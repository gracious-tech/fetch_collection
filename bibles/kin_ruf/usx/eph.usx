<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="EPH" style="id">- Rufumbira New Testament</book>
  <para style="h">ABEFEESO</para>
  <para style="toc3">Efe</para>
  <para style="toc2">ABEFEESO</para>
  <para style="toc1">Urwandiko Intumwa Pawulo yandikiye ABEFEESO</para>
  <para style="mt2">Urwandiko Intumwa Pawulo yandikiye</para>
  <para style="mt1">ABEFEESO</para>
  <para style="imt">INYANZURO</para>
  <para style="im">Ica mbere ca byose, <char style="bk">Urwandiko Intumwa Pawulo yandikiye Abefeeso </char> rushingiye ku “Umugambi w'Imaana wo gukoranyiriza hamwe ibyaremwe byose, ibyo mu ijuru byose n'ibyo mu isi, hamwe na Kristo nk'umutwe waabyo” 1:10. Ikindi kandi, uru rwandiko rugamije gushiishikariza abantu b'Imaana kuba muri uyu mugambi ukomeye ku bw'ubumwe bwa kiremwamuntu binyuriye mu kunga ubumwe na Yesu Kristo.</para>
  <para style="ip">Mu gice ca mbere c'<char style="bk">Abefeeso </char> umwanditsi agaragaza umutwe w'amagambo y'ubumwe avuga uburyo bwo Imaana Daata yatooranyije abantu baayo, uko bababarirwa ibyaha byabo no kubohoorwa kwabo babikeesha Yesu Kristo Umwana w'Imaana, n'uko iseezerano ry'Imaana rikomeye ryemezwa n'Umwuka Weera. Mu gice gikurikiraho, umwanditsi ashiishikariza abasoma kubaho mu buryo ubumwe bwabo na Kristo bugaragarira mu mibaanire yaabo.</para>
  <para style="ip">Amagambo menshi y'amarenga akoreeshwa mukugaragaza ubumwe bw'abantu b'Imaana n'ubwiyunge na Kristo. Itoorero ni nk'umubiri na Kristo akaba nk'umutwe waawo, cangwa ni nk'icuubakwa na Kristo akaba urufatiro rwaco, cangwa ni nk'umugore na Kristo akaba umugabo. Uru rwandiko ruteera intambwe ndende biteewe n'uburyo bwo umwanditsi akoreesha ajanwa n'igiteekerezo c'ubuntu bw'Imaana muri Kristo. Byose bigaragarira mu rukundo rwa Kristo, ukwitanga, kubabarira, ubuntu, n'ubutungaane.</para>
  <para style="iot">Ibirimo</para>
  <para style="io1">Inyanzuro <char style="ior"><ref loc="EPH 1:1-2">1:1-2</ref> </char></para>
  <para style="io1">Kristo hamwe n'itoorero <char style="ior"><ref loc="EPH 1:3-3:21">1:3—3:21</ref></char></para>
  <para style="io1">Ubugingo busha muri Kristo <char style="ior"><ref loc="EPH 4:1-6:20">4:1—6:20</ref></char></para>
  <para style="io1">Umusoozo <char style="ior"><ref loc="EPH 6:21-24">6:21-24</ref></char></para>
  <chapter number="1" style="c" sid="EPH 1" />
  <para style="s1">Indamutso</para>
  <para style="p">
    <verse number="1" style="v" sid="EPH 1:1" />
    <note caller="-" style="x">
      <char style="xo" closed="false">1:1 </char>
      <char style="xt" closed="false">
        <ref loc="ACT 18:19-21">Iby 18:19-21</ref>; <ref loc="ACT 19:1">19:1</ref>.</char>
    </note>Njeewe Pawulo, uwo Imaana yagize intumwa ya Kristo, ku bw'ubushaake bwayo,</para>
  <para style="p" vid="EPH 1:1">Ndabandikira mwebwe abantu b'Imaana bari muri Efeeso, biizeera Kristo Yesu.<verse eid="EPH 1:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="EPH 1:2" />Mugire ubuntu n'amahoro bituruka ku Maana Daata wa twese no ku Mwami Yesu Kristo.<verse eid="EPH 1:2" /></para>
  <para style="s1">Imigisha y'Imaana Ibonerwa mu Kwizeera Kristo</para>
  <para style="p">
    <verse number="3" style="v" sid="EPH 1:3" />Imaana, kandi Se w'Umwami waacu Yesu Kristo ishiimwe, kuko yaduheereye muri Kristo imigisha yoose y'Umwuka wo mu ijuru. <verse eid="EPH 1:3" /><verse number="4" style="v" sid="EPH 1:4" />Yadutooranyije binyuze muri we isi itaraaremwa, kugira ngo tube intungaane n'abaziranenge.</para>
  <para style="p" vid="EPH 1:4">Ku bw'urukundo rwayo, <verse eid="EPH 1:4" /><verse number="5" style="v" sid="EPH 1:5" />Imaana yari yarahisemo kutugira abaana baayo tubikeesha Yesu Kristo, ku bw'ineeza n'ubushaake bwayo. <verse eid="EPH 1:5" /><verse number="6" style="v" sid="EPH 1:6" />Noone reero, reka dusingize Imaana ku bw'ubuntu buhebuuje ari yo mpaano yaduheereye ubuntu, ibinyujije mu Mwana waayo w'inkoramutima. <verse eid="EPH 1:6" /><verse number="7" style="v" sid="EPH 1:7" /><note caller="-" style="x"><char style="xo" closed="false">1:7 </char><char style="xt" closed="false"><ref loc="COL 1:14">Kol 1:14</ref>.</char></note>Ni we waduheesheje gucungurwa ku bw'amaraso ye, tukababarirwa ibicumuro byacu, ku bw'ubuntu bwe buhebuuje <verse eid="EPH 1:7" /><verse number="8" style="v" sid="EPH 1:8" />bwo yaduseesekajeho.</para>
  <para style="p" vid="EPH 1:8">Ku bw'ubuhanga n'ubumenyi bwe bwose, <verse eid="EPH 1:8" /><verse number="9" style="v" sid="EPH 1:9" />Imaana yatumenyesheje ibanga ry'ubushaake bwayo, ikora ico yari igambiriye ikurikije imirimo Kristo yakoze. <verse eid="EPH 1:9" /><verse number="10" style="v" sid="EPH 1:10" />Umugambi wo Imaana izuuzuza igihe kigeze, ni ugukoranyiriza hamwe ibintu byose muri Kristo, ari ibiri mu ijuru cangwa ibiri ku isi.<verse eid="EPH 1:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="EPH 1:11" />Imaana ikora ibintu byose nk'uko ibishaaka, yadutooranyirije kuba abaayo twunze ubumwe na Kristo nk'uko yari yarabigambiiriye kuva keera. <verse eid="EPH 1:11" /><verse number="12" style="v" sid="EPH 1:12" />Imaana yabikoze kugira ngo twebwe abaabanje kwizeera Kristo, duhimbaaze ikuzo ryayo.<verse eid="EPH 1:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="EPH 1:13" />Namwe reero abamaze kumva ijambo ry'ukuri, ari ryo Nkuru Nziiza yabaazaniye gukizwa, mwahindutse abaana b'Imaana. Mwemeye Kristo maze Imaana ibashiraho ikimenyeetso caayo c'Umwuka Weera yari yarabaseezeranyije. <verse eid="EPH 1:13" /><verse number="14" style="v" sid="EPH 1:14" />Uwo Mwuka ni co ceemezo ko tuzaabona ico Imaana yaseezeranyije abantu baayo, kandi iki kiduhamiriza yuuko Imaana izaaha abaayo umudendeezo wuzuye. Reka duhimbaaze ikuzo ryayo!<verse eid="EPH 1:14" /></para>
  <para style="s1">Isengeesho rya Pawulo</para>
  <para style="p">
    <verse number="15" style="v" sid="EPH 1:15" />Maze kumva uko mwizeera Umwami Yesu n'urukundo mufitiye abantu b'Imaana boose, ni co gituma <verse eid="EPH 1:15" /><verse number="16" style="v" sid="EPH 1:16" />nanje mbashiimira Imaana ubudahwema, nkabiibuka mu masengeesho yanje. <verse eid="EPH 1:16" /><verse number="17" style="v" sid="EPH 1:17" />Ndasaba Imaana y'Umwami waacu Yesu Kristo, ari yo Daata w'ikuzo, kubaha Umwuka uzaabaha ubwenge no kubahishuurira Imaana, kugira ngo murusheho kuyimenya. <verse eid="EPH 1:17" /><verse number="18" style="v" sid="EPH 1:18" />Ndasaba ko imitima yaanyu yakinguuka ikabona, kugira ngo mumenye ibyiringiro byo mwahamagariwe, kandi mumenye n'icuubahiro gihebuuje yaseezeranyije abaana baayo, <verse eid="EPH 1:18" /><verse number="19" style="v" sid="EPH 1:19" />kandi mumenye uko imbaraga z'ububaasha zikorera muri twe abiizeera. Izi mbaraga zidukoreramo, ni nazo mbaraga zihebuuje <verse eid="EPH 1:19" /><verse number="20" style="v" sid="EPH 1:20" />yakoreesheje ubwo yazuuye Yesu mu baapfuuye maze ikamwicaza iburyo bwayo mu mwanya wo mu ijuru. <verse eid="EPH 1:20" /><verse number="21" style="v" sid="EPH 1:21" />Kristo yashizwe heejuru y'abatware, abanyabushobozi, abanyabubaasha, n'abategetsi boose bo mu ijuru, ndetse n'izina rye rishirwa heejuru y'andi mazina y'ubushobozi muri iki gihe, no mu gihe kizaaza. <verse eid="EPH 1:21" /><verse number="22" style="v" sid="EPH 1:22" /><note caller="-" style="x"><char style="xo" closed="false">1:22 </char><char style="xt" closed="false"><ref loc="COL 1:18">Kol 1:18</ref>.</char></note>Imaana yahaaye Kristo ububaasha bwo gutegeka ibintu byose, kandi imugira umutwe w'itoorero. <verse eid="EPH 1:22" /><verse number="23" style="v" sid="EPH 1:23" />Itoorero ni umubiri wa Kristo kandi ni co cuuzuzo kuri Kristo, na Kristo ubwe akuuzuza ibintu byose ahantu hoose.<verse eid="EPH 1:23" /></para>
  <chapter eid="EPH 1" />
  <chapter number="2" style="c" sid="EPH 2" />
  <para style="s1">Kuva mu Rupfu Uja mu Bugingo</para>
  <para style="p">
    <verse number="1" style="v" sid="EPH 2:1" />
    <note caller="-" style="x">
      <char style="xo" closed="false">2:1 </char>
      <char style="xt" closed="false">
        <ref loc="COL 2:13">Kol 2:13</ref>.</char>
    </note>Namwe mwari mwarapfuuye muzize ibicumuro n'ibyaha byanyu. <verse eid="EPH 2:1" /><verse number="2" style="v" sid="EPH 2:2" />Ico gihe ni byo mwabagamo, mukurikije imigenzereze mibi y'isi, no kuubahiriza umutegetsi w'imbaraga w'imyuka mibi ari we ukorera mu bantu batumvira Imaana. <verse eid="EPH 2:2" /><verse number="3" style="v" sid="EPH 2:3" />Kandi naatwe twese twari tumeze nka bo, dukurikiza irari ry'imibiri yaacu n'ibyo imitima yaacu yiiteekerereje. Mu buryo bwacu bwa kamere, twari abo kubabazwa n'umujinya w'Imaana, nk'abandi boose.<verse eid="EPH 2:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="EPH 2:4" />Ariko imbabazi z'Imaana ni nyinshi, kandi n'urukundo idukunda rurahebuuje, <verse eid="EPH 2:4" /><verse number="5" style="v" sid="EPH 2:5" />nuubwo twari twarapfuuye tuzize ibicumuro byacu, yadushubije ubugingo hamwe ku bw'ubumwe bwacu na Kristo. Erega mwakijijwe ku bw'ubuntu bwayo. <verse eid="EPH 2:5" /><verse number="6" style="v" sid="EPH 2:6" />Kuko Imaana yatuzuuranye na Kristo Yesu, itwicazanya na we mu ijuru tubikeesha Kristo Yesu. <verse eid="EPH 2:6" /><verse number="7" style="v" sid="EPH 2:7" />Ibyo yabikoze kugira ngo mu bihe bizaaza byose yeerekane ubuntu bwayo butagira akagero, ikoreesheje urukundo yadukunze binyuze muri Yesu Kristo. <verse eid="EPH 2:7" /><verse number="8" style="v" sid="EPH 2:8" />Koko mwakijijwe n'ubuntu ku bwo kwizeera Yesu Kristo, kandi si imbaraga zaanyu zaabikoze, ahuubwo ni impaano y'Imaana, <verse eid="EPH 2:8" /><verse number="9" style="v" sid="EPH 2:9" />bidaturutse no ku mirimo yaanyu, kugira ngo hatagira ubyiraatiisha. <verse eid="EPH 2:9" /><verse number="10" style="v" sid="EPH 2:10" />Kuko Imaana ari yo yatugize ico turi co, yaturemeye imirimo myiza muri Kristo Yesu, yo yateguuye keera kugira ngo iturange mu kubaho kwacu.<verse eid="EPH 2:10" /></para>
  <para style="s1">Ubumwe muri Kristo</para>
  <para style="p">
    <verse number="11" style="v" sid="EPH 2:11" />Nuuko reero, mwebwe banyamahanga ku mubiri, abo Abayuuda biitaga “abataarakebwe” maze bo bakiiyita “abaakebwe” Kuko gukebwa kimenyeesha umuhango wo gukeba igice c'ubugabo, nimwibuke reero uko keera mwari mumeze. <verse eid="EPH 2:11" /><verse number="12" style="v" sid="EPH 2:12" />Ico gihe ntimwari mufite Kristo. Mwari abanyamahanga kandi ntimwari muri ab'umuryango wa Isirayeli. Ntaaho mwari muhuuriye n'amaseezerano Imaana yagiriye abantu baayo, kandi mwari mutuuye muri iyi si nta byiringiro mufite kandi mutaazi Imaana. <verse eid="EPH 2:12" /><verse number="13" style="v" sid="EPH 2:13" />Ariko ubu ubwo mwunze ubumwe na Kristo Yesu, mwebwe abaabaga kure y'Imaana, mwigijwe haafi yaayo n'amaraso ya Kristo. <verse eid="EPH 2:13" /><verse number="14" style="v" sid="EPH 2:14" />Koko Kristo ubwe yatuuzaniye amahoro ubwo yunze Abayuuda n'abanyamahanga bakaba umwe. Yakoreesheje umubiri we gukuuraho igisiika caabatandukanyaga kigatuma bahora bari abanzi. <verse eid="EPH 2:14" /><verse number="15" style="v" sid="EPH 2:15" /><note caller="-" style="x"><char style="xo" closed="false">2:15 </char><char style="xt" closed="false"><ref loc="COL 2:14">Kol 2:14</ref>.</char></note>Yakuuyeho itegeko ry'Abayuuda hamwe n'amabwiriza ya ryo, kugira ngo iyi miryango ebyiri ayihindure umwe musha muri we, nuuko azane amahoro. <verse eid="EPH 2:15" /><verse number="16" style="v" sid="EPH 2:16" /><note caller="-" style="x"><char style="xo" closed="false">2:16 </char><char style="xt" closed="false"><ref loc="COL 1:20">Kol 1:20</ref>.</char></note>Ku bw'urupfu rwe rwo ku musaraba, abo bombi Kristo yabunze n'Imaana maze abagira umubiri umwe, bityo arandura urwango rwari hagati yaabo. <verse eid="EPH 2:16" /><verse number="17" style="v" sid="EPH 2:17" />Noone reero Kristo yaraaje maze yamamaza Inkuru Nziiza y'amahoro kuri boose, kuri mwe abanyamahanga, baari kure y'Imaana, hamwe n'Abayuuda, baari haafi n'Imaana. <verse eid="EPH 2:17" /><verse number="18" style="v" sid="EPH 2:18" />Twese reero, Abayuuda n'abanyamahanga, dushobora kwegeera imbere y'Imaana Daata turi mu Mwuka umwe, tubikeesha Kristo.<verse eid="EPH 2:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="EPH 2:19" />Bityo reero ntimukiri abanyamahanga n'abiimukiira, ahuubwo musangiye ubwenegihugu n'abantu b'Imaana, ndetse mukaba muri bamwe bo mu muryango waayo. <verse eid="EPH 2:19" /><verse number="20" style="v" sid="EPH 2:20" />Namwe mwubatswe ku rufatiro rwubatswe n'intumwa n'abahanuuzi, ariko ibuye ry'imfuruka ni Kristo Yesu ubwe. <verse eid="EPH 2:20" /><verse number="21" style="v" sid="EPH 2:21" />Ni we ushoboza inzu yoose guteeranywa neeza maze igahinduka urusengero rwera rwa Nyagasani. <verse eid="EPH 2:21" /><verse number="22" style="v" sid="EPH 2:22" />Reero muri we ni mwo mwe hamwe n'abandi mwubakwa mu buryo bw'Umwuka, kugira ngo mube inzu yo gutuurwamo n'Imaana.<verse eid="EPH 2:22" /></para>
  <chapter eid="EPH 2" />
  <chapter number="3" style="c" sid="EPH 3" />
  <para style="s1">Umurimo wa Pawulo mu Banyamahanga</para>
  <para style="p">
    <verse number="1" style="v" sid="EPH 3:1" />Ni co gituma njeewe Pawulo ndi umusibe ku bwa Kristo Yesu ku bwanyu abanyamahanga. <verse eid="EPH 3:1" /><verse number="2" style="v" sid="EPH 3:2" />Ngira ngo mwumviise yuuko Imaana yanshinze kubakorera uyu murimo ku bw'ubuntu bwayo. <verse eid="EPH 3:2" /><verse number="3" style="v" sid="EPH 3:3" />Imaana yampishuuriye ibanga ry'umugambi waayo nk'uko nabyanditse muri make, <verse eid="EPH 3:3" /><verse number="4" style="v" sid="EPH 3:4" /><note caller="-" style="x"><char style="xo" closed="false">3:4 </char><char style="xt" closed="false"><ref loc="COL 1:26">Kol 1:26</ref>,<ref loc="COL 1:27">27</ref>.</char></note>kandi nimubisoma muribuuze gusobaanukirwa ukuntu nasobaanukiwe iryo banga rya Kristo. <verse eid="EPH 3:4" /><verse number="5" style="v" sid="EPH 3:5" />Mu bihe bya keera, iri banga ntiryigeze rimenyeshwa abaana b'abantu, nk'uko ubu rimaze guhishuurirwa intumwa ze zeera, ikoreesheje Umwuka waayo. <verse eid="EPH 3:5" /><verse number="6" style="v" sid="EPH 3:6" />Umugambi w'iryo banga ni uko abanyamahanga na bo ari abaragwa bumurage w'Imaana kimwe n'Abayuuda ku bw'Ubutumwa Bwiza. Ni ingingo z'umubiri umwe kandi basangiye ku seezerano Imaana yakoze muri Kristo, babikeesha Inkuru Nziiza.<verse eid="EPH 3:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="EPH 3:7" />Nagizwe umugaragu wo kwamamaza Ubutumwa Bwiza nkurikije ubuntu bw'Imaana nahaawe, ku bw'imbaraga zaayo zikorera muri nje. <verse eid="EPH 3:7" /><verse number="8" style="v" sid="EPH 3:8" />Nuubwo ari njeewe urutwa n'uworoheje caane mu bantu b'Imaana boose, Imaana yampaaye umugisha wo kujaanira abanyamahanga Ubutumwa Bwiza bwa Kristo ari bwo butunzi butarondooreka, <verse eid="EPH 3:8" /><verse number="9" style="v" sid="EPH 3:9" />no gusobaanurira abantu uko ibanga ry'umugambi w'Imaana rigiiye gushirwa mu bikorwa. Imaana yaremye ibintu byose, yahishe iryo banga ryayo uheereye keera koose, <verse eid="EPH 3:9" /><verse number="10" style="v" sid="EPH 3:10" />kugira ngo abo muri iki gihe, abategetsi, n'ibikomangoma byo mu ijuru, bamenyeshwe n'itoorero, ubwenge bw'Imaana bw'uburyo bwinshi. <verse eid="EPH 3:10" /><verse number="11" style="v" sid="EPH 3:11" />Uku ni ko Imaana yuujurije umugambi waayo uhoraho inyuriye muri Kristo Yesu Umwami waacu. <verse eid="EPH 3:11" /><verse number="12" style="v" sid="EPH 3:12" />Mu kunga ubumwe na Kristo no kwizeera dufite muri we, biduheesha kwegeera Imaana tudatiinya. <verse eid="EPH 3:12" /><verse number="13" style="v" sid="EPH 3:13" />Nooneho reero ndabinginga ngo mudacoogora biteewe n'uko mbabazwa ku bwanyu, kuko ari byo bibaheesha icuubahiro.<verse eid="EPH 3:13" /></para>
  <para style="s1">Gusabira Abefeeso</para>
  <para style="p">
    <verse number="14" style="v" sid="EPH 3:14" />Ni co gituma mfukama imbere y'Imaana Daata, <verse eid="EPH 3:14" /><verse number="15" style="v" sid="EPH 3:15" />uwo imiryango yoose yo mu ijuru n'iyo ku isi yiitirirwa. <verse eid="EPH 3:15" /><verse number="16" style="v" sid="EPH 3:16" />Ndasaba Imaana nyir'ikuzo n'ububaasha bwose kubateera imbaraga no gukomeza imitima yaanyu, ibigiriishije Umwuka waayo <verse eid="EPH 3:16" /><verse number="17" style="v" sid="EPH 3:17" />kandi ndasaba ngo Kristo atuure mu mitima yaanyu mubikeesha ukwizeera kwanyu, ubwo muri gushoora imizi no gushikama mu rukundo. <verse eid="EPH 3:17" /><verse number="18" style="v" sid="EPH 3:18" />Ndasaba kugira ngo mwebwe hamwe n'abantu b'Imaana boose, mugire imbaraga zo kumenya yuuko urukundo rwa Kristo ruhebuuje, <verse eid="EPH 3:18" /><verse number="19" style="v" sid="EPH 3:19" />no kumenya yuuko urukundo rwe rurenze ukwitegereza, kugira ngo mushobore gusendeerezwamo kamere yoose y'Imaana.<verse eid="EPH 3:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="EPH 3:20" />Noone reero, dukwiriye gushiima Imaana yo ikoreesha imbaraga zaayo muri twe, igakora ibirenze ku byo twasaba, ndetse n'ibyo twakwibwira. <verse eid="EPH 3:20" /><verse number="21" style="v" sid="EPH 3:21" />Ni ihaabwe ikuzo mu itoorero no muri Kristo Yesu ibihe byose, n'uko ibihe biha ibindi. Amiina.<verse eid="EPH 3:21" /></para>
  <chapter eid="EPH 3" />
  <chapter number="4" style="c" sid="EPH 4" />
  <para style="s1">Ubumwe mu Mubiri wa Kristo</para>
  <para style="p">
    <verse number="1" style="v" sid="EPH 4:1" />Noone reero, njeewe umusibe wa Nyagasani, ndabinginga kugira ngo muje mugenza uko bikwiriye, mukurikije ibyo mwahamagariwe. <verse eid="EPH 4:1" /><verse number="2" style="v" sid="EPH 4:2" /><note caller="-" style="x"><char style="xo" closed="false">4:2 </char><char style="xt" closed="false"><ref loc="COL 3:12">Kol 3:12</ref>,<ref loc="COL 3:13">13</ref>.</char></note>Mwiciishe bugufi, mugire ukwiyorosha, kandi mwihangaane. Mugaragaze urukundo rwanyu mu kwihangaanirana muri byose. <verse eid="EPH 4:2" /><verse number="3" style="v" sid="EPH 4:3" />Muharanire kurinda ubumwe butangwa n'Umwuka w'Imaana, n'amahoro abahuuza. <verse eid="EPH 4:3" /><verse number="4" style="v" sid="EPH 4:4" />Hariho umubiri umwe n'Umwuka umwe, nk'uko ico mwiringira ari kimwe, ari na co Imaana yabahamagariye. <verse eid="EPH 4:4" /><verse number="5" style="v" sid="EPH 4:5" />Hariho Nyagasani umwe, ukwizeera kumwe, umubatizo umwe, <verse eid="EPH 4:5" /><verse number="6" style="v" sid="EPH 4:6" />Imaana imwe kandi Daata wa twese, usumba boose, ukorera muri boose, kandi agatuura muri boose.<verse eid="EPH 4:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="EPH 4:7" />Buri umwe muri twe yahaawe urugero rw'impaano imukwiriye, nk'uko Kristo yayimugeneye. <verse eid="EPH 4:7" /><verse number="8" style="v" sid="EPH 4:8" />Ni na ko ibyanditswe bivuga ngo,</para>
  <para style="q1" vid="EPH 4:8">“Ubwo yazaamuutse aja mu ijuru,</para>
  <para style="q2" vid="EPH 4:8">yajaanye abanyagwa benshi,</para>
  <para style="q2" vid="EPH 4:8">yahaaye abantu impaano.”<verse eid="EPH 4:8" /></para>
  <para style="m">
    <verse number="9" style="v" sid="EPH 4:9" />Noone se, “Yazaamuutse mu ijuru” bisobaanura iki? Bisobaanura yuuko yabanje kumanuka akagera ikuzimu. <verse eid="EPH 4:9" /><verse number="10" style="v" sid="EPH 4:10" />Bityo reero, uwamanutse ni we wazaamuutse, aja heejuru y'amajuru yoose, kugira ngo yuzure hoose. <verse eid="EPH 4:10" /><verse number="11" style="v" sid="EPH 4:11" />Ni we watanze impaano zo kugira ngo bamwe babe intumwa, abandi abahanuuzi, abandi abavugabutumwa, abandi abashumba n'abiigiisha. <verse eid="EPH 4:11" /><verse number="12" style="v" sid="EPH 4:12" />Ibyo yabikoze kugira ngo ateguurire abantu b'Imaana gukora umurimo waayo, no gukomeza umubiri wa Kristo. <verse eid="EPH 4:12" /><verse number="13" style="v" sid="EPH 4:13" />Bityo twese tuzunga ubumwe mu kwizeera no kumenya Umwana w'Imaana, tukaba abantu bahamye, bageze ku rugero rwuzuye rwa Kristo. <verse eid="EPH 4:13" /><verse number="14" style="v" sid="EPH 4:14" />Ubwo ntituzaaaba tukiri abaana batwarwa n'imivumba no guhuuhwa n'imiyaga yoose ihindagurika, ari yo myigiishirize y'abantu bashukana, bakayobya abandi bakoreesheje uburyarya bihimbiye. <verse eid="EPH 4:14" /><verse number="15" style="v" sid="EPH 4:15" />Ahuubwo nituvuga ukuri tugakurikiza umutima w'urukundo, tuzaakurira mu bumwe na Kristo, ari we mutwe. <verse eid="EPH 4:15" /><verse number="16" style="v" sid="EPH 4:16" /><note caller="-" style="x"><char style="xo" closed="false">4:16 </char><char style="xt" closed="false"><ref loc="COL 2:19">Kol 2:19</ref>.</char></note>Ni we ugenga ingingo zoose z'umubiri zihuurizwa hamwe, n'umubiri woose ugafatwa n'ingingo ziwugize. Bityo buri rugingo rukoze umurimo rushinzwe, umubiri woose urakura maze ukiiyubakira mu rukundo.<verse eid="EPH 4:16" /></para>
  <para style="s1">Ubugingo Busha muri Kristo</para>
  <para style="p">
    <verse number="17" style="v" sid="EPH 4:17" />Dore ibi ni byo mbabwira kandi neemeza biturutse kuri Nyagasani; ntimugakomeze kwifata nk'abataazi Imaana, bakurikiza ibiteekerezo byabo bitagira umumaro, <verse eid="EPH 4:17" /><verse number="18" style="v" sid="EPH 4:18" />n'ubwenge bwabo bukaba ari ntaaco busobaanukirwa. Biitandukanyije n'ubugingo Imaana itanga, ku bw'ubujiji bwabo n'imitima yaabo yiinangiye. <verse eid="EPH 4:18" /><verse number="19" style="v" sid="EPH 4:19" />Ntibakigira isoni na hato. Ubu bariyandarika, bagakora ibiteeye isoni byose biteerwa n'irari ntaaco batiinya.<verse eid="EPH 4:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="EPH 4:20" />Ibyo si byo mwigiishijwe ubwo mwigiishwaga kumenya Kristo! <verse eid="EPH 4:20" /><verse number="21" style="v" sid="EPH 4:21" />Ni koko mwumviishije ibimufasheho, kandi nk'abayoboke be mwigiishijwe ukuri gusangwa muri Yesu. <verse eid="EPH 4:21" /><verse number="22" style="v" sid="EPH 4:22" /><note caller="-" style="x"><char style="xo" closed="false">4:22 </char><char style="xt" closed="false"><ref loc="COL 3:9">Kol 3:9</ref>.</char></note>Noone reero nimwiyambure kamere yaanyu ya keera, yategekaga imigenzereze yaanyu, igatuma mwangiizwa n'ibyifuuzo by'iryo rari. <verse eid="EPH 4:22" /><verse number="23" style="v" sid="EPH 4:23" />Nimuvugurure imitima yaanyu maze muhinduke basha mu biteekerezo, <verse eid="EPH 4:23" /><verse number="24" style="v" sid="EPH 4:24" /><note caller="-" style="x"><char style="xo" closed="false">4:24 </char><char style="xt" closed="false"><ref loc="COL 3:10">Kol 3:10</ref>.</char></note>kandi mwambare kamere nsha y'ishusho y'Imaana, murangwa n'ubuzima nyakuri butungaanye hamwe n'ubuziranenge.<verse eid="EPH 4:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="EPH 4:25" />Noone reero, nimuciike ku binyoma, buri muntu abwire mugenzi we ukuri, kuko twese turi ingingo z'umubiri wa Kristo. <verse eid="EPH 4:25" /><verse number="26" style="v" sid="EPH 4:26" />Kandi nimuraakara ntibibateere gukora icaaha, ndetse izuuba ntirikarenge mugifite uburaakari, <verse eid="EPH 4:26" /><verse number="27" style="v" sid="EPH 4:27" />kandi ntimugahe Sataani amahiirwe yo kubashuka. <verse eid="EPH 4:27" /><verse number="28" style="v" sid="EPH 4:28" />Abiibaga barekeraho kwiiba, ahuubwo batangire kwihaatira gukoreesha amaboko yaabo, kugira ngo babone uko bafasha abakene. <verse eid="EPH 4:28" /><verse number="29" style="v" sid="EPH 4:29" />Ntimugakoreeshe amagambo mabi, ahuubwo mukoreeshe amagambo meeza yaakuubaka ubugingo bw'abandi nk'uko babikeneye, kugira ngo abayumva abagirire akamaro. <verse eid="EPH 4:29" /><verse number="30" style="v" sid="EPH 4:30" />Kandi ntimukaraakaze Umwuka Weera, kuko uwo Mwuka ni ikimenyeetso Imaana yabashizeho kizaabaranga ku munsi wo gucungurwa kwanyu. <verse eid="EPH 4:30" /><verse number="31" style="v" sid="EPH 4:31" />Mwivaanemo gushaariirana koose n'umujinya, no kuraakara, n'intonganya, n'itimwe, <verse eid="EPH 4:31" /><verse number="32" style="v" sid="EPH 4:32" /><note caller="-" style="x"><char style="xo" closed="false">4:32 </char><char style="xt" closed="false"><ref loc="COL 3:13">Kol 3:13</ref>.</char></note>ahuubwo mugirirane impuhwe n'ineeza, mubabarirane nk'uko Imaana yabababariye binyuze muri Kristo Yesu.<verse eid="EPH 4:32" /></para>
  <chapter eid="EPH 4" />
  <chapter number="5" style="c" sid="EPH 5" />
  <para style="s1">Kuba mu Muco</para>
  <para style="p">
    <verse number="1" style="v" sid="EPH 5:1" />Ubwo reero muri abaana b'Imaana ikunda caane, muje mugerageza kuba nka yo. <verse eid="EPH 5:1" /><verse number="2" style="v" sid="EPH 5:2" />Kandi muje mukundana nk'uko Kristo yadukunze agatanga ubuzima bwe ku bwacu nk'ituuro n'igitambo gihuumura neeza kigashiimiisha Imaana.<verse eid="EPH 5:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="EPH 5:3" />Ubwo muri abaana b'Imaana, ntibikwiriye ko ingeso mbi nk'ubusambanyi, kwiyandarika, no kurarikira ibintu, birangwa muri mwe. <verse eid="EPH 5:3" /><verse number="4" style="v" sid="EPH 5:4" />Kandi ntibikwiriye ko mukoreesha amagambo ateeye isoni, akoreeshwa n'abapfaapfa, n'amashengo adakwiriye, ahuubwo muje mushiima Imaana. <verse eid="EPH 5:4" /><verse number="5" style="v" sid="EPH 5:5" />Koko reero mumenye neeza yuuko ari nta musambanyi, cangwa ukora ibiteeye isoni, cangwa umunyamururu [kuko umururu ari uburyo bumwe bwo guhindura iby'isi ibigirwamaana], uzaagira umugabane mu Bwami bwa Kristo n'ubw'Imaana.<verse eid="EPH 5:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="EPH 5:6" />Ntihakagire ubashukiisha amagambo atagira aho ashingiye, kuko ibikorwa nk'ibyo biizana umujinya w'Imaana maze bigatuma ihana abatayumvira. <verse eid="EPH 5:6" /><verse number="7" style="v" sid="EPH 5:7" />Nuuko reero ntimugafatanye n'abantu nk'abo. <verse eid="EPH 5:7" /><verse number="8" style="v" sid="EPH 5:8" />Namwe ubwanyu mwari mu mwijima, ariko ubwo mwahindutse mukaba aba Nyagasani, muri mu muco. Nooneho reero, nimugenze nk'abaana b'umuco, <verse eid="EPH 5:8" /><verse number="9" style="v" sid="EPH 5:9" />kuko umuco ni wo uzana umusaaruuro w'ingeso nziiza zoose, ubutungaane, n'ukuri. <verse eid="EPH 5:9" /><verse number="10" style="v" sid="EPH 5:10" />Nimushishooze kumenya ibishiimiisha Nyagasani. <verse eid="EPH 5:10" /><verse number="11" style="v" sid="EPH 5:11" />Ntimukiivange mu bikorwa bitagira akamaro, kuko ari iby'umwijima, ahuubwo muje mubishira kumugaragaro. <verse eid="EPH 5:11" /><verse number="12" style="v" sid="EPH 5:12" />Ibyo bikorwa byabo bikorwa rwihishwa biteeye isoni no kubivugaho. <verse eid="EPH 5:12" /><verse number="13" style="v" sid="EPH 5:13" />Ariko iyo byose bishizwe kumugaragaro, imiteerere yabyo nyakuri iboneka neeza, <verse eid="EPH 5:13" /><verse number="14" style="v" sid="EPH 5:14" />kuko ikigaragajwe coose kiba kibaaye umuco. Ni co gituma bivugwa ngo,</para>
  <para style="q1" vid="EPH 5:14">“Yewe usinziiriye, kanguka,</para>
  <para style="q2" vid="EPH 5:14">maze uzuuke uve mu baapfuuye,</para>
  <para style="q1" vid="EPH 5:14">nuuko Kristo azaakumurikire.”<verse eid="EPH 5:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="EPH 5:15" />Nuuko reero, mwirinde mu mibeereho yaanyu. Ntimukabe nk'injiji, ahuubwo mube nk'abanyabwenge. <verse eid="EPH 5:15" /><verse number="16" style="v" sid="EPH 5:16" /><note caller="-" style="x"><char style="xo" closed="false">5:16 </char><char style="xt" closed="false"><ref loc="COL 4:5">Kol 4:5</ref>.</char></note>Mukoreeshe neeza igihe mufite, kuko iminsi ari mibi. <verse eid="EPH 5:16" /><verse number="17" style="v" sid="EPH 5:17" />Noone reero mureke kuba abapfu, ahuubwo mumenye ico Nyagasani ashaaka ngo mukore.<verse eid="EPH 5:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="EPH 5:18" />Ntimugasindiishwe na divaayi, yaatuma mukora ibidakwiriye, ahuubwo mwuzure Umwuka. <verse eid="EPH 5:18" /><verse number="19" style="v" sid="EPH 5:19" /><note caller="-" style="x"><char style="xo" closed="false">5:19 </char><char style="xt" closed="false"><ref loc="COL 3:16">Kol 3:16</ref>,<ref loc="COL 3:17">17</ref>.</char></note>Mubwirane amagambo ya Zaaburi, n'indirimbo z'ibisingizo, n'izikomooka ku Mwuka, muririmba kandi mucurangira Nyagasani mubikuuye ku mutima. <verse eid="EPH 5:19" /><verse number="20" style="v" sid="EPH 5:20" />Mu izina ry'Umwami waacu Yesu Kristo, muje muhora mushiima Imaana Daata.<verse eid="EPH 5:20" /></para>
  <para style="s1">Imibaanire y'Umugabo n'Umugore</para>
  <para style="p">
    <verse number="21" style="v" sid="EPH 5:21" />Muje mwubahana mubiteewe no kuubaha Kristo.<verse eid="EPH 5:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="EPH 5:22" />
    <note caller="-" style="x">
      <char style="xo" closed="false">5:22 </char>
      <char style="xt" closed="false">
        <ref loc="COL 3:18">Kol 3:18</ref>; <ref loc="1PE 3:1">1Pet 3:1</ref>.</char>
    </note>Bagore, mwubahe abagabo baanyu nk'uko mwubaha Nyagasani. <verse eid="EPH 5:22" /><verse number="23" style="v" sid="EPH 5:23" />Kuko umugabo ni we mutwe w'umugore nk'uko Kristo ari umutwe w'itoorero, ari ryo mubiri we. <verse eid="EPH 5:23" /><verse number="24" style="v" sid="EPH 5:24" />Nk'uko reero itoorero ryubaha Kristo, ni ko namwe bagore mugomba kuubaha abagabo baanyu muri byose.<verse eid="EPH 5:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="EPH 5:25" />
    <note caller="-" style="x">
      <char style="xo" closed="false">5:25 </char>
      <char style="xt" closed="false">
        <ref loc="COL 3:19">Kol 3:19</ref>; <ref loc="1PE 3:7">1Pet 3:7</ref>.</char>
    </note>Bagabo, mukunde abagore baanyu nk'uko Kristo yakunze itoorero akaritangira ubugingo bwe. <verse eid="EPH 5:25" /><verse number="26" style="v" sid="EPH 5:26" />Ibyo yabikoze kugira ngo yeeze itoorero akoreesheje ijambo rye n'amaazi, <verse eid="EPH 5:26" /><verse number="27" style="v" sid="EPH 5:27" />maze aryigarurize ribengerana kandi ritagira inenge, nta mipfunyo cangwa ikindi kintu kitaboneye. <verse eid="EPH 5:27" /><verse number="28" style="v" sid="EPH 5:28" />Uko ni ko abagabo bagomba gukunda abagore baabo nk'uko bakunda imibiri yaabo. Umugabo ukunda umugore we aba yiikunda ubwe. <verse eid="EPH 5:28" /><verse number="29" style="v" sid="EPH 5:29" />Koko reero, abantu ntibanga imibiri yaabo, ahuubwo barayigaburira kandi bakayireeberera, nk'uko Kristo agenzereza itoorero rye, <verse eid="EPH 5:29" /><verse number="30" style="v" sid="EPH 5:30" />kuko turi ingingo z'umubiri we. <verse eid="EPH 5:30" /><verse number="31" style="v" sid="EPH 5:31" />Ibyanditswe biravuga biti, “Ni co gituma umugabo azaasiga se na nyina akiifatanya n'umugore we, nuuko abo babiri bakaba umubiri umwe.” <verse eid="EPH 5:31" /><verse number="32" style="v" sid="EPH 5:32" />Iryo ni ibanga rikomeye ry'ukuri, ariko nje mvuga yuuko rivuga kuri Kristo n'itoorero rye. <verse eid="EPH 5:32" /><verse number="33" style="v" sid="EPH 5:33" />Nuuko reero namwe, buri mugabo akwiriye gukunda umugore we nk'uko yiikunda, kandi buri mugore akuubaha umugabo we.<verse eid="EPH 5:33" /></para>
  <chapter eid="EPH 5" />
  <chapter number="6" style="c" sid="EPH 6" />
  <para style="s1">Abaana n'Ababyeyi</para>
  <para style="p">
    <verse number="1" style="v" sid="EPH 6:1" />
    <note caller="-" style="x">
      <char style="xo" closed="false">6:1 </char>
      <char style="xt" closed="false">
        <ref loc="COL 3:20">Kol 3:20</ref>.</char>
    </note>Baana, muje mwumvira ababyeyi baanyu kuko ari byo bikwiriye abari muri Nyagasani. <verse eid="EPH 6:1" /><verse number="2" style="v" sid="EPH 6:2" />“Wubahe so na nyoko” ni ryo tegeko rya mbere rijaana n'iseezerano: <verse eid="EPH 6:2" /><verse number="3" style="v" sid="EPH 6:3" />“kugira ngo bizaakugendere neeza, maze uramire ku isi.”<verse eid="EPH 6:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="EPH 6:4" />
    <note caller="-" style="x">
      <char style="xo" closed="false">6:4 </char>
      <char style="xt" closed="false">
        <ref loc="COL 3:21">Kol 3:21</ref>.</char>
    </note>Namwe kandi ba se b'abaana, ntimukaraakaze abaana baanyu, ahuubwo mubarere neeza mubiigiisha ibya Nyagasani.<verse eid="EPH 6:4" /></para>
  <para style="s1">Imbaata na ba Sheebuja</para>
  <para style="p">
    <verse number="5" style="v" sid="EPH 6:5" />
    <note caller="-" style="x">
      <char style="xo" closed="false">6:5 </char>
      <char style="xt" closed="false">
        <ref loc="COL 3:22-25">Kol 3:22-25</ref>.</char>
    </note>Namwe mbaata, muje mwumvira ba shoobuja bo ku isi kandi mubuubahe mubikuuye ku mutima nk'abuubaha Kristo. <verse eid="EPH 6:5" /><verse number="6" style="v" sid="EPH 6:6" />Muje mubikora bidateewe n'uko babareeba byonyine, mushaaka ngo babashiime, ahuubwo muje mubikora n'umutima umwe nk'abagaragu ba Kristo mubikuuye ku mutima nk'uko Imaana ibishaaka. <verse eid="EPH 6:6" /><verse number="7" style="v" sid="EPH 6:7" />Muje mukorera ba shoobuja n'umutima umwe nk'abakorera Nyagasani, mutari nk'abakorera abantu. <verse eid="EPH 6:7" /><verse number="8" style="v" sid="EPH 6:8" />Mumenye yuuko Nyagasani azaahemba buri muntu, yaaba imbaata cangwa uwiigenga, akurikije imirimo myiza yakoze.<verse eid="EPH 6:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="EPH 6:9" />
    <note caller="-" style="x">
      <char style="xo" closed="false">6:9 a </char>
      <char style="xt" closed="false">
        <ref loc="COL 4:1">Kol 4:1</ref>; </char>
      <char style="xo" closed="false">b </char>
      <char style="xt" closed="false">
        <ref loc="COL 3:25">Kol 3:25</ref>.</char>
    </note>Namwe bakoreesha, muje mugirira mutyo abagaragu baanyu, mureke kubakangiisha ibihano. Mumenye yuuko mwebwe n'abagaragu baanyu musangiye Shoobuja wo mu ijuru, utarobaanura abantu ku butoni.<verse eid="EPH 6:9" /></para>
  <para style="s1">Intwaro z'Umukristo</para>
  <para style="p">
    <verse number="10" style="v" sid="EPH 6:10" />Ahasigaye reero, nimukomezwe n'imbaraga zihebuuje za Nyagasani. <verse eid="EPH 6:10" /><verse number="11" style="v" sid="EPH 6:11" />Mwambare intwaro zoose ziturutse ku Maana, kugira ngo muzaashobore guhangana n'uburiganya bwa Sataani. <verse eid="EPH 6:11" /><verse number="12" style="v" sid="EPH 6:12" />Kuko ntiturwana n'abantu, ahuubwo turwana n'imyuka mibi itegeka ikireere, ibikomangoma n'ibihangaage, n'abategeka iyi si y'umwijima. <verse eid="EPH 6:12" /><verse number="13" style="v" sid="EPH 6:13" />Nuuko reero nimwambare intwaro z'Imaana, kugira ngo umunsi mubi ni ugera, muzaashobore guhangana n'igiteero c'umwanzi, kandi intambara n'irangira, muzaahagarare mudatsinzwe.<verse eid="EPH 6:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="EPH 6:14" />Nuuko reero nimuhagarare kigabo, mukenyere ukuri nk'umushumi, kandi mwambare gukiraanuka nk'icuuma gikingira igituuza. <verse eid="EPH 6:14" /><verse number="15" style="v" sid="EPH 6:15" />Naho ingato zo mu birenge byanyu, zibe umwete wo kwamamaza Inkuru Nziiza y'amahoro. <verse eid="EPH 6:15" /><verse number="16" style="v" sid="EPH 6:16" />Igihe coose, muje mwitwaza ingabo yo kwizeera, kuko ari yo muziifashiisha kuzimya imyambi igurumana, iraswa n'umubi. <verse eid="EPH 6:16" /><verse number="17" style="v" sid="EPH 6:17" />Nimwakiire agakiza nk'ingofero y'icuuma, kandi n'ijambo ry'Imaana nk'inkoota muhaabwa n'Umwuka. <verse eid="EPH 6:17" /><verse number="18" style="v" sid="EPH 6:18" />Igihe mukora ibyo, muje musenga, musaba Imaana kubafasha. Muje musenga buri gihe muyobowe n'Umwuka. Ku bw'ibyo, mugume muri maaso kandi muhore musabira abantu b'Imaana. <verse eid="EPH 6:18" /><verse number="19" style="v" sid="EPH 6:19" />Nanje munsabire kugira ngo nimbumbuura akanwa, Imaana impe ubutumwa bukwiriye, kugira ngo mvuge nshize amanga menyeeshe abantu ibanga ry'ubutumwa bwiza. <verse eid="EPH 6:19" /><verse number="20" style="v" sid="EPH 6:20" />Ubwo butumwa ni bwo mpagarariye n'ubwo ndi mu gihome. Icampa nkavuga ubutumwa nshize amanga nk'uko bikwiriye.<verse eid="EPH 6:20" /></para>
  <para style="s1">Umusoozo</para>
  <para style="p">
    <verse number="21" style="v" sid="EPH 6:21" />
    <note caller="-" style="x">
      <char style="xo" closed="false">6:21 </char>
      <char style="xt" closed="false">
        <ref loc="ACT 20:4">Iby 20:4</ref>; <ref loc="2TI 4:12">2 Tim 4:12</ref>.</char>
    </note>
    <note caller="-" style="x">
      <char style="xo" closed="false">6:21 </char>
      <char style="xt" closed="false">
        <ref loc="COL 4:7">Kol 4:7</ref>,<ref loc="COL 4:8">8</ref>.</char>
    </note>Tukiko, umuvandimwe waacu dukunda kandi umugaragu wiringirwa mu murimo wa Nyagasani, azaababwira uko meze, kugira ngo mumenye uko meze. <verse eid="EPH 6:21" /><verse number="22" style="v" sid="EPH 6:22" />Ni co gitumye mubatumaho kugira ngo ababwire uko twese tumeze, hamwe no kubakomeza.<verse eid="EPH 6:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="EPH 6:23" />Amahoro n'urukundo hamwe no kwizeera bikomooka ku Maana Daata n'Umwami Yesu Kristo, bihorane n'abavandimwe biizeera. <verse eid="EPH 6:23" /><verse number="24" style="v" sid="EPH 6:24" />Ubuntu bw'Imaana bubaane n'abo boose bakunda Umwami Yesu Kristo n'urukundo rudateezuuka.<verse eid="EPH 6:24" /></para>
  <chapter eid="EPH 6" />
</usx>