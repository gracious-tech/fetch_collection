<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="GAL" style="id">- Rufumbira New Testament</book>
  <para style="h">ABAGALATIYA</para>
  <para style="toc3">Gal</para>
  <para style="toc2">ABAGALATIYA</para>
  <para style="toc1">Urwandiko Intumwa Pawulo yandikiye ABAGALATIYA</para>
  <para style="mt1">ABAGALATIYA</para>
  <para style="imt">INYANZURO</para>
  <para style="im">Ubutumwa Bwiza bwa Yesu butangiye kwamamazwa no kwakiirwa mu bantu batari Abayuuda, abantu benshi biibazaga niiba koko umuntu agomba kuubahiriza amategeko ya Moose kugira ngo abe umukristo nyakuri. Pawulo yari yaravuze ko ibi bitaari ngombwa, ahuubwo ko iciifuzwa gikuru mu buzima bwo muri Kristo ari ukwizeera, anari ko gutuma abantu batungaanira Imaana. Ariko mu matoorero amwe y'i Galatiya, igice c'i Rooma muri Asiya nto, haari abantu baaje bahakanya Pawulo bavuga ko umuntu akwiriye no gukurikiza amategeko ya Moose kugira ngo atungaanire Imaana.</para>
  <para style="ip">
    <char style="bk">Urwandiko Intumwa Pawulo yandikiye Abagalatiya</char> rwanditswe kugira ngo rugarure kwizeera nyakuri n'imitwarize mu bantu baari baarayobejwe n'inyigiisho z'ibinyoma. Pawulo atangira ashigikira uburenganzira bwe bwo kwitwa intumwa ya Yesu Kristo. Ntaabwo ateezuuka kuvuga ko umuhamagaro we wo kuba intumwa wavuuye ku Maana atari ku bushobozi bw'umuntu, kandi ko umurimo we wari ugenewe na caane abanyamahanga. Nuuko reero azana igiteekerezo kivuga ko umuntu atungaanira Imaana ku bwo kwizeera gusa. Mu bice bisooza byo muri uru rwandiko, Pawulo yeerekana ko imyifatire ya gikristo iva mu rukundo ruturuka mu kwizeera Kristo.</para>
  <para style="iot">Ibirimo</para>
  <para style="io1">Inyanzuro <char style="ior"><ref loc="GAL 1:1-10">1:1-10</ref></char></para>
  <para style="io1">Ububaasha bwa Pawulo nk'intumwa <char style="ior"><ref loc="GAL 1:11-2:21">1:11—2:21</ref></char></para>
  <para style="io1">Ubutumwa bw'Ubuntu bw'Imaana<char style="ior"><ref loc="GAL 3:1-4:31">3:1—4:31</ref></char></para>
  <para style="io1">Umudendeezo w'Umukristo n'inshingano ze <char style="ior"><ref loc="GAL 5:1-6:10">5:1—6:10</ref></char></para>
  <para style="io1">Umusoozo<char style="ior"><ref loc="GAL 6:11-18">6:11-18</ref></char></para>
  <chapter number="1" style="c" sid="GAL 1" />
  <para style="s">Indamutso</para>
  <para style="p">
    <verse number="1" style="v" sid="GAL 1:1" />Njeewe Pawulo wahamagariwe kuba intumwa bidakomootse ku bantu cangwa ku bushobozi bwabo ahuubwo bikomootse kuri Yesu Kristo n'Imaana Daata yamuzuuye mu baapfuuye, <verse eid="GAL 1:1" /><verse number="2" style="v" sid="GAL 1:2" />hamwe n'abiizeera turi kumwe boose, turabaramutsa mwebwe abo mu matoorero y'i Galatiya.<verse eid="GAL 1:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="GAL 1:3" />Tubiifuurije ubuntu n'amahoro biva ku Maana Daata no ku Mwami Yesu Kristo,<verse eid="GAL 1:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="GAL 1:4" />watanze ubugingo bwe ku bw'ibyaha byacu kugira ngo adukize iki gihe kibi ca noone nk'uko Imaana Daata yabishaatse. <verse eid="GAL 1:4" /><verse number="5" style="v" sid="GAL 1:5" />Icuubahiro kibe ic'Imaana iteeka ryose! Amiina.<verse eid="GAL 1:5" /></para>
  <para style="s">Ubutumwa Bwiza Bumwe Rukumbi</para>
  <para style="p">
    <verse number="6" style="v" sid="GAL 1:6" />Ntangaajwe n'uko mu gihe gito mutangiye kuva kuwabahamagaye abiteewe n'ubuntu mwagiriwe na Kristo, maze mukeemera ubundi butumwa. <verse eid="GAL 1:6" /><verse number="7" style="v" sid="GAL 1:7" />Nyamara ntaabundi butumwa bubaho, ahuubwo hariho abantu baahagurukiye kubayobya no gushaaka guhindura Ubutumwa Bwiza bwa Kristo. <verse eid="GAL 1:7" /><verse number="8" style="v" sid="GAL 1:8" />Ariko reero hagize undi muntu ubabwiriza ubutumwa butandukanye n'ubwo twabagejejeho, n'aho yaaba twebwe cangwa malayika uvuuye mu ijuru, avumwe! <verse eid="GAL 1:8" /><verse number="9" style="v" sid="GAL 1:9" />Nk'uko twababwiye mbere, na n'ubu mbisubiyemo, uzaababwiriza ubutumwa butandukanye n'ubwo mwakiiriye, avumwe!<verse eid="GAL 1:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="GAL 1:10" />Mbese muteekereza ko niifuuza gushimwa n'abantu cangwa n'Imaana? Aho ntimuteekereza ko mparanira kuneezeeza abantu? Mbaaye ngerageza kuneezeeza abantu sinaaba nkiri umugaragu wa Kristo.<verse eid="GAL 1:10" /></para>
  <para style="s">Uko Pawulo Yabaaye Intumwa ya Kristo</para>
  <para style="p">
    <verse number="11" style="v" sid="GAL 1:11" />Bavandimwe, reka mbamenyeeshe yuuko Ubutumwa Bwiza nababwirije budakomooka ku bantu. <verse eid="GAL 1:11" /><verse number="12" style="v" sid="GAL 1:12" />Sinigeze mbuhaabwa n'umuntu weese kandi sinabwigiishijwe n'umuntu, ahuubwo ni Yesu Kristo wabumpishuuriye.<verse eid="GAL 1:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="GAL 1:13" />
    <note caller="-" style="x">
      <char style="xo" closed="false">1:13 </char>
      <char style="xt" closed="false">
        <ref loc="ACT 8:3">Iby 8:3</ref>; <ref loc="ACT 22:4">22:4</ref>,<ref loc="ACT 22:5">5</ref>; <ref loc="ACT 26:9-11">26:9-11</ref>.</char>
    </note>Mwumviise uko nagenzaga nkiri umuyoboke w'idiini y'Abayuuda. Natooteje itoorero ry'Imaana ntaawe ngirira imbabazi nshaaka kuritsemba. <verse eid="GAL 1:13" /><verse number="14" style="v" sid="GAL 1:14" /><note caller="-" style="x"><char style="xo" closed="false">1:14 </char><char style="xt" closed="false"><ref loc="ACT 22:3">Iby 22:3</ref>.</char></note>Narushije benshi bo mu bwoko bwacu tungana gukurikiza idiini y'Abayuuda, kandi nabarushaga kugira umuhaati wo gushira imbere imigenzo twasigiwe na ba sogokuruza.<verse eid="GAL 1:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="GAL 1:15" />
    <note caller="-" style="x">
      <char style="xo" closed="false">1:15 </char>
      <char style="xt" closed="false">
        <ref loc="ACT 9:3-6">Iby 9:3-6</ref>; <ref loc="ACT 22:6-10">22:6-10</ref>; <ref loc="ACT 26:13-18">26:13-18</ref>.</char>
    </note>Ariko Imaana yantooranyije ntaraavuuka, impamagarira kuyikorera ku bw'ubuntu bwayo. Yahisemo <verse eid="GAL 1:15" /><verse number="16" style="v" sid="GAL 1:16" />kumpishuurira Umwana waayo, kugira ngo naamamaze Ubutumwa Bwiza mu banyamahanga. Siniigeze nja kugiisha inaama umuntu weese kugira ngo menye ico gukora, <verse eid="GAL 1:16" /><verse number="17" style="v" sid="GAL 1:17" />habe no kuja i Yerusaalemu kubaza abambanjirije kuba intumwa, ahuubwo nagendeye kimwe muri Araabiya kandi mvuuyeyo nsubira i Damasiko. <verse eid="GAL 1:17" /><verse number="18" style="v" sid="GAL 1:18" /><note caller="-" style="x"><char style="xo" closed="false">1:18 </char><char style="xt" closed="false"><ref loc="ACT 9:26-30">Iby 9:26-30</ref>.</char></note>Nuuko imyaka itatu ishize ndazaamuuka nja i Yerusaalemu gusuura Peetero, marana na we iminsi cumi n'itaanu. <verse eid="GAL 1:18" /><verse number="19" style="v" sid="GAL 1:19" />Ariko sinigeze mbona izindi ntumwa keretse Yaakobo mwene se w'Umwami waacu.<verse eid="GAL 1:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="GAL 1:20" />Ibyo mbandikiye byose ni ukuri, Imaana irabiizi ko ntabeesha!<verse eid="GAL 1:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="GAL 1:21" />Haanyuma y'urwo ruzinduko, nagiiye mu bice binini bya Siriya na Silisiya. <verse eid="GAL 1:21" /><verse number="22" style="v" sid="GAL 1:22" />Muri ibyo bihe, abo mu matoorero ya Kristo y'i Yudeeya ntaabwo baari baakamboonyeho. <verse eid="GAL 1:22" /><verse number="23" style="v" sid="GAL 1:23" />Ukuuyeho baari baarumviise abamvugagaho bati, “Waawundi wadutootezaga keera asigaye yaamamaza ukwizeera yarwanyaga.” <verse eid="GAL 1:23" /><verse number="24" style="v" sid="GAL 1:24" />Nuuko bahimbaaza Imaana ku bwanje.<verse eid="GAL 1:24" /></para>
  <chapter eid="GAL 1" />
  <chapter number="2" style="c" sid="GAL 2" />
  <para style="s">Pawulo n'Izindi Ntumwa</para>
  <para style="p">
    <verse number="1" style="v" sid="GAL 2:1" />
    <note caller="-" style="x">
      <char style="xo" closed="false">2:1 </char>
      <char style="xt" closed="false">
        <ref loc="ACT 11:30">Iby 11:30</ref>; <ref loc="ACT 15:2">15:2</ref>.</char>
    </note>Haanyuma y'imyaka cumi n'enye nsubira i Yerusaalemu ndi hamwe na Barinaba, niitwaza Tito. <verse eid="GAL 2:1" /><verse number="2" style="v" sid="GAL 2:2" />Nagiiyeyo kuko Imaana yari yampishuuriye ko njayo. Nuuko ngiraho inaama y'umwihereero n'abayobozi b'itoorero mbasobaanurira ubutumwa mbwiriza abanyamahanga. Kwari ukugira ngo ntaba nararuhiye ubusa cangwa kongera kwiruhiriza ubusa. <verse eid="GAL 2:2" /><verse number="3" style="v" sid="GAL 2:3" />Ariko na Tito uwo twari kumwe ntibiigeze bamuhata gukebwa nuubwo yari Umugiriki. <verse eid="GAL 2:3" /><verse number="4" style="v" sid="GAL 2:4" />Nyamara hariho indyarya ziiyita abiizeera zinjiye muri twe rwihishwa zigendereye kugenzuura umudendeezo dufite muri Kristo Yesu, kugira ngo zidushire mu bubaata. <verse eid="GAL 2:4" /><verse number="5" style="v" sid="GAL 2:5" />Ariko ntitwigeze tuzumvira na hato kugira ngo ukuri k'Ubutumwa Bwiza kugume muri mwe kudahinyutse.<verse eid="GAL 2:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GAL 2:6" />Ariko abandi biitwa abayobozi (ico bari co ntibindeeba, kuko Imaana itarobaanura ku butoni), abo bayobozi ntaaco baanyongeereyeho ku byo niigiishaga. <verse eid="GAL 2:6" /><verse number="7" style="v" sid="GAL 2:7" />Ahuubwo baaboonye ko Imaana yampaaye umurimo wo kubwiriza ubutumwa mu banyamahanga nk'uko Peetero na we yahaawe umurimo wo kubwiriza mu baakebwe. <verse eid="GAL 2:7" /><verse number="8" style="v" sid="GAL 2:8" />Kuko uwahaaye Peetero kuba intumwa mu baakebwe ni na we wampaaye kuba intumwa mu banyamahanga. <verse eid="GAL 2:8" /><verse number="9" style="v" sid="GAL 2:9" />Yaakobo, Peetero na Yohaana ari bo biitwa inkingi z'umuryango w'Imaana, bamaze kumenya impaano nahaawe nje na Barinaba badukora mu ntoki, nk'ikimenyeetso co gufatanya no kwemera ko njeewe na Barinaba tuja mu banyamahanga naho bo bakaguma mu baakebwe. <verse eid="GAL 2:9" /><verse number="10" style="v" sid="GAL 2:10" />Ikintu kimwe baatwihanangirije kwari ukuja twibuka abakene kandi ari na co nanje nashiishikariye gukora.<verse eid="GAL 2:10" /></para>
  <para style="s">Pawulo Yamagirira Peetero muri Antiyokiya</para>
  <para style="p">
    <verse number="11" style="v" sid="GAL 2:11" />Igihe Peetero yaazaga muri Antiyokiya, namuhakanyije kumugaragaro kuko byari bigaragara ko ari mu nshobe. <verse eid="GAL 2:11" /><verse number="12" style="v" sid="GAL 2:12" />Mbere y'uko abantu baturutse kwa Yaakobo bahagera, Peetero yasangiraga n'abanyamahanga. Aho baagereyeyo, abiivaanamo, arabaneena kuko yatiinyaga abaashigikiraga gukebwa. <verse eid="GAL 2:12" /><verse number="13" style="v" sid="GAL 2:13" />Nuuko n'abandi bakristo b'Abayuuda biiyunga kuri Peetero mu buryarya, bigeze aho Barinaba na we yoshwa na bo mu kuryarya kwabo. <verse eid="GAL 2:13" /><verse number="14" style="v" sid="GAL 2:14" />Ariko mboonye ko batari gukurikiza ukuri k'Ubutumwa Bwiza, mbwira Peetero boose babireeba nti, “Niiba wowe Umuyuuda wiifata nk'abanyamahanga, ntiwiifate nk'Abayuuda, ni iki gituma uhata abanyamahanga gukurikiza imigenzo y'Abayuuda?”<verse eid="GAL 2:14" /></para>
  <para style="s">Abayuuda na abanyamahanga Bakizwa ku bwo Kwizeera</para>
  <para style="p">
    <verse number="15" style="v" sid="GAL 2:15" />Koko twebwe turi Abayuuda kavuukire, ntituri abanyamahanga b'abanyabyaha. <verse eid="GAL 2:15" /><verse number="16" style="v" sid="GAL 2:16" /><note caller="-" style="x"><char style="xo" closed="false">2:16 a </char><char style="xt" closed="false"><ref loc="ROM 3:20">Rom 3:20</ref>; </char><char style="xo" closed="false">b </char><char style="xt" closed="false"><ref loc="ROM 3:22">Rom 3:22</ref>.</char></note>Ariko tuuzi yuuko umuntu adatsindishirizwa n'imirimo itegetswe n'amategeko ahuubwo atsindishirizwa no kwizeera Yesu Kristo, bidateewe no kuubahiriza amategeko kuko ntaan'umwe utsindishirizwa abikeesheje imirimo itegetswe n'amategeko. <verse eid="GAL 2:16" /><verse number="17" style="v" sid="GAL 2:17" />Mbese, niiba dushaaka gutsindishirizwa muri Kristo, ariko naatwe ubwacu tugasangwa turi abanyabyaha, ibyo bivuga ko Kristo ari we utuma abantu bagwa mu byaha? Oya ntibikabeho! <verse eid="GAL 2:17" /><verse number="18" style="v" sid="GAL 2:18" />Ariko niiba nongera kugengwa n'amategeko naretse, mba neerekanye ko ndi umunyabyaha. <verse eid="GAL 2:18" /><verse number="19" style="v" sid="GAL 2:19" />Nyamara njeewe napfuuye kubyerekeye kuubahiriza amategeko, kugira ngo mbeho ku bw'Imaana. Nabambanywe na Kristo ku musaraba, <verse eid="GAL 2:19" /><verse number="20" style="v" sid="GAL 2:20" />ariko noone si nje uriho, ahuubwo ni Kristo uriho muri nje. Ubuzima mbamo muri uyu mubiri, mbubamo mbishobozwa no kwizeera Umwana w'Imaana, wankunze, akanyiitangira ku musaraba. <verse eid="GAL 2:20" /><verse number="21" style="v" sid="GAL 2:21" />Nje sinaasuuzugura ubuntu bw'Imaana, kuko niiba gutungaanira Imaana kuzanwa no kuubahiriza amategeko, kimenyeesha ko Kristo yapfiiriye ubusa.<verse eid="GAL 2:21" /></para>
  <chapter eid="GAL 2" />
  <chapter number="3" style="c" sid="GAL 3" />
  <para style="s">Itegeko cangwa Kwizeera</para>
  <para style="p">
    <verse number="1" style="v" sid="GAL 3:1" />Yemwe Bagalatiya b'abapfaapfa mwe! Mbese ni nde wabaroze? Ntimwagaragarijwe urupfu Yesu Kristo yapfuuye ku musaraba? <verse eid="GAL 3:1" /><verse number="2" style="v" sid="GAL 3:2" />Nshaaka ko mumbwira iki gusa: Mbese kuubahiriza amategeko ni co caabaheesheje Umwuka Weera cangwa se ni uko mwumviise Ubutumwa mukiizeera? <verse eid="GAL 3:2" /><verse number="3" style="v" sid="GAL 3:3" />Mbese muri abapfaapfa mutyo? Mwatangiranye n'Umwuka w'Imaana, noone muheruukanye no gukorera mu mbaraga z'umubiri.? <verse eid="GAL 3:3" /><verse number="4" style="v" sid="GAL 3:4" />Mbese ibyo mwanyuzemo mubabara, byababeereye imfaabusa? Ni ukuri hari ico byabamariye! <verse eid="GAL 3:4" /><verse number="5" style="v" sid="GAL 3:5" />Mbese Imaana ibaha Umwuka waayo, igakora ibitangaaza muri mwe ibiteerwa n'uko mwubahiriza amategeko cangwa n'uko mwumviise Ubutumwa mukiizeera?<verse eid="GAL 3:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GAL 3:6" />
    <note caller="-" style="x">
      <char style="xo" closed="false">3:6 </char>
      <char style="xt" closed="false">
        <ref loc="ROM 4:3">Rom 4:3</ref>.</char>
    </note>Ni na ko byabaaye kuri Aburahamu, “Yiizeeye Imaana, bituma Imaana imwemera nk'umukiraanutsi.” <verse eid="GAL 3:6" /><verse number="7" style="v" sid="GAL 3:7" /><note caller="-" style="x"><char style="xo" closed="false">3:7 </char><char style="xt" closed="false"><ref loc="ROM 4:16">Rom 4:16</ref>.</char></note>Nuuko reero mumenye yuuko abaana ba Aburahamu nyakuri ari abo biizeera Imaana. <verse eid="GAL 3:7" /><verse number="8" style="v" sid="GAL 3:8" />Kandi ibyanditswe byari byaragaragaje yuuko Imaana izatsindishiriza abanyamahanga ku bwo kwizeera kwabo. Kandi ibyanditswe byatangaaje Ubutumwa Bwiza kuri Aburahamu mbere y'igihe, ngo, “Muri wowe imiryango yoose yo mu isi izaguheerwamo umugisha.” <verse eid="GAL 3:8" /><verse number="9" style="v" sid="GAL 3:9" />Nuuko reero, abo beemera Kristo bahaabwa umugisha nk'uko Aburahamu yawuhaawe ku bwo kwizeera.<verse eid="GAL 3:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="GAL 3:10" />Naho abiishingikiriza ku kuubahiriza amategeko baba bari mu muvumo, kuko byanditswe ngo, “Havumwe umuntu weese udakurikiza ibyanditswe byose mu gitabo c'amategeko.” <verse eid="GAL 3:10" /><verse number="11" style="v" sid="GAL 3:11" />Ubu birasobaanutse yuuko ari nta muntu utsindishirizwa n'amategeko imbere y'Imaana, kuko byanditswe ngo, “Umukiraanutsi azaabeeshwaho no kwizeera.” <verse eid="GAL 3:11" /><verse number="12" style="v" sid="GAL 3:12" />Nyamara amategeko ntaaco ahuuriyeho no kwizeera, ariko reero ibyanditswe biravuga ngo, “Uzuubahiriza amategeko, azaabeeshwaho na yo.”<verse eid="GAL 3:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="GAL 3:13" />Kristo yaducunguye kugira ngo dukizwe umuvumo w'amategeko, ahinduka ikivume ku bwacu, nk'uko byanditswe ngo, “Havumwe umuntu weese umanitswe ku giti.” <verse eid="GAL 3:13" /><verse number="14" style="v" sid="GAL 3:14" />Muri Kristo Yesu, Imaana yahaaye umugisha abanyamahanga usa n'uwo yaseezeranyije Aburahamu, kugira ngo ku bwo kwizeera, twe abeemera, tuzaahaabwe Umwuka Weera twaseezeranyijwe.<verse eid="GAL 3:14" /></para>
  <para style="s">Itegeko n'Iseezerano</para>
  <para style="p">
    <verse number="15" style="v" sid="GAL 3:15" />Bavandimwe, reka mbabwire nkurikije urugero mu buzima busanzwe: Iyo abantu babiri bagize ico beemeranya maze bagakora amaseezerano, bagashiraho ukuboko, ntaamuntu ushobora kuyiica cangwa ngo agire ico yongeraho. <verse eid="GAL 3:15" /><verse number="16" style="v" sid="GAL 3:16" />Imaana yakoranye iseezerano na Aburahamu n'urubyaro rwe. Ibyanditswe ntibivuga ko ari “Imbyaro” nk'aho ari abantu benshi, ahuubwo ni “urubyaro rwawe”, bimenyeesha umuntu umwe weenyine ari we Kristo. <verse eid="GAL 3:16" /><verse number="17" style="v" sid="GAL 3:17" />Ico nshaaka kuvuga ni iki: Imaana yakoze iseezerano na Aburahamu kandi irarikomeza. Itegeko ryahaawe Moose haanyuma y'imyaka magana ane na mirongo itatu, ntiryakwica iryo seezerano cangwa ngo ririkuureho. <verse eid="GAL 3:17" /><verse number="18" style="v" sid="GAL 3:18" /><note caller="-" style="x"><char style="xo" closed="false">3:18 </char><char style="xt" closed="false"><ref loc="ROM 4:14">Rom 4:14</ref>.</char></note>Kuko niiba umurage ushingiye ku tegeko, ntuuba ukivuuye ku byaseezeranyijwe. Ariko Imaana yawuhaaye Aburahamu binyuze mu iseezerano.<verse eid="GAL 3:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="GAL 3:19" />Noone se amategeko agamije iki? Yongereweho kugira ngo agaragaze ibicumuro kugeza ubwo urubyaro rwagenewe ibyaseezeranyijwe ruzaazira. Kandi yahaaye abaamalayika amategeko kuyaha Moose ari we muhuuza w'Imaana n'abantu. <verse eid="GAL 3:19" /><verse number="20" style="v" sid="GAL 3:20" />Ariko umuhuuza yiifuuzwa iyo abantu bareenze umwe, kandi Imaana ni imwe<verse eid="GAL 3:20" /></para>
  <para style="s">Ikigendererwa c'Itegeko</para>
  <para style="p">
    <verse number="21" style="v" sid="GAL 3:21" />Mbese ubwo bimeze bityo, amategeko ahakanya amaseezerano y'Imaana? Oya ntibikabeho! Kuko iyo amategeko aba yabeeshaho abantu, buri muntu yaagahindutse intungaane imbere y'Imaana ku bwo kuyumvira. <verse eid="GAL 3:21" /><verse number="22" style="v" sid="GAL 3:22" />Ariko ibyanditswe bivuga yuuko abari mu isi boose bari mu bubaata bw'icaaha, nuuko reero impaano Imaana yaduseezeranyije yo kutubaatuura, ibonerwa mu kwizeera Yesu Kristo igahaabwa abo beemera.<verse eid="GAL 3:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="GAL 3:23" />Icakora uko kwizeera kutaraaza, twari turi imbohe kandi turinzwe n'amategeko dutegereje kwizeera kwari kugiiye guhishuurwa. <verse eid="GAL 3:23" /><verse number="24" style="v" sid="GAL 3:24" />Bityo reero amategeko yaraturinze kugira ngo tudakora ikibi kugeza ubwo Kristo yaaziye, kugira ngo dutsindishirizwe no kwizeera. <verse eid="GAL 3:24" /><verse number="25" style="v" sid="GAL 3:25" />Ubwo reero kwizeera kwamaze kuuza, ntituciifuuza kuyoborwa n'amategeko, <verse eid="GAL 3:25" /><verse number="26" style="v" sid="GAL 3:26" />kuko mwese muri abaana b'Imaana mubiheeshejwe no kwizeera Kristo Yesu. <verse eid="GAL 3:26" /><verse number="27" style="v" sid="GAL 3:27" />Nk'uko benshi muri mwe mwabatijwe muri Kristo ni na ko mufite ubumwe na Kristo. <verse eid="GAL 3:27" /><verse number="28" style="v" sid="GAL 3:28" />Noone reero ntihakiriho Umuyuuda cangwa Umugiriki, imbaata cangwa uwiigenga, umugabo cangwa umugore, kuko mwese muri umwe muri Kristo Yesu. <verse eid="GAL 3:28" /><verse number="29" style="v" sid="GAL 3:29" /><note caller="-" style="x"><char style="xo" closed="false">3:29 </char><char style="xt" closed="false"><ref loc="ROM 4:13">Rom 4:13</ref>.</char></note>Ubwo reero muri aba Kristo, ni mwe rubyaro rwa Aburahamu, muri n'abaragwa b'iby'Imaana yaseezeranyije.<verse eid="GAL 3:29" /></para>
  <chapter eid="GAL 3" />
  <chapter number="4" style="c" sid="GAL 4" />
  <para style="p">
    <verse number="1" style="v" sid="GAL 4:1" />Ariko nshaaka kumenyeesha ngo, iyo umubyeyi apfuuye agasigira umwana we umurage, uwo mwana akiri muto ntaaho aba atandukaniye n'umugaragu, nuubwo ari we nyir'ibintu byose. <verse eid="GAL 4:1" /><verse number="2" style="v" sid="GAL 4:2" />Akiri muto aguma mu maboko y'abamurera n'abashinzwe ibintu bye kugeza igihe caategetswe na se. <verse eid="GAL 4:2" /><verse number="3" style="v" sid="GAL 4:3" />Ni ko naatwe twari tumeze tukiri bato. Twari imbaata, tugengwa n'imyuka mibi itegeka iyi si. <verse eid="GAL 4:3" /><verse number="4" style="v" sid="GAL 4:4" />Maze ko igihe gikwiriye caageze, Imaana yoohereje Umwana waayo wabyawe n'umugore, kandi avuuka agengwa n'amategeko y'Abayuuda, <verse eid="GAL 4:4" /><verse number="5" style="v" sid="GAL 4:5" /><note caller="-" style="x"><char style="xo" closed="false">4:5 </char><char style="xt" closed="false"><ref loc="ROM 8:15-17">Rom 8:15-17</ref>.</char></note>kugira ngo acungure abaari bakigengwa n'amategeko maze tubone kuba abaana b'Imaana.<verse eid="GAL 4:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GAL 4:6" />Kandi kuko muri abaana b'Imaana, ni co caatumye yoohereza Umwuka w'Umwana waayo mu mitima yaacu uhora utakamba uti, “Daata, Daata.” <verse eid="GAL 4:6" /><verse number="7" style="v" sid="GAL 4:7" />Nuuko reero, ntuukiri umugaragu ahuubwo uri umwana, kandi reero ubwo uri umwana waayo, Imaana yakugize umuragwa waayo.<verse eid="GAL 4:7" /></para>
  <para style="s">Pawulo Ahangayika ku bw'Abagalatiya</para>
  <para style="p">
    <verse number="8" style="v" sid="GAL 4:8" />Mbere mutaraamenya Imaana, mwari imbaata, mukorera ibigirwamaana bitabaho. <verse eid="GAL 4:8" /><verse number="9" style="v" sid="GAL 4:9" />Ariko noone, ubwo mwamenye Imaana, ndetse na yo ikaba ibaazi, ni iki gituma musubira inyuma mu bya keera mukumvira imyuka mibi idafite imbaraga n'umumaro? Ni iki gituma mushaaka kongera kuba imbaata zaabyo? <verse eid="GAL 4:9" /><verse number="10" style="v" sid="GAL 4:10" />Mwubahiriza iminsi ikomeye, ameezi, ibihe, n'imyaka. <verse eid="GAL 4:10" /><verse number="11" style="v" sid="GAL 4:11" />Munteeye ubwoba yuuko ibyo nabakoreye byose naaba naravunikiye ubusa.<verse eid="GAL 4:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="GAL 4:12" />Ndabinginze bavandimwe, mumere nkanje, kuko nanje meze nkamwe. Nta kibi mwigeze munkorera. <verse eid="GAL 4:12" /><verse number="13" style="v" sid="GAL 4:13" />Muriibuka neeza yuuko icaatumye mbona uburyo bwo kwamamaza Ubutumwa Bwiza muri mwe ubwambere ari uko nari ndwaye. <verse eid="GAL 4:13" /><verse number="14" style="v" sid="GAL 4:14" />Ariko nuubwo umubiri wanje wari utameze neeza, ukababeera ikigeregezo, ntimwigeze mumpinyura cangwa ngo munyange. Ahuubwo mwanyakiiriye nka malayika w'Imaana, ndetse munyakiira nk'abaakiira Kristo Yesu. <verse eid="GAL 4:14" /><verse number="15" style="v" sid="GAL 4:15" />Ico gihe mwari munyishiimiye caane! Icaatumye muhinduka ni iki? Iyo bishoboka muba mwaranogooyemo amaaso yaanyu mukayampa. <verse eid="GAL 4:15" /><verse number="16" style="v" sid="GAL 4:16" />Mbese ubu mpindutse umwanzi waanyu ku bwo kubabwira ukuri?<verse eid="GAL 4:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="GAL 4:17" />Abo biigiisha b'ibinyoma beerekana yuuko babiitaayeho caane, nyamara ibigendererwa byabo si byiza, kuko ico bashaaka n'ukuntandukanya namwe, kugira ngo abe ari bo mwitaho. <verse eid="GAL 4:17" /><verse number="18" style="v" sid="GAL 4:18" />Nihagira umuntu ugira umwete wo gukora ibyiza, naabikore igihe coose, atari igihe ndi kumwe namwe coonyine. <verse eid="GAL 4:18" /><verse number="19" style="v" sid="GAL 4:19" />Baana banje, nk'uko umugore uri ku bise ababara, ni ko nanje mbabazwa namwe kugeza igihe kamere ya Kristo izaagaragarira muri mwe. <verse eid="GAL 4:19" /><verse number="20" style="v" sid="GAL 4:20" />Icampa ubu nkaba ndikumwe namwe, ngahindura uburyo mvugana namwe, kuko ibyanyu bimpangayikiishije.<verse eid="GAL 4:20" /></para>
  <para style="s">Urugero rwa Sara na Hagari</para>
  <para style="p">
    <verse number="21" style="v" sid="GAL 4:21" />Ngaaho nimumbwire mwebwe abashaaka gutwarwa n'amategeko, mbese ntimwumva ibyo amategeko avuga? <verse eid="GAL 4:21" /><verse number="22" style="v" sid="GAL 4:22" />Byanditswe yuuko Aburahamu yari afite abahungu babiri, umwe yamubyaranye n'umuja, undi amubyarana n'umugore we. <verse eid="GAL 4:22" /><verse number="23" style="v" sid="GAL 4:23" />Yabyaranye n'umuja nk'uko bisanzwe mu buryo bw'umubiri, naho umwana w'umugore we yavuutse ku bw'iseezerano ry'Imaana. <verse eid="GAL 4:23" /><verse number="24" style="v" sid="GAL 4:24" />Imivuukire y'aba bahungu bombi ni nk'umugani w'incaamarenga. Aba bagore bombi bahagarariye amaseezerano abiri. Umugore umwe ari we Hagari wabyariye abaana be mu bubaata ahagarariye iseezerano ryakorewe ku musozi wa Sinaayi. <verse eid="GAL 4:24" /><verse number="25" style="v" sid="GAL 4:25" />Hagari uhagarariye umusozi wa Sinaayi wo muri Araabiya, agereranywa n'i tawuni nkuru ya Yerusaalemu y'ubu iri mu bubaata n'abantu baayo boose. <verse eid="GAL 4:25" /><verse number="26" style="v" sid="GAL 4:26" />Naho undi mugore, ahagarariye Yerusaalemu yo mu ijuru yiigenga, kandi ni we mubyeyi waacu. <verse eid="GAL 4:26" /><verse number="27" style="v" sid="GAL 4:27" />Kuko ibyanditswe bivuga ngo,</para>
  <para style="q1" vid="GAL 4:27">“Ishiime yewe mugore w'ingumba utaariigeze ubyara!</para>
  <para style="q2" vid="GAL 4:27">Rangurura maze uvuze impudu z'umuneezeero, wowe utaariigeze umenya ububabare bw'ibise</para>
  <para style="q1" vid="GAL 4:27">Kuko abaana b'intaabwa ari benshi</para>
  <para style="q2" vid="GAL 4:27">kuruta ab'umugore w'inkundwakazi w'umugabo we atiigeze areka.”<verse eid="GAL 4:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="GAL 4:28" />Nuuko reero bavandimwe, namwe muri abaana b'iseezerano nk'uko Isaaka yari ari. <verse eid="GAL 4:28" /><verse number="29" style="v" sid="GAL 4:29" />Kandi uko byabaaye ico gihe, uwavuutse ku bwa kamere y'umubiri yatootezaga uwavuutse ku bw'Umwuka, na n'ubu ni ko bimeze. <verse eid="GAL 4:29" /><verse number="30" style="v" sid="GAL 4:30" />Ariko se ibyanditswe bivuga iki? “Irukana umuja n'umuhungu we, kuko umwana w'umuja atazaagabana umurage n'umwana w'umugore wiigenga.” <verse eid="GAL 4:30" /><verse number="31" style="v" sid="GAL 4:31" />Nuuko reero bavandimwe, ntaabwo tukiri abaana b'umuja ahuubwo turi abaana b'umugore wiigenga.<verse eid="GAL 4:31" /></para>
  <chapter eid="GAL 4" />
  <chapter number="5" style="c" sid="GAL 5" />
  <para style="s">Kamere y'Umudendeezo wa Gikristo</para>
  <para style="p">
    <verse number="1" style="v" sid="GAL 5:1" />Umudendeezo dufite ni uko Kristo yatubohooye. Nuuko reero nimuhagarare mushikamye, mwirinda gusubira mu bubaata.<verse eid="GAL 5:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="GAL 5:2" />Nimwumve! Njeewe Pawulo ndababwira yuuko nimwemera gukebwa, Kristo ntaaco yaaba akibamarira. <verse eid="GAL 5:2" /><verse number="3" style="v" sid="GAL 5:3" />Kandi ndongera kwihanangiriza umugabo weese wemera gukebwa yuuko akwiriye gukurikiza amategeko yoose. <verse eid="GAL 5:3" /><verse number="4" style="v" sid="GAL 5:4" />Mwebwe abashaaka gutsindishirizwa n'amategeko mwitandukanyije na Kristo, kuko mwaguuye mukava mu buntu bw'Imaana. <verse eid="GAL 5:4" /><verse number="5" style="v" sid="GAL 5:5" />Ariko twebwe ku bw'imbaraga z'Umwuka w'Imaana no kwizeera, dufite ubwuzu bwo kwakira ibyiringiro byo gukiraanuka Imaana yaduseezeranyije. <verse eid="GAL 5:5" /><verse number="6" style="v" sid="GAL 5:6" />Iyo turi muri Kristo, gukebwa cangwa kudakebwa ntaaco bimaze, ahuubwo igikuru ni ukwizeera kugaragarira mu rukundo.<verse eid="GAL 5:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="GAL 5:7" />Mbese ko mwakoraga neeza, ni nde wababujije gukurikiza ukuri? <verse eid="GAL 5:7" /><verse number="8" style="v" sid="GAL 5:8" />Beene uko kooshwa ntikwaturuka kuwabahamagaye. <verse eid="GAL 5:8" /><verse number="9" style="v" sid="GAL 5:9" /><note caller="-" style="x"><char style="xo" closed="false">5:9 </char><char style="xt" closed="false"><ref loc="1CO 5:6">1 Kor 5:6</ref>.</char></note>Nk'uko bivugwa ngo, “Igituubuura gike gituma ifu y'ingano ituubuuka.” Ni na ko ijambo rito rishobora kubahindura mwese. <verse eid="GAL 5:9" /><verse number="10" style="v" sid="GAL 5:10" />Niizeye ntashidiikanya yuuko ku bwa Nyagasani mutazaateekereza ukundi, kandi ubayobya, akabaazanira guhagarika imitima weese, Imaana izaamuhana.<verse eid="GAL 5:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="GAL 5:11" />Mbese Bavandimwe, niiba nkibwiriza ko gukebwa ari ngombwa, ni iki gituma ngitootezwa? Iyo mba nigiisha ibyo, ubutumwa bw'umusaraba mbwiriza buba ari ntaawe buteeye ikibazo. <verse eid="GAL 5:11" /><verse number="12" style="v" sid="GAL 5:12" />Icampa abo bababuza amahoro bashaaka ko mukebwa baakwikona.<verse eid="GAL 5:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="GAL 5:13" />Naho mwebwe bavandimwe, mwahamagariwe kuba ab'umudendeezo. Ariko umudendeezo mwahaawe mureke kuwuhindura urwitwazo rwo gukora ibyo kamere y'imibiri yaanyu irarikira, ahuubwo buri weese akorere mugenzi we abiteewe n'urukundo. <verse eid="GAL 5:13" /><verse number="14" style="v" sid="GAL 5:14" />Kuko amategeko yoose abumbiye muri rimwe ngo, “Ukunde mugenzi waawe nk'uko wiikunda.” <verse eid="GAL 5:14" /><verse number="15" style="v" sid="GAL 5:15" />Ariko reero, niiba mwifata nk'inyamaaswa, mugashikagurana, mugaconcomerana, muramenye ntimuzaamarane.<verse eid="GAL 5:15" /></para>
  <para style="s">Imirimo ya Kamere n'Imbuto z'Umwuka</para>
  <para style="p">
    <verse number="16" style="v" sid="GAL 5:16" />Ndababwira nti; nimuyoborwe n'Umwuka, ni bwo mutazaakora ibyo kamere irarikira. <verse eid="GAL 5:16" /><verse number="17" style="v" sid="GAL 5:17" /><note caller="-" style="x"><char style="xo" closed="false">5:17 </char><char style="xt" closed="false"><ref loc="ROM 7:15-23">Rom 7:15-23</ref>.</char></note>Kuko kamere irarikira ibyo Umwuka yanga, kandi ibyo Umwuka ushaaka bitandukanye n'ibyo kamere ishaaka. Ni co gituma ibyo mushaaka gukora atari byo mukora. <verse eid="GAL 5:17" /><verse number="18" style="v" sid="GAL 5:18" />Ariko niiba muyoborwa n'Umwuka, ntimuba mugihatwa gukurikiza amategeko.<verse eid="GAL 5:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="GAL 5:19" />Dore ibikorwa bya kamere biriigaragaza, ni ubusambanyi, gukora ibiteeye isoni, ubwomanzi, <verse eid="GAL 5:19" /><verse number="20" style="v" sid="GAL 5:20" />gusenga ibishushaanyo, kuroga, kwangana, amakimbirane, ishari, uburaakari, intonganya, ubutumviikana, amacaakubiri, <verse eid="GAL 5:20" /><verse number="21" style="v" sid="GAL 5:21" />umujinya, ubusinzi, kwiyandarika mu byo kunywa n'ubuheeheesi, n'ibindi bisa bityo. Ndabiihanangiriza nk'uko nabibabwiye kare, yuuko abakora ibisa bityo, ntaamurage bazaahaabwa mu Bwami bw'Imaana.<verse eid="GAL 5:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="GAL 5:22" />Ariko reero, imbuto z'Umwuka ni urukundo, umuneezeero, amahoro, kwihangaana, ubugwaneeza, ubupfura, kwiringirwa, <verse eid="GAL 5:22" /><verse number="23" style="v" sid="GAL 5:23" />kwiciisha bugufi no kwirinda. Ibimeze bityo ntaamategeko abihana. <verse eid="GAL 5:23" /><verse number="24" style="v" sid="GAL 5:24" />Aba Kristo Yesu baabambye kamere yaabo y'umubiri, n'ingeso mbi ndetse n'irari ku musaraba. <verse eid="GAL 5:24" /><verse number="25" style="v" sid="GAL 5:25" />Niiba tubeeshwaho n'Umwuka, tuje tuyoborwa n'Umwuka. <verse eid="GAL 5:25" /><verse number="26" style="v" sid="GAL 5:26" />Twekwishira heejuru cangwa ngo twenderanye, cangwa ngo tugirirane ishari.<verse eid="GAL 5:26" /></para>
  <chapter eid="GAL 5" />
  <chapter number="6" style="c" sid="GAL 6" />
  <para style="s">Kwakiirana Imitwaro</para>
  <para style="p">
    <verse number="1" style="v" sid="GAL 6:1" />Bavandimwe, nihagira ugwa mu caaha, mwebwe abayoborwa n'Umwuka mumugarure mumworoheye, ariko namwe mwirinde kugira ngo mutagwa mu bishuko. <verse eid="GAL 6:1" /><verse number="2" style="v" sid="GAL 6:2" />Mwakiirane imitwaro, bityo reero muzaaba mwumviye amategeko ya Kristo. <verse eid="GAL 6:2" /><verse number="3" style="v" sid="GAL 6:3" />Umuntu niyibwira ko akomeye, kandi ari ntaaco ari co, uwo aba yiibeesha. <verse eid="GAL 6:3" /><verse number="4" style="v" sid="GAL 6:4" />Buri muntu akwiriye gusuuzuma ibikorwa bye, nuuko ibyo bikorwa bye atari ibya mugenzi we ni byo bizaamuraata. <verse eid="GAL 6:4" /><verse number="5" style="v" sid="GAL 6:5" />Kuko buri muntu agomba kwikorera umutwaro we.<verse eid="GAL 6:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GAL 6:6" />Abiigiishwa ijambo ry'Imaana bakwiriye gusangira n'abiigiisha baabo ku byiza bafite.<verse eid="GAL 6:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="GAL 6:7" />Ntimukibeeshe, kuko Imaana ntinnyegwa. Ibyo umuntu abiba ni byo azaasaaruura. <verse eid="GAL 6:7" /><verse number="8" style="v" sid="GAL 6:8" />Ubiba imbuto zishiimiisha kamere ye, azaasaaruura urupfu. Naho ubiba imbuto zishiimiisha Umwuka w'Imaana, azaasaaruura ubugingo buhoraho. <verse eid="GAL 6:8" /><verse number="9" style="v" sid="GAL 6:9" />Ntitukarambirwe gukora ibyiza, kuko nitudacoogora, tuzaasaaruura igihe kigeze. <verse eid="GAL 6:9" /><verse number="10" style="v" sid="GAL 6:10" />Nuuko reero, igihe coose tuboonye uburyo, tuje tugirira abantu boose neeza, ariko caane caane ab'umuryango w'abiizeera.<verse eid="GAL 6:10" /></para>
  <para style="s">Amabwiriza ya Nyuma n'Indamutso</para>
  <para style="p">
    <verse number="11" style="v" sid="GAL 6:11" />Nimwitegereze inyugute nini nkoreesha mbandikira n'ukuboko kwanje! <verse eid="GAL 6:11" /><verse number="12" style="v" sid="GAL 6:12" />Abo babahata gukebwa, ni abashaaka kwiraatana ibikorwa by'umubiri ariko babikora kugira ngo badatootezwa bazize umusaraba wa Kristo. <verse eid="GAL 6:12" /><verse number="13" style="v" sid="GAL 6:13" />Nyamara nabaakebwe ubwabo ntibuubahiriza amategeko, ahuubwo bashaaka ko mukebwa kugira ngo babone uko biiraata ku bw'uwo muhango, bityo reero bavuge ko muri abiigiishwa baabo. <verse eid="GAL 6:13" /><verse number="14" style="v" sid="GAL 6:14" />Naho njeewe ntaakindi nakwiraatiisha, ukuuyeho umusaraba wa Nyagasani Yesu Kristo. Urupfu rwa Yesu ku musaraba rwatumye mbona ko ubuzima bw'iyi si ari imfaabusa maze nanje mpinduka ubusa kuri ubwo buzima. <verse eid="GAL 6:14" /><verse number="15" style="v" sid="GAL 6:15" />Kuko gukebwa cangwa kudakebwa ntaaco bimaze, ahuubwo igikuru ni ukuba icaaremwe gisha. <verse eid="GAL 6:15" /><verse number="16" style="v" sid="GAL 6:16" />Naho abakurikiza iri tegeko mu mibeereho yaabo, amahoro n'imbabazi bibaane na bo kandi bibaane na Isirayeli y'Imaana.<verse eid="GAL 6:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="GAL 6:17" />Ndangiza, kuva ubu, ntihakagire undusha, kuko mfite inkovu ku mubiri wanje zigaragaza ko ndi umugaragu wa Yesu.<verse eid="GAL 6:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="GAL 6:18" />Bavandimwe, ubuntu bw'Umwami waacu Yesu Kristo bubaane n'imitima yaanyu. Amiina.<verse eid="GAL 6:18" /></para>
  <chapter eid="GAL 6" />
</usx>