<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="2TI" style="id">- Rufumbira New Testament</book>
  <para style="h">2 TIMOTEEYO</para>
  <para style="toc3">2 Tim</para>
  <para style="toc2">2 TIMOTEEYO</para>
  <para style="toc1">Urwandiko rwa kabiri Intumwa Pawulo yandikiye TIMOTEEYO</para>
  <para style="mt2">Urwandiko rwa kabiri Intumwa Pawulo yandikiye</para>
  <para style="mt1">TIMOTEEYO</para>
  <para style="imt">INYANZURO</para>
  <para style="im">
    <char style="bk">Urwandiko rwa kabiri Intumwa Pawulo yandikiye Timoteeyo</char> rwiganjemo inaama yihariye ya Timoteeyo nk'umusore bakorana kandi umufasha mu murimo w'Imaana. Umutwe mukuru w'iki gitabo ni ukwihangaana. Timoteeyo akomeje kugiirwa inaama no kwihanangirizwa gukomeza gutanga ubuhamya kuri Yesu Kristo, bushingiye ku nyigiisho z'ukuri kw'Inkuru Nziiza hamwe n'Iseezerano rya Keera, no gukora umurimo we nk'umwigiisha n'umuvugabutumwa, byose akabikora ababazwa kandi ahakanywa.</para>
  <para style="ip">Timoteeyo yihanangirizwa kutiivanga mu mpaka z'ubupfaapfa n'ubujiji 2:23 bitagira iciiza bivamo, ahuubwo bikangiriza abantu babyumviise.</para>
  <para style="ip">Muri ibyo byose, Timoteeyo ariibutswa kugendera ku rugero rw'ubuzima n'ikigendererwa ca Pawulo wanditse aya magambo ari yo, kwizeera kwe, kwihangaana, urukundo, no kubabarira mu gutootezwa.</para>
  <para style="iot">Ibirimo</para>
  <para style="io1">Inyanzuro <char style="ior"><ref loc="2TI 1:1-2">1:1-2</ref></char></para>
  <para style="io1">Guhimbaaza no kwihanangiriza <char style="ior"><ref loc="2TI 1:3-2:13">1:3—2:13</ref></char></para>
  <para style="io1">Inaama no Kwamagana <char style="ior"><ref loc="2TI 2:14-4:5">2:14—4:5</ref></char></para>
  <para style="io1">Imbeera ya Pawulo <char style="ior"><ref loc="2TI 4:6-18">4:6-18</ref></char></para>
  <para style="io1">Umusoozo <char style="ior"><ref loc="2TI 4:19-22">4:19-22</ref></char></para>
  <chapter number="1" style="c" sid="2TI 1" />
  <para style="s1">Indamutso</para>
  <para style="p">
    <verse number="1" style="v" sid="2TI 1:1" />Njeewe Pawulo, intumwa ya Kristo Yesu nk'uko Imaana yabishaatse, ku bw'iseezerano ry'ubugingo bubonerwa muri Kristo Yesu,<verse eid="2TI 1:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="2TI 1:2" />
    <note caller="-" style="x">
      <char style="xo" closed="false">1:2 </char>
      <char style="xt" closed="false">
        <ref loc="ACT 16:1">Iby 16:1</ref>.</char>
    </note>kuri Timoteeyo, umwana wanje nkunda caane.</para>
  <para style="p" vid="2TI 1:2">Ubuntu, imbabazi, n'amahoro biva ku Maana Daata na Kristo Yesu Umwami waacu, bibe kuri wowe.<verse eid="2TI 1:2" /></para>
  <para style="s1">Gushiima no Gukomeza</para>
  <para style="p">
    <verse number="3" style="v" sid="2TI 1:3" />Ndashiima Imaana yo nkorera n'umutima ukeeye, nk'uko ba sogokuruza baabigenzaga. Mpora nkwibuka buri uko nsenga amanywa n'ijoro. <verse eid="2TI 1:3" /><verse number="4" style="v" sid="2TI 1:4" />Iyo niibutse amarira yaawe, numva ngukumbuye nkiifuuza kukubona, kugira ngo ngire umuneezeero. <verse eid="2TI 1:4" /><verse number="5" style="v" sid="2TI 1:5" /><note caller="-" style="x"><char style="xo" closed="false">1:5 </char><char style="xt" closed="false"><ref loc="ACT 16:1">Iby 16:1</ref>.</char></note>Niibuka ukwizeera kwawe kutaryarya, nk'uko nyogokuru Loyida, na nyoko Ewunike baari bafite, noone nkaba ntashidiikanya yuuko uko kwizeera kuri no muri wowe. <verse eid="2TI 1:5" /><verse number="6" style="v" sid="2TI 1:6" />Ku bw'iyo mpamvu ndakwibutsa kubyutsa impaano y'Imaana ikurimo ngo yaake, yo wahaawe igihe nkurambikaho ibiganza. <verse eid="2TI 1:6" /><verse number="7" style="v" sid="2TI 1:7" />Kuko Imaana ntiyaduhaaye Umwuka w'ubwoba, ahuubwo yaduhaaye Umwuka w'imbaraga n'urukundo no kwifata.<verse eid="2TI 1:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="2TI 1:8" />Ntukagire isoni zo kuba umuhamya w'Umwami waacu, cangwa ngo ugirire isoni, nje umusibe nzira Umwami Yesu. Ahuubwo wifatanye nanje mu kubabazwa ku bw'Ubutumwa Bwiza, ufashijwe n'imbaraga z'Imaana. <verse eid="2TI 1:8" /><verse number="9" style="v" sid="2TI 1:9" />Yaradukijije, iduhamagarira kuba abaayo burundu, bidaturutse ku mirimo yaacu, ahuubwo ibiteewe n'umugambi waayo, n'ubuntu yatugiriye. Ubwo buntu yabuduheereye muri Kristo Yesu mbere y'ibihe byose, <verse eid="2TI 1:9" /><verse number="10" style="v" sid="2TI 1:10" />ariko ubu bukaba bwaraduhishuuriwe igihe Umukiza waacu Yesu Kristo yigaragaje. Yatsinze imbaraga z'urupfu, maze agaragaza ubugingo no kudapfa akoreesheje Ubutumwa Bwiza.<verse eid="2TI 1:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="2TI 1:11" />
    <note caller="-" style="x">
      <char style="xo" closed="false">1:11 </char>
      <char style="xt" closed="false">
        <ref loc="1TI 2:7">1 Tim 2:7</ref>.</char>
    </note>Ubwo butumwa ni bwo nashiriweho kuba umubwiriza, intumwa n'umwigiisha. <verse eid="2TI 1:11" /><verse number="12" style="v" sid="2TI 1:12" />Ni yo mpamvu ituma mbabazwa ntya. Ariko ntibinteera isoni, kuko nzi uwo niiringira, kandi sinshidiikanya yuuko ashoboye kurinda ibyo yanshinze kugeza umunsi azaagarukira. <verse eid="2TI 1:12" /><verse number="13" style="v" sid="2TI 1:13" />Uje ukomeza inyigiisho z'ukuri wanyumviyeho, bityo urangwe no kwizeera n'urukundo muri Kristo Yesu. <verse eid="2TI 1:13" /><verse number="14" style="v" sid="2TI 1:14" />Uje urinda ibyiza waragijwe, ubifashijwemo n'Umwuka Weera utuura muri twe.<verse eid="2TI 1:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="2TI 1:15" />Uzi neeza yuuko abo muri Asiya boose banteereranye, ubariyemo Fugelo na Herumogene. <verse eid="2TI 1:15" /><verse number="16" style="v" sid="2TI 1:16" />Nyagasani naagirire umuryango wa Onesifooro imbabazi, kuko yampuumurije kenshi, kandi ntaakorwe n'isoni kuko nari mu gihome. <verse eid="2TI 1:16" /><verse number="17" style="v" sid="2TI 1:17" />Ubwo yageze i Rooma, yagize umwete wo kunshaaka kandi arambona. <verse eid="2TI 1:17" /><verse number="18" style="v" sid="2TI 1:18" />Nyagasani amuhe kuzaabona imbabazi ku munsi wa nyuma! Kandi uzi neeza ibyo yankoreye muri Efeeso.<verse eid="2TI 1:18" /></para>
  <chapter eid="2TI 1" />
  <chapter number="2" style="c" sid="2TI 2" />
  <para style="s">Umusirikare w'Intahemuka wa Kristo Yesu</para>
  <para style="p">
    <verse number="1" style="v" sid="2TI 2:1" />Noone reero mwana wanje, ukomerere mu buntu bubonerwa muri Kristo Yesu. <verse eid="2TI 2:1" /><verse number="2" style="v" sid="2TI 2:2" />Kandi amagambo wumviise mvuga mubahamya benshi, uyamenyeeshe abantu biiringirwa kandi bazaashobora kubyigiisha abandi.<verse eid="2TI 2:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="2TI 2:3" />Uje ufatanya n'abandi kwihangaanira imibabaro, nk'umusirikare mwiza wa Kristo Yesu. <verse eid="2TI 2:3" /><verse number="4" style="v" sid="2TI 2:4" />Ukora ubusirikare ahora ashaaka kuneezeeza sheebuja kandi ntiyivanga mu buzima bwa gituurage. <verse eid="2TI 2:4" /><verse number="5" style="v" sid="2TI 2:5" />Umukinnyi wiiruka mu marushanwa, na we ntiyatsindira umudaari, keretse akurikije amategeko y'umukino. <verse eid="2TI 2:5" /><verse number="6" style="v" sid="2TI 2:6" />Kandi umuhinzi wakoze umurimo ugaragara ni we ukwiriye kubanza yaganura ku byo yasaaruuye. <verse eid="2TI 2:6" /><verse number="7" style="v" sid="2TI 2:7" />Uzirikane ibyo mvuga, kuko Nyagasani azaaguha kubimenya byose.<verse eid="2TI 2:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="2TI 2:8" />Uje wibuka Yesu Kristo ukomooka mu muryango wa Dawudi, akaba yarazuuwe mu baapfuuye, nk'uko Inkuru Nziiza niigiisha ibihamya. <verse eid="2TI 2:8" /><verse number="9" style="v" sid="2TI 2:9" />Iyo Nkuru Nziiza ni yo mpoorwa, ngatootezwa, kugera ubwo mboheeshwa iminyururu nk'umugome. Nyamara, ijambo ry'Imaana ryo ntiribohwa. <verse eid="2TI 2:9" /><verse number="10" style="v" sid="2TI 2:10" />Ni co gituma nihangaanira byose mbigirira abaatooranyijwe n'Imaana, kugira ngo na bo bashobore kuronka agakiza kaba muri Kristo Yesu, hamwe n'ikuzo rihoraho. <verse eid="2TI 2:10" /><verse number="11" style="v" sid="2TI 2:11" />Iri jambo ni iryo kwizeerwa ngo:</para>
  <para style="q1" vid="2TI 2:11">“Niiba twarapfanye na we,</para>
  <para style="q2" vid="2TI 2:11">tuzaabaana na we.<verse eid="2TI 2:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="2TI 2:12" />
    <note caller="-" style="x">
      <char style="xo" closed="false">2:12 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 10:33">Mat 10:33</ref>; <ref loc="LUK 12:9">Luk 12:9</ref>.</char>
    </note>Nidukomeza kwihangaana,</para>
  <para style="q2" vid="2TI 2:12">naatwe tuzaategeka hamwe na we.</para>
  <para style="q1" vid="2TI 2:12">Nitumwihakana,</para>
  <para style="q2" vid="2TI 2:12">na we azaatwihakana.<verse eid="2TI 2:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="2TI 2:13" />Nuubwo twamuhemukira,</para>
  <para style="q2" vid="2TI 2:13">we azaaguma ari intahemuka,</para>
  <para style="q2" vid="2TI 2:13">kuko atabaasha kwivuguruza.”<verse eid="2TI 2:13" /></para>
  <para style="s1">Umukozi Imaana Yeemera</para>
  <para style="p">
    <verse number="14" style="v" sid="2TI 2:14" />Uje wibutsa abantu bawe ibyo, kandi ubiihanangirize imbere y'Imaana ko bareka kurwanira amagambo kuko ari ntaakamaro bifite, ahuubwo ko bigirira naabi abayumva. <verse eid="2TI 2:14" /><verse number="15" style="v" sid="2TI 2:15" />Uje ugira umwete wo kwishira imbere y'Imaana nk'ushimwa na yo, umukozi utagira icaamuteera isoni, ushobora gusobaanura neeza ijambo ry'ukuri. <verse eid="2TI 2:15" /><verse number="16" style="v" sid="2TI 2:16" />Uje wirinda ibiganiiro bitagira umumaro, kuko amagambo nk'ayo atuma abantu bakomeza kugomera Imaana. <verse eid="2TI 2:16" /><verse number="17" style="v" sid="2TI 2:17" />Inyigiisho nk'izo zimeze nk'igisebe c'umufunzo kirya umubiri. Abagabo biigiisha ibimeze bityo ni, Humenayo na Fileto. <verse eid="2TI 2:17" /><verse number="18" style="v" sid="2TI 2:18" />Baataaye inzira y'ukuri bavuga ko izuuka ryarangije kubaho, maze ibyo bigatuma ukwizeera kwa bamwe guhungabana. <verse eid="2TI 2:18" /><verse number="19" style="v" sid="2TI 2:19" />Nyamara urufatiro rw'Imaana rukomeye ntirwanyeganyezwa, kandi kuri rwo handitsweho aya magambo ngo, “Nyagasani azi abe,” kandi ngo, “Umuntu weese wambaza izina rya Nyagasani agomba kurekeraho gukora ibibi.”<verse eid="2TI 2:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="2TI 2:20" />Mu nzu ngari ntihabamo ibikoreesho by'izaahabu n'ifeeza byonyine ahuubwo habamo n'ibikozwe mu biti no mu ibumba, bimwe bigaharirwa gukoreeshwa ku minsi y'icuubahiro, naho ibindi bikagenerwa ku minsi isanzwe.<figure style="fig" file="HK00143B.TIF" size="col" ref="2:20">Mu nzu ngari habamo ibikoreesho bitandukanye.</figure> <verse eid="2TI 2:20" /><verse number="21" style="v" sid="2TI 2:21" />Umuntu weese reero wirinda gukora ibibi navuze, azaaba igikoreesho c'icuubahiro, gitunganyirijwe gukoreeshwa umurimo mwiza woose, kuko azaaba yeguriwe kandi ari ingirakamaro kuri nyir'inzu. <verse eid="2TI 2:21" /><verse number="22" style="v" sid="2TI 2:22" />Uje wirinda irari rya gisore, ahuubwo ukurikirane ubutungaane, kwizeera, urukundo, n'amahoro, ufatanyije n'abambaza Imaana n'umutima ukeeye. <verse eid="2TI 2:22" /><verse number="23" style="v" sid="2TI 2:23" />Wirinde impaka ziteerwa n'ubupfu hamwe n'ubujiji, kuko uzi neeza ko zivamo amahaane. <verse eid="2TI 2:23" /><verse number="24" style="v" sid="2TI 2:24" />Nk'umugaragu wa Nyagasani, ntaabwo ugomba kuba umunyamahaane ahuubwo ugomba kuba umugwaneeza kuri boose, ukaba n'umwigiisha mwiza kandi wihangaana, <verse eid="2TI 2:24" /><verse number="25" style="v" sid="2TI 2:25" />ukagorora abaguhakanya n'ubwitonzi. Imaana ishobora kubaha umugisha wo kwihana bakamenya ukuri, <verse eid="2TI 2:25" /><verse number="26" style="v" sid="2TI 2:26" />bityo reero bagashobora kwisubiraho bakava mu mutego wa Sataani, wari warabagize imbohe akabakoreesha ico yishaakiye.<verse eid="2TI 2:26" /></para>
  <chapter eid="2TI 2" />
  <chapter number="3" style="c" sid="2TI 3" />
  <para style="s1">Iminsi y'Imperuuka</para>
  <para style="p">
    <verse number="1" style="v" sid="2TI 3:1" />Ugomba kumenya yuuko mu minsi y'imperuuka hazaabaho ibihe bikomeye. <verse eid="2TI 3:1" /><verse number="2" style="v" sid="2TI 3:2" />Hazaabaho abantu biikunda, abakunda isente, abiiraasi, abanyamaryo, abatukana, abatumvira ababyeyi baabo, intashiima, abatuubaha Imaana, <verse eid="2TI 3:2" /><verse number="3" style="v" sid="2TI 3:3" />abadakunda abaabo, abagome batababarira abandi, ababeesherana, abahubuka, abanyarugomo, abadakunda ibyiza, <verse eid="2TI 3:3" /><verse number="4" style="v" sid="2TI 3:4" />abagambanyi, ibyihebe, abuuzuye ubwibone, abakunda ibibaneezeeza aho gukunda Imaana, <verse eid="2TI 3:4" /><verse number="5" style="v" sid="2TI 3:5" />abiitwara nk'abuubaha Imaana, ariko bagahinyura imbaraga zaayo. Abameze batyo uje ubiirengagiza. <verse eid="2TI 3:5" /><verse number="6" style="v" sid="2TI 3:6" />Bamwe muri bo bakunda gusesera mu mago y'abandi bakiigaruriza abagore b'ibyomanzi, baaheranywe n'ibyaha maze bagatwarwa n'irari ry'uburyo bwose. <verse eid="2TI 3:6" /><verse number="7" style="v" sid="2TI 3:7" />Abo bagore bahora bagerageza kwiga ibintu bisha ariko ntibashobore kumenya ukuri kw'Imaana. <verse eid="2TI 3:7" /><verse number="8" style="v" sid="2TI 3:8" />Nk'uko Yanesi na Yambure baahakanyije Moose, ni na ko abo bantu barwanya ukuri. Bafite ubwenge bwonoonekaye no kwemera kudashitse. <verse eid="2TI 3:8" /><verse number="9" style="v" sid="2TI 3:9" />Ariko ntaabwo bazaateera imbere caane, kuko ubupfu bwabo buzaagaragarira imbere ya boose, nk'uko byagendeye Yanesi na Yambure.<verse eid="2TI 3:9" /></para>
  <para style="s1">Amabwiriza ya Nyuma</para>
  <para style="p">
    <verse number="10" style="v" sid="2TI 3:10" />Ariko wowe Timoteeyo, wakurikije inyigiisho yanje, imyifatire yanje, n'ibyo ngamije gukora mu buzima bwanje. Wakurikije kwizeera kwanje, kwihangaana kwanje, urukundo rwanje, n'ubudacoogora bwanje. <verse eid="2TI 3:10" /><verse number="11" style="v" sid="2TI 3:11" /><note caller="-" style="x"><char style="xo" closed="false">3:11 a </char><char style="xt" closed="false"><ref loc="ACT 13:14-52">Iby 13:14-52</ref>; </char><char style="xo" closed="false">b </char><char style="xt" closed="false"><ref loc="ACT 14:1-7">Iby 14:1-7</ref>; </char><char style="xo" closed="false">c </char><char style="xt" closed="false"><ref loc="ACT 14:8-20">Iby 14:8-20</ref>.</char></note>Uzi kandi n'ukuntu natootejwe ndetse nkababarizwa mu bice bya Antiyokiya, Ikoniyo n'i Lisitura. Mbega ukuntu nihangaaniye gutootezwa! Nyamara ibyo byose ni Nyagasani wabinkijije. <verse eid="2TI 3:11" /><verse number="12" style="v" sid="2TI 3:12" />Ni koko, abashaaka guhora baramya Imaana bari muri Kristo Yesu boose, bazaatootezwa. <verse eid="2TI 3:12" /><verse number="13" style="v" sid="2TI 3:13" />Naho abagiranaabi n'indyarya bazaarushaho kuba babi, bayobya abandi kandi na bo abandi babayobya. <verse eid="2TI 3:13" /><verse number="14" style="v" sid="2TI 3:14" />Ariko wowe Timoteeyo, ukomerere mu kuri wiigiishijwe kandi ko wemeye udashidiikanya. Uzi neeza uwakwigiishije, <verse eid="2TI 3:14" /><verse number="15" style="v" sid="2TI 3:15" />kandi uzi yuuko kuva mu buto bwawe wamenye ibyanditswe byera bishobora kukumenyeesha ubwenge bwakuyobora ku gakiza kabonerwa mu kwizeera Kristo Yesu. <verse eid="2TI 3:15" /><verse number="16" style="v" sid="2TI 3:16" />Ibyanditswe byera byose byahuumeetswe n'Imaana kandi bifite umumaro wo kwigiisha ukuri, kwamagana inyigiisho mbi, kugorora umuntu no kumutooza gutungaanira Imaana, <verse eid="2TI 3:16" /><verse number="17" style="v" sid="2TI 3:17" />kugira ngo ukorera Imaana weese abe ashitse kandi afite ibimukwiriye mu gukora imirimo myiza yoose.<verse eid="2TI 3:17" /></para>
  <chapter eid="2TI 3" />
  <chapter number="4" style="c" sid="2TI 4" />
  <para style="p">
    <verse number="1" style="v" sid="2TI 4:1" />Ndakwihanangirije imbere y'Imaana na Kristo Yesu, uzaagaruka gutegeka nk'Umwami maze agaciira abazima n'abaapfuuye imanza, <verse eid="2TI 4:1" /><verse number="2" style="v" sid="2TI 4:2" />amamaza ijambo ry'Imaana, ukomeze kuryigiisha mu gihe ciiza no mu gihe gikomeye, uje wereka abantu inshobe zaabo kandi wamagane ibyaha byabo, ariko ubahuuguure kandi ubiigiishe ufite kwihangaana. <verse eid="2TI 4:2" /><verse number="3" style="v" sid="2TI 4:3" />Kuko igihe kizaaza aho abantu baziima amatwi inyigiisho zishitse, ahuubwo bakurikize ibyifuuzo byabo maze biishaakire abiigiisha benshi bazaababwira ibyo bashaaka kumva. <verse eid="2TI 4:3" /><verse number="4" style="v" sid="2TI 4:4" />Bazaaja biica amatwi ngo batumva ukuri, ahuubwo bakurikize inyigiisho zitagira ishingiro. <verse eid="2TI 4:4" /><verse number="5" style="v" sid="2TI 4:5" />Ariko wowe, uje uba maaso buri gihe, wihangaanire kubabazwa, ukore umurimo w'ivugabutumwa, maze urangize umurimo washinzwe n'Imaana.<verse eid="2TI 4:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="2TI 4:6" />Naho njeewe, igihe c'ubuzima bwanje gutaaha kirasohoye, ubwo ubuzima bwanje bugiiye gutangwa nk'igitambo. <verse eid="2TI 4:6" /><verse number="7" style="v" sid="2TI 4:7" />Narwanye intambara nziiza, irushanwa nagombaga kwiruka nararirangije, kandi narinze ukwizeera. <verse eid="2TI 4:7" /><verse number="8" style="v" sid="2TI 4:8" />Ahasigaye, mbikiwe ikamba ryateguuriwe intungaane, iryo Nyagasani, umucaamanza utabeera azampa uwo munsi. Si nje azaariha njenyine, ahuubwo azaariha n'abo boose bategereje ukwigaragaza kwe.<verse eid="2TI 4:8" /></para>
  <para style="s1">Amagambo y'Umwihariko ya Timoteeyo</para>
  <para style="p">
    <verse number="9" style="v" sid="2TI 4:9" />Ugerageze kungeraho vuba. <verse eid="2TI 4:9" /><verse number="10" style="v" sid="2TI 4:10" /><note caller="-" style="x"><char style="xo" closed="false">4:10 a </char><char style="xt" closed="false"><ref loc="COL 4:14">Kol 4:14</ref>; <ref loc="PHM 1:24">Fili 1:24</ref>; </char><char style="xo" closed="false">b </char><char style="xt" closed="false"><ref loc="2CO 8:23">2 Kor 8:23</ref>; <ref loc="GAL 2:3">Gal 2:3</ref>; <ref loc="TIT 1:4">Tito 1:4</ref>.</char></note>Demasi yarantaaye aja i Teesalonike kuko yakunze iby'isi ya noone. Kiresikesi na we yagiiye i Galatiya, Tito aja i Dalumatiya. <verse eid="2TI 4:10" /><verse number="11" style="v" sid="2TI 4:11" /><note caller="-" style="x"><char style="xo" closed="false">4:11 a </char><char style="xt" closed="false"><ref loc="COL 4:14">Kol 4:14</ref>; <ref loc="PHM 1:24">Fili 1:24</ref>; </char><char style="xo" closed="false">b </char><char style="xt" closed="false"><ref loc="ACT 12:12">Iby 12:12</ref>,<ref loc="ACT 12:25">25</ref>; <ref loc="ACT 13:13">13:13</ref>; <ref loc="ACT 15:37-39">15:37-39</ref>; <ref loc="COL 4:10">Kol 4:10</ref>; <ref loc="PHM 1:24">Fili 1:24</ref>.</char></note>Luka ni we wenyine ukiri kumwe nanje. Ushaake Mariko maze umunzanire kuko amfitiye akamaro mu murimo wanje. <verse eid="2TI 4:11" /><verse number="12" style="v" sid="2TI 4:12" /><note caller="-" style="x"><char style="xo" closed="false">4:12 </char><char style="xt" closed="false"><ref loc="ACT 20:4">Iby 20:4</ref>; <ref loc="EPH 6:21">Efe 6:21</ref>,<ref loc="EPH 6:22">22</ref>; <ref loc="COL 4:7">Kol 4:7</ref>,<ref loc="COL 4:8">8</ref>.</char></note>Tushiko namwohereje muri Efeeso. <verse eid="2TI 4:12" /><verse number="13" style="v" sid="2TI 4:13" /><note caller="-" style="x"><char style="xo" closed="false">4:13 </char><char style="xt" closed="false"><ref loc="ACT 20:6">Iby 20:6</ref>.</char></note>Nuuza, uzanzanire umwiteero nasize i Turowadi kwa Karupo hamwe n'ibitabo, caane caane ibikozwe mu ruhu.<verse eid="2TI 4:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="2TI 4:14" />
    <note caller="-" style="x">
      <char style="xo" closed="false">4:14 a </char>
      <char style="xt" closed="false">
        <ref loc="1TI 1:20">1 Tim 1:20</ref>; </char>
      <char style="xo" closed="false">b </char>
      <char style="xt" closed="false">
        <ref loc="ROM 2:6">Rom 2:6</ref>.</char>
    </note>Alekizanda, umucuzi w'imiringa yankoreye naabi caane. Nyagasani azaamuhanire ibikwiranye n'ibyo yakoze. <verse eid="2TI 4:14" /><verse number="15" style="v" sid="2TI 4:15" />Naawe ugomba kumwirinda kuko yarwanyije caane ibyo twigiishaga.<verse eid="2TI 4:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="2TI 4:16" />Ubwo niireguuraga mu rukiiko ubwa mbere, nta muntu n'umwe wanshigikiye, ahuubwo boose baaranteereranye. Imaana ntiikabibaryoze! <verse eid="2TI 4:16" /><verse number="17" style="v" sid="2TI 4:17" />Ariko Nyagasani yambaaye haafi, maze arankomeza, kugira ngo nshobore kwamamaza Ubutumwa Bwiza maze n'Abanyamahanga boose babwumve. Nuuko ankuura mu kanwa k'intare. <verse eid="2TI 4:17" /><verse number="18" style="v" sid="2TI 4:18" />Nyagasani azankiza ikibi coose kandi andinde kugeza mu Bwami bwe bwo mu ijuru. Icuubahiro kibe ice, iteeka ryose, Amiina.<verse eid="2TI 4:18" /></para>
  <para style="s1">Umusoozo</para>
  <para style="p">
    <verse number="19" style="v" sid="2TI 4:19" />
    <note caller="-" style="x">
      <char style="xo" closed="false">4:19 a </char>
      <char style="xt" closed="false">
        <ref loc="ACT 18:2">Iby 18:2</ref>; </char>
      <char style="xo" closed="false">b </char>
      <char style="xt" closed="false">
        <ref loc="2TI 1:16">2 Tim 1:16</ref>,<ref loc="2TI 1:17">17</ref>.</char>
    </note>Untaahirize Purisikila na Akwila, n'ab'urugo rwa Onesiforo. <verse eid="2TI 4:19" /><verse number="20" style="v" sid="2TI 4:20" /><note caller="-" style="x"><char style="xo" closed="false">4:20 a </char><char style="xt" closed="false"><ref loc="ACT 19:22">Iby 19:22</ref>; <ref loc="ROM 16:23">Rom 16:23</ref>; </char><char style="xo" closed="false">b </char><char style="xt" closed="false"><ref loc="ACT 20:4">Iby 20:4</ref>; <ref loc="ACT 21:29">21:29</ref>.</char></note>Erasito yasigaye i Korinto, naho Tirofimo namusize i Mileto arwaye. <verse eid="2TI 4:20" /><verse number="21" style="v" sid="2TI 4:21" />Uzaagerageze kuuza mbere y'igihe c'imbeho.</para>
  <para style="p" vid="2TI 4:21">Ewubulo hamwe na Pudensi na Lino na Kilawudiya n'abandi bakristo ba hano i Rooma baragutaasha.<verse eid="2TI 4:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="2TI 4:22" />Nyagasani abaane naawe. Ubuntu bw'Imaana bubaane namwe, Amiina.<verse eid="2TI 4:22" /></para>
  <chapter eid="2TI 4" />
</usx>