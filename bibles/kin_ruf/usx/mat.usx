<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="MAT" style="id">- Rufumbira New Testament</book>
  <para style="h">MATAYO</para>
  <para style="toc3">Mat</para>
  <para style="toc2">MATAYO</para>
  <para style="toc1">Ubutumwa Bwiza uko Bwanditswe na MATAYO</para>
  <para style="mt2">Ubutumwa Bwiza uko bwanditswe na</para>
  <para style="mt1">MATAYO</para>
  <para style="imt">INYANZURO</para>
  <para style="ip">
    <char style="bk">Ubutumwa Bwiza uko bwanditswe na Matayo</char> butubwira Inkuru Nziiza ko Yesu ari we mucunguzi wari waraseezeranyijwe. Uwo ni we Imaana yujuririjemo iseezerano yari yaragiranye n'abantu baayo mu Iseezerano rya Keera. Ubu Butumwa Bwiza si ubw'Abayuuda bo Yesu yavuukiyemo kandi agatuuramo gusa, ahuubwo ni ubw'abantu boose ku isi yoose.</para>
  <para style="ip">
    <char style="bk">Ubutumwa Bwiza uko bwanditswe na Matayo</char> buteguuwe neeza. Butangirana no kuvuuka kwa Yesu Kristo, gusobaanura umubatizo no kugeragezwa kwe, ndetse n'uko yatangiye umurimo wo kubwiriza ubutumwa, kwigiisha no gukiza abantu muri Galileeya. Nyuma y'ibi, Ubutumwa Bwiza bwerekana urugendo rwa Yesu ava i Galileeya aja i Yerusaalemu hamwe n'ibyabaye kuri Yesu mu cumweru ce ca nyuma, byamuviiriyemo kubambwa nyuma akazuuka.</para>
  <para style="ip">Ubu Butumwa Bwiza bugaragaza Yesu nk'umwigiisha w'umuhanga ufite ububaasha bwo gusobaanura amategeko y'Imaana, no kwigiisha ibyerekeye Ubwami bw'Imaana. Inyigiisho ze nyinshi ziibumbiye mu buce butaanu: (1) Yesu yigiishiriza ku musozi. Ubu butumwa bugizwe na kamere, inshingano, amahiirwe, n'iherezo ry'abo bazaaja mu Bwami bw'Imaana (igice ca 5-7); (2) Amabwiriiza yahaawe abiigiishwa cumi na babiri kuja gukora umurimo wo kubwiriza ubutumwa (igice ca 10); (3) Imigani ifashe ku Bwami bw'ijuru (igice ca 13); (4) Kwigiisha ico gukura mu buryo bw'umwuka bimenyeesha (igice ca 18); (5) Kwigiisha ku mperuuka y'ab'iki gihe no kuuza k'Ubwami bw'ijuru (igice ca 24-25).</para>
  <para style="iot">Ibirimo</para>
  <para style="io1">Amavu n'amavuuko ya Yesu Kristo <char style="ior"><ref loc="MAT 1:1-2:23">1:1—2:23</ref> </char></para>
  <para style="io1">Inyigiisho za Yohaana Umubatiza <char style="ior"><ref loc="MAT 3:1-12">3:1-12</ref></char></para>
  <para style="io1">Kubatizwa no kugeragezwa kwa Yesu<char style="ior"><ref loc="MAT 3:13-4:11">3:13—4:11</ref></char></para>
  <para style="io1">Yesu atangira umurimo we i Galileeya<char style="ior"><ref loc="MAT 4:12-18:25">4:12—18:25</ref></char></para>
  <para style="io1">Kuva i Galileeya kuja i Yerusaalemu <char style="ior"><ref loc="MAT 19:1-20:34">19:1—20:34</ref> </char></para>
  <para style="io1">Icumweru ca nyuma i Yerusaalemu no mu bice biheegeereye <char style="ior"><ref loc="MAT 21:1-27:66">21:1—27:66</ref></char></para>
  <para style="io1">Kuzuuka no kwiyeerekana k'Umwami Yesu. <char style="ior"><ref loc="MAT 28:1-20">28:1-20</ref></char></para>
  <chapter number="1" style="c" sid="MAT 1" />
  <para style="s1">Amavu n'Amavuuko ya Yesu Kristo</para>
  <para style="r">(<ref loc="LUK 3:23-38">Luk 3:23-38</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 1:1" />Dore aya ni yo mavu n'amavuuko<note caller="+" style="f"><char style="fr" closed="false">1:1 </char><char style="fq" closed="false">Mavu n'amavuuko </char><char style="ft" closed="false">bimenyeesha amaseekuruza</char></note> ya Yesu Kristo, mwene Dawudi, ukomooka kuri Aburahamu.<verse eid="MAT 1:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="MAT 1:2" />Aburahamu yabyaye Isaaka, Isaaka abyara Yaakobo, Yaakobo abyara Yuda na beene se, <verse eid="MAT 1:2" /><verse number="3" style="v" sid="MAT 1:3" />Yuda yabyaranye na Tamari Peresi na Zeera, Peresi abyara Hezirooni, Hezirooni abyara Aramu, <verse eid="MAT 1:3" /><verse number="4" style="v" sid="MAT 1:4" />Aramu yabyaye Amiinadabu, Amiinadabu abyara Nahasoni, Nahasoni abyara Saalumooni, <verse eid="MAT 1:4" /><verse number="5" style="v" sid="MAT 1:5" />kandi Saalumooni abyara Bowazi amubyaranye na Rahabu, Bowazi yabyaye Obedi amubyaranye na Ruusi, Obedi abyara Yese, <verse eid="MAT 1:5" /><verse number="6" style="v" sid="MAT 1:6" />kandi Yese ni we wabyaye umwami Dawudi.</para>
  <para style="p" vid="MAT 1:6">Kandi Dawudi yabyaye Solomooni, amubyarana n'umugore wa Uriya, <verse eid="MAT 1:6" /><verse number="7" style="v" sid="MAT 1:7" />Solomooni abyara Rehobowamu, Rehobowamu abyara Abiya, Abiya abyara Asafu. <verse eid="MAT 1:7" /><verse number="8" style="v" sid="MAT 1:8" />Asafu yabyaye Yehoshafaati, Yehoshafaati abyara Yoramu, Yoramu abyara Uziya, <verse eid="MAT 1:8" /><verse number="9" style="v" sid="MAT 1:9" />Uziya ni we wabyaye Yosamu, Yosamu abyara Ahazi na Ahazi abyara Heezekiya. <verse eid="MAT 1:9" /><verse number="10" style="v" sid="MAT 1:10" />Heezekiya yabyaye Manase, Manase abyara Amosi<note caller="+" style="f"><char style="fr" closed="false">1:10 </char><char style="fk" closed="false">Amosi </char><char style="ft" closed="false">Mu bindi byanditswe byera bandika </char><char style="it">Amoni</char> </note>, Amosi abyara Yosiya. <verse eid="MAT 1:10" /><verse number="11" style="v" sid="MAT 1:11" />Yosiya yabyaye Yekoniya hamwe na beene se, baabayeho mu gihe Abayuuda baajanwaga bunyago i Babilooni.<verse eid="MAT 1:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 1:12" />Nyuma yo kwimurirwa i Babilooni, Yekoniya yabyaye Salatiyeli, Salatiyeli abyara Zerubabeeli. <verse eid="MAT 1:12" /><verse number="13" style="v" sid="MAT 1:13" />Kandi Zerubabeeli abyara Abiyuudi, Abiyuudi abyara Eliyakimu wabyaye Azori, <verse eid="MAT 1:13" /><verse number="14" style="v" sid="MAT 1:14" />kandi Azori na we abyara Zadoki, Zadoki abyara Akiimu, Akiimu abyara Eliyuudi, <verse eid="MAT 1:14" /><verse number="15" style="v" sid="MAT 1:15" />Eliyuudi ni we wabyaye Eliyazaari, kandi Eliyazaari abyara Matani ise wa Yaakobo, <verse eid="MAT 1:15" /><verse number="16" style="v" sid="MAT 1:16" />Yaakobo yabyaye Yozefu umugabo wa Mariya, ari we wabyaye Yesu wiitwa Kristo.<verse eid="MAT 1:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 1:17" />Nuuko kuva kuri Aburahamu kugeza kuri Dawudi ni amaseekuruza cumi n'ane, kandi kuva kuri Dawudi kugeza ku bajanywe i Babilooni na yo ni amaseekuruza cumi n'ane. Kuva ku baajanywe i Babilooni kugera kuri Kristo, na yo ni amaseekuruza cumi n'ane.<verse eid="MAT 1:17" /></para>
  <para style="s1">Kuvuuka Kwa Yesu Kristo</para>
  <para style="r">(<ref loc="LUK 2:1-7">Luk 2:1-7</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 1:18" />
    <note caller="-" style="x">
      <char style="xo" closed="false">1:18 </char>
      <char style="xt" closed="false">
        <ref loc="LUK 1:27">Luk 1:27</ref>.</char>
    </note>Uku ni ko byagenze mu kuvuuka kwa Yesu Kristo. Ubwo Mariya nyina wa Yesu yari aseezeranye na Yozefu, ariko bataraashingiranwa, Mariya asangwa afite inda y'Umwuka Weera. <verse eid="MAT 1:18" /><verse number="19" style="v" sid="MAT 1:19" />Umugabo we Yozefu yari umuntu w'intungaane kandi ntiyashaakaga kumukoza isoni kumugaragaro, nuuko yigiira inaama yo kumubenga rwihishwa. <verse eid="MAT 1:19" /><verse number="20" style="v" sid="MAT 1:20" />Akibiteekerezaho, malayika w'Imaana amubonekera mu nzozi, aramubwira ati, “Yozefu mwene Dawudi, ntutinye gusohoza umugeni waawe Mariya, kuko iyo nda yasamye ari iy'Umwuka Weera. <verse eid="MAT 1:20" /><verse number="21" style="v" sid="MAT 1:21" /><note caller="-" style="x"><char style="xo" closed="false">1:21 </char><char style="xt" closed="false"><ref loc="LUK 1:31">Luk 1:31</ref>.</char></note>Azaabyara umwana w'umuhungu uzamwite Yesu, kuuko ni we uzaakiza abantu be ibyaha byabo.”<verse eid="MAT 1:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 1:22" />Ibi byose byabaayeho kugira ngo bibe nk'uko Uhoraho yari yaravugiye mu muhanuuzi ati, <verse eid="MAT 1:22" /><verse number="23" style="v" sid="MAT 1:23" />“Dore, umukoobwa w'isugi azaasama inda abyare umwana w'umuhungu, kandi bazamwita Emanweli,” risobaanurwa ngo, “Imaana iri kumwe naatwe.”<verse eid="MAT 1:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 1:24" />Yozefu akangutse, abigenza nk'uko malayika w'Uhoraho yamutegetse, ajaana Mariya nk'umugore we, <verse eid="MAT 1:24" /><verse number="25" style="v" sid="MAT 1:25" /><note caller="-" style="x"><char style="xo" closed="false">1:25 </char><char style="xt" closed="false"><ref loc="LUK 2:21">Luk 2:21</ref>.</char></note>ariko ntibigeze baryamana kugeza igihe yabyariye umwana w'umuhungu, nuuko uwo mwana amwita Yesu.<verse eid="MAT 1:25" /></para>
  <chapter eid="MAT 1" />
  <chapter number="2" style="c" sid="MAT 2" />
  <para style="s1">Abanyabwenge Bazindukira Yesu</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 2:1" />Yesu yavuukiye i Beetelehemu mu gice c'i Yudeeya, ku ngoma y'Umwami Herodi. Amaze kuvuuka, abagabo baari abahanga mu bumenyi bw'inyenyeeri bava iburasirazuuba beerekeza i Yerusaalemu <verse eid="MAT 2:1" /><verse number="2" style="v" sid="MAT 2:2" />barabaza bati, “Mbese umwami w'Abayuuda uheruutse kuvuuka ari heehe? Twaboonye inyenyeeri ye iri guhingukira iburasirazuuba, noone tuuje kumuramya.”<verse eid="MAT 2:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 2:3" />Umwami Herodi n'abatuuye i Yerusaalemu boose babyumviise batyo, bahagarika imitima. <verse eid="MAT 2:3" /><verse number="4" style="v" sid="MAT 2:4" />Herodi ahamagara abatware b'abaheerezabitambo boose hamwe n'abiigiishamategeko, ababaza aho Kristo azaavuukira.<verse eid="MAT 2:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 2:5" />Baramusubiza bati, “Azaavuukira i Beetelehemu mu gice c'i Yudeeya, nk'uko byanditswe n'umuhanuuzi ngo,<verse eid="MAT 2:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="MAT 2:6" />‘Kandi naawe Beetelehemu yo muri Yudeeya,</para>
  <para style="q2" vid="MAT 2:6">ntaabwo uri uwanyuma mu butegetsi bwa Yuda,</para>
  <para style="q1" vid="MAT 2:6">kuko muri wowe hazaavuuka umutegetsi</para>
  <para style="q2" vid="MAT 2:6">uzaaba umushumba w'ubwoko bwanje bwa Isirayeli.’ ”<verse eid="MAT 2:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 2:7" />Nuuko Herodi ahamagaza abo banyabwenge<note caller="+" style="f"><char style="fr" closed="false">2:7 </char><char style="ft" closed="false">abanyabwenge n'abahanga mu by'inyenyeeri</char></note>, arabiihereerana maze ababaza neeza igihe iyo nyenyeeri yabonekeye. <verse eid="MAT 2:7" /><verse number="8" style="v" sid="MAT 2:8" />Aboohereza i Beetelehemu maze arababwira ati, “Nimugende mubaririze neeza iby'uwo mwana, nimumubona, muzaagaruke muumenyeeshe nuuko nanje nje kumuramya.”<verse eid="MAT 2:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 2:9" />Bamaze kumva amagambo y'umwami, baragenda. Bageze imbere babona ya nyenyeeri baari baaboneye iburasirazuuba, ibaja imbere kugeza ubwo yahagaze aho uwo mwana yari ari. <verse eid="MAT 2:9" /><verse number="10" style="v" sid="MAT 2:10" />Baboonye ko iyo nyenyeeri yahagaze, barishiima birenze urugero. <verse eid="MAT 2:10" /><verse number="11" style="v" sid="MAT 2:11" />Binjiye mu nzu, babona umwana hamwe na nyina Mariya, barapfukama maze baheerako baramuramya. Bapfunduura ubusanduku bubiikwamo ibintu by'agaciiro, bamuheereza impaano z'izaahabu, Ububani<note caller="+" style="f"><char style="fr" closed="false">2:11 </char><char style="ft" closed="false">Ububaani n'imibavu ihuumura neeza </char></note> hamwe n'imibavu ihuumura neeza.<verse eid="MAT 2:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 2:12" />Nuuko bafata inzira basubira iwaabo bakoreesheje iyindi nzira kuko Imaana yari yabiihanangirije mu nzozi ngo badasubira kwa Herodi.<verse eid="MAT 2:12" /></para>
  <para style="s1">Guhungira mu Igiputi</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 2:13" />Abanyabwenge bamaze kugenda, Malayika w'Imaana abonekera Yozefu mu nzozi, aramubwira ati, “Haguruka uhunze umwana na nyina, muje mu gihugu ca Igiputi, maze mugumeyo kugeza igihe nzaakubwirira, kuko Herodi arenda gushaakiisha uwo mwana ngo amwice.”<verse eid="MAT 2:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 2:14" />Nuuko iryo joro Yozefu arahaguruka, afata inzira, ajaana umwana na nyina bahungira muri Igiputi. <verse eid="MAT 2:14" /><verse number="15" style="v" sid="MAT 2:15" />Bagumayo kugeza igihe Herodi yapfiiriye. Ibi byabaayeho kugira ngo ibyo Uhoraho yavugiye mu muhanuuzi bisohore ati, “Nahamagaye umwana wanje ngo ave muri Igiputi.”<verse eid="MAT 2:15" /></para>
  <para style="s1">Herodi Ategeka ko Abaana Bato Biicwa</para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 2:16" />Herodi amaze kumenya ko ba banyabwenge baari baturutse iburasirazuuba bamuhenze ubwenge, biramuraakaza caane. Ategeka ko abaana b'abahungu bafite imyaka ebyiri hamwe n'abataraayigeza boose batuuye i Beetelehemu n'ibice biheereranye naho biicwa. Yagereranyije igihe co baabanyabwenge bari baamubwiye ko ariho baaboonye inyenyeeri.<verse eid="MAT 2:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 2:17" />Ni bwo ibyavugiwe mu muhanuuzi Yeremiya byasohoye ngo,<verse eid="MAT 2:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="MAT 2:18" />“Induuru yumviikana i Rama,</para>
  <para style="q2" vid="MAT 2:18">induuru y'umuboroogo ukabije.</para>
  <para style="q1" vid="MAT 2:18">Rasheeli aririra abaana be,</para>
  <para style="q2" vid="MAT 2:18">ntibyashoboka ko ahozwa,</para>
  <para style="q2" vid="MAT 2:18">kuko batakiriho.”<verse eid="MAT 2:18" /></para>
  <para style="s1">Guhunguuka bava mu Igiputi</para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 2:19" />Herodi amaze gupfa, malayika w'Imaana abonekera Yozefu mu nzozi bakiri muri Igiputi, <verse eid="MAT 2:19" /><verse number="20" style="v" sid="MAT 2:20" />aramubwira ati, “Haguruka usubize umwana na nyina mu gihugu ca Isirayeli, kuko abaashaakaga kumwica baapfuuye.” <verse eid="MAT 2:20" /><verse number="21" style="v" sid="MAT 2:21" />Nuuko Yozefu afata inzira ajaana umwana na nyina, basubira mu gihugu ca Isirayeli.<verse eid="MAT 2:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 2:22" />Ariko yumviise yuuko Arikelawosi mwene Herodi ari we wazunguuye se akaba ari we wabaaye umwami w'i Yudeeya, agira ubwoba bwo kujayo. Ariko kuko yari yihanangirijwe mu nzozi, aja mu disiturikiti y'i Galileeya, <verse eid="MAT 2:22" /><verse number="23" style="v" sid="MAT 2:23" /><note caller="-" style="x"><char style="xo" closed="false">2:23 </char><char style="xt" closed="false"><ref loc="MRK 1:24">Mar 1:24</ref>; <ref loc="LUK 2:39">Luk 2:39</ref>; <ref loc="JHN 1:45">Yoh 1:45</ref>.</char></note>atuura mu tawuni y'i Nazaareeti kugira ngo ibyavugiwe mu bahanuuzi bibe nk'uko byavuuzwe ngo, “Aziitwa Umunyanazaareeti.”<verse eid="MAT 2:23" /></para>
  <chapter eid="MAT 2" />
  <chapter number="3" style="c" sid="MAT 3" />
  <para style="s1">Kubwiriza Kwa Yohaana Umubatiza</para>
  <para style="r">(<ref loc="MRK 1:1-8">Mar 1:1-8</ref>; <ref loc="LUK 3:1-18">Luk 3:1-18</ref>; <ref loc="JHN 1:19-28">Yoh 1:19-28</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 3:1" />Ico gihe, Yohaana Umubatiza aja mu butaayu i Yudeeya abwiriza ati, <verse eid="MAT 3:1" /><verse number="2" style="v" sid="MAT 3:2" /><note caller="-" style="x"><char style="xo" closed="false">3:2 </char><char style="xt" closed="false"><ref loc="MAT 4:17">Mat 4:17</ref>; <ref loc="MRK 1:15">Mar 1:15</ref>.</char></note>“Nimwihane ibyaha byanyu kuko Ubwami bwo mu ijuru bwegereje!” <verse eid="MAT 3:2" /><verse number="3" style="v" sid="MAT 3:3" />Yohaana uwo ni we wari waravuzweho n'umuhanuuzi Yesaaya ati,</para>
  <para style="q1" vid="MAT 3:3">“Ijwi ry'uvugira mu butaayu aranguruye ati,</para>
  <para style="q1" vid="MAT 3:3">‘Nimutungaanye inzira y'Uhoraho,</para>
  <para style="q2" vid="MAT 3:3">mugorore aho azanyura.’ ”<verse eid="MAT 3:3" /></para>
  <para style="m">
    <verse number="4" style="v" sid="MAT 3:4" />Yohaana yambaraga umwambaro ukozwe mu bwoya bw'ingamiya akawukenyeza umushumi w'uruhu. Yaryaga inzige hamwe n'ubuuki bw'ubuhura. <verse eid="MAT 3:4" /><verse number="5" style="v" sid="MAT 3:5" />Abantu b'i Yerusaalemu no mu bice byose by'i Yudeeya, no mu bice byitoorooye uruuzi rwa Yorodaani bazaga bamusanga <verse eid="MAT 3:5" /><verse number="6" style="v" sid="MAT 3:6" />bakihana ibyaha byabo maze akababatiriza mu ruuzi rwa Yorodaani.<verse eid="MAT 3:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 3:7" />
    <note caller="-" style="x">
      <char style="xo" closed="false">3:7 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 12:34">Mat 12:34</ref>; <ref loc="MAT 23:33">23:33</ref>.</char>
    </note>Ariko Yohaana aboonye Abafarisaayo n'Abasadukaayo benshi bamuuzaho ngo ababatize, arababwira ati, “Mwa rubyaro rw'inshiira mwe! Ni nde wabagiiriye inaama ngo muhunge uburakari bw'Imaana bwegereje? <verse eid="MAT 3:7" /><verse number="8" style="v" sid="MAT 3:8" />Nimukore ibikorwa bikwiriye abiihannye. <verse eid="MAT 3:8" /><verse number="9" style="v" sid="MAT 3:9" /><note caller="-" style="x"><char style="xo" closed="false">3:9 </char><char style="xt" closed="false"><ref loc="JHN 8:33">Yoh 8:33</ref>.</char></note>Ntimwibeeshe muti, ‘Dukomooka kuri Aburahamu,’ ndabahamiriza yuuko Imaana ishobora kurema muri aya mabuye beene Aburahamu. <verse eid="MAT 3:9" /><verse number="10" style="v" sid="MAT 3:10" /><note caller="-" style="x"><char style="xo" closed="false">3:10 </char><char style="xt" closed="false"><ref loc="MAT 7:19">Mat 7:19</ref>.</char></note>Ndetse n'ubu, intorezo yo gutema igiti irateguuwe. Igiti coose kiteera imbuto nziiza kigiiye gutemwa gitwikwe mu muriro.<verse eid="MAT 3:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 3:11" />Njeewe mbabatiriisha amaazi nk'ikimenyeetso ceerekana yuuko mwihannye ibyaha byanyu, ariko uzaaza nyuma yanje andusha ububaasha, sinkwiriye no kumukuuramo ingato. We azaababatiriisha Umwuka Weera n'umuriro. <verse eid="MAT 3:11" /><verse number="12" style="v" sid="MAT 3:12" />Dore afashe intaara ngo agosoore impeke azihunike mu kigega, naho umurama, awucaaniishe umuriro utazima.”<verse eid="MAT 3:12" /></para>
  <para style="s1">Kubatizwa kwa Yesu</para>
  <para style="r">(<ref loc="MRK 1:9-11">Mar 1:9-11</ref>; <ref loc="LUK 3:21-22">Luk 3:21-22</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 3:13" />Ico gihe, Yesu ava i Galileeya aja ku ruuzi rwa Yorodaani ngo Yohaana amubatize. <verse eid="MAT 3:13" /><verse number="14" style="v" sid="MAT 3:14" />Ariko Yohaana agerageza kumuhakanira ati, “Ni wowe ukwiriye kumbatiza, noone unjeho ngo nkubatize?”<verse eid="MAT 3:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 3:15" />Yesu aramusubiza ati, “Emera ubikore ubu, kuko ari byo bikwiriye mu kuzuuza ibyo Imaana ishaaka.” Nuuko Yohaana arabyemera.<verse eid="MAT 3:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 3:16" />Yesu amaze kubatizwa, yuunamuka mu maazi, ijuru rirakinguuka nuuko abona Umwuka w'Imaana amumanukiraho asa n'inuma. <verse eid="MAT 3:16" /><verse number="17" style="v" sid="MAT 3:17" /><note caller="-" style="x"><char style="xo" closed="false">3:17 </char><char style="xt" closed="false"><ref loc="MAT 12:18">Mat 12:18</ref>; <ref loc="MAT 17:5">17:5</ref>; <ref loc="MRK 1:11">Mar 1:11</ref>; <ref loc="LUK 9:35">Luk 9:35</ref>.</char></note>Maze ijwi ry'Imaana rivugira mu ijuru riti, “Uyu ni Umwana wanje nkunda<note caller="+" style="f"><char style="fr" closed="false">3:17 </char><char style="ft" closed="false">Mu bindi byanditswe byera harimo </char><char style="fqa" closed="false">Umuhungu wanje nkunda</char></note> nkamwishiimira.”<verse eid="MAT 3:17" /></para>
  <chapter eid="MAT 3" />
  <chapter number="4" style="c" sid="MAT 4" />
  <para style="s1">Yesu ageragezwa na Sataani</para>
  <para style="r">(<ref loc="MRK 1:2-13">Mar 1:2-13</ref>; <ref loc="LUK 4:1-13">Luk 4:1-13</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 4:1" />
    <note caller="-" style="x">
      <char style="xo" closed="false">4:1 </char>
      <char style="xt" closed="false">
        <ref loc="HEB 2:18">Heb 2:18</ref>; <ref loc="HEB 4:15">4:15</ref>.</char>
    </note>Nuuko Yesu ajanwa n'Umwuka w'Imaana mu butaayu kugira ngo ahageragerezwe na Sataani. <verse eid="MAT 4:1" /><verse number="2" style="v" sid="MAT 4:2" />Ubwo yari amaze iminsi mirongo ine n'amajoro mirongo ane asiibye, Yesu arasonza. <verse eid="MAT 4:2" /><verse number="3" style="v" sid="MAT 4:3" />Umushukanyi aramwegeera aramubwira ati, “Niiba uri Umwana w'Imaana koko, tegeka aya mabuye ahinduke imigaati.”<verse eid="MAT 4:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 4:4" />Ariko Yesu aramusubiza ati, “Biranditswe ngo,</para>
  <para style="q1" vid="MAT 4:4">‘Umuntu ntaabwo atungwa n'umugaati gusa,</para>
  <para style="q2" vid="MAT 4:4">ahuubwo abeeshwaho n'ijambo ryose riva mu kanwa k'Imaana.’ ”<verse eid="MAT 4:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 4:5" />Nuuko Sataani arongera ajaana Yesu mu tawuni nkuru Yeera, amuhagarika ku gasongeero k'Inzu y'Imaana, <verse eid="MAT 4:5" /><verse number="6" style="v" sid="MAT 4:6" />maze aramubwira ati, “Niiba uri Umwana w'Imaana, simbukira haasi, kuko byanditswe ngo,</para>
  <para style="q1" vid="MAT 4:6">‘Imaana izaagutegekera abaamalayika baayo,</para>
  <para style="q2" vid="MAT 4:6">bagutegere amaboko bakuramire,</para>
  <para style="q1" vid="MAT 4:6">kugira ngo ikirenge caawe kidasiitaara ku ibuye.’ ”<verse eid="MAT 4:6" /></para>
  <para style="m">
    <verse number="7" style="v" sid="MAT 4:7" />Yesu aramusubiza ati, “Kandi, byanditswe ngo, ‘Ntukagerageze Uhoraho Imaana yaawe.’ ”<verse eid="MAT 4:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 4:8" />Nuuko Sataani arongera ajaana Yesu mu mpinga<note caller="+" style="f"><char style="fr" closed="false">4:8 </char><char style="fqa">Ku gasongero</char> cangwa <char style="fqa" closed="false">agatwetwe k'ikirunga </char></note> y'ikirunga kireekire caane, amwereka ubwami bwose bwo ku isi n'icuubahiro caabwo, <verse eid="MAT 4:8" /><verse number="9" style="v" sid="MAT 4:9" />aramubwira ati, “Biriiya byose ndabiguha, n'upfukama ukandamya.”<verse eid="MAT 4:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 4:10" />Yesu aramusubiza ati, “Hoshi genda, Sataani! Kuko byanditswe ngo,</para>
  <para style="q1" vid="MAT 4:10">‘Uramye Uhoraho Imaana yaawe,</para>
  <para style="q2" vid="MAT 4:10">abe ari yo yoonyine ukorera.’ ”<verse eid="MAT 4:10" /></para>
  <para style="m">
    <verse number="11" style="v" sid="MAT 4:11" />Sataani amusiga ahongaho, haaza abaamalayika baramukorera.<verse eid="MAT 4:11" /></para>
  <para style="s1">Yesu Atangirira i Galileeya Gukora Umurimo We</para>
  <para style="r">(<ref loc="MRK 1:14-15">Mar 1:14-15</ref>; <ref loc="LUK 4:14-15">Luk 4:14-15</ref>)</para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 4:12" />
    <note caller="-" style="x">
      <char style="xo" closed="false">4:12 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 14:3">Mat 14:3</ref>; <ref loc="MRK 6:17">Mar 6:17</ref>; <ref loc="LUK 3:19">Luk 3:19</ref>,<ref loc="LUK 3:20">20</ref>.</char>
    </note>Yesu yumviise ko Yohaana yashizwe mu gihome, aja i Galileeya. <verse eid="MAT 4:12" /><verse number="13" style="v" sid="MAT 4:13" /><note caller="-" style="x"><char style="xo" closed="false">4:13 </char><char style="xt" closed="false"><ref loc="JHN 2:12">Yoh 2:12</ref>.</char></note>Ava i Nazaareeti, yimukira i Kaperenawumu, i tawuni yegeranye n'inyanja y'i Galileeya mu gice ca Zebulooni na Nafutaali, <verse eid="MAT 4:13" /><verse number="14" style="v" sid="MAT 4:14" />kugira ngo bibe nk'uko byavugiwe mu muhanuuzi Yesaaya ngo,<verse eid="MAT 4:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="MAT 4:15" />“Gihugu ca Zebulooni n'ica Nafutaali,</para>
  <para style="q2" vid="MAT 4:15">ahagana ku nyanja, haakurya ya Yorodaani,</para>
  <para style="q2" vid="MAT 4:15">i Galileeya ituuwe n'abanyamahanga.<verse eid="MAT 4:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="MAT 4:16" />Abantu baari mu mwijima,</para>
  <para style="q2" vid="MAT 4:16">baaboonye umuco mwinshi,</para>
  <para style="q1" vid="MAT 4:16">naabo baari mu gihugu gicuze umwijima w'igicuucu c'urupfu</para>
  <para style="q2" vid="MAT 4:16">umuco warabamurikiye.”<verse eid="MAT 4:16" /></para>
  <para style="m">
    <verse number="17" style="v" sid="MAT 4:17" />
    <note caller="-" style="x">
      <char style="xo" closed="false">4:17 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 3:2">Mat 3:2</ref>.</char>
    </note>Uheereye ico gihe, Yesu atangira kwamamaza ubutumwa ati, “Nimwihane kuko Ubwami bw'ijuru bureegeereje.”<verse eid="MAT 4:17" /></para>
  <para style="s1">Yesu Ahamagara Abarobyi Bane</para>
  <para style="r">(<ref loc="MRK 1:16-20">Mar 1:16-20</ref>; <ref loc="LUK 5:1-11">Luk 5:1-11</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 4:18" />Ubwo Yesu yanyuraga ku nkengeero y'inyanja ya Galileeya, abona abarobyi babiri baari ibyenenyina, Simooni witwaga Peetero na Andereya, bari gushira ubutimba<note caller="+" style="f"><char style="fr" closed="false">4:18 </char><char style="ft" closed="false">ubutimba bwo kurobesha isamaaki</char></note> bwabo mu nyanja ngo barobe isamaaki. <verse eid="MAT 4:18" /><verse number="19" style="v" sid="MAT 4:19" />Nuuko arababwira ati, “Nimunkurikire, nzaabahindura abarobyi b'abantu.” <verse eid="MAT 4:19" /><verse number="20" style="v" sid="MAT 4:20" />Ako kaanya, basiga ubutimba bwabo baramukurikira.<verse eid="MAT 4:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 4:21" />Akomejemo abona abandi babiri, b'ibyenenyina ari bo, Yaakobo na Yohaana beene Zebedaayo bari mu bwato basana ubutimba bwabo. Yesu arabahamagara, <verse eid="MAT 4:21" /><verse number="22" style="v" sid="MAT 4:22" />baheerako basigira se ubwato, bakurikira Yesu.<verse eid="MAT 4:22" /></para>
  <para style="s1">Yesu Yiigiisha, Abwiriza kandi Akiza Abarwayi</para>
  <para style="r">(<ref loc="LUK 6:17-19">Luk 6:17-19</ref>)</para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 4:23" />
    <note caller="-" style="x">
      <char style="xo" closed="false">4:23 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 9:35">Mat 9:35</ref>; <ref loc="MRK 1:39">Mar 1:39</ref>.</char>
    </note>Yesu yitooroora i Galileeya yoose, yiigiishiriza abantu mu masinagoogi yaabo, ababwiriza Ubutumwa Bwiza bw'Ubwami bw'ijuru, kandi akiza abantu uburwayi n'indwara z'uburyo bwose. <verse eid="MAT 4:23" /><verse number="24" style="v" sid="MAT 4:24" />Inkuru y'ibyiza bye yamamara mu gihugu ca Siriya hoose, nuuko bamuzanira abantu boose barwaye indwara z'amooko atari amwe, imbabare n'abateewe na dayimooni, abarwaye ibicuri n'abarema, arabakiza. <verse eid="MAT 4:24" /><verse number="25" style="v" sid="MAT 4:25" />Nuuko imbaga y'abantu iramukurikira, bamwe baturutse i Galileeya, mu gice c'i Dekapolisi, abandi baturutse i Yerusaalemu n'i Yudeeya, no haakurya ya Yorodaani.<verse eid="MAT 4:25" /></para>
  <chapter eid="MAT 4" />
  <chapter number="5" style="c" sid="MAT 5" />
  <para style="ms">Yesu Yigiishiriza ku Musozi</para>
  <para style="mr">(<ref loc="MAT 5:1-7:29">5:1—7:29</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 5:1" />Yesu aboonye imbaga y'abantu, azaamuka umusozi. Amaze kwicara, abiigiishwa be baramwegeera. <verse eid="MAT 5:1" /><verse number="2" style="v" sid="MAT 5:2" />Nuuko atangira kuvuga kandi arabiigiisha ati:<verse eid="MAT 5:2" /></para>
  <para style="s1">Umuneezeero Nyaawo</para>
  <para style="r">(<ref loc="LUK 6:20-23">Luk 6:20-23</ref>)</para>
  <para style="q1">
    <verse number="3" style="v" sid="MAT 5:3" />“Hahiirwa abakene mu mitima yaabo,</para>
  <para style="q2" vid="MAT 5:3">kuko Ubwami bw'ijuru ari ubwabo.<verse eid="MAT 5:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="MAT 5:4" />Hahiirwa abashavura,</para>
  <para style="q2" vid="MAT 5:4">kuko bazaahuumurizwa.<verse eid="MAT 5:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="MAT 5:5" />Hahiirwa abiiciisha bugufi,</para>
  <para style="q2" vid="MAT 5:5">kuko ari bo bazaragwa isi.<verse eid="MAT 5:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="MAT 5:6" />Hahiirwa abasonzera ubutungaane bakabugirira imyota,</para>
  <para style="q2" vid="MAT 5:6">kuko bazaahaazwa.<verse eid="MAT 5:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="MAT 5:7" />Hahiirwa abanyampuhwe,</para>
  <para style="q2" vid="MAT 5:7">kuko bazaazigirirwa.<verse eid="MAT 5:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="MAT 5:8" />Hahiirwa abafite imitima itunganye,</para>
  <para style="q2" vid="MAT 5:8">kuko bazaabona Imaana.<verse eid="MAT 5:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="MAT 5:9" />Hahiirwa abaharanira amahoro,</para>
  <para style="q2" vid="MAT 5:9">kuko baziitwa abaana b'Imaana.<verse eid="MAT 5:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="MAT 5:10" />
    <note caller="-" style="x">
      <char style="xo" closed="false">5:10 </char>
      <char style="xt" closed="false">
        <ref loc="1PE 3:14">1Pet 3:14</ref>.</char>
    </note>Hahiirwa abatootezwa bazira gukiraanuka,</para>
  <para style="q2" vid="MAT 5:10">kuko Ubwami bw'ijuru ari ubwabo.<verse eid="MAT 5:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 5:11" />
    <note caller="-" style="x">
      <char style="xo" closed="false">5:11 </char>
      <char style="xt" closed="false">
        <ref loc="1PE 4:14">1Pet 4:14</ref>.</char>
    </note>Murahiirwa ni babatuka, bakabatooteza, bakababeeshera mu buryo byinshi ari nje babaryoza. <verse eid="MAT 5:11" /><verse number="12" style="v" sid="MAT 5:12" /><note caller="-" style="x"><char style="xo" closed="false">5:12 </char><char style="xt" closed="false"><ref loc="ACT 7:52">Iby 7:52</ref>.</char></note>Muziishiime kandi muneezeerwe, kuko mufite ibihembo bihebuuje mu ijuru, kuko ni ko n'abahanuuzi baababanjirije baatootejwe.<verse eid="MAT 5:12" /></para>
  <para style="s1">Umunyu hamwe n'Umuco</para>
  <para style="r">(<ref loc="MRK 9:50">Mar 9:50</ref>; <ref loc="LUK 14:34-35">Luk 14:34-35</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 5:13" />
    <note caller="-" style="x">
      <char style="xo" closed="false">5:13 </char>
      <char style="xt" closed="false">
        <ref loc="MRK 9:50">Mar 9:50</ref>; <ref loc="LUK 14:34">Luk 14:34</ref>,<ref loc="LUK 14:35">35</ref>.</char>
    </note>Muri umuunyu w'isi, ariko se umuunyu wamaze gukayuka, wakongera kuryoshwa ute? Ntaaco uba ukimaze keretse kujugunywa hanze abantu bakawukandagira.<verse eid="MAT 5:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 5:14" />
    <note caller="-" style="x">
      <char style="xo" closed="false">5:14 </char>
      <char style="xt" closed="false">
        <ref loc="JHN 8:12">Yoh 8:12</ref>; <ref loc="JHN 9:5">9:5</ref>.</char>
    </note>Muri umuco w'isi. I tawuni yubatswe ku mpinga y'umusozi ntiyahishwa. <verse eid="MAT 5:14" /><verse number="15" style="v" sid="MAT 5:15" /><note caller="-" style="x"><char style="xo" closed="false">5:15 </char><char style="xt" closed="false"><ref loc="MRK 4:21">Mar 4:21</ref>; <ref loc="LUK 8:16">Luk 8:16</ref>; <ref loc="LUK 11:33">11:33</ref>.</char></note>Ntaamuntu ucaana itaara ngo aryubikeho intonga, ahuubwo riterekwa ku gitereko caaryo, rikamurikira abari mu nzu boose. <verse eid="MAT 5:15" /><verse number="16" style="v" sid="MAT 5:16" /><note caller="-" style="x"><char style="xo" closed="false">5:16 </char><char style="xt" closed="false"><ref loc="1PE 2:12">1Pet 2:12</ref>.</char></note>No ku bw'iyo mpamvu reero, mucaane amataara yaanyu amurikire abandi, kugira ngo babone imirimo yaanyu myiza maze baheereko bahe So wo mu ijuru ikuzo.<verse eid="MAT 5:16" /></para>
  <para style="s1">Yesu Yiigiisha ibyerekeye Amategeko</para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 5:17" />Ntimuteekereze ko nazanywe no gukuraho amategeko cangwa ibyanditswe n'abahanuuzi, sinazanywe no kubivaanaho ahuubwo naaje kubisohoza. <verse eid="MAT 5:17" /><verse number="18" style="v" sid="MAT 5:18" /><note caller="-" style="x"><char style="xo" closed="false">5:18 </char><char style="xt" closed="false"><ref loc="LUK 16:17">Luk 16:17</ref>.</char></note>Ndababwira ukuri yuuko, ijuru n'isi bikiriho, ntakanyuguti na kamwe cangwa akadomo<note caller="+" style="f"><char style="fr" closed="false">5:18 </char><char style="ft" closed="false">Ibindi byanditswe byera bandika </char><char style="fqa">iyota</char> ari ko kanyuguti gasembayo kuba gato mu nyuguti z'aba Giriki</note> na kamwe kazaakurwa ku mategeko byose bitari byarangira. <verse eid="MAT 5:18" /><verse number="19" style="v" sid="MAT 5:19" />Noone reero uziica rimwe muri aya mategeko n'aho ryaba ryoroshe kuruta ayandi, akiigiisha abandi kugenza nka we, azaagirwa uwanyuma mu Bwami bw'ijuru. Ariko uzaayakurikiza, akayiigiisha abandi aziitwa mukuru mu Bwami bw'ijuru. <verse eid="MAT 5:19" /><verse number="20" style="v" sid="MAT 5:20" />Kandi ndababwira yuuko nimutaba abakiraanutsi kuruta Abiigiishamategeko n'Abafarisaayo, ntaabwo muzinjira mu Bwami bw'ijuru.<verse eid="MAT 5:20" /></para>
  <para style="s1">Inyigiisho Yeerekeye Uburaakari</para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 5:21" />Mwumviise ko abaakeera babwiwe bati, ‘Ntuukiice, uwishe weese azaahanwa.’ <verse eid="MAT 5:21" /><verse number="22" style="v" sid="MAT 5:22" />Ariko ndababwira yuuko uraakarira umuvandimwe we,<note caller="+" style="f"><char style="fr" closed="false">5:22 </char><char style="ft" closed="false">Mu bindi byanditse byera bongeraho bati, </char><char style="it">nta co bapfa</char> </note> akwiriye guhanwa n'ubucaamanza. Kandi uzaatuka mwene nyina cangwa mushiki we akwiriye kujanwa imbere y'urukiko agaciirwa urubanza, kandi uvuga ati, ‘Wa gipfaapfa we,’ aba ari uwo gushirwa mu nyenga y'umuriro utazima<note caller="+" style="f"><char style="fr" closed="false">5:22 </char><char style="fqa" closed="false">Gehenomu </char></note>. <verse eid="MAT 5:22" /><verse number="23" style="v" sid="MAT 5:23" />Nuuko n'ujaana ituuro ryawe ku rutambiro rw'Imaana, wahagera ukiibuka ko ufite ico upfa n'umuvandimwe waawe, <verse eid="MAT 5:23" /><verse number="24" style="v" sid="MAT 5:24" />usige iryo tuuro aho imbere y'urutambiro, maze ubanze ugende wikiraanure n'uwo muvandimwe, ubone kuuza gutanga ituuro ryawe. <figure style="fig" alt="Leave your offering at the altar and first settle your dispute with a brother" file="DD-32B.TIF" size="col" loc="Darwin" copy="The British and Foreign Bible Societies" ref="5:24">Usige ituuro ryawe aho kurutambiro, umanze wikiranuura n'umuvandimwe.</figure><verse eid="MAT 5:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 5:25" />Wikiranure vuba n'ukurega mukiri mu nzira kugira ngo atakujaanira umucaamanza, umucaamanza na we akagushikiriza umusirikare nuuko ugashirwa mu gihome. <verse eid="MAT 5:25" /><verse number="26" style="v" sid="MAT 5:26" />Ndakubwira ukuri yuuko utazaavamo utabanje kwishura umwenda woose ntihasigare na gake.<verse eid="MAT 5:26" /></para>
  <para style="s1">Inyigiisho Yeerekeye Ubusambanyi</para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 5:27" />Mwumviise ko byavuzwe ngo, ‘Ntuugasambane.’ <verse eid="MAT 5:27" /><verse number="28" style="v" sid="MAT 5:28" />Ariko ndababwira yuuko umuntu weese ureeba umugore akamurarikira, aba amaze gusambana na we mu biteekerezo bye. <verse eid="MAT 5:28" /><verse number="29" style="v" sid="MAT 5:29" /><note caller="-" style="x"><char style="xo" closed="false">5:29 </char><char style="xt" closed="false"><ref loc="MAT 18:9">Mat 18:9</ref>; <ref loc="MRK 9:47">Mar 9:47</ref>.</char></note>Ijiisho ryawe ry'iburyo nirikuguusha mu caaha, urinogooremo urite, biraruta ko wabura rumwe mu ngingo zaawe, aho kugira ngo umubiri waawe woose utaabwe mu muriro w'iteeka. <verse eid="MAT 5:29" /><verse number="30" style="v" sid="MAT 5:30" /><note caller="-" style="x"><char style="xo" closed="false">5:30 </char><char style="xt" closed="false"><ref loc="MAT 18:8">Mat 18:8</ref>; <ref loc="MRK 9:43">Mar 9:43</ref>.</char></note>Kandi ukuboko kwawe kw'iburyo nikukuguusha mu caaha, uguceho ugute. Biraruta ko wabura rumwe mu ngingo zaawe, aho kugira ngo umubiri waawe woose utaabwe mu muriro w'iteeka.<verse eid="MAT 5:30" /></para>
  <para style="s1">Inyigiisho Yeerekeye Gutaana kw'Abashaakanye</para>
  <para style="r">(<ref loc="MAT 19:9">Mat 19:9</ref>; <ref loc="MRK 10:11-12">Mar 10:11-12</ref>; <ref loc="LUK 16:18">Luk 16:18</ref>)</para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 5:31" />
    <note caller="-" style="x">
      <char style="xo" closed="false">5:31 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 19:7">Mat 19:7</ref>; <ref loc="MRK 10:4">Mar 10:4</ref>.</char>
    </note>Kandi byaravuzwe ngo, ‘Uzaashaaka kwirukana umugore we akwiriye kumuha urwandiko rwemeza ko batandukanye.’ <verse eid="MAT 5:31" /><verse number="32" style="v" sid="MAT 5:32" /><note caller="-" style="x"><char style="xo" closed="false">5:32 </char><char style="xt" closed="false"><ref loc="MAT 19:9">Mat 19:9</ref>; <ref loc="MRK 10:11">Mar 10:11</ref>,<ref loc="MRK 10:12">12</ref>; <ref loc="LUK 16:18">Luk 16:18</ref>; <ref loc="1CO 7:10">1 Kor 7:10</ref>,<ref loc="1CO 7:11">11</ref>.</char></note>Ariko nje ndababwira ko umuntu weese wirukana umugore we atamuhooye gusambana, nyuma agatungwa n'undi mugabo, aba amuteeye ubusambanyi. Byongeye kandi, ushohoje uwo mugore wirukanywe na we aba asambanye.<verse eid="MAT 5:32" /></para>
  <para style="s1">Inyigiisho Yeerekeye Indahiro</para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 5:33" />Byongeye, mwumviise ko abaakeera baabwiwe bati, ‘Ntuukarahire ibinyoma, ahuubwo uzaakorere Uhoraho ibyo wamuseezeranyije mu ndahiro.’ <verse eid="MAT 5:33" /><verse number="34" style="v" sid="MAT 5:34" /><note caller="-" style="x"><char style="xo" closed="false">5:34 a </char><char style="xt" closed="false"><ref loc="JAS 5:12">Yaak 5:12</ref>; </char><char style="xo" closed="false">b </char><char style="xt" closed="false"><ref loc="MAT 23:22">Mat 23:22</ref>.</char></note>Ariko nje ndababwira ngo, ntimukarahire na hato, kwaba kurahira mushingiye ku ijuru kuko ari ryo ntebe ya caami y'Imaana, <verse eid="MAT 5:34" /><verse number="35" style="v" sid="MAT 5:35" />cangwa ku isi, kuko ari yo kabaaho ikandagizaho ibirenge, cangwa kuri i Yerusaalemu kuko ari yo tawuni nkuru y'Umwami ukomeye. <verse eid="MAT 5:35" /><verse number="36" style="v" sid="MAT 5:36" />Kandi ntuuzaarahire n'umutwe waawe, kuko udashobora guhindura n'umwe mu misatsi yaawe ngo ube umweru cangwa umukara. <verse eid="MAT 5:36" /><verse number="37" style="v" sid="MAT 5:37" />Ahuubwo muje muvuga muti, ‘Yeego’, cangwa ‘Oya,’ ibirenze ibyo biba bituruka kuri Seekibi.<verse eid="MAT 5:37" /></para>
  <para style="s1">Inyigiisho Yeerekeye Kwihoorera</para>
  <para style="r">(<ref loc="LUK 6:29-30">Luk 6:29-30</ref>)</para>
  <para style="p">
    <verse number="38" style="v" sid="MAT 5:38" />Mwumviise ko byavuzwe ngo, ‘Umennye undi ijiisho, na we barimumene kandi ukuye undi iryinyo na we barimukuure.’ <verse eid="MAT 5:38" /><verse number="39" style="v" sid="MAT 5:39" />Ariko nje ndababwira kutiituura inaabi abaayibagiriye. Ahuubwo nihagira ugukubita ku musaya w'i buryo, umuhindurire n'undi awukubite. <verse eid="MAT 5:39" /><verse number="40" style="v" sid="MAT 5:40" />Kandi umuntu naashaaka kukubuuranya ngo akunyage isaati yaawe, umuhe n'ikooti, <verse eid="MAT 5:40" /><verse number="41" style="v" sid="MAT 5:41" />ndetse nihagira ugutegeka kugenda urugendo rwa mayilo imwe, uzakomezemo ugende n'iya kabiri. <verse eid="MAT 5:41" /><verse number="42" style="v" sid="MAT 5:42" />Nihagira ugira ico agusaba uzaakimuhe, nihagira ugira ico agutiira, uzaakimutiize.<verse eid="MAT 5:42" /></para>
  <para style="s1">Gukunda Abanzi</para>
  <para style="r">(<ref loc="LUK 6:27-28">Luk 6:27-28</ref>,<ref loc="LUK 6:32-36">32-36</ref>)</para>
  <para style="p">
    <verse number="43" style="v" sid="MAT 5:43" />Mwumviise ko byavuzwe ngo, ‘Uje ukunda mugenzi waawe, wange umwanzi waawe.’ <verse eid="MAT 5:43" /><verse number="44" style="v" sid="MAT 5:44" />Ariko nje ndababwira ngo, ‘mukunde abanzi baanyu kandi muje musabira ababatooteza,’ <verse eid="MAT 5:44" /><verse number="45" style="v" sid="MAT 5:45" />kugira ngo mube abaana ba So uri mu ijuru, kuko avuusha izuuba rye ku babi no ku beeza, kandi akagwisha imvura ku batunganye no kubadatunganye. <verse eid="MAT 5:45" /><verse number="46" style="v" sid="MAT 5:46" />Nimukunda ababakunda gusa, muzaagira bihembo ki? Mbese abasoreesha bo ntibagenza batyo? <verse eid="MAT 5:46" /><verse number="47" style="v" sid="MAT 5:47" />Kandi n'uramutsa abavandimwe baawe gusa, uba urushije iki abandi bantu? Mbese abapagaani bo ntibabigenza batyo? <verse eid="MAT 5:47" /><verse number="48" style="v" sid="MAT 5:48" />Mube intungaane nk'uko na So wo mu ijuru ari intungaane.<verse eid="MAT 5:48" /></para>
  <chapter eid="MAT 5" />
  <chapter number="6" style="c" sid="MAT 6" />
  <para style="s1">Inyigiisho Yeerekeye Gufasha Abakene</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 6:1" />
    <note caller="-" style="x">
      <char style="xo" closed="false">6:1 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 23:5">Mat 23:5</ref>.</char>
    </note>Mwirinde gukorera ibikorwa by'ubukiraanutsi kumugaragaro kugira ngo babareebe, kuko nimugira mutyo, ntimuzaabona ingororano ya So wo mu ijuru.<verse eid="MAT 6:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="MAT 6:2" />Ahuubwo igihe utanze imfashanyo, ntukabyamamaze nk'uko indyarya zibigenzereza mu masinagoogi no ku mihanda kugira ngo zishimwe. Ndababwira ukuri yuuko abo baba bamaze guhaabwa ingororano yaabo. <verse eid="MAT 6:2" /><verse number="3" style="v" sid="MAT 6:3" />Ariko igihe utanze imfashanyo, ukuboko kwawe kwa bumoso ntikukamenye ico ukwa buryo gutanze, <verse eid="MAT 6:3" /><verse number="4" style="v" sid="MAT 6:4" />kugira ngo ibyo utanze bibe ibanga, nuuko So wo mu ijuru ureeba ibyihereereye azaabagororera.<verse eid="MAT 6:4" /></para>
  <para style="s1">Inyigiisho Yeerekeye Gusenga</para>
  <para style="r">(<ref loc="LUK 11:2-4">Luk 11:2-4</ref>)</para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 6:5" />
    <note caller="-" style="x">
      <char style="xo" closed="false">6:5 </char>
      <char style="xt" closed="false">
        <ref loc="LUK 18:10-14">Luk 18:10-14</ref>.</char>
    </note>Kandi igihe musenga, ntimukabe nk'abantu b'indyarya, bakunda gusenga bahagaze mu masinagoogi no ku mihanda, kugira ngo abantu babareebe. Ndababwira ukuri yuuko abo baba bamaze guhaabwa ingororano yaabo. <verse eid="MAT 6:5" /><verse number="6" style="v" sid="MAT 6:6" />Ahuubwo igihe usenga, uje winjira mu gisenge caawe ukinge, maze usenge So mwihereeranye. Kandi So ureeba ibyiherereye azaakugororera.<verse eid="MAT 6:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 6:7" />Igihe usenga, ntuugatondagure amagambo atagira ico avuga nk'uko abapagaani babigenza, kuko bateekereza ko kuvuga amagambo menshi bituma bumvwa. <verse eid="MAT 6:7" /><verse number="8" style="v" sid="MAT 6:8" />Ntimukabe nka bo, kuko So azi ibyo mukeneye mutaraabimusaba.<verse eid="MAT 6:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 6:9" />Nuuko reero muje musenga mutya:</para>
  <para style="q1" vid="MAT 6:9">Daata wa twese uri mu Ijuru,</para>
  <para style="q2" vid="MAT 6:9">izina ryawe ryubahwe.<verse eid="MAT 6:9" /></para>
  <para style="q2">
    <verse number="10" style="v" sid="MAT 6:10" />Ubwami bwawe buuze.</para>
  <para style="q2" vid="MAT 6:10">Ibyo ushaaka bikorwe</para>
  <para style="q3" vid="MAT 6:10">mu isi nk'uko bikorwa mu ijuru.<verse eid="MAT 6:10" /></para>
  <para style="q2">
    <verse number="11" style="v" sid="MAT 6:11" />Uduhe ifunguro ridutunga uko bukeeye<note caller="+" style="f"><char style="fr" closed="false">6:11 </char><char style="fqa" closed="false">Uduhe noone ibyokurya byacu by'uyu munsi </char></note>.<verse eid="MAT 6:11" /></para>
  <para style="q2">
    <verse number="12" style="v" sid="MAT 6:12" />Utubabarire ibyaha byacu,</para>
  <para style="q3" vid="MAT 6:12">nk'uko naatwe tubabarira abaducumuraho.<verse eid="MAT 6:12" /></para>
  <para style="q2">
    <verse number="13" style="v" sid="MAT 6:13" />Ntuuduteererane ngo tugwe mu bitugerageza,</para>
  <para style="q2" vid="MAT 6:13">ahuubwo udukize Umubi<note caller="+" style="f"><char style="fr" closed="false">6:13 </char><char style="ft" closed="false">Ibindi byanditswe byera bongeraho </char><char style="fqa" closed="false">Kuko ubwami n'ubushobozi n'icuubahiro ari ibyawe, ubu n'iteeka ryose. Amiina </char></note>.<verse eid="MAT 6:13" /></para>
  <para style="m">
    <verse number="14" style="v" sid="MAT 6:14" />
    <note caller="-" style="x">
      <char style="xo" closed="false">6:14 </char>
      <char style="xt" closed="false">
        <ref loc="MRK 11:25">Mar 11:25</ref>,<ref loc="MRK 11:26">26</ref>.</char>
    </note>Kuko nimubabarira abandi ibyaha baabakoreye, So uri mu ijuru na we azaabababarira ibyaha byanyu. <verse eid="MAT 6:14" /><verse number="15" style="v" sid="MAT 6:15" />Ariko nimutababarira abandi, So uri mu ijuru na we ntaabwo azaabababarira ibyaha byanyu.<verse eid="MAT 6:15" /></para>
  <para style="s1">Inyigiisho Ifashe ku Gusiiba</para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 6:16" />Kandi igihe musiiba, ntimukiijime ku maaso ngo mugaragaze umubabaro nk'uko indyarya zibikora, zikambya agahanga kugira ngo abantu bamenye ko ziri mu gisiibo. Ndababwira ukuri yuuko abo baba baamaze guhaabwa ingororano yaabo. <verse eid="MAT 6:16" /><verse number="17" style="v" sid="MAT 6:17" />Ariko mwebwe nimusiiba, mwisiige amavuta mu mutwe, kandi mukarabe mu maaso, <verse eid="MAT 6:17" /><verse number="18" style="v" sid="MAT 6:18" />kugira ngo abantu batamenya ko mwasiibye ahuubwo bimenywe na So wenyine utagaragara, kandi So ureeba ibyihereereye azaabaha ingororano.<verse eid="MAT 6:18" /></para>
  <para style="s1">Gukungaanya Ubukungu bwo mu Ijuru</para>
  <para style="r">(<ref loc="LUK 12:33-34">Luk 12:33-34</ref>)</para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 6:19" />
    <note caller="-" style="x">
      <char style="xo" closed="false">6:19 </char>
      <char style="xt" closed="false">
        <ref loc="JAS 5:2">Yaak 5:2</ref>,<ref loc="JAS 5:3">3</ref>.</char>
    </note>Ntimugakungaanyirize ubukungu bwanyu ku isi aho bwononwa n'ibiseesamuzinga n'ingese<note caller="+" style="f"><char style="fr" closed="false">6:19 </char><char style="ft" closed="false">Ibisesamuzinga n'ibisimba bisa n'ibinyugunyugu byonona imyenda kandi </char><char style="fq">ingese</char> zituma ibyuma bikereba bikononekara.</note>, kandi n'aho abajuura baapfumura bakabwiba. <verse eid="MAT 6:19" /><verse number="20" style="v" sid="MAT 6:20" />Ahuubwo, mwikungaanyirize ubukungu bwo mu ijuru, aho ibiseesamuzinga n'ingese bitagera, n'aho abajuura badashobora gupfumura. <verse eid="MAT 6:20" /><verse number="21" style="v" sid="MAT 6:21" />Kuko aho ubutunzi bwawe buri, ni ho uzaahoza umutima.<verse eid="MAT 6:21" /></para>
  <para style="s1">Akamaro k'Ijiisho ku Mubiri</para>
  <para style="r">(<ref loc="LUK 11:34-36">Luk 11:34-36</ref>)</para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 6:22" />Ijiisho ni itaara rimurikira umubiri waawe. Iyo amaaso yaawe areeba neeza, umubiri woose ugira umuco, <verse eid="MAT 6:22" /><verse number="23" style="v" sid="MAT 6:23" />ariko ijiisho ryawe niiba ritameze neeza, umubiri waawe woose wuzura umwijima. Reero niiba umuco ukurimo ari umwijima, mbeega ukuntu uwo mwijima uzaaba mwinshi!<verse eid="MAT 6:23" /></para>
  <para style="s1">Gukorera Abatware Babiri</para>
  <para style="r">(<ref loc="LUK 16:13">Luk 16:13</ref>; <ref loc="LUK 12:22-31">12:22-31</ref>)</para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 6:24" />Nta mugaragu ushobora gukorera abatware babiri, kuko yakwanga umwe agakunda undi, cangwa akiitangira umwe agasuuzugura undi. Ntimushobora gukorera Imaana n'ubutunzi<note caller="+" style="f"><char style="fr" closed="false">6:24 </char><char style="ft" closed="false">Mu bindi byanditswe byera bavuga </char><char style="fqa" closed="false">Amashilingi</char></note>.<verse eid="MAT 6:24" /></para>
  <para style="s1">Ntimugahagarike Imitima</para>
  <para style="r">(<ref loc="LUK 12:22-31">Luk 12:22-31</ref>)</para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 6:25" />Ni co gitumye mbabwira ngo, ntimugahagarike imitima yaanyu ku byerekeye ubuzima bwanyu muti, mbese tuzaarya iki, cangwa tuzanywa iki, cangwa ibifashe ku mubiri waanyu muti, mbese tuzambara iki. Mbese ubuzima ntiburuta ibyo kurya, n'umubiri ukaruta imyambaro? <verse eid="MAT 6:25" /><verse number="26" style="v" sid="MAT 6:26" />Nimureebe inyoni zo mu kireere, ntizibiba, ntizisaaruura cangwa ngo zihunike mu bigega, ariko So wo mu ijuru arazigaburira. Mbese ntimuzirusha agaciiro? <verse eid="MAT 6:26" /><verse number="27" style="v" sid="MAT 6:27" />Kandi hari n'umwe muri mwe ushobora kwiyongeereraho niibura akaanya gato ku buzima bwe ku bwo guhagarika umutima? <verse eid="MAT 6:27" /><verse number="28" style="v" sid="MAT 6:28" />Noone n'iki gituma muhagarika imitima yaanyu mwibaza ico muzambara? Mwitegereze ukuntu ibimori byo mu gasozi bikura, nta murimo bikora, nta n'imyenda biboha, <verse eid="MAT 6:28" /><verse number="29" style="v" sid="MAT 6:29" />ariko ndababwira ukuri yuuko na Solomooni mu cuubahiro yari afite coose, atiigeze yambara nka kimwe muri ibyo bimori. <verse eid="MAT 6:29" /><verse number="30" style="v" sid="MAT 6:30" />Noone se niiba Imaana yambika ityo ibyatsi byo mu gasozi biriho noone, ejo bikajugunywa mu muriro, mwe ntizaarushaho kubambika mwabanyakwizeera guke mwe? <verse eid="MAT 6:30" /><verse number="31" style="v" sid="MAT 6:31" />Nuuko reero ntimugahagarike imitima, mwibaza muti, ‘Tuzaarya iki?’ Cangwa muti, ‘Tuzanywa iki?’ Cangwa muti, ‘Tuzambara iki?’ <verse eid="MAT 6:31" /><verse number="32" style="v" sid="MAT 6:32" />Ibyo byose abanyamahanga ni byo baharanira, nyamara So wo mu ijuru azi ko ibyo byose mubikeneye. <verse eid="MAT 6:32" /><verse number="33" style="v" sid="MAT 6:33" />Ariko mbere ya byose muharanire Ubwami bw'Imaana no gukiraanuka kwayo, ni ho ibindi byose muzaabyongeererwa.<verse eid="MAT 6:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 6:34" />Noone reero ntimugahagarike imitima yaanyu mwibaza iby'ejo, kuko iby'ejo bibara ab'ejo, kandi ingoorane za buri munsi zirahaagije.<verse eid="MAT 6:34" /></para>
  <chapter eid="MAT 6" />
  <chapter number="7" style="c" sid="MAT 7" />
  <para style="s1">Guciira Abandi Imanza</para>
  <para style="r">(<ref loc="LUK 6:37-38">Luk 6:37-38</ref>,<ref loc="LUK 6:41-42">41-42</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 7:1" />Ntimugaciire abandi urubanza, kugira ngo namwe mutazaaruciirwa. <verse eid="MAT 7:1" /><verse number="2" style="v" sid="MAT 7:2" /><note caller="-" style="x"><char style="xo" closed="false">7:2 </char><char style="xt" closed="false"><ref loc="MRK 4:24">Mar 4:24</ref>.</char></note>Kuko urubanza muciira abandi ari rwo muzaaciirwa, kandi urugero mugeramo ari rwo muzaagererwamo. <verse eid="MAT 7:2" /><verse number="3" style="v" sid="MAT 7:3" />Kuki ureeba igitokoozi co mu jiisho rya mugenzi waawe, ariko ukirengagiza umugogo uri mu ryawe? <verse eid="MAT 7:3" /><verse number="4" style="v" sid="MAT 7:4" />Cangwa se, wabwira ute mugenzi waawe uti, ‘Reka ngutokoore igitokoozi kiri mu ijiisho ryawe,’ kandi utareeba umugogo uri mu ryawe? <verse eid="MAT 7:4" /><verse number="5" style="v" sid="MAT 7:5" />Wa ndyarya we, banza utokoore umugogo uri mu jiisho ryawe, nuuko ubone uko wakiza mugenzi waawe igitokoozi kiri mu jiisho rye.<verse eid="MAT 7:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 7:6" />Ibyejejwe ntimukabihe imbwa, kandi ntimugate amasaro yaanyu y'umutaako y'igiciiro imbere y'ingurube, kuko zaayakandagira, zikabiihiindukana maze zikabatanyaguza.<verse eid="MAT 7:6" /></para>
  <para style="s1">Gusaba, Gushaaka, Gukomanga</para>
  <para style="r">(<ref loc="LUK 11:9-13">Luk 11:9-13</ref>)</para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 7:7" />Musabe muzaahaabwa, mushaake muzaabona, mukomange, urugi ruzakinguurwa. <verse eid="MAT 7:7" /><verse number="8" style="v" sid="MAT 7:8" />Kuko usaba weese arahaabwa, ushaaka arabona, kandi ukomanga arakinguurirwa. <verse eid="MAT 7:8" /><verse number="9" style="v" sid="MAT 7:9" />Muri mwe ni nde wo umwana we yaasaba umugaati akamuha ibuye? <verse eid="MAT 7:9" /><verse number="10" style="v" sid="MAT 7:10" />Cangwa yaamusaba isaamaaki akamuha inzoka? <verse eid="MAT 7:10" /><verse number="11" style="v" sid="MAT 7:11" />Noone se mwe ko muri babi mukaba muuzi kugenera abaana baanyu ibyiza, So uri mu ijuru we ntaazaarushaho guha ibyiza ababimusabye?<verse eid="MAT 7:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 7:12" />
    <note caller="-" style="x">
      <char style="xo" closed="false">7:12 </char>
      <char style="xt" closed="false">
        <ref loc="LUK 6:31">Luk 6:31</ref>.</char>
    </note>Muri byose, muje mugirira abandi uko mwifuuza kugirirwa, kuko iri ni ryo tegeko n'ibyahanuuwe.<verse eid="MAT 7:12" /></para>
  <para style="s1">Irembo Rifunganye</para>
  <para style="r">(<ref loc="LUK 13:24">Luk 13:24</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 7:13" />Mwinjire mu irembo rifunganye, kuko irembo rijaana abantu kurimbuka ni rinini kandi n'inzira ijayo ntiiruhije, n'abayinyuramo ni benshi. <verse eid="MAT 7:13" /><verse number="14" style="v" sid="MAT 7:14" />Na ho irembo rija mu bugingo rirafungaanye kandi n'inzira ijayo iraruhije, n'abarinyuramo ni bake.<verse eid="MAT 7:14" /></para>
  <para style="s1">Igiti n'Imbuto Zaaco</para>
  <para style="r">(<ref loc="LUK 6:43-44">Luk 6:43-44</ref>)</para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 7:15" />Mwirinde abahanuuzi b'ibinyoma, baaza biigize nk'intaama ariko munda ari amasega aryana. <verse eid="MAT 7:15" /><verse number="16" style="v" sid="MAT 7:16" />Muzaabamenyera ku mbuto beera. Mbese wasoroma imbuto z'imizaabibu ku giti c'amahwa, cangwa imbuto z'umutiini ku matovu? <verse eid="MAT 7:16" /><verse number="17" style="v" sid="MAT 7:17" />Ni na ko, buri giti ciiza ceera imbuto nziiza, naho igiti kibi kikeera imbuto mbi. <verse eid="MAT 7:17" /><verse number="18" style="v" sid="MAT 7:18" />Igiti ciiza ntigishobora kwera imbuto mbi, kandi n'igiti kibi ntigishobora kwera imbuto nziiza. <verse eid="MAT 7:18" /><verse number="19" style="v" sid="MAT 7:19" /><note caller="-" style="x"><char style="xo" closed="false">7:19 </char><char style="xt" closed="false"><ref loc="MAT 3:10">Mat 3:10</ref>; <ref loc="LUK 3:9">Luk 3:9</ref>.</char></note>Igiti coose kiteera imbuto nziiza kiratemwa kikajugunywa mu muriro. <verse eid="MAT 7:19" /><verse number="20" style="v" sid="MAT 7:20" /><note caller="-" style="x"><char style="xo" closed="false">7:20 </char><char style="xt" closed="false"><ref loc="MAT 12:33">Mat 12:33</ref>.</char></note>Nuuko reero, muzaabamenyera ku mbuto zaabo.<verse eid="MAT 7:20" /></para>
  <para style="s1">Abatazeemerwa mu Bwami bw'Imaana</para>
  <para style="r">(<ref loc="LUK 13:25-27">Luk 13:25-27</ref>)</para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 7:21" />Umuntu weese umbwira ati, ‘Nyagasani, Nyagasani,’ si we uzinjira mu Bwami bwo mu ijuru, keretse abo bakora ibyo Daata uri mu ijuru ashaaka. <verse eid="MAT 7:21" /><verse number="22" style="v" sid="MAT 7:22" />Kuri uwo munsi, benshi bazambwira bati, ‘Nyagasani, Nyagasani, mbese ntitwahanuuye mu izina ryawe, kandi tukiirukana abadayimooni mu izina ryawe, tugakora n'ibitangaaza byinshi mu izina ryawe?’ <verse eid="MAT 7:22" /><verse number="23" style="v" sid="MAT 7:23" />Ni bwo nzaabeerurira nti, ‘Siniigeeze mbamenya, nimumve imbere mwa nkozi z'ibibi mwe!’<verse eid="MAT 7:23" /></para>
  <para style="s1">Abuubatsi Babiri</para>
  <para style="r">(<ref loc="LUK 6:47-49">Luk 6:47-49</ref>)</para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 7:24" />Umuntu weese wumva aya magambo yanje akayakurikiza, ameze nk'umunyabwenge wuubatse inzu ye ku rutare. <verse eid="MAT 7:24" /><verse number="25" style="v" sid="MAT 7:25" />Nyuma, imvura iragwa, imyuzure iratemba, umuyaga urahuuha byose byihuura kuri iyo nzu, ariko ntiyagwa kuko yari yubatswe ku rutare. <verse eid="MAT 7:25" /><verse number="26" style="v" sid="MAT 7:26" />Kandi umuntu weese wumva aya magambo yanje ntaayakurikize, azaamera nk'umupfaapfa wuubatse inzu ye ku umuseenyi. <verse eid="MAT 7:26" /><verse number="27" style="v" sid="MAT 7:27" />Imvura iragwa, imyuzure iratemba, umuyaga urahuuha, byose bikoranira kuri iyo nzu ihita igwa. Si ukugwa gusa ahuubwo yahindutse ubushingwe!”<verse eid="MAT 7:27" /></para>
  <para style="s1">Ububaasha bwa Yesu</para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 7:28" />
    <note caller="-" style="x">
      <char style="xo" closed="false">7:28 </char>
      <char style="xt" closed="false">
        <ref loc="MRK 1:22">Mar 1:22</ref>; <ref loc="LUK 4:32">Luk 4:32</ref>.</char>
    </note>Yesu amaze kuvuga ibyo byose, rubanda rutangaarira imyigiishirize ye, <verse eid="MAT 7:28" /><verse number="29" style="v" sid="MAT 7:29" />kuko yabiigiishaga nk'ufite ububaasha atari nk'uko Abiigiishamategeko baabo biigiishaga.<verse eid="MAT 7:29" /></para>
  <chapter eid="MAT 7" />
  <chapter number="8" style="c" sid="MAT 8" />
  <para style="s1">Yesu Akiza Umubembe</para>
  <para style="r">(<ref loc="MRK 1:40-45">Mar 1:40-45</ref>; <ref loc="LUK 5:12-16">Luk 5:12-16</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 8:1" />Yesu amanutse kuri uwo musozi, abantu benshi baramukurikira. <verse eid="MAT 8:1" /><verse number="2" style="v" sid="MAT 8:2" />Maze haaza umubembe aramwegeera, aramupfukamira aramubwira ati, “Nyagasani, ubishaatse wankiza<note caller="+" style="f"><char style="fr" closed="false">8:2 </char><char style="ft" closed="false">Mu bindi byanditswe byera bakoresha, </char><char style="fqa">wanyeza</char> iyo ndwara yatumaga umuntu ahumaana.</note>.”<verse eid="MAT 8:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 8:3" />Yesu arambuura ukuboko amukoraho aravuga ati, “Ndabishaaka, kira!” Ako kaanya ibibembe bye birakira. <verse eid="MAT 8:3" /><verse number="4" style="v" sid="MAT 8:4" />Nuuko Yesu aramubwira ati, “Uramenye ntihagire uwo ubwira, ariko, ugende wiyereke umuheerezabitambo, maze utange ituuro Moose yategetse, ribabeere iceemezo c'uko wakize.”<verse eid="MAT 8:4" /></para>
  <para style="s1">Yesu Akiza Umugaragu w'Umutware w'Abasirikare</para>
  <para style="r">(<ref loc="LUK 7:1-10">Luk 7:1-10</ref>)</para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 8:5" />Yesu ageze i Kaperenawumu, umutware w'abasirikare ijana aramwegeera, aramwinginga <verse eid="MAT 8:5" /><verse number="6" style="v" sid="MAT 8:6" />aramubwira ati, “Nyagasani, nasize umugaragu wanje mu rugo aryamye, kandi arababara bikabije.” <verse eid="MAT 8:6" /><verse number="7" style="v" sid="MAT 8:7" />Yesu aramusubiza ati, “Ndaaza mukize.” <verse eid="MAT 8:7" /><verse number="8" style="v" sid="MAT 8:8" />Uwo mutware w'abasirikare ijana aramusubiza ati, “Nyagasani, ntibinkwiriye ko winjira mu nzu yanje, ahuubwo vuga ijambo ryawe gusa, umugaragu wanje arakira. <verse eid="MAT 8:8" /><verse number="9" style="v" sid="MAT 8:9" />Kuko nanje ndi umuntu ufite ububaasha, kandi mfite abasirikare ntegeka. Iyo mbwiye umwe muri bo nti, ‘Genda,’ aragenda, naabwira undi nti, ‘Ngwino,’ akaaza, naabwira umugaragu wanje nti, ‘Kora iki,’ akagikora.”<verse eid="MAT 8:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 8:10" />Yesu abyumviise, aratangaara abwira abaari bamukurikiye ati, “Ndababwira ukuri ko muri Isirayeli ntiigeze mbona umuntu ufite kwizeera nk'uku. <verse eid="MAT 8:10" /><verse number="11" style="v" sid="MAT 8:11" /><note caller="-" style="x"><char style="xo" closed="false">8:11 </char><char style="xt" closed="false"><ref loc="LUK 13:29">Luk 13:29</ref>.</char></note>Kandi ndababwira yuuko benshi bazaaturuka iburasirazuuba n'iburengerazuuba, bagasangira na Aburahamu, Isaaka na Yaakobo mu Bwami bwo mu ijuru, <verse eid="MAT 8:11" /><verse number="12" style="v" sid="MAT 8:12" /><note caller="-" style="x"><char style="xo" closed="false">8:12 </char><char style="xt" closed="false"><ref loc="MAT 22:13">Mat 22:13</ref>; <ref loc="MAT 25:30">25:30</ref>; <ref loc="LUK 13:28">Luk 13:28</ref>.</char></note>naho abaari baragenewe kuba abazunguura b'ubwo Bwami bakajugunywa hanze mu mwijima, aho bazaaririra bagahekenya ameenyo.” <verse eid="MAT 8:12" /><verse number="13" style="v" sid="MAT 8:13" />Nuuko Yesu abwira uwo mutware w'abasirikare ijana ati, “Genda, bikubeere nk'uko ubyizeeye.” Muri ako kaanya, umugaragu we arakira.<verse eid="MAT 8:13" /></para>
  <para style="s1">Yesu Akiza Abarwayi Benshi</para>
  <para style="r">(<ref loc="MRK 1:29-34">Mar 1:29-34</ref>; <ref loc="LUK 4:38-41">Luk 4:38-41</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 8:14" />Yesu ageze kwa Peetero abona nyirabukwe wa Peetero aryamye afite umuriro mwinshi. <verse eid="MAT 8:14" /><verse number="15" style="v" sid="MAT 8:15" />Yesu amufata ukuboko, umuriro umuvamo, nuuko arahaguruka atangira kumuzimaanira.<verse eid="MAT 8:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 8:16" />Bugoroobye, baazana abantu benshi bateewe n'abadayimooni, nuuko yiirukana abadayimooni abakabukira, kandi abaari barwaye boose arabakiza. <verse eid="MAT 8:16" /><verse number="17" style="v" sid="MAT 8:17" />Ibi byabaaye kugira ngo ibyavuzwe n'umuhanuuzi Yesaaya bisohore ngo, “Ubwe, yiishizeho ubumuga bwacu, yiikorera indwara zaacu.”<verse eid="MAT 8:17" /></para>
  <para style="s1">Gukurikira Yesu</para>
  <para style="r">(<ref loc="LUK 9:57-62">Luk 9:57-62</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 8:18" />Yesu aboonye ko akiikijwe n'abantu benshi, ategeka ko bambuka bakaja haakurya y'inyanja. <verse eid="MAT 8:18" /><verse number="19" style="v" sid="MAT 8:19" />Umwe mu biigiishamategeko aramwegeera aravuga ati, “Mwigiisha, nzaagukurikira aho uzaaja hoose.”<verse eid="MAT 8:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 8:20" />Yesu aramubwira ati, “Ibisamagwe bifite imyobo, kandi n'inyoni zo mu kireere zifite ibyari, ariko Umwana w'Umuntu ntaabwo afite aho arambika umusaya.”<verse eid="MAT 8:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 8:21" />Undi mu biigiishwa be aramubwira ati, “Nyagasani, reka mbanze nje guhamba daata.”<verse eid="MAT 8:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 8:22" />Ariko Yesu aramubwira ati, “Nkurikira, ureke abapfu bahambe abapfu baabo.”<verse eid="MAT 8:22" /></para>
  <para style="s1">Yesu Ahoosha Umuyaga Mwinshi</para>
  <para style="r">(<ref loc="MRK 4:35-41">Mar 4:35-41</ref>; <ref loc="LUK 8:22-25">Luk 8:22-25</ref>)</para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 8:23" />Nuuko Yesu agiiye mu bwato, abiigiishwa be baramukurikira. <verse eid="MAT 8:23" /><verse number="24" style="v" sid="MAT 8:24" />Habyuka umuyaga mwinshi mu nyanja kugeza ubwo ubwato bwari bugiiye kurengerwa n'imivumba. Ariko Yesu we yari asinziiriye. <verse eid="MAT 8:24" /><verse number="25" style="v" sid="MAT 8:25" />Nuuko baja aho ari maze baramukangura, baramubwira bati, “Nyagasani, dutabaare turarimbutse!”<verse eid="MAT 8:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 8:26" />Yesu arabasubiza ati, “Ni iki kibateeye ubwoba, mwa banyakwizeeraguke mwe?” Nuuko arahaguruka acaaha umuyaga n'inyanja, maze haratuuza caane.<verse eid="MAT 8:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 8:27" />Abantu boose baratangaara baravuga bati, “Uyu ni muntu ki utegeka imiyaga n'inyanja bikamwumvira?”<verse eid="MAT 8:27" /></para>
  <para style="s1">Yesu Akiza Abagabo Babiri Bateewe na Dayimooni</para>
  <para style="r">(<ref loc="MRK 5:1-20">Mar 5:1-20</ref>; <ref loc="LUK 8:26-39">Luk 8:26-39</ref>)</para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 8:28" />Yesu ageze haakurya mu gihugu c'Abagadareeni<note caller="+" style="f"><char style="fr" closed="false">8:28 </char><char style="ft" closed="false">Ibindi byanditswe byera bivuga </char><char style="fqa">igihugu c'Abagadareeni</char> cangwa <char style="fqa">Gerasa</char> cangwa <char style="fqa" closed="false">Gadarenoni </char></note>, abagabo babiri baari bateewe n'abadayimooni baaza bamusanga baturutse mu bituuro. Baari bateeye ubwoba, ku buryo ari nta muntu wari ukinyura muri iyo nzira. <verse eid="MAT 8:28" /><verse number="29" style="v" sid="MAT 8:29" />Ako kaanya bateera heejuru bati, “Udushaakaho iki Mwana w'Imaana? Mbese uzanywe hano no kutwiciisha agashinyaguro igihe kitaraagera?”<verse eid="MAT 8:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="MAT 8:30" />Haafi aho haari umugana w'ingurube ziriisha. <verse eid="MAT 8:30" /><verse number="31" style="v" sid="MAT 8:31" />Nuuko abo badayimooni binginga Yesu bati, “Nuutwirukana, utwohereze muri uriiya mugana w'ingurube.”<verse eid="MAT 8:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 8:32" />Yesu arabasubiza ati, “Nimugende.” Nuuko bava muri abo bagabo baja mu ngurube, maze umugana woose umanuka ku gacuri ugwa mu nyanja urarohama.<verse eid="MAT 8:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 8:33" />Abashumba baari baragiye izo ngurube barahunga. Bageze mu tawuni, bateekerereza abantu ibyabaye byose n'ibyerekeye ba bagabo baari bateewe n'abadayimooni. <verse eid="MAT 8:33" /><verse number="34" style="v" sid="MAT 8:34" />Bityo abantu boose bo muri iyo tawuni baja gusanganira Yesu. Bamuboonye, baramwinginga ngo abaviire mu gihugu.<verse eid="MAT 8:34" /></para>
  <chapter eid="MAT 8" />
  <chapter number="9" style="c" sid="MAT 9" />
  <para style="m">
    <verse number="1" style="v" sid="MAT 9:1" />Nuuko Yesu amaze kuja mu bwato, arambuka aja mu tawuni y'iwaabo<note caller="+" style="f"><char style="fr" closed="false">9:1 </char><char style="fqa" closed="false">i Kaperenawumu </char></note>.<verse eid="MAT 9:1" /></para>
  <para style="s1">Yesu Akiza Umugabo Umugaye</para>
  <para style="r">(<ref loc="MRK 2:1-12">Mar 2:1-12</ref>; <ref loc="LUK 5:17-26">Luk 5:17-26</ref>)</para>
  <para style="p">
    <verse number="2" style="v" sid="MAT 9:2" />Bamuuzanira umugabo umugaye bamuheetse mu ngobyi, aboonye ko bafite kwizeera, abwira uwo mugabo ati, “Huumura mwana wanje, ibyaha byawe urabibabariwe.”<verse eid="MAT 9:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 9:3" />Bamwe mu biigiishamategeko babyumviise batangira kwitootomba mu mutima bati, “Uyu mugabo ariigereranya n'Imaana.”<verse eid="MAT 9:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 9:4" />Ariko Yesu amenya ibyo biibwira, arababaza ati, “Mbese ni kuki mugira ibiteekerezo bidatunganye mu mitima yaanyu? <verse eid="MAT 9:4" /><verse number="5" style="v" sid="MAT 9:5" />Icooroshe ni ikihe? Ni ukuvuga ngo ‘Ibyaha byawe urabibabariwe,’ cangwa ngo, ‘Haguruka ugende’? <verse eid="MAT 9:5" /><verse number="6" style="v" sid="MAT 9:6" />Nyamara ibi ni ukugira ngo mumenye ko Umwana w'Umuntu afite ububaasha hano ku isi bwo kubabarira ibyaha.” Nuuko abwira uwo mugabo umugaye ati, “Haguruka, wikorere ingobyi yaawe, utaahe.”<verse eid="MAT 9:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 9:7" />Uwo mugabo arahaguruka, arataaha. <verse eid="MAT 9:7" /><verse number="8" style="v" sid="MAT 9:8" />Abantu babiboonye, bateerwa n'ubwoba, basingiza Imaana yahaaye abantu ububaasha nk'ubwo.<verse eid="MAT 9:8" /></para>
  <para style="s1">Yesu Ahamagara Matayo</para>
  <para style="r">(<ref loc="MRK 2:13-17">Mar 2:13-17</ref>; <ref loc="LUK 5:27-32">Luk 5:27-32</ref>)</para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 9:9" />Yesu ava muri uwo mwanya, akigenda abona umugabo witwaga Matayo yiicaye ahantu basorooreza imisoro, maze aramubwira ati, “Nkurikira.” Matayo aheerako aramukurikira.<verse eid="MAT 9:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 9:10" />
    <note caller="-" style="x">
      <char style="xo" closed="false">9:10 </char>
      <char style="xt" closed="false">
        <ref loc="LUK 15:1">Luk 15:1</ref>,<ref loc="LUK 15:2">2</ref>.</char>
    </note>Ubwo Yesu yari yiicaye n'abiigiishwa be bari kurya ifunguro rya nimugoroba<note caller="+" style="f"><char style="fr" closed="false">9:10 </char><char style="ft" closed="false">Ibindi byanditswee byogeeraho </char><char style="fqa">Mu nzu ya Matayo</char> cangwa <char style="fqa" closed="false">Kwa Matayo.</char></note>, abasoreesha benshi n'abanyabyaha baraaza basangira na bo. <verse eid="MAT 9:10" /><verse number="11" style="v" sid="MAT 9:11" />Bamwe mu Bafarisaayo babiboonye babaza abiigiishwa be bati, “Ni kuki umwigiisha waanyu asangira n'abasoreesha n'abanyabyaha?”<verse eid="MAT 9:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 9:12" />Yesu abumviise arababwira ati, “Abazima si bo bakeneye umuvuuzi, ahuubwo ni abarwayi bamukeneye. <verse eid="MAT 9:12" /><verse number="13" style="v" sid="MAT 9:13" /><note caller="-" style="x"><char style="xo" closed="false">9:13 </char><char style="xt" closed="false"><ref loc="MAT 12:7">Mat 12:7</ref>.</char></note>Nimugende mwige ico ibi byanditswe bisobaanura, ‘Ico mbashaakaho si ibitambo, ahuubwo ni uko mwagira impuhwe.’ Sinazanywe no guhamagara intungaane, ahuubwo naaje guhamagara abanyabyaha.”<verse eid="MAT 9:13" /></para>
  <para style="s1">Impaka Zeerekeye ku byo Gusiiba</para>
  <para style="r">(<ref loc="MRK 2:18-22">Mar 2:18-22</ref>; <ref loc="LUK 5:33-39">Luk 5:33-39</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 9:14" />Nuuko abiigiishwa ba Yohaana beegeera Yesu baramubaza bati, “Ni kuki twebwe n'Abafarisaayo dusiiba, naho abiigiishwa baawe bo ntibasiibe?”<verse eid="MAT 9:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 9:15" />Yesu arabasubiza ati, “Abatumirwa ntibaashobora gushavura bakiri n'umukwe. Ahuubwo igihe kizaagera ubwo umukwe azaabavanwamo, baheereko basiibe.<verse eid="MAT 9:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 9:16" />Ntaamuntu uteera ikiremu gisha ku mwenda ushaaje, uwaabikora atyo, yatuma ikiremu gisha kiwukurura, ugashishimuka, umwenge ukarushaho kuba munini. <verse eid="MAT 9:16" /><verse number="17" style="v" sid="MAT 9:17" />Kandi ntawaasuka divaayi nsha mu mifuka y'impu ishaaje kuko uwaabikora atyo, iyo divaayi yaaturitsa imifuka y'impu ndetse na yo ikameneka maze byombi akabipfiirwa. Ahuubwo, divaayi nsha bayisuka mu mifuka y'impu ikiri misha ntihagire icangirika muri byombi.”<note caller="+" style="f"><char style="fr" closed="false">9:17 </char><char style="ft" closed="false">Imifuka ikozwe mu mpu ni yo Abayuuda baabikagamo divaayi</char></note><verse eid="MAT 9:17" /></para>
  <para style="s1">Umukoobwa wa Yayiro n'Umugore wafashe ku Mwenda wa Yesu</para>
  <para style="r">(<ref loc="MRK 5:21-43">Mar 5:21-43</ref>; <ref loc="LUK 8:40-56">Luk 8:40-56</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 9:18" />Akivuga ibyo, haaza umutware w'isinagoogi aramupfukamira aramubwira ati, “Umukoobwa wanje amaze gupfa, ariko ngwino umurambikeho ibiganza yongere abeho.”<verse eid="MAT 9:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 9:19" />Nuuko Yesu arahaguruka, ajaana n'abiigiishwa be, bakurikira uwo mutware.<verse eid="MAT 9:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 9:20" />Ako kaanya haaza umugore wari urwaye indwara yo kuva, ayimaranye imyaka cumi n'ebyiri. Amuturuka inyuma afata ku mukugiro w'umwenda we, <verse eid="MAT 9:20" /><verse number="21" style="v" sid="MAT 9:21" />kuko yibwiraga ati, “Ninkora ku mwenda we gusa, ndakira.”<verse eid="MAT 9:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 9:22" />Yesu arahinduka, amuboonye, aramubwira ati, “Huumura mwana wanje, kwizeera kwawe kuragukijije.” Ako kaanya, uwo mugore arakira.<verse eid="MAT 9:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 9:23" />Yesu ageze mu rugo rwa wa mutware, abona abavuza imyironge baririra uwapfuuye hamwe n'abandi benshi bacura umuboroogo, <verse eid="MAT 9:23" /><verse number="24" style="v" sid="MAT 9:24" />arababwira ati, “Nimusohoke, umukoobwa ntiyapfuuye ahuubwo arasinziiriye.” Nuuko baramuseka. <verse eid="MAT 9:24" /><verse number="25" style="v" sid="MAT 9:25" />Boose bamaze kugera hanze, Yesu arinjira amufata ukuboko, umukoobwa arahaguruka. <verse eid="MAT 9:25" /><verse number="26" style="v" sid="MAT 9:26" />Iyo nkuru ikwira hoose.<verse eid="MAT 9:26" /></para>
  <para style="s1">Yesu Ahumuura Impumyi Ebyiri</para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 9:27" />Yesu akiva aho hantu, abagabo babiri b'impumyi bamukurikira bamutakambira bati, “Mwana wa Dawudi, tugirire impuhwe!”<verse eid="MAT 9:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 9:28" />Yinjiye mu nzu, abo bantu bahumye bakomeza kumukurikira, Yesu arababaza ati, “Mbese mwizeera ko nshobora kubakiza?”</para>
  <para style="p" vid="MAT 9:28">Baramusubiza bati, “Yeego, Nyagasani.”<verse eid="MAT 9:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 9:29" />Nuuko afata ku maaso yaabo arababwira ati, “Bibabeere nk'uko mwizeera.”<verse eid="MAT 9:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="MAT 9:30" />Amaaso yaabo aheerako arahumuuka. Nuuko Yesu arabiihanangiriza ati, “Muramenye ntihagire ubimenya.”<verse eid="MAT 9:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 9:31" />Ariko bakiva aho, baheerako batangira kubyamamaza babikwiza mu gihugu coose.<verse eid="MAT 9:31" /></para>
  <para style="s1">Yesu Akiza Umuragi</para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 9:32" />Bamaze kuva aho, bamuuzanira umuntu wari uteewe na dayimooni y'uburagi. <verse eid="MAT 9:32" /><verse number="33" style="v" sid="MAT 9:33" />Yesu amaze kwirukana dayimooni, uwo muragi aravuga. Rubanda baratangaara caane baravuga bati, “Ntihigeze kuboneka ibintu nk'ibi muri Isirayeli.”<verse eid="MAT 9:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 9:34" />
    <note caller="-" style="x">
      <char style="xo" closed="false">9:34 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 10:25">Mat 10:25</ref>; <ref loc="MAT 12:24">12:24</ref>; <ref loc="MRK 3:22">Mar 3:22</ref>; <ref loc="LUK 11:15">Luk 11:15</ref>.</char>
    </note>Ariko Abafarisaayo bo baravuga bati, “Umutware w'abadayimooni ni we umuha ububaasha bwo kwirukana abadayimooni.”<note caller="+" style="f"><char style="fr" closed="false">9:34 </char><char style="ft" closed="false">Hari ibindi byanditswe byera bitongeraho uyu murongo. </char></note><verse eid="MAT 9:34" /></para>
  <para style="s1">Abasaaruuzi ni Bake</para>
  <para style="p">
    <verse number="35" style="v" sid="MAT 9:35" />
    <note caller="-" style="x">
      <char style="xo" closed="false">9:35 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 4:23">Mat 4:23</ref>; <ref loc="MRK 1:39">Mar 1:39</ref>; <ref loc="LUK 4:44">Luk 4:44</ref>.</char>
    </note>Yesu aja mu matawuni yoose no mu byaro yiigiishiriza mu masinagoogi kandi yaamamaza Inkuru Nziiza y'Ubwami, akiza buri ndwara n'abarwayi b'uburyo bwose. <verse eid="MAT 9:35" /><verse number="36" style="v" sid="MAT 9:36" /><note caller="-" style="x"><char style="xo" closed="false">9:36 </char><char style="xt" closed="false"><ref loc="MRK 6:34">Mar 6:34</ref>.</char></note>Aboonye abo bantu benshi caane, abagirira impuhwe kuko baari bashobewe kandi bafite intege nke nk'intaama zitagira umushumba. <verse eid="MAT 9:36" /><verse number="37" style="v" sid="MAT 9:37" /><note caller="-" style="x"><char style="xo" closed="false">9:37 </char><char style="xt" closed="false"><ref loc="LUK 10:2">Luk 10:2</ref>.</char></note>Nuuko abwira abiigiishwa be ati, “Dore imyaka yeze ni myinshi, ariko abasaaruuzi ni bake, <verse eid="MAT 9:37" /><verse number="38" style="v" sid="MAT 9:38" />noone reero ni musabe Nyagasani yohereze abasaaruuzi mu myaka ye.”<verse eid="MAT 9:38" /></para>
  <chapter eid="MAT 9" />
  <chapter number="10" style="c" sid="MAT 10" />
  <para style="s1">Intumwa Cumi n'Ebyiri</para>
  <para style="r">(<ref loc="MRK 3:13-19">Mar 3:13-19</ref>; <ref loc="LUK 6:12-16">Luk 6:12-16</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 10:1" />Nuuko Yesu ahamagara abiigiishwa be cumi na babiri abaha ububaasha bwo gutegeka imyuka mibi no kuyiirukana, n'ubwo gukiza indwara z'uburyo bwose. <verse eid="MAT 10:1" /><verse number="2" style="v" sid="MAT 10:2" />Aya ni yo mazina y'abo cumi na babiri: Uwa mbere ni Simooni witwaga Peetero na mwene nyina Andereya, Yaakobo na Yohaana beene Zebedaayo, <verse eid="MAT 10:2" /><verse number="3" style="v" sid="MAT 10:3" />Filipo na Barutolomayo, Tomasi na Matayo umusoreesha, Yaakobo mwene Alufaayo na Tadeeyo, <verse eid="MAT 10:3" /><verse number="4" style="v" sid="MAT 10:4" />Simooni w'umurwanashaka w'igihugu<note caller="+" style="f"><char style="fr" closed="false">10:4 </char><char style="ft" closed="false">Mu bindi byanditswe byera bamwita </char><char style="fqa">Zelote, </char> kimenyeesha umurwanashaka cangwa umunyakanaani</note>, na Yuda Isikariyoti, wa wundi wagambaaniye Yesu.<verse eid="MAT 10:4" /></para>
  <para style="s1">Yesu Atuma Intumwa Cumi n'Ebyiri</para>
  <para style="r">(<ref loc="MRK 6:7-13">Mar 6:7-13</ref>; <ref loc="LUK 9:1-6">Luk 9:1-6</ref>)</para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 10:5" />Yesu atuma abo cumi na babiri abaha izi ngenderwaho ati, “Ntihagire abanyamahanga mujamo cangwa ngo muje mu ma tawuni y'Abanyasamariya, <verse eid="MAT 10:5" /><verse number="6" style="v" sid="MAT 10:6" />ahuubwo muje mu ntaama zaazimiye z'umuryango wa Isirayeli. <verse eid="MAT 10:6" /><verse number="7" style="v" sid="MAT 10:7" />Mugenda, mwamamaze ubutumwa muti, ‘Ubwami bwo mu ijuru bureegeereje.’ <verse eid="MAT 10:7" /><verse number="8" style="v" sid="MAT 10:8" />Mukize abarwayi, muzuure abaapfuuye, mukize ababembe,<note caller="+" style="f"><char style="fr" closed="false">10:8 </char><char style="ft" closed="false">Ibibembe byahagarariraga indwara nyinshi zitandukanye </char></note> mwirukane abadayimooni. Mwaheerewe ubuntu, mutangire ubuntu. <verse eid="MAT 10:8" /><verse number="9" style="v" sid="MAT 10:9" />Ntihagire izaahabu, ifeeza cangwa umuringa mwitwaza. <verse eid="MAT 10:9" /><verse number="10" style="v" sid="MAT 10:10" /><note caller="-" style="x"><char style="xo" closed="false">10:10 </char><char style="xt" closed="false"><ref loc="1CO 9:14">1 Kor 9:14</ref>; <ref loc="1TI 5:18">1 Tim 5:18</ref>.</char></note>Ntimujaane igikapu c'urugendo, cangwa ngo mujaane isaati ebyiri, cangwa inkweto, cangwa inkoni kuko umukozi akwiriye guhaabwa ibyo yiifuuza.<verse eid="MAT 10:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 10:11" />I tawuni cangwa icaaro muzinjiramo, mushaakiishemo umuntu wishiimira kubacumbikira, maze mubaane na we, kugeza igihe muzaahaviira. <verse eid="MAT 10:11" /><verse number="12" style="v" sid="MAT 10:12" />Nimugera mu rugo rwe, mubaramutse. <verse eid="MAT 10:12" /><verse number="13" style="v" sid="MAT 10:13" />Niiba ab'urwo rugo bakwiriye amahoro yaanyu, agumane na bo, ariko niiba batabikwiriye, amahoro yaanyu abagarukire. <verse eid="MAT 10:13" /><verse number="14" style="v" sid="MAT 10:14" /><note caller="-" style="x"><char style="xo" closed="false">10:14 </char><char style="xt" closed="false"><ref loc="ACT 13:51">Iby 13:51</ref>.</char></note>Nihagira uwanga kubacumbikira, cangwa kubatega amatwi, mukunkumure umucuucu wo mu birenge byanyu mukiva muri urwo rugo cangwa iyo tawuni ngo bibabeere ikimenyeetso co kubashinja. <verse eid="MAT 10:14" /><verse number="15" style="v" sid="MAT 10:15" /><note caller="-" style="x"><char style="xo" closed="false">10:15 </char><char style="xt" closed="false"><ref loc="MAT 11:24">Mat 11:24</ref>.</char></note><note caller="-" style="x"><char style="xo" closed="false">10:15 </char><char style="xt" closed="false"><ref loc="LUK 10:4-12">Luk 10:4-12</ref>.</char></note>Ndababwira ukuri yuuko ab'i Sodomu n'i Gomora bazaahaabwa igihano gito ku munsi wo guca urubanza ugereranyije nab'iyo tawuni.”<verse eid="MAT 10:15" /></para>
  <para style="s1">Igihe co Gutootezwa</para>
  <para style="r">(<ref loc="MRK 13:9-13">Mar 13:9-13</ref>; <ref loc="LUK 21:12-17">Luk 21:12-17</ref>)</para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 10:16" />
    <note caller="-" style="x">
      <char style="xo" closed="false">10:16 </char>
      <char style="xt" closed="false">
        <ref loc="LUK 10:3">Luk 10:3</ref>.</char>
    </note>“Dore mboohereje nk'intaama hagati y'amasega aryana, nuuko reero mugire ubwenge nk'ubw'inzoka kandi mugire ubucureezi nk'ubw'inuma. <verse eid="MAT 10:16" /><verse number="17" style="v" sid="MAT 10:17" /><note caller="-" style="x"><char style="xo" closed="false">10:17 </char><char style="xt" closed="false"><ref loc="MRK 13:9-11">Mar 13:9-11</ref>; <ref loc="LUK 12:11">Luk 12:11</ref>,<ref loc="LUK 12:12">12</ref>; <ref loc="LUK 21:12-15">21:12-15</ref>.</char></note>Mwirinde abo bantu, kuko bazaabajaana mu nkiiko bakabakubitira no mu masinagoogi, <verse eid="MAT 10:17" /><verse number="18" style="v" sid="MAT 10:18" />kandi muzaagabizwa abategetsi n'abaami babampoora, ubwo muzambeera abahamya imbere yaabo n'abanyamahanga. <verse eid="MAT 10:18" /><verse number="19" style="v" sid="MAT 10:19" />Igihe bazaabagabiza mu nkiiko, ntimuzaahagarike imitima mwibaza uko muzaavuga n'ibyo muzaavuga, kuko ibyo kuvuga muzaabihaabwa ico gihe. <verse eid="MAT 10:19" /><verse number="20" style="v" sid="MAT 10:20" />Kuko si mwe muzaaba muvuga, ahuubwo Umwuka wa So ni we uzaabavugiramo.<verse eid="MAT 10:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 10:21" />
    <note caller="-" style="x">
      <char style="xo" closed="false">10:21 </char>
      <char style="xt" closed="false">
        <ref loc="MRK 13:12">Mar 13:12</ref>; <ref loc="LUK 21:16">Luk 21:16</ref>.</char>
    </note>Umuntu azaagambaanira uwo bava inda imwe ngo yicwe, se w'umwana azaamugambaanira, n'abaana bazaagomera ababyeyi baabo babiiciishe. <verse eid="MAT 10:21" /><verse number="22" style="v" sid="MAT 10:22" /><note caller="-" style="x"><char style="xo" closed="false">10:22 a </char><char style="xt" closed="false"><ref loc="MAT 24:9">Mat 24:9</ref>; <ref loc="MRK 13:13">Mar 13:13</ref>; <ref loc="LUK 21:17">Luk 21:17</ref>; </char><char style="xo" closed="false">b </char><char style="xt" closed="false"><ref loc="MAT 24:13">Mat 24:13</ref>; <ref loc="MRK 13:13">Mar 13:13</ref>.</char></note>Muzangwa na boose ku bw'izina ryanje. Ariko uziihangaana kugeza ku iherezo azaakizwa. <verse eid="MAT 10:22" /><verse number="23" style="v" sid="MAT 10:23" />Ni babatootereza mu tawuni imwe, muzaahungire mu yindi. Ndabahamiriza yuuko mutazaazenguruka amatawuni yoose yo muri Isirayeli Umwana w'Umuntu ataraaza.<verse eid="MAT 10:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 10:24" />
    <note caller="-" style="x">
      <char style="xo" closed="false">10:24 a </char>
      <char style="xt" closed="false">
        <ref loc="LUK 6:40">Luk 6:40</ref>; </char>
      <char style="xo" closed="false">b </char>
      <char style="xt" closed="false">
        <ref loc="JHN 13:16">Yoh 13:16</ref>; <ref loc="JHN 15:20">15:20</ref>.</char>
    </note>Ntamwigiishwa uruta umwigiisha we, ntaan'umugaragu uruta sheebuja. <verse eid="MAT 10:24" /><verse number="25" style="v" sid="MAT 10:25" /><note caller="-" style="x"><char style="xo" closed="false">10:25 </char><char style="xt" closed="false"><ref loc="MAT 9:34">Mat 9:34</ref>; <ref loc="MAT 12:24">12:24</ref>; <ref loc="MRK 3:22">Mar 3:22</ref>; <ref loc="LUK 11:15">Luk 11:15</ref>.</char></note>Birahagije ko umwigiishwa amera nk'umwigiisha, ndetse n'umugaragu akamera nka sheebuja. Nuuko reero niiba nyir'urugo yiswe Bbelizebuulu, abo muri urwo rugo baziitwa amazina mabi kurutaho.<verse eid="MAT 10:25" /></para>
  <para style="s1">Kudatiinya Abantu</para>
  <para style="r">(<ref loc="LUK 12:2-7">Luk 12:2-7</ref>)</para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 10:26" />
    <note caller="-" style="x">
      <char style="xo" closed="false">10:26 </char>
      <char style="xt" closed="false">
        <ref loc="MRK 4:22">Mar 4:22</ref>; <ref loc="LUK 8:17">Luk 8:17</ref>.</char>
    </note>Nuuko reero ntimukabatinye, kuko ntaagihishwe kitazaahishuurwa, kandi ntaagikorerwa mu ibanga kitazaamenyekana. <verse eid="MAT 10:26" /><verse number="27" style="v" sid="MAT 10:27" />Ibyo mbabwirira mu mwijima, muzaabivugire mu muco, kandi ibyo mwongorerwa, muzaabyamamarize ku gasozi. <verse eid="MAT 10:27" /><verse number="28" style="v" sid="MAT 10:28" />Ntimugatinye abiica umubiri ariko badashobora kwica ubugingo, ahuubwo mutinye uwo ufite ububaasha bwo kurimburira umubiri n'ubugingo muri gehenoomu. <verse eid="MAT 10:28" /><verse number="29" style="v" sid="MAT 10:29" />Mbese ibishwi<note caller="+" style="f"><char style="fr" closed="false">10:29 </char><char style="fq">Ibishwi</char> birororwa mu Bayuuda kandi bikaguriishwa. Ni ibyokurya by'abakene</note> bibiri ntibigurwa igiceri<note caller="+" style="f"><char style="fr" closed="false">10:29 </char><char style="fq">Igiceri </char> n'ishilingi nke caane zisuzuguritse. Nizo zisembayo ubuke </note>? Ariko nta na kimwe gishobora kwikubita haasi, So wo mu ijuru atabyemeye. <verse eid="MAT 10:29" /><verse number="30" style="v" sid="MAT 10:30" />Kandi n'imisatsi yo ku mitwe yaanyu irabazwe. <verse eid="MAT 10:30" /><verse number="31" style="v" sid="MAT 10:31" />Noone reero, ntimugire ubwoba, kuko mufite agaciiro kuruta ibishwi byinshi.<verse eid="MAT 10:31" /></para>
  <para style="s1">Guhamya no Kwihakana Kristo</para>
  <para style="r">(<ref loc="LUK 12:8-9">Luk 12:8-9</ref>)</para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 10:32" />Nuuko reero umuntu weese uzanyemera mu ruhame rw'abantu, nanje nzamwemera imbere ya Daata wo mu ijuru. <verse eid="MAT 10:32" /><verse number="33" style="v" sid="MAT 10:33" /><note caller="-" style="x"><char style="xo" closed="false">10:33 </char><char style="xt" closed="false"><ref loc="2TI 2:12">2 Tim 2:12</ref>.</char></note>Ariko uzanyihakanira mu ruhame rw'abantu, nanje nzamwihakanira imbere ya Daata wo mu ijuru.<verse eid="MAT 10:33" /></para>
  <para style="s1">Yesu Ntiyazanye Amahoro, Ahuubwo Yazanye Inkoota</para>
  <para style="r">(<ref loc="LUK 12:51-53">Luk 12:51-53</ref>; <ref loc="LUK 14:26-27">14:26-27</ref>)</para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 10:34" />Ntimugateekereze ko nazanywe no kuuzana amahoro ku isi, oya, si nazanywe no kuuzana amahoro ku isi, ahuubwo nazanye inkoota. <verse eid="MAT 10:34" /><verse number="35" style="v" sid="MAT 10:35" />Kuko naaje gutandukanya umuhungu na se, umukoobwa na nyina, n'umukazaana na nyirabukwe.<verse eid="MAT 10:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="MAT 10:36" />Kandi, abanzi b'umuntu bazaaturuka mu nzu ye.<verse eid="MAT 10:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="MAT 10:37" />Umuntu weese ukunda se cangwa nyina kuruta uko ankunda, ntakwiriye kuba uwanje. Kandi ukunda umuhungu we cangwa umukoobwa we kuruta uko ankunda, ntaakwiriye kuba uwanje. <verse eid="MAT 10:37" /><verse number="38" style="v" sid="MAT 10:38" /><note caller="-" style="x"><char style="xo" closed="false">10:38 </char><char style="xt" closed="false"><ref loc="MAT 16:24">Mat 16:24</ref>; <ref loc="MRK 8:34">Mar 8:34</ref>; <ref loc="LUK 9:23">Luk 9:23</ref>.</char></note>Utiikorera umusaraba we ngo ankurikire, ntaabwo akwiriye kuba uwanje. <verse eid="MAT 10:38" /><verse number="39" style="v" sid="MAT 10:39" /><note caller="-" style="x"><char style="xo" closed="false">10:39 </char><char style="xt" closed="false"><ref loc="MAT 16:25">Mat 16:25</ref>; <ref loc="MRK 8:35">Mar 8:35</ref>; <ref loc="LUK 9:24">Luk 9:24</ref>; <ref loc="LUK 17:33">17:33</ref>; <ref loc="JHN 12:25">Yoh 12:25</ref>.</char></note>Urengera ubuzima bwe azaabubura, ariko uzaahara ubuzima bwe ku bwanje, azaabubona.<verse eid="MAT 10:39" /></para>
  <para style="s1">Ibihembo</para>
  <para style="r">(<ref loc="MRK 9:41">Mar 9:41</ref>)</para>
  <para style="p">
    <verse number="40" style="v" sid="MAT 10:40" />
    <note caller="-" style="x">
      <char style="xo" closed="false">10:40 a </char>
      <char style="xt" closed="false">
        <ref loc="LUK 10:16">Luk 10:16</ref>; <ref loc="JHN 13:20">Yoh 13:20</ref>; </char>
      <char style="xo" closed="false">b </char>
      <char style="xt" closed="false">
        <ref loc="MRK 9:37">Mar 9:37</ref>; <ref loc="LUK 9:48">Luk 9:48</ref>.</char>
    </note>Ubaakiiriye neeza weese ninje aba yaakiiriye, kandi unyakiiriye aba yaakiiriye uwantumye. <verse eid="MAT 10:40" /><verse number="41" style="v" sid="MAT 10:41" />Uwakiira umuhanuuzi mu izina ry'umuhanuuzi azaahaabwa ingororano y'abahanuuzi, kandi uwaakiira umukiraanutsi mu izina ry'abakiraanutsi azaahaabwa ingororano y'abakiraanutsi. <verse eid="MAT 10:41" /><verse number="42" style="v" sid="MAT 10:42" />Kandi uzaaha umwe muri aba baana bato niibura igikopu c'amaazi akonje yo kunywa mu izina ry'abiigiishwa, ndababwira ukuri yuuko atazaabura guhembwa.”<verse eid="MAT 10:42" /></para>
  <chapter eid="MAT 10" />
  <chapter number="11" style="c" sid="MAT 11" />
  <para style="p">
    <verse number="1" style="v" sid="MAT 11:1" />Yesu arangije guha abiigiishwa be cumi na babiri ingenderwaho, avayo aja kwigiisha no kwamamaza Ubutumwa mu matawuni y'aho.<verse eid="MAT 11:1" /></para>
  <para style="s1">Yohaana Umubatiza Yoohereza Abantu kuri Yesu</para>
  <para style="r">(<ref loc="LUK 7:18-35">Luk 7:18-35</ref>)</para>
  <para style="p">
    <verse number="2" style="v" sid="MAT 11:2" />Igihe Yohaana yari mu gihome, yumviise ibyo Kristo akora, amutumaho abiigiishwa be<note caller="+" style="f"><char style="fr" closed="false">11:2 </char><char style="ft" closed="false">Ibindi byanditswe byera bivuga ngo, </char><char style="fqa" closed="false">amutumaho babiri mu biigiishwa be </char></note> <verse eid="MAT 11:2" /><verse number="3" style="v" sid="MAT 11:3" />baramubaza bati, “Mbese uri wa wundi ugomba kuzaaza, cangwa dutegereze undi?”<verse eid="MAT 11:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 11:4" />Yesu arabasubiza ati, “Nimugende mubwire Yohaana ibyo mwiyumviye n'ibyo mwiboneye, <verse eid="MAT 11:4" /><verse number="5" style="v" sid="MAT 11:5" />impumyi zirahumuuka, abarema baragenda, ababembe barakira, abapfaamatwi barumva, abaapfuuye barazuurwa, n'abakene bakagezwaho Ubutumwa Bwiza. <verse eid="MAT 11:5" /><verse number="6" style="v" sid="MAT 11:6" />Hahiirwa abo bizeera ibyanje badashidiikanya.”<verse eid="MAT 11:6" /></para>
  <para style="s1">Yesu Ashiimagiza Yohaana Umubatiza</para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 11:7" />Abiigiishwa ba Yohaana bakiva aho, Yesu atangira kubwira abantu ibya Yohaana ati, “Mwagiiye mu butaayu kureeba iki? Urubingo ruhungabanywa n'umuyaga? <verse eid="MAT 11:7" /><verse number="8" style="v" sid="MAT 11:8" />Noone se mwagiiye kureeba iki? Umuntu wambaye imyambaro y'agaciiro kenshi? Umva, abambara imyambaro ihenze baba ibwami. <verse eid="MAT 11:8" /><verse number="9" style="v" sid="MAT 11:9" />Noone se mwagiiye kureeba iki? Umuhanuuzi? Yeego, ni koko ndababwira ko, ndetse aruta umuhanuuzi. <verse eid="MAT 11:9" /><verse number="10" style="v" sid="MAT 11:10" />Uwo Yohaana Umubatiza ni we ibyanditswe bivuga, ngo,</para>
  <para style="q1" vid="MAT 11:10">‘Dore noohereje intumwa yanje mbere yaawe,</para>
  <para style="q2" vid="MAT 11:10">kugira ngo akubanzirize, maze agutungaanyirize inzira.’<verse eid="MAT 11:10" /></para>
  <para style="m">
    <verse number="11" style="v" sid="MAT 11:11" />Ndababwira ukuri yuuko, mu baabyawe n'umugore, hatiigeze kubaho umuntu ukomeye nka Yohaana Umubatiza, ariko nyamara, uworoheje mu bo mu Bwami bw'ijuru aramuruta. <verse eid="MAT 11:11" /><verse number="12" style="v" sid="MAT 11:12" /><note caller="-" style="x"><char style="xo" closed="false">11:12 </char><char style="xt" closed="false"><ref loc="LUK 16:16">Luk 16:16</ref>.</char></note>Uheereye mu minsi ya Yohaana Umubatiza ukageza n'ubu Ubwami bwo mu ijuru buraharanirwa, intwari zibweguukanisha imbaraga. <verse eid="MAT 11:12" /><verse number="13" style="v" sid="MAT 11:13" />Kuko abahanuuzi boose, n'amategeko byahanuuye kugeza igihe Yohaana yaziye. <verse eid="MAT 11:13" /><verse number="14" style="v" sid="MAT 11:14" /><note caller="-" style="x"><char style="xo" closed="false">11:14 </char><char style="xt" closed="false"><ref loc="MAT 17:10-13">Mat 17:10-13</ref>; <ref loc="MRK 9:11-13">Mar 9:11-13</ref>.</char></note>Kandi niiba mushaatse kubyemera, uwo Yohaana ni we umeze nka Eliya wahanuuwe ko azaaza. <verse eid="MAT 11:14" /><verse number="15" style="v" sid="MAT 11:15" />Ufite amatwi yumva, niyumve!<verse eid="MAT 11:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 11:16" />Ariko abantu b'iki gihe nabagereranya n'iki? Bameze nk'abaana biicaye mu maguriro bahamagarana bati,<verse eid="MAT 11:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="MAT 11:17" />‘Twabavugirije imyironge, ntimwabyina.</para>
  <para style="q2" vid="MAT 11:17">Twateye indirimbo z'amaganya, ariko ntimwarira.’<verse eid="MAT 11:17" /></para>
  <para style="m">
    <verse number="18" style="v" sid="MAT 11:18" />Nk'uko Yohaana yaje atarya kandi atanywa, baravuga bati, ‘Afite dayimooni.’ <verse eid="MAT 11:18" /><verse number="19" style="v" sid="MAT 11:19" />Umwana w'Umuntu aje arya kandi anywa, baravuga bati, ‘Dore, uriiya ni igisambo kandi ni umusinzi, n'inshuti y'abasoreesha n'abanyabyaha!’ Nyamara, ubwenge bugaragazwa n'imirimo yabwo.”<verse eid="MAT 11:19" /></para>
  <para style="s1">Amatawuni Yanze Kwihana</para>
  <para style="r">(<ref loc="LUK 10:13-15">Luk 10:13-15</ref>)</para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 11:20" />Nuuko atangira gucaaha abatuuye mu matawuni yo yakoreyemo ibitangaaza byinshi, ariko bakanga kwihana. <verse eid="MAT 11:20" /><verse number="21" style="v" sid="MAT 11:21" />Arababwira ati, “Muzaabona ishano mwa bantu b'i Koraziini mwe! Namwe ab'i Betsayida muzaabona ishano. Kuko ibitangaaza byakorewe muri mwe, iyo bikorerwa i Tiiro n'i Sidoni, abaaho baba barambaye ibiguniya baakisiiga itaazi nk'ikimenyeetso co kwihana. <verse eid="MAT 11:21" /><verse number="22" style="v" sid="MAT 11:22" />Ariko ndababwira yuuko, ku munsi wo guciirwaho urubanza, bizooroha kwihanganira ab'i Tiiro n'i Sidoni kuruta mwe. <verse eid="MAT 11:22" /><verse number="23" style="v" sid="MAT 11:23" />Kandi namwe ab'i Kaperenawumu,</para>
  <para style="q1" vid="MAT 11:23">mbese mushizwe heejuru ngo mugere ku ijuru?</para>
  <para style="q2" vid="MAT 11:23">Oya, muzaamanurwa mugezwe ikuzimu.</para>
  <para style="m" vid="MAT 11:23">Kuko iyo ibitangaaza byabakorewemo bikorerwa i Sodomu, iba igihagaze kugeza nan'ubu. <verse eid="MAT 11:23" /><verse number="24" style="v" sid="MAT 11:24" /><note caller="-" style="x"><char style="xo" closed="false">11:24 </char><char style="xt" closed="false"><ref loc="MAT 10:15">Mat 10:15</ref>; <ref loc="LUK 10:12">Luk 10:12</ref>.</char></note>Ariko ndababwira yuuko ku munsi wo guciirwa imanza, ab'i Sodomu baziihangaanirwa kurusha uko mwe muziihangaanirwa.”<verse eid="MAT 11:24" /></para>
  <para style="s1">Yesu ni we Buruhuukiro</para>
  <para style="r">(<ref loc="LUK 10:21-22">Luk 10:21-22</ref>)</para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 11:25" />Ico gihe Yesu aravuga ati, “Ndagushiima Daata, Nyir'ijuru n'isi, kuko ibyo wabihishe abanyabwenge n'abahanga ukabihishuurira abaciiye bugufi. <verse eid="MAT 11:25" /><verse number="26" style="v" sid="MAT 11:26" />Yeego, Daata, kuko ari ko wabishaatse.<verse eid="MAT 11:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 11:27" />
    <note caller="-" style="x">
      <char style="xo" closed="false">11:27 a </char>
      <char style="xt" closed="false">
        <ref loc="JHN 3:35">Yoh 3:35</ref>; </char>
      <char style="xo" closed="false">b </char>
      <char style="xt" closed="false">
        <ref loc="JHN 1:18">Yoh 1:18</ref>; <ref loc="JHN 10:15">10:15</ref>.</char>
    </note>Ibintu byose nabihaawe na Daata. Ntaawe uzi Umwana keretse Se, kandi ntaawe uzi Se keretse Umwana, n'uwo Umwana ashaatse guhishuurira se.<verse eid="MAT 11:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 11:28" />Nimuuze mwese abarushe n'abaremeererewe, ndabaruhuura. <verse eid="MAT 11:28" /><verse number="29" style="v" sid="MAT 11:29" />Nimunyumvire kandi mundeebereho, kuko norooheje kandi nkaba nshiye bugufi mu mutima, ni ho muzaabona uburuhukiro mu mitima yaanyu. <verse eid="MAT 11:29" /><verse number="30" style="v" sid="MAT 11:30" />Kuko kunkurikira bitaruhije, n'umutwaro wanje utaremeereye.”<verse eid="MAT 11:30" /></para>
  <chapter eid="MAT 11" />
  <chapter number="12" style="c" sid="MAT 12" />
  <para style="s1">Ikibazo Ceerekeye Umunsi w'Isaabato</para>
  <para style="r">(<ref loc="MRK 2:23-28">Mar 2:23-28</ref>; <ref loc="LUK 6:1-5">Luk 6:1-5</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 12:1" />Muri ico gihe, Yesu anyura mu mirima y'ingano ku Isaabato, abiigiishwa be baari bashonje, maze batangira guca amahundo bararya. <verse eid="MAT 12:1" /><verse number="2" style="v" sid="MAT 12:2" />Abafarisaayo babiboonye, baramubwira bati, “Dore, abiigiishwa baawe barakora ibidakwiriye gukorwa ku Isaabato.”<verse eid="MAT 12:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 12:3" />Na we arabasubiza ati, “Mbese ntaabwo mwasomye uko Dawudi n'abo baari kumwe baabigenjeje ubwo baari bashonje? <verse eid="MAT 12:3" /><verse number="4" style="v" sid="MAT 12:4" />Yinjiye mu Nzu y'Imaana arya imigaati yari igenewe ituuro ry'Imaana, kandi we n'abo baari kumwe ntaabwo bari beemerewe kuyirya, kuko yari igenewe abaheerezabitambo bonyine. <verse eid="MAT 12:4" /><verse number="5" style="v" sid="MAT 12:5" />Cangwa se ntimwasomye mu mategeko ko ku Isaabato abaheerezabitambo mu Nzu y'Imaana biica itegeko rigenga Isaabato kandi ntibibabeere icaaha? <verse eid="MAT 12:5" /><verse number="6" style="v" sid="MAT 12:6" />Ndababwira yuuko hano hari igisumba Inzu y'Imaana. <verse eid="MAT 12:6" /><verse number="7" style="v" sid="MAT 12:7" /><note caller="-" style="x"><char style="xo" closed="false">12:7 </char><char style="xt" closed="false"><ref loc="MAT 9:13">Mat 9:13</ref>.</char></note>Ariko iyo muba muuzi ico aya magambo amenyeesha, ‘Ico nshaaka ni imbabazi atari ibitambo,’ ntimuba mwaciiriye urubanza abatagira icaaha, <verse eid="MAT 12:7" /><verse number="8" style="v" sid="MAT 12:8" />kuko Umwana w'Umuntu ari we ufite ububaasha bugenga Isaabato.”<verse eid="MAT 12:8" /></para>
  <para style="s1">Yesu Akiza Umugabo Unyuunyuutse Ikiganza</para>
  <para style="r">(<ref loc="MRK 3:1-6">Mar 3:1-6</ref>; <ref loc="LUK 6:6-11">Luk 6:6-11</ref>)</para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 12:9" />Ava muri uwo mwanya aja mu isinagoogi yaabo, <verse eid="MAT 12:9" /><verse number="10" style="v" sid="MAT 12:10" />ahasanga umugabo ufite ikiganza kinyunyutse, maze baramubaza bati, “Mbese amategeko yeemera gukiza umuntu ku Isaabato?” Ibi baabimubajije kugira ngo babone uko bamurega.<verse eid="MAT 12:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 12:11" />
    <note caller="-" style="x">
      <char style="xo" closed="false">12:11 </char>
      <char style="xt" closed="false">
        <ref loc="LUK 14:5">Luk 14:5</ref>.</char>
    </note>Na we arabasubiza ati, “Mbese umwe muri mwe yaaba afite intaama imwe yoonyine, ikagwa mu coobo ku munsi w'Isaabato, ntaayikuuremo? <verse eid="MAT 12:11" /><verse number="12" style="v" sid="MAT 12:12" />Nyamara umuntu arusha intaama agaciiro! Nuuko reero, byemewe n'amategeko gukora neeza ku munsi w'Isaabato.” <verse eid="MAT 12:12" /><verse number="13" style="v" sid="MAT 12:13" />Haanyuma abwira wa mugabo ati, “Rambuura ikiganza caawe.” Arakirambuura, maze kirakira, kiba kizima nk'ikindi. <verse eid="MAT 12:13" /><verse number="14" style="v" sid="MAT 12:14" />Ariko Abafarisaayo barasohoka nuuko baja inaama yo kumwica.<verse eid="MAT 12:14" /></para>
  <para style="s1">Umugaragu Watooranyijwe n'Imaana</para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 12:15" />Yesu amenye imigambi y'Abafarisaayo, arahava. Abantu benshi baramukurikira, maze abaari barwaye boose arabakiza, <verse eid="MAT 12:15" /><verse number="16" style="v" sid="MAT 12:16" />kandi abategeka kutamwamamaza. <verse eid="MAT 12:16" /><verse number="17" style="v" sid="MAT 12:17" />Ibi yabikoze kugira ngo ibyavuzwe n'umuhanuuzi Yesaaya byuzuzwe ngo,<verse eid="MAT 12:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="MAT 12:18" />“Uyu ni umugaragu wanje, niitooranyirije,</para>
  <para style="q2" vid="MAT 12:18">nkunda caane, umutima wanje ukamwishiimira.</para>
  <para style="q1" vid="MAT 12:18">Nzaamushiraho Umwuka wanje,</para>
  <para style="q2" vid="MAT 12:18">maze na we azaamamaze ubutabeera ku banyamahanga.<verse eid="MAT 12:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="MAT 12:19" />Ntaazaatongana, kandi ntaazaasakuza,</para>
  <para style="q2" vid="MAT 12:19">cangwa ngo hagire uwumva ijwi rye mu mihanda.<verse eid="MAT 12:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="MAT 12:20" />Azaagirira impuhwe abafite intege nke,</para>
  <para style="q2" vid="MAT 12:20">kandi agirire imbabazi imburabure.</para>
  <para style="q1" vid="MAT 12:20">Azaakomeza kugeza igihe ubutabeera buzaatsinda.<note caller="+" style="f"><char style="fr" closed="false">12:20 </char><char style="ft" closed="false">Ibindi byanditswe byera bikoresha ururimi rw'amarenga n'ibishushaanyo muri uyu murongo. Bandika bati, </char><char style="fqa" closed="false">Urubingo rusadutse ntaazaaruvuna, kandi n'urumuri rucumba ntaazaaruzimya, kugeza ubwo ubutabeera buzaagaragara. </char></note><verse eid="MAT 12:20" /></para>
  <para style="q2">
    <verse number="21" style="v" sid="MAT 12:21" />Bityo reero abanyamahanga baziiringira izina rye.”<verse eid="MAT 12:21" /></para>
  <para style="s1">Yesu na Bbelizebuulu</para>
  <para style="r">(<ref loc="MRK 3:20-30">Mar 3:20-30</ref>; <ref loc="LUK 11:14-23">Luk 11:14-23</ref>)</para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 12:22" />Nuuko bamuuzanira umuntu uhumye kandi ari n'umuragi kuko yari ateewe na dayimooni, maze Yesu aramukiza. Uwo muntu aravuga kandi arareeba. <verse eid="MAT 12:22" /><verse number="23" style="v" sid="MAT 12:23" />Abantu nyamwinshi baari aho, boose baratangaara maze bariibaza bati, “Uyu ntiyaaba ari we mwene Dawudi?”<verse eid="MAT 12:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 12:24" />
    <note caller="-" style="x">
      <char style="xo" closed="false">12:24 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 9:34">Mat 9:34</ref>; <ref loc="MAT 10:25">10:25</ref>.</char>
    </note>Ariko Abafarisaayo babyumviise, baravuga bati, “Ntaawundi umuha imbaraga zo kwirukana abadayimooni, keretse Bbelizebuulu, umutware w'abadayimooni.” <verse eid="MAT 12:24" /><verse number="25" style="v" sid="MAT 12:25" />Kuko Yesu yari azi ico baateekereza, ni ko kubabwira ati, “Ubwami bwose bwigabyemo ibice burarimbuka, kandi ntaatawuni cangwa umuryango wisubiranamo ngo urambe<note caller="+" style="f"><char style="fr" closed="false">12:25 </char><char style="ft" closed="false">Kuramba kimenyeesha kumara igihe kireekire cangwa kurama</char></note>. <verse eid="MAT 12:25" /><verse number="26" style="v" sid="MAT 12:26" />Niiba Sataani yiirukana Sataani, ubwo aba yiirwanya, noone se ubwami bwe bwakomera bute? <verse eid="MAT 12:26" /><verse number="27" style="v" sid="MAT 12:27" />Kandi niiba nkoreesha Bbelizebuulu kwirukana abadayimooni, noone se abayoboke baanyu ni nde ubaha ububaasha bwo kwirukana abadayimooni? Ni co gituma reero bazaabaciira urubanza. <verse eid="MAT 12:27" /><verse number="28" style="v" sid="MAT 12:28" />Ariko niiba ari Umwuka w'Imaana nkoreesha kwirukana abadayimooni, reero Ubwami bw'Imaana bwabagezemo.<verse eid="MAT 12:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 12:29" />Cangwa se, umuntu yashobora ate kumena inzu y'umunyambaraga maze agasahura ibye, atabanje kumuboha? Ubwo ni bwo yashobora gusahura ibyo mu rugo rwe.<verse eid="MAT 12:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="MAT 12:30" />
    <note caller="-" style="x">
      <char style="xo" closed="false">12:30 </char>
      <char style="xt" closed="false">
        <ref loc="MRK 9:40">Mar 9:40</ref>.</char>
    </note>Umuntu weese utari nanje aba andwanya, kandi uwo tudateeranyiriza hamwe arataataanya. <verse eid="MAT 12:30" /><verse number="31" style="v" sid="MAT 12:31" />Ni co gituma mbabwira ko abantu bazaababarirwa icaaha coose ndetse no gutuka Imaana, ariko gutuka Umwuka Weera ntaabwo bizaababarirwa. <verse eid="MAT 12:31" /><verse number="32" style="v" sid="MAT 12:32" /><note caller="-" style="x"><char style="xo" closed="false">12:32 </char><char style="xt" closed="false"><ref loc="LUK 12:10">Luk 12:10</ref>.</char></note>Umuntu weese uzaavuga naabi Umwana w'Umuntu azaababarirwa, ariko uzaavuga naabi Umwuka Weera ntaabwo azaababarirwa, haaba mu gihe turimo cangwa ikizaaza.<verse eid="MAT 12:32" /></para>
  <para style="s1">Igiti n'Imbuto Zaaco</para>
  <para style="r">(<ref loc="LUK 6:43-45">Luk 6:43-45</ref>)</para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 12:33" />
    <note caller="-" style="x">
      <char style="xo" closed="false">12:33 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 7:20">Mat 7:20</ref>; <ref loc="LUK 6:44">Luk 6:44</ref>.</char>
    </note>Niiba mufite igiti ciiza, kizeera imbuto nziiza, niiba mufite igiti kibi, kizeera imbuto mbi, kuko igiti kirangwa n'imbuto zaaco. <verse eid="MAT 12:33" /><verse number="34" style="v" sid="MAT 12:34" /><note caller="-" style="x"><char style="xo" closed="false">12:34 a </char><char style="xt" closed="false"><ref loc="MAT 3:7">Mat 3:7</ref>; <ref loc="MAT 23:33">23:33</ref>; <ref loc="LUK 3:7">Luk 3:7</ref>; </char><char style="xo" closed="false">b </char><char style="xt" closed="false"><ref loc="MAT 15:18">Mat 15:18</ref>; <ref loc="LUK 6:45">Luk 6:45</ref>.</char></note>Mwa rubyaro rw'inciira mwe! Mwashobora mute kuvuga amagambo meeza, kandi muri babi? Kuko akuuzuye umutima ni ko gaseesekara ku rurimi. <verse eid="MAT 12:34" /><verse number="35" style="v" sid="MAT 12:35" />Umuntu mwiza avaana ibyiza mu mutima we, naho umuntu mubi akavaana ibibi byuzuye mu mutima we.<verse eid="MAT 12:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="MAT 12:36" />Ndababwira yuuko, ku munsi Imaana izaaca imanza muzaabazwa buri jambo ryose ry'impfaabusa mwavuze, <verse eid="MAT 12:36" /><verse number="37" style="v" sid="MAT 12:37" />kuko amagambo yaawe ari yo azaatuma utsinda, cangwa utsindwa n'urubanza.”<verse eid="MAT 12:37" /></para>
  <para style="s1">Abantu Basaba Yesu Gukora Igitangaaza</para>
  <para style="r">(<ref loc="MRK 8:11-12">Mar 8:11-12</ref>; <ref loc="LUK 11:29-32">Luk 11:29-32</ref>)</para>
  <para style="p">
    <verse number="38" style="v" sid="MAT 12:38" />
    <note caller="-" style="x">
      <char style="xo" closed="false">12:38 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 16:1">Mat 16:1</ref>; <ref loc="MRK 8:11">Mar 8:11</ref>; <ref loc="LUK 11:16">Luk 11:16</ref>.</char>
    </note>Nuuko bamwe mu banditsi<note caller="+" style="f"><char style="fr" closed="false">12:38 </char><char style="ft" closed="false">cangwa </char><char style="fqa" closed="false">Abiigiishamategeko</char></note> n'Abafarisaayo baramubwira bati, “Mwigiisha, turiifuuza kureeba igitangaaza kiguturukaho.” <verse eid="MAT 12:38" /><verse number="39" style="v" sid="MAT 12:39" /><note caller="-" style="x"><char style="xo" closed="false">12:39 </char><char style="xt" closed="false"><ref loc="MAT 16:4">Mat 16:4</ref>; <ref loc="MRK 8:12">Mar 8:12</ref>.</char></note>Ariko we arabasubiza ati, “Ab'igihe c'inkozi z'ibibi hamwe n'ubuhemu barasaba igitangaaza, ariko ntaagitangaaza kindi bazaahaabwa, keretse ic'umuhanuuzi Yona. <verse eid="MAT 12:39" /><verse number="40" style="v" sid="MAT 12:40" />Nk'uko Yona yamaze iminsi itatu n'amajoro atatu mu nda y'isamaaki nini, ni ko n'Umwana w'Umuntu azaamara iminsi itatu n'amajoro atatu ikuzimu. <verse eid="MAT 12:40" /><verse number="41" style="v" sid="MAT 12:41" />Ku munsi w'urubanza abantu b'i Ninevi bazaahagurukira ab'iki gihe maze babashinje, kuko biihannye ku bw'inyigiisho ya Yona, kandi dore uruta Yona ari hano! <verse eid="MAT 12:41" /><verse number="42" style="v" sid="MAT 12:42" />Umwamikazi w'amajeepfo azaahagurukira ab'iki gihe kuri uwo munsi w'urubanza maze abatsinde, kuko yaturutse ku mpera y'isi aje kumva ubuhanga bwa Solomooni, kandi hano hari uruta Solomooni!<verse eid="MAT 12:42" /></para>
  <para style="s1">Kugaruka k'Umwuka Mubi</para>
  <para style="r">(<ref loc="LUK 11:24-26">Luk 11:24-26</ref>)</para>
  <para style="p">
    <verse number="43" style="v" sid="MAT 12:43" />Iyo umwuka mubi uvuuye mu muntu, uzereera mu butaayu ushaakiisha uburuhuukiro, maze ukabubura. <verse eid="MAT 12:43" /><verse number="44" style="v" sid="MAT 12:44" />Nuuko ukavuga uti, ‘Reka nsubire mu nzu yanje navuuyemo.’ Iyo ugarutse ugasanga irimo ubusa, ikondoowe, kandi iteguuwe, <verse eid="MAT 12:44" /><verse number="45" style="v" sid="MAT 12:45" />uragenda ukaazana indi myuka mibi irindwi iyirusha ubukana, maze ikinjira ikahatuura kandi imibeereho ye ya nyuma ikarusha iya mbere kuba mibi. Uko ni ko bizaabeera inkozi z'ibibi z'iki gihe.”<verse eid="MAT 12:45" /></para>
  <para style="s1">Nyina wa Yesu n'Abavandimwe be</para>
  <para style="r">(<ref loc="MRK 3:31-35">Mar 3:31-35</ref>; <ref loc="LUK 8:19-21">Luk 8:19-21</ref>)</para>
  <para style="p">
    <verse number="46" style="v" sid="MAT 12:46" />Igihe Yesu yari akivugana n'abantu benshi, nyina n'abavandimwe<note caller="+" style="f"><char style="fr" closed="false">12:46 </char><char style="ft" closed="false">Ibindi byanditswe byera bavuga </char><char style="fqa">beene nyina</char> cangwa <char style="fqa">beene se</char> mu mwanya w'abavandimwe.</note> be baari bahagaze hanze, bashaaka kuvugana na we. <verse eid="MAT 12:46" /><verse number="47" style="v" sid="MAT 12:47" /><note caller="+" style="f"><char style="fr" closed="false">12:47 </char><char style="ft" closed="false">Bimwe mu byanditse byera ntibifite umurongo wa 47.</char></note> Umuntu aramubwira ati, “Dore, nyoko n'abavandimwe baawe bahagaze hanze, barashaaka kuvugana naawe.”<verse eid="MAT 12:47" /></para>
  <para style="p">
    <verse number="48" style="v" sid="MAT 12:48" />Yesu asubiza uwari amaze kumubwira ati, “Maama ni nde, kandi abavandimwe banje ni bande?” <verse eid="MAT 12:48" /><verse number="49" style="v" sid="MAT 12:49" />Nuuko atunga urutoki ku biigiishwa be, maze aravuga ati, “Dore maama n'abavandimwe banje! <verse eid="MAT 12:49" /><verse number="50" style="v" sid="MAT 12:50" />Kuko umuntu weese ukora ibyo Daata wo mu ijuru ashaaka ni we mwene daata, ni we mushiki wanje kandi ni we maama.”<verse eid="MAT 12:50" /></para>
  <chapter eid="MAT 12" />
  <chapter number="13" style="c" sid="MAT 13" />
  <para style="s1">Umugani W'umubibyi</para>
  <para style="r">(<ref loc="MRK 4:1-9">Mar 4:1-9</ref>; <ref loc="LUK 8:4-8">Luk 8:4-8</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 13:1" />Uwo munsi Yesu ava mu nzu maze yicara ku nkengeero y'inyanja. <verse eid="MAT 13:1" /><verse number="2" style="v" sid="MAT 13:2" /><note caller="-" style="x"><char style="xo" closed="false">13:2 </char><char style="xt" closed="false"><ref loc="LUK 5:1-3">Luk 5:1-3</ref>.</char></note>Abantu benshi baramwitooroora bimuteera kuja mu bwato maze yiicaramo, naho abo bantu bahagarara ku nkengeero. <verse eid="MAT 13:2" /><verse number="3" style="v" sid="MAT 13:3" />Ababwira ibintu byinshi akoreesheje imigani ati,</para>
  <para style="p" vid="MAT 13:3">“Nimwumve! Umubibyi yagiiye kubiba. <verse eid="MAT 13:3" /><verse number="4" style="v" sid="MAT 13:4" />Ubwo yabibaga, imbuto zimwe zigwa mu nzira, maze inyoni ziraaza zirazirya. <verse eid="MAT 13:4" /><verse number="5" style="v" sid="MAT 13:5" />Izindi mbuto zigwa ku kaara, maze zimera vuba, kuko ubutaka bwari buke. <verse eid="MAT 13:5" /><verse number="6" style="v" sid="MAT 13:6" />Ariko izuuba rivuuye ziraraba, kuko imizi itaari igeze kure, ziruuma. <verse eid="MAT 13:6" /><verse number="7" style="v" sid="MAT 13:7" />Izindi mbuto zigwa mu mahwa, amahwa arakura, arazipfukiriranya ntizaakura. <verse eid="MAT 13:7" /><verse number="8" style="v" sid="MAT 13:8" />Izindi mbuto zigwa mu butaka bwiza maze zeera imbuto, zimwe ijana, izindi mirongo itandatu, izindi mirongo itatu.<verse eid="MAT 13:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 13:9" />Ufite amatwi yumva niyumve!”<verse eid="MAT 13:9" /></para>
  <para style="s1">Igituma Yesu Avugira mu Migani</para>
  <para style="r">(<ref loc="MRK 4:10-12">Mar 4:10-12</ref>; <ref loc="LUK 8:9-10">Luk 8:9-10</ref>)</para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 13:10" />Abiigiishwa be baramwegeera maze baramubaza bati, “Ni iki gituma ubiigiishiriza mu migani?”<verse eid="MAT 13:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 13:11" />Arabasubiza ati, “Mwebwe mwahaawe kumenya amabanga y'Ubwami bw'ijuru, ariko bo ntibaabihaawe. <verse eid="MAT 13:11" /><verse number="12" style="v" sid="MAT 13:12" /><note caller="-" style="x"><char style="xo" closed="false">13:12 </char><char style="xt" closed="false"><ref loc="MAT 25:29">Mat 25:29</ref>; <ref loc="MRK 4:25">Mar 4:25</ref>; <ref loc="LUK 8:18">Luk 8:18</ref>; <ref loc="LUK 19:26">19:26</ref>.</char></note>Kuko abafite, bazongeererwa kandi bahaabwe byinshi, ariko abadafite, bazaakwa n'ico bafite. <verse eid="MAT 13:12" /><verse number="13" style="v" sid="MAT 13:13" />Igituma mbiigishiriza mu migani ni uko ‘Bareeba ntibabone, baatega amatwi ntibumve kandi ntibasobaanukirwe.’ <verse eid="MAT 13:13" /><verse number="14" style="v" sid="MAT 13:14" />Muri bo, hazuuzurizwa ubuhanuuzi bwa Yesaaya buvuga ngo,</para>
  <para style="q1" vid="MAT 13:14">‘Koko muzumva, ariko ntimuzaasobaanukirwa,</para>
  <para style="q2" vid="MAT 13:14">kandi muzaareeba, ariko ntimuzaabona.<verse eid="MAT 13:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="MAT 13:15" />Kuko imitima yaabo yiinangiye,</para>
  <para style="q2" vid="MAT 13:15">kandi amatwi yaabo akaba atumva neeza,</para>
  <para style="q3" vid="MAT 13:15">ndetse biipfutse amaaso, kugira ngo batareeba,</para>
  <para style="q2" vid="MAT 13:15">atari ibyo, amaaso yaabo yakareebye,</para>
  <para style="q2" vid="MAT 13:15">n'amatwi yaabo yakumviise,</para>
  <para style="q2" vid="MAT 13:15">kandi imitima yaabo igasobaanukirwa,</para>
  <para style="q1" vid="MAT 13:15">maze bakampindukira,</para>
  <para style="q2" vid="MAT 13:15">nkabakiza.’<verse eid="MAT 13:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 13:16" />
    <note caller="-" style="x">
      <char style="xo" closed="false">13:16 </char>
      <char style="xt" closed="false">
        <ref loc="LUK 10:23">Luk 10:23</ref>,<ref loc="LUK 10:24">24</ref>.</char>
    </note>Ariko mwebwe murahiirwa, kuko amaaso yaanyu arabona, kandi n'amatwi yaanyu arumva. <verse eid="MAT 13:16" /><verse number="17" style="v" sid="MAT 13:17" />Ndababwira ukuri yuuko abahanuuzi benshi n'abantu bintungaane biifuuzaga kureeba ibyo mureeba, ariko ntibabibone, ndetse no kumva ibyo mwumva, ariko ntibabyumve.<verse eid="MAT 13:17" /></para>
  <para style="s1">Yesu Asobaanura Umugani w'Umubibyi</para>
  <para style="r">(<ref loc="MRK 4:13-20">Mar 4:13-20</ref>; <ref loc="LUK 8:11-15">Luk 8:11-15</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 13:18" />Nuuko nimwumve ico umugani w'umubibyi umenyeesha. <verse eid="MAT 13:18" /><verse number="19" style="v" sid="MAT 13:19" />Iyo umuntu yumviise ijambo ry'Imaana ariko ntaarisobaanukirwe, Umubi araaza agasahura ikibibwe mu mutima we, uwo ameze nk'imbuto zaabibwe ku nzira. <verse eid="MAT 13:19" /><verse number="20" style="v" sid="MAT 13:20" />Naho izaabibwe ku kaara, ni uwumva ijambo ako kaanya akaryakiirana umuneezeero, <verse eid="MAT 13:20" /><verse number="21" style="v" sid="MAT 13:21" />ariko ntirimwuzure ngo rishinge imizi, yiihangaana umwanya muto. Iyo haaje amakuba cangwa gutootezwa biteewe n'iryo jambo, uwo muntu ashooka avuuye mu kwizeera. <verse eid="MAT 13:21" /><verse number="22" style="v" sid="MAT 13:22" />Naho izaaguuye mu mahwa, zisobaanura umuntu wumva neeza ijambo, ariko akiita ku by'isi maze irari ry'ubutunzi rikaniga rya jambo, maze ntiryere imbuto. <verse eid="MAT 13:22" /><verse number="23" style="v" sid="MAT 13:23" />Naho izaabibwe mu butaka bwiza, abo ni abumva ijambo bakarisobaanukirwa, bakeera imbuto, umwe ijana, undi mirongo itandatu, undi mirongo itatu.”<verse eid="MAT 13:23" /></para>
  <para style="s1">Umugani w'Urumamfu mu Ngano</para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 13:24" />Yesu aciira abantu undi mugani ati, “Ubwami bw'ijuru bwagereranywa n'umuntu wabibye imbuto nziiza mu murima we. <verse eid="MAT 13:24" /><verse number="25" style="v" sid="MAT 13:25" />Ariko abantu basinziiriye, umwanzi araaza abiba urumamfu mu ngano, maze ariigendera. <verse eid="MAT 13:25" /><verse number="26" style="v" sid="MAT 13:26" />Ingano zimaze kumera no kugaragaza imbuto, urumamfu na rwo ruragaragara. <verse eid="MAT 13:26" /><verse number="27" style="v" sid="MAT 13:27" />Abagaragu be baraaza baramubaza bati, ‘Daatabuja, ntiwari warabibye imbuto nziiza mu murima waawe? Noone se, urumamfu rwaje rute?’ <verse eid="MAT 13:27" /><verse number="28" style="v" sid="MAT 13:28" />Arabasubiza ati, ‘Umwanzi ni we wabikoze.’ Abagaragu barongera bati, ‘Noone urashaaka ko tuja kururandura?’ <verse eid="MAT 13:28" /><verse number="29" style="v" sid="MAT 13:29" />Ariko we arabasubiza ati, ‘Oya, muri uko kurandura urumamfu, mushobora kururandurana n'ingano. <verse eid="MAT 13:29" /><verse number="30" style="v" sid="MAT 13:30" />Reka byombi bikurane kugeza igihe c'isaaruura, maze mu gihe co gusaaruura nzaabwira abasaaruuzi nti, nimubanze mutoranye urumamfu maze muruhambiremo imiganda murutwike, ingano muzihunike mu kigega canje.’ ”<verse eid="MAT 13:30" /></para>
  <para style="s1">Umugani w'Akabuto Gato</para>
  <para style="r">(<ref loc="MRK 4:30-32">Mar 4:30-32</ref>; <ref loc="LUK 13:18-19">Luk 13:18-19</ref>)</para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 13:31" />Yesu abaciira undi mugani ati, “Ubwami bw'ijuru bumeze nk'akabuto gato kitwa sinaapi ko umuntu yabibye mu murima we. <verse eid="MAT 13:31" /><verse number="32" style="v" sid="MAT 13:32" />Ni ko kabuto gatooya kuruta izindi mbuto zoose, ariko iyo gakuze kaba igiti kinini gifite amashami ndetse inyoni zo mu kireere zaarika mu mashami yaaco.”<verse eid="MAT 13:32" /></para>
  <para style="s1">Umugani w'Umusemburo</para>
  <para style="r">(<ref loc="LUK 13:20-21">Luk 13:20-21</ref>)</para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 13:33" />Ababwira undi mugani ati, “Ubwami bw'ijuru bumeze nk'umusemburo umugore yavanze mo ibyibo bitatu by'ifu kugeza aho byose bitutumba.”<verse eid="MAT 13:33" /></para>
  <para style="s1">Akamaro k'Imigani y'Amarenga</para>
  <para style="r">(<ref loc="MRK 4:33-34">Mar 4:33-34</ref>)</para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 13:34" />Yesu yigishirizaga abantu benshi mu migani kandi ntaaco yiigiishije adakoreesheje imigani y'amarenga. <verse eid="MAT 13:34" /><verse number="35" style="v" sid="MAT 13:35" />Uku kwari ukugira ngo iby'umuhanuuzi yavuze bisohore ati,</para>
  <para style="q1" vid="MAT 13:35">“Nzaabumbuura akanwa kanje mvuge mu migani y'amarenga.</para>
  <para style="q2" vid="MAT 13:35">Nzaamamaza ibyahishwe kuva isi ikiremwa.”<verse eid="MAT 13:35" /></para>
  <para style="s1">Yesu Asobaanura Umugani w'Urumamfu</para>
  <para style="p">
    <verse number="36" style="v" sid="MAT 13:36" />Haanyuma asiga rubanda maze yinjira mu nzu. Nuuko abiigiishwa be baramwegeera, baramubaza bati, “Dusobaanurire umugani w'urumamfu mu murima.”<verse eid="MAT 13:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="MAT 13:37" />Arabasubiza ati, “Uwabibye imbuto nziiza ni Umwana w'Umuntu, <verse eid="MAT 13:37" /><verse number="38" style="v" sid="MAT 13:38" />umurima ni isi, imbuto nziiza ni abaana b'Ubwami, urumamfu ni abaana b'Umubi, <verse eid="MAT 13:38" /><verse number="39" style="v" sid="MAT 13:39" />naho umwanzi wateeye urumamfu ni Seekibi, isaaruura n'imperuuka y'isi, naho abasaaruuzi ni abaamalayika. <verse eid="MAT 13:39" /><verse number="40" style="v" sid="MAT 13:40" />Nk'uko urumamfu rukunganywa rukajugunywa mu muriro, ni nako bizaaba ku mperuuka y'isi. <verse eid="MAT 13:40" /><verse number="41" style="v" sid="MAT 13:41" />Umwana w'Umuntu azoohereza abaamalayika be, maze batandukanye abo boose baatumye abandi bagomera Imaana hamwe n'inkozi z'ibibi, <verse eid="MAT 13:41" /><verse number="42" style="v" sid="MAT 13:42" />maze babajugunye mu itanuura y'umuriro, aho bazaaririra bakahahekenyera ameenyo. <verse eid="MAT 13:42" /><verse number="43" style="v" sid="MAT 13:43" />Ico gihe intungaane zizaarabagirana nk'izuuba mu Bwami bwa Se. Ufite amatwi ni yumve!<verse eid="MAT 13:43" /></para>
  <para style="s1">Umugani w'Ubukungu Buhishwe</para>
  <para style="p">
    <verse number="44" style="v" sid="MAT 13:44" />Ubwami bw'ijuru bumeze nk'ikintu c'agaciiro gihishwe mu murima. Iyo umuntu akiguuyeho<note caller="+" style="f"><char style="fr" closed="false">13:44 </char><char style="ft" closed="false">Kubona ikintu utaciteguuye </char></note>, aragihisha maze akagenda n'umuneezeero mwinshi akaguriisha ibyo yari atunze byose kugira ngo abone uko yagura wa murima.<verse eid="MAT 13:44" /></para>
  <para style="s1">Umugani w'Amabuye y'Agaciiro</para>
  <para style="p">
    <verse number="45" style="v" sid="MAT 13:45" />Byongeye kandi, Ubwami bw'ijuru bumeze nk'umucuruuzi washaakaga amabuye y'agaciiro meeza, <verse eid="MAT 13:45" /><verse number="46" style="v" sid="MAT 13:46" />aboonye ibuye rimwe ry'agaciiro kanini, aragenda aguriisha ibyo atunze byose maze ararigura.<verse eid="MAT 13:46" /></para>
  <para style="s1">Umugani w'Agatimba ko Kurobeesha</para>
  <para style="p">
    <verse number="47" style="v" sid="MAT 13:47" />Byongeye kandi, Ubwami bw'ijuru bumeze nk'agatimba baajugunye mu nyanja kagafata isamaaki z'amooko yoose, <verse eid="MAT 13:47" /><verse number="48" style="v" sid="MAT 13:48" />kaamara kuuzura, bakagakururira ku nkengeero, bakiicara, maze isamaaki nziiza bakazishira mu bisobane naho imbi bakazijugunya. <verse eid="MAT 13:48" /><verse number="49" style="v" sid="MAT 13:49" />Uko ni ko bizaaba ku mperuuka y'isi. Abaamalayika b'Imaana bazaaza batandukanye intungaane n'inkozi z'ibibi <verse eid="MAT 13:49" /><verse number="50" style="v" sid="MAT 13:50" />bazijugunye mu itanuura y'umuriro, aho bazaaririra bakahahekenyera ameenyo.”<verse eid="MAT 13:50" /></para>
  <para style="s1">Yesu Avuga ku Nyigiisho za Keera n'Izuubu</para>
  <para style="p">
    <verse number="51" style="v" sid="MAT 13:51" />Yesu arababaza ati, “Ibi bintu murabisobaanukiwe?”</para>
  <para style="p" vid="MAT 13:51">Baramusubiza bati, “Yee.”<verse eid="MAT 13:51" /></para>
  <para style="p">
    <verse number="52" style="v" sid="MAT 13:52" />Arababwira ati, “Nuuko reero umwanditsi weese wiigiishijwe iby'Ubwami bw'ijuru yagereranywa na nyir'urugo wakuuye mu bubiiko ibisha n'ibishaaje.”<verse eid="MAT 13:52" /></para>
  <para style="p">
    <verse number="53" style="v" sid="MAT 13:53" />Yesu amaze kubaciira iyo migani, ava muri uwo mwanya.<verse eid="MAT 13:53" /></para>
  <para style="s1">Ab'i Nazaareeti Banga Yesu</para>
  <para style="r">(<ref loc="MRK 6:1-6">Mar 6:1-6</ref>; <ref loc="LUK 4:16-30">Luk 4:16-30</ref>)</para>
  <para style="p">
    <verse number="54" style="v" sid="MAT 13:54" />Aja mu tawuni y'iwaabo atangira kwigiishiriza abantu mu masinagoogi yaabo, maze baratangaara, baravuga bati, “Uyu mugabo akuura he ubu buhanga n'ububaasha bwo gukora ibi bitangaaza? <verse eid="MAT 13:54" /><verse number="55" style="v" sid="MAT 13:55" />Uyu si umwana wa wa mubaaji? Nyina siyitwa Mariya? Beene se si Yaakobo, Yozefu, Simooni na Yuda? <verse eid="MAT 13:55" /><verse number="56" style="v" sid="MAT 13:56" />Bashiki be ntidutuuranye na bo? Noone se yakuuye he ubuhanga n'ububaasha bwo gukora ibintu nk'ibi?” <verse eid="MAT 13:56" /><verse number="57" style="v" sid="MAT 13:57" /><note caller="-" style="x"><char style="xo" closed="false">13:57 </char><char style="xt" closed="false"><ref loc="JHN 4:44">Yoh 4:44</ref>.</char></note>Nuuko baramwanga.</para>
  <para style="p" vid="MAT 13:57">Ariko Yesu arababwira ati, “Ntaahandi abahanuuzi basuuzugurirwa, keretse mu gihugu caabo ndetse no mu miryango yaabo.” <verse eid="MAT 13:57" /><verse number="58" style="v" sid="MAT 13:58" />Kandi ntiyongera kuhakorera ibitangaaza, abiteewe no kuteemera kwabo.<verse eid="MAT 13:58" /></para>
  <chapter eid="MAT 13" />
  <chapter number="14" style="c" sid="MAT 14" />
  <para style="s1">Urupfu rwa Yohaana Umubatiza</para>
  <para style="r">(<ref loc="MRK 6:14-29">Mar 6:14-29</ref>; <ref loc="LUK 9:7-9">Luk 9:7-9</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 14:1" />Ico gihe Herodi, umutware w'i Galileeya, yumva ibifashe kuri Yesu, <verse eid="MAT 14:1" /><verse number="2" style="v" sid="MAT 14:2" />nuuko abwira abagaragu be ati. “Uyu ni Yohaana Umubatiza wazuutse mu baapfuuye, kandi ni co gituma akora ibitangaaza nk'ibi.”<verse eid="MAT 14:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 14:3" />
    <note caller="-" style="x">
      <char style="xo" closed="false">14:3 </char>
      <char style="xt" closed="false">
        <ref loc="LUK 3:19">Luk 3:19</ref>,<ref loc="LUK 3:20">20</ref>.</char>
    </note>Kuko Herodi yari yarafashe Yohaana, akamuboha, akamushira mu gihome ku bwa Herodiyaasi, umugore wa mwene nyina Filipo, <verse eid="MAT 14:3" /><verse number="4" style="v" sid="MAT 14:4" />kuko Yohaana yaramubwiraga ati, “Amategeko ntaabwo akwemerera kumutunga.” <verse eid="MAT 14:4" /><verse number="5" style="v" sid="MAT 14:5" />Nuubwo Herodi yashaakaga kumwica, yatiinyaga rubanda, kuko bamujaanaga nk'umuhanuuzi.<verse eid="MAT 14:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 14:6" />Umunsi wo kwibuka kuvuuka kwa Herodi ugeze, umukoobwa wa Herodiyaasi abyinira imbere y'abaatumiwe, maze ashiimiisha Herodi <verse eid="MAT 14:6" /><verse number="7" style="v" sid="MAT 14:7" />ku buryo yaseezeranyije uwo mukoobwa arahira ko aribumuhe ico amusaba coose.<verse eid="MAT 14:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 14:8" />Nyina amaze kumwosha, aravuga ati, “Mpa igihanga ca Yohaana Umubatiza ku mbeehe.”<verse eid="MAT 14:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 14:9" />Umwami arababara caane, ariko kubw'indahiro yari yarahiriye imbere y'abashitsi be, ategeka ko bakimuha. <verse eid="MAT 14:9" /><verse number="10" style="v" sid="MAT 14:10" />Nuuko yoohereza abo kuja guciira igihanga ca Yohaana mu gihome. <verse eid="MAT 14:10" /><verse number="11" style="v" sid="MAT 14:11" />Igihanga bakiizana ku mbeehe maze bagiheereza wa mukoobwa, na we agiheereza nyina. <verse eid="MAT 14:11" /><verse number="12" style="v" sid="MAT 14:12" />Abiigiishwa ba Yohaana baraaza bajaana umurambo we maze barawuhamba, haanyuma baja kubimenyeesha Yesu.<verse eid="MAT 14:12" /></para>
  <para style="s1">Yesu Agaburira Abantu Ibihumbi Bitaanu</para>
  <para style="r">(<ref loc="MRK 6:30-44">Mar 6:30-44</ref>; <ref loc="LUK 9:10-17">Luk 9:10-17</ref>; <ref loc="JHN 6:1-14">Yoh 6:1-14</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 14:13" />Yesu amaze kubyumva, aja mu bwato, agana ahantu hadatuuwe kwihereera. Ariko rubanda babimenye, bava mu matawuni yaabo n'amaguru maze baramukurikira. <verse eid="MAT 14:13" /><verse number="14" style="v" sid="MAT 14:14" />Amaze kwambuka, abona rubanda nyamwinshi, abagirira impuhwe maze akiiza abarwayi baari muri bo.<verse eid="MAT 14:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 14:15" />Bugoroobye, abiigiishwa baramusanga maze baramubwira bati, “Aha ni ahantu hadatuuwe, kandi n'umunsi urakuze, seezerera aba bantu baje mu byaro byabo maze biigurire ibyokurya.”<verse eid="MAT 14:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 14:16" />Yesu arabasubiza ati, “Singombwa ko bagenda, nimubagaburire mwebwe ubwanyu.”<verse eid="MAT 14:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 14:17" />Baramusubiza bati, “Ntaaco dufite hano, keretse imigaati itaanu n'isamaaki ebyiri gusa.”<verse eid="MAT 14:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 14:18" />Arababwira ati, “Nimubinzanire hano.” <verse eid="MAT 14:18" /><verse number="19" style="v" sid="MAT 14:19" />Maze ategeka abo bantu kwicara haasi mu byatsi. Afata ya migaati itaanu n'isamaaki ebyiri, areeba mu ijuru, ashiimira Imaana maze amanyagura ya migaati, ayiha abiigiishwa, na bo bayigaburira rubanda nyamwinshi. <verse eid="MAT 14:19" /><verse number="20" style="v" sid="MAT 14:20" />Boose bararya, barahaaga, nuuko barundanyiriza hamwe ibisigaye, byuzura intonga cumi n'ebyiri. <verse eid="MAT 14:20" /><verse number="21" style="v" sid="MAT 14:21" />Abaariiye baari nk'abagabo ibihumbi bitaanu, abagore n'abaana batabariwemo.<verse eid="MAT 14:21" /></para>
  <para style="s1">Yesu Agendera ku Maazi</para>
  <para style="r">(<ref loc="MRK 6:45-52">Mar 6:45-52</ref>; <ref loc="JHN 6:15-21">Yoh 6:15-21</ref>)</para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 14:22" />Ako kaanya Yesu ategeka abiigiishwa kwinjira mu bwato ngo bamubanzirize haakurya, mu gihe we agiseezerera rubanda. <verse eid="MAT 14:22" /><verse number="23" style="v" sid="MAT 14:23" />Amaze kubaseezerera, azaamuuka umusozi wenyine aja gusenga. Bwagoroobye ari yo wenyine, <verse eid="MAT 14:23" /><verse number="24" style="v" sid="MAT 14:24" />kandi ubwato bwari bugeze kure y'inkengeero buhungabanywa n'imivumba kuko umuyaga wari ubaturutse imbere.<verse eid="MAT 14:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 14:25" />Nuuko mu gitondo ca kare kare, aza abagana agendeesha amaguru heejuru y'inyanja. <verse eid="MAT 14:25" /><verse number="26" style="v" sid="MAT 14:26" />Ariko abiigiishwa bamuboonye agendera ku nyanja, basha ubwoba, ni ko kuvuza induuru bati, “Ni umuzimu!”<verse eid="MAT 14:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 14:27" />Ako kaanya Yesu avugana na bo arababwira ati, “Nimuhuumure, ni njeewe, mwitiinya.”<verse eid="MAT 14:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 14:28" />Peetero ni ko kumusubiza ati, “Nyagasani, niiba ari wowe koko, ntegeka ngusange, ngendera heejuru y'amaazi.”<verse eid="MAT 14:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 14:29" />Yesu ati, “Ngwino.” Nuuko Peetero ava mu bwato, atangira kugendera heejuru y'amaazi, asanga Yesu. <verse eid="MAT 14:29" /><verse number="30" style="v" sid="MAT 14:30" />Ariko aboonye umuyaga ubaaye mwinshi, agira ubwoba, maze atangira kurohama, nuuko ateera heejuru ati, “Nyagasani, ntabaara!”<verse eid="MAT 14:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 14:31" />Ako kaanya Yesu arambuura ukuboko kwe aramusingiira, aramubwira ati, “Wa mwemera gato we, kuki washidikanyije?”<verse eid="MAT 14:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 14:32" />Nuuko bageze mu bwato, umuyaga uratuuza. <verse eid="MAT 14:32" /><verse number="33" style="v" sid="MAT 14:33" />Abaari mu bwato baramuramya, bavuga bati, “Ni ukuri uri Umwana w'Imaana!”<verse eid="MAT 14:33" /></para>
  <para style="s1">Yesu Akiza Abarwayi mu Gihugu ca Genezareti</para>
  <para style="r">(<ref loc="MRK 6:53-56">Mar 6:53-56</ref>)</para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 14:34" />Bamaze kwambuka, bagera mu gihugu ca Genezareti. <verse eid="MAT 14:34" /><verse number="35" style="v" sid="MAT 14:35" />Abantu b'uwo mwanya bamaze kumumenya, bakwirakwiza inkuru muri ico gihugu coose maze bamuuzanira abarwayi boose. <verse eid="MAT 14:35" /><verse number="36" style="v" sid="MAT 14:36" />Nuuko binginga Yesu ngo niibura yeemerere abarwayi bafate ku nshonda z'umwenda we kandi abo boose baazikozeho barakira.<verse eid="MAT 14:36" /></para>
  <chapter eid="MAT 14" />
  <chapter number="15" style="c" sid="MAT 15" />
  <para style="s1">Imigenzo y'Abakurambere</para>
  <para style="r">(<ref loc="MRK 7:1-13">Mar 7:1-13</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 15:1" />Muri ico gihe, Abafarisaayo hamwe n'Abiigiishamategeko basanga Yesu bavuuye i Yerusaalemu, baramubaza bati, <verse eid="MAT 15:1" /><verse number="2" style="v" sid="MAT 15:2" />“Kuki abiigiishwa baawe badakurikiza umuco karande w'abakurambere? Dore ntibakaraba intoki bagiiye kurya.”<verse eid="MAT 15:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 15:3" />Arabasubiza ati, “Mwebwe kuki mwica itegeko ry'Imaana mwishigikirije umuco karande waanyu? <verse eid="MAT 15:3" /><verse number="4" style="v" sid="MAT 15:4" />Kuko Imaana yaravuze iti,<note caller="+" style="f"><char style="fr" closed="false">15:4 </char><char style="ft" closed="false">Ibindi byanditswe byera byerekana ngo </char><char style="fqa" closed="false">Imaana yarategetse iti. </char></note> ‘Uje wubaha so na nyoko,’ kandi iti, ‘Uzaatuka se cangwa nyina agomba kwicwa.’ <verse eid="MAT 15:4" /><verse number="5" style="v" sid="MAT 15:5" />Ariko umuntu weese ubwira se cangwa nyina ati, ‘Ico najaga kugufaashiisha nagituuye Imaana.’ Umuntu umeze atyo ntaabwo yakuubaha se cangwa nyina. <verse eid="MAT 15:5" /><verse number="6" style="v" sid="MAT 15:6" />Bityo, muba mushigikiye umuco karande, ijambo ry'Imaana hamwe n'amategeko mukabihindura ubusa. <verse eid="MAT 15:6" /><verse number="7" style="v" sid="MAT 15:7" />Mwa ndyarya mwe! Yesaaya yabahanuuyeho neeza ubwo yavuze ati,<verse eid="MAT 15:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="MAT 15:8" />‘Aba bantu banyubahiisha ururimi,</para>
  <para style="q2" vid="MAT 15:8">ariko imitima yaabo imba kure,<verse eid="MAT 15:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="MAT 15:9" />barushwa n'ubusa bansenga,</para>
  <para style="q2" vid="MAT 15:9">kuko biigiisha amategeko y'abantu nk'aho ari amategeko yanje.’ ”<verse eid="MAT 15:9" /></para>
  <para style="s1">Ibihumaanya Umuntu</para>
  <para style="r">(<ref loc="MRK 7:14-23">Mar 7:14-23</ref>)</para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 15:10" />Nuuko ahamagara rubanda maze arababwira ati, “Nimutege amatwi kandi musobaanukirwe, <verse eid="MAT 15:10" /><verse number="11" style="v" sid="MAT 15:11" />ntaabwo ari ikija mu kanwa gihumaanya umuntu, ahuubwo ikiva mu kanwa ni co kiimuhumaanya.”<verse eid="MAT 15:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 15:12" />Maze abiigiishwa baramwegeera baramubaza bati, “Uzi yuuko Abafarisaayo baababajwe no kumva amagambo umaze kuvuga?”<verse eid="MAT 15:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 15:13" />Arabasubiza ati, “Igiti coose kitaateewe na Daata wo mu ijuru kigomba kurandurwa. <verse eid="MAT 15:13" /><verse number="14" style="v" sid="MAT 15:14" /><note caller="-" style="x"><char style="xo" closed="false">15:14 </char><char style="xt" closed="false"><ref loc="LUK 6:39">Luk 6:39</ref>.</char></note>Nimubiihorere, ni impumyi ziyobora izindi mpumyi. Kandi iyo impumyi iyoboye indi mpumyi, zombi zigwa mu coobo.”<verse eid="MAT 15:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 15:15" />Ariko Peetero aramubwira ati, “Dusobaanurire uyu mugani.”<verse eid="MAT 15:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 15:16" />Nuuko aramusubiza ati, “Mbese namwe ntimuraasobaanukirwa? <verse eid="MAT 15:16" /><verse number="17" style="v" sid="MAT 15:17" />Ntimuuzi yuuko ikintu coose kigiiye mu kanwa kija munda, maze kigasohoka kikaja mu coroone? <verse eid="MAT 15:17" /><verse number="18" style="v" sid="MAT 15:18" /><note caller="-" style="x"><char style="xo" closed="false">15:18 </char><char style="xt" closed="false"><ref loc="MAT 12:34">Mat 12:34</ref>.</char></note>Ariko ibiva mu kanwa biba biturutse mu mutima, kandi ni byo bihumaanya umuntu. <verse eid="MAT 15:18" /><verse number="19" style="v" sid="MAT 15:19" />Kuko mu mutima ni ho haturuka ibiteekerezo bibi nk'ubwicanyi, ubusambanyi, ubuheeheesi, ubujuura, ububeeshi no gusebya abandi. <verse eid="MAT 15:19" /><verse number="20" style="v" sid="MAT 15:20" />Ibi ni byo bihumaanya umuntu, ariko kuriisha intoki zidakarabye ntibihumaanya.”<verse eid="MAT 15:20" /></para>
  <para style="s1">Umugore Wagize Kwizeera</para>
  <para style="r">(<ref loc="MRK 7:24-30">Mar 7:24-30</ref>)</para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 15:21" />Yesu arahava aja mu disiturikiti y'i Tiiro n'i Sidoni. <verse eid="MAT 15:21" /><verse number="22" style="v" sid="MAT 15:22" />Muri ako kaanya haba haaje Umunyakanaanikazi wari utuuye muri ako gace, asanga Yesu, ateera heejuru caane ati, “Nyagasani, Mwana wa Dawudi, ngirira imbabazi, umukoobwa wanje yateewe na dayimooni.”<verse eid="MAT 15:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 15:23" />Ariko ntiyagira ico amusubiza. Nuuko abiigiishwa be baramwegeera baramwinginga, baramubwira bati, “Mwirukane kuko ayombera inyuma yaacu.”<verse eid="MAT 15:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 15:24" />Arabasubiza ati, “Ntaahandi nooherejwe, keretse mu ntaama za Isirayeli zaazimiye.”<verse eid="MAT 15:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 15:25" />Uwo mugore araaza apfukama imbere ye, aravuga ati, “Nyagasani, ntabaara.”<verse eid="MAT 15:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 15:26" />Yesu aramusubiza ati, “Ntaabwo bikwiriye gufata ibyokurya by'abaana maze ukabijugunyira imbwa.”<verse eid="MAT 15:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 15:27" />Umugore na we ati, “Ni koko Nyagasani, ariko imbwa na zo zirya ibisigarizwa bigwa bivuuye ku meeza ya sheebuja.”<verse eid="MAT 15:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 15:28" />Maze Yesu aramusubiza ati, “Mugore, ufite kwizeera gukomeye! Bikubeere nk'uko ubishaaka.” Ako kaanya umukoobwa we arakira.<verse eid="MAT 15:28" /></para>
  <para style="s1">Yesu Akiza Abantu Benshi</para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 15:29" />Yesu amaze kuva muri uwo mwanya, anyura ku nkengeero y'inyanja ya Galileeya, maze azaamuuka umusozi nuuko ariicara. <verse eid="MAT 15:29" /><verse number="30" style="v" sid="MAT 15:30" />Abantu benshi baaza aho ari, bazaana abacumbagira, abamuga, abahumye, abaragi n'abandi benshi. Baabashiraga imbere ye, akabakiza, <verse eid="MAT 15:30" /><verse number="31" style="v" sid="MAT 15:31" />ku buryo rubanda baatangaaye ubwo bareebaga abaragi bavuga, abamugaye bakira, abacumbagira bagenda, n'abahumye bareeba, maze basingiza Imaana ya Isirayeli.<verse eid="MAT 15:31" /></para>
  <para style="s">Yesu Agaburira Abantu Ibihumbi Bine</para>
  <para style="r">(<ref loc="MRK 8:1-10">Mar 8:1-10</ref>)</para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 15:32" />Yesu ahamagara abiigiishwa be maze avugana na bo ababwira ati, “Aba bantu nyamwinshi ndabababariye, kuko maranye na bo iminsi itatu yoose noone bakaba ntaaco kurya bafite, kandi sinshaaka kubaseezerera bafite inzara, kugira ngo batagwa mu nzira.”<verse eid="MAT 15:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 15:33" />Abiigiishwa baramubwira bati, “Twakuura he imigaati ihaagije aba bantu boose muri ubu butaayu?”<verse eid="MAT 15:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 15:34" />Yesu arababaza ati, “Mufite imigaati ingaahe?”</para>
  <para style="p" vid="MAT 15:34">Baramusubiza bati, “Dufite imigaati irindwi n'udusamaaki dukeeya.”<verse eid="MAT 15:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="MAT 15:35" />Maze ategeka rubanda kwicara haasi, <verse eid="MAT 15:35" /><verse number="36" style="v" sid="MAT 15:36" />afata ya migaati irindwi na za samaaki, amaze gushiimira Imaana arayimaanyagura, abiha abiigiishwa be, maze n'abiigiishwa babiha abantu. <verse eid="MAT 15:36" /><verse number="37" style="v" sid="MAT 15:37" />Boose bararya barahaaga, maze bashira hamwe ubuvungunyukira busigaye, bwuzura ibisobane birindwi. <verse eid="MAT 15:37" /><verse number="38" style="v" sid="MAT 15:38" />Abaariiye baari abagabo ibihumbi bine, batabariyemo abagore n'abaana.<verse eid="MAT 15:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="MAT 15:39" />Amaze guseezerera rubanda, yinjira mu bwato maze aja mu gace ka Magadani.<verse eid="MAT 15:39" /></para>
  <chapter eid="MAT 15" />
  <chapter number="16" style="c" sid="MAT 16" />
  <para style="s1">Abayuuda Basaba Yesu Ikimenyeetso</para>
  <para style="r">(<ref loc="MRK 8:11-13">Mar 8:11-13</ref>; <ref loc="LUK 12:54-56">Luk 12:54-56</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 16:1" />
    <note caller="-" style="x">
      <char style="xo" closed="false">16:1 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 12:38">Mat 12:38</ref>; <ref loc="LUK 11:16">Luk 11:16</ref>.</char>
    </note>Abafarisaayo n'Abasadukaayo baraaza, basaba Yesu kubeereka ikimenyeetso kivuuye mu ijuru kugira ngo bamutege. <verse eid="MAT 16:1" /><verse number="2" style="v" sid="MAT 16:2" />Arabasubiza ati, “Muri iki gihugu iyo bugoroobye, muravuga muti, ‘Haraba umuco kuko ijuru ritukura.’ <verse eid="MAT 16:2" /><verse number="3" style="v" sid="MAT 16:3" />Naho mu gitondo muti, ‘Haraba umuvumbi uyu munsi, kuko ijuru ritukura kandi ryijimye.’ Muuzi neeza kureeba ikireere mukamenya niiba haraba umuco cangwa umuvumbi, ariko ntimushobora kumenya ibimenyeetso by'ibihe. <verse eid="MAT 16:3" /><verse number="4" style="v" sid="MAT 16:4" /><note caller="-" style="x"><char style="xo" closed="false">16:4 </char><char style="xt" closed="false"><ref loc="MAT 12:39">Mat 12:39</ref>; <ref loc="LUK 11:29">Luk 11:29</ref>.</char></note>Abantu b'iki gihe c'ubugizi bwa naabi n'ubutamenya Imaana barashaaka ikimenyeetso, ariko ntaakimenyeetso bazaabona keretse ica Yona.” Nuuko abasiga aho aragenda<verse eid="MAT 16:4" /></para>
  <para style="s1">Umusemburo w'Abafarisaayo n'Abasadukaayo</para>
  <para style="r">(<ref loc="MRK 8:14-21">Mar 8:14-21</ref>)</para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 16:5" />Abiigiishwa ba Yesu bageze haakurya, baari biibagiwe kujaana imigaati. <verse eid="MAT 16:5" /><verse number="6" style="v" sid="MAT 16:6" /><note caller="-" style="x"><char style="xo" closed="false">16:6 </char><char style="xt" closed="false"><ref loc="LUK 12:1">Luk 12:1</ref>.</char></note>Yesu arababwira ati, “Murabe maaso, kandi mwirinde umusemburo w'Abafarisaayo n'uw'Abasadukaayo.” <verse eid="MAT 16:6" /><verse number="7" style="v" sid="MAT 16:7" />Bo reero baravugana bati, “Ni uko tutaazanye imigaati.”<verse eid="MAT 16:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 16:8" />Nuuko Yesu amaze kubimenya, arababwira ati, “Mwa beemera gato mwe, kuki muvuga ibyerekeye uko mutaazanye imigaati? <verse eid="MAT 16:8" /><verse number="9" style="v" sid="MAT 16:9" /><note caller="-" style="x"><char style="xo" closed="false">16:9 </char><char style="xt" closed="false"><ref loc="MAT 14:17-21">Mat 14:17-21</ref>.</char></note>Na n'ubu ntimuraasobaanukirwa? Ntimwibuka ya migaati itaanu ku bantu ibihumbi bitaanu, kandi haasigaye ibisobane bingaahe? <verse eid="MAT 16:9" /><verse number="10" style="v" sid="MAT 16:10" /><note caller="-" style="x"><char style="xo" closed="false">16:10 </char><char style="xt" closed="false"><ref loc="MAT 15:34-38">Mat 15:34-38</ref>.</char></note>Cangwa ya migaati irindwi ku bantu ibihumbi bine, kandi haasigaye ibisobane bingaahe? <verse eid="MAT 16:10" /><verse number="11" style="v" sid="MAT 16:11" />Mushobora mute kudasobaanukirwa ko atari imigaati navugaga? Mwirinde imisemburo y'Abafarisaayo n'Abasadukaayo!”<verse eid="MAT 16:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 16:12" />Nuuko basobaanukirwa ko ataababwiraga kwirinda umusemburo w'imigaati, ahuubwo ko ari ukwirinda inyigiisho z'Abafarisaayo n'iz'Abasadukaayo.<verse eid="MAT 16:12" /></para>
  <para style="s1">Peetero Ahamya ko Yesu ari Umwana w'Imaana</para>
  <para style="r">(<ref loc="MRK 8:27-30">Mar 8:27-30</ref>; <ref loc="LUK 9:18-21">Luk 9:18-21</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 16:13" />Nuuko Yesu ageze mu gice c'i Kayisaariya ya Filipo, abaza abiigiishwa be ati, “Abantu bavuga ko Umwana w'Umuntu ari nde?”<verse eid="MAT 16:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 16:14" />
    <note caller="-" style="x">
      <char style="xo" closed="false">16:14 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 14:1">Mat 14:1</ref>,<ref loc="MAT 14:2">2</ref>; <ref loc="MRK 6:14">Mar 6:14</ref>,<ref loc="MRK 6:15">15</ref>; <ref loc="LUK 9:7">Luk 9:7</ref>,<ref loc="LUK 9:8">8</ref>.</char>
    </note>Baramusubiza bati, “Bamwe bavuga ko uri Yohaana Umubatiza, abandi ngo uri Eliya, abandi ngo uri Yeremiya, cangwa ngo uri umwe mu bahanuuzi.”<verse eid="MAT 16:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 16:15" />Yongera kubabaza ati, “Ariko se mwebwe muvuga ko ndi nde?”<verse eid="MAT 16:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 16:16" />
    <note caller="-" style="x">
      <char style="xo" closed="false">16:16 </char>
      <char style="xt" closed="false">
        <ref loc="JHN 6:68">Yoh 6:68</ref>,<ref loc="JHN 6:69">69</ref>.</char>
    </note>Simooni Peetero aramusubiza ati, “Uri Kristo<note caller="+" style="f"><char style="fr" closed="false">16:16 </char><char style="ft" closed="false">Mesiya</char></note>, Umwana w'Imaana nzima!”<verse eid="MAT 16:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 16:17" />Yesu aramubwira ati, “Urahiirwa Simooni mwene Yona! Kuko atari umuntu wabiguhishuuriye, ahuubwo ni Daata uri mu ijuru. <verse eid="MAT 16:17" /><verse number="18" style="v" sid="MAT 16:18" />Kandi ndakubwira, ko uri Peetero kimenyeesha Urutare, kandi kuri urwo rutare ni ho nzubaka Itoorero ryanje, ndetse n'imbaraga z'urupfu ntizizaarishobora. <verse eid="MAT 16:18" /><verse number="19" style="v" sid="MAT 16:19" /><note caller="-" style="x"><char style="xo" closed="false">16:19 </char><char style="xt" closed="false"><ref loc="MAT 18:18">Mat 18:18</ref>; <ref loc="JHN 20:23">Yoh 20:23</ref>.</char></note>Nzaaguha ibishumuruzo by'Ubwami bw'ijuru, kandi ico uzaaboha mu isi, kizaaba kiboshwe no mu ijuru, kandi ico uzaabohoora mu isi kizaaba kibohoowe no mu ijuru.”<verse eid="MAT 16:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 16:20" />Nuuko yihanangiriza abiigiishwa be kutagira uwo babwira ko ari we Kristo.<verse eid="MAT 16:20" /></para>
  <para style="s1">Yesu Avuga ko Azaapfa Akazuuka</para>
  <para style="r">(<ref loc="MRK 8:3-9:1">Mar 8:3—9:1</ref>; <ref loc="LUK 9:22-27">Luk 9:22-27</ref>)</para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 16:21" />Uheereye ubwo, Yesu atangira kumenyeesha abiigiishwa be ko ari ngombwa kuja i Yerusaalemu, akababazwa caane n'abakuru b'imiryango n'abatware b'abaheerezabitambo n'Abiigiishamategeko, bakamwica, maze ku munsi wa gatatu akazuurwa.<verse eid="MAT 16:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 16:22" />Nuuko Peetero aramwihereerana maze atangira kumucaaha ati, “Ibyo biragatsindwa, Nyagasani! Ibi ntibikakubeho.”<verse eid="MAT 16:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 16:23" />Ariko we arahinduka maze abwira Peetero ati, “Mva iruhande Sataani! Umbereye igisiitaaza, kuko ibiteekerezo byawe bitavuuye ku Maana ahuubwo ni iby'abantu.”<verse eid="MAT 16:23" /></para>
  <para style="s1">Umusaraba no Kwiyanga</para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 16:24" />
    <note caller="-" style="x">
      <char style="xo" closed="false">16:24 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 10:38">Mat 10:38</ref>; <ref loc="LUK 14:27">Luk 14:27</ref>.</char>
    </note>Nuuko Yesu abwira abiigiishwa be ati, “Niiba hari ushaaka kunkurikira, niyiyange maze aheeke umusaraba we ankurikire. <verse eid="MAT 16:24" /><verse number="25" style="v" sid="MAT 16:25" /><note caller="-" style="x"><char style="xo" closed="false">16:25 </char><char style="xt" closed="false"><ref loc="MAT 10:39">Mat 10:39</ref>; <ref loc="LUK 17:33">Luk 17:33</ref>; <ref loc="JHN 12:25">Yoh 12:25</ref>.</char></note>Kuko abashaaka gukiza ubugingo bwabo bazaabubura, naho uzaabura ubugingo bwe ku bwanje azaabubona. <verse eid="MAT 16:25" /><verse number="26" style="v" sid="MAT 16:26" />Umuntu byamumarira iki gutunga ibintu byose byo mu isi ariko agataakaza ubugingo bwe? Cangwa se ubugingo bw'umuntu yabugurana iki? <verse eid="MAT 16:26" /><verse number="27" style="v" sid="MAT 16:27" /><note caller="-" style="x"><char style="xo" closed="false">16:27 a </char><char style="xt" closed="false"><ref loc="MAT 25:31">Mat 25:31</ref>; </char><char style="xo" closed="false">b </char><char style="xt" closed="false"><ref loc="ROM 2:6">Rom 2:6</ref>.</char></note>Kuko Umwana w'Umuntu agiiye kuuzaagarukana n'abaamalayika be ari mu ikuzo rya Se, maze agororere umuntu weese akurikije ibyo yakoze. <verse eid="MAT 16:27" /><verse number="28" style="v" sid="MAT 16:28" />Ndababwira ukuri yuuko, hari bamwe bahagaze hano batazaapfa bataboonye Umwana w'Umuntu aziye mu cuubahiro c'Ubwami bwe.”<verse eid="MAT 16:28" /></para>
  <chapter eid="MAT 16" />
  <chapter number="17" style="c" sid="MAT 17" />
  <para style="s1">Ishusho ya Yesu Ihinduka Ukundi</para>
  <para style="r">(<ref loc="MRK 9:2-13">Mar 9:2-13</ref>; <ref loc="LUK 9:28-36">Luk 9:28-36</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 17:1" />Hashize iminsi itandatu, Yesu ajaana na Peetero, na Yaakobo na mwene nyina Yohaana maze abajaana ku mpinga y'umusozi mureemure, bonyine. <verse eid="MAT 17:1" /><verse number="2" style="v" sid="MAT 17:2" />Nuuko ishusho ye ihinduka ukundi imbere yaabo, mu maaso he harabagirana nk'izuuba, n'imyambaro ye ireererana. <verse eid="MAT 17:2" /><verse number="3" style="v" sid="MAT 17:3" />Muri ako kaanya Moose na Eliya barababonekera, bavugana na Yesu. <verse eid="MAT 17:3" /><verse number="4" style="v" sid="MAT 17:4" />Nuuko Peetero abwira Yesu ati, “Nyagasani, ni byiza ko twibeera hano. Nuubishaaka, ngiiye<note caller="+" style="f"><char style="fr" closed="false">17:4 </char><char style="ft" closed="false">Mu bindi byanditswe byera hakoreeshwa </char><char style="fqa" closed="false">tugiiye </char></note> kuubaka ibiraaro<note caller="+" style="f"><char style="fr" closed="false">17:4 </char><char style="fqa" closed="false">Amahema </char></note> bitatu hano, kimwe caawe, ikindi ca Moose, n'ikindi ca Eliya.”<verse eid="MAT 17:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 17:5" />
    <note caller="-" style="x">
      <char style="xo" closed="false">17:5 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 3:17">Mat 3:17</ref>; <ref loc="MAT 12:18">12:18</ref>; <ref loc="MRK 1:11">Mar 1:11</ref>; <ref loc="LUK 3:22">Luk 3:22</ref>.</char>
    </note>
    <note caller="-" style="x">
      <char style="xo" closed="false">17:5 </char>
      <char style="xt" closed="false">
        <ref loc="2PE 1:17">2Pet 1:17</ref>,<ref loc="2PE 1:18">18</ref>.</char>
    </note>Akivuga, igicu kibengerana kirababundikira, maze muri ico gicu havamo ijwi rivuga riti, “Uyu ni Umwana wanje nkunda caane, nimumwumvire!”<verse eid="MAT 17:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 17:6" />Abiigiishwa babyumviise, biituura haasi buubamye, bagira ubwoba bwinshi caane. <verse eid="MAT 17:6" /><verse number="7" style="v" sid="MAT 17:7" />Ariko Yesu araaza abafataho, arababwira ati, “Muhaguruke, mwigira ubwoba.” <verse eid="MAT 17:7" /><verse number="8" style="v" sid="MAT 17:8" />Buubuuye amaaso, ntihaagira undi babona keretse Yesu wenyine.<verse eid="MAT 17:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 17:9" />Bakimanuka umusozi, Yesu arabiihanangiriza ati, “Ntimugire uwo mubwira ibyo mumaze kwerekwa, kugeza aho Umwana w'Umuntu azaaba amaze kuzuuka mu baapfuuye.”<verse eid="MAT 17:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 17:10" />Nuuko abiigiishwa baramubaza bati, “Kuki Abiigiishamategeko bavuga ko Eliya ari we ugomba kubanza kuuza?”<verse eid="MAT 17:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 17:11" />Arabasubiza ati, “Ni koko Eliya akwiriye kubanza kuuza kandi agatungaanya ibintu byose, <verse eid="MAT 17:11" /><verse number="12" style="v" sid="MAT 17:12" /><note caller="-" style="x"><char style="xo" closed="false">17:12 </char><char style="xt" closed="false"><ref loc="MAT 11:14">Mat 11:14</ref>.</char></note>ariko ndababwira yuuko Eliya yaaje ntibamumenye, ahuubwo bamugirira naabi uko biishaakiye. Uko ni ko n'Umwana w'Umuntu bagiiye kumubabaza.”<verse eid="MAT 17:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 17:13" />Nuuko abiigiishwa bamenya ko uwo yavugaga ari Yohaana Umubatiza.<verse eid="MAT 17:13" /></para>
  <para style="s1">Yesu Akiza Umuhungu Uteewe na Dayimooni</para>
  <para style="r">(<ref loc="MRK 9:14-29">Mar 9:14-29</ref>; <ref loc="LUK 9:37-43a">Luk 9:37-43a</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 17:14" />Bageze ku bantu benshi, umugabo yegeera Yesu, aramupfukamira, <verse eid="MAT 17:14" /><verse number="15" style="v" sid="MAT 17:15" />maze aramubwira ati, “Nyagasani, girira umuhungu wanje imbabazi, kuko arwaye igicuri kikaba kimubabaza caane. Akunda kugwa mu muriro ndetse no mu maazi. <verse eid="MAT 17:15" /><verse number="16" style="v" sid="MAT 17:16" />Namuuzaniye abiigiishwa baawe, ariko ntibaashobora kumukiza.”<verse eid="MAT 17:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 17:17" />Yesu aramusubiza ati, “Yemwe bantu b'iki gihe batiizeera kandi baayobye, nzabaana namwe kugeza ryari? Nzabiihanganira kugeza ryari? Nimumunzanire hano.” <verse eid="MAT 17:17" /><verse number="18" style="v" sid="MAT 17:18" />Yesu acaaha ya dayimooni, maze imuvamo, umuhungu aheerako arakira.<verse eid="MAT 17:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 17:19" />Nuuko abiigiishwa biihereerana Yesu, baramubaza bati, “Kuki twebwe tutaashoboye kuyiirukana?”<verse eid="MAT 17:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 17:20" />
    <note caller="-" style="x">
      <char style="xo" closed="false">17:20 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 21:21">Mat 21:21</ref>; <ref loc="MRK 11:23">Mar 11:23</ref>; <ref loc="1CO 13:2">1 Kor 13:2</ref>.</char>
    </note>Arababwira ati, “Ni ku bwo kwizeera kwanyu guke. Ndababwira ukuri, iyo ufite kwizeera naaho kwangana n'akabuto gato kitwa sinaapi, mwabwira uyu musozi muti, ‘Va hano uje hariiya,’ maze ukahaja, kandi ntaakizaabananira.<verse eid="MAT 17:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 17:21" />
    <note caller="+" style="f">
      <char style="fr" closed="false">17:21 </char>
      <char style="ft" closed="false">Ibyanditswe byera bimwe ntibifite uyu murongo</char>
    </note>Ariko dayimooni nkiiyi ntishoborwa n'ikindi keretse gusenga no gusiiba.”<verse eid="MAT 17:21" /></para>
  <para style="s1">Yesu Yongera Kuvuga ko Azaapfa kandi Akazuuka</para>
  <para style="r">(<ref loc="MRK 9:30-32">Mar 9:30-32</ref>; <ref loc="LUK 9:43b-45">Luk 9:43b-45</ref>)</para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 17:22" />Igihe abiigiishwa baari bateeraniye i Galileeya, Yesu arababwira ati, “Umwana w'Umuntu agiiye kugambanirwa kandi agabizwe abantu, <verse eid="MAT 17:22" /><verse number="23" style="v" sid="MAT 17:23" />maze bamwice, ariko ku munsi wa gatatu azuurwe.” Nuuko bagira agahinda kenshi.<verse eid="MAT 17:23" /></para>
  <para style="s1">Gutanga Umusoro w'Inzu y'Imaana</para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 17:24" />Ubwo baari bageze i Kaperenawumu, abasoreesha b'umusoro w'Inzu y'Imaana basanga Peetero maze baramubaza bati, “Mbese umwigiisha waanyu atanga umusoro w'Inzu y'Imaana?”<verse eid="MAT 17:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 17:25" />Na we aramusubiza ati, “Yee, arawutanga.”</para>
  <para style="p" vid="MAT 17:25">Peetero yinjiye mu nzu, Yesu ni co yabanje kuvugaho, aramubaza ati, “Urateekereza iki Simooni? Ni bande bo abaami b'isi basaba imisoro cangwa amasoko? N'abaturage cangwa ni abanyamahanga?”<verse eid="MAT 17:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 17:26" />Peetero arasubiza ati, “Ni abanyamahanga.”</para>
  <para style="p" vid="MAT 17:26">Yesu aramubwira ati, “Nooneho reero abatuurage ntibagomba gusoreeshwa. <verse eid="MAT 17:26" /><verse number="27" style="v" sid="MAT 17:27" />Ariko, kugira ngo tutabaraakaza, ja ku nyanja ujugunyemo ururobo, isamaaki ya mbere uri bufate, uyaasamure, uribusangemo igiceri, ukijaane ukibahe nk'umusoro w'Inzu y'Imaana ku bwawe nanje.”<verse eid="MAT 17:27" /></para>
  <chapter eid="MAT 17" />
  <chapter number="18" style="c" sid="MAT 18" />
  <para style="s1">Umukuru Uruta Abandi</para>
  <para style="r">(<ref loc="MRK 9:33-37">Mar 9:33-37</ref>; <ref loc="LUK 9:46-48">Luk 9:46-48</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 18:1" />
    <note caller="-" style="x">
      <char style="xo" closed="false">18:1 </char>
      <char style="xt" closed="false">
        <ref loc="LUK 22:24">Luk 22:24</ref>.</char>
    </note>Ico gihe abiigiishwa beegeera Yesu baramubaza bati, “Umukuru mu Bwami bwo mu ijuru ni nde?” <verse eid="MAT 18:1" /><verse number="2" style="v" sid="MAT 18:2" />Ahamagara umwana muto, amushira hagati yaabo <verse eid="MAT 18:2" /><verse number="3" style="v" sid="MAT 18:3" /><note caller="-" style="x"><char style="xo" closed="false">18:3 </char><char style="xt" closed="false"><ref loc="MRK 10:15">Mar 10:15</ref>; <ref loc="LUK 18:17">Luk 18:17</ref>.</char></note>maze arababwira ati, “Ndababwira ukuri, nimudahinduka ngo mube nk'abaana bato, ntaabwo muzinjira mu Bwami bw'ijuru. <verse eid="MAT 18:3" /><verse number="4" style="v" sid="MAT 18:4" />Uwiiciisha bugufi nk'uyu mwana ni we uruta abandi mu Bwami bwo mu ijuru. <verse eid="MAT 18:4" /><verse number="5" style="v" sid="MAT 18:5" />Uwaakiira umwana muto nk'uyu mu izina ryanje, aba ari nje yaakiiriye.<verse eid="MAT 18:5" /></para>
  <para style="s1">Ibituma Abantu Bacumura</para>
  <para style="r">(<ref loc="MRK 9:42-48">Mar 9:42-48</ref>; <ref loc="LUK 17:1-2">Luk 17:1-2</ref>)</para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 18:6" />Nihagira uwo muri mwe ucumuza umwe muri aba bato banyiizeera, iciiza ni uko baahambiira urusyo runini ku ijosi rye maze akarohwa mu nyanja hagati. <verse eid="MAT 18:6" /><verse number="7" style="v" sid="MAT 18:7" />Abo ku isi baguushije ishano ku bw'imitego ibaguusha mu byaha! Ibiguusha abantu mu byaha ntibyabura kubaho, ariko umuntu ubiteera azaabona ishano!<verse eid="MAT 18:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 18:8" />
    <note caller="-" style="x">
      <char style="xo" closed="false">18:8 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 5:30">Mat 5:30</ref>.</char>
    </note>Niiba ikiganza caawe cangwa ikirenge caawe biguteera gukora icaaha, biceho ubijugunye kure yaawe. Iciiza ni uko waakwinjira mu bugingo buhoraho nta kiganza cangwa ikirenge ufite, aho kugira ibiganza bibiri n'ibirenge bibiri maze ukajugunywa mu muriro utazima. <verse eid="MAT 18:8" /><verse number="9" style="v" sid="MAT 18:9" /><note caller="-" style="x"><char style="xo" closed="false">18:9 </char><char style="xt" closed="false"><ref loc="MAT 5:29">Mat 5:29</ref>.</char></note>Kandi ijiisho ryawe niriguteera gukora icaaha, urinogooremo maze urijugunye kure yaawe. Nibyiza ko waakwinjira mu bugingo buhoraho n'ijiisho rimwe aho kugira amaaso abiri ukajugunywa mu muriro utazima.<verse eid="MAT 18:9" /></para>
  <para style="s1">Umugani w'Intaama ya Zimiye</para>
  <para style="r">(<ref loc="LUK 15:3-7">Luk 15:3-7</ref>)</para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 18:10" />
    <note caller="-" style="x">
      <char style="xo" closed="false">18:10 </char>
      <char style="xt" closed="false">
        <ref loc="LUK 19:10">Luk 19:10</ref>.</char>
    </note>Mwirinde mudasuuzuugura umwe muri abo baana bato. Ndababwira yuuko, abaamalayika baabo bo mu ijuru bahora imbere ya Daata wo mu ijuru. <verse eid="MAT 18:10" /><verse number="11" style="v" sid="MAT 18:11" /><note caller="+" style="f"><char style="fr" closed="false">18:11 </char><char style="ft" closed="false">Mu bindi byanditswe byera bimwe ntibongeraho uyu murongo. </char></note> Kuko Umwana w'Umuntu yaaje gukiza abaazimiye.<verse eid="MAT 18:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 18:12" />Mwebwe murabivugaho iki? Niiba umuntu afite intaama ijana, maze imwe muri zo ikazimira, ntaabwo asiga za zindi mirongo cenda n'icenda ku musozi maze akaja gushaaka iyazimiye? <verse eid="MAT 18:12" /><verse number="13" style="v" sid="MAT 18:13" />Kandi ndababwira ukuri yuuko iyo ayiboonye, arayiishiimira caane kuruta za mirongo cenda n'icenda zitaazimiye. <verse eid="MAT 18:13" /><verse number="14" style="v" sid="MAT 18:14" />Noone reero ni na ko So<note caller="+" style="f"><char style="fr" closed="false">18:14 </char><char style="ft" closed="false">Ibindi byanditswe byerekana </char><char style="fqa" closed="false">Daata </char></note> wo mu ijuru adashaaka ko hagira n'umwe muri aba bato uzimira.<verse eid="MAT 18:14" /></para>
  <para style="s1">Guhana Umuvandimwe Wacumuye</para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 18:15" />
    <note caller="-" style="x">
      <char style="xo" closed="false">18:15 </char>
      <char style="xt" closed="false">
        <ref loc="LUK 17:3">Luk 17:3</ref>.</char>
    </note>Niiba umuvandimwe mu itoorero agushobereje<note caller="+" style="f"><char style="fr" closed="false">18:15 </char><char style="ft" closed="false">Ibindi byanditswe byerekana </char><char style="fqa" closed="false">ashobeje </char></note>, musange maze umusobaanurire inshobe ye mwihereereye. Aramutse yumviise ko yashobeje, uzaaba wiigarurije uwo muvandimwe. <verse eid="MAT 18:15" /><verse number="16" style="v" sid="MAT 18:16" />Ariko naateemera ko yagushobereje, jaana n'undi muntu umwe cangwa babiri, kugira ngo babihamye bari babiri cangwa batatu. <verse eid="MAT 18:16" /><verse number="17" style="v" sid="MAT 18:17" />Uwo muvandimwe niyanga kubumva, ubibwire itoorero, kandi naaramuka yanze no kumva itoorero, umujaane nk'aho ari umunyamahanga cangwa umusoreesha.<verse eid="MAT 18:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 18:18" />
    <note caller="-" style="x">
      <char style="xo" closed="false">18:18 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 16:19">Mat 16:19</ref>; <ref loc="JHN 20:23">Yoh 20:23</ref>.</char>
    </note>Ndababwira ukuri yuuko, ibyo muzaaboha mu isi bizaaba biboshwe no mu ijuru, kandi ibyo muzaabohoora mu isi bizaaba bibohoowe no mu ijuru.<verse eid="MAT 18:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 18:19" />Ndongera kubabwira ukuri, iyo babiri muri mwe ku isi beemeranyije ico basaba, bazaagihaabwa na Daata wo mu ijuru. <verse eid="MAT 18:19" /><verse number="20" style="v" sid="MAT 18:20" />Kuko aho babiri cangwa batatu bateeraniye hamwe mu izina ryanje, mba ndi hagati yaabo.”<verse eid="MAT 18:20" /></para>
  <para style="s1">Umugani w'Umugaragu Utababarira</para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 18:21" />
    <note caller="-" style="x">
      <char style="xo" closed="false">18:21 </char>
      <char style="xt" closed="false">
        <ref loc="LUK 17:3">Luk 17:3</ref>,<ref loc="LUK 17:4">4</ref>.</char>
    </note>Nuuko Peetero yegeera Yesu maze aramubaza ati, “Nyagasani, umuvandimwe wanje mu itoorero akomeje kunshobereza, nkwiriye kumubabarira kangahe? Nzageze karindwi?”<verse eid="MAT 18:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 18:22" />Yesu aramusubiza ati, “Oya, ntaabwo ari karindwi, ahuubwo ndakubwira ko ari mirongo irindwi, karindwi. <verse eid="MAT 18:22" /><verse number="23" style="v" sid="MAT 18:23" />Ku bw'iyo mpamvu, Ubwami bwo mu ijuru bwagereranywa n'umwami washaatse ko abagaragu be bakuru bamumurikira ibintu bye. <verse eid="MAT 18:23" /><verse number="24" style="v" sid="MAT 18:24" />Atangiye kumurikiisha, bamuuzanira umwe mu bagaragu wari umurimo Italanta ibihumbi icumi. <verse eid="MAT 18:24" /><verse number="25" style="v" sid="MAT 18:25" />Kuko yananiwe kwishura, sheebuja ategeka ko yaguriishwa, hamwe n'umugore we n'abaana be n'ibyo atunze byose, kugira ngo umwenda wishurwe. <verse eid="MAT 18:25" /><verse number="26" style="v" sid="MAT 18:26" />Nuuko wa mugaragu aramupfukamira maze aramwinginga ati, ‘Nyihangaanira, nzaakwishura byose.’ <verse eid="MAT 18:26" /><verse number="27" style="v" sid="MAT 18:27" />Kubw'impuhwe yamugiriye, sheebuja wa wamugaragu aramurekura kandi amubabarira na wa mwenda we.<verse eid="MAT 18:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 18:28" />Ariko wa mugaragu agisohoka, ahuura n'umugaragu mugenzi we wari umurimo idinaari ijana, nuuko amutunga umunigo, amubwira ati, ‘Nyishura umwenda wanje.’ <verse eid="MAT 18:28" /><verse number="29" style="v" sid="MAT 18:29" />Umugaragu mugenzi we aramupfukamira amusaba imbabazi ati, ‘Nyihangaanira, nzaakwishura.’ <verse eid="MAT 18:29" /><verse number="30" style="v" sid="MAT 18:30" />Ariko aranga, maze aragenda amushira mu gihome kugeza aho aziishurira umwenda we. <verse eid="MAT 18:30" /><verse number="31" style="v" sid="MAT 18:31" />Abagaragu bagenzi baabo baboonye ibibaaye birabababaza caane, nuuko ni ko kuja kwa sheebuja bamubwira ibyabaaye byose. <verse eid="MAT 18:31" /><verse number="32" style="v" sid="MAT 18:32" />Maze sheebuja atumiisha kuri wa mugaragu nuuko aramubwira ati, ‘Yeewe mugaragu mubi we! Nakubabariye umwenda waawe woose kuko wansabye imbabazi, <verse eid="MAT 18:32" /><verse number="33" style="v" sid="MAT 18:33" />wowe ntugomba kuba wababariye umugaragu mugenzi waawe, nk'uko nanje naakubabariye?’ <verse eid="MAT 18:33" /><verse number="34" style="v" sid="MAT 18:34" />Nuuko sheebuja araraakara maze amuheereza abasirikare bo kumubabaza kugeza igihe azaarangiriza kwishura umwenda we woose.<verse eid="MAT 18:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="MAT 18:35" />Uko ni ko Daata wo mu ijuru azaabagirira, nimutababarira abavandimwe baanyu mubikuuye ku mutima.”<verse eid="MAT 18:35" /></para>
  <chapter eid="MAT 18" />
  <chapter number="19" style="c" sid="MAT 19" />
  <para style="s1">Inyigiisho Yeerekeye Gutandukana kw'abaashaakanye</para>
  <para style="r">(<ref loc="MRK 10:1-12">Mar 10:1-12</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 19:1" />Yesu arangije kuvuga aya magambo, ava i Galileeya aja mu gihugu ca Yudeeya hiirya ya Yorodaani. <verse eid="MAT 19:1" /><verse number="2" style="v" sid="MAT 19:2" />Abantu benshi baramukurikira, maze abakirizayo.<verse eid="MAT 19:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 19:3" />Bamwe mu Bafarisaayo baramwegeera, maze kugira ngo bamugerageze baramubaza bati, “Mbese bireemewe ko umugabo yiirukana umugore we ku mpamvu ibonetse yoose?”<verse eid="MAT 19:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 19:4" />Arabasubiza ati, “Ntimwari mwasoma yuuko mu ntangiriro Rurema yabaremye nk'umugabo n'umugore, <verse eid="MAT 19:4" /><verse number="5" style="v" sid="MAT 19:5" />kandi akavuga ati, ‘Ni co gituma umugabo azaasiga se na nyina akabaana n'umugore we nuuko bombi bakaba umubiri umwe’? <verse eid="MAT 19:5" /><verse number="6" style="v" sid="MAT 19:6" />Noone baba batakiri babiri, ahuubwo baba babaaye umubiri umwe. Bityo reero ico Imaana yafatanyije, ntihakagire ugitandukanya.”<verse eid="MAT 19:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 19:7" />
    <note caller="-" style="x">
      <char style="xo" closed="false">19:7 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 5:31">Mat 5:31</ref>.</char>
    </note>Baramubaza bati, “Noone se kuki Moose yategetse ko umugabo akwiriye gutanga urwandiko rwo kwirukana umugore we maze bakabona gutandukana?”<verse eid="MAT 19:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 19:8" />Arabasubiza ati, “N'imitima yaanyu ikomeye kwigiisha yatumye Moose abeemerera kwirukana abagore baanyu, ariko si ko byahoze kuva kare. <verse eid="MAT 19:8" /><verse number="9" style="v" sid="MAT 19:9" /><note caller="-" style="x"><char style="xo" closed="false">19:9 </char><char style="xt" closed="false"><ref loc="MAT 5:32">Mat 5:32</ref>; <ref loc="1CO 7:10">1 Kor 7:10</ref>,<ref loc="1CO 7:11">11</ref>.</char></note>Kandi ndababwira ko, umuntu weese wiirukana umugore we, bitavuuye kubusambanyi, maze akaazana undi aba asambanye.”<note caller="+" style="f"><char style="fr" closed="false">19:9 </char><char style="ft" closed="false">Ibindi byaditswe byera byerekana </char><char style="fqa">Keretse biteewe no kutiizeerwa, bigatuma asambana.</char> Ibindi byongera ku mpera y'umurongo ngo, <char style="fqa" closed="false">Kandi urongora umugore wavuuye mu nzu aba asambanye.</char></note><verse eid="MAT 19:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 19:10" />Abiigiishwa baramubwira bati, “Niiba iby'umugabo n'umugore ariko bimeze, icaaruta ni ukutarongora.”<verse eid="MAT 19:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 19:11" />Ariko arasubiza ati, “Ntaabwo ari buri muntu wakwemera iyi nyigiisho, keretse abo baabihaawe bonyine. <verse eid="MAT 19:11" /><verse number="12" style="v" sid="MAT 19:12" />Hariho abataarongora kuko baavuutse ari ibiremba, hariho n'abandi bataarongora kuko bagizwe inkone n'abandi bantu, hari n'abandi bahitamo kutarongora ku bw'Ubwami bw'ijuru. Ushobora kumva ni yumve iyi nyigiisho.”<verse eid="MAT 19:12" /></para>
  <para style="s1">Yesu aha Umugiisha Abaana Bato</para>
  <para style="r">(<ref loc="MRK 10:13-16">Mar 10:13-16</ref>; <ref loc="LUK 18:15-17">Luk 18:15-17</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 19:13" />Nuuko hagira abantu baazanira Yesu abaana bato ngo abarambikeho ibiganza maze abasabire. Abiigiishwa bakabukira abaari babaazanye, <verse eid="MAT 19:13" /><verse number="14" style="v" sid="MAT 19:14" />ariko Yesu arababwira ati, “Mureke abaana bato bansange, ntimubabuze, kuko Ubwami bw'ijuru ari ubw'abameze nk'abo.”<verse eid="MAT 19:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 19:15" />Nuuko abarambikaho ibiganza maze aragenda.<verse eid="MAT 19:15" /></para>
  <para style="s1">Umusore w'Umukire</para>
  <para style="r">(<ref loc="MRK 10:17-31">Mar 10:17-31</ref>; <ref loc="LUK 18:18-30">Luk 18:18-30</ref>)</para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 19:16" />Nuuko umuntu asanga Yesu maze aramubaza ati, “Mwigiisha, n'ikihe kintu ciiza naakora kugira ngo mbone ubugingo buhoraho?”<verse eid="MAT 19:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 19:17" />Yesu aramusubiza ati, “Ni kuki umbaza ikiri ciiza? Umwiza ni umwe gusa. Ariko niiba ushaaka kwinjira mu bugingo, kurikiza amategeko.”<verse eid="MAT 19:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 19:18" />Wa musore aramubaza ati, “Ni ayahe?”</para>
  <para style="p" vid="MAT 19:18">Yesu aramusubiza ati, “Ntuukiice, ntuugasambane, ntuukiibe, ntuugashinje abandi ibinyoma, <verse eid="MAT 19:18" /><verse number="19" style="v" sid="MAT 19:19" />Uje wubaha so na nyoko kandi uje ukunda mugenzi waawe nk'uko wikunda.”<verse eid="MAT 19:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 19:20" />Wa musore aramubwira ati, “Ibyo byose narabikurikije,<note caller="+" style="f"><char style="fr" closed="false">19:20 </char><char style="ft" closed="false">Mu bindi byanditswe bongeraho </char><char style="fqa" closed="false">kuva mu busore bwanje.</char></note> noone ico nshigaje ni iki?”<verse eid="MAT 19:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 19:21" />Yesu aramusubiza ati, “Niiba ushaaka kuba intungaane, genda uguriishe ibyo utunze byose, maze ibivuuyemo ubihe abakene, ni bwo uzaagira ubutunzi mu ijuru, uheereko uze unkurikire.”<verse eid="MAT 19:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 19:22" />Uwo musore yumviise iryo jambo, agenda ababaye, kuko yari afite ubutunzi bwinshi caane.<verse eid="MAT 19:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 19:23" />Nuuko Yesu abwira abiigiishwa be ati, “Ndababwira ukuri, birakomeye kugira ngo umukire yinjire mu Bwami bwo mu ijuru. <verse eid="MAT 19:23" /><verse number="24" style="v" sid="MAT 19:24" />Ndongera kubabwira yuuko byoroheye ingamiya kunyura mu gapfumure k'urusindaani, kuruta ko umukire yakwinjira mu Bwami bw'Imaana.”<verse eid="MAT 19:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 19:25" />Abiigiishwa babyumviise, baratangaara maze baramubaza bati, “Noone se, ni nde ushobora kurokoka?”<verse eid="MAT 19:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 19:26" />Yesu arabiitegereza maze arababwira ati, “Ku bantu ntibishoboka, ariko ku Maana byose birashoboka.”<verse eid="MAT 19:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 19:27" />Peetero aramubaza ati, “Dore twebwe twasize ibyacu byose turagukurikira, noone se tuzaabyungukiramo iki?”<verse eid="MAT 19:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 19:28" />
    <note caller="-" style="x">
      <char style="xo" closed="false">19:28 a </char>
      <char style="xt" closed="false">
        <ref loc="MAT 25:31">Mat 25:31</ref>; </char>
      <char style="xo" closed="false">b </char>
      <char style="xt" closed="false">
        <ref loc="LUK 22:30">Luk 22:30</ref>.</char>
    </note>Yesu arababwira ati, “Ndababwira ukuri yuuko igihe Umwana w'Umuntu azaazira, akiicara ku ntebe ye y'icuubahiro mu isi nsha, mwebwe mwankurikiye muziicara ku ntebe cumi n'ebyiri nuuko mutegeke imiryango cumi n'ebyiri y'Abiisirayeli. <verse eid="MAT 19:28" /><verse number="29" style="v" sid="MAT 19:29" />Maze umuntu weese wasize amazu, cangwa beene se, cangwa bashiki be, cangwa se, cangwa nyina, cangwa abaana, cangwa imirima ku bw'izina ryanje, azaahaabwa nka byo inshuro ijana, kandi ahaabwe n'ubugingo buhoraho. <verse eid="MAT 19:29" /><verse number="30" style="v" sid="MAT 19:30" /><note caller="-" style="x"><char style="xo" closed="false">19:30 </char><char style="xt" closed="false"><ref loc="MAT 20:16">Mat 20:16</ref>; <ref loc="LUK 13:30">Luk 13:30</ref>.</char></note>Ariko abenshi baari abambere bazaaba abaanyuma, kandi abaanyuma babe abambere.”<verse eid="MAT 19:30" /></para>
  <chapter eid="MAT 19" />
  <chapter number="20" style="c" sid="MAT 20" />
  <para style="s1">Abakozi bo mu Mizaabibu</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 20:1" />Yesu akomeza kubabwira ati, “Ubwami bwo mu ijuru bwagereranywa na nyir'umurima wazindutse kare mu gitondo gushaaka abakozi bo gukorera imizaabibu ye. <verse eid="MAT 20:1" /><verse number="2" style="v" sid="MAT 20:2" />Amaze kwemeranya na bo igihembo gikwiye umubyizi w'umunsi,<note caller="+" style="f"><char style="fr" closed="false">20:2 </char><char style="ft" closed="false">Idinaari</char></note> aboohereza mu murima we w'imizaabibu. <verse eid="MAT 20:2" /><verse number="3" style="v" sid="MAT 20:3" />Asohotse nko ku saaha itatu, abona abandi biihagarariye mu guriro ntaaco bakora, <verse eid="MAT 20:3" /><verse number="4" style="v" sid="MAT 20:4" />maze na bo arababwira ati, ‘Namwe muje mu mizaabibu, ndibubiishure igihembo gikwiriye.’ <verse eid="MAT 20:4" /><verse number="5" style="v" sid="MAT 20:5" />Yongeye gusohoka nka saaha itandatu na saaha icenda, na bwo abigenza atyo. <verse eid="MAT 20:5" /><verse number="6" style="v" sid="MAT 20:6" />Nka saaha icumi n'imwe nabwo arasohoka maze asanga abandi bahagaze, arababaza ati, ‘Kuki mwahagaze aho ntaaco mukora umunsi woose?’ <verse eid="MAT 20:6" /><verse number="7" style="v" sid="MAT 20:7" />Baramusubiza bati, ‘Ni uko ntaawe twaboonye wo kuduteereza.’ Arababwira ati, ‘Namwe nimuje gukora mu mizaabibu.’ <verse eid="MAT 20:7" /><verse number="8" style="v" sid="MAT 20:8" />Bugoroobye, nyir'umurima abwira umukoreesha ati, ‘Hamagara abakozi maze ubiishure, uheereye ku baaje nyuma kugeza ku baaje mbere.’ <verse eid="MAT 20:8" /><verse number="9" style="v" sid="MAT 20:9" />Abaateerejwe ku saaha cumi n'imwe baaje, buri umwe muri bo yiishuwe igihembo c'umubyizi w'umunsi cuzuye. <verse eid="MAT 20:9" /><verse number="10" style="v" sid="MAT 20:10" />Aba mbere baaje, baateekerezaga ko bari buhembwe ibirenzeho, ariko na bo buri umwe yiishuwe ibingana n'umubyizi w'umunsi. <verse eid="MAT 20:10" /><verse number="11" style="v" sid="MAT 20:11" />Bamaze kubibona, biitotombera nyir'imizaabibu, <verse eid="MAT 20:11" /><verse number="12" style="v" sid="MAT 20:12" />bavuga bati, ‘Aba ba nyuma baakoze isaaha imwe yoonyine, noone ubanganyije naatwe twiriwe dukoboka umunsi woose duhangana n'izuuba!’<verse eid="MAT 20:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 20:13" />Ariko we asubiza umwe muri bo ati, ‘Nshuti yanje, sinkugiriye naabi, ntitwemeranyije igihembo c'umubyizi w'umunsi? <verse eid="MAT 20:13" /><verse number="14" style="v" sid="MAT 20:14" />Fata ikiri icaawe maze ugende, mpisemo kwishura uwaaje nyuma igihembo kingana n'icaawe. <verse eid="MAT 20:14" /><verse number="15" style="v" sid="MAT 20:15" />Mbese ntaabwo mfite uburenganzira bwo gukoreesha amashilingi yanje? Cangwa se, ugize ishari kuko ndi umunyabuntu?’ <verse eid="MAT 20:15" /><verse number="16" style="v" sid="MAT 20:16" /><note caller="-" style="x"><char style="xo" closed="false">20:16 </char><char style="xt" closed="false"><ref loc="MAT 19:30">Mat 19:30</ref>; <ref loc="MRK 10:31">Mar 10:31</ref>; <ref loc="LUK 13:30">Luk 13:30</ref>.</char></note>Noone reero abaanyuma bazaaba aba mbere, kandi n'abambere bazaaba abaanyuma.”<note caller="+" style="f"><char style="fr" closed="false">20:16 </char><char style="ft" closed="false">Ibindi byanditswe byera bimwe byongeraho </char><char style="fqa" closed="false">Kuko hahamagarwa benshi ariko hagatooranywa bake. </char></note><verse eid="MAT 20:16" /></para>
  <para style="s1">Yesu Avuga ku Rupfu rwe ubwa Gatatu</para>
  <para style="r">(<ref loc="MRK 10:32-34">Mar 10:32-34</ref>; <ref loc="LUK 18:31-34">Luk 18:31-34</ref>)</para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 20:17" />Ubwo Yesu yazaamuukaga aja i Yerusaalemu, yihereerana abiigiishwa be cumi na babiri, kandi ababwirira mu nzira ati, <verse eid="MAT 20:17" /><verse number="18" style="v" sid="MAT 20:18" />“Dore turazaamuuka tuja i Yerusaalemu, kandi Umwana w'Umuntu agiiye kugabizwa abatware b'abaheerezabitambo n'Abiigiishamategeko, maze bamuciire urubanza rwo gupfa. <verse eid="MAT 20:18" /><verse number="19" style="v" sid="MAT 20:19" />Bazaamugabiza abanyamahanga kugira ngo bamushinyagurire, bamukubite maze bamubambe ku musaraba, ariko ku munsi wa gatatu azaazuurwe.”<verse eid="MAT 20:19" /></para>
  <para style="s1">Gusaba kwa Nyina wa Yaakobo na Yohaana</para>
  <para style="r">(<ref loc="MRK 10:35-45">Mar 10:35-45</ref>)</para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 20:20" />Nuuko nyina w'abahungu ba Zebedaayo asanga Yesu ari n'abahungu be, aramupfukamira, maze amusaba ubutoni.<verse eid="MAT 20:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 20:21" />Yesu aramubaza ati, “Urashaaka iki?” Na we aramusubiza ati, “Naagusabaga ngo abahungu banje babiri baziicare mu Bwami bwawe, umwe mu kuboko kwa buryo undi mu kuboko kwa bumoso.”<verse eid="MAT 20:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 20:22" />Ariko Yesu we arabasubiza ati, “Ntaabwo muuzi ico musaba. Mbese mwashobora kunywera ku gikopu co ndi haafi kunyweraho?”<note caller="+" style="f"><char style="fr" closed="false">20:22 </char><char style="ft" closed="false">Ibindi byanditswe byera bongeraho </char><char style="fqa" closed="false">cangwa kubatizwa umubatizo ngiiye kubatizwa? </char></note> Baramubwira bati, “Turabishobora.”<verse eid="MAT 20:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 20:23" />Arababwira ati, “Ni koko muzanywera ku gikopu canje, ariko kwicara iburyo bwanje n'ibumoso bwanje, si nje ubitanga, ahuubwo bihaabwa abo Daata yabigeneye.”<verse eid="MAT 20:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 20:24" />Nuuko abandi icumi babyumviise, baraakarira abo bavandimwe bombi. <verse eid="MAT 20:24" /><verse number="25" style="v" sid="MAT 20:25" /><note caller="-" style="x"><char style="xo" closed="false">20:25 </char><char style="xt" closed="false"><ref loc="LUK 22:25">Luk 22:25</ref>,<ref loc="LUK 22:26">26</ref>.</char></note>Yesu arabahamagara boose maze arababwira ati, “Muuzi yuuko abategetsi b'abanyamahanga bategekeesha abo bayobora agahato, kandi ko abayobozi bo muri bo babakandamiza. <verse eid="MAT 20:25" /><verse number="26" style="v" sid="MAT 20:26" /><note caller="-" style="x"><char style="xo" closed="false">20:26 </char><char style="xt" closed="false"><ref loc="MAT 23:11">Mat 23:11</ref>; <ref loc="MRK 9:35">Mar 9:35</ref>; <ref loc="LUK 22:26">Luk 22:26</ref>.</char></note>Ariko muri mwe si ko bimeze, ahuubwo ushaaka kuba mukuru muri mwe, agomba kuba umuheereza wa boose, <verse eid="MAT 20:26" /><verse number="27" style="v" sid="MAT 20:27" />kandi ushaaka kuba uwa mbere muri mwe, agomba kuba umugaragu waanyu, <verse eid="MAT 20:27" /><verse number="28" style="v" sid="MAT 20:28" />nk'uko Umwana w'Umuntu ataazanywe no kugira ngo bamukorere, ahuubwo yaaje gukorera abandi no gutanga ubugingo bwe ngo bube inshungu ya benshi.”<verse eid="MAT 20:28" /></para>
  <para style="s1">Yesu Ahumuura Abantu Babiri Bahumye</para>
  <para style="r">(<ref loc="MRK 10:46-52">Mar 10:46-52</ref>; <ref loc="LUK 18:18-43">Luk 18:18-43</ref>)</para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 20:29" />Igihe Yesu n'abiigiishwa be baavaga i Yeriko, abantu benshi barabakurikira. <verse eid="MAT 20:29" /><verse number="30" style="v" sid="MAT 20:30" />Abantu babiri bahumye baari biicaye iruhande rw'inzira. Bumviise yuuko Yesu ari kunyuraho, bateera heejuru bati, “Nyagasani, Mwana wa Dawudi, tugirire imbabazi!”<verse eid="MAT 20:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 20:31" />Abantu barabacaaha ngo baceceke, ariko barushaho guteera heejuru bati, “Tugirire imbabazi, Nyagasani, Mwana wa Dawudi!”<verse eid="MAT 20:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 20:32" />Yesu arahagarara maze arabahamagara, arababaza ati, “Murashaaka ko mbakorera iki?”<verse eid="MAT 20:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 20:33" />Baramusubiza bati, “Nyagasani, turashaaka ko amaaso yaacu ahumuuka.”<verse eid="MAT 20:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 20:34" />Yesu abagirira impuhwe, abakora ku maaso, ako kaanya barareeba maze baramukurikira.<verse eid="MAT 20:34" /></para>
  <chapter eid="MAT 20" />
  <chapter number="21" style="c" sid="MAT 21" />
  <para style="s1">Yesu aja i Yerusaalemu mu Cuubahiro</para>
  <para style="r">(<ref loc="MRK 11:1-11">Mar 11:1-11</ref>; <ref loc="LUK 19:28-40">Luk 19:28-40</ref>; <ref loc="JHN 12:12-19">Yoh 12:12-19</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 21:1" />Yesu n'abiigiishwa be beegeereje i Yerusaalemu, bagera i Betifage ku musozi wa Elayoni. Nuuko Yesu yoohereza abiigiishwa babiri <verse eid="MAT 21:1" /><verse number="2" style="v" sid="MAT 21:2" />arababwira ati, “Ni muje mu caaro kiri imbere yaanyu, mukihagera, murabona indogobe izirikanywe n'iyaayo, muziziture muzinzanire. <verse eid="MAT 21:2" /><verse number="3" style="v" sid="MAT 21:3" />Nihagira ugira ico ababaza, mumubwire muti, ‘Daatabuja arazishaaka.’ Kandi arazibagarurira vuba.” <verse eid="MAT 21:3" /><verse number="4" style="v" sid="MAT 21:4" />Ibi byabayeho kuzuza ibyo umuhanuuzi yari yaravuze ati,<verse eid="MAT 21:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="MAT 21:5" />“Mubwire ab'i tawuni y'i Siyoni muti,</para>
  <para style="q1" vid="MAT 21:5">Dore umwami waanyu arikuuza!</para>
  <para style="q2" vid="MAT 21:5">Yiciishije bugufi, aheetswe n'indogobe,</para>
  <para style="q3" vid="MAT 21:5">aheetswe n'icana c'indogobe.”<verse eid="MAT 21:5" /></para>
  <para style="m">
    <verse number="6" style="v" sid="MAT 21:6" />Nuuko abiigiishwa baragenda, bakora nk'uko Yesu yabategetse. <verse eid="MAT 21:6" /><verse number="7" style="v" sid="MAT 21:7" />Baazana ya ndogobe n'icaana caayo, babisasaho imyenda yaabo nuuko Yesu yiicaraho. <verse eid="MAT 21:7" /><verse number="8" style="v" sid="MAT 21:8" />Rubanda nyamwinshi basasa imyenda yaabo mu nzira, abandi baca amashami y'ibiti bayasasa mu nzira. <verse eid="MAT 21:8" /><verse number="9" style="v" sid="MAT 21:9" />Abantu benshi baagendaga imbere n'inyuma ya Yesu batangira guteera heejuru bati,</para>
  <para style="q1" vid="MAT 21:9">“Hozaana, asingizwe Umwana wa Dawudi!</para>
  <para style="q2" vid="MAT 21:9">Hasingizwe uje mu izina rya Nyagasani!</para>
  <para style="q1" vid="MAT 21:9">Hozaana ahasumba hoose mu ijuru!”<verse eid="MAT 21:9" /></para>
  <para style="m">
    <verse number="10" style="v" sid="MAT 21:10" />Yesu yinjiye i Yerusaalemu, i tawuni nkuru yoose irakangarana. Abantu barabaza bati, “Uwo ni nde?” <verse eid="MAT 21:10" /><verse number="11" style="v" sid="MAT 21:11" />Rubanda nyamwinshi baravuga bati, “Uyu n'umuhanuuzi Yesu, w'i Nazaareeti y'i Galileeya.”<verse eid="MAT 21:11" /></para>
  <para style="s1">Yesu Yirukana Abaacuruurizaga mu Nzu y'Imaana</para>
  <para style="r">(<ref loc="MRK 11:15-19">Mar 11:15-19</ref>; <ref loc="LUK 19:45-48">Luk 19:45-48</ref>; <ref loc="JHN 2:13-22">Yoh 2:13-22</ref>)</para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 21:12" />Yesu yinjira mu Nzu y'Imaana yiirukana abacuruuzi n'abaguzi boose baarimo. Yubika imeeza z'abaaguraanaga amashilingi n'abaaguriishaga inuma. <verse eid="MAT 21:12" /><verse number="13" style="v" sid="MAT 21:13" />Arababwira ati, “Ibyanditswe biravuga biti,</para>
  <para style="q1" vid="MAT 21:13">‘Inzu yanje iziitwa Urusengero,’</para>
  <para style="q2" vid="MAT 21:13">ariko mwe mwayihinduye ubwihisho bw'abajuura.”<verse eid="MAT 21:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 21:14" />Nuuko Impumyi n'abarema bamusanga mu Nzu y'Imaana maze arabakiza. <verse eid="MAT 21:14" /><verse number="15" style="v" sid="MAT 21:15" />Abatware b'abaheerezabitambo hamwe n'Abiigiishamategeko baboonye ibitangaaza akoze, n'abaana bateera heejuru mu Nzu y'Imaana bati, “Hozaana, aragasingizwa Umwana wa Dawudi,” bararaakara <verse eid="MAT 21:15" /><verse number="16" style="v" sid="MAT 21:16" />nuuko babaza Yesu bati, “Uri kumva ibyo bari kuvuga?” Arabasubiza ati, “Yeego ndi kubyumva, mbese ntimuraasoma ibyanditswe ngo,</para>
  <para style="q1" vid="MAT 21:16">‘Wateguuye ko abaana bato n'abakiri ku ibeere bagusingiza’?”<verse eid="MAT 21:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 21:17" />Yesu abasiga aho, aja mu tawuni y'i Bbetaniya aho yaraaye.<verse eid="MAT 21:17" /></para>
  <para style="s1">Yesu Avuma Igiti ciitwa Umutiini</para>
  <para style="r">(<ref loc="MRK 11:12-14">Mar 11:12-14</ref>,<ref loc="MRK 11:20-24">20-24</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 21:18" />Mu gitondo, ubwo Yesu yasubiye mu tawuni nkuru, yari ashonje. <verse eid="MAT 21:18" /><verse number="19" style="v" sid="MAT 21:19" />Aboonye igiti ciitwa umutiini iruhande rw'inzira, aracegeera, ariko asanga ari amababi gusa. Maze arakibwira ati, “Ntuziigere weera imbuto ukundi!” Ako kaanya ico giti c'umutiini kiruuma. <verse eid="MAT 21:19" /><verse number="20" style="v" sid="MAT 21:20" />Abiigiishwa be babiboonye, batangaara bavuga bati, “Kiriya giti c'umutiini cuumiyeho gite?” <verse eid="MAT 21:20" /><verse number="21" style="v" sid="MAT 21:21" /><note caller="-" style="x"><char style="xo" closed="false">21:21 </char><char style="xt" closed="false"><ref loc="MAT 17:20">Mat 17:20</ref>; <ref loc="1CO 13:2">1 Kor 13:2</ref>.</char></note>Yesu arabasubiza ati, “Ndababwira ukuri, nimwizeera mudashidiikanya, muzaashobora gukora nk'ibyo nkoreye iki giti c'umutiini. Ndetse atari ibyo gusa, ahuubwo muzaashobora kubwira uyu musozi muti, ‘Shiguka ujugunywe mu nyanja,’ nuuko bibe. <verse eid="MAT 21:21" /><verse number="22" style="v" sid="MAT 21:22" />Ibyo muzaasaba byose musenga mufite kwizeera, muzaabihaabwa.”<verse eid="MAT 21:22" /></para>
  <para style="s">Ububaasha bwa Yesu Babwibazaho</para>
  <para style="r">(<ref loc="MRK 11:27-33">Mar 11:27-33</ref>; <ref loc="LUK 20:1-8">Luk 20:1-8</ref>)</para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 21:23" />Yesu amaze kwinjira mu Nzu y'Imaana, abatware b'aheerezabitambo n'abakuru b'imiryango baaza aho ari baramubaza bati, “Ni bubaasha ki bugukoreesha ibyo kandi ni nde waguhaaye ubwo bubaasha?” <verse eid="MAT 21:23" /><verse number="24" style="v" sid="MAT 21:24" />Yesu arabasubiza ati, “Nanje ndababaza ikibazo kimwe, nimunsubiza ni ho ndababwira aho nkuura ububaasha bwo gukora ibi bintu. <verse eid="MAT 21:24" /><verse number="25" style="v" sid="MAT 21:25" />Mbese ububaasha bwa Yohaana bwo kubatiza bwavuuye mu ijuru cangwa se bwakomootse ku bantu?” Batangira kubazanya bati, “Nituvuga ngo, ‘Ni mu ijuru,’ aratubaza ati, ‘Kuki mutamwemeye?’ <verse eid="MAT 21:25" /><verse number="26" style="v" sid="MAT 21:26" />Kandi nituvuga ngo ‘Bwakomootse ku bantu,’ ntaabwo turibukire abantu kuko beemera badashidiikanya ko Yohaana ari umuhanuuzi.” <verse eid="MAT 21:26" /><verse number="27" style="v" sid="MAT 21:27" />Nuuko basubiza Yesu bati, “Ntitubiizi.” Yesu arababwira ati, “Nanje reero sindababwira aho nkura ububaasha bwo gukora ibyo.”<verse eid="MAT 21:27" /></para>
  <para style="s">Umugani w'Abahungu Babiri</para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 21:28" />Yesu arababaza ati, “Mbese uyu mugani muwuteekerezaho iki? Haabaayeho umugabo wari ufite abahungu babiri. Abwira umuhungu mukuru ati, ‘Mwana wanje, genda ukorere imizaabibu mu murima.’ <verse eid="MAT 21:28" /><verse number="29" style="v" sid="MAT 21:29" />Uwo muhungu aramusubiza ati, ‘Sinshaaka, ageze nyuma yisubiraho, aja yo.’ <verse eid="MAT 21:29" /><verse number="30" style="v" sid="MAT 21:30" />Nuuko se aja kubwira umuhungu we wakabiri nk'ibyo yabwiye uwa mbere. Uwo we aramusubiza ati, ‘Yeego daata, ndibujeyo,’ ariko ntiyajayo. <verse eid="MAT 21:30" /><verse number="31" style="v" sid="MAT 21:31" />Mbese muri abo bombi ni nde wakoze ibyo se ashaaka?” Baramusubiza bati, “Ni uwa mbere.” Yesu arababwira ati, “Ndababwira ukuri yuuko abasoreesha na ba malaaya bagiiye kubabanziriza kwinjira mu Bwami bw'Imaana. <verse eid="MAT 21:31" /><verse number="32" style="v" sid="MAT 21:32" /><note caller="-" style="x"><char style="xo" closed="false">21:32 </char><char style="xt" closed="false"><ref loc="LUK 3:12">Luk 3:12</ref>; <ref loc="LUK 7:29">7:29</ref>,<ref loc="LUK 7:30">30</ref>.</char></note>Kuko Yohaana yaje kubeereka inzira yo gukiraanuka ntimwamwemera, ariko abasoreesha na ba malaaya baramwemera, n'ubwo mubona ibikorwa byabo, ntimwisubiraho ngo mumwemere.”<verse eid="MAT 21:32" /></para>
  <para style="s">Umugani w'Abakozi Babi</para>
  <para style="r">(<ref loc="MRK 12:1-12">Mar 12:1-12</ref>; <ref loc="LUK 20:9-19">Luk 20:9-19</ref>)</para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 21:33" />Yesu arababwira ati, “Nimwumve undi mugani, haabaayeho umuntu wari ufite umurima, ateeramo imizaabibu, arayizitirira, acukuramo urwina maze yubakamo umunaara w'abarinzi. Nuuko awaatira abahinzi, aja mu kindi gihugu. <verse eid="MAT 21:33" /><verse number="34" style="v" sid="MAT 21:34" />Igihe co gusaaruura kigeze, yoohereza abagaragu be ku baatiisha kugira ngo babahe ubwatamurima bw'imizaabibu. <verse eid="MAT 21:34" /><verse number="35" style="v" sid="MAT 21:35" />Ariko abaatiisha barabafata, umwe baramukubita, undi baramwica kandi undi bamuteera amabuye. <verse eid="MAT 21:35" /><verse number="36" style="v" sid="MAT 21:36" />Arongera yoohereza abandi bagaragu benshi kuruta aba mbere, na bo babagenza batyo. <verse eid="MAT 21:36" /><verse number="37" style="v" sid="MAT 21:37" />Haanyuma yoohereza umuhungu we, yibwira ati, ‘Umwana wanje baramwubaha.’ <verse eid="MAT 21:37" /><verse number="38" style="v" sid="MAT 21:38" />Ariko abaatiisha bamuboonye baravugana bati, ‘Uyu ni we uzaazunguura ibya se, nimuuze tumwice tujaane ibyo yari kuzaazunguura.’ <verse eid="MAT 21:38" /><verse number="39" style="v" sid="MAT 21:39" />Baheerako baramufata, bamujugunya hiirya y'umurima maze baramwica. <verse eid="MAT 21:39" /><verse number="40" style="v" sid="MAT 21:40" />Noone se nyir'umurima naaza azaabagenza ate?” <verse eid="MAT 21:40" /><verse number="41" style="v" sid="MAT 21:41" />Baramubwira bati, “Abo bagome azaabiica nuuko umurima awaatire abandi baazaamuha umusaaruuro igihe kigeze.”<verse eid="MAT 21:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="MAT 21:42" />Yesu arababwira ati, “Ntimuraasoma ibyanditswe ngo,</para>
  <para style="q1" vid="MAT 21:42">‘Ibuye abuubatsi banze</para>
  <para style="q2" vid="MAT 21:42">ni ryo ryabaaye urufatiro rw'inzu,</para>
  <para style="q1" vid="MAT 21:42">ibi ni Imaana yabikoze,</para>
  <para style="q2" vid="MAT 21:42">kandi ni ibitangaaza mu maaso yaacu’?<verse eid="MAT 21:42" /></para>
  <para style="m">
    <verse number="43" style="v" sid="MAT 21:43" />Noone ndababwira yuuko, Ubwami bw'Imaana buzaabakuurwaho bugahaabwa abo beera imbuto zibukwiriye. <verse eid="MAT 21:43" /><verse number="44" style="v" sid="MAT 21:44" />Uzaagwa kuri iri buye azaavunagurika, kandi uwo rizaagwira azaajanjagurika.” <verse eid="MAT 21:44" /><verse number="45" style="v" sid="MAT 21:45" />Abatware b'abaheerezabitambo n'Abafarisaayo bumviise uyu mugani, bamenya ko ari bo avugaho. <verse eid="MAT 21:45" /><verse number="46" style="v" sid="MAT 21:46" />Nuuko baashaka kumufata, ariko Batiinya rubanda nyamwinshi, kuko beemeraga ko ari umuhanuuzi.<verse eid="MAT 21:46" /></para>
  <chapter eid="MAT 21" />
  <chapter number="22" style="c" sid="MAT 22" />
  <para style="s">Umugani w'Ubukwe</para>
  <para style="r">(<ref loc="LUK 14:15-24">Luk 14:15-24</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 22:1" />Yesu yongera kubabwirira mu migani ati, <verse eid="MAT 22:1" /><verse number="2" style="v" sid="MAT 22:2" />“Ubwami bw'ijuru bwagereranywa n'umwami wakoreye umuhungu we ubukwe. <verse eid="MAT 22:2" /><verse number="3" style="v" sid="MAT 22:3" />Yoohereza abagaragu be guhamagara abaatumiwe mu bukwe, ariko ntibaaza. <verse eid="MAT 22:3" /><verse number="4" style="v" sid="MAT 22:4" />Arongera atuma abandi bagaragu, arababwira ati, ‘Mubwire abaatumiwe muti, dore, nateguuye ifunguro rya nimugorooba, nabaaze ibimasa n'inyana z'imishishe, byose birateguuwe nimuuze mu bukwe.’ <verse eid="MAT 22:4" /><verse number="5" style="v" sid="MAT 22:5" />Ariko ntibaabyitaho baragenda, umwe aja mu murima we, undi mu bucuuruzi bwe, <verse eid="MAT 22:5" /><verse number="6" style="v" sid="MAT 22:6" />naho abandi bafata abagaragu be babagirira naabi, barabiica. <verse eid="MAT 22:6" /><verse number="7" style="v" sid="MAT 22:7" />Umwami araraakara. Yoohereza abasirikare be batsemba abo biicanyi, n'itawuni nkuru yaabo barayootsa. <verse eid="MAT 22:7" /><verse number="8" style="v" sid="MAT 22:8" />Nuuko abwira abagaragu be ati, ‘Ubukwe bwateguuwe ariko abaatumiwe ntibaari babukwiriye. <verse eid="MAT 22:8" /><verse number="9" style="v" sid="MAT 22:9" />Nuuko nimugende mu mihanda migari, muraarike buri weese gutaaha ubukwe.’ <verse eid="MAT 22:9" /><verse number="10" style="v" sid="MAT 22:10" />Abo bagaragu baja mu mihanda migari bakungaanya abo baboonye boose, hari abeeza cangwa ababi, maze igisenge c'ubukwe kiruuzura.<verse eid="MAT 22:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 22:11" />Ariko umwami aje kureeba abashitsi, abonamo umugabo wari utambaye umwenda w'ubukwe, <verse eid="MAT 22:11" /><verse number="12" style="v" sid="MAT 22:12" />nuuko aramubwira ati, ‘Nshuti yanje, wageze hano ute utambaye umwenda w'ubukwe?’ Uwo mugabo abura ico avuga. <verse eid="MAT 22:12" /><verse number="13" style="v" sid="MAT 22:13" /><note caller="-" style="x"><char style="xo" closed="false">22:13 </char><char style="xt" closed="false"><ref loc="MAT 8:12">Mat 8:12</ref>; <ref loc="MAT 25:30">25:30</ref>; <ref loc="LUK 13:28">Luk 13:28</ref>.</char></note>Nuuko umwami abwira abaheereza ati, ‘Nimumuhambiire amaboko n'amaguru, mumujugunye hanze mu mwijima, aho bazaaririra bakahahekenyera ameenyo.’ <verse eid="MAT 22:13" /><verse number="14" style="v" sid="MAT 22:14" />Kuko hahamagarwa benshi, hagatooranywa bake.”<verse eid="MAT 22:14" /></para>
  <para style="s1">Ikibazo Ceerekeye Gutanga Imisoro</para>
  <para style="r">(<ref loc="MRK 12:13-17">Mar 12:13-17</ref>; <ref loc="LUK 20:20-26">Luk 20:20-26</ref>)</para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 22:15" />Nuuko Abafarisaayo baja inaama yo gutegera Yesu mu magambo avuga. <verse eid="MAT 22:15" /><verse number="16" style="v" sid="MAT 22:16" />Boohereza abiigiishwa baabo hamwe n'abo mu kibiina c'Abaherodi ngo babaze Yesu bati, “Mwigiisha, tuuzi yuuko uri umunyakuri, kandi ko wiigiisha inzira y'Imaana ushingiye ku kuri, ntaawe utinya, kandi ntuurobaanura kubutoni. <verse eid="MAT 22:16" /><verse number="17" style="v" sid="MAT 22:17" />Nuuko reero tubwire ico uteekereza. Mbese byemewe n'amategeko gutanga umusoro wa Kayisaari cangwa ntibyemewe?” <verse eid="MAT 22:17" /><verse number="18" style="v" sid="MAT 22:18" />Ariko kuko Yesu yari azi imigambi yaabo mibi arababaza ati, “Kuki mungerageza mwa ndyarya mwe? <verse eid="MAT 22:18" /><verse number="19" style="v" sid="MAT 22:19" />Nimunyereke igiceri mukoreesha mu gutanga umusoro.” Maze bamuuzanira idinaari. <verse eid="MAT 22:19" /><verse number="20" style="v" sid="MAT 22:20" />Nuuko arababaza ati, “Iri shusho n'iri zina ni ibya nde?” <verse eid="MAT 22:20" /><verse number="21" style="v" sid="MAT 22:21" />Baramusubiza bati, “Ni ibya Kayisaari.” Yesu arababwira ati, “Nuuko reero ibya Kayisaari mubihe Kayisaari, n'iby'Imaana mubihe Imaana.” <verse eid="MAT 22:21" /><verse number="22" style="v" sid="MAT 22:22" />Babyumviise baratangaara, baramusiga, baragenda.<verse eid="MAT 22:22" /></para>
  <para style="s1">Ikibazo Ceerekeye Izuuka ry'Abaapfuuye</para>
  <para style="r">(<ref loc="MRK 12:18-27">Mar 12:18-27</ref>; <ref loc="LUK 20:27-40">Luk 20:27-40</ref>)</para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 22:23" />
    <note caller="-" style="x">
      <char style="xo" closed="false">22:23 </char>
      <char style="xt" closed="false">
        <ref loc="ACT 23:8">Iby 23:8</ref>.</char>
    </note>Uwo munsi Abasadukaayo bamwe baaza aho Yesu ari bavuga ko ari ntaakuzuuka kw'abaapfuuye kubaho. Baramubaza bati, <verse eid="MAT 22:23" /><verse number="24" style="v" sid="MAT 22:24" />“Mwigiisha, Moose yaravuze ati, ‘Umugabo n'azaapfa atabyaye, murumuna we azaacuure uwo mupfaakazi, kugira ngo aciikuure mwene nyina amubyarire abaana.’ <verse eid="MAT 22:24" /><verse number="25" style="v" sid="MAT 22:25" />Haabaayeho ibyene nyina birindwi, uwa mbere arasohoza ariko apfa ntamwana asize, maze mwene nyina asigarana uwo mupfaakazi. <verse eid="MAT 22:25" /><verse number="26" style="v" sid="MAT 22:26" />N'uwa kabiri biba bityo, n'uwa gatatu, kugeza ku wa karindwi. <verse eid="MAT 22:26" /><verse number="27" style="v" sid="MAT 22:27" />Haanyuma na wa mugore arapfa. <verse eid="MAT 22:27" /><verse number="28" style="v" sid="MAT 22:28" />Noone mu gihe co kuzuuka, muri abo barindwi uwo mugore azaaba uwa nde, ko boose baamutunze?”<verse eid="MAT 22:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 22:29" />Yesu arabasubiza ati, “Mwarayobye, kuko mutaazi ibyanditswe cangwa imbaraga z'Imaana. <verse eid="MAT 22:29" /><verse number="30" style="v" sid="MAT 22:30" />Kuko mu izuuka ntihabamo gusohoza cangwa gushingirwa, ahuubwo baba nk'abaamalayika bo mu ijuru. <verse eid="MAT 22:30" /><verse number="31" style="v" sid="MAT 22:31" />Naho ibyerekeye izuuka ry'abaapfuuye, mbese ntimwasomye ibyo Imaana yababwiye iti, <verse eid="MAT 22:31" /><verse number="32" style="v" sid="MAT 22:32" />‘Ndi Imaana ya Aburahamu, Imaana ya Isaaka n'Imaana ya Yaakobo?’ Ntaabwo ari Imaana y'abaapfuuye, ahuubwo ni iy'abazima.” <verse eid="MAT 22:32" /><verse number="33" style="v" sid="MAT 22:33" />Nuuko rubanda nyamwinshi babyumviise, batangaazwa n'inyigiisho ye.<verse eid="MAT 22:33" /></para>
  <para style="s1">Itegeko Rikomeye Kurusha Ayandi</para>
  <para style="r">(<ref loc="MRK 12:28-34">Mar 12:28-34</ref>; <ref loc="LUK 10:25-28">Luk 10:25-28</ref>)</para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 22:34" />Abafarisaayo bamaze kumva ko Yesu yazibije Abasadukaayo akanwa bakabura ico basubiza, bakungaanira hamwe, <verse eid="MAT 22:34" /><verse number="35" style="v" sid="MAT 22:35" />nuuko umwe muri bo wari umunyamategeko, abaza Yesu ikibazo co kumutega, ati, <verse eid="MAT 22:35" /><verse number="36" style="v" sid="MAT 22:36" />“Mwigiisha, mu mategeko yoose iriruta ayandi ni iriihe?” <verse eid="MAT 22:36" /><verse number="37" style="v" sid="MAT 22:37" />Aramubwira ati, “ ‘Ukunde Uhoraho Imaana yaawe n'umutima waawe woose, n'ubugingo bwawe bwose, n'ubwenge bwawe bwose.’ <verse eid="MAT 22:37" /><verse number="38" style="v" sid="MAT 22:38" />Iryo ni ryo tegeko rya mbere riruta ayandi yoose. <verse eid="MAT 22:38" /><verse number="39" style="v" sid="MAT 22:39" />Irya kabiri rimeze nka ryo, ‘Ukunde mugenzi waawe nk'uko wiikunda.’ <verse eid="MAT 22:39" /><verse number="40" style="v" sid="MAT 22:40" /><note caller="-" style="x"><char style="xo" closed="false">22:40 </char><char style="xt" closed="false"><ref loc="LUK 10:25-28">Luk 10:25-28</ref>.</char></note>Kuri ayo mategeko yombi ni yo shingiro y'amategeko yoose n'ibyanditswe n'abahanuuzi.”<verse eid="MAT 22:40" /></para>
  <para style="s1">Ikibazo Ceerekeye Kristo</para>
  <para style="r">(<ref loc="MRK 12:35-37">Mar 12:35-37</ref>; <ref loc="LUK 20:41-44">Luk 20:41-44</ref>)</para>
  <para style="p">
    <verse number="41" style="v" sid="MAT 22:41" />Ubwo Abafarisaayo baari bateeranye, Yesu ababaza iki kibazo ati, <verse eid="MAT 22:41" /><verse number="42" style="v" sid="MAT 22:42" />“Kristo mu muteekerezaho iki? Mbese ni mwene nde?” Baramusubiza bati, “Ni mwene Dawudi.” <verse eid="MAT 22:42" /><verse number="43" style="v" sid="MAT 22:43" />Arababaza ati, “Noone se ni kuki Dawudi abihishuuriwe n'Umwuka amwita Umwami, avuga ati,<verse eid="MAT 22:43" /></para>
  <para style="q1">
    <verse number="44" style="v" sid="MAT 22:44" />‘Uhoraho yabwiye Umwami wanje ati;</para>
  <para style="q1" vid="MAT 22:44">Icara iruhande rw'ukuboko kwanje kw'iburyo,</para>
  <para style="q2" vid="MAT 22:44">kugeza aho nzaashirira abanzi baawe haasi y'ibirenge byawe’?<verse eid="MAT 22:44" /></para>
  <para style="p">
    <verse number="45" style="v" sid="MAT 22:45" />Noone niiba Dawudi amwita Umwami we, yaaba umwana we ate?” <verse eid="MAT 22:45" /><verse number="46" style="v" sid="MAT 22:46" />Ntaawashoboye kumusubiza, kandi ntaanuwigeze yongera kugira ico amubaza kuva uwo munsi.<verse eid="MAT 22:46" /></para>
  <chapter eid="MAT 22" />
  <chapter number="23" style="c" sid="MAT 23" />
  <para style="s1">Yesu Yaamagana Ibyerekeye Abiigiishamategeko n'Abafarisaayo</para>
  <para style="r">(<ref loc="MRK 12:28-39">Mar 12:28-39</ref>; <ref loc="LUK 11:43">Luk 11:43</ref>,<ref loc="LUK 11:46">46</ref>; <ref loc="LUK 20:45-46">20:45-46</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 23:1" />Nuuko Yesu abwira abantu nyamwinshi n'abiigiishwa be ati, <verse eid="MAT 23:1" /><verse number="2" style="v" sid="MAT 23:2" />“Abiigiishamategeko n'abafarisaayo ni bo baagiiye mu mwanya wa Moose mu gusobaanura amategeko, <verse eid="MAT 23:2" /><verse number="3" style="v" sid="MAT 23:3" />nuuko reero mukore ibyo babiigiisha kandi mubikurikize, ariko mwegukurikiza ibyo bakora kuko ibyo bavuga atari byo bakora. <verse eid="MAT 23:3" /><verse number="4" style="v" sid="MAT 23:4" />Bahambiira imitwaro iremeereye caane bakayishira ku ntugu z'abantu, ariko bo ntibeemere kuba bayikozaho n'urutoki rwabo ngo babafashe. <verse eid="MAT 23:4" /><verse number="5" style="v" sid="MAT 23:5" /><note caller="-" style="x"><char style="xo" closed="false">23:5 </char><char style="xt" closed="false"><ref loc="MAT 6:1">Mat 6:1</ref>.</char></note>Ibyo bakora byose babikora ngo bareebwe n'abantu, ni co gituma bakunda kwambara udufuka batwaramo udupapuro tw'Ibyanditswe bakatugira tunini kuruta abandi, kandi bagahinuura imihino y'imyenda yaabo ngo ibe miremire kurushaho. <verse eid="MAT 23:5" /><verse number="6" style="v" sid="MAT 23:6" />Bakunda imyamya y'icuubahiro mu mashitsi n'ibyicaro byiza mu masinagoogi, <verse eid="MAT 23:6" /><verse number="7" style="v" sid="MAT 23:7" />bakunda ko baramutswa mu cuubahiro mu maguriro, no kumva abantu babiita ‘Mwigiisha.’ <verse eid="MAT 23:7" /><verse number="8" style="v" sid="MAT 23:8" />Mwe ntimukeemere ko babiita ‘Mwigiisha,’ kuko mufite Umwigiisha umwe gusa, mwebwe mukaba muri abiiga. <verse eid="MAT 23:8" /><verse number="9" style="v" sid="MAT 23:9" />Ntimukagire uwo mwita so kuri iyi si kuko mufite So umwe uri mu ijuru. <verse eid="MAT 23:9" /><verse number="10" style="v" sid="MAT 23:10" />Kandi ntimukeemere ko babiita abatooza, kuko mufite umutooza umwe, ari we Kristo. <verse eid="MAT 23:10" /><verse number="11" style="v" sid="MAT 23:11" /><note caller="-" style="x"><char style="xo" closed="false">23:11 </char><char style="xt" closed="false"><ref loc="MAT 20:26">Mat 20:26</ref>,<ref loc="MAT 20:27">27</ref>; <ref loc="MRK 9:35">Mar 9:35</ref>; <ref loc="MRK 10:43">10:43</ref>,<ref loc="MRK 10:44">44</ref>; <ref loc="LUK 22:26">Luk 22:26</ref>.</char></note>Umukuru muri mwe agomba kuba umugaragu waanyu. <verse eid="MAT 23:11" /><verse number="12" style="v" sid="MAT 23:12" /><note caller="-" style="x"><char style="xo" closed="false">23:12 </char><char style="xt" closed="false"><ref loc="LUK 14:11">Luk 14:11</ref>; <ref loc="LUK 18:14">18:14</ref>.</char></note>Abiishira heejuru boose bazaaciishwa bugufi, kandi abiiciisha bugufi boose bazaashirwa heejuru.<verse eid="MAT 23:12" /></para>
  <para style="s1">Abafarisaayo n'Abiigiishamategeko Bazaabona Ishano</para>
  <para style="r">(<ref loc="MRK 12:40">Mar 12:40</ref>; <ref loc="LUK 11:39-42">Luk 11:39-42</ref>,<ref loc="LUK 11:44">44</ref>,<ref loc="LUK 11:52">52</ref>; <ref loc="LUK 20:47">20:47</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 23:13" />Muzaabona ishano mwa ndyarya mwe z'Abiigiishamategeko n'Abafarisaayo! Kuko mukingiranya abantu hanze y'Ubwami bw'ijuru, kandi namwe ubwanyu ntimwinjire, ahuubwo mukabuza n'abandi kwinjira. <verse eid="MAT 23:13" /><verse number="14" style="v" sid="MAT 23:14" /><note caller="+" style="f"><char style="fr" closed="false">23:14 </char><char style="ft" closed="false">Bimwe mu byanditswe byera ntibongeraho uyu murongo. </char></note>Muzaabona ishano mwa ndyarya mwe z'Abiigiishamategeko n'Abafarisaayo, kuko murya ingo z'abapfaakazi, mukavuga amasengeesho mareemare mwiyerekana ngo babareebe. Muzaaciirwa urubanza rukomeye kurusha abandi. <verse eid="MAT 23:14" /><verse number="15" style="v" sid="MAT 23:15" />Muzaabona ishano mwa ndyarya mwe z'Abiigiishamategeko n'Abafarisaayo! Kuko mwambuka inyanja n'ibihugu guhindura umuntu umwe, mwamubona mukamugira uwo kujugunywa mu muriro utazima birenze ibyanyu inshuro ebyiri.<verse eid="MAT 23:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 23:16" />Muzaabona ishano mwa barandasi bahumye mwe, muvuga muti, ‘Urahiye Inzu y'Imaana ntaaco biba bitwaye, ariko urahiye izaahabu yo mu Nzu y'Imaana azaafatwa n'iyo ndahiro.’ <verse eid="MAT 23:16" /><verse number="17" style="v" sid="MAT 23:17" />Mwa bapfaapfa mwe b'impumyi! Ikiruta ikindi ni ikiihe, izaahabu cangwa Inzu y'Imaana yeeza iyo zaahabu? <verse eid="MAT 23:17" /><verse number="18" style="v" sid="MAT 23:18" />Kandi muravuga muti, ‘urahiye igicaaniro ntaaco biba bitwaye, ariko urahiye ituuro riri ku gicaaniro azaaba aboshwe n'iyo ndahiro.’ <verse eid="MAT 23:18" /><verse number="19" style="v" sid="MAT 23:19" />Mbeega ukuntu muri impumyi! Ikiruta ikindi ni ikiihe, ituuro cangwa igicaaniro ceeza iryo tuuro? <verse eid="MAT 23:19" /><verse number="20" style="v" sid="MAT 23:20" />Nuuko reero, urahiye igicaaniro, aba akirahiye n'ibikiriho byose, <verse eid="MAT 23:20" /><verse number="21" style="v" sid="MAT 23:21" />kandi urahiye Inzu y'Imaana aba ayirahiye hamwe n'Imaana iyituuyemo, <verse eid="MAT 23:21" /><verse number="22" style="v" sid="MAT 23:22" /><note caller="-" style="x"><char style="xo" closed="false">23:22 </char><char style="xt" closed="false"><ref loc="MAT 5:34">Mat 5:34</ref>.</char></note>kandi urahiye ijuru, aba arahiye intebe y'Ubwami bw'Imaana n'uyiicaraho.<verse eid="MAT 23:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 23:23" />Muzaabona ishano mwa ndyarya mwe z'Abiigiishamategeko n'Abafarisaayo! Kuko mutanga kimwe ca cumi c'ibimera by'ifashiishwa nk'ibirungo nk'umujaaja, umudarasiini, n'umuteete, ariko mukirengagiza ingingo z'ingenzi z'amategeko, ari zo ubutabeera, imbabazi no kwizeera. Ibyo ni byo mwagombaga kwitooza mutaretse n'ibindi. <verse eid="MAT 23:23" /><verse number="24" style="v" sid="MAT 23:24" />Mwa barandasi muhumye mwe! Mwubahiriza amategeko yoroshe ariko mukiyobagiza ingingo z'amategeko y'ingenzi mutabiizi.<verse eid="MAT 23:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 23:25" />Muzaabona ishano mwa ndyarya mwe z'Abiigiishamategeko n'Abafarisaayo! Mwoza igikopu n'isahaani inyuma, naho munda huzuyemo ibyo mwaboonye mu bwambuzi no kwikunda. <verse eid="MAT 23:25" /><verse number="26" style="v" sid="MAT 23:26" />Wa Mufarisaayo uhumye we! Banza wooze munda y'igikopu nuuko n'inyuma habone kubonera.<verse eid="MAT 23:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 23:27" />
    <note caller="-" style="x">
      <char style="xo" closed="false">23:27 </char>
      <char style="xt" closed="false">
        <ref loc="ACT 23:3">Iby 23:3</ref>.</char>
    </note>Muzaabona ishano mwa ndyarya mwe z'Abiigiishamategeko n'Abafarisaayo! Mumeze nk'ibituro bisiize irangi ry'umweru, bireebeka neeza inyuma, ariko munda bikaba byuzuyemo amagufa y'abaapfuuye n'imyanda y'ingeri zoose. <verse eid="MAT 23:27" /><verse number="28" style="v" sid="MAT 23:28" />Namwe inyuma mureebeka muri abakiraanutsi ariko munda mwuzuye uburyarya n'ubugome.<verse eid="MAT 23:28" /></para>
  <para style="s1">Yesu Avuga ku Bihano Abiigiishamategeko n'Abafarisaayo Bazaabona.</para>
  <para style="r">(<ref loc="LUK 11:47-51">Luk 11:47-51</ref>)</para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 23:29" />Muzaabona ishano mwa ndyarya mwe z'Abiigiishamategeko n'Abafarisaayo, kuko mwubaka imva z'abahanuuzi mugataaka imyanya y'urwibutso rw'abakiraanutsi, <verse eid="MAT 23:29" /><verse number="30" style="v" sid="MAT 23:30" />maze mukavuga muti, ‘Yabaaye twarabaayeho mu gihe ca ba sogokuruza, ntaabwo twari gufatanya na bo kumena amaraso y'abahanuuzi.’ <verse eid="MAT 23:30" /><verse number="31" style="v" sid="MAT 23:31" />Noone murabihamya ubwanyu ko mukomooka ku biishe abo bahanuuzi. <verse eid="MAT 23:31" /><verse number="32" style="v" sid="MAT 23:32" />Nuuko namwe nimurangize umurimo watangiwe na basookuruza baanyu. <verse eid="MAT 23:32" /><verse number="33" style="v" sid="MAT 23:33" /><note caller="-" style="x"><char style="xo" closed="false">23:33 </char><char style="xt" closed="false"><ref loc="MAT 3:7">Mat 3:7</ref>; <ref loc="MAT 12:34">12:34</ref>; <ref loc="LUK 3:7">Luk 3:7</ref>.</char></note>Mwa nzoka mwe, mwa baana b'inshiira mwe! Muzaahunga mute igihano c'i gehenoomu? <verse eid="MAT 23:33" /><verse number="34" style="v" sid="MAT 23:34" />Nuuko reero ngiiye kubooherereza abahanuuzi, n'abanyabwenge, n'Abiigiishamategeko, bamwe muri bo muzaabiica kandi mubabambe, abandi muzaabakubitira mu masinagoogi yaanyu, muzaabiirukana mu ma tawuni yoose bazaajamo. <verse eid="MAT 23:34" /><verse number="35" style="v" sid="MAT 23:35" />Nuuko reero muzaabarweho amaraso y'abakiraanutsi yamenetse ku isi, uheereye ku maraso y'umukiraanutsi Abeli kugeza ku maraso ya Zakariya mwene Barakiya, uwo mwiciye hagati y'aheera h'Inzu y'Imaana n'igicaaniro. <verse eid="MAT 23:35" /><verse number="36" style="v" sid="MAT 23:36" />Ndababwira ukuri yuuko, ibi byose bizaasohora ku b'iki gihe.<verse eid="MAT 23:36" /></para>
  <para style="s1">Yesu aririra Yerusaalemu</para>
  <para style="r">(<ref loc="LUK 13:34-35">Luk 13:34-35</ref>)</para>
  <para style="p">
    <verse number="37" style="v" sid="MAT 23:37" />Yemwe bantu b'i Yerusaalemu, biica abahanuuzi bagateera amabuye ababatumwemo! Ni kangaahe nashaatse kubarundarunda nk'uko inkoko ibundikiira ubushwi bwayo munda y'amababa yaayo, ariko ntimunkundire! <verse eid="MAT 23:37" /><verse number="38" style="v" sid="MAT 23:38" />Dore iwaanyu hasigaye ari amatongo. <verse eid="MAT 23:38" /><verse number="39" style="v" sid="MAT 23:39" />Ndababwira yuuko mutazongera kumbona kugeza ubwo muzaavuga muti, ‘Hahiirwa uje mu izina ry'Uhoraho.’ ”<verse eid="MAT 23:39" /></para>
  <chapter eid="MAT 23" />
  <chapter number="24" style="c" sid="MAT 24" />
  <para style="s1">Yesu Avuga Ibyerekeye Gusenyuka kw'Inzu y'Imaana</para>
  <para style="r">(<ref loc="MRK 13:1-2">Mar 13:1-2</ref>; <ref loc="LUK 21:5-6">Luk 21:5-6</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 24:1" />Ubwo Yesu yavaga mu Nzu y'Imaana, arikugenda, abiigiishwa be baramusanga maze bamwereka imyubakire y'Inzu y'Imaana. <verse eid="MAT 24:1" /><verse number="2" style="v" sid="MAT 24:2" />Nuuko arababaza ati, “Ntimureeba ibi byose? Ndababwira ukuri yuuko aha hatazaasigara ibuye rigeretse ku rindi, byose bizaajugunywa haasi.”<verse eid="MAT 24:2" /></para>
  <para style="s1">Ibyerekana Imperuuka y'Isi</para>
  <para style="r">(<ref loc="MRK 13:3-13">Mar 13:3-13</ref>; <ref loc="LUK 21:7-19">Luk 21:7-19</ref>)</para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 24:3" />Yesu yiicaye ku musozi wa Elayoni, abiigiishwa baaza aho ari biihereereye, baravuga bati, “Tubwire, ibyo bizaaba ryari, ni kimenyeetso ki kizeerekana kuuza kwawe hamwe n'imperuuka y'isi?”<verse eid="MAT 24:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 24:4" />Arabasubiza ati, “Mwirinde hatagira umuntu ubayobya. <verse eid="MAT 24:4" /><verse number="5" style="v" sid="MAT 24:5" />Kuko benshi bazaaza mu izina ryanje bavuga bati, ‘Ni nje Kristo!’ Kandi bazaayobya benshi. <verse eid="MAT 24:5" /><verse number="6" style="v" sid="MAT 24:6" />Muzumva intambara n'impuuha z'intambara, ariko ntimuzaakuuke umutima, kuko ibi bitazaabura kubaho, ariko si byo herezo. <verse eid="MAT 24:6" /><verse number="7" style="v" sid="MAT 24:7" />Igihugu kizaateera ikindi, kandi ubwami buteere ubundi, hazaabaho inzara n'imishitsi mumyanya myinshi, <verse eid="MAT 24:7" /><verse number="8" style="v" sid="MAT 24:8" />ibyo byose bizaaba bimeze nk'imigendo ibanziriza ibise by'umubyeyi yenda kubyara.<verse eid="MAT 24:8" /></para>
  <para style="s1">Yesu Avuga ku Byerekeye Gutootezwa</para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 24:9" />
    <note caller="-" style="x">
      <char style="xo" closed="false">24:9 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 10:22">Mat 10:22</ref>.</char>
    </note>Ico gihe muzaatangwa ngo mutootezwe, ndetse mwicwe, kandi ibihugu byose bizaabanga ku bw'izina ryanje. <verse eid="MAT 24:9" /><verse number="10" style="v" sid="MAT 24:10" />Maze benshi bazaagwa, bagambaanirane kandi bangane. <verse eid="MAT 24:10" /><verse number="11" style="v" sid="MAT 24:11" />Abahanuuzi b'ibinyoma bazaaduka kandi bayobye benshi. <verse eid="MAT 24:11" /><verse number="12" style="v" sid="MAT 24:12" />Kandi ku bwo kwiyongera k'ubugome, urukundo rwa benshi ruzaakonja. <verse eid="MAT 24:12" /><verse number="13" style="v" sid="MAT 24:13" /><note caller="-" style="x"><char style="xo" closed="false">24:13 </char><char style="xt" closed="false"><ref loc="MAT 10:22">Mat 10:22</ref>.</char></note>Ariko uziihangaana kugeza ku mperuuka azaakizwa. <verse eid="MAT 24:13" /><verse number="14" style="v" sid="MAT 24:14" />Kandi ubu Butumwa Bwiza bw'Ubwami buzaamamazwa mu isi yoose, bubeere amahanga yoose ubuhamya, nuuko imperuuka iheereko ize.<verse eid="MAT 24:14" /></para>
  <para style="s1">Ikizira Kirimbura</para>
  <para style="r">(<ref loc="MRK 13:14-23">Mar 13:14-23</ref>; <ref loc="LUK 21:20-24">Luk 21:20-24</ref>)</para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 24:15" />Nimuzaabona ikizira kirimbura gihagaze aheera, nk'uko byahanuuwe n'umuhanuuzi Daniyeli (ubisoma abyitondere), <verse eid="MAT 24:15" /><verse number="16" style="v" sid="MAT 24:16" />maze abazaaba bari i Yudeeya bahungire ku misozi, <verse eid="MAT 24:16" /><verse number="17" style="v" sid="MAT 24:17" /><note caller="-" style="x"><char style="xo" closed="false">24:17 </char><char style="xt" closed="false"><ref loc="LUK 17:31">Luk 17:31</ref>.</char></note>uzaaba ari heejuru y'inzu yekuzaamanuka ngo ajaane ikiri mu nzu, <verse eid="MAT 24:17" /><verse number="18" style="v" sid="MAT 24:18" />n'uzaaba ari mu murima yekuzaasubira inyuma gushikiira umwambaro. <verse eid="MAT 24:18" /><verse number="19" style="v" sid="MAT 24:19" />Muri iyo minsi, abagore batwite n'abari konsa bazaabona ishano. <verse eid="MAT 24:19" /><verse number="20" style="v" sid="MAT 24:20" />Musenge kugira ngo ico gihe co guhunga kitazaabaho mu minsi y'imbeho cangwa ku Isaabato. <verse eid="MAT 24:20" /><verse number="21" style="v" sid="MAT 24:21" /><note caller="-" style="x"><char style="xo" closed="false">24:21 </char><char style="xt" closed="false"><ref loc="REV 7:14">Ibya 7:14</ref>.</char></note>Kuko muri iyo minsi hazaabaho kubabara caane, kutigeze kubaho kuva kukuremwa ku isi kugeza ubu kandi ntikuzongera kubaho ukundi. <verse eid="MAT 24:21" /><verse number="22" style="v" sid="MAT 24:22" />Kandi Imaana iyo itagabanya iyo minsi nta wari kuzaarokoka, ariko ku bw'abo yiitooranyirije, iyo minsi izaagabanywa. <verse eid="MAT 24:22" /><verse number="23" style="v" sid="MAT 24:23" />Nuuko nihagira ubabwira ati, ‘Dore, hano hari Kristo!’ Cangwa ati, ‘Dore, ari hariya!’ Ntimuzaabyemere. <verse eid="MAT 24:23" /><verse number="24" style="v" sid="MAT 24:24" />Kuko hazaaduka abiiyita Kristo n'abahanuuzi b'ibinyoma kandi bakore ibimenyeetso n'ibitangaaza, kugira ngo babayobye, ndetse nibishoboka bayobye n'abo Imaana yiitooranyirije. <verse eid="MAT 24:24" /><verse number="25" style="v" sid="MAT 24:25" />Murumve! Dore mbibamenyeesheje bitari byaba.<verse eid="MAT 24:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 24:26" />
    <note caller="-" style="x">
      <char style="xo" closed="false">24:26 </char>
      <char style="xt" closed="false">
        <ref loc="LUK 17:23">Luk 17:23</ref>,<ref loc="LUK 17:24">24</ref>.</char>
    </note>Nuuko nibababwira bati, ‘Dore, ari mu butaayu,’ ntimukajeyo. Ni bababwira bati, ‘Dore, ari mu nzu, ntimuzaabyemere.’ <verse eid="MAT 24:26" /><verse number="27" style="v" sid="MAT 24:27" />Nk'uko umurabyo urabiriza iburasirazuuba ukagera iburengerazuuba, ni ko no kuuza k'Umwana w'Umuntu kuzaaba. <verse eid="MAT 24:27" /><verse number="28" style="v" sid="MAT 24:28" /><note caller="-" style="x"><char style="xo" closed="false">24:28 </char><char style="xt" closed="false"><ref loc="LUK 17:37">Luk 17:37</ref>.</char></note>Aho intumbi iri hoose, ni ho ibisiiga biteeranira.<verse eid="MAT 24:28" /></para>
  <para style="s1">Kuuza k'Umwana w'Umuntu</para>
  <para style="r">(<ref loc="MRK 13:24-27">Mar 13:24-27</ref>; <ref loc="LUK 21:25-28">Luk 21:25-28</ref>)</para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 24:29" />
    <note caller="-" style="x">
      <char style="xo" closed="false">24:29 a </char>
      <char style="xt" closed="false">
        <ref loc="REV 6:12">Ibya 6:12</ref>; </char>
      <char style="xo" closed="false">b </char>
      <char style="xt" closed="false">
        <ref loc="REV 6:13">Ibya 6:13</ref>.</char>
    </note>Bidatinze, nyuma y'iyo minsi y'imibabaro, izuuba riziijima, n'ukwezi ntikuzaava, inyenyeeri zizaagwa ziva mu kireere, n'imbaraga zo mu kireere zizanyeganyezwa. <verse eid="MAT 24:29" /><verse number="30" style="v" sid="MAT 24:30" /><note caller="-" style="x"><char style="xo" closed="false">24:30 </char><char style="xt" closed="false"><ref loc="REV 1:7">Ibya 1:7</ref>.</char></note>Nuuko ikimenyeetso c'Umwana w'Umuntu kizaaboneka mu ijuru, kandi amooko yoose yo ku isi azaacura umuboroogo, maze babone Umwana w'Umuntu aziye ku bicu byo mu ijuru afite imbaraga n'ikuzo ryinshi. <verse eid="MAT 24:30" /><verse number="31" style="v" sid="MAT 24:31" />Azoohereza abaamalayika be mu nshonda enye z'isi, bavuze impanda iranguruye, bakungaanye abo yatooranyije, uheereye aho isi itangiriye ukageza aho irangiriye.<verse eid="MAT 24:31" /></para>
  <para style="s1">Inyigiisho y'Igiti Ciitwa Umutiini</para>
  <para style="r">(<ref loc="MRK 13:28-31">Mar 13:28-31</ref>; <ref loc="LUK 21:29-33">Luk 21:29-33</ref>)</para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 24:32" />Reka igiti ciitwa umutiini kitwigiishe isomo. Iyo amashami yaaco ashishe akameraho amababi, mumenya yuuko igihe kiba kiri bugufi guhinduka. <verse eid="MAT 24:32" /><verse number="33" style="v" sid="MAT 24:33" />Nuuko reero, nimubona ibi byose, mumenye yuuko Umwana w'Umuntu ari haafi, kandi ko ageze ku irembo. <verse eid="MAT 24:33" /><verse number="34" style="v" sid="MAT 24:34" />Ndababwira ukuri yuuko, ab'iki gihe batazaashiraho mbere yuuko ibi byose biba. <verse eid="MAT 24:34" /><verse number="35" style="v" sid="MAT 24:35" />Ijuru n'isi bizaashira, ariko amagambo yanje ntaazaashira.<verse eid="MAT 24:35" /></para>
  <para style="s1">Mube Maaso</para>
  <para style="r">(<ref loc="MRK 13:32-37">Mar 13:32-37</ref>; <ref loc="LUK 17:26-30">Luk 17:26-30</ref>,<ref loc="LUK 17:34-36">34-36</ref>)</para>
  <para style="p">
    <verse number="36" style="v" sid="MAT 24:36" />Ariko ibyerekeye uwo munsi n'isaaha ntaawe ubiizi, naaho baaba abaamalayika bo mu ijuru, cangwa Umwana, keretse Daata wenyine. <verse eid="MAT 24:36" /><verse number="37" style="v" sid="MAT 24:37" />Uko mu minsi ya Nowa byari bimeze, ni ko no kuuza kw'Umwana w'Umuntu kuzaaba. <verse eid="MAT 24:37" /><verse number="38" style="v" sid="MAT 24:38" />Nk'uko baari bameze muri iyo minsi yabanjirije umwuzure, abantu baararyaga, kandi bakanywa, abagabo baararongoraga, abagore bagashingirwa, kugeza umunsi Nowa yinjiriye mu nkuge, <verse eid="MAT 24:38" /><verse number="39" style="v" sid="MAT 24:39" />ariko ntibaabimenya kugeza aho umwuzure waaziye ukabajaana boose, ni ko no kuuza k'Umwana w'Umuntu kuzaaba. <verse eid="MAT 24:39" /><verse number="40" style="v" sid="MAT 24:40" />Uwo munsi abantu babiri bazaaba bari mu murima, umwe azaajanwa, undi asigare. <verse eid="MAT 24:40" /><verse number="41" style="v" sid="MAT 24:41" />Abagore babiri bazaaba basya hamwe, umwe azaajanwa, undi asigare. <verse eid="MAT 24:41" /><verse number="42" style="v" sid="MAT 24:42" />Nuuko reero mube maaso, kuko mutaazi umunsi wo Umwami waanyu azaazira. <verse eid="MAT 24:42" /><verse number="43" style="v" sid="MAT 24:43" /><note caller="-" style="x"><char style="xo" closed="false">24:43 </char><char style="xt" closed="false"><ref loc="LUK 12:39">Luk 12:39</ref>,<ref loc="LUK 12:40">40</ref>.</char></note>Ariko ibi mubimenye, iyo nyir'urugo aza kumenya igihe c'ijoro umujuura azaaziramo, yaakabaaye maaso ntamwemerere kwinjira mu nzu ye. <verse eid="MAT 24:43" /><verse number="44" style="v" sid="MAT 24:44" />Namwe mwiteguure, kuko Umwana w'Umuntu azaaza igihe mudateekereza.<verse eid="MAT 24:44" /></para>
  <para style="s1">Umugani w'Umugaragu Wiringirwa n'Umugaragu w'Umuhemu</para>
  <para style="r">(<ref loc="LUK 12:41-48">Luk 12:41-48</ref>)</para>
  <para style="p">
    <verse number="45" style="v" sid="MAT 24:45" />Mbese ni nde mugaragu w'umwiringirwa kandi ufite ubwenge? Ni uwo sheebuja yasigiye kuja aheereza abandi bagaragu ibyokurya mu gihe gikwiriye. <verse eid="MAT 24:45" /><verse number="46" style="v" sid="MAT 24:46" />Hahiirwa umugaragu wo sheebuja azaagaruka agasanga ari gukora ibyo yamushinze. <verse eid="MAT 24:46" /><verse number="47" style="v" sid="MAT 24:47" />Ndababwira ukuri yuuko, azamwegurira ibintu bye byose. <verse eid="MAT 24:47" /><verse number="48" style="v" sid="MAT 24:48" />Ariko umugaragu mubi niyibwira mu mutima we ati, ‘Daatabuja aratinze,’ <verse eid="MAT 24:48" /><verse number="49" style="v" sid="MAT 24:49" />maze agatangira gukubita abagaragu bagenzi be, no gusangira n'abasinzi, <verse eid="MAT 24:49" /><verse number="50" style="v" sid="MAT 24:50" />sheebuja azaagaruka igihe umugaragu we adateekereza kandi ataazi. <verse eid="MAT 24:50" /><verse number="51" style="v" sid="MAT 24:51" />Azaamuhana yihanikiiriye<note caller="+" style="f"><char style="fr" closed="false">24:51 </char><char style="ft" closed="false">Bimwe mu byanditswe byera bivuga biti, </char><char style="fqa" closed="false">Azaamucagagura </char></note>, amushire aho indyarya ziri, aho bazaarira kandi bagahekenya ameenyo.”<verse eid="MAT 24:51" /></para>
  <chapter eid="MAT 24" />
  <chapter number="25" style="c" sid="MAT 25" />
  <para style="s">Umugani w'Abakoobwa Cumi</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 25:1" />
    <note caller="-" style="x">
      <char style="xo" closed="false">25:1 </char>
      <char style="xt" closed="false">
        <ref loc="LUK 12:35">Luk 12:35</ref>.</char>
    </note>Yesu akomeza kubabwira ati, “Ico gihe Ubwami bw'Imaana buzaagereranywa n'uyu mugani. Abakoobwa cumi baajanye amataara yaabo, baja gusanganira umukwe. <verse eid="MAT 25:1" /><verse number="2" style="v" sid="MAT 25:2" />Bataanu muri bo baari abapfaapfa, abandi bataanu baari abanyabwenge. <verse eid="MAT 25:2" /><verse number="3" style="v" sid="MAT 25:3" />Abo bapfaapfa baajaanye amataara yaabo, ariko ntibaajaana amavuta yo kongeramo, <verse eid="MAT 25:3" /><verse number="4" style="v" sid="MAT 25:4" />ariko abanyabwenge bo bajaana amataara n'amavuta yaayo mu macupa. <verse eid="MAT 25:4" /><verse number="5" style="v" sid="MAT 25:5" />Umukwe atinze kuuza, abakoobwa boose batangira guhunikiira, barasinziira. <verse eid="MAT 25:5" /><verse number="6" style="v" sid="MAT 25:6" />Ariko n'ijoro mu gicuku, haba urusaku bati, ‘Umukwe araaje! Nimusohoke muje kumusanganira!’ <verse eid="MAT 25:6" /><verse number="7" style="v" sid="MAT 25:7" />Nuuko abakoobwa<note caller="+" style="f"><char style="fr" closed="false">25:7 </char><char style="ft" closed="false">Murugiriki ni abakoobwa b'isugi</char></note> boose barabaduka, batungaanya amataara yaabo. <verse eid="MAT 25:7" /><verse number="8" style="v" sid="MAT 25:8" />Abapfaapfa babwira abanyabwenge bati, ‘Muduhe ku mavuta y'itaara yaanyu kuko amataara yaacu agiiye kuzima.’ <verse eid="MAT 25:8" /><verse number="9" style="v" sid="MAT 25:9" />Ariko abanyabwenge barabahakanira bati, ‘Ntibishoboka! Ntiyaadukwira twese, ahuubwo byaba byiza mugiiye mu bacuruuzi mukiigurira ayaanyu.’ <verse eid="MAT 25:9" /><verse number="10" style="v" sid="MAT 25:10" />Ariko bagiiye kuyagura, umukwe araaza, abari biiteguuye binjirana na we mu nzu y'ubukwe, nuuko urugi rurakingwa. <verse eid="MAT 25:10" /><verse number="11" style="v" sid="MAT 25:11" /><note caller="-" style="x"><char style="xo" closed="false">25:11 </char><char style="xt" closed="false"><ref loc="LUK 13:25">Luk 13:25</ref>.</char></note>Haanyuma baabakoobwa b'abapfaapfa bagarutse, barahamagara bati, ‘Daatabuja, daatabuja, dukinguurire.’ <verse eid="MAT 25:11" /><verse number="12" style="v" sid="MAT 25:12" />Na we arabasubiza ati, ‘Ndababwira ukuri, simbaazi!’ ” <verse eid="MAT 25:12" /><verse number="13" style="v" sid="MAT 25:13" />Nuuko Yesu arababwira ati, “Mube maaso, kuko mutaazi umunsi cangwa igihe Umwana w'Umuntu azaazira.<verse eid="MAT 25:13" /></para>
  <para style="s1">Umugani w'Abagaragu Batatu</para>
  <para style="r">(<ref loc="LUK 19:11-27">Luk 19:11-27</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 25:14" />
    <note caller="-" style="x">
      <char style="xo" closed="false">25:14 </char>
      <char style="xt" closed="false">
        <ref loc="LUK 19:11-27">Luk 19:11-27</ref>.</char>
    </note>Ubwami bw'Imaana bwagereranywa n'uyu mugani. Haabaayeho umugabo washaatse kuja ku rugendo, ataraagenda ahamagara abagaragu be, abaha kureeberera ibintu bye. <verse eid="MAT 25:14" /><verse number="15" style="v" sid="MAT 25:15" />Umwe amuha italanta itaanu, undi ebyiri, undi imwe, buri umwe amuha akurikije uko ashoboye. Haanyuma aragenda. <verse eid="MAT 25:15" /><verse number="16" style="v" sid="MAT 25:16" />Ako kaanya uwahaawe italanta itaanu aja kuzikoreesha, yunguka izindi itaanu. <verse eid="MAT 25:16" /><verse number="17" style="v" sid="MAT 25:17" />Uwahaawe italanta ebyiri na we yungukamo izindi ebyiri. <verse eid="MAT 25:17" /><verse number="18" style="v" sid="MAT 25:18" />Ariko uwahaawe italanta imwe aragenda acukura icoobo mu taka atabamo italanta ya sheebuja. <verse eid="MAT 25:18" /><verse number="19" style="v" sid="MAT 25:19" />Nyuma y'igihe kireekire sheebuja w'abo bagaragu araaza, ahamagara abagaragu be kugira ngo bamurike ibyo yabasigiye. <verse eid="MAT 25:19" /><verse number="20" style="v" sid="MAT 25:20" />Umugaragu wahaawe italanta itaanu araaza, aramubwira ati, ‘Daatabuja, wampaaye italanta itaanu, dore nungutsemo izindi talanta itaanu.’ <verse eid="MAT 25:20" /><verse number="21" style="v" sid="MAT 25:21" />Sheebuja aramusubiza ati, ‘Wakoze mugaragu mwiza kandi wiringirwa, wabaye umwiringirwa mu bintu bike, nzagushinga ibisumbaho, ngwino wiishiimane na shoobuja!’ <verse eid="MAT 25:21" /><verse number="22" style="v" sid="MAT 25:22" />Uwahaawe italanta ebyiri na we araaza abwira sheebuja ati, ‘Daatabuja wampaaye italanta ebyiri, dore nungutsemo izindi talanta ebyiri.’ <verse eid="MAT 25:22" /><verse number="23" style="v" sid="MAT 25:23" />Sheebuja aramusubiza ati, ‘Nuuko mugaragu mwiza kandi wiringirwa, wabaaye umwiringirwa mu bintu bike, nzagushinga ibisumbaho, ngwino wiishiimane na shoobuja!’ <verse eid="MAT 25:23" /><verse number="24" style="v" sid="MAT 25:24" />Naho uwahaawe italanta imwe araaza, aravuga ati, ‘Daatabuja, namenye ko uri umuntu utagira imbabazi, usaaruura aho utaabibye, ukaanura aho utaanitse. <verse eid="MAT 25:24" /><verse number="25" style="v" sid="MAT 25:25" />Bityo reero naratiinye, ndagenda mpisha italanta yaawe mu taka. Dore fata ibyawe!’ <verse eid="MAT 25:25" /><verse number="26" style="v" sid="MAT 25:26" />Ariko sheebuja aramusubiza ati, ‘Wa mugaragu mubi we kandi w'umunebwe! Wari uzi ko nsaaruura aho ntaabibye kandi nkaanura aho ntaanitse? <verse eid="MAT 25:26" /><verse number="27" style="v" sid="MAT 25:27" />Wari ukwiriye kuba warashize italanta yanje mu bbanka, maze naagaruka nkabona ibyanje n'amagoba yabyo. <verse eid="MAT 25:27" /><verse number="28" style="v" sid="MAT 25:28" />Noone nimuyimwake, muyiheereze ufite italanta cumi. <verse eid="MAT 25:28" /><verse number="29" style="v" sid="MAT 25:29" /><note caller="-" style="x"><char style="xo" closed="false">25:29 </char><char style="xt" closed="false"><ref loc="MAT 13:12">Mat 13:12</ref>; <ref loc="MRK 4:25">Mar 4:25</ref>; <ref loc="LUK 8:18">Luk 8:18</ref>.</char></note>Kuko umuntu weese ufite, azongereerwa byinshi, naho udafite na busa azaakuurwaho na gake yari afite. <verse eid="MAT 25:29" /><verse number="30" style="v" sid="MAT 25:30" /><note caller="-" style="x"><char style="xo" closed="false">25:30 </char><char style="xt" closed="false"><ref loc="MAT 8:12">Mat 8:12</ref>; <ref loc="MAT 22:13">22:13</ref>; <ref loc="LUK 13:28">Luk 13:28</ref>.</char></note>Naho uyu mugaragu utagira ico amaze, nimumujugunye hanze mu mwijima, aho bazaaririra bakahahekenyera ameenyo.’<verse eid="MAT 25:30" /></para>
  <para style="s">Urubanza ku Munsi w'Imperuuka</para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 25:31" />
    <note caller="-" style="x">
      <char style="xo" closed="false">25:31 a </char>
      <char style="xt" closed="false">
        <ref loc="MAT 16:27">Mat 16:27</ref>; </char>
      <char style="xo" closed="false">b </char>
      <char style="xt" closed="false">
        <ref loc="MAT 19:28">Mat 19:28</ref>.</char>
    </note>Igihe Umwana w'Umuntu azaagaruka mu cuubahiro ashagawe n'abaamalayika, aziicara ku ntebe ye y'Ubwami. <verse eid="MAT 25:31" /><verse number="32" style="v" sid="MAT 25:32" />Amahanga yoose azaateeranyirizwa imbere ye, maze atandukanye abantu, nk'uko umushumba atandukanya intaama n'ihene. <verse eid="MAT 25:32" /><verse number="33" style="v" sid="MAT 25:33" />Intungaane azaazishira iburyo bwe naho abanyabyaha bashirwe ibumoso. <verse eid="MAT 25:33" /><verse number="34" style="v" sid="MAT 25:34" />Nuuko reero, Umwami azaabwira abari iburyo bwe ati, ‘Nimuuze abo Daata yahaaye umugisha muragwe ubwami bwabateguuriwe uheereye ku kuremwa kw'isi, <verse eid="MAT 25:34" /><verse number="35" style="v" sid="MAT 25:35" />kuko nari nshonje muramfungurira, nari mfite imyota mumpa ico kunywa, nari mu rugendo murancumbikira, <verse eid="MAT 25:35" /><verse number="36" style="v" sid="MAT 25:36" />nari nambaye ubusa muranyambika, nari ndwaye muransuura, nari mu gihome muuza kundeeba.’ <verse eid="MAT 25:36" /><verse number="37" style="v" sid="MAT 25:37" />Nuuko intungaane nazo zizaamubaza ziti, ‘Nyagasani, twakuboonye ryari ushonje tukagufungurira, cangwa ufite imyota tukaguha ico kunywa, <verse eid="MAT 25:37" /><verse number="38" style="v" sid="MAT 25:38" />uri mu rugendo tukagucumbikira, cangwa wambaye ubusa tukakwambika? <verse eid="MAT 25:38" /><verse number="39" style="v" sid="MAT 25:39" />Ni gihe ki twakuboonye urwaye cangwa uri mu gihome tukaaza kugusuura?’ <verse eid="MAT 25:39" /><verse number="40" style="v" sid="MAT 25:40" />Nuuko Umwami azaabasubiza ati, ‘Ndababwira ukuri yuuko ibyo mwakoreye umwe mu bavandimwe banje baciiye bugufi, burya ni nje mwabikoreraga.’ <verse eid="MAT 25:40" /><verse number="41" style="v" sid="MAT 25:41" />Nuuko azaabwira n'abari ibumoso ati, ‘Nimumve iruhande, mwabivume mwe, muje mu muriro w'iteeka wateguuriwe Sataani n'abaamalayika be, <verse eid="MAT 25:41" /><verse number="42" style="v" sid="MAT 25:42" />kuko nari nshonje, ntimwamfungurira, kandi nari mfite imyota ntimwampa ico kunywa, <verse eid="MAT 25:42" /><verse number="43" style="v" sid="MAT 25:43" />nari mu rugendo ntimwancumbikira, nari nambaye ubusa, ntimwampa ico kwambara, nari ndwaye kandi ndi mu gihome, ntimwansuura.’ <verse eid="MAT 25:43" /><verse number="44" style="v" sid="MAT 25:44" />Nuuko na bo bazaamusubiza bati, ‘Nyagasani, ni gihe ki twakuboonye ushonje cangwa ufite imyota, uri mu rugendo wifuza ubufasha, wambaye ubusa, cangwa urwaye cangwa uri mu gihome ntitugufashe?’ <verse eid="MAT 25:44" /><verse number="45" style="v" sid="MAT 25:45" />Nawe azaabasubiza ati, ‘Ndababwira ukuri yuuko, ibyo mutaakoreye umwe mu bantu banje baciiye bugufi, ni nje mutaabikoreye.’ <verse eid="MAT 25:45" /><verse number="46" style="v" sid="MAT 25:46" />Abo bazaaja aho bazaahanirwa iteeka ryose, naho intungaane zije mu bugingo buhoraho iteeka.”<verse eid="MAT 25:46" /></para>
  <chapter eid="MAT 25" />
  <chapter number="26" style="c" sid="MAT 26" />
  <para style="s1">Inaama yo Kugambaanira Yesu</para>
  <para style="r">(<ref loc="MRK 14:1-2">Mar 14:1-2</ref>; <ref loc="LUK 22:1-2">Luk 22:1-2</ref>; <ref loc="JHN 11:45-53">Yoh 11:45-53</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 26:1" />Yesu arangije kwigiisha ibyo, abwira abiigiishwa be ati, <verse eid="MAT 26:1" /><verse number="2" style="v" sid="MAT 26:2" />“Muuzi ko nihashira iminsi ebyiri, tuziizihiza umunsi wo Kunyurwaho, haanyuma Umwana w'Umuntu agatangwa kugira ngo abambwe k'umusaraba.”<verse eid="MAT 26:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 26:3" />Nuuko abatware b'abaheerezabitambo n'abakuru b'imiryango bateeranira mu gikaari c'Umuheerezabitambo mukuru wiitwa Kayafa, <verse eid="MAT 26:3" /><verse number="4" style="v" sid="MAT 26:4" />kugira ngo baje inaama yo gufata Yesu rwihishwa no kumwica. <verse eid="MAT 26:4" /><verse number="5" style="v" sid="MAT 26:5" />Ariko baravuga bati, “Twekubikora mu minsi mikuru yo Kunyurwaho, kuko tubikoze, abantu bateera agasasamaro.”<verse eid="MAT 26:5" /></para>
  <para style="s1">Yesu Asiigwa Amavuta i Bbetaniya</para>
  <para style="r">(<ref loc="MRK 14:3-9">Mar 14:3-9</ref>; <ref loc="JHN 12:1-8">Yoh 12:1-8</ref>)</para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 26:6" />Ubwo Yesu yari i Bbetaniya mu rugo rwa Simooni wo Yesu yari yarakijije ibibembe, <verse eid="MAT 26:6" /><verse number="7" style="v" sid="MAT 26:7" /><note caller="-" style="x"><char style="xo" closed="false">26:7 </char><char style="xt" closed="false"><ref loc="LUK 7:37">Luk 7:37</ref>,<ref loc="LUK 7:38">38</ref>.</char></note>umugore aza aho Yesu ari afite icupa ry'uzuye amavuta ahuumura neeza kandi y'igiciiro kinini caane, ayasuka ku mutwe wa Yesu igihe yari ku meeza afungura.<figure style="fig" alt="The woman powered oil on the head of Jesus" file="DD-27A.TIF" size="col" loc="Darwin" copy="The British and Foreign Bible Societies." ref="26:7">Umugore asuka amavuta ku mutwe wa Yesu</figure> <verse eid="MAT 26:7" /><verse number="8" style="v" sid="MAT 26:8" />Ariko abiigiishwa be babiboonye bararaakara baravuga bati, “Mbese aya mavuta apfuuye iki? <verse eid="MAT 26:8" /><verse number="9" style="v" sid="MAT 26:9" />Aya mavuta yari akwiriye kuguriishwa akavamo amashilingi menshi, haanyuma agahaabwa abakene”. <verse eid="MAT 26:9" /><verse number="10" style="v" sid="MAT 26:10" />Yesu amenya byose baavugaga, arababwira ati, “Uyu mugore muramuryoza iki, ankoreye ikintu ciiza. <verse eid="MAT 26:10" /><verse number="11" style="v" sid="MAT 26:11" />Abakene muzaahorana nabo, ariko nje ntimuzamporana iteeka. <verse eid="MAT 26:11" /><verse number="12" style="v" sid="MAT 26:12" />Kunsukaho aya mavuta ni ukugira ngo atungaanye umubiri wanje mbere yo guhambwa. <verse eid="MAT 26:12" /><verse number="13" style="v" sid="MAT 26:13" />Ndababwira ukuri yuuko, iyi nkuru nziza izaamamazwa ku isi yoose, kandi ico akoze kizaavugwa ngo bamwibuke”.<verse eid="MAT 26:13" /></para>
  <para style="s1">Yuda Yeemera Kugambaanira Yesu</para>
  <para style="r">(<ref loc="MRK 14:10-11">Mar 14:10-11</ref>; <ref loc="LUK 22:3-6">Luk 22:3-6</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 26:14" />Ico gihe umwe mu biigiishwa cumi na babiri witwaga Yuda Isikariyooti, aja kureeba abatware b'abaheerezabitambo<verse eid="MAT 26:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 26:15" />arababaza ati, “Mbese murampa iki, nimbagabiza Yesu?” Nuuko bamuha ibiceri by'ifeeza mirongo itatu. <verse eid="MAT 26:15" /><verse number="16" style="v" sid="MAT 26:16" />Kuva ubwo atangira gushaaka uburyo bwo kugambaanira Yesu.<verse eid="MAT 26:16" /></para>
  <para style="s1">Yesu Asangira n'Abiigiishwa be Ifunguro ryo Kunyurwaho</para>
  <para style="r">(<ref loc="MRK 14:12-21">Mar 14:12-21</ref>; <ref loc="LUK 22:7-13">Luk 22:7-13</ref>,<ref loc="LUK 22:21-23">21-23</ref>; <ref loc="JHN 13:21-30">Yoh 13:21-30</ref>)</para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 26:17" />Ku munsi wa mbere w'imihango yo kurya Imigaati Idasembuwe, abiigiishwa baaza aho Yesu ari baramubaza bati, “Mbese urashaaka ko duteguurira he aho urariira ifunguro ryo Kunyurwaho?” <verse eid="MAT 26:17" /><verse number="18" style="v" sid="MAT 26:18" />Yesu arabasubiza ati, “Nimuje mu tawuni nkuru, kwa kaanaaka, mumubwire muti, ‘Umwigiisha aravuze ngo, igihe canje kireegeereje, noone ndashaaka gusangirira iwaawe n'abiigiishwa banje ifunguro ryo Kunyurwaho.’ ” <verse eid="MAT 26:18" /><verse number="19" style="v" sid="MAT 26:19" />Nuuko abiigiishwa baragenda bakora ico Yesu yari yaabategetse, batungaanyiriza mu nzu y'uwo mugabo iby'umuhango wo Kunyurwaho. <verse eid="MAT 26:19" /><verse number="20" style="v" sid="MAT 26:20" />Bugoroobye, Yesu yiicarana n'abiigiishwa be cumi na babiri, barafungura. <verse eid="MAT 26:20" /><verse number="21" style="v" sid="MAT 26:21" />Bagifungura Yesu arababwira ati, “Ndababwira ukuri yuuko, umwe muri mwe agiiye kungambaanira.” <verse eid="MAT 26:21" /><verse number="22" style="v" sid="MAT 26:22" />Birabababaza caane, batangira kumubaza umwe umwe bati, “Nyagasani, yaaba ari njeewe?” <verse eid="MAT 26:22" /><verse number="23" style="v" sid="MAT 26:23" />Arabasubiza ati, “Uwo duhuuriza intoki ku sahaane, ni we ugiiye kungambaanira. <verse eid="MAT 26:23" /><verse number="24" style="v" sid="MAT 26:24" />Ni koko Umwana w'umuntu agiiye gupfa nk'uko byamwanditsweho, ariko uwo muntu uzaamugambaanira azaabona ishano! Icaakabaaye ciiza ni uko uwo muntu aba ataaravuutse.” <verse eid="MAT 26:24" /><verse number="25" style="v" sid="MAT 26:25" />Yuda wari ugiiye kumugambaanira aramubaza ati, “Mwigiisha, ni nje?” Yesu aramusubiza ati “Urabyivugiye.”<verse eid="MAT 26:25" /></para>
  <para style="s1">Yesu Asangira Ifunguro rya Nyuma n'Abiigiishwa be</para>
  <para style="r">(<ref loc="MRK 14:22-26">Mar 14:22-26</ref>; <ref loc="LUK 22:14-20">Luk 22:14-20</ref>; <ref loc="1CO 11:23-25">1 Kor 11:23-25</ref>)</para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 26:26" />Bakirya, Yesu afata umugaati, amaze kuwushiimira Imaana, arawumaanyagura, awuha abiigiishwa be, ababwira ati, “Mwakiire murye, uyu ni umubiri wanje.” <verse eid="MAT 26:26" /><verse number="27" style="v" sid="MAT 26:27" />Haanyuma afata igikopu, arangije kugishiimira Imaana arabaheereza avuga ati, “Nimunyweho mwese, <verse eid="MAT 26:27" /><verse number="28" style="v" sid="MAT 26:28" />aya ni amaraso yanje y'iseezerano risha agiiye kumenerwa benshi kugira ngo bababarirwe ibyaha. <verse eid="MAT 26:28" /><verse number="29" style="v" sid="MAT 26:29" />Ndababwira ko ntazongera kunywa ku mbuto z'imizaabibu ukundi kugeza ku munsi nzanywera divaayi nsha mu Bwami bwa Daata.” <verse eid="MAT 26:29" /><verse number="30" style="v" sid="MAT 26:30" />Nuuko bamaze kuririmba indirimbo, baja ku musozi wa Elayoni.<verse eid="MAT 26:30" /></para>
  <para style="s1">Yesu Ahanuura ko Peetero Aramwihakana</para>
  <para style="r">(<ref loc="MRK 14:27-31">Mar 14:27-31</ref>; <ref loc="LUK 22:31-34">Luk 22:31-34</ref>; <ref loc="JHN 13:36-38">Yoh 13:36-38</ref>)</para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 26:31" />Yesu arababwira ati, “Iri joro mwese mugiiye kumpunga kandi munsige, nk'uko byanditswe ngo,</para>
  <para style="q1" vid="MAT 26:31">‘Nziica umushumba,</para>
  <para style="q2" vid="MAT 26:31">maze umukumbi w'intaama utaataane.’<verse eid="MAT 26:31" /></para>
  <para style="m">
    <verse number="32" style="v" sid="MAT 26:32" />
    <note caller="-" style="x">
      <char style="xo" closed="false">26:32 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 28:16">Mat 28:16</ref>.</char>
    </note>Ariko niimara kuzuuka, nzaababanziriza i Galileeya.”<verse eid="MAT 26:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 26:33" />Peetero aramusubiza ati, “Naaho abandi boose baaguhunga, njeewe sinzigera ngusiga.” <verse eid="MAT 26:33" /><verse number="34" style="v" sid="MAT 26:34" />Yesu aramusubiza ati, “Ndakubwira ukuri yuuko, iri joro, isaaki itaraabika uribunyiihakane gatatu.” <verse eid="MAT 26:34" /><verse number="35" style="v" sid="MAT 26:35" />Peetero aramubwira ati, “Naaho kwaba gupfa, ndeemera mpfaane na we, ariko sindibukwihakane na hato.” N'abandi biigiishwa boose bavuga batyo.<verse eid="MAT 26:35" /></para>
  <para style="s1">Yesu Asengera i Getsemaani</para>
  <para style="r">(<ref loc="MRK 14:32-42">Mar 14:32-42</ref>; <ref loc="LUK 22:39-46">Luk 22:39-46</ref>)</para>
  <para style="p">
    <verse number="36" style="v" sid="MAT 26:36" />Nuuko Yesu ajaana n'abiigiishwa be ahantu hiitwa i Getsemaani, maze arababwira ati, “Nimube mwicaye aha nje hirya gusenga.” <verse eid="MAT 26:36" /><verse number="37" style="v" sid="MAT 26:37" />Ajaana na Peetero, na beene Zebedaayo bombi ari bo, Yaakobo na Yohaana, maze atangira kugira agahinda n'ishavu. <verse eid="MAT 26:37" /><verse number="38" style="v" sid="MAT 26:38" />Yesu arababwira ati, “Mfite agahinda kenshi mu mutima, kenda kunyica. Nimugume aha, kandi mube maaso hamwe nanje.” <verse eid="MAT 26:38" /><verse number="39" style="v" sid="MAT 26:39" />Yigira imbere gato, yuubama haasi maze asenga avuga ati, “Daata, niiba bishoboka, nkiza ubu bubabare, ariko byekuba uko nshaaka ahuubwo bibe uko ushaaka.” <verse eid="MAT 26:39" /><verse number="40" style="v" sid="MAT 26:40" />Nuuko agaruka aho abiigiishwa be bari, asanga basinziiriye, maze abwira Peetero ati, “Ntimushobora kuba maaso nanje kumara isaaha imwe yoonyine? <verse eid="MAT 26:40" /><verse number="41" style="v" sid="MAT 26:41" />Nimube maaso kandi musenge kugira ngo mutagwa mu bishuko. Umutima urakunze, ariko umubiri ufite intege nke.”<verse eid="MAT 26:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="MAT 26:42" />Asubirayo ubwa kabiri maze arasenga ati, “Daata, niiba ari ngombwa ko nyura muri ubu bubabare, bibe nk'uko ubishaaka.” <verse eid="MAT 26:42" /><verse number="43" style="v" sid="MAT 26:43" />Agarutse asanga bongeye gusinziira, kuko amaaso yaabo yari afite ibitotsi byinshi.<verse eid="MAT 26:43" /></para>
  <para style="p">
    <verse number="44" style="v" sid="MAT 26:44" />Yesu yongera kubasiga, asubirayo asenga ubwa gatatu asubira muri ya magambo. <verse eid="MAT 26:44" /><verse number="45" style="v" sid="MAT 26:45" />Arongera asanga abiigiishwa be, arababwira ati, “Muracasinziiriye, muracaruhuutse? Dore igihe kirageze Umwana w'Umuntu akagambaanirwa, agashirwa mu maboko y'abanyabyaha. <verse eid="MAT 26:45" /><verse number="46" style="v" sid="MAT 26:46" />Nimuhaguruke tugende! Dore ungambaanira ari hano.”<verse eid="MAT 26:46" /></para>
  <para style="s1">Yesu Afatwa</para>
  <para style="r">(<ref loc="MRK 14:43-50">Mar 14:43-50</ref>; <ref loc="LUK 22:47-53">Luk 22:47-53</ref>; <ref loc="JHN 18:3-12">Yoh 18:3-12</ref>)</para>
  <para style="p">
    <verse number="47" style="v" sid="MAT 26:47" />Yesu akivuga ayo magambo, Yuda umwe mu biigiishwa be, abageraho. Yari aherekejwe n'igiteero kinini gifite inkoota n'ubuhiri. Baari booherejwe n'abatware b'abaheerezabitambo na bakuru b'imiryango. <verse eid="MAT 26:47" /><verse number="48" style="v" sid="MAT 26:48" />Umugambaanyi yari yabahaaye ikimenyeetso ati, “Uwo ndi buramutse musoma, ni we uwo, mumufate.”<verse eid="MAT 26:48" /></para>
  <para style="p">
    <verse number="49" style="v" sid="MAT 26:49" />Yuda ageze aho Yesu ari aramubwira ati, “Muraho Mwigiisha! Aramusoma.”<verse eid="MAT 26:49" /></para>
  <para style="p">
    <verse number="50" style="v" sid="MAT 26:50" />Yesu aramusubiza ati, “Nshuti yanje, kora ikikuuzanye.” Maze abagabo baari na Yuda baraaza basingiira Yesu, baramufata. <verse eid="MAT 26:50" /><verse number="51" style="v" sid="MAT 26:51" />Ako kaanya umwe mu baari kumwe na Yesu, akuura inkoota mu rwubati, ayikubita umugaragu w'Umuheerezabitambo mukuru, amuca ugutwi. <verse eid="MAT 26:51" /><verse number="52" style="v" sid="MAT 26:52" />Nuuko Yesu aramubwira ati, “Subiza inkoota yaawe mu rwubati<note caller="+" style="f"><char style="fr" closed="false">26:52 </char><char style="ft" closed="false">Urwubati n'ububiiko bw'inkoota cangwa agafuka cangwa agahago inkoota ibiikwamo </char></note>, kuko abarwaniisha inkoota na bo bazaarimburwa n'inkoota. <verse eid="MAT 26:52" /><verse number="53" style="v" sid="MAT 26:53" />Mbese uteekereza ko ntabaasha kwambaza Daata, maze akanyoherereza imitwe y'abaamalayika irenga cumi n'ebyiri? <verse eid="MAT 26:53" /><verse number="54" style="v" sid="MAT 26:54" />Ariko se bibaye bityo, ibyanditswe byasohozwa bite, kandi bivuga ko ari ko bikwiriye kuba?”<verse eid="MAT 26:54" /></para>
  <para style="p">
    <verse number="55" style="v" sid="MAT 26:55" />
    <note caller="-" style="x">
      <char style="xo" closed="false">26:55 </char>
      <char style="xt" closed="false">
        <ref loc="LUK 19:47">Luk 19:47</ref>; <ref loc="LUK 21:37">21:37</ref>.</char>
    </note>Ako kaanya Yesu abwira rubanda nyamwinshi ati, “Mbese mwagombaga kuuza kumfata mwitwaje inkoota n'ubuhiri, nk'aho muje gufata umwambuzi? Buri gihe niicaraga mu Nzu y'Imaana niigiisha, kandi ntimwamfata. <verse eid="MAT 26:55" /><verse number="56" style="v" sid="MAT 26:56" />Ariko ibi byose bibaaye kugira ngo ibyanditswe n'abahanuuzi bisohore.”</para>
  <para style="p" vid="MAT 26:56">Nuuko abiigiishwa baramuteererana, barahunga.<verse eid="MAT 26:56" /></para>
  <para style="s1">Yesu Ashinjwa Imbere y'urukiiko Rukuru</para>
  <para style="r">(<ref loc="MRK 14:53-65">Mar 14:53-65</ref>; <ref loc="LUK 22:54-55">Luk 22:54-55</ref>,<ref loc="LUK 22:63-71">63-71</ref>; <ref loc="JHN 18:13-14">Yoh 18:13-14</ref>,<ref loc="JHN 18:19-24">19-24</ref>)</para>
  <para style="p">
    <verse number="57" style="v" sid="MAT 26:57" />Abaari baafashe Yesu bamujaana kwa Kayafa Umuheerezabitambo mukuru. Mu rugo rwe ni ho Abiigiishamategeko n'abakuru b'imiryango baari bateeraniye. <verse eid="MAT 26:57" /><verse number="58" style="v" sid="MAT 26:58" />Ariko Peetero amukurikirira kure, agera mu gikaari c'Umuheerezabitambo mukuru, yicarana n'abarinzi kugira ngo areebe amaherezo ya byose. <verse eid="MAT 26:58" /><verse number="59" style="v" sid="MAT 26:59" />Nuuko abatware b'abaheerezabitambo n'abagize urukiiko rukuru boose batangira gushaakiisha ibirego by'ibinyoma ngo biiciishe Yesu, <verse eid="MAT 26:59" /><verse number="60" style="v" sid="MAT 26:60" />ariko ntibaabibona, n'ubwo haaje abajurizi bo kumushinja ibinyoma benshi. Haanyuma abagabo babiri mubaaje kumushinja, <verse eid="MAT 26:60" /><verse number="61" style="v" sid="MAT 26:61" /><note caller="-" style="x"><char style="xo" closed="false">26:61 </char><char style="xt" closed="false"><ref loc="JHN 2:19">Yoh 2:19</ref>.</char></note>baravuga bati, “Uyu mugabo yaravuze ati, ‘Nshobora gusenya Inzu y'Imaana maze nkayubaka mu minsi itatu.’ ” <verse eid="MAT 26:61" /><verse number="62" style="v" sid="MAT 26:62" />Umuheerezabitambo mukuru arahaguruka, abwira Yesu ati, “Wakwireguura iki ku byo bakurega? Ntaaco ushobora kubivugaho?” <verse eid="MAT 26:62" /><verse number="63" style="v" sid="MAT 26:63" />Ariko Yesu we ariicecekera. Umuheerezabitambo mukuru aramubwira ati, “Rahira mu izina ry'Imaana Ihoraho, utubwire niiba ari wowe Kristo, Umwana w'Imaana.” <verse eid="MAT 26:63" /><verse number="64" style="v" sid="MAT 26:64" />Yesu aramusubiza ati, “Urabyivugiye. Ariko ndababwira yuuko, uheereye ubu muzaabona Umwana w'Umuntu yiicaye iburyo bw'Imaana Nyir'ububaasha kandi aje ku bicu byo mu ijuru.”<verse eid="MAT 26:64" /></para>
  <para style="p">
    <verse number="65" style="v" sid="MAT 26:65" />Nuuko Umuheerezabitambo mukuru ashishimura imyambaro ye aravuga ati, “Uyu mugabo arasebya Imaana! Abandi bajurizi turashaaka ab'iki? Mwiyumviye ukuntu akoze amaroreerwa yo gusebya Imaana. <verse eid="MAT 26:65" /><verse number="66" style="v" sid="MAT 26:66" />Murabivugaho iki?”</para>
  <para style="p" vid="MAT 26:66">Baramusubiza bati, “Akwiriye gupfa.”<verse eid="MAT 26:66" /></para>
  <para style="p">
    <verse number="67" style="v" sid="MAT 26:67" />Nuuko bamuciira mu maaso, bamukubita ibipfunsi, abandi bamukubita inshi <verse eid="MAT 26:67" /><verse number="68" style="v" sid="MAT 26:68" />bavuga bati, “Duhanuurire Kristo we! Ugukubise ni nde?”<verse eid="MAT 26:68" /></para>
  <para style="s1">Peetero Yiihakana Yesu</para>
  <para style="r">(<ref loc="MRK 14:66-72">Mar 14:66-72</ref>; <ref loc="LUK 22:56-62">Luk 22:56-62</ref>; <ref loc="JHN 18:15-18">Yoh 18:15-18</ref>,<ref loc="JHN 18:25-27">25-27</ref>)</para>
  <para style="p">
    <verse number="69" style="v" sid="MAT 26:69" />Ubwo Peetero yari yiicaye hanze mu gikaari, haaza umuja aramubwira ati, “Naawe wari kumwe na Yesu w'i Galileeya.” <verse eid="MAT 26:69" /><verse number="70" style="v" sid="MAT 26:70" />Ariko Peetero ahakanira imbere ya boose avuga ati, “Ibyo uvuga simbiizi.” <verse eid="MAT 26:70" /><verse number="71" style="v" sid="MAT 26:71" />Arasohoka, ageze ku irembo ry'igikaari, undi muja aramubona, nuuko abwira abaari bahagaze aho ati, “Uyu mugabo na we yari na Yesu w'i Nazaareeti.” <verse eid="MAT 26:71" /><verse number="72" style="v" sid="MAT 26:72" />Peetero yongera kubihakana arahira ati, “Uwo mugabo siimuuzi!”<verse eid="MAT 26:72" /></para>
  <para style="p">
    <verse number="73" style="v" sid="MAT 26:73" />Hashize umwanya muke, abaari bahagaze aho baraaza beegeera Peetero, baramubwira bati, “Ni ukuri naawe uri umwe muri bo, imvugo yaawe irakuranga.”<verse eid="MAT 26:73" /></para>
  <para style="p">
    <verse number="74" style="v" sid="MAT 26:74" />Peetero atangira kuvugira heejuru no gucurikiranya indahiro ati, “Niiba ndi kubeesha, Imaana impane! Uwo mugabo siimuuzi!”</para>
  <para style="p" vid="MAT 26:74">Ako kaanya isaaki irabika. <verse eid="MAT 26:74" /><verse number="75" style="v" sid="MAT 26:75" />Maze Peetero yiibuka amagambo Yesu yari yaamubwiye ati, “Isaaki itaraabika, uraba wanyihakanye gatatu.” Nuuko Peetero asohoka arira caane.<verse eid="MAT 26:75" /></para>
  <chapter eid="MAT 26" />
  <chapter number="27" style="c" sid="MAT 27" />
  <para style="s1">Yesu Bamujaana kwa Pilaato</para>
  <para style="r">(<ref loc="MRK 15:1">Mar 15:1</ref>; <ref loc="LUK 23:1-2">Luk 23:1-2</ref>; <ref loc="JHN 18:28-32">Yoh 18:28-32</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 27:1" />Kare kare mu gitondo, abatware b'Abaheerezabitambo boose n'abakuru b'imiryango barateerana ngo baje inaama yo kwica Yesu. <verse eid="MAT 27:1" /><verse number="2" style="v" sid="MAT 27:2" />Baramuboha, baramujaana bamushikiriza Pilaato Umutegetsi mukuru w'i Rooma.<verse eid="MAT 27:2" /></para>
  <para style="s1">Urupfu rwa Yuda</para>
  <para style="r">(<ref loc="REV 1:18-19">Ibya 1:18-19</ref>)</para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 27:3" />
    <note caller="-" style="x">
      <char style="xo" closed="false">27:3 </char>
      <char style="xt" closed="false">
        <ref loc="ACT 1:18">Iby 1:18</ref>,<ref loc="ACT 1:19">19</ref>.</char>
    </note>Ubwo Yuda wamugambaaniye aboonye ko Yesu baamuciiriye urubanza rwo gupfa, yiisubiraho ariicuza agarura bya biceri by'ifeeza mirongo itatu abiheereza abatware b'Abaheerezabitambo n'Abakuru b'imiryango. <verse eid="MAT 27:3" /><verse number="4" style="v" sid="MAT 27:4" />Aravuga ati, “Naacumuye kuko nagambaaniye umuntu w'umwere ngo yiicwe.” Ariko bo baramusubiza bati, “Ibyo birakureeba! Ntibidufasheho!” <verse eid="MAT 27:4" /><verse number="5" style="v" sid="MAT 27:5" />Nuuko Yuda ajugunya ibyo biceri mu Nzu y'Imaana, aragenda aja kwimanika. <verse eid="MAT 27:5" /><verse number="6" style="v" sid="MAT 27:6" />Ariko abatware b'Abaheerezabitambo, batoragura bya biceri baravuga bati, “Amategeko ntiyeemera ko ibi biceri bivangwa n'ibindi byo mu bubiiko bw'Inzu y'Imaana, kuko byatanzwe nk'ikiguzi co kumena amaraso.” <verse eid="MAT 27:6" /><verse number="7" style="v" sid="MAT 27:7" />Bamaze kuja inaama, bahitamo ko ibyo biceri babiguramo Umurima w'Umubumbyi kugira ngo uzaabe irimbi ryo kuja bahambamo abanyamahanga. <verse eid="MAT 27:7" /><verse number="8" style="v" sid="MAT 27:8" />Ni co gituma uwo murima wiitwa, Umurima w'Amaraso kugeza na n'ubu. <verse eid="MAT 27:8" /><verse number="9" style="v" sid="MAT 27:9" />Nuuko huuzuzwa ibyari byarahanuuwe n'umuhanuuzi Yeremiya<note caller="+" style="f"><char style="fr" closed="false">27:9 </char><char style="ft" closed="false">Ibindi byanditswe bivuga </char><char style="fqa" closed="false">Zakariya </char></note> ati, “Bajanye ibiceri by'ifeeza mirongo itatu, ari co giciiro bamwe mu Biisirayeli baari biyemeje kumugura, <verse eid="MAT 27:9" /><verse number="10" style="v" sid="MAT 27:10" />babiguramo umurima w'Umubumbyi, nk'uko Nyagasani yabitegetse.”<verse eid="MAT 27:10" /></para>
  <para style="s1">Yesu Abazwa na Pilaato</para>
  <para style="r">(<ref loc="MRK 15:2-5">Mar 15:2-5</ref>; <ref loc="LUK 23:3-5">Luk 23:3-5</ref>; <ref loc="JHN 18:33-38">Yoh 18:33-38</ref>)</para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 27:11" />Yesu ahagarara imbere y'umutegetsi w'i Rooma wiitwaga Pilaato. Uwo mutegetsi abaza Yesu ati, “Ni wowe mwami w'Abayuuda?” Yesu aramusubiza ati, “Urabyivugiye”. <verse eid="MAT 27:11" /><verse number="12" style="v" sid="MAT 27:12" />Ariko abatware b'Abaheerezabitambo n'abakuru b'imiryango baamureze, ntiyagira ico abasubiza. <verse eid="MAT 27:12" /><verse number="13" style="v" sid="MAT 27:13" />Nuuko Pilaato aramubaza ati, “Mbese ntiwumva ibyo birego byose bakurega?” <verse eid="MAT 27:13" /><verse number="14" style="v" sid="MAT 27:14" />Ariko Yesu ntiyagira ijambo na rimwe asubiza Pilaato ku byo bamurega maze Pilaato biramutangaaza caane.<verse eid="MAT 27:14" /></para>
  <para style="s1">Yesu Bamuciira Urubanza rwo Gupfa</para>
  <para style="r">(<ref loc="MRK 15:6-15">Mar 15:6-15</ref>; <ref loc="LUK 23:13-25">Luk 23:13-25</ref>; <ref loc="JHN 18:39">Yoh 18:39</ref>; <ref loc="JHN 19:16">19:16</ref>)</para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 27:15" />Buri munsi mukuru wo Kunyurwaho, umutegetsi w'i Rooma yari yaramenyeereje abantu kubarekurira umwe mu basibe wo biishaakiraga. <verse eid="MAT 27:15" /><verse number="16" style="v" sid="MAT 27:16" />Muri ico gihe haari umusibe w'ikirangirire wiitwaga Yesu<note caller="+" style="f"><char style="fr" closed="false">27:16 </char><char style="ft" closed="false">Bimwe mu byanditswe byera ntihongerwaho irindi zina rya Baraba ari ryo Yesu</char></note> Baraba. <verse eid="MAT 27:16" /><verse number="17" style="v" sid="MAT 27:17" />Nuuko abantu bamaze guteerana, Pilaato arababaza ati, “Muri aba babiri uwo mushaaka ko mbarekurira ni nde, Yesu Baraba cangwa Yesu wiitwa Kristo?” <verse eid="MAT 27:17" /><verse number="18" style="v" sid="MAT 27:18" />Kuko yari azi neeza ko abayobozi b'Abayuuda bamugabije Yesu<note caller="+" style="f"><char style="fr" closed="false">27:18 </char><char style="ft" closed="false">Mesiya</char></note> biteewe n'ishari baamugiriye. <verse eid="MAT 27:18" /><verse number="19" style="v" sid="MAT 27:19" />Ubwo yari aciicaye ku ntebe y'imanza, umugore we amwoherereza ubutumwa ati, “Ntuugire ico utwara uwo mugabo w'umuziranenge, naraaye ndoose byinshi bifashe kuri we, kandi byambujije amahoro.”<verse eid="MAT 27:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 27:20" />Nuuko abatware b'Abaheerezabitambo n'abakuru b'imiryango boosha rubanda ko bakwiriye gusaba Baraba akarekurwa ariko Yesu we bakamwica. <verse eid="MAT 27:20" /><verse number="21" style="v" sid="MAT 27:21" />Nuuko umutegetsi yongera kubabaza ati, “Mbese muri aba bombi, mushaaka ngo mbarekurire uwuuhe?” Baramusubiza bati, “Ni Baraba.” <verse eid="MAT 27:21" /><verse number="22" style="v" sid="MAT 27:22" />Pilaato arababaza ati, “Yesu wiitwa Kristo we mukorere iki?” Boose bavugira hamwe bati,</para>
  <para style="p" vid="MAT 27:22">“Naabambwe!”<verse eid="MAT 27:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 27:23" />Pilaato arongera arababaza ati, “Kuki, yakoze caaha ki?”</para>
  <para style="p" vid="MAT 27:23">Ariko bakomeza guteera heejuru bavuga bati, “Naabambwe!”<verse eid="MAT 27:23" /></para>
  <para style="s">Pilaato Atanga Yesu ngo Abambwe</para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 27:24" />Pilaato aboonye ko ntaaco yaabikorera, ahuubwo ko byateera agasasamaro, afata amaazi akarabira intoki imbere ya rubanda, aravuga ati, “Ndi umwere w'amaraso y'uyu muntu, birabe ibyanyu.” <verse eid="MAT 27:24" /><verse number="25" style="v" sid="MAT 27:25" />Rubanda basubiriza hamwe bati, “Amaraso ye azaatubarweho n'abaana baacu!” <verse eid="MAT 27:25" /><verse number="26" style="v" sid="MAT 27:26" />Nuuko abarekurira Baraba, ategeka ko bakubita Yesu<note caller="+" style="f"><char style="fr" closed="false">27:26 </char><char style="ft" closed="false">Kristo</char></note>, haanyuma aramubaha ngo bamubambe.<verse eid="MAT 27:26" /></para>
  <para style="s1">Abasirikare Bashinyagurira Yesu</para>
  <para style="r">(<ref loc="MRK 15:16-20">Mar 15:16-20</ref>; <ref loc="JHN 19:2-3">Yoh 19:2-3</ref>)</para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 27:27" />Nuuko abasirikare ba Pilaato bajaana Yesu mu gikaari c'umutegeka, umutwe w'abasirikare woose uramwitooroora. <verse eid="MAT 27:27" /><verse number="28" style="v" sid="MAT 27:28" />Bamukuuramo imyambaro ye, bamwambika igishuura gitukura, <verse eid="MAT 27:28" /><verse number="29" style="v" sid="MAT 27:29" />bamaze kuboha ikamba ry'amahwa, barimwambika ku mutwe. Bamufatiisha urubingo mu kuboko kwe kw'iburyo, maze baramupfukamira kandi bamushinyagurira bavuga bati, “Urakarama, Mwami w'Abayuuda!” <verse eid="MAT 27:29" /><verse number="30" style="v" sid="MAT 27:30" />Nuuko bamuciiraho, bafata urubingo barumukubita mu mutwe. <verse eid="MAT 27:30" /><verse number="31" style="v" sid="MAT 27:31" />Barangije kumushinyagurira, bamukuuramo ca gishuura, bamwambika imyambaro ye, bamujaana kumubamba.<verse eid="MAT 27:31" /></para>
  <para style="s1">Yesu Abambwa ku Musaraba</para>
  <para style="r">(<ref loc="MRK 15:21-32">Mar 15:21-32</ref>; <ref loc="LUK 23:26-43">Luk 23:26-43</ref>; <ref loc="JHN 19:17-27">Yoh 19:17-27</ref>)</para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 27:32" />Bagisohoka, bahuura na Simooni w'Umunyakureeni, bamuhata kwikorera umusaraba wa Yesu. <verse eid="MAT 27:32" /><verse number="33" style="v" sid="MAT 27:33" />Bageze mu mwanya wiitwa Gorogota, kimenyeesha Ku k'igihanga, <verse eid="MAT 27:33" /><verse number="34" style="v" sid="MAT 27:34" />bamusomya divaayi ivanze n'indurwe<note caller="+" style="f"><char style="fr" closed="false">27:34 </char><char style="ft" closed="false">ikintu gishaarira</char></note>, asogongeye yanga kuyinywa. <verse eid="MAT 27:34" /><verse number="35" style="v" sid="MAT 27:35" />Bamaze kumubamba, bagabana imyenda ye bakoreesheje ubufindo. <verse eid="MAT 27:35" /><verse number="36" style="v" sid="MAT 27:36" />Abasirikare biicara aho, barinda Yesu. <verse eid="MAT 27:36" /><verse number="37" style="v" sid="MAT 27:37" />Heejuru y'umutwe wa Yesu bashiraho icaapa canditsweho ngo, “Uyu ni Yesu Umwami w'Abayuuda” <verse eid="MAT 27:37" /><verse number="38" style="v" sid="MAT 27:38" />Nuuko bamubamba n'abambuzi babiri, umwe iburyo bwe undi ibumoso bwe. <verse eid="MAT 27:38" /><verse number="39" style="v" sid="MAT 27:39" />Abantu baanyuragaho baaramutukaga, bakazunguza umutwe <verse eid="MAT 27:39" /><verse number="40" style="v" sid="MAT 27:40" /><note caller="-" style="x"><char style="xo" closed="false">27:40 </char><char style="xt" closed="false"><ref loc="MAT 26:61">Mat 26:61</ref>; <ref loc="JHN 2:19">Yoh 2:19</ref>.</char></note>bati, “Woowe waaseenya Inzu y'Imaana ukayubaka mu minsi itatu, ikize! Niiba uri Umwana w'Imaana koko, manuka uve ku musaraba!” <verse eid="MAT 27:40" /><verse number="41" style="v" sid="MAT 27:41" />Abatware b'Abaheerezabitambo hamwe, n'Abiigiishamategeko n'abakuru b'imiryango na bo bashinyagurira Yesu batyo <verse eid="MAT 27:41" /><verse number="42" style="v" sid="MAT 27:42" />bavuga bati, “Yakijije abandi ariko we ntiyakwikiza. Ni umwami w'Abiisirayeli, naamanuke ku musaraba noone aha nuuko naatwe tumwemere. <verse eid="MAT 27:42" /><verse number="43" style="v" sid="MAT 27:43" />Yiringira Imaana, reka reero Imaana imukize ubu, niiba ibishaaka, kuko yavuze ngo, ‘Ndi Umwana w'Imaana.’ ” <verse eid="MAT 27:43" /><verse number="44" style="v" sid="MAT 27:44" />Ba bambuzi baari babambwe hamwe na Yesu na bo bamutuka batyo.<verse eid="MAT 27:44" /></para>
  <para style="s1">Urupfu rwa Yesu</para>
  <para style="r">(<ref loc="MRK 15:33-41">Mar 15:33-41</ref>; <ref loc="LUK 23:44-49">Luk 23:44-49</ref>; <ref loc="JHN 19:28-30">Yoh 19:28-30</ref>)</para>
  <para style="p">
    <verse number="45" style="v" sid="MAT 27:45" />Kuva saaha itandatu z'amanywa kugeza saaha cenda z'umugorooba isi yoose icura umwijima. <verse eid="MAT 27:45" /><verse number="46" style="v" sid="MAT 27:46" />Maze nko ku saaha icenda z'umugorooba, Yesu ataka n'ijwi rirenga ati, “Eli Eli lama sabakitani?” Bisobaanura ngo, “Maana yanje, Maana yanje, ni iki gitumye unteererana?” <verse eid="MAT 27:46" /><verse number="47" style="v" sid="MAT 27:47" />Bamwe mu baari bahagaze aho babyumviise baravuga bati, “Uyu mugabo aratabaaza Eliya!” <verse eid="MAT 27:47" /><verse number="48" style="v" sid="MAT 27:48" />Ako kaanya umwe muri bo ariiruka afata icangwe, acuuzuza divaayi ishaariira, agishira ku rubingo, aramuheereza ngo anywe. <verse eid="MAT 27:48" /><verse number="49" style="v" sid="MAT 27:49" />Ariko abandi baravuga bati, “Reka tureebe niiba Eliya araaza kumukiza.”<note caller="+" style="f"><char style="fr" closed="false">27:49 </char><char style="ft" closed="false">Ibindi byanditswe byera bivuga ko bamucumise icumu mu rubavu hakavamo amaazi na maraso.</char></note> <verse eid="MAT 27:49" /><verse number="50" style="v" sid="MAT 27:50" />Nuuko Yesu yongera gutaka n'ijwi rirenga maze arapfa. <verse eid="MAT 27:50" /><verse number="51" style="v" sid="MAT 27:51" />Ako kaanya umwenda wari umanitswe mu Nzu y'Imaana ushishimukamo kabiri, kuva heejuru kugera haasi. Isi ihinda umushitsi maze ibitare birasaduka. <verse eid="MAT 27:51" /><verse number="52" style="v" sid="MAT 27:52" />Ibituuro birakinguuka, n'imibiri y'abeera baapfuuye irazuurwa, <verse eid="MAT 27:52" /><verse number="53" style="v" sid="MAT 27:53" />maze iva mu bituuro. Yesu amaze kuzuuka, baja mu tawuni yeera y'i Yerusaalemu, babonekera abantu benshi.<verse eid="MAT 27:53" /></para>
  <para style="p">
    <verse number="54" style="v" sid="MAT 27:54" />Umutware utegeka abasirikare ijana n'abaari kumwe na we barinda Yesu, baboonye umushitsi n'ibibaaye bagira ubwoba bwinshi caane, baratiinya, baravuga bati, “Uyu yari Umwana w'Imaana.” <verse eid="MAT 27:54" /><verse number="55" style="v" sid="MAT 27:55" /><note caller="-" style="x"><char style="xo" closed="false">27:55 </char><char style="xt" closed="false"><ref loc="LUK 8:2">Luk 8:2</ref>,<ref loc="LUK 8:3">3</ref>.</char></note>Haariho abagore benshi bahagaze bareebera kure. Baari baherekeje Yesu kuva i Galileeya bamuheereza ibyo yifuuza. <verse eid="MAT 27:55" /><verse number="56" style="v" sid="MAT 27:56" />Muri bo haarimo, Mariya Magadaleena, Mariya nyina wa Yaakobo na Yozefu, na nyina wa beene Zebedaayo.<verse eid="MAT 27:56" /></para>
  <para style="s1">Guhambwa kwa Yesu.</para>
  <para style="r">(<ref loc="MRK 15:42-47">Mar 15:42-47</ref>; <ref loc="LUK 23:50-56">Luk 23:50-56</ref>; <ref loc="JHN 19:38-42">Yoh 19:38-42</ref>)</para>
  <para style="p">
    <verse number="57" style="v" sid="MAT 27:57" />Bugoroobye, haaza umugabo w'umukire uturuka Arimatiya, witwaga Yozefu, kandi na we yari Umwigiishwa wa Yesu. <verse eid="MAT 27:57" /><verse number="58" style="v" sid="MAT 27:58" />Aja kwa Pilaato amusaba umurambo wa Yesu. Pilaato ategeka ko bawumuha. <verse eid="MAT 27:58" /><verse number="59" style="v" sid="MAT 27:59" />Yozefu ajaana umurambo wa Yesu awuzinga mu mwenda w'umweru usukuuye, <verse eid="MAT 27:59" /><verse number="60" style="v" sid="MAT 27:60" />awuhamba mu mva ye nsha yari yaracukuye mu ibuye ry'urutare. Haanyuma abirindurira ikibuye kinini ku muryango w'igituuro maze ariigendera. <verse eid="MAT 27:60" /><verse number="61" style="v" sid="MAT 27:61" />Mariya Magadaleena na Mariya wundi baari aho, biicaye ahateeganye n'ico gituuro.<verse eid="MAT 27:61" /></para>
  <para style="s1">Abasirikare Barinda Igituuro ca Yesu</para>
  <para style="p">
    <verse number="62" style="v" sid="MAT 27:62" />Umunsi wakurikiyeho ari wo Saabato, abatware b'Abaheerezabitambo n'Abafarisaayo bateeranira kwa Pilaato <verse eid="MAT 27:62" /><verse number="63" style="v" sid="MAT 27:63" /><note caller="-" style="x"><char style="xo" closed="false">27:63 </char><char style="xt" closed="false"><ref loc="MAT 16:21">Mat 16:21</ref>; <ref loc="MAT 17:23">17:23</ref>; <ref loc="MAT 20:19">20:19</ref>; <ref loc="MRK 8:31">Mar 8:31</ref>; <ref loc="MRK 9:31">9:31</ref>; <ref loc="MRK 10:33">10:33</ref>,<ref loc="MRK 10:34">34</ref>; <ref loc="LUK 9:22">Luk 9:22</ref>; <ref loc="LUK 18:31-33">18:31-33</ref>.</char></note>baramubwira bati, “Nyakuubahwa, ibuka neeza yuuko wa mubeeshi akiriho yavuze ati, ‘Haanyuma y'iminsi itatu nzaazuuka.’ <verse eid="MAT 27:63" /><verse number="64" style="v" sid="MAT 27:64" />Nuuko reero tegeka habeho kurinda igituuro kugeza ku munsi wa gatatu. Naho ubundi abiigiishwa be baaza bakamwiba, bakabwira abantu bati, ‘Yazuutse mu baapfuuye!’ Nuuko ikinyoma ca nyuma kikaruta ica mbere.” <verse eid="MAT 27:64" /><verse number="65" style="v" sid="MAT 27:65" />Pilaato arababwira ati, “Mufite abasirikare b'abarinzi, nimugende murinde ico gituuro nk'uko mushoboye.” <verse eid="MAT 27:65" /><verse number="66" style="v" sid="MAT 27:66" />Nuuko bagenda n'abarinzi maze bareeba ngo igituuro kirinzwe neeza, kandi kuri rya buye ripfundikiyeho bashiraho akamenyeetso.<verse eid="MAT 27:66" /></para>
  <chapter eid="MAT 27" />
  <chapter number="28" style="c" sid="MAT 28" />
  <para style="s1">Kuzuuka kwa Yesu</para>
  <para style="r">(<ref loc="MRK 16:1-10">Mar 16:1-10</ref>; <ref loc="LUK 24:1-12">Luk 24:1-12</ref>; <ref loc="JHN 20:1-10">Yoh 20:1-10</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 28:1" />Isaabato irangiye, ku munsi wa mbere w'icumweru, bugiiye guca, Mariya Magadaleena na Mariya wundi baja kureeba ca gituuro. <verse eid="MAT 28:1" /><verse number="2" style="v" sid="MAT 28:2" />Ako kaanya habaho umushitsi, malayika wa Nyagasani, amanuka avuuye mu ijuru, abirindura ca kibuye kinini, aciicaraho. <verse eid="MAT 28:2" /><verse number="3" style="v" sid="MAT 28:3" />Ishusho ye yasaga nk'umurabyo kandi imyambaro ye yari umweru nk'urubura. <verse eid="MAT 28:3" /><verse number="4" style="v" sid="MAT 28:4" />Abarinzi bagira ubwoba bwinshi caane bahinda umushitsi, bamera nk'abapfuuye. <verse eid="MAT 28:4" /><verse number="5" style="v" sid="MAT 28:5" />Nuuko malayika abwira ba bagore ati, “Mwitiinya. Nzi yuuko mushaaka Yesu wabambwe ku musaraba. <verse eid="MAT 28:5" /><verse number="6" style="v" sid="MAT 28:6" />Ntaabwo ari hano. Imaana yamuzuuye, nk'uko yabivuze. Muuze mureebe aho umubiri we wari uri. <verse eid="MAT 28:6" /><verse number="7" style="v" sid="MAT 28:7" />Ni mugende mwihuuta mubwire abiigiishwa be ko yazuutse, kandi ko agiiye kubatanga kugera i Galileeya, ni ho namwe muzaamubonera. Ubu ni bwo butumwa nari mbafitiye.” <verse eid="MAT 28:7" /><verse number="8" style="v" sid="MAT 28:8" />Nuuko bava ku gituuro bafite ubwoba n'umuneezeero mwinshi, bagenda biruka baja kubibwira abiigiishwa. <verse eid="MAT 28:8" /><verse number="9" style="v" sid="MAT 28:9" />Bakigenda, bahuura na Yesu, arabaramutsa agira ati, “Amahoro abe muri mwe” Baramwegeera, bapfukama imbere ye, bafata ku birenge bye, baramuramya. <verse eid="MAT 28:9" /><verse number="10" style="v" sid="MAT 28:10" />Yesu arababwira ati, “Mwitiinya, ni mugende mubwire beene Daata kuja i Galileeya ni ho bazambonera.”<verse eid="MAT 28:10" /></para>
  <para style="s">Abarinzi Bavuga ibyo Baaboonye</para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 28:11" />Ba bagore bakigenda, bamwe mu barinzi baja mu tawuni nkuru maze babwira abatware b'abaheerezabitambo ibyabaye byose. <verse eid="MAT 28:11" /><verse number="12" style="v" sid="MAT 28:12" />Abatware b'abaheerezabitambo bahuura n'abakuru b'imiryango, nuuko baja inaama, yo guha abarinzi amashilingi menshi, <verse eid="MAT 28:12" /><verse number="13" style="v" sid="MAT 28:13" />barababwira bati, “Muzaavuge muti, ‘Abiigiishwa be baaje n'ijoro biiba umurambo we dusinziiriye.’ <verse eid="MAT 28:13" /><verse number="14" style="v" sid="MAT 28:14" />Umutegetsi mukuru ni abyumva, turabimwemeza kandi namwe tubarinde ingoorane mwari kugira.” <verse eid="MAT 28:14" /><verse number="15" style="v" sid="MAT 28:15" />Nuuko abarinzi bajaana ya mashilingi, kandi babikora nk'uko baategetswe. Iyi nkuru iracaavugwa mu Bayuuda kugeza n'uyu munsi.<verse eid="MAT 28:15" /></para>
  <para style="s1">Yesu Abonekera Abiigiishwa be</para>
  <para style="r">(<ref loc="MRK 16:14-18">Mar 16:14-18</ref>; <ref loc="LUK 24:36-49">Luk 24:36-49</ref>; <ref loc="JHN 20:19-23">Yoh 20:19-23</ref>; <ref loc="REV 1:6-8">Ibya 1:6-8</ref>)</para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 28:16" />
    <note caller="-" style="x">
      <char style="xo" closed="false">28:16 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 26:32">Mat 26:32</ref>; <ref loc="MRK 14:28">Mar 14:28</ref>.</char>
    </note>Nuuko ba biigiishwa cumi n'umwe baja i Galileeya, ku musozi Yesu yari yarabategetse. <verse eid="MAT 28:16" /><verse number="17" style="v" sid="MAT 28:17" />Bamuboonye, baramuramya, ariko bamwe barashidiikanya. <verse eid="MAT 28:17" /><verse number="18" style="v" sid="MAT 28:18" />Yesu aja aho bari arababwira ati, “Nahaawe ububaasha bwose mu ijuru no mu isi. <verse eid="MAT 28:18" /><verse number="19" style="v" sid="MAT 28:19" /><note caller="-" style="x"><char style="xo" closed="false">28:19 </char><char style="xt" closed="false"><ref loc="ACT 1:8">Iby 1:8</ref>.</char></note>Nuuko reero, ni mugende mwigiishe abantu boose, mubabatiza mu izina rya Daata wa twese, n'iry'Umwana, n'iry'Umwuka wera, <verse eid="MAT 28:19" /><verse number="20" style="v" sid="MAT 28:20" />mubiigiishe kumvira ibyo nabategetse byose. Kandi dore ndi kumwe namwe kugeza ku mperuuka y'isi.”<verse eid="MAT 28:20" /></para>
  <chapter eid="MAT 28" />
</usx>