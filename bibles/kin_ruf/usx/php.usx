<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="PHP" style="id">- Rufumbira New Testament</book>
  <para style="h">ABAFILIPI</para>
  <para style="toc3">Fil</para>
  <para style="toc2">ABAFILIPI</para>
  <para style="toc1">Urwandiko Intumwa Pawulo yandikiye ABAFILIPI</para>
  <para style="mt1">ABAFILIPI</para>
  <para style="imt">INYANZURO</para>
  <para style="im">
    <char style="bk">Urwandiko Intumwa Pawulo yandikiye Abafilipi </char> rwandikiwe Itoorero rya mbere ryo Pawulo yari yarashinze ku butaka bw' i Buraayi, mu gice kinini c'i Rooma y'i Makedooniya. Uru rwandiko rwanditswe ubwo Intumwa Pawulo yari ari mu gihome. Ico gihe yari ahangayikiishijwe n'uko abandi bakristo bo baakoranaga umurimo baamuhakanyaga kandi akababazwa n'inyigiisho z'ibinyoma zaari ziri mu itoorero ry'i Filipi. Nyamara uru rwandiko ruzana agahenge ku muneezeero no kudaciika intege bibaasha gusobaanurwa no kwizeera guhebuuje ko Pawulo afite muri Yesu Kristo.</para>
  <para style="ip">Icaatumye Pawulo yiihuutira kwandika uru rwandiko ni ugushiima abakristo b' i Filipi ku bw'ubufasha bari baaramwoherereje kwifashiisha mu gihe yari abwifuuza. Akoreesha uyu mugisha kubeemeza ngo bagire ubutwari kandi bakomere nuubwo yari afite ibimuhagaritse umutima ubwe kandi na bo bakagira ibibagooye. Abinginga kugira imyifatire iciiye bugufi nk'iya Yesu aho kuyoborwa no kwikunda hamwe no kwibona. Abiibutsa ko umubaano bafitanye na Kristo ari impaano y'ubuntu bw'Imaana baakiiriye binyuze mu kwizeera atari ku bwo kuubahiriza imihango yo mu mategeko y'Abayuuda. Yandika iby'umuneezeero hamwe n'amahoro Imaana iha abo baba mu mubaano na Kristo.</para>
  <para style="ip">Uru rwandiko rurangwa n'uburyo rushingiye ku muneezeero, kudaciika intege, ubumwe hamwe no kwihangaana mu kwizeera k'ubukristo hamwe n'ubuzima. Rwongera guhishuura umutima Pawulo yari afitiye itoorero rya Filipi.</para>
  <para style="iot">Ibirimo</para>
  <para style="io1">Inyanzuro <char style="ior"><ref loc="PHP 1:1-11">1:1-11</ref></char></para>
  <para style="io1">Ibyo Pawulo ubwe yari ari kunyuramo <char style="ior"><ref loc="PHP 1:12-26">1:12-26</ref></char></para>
  <para style="io1">Ubuzima bwo muri Kristo <char style="ior"><ref loc="PHP 1:27-2:18">1:27—2:18</ref></char></para>
  <para style="io1">Imigambi ya Timoteeyo na Epafura <char style="ior"><ref loc="PHP 2:19-30">2:19-30</ref></char></para>
  <para style="io1">Kwamagirira ibyerekeye abanzi n'akaaga <char style="ior"><ref loc="PHP 3:1-4:9">3:1—4:9</ref> </char></para>
  <para style="io1">Pawulo n'inshuti ze zo muri Filipi <char style="ior"><ref loc="PHP 4:10-20">4:10-20</ref></char></para>
  <para style="io1">Umusoozo <char style="ior"><ref loc="PHP 4:21-23">4:21-23</ref></char></para>
  <chapter number="1" style="c" sid="PHP 1" />
  <para style="s1">Indamutso</para>
  <para style="p">
    <verse number="1" style="v" sid="PHP 1:1" />
    <note caller="-" style="x">
      <char style="xo" closed="false">1:1 </char>
      <char style="xt" closed="false">
        <ref loc="ACT 16:12">Iby 16:12</ref>.</char>
    </note>Njeewe Pawulo na Timoteeyo abagaragu ba Yesu Kristo,</para>
  <para style="p" vid="PHP 1:1">Turabandikira mwebwe bantu b'Imaana mwese bo muri Filipi beemera Kristo Yesu hamwe n'abayobozi b'itoorero n'abadiyakooni.<verse eid="PHP 1:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="PHP 1:2" />Ubuntu n'amahoro biva ku Maana Daata hamwe n'Umwami Yesu Kristo bibe muri mwe.<verse eid="PHP 1:2" /></para>
  <para style="s">Isengeesho Pawulo Asabira Abafilipi</para>
  <para style="p">
    <verse number="3" style="v" sid="PHP 1:3" />Nshiima Imaana igihe coose mbateekerejeho, <verse eid="PHP 1:3" /><verse number="4" style="v" sid="PHP 1:4" />kandi igihe coose mbasengeye, bimpa umuneezeero <verse eid="PHP 1:4" /><verse number="5" style="v" sid="PHP 1:5" />kuko mwakomeje gufatanya nanje mu kwamamaza Ubutumwa Bwiza bwa Kristo uheereye ubwo mwabwumviise kugeza na n'ubu. <verse eid="PHP 1:5" /><verse number="6" style="v" sid="PHP 1:6" />Ndahamya neeza ntashidiikanya ko iyatangiye umurimo mwiza muri mwe izaawurangiza rwose kugeza ku munsi Yesu Kristo azaagaruka. <verse eid="PHP 1:6" /><verse number="7" style="v" sid="PHP 1:7" />Mbahoza ku mutima kandi koko birakwiriye ko mbateekerezaho ntyo kuko mukomeje gusangira nanje ubuntu bw'Imaana ubu ndi mu gihome, ndetse n'igihe nshigikira Ubutumwa Bwiza mpamya ko ari ubw'ukuri. <verse eid="PHP 1:7" /><verse number="8" style="v" sid="PHP 1:8" />Imaana ni yo njuriza ko mpora mbakumbuye mbiteewe n'urukundo rwa Kristo rundimo.<verse eid="PHP 1:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="PHP 1:9" />Isengesho ryanje ni ukugira ngo urukundo rwanyu rurusheho kugwira kandi mushobore kumenya no gusobaanukirwa, <verse eid="PHP 1:9" /><verse number="10" style="v" sid="PHP 1:10" />kugira ngo mushobore gutooranya iciiza kiruta ibindi. Nibwo muzaaba abeere kandi inyangamugayo ku munsi Kristo azaagaruka. <verse eid="PHP 1:10" /><verse number="11" style="v" sid="PHP 1:11" />Nuuko ubuzima bwanyu burangweho umusaaruuro w'imbuto z'ubutungaane zitangwa na Yesu Kristo weenyine kugira ngo Imaana ihaabwe ikuzo kandi ihimbaazwe.<verse eid="PHP 1:11" /></para>
  <para style="s">Ku Bwanje Kubaho ni Kristo</para>
  <para style="p">
    <verse number="12" style="v" sid="PHP 1:12" />Bakundwa, nshaaka ko mumenya yuuko ibyambaayeho byatumye ubutumwa bwiza bwamamara. <verse eid="PHP 1:12" /><verse number="13" style="v" sid="PHP 1:13" /><note caller="-" style="x"><char style="xo" closed="false">1:13 </char><char style="xt" closed="false"><ref loc="ACT 28:30">Iby 28:30</ref>.</char></note>Kandi ku bw'ibyo, abarinzi b'i bwami n'abandi bantu boose bari hano baazi neeza yuuko nsibwe ndyora Kristo. <verse eid="PHP 1:13" /><verse number="14" style="v" sid="PHP 1:14" />Ndetse gusibwa kwanje kwatumye abiizeera boose bakomerera mu Mwami bituma batiinyuuka igihe coose barikuvuga ijambo ry'Imaana.<verse eid="PHP 1:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="PHP 1:15" />Ni ukuri bamwe babwiriza ibya Kristo babiteewe n'ishari hamwe no gushaaka kurushanwa, ariko abandi babwiriza ibya Kristo n'umutima mwiza. <verse eid="PHP 1:15" /><verse number="16" style="v" sid="PHP 1:16" />Aba babwiriza ubutumwa babiteewe n'urukundo, kuko baazi neeza yuuko natooranyirijwe kurwanira Ubutumwa Bwiza. <verse eid="PHP 1:16" /><verse number="17" style="v" sid="PHP 1:17" />Abandi baamamaza ibya Kristo babiteewe n'uko biishaakira inyungu zaabo bwiite.<verse eid="PHP 1:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="PHP 1:18" />Ariko ibyo ntaaco bitwaye. Baaba babikorana imigambi mibi cangwa myiza, ubutumwa bwa Kristo buri kwamamazwa mu buryo bwose kandi ku bw'iyo mpamvu, ndabyishiimiye kandi nzaahora niishiima. <verse eid="PHP 1:18" /><verse number="19" style="v" sid="PHP 1:19" />Kuko nzi yuuko ku bw'amasengeesho yaanyu, no gufashwa n'Umwuka utangwa na Yesu Kristo, ibi bizamviiramo kubohoorwa. <verse eid="PHP 1:19" /><verse number="20" style="v" sid="PHP 1:20" />Ico niifuuza kandi mfitiye iciizeere ni ukugira ngo ntazaakorwa n'isoni mu buryo ubwo ari bwo bwose, ahuubwo mu kuvuga nshize amanga kwanje, Kristo ashirwe heejuru mu mibeereho yanje, ubu no kugeza iteeka ryose naaba ndi muzima cangwa mfuuye. <verse eid="PHP 1:20" /><verse number="21" style="v" sid="PHP 1:21" />Kuko ku bwanje kubaho ni Kristo kandi gupfa ni inyungu. <verse eid="PHP 1:21" /><verse number="22" style="v" sid="PHP 1:22" />Ariko reero niiba kubaho mu mubiri ari co kizaateera gukomeza kwera imbuto z'umurimo wanje sinzi ico naahitamo. <verse eid="PHP 1:22" /><verse number="23" style="v" sid="PHP 1:23" />Birankomereye guhitamo muri byombi. Kuko niifuuza caane kuva muri uyu mubiri nkabaana na Kristo kandi ni byo byambeera byiza bihebuuje, <verse eid="PHP 1:23" /><verse number="24" style="v" sid="PHP 1:24" />ariko kuguma mu mubiri ni byo by'ingirakamaro kuri mwe. <verse eid="PHP 1:24" /><verse number="25" style="v" sid="PHP 1:25" />Nuuko reero ubwo maze kwemezwa, nzi neeza yuuko nzaagumana namwe kugira ngo nkomeze kubafasha mwese gukura ndetse no kugira umuneezeero wo kwizeera kwanyu. <verse eid="PHP 1:25" /><verse number="26" style="v" sid="PHP 1:26" />Kandi kugira ngo ninongera kugaruka iwaanyu, muzaarusheho kugira impamvu zo kwishiimira muri Kristo ku bw'ibyo ari gukora muri nje.<verse eid="PHP 1:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="PHP 1:27" />Ikiruta byose, mukwiriye gukora ibikwiranye n'ubutumwa bwiza bwa Kristo kugira ngo niiyo naaba nje kubasuura cangwa sinze, nzumve ko mukomereye mu mwuka umwe, muhuuje umugambi kandi murwanira hamwe ku bwo kwizeera Ubutumwa Bwiza. <verse eid="PHP 1:27" /><verse number="28" style="v" sid="PHP 1:28" />Ntimugateerwe ubwoba n'abanzi baanyu ahuubwo igihe coose muzaahore mufite ubutwari kuko iki ni co kizaabagaragariza ko bagiiye kurimburwa naho mwe mukarokoka kuko ni Imaana ibaha intsinzi. <verse eid="PHP 1:28" /><verse number="29" style="v" sid="PHP 1:29" />Kuko mutaahaawe umugisha wo kwizeera Kristo gusa, ahuubwo mwahaawe no kubabazwa ku bwe. <verse eid="PHP 1:29" /><verse number="30" style="v" sid="PHP 1:30" /><note caller="-" style="x"><char style="xo" closed="false">1:30 </char><char style="xt" closed="false"><ref loc="ACT 16:19-40">Iby 16:19-40</ref>.</char></note>Turi hamwe mu rugamba. Mwitegereje urugamba narwanye mu gihe caashize kandi murabiizi ko nkirurimo na n'ubu.<verse eid="PHP 1:30" /></para>
  <chapter eid="PHP 1" />
  <chapter number="2" style="c" sid="PHP 2" />
  <para style="s">Kwiciisha Bugufi no Gukomera Kwa Kristo</para>
  <para style="p">
    <verse number="1" style="v" sid="PHP 2:1" />Ubwo reero ubuzima bwanyu muri Kristo bubaha gukomera, urukundo rwe rukabahuumuriza, mufite ubumwe n'Umwuka kandi mugirirana impuhwe n'imbabazi. <verse eid="PHP 2:1" /><verse number="2" style="v" sid="PHP 2:2" />Ngaaho nimunsendeerezemo umuneezeero muhuuje ibiteekerezo hamwe n'urukundo kandi mwibwira bimwe mu mitima yaanyu no mu biteekerezo. <verse eid="PHP 2:2" /><verse number="3" style="v" sid="PHP 2:3" />Ntimukagire ico mukora mubiteewe no kwikunda cangwa kwishira heejuru, ahuubwo mu kwiciisha bugufi kwanyu umuntu weese yibwire ko mugenzi we amuruta. <verse eid="PHP 2:3" /><verse number="4" style="v" sid="PHP 2:4" />Umuntu weese muri mwe ye kwita ku byifuuzo bye gusa ahuubwo azirikane n'iby'abandi. <verse eid="PHP 2:4" /><verse number="5" style="v" sid="PHP 2:5" />Mugire umutima nk'uwari muri Kristo.<verse eid="PHP 2:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PHP 2:6" />We, nuubwo yari afite kamere y'Imaana,</para>
  <para style="q2" vid="PHP 2:6">ntiyiigeze ateekereza ko guhwana n'Imaana ari ikintu co kugundiira,<verse eid="PHP 2:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PHP 2:7" />ahuubwo yiiyambuye icuubahiro ce,</para>
  <para style="q2" vid="PHP 2:7">ajaana kamere y'umugaragu.</para>
  <para style="q1" vid="PHP 2:7">Avuukira mu ishusho y'umuntu.</para>
  <para style="q2" vid="PHP 2:7">Kandi amaze kuboneka afite ishusho y'umuntu,<verse eid="PHP 2:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PHP 2:8" />yiiciisha bugufi kandi arumvira, kugeza ku gupfa</para>
  <para style="q2" vid="PHP 2:8">ndetse apfa urupfu rwo ku musaraba.<verse eid="PHP 2:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PHP 2:9" />No ku bw'iyo mpamvu, Imaana na yo yamushize heejuru caane</para>
  <para style="q2" vid="PHP 2:9">kandi imuha izina riruta ayandi mazina yoose,<verse eid="PHP 2:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PHP 2:10" />kugira ngo mu izina rya Yesu, amavi yoose apfukame,</para>
  <para style="q2" vid="PHP 2:10">yaaba ay'ibiremwa byo mu ijuru cangwa ibyo ku isi n'ibyo munsi y'isi,<verse eid="PHP 2:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PHP 2:11" />kandi buri rurimi rwature ko Yesu Kristo ari Umwami,</para>
  <para style="q2" vid="PHP 2:11">ngo Imaana Daata ihaabwe ikuzo.<verse eid="PHP 2:11" /></para>
  <para style="s1">Kumurika nk'Umuco w'Isi</para>
  <para style="p">
    <verse number="12" style="v" sid="PHP 2:12" />Nuuko reero bakundwa, nk'uko mwahoze munyumvira ndi kumwe namwe ubu murusheho kunyumvira ubwo ntari kumwe namwe. Mugaragaze ibikorwa by'agakiza kaanyu mutiinya kandi mwubaha Imaana, <verse eid="PHP 2:12" /><verse number="13" style="v" sid="PHP 2:13" />kuko Imaana ni yo ikorera muri mwe kandi ibashoboza gushaaka no gukora ibyo yiishiimira.<verse eid="PHP 2:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="PHP 2:14" />Mukore byose mutiitotomba kandi mutagiishanya impaka, <verse eid="PHP 2:14" /><verse number="15" style="v" sid="PHP 2:15" />kugira ngo mube abeere kandi intungaane. Mube abaana b'Imaana batagira inenge hagati y'abantu b'iki gihe b'indyarya hamwe n'abahemu, bo mumurikira nk'inyenyeeri muri iyi isi. <verse eid="PHP 2:15" /><verse number="16" style="v" sid="PHP 2:16" />Ni ku bwo gushikama ku jambo ry'ubugingo kwanyu ko nziiraatana ku munsi wo Kristo azaagarukiraho yuuko ntiirukiye ubusa cangwa ngo nkorere ubusa.<verse eid="PHP 2:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="PHP 2:17" />Ariko nuubwo amaraso yanje yaaba ayo gusukwa ku itambiro nk'igitambo ngo abe ituuro ry'ukwizeera kwanyu, nzaabyishiimira kandi namwe mwishiimane nanje. <verse eid="PHP 2:17" /><verse number="18" style="v" sid="PHP 2:18" />Namwe ni uko, mukwiriye kwishiima kandi mugasangira nanje umuneezeero.<verse eid="PHP 2:18" /></para>
  <para style="s">Timoteeyo na Epafura</para>
  <para style="p">
    <verse number="19" style="v" sid="PHP 2:19" />Mfite ibyiringiro mu Mwami Yesu ko nzaabatumaho Timoteeyo bidatinze kugira ngo nshobore guhuumurizwa n'inkuru yaanyu. <verse eid="PHP 2:19" /><verse number="20" style="v" sid="PHP 2:20" />Ntaawundi mfite nka we uziita ku byanyu. <verse eid="PHP 2:20" /><verse number="21" style="v" sid="PHP 2:21" />Abandi boose baharanira inyungu zaabo aho kwita ku bya Yesu Kristo. <verse eid="PHP 2:21" /><verse number="22" style="v" sid="PHP 2:22" />Ariko muuzi neeza uko Timoteeyo yagaragaje agaciiro ke, uko we nanje nk'umwana na se, twakoranye mu kwamamaza Ubutumwa Bwiza. <verse eid="PHP 2:22" /><verse number="23" style="v" sid="PHP 2:23" />Niringiye kuzaamubatumaho vuba niimara kumenya ibigiiye kumbaho hano. <verse eid="PHP 2:23" /><verse number="24" style="v" sid="PHP 2:24" />Kandi ndizeera mu Mwami ko nanje ubwanje nzaaza kubareeba bidatinze.<verse eid="PHP 2:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="PHP 2:25" />Nateekereje yuuko ari ngombwa ko naabooherereza mwene daata Epafura, dufatanyije umurimo kandi turwana hamwe urugamba. Ni intumwa yaanyu kandi ni we unkorera ibyo nkennye. <verse eid="PHP 2:25" /><verse number="26" style="v" sid="PHP 2:26" />Amaze igihe yiifuuza kubareebaho kandi ahangayikiishijwe n'uko mwumviise ko arwaye. <verse eid="PHP 2:26" /><verse number="27" style="v" sid="PHP 2:27" />Ni koko yararwaye bikabije kugeza ubwo yari agiiye gupfa. Ariko Imaana yamugiriye imbabazi, kandi atari we gusa, ahuubwo nanje kugira ngo ntongera undi mubabaro ku wo nari nsanganywe. <verse eid="PHP 2:27" /><verse number="28" style="v" sid="PHP 2:28" />Ndashiishikarira kumubooherereza kugira ngo mushobore kongera kwishiima mumuboonye kandi nanje nshire agahinda. <verse eid="PHP 2:28" /><verse number="29" style="v" sid="PHP 2:29" />Nuuko reero mumwakiirane umuneezeero mu Mwami kandi muje mwubaha abantu nkaabo, <verse eid="PHP 2:29" /><verse number="30" style="v" sid="PHP 2:30" />kuko yahaze ubuzima bwe kugeza ubwo yari agiiye gupfa azize umurimo wa Kristo, kugira ngo angezeho ubufasha bwo mwe mutaari kungezaho.<verse eid="PHP 2:30" /></para>
  <chapter eid="PHP 2" />
  <chapter number="3" style="c" sid="PHP 3" />
  <para style="s">Ubutungaane Nyakuri</para>
  <para style="p">
    <verse number="1" style="v" sid="PHP 3:1" />Ibisigaye bavandimwe, mwishiimire mu Mwami. Sindambirwa kubandikira nsubiramo ibyo niigeze kubandikira igihe bibafitiye akamaro. <verse eid="PHP 3:1" /><verse number="2" style="v" sid="PHP 3:2" />Mwirinde abo bantu biitwara nk'imbwa, mwirinde abagizi ba naabi, mwirinde abo bakeba umubiri. <verse eid="PHP 3:2" /><verse number="3" style="v" sid="PHP 3:3" />Ni twe twakebwe by'ukuri kuko turamya Imaana mu Mwuka kandi tukiishiimira muri Kristo Yesu aho kwiringira iby'umubiri, <verse eid="PHP 3:3" /><verse number="4" style="v" sid="PHP 3:4" />nuubwo nanje ubwanje mfite impamvu zo kwiringira iby'umubiri. Niiba hari undi weese ufite impamvu zo kwiringira iby'umubiri, njeewe ndazimurusha, <verse eid="PHP 3:4" /><verse number="5" style="v" sid="PHP 3:5" /><note caller="-" style="x"><char style="xo" closed="false">3:5 a </char><char style="xt" closed="false"><ref loc="ROM 11:1">Rom 11:1</ref>; </char><char style="xo" closed="false">b </char><char style="xt" closed="false"><ref loc="ACT 23:6">Iby 23:6</ref>; <ref loc="ACT 26:5">26:5</ref>.</char></note>kuko nakebwe ku munsi wa munaane, ndi uwo mu bwoko bwa Isirayeli mu muryango wa Benjamiini, ndi Umuheburaayo wavuukiye mu Baheburaayo, kandi ku byerekeye amategeko ndi Umufarisaayo, <verse eid="PHP 3:5" /><verse number="6" style="v" sid="PHP 3:6" /><note caller="-" style="x"><char style="xo" closed="false">3:6 </char><char style="xt" closed="false"><ref loc="ACT 8:3">Iby 8:3</ref>; <ref loc="ACT 22:4">22:4</ref>; <ref loc="ACT 26:9-11">26:9-11</ref>.</char></note>nari mfite ishaka mu gutooteza itoorero, kandi ku byerekeye gutungaana kuzanwa n'amategeko nari inyangamugayo. <verse eid="PHP 3:6" /><verse number="7" style="v" sid="PHP 3:7" />Nyamara ibyo nabaraga nk'inyungu byose mbibara ko ari igihombo ku bwa Kristo. <verse eid="PHP 3:7" /><verse number="8" style="v" sid="PHP 3:8" />Ndetse ibintu byose mbibara nk'igihombo iyo mbigereranyije n'agaciiro gakomeye ko kumenya Kristo Yesu nk'Umwami wanje. Ku bwe, neemeye guhara ibyari inyungu zanje byose mbibara nk'ibishingwe kugira ngo ndonke Kristo <verse eid="PHP 3:8" /><verse number="9" style="v" sid="PHP 3:9" />kandi mboneke muri we ntafite gutungaana kwanje kuzanwa n'amategeko ahuubwo kuzanwa no kwizeera Kristo ari ko gutungaana kuva ku Maana gushingiye ku kwizeera. <verse eid="PHP 3:9" /><verse number="10" style="v" sid="PHP 3:10" />Niifuuza kumenya Kristo no kumenya imbaraga zo kuzuuka kwe kandi no gusangira na we imibabaro nkaba nka we no mu rupfu rwe, <verse eid="PHP 3:10" /><verse number="11" style="v" sid="PHP 3:11" />kugira ngo nibishoboka nzaagere ku izuurwa ry'abaapfuuye.<verse eid="PHP 3:11" /></para>
  <para style="s">Guharanira Kugera ku Nteego</para>
  <para style="p">
    <verse number="12" style="v" sid="PHP 3:12" />Si ukuvuga ko maze kuba ico niifuuza kuba cangwa se ko maze kugera ku nteego, ahuubwo nkomeza guharanira kubona uruhembo rwo Kristo yatsindiye akanyigaruriza. <verse eid="PHP 3:12" /><verse number="13" style="v" sid="PHP 3:13" />Bakundwa, sinteekereza ko maze kukigeraho ariko kimwe nkora, ni ukwibagirwa ibiri inyuma ngaharanira gusingiira ibiri imbere. <verse eid="PHP 3:13" /><verse number="14" style="v" sid="PHP 3:14" />Mparanira kugera ku nteego kugira ngo mpaabwe igihembo co mu ijuru nahamagariwe n'Imaana muri Kristo Yesu.<verse eid="PHP 3:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="PHP 3:15" />Nooneho reero abo boose bakuze mu by'Umwuka bakomeze guhuuza umutima kandi niiba hari uteekereza ukundi kuntu ku kintu ico ari co coose, Imaana izaabibahishuurira. <verse eid="PHP 3:15" /><verse number="16" style="v" sid="PHP 3:16" />Ico dusabwa ni ugukomeza ico tumaze kubona.<verse eid="PHP 3:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="PHP 3:17" />
    <note caller="-" style="x">
      <char style="xo" closed="false">3:17 </char>
      <char style="xt" closed="false">
        <ref loc="1CO 4:16">1 Kor 4:16</ref>; <ref loc="1CO 11:1">11:1</ref>.</char>
    </note>Bavandimwe, mugere ikirenge mu canje kandi mukurikize abo boose bakurikiza iciitegererezo twabeeretse. <verse eid="PHP 3:17" /><verse number="18" style="v" sid="PHP 3:18" />Nk'uko nababwiye ibi kenshi, na n'ubu nkaba mbibabwira ndira, benshi bakomeje kuba abanzi b'umusaraba. <verse eid="PHP 3:18" /><verse number="19" style="v" sid="PHP 3:19" />Iherezo ryabo ni ukurimbuka, kuko imaana yaabo ni inda, ibiteeye isoni ni byo biiraatana kandi imitima yaabo bayihoza ku by'isi. <verse eid="PHP 3:19" /><verse number="20" style="v" sid="PHP 3:20" />Ariko twebwe iwaacu ni mu ijuru, kandi ni ho Umukiza dutegereje azaava, ari we Mwami Yesu Kristo. <verse eid="PHP 3:20" /><verse number="21" style="v" sid="PHP 3:21" />Azaahindura imibiri yaacu y'intege nke ipfa, ayigire imibiri y'ikuzo nk'uwe, akoreesheje ubushobozi afite bumubaashiisha gutegeka ibintu byose.<verse eid="PHP 3:21" /></para>
  <chapter eid="PHP 3" />
  <chapter number="4" style="c" sid="PHP 4" />
  <para style="s1">Amabwiriza</para>
  <para style="p">
    <verse number="1" style="v" sid="PHP 4:1" />Nuuko reero bavandimwe nkunda kandi nkumbuye, mwebwe muneezeero wanje kandi kamba ryanje, muhagarare mushikamye mutyo mu Mwami.<verse eid="PHP 4:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="PHP 4:2" />Ndinginga Ewudiya hamwe na Sintike guhuuza umutima nkabavandimwe mu Mwami. <verse eid="PHP 4:2" /><verse number="3" style="v" sid="PHP 4:3" />Kandi naawe dufatanyije umurimo, ndagusaba gufasha aba bagore kuko baafatanyije nanje kurwanira umurimo w'Ubutumwa Bwiza hamwe na Kilimenti n'abandi twakoranye abo amazina yaabo ari mu gitabo c'ubugingo.<verse eid="PHP 4:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="PHP 4:4" />Muhore mwishiimira mu Mwami. Ndongera kubivuga nti, mwishiime!<verse eid="PHP 4:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="PHP 4:5" />Ubugwaneza bwanyu bumenywe na buri umwe. Umwami ari haafi kugaruka. <verse eid="PHP 4:5" /><verse number="6" style="v" sid="PHP 4:6" />Ntimukagire ico mwiganyira ahuubwo muri byose mumenyeeshe Imaana ibyo mukeneye byose muyisenga, muyinginga kandi muyishiima. <verse eid="PHP 4:6" /><verse number="7" style="v" sid="PHP 4:7" />Kandi amahoro Imaana itanga, aruta uko umuntu yakwibwira azaarinda imitima yaanyu n'ibiteekerezo byanyu muri Kristo Yesu.<verse eid="PHP 4:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="PHP 4:8" />Ibisigaye bakundwa, ikintu coose c'ukuri, ikintu coose co kuubahwa, ikintu coose gikiraanuka, ikintu coose kiboneye, ikintu coose c'igikundiro, ikintu coose gishimwa, niiba hari iciiza gihebuuje kandi hakabaho igikwiriye ishimwe, abe ari co muhoza ku mutima. <verse eid="PHP 4:8" /><verse number="9" style="v" sid="PHP 4:9" />Mukomeze gukora ibyo mwize, ibyo mwakiiriye, ibyo mwumviise hamwe niibyo mwaboonye muri nje nuuko Imaana y'amahoro izaabaana namwe.<verse eid="PHP 4:9" /></para>
  <para style="s1">Gushiima ku bw'Imfashanyo</para>
  <para style="p">
    <verse number="10" style="v" sid="PHP 4:10" />Niishimye caane mu Mwami kuko ubu haanyuma y'igihe kinini mwongeye kunzirikana. N'ubundi mwaranzirikanaga ariko mukabura uburyo bwo kubyerekana. <verse eid="PHP 4:10" /><verse number="11" style="v" sid="PHP 4:11" />Si ukuvuga ko nshaatse kwerekana ngo ndakennye kuko maze kwiga kunyurwa n'ibyo mfite. <verse eid="PHP 4:11" /><verse number="12" style="v" sid="PHP 4:12" />Nzi kubaho mfite biike kandi nzi no kubaho mfite ibisaaze. Muri byose kandi mu buryo bwose, niize ibanga ryo kubaho mu buzima bwose, naaba mpaaze cangwa nshonje, naaba mfite byinshi cangwa nkennye. <verse eid="PHP 4:12" /><verse number="13" style="v" sid="PHP 4:13" />Nshobozwa byose na Kristo umpa imbaraga.<verse eid="PHP 4:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="PHP 4:14" />Muri byose, mwagize neeza kumfasha mu mibabaro yanje. <verse eid="PHP 4:14" /><verse number="15" style="v" sid="PHP 4:15" />Nk'uko mubizi mwa Bafilipi mwe, mu gihe co Ubutumwa Bwiza bwatangiye kubwirizwa mvuye Makedooniya, ntaarindi toorero ryafatanyije nanje mu byo gutanga no guhaabwa ukuuyeho mwe. <verse eid="PHP 4:15" /><verse number="16" style="v" sid="PHP 4:16" /><note caller="-" style="x"><char style="xo" closed="false">4:16 </char><char style="xt" closed="false"><ref loc="ACT 17:1">Iby 17:1</ref>.</char></note><note caller="-" style="x"><char style="xo" closed="false">4:16 </char><char style="xt" closed="false"><ref loc="2CO 11:9">2 Kor 11:9</ref>.</char></note>Kuko n'igihe nari ndi i Tesalonike, mwanyoherereje ubufasha mumpa ibyo nari nifuuza kandi mwabikoze kenshi. <verse eid="PHP 4:16" /><verse number="17" style="v" sid="PHP 4:17" />Simvuga ibi kuko nshaaka impaano zaanyu ahuubwo nshaaka ko murushaho kunguka. <verse eid="PHP 4:17" /><verse number="18" style="v" sid="PHP 4:18" />Maze kubona ibihagije ahuubwo mfite ibinsaaze. Ndahaagijwe rwose ubwo maze guhaabwa imfashanyo mwanyoherereje kuva kuri Epafura, ituuro rihuumura neeza, igitambo ceemewe kandi gishimwa n'Imaana. <verse eid="PHP 4:18" /><verse number="19" style="v" sid="PHP 4:19" />Kandi Imaana nkorera izaabahaaza ibyo mukeneye byose nk'uko ubutunzi bw'ikuzo ryayo buri, muri Kristo Yesu. <verse eid="PHP 4:19" /><verse number="20" style="v" sid="PHP 4:20" />Nuuko Imaana Daata ihaabwe ikuzo iteeka ryose. Amiina.<verse eid="PHP 4:20" /></para>
  <para style="s1">Umusoozo</para>
  <para style="p">
    <verse number="21" style="v" sid="PHP 4:21" />Muntaahirize abantu b'Imaana boose muri Kristo Yesu. Abavandimwe turi kumwe barabataasha. <verse eid="PHP 4:21" /><verse number="22" style="v" sid="PHP 4:22" />Ab'Imaana boose na caane abo mu rugo rw'umwami w'i Rooma barabataasha.<verse eid="PHP 4:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="PHP 4:23" />Ubuntu bw'Umwami Yesu Kristo bubaane namwe mwese.<verse eid="PHP 4:23" /></para>
  <chapter eid="PHP 4" />
</usx>