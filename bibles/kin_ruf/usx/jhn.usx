<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="JHN" style="id">- Rufumbira New Testament</book>
  <para style="h">YOHAANA</para>
  <para style="toc3">Yoh</para>
  <para style="toc2">YOHAANA</para>
  <para style="toc1">Ubutumwa bwiza uko bwanditswe na YOHAANA</para>
  <para style="mt2">Ubutumwa bwiza uko bwanditswe na</para>
  <para style="mt1">YOHAANA</para>
  <para style="imt">INYANZURO</para>
  <para style="im">
    <char style="bk">Ubutumwa Bwiza uko bwanditswe na Yohaana</char> bwerekana ukuntu Yesu ari we Jambo w'Imaana uhoraho “wahindutse umuntu akabaana naatwe.” 1:14 Nk'uko ibiri muri iki gitabo ubwaco bivuga, ubu Butumwa bwanditswe kugira ngo ababusoma bizeere ko Yesu ari Umukiza waseezeranyijwe, kandi ko ari Umwana w'Imaana. Uzamwizeera weese azaahaabwa ubugingo buhoraho 20:31.</para>
  <para style="ip">Haanyuma y'inyanzuro yeerekana ko Jambo w'Imaana azaahoraho ari we Yesu, amagambo abanza y'iki gitabo atwereka ibitangaaza byerekana ko Yesu ari we Mucunguzi waseezeranyijwe, ni we Mwana w'Imaana. Ibi bikurikirwa n'ibisobaanuro byerekana ico ibyo bitangaaza bigaragaza. Iki gice c'igitabo kitwereka uko abantu bamwe bizeeye Yesu haanyuma bagahinduka abayoboke be, naho abandi bakamuhakanya maze ntibizeere. Uheereye ku gice ca 13 ukageza ku ca 17, heerekana neeza ukuntu Yesu yagize kwihereera n'abiigiishwa be mu ijoro ryo yafashwemo, kandi n'amagambo ye yo kubateguura no kubakomeza kugeza ku munsi wabanjirije kubambwa kwe. Ibice biheruuka byerekana ukuntu Yesu baamufashe, uko baamuciiriye urubanza, kubambwa no kuzuuka kwe, n'uko yabonekeye abiigiishwa be haanyuma yo kuzuuka.</para>
  <para style="ip">Ibyavuzwe ku mugore wafashwe asambana mu gice ca 7:53 kugeza ku gice ca 8:1-11 bishizwe mu kagote kuko bimwe mu byanditswe byera bya keera n'ibyahinduwe ntaabwo bishirwamo, naho ibindi byanditswe, bibishira mu yindi myanya.</para>
  <para style="ip">
    <char style="bk">Yohaana</char> ashimangira ibyerekeye impaano y'ubugingo buhoraho ibonerwa muri Kristo. Iyi mpaano ibonwa mu bugingo bwa noone, igahaabwa abiizeera Yesu nk'inzira, ukuri n'ubugingo. Ic'ingenzi kiri mu Butumwa bwa Yohaana ni uko akoreesha ibyo kureeberaho bifatika mu buzima bwa buri gihe, byerekana ibigaragara tuuzi mu by'umwuka, icokureeberaho, amaazi, umugaati, umuco, umushumba n'intaama ze, hamwe n'umuzaabibu n'imbuto zaawo.</para>
  <para style="iot">Ibirimo</para>
  <para style="io1">Inyanzuro<char style="ior"><ref loc="JHN 1:1-18">1:1-18</ref></char></para>
  <para style="io1">Yohaana Umubatiza n'abiigiishwa ba Yesu ba mbere <char style="ior"><ref loc="JHN 1:19-51">1:19-51</ref></char></para>
  <para style="io1">Ubuheereza bwa Yesu muri rubanda <char style="ior"><ref loc="JHN 2:1-12:50">2:1—12:50</ref> </char></para>
  <para style="io1">Iminsi ya nyuma muri Yerusaalemu n'imyanya ihitoorooye. <char style="ior"><ref loc="JHN 13:1-19:42">13:1—19:42</ref></char></para>
  <para style="io1">Kuzuuka no kwiyeerekana kwa Nyagasani <char style="ior"><ref loc="JHN 20:1-31">20:1-31</ref></char></para>
  <para style="io1">Indunduro. Ukundi kwiyeerekana muri Galileeya <char style="ior"><ref loc="JHN 21:1-25">21:1-25</ref></char></para>
  <chapter number="1" style="c" sid="JHN 1" />
  <para style="s1">Ijambo ry'Ubugingo</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 1:1" />Mu ntangiriro ya byose, haariho Jambo, Jambo yahoranye n'Imaana kandi uwo Jambo yari Imaana. <verse eid="JHN 1:1" /><verse number="2" style="v" sid="JHN 1:2" />Imaana itaraagira ico irema, Jambo yabaanaga na yo. <verse eid="JHN 1:2" /><verse number="3" style="v" sid="JHN 1:3" />Imaana yaremye ibintu byose ibinyujije muri we, nta kintu na kimwe caaremwe atari ku bwe. <verse eid="JHN 1:3" /><verse number="4" style="v" sid="JHN 1:4" />Jambo uwo ni we sooko y'ubugingo, kandi ubugingo<note caller="+" style="f"><char style="fr" closed="false">1:4 </char><char style="ft" closed="false">Muri we, ntaacabaho bidaturutse kuri we </char></note> bwazaniye abantu boose urumuri. <verse eid="JHN 1:4" /><verse number="5" style="v" sid="JHN 1:5" />Urwo rumuri rumurikira mu mwijima, kandi umwijima ntiwarusobaanukirwa.<verse eid="JHN 1:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="JHN 1:6" />
    <note caller="-" style="x">
      <char style="xo" closed="false">1:6 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 3:1">Mat 3:1</ref>; <ref loc="MRK 1:4">Mar 1:4</ref>; <ref loc="LUK 3:1">Luk 3:1</ref>,<ref loc="LUK 3:2">2</ref>.</char>
    </note>Haabaayeho umugabo watumwe n'Imaana, witwaga Yohaana. <verse eid="JHN 1:6" /><verse number="7" style="v" sid="JHN 1:7" />Yazanywe no kuba umuhamya w'iby'urwo rumuri, kugira ngo atume boose biizeera. <verse eid="JHN 1:7" /><verse number="8" style="v" sid="JHN 1:8" />We ku bwe nti yari urumuri, ahuubwo yaaje kuba umuhamya w'iby'urwo rumuri. <verse eid="JHN 1:8" /><verse number="9" style="v" sid="JHN 1:9" />Urwo ni rwo rumuri nyakuri rwaje muri iyi si kumurikira abantu boose.<verse eid="JHN 1:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="JHN 1:10" />Jambo yari mu isi, kandi isi yaremwe ku bwe, ariko abo mu isi ntibaamumenya. <verse eid="JHN 1:10" /><verse number="11" style="v" sid="JHN 1:11" />Yaaje mu gihugu ce, ariko abantu be ntibamwemera. <verse eid="JHN 1:11" /><verse number="12" style="v" sid="JHN 1:12" />Icakora abo boose bamwakiiriye, bakiizeera izina rye, yabahaaye ububaasha bwo kuba abaana b'Imaana. <verse eid="JHN 1:12" /><verse number="13" style="v" sid="JHN 1:13" />Ntibaabaaye abaana b'Imaana mu buryo busanzwe bw'abantu babyaramo, ariko Imaana ubwayo ni yo yabiibyariye mu mwuka.<verse eid="JHN 1:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="JHN 1:14" />Jambo yabaaye umuntu aba muri twe, tubona ikuzo rye risa n'iry'umwana w'ikinege wa se, yuuzuye imbabazi n'ukuri.<verse eid="JHN 1:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="JHN 1:15" />Yohaana yahamije ibye avuga ati, “Uyu ni we navuzeho ubwo navugaga nti, ‘Uzaaza nyuma yanje, aranduta kuko yariho ntaraabaho.’ ”<verse eid="JHN 1:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 1:16" />Twese twahaawe ku migisha ye myinshi caane, kandi duhaabwa ubuntu ku bundi. <verse eid="JHN 1:16" /><verse number="17" style="v" sid="JHN 1:17" />Amategeko yatanzwe anyuze kuri Moose, naho ubuntu n'ukuri byatugezeho binyuze muri Yesu Kristo. <verse eid="JHN 1:17" /><verse number="18" style="v" sid="JHN 1:18" />Nta muntu wigeze kubona Imaana. Keretse Umwana waayo w'ikinege kandi umeze nk'Imaana, akaba ari iruhande rwa Se, ni we wayitumenyeesheje.<verse eid="JHN 1:18" /></para>
  <para style="b" />
  <para style="s1">Ubuhamya bwa Yohaana Umubatiza</para>
  <para style="r">(<ref loc="MAT 3:1-12">Mat 3:1-12</ref>; <ref loc="MRK 1:1-8">Mar 1:1-8</ref>; <ref loc="LUK 3:1-18">Luk 3:1-18</ref>)</para>
  <para style="p">
    <verse number="19" style="v" sid="JHN 1:19" />Yohaana yatanze ubu buhamya ubwo Abayuuda boohereje abaheerezabitambo n'Abaleevi kuva i Yerusaalemu kumubaza bati, “Mbese uri nde?”<verse eid="JHN 1:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="JHN 1:20" />Yohaana ntiyabahakaniye, ahuubwo yarabeeruriye ati, “Si nje Kristo.”<verse eid="JHN 1:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="JHN 1:21" />Barongera baramubaza bati, “Noone se uri nde? Uri Eliya?”</para>
  <para style="p" vid="JHN 1:21">Arabasubiza ati, “Ntaabwo ndi we.”</para>
  <para style="p" vid="JHN 1:21">Bakomeza kumubaza bati, “Mbese uri wa muhanuuzi?”</para>
  <para style="p" vid="JHN 1:21">Arabasubiza ati, “Oya”<verse eid="JHN 1:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 1:22" />Nuuko baramubaza bati, “Mbese noone wowe uri nde? Duhe igisubizo co kujaanira abaadutumye. Wowe wivugaho iki?”<verse eid="JHN 1:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="JHN 1:23" />Yohaana abasubiza avuga ibyahanuuwe n'umuhanuuzi Yesaaya ati,</para>
  <para style="q1" vid="JHN 1:23">“Ndi ijwi rirangururira mu butaayu riti,</para>
  <para style="q2" vid="JHN 1:23">‘Nimugorore inzira y'Uhoraho!’ ”<verse eid="JHN 1:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="JHN 1:24" />Abo bantu baari baatumwe n'Abafarisaayo, <verse eid="JHN 1:24" /><verse number="25" style="v" sid="JHN 1:25" />barongera babaza Yohaana bati, “Noone se niiba utari Mesiya, nt'ube Eliya, nt'ube umuhanuuzi, kuki ubatiza?”<verse eid="JHN 1:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="JHN 1:26" />Yohaana arabasubiza ati, “Njeewe ndabatiriisha amaazi, ariko muri mwe hari uwo mutaazi, <verse eid="JHN 1:26" /><verse number="27" style="v" sid="JHN 1:27" />kandi ni we ugiiye kuuza ankurikiye, ntibinkwiriye no gupfunduura udushumi tw'ingato ze.”<verse eid="JHN 1:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="JHN 1:28" />Ibi byabeereye i Beetaniya hakurya y'uruuzi rwa Yorodaani, aho Yohaana yabatirizaga abantu.<verse eid="JHN 1:28" /></para>
  <para style="s1">Umwana w'Intaama w'Imaana</para>
  <para style="p">
    <verse number="29" style="v" sid="JHN 1:29" />Umunsi wakurikiyeho, Yohaana abona Yesu aje amusanga. Nuuko Yohaana aravuga ati, “Dore Umwana w'Intaama w'Imaana ukuraho ibyaha by'abari mu isi. <verse eid="JHN 1:29" /><verse number="30" style="v" sid="JHN 1:30" />Uyu ni we navuze nti, ‘Nyuma yanje hazaaza umugabo unduta kuko yabaayeho mbere yanje.’ <verse eid="JHN 1:30" /><verse number="31" style="v" sid="JHN 1:31" />Icakora nje ubwanje sinari muuzi, uretse yuuko naaje mbatiriisha amaazi ku bw'iyo mpamvu, kugira ngo amenyekane mu Biisirayeli.”<verse eid="JHN 1:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="JHN 1:32" />Kandi Yohaana atanga ubuhamya agira ati, “Naboonye Umwuka amanuka avuuye mu ijuru mu ishusho y'inuma, nuuko aguma kuri Yesu. <verse eid="JHN 1:32" /><verse number="33" style="v" sid="JHN 1:33" />Nje ubwanje sinari muuzi, ariko uwantumye kubatiriisha amaazi yarambwiye ati, ‘Uwo uzaabona Umwuka wanje amumanukiraho kandi akamugumaho, ni we ubatiriisha Umwuka Weera.’ <verse eid="JHN 1:33" /><verse number="34" style="v" sid="JHN 1:34" />Nje ubwanje narabyiboneye, kandi ndahamya ko ari we Mwana w'Imaana.”<verse eid="JHN 1:34" /></para>
  <para style="s1">Abiigiishwa ba Yesu ba Mbere</para>
  <para style="p">
    <verse number="35" style="v" sid="JHN 1:35" />Bukeeye bwaho, Yohaana yongera guhagarara hamwe n'abiigiishwa be babiri. <verse eid="JHN 1:35" /><verse number="36" style="v" sid="JHN 1:36" />Aboonye Yesu anyuzeho aravuga ati, “Dore, uyu ni Umwana w'Intaama w'Imaana!”<verse eid="JHN 1:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="JHN 1:37" />Ba biigiishwa babiri bumviise avuga atyo, bakurikira Yesu. <verse eid="JHN 1:37" /><verse number="38" style="v" sid="JHN 1:38" />Yesu arahinduka maze abona bamukurikiye, arababaza ati, “Murashaaka iki?”</para>
  <para style="p" vid="JHN 1:38">Baramusubiza bati, “<char style="it">Rabbi</char> (bisobaanurwa ngo Mwigiisha), utuuye he?”<verse eid="JHN 1:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="JHN 1:39" />Arabasubiza ati, “Nimuuze muhareebe.” Bajaana na we, babona aho yataahaga. Nuuko bagumana nawe uwo munsi woose. Zaari nka saaha cumi z'umugorooba.<verse eid="JHN 1:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="JHN 1:40" />Umwe muri abo bagabo babiri wumviise Yohaana avuga maze agakurikira Yesu yari Andereya, mwenenyina wa Simooni Peetero. <verse eid="JHN 1:40" /><verse number="41" style="v" sid="JHN 1:41" />Muri ako kaanya abona mwenenyina Simooni aramubwira ati, “Twaboonye Mesiya.” (Kimenyeesha uwasiizwe amavuta<note caller="+" style="f"><char style="fr" closed="false">1:41 </char><char style="ft" closed="false">Cangwa </char><char style="it">Kristo</char> </note>) <verse eid="JHN 1:41" /><verse number="42" style="v" sid="JHN 1:42" />Nuuko amuuzanira Yesu, maze Yesu amwitegereje aramubwira ati, “Uri Simooni mwene Yohaana, uziitwa keefa.” (Iri zina ni co kimwe na Peetero kandi rimenyeesha Urutare).<verse eid="JHN 1:42" /></para>
  <para style="s1">Yesu Ahamagara Filipo na Natanayeli</para>
  <para style="p">
    <verse number="43" style="v" sid="JHN 1:43" />Umunsi wakurikiyeho, Yesu ahitamo kuja i Galileeya. Ahuura na Filipo aramubwira ati, “Nkurikira.” <verse eid="JHN 1:43" /><verse number="44" style="v" sid="JHN 1:44" />Filipo yari akomooka i Beetsayida, ari na yo tawuni nkuru yo Andereya na Peetero batuuyemo. <verse eid="JHN 1:44" /><verse number="45" style="v" sid="JHN 1:45" />Filipo abona Natanayeli, nuuko aramubwira ati, “Twaboonye Mesiya, uwo Moose yanditse mu mategeko, n'abahanuuzi bakamwandikaho. Ni Yesu w'i Nazaareeti, mwene Yozefu.”<verse eid="JHN 1:45" /></para>
  <para style="p">
    <verse number="46" style="v" sid="JHN 1:46" />Natanayeli asubiza Filipo ati, “Mbese i Nazaareeti naho hari iciiza caahaturuka?” Filipo aramusubiza ati, “Ngwino wiireebere.”<verse eid="JHN 1:46" /></para>
  <para style="p">
    <verse number="47" style="v" sid="JHN 1:47" />Yesu abona Natanayeli aza aho ari, nuuko amuvugaho agira ati, “Uyu mugabo ni umu Isirayeli nyakuri udafite uburyarya.”<verse eid="JHN 1:47" /></para>
  <para style="p">
    <verse number="48" style="v" sid="JHN 1:48" />Natanayeli aramubaza ati, “Wamenyeye he?”</para>
  <para style="p" vid="JHN 1:48">Yesu aramusubiza ati, “Nakuboonye ubwo wari munsi y'igiti ciitwa umutiini Filipo ataraaguhamagara.”<verse eid="JHN 1:48" /></para>
  <para style="p">
    <verse number="49" style="v" sid="JHN 1:49" />Natanayeli aramusubiza ati, “Mwigiisha, koko uri Umwana w'Imaana! Uri Umwami wa Isirayeli!” <verse eid="JHN 1:49" /><verse number="50" style="v" sid="JHN 1:50" />Yesu aramusubiza ati, “Wemejwe n'uko nkubwiye ko nakuboonye ubwo wari munsi y'igiti c'umutiini? Uzaabona n'ibindi bitangaaje gusumba ibyo.” <verse eid="JHN 1:50" /><verse number="51" style="v" sid="JHN 1:51" />Arongera aramubwira ati, “Ndababwira ukuri yuuko, muzaabona ijuru rikinguutse, mubone abaamalayika b'Imaana bazaamukira kandi bamanukira ku Mwana w'Umuntu.”<verse eid="JHN 1:51" /></para>
  <chapter eid="JHN 1" />
  <chapter number="2" style="c" sid="JHN 2" />
  <para style="s1">Ubukwe bw'i Kaana</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 2:1" />Ku munsi wa gatatu haari ubukwe mu tawuni y'i Kaana mu disiturikiti y'i Galileeya. Nyina wa Yesu yari yaataashe ubwo bukwe. <verse eid="JHN 2:1" /><verse number="2" style="v" sid="JHN 2:2" />Yesu n'abiigiishwa be na bo baari baatumiwe muri ubwo bukwe. <verse eid="JHN 2:2" /><verse number="3" style="v" sid="JHN 2:3" />Divaayi imaze gushira, nyina wa Yesu aramubwira ati, “Nta divaayi bagifite.”<verse eid="JHN 2:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="JHN 2:4" />Yesu aramusubiza ati, “Mubyeyi, nje na we ibyo ntibitureeba. Igihe canje ntikiraagera”<verse eid="JHN 2:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="JHN 2:5" />Nyina wa Yesu abwira abagabuzi ati, “Mukore ico ari bubabwire coose.”<verse eid="JHN 2:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="JHN 2:6" />Imbere yaabo haari hateretswe ibibindi bitandatu bibaajwe mu mabuye. Abayuuda baasukagamo amaazi agakoreeshwa mu mihango yaabo yo kwiyeza. Buri kibindi caajagamo nka lita ijana. <verse eid="JHN 2:6" /><verse number="7" style="v" sid="JHN 2:7" />Yesu arababwira ati, “Nimwuzuze amaazi muri ibyo bibindi.” Nuuko barabyuzuza kugeza ku rugaara.<figure style="fig" alt="Jesus asked them to fill the water pots to the brim." file="DD-30A.TIF" size="col" loc="Darwin" copy="The British and Foreign Bible Societies" ref="2:7">Yesu ategeka abategeka kuuzuza intango amaazi.</figure> <verse eid="JHN 2:7" /><verse number="8" style="v" sid="JHN 2:8" />Yesu arongera arababwira ati, “Noone reero nimudaheho, maze mujaanire mukuru w'ubukwe.” <verse eid="JHN 2:8" /><verse number="9" style="v" sid="JHN 2:9" />Mukuru w'ubukwe asogongeye ku maazi yahindutse divaayi, ntiyamenya aho iturutse, (ukuyeho abagabuzi baadashe ayo maazi ni bo baari bahaazi), mukuru w'ubukwe ahamagara umukwe <verse eid="JHN 2:9" /><verse number="10" style="v" sid="JHN 2:10" />aramubwira ati, “Ubusanzwe, babanza kugabura divaayi nziiza, haanyuma abantu baamara guhaaga bakagabura itaryoshe. Ariko wowe wakomeje kugabura divaayi iryoshe kugeza n'ubu.”<verse eid="JHN 2:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="JHN 2:11" />Yesu yakoreye iki gitangaaza ce ca mbere i Kaana y'i Galileeya. Mu gukora ibi, yeerekanye ikuzo rye, nuuko abiigiishwa be baramwizeera.<verse eid="JHN 2:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 2:12" />
    <note caller="-" style="x">
      <char style="xo" closed="false">2:12 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 4:13">Mat 4:13</ref>.</char>
    </note>Haanyuma y'ibyo, Yesu aja i Kaperenawumu ari kumwe na nyina, na beenenyina, hamwe n'abiigiishwa be, nuuko bamarayo iminsi mike.<verse eid="JHN 2:12" /></para>
  <para style="s1">Yesu Yiirukana Abaacuruurizaga mu Nzu y'Imaana</para>
  <para style="r">(<ref loc="MAT 21:12-13">Mat 21:12-13</ref>; <ref loc="MRK 11:15-17">Mar 11:15-17</ref>; <ref loc="LUK 19:45-46">Luk 19:45-46</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="JHN 2:13" />Iminsi yo kwizihiza ibirori byo Kunyurwaho kw'Abayuuda yegeereje, Yesu aja i Yerusaalemu. <verse eid="JHN 2:13" /><verse number="14" style="v" sid="JHN 2:14" />Asanga abantu baguriisha inka, intaama, n'inuma, kandi n'abandi baavunjaga amashilingi biicaye ku meeza zaabo mu Nzu y'Imaana. <verse eid="JHN 2:14" /><verse number="15" style="v" sid="JHN 2:15" />Nuuko Yesu akora inkoni mu migozi, ayikoreesha kwirukana amatungo yoose yari mu nzu y'Imaana, yiirukanamo intaama, n'inka. Amena haasi ibiceri by'abaavunjaga, kandi ahirika n'imeeza zaabo. <verse eid="JHN 2:15" /><verse number="16" style="v" sid="JHN 2:16" />Maze abwira abaaguriishaga inuma ati, “Ni muzikuure hano! Murekeraho guhindura inzu ya Daata iguriro.” <verse eid="JHN 2:16" /><verse number="17" style="v" sid="JHN 2:17" />Abiigiishwa be biibuka ibyanditswe bivuga ngo, “Urukundo mfitiye Inzu yaawe ni nk'umuriro ungurumanamo.”<verse eid="JHN 2:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="JHN 2:18" />Abayuuda baramubaza bati, “Ni gitangaaza ki wakora ceerekana ko ufite ububaasha buturuka ku Maana bwo gukora ibi?”<verse eid="JHN 2:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="JHN 2:19" />
    <note caller="-" style="x">
      <char style="xo" closed="false">2:19 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 26:61">Mat 26:61</ref>; <ref loc="MAT 27:40">27:40</ref>; <ref loc="MRK 14:58">Mar 14:58</ref>; <ref loc="MRK 15:29">15:29</ref>.</char>
    </note>Yesu arabasubiza ati, “Nimusenye iyi Nzu y'Imaana, nanje nzayubaka mu minsi itatu.”<verse eid="JHN 2:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="JHN 2:20" />Abayobozi b'Abayuuda baramusubiza bati, “Iyi Nzu y'Imaana yubatswe mu myaka mirongo ine n'itandatu, byashoboka ko wayubakira mu minsi itatu?”<verse eid="JHN 2:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="JHN 2:21" />Ariko Inzu y'Imaana Yesu yamenyeeshaga ni umubiri we. <verse eid="JHN 2:21" /><verse number="22" style="v" sid="JHN 2:22" />Nuuko amaze kuzuurwa mu baapfuuye, abiigiishwa be biibuka ko yari yarabivuze, maze beemera ibyanditswe, n'ijambo Yesu yari yaravuze.<verse eid="JHN 2:22" /></para>
  <para style="s1">Yesu azi Ibya Kameremuntu</para>
  <para style="p">
    <verse number="23" style="v" sid="JHN 2:23" />Ubwo Yesu yari i Yerusaalemu mu minsi mikuru yo Kunyurwaho, abantu benshi baaramwizeeye ku bw'ibitangaaza baaboonye akora. <verse eid="JHN 2:23" /><verse number="24" style="v" sid="JHN 2:24" />Ariko Yesu we ntiyabiizeeraga, kuko yari azi abantu boose uko bari. <verse eid="JHN 2:24" /><verse number="25" style="v" sid="JHN 2:25" />Ntiyagombaga kubwirwa iby'abantu, kuko we ubwe yari azi ibyo buri muntu ateekereza.<verse eid="JHN 2:25" /></para>
  <chapter eid="JHN 2" />
  <chapter number="3" style="c" sid="JHN 3" />
  <para style="s1">Nikodemu Aja kureeba Yesu</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 3:1" />Haariho Umufarisaayo witwaga Nikodemu, wari umuyobozi w'Abayuuda. <verse eid="JHN 3:1" /><verse number="2" style="v" sid="JHN 3:2" />Ijoro rimwe, asanga Yesu maze aramubwira ati, “Mwigiisha, tuuzi yuuko uri umwigiisha wavuuye ku Maana, kuko ari ntaawashobora gukora ibitangaaza ukora, atari kumwe n'Imaana.”<verse eid="JHN 3:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="JHN 3:3" />Yesu aramusubiza ati, “Ndakubwira ukuri yuuko, nta muntu n'umwe ushobora kubona Ubwami bw'Imaana atabyawe ubwa kabiri.”<verse eid="JHN 3:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="JHN 3:4" />Nikodemu aramubaza ati, “Mbese umuntu ashobora kubyarwa ubwa kabiri ate kandi akuze? Mbese yakongera gusubira mu nda ya nyina, ngo abyarwe ubwa kabiri?”<verse eid="JHN 3:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="JHN 3:5" />Yesu aramusubiza ati, “Ndakubwira ukuri yuuko ntaan'umwe wakwinjira mu bwami bw'Imaana atabyawe n'amaazi n'Umwuka. <verse eid="JHN 3:5" /><verse number="6" style="v" sid="JHN 3:6" />Ikibyawe n'umubiri na co ni umubiri, kandi ikibyawe n'Umwuka, ni umwuka. <verse eid="JHN 3:6" /><verse number="7" style="v" sid="JHN 3:7" />Ntibigutangaaze yuuko nkubwiye ngo, ‘Mugomba kubyarwa ubwa kabiri.’ <verse eid="JHN 3:7" /><verse number="8" style="v" sid="JHN 3:8" />Umuyaga uhuuha weerekeza aho ushaaka, mukumva guhuuha kwawo, ariko ntimumenye aho uturuka cangwa aho weerekeza. Ni na ko uwabyawe n'Umwuka weese amera.”<verse eid="JHN 3:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="JHN 3:9" />Nikodemu aramusubiza ati, “Mbese ibyo byashoboka bite?”<verse eid="JHN 3:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="JHN 3:10" />Yesu aramusubiza ati, “Ukaba uri umwigiisha w'Abiisirayeli, maze ntuusobaanukirwe ibi bintu? <verse eid="JHN 3:10" /><verse number="11" style="v" sid="JHN 3:11" />Ndakubwira ukuri yuuko tuvuga ibyo tuuzi kandi tugahamya ibyo twaboonye, ariko ntimwakiire ibyo duhamya. <verse eid="JHN 3:11" /><verse number="12" style="v" sid="JHN 3:12" />Niiba mbabwiye iby'isi ntimwizeere, nimbabwira iby'ijuru muzabyizeera mute? <verse eid="JHN 3:12" /><verse number="13" style="v" sid="JHN 3:13" />Ntaawigeze kuzaamuuka aja mu ijuru, keretse uwo wamanutse ava mu ijuru, ari we Umwana w'umuntu.<verse eid="JHN 3:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="JHN 3:14" />Nk'uko Moose yamanitse inzoka ku giti mu butaayu, ni ko n'Umwana w'Umuntu akwiriye kumanikwa, <verse eid="JHN 3:14" /><verse number="15" style="v" sid="JHN 3:15" />kugira ngo umwizeera weese abone ubugingo buhoraho.<verse eid="JHN 3:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 3:16" />Kuko Imaana yakunze abari mu isi caane, byatumye itanga Umwana waayo w'ikinege, kugira ngo umwizeera weese atarimbuka ahuubwo ahaabwe ubugingo buhoraho.<verse eid="JHN 3:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="JHN 3:17" />Koko, Imaana ntiyoohereje Umwana waayo ku isi kugira ngo aciire abayiriho urubanza, ahuubwo kwari ukugira ngo bakirizwe muri we.<verse eid="JHN 3:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="JHN 3:18" />Abamwizeera boose ntibaciirwa urubanza, ariko abatamwizeera boose baba baaciiriwe urubanza, kuko baba batiizeeye izina ry'Umwana w'ikinege w'Imaana. <verse eid="JHN 3:18" /><verse number="19" style="v" sid="JHN 3:19" />Iyi ni yo nsharubanza, ngo, umuco waaje mu isi, ariko abantu bakunda umwijima kuruta umuco kuko ibikorwa byabo ari bibi. <verse eid="JHN 3:19" /><verse number="20" style="v" sid="JHN 3:20" />Abo bakora ibibi, banga umuco, ntibaweegeera kugira ngo ibyo bakora bitagaragara. <verse eid="JHN 3:20" /><verse number="21" style="v" sid="JHN 3:21" />Ariko abakora ibitunganye, baja mu muco, kugira ngo ibyo bakora bigaragare ko byakorewe mu kuubaha Imaana.”<verse eid="JHN 3:21" /></para>
  <para style="s1">Yesu na Yohaana Umubatiza</para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 3:22" />Haanyuma y'ibyo, Yesu ajaana n'abiigiishwa be mu disiturikiti y'i Yudeeya, agumayo na bo igihe kinini babatiza. <verse eid="JHN 3:22" /><verse number="23" style="v" sid="JHN 3:23" />Yohaana na we yabatirizaga abantu ahiitwa Eyinoni haafi y'i tawuni ya Salimu. Kuko haari amaazi menshi, abantu baakomezaga kuuza aho Yohaana ari, bakabatizwa. <verse eid="JHN 3:23" /><verse number="24" style="v" sid="JHN 3:24" /><note caller="-" style="x"><char style="xo" closed="false">3:24 </char><char style="xt" closed="false"><ref loc="MAT 14:3">Mat 14:3</ref>; <ref loc="MRK 6:17">Mar 6:17</ref>; <ref loc="LUK 3:19">Luk 3:19</ref>,<ref loc="LUK 3:20">20</ref>.</char></note>Ibyo byose byabaaye Yohaana ataraashirwa mu gihome.<verse eid="JHN 3:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 3:25" />Abiigiishwa ba Yohaana batangira kuja impaka n'Umuyuuda bapfa umuhango wo kwiyeza. <verse eid="JHN 3:25" /><verse number="26" style="v" sid="JHN 3:26" />Basanga Yohaana baramubwira bati, “Mwigiisha, wa mugabo mwari kumwe hakurya ya Yorodaani, uwo watangagaho ubuhamya, na we arikubatiza, kandi boose bari kumusanga.”<verse eid="JHN 3:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="JHN 3:27" />Yohaana arabasubiza ati, “Nta muntu washobora kwiha ikintu, keretse agihaawe n'Imaana. <verse eid="JHN 3:27" /><verse number="28" style="v" sid="JHN 3:28" /><note caller="-" style="x"><char style="xo" closed="false">3:28 </char><char style="xt" closed="false"><ref loc="JHN 1:20">Yoh 1:20</ref>.</char></note>Namwe ubwanyu mwambeera abahamya ko navuze nti, ‘Si nje Mesiya ahuubwo naaje kumuteguurira.’ <verse eid="JHN 3:28" /><verse number="29" style="v" sid="JHN 3:29" />Ufite umugeni aba ari umukwe. Inshuti y'umukwe imuhagarara iruhande ikamwumva, ineezezwa n'ijwi rye. Ku bw'iyo mpamvu, umuneezeero wanje urasohoye. <verse eid="JHN 3:29" /><verse number="30" style="v" sid="JHN 3:30" />Ni ngombwa ko ashirwa heejuru, naho nje ngaca bugufi”<verse eid="JHN 3:30" /></para>
  <para style="s1">Yesu Aturuka mu Ijuru</para>
  <para style="p">
    <verse number="31" style="v" sid="JHN 3:31" />Uwaturutse heejuru ni we usumba boose. Naho uwo ku isi aba ari uw'isi kandi avuga iby'isi. Uwaturutse reero mu ijuru asumba boose. <verse eid="JHN 3:31" /><verse number="32" style="v" sid="JHN 3:32" />Atanga ubuhamya bw'ibyo yaboonye kandi yumviise, ariko ntihagire uweemera ubuhamya bwe. <verse eid="JHN 3:32" /><verse number="33" style="v" sid="JHN 3:33" />Umuntu weese weemera ubuhamya bwe, aba ahamije ko Imaana ari Ukuri. <verse eid="JHN 3:33" /><verse number="34" style="v" sid="JHN 3:34" />Uwo Imaana yatumye avuga amagambo yaayo, kuko Imaana imuha Umwuka waayo itamugerera. <verse eid="JHN 3:34" /><verse number="35" style="v" sid="JHN 3:35" /><note caller="-" style="x"><char style="xo" closed="false">3:35 </char><char style="xt" closed="false"><ref loc="MAT 11:27">Mat 11:27</ref>; <ref loc="LUK 10:22">Luk 10:22</ref>.</char></note>Imaana Daata ikunda Umwana waayo kandi ibintu byose yabishize mu maboko ye. <verse eid="JHN 3:35" /><verse number="36" style="v" sid="JHN 3:36" />Abiizeera Umwana w'Imaana bafite ubugingo bw'iteeka ryose. Ariko abo batamwumvira ntibazaabona ubugingo, ahuubwo, bazaaguma mu mujinya w'Imaana.<verse eid="JHN 3:36" /></para>
  <chapter eid="JHN 3" />
  <chapter number="4" style="c" sid="JHN 4" />
  <para style="s1">Yesu n'Umusamariyakazi</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 4:1" />Abafarisaayo bumviise ko Yesu afite abayoboke benshi kandi ko yabatizaga kurusha Yohaana. <verse eid="JHN 4:1" /><verse number="2" style="v" sid="JHN 4:2" />(Icakora, Yesu ubwe ntiyigeze kubatiza umuntu weese ahuubwo ni abiigiishwa be baabatizaga.) <verse eid="JHN 4:2" /><verse number="3" style="v" sid="JHN 4:3" />Umwami Yesu yumviise ibyo baavugaga, ava i Yudeeya aja i Galileeya. <verse eid="JHN 4:3" /><verse number="4" style="v" sid="JHN 4:4" />Ariko byari ngombwa ko anyura i Samariya.<verse eid="JHN 4:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="JHN 4:5" />Nuuko agera mu tawuni y'i Samariya yitwa Sukari, yari haafi y'umurima Yaakobo yahaaye umwana we Yozefu. <verse eid="JHN 4:5" /><verse number="6" style="v" sid="JHN 4:6" />Muri uwo mwanya haari umugezi wa Yaakobo. Ku bw'urugendo rureerure, Yesu yari arushe caane, nuuko yiicara iruhande rw'uwo mugezi, kandi haari nka saaha itandatu z'amanywa.<verse eid="JHN 4:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="JHN 4:7" />Umusamariyakazi aza kuvooma amaazi, Yesu aramubwira ati, “Mpa amaazi yo kunywa” <verse eid="JHN 4:7" /><verse number="8" style="v" sid="JHN 4:8" />(Abiigiishwa be baari baagiiye mu tawuni kugura ibyokurya). <figure style="fig" alt="Jesus ask a Samaritan woman for drinking water" file="DD-35A.TIF" size="col" loc="Darwin" copy="The British and Foreign Bible Societies" ref="4:8">Yesu asaba Umusamariyakazi amaazi yo kunywa.</figure><verse eid="JHN 4:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="JHN 4:9" />Umusamariyakazi aramusubiza ati, “Wansaba amaazi ute kandi uzi neeza ko uri Umuyuuda, nje nkaba Umusamariyakazi?” (Yavuze atyo kuko Abayuuda ntibaasangiraga n'Abasamariya.)<note caller="+" style="f"><char style="fr" closed="false">4:9 </char><char style="ft" closed="false">Ibindi byanditswe bya keera ntibifite iyi nteruro y'amagambo</char></note><verse eid="JHN 4:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="JHN 4:10" />Yesu aramusubiza ati, “Iyaaba wari uzi impaano Imaana itanga, ukamenya n'ugusaba amaazi uwo ari we, naawe uba umusabye, akaguha amaazi atanga ubugingo.”<verse eid="JHN 4:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="JHN 4:11" />Uwo mugore aramusubiza ati, “Daatabuja, ko udafite ikivoomeesho, n'umugezi akaba ari mureemure, ayo maazi atanga ubugingo wayakuura he? <verse eid="JHN 4:11" /><verse number="12" style="v" sid="JHN 4:12" />Mbese uruta sogokuruza Yaakobo wadusigiye uyu mugezi, akawunyweraho, we n'abaana be n'amatungo ye?”<verse eid="JHN 4:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="JHN 4:13" />Yesu aramusubiza ati, “Unywa aya maazi weese azongera agire imyota, <verse eid="JHN 4:13" /><verse number="14" style="v" sid="JHN 4:14" />ariko uzanywa amaazi nzaamuha, ntaazaagira imyota ukundi, ahuubwo amaazi nzaamuha, azaamubeera isooko y'amaazi idudubiza kugeza mu bugingo bw'iteeka ryose.”<verse eid="JHN 4:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="JHN 4:15" />Uwo mugore aramusubiza ati, “Daatabuja, mpa kuri ayo maazi, ntazongera kugira imyota, ngo ngaruke hano kuvooma.”<verse eid="JHN 4:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 4:16" />Yesu aramubwira ati, “Genda uhamagare umugabo waawe maze ugaruke.”<verse eid="JHN 4:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="JHN 4:17" />Uwo mugore aramusubiza ati, “Nta mugabo mfite.” Yesu aramubwira ati, “Uvuze ukuri yuuko udafite umugabo.<verse eid="JHN 4:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="JHN 4:18" />Kuko wari ufite abagabo bataanu, n'uwo ufite ubu si uwaawe. Ibyo uvuze ni ukuri.”<verse eid="JHN 4:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="JHN 4:19" />Uwo mugore aramubwira ati, “Daatabuja mboonye ko uri umuhanuuzi. <verse eid="JHN 4:19" /><verse number="20" style="v" sid="JHN 4:20" />Ba sogokuruza basengeraga kuri uyu musozi, naho mwe mukagira ngo i Yerusaalemu ni ho hakwiriye gusengerwa.”<verse eid="JHN 4:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="JHN 4:21" />Yesu aramusubiza ati, “Mugore, nyizeera, dore igihe kirageze, ubwo bitazaaba ngombwa ko musengera Imaana Daata kuri uyu musozi cangwa i Yerusaalemu. <verse eid="JHN 4:21" /><verse number="22" style="v" sid="JHN 4:22" />Dore mwebwe abantu b'i Samariya muramya uwo mutaazi, ariko twebwe turamya uwo tuuzi, kuko agakiza gaturuka mu Bayuuda. <verse eid="JHN 4:22" /><verse number="23" style="v" sid="JHN 4:23" />Igihe kireegeereje kandi kirasohoye, ubwo abaramya Daata by'ukuri, bamuramya mu kuri bayobowe n'Umwuka, kuko Daata ashaaka beene abo bamuramya batyo. <verse eid="JHN 4:23" /><verse number="24" style="v" sid="JHN 4:24" />Imaana ni Umwuka kandi abayiramya bakwiriye kuyiramya by'ukuri, bayobowe n'Umwuka.”<verse eid="JHN 4:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 4:25" />Uwo mugore aramubwira ati, “Nzi yuuko Mesiya azaaza (ari we Kristo), kandi naamara kuuza azaatubwira byose.”<verse eid="JHN 4:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="JHN 4:26" />Yesu aramusubiza ati, “Ni nje Mesiya, uwo uvugana na we.”<verse eid="JHN 4:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="JHN 4:27" />Ako kaanya abiigiishwa be baraaza maze batangaazwa n'uko Yagaaniiraga n'umugore. Ariko ntihaagira n'umwe muri bo ubaza uwo mugore ati, “Urashaaka iki?” Cangwa ngo abaze Yesu ati, “Ni iki wagaaniiraga n'uyu mugore?”<verse eid="JHN 4:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="JHN 4:28" />Nuuko uwo mugore asiga ikivoomeesho ce, aja mu tawuni nkuru. Maze abwira abantu ati, <verse eid="JHN 4:28" /><verse number="29" style="v" sid="JHN 4:29" />“Nimuuze mureebe umuntu wambwiye ibyo nakoze byose. Aho ntiyaba ari we Kristo?” <verse eid="JHN 4:29" /><verse number="30" style="v" sid="JHN 4:30" />Bava muri iyo tawuni, basanga Yesu.<verse eid="JHN 4:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="JHN 4:31" />Ubwo abiigiishwa be baramwingingaga bati, “Mwigiisha, gira ico urya.”<verse eid="JHN 4:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="JHN 4:32" />Ariko Yesu arabasubiza ati, “Mfite ibyokurya mutaazi.”<verse eid="JHN 4:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="JHN 4:33" />Abiigiishwa be batangira kubazanya bati, “Mbese hari uwamuuzaniye ibyokurya tutaraagera hano?”<verse eid="JHN 4:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="JHN 4:34" />Yesu arabasubiza ati, “Gukora ibyo uwantumye ashaaka, no kurangiza umurimo we, ni byo byokurya byanje. <verse eid="JHN 4:34" /><verse number="35" style="v" sid="JHN 4:35" />Mbese ntimuvuga muti, ‘Hasigaye ameezi ane igihe c'isaaruura kikagera’? Ariko ndababwira nti, nimwitegereze neeza mureebe. Dore imyaka ireeze kandi itegereje gusaaruurwa. <verse eid="JHN 4:35" /><verse number="36" style="v" sid="JHN 4:36" />Umusaaruuzi ariguhembwa, maze akarundanyiriza imbuto ubugingo buhoraho, kugira ngo umubibyi n'umusaaruuzi baneezeeranwe. <verse eid="JHN 4:36" /><verse number="37" style="v" sid="JHN 4:37" />Nk'uko baca umugani w'ukuri ngo, ‘Habiba umwe, hagasaaruura undi.’ <verse eid="JHN 4:37" /><verse number="38" style="v" sid="JHN 4:38" />Nabatumye gusaaruura ibyo mutaaruhiye, abandi baarakoze bararuha, naho mwebwe mugiiye gusaaruura ibyo baaruhiye.”<verse eid="JHN 4:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="JHN 4:39" />Abasamariya benshi bo muri iyo tawuni beemera Yesu ku bw'ubuhamya bw'uwo mugore yavuze ati, “Yambwiye ibyo nakoze byose.” <verse eid="JHN 4:39" /><verse number="40" style="v" sid="JHN 4:40" />Nuuko Abasamariya bamusanga bamwinginga ngo agumane na bo, maze Yesu amarayo iminsi ebyiri.<verse eid="JHN 4:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="JHN 4:41" />Kandi benshi bizeera Yesu ku bw'ubutumwa bwe. <verse eid="JHN 4:41" /><verse number="42" style="v" sid="JHN 4:42" />Abo bantu babwira wa mugore bati, “Si ibyo watubwiye byonyine biduteera kwizeera, ariko n'uko naatwe twiyumviye, kandi tumenye ko uyu muntu ari we Mukiza w'abari mu isi.”<verse eid="JHN 4:42" /></para>
  <para style="s1">Yesu Asubira i Galileeya</para>
  <para style="p">
    <verse number="43" style="v" sid="JHN 4:43" />Iminsi ebyiri ishize, Yesu avayo aja i Galileeya. <verse eid="JHN 4:43" /><verse number="44" style="v" sid="JHN 4:44" /><note caller="-" style="x"><char style="xo" closed="false">4:44 </char><char style="xt" closed="false"><ref loc="MAT 13:57">Mat 13:57</ref>; <ref loc="MRK 6:4">Mar 6:4</ref>; <ref loc="LUK 4:24">Luk 4:24</ref>.</char></note>(Kuko Yesu ubwe yari yaravugiyeyo ko nta muhanuuzi uhaabwa icuubahiro mu gihugu c'iwaabo). <verse eid="JHN 4:44" /><verse number="45" style="v" sid="JHN 4:45" /><note caller="-" style="x"><char style="xo" closed="false">4:45 </char><char style="xt" closed="false"><ref loc="JHN 2:23">Yoh 2:23</ref>.</char></note>Ageze i Galileeya, Abanyagalileeya baramwakiira, kuko baari baaraboonye ibyo yakoreye i Yerusaalemu mu minsi mikuru, kuko na bo baari baagiiyeyo.<verse eid="JHN 4:45" /></para>
  <para style="s">Yesu Akiza Umwana w'Umutware</para>
  <para style="p">
    <verse number="46" style="v" sid="JHN 4:46" />
    <note caller="-" style="x">
      <char style="xo" closed="false">4:46 </char>
      <char style="xt" closed="false">
        <ref loc="JHN 2:1-11">Yoh 2:1-11</ref>.</char>
    </note>Yesu asubira mu tawuni y'i Kaana muri Galileeya, aho yari yarahinduriye amaazi divaayi. Umutware w'ibwami yari afite umwana urwariye i Kaperenawumu. <verse eid="JHN 4:46" /><verse number="47" style="v" sid="JHN 4:47" />Uwo mutware yumviise ko Yesu yavuuye i Yudeeya akaba ageze i Galileeya, aragenda, maze amwinginga kumanuka ngo akize umuhungu we kuko yari indembe. <verse eid="JHN 4:47" /><verse number="48" style="v" sid="JHN 4:48" />Nuuko Yesu aramubwira ati, “Mutaraabona ibimenyeetso n'ibitangaaza ntimwashobora kwizeera.”<verse eid="JHN 4:48" /></para>
  <para style="p">
    <verse number="49" style="v" sid="JHN 4:49" />Umutware aramubwira ati, “Daatabuja, banguka tujaane, umwana wanje ataraahwera.”<verse eid="JHN 4:49" /></para>
  <para style="p">
    <verse number="50" style="v" sid="JHN 4:50" />Yesu aramusubiza ati, “Subirayo, umwana waawe arabaho.” Uwo mutware yizeera ijambo Yesu amubwiye aragenda.<verse eid="JHN 4:50" /></para>
  <para style="p">
    <verse number="51" style="v" sid="JHN 4:51" />Akigenda, ahuura n'abagaragu be mu nzira bamubwira amakuru meeza ko umwana we ari muzima.<verse eid="JHN 4:51" /></para>
  <para style="p">
    <verse number="52" style="v" sid="JHN 4:52" />Nuuko abaza abagaragu be igihe umwana yatangiriye kooroherwa. Baramusubiza bati, “Ejo ku saaha indwi z'amanywa ni ho umuriro wamuvuuyemo.” <verse eid="JHN 4:52" /><verse number="53" style="v" sid="JHN 4:53" />Se w'uwo mwana wari urwaye amenya ko ari yo saaha Yesu yamubwiriye ati, “Umwana waawe ni muzima, ntaaribupfe.” Nuuko uwo mutware n'umuryango we woose bizeera Yesu.<verse eid="JHN 4:53" /></para>
  <para style="p">
    <verse number="54" style="v" sid="JHN 4:54" />Iki caari igitangaaza ca kabiri Yesu yakoze amaze kuva i Yudeeya aja i Galileeya.<verse eid="JHN 4:54" /></para>
  <chapter eid="JHN 4" />
  <chapter number="5" style="c" sid="JHN 5" />
  <para style="s1">Yesu Akiza ku Munsi w'Isaabato</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 5:1" />Nyuma y'ibi, haba iminsi y'ibirori by'Abayuuda, nuuko Yesu aja i Yerusaalemu.<verse eid="JHN 5:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="JHN 5:2" />Ubwo i Yerusaalemu haafi y'irembo ryitwa Irembo ry'Intaama haari ikidendeezi, mu ru Heburaayo ciitwa Beetsayida, kizengurutswe n'amabaraza ataanu. <verse eid="JHN 5:2" /><verse number="3" style="v" sid="JHN 5:3" />Muri ayo mabaraza haabaga haryamye abarwayi benshi caane, barimo impumyi, abarema n'abandi bamugaye. <verse eid="JHN 5:3" /><verse number="4" style="v" sid="JHN 5:4" /><note caller="+" style="f"><char style="fr" closed="false">5:4 </char><char style="ft" closed="false">Bimwe mu byanditswe byakeera, ntiharimo uyu murongo</char></note> Kuko rimwe na rimwe malayika yamanukaga akaja muri ico kidendeezi, agahindura amaazi. Amaazi akimara guhinduka, umurwayi wabanzaga kukijamo yakiraga indwara iyo ariyo yoose. <verse eid="JHN 5:4" /><verse number="5" style="v" sid="JHN 5:5" />Aho haari umugabo wari ufite indwara ayimaranye imyaka mirongo itatu n'umunaane. <verse eid="JHN 5:5" /><verse number="6" style="v" sid="JHN 5:6" />Yesu aboonye aryamye, amenya ko ahamaze igihe kireekire, aramubaza ati, “Mbese urashaaka gukira?”<verse eid="JHN 5:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="JHN 5:7" />Uwo murwayi aramusubiza ati, “Daatabuja, ntaabwo mfite uwo kunshira mu kidendeezi amaazi ahinduwe, kandi iyo ngerageza kujamo, undi muntu antanga kugeramo.”<verse eid="JHN 5:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="JHN 5:8" />Yesu aramusubiza ati, “Haguruka, wiikorere akarago kaawe ugende.” <verse eid="JHN 5:8" /><verse number="9" style="v" sid="JHN 5:9" />Muri ako kaanya uwo murwayi arakira, azinga akarago ke aragenda.</para>
  <para style="p" vid="JHN 5:9">Ibyo byabaaye ku munsi w'i Saabato.<verse eid="JHN 5:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="JHN 5:10" />Nuuko Abayuuda babwira uwo muntu wari umaze gukira bati, “Dore ni ku Saabato, ntaabwo itegeko rikwemerera kwikorera akarago kaawe.”<verse eid="JHN 5:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="JHN 5:11" />Ariko arabasubiza ati, “Uwankijije ni we wambwiye ati, ‘Ikorere akarago kaawe ugende.’ ”<verse eid="JHN 5:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 5:12" />Baramubaza bati, “Uwo ni nde wakubwiye ngo, ‘Ikorere akarago kaawe ugende’?”<verse eid="JHN 5:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="JHN 5:13" />Ariko uwo mugabo wari umaze gukira ntiyamenye uwamukijije uwo ari we, kuko Yesu yari amaze kuburira mu bantu benshi baari aho.<verse eid="JHN 5:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="JHN 5:14" />Nyuma yaho, Yesu amusanga mu Nzu y'Imaana aramubwira ati, “Dore waakize, ntukongere gukora icaaha ukundi kugira ngo utazaabona ishano rirutaho.”<verse eid="JHN 5:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="JHN 5:15" />Uwo mugabo aja kumenyeesha Abayuuda yuuko ari Yesu wamukijije. <verse eid="JHN 5:15" /><verse number="16" style="v" sid="JHN 5:16" />Nuuko Abayuuda batangira gutooteza Yesu kuko yakoraga ibintu nk'ibyo ku Saabato. <verse eid="JHN 5:16" /><verse number="17" style="v" sid="JHN 5:17" />Ariko Yesu aravuga ati, “Daata aracaakora kugeza n'ubu, kandi nanje ndigukora.”<verse eid="JHN 5:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="JHN 5:18" />Ibi bituma Abayuuda barushaho gushaaka kumwica, kuko ntiyishe itegeko ry'i Saabato gusa, ahuubwo yavuze ko Imaana ari Se, ubwo akaba ari kwigereranya na Yo.<verse eid="JHN 5:18" /></para>
  <para style="s1">Yesu Afite Ububaasha Buva ku Maana</para>
  <para style="p">
    <verse number="19" style="v" sid="JHN 5:19" />Yesu arabasubiza ati, “Ni ukuri, ndababwira yuuko Umwana w'Imaana ntaaco akora na kimwe ku bwe, kitari ico abona Se akora. Kuko ico Se akora ni co Umwana na we akora. <verse eid="JHN 5:19" /><verse number="20" style="v" sid="JHN 5:20" />Daata akunda Umwana, akamwereka ibyo akora byose Kandi azamwereka n'ibirenze ibyo kugira ngo bibatangaaze. <verse eid="JHN 5:20" /><verse number="21" style="v" sid="JHN 5:21" />Ni koko, nk'uko Daata azuura abaapfuuye akabaha ubugingo, ni ko n'Umwana aha ubugingo abo ashaaka. <verse eid="JHN 5:21" /><verse number="22" style="v" sid="JHN 5:22" />Nta n'umwe Daata aciira urubanza ahuubwo ububaasha bwo guca imanza zoose yabuhaaye uwo Mwana, <verse eid="JHN 5:22" /><verse number="23" style="v" sid="JHN 5:23" />kugira ngo boose buubahe Umwana nk'uko buubaha Se. Umuntu weese utuubaha uwo Mwana, aba atuubashe na Se wamutumye.<verse eid="JHN 5:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="JHN 5:24" />Ndababwira ukuri yuuko, uwumva ijambo ryanje akizeera uwantumye aba afite ubugingo buhoraho, kandi ntaabwo azaaciirwa urubanza, ahuubwo aba avuuye mu rupfu ageze mu bugingo.<verse eid="JHN 5:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 5:25" />Ndababwira ukuri yuuko igihe kigeze, kandi ubu kirasohoye, ubwo abaapfuuye bazumva ijwi ry'Umwana w'Imaana, maze abazaaryumva bazaabaho. <verse eid="JHN 5:25" /><verse number="26" style="v" sid="JHN 5:26" />Nk'uko Daata ari we sooko y'ubugingo, ni na ko yabuhaaye Umwana we kuba isooko y'ubugingo. <verse eid="JHN 5:26" /><verse number="27" style="v" sid="JHN 5:27" />Kandi amuha n'ububaasha bwo guca imanza, kuko ni Umwana w'Umuntu. <verse eid="JHN 5:27" /><verse number="28" style="v" sid="JHN 5:28" />Ibyo ntibibatangaaze kuko igihe kigiiye kuuza ubwo abari mu bituuro boose bazumva ijwi rye <verse eid="JHN 5:28" /><verse number="29" style="v" sid="JHN 5:29" />bakavamo. Abaakoze ibyiza, bakazuukira ubugingo, naho abaakoze ibibi bakazuukira guciirwa urubanza rw'iteeka.<verse eid="JHN 5:29" /></para>
  <para style="s1">Abahamya ba Yesu</para>
  <para style="p">
    <verse number="30" style="v" sid="JHN 5:30" />Ntaaco nshobora gukora ku bwanje. Uko numviise ni ko nca imanza, kandi imanza zo nca ni iz'ubutabeera kuko ntakurikiza ibyo nkunda ubwanje, ahuubwo nkurikiza ibyo uwantumye akunda.<verse eid="JHN 5:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="JHN 5:31" />Ndamutse niitanzeho ubuhamya, ubwo buhamya bwaba atari ukuri. <verse eid="JHN 5:31" /><verse number="32" style="v" sid="JHN 5:32" />Ariko hariho undi uhamya ibyanje, kandi nzi neeza ko ibyo ahamya kuri nje ari ukuri. <verse eid="JHN 5:32" /><verse number="33" style="v" sid="JHN 5:33" /><note caller="-" style="x"><char style="xo" closed="false">5:33 </char><char style="xt" closed="false"><ref loc="JHN 1:19-27">Yoh 1:19-27</ref>; <ref loc="JHN 3:27-30">3:27-30</ref>.</char></note>Mwohereje intumwa kuri Yohaana, na we ahamya ukuri. <verse eid="JHN 5:33" /><verse number="34" style="v" sid="JHN 5:34" />Si uko nkeneye ubuhamya bw'abantu nk'ubwo, ahuubwo mbivugiye kugira ngo mukizwe. <verse eid="JHN 5:34" /><verse number="35" style="v" sid="JHN 5:35" />Yohaana yari nk'itaara ryaka rikamurika, na mwe mwishiimiye umuco we kumara akaanya gato. <verse eid="JHN 5:35" /><verse number="36" style="v" sid="JHN 5:36" />Nyamara njeewe, mfite ubuhamya busumba ubwa Yohaana. Imirimo yo Daata yampaaye kurangiza, ni na yo mirimo ndigukora, akaba anariyo impamiriza ko natumwe na Daata. <verse eid="JHN 5:36" /><verse number="37" style="v" sid="JHN 5:37" /><note caller="-" style="x"><char style="xo" closed="false">5:37 </char><char style="xt" closed="false"><ref loc="MAT 3:17">Mat 3:17</ref>; <ref loc="MRK 1:11">Mar 1:11</ref>; <ref loc="LUK 3:22">Luk 3:22</ref>.</char></note>Kandi Daata wantumye ni we ubwe untangaho ubuhamya. Ntimwigeze kumva ijwi rye, cangwa ngo mubone ishusho ye, <verse eid="JHN 5:37" /><verse number="38" style="v" sid="JHN 5:38" />kandi ntimufite ijambo rye muri mwe, kuko ntimwemeye uwo yatumye.<verse eid="JHN 5:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="JHN 5:39" />Mushishooza Ibyanditswe kuko mwibwira yuuko muri byo harimo ubugingo buhoraho, kandi ari byo bintangaho ubuhamya. <verse eid="JHN 5:39" /><verse number="40" style="v" sid="JHN 5:40" />Ariko mukanga kunsanga kugira ngo muhaabwe ubugingo buhoraho.<verse eid="JHN 5:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="JHN 5:41" />Simparanira gushimwa n'abantu. <verse eid="JHN 5:41" /><verse number="42" style="v" sid="JHN 5:42" />Ariko nzi yuuko ari nta rukundo rw'Imaana rubarimo. <verse eid="JHN 5:42" /><verse number="43" style="v" sid="JHN 5:43" />Naaje mu izina rya Daata, ntimwanyemera, ariko hagize undi uza ahagarariye izina rye, muzamwemera. <verse eid="JHN 5:43" /><verse number="44" style="v" sid="JHN 5:44" />Mbese mwakwemera mute, kandi muharanira guhaabwa icuubahiro na bagenzi baanyu, ariko mudashaakiisha icuubahiro gituruka kuri uwo wenyine uri Imaana? <verse eid="JHN 5:44" /><verse number="45" style="v" sid="JHN 5:45" />Ntimuteekereze ko ari nje uzaabarega kuri Daata, uzaabarega ni Moose wo mwashizemo ibyiringiro. <verse eid="JHN 5:45" /><verse number="46" style="v" sid="JHN 5:46" />Niiba mwariizeeye Moose, nanje mwagombaga kunyiizeera, kuko yanditse ibinyerekeyeho. <verse eid="JHN 5:46" /><verse number="47" style="v" sid="JHN 5:47" />Ariko niiba mutiizeera ibyo Moose yanditse, muziizeera mute ibyo mbabwira?”<verse eid="JHN 5:47" /></para>
  <chapter eid="JHN 5" />
  <chapter number="6" style="c" sid="JHN 6" />
  <para style="s1">Yesu Agaburira Abantu Basaaga Ibihumbi Bitaanu</para>
  <para style="r">(<ref loc="MAT 14:13-21">Mat 14:13-21</ref>; <ref loc="MRK 6:30-44">Mar 6:30-44</ref>; <ref loc="LUK 9:10-17">Luk 9:10-17</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 6:1" />Haanyuma y'ibyo, Yesu aja hakurya y'inyanja ya Galileeya, ari na yo yitwa Tibeeriya. <verse eid="JHN 6:1" /><verse number="2" style="v" sid="JHN 6:2" />Abantu benshi bakomeza kumukurikira, kuko baari baaboonye ibitangaaza yakoreraga abarwayi. <verse eid="JHN 6:2" /><verse number="3" style="v" sid="JHN 6:3" />Yesu arazaamuuka aja ku musozi yicarayo hamwe n'abiigiishwa be. <verse eid="JHN 6:3" /><verse number="4" style="v" sid="JHN 6:4" />Ubwo iminsi yo Kunyurwaho, ari yo minsi mikuru y'Abayuuda, yari yegeereje. <verse eid="JHN 6:4" /><verse number="5" style="v" sid="JHN 6:5" />Yesu yuubuura amaaso abona abantu nyamwinshi baaza bamusanga, abaza Filipo ati, “Mbese imigaati yo kugaburira aba bantu turayiguraahe?” <verse eid="JHN 6:5" /><verse number="6" style="v" sid="JHN 6:6" />Yesu yavuze ibi, kugira ngo agerageze Filipo kuko we ubwe yari azi ico agiiye gukora.<verse eid="JHN 6:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="JHN 6:7" />Nuuko Filipo aramusubiza ati, “N'ubwo twaba dufite amashilingi yahemba umukozi imibyizi y'ameezi atandatu, ntaabwo twabona imigaati yaabahaaza ngo niibura buri umwe muri bo aboneho akavungunyukira.”<verse eid="JHN 6:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="JHN 6:8" />Umwe mu biigiishwa be wiitwaga Andereya, mwene nyina wa Simooni Peetero abwira Yesu ati, <verse eid="JHN 6:8" /><verse number="9" style="v" sid="JHN 6:9" />“Aha hari umuhungu ufite imigaati y'ingano itaanu hamwe n'isamaaki ebyiri. Ariko se, ibyo byamarira iki aba bantu boose?”<verse eid="JHN 6:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="JHN 6:10" />Yesu aravuga ati, “Nimwicaze abantu boose.” Aho hantu haari ubwatsi bwinshi, nuuko abantu<note caller="+" style="f"><char style="fr" closed="false">6:10 </char><char style="ft" closed="false">Abagabo</char></note> bariicara, boose hamwe, baari nk'abantu ibihumbi bitaanu. <verse eid="JHN 6:10" /><verse number="11" style="v" sid="JHN 6:11" />Nuuko Yesu afata iyo migaati, ayishiimira Imaana, maze ayigabira abaari biicaye. Isamaaki nazo azigenza atyo, arazibagabira, buri umwe abona ibimuhaagije nk'uko abishaaka. <verse eid="JHN 6:11" /><verse number="12" style="v" sid="JHN 6:12" />Bamaze guhaaga, Yesu abwira abiigiishwa be ati, “Nimutooragure ubuvungunyukira busigaye kugira ngo hatagira ibipfa ubusa.” <verse eid="JHN 6:12" /><verse number="13" style="v" sid="JHN 6:13" />Nuuko bakungaanyiriza hamwe ubuvungunyukira bwasaagutse kuri ya migaati itaanu bamaze kurya, buuzuza intonga cumi n'ebyiri.<verse eid="JHN 6:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="JHN 6:14" />Abantu baboonye ico gitangaaza Yesu yakoze, batangira kuvuga bati, “Ni koko, uyu ni wa Muhanuuzi ukwiriye kuuza mu isi.” <verse eid="JHN 6:14" /><verse number="15" style="v" sid="JHN 6:15" />Yesu amenye ko bari haafi kuuza kumujaana ku gahato ngo bamugire umwami, abavamo aja ku musozi wenyine.<verse eid="JHN 6:15" /></para>
  <para style="s1">Yesu Agendera ku Maazi</para>
  <para style="r">(<ref loc="MAT 14:22-33">Mat 14:22-33</ref>; <ref loc="MRK 6:45-52">Mar 6:45-52</ref>)</para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 6:16" />Bugoroobye, abiigiishwa be baramanuka baja ku nyanja. <verse eid="JHN 6:16" /><verse number="17" style="v" sid="JHN 6:17" />Bafata ubwato baja haakurya ahagana i Kaperenawumu. Bwari bumaze kwijima, kandi Yesu ntaabwo yari yaakabagezeho. <verse eid="JHN 6:17" /><verse number="18" style="v" sid="JHN 6:18" />Inyanja iriihinduriza kuko hahuushe umuyaga mwinshi. <verse eid="JHN 6:18" /><verse number="19" style="v" sid="JHN 6:19" />Bamaze kugaasha nka kilomita itaanu cangwa itandatu, babona Yesu agendeesha ibirenge ku nyanja agana ku bwato baarimo, maze bateerwa n'ubwoba. <verse eid="JHN 6:19" /><verse number="20" style="v" sid="JHN 6:20" />Ariko Yesu arababwira ati, “Ni nje, mwitiinya!” <verse eid="JHN 6:20" /><verse number="21" style="v" sid="JHN 6:21" />Bashaatse kumushira mu bwato, babona ubwato bugeze ku nkengeero aho baajaga.<verse eid="JHN 6:21" /></para>
  <para style="s1">Abantu Bagaruka Gushaaka Yesu</para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 6:22" />Bukeeye, ya mbaga y'abantu baari baasigaye hakurya y'inyanja baaza kumenya ko nta bundi bwato bwari aho. Kandi baari baaboonye ko Yesu atinjiye mu bwato n'abiigiishwa be, ariko ko abiigiishwa baari baagiiye bonyine. <verse eid="JHN 6:22" /><verse number="23" style="v" sid="JHN 6:23" />Andi maato avuuye i Tibeeriya nayo aza aho baari baariiriye imigaati Umwami Yesu amaze kuyishiimira Imaana. <verse eid="JHN 6:23" /><verse number="24" style="v" sid="JHN 6:24" />Nuuko abo bantu baboonye ko Yesu ndetse n'abiigiishwa be batari muri ayo mato, bafata ubwato baja i Kaperenawumu gushaaka Yesu.<verse eid="JHN 6:24" /></para>
  <para style="s1">Yesu ni Umugaati Utanga Ubugingo</para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 6:25" />Bamusanze haakurya y'inyanja, baramubaza bati, “Mwigiisha, mbese aha wahageze ryari?”<verse eid="JHN 6:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="JHN 6:26" />Yesu arabasubiza ati, “Ndababwira ukuri yuuko mutarikunshaaka kuko mwaboonye ibitangaaza, ahuubwo ni uko mwariye imigaati mugahaaga. <verse eid="JHN 6:26" /><verse number="27" style="v" sid="JHN 6:27" />Ntimugakorere ibyokurya bishira, ahuubwo muharanire gukorera ibyokurya bihoraho mu bugingo bw'iteeka, ubwo Umwana w'Umuntu azaabaha. Kuko ari we, Imaana Daata yashizeho ikimenyeetso.”<verse eid="JHN 6:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="JHN 6:28" />Baramubaza bati, “Twagenza dute kugira ngo dukore imirimo Imaana ishaaka?”<verse eid="JHN 6:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="JHN 6:29" />Yesu arabasubiza ati, “Umurimo Imaana ibashaakaho ni uko mwakwizeera uwo yatumye.”<verse eid="JHN 6:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="JHN 6:30" />Baramusubiza bati, “Uradukorera ikihe gitangaaza kugira ngo tukibone maze twizeere? Uratwereka gikorwa ki? <verse eid="JHN 6:30" /><verse number="31" style="v" sid="JHN 6:31" />Ba sogokuruza baariye Manu mu butaayu, nk'uko byanditswe ngo, ‘Yabagaburiye ibyokurya biturutse mu ijuru.’ ”<verse eid="JHN 6:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="JHN 6:32" />Yesu arababwira ati, “Ndababwira ukuri yuuko atari Moose wabahaaye ibyokurya biturutse mu ijuru, ahuubwo ko ari Daata utanga ibyokurya nyakuri bituruka mu ijuru. <verse eid="JHN 6:32" /><verse number="33" style="v" sid="JHN 6:33" />Kuko umugaati w'Imaana ni uwo uva mu ijuru, kandi ukaazanira isi ubugingo.”<verse eid="JHN 6:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="JHN 6:34" />Nuuko baramubwira bati, “Daatabuja, uje uhora uduha uwo mugaati.”<verse eid="JHN 6:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="JHN 6:35" />Yesu arabasubiza ati, “Ni nje mugaati w'ubugingo. Unsanga weese ntaabwo aziigera asonza, kandi unyizeera weese ntaabwo aziigera agira imyota. <verse eid="JHN 6:35" /><verse number="36" style="v" sid="JHN 6:36" />Nyamara nk'uko nababwiye, murambona ariko ntimunyizeera. <verse eid="JHN 6:36" /><verse number="37" style="v" sid="JHN 6:37" />Abo Daata ampa boose bangeraho, kandi abansanga sinzaabiirukana, <verse eid="JHN 6:37" /><verse number="38" style="v" sid="JHN 6:38" />kuko navuuye mu ijuru ntaazanywe no gukora ibyo nshaaka, ahuubwo nazanywe no gukora ibyo uwantumye ashaaka. <verse eid="JHN 6:38" /><verse number="39" style="v" sid="JHN 6:39" />Kandi ico uwantumye ashaaka ni ukutagira n'umwe nzimiza mu bo yampaaye, ahuubwo ngo nzamuzuure ku munsi wa nyuma. <verse eid="JHN 6:39" /><verse number="40" style="v" sid="JHN 6:40" />Iki ni co Daata ashaaka koko, kugira ngo abo boose babona Umwana bakamwizeera, bazaahaabwe ubugingo budashira, maze nkazaabazuura ku munsi w'imperuuka.”<verse eid="JHN 6:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="JHN 6:41" />Maze Abayuuda batangira kwitootomba kuko Yesu yari yavuze ati, “Ni nje mugaati wamanutse mu ijuru.” <verse eid="JHN 6:41" /><verse number="42" style="v" sid="JHN 6:42" />Abo Bayuuda baavugaga bati, “Uyu si Yesu, mwene Yozefu, uwo tuuzi neeza se na nyina? Noone se ubu yavuga ate ati, ‘Ni nje mugaati wamanutse mu ijuru’?”<verse eid="JHN 6:42" /></para>
  <para style="p">
    <verse number="43" style="v" sid="JHN 6:43" />Yesu arabasubiza ati, “Nimureke kwitootomba. <verse eid="JHN 6:43" /><verse number="44" style="v" sid="JHN 6:44" />Nta we ushobora kungeraho ataazanywe na Daata wantumye, kandi nzaamuzuura ku munsi wa nyuma. <verse eid="JHN 6:44" /><verse number="45" style="v" sid="JHN 6:45" />Nk'uko byanditswe n'abahanuuzi ngo, ‘Kandi boose baziigiishwa n'Imaana.’ Buri weese wumviise ibya Daata kandi akabyiga aransanga. <verse eid="JHN 6:45" /><verse number="46" style="v" sid="JHN 6:46" />Si uko hari uwigeze abona Daata, uretse uwaturutse ku Maana. Uwo ni we waboonye Daata. <verse eid="JHN 6:46" /><verse number="47" style="v" sid="JHN 6:47" />Ndababwira ukuri yuuko, uwizeera weese afite ubugingo buhoraho. <verse eid="JHN 6:47" /><verse number="48" style="v" sid="JHN 6:48" />Ni nje mugaati w'ubugingo. <verse eid="JHN 6:48" /><verse number="49" style="v" sid="JHN 6:49" />Ba sogokuruza baariiriye manu mu butaayu ariko baarapfuuye. <verse eid="JHN 6:49" /><verse number="50" style="v" sid="JHN 6:50" />Uyu ni umugaati uva mu ijuru, kugira ngo uwuriye weese yeekuzaapfa. <verse eid="JHN 6:50" /><verse number="51" style="v" sid="JHN 6:51" />Ni nje mugaati muzima wamanutse mu ijuru. Urya kuri uyu mugaati azaabaho iteeka. Umugaati nzaatangira ubugingo bw'ab'isi ni umubiri wanje.”<verse eid="JHN 6:51" /></para>
  <para style="p">
    <verse number="52" style="v" sid="JHN 6:52" />Abayuuda batangira kuja impaka bati, “Mbese uyu mugabo ashobora ate kuduha umubiri we ngo tuwurye?”<verse eid="JHN 6:52" /></para>
  <para style="p">
    <verse number="53" style="v" sid="JHN 6:53" />Nuuko Yesu arababwira ati, “Ndababwira ukuri yuuko nimutarya umubiri w'Umwana w'Umuntu, mukanywa n'amaraso ye, nta bugingo muba mufite muri mwe. <verse eid="JHN 6:53" /><verse number="54" style="v" sid="JHN 6:54" />Abarya umubiri wanje, bakanywa amaraso yanje baba bafite ubugingo buhoraho kandi nzaabazuura ku munsi w'imperuuka. <verse eid="JHN 6:54" /><verse number="55" style="v" sid="JHN 6:55" />Kuko umubiri wanje ni ibyokurya nyakuri, kandi amaraso yanje ni ibyo kunywa nyakuri. <verse eid="JHN 6:55" /><verse number="56" style="v" sid="JHN 6:56" />Umuntu weese urya umubiri wanje, akanywa n'amaraso yanje aguma muri nje, nanje nkaguma muri we. <verse eid="JHN 6:56" /><verse number="57" style="v" sid="JHN 6:57" />Nk'uko Daata uhoraho yantumye, kandi nkaba ndiho ku bwa Daata, ni na ko buri muntu weese urya umubiri wanje azaabaho ku bwanje. <verse eid="JHN 6:57" /><verse number="58" style="v" sid="JHN 6:58" />Uyu ni umugaati wamanutse mu ijuru, si nk'uwo ba sogokuruza baariiye, kandi bagapfa. Ariko urya uyu mugaati azaabaho iteeka.”<verse eid="JHN 6:58" /></para>
  <para style="p">
    <verse number="59" style="v" sid="JHN 6:59" />Ibi Yesu yabivuze igihe yiigiishirizaga mu sinagoogi y'i Kaperenawumu.<verse eid="JHN 6:59" /></para>
  <para style="s1">Amagambo y'Ubugingo Buhoraho</para>
  <para style="p">
    <verse number="60" style="v" sid="JHN 6:60" />Benshi mu biigiishwa be bumviise ibyo, baravuga bati, “Iyi nyigiisho irakomeye caane, mbese n'inde washobora kuyikurikiza?”<verse eid="JHN 6:60" /></para>
  <para style="p">
    <verse number="61" style="v" sid="JHN 6:61" />Ariko Yesu amenye ko abiigiishwa be biitotomba, arababaza ati, “Mbese ibi mvuze birabaraakaje? <verse eid="JHN 6:61" /><verse number="62" style="v" sid="JHN 6:62" />Noone se, byaba bite muboonye Umwana w'Umuntu azaamuutse aja aho yahoze mbere? <verse eid="JHN 6:62" /><verse number="63" style="v" sid="JHN 6:63" />Umwuka ni we utanga ubugingo, imbaraga z'umuntu nta co zimaze. Amagambo mbabwiye ni Umwuka n'ubugingo buhoraho. <verse eid="JHN 6:63" /><verse number="64" style="v" sid="JHN 6:64" />Ariko muri mwe, hari abatiizeera.” Kuko uheereye keera koose, Yesu yari azi abatiizeera hamwe n'uzaamugambaanira. <verse eid="JHN 6:64" /><verse number="65" style="v" sid="JHN 6:65" />Nuuko aravuga ati, “Niyo mpamvu yatumye mbabwira ko ari ntaawe ushobora kuuza kuri nje atabihaawe na Daata.”<verse eid="JHN 6:65" /></para>
  <para style="p">
    <verse number="66" style="v" sid="JHN 6:66" />Ni co caatumye, benshi mu bayoboke ba Yesu basubira inyuma ntibongera kugendana na we. <verse eid="JHN 6:66" /><verse number="67" style="v" sid="JHN 6:67" />Nuuko Yesu abaza ba biigiishwa be cumi na babiri ati, “Mbese namwe mushaaka kurekeraho kunkurikira?”<verse eid="JHN 6:67" /></para>
  <para style="p">
    <verse number="68" style="v" sid="JHN 6:68" />
    <note caller="-" style="x">
      <char style="xo" closed="false">6:68 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 16:16">Mat 16:16</ref>; <ref loc="MRK 8:29">Mar 8:29</ref>; <ref loc="LUK 9:20">Luk 9:20</ref>.</char>
    </note>Simooni Peetero aramusubiza ati, “Mwami, mbese twaja kuri nde, ko ari wowe ufite amagambo atanga ubugingo buhoraho? <verse eid="JHN 6:68" /><verse number="69" style="v" sid="JHN 6:69" />Tumaze kwemera no kumenya yuuko uri Uweera w'Imaana.”<verse eid="JHN 6:69" /></para>
  <para style="p">
    <verse number="70" style="v" sid="JHN 6:70" />Yesu arabasubiza ati, “Mbese sinabiitooranyirije, mwe cumi na babiri? Nyamara umwe muri mwe ni Sataani.” <verse eid="JHN 6:70" /><verse number="71" style="v" sid="JHN 6:71" />Ubwo Yesu yamenyeeshaga Yuda, mwene Simooni Isikariyoti. Kuko nuubwo yari umwe mu biigiishwa cumi na babiri, ni we wari kuzaamugambaanira.<verse eid="JHN 6:71" /></para>
  <chapter eid="JHN 6" />
  <chapter number="7" style="c" sid="JHN 7" />
  <para style="s1">Yesu na Bavandimwe be</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 7:1" />Nyuma y'ibyo, Yesu akomeza kugendagenda muri Galileeya. Ntiyashaakaga kuja i Yudeeya kuko Abayuuda baashaakaga uburyo bwo kumwica. <verse eid="JHN 7:1" /><verse number="2" style="v" sid="JHN 7:2" />Umunsi mukuru w'Abayuuda wiitwa ingando<note caller="+" style="f"><char style="fr" closed="false">7:2 </char><char style="bd">Ingando</char> ni iminsi mikuru yo Abayuuda bibukiraga ho igihe baazereeraga mu butaayu bataaha mu mahema.</note> wari wegeereje. <verse eid="JHN 7:2" /><verse number="3" style="v" sid="JHN 7:3" />Nuuko abavandimwe be baramubwira bati, “Va hano uje i Yudeeya, kugira ngo abiigiishwa baawe na bo bareebe imirimo ukora. <verse eid="JHN 7:3" /><verse number="4" style="v" sid="JHN 7:4" />Ntaamuntu uhisha ibikorwa bye kandi ashaaka kumenyekana. Ubwo reero ukora ibintu nk'ibyo, reka isi yoose ibimenye!” <verse eid="JHN 7:4" /><verse number="5" style="v" sid="JHN 7:5" />Kuko n'abavandimwe be ntaabwo bamwemeraga.<verse eid="JHN 7:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="JHN 7:6" />Yesu arababwira ati, “Igihe canje ntikiraagera, ariko igihe caanyu co gihoraho buri gihe. <verse eid="JHN 7:6" /><verse number="7" style="v" sid="JHN 7:7" />Ab'isi ntibashobora kubanga, ariko njeewe baranyanga kuko neemeza ko ibyo bakora ari bibi. <verse eid="JHN 7:7" /><verse number="8" style="v" sid="JHN 7:8" />Mwebwe nimuje mu birori. Nje sindibujeyo kuko igihe canje kitaraagera.” <verse eid="JHN 7:8" /><verse number="9" style="v" sid="JHN 7:9" />Amaze kubabwira ibyo, aguma i Galileeya.<verse eid="JHN 7:9" /></para>
  <para style="s1">Yesu mu Birori by'Ingando</para>
  <para style="p">
    <verse number="10" style="v" sid="JHN 7:10" />Ariko abavandimwe be bamaze kuja mu birori, Yesu na we ajayo, ariko atari kumugaragaro, ahuubwo agenda rwihishwa. <verse eid="JHN 7:10" /><verse number="11" style="v" sid="JHN 7:11" />Abayuuda baamushaakiraga muri ibyo birori, bakabaza bati, “Mbese ari he?”<verse eid="JHN 7:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 7:12" />Nuuko abantu bagera aho kongorerana kubimwerekeyeho. Ubwo bamwe baavugaga bati, “Ni umugabo mwiza,” abandi bo bakagira bati, “Oya, ahuubwo ari kuyobya abantu.” <verse eid="JHN 7:12" /><verse number="13" style="v" sid="JHN 7:13" />Ariko nta muntu wavugaga ibihereereye kuri Yesu kumugaragaro, ku bwo gutiinya Abayuuda.<verse eid="JHN 7:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="JHN 7:14" />Ibirori bigeze hagati, Yesu aja mu nzu y'Imaana maze atangira kwigiisha. <verse eid="JHN 7:14" /><verse number="15" style="v" sid="JHN 7:15" />Abayuuda birabatangaaza maze baravuga bati, “Bishoboka bite kugira ngo uyu mugabo agire ubwenge bwinshi kandi ataariigeze yiga?”<verse eid="JHN 7:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 7:16" />Yesu arabasubiza ati, “Ibyo niigiisha ntaabwo ari ibyanje, ahuubwo ni iby'uwantumye. <verse eid="JHN 7:16" /><verse number="17" style="v" sid="JHN 7:17" />Umuntu weese uhitamo gukora ibyo Imaana ishaaka, azaamenya niiba ibyo niigiisha bikomooka ku Maana, cangwa niiba mvuga ibyanje. <verse eid="JHN 7:17" /><verse number="18" style="v" sid="JHN 7:18" />Abavuga ibyabo baba biishaakira icuubahiro, ariko ushaakira icuubahiro uwamutumye ni we w'ukuri, kandi ntaabinyoma bimubamo.<verse eid="JHN 7:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="JHN 7:19" />Mbese Moose ntiyabahaaye amategeko? Nyamara nta n'umwe muri mwe uyakurikiza. Kuki mushaakiisha uburyo bwo kunyica?”<verse eid="JHN 7:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="JHN 7:20" />Rubanda ruramusubiza ruti, “Wahanzweho na dayimooni! Ni nde ushaaka kukwica?”<verse eid="JHN 7:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="JHN 7:21" />Yesu arabasubiza ati, “Nakoze igitangaaza kimwe, mwese muratangaara. <verse eid="JHN 7:21" /><verse number="22" style="v" sid="JHN 7:22" />Moose yabahaaye umuhango wo gukebwa (ariko si kuri Moose wakomootseho, ahuubwo wakomootse kuri ba sogokuruza), maze mukeba abantu ku Saabato. <verse eid="JHN 7:22" /><verse number="23" style="v" sid="JHN 7:23" /><note caller="-" style="x"><char style="xo" closed="false">7:23 </char><char style="xt" closed="false"><ref loc="JHN 5:9">Yoh 5:9</ref>.</char></note>Niiba umuntu yaakebwa ku Saabato kugira ngo itegeko rya Moose mutaryica, kuki mundaakarira kuko nakijije ubuzima bw'umuntu ku Saabato? <verse eid="JHN 7:23" /><verse number="24" style="v" sid="JHN 7:24" />Ntimugace urubanza mushingiye kubigaragara gusa, ahuubwo muce imanza mukurikije ukuri.”<verse eid="JHN 7:24" /></para>
  <para style="s1">Abantu Biibaza Niiba Yesu ari Kristo</para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 7:25" />Bamwe mu bantu batuuye i Yerusaalemu baravuga bati, “Uriiya si wa mugabo bashaaka kwica? <verse eid="JHN 7:25" /><verse number="26" style="v" sid="JHN 7:26" />Dore aravugira kumugaragaro, kandi nta co bamuvugaho! Aho abategetsi ntibaamenye ko ari Kristo? <verse eid="JHN 7:26" /><verse number="27" style="v" sid="JHN 7:27" />Uyu mugabo tuuzi aho aturuka, ariko Kristo we naaza, nta we uzaamenya aho aturuka.”<verse eid="JHN 7:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="JHN 7:28" />Yesu yigiishiriza mu nzu y'Imaana, avuga aranguruye ijwi ati, “Njeewe muranzi, kandi n'aho nkomooka murahaazi. Sinaaje ku bwanje, ahuubwo naaje ntumwe n'iy'ukuri yo mutaazi. <verse eid="JHN 7:28" /><verse number="29" style="v" sid="JHN 7:29" />Njeewe ndamuuzi, kuko nkomooka kuri we, kandi ni we wantumye.”<verse eid="JHN 7:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="JHN 7:30" />Nuuko bagerageza kumufata, ariko ntihaagira n'umwe umukozaho urutoki, kuko igihe kitaari caakageze. <verse eid="JHN 7:30" /><verse number="31" style="v" sid="JHN 7:31" />Abantu benshi mu baari bateeraniye aho baramwemera, maze baravuga bati, “Mbese Kristo naaza, azaakora ibitangaaza biruta ibyo uyu mugabo yakoze?”<verse eid="JHN 7:31" /></para>
  <para style="s1">Abarinzi Booherezwa Gufata Yesu</para>
  <para style="p">
    <verse number="32" style="v" sid="JHN 7:32" />Abafarisaayo bumva ibyo rubanda ruvuga bongorerana kuri Yesu, nuuko abatware b'abaheerezabitambo hamwe n'abafarisaayo boohereza abarinzi b'inzu y'Imaana kuja kumufata. <verse eid="JHN 7:32" /><verse number="33" style="v" sid="JHN 7:33" />Nuuko Yesu aravuga ati, “Ndacaari kumwe namwe igihe gito, haanyuma ngasanga uwantumye. <verse eid="JHN 7:33" /><verse number="34" style="v" sid="JHN 7:34" />Muzanshaaka, ariko ntimuzambona, kandi aho nzaaba ndi, ntimuzaashobora kugerayo.”<verse eid="JHN 7:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="JHN 7:35" />Nuuko Abayuuda barabazanya bati, “Mbese uyu mugabo agiiye kuja he, ho tutazaamubona? Aho ntaagiiye gusanga Abayuuda baataataaniye mu Bagiriki maze akiigiisha Abagiriki? <verse eid="JHN 7:35" /><verse number="36" style="v" sid="JHN 7:36" />Ayo magambo avuze ngo, ‘Muzanshaaka, ariko ntimuzambona’ kandi ngo ‘Aho nzaaba ndi, ntimuzaashobora kugerayo,’ amenyeesha iki?”<verse eid="JHN 7:36" /></para>
  <para style="s1">Imigezi y'Amaazi y'Ubugingo</para>
  <para style="p">
    <verse number="37" style="v" sid="JHN 7:37" />Ku munsi wa nyuma w'iminsi y'ibirori, ari wo munsi mukuru usumba iyindi, Yesu arahagarara avuga mu ijwi rirenga ati, “Ufite imyota weese nansange, <verse eid="JHN 7:37" /><verse number="38" style="v" sid="JHN 7:38" />kandi umuntu weese unyizeera, ni anywe, nk'uko ibyanditswe bivuga ngo, ‘Imigezi y'amaazi y'ubugingo izaatemba imuturukamo.’ ” <verse eid="JHN 7:38" /><verse number="39" style="v" sid="JHN 7:39" />Ibyo Yesu yabivuze yeerekeje ku Mwuka Weera, uwo abamwemera baagombaga kubona. Ico gihe Mwuka Weera yari ataraaza kuko Yesu yari atarahaabwa icuubahiro.<verse eid="JHN 7:39" /></para>
  <para style="s1">Kwigabamo Ibice kw'Abantu</para>
  <para style="p">
    <verse number="40" style="v" sid="JHN 7:40" />Bamwe muri rubanda bumviise ayo magambo baravuga bati, “Uyu koko ni wa muhanuuzi.”<verse eid="JHN 7:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="JHN 7:41" />Abandi baravuga bati, “Uyu ni we Kristo.”</para>
  <para style="p" vid="JHN 7:41">Ariko abandi barabaza bati, “Byashoboka ko Kristo aturuka i Galileeya? <verse eid="JHN 7:41" /><verse number="42" style="v" sid="JHN 7:42" />Mbese ibyanditswe ntibivuga ko Kristo azaakomooka mu rubyaro rwa Dawudi kandi akavuukira i Beetelehemu, i tawuni yo Dawudi yari atuuyemo?” <verse eid="JHN 7:42" /><verse number="43" style="v" sid="JHN 7:43" />Nuuko abantu biigabamo ibice ku bwa Yesu. <verse eid="JHN 7:43" /><verse number="44" style="v" sid="JHN 7:44" />Bamwe muri bo bashaaka kumufata, ariko ntihaagira umukozaho urutoki.<verse eid="JHN 7:44" /></para>
  <para style="s1">Ubuteemera bw'Abayobozi b'Abayuuda</para>
  <para style="p">
    <verse number="45" style="v" sid="JHN 7:45" />Ba barinzi b'Inzu y'Imaana basubira ku batware b'Abaheerezabitambo n'Abafarisaayo, nuuko babaza abarinzi bati, “Kuki mutaamufashe, mukamuuzana?”<verse eid="JHN 7:45" /></para>
  <para style="p">
    <verse number="46" style="v" sid="JHN 7:46" />Abarinzi na bo barabasubiza bati, “Yemwe, nta muntu n'umwe wigeze kuvuga nk'uyu mugabo!”<verse eid="JHN 7:46" /></para>
  <para style="p">
    <verse number="47" style="v" sid="JHN 7:47" />Abafarisaayo barabasubiza bati, “Namwe se yaabashutse? <verse eid="JHN 7:47" /><verse number="48" style="v" sid="JHN 7:48" />Haaba hariho umuntu n'umwe wo mu bategetsi cangwa mu Bafarisaayo wamwemeye? <verse eid="JHN 7:48" /><verse number="49" style="v" sid="JHN 7:49" />Ariko aba bantu nyamwinshi bataazi amategeko ya Moose, Imaana izaabavuma.”<verse eid="JHN 7:49" /></para>
  <para style="p">
    <verse number="50" style="v" sid="JHN 7:50" />
    <note caller="-" style="x">
      <char style="xo" closed="false">7:50 </char>
      <char style="xt" closed="false">
        <ref loc="JHN 3:1">Yoh 3:1</ref>,<ref loc="JHN 3:2">2</ref>.</char>
    </note>Umwe mu Bafarisaayo wari aho, ni Nikodemu kandi yari yariigeze kuja kureeba Yesu. Abwira bagenzi be ati, <verse eid="JHN 7:50" /><verse number="51" style="v" sid="JHN 7:51" />“Mbese amategeko yaacu atwemerera guciira umuntu urubanza, atabanje guhaabwa umugisha wo kwireguura no kumenya ibyo yakoze?”<verse eid="JHN 7:51" /></para>
  <para style="p">
    <verse number="52" style="v" sid="JHN 7:52" />Baramusubiza bati, “Naawe se uva i Galileeya? Ushishooze neeza mu byanditswe maze urasanga ko ari ntamuhanuuzi uzaaturuka i Galileeya.” <verse eid="JHN 7:52" /><verse number="53" style="v" sid="JHN 7:53" />Nuuko buri umwe aja iwe.<verse eid="JHN 7:53" /></para>
  <chapter eid="JHN 7" />
  <chapter number="8" style="c" sid="JHN 8" />
  <para style="s1">Umugore Wafashwe Asambana</para>
  <para style="p">[ <verse number="1" style="v" sid="JHN 8:1" />Naho Yesu we aja ku musozi wa Elayoni. <verse eid="JHN 8:1" /><verse number="2" style="v" sid="JHN 8:2" />Mu gitondo ca kare, Yesu agaruka mu nzu y'Imaana. Abantu boose baramusanga maze ariicara atangira kubiigiisha. <verse eid="JHN 8:2" /><verse number="3" style="v" sid="JHN 8:3" />Abiigiishamategeko n'Abafarisaayo baazanira Yesu umugore wafashwe asambana, bamuhagarika imbere yaabo, <verse eid="JHN 8:3" /><verse number="4" style="v" sid="JHN 8:4" />baramubwira bati, “Mwigiisha, uyu mugore yafashwe asambana. <verse eid="JHN 8:4" /><verse number="5" style="v" sid="JHN 8:5" />Mu mategeko, Moose yadutegetse kwiciisha amabuye abagore nk'abo. Noone wowe urabivugaho iki?” <verse eid="JHN 8:5" /><verse number="6" style="v" sid="JHN 8:6" />Ibyo baabivugiraga kugira ngo bamutegere mu byo avuga maze babone ibyo bamurega. Yesu we aruunama yandikiisha urutoki haasi. <verse eid="JHN 8:6" /><verse number="7" style="v" sid="JHN 8:7" />Bakomeje kumubaza aruunamuka arababwira ati, “Muri mwe udafite icaaha, ni abe ari we ubanza kumuteera ibuye.” <verse eid="JHN 8:7" /><verse number="8" style="v" sid="JHN 8:8" />Yongera kuunama yandika haasi.<note caller="+" style="f"><char style="fr" closed="false">8:8 </char><char style="ft" closed="false">Mu bindi byanditswe bya keera hongerwaho, “Ibyaha bya buri umwe.”</char></note> <verse eid="JHN 8:8" /><verse number="9" style="v" sid="JHN 8:9" />Babyumviise batyo, batangira kugenda umwe umwe, baheereye ku bakuru. Basiga Yesu wenyine hamwe na wa mugore amuhagaze imbere. <verse eid="JHN 8:9" /><verse number="10" style="v" sid="JHN 8:10" />Yesu aruunamuka aramubaza ati, “Mugore, abaakuregaga bari he? Nta n'umwe waguciiriye urubanza?”<verse eid="JHN 8:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="JHN 8:11" />Wa mugore aramusubiza ati, “Nta n'umwe daatabuja.”</para>
  <para style="p" vid="JHN 8:11">Yesu aramubwira ati, “Nanje ntaabwo nguciiriye urubanza. Genda, ariko uheereye noone ntuuzongere gukora icaaha.”]<note caller="+" style="f"><char style="fr" closed="false">8:11 </char><char style="ft">Ibyanditswe bya kare byinshi ntaabwo harimo 7:53-8:11. Mu bindi byanditswe, hano niho hongerwa iyi nyandiko cangwa igashirwa inyuma ya 7:36 cangwa 21:25 cangwa inyuma ya Luka 21:38, kandi ibyo byanditswe bikagira intandukano. Bamwe bashidikanya ibi byanditswe.</char></note><verse eid="JHN 8:11" /></para>
  <para style="s1">Yesu ni Umuco w'Isi</para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 8:12" />
    <note caller="-" style="x">
      <char style="xo" closed="false">8:12 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 5:14">Mat 5:14</ref>; <ref loc="JHN 9:5">Yoh 9:5</ref>.</char>
    </note>Yesu yongera kubwira Abafarisaayo ati, “Ninje muco w'isi. Unkurikira weese ntaabwo azaagendera mu mwijima, ahuubwo azaaba afite umuco w'ubugingo.”<verse eid="JHN 8:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="JHN 8:13" />
    <note caller="-" style="x">
      <char style="xo" closed="false">8:13 </char>
      <char style="xt" closed="false">
        <ref loc="JHN 5:31">Yoh 5:31</ref>.</char>
    </note>Nuuko Abafarisaayo baramubwira bati, “Ubwo ari wowe wiitangaho ubuhamya, ibyo uhamya ntaabwo ari iby'ukuri.”<verse eid="JHN 8:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="JHN 8:14" />Yesu arabasubiza ati, “Nuubwo ari nje witangaho ubuhamya, ibyo mpamya ni iby'ukuri kuko nzi iyo naturutse n'aho nja, ariko mwebwe ntaabwo muuzi aho naturutse cangwa aho nja. <verse eid="JHN 8:14" /><verse number="15" style="v" sid="JHN 8:15" />Mwe muca urubanza nk'abantu, ariko njeewe ntaawe nciira urubanza. <verse eid="JHN 8:15" /><verse number="16" style="v" sid="JHN 8:16" />Nuubwo naaca urubanza, naaca urw'ukuri, kuko atari njeewe uca urubanza njenyine, ahuubwo mba ndi na Daata wantumye. <verse eid="JHN 8:16" /><verse number="17" style="v" sid="JHN 8:17" />Mu mategeko yaanyu, handitswe ngo ibyo abantu babiri beemeje biba ari ukuri. <verse eid="JHN 8:17" /><verse number="18" style="v" sid="JHN 8:18" />Nje ubwanje niitangaho ubuhamya, kandi na Daata wantumye antangaho ubuhamya.”<verse eid="JHN 8:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="JHN 8:19" />Baramubaza bati, “So aba heehe?”</para>
  <para style="p" vid="JHN 8:19">Yesu arabasubiza ati, “Ntaabwo munzi kandi na Daata ntaabwo mumuuzi. Kuko iyo muba munzi, muba muuzi na Daata.”<verse eid="JHN 8:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="JHN 8:20" />Yesu yavuze aya magambo ubwo yigiishirizaga mu gisenge caabiikwagamo ibyo batuuriramo mu nzu y'Imaana, ariko ntihaagira umufata, kuko isaaha ntiyari yaakageze.<verse eid="JHN 8:20" /></para>
  <para style="s1">Yesu Avuga ku Rupfu Rwe</para>
  <para style="p">
    <verse number="21" style="v" sid="JHN 8:21" />Yesu yongera kubabwira ati, “Ndagiiye kandi muzanshaaka, ariko muzaapfaana ibyaha byanyu. Aho ngiiye, ntimushobora kujayo.”<verse eid="JHN 8:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 8:22" />Abayuuda barabazanya bati, “Mbese agiiye kwiyahura? Ni yo mpamvu avuze ati, ‘Aho ngiiye, ntimushobora kujayo’?”<verse eid="JHN 8:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="JHN 8:23" />Yesu arabasubiza ati, “Mwebwe mukomooka haasi, njeewe nkomooka heejuru. Muri ab'iyi si, ariko njeewe ntaabwo ndi uw'iyi si. <verse eid="JHN 8:23" /><verse number="24" style="v" sid="JHN 8:24" />Niyo mpamvu nababwiye ko muzaapfaana ibyaha byanyu, kandi koko nimutiizeera ko ndi we,<note caller="+" style="f"><char style="fr" closed="false">8:24</char><char style="ft">Ari njeewe</char></note> muzaapfaana ibyaha byanyu.”<verse eid="JHN 8:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 8:25" />Baramubaza bati, “Uri nde?”</para>
  <para style="p" vid="JHN 8:25">Yesu arabasubiza ati, “Ndi uwo nababwiye kuva mbere.<note caller="+" style="f"><char style="fr" closed="false">8:25 </char><char style="ft" closed="false">Mbese kuki mvugana namwe. </char></note> <verse eid="JHN 8:25" /><verse number="26" style="v" sid="JHN 8:26" />Mfite byinshi byo kubavugaho mbaciira urubanza, ariko uwantumye ni uw'ukuri, kandi ibyo namwumviiseho ni byo mbwira abari ku isi.”<verse eid="JHN 8:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="JHN 8:27" />Ntibaamenya ko yababwiraga ibyerekeye kuri Se. <verse eid="JHN 8:27" /><verse number="28" style="v" sid="JHN 8:28" />Nuuko Yesu arababwira ati, “Nimumara kuzaamuura Umwana w'Umuntu ku musaraba, nibwo muzaamenya ko ndi we,<note caller="+" style="f"><char style="fr" closed="false">8:28 </char><char style="ft" closed="false">Ari njeewe</char></note> kandi ko ari nta co nkora ku bwanje, ahuubwo mvuga ibyo Daata yambwirije. <verse eid="JHN 8:28" /><verse number="29" style="v" sid="JHN 8:29" />Kandi uwantumye turi kumwe. Ntaabwo yansize njenyine, kuko mpora nkora ibimushiimiisha.”<verse eid="JHN 8:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="JHN 8:30" />Yesu amaze kuvuga atyo, abantu benshi baramwemera.<verse eid="JHN 8:30" /></para>
  <para style="s1">Ukuri Kuzaababohoora</para>
  <para style="p">
    <verse number="31" style="v" sid="JHN 8:31" />Nuuko Yesu abwira Abayuuda baari bamwemeye ati, “Nimukomeza kumvira ijambo ryanje, muzaaba mubaaye abiigiishwa banje nyakuri. <verse eid="JHN 8:31" /><verse number="32" style="v" sid="JHN 8:32" />Kandi muzaamenya ukuri, kandi ukuri kuzaababohoora.”<verse eid="JHN 8:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="JHN 8:33" />
    <note caller="-" style="x">
      <char style="xo" closed="false">8:33 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 3:9">Mat 3:9</ref>; <ref loc="LUK 3:8">Luk 3:8</ref>.</char>
    </note>Baramusubiza bati, “Dukomooka kuri Aburahamu kandi ntaabwo twigeze tuba abagaragu. Uramenyeesha iki kuvuga ngo, ‘Muzaabohoorwa’?”<verse eid="JHN 8:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="JHN 8:34" />Yesu arabasubiza ati, “Ndababwira ukuri yuuko umuntu weese ukora icaaha aba abaaye imbohe<note caller="+" style="f"><char style="fr" closed="false">8:34 </char><char style="ft" closed="false">Umugaragu</char></note> y'icaaha. <verse eid="JHN 8:34" /><verse number="35" style="v" sid="JHN 8:35" />Umugaragu ntaabwo akomeza kuba mu muryango iteeka, ahuubwo umwana ni we uwubamo iteeka ryose. <verse eid="JHN 8:35" /><verse number="36" style="v" sid="JHN 8:36" />Noone reero niiba Umwana w'Imaana ababohooye, muzaaba mubohoowe by'ukuri. <verse eid="JHN 8:36" /><verse number="37" style="v" sid="JHN 8:37" />Nzi neeza yuuko mukomooka kuri Aburahamu, ariko mukaba mushaaka kunyica, kuko muteemera ijambo ryanje. <verse eid="JHN 8:37" /><verse number="38" style="v" sid="JHN 8:38" />Nje mvuga ibyo naboonye kuri Daata, ariko mwebwe mu gomba gukora ibyo mwumviise kuri So.”<verse eid="JHN 8:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="JHN 8:39" />Baramusubiza bati, “Daata ni Aburahamu.”</para>
  <para style="p" vid="JHN 8:39">Yesu na we arababwira ati, “Iyo muba abaana ba Aburahamu, muba mukora nk'ibyo Aburahamu yakoze. <verse eid="JHN 8:39" /><verse number="40" style="v" sid="JHN 8:40" />Dore murashaaka kunyica kandi mbabwiye ukuri ko numviise ku Maana. Ibyo ntaabwo ari byo Aburahamu yakoze. <verse eid="JHN 8:40" /><verse number="41" style="v" sid="JHN 8:41" />Mwe murakora koko ibyo so akora.”</para>
  <para style="p" vid="JHN 8:41">Baramusubiza bati, “Dufite Daata umwe, ari we Maana. Ntaabwo turi ibibyarirano.”<verse eid="JHN 8:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="JHN 8:42" />Yesu arababwira ati, “Iyo Imaana iba ari yo So, muba munkunze, kuko nanje nkomooka ku Maana nkaba ndi hano. Sinaaje ku bwanje, ahuubwo ni yo yantumye. <verse eid="JHN 8:42" /><verse number="43" style="v" sid="JHN 8:43" />Kuki mudasobaanukirwa ibyo mvuga? Ni uko mudashaaka kwemera ijambo ryanje. <verse eid="JHN 8:43" /><verse number="44" style="v" sid="JHN 8:44" />Mukomooka kuri so, ari we Sataani, kandi murashaaka gukurikiza ibyo yiifuuza. Yahoze ari umwicanyi kuva mu ntangiriro kandi ntiyiigeze ashigikira ukuri, kuko atiigeze agira ukuri. Iyo avuga ibinyoma, aba avuga ibiri ibye, kuko ari umubeeshi kandi akaba na se w'ibinyoma. <verse eid="JHN 8:44" /><verse number="45" style="v" sid="JHN 8:45" />Ariko kuko nje mbabwira ukuri, ni yo mpamvu ituma mutanyemera. <verse eid="JHN 8:45" /><verse number="46" style="v" sid="JHN 8:46" />Ni nde muri mwe wanshinja icaaha? Iyo mbabwira ukuri, kuki mutanyemera? <verse eid="JHN 8:46" /><verse number="47" style="v" sid="JHN 8:47" />Ukomooka ku Maana yumva amagambo y'Imaana. Impamvu ituma mutayumva reero, ni uko mudakomooka ku Maana.”<verse eid="JHN 8:47" /></para>
  <para style="p">
    <verse number="48" style="v" sid="JHN 8:48" />Abayuuda baramusubiza bati, “Sitwabivuze ukuri ko uri Umusamariya, kandi ko hari dayimooni ikurimo?”<verse eid="JHN 8:48" /></para>
  <para style="p">
    <verse number="49" style="v" sid="JHN 8:49" />Yesu arabasubiza ati, “Nta dayimooni mfite, ahuubwo nuubaha Daata, naho mwebwe mukansuzugura. <verse eid="JHN 8:49" /><verse number="50" style="v" sid="JHN 8:50" />Kandi siniishaakira icuubahiro, ahuubwo hariho ugishaaka kandi ni we uca urubanza. <verse eid="JHN 8:50" /><verse number="51" style="v" sid="JHN 8:51" />Ndababwira ukuri yuuko, uweemera inyigiisho zanje atazaapfa.”<verse eid="JHN 8:51" /></para>
  <para style="p">
    <verse number="52" style="v" sid="JHN 8:52" />Abayuuda baramubwira bati, “Nooneho ubu tumenye neeza ko ufite dayimooni. Aburahamu yarapfuuye, kandi n'abahanuuzi barapfa, noone wowe uravuga ngo, ‘Umuntu uzumvira ijambo ryanje ntaabwo azaapfa!’ <verse eid="JHN 8:52" /><verse number="53" style="v" sid="JHN 8:53" />Mbese uruta sogokuruza Aburahamu wapfuuye? Abahanuuzi na bo baarapfuuye. Wowe wiibwira ko uri nde?”<verse eid="JHN 8:53" /></para>
  <para style="p">
    <verse number="54" style="v" sid="JHN 8:54" />Yesu arabasubiza ati, “Iyo niiha icuubahiro, ico cuubahiro caaba gipfuuye ubusa. Ni Daata umpa icuubahiro, uwo muvuga ko ari Imaana yaanyu, <verse eid="JHN 8:54" /><verse number="55" style="v" sid="JHN 8:55" />nuubwo mutiigeze mumumenya. Ariko njeewe ndamuuzi. Ndamutse mvuze ko ntamuuzi, ubwo naaba mbaaye umubeeshi nka mwe. Ariko ndamuuzi, kandi nkurikiza ijambo rye. <verse eid="JHN 8:55" /><verse number="56" style="v" sid="JHN 8:56" />Sogokuruza Aburahamu yahimbaajwe no kuzaabona igihe co kuuza kwanje, ico gihe yarakiboonye maze araneezeerwa.”<verse eid="JHN 8:56" /></para>
  <para style="p">
    <verse number="57" style="v" sid="JHN 8:57" />Nuuko Abayuuda baramubwira bati, “Uba utari wageza imyaka mirongo itaanu, noone ngo waboonye Aburahamu?”<note caller="+" style="f"><char style="fr" closed="false">8:57 </char><char style="ft" closed="false">Ibindi byanditswe byera bya kare havuga hati, </char><char style="it">Mbese Aburahamu yakuboonyeho?</char> </note><verse eid="JHN 8:57" /></para>
  <para style="p">
    <verse number="58" style="v" sid="JHN 8:58" />Yesu arabasubiza ati, “Ndababwira ukuri, mbere yuuko Aburahamu avuuka, nari ndiho.”<verse eid="JHN 8:58" /></para>
  <para style="p">
    <verse number="59" style="v" sid="JHN 8:59" />Nuuko batooragura amabuye yo kumuteera, ariko Yesu ariihisha asohoka mu Nzu y'Imaana.<verse eid="JHN 8:59" /></para>
  <chapter eid="JHN 8" />
  <chapter number="9" style="c" sid="JHN 9" />
  <para style="s1">Yesu Avuura Umugabo Wavuutse Ahumye</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 9:1" />Ubwo Yesu yagendaga, abona umugabo wavuutse ahumye. <verse eid="JHN 9:1" /><verse number="2" style="v" sid="JHN 9:2" />Abiigiishwa be baramubaza bati, “Mwigiisha, uwakoze icaaha caatumye uyu mugabo avuuka ahumye ni nde? Ni we wakoze icaaha, cangwa ni ababyeyi be?”<verse eid="JHN 9:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="JHN 9:3" />Yesu arabasubiza ati, “Haaba uyu mugabo cangwa ababyeyi be, ntaawakoze icaaha, ahuubwo yavuutse ahumye kugira ngo imbaraga z'Imaana zigaragarire muri we. <verse eid="JHN 9:3" /><verse number="4" style="v" sid="JHN 9:4" />Tugomba gukora imirimo y'uwantumye hakiri ku manywa. Ijoro riraaje kandi muri ryo ntaawagira ico akora. <verse eid="JHN 9:4" /><verse number="5" style="v" sid="JHN 9:5" /><note caller="-" style="x"><char style="xo" closed="false">9:5 </char><char style="xt" closed="false"><ref loc="MAT 5:14">Mat 5:14</ref>; <ref loc="JHN 8:12">Yoh 8:12</ref>.</char></note>Nkiri muri iyi si, ndi umuco w'isi.”<verse eid="JHN 9:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="JHN 9:6" />Amaze kuvuga atyo, aciira haasi maze atobeesha akondo amacandwe, agasiiga ku maaso ya wa mugabo wari uhumye <verse eid="JHN 9:6" /><verse number="7" style="v" sid="JHN 9:7" />avuga ati, “Genda ukarabe amaaso yaawe mu kidendeezi ca Silowamu” (Risobaanura “gutumwa”). Nuuko uwo mugabo wari uhumye aragenda, akaraba amaaso ye, maze agaruka ari kureeba.<verse eid="JHN 9:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="JHN 9:8" />Abatuuranyi be n'abaamubonaga mbere agisabiriza batangira kubazanya bati, “Uyu si wa mugabo wicaraga asabiriza?”<verse eid="JHN 9:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="JHN 9:9" />Bamwe bakavuga bati, “Ni we.” Abandi bakavuga bati, “Ntaabwo ari we, ahuubwo ni uwo basa.”</para>
  <para style="p" vid="JHN 9:9">Maze wa mugabo arabasubiza ati, “Ni nje.”<verse eid="JHN 9:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="JHN 9:10" />Ariko bakomeza kumubaza bati, “Byagenze bite kugira ngo ureebe?”<verse eid="JHN 9:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="JHN 9:11" />Arabasubiza ati, “Wa mugabo wiitwa Yesu yatobye akondo, akansiiga ku maaso maze ambwira kuja ku kidendeezi ca Silowamu kuyakaraba. Nuuko nja yo, nkimara gukaraba, ntangira kureeba.”<verse eid="JHN 9:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 9:12" />Baramubaza bati, “Ari heehe?” Na we arabasubiza ati, “Ntaabwo mbiizi.”<verse eid="JHN 9:12" /></para>
  <para style="s1">Abafarisaayo Bacondooza Uko Uwari Ahumye Yareebye</para>
  <para style="p">
    <verse number="13" style="v" sid="JHN 9:13" />Nuuko uwo mugabo wari warahoze ari impumyi bamujaanira Abafarisaayo. <verse eid="JHN 9:13" /><verse number="14" style="v" sid="JHN 9:14" />Kandi uwo munsi wo Yesu atoba akondo agakiza uwo umugabo ubuhumyi wari umunsi w'i Saabato. <verse eid="JHN 9:14" /><verse number="15" style="v" sid="JHN 9:15" />Nuuko Abafarisaayo bongera kubaza wa mugabo uko yahumuutse. Na we arabasubiza ati, “Yansiize akondo ku maaso yanje, ndayakaraba, noone ubu ndareeba.”<verse eid="JHN 9:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 9:16" />Bamwe mu Bafarisaayo baravuga bati, “Uyu mugabo ntaabwo akomooka ku Maana, kuko ntiyubahiriza itegeko ry'i Saabato.”</para>
  <para style="p" vid="JHN 9:16">Ariko abandi na bo baravuga bati, “Byashoboka bite kugira ngo umunyabyaha akore ibitangaaza nk'ibi?” Maze biigabamo ibice.<verse eid="JHN 9:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="JHN 9:17" />Abafarisaayo bongera kubaza wa mugabo bati, “Uvuga yuuko yakuvuuye ubuhumyi, noone wowe urabivugaho iki?”</para>
  <para style="p" vid="JHN 9:17">Na we arabasubiza ati, “Ni umuhanuuzi.”<verse eid="JHN 9:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="JHN 9:18" />Ariko Abayuuda banga kwemera ko uwo mugabo yari impumyi noone akaba ari kureeba kugeza ubwo batumyeho ababyeyi be <verse eid="JHN 9:18" /><verse number="19" style="v" sid="JHN 9:19" />maze bakababaza bati, “Uyu si umuhungu waanyu? Muvuga ko yavuutse atareeba, byabaaye bite se, kugira ngo ubu abe ari kureeba?”<verse eid="JHN 9:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="JHN 9:20" />Ababyeyi be barasubiza bati, “Ico tuuzi ni uko uyu ari umuhungu waacu, kandi ko yavuutse ari impumyi, <verse eid="JHN 9:20" /><verse number="21" style="v" sid="JHN 9:21" />ariko ntaabwo tuuzi uko byagiiye ngo ashobore kureeba, cangwa ngo tumenye uwamuhumuuye amaaso. Nimumwibarize namwe, kuko ni mukuru kandi yashobora kwisubiriza!” <verse eid="JHN 9:21" /><verse number="22" style="v" sid="JHN 9:22" />Ababyeyi be baavuze batyo ku bwo gutiinya Abayuuda. Abo Bayuuda baari baamaze kwemeranya yuuko umuntu weese uzeerura ko Yesu ari Kristo yirukanwa mu Isinagoogi. <verse eid="JHN 9:22" /><verse number="23" style="v" sid="JHN 9:23" />Ni co caatumye ababyeyi be bavuga bati, “Nimukuru, mumwibarize.”<verse eid="JHN 9:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="JHN 9:24" />Abayuuda bongera guhamagara wa mugabo wari waravuutse ahumye ubwa kabiri, maze baramubwira bati, “Rahira imbere y'Imaana ko uribuvuge ukuri! Tuuzi yuuko uyu mugabo wakuvuuye ari umunyabyaha.”<verse eid="JHN 9:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 9:25" />Na we arasubiza ati, “Ntaabwo nzi niiba ari umunyabyaha, ariko ico nzi kimwe, ni uko nari impumyi, noone nkaba ndeeba.”<verse eid="JHN 9:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="JHN 9:26" />Baramubaza bati, “Yakugenjeje ate? Yahumuuye amaaso yaawe ate?”<verse eid="JHN 9:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="JHN 9:27" />Arabasubiza ati, “Naabibabwiye kandi ntimwabyumva. Kuki mushaaka kongera kubyumva? Mbese namwe mushaaka kuba abiigiishwa be?”<verse eid="JHN 9:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="JHN 9:28" />Nuuko baramutuka bamubwira bati, “Uri umwigiishwa we, ariko twebwe turi abiigiishwa ba Moose. <verse eid="JHN 9:28" /><verse number="29" style="v" sid="JHN 9:29" />Tuuzi yuuko Imaana yavuganye na Moose, ariko uyu mugabo we ntaabwo tuuzi iyo aturuka.”<verse eid="JHN 9:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="JHN 9:30" />Wa mugabo arabasubiza ati, “Ibi birantangaaje! Ntaabwo muuzi iyo aturuka, ariko yampumuuye amaaso! <verse eid="JHN 9:30" /><verse number="31" style="v" sid="JHN 9:31" />Tuuzi yuuko Imaana itumva abanyabyaha, ariko yumva uyuubaha, agakora ibyo ishaaka. <verse eid="JHN 9:31" /><verse number="32" style="v" sid="JHN 9:32" />Kuva isi yaaremwa, ntaawigeze kumva umuntu wahumuuye amaaso y'umuntu wavuutse ari impumyi. <verse eid="JHN 9:32" /><verse number="33" style="v" sid="JHN 9:33" />Iyo uyu mugabo aba adakomooka ku Maana, ntaaco aba yashoboye gukora.”<verse eid="JHN 9:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="JHN 9:34" />Baramusubiza bati, “Wowe wavuukiye mu byaha unabikuriramo, noone urashaaka kutwiigiisha?” Nuuko bamwirukana mu sinagoogi.<verse eid="JHN 9:34" /></para>
  <para style="s1">Ubuhumyi bwo mu Mwuka</para>
  <para style="p">
    <verse number="35" style="v" sid="JHN 9:35" />Yesu yumviise ko birukanye wa mugabo mu sinagoogi, aza kumubona maze aramubaza ati, “Mbese weemera Umwana w'Umuntu?”<verse eid="JHN 9:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="JHN 9:36" />Na we aramusubiza ati, “Daatabuja, mbwira uwo ari we, kugira ngo mwemere!”<verse eid="JHN 9:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="JHN 9:37" />Yesu aramubwira ati, “Wamuboonye, kandi ni we uvugana na we.”<verse eid="JHN 9:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="JHN 9:38" />Wa mugabo aravuga ati, “Ndemera Nyagasani!” Niko gupfukama imbere ya Yesu, aramuramya.<verse eid="JHN 9:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="JHN 9:39" />Nuuko Yesu aravuga ati, “Naaje muri iyi si guca urubanza, kugira ngo abo batabona bareebe, kandi ababona bahume.”<verse eid="JHN 9:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="JHN 9:40" />Bamwe mu Bafarisaayo baari hamwe na we babyumviise baramubwira bati, “Mbese naatwe turi impumyi?”<verse eid="JHN 9:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="JHN 9:41" />Yesu nawe arabasubiza ati, “Iyo muba muri impumyi, nta caaha mwajaga kugira, ariko ubwo muvuga ngo murabona, icaaha caanyu kigumyeho.”<verse eid="JHN 9:41" /></para>
  <chapter eid="JHN 9" />
  <chapter number="10" style="c" sid="JHN 10" />
  <para style="s1">Umugani w'Umushumba</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 10:1" />Yesu aravuga ati, “Ni ukuri, ni ukuri, ndababwira yuuko uwinjira mu rugo rw'intaama atanyuze mu irembo ahuubwo akuuririra ahandi aba ari umujuura cangwa umunyazi.<verse eid="JHN 10:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="JHN 10:2" />Uwinjirira mu irembo, aba ari umushumba w'intaama. <verse eid="JHN 10:2" /><verse number="3" style="v" sid="JHN 10:3" />Umurinzi amukinguurira irembo, n'intaama zikumva ijwi rye. Ahamagara intaama ze mu mazina yazo, maze akazaahura<note caller="+" style="f"><char style="fr" closed="false">10:3 </char><char style="fp" closed="false">Kwahura </char><char style="ft" closed="false">Gusohora amatungo uyanjanye kuyaragira.</char></note>. <verse eid="JHN 10:3" /><verse number="4" style="v" sid="JHN 10:4" />Iyo amaze gukuuramo intaama ze, azija imbere, zikamukurikira kuko ziizi ijwi rye. <verse eid="JHN 10:4" /><verse number="5" style="v" sid="JHN 10:5" />Ntaabwo zaakurikira uwo zitaazi, ahuubwo ziramuhunga kuko zitaazi ijwi rye”.<verse eid="JHN 10:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="JHN 10:6" />Yesu yakoreesheje ico ciitegererezo ariko ntibaasobaanukirwa ibyo ababwira.<verse eid="JHN 10:6" /></para>
  <para style="s1">Yesu Umushumba Mwiza</para>
  <para style="p">
    <verse number="7" style="v" sid="JHN 10:7" />Yesu yongera kubabwira ati, “Ndababwira ukuri yuuko ari nje rembo ry'intaama. <verse eid="JHN 10:7" /><verse number="8" style="v" sid="JHN 10:8" />Abambanjirije boose ni abajuura n'abanyazi, ariko intaama ntizaabumviise. <verse eid="JHN 10:8" /><verse number="9" style="v" sid="JHN 10:9" />Ni nje rembo. Uwinjira anyuzeho weese azaakizwa, azinjira kandi asohoke maze abone urwuri. <verse eid="JHN 10:9" /><verse number="10" style="v" sid="JHN 10:10" />Umujuura azanwa no kwiba, no kwica, no kurimbura. Nazanywe no kugira ngo abantu babone ubugingo, ndetse ngo babubone mu bwuzuye.<verse eid="JHN 10:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="JHN 10:11" />Ni nje mushumba mwiza. Umushumba mwiza ahara ubugingo bwe ku bw'intaama ze. <verse eid="JHN 10:11" /><verse number="12" style="v" sid="JHN 10:12" />Naho umupakazi, utari umushumba kandi utari nyir'intaama, iyo aboonye inyamaaswa ije, asiga intaama agahunga, nuuko inyamaaswa ikazifata maze ikazitaatanya. <verse eid="JHN 10:12" /><verse number="13" style="v" sid="JHN 10:13" />Umupakazi arahunga kuko ntaabwo yiita ku ntaama. <verse eid="JHN 10:13" /><verse number="14" style="v" sid="JHN 10:14" /><note caller="-" style="x"><char style="xo" closed="false">10:14 </char><char style="xt" closed="false"><ref loc="MAT 11:27">Mat 11:27</ref>; <ref loc="LUK 10:22">Luk 10:22</ref>.</char></note>Ni nje mushumba mwiza. Intaama zanje ndaziizi kandi na zo zikaamenya, <verse eid="JHN 10:14" /><verse number="15" style="v" sid="JHN 10:15" />nk'uko Daata anzi kandi nanje nkamenya Daata. Ndetse neemera gupfiira intaama zanje. <verse eid="JHN 10:15" /><verse number="16" style="v" sid="JHN 10:16" />Mfite n'izindi ntaama zitari izo muri uyu mukumbi. Na zo ngomba kuziizana, maze zikazumva ijwi ryanje. Nuuko hakabaho umukumbi umwe, n'umushumba umwe.<verse eid="JHN 10:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="JHN 10:17" />Ku bw'iyo mpamvu, Daata arankunda, kuko niteguuye gutanga ubugingo bwanje kugira ngo nzaabusubirane. <verse eid="JHN 10:17" /><verse number="18" style="v" sid="JHN 10:18" />Ntaawe ubunyaka, ahuubwo mbutanga ku bushaake bwanje. Mfite ubushobozi bwo kubutanga, n'ubwo kubusubirana. Iri tegeko narihaawe na Daata.”<verse eid="JHN 10:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="JHN 10:19" />Abayuuda bongera kwicamo ibice ku bw'ayo magambo. <verse eid="JHN 10:19" /><verse number="20" style="v" sid="JHN 10:20" />Benshi muri bo baaravugaga bati, “Ahanzweho dayimooni kandi yasaze. Ni kuki mumwumviriza?”<verse eid="JHN 10:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="JHN 10:21" />Ariko abandi bakavuga bati, “Aya ntaabwo ari amagambo y'umuntu uhanzweho na dayimooni. Mbese dayimooni yashobora guhumuura impumyi?”<verse eid="JHN 10:21" /></para>
  <para style="s1">Yesu Yangwa n'Abayuuda</para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 10:22" />Ico gihe hari umunsi wo kwibuka gutaaha Inzu y'Imaana i Yerusaalemu, kandi caari igihe c'imbeho nyinshi. <verse eid="JHN 10:22" /><verse number="23" style="v" sid="JHN 10:23" />Yesu yagendagendaga mu Nzu y'Imaana, munsi y'ibaraza ryitwa irya Solomooni. <verse eid="JHN 10:23" /><verse number="24" style="v" sid="JHN 10:24" />Abayuuda baramwitooroora baramubaza bati, “Uzaageza ryari kutureka mu rujijo? Tubwire neeza niiba uri Kristo.”<verse eid="JHN 10:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 10:25" />Yesu arabasubiza ati, “Narabibabwiye ntimwabyemera. Imirimo nkora mu izina rya Daata na yo intangaho ubuhamya, <verse eid="JHN 10:25" /><verse number="26" style="v" sid="JHN 10:26" />ariko ntimubyemera, kuko mutari abo mu ntaama zanje. <verse eid="JHN 10:26" /><verse number="27" style="v" sid="JHN 10:27" />Intaama zanje zumva ijwi ryanje. Ndaziizi kandi na zo zikankurikira. <verse eid="JHN 10:27" /><verse number="28" style="v" sid="JHN 10:28" />Nziha ubugingo buhoraho, kandi ntaabwo zizaarimbuka. Ntaawe uzaazinsahura mu ntoke zanje. <verse eid="JHN 10:28" /><verse number="29" style="v" sid="JHN 10:29" />Ibyo Daata yampaaye biruta ibindi byose kandi ntaawabisahura mu maboko ye.<note caller="+" style="f"><char style="fr" closed="false">10:29 </char><char style="ft" closed="false">Ibindi byanditswe bya keera bivuga ngo, Daata wazimpaaye aruta byose kandi ntaawe ubasha kuzimusahura </char></note> <verse eid="JHN 10:29" /><verse number="30" style="v" sid="JHN 10:30" />Njeewe na Daata turi umwe.”<verse eid="JHN 10:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="JHN 10:31" />Abayuuda bongera gutooragura amabuye ngo bayamuteere. <verse eid="JHN 10:31" /><verse number="32" style="v" sid="JHN 10:32" />Yesu arabasubiza ati, “Nabeeretse imirimo myiza myinshi yavuuye kuri Daata. Ni uwuhe muri yo utuma mwenda kunteera amabuye?”<verse eid="JHN 10:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="JHN 10:33" />Abayuuda baramusubiza bati, “Ntaabwo ari imirimo myiza tugiiye kuguteerera amabuye, ahuubwo ni ugusebya Imaana, kuko uri umuntu ukaba wishushanyije kuba Imaana.”<verse eid="JHN 10:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="JHN 10:34" />Yesu arabasubiza ati, “Ntibyanditswe mu mategeko yaanyu ngo Imaana yaravuze iti, ‘Muri imaana’? <verse eid="JHN 10:34" /><verse number="35" style="v" sid="JHN 10:35" />Tuuzi neeza ko ibyanditswe ari ukuri ubuzira herezo, kandi ko Imaana yiise abo bantu imaana, anari bo baahaawe ubutumwa. <verse eid="JHN 10:35" /><verse number="36" style="v" sid="JHN 10:36" />Mbese mwavuga mute ngo uwo Daata yatooranyije akamwohereza mu isi ari gusebya Imaana kuko navuze nti, ‘Ndi Umwana w'Imaana’? <verse eid="JHN 10:36" /><verse number="37" style="v" sid="JHN 10:37" />Niiba ntakora imirimo ya Daata, nimureke kunyemera. <verse eid="JHN 10:37" /><verse number="38" style="v" sid="JHN 10:38" />Ariko niiba nyikora, n'ubwo mutanyizeera, mwizeere iyo mirimo, kugira ngo mumenye kandi mwemere ko Daata ari muri nje nanje nkaba muri we.”<verse eid="JHN 10:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="JHN 10:39" />Bongera gushaaka kumufata ariko arabatoroka.<verse eid="JHN 10:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="JHN 10:40" />
    <note caller="-" style="x">
      <char style="xo" closed="false">10:40 </char>
      <char style="xt" closed="false">
        <ref loc="JHN 1:28">Yoh 1:28</ref>.</char>
    </note>Avayo yongera kuja haakurya ya Yorodaani aho Yohaana yabatirizaga mbere, agumayo. <verse eid="JHN 10:40" /><verse number="41" style="v" sid="JHN 10:41" />Abantu benshi baaza aho Yesu ari, baravuga bati, “Yohaana ntaagitangaaza yakoze, ariko ibyo yavuze kuri uyu mugabo byose byari ukuri.” <verse eid="JHN 10:41" /><verse number="42" style="v" sid="JHN 10:42" />Maze abantu benshi baariyo baramwizeera.<verse eid="JHN 10:42" /></para>
  <chapter eid="JHN 10" />
  <chapter number="11" style="c" sid="JHN 11" />
  <para style="s1">Urupfu rwa Laazaaro</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 11:1" />
    <note caller="-" style="x">
      <char style="xo" closed="false">11:1 </char>
      <char style="xt" closed="false">
        <ref loc="LUK 10:38">Luk 10:38</ref>,<ref loc="LUK 10:39">39</ref>.</char>
    </note>Haari umugabo wari urwaye wiitwaga Laazaaro akaba yari atuuye i Beetaniya, icaaro co Mariya na mwenenyina Marita baari batuuyemo. <verse eid="JHN 11:1" /><verse number="2" style="v" sid="JHN 11:2" /><note caller="-" style="x"><char style="xo" closed="false">11:2 </char><char style="xt" closed="false"><ref loc="JHN 12:3">Yoh 12:3</ref>.</char></note>Mariya uwo ni we wasiize Yesu amavuta ku birenge akabihanaguza umusatsi we, kandi musaaza we Laazaaro ni we wari urwaye. <verse eid="JHN 11:2" /><verse number="3" style="v" sid="JHN 11:3" />Bashiki be batuma kuri Yesu bati, “Nyagasani, inshuti yaawe ukunda irarwaye.”<verse eid="JHN 11:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="JHN 11:4" />Yesu abyumviise, aravuga ati, “Iyo ndwara ntaabwo ari iyo kumwica, ahuubwo ni iyo guheesha Imaana ikuzo, kugira ngo Umwana waayo ahaabwe icuubahiro.”<verse eid="JHN 11:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="JHN 11:5" />Nuubwo Yesu yakundaga Marita na mwenenyina, na Laazaaro, <verse eid="JHN 11:5" /><verse number="6" style="v" sid="JHN 11:6" />yamaze iminsi ebyiri aho yari ari, amaze kumva ko Laazaaro arwaye. <verse eid="JHN 11:6" /><verse number="7" style="v" sid="JHN 11:7" />Nyuma y'iyo minsi ebyiri, abwira abiigiishwa be ati, “Reka dusubire i Yudeeya.”<verse eid="JHN 11:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="JHN 11:8" />Abiigiishwa be baramubaza bati, “Mwigiisha, Abayuuda bendaga kuguteererayo amabuye noone ushaaka gusubirayo?”<verse eid="JHN 11:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="JHN 11:9" />Yesu arabasubiza ati, “Mbese umunsi nt'ufite amasaaha cumi n'abiri? Abagenda ku manywa ntaabwo basiitaara, kuko baba babona umuco w'iyi si. <verse eid="JHN 11:9" /><verse number="10" style="v" sid="JHN 11:10" />Ariko abagenda mu ijoro barasiitaara, kuko umuco uba utari muri bo.” <verse eid="JHN 11:10" /><verse number="11" style="v" sid="JHN 11:11" />Amaze kuvuga atyo, arababwira ati, “Inshuti yaacu Laazaaro yaasinziiriye, ariko ngiiye kumukangura.”<verse eid="JHN 11:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 11:12" />Abiigiishwa be baramubwira bati, “Nyagasani, niiba yaasinziiriye araba neeza.”<verse eid="JHN 11:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="JHN 11:13" />Yesu yavugaga iby'urupfu rwa Laazaaro, ariko bo bagateekereza ko yamenyeeshaga gusinziira kwa buri gihe. <verse eid="JHN 11:13" /><verse number="14" style="v" sid="JHN 11:14" />Nuuko Yesu arabeerurira ati, “Laazaaro yaapfuuye. <verse eid="JHN 11:14" /><verse number="15" style="v" sid="JHN 11:15" />Ariko ku bwanyu neejejwe nuuko nari ntahari, kugira ngo mwizeere. Noone, nimuuze tuje aho ari.”<verse eid="JHN 11:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 11:16" />Tomasi, witwaga Mahasa, abwira abiigiishwa bagenzi be ati, “Nimuuze naatwe tugende, dupfaane na we.”<verse eid="JHN 11:16" /></para>
  <para style="s1">Yesu ni we Kuzuuka n'Ubugingo</para>
  <para style="p">
    <verse number="17" style="v" sid="JHN 11:17" />Yesu agezeyo, asanga Laazaaro amaze iminsi enye mu mva. <verse eid="JHN 11:17" /><verse number="18" style="v" sid="JHN 11:18" />Kuva i Beetaniya kugera i Yerusaalemu haari bugufi, nka kilomita itatu, <verse eid="JHN 11:18" /><verse number="19" style="v" sid="JHN 11:19" />kandi Abayuuda benshi baari baaje gusuura Marita na Mariya kugira ngo babahuumurize ku bwo gupfuusha musaaza waabo.<verse eid="JHN 11:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="JHN 11:20" />Marita yumviise ko Yesu ari kuuza, aja kumusanganira, Mariya we asigara mu rugo. <verse eid="JHN 11:20" /><verse number="21" style="v" sid="JHN 11:21" />Marita abwira Yesu ati, “Nyagasani, iyo uba uri hano, musaaza wanje ntaaba yarapfuuye. <verse eid="JHN 11:21" /><verse number="22" style="v" sid="JHN 11:22" />Ariko n'ubu nzi yuuko ibyo usabye byose Imaana yaabiguha.”<verse eid="JHN 11:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="JHN 11:23" />Yesu aramusubiza ati, “Musaaza waawe azaazuuka.”<verse eid="JHN 11:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="JHN 11:24" />Marita aramubwira ati, “Nzi yuuko azaazuuka ku munsi w'imperuuka.”<verse eid="JHN 11:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 11:25" />Yesu aramubwira ati, “Ninje kuzuuka n'ubugingo. Unyizeera weese n'aho yaaba yarapfuuye, azaabaho, <verse eid="JHN 11:25" /><verse number="26" style="v" sid="JHN 11:26" />kandi uriho weese unyizeera ntaabwo azaapfa. Ibyo urabyemera?”<verse eid="JHN 11:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="JHN 11:27" />Marita aramusubiza ati, “Yeego Nyagasani, neemera ko uri Kristo,<note caller="+" style="f"><char style="fr" closed="false">11:27 </char><char style="ft" closed="false">Mesiya</char></note> Umwana w'Imaana, uwo yaseezeranyije kuuza mu isi.”<verse eid="JHN 11:27" /></para>
  <para style="s1">Yesu Arira</para>
  <para style="p">
    <verse number="28" style="v" sid="JHN 11:28" />Amaze kuvuga ibyo, Marita asubirayo maze ahamagara mwenenyina Mariya, aramwongorera ati, “Umwigiisha ari hano kandi araguhamagara.” <verse eid="JHN 11:28" /><verse number="29" style="v" sid="JHN 11:29" />Abyumviise, ahaguruka vuba aramusanga. <verse eid="JHN 11:29" /><verse number="30" style="v" sid="JHN 11:30" />Yesu ntaabwo yari yaakageze muri ico caaro, ahuubwo yari akiri aho Marita yamusanganiriye. <verse eid="JHN 11:30" /><verse number="31" style="v" sid="JHN 11:31" />Abayuuda baari na Mariya mu nzu bamuhuumuriza, baboonye asohotse vuba, baramukurikira biibwira yuuko agiiye kuririra ku mva.<verse eid="JHN 11:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="JHN 11:32" />Mariya ageze aho Yesu ari, amuboonye apfukama imbere ye aravuga ati, “Nyagasani, iyo uba hano, musaaza wanje ntaaba yarapfuuye.”<verse eid="JHN 11:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="JHN 11:33" />Yesu aboonye uko Mariya arira, kandi n'Abayuuda baari bamuherekeje na bo barira, bimushengura umutima agira agahinda.<verse eid="JHN 11:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="JHN 11:34" />Arababaza ati, “Mbese mwamuhambye he?” Baramusubiza bati, “Nyagasani, ngwino uhareebe.”<verse eid="JHN 11:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="JHN 11:35" />Nuuko Yesu ararira. <verse eid="JHN 11:35" /><verse number="36" style="v" sid="JHN 11:36" />Maze Abayuuda baravuga bati, “Nimureebe ukuntu yamukundaga!”<verse eid="JHN 11:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="JHN 11:37" />Ariko bamwe muri bo baravuga bati, “Mbese uwahumuuye impumyi, yari ananiwe gutuma uyu mugabo adapfa?”<verse eid="JHN 11:37" /></para>
  <para style="s1">Yesu Azuura Laazaaro</para>
  <para style="p">
    <verse number="38" style="v" sid="JHN 11:38" />Nuuko Yesu yongera gushenguka umutima, agera ku mva. Iyo mva yari ubuvumo kandi bwari bukingiishijwe ibuye. <verse eid="JHN 11:38" /><verse number="39" style="v" sid="JHN 11:39" />Yesu aravuga ati, “Ni mukuureho iryo buye.” Ariko Marita, mushiki wa nyakwigendera, aramubwira ati, “Nyagasani, ubu aranuuka kuko amaze iminsi enye apfuuye.”<verse eid="JHN 11:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="JHN 11:40" />Yesu aramubwira ati, “Sinakubwiye yuuko niweemera urabona ubwiza bw'Imaana?” <verse eid="JHN 11:40" /><verse number="41" style="v" sid="JHN 11:41" />Nuuko bakuuraho ibuye. Yesu areeba heejuru maze aravuga ati, “Daata ndagushimye kuko unyumviise. <verse eid="JHN 11:41" /><verse number="42" style="v" sid="JHN 11:42" />Nzi yuuko usanzwe unyumva, ariko ibi mbivugiye ku bw'abantu bahagaze hano kugira ngo bizeere ko ari wowe wantumye.” <verse eid="JHN 11:42" /><verse number="43" style="v" sid="JHN 11:43" />Amaze kuvuga ibyo, ahamagara mu ijwi rirenga ati, “Laazaaro, sohoka!” <verse eid="JHN 11:43" /><verse number="44" style="v" sid="JHN 11:44" />Uwari warapfuuye arasohoka, amaboko n'amaguru bye bihambijwe utugozi tw'umwenda, kandi no mu maaso he hapfukiishijwe igitambaaro. Yesu arababwira ati, “Nimumuhambuure, mumureke agende.”<verse eid="JHN 11:44" /></para>
  <para style="s1">Umugambi wo Kwica Yesu</para>
  <para style="r">(<ref loc="MAT 26:1-5">Mat 26:1-5</ref>; <ref loc="MRK 14:1-2">Mar 14:1-2</ref>; <ref loc="LUK 22:1-2">Luk 22:1-2</ref>)</para>
  <para style="p">
    <verse number="45" style="v" sid="JHN 11:45" />Benshi mu Bayuuda baari baaje gusuura Mariya baboonye ibyo Yesu akoze, baramwizeera. <verse eid="JHN 11:45" /><verse number="46" style="v" sid="JHN 11:46" />Ariko bamwe muri bo baja kubwira Abafarisaayo ibyo Yesu yakoze. <verse eid="JHN 11:46" /><verse number="47" style="v" sid="JHN 11:47" />Nuuko abatware b'abaheerezabitambo hamwe n'Abafarisaayo bahamagaza urukiiko rukuru, baravuga bati, “Turakora iki? Uyu mugabo akomeje gukora ibitangaaza byinshi. <verse eid="JHN 11:47" /><verse number="48" style="v" sid="JHN 11:48" />Nitumureka agakomezamo atyo, buri weese aramwemera, bitume Abarooma baaza kurimbura uyu mwanya waacu weera<note caller="+" style="f"><char style="fr" closed="false">11:48 </char><char style="ft" closed="false">Urusengero cangwa Inzu y'Imaana</char></note> hamwe n'umuryango waacu.”<verse eid="JHN 11:48" /></para>
  <para style="p">
    <verse number="49" style="v" sid="JHN 11:49" />Ariko umwe muri bo witwaga Kayafa, wari Umuheerezabitambo mukuru muri uwo mwaka arababwira ati, “Ntaaco muuzi na hato! <verse eid="JHN 11:49" /><verse number="50" style="v" sid="JHN 11:50" />Ntimusobaanukirwa yuuko byakababeereye byiza ngo umuntu umwe apfiire abantu kuruta uko umuryango woose warimburwa.” <verse eid="JHN 11:50" /><verse number="51" style="v" sid="JHN 11:51" />Ibyo ntiyabivuze ku bwe, ariko kuko yari Umuheerezabitambo mukuru muri uwo mwaka, yahanuuye ko Yesu yenda gupfiira ubwoko bw'Abayuuda, <verse eid="JHN 11:51" /><verse number="52" style="v" sid="JHN 11:52" />ariko si ubwo bwoko bwonyine, ahuubwo kwari ukugira ngo ahuurize hamwe abaana b'Imaana baataataanye.<verse eid="JHN 11:52" /></para>
  <para style="p">
    <verse number="53" style="v" sid="JHN 11:53" />Uheereye uwo munsi abategetsi b'Abayuuda baja inaama zo kwica Yesu. <verse eid="JHN 11:53" /><verse number="54" style="v" sid="JHN 11:54" />Nuuko Yesu ntiyongera kugenda mu Bayuuda kumugaragaro, ahuubwo avayo aja mu tawuni yitwa Efurayimu mu gice kiri haafi n'ubutaayu, agumayo n'abiigiishwa be.<verse eid="JHN 11:54" /></para>
  <para style="p">
    <verse number="55" style="v" sid="JHN 11:55" />Umunsi wo Kunyurwaho kw'Abayuuda wari weegeereje, nuuko benshi bava mu byaro baja i Yerusaalemu mbere y'umunsi wo Kunyurwaho kugira ngo bakore umuhango wo kwihumaanura. <verse eid="JHN 11:55" /><verse number="56" style="v" sid="JHN 11:56" />Baashaakaga Yesu maze bakabazanya bahagaze mu Nzu y'Imaana bati, “Murabiteekerezaho iki? Koko ntaaribuuze muri ibi birori?” <verse eid="JHN 11:56" /><verse number="57" style="v" sid="JHN 11:57" />Abatware b'abaheerezabitambo hamwe n'Abafarisaayo baari baategetse yuuko umuntu weese uri bumenye aho Yesu ari, akwiriye kubibamenyeesha kugira ngo bamufate.<verse eid="JHN 11:57" /></para>
  <chapter eid="JHN 11" />
  <chapter number="12" style="c" sid="JHN 12" />
  <para style="s1">Mariya Asiiga Yesu Amavuta</para>
  <para style="r">(<ref loc="MAT 26:6-13">Mat 26:6-13</ref>; <ref loc="MRK 14:3-9">Mar 14:3-9</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 12:1" />Hasigaye iminsi itandatu umunsi wo Kunyurwaho ukagera, Yesu aza i Beetaniya, aho Laazaaro, wo yazuuye mu baapfuuye yari atuuye. <verse eid="JHN 12:1" /><verse number="2" style="v" sid="JHN 12:2" />Bamuzimaanira ibyokurya bya nimugorooba kandi Marita aba ari we ubigabura. Laazaaro yari umwe mu baasangiraga na Yesu. <verse eid="JHN 12:2" /><verse number="3" style="v" sid="JHN 12:3" /><note caller="-" style="x"><char style="xo" closed="false">12:3 </char><char style="xt" closed="false"><ref loc="LUK 7:37">Luk 7:37</ref>,<ref loc="LUK 7:38">38</ref>.</char></note>Mariya afata icupa ry'amavuta y'agaciiro, ahuumura neeza yitwa naridi, ayasuka ku birenge bya Yesu nuuko abihanaguza umusatsi we. Inzu yoose yuuzura impumuro y'ayo mavuta. <verse eid="JHN 12:3" /><verse number="4" style="v" sid="JHN 12:4" />Yuda Isikariyoti, umwe mu biigiishwa be, uwari kuzaamugambaanira aravuga ati, <verse eid="JHN 12:4" /><verse number="5" style="v" sid="JHN 12:5" />“Mbese kuki aya mavuta ataaguriishijwe idinaari magana atatu maze zigahaabwa abakene?” <verse eid="JHN 12:5" /><verse number="6" style="v" sid="JHN 12:6" />Ntaabwo yavuze atyo ku bwo kwita ku bakene, ahuubwo ni uko yari umujuura kandi ari we wabiikaga umufuka w'amashilingi akiiba ibyo baabiikagamo.<verse eid="JHN 12:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="JHN 12:7" />Yesu aravuga ati, “Nimumureke, kuko aya mavuta yayabiikiye kugira ngo anteguurire umunsi wo guhambwa. <verse eid="JHN 12:7" /><verse number="8" style="v" sid="JHN 12:8" />Abakene muzaahorana na bo, ariko njeewe ntaabwo muzamporana.”<verse eid="JHN 12:8" /></para>
  <para style="s1">Umugambi wo Kwica Laazaaro</para>
  <para style="p">
    <verse number="9" style="v" sid="JHN 12:9" />Abayuuda benshi bamaze kumenya ko Yesu ari i Beetaniya, bajayo ariko batajanywe no kureeba Yesu gusa, ahuubwo kugira ngo babone Laazaaro uwo yari yarazuuye mu baapfuuye. <verse eid="JHN 12:9" /><verse number="10" style="v" sid="JHN 12:10" />Nuuko abatware b'abaheerezabitambo baja inaama yo kugira ngo na Laazaaro bamwice, <verse eid="JHN 12:10" /><verse number="11" style="v" sid="JHN 12:11" />kuko ari we watumaga Abayuuda benshi babaciikaho bakeemera Yesu.<verse eid="JHN 12:11" /></para>
  <para style="s1">Yesu Yinjira i Yerusaalemu mu Cuubahiro</para>
  <para style="r">(<ref loc="MAT 21:1-11">Mat 21:1-11</ref>; <ref loc="MRK 11:1-11">Mar 11:1-11</ref>; <ref loc="LUK 19:28-40">Luk 19:28-40</ref>)</para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 12:12" />Bukeeye bwaho, abantu benshi bari baaje mu minsi mikuru yo Kunyurwaho, bumva ko Yesu ari kuuza i Yerusaalemu. <verse eid="JHN 12:12" /><verse number="13" style="v" sid="JHN 12:13" />Nuuko bafata amashami y'ibiti, baja kumusanganira bateera heejuru bati,</para>
  <para style="q1" vid="JHN 12:13">“Hozaana!</para>
  <para style="q1" vid="JHN 12:13">Hahiirwa uje mu izina rya Nyagasani.</para>
  <para style="q2" vid="JHN 12:13">Umwami wa Isirayeli!”<verse eid="JHN 12:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="JHN 12:14" />Yesu aboonye icana c'indogobe aciicaraho, nk'uko byanditswe ngo,<verse eid="JHN 12:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="JHN 12:15" />“wiitiinya, mukoobwa w'i Siyoni.</para>
  <para style="q1" vid="JHN 12:15">Dore, Umwami waawe araaje,</para>
  <para style="q2" vid="JHN 12:15">yiicaye ku cana c'indogobe!”<verse eid="JHN 12:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 12:16" />Ubwambere, abiigiishwa be ntibaasobaanukiwe ibyo, ariko Yesu amaze kuzuuka agahaabwa ikuzo, ni ho bibutse ko ibyo bintu ari we byari byaranditsweho, ari na ko baabimugiriye.<verse eid="JHN 12:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="JHN 12:17" />Ba bantu benshi baari kumwe na we igihe yahamagaye Laazaaro ngo ave mu gituuro akamuzuura, bakomeza guhamya ibyo baaboonye.<note caller="+" style="f"><char style="fr" closed="false">12:17 </char><char style="ft" closed="false">Ibindi byanditswe bya keera bivuga biti, </char><char style="it">Hamwe nawe batangira guhamya yuuko yari yahamagawe kuva mu </char>baapfuuye. </note> <verse eid="JHN 12:17" /><verse number="18" style="v" sid="JHN 12:18" />Ni co caatumye abantu benshi baja kumusanganira, kuko bumviise ko yakoze ico gitangaaza. <verse eid="JHN 12:18" /><verse number="19" style="v" sid="JHN 12:19" />Abafarisaayo baravugana bati, “Murabona ko turi kurushwa n'ubusa. Dore, abantu boose baramukurikiye!”<verse eid="JHN 12:19" /></para>
  <para style="s1">Bamwe mu Bagiriki Bashaaka Kureeba Yesu</para>
  <para style="p">
    <verse number="20" style="v" sid="JHN 12:20" />Haari Abagiriki bamwe na bo baari baaje i Yerusaalemu kuramya muri iyo minsi mikuru. <verse eid="JHN 12:20" /><verse number="21" style="v" sid="JHN 12:21" />Beegeera Filipo w'i Beetsayida y'i Galileeya baramubwira bati, “Mutware, turashaaka kureeba Yesu.”<verse eid="JHN 12:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 12:22" />Filipo aja kubibwira Andereya, maze bombi baja kubibwira Yesu. <verse eid="JHN 12:22" /><verse number="23" style="v" sid="JHN 12:23" />Yesu arabasubiza ati, “Igihe kirageze kugira ngo Umwana w'Umuntu ahaabwe ikuzo. <verse eid="JHN 12:23" /><verse number="24" style="v" sid="JHN 12:24" />Ndababwira ukuri yuuko iyo akabuto k'ingano kataguuye mu taka ngo gapfe, kaguma ari kamwe konyine, ariko iyo gapfuuye keera imbuto nyinshi. <verse eid="JHN 12:24" /><verse number="25" style="v" sid="JHN 12:25" /><note caller="-" style="x"><char style="xo" closed="false">12:25 </char><char style="xt" closed="false"><ref loc="MAT 10:39">Mat 10:39</ref>; <ref loc="MAT 16:25">16:25</ref>; <ref loc="MRK 8:35">Mar 8:35</ref>; <ref loc="LUK 9:24">Luk 9:24</ref>; <ref loc="LUK 17:33">17:33</ref>.</char></note>Ukunda ubugingo bwe azaabubura, ariko utanga ubugingo bwe muri iyi si ku bwanje azaabona ubugingo buhoraho. <verse eid="JHN 12:25" /><verse number="26" style="v" sid="JHN 12:26" />Unkorera weese akwiriye kunkurikira, kuko aho ndi n'umugaragu wanje ni ho azaaba. Unkorera weese, Daata azaamuha icuubahiro.<verse eid="JHN 12:26" /></para>
  <para style="s1">Yesu Avuga Ibyerekeye Urupfu Rwe</para>
  <para style="p">
    <verse number="27" style="v" sid="JHN 12:27" />Ubu mpagaritse umutima. Noone se mvuge iki! ‘Daata, unkize iki gihe’? Oya, icanzanye ni ukugira ngo ngere kuri iki gihe c'umubabaro. <verse eid="JHN 12:27" /><verse number="28" style="v" sid="JHN 12:28" />Daata, heesha izina ryawe icuubahiro.” Nuuko ijwi rituruka mu ijuru riravuga riti, “Maze guheesha izina ryanje icuubahiro kandi nzongera kuriheesha ikuzo.”<verse eid="JHN 12:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="JHN 12:29" />Abantu benshi baari bahagaze aho bumva iryo jwi maze baravuga bati, “Ni inkuba.” Abandi baravuga bati, “Malayika avuganye na we.”<verse eid="JHN 12:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="JHN 12:30" />Yesu arabasubiza ati, “Iri jwi riije ku bwanyu, si ku bwanje. <verse eid="JHN 12:30" /><verse number="31" style="v" sid="JHN 12:31" />Ubu igihe co guciira isi urubanza kirageze. Umutware w'iyi si agiiye kuneeshwa. <verse eid="JHN 12:31" /><verse number="32" style="v" sid="JHN 12:32" />Nanje niimara kumanikwa heejuru y'isi, nziirehereza abantu boose ngo baaze aho ndi.” <verse eid="JHN 12:32" /><verse number="33" style="v" sid="JHN 12:33" />Ibyo yabivugiye kugaragaza urupfu yari agiiye gupfa urwo ari rwo.<verse eid="JHN 12:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="JHN 12:34" />Abantu nyamwinshi baramusubiza bati, “Twasomye mu bitabo by'amategeko ko Kristo azaagumaho iteeka ryose. Noone ushobora ute kuvuga ngo Umwana w'Umuntu agomba kumanikwa heejuru? Mbese uwo Mwana w'Umuntu ni nde?”<verse eid="JHN 12:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="JHN 12:35" />Yesu ni ko kubabwira ati, “Umuco uzaabaana namwe kumara igihe gito. Noone ni mugende hakibona kugira ngo umwijima utabatungura, kuko ugenda mu mwijima atamenya iyo agana. <verse eid="JHN 12:35" /><verse number="36" style="v" sid="JHN 12:36" />Mugifite umuco, muwizeere, kugira ngo mube abaana b'umuco.”</para>
  <para style="s1" vid="JHN 12:36">Abayuuda Banga Kwemera Yesu</para>
  <para style="p" vid="JHN 12:36">Yesu amaze kuvuga atyo aragenda, arabiihisha. <verse eid="JHN 12:36" /><verse number="37" style="v" sid="JHN 12:37" />N'ubwo yari yarakoreye ibitangaaza byinshi imbere yaabo, Abayuuda ntibamwizeeye. <verse eid="JHN 12:37" /><verse number="38" style="v" sid="JHN 12:38" />Ibyo byabaaye kugira ngo hasohore ibyavuzwe n'umuhanuuzi Yesaaya ati,</para>
  <para style="q1" vid="JHN 12:38">“Nyagasani, ni nde wizeeye ubutumwa twavuze?</para>
  <para style="q2" vid="JHN 12:38">Kandi imbaraga z'Uhoraho zaahishuriwe nde?”<verse eid="JHN 12:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="JHN 12:39" />Ni co gituma badashobora kwizeera kuko Yesaaya yongeye kuvuga ati,<verse eid="JHN 12:39" /></para>
  <para style="q1">
    <verse number="40" style="v" sid="JHN 12:40" />“Imaana yabahumije amaaso</para>
  <para style="q2" vid="JHN 12:40">kandi ibanangira imitima,</para>
  <para style="q1" vid="JHN 12:40">kugira ngo be kubona n'amaaso yaabo</para>
  <para style="q2" vid="JHN 12:40">kandi be gusobaanukirwa mu mitima, kugira ngo batiihana</para>
  <para style="q2" vid="JHN 12:40">nkabakiza.”<verse eid="JHN 12:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="JHN 12:41" />Yesaaya yavuze ibyo kuko yaboonye ubwiza bwa Yesu kandi amuvugaho.<verse eid="JHN 12:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="JHN 12:42" />Icakora abantu benshi, ndetse no mu batware, baaramwizeeraga, ariko ntibabivuge ku kumugaragaro kugira ngo Abafarisaayo batabaca mu sinagoogi. <verse eid="JHN 12:42" /><verse number="43" style="v" sid="JHN 12:43" />Baakunze gushimwa n'abantu kuruta gushimwa n'Imaana.<verse eid="JHN 12:43" /></para>
  <para style="s1">Ijambo rya Yesu ni ryo Mucaamanza</para>
  <para style="p">
    <verse number="44" style="v" sid="JHN 12:44" />Nuuko Yesu avuga aranguruye ati, “Unyiizeera weese si nje aba yiizeeye, ahuubwo aba yiizeeye uwantumye. <verse eid="JHN 12:44" /><verse number="45" style="v" sid="JHN 12:45" />Kandi umbona weese aba aboonye uwantumye. <verse eid="JHN 12:45" /><verse number="46" style="v" sid="JHN 12:46" />Naaje mu isi ndi umuco, kugira ngo unyizeera weese ataguma mu mwijima. <verse eid="JHN 12:46" /><verse number="47" style="v" sid="JHN 12:47" />Umuntu weese wumva amagambo yanje ntayakurikize si nje umuciira urubanza, kuko ntaazanywe no guciira abari mu isi urubanza, ahuubwo nazanywe no kubakiza. <verse eid="JHN 12:47" /><verse number="48" style="v" sid="JHN 12:48" />Unyanga, ntiyakiire amagambo yanje afite umucaamanza we, ijambo navuze ni ryo rizaamuciira urubanza ku munsi w'imperuuka! <verse eid="JHN 12:48" /><verse number="49" style="v" sid="JHN 12:49" />Kuko ntaavuze ku bwanje, ahuubwo Daata wantumye ni we wantegetse ibyo nkwiriye kuvuga nuuko nkwiriye kubivuga. <verse eid="JHN 12:49" /><verse number="50" style="v" sid="JHN 12:50" />Kandi nzi neeza yuuko itegeko rye ari ryo bugingo buhoraho. Nuuko reero ibyo mvuga, mbivuga uko Daata yabimbwiye.”<verse eid="JHN 12:50" /></para>
  <chapter eid="JHN 12" />
  <chapter number="13" style="c" sid="JHN 13" />
  <para style="s1">Yesu Akarabya Abiigiishwa be Ibirenge</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 13:1" />Mbere y'umunsi mukuru wo Kunyurwaho, Yesu yari azi ko igihe ce kigeze co kuva muri iyi si akaja kwa Se. Urukundo yakunze abe bari mu isi, ni rwo yakomeje kubakunda kugeza ku iheerezo.<verse eid="JHN 13:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="JHN 13:2" />Sataani yari yamaze kwemeza umutima wa Yuda mwene Simooni Isikariyoti ko amugambaanira. Nuuko bari gufungura ibya nimugorooba <verse eid="JHN 13:2" /><verse number="3" style="v" sid="JHN 13:3" />Yesu, azirikanye ko Se yamweguriye ibintu byose, kandi ko yakomootse ku Maana, kandi ko agomba gusubira ku Maana, <verse eid="JHN 13:3" /><verse number="4" style="v" sid="JHN 13:4" />ava ku meeza, yikuuramo umwiteero we, maze afata itaahuro arayikenyera. <verse eid="JHN 13:4" /><verse number="5" style="v" sid="JHN 13:5" />Nuuko asuka amaazi ku beesani maze atangira gukarabya ibirenge by'abiigiishwa be, akabihanaguza ya taahuro yari akenyeye. <verse eid="JHN 13:5" /><verse number="6" style="v" sid="JHN 13:6" />Ageze kuri Simooni Peetero, Peetero aramubwira ati, “Nyagasani, ugiiye kunkarabya ibirenge?”<verse eid="JHN 13:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="JHN 13:7" />Yesu aramusubiza ati, “Ntaabwo wamenya ibyo nkora ubu, ariko haanyuma uzaabisobaanukirwa.”<verse eid="JHN 13:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="JHN 13:8" />Peetero ni ko kumubwira ati, “Ntuuziigera unkarabya ibirenge.” Yesu aramusubiza ati, “Ndamutse ntagukarabije ibirenge, ntaaco tuzaaba tugihuuriyeho.”<verse eid="JHN 13:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="JHN 13:9" />Simooni Peetero ni ko kumusubiza ati, “Nooneho reero Nyagasani, ntunkarabye ibirenge byonyine, ahuubwo unkarabye n'amaboko ndetse n'umutwe!”<verse eid="JHN 13:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="JHN 13:10" />Yesu aramusubiza ati, “Uwiiyuhagiye umubiri ntaabwo aba yiifuuza gukaraba ukundi, keretse ibirenge,<note caller="+" style="f"><char style="fr" closed="false">13:10 </char><char style="ft" closed="false">Ibindi byanditswe ntibyongeraho, </char><char style="it">Keretse ibirenge.</char> </note> kuko aba yiisukuuye weese. Kandi koko murasukuuwe, n'ubwo atari mwese.” <verse eid="JHN 13:10" /><verse number="11" style="v" sid="JHN 13:11" />Yesu yari azi ugiiye kumugambaanira, kandi niyo mpamvu yavuze ati, “Ntaabwo ariko mwese muri abeere.”<verse eid="JHN 13:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 13:12" />
    <note caller="-" style="x">
      <char style="xo" closed="false">13:12 </char>
      <char style="xt" closed="false">
        <ref loc="LUK 22:27">Luk 22:27</ref>.</char>
    </note>Amaze kubakarabya ibirenge, yongera kwambara umwiteero we, no gusubira ku meeza, arababaza ati, “Aho musobaanukiwe ico maze kubakorera? <verse eid="JHN 13:12" /><verse number="13" style="v" sid="JHN 13:13" />Munyita Umwigiisha na Nyagasani, kandi koko murashitsa, kuko ni wo ndi we. <verse eid="JHN 13:13" /><verse number="14" style="v" sid="JHN 13:14" />Noone reero ubwo njeewe, Nyagasani kandi Umwigiisha mbakarabije ibirenge, namwe mugomba kuja mubikarabyanya. <verse eid="JHN 13:14" /><verse number="15" style="v" sid="JHN 13:15" />Mbahaaye urugero, kugira ngo namwe muje mukora nk'uko mbakoreye. <verse eid="JHN 13:15" /><verse number="16" style="v" sid="JHN 13:16" /><note caller="-" style="x"><char style="xo" closed="false">13:16 </char><char style="xt" closed="false"><ref loc="MAT 10:24">Mat 10:24</ref>; <ref loc="LUK 6:40">Luk 6:40</ref>; <ref loc="JHN 15:20">Yoh 15:20</ref>.</char></note>Ndababwira ukuri yuuko, nta bagaragu<note caller="+" style="f"><char style="fr" closed="false">13:16 </char><char style="ft" closed="false">Imbaata. </char></note> baruta sheebuja, kandi nta ntumwa zaaruta uwazitumye. <verse eid="JHN 13:16" /><verse number="17" style="v" sid="JHN 13:17" />Nimumenya ibyo, murahiirwa muramutse mubikurikije.<verse eid="JHN 13:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="JHN 13:18" />Ntaabwo ari mwese mvugaho, kuko nzi abo natooranyije. Ariko ni ukugira ngo ibyanditswe byuzuzwe ngo, ‘Uwo twasangiye ibyokurya ni we wampindutse.’ <verse eid="JHN 13:18" /><verse number="19" style="v" sid="JHN 13:19" />Ndabibabwira ubu bitari byaba, kugira ngo nibiba, muzeemere ko ndi we.<note caller="+" style="f"><char style="fr" closed="false">13:19 </char><char style="ft" closed="false">Ari njeewe.</char></note> <verse eid="JHN 13:19" /><verse number="20" style="v" sid="JHN 13:20" /><note caller="-" style="x"><char style="xo" closed="false">13:20 </char><char style="xt" closed="false"><ref loc="MAT 10:40">Mat 10:40</ref>; <ref loc="MRK 9:37">Mar 9:37</ref>; <ref loc="LUK 9:48">Luk 9:48</ref>; <ref loc="LUK 10:16">10:16</ref>.</char></note>Ndababwira ukuri yuuko, uwaakiira uwo ntumye aba anyakiiriye, kandi unyakiira aba yakiiriye uwantumye.”<verse eid="JHN 13:20" /></para>
  <para style="s1">Yesu Ahanuura ko Agiiye Kugambaanirwa</para>
  <para style="r">(<ref loc="MAT 26:20-25">Mat 26:20-25</ref>; <ref loc="MRK 14:17-21">Mar 14:17-21</ref>; <ref loc="LUK 22:21-23">Luk 22:21-23</ref>)</para>
  <para style="p">
    <verse number="21" style="v" sid="JHN 13:21" />Amaze kuvuga atyo, Yesu ashenguka umutima maze avuga yeeruye ati, “Ndababwira ukuri, umwe muri mwe agiiye kungambaanira.”<verse eid="JHN 13:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 13:22" />Abiigiishwa barareebana, kuko ntibaari baazi uwo yavugaga. <verse eid="JHN 13:22" /><verse number="23" style="v" sid="JHN 13:23" />Umwe mu biigiishwa ba Yesu, uwo yakundaga caane, yari yiicaye haafi ye, <verse eid="JHN 13:23" /><verse number="24" style="v" sid="JHN 13:24" />maze Simooni Peetero amwicira ijiisho ngo amubaze uwo yamenyeeshaga.<verse eid="JHN 13:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 13:25" />Nuuko wa mwigiishwa yeegeera Yesu maze aramubaza ati, “Nyagasani, uwo uvuze ni nde?”<verse eid="JHN 13:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="JHN 13:26" />Yesu aramusubiza ati, “Ni uwo ndaha ikimanyu c'umugaati maze gukoza.”<note caller="+" style="f"><char style="fr" closed="false">13:26 </char><char style="ft" closed="false">Aragikoza.</char></note> Nuuko amaze gukoza ikimanyu c'umugaati, agiheereza Yuda mwene Simooni Isikariyoti. <verse eid="JHN 13:26" /><verse number="27" style="v" sid="JHN 13:27" />Yuda amaze kwakiira ico kimanyu c'umugaati, Sataani amwinjiramo. Yesu aramubwira ati, “Ico ugiiye gukora, gikore vuba.” <verse eid="JHN 13:27" /><verse number="28" style="v" sid="JHN 13:28" />Ariko nta n'umwe mu baari ku meeza wamenye icaatumye amubwira atyo. <verse eid="JHN 13:28" /><verse number="29" style="v" sid="JHN 13:29" />Kuko Yuda yari asanzwe ari umubiitsi, bamwe baateekereje ko Yesu yamubwiraga ko aja kugura ibyo kwifashiisha ku umunsi mukuru, cangwa kugira ico aha abakene.<verse eid="JHN 13:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="JHN 13:30" />Nuuko Yuda amaze kwakiira ca kimanyu c'umugaati, ako kaanya arasohoka. Kandi haari nijoro.<verse eid="JHN 13:30" /></para>
  <para style="s1">Itegeko Risha</para>
  <para style="p">
    <verse number="31" style="v" sid="JHN 13:31" />Yuda amaze gusohoka, Yesu aravuga ati, “Ubu Umwana w'Umuntu ahaawe ikuzo, kandi Imaana na yo iheerewe ikuzo muri we. <verse eid="JHN 13:31" /><verse number="32" style="v" sid="JHN 13:32" />Kandi ubwo Imaana iheerewe ikuzo muri we,<note caller="+" style="f"><char style="fr" closed="false">13:32 </char><char style="ft" closed="false">Bimwe mu byanditswe bya keera ntaabwo bashiraho; Ubwo Imaana iheerewe ikuzo muri we.</char></note> Imaana na yo izaaha Umwana w'Umuntu ikuzo muri yo kandi igiiye kumukuza bidatinze. <verse eid="JHN 13:32" /><verse number="33" style="v" sid="JHN 13:33" /><note caller="-" style="x"><char style="xo" closed="false">13:33 </char><char style="xt" closed="false"><ref loc="JHN 7:34">Yoh 7:34</ref>.</char></note>Baana banje, ndacaari kumwe namwe akaanya gato. Muzanshaaka, kandi nk'uko nabwiye Abayuuda, ubu namwe ndabibabwiye nti, ‘Aho ngiiye, ntimushobora kuhaja.’ <verse eid="JHN 13:33" /><verse number="34" style="v" sid="JHN 13:34" /><note caller="-" style="x"><char style="xo" closed="false">13:34 </char><char style="xt" closed="false"><ref loc="JHN 15:12">Yoh 15:12</ref>,<ref loc="JHN 15:17">17</ref>; <ref loc="1JN 3:23">1 Yoh 3:23</ref>; <ref loc="2JN 1:5">2 Yoh 1:5</ref>.</char></note>Mbahaaye itegeko risha, nimukundane. Nk'uko nabakunze, abe ari ko namwe mukundana. <verse eid="JHN 13:34" /><verse number="35" style="v" sid="JHN 13:35" />Nimugirirana urukundo, ico ni co boose bazaabamenyeraho ko muri abiigiishwa banje.”<verse eid="JHN 13:35" /></para>
  <para style="s1">Yesu Avuga ko Peetero Aribumwihakane</para>
  <para style="r">(<ref loc="MAT 26:31-35">Mat 26:31-35</ref>; <ref loc="MRK 14:27-31">Mar 14:27-31</ref>; <ref loc="LUK 22:31-34">Luk 22:31-34</ref>)</para>
  <para style="p">
    <verse number="36" style="v" sid="JHN 13:36" />Simooni Peetero aramubaza ati, “Nyagasani, ugiiye he?” Yesu aramusubiza ati,</para>
  <para style="p" vid="JHN 13:36">“Aho ngiiye ubu, ntuushobora kunkurikira, ariko uzankurikira ubundi.”<verse eid="JHN 13:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="JHN 13:37" />Peetero aravuga ati, “Nyagasani, icambuza kugukurikira ubu ni iki? Niiteguuye no kugupfiira.”<verse eid="JHN 13:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="JHN 13:38" />Yesu aramusubiza ati, “Witeguuye kuzampfiira? Ndakubwira ukuri yuuko isaaki itaraabika, uraba umaze kunyihakana gatatu.”<verse eid="JHN 13:38" /></para>
  <chapter eid="JHN 13" />
  <chapter number="14" style="c" sid="JHN 14" />
  <para style="s1">Yesu ni we Nzira Ija kwa Daata</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 14:1" />Yesu arababwira ati, “Ntimuhagarike imitima yaanyu. Mwizeere Imaana, nanje munyizeere. <verse eid="JHN 14:1" /><verse number="2" style="v" sid="JHN 14:2" />Mu nzu ya Daata harimo ibisenge byinshi. Iyo biba bitameze bityo, mba ntaarababwiye ko ngiye kubateguurira umwanya. <verse eid="JHN 14:2" /><verse number="3" style="v" sid="JHN 14:3" />Kandi niimara kubateguurira umwanya, nzaagaruka maze mbijanire, kugira ngo aho ndi namwe abe ari ho muba. <verse eid="JHN 14:3" /><verse number="4" style="v" sid="JHN 14:4" />Kandi inzira ija aho ngiiye murayiizi.”<verse eid="JHN 14:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="JHN 14:5" />Tomasi aramubaza ati, “Nyagasani, twaba tutaazi aho ugiiye, maze tukamenya inzira ijayo?”<verse eid="JHN 14:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="JHN 14:6" />Yesu aramusubiza ati, “Ni nje nzira, n'ukuri, n'ubugingo. Ntaawe uja kwa Daata atanyuze kuri nje. <verse eid="JHN 14:6" /><verse number="7" style="v" sid="JHN 14:7" />Niiba munzi, na Daata muzaamumenya. Ndetse kuva uyu munsi muramuuzi kandi mwaramuboonye.”<verse eid="JHN 14:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="JHN 14:8" />Filipo aramubwira ati, “Nyagasani, twereke So, ibyo biraba bihaagije.”<verse eid="JHN 14:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="JHN 14:9" />Yesu aramusubiza ati, “Filipo we, n'iki gihe coose tumaranye noone ukaba utanzi? Uwamboonye weese aba yaaboonye na Daata. Noone ushobora ute kuvuga ngo, ‘Twereke So’? <verse eid="JHN 14:9" /><verse number="10" style="v" sid="JHN 14:10" />Ntaabwo mwemera ko ndi muri Daata, na Daata akaba muri nje? Amagambo mbabwira sinyavuga ku bwanje, ahuubwo Daata umporamo ni we ukora imirimo ye. <verse eid="JHN 14:10" /><verse number="11" style="v" sid="JHN 14:11" />Nimwemere ko ndi muri Daata na Daata akaba muri nje, ariko niiba mutabyemera, niibura nimwemezwe n'imirimo nkora. <verse eid="JHN 14:11" /><verse number="12" style="v" sid="JHN 14:12" />Ndababwira ukuri, ko unyemera azaakora imirimo nkora, kandi azaakora n'ibiruta ibi, kuko ngiye kwa Daata. <verse eid="JHN 14:12" /><verse number="13" style="v" sid="JHN 14:13" />Byongeye kandi, nzaakora ico muzansaba coose mu izina ryanje, kugira ngo Daata aheererwe ikuzo mu Mwana. <verse eid="JHN 14:13" /><verse number="14" style="v" sid="JHN 14:14" />Nimugira ico musaba coose mu izina ryanje, nzaagikora.<verse eid="JHN 14:14" /></para>
  <para style="s1">Yesu Aseezeranya Umwuka Weera</para>
  <para style="p">
    <verse number="15" style="v" sid="JHN 14:15" />Niiba munkunda, muzuubahiriza amategeko yanje. <verse eid="JHN 14:15" /><verse number="16" style="v" sid="JHN 14:16" />Nanje nzaasaba Daata, na we azaabaha undi Mufasha, kugira ngo abaane namwe ibihe byose. <verse eid="JHN 14:16" /><verse number="17" style="v" sid="JHN 14:17" />Uwo ni we Mwuka w'ukuri, wo ab'isi badashobora kwakiira kuko batamubona kandi batamuuzi. Ariko mwebwe muramuuzi, kuko abaana namwe, kandi azaaba muri mwe.<verse eid="JHN 14:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="JHN 14:18" />Sinzaabasiga mwenyine nk'imfubyi, nzaabagarukira. <verse eid="JHN 14:18" /><verse number="19" style="v" sid="JHN 14:19" />Mumwanya muto, ab'isi ntibazongera kumbona, ariko mwebwe muzambona, kuko ndiho, namwe muzaabaho. <verse eid="JHN 14:19" /><verse number="20" style="v" sid="JHN 14:20" />Uwo munsi muzaamenya ko mba muri Daata, kandi namwe mukaba muri nje, nk'uko nanje ndi muri mwe.<verse eid="JHN 14:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="JHN 14:21" />Abeemera amategeko yanje kandi bakayakurikiza ni bo bankunda, kandi abankunda bazaakundwa na Daata, nanje nzaabakunda kandi mbiyereke.”<verse eid="JHN 14:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 14:22" />Yuda (Utari Isikariyoti) aramubaza ati, “Nyagasani, uzaatwiyereka twenyine ute, utiyeretse ab'isi?”<verse eid="JHN 14:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="JHN 14:23" />Yesu aramusubiza ati, “Abankunda bazuubaha ijambo ryanje, kandi na Daata azaabakunda, maze nje na Daata tubasange tubaane na bo. <verse eid="JHN 14:23" /><verse number="24" style="v" sid="JHN 14:24" />Utankunda weese ntaakurikiza inyigiisho yanje, kandi inyigiisho mwumva si iyanje, ahuubwo ni iya Daata wantumye.<verse eid="JHN 14:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 14:25" />Ibi mbibabwiye nkiri kumwe namwe, <verse eid="JHN 14:25" /><verse number="26" style="v" sid="JHN 14:26" />ariko Umufasha, ari we Mwuka Weera, uwo Daata azoohereza mu izina ryanje, ni we uzaabiigiisha byose, kandi abiibutse ibyo nababwiye byose.<verse eid="JHN 14:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="JHN 14:27" />Mbasigiye amahoro, mbahaaye amahoro yanje. Sinyabahaaye nk'uko ab'isi bayatanga. Ntimuhagarike imitima, kandi ntimugire ubwoba. <verse eid="JHN 14:27" /><verse number="28" style="v" sid="JHN 14:28" />Mwumviise mbabwira nti, ‘Ndagiiye, kandi nzaabagarukira.’ Iyaaba mwankundaga, mwakwishiimiye ko ngiiye kwa Daata, kuko Daata anduta. <verse eid="JHN 14:28" /><verse number="29" style="v" sid="JHN 14:29" />Dore ibyo mbibabwiye bitari byaba, kugira ngo nibiba, muzeemere. <verse eid="JHN 14:29" /><verse number="30" style="v" sid="JHN 14:30" />Sinzongera kuvugana namwe byinshi, kuko umutegetsi w'iyi si arenda kuuza. Ntabubaasha amfiteho, <verse eid="JHN 14:30" /><verse number="31" style="v" sid="JHN 14:31" />ahuubwo nkora uko Daata yantegetse, kugira ngo isi imenye ko mukunda. Nimuhaguruke, tuve hano.”<verse eid="JHN 14:31" /></para>
  <chapter eid="JHN 14" />
  <chapter number="15" style="c" sid="JHN 15" />
  <para style="s1">Yesu ni Umuzaabibu w'Ukuri</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 15:1" />“Ndi umuzaabibu w'ukuri, naho Daata akaba umuhinzi. <verse eid="JHN 15:1" /><verse number="2" style="v" sid="JHN 15:2" />Ishami ryose ryo muri nje riteera imbuto arikuuraho. Ishami ryose ryera imbuto araryicira<note caller="+" style="f"><char style="fr" closed="false">15:2 </char><char style="ft" closed="false">Mu rurimi rw'urugiriki, kimenyeesha kwicira no kwezwa</char></note> kugira ngo rirusheho kwera izindi mbuto. <verse eid="JHN 15:2" /><verse number="3" style="v" sid="JHN 15:3" />Mwebwe mwejejwe n'ijambo nababwiye. <verse eid="JHN 15:3" /><verse number="4" style="v" sid="JHN 15:4" />Mugume muri nje, nk'uko nanje nguma muri mwe. Nk'uko ishami ridashobora kwera imbuto ku bwaryo ritari ku muzaabibu, namwe ni ko mutaashobora kwera imbuto mutagumye muri nje.<verse eid="JHN 15:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="JHN 15:5" />Nje ndi umuzaabibu, kandi mwe muri amashami. Uguma muri nje, nanje nkaguma muri we, yeera imbuto nyinshi, kuko tutari kumwe nta co mwashobora gukora. <verse eid="JHN 15:5" /><verse number="6" style="v" sid="JHN 15:6" />Utaguma muri nje, ajugunywa nk'ishami maze akuumagatana. Amashami ameze atyo barayakungaanya, bakayajugunya mu muriro, agasha. <verse eid="JHN 15:6" /><verse number="7" style="v" sid="JHN 15:7" />Nimuguma muri nje, n'amagambo yanje akaguma muri mwe, musabe ico mushaaka coose, muzaagihaabwa. <verse eid="JHN 15:7" /><verse number="8" style="v" sid="JHN 15:8" />Igiheesha Daata icuubahiro ni uko mwakwera imbuto nyinshi kandi mukaba abiigiishwa banje. <verse eid="JHN 15:8" /><verse number="9" style="v" sid="JHN 15:9" />Uko Daata yankunze, ni ko nabakunze. Nimugume mu rukundo rwanje. <verse eid="JHN 15:9" /><verse number="10" style="v" sid="JHN 15:10" />Nimwubaha amategeko yanje, muzaaguma mu rukundo rwanje, nk'uko nanje nuubaha amategeko ya Daata, maze nkaguma mu rukundo rwe.<verse eid="JHN 15:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="JHN 15:11" />Ibi mbibabwiye ngira ngo umuneezeero wanje ube muri mwe, kandi ngo umuneezeero waanyu ube mwinshi. <verse eid="JHN 15:11" /><verse number="12" style="v" sid="JHN 15:12" /><note caller="-" style="x"><char style="xo" closed="false">15:12 </char><char style="xt" closed="false"><ref loc="JHN 13:34">Yoh 13:34</ref>; <ref loc="JHN 15:17">15:17</ref>; <ref loc="1JN 3:23">1 Yoh 3:23</ref>; <ref loc="2JN 1:5">2 Yoh 1:5</ref>.</char></note>Itegeko ryanje ngiri, mukundane nk'uko nanje nabakunze. <verse eid="JHN 15:12" /><verse number="13" style="v" sid="JHN 15:13" />Ntaawagira urukundo ruruta urw'umuntu gupfiira inshuti ze. <verse eid="JHN 15:13" /><verse number="14" style="v" sid="JHN 15:14" />Muri inshuti zanje, nimukora ibyo mbategetse. <verse eid="JHN 15:14" /><verse number="15" style="v" sid="JHN 15:15" />Sinkibiita abagaragu, kuko umugaragu atamenya ico sheebuja akora, ahuubwo mbiise inshuti zanje, kuko nabamenyesheje ibyo numviise kuri Daata byose. <verse eid="JHN 15:15" /><verse number="16" style="v" sid="JHN 15:16" />Si mwe mwantooranyije, ahuubwo ni nje wabatooranyije. Nabatumye kuja kwera imbuto, kandi ngo izo mbuto zigumeho, kugira ngo Daata azaabahe ico muzaasaba coose mu izina ryanje. <verse eid="JHN 15:16" /><verse number="17" style="v" sid="JHN 15:17" />Mbategetse kugira ngo mukundane.<verse eid="JHN 15:17" /></para>
  <para style="s1">Urwango rw'Isi</para>
  <para style="p">
    <verse number="18" style="v" sid="JHN 15:18" />Abantu b'isi nibabanga, mumenye ko ari nje baabanje kwanga bataraabanga. <verse eid="JHN 15:18" /><verse number="19" style="v" sid="JHN 15:19" />Iyo muba ab'isi<note caller="+" style="f"><char style="fr" closed="false">15:19 </char><char style="ft" closed="false">Ab'iyi si </char></note>, baari kubakunda nk'uko bakunda abaabo. Ariko kuko mutari ab'isi, ahuubwo nkaba narabatooranyije mu b'isi, ni co gituma ab'isi babanga. <verse eid="JHN 15:19" /><verse number="20" style="v" sid="JHN 15:20" /><note caller="-" style="x"><char style="xo" closed="false">15:20 </char><char style="xt" closed="false"><ref loc="MAT 10:24">Mat 10:24</ref>; <ref loc="LUK 6:40">Luk 6:40</ref>; <ref loc="JHN 13:16">Yoh 13:16</ref>.</char></note>Mwibuke ijambo nababwiye nti, ‘umugaragu ntaaruta sheebuja.’ Niiba bantooteza, namwe bazaabatooteza, kandi niiba baarakurikije inyigiisho yanje, n'iyaanyu bazaayikurikiza. <verse eid="JHN 15:20" /><verse number="21" style="v" sid="JHN 15:21" />Ariko ibi byose bazaabibakorera babaziza izina ryanje, kuko bataazi uwantumye. <verse eid="JHN 15:21" /><verse number="22" style="v" sid="JHN 15:22" />Iyo ntaaza ngo mvugane na bo, ntibaba bafite icaaha, ariko ubu ntibafite uko bakwireguura icaaha caabo. <verse eid="JHN 15:22" /><verse number="23" style="v" sid="JHN 15:23" />Unyanga weese aba yanga na Daata. <verse eid="JHN 15:23" /><verse number="24" style="v" sid="JHN 15:24" />Iyo ntagaragaza muri bo ibitangaaza bitiigeze gukorwa n'undi muntu weese, ntibaajaga kugira icaaha. Ariko baarabiboonye, bararenga baranyanga, hamwe na Daata. <verse eid="JHN 15:24" /><verse number="25" style="v" sid="JHN 15:25" />Ibyo byabaaye kugira ngo ibyanditswe mu mategeko yaabo byuzuzwe ngo, ‘Banyanze nta co banziza.’<verse eid="JHN 15:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="JHN 15:26" />Ubwo Umufasha nzaabooherereza avuuye kuri Daata azaaza, ari we Mwuka w'ukuri ukomooka kuri Daata, azambeera umuhamya. <verse eid="JHN 15:26" /><verse number="27" style="v" sid="JHN 15:27" />Namwe reero muzantangeho ubuhamya kuko mwabanye nanje kuva mu ntangiriro.<verse eid="JHN 15:27" /></para>
  <chapter eid="JHN 15" />
  <chapter number="16" style="c" sid="JHN 16" />
  <para style="p">
    <verse number="1" style="v" sid="JHN 16:1" />Ibyo mbibabwiye ngira ngo hatagira ikibaguusha. <verse eid="JHN 16:1" /><verse number="2" style="v" sid="JHN 16:2" />Bazaabaca mu masinagoogi kandi igihe kigiiye kugera, aho abazaabiica baziibwira ko mu gukora ibyo bazaaba bakorera Imaana. <verse eid="JHN 16:2" /><verse number="3" style="v" sid="JHN 16:3" />Ibyo bazaabikora babiteewe n'uko bataamenye Daata, nanje ntibaamenye. <verse eid="JHN 16:3" /><verse number="4" style="v" sid="JHN 16:4" />Ibyo mbibabwiriye kugira ngo igihe ca byo nikigera, muziibuke ko nabibabwiye.</para>
  <para style="s1" vid="JHN 16:4">Umurimo w'Umwuka Weera</para>
  <para style="p" vid="JHN 16:4">Ibyo sinabibabwiye mbere na mbere, kuko nari kumwe namwe. <verse eid="JHN 16:4" /><verse number="5" style="v" sid="JHN 16:5" />Ubu nenda gusanga uwantumye, ariko mbabajwe n'uko ntaanumwe muri mwe umbaza ati, ‘ugiiye he?’ <verse eid="JHN 16:5" /><verse number="6" style="v" sid="JHN 16:6" />Ariko kuko mbabwiye ibyo, imitima yaanyu yuuzuye agahinda. <verse eid="JHN 16:6" /><verse number="7" style="v" sid="JHN 16:7" />Ariko ndababwira ukuri yuuko icaabagirira akamaro ari uko naagenda, kuko ntagiiye, Umufasha ntaabwo azaaza muri mwe, ariko ningenda nzamubooherereza. <verse eid="JHN 16:7" /><verse number="8" style="v" sid="JHN 16:8" />Kandi naamara kuuza, azeereka ab'isi ico icaaha kimenyeesha, ico gukiraanuka bimenyeesha n'ibyo guciirwa urubanza. <verse eid="JHN 16:8" /><verse number="9" style="v" sid="JHN 16:9" />Azaababwira ibyerekeye icaaha caabo, kuko batanyemeye. <verse eid="JHN 16:9" /><verse number="10" style="v" sid="JHN 16:10" />Azaababwira ibyerekeye gukiraanuka, kuko ngiye kwa Daata, kandi mukaba mutakimboonye. <verse eid="JHN 16:10" /><verse number="11" style="v" sid="JHN 16:11" />Azaababwira ibyerekeye urubanza, kuko umutware w'iyi si yaciiriwe urubanza.<verse eid="JHN 16:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 16:12" />Ndacaafite ibyo kubabwira byinshi, ariko ubu ntimwashobora kubyihangaanira. <verse eid="JHN 16:12" /><verse number="13" style="v" sid="JHN 16:13" />Ubwo Umwuka w'ukuri azaaza, azaabayobora mu kuri koose, kuko atazaavuga ku bwe, ahuubwo azaavuga ibyo yumviise byose, kandi akabamenyeesha ibigiiye kubaho. <verse eid="JHN 16:13" /><verse number="14" style="v" sid="JHN 16:14" />Azampeesha ikuzo, kuko azaahaabwa ku byanje maze akabibamenyeesha. <verse eid="JHN 16:14" /><verse number="15" style="v" sid="JHN 16:15" />Ibyo Daata afite byose ni ibyanje, ni co gitumye mvuga ko azaafata ku byanje maze akabibamenyeesha.<verse eid="JHN 16:15" /></para>
  <para style="s1">Umubabaro Uzaahinduka Umuneezeero</para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 16:16" />Hasigaye akaanya gato, ntimwongere kumbona, maze akandi kaanya gato, mukambona.”<verse eid="JHN 16:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="JHN 16:17" />Bamwe mu biigiishwa be batangira kubazanya bati, “Ubwo aramenyeesha iki kutubwira ati, ‘Hasigaye akaanya gato ntimwongere kumbona, maze akandi kaanya gato, mukambona.’ Kandi ngo ‘Kuko ngiiye kwa Daata’?” <verse eid="JHN 16:17" /><verse number="18" style="v" sid="JHN 16:18" />Nuuko barabaza bati, “Iby'aka kaanya gato biramenyeesha iki? Ntaabwo tuuzi ico ashaaka kuvuga.”<verse eid="JHN 16:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="JHN 16:19" />Yesu amenya ko bashaaka kumubaza, arababwira ati, “Mbese murabazanya ico namenyeeshaga ubwo navugaga nti, ‘Mukanya gato ntimuzambona, kandi akandi kaanya gato, muzambona.’? <verse eid="JHN 16:19" /><verse number="20" style="v" sid="JHN 16:20" />Ndababwira ukuri yuuko mwebwe muzaarira kandi mukaganya, ariko ko ab'isi bazaaneezeerwa, mwe muzaagira umubabaro, ariko umubabaro waanyu uzaahinduka umuneezeero. <verse eid="JHN 16:20" /><verse number="21" style="v" sid="JHN 16:21" />Iyo umugore agiiye kubyara, arababara kuko igihe ce kiba kigeze, ariko iyo umwana amaze kuvuuka, ntaabwo aba aciibuka ububabare, kuko aba aneejeejwe nuuko haba havuutse umuntu ku isi. <verse eid="JHN 16:21" /><verse number="22" style="v" sid="JHN 16:22" />Namwe ubu mufite umubabaro, ariko nzongera kubabona, maze imitima yaanyu ineezeerwe, kandi ntaamuntu uzaabaaka umuneezeero waanyu.<verse eid="JHN 16:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="JHN 16:23" />Uwo munsi ntaaco muzambaza. Ndababwira ukuri yuuko, nimugira ico musaba Daata mu izina ryanje, azaakibaha. <verse eid="JHN 16:23" /><verse number="24" style="v" sid="JHN 16:24" />Kugeza ubu ntaaco mwari mwasaba mu izina ryanje. Musabe muzaahaabwa, kugira ngo umuneezeero waanyu useesekare.<verse eid="JHN 16:24" /></para>
  <para style="s1">Yesu Yatsinze Isi</para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 16:25" />Ibyo mbibabwiye mu marenga. Igihe kirageze ubwo ntazongera kubabwirira mu marenga, ahuubwo nkababwira neeruye ibyerekeye Daata. <verse eid="JHN 16:25" /><verse number="26" style="v" sid="JHN 16:26" />Uwo munsi muzaasaba mu izina ryanje. Simbabwira ngo nzaabasabira kuri Daata, <verse eid="JHN 16:26" /><verse number="27" style="v" sid="JHN 16:27" />kuko Daata ubwe abakundira ko mwankunze, kandi mukeemera ko nkomooka ku Maana.<note caller="+" style="f"><char style="fr" closed="false">16:27 </char><char style="ft" closed="false">Mu bindi byanditswe bashiraho </char><char style="it">Daata</char> </note> <verse eid="JHN 16:27" /><verse number="28" style="v" sid="JHN 16:28" />Nakomootse kuri Daata maze nza mu isi, noone ngiiye kuva mu isi nsubire kuri Daata.”<verse eid="JHN 16:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="JHN 16:29" />Abiigiishwa be baravuga bati, “Nooneho uravuga weeruye, udakoreesheje amarenga. <verse eid="JHN 16:29" /><verse number="30" style="v" sid="JHN 16:30" />Ubu tumenye ko uzi byose, kandi ko bitari ngombwa kugira ico umuntu akubaza, ni co gituma twemera ko ukomooka ku Maana.”<verse eid="JHN 16:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="JHN 16:31" />Yesu arabasubiza ati, “Nooneho ubu mureemera? <verse eid="JHN 16:31" /><verse number="32" style="v" sid="JHN 16:32" />Dore ubu igihe kireegeereje, ndetse kirageze, maze mugataataana, umwe akaja ukwe n'undi ukwe, maze mukansiga njenyine. Ariko ntaabwo ndi njenyine kuko Daata ari kumwe nanje. <verse eid="JHN 16:32" /><verse number="33" style="v" sid="JHN 16:33" />Ibyo mbibabwiye kugira ngo mugire amahoro ku bwo kunyizeera. Mu isi muzaatootezwa, ariko nimukomere kuko naneesheje isi!”<verse eid="JHN 16:33" /></para>
  <chapter eid="JHN 16" />
  <chapter number="17" style="c" sid="JHN 17" />
  <para style="s1">Yesu Asengera Abiigiishwa be</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 17:1" />Yesu amaze kuvuga atyo, yubuura amaaso areeba heejuru maze aravuga ati, “Daata, igihe kirageze, heesha Umwana waawe icuubahiro, kugira ngo na we aguheeshe icuubahiro, <verse eid="JHN 17:1" /><verse number="2" style="v" sid="JHN 17:2" />kuko wamuhaaye ububaasha ku bantu boose, kugira ngo abo wamuhaaye boose, abahe ubugingo buhoraho. <verse eid="JHN 17:2" /><verse number="3" style="v" sid="JHN 17:3" />Kandi ubwo bugingo buhoraho ni ukukumenya, wowe Maana y'ukuri yoonyine, no kumenya uwo watumye ari we Yesu Kristo. <verse eid="JHN 17:3" /><verse number="4" style="v" sid="JHN 17:4" />Naguheesheje icuubahiro hano mu isi, ndangiza umurimo wampaaye gukora. <verse eid="JHN 17:4" /><verse number="5" style="v" sid="JHN 17:5" />Noone ubu, Daata, imbere yaawe umpeeshe icuubahiro nk'ico nahoranye imbere yaawe, isi itaraaremwa.<verse eid="JHN 17:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="JHN 17:6" />Naamamaje izina ryawe mu bantu wampaaye ubakuuye mu isi. Baari abaawe urabampa, noone buubaha ijambo ryawe. <verse eid="JHN 17:6" /><verse number="7" style="v" sid="JHN 17:7" />Noone ubu baazi yuuko ibyo wampaaye byose bikomooka kuri wowe, <verse eid="JHN 17:7" /><verse number="8" style="v" sid="JHN 17:8" />kuko nabahaaye amagambo wampaaye, maze barayaakiira kandi bamenya ukuri yuuko nkomooka kuri wowe, kandi bakeemera ko ari wowe wantumye.<verse eid="JHN 17:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="JHN 17:9" />Ubu ndabasabira. Ntaabwo nsabira ab'isi, ahuubwo ndasabira abo wampaaye, kuko ari abaawe. <verse eid="JHN 17:9" /><verse number="10" style="v" sid="JHN 17:10" />Abantu banje ni abaawe, kandi abaawe na bo ni abanje kandi naheerewe icuubahiro muri bo. <verse eid="JHN 17:10" /><verse number="11" style="v" sid="JHN 17:11" />Ntaabwo nkiri mu isi, ariko bo bari mu isi, kandi nje ngusanga. Daata weera, abo wampaaye barindishe izina ryawe wampaaye, kugira ngo babe umwe nk'uko naatwe turi umwe. <verse eid="JHN 17:11" /><verse number="12" style="v" sid="JHN 17:12" /><note caller="-" style="x"><char style="xo" closed="false">17:12 </char><char style="xt" closed="false"><ref loc="JHN 13:18">Yoh 13:18</ref>.</char></note>Igihe nari kumwe na bo, nabarindaga nkoreesheje imbaraga z'izina ryawe wampaaye. Narabarinze ntihaagira n'umwe muri bo utaakara, keretse uwari waragenewe kurimbuka kugira ngo Ibyanditswe byuzuzwe. <verse eid="JHN 17:12" /><verse number="13" style="v" sid="JHN 17:13" />Daata, ubu ndi haafi kugusanga, kandi ibyo mbivuze nkiri mu isi kugira ngo bagire umuneezeero wuuzuye muri bo. <verse eid="JHN 17:13" /><verse number="14" style="v" sid="JHN 17:14" />Nabahaaye ijambo ryawe, maze ab'isi barabanga kuko batari ab'isi, nk'uko nanje ntari uw'isi. <verse eid="JHN 17:14" /><verse number="15" style="v" sid="JHN 17:15" />Singusaba ko ubakuura ku isi, ahuubwo ndagusaba kubarinda Umubi. <verse eid="JHN 17:15" /><verse number="16" style="v" sid="JHN 17:16" />Ntaabwo ari ab'isi, nk'uko nanje ntari uw'isi. <verse eid="JHN 17:16" /><verse number="17" style="v" sid="JHN 17:17" />Beereze mu kuri, ijambo ryawe ni ukuri. <verse eid="JHN 17:17" /><verse number="18" style="v" sid="JHN 17:18" />Uko wantumye ku isi, nanje ni ko nabatumye ku isi. <verse eid="JHN 17:18" /><verse number="19" style="v" sid="JHN 17:19" />Kandi ku bw'abo narakwiyeguriye, kugira ngo na bo bakwiyegurire mu kuri.<verse eid="JHN 17:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="JHN 17:20" />Ntaabwo nsabira aba bonyine, ahuubwo ndasabira n'abazaanyemera babikeesha ijambo ryabo, <verse eid="JHN 17:20" /><verse number="21" style="v" sid="JHN 17:21" />kugira ngo boose babe umwe. Nk'uko wowe, Daata uba muri nje, nanje nkaba muri wowe, nasabaga ko na bo bunga ubumwe muri twe, kugira ngo isi yeemere ko ari wowe wantumye. <verse eid="JHN 17:21" /><verse number="22" style="v" sid="JHN 17:22" />Icuubahiro wampaaye nanje narakibahaaye, kugira ngo babe umwe nk'uko naatwe turi umwe. <verse eid="JHN 17:22" /><verse number="23" style="v" sid="JHN 17:23" />Nje mba muri bo, naawe uba muri nje, kugira ngo babe umwe burundu, maze isi imenye ko wantumye, kandi ko wabakunze nk'uko wankunze.<verse eid="JHN 17:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="JHN 17:24" />Daata, ndashaaka ko abo wampaaye na bo babaana nanje aho ndi, kugira ngo babone ikuzo ryanje, ryo wampaaye, kuko wankunze isi itaraaremwa. <verse eid="JHN 17:24" /><verse number="25" style="v" sid="JHN 17:25" />Daata utungaanye, isi ntaabwo ikuuzi, ariko nje ndakuuzi, kandi aba baazi ko wantumye. <verse eid="JHN 17:25" /><verse number="26" style="v" sid="JHN 17:26" />Nabamenyesheje izina ryawe, kandi nzaakomeza kuribamenyeesha, kugira ngo urukundo wankunze rubabemo, kandi nanje mbabemo.”<verse eid="JHN 17:26" /></para>
  <chapter eid="JHN 17" />
  <chapter number="18" style="c" sid="JHN 18" />
  <para style="s1">Yesu Afatwa</para>
  <para style="r">(<ref loc="MAT 26:47-56">Mat 26:47-56</ref>; <ref loc="MRK 14:43-50">Mar 14:43-50</ref>; <ref loc="LUK 22:47-53">Luk 22:47-53</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 18:1" />Yesu amaze kuvuga ayo magambo, asohoka n'abiigiishwa be, bambuka ikibaya ca Kidironi. Yesu n'abiigiishwa be binjira mu gashamba kaari muri uwo mwanya. <verse eid="JHN 18:1" /><verse number="2" style="v" sid="JHN 18:2" />Yuda wamugambaaniye na we yari azi uwo mwanya kuko Yesu yakundaga kuhaja n'abiigiishwa be. <verse eid="JHN 18:2" /><verse number="3" style="v" sid="JHN 18:3" />Nuuko Yuda azana abasirikare hamwe n'abapolisi yahaawe n'abatware b'abaheerezabitambo n'Abafarisaayo. Baaje biitwaje amataara, amatooki hamwe n'intwaro. <verse eid="JHN 18:3" /><verse number="4" style="v" sid="JHN 18:4" />Nuuko Yesu ubwo yari azi ibigiiye kubaho byose, arabasanga maze arababaza ati, “Murashaaka nde?”<verse eid="JHN 18:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="JHN 18:5" />Baramusubiza bati, “Yesu w'i Nazaareeti.”</para>
  <para style="p" vid="JHN 18:5">Yesu arababwira ati, “Ni njeewe.”</para>
  <para style="p" vid="JHN 18:5">Yuda, umugambanyi yari ahagararanye na bo.<verse eid="JHN 18:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="JHN 18:6" />Yesu amaze kubabwira ati, “Ni njeewe,” basubira inyuma, bagwa haasi. <verse eid="JHN 18:6" /><verse number="7" style="v" sid="JHN 18:7" />Arongera arababaza ati, “Murashaaka nde?”</para>
  <para style="p" vid="JHN 18:7">Baravuga bati, “Yesu w'i Nazaareeti,”<verse eid="JHN 18:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="JHN 18:8" />Yesu arabasubiza ati, “Nababwiye ko ari nje. Niiba ari nje mushaaka reero, nimureke aba bagende.” <verse eid="JHN 18:8" /><verse number="9" style="v" sid="JHN 18:9" />Yabivuze agira ngo ijambo yavuze risohore, ati, “Mu bo wampaaye ntaan'umwe muri bo nataakaje.”<verse eid="JHN 18:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="JHN 18:10" />Simooni Peetero yari afite inkoota nuuko ayikuurayo, ayikubita umugaragu w'Umuheerezabitambo mukuru, amuca ugutwi kw'iburyo. Uwo mugaragu yitwaga Malikosi. <verse eid="JHN 18:10" /><verse number="11" style="v" sid="JHN 18:11" /><note caller="-" style="x"><char style="xo" closed="false">18:11 </char><char style="xt" closed="false"><ref loc="MAT 26:39">Mat 26:39</ref>; <ref loc="MRK 14:36">Mar 14:36</ref>; <ref loc="LUK 22:42">Luk 22:42</ref>.</char></note>Yesu abwira Peetero ati, “Subiza inkoota yaawe mu rwubati. Mbese singomba kubabazwa nk'uko Daata yabinteguuriye?”<verse eid="JHN 18:11" /></para>
  <para style="s1">Yesu Ajanwa imbere y'Umuheerezabitambo Mukuru</para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 18:12" />Abasirikare, umutware waabo, hamwe n'abapolisi b'Abayuuda bafata Yesu, maze baramuboha. <verse eid="JHN 18:12" /><verse number="13" style="v" sid="JHN 18:13" />Babanza kumujaana kwa Anaasi wari seebukwe wa Kayafa, Umuheerezabitambo mukuru w'uwo mwaka. <verse eid="JHN 18:13" /><verse number="14" style="v" sid="JHN 18:14" /><note caller="-" style="x"><char style="xo" closed="false">18:14 </char><char style="xt" closed="false"><ref loc="JHN 11:49">Yoh 11:49</ref>,<ref loc="JHN 11:50">50</ref>.</char></note>Kayafa ni we wari waragiiriye inaama Abayuuda yuuko bikwiriye ko umuntu umwe yapfiira abantu benshi.<verse eid="JHN 18:14" /></para>
  <para style="s1">Peetero Yihakana Yesu</para>
  <para style="r">(<ref loc="MAT 26:69-70">Mat 26:69-70</ref>; <ref loc="MRK 14:66-68">Mar 14:66-68</ref>; <ref loc="LUK 22:55-57">Luk 22:55-57</ref>)</para>
  <para style="p">
    <verse number="15" style="v" sid="JHN 18:15" />Simooni Peetero n'undi mwigiishwa bakurikira Yesu. Kuko uwo mwigiishwa yari azwi n'Umuheerezabitambo mukuru, yinjirana na Yesu mu gikaari c'inzu y'uwo Muheerezabitambo mukuru. <verse eid="JHN 18:15" /><verse number="16" style="v" sid="JHN 18:16" />Peetero we asigara ahagaze hanze inyuma y'irembo. Wa mwigiishwa wari uziranye n'Umuheerezabitambo mukuru, arasohoka avugana n'umugore warindaga irembo, nuuko yinjiza Peetero. <verse eid="JHN 18:16" /><verse number="17" style="v" sid="JHN 18:17" />Wa mugore abaza Peetero ati, “Aho naawe ntiwaba uri umwe mu biigiishwa b'uriiya mugabo?”</para>
  <para style="p" vid="JHN 18:17">Peetero aramusubiza ati, “Oya, ntaabwo ndi we.”<verse eid="JHN 18:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="JHN 18:18" />Abagaragu n'abapolisi baari bacanye umuriro w'amakara boota, kuko haari imbeho. Peetero na we yari kumwe na bo ahagaze yoota.<verse eid="JHN 18:18" /></para>
  <para style="s1">Abakuru b'Abaheerezabitambo Babaza Yesu</para>
  <para style="r">(<ref loc="MAT 26:59-66">Mat 26:59-66</ref>; <ref loc="MRK 14:55-64">Mar 14:55-64</ref>; <ref loc="LUK 22:66-71">Luk 22:66-71</ref>)</para>
  <para style="p">
    <verse number="19" style="v" sid="JHN 18:19" />Nuuko Umukuru w'abaheerezabitambo abaza Yesu iby'abiigiishwa be n'inyigiisho ye. <verse eid="JHN 18:19" /><verse number="20" style="v" sid="JHN 18:20" />Yesu arasubiza ati, “Navugiraga ku kumugaragaro, mbwira isi yoose. Nigiishirizaga mu masinagoogi no mu Nzu y'Imaana aho Abayuuda boose bateeranira. Ntaaco navuze rwihishwa. <verse eid="JHN 18:20" /><verse number="21" style="v" sid="JHN 18:21" />Kuki umbaza? Baza abumviise ibyo nababwiraga, baazi ibyo navuze.”<verse eid="JHN 18:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 18:22" />Amaze kuvuga atyo, umupolisi umwe wari uhagaze aho akubita Yesu urushi mu maaso, avuga ati, “Uko ni ko ugomba gusubiza Umuheerezabitambo mukuru?”<verse eid="JHN 18:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="JHN 18:23" />Yesu arasubiza ati, “Niiba mvuze ikidashitse, garagaza ikibi mvuze, kandi niiba mvuze igikwiriye, unkubitiye iki?”<verse eid="JHN 18:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="JHN 18:24" />Maze Anaasi yoohereza Yesu aboshwe kwa Kayafa, Umuheerezabitambo mukuru.<verse eid="JHN 18:24" /></para>
  <para style="s1">Peetero Yongera Kwihakana Yesu</para>
  <para style="r">(<ref loc="MAT 26:71-75">Mat 26:71-75</ref>; <ref loc="MRK 14:69-72">Mar 14:69-72</ref>; <ref loc="LUK 22:58-62">Luk 22:58-62</ref>)</para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 18:25" />Simooni Peetero yari agihagaze aho kandi yota, maze baramubaza bati, “Mbese ntaabwo uri umwe mu biigiishwa be?”</para>
  <para style="p" vid="JHN 18:25">Arabiihakana avuga ati, “Ntaabwo ndi we.”<verse eid="JHN 18:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="JHN 18:26" />Umwe mu bagaragu w'Umuheerezabitambo mukuru, wari mwene waabo w'umugabo Peetero yaciiye ugutwi aramubaza ati, “Sinakuboonye uri kumwe na bo muri ka gashamba?”<verse eid="JHN 18:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="JHN 18:27" />Peetero yongera guhakana, maze ako kaanya isaaki irabika.<verse eid="JHN 18:27" /></para>
  <para style="s1">Yesu Ajanwa Imbere ya Pilaato</para>
  <para style="r">(<ref loc="MAT 27:1-2">Mat 27:1-2</ref>,<ref loc="MAT 27:11-14">11-14</ref>; <ref loc="MRK 15:1-5">Mar 15:1-5</ref>; <ref loc="LUK 23:1-5">Luk 23:1-5</ref>)</para>
  <para style="p">
    <verse number="28" style="v" sid="JHN 18:28" />Mu gitondo kare kare, bavaana Yesu kwa Kayafa bamujaana mu rugo rwa Pilaato, wari umutware w'i Rooma. Bo ntaabwo binjiye mu rugo rw'umutware kugira ngo batiihumaanya, bakabura uko barya ifunguro ryo Kunyurwaho. <verse eid="JHN 18:28" /><verse number="29" style="v" sid="JHN 18:29" />Pilaato arasohoka abasanga hanze, maze arababaza ati, “Uyu mugabo muramurega iki?”<verse eid="JHN 18:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="JHN 18:30" />Baramusubiza bati, “Iyo uyu mugabo ataba ari umugiranaabi, ntituba tumukuuzaniye.”<verse eid="JHN 18:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="JHN 18:31" />Pilaato arababwira ati, “Nimumujaane mumuciire urubanza mukurikije amategeko yaanyu.”</para>
  <para style="p" vid="JHN 18:31">Abayuuda baramusubiza bati, “Ntaabwo twemerewe kugira uwo duciira urubanza rwo gupfa.” <verse eid="JHN 18:31" /><verse number="32" style="v" sid="JHN 18:32" /><note caller="-" style="x"><char style="xo" closed="false">18:32 </char><char style="xt" closed="false"><ref loc="JHN 3:14">Yoh 3:14</ref>; <ref loc="JHN 12:32">12:32</ref>.</char></note>(Ibyo byabaaye kugira ngo ijambo Yesu yavuze ryerekeye urupfu rwe ryuzurizwe.)<verse eid="JHN 18:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="JHN 18:33" />Pilaato yongera gusubira mu rugo rwe, ahamagaza Yesu, maze aramubaza ati, “Uri Umwami w'Abayuuda?”<verse eid="JHN 18:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="JHN 18:34" />Yesu aramusubiza ati, “Mbese ibyo ubibajije ku bwawe, cangwa ni abandi bakubwiye ibyanje?”<verse eid="JHN 18:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="JHN 18:35" />Pilaato aramusubiza ati, “Aho ntuugira ngo nanje ndi Umuyuuda? Beene waanyu hamwe n'abatware b'abaheerezabitambo ni bo bakunzaniye, wakoze iki?”<verse eid="JHN 18:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="JHN 18:36" />Yesu aramusubiza ati, “Ubwami bwanje ntaabwo ari ubwo kuri iyi si. Iyo Ubwami bwanje buba ari ubwo kuri iyi si, abiigiishwa banje baba bandwanyeho kugira ngo ntashikirizwa Abayuuda. Ariko uko bimeze, Ubwami bwanje ntaabwo ari ubwa hano.”<verse eid="JHN 18:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="JHN 18:37" />Pilaato aramubaza ati, “Noone se uri umwami?”</para>
  <para style="p" vid="JHN 18:37">Yesu aramusubiza ati, “Urabivuze ko ndi umwami. Iki ni co navuukiye kandi ni co canzanye mu isi, guhamya ukuri. Umuntu weese ufite ukuri muri we, yumva ijwi ryanje.”<verse eid="JHN 18:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="JHN 18:38" />Pilaato aramubaza ati, “Ukuri ni iki?”</para>
  <para style="s1" vid="JHN 18:38">Yesu Aciirwa urwo Gupfa</para>
  <para style="r" vid="JHN 18:38">(<ref loc="MAT 27:15-31">Mat 27:15-31</ref>; <ref loc="MRK 15:6-20">Mar 15:6-20</ref>; <ref loc="LUK 23:13-25">Luk 23:13-25</ref>)</para>
  <para style="p" vid="JHN 18:38">Yesu amaze kuvuga atyo, Pilaato yongera gusohoka, asanga Abayuuda maze arababwira ati, “Nta rubanza musanganye.<verse eid="JHN 18:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="JHN 18:39" />Ariko musanzwe mufite umugenzo ko mbarekurira imbohe imwe mwishaakiye, ku munsi wo Kunyurwaho, murashaaka ko mbarekurira Umwami w'Abayuuda?”<verse eid="JHN 18:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="JHN 18:40" />Bateera heejuru bavuga bati, “Si uwo mugabo dushaaka, ahuubwo duhe Baraba!” Uwo Baraba yari umwe mubaarwanyaga ubutegetsi bw'i Rooma.<verse eid="JHN 18:40" /></para>
  <chapter eid="JHN 18" />
  <chapter number="19" style="c" sid="JHN 19" />
  <para style="p">
    <verse number="1" style="v" sid="JHN 19:1" />Nuuko Pilaato ajaana Yesu maze ategeka ko bamukubita ibibooko. <verse eid="JHN 19:1" /><verse number="2" style="v" sid="JHN 19:2" />Abasirikare baboha ikamba ry'amahwa, barimwambika ku mutwe maze bamwambika igishuura gitukura. <verse eid="JHN 19:2" /><verse number="3" style="v" sid="JHN 19:3" />Bakaaza bamubwira bati, “Turakuramutsa, Mwami w'Abayuuda!” Nuuko bakamukubita inshi mu maaso.<verse eid="JHN 19:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="JHN 19:4" />Pilaato yongera gusohoka maze arababwira ati, “Dore ndamubaazanira kugira ngo mbamenyeeshe yuuko nta caaha na kimwe musanganye.” <verse eid="JHN 19:4" /><verse number="5" style="v" sid="JHN 19:5" />Nuuko Yesu asohoka yambaye ikamba ry'amahwa n'igishuura gitukura. Pilaato arababwira ati, “Dore nguyu wa muntu!”<verse eid="JHN 19:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="JHN 19:6" />Abatware b'abaheerezabitambo n'abapolisi bamukubise amaaso, bateera heejuru bati, “Ni abambwe! Ni abambwe!”</para>
  <para style="p" vid="JHN 19:6">Pilaato ni ko kubabwira ati, “Ngaho nimumujaane abe ari mwe mumwibambira. Nje ntaacaha kimuhama musanganye.”<verse eid="JHN 19:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="JHN 19:7" />Abayuuda barasubiza bati, “Dufite itegeko, kandi dukurikije iryo tegeko agomba gupfa, kuko yiigize Umwana w'Imaana.”<verse eid="JHN 19:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="JHN 19:8" />Pilaato yumviise ibyo, arushaho kugira ubwoba. <verse eid="JHN 19:8" /><verse number="9" style="v" sid="JHN 19:9" />Yongera kwinjira mu gikaari maze abaza Yesu ati, “Ukomooka he?”</para>
  <para style="p" vid="JHN 19:9">Ariko Yesu ntihaagira ico asubiza. <verse eid="JHN 19:9" /><verse number="10" style="v" sid="JHN 19:10" />Pilaato ni ko kumubwira ati, “Wanze kunsubiza? Ntaabwo uzi yuuko mfite ububaasha bwo kukurekura, kandi nkagira n'ububaasha bwo kukubamba?”<verse eid="JHN 19:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="JHN 19:11" />Yesu aramusubiza ati, “Ntabubaasha wagombaga kungiraho utabuhaawe n'Imaana. Ni co gituma uwakungabije afite icaaha kiruta icaawe.”<verse eid="JHN 19:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 19:12" />Pilaato abyumviise agerageza gushaaka uburyo bwo kurekura Yesu, ariko Abayuuda bateera heejuru bati, “Nuurekura uyu mugabo uraba utari inshuti ya Kayisaari, kuko uwiigira umwami weese aba arwanya Kayisaari.”<verse eid="JHN 19:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="JHN 19:13" />Pilaato ko yumviise ayo magambo, ajaana Yesu hanze maze yiicara ku ntebe y'ubucaamanza ahiitwa “Mabuye Ashashe”, mu Ruheburayo hakiitwa “Gabata”. <verse eid="JHN 19:13" /><verse number="14" style="v" sid="JHN 19:14" />Ubwo haari umunsi wo kwiteguura ibyo Kunyurwaho, kandi haari nk'isaaha itandatu z'amanywa. Abwira Abayuuda ati, “Nguyu umwami waanyu!”<verse eid="JHN 19:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="JHN 19:15" />Bateera heejuru bati, “Mwice! Mwice! Mubambe!”</para>
  <para style="p" vid="JHN 19:15">Pilaato arababaza ati, “Mbambe umwami waanyu?”</para>
  <para style="p" vid="JHN 19:15">Abaheerezabitambo bakuru barasubiza bati, “Nta mwami wundi dufite keretse Kayisaari.”<verse eid="JHN 19:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 19:16" />Nuuko Pilaato aramubaha ngo bamubambe.</para>
  <para style="s1" vid="JHN 19:16">Yesu Abambwa ku Musaraba</para>
  <para style="r" vid="JHN 19:16">(<ref loc="MAT 27:32-44">Mat 27:32-44</ref>; <ref loc="MRK 15:21-32">Mar 15:21-32</ref>; <ref loc="LUK 23:26-43">Luk 23:26-43</ref>)</para>
  <para style="p" vid="JHN 19:16">Nuuko bajaana Yesu.<verse eid="JHN 19:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="JHN 19:17" />Agenda yikoreye umusaraba, yeerekeza ahantu hiitwa “Ku Kibihanga,” mu Ruheburayo hakiitwa “Gologota.” <verse eid="JHN 19:17" /><verse number="18" style="v" sid="JHN 19:18" />Aho ni ho baamubambiye, kandi bamubamba n'abandi babiri, umwe iburyo undi ibumoso, Yesu ari hagati yaabo. <verse eid="JHN 19:18" /><verse number="19" style="v" sid="JHN 19:19" />Nuuko Pilaato yandika inyandiko ayishira ku musaraba. Yari yanditswe ngo, “Yesu w'i Nazaareeti, Umwami w'Abayuuda.” <verse eid="JHN 19:19" /><verse number="20" style="v" sid="JHN 19:20" />Abayuuda benshi baasomye iyo nyandiko kuko aho Yesu yabambwe haari haafi n'itawuni nkuru, kandi yari yanditswe mu Ruheburayo, mu Rulatini, hamwe no mu Rugiriki. <verse eid="JHN 19:20" /><verse number="21" style="v" sid="JHN 19:21" />Abatware b'abaheerezabitambo b'Abayuuda babwira Pilaato bati, “Reka kwandika ngo, ‘Umwami w'Abayuuda,’ ahuubwo andika ngo, ‘Uyu mugabo yavugaga ko ari Umwami w'Abayuuda.’ ”<verse eid="JHN 19:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 19:22" />Pilaato arabasubiza ati, “Ico nanditse, nacanditse.”<verse eid="JHN 19:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="JHN 19:23" />Abasirikare bamaze kubamba Yesu, bajaana imyambaro ye maze bayigabamo kane, buri musirikare ajaana umugabane we. Bajanye n'ikanzu ye ariko iyo kanzu ntaabwo yari ifite umubariiro, ahuubwo yari iboshwe kuva heejuru kugeza haasi. <verse eid="JHN 19:23" /><verse number="24" style="v" sid="JHN 19:24" />Abasirikare barabwirana bati, “Ntituyitandure, ahuubwo reka tuyikorereho ubufindo, maze tumenye uri buyijaane.” Bityo huuzuzwa ibyanditswe ngo,</para>
  <para style="q1" vid="JHN 19:24">“Bigabanyije imyambaro yanje,</para>
  <para style="q2" vid="JHN 19:24">maze ikanzu yanje bayikoreraho ubufindo.”</para>
  <para style="m" vid="JHN 19:24">Uko ni ko abasirikare baabigenjeje.<verse eid="JHN 19:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 19:25" />Iruhande rw'umusaraba wa Yesu haari hahagaze nyina, nyinawaabo, Mariya umugore wa Kilopasi, na Mariya Magadaleena. <verse eid="JHN 19:25" /><verse number="26" style="v" sid="JHN 19:26" />Yesu aboonye nyina na wa mwigiishwa yakundaga bahagararanye, abwira nyina ati, “Mugore, dore umwana waawe.”<verse eid="JHN 19:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="JHN 19:27" />Abwira wa mwigiishwa ati, “Nguyu nyoko.” Uheereye ubwo, uwo mwigiishwa amujaana iwe.<verse eid="JHN 19:27" /></para>
  <para style="s1">Urupfu rwa Yesu</para>
  <para style="r">(<ref loc="MAT 27:45-56">Mat 27:45-56</ref>; <ref loc="MRK 15:33-41">Mar 15:33-41</ref>; <ref loc="LUK 23:44-49">Luk 23:44-49</ref>)</para>
  <para style="p">
    <verse number="28" style="v" sid="JHN 19:28" />Haanyuma y'ibyo, Yesu amaze kumenya ko byose birangiye, (kandi kugira ngo ibyanditswe bisohore), aravuga ati, “Mfite imyota.”<verse eid="JHN 19:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="JHN 19:29" />Aho haari hateretse ikibindi cuuzuye divaayi ishaariira. Nuuko bahambira ku rubingo icangwe bagikoza muri ya divaayi ishaariira, maze bagishira ku munwa we. <verse eid="JHN 19:29" /><verse number="30" style="v" sid="JHN 19:30" />Yesu amaze kunywa kuri iyo divaayi, aravuga ati, “Birarangiye.”</para>
  <para style="p" vid="JHN 19:30">Nuuko yuunika umutwe maze umwuka urahera.<verse eid="JHN 19:30" /></para>
  <para style="s1">Yesu Bamuteera icumu mu Rubavu</para>
  <para style="p">
    <verse number="31" style="v" sid="JHN 19:31" />Kuko wari umunsi wo kwiteguurira umunsi mukuru wo Kunyurwaho, Abayuuda ntibaashaakaga ko imirambo iguma ku musaraba ku Saabato, kandi iyo Saabato yari umunsi mukuru. Maze basaba Pilaato ngo bavune amaguru yaabo, maze imirambo bayimanure. <verse eid="JHN 19:31" /><verse number="32" style="v" sid="JHN 19:32" />Abasirikare baraaza bavuna amaguru y'uwambere n'ay'undi wari ubambanywe na Yesu. <verse eid="JHN 19:32" /><verse number="33" style="v" sid="JHN 19:33" />Ariko baageze kuri Yesu basanga yapfuuye, ntibiirirwa bamuvuna amaguru, <verse eid="JHN 19:33" /><verse number="34" style="v" sid="JHN 19:34" />ahuubwo umwe mu basirikare amutikura icumu mu rubavu, ako kaanya havamo amaraso n'amaazi. <verse eid="JHN 19:34" /><verse number="35" style="v" sid="JHN 19:35" />(Uwabiboonye ni we ubihamije kugira ngo naawe weemere. Ubuhamya bwe ni ubw'ukuri kandi azi ko avuga ukuri.) <verse eid="JHN 19:35" /><verse number="36" style="v" sid="JHN 19:36" />Ibyo byabaaye kugira ngo ibyanditswe bisohore ngo, “Nta gufa rye rizaavunwa.” <verse eid="JHN 19:36" /><verse number="37" style="v" sid="JHN 19:37" /><note caller="-" style="x"><char style="xo" closed="false">19:37 </char><char style="xt" closed="false"><ref loc="REV 1:7">Ibya 1:7</ref>.</char></note>Kandi ibindi byanditswe biravuga ngo, “Bazaarangamira uwo baateeye icumu.”<verse eid="JHN 19:37" /></para>
  <para style="s1">Guhambwa kwa Yesu</para>
  <para style="r">(<ref loc="MAT 27:57-61">Mat 27:57-61</ref>; <ref loc="MRK 15:42-47">Mar 15:42-47</ref>; <ref loc="LUK 23:50-56">Luk 23:50-56</ref>)</para>
  <para style="p">
    <verse number="38" style="v" sid="JHN 19:38" />Nyuma y'ibyo, Yozefu wa Arimatiya, wari umuyoboke wa Yesu rwihishwa kuko yatiinyaga Abayuuda, asaba Pilaato gukuraho umurambo wa Yesu. Pilaato arabimwemerera, nuuko araaza arawujaana. <verse eid="JHN 19:38" /><verse number="39" style="v" sid="JHN 19:39" /><note caller="-" style="x"><char style="xo" closed="false">19:39 </char><char style="xt" closed="false"><ref loc="JHN 3:1">Yoh 3:1</ref>,<ref loc="JHN 3:2">2</ref>.</char></note>Nikodemu, wa wundi wigeze gusanga Yesu n'ijoro, na we araaza azanye ikivange c'imibavu yari ifite uburemeezi bungana nk'ibiro mirongo itatu. <verse eid="JHN 19:39" /><verse number="40" style="v" sid="JHN 19:40" />Bajaana umurambo wa Yesu maze bawuzinga mu mwenda n'imibavu, bakurikije umugenzo wo guhamba w'Abayuuda. <verse eid="JHN 19:40" /><verse number="41" style="v" sid="JHN 19:41" />Aho yabambwe haari umurima, kandi muri uwo murima haarimo imva nsha itaraahambwamo umuntu weese. <verse eid="JHN 19:41" /><verse number="42" style="v" sid="JHN 19:42" />Kubeera ko wari umunsi ubanziriza i Saabato, kandi ko iyo mva yari haafi, aba ariho bahamba Yesu.<verse eid="JHN 19:42" /></para>
  <chapter eid="JHN 19" />
  <chapter number="20" style="c" sid="JHN 20" />
  <para style="s">Kuzuuka kwa Yesu</para>
  <para style="r">(<ref loc="MAT 28:1-8">Mat 28:1-8</ref>; <ref loc="MRK 16:1-8">Mar 16:1-8</ref>; <ref loc="LUK 24:1-12">Luk 24:1-12</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 20:1" />Mu gitondo co ku c'umweru, Mariya Magadaleena azindukira ku mva butaraatandukana, maze asanga rya buye ryavanywe ku mva. <verse eid="JHN 20:1" /><verse number="2" style="v" sid="JHN 20:2" />Agenda yirukanka asanga Simooni Peetero na wa mwigiishwa Yesu yakundaga, maze arababwira ati, “Nyagasani baamukuuye mu mva, noone ntituuzi iyo baamushize.”<verse eid="JHN 20:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="JHN 20:3" />Peetero na wa mwigiishwa barasohoka baja ku mva. <verse eid="JHN 20:3" /><verse number="4" style="v" sid="JHN 20:4" />Bombi bariiruka, ariko wa mwigiishwa asiga Peetero, amutanga kugera ku mva. <verse eid="JHN 20:4" /><verse number="5" style="v" sid="JHN 20:5" />Aruunama arungurukamo, maze abona imyenda irambitse haasi, ariko ntiyinjira mu mva. <verse eid="JHN 20:5" /><verse number="6" style="v" sid="JHN 20:6" />Simooni Peetero wari umukurikiye abe arahageze, arinjira. Abona imyenda irambitswe haasi, <verse eid="JHN 20:6" /><verse number="7" style="v" sid="JHN 20:7" />kandi igitambaaro caari ku mutwe wa Yesu, kitarambitswe hamwe na ya myenda, ahuubwo co kizinze kiri hiirya coonyine. <verse eid="JHN 20:7" /><verse number="8" style="v" sid="JHN 20:8" />Wa mwigiishwa wari wageze ku mva mbere, na we arinjira, maze areemera. <verse eid="JHN 20:8" /><verse number="9" style="v" sid="JHN 20:9" />Kugeza ubwo baari bataraamenya ibyanditswe ko agomba kuzuuka mu baapfuuye. <verse eid="JHN 20:9" /><verse number="10" style="v" sid="JHN 20:10" />Maze abiigiishwa basubira mu mago yaabo.<verse eid="JHN 20:10" /></para>
  <para style="s1">Yesu Abonekera Mariya Magadaleena</para>
  <para style="r">(<ref loc="MAT 28:9-10">Mat 28:9-10</ref>; <ref loc="MRK 16:9-11">Mar 16:9-11</ref>)</para>
  <para style="p">
    <verse number="11" style="v" sid="JHN 20:11" />Mariya yari ahagaze ku mva arira. Akirira, aruunama arunguruka<note caller="+" style="f"><char style="fr" closed="false">20:11 </char><char style="ft" closed="false">Mu Rugiriki, ijambo</char><char style="it">Kurunguruka</char> ntaabwo irishirwaho</note> mu mva, <verse eid="JHN 20:11" /><verse number="12" style="v" sid="JHN 20:12" />maze abona abaamalayika babiri bambaye imyenda yeererana, biicaye aho umurambo wa Yesu wari urambitswe, umwe ahagana ku mutwe, undi ahagana ku birenge. <verse eid="JHN 20:12" /><verse number="13" style="v" sid="JHN 20:13" />Baramubwira bati, “Mugore, kuki uri kurira?”</para>
  <para style="p" vid="JHN 20:13">Arabasubiza ati, “Umwami wanje baamujaanye, noone nayobewe iyo baamushize.”<verse eid="JHN 20:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="JHN 20:14" />Amaze kuvuga atyo, arahinduka areeba inyuma maze abona Yesu ahahagaze, ariko ntiyamenya ko ari we. <verse eid="JHN 20:14" /><verse number="15" style="v" sid="JHN 20:15" />Yesu aramubaza ati, “Mugore, urarizwa n'iki? Urashaaka nde?”</para>
  <para style="p" vid="JHN 20:15">Yiibwira ko ari umukozi wo mu murima, aramusubiza ati, “Mutware, niiba ari wowe wamujaanye ahandi, mbwira aho wamushize, maze mukuureyo, mujaane.”<verse eid="JHN 20:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 20:16" />Yesu aramuhamagara ati, “Mariya!”</para>
  <para style="p" vid="JHN 20:16">Arahinduka maze avuga mu ruheburaayo<note caller="+" style="f"><char style="fr" closed="false">20:16 </char><char style="ft" closed="false">Mu Arameyiki</char></note> ati, “Rabuni!” (Kimenyeesha Mwigiisha).<verse eid="JHN 20:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="JHN 20:17" />Yesu aramubwira ati, “Utankoraho kuko ntaabwo nari naazaamuuka ngo nje kwa Daata, ahuubwo genda usange beene Daata maze ubabwiire uti, ‘Nzaamuutse nja kwa Daata ari we So, ku Maana yanje ari yo Maana yaanyu.’ ”<verse eid="JHN 20:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="JHN 20:18" />Nuuko Mariya Magadaleena aragenda abwira abiigiishwa ati, “Naboonye Nyagasani.” Maze abateekerereza ibyo yamubwiye.<verse eid="JHN 20:18" /></para>
  <para style="s1">Yesu Abonekera Abiigiishwa be</para>
  <para style="r">(<ref loc="MAT 28:16-20">Mat 28:16-20</ref>; <ref loc="MRK 16:14-18">Mar 16:14-18</ref>; <ref loc="LUK 24:36-49">Luk 24:36-49</ref>)</para>
  <para style="p">
    <verse number="19" style="v" sid="JHN 20:19" />Kuri uwo munsi nimugorooba, ari wo munsi ubanziriza icumweru, abiigiishwa baari bateeranye. Baari bikingiranyije mu nzu ku bwo gutiinya Abayuuda. Yesu araaza abahagarara hagati arababwira ati, “Nimugire amahoro” <verse eid="JHN 20:19" /><verse number="20" style="v" sid="JHN 20:20" />Amaze kuvuga atyo, abeereka ibiganza bye n'urubavu rwe. Nuuko abiigiishwa baboonye Nyagasani baraneezeerwa. <verse eid="JHN 20:20" /><verse number="21" style="v" sid="JHN 20:21" />Yesu yongera kubabwira ati, “Nimugire amahoro. Uko Daata yantumye, nanje ndabatumye.” <verse eid="JHN 20:21" /><verse number="22" style="v" sid="JHN 20:22" />Amaze kuvuga atyo, abahumeekeraho maze arababwira ati, “Ni mwakiire Umwuka Weera. <verse eid="JHN 20:22" /><verse number="23" style="v" sid="JHN 20:23" /><note caller="-" style="x"><char style="xo" closed="false">20:23 </char><char style="xt" closed="false"><ref loc="MAT 16:19">Mat 16:19</ref>; <ref loc="MAT 18:18">18:18</ref>.</char></note>Abo muzaababarira ibyaha boose, bazaaba babibabariwe, abo mutazaabibabarira boose, bazaaba batabibabariwe.”<verse eid="JHN 20:23" /></para>
  <para style="s1">Yesu na Tomasi</para>
  <para style="p">
    <verse number="24" style="v" sid="JHN 20:24" />Ariko Tomasi umwe muri ba cumi na babiri witwaga Mahasa<note caller="+" style="f"><char style="fr" closed="false">20:24 </char><char style="ft" closed="false">Didimasi</char></note>, ntiyari kumwe na bo ubwo Yesu yaaje. <verse eid="JHN 20:24" /><verse number="25" style="v" sid="JHN 20:25" />Abandi biigiishwa baramubwira bati, “Twaboonye Nyagasani.”</para>
  <para style="p" vid="JHN 20:25">Ariko we arabasubiza ati, “Nintabona umwenge w'imisumaari mu biganza bye, kandi sinshiremo urutoki rwanje, ngo nshire n'ikiganza canje mu rubavu rwe, sinzeemera.”<verse eid="JHN 20:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="JHN 20:26" />Hashize iminsi munaane, abiigiishwa na bwo baari bateeraniye mu nzu, nooneho Tomasi yari kumwe na bo. Nuubwo inzuugi zaari zikinze, Yesu araaza ahagarara hagati yaabo arababwira ati, “Nimugire amahoro.” <verse eid="JHN 20:26" /><verse number="27" style="v" sid="JHN 20:27" />Haanyuma abwira Tomasi ati, “Shira urutoki rwawe hano maze ureebe ibiganza byanje. Zana ikiganza caawe maze ugishire mu rubavu rwanje. Reka gushidiikanya ahuubwo emera.”<verse eid="JHN 20:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="JHN 20:28" />Tomasi aramusubiza ati, “Nyagasani kandi Maana yanje!”<verse eid="JHN 20:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="JHN 20:29" />Yesu aramubwira ati, “Wemejwe n'uko umboonye? Hahiirwa abiizeera bataboonye.”<verse eid="JHN 20:29" /></para>
  <para style="s1">Ikigendererwa c'iki Gitabo</para>
  <para style="p">
    <verse number="30" style="v" sid="JHN 20:30" />Yesu yakoreye imbere y'abiigiishwa be ibindi bitangaaza byinshi, bitanditswe muri iki gitabo. <verse eid="JHN 20:30" /><verse number="31" style="v" sid="JHN 20:31" />Ariko ibi byanditswe kugira ngo mwemere<note caller="+" style="f"><char style="fr" closed="false">20:31 </char><char style="ft" closed="false">Mukomeze kwemera </char></note> ko Yesu ari Kristo, Umwana w'Imaana, kandi ngo nimumwemera mugire ubugingo buhoraho.<verse eid="JHN 20:31" /></para>
  <chapter eid="JHN 20" />
  <chapter number="21" style="c" sid="JHN 21" />
  <para style="s1">Yesu Abonekera Abiigiishwa Barindwi</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 21:1" />Nyuma y'ibyo, Yesu yongera kubonekera abiigiishwa be ku nyanja ya Tibeeriya, maze ababonekera atya. <verse eid="JHN 21:1" /><verse number="2" style="v" sid="JHN 21:2" />Simooni Peetero, na Tomasi witwaga Mahasa, na Natanayeli w'i Kaana y'i Galileeya, beene Zebedaayo, n'abandi biigiishwa babiri baari bari kumwe. <verse eid="JHN 21:2" /><verse number="3" style="v" sid="JHN 21:3" /><note caller="-" style="x"><char style="xo" closed="false">21:3 </char><char style="xt" closed="false"><ref loc="LUK 5:5">Luk 5:5</ref>.</char></note>Simooni Peetero arababwira ati, “Ngiiye kuroba.” Baramusubiza bati, “Turajaana.” Barasohoka maze baja mu bwato, ariko muri iryo joro ntihaagira ico bafata.<verse eid="JHN 21:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="JHN 21:4" />Bukimara guca, Yesu ahagarara ku nkengeero, ariko abiigiishwa ntibamenya ko ari we. <verse eid="JHN 21:4" /><verse number="5" style="v" sid="JHN 21:5" />Yesu arababaza ati, “Nshuti zanje, hari isamaaki mwafashe?”</para>
  <para style="p" vid="JHN 21:5">Baramusubiza bati, “Ntaazo.”<verse eid="JHN 21:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="JHN 21:6" />
    <note caller="-" style="x">
      <char style="xo" closed="false">21:6 </char>
      <char style="xt" closed="false">
        <ref loc="LUK 5:6">Luk 5:6</ref>.</char>
    </note>Arababwira ati, “Nimujugunye agatimba kanyu iburyo bw'ubwato, muragira ico mubona.” Nuuko barakajugunya, ariko bananirwa kugakururira mu bwato kuko isamaaki zaari nyinshi.<verse eid="JHN 21:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="JHN 21:7" />Wa mwigiishwa Yesu yakundaga abwira Peetero ati, “Ni Nyagasani.” Simooni Peetero yumviise ko ari Nyagasani, akenyera umwenda kuko yari yambaye ubusa, maze yiiroha mu nyanja. <verse eid="JHN 21:7" /><verse number="8" style="v" sid="JHN 21:8" />Abandi biigiishwa baaza ku nkengeero mu bwato, bakurura agatimba kuuzuye isamaaki. Ntaabwo baari kure y'inkengero, ahuubwo haari nka mita ijana. <verse eid="JHN 21:8" /><verse number="9" style="v" sid="JHN 21:9" />Bageze imusozi, babona umuriro w'amakara, uriho isamaaki, hamwe n'umugaati. <verse eid="JHN 21:9" /><verse number="10" style="v" sid="JHN 21:10" />Yesu arababwira ati, “Nimuuzane kuri izo samaaki mumaze gufata.”<verse eid="JHN 21:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="JHN 21:11" />Simooni Peetero yinjira mu bwato maze akururira agatimba kuuzuye isamaaki nini imusozi. Zoose zaari ijana na mirongo itaanu n'itatu kandi n'ubwo zaari nyinshi, agatimba ntaabwo kaaciitse. <verse eid="JHN 21:11" /><verse number="12" style="v" sid="JHN 21:12" />Yesu arababwira ati, “Nimuuze dufungure ibya mugitondo.” Ntihaagira n'umwe muri abo biigiishwa utiinyuka kumubaza ati, “Uri nde?” Kuko baari baamenye ko ari Nyagasani. <verse eid="JHN 21:12" /><verse number="13" style="v" sid="JHN 21:13" />Yesu yiigira imbere afata umugaati maze arawubaha, n'isamaaki azigenza atyo.<verse eid="JHN 21:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="JHN 21:14" />Ubwo bwari ubwa gatatu Yesu abonekera abiigiishwa be, amaze kuzuuka mu baapfuuye.<verse eid="JHN 21:14" /></para>
  <para style="s1">Yesu na Peetero</para>
  <para style="p">
    <verse number="15" style="v" sid="JHN 21:15" />Barangije kurya amafunguro ya mugitondo, Yesu abwira Simooni Peetero ati, “Simooni mwene Yohaana, urankunda kurusha aba ngaaba?”</para>
  <para style="p" vid="JHN 21:15">Aramusubiza ati, “Yeego Nyagasani, uzi ko ngukunda.”</para>
  <para style="p" vid="JHN 21:15">Yesu aramubwira ati, “Ragira abaana b'intaama zanje.” <verse eid="JHN 21:15" /><verse number="16" style="v" sid="JHN 21:16" />Yesu yongera kumubaza ubwa kabiri ati, “Simooni mwene Yohaana, urankunda?”</para>
  <para style="p" vid="JHN 21:16">Peetero aramusubiza ati, “Yeego Nyagasani, uzi ko ngukunda.”</para>
  <para style="p" vid="JHN 21:16">Yesu aramubwira ati, “Ragira intaama zanje.” <verse eid="JHN 21:16" /><verse number="17" style="v" sid="JHN 21:17" />Yongera kumubaza ubwa gatatu ati, “Simooni mwene Yohaana, urankunda?”</para>
  <para style="p" vid="JHN 21:17">Peetero ababazwa n'uko Yesu amubajije ubwa gatatu ati, “Urankunda?” Nuuko aramusubiza ati, “Nyagasani, umenya byose, uzi ko ngukunda.”</para>
  <para style="p" vid="JHN 21:17">Nuuko Yesu aramubwira ati, “Ragira intaama zanje. <verse eid="JHN 21:17" /><verse number="18" style="v" sid="JHN 21:18" />Ndakubwira ukuri yuuko, ubwo wari ukiri muto, wariikenyezaga kandi ukaja aho ushaaka. Ariko nuumara gusaaza, uzaateega amaboko undi agukenyeze, kandi akujaane aho udashaaka.” <verse eid="JHN 21:18" /><verse number="19" style="v" sid="JHN 21:19" />(Yesu yavuze ibyo, ashaaka kwerekana urupfu Peetero azaapfa, bikuubahiisha Imaana.) Amaze kuvuga atyo, aramubwira ati, “Nkurikira.”<verse eid="JHN 21:19" /></para>
  <para style="s1">Yesu na wa Mwigiishwa Yakundaga</para>
  <para style="p">
    <verse number="20" style="v" sid="JHN 21:20" />
    <note caller="-" style="x">
      <char style="xo" closed="false">21:20 </char>
      <char style="xt" closed="false">
        <ref loc="JHN 13:25">Yoh 13:25</ref>.</char>
    </note>Peetero areebye inyuma, abona wa mwigiishwa Yesu yakundaga abakurikiye, kandi ni wa wundi wegamiye Yesu bafungura akamubaza ati, “Nyagasani, ni nde ugiiye kukugambaanira?” <verse eid="JHN 21:20" /><verse number="21" style="v" sid="JHN 21:21" />Peetero amaze kumubona, abaza Yesu ati, “Nyagasani, uyu we kandi ibye bigende bite?”<verse eid="JHN 21:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 21:22" />Yesu aramusubiza ati, “Niiba ari ubushaake bwanje ngo akomeze kubaho kugeza igihe nzaagarukira, bigutwaye iki? Wowe nkurikira!”<verse eid="JHN 21:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="JHN 21:23" />Kuva ubwo inkuru yaamamara mu muryango w'abeemera<note caller="+" style="f"><char style="fr" closed="false">21:23 </char><char style="ft" closed="false">Mu bavandimwe </char></note> ko uwo mwigiishwa atazaapfa. Nyamara Yesu ntaabwo yabwiye Peetero yuuko uwo mwigiishwa atazaapfa, ahuubwo yaramubwiye ati, “Niiba ari ubushaake bwanje ko agumaho kugeza aho nzaazira, bigutwaye iki?”<note caller="+" style="f"><char style="fr" closed="false">21:23 </char><char style="ft" closed="false">Mu bindi byanditswe, ntihongerwaho </char><char style="it">Bigutwaye iki</char></note><verse eid="JHN 21:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="JHN 21:24" />Uyu ni we wa mwigiishwa wemeza ibyo byose kandi ni we wabyanditse, kandi tuuzi yuuko ubuhamya bwe ari ukuri.<verse eid="JHN 21:24" /></para>
  <para style="s1">Umusoozo</para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 21:25" />Hari n'ibindi byinshi Yesu yakoze, nyamara byose byanditswe, ngira ngo ibitabo byakwandikwamo ntibyakwirwa mu isi.<verse eid="JHN 21:25" /></para>
  <chapter eid="JHN 21" />
</usx>