<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="1CO" style="id">- Rufumbira New Testament</book>
  <para style="h">1ABAKORINTO</para>
  <para style="toc3">1 Kor</para>
  <para style="toc2">1 ABAKORINTO</para>
  <para style="toc1">Urwandiko rwa mbere Intumwa Pawulo yandikiye ABAKORINTO</para>
  <para style="mt1">1 ABAKORINTO</para>
  <para style="imt">INYANZURO</para>
  <para style="im">
    <char style="bk">Urwandiko rwa mbere Intumwa Pawulo yandikiye Abakorinto</char> rwandikiwe kugira ngo rukemure ingoorane z'imibeereho ya gikristo no kwizeera kwari kwadutse mu itoorero ryo Pawulo yari yaratangiye i Korinto. Ico gihe Korinto yari itawuni nkuru y'icaamamare yo mu Bugiriki, akaba ari nayo tawuni nkuru y'igice ca Rooma ciitwa Akiya. Yari izwi caane ku bw'ubucuruuzi bwari buteeye imbere, umuco w'ubwibone, ibyaha by'ubusambanyi hamwe n'amadiini menshi.</para>
  <para style="ip">Impamvu nkuru zo Pawulo yari yibanzeho ni ibibazo byerekeye kwirema ibice, ubusambanyi mu itoorero, ibibazo bifashe ku guhuuza ibitsina no gushingiranwa, ibifashe ku mutimanaama, uko itoorero rikwiriye kugenza, impaano z'Umwuka Weera hamwe n'ibyerekeye izuuka. Yashizeho umwete wo kwerekana ico Ubutumwa Bwiza buvuga kuri ibi bibazo.</para>
  <para style="ip">Igice ca cumi na gatatu ari co ceerekana urukundo nk'impaano y'Imaana iha abantu baayo, ni co gice gishobora kuba kizwi caane muri iki gitabo.</para>
  <para style="iot">Ibirimo</para>
  <para style="io1">Inyanzuro<char style="ior"><ref loc="1CO 1:1-9">1:1-9</ref></char></para>
  <para style="io1">Amacaakubiri mu itoorero <char style="ior"><ref loc="1CO 1:10-4:21">1:10—4:21</ref> </char></para>
  <para style="io1">Ubusambanyi hamwe n'imibeereho yo mu mago<char style="ior"><ref loc="1CO 5:1-7:40">5:1—7:40</ref></char></para>
  <para style="io1">Abakristo hamwe n'abapagaani<char style="ior"><ref loc="1CO 8:1-11:1">8:1—11:1</ref></char></para>
  <para style="io1">Kubaho kw'Itoorero no kuramya <char style="ior"><ref loc="1CO 11:2-14:40">11:2—14:40</ref></char></para>
  <para style="io1">Izuuka rya Kristo hamwe n'abeemera<char style="ior"><ref loc="1CO 15:1-58">15:1-58</ref></char></para>
  <para style="io1">Amatuuro y'Abakristo muri Yudeeya <char style="ior"><ref loc="1CO 16:1-4">16:1-4</ref></char></para>
  <para style="io1">Ibifashe kuri Pawulo bwiite hamwe n'umusoozo<char style="ior"><ref loc="1CO 16:5-24">16:5-24</ref></char></para>
  <chapter number="1" style="c" sid="1CO 1" />
  <para style="s1">Indamutso</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 1:1" />Njeewe Pawulo wahamagariwe kuba intumwa ya Yesu Kristo uko Imaana yabishaatse hamwe n'umuvandimwe waacu Sositeni, <verse eid="1CO 1:1" /><verse number="2" style="v" sid="1CO 1:2" /><note caller="-" style="x"><char style="xo" closed="false">1:2 </char><char style="xt" closed="false"><ref loc="ACT 18:1">Iby 18:1</ref>.</char></note>ndabandikiye mwebwe ab'itoorero ry'Imaana riri i Korinto, no kuri abo baatooranyijwe na Yesu Kristo kuba abeera hamwe n'abandi boose bari mu yindi myanya bambaza izina rya Nyagasani Yesu Kristo, ari we Mwami waabo n'uwaacu.<verse eid="1CO 1:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="1CO 1:3" />Ubuntu n'amahoro biva ku Maana Daata n'Umwami waacu Yesu Kristo bibe muri mwe.<verse eid="1CO 1:3" /></para>
  <para style="s1">Imigisha yo muri Kristo</para>
  <para style="p">
    <verse number="4" style="v" sid="1CO 1:4" />Mpora nshiima Imaana ibihe byose ku bwanyu ku bw'ubuntu bw'Imaana mwahaawe binyuriye muri Yesu Kristo, <verse eid="1CO 1:4" /><verse number="5" style="v" sid="1CO 1:5" />kuko muri byose Imaana yabahaaye ibintu byiza byinshi, mu byo muvuga byose no mu bwenge bwose. <verse eid="1CO 1:5" /><verse number="6" style="v" sid="1CO 1:6" />Ubuhamya bufashe kuri Kristo bwashimangiwe muri mwe, <verse eid="1CO 1:6" /><verse number="7" style="v" sid="1CO 1:7" />bituma mutabura impaano y'Umwuka mu gihe mutegereza guhishuurwa kwa Yesu Kristo Umwami waacu. <verse eid="1CO 1:7" /><verse number="8" style="v" sid="1CO 1:8" />Ni we uzaabakomeza mu kwizeera kugeza ku mperuuka, kugira ngo muzaabe mudafite umugayo ku munsi wa Nyagasani Yesu Kristo. <verse eid="1CO 1:8" /><verse number="9" style="v" sid="1CO 1:9" />Imaana idahemuka, ni yo yabahamagariye kugira umubaano n'Umwana waayo Yesu Kristo Umwami waacu.<verse eid="1CO 1:9" /></para>
  <para style="s1">Amacaakubiri mu Itoorero</para>
  <para style="p">
    <verse number="10" style="v" sid="1CO 1:10" />Noone bavandimwe ndabinginga mu izina ry'Umwami waacu Yesu Kristo, kugira ngo mwese mu be bamwe kandi ntihagire amacaakubiri areebeka muri mwe, ahuubwo muhuuze imitima n'inaama. <verse eid="1CO 1:10" /><verse number="11" style="v" sid="1CO 1:11" />Kuko nabwiwe n'ab'umuryango wa Kiloowe, ko haagaragaye intonganya muri mwe abizeera. <verse eid="1CO 1:11" /><verse number="12" style="v" sid="1CO 1:12" /><note caller="-" style="x"><char style="xo" closed="false">1:12 </char><char style="xt" closed="false"><ref loc="ACT 18:24">Iby 18:24</ref>.</char></note>Ico menyeesha ni uko muvuga ibintu byinshi bitandukanye. Umwe aravuga ati, “Njeewe ndi uwa Pawulo,” cangwa ngo, “Njeewe ndi uwa Apolo,” undi na we ati, “Njeewe ndi uwa Peetero” undi na we ati, “Njeewe ndi uwa Kristo.” <verse eid="1CO 1:12" /><verse number="13" style="v" sid="1CO 1:13" />Mbese Kristo yagabanyijwemo ibice? Mbese ni Pawulo wababambiwe ku musaraba? Cangwa se mwabatijwe mu izina rya Pawulo?<verse eid="1CO 1:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="1CO 1:14" />
    <note caller="-" style="x">
      <char style="xo" closed="false">1:14 a </char>
      <char style="xt" closed="false">
        <ref loc="ACT 18:8">Iby 18:8</ref>; </char>
      <char style="xo" closed="false">b </char>
      <char style="xt" closed="false">
        <ref loc="ACT 19:29">Iby 19:29</ref>; <ref loc="ROM 16:23">Rom 16:23</ref>.</char>
    </note>Ndashiimira Imaana ko ari ntaan'umwe muri mwe nabatije keretse Kirisipo na Gaayo, <verse eid="1CO 1:14" /><verse number="15" style="v" sid="1CO 1:15" />kugira ngo hatagira umuntu uvuga ngo mwabatijwe mu izina ryanje. <verse eid="1CO 1:15" /><verse number="16" style="v" sid="1CO 1:16" /><note caller="-" style="x"><char style="xo" closed="false">1:16 </char><char style="xt" closed="false"><ref loc="1CO 16:15">1 Kor 16:15</ref>.</char></note>Icakora nabatije n'umuryango wa Sitefaano, kandi uretse abo, simpamya ko hari undi muntu nabatije. <verse eid="1CO 1:16" /><verse number="17" style="v" sid="1CO 1:17" />Kristo ntiyanyohereje kubatiza, ahuubwo yanyohereje kwamamaza Ubutumwa Bwiza, ntakoreesheje amagambo y'ubuhanga bw'abantu, kugira ngo urupfu rwa Yesu ku musaraba rudahinduka impfaabusa.<verse eid="1CO 1:17" /></para>
  <para style="s1">Kristo ni we Mbaraga n'Ubwenge bw'Imaana</para>
  <para style="p">
    <verse number="18" style="v" sid="1CO 1:18" />Ubutumwa bwerekeye umusaraba wa Kristo ni ubupfu kuri abo bari kurimbuka, ariko kuri twebwe abari gukizwa, ni imbaraga z'Imaana. <verse eid="1CO 1:18" /><verse number="19" style="v" sid="1CO 1:19" />Ibyanditswe biravuga biti,</para>
  <para style="q1" vid="1CO 1:19">“Nzaarimbura ubwenge bw'abanyabwenge,</para>
  <para style="q2" vid="1CO 1:19">kandi nzaarimbura n'ubuhanga bw'abahanga.”<verse eid="1CO 1:19" /></para>
  <para style="m">
    <verse number="20" style="v" sid="1CO 1:20" />Noone se, umunyabwenge ari he? Umuhanga se we ari he? Mbese umunyampaka w'iki gihe ari he? Mbese ubwenge bw'iyi si Imaana ntiyaba yarabuhinduye ubupfu?<verse eid="1CO 1:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="1CO 1:21" />Koko reero muri ubwo bwenge bwayo, Imaana ntiyakunze ko abantu bayimenya bakoreesheje ubwenge bwabo, ahuubwo yahisemo gukoreesha ubutumwa tuvuga bwo abantu biita ubupfu, kugira ngo ikize abeemera. <verse eid="1CO 1:21" /><verse number="22" style="v" sid="1CO 1:22" />Dore Abayuuda basaba ibimenyeetso byo kubeemeza, naho Abagiriki bo bagashaaka ubwenge. <verse eid="1CO 1:22" /><verse number="23" style="v" sid="1CO 1:23" />Naho twebwe, twamamaza Kristo wabambwe ku musaraba, bikaba igisiitaaza ku Bayuuda n'ubupfu ku banyamahanga, <verse eid="1CO 1:23" /><verse number="24" style="v" sid="1CO 1:24" />ariko ku baahamagawe, b'Abayuuda n'Abagiriki, ubu butumwa ni Kristo, ari we mbaraga z'Imaana n'ubwenge bwayo. <verse eid="1CO 1:24" /><verse number="25" style="v" sid="1CO 1:25" />Ikigaragara nk'ubupfu bw'Imaana, gitambuutse kure ubwenge bw'abantu, kandi ikigaragara nk'intege nke z'Imaana, gisumba imbaraga z'abantu.<verse eid="1CO 1:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="1CO 1:26" />Noone reero bavandimwe, nimuzirikane uko mwari mumeze igihe Imaana yabahamagaye. Ukurikije uko abantu babibona, benshi muri mwe ntimwari abanyabwenge cangwa ibihangaage cangwa mwaravuukiye mu mago akomeye. <verse eid="1CO 1:26" /><verse number="27" style="v" sid="1CO 1:27" />Ariko Imaana yatooranyije ibyo abantu biita ubupfu kugira ngo ikoze isoni abanyabwenge, Imaana yatooranyije ibinyantege nke kugira ngo ikoze isoni ibihangaage. <verse eid="1CO 1:27" /><verse number="28" style="v" sid="1CO 1:28" />Imaana yatooranyije ibyo abantu b'iyi si bahinyura bagasuuzugura no kubigira ubusa, kugira ngo ihindure ubusa ibyo ab'isi bateekereza ko ari bikuru. <verse eid="1CO 1:28" /><verse number="29" style="v" sid="1CO 1:29" />Imaana yabikoze kugira ngo hatagira umuntu n'umwe wiikuza imbere yaayo. <verse eid="1CO 1:29" /><verse number="30" style="v" sid="1CO 1:30" />Imaana ni yo sooko y'ubuzima bwanyu muri Yesu Kristo, kandi imugira ubwenge bukomooka ku Maana, n'ubutungaane, no kwezwa, no gucungurwa, <verse eid="1CO 1:30" /><verse number="31" style="v" sid="1CO 1:31" />kugira ngo bibe nk'uko byanditswe ngo, “Ushaaka kwiraata weese, niyiraatiishe ibyo Nyagasani yamukoreye.”<verse eid="1CO 1:31" /></para>
  <chapter eid="1CO 1" />
  <chapter number="2" style="c" sid="1CO 2" />
  <para style="s1">Pawulo Yiigiisha ibya Yesu Wabambwe ku Musaraba</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 2:1" />Bavandimwe, ubwo naaje iwaanyu kwamamaza amabanga y'Imaana, sinakoreesheje amagambo akomeye, cangwa ay'ubwenge buhanitse. <verse eid="1CO 2:1" /><verse number="2" style="v" sid="1CO 2:2" />Kuko nahisemo kutagira ikindi mbamenyeesha keretse Yesu Kristo wabambwe ku musaraba. <verse eid="1CO 2:2" /><verse number="3" style="v" sid="1CO 2:3" /><note caller="-" style="x"><char style="xo" closed="false">2:3 </char><char style="xt" closed="false"><ref loc="ACT 18:9">Iby 18:9</ref>.</char></note>Kandi igihe naazaga iwaanyu, nari mfite intege nke, ndetse ntinya kandi mpinda umushitsi. <verse eid="1CO 2:3" /><verse number="4" style="v" sid="1CO 2:4" />Kandi ntaabwo niigiishije no kwamamaza Inkuru Nziiza nkoreesheje amagambo yo kwemeza y'ubwenge bw'abantu, ahuubwo nabeemeje ku bw'ububaasha bw'Umwuka w'Imaana. <verse eid="1CO 2:4" /><verse number="5" style="v" sid="1CO 2:5" />Kwizeera kwanyu reero kukaba kudashingiye ku bwenge bw'abantu, ahuubwo kukaba gushingiye ku mbaraga z'Imaana.<verse eid="1CO 2:5" /></para>
  <para style="s1">Ubwenge bw'Imaana</para>
  <para style="p">
    <verse number="6" style="v" sid="1CO 2:6" />Icakora abamaze gukomera mu by'Umwuka, tubabwiriza ubutumwa bw'ubwenge, ariko ntaabwo ari ubwenge bw'iyi si cangwa ubwenge bw'abategeka iyi si bagiiye kurimbuka. <verse eid="1CO 2:6" /><verse number="7" style="v" sid="1CO 2:7" />Ahuubwo ubwenge bwo naamamaza ni ubwenge bw'Imaana bwahishwe abantu kuva keera koose, Imaana ikabugenera kuduheesha icuubahiro. <verse eid="1CO 2:7" /><verse number="8" style="v" sid="1CO 2:8" />Ntaan'umwe mu batware b'iyi si wiigeze kumenya ubu bwenge, kuko iyo baba baarabumenye, ntibaba baarabambye Umwami w'ikuzo ku musaraba. <verse eid="1CO 2:8" /><verse number="9" style="v" sid="1CO 2:9" />Ahuubwo nk'uko ibyanditswe bivuga ngo,</para>
  <para style="q1" vid="1CO 2:9">“Ico ijiisho ritaaboonye cangwa ngo ugutwi kumve,</para>
  <para style="q2" vid="1CO 2:9">ico umuntu atiigeze ateekereza ko caabaho,</para>
  <para style="q2" vid="1CO 2:9">ni co Imaana yateguuriye abayikunda.”<verse eid="1CO 2:9" /></para>
  <para style="m">
    <verse number="10" style="v" sid="1CO 2:10" />Ariko Imaana yakoreesheje Umwuka waayo kuduhishuurira amabanga yaayo, kandi Umwuka w'Imaana agenzuura byose ndetse n'amayobera y'Imaana. <verse eid="1CO 2:10" /><verse number="11" style="v" sid="1CO 2:11" />Mbese ni nde wamenya ikiri ku mutima w'umuntu keretse umwuka uri muri uwo muntu? Ni na ko ari ntaamuntu waamenya iby'Imaana, keretse Umwuka waayo. <verse eid="1CO 2:11" /><verse number="12" style="v" sid="1CO 2:12" />Noone reero ntaabwo ari umwuka w'iyi si twahaawe, ahuubwo twahaawe Umwuka uva ku Maana, kugira ngo tumenye impaano Imaana yaduteguuriye.<verse eid="1CO 2:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="1CO 2:13" />Ibi ntaabwo tubivuga mu magambo twiigiishijwe n'abantu, ahuubwo ni mu magambo twiigiishijwe n'Umwuka w'Imaana, uduha gusobaanura iby'Umwuka kuri abo basanzwe bamufite. <verse eid="1CO 2:13" /><verse number="14" style="v" sid="1CO 2:14" />Umuntu utagira Umwuka w'Imaana ntaabwo ashobora kwakiira iby'Umwuka w'Imaana, ndetse kuri we abyita ubupfu. Ntaabwo ashobora kubimenya kuko bigenzuurwa n'ufite Umwuka w'Imaana wenyine. <verse eid="1CO 2:14" /><verse number="15" style="v" sid="1CO 2:15" />Umuntu ufite Umwuka w'Imaana agenzuura byose, kandi we ntaawamugenzuura. <verse eid="1CO 2:15" /><verse number="16" style="v" sid="1CO 2:16" />Nk'uko ibyanditswe bivuga ngo,</para>
  <para style="q1" vid="1CO 2:16">“Ni nde wamenye ibiteekerezo by'Uhoraho</para>
  <para style="q2" vid="1CO 2:16">kugira ngo ashobore kumugiira inaama?”</para>
  <para style="m" vid="1CO 2:16">Nyamara twebwe dufite ibiteekerezo nk'ibya Kristo.<verse eid="1CO 2:16" /></para>
  <chapter eid="1CO 2" />
  <chapter number="3" style="c" sid="1CO 3" />
  <para style="s">Amacaakubiri mu Itoorero ry'Ikorinto</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 3:1" />Noone bavandimwe, sinashoboye kuvugana namwe nk'ubwira abafite Umwuka w'Imaana, ahuubwo nababwiye nk'ubwira abantu bakigengwa na kamere y'umubiri, bakiri bato mu bya Kristo. <verse eid="1CO 3:1" /><verse number="2" style="v" sid="1CO 3:2" /><note caller="-" style="x"><char style="xo" closed="false">3:2 </char><char style="xt" closed="false"><ref loc="HEB 5:12">Heb 5:12</ref>,<ref loc="HEB 5:13">13</ref>.</char></note>Nabagaburiye amata, sinabagaburira ibyokurya bikomeye kuko mutaari mwagashoboye kubirya. Ndetse n'ubu ntimuraabishobora, <verse eid="1CO 3:2" /><verse number="3" style="v" sid="1CO 3:3" />kuko muciifata nk'abantu bakigengwa na kamere y'umubiri. Noone se niiba mugifite ishari n'intonganya muri mwe, ntaabwo muri ab'isi, kandi ntimuciitwara nk'uko abantu basanzwe babigenza? <verse eid="1CO 3:3" /><verse number="4" style="v" sid="1CO 3:4" /><note caller="-" style="x"><char style="xo" closed="false">3:4 </char><char style="xt" closed="false"><ref loc="1CO 1:12">1 Kor 1:12</ref>.</char></note>Igihe umwe avuze ati, “Njeewe ndi uwa Pawulo,” undi na we ati, “Njeewe ndi uwa Apolo,” ntibiba bigaragara ko mutwaza nk'abantu basanzwe?<verse eid="1CO 3:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="1CO 3:5" />Mbese noone, Apolo ni iki? Kandi Pawulo ni iki? Turi abagaragu b'Imaana baatumye mwemera Kristo. Buri umwe weese muri twe akora umurimo wo Nyagasani yamuhaaye gukora. <verse eid="1CO 3:5" /><verse number="6" style="v" sid="1CO 3:6" /><note caller="-" style="x"><char style="xo" closed="false">3:6 a </char><char style="xt" closed="false"><ref loc="ACT 18:4-11">Iby 18:4-11</ref>; </char><char style="xo" closed="false">b </char><char style="xt" closed="false"><ref loc="ACT 18:24-28">Iby 18:24-28</ref>.</char></note>Njeewe nateeye imbuto, Apolo ayisukiira amaazi, ariko Imaana ni yo yayikujije. <verse eid="1CO 3:6" /><verse number="7" style="v" sid="1CO 3:7" />Noone reero, hari uteera imbuto cangwa uyisukiira amaazi ntaaco bari co. Imaana yo itanga gukura ni yo nkuru. <verse eid="1CO 3:7" /><verse number="8" style="v" sid="1CO 3:8" />Uteera imbuto n'uyisukiira amaazi ntaaho batandukaniye kuko bombi Imaana izaabahemba ikurikije ibihwanye n'umurimo baakoze. <verse eid="1CO 3:8" /><verse number="9" style="v" sid="1CO 3:9" />Twembi turi abagaragu bakorera Imaana, naho mwebwe mukaba umurima waayo.</para>
  <para style="p" vid="1CO 3:9">Ikindi kandi muri icuubakwa c'Imaana. <verse eid="1CO 3:9" /><verse number="10" style="v" sid="1CO 3:10" />Nakoreesheje impaano Imaana yampaaye, maze nkora umurimo w'umwubatsi w'umuhanga, nshiraho urufatiro, undi muntu arwubakiraho. Icakora buri muntu agomba kwitondera uburyo arwubakiraho. <verse eid="1CO 3:10" /><verse number="11" style="v" sid="1CO 3:11" />Kuko ntaamuntu waashiraho urundi rufatiro, rutari urwashizweho, kandi urwo rufatiro ni Yesu Kristo. <verse eid="1CO 3:11" /><verse number="12" style="v" sid="1CO 3:12" />Noone umuntu aramutse yuubakiishije izaahabu cangwa ifeeza, cangwa amabuye y'agaciiro, cangwa ibiti, cangwa ibyatsi, cangwa ibikenyeri kuri uru rufatiro, <verse eid="1CO 3:12" /><verse number="13" style="v" sid="1CO 3:13" />umurimo wa buri mwubatsi uzaagaragara ku munsi Yesu azaaza guca urubanza. Uwo munsi uzaarangwa n'umuriro, kandi uwo muriro ni wo uzaasuuzuma agaciiro ku murimo wakozwe na buri muntu. <verse eid="1CO 3:13" /><verse number="14" style="v" sid="1CO 3:14" />Ibyubatswe ku rufatiro biramutse birokotse uwo muriro, umwubatsi azaahaabwa uruhembo. <verse eid="1CO 3:14" /><verse number="15" style="v" sid="1CO 3:15" />Ariko umurimo uramutse wokejwe n'umuriro, umwubatsi azaahomba, ariko we ubwe azaarokoka nk'ukuuwe mu muriro.<verse eid="1CO 3:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="1CO 3:16" />
    <note caller="-" style="x">
      <char style="xo" closed="false">3:16 </char>
      <char style="xt" closed="false">
        <ref loc="1CO 6:19">1 Kor 6:19</ref>; <ref loc="2CO 6:16">2 Kor 6:16</ref>.</char>
    </note>Ntaabwo muuzi yuuko muri inzu y'Imaana, kandi ko Umwuka w'Imaana abatuuyemo? <verse eid="1CO 3:16" /><verse number="17" style="v" sid="1CO 3:17" />Noone reero umuntu weese usenya inzu y'Imaana, Imaana na yo izaamusenya kuko inzu y'Imaana ireera, kandi iyo nzu y'Imaana ni mwebwe.<verse eid="1CO 3:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="1CO 3:18" />Ntihakagire uwiibeesha. Nihagira umuntu muri mwe wiibwira ko ari umunyabwenge muri iki gihe, akwiriye guhinduka umupfaapfa kugira ngo abone kuba umunyabwenge nyakuri. <verse eid="1CO 3:18" /><verse number="19" style="v" sid="1CO 3:19" />Kuko ubwenge bw'iyi si ari ubupfaapfa imbere y'Imaana, nk'uko byanditswe ngo,</para>
  <para style="q1" vid="1CO 3:19">“Imaana itegera abanyabwenge mu buriganya bwabo!” <verse eid="1CO 3:19" /><verse number="20" style="v" sid="1CO 3:20" />Kandi ngo,</para>
  <para style="q1" vid="1CO 3:20">“Nyagasani azi ibyo abanyabwenge bateekereza,</para>
  <para style="q2" vid="1CO 3:20">ko bitagira akamaro.”<verse eid="1CO 3:20" /></para>
  <para style="m">
    <verse number="21" style="v" sid="1CO 3:21" />Noone reero ntihakagire uwiraatiisha ibyo abantu bakora, kuko byose ari ibyanyu. <verse eid="1CO 3:21" /><verse number="22" style="v" sid="1CO 3:22" />Yaaba Pawulo cangwa Apolo cangwa Peetero, yaaba isi cangwa ubugingo cangwa urupfu, byaba ibyo muri iki gihe cangwa ibyo mu gihe kizaaza, byose ni ibyanyu, <verse eid="1CO 3:22" /><verse number="23" style="v" sid="1CO 3:23" />kandi namwe muri aba Kristo, Kristo na we akaba uw'Imaana.<verse eid="1CO 3:23" /></para>
  <chapter eid="1CO 3" />
  <chapter number="4" style="c" sid="1CO 4" />
  <para style="s">Inshingano z'Intumwa za Kristo</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 4:1" />Nuuko reero muje mudufata nk'abagaragu ba Kristo bashinzwe kwamamaza amabanga y'Imaana. <verse eid="1CO 4:1" /><verse number="2" style="v" sid="1CO 4:2" />Kandi ico abashinzwe uwo murimo bashaakwaho ni ukuba abiiringirwa. <verse eid="1CO 4:2" /><verse number="3" style="v" sid="1CO 4:3" />Ariko njeewe, igikuru si uko mwanciira urubanza cangwa ngo nduciirwe n'urukiiko rw'abantu. Nanje ubwanje siniciira urubanza. <verse eid="1CO 4:3" /><verse number="4" style="v" sid="1CO 4:4" />Ntaaco umutima wanje unshinja, ariko ibyo ntibigaragaza ko ndi intungaane, ahuubwo Nyagasani wenyine ni we unciira urubanza. <verse eid="1CO 4:4" /><verse number="5" style="v" sid="1CO 4:5" />Ni co gituma mutagomba kugira uwo muciira urubanza igihe kitaraagera. Mutegereze igihe Nyagasani azaazira maze agashira ku mugaragaro ibyari bihishwe mu mwijima, kandi akagaragaza imigambi yo mu mitima y'abantu. Ubwo ni bwo Imaana izaaha umuntu weese ishimwe rimukwiriye.<verse eid="1CO 4:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="1CO 4:6" />Bavandimwe, ibyo navuze nabyigereranyijeho njeewe na Apolo kugira ngo bibabeere urugero rwo kwigiraho ibivugwa ngo, “Ntimukarenge ku byanditswe.” Kugira ngo hatagira ukuza umuntu umwe maze agahinyura undi. <verse eid="1CO 4:6" /><verse number="7" style="v" sid="1CO 4:7" />Mbese ni nde wakurutiishije abandi? Imaana si yo yaguhaaye ibyo utunze byose? Noone se niiba warabihaawe, ni iki gituma wiiraata nk'aho utaabihaawe nk'impaano?<verse eid="1CO 4:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1CO 4:8" />Mbese mumaze kubona ibyo mukeneye byose? Mumaze no kuba abakungu? Mbese mumaze kuba abaami nuubwo tutari bo? Icampa koko mukaba abaami kugira ngo naatwe dutegekane namwe! <verse eid="1CO 4:8" /><verse number="9" style="v" sid="1CO 4:9" />Niibwira yuuko twebwe intumwa za Kristo Imaana yadushize inyuma y'abandi, nk'abaaciiriwe urubanza rwo gupfa kuko twashizwe ku ka rubanda, maze dushungeerwa n'ab'isi, abaamalayika hamwe n'abantu. <verse eid="1CO 4:9" /><verse number="10" style="v" sid="1CO 4:10" />Twebwe turi abapfu kuko twemera Kristo, naho mwe muri abanyabwenge muri Kristo. Twebwe turi abanyantege nke, naho mwebwe muri abanyambaraga. Mwebwe muruubahwa naho twebwe turasuuzugurwa. <verse eid="1CO 4:10" /><verse number="11" style="v" sid="1CO 4:11" />Kugeza na n'ubu turasonza tukagira n'imyota, twambaye ubusa, turakubitwa, turi inzereezi, <verse eid="1CO 4:11" /><verse number="12" style="v" sid="1CO 4:12" /><note caller="-" style="x"><char style="xo" closed="false">4:12 </char><char style="xt" closed="false"><ref loc="ACT 18:3">Iby 18:3</ref>.</char></note>kandi tukaruha dukoreesha amaboko yaacu. Iyo badututse, tubasabira umugisha, iyo badutooteje, turiihangaana, <verse eid="1CO 4:12" /><verse number="13" style="v" sid="1CO 4:13" />iyo badusebya, tubavugiisha neeza. Na n'ubu abantu baatugize nk'umwanda w'iyi si, kandi baduhindura nk'ibishingwe boose bajugunya.<verse eid="1CO 4:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="1CO 4:14" />Ibi simbibandikira kugira ngo mbakoze isoni, ahuubwo ni ukugira ngo mbiigiishe musobaanukirwe nk'abaana banje nkunda. <verse eid="1CO 4:14" /><verse number="15" style="v" sid="1CO 4:15" />N'aho mwagira ibihumbi n'ibihumbagiza by'ababarera mu buzima bwanyu muri Kristo, mufite umubyeyi umwe. Ninje wababeereye umubyeyi nk'abakristo igihe mbaazanira Inkuru Nziiza. <verse eid="1CO 4:15" /><verse number="16" style="v" sid="1CO 4:16" /><note caller="-" style="x"><char style="xo" closed="false">4:16 </char><char style="xt" closed="false"><ref loc="1CO 11:1">1 Kor 11:1</ref>; <ref loc="PHP 3:17">Fil 3:17</ref>.</char></note>Noone reero ndabinginga ngo mukurikize urugero rwanje. <verse eid="1CO 4:16" /><verse number="17" style="v" sid="1CO 4:17" />Ni co gitumye mbooherereje Timoteeyo, umwana wanje nkunda kandi udahemuka kuri Nyagasani, kugira ngo abiibutse imitwarize yanje yo nkeesha Kristo, nk'uko niigiisha abeemera Kristo mu matoorero yoose.<verse eid="1CO 4:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="1CO 4:18" />Bamwe muri mwe mwateekereje ko ntazaagaruka kubasuura maze bibateera kwishira heejuru. <verse eid="1CO 4:18" /><verse number="19" style="v" sid="1CO 4:19" />Ariko Nyagasani naabishaaka, nzaaza iwaanyu vuba, maze nireebere ububaasha bwo abo biiraasi bafite, atari ukugendera ku magambo yaabo gusa. <verse eid="1CO 4:19" /><verse number="20" style="v" sid="1CO 4:20" />Kuko Ubwami bw'Imaana budashingiye ku magambo, ahuubwo bushingiye ku mbaraga. <verse eid="1CO 4:20" /><verse number="21" style="v" sid="1CO 4:21" />Mbese ico mwahitamo ni ikiihe? Nzaaze iwaanyu niitwaje inkoni yo kubahana, cangwa nzaaze mfite umutima w'urukundo n'ubugwaneeza?<verse eid="1CO 4:21" /></para>
  <chapter eid="1CO 4" />
  <chapter number="5" style="c" sid="1CO 5" />
  <para style="s">Ubusambanyi Mu Itoorero</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 5:1" />Nabwiwe inkuru y'imvaho yuuko muri mwe hari ubusambanyi bukabije, ndetse no ku buryo butaraaboneka no mu banyamahanga bataazi Imaana. Bavuga ko umugabo umwe muri mwe atunze umugore wa se. <verse eid="1CO 5:1" /><verse number="2" style="v" sid="1CO 5:2" />Noone muriishira heejuru! Ahuubwo mwari kubabara, maze uwakoze ico caaha akiirukanwa muri mwe. <verse eid="1CO 5:2" /><verse number="3" style="v" sid="1CO 5:3" />Kandi nuubwo ndi kure yaanyu mu mubiri, ndikumwe namwe mu mwuka, kandi nkaba naramaze guciira urubanza uwakoze ayo mahano, <verse eid="1CO 5:3" /><verse number="4" style="v" sid="1CO 5:4" />mu izina rya Nyagasani Yesu nk'aho nari mpiibeereye. Nimuteeranira hamwe mu izina rya Nyagasani Yesu, nanje ngateerana namwe mu mutima, <verse eid="1CO 5:4" /><verse number="5" style="v" sid="1CO 5:5" />uwo mugabo muzaamushikirize Sataani maze umubiri we urimbuke, kugira ngo ubugingo bwe buzaarokoke ku munsi wa Nyagasani.<verse eid="1CO 5:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="1CO 5:6" />
    <note caller="-" style="x">
      <char style="xo" closed="false">5:6 </char>
      <char style="xt" closed="false">
        <ref loc="GAL 5:9">Gal 5:9</ref>.</char>
    </note>Si byiza ko mwakwiraata! Ntaabwo muuzi yuuko agasemburo gake gatuubuura igifooto coose c'ifu? <verse eid="1CO 5:6" /><verse number="7" style="v" sid="1CO 5:7" />Noone reero nimwivaanemo icaaha kimeze nk'umusemburo ushaaje, maze mube nk'umugaati musha udasembuye nk'uko musanzwe. Dore igihe c'ibirori byo Kunyurwaho kirageze, kuko Kristo ari we mwana w'intaama w'igitambo co Kunyurwaho watambwe. <verse eid="1CO 5:7" /><verse number="8" style="v" sid="1CO 5:8" />Noone reero nitwizihize ibyo birori tudakoreesheje umusemburo ushaaje ari co caaha n'ubukozi bw'ibibi, ahuubwo dukoreeshe umugaati udasembuye ari wo ukuri no kutaryarya.<verse eid="1CO 5:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="1CO 5:9" />Mu rwandiko mperuutse kubandikira, nababwiye yuuko mutagomba kwifatanya n'abasambanyi. <verse eid="1CO 5:9" /><verse number="10" style="v" sid="1CO 5:10" />Sinashaakaga kuvuga abasambanyi bo muri iyi si, cangwa abanyamururu n'abambuzi, cangwa abasenga ibishushaanyo, kuko kwitandukanya na bo boose byabasaba kuva mu isi. <verse eid="1CO 5:10" /><verse number="11" style="v" sid="1CO 5:11" />Ibyo nashaakaga kubabwira ni ukutiifatanya n'umuntu wiiyita umuvandimwe muri Kristo kandi akaba ari umusambanyi, cangwa umunyamururu, cangwa usenga ibishushaanyo, usebanya, umusinzi, cangwa umwambuzi. Ndetse umuntu nk'uwo ntimugasangire na we.<verse eid="1CO 5:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="1CO 5:12" />Mbese hari aho mpuuriye no guciira urubanza abo hanze batari abakristo? Mbese si abo muri mwe bo mukwiriye guciira urubanza? <verse eid="1CO 5:12" /><verse number="13" style="v" sid="1CO 5:13" />Imaana ni yo izaabaciira urubanza. Noone reero nimugenze nk'uko byanditswe ngo, “Nimuvaane inkozi z'ibibi muri mwe.”<verse eid="1CO 5:13" /></para>
  <chapter eid="1CO 5" />
  <chapter number="6" style="c" sid="1CO 6" />
  <para style="s">Imanza z'Abakristo</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 6:1" />Igihe umwe muri mwe agize ico apfa n'umukristo mugenzi we, yahangaara ate kumurega ku bacaamanza b'abapagaani, mumwanya wo kuja ku bantu b'Imaana ngo babakiraanure? <verse eid="1CO 6:1" /><verse number="2" style="v" sid="1CO 6:2" />Ntaabwo muuzi yuuko abantu b'Imaana ari bo bazaaciira ab'isi urubanza? Noone se niiba ari mwe muzaaciira ab'isi urubanza, mwananirwa mute guca imanza zooroheje? <verse eid="1CO 6:2" /><verse number="3" style="v" sid="1CO 6:3" />Ntaabwo muuzi yuuko tuzaaciira abaamalayika urubanza? Niiba bimeze bityo twashobora guciira imanza abantu b'iki gihe <verse eid="1CO 6:3" /><verse number="4" style="v" sid="1CO 6:4" />Niiba reero mufite imanza zimeze zityo, ni kuki muzishira mu bantu badafite ico bahuuriyeho n'itoorero? <verse eid="1CO 6:4" /><verse number="5" style="v" sid="1CO 6:5" />Mbese ntaasoni mugira? Ubwo koko ntaamuntu n'umwe muri mwe ufite ubwenge bwashobora gukiraanura abakristo bagenzi baanyu? <verse eid="1CO 6:5" /><verse number="6" style="v" sid="1CO 6:6" />Dore ahuubwo umukristo ajaana mugenzi we mu rukiiko maze abatiizeera bakabaciira urubanza!<verse eid="1CO 6:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="1CO 6:7" />Kuko mufitanye imanza zigomba guciibwa n'abaramuzi mu nkiiko, byerekana yuuko mwananiwe kwitwara nk'abakristo. Kuki mutiihanganira gukorerwa naabi? Kuki mutaakwemera kunyagwa ibyanyu? <verse eid="1CO 6:7" /><verse number="8" style="v" sid="1CO 6:8" />Ahuubwo mwe ubwanyu mugirira abandi naabi ndetse mukabambura, kandi ari abakristo bagenzi baanyu. <verse eid="1CO 6:8" /><verse number="9" style="v" sid="1CO 6:9" />Ntaabwo muuzi neeza yuuko inkozi z'ibibi zitazaaragwa Ubwami bw'Imaana? Muramenye ntimwibeeshe! Inkozi z'ibibi, abasenga ibishushaanyo, abasambanyi basanzwe n'abakora ibitingwa, <verse eid="1CO 6:9" /><verse number="10" style="v" sid="1CO 6:10" />abajuura, abanyamururu, abasinzi, abatukana, n'abambuzi, abo boose ntibazaaragwa Ubwami bw'Imaana. <verse eid="1CO 6:10" /><verse number="11" style="v" sid="1CO 6:11" />Bamwe muri mwe mwari mumeze mutyo ariko ubu mwuhagiwe ibyaha, mureezwa, kandi mugirwa intungaane imbere y'Imaana ku bwa Nyagasani Yesu Kristo, no ku bw'Umwuka Weera.<verse eid="1CO 6:11" /></para>
  <para style="s">Mukoreeshe Imibiri yaanyu Guheesha Imaana Ikuzo</para>
  <para style="p">
    <verse number="12" style="v" sid="1CO 6:12" />
    <note caller="-" style="x">
      <char style="xo" closed="false">6:12 </char>
      <char style="xt" closed="false">
        <ref loc="1CO 10:23">1 Kor 10:23</ref>.</char>
    </note>Bamwe muri mwe baravuga bati, “Neemerewe gukora ibyo niishaakiye.” Nyamara ntaabwo ariko byose bifite akamaro. Nshobora kuvuga ko nemerewe gukora ibyo niishaakiye, ariko sinzeemera gutegekwa na kimwe muri byo. <verse eid="1CO 6:12" /><verse number="13" style="v" sid="1CO 6:13" />Abandi baravuga bati, “Ibyokurya ni iby'inda, kandi n'inda ni iy'ibyokurya.” Nyamara Imaana izaabitsemba byombi. Umubiri ntaabwo wagenewe ubusambanyi, ahuubwo wagenewe gukorera Nyagasani na Nyagasani akaba ari we uwureeberera. <verse eid="1CO 6:13" /><verse number="14" style="v" sid="1CO 6:14" />Imaana yazuuye Umwami Yesu, naatwe izaatuzuura ikoreesheje imbaraga zaayo.<verse eid="1CO 6:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="1CO 6:15" />Ntimuuzi yuuko imibiri yaanyu ari ingingo za Kristo? Noone se mfate ingingo z'umubiri wa Kristo maze nzigire ingingo za malaaya? Oya, ntibishoboka! <verse eid="1CO 6:15" /><verse number="16" style="v" sid="1CO 6:16" />Cangwa ntimuuzi yuuko usambanye na malaaya aba abaaye umubiri umwe na we? Kuko ibyanditswe biravuga ngo, “Bombi bazaaba babaaye umubiri umwe.” <verse eid="1CO 6:16" /><verse number="17" style="v" sid="1CO 6:17" />Ariko uwiifatanya na Nyagasani aba abaaye umwe na we.<verse eid="1CO 6:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="1CO 6:18" />Nimwirinde ubusambanyi! Icaha coose umuntu akora, ntikigera ku mubiri we, naho usambana aba acumuriye umubiri we bwiite. <verse eid="1CO 6:18" /><verse number="19" style="v" sid="1CO 6:19" /><note caller="-" style="x"><char style="xo" closed="false">6:19 </char><char style="xt" closed="false"><ref loc="1CO 3:16">1 Kor 3:16</ref>; <ref loc="2CO 6:16">2 Kor 6:16</ref>.</char></note>Ntimuuzi yuuko imibiri yaanyu ari urusengero rw'Umwuka Weera utuuye muri mwe mwahaawe n'Imaana kandi mukaba ari ntaabubaasha mwifiteho ngo mwigenge? <verse eid="1CO 6:19" /><verse number="20" style="v" sid="1CO 6:20" />Imaana yabacunguje ikiguzi gikomeye! Noone reero nimukoreeshe imibiri yaanyu kuyiheesha ikuzo.<verse eid="1CO 6:20" /></para>
  <chapter eid="1CO 6" />
  <chapter number="7" style="c" sid="1CO 7" />
  <para style="s">Ibyerekeye ibyo Gushingiranwa</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 7:1" />Noone kubyerekeye ibyo mwanyandikiye, ni byiza ko umagabo atarongora. <verse eid="1CO 7:1" /><verse number="2" style="v" sid="1CO 7:2" />Ariko kuko hariho ubusambanyi bukabije, buri mugabo agomba kugira umugore we, na buri mugore akagira umugabo we. <verse eid="1CO 7:2" /><verse number="3" style="v" sid="1CO 7:3" />Umugabo ntaakwiriye kwiyima umugore we, kandi n'umugore ntaakwiriye kwiyima umugabo. <verse eid="1CO 7:3" /><verse number="4" style="v" sid="1CO 7:4" />Kuko umugore ntiyigenga ku mubiri we, ahuubwo ugengwa n'umugabo we, byongeye kandi, umugabo na we ntiyigenga ku mubiri we, ahuubwo ugengwa n'umugore we. <verse eid="1CO 7:4" /><verse number="5" style="v" sid="1CO 7:5" />Ntihakagire uwiyima undi, keretse mubanje kubyumviikana, kandi na bwo kumara igihe gito, kugira ngo mubone uko musenga. Ariko mugomba kongera kugira imibonano bidatinze kugira ngo mutananirwa kwifata maze Sataani akaboneraho kubashuka.<verse eid="1CO 7:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="1CO 7:6" />Ibyo mbabwiye mbona ko ari byo bikwiriye, ariko simbibategetse. <verse eid="1CO 7:6" /><verse number="7" style="v" sid="1CO 7:7" />Nakwifuuje yuuko abantu boose baamera nkanje, ariko buri umwe afite ingabire yiihariye yahaawe n'Imaana.<verse eid="1CO 7:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1CO 7:8" />Kuri abo bataraashaaka hamwe n'abo baakuuweho abo baashaakanye, ndababwira yuuko iciiza ari uko baakwigumira bonyine nkanje. <verse eid="1CO 7:8" /><verse number="9" style="v" sid="1CO 7:9" />Ariko niiba badashobora kwifata, bagomba gushaaka, kuko ibyiza ari ugushaaka aho kwicwa n'irari.<verse eid="1CO 7:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="1CO 7:10" />
    <note caller="-" style="x">
      <char style="xo" closed="false">7:10 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 5:32">Mat 5:32</ref>; <ref loc="MAT 19:9">19:9</ref>; <ref loc="MRK 10:11">Mar 10:11</ref>,<ref loc="MRK 10:12">12</ref>; <ref loc="LUK 16:18">Luk 16:18</ref>.</char>
    </note>Kuri abo baashaakanye, mbahaaye itegeko ritari iryanje, ahuubwo riturutse kuri Nyagasani. Umugore ntaagatandukane n'umugabo we, <verse eid="1CO 7:10" /><verse number="11" style="v" sid="1CO 7:11" />ariko aramutse atandukanye na we, ntaakongere gushingirwa ku wundi mugabo ahuubwo yiiyuzuze n'umugabo we, kandi n'umugabo ntaakiirukane umugore we.<verse eid="1CO 7:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="1CO 7:12" />Ku bandi, ibyo ngiiye kubabwira ni ibyanje si ibya Nyagasani. Umugabo weemera Kristo aramutse afite umugore utiizeera, kandi uwo mugore akeemera kubaana na we, ntaabwo agomba kumwirukana. <verse eid="1CO 7:12" /><verse number="13" style="v" sid="1CO 7:13" />Kandi umugore aramutse afite umugabo utiizeera, ntaabwo agomba gutandukana na we. <verse eid="1CO 7:13" /><verse number="14" style="v" sid="1CO 7:14" />Kuko umugabo utiizeera yezwa ku bw'umugore we, kandi umugore utiizeera na we yezwa ku bw'umugabo we. Bitabaaye bityo, abaana baabo baaba badatunganye imbere y'Imaana, kandi si ko biri kuko beeguriwe Imaana. <verse eid="1CO 7:14" /><verse number="15" style="v" sid="1CO 7:15" />Ariko wa wundi utiizeera Kristo ahisemo gutandukana n'uwo baashaakanye abikore. Iyo bibaaye bityo, umuvandimwe wizeera Kristo aba abohoowe, kuko Imaana yaduhamagariye kubaho mu mahoro. <verse eid="1CO 7:15" /><verse number="16" style="v" sid="1CO 7:16" />Wa mugore we w'umukristo, wabwirwa n'iki ko utazaakiza umugabo waawe? Naawe wa mugabo we w'umukristo, wabwirwa n'iki ko utazaakiza umugore waawe?<verse eid="1CO 7:16" /></para>
  <para style="s1">Mubeho Nk'uko Imaana Yabahamagaye</para>
  <para style="p">
    <verse number="17" style="v" sid="1CO 7:17" />Nuuko reero buri muntu akomeze kuba nk'uko Nyagasani yamugeneye, kandi amere nk'uko yari ari Imaana ikimuhamagarira kuba umukristo. Iri ni ryo tegeko niigiisha mu ma toorero yoose. <verse eid="1CO 7:17" /><verse number="18" style="v" sid="1CO 7:18" />Muri mwe niiba hari uwahamagawe n'Imaana yarakebwe, ntaagomba kwigira nk'aho ataakebwe. Niiba kandi hari uwahamagawe ataraakebwa, singombwa ko akebwa. <verse eid="1CO 7:18" /><verse number="19" style="v" sid="1CO 7:19" />Haaba gukebwa cangwa kudakebwa, byose ntaaco bivuze, ahuubwo igikuru ni ukuubahiriza amategeko y'Imaana. <verse eid="1CO 7:19" /><verse number="20" style="v" sid="1CO 7:20" />Buri muntu agume nk'uko yari ameze igihe Imaana yamuhamagaye. <verse eid="1CO 7:20" /><verse number="21" style="v" sid="1CO 7:21" />Niiba igihe wahamagawe wari imbaata, ntibikakubabaze. Ariko uramutse uboonye umugisha wo kuva mu bubaata, uzaawukoreeshe. <verse eid="1CO 7:21" /><verse number="22" style="v" sid="1CO 7:22" />Uwo Nyagasani yahamagaye ari imbaata, aba yaragizwe uwiigenga na Kristo, kandi uwahamagawe na Kristo ari uwiigenga, aba abaaye imbaata ye. <verse eid="1CO 7:22" /><verse number="23" style="v" sid="1CO 7:23" />Imaana yabatanzeho ikiguzi, noone reero ntimukabe imbaata z'abantu. <verse eid="1CO 7:23" /><verse number="24" style="v" sid="1CO 7:24" />Bavandimwe, buri muntu agume yunze ubumwe n'Imaana nk'uko yari ameze agihamagarwa.<verse eid="1CO 7:24" /></para>
  <para style="s1">Imyifatire y'Abataraashaaka n'Abapfaakazi</para>
  <para style="p">
    <verse number="25" style="v" sid="1CO 7:25" />Ku byo mwanditse byerekeye abataraashaaka, ntaategeko mbifitiye rivuuye kuri Nyagasani, ahuubwo ndababwira igiteekerezo canje nk'umuntu Nyagasani yagiriye impuhwe.<verse eid="1CO 7:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="1CO 7:26" />Ngereranyije n'ibi bihe bikomeye, ni byiza ko buri muntu aguma nk'uko ari. <verse eid="1CO 7:26" /><verse number="27" style="v" sid="1CO 7:27" />Niiba ufite umugore, ntuugatandukane na we. Niiba ntaamugore ufite, ntuukamushaake. <verse eid="1CO 7:27" /><verse number="28" style="v" sid="1CO 7:28" />Icakora uramutse ushaatse umugore, ntaacaaha uba ukoze, kandi n'umukoobwa utaraashaaka aramutse ashingiwe, ntaacaaha aba akoze. Ariko abashingiranwa bazaagira ingoorane mu buzima bwabo, kandi ni byo nashaakaga kubarinda.<verse eid="1CO 7:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="1CO 7:29" />Bavandimwe, ndababwiza ukuri yuuko hasigaye igihe gito. Uheereye noone, abafite abagore babe nk'abatabafite, <verse eid="1CO 7:29" /><verse number="30" style="v" sid="1CO 7:30" />kandi abarira babe nk'abatarira, n'abaneezeerewe babe nk'aho bataneezeerewe, kandi n'abacuruuza bamere nk'aho ntaaco bagira, <verse eid="1CO 7:30" /><verse number="31" style="v" sid="1CO 7:31" />n'abakoreesha iby'iyi si ntibagatwarwe na byo, kuko ishusho y'iyi si igiiye gushiraho.<verse eid="1CO 7:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="1CO 7:32" />Ndabiifuuriza kudahagarika imitima. Udafite umugore aharanira gukora umurimo wa Nyagasani, kuko aba ashaaka gushiimiisha Imaana, <verse eid="1CO 7:32" /><verse number="33" style="v" sid="1CO 7:33" />naho umugabo ufite umugore, aharanira iby'isi ngo abone uko ashiimiisha umugore we, <verse eid="1CO 7:33" /><verse number="34" style="v" sid="1CO 7:34" />bityo reero akagira imitima ebyiri. Umugore utaraashaatse cangwa umukoobwa w'isugi ashiishikarira ibya Nyagasani, kugira ngo atungaane ku mubiri no ku mutima, naho umugore ufite umugabo ashiishikarira iby'isi, ashaakiisha uko yaashiimiisha umugabo we.<verse eid="1CO 7:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="1CO 7:35" />Ibyo mbibabwiriye kubafasha atari ukubahata, kugira ngo mukore ibitunganye kandi mwiyegurire Nyagasani ntaakibateganya.<verse eid="1CO 7:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="1CO 7:36" />Ariko haramutse hari umusore wiiyumviisha ko yaaba ahemukiye umukobwa yasabye aramutse atamurongoye kandi amurarikiye caane, nibashingiranwe nk'uko babishaaka, kuko ntaacaaha baba bakoze. <verse eid="1CO 7:36" /><verse number="37" style="v" sid="1CO 7:37" />Niiba kandi umusore yiiyemeje mu mutima we kutarongora umukoobwa ntaawe umuhase, kandi akaba yaashobora kurinda irari rye, yaaba akoze neeza kutarongora uwo mukoobwa. <verse eid="1CO 7:37" /><verse number="38" style="v" sid="1CO 7:38" />Bityo reero, umugabo urongora aba akoze neeza, ariko utarongora aba akoze neeza kurushaho.<verse eid="1CO 7:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="1CO 7:39" />Umugore ufite umugabo ntaabwo aba yeemerewe gushingirwa umugabo we akiriho, ariko iyo umugabo we apfuuye, umugore afite uburenganzira bwo gushingirwa ku w'undi mugabo yiishimiye weese, ariko uwo mugabo akwiriye kuba ari umukristo. <verse eid="1CO 7:39" /><verse number="40" style="v" sid="1CO 7:40" />Ariko ku bwanje, yaarushaho kumererwa neeza agumye uko ari, kandi niibwira yuuko nanje mfite Umwuka w'Imaana.<verse eid="1CO 7:40" /></para>
  <chapter eid="1CO 7" />
  <chapter number="8" style="c" sid="1CO 8" />
  <para style="s">Ibyokurya Biterekeejwe Ibigirwamaana</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 8:1" />Noone ndashaaka kuvuga ku byerekeye ibyokurya biterekeejwe ibigirwamaana.</para>
  <para style="p" vid="1CO 8:1">Ni koko, “Twese tubifiteho ubumenyi” nk'uko bivugwa. Ubwo bumenyi buteera kwiraata, naho urukundo rurakomeza. <verse eid="1CO 8:1" /><verse number="2" style="v" sid="1CO 8:2" />Umuntu wiibwira ko hari ico azi, aba ntaaco yari yaamenya ukurikije ibyo akwiriye kumenya, <verse eid="1CO 8:2" /><verse number="3" style="v" sid="1CO 8:3" />ariko umuntu ukunda Imaana amenywa na yo.<verse eid="1CO 8:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="1CO 8:4" />Noone reero kubyerekeye kurya ibyokurya byaterekeejwe ibigirwamaana, tuuzi neeza yuuko ku isi ibigirwamaana ari ubusa kandi ko ntaayindi Maana iriho keretse Imaana imwe rukumbi. <verse eid="1CO 8:4" /><verse number="5" style="v" sid="1CO 8:5" />Ni ukuri koko hariho ibyo abantu biita ibigirwamaana mu ijuru no ku isi, kandi koko hariho ibigirwamaana n'ibyitwa abatware byinshi, <verse eid="1CO 8:5" /><verse number="6" style="v" sid="1CO 8:6" />ariko kuri twe hariho Imaana imwe rukumbi ari yo Daata, waremye byose kandi we dukeesha kubaho, kandi hariho na Nyagasani umwe Yesu Kristo watumye ibintu byose bibaho, kandi tukabeeshwaho na we.<verse eid="1CO 8:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="1CO 8:7" />Ariko si ko buri muntu afite ubwo bumenyi. Bamwe bamenyereye kuramya ibigirwamaana kugeza ubu ku buryo bateekereza ko iyo bariiye ibyokurya biibwira yuuko byaterekeejwe ikigirwamaana, bityo reero umutimanaama waabo ugaciika intege maze bakiiyumvamo ko baahumanye. <verse eid="1CO 8:7" /><verse number="8" style="v" sid="1CO 8:8" />Nyamara ibyokurya si byo bizaaduhuuza n'Imaana. Iyo tutabiriiye ntaaco dupfiirwa, kandi iyo tubiriiye ntaaco twunguka.<verse eid="1CO 8:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="1CO 8:9" />Ariko mwirinde kugira ngo ubwo burenganzira bwanyu butaaza kuguusha abanyantege nke mu caaha. <verse eid="1CO 8:9" /><verse number="10" style="v" sid="1CO 8:10" />Koko se umunyantege nke akuboonye, wowe usobaanukiwe uriira mu ngoro y'ikigirwamaana, ntibyamuteera kurya ibyokurya byaterekeejwe ibigirwamaana? <verse eid="1CO 8:10" /><verse number="11" style="v" sid="1CO 8:11" />Bityo reero gusobaanukirwa kwawe kuzaatuma umuvandimwe waawe wo Yesu yapfiiriye arimbuka. <verse eid="1CO 8:11" /><verse number="12" style="v" sid="1CO 8:12" />Kandi nimucumura ku bavandimwe baanyu, mugatuma umutimanaama waabo udashobora guhitamo ikibi n'iciiza, muba mucumuye kuri Kristo. <verse eid="1CO 8:12" /><verse number="13" style="v" sid="1CO 8:13" />Nuuko reero niiba ibyokurya ari byo biguusha umuvandimwe wanje mu caaha, sinzongera kurya inyama, kugira ngo ntamuguusha mu caaha.<verse eid="1CO 8:13" /></para>
  <chapter eid="1CO 8" />
  <chapter number="9" style="c" sid="1CO 9" />
  <para style="s">Uburenganzira n'Inshingano by'Intumwa</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 9:1" />Mbese simfite umudendeezo? Mbese si ndi intumwa? Mbese sinaboonye Yesu Umwami waacu ? Mbese ntimuri umusaaruuro wanje muri Nyagasani? <verse eid="1CO 9:1" /><verse number="2" style="v" sid="1CO 9:2" />Niiba ku bandi ntari intumwa, niibura ndi yo kuri mwe, kuko muri ikimenyeetso canje co kuba intumwa ya Nyagasani.<verse eid="1CO 9:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="1CO 9:3" />Ibi ni byo niireguuza iyo abantu bansebya. <verse eid="1CO 9:3" /><verse number="4" style="v" sid="1CO 9:4" />Mbese ntitugira uburenganzira bwo guhaabwa ibyo kurya n'ibyo kunywa? <verse eid="1CO 9:4" /><verse number="5" style="v" sid="1CO 9:5" />Mbese twebwe ntitugira uburenganzira bwo kujaana n'umugore wiizeera nk'uko izindi ntumwa hamwe n'abavandimwe ba Nyagasani na Peetero baabigenjeje? <verse eid="1CO 9:5" /><verse number="6" style="v" sid="1CO 9:6" />Cangwa se ni nje na Barinaba twenyine duhatirwa gukorera ibidutunga? <verse eid="1CO 9:6" /><verse number="7" style="v" sid="1CO 9:7" />Ni nde waaba ari umusirikare, maze akiyishurira ibimutunga? Ni nde waahinga umuzaabibu maze ntaawuryeho imbuto? Cangwa se ni nde waaragira ubusho bw'inka maze ntanywe amata?<verse eid="1CO 9:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1CO 9:8" />Ibyo simbivuga nshingiye ku miteekerereze y'abantu. Amategeko na yo arabihamya. <verse eid="1CO 9:8" /><verse number="9" style="v" sid="1CO 9:9" /><note caller="-" style="x"><char style="xo" closed="false">9:9 </char><char style="xt" closed="false"><ref loc="1TI 5:18">1 Tim 5:18</ref>.</char></note>Kuko byanditswe mu mategeko ya Moose ngo, “Ntimugapfuke umunwa w'ikimasa igihe kivunga ingano.” Ubwo se ibimasa ni byo Imaana yiitaho byonyine? <verse eid="1CO 9:9" /><verse number="10" style="v" sid="1CO 9:10" />Cangwa se si twe yabivugiye? Ni koko ni twebwe byandikiwe, kuko uhinga n'uhuura bombi bakwiriye kubikora bafite ibyiringiro byo kugabana ku musaaruuro. <verse eid="1CO 9:10" /><verse number="11" style="v" sid="1CO 9:11" /><note caller="-" style="x"><char style="xo" closed="false">9:11 </char><char style="xt" closed="false"><ref loc="ROM 15:27">Rom 15:27</ref>.</char></note>Niiba twarababibyemo imbuto z'Umwuka w'Imaana, mbese byabakomerera dusaaruye ku byo mutunze? <verse eid="1CO 9:11" /><verse number="12" style="v" sid="1CO 9:12" />Kandi niiba abandi babafiteho uburenganzira bwo kugira ico bababonaho, twebwe ntitubarusha ubwo burenganzira?</para>
  <para style="p" vid="1CO 9:12">Nyamara ubwo burenganzira ntitwabukoreesheje, ahuubwo twihangaaniye byose kugira ngo tutaba igisiitaaza mu nzira yo kwamamaza Ubutumwa Bwiza bwa Kristo. <verse eid="1CO 9:12" /><verse number="13" style="v" sid="1CO 9:13" />Mbese ntimuuzi yuuko abakora mu Nzu y'Imaana batungwa n'ibyo muri iyo Nzu, n'abatambira ku rutambiro bakagabana ku byo batambye? <verse eid="1CO 9:13" /><verse number="14" style="v" sid="1CO 9:14" /><note caller="-" style="x"><char style="xo" closed="false">9:14 </char><char style="xt" closed="false"><ref loc="MAT 10:10">Mat 10:10</ref>; <ref loc="LUK 10:7">Luk 10:7</ref>.</char></note>Bityo reero, Nyagasani yategetse yuuko abaamamaza Ubutumwa Bwiza bagomba gutungwa na bwo.<verse eid="1CO 9:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="1CO 9:15" />Ariko ntaaco muri ubu burenganzira niigeze kwitwaza, kandi simbandikiye ibyo kugira ngo mugire ico mumpa. Ahuubwo naahitamo gupfa, kuruta uko umuntu yahindura ubusa uko kwiraata kwanje! <verse eid="1CO 9:15" /><verse number="16" style="v" sid="1CO 9:16" />Iyo mbwirije Ubutumwa Bwiza, ntibinteera kwiraata, kuko ari umurimo ntegetswe gukora, kandi ntaamamaje Ubutumwa Bwiza naguusha ishano! <verse eid="1CO 9:16" /><verse number="17" style="v" sid="1CO 9:17" />Iyo mba nkora uyu murimo ku bushaake bwanje, mba naraboonye uruhembo, ariko kuko nawuhaawe n'Imaana, mbikora nk'umurimo nshinzwe. <verse eid="1CO 9:17" /><verse number="18" style="v" sid="1CO 9:18" />Noone se uruhembo rwanje ni uruuhe? Uruhembo rwanje ni ukwamamaza Ubutumwa Bwiza ku buntu, ntakurikije uburenganzira ngenewe nk'umubwirizabutumwa.<verse eid="1CO 9:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="1CO 9:19" />Nuubwo mfite umudendeezo kuri boose, niihinduye umugaragu wa boose kugira ngo ndusheho kwigaruriza abantu benshi mbageza kuri Kristo. <verse eid="1CO 9:19" /><verse number="20" style="v" sid="1CO 9:20" />Iyo ndi n'Abayuuda, mba nk'Umuyuuda kugira ngo mbone uko mbiigarurira. Nuubwo kandi ntagengwa n'amategeko ya Moose, mba nk'ugengwa na yo kugira ngo niigarurire abagengwa na yo. <verse eid="1CO 9:20" /><verse number="21" style="v" sid="1CO 9:21" />Kandi iyo ndi n'abanyamahanga, nanje mba nk'abanyamahanga badakurikiza amategeko y'Abayuuda kugira ngo mbiigarurize. Ariko ibi ntibivuga yuuko ntakurikiza amategeko y'Imaana ahuubwo nyoborwa n'amategeko ya Kristo. <verse eid="1CO 9:21" /><verse number="22" style="v" sid="1CO 9:22" />Iyo ndi n'abafite intege nke mu kwizeera, niitwara nka bo kugira ngo mbiigarurize. Niigize nk'uko abantu boose bameze, kugira ngo nkoreeshe uburyo bwose kurokora bamwe muri bo.<verse eid="1CO 9:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="1CO 9:23" />Ibyo byose mbikorera kwamamaza Ubutumwa Bwiza kugira ngo nzaabuboneho umugabane. <verse eid="1CO 9:23" /><verse number="24" style="v" sid="1CO 9:24" />Mbese ntimuuzi yuuko abarushanwa mu kwiruka boose biiruka, ariko umwe akaba ari we utsindira igihembo? Noone reero namwe nimwiruke kugira ngo muzaatsindire ico gihembo. <verse eid="1CO 9:24" /><verse number="25" style="v" sid="1CO 9:25" />Umuntu weese mu irushanwa yiirinda muri byose, aharanira ikamba rishira vuba, ariko twebwe dukora umurimo waacu kugira ngo tuzaabone ikamba rihoraho iteeka. <verse eid="1CO 9:25" /><verse number="26" style="v" sid="1CO 9:26" />Ni yo mpamvu ntaapfa kwiruka nk'utaazi iyo aja, kandi ni co gituma meze nk'umukinnyi w'ibikonde ukubita adahushwa. <verse eid="1CO 9:26" /><verse number="27" style="v" sid="1CO 9:27" />Ahuubwo mbabaza umubiri wanje nkawukomeza, kugira ngo ntabwiriza abandi Ubutumwa, maze njeewe sineemerwe.<verse eid="1CO 9:27" /></para>
  <chapter eid="1CO 9" />
  <chapter number="10" style="c" sid="1CO 10" />
  <para style="s">Kwamagana Ibigirwamaana</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 10:1" />Bavandimwe, ndashaaka ko mwibuka ibyabaaye kuri baasogokuruza ubwo baari bayobowe na Moose barinzwe n'igicu, maze boose bakambuka Inyanja Itukura. <verse eid="1CO 10:1" /><verse number="2" style="v" sid="1CO 10:2" />Mu gicu no mu nyanja nimwo boose baabatirijwe nk'abayoboke ba Moose, <verse eid="1CO 10:2" /><verse number="3" style="v" sid="1CO 10:3" />maze boose barya ibyokurya bimwe bivuuye mu ijuru ku Maana, <verse eid="1CO 10:3" /><verse number="4" style="v" sid="1CO 10:4" />kandi boose baasangira ico kunywa kivuuye mu ijuru. Banywereye ku rutare rw'umwuka baahaawe n'Imaana rwajaanaga na bo, kandi urwo rutare ni Kristo. <verse eid="1CO 10:4" /><verse number="5" style="v" sid="1CO 10:5" />Ariko benshi muri bo ntaabwo baashiimiishije Imaana, ni co caatumye biicwa maze imirambo yaabo itaagagurizwa mu butaayu.<verse eid="1CO 10:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="1CO 10:6" />Ibyo byose byabeereyeho kugira ngo bitubeere iciitegererezo co kugira ngo tutararikiira ikibi nk'uko na bo baabigenjeje. <verse eid="1CO 10:6" /><verse number="7" style="v" sid="1CO 10:7" />Ntimugasenge ibishushaanyo nk'uko bamwe muri bo baabigenjeje, nk'uko byanditswe ngo, “Abantu baaricaye bararya kandi baranywa, barangije barahaguruka maze barabyina.” <verse eid="1CO 10:7" /><verse number="8" style="v" sid="1CO 10:8" />Twirinde ubusambanyi nk'uko bamwe muri bo basambanye, bigatuma abantu ibihumbi makumyabiri na bitatu bapfiira umunsi umwe. <verse eid="1CO 10:8" /><verse number="9" style="v" sid="1CO 10:9" />Kandi ntitugomba kugerageza Kristo, nk'uko bamwe muri bo baamugerageje, maze bagatsembwa n'inzoka. <verse eid="1CO 10:9" /><verse number="10" style="v" sid="1CO 10:10" />Ntimukiitotombe nk'uko bamwe muri bo biitotombye, maze malayika w'urupfu akabarimbura.<verse eid="1CO 10:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="1CO 10:11" />Ibyo byababaayeho kugira ngo bibeere abandi iciitegererezo, kandi byandikiwe kuduhuguura kuko tugeze mu bihe by'imperuuka.<verse eid="1CO 10:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="1CO 10:12" />Bityo reero uwiibwira ko ahagaze, yiirinde kugira ngo atagwa. <verse eid="1CO 10:12" /><verse number="13" style="v" sid="1CO 10:13" />Ntaakigeragezo na kimwe caabagezeho kidasanzwe mu bantu. Imaana ni intahemuka, kandi ntaabwo izaatuma mugeragezwa n'ibirenze ibyo mwashobora gutsinda. Ariko nimugeragezwa, Imaana izaabaha imbaraga zo kwihangaanira ibyo bigeragezo maze ibahe n'uburyo bwo kubivamo.<verse eid="1CO 10:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="1CO 10:14" />Nuuko reero nshuti zanje, nimugendere kure ibyo gusenga ibigirwamaana. <verse eid="1CO 10:14" /><verse number="15" style="v" sid="1CO 10:15" />Ndababwira nk'abantu bafite ubwenge, noone reero namwe nimusuuzume ibyo mbabwira. <verse eid="1CO 10:15" /><verse number="16" style="v" sid="1CO 10:16" /><note caller="-" style="x"><char style="xo" closed="false">10:16 </char><char style="xt" closed="false"><ref loc="MAT 26:26-28">Mat 26:26-28</ref>; <ref loc="MRK 14:22-24">Mar 14:22-24</ref>; <ref loc="LUK 22:19">Luk 22:19</ref>,<ref loc="LUK 22:20">20</ref>.</char></note>Mbese igikopu c'umugisha dukoreesha dushiimira Imaana, si ugusangira amaraso ya Kristo? Naho se umugaati tumanyura, si ugusangira umubiri wa Kristo? <verse eid="1CO 10:16" /><verse number="17" style="v" sid="1CO 10:17" />Kuko hariho umugaati umwe, twese nuubwo turi benshi, turi umubiri umwe, kuko twese dusangira umugaati umwe.<verse eid="1CO 10:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="1CO 10:18" />Nimureebe urubyaro rwa Isirayeli. Mbese abarya ku byatambiwe Imaana ku rutambiro ntibaba bafatanyije mugukora umurimo wo ku rutambiro? <verse eid="1CO 10:18" /><verse number="19" style="v" sid="1CO 10:19" />Mbese nshaaka kumenyeesha iki? Ibyokurya bituuwe ibigirwamaana hari ico bimaze? Cangwa ikigirwamaana hari ico kimaze? <verse eid="1CO 10:19" /><verse number="20" style="v" sid="1CO 10:20" />Oya, ahuubwo ico menyeesha ni uko ibyo abapagaani baterekeeza babiterekeeza abadayimooni, atari Imaana babituura, kandi sinshaaka ko musangira n'abadayimooni. <verse eid="1CO 10:20" /><verse number="21" style="v" sid="1CO 10:21" />Ntimushobora kunywera ku gikopu ca Nyagasani hamwe no ku gikopu c'abadayimooni, ntimushobora kurya ibyo ku meeza ya Nyagasani ngo mwongere murye ibyo ku meeza y'abadayimooni. <verse eid="1CO 10:21" /><verse number="22" style="v" sid="1CO 10:22" />Cangwa se turashaaka gutuma Nyagasani agira ishari? Duteekereza ko tumurusha imbaraga?<verse eid="1CO 10:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="1CO 10:23" />
    <note caller="-" style="x">
      <char style="xo" closed="false">10:23 </char>
      <char style="xt" closed="false">
        <ref loc="1CO 6:12">1 Kor 6:12</ref>.</char>
    </note>Bamwe baravuga bati, “Twemerewe gukora ibyo twishaakiye,” nyamara ntaabwo ari ko byose bidufitiye akamaro. “Twemerewe gukora ibyo twishaakiye,” ariko si ko byose bitwungura. <verse eid="1CO 10:23" /><verse number="24" style="v" sid="1CO 10:24" />Ntihakagire uwiishaakira inyungu ye bwite, ahuubwo aje ayishaakira abandi.<verse eid="1CO 10:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="1CO 10:25" />Muje murya ibyokurya biguriishwa mu iguriro byose mutabanje kubaririza kugira ngo imitima yaanyu itabaciira urubanza, <verse eid="1CO 10:25" /><verse number="26" style="v" sid="1CO 10:26" />kuko isi n'ibiyirimo byose ari ibya Nyagasani.<verse eid="1CO 10:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="1CO 10:27" />Nihagira umuntu utiizeera Kristo ubatumira gusangira na we maze mukeemera ubwo butumire, muje murya ibyo abazimaaniye mutabanje kubaza kugira ngo imitima yaanyu itabaciira urubanza. <verse eid="1CO 10:27" /><verse number="28" style="v" sid="1CO 10:28" />Ariko nihagira ubabwira ati, “Ibi byokurya byaterekeejwe ibigirwamaana,” ntimukabirye kuko abibabwiriye no ku bw'umutimanaama. <verse eid="1CO 10:28" /><verse number="29" style="v" sid="1CO 10:29" />Umutimanaama mvuga si uwaanyu, ahuubwo ni uwa wa muntu.</para>
  <para style="p" vid="1CO 10:29">Ikindi kandi, kuki umutimanaama w'undi muntu waatuma ntakora ico nshaaka gukora. <verse eid="1CO 10:29" /><verse number="30" style="v" sid="1CO 10:30" />Niiba ngize ico ndya ngishiimiye Imaana, kuki abantu bansebya kubeera ibyokurya nashiimiye Imaana?<verse eid="1CO 10:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="1CO 10:31" />Nooneho reero, iyo murya cangwa munywa, cangwa mukora ikindi kintu coose, muje mubikorera guheesha Imaana ikuzo. <verse eid="1CO 10:31" /><verse number="32" style="v" sid="1CO 10:32" />Muje mwifata mu buryo bwo kutabeera Abayuuda cangwa Abagiriki cangwa itoorero ry'Imaana igisiitaaza. <verse eid="1CO 10:32" /><verse number="33" style="v" sid="1CO 10:33" />Mugomba gukurikiza urugero rwanje kuko ngerageza gushiimiisha boose muri byose, ntaharanira inyungu zanje bwite, ahuubwo mparanira inyungu za benshi, kugira ngo bakizwe.<verse eid="1CO 10:33" /></para>
  <chapter eid="1CO 10" />
  <chapter number="11" style="c" sid="1CO 11" />
  <para style="p">
    <verse number="1" style="v" sid="1CO 11:1" />
    <note caller="-" style="x">
      <char style="xo" closed="false">11:1 </char>
      <char style="xt" closed="false">
        <ref loc="1CO 4:16">1 Kor 4:16</ref>; <ref loc="PHP 3:17">Fil 3:17</ref>.</char>
    </note>Nuuko reero nimunkurikize, nk'uko nanje nkurikiza Kristo.<verse eid="1CO 11:1" /></para>
  <para style="s">Imyifatire mu Mateeraniro yo Gusenga</para>
  <para style="p">
    <verse number="2" style="v" sid="1CO 11:2" />Ndabashiimira kuko muhora munyibuka muri byose kandi mugakurikiza inyigiisho nababwirije. <verse eid="1CO 11:2" /><verse number="3" style="v" sid="1CO 11:3" />Ariko ndashaaka ko mumenya yuuko Kristo ari we mutwe ugenga buri mugabo, kandi umugabo akaba umutwe ugenga umugore we, naho Imaana ikaba umutwe ugenga Kristo. <verse eid="1CO 11:3" /><verse number="4" style="v" sid="1CO 11:4" />Umugabo weese usenga cangwa agahanuura yitwikiiriye umutwe, aba atuubashe umutwe we ari wo Kristo. <verse eid="1CO 11:4" /><verse number="5" style="v" sid="1CO 11:5" />Naho umugore usenga cangwa agahanuura atiitwikiiriye umutwe, aba atuubashe umutwe we ari wo mugabo we. Uwo mugore aba ahwanye n'uwo boogoshe umusatsi ku mutwe. <verse eid="1CO 11:5" /><verse number="6" style="v" sid="1CO 11:6" />Niiba umugore atiiteze igitambaaro ku mutwe, reero n'umusatsi woose awoogoshe. Ariko kuko biteeye isoni kugira ngo umugore yoogoshe umusatsi we cangwa ngo awukemure, akwiriye kwitega igitambaaro ku mutwe. <verse eid="1CO 11:6" /><verse number="7" style="v" sid="1CO 11:7" />Si ngombwa ko umugabo ya kwitwikiira igitambaaro ku mutwe kuko ari ishusho n'ubwiza bw'Imaana, naho umugore ni ubwiza bw'umugabo we. <verse eid="1CO 11:7" /><verse number="8" style="v" sid="1CO 11:8" />Ni koko, umugabo ntaabwo yakomootse ku mugore, ahuubwo umugore ni we wakomootse ku mugabo. <verse eid="1CO 11:8" /><verse number="9" style="v" sid="1CO 11:9" />Kandi umugabo si we waremewe umugore ahuubwo umugore ni we waremewe umugabo. <verse eid="1CO 11:9" /><verse number="10" style="v" sid="1CO 11:10" />Ku bw'iyo mpamvu, umugore akwiriye kwambara igitambaaro ku mutwe we nk'ikimenyeetso kigaragaza yuuko agengwa n'umugabo we, kugira ngo bineezeeze abaamalayika. <verse eid="1CO 11:10" /><verse number="11" style="v" sid="1CO 11:11" />Nyamara imbere ya Nyagasani, umugore ntiyabaho hatariho umugabo cangwa ngo umugabo abeho hatariho umugore. <verse eid="1CO 11:11" /><verse number="12" style="v" sid="1CO 11:12" />Kuko nuubwo umugore yakomootse ku mugabo, umugabo na we yabyawe n'umugore, ariko ibintu byose bikomooka ku Maana.<verse eid="1CO 11:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="1CO 11:13" />Ngaaho namwe nimumbwire, mbese birakwiriye ko umugore asenga Imaana adatwikiiriye umutwe? <verse eid="1CO 11:13" /><verse number="14" style="v" sid="1CO 11:14" />Mbese umuco kamere ubwawo ntuutwigiisha yuuko bisuuzuguritse ngo umugabo atereke umusatsi ukaba mureemure, <verse eid="1CO 11:14" /><verse number="15" style="v" sid="1CO 11:15" />naho umugore, kugira umusatsi mureemure bikamuheesha icuubahiro ? Erega umugore Imaana yamuhaaye umusatsi mureemure kugira ngo utwikiire umutwe we. <verse eid="1CO 11:15" /><verse number="16" style="v" sid="1CO 11:16" />Ariko hagize uteemeranya nanje kuri iyi ngingo, amenye yuuko yaaba twebwe cangwa amatoorero y'Imaana ntaawundi muco dufite utari uwo.<verse eid="1CO 11:16" /></para>
  <para style="s">Ibidakwiriye mu Igaburo rya Nyagasani</para>
  <para style="r">(<ref loc="MAT 26:26-29">Mat 26:26-29</ref>; <ref loc="MRK 14:22-25">Mar 14:22-25</ref>; <ref loc="LUK 22:14-20">Luk 22:14-20</ref>)</para>
  <para style="p">
    <verse number="17" style="v" sid="1CO 11:17" />Ariko mu mabwiriza akurikira ntaabwo ndibubashiime, kuko amateeraniro yaanyu yo gusenga aho kubungura, abateera gusubira inyuma. <verse eid="1CO 11:17" /><verse number="18" style="v" sid="1CO 11:18" />Ica mbere ca byose, iyo muteeranye nk'itoorero, numva yuuko mwigabamo ibice, kandi koko bimwe neemeranya na byo. <verse eid="1CO 11:18" /><verse number="19" style="v" sid="1CO 11:19" />Ni koko hagomba kubaho ibice muri mwe, kugira ngo abatungaaniye Imaana muri mwe bagaragare. <verse eid="1CO 11:19" /><verse number="20" style="v" sid="1CO 11:20" />Iyo muteeraniye hamwe, ntaabwo muba muteeranijwe no gusangira Ifunguro rya Nyagasani, <verse eid="1CO 11:20" /><verse number="21" style="v" sid="1CO 11:21" />kuko iyo igihe co kurya kigeze, buri umwe atanguranwa kurya ibyo yiizaniye, bikagera naaho umwe yaakwicwa n'inzara, naho undi yiisindiye. <verse eid="1CO 11:21" /><verse number="22" style="v" sid="1CO 11:22" />Mbese ntaamago mufite ngo abe ari mwo muriira cangwa munywera? Cangwa se muuzanwa no kugayiisha itoorero ry'Imaana hamwe no gukoza isoni abakene? Noone se mbabwire iki? Noone se mbashiime? Oya! Ibyo sinaabibashiimira.<verse eid="1CO 11:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="1CO 11:23" />Nje amabwiriza nahaawe na Nyagasani ni yo nabahaaye ngo: ijoro Umwami Yesu yagambaaniwe, yafashe umugaati, <verse eid="1CO 11:23" /><verse number="24" style="v" sid="1CO 11:24" />amaze kuwushiimira Imaana, arawumaanyura maze aravuga ati, “Uyu ni umubiri wanje utanzwe ku bwanyu. Muje mukora mutya kugira ngo munyibuke.” <verse eid="1CO 11:24" /><verse number="25" style="v" sid="1CO 11:25" />Barangije kurya, afata igikopu maze aravuga ati, “Iki ni igikopu c'iseezerano risha ryemejwe n'amaraso yanje. Muje mubikora mutya igihe coose munywereye divaayi muri iki gikopu, kugira ngo munyibuke.”<verse eid="1CO 11:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="1CO 11:26" />Kuko igihe murya kuri uyu mugaati mukanywera no kuri iki gikopu, muba mwamamaza urupfu rwa Nyagasani, kugeza aho azaagarukira. <verse eid="1CO 11:26" /><verse number="27" style="v" sid="1CO 11:27" />Noone reero umuntu urya uyu mugaati cangwa akanywera ku gikopu ca Nyagasani mu buryo budakwiriye, azaaba acumuye ku mubiri n'amaraso bya Nyagasani. <verse eid="1CO 11:27" /><verse number="28" style="v" sid="1CO 11:28" />Noone reero nimwisuuzume maze mubone kurya uwo mugaati no kunywera kuri ico gikopu. <verse eid="1CO 11:28" /><verse number="29" style="v" sid="1CO 11:29" />Kuko abo boose barya kuri uwo mugaati kandi bakanywera kuri ico gikopu batabanje kuzirikana umubiri wa Kristo, Imaana izaabaciira urubanza igihe barya cangwa banywa. <verse eid="1CO 11:29" /><verse number="30" style="v" sid="1CO 11:30" />Ku bw'iyo mpamvu, abenshi muri mwe bararwaye kandi bafite intege nke, naho abandi baarapfuuye. <verse eid="1CO 11:30" /><verse number="31" style="v" sid="1CO 11:31" />Nyamara tubanje kwisuuzuma ubwacu, ntitwaciirwa urubanza. <verse eid="1CO 11:31" /><verse number="32" style="v" sid="1CO 11:32" />Ariko duciiriwe urubanza na Nyagasani, turahanwa kugira ngo tudaciirwa urubanza rw'iteeka hamwe n'ab'isi.<verse eid="1CO 11:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="1CO 11:33" />Noone reero bavandimwe, igihe muteeraniriye hamwe gusangira, muje murindana. <verse eid="1CO 11:33" /><verse number="34" style="v" sid="1CO 11:34" />Nihagira usonza, azaaje abanza kuriira iwe, kugira ngo nimuteerana, imyifatire yaanyu itabaviiramo guciirwa urubanza n'Imaana. Ibisigaye nzaabibabwira ubwo nzaagaruka.<verse eid="1CO 11:34" /></para>
  <chapter eid="1CO 11" />
  <chapter number="12" style="c" sid="1CO 12" />
  <para style="s">Impaano z'Umwuka Weera</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 12:1" />Bavandimwe, sinshaaka yuuko muba murujijo mu byerekeye impaano z'Umwuka Weera. <verse eid="1CO 12:1" /><verse number="2" style="v" sid="1CO 12:2" />Muuzi yuuko ubwo mwari mukiri abapagaani, mwashukwaga kandi mukayobeeshwa n'ibigirwamaana bitavuga. <verse eid="1CO 12:2" /><verse number="3" style="v" sid="1CO 12:3" />Ni co gituma nshaaka yuuko mumenya ko ari ntaamuntu uyoborwa n'Umwuka w'Imaana wavuga ati, “Yesu naavumwe!” Kandi ko ari ntaamuntu wavuga ati, “Yesu n'Umwami” keretse abiheeshejwe n'Umwuka Weera.<verse eid="1CO 12:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="1CO 12:4" />
    <note caller="-" style="x">
      <char style="xo" closed="false">12:4 </char>
      <char style="xt" closed="false">
        <ref loc="ROM 12:6-8">Rom 12:6-8</ref>.</char>
    </note>Hariho impaano z'uburyo bwinshi, ariko Umwuka uzitanga ni umwe, <verse eid="1CO 12:4" /><verse number="5" style="v" sid="1CO 12:5" />kandi hariho uburyo bwinshi bwo gukorera Imaana, ariko ni Nyagasani umwe dukorera. <verse eid="1CO 12:5" /><verse number="6" style="v" sid="1CO 12:6" />Hariho uburyo bwinshi bwo gutanga ubuheereza, ariko Imaana itanga ubwo bushobozi kuri boose ni imwe. <verse eid="1CO 12:6" /><verse number="7" style="v" sid="1CO 12:7" />Umwuka w'Imaana yiigaragariza mu mpaano aha buri muntu, kugira ngo bigirire boose akamaro. <verse eid="1CO 12:7" /><verse number="8" style="v" sid="1CO 12:8" />Umwuka w'Imaana aha umuntu umwe ubushobozi bwo kuvuga ijambo ry'ubwenge, undi uwo Mwuka akamuha ijambo ry'ubumenyi. <verse eid="1CO 12:8" /><verse number="9" style="v" sid="1CO 12:9" />Umwe uwo Mwuka akamuha kwizeera Kristo bihebuuje, undi akamuha impaano yo gukiza indwara. <verse eid="1CO 12:9" /><verse number="10" style="v" sid="1CO 12:10" />Undi uwo Mwuka amuha imbaraga zo gukora ibitangaaza, undi akamuha impaano yo guhanuura, undi akamuha ubushobozi bwo kugenzuura Umwuka w'Imaana n'umwuka udaturuka ku Maana. Umwe amuha ubushobozi bwo kuvuga mu ndimi z'uburyo bwinshi, undi akamuha ubushobozi bwo kuzisobaanura. <verse eid="1CO 12:10" /><verse number="11" style="v" sid="1CO 12:11" />Ariko ibyo byose bikorwa n'Umwuka umwe rukumbi, ugaba impaano zitandukanye kuri buri muntu uko yiishaakiye.<verse eid="1CO 12:11" /></para>
  <para style="s">Umubiri Umwe Ugizwe n'Ibice Byinshi</para>
  <para style="p">
    <verse number="12" style="v" sid="1CO 12:12" />
    <note caller="-" style="x">
      <char style="xo" closed="false">12:12 </char>
      <char style="xt" closed="false">
        <ref loc="ROM 12:4">Rom 12:4</ref>,<ref loc="ROM 12:5">5</ref>.</char>
    </note>Kristo ameze nk'umubiri umwe, ugizwe n'ibice bitandukanye, kandi ibyo bice by'umubiri byose n'ubwo bitandukanye, ni umubiri umwe. <verse eid="1CO 12:12" /><verse number="13" style="v" sid="1CO 12:13" />Ni co kimwe, twaba Abayuuda cangwa abanyamahanga, twaba abagaragu cangwa abiigenga, twese twabatirijwe mu Mwuka umwe tuba umubiri umwe, kandi twese twujujwe n'uwo Mwuka umwe.<verse eid="1CO 12:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="1CO 12:14" />Koko reero, umubiri ntaabwo ugizwe n'igice kimwe gusa, ahuubwo ugizwe n'ibice byinshi. <verse eid="1CO 12:14" /><verse number="15" style="v" sid="1CO 12:15" />Ikirenge kiramutse kigize kiti, “Kuko ntari ikiganza, sindi kimwe mu bice by'umubiri,” ico nticaatuma kitaba igice c'umubiri. <verse eid="1CO 12:15" /><verse number="16" style="v" sid="1CO 12:16" />Kandi ugutwi kugize kuti, “Kuko ntari ijiisho, sindi kimwe mu bice by'umubiri,” ico nticaatuma kitaba igice c'umubiri. <verse eid="1CO 12:16" /><verse number="17" style="v" sid="1CO 12:17" />Mbese iyo umubiri uja kuba ijiisho, ibyo kumva byari kuba bite? Kandi iyo umubiri woose uja kuba ugutwi, ibyo guhuumurirwa byari kuba bite? <verse eid="1CO 12:17" /><verse number="18" style="v" sid="1CO 12:18" />Ubusanzwe, Imaana yashize buri gice c'umubiri mu mwanya waco nk'uko yabishaatse. <verse eid="1CO 12:18" /><verse number="19" style="v" sid="1CO 12:19" />Mbese iyo byose bija kuba igice kimwe, umubiri wari kuba he? <verse eid="1CO 12:19" /><verse number="20" style="v" sid="1CO 12:20" />Ubusanzwe hariho ibice byinshi, ariko umubiri ni umwe.<verse eid="1CO 12:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="1CO 12:21" />Ijiisho ntirishobora kubwira ikiganza riti, “Ntaaco umariye,” cangwa ngo umutwe ubwire ikirenge uti, “Ntaaco nkwifuuriza.” <verse eid="1CO 12:21" /><verse number="22" style="v" sid="1CO 12:22" />Ahuubwo ibice by'umubiri bireebeka nk'aho ari ibinyantege nke, ni byo bikenewe caane, <verse eid="1CO 12:22" /><verse number="23" style="v" sid="1CO 12:23" />kandi ibyo bice by'umubiri byo duteekereza ko bifite agaciiro gake ni byo twitaho kuruta ibindi, kandi ibice by'umubiri bidashirwa ku mugaragaro ni byo twitaho caane. <verse eid="1CO 12:23" /><verse number="24" style="v" sid="1CO 12:24" />Nyamara ibice bibonereye kugaragara mu maaso y'abantu ntaabwo bikeneye kwitaabwaho. Imaana yashize hamwe ibice by'umubiri, irushaho guha icuubahiro ibyo bice birebeka nkaaho bigayitse, <verse eid="1CO 12:24" /><verse number="25" style="v" sid="1CO 12:25" />kugira ngo umubiri utiiremamo ibice, ahuubwo kugira ngo ibice byose by'umubiri biteerane inkunga. <verse eid="1CO 12:25" /><verse number="26" style="v" sid="1CO 12:26" />Igice c'umubiri iyo kibabaye, ibindi bice by'umubiri bibabarana na co, kandi iyo igice c'umubiri gihaawe icuubahiro, ibindi bice na byo byishiimana na co.<verse eid="1CO 12:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="1CO 12:27" />Nuuko reero mwese muri umubiri wa Kristo, kandi buri umwe ni igice c'uwo mubiri. <verse eid="1CO 12:27" /><verse number="28" style="v" sid="1CO 12:28" /><note caller="-" style="x"><char style="xo" closed="false">12:28 </char><char style="xt" closed="false"><ref loc="EPH 4:11">Efe 4:11</ref>.</char></note>Dore abo Imaana yashizeho mu toorero ryayo, yabanje gushiraho intumwa, ikurikizaho abahanuuzi, ubwa gatatu ishiraho abiigiisha, haanyuma ishiraho abo gukora ibitangaaza, ikurikizaho abafite impaano zo gukiza indwara cangwa zo gufasha abandi, abaahaawe ubuyobozi, n'abo baahaawe kuvuga mu zindi indimi zitandukanye. <verse eid="1CO 12:28" /><verse number="29" style="v" sid="1CO 12:29" />Mbese boose ni ko ari intumwa? Mbese boose ni ko ari abahanuuzi? Mbese ni ko boose ari abiigiisha? Mbese ni ko boose bakora ibitangaaza? <verse eid="1CO 12:29" /><verse number="30" style="v" sid="1CO 12:30" />Mbese ni ko boose bafite impaano yo gukiza abarwayi? Mbese ni ko boose bavuga mu ndimi zitandukanye? Mbese ni ko boose baazi gusobaanura izo ndimi? <verse eid="1CO 12:30" /><verse number="31" style="v" sid="1CO 12:31" />Nuuko reero nimuharanire impaano ziruta izindi.</para>
  <para style="p" vid="1CO 12:31">Maze nanje nzaabeereka inzira nziiza ihebuuje.<verse eid="1CO 12:31" /></para>
  <chapter eid="1CO 12" />
  <chapter number="13" style="c" sid="1CO 13" />
  <para style="s">Impaano y'Urukundo</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 13:1" />Nuubwo navuga mu ndimi z'abantu n'iz'abaamalayika, ariko singire urukundo, naaba meze nk'ikide kibomborana cangwa inzogera ziirangiira. <verse eid="1CO 13:1" /><verse number="2" style="v" sid="1CO 13:2" /><note caller="-" style="x"><char style="xo" closed="false">13:2 </char><char style="xt" closed="false"><ref loc="MAT 17:20">Mat 17:20</ref>; <ref loc="MAT 21:21">21:21</ref>; <ref loc="MRK 11:23">Mar 11:23</ref>.</char></note>Kandi nuubwo nagira impaano y'ubuhanuuzi, ngasobaanukirwa amayobera yoose n'ubumenyi bwose, kandi nuubwo nagira ukwizeera gukomeye, kwashobora kwimura imisozi, ariko singire urukundo, ntaaco mba ndi co. <verse eid="1CO 13:2" /><verse number="3" style="v" sid="1CO 13:3" />Nuubwo naatanga ibyanje byose ngo bihaabwe abakene, kandi nuubwo naatanga umubiri wanje ngo utwikwe,<note caller="+" style="f"><char style="fr" closed="false">13:3 </char><char style="ft" closed="false">Ibindi byanditswe, bivuga ngo, </char><char style="fqa" closed="false">kugira ngo niraate </char></note> ariko singire urukundo, ntaaco byamarira.<verse eid="1CO 13:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="1CO 13:4" />Urukundo ruriihangaana, urukundo rugira neeza, urukundo ntirugira ishari, urukundo ntirwiraariira cangwa ngo rwikuririze. <verse eid="1CO 13:4" /><verse number="5" style="v" sid="1CO 13:5" />Urukundo ntirukoza isoni, ntirushaaka ibyarwo, ntiruraakara, ntirugira inziika, <verse eid="1CO 13:5" /><verse number="6" style="v" sid="1CO 13:6" />ntirwishiimira gukora ibibi, ahuubwo rwishiimira ukuri. <verse eid="1CO 13:6" /><verse number="7" style="v" sid="1CO 13:7" />Urukundo rwihangaanira byose, rwemera byose, rwiringira byose kandi rutwihangaanisha muri byose.<verse eid="1CO 13:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1CO 13:8" />Guhanuura kuzaashira, kuvuga indimi zitandukanye bizaashira, ubwenge buzaagira iherezo, ariko urukundo ntiruzaashira. <verse eid="1CO 13:8" /><verse number="9" style="v" sid="1CO 13:9" />Koko reero ubwenge bwacu ntibwuzuye kandi duhanuura ibituuzuye. <verse eid="1CO 13:9" /><verse number="10" style="v" sid="1CO 13:10" />Ariko igihe ibyuzuye kandi bitunganye bizaazira, ibituuzuye bidatunganye bizaashira.<verse eid="1CO 13:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="1CO 13:11" />Nkiri umwana, navugaga nk'umwana, ngateekereza nk'umwana, kandi nkiibwira nk'umwana. Ariko maze gukura, iby'ubwana narabiretse. <verse eid="1CO 13:11" /><verse number="12" style="v" sid="1CO 13:12" />Ibyo tureeba ubu bimeze nk'ibikeezikeezi biboneka mu ndorerwamo, ariko ico gihe tuzaareebana amaaso ku yandi. Ubu ibyo nzi ni ibice, ariko ico gihe nzaamenya ibyuzuye, nk'uko Imaana inzi mu bwuzuye.<verse eid="1CO 13:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="1CO 13:13" />Noone ubu reero hasigaye ibi uko ari bitatu: Ukwizeera, ibyiringiro n'urukudo, ariko ikiruta byose ni urukundo.<verse eid="1CO 13:13" /></para>
  <chapter eid="1CO 13" />
  <chapter number="14" style="c" sid="1CO 14" />
  <para style="s">Impaano z'Umwuka Weera</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 14:1" />Nimuharanire urukundo kandi mushiishikarire kugira impaano z'Umwuka, na caane impaano yo kwamamaza ubutumwa bw'Imaana. <verse eid="1CO 14:1" /><verse number="2" style="v" sid="1CO 14:2" />Abavuga mu ndimi zidasobaanutse ntaabwo baba babwira abantu, ahuubwo baba babwira Imaana. Ntaawumva ibyo bavuga kuko baba bavuga amabanga bayobowe n'Umwuka. <verse eid="1CO 14:2" /><verse number="3" style="v" sid="1CO 14:3" />Ariko abahanuura baba babwira abantu ibyo kubafasha, kubakomeza no kubahuumuriza. <verse eid="1CO 14:3" /><verse number="4" style="v" sid="1CO 14:4" />Abavuga mu ndimi zidasobaanutse ni bo biyungura ubwabo, ariko abavuga ijambo ry'ubuhanuuzi bungura itoorero ryose.<verse eid="1CO 14:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="1CO 14:5" />Naakwifuuza ko mwese muvuga mu ndimi zidasobaanutse, ariko caane caane naakunda yuuko mwahanuura. Uhanuura arusha agaciiro uvuga mu ndimi zidasobaanutse, keretse hagize ushobora kuzisobaanura kugira ngo zifashe itoorero. <verse eid="1CO 14:5" /><verse number="6" style="v" sid="1CO 14:6" />Noone se bavandimwe, ndamutse nje iwaanyu nkivugira mu ndimi zidasobaanutse, naaba mbafashije iki? Ntaaco mba mbafashije keretse mbabwiye ibyo Imaana yampishuuriye, cangwa ubumenyi, ubuhanuuzi n'inyigiisho bikomooka ku Maana.<verse eid="1CO 14:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="1CO 14:7" />Ni co kimwe n'ibiririmbiisho bitagira ubuzima nk'umwirenge cangwa inanga. Wabwirwa n'iki ikivuzwa cangwa igicurangwa, udatandukanyije amajwi yabyo? <verse eid="1CO 14:7" /><verse number="8" style="v" sid="1CO 14:8" />Kandi impanda na yo ivugijwe ijwi ridasobaanutse, ni nde wakwiteguurira urugamba? <verse eid="1CO 14:8" /><verse number="9" style="v" sid="1CO 14:9" />Namwe reero ni uko. Umuntu yaasobaanukirwa ate ibyo muvuga kandi indimi mukoreesha zidasobaanura amagambo? Amagambo yaanyu azaaba abaaye impfaabusa. <verse eid="1CO 14:9" /><verse number="10" style="v" sid="1CO 14:10" />Ku isi hariho indimi nyinshi, kandi ntaanarumwe rudafite ico rusobaanura. <verse eid="1CO 14:10" /><verse number="11" style="v" sid="1CO 14:11" />Ariko reero hagize umbwira amagambo ntasobaanukiwe muri urwo rurimi ruvugwa, uruvuga aba ambeereye umunyamahanga kandi nanje nkaba mubeereye umunyamahanga. <verse eid="1CO 14:11" /><verse number="12" style="v" sid="1CO 14:12" />Noone reero ubwo muharanira kugira impaano z'Umwuka, mwibande na caane kuri izo zaabafasha kuzaamuura itoorero.<verse eid="1CO 14:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="1CO 14:13" />Noone reero umuntu uvuga mu ndimi zidasobaanutse, akwiriye no gusaba Imaana impaano yo gusobaanura ibyo yavuze. <verse eid="1CO 14:13" /><verse number="14" style="v" sid="1CO 14:14" />Kuko iyo nsenga mu ndimi zidasobaanutse, umutima wanje uba usenga ariko ubwenge bwanje ntibugire ico bumara. <verse eid="1CO 14:14" /><verse number="15" style="v" sid="1CO 14:15" />Noone se niiba bimeze bityo, nkore iki? Nzaaja nsengera mu mutima, ubundi kandi nsengane ubwenge. Nzaaririmbira indirimbo z'ishimwe mu mutima kandi nongere ndirimbane ubwenge. <verse eid="1CO 14:15" /><verse number="16" style="v" sid="1CO 14:16" />Mbese uramutse ushiimiye Imaana mu mutima gusa, umuntu w'iruhande udasobaanukiwe yaashobora ate gusubiza ati, “Amiina” ku sengeesho ryo atumviise, kandi atumva ico uvuga? <verse eid="1CO 14:16" /><verse number="17" style="v" sid="1CO 14:17" />Ushobora gushiima neeza caane, ariko abandi bantu ntihagire ico bunguka.<verse eid="1CO 14:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="1CO 14:18" />Ndashiimira Imaana kuko mwese mbarusha kuvuga mu ndimi zidasobaanutse, <verse eid="1CO 14:18" /><verse number="19" style="v" sid="1CO 14:19" />ariko ndi mu masengeesho yo mu ikoraniro, naavuga amagambo ataanu yoonyine asobaanutse kugira ngo niigiishe abandi, aho kuvuga amagambo menshi mu ndimi zidasobaanutse.<verse eid="1CO 14:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="1CO 14:20" />Bavandimwe, ntimugateekereze nk'abaana bato, ariko mu byerekeye gukora icaaha, mugomba kuba intungaane nk'abaana naho mu miteekerereze, muje mugenza nk'abantu bakuru. <verse eid="1CO 14:20" /><verse number="21" style="v" sid="1CO 14:21" />Mu gitabo c'amategeko handitswe ngo,</para>
  <para style="q1" vid="1CO 14:21">“Nzaakoreesha abantu bavuga indimi zidasobaanutse</para>
  <para style="q2" vid="1CO 14:21">mukubwira abantu banje, uwo ni Nyagasani ubivuze.</para>
  <para style="q1" vid="1CO 14:21">Nzaababwira nkoreesheje akanwa k'abanyamahanga,</para>
  <para style="q2" vid="1CO 14:21">ariko nabwo abantu banje ntibazanyumvira.”<verse eid="1CO 14:21" /></para>
  <para style="m">
    <verse number="22" style="v" sid="1CO 14:22" />Noone reero, impaano yo kuvuga mu ndimi zidasobaanutse ntaabwo ari ikimenyeetso c'abeemera ahuubwo ni ic'abateemera, naho impaano yo guhanuura ntaabwo ari ikimenyeetso c'abateemera, ahuubwo n'ikimenyeetso c'abeemera.<verse eid="1CO 14:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="1CO 14:23" />Noone se abeemera boose bateeraniye hamwe maze hakagira abatangira kuvuga mu ndimi zidasobaanutse nuuko hakinjira umuntu udasobaanukiwe cangwa utiizeera, ntiyavuga ati muri abasazi? <verse eid="1CO 14:23" /><verse number="24" style="v" sid="1CO 14:24" />Ariko hagize umuntu udasobaanukiwe cangwa utiizeera winjira maze agasanga buri muntu ahanuura, yakwishinja ibyaha bye ku bw'ibyo yumva. <verse eid="1CO 14:24" /><verse number="25" style="v" sid="1CO 14:25" />Nyuma yuuko amabanga ahishwe mu mutima y'utiizeera ashizwe ahagaragara, azaapfukama imbere y'Imaana maze ayiramye avuga ati, “Ni ukuri koko Imaana iri muri mwe!”<verse eid="1CO 14:25" /></para>
  <para style="s">Ibyo Gukurikiza mu Matoorero</para>
  <para style="p">
    <verse number="26" style="v" sid="1CO 14:26" />Noone se bavandimwe dukore iki? Igihe muteeraniye hamwe, umwe ashobora kuyobora indirimbo, undi akiigiisha, undi agatangaaza ibyo yahishuuriwe, undi akavuga mu ndimi zidasobaanutse, kandi undi agasobaanura ibyavuzwe. Nuuko reero byose muje mubikora mu kungura itoorero. <verse eid="1CO 14:26" /><verse number="27" style="v" sid="1CO 14:27" />Niiba hariho abavuga mu ndimi zidasobanutse, havuge babiri cangwa batatu gusa kandi havuge umwe umwe, nuuko habeho n'uwo kuzisobaanura. <verse eid="1CO 14:27" /><verse number="28" style="v" sid="1CO 14:28" />Kandi niiba hatariho uwo gusobaanura izo ndimi, uvugira mu ndimi zidasobaanutse akwiriye guceceka akavugira mu mutima we kandi akavugana n'Imaana. <verse eid="1CO 14:28" /><verse number="29" style="v" sid="1CO 14:29" />Abahanuuzi babiri cangwa batatu na bo bavuge, maze abandi basuuzume ibyo bavuga. <verse eid="1CO 14:29" /><verse number="30" style="v" sid="1CO 14:30" />Ariko hagize umuntu wiicaye mu iteeraniro akagira ico ahishuurirwa, uwavugaga akwiriye kuba arekeye aho. <verse eid="1CO 14:30" /><verse number="31" style="v" sid="1CO 14:31" />Kuko mwese mushobora guhanuura habanje umwe hagakurikiraho undi, kugira ngo boose biige kandi bibakomeze. <verse eid="1CO 14:31" /><verse number="32" style="v" sid="1CO 14:32" />Impaano y'Umwuka w'ubuhanuuzi ikwiriye kugengwa n'uvuga ubwo buhanuuzi, <verse eid="1CO 14:32" /><verse number="33" style="v" sid="1CO 14:33" />kuko Imaana itari Imaana y'akajagaari, ahuubwo ni iy'amahoro.</para>
  <para style="p" vid="1CO 14:33">Nk'uko bimeze mu matoorero yoose y'abantu b'Imaana, <verse eid="1CO 14:33" /><verse number="34" style="v" sid="1CO 14:34" />abagore bagomba guceceka, kuko bateemerewe kuvuga, ahuubwo beemere gutegekwa nk'uko amategeko y'Abayuuda abivuga. <verse eid="1CO 14:34" /><verse number="35" style="v" sid="1CO 14:35" />Baramutse hari ico biifuuza kumenya, baje babariza abagabo mu rugo, kuko biteeye isoni ko umugore avugira mu iteeraniro.<verse eid="1CO 14:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="1CO 14:36" />Mbese ijambo ry'Imaana rikomooka kuri mwe? Cangwa se ni mwe mwenyine ryagejejweho? <verse eid="1CO 14:36" /><verse number="37" style="v" sid="1CO 14:37" />Umuntu weese wiibwira ko ari umuhanuuzi, cangwa se ko afite imbaraga z'Umwuka, niyemere ko ibyo mbandikiye ari itegeko rya Nyagasani. <verse eid="1CO 14:37" /><verse number="38" style="v" sid="1CO 14:38" />Ariko naataryemera, na mwe ntimukamwiteho.<verse eid="1CO 14:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="1CO 14:39" />Noone reero bavandimwe, nimuharanire kubwiriza ubutumwa bw'Imaana, ariko ntimubuze abiizeera kuvuga mu ndimi zidasobaanutse. <verse eid="1CO 14:39" /><verse number="40" style="v" sid="1CO 14:40" />Mugomba gukora byose neeza mu buryo bukwiriye.<verse eid="1CO 14:40" /></para>
  <chapter eid="1CO 14" />
  <chapter number="15" style="c" sid="1CO 15" />
  <para style="s">Kuzuuka kwa Kristo</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 15:1" />Bavandimwe, ndashaaka kubiibutsa iby'Inkuru Nziiza nababwirije, maze mukayaakiira mukanayikomereramo, <verse eid="1CO 15:1" /><verse number="2" style="v" sid="1CO 15:2" />ikaba ari na yo izaabakiza muramutse muyikomeje nk'uko nayibabwirije, keretse ukwizeera kwanyu kuramutse kwarabaaye imfaabusa.<verse eid="1CO 15:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="1CO 15:3" />Koko reero nabagejejeho ico nanje nahaawe, ari co c'ingenzi, yuuko Kristo yapfiiriye ibyaha byacu nk'uko byari byaranditswe, <verse eid="1CO 15:3" /><verse number="4" style="v" sid="1CO 15:4" /><note caller="-" style="x"><char style="xo" closed="false">15:4 </char><char style="xt" closed="false"><ref loc="MAT 12:40">Mat 12:40</ref>; <ref loc="ACT 2:24-32">Iby 2:24-32</ref>.</char></note>kandi ko yahambwe maze ku munsi wa gatatu akazuuka nk'uko byari byaranditswe na noone, <verse eid="1CO 15:4" /><verse number="5" style="v" sid="1CO 15:5" /><note caller="-" style="x"><char style="xo" closed="false">15:5 a </char><char style="xt" closed="false"><ref loc="LUK 24:34">Luk 24:34</ref>; </char><char style="xo" closed="false">b </char><char style="xt" closed="false"><ref loc="MAT 28:16">Mat 28:16</ref>,<ref loc="MAT 28:17">17</ref>; <ref loc="MRK 16:14">Mar 16:14</ref>; <ref loc="LUK 24:36">Luk 24:36</ref>; <ref loc="JHN 20:19">Yoh 20:19</ref>.</char></note>kandi yuuko yabonekeye Peetero, haanyuma abonekera na za ntumwa cumi n'ebyiri. <verse eid="1CO 15:5" /><verse number="6" style="v" sid="1CO 15:6" />Haanyuma yongeye kubonekera abavandimwe basaaga magana ataanu icaarimwe, kandi abenshi muri bo baracaariho ariko bamwe baarapfuuye. <verse eid="1CO 15:6" /><verse number="7" style="v" sid="1CO 15:7" />Maze yabonekeye na Yaakobo, nyuma abonekera intumwa zoose.<verse eid="1CO 15:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1CO 15:8" />
    <note caller="-" style="x">
      <char style="xo" closed="false">15:8 </char>
      <char style="xt" closed="false">
        <ref loc="ACT 9:3-6">Iby 9:3-6</ref>.</char>
    </note>Nyuma ya byose, nanje arambonekera nuubwo meeze nk'uwavuukiye imburagihe. <verse eid="1CO 15:8" /><verse number="9" style="v" sid="1CO 15:9" /><note caller="-" style="x"><char style="xo" closed="false">15:9 </char><char style="xt" closed="false"><ref loc="ACT 8:3">Iby 8:3</ref>.</char></note>Kuko ndi uworoheje mu zindi ntumwa zoose, ndetse sinkwiriwe no kwitwa intumwa, kuko natooteje itoorero ry'Imaana. <verse eid="1CO 15:9" /><verse number="10" style="v" sid="1CO 15:10" />Ariko ku bw'ubuntu bw'Imaana, ni co caatumye mba uko ndi, kandi ubwo buntu nahaawe ntibwabaaye impfaabusa, ahuubwo nakoze caane kuruta boose, nuubwo atari ku bwanje ahuubwo ni ku bw'ubuntu bw'Imaana buri nanje. <verse eid="1CO 15:10" /><verse number="11" style="v" sid="1CO 15:11" />Uko biri koose, yaaba njeewe cangwa bo, ubwo ni bwo butumwa twamamaza kandi namwe ni bwo mwemeye.<verse eid="1CO 15:11" /></para>
  <para style="s">Izuuka ry'Abaapfuuye</para>
  <para style="p">
    <verse number="12" style="v" sid="1CO 15:12" />Ubwo haamamazwa ko Yesu yazuutse mu baapfuuye, bishoboka bite ko bamwe muri mwe bavuga ko abaapfuuye batazaazuuka? <verse eid="1CO 15:12" /><verse number="13" style="v" sid="1CO 15:13" />Niiba hatariho kuzuuka kw'abaapfuuye, noone reero na Kristo ntaabwo yazuutse, <verse eid="1CO 15:13" /><verse number="14" style="v" sid="1CO 15:14" />kandi niiba Kristo ataarazuutse, ubutumwa twamamaza no kwizeera Kristo kwanyu biba bibaaye ubusa. <verse eid="1CO 15:14" /><verse number="15" style="v" sid="1CO 15:15" />Kandi naatwe twagaragara nk'abahamya Imaana mu binyoma, kuko twahamije yuuko Imaana yazuuye Kristo kandi itaaramuzuuye niiba abaapfuuye batazaazuuka. <verse eid="1CO 15:15" /><verse number="16" style="v" sid="1CO 15:16" />Kuko niiba abaapfuuye batazuuka, noone reero na Kristo ntaabwo yazuutse. <verse eid="1CO 15:16" /><verse number="17" style="v" sid="1CO 15:17" />Niiba Imaana itaarazuuye Kristo, ukwizeera kwanyu muri Kristo ntikugira umumaro, mukaba mukiri mu byaha byanyu. <verse eid="1CO 15:17" /><verse number="18" style="v" sid="1CO 15:18" />Bityo reero n'abaapfiiriye muri Kristo baararimbutse. <verse eid="1CO 15:18" /><verse number="19" style="v" sid="1CO 15:19" />Niiba reero ibyiringiro byacu muri Kristo ari byiza muri ubu buzima gusa, twaba dukwiriye kugirirwa imbabazi kuruta abandi bantu boose.<verse eid="1CO 15:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="1CO 15:20" />Ariko mu by'ukuri, Kristo yazuutse mu baapfuuye, aba umuzuukambere mu baapfuuye. <verse eid="1CO 15:20" /><verse number="21" style="v" sid="1CO 15:21" />Nk'uko urupfu rwazanywe n'umuntu, ni ko no kuzuuka kw'abaapfuuye kwazanywe n'umuntu. <verse eid="1CO 15:21" /><verse number="22" style="v" sid="1CO 15:22" />Nk'uko boose baapfa biturutse kuri Adamu, ni na ko boose bazaazuuka mu baapfuuye biturutse kuri Kristo. <verse eid="1CO 15:22" /><verse number="23" style="v" sid="1CO 15:23" />Ariko buri umwe azaazuuka mu gihe ce, uwabanje kuzuuka ni Kristo maze haanyuma abaamuyobotse bazaakurikireho, igihe co azaazira. <verse eid="1CO 15:23" /><verse number="24" style="v" sid="1CO 15:24" />Nuuko hazaabaho imperuuka, Kristo atsembe ibinyabutware by'umwuka byose, ibinyabushobozi, n'ibinyabubaasha, maze yeegurire Imaana Daata Ubwami. <verse eid="1CO 15:24" /><verse number="25" style="v" sid="1CO 15:25" />Kuko Kristo akwiriye gutegeka kugeza aho Imaana izaatsinda abanzi boose ikabashira munsi y'ibirenge bye. <verse eid="1CO 15:25" /><verse number="26" style="v" sid="1CO 15:26" />Umwanzi uzaaheruuka gutsembwa ni urupfu. <verse eid="1CO 15:26" /><verse number="27" style="v" sid="1CO 15:27" />Kuko ibyanditswe biravuga ngo, “Imaana yashize ibintu byose munsi y'ibirenge bye.” Ariko iyo ivuga iti, “Byose bishizwe munsi y'ibirenge bye,” biragaragara yuuko Imaana yashize ibintu byose munsi y'ibirenge bya Kristo yo itabibariwemo. <verse eid="1CO 15:27" /><verse number="28" style="v" sid="1CO 15:28" />Igihe ibintu byose bizaaba bimaze kwegurirwa Kristo, ni bwo na we nk'Umwana w'Imaana aziiyegurira Imaana yamweguriye byose, kugira ngo itegeke abe byose muri boose.<verse eid="1CO 15:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="1CO 15:29" />Bitabaaye bityo, reka twibaze ku bantu babatirizwa abaapfuuye. Niiba koko abaapfuuye batazuuka nk'uko bamwe babivuga, ni iki gituma bababatirizwa? <verse eid="1CO 15:29" /><verse number="30" style="v" sid="1CO 15:30" />Kandi kuki naatwe ubwacu twishira mu kaaga buri gihe? <verse eid="1CO 15:30" /><verse number="31" style="v" sid="1CO 15:31" />Bavandimwe, buri munsi mpora mpanganye n'urupfu! Ibyo mbivuga ku bw'ishema mfite ku bwanyu kubwa Kristo Yesu Umwami waacu. <verse eid="1CO 15:31" /><verse number="32" style="v" sid="1CO 15:32" />Niiba naarakurikije ibyiringiro by'abantu nkarwana n'inyamaaswa zo muri Efeeso, byamariye iki? Ariko niiba abaapfuuye batazuuka, nidukurikize iby'abantu bavuga ngo, “Nimureke twiriire kandi twinywere, kuko ejo tuzaapfa.”<verse eid="1CO 15:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="1CO 15:33" />Ntihakagire ubayobya, kuko “Kubaana n'ababi byonoona ingeso nziiza.” <verse eid="1CO 15:33" /><verse number="34" style="v" sid="1CO 15:34" />Nimwisubireho mwifate uko bikwiriye, kandi mwekongera gukora ibyaha kuko bamwe muri mwe bataazi Imaana. Ibyo mbivugiye kubakoza isoni.<verse eid="1CO 15:34" /></para>
  <para style="s">Imibiri y'Abazaazuuka</para>
  <para style="p">
    <verse number="35" style="v" sid="1CO 15:35" />Ariko bamwe bazaabaza bati, “Mbese abaapfuuye bazaazuuka bate? Mbese bazaagira umubiri umeze ute?” <verse eid="1CO 15:35" /><verse number="36" style="v" sid="1CO 15:36" />Mbeega injiji! Ico ubibye ntigishobora kumera ngo kibe kizima kitabanje gupfa. <verse eid="1CO 15:36" /><verse number="37" style="v" sid="1CO 15:37" />Kandi ico ubiba ntigisa n'ikizeera haanyuma, ahuubwo ni akabuto gato, kaaba ak'ingano cangwa akandi kabuto koose. <verse eid="1CO 15:37" /><verse number="38" style="v" sid="1CO 15:38" />Nyuma Imaana iha ako kabuto ishusho yakageneye, buri rubuto iruha akamero yarugeneye.<verse eid="1CO 15:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="1CO 15:39" />Kandi n'imibiri y'ibinyabuzima ntaabwo yoose isa. Abantu bagira umubiri usa ukwawo, n'inyamaaswa zikagira umubiri usa ukwazo, inyoni hamwe n'isamaaki na zo bikaba uko.<verse eid="1CO 15:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="1CO 15:40" />Kandi hari ibyaremwe byo mu kireere n'ibindi byo ku isi, ariko ubwiza bw'ibyo mu kireere butandukanye n'ubwiza bw'ibyo ku isi. <verse eid="1CO 15:40" /><verse number="41" style="v" sid="1CO 15:41" />Izuuba rirabagirana ukwaryo, ukwezi kukarabagirana ukwako, n'inyenyeeri zikarabagirana ukwazo, ndetse n'inyenyeeri ubwazo ntizihwanyije kurabagirana.<verse eid="1CO 15:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="1CO 15:42" />No kuzuuuka kw'abaapfuuye ni ko kumeze. Iyo umubiri uhambwe urabora, ariko ukazaazuukira kudapfa. <verse eid="1CO 15:42" /><verse number="43" style="v" sid="1CO 15:43" />Ushirwa mu butaka usuuzuguritse, ariko ukazaazuukana ikuzo. Ushirwa mu butaka ufite intege nke, ariko ukazuukana imbaraga. <verse eid="1CO 15:43" /><verse number="44" style="v" sid="1CO 15:44" />Uhambwa ari umubiri ufatika, ukazuuka ari umubiri w'umwuka. Niiba hariho umubiri ufatika, hagomba reero no kubaho umubiri w'umwuka. <verse eid="1CO 15:44" /><verse number="45" style="v" sid="1CO 15:45" />Ni na ko ibyanditswe bivuga ngo, “Umuntu wa mbere, ari we Adamu yabaaye muzima”, naho Adamu wa nyuma ni umwuka utanga ubugingo. <verse eid="1CO 15:45" /><verse number="46" style="v" sid="1CO 15:46" />Ariko si umwuka ubanza, ahuubwo ni umubiri ufatika ubanza, maze hagakurikiraho umwuka. <verse eid="1CO 15:46" /><verse number="47" style="v" sid="1CO 15:47" />Umuntu wa mbere yavuuye mu butaka, kandi yaremwe mu butaka, naho umuntu wa kabiri yavuuye mu ijuru. <verse eid="1CO 15:47" /><verse number="48" style="v" sid="1CO 15:48" />Nk'uko uwaremwe mu butaka yabaaye, ni na ko ab'ubutaka bameze, kandi nk'uko uwavuuye mu ijuru ameze, ni na ko abaagenewe ijuru bazaaba. <verse eid="1CO 15:48" /><verse number="49" style="v" sid="1CO 15:49" />Kandi nk'uko twambaye ishusho y'umuntu waremwe mu butaka, ni na ko tuzambara ishusho y'umuntu waturutse mu ijuru.<verse eid="1CO 15:49" /></para>
  <para style="p">
    <verse number="50" style="v" sid="1CO 15:50" />Noone bavandimwe, ico nshaaka kuvuga ni iki, umuntu ntaabwo ashobora kuronka umurage w'Ubwami bw'Imaana ku bw'umubiri n'amaraso, kandi ibibora ntaabwo byaragwa ibitabora.<verse eid="1CO 15:50" /></para>
  <para style="p">
    <verse number="51" style="v" sid="1CO 15:51" />
    <note caller="-" style="x">
      <char style="xo" closed="false">15:51 </char>
      <char style="xt" closed="false">
        <ref loc="1TH 4:15-17">1Tes 4:15-17</ref>.</char>
    </note>Nimwumve mbamenere ibanga! Ntaabwo twese tuzaapfa, ahuubwo twese tuzaahindurwa ukundi, <verse eid="1CO 15:51" /><verse number="52" style="v" sid="1CO 15:52" />mu kaanya gato nk'ako guhumbya, ubwo impanda ya nyuma izaavuga. Kuko impanda izaavuga, maze abaapfuuye bazuurwe badafite imibiri ibora, maze naatwe duhindurwe ukundi. <verse eid="1CO 15:52" /><verse number="53" style="v" sid="1CO 15:53" />Kuko uyu mubiri ubora ukwiriye kwambikwa umubiri utabora, kandi uyu mubiri wagenewe gupfa ukwiriye kwambikwa umubiri utazaapfa. <verse eid="1CO 15:53" /><verse number="54" style="v" sid="1CO 15:54" />Noone reero igihe uyu mubiri wagenewe kubora uzambikwa utabora, kandi n'uyu mubiri ugenewe gupfa ukambikwa umubiri utazaapfa, ubwo ni bwo ibyanditswe bizuuzurizwa ngo, “Urupfu ruratsinzwe burundu.”<verse eid="1CO 15:54" /></para>
  <para style="q1">
    <verse number="55" style="v" sid="1CO 15:55" />“Wa rupfu we, gutsinda kwawe kuri he?</para>
  <para style="q1" vid="1CO 15:55">Wa rupfu we, urubuuri rwawe ruri he?”<verse eid="1CO 15:55" /></para>
  <para style="m">
    <verse number="56" style="v" sid="1CO 15:56" />Urubuuri rw'urupfu ni icaaha, kandi imbaraga z'icaaha ni amategeko. <verse eid="1CO 15:56" /><verse number="57" style="v" sid="1CO 15:57" />Ariko Imaana ishimwe, kuko iduha gutsinda ku bw'Umwami waacu Yesu Kristo.<verse eid="1CO 15:57" /></para>
  <para style="p">
    <verse number="58" style="v" sid="1CO 15:58" />Nuuko reero bakundwa, nimukomere, ntimuhungabane, kandi mukomeze gushiishikarira gukora umurimo wa Nyagasani, kuko muuzi neeza yuuko ntaaco muzaakorera Nyagasani kizaaba imfaabusa.<verse eid="1CO 15:58" /></para>
  <chapter eid="1CO 15" />
  <chapter number="16" style="c" sid="1CO 16" />
  <para style="s">Gusorooza Imfashanyo z'Abavandimwe</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 16:1" />
    <note caller="-" style="x">
      <char style="xo" closed="false">16:1 </char>
      <char style="xt" closed="false">
        <ref loc="ROM 15:25">Rom 15:25</ref>,<ref loc="ROM 15:26">26</ref>.</char>
    </note>Ku byerekeye gusorooza ishilingi zo gufasha abantu b'Imaana muri Yudeeya, mukurikize nk'uko nategetse amatoorero yo muri Galatiya. <verse eid="1CO 16:1" /><verse number="2" style="v" sid="1CO 16:2" />Ku munsi wa mbere wa buri cumweru, buri muntu aje abiika ico yaashobora gusaagura ku byo yungutse, kugira ngo igihe nzaazira ataba ari ho mutangira gusorooza imfashanyo. <verse eid="1CO 16:2" /><verse number="3" style="v" sid="1CO 16:3" />Ningera iyo, nzaaha inzaandiko abantu bo muzaaba mwihitiyemo, bajaane imfashanyo zaanyu i Yerusaalemu. <verse eid="1CO 16:3" /><verse number="4" style="v" sid="1CO 16:4" />Kandi bibaaye ngombwa ko nanje ngenda, tuzaafatanya urugendo.<verse eid="1CO 16:4" /></para>
  <para style="s">Imigambi ya Pawulo</para>
  <para style="p">
    <verse number="5" style="v" sid="1CO 16:5" />
    <note caller="-" style="x">
      <char style="xo" closed="false">16:5 </char>
      <char style="xt" closed="false">
        <ref loc="ACT 19:21">Iby 19:21</ref>.</char>
    </note>Nzaabasuura maze kunyura muri Makedooniya kuko mfite umugambi wo kuyinyuramo, <verse eid="1CO 16:5" /><verse number="6" style="v" sid="1CO 16:6" />kandi ubundi ahaari nzaamarana namwe iminsi ndetse nkaba naahamara n'iminsi y'igihe c'imbeho, kugira ngo mumfashe gukomeza urugendo rwanje aho nzaaja hoose. <verse eid="1CO 16:6" /><verse number="7" style="v" sid="1CO 16:7" />Sinshaaka kubabonaho gato ngo nkomeze urugendo, kuko nizeeye kuzaamarana namwe iminsi, Nyagasani naabishaaka.<verse eid="1CO 16:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1CO 16:8" />
    <note caller="-" style="x">
      <char style="xo" closed="false">16:8 </char>
      <char style="xt" closed="false">
        <ref loc="ACT 19:8-10">Iby 19:8-10</ref>.</char>
    </note>Ariko nzaaguma muri Efeeso kugeza ku munsi wa Pentekooti, <verse eid="1CO 16:8" /><verse number="9" style="v" sid="1CO 16:9" />kuko nuugururiwe irembo kugira ngo mpakorere umurimo w'ingirakamaro, nuubwo hariyo abandwanya benshi.<verse eid="1CO 16:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="1CO 16:10" />
    <note caller="-" style="x">
      <char style="xo" closed="false">16:10 </char>
      <char style="xt" closed="false">
        <ref loc="1CO 4:17">1 Kor 4:17</ref>.</char>
    </note>Timoteeyo aramutse aje, mureebe ngo mumwakiiranye urugwiro kugira ngo abaane namwe adatiinya, kuko akora umurimo wa Nyagasani nkanje. <verse eid="1CO 16:10" /><verse number="11" style="v" sid="1CO 16:11" />Nuuko reero ntihazaagire umusuuzugura, ahuubwo muzaamufashe gukomeza urugendo rwe mu mahoro, kugira ngo angereho, kuko mutegereje we n'abandi bavandimwe.<verse eid="1CO 16:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="1CO 16:12" />Ku byerekeye umuvandimwe waacu Apolo, naramwinginze ngo azane n'abandi bavandimwe iwaanyu, ariko ntaabwo yabikunze na hato, nyamara naabona uburyo, azaaza.<verse eid="1CO 16:12" /></para>
  <para style="s">Amabwiriza ya Nyuma</para>
  <para style="p">
    <verse number="13" style="v" sid="1CO 16:13" />Murabe maaso, mukomerere mu kwizeera, mube intwari kandi mukomere. <verse eid="1CO 16:13" /><verse number="14" style="v" sid="1CO 16:14" />Ibyo mukora byose mubikorane urukundo.<verse eid="1CO 16:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="1CO 16:15" />
    <note caller="-" style="x">
      <char style="xo" closed="false">16:15 </char>
      <char style="xt" closed="false">
        <ref loc="1CO 1:16">1 Kor 1:16</ref>.</char>
    </note>Ikindi bavandimwe, muuzi neeza yuuko Siteefaano n'ab'urugo rwe ari bo baabanjirije abandi bo muri Akaya kwemera Kristo, kandi bakaba baariitangiye gufasha abantu b'Imaana. <verse eid="1CO 16:15" /><verse number="16" style="v" sid="1CO 16:16" />Ndabinginze ngo mwemere kuyoborwa n'abantu nk'abo, hamwe n'abandi boose bafatanyije na bo imirimo n'imiruho.<verse eid="1CO 16:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="1CO 16:17" />Neejeejwe n'uko Siteefaano na Forotunato na Akayiku baaje hano, bagakora ico mwajaga kunkorera iyo muhaba, <verse eid="1CO 16:17" /><verse number="18" style="v" sid="1CO 16:18" />kuko baruhuuye umutima wanje ndetse n'uwanyu. Nuuko muje mushiimira abantu nk'abo ibyo baakoze.<verse eid="1CO 16:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="1CO 16:19" />
    <note caller="-" style="x">
      <char style="xo" closed="false">16:19 </char>
      <char style="xt" closed="false">
        <ref loc="ACT 18:2">Iby 18:2</ref>.</char>
    </note>Amatoorero yo muri Asiya arabaramutsa. Akwila na Purisika, hamwe n'itoorero riteeranira mu rugo rwabo, barabataasha caane muri Nyagasani. <verse eid="1CO 16:19" /><verse number="20" style="v" sid="1CO 16:20" />Abavandimwe boose barabataasha.</para>
  <para style="p" vid="1CO 16:20">Namwe reero muramukanye mu buryo bwa gikristo.<verse eid="1CO 16:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="1CO 16:21" />Njeewe Pawulo, ni nje wiyandikiye iyi ndamutso.<verse eid="1CO 16:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="1CO 16:22" />Nihagira umuntu udakunda Nyagasani, avumwe.</para>
  <para style="p" vid="1CO 16:22">Ngwino Mwami waacu.<verse eid="1CO 16:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="1CO 16:23" />Ubuntu bwa Nyagasani Yesu, bubaane namwe.<verse eid="1CO 16:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="1CO 16:24" />Urukundo rwanje rubaane namwe mwese ku bwa Kristo Yesu.<verse eid="1CO 16:24" /></para>
  <chapter eid="1CO 16" />
</usx>