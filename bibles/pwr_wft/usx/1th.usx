<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="1TH" style="id">- Powari Standard Project</book>
  <para style="h">1 थिस्सलुनीकियो</para>
  <para style="toc3">1 थिस्सलुनीकियो</para>
  <para style="toc2">1 थिस्सलुनीकियो</para>
  <para style="toc1">थिस्सलुनीकियो को नाव पौलुस को पहेलो चिठ्ठी</para>
  <para style="mt2">थिस्सलुनीकियो के नाम पौलुस का प्रथम पत्र</para>
  <para style="mt1">थिस्सलुनीकियो को नाव पौलुस को पहेलो चिठ्ठी</para>
  <para style="imt">परिचय</para>
  <para style="ip">थिस्सलुनीकियों की पहिली चिठ्ठी पेरीत पौलुस न <char style="xt"><ref loc="1TH 1:1">1:1</ref></char> लिख्यो होतो। पहिले पवितर गीरंथ को हिस्सा बन्यो अखिन मसीह को जलम को 51 साल बाद लिख्यो गयो, जब पौलुस न चिठ्ठी लिख्यो तब ऊ कुरिन्थियों सहर मा होतो थिस्सलुनीकियों की कलीसिया जेनला ओना चिठ्ठी लिख्यो दूसरों मिसनरी यातरा को बीचमा स्थापित करयो गयी होती, <char style="xt"><ref loc="ACT 17:1-10">पेरीत 17:1-10</ref></char> पेरीत को किताब मा असो सांगयो से का यो कलिसीया यहूदिगीन अखिन गैरयहुदी को बनयो होती।</para>
  <para style="ip">यो कलीसिया को स्थापना करन को बाद पौलुस थिस्सलुनीकियों मा जादा दिवस तकन रुक नहीं सक्यो। येकोलायी ओना यो चिठ्ठी ला जोस दिलान को लाय लिख्यो, या चिठ्ठी मा लगत बिसय को बारेमा चरचा करयो गयो से, जसो का मसीही गीनला कसो रहनो पाहिजे। पौलुस मसीह को दूसरों आवन तकन को बारे मा लिख्यो से, साइद येकोलायी की थिस्सलुनीकियों को कलीसिया मा रव्हन वालो बिस्वासी गिनला आयकवानो को लाय लगत जोस मा होतो, पौलुस यो बिसय लक यीसु को दूसरों आवनो को बारेमा लिखके उनला असो जीवन को लायी बढावा देवासे जोनलक परमेस्वर खुस होहेत। <char style="xt"><ref loc="1TH 5:6-8">5:6-8</ref></char></para>
  <para style="iot">रुपरेखा</para>
  <para style="io1">1. कलीसिया ला नमस्कार अखीन परमेस्वर ला धन्यवाद। <char style="ior"><ref loc="1TH 1">1</ref></char></para>
  <para style="io1">2. पौलुस आपरो काम को बारे मा अखीन तीमुथियुस ना जोन खबर लायो होतो ओको बारेमा चरचा करयो। <char style="ior"><ref loc="1TH 2-3">2—3</ref></char></para>
  <para style="io1">3. यीसु को दूबारा आवनो को तैयारी करन को लाय मसीही मा कसो जीवन जीवनो पाहिजे। <char style="ior"><ref loc="1TH 4:1-5:15">4:1—5:15</ref> </char></para>
  <para style="io1">4. पौलुस को कलिसीया मा नमस्कार हर एक न ओको चिठ्ठी बाचनो पाहिजे, येको बारेमा सुचना। <char style="ior"><ref loc="1TH 5:16-28">5:16-28</ref></char></para>
  <chapter number="1" style="c" sid="1TH 1"/>
  <para style="s">अभिवादन</para>
  <para style="p">
    <verse number="1" style="v" sid="1TH 1:1"/>हमरो बाप परमेस्वर अना पिरभू<note caller="+" style="f"><char style="fr" closed="false">1:1 </char><char style="ft" closed="false">परमेस्वर का बेटा</char></note> यीसु मसीह मा थिस्सलुनीकिया नगर को कलीसिया को नाव पौलुस सिलवानुस अखीन तीमुथियुस ला चिठ्ठी मा</para>
  <para style="p" vid="1TH 1:1">किरपा अखीन सान्ती मिलहेत।<verse eid="1TH 1:1"/></para>
  <para style="s">थिस्सलुनीकिया को भरोसा को उदाहरन</para>
  <para style="p">
    <verse number="2" style="v" sid="1TH 1:2"/>जबा-जबा आमी तुमी लोकगीन ला आपरी पिराथना<note caller="+" style="f"><char style="fr" closed="false">1:2</char><char style="ft" closed="false">बिनती</char></note> मा हेत करतो हुयो परमेस्वर को धनबाद करसेजन। <verse eid="1TH 1:2"/><verse number="3" style="v" sid="1TH 1:3"/>तुमरो बिस्वास को काम अना माया को मेहनत अना आमरो पिरभु यीसु मसीह मा भरोसा अना धिरज को आस आपरो परमेस्वर अना बाबूजी को पुढ़ा सदा हेत करासेजन। <verse eid="1TH 1:3"/><verse number="4" style="v" sid="1TH 1:4"/>अगा भाऊ हुन अना बहिनीहिन हमी जानासेजन का परमेस्वर तुमला पिरेम करासे अना परमेस्वर न तुमला ओको होवन को साठी बेचीसेस। <verse eid="1TH 1:4"/><verse number="5" style="v" sid="1TH 1:5"/>काहेकी हमीना निरो गोस्टी लक नही पर ताकत अना पवीतर आतमा अखीन पिक्को बिस्वास को संग तुमी लोकगीन को बीच मा साजरो बारता को पिरचार करीया तुमी जानासेव का तुमरो कल्यान को लाई, तुमरो बीच मा हमरो सुभाव कसो होतो। <verse eid="1TH 1:5"/><verse number="6" style="v" sid="1TH 1:6"/>तुमी न अमरो, अना पिरभू को मंघा होयके मोठी आफत को सामना करता हुयो, पवीतर आतमा की हेत करके खुसी लक साजरी बारता ला मानयात। <verse eid="1TH 1:6"/><verse number="7" style="v" sid="1TH 1:7"/>ऐना रिति लक तुमी मकीदुनिया परदेस अखया अना यूनान देस को सबच भरोसा गीन लाई नमुना बन गयत। <verse eid="1TH 1:7"/><verse number="8" style="v" sid="1TH 1:8"/>तुमरो यहान लक पिरभू की खबर नही पर मकीदुनिया अखया अना यूनान मा बगर गई अना परमेस्वर मा तुमरो भरोसा की गोस्टी सदा होय रही से, तबा हमला कव्हनो को जघा ना हती। <verse eid="1TH 1:8"/><verse number="9" style="v" sid="1TH 1:9"/>लोक खुदच हमला सांग सेत का तुमरो कन हमरो कसो मान भाव भयो अखीन तुमी कोनो पिरकार देव-मुरती ला छोड़के परमेस्वर को कन फिरयो सेव जेनको लक तुमी खरो अना जित्तो परमेस्वर को सेवा मा बनीसेव। <verse eid="1TH 1:9"/><verse number="10" style="v" sid="1TH 1:10"/>अखीन वोको टूरा यीसु<note caller="+" style="f"><char style="fr" closed="false">1:10 </char><char style="ft" closed="false">परमेस्वर के बेटे का नाव</char></note> की सरग लक आवनो की “बाट देखासेव,” जेनला परमेस्वर न मरयो मा लक जित्तो करीस। मजे यीसु ला, जोन आमीला आवन वालो कोप लक बचाव से।<verse eid="1TH 1:10"/></para>
  <chapter eid="1TH 1"/>
  <chapter number="2" style="c" sid="1TH 2"/>
  <para style="s">थिस्सुलुनिकिया नगर मा पौलुस को सेवा को काम</para>
  <para style="p">
    <verse number="1" style="v" sid="1TH 2:1"/>भाऊ गीन तुमी खुदच जानासेव का आमरो तुमरो जवर आवनो बेकार नही भयो। <verse eid="1TH 2:1"/><verse number="2" style="v" sid="1TH 2:2"/>पर तुमी त जानासेव का फिलिप्पी मा दुख उचलनो अना बुरो बरताव सह्वनो को मंघा भी हमी अपरो परमेस्वर मा असी हिम्मत पायके, घोर बिरोध को होतो हुयो भी तुमला परमेस्वर की साजरो बारता आयकावाया। <verse eid="1TH 2:2"/><verse number="3" style="v" sid="1TH 2:3"/>काहेकी आमरो सिक्सा न त भरम लक, न ता “खोटो करम” अना न ता छल को संग से। <verse eid="1TH 2:3"/><verse number="4" style="v" sid="1TH 2:4"/>परमेस्वर न अपरी साजरो बारता सोपन को लाई हमला काबील समझीस की हमी मानूस गीन ला नही पर हिरदय ला परख लाई परमेस्वर पर भरोसा करन लाई पिरचार करासेजन। <verse eid="1TH 2:4"/><verse number="5" style="v" sid="1TH 2:5"/>जसो का तुमी जानलेईसेव, हमीना त कभीच तुमला “एक हात ककड़ी अना नौ हात बीजा” नही करया सेजन। ना लोभ लाई कोनी बहाना बनाया, परमेस्वर हमरो गवाह से। <verse eid="1TH 2:5"/><verse number="6" style="v" sid="1TH 2:6"/>मंग भी हमी मानूस लक मान-मरयादा नही चाव्हत होता, जसो की तुमी लक या कोनी अखीन लक। <verse eid="1TH 2:6"/><verse number="7" style="v" sid="1TH 2:7"/>आमी यीसु मसीह को पेरीत होवन को साठी आमी तुमरो वरता हक जमाय सकता, पर आमी ना तुमरो संग नरमी लक पेस भयो, जसो एक दुध पीवावन वालो माय अपरो लेकरागीन को पाल-पोस के नरम रुप लक पेस आवासे। <verse eid="1TH 2:7"/><verse number="8" style="v" sid="1TH 2:8"/>यो रिती लक तुमरो लाई ममता होवनो को कारन हमला खुसी भई, का न केवल तुमला परमेस्वर को साजरो बारता आयकावाया पर तुमरो लाई अपरो पिरयान गीन ला भी दे दियासेजन। काहेकी तुमी हमारो लाई लगत माया को होय गयासेव। <verse eid="1TH 2:8"/><verse number="9" style="v" sid="1TH 2:9"/>भाऊ गीन तुमी हमारो महेनत अना दुख महसुस होहे, का हमीना तुमरो पर बोझ नही बनन को मकसद लक कसो रात-दिवस काम धंधा करके तुमला परमेस्वर की साजरो बारता आयकवाया।<verse eid="1TH 2:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="1TH 2:10"/>तुमी एना गोस्टी का गवाह सेव अखीन वसोच परमेस्वर भी से, का हमीना तुमला भरोसा को संग पवीतर<note caller="+" style="f"><char style="fr" closed="false">2:10</char><char style="ft" closed="false">बिना पाप का</char></note>, धारमिक अना निरदोस जसो बरताव करीसेजन। <verse eid="1TH 2:10"/><verse number="11" style="v" sid="1TH 2:11"/>तुमी जानासेव का जसो बाप अपरा टूरा गीन को संग बरताव करासे, वसोच हमी भी तुमी मा लक हर एक ला सिक्सा देईसेजन अना तैय्यार करा सेजन अखीन बिनती करके समझाई सेजन। <verse eid="1TH 2:11"/><verse number="12" style="v" sid="1TH 2:12"/>मी बढावा देके कव्हन लगयो का तुमरो चाल चलन परमेस्वर को काबिल होहे, जोन तुमला अपरो राज अना महिमा<note caller="+" style="f"><char style="fr" closed="false">2:12</char><char style="ft" closed="false">बड़ाई</char></note> मा हाकलासे।<verse eid="1TH 2:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="1TH 2:13"/>एना कारन हमी भी सदा परमेस्वर ला धनवाद करा सेजन। का जबा हमरो कन लक तुमला परमेस्वर को गोस्टी की खबर मिली त तुमी न वोनो मानूस गीन ला नही, पर परमेस्वर को गोस्टी समझके अपनायेत। खरो मा उ से भी जोन तुमी भरोसा मा अपरो काम भी करासेत। <verse eid="1TH 2:13"/><verse number="14" style="v" sid="1TH 2:14"/>अगा भाऊ हून तुमी मसीह यीसु मा परमेस्वर की ओनो कलीसिया गीन को मंघा होयेत, जोन यहुदिया मा से। काहेकी तुमी भी अपरो देस का रव्हन वारा लक वसोच दुख सहिसेव। <verse eid="1TH 2:14"/><verse number="15" style="v" sid="1TH 2:15"/>जिनना पिरभू यीसु अना भविस्यवक्ता गीन दुही ला मार डाकिन अना हम ला भी सतायके भगाय देईन। वय परमेस्वर उनलक खुसी नाहतो कहेका वय सबच मानूस गीन को बिरोधी सेत। <verse eid="1TH 2:15"/><verse number="16" style="v" sid="1TH 2:16"/>काहेकि गैर यहुदीगीन ला सूटकारा की साजरी खबर को पिरचार करनो मा वय हमरो लाई बाधा करता रहीसेत। ऐको फर को रुप मा वय सदा अपरो पाप को कुड़ो<note caller="+" style="f"><char style="fr" closed="false">2:16</char><char style="ft" closed="false">घड़ा</char></note> भरतो रहीन, पर अबा त परमेस्वर को गजब कोप भड़क गयो सेत।<verse eid="1TH 2:16"/></para>
  <para style="s">पौलुस कलीसिया लक मिलन को मनसा</para>
  <para style="p">
    <verse number="17" style="v" sid="1TH 2:17"/>पर अगा भाऊ हून हमी तुमरो लक जारासी उसीर को साठी बेगरो कियो गया होता। आतमा (दिल) मा नही पर देह मा एको लाई मोठी आस को संग तुमरो चेहेरा देखन को काजी लगत कोसीस करता रहया। <verse eid="1TH 2:17"/><verse number="18" style="v" sid="1TH 2:18"/>काहेकी हमी तुमरो जवर एक नही दुई गन आवन की आस राखत होता। खुदच मी पौलुस एक नही पर दोन गन आवन चाहवत होतो मंग भी सैतान<note caller="+" style="f"><char style="fr" closed="false">2:18 </char><char style="ft" closed="false">परमेस्वर का सतरू</char></note> अंड़गा डाकत होतीन। <verse eid="1TH 2:18"/><verse number="19" style="v" sid="1TH 2:19"/>हमारो आस खुसी बड़ाई<note caller="+" style="f"><char style="fr" closed="false">2:19</char><char style="ft" closed="false">उल्लास</char></note> को मुकुट कोनतो से? हमरो पिरभू यीसु को आवन की बेरा मा का तुमी नही होवन का? <verse eid="1TH 2:19"/><verse number="20" style="v" sid="1TH 2:20"/>सचमुच मा तुमीच हमारो महिमा अना खुसी सेव।<verse eid="1TH 2:20"/></para>
  <chapter eid="1TH 2"/>
  <chapter number="3" style="c" sid="1TH 3"/>
  <para style="p">
    <verse number="1" style="v" sid="1TH 3:1"/>एको लाई जबा हमी ना लगत नही सह सकया। तबा हमी न अथेने नगर मा एकलो रह जानो समझया। <verse eid="1TH 3:1"/><verse number="2" style="v" sid="1TH 3:2"/>अना आमी ना आपरो भाऊ अखीन मसीह की साजरो बारता मा परमेस्वर ला संग देन वारा दास तीमुथियुस ला धाड़िया, का तुमरो भरोसा मा तुमला बड़ावा देके पक्को करेहत अना समझाहेत। <verse eid="1TH 3:2"/><verse number="3" style="v" sid="1TH 3:3"/>जेनको लक एना दुख लक कोनी भी इतानी-उता नही होय जाव, तुमी खुदच जाना लेईसेव का हमी एको लाई ठहराया गईसेजन। <verse eid="1TH 3:3"/><verse number="4" style="v" sid="1TH 3:4"/>पक्को मा जबा हमी तुमरो संग होतो, त तुमला पुढ़ा च सांग देत होता का हमला दुख सवनो पडेत। अना भयो भी वसोच जसो का तुमी जानासेव। <verse eid="1TH 3:4"/><verse number="5" style="v" sid="1TH 3:5"/>एना कारन जबा मोरो लक अखीन न सहयो गयो त मीना तुमरो भरोसा की घटना जानन लाई धाड़ियो, काही असो नही होवा का परखन वालो न तुमरी परिक्सा करी रहेस अना हमारो महेनत बेकार भय जाहेत।<verse eid="1TH 3:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="1TH 3:6"/>पर अबा जबकि तीमुथियुस तुमरो भरोसा अना पिरेम की साजरो बारता आन के हमरो जवर लवट के आयो अना वोना यो भी सांगीसेस का तुमी ना हमला पिरेम लक हेत राखियासेव अना जसो हमी तुमला वसोच तुमी भी हमला देखन लाई लगत बेरा तकन तरसासेव। <verse eid="1TH 3:6"/><verse number="7" style="v" sid="1TH 3:7"/>एको कारन अगा भाऊ हमरो सबच दुख मा अना कस्ट मा भी तुमरो भरोसा को कारन हमीना तुमरो बिसय मा सान्ती पाया। <verse eid="1TH 3:7"/><verse number="8" style="v" sid="1TH 3:8"/>अदी तुमी पिरभू मा पक्को लक रव्हो त हमी सचमुच जित्तो सेजन। <verse eid="1TH 3:8"/><verse number="9" style="v" sid="1TH 3:9"/>हमी वोना सबरी खुसी को बदला मा परमेस्वर ला कसो धनबाद देबो, जेनको लक हमी तुमरो कारन अपरो परमेस्वर को पुड़ा खुसी होवबिन। <verse eid="1TH 3:9"/><verse number="10" style="v" sid="1TH 3:10"/>हमी रात-दिवस मोठी लगन लक पिराथना करा सेजन, का तुमरो तोन्ड देखबिन अना तुमरो भरोसा घटी कमी पूरी करबिन।<verse eid="1TH 3:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="1TH 3:11"/>अबा हमरो परमेस्वर अना बाप खुदच अखीन हमरो पिरभू यीसु तुमरो जवर आवनो मा हमला रास्ता देखाहे। <verse eid="1TH 3:11"/><verse number="12" style="v" sid="1TH 3:12"/>अना पिरभू करे का तुमी एक दुसरो को लाई अखीन सबच मानूस गीन को लाई पिरेम मा उन्नती करत जाने अना बढता जाने। जसो का हमी भी तुमरो लाई करी सेजन। <verse eid="1TH 3:12"/><verse number="13" style="v" sid="1TH 3:13"/>का जबा हमरो पिरभू यीसु, अपरो सब पवीतर लोक गीन को संग मा आहे, त उ तुमरो हिरदय ला परमेस्वर आमरो बाप को पुड़ा पवितरता मा खरो राखे।<verse eid="1TH 3:13"/></para>
  <chapter eid="1TH 3"/>
  <chapter number="4" style="c" sid="1TH 4"/>
  <para style="s">परमेस्वर ला खुस करन वालो जिता जिंदगी</para>
  <para style="p">
    <verse number="1" style="v" sid="1TH 4:1"/>अखट्ट मा अगा भाऊ हुन हमी तुमी लक पिरभू यीसु मा बिनती करके तुमला समझाव सेजन का, जसो तुमीना आमिलक काबिल चाल चलनो अना परमेस्वर ला खुस करन की सिक्सा पायासेव। अना जसो का तुमी सचमुच चला सेव। वसोच अखीन लगत बढत जावो। <verse eid="1TH 4:1"/><verse number="2" style="v" sid="1TH 4:2"/>काहेकि तुमी जानासेव का हमी न पिरभू यीसु को कन लक तुमला कोन-कोन सो हुकूम देईसेजन। <verse eid="1TH 4:2"/><verse number="3" style="v" sid="1TH 4:3"/>परमेस्वर की मरजी से का तुमी पवीतर बनो अना खोटो करम लक बचया रव्हो। <verse eid="1TH 4:3"/><verse number="4" style="v" sid="1TH 4:4"/>का तुमी मा लक हर एक मानूस अपरी बायको को ईज्जत राखे अना पवीतर को संग पायो जानोसे। <verse eid="1TH 4:4"/><verse number="5" style="v" sid="1TH 4:5"/>परजात गीन को जसो कामुक होयके नही जोन परमेस्वर ला नही जानासेत। <verse eid="1TH 4:5"/><verse number="6" style="v" sid="1TH 4:6"/>का एना गोस्टी मा कोनी भी अपरो भाऊ को दोस नही करेहेत अना नही वोला ठगाहेत। काहेकी पिरभू एना सबरी गोस्टी गीन ला बदला लेवन वारा सेत जसो का हमीना पुड़ा च तुमला सांगीसेजन अना साजरी अक्ल लक चेताय भी सेजन। <verse eid="1TH 4:6"/><verse number="7" style="v" sid="1TH 4:7"/>काहेकि परमेस्वर न हमला नीच काम को लाई नही पर पवीतर होवन लाई हाकलिसेस। <verse eid="1TH 4:7"/><verse number="8" style="v" sid="1TH 4:8"/>एको कारन जसो जोन एला बेकार जानासे, उ मानूस ला नही पर परमेस्वर ला बेकार जानासे, जोन तुमला अपरी पवीतर आतमा देवासे।<verse eid="1TH 4:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="1TH 4:9"/>अगा भाऊ पिरेम को बिसय मा यो जरूरी नही का मि तुमरो लाई काही लिखुह। काहेकी एक दुसरो लक पिरेम करनो तुमीना अपरो परमेस्वर कन लक सिकासो। <verse eid="1TH 4:9"/><verse number="10" style="v" sid="1TH 4:10"/>काहेका तुम सचमुच पूरी मकीदुनिया को भाऊहुन को संग असोच बरताव करत होता पर भाऊ हून तुमरो लक बिनती करासेजन का अखीन बढता जावो। <verse eid="1TH 4:10"/><verse number="11" style="v" sid="1TH 4:11"/>अखीन जसो हुकूम हमीना तुमला देई सेजन तुमी सान्ती लक जिंदगी की आस राखो, अपरो काम लक काम राखो अना अपरो हात गीन लक महेनत करो। <verse eid="1TH 4:11"/><verse number="12" style="v" sid="1TH 4:12"/>जोको लक बाहेर वारा लक मान मिल सकेह अना तुमला कोनी चीज की आस नही रह।<verse eid="1TH 4:12"/></para>
  <para style="s">पिरभु को दुबारा आवनो</para>
  <para style="p">
    <verse number="13" style="v" sid="1TH 4:13"/>पर अगा भाऊ हुन हमी नही चाव्हसेजन, का तुमी उनको बिसय मा अनजान रहवो। जोन सोय गईसेत अना काही लोक गीन को जसो सोकित होय जावो, जिनला आसा नाहती। <verse eid="1TH 4:13"/><verse number="14" style="v" sid="1TH 4:14"/>हमी भरोसा करासेजन का यीसु मारयो गयो अना जितो भयो। एकोलाय परमेस्वर उनला भी जोन यीसु मा सोय गईसेत वोको संग मा आनहेत।<verse eid="1TH 4:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="1TH 4:15"/>एना कारन हमी पिरभू को गोस्टी को लक तुमरो लक कव्हवसू का हमी जोन जित्तो सेजन अना पिरभू को आवन तकन बचया रहबोन अना सोया हुया लक कबच नही पुड़ा बढबोन। <verse eid="1TH 4:15"/><verse number="16" style="v" sid="1TH 4:16"/>काहेकी पिरभू खुदच ललकार अना मुखिया सरगदुत ला हाकलके अखीन परमेस्वर की तुर्रा की आवाज को संग मा सरग लक उतरेत अखीन जोन मसीह मा मर गई सेत, वय पुड़ा जित्तो होयेती। <verse eid="1TH 4:16"/><verse number="17" style="v" sid="1TH 4:17"/>तबा हमी जोन जित्तो सेजन अना बचयो रहेति उनको संग मा वारा मा पिरभू लक मिलन को लाई बादर पर उचाल लियो जावबिन। एना रिती लक हमी सदा पिरभू को संग रहबिन। <verse eid="1TH 4:17"/><verse number="18" style="v" sid="1TH 4:18"/>एकोलाय एना गोस्टी गीन लक एक दुसरो ला सान्ती देवो।<verse eid="1TH 4:18"/></para>
  <chapter eid="1TH 4"/>
  <chapter number="5" style="c" sid="1TH 5"/>
  <para style="s">दुबारा आवन वालो पिरभु यीसु लाई तैय्यार रव्हने</para>
  <para style="p">
    <verse number="1" style="v" sid="1TH 5:1"/>अगा भाऊ एना गोस्टी को जरुरी नही से। का यो बेरा या जुग्ग को बिसय मा तुमला काही लिखयो जाहे। <verse eid="1TH 5:1"/><verse number="2" style="v" sid="1TH 5:2"/>काहेकि तुमी खुदच भली-भाती जानासेव का जसो रात मा चोर आवासे वसोच पिरभू को दिवस भी आहे। <verse eid="1TH 5:2"/><verse number="3" style="v" sid="1TH 5:3"/>जबा लोक कहेत “सान्ती अना सब साजरो से” तबा जसी पेट लक रव्हन वालो आई-माई पर एकदम लक दुख आवासे। वसोच उनको पर एकाएक नास आय जाहे अना वय बच नही सकनका। <verse eid="1TH 5:3"/><verse number="4" style="v" sid="1TH 5:4"/>पर भाऊ तुमी इंधारो मा नही सेव, का उ दिवस तुमरो पर चोर को जसो आय जाहे। <verse eid="1TH 5:4"/><verse number="5" style="v" sid="1TH 5:5"/>काहेकि तुमी सब उजाडो की आवलाद अखीन दिवस की आवलाद सेव हमी न त रात का सेजन अना नही इंधारो का सेजन। <verse eid="1TH 5:5"/><verse number="6" style="v" sid="1TH 5:6"/>अना हमी दुसरो को जसो नोको सोवनो पर जागतो अना चालु रव्हना। <verse eid="1TH 5:6"/><verse number="7" style="v" sid="1TH 5:7"/>काहेकि जोन सोवासेत वय रात मा सोवासेत अना जोन नसा मा रहवसेत वय रात मा नसा मा होवासेत। <verse eid="1TH 5:7"/><verse number="8" style="v" sid="1TH 5:8"/>पर एकोलाय का हमी दिवस का सेजन आव हमी भरोसा अना पिरेम को कवच<note caller="+" style="f"><char style="fr" closed="false">5:8</char><char style="ft" closed="false">सीना में बांधा जाने वाला पट्टा</char></note> अना सूटकारा की आस को टोप पहेर के तैय्यार रव्हबिन। <verse eid="1TH 5:8"/><verse number="9" style="v" sid="1TH 5:9"/>काहेकि परमेस्वर न हमला कोप लाई नही पर हमरो पिरभू यीसु मसीह को कन लक सूटकारा पावन लाई ठहराईसेस। <verse eid="1TH 5:9"/><verse number="10" style="v" sid="1TH 5:10"/>उ हमरो लाई एने कारन लक मारयो गयो का चाव्ह हमी जागता या सोता रव्हबिन, हमी सब मिलके ओको संग जित्तो रव्हबिन। <verse eid="1TH 5:10"/><verse number="11" style="v" sid="1TH 5:11"/>एको लाई एक दुसरो ला सान्ती देवो। अना एक दुसरो की तरक्की करहो जसो का तुमी कर भी रहिसेव।<verse eid="1TH 5:11"/></para>
  <para style="s">अखट्ट गोस्टी अना सुभकामना</para>
  <para style="p">
    <verse number="12" style="v" sid="1TH 5:12"/>पर भाऊ गीन हमी तुमरो लक बिनती करासेजन का उनको मान-भाव करो। जोन तुमरो बीच मोठी महेनत करासेत अना जोन पिरभू मा तुमरो ओरिया अगवा राखीसेस अना तुमला सिक्सा देवसेत। <verse eid="1TH 5:12"/><verse number="13" style="v" sid="1TH 5:13"/>अखीन उनको काम को कारन पिरेम लक उन को संग साजरो सान्ती लक रव्हो।<verse eid="1TH 5:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="1TH 5:14"/>अगा भाऊ तुमरो लक बिनती करासेजन का आलसी गीन ला चेताय देव। निरास गीन ला हिम्मत देवो। कमजोर गीन की मदद करो सब को संग मा धीरज राखो। <verse eid="1TH 5:14"/><verse number="15" style="v" sid="1TH 5:15"/>ध्यान राखो का, कोनी बुराई को बदला बुराई नोको करो पर हमेसा एक दुसरो ला अना सब लोक गीन ला भला करन मा कोसीस करतो रहेयो।<verse eid="1TH 5:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="1TH 5:16"/>हमेसा खुसी लक रहवो। <verse eid="1TH 5:16"/><verse number="17" style="v" sid="1TH 5:17"/>लगातर पिराथना करता रहवो। <verse eid="1TH 5:17"/><verse number="18" style="v" sid="1TH 5:18"/>हर एक हाल मा धनयवाद देवो। काहेकी मसीह यीसु मा तुमरो लाई परमेस्वर की याच मरजी से।<verse eid="1TH 5:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="1TH 5:19"/>आतमा ला नोको बुझावो। <verse eid="1TH 5:19"/><verse number="20" style="v" sid="1TH 5:20"/>दरसन की गोस्टी गीन ला नाहनो नोको जानो। <verse eid="1TH 5:20"/><verse number="21" style="v" sid="1TH 5:21"/>सब गोस्टी गीन ला साजरो लक परिक्सा करो, जोन साजरी से वोला पक्को लक सम्हाल राखने। <verse eid="1TH 5:21"/><verse number="22" style="v" sid="1TH 5:22"/>सब पिरकार की बुराई लक बचया रहवना।<verse eid="1TH 5:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="1TH 5:23"/>अबा सान्ती को परमेस्वर आतमा आपच तुमला पूरो पवीतर करहे। अखीन तुमरो आतमा, परान अना देह हमरो पिरभू यीसु मसीह को आवन तकन पूरो रिती लक निरदोस अखीन साजरी रह। <verse eid="1TH 5:23"/><verse number="24" style="v" sid="1TH 5:24"/>तुमरो बुलावन वालो बिस्वास को काबील से अना उ असोच करहे।<verse eid="1TH 5:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="1TH 5:25"/>अगो भाऊ, हमरो लाई पिराथना करने।<verse eid="1TH 5:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="1TH 5:26"/>सब भाऊ गीन ला पवीतर चुम्मा लक नमस्ते लेवने।<verse eid="1TH 5:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="1TH 5:27"/>मी पिरभू की किरया देवसु का एना चिठ्ठी ला सब भाऊ गीन ला वाच के आयकावो जाहे।<verse eid="1TH 5:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="1TH 5:28"/>आमरो पिरभू यीसु मसीह को दया तुमरो संग होवती रव्हे।<verse eid="1TH 5:28"/></para>
  <chapter eid="1TH 5"/>
</usx>
