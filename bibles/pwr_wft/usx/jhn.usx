<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="JHN" style="id">- Powari Standard Project</book>
  <para style="h">योहन</para>
  <para style="toc3">योहन</para>
  <para style="toc2">योहन</para>
  <para style="toc1">योहन लक लिख्यो यीसु मसीह साजरा बारता</para>
  <para style="mt2">योहन के व्दारा लिखा यीसु मसीह का सुसमाचार</para>
  <para style="mt1">योहन लक लिख्यो यीसु मसीह को साजरा बारता</para>
  <para style="imt">परिचय</para>
  <para style="ip">योहन लक लिख्यो यीसु को कथा मा यीसु ला परमेस्वर को सबद को रुपमा चोवायो गयो से। जोन ना मानूस देह मा आय के आमरो बीचमा रह्यो से। यो कथा एको लाय लिख्यो गयो से, का एला बाचन वारा भरोसा करेत का यीसु च परन कियो हुओ सूटकारा देवन वारा परमेस्वर को टूरा से। अना वय भरोसा करके जिंदगी ला पाय सकासे।</para>
  <para style="ip">पहले यीसु ला परमेस्वर को सबद को रुपमा चोवायो गयो से। वोको मंघा मा कहानी मा पुढ़ा को सात चकित करनवारा काम ला दरसायो गयो से। उन लक यो मालुम होवासे का यीसु परन कियो गयो सूटकारा देवन वारा परमेस्वर को टूरा से।</para>
  <para style="ip">दुसरो हिस्सा मा जोन सिक्सा से, वोमा यो समजायो गयो से का चकित होवन वारा काम को काजक अरथ से? अना यो भी सांगो गयो से, का काही लोकगीन ना यीसु पर भरोसा करके अखीन वोको चेला बन गईन। अना काही लोकगीन वोको विरोध करके विरोधी बन गईन। अना भरोसा राखन लाय मुकर गईन।</para>
  <para style="ip">अध्याय 13 लक 17 तकन यीसु ला धरान वालो रात को, यीसु को चेलागीन संग गोस्टी करत, कूरूस मा चघायो जानो को पयले संजा को बेरामा चेलागीन ला समजावनो, आखीर मा कूरूस मा लटकानो, अना वोको कबर लक जिवनो अना चेलागीन को पुढ़ा परगट होवनो को बारे मा सेत। <char style="xt"><ref loc="JHN 20:31">20:31</ref></char> योहन यीसु को लक दियो जान वालो अमर जीवन पर जोर देव से। यो असो दान से जो अबा सुरु होवा से। अना उनला भेटा से जोन यीसु को सांगयो रास्ता मा चलासे। अखीन यीसु ला खरो जीवन अना पंथ को रुप मा अपनावा से। योहन आत्मिक गोस्टी ला समजावन लाय साधारन चीज को उदाहरन देवासे। जसो पानी, भाकरी, दियो को उजाड़ो, मेढा को चरवाहा अना अंगूर को बेला, फर चोवान।</para>
  <para style="iot">रुपरेखा</para>
  <para style="io1">1. भूमिका योहन बप्तिस्मा देन वालो। <char style="ior"><ref loc="JHN 1:1-18">1:1-18</ref> </char></para>
  <para style="io1">2. अना यीसु का पयलो चेला यीसु को लोक सेवा। <char style="ior"><ref loc="JHN 1:19-12:50">1:19—12:50</ref> </char></para>
  <para style="io1">3. यरुसलेम मा आखरी का काही दिवस। <char style="ior"><ref loc="JHN 13:1-20:31">13:1—20:31</ref> </char></para>
  <para style="io1">4. पिरभू को मरो मा लक जीवनो अना ओको चोवनो गलील मा मंग लक चोवनो। <char style="ior"><ref loc="JHN 21">21</ref></char></para>
  <chapter number="1" style="c" sid="JHN 1"/>
  <para style="s">सबद को देह रुपमा आवनो</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 1:1"/>सबमा सूरू मा सबद होतो। अना सबद परमेस्वर<note caller="+" style="f"><char style="fr" closed="false">1:1</char><char style="ft" closed="false">परमेस्वर</char></note> को संगा होतो। अखीन सबद परमेस्वर होतो। <verse eid="JHN 1:1"/><verse number="2" style="v" sid="JHN 1:2"/>वोच सुरुमा परमेस्वर को संगा होतो। <verse eid="JHN 1:2"/><verse number="3" style="v" sid="JHN 1:3"/>सबच काही वोकोच लक जलम भयो से, उनमा लक कोनी भी चीज वोको बगर जलम नही भयेव। <verse eid="JHN 1:3"/><verse number="4" style="v" sid="JHN 1:4"/>वोको मा जिंदगी होतो, अना वा जीन्दगी मानूस गिनको उजाड़ो होतो। <verse eid="JHN 1:4"/><verse number="5" style="v" sid="JHN 1:5"/>अखीन उजाड़ो इंधारो मा चमकासे अना इँधारो <note caller="+" style="f"><char style="fr" closed="false">1:5</char><char style="ft" closed="false">अँधेरा </char></note> वोला नही अपनाय सकयेव।<verse eid="JHN 1:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="JHN 1:6"/>परमेस्वर को कन लक एक मानूस आयो, वोको नाव योहन होतो। <verse eid="JHN 1:6"/><verse number="7" style="v" sid="JHN 1:7"/>उ सच्चो उजाड़ो को बारे मा सबला गवाही देन आयेव होतो, का सब वोको गोस्टी ला मानके भरोसा करेत। <verse eid="JHN 1:7"/><verse number="8" style="v" sid="JHN 1:8"/>उ खुद उजाड़ो नहोत, मंग उ सच्चो उजाड़ो को बारे मा साँगन आयेव होतो। <verse eid="JHN 1:8"/><verse number="9" style="v" sid="JHN 1:9"/>उ उजाड़ो जोन खरो से, वा हरेक मानूस मा उजाड़ो कर देसे। असो उजाड़ो दुनिया मा आवनवारा होतो।<verse eid="JHN 1:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="JHN 1:10"/>उ दुनिया मा होतो, अना सप्पा दुनिया वोको लक जलम लेयी होती, तरी दुनिया को लोक गीनना वोला नही चिन्हो। <verse eid="JHN 1:10"/><verse number="11" style="v" sid="JHN 1:11"/>उ आपरो घर मा आयो, अना वोकोच घरवारो ना वोला धुतकार<note caller="+" style="f"><char style="fr" closed="false">1:11</char><char style="ft" closed="false">ठुकरा</char></note> देइन। <verse eid="JHN 1:11"/><verse number="12" style="v" sid="JHN 1:12"/>पर जितरो ना वोला आपनाय लेइन, उनला वोना परमेस्वर को टूरा-टुरी होवन को हक देइस। मनजे जोन लोकगीन वोको नाव पर भरोसा राखासे। <verse eid="JHN 1:12"/><verse number="13" style="v" sid="JHN 1:13"/>की जसो रकत लक मानूस जलम होवासे, ओनो पिरकार लक वय जलम नही लेईन तरी उनको अजी स्वता परमेस्वर से।<verse eid="JHN 1:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="JHN 1:14"/>अना सबद देह मा आयो अना दया अखीन खराई<note caller="+" style="f"><char style="fr" closed="false">1:14</char><char style="ft" closed="false">सच्चाई</char></note> लक आमरो बीच मा रहयो अना आमी ना उ परमेस्वर को टूरा को महिमा आपरो डोरा लक चोवयो सेजन।<verse eid="JHN 1:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="JHN 1:15"/>योहन ना वोको बारे मा गवाही दियो से। अना हाकल के कव्हयो “यो वोच से जोन को बारे मा मिना साँगयो होतो, जोन मोरो मँघा आवनवालो से, मोरो लक मोठयो से, काहेकि उ मोरो लक पयले होतो।”<verse eid="JHN 1:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 1:16"/>काहे का वोको मोठयो दया लक एक नही पर आमी ला दुई बार दया मिलि से। <verse eid="JHN 1:16"/><verse number="17" style="v" sid="JHN 1:17"/>एको लाय का मोसे को नियम<note caller="+" style="f"><char style="fr" closed="false">1:17</char><char style="ft" closed="false">नियम</char></note> ता मोसे ना दियो से। पर खराई अना दया यीसु मसीह सूटकारा देवन वालो लक धाड़ियो गयो से। <verse eid="JHN 1:17"/><verse number="18" style="v" sid="JHN 1:18"/>कबच कोनी न परमेस्वर ला नही चोयोसेस, पर परमेस्वर को टूरा नाच परमेस्वर ला चोवयोसेस, काहेका जोन वोकोच कन लक आईसे, वोनाच परमेस्वर ला चोवायोसेस।<verse eid="JHN 1:18"/></para>
  <para style="s">योहन को गवाही</para>
  <para style="r">(<ref loc="MAT 3:1-12">मत्ती 3:1-12</ref>; <ref loc="MRK 1:1-8">मरकुस 1:1-8</ref>; <ref loc="LUK 3:1-18">लूका 3:1-18</ref>)</para>
  <para style="p">
    <verse number="19" style="v" sid="JHN 1:19"/>जबा यहूदिगीन ना यरुसलेम मा याजक अना लेवी दासगिन ला योहन लक यो पुसन काजी धाड़ीन का “तु कोन आस?”<verse eid="JHN 1:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="JHN 1:20"/>ता वोना यो गवाही देइस अना बिना संका को राजी भय गयो। “की मी मसीह नही सेव।” <verse eid="JHN 1:20"/><verse number="21" style="v" sid="JHN 1:21"/>तबा उनना योहन लक पुसिन, “मंग तु कोन आस?” “का तू भविस्यवक्ता एलिय्याह आस?” योहन ना कव्हयो “मि एलिय्याह नही सेऊ” तो “का कोनी मोठयो भविस्यवक्ता सेव?” योहन ना कहीस, नही। <verse eid="JHN 1:21"/><verse number="22" style="v" sid="JHN 1:22"/>तबा उनना वोको लक पुसिन का तू कोन आस? जोन ना आमला धाड़ीसेस उनला आमी काजक साँगबिन? “तू आपरो बारेमा काजक कव्हसेस?” <verse eid="JHN 1:22"/><verse number="23" style="v" sid="JHN 1:23"/>योहन ना कव्हयो, जसो भविस्यवक्ता यसायाह ना साँगिसेस “जंगल मा एक हाकलनवारा को आवाज का पिरभू को पंथ<note caller="+" style="f"><char style="fr" closed="false">1:23</char><char style="ft" closed="false">रास्ता</char></note> ला सरल करो।” मि वोच सेव।<verse eid="JHN 1:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="JHN 1:24"/>वय मोसे को नियम को गुरू को कन लक धाडो गयो होतिन। <verse eid="JHN 1:24"/><verse number="25" style="v" sid="JHN 1:25"/>उनना योहन लक पलट के पुसिन, “तू ना ता मसीह ना तो भविस्यवक्ता ना ता एलिय्याह आस। मंग तु काय साठी बप्तिस्मा देसेस?”<verse eid="JHN 1:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="JHN 1:26"/>तबा योहन ना जवाब दियो, “मि तो तुमी ला पानी मा बप्तिस्मा देवासू, पर तुमारो बीच मा एक मानूस उभो से, जेनला तुमी नही जानसो। <verse eid="JHN 1:26"/><verse number="27" style="v" sid="JHN 1:27"/>मतलब मोरो मँघा आवनवालो से, जोन मोरो लक ज्यादा साजरो से, मि जोन को जूता की दोरी खोलन लायक भी नही सेउ।”<verse eid="JHN 1:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="JHN 1:28"/>यो गोस्टी यरदन नदी को वोनागन बैतनिहा गाँव मा भयो होतो जहान योहन बप्तिस्मा देत होतो।<verse eid="JHN 1:28"/></para>
  <para style="s">परमेस्वर को पाठी</para>
  <para style="p">
    <verse number="29" style="v" sid="JHN 1:29"/>दुसरो दिवस मा योहन बप्तिस्मा देवनवारा ना यीसु ला आपरो कन आवता चोइस अना कहीस, चोवो यो परमेस्वर को पाठी<note caller="+" style="f"><char style="fr" closed="false">1:29</char><char style="ft" closed="false">पाठी</char></note> से, जो दुनिया को पाप ला उचल ले जावसे। <verse eid="JHN 1:29"/><verse number="30" style="v" sid="JHN 1:30"/>जोन को बारेमा मीना सांग्यो होतो, क एक मानूस मोरो मंघा आवन वारा से यो वोच से, जोन मोरो लक साजरो से काहेका उ मोरो लक पूढा होतो। <verse eid="JHN 1:30"/><verse number="31" style="v" sid="JHN 1:31"/>अना मी वोला चिन्हत नही होतो। पर यो काजी मी पानी मा बप्तिस्मा देवसू का यो गोस्टी इसरायल जाती मा सब ला मालुम भई जाहेति।<verse eid="JHN 1:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="JHN 1:32"/>अना योहन ना यो गवाही देइस, मी ना परेवा को जसो आतमा ला सरग लक उतरतो चोयी सेऊ अना आतमा आयके वोको वरता रुक गयो। <verse eid="JHN 1:32"/><verse number="33" style="v" sid="JHN 1:33"/>अना मी ता वोला चिन्हत<note caller="+" style="f"><char style="fr" closed="false">1:33</char><char style="ft" closed="false">जानता</char></note> नही होतो। पर जोन परमेस्वर ना मोला पानी लक बप्तिस्मा देवन लाय धाड़िसेस, वोना मोला सांगीस, का तुमी जोको वरता आतमा ला उतरतो अना रुकतो चोवजोस वोच पवितर आतमा लक बप्तिस्मा देवनवारा से। <verse eid="JHN 1:33"/><verse number="34" style="v" sid="JHN 1:34"/>अखीन मीना चोवयो अना मि सांगुसू, का योच परमेस्वर को टूरा आय।<verse eid="JHN 1:34"/></para>
  <para style="s">यीसु को पहिला चेला</para>
  <para style="p">
    <verse number="35" style="v" sid="JHN 1:35"/>दुसरो दिवस योहन ओको दुई चेला को संगा उभो होतिन। <verse eid="JHN 1:35"/><verse number="36" style="v" sid="JHN 1:36"/>जबा उनना यीसु ला चलता चोयो, तबा कव्हन लगयो, चोवो यव परमेस्वर को पाठी आय।<verse eid="JHN 1:36"/></para>
  <para style="p">
    <verse number="37" style="v" sid="JHN 1:37"/>तबा वय दुई चेला ना यव आयकिन ता यीसु को संगा भय गईन।<verse eid="JHN 1:37"/></para>
  <para style="p">
    <verse number="38" style="v" sid="JHN 1:38"/>यीसु ना मुरक के उनला मंघा आवता चोयो, ता पुसासे, तुमी कोन ला चोवासेव? तबा उनना कहिन, हे गुरू तू कहाँन रव्हसेस?<verse eid="JHN 1:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="JHN 1:39"/>तबा यीसु ना चेलाहुन ला कव्हसे, “चलो अना चोय लेव” तबा वोना जायके वोको रव्हन को जघा चोयो अना वोको संगा रहयो, यो महातनी बेरा होती।<verse eid="JHN 1:39"/></para>
  <para style="p">
    <verse number="40" style="v" sid="JHN 1:40"/>जोन चेला योहन को गोस्टी आयकिन होतीन यीसु को मंघा भई गयी होतीन, उन दुही मा लक समोन अना एक अंद्रियास नाव को होतो। <verse eid="JHN 1:40"/><verse number="41" style="v" sid="JHN 1:41"/>अंद्रियास पयले आपरो सगो भाऊ समौन ले भेटयो अना वोला कव्हयो “आमला बचावन वारो मसीह मिल गयो से।”<verse eid="JHN 1:41"/></para>
  <para style="p">
    <verse number="42" style="v" sid="JHN 1:42"/>तबा अंद्रियास ना समौन ला यीसु को जवर आनिस। तबा वोना टकटकी लगायके ओला चोयके कहीस, “तु योहन को टूरा समौन आस, तू पतरस<note caller="+" style="f"><char style="fr" closed="false">1:42 </char><char style="ft" closed="false">लहान गोटा</char></note> कहलाजोस।”<verse eid="JHN 1:42"/></para>
  <para style="s">यीसु ना फिलिप्पुस अना नतनएल ला हाकलीस</para>
  <para style="p">
    <verse number="43" style="v" sid="JHN 1:43"/>दुसरो दिवस यीसु ना गलील जानो को निरनय लेवो,। उ फिलिप्पुस लक भेटयो अना ओको लक कव्हयो “मोरो मंघ होय लेव।” <verse eid="JHN 1:43"/><verse number="44" style="v" sid="JHN 1:44"/>फिलिप्पुस, अन्दिरयास, अना पतरस को नगर बैतसेदा को रव्हन वारा होतीन। <verse eid="JHN 1:44"/><verse number="45" style="v" sid="JHN 1:45"/>फिलिप्पुस नतनएल लक भेटयो अना वोको लक कव्हयो जेनको बारेमा भविस्यवक्ता मोसे ना, मोसे को नियम मा अना पवीतर भविस्यवक्ता गीनना पवीतर गिरंथ मा सांगिने, उ हमला मिल गयो से, उ यूसुफ को टूरा यीसु आय, जोन नासरत नगर मा रव्हासे।<verse eid="JHN 1:45"/></para>
  <para style="p">
    <verse number="46" style="v" sid="JHN 1:46"/>नतनएल ना वोको लक कहीस, का कोनी साजरो चीज नासरत नगर लक हीट सकासे?</para>
  <para style="p" vid="JHN 1:46">फिलिप्पुस ना वोको लक कव्हयो, आयके चोय ले।<verse eid="JHN 1:46"/></para>
  <para style="p">
    <verse number="47" style="v" sid="JHN 1:47"/>यीसु ना नतनएल ला आपरो कन आवत चोवके वोको बारेमा कव्हयो, “चोवो एकोमा कपट नहात, यो खरो-खर इसरायली से?”<verse eid="JHN 1:47"/></para>
  <para style="p">
    <verse number="48" style="v" sid="JHN 1:48"/>नतनएल ना वोको लक कव्हयो, तू मोला कसो जानासेस?</para>
  <para style="p" vid="JHN 1:48">यीसु ना वोला जवाब दियो, ओको लक पुढा की फिलिप्पुस ना तोला हाकलीस, जबा तु अँजीर को झाड़ को खाल्या होतो, तबा मिना तोला चोवयो होतो।<verse eid="JHN 1:48"/></para>
  <para style="p">
    <verse number="49" style="v" sid="JHN 1:49"/>नतनएल ना वोला जवाब दियो, “हे गुरू तू परमेस्वर को टूरा, अना इसरायल जाती को महा राजा आस।”<verse eid="JHN 1:49"/></para>
  <para style="p">
    <verse number="50" style="v" sid="JHN 1:50"/>यीसु ना उनला जवाब दियो, “मीना जो तोरो लक कव्हयो का मिना तोला अँजीर को झाड़ को खाल्या चोवयो सेव का तू एकोलाय भरोसा राखासे? तू एको लक मोठो-मोठो काम चोवजोस।” <verse eid="JHN 1:50"/><verse number="51" style="v" sid="JHN 1:51"/>मंग वोको लक सांग्यो मी तूमी लक खरो-खर सांगसू का, “तुमी सरग ला उघड़ो हुयो अना परमेस्वर को सरगदूत गिनला वरता जातो अना मानूस को टूरा<note caller="+" style="f"><char style="fr" closed="false">1:51 </char><char style="ft" closed="false">यीसु खुद को बारेमा कव्हासेत</char></note> ला खाल्या उतरतो चोवने।”<verse eid="JHN 1:51"/></para>
  <chapter eid="JHN 1"/>
  <chapter number="2" style="c" sid="JHN 2"/>
  <para style="s">काना नगर मा लगन</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 2:1"/>मंग परो को दिवस गलील छेतर को काना नगर मा कोनी को बिहाव होतो, अना यीसु की माय भी उता होती। <verse eid="JHN 2:1"/><verse number="2" style="v" sid="JHN 2:2"/>यीसु अना वोका चेला गीन भी नेवता मा आयो होतीन। <verse eid="JHN 2:2"/><verse number="3" style="v" sid="JHN 2:3"/>जबा पिवनो को लाई अंगूर को रस खत्म भय गयो। ता यीसु की माय ना कहीस, “अता उनको जवर ता अंगूर को रस नाहती।”<verse eid="JHN 2:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="JHN 2:4"/>यीसु न कहीस। अवो माय, अबा मोरो काजक काम से? अबा यो काम करनो की बेरा नहात।<verse eid="JHN 2:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="JHN 2:5"/>ओकी माय नौकर गीनला कव्हासे, उ जोन काही करन ला सांगेत वोच करने।<verse eid="JHN 2:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="JHN 2:6"/>उता यहूदी-जात सुध्द करन को रिती-रिवाज को लक गोटा को सह<note caller="+" style="f"><char style="fr" closed="false">2:6</char><char style="ft" closed="false">छय</char></note> गजब मोठो भांडो राखी होतीन, उनमा एक-एक मा संबर<note caller="+" style="f"><char style="fr" closed="false">2:6 </char><char style="ft" closed="false">एक सव</char></note> लिटर को लगभग रस समावत होत्यो। <verse eid="JHN 2:6"/><verse number="7" style="v" sid="JHN 2:7"/>यीसु ओन्हीसीन कव्हसे, भांडो मा पानी भर देव, अना यीसु को कव्हन लक, ओन्हीसीन भांडो ला टोंड तकन लबा-लब भर देयि होतीन। <verse eid="JHN 2:7"/><verse number="8" style="v" sid="JHN 2:8"/>तबा वोना ओन्हीसीन कव्हासे, हेड़के हांडी रांधिया को जवर ले जावो। <verse eid="JHN 2:8"/><verse number="9" style="v" sid="JHN 2:9"/>जबा हांडी रांधिया ना वा पानी ला चाखीस, जोन अंगूर को रस बन गयो होतो। अना ओन्हीसीन नही जान पाईन का किता लक आइसे, पर वोको नौकर गीनला यो सब कान्ड मालुम होतो। तबा हान्डी राँधिया ना नवरदेव ला हाकलके कहीस, <verse eid="JHN 2:9"/><verse number="10" style="v" sid="JHN 2:10"/>“हर कोनी मानूस पुढा निट-नाट अंगूर को रस देवासे, अना जबा लोकगीन को जिव भर जासे तबा फिको देवासे, पर तुना अबा लक निट-नाट अंगूर रस बचाय राखिसेस।” <figure style="fig" alt="Filling water in the stone jars" file="LB00135C.TIF" size="col" copy="Horace Knowles ©" ref="2:7">गोटा को मड़का मा पानी भरतो हुयो</figure><verse eid="JHN 2:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="JHN 2:11"/>यीसु ना गलील को काना नगर मा आपरो यो पयलो निसान दिसाय के आपरी महिमा ला दिसाइस। अना ओको चेला ना वोको पर भरोसा ठेइन।<verse eid="JHN 2:11"/></para>
  <para style="s">यीसु ला मंदिर ला सफा करनो</para>
  <para style="r">(<ref loc="MAT 21:12-13">मत्ती 21:12-13</ref>; <ref loc="MRK 11:15-17">मरकुस 11:15-17</ref>; <ref loc="LUK 19:45-46">लूका 19:45-46</ref>)</para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 2:12"/>येको मंघा वा अना वोकी माय अना भाऊ अना चेला कफरनहुम नगर ला गईन अना उता काही दिवस रहीन। <verse eid="JHN 2:12"/><verse number="13" style="v" sid="JHN 2:13"/>यहूदिगीन को फसह<note caller="+" style="f"><char style="fr" closed="false">2:13 </char><char style="ft" closed="false">बलीदान को तिहार</char></note> को तिहार जवर होतो, अना यीसु यरुसलेम ला गयो। <verse eid="JHN 2:13"/><verse number="14" style="v" sid="JHN 2:14"/>वोना मंदिर मा मेढा परेवा बईल बिकनवालो अना सोना-चांदी ला बदलन वारो ला बसा चोवसे, <verse eid="JHN 2:14"/><verse number="15" style="v" sid="JHN 2:15"/>एकोलाई वोने रस्सी को कोड़ा बनायीस अना सब मवेसीहुन ला बाहेर मंदिर लक हेड़ देयो होत्यो। अना सोनार गीन को पैसा ला बगराय देयो होतो, अना पीढा<note caller="+" style="f"><char style="fr" closed="false">2:15</char><char style="ft" closed="false">बसन को इसटूल या टेवल</char></note> ला उलट देयो होतो। <verse eid="JHN 2:15"/><verse number="16" style="v" sid="JHN 2:16"/>अना परेवा बिकन वारो ला साँगीस, इनला इता लक ले जावो! मोरो परमेस्वर को घर ला, धंधा करन को सराव नोको बनाव। <verse eid="JHN 2:16"/><verse number="17" style="v" sid="JHN 2:17"/>तबा ओको चेला गीनला हेत आई, का गिरंथ मा लिखयो से, “तोरो घर को लाई मोरी धुन मोला खाय डाकेत।”<verse eid="JHN 2:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="JHN 2:18"/>एतरो पर यहूदी लोक ओको लक कव्हासेत। तु असो काम करासेस, ता आमी ला काही निसान दिसाव।<verse eid="JHN 2:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="JHN 2:19"/>यीसु ना उनलक जवाब मा कव्हासे, “यो मंदिर ला पाड़ देव, अना मी एला तीन दिवस मा उभो कर देहू।”<verse eid="JHN 2:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="JHN 2:20"/>यहूदी लोकगीन ना कहिन, “यो मंदिर ला बनावन मा छियालीस साल लगीसेत। अना का तु वोला तीन दिवस मा उभो कर देवजोस?” <verse eid="JHN 2:20"/><verse number="21" style="v" sid="JHN 2:21"/>पर वोना आपरो देह रुपी मंदिर को बारे मा कव्हयो होतो। <verse eid="JHN 2:21"/><verse number="22" style="v" sid="JHN 2:22"/>अना जबा उ मरो मा लक जित्तो भयो, तबा ओको चेला गीनला हेत आई, का वोने उनलक यो कव्हयो होतो, अना उनना परमेस्वर को पवितर गिरंथ अना उ परमेस्वर की गोस्टी पर, जोन यीसु ना साँगयो होतो भरोसा राखीन।<verse eid="JHN 2:22"/></para>
  <para style="s">यीसु मानूस को मन ला जानासे</para>
  <para style="p">
    <verse number="23" style="v" sid="JHN 2:23"/>यीसु यरुसलेम नगर मा फसह को तिहार मा होतो, अना उ जोन निसान दिसावत होतो, ओला चोवके लोकगीन यीसु नाव पर भरोसा ठेइन। <verse eid="JHN 2:23"/><verse number="24" style="v" sid="JHN 2:24"/>पर यीसु ना आपरो आप ला, उनको भरोसा मा नही छोड़ीस, काहेकी उ उन मानूस को मन ला जानत होतो। <verse eid="JHN 2:24"/><verse number="25" style="v" sid="JHN 2:25"/>यो काजी वोला मानुसहिन ला गवाही देवन को जरूरत नही होतो।<verse eid="JHN 2:25"/></para>
  <chapter eid="JHN 2"/>
  <chapter number="3" style="c" sid="JHN 3"/>
  <para style="s">यीसु को नीकुदेमुस ला सिक्सा</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 3:1"/>याजक अना मोसे को नियम को गुरू गीनमा नीकुदेमुस नाव को एक मानूस होतो जोन यहूदी लोकगीन को मुखिया<note caller="+" style="f"><char style="fr" closed="false">3:1 </char><char style="ft" closed="false">सरदार</char></note> होतो। <verse eid="JHN 3:1"/><verse number="2" style="v" sid="JHN 3:2"/>वोना रात मा यीसु को जवर आयके वोको लक कहीस, “हे पिरभू तू परमेस्वर कन लक गुरू<note caller="+" style="f"><char style="fr" closed="false">3:2</char><char style="ft" closed="false">मूलमा रब्बी लिखयो से जोन को मतलब गूरू अना सतगूरू होवासेत।</char></note> होयके आईसेस, काहे की जो निसान तु दिसावासेस, अदी परमेस्वर वोको संग नही सेत तो उ नही दिसा सकासे।”<verse eid="JHN 3:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="JHN 3:3"/>यीसु ना खरो जवाब देइस, ओला साँगीस, की अदी कोनी मानूस नवतो रीती लक जलम नही लेवासे, तो उ परमेस्वर को राज कभी नही चोय सकेत।<verse eid="JHN 3:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="JHN 3:4"/>नीकुदेमुस न ओको लक कहीस मानूस जब बुड़गा भय गयो, तबा उ कसो जलम ले सकासे? का वा आपरी माय को कोख लक दुसरो बार जलम लेहेत।<verse eid="JHN 3:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="JHN 3:5"/>यीसु ना खरो जवाब ओला देईस, “मी तुमी लक कव्हसू, जब तकन कोनी मानूस, पानी अना आतमा लक नही जलम लेहेत, ता उ परमेस्वर को राज मा धस नही सकासे। <verse eid="JHN 3:5"/><verse number="6" style="v" sid="JHN 3:6"/>काहे की जोन तन लक जलमो से उ तन सेत, अना जोन आतमा लक जलमो से वा आतमा सेत। <verse eid="JHN 3:6"/><verse number="7" style="v" sid="JHN 3:7"/>काहे चकित होवा सो, की मीना तोरो लक साँगिसेव, तोला नवतो रीती लक जलम लेनो जरूरी से। <verse eid="JHN 3:7"/><verse number="8" style="v" sid="JHN 3:8"/>वारा जितानी कन चाव्हासे उता कन चलासे, अना तु वोको सबद आयकासे, पर नही जानासो की वा किता लक आवासे अना किता लक जासे? जोन कोनी आतमा लक, जलमो से उ असोच से।”<verse eid="JHN 3:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="JHN 3:9"/>नीकुदेमुस ना वोला जवाब देइस, “असो-कसो होय सकसे?”<verse eid="JHN 3:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="JHN 3:10"/>यो आयक के यीसु ना वोको लक कहीस, “तु इसरायल लोक को गुरू होयके भी, यो गोस्टी ला नही समझीसेस।” <verse eid="JHN 3:10"/><verse number="11" style="v" sid="JHN 3:11"/>मी तोरो लक खरो कव्हसू, “आमी जोन गोस्टी जानसेजन वोला कव्होसेजन, अना जोन आमी ना चोवोसेजन ओकी गवाही देवासेजन, अना तुमी आमरो गवाही पर भरोसा नही करासो। <verse eid="JHN 3:11"/><verse number="12" style="v" sid="JHN 3:12"/>जबा मीना तुम लक, धरती की गोस्टी सांगिसेव, तो तुमी न भरोसा नही ठेवासो, अना मी तुमला सरग की गोस्टी सांगु तो कसो भरोसा ठेवने।”<verse eid="JHN 3:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="JHN 3:13"/>कोनी सरग मा नही चघयो से, पर उ चघयो से जोन सरग मा लक खाल्या उतरयो से। मजे “मानूस को टूरा” जोन सरग मा से। <verse eid="JHN 3:13"/><verse number="14" style="v" sid="JHN 3:14"/>अना जोन रीत लक, मोसे भविस्यवक्ता ना जंगल मा, सरप ला, वरता चघायो होतो। वोच रीत लक जरुरीसे की “मानूस को टूरा” भी वरता मा चघायो जाय। <verse eid="JHN 3:14"/><verse number="15" style="v" sid="JHN 3:15"/>एकोलाय जोन कोनी, वोको पर भरोसा राखेत, उ अमर जीवन पाहेत। <verse eid="JHN 3:15"/><verse number="16" style="v" sid="JHN 3:16"/>काहेका परमेस्वर ना संसार लक एतरो माया राखियो, का वोना आपरो चहतो एकच टूरा ला दे देईस। एकोलाय जोन कोनी वोको पर भरोसा राखेत, उ नास नही होहेत पर अमर जीवन पाहेत। <verse eid="JHN 3:16"/><verse number="17" style="v" sid="JHN 3:17"/>परमेस्वर ना आपरो टूरा ला दन्ड देवन ला नही, पर संसार ला सूटकारा<note caller="+" style="f"><char style="fr" closed="false">3:17</char><char style="ft" closed="false">मुक्ती, मोक्छ, पाप लक बेगरो करन को लाय</char></note> देवन लाय धाड़ीसेस।<verse eid="JHN 3:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="JHN 3:18"/>“ जोन कोनी ओको पर भरोसा राखेत, वो दन्ड नही पाहेत, पर जो लोकगीन भरोसा नही करयेत, वो खोटो मानो जाहेती। ऐको मायना असो से का उनना, परमेस्वर को एकलो चहेतो टूरा को नाव पर भरोसा नही राखिन। <verse eid="JHN 3:18"/><verse number="19" style="v" sid="JHN 3:19"/>अना दन्ड को यो कारन से, की उजाड़ो जगत मा आयो पर मानुसगिन ना इंधारो ला उजाड़ो लक ज्यादा माया करीन, काहेका, उनको काम खोटो होतीन। <verse eid="JHN 3:19"/><verse number="20" style="v" sid="JHN 3:20"/>काहेका जोन कोनी खोटो काम करनवालो को संगी से, उ उजाड़ो लक गुस्सा राखासे। अना उजाड़ो को जवर नही आवासेत, कहीं असो न होहे की उनको काम पर दोस लगाहेत। <verse eid="JHN 3:20"/><verse number="21" style="v" sid="JHN 3:21"/>पर जोन खराई पर चलासे, वा उजाड़ो को जवर आवासे, का उनको काम जोन परमेस्वर लक कियो गयो सेत पुडा आहेत।”<verse eid="JHN 3:21"/></para>
  <para style="s">यीसु को बारे मा योहन को गवाही</para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 3:22"/>येको मंघा यीसु, अना वोका चेला, यहुदिया देस मा आई होतीन, अना यीसु उनको संग रव्हके बप्तिस्मा देवन लगयो। <verse eid="JHN 3:22"/><verse number="23" style="v" sid="JHN 3:23"/>योहन भी सालेम नगर को जवर बप्तिस्मा देवत होतो, काहे का उता लगत पानी होतो, अना लोक गीन आयके बप्तिस्मा लेवत होतीन। <verse eid="JHN 3:23"/><verse number="24" style="v" sid="JHN 3:24"/>योहन वोना बेरा तकन जेल मा नही डाकयो गयो होतो।<verse eid="JHN 3:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 3:25"/>उता योहन को चेला को काही यहूदी लोकगीन संग सुध्दी को बारे मा बैस भयी। <verse eid="JHN 3:25"/><verse number="26" style="v" sid="JHN 3:26"/>अना उनना योहन को जवर आयके, वोको लक कहिन, “हे गुरू जोन मानूस यरदन नदी को वोनागन तोरो संग होतो। अना जोकि तुना गवाही देईसेस, चोव उ बप्तिस्मा देवासे, अना सबच वोको जवर आवासेत।”<verse eid="JHN 3:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="JHN 3:27"/>योहन ना जवाब देइस, “जब तकन मानूस ला सरग लक नही दियो जाय सका, तब तकन वा काही नही पाय सकासे। <verse eid="JHN 3:27"/><verse number="28" style="v" sid="JHN 3:28"/>तुमी ता खुदच मोरो गवाही सेव, की मीना साँगयो मी मसीह नही सेव, पर वोको पुढा धाड़ो गयो सेव। <verse eid="JHN 3:28"/><verse number="29" style="v" sid="JHN 3:29"/>जोन की नवरी से, उ नवरा से, पर नवरा को संगी जो उभो से, वोकी आयकसेस अना नवरा को सबद लक खुस होवासे। अता मोरो खुसि पूरी भय गयी। <verse eid="JHN 3:29"/><verse number="30" style="v" sid="JHN 3:30"/>जरुरी से की उ बढ़े अना मी घटत रहुँ।”<verse eid="JHN 3:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="JHN 3:31"/>जोन वरता लक आवासे, उ सब लक बेस से, जो धरती लक आवासे उ धरती को से, अना उ धरती को गोस्टी कव्होसे, जोन सरग लक आवासे वा सब लक वरता से। <verse eid="JHN 3:31"/><verse number="32" style="v" sid="JHN 3:32"/>जोन काही ओना चोयोसे अना आयकीसेस ओकी च गवाही ला देवासे अना कोनी वोकी गवाही नही अपनावासे। <verse eid="JHN 3:32"/><verse number="33" style="v" sid="JHN 3:33"/>जिनना वोकी गवाही अपनाय लेईसेत वोना यो गोस्टी पर छाप<note caller="+" style="f"><char style="fr" closed="false">3:33</char><char style="ft" closed="false">मुहर</char></note> लगा देइसेत की परमेस्वर खरो से। <verse eid="JHN 3:33"/><verse number="34" style="v" sid="JHN 3:34"/>काहे की जोनला परमेस्वर ना धाड़ीसेस उ परमेस्वर की गोस्टी कव्होसे, काहे की उ आतमा नाप-नाप के नही देवासे। <verse eid="JHN 3:34"/><verse number="35" style="v" sid="JHN 3:35"/>बाबूजी टूरा लक माया राखासे अना ओना चीज ला जोन ओको जवर से टूरा को हात<note caller="+" style="f"><char style="fr" closed="false">3:35 </char><char style="ft" closed="false">अधिकार</char></note> मा दे देसे। <verse eid="JHN 3:35"/><verse number="36" style="v" sid="JHN 3:36"/>जो टूरा पर भरोसा करासे, उ अमर जीवन पाहे। पर जो टूरा ला नही मानासे, उ जीवन ला नही चोय सके। पर परमेस्वर को गुस्सा वोको पर रव्होसे।<verse eid="JHN 3:36"/></para>
  <chapter eid="JHN 3"/>
  <chapter number="4" style="c" sid="JHN 4"/>
  <para style="s">यीसु अना सामरी बायका</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 4:1"/>मोसे को नियम को गुरू गिनला मालुम भयो का, यीसु योहन लक लगत चेला बनावासे अना उनला बप्तिस्मा देवासे। <verse eid="JHN 4:1"/><verse number="2" style="v" sid="JHN 4:2"/>पर यीसु खुदच बप्तिसमा नही देत होतो पर ओको चेला गीन पानी मा बप्तिस्मा देवत होतीन। <verse eid="JHN 4:2"/><verse number="3" style="v" sid="JHN 4:3"/>तबा यीसु यहुदिया छेतर ला छोड़के मंग गलील छेतर ला चलो गयो। <verse eid="JHN 4:3"/><verse number="4" style="v" sid="JHN 4:4"/>अना वहान लक होयके उ सामरिया छेतर ला जावनो जरुरी समजयो।<verse eid="JHN 4:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="JHN 4:5"/>एकोलाय उ सामरिया छेतर ला आयो ता सुखार नगर कठा आयो, यो नगर उ जघा को जवर से, जोन याकूब न आपरो टूरा यूसुफ ला देयि होतीस। <verse eid="JHN 4:5"/><verse number="6" style="v" sid="JHN 4:6"/>जबा यीसु थक गयो तो आयके जहान याकूब को बिहर होतो बस गयो। ओनो बेरा दिवस को टिकाटिक 12 बजया होतीन, यो बिहर ला याकूब खन्दो होतो।<verse eid="JHN 4:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="JHN 4:7"/>एतरो मा एक सामरिया की रव्होन वाली बायका पानी भरन ला आई। यीसु ना ओको लक कहीस, “का मोला पानी पियाव।” <verse eid="JHN 4:7"/><verse number="8" style="v" sid="JHN 4:8"/>काहे का ओको चेला ता, नगर मा जेवन लेवन ला गई होतिन।<verse eid="JHN 4:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="JHN 4:9"/>सामरी बायका वोला कव्हसे; तु ता यहूदी जात को सेस अना मि सामरी बायका आऊ, मोला पानी कायला मांगासेस। (काहे की यहुदी, सामरी लोकगीन को कोनी बरतन भांडो काम मा नही आनत होतीन)<verse eid="JHN 4:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="JHN 4:10"/>यीसु ना सांगीस, का तु परमेस्वर को बरदान ला चिन्हतीस, ता यो भी चिन्हतीस की उ कोन से, जो तोरो लक कव्होसे, का मोला पानी पियाव, तो तु मोरो लक मांगतीस। अना मि तोला जिंदगी को पानी देवतो। <verse eid="JHN 4:10"/><verse number="11" style="v" sid="JHN 4:11"/>बायका न ओला कहीस, हे पिरभू, पानी भरन ला ता बालटी नाहती, बिहर भी गहरो से, ता वो जीवन को लाई पानी तोरो जवर किता लक आहे? <verse eid="JHN 4:11"/><verse number="12" style="v" sid="JHN 4:12"/>यो तो आमरो अजी याकूब जोनना आमला यो बेहेर देइसेस। जोन मा ओना अना ओको लेकरा अना ओको मवेसी हुनार ना पीई सेजन। का तु आमरो अजी याकूब लक मोठो सेस?<verse eid="JHN 4:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="JHN 4:13"/>यीसु कव्हासे, जोन कोनी यो पानी ला पीवासे वा मंग तहान होय जाहे। <verse eid="JHN 4:13"/><verse number="14" style="v" sid="JHN 4:14"/>पर जोन कोनी यो पानी पीहे जोन मी देवासू, उ सदा लक तहान नही होहेत। पर उ पानी एक झिरिया बन जाहेत, जोन हरामेसा तकन पिझरत रहेत।<verse eid="JHN 4:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="JHN 4:15"/>बायका वोला कहीस, हे पिरभू, वा पानी मोला देव जोन लक मोला तहान नही लगहेत अना मी एतरो दुहूर पानी भरन आहू।<verse eid="JHN 4:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 4:16"/>यीसु वोला कव्हासे, जाय अना आपरो नवरा ला बुलायके आन।<verse eid="JHN 4:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="JHN 4:17"/>ता बायका ओला कव्होसे, “मि बगर नौरा की सेव।”</para>
  <para style="p" vid="JHN 4:17">यीसु न वोला जवाब देसे, तु सहीच कव्होसेस, का मोरो कोनी नौरा नहाति। <verse eid="JHN 4:17"/><verse number="18" style="v" sid="JHN 4:18"/>काहे की तु पाँच नौरा बनाय लियो से अना जोको जवर तु अता होत उ भी तोरो नवरा नाहती। मोला तुना यो खरो साँगलीस।<verse eid="JHN 4:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="JHN 4:19"/>बायका ना यीसु ला कव्हसे, हे पिरभू, “मोला असी लगासे की तु कोनी मोठो भविस्यवक्ता आस।” <verse eid="JHN 4:19"/><verse number="20" style="v" sid="JHN 4:20"/>आमरो अजी-दाजी<note caller="+" style="f"><char style="fr" closed="false">4:20 </char><char style="ft" closed="false">बाप-दादा</char></note> ना योच पहाड़ पर बलिदान चघाईसेत, पर तुम्हि कव्होसेव की वा जघा जिता बलिदान चघावनो से, यरुसलेम मा से।<verse eid="JHN 4:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="JHN 4:21"/>यीसु ना बायका ला कव्हासे, की अवो बाया, मोरो गोस्टी मा भरोसा ठेव, वा बेरा आवासे, अजीहुन को अराधना तुमी ना ता पहाड़ पर, ना यरुसलेम नगर मा करोह। <verse eid="JHN 4:21"/><verse number="22" style="v" sid="JHN 4:22"/>तुम जेनला नही जानसो वोला बलिदान चघावसो, आमी जेनला जानसेजन वोला बलिदान चघावसेजन, काहेका सूटकारा यहूदिगीन लक से। <verse eid="JHN 4:22"/><verse number="23" style="v" sid="JHN 4:23"/>पर वा बेरा आवासे पर अबा से वोमा खरो भगत सरग को दआजी की पूजा आतमा अना खराई लक करयेत। काहे का सरग को दआजि आपरो लाय असो ही भगत ला तपाससे<note caller="+" style="f"><char style="fr" closed="false">4:23</char><char style="ft" closed="false">ढुढा से</char></note>। <verse eid="JHN 4:23"/><verse number="24" style="v" sid="JHN 4:24"/>परमेस्वर आतमा से अना जरुरी से का वोकी बलिदान करनवारा आतमा अना खराई लक वोकी बलिदान करयेत।<verse eid="JHN 4:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 4:25"/>बायका कव्होसे मि जानसेउ का मसीह जोन खिस्त<note caller="+" style="f"><char style="fr" closed="false">4:25 </char><char style="ft" closed="false">अभिसिक्त</char></note> कहलावोसे उ आवनवारा सेत, जब उ आहे तबा सबच गोस्टी हमला सांग देहे।<verse eid="JHN 4:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="JHN 4:26"/>यीसु ओला कव्हासे। मि तोरो लक गोस्टी करुसेऊ, “मी वाच सेव।”<verse eid="JHN 4:26"/></para>
  <para style="s">चेला की वापिस</para>
  <para style="p">
    <verse number="27" style="v" sid="JHN 4:27"/>वाच बेरा मा चेला आय जासेत, अना यीसु ला बाई संग गोस्टी करत चोवसेत अना चकित भय जासेत। एको मंग कोनी ना असो नही पुसिन, तु काजक चाव्हसेस अना यो बाई लक काजक गोस्टी करसेस?<verse eid="JHN 4:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="JHN 4:28"/>तब च मंग बायका ना आपरो भांडो ला उतच सोड़ देइस, अना नगर ला धायके लोकहुन ला सांगासे, <verse eid="JHN 4:28"/><verse number="29" style="v" sid="JHN 4:29"/>“चलबिन एक मानूस ला चोवो, जोन मोरो बारे मा सबच काही सांग देईसेस, कहीं वोच तो मसीह नही से?” <verse eid="JHN 4:29"/><verse number="30" style="v" sid="JHN 4:30"/>एको लाय वय लोकगीन नगर ला‌ सोड़के अना यीसु को जवर आइन।<verse eid="JHN 4:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="JHN 4:31"/>वोनोच बेरा चेला ना यीसु ला बिनती करीन, “गुरू, काही जेव लेव।”<verse eid="JHN 4:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="JHN 4:32"/>यीसु उन लक कव्हासे, “जेवन लाय मोरो जवर उ जेवन से जेनला तुमी नही जानोसो।” <verse eid="JHN 4:32"/><verse number="33" style="v" sid="JHN 4:33"/>एतरो मा ओको चेला आपस मा यो कव्हन लगीन, “का कोनी ना वोको लाय काही जेवन ला आनी सेत?”<verse eid="JHN 4:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="JHN 4:34"/>यीसु ना उनला कव्हासे, जोन मोला धाड़ीसेस, वोकी मरजी पर चलहु, अना वोको काम ला पूरो करू, योच मोरो जेवन से। <verse eid="JHN 4:34"/><verse number="35" style="v" sid="JHN 4:35"/>यीसु कव्हासे, का तुमी नही कव्होसो, का अब कटनी ला चार महिना रहय गईसेत? पर मि तुमी लोकगीन लक कव्हुसू, डोरा ला उचलके उन्हारी<note caller="+" style="f"><char style="fr" closed="false">4:35 </char><char style="ft" closed="false">फसल</char></note> ला चोवो। वय कटनी को लाय पक गईसेत। <verse eid="JHN 4:35"/><verse number="36" style="v" sid="JHN 4:36"/>अबा कापनवालो रोजी पाहेत अना अमर जीवन को लाय फर सँगरेत, जिनको लाय बोवन वालो अना कापनवालो दुही मिलके खुसी मनाहेत। <verse eid="JHN 4:36"/><verse number="37" style="v" sid="JHN 4:37"/>काहे का यो हाना खरो बससे, एक से ता बोवासे अना दुजो से तो कापसे। <verse eid="JHN 4:37"/><verse number="38" style="v" sid="JHN 4:38"/>मिना तुमला वा खेत कापन लाय धाड़िसेउ, जिनमा तुमी ना मेहनत नही करयत। दुजा ऐमा मेहनत करीसेत अना तुमला वोको मेहनत को फर मिलिसे।<verse eid="JHN 4:38"/></para>
  <para style="s">सामरीहिन को भरोसा राखनो</para>
  <para style="p">
    <verse number="39" style="v" sid="JHN 4:39"/>ता उ यहुदिया ला सोड़के मंग लवटके गलील ला चली गयो। ओनो बायको को गवाही ला जो यीसु ना ओको बारे मा सब काही कही होतीस यो गवाही ला आयक के ओनो नगर को लगत सो सामरीहुन ना यीसु मा भरोसा कर लेइन। <verse eid="JHN 4:39"/><verse number="40" style="v" sid="JHN 4:40"/>एको लाय जबा वय सामरी यीसु जवर आइन त यीसु लक बिनती करिन का तु आमरो इता रुक। वा दुई दिवस उतच रहयो।<verse eid="JHN 4:40"/></para>
  <para style="p">
    <verse number="41" style="v" sid="JHN 4:41"/>लगत लोकगीन ना वोको सिक्सा ला आयकीन अना वोको पर भरोसा करन लगीन। <verse eid="JHN 4:41"/><verse number="42" style="v" sid="JHN 4:42"/>अना सामरीगिन वा बाई ला बोलिन का, अता त आमी तोरो कव्हन लक भरोसा नही करबिन। आमी खुदच वोला आयक लेई सेजन। अना आमी जान सेजन, का उ खरो-खर मा संसार को बचावनवारो से।<verse eid="JHN 4:42"/></para>
  <para style="p">
    <verse number="43" style="v" sid="JHN 4:43"/>जबा दुई दिवस बीत गईन, तबा यीसु वहान लक गलील छेतर ला गयो। <verse eid="JHN 4:43"/><verse number="44" style="v" sid="JHN 4:44"/>यीसु खुदच गवाही देवत होतो का आपरो देस मा भविस्यवक्ता को मान नही होवा। <verse eid="JHN 4:44"/><verse number="45" style="v" sid="JHN 4:45"/>जबा यीसु गलील छेतर ला पहुचियो, तबा लोकगीन ना वोको मिजवानी करीन। काहेका यीसु तिहार को दिवस यरुसलेम मा जो काही कियो होतो, ओला सबला गलील छेतर का रहोन वालो ना चोइन होतीन, काहे का तिहार मा वय सबच उतच होतीन।<verse eid="JHN 4:45"/></para>
  <para style="s">राजा को करमचारी को टूरा ला साजरो करनो</para>
  <para style="p">
    <verse number="46" style="v" sid="JHN 4:46"/>यीसु मंग गलील छेतर को काना नगर मा आयो, जिता वोने पानी ला अंगूर को रस बनायी होतीस। उता एक करमचारी होतो, जोन कफरनहुम नगर को रव्होन वालो होतो, वोको टूरा बीमार होतो। <verse eid="JHN 4:46"/><verse number="47" style="v" sid="JHN 4:47"/>जबा उ करमचारी ना कव्हयो, का यीसु यहुदिया छेतर लक गलील छेतर मा आइसे, तब उ वोको जवर आयो। अना ओको लक पिराथना करासे का, उ चलके वोको टूरा ला साजरो कर दे, काहेका वा मरनो पर होतो। <verse eid="JHN 4:47"/><verse number="48" style="v" sid="JHN 4:48"/>यीसु ना वोला कहीस, का तुमी निसान अना चमतकार ला चोयके मोरो पर भरोसा करोसो।<verse eid="JHN 4:48"/></para>
  <para style="p">
    <verse number="49" style="v" sid="JHN 4:49"/>यो गोस्टी पर करमचारी ना ओको लक कहीस, पिरभू किरपा कर अना मोरो टूरा को मरन को पुढा चल।<verse eid="JHN 4:49"/></para>
  <para style="p">
    <verse number="50" style="v" sid="JHN 4:50"/>यीसु ना वोला कहीस, “जाय तोरो टूरा जित्तो से,”</para>
  <para style="p" vid="JHN 4:50">उ वोको कव्हन पर भरोसा करके चलो गयो।<verse eid="JHN 4:50"/></para>
  <para style="p">
    <verse number="51" style="v" sid="JHN 4:51"/>उ रास्ता पर जाय रहयो होतो, एतरो मा वोको दास गीन आयके वोला कव्हन लगीन, की तोरो टूरा जित्तो से।<verse eid="JHN 4:51"/></para>
  <para style="p">
    <verse number="52" style="v" sid="JHN 4:52"/>वोना उन ला पुसयो, का उ कोन सो बेरा मा साजरो भयो। उनना वोला कहिन, “काल दिवस को एक बजे वोको बुखार ठीक भयो।” <verse eid="JHN 4:52"/><verse number="53" style="v" sid="JHN 4:53"/>तबा उ समज गयो का ठीक वोच बेरा यीसु ना कहीस होतो, का जाय तोरो टूरा जित्तो से। अना वोने आपरो सप्पा घर सकट भरोसा करन लगयो।<verse eid="JHN 4:53"/></para>
  <para style="p">
    <verse number="54" style="v" sid="JHN 4:54"/>यो यीसु को दुसरो निसान होतो। जो वोने यहुदिया छेतर लक आयके गलील छेतर मा दिसाईस।<verse eid="JHN 4:54"/></para>
  <chapter eid="JHN 4"/>
  <chapter number="5" style="c" sid="JHN 5"/>
  <para style="s">अड़तीस साल को रोगी ला साजरो करनो</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 5:1"/>एको काही रोज बाद मा यीसु यहूदी लोकहुन को एक तिहार बेरा मा यरुसलेम तीरथ ला गयो। <verse eid="JHN 5:1"/><verse number="2" style="v" sid="JHN 5:2"/>यरुसलेम मा भेड़ बेसकुड़ को जवर एक कुन्ड से, इब्रानी भासा मा येला बेतहसेदा कहयो जासे। एको जवर पाँच छप्पर बनयो सेत। <verse eid="JHN 5:2"/><verse number="3" style="v" sid="JHN 5:3"/>वोमा लगत सा बीमार अँधरा, लँगडा, अना लकवा वालो पड़या रहोत होतिन। वय पानी ला हिलन की रास्ता चोवत होतीन। <verse eid="JHN 5:3"/><verse number="4" style="v" sid="JHN 5:4"/>काहे का पिरभू को सरग दुत बेरा-बेरा मा कुन्ड मा उतरके पानी ला हिलावत होतीन। पानी हिलन को बेरा जोन मानूस पहेले कुन्ड मा उतरत होतो, चाहे उ कोनी भी रोग लक होयहेत, उ साजरो भय जात होतो। <note caller="+" style="f"><char style="fr" closed="false">5:4 </char><char style="ft" closed="false">काही जूनो लिखयो नकल मा यो पद नहात।</char></note> <verse eid="JHN 5:4"/><verse number="5" style="v" sid="JHN 5:5"/>उता कन एक मानूस होतो जोन अड़तीस बरस लक बीमार होतो। <verse eid="JHN 5:5"/><verse number="6" style="v" sid="JHN 5:6"/>जबा यीसु ना वोला वहान लेटो चोयीस अना यो जानके का उ एतरो लम्बो बेरा लक रोगी से ता यीसु ओला कव्हासे, “का तू साजरो होवनो चाव्हासे?”<verse eid="JHN 5:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="JHN 5:7"/>बीमार ना कहीस, पिरभू! मोरो कोनी नाहात, की जोन पानी हिलन को बेरा मोला कुन्ड मा उतारहेत। मोरो उतरनो को पुढ़ा च, कोनी दुसरो मोरो लक पयले उतर जासे।<verse eid="JHN 5:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="JHN 5:8"/>यीसु ना वोला कहीस, उभो होय! आपरो दरी ला उचल अना हिंड।<verse eid="JHN 5:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="JHN 5:9"/>गदने उ मानूस चाँगलो भय गयो, अना आपरो दरी ला उचलके हिंडन लगयो। <verse eid="JHN 5:9"/><verse number="10" style="v" sid="JHN 5:10"/>ओला हिंडतो चोयके यहुदी अधिकारी ना ओनो मानूस कव्हन लगीन की तोला कउन ना साजरो करीसेस? काहेकि यो ता बिसराम को दिवस से यो कानुन को बिरोध मा से, आज को दिवस तोला आपरो दरी उचलनो भी साजरो नहोती। <verse eid="JHN 5:10"/><verse number="11" style="v" sid="JHN 5:11"/>वोना उन ला जवाब देइस, “जोन मानूस मोला साजरो करीसेस, वोच न मोला कहिसेस, आपरो दरी ला उचल अना हिंडबिन।”<verse eid="JHN 5:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 5:12"/>उनना वोको लक पुसिन, “उ कोन मानूस से? जोन तोला कहिसेस, दरी उचल अना हिंड।”<verse eid="JHN 5:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="JHN 5:13"/>पर उ मानूस जोन साजरो भयो होतो, नही जानत होतो का उ कोन आय, काहेका ओनो जघा लगत भीड़ होती एकोलाई यीसु ओको लक दुहूर चली गयो होतो।<verse eid="JHN 5:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="JHN 5:14"/>येने गोस्टी को मंघा, रोगी यीसु ला मंदिर मा भेटयो। यीसु ना वोला कहीस, चोव! तु साजरो भय गईसेस, मंग पाप नोको करबिन, नही ता अखिन कोनी मोठी आफद तोरो पर आन पड़ेहत।<verse eid="JHN 5:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="JHN 5:15"/>ओना जायके यहूदि अधिकारीहुन ला कव्ह देसे, उ यीसु होतो, जेने मोला चांगलो करीसेस। <verse eid="JHN 5:15"/><verse number="16" style="v" sid="JHN 5:16"/>काहेकि यीसु ना बिसराम दिवस मा साजरो करन को काम करीसे, एकोलाई यहुदीहुन ओला सतावन लगीन। <verse eid="JHN 5:16"/><verse number="17" style="v" sid="JHN 5:17"/>यीसु ना उनला जवाब देईस, मोरो दाअजी अजी हमेसा काम करतो रव्हसे, एकोलाई मि भी काम करासेऊ। एकोलाई यहुदी ओला मार डाकन को कोसिस करत होतीन।<verse eid="JHN 5:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="JHN 5:18"/>नाच केवल एकोलाई का उ बिसराम ला तोड़ रहयो होतो बल्कि उ परमेस्वर ला आपरो बाबूजी भी कव्हत होता। अना एकोलाई अपरो आपला परमेस्वर को जसो ठहरात होतो।<verse eid="JHN 5:18"/></para>
  <para style="s">टूरा को हक</para>
  <para style="p">
    <verse number="19" style="v" sid="JHN 5:19"/>ऐना रिती यीसु ना उन लक साँगीस, मि तुमी लक खरो कव्हासेऊ, “टूरा खुदच काही नही कर सका, केवल परमेस्वर दाअजी जोन वोला करन ला कव्हासे, काहे का जोन काम ला दाअजी करासे, वसोच टूरा भी वोच रिती लक करासे।” <verse eid="JHN 5:19"/><verse number="20" style="v" sid="JHN 5:20"/>काहे का परमेस्वर दाअजी टूरा ला माया राखासे। अना जोन-जोन काम उ खुद करासे, उ सबला वोला दिसावासे अना यो काम लक मोठो काम वोला दिसाये। काहे का तुमी चकित होवो। <verse eid="JHN 5:20"/><verse number="21" style="v" sid="JHN 5:21"/>जसो की दाअजी मरयो हुयो ला जित्तो उचलासे, अना जिंदगी भी देसे। वसोच टूरा भी जेनला उ चाव्हासे ओला जित्तो कर देसे। <verse eid="JHN 5:21"/><verse number="22" style="v" sid="JHN 5:22"/>दाअजी कोनी को न्याय नही करासे, पर न्याय करन साठी हक टूरा ला देइसेस। <verse eid="JHN 5:22"/><verse number="23" style="v" sid="JHN 5:23"/>मनजे कोनी टुआ को मान करहेत वसोच दाअजी को मान करहेत। जोन टूरा को मान नही करासे, उ दाअजी को जोने वोला धाडीसेस, मान नही करासे।<verse eid="JHN 5:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="JHN 5:24"/>मि तुमी लक खरो सांगिसेउ,“ जोन मोरी गोस्टी आयक के मोरो धाड़नवालो पर भरोसा करासे, वोको जवर अमर जीवन से अना ओको पर सजा की हुकूम नही होवासे। पर उ मिरतु लक पार भयके जीवन मा धसेत।” <verse eid="JHN 5:24"/><verse number="25" style="v" sid="JHN 5:25"/>मि तुमी लक खरो सांगिसेउ, “उ बेरा आवासे अना अबा भी से, जोनमा मरया हुया परमेस्वर दाअजी को टूरा की आवाज आयकेत। अना जोन कोनी आयकेत वय जित्तो होयेती।” <verse eid="JHN 5:25"/><verse number="26" style="v" sid="JHN 5:26"/>“काहे की जोन रिती लक दाअजी जीवन राखासे, वोच रिती लक वोना टूरा ला भी यो हक दियो से का आपरो आप मा जीवन राखे। <verse eid="JHN 5:26"/><verse number="27" style="v" sid="JHN 5:27"/>वरन वोला न्याय करन को भी हक दियो गईसे, एको लाय उ मानूस को टूरा से। <verse eid="JHN 5:27"/><verse number="28" style="v" sid="JHN 5:28"/>एको लाय चकित नोको हुओ, काहे का उ बेरा आवासे का जेतरा मरा हुआ सेत, वय वोकी आवाज आयक के मरघट्टी लक हिटहेत। <verse eid="JHN 5:28"/><verse number="29" style="v" sid="JHN 5:29"/>जिनना साजरो करीसेत, वय जीवन को लाय <note caller="+" style="f"><char style="fr" closed="false">5:29 </char><char style="ft" closed="false">मरो मे से जी उठना</char></note> अना जोनना बुरो करीसेत, वय सजा को लाय, जित्तो होयेती।”<verse eid="JHN 5:29"/></para>
  <para style="s">यीसु को बारे मा गवाही</para>
  <para style="p">
    <verse number="30" style="v" sid="JHN 5:30"/>“मि आपरो लक काही नही कर सकु, जसो आयकासेऊ वसोच न्याय करासेउ, काहेकि मोरो न्याय खरो से काहेका मि आपरी मरजी लक नही पर आपरो धाड़न वालो की मरजी ला चाहव्सेउ।”<verse eid="JHN 5:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="JHN 5:31"/>अदी मि आपरो गवाही<note caller="+" style="f"><char style="fr" closed="false">5:31 </char><char style="ft" closed="false">प्रमान</char></note> आपच देवासु, तो यो गोस्टी खरो नाहती। <verse eid="JHN 5:31"/><verse number="32" style="v" sid="JHN 5:32"/>एक अखीन से जो मोरी गवाही देसे, अना मि जानासू का जोन यो गोस्टी ला पुरुप करासे, उ खरो से। <verse eid="JHN 5:32"/><verse number="33" style="v" sid="JHN 5:33"/>तुमी ना लोक गीनला योहन को जवर पुछन लाई धाड़यात अना वोना खरो गवाही सांगिसेस। <note caller="+" style="f"><char style="fr" closed="false">5:33</char><char style="ft" closed="false">बयान दिया</char></note> <verse eid="JHN 5:33"/><verse number="34" style="v" sid="JHN 5:34"/>मि मानूस को गवाही पर आसरित नही सेऊ। तरी मि एकलाय कव्हासेउ जेकोलक तुमरो बचाव भय सकेत। <verse eid="JHN 5:34"/><verse number="35" style="v" sid="JHN 5:35"/>योहन ओनो दियो को जसो होतो जोन जलतो हुयो से अना उजाड़ो देसे। अना तुमी काही बेरा को लाई ओको उजाड़ो को खुसी मनावन चाव्हत होता। <verse eid="JHN 5:35"/><verse number="36" style="v" sid="JHN 5:36"/>पर मोरो जवर जोन गवाही से, उ योहन की गवाही लक मोठी से। अना जोन काम परमेस्वर दाअजी ना मोला पूरो करन लाई, देईसेस। मजे वय योच काम सेत, जोन मि करुसेउ, वय मोरो सबुत<note caller="+" style="f"><char style="fr" closed="false">5:36 </char><char style="ft" closed="false">सबुत</char></note> सेती, का परमेस्वर दाअजी ना मोला धाड़ीसेस। <verse eid="JHN 5:36"/><verse number="37" style="v" sid="JHN 5:37"/>परमेस्वर दाअजी ना जेना मोला धाड़ीसेस, मोरी गवाही देईसेस। तुमी लोकहुन ना ओको गोस्टी कबच नही आयकियत अना न तुमीना ओको रूप चोयीसेव। <verse eid="JHN 5:37"/><verse number="38" style="v" sid="JHN 5:38"/>अखिन नाच तुमी आपरो भीतर ओको खबर ला अपनायो सेव। काहेकी तुमी ओमा बिस्वास नही राखासेव जेनला परमेस्वर दाअजी ना धाड़ीसेस। <verse eid="JHN 5:38"/><verse number="39" style="v" sid="JHN 5:39"/>तुमी गिरंथहुन मा वाचासो, काहेका तुम्हि समजासो की ओमा अमर जिंदगी तुमला मिलेहत। अना यो वाचासो जोनमा मोरो बारे मा सबूत कहयो गयो से। <verse eid="JHN 5:39"/><verse number="40" style="v" sid="JHN 5:40"/>मंगच तुमी जिंदगी पावन लाई मोरो जवर नही आवन चाव्हसो।<verse eid="JHN 5:40"/></para>
  <para style="p">
    <verse number="41" style="v" sid="JHN 5:41"/>मि मानूस लक मान- मरयादा नही चाव्हसेउ। <verse eid="JHN 5:41"/><verse number="42" style="v" sid="JHN 5:42"/>पर मि जानसेउ का तुमी मा परमेस्वर को माया नहात। <verse eid="JHN 5:42"/><verse number="43" style="v" sid="JHN 5:43"/>मि आपरो दाअजी को नाव लक आईसेऊ मंग तुमी लोकहून मोला नही अपनावा सेव। अदी कोनी आपरो नाव लक आहे तो ओला तुमी अपनाय लेहो। <verse eid="JHN 5:43"/><verse number="44" style="v" sid="JHN 5:44"/>तुमी मोरो पर बिस्वास कसो कर सकासेव? काहेकि तुमी ता एकमेक लक मान- मरयादा चाव्हासेव। अना उ मान- मरयादा जोन एक परमेस्वर को कन लक से, नही चाव्हासेव। <verse eid="JHN 5:44"/><verse number="45" style="v" sid="JHN 5:45"/>यो नोको समजो का मि परमेस्वर दाअजी को पुढ़ा तुमी पर दोस लगाव सेउ। तुमी पर दोस लगावन वालो मोसे से, जोन पर तुमी ना आस राखयत। अदि तुमी मोसे पर सही मा बिस्वास करासेव <verse eid="JHN 5:45"/><verse number="46" style="v" sid="JHN 5:46"/>ता तुमी मोरो मा भी बिस्वास करतत काहेकि मोसे ना मोरो बारे मा लिख्यो से। <verse eid="JHN 5:46"/><verse number="47" style="v" sid="JHN 5:47"/>जबा तुमी, जोन ओना लिख्यो सेस ओमा बिस्वास नही करासेव, “ता मोरो गोस्टी मा बिस्वास कसो करोह?”<verse eid="JHN 5:47"/></para>
  <chapter eid="JHN 5"/>
  <chapter number="6" style="c" sid="JHN 6"/>
  <para style="s">पाँच हजार मानूस ला जेवानो</para>
  <para style="r">(<ref loc="MAT 14:13-21">मत्ती 14:13-21</ref>; <ref loc="MRK 6:30-44">मरकुस 6:30-44</ref>; <ref loc="LUK 9:10-17">लूका 9:10-17</ref>)</para>
  <para style="m">
    <verse number="1" style="v" sid="JHN 6:1"/>एको मंघा यीसु गलील नगर को तिबिरियास नाव को झील को वोनागन चली गयो। <verse eid="JHN 6:1"/><verse number="2" style="v" sid="JHN 6:2"/>अना ओको मंघा एक मोठी भीड़ वोको मंघा भय गई, काहे का उनना रोगीहुन ला साजरो करन लाय अदभुत हिदान चोवायो होता। <verse eid="JHN 6:2"/><verse number="3" style="v" sid="JHN 6:3"/>तबा यीसु पहाड़ मा चघके आपरो मंघा आवनवालो चेलाहुन को संग उता बस गयो। <verse eid="JHN 6:3"/><verse number="4" style="v" sid="JHN 6:4"/>यहूदिगीन को फसह को तिहार जवर होतो। <verse eid="JHN 6:4"/><verse number="5" style="v" sid="JHN 6:5"/>जबा यीसु ना एक मोठी भीड़ ला आपरो जवर आवत चोवीस, तबा ओना फिलिप्पुस लक पुसिस, हमि इनको लाई जेवन किता लक आनबिन? <verse eid="JHN 6:5"/><verse number="6" style="v" sid="JHN 6:6"/>यीसु यो गोस्टी ओको परिक्सा लेवन को लाई कही होतीस, काहे का उ खुदच जानत होतो, का उ काजक करन जाय रही से?<verse eid="JHN 6:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="JHN 6:7"/>फिलिप्पुस न ओला जवाब देईस, का दुई सौ सिक्का <note caller="+" style="f"><char style="fr" closed="false">6:7</char><char style="ft" closed="false">एक दिवस भर की मजदुरी एक सिक्का होतो</char></note>की जेवन भी उनला ला कम पड़हेत। पर हरेक झनला जरा-जरा बाँटनो पर जरा लगत बाँटा नही आहेत।<verse eid="JHN 6:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="JHN 6:8"/>ओको चेला मा एक अखिन, जोन समौन पतरस को भाऊ अन्दिरयास होतो, ओना यीसु ला कहीस, <verse eid="JHN 6:8"/><verse number="9" style="v" sid="JHN 6:9"/>इता एक टूरा से, जोको जवर, जौ को पांच भाकर अना दुई मसरी सेती। पर एतरो लोकहुन लाय नही होवन की।<verse eid="JHN 6:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="JHN 6:10"/>यीसु न कहीस, लोकहुन ला गवथ मा बसाय देव। तबा मरद-माना<note caller="+" style="f"><char style="fr" closed="false">6:10 </char><char style="ft" closed="false">मानूस</char></note> जिनकी गिनती पांच हजार को करिब होती। बर्रा मा गवथ पर बसाय देईन। <verse eid="JHN 6:10"/><verse number="11" style="v" sid="JHN 6:11"/>तबा यीसु ना भाकर लेइस, अना परमेस्वर ला धनवाद करके लोकहून ला पगंत मा परस देइन, वसोच मसरी ला भी मन को मरजी लक बाट देइन। <verse eid="JHN 6:11"/><verse number="12" style="v" sid="JHN 6:12"/>जबा वय जेयके के अघा गईन, तबा यीसु आपरो चेला गीन ला कहीस, बचयो टुकड़ा-टाकड़ी ला सकेल लेव, नास नोको करो। <verse eid="JHN 6:12"/><verse number="13" style="v" sid="JHN 6:13"/>तबा जेवन को मंघा उनना जौ को भाकरी को बारा टोपली टुकड़ा-टाकड़ी ला जमा करीन।<verse eid="JHN 6:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="JHN 6:14"/>यीसु को यो चमत्कार चोयके लोकहुन ना कहयो, “पिक्को मा यो भविस्यवक्ता से जोन संसार मा आवन वारो होतो।” <verse eid="JHN 6:14"/><verse number="15" style="v" sid="JHN 6:15"/>यीसु ना यो जानके क वय मोला राजा बनान लाय धरन चाव्हासेत, एकोलाय उ पहाड़ पर चली गयो।<verse eid="JHN 6:15"/></para>
  <para style="s">यीसु को पानी पर चलनो</para>
  <para style="r">(<ref loc="MAT 14:22-33">मत्ती 14:22-33</ref>; <ref loc="MRK 6:45-52">मरकुस 6:45-52</ref>)</para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 6:16"/>जब झूलाखाली भई, ता ओको चेला झील को कन गईन। <verse eid="JHN 6:16"/><verse number="17" style="v" sid="JHN 6:17"/>अना नाव मा चघके सागर को ओनागन, कफरनहुम नगर ला जावन लगीन। ओना बेरा जेवन रात भई गई होती। अना यीसु उनको कठा नही आयो होतो। <verse eid="JHN 6:17"/><verse number="18" style="v" sid="JHN 6:18"/>मोठो आंधड़ आवन लगी अना पानी मा लहर चलन लगी, <verse eid="JHN 6:18"/><verse number="19" style="v" sid="JHN 6:19"/>तबा वय डोंगा चलात-चलात सह किलोमीटर तकन निकल गईन। तबा उनना यीसु ला सागर पर चलता, अना नाव को कठा आवता चोयीन, तो डराय गईन। <verse eid="JHN 6:19"/><verse number="20" style="v" sid="JHN 6:20"/>तबा यीसु उनला कव्हसे, डराव नोको, “काहेकि मि सेऊ।” <verse eid="JHN 6:20"/><verse number="21" style="v" sid="JHN 6:21"/>मंग उनना ओला गदने नाव मा चघाय लेईन, ता गदने डोंगा वोना जघा पर पहुच गयी, जिता उनला जानो होतो।<verse eid="JHN 6:21"/></para>
  <para style="s">लोक ला यीसु को चोवनो</para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 6:22"/>दुसरो दिवस लोकहून को ओना भीड़ ना जोन झील को ओनागन रह गयी होती, चोयिन का वहान केवल एक डोंगा होतो, अना अपरो चेलाहुन को संग यीसु नही गयो होतो, पर ओको चेलागीन च चले गयो होतीन। <verse eid="JHN 6:22"/><verse number="23" style="v" sid="JHN 6:23"/>तबा ओनाच बेरा मा, काही लोक नाव तिबिरियास लक वोना जघा को जवर आइन, जहान उनना पिरभू को पिराथना-धनवाद करके ना भाकर जेयी होतीन। <verse eid="JHN 6:23"/><verse number="24" style="v" sid="JHN 6:24"/>तबा लोकगीन ना चोयीन का यहान, यीसु अना चेला गीन नहात, ता वय नहानी डोंगी मा चघके, यीसु ला ढुंढत-ढांढत कफरनहुम मा पहुँचईन।<verse eid="JHN 6:24"/></para>
  <para style="s">यीसु जिन्दगी को भाकर</para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 6:25"/>झील को ओनागन जबा वय लोक यीसु लक मिलिन ता उनना ओला सांगीन, ओ गुरू, इता तु कब लक आईसेस?<verse eid="JHN 6:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="JHN 6:26"/>यीसु उनला कव्हासे। खरो-खर तुमी मोला एकोलाय नही पुसासेव, की तुम्हिना अचंभा वालो निसान चोयोसेव, पर भाकर जेयके अघाइसो। <verse eid="JHN 6:26"/><verse number="27" style="v" sid="JHN 6:27"/>नास होवन वालो जेवन लाई मेहनत कायलाई करोसो? पर उ जेवन लाई मेहनत करो, जोन अमर जीवन लाई से। काहेकि उ जेवन मानूस को टूरा देहे, काहेका परमेस्वर दाअजी ना यो देन को हक वोला देईसेस। मजे परमेस्वर ना छाप लगाइसे।<verse eid="JHN 6:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="JHN 6:28"/>एतरो आयक के उनना कहीन, परमेस्वर को काम करन ला आमी का करबिन।<verse eid="JHN 6:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="JHN 6:29"/>यीसु ना जवाब देइस, परमेस्वर का काम यो से की तुमी मोरो भरोसा पर करो काहेकी परमेस्वर ना मोला धाड़िसेस।<verse eid="JHN 6:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="JHN 6:30"/>तब ओन्हीसीन कहिन, मंग तु कोनतो निसान दिसावासेस की आमी चोवके तोरो भरोसा पर करबिन। <verse eid="JHN 6:30"/><verse number="31" style="v" sid="JHN 6:31"/>आमरो बाप-दादा ना जंगल मा मन्ना<note caller="+" style="f"><char style="fr" closed="false">6:31 </char><char style="ft" closed="false">सरग की भाकर</char></note> खाईन, जसो लिखयो से, वोना उनला खावन लाई सरग की भाखर देइस।<verse eid="JHN 6:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="JHN 6:32"/>यीसु ना कहीस, का मि तुम लक खरो कव्हसू, “का मोसे ना तुम्हिला वा भाकर सरग लक नही देइस, पर मोरो दाअजी तुमला सच्ची भाखरी सरग लक देसे। <verse eid="JHN 6:32"/><verse number="33" style="v" sid="JHN 6:33"/>काहे का परमेस्वर की भाकर वाच से जोन सरग लक उतरीसे अना संसार ला जिंदगी देसे।”<verse eid="JHN 6:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="JHN 6:34"/>तबा ओन्हीसीन कहिन, हे पिरभू यो भाकर हमला सबा बेरा देजोस।<verse eid="JHN 6:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="JHN 6:35"/>यीसु ना उनला कहीस, “जिंदगी की भाकर मि सेव, जो मोर कगर<note caller="+" style="f"><char style="fr" closed="false">6:35 </char><char style="ft" closed="false">जवर</char></note> आवासे, ओला कभ्भु भुख नही लगेत, अना जोन मोरो पर भरोसा ठेवासे, ओला कभ्भु तहान नही लगेत।” <verse eid="JHN 6:35"/><verse number="36" style="v" sid="JHN 6:36"/>तुमना मोला चोय भी लियत ता भी भरोसा नही ठेवासो। <verse eid="JHN 6:36"/><verse number="37" style="v" sid="JHN 6:37"/>जोन कोनी ला परमेस्वर दाअजी मोरो कठा धाड़ासे, उ मोरो कठा आहेत। अना जो कोनी मोरो कठा आहेति ओला मि कभ्भुच नही हेड़ु। <verse eid="JHN 6:37"/><verse number="38" style="v" sid="JHN 6:38"/>काहे का मि आपरी मरजी ला नही पर परमेस्वर की मरजी पूरी करनलाय सरग लक आईसेऊ। <verse eid="JHN 6:38"/><verse number="39" style="v" sid="JHN 6:39"/>परमेस्वर की मरजी यो से की जिनला ओना मोला देईसेस उनमा लक मि कोनी ला नही खोउँ, पर आखीर मा ओला जित्तो कर देहुँ। <verse eid="JHN 6:39"/><verse number="40" style="v" sid="JHN 6:40"/>काहेकी परमेस्वर की मरजी यो से की जोन कोनी मोला चोहे, अना मोरो पर भरोसा ठेये उ अमर जिंदगी पाहेत।<verse eid="JHN 6:40"/></para>
  <para style="p">
    <verse number="41" style="v" sid="JHN 6:41"/>एको लाय यहूदिगीन वोको पर कुड़कुड़ान लगीन, की ओना कव्हयो होतो की जोन भाकर सरग लक उतरीसे, उ मि सेव। <verse eid="JHN 6:41"/><verse number="42" style="v" sid="JHN 6:42"/>अना उनको कव्हनो यो होतो, का यो यूसुफ को टूरा यीसु नहाती का, जोनको माय-अजी ला आमी जाना सेजन? ता उ कसो कव्हसे का, मि सरग लक आईसेऊ?<verse eid="JHN 6:42"/></para>
  <para style="p">
    <verse number="43" style="v" sid="JHN 6:43"/>यीसु उनला जवाब देसे, आपस मा नोको कुड़कुड़ाओ। <verse eid="JHN 6:43"/><verse number="44" style="v" sid="JHN 6:44"/>कोनी मोर कठा नही आय सका, जब तकन दाअजी परमेस्वर जोन मोला धाड़िसेस, ओला नोको झीक लेय। <verse eid="JHN 6:44"/><verse number="45" style="v" sid="JHN 6:45"/>भविस्यवक्ता गीनको लेख मा यो लिखयो से। वय सब परमेस्वर को कन लक सिकायो होयेति। जोन कोनी ना दाअजी लक आयकिया अना सिकाया होयेत, उ मोर कठा आहेति। <verse eid="JHN 6:45"/><verse number="46" style="v" sid="JHN 6:46"/>एको अरथ यो नहोती का कोनी ना दाअजी ला चोयीसेस, पर वाच जोन परमेस्वर कन लक आयीसे ओनाच दाअजी ला चोयीसे। <verse eid="JHN 6:46"/><verse number="47" style="v" sid="JHN 6:47"/>मि तुम लक खरो साँगुसु, जोन कोनी भरोसा करासे वाच अमर जिंदगी पाहेत। <verse eid="JHN 6:47"/><verse number="48" style="v" sid="JHN 6:48"/>मि जिंदगी की भाकर सेव। <verse eid="JHN 6:48"/><verse number="49" style="v" sid="JHN 6:49"/>तुमरो आजा-पुरखागीन ना जंगल मा मन्ना<note caller="+" style="f"><char style="fr" closed="false">6:49 </char><char style="ft" closed="false">सरग की भाकर</char></note> खाईन पर वय मर गईन। <verse eid="JHN 6:49"/><verse number="50" style="v" sid="JHN 6:50"/>यो वा भाखर से, जोन सरग लक उतरीसे, एकोलाय जोन कोनी ओनो भाखर ला खाहे उ नही मरेत। <verse eid="JHN 6:50"/><verse number="51" style="v" sid="JHN 6:51"/>जीवन की भाकर जोन सरग लक उतरी से, मि सेव। जोन यो भाकर मा लक खाये उ सदा जित्तो रहेत, अना जोन भाकर मि संसार को जिन्दगी को लाय देहुँ, उ मोरो देह से।<verse eid="JHN 6:51"/></para>
  <para style="p">
    <verse number="52" style="v" sid="JHN 6:52"/>येने गोस्टी पर यहूदिगीन आपस मा झगड़न लगीन, यो मानूस कसो हमला आपरो देह खावन लाई दे सकासे?<verse eid="JHN 6:52"/></para>
  <para style="p">
    <verse number="53" style="v" sid="JHN 6:53"/>यीसु उन ला कहीस, मि खरो-खरो साँगुसु की जबा तकन मानूस को टूरा को माँस नही खाओ, अना मोरो खून नही पिवने, तबा तकन, तुमरो मा जिंदगी नही रहेत। <verse eid="JHN 6:53"/><verse number="54" style="v" sid="JHN 6:54"/>जोन मोरो माँस खावसे अना खून पिवासे, अमर जिंदगी ओकोच से, अना आखीर मा ओला मंग जीत्तो करू। <verse eid="JHN 6:54"/><verse number="55" style="v" sid="JHN 6:55"/>काहे का मोरो माँस सहीच मा खावन की चीज से अना मोर खून सही मा पिवन की चीज से। <verse eid="JHN 6:55"/><verse number="56" style="v" sid="JHN 6:56"/>जोन मोरो माँस खावासे अना मोरो खून पिवासे, उ मोरो मा अडिग<note caller="+" style="f"><char style="fr" closed="false">6:56 </char><char style="ft" closed="false">मजबुत</char></note> बनयो रहोसे, अना मि ओमा बनयो रहुसु। <verse eid="JHN 6:56"/><verse number="57" style="v" sid="JHN 6:57"/>जसो जित्तो परमेस्वर ना मोला धाड़ीसेस अना जिंदगी देइसेस वसोच जोन मोरो माँस ला खावसे। उ भी जित्तो रहेत। <verse eid="JHN 6:57"/><verse number="58" style="v" sid="JHN 6:58"/>जो भाकर सरग लक उतरी याच से, उ भाकर को जसो नही जेनला तुमरो आजा-पुरखा ना खाईन अना मर गईन। जोन कोनी यो भाकर खाये उ सदा जित्तो रहेत।<verse eid="JHN 6:58"/></para>
  <para style="p">
    <verse number="59" style="v" sid="JHN 6:59"/>यीसु ना यो गोस्टी कफरनहुम गाँव को एक सभाघर मा सिक्सा देवतो बेरा कहीस।<verse eid="JHN 6:59"/></para>
  <para style="s">अमर जिन्दगी को गोस्टी</para>
  <para style="p">
    <verse number="60" style="v" sid="JHN 6:60"/>ओको चेला मा लक बहुत लोकगीन यो आयक के कहिन यो गजब कठीन सिक्सा से, येला कोन आयक सकासे।<verse eid="JHN 6:60"/></para>
  <para style="p">
    <verse number="61" style="v" sid="JHN 6:61"/>यीसु न आपरो मन मा यो जानके का चेला आपस मा यो गोस्टी लक कुड़कुड़ावा सेति, उन लक पुसिस, का यो सिक्सा तुमला कठिन लगासे। <verse eid="JHN 6:61"/><verse number="62" style="v" sid="JHN 6:62"/>अदी तुमी मानूस को टूरा ला जिता उ पयले होतो, उता वरता जातो चोहो ता का होहे? <verse eid="JHN 6:62"/><verse number="63" style="v" sid="JHN 6:63"/>आतमा ता जिन्दगी देन वालो से, माँस लक कोनी फायदा नही से, जो गोस्टी मीना तुमी लक कव्हसू, वय आतमा अना जिन्दगी दुही सेत। <verse eid="JHN 6:63"/><verse number="64" style="v" sid="JHN 6:64"/>पर तुम मा लक काही ता असो सेति जोन नही करासेत, काहे का यीसु पुढ़ा च लक जानत होतो का कोन मोरो भरोसा नही करह, अना कोन मोला धरायहे। <verse eid="JHN 6:64"/><verse number="65" style="v" sid="JHN 6:65"/>अना ओना कहीस, एको लाई मिना तुमी लक कव्हयो होतो का जबा तकन कोनी को दाअजी को कन लक यो वरदान न देयो जाहेत तबा तकन उ मोरो कठा नही आय सका।<verse eid="JHN 6:65"/></para>
  <para style="p">
    <verse number="66" style="v" sid="JHN 6:66"/>एतरो पर ओको चेला मा लक लगत सा उलटो मंग गईन अना कोनी लगत सँग नही चलिन। <verse eid="JHN 6:66"/><verse number="67" style="v" sid="JHN 6:67"/>तबा यीसु ना बारा चेला लक कहीस, का तुमी भी हमेसा सोड़के जानो चाहोसो?<verse eid="JHN 6:67"/></para>
  <para style="p">
    <verse number="68" style="v" sid="JHN 6:68"/>समौन पतरस नाव को चेला ना कहीस, हे पिरभू! आमी कोन को जवर जाबोन, अमर जिंदगी की गोस्टी ता तोरोच जवर सेत। <verse eid="JHN 6:68"/><verse number="69" style="v" sid="JHN 6:69"/>अना आमी ना भरोसा कर लिया अना जान लिया का परमेस्वर को पवीतर जन<note caller="+" style="f"><char style="fr" closed="false">6:69</char><char style="ft" closed="false">पवीतर व्यक्ति</char></note> तु ही सेस।<verse eid="JHN 6:69"/></para>
  <para style="p">
    <verse number="70" style="v" sid="JHN 6:70"/>यीसु न जवाब देइस, का मिना तुमी बारा ला नही निवाड़ी सेव, ता भी तुमी बारा मा लक एक से जो सैतान<note caller="+" style="f"><char style="fr" closed="false">6:70 </char><char style="ft" closed="false">साँगड़</char></note> कन लक से। <verse eid="JHN 6:70"/><verse number="71" style="v" sid="JHN 6:71"/>यो ओना समोन इस्करियोति को टूरा यहूदा लाय कहि होतीस। काहे की वाच बारा मा लक एक होतो जेने यीसु ला धराय होतीस।<verse eid="JHN 6:71"/></para>
  <chapter eid="JHN 6"/>
  <chapter number="7" style="c" sid="JHN 7"/>
  <para style="s">यीसु को भाऊ गीनको अबिस्वास</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 7:1"/>एको मंघा, यीसु ना गलील मा फिरयो, काहेका उ यहुदिया ला नही फिरन चाव्हत होतो, काहेका वहान को यहुदी अधिकारी ओला मार डाकन चाव्हत होतीन। <verse eid="JHN 7:1"/><verse number="2" style="v" sid="JHN 7:2"/>यहूदिगीन को झोपड़ी को तिहार कठा होतो। <verse eid="JHN 7:2"/><verse number="3" style="v" sid="JHN 7:3"/>एको लाई यीसु को भाऊ लोकगीन ना ओको लक कहीन, यो जघा ला सोड़के यहुदी नगर मा जाय, काहेका जोन काम तु करासेस, ओला तोरो मघा चलनवारो चोवेत। <verse eid="JHN 7:3"/><verse number="4" style="v" sid="JHN 7:4"/>जोन जग जाहीर होवनो चाव्हासे वा लूक के काम नही करासेत। जब तू असो काम करासेस ता सबको पूढा आपरो काम दिसाव। <verse eid="JHN 7:4"/><verse number="5" style="v" sid="JHN 7:5"/>काहेका यीसु को भाऊहुन तकन ओमा भरोसा नही करत होतीन।<verse eid="JHN 7:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="JHN 7:6"/>तब यीसु ना उन लक कहीस, तुमरो लाई हरेक बेरा साजरो से, पर मोरो लाई अबा साजरो बेरा नही आईसे। <verse eid="JHN 7:6"/><verse number="7" style="v" sid="JHN 7:7"/>यो दुनिया तुमरो लक बैर नही करासे, पर मोरो लक बैर करासे, काहेका मी उनको बिरोध मा यो गवाही देवासू का उनको काम बुरो सेति। <verse eid="JHN 7:7"/><verse number="8" style="v" sid="JHN 7:8"/>ऐना तिहार मा तुमी लोक जावो, मि अबा यो तिहार मा नही जाहु, काहे की मोरो बेरा पूरो नही भईसे। <verse eid="JHN 7:8"/><verse number="9" style="v" sid="JHN 7:9"/>असी गोस्टी कव्हन को मंघा यीसु गलील नगर मा रुक गयो।<verse eid="JHN 7:9"/></para>
  <para style="s">झोपड़ी को तिहार मनानो</para>
  <para style="p">
    <verse number="10" style="v" sid="JHN 7:10"/>जबा तिहार मा ओको भाऊहुन चली गईन ता उ भी गयो पर उ खुल्लो रुप लक नही, चुप्पई चाप गयो होतो। <verse eid="JHN 7:10"/><verse number="11" style="v" sid="JHN 7:11"/>यहूदी मुखिया यीसु ला तिहार मा यो कव्हके तलास कर रही होतीन का, “उ मानूस किता से?”<verse eid="JHN 7:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 7:12"/>लोकगीन ओको बारे मा चुप्पई लक लगत पिरकार को गोस्टी कर रही होतीन, काही कव्हत होतिन, का उ साजरो मानूस से, अना काही कव्हत होतीन, नही उ लोकगीन ला भरमावासे। <verse eid="JHN 7:12"/><verse number="13" style="v" sid="JHN 7:13"/>ता भी यहूदिगीन को भेव लक कोनी मानूस ओको बारे मा नही साँगत होतो।<verse eid="JHN 7:13"/></para>
  <para style="s">यरुसलेम मा यीसु को पिरवचन</para>
  <para style="p">
    <verse number="14" style="v" sid="JHN 7:14"/>जबा तिहार अरधो बीत गयो होतो, तबा यीसु मंदिर मा गयो अना ओना पिरवचन देवनो सुरु कियो। <verse eid="JHN 7:14"/><verse number="15" style="v" sid="JHN 7:15"/>तबा यहूदिगीन चकित होयके कव्हन लगीन, यो मानूस कबच वाचन करन लाई पाठसाला नही गयी से, मंग एतरो काही कसो लक जानासे?<verse eid="JHN 7:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 7:16"/>यीसु ना जवाब देइस, मि जोन पिरवचन ला देसू उ मोरो कन लक नही, पर मोरो धाड़न वालो परमेस्वर को कन लक से, जोन ना मोला धाड़ीसेस। <verse eid="JHN 7:16"/><verse number="17" style="v" sid="JHN 7:17"/>अदी मानूस उ करनो चाहे, जोन मोठो दाअजी को मरजी से ता उ यो जान जाहे का जोन पिरवचन मि देवासू, उ मोठो परमेस्वर को से, मंग मि आपरो कन लक नही देय रही सेउ। <verse eid="JHN 7:17"/><verse number="18" style="v" sid="JHN 7:18"/>जोन आपरो टोंड लक कव्हन चाव्हासे, उ आपरो बड़ाई चाव्हासे, पर जोन आपरो धाड़न वालो की बडाई चाव्हासे, वाच खरो से, अना ओमा अन्याय<note caller="+" style="f"><char style="fr" closed="false">7:18 </char><char style="ft" closed="false">खोट</char></note> नाहती। <verse eid="JHN 7:18"/><verse number="19" style="v" sid="JHN 7:19"/>का तुमला मोसे को नियम ला नही देई गयी से? मंग तुम्हि मा लक कोनी मोसे को नियम पर नही चलासे। तुमी मोला कायलाई मार डाकन चाव्हासो?<verse eid="JHN 7:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="JHN 7:20"/>लोकहुन ना जवाब देइन, “तोरो पर भूत घुस गयी से जोन तोला मारन को तक्का पर से।”<verse eid="JHN 7:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="JHN 7:21"/>यीसु उनला जवाब देसे की, मि तुमरो लाई एक अदभुत काम ला करयो अना तुम्हि ता चकित भयो सेव। <verse eid="JHN 7:21"/><verse number="22" style="v" sid="JHN 7:22"/>एनाच मकसद लक मोसे ना तुमला खतना को रिवाज सौप देयि होतो। (असो नही का यो रिवाज मोसे को कन लक से, पर तुमरो आजा-पुरखा लक चलके आय रहयो होतो।) अखीन तुमी बिसराम दिवस मा टुराहुनार को खतना करासेव। <verse eid="JHN 7:22"/><verse number="23" style="v" sid="JHN 7:23"/>जबा पवीतर दिवस मानूस को खतना कियो जासे, तबा मोसे को नियम को हुकूम बनो रव्हासे, तो तुमी मोरो पर काहे गुस्सा करासो की मिना एक मानूस ला पूरी तरीको लक साजरो करीसेऊ। <verse eid="JHN 7:23"/><verse number="24" style="v" sid="JHN 7:24"/>गोस्टी जसी से वसो चोवके न्याय करो, टोंड चोवके न्याय नोको करो।<verse eid="JHN 7:24"/></para>
  <para style="s">का यीसु च मसीहा आय?</para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 7:25"/>तबा यरुसलेम का रव्हनवालो लोकहुन मा लक काही ना कहिन, “का यो वोच मानूस नही से, जोनला लोक मार डाकन चाव्हसेत?” <verse eid="JHN 7:25"/><verse number="26" style="v" sid="JHN 7:26"/>चोवो, उ ता लोकहुन को बीच खुल्लमखुल्ला<note caller="+" style="f"><char style="fr" closed="false">7:26</char><char style="ft" closed="false">साफ-साफ</char></note> गोस्टी कर रही से अना कोनी ओला काही नही कव्ह सका सेत, का यो नही होय सका यहुदी मुखिया ला सही मा मालुम भयो, का योच खरोखर मसीह से? <note caller="+" style="f"><char style="fr" closed="false">7:26</char><char style="ft" closed="false">परमेस्वर का धाडयो हुयो। </char></note> <verse eid="JHN 7:26"/><verse number="27" style="v" sid="JHN 7:27"/>“येला तो हमी जानसेजन, का यो कहाँन को से? पर जब मसीह आहेत, तबा कोनी नही जान पाहेत, की उ कहाँन को सेत?”<verse eid="JHN 7:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="JHN 7:28"/>यीसु ना मंदिर मा जोर लक कहयो, “का तुमी सच मा नही जानासेव, मि कोन सेऊ अना किता लक आयीसेऊ?” मि आपरो हक लक नही आयीसेऊ, काहेका जोन ना मोला धाड़ीसेस उ सच्चो से, तुमी ओला नही जानासेव। <verse eid="JHN 7:28"/><verse number="29" style="v" sid="JHN 7:29"/>मि ओला जानासू, काहेका मि ओको कन लक आयी सेऊ, अखीन ओने मोला धाड़िसेस।<verse eid="JHN 7:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="JHN 7:30"/>मंग वय ओला बंदी बनावन को कोसिस करन लगीन, पर कोनी भी ओको पर हात नही डाक सकया। काहेकि ओको बेरा अबा नही आयी होती। <verse eid="JHN 7:30"/><verse number="31" style="v" sid="JHN 7:31"/>मंग भीड़ मा लक लगत सा लोक ओको पर भरोसा कर लेईन। अना कव्हन लगीन, “मसीह जबा आहे तबा का येको लक लगत निसान करेत जोन एना चोवायीसेस।”<verse eid="JHN 7:31"/></para>
  <para style="s">यहुदी हुनको यीसु ला धरान की कोसिस</para>
  <para style="p">
    <verse number="32" style="v" sid="JHN 7:32"/>मुखिया याजक अना मोसे को नियम को गुरू गीन ना सुनगुन-सुनगुन यो गोस्टी ला लोकगीन ला करत आयकिन, एकोलाई मोठा याजक अना मोसे को नियम को गुरु ना ओला धरन लाई सिपाही धाड़िन। <verse eid="JHN 7:32"/><verse number="33" style="v" sid="JHN 7:33"/>तबा यीसु ना कहीस, “मी काही बेरा तुम्हरो संग सेव, तबा मि आपरो धाड़न वालो परमेस्वर को जवर चलो जाहुँ। <verse eid="JHN 7:33"/><verse number="34" style="v" sid="JHN 7:34"/>तुमी मोला ढुँढ-ढाँढ<note caller="+" style="f"><char style="fr" closed="false">7:34</char><char style="ft" closed="false">खोज करो</char></note> करहो, पर मि तुमला नही मिलुँ, काहेका मि जिता जासू, वहान तुमी नही आय सकसो।”<verse eid="JHN 7:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="JHN 7:35"/>यहुदी अधिकारी आपसी मा कहिन, “उ किता को जघा ला जासे का हमी ओला नही पायबिन?” का उ युनानी नगर ला ता नही जासे का वहान तितिर-बितिर रव्हन वाला यहुदी गीनला, युनानी मा सिक्सा सांगेह? <verse eid="JHN 7:35"/><verse number="36" style="v" sid="JHN 7:36"/>यो गोस्टी को का मतलब से? का उ कव्हसे का तुमी मोला तपासो पर नही पायबिन, अखिन जिता मि जाहु उता तुमी नही आय सकबिन।<verse eid="JHN 7:36"/></para>
  <para style="s">जिन्दगी को पानी को नद्दी</para>
  <para style="p">
    <verse number="37" style="v" sid="JHN 7:37"/>तिहार को आखरी दिवस मा यीसु उभो हुयो, अना जोर लक कव्हन लगयो, “जोन कोनी भी तहान होय, उ मोरो कठा आयेत।” <verse eid="JHN 7:37"/><verse number="38" style="v" sid="JHN 7:38"/>जोन कोनी बिस्वासी होयके मोरो मा लक पिहे, पवितर गिरंथ मा असो लिख्यो से, ओको भितर लक जिंदगी को पानी को झरना<note caller="+" style="f"><char style="fr" closed="false">7:38</char><char style="ft" closed="false">धारा</char></note> बोह जाहेत। <verse eid="JHN 7:38"/><verse number="39" style="v" sid="JHN 7:39"/>यीसु ना यो गोस्टी पवीतर आतमा को बारे मा साँगयो होतो, जेनला ओको पर भरोसा ठेवन वालो पावन वालो होतीन। काहे की पवीतर आतमा अबा तकन नही उतरयो होतो। काहे की यीसु आपरो महिमा अबा तकन नही भेटयो होतो।<verse eid="JHN 7:39"/></para>
  <para style="p">
    <verse number="40" style="v" sid="JHN 7:40"/>भीड़ मा लक काही लोकहुन ना यीसु ला यो कव्हत आयकिन अखिन कहिन, “यो मानूस ता वाकई मा भविस्यवक्ता आय!”<verse eid="JHN 7:40"/></para>
  <para style="p">
    <verse number="41" style="v" sid="JHN 7:41"/>अना दुसरो ना कहिन, “उ ता मसीह आय!”</para>
  <para style="p" vid="JHN 7:41">पर कोनी-कोनी कव्हन लगीन, “का मसीह गलील नगर लक आहेत?” <verse eid="JHN 7:41"/><verse number="42" style="v" sid="JHN 7:42"/>का पवितर गिरंथ मा यो लिख्यो से? का मसीह दाऊद को खानदान, बैतलेहम गाँव मा जलम लियो, अना दाउद को नगर लक आहेत, जहान दाऊद रव्हत होतो। <verse eid="JHN 7:42"/><verse number="43" style="v" sid="JHN 7:43"/>तबा असो गोस्टी को कारन लक, भीड़ मा फुट पड़ गई। <verse eid="JHN 7:43"/><verse number="44" style="v" sid="JHN 7:44"/>उनमा लक काही लोकगीन ओला धरनो चाव्हत होतीन, पर वा कोनी को हात मा नही आयो।<verse eid="JHN 7:44"/></para>
  <para style="s">यहुदी मुखिया को अबिस्वास</para>
  <para style="p">
    <verse number="45" style="v" sid="JHN 7:45"/>जबा सिपाही वापिस होयके मुखिया याजक अना मोसे को नियम को गुरू जवर आइन। तबा उनना सिपाही लक पुसिन, “तुमी काय लाई ओला नही आनयत?”<verse eid="JHN 7:45"/></para>
  <para style="p">
    <verse number="46" style="v" sid="JHN 7:46"/>सिपाही ना साँगिन, “आज तकन आमिना ओको जसो कोनी मानूस ला गोस्टी करता नही चोया!”<verse eid="JHN 7:46"/></para>
  <para style="p">
    <verse number="47" style="v" sid="JHN 7:47"/>मोसे को नियम को गुरू गीनना उनला कहीन, “का तुमी भी भरमाया गया सेव?” <verse eid="JHN 7:47"/><verse number="48" style="v" sid="JHN 7:48"/>कोनी भी यहुदी मुखिया अना मोसे को नियम को गुरू गीनना ओको पर भरोसा नही करीन? <verse eid="JHN 7:48"/><verse number="49" style="v" sid="JHN 7:49"/>यो लोक जोन मोसे को नियम नही जानासेति‌ वय सापित सेति।<verse eid="JHN 7:49"/></para>
  <para style="p">
    <verse number="50" style="v" sid="JHN 7:50"/>नीकुदेमुस जोन पुढा वोको जवर आयो होतो, उ उनमा लक एक होतो, उनला कहीस। <verse eid="JHN 7:50"/><verse number="51" style="v" sid="JHN 7:51"/>का आमरो मोसे को नियम मा, असो नही लिख्योसेत? का जबा तकन वोको बारे मा यो जान नही लेव, उ काजक करासे, कसो दन्ड ठहरायो जाहेती?<verse eid="JHN 7:51"/></para>
  <para style="p">
    <verse number="52" style="v" sid="JHN 7:52"/>ओन्हीसिन ओला जवाब देईन, का तु भी गलीली सेस? तू ढूढ-ढान्ड कर अना खोज, का गलील मा कोनी भविस्यवक्ता भयो से? <verse eid="JHN 7:52"/><verse number="53" style="v" sid="JHN 7:53"/>तबा वय सब वहान लक आपरो घर ला चली गईन।<verse eid="JHN 7:53"/></para>
  <chapter eid="JHN 7"/>
  <chapter number="8" style="c" sid="JHN 8"/>
  <para style="s">बैस्या बायका ला छिमा</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 8:1"/>यीसु मंग जैतून पहाड़ पर चली गयो। <verse eid="JHN 8:1"/><verse number="2" style="v" sid="JHN 8:2"/>पहट ला मंदिर मा आयो, तबा सब लोकगीन मंदिर मा आवन लगीन, यीसु वहान बसके उनला सिक्सा देवन लगयो। <verse eid="JHN 8:2"/><verse number="3" style="v" sid="JHN 8:3"/>तबा यहुदी अगुवा अना मोसे को नियम को गुरू गीन एक बायको ला आनीन जोन छिनाला<note caller="+" style="f"><char style="fr" closed="false">8:3 </char><char style="ft" closed="false">व्यभिचार </char></note> करत धरी गई होती। ओला बीच मा उभी करके यीसु लक कहीन, <verse eid="JHN 8:3"/><verse number="4" style="v" sid="JHN 8:4"/>“हे गुरूजी, या बायको छिनाली करत धराय गईसे। <verse eid="JHN 8:4"/><verse number="5" style="v" sid="JHN 8:5"/>मोसे को नियम मा हम ला हुकूम देईसेस की असी बायको ला गोटा लक मारो जाय, एको बारे मा तोरी काजक राय से?” <verse eid="JHN 8:5"/><verse number="6" style="v" sid="JHN 8:6"/>ओन्हीसीन यीसु ला फसावन लाय यो गोस्टी पुस रही होतीन, जोनको लक उनला कोनी असो बहाना मिल जाहेत का ओको पर दोस लगाय सकेत। पर यीसु खाल्या नवके अखिन आपरी कंरगी लक जमीन मा लिखन लगयो।<verse eid="JHN 8:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="JHN 8:7"/>काहेकि जबा वय ओको लक पुसत रहिन, एकोलाई यीसु सीधो तनके उनलक बोलिस, “तुमी मा लक जोन पापी नहात वाच सबलक पयले एने बायका ला गोटा मारे।” <verse eid="JHN 8:7"/><verse number="8" style="v" sid="JHN 8:8"/>अना मंग उ जमीन मा वोनो भयके लिखन लगयो। <verse eid="JHN 8:8"/><verse number="9" style="v" sid="JHN 8:9"/>जबा लोकहुन ना असो आयकिन, तबा मोठो लक नहानो तकन, एक-एक करके उता लक हिट गईन। असो यीसु च उता एकलो रह गयो। यीसु को मोहरा वा बायको अबा भी उभी होती। <verse eid="JHN 8:9"/><verse number="10" style="v" sid="JHN 8:10"/>तबा यीसु उभो भयो अना ओनो बायका लक बोलिस, “ओ बायका, वय सब किता गईन? का कोनी ना तोला दोसी नही ठहरायीन?” <verse eid="JHN 8:10"/><verse number="11" style="v" sid="JHN 8:11"/>बायका कव्हासे, “हे पिरभू! कोन्हीसीन नही।” यीसु ना कहीस, “मि भी तोला दन्ड नही देहुँ, जाय अना मंग कबच पाप नोको करजोस।”<verse eid="JHN 8:11"/></para>
  <para style="s">जगत को उजाड़ो यीसु</para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 8:12"/>मंग वहान पायो जावन वाला लोक गीनला यीसु ना कहीस, “जगत को उजाडो मि सेव। जोन मोरो मंघा चलहेत कबच इंधारो मा नही रहेत, पर ओला उजाड़ो मिल्हेत जोन जिंदगी देवासे।”<verse eid="JHN 8:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="JHN 8:13"/>एतरो पर मोसे को नियम को गुरू यीसु लक कव्हासेत, “तु आपरी गवाही<note caller="+" style="f"><char style="fr" closed="false">8:13</char><char style="ft" closed="false">गवाही</char></note> खुदच देसेस, एकोलाई तोरी गवाही खरी नहात।”<verse eid="JHN 8:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="JHN 8:14"/>तबा यीसु ना उन ला साँगिस, “अदी मि आपरो पुरूप खुदच देवासु ता भी मोरो पुरूप खरो से, काहे की मि जानासेऊ की मि किता लक आयीसेऊ, अना किता लक जावासू। पर तुमी नही जानासेव की मि किता लक आयीसेऊ अना किता लक जावासेऊ। <verse eid="JHN 8:14"/><verse number="15" style="v" sid="JHN 8:15"/>तुमी मानूस की उसुल पर न्याय करोसो, मि कोनी को नियाव नही करूँ। <verse eid="JHN 8:15"/><verse number="16" style="v" sid="JHN 8:16"/>तरी अदी मि न्याय करूँ, ता मोरो न्याय खरो से। काहे की मि एकलो नही सेव। पर मोठो दाअजी अजी, जेना मोला धाड़ीसेस, उ अना मि मिलके न्याय करासेत। <verse eid="JHN 8:16"/><verse number="17" style="v" sid="JHN 8:17"/>मि आपरी गवाही खुदच देवासेऊ अना मोठो दाअजी अजी भी, जेना मोला धाड़ीसेस, मोरो कन लक गवाही देसे। <verse eid="JHN 8:17"/><verse number="18" style="v" sid="JHN 8:18"/>एक तो मि खुदच आपरी गवाही देवासु। अना दुजो से परमेस्वर बाबूजी, जोन ना मोरो कनलक गवाही देइसेस, जोन ना मोला धाड़िसेस।”<verse eid="JHN 8:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="JHN 8:19"/>ऐतरो मा लोकहुन यीसु ला कव्हासेत, “तोरो अजी किता से?” यीसु ना कहीस, “तुमी नही जानासो, का मि कोन सेऊ? अना मोरो अजी ला भी नही जानासो, अदि तुमी जानतत, ता मोरो अजी ला भी जान लियो रव्हतत।”<verse eid="JHN 8:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="JHN 8:20"/>यीसु ना या गोस्टी उनला मंदिर मा सिक्सा देतो बेरा भन्डार घर मा कहीस, तरी कोनी ना ओला नही धरीन, काहेकि ओको बेरा अबा नही आयो होतो।<verse eid="JHN 8:20"/></para>
  <para style="s">यीसु किता को से, यहुदी ना नही जान पाईन</para>
  <para style="p">
    <verse number="21" style="v" sid="JHN 8:21"/>यीसु ना मंग एक गन उन ला कहीस, “मि चली जाहु, तुमी मोला ढुंढ-ढान्ड करने, पर तुम्हि आपरो पापहुन मा मर जाहो। जिता मि जावासेऊ वहान तुमी नही आय सकने।”<verse eid="JHN 8:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 8:22"/>मंग यहुदी अगूवा कव्हन लगीन, “का तुमी सोचसो का उ आपरो खुदच ला मार देहे? काहेकि ओना कहिसेस तुमी वहान नही आय सकने जहान मि जावासेऊ।”<verse eid="JHN 8:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="JHN 8:23"/>ओना उन ला कहीस तुमी धरती का सेव, मि वरता<note caller="+" style="f"><char style="fr" closed="false">8:23 </char><char style="ft" closed="false">ऊपर</char></note> लक आयी सेऊ। अना तुमी दुनियाँ का आव, मि दुनिया को नही आऊ। <verse eid="JHN 8:23"/><verse number="24" style="v" sid="JHN 8:24"/>एको लाई मिना तुमला कव्हयो, की तुमी पाप मा मरोह। काहे की तुमी भरोसा नही ठेवो, की मि वाच सेऊ।<verse eid="JHN 8:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 8:25"/>मंग ओन्हीसीन ओको लक पुसिन, “तु कोन आस?”</para>
  <para style="p" vid="JHN 8:25">यीसु ना उन लक जवाब देइस, मि सुरू लक तुमला साँगत आयीसेऊ, वाच सेऊ। <verse eid="JHN 8:25"/><verse number="26" style="v" sid="JHN 8:26"/>तुमरो बारे मा मोला लगत गोस्टी कव्हनो से, अना तुमरो न्याय करनो से। पर मोरो धाड़न वालो परमेस्वर खरो से। मीना जोन गोस्टी ओको लक आयकीसेऊ। वाच मि जगत लक कव्हसू।<verse eid="JHN 8:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="JHN 8:27"/>वय नही समज पाईन की आमी ला उ परमेस्वर दाअजी को बारे मा कव्हासे। <verse eid="JHN 8:27"/><verse number="28" style="v" sid="JHN 8:28"/>तबा यीसु न कहीस जबा तुमी मानूस को टूरा वरता मा चघावने, तो जान लेवने की मि वाच आऊ। अना मि आपरो आप लक काही नही करासू। पर जसो मोरो परमेस्वर दाअजी ना सिकाईसेस वसोच गोस्टी कव्हसू। <verse eid="JHN 8:28"/><verse number="29" style="v" sid="JHN 8:29"/>मोरो धाड़नवालो मोरो सँग से, ओने मोला एकलो नही सोड़ीसेस, यो काजी सदा वाच काम करासू, जोको लक परमेस्वर खुस रव्हासे।<verse eid="JHN 8:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="JHN 8:30"/>यीसु की यो गोस्टी ला आयक के लगत लोकइन ना ओको बिस्वासी होय गयीन।<verse eid="JHN 8:30"/></para>
  <para style="s">पाप लक सूटकारा को पिरवचन</para>
  <para style="p">
    <verse number="31" style="v" sid="JHN 8:31"/>तबा यीसु ना वोको पर भरोसा राखनवालो यहूदी गीनला कहीस, अदी तुमी मोरो गोस्टी ला आयको, ता खरो मा मोरो चेला कहलाहो। <verse eid="JHN 8:31"/><verse number="32" style="v" sid="JHN 8:32"/>अना खराई ला जान लेवने तो खराई तुमला सूटकारा देहेत।<verse eid="JHN 8:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="JHN 8:33"/>ओन्हिसीन यीसु लक सवाल पुसासेत, “आमी तो अबराहम को खानदान<note caller="+" style="f"><char style="fr" closed="false">8:33 </char><char style="ft" closed="false">खानदान</char></note> को सेजन। आमी कोनी का गुलाम नही भयो, मंग तु कसो कव्हासेव तुमिला सूटकारा मिलहेत?”<verse eid="JHN 8:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="JHN 8:34"/>यीसु ना उन ला जवाब देइस, मि तुमला खरो-खरो कव्हुसू। हर कोनी जोन पाप करासे, पाप को दास से। <verse eid="JHN 8:34"/><verse number="35" style="v" sid="JHN 8:35"/>कोनी दास हमेसा घर मा नही रव्ह सका, पर टूरा हमेसा संग रव्होसे। <verse eid="JHN 8:35"/><verse number="36" style="v" sid="JHN 8:36"/>तबा अदी टूरा तुमला सूटकारा देहेत, तबा सच्ची मा तुमी पाप लक सूटकारा पाहो।<verse eid="JHN 8:36"/></para>
  <para style="p">
    <verse number="37" style="v" sid="JHN 8:37"/>मि जानासु की तुमी अबराहम को खानदान का सेव। मंग मोरो सबद तुमरो मनमा नही समावासे, तबच तुमी मोला मार डाकनो चाव्हासेव। <verse eid="JHN 8:37"/><verse number="38" style="v" sid="JHN 8:38"/>मि वाच कव्हुसू जोन मिना आपरो परमेस्वर अजी को इता चोविसेऊ। अना तुमी वाच करोसो जोन तुमीना आपरो अजी सैतान लक आयकासेव। <verse eid="JHN 8:38"/><verse number="39" style="v" sid="JHN 8:39"/>एतरो पर ओन्हिसीन यीसु ला जवाब देइन, “आमरो अजी ता अबराहम से।”</para>
  <para style="p" vid="JHN 8:39">यीसु ना कहीस, “अदी तुमी अबराहम की औलाद होतत ता अबराहम को जसो काम करतत। <verse eid="JHN 8:39"/><verse number="40" style="v" sid="JHN 8:40"/>पर तुमी ता मोरो जसो मानूस ला मार डाकन चाव्हसेव, जेने तुमला उ खराई ला साँगिसेस जो मोठो परमेस्वर लक आयकीसेस। अबराहम ना ता असो नही करयो होतो। <verse eid="JHN 8:40"/><verse number="41" style="v" sid="JHN 8:41"/>तुमी आपरो अजी को काम करोसो।” मंग ओन्हीसीन यीसु लक कहीन, “आमी छिंडरापन लक नही जनम नही लियासेजन। आमरो एकच अजी परमेस्वर से अना उ पवीतर से।”<verse eid="JHN 8:41"/></para>
  <para style="p">
    <verse number="42" style="v" sid="JHN 8:42"/>यीसु ना उन लक कहीस अदी परमेस्वर तुमरो अजी होतो ता तुमी मोरो लक माया राखतत। काहे की मि परमेस्वर कन लक हिटके आईसेऊ, अना अबा यहान सेऊ। मि खुद नही आईसेऊ, पर ओना मोला धाडीसेस। <verse eid="JHN 8:42"/><verse number="43" style="v" sid="JHN 8:43"/>एकोलाई तुमी मोरो समाचार नही आयकासो, एकोलाई नही समजासो का मि काजक कह रही सेऊ। <verse eid="JHN 8:43"/><verse number="44" style="v" sid="JHN 8:44"/>तुमी आपरो अजी सैतान कन लक सेव, अना आपरो अजी को लालसा ला पूरी करनो चाव्हासेव। उ ता सुरू लक खूनी से, खराई लाय सच्चो नही रव्हे। काहे की सच ओमा नहाती, जबा उ झुठो सांगासे ता आपरो आचरन च लक सांगासे, काहे की उ झुठो से, अना झुठो को अजी से। <verse eid="JHN 8:44"/><verse number="45" style="v" sid="JHN 8:45"/>“पर काहेकि मि खराई कव्ह रही सेउ एकोलाई तुमी मोरो भरोसा नही करतत।” <verse eid="JHN 8:45"/><verse number="46" style="v" sid="JHN 8:46"/>तुमी मा लक कोन मोला पापी होवन को लानछान लगाय सकासे। अदी मि खराई लक कव्हसू, तो तुमी मोरो भरोसा कायलाई नही करतत। <verse eid="JHN 8:46"/><verse number="47" style="v" sid="JHN 8:47"/>जोन मानूस परमेस्वर को होवासे, उ परमेस्वर की गोस्टी ला आयकासे, तुमी एकोलाय नही आयको की परमेस्वर कन लक नही सेव।<verse eid="JHN 8:47"/></para>
  <para style="s">यीसु अबराहम को पहले रव्हसे</para>
  <para style="p">
    <verse number="48" style="v" sid="JHN 8:48"/>यो आयक के यहूदिगीन ना ओला कहिन, “का हमी खरो नही सांगासेजन, का तू सामरी आस अना तोरो मा भूत से?”<verse eid="JHN 8:48"/></para>
  <para style="p">
    <verse number="49" style="v" sid="JHN 8:49"/>यीसु ना जवाब देईस, मोरो मा कोनी भूत नहात। पर मि आपरो अजी को मान करुसु अना तुमी मोरो बेईज्जती करोसो। <verse eid="JHN 8:49"/><verse number="50" style="v" sid="JHN 8:50"/>पर मि आपरी बड़ाई नही चाव्हासेऊ, पर एक से जोन मोरी बड़ाई चाव्हासे अना न्याय करासे। <verse eid="JHN 8:50"/><verse number="51" style="v" sid="JHN 8:51"/>मि तुमला खरो कव्हसु की अदी कोनी मानूस मोरो कव्हो गयो गोस्टी ला आपनासे ता उ मिरतु ला कबच नही चोहेत।<verse eid="JHN 8:51"/></para>
  <para style="p">
    <verse number="52" style="v" sid="JHN 8:52"/>एतरो पर यहुदी अगूवा गीनना ओला कहिन, “अता आमला मालुम भय गयो से का तोरो मा कोनी भूत से। अबराहम अना भविस्यवक्ता गीन मर गयो सेत। अना तु कव्हसेस अदि कोनी मोरी गोस्टी ला आपनाहे ता ओकी मिरतु कभ्भू नही होयेत। <verse eid="JHN 8:52"/><verse number="53" style="v" sid="JHN 8:53"/>का तु आमरो पुरखा अबराहम लक मोठो आस? जोन मर गयो, अखिन भविस्यवक्ता भी मर गयीन। तु अपरो आप ला काजक समजासे?”<verse eid="JHN 8:53"/></para>
  <para style="p">
    <verse number="54" style="v" sid="JHN 8:54"/>यीसु ना जवाब देईस, अदी मि आप आपरी बड़ाई करु ता मोरी बडाई काही नही, पर मोरी बडाई करन वालो मोरो परमेस्वर बाबूजी से, जेनला तुमी कसो की उ आमरो परमेस्वर आय। <verse eid="JHN 8:54"/><verse number="55" style="v" sid="JHN 8:55"/>अना तुमी तो ओला नही जानो, पर मि ओला जानसेऊ, अना अदी मि कहुँ की ओला नही जानु तो मि तुमरो जसो झुठो ठहरू। पर मि ओला जानासेऊ, अना ओको सबद<note caller="+" style="f"><char style="fr" closed="false">8:55</char><char style="ft" closed="false">गोस्टी</char></note> मा चलासेऊ। <verse eid="JHN 8:55"/><verse number="56" style="v" sid="JHN 8:56"/>तुमरो पुरखा अबराहम मोला चोवन की आसा लक लगत खुस होतो, अना ओना चोय लेइस अना खुसी मनाईस।<verse eid="JHN 8:56"/></para>
  <para style="p">
    <verse number="57" style="v" sid="JHN 8:57"/>मंग यहूदी अगूवागीन ना ओला कहीन, “अब तकन तु पचास बरस को नही भईसेस, मंग तु ना अबराहम ला कसो चोय लियोसे?”<verse eid="JHN 8:57"/></para>
  <para style="p">
    <verse number="58" style="v" sid="JHN 8:58"/>यीसु ना उनला कहीस, “मि तुमी लक खरो कव्हसु, की पुढा अबराहम पैदा भयो, एको लक पुढा मि सेउ।”<verse eid="JHN 8:58"/></para>
  <para style="p">
    <verse number="59" style="v" sid="JHN 8:59"/>तबा ओन्हीसीन ओला मारन लाई गोटा उचलीन पर यीसु हिटके मंदिर लक चलो गयो।<verse eid="JHN 8:59"/></para>
  <chapter eid="JHN 8"/>
  <chapter number="9" style="c" sid="JHN 9"/>
  <para style="s">जन्म को अँधरा ला साजरो करनो</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 9:1"/>मंग जातो बेरा ओना एक मानूस ला चोवीस, जोन जनम लक अँधरा होतो। <verse eid="JHN 9:1"/><verse number="2" style="v" sid="JHN 9:2"/>एतरो पर यीसु को चेलाहुन ना ओको लक पुसिन, “हे गुरू कोन ना पाप करीसेस, की यो अँधरा जनम लेइसे, यो मानूस ना, का ओको माय-अजी ना?”<verse eid="JHN 9:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="JHN 9:3"/>यीसु ना जवाब देइस, “ना तो ओना पाप करीसेस, ना ओको माय-अजी ना, पर यो एकोलाय अँधरो भयो की परमेस्वर को काम दिसायो जाहे। <verse eid="JHN 9:3"/><verse number="4" style="v" sid="JHN 9:4"/>जोन मोला धाडिसेस आमीला ओको काम दिवस मा करनो से अना उ रात आनो पर से, जोनमा कोनी काम नही कर सका। <verse eid="JHN 9:4"/><verse number="5" style="v" sid="JHN 9:5"/>जबा तकन मि दुनिया मा सेउ, तबा तकन दुनियाँ को उजाड़ो सेव।”<verse eid="JHN 9:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="JHN 9:6"/>असो कव्हके ओना धरती मा थुकीस, अना वा थुक लक माटी ला सानिस अना उ माटी ला अँधरा को डोरा मा लगायके रगड़ देईस। <verse eid="JHN 9:6"/><verse number="7" style="v" sid="JHN 9:7"/>अना ओला कहीस “जाय सीलोह को कुन्ड मा धोय ले! मंग अँधरा ना जायके डोरा ला धोय लेइस, जबा उ मंघा वापिस भयो ता ओला चोवन लगयो।”<verse eid="JHN 9:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="JHN 9:8"/>तबा सेजारवारा अना जोन्हीसीन ओला पयले भीक मांगत चोवत होतीन, कव्हन लगीन, का यो वाच मानूस नही से, जोन बसके ना भीक मांगत होतो?<verse eid="JHN 9:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="JHN 9:9"/>काही लोकगीन ना कहिन, “यो वाच से” दुसरो ना कहिन, “नही, यो उ नही से, ओको जसो चोवासे।”</para>
  <para style="p" vid="JHN 9:9">एतरो पर अँधरा ना कहीस, “मि वाच सेव।”<verse eid="JHN 9:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="JHN 9:10"/>तबा वय ओको लक पूसन लगीन, “तोरो डोरा कसो उघड गईन?”<verse eid="JHN 9:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="JHN 9:11"/>वोना जवाब देइस, “यीसु नाव को एक मानूस ना माटी गिली करीस, अना मोरो डोरा मा लगायके मोरो लक कहीस, जाय अना सीलोह मा जायके धोय ले! अना मि जायके धोयो बस एतरो पर मोला चोवन लगयो।”<verse eid="JHN 9:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 9:12"/>मंग लोकहुन ना वोको लक पुसिन, “उ किता से?”</para>
  <para style="p" vid="JHN 9:12">वोना कहीस, “मि नही जानु।”<verse eid="JHN 9:12"/></para>
  <para style="s">मोसे को नियम को गुरूहुन लक जाँच पड़ताल</para>
  <para style="p">
    <verse number="13" style="v" sid="JHN 9:13"/>लोक ओला जोन पयले अँधरा होतो, मोसे को नियम को गुरू को जवर आनीन। <verse eid="JHN 9:13"/><verse number="14" style="v" sid="JHN 9:14"/>जोन दिवस मा यीसु ना माती ओदी करके अँधरा ला डोरा उघाड़ो होतीस, वा बिसराम दिवस होतो। <verse eid="JHN 9:14"/><verse number="15" style="v" sid="JHN 9:15"/>मंग एक गन मोसे को नियम को गुरू ना ओको लक पुसिन, “का ओको डोरा कसो उघड़ीन?” ओना सांगीस, “ओना मोरो डोरा पर ओदी माती लगाइस, मंग मिना धोयो अना अता मि चोय सकासू।”<verse eid="JHN 9:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 9:16"/>एतरो पर काही मोसे को नियम को गुरू कव्हन लगीन, यो मानूस परमेस्वर को कन लक नहात, काहेकि उ बिसराम दिवस को पालन नही करासे।</para>
  <para style="p" vid="JHN 9:16">ओतरो पर दुसरो ना कहीन, “कोनी पापी मानूस भला असो निसान कसो दिसाय सकासे?” असो परकार लक उनमा आपसी मा फूटफैर भय गई।<verse eid="JHN 9:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="JHN 9:17"/>वय एक गन मंग ओनो अँधरा लक कहिन, “ओको बारे मा तु काजक कव्हासेत? काहेकि ऐना बिसय ला तु जानासेस की ओने तोला डोरा देईसेस।” तबा ओना कहीस, “उ भविस्यवक्ता आय।” <verse eid="JHN 9:17"/><verse number="18" style="v" sid="JHN 9:18"/>यहूदी अगुवाहुन ना ओनो बेरा ओको पर बिस्वास नही करीन की उ मानूस अँधरा होतो अना ओला डोरा लक चोवन लगयो होतो। तबा ओको माय-अजी ला बुलवाइन। <verse eid="JHN 9:18"/><verse number="19" style="v" sid="JHN 9:19"/>अना उनको लक पुसीन, “का यो च तुमरो टूरा आय! जोनको बारे मा तुम्हि सांगासेव की उ अँधरा होतो? मंग यो कसो चोवन लगयो।”<verse eid="JHN 9:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="JHN 9:20"/>ओको माय-अजी ना जवाब देइन, “का हमी ता जानसेजन की यो हमरो टूरा आय, अना यो अँधरा जलम लियो होतो। <verse eid="JHN 9:20"/><verse number="21" style="v" sid="JHN 9:21"/>पर हमी अता नही जानसेजन की अबा कसो चोवासे? अना नही जानासेजन का येको डोरा कोन ना उघाडीसेस? एको लक पुस लेव अता उ अकलवर से, आपरो बारे मा उ खुदच साँग देहे।” <verse eid="JHN 9:21"/><verse number="22" style="v" sid="JHN 9:22"/>यो गोस्टी ला ओको माय-बाबूजी ना एको लाई कहिन का वय यहूदी अगुवागीन लक डरात होतिन। काहेकि यहुदी अगुवाहुन यो गोस्टी लक एक मन भयो होतिन, का अदी कोनी कहेत की उ मसीह से, ता वोला मंदीर को सभा लक हेड़ दियो जाहे। <verse eid="JHN 9:22"/><verse number="23" style="v" sid="JHN 9:23"/>एकोलाई ओको माय-अजी ना कहीन, “उ मोठो भय गयो से, ओकोच लक पुस लेव।”<verse eid="JHN 9:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="JHN 9:24"/>तबा उनना उ मानूस ला जोन अँधरा होतो दुसरो गन बुलाइन, अना कहिन, “खरो साँग, जोन तु साजरो भयो से, ओको कारन परमेस्वर को बड़ाई कर! हमिला मालुम से की उ मानूस पापी आय।”<verse eid="JHN 9:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 9:25"/>एको पर ओना जवाब देइस, “मि नही जानु की उ पापी से का न्यायी से, मि ता बस यो जानासेऊ की मि अँधरा होतो, अना अता चोवन लगयो।”<verse eid="JHN 9:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="JHN 9:26"/>यो गोस्टी पर उनना ओको लक पुसिन, “ओना तोरो सँग काजक करीसेस? ओना तोरो डोरा कसो उघाडीसेस?”<verse eid="JHN 9:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="JHN 9:27"/>असो गोस्टी पर ओना जवाब दियो, मि ता तुमला साँग दियो, पर तुमी नही आयकत!अता दुसरो गन कायलाई आयकनो चाव्हासो? का तुमी भी ओको चेला बननो चाव्हासो?<verse eid="JHN 9:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="JHN 9:28"/>एको पर वय ओला बेज्जत करीन अना कहिन, “तुच ओको चेला सेस, पर आमी ता मोसे भविस्यवक्ता को चेला आजन। <verse eid="JHN 9:28"/><verse number="29" style="v" sid="JHN 9:29"/>आमी ता जानासेजन का परमेस्वर ना मोसे भविस्यवक्ता लक गोस्टी करी होतिस, पर एला नही जान पाया की उ किता लक आयीसे?”<verse eid="JHN 9:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="JHN 9:30"/>ओना उन ला जवाब देइस, “या ता अचंभा से, तुम्हिला मालूम नहात कि वा किता को आय? पर ओना मोरो डोरा उघाड़ीसेस। <verse eid="JHN 9:30"/><verse number="31" style="v" sid="JHN 9:31"/>हमि जानसेजन, का परमेस्वर पापी गीनको नही आयकासे पर अदी कोनी परमेस्वर को भगत से अना ओकी मरजी पर चलासे ता उ ओकी आयकसे। <verse eid="JHN 9:31"/><verse number="32" style="v" sid="JHN 9:32"/>जूनो जमाना लक यो कभ्भू आयकनो मा नही आयो का कोनी ना जलम लक अँधरा को डोरा उघाड़यो से। <verse eid="JHN 9:32"/><verse number="33" style="v" sid="JHN 9:33"/>अदी यो मानूस परमेस्वर को कन लक नही होतो, ता यो काही भी नही कर सकतो।”<verse eid="JHN 9:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="JHN 9:34"/>उनना जवाब देइन, “का तु खरो-खर मा पाप मा रहयोसेस, अना पाप लक जलम लेयीसेस। अना अता तु हमला सीकावासे?” अना उनना वोला बाहेर हेड़ देयीन।<verse eid="JHN 9:34"/></para>
  <para style="s">मन को अँधरापन</para>
  <para style="p">
    <verse number="35" style="v" sid="JHN 9:35"/>यीसु ना आयकिस की उनना ओला बाहेर हेड देइन, अना जबा वोला मिलयो ता कहीस, “का तु मानूस को टूरा पर भरोसा करासेस?”<verse eid="JHN 9:35"/></para>
  <para style="p">
    <verse number="36" style="v" sid="JHN 9:36"/>ओना मानूस ना जवाब देइस का, “हे पिरभू, उ कोन आय, जोको पर मि भरोसा राखु?”<verse eid="JHN 9:36"/></para>
  <para style="p">
    <verse number="37" style="v" sid="JHN 9:37"/>यीसु ना ओला कहीस, “तु ना ओला चोवीसेस, अना जोन तोरो सँग गोस्टी करा से वोच आय!”<verse eid="JHN 9:37"/></para>
  <para style="p">
    <verse number="38" style="v" sid="JHN 9:38"/>ओना कहीस, “हे पिरभू मि भरोसा करासू।” अना ओला परनाम करीस। <verse eid="JHN 9:38"/><verse number="39" style="v" sid="JHN 9:39"/>तबा यीसु ना कहीस, “मि यो संसार मा न्याय करन ला आइसेऊ। काहेकी जोन नही चोवासेत वय चोवेत, अना जो चोवासेत वय अँधरा भय जाहेत।”<verse eid="JHN 9:39"/></para>
  <para style="p">
    <verse number="40" style="v" sid="JHN 9:40"/>जोन मोसे को नियम को गुरू ओको सँग होतिन, “उनना यो गोस्टी आयक के ओको लक कहिन, का हमि अँधरा सेजन?”<verse eid="JHN 9:40"/></para>
  <para style="p">
    <verse number="41" style="v" sid="JHN 9:41"/>यीसु ना उनला साँगीस, “अदी तुम्हि अँधरा नही होतत, तो मोला पापी नही ठहरतत। पर अब कव्हसो की हमि चोवसेजन, एकोलाय, तुम्हरो पाप बनो रव्हासे।”<verse eid="JHN 9:41"/></para>
  <chapter eid="JHN 9"/>
  <chapter number="10" style="c" sid="JHN 10"/>
  <para style="s">चरवाहा अना मेढा गीन को बोधकथा</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 10:1"/>यीसु ना कहीस मि तुमला खरो-खर कव्हासू, जोन कोनी बेसकुड़ लक मेंढा को कोठा मा नही धसासे, पर कोनी दुसरो परकार लक धसासे, उ चोट्टा अना डाकु आय। <verse eid="JHN 10:1"/><verse number="2" style="v" sid="JHN 10:2"/>पर जोन मानूस बेसकुड़ लक भीतर धसासे, उ मेढा को चरानवालो से। <verse eid="JHN 10:2"/><verse number="3" style="v" sid="JHN 10:3"/>जबा उ आपरो मेढा हुनला बाहेर हेड़ देसे अना उनको मोहरा-मोहरा चलासे। अना मेढा ओको आवाज ला आयकासेत अना ओको मंघा चलासेत। <verse eid="JHN 10:3"/><verse number="4" style="v" sid="JHN 10:4"/>जबा उ आपरी सप्पा मेंढ़ा ला बाहेर हेड़ लेवासे, ता उनको पुढा-पुढा चलासे, अना मेढा ओको मंघा-मंघा होय जासेति। काहेका वय ओको आवाज जानासेत। <verse eid="JHN 10:4"/><verse number="5" style="v" sid="JHN 10:5"/>पर वय पराया को मंघा नही जासेत, पर ओको लक परायेत काहेका वय परायो को आवाज नही जानासेत। <verse eid="JHN 10:5"/><verse number="6" style="v" sid="JHN 10:6"/>यीसु ना उन लक यो बोधकथा कहीस, पर वय नही समझ पाईन का यो का गोस्टी से जोन वा उनलक कव्हसे।<verse eid="JHN 10:6"/></para>
  <para style="s">यीसु साजरो चरानवालो</para>
  <para style="p">
    <verse number="7" style="v" sid="JHN 10:7"/>तबा यीसु ना उन लक सांगयो, मि तुमी लक सही-सही कव्हसु, मेढा गीनको बेसकुड़ मि सेव। <verse eid="JHN 10:7"/><verse number="8" style="v" sid="JHN 10:8"/>जेतरो मोरो लक पुढ़ा आइन, वय सबच चोट्टा अना डाकु सेति, पर मेढा गीनना उनकी नही आयकिन। <verse eid="JHN 10:8"/><verse number="9" style="v" sid="JHN 10:9"/>बेसकुड़ मि सेव, अदी कोनी मोरो लक भितर धसेत, तो सूटकारा पाहेत, अना भीतर बाहेर आवनो-जावनो करहेत अना चारा पाहेत। <verse eid="JHN 10:9"/><verse number="10" style="v" sid="JHN 10:10"/>चोट्टा अखीन कोनी काम लाई नही आवासे, पर चोरी करन अना मार डाकन बरबाद करन ला आवासे। मि एकोलाय आई सेउ, की वय जिंदगानी पाहेत, अना लगत लक पाहेत। <figure style="fig" alt="Shepherd with his sheep in sheepfold" file="LB00014C.TIF" size="span" copy="Horace Knowles ©" ref="10:7">मेंढागिन को कोठा मा मेढ़ा को चरान वालो</figure><verse eid="JHN 10:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="JHN 10:11"/>मि साजरो चरानवालो सेव, साजरो चरान वालो मेढा गीन लाई आपरो जान देवासे। <verse eid="JHN 10:11"/><verse number="12" style="v" sid="JHN 10:12"/>बनिहार जोन ना तो मेढा को चरान वालो से अना मेढा को मालीक आय, बीघा ला आवता चोवके मेढा गिनला सोड़के पराय जासे, अना बीघा उनला धर लेवासे, अना छित्तरा देवासे। <verse eid="JHN 10:12"/><verse number="13" style="v" sid="JHN 10:13"/>उ एक बनिहार आय अना वोला मेंढा गीनको फिकर नहात, एकोलाय वा उनला सोड़के पराय जावासे। <verse eid="JHN 10:13"/><verse number="14" style="v" sid="JHN 10:14"/>मि साजरो चरानवालो सेउ, मि आपरी मेढागिन ला जानासेऊ अना मोरो मेढा मोला जानासे। <verse eid="JHN 10:14"/><verse number="15" style="v" sid="JHN 10:15"/>जसो बाबूजी मोला जानासे अना मि बाबूजी ला जानासु अना मि मेढा लाई आपरो जान देवासेउ।<verse eid="JHN 10:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 10:16"/>मोरो अखीन मेढा सेत, जोन यो मेंढ़ा खोली को नाहती, मोला उनला आननो जरुरीसेत। वय मोरो आवाज आयकेत, तबा एक करप अना एक चरानवालो होयेत। <verse eid="JHN 10:16"/><verse number="17" style="v" sid="JHN 10:17"/>बाबूजी एको लाई मोरो लक माया राखासे, की मि आपरो जान देवासेउ की ओला मंग ले लेहु। <verse eid="JHN 10:17"/><verse number="18" style="v" sid="JHN 10:18"/>मोरो जिंदगानी कोनी मोरो लक नही हीसक सकासे। पर मि ओला आपच देवसेउ, मोला ओला देवनो को भी हक से अना ओला मंग लेवन को हक से। यो हुकूम मोरो बाबूजी लक मोला मिलिसे।<verse eid="JHN 10:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="JHN 10:19"/>या गोस्टी को कारन लक यहूदिगीन मा मंग फुट पड़ गई। <verse eid="JHN 10:19"/><verse number="20" style="v" sid="JHN 10:20"/>उनमा लक लगत कव्हन लगीन, ओमा भुत से, अना उ बैताड़ से, ओकी कायलाई आयकासेव? <verse eid="JHN 10:20"/><verse number="21" style="v" sid="JHN 10:21"/>अखीन लोकहुन ना कहिन, यो गोस्टी असो मानूस को नही जोनमा भुत-पलित से। का भुत-पलित अँधरा की डोरा उघाड़ सका सेत?<verse eid="JHN 10:21"/></para>
  <para style="s">यहूदिगीन को यीसु मा भरोसा नही करनो</para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 10:22"/>ओनो दिवस मा यरुसलेम मा मंदिर को उदघाटन दिवस मनायो जात होतो, अना जाड़ो की बेरा होतो। <verse eid="JHN 10:22"/><verse number="23" style="v" sid="JHN 10:23"/>यीसु मंदिर मा सुलेमान को अँगना मा फिरत होतो। <verse eid="JHN 10:23"/><verse number="24" style="v" sid="JHN 10:24"/>तबा यहूदिगीन ना ओला घेर लेइन, अना पुसन लगीन, “तु कब तकन हमला संका मा राखजोस? अदी तु मसीह आस ता हमला साँग दे।”<verse eid="JHN 10:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 10:25"/>यीसु उनला साँगिस, “मिना तुम्हि ला साँगीसेव पर तुमला भरोसा नहाय।” मि आपरो बाबूजी को नाव लक जोन काम करासू, वाच मोरो पूरुप से। <verse eid="JHN 10:25"/><verse number="26" style="v" sid="JHN 10:26"/>पर तुमी भरोसा नही राखोसो, काहेकी मोरी मेढा गीनमा लक तुम्ही नही सेव। <verse eid="JHN 10:26"/><verse number="27" style="v" sid="JHN 10:27"/>मोरी मेढा मोरी गोस्टी ला आयकासेत, मि उनला जानासेऊ अना वय मोरो मंघा-मंघा चलसेति। <verse eid="JHN 10:27"/><verse number="28" style="v" sid="JHN 10:28"/>मि उनला अमर जिंदगी देवासु, वय कभ्भू च नास नही होहेत। अना कोनी उनला मोरो हात लक नही हिसकेत<note caller="+" style="f"><char style="fr" closed="false">10:28 </char><char style="ft" closed="false">छुड़ायेत</char></note>। <verse eid="JHN 10:28"/><verse number="29" style="v" sid="JHN 10:29"/>उनला मोरो दाअजी ना मोला देइसेस, अना कोनी उनला दाअजी को हात लक नही हिसक सकेह। <verse eid="JHN 10:29"/><verse number="30" style="v" sid="JHN 10:30"/>मी अना मोरो अजी दूई एकच सेजन।<verse eid="JHN 10:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="JHN 10:31"/>मंग यहूदी अगुवाहुन ना ओला मारन लाई गोटा<note caller="+" style="f"><char style="fr" closed="false">10:31</char><char style="ft" closed="false">पत्थर</char></note> उचलीन। <verse eid="JHN 10:31"/><verse number="32" style="v" sid="JHN 10:32"/>एतरो पर यीसु ना कहीस की, मि तुमला आपरो बाबूजी को लगत सा काम चोवायो, उनमा लक कोन तो भला काम लक मोला गोटा मारासो।<verse eid="JHN 10:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="JHN 10:33"/>यहूदिगीन ना जवाब देईन “भलो काम को लाई नही पर तु परमेस्वर की निन्दा करासेस एको लाई आमी मारासेजन। तु मानूस होयके भी आपरो आप ला, परमेस्वर मानासेत।” <verse eid="JHN 10:33"/><verse number="34" style="v" sid="JHN 10:34"/>यीसु उनला कव्हसे, का यो भी तुमरो मोसे को नियम अना गिंरथ मा लिखियो से? का मिना कहयो सेऊ, “तुमी सबच परमेस्वर सेव?” <verse eid="JHN 10:34"/><verse number="35" style="v" sid="JHN 10:35"/>आमी जानसेजन का गिरंथ जोन कव्हासे उ हमेसा को लाई सच्चो से, अना परमेस्वर ना उन लोक हुनला परमेस्वर कहयो, जोन लोक हुनला ओको बारता दियो गयो होतो।<verse eid="JHN 10:35"/></para>
  <para style="p">
    <verse number="36" style="v" sid="JHN 10:36"/>“अता जोनला बाबूजी ना चघावा ठयरायके जगत मा धाड़ीसेस, का तुमी एकोलाई ओला कव्हसो, तु परमेस्वर की निन्दा करासेस? एकोलाय मि ना कव्हयो, मि परमेस्वर को टूरा सेउ। <verse eid="JHN 10:36"/><verse number="37" style="v" sid="JHN 10:37"/>अदी मि आपरो दाअजी को मरजी को जसो काम नही करासू, ता मोरो भरोसा नोको करो। <verse eid="JHN 10:37"/><verse number="38" style="v" sid="JHN 10:38"/>पर अदि मि आपरो मोठो दाअजी को काम करासेउ, ता चाहे मोरो बिस्वास नोको करो, पर काम पर ता बिस्वास करो। जोन लक तुम्हिला पता लग जाय का बाबूजी मोरो मा से अना मी बाबूजी मा सेऊ।”<verse eid="JHN 10:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="JHN 10:39"/>तबा उनना मंग ओला धरन को कोसिस करीन, पर उ उनको हात लक बूचक गयो। <verse eid="JHN 10:39"/><verse number="40" style="v" sid="JHN 10:40"/>मंग उ यरदन नदी को वोनागन पराय गयो। जिता योहन पुढा बप्तिस्मा देवत होतो, अना उतच रहयो। <verse eid="JHN 10:40"/><verse number="41" style="v" sid="JHN 10:41"/>तबा लगत लोक ओको कठा आयके कव्हन लगीन, योहन ना तो कोनी निसान नही दिसाइस, पर जोन काही योहन ना येको बारे मा सांगी होतीस, उ सब खरो से। <verse eid="JHN 10:41"/><verse number="42" style="v" sid="JHN 10:42"/>अना उता लगत लोकगीन ना यीसु पर भरोसा करीन।<verse eid="JHN 10:42"/></para>
  <chapter eid="JHN 10"/>
  <chapter number="11" style="c" sid="JHN 11"/>
  <para style="s">लाजर को मरनो</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 11:1"/>एक आदमी को नाव लाजर होतो, उ आपरो बहिन मरियम अना मारथा को संग बैतनिय्याह नगर मा रव्हत होतो, उ बिमार भई गयो। <verse eid="JHN 11:1"/><verse number="2" style="v" sid="JHN 11:2"/>या वाच मरियम से, जेना पिरभू पर इतर डाकके ओको पाय ला चुन्दी लक मलन लगीन। वोको भाऊ लाजर बीमार होतो। <verse eid="JHN 11:2"/><verse number="3" style="v" sid="JHN 11:3"/>एको लाई ओकी बहिन गीनना ओको जवर खबर धाड़िन, “ओ पिरभू, अता चोव, जेनको लक तु माया राखसेस, उ बीमार पड़यो से।”<verse eid="JHN 11:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="JHN 11:4"/>यो आयक के यीसु ना कहीस, “यो बीमारी मरन लाय नहाय, पर परमेस्वर की महिमा लाय भईसे, जेनालक परमेस्वर को टूरा की महिमा होय।”<verse eid="JHN 11:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="JHN 11:5"/>यीसु मारथा, ओकी बहिन अना लाजर सब लक माया राखत होतो। <verse eid="JHN 11:5"/><verse number="6" style="v" sid="JHN 11:6"/>जबा ओना आयकिस की लाजर बीमार से, तबा उ जहान होतो उतच दुई दिवस अखीन रूकयो। <verse eid="JHN 11:6"/><verse number="7" style="v" sid="JHN 11:7"/>तबा उ चेला गीन लक कहीस, “आव आमी यहुदिया ला चलबीन।” <verse eid="JHN 11:7"/><verse number="8" style="v" sid="JHN 11:8"/>चेला गीनना कहिन, “गुरू, अबा तो यहूदी तोला गोटा मारत होतीन, अना अबा तु उता जावासेस?”<verse eid="JHN 11:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="JHN 11:9"/>यीसु ना जवाब देईस, “का दिवस मा 12 तास नही होवासे? अदी कोनी दिवस-दिवस मा चलासे ता खोद्दा नही खावासे, काहेकि यो जगत को उजाड़ो चोवासे। <verse eid="JHN 11:9"/><verse number="10" style="v" sid="JHN 11:10"/>पर अदी कोनी राति मा चलासे ता खोद्दा खावासे, काहेकि उ इंधारो मा चलासे।” <verse eid="JHN 11:10"/><verse number="11" style="v" sid="JHN 11:11"/>यो गोस्टी सांगनो पर यीसु ना कहीस, “हमरो संगी लाजर जप मा से, मि ओला जगान जावासु।”<verse eid="JHN 11:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 11:12"/>तबा चेला ना ओला कहिन हे पिरभू अदी उ जप मा से, तो उ साजरो भई जाहे।<verse eid="JHN 11:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="JHN 11:13"/>यीसु ना तो वोको मौत को बारे मा सांगी होतीस, पर वय समजीन की जप को बारे मा सांगसेस। <verse eid="JHN 11:13"/><verse number="14" style="v" sid="JHN 11:14"/>तबा यीसु ना उन लक सप्पा-सप्पा कह देईस “लाजर मर गई से, <verse eid="JHN 11:14"/><verse number="15" style="v" sid="JHN 11:15"/>अखीन मि खुस सेव का आमी उता नही होता, का तुमी भरोसा करहो। पर आव, आमी ओको कठा जाबिन।”<verse eid="JHN 11:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 11:16"/>तबा थोमा, “जोन दिदमुस<note caller="+" style="f"><char style="fr" closed="false">11:16</char><char style="ft" closed="false">जुड़या</char></note> कहलावसे, आपरो संगी चेला गीन ला कव्हसे, आव, हमि भी ओको सँगा मरन ला चलबिन।”<verse eid="JHN 11:16"/></para>
  <para style="s">यीसु खुद पुनरुत्थान अना जीवन आय</para>
  <para style="p">
    <verse number="17" style="v" sid="JHN 11:17"/>उता पहुचनो पर यीसु ला मालुम भयो, की लाजर ला मरयो अना मरघट्टी मा राखो चार दिवस भई, <verse eid="JHN 11:17"/><verse number="18" style="v" sid="JHN 11:18"/>जोन बैतनिय्याह यरुसलेम को जवर कोनी तीन किलोमीटर <note caller="+" style="f"><char style="fr" closed="false">11:18</char><char style="ft" closed="false">दोन मील </char></note>की दुरी पर होतो। <verse eid="JHN 11:18"/><verse number="19" style="v" sid="JHN 11:19"/>लगत यहूदिगीन मारथा अना मरियम को जवर ओको भाऊ की मौत पर सान्ती देवन लाई आई होतीन।<verse eid="JHN 11:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="JHN 11:20"/>जबा मारथा ना यीसु को आवन को खबर आयकिस, ता ओला मिलन को लाई गई, पर मरियम घर मा बसी रहयी। <verse eid="JHN 11:20"/><verse number="21" style="v" sid="JHN 11:21"/>मारथा ना यीसु लक कहीस, हे पिरभू! अदी तु यहान होतो, ता मोरो भाऊ कभ्भूच नही मरतो <verse eid="JHN 11:21"/><verse number="22" style="v" sid="JHN 11:22"/>अखीन अबा भी मि जानासेऊ की जोन कही तु परमेस्वर लक माँगजो ता परमेस्वर तोला देहे। <verse eid="JHN 11:22"/><verse number="23" style="v" sid="JHN 11:23"/>यीसु ना ओको लक कहीस, तोरो भाऊ जिँदो भई जाहे।<verse eid="JHN 11:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="JHN 11:24"/>मारथा ना ओला कहीस, मि जानासेऊ की आखीर दिवस मा सबको जित्तो होवनो <note caller="+" style="f"><char style="fr" closed="false">11:24</char><char style="ft" closed="false">मर हुओ मे से जी उठना</char></note> को बेरा उ जी उठेत।<verse eid="JHN 11:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 11:25"/>यीसु ना ओला कहीस, जित्तो होवनो, अना जिंदगी मि सेउ, जोन कोनी मोरो पर भरोसा करेत, उ अदी मर भी जाहेत ता भी जीहेत। <verse eid="JHN 11:25"/><verse number="26" style="v" sid="JHN 11:26"/>अना जोन कोनी जित्तो से अना मोरो पर भरोसा करासे, उ अमर काल तकन नही मरेह। का तु भरोसा करसेस?<verse eid="JHN 11:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="JHN 11:27"/>ओना ओला कहीस, हव पिरभू, मि भरोसा करुसेउ, की तुच परमेस्वर को टूरा मसीह आस, जोन जगत मा आवनवालो होतो।<verse eid="JHN 11:27"/></para>
  <para style="s">यीसु को रड़नो</para>
  <para style="p">
    <verse number="28" style="v" sid="JHN 11:28"/>यो कहके मारथा चली गई, अना आपरी बहिन मरियम ला बुलाके चुप्पी लक कहीस, गुरू यहान से अना तोला बुलावसेत। <verse eid="JHN 11:28"/><verse number="29" style="v" sid="JHN 11:29"/>यो आयक के उ एकदम उठके ओको जवर आई। <verse eid="JHN 11:29"/><verse number="30" style="v" sid="JHN 11:30"/>यीसु अबा गाँव मा नही पहुचियो होतो, पर ओना जघा मा होतो, जिता मारथा ना ओला मिली होती। <verse eid="JHN 11:30"/><verse number="31" style="v" sid="JHN 11:31"/>तबा जोन यहूदी ओको सँग घर मा होतीन अना ओला सान्ती देय रही होतीन, यो चोयके मरियम एकदम उठके बाहेर गई, ता वय यो समझीन की उ मरघट्टी पर रोवन ला जावासे ता ओको मंघा भय गईन।<verse eid="JHN 11:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="JHN 11:32"/>जबा मरियम उता पहुची जिता यीसु होतो, ता ओला चोवके ओको पाय पर पड़ गई अना कहीस, हे पिरभू! अदी तुमी इता होतत, ता मोरो भाऊ नही मरतो।<verse eid="JHN 11:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="JHN 11:33"/>जबा यीसु ना ओला अना उन यहूदिगीन ला जोन ओको सँग आई होतीन रड़ता चोवयो, ता आतमा मा लगत उदास अना बैचेन भयो।<verse eid="JHN 11:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="JHN 11:34"/>अना कहीस, तुमी ना ओला किता रखिसेव? उनना ओला कहीन हे पिरभू चलके चोव लेव।<verse eid="JHN 11:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="JHN 11:35"/>यीसु रड़यो। <verse eid="JHN 11:35"/><verse number="36" style="v" sid="JHN 11:36"/>तबा यहूदी कव्हन लागीन, चोवो उ ओको लक केतरो माया राखासे? <verse eid="JHN 11:36"/><verse number="37" style="v" sid="JHN 11:37"/>पर उनमा लक काही ना कहीन, का यो जोन अँधरा की डोरा खोलिस, यो भी नही कर सकिस, की यो मानूस न मरतो।<verse eid="JHN 11:37"/></para>
  <para style="s">लाजर को जित्तो कियो जानो</para>
  <para style="p">
    <verse number="38" style="v" sid="JHN 11:38"/>यीसु मन मा मंग लगत उदास भयो मरघट्टी पर आयो। उता एक गुफा होती, अना एक गोटा ओको पर राखियो होतो। <verse eid="JHN 11:38"/><verse number="39" style="v" sid="JHN 11:39"/>यीसु ना कहीस, गोटा ला हटाय देव?</para>
  <para style="p" vid="JHN 11:39">उ मरयो हुयो की बहिन मारथा ओला कव्हन लगीस, हे पिरभू! ओमा लक अता ता बदबु आवासे, काहेका ओला मरयो हुयो चार दिवस भई गई सेत। <verse eid="JHN 11:39"/><verse number="40" style="v" sid="JHN 11:40"/>यीसु ना वोला कहीस, का मिना तोला नही कव्हयो होतो? की अदी तु भरोसा करजोस ता परमेस्वर की महिमा ला चोवजोस। <verse eid="JHN 11:40"/><verse number="41" style="v" sid="JHN 11:41"/>तबा उनना वो गोटा ला हटाईन, यीसु ना डोरा उठायके कहीस, हे बाबूजी! मि तोरो धनवाद करू सेऊ, की तु ना मोरी आयक लेई सेस। <verse eid="JHN 11:41"/><verse number="42" style="v" sid="JHN 11:42"/>मि जानसु तु हमेसा मोरी आयकिसेस, पर जोन भीड़ इता-उता उभी से, उन ला भी भरोसा भय जाहे की तु ना मोला धाडिसेस, यो काजी मि ना असो कहीसेउ।<verse eid="JHN 11:42"/></para>
  <para style="p">
    <verse number="43" style="v" sid="JHN 11:43"/>यो कहके ओने मोठी आवाज लक हाकलीस, हे लाजर हिट आव।<verse eid="JHN 11:43"/></para>
  <para style="p">
    <verse number="44" style="v" sid="JHN 11:44"/>जोन मर गयो होतो उ कफन लक हात पाय बंधयो हिट आयो। अना ओको टोन्ड अंगोछा लक लिपटो होतो। यीसु ना कहीस, ओला उघाड़ देव अना जान देव।<verse eid="JHN 11:44"/></para>
  <para style="s">यीसु को विरोध मा साजिस</para>
  <para style="r">(<ref loc="MAT 26:1-5">मत्ती 26:1-5</ref>; <ref loc="MRK 14:1">मरकुस 14:1</ref>,<ref loc="MRK 14:2">2</ref>; <ref loc="LUK 22:1">लूका 22:1</ref>,<ref loc="LUK 22:2">2</ref>)</para>
  <para style="p">
    <verse number="45" style="v" sid="JHN 11:45"/>तबा जोन यहूदी मरियम को जवर आयो होतिन, अना ओको यो काम चोईन, उनमा लक लगत गीनना भरोसा करीन। <verse eid="JHN 11:45"/><verse number="46" style="v" sid="JHN 11:46"/>पर उनमा लक काही ना मोसे को नियम को गुरू को जवर यीसु को काम को खबर <note caller="+" style="f"><char style="fr" closed="false">11:46</char><char style="ft" closed="false">समाचार</char></note> देईन। <verse eid="JHN 11:46"/><verse number="47" style="v" sid="JHN 11:47"/>एतरो पर मुखिया याजक अना मोसे को नियम को गुरू ना मोठी सभा बुलाईन अना कहिन, हमि का करबीन, यो मानूस तो लगत निसान चोवायोसे? <verse eid="JHN 11:47"/><verse number="48" style="v" sid="JHN 11:48"/>अदी हमि ओला असोच सोड़ देबीन, तो सबच ओको पर भरोसा कर लेहेत, अना रोमी आयके आमरी जघा अना लोक दुही पर हक जमा लेहेत।<verse eid="JHN 11:48"/></para>
  <para style="p">
    <verse number="49" style="v" sid="JHN 11:49"/>तबा उनमा लक काइफा नाव को एक मोठो मुखिया याजक होतो। ओना कहीस, तुम काही भी नही जानो, <verse eid="JHN 11:49"/><verse number="50" style="v" sid="JHN 11:50"/>अखीन नही समजासो, का तुमरो लाई यो भलो से, की हमरो काजी एक मानूस मरेत, अना सप्पा लोक को नास नोको होय। <verse eid="JHN 11:50"/><verse number="51" style="v" sid="JHN 11:51"/>यो गोस्टी ओने आपरो कन लक नही कहीस, पर आवन वारो गोस्टी ला जानके, मोठो मुखिया याजक होवनो को कारन लक सांगीस, का यीसु ओना लोकगीन लाई मार दियो जाहेत। <verse eid="JHN 11:51"/><verse number="52" style="v" sid="JHN 11:52"/>अना ना केवल उन लोक को लाय पर एकोलाय की परमेस्वर की गुमयो हुयो सँतान एकठ्ठो भयी जाहे।<verse eid="JHN 11:52"/></para>
  <para style="p">
    <verse number="53" style="v" sid="JHN 11:53"/>अखीन ओनो दिवस लक वय ओला मार डाकन की सलाह करन लगीन। <verse eid="JHN 11:53"/><verse number="54" style="v" sid="JHN 11:54"/>एको लाई यीसु ओनो बेरा लक यहूदिगीन मा खुलो रित लक नही घुमयो, पर उता लक जंगल को जवर छेतर मा इफराईम नाव को एक नगर मा चली गयो, अना चेला गीन संगा उतच रव्हन लगयो।<verse eid="JHN 11:54"/></para>
  <para style="p">
    <verse number="55" style="v" sid="JHN 11:55"/>यहूदिगीन को फसह को तिहार जवर होतो। अना लगत सा लोक बलिदान को पुढा देहात लक यरुसलेम मा गईन, की आपरो आप ला पवीतर करयेत। <verse eid="JHN 11:55"/><verse number="56" style="v" sid="JHN 11:56"/>एको लाई वय यीसु ला ढुढन लगीन, अना मंदिर मा उभा होयके आपस मा कव्हन लागिन, तुमी का सोचासो? का उ तिहार मा नही आहे। <verse eid="JHN 11:56"/><verse number="57" style="v" sid="JHN 11:57"/>मोठो मुखिया याजक अना मोसे को नियम को गुरू ना यो हुकूम देईन, का अदी कोनी यो जाने की यीसु किता से ता सांगे, ताकि ओला धर<note caller="+" style="f"><char style="fr" closed="false">11:57 </char><char style="ft" closed="false">पकड़</char></note> लेबो।<verse eid="JHN 11:57"/></para>
  <chapter eid="JHN 11"/>
  <chapter number="12" style="c" sid="JHN 12"/>
  <para style="s">यीसु को पाय मा इतर डाकनो</para>
  <para style="r">(<ref loc="MAT 26:6-13">मत्ती 26:6-13</ref>; <ref loc="MRK 14:3-9">मरकुस 14:3-9</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 12:1"/>यीसु फसह को तिहार लक छह दिवस पुढा बैतनिय्याह नगर मा आयो, जिता लाजर होतो। जेनला यीसु ना मरो मा लक जित्तो करी होतिस। <verse eid="JHN 12:1"/><verse number="2" style="v" sid="JHN 12:2"/>उता उनना ओको लाई जेवन<note caller="+" style="f"><char style="fr" closed="false">12:2 </char><char style="ft" closed="false">भोजन</char></note> तैय्यार करी होतीन, अना मारथा सेवा करत होती। लाजर उनमा लक एक होतो, जोन ओको सँगा जेवन लाई बसयो होतो। <verse eid="JHN 12:2"/><verse number="3" style="v" sid="JHN 12:3"/>तबा मरियम ना जटामाँसी को ढाई किलो सुध्द कीमती इतर<note caller="+" style="f"><char style="fr" closed="false">12:3</char><char style="ft" closed="false">खुसबु देने वालो सेंट</char></note> आनके यीसु को पाय पर डाकीस, अना चुन्दी लक ओको पाय ला मलन लगीस अना इतर की महक लक सारो घर महकन लगयो। <verse eid="JHN 12:3"/><verse number="4" style="v" sid="JHN 12:4"/>पर ओको चेला मा लक यहूदा इस्करियोति नाव को एक चेला जोन ना ओला धरायो, कव्हन लगयो। <verse eid="JHN 12:4"/><verse number="5" style="v" sid="JHN 12:5"/>यो इतर तो तीन सौ सिक्का मा बेचो भी जाय सकासे अना गरिब गोर गीनला दियो जाय सकासे। <verse eid="JHN 12:5"/><verse number="6" style="v" sid="JHN 12:6"/>यो बात ओना एको लाई नही कहीस, की ओला गरीब गोर की चिंता होती, पर एको लाई कहीस, की उ चोट्टा होतो, अना ओको जवर ओकी पियुसी<note caller="+" style="f"><char style="fr" closed="false">12:6 </char><char style="ft" closed="false">थैली</char></note> रहोत होती। अना ओको मा जो काही डाकयो जावत होतो उ हेड़ लेत होतो। <figure style="fig" alt="Alabaster jars" file="HK00142C.TIF" size="col" copy="Horace Knowles ©" ref="2:12">संगमरमर को सीसी</figure><verse eid="JHN 12:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="JHN 12:7"/>यीसु ना कहीस, ओला रव्हन देव, ओला मोरो गाड़ो जावन को दिवस को लाय करन देव। <verse eid="JHN 12:7"/><verse number="8" style="v" sid="JHN 12:8"/>काहे की गरीब गोर तो तुमरो सँगा हमेसा रव्हेत,, पर मि तुमरो सँगा हमेसा<note caller="+" style="f"><char style="fr" closed="false">12:8 </char><char style="ft" closed="false">हरेक बेरा तकन बन्या रहेतिन</char></note> नही रहुँ।<verse eid="JHN 12:8"/></para>
  <para style="s">लाजर को विरोध मा साजिस</para>
  <para style="p">
    <verse number="9" style="v" sid="JHN 12:9"/>जबा यहूदी को मोठी भीड़ यो जान गईन, का उ उता से, ता वय केवल यीसु को काजी नही, बल्कि एको लाई भी आइन, का लाजर ला चोवबोन, जेनला ओने मरयो हुयो मा लक जित्तो करी होतिस। <verse eid="JHN 12:9"/><verse number="10" style="v" sid="JHN 12:10"/>तबा मोठा मुखिया याजक ना लाजर ला भी मारन की साजिस करीन। <verse eid="JHN 12:10"/><verse number="11" style="v" sid="JHN 12:11"/>काहेकि ओको काजी लगत सा यहूदी ओको पक्स मा भय गई होतीन, अना ओको पर भरोसा कर रही होतिन।<verse eid="JHN 12:11"/></para>
  <para style="s">यरूसलेम मा जीत को सँग धसनो</para>
  <para style="r">(<ref loc="MAT 21:1-11">मत्ती 21:1-11</ref>; <ref loc="MRK 11:1-11">मरकुस 11:1-11</ref>; <ref loc="LUK 19:28-40">लूका 19:28-40</ref>)</para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 12:12"/>दुसरो दिवस लगत सा लोकगीन ना जोन तिहार मा आई होतीन उनना आयक के की यीसु यरुसलेम मा आय रहयो से। <verse eid="JHN 12:12"/><verse number="13" style="v" sid="JHN 12:13"/>लोकगीन खजुर की डारी लेईन, अना ओला मिलन को लाई हिटिन। “अना चिल्लाके कव्हन लगीन।” बड़ाई होय, “धन्य से इसरायल को राजा।” जो पिरभू<note caller="+" style="f"><char style="fr" closed="false">12:13 </char><char style="ft" closed="false">सरवसक्तिमान परमेस्वर</char></note> को नाव लक आवासे।<verse eid="JHN 12:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="JHN 12:14"/>जबा यीसु ला गदही को एक बच्चा मिलयो, ता उ ओको पर बस गयो। जसो ओको बारे मा लिखि से।<verse eid="JHN 12:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="JHN 12:15"/>“अवो सिय्योन की टूरी, भेव नोको राख,</para>
  <para style="q1" vid="JHN 12:15">देख, तोरो राजा गदही को बछेरु पर</para>
  <para style="q2" vid="JHN 12:15">चघके<note caller="+" style="f"><char style="fr" closed="false">12:15 </char><char style="ft" closed="false">महिमा से भरकर</char></note> चलत आय रही से।”<verse eid="JHN 12:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 12:16"/>यीसु को चेलागीन यो गोस्टी नही समजयो होतीन, पर यीसु को महिमा मिलन को मंघा उनला हेत आयी, का यो वोको बारे मा लिखीसे अना लोक गीनना वोको संग असोच कियो होतो।<verse eid="JHN 12:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="JHN 12:17"/>तब भीड़ मा वय मानूस गीन गवाही देयीन, जोन बेरा लाजर ला मरघट्टी लक हाकल के यीसु ने जित्तो कियो होतो वोच बेरा चोयो होतीन। <verse eid="JHN 12:17"/><verse number="18" style="v" sid="JHN 12:18"/>एको लाई लगत लोक गीन यीसु को आवभगत करन लाई हिटीन। ओन्हीसीन आयकीन का यीसु ना यो निसान चोवाइसेस। <verse eid="JHN 12:18"/><verse number="19" style="v" sid="JHN 12:19"/>यो सब चोय के मोसे को नियम को गुरू ना एकमेक लक कहिन, “चोव रहिसेव ना, तुमी लक काही नही होय सका। चोवो सप्पा संसार ओको मंघा चल रही से।”<verse eid="JHN 12:19"/></para>
  <para style="s">युनानीहुन लक यीसु ला ढुढनो</para>
  <para style="p">
    <verse number="20" style="v" sid="JHN 12:20"/>जोन लोक तिहार को बेरा मा पूजा करन आई होतीन, उनमा काही यूनानी होतीन। <verse eid="JHN 12:20"/><verse number="21" style="v" sid="JHN 12:21"/>उनना फिलिप्पुस को जवर आयके यो बिनती करीन, महोदय, आमी यीसु पिरभू लक मिलन आईसेजन। फिलिप्पुस गलील छेतर को बैतसेदा नगर को रव्हन वालो होतो।<verse eid="JHN 12:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 12:22"/>उ गयो अना अन्दिरयास ला यो सांगिस, तबा अन्दिरयास अना फिलिप्पुस गईन अना उनना यीसु ला एको बारे मा खबर देईन। <verse eid="JHN 12:22"/><verse number="23" style="v" sid="JHN 12:23"/>यीसु ना उन लक कहीस, उ बेरा आय गईसे, जबा मानूस को टूरा महिमा ला पाय लेहे। <verse eid="JHN 12:23"/><verse number="24" style="v" sid="JHN 12:24"/>मि तुमी लक खरो सांगासेउ जबा तकन गँहु को बीज माती मा पड़के मर नही जासे तबा तकन उ एकलो रव्होसे, पर अदी उ मर जावासे ता लगत फर देवासे। <verse eid="JHN 12:24"/><verse number="25" style="v" sid="JHN 12:25"/>जोन आपरो जान लक माया करासे, उ ओला नास करासे, अना जोन यो संसार मा आपरो जान लक बैर करासे, उ ओला अमर जिन्दगी कोलाय सुरक्सित राखासे। <verse eid="JHN 12:25"/><verse number="26" style="v" sid="JHN 12:26"/>अदी कोनी मोरो दास बननो चाव्हासे तो मोरो मंघा चले, जिता मि सेउ, उता मोरो चेला भी रव्हेत, अदी कोनी मोरी सेवा करनो चाव्हासे ता बाबूजी ओको मान करेत।<verse eid="JHN 12:26"/></para>
  <para style="s">कूरूस को मिरतु को ईसारा</para>
  <para style="p">
    <verse number="27" style="v" sid="JHN 12:27"/>“अब मोरी मन बेचेन से, का मि यो कहुँ, बाबूजी, यो बेरा को आफद लक मोला बचाव? काहेका यो काजी मि यो बेरा तकन पहुची सेउ। <verse eid="JHN 12:27"/><verse number="28" style="v" sid="JHN 12:28"/>ओ बाबूजी! लोकगीन मा आपरो नाव की महिमा कर।”</para>
  <para style="p" vid="JHN 12:28">ओनो बेरा मा यो सरग लक आवाज आई, का मिना आपरो नाव की महिमा करीसेव, अना मंग ओको महिमा करू।<verse eid="JHN 12:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="JHN 12:29"/>इता उता लोक गीनना आयक के कहिन बादल गरजियो, काही लोकगीन ना कहिन, एक सरगदूत ना वोला काही सांगयो से।।<verse eid="JHN 12:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="JHN 12:30"/>यीसु ना सांगीस यो आवाज मोरो लाई नही, बलिक तुमी लोकगीन लाय से। <verse eid="JHN 12:30"/><verse number="31" style="v" sid="JHN 12:31"/>अब यो संसार को न्याय होवा से, अब यो संसार को मुखिया हेड़ दियो जाहे। <verse eid="JHN 12:31"/><verse number="32" style="v" sid="JHN 12:32"/>अना मि जबा धरती लक वरता उचलो जाहुँ। तबा सब मानूस गीनला आपरो कन झीक लेहुँ। <verse eid="JHN 12:32"/><verse number="33" style="v" sid="JHN 12:33"/>ऐना सबद लक यीसु ना ईसारा करीस, का ओकी मिरतु कोन तरीको लक होयेत?<verse eid="JHN 12:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="JHN 12:34"/>लोकगीन ना असो सांगीन, मोसे को नियम हमला यो सिक्सा देसे की मसीह सदा रहेत, मंग तु यो कायलाय कव्हसेस, की मानूस को टूरा ला वरता जानो जरूरी से? यो मानूस टूरा<note caller="+" style="f"><char style="fr" closed="false">12:34 </char><char style="ft" closed="false">सकितसाली बेटा</char></note> कोन आय?<verse eid="JHN 12:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="JHN 12:35"/>एतरो पर यीसु ना उन ला कहीस, अता कम बेरा से की उजाड़ो तुमरो संग से। जबा तकन उजाड़ो तुमरो जवर से पुढा बढ जाओ। कहीं असो न होहे की इंधारो<note caller="+" style="f"><char style="fr" closed="false">12:35 </char><char style="ft" closed="false">अँधकार</char></note> तुमला घेर ले। जोन इंधारो मा चला से वा नही जान सका की किता जावसे? <verse eid="JHN 12:35"/><verse number="36" style="v" sid="JHN 12:36"/>जबा तकन उजाड़ो तुमरो जवर से उजाड़ो पर भरोसा ठेवो, जोन लक तुम्हि उजाड़ो की सँतान बन सको। असो कव्हनो पर यीसु चली गयो अना उनको लक लुक गयो।<verse eid="JHN 12:36"/></para>
  <para style="s">यहूदिगीन को अबिस्वास</para>
  <para style="p">
    <verse number="37" style="v" sid="JHN 12:37"/>मंग यीसु ना उनको पुढ एतरो निसान चोवाइस, मंग उनना भरोसा नही करीन। <verse eid="JHN 12:37"/><verse number="38" style="v" sid="JHN 12:38"/>एकोलाय भविस्यवक्ता यसायाह को यो कव्हनो पूरो भयो का,</para>
  <para style="q1" vid="JHN 12:38">ओ पिरभू! हमरो साजरो खबर पर कोन भरोसा ठेइस ?</para>
  <para style="q2" vid="JHN 12:38">अना पिरभू को हात को ताकत कोन पर परगट भयो से?<verse eid="JHN 12:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="JHN 12:39"/>वय एको लाई भी भरोसा नही कर सकीन, का भविस्यवक्ता यसायाह ना यो कव्हयो होतो,<verse eid="JHN 12:39"/></para>
  <para style="q1">
    <verse number="40" style="v" sid="JHN 12:40"/>मोठो परमेस्वर ना उनको डोरा ला अँधरा कर देइस</para>
  <para style="q2" vid="JHN 12:40">अना उनको अक्कल ला सटया देइस। परमेस्वर ना कव्हयो,</para>
  <para style="q2" vid="JHN 12:40">कहीं असो न होहे की वय डोरा ला चोयेत,</para>
  <para style="q2" vid="JHN 12:40">अना अक्कल लक समजेत।</para>
  <para style="q2" vid="JHN 12:40">अना मोरो मंघा भय जाहेत।</para>
  <para style="q2" vid="JHN 12:40">अना मि उन ला साजरो कर देहुँ।<verse eid="JHN 12:40"/></para>
  <para style="p">
    <verse number="41" style="v" sid="JHN 12:41"/>यसायाह ना यो सबच एको लाई साँगीस, की उनना यीसु की महिमा ला चोयी होतो, अना वोको बारे मा सांगीस<verse eid="JHN 12:41"/></para>
  <para style="p">
    <verse number="42" style="v" sid="JHN 12:42"/>मंग अधिकारी मा लक काही ना ओको भरोसा करीन, पर मोसे को नियम को गुरू को पुढा ओला नही अपनात होतीन। उनला डर होतो की सभा लक उनला कही नोको ठुकराय दियो जाय। <verse eid="JHN 12:42"/><verse number="43" style="v" sid="JHN 12:43"/>उनला परमेस्वर को मान लक ज्यादा, मानूस को मान को माया होतो।<verse eid="JHN 12:43"/></para>
  <para style="s">यीसु को बचन लक सजा</para>
  <para style="p">
    <verse number="44" style="v" sid="JHN 12:44"/>यीसु ना हाकलके कहीस, “जोन मोरो पर भरोसा करासे उ मोरो पर नही पर जोनना मोला धाड़िसेस ओको पर करासे। <verse eid="JHN 12:44"/><verse number="45" style="v" sid="JHN 12:45"/>अना जोनना मोला चोवीसेस, ओना मोरो धाड़न वालो ला चोवीसेस। <verse eid="JHN 12:45"/><verse number="46" style="v" sid="JHN 12:46"/>मि जगत मा उजाड़ो होयके आईसेऊ, एकोलाय जोन कोनी मोरो पर भरोसा करेत, उ इंधारो मा नही रव्हेत। <verse eid="JHN 12:46"/><verse number="47" style="v" sid="JHN 12:47"/>अदी कोनी मोरी गोस्टी ला आयकसे अना नही मानासे ता मि ओला सजा नही देहु। काहेकि मि जगत ला अपराधी ठहरावन को लाय नही, पर जगत ला सूटकारा<note caller="+" style="f"><char style="fr" closed="false">12:47</char><char style="ft" closed="false">अजादी</char></note> देवन ला आईसेऊ। <verse eid="JHN 12:47"/><verse number="48" style="v" sid="JHN 12:48"/>जोन मोला बेकार जानासे अना मोरी गोस्टी नही अपनावासे, ओला अपराधी ठयरावन वालो तो एक से, जेना गोस्टी मिना सांगीसेउ, वा बितो दिवस मा ओको न्याय करयेत। <verse eid="JHN 12:48"/><verse number="49" style="v" sid="JHN 12:49"/>काहे की मिना आपरो कन लक गोस्टी नही करिसेऊ, पर बाबूजी जोनना मोला धाड़िसेस ओना मोला हुकूम देईसेस, मि काजक कहुँ, अना मि काजक सांगीन? <verse eid="JHN 12:49"/><verse number="50" style="v" sid="JHN 12:50"/>अना मि जानासेऊ का ओको हुकूम अमर जिंदगी से, एकोलाय मि जेना गोस्टी ला सांगासु, बाबूजी ना मोला जसो सांगीसेस, वसोच सांगासु।”<verse eid="JHN 12:50"/></para>
  <chapter eid="JHN 12"/>
  <chapter number="13" style="c" sid="JHN 13"/>
  <para style="s">यीसु लक चेला को पाय धोवनो</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 13:1"/>फसह को तिहार को पुढा जबा यीसु ना जान लियो का मोरी बेरा आय गयो से, का मी जगत ला सोड़के बाबूजी को जवर जावनो से, ता आपरो लोकगीन लक जोन जगत मा होतीन, उनलक जसो माया उ राखत होतो, आखरी बेरा भी वसोच माया राखिस।<verse eid="JHN 13:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="JHN 13:2"/>अना जबा सैतान<note caller="+" style="f"><char style="fr" closed="false">13:2 </char><char style="ft" closed="false">इबलीस</char></note> समोन को टूरा यहूदा इस्करियोति को मन मा यो गोस्टी डाक चुकयो होतो, का ओला धरवाए। <verse eid="JHN 13:2"/><verse number="3" style="v" sid="JHN 13:3"/>यीसु ना यो जानके की, बाबूजी ना सब काही मोरो हात मा कर देईसेस। अना मि परमेस्वर को जवर लक आईसेऊ, अना परमेस्वर को जवर जासू। <verse eid="JHN 13:3"/><verse number="4" style="v" sid="JHN 13:4"/>जेवन लक उठके आपरो कपरा<note caller="+" style="f"><char style="fr" closed="false">13:4</char><char style="ft" closed="false">कपरा</char></note> ला उतार देईस, अना गमछा लक आपरी कम्मर ला बाँधिस <verse eid="JHN 13:4"/><verse number="5" style="v" sid="JHN 13:5"/>तबा बरतन मा पानी भरके चेला को पाय धोवन लगयो, अना गमछा लक पोसन लगयो। <verse eid="JHN 13:5"/><verse number="6" style="v" sid="JHN 13:6"/>जबा उ समौन पतरस को कठा गयो, तबा पतरस ना ओला कहीस, का “हे पिरभू, का तु मोरो पाय धोवसेस?”<verse eid="JHN 13:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="JHN 13:7"/>यीसु ना साँगीस, “जोन मि करासेऊ, तु ओला अबा नही जानस, पर एको मंघा समज जाजोस।”<verse eid="JHN 13:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="JHN 13:8"/>पतरस ना ओला कहीस, “तोला मी आपरो पाय कभ्भू नही धोवन देहू।” असो आयक के यीसु ना कहीस, अदी तू मोला तोरो पाय नही धोवन देजोस ता हरामेसा को लाय तोरो मोरो काही नाता नहात।<verse eid="JHN 13:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="JHN 13:9"/>समौन पतरस ना ओला कहीस, हे पिरभू ता मोरो पाय ला च नही पर हात अना डोस्का ला भी धोय देव।<verse eid="JHN 13:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="JHN 13:10"/>यीसु ना ओला कहीस जोन आंग खोर लियो सेत, वोला पाय को सिवा अखीन काही धोवन को जरूरत नहाय, पर वा सुध्द से। तुम्हि सुध्द सेव पर सबच नही। <verse eid="JHN 13:10"/><verse number="11" style="v" sid="JHN 13:11"/>उ आपरो धरानवालो ला जान गयो होतो, एको लाई ओना कहीस, तुम्हि सब का सब सुध्द नहाव।<verse eid="JHN 13:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 13:12"/>जबा उ उनको पाय धोय चुकयो, अना आपरो कपरा डाकके बस गयो, ता उन लक कव्हन लगयो, का तुम्हिला समजमा आयो! मिना तुमरो सँग काजक करीसेव? <verse eid="JHN 13:12"/><verse number="13" style="v" sid="JHN 13:13"/>तुमी मोला गुरू अना पिरभू कव्हसो अना साजरो च कव्हसो, काहे का मि वाच सेऊ। <verse eid="JHN 13:13"/><verse number="14" style="v" sid="JHN 13:14"/>अदी मी पिरभू अना गुरू होयके तुमरो पाय धोयो, तो यो जरुरी सेत का तुमी भी एकमेक को पाय धोवो। <verse eid="JHN 13:14"/><verse number="15" style="v" sid="JHN 13:15"/>काहे की मिना तुमला उदाहरन चोवायो सेऊ, का जसो मिना तुमरो सँग करीसेऊ तुमी भी वसोच करो। <verse eid="JHN 13:15"/><verse number="16" style="v" sid="JHN 13:16"/>मि तुमी लक खरो कव्हसू, दास आपरो पिरभू लक मोठो नही होवासे, अना ना धाडयो गयो आपरो धाड़न वालो लक, <verse eid="JHN 13:16"/><verse number="17" style="v" sid="JHN 13:17"/>तुमी यो गोस्टी जानासेव, अना अदी उन पर चलो तो धन्य सेव।<verse eid="JHN 13:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="JHN 13:18"/>मी तुम्हि सबको बारेमा नही सांगासेऊ, काहेका जोनला मिना निवाड़ी सेव ओला मि जानासू। पर यो एको लाय भयो से का, पवितर गिरंथ को उ गोस्टी पूरो भयी जाय “का जोन ना मोरो जेवन जेयो सेत, वोनाच मोला लात मरा सेत।” <verse eid="JHN 13:18"/><verse number="19" style="v" sid="JHN 13:19"/>अता मि तुमला हेत दिलासू, का जबा यो गोस्टी भय जाहे तो तुमी भरोसा करो। की मि वाच सेव। <verse eid="JHN 13:19"/><verse number="20" style="v" sid="JHN 13:20"/>मि तुमी लक खरो कव्हासू जोन मोरो धाड़न वारो ला अपनावसे, उ मोला अपनावासे अना जोन मोला अपनावसे उ मोरो धाड़नवालो ला अपनावासे।<verse eid="JHN 13:20"/></para>
  <para style="s">दगाबाज को कन ईसारा</para>
  <para style="r">(<ref loc="MAT 26:20-25">मत्ती 26:20-25</ref>; <ref loc="MRK 14:17-21">मरकुस 14:17-21</ref>; <ref loc="LUK 22:21-23">लूका 22:21-23</ref>)</para>
  <para style="p">
    <verse number="21" style="v" sid="JHN 13:21"/>यो गोस्टी ला साँगके यीसु आतमा मा बैचेन भयो अना ओना गवाही देइस मि तुमी लक खरो कव्हसु, की तुमी मा लक एक से, जोन मोला धराहे। <verse eid="JHN 13:21"/><verse number="22" style="v" sid="JHN 13:22"/>चेला गीनला संका भई की वा कोन को बारे मा सांगासे? ता वय एकमेक कन चोवन लगीन। <verse eid="JHN 13:22"/><verse number="23" style="v" sid="JHN 13:23"/>उन चेला मा लक एक जोन यीसु लक माया करत होतो, ओको छाती कन नवके बसत होतो। <verse eid="JHN 13:23"/><verse number="24" style="v" sid="JHN 13:24"/>तबा समौन पतरस ना ओला ईसारा करके पुसयो, साँग, उ कोन को बारे मा कव्हासे?<verse eid="JHN 13:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 13:25"/>तबा ओना ओच तरिका लक यीसु की छाती कन नवके ओको लक पुसिस, हे पिरभू उ कोन आय?<verse eid="JHN 13:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="JHN 13:26"/>यीसु ना वोकोलक सांगीस, जोनला मि यो भाकर को टुकड़ा डुबा के देहुँ वाच से, ओना टुकड़ा ला डुबायके समोन इस्करियोति को टूरा यूदूस ला देईस। <verse eid="JHN 13:26"/><verse number="27" style="v" sid="JHN 13:27"/>टुकड़ा लेवन को मंघा सैतान ओमा समाय गयो। तबा यीसु ना कहीस, जोन काम तु करन चाव्हासेस वा गदने कर। <verse eid="JHN 13:27"/><verse number="28" style="v" sid="JHN 13:28"/>पर बसन वालो मा लक कोनी नही जान पायो, का यो गोस्टी ओना ओला काय लाई कहीस। <verse eid="JHN 13:28"/><verse number="29" style="v" sid="JHN 13:29"/>यहूदा को जवर पियुसी रव्हत होतो एकोलाय काही-काही ना समजीन का यीसु ओला यो कव्हासे जो काही हमला तिहार को लाई पाहिजे उ लेके आन। या यो कहीस, गरीब गोर ला काही देव।<verse eid="JHN 13:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="JHN 13:30"/>येने परकार लक उ टुकड़ा धरयो अना बाहेर हीट गयो, वा रात को बेरा होती। <verse eid="JHN 13:30"/><verse number="31" style="v" sid="JHN 13:31"/>जबा उ बाहेर चली गयो ता यीसु ना कहीस अबा मानूस को टूरा को बड़ाई<note caller="+" style="f"><char style="fr" closed="false">13:31 </char><char style="ft" closed="false">महिमा</char></note> होवासे, अना परमेस्वर की महिमा ओमा भयोसे। <verse eid="JHN 13:31"/><verse number="32" style="v" sid="JHN 13:32"/>अदी ओमा परमेस्वर की महिमा होवासे, तो परमेस्वर भी आपरो लक ओकी महिमा करेत, अना तुरतई करेत। <verse eid="JHN 13:32"/><verse number="33" style="v" sid="JHN 13:33"/>ओ टूराहुन, मि जरा सो बेरा तकन तुमरो जवर सेउ, मंग तुम्हि मोला ढुंढने, जसो की मि यहूदिगीन लक कव्हसू, जिता मि जावासेऊ, उता तुमी नही आय सको, वसोच तुम्हिला भी कव्हासू। <verse eid="JHN 13:33"/><verse number="34" style="v" sid="JHN 13:34"/>मि तुम्हिला एक नवतो हुकूम देवासु, का एकमेक लक माया करो, जसो मि तुम्हरो लक माया राखासु, वसोच तुम्हि एकमेक लक माया राखो। <verse eid="JHN 13:34"/><verse number="35" style="v" sid="JHN 13:35"/>अदी आपसी मा माया राखो, ता सबच जान जाहेत, का तुम्हि मोरो चेला आव।<verse eid="JHN 13:35"/></para>
  <para style="s">पतरस ला मना करन को ईसारा</para>
  <para style="r">(<ref loc="MAT 26:31-35">मत्ती 26:31-35</ref>; <ref loc="MRK 14:27-31">मरकुस 14:27-31</ref>; <ref loc="LUK 22:31-34">लूका 22:31-34</ref>)</para>
  <para style="p">
    <verse number="36" style="v" sid="JHN 13:36"/>समौन पतरस ना ओला कहीस, हे पिरभू तु किता जावसेस? यीसु ना जवाब देइस, जिता मि जावसु उता तु नही आय सकस, पर येको मंघा मोरो मघानी आवजोस।<verse eid="JHN 13:36"/></para>
  <para style="p">
    <verse number="37" style="v" sid="JHN 13:37"/>पतरस ना ओला कहीस, हे पिरभू अबा मि तोरो मंघा काय लाई नही आय सकु? मि तो तोरो लाई आपरो जान भी दे देहुँ।<verse eid="JHN 13:37"/></para>
  <para style="p">
    <verse number="38" style="v" sid="JHN 13:38"/>यीसु ना जवाब देइस, का तु मोरो लाई आपरो जान देजोस? मि तोरो लक खरो सांगासु का कुकड़ा चिल्लावन को पहले तु मोरो नाव लक तीन डाई मुकर जाजोस।<verse eid="JHN 13:38"/></para>
  <chapter eid="JHN 13"/>
  <chapter number="14" style="c" sid="JHN 14"/>
  <para style="s">परमेस्वर को कठा पहुचन को रास्ता</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 14:1"/>तुमरो मन बैचेन नोको होय, तुम्हि परमेस्वर पर भरोसा राखिसो, मोरो पर भी भरोसा राखो। <verse eid="JHN 14:1"/><verse number="2" style="v" sid="JHN 14:2"/>मोरो बाबूजी को घर मा लगत सा रव्हन को जघा सेत, अदी नही होतो ता मि तुम्हिला सांग देतो। काहे की मि तुमरो लाय जघा<note caller="+" style="f"><char style="fr" closed="false">14:2 </char><char style="ft" closed="false">जगह</char></note> तैय्यार करन जावासू। <verse eid="JHN 14:2"/><verse number="3" style="v" sid="JHN 14:3"/>अना अदी मि जायके तुमरो लाई जघा तैय्यार करासू, ता मंग आयके तुमला आपरो सँग ले जाहुँ। की जिता मि रव्हुसु, उतच तुम्हि भी रव्हो। <verse eid="JHN 14:3"/><verse number="4" style="v" sid="JHN 14:4"/>अना जिता मि जावनो पर सेव, तुम्हि उता को रास्ता ला जानासेव।<verse eid="JHN 14:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="JHN 14:5"/>थोमा ना कहीस, हे पिरभू हमला मालूम नहाय, का तु किता जावसेस। ता रास्ता कसो जानबोन?<verse eid="JHN 14:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="JHN 14:6"/>यीसु ना ओला कहीस, रास्ता, खराई अना जीवन मिच आव। मोरो बगर कोनी बाबूजी को जवर नही जाय सका। <verse eid="JHN 14:6"/><verse number="7" style="v" sid="JHN 14:7"/>अदी तुमी मोला जानने, ता मोरो बाबूजी ला भी जानने। पर अब तुम्हि ओला जान गयो सेव अना चोवासो।<verse eid="JHN 14:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="JHN 14:8"/>फिलिप्पुस ओला कव्हसे, हे पिरभू! बाबूजी ला हमला चोवा। याच हमरो लाई लगत से।<verse eid="JHN 14:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="JHN 14:9"/>यीसु ना ओला कहीस, हे फिलिप्पुस, मि एतरो दिवस तकन तुमरो जवर रहयो, अना का तु मोला नही जानासे? एको लाई जोन ना मोला चोय लियो ओना बाबूजी ला चोय लेइसेस। तु कायलाय कव्हसेत की बाबूजी ला हमला चोवाय? <verse eid="JHN 14:9"/><verse number="10" style="v" sid="JHN 14:10"/>का तोला भरोसा नहात? का मि बाबूजी मा सेव अना बाबूजी मोरो मा से, यो गोस्टी जोन तुमी लक कव्हसु आपरो आपच लक नही कव्हसू पर बाबूजी जोन मोरो मा से, आपरो काम करासे। <verse eid="JHN 14:10"/><verse number="11" style="v" sid="JHN 14:11"/>मोरोच भरोसा करो की मि बाबूजी मा सेव अना बाबूजी मोरो मा से। नही ता काम लक च मोरो भरोसा करो।<verse eid="JHN 14:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 14:12"/>यीसु ना उनला खरो साँगीस, जोन मोरो पर भरोसा करासे, जसो काम मि करासू, वसोच काम उ भी करेत, वरन ओको लक भी मोठो काम करेत। <verse eid="JHN 14:12"/><verse number="13" style="v" sid="JHN 14:13"/>मि तुम्हि लोकगीन लक खरोखर कव्हसू-अना जोन काही तुम्हि मोरो नाव लक माँगने ता वा पूरो होहेत। जोनलक मोरो लक बाबूजी की महिमा होहे। <verse eid="JHN 14:13"/><verse number="14" style="v" sid="JHN 14:14"/>अदी कोनी बात ला तुम्हि लोकगीन मोरो नाव लक माँगो ता मि ओला करहुँ।<verse eid="JHN 14:14"/></para>
  <para style="s">पवीतर आतमा को वायदा</para>
  <para style="p">
    <verse number="15" style="v" sid="JHN 14:15"/>अदी तुमी मोरो लक माया राखने ता मोरी हुकूम ला मानने <verse eid="JHN 14:15"/><verse number="16" style="v" sid="JHN 14:16"/>मि बाबूजी लक बिनती करुहुँ अना उ तुमला एक अखीन सहारा देहे की उ सदा तुमरो सँग रहे <verse eid="JHN 14:16"/><verse number="17" style="v" sid="JHN 14:17"/>मजे खराई को आतमा, जेनला ना तो जगत अपनाव सकासे, ना ओला जानासे, काहे की उ तुमरो संग च रव्हासे अना तुममा च होहे।<verse eid="JHN 14:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="JHN 14:18"/>मि तुमला फिरतहा नहि छोड़ू, मि तुमरो जवर आवासेऊ। <verse eid="JHN 14:18"/><verse number="19" style="v" sid="JHN 14:19"/>जरासो देर मंघा यो जगत मोला नही चोवहे। पर तुमी मोला चोवहो, एको लाई की मि जित्तो सेव, तुमी भी जित्तो रव्हो। <verse eid="JHN 14:19"/><verse number="20" style="v" sid="JHN 14:20"/>उ दिवस तुमी जानने की मि आपरो बाबूजी मा सेव, अना तुम्हि मोरो मा सेव अना मि तुमरो मा सेव।<verse eid="JHN 14:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="JHN 14:21"/>जोनो को जवर मोरो हुकूम सेत अना उ ओला मानासे। वाच मोरो लक माया राखासे, अना मी ओको लक माया राखुँ। अना आपरो आप ला ओको पर परगट करुह।<verse eid="JHN 14:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 14:22"/>एक यहूदा नाव को चेला जो इस्करियोति नही होतो, ओला कहीस, “हे पिरभू, का भयो का तु आपरो आप ला हमि पर दिखान चाव्हासेस अना जगत पर नही।”<verse eid="JHN 14:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="JHN 14:23"/>यीसु ना जवाब देईस, अदी कोनी मोरो लक माया राखेह, ता उ मोरो सबद ला मानेह। अना मोरो बाबूजी ओको लक माया राखेह, अना हमि ओको जवर आवबिन अना ओको सँग रव्हबिन। <verse eid="JHN 14:23"/><verse number="24" style="v" sid="JHN 14:24"/>जोन मोरो माया नही राखा, उ मोरो गोस्टी ला नही मानासे अना जोन गोस्टी तुमीना आयकीसेव, उ मोरो नही पर बाबूजी को से, जोनना मोला धाड़िसेस।<verse eid="JHN 14:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 14:25"/>यो गोस्टी मिना तुमरो सँग रहतो बखत कव्हसू। <verse eid="JHN 14:25"/><verse number="26" style="v" sid="JHN 14:26"/>पर जबा उ सहायक मजे पवीतर आतमा आहेत, जोनला बाबूजी मोरो नाव लक धाडे़त, उ तुम लोकगीन ला सबच गोस्टी सिखाहे। अना सब काही हेत कराहे, जोनला मिना कहीसेउ।<verse eid="JHN 14:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="JHN 14:27"/>मि तुमला सान्ती देय के जासू, आपरो सान्ती तुमला देवासु। जसो जगत देसे वसो मि तुमला नही देहुँ, तुमरो मन बेचैन नोको होयेत, अना नोको डराव। <verse eid="JHN 14:27"/><verse number="28" style="v" sid="JHN 14:28"/>तुमी आयकासेव का मिना तुमला कव्हयो होतो, मि जावासू अना तुमरो जवर मंग आहू, अदी तुम्हि माया राखिसेव तो यो गोस्टी लक खुस होवो की मि बाबूजी को जवर जावासू, अना बाबूजी मोरो लक मोठो से। <verse eid="JHN 14:28"/><verse number="29" style="v" sid="JHN 14:29"/>मिना तुमला असो होवनो को पुढा कव्ह देइसेव, की जबा उ भय जाहे, ता तुमी भरोसा करहो। <verse eid="JHN 14:29"/><verse number="30" style="v" sid="JHN 14:30"/>मि अबा तुमरो सँग अखीन गोस्टी नही करू। काहे का यो जगत को अधिकारी आवासे, मोरो पर ओको काही हक नही। <verse eid="JHN 14:30"/><verse number="31" style="v" sid="JHN 14:31"/>पर यो एकोलाय होवासे, की जगत जानेह की मि बाबूजी लक माया राखासू, अना जसो बाबूजी ना मोला हुकूम देइसेस वसोच करूसू, उठो, यहान लक चलो।<verse eid="JHN 14:31"/></para>
  <chapter eid="JHN 14"/>
  <chapter number="15" style="c" sid="JHN 15"/>
  <para style="s">यीसु सही को अंगूर को बेला</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 15:1"/>खरो अंगूर की बेला मि सेव। अना मोरो बाबूजी कास्तकार से। <verse eid="JHN 15:1"/><verse number="2" style="v" sid="JHN 15:2"/>जोन डाली मोरो मा से अना नही फरासे, ओला उ काट डाकासे, अना जो फरासे, ओला छाटासे, जोन लक अखीन फरेत। <verse eid="JHN 15:2"/><verse number="3" style="v" sid="JHN 15:3"/>तुम्हि तो उ गोस्टी लाय सुध्द सेव जोन मिना सांगासेऊ, <verse eid="JHN 15:3"/><verse number="4" style="v" sid="JHN 15:4"/>तुम्हि मोरो मा बनो रव्हो, अना मि तुमरो मा, जसो डार अदी अंगूर बेला मा बनी रव्हसे, ता तबच फर सकेत।<verse eid="JHN 15:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="JHN 15:5"/>मि अंगूर बेला सेव, तुमी डार सेव, जोन मोरो मा बनो रव्हासे, अना मि ओमा, उ लगत फर फरासे, काहेकि तुम्हि मोरो लक बेगरो भयके, तुम्हि काही नही कर सको। <verse eid="JHN 15:5"/><verse number="6" style="v" sid="JHN 15:6"/>अदी कोनी मोरो मा बनो नोको रव्हेत, ता उ डार को जसो फेक दियो जावासे, अना सूक जावासे, अना लोक गीन उनला एकठ्ठो करके स्तो मा झोक देवासेत, अना वय जर जासेत। <verse eid="JHN 15:6"/><verse number="7" style="v" sid="JHN 15:7"/>अदी तुम्हि मी मोरो मा बनयो रव्हो अना मोरो गोस्टी तुमी मा बनी रव्हो, तो जोन चाव्हो माँगने तो उ तुमरो लाय भई जाहे। <verse eid="JHN 15:7"/><verse number="8" style="v" sid="JHN 15:8"/>मोरो बाबूजी की बड़ाई योच लक होवासे, तुम्हि लगत सा फर आननो, तबाच तुम्हि मोरो चेला कहलाने।<verse eid="JHN 15:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="JHN 15:9"/>जसो बाबूजी ना मोरो लक माया राखीसेस, वसोच मिना तुमी लक माया राखीसेऊ, मोरो माया मा बनो रव्हो। <verse eid="JHN 15:9"/><verse number="10" style="v" sid="JHN 15:10"/>अदी तुमी मोरो हुकूम ला मानने तो मोरो माया मा बनयो रव्हने। जसो की मीना आपरो बाबूजी को हुकूम ला मानीसेऊ, अखीन ओको माया मा बनयो रहोसेऊ।<verse eid="JHN 15:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="JHN 15:11"/>मिना यो गोस्टी तुम्हि लक एकोलाय कहीसेउ, की मोरो खुसी तुम्हि मा बनो रव्हो, अना तुम्हरो खुसी पूरो भई जाहे। <verse eid="JHN 15:11"/><verse number="12" style="v" sid="JHN 15:12"/>मोरो हुकूम यो से की जसो मिना तुम्हि लक माया राखीसेऊ, वसोच तुम्हि भी एकमेक लक माया राखो। <verse eid="JHN 15:12"/><verse number="13" style="v" sid="JHN 15:13"/>एको लाई मोठो माया कोनतो से?का कोनी आपरो संगी को लाई आपरो जान देदे? <verse eid="JHN 15:13"/><verse number="14" style="v" sid="JHN 15:14"/>जोन हुकूम मि तुम्हिला देसु, अदी ओला मानने तो तुम्हि मोरो संगी सेव। <verse eid="JHN 15:14"/><verse number="15" style="v" sid="JHN 15:15"/>अता अबा लक मि तुम्हिला दास नही कहुँ, काहे की नौकर ला मालुम नही रव्हासे का वोको मालीक काजक करासे?पर मि ना तुमला संगी कहीसेउ, काहे की मिना जोन गोस्टी आपरो बाबूजी लक आयकासेऊ, वय सबच तुमला साँग देइसेउ। <verse eid="JHN 15:15"/><verse number="16" style="v" sid="JHN 15:16"/>तुम लोकगीन ना मोला नही निवाड़ो सेव पर मिना तुमला निवाड़ी सेव अना तुमला ठहराई सेउ की तुमी जायके फर आनो अना तुमरो फर बनो रहे। की तुम्हि मोरो नाव लक जोन काही बाबूजी लक माँगो, उ तुमला देहे। <verse eid="JHN 15:16"/><verse number="17" style="v" sid="JHN 15:17"/>यो गोस्टी को हुकूम, मि तुमला एको लाई देवसु की तुमी एकमेक लक माया राखो।<verse eid="JHN 15:17"/></para>
  <para style="s">जगत लक बइर</para>
  <para style="p">
    <verse number="18" style="v" sid="JHN 15:18"/>अदी जगत तुमरो लक बइर राखासे तो तुम्हि जानासो की ओना तुमरो लक पुड़ा मोरो लक बयिर राखिस। <verse eid="JHN 15:18"/><verse number="19" style="v" sid="JHN 15:19"/>अदी तुमी जगत का होतत, तो जगत तुमरो लक माया राखतो, पर एको काजी की तुमी जगत को नही सेव, काहेका मि ला जगत मा लक निवाड़ी सेव। एकोलाय जगत तुमी लक बइर राखासे। <verse eid="JHN 15:19"/><verse number="20" style="v" sid="JHN 15:20"/>जोन गोस्टी मिना तुमी लक कहीसेउ, वोला हेत राखो, दास आपरो पिरभू लक मोठो नही होवासे, अदी ओन्हीसीन मोला तगाईन, तो तुमला भी तंगाहेत। अदी ओन्हिसीन मोरी गोस्टी मानीन, तो तुमरो भी मानहेत। <verse eid="JHN 15:20"/><verse number="21" style="v" sid="JHN 15:21"/>पर यो सबच काही वय मोरो नाव को कारन तुमी लोक सँग करहेती। काहे की वय मोरो धाड़न वालो ला नही ओरखासेस।<verse eid="JHN 15:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 15:22"/>अदी मि नही आतो, अना उनलक गोस्टी नही करतो, तो वय पापी नही ठयरतिन, पर अबा उनला उनको पाप लाई कोनी बहाना नाहती। <verse eid="JHN 15:22"/><verse number="23" style="v" sid="JHN 15:23"/>जोन मोरो लक बइर राखसेत, उ मोरो बाबूजी लक भी बइर राखसेत। <verse eid="JHN 15:23"/><verse number="24" style="v" sid="JHN 15:24"/>यदी मिना उनमा वय काम नही करतो जोन कोनी ना नही करयो सेत, ता वय पापी नही ठयरतत। पर अबा तो उनना मोला अना मोरो बाबूजी दुही ला चोवीसेत अना दुही लक बइर कियो, <verse eid="JHN 15:24"/><verse number="25" style="v" sid="JHN 15:25"/>यो एकोलाय भयो का वा सबद पूरो होय, जोन उनको मोसे को नियम मा लिखीसे, “उनना मोरो लक बेकार च बइर करीसेत।”<verse eid="JHN 15:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="JHN 15:26"/>पर जबा उ सहायक आहे मजे खराई को आतमा जेनला मि तुमरो जवर बाबूजी को कन लक धाड़हु मजे सत को आतमा, जोन अजी को कनलक हीटासेत वो मोरो गवाही देहेत। <verse eid="JHN 15:26"/><verse number="27" style="v" sid="JHN 15:27"/>अना तुमी भी मोरो गवाही सेव काहे की तुमी सुरु मा मोरो सँग रही सेव।<verse eid="JHN 15:27"/></para>
  <chapter eid="JHN 15"/>
  <chapter number="16" style="c" sid="JHN 16"/>
  <para style="p">
    <verse number="1" style="v" sid="JHN 16:1"/>यो गोस्टी मिना तुमी लक एकोलाय सांगासू का तुम्हि डावाडोल नोको होव। <verse eid="JHN 16:1"/><verse number="2" style="v" sid="JHN 16:2"/>वय तुम्हिला पिराथना सभा अना समाज लक हेड़ देहेत, इतरोच नही पर उ बेरा आवासे, की जो कोनी तुमला मार डाकेह, उ समजेत की मि परमेस्वर की सेवा करुसु। <verse eid="JHN 16:2"/><verse number="3" style="v" sid="JHN 16:3"/>असो वय एकोलाय करयेत, की उन बाबूजी ला नही जानासेत, अना मोला भी नही जानासेत। <verse eid="JHN 16:3"/><verse number="4" style="v" sid="JHN 16:4"/>पर यो गोस्टी मिना एकोलाय तुमी लक सांगीसेउ की जबा एको बेरा आहे तो तुमला हेत आहे की मिना तुम्हि लक पुढा च सांग दियो होतो।<verse eid="JHN 16:4"/></para>
  <para style="s">पवीतर आतमा को काम</para>
  <para style="p">
    <verse number="5" style="v" sid="JHN 16:5"/>मि ना सुरु मा तुम्हि लक यो गोस्टी एकोलाय नही सांगयो, काहे की मि तुम्हारो सँग होतो, पर अबा मि आपरो धाड़नवालो को जवर जावासू अना तुम्हि मा लक कोनी मोरो लक नही पुसेत, तु कहाँन जासेस? <verse eid="JHN 16:5"/><verse number="6" style="v" sid="JHN 16:6"/>पर मिना जोन गोस्टी तुमी लक सांगीसेउ एकोलाय तुम्हारो मन सोक लक भरीयो से। <verse eid="JHN 16:6"/><verse number="7" style="v" sid="JHN 16:7"/>ता भी मि तुम्हि ला खरो सांगासू, का मोरो जावनो तुमरो लाय साजरो से, काहेकी अदी मि नही जाऊ तो उ सहायक तुमरो जवर नही आहेत, पर अदी मि जाउ तबा ओला तुमरो जवर धाड़ू। <verse eid="JHN 16:7"/><verse number="8" style="v" sid="JHN 16:8"/>उ आयके जगत ला पाप अना नेकी अना न्याय को बारेमा बेजवाब करेत। <verse eid="JHN 16:8"/><verse number="9" style="v" sid="JHN 16:9"/>पाप को बारे मा एकोलाय की वय मोरो पर भरोसा नही करयेत। <verse eid="JHN 16:9"/><verse number="10" style="v" sid="JHN 16:10"/>अना नेकीपन को बारे मा एकोलाय की मि बाबूजी को जवर जासू अना तुमी मोला मँग नही चोहो। <verse eid="JHN 16:10"/><verse number="11" style="v" sid="JHN 16:11"/>न्याय को बारे मा एकोलाय का जगत को मुखिया दोसी ठयरायो गई से।<verse eid="JHN 16:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 16:12"/>मोला तुम्हि लक अखीन भी लगत सी गोस्टी कव्हनो से, पर अबा तुमी उनला सहन नही कर सकेत। <verse eid="JHN 16:12"/><verse number="13" style="v" sid="JHN 16:13"/>पर जबा उ असो खराई को आतमा आहे, ता तुमला सबच खराई को रास्ता सांगेत, काहेकी उ आपरो कन लक नही सांगेत पर जोन-जोन काही आयकेत वाच ला सांगेत अना आवनवालो गोस्टी तुमला सांगेत। <verse eid="JHN 16:13"/><verse number="14" style="v" sid="JHN 16:14"/>उ मोरी बड़ाई करेत, काहेकि उ मोरो गोस्टी लक तुम्हिला सांगेत। <verse eid="JHN 16:14"/><verse number="15" style="v" sid="JHN 16:15"/>जोन काही बाबूजी को से, उ सबच मोरो से, एकोलाय मिना कव्हयो का उ मोरी गोस्टी मा लक तुम्हिला सांगेत।<verse eid="JHN 16:15"/></para>
  <para style="s">दुख ला सुक मा बदलेत</para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 16:16"/>जरासो बेरा को बादमा तुम्हि मोला नही चोवने पर जरासो बेरा को बाद मंग मोला चोवने।<verse eid="JHN 16:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="JHN 16:17"/>यो गोस्टी आयक के यीसु को काही चेलागीन एकमेक लक सांगन लगीन, यो अमीला काजक सांगासे? जरासो बेरा मा तुमी मोला नही चोवने, मँग जरासो बेरा मा तुम्हि मोला चोवने। <verse eid="JHN 16:17"/><verse number="18" style="v" sid="JHN 16:18"/>तबा चेला गीन ना कहीन, “ यो जरासो बेरा” कव्हसे, एको काजक मतलब से, अमीला समजमा नही आवासेत?<verse eid="JHN 16:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="JHN 16:19"/>यीसु जानत होतो का वय वोको लक काही सवाल करनो चाव्हासेत, तबा यीसु ना कव्हयो, तुम्हि एकमेक लक बिचार करासो, का यो “जरासो बेरा मा मोला नही चोवने मंग जरासो बेरा मा मोला चोवने” को काजक मतलब सेत? <verse eid="JHN 16:19"/><verse number="20" style="v" sid="JHN 16:20"/>मि तुम्हिला खरो सांगासू का “तुम्हि रड़तो रव्हने अना जगत खुसहाली मनाहेत, तुम्हिला दुख होहेत पर तुमरो दुख खुसहाली मा बदल जाहेत। <verse eid="JHN 16:20"/><verse number="21" style="v" sid="JHN 16:21"/>लेकरा जलम लेवन को पुढा बायका ला दरद होवासे, काहे की ओकी दुख को बेरा आय जासे, पर जबा वा लेकरा को जलम भयी जासे ता वा खुसहाली मनावासे, का एक मानूस तन जलम लेयीसेस, अना वा मुसीबत ला हेत नही करासे। <verse eid="JHN 16:21"/><verse number="22" style="v" sid="JHN 16:22"/>वसोच परकार लक तुम्हिला अबा सोक से पर मि तुमी लक मँग मिलहु अना तुमरो मन खुसहाली लक भर जाहे। अना तुमरो खुसहाली कोनी तुम लक नही हिसक सकेत।”<verse eid="JHN 16:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="JHN 16:23"/>वोना दिवस तुम्हि लोक मोला काही नही पुसने, मि तुमरो लक खरो-खर सांगासू, “अदी मोरो नाव लक तुम्हि बाबूजी लक काही माँगने, ता उ मोरो नाव लक तुम्हिला देहेत। <verse eid="JHN 16:23"/><verse number="24" style="v" sid="JHN 16:24"/>अबा तकन तुम्हि लोक ना मोरो नाव लक काही नही माँगीसेव, माँगो तो तुम्हिला भेटेत, जोनलक तुमरो खुसहाली पूरो भई जाहेत।”<verse eid="JHN 16:24"/></para>
  <para style="s">मी दुनियाँ ला जीत लियो सेऊ</para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 16:25"/>मिना यो गोस्टी तुम्हिला उदाहरन लक सांगीसेउ, पर उ बेरा आवासे, मि तुम्हिला उदाहरन लक नही सांगू पर अबा मी तुम्हिला बाबूजी को बारे सपा-सपा साँगु। <verse eid="JHN 16:25"/><verse number="26" style="v" sid="JHN 16:26"/>ओनो दिवस तुम्हि लोक मोरो नाव लक माँगने अना मि तुम्हिला यो नही सांगासु, की मि तुमरो लाय बाबूजी लक बिनती करुहुँ। <verse eid="JHN 16:26"/><verse number="27" style="v" sid="JHN 16:27"/>काहे की परमेस्वर तो खुदच तुम्हिला माया करासे। काहेका तुम्हिना मोरो लक माया करयो से, अना यो भी भरोसा करासेव की मि बाबूजी को कनलक आईसेऊ। <verse eid="JHN 16:27"/><verse number="28" style="v" sid="JHN 16:28"/>मि बाबूजी को कन लक जगत मा आयीसेऊ, अना मि मंग जगत ला सोड़के बाबूजी को जवर जावासू।<verse eid="JHN 16:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="JHN 16:29"/>तब यीसू ना चेलागीन ना कहीन, चोव, अता तो तु खोलके सांग दियोसे, अना कोनी उदाहरन नही सांगासेस। <verse eid="JHN 16:29"/><verse number="30" style="v" sid="JHN 16:30"/>अता हमि जान गई सेजन की तु सबच काही जानासेस, अता जरूरत नहात, की कोनी तोरो लक काही पुसेत, एकोलाय अमी भरोसा करासेजन की तु परमेस्वर को कन लक आईसेस।<verse eid="JHN 16:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="JHN 16:31"/>यो आयक के यीसु ना उन लक जवाब दियो, का तुम्हि अता भरोसा करासेव। <verse eid="JHN 16:31"/><verse number="32" style="v" sid="JHN 16:32"/>चोवो, उ घडी आवासे, की तुमी सबच भटक जाहो अना आपरो-आपरो रास्ता लेहो, अना मोला एकलो सोड़ देहो। ता भी मि एकलो नही सेव, पर बाबूजी मोरो सँगमा से। <verse eid="JHN 16:32"/><verse number="33" style="v" sid="JHN 16:33"/>मि ना यो गोस्टी तुमला एकोलाय सांगीसेऊ की तुमला मोरो सान्ती मिल्हे, जगत मा तुम्हिला दुख होवासे, पर हिम्मत राखो! मि ना जगत ला जीत लियोसेऊ।<verse eid="JHN 16:33"/></para>
  <chapter eid="JHN 16"/>
  <chapter number="17" style="c" sid="JHN 17"/>
  <para style="s">मुख याजकीय यीसु को पिराथना</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 17:1"/>यीसु ना यो गोस्टी कहीस, अना आपरो डोरा सरग कन उचलके कहीस, अगो बाबूजी! वा बेरा आय गयोसे, आपरो टूरा को बड़ाई कर, की टूरा भी तोरो बडाई करहे, <verse eid="JHN 17:1"/><verse number="2" style="v" sid="JHN 17:2"/>काहेकि तुना ओला सबच मानूस जाति पर हक देईसेस, जोनलक उ उन सबला अमर जिंदगी दे, जोनला तूना वोला सोपयो सेत। <verse eid="JHN 17:2"/><verse number="3" style="v" sid="JHN 17:3"/>अना अमर जिंदगी योसे की वय तोला एकच खरो परमेस्वर अना यीसु मसीह ला, जेनला तु ना धाड़ीसेस जानेत। <verse eid="JHN 17:3"/><verse number="4" style="v" sid="JHN 17:4"/>“जोन काम तुना मोला करन लाय देइसेस ओला पूरो करके मिना धरती पर महिमा करयो सेऊ, जोन जगत बनान को पुढा, मोरो तोरी सँग होतो। <verse eid="JHN 17:4"/><verse number="5" style="v" sid="JHN 17:5"/>अता हे बाबूजी! तु आपरो सँग मोरी महिमा वा महीमा लक कर जोन जगत को पैदा होवन लक पुढा, मोरो तोरो सँग होतो।”<verse eid="JHN 17:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="JHN 17:6"/>मिना तोरो नाव वोना मानूसगिन पर उजागर कियो से, जोन लोक गीनला तुना जगत मा मोला देइसेस, वय तोरी होतीन अना तुना उनला मोला देईसेस, अखीन उनना तोरो सबद ला मना लेईसेत। <verse eid="JHN 17:6"/><verse number="7" style="v" sid="JHN 17:7"/>अबा वय जान गईसेजन जोन काही तुना मोला देईसेस, उ सबच तोरो कन लक से। <verse eid="JHN 17:7"/><verse number="8" style="v" sid="JHN 17:8"/>काहेकि जोन गोस्टी तुना देइसेस मिना उनला धाड़ीसेऊ, अना उनना ओनो गोस्टी ला भरोसा लक अपनाय लियो सेत अना खरो मा जान लेयीसेत, का मि तोरो मा लक हिटि सेऊ। ओन्हिसीन जान लियो सेत का तुना मोला धाड़ीसेस।<verse eid="JHN 17:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="JHN 17:9"/>मि उनको लाई बिनती करासू। जगत को लाई बिनती नही करुहू। पर उनको लाई जिनला तुना मोला देइसेस, काहेकि वय तोरा सेती। <verse eid="JHN 17:9"/><verse number="10" style="v" sid="JHN 17:10"/>अना जोन काही मोरो सेत, वय सबच तोरो सेत अना जोन तोरो से उ मोरो से, अना इनलक मोरो बड़ाई उजागर भई। <verse eid="JHN 17:10"/><verse number="11" style="v" sid="JHN 17:11"/>मि दुनिया मा नही रहुँ, पर यो लोकगीन दुनिया मा रहेत, अना मि तोरी जवर आवासेऊ, हे पवीतर बाबूजी, आपरो उ नाव लक जोन तुना मोला देईसेस, उनकी रक्सा कर, वय आमरो जसो एक रहेत। <verse eid="JHN 17:11"/><verse number="12" style="v" sid="JHN 17:12"/>जबा मि उनको सँग होतो, मिना तोरो उ नाव लक, जोन तुना मोला देइसेस, उनको रक्सा कर, अना नास होवनवालो टूरा ला सोड़के उन लोकगीन मा लक कोनी नास नही भयो। एकोलाय की पवितर गिरंथ मा जोन कहो गयो उ पूरो होए। <verse eid="JHN 17:12"/><verse number="13" style="v" sid="JHN 17:13"/>अबा मि तोरो जवर आवासू अना यो गोस्टी जगत मा कव्हसू, की वय मोरो खुसहाली आपरो मा पूरो पाहेत। <verse eid="JHN 17:13"/><verse number="14" style="v" sid="JHN 17:14"/>मिना तोरो गोस्टी उनला पहुचा देईसेऊ। अना जगत ना उनलक बइर करीस, काहे की जसो मि जगत को नही, वसोच वय भी जगत का नहाति। <verse eid="JHN 17:14"/><verse number="15" style="v" sid="JHN 17:15"/>मि यो बिनती नही करुहु की तू उनला जगत लक उचल लेहे, पर यो की तु उनला ओनो दुस्ट लक बचाव राख, <verse eid="JHN 17:15"/><verse number="16" style="v" sid="JHN 17:16"/>जसो मि जगत को नही। वसोच वय भी जगत का नहात। <verse eid="JHN 17:16"/><verse number="17" style="v" sid="JHN 17:17"/>खराई को दवारा उन ला पवीतर कर, तोरो सबद खराई से। <verse eid="JHN 17:17"/><verse number="18" style="v" sid="JHN 17:18"/>जसो तुना मोला जगत मा धाड़िसेस, वसो मिना मि उनला जगत मा धाड़िसेत। <verse eid="JHN 17:18"/><verse number="19" style="v" sid="JHN 17:19"/>अना उनको लाई मि आपरो आप ला पवीतर करुसेऊ काहेकि वय भी खराई को कन लक पवीतर कियो जाहेत।<verse eid="JHN 17:19"/></para>
  <para style="s">सब भरोसा राखनवारा लाय पिराथना</para>
  <para style="p">
    <verse number="20" style="v" sid="JHN 17:20"/>मि केवल इनको लाई बिनती नही करुहु, पर उनको लाई भी जोन इनको सबद लक मोरो पर भरोसा करासेत। <verse eid="JHN 17:20"/><verse number="21" style="v" sid="JHN 17:21"/>की वय सबच एक होय जाहेत। जसो तु हे बाबूजी मोरो मा सेस, अना मि तोरो मा सेव, वसोच वय आमरो मा होहेत। जेना लक जगत भरोसा करहे की तुना मोला धाड़िसेस। <verse eid="JHN 17:21"/><verse number="22" style="v" sid="JHN 17:22"/>उ महिमा जेनला तुना मोला देईसेस मिना उनला देईसेऊ, की वसोच एक होहेत। जसो की हमी एक सेजन। <verse eid="JHN 17:22"/><verse number="23" style="v" sid="JHN 17:23"/>मि उन मा अना तु मोरो मा की वय सिध्द भयके एक जाहेत अना जगत जानहेत की तुना मोला धाडिसेस अना जसो तुना मोरो लक माया राखिसेस, वसोच उनलक भी माया राख।<verse eid="JHN 17:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="JHN 17:24"/>हे बाबूजी मी चाव्हुसु की जिनला तुना मोला देईसेस, जिता मि सेव, उता वय भी मोरो सँग होहेत। की वय मोरी महिमा ला चोहेत जोन तुना मोला देइसेस। काहे की जगत को पैदा होवन को पुढा तुना मोरो लक माया राखयोस।<verse eid="JHN 17:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 17:25"/>हे न्यायी बाबूजी जगत ना मोला नही जानिस पर मिना तोला जानीसेऊ, अना इनना भी जानिन का तुना मोला धाड़िसेस। <verse eid="JHN 17:25"/><verse number="26" style="v" sid="JHN 17:26"/>मिना तोरो नाव उन लोकगीन ला साँगयो, अना साँगतो रहुँ। की जोन माया तुना मोरो लक करीसेस, वोच माया उनमा रव्हे। अना मि उनमा रहुँ।<verse eid="JHN 17:26"/></para>
  <chapter eid="JHN 17"/>
  <chapter number="18" style="c" sid="JHN 18"/>
  <para style="s">यीसु को धरायो जानो</para>
  <para style="r">(<ref loc="MAT 26:47-56">मत्ती 26:47-56</ref>; <ref loc="MRK 14:43-50">मरकुस 14:43-50</ref>; <ref loc="LUK 22:47-53">लूका 22:47-53</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 18:1"/>यीसु यो गोस्टी साँगके आपरो चेला को सँगा किदरोन नाला को वोनागन गयो। उता एक बारी होती, जोन मा उ अना ओको चेला गईन। <verse eid="JHN 18:1"/><verse number="2" style="v" sid="JHN 18:2"/>ओको धरानवालो यहूदा भी उ जघा जानत होतो, काहेकि यीसु आपरो चेला को सँगा उता जात होतो। <verse eid="JHN 18:2"/><verse number="3" style="v" sid="JHN 18:3"/>तबा यूदूस, सिपाही गीनको दल ला लेयके अना मुखिया याजक अना मोसे को नियम को गुरू कन लक सिपाही ला लेयके, दियो, टेमा अना हतियार धरके उता आयो। <verse eid="JHN 18:3"/><verse number="4" style="v" sid="JHN 18:4"/>तबा यीसु उ सब गोस्टी ला जोन ओको पर आवनवालो होती, जानके हिटयो, अना उनला कहीस कोन ला ढुँढोसेव?<verse eid="JHN 18:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="JHN 18:5"/>उनना ओला जवाब देईन,</para>
  <para style="p" vid="JHN 18:5">यीसु नासरी ला, यीसु ना उनला कहीस, मि सेव</para>
  <para style="p" vid="JHN 18:5">ओको धरानवालो यहूदा भी उतच उभयो होतो। <verse eid="JHN 18:5"/><verse number="6" style="v" sid="JHN 18:6"/>ओको कव्हन पर की मि सेऊ, वय मँघा पछलके जमीं पर गिर गईन। <verse eid="JHN 18:6"/><verse number="7" style="v" sid="JHN 18:7"/>तबा ओना मंग उनलक पुसयो, तुमी कोन ला ढुँढोसेव?</para>
  <para style="p" vid="JHN 18:7">वय बोलिन का यीसु नासरी ला! <verse eid="JHN 18:7"/><verse number="8" style="v" sid="JHN 18:8"/>यीसु ना जवाब देइस मि तो तुमला कह देइसेउ, की मि सेव, अदी मोला ढुँढोसो तो इनला जावन देव। <verse eid="JHN 18:8"/><verse number="9" style="v" sid="JHN 18:9"/>यो एकोलाय भईसे की उ सबद पूरो होहे जोन ओना कव्हयो होतिस, “जोनला तुना मोला दियो होतोस, उनमा लक मिना एक ला भी नही खोयो।”<verse eid="JHN 18:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="JHN 18:10"/>एतरो पर समौन पतरस ना, तलवार झीकके अना मोठो मुखिया याजक को दास पर चलायके ओको उज्जो कान ला काप देइस, यो दास को नाव मलखुस होतो। <verse eid="JHN 18:10"/><verse number="11" style="v" sid="JHN 18:11"/>तब यीसु ना पतरस लक कहीस, आपरी तलवार म्यान मा राख, जोन बटकी बाबूजी ना मोला देइसेस, का मि ओला नही पीहुँ?<verse eid="JHN 18:11"/></para>
  <para style="s">हन्ना को पुढा यीसु</para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 18:12"/>तबा दरोगा ना सिपाही ला हुकूम देईस, तबा यहूदिगीन को दास गीन अखीन सिपाईगीन ना यीसु ला धरके बाँध लेइन। <verse eid="JHN 18:12"/><verse number="13" style="v" sid="JHN 18:13"/>अना पुढा ओला हन्ना को जवर लेगइन, काहेकि उ ओना बरस को मोठो मुखिया याजक होतो जोन काइफा को ससुर होतो। <verse eid="JHN 18:13"/><verse number="14" style="v" sid="JHN 18:14"/>यो वाच काइफा होतो, जेना यहूदिगीन ला सलाह दियो होतो की हमरो लोकगीन को लाई एक मानूस ला मरनो साजरो से।<verse eid="JHN 18:14"/></para>
  <para style="s">पतरस को मुकरनो</para>
  <para style="r">(<ref loc="MAT 26:69">मत्ती 26:69</ref>,<ref loc="MAT 26:70">70</ref>; <ref loc="MRK 14:66-68">मरकुस 14:66-68</ref>; <ref loc="LUK 22:55-57">लूका 22:55-57</ref>)</para>
  <para style="p">
    <verse number="15" style="v" sid="JHN 18:15"/>समौन पतरस अना एक अखीन चेला यीसु को मँघा भय गइन, यो चेलाला मोठो मुखिया याजक ओरखत होतो, एकोलाय उ यीसु को सँग मोठो याजक को आँगन मा गयो। <verse eid="JHN 18:15"/><verse number="16" style="v" sid="JHN 18:16"/>पर पतरस बाहेर डहलान मा उभो होतो तबा दुसरा चेला जोनला मोठो मुखिया याजक ओरखत होतो, बाहेर हिटके अना चौकीदार लक कहके पतरस ला भीतर ले आइस। <verse eid="JHN 18:16"/><verse number="17" style="v" sid="JHN 18:17"/>वय दासी जोन चौकीदार होती पतरस लक कहीस, कहीं तु भी यो मानूस को चेला मा लक तो नही आस,</para>
  <para style="p" vid="JHN 18:17">ओना कहीस, मि नही सेव,<verse eid="JHN 18:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="JHN 18:18"/>दास अना सिपाही थन्डी को मारे अँगेठा पैटाय के स्तो तापत होतीन अना पतरस भी उनको सँग होतो।<verse eid="JHN 18:18"/></para>
  <para style="s">मोठो याजक को यीसु लक पुसाताछी</para>
  <para style="r">(<ref loc="MAT 26:59-66">मत्ती 26:59-66</ref>; <ref loc="MRK 14:55-64">मरकुस 14:55-64</ref>; <ref loc="LUK 22:66-71">लूका 22:66-71</ref>)</para>
  <para style="p">
    <verse number="19" style="v" sid="JHN 18:19"/>तबा मोठो मुखिया याजक ना यीसु लक ओको चेला को बारे मा अना ओको सिक्सा को बारे पुसयो। <verse eid="JHN 18:19"/><verse number="20" style="v" sid="JHN 18:20"/>यीसु ना जवाब देइस, मिना जगत लक खुलके गोस्टी करिसेऊ, मिना सभाघर अना मंदिर मा जिता सबच यहूदिगीन एकठ्ठो होत होतीन, हमेसा सिक्सा देवत रहयो, अना छिपयो मा काही नही कव्हयो। <verse eid="JHN 18:20"/><verse number="21" style="v" sid="JHN 18:21"/>तुमी मोला कायलाई पुसा सो? आयकन वालो ला पुसो, की मिना उनलक काजक सांगीसेऊ?<verse eid="JHN 18:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 18:22"/>जबा ओना यो कहीस, तो सिपाही मा लक एक ना जो जवर उभो होतो, यीसु ला चाटा मारके कव्हन लग्यो, का तु मोठो मुखिया याजक ला यो रिती लक जवाब देईसेस?<verse eid="JHN 18:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="JHN 18:23"/>यीसु ना जवाब देइस, अदी मिना बुरो कव्हसू, तो वा बुराई की गवाही दे, पर अदी भलो कव्हसू तो मोला कायलाई मारासो?<verse eid="JHN 18:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="JHN 18:24"/>हन्ना ना ओला बँधयो हुयो काइफा मोठो मुखिया याजक को जवर धाड़ दियो।<verse eid="JHN 18:24"/></para>
  <para style="s">पतरस को दुसरो अना तीसरो बार मना करनो</para>
  <para style="r">(<ref loc="MAT 26:71-75">मत्ती 26:71-75</ref>; <ref loc="MRK 14:69-72">मरकुस 14:69-72</ref>; <ref loc="LUK 22:58-62">लूका 22:58-62</ref>)</para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 18:25"/>समौन पतरस उभो होयके स्तो ताप रहयो होतो।</para>
  <para style="p" vid="JHN 18:25">तबा उनना ओला कहीन, कहीं तु भी ओको चेला तो नहात?<verse eid="JHN 18:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="JHN 18:26"/>मोठो मुखिया याजक को दास गीनमा लक एक जोन ओको खानदान लक होतो, जेनको कान पतरस ना कापयो होतिस, ओना कहीस, का मिना तोला ओको सँग बारी मा नही चोवयो?<verse eid="JHN 18:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="JHN 18:27"/>पतरस ना मंग मना कर देइस, अना कुकड़ा ना एकदम लक चिल्लाय देइस।<verse eid="JHN 18:27"/></para>
  <para style="s">राजा पीलातुस को पुढा यीसु</para>
  <para style="r">(<ref loc="MAT 27:1">मत्ती 27:1</ref>,<ref loc="MAT 27:2">2</ref>,<ref loc="MAT 27:11-14">11-14</ref>; <ref loc="MRK 15:1-5">मरकुस 15:1-5</ref>; <ref loc="LUK 23:1-5">लूका 23:1-5</ref>)</para>
  <para style="p">
    <verse number="28" style="v" sid="JHN 18:28"/>पहट को बेरामा वय यीसु ला काइफा को जवर लक किला मा ले गईन पर भीतर नही धसीन, काहेका उनला असुध्द होवन को डर होति। अबा फसह को तिहार को जेवन नही करी होतिन। <verse eid="JHN 18:28"/><verse number="29" style="v" sid="JHN 18:29"/>तबा पीलातुस उनको जवर बाहेर हिट गयो, अना कहीस, तुमी यो मानूस पर कोन गोस्टी लक दोस लगावसो?<verse eid="JHN 18:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="JHN 18:30"/>उनना ओला जवाब देइस, अदी उ कुकरमी नही होतो, तो हमी ओला तोरो हात नही सौपता।<verse eid="JHN 18:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="JHN 18:31"/>पीलातुस ना उनलक कहीस, तुमी येला ले जाके मोसे को नियम लक न्याय करो! यहूदिगीन ओला कहिन, हमी ला यो हक नहात की कोनी ला जान लक मारबोन।<verse eid="JHN 18:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="JHN 18:32"/>यो एको लाई भयो का यीसु की उ गोस्टी पूरी होहे जोन ओना यो ईसारा देतो बेरा कव्हयो होतीस, की ओकी मौत कसी रीत लक होहे।<verse eid="JHN 18:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="JHN 18:33"/>तबा पीलातुस किला मा अँदर धसके अना यीसु ला मंग लक पुसयो की का तु यहूदिगीन को राजा आस?<verse eid="JHN 18:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="JHN 18:34"/>यीसु ना जवाब देइस, “का तु यो गोस्टी आपरो कन लक कव्हसेस का दुसरो मोरो बारे मा तोरो लक कव्हसेत?”<verse eid="JHN 18:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="JHN 18:35"/>पीलातुस ना जवाब देइस, का मि यहूदी आऊ ?तोरोच जात वारा अना मुखिया याजक ना तोला मोरो हात मा सौपीसेत। तुना का करीसेस?<verse eid="JHN 18:35"/></para>
  <para style="p">
    <verse number="36" style="v" sid="JHN 18:36"/>यीसु ना जवाब देइस, मोरो राजपाठ यो जगत को नही से। अदी मोरो राजपाठ यो जगत को होतो, तो मोरो सिपाही इनलक लड़तीन अना मि यहूदिगीन को हात मा नही सौपयो जातो। पर मोरो राज इता को नहाती।<verse eid="JHN 18:36"/></para>
  <para style="p">
    <verse number="37" style="v" sid="JHN 18:37"/>पीलातुस ना ओला कहीस, तो का तु यहुदीगीन को राजा आस?</para>
  <para style="p" vid="JHN 18:37">यीसु ना जवाब देइस, तु कव्होसेस की मि राजा सेउ, मिना एकोलाय जन्म लेइसेउ अना जगत मा आयीसेऊ, की खराई को गवाही देऊ। जो कोनी भी खराई को से, उ मोरो आवाज ला आयकासे।<verse eid="JHN 18:37"/></para>
  <para style="p">
    <verse number="38" style="v" sid="JHN 18:38"/>पीलातुस ना ओला कहीस की खराई काजक से?</para>
  <para style="s" vid="JHN 18:38">मिरतुदन्ड को हुकूम</para>
  <para style="r" vid="JHN 18:38">(<ref loc="MAT 27:15-31">मत्ती 27:15-31</ref>; <ref loc="MRK 15:6-20">मरकुस 15:6-20</ref>; <ref loc="LUK 23:13-25">लूका 23:13-25</ref>)</para>
  <para style="p" vid="JHN 18:38">यो साँगके उ मंग यहूदिगीन को जवर लक हिट गयो, अना उन लक कहीस, मि तो ओमा काही दोस नही पाऊ। <verse eid="JHN 18:38"/><verse number="39" style="v" sid="JHN 18:39"/>पर तुमरो यो रीती लक की मि फसह को तिहार मा तुमरो लाई एक आदमी ला छोड़ देहू, एकोलाय का तुम्हि चाव्हासो की मि तुमरो लाई यहूदिगीन को राजा ला सोड़ देहू?<verse eid="JHN 18:39"/></para>
  <para style="p">
    <verse number="40" style="v" sid="JHN 18:40"/>तबा उनना मँग चिल्लायके कहीन, एला नही पर हमरो लाई बरब्बा ला छोड़ दे! अना बरब्बा डाकु होतो।<verse eid="JHN 18:40"/></para>
  <chapter eid="JHN 18"/>
  <chapter number="19" style="c" sid="JHN 19"/>
  <para style="p">
    <verse number="1" style="v" sid="JHN 19:1"/>येको पर पीलातुस ना यीसु ला कोड़ा लगवाइस। <verse eid="JHN 19:1"/><verse number="2" style="v" sid="JHN 19:2"/>सिपाई ना कांटा झाड़ को मुकुट गुथके ओको डोस्का मा राखिन अना ओला बेजनी कपरा पहनाय देईन। <verse eid="JHN 19:2"/><verse number="3" style="v" sid="JHN 19:3"/>अना ओको जवर आयके कव्हन लगीन, हे यहूदी को राजा नमस्कार<note caller="+" style="f"><char style="fr" closed="false">19:3</char><char style="ft" closed="false">नमस्ते</char></note> अना ओला झापड़ भी मारिन।<verse eid="JHN 19:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="JHN 19:4"/>तबा पीलातुस ना मंग बाहेर हिटके लोक गीनला कहीस, चोवो मि ओला तुमरो जवर मँग बाहेर आनासू, जोनलक तुम्हि जानो का उ निरदोस से। ओमा काही भी दोस नहात। <verse eid="JHN 19:4"/><verse number="5" style="v" sid="JHN 19:5"/>तबा यीसु कांटा को मुकुट अना बैजनी कपरा डाकयो हुयो बाहेर हिटयो। अना पीलातुस ना उनलक कहीस, “चोवो यो मानूस ला।”<verse eid="JHN 19:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="JHN 19:6"/>तबा मुखिया याजक अना सिपाही ना ओला चोवीन। तो चिल्लाके कहिन, का ओला कूरूस मा चघाव!</para>
  <para style="p" vid="JHN 19:6">पीलातुस ना ओला कहीस, तुम्हिच ओला आन के कूरूस पर चघाओ! काहेकि ओमा काही दोस नही पायो सेऊ।<verse eid="JHN 19:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="JHN 19:7"/>यहूदी गीनना ओला जवाब देइन, “हमारो भी मोसे को नियम को लक, उ जरुर मार डाकन को काबील से, काहेकी ओना आपरो आपच परमेस्वर को टूरा बनाईसेस।”<verse eid="JHN 19:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="JHN 19:8"/>जबा पीलातुस ना यो गोस्टी आयकीस तो अखीन भेव समाय गयो अना यीसु लक कहिस, “तु किता को सेस?” पर यीसु ना ओला काही भी जवाब नही देइस।<verse eid="JHN 19:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="JHN 19:9"/>अना मंग किला को भीतर गयो अना यीसु लक कहिस, तु किता को सेस? पर यीसु ना ओला काही भी जवाब नही देइस। <verse eid="JHN 19:9"/><verse number="10" style="v" sid="JHN 19:10"/>एतरो पर पीलातुस ना ओला कहीस, मोरो लक काहे नही कव्हासे? का तु नही जानस की तोला छोड़ देवन को हक मोला से, अना तोला कूरूस मा चघा वन को हक मोला से।<verse eid="JHN 19:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="JHN 19:11"/>यीसु ना जवाब देइस, “अदी तोला वरता लक नही दियो जाहे तो तोरो मोरो पर काही भी हक नही से। एकोलाय जोन मोला तोरो हात धरायो से ओको पाप लगत से।”<verse eid="JHN 19:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 19:12"/>एतरो पर पीलातुस ना ओला सोड़ देनो चाहयो, पर यहूदी गीनना चिल्लाके कहीन, अदी तु एला सोड़ देजोस तो तोरी भक्ति कैसर को संगी नही से। जोन कोनी आपरो आप ला राजा बनावासे। उ कैसर को सामना करासे।<verse eid="JHN 19:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="JHN 19:13"/>यो गोस्टी आयक के पीलातुस यीसु ला बाहेर लायो, अना उ जघा एक चबुतरा होती जो इबरानी मा गब्बता कहलासे अना उता न्याय आसन पर बसयो <verse eid="JHN 19:13"/><verse number="14" style="v" sid="JHN 19:14"/>यो फसह को तिहार की तैय्यारी को दिवस होतो, अना यो बेरा छटवो तास को लगभग की होती। तबा ओना यहूदिगीन लक कहीस, “चोवो तुमरो राजा!”<verse eid="JHN 19:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="JHN 19:15"/>पर वय चिल्लाइन, ले जाव, ले जाव! अना ओला कूरूस मा चघाव,</para>
  <para style="p" vid="JHN 19:15">पीलातुस ना उन लक कहीस, का मि तुमरो राजा ला कूरूस पर चघाऊ!</para>
  <para style="p" vid="JHN 19:15">मुखिया पुजारी ना जवाब देइस, कैसर ला छोड़ हमरो कोनी राजा नहाय! <verse eid="JHN 19:15"/><verse number="16" style="v" sid="JHN 19:16"/>तबा उनना यीसु ला उनको हात सौप देइस, ताकि उ कूरूस मा चघाव जाहे।<verse eid="JHN 19:16"/></para>
  <para style="s">यीसु ला कूरूस मा चघावनो</para>
  <para style="r">(<ref loc="MAT 27:32-44">मत्ती 27:32-44</ref>; <ref loc="MRK 15:21-32">मरकुस 15:21-32</ref>; <ref loc="LUK 23:26-43">लूका 23:26-43</ref>)</para>
  <para style="p">
    <verse number="17" style="v" sid="JHN 19:17"/>तबा वय यीसु ला ले गईन, अना उ आपरो कूरूस उठायके उ जघा तकन बाहेर गयो, जो कवटी को जघा कहलावासे अना इबरानी मा गुलगुता। <verse eid="JHN 19:17"/><verse number="18" style="v" sid="JHN 19:18"/>उता उनना ओला अना ओको सँगा अखीन दोन मानूस ला कूरूस पर चघाईन, एक को इता अना एक ला उता, अना बीच मा यीसु ला। <verse eid="JHN 19:18"/><verse number="19" style="v" sid="JHN 19:19"/>पीलातुस ना एक दोसपतर<note caller="+" style="f"><char style="fr" closed="false">19:19</char><char style="ft" closed="false">कागद की चिठ्ठी</char></note> लिखवाके‍ कूरूस पर लगा देइस, अना ओमा यो लिखयो होतो, यीसु नासरी, यहूदिगीन को राजा। <verse eid="JHN 19:19"/><verse number="20" style="v" sid="JHN 19:20"/>यो दोसपतर लगत सा यहूदिगीन ना वाचिन काहेकि उ जघा जिता यीसु कूरूस मा चघाव गयो होतो। नगरको जवर होतो, अना पतर<note caller="+" style="f"><char style="fr" closed="false">19:20</char><char style="ft" closed="false">चिठ्ठी</char></note> इबरानी मा अना लतीनी अना यूनानी मा लिखयो होतो। <verse eid="JHN 19:20"/><verse number="21" style="v" sid="JHN 19:21"/>तबा यहूदिगीन को मुखिया याजक ना पीलातुस लक कहीस, “यहुदि गिनको को राजा” मत लिखने पर यो की “ओने कहीस मि यहुदी को राजा सेउ।”<verse eid="JHN 19:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 19:22"/>पीलातुस ना जवाब देइस, मि ना जो लिख दियो उ लिख दियो।<verse eid="JHN 19:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="JHN 19:23"/>जबा सैनिक यीसु ला कूरूस मा चघा देईन तो ओको कपरा आन के चार करीन, हर सिपाही को लाई एक पराय अना कुरता भी लेईन, पर कुरता बिन सिवन को वरता लक खाल्या तकन बुनयो हुवो होतो। <verse eid="JHN 19:23"/><verse number="24" style="v" sid="JHN 19:24"/>एकोलाय उनना आपसी मा कहिन,</para>
  <para style="q1" vid="JHN 19:24">हमि एला नही फाड़बोन पर एको पर चिठ्ठी डाकबिन की यो कोन की होहे।</para>
  <para style="q2" vid="JHN 19:24">यो एकोलाय की पवितर गिरंथ मा जोन कव्हयो गयो उ पूरो भये।</para>
  <para style="p" vid="JHN 19:24">उनना मोरो कपरा आपस मा बाँट लेइन अना मोरो पल्लु<note caller="+" style="f"><char style="fr" closed="false">19:24</char><char style="ft" closed="false">पल्लु </char></note> पर चिठ्ठी डाकिन।<verse eid="JHN 19:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 19:25"/>अता सिपाही ना असो ही करीन यीसु को कूरूस जवर ओकी माय, अना ओकी माया की बहिन, कलोपास की बायको<note caller="+" style="f"><char style="fr" closed="false">19:25</char><char style="ft" closed="false">घरवाली</char></note> मरियम, अना मरियम मगदलीनी उभी होती। <verse eid="JHN 19:25"/><verse number="26" style="v" sid="JHN 19:26"/>जबा यीसु ना आपरी माय अना ओनो चेला ला जेनला उ माया राखत होतो। जवर उभो देखिस ता आपरी माय लक कहीस हे बाया<note caller="+" style="f"><char style="fr" closed="false">19:26 </char><char style="ft" closed="false">बायका</char></note> देख यो तोरो टूरा से।<verse eid="JHN 19:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="JHN 19:27"/>तबा ओना चेला लक कहीस, यो तोरो माय से। अना वोच बेरा लक उ चेला ओला आपरो घर ले गईन।<verse eid="JHN 19:27"/></para>
  <para style="s">यीसु को मिरतु</para>
  <para style="r">(<ref loc="MAT 27:45-56">मत्ती 27:45-56</ref>; <ref loc="MRK 15:33-41">मरकुस 15:33-41</ref>; <ref loc="LUK 23:44-49">लूका 23:44-49</ref>)</para>
  <para style="p">
    <verse number="28" style="v" sid="JHN 19:28"/>एको मँघा यीसु ना यो जानके की अता सब काही पूरो भयो, पवितर गिरंथ मा जोन कहो गयो उ पूरो भयो, तब कह्यो “मि तहान सेउ।”<verse eid="JHN 19:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="JHN 19:29"/>उता अंगूर रस भरो हुयो एक बरतन राखियो होतो, अता उनना अंगूर को रस माफिलायो हुयो स्पंज ला जुफा मा राखके ओको तोन्ड लक लगाइन। <verse eid="JHN 19:29"/><verse number="30" style="v" sid="JHN 19:30"/>यीसु ना उ पित मिलयो अंगूर को रस टोंड मा लेइस अना कहीस “पूरो भयो।”</para>
  <para style="p" vid="JHN 19:30">अना डोस्का डाखके परान छोड़ देइस।<verse eid="JHN 19:30"/></para>
  <para style="s">भाला लक यीसु ला छेदनो</para>
  <para style="p">
    <verse number="31" style="v" sid="JHN 19:31"/>यो बिसराम-दिवस लक पहेले तैय्यारी को दिवस होतो। यहूदी गीनना पीलातुस लक बिनती करीन का उनको टगंड़ी तोड़ दियो जाय अना उनको देह उतारो जाय, जोनलक पवीतर दिवस मा वय कूरूस पर नोको रहेत। काहेकि उ सब्त का मोठो दिवस होतो। <verse eid="JHN 19:31"/><verse number="32" style="v" sid="JHN 19:32"/>एकोलाय सैनिक ना आयके कूरूस मा टगयो, पहेलो अना दूसरो, मानूस को टेगड़ी टोड़िन, जोन यीसु को संग कूरूस मा चघायो गयो होतीन। <verse eid="JHN 19:32"/><verse number="33" style="v" sid="JHN 19:33"/>पर जबा यीसु को जवर आयके चोविन की उ मर चुकयो तो ओकी टाँग नही तोड़ीन। <verse eid="JHN 19:33"/><verse number="34" style="v" sid="JHN 19:34"/>पर सिपाही मा लक एक ना बरछी लक ओको पसरी मा मारयो, अना ओमा लक तुरंत रकत अना पानी हिटियो। <verse eid="JHN 19:34"/><verse number="35" style="v" sid="JHN 19:35"/>जेना यो देखीस ओने गवाही देइस, अना ओकी गवाही देईसेस अना ओको गवाही खरो से उ खूदच जानासे का खरो कव्हसे जेनको लक तुमी भी भरोसा राखो। <verse eid="JHN 19:35"/><verse number="36" style="v" sid="JHN 19:36"/>यो गोस्टी एको लाई भई का पवितर गिरंथ मा कव्हयो गयो होतो, उ पुरो भयो। “ओकी एक भी हाड़ नही तोड पाहे।” <verse eid="JHN 19:36"/><verse number="37" style="v" sid="JHN 19:37"/>मँग एक जघा पवितर गिरंथ पर यो लिखो से “जोनना वोला छेदयो, वाच वोको कन चोवयो।”<verse eid="JHN 19:37"/></para>
  <para style="s">यीसु को गाड़ो जानो</para>
  <para style="r">(<ref loc="MAT 27:57-61">मत्ती 27:57-61</ref>; <ref loc="MRK 15:42-47">मरकुस 15:42-47</ref>; <ref loc="LUK 23:50-56">लूका 23:50-56</ref>)</para>
  <para style="p">
    <verse number="38" style="v" sid="JHN 19:38"/>यो गोस्टि को बाद अरिमितिया को यूसुफ ना जोन यीसु को चेला होतो, पर यहूदी गीनको भेव लक यो गोस्टी ला लुकाय राखत होतो। युसुफ ना पीलातुस ला साँगीस, का “तु यीसु को लास ला मोला देव।”</para>
  <para style="p" vid="JHN 19:38">तबा पीलातुस ना कव्हयो का ले जाय। <verse eid="JHN 19:38"/><verse number="39" style="v" sid="JHN 19:39"/>नीकुदेमुस जोन पुढा रात ला यीसु को कठा गयो होतो, वोच पचास सेर लुभान अना गवारपाठा ले गयो। <verse eid="JHN 19:39"/><verse number="40" style="v" sid="JHN 19:40"/>तबा उन्ना यीसु को लास ले गईन, अना यहूदिगीन को गाड़ो जानो को रिवाज लक ओला सुगंधित सामान को सँगा कपरा मा लपटिन। <verse eid="JHN 19:40"/><verse number="41" style="v" sid="JHN 19:41"/>ओनो जघामा जिता यीसु कूरूस मा चघाव गयो होतो, एक बारी होती अना उ बारी मा एक नवतो मरघट्टी होती जेमा कोनी ना राखियो गयो होतो। <verse eid="JHN 19:41"/><verse number="42" style="v" sid="JHN 19:42"/>एकोलाय यहूदिगीन की तैय्यारी को दिवस सूकीरवार को कारन उनना यीसु ला वोचमा राख्यो, काहेकि वा मरघट्टी जवर होती।<verse eid="JHN 19:42"/></para>
  <chapter eid="JHN 19"/>
  <chapter number="20" style="c" sid="JHN 20"/>
  <para style="s">यीसु को जिन्दो होवनो</para>
  <para style="r">(<ref loc="MAT 28:1-8">मत्ती 28:1-8</ref>; <ref loc="MRK 16:1-8">मरकुस 16:1-8</ref>; <ref loc="LUK 24:1-12">लूका 24:1-12</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 20:1"/>हफ्ता को पहिले दिवस मरियम मगदलीनी पहेटिया मा मरघटी मा आइन, अना गोटा ला मरघट्टी लक हटयो हुयो चोवीन। <verse eid="JHN 20:1"/><verse number="2" style="v" sid="JHN 20:2"/>तबा वय धाव के समौन पतरस अना उ दुसरो चेला को जवर जेनको लक यीसु माया राखत होतो आयके कहिन, वय पिरभू ला मरघट्टी मा लक हेड़के ले गईन, अना अमीला पता नहात, वोला किता राख दियो!<verse eid="JHN 20:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="JHN 20:3"/>तबा पतरस अना उ दुजो चेला हिटके मरघट्टी को कन चली गईन। <verse eid="JHN 20:3"/><verse number="4" style="v" sid="JHN 20:4"/>वय दोंनो सँग-सँग धाव रह्यो होतिन, पर दुसरो चेला पतरस लक पुड़ढा मरघट्टी<note caller="+" style="f"><char style="fr" closed="false">20:4 </char><char style="ft" closed="false">मसान घाट</char></note> मा पहुचयो। <verse eid="JHN 20:4"/><verse number="5" style="v" sid="JHN 20:5"/>अना उ वोनो होयके कपरा पड़ो चोवयो, ता भी उ भीतर नही गयो। <verse eid="JHN 20:5"/><verse number="6" style="v" sid="JHN 20:6"/>तबा समौन पतरस ओको मंघा-मंघा पहुचियो, अना मरघट्टी <note caller="+" style="f"><char style="fr" closed="false">20:6 </char><char style="ft" closed="false">कब्रस्थान </char></note> को भीतर गयो, अना कपरा पड़ा चोविस <verse eid="JHN 20:6"/><verse number="7" style="v" sid="JHN 20:7"/>अना उ गमछा जोन ओको डोस्का<note caller="+" style="f"><char style="fr" closed="false">20:7 </char><char style="ft" closed="false">कवटी</char></note> लक बँधो होतो, अलग एक जघा गुन्ड के राखियो होतो। <verse eid="JHN 20:7"/><verse number="8" style="v" sid="JHN 20:8"/>तबा दुसरो चेला भी जोन मरघट्टी पर पुढा पहुचियो होतो, भीतर गयो अना चोयके भरोसा करीन। <verse eid="JHN 20:8"/><verse number="9" style="v" sid="JHN 20:9"/>वय तो अबा तकन पवितर गिरंथ की उ गोस्टीच ला नही समजयो होतीन, की ओको मरो मा लक जिँदो होवनो से। <verse eid="JHN 20:9"/><verse number="10" style="v" sid="JHN 20:10"/>तबा यो चेला आपरो घर लवट गईन।<verse eid="JHN 20:10"/></para>
  <para style="s">मरियम मगदलीनी ला दिसनो</para>
  <para style="r">(<ref loc="MAT 28:9-10">मत्ती 28:9-10</ref>; <ref loc="MRK 16:9-11">मरकुस 16:9-11</ref>)</para>
  <para style="p">
    <verse number="11" style="v" sid="JHN 20:11"/>पर मरियम रोवती हुई मरघट्टी को जवर च बाहेर उभी रही, अना रोवती-रोवती मरघट्टी को कन नवके, <verse eid="JHN 20:11"/><verse number="12" style="v" sid="JHN 20:12"/>दुई सरगदूत ला पाढरो कपरा घालयो हुयो एक ला मुंडेसा अना दुसरो ला पैताना मा बस्यो चोयी, जिता यीसु को लास राखी होतीन। <verse eid="JHN 20:12"/><verse number="13" style="v" sid="JHN 20:13"/>उनना ओकोलक कहीन अवो बायका तु काय ला रोवासेस?</para>
  <para style="p" vid="JHN 20:13">ओना उनलक कहीस, वय मोरो पिरभू ला उचलके ले गईन, अना मोला मालूम नहात की ओला किता राखीसेत?<verse eid="JHN 20:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="JHN 20:14"/>यो कही अना वा यीसु ला उभो चोयी, पर वा नही वोरख सकी का उ यीसु आय। <verse eid="JHN 20:14"/><verse number="15" style="v" sid="JHN 20:15"/>यीसु ना ओला कहीस, अवो बाई तु काय लाय रोवासेस कोन ला ढुढासे?</para>
  <para style="p" vid="JHN 20:15">ओना माली समजके ओला कहीस, हे पिरभू अदी तु ना ओला उचल लेइसेस। तो मोला सांग ओला किता राखीसेस अना मि ओला ले जा? <verse eid="JHN 20:15"/><verse number="16" style="v" sid="JHN 20:16"/>यीसु ना ओला कहीस, मरियम! ओना मंघा मुरकके ओला इबरानी मा कहिस “हे गुरु”<verse eid="JHN 20:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="JHN 20:17"/>यीसु ना कहीस, मोला नोको छुवस। काहेकि मि अबा तकन बाबूजी को जवर वरता नही गयो, पर मोरो भाऊ को जवर जावके उन लक सांग दे, की मि आपरो बाबूजी अना तुमरो बाबूजी अना आपरो परमेस्वर अना तुम्हरो परमेस्वर को जवर वरता जावासु।<verse eid="JHN 20:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="JHN 20:18"/>मरियम मगदलीनी ना जायके चेलागीन चेला गीनला साँगिस, मिना पिरभू ला चोवीसेऊ, अना ओना मोला यो गोस्टी कहीस।<verse eid="JHN 20:18"/></para>
  <para style="s">चेलागीन ला चोवनो</para>
  <para style="r">(<ref loc="MAT 28:16-20">मत्ती 28:16-20</ref>; <ref loc="MRK 16:14-18">मरकुस 16:14-18</ref>; <ref loc="LUK 24:36-49">लूका 24:36-49</ref>)</para>
  <para style="p">
    <verse number="19" style="v" sid="JHN 20:19"/>ओनो दिवस जोन हप्ता को पहेलो दिवस होतो, झुलाखाली को बेरा जबा उता को बेसकुड़ जिता चेला होतीन, यहूदिगीन को भेव को मारे बंद होतो। तबा यीसु आयो अना उनको बीच मा उभो होयके उनलक कहीस, “तुमला सान्ती मिलहे।” <verse eid="JHN 20:19"/><verse number="20" style="v" sid="JHN 20:20"/>अना यो सांग के ओना आपरो हात अना आपरो पंजर उनला चोवायो तबा चेलागीन पिरभू ला चोवके खुसी लक भय गईन। <verse eid="JHN 20:20"/><verse number="21" style="v" sid="JHN 20:21"/>यीसु ना मँग उनलक कहीस, “तुमला सान्ती मिलहे। जसो बाबूजी ना मोला धाड़ीसेस, वसो ही मि भी तुमला धाड़िसेउ।” <verse eid="JHN 20:21"/><verse number="22" style="v" sid="JHN 20:22"/>यो साँगके ओना उन पर फुकिस। अना उन लक कहीस, “पवीतर आतमा लेव। <verse eid="JHN 20:22"/><verse number="23" style="v" sid="JHN 20:23"/>जिनको पाप तुमी छिमा करो वो उनको लाई छिमा कियो जाहे। जिनला तुमी राखसेव वय राखो गईसेत।”<verse eid="JHN 20:23"/></para>
  <para style="s">थोमा ला चोवनो</para>
  <para style="p">
    <verse number="24" style="v" sid="JHN 20:24"/>पर बारा मा लक एक मजे थोमा जोन दिदमुस कहलावासे। जबा यीसु आयो ता उनको सँग नही होतो। <verse eid="JHN 20:24"/><verse number="25" style="v" sid="JHN 20:25"/>जबा चेलागीन ओको लक कव्हन लागीन, हमी ना पिरभू ला चोवीसेजन, तबा ओना उन लक कहीस,</para>
  <para style="p" vid="JHN 20:25">जबा तकन मि ओको हात मा खिल्ला का छेद न चोय लुँ, अना खिल्लो को छेद मा आपरी वोट ना डाक लुँ, अना ओको छेद मा आपरो हात न डाख लु, तबा तकन मि भरोसा नही करुँ।<verse eid="JHN 20:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="JHN 20:26"/>आठ दिवस को मंघा ओको चेलागिन मंग घर को भीतर आइन, अना थोमा उनको सँग होतो। अना किवाड़ बँद होतीन। तबा यीसु आयो अना उनको बीच मा उभो होयके कहीस, तुमला सान्ती मिलहे। <verse eid="JHN 20:26"/><verse number="27" style="v" sid="JHN 20:27"/>तबा ओना थोमा लक कहीस, आपरी बोट इता आनके मोरो हात ला चोय। अना आपरो हात आनके मोरो छेद मा डाक। अना अबिस्वासी नोको पर बिस्वास करन वालो बन।<verse eid="JHN 20:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="JHN 20:28"/>यो आयक के थोमा ना जवाब देइस। हे मोरो, पिरभू हे मोरो परमेस्वर।<verse eid="JHN 20:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="JHN 20:29"/>यीसु ना ओला कहीस, “तु ना मोला चोवीसेस एको लाई भरोसा करसेस, धन्य सेत वय जेने मोला बिन चोय भरोसा करासेत।”<verse eid="JHN 20:29"/></para>
  <para style="s">यो पुस्तक को मकसद</para>
  <para style="p">
    <verse number="30" style="v" sid="JHN 20:30"/>यीसु ना अखीन लगत सा निसान चेला को पुढा चोवाईस। जोन यो किताब मा लिखयो नही गई सेत। <verse eid="JHN 20:30"/><verse number="31" style="v" sid="JHN 20:31"/>पर एको कारन लक लिखी गई से की तुमी लोकगीन भरोसा करो, की यीसु जोन से उ परमेस्वर को धाड़ो गयो से। अना कव्हनो मा मसीह से। अना ओको नाव मा भरोसा करनो लक जीवन मिलासे।<verse eid="JHN 20:31"/></para>
  <chapter eid="JHN 20"/>
  <chapter number="21" style="c" sid="JHN 21"/>
  <para style="s">तिबिरियास झील को किनार मा चेला गीनला चोवनो</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 21:1"/>येको मंघा यीसु ना तिबिरियास झील को किनार मा मगं चेला गीनको जवर आपरो आप ला दिसायो। यो असो भयो, <verse eid="JHN 21:1"/><verse number="2" style="v" sid="JHN 21:2"/>समौन पतरस अना थोमा जोनला दिदमुस भी कहव्सेत। अना गलील को काना नगर को नतनएल अना जबदी को टूरा अना ओको चेला मा दोन दिगर जन इकठ्ठा भईन। <verse eid="JHN 21:2"/><verse number="3" style="v" sid="JHN 21:3"/>समौन पतरस ना उनको लक कहीस, “मि मसरी पकड़न लाई जावासू।” वय ओला कहिन “हमि भी तोरो सँग चला सेजन।”</para>
  <para style="p" vid="JHN 21:3">वय चले गइन, नाव मा चघके मसरि पकड़न लगीन, पर उ रात उनला काही नही भेटियो। <verse eid="JHN 21:3"/><verse number="4" style="v" sid="JHN 21:4"/>पहट को बेरा यीसु किनारे पर उभो होतो, पर चेला गीन नही चिन्हो का यो यीसु से। <verse eid="JHN 21:4"/><verse number="5" style="v" sid="JHN 21:5"/>तबा यीसु ना उन लक कहीस, ओ भाऊ तुमरो कठा कितरो मसरी सेत?</para>
  <para style="p" vid="JHN 21:5">तबा वय जवाब देईन, काही नाहती।<verse eid="JHN 21:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="JHN 21:6"/>ओना उन लक कहीस, नाव की उज्जो कना जाल डाकहो तबा तो तुम पाहो। एकोलाई: उनना जाल डाकिन, अना लगत सारी मसरी जेनला उनला झिकत नही बनयो।<verse eid="JHN 21:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="JHN 21:7"/>तबा ओनो चेला ना जेनला यीसु माया राखत होतो। ओना पतरस ला कहीस, यो तो पिरभू से। समौन पतरस ना यो आयकिस, तो ओना कमर मा गमछा डाकके अना झील मा कूद गयो। <verse eid="JHN 21:7"/><verse number="8" style="v" sid="JHN 21:8"/>पर दुसरो चेला नहानी डोंगी मा मसरी लक भरो जाल खिचत-खिचत आइन। वहान लक सिरफ 100 मिटर दुहुर लक धरती को किनार होतो। <verse eid="JHN 21:8"/><verse number="9" style="v" sid="JHN 21:9"/>वय धरती मा उतरीन होतीन अना कोयले को स्‍तो अना ओको पर मसरी राखी गई होती अना भाकर चोवीन। <verse eid="JHN 21:9"/><verse number="10" style="v" sid="JHN 21:10"/>यीसु ना उन लक कहीस “तुमीना जोन मसरी अबा धरियासेव, ओमा लक काही आनो।”<verse eid="JHN 21:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="JHN 21:11"/>समौन पतरस ना डोंगी मा चघके एक सौ तिरेपन मोठो मसरी लक भरो हुवो जाल धरती मा झिकिस। अना एतरी मसरी होवनो पर भि जाल नही फटयो। <verse eid="JHN 21:11"/><verse number="12" style="v" sid="JHN 21:12"/>यीसु ना उनलक साँगीस, आव, आमी जेवन करबीन। चेला गीन मा कोनी ला एतरो हिम्मत नई भयो की ओला पुसेत, की तु कोन आस? काहे की वय जानत होतीन की यो पिरभू च से। <verse eid="JHN 21:12"/><verse number="13" style="v" sid="JHN 21:13"/>यीसु आयो अना भाकर आन कन उनला देइस, अना वसोच मसरी भी। <verse eid="JHN 21:13"/><verse number="14" style="v" sid="JHN 21:14"/>यो तिसरो गन से की यीसु मरो मा लक जित्तो होवनो को मंघा चेला गीन ला चोयो।<verse eid="JHN 21:14"/></para>
  <para style="s">यीसु अना पतरस</para>
  <para style="p">
    <verse number="15" style="v" sid="JHN 21:15"/>जेवन करनो को मंघा यीसु समोन पतरस लक कहीस, की हे समौन, योहन को टूरा, का तु मोला माया राखसेस का?</para>
  <para style="p" vid="JHN 21:15">ओना कहीस, “हव, पिरभू, मि तोरो लक माया राखुसु तु तो जानसेस।”</para>
  <para style="p" vid="JHN 21:15">ओने ओला कहीस, “मोरो मेंढ़ा गीन ला चराव।” <verse eid="JHN 21:15"/><verse number="16" style="v" sid="JHN 21:16"/>ओना मंग दुसरो गन ओला कहीस,</para>
  <para style="p" vid="JHN 21:16">हे समौन योहन को टूरा का तू मोरो लक माया करासेत,</para>
  <para style="p" vid="JHN 21:16">तबा समौन यीसु लक कहीस, हव पिरभू तु जानासेस की मि तोरो लक माया राखसू ओने मंग कहीस, मोरो मेढा ला चराव। <verse eid="JHN 21:16"/><verse number="17" style="v" sid="JHN 21:17"/>ओने मंग तीसरो डाई ओला कहीस, हे समौन योहन को टूरा, का तु मोरो लक माया राखसेस।</para>
  <para style="p" vid="JHN 21:17">मंग पतरस उदास भय गयो की ओने तीसरो गन असो कह देइस। का तु मोला माया राखसेस? अना एतरो पर ओने कह देइस, का हे पिरभू तु तो सब काही जानासेस की मि तोरो लक माया राखसु का नही।</para>
  <para style="p" vid="JHN 21:17">यीसु ना मंग कहीस मोरी मेढा ला चराव। <verse eid="JHN 21:17"/><verse number="18" style="v" sid="JHN 21:18"/>मि तोरो लक खरो मा कव्हुसु की जबा तु जवान होतोस तो आपरो कमर बाँधके जिता चाहत होतो जात होतोस, पर जब तु सयानो होजोस तो आपरो हात पसार जोस, अना दुसरो तोरी कमर बाँधके जिता तु नही चाहवजोस उता तोला ले जाहेत। <verse eid="JHN 21:18"/><verse number="19" style="v" sid="JHN 21:19"/>ओना ऐना गोस्टी लक ईसारा देईस की पतरस कसो मौत लक परमेस्वर की बड़ाई करेत। अना तबा ओना ओला कहीस, मोरो मँघा भयजाहे।<verse eid="JHN 21:19"/></para>
  <para style="s">यीसु अना ओको माया को चेला</para>
  <para style="p">
    <verse number="20" style="v" sid="JHN 21:20"/>पतरस ना मुरकके उ चेला ला मंघा आवता चोवीस, जेनको लक यीसु माया राखत होतो अना जेना जेवन को बेरा ओको छाती कन नवके पुछिस होतीस, हे पिरभू तोरो धरान वालो कोन से? <verse eid="JHN 21:20"/><verse number="21" style="v" sid="JHN 21:21"/>ओला चोवके पतरस ना यीसु लक कहीस हे पिरभू एको काजक हाल होहे?<verse eid="JHN 21:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 21:22"/>यीसु ना ओला कहीस अदी मि चाहु की उ मोरो आनो तकन रुकयो रह। ता मोला एकोलक काजक, तु मोरो मंघा भय जाय।<verse eid="JHN 21:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="JHN 21:23"/>एको लाई भाऊ गीन मा यो गोस्टी फैल गई की उ चेला नही मरेह, ता भी यीसु ना ओला नही कहीस की उ नही मरेह, पर यो की “अदी मि चाहुँ की उ मोरो आनो तकन रुकयो रह, तो तोला एको लक काजक?”<verse eid="JHN 21:23"/></para>
  <para style="s">निचोड</para>
  <para style="p">
    <verse number="24" style="v" sid="JHN 21:24"/>यो वाच चेला से, जोन ऐना गोस्टी की गवाही देवासे। अना जेना ऐना गोस्टी ला लिखि से अना हमी जानसेजन की ओकी गवाही खरो से।<verse eid="JHN 21:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 21:25"/>अखीन भी लगत सा काम सेत, जोन यीसु ना करीसेस। अदी वय एक-एक करके बयान करी जातीन ता मि समझुसु की जोन किताब लिखी जातीन, वय जगत मा नही समातीन।<verse eid="JHN 21:25"/></para>
  <chapter eid="JHN 21"/>
</usx>
