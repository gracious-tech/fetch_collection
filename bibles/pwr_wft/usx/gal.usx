<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="GAL" style="id">- Powari Standard Project</book>
  <para style="h">गलातियो</para>
  <para style="toc3">गलातियो</para>
  <para style="toc2">गलातियो</para>
  <para style="toc1">गलातियो को नाव पौलुस की चिठ्ठी</para>
  <para style="mt2">गलातियो के नाम पौलुस का पत्र</para>
  <para style="mt1">गलातियो को नाव पौलुस की चिठ्ठी</para>
  <para style="imt">परिचय</para>
  <para style="ip">गलातियो को यो किताब ला पेरीत पौलुस ना लिख्यो सेत। <char style="xt"><ref loc="GAL 1:1">1:1</ref> </char> यो एक चिठ्ठी होतो, जोन ला पौलुस, ना गलातियो को कलीसिया गिनला, मसीह को जलम लेवन को मघानी 48-57 साल को बीच को बेरा मा लिख्यो होतो। असो लगासेत का गलातिया साइद रोमन पिरान्त गलातिया मा रव्हनवालो लोक हुन लाय होतो। विदवान गिनला अखीन मालूम नहाय का, जबा पौलुस ना यो चिठ्ठी लिख्यो होतो तबा कहाँन रव्हत होतो। परा इफिसुस अना कुरुन्थी दुई मा लक कोनी एक जघा को सहेर को असो सेत।</para>
  <para style="ip">पौलुस ना गलातिया को यहूदी अना गैरयहुदी दुई परकार को ईसाई गिनको काजी लिख्यो सेत। वोना बिसेस करके एक खोटो सिक्सा को सामना करन काजी लिख्यो गयो होतो, जोनमा असो सांगयो गयो होतो, का सबा ईसाई हुनला यहूदी धरम मानके खतना करवानो जरुरी सेत। काहेका ईसाई गिनको बीचमा जूनो यहूदी लोक गीन होतिन जोन गैर यहुदीगीन को खतना को लाय दबाव बनावत होतिन। उनना पौलुस को पेरीत होवनो मा भी सवाल करीन, पौलुस ना आपरो काही किस्सा सांग के आपरो पेरीत होवन को दावा ला सिद्द करयो। <char style="xt"><ref loc="GAL 1:11-2:14">1:11—2:14</ref> </char> अना वोना यो समजा के साजरो बारता को बचाव करीस का सूटकारा सिरप यीसु मसीह मा बिस्वास करके च भेट सकासेत। <char style="xt"><ref loc="GAL 2:16">2:16</ref></char> यो वोना दयालूपन को फर सेत जोन परमेस्वर चोवायो सेत यो कोनी लोक को करम को कारन नाहती।</para>
  <para style="iot">रुपरेखा</para>
  <para style="io1">1 पौलुस आपरो चिठ्ठी को सुरुवात गलातियो को कलीसिया ला नमस्कार लक करयो सेत। <char style="ior"><ref loc="GAL 1:1-5">1:1-5</ref></char></para>
  <para style="io1">2 तब पौलुस ना खुद को बारेमा सांगयो का पयले खुद कसो यहुदी नियम को अनुसार चलत होतो। अना आपरो रक्सा को लाय वोमा चलन को कोसीस करयो पर वोको कोनी फायदा नही भेटयो। <char style="ior"><ref loc="GAL 1:6-2:21">1:6—2:21</ref></char></para>
  <para style="io1">3 एको मघा उ सूटकारा को नियम को बारे मा लिखा सेत। 3 अना 4 पद</para>
  <para style="io1">मंग उ साजरो मसीही जिंदगी जीवन को लाय काही सदारन निरदेस देवासेत। आजादी अना जिम्मेदारी <char style="ior"><ref loc="GAL 5:6-10">5:6-10</ref> </char></para>
  <para style="io1">5. पौलुस ना आपरो चिठ्ठी ला एक अखट्ट अभिवादन अना बिनती को संग यो हेत करन को समज देके पूरो करासेत का परमेस्वर लक एक नयो मानूस मा बदलाव होवनो बहारी नेम धरम लक जादा जरुरी सेत। जसो का खतना कियो जावनो <char style="ior"><ref loc="GAL 6:11-18">6:11-18</ref></char></para>
  <chapter number="1" style="c" sid="GAL 1" />
  <para style="s">अभिवादन</para>
  <para style="p">
    <verse number="1" style="v" sid="GAL 1:1" />यो चिठ्ठी मि पौलुस को कन लक लिख्यो गयी से। जोन ला खुदच यीसु मसीह अना परमेस्वर बाबूजी ना मोला पेरीत<note caller="+" style="f"><char style="fr" closed="false">1:1</char><char style="ft" closed="false">पेरीत</char></note> ठहराईसेस। जेने ओला मरयो हुवो मा लक मंग लक जित्तो करीसेस जोन ना तो मानूस को कन लक अना ना कोनी मानूस कन लक पेरीत ठहरायो गयो सेव। <verse eid="GAL 1:1" /><verse number="2" style="v" sid="GAL 1:2" />मि अना जेतरा भाऊ-बहिन मोरो संग सेति, गलातिया छेतर की कलीसिया ला हात जोड़ासेजन।<verse eid="GAL 1:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="GAL 1:3" />आमरो बाबूजी परमेस्वर अना पिरभु यीसु मसीह तुमी लोकगीन ला दया अना सान्ती देहे।<verse eid="GAL 1:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="GAL 1:4" />मसीह ना आमरो पापगीन को साठी आपरो ला बलिदान करदेइस। जेनको लक की उ आमरो बाबूजी परमेस्वर की मरजी को लक एना बेरा को पापी जुग लक आमरो सूटकारा करेत। <verse eid="GAL 1:4" /><verse number="5" style="v" sid="GAL 1:5" />ओकी महिमा जुग-जुग तकन बनी रव्हे। आमेन।<verse eid="GAL 1:5" /></para>
  <para style="s">एकच साजरो बारता से</para>
  <para style="p">
    <verse number="6" style="v" sid="GAL 1:6" />मोला अचंभा होवासे की जेना तुमी लोकगीन ला मसीह को दया<note caller="+" style="f"><char style="fr" closed="false">1:6 </char><char style="ft" closed="false">मसीह का अनुग्रह</char></note> कन लक हाकलीस। ओला तुमी एतरो लहाकी लक सोड़ के कोनी दुजो साजरो बारता का मंघा होय गयत। <verse eid="GAL 1:6" /><verse number="7" style="v" sid="GAL 1:7" />वाकई मा, “दुजो कोनी साजरो बारता” नहाती, पर काही लोक तुममा सांती भँग करसेति। अना मसीह को साजरो बारता ला अकारत करनो चाव्हसेत। <verse eid="GAL 1:7" /><verse number="8" style="v" sid="GAL 1:8" />पर जोन साजरो बारता मीना तुमला आयकवाईसु, अदी कोनी खुदच हमि या कोनी सरग को दूत कायलाई नही होहे, ओनो बेगरो साजरो बारता तुमला आयकावाहे ता उ सापित होहे। <verse eid="GAL 1:8" /><verse number="9" style="v" sid="GAL 1:9" />जोन काही मि कवह चुकीसेव, वाच मंग कवहसु जोन साजरो बारता तुमला मिलयो से अदी कोनी दुजो अलग साजरो बारता तुमला आयकावासे। ता उ सापित से।<verse eid="GAL 1:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="GAL 1:10" />अता मि कोन को दया चाव्हसेउ? मानूस को या परमेस्वर को? अदी मि मानूसगिन ला राजी करन चाव्हतो तो, तो मि मसीह को दास बनन काबिल नही होतो।<verse eid="GAL 1:10" /></para>
  <para style="s">पेरीत पौलुस कन लक सांगो गयो साजरो बारता मानूस रचयो नही से।</para>
  <para style="p">
    <verse number="11" style="v" sid="GAL 1:11" />अगो भाऊ अना बहिनगीन। मि तुमी लोकगीन ला दिलासु। की मीना जो साजरो बारता आयकाईसेउ। उ मानूस लिखयो नही से। <verse eid="GAL 1:11" /><verse number="12" style="v" sid="GAL 1:12" />मीना कोनी मानूस को मदद लक ओला नही अपनायो अना नही सिकयो , पर ओला खुदच यीसु मसीह ना मोरो पर दिसाईसेस।<verse eid="GAL 1:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="GAL 1:13" />का तुमी लोकगीन आयकासेव, की जबा मि यहुदी धरम नियम मा चलनवारो होतो ता मोरो सुभाव कसो होतो? मि परमेस्वर की कलीसिया ला लगत तँगात<note caller="+" style="f"><char style="fr" closed="false">1:13 </char><char style="ft" closed="false">सताता</char></note> होतो। अना ओला नास<note caller="+" style="f"><char style="fr" closed="false">1:13 </char><char style="ft" closed="false">मारता</char></note> करत होतो। <verse eid="GAL 1:13" /><verse number="14" style="v" sid="GAL 1:14" />जसो मोरो आजा पुरखा नियम धरम खुसी<note caller="+" style="f"><char style="fr" closed="false">1:14 </char><char style="ft" closed="false">जागरुक तरह से </char></note> लक मनावत होतीन, वसोच मि भी मनावत होतो। अना यहुदी धरम नियम पालनो मा मोरो संगी साथी यहुदी गीन लक सब मा बढ़के होतो।<verse eid="GAL 1:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="GAL 1:15" />पर परमेस्वर ना मोला माय को गरभ लक बेगरोच कर लेई होतीस अना मोरो पर दया करके ना मोला हाकलीस। <verse eid="GAL 1:15" /><verse number="16" style="v" sid="GAL 1:16" />परमेस्वर ना मोला आपरो टूरा ला दिसाईस अना मोला अलग कर देइस का मि यीसु को साजरो बारता ला परजात ला सांगु। एको मंघा मीना कोनी निरो मानूस <note caller="+" style="f"><char style="fr" closed="false">1:16 </char><char style="ft" closed="false">माँस अना रकत के बगैर </char></note> खून को रिस्तेदार लक नही पुसयो। <verse eid="GAL 1:16" /><verse number="17" style="v" sid="GAL 1:17" />अना मी यरुसलेम को पेरीत गीन ला भी नही पुसयो। पर मि एकदम लक अरब देस ला चली गयो, अना मि दमिसक नगर वापिस आय गयो। <verse eid="GAL 1:17" /><verse number="18" style="v" sid="GAL 1:18" />पर तीन बरस मंघा, पतरस लक खबर लेवन साठी यरुसलेम नगर गयो। अना उनको संगा एक पँदरवाड़ी<note caller="+" style="f"><char style="fr" closed="false">1:18 </char><char style="ft" closed="false">पँद्रह दिवस तकन </char></note> रहयो। <verse eid="GAL 1:18" /><verse number="19" style="v" sid="GAL 1:19" />पर मोरी भेंट<note caller="+" style="f"><char style="fr" closed="false">1:19</char><char style="ft" closed="false">मूलाकात</char></note> वहान कोनी लक नही भई, केवल पिरभु को भाऊ पेरीत याकूब लक भई। अखीन वहान कोनी लक नही भई।<verse eid="GAL 1:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="GAL 1:20" />परमेस्वर जानासे की जोन गोस्टी मी तुमला लिखीसेव, ओमा काही खोट नाहती।<verse eid="GAL 1:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="GAL 1:21" />ऐको मंघा मि सीरिया अना किलकिया छेतर मा आयो। <verse eid="GAL 1:21" /><verse number="22" style="v" sid="GAL 1:22" />ओना बेरा यहुदिया छेतर की कलीसिया जोन मसीह मा से। मोला साजरो लक नही जानत होतीन। <verse eid="GAL 1:22" /><verse number="23" style="v" sid="GAL 1:23" />अना एतरोच आयकिन होतीन की “जोन मानूस हमला पयले सतावत होतो, उ अबा भरोसा को साजरो बारता आयकवाई रही से। जेनला उ पुढ़ा नास करत होतो।” <verse eid="GAL 1:23" /><verse number="24" style="v" sid="GAL 1:24" />वो मोरो बारे मा परमेस्वर को बड़ाई करत होतीन।<verse eid="GAL 1:24" /></para>
  <chapter eid="GAL 1" />
  <chapter number="2" style="c" sid="GAL 2" />
  <para style="s">पेरीत कन लक पौलुस को काम की मानता</para>
  <para style="p">
    <verse number="1" style="v" sid="GAL 2:1" />चौदह बरस बीतन को मंगा मि बरनबास को संगा यरुसलेम गयो। अना तीतुस ला संगा ले गयो। <verse eid="GAL 2:1" /><verse number="2" style="v" sid="GAL 2:2" />मि परमेस्वर को सांगयो लक उता गयो। अना जोन साजरो बारता मि परजात गीन <note caller="+" style="f"><char style="fr" closed="false">2:2</char><char style="ft" closed="false">यहुदी जाति के अलावा दुसरे जाति में</char></note> मा सांगिसेउ। वाच मीना उनला सांग दियो, पुड़ा पेस कियो। पर एकलो मा उनला जोन मोठो समजो जावत होतीन। की कहीं मोरी यो बेरा की या पिछलो दौड़ धुप अकारत न होय जाय। <verse eid="GAL 2:2" /><verse number="3" style="v" sid="GAL 2:3" />पर कोनी ना तीतुस ला जोन मोरो संगा होतो अना यूनानी से, खतना करान को साठी मजबुर नही करीन। <verse eid="GAL 2:3" /><verse number="4" style="v" sid="GAL 2:4" />यो उन दोगला भाऊगीन लक भयो। जोन चोरी लक धस आया होतीन की हमारो ओनो सुट की जोन यीसु मसीह मा हमला मिलीसे। भेद आन के ना हमला दास बनाऐत। <verse eid="GAL 2:4" /><verse number="5" style="v" sid="GAL 2:5" />आमी ना जरा सो देर लाय भी उनको कब्जा मा रव्हनो ला नही मानया। पर एकोलाय की साजरो बारता को खराई तुममा बनी रव्हे।<verse eid="GAL 2:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GAL 2:6" />पर वय लोक जो मान महातम को समजो जावत होतिन, वय कसा होतीन मोला एकोलक काही काम नाहाति; परमेस्वर कोनी को पक्स नही करा-उनलक जोन काही समझो जावत होतीन, मोला काही भी नही मिलीसे। <verse eid="GAL 2:6" /><verse number="7" style="v" sid="GAL 2:7" />पर एको बदला मा जबा उनना चोवयो की जसो लक पतरस ला खतना कियो हुयो लोकगीन को भरोसा साठी, साजरो बारता को काम सौपयो गई से, वसोच मोला बिन खतना कियो परजात लोकगीन को साठी साजरो बारता को काम सौपयो गयो से। <verse eid="GAL 2:7" /><verse number="8" style="v" sid="GAL 2:8" />काहेकि जोन परमेस्वर ना पेरीत पतरस लक खतना करनवालो मा अगुवाई को काम मोठो असरदार तरीको लक करवाइ, ओनाच मोरो लक भी परजात गीन मा असरदार काम करवाइसेस। <verse eid="GAL 2:8" /><verse number="9" style="v" sid="GAL 2:9" />जबा उनना ओना दया ला चिन्हिन जोन मोला मिली होतो ता याकूब, कैफा अना योहन ना जो कलीसिया को खम्बा समजो जावत होतीन, मोला अना बरनबास को संगती को उज्जो हात दियो की आमी परजात जातिगीन मा अना वय खतना करन वालो मा, काम करयेत। <verse eid="GAL 2:9" /><verse number="10" style="v" sid="GAL 2:10" />उनना आमी लक केवल योच बिनती करीन की गरीबगीन की हेत लेहेत। यो काम ला करन को साठी मि भी जोस मा रहयो। <verse eid="GAL 2:10" /><verse number="11" style="v" sid="GAL 2:11" />पर जबा कैफा अन्ताकिया आयो तो मीना ओको पुढ़ा ओको बिरोध कियो। काहेका उ दोसी होतो।<verse eid="GAL 2:11" /></para>
  <para style="s">पौलुस को कन लक पतरस को विरोध</para>
  <para style="p">
    <verse number="12" style="v" sid="GAL 2:12" />काहेकि याकूब को यहान लक काही लोकगीन को आवन लक पुढ़ा, उ परजात गीन को संग जेवन करत होतो। पर जबा वय आइन ता खतना वालो को भेव लक उन लक हट गयो अना एक कना करन लगयो। <verse eid="GAL 2:12" /><verse number="13" style="v" sid="GAL 2:13" />सुटयो यहूदिगीन ना भी यो छल मा ओको संग देइन, यहान तकन की बरनबास भी उन लोकगीन को छल को कारन बहक गयो। <verse eid="GAL 2:13" /><verse number="14" style="v" sid="GAL 2:14" />पर यो चोय के की वय लोक साजरो बारता को खराई को लक जिंदगी नही कर रही होतीन ता सब को पुढ़ा मीना पतरस लक कव्हयो, “जबा तु यहूदी भयके परजात गीन की जसो जिंदगी करसेस। ता तु गैरयहुदिगीन ला यहुदी को जसो चलन ला काय साठी कव्हसेस?”<verse eid="GAL 2:14" /></para>
  <para style="s">भरोसा कन लक धरमी ठरहनो</para>
  <para style="p">
    <verse number="15" style="v" sid="GAL 2:15" />आमी ता जलम लक यहूदी जाति सेजन, "पापी परजात" गीन मा लक नही। <verse eid="GAL 2:15" /><verse number="16" style="v" sid="GAL 2:16" />आमी जानसेजन से की मानूस मोसे को नियम लक नही पर मसीह यीसु पर भरोसा करनो लक धरमी ठहरायो जासे। यो काजी आमी ना भी मसिहा यीसु पर भरोसा करीसेजन की आमी मोसे को नियम को लक नही पर मसीह पर भरोसा करन लक धरमी ठहरबोन। काहेकि मोसे को नियम लक कोनी भी मानूस देह धरमी <note caller="+" style="f"><char style="fr" closed="false">2:16</char><char style="ft" closed="false">पवीतर </char></note> नही ठहरायो जाहे। <verse eid="GAL 2:16" /><verse number="17" style="v" sid="GAL 2:17" />आमी जो मसीह मा धरमी ठहरायो जावन, अदी खुदच पापी हिटबोन ता का मसीह पाप को दास से? कभीच नही। <verse eid="GAL 2:17" /><verse number="18" style="v" sid="GAL 2:18" />जेनला मि एक बार नास कर चुकीसेव, अदी ओला मंग बनासु तो खुदच ला दोसी ठहरासू। <verse eid="GAL 2:18" /><verse number="19" style="v" sid="GAL 2:19" />काहेकि मोसे को नियम को काम कन लक मि नियम को साठी कूरूस मा चघायो गयो की परमेस्वर मसीह को लाई जित्तो रह सकू। <verse eid="GAL 2:19" /><verse number="20" style="v" sid="GAL 2:20" />मि मसीह को सँग सुली पर टाँगयो गयो सेव। अता मि जित्तो नही रहयो, पर मसिहा मोरो मा जित्तो से, अना अबा मि जोन तन मा जित्तो सेउ, तो केवल ओनो भरोसा लक जित्तो सेउ जोन परमेस्वर को टूरा पर से, जेने मोरो लक माया करीस अना मोरो साठी आपरो आप ला दे देइस। <verse eid="GAL 2:20" /><verse number="21" style="v" sid="GAL 2:21" />मि परमेस्वर को दया ला अकारत नही ठहराउ। काहेकि अदी नेकीपन मोसे को नियम को काम कन लक मिल सकसे तो मसीह को मरनो अकारत से।<verse eid="GAL 2:21" /></para>
  <chapter eid="GAL 2" />
  <chapter number="3" style="c" sid="GAL 3" />
  <para style="s">भरोसा लक आतमा को फर मिलसे</para>
  <para style="p">
    <verse number="1" style="v" sid="GAL 3:1" />मुरख गलातियो, कोन ना तुमला मोह लेईस? तुमरी डोरा को पुढ़ा यीसु मसीह ता साजरो तरिको लक कूरूस मा चघायो हुयो दिसायो गयो होतो। <verse eid="GAL 3:1" /><verse number="2" style="v" sid="GAL 3:2" />मि तुमी लक केवल एतरोच जानन चाव्हसु की तुमना आतमा ला का मोसे को नियम को काम लक पाइसेव, या भरोसा लक साजरो बारता ला आयकन लक? <verse eid="GAL 3:2" /><verse number="3" style="v" sid="GAL 3:3" />का तुमी एतरो मुरख सेव की आतमा की रिती लक सुरू करके अता आँग की रिती पर सारहो? <verse eid="GAL 3:3" /><verse number="4" style="v" sid="GAL 3:4" />का तुमी ना एतरो आफद अकारत ही उचलीयत? का वय खरो मा अकारत होतीन? <verse eid="GAL 3:4" /><verse number="5" style="v" sid="GAL 3:5" />जोन तुमला आतमा देवासे अना तुममा अचंभा को काम करासे, उ का एकोसाठी करासे की तुमना मोसे को नियम को काम करयत या एकोसाठी की तुमना साजरो बारता पर भरोसा करयात?<verse eid="GAL 3:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GAL 3:6" />ऐना रिती लक अबराहम ना परमेस्वर पर <note caller="+" style="f"><char style="fr" closed="false">3:6 </char><char style="ft" closed="false">विस्वास </char></note> मा बिस्वास करीस , अना यो वोको लाय नेकी गिनयो गयो। <verse eid="GAL 3:6" /><verse number="7" style="v" sid="GAL 3:7" />अता यो जान लेव की भरोसा करनवारा च अबराहम की सँतान<note caller="+" style="f"><char style="fr" closed="false">3:7 </char><char style="ft" closed="false">खानदान </char></note> सेत। <verse eid="GAL 3:7" /><verse number="8" style="v" sid="GAL 3:8" />अना पवितर गिरंथ ना पयले लक यो जानके की परमेस्वर गैरयहूदी ला भरोसा लक नेक ठहरायो जाहे, पुढ़ा च लक अबराहम ला साजरो बारता आयकवाय देइस: “की सप्पा लोक गीन तोरो मा किरपा<note caller="+" style="f"><char style="fr" closed="false">3:8</char><char style="ft" closed="false">आसीस </char></note> पाहेति।” <verse eid="GAL 3:8" /><verse number="9" style="v" sid="GAL 3:9" />एकोसाठी जोन बिस्वास करसेति, वय बिस्वासी अबराहम को संगा आसीस पाहेति।<verse eid="GAL 3:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="GAL 3:10" />एकोसाठी जो लोक मोसे को नियम को काम पर भरोसा राखासेति, वय सबच सिराप को कब्जा मा सेत, काहेकि लिखीसे, “जोन कोनी मोसे को नियम को किताब मा लिखयो सबच हुकूम को पालन नही करा, उ सिरापित<note caller="+" style="f"><char style="fr" closed="false">3:10 </char><char style="ft" closed="false">दोसी </char></note> से।” <verse eid="GAL 3:10" /><verse number="11" style="v" sid="GAL 3:11" />एकोसाठी यो गोस्टी खुलो से की मोसे को नियम को काम कन लक परमेस्वर को नजर मा कोनी न्यायी ठहरायो नही जाहे, काहेकि नेक मानूस भरोसा <note caller="+" style="f"><char style="fr" closed="false">3:11</char><char style="ft" closed="false">विस्वास </char></note> लक जित्तो रव्हसे। <verse eid="GAL 3:11" /><verse number="12" style="v" sid="GAL 3:12" />पर भरोसा को मोसे को नियम को काम लक कोनी नाता नहाय। पर “जोन ओको गोस्टीहुन को पालन करेत उ उनको काजी जित्तो<note caller="+" style="f"><char style="fr" closed="false">3:12 </char><char style="ft" closed="false">जीवन पायेगा </char></note> रहेत।”<verse eid="GAL 3:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="GAL 3:13" />मसीह ना हमला आन के मोसे को नियम को काम को सिराप लक छुड़ायीस अना खुदच आमरो साठी सिरापित बन गयो, काहेकि लिखीसे, “जोन कोनी लकड़ी को कूरूस मा लटकायो जावसे उ सिरापित <note caller="+" style="f"><char style="fr" closed="false">3:13 </char><char style="ft" closed="false">दोसी </char></note> से।” <verse eid="GAL 3:13" /><verse number="14" style="v" sid="GAL 3:14" />यो एकोसाठी भयो की अबराहम को आसिरवाद यीसु मसीह मा परजात तकन पहुचे अना आमी भरोसा को कन लक ओना आतमा ला पावबिन, जोको परन कियो गयी से।<verse eid="GAL 3:14" /></para>
  <para style="s">कानुन अना वायदा</para>
  <para style="p">
    <verse number="15" style="v" sid="GAL 3:15" />भाऊ गीन, मि मानूस की रिती पर कव्हसू मानूस को वायदा भी जबा एक बार पक्को भय जावसे तो ओला कोनी रध्द नही करासे अना ना ओमा काही जोड़से। <verse eid="GAL 3:15" /><verse number="16" style="v" sid="GAL 3:16" />ऐना रीती लक परन अबराहम अना ओको खानदान<note caller="+" style="f"><char style="fr" closed="false">3:16 </char><char style="ft" closed="false">सँतान </char></note> लक कियो गयो होतो। पवितर गिरंथ नही कव्हसे, अना उनको खानदान गीन लक, “जसो की लगतगीन ला ईसारा, पर उनको खानदान ला, मान लेव तोरो खानदान लकच” जोन मसीह से। <verse eid="GAL 3:16" /><verse number="17" style="v" sid="GAL 3:17" />मोरो कव्हनो यो से जोन लिखयो लेख कन लक परमेस्वर पक्को कियो जाय चुकी से ओला चार सी तीस बरस मंघा होवन वालो मोसे को नियम को काम रध्द नही कर सकसे अना न ओको किरिया<note caller="+" style="f"><char style="fr" closed="false">3:17</char><char style="ft" closed="false">वायदा </char></note> ला बेकार बनाय सकसे। <verse eid="GAL 3:17" /><verse number="18" style="v" sid="GAL 3:18" />अदी मोसे को नियम को जरिया लक वारिसपन सुपरुत कर दियो जातो, तो परन लक ओको कोनी नातो नही पर वायदा कन लक ही परमेस्वर ना ओला अबराहम ला देवन को दया करीसेस।<verse eid="GAL 3:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="GAL 3:19" />तबा मोसे को नियम को काम को का मकसद से? जेने खानदान की परन दियो गई होती, ओको आवन को बेरा तकन नियम जुल्म को काजी जोड़ देई गई होती। उ सरगदूत गीन कन लक बिचवई को जरिया लक ठहरायो गयी से। <verse eid="GAL 3:19" /><verse number="20" style="v" sid="GAL 3:20" />बिचवई को काम दुई को बीच मा कियो जावसे; पर परमेस्वर एक से।<verse eid="GAL 3:20" /></para>
  <para style="s">नियम को मकसद</para>
  <para style="p">
    <verse number="21" style="v" sid="GAL 3:21" />ता का मोसे को नियम को काम अना परमेस्वर को परन मा विरोध से? कबच नहि। अदी असो कानुन की मुनादी भई होती, जोन जीवन देवनो मा होती, तो मोसे को नियम ला पालन लक ही मानूस नेक ठहरतो। <verse eid="GAL 3:21" /><verse number="22" style="v" sid="GAL 3:22" />पर पवितर गिरंथ ना सबच काही पाप को ताकत को कब्जा मा बँदी बनाय देइसेस, जोन लक यीसु मसीह मा कन लक भरोसा करनवारा भरोसा को साठी परन पूरो कियो जाय।<verse eid="GAL 3:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="GAL 3:23" />पर भरोसा को आवन को पुढ़ा आमी मोसे को नियम संग मा बंदी होता, अना भरोसा को आवन पर आमी ओको कब्जा मा रहया। <verse eid="GAL 3:23" /><verse number="24" style="v" sid="GAL 3:24" />ऐना रिती लक मसीह तकन पहुचन को साठी मोसे को नियम आमरो रखवारी करत होती। जोन भरोसा लक आमी लक न्यायी ठहरायो जावबिन। <verse eid="GAL 3:24" /><verse number="25" style="v" sid="GAL 3:25" />पर भरोसा आवनो लक आमी रखवालो का कब्जा मा नही रहया।<verse eid="GAL 3:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="GAL 3:26" />काहे की तुमी सप्पा को सप्पा यीसु मसीह मा भरोसा करन को काजी परमेस्वर की संतान सेव। <verse eid="GAL 3:26" /><verse number="27" style="v" sid="GAL 3:27" />काहेकि जितरो लोकगीन न मसीह को बप्तिस्मा ले लेइसेत, उनना मसिहा ला धारन कर लेइसेत। <verse eid="GAL 3:27" /><verse number="28" style="v" sid="GAL 3:28" />अब न कोनी यहूदिगीन सेत अना न कोनी यूनानी, न कोनी दास से अना न कोनी अजाद, न कोनी मरदमाना से, न कोनी आई-माई। तुमी सप्पा यीसु मसीह मा एक भई गया सेव। <verse eid="GAL 3:28" /><verse number="29" style="v" sid="GAL 3:29" />अदी तुमी लोक मसीह का सेव, तो अबराहम का खानदान सेव अना परन को वारिसदार<note caller="+" style="f"><char style="fr" closed="false">3:29</char><char style="ft" closed="false">हक रखने वालो</char></note> भी सेव।<verse eid="GAL 3:29" /></para>
  <chapter eid="GAL 3" />
  <chapter number="4" style="c" sid="GAL 4" />
  <para style="s">आमीला परमेस्वर को संतान बनावासे</para>
  <para style="p">
    <verse number="1" style="v" sid="GAL 4:1" />मोरो कव्हन को मतलब यो से जबा तकन वारिस नाबालिग से, उ सप्पा जायदाद को पिरभु होतो हुयो भी दास लक कोनी तरिको लक बेगरो से। <verse eid="GAL 4:1" /><verse number="2" style="v" sid="GAL 4:2" />उ बाबूजी कन लक नियत बेरा तकन पालक अना घर रखवालो को बस मा रव्हसे। <verse eid="GAL 4:2" /><verse number="3" style="v" sid="GAL 4:3" />एने रिति, जब तकन आमी नाबालिग होता तबा तकन दुनिया को उसुल गीन<note caller="+" style="f"><char style="fr" closed="false">4:3</char><char style="ft" closed="false">आदि सिक्सा</char></note> को कब्जा मा दास बनयो हुयो होतो; <verse eid="GAL 4:3" /><verse number="4" style="v" sid="GAL 4:4" />पर बेरा पूरो भय जावन पर परमेस्वर ना मोसे को नियम लाई आपरो टूरा ला धाड़िसेस उ एक बायका लक पैदा भयो, <verse eid="GAL 4:4" /><verse number="5" style="v" sid="GAL 4:5" />जोन लक उ मोसे को नियम लक कब्जा मा रव्हनवालो ला सुड़ाय सकेह अना आमी परमेस्वर की गोद लिया सँतान बन जावबिन।<verse eid="GAL 4:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GAL 4:6" />तुमी लोक सँतान ही सेव। एको पुरुप यो से की परमेस्वर ना आमरो मन मा आपरो टूरा को आतमा ला धाड़िस। जोन पुकार के यो कव्हसे, “बाबूजी, अजी।” <verse eid="GAL 4:6" /><verse number="7" style="v" sid="GAL 4:7" />एकोलाय अब तुमी दास नही, सँतान सेव अना संतान होवन को नातो लक तुमी परमेस्वर की दया लक वारिस<note caller="+" style="f"><char style="fr" closed="false">4:7 </char><char style="ft" closed="false">हकवाले </char></note> भी सेव।<verse eid="GAL 4:7" /></para>
  <para style="s">गलातिगीन को बारे मा संत पौलुस की चिंता</para>
  <para style="p">
    <verse number="8" style="v" sid="GAL 4:8" />तुमी लोक पुढ़ा, जबा तुमला परमेस्वर को अक्ल नही मिलयो होतो, असो देवतागीन की सेवा-जापता करत होतो, जिनको करनो वाकई मा साजरो नाहाती। <verse eid="GAL 4:8" /><verse number="9" style="v" sid="GAL 4:9" />पर अबा तुमी परमेस्वर ला वोरख लियो सेव या असो कव्हबिन की परमेस्वर ना तुमला अपनाय लेइसेस, तो तुम्ही कसो मंग उन बेजोर अना बेसार उसुल गीन की आसरा ले सकासेव? का तुमी एक गन मंग उनकी सेवा अपनावन चाव्हसो? <verse eid="GAL 4:9" /><verse number="10" style="v" sid="GAL 4:10" />तुमी लोक मुख दिवस, माह, मौसम अना बरस मनासेव। <verse eid="GAL 4:10" /><verse number="11" style="v" sid="GAL 4:11" />मोला भेव से, कहीं असो न होयहेत की मीना तुमी लोकगीन को बीच मा बेकार मेहनत करीसेव।<verse eid="GAL 4:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="GAL 4:12" />भाऊ अना बहिनगीन। तुमी मोरो जसो बनों, जेने रिति लक मि तुमरो जसो बन गयो सेव, योच तुमरो लक मोरो बिनती से। तुमी लोकगीन ना मोरो सँगा कोनी गलती अन्याव नही करी सो। <verse eid="GAL 4:12" /><verse number="13" style="v" sid="GAL 4:13" />तुमी जानासो की मोरो देह बीमार होवनो को काजी मोला तुमला पयलो गन साजरो बारता आयकवानो को मौका मिलिसे। <verse eid="GAL 4:13" /><verse number="14" style="v" sid="GAL 4:14" />ऐना रिती लक मि आपरो आँग की हिनो होवनो को काजी तुमी लोकगीन को साठी परीक्सा बनीसे, मंग भी तुमीना न तो मोरो गुस्सा करीसेव, अना न मोरो बारे मा घिरना चोवाईसेव, एको सिवा तुमना मोरो असो सेवा-सत्कार करीसेव, मानो जसो मि परमेस्वर को दूत या खुदच यीसु मसीह सेव। <verse eid="GAL 4:14" /><verse number="15" style="v" sid="GAL 4:15" />ओना बेरा तुमी लोक आपरो ला साजरो समजत होतो, अता तुमी लोकगीन को उ गवाही किता गयो? मि तुमी लोकगीन को बारे मा यो तो कव्ह सकत होतो। की अदी होय सकतो तो तुमी आपरी डोरा भी हेड़ के दे दिया रव्हतत। <verse eid="GAL 4:15" /><verse number="16" style="v" sid="GAL 4:16" />का मि तुमरो दुस्मन एकोसाठी बन गयी सेव की मि लोकगीन लक खरो-खरो कव्हसू।<verse eid="GAL 4:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="GAL 4:17" />जोन लोक तुमरो पर दया करके मिलान चाव्हसेत। पर वय साजरो मकसद लक असो नही कर रही सेत। वय तुमला मोरोलक अलग करनो चाव्हसेत, जोकोलक तुमी उनला आपरो पर हुकुमत करन देव। <verse eid="GAL 4:17" /><verse number="18" style="v" sid="GAL 4:18" />यो साजरो गोस्टी से की लोक तुमरी दया चाव्हसेत पर यो साजरो मकसद लक होय अना सदा रह, केवल ओनो बेरा तकन नही जबा तकन मि तुमरो बीच पायो जावासू। <verse eid="GAL 4:18" /><verse number="19" style="v" sid="GAL 4:19" />मोरो चहेतो लेकरा। जबा तकन तुममा मसीह को स्वरुप नही बन जावा। तबा तकन मि तुमरो लाई मंग जच्चा की पीड़ा सह रही सेव। <verse eid="GAL 4:19" /><verse number="20" style="v" sid="GAL 4:20" />मि कितरो चाव्हसु की अबा तुमरो बीच रव्हतो जेनको लक मि सही भासा को उपयोग कर सकू, काहेकि मोरी समझ मा नही आवा की मि तुमला काजक कहुँ।<verse eid="GAL 4:20" /></para>
  <para style="s">दुन नियम एक बँदीपन को अना दुजो सूटकारा को</para>
  <para style="p">
    <verse number="21" style="v" sid="GAL 4:21" />तुमी जोन मोसे को नियम को बस मा रव्हन चाव्हसो, मोला यो साँगो, का तुमी यो नही आयको की कानुन तुमला का कव्हसे? <verse eid="GAL 4:21" /><verse number="22" style="v" sid="GAL 4:22" />ओमा लिखीसे की अबराहम को दुई टूरा होतीन एक सेविका लक अना दुजो आजाद बायको लक। <verse eid="GAL 4:22" /><verse number="23" style="v" sid="GAL 4:23" />सेविका को टूरा को पैदा होवनो प्रकति को कन लक भयो। पर छुट्टो बायको को टूरा को पैदा होवनो परन कन लक। <verse eid="GAL 4:23" /><verse number="24" style="v" sid="GAL 4:24" />ऐना गोस्टी को एक दिखयो मायना से। या दुई बायको दुई वायदा को नामना सेति। एक सीनय परवत को, जेनको लक दास पैदा होवासेत अना वा हाजिरा से। <verse eid="GAL 4:24" /><verse number="25" style="v" sid="GAL 4:25" />हाजिरा अरब देस को सीनय परवत मानो जासे, जोन अबा को यरुसलेम को जसो से, काहे की वा आपरी संतानगीन को सकट सेवा मा से। <verse eid="GAL 4:25" /><verse number="26" style="v" sid="GAL 4:26" />पर वरता को यरुसलेम आजाद से, अना वा आमरी माय से। <verse eid="GAL 4:26" /><verse number="27" style="v" sid="GAL 4:27" />काहेकि लिखीसे,</para>
  <para style="q1" vid="GAL 4:27">“ओ बँझलु, तु जोन नही जानासेस,</para>
  <para style="q2" vid="GAL 4:27">पिरभु मा खुस रव्ह। तु जोन जनन को दुख नही जानस, खुसी लक झुम उचल,</para>
  <para style="q1" vid="GAL 4:27">काहेकि तजी हुई की लेकरा,</para>
  <para style="q2" vid="GAL 4:27">बयाही हुयी की लेकरा<note caller="+" style="f"><char style="fr" closed="false">4:27 </char><char style="ft" closed="false">सादी करी हुई </char></note> लक लगत सेत।”<verse eid="GAL 4:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="GAL 4:28" />“ओ भाऊ गीन, तुमी इसहाक को जसो परन को लेकरा सेव। <verse eid="GAL 4:28" /><verse number="29" style="v" sid="GAL 4:29" />पर जसो ओनो बेरा आँग को कनलक पैदा हुयो ता आतमा को कनलक जनमो हुयो ला सतावत होतो, वसोच अबा भी होवासे। <verse eid="GAL 4:29" /><verse number="30" style="v" sid="GAL 4:30" />पर पवितर गिरंथ मा काजक लिखीसे? दासी अना ओको टूरा ला हेड़ देव, काहेकि दासी को टूरा तो खुल्लो बायको को टूरा को सँग हक रखन वालो नही होहे।” <verse eid="GAL 4:30" /><verse number="31" style="v" sid="GAL 4:31" />एको साठी हे भाऊ गीन, आमी दासी का नई सेजन पर खुल्लो बायको को लेकरा सेजन।<verse eid="GAL 4:31" /></para>
  <chapter eid="GAL 4" />
  <chapter number="5" style="c" sid="GAL 5" />
  <para style="s">मसीह कन लक दियो गयी छुट</para>
  <para style="p">
    <verse number="1" style="v" sid="GAL 5:1" />मसीह ना छुट्टो रव्हन लाई हमरो सूटकारा<note caller="+" style="f"><char style="fr" closed="false">5:1</char><char style="ft" closed="false">सूटकारा</char></note> करीसेस, एकोसाठी तुमी लोक पक्का रव्हो। अना मंग गुलामी को जुआड़ी मा नोको फंदहो।<verse eid="GAL 5:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="GAL 5:2" />मि पौलुस, तुमी लोकगीन लक यो कव्हसु अदी तुमी सुद होवन को नियम करावासो, तो तुमी लोकगीन ला मसीह लक कोनी फायदा नही होहे। <verse eid="GAL 5:2" /><verse number="3" style="v" sid="GAL 5:3" />मंग मि हर एक खतना करानवालो ला पूरो जोर लक कव्हसू की ओला सप्पा मोसे को नियम को पालन करनो से। <verse eid="GAL 5:3" /><verse number="4" style="v" sid="GAL 5:4" />अदी तुमी आपरी धरमी पन को साठी मोसे को नियम पर आसरा रखनो चाव्हसो, तो तुमी ना मसीह लक आपरो नाता तोड़ लेईसेव अना परमेस्वर की दया ला खोय देइसेव। <verse eid="GAL 5:4" /><verse number="5" style="v" sid="GAL 5:5" />काहेका आतमा लक आमी भरोसा लक आस कियो हुया, धरमिपन को रस्ता चोविसेजन। <verse eid="GAL 5:5" /><verse number="6" style="v" sid="GAL 5:6" />अदी आमी यीसु मसीह लक जुड़या सेजन, तो खतना कोनी काम को नाहती। पर भरोसा से, जोन माया कन लक असर डाकासे।<verse eid="GAL 5:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="GAL 5:7" />तुमी लोक साजरो उन्नती कर रहया होतत। तुमी लोकगीन ला कोन ना पुढ़ा बढ़नो लक रोकिस की तुमी खरो गोस्टी ला नोको मानो? <verse eid="GAL 5:7" /><verse number="8" style="v" sid="GAL 5:8" />असो सीक तुमरो हाकलन वालो को कन लक नही। <verse eid="GAL 5:8" /><verse number="9" style="v" sid="GAL 5:9" />जरा सो खमीर<note caller="+" style="f"><char style="fr" closed="false">5:9</char><char style="ft" closed="false">ब्रेड भाकर में डाला जाने वाला पाउडर</char></note> पूरो गुथो हुयो कनीक ला खमीर बनाय देसे। <verse eid="GAL 5:9" /><verse number="10" style="v" sid="GAL 5:10" />मोला पिरभु मा तुमी पर सत से की तुमी कोनी अखीन बिचार धारा ला नही अपनाहो। पर तुमला घबरावनवालो चाहे उ कोनी काहे न होहे, सजा पाहे।<verse eid="GAL 5:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="GAL 5:11" />पर ओ भाऊ अदी मि अबा तकन खतना को परचार करतो आईसेव तो काहे सतावो जावुसु? मंग तो कूरूस को रास्ता पर जोन ठोकर होती, उ खतम भय गई। <verse eid="GAL 5:11" /><verse number="12" style="v" sid="GAL 5:12" />भलो होतो की जोन तुमला भटकाय देवासे, वय खुदच आपरो आँग काप डाकतीन।<verse eid="GAL 5:12" /></para>
  <para style="s">पवीतर आतमा को जीवन</para>
  <para style="p">
    <verse number="13" style="v" sid="GAL 5:13" />ओ भाऊ गीन तुमी सूटकारा पावन को लाई हाकलो गयो सेव, यो सूटकारा आँग की मनसा पूरी करन लाई नही होइसे, पर माया लक एक दुजो की सेवा करो। <verse eid="GAL 5:13" /><verse number="14" style="v" sid="GAL 5:14" />काहेकि सप्पा मोसे को नियम यो कव्हयो लक एकच सबद लक पूरो भय जावसे। तु आपरो पड़ोसी लक आपरो जसो माया<note caller="+" style="f"><char style="fr" closed="false">5:14</char><char style="ft" closed="false">पिरेम</char></note> राख। <verse eid="GAL 5:14" /><verse number="15" style="v" sid="GAL 5:15" />पर अदी तुमी एक दुसरो ला दात लक काटो सो अना फाड़ खावोसो, तो सतरक रव्हने की कही एक दुसरो ला सत्यानास नोको कर देहो।<verse eid="GAL 5:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="GAL 5:16" />पर मि कव्हसू की पवीतर आतमा को जसो चलोह तो तुमी आँग की मनसा ला कोनी रिती लक पूरी नही करहो। <verse eid="GAL 5:16" /><verse number="17" style="v" sid="GAL 5:17" />काहे की आँग तो पवीतर आतमा को विरोध मा अना पवीतर आतमा आँग को विरोध मा लालसा करासे, यो तो एक दुसरो को विरोधी<note caller="+" style="f"><char style="fr" closed="false">5:17 </char><char style="ft" closed="false">सतरू</char></note> सेत, जोन तुमी करनो चाव्हसो ओला नही कर सकोह। <verse eid="GAL 5:17" /><verse number="18" style="v" sid="GAL 5:18" />पर अदी तुमी पवीतर आतमा को चलाय चला सो तो मोसे को नियम को बस मा नही रहयो।<verse eid="GAL 5:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="GAL 5:19" />अबा आँग को काम खुलोसेत, मजे छिंडरापन, खोटो करम कामुकता, <verse eid="GAL 5:19" /><verse number="20" style="v" sid="GAL 5:20" />मुरत पुजा, जादु टोना, गुटबन्दी, बैर, झगड़ा, ईरसा, गुस्सा, बिरोध, फुट, अधरम <verse eid="GAL 5:20" /><verse number="21" style="v" sid="GAL 5:21" />छल, नसा, रँगरेली, अना ऐना तरह का काम सेत, जिनको बिसय मा मि तुमला चितासु जसो पयले चितोनी देय चुकयो, की असो-असो कामवारा तो परमेस्वर को राज का हकदार<note caller="+" style="f"><char style="fr" closed="false">5:21</char><char style="ft" closed="false">उत्तराधिकारी</char></note> नही होव्हेत।<verse eid="GAL 5:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="GAL 5:22" />पर पवीतर आतमा को फर माया, उत्साह, सान्ती, धीरज, दयालुपन, भलाई अना भरोसा सेत। <verse eid="GAL 5:22" /><verse number="23" style="v" sid="GAL 5:23" />नरमदिली अना संयम सेत। असो-असो मोसे को नियम को विरोध मा कोनी कानुन नही से। <verse eid="GAL 5:23" /><verse number="24" style="v" sid="GAL 5:24" />जोन मसीह यीसु को सेत, उनना आपरो आँग ला बुरो मनसा अना लालसा गीन सकट कूरूस मा चघायो देईसेत। <verse eid="GAL 5:24" /><verse number="25" style="v" sid="GAL 5:25" />अदी आमी पवीतर आतमा की सलाह को लक जिंदगी बिताबिन तो हमला पवीतर आतमा कन लक जिंदगी मिल गई से।<verse eid="GAL 5:25" /></para>
  <para style="s">मानूस जोन बोवासे वाच कापासे</para>
  <para style="p">
    <verse number="26" style="v" sid="GAL 5:26" />आमी झुठो घमन्ड नोको करबीन एक दुजो लक ला नही भडकाबिन अना एक दुजो लक जरन नही करबीन।<verse eid="GAL 5:26" /></para>
  <chapter eid="GAL 5" />
  <chapter number="6" style="c" sid="GAL 6" />
  <para style="p">
    <verse number="1" style="v" sid="GAL 6:1" />भाऊगीन अना बहिनगीन। अदी यो मालुम चलतो का कोनी ना कोनी गलत काम करीसेस तो तुमी लोक जोन आतमिक सेव, ओला नरम<note caller="+" style="f"><char style="fr" closed="false">6:1</char><char style="ft" closed="false">सीधो </char></note> तरीका लक साजरो करबीन। तुमी खुदच सतरक रव्हने कहिं असो न होय की तुमी भी परिक्सा मा पड़ जाहो। <verse eid="GAL 6:1" /><verse number="2" style="v" sid="GAL 6:2" />असो बोझ लक मोसे को नियम मा एक दुसरो की मदद करबीन अना येने रिती लक मसीह को हुकूम पूरो करबीन। <verse eid="GAL 6:2" /><verse number="3" style="v" sid="GAL 6:3" />काहेकि अदी कोनी समझसे की मि काही सेव। जबकि काही नही से तो उ आपरो आप ला ठगसे। <verse eid="GAL 6:3" /><verse number="4" style="v" sid="GAL 6:4" />हर कोनी आपरो काम ला परख लेहे, तबा ओको पड़ोसी को काम मा नही पर आपरो पर गरब करन को बेस कारन होव्हे। <verse eid="GAL 6:4" /><verse number="5" style="v" sid="GAL 6:5" />काहेकि हरएक मानूस ला आपरो बीड़ा खुदच उठानो पड़हे।<verse eid="GAL 6:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GAL 6:6" />जोन मानूस गोस्टी को सिक्सा पावसे, उ आपरी सबच साजरो चीज मा आपरो सिक्सक ला सामिल करे।<verse eid="GAL 6:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="GAL 6:7" />धोखा नोको खावने। परमेस्वर को ठठ्ठा नही करयो जाय सका। मानूस जोन बोवासे। वाच कापासे। <verse eid="GAL 6:7" /><verse number="8" style="v" sid="GAL 6:8" />जोन आपरी आँग की आदत को लाई बोवासे, उ आँग की माटी मा विनास की फसल कापासे; पर जोन पवीतर आतमा को लाई बोवासे, उ पवीतर आतमा की माटी मा अमर जीवन की फसल कापासे। <verse eid="GAL 6:8" /><verse number="9" style="v" sid="GAL 6:9" />आमी भलाई करत-करत हिम्मत न हारबिन काहेकि अदी आमी पक्को बनी रहबिन तो बेरा आवनो पर जरुर फसल कापबिन। <verse eid="GAL 6:9" /><verse number="10" style="v" sid="GAL 6:10" />एकोलाय जबा तकन आमी ला डाव मिलसे, आमी सबको भला करसेजन। मुख रूप लक उन लोकगीन की जोन भरोसा को कारन आमरो परिवार का सेत।<verse eid="GAL 6:10" /></para>
  <para style="s">आमी सप्पा परकार लक नयो संसार बनबिन।</para>
  <para style="p">
    <verse number="11" style="v" sid="GAL 6:11" />चोवो, मीना कसो मोठो-मोठो सबद मा तुमला आपरो हात लक लिखिसेव। <verse eid="GAL 6:11" /><verse number="12" style="v" sid="GAL 6:12" />जोन लोक दिखावा को काम लक झुठी बड़ाई पावनो चाव्हसेत। वय देह को खतना करवान को साठी तुमला रोकासेति यो एकोलाय की मसीह को कूरूस को कारन उन पर जुरुम नही कियो जाय। <verse eid="GAL 6:12" /><verse number="13" style="v" sid="GAL 6:13" />काहेकि सुध्द कियो हुया लोक खुदच मोसे को नियम पालन नही करासेत, बलकि वय तुमरो खतना करन चाव्हसेत जेनको लक वय यो गोस्टी कर सकबिन की आपरो-आपरो आँग मा यो धरम नियम अपनाय लियो से। <verse eid="GAL 6:13" /><verse number="14" style="v" sid="GAL 6:14" />पर असो नही होहे की मि आमरो पिरभु यीसु मसीह को कूरूस को अलावा कोनी अना गोस्टी पर गरब करुह, जेनको कन लक दुनिया मोरी नजर मा अना मि दुनिया को नजर मा कूरूस मा चघायो जाय चुकयो। <verse eid="GAL 6:14" /><verse number="15" style="v" sid="GAL 6:15" />कोनी को खतना भयो अना नही एको कोनी मानता नही से, मानता यो गोस्टी को से की आमी पूरो रूप लक नयो संसार बन जाबोन। <verse eid="GAL 6:15" /><verse number="16" style="v" sid="GAL 6:16" />यो नियम को लक चलनवारो पर अना परमेस्वर को इसरायल पर सान्ती अना तरस होय।<verse eid="GAL 6:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="GAL 6:17" />अबा लक कोनी मोला तँग नोको करने। मि यीसु को धब्बा ला आपरो बदन मा राखके रव्ह रही सेव।<verse eid="GAL 6:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="GAL 6:18" />भाऊ अना बहिन गीन। हमरो पिरभु यीसु मसीह की आतमिक दया तुमी लोकगीन पर बनी रहये। आमेन।<verse eid="GAL 6:18" /></para>
  <chapter eid="GAL 6" />
</usx>