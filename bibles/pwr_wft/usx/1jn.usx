<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="1JN" style="id">- Powari Standard Project</book>
  <para style="h">1 यहुन्ना</para>
  <para style="toc3">1 योहन</para>
  <para style="toc2">1 योहन</para>
  <para style="toc1">योहन को पहेलो चिठ्ठी</para>
  <para style="mt2">यहुन्ना का प्रथम पत्र</para>
  <para style="mt1">योहन को पहेलो चिठ्ठी</para>
  <para style="imt">परिचय</para>
  <para style="ip">1 योहन को चिठ्ठी पेरीत योहन लक मसीह को जलम को 50 लक 100 साल को बीच लिख्यो गयो होतो। योहन खुद को पेहचान लेखक को रूपमा नही करवायो से पर पहलो अध्याय दरसावा से का उ यीसु को जिंदगी अखीन मरके जिवनो ला आपरो डोरा लक चोवयो से। <char style="xt"><ref loc="1JN 1:1-3">1:1-3</ref></char> 1 योहन को लिखन को तरीका योहन को साजरा बारता लक लगत मिलतो जुलतो से। असो मानो जावासे का योहन ना इफिसुस मा रव्हतो बेरा च योहन अना तीन सबद को 1 योहन, 2 योहन अखीन 3 योहन को अनुसार साजरा बारता लिख्यो होतो।</para>
  <para style="ip">योहन ना यो चिठ्ठी सबा ईसाई गिनला असो बेरा मा लिख्यो होतो। जबा चरच ला नामको लोक को एक समूह लक परेसानी होतो। इन लोक हुनको असो माननो होतो का यीसु पूरो रीत लक परमेस्वर होतो पर उ सहीमा मांस अखीन रकत वालो मानूस नही होतो। यो कारन लक योहन यीसु को जीवन ला आपरो डोरा लक चोवनो को गोस्टी ला लिखा से। का मी वोला आपरो हात लक छिवो सेऊ। <char style="xt"><ref loc="1JN 1:1-3">1:1-3</ref></char> यो चिठ्ठी ला लिखन को उद्देस्य वोको खुसी ला पूरो करनो से <char style="xt"><ref loc="1JN 1:4">1 योहन 1:4</ref></char> अना बिस्वासी गिनला पाप करन लक रोकनो से। <char style="xt"><ref loc="1JN 2:1">1 योहन 2:1</ref></char> बिस्वासी गिनला खोटो सिक्सा लक रोकनो <char style="xt"><ref loc="1JN 2:26">1 योहन 2:26</ref></char> अना उनला समजानो से का वय कसो बचायो गयोसे। <char style="xt"><ref loc="1JN 5:13">5:13</ref> </char></para>
  <para style="iot">रूपरेखा</para>
  <para style="io1">1. योहन आपरो चिठ्ठी को परिचय देवासे, अखीन एला लिखन को एक उद्देस्य देवासे। <char style="ior"><ref loc="1JN 1:1-4">1:1-4</ref></char></para>
  <para style="io1">2. मंग वा सांगासे का परमेस्वर कसो उजाड़ से। अखीन अमीला यीसु को जसो मा कसो जिवनो पाहिजे। <char style="ior"><ref loc="1JN 1:5-3:10">1:5—3:10</ref> </char></para>
  <para style="io1">3. मंग उ अमीला एकमेक लक पिरेम करनो को हुकूम ला हेत करावासे। <char style="ior"><ref loc="1JN 3:11-5:12">3:11—5:12</ref> </char></para>
  <para style="io1">4. उ मा आपरो चिठ्ठी ला खतम करासे। <char style="ior"><ref loc="1JN 5:13-21">5:13-21</ref></char></para>
  <chapter number="1" style="c" sid="1JN 1" />
  <para style="s">जिंदगानी को बचन</para>
  <para style="p">
    <verse number="1" style="v" sid="1JN 1:1" />उ दुनिया को सुरुवात लकच ही होतो: आमीना येला आयकासेजन, आपरो नजर लक चोयोसेजन से, धियान लक चोयो सेजन, अना येला खुदच आपरो ही हातगीन लक आमीने येला छुयिसेत। आमी ओनो वचन को बारे मा साँग रही सेजन जो जीवन से। <verse eid="1JN 1:1" /><verse number="2" style="v" sid="1JN 1:2" />ओनो च जीवन को गियान आमीला करायो गयो। आमिना ओला चोया सेजन। आमी ओको गवाही सेजन अना अबा आमी तुमी लोकहुन ला ओना च अमर जिंदगी को एलान कर रही सेजन जोन बाबूजी को संग होतो अना आमी जेनको गियान करायो गयो। <verse eid="1JN 1:2" /><verse number="3" style="v" sid="1JN 1:3" />जोन काही आमी ना दिसया अना आयको सेजन ओको खबर तुमला देसेजन, एकोलाय की तुमी भी आमरो संगा संगी सेजन, अना आमरो यो संगीपन बाबूजी को संगा अना ओको टूरा यीसु मसीह को संग से। <verse eid="1JN 1:3" /><verse number="4" style="v" sid="1JN 1:4" />अना यो गोस्टी आमी एकोसाठी लिखासेजन का तुमरो खुसी पूरी भयी जाहे।<verse eid="1JN 1:4" /></para>
  <para style="s">परमेस्वर आमरो पापहुन ला छिमा करासे</para>
  <para style="p">
    <verse number="5" style="v" sid="1JN 1:5" />आमिना यीसु मसीह लक जोन साजरो बारता आयकोसेजन, उ यो से अना ऐलाच आमी तुमला आयकी सेजन, परमेस्वर उजियाड़ो से अना ओमा जरासो भी अंधारो नही से। <verse eid="1JN 1:5" /><verse number="6" style="v" sid="1JN 1:6" />यदि आमी कव्हबिन का आमी ओको संगी सेजन अना पाप को अंधारो जिंदगी ला जीवत रहया ता आमी खोटो कव्हसेजन अना खरो को अनुसरन नही कर रही सेजन। <verse eid="1JN 1:6" /><verse number="7" style="v" sid="1JN 1:7" />पर यदि आमी अबा उजियाड़ो मा पुढ़ा बढ़सेजन काहेकि उजियाड़ो मा च परमेस्वर से-ता आमी भरोसा को रूप मा एक दुसरो को संगी सेजन, अना परमेस्वर को टूरा यीसु को रकत आमला सबच पापहुन लक सुद कर देवासे।<verse eid="1JN 1:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1JN 1:8" />अदी आमी कव्हबिन का आमी मा काही पाप नहात, ता आपरो आप ला दगा देसेजन अना आमरो मा खरो नाहोति। <verse eid="1JN 1:8" /><verse number="9" style="v" sid="1JN 1:9" />अदी आमी आपरो पाप ला मान लेबिन, ता उ आमरो पाप गीन ला छिमा करनो को लाई अना अमीला सप्पा अन्याय लक सुद्ध करन लाय भरोसा लायक अना न्यायी से। <verse eid="1JN 1:9" /><verse number="10" style="v" sid="1JN 1:10" />अदी आमी कव्हबिन का आमी ना कोनी पाप नही करयो सेजन, ता आमी परमेस्वर ला खोटो ठहरा सेजन अना ओको बचन आमी मा नहाय।<verse eid="1JN 1:10" /></para>
  <chapter eid="1JN 1" />
  <chapter number="2" style="c" sid="1JN 2" />
  <para style="s">मसीह आमरो सहारा</para>
  <para style="p">
    <verse number="1" style="v" sid="1JN 2:1" />एकोसाठी अगा माया को टुरागीन, यो गोस्टी मि तुम्ही ला एकोलाय लिख रही सेऊ तुमी पाप मा नोको पड़ो अना अदी कोनी पाप करेत ता बाबूजी को कठा आमरो पापहुन लक बचावन साठी बचावन वालो एक सहारा से, मन्जे उ से न्यायी यीसु मसीह। <verse eid="1JN 2:1" /><verse number="2" style="v" sid="1JN 2:2" />उ एक बलिदान से जोन हमारो पापहुन ला छिमा करासे न केवल आमरो पापहुन को मनजे सप्पा संसार को पापहुन को।<verse eid="1JN 2:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="1JN 2:3" />अदी आमी परमेस्वर को हुकूम ला मान लेवबोन ता योच उ रास्ता सेत जेकोलक आमी पिक्को होवबिन का आमीना खरोखर ओला जान लिया सेजन। <verse eid="1JN 2:3" /><verse number="4" style="v" sid="1JN 2:4" />अदि कोनी कव्हसे की, “मि परमेस्वर ला जानासेऊ!” अना ओको हुकूम गीन ला नही मानासे ता उ खोटो से। ओको मन मा खरो नहाय। <verse eid="1JN 2:4" /><verse number="5" style="v" sid="1JN 2:5" />पर अदि कोनी परमेस्वर को बचन को पालन करासे ता ओमा परमेस्वर को माया सिध्द भयी से। योच उ रास्ता से जकोलक आमला पिक्को होवासे का आमी परमेस्वर मा पिक्को सेजन। <verse eid="1JN 2:5" /><verse number="6" style="v" sid="1JN 2:6" />जोन असो कव्हसे का उ परमेस्वर मा बनयो से, ओला यीसु को जसो जिंदगी जीवनो पाहिजे।<verse eid="1JN 2:6" /></para>
  <para style="s">सब लक माया राखो</para>
  <para style="p">
    <verse number="7" style="v" sid="1JN 2:7" />अगा चहेतो, मि तुमला कोनी नवो हुकूम नही लिख रही सेउ पर यो एक सनातन हुकूम से। जोन तुमला सुरुवात मा च देव देयि गयी होती। यो जूनो हुकूम उ साजरो बारता से जोन तुमना आयकियो सेव। <verse eid="1JN 2:7" /><verse number="8" style="v" sid="1JN 2:8" />मि तुमला एक अखिन दुसरी नवी हुकूम लिख रही सेऊ। ऐना बिसय को सत्य मसीह को जिंदगी मा अना तुमरो जिंदगी हुन मा उजागर भयी से काहेकि अंधारो खतम होय रही से अना खरो उजियाड़ो ता चमक च रहयो से।<verse eid="1JN 2:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="1JN 2:9" />जोन कोनी असो कव्हसे का मि उजाडो मा सेव अना आपरो भाऊ लक बैर राखासे, ता उ अबा तकन अंधार मा बनयो हुयो से। <verse eid="1JN 2:9" /><verse number="10" style="v" sid="1JN 2:10" />पर जोन कोनी आपरो भाऊ लक माया राखासे, उ उजाडो मा बनयो रव्हसे, अना ओको जिंदगी मा असो काही च नही से जेनको लक कोनी पाप मा नही पड़हेत। <verse eid="1JN 2:10" /><verse number="11" style="v" sid="1JN 2:11" />पर जोन कोनी आपरो भाऊ लक ईरसा राखासे, उ ईंधारो मा से। उ अंधारो मा जिंदगी जी रही से। उ नही जाना, उ किता जाय रही से। काहेका ईंधारो ना ओको डोरा भोकना कर देईसेस।<verse eid="1JN 2:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="1JN 2:12" />ओ माया को टुराहुन, मि तुमी ला एकोलाय लिखासेऊ, काहेका यीसु मसीह को काज तुमरो पाप छिमा कियो गयी सेत। <verse eid="1JN 2:12" /><verse number="13" style="v" sid="1JN 2:13" />ओ बाबुजीहुन, मि तुमीला एकोलाय लिखासेऊ, काहेका तुमी, जोन सूरूवात लक रव्हसे तूमी ओला जानासेव। ओ जुवानहुन, मि तुमला एकोलाय लिखासेऊ, का तुमना ओना बुराई पर जीत पायासेव।<verse eid="1JN 2:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="1JN 2:14" />ओ लेकराहुन, मि तुमला लिख रही सेऊ, काहेका तुमी परमेस्वर बाबूजी ला जान गयासेव। ओ बाबुजीहुन, मि ना तुमीला एकोलाय लिखासेऊ, काहेका जोन सूरू लक से तुमी ओला जान गयी सेव। ओ जुवानहुन, मीना तुमला एकोलाय लिखासेऊ, काहेका तुमी ताकतवर सेव, अना को गोस्टी तुमी मा बनो रव्हसे, अना तुमी ना ओनो बुराई पर जीत पायासेव।<verse eid="1JN 2:14" /></para>
  <para style="s">संसार लक माया नही करनो</para>
  <para style="p">
    <verse number="15" style="v" sid="1JN 2:15" />संसार ला अना संसार की चीजगीन ला माया नोको राखो। अदि कोनी संसार लक माया राखासे, ता ओको दिल मा बाबूजी को माया नही से। <verse eid="1JN 2:15" /><verse number="16" style="v" sid="1JN 2:16" />काहेकि ऐना संसार को हरेक चीज, जोन पर लोक एतरो घमन्ड करासेत। मोठयो बाबूजी को कन लक नही से पर उ ता संसारिक से। <verse eid="1JN 2:16" /><verse number="17" style="v" sid="1JN 2:17" />यो संसार आपरी लालसा हुन अना मरजीहुन सकट खतम होतो जाय रही से पर उ जोन परमेस्वर को मरजी ला मानासे, अमर होय जासे।<verse eid="1JN 2:17" /></para>
  <para style="s">मसीह-बिरोधीहुन को मंघा नोको होवने</para>
  <para style="p">
    <verse number="18" style="v" sid="1JN 2:18" />ओ चहेतो टुराहुन, यो आखरी बेरा आय गयी से! अना जसो का तुमिना आयकिया सेव का मसीह को बिरोधी आय रही से। एकोलाय अब कई मसीह बिरोधी उपजीसेत। ऐनाच आमी जानबिन का आखरी बेरा आय गयी से। <verse eid="1JN 2:18" /><verse number="19" style="v" sid="1JN 2:19" />मसीहको बिरोधी आमरो च बीच लक हिटीसेत पर बाकई मा वय आमरो नही सेत काहेकि अदि वय खरो आमरो होतीन ता आमरो संगी होतीन। पर वय आमला तज देयि सेत जेकोलक वय यो चोवाय सकेत का उनमा लक कोनी भी पक्को मा आमरो नाहती।<verse eid="1JN 2:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="1JN 2:20" />पर तुमरो ता ओना पवीतर लक अभिसेक हुयो से। एकोलाय तुमी सब सत्य ला जानासेव। <verse eid="1JN 2:20" /><verse number="21" style="v" sid="1JN 2:21" />मीना तुमला एकोलाय नही लिखासेव की तुमी खराई ला नही जानासेव, पर तुमी ता ओला जानासेव अना एकोलाय का सत्य लक कोनी खोटो नही हिटसे।<verse eid="1JN 2:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="1JN 2:22" />पर जोन यो कव्हसे का यीसु मसीह नाहती, उ खोटो से। असो मानूस मसीह को बैरी से उ ता बाबूजी अना टूरा दुही ला नकारसे। <verse eid="1JN 2:22" /><verse number="23" style="v" sid="1JN 2:23" />जोन कोनी टूरा लक मुकर जावसे ओको जवर बाबूजी भी नही: पर जोन टूरा ला मान लेवासे, उ बाबूजी ला भी मानासे।<verse eid="1JN 2:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="1JN 2:24" />जोन काही तुमी ना सुरू लक आयकिया सेव, वाच तुम मा बनयो रव्हे; जोन तुमी ना सुरू लक आयकियो सेव; अदि उ तुमी मा बनयो रव्हे ता तुमी टूरा मा अना बाबूजी मा बनया रव्हो। <verse eid="1JN 2:24" /><verse number="25" style="v" sid="1JN 2:25" />ओना आमला अमर जिंदगी देन को परन करीसेस।<verse eid="1JN 2:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="1JN 2:26" />मीना यो गोस्टी तुमला उन लोकहुन को बारे मा लिखयोसेऊ, जोन तुमला भरमावन को तक्का मा रव्हसेत। <verse eid="1JN 2:26" /><verse number="27" style="v" sid="1JN 2:27" />पर तुमरो उ अभिसेक जोन ओको कन लक करयो गयो, तुमी मा बनयो रव्हसे; अना तुमला ऐको मकसद नही का कोनी तुमला सिखाहे वरन जसो उ अभिसेक जोन ओको कन लक करयो गयो तुमला सबच गोस्टी सिकावासे, अना यो खरो से अना खोटो नहाती; अना जसो ओना तुमला सिकायो से वसोच तुमी ओमा बनयो रव्हसो।<verse eid="1JN 2:27" /></para>
  <para style="s">परमेस्वर को औलाद</para>
  <para style="p">
    <verse number="28" style="v" sid="1JN 2:28" />एकोलाय ओ चहेतो लेकराहुन, ओमा बनयो रव्हो का जबा हमला ओको गियान होय ता आमी हिम्मत पाय सकबिन, अना आमी ओको मंग आवनो को बेरा आमला लजाबिन नहि। <verse eid="1JN 2:28" /><verse number="29" style="v" sid="1JN 2:29" />अदि तुमी यो जानासेव, की उ न्यायी से, ता यो भी जानासेव का जोन कोनी नेकी को काम करासे उ परमेस्वर लक जन्मो से।<verse eid="1JN 2:29" /></para>
  <chapter eid="1JN 2" />
  <chapter number="3" style="c" sid="1JN 3" />
  <para style="s">आमी परमेस्वर को सन्तान सेत</para>
  <para style="p">
    <verse number="1" style="v" sid="1JN 3:1" />बिचार करबीन दिसबिन का मोठयो परमेस्वर बाबूजी ना आमी पर केतरो मोठो माया दिसायीसेस। जेकोलक आमी ओको टूरा-टूरी कहलाबिन अना बाकई मा वय आमिच सेत एकोलाय संसार आमला नोको ओरखबिन काहेका उ मसीह ला नही चिन्हासेत। <verse eid="1JN 3:1" /><verse number="2" style="v" sid="1JN 3:2" />ओ चहेतो हुन, अब आमी परमेस्वर को औलाद सेजन पर भबिस्य मा आमी काजक होवबिन, अबा तक ऐको मालुम नही करायो गयो से। जोन भी होय, आमी यो जानबिन का मसीह को मंग दिसावन पर आमी ओकोच जसो होय जावबिन काहेकि उ जसो सेत, आमी ओला बेस वसोच चोयबिन। <verse eid="1JN 3:2" /><verse number="3" style="v" sid="1JN 3:3" />हरेक कोनी जोन ओनो पर असी आस राखासे, उ आपरो आपला वसोच पवितर करासे जसो मसीह पवितर से।<verse eid="1JN 3:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="1JN 3:4" />जोन कोनी खोटो करम करासे, उ को परमेस्वर नियम ला बिरोध करासे। काहेकि नियम ला बिरोध करनो च पाप से। <verse eid="1JN 3:4" /><verse number="5" style="v" sid="1JN 3:5" />तुमी ता जानाच सेव का मसीह लोकहुन को पापहुन को एकोलाय दिसयो की पाप हुन ला दुहुर कर लेहे। उ सुभाव लक पापी नहाती। <verse eid="1JN 3:5" /><verse number="6" style="v" sid="1JN 3:6" />जोन कोनी ओमा बनयो रव्हसे, उ पाप नही करा; जोन कोनी पाप करासे ओना ना ता ओला चोयीसेस अना नाच ओला जानीसेस।<verse eid="1JN 3:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="1JN 3:7" />ओ टुराहुन कोनी को भरमावनो मा नोको आवनो। जोन न्याय को काम करासे, वाच ओको जसो धरमी से। <verse eid="1JN 3:7" /><verse number="8" style="v" sid="1JN 3:8" />जोन कोनी पाप करासे उ सैतान<note caller="+" style="f"><char style="fr" closed="false">3:8</char><char style="ft" closed="false">इबलीस</char></note> को कन लक से, काहेकि सैतान सुरुवात लक पाप करतो आयोसे। परमेस्वर को टूरा एकोलाय आयो का सैतान को काम ला नास करेत।<verse eid="1JN 3:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="1JN 3:9" />जोन कोनी परमेस्वर लक पैदा लेई सेस, उ पाप नही करासे; काहेकि ओको सुभाव ओमा बनयो रव्हसे, अना उ पाप कर च नही सका काहेका परमेस्वर लक पैदा लेई सेस। <verse eid="1JN 3:9" /><verse number="10" style="v" sid="1JN 3:10" />ऐकोच लक परमेस्वर को औलाद अना सैतान को औलाद जानो जासेती; जोन कोनी धरम को काम नही करासे उ परमेस्वर लक नही, अखिन उ जोन आपरो भाऊ लक माया नही राखा।<verse eid="1JN 3:10" /></para>
  <para style="s">एक दुजो लक माया राखनो</para>
  <para style="p">
    <verse number="11" style="v" sid="1JN 3:11" />काहेका जोन साजरो बारता तुमी ना सुरूवात लक आयकियात, उ यो से का आमी एक दुसरो लक माया राखबिन; <verse eid="1JN 3:11" /><verse number="12" style="v" sid="1JN 3:12" />अना कैन को जसो नोको बनबिन जोन ओनो दुस्ट लक होतो, अना जेने आपरो भाऊ ला मार डाकिस होतीस। अना ओला कोन कारन लक मार डाकिस? यो कारन का ओको काम बुरो होतीन, अना ओको भाउ न्यायी होतो।<verse eid="1JN 3:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="1JN 3:13" />ओ भाऊ, अदि संसार तुमी लक ईरसा करासे ता चकित नही होवनो। <verse eid="1JN 3:13" /><verse number="14" style="v" sid="1JN 3:14" />आमी जानबिन का आमी मिरतु लक पार भयके जिंदगी मा पहुचियो सेजन; काहेका आमी भाऊगीन लक माया राखासेजन। जोन माया नही राखासे उ मिरतु को हाल मा रव्हसे। <verse eid="1JN 3:14" /><verse number="15" style="v" sid="1JN 3:15" />जोन कोनी आपरो भाऊ लक ईरसा राखासे, उ खुनी से; अना तुमी जानासेव का कोनी खुनी मा अमर जिंदगी नही रव्हसे। <verse eid="1JN 3:15" /><verse number="16" style="v" sid="1JN 3:16" />आमी ना माया एकोलाय जानिया का ओना आमरो लाई आपरो जान दे देइस; अना आमला भी आपरो भाऊ लाई जान देवनो जरुरी से। <verse eid="1JN 3:16" /><verse number="17" style="v" sid="1JN 3:17" />पर जोन कोनी को जवर संसार को धन से अना आपरो भाऊ ला कंगाल दिसके ओको पर दया खावनो नही चाहे, ता ओमा परमेस्वर को माया कसो बनो रव्ह सकासे? <verse eid="1JN 3:17" /><verse number="18" style="v" sid="1JN 3:18" />ओ टुरागीन, आमी गोस्टी अना जुबान लकच नही, पर काम अना खराई लक भी माया करबीन।<verse eid="1JN 3:18" /></para>
  <para style="s">परमेस्वर को पुढा हिम्मत</para>
  <para style="p">
    <verse number="19" style="v" sid="1JN 3:19" />एकोच लक आमी जानबिन का आमी खरो का सेजन; अना जेनो गोस्टी मा आमरो मन आमीला दोस देहे, ओको बारे मा आमी ओको पुढा आपरो-आपरो मन ला हिम्मत दे सकबिन। <verse eid="1JN 3:19" /><verse number="20" style="v" sid="1JN 3:20" />काहेकि परमेस्वर आमरो मन लक मोठो से, अना वा सबच काही गुन-दोस जानासे। <verse eid="1JN 3:20" /><verse number="21" style="v" sid="1JN 3:21" />ओ चहेतो हुन अदि आमरो मन आमला दोस नही देहे ता आमला परमेस्वर को पुढा हिम्मत होवासे। <verse eid="1JN 3:21" /><verse number="22" style="v" sid="1JN 3:22" />अना जोन काही आमी माँगासेजन उ आमला ओकोलक मिलासे, काहेका आमी ओको हुकूम ला मानासेजन अना जोन काही ओला साजरो लगासे वाच करासेजन। <verse eid="1JN 3:22" /><verse number="23" style="v" sid="1JN 3:23" />ओकी हुकूम यो से का आमी ओको टूरा यीसु मसीह को नाव पर भरोसा करबीन, अना ओना आमला हुकूम देईसेस ओकोच जसो आपसी मा माया राखबिन। <verse eid="1JN 3:23" /><verse number="24" style="v" sid="1JN 3:24" />जोन ओको हुकूम ला मानासे, उ ओमा अना उ उनमा बनयो रव्हसे, अना एकोच लक मनजे ओना आतमा लक जोन ओना आमला देईसेस आमी जानासेजन की उ आमिमा बनयो रव्हसे।<verse eid="1JN 3:24" /></para>
  <chapter eid="1JN 3" />
  <chapter number="4" style="c" sid="1JN 4" />
  <para style="s">आतमा ला परखो</para>
  <para style="p">
    <verse number="1" style="v" sid="1JN 4:1" />ओ चहेतो, हरेक आतमा को भरोसा नोको करो पर आतमा ला परखो का वय परमेस्वर को कन लक सेत का नही; काहेका लगत सा खोटो भविस्यवक्ता संसार मा हिटके उभो होयी सेत। <verse eid="1JN 4:1" /><verse number="2" style="v" sid="1JN 4:2" />परमेस्वर को आतमा तुमी ऐना रीती लक ओरख सकासेव, जोन आतमा मान लेवासे का यीसु मसीह तन मा होयके आयिसे उ परमेस्वर को कन लक से, <verse eid="1JN 4:2" /><verse number="3" style="v" sid="1JN 4:3" />जोन आतमा यीसु ला नही मानासे उ परमेस्वर को कन लक नहाती; वाच ता मसीहबिरोधी को आतमा से, जेनको चरचा तुमी आयक लेईसेव का उ आवनवालो से, अबा भी संसार मा से।<verse eid="1JN 4:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="1JN 4:4" />ओ लेकराहून तुमी परमेस्वर का सेव तुमी ना उन पर जीत पायासेव काहेका जोन तुमी मा से उ ओकोलक जोन संसार मा से, मोठो से। <verse eid="1JN 4:4" /><verse number="5" style="v" sid="1JN 4:5" />वय संसार का सेत, एने कारन वय संसार को गोस्टी सांगासेत, अना संसार उनकी आयकासे। <verse eid="1JN 4:5" /><verse number="6" style="v" sid="1JN 4:6" />आमी परमेस्वर का सेजन। जोन परमेस्वर ला जानासे, उ आमरो आयकासे; जोन परमेस्वर ला नही जानासे उ आमरो नही आयकासे। ऐना रीती लक आमी सच्चो आतमा अना भरम को आतमा ला ओरख लेसेजन।<verse eid="1JN 4:6" /></para>
  <para style="s">परमेस्वर माया से</para>
  <para style="p">
    <verse number="7" style="v" sid="1JN 4:7" />ओ चहेतोहुन आमी आपसी मा माया राखबिन; काहेका परमेस्वर माया लक से। जोन कोनी माया करासे, उ परमेस्वर लक पैदा लेइसेस अना परमेस्वर ला जानासे। <verse eid="1JN 4:7" /><verse number="8" style="v" sid="1JN 4:8" />जो माया नही राखा उ परमेस्वर ला नही जाना, काहेकि परमेस्वर माया से। <verse eid="1JN 4:8" /><verse number="9" style="v" sid="1JN 4:9" />जोन माया परमेस्वर आमी लक राखासे, उ एकोच लक आयीसेस का परमेस्वर ना आपरो एकच टूरा ला संसार मा धाड़ीसेस का आमी ओको लक जिंदगी पावबिन। <verse eid="1JN 4:9" /><verse number="10" style="v" sid="1JN 4:10" />माया ऐमा नहाती का आमिना परमेस्वर लक माया करिया सेजन, पर ऐमा से का ओना आमी लक माया करीसेस अना आमरो पाप को पस्तावा को साठी आपरो टूरा ला धाड़ीस।<verse eid="1JN 4:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="1JN 4:11" />ओ चहेतोहुन, जब परमेस्वर ना आमी लक असो माया करीसेस, ता आमला भी आपसी मा माया करनो जरुरी से। <verse eid="1JN 4:11" /><verse number="12" style="v" sid="1JN 4:12" />परमेस्वर ला कबा च कोनी ना नही चोयीसेस; अदि आपस मा माया राखबिन, ता परमेस्वर आमी मा बनयो रव्हसे अना ओको माया आमी मा सिध्द भयी गयो से।<verse eid="1JN 4:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="1JN 4:13" />एकोच लक आमी जाना सेजन का आमी ओमा बनयो रव्हसेजन, अना उ आमी मा; काहेका ओना आपरो आतमा मा लक आमला देयीसेस। <verse eid="1JN 4:13" /><verse number="14" style="v" sid="1JN 4:14" />आमिना चोय भी लियासेजन अना गवाही देसेजन का बाबूजी ना टूरा ला संसार को सुटकारा देवनवालो करके धाड़ीसेस। <verse eid="1JN 4:14" /><verse number="15" style="v" sid="1JN 4:15" />जोन कोनी यो मान लेवासे का यीसु परमेस्वर को टूरा से, परमेस्वर ओमा बनयो रव्हसे, अना उ परमेस्वर मा।<verse eid="1JN 4:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="1JN 4:16" />जो माया परमेस्वर आमी लक राखासे, ओला आमी जान गयासेजन अना आमला ओको भरोसा से। परमेस्वर माया से, अना जोन माया मा बनो रव्हसे उ परमेस्वर मा बनो रव्हसे, अना परमेस्वर ओमा बनो रव्हसे। <verse eid="1JN 4:16" /><verse number="17" style="v" sid="1JN 4:17" />एकोच लक माया आमिमा सिध्द भयो का आमला नियाव को दिवस हिम्मत होहे; काहेका जसो उ से वसोच संसार मा आमी भी सेजन। <verse eid="1JN 4:17" /><verse number="18" style="v" sid="1JN 4:18" />माया मा कोनी भेव नाहती, पर भरपूर माया भेव ला दूहुर करासेत। काहेका भेव को तालुक सजा लक होवासे, जोन भेव राखासे उ माया मा सिध्द नही भयो।<verse eid="1JN 4:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="1JN 4:19" />आमी एकोलाय माया करासेजन, का पयले ओना आमिलक माया करीसेस। <verse eid="1JN 4:19" /><verse number="20" style="v" sid="1JN 4:20" />अदि कोनी कव्हेत, “मि परमेस्वर लक माया राखासेऊ,” अना आपरो भाऊ लक ईरसा राखेह ता उ खोटो से; काहेका जोन आपरो भाऊ लक जेने ओला चोयीसेस माया नही राखा, ता उ परमेस्वर लक भी जेनला ओना नही चोयीसेस माया नही राख सकासे। <verse eid="1JN 4:20" /><verse number="21" style="v" sid="1JN 4:21" />ओकोलक आमला यो हुकूम मिलीसेस, का जोन कोनी परमेस्वर लक माया राखासे उ आपरो भाऊ लक भी माया राखेह।<verse eid="1JN 4:21" /></para>
  <chapter eid="1JN 4" />
  <chapter number="5" style="c" sid="1JN 5" />
  <para style="s">संसार पर जीत पावनो</para>
  <para style="p">
    <verse number="1" style="v" sid="1JN 5:1" />जोन को यो भरोसा से का यीसु च मसीह से, अना परमेस्वर को टूरा से। जोन दाअजी ला माया करासे उ ओको टूरा ला भी माया करासे। <verse eid="1JN 5:1" /><verse number="2" style="v" sid="1JN 5:2" />एने परकार जबा आमी परमेस्वर ला माया करासेजन अना ओकी हुकूम ला मानासेजन, ता आमी जाना सेजन का आमी परमेस्वर की सन्तानगीन लक माया करासेजन। <verse eid="1JN 5:2" /><verse number="3" style="v" sid="1JN 5:3" />काहेका परमेस्वर लक माया राखनो को मायना से का आमी ओको हुकूम गीन ला मानबिन अना ओको हुकूम कठीन नहाती। <verse eid="1JN 5:3" /><verse number="4" style="v" sid="1JN 5:4" />काहेका जोन कोनि परमेस्वर को टूरा बन जासे, उ जग पर जीत पावसे। अना जग को वरता आमला जोको लक जीत मिलासे, उ आमरो भरोसा से। <verse eid="1JN 5:4" /><verse number="5" style="v" sid="1JN 5:5" />वाच जग पर जीत पावसे जोन यो भरोसा करासे की यीसु परमेस्वर को टूरा से।<verse eid="1JN 5:5" /></para>
  <para style="s">यीसु मसीह को बारे मा गवाही</para>
  <para style="p">
    <verse number="6" style="v" sid="1JN 5:6" />जोन पानी अना रकत को कन लक आयो होतो, मनजे सच्चो यीसु मसीह, उ ना ता केवल पानी लक पर पानी अना रकत दुही को कन लक आयो होतो। <verse eid="1JN 5:6" /><verse number="7" style="v" sid="1JN 5:7" />ओको तीन गवाह सेत। <verse eid="1JN 5:7" /><verse number="8" style="v" sid="1JN 5:8" />आतमा, पानी अना रकत; अना तीनच को एकच जसी गवाही सेत। <verse eid="1JN 5:8" /><verse number="9" style="v" sid="1JN 5:9" />जबा आमी मानूस को गवाही मान लेसेजन, ता परमेस्वर को गवाही ता ओको लक बढके सेत; अना परमेस्वर को गवाही यो से का उ आपरो टूरा को बारे मा गवाही देसे <verse eid="1JN 5:9" /><verse number="10" style="v" sid="1JN 5:10" />जोन परमेस्वर को टूरा पर बिस्वास करासे उ आपरो मा गवाही राखासे। जेना परमेस्वर पर बिस्वास नही कियोसेस ओना ओला खोटो ठहरायीसेस, काहेका ओना ओनो गवाही पर बिस्वास नही करीन जोन परमेस्वर ना आपरो टूरा को बारे मा देयीसेस। <verse eid="1JN 5:10" /><verse number="11" style="v" sid="1JN 5:11" />अना ओकी गवाही यो से का परमेस्वर ना आमला अमर जिंदगी देईसेस, यो जिंदगी ओको टूरा कन लक मिलयो से। <verse eid="1JN 5:11" /><verse number="12" style="v" sid="1JN 5:12" />जोको जवर टूरा से, ओको जवर जिंदगी से, अना जेनको जवर परमेस्वर को टूरा नहाती, ओको जवर जिंदगी भी नहाति।<verse eid="1JN 5:12" /></para>
  <para style="s">अमर जिंदगी</para>
  <para style="p">
    <verse number="13" style="v" sid="1JN 5:13" />परमेस्वर को टूरा मा भरोसा राखन वालो, तुमला यो गोस्टी मी एकोलाय लिख रही सेऊ जेनको लक तुमी यो जान लेव का अमर जिंदगी तुमरो जवर से। <verse eid="1JN 5:13" /><verse number="14" style="v" sid="1JN 5:14" />आमरो परमेस्वर मा यो भरोसा से का अदि आमी ओको मरजी को कन लक ओकोलक बिनती करबीन ता उ आमरो आयकासे। <verse eid="1JN 5:14" /><verse number="15" style="v" sid="1JN 5:15" />जबा आमी जानासेजन का जोन काही आमी मांगासेजन उ आमरी आयकासे; ता यो जानासेजन की जोन काही आमिना ओकोलक मांगीसेजन, उ पायो सेजन।<verse eid="1JN 5:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="1JN 5:16" />अदि, कोनी आपरो भाऊ ला असो पाप करतो दिसो जेनको फर मिरतु नही होहे, ता बिनती करेत, अना परमेस्वर ओला उनको लाई, जिनना असो पाप करीसेस जेनको फर मिरतु नही होहे। जिंदगी देहे। असो भी पाप से जेनको फर मिरतु से; ऐको बारे मा मि बिनती करन को लाई नही कव्हसू। <verse eid="1JN 5:16" /><verse number="17" style="v" sid="1JN 5:17" />सबच परकार को अधरम ता पाप से, पर असो भी पाप से जेनको फर मिरतु नही।<verse eid="1JN 5:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="1JN 5:18" />आमी जानासेजन, का जोन कोनी परमेस्वर को टूरा बन गयी से भयी, उ पाप नही करत रव्हा पर परमेस्वर को टूरा, ओकी रक्सा करत रव्हसे। उ दुस्ट ओला छुय नही सकासे।<verse eid="1JN 5:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="1JN 5:19" />आमी जानासेजन का आमी परमेस्वर लक सेजन, अना सप्पा जग ओना दुस्ट को कब्जा मा से।<verse eid="1JN 5:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="1JN 5:20" />लेकिन आमी यो भी जानासेजन का परमेस्वर को टूरा आय गयो से अना ओना आमला उ गियान देइसेस, मनजे यो का आमी ओमाच रव्हसेजन, जोन खरो से, मोठयो परमेस्वर च खरो परमेस्वर से अना ओच अमर जिंदगी से।<verse eid="1JN 5:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="1JN 5:21" />ओ लेकरागीन, आपरो आपला मुरत गीन लक बचाव राखबीन।<verse eid="1JN 5:21" /></para>
  <chapter eid="1JN 5" />
</usx>