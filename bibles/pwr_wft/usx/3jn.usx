<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="3JN" style="id">- Powari Standard Project</book>
  <para style="h">3 योहन</para>
  <para style="toc3">3 योहन</para>
  <para style="toc2">3 योहन</para>
  <para style="toc1">योहन को तीसरो चिठ्ठी</para>
  <para style="mt2">यहुन्ना का तिसरा पत्र</para>
  <para style="mt1">योहन को तीसरी चिठ्ठी</para>
  <para style="imt">परिचय</para>
  <para style="ip">योहन को तिसरो चिठ्ठी पेरीत योहन लक मसीह को जलम को 50 लक 100 साल को भीतर लिख्यो गयो होतो, योहन खुदला लेखक को रूप मा परगट नही करासे पर खुद ला बुजरुक कव्हा से। <char style="xt"><ref loc="3JN 1:1">1:1</ref></char> उ <char style="xt"><ref loc="2JN 1:1">2 योहन 1:1</ref></char> मा भी असोच करासे, असो मानो जावासे, का योहन ना इफिसुस मा रव्हतो बेरा योहन अखीन तीन अक्सर 1 योहन, 2 योहन अखीन 3 योहन को अनुसार साजरा बारता लिख्यो होतो।</para>
  <para style="ip">योहन ना यो चिठ्ठी गयुस नाव को एक बिस्वासी ला लिख्यो हुयो। उ गयुस ला एक संगी को रूप मा संबोधित करासे। अखीन वोला ईसाई भाऊहुन को लाय मिजवानी करन को हुकूम देवासे। जोन वोना छेतर को यातरा करत होतिन।</para>
  <para style="iot">रूपरेखा</para>
  <para style="io1">1. योहन आपरो चिठ्ठी को परिचय देवा से। <char style="ior"><ref loc="3JN 1:1">1:1</ref></char></para>
  <para style="io1">2. मंग उ गयुस ला बढ़ावा देवासे, अखीन वोको भाऊ गिनको पोहनाई करान को निरदेस देवासे। <char style="ior"><ref loc="3JN 1:2-8">1:2-8</ref></char></para>
  <para style="io1">3. मंग उ दुई बेगरो मरद दियुतिरफेस अखीन दिमेतिरयुस को गोस्टी करासे। <char style="ior"><ref loc="3JN 1:9-12">1:9-12</ref></char></para>
  <para style="io1">4. अखट्ट मा उ आपरो चिठ्ठी खतम करासे। <char style="ior"><ref loc="3JN 1:13-14">1:13-14</ref></char></para>
  <chapter number="1" style="c" sid="3JN 1" />
  <para style="p">
    <verse number="1" style="v" sid="3JN 1:1" />योहन को कन लक, माया को संगी, गयुस ला जेनला मि खरो मा सहसंगी को रूप मा माया करासेऊ।<verse eid="3JN 1:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="3JN 1:2" />ओ मोरो चहेतो संगी, मि बिनती करासेऊ का तु जसो आत्मिक रूप लक बढ़ रही सेस, वसोच हरेक पिरकार लक बढ़तो रव्ह अना भलो चंगो रीती लक खुसी उचलत रव्ह। <verse eid="3JN 1:2" /><verse number="3" style="v" sid="3JN 1:3" />जबा आमरो काही भाऊहुन ना मोरो जवर आयके सत को बारे मा तुमरी पिक्को भरोसा ला सांगीस, मि लगत खुसी भयो का तुमी सत को रास्ता पर कोन रीती चल रहया सेव। <verse eid="3JN 1:3" /><verse number="4" style="v" sid="3JN 1:4" />मोला एकोलक बड़के कोनी खुसी नाहोति का मी आयकासू का मोरा लेकरा सत मा बनयो रव्ह सेत। <verse eid="3JN 1:4" /><verse number="5" style="v" sid="3JN 1:5" />अगा मोरा चहेतो संगी, तुमी आमरो भाऊहुन को भलाई मा जोन काही कर सकासेव, ओला भरोसा को संग कर रहया सेव। जबकि वय लोक तुमरो लाई अनजान सेत। <verse eid="3JN 1:5" /><verse number="6" style="v" sid="3JN 1:6" />जो माया तुमीना उन पर चोवीसेव ओन्हीसीन कलीसिया को पुढ़ा ओको गवाही देयि सेत। उनको यातरा ला बनाय राखन लाई किरपा लक उनको एने तरीका मदद करबीन जेनको सहमति परमेस्वर करासे। <verse eid="3JN 1:6" /><verse number="7" style="v" sid="3JN 1:7" />काहेकी वय मसीह को सेवा को साठी यातरा पर हिटीसेत अना ओन्हीसीन बिरोधीहुन लक कोनी मदद नही लेयीसेत। <verse eid="3JN 1:7" /><verse number="8" style="v" sid="3JN 1:8" />एकोलाय आमी बिस्वासीहुन ला असो लोकहुन को मदद करनो चाहिसे जेनको लक हमी भी खरो को पक्स मा संग करमी सिध्द होय सकबिन।<verse eid="3JN 1:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="3JN 1:9" />मीना कलीसिया ला काही लिख्खो होत्यो पर दियुतिरफेस जोन उनको मा मोठयो होवनो चाव्हासेत उ हमला नही अपनावसे। <verse eid="3JN 1:9" /><verse number="10" style="v" sid="3JN 1:10" />एकोलाय जबा मी आहू त जोन काम उ करासेत वोको सुधि दिलाहू। का उ आमरो बारे मा बुरी-बुरी गोस्टी बकासे अखीन एको मा भी वोको मनमा सान्ती ना हती ता उ कलीसिया लक लोक गीन ला हेड़ासेत अना जोन हमीला अपनानो चाव्हसेत उनला भी उ नही भावासेत। ता उ आपच भाऊ गीन ला अपनानो चाहवासे अना मना करासे अखीन कलीसिया लक हेड देवासे।<verse eid="3JN 1:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="3JN 1:11" />अगा चहेतोहुन बुराई को नही पर भला को मंघा पराओ, जोन भलो करासेत परमेस्वर वोला चोवासेत पर जोन बुराई करासेत परमेस्वर को किरपा वोको पर नही होवासेत।<verse eid="3JN 1:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="3JN 1:12" />दिमेतिरयुस को बिसय मा सबच न अना सत न भी आपच गवाही देइस अखीन हमी भी गवाही देवा सेजन अना तु जानासेस का हमारो गवाही खरो से।<verse eid="3JN 1:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="3JN 1:13" />मोला तोला लगत काही लिखवानो त होतो परन स्याही अना कलम लक नही लिखवानो चाव्हत होता। <verse eid="3JN 1:13" /><verse number="14" style="v" sid="3JN 1:14" />पर मोला आस से का तोरो लक गदने भेंट करू तबा हमी आमने-सामने गोस्टी करबीन।<verse eid="3JN 1:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="3JN 1:15" />तोला सान्ती मिलती रह यहान का संगी तोला नमस्कार कव्हसेत</para>
  <para style="p" vid="3JN 1:15">वहान का संगी गीन ला नाव आन कन नमस्कार कव्ह देवजोस।<verse eid="3JN 1:15" /></para>
  <chapter eid="3JN 1" />
</usx>