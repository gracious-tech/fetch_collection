<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="HEB" style="id">- Powari Standard Project</book>
  <para style="h">इब्रानियो</para>
  <para style="toc3">इब्रानियो</para>
  <para style="toc2">इब्रानियो</para>
  <para style="toc1">इब्रानियो को नाव पौलुस की चिठ्ठी</para>
  <para style="mt2">इब्रानियो के नाव पौलुस का पत्र</para>
  <para style="mt1">इब्रानियो को नाव पौलुस की चिठ्ठी</para>
  <para style="imt">परिचय</para>
  <para style="ip">इब्रानियो को किताब एक जोस पैदा करन वारो चिठ्ठी से। जोन दरसावा सेत का कसो यीसु ना जूनो करार को लगत भविस्यवानी गिनला पूरो करीस। यो एक उपदेस को जसो लिख्यो गयो होतो। इब्रानियो को जूनो करार लक 60 लेक जादा परसंग से। जोन सफा-सफा चोवासेत का यीसु कसो भविस्यवानी अखीन यहूदी महायाजक को काम ला पूरो करयो से। एना कारन लक यो किताब यहूदी ईसाई गिनला जोस दिलावन वालो होतो। इब्रानियो ना चोवायो का कसो यीसु ना कानून ला पूरो करयो, जोन लक याजक गिनला दुबारा बली देवनो नोको पड़े। यीसु सबको पाप को लाय एक बार हरामेसा को लाय बली होतो। आमरो बेरा मा ईसाई गीन इब्रानियो को चिठ्ठी लक बढ़ावा पाय सका सेत। का वय यीसु को मघा चलतो बेरा जोन आमरो लाय परमेस्वर पर भरोसा करनो संभव बनावासेत। अखीन संगमा वोको पर भरोसा करतो रव्हनो। <char style="xt"><ref loc="HEB 12:2">12:2</ref></char></para>
  <para style="ip">इब्रानियो ला कोनना लिख्यो से यो कोनीला मालुम नाहती पर विदवान गीनना पेरीत पौलुस, लूका या बरनबास जसो मा लक कोनी सेत। लेख को तिथी भी मालुम नाहती। लेकिन लगत लोक गिनको असो मानता सेत का, ईसा को जलम को मघानी सन 70 को पहले लिख्यो गयो से काहेका अना 70 मा यरुसलेम नगर ला नास करयो होतिन। पर यो चिठ्ठी मा लेखक यरुसलेम नगर को बारेमा गोस्टी करासेत। असो जसो अबा नास नही भयो सेत। इब्रानियो ला रोम सहेर मा में लिख्यो गयो होतो। अना असो लगासे का लगत चरच मा धाड़यो गयो होतो। <char style="xt"><ref loc="HEB 13:24">13:24</ref></char></para>
  <para style="iot">रूपरेखा</para>
  <para style="io1">1. लेखक चोवायो से का यीसु भविस्यवक्ता अखीन सरगदूत गीन लक लगत बेस से। <char style="ior"><ref loc="HEB 1:1-4:13">1:1—4:13</ref></char></para>
  <para style="io1">2. मंग वा चोवायो से का यीसु उन याजकगीन लक बेस से जोन यरुसलेम मा परमेस्वर को मंदिर मा सेवा करासेत। <char style="ior"><ref loc="HEB 4:14-7:28">4:14—7:28</ref></char></para>
  <para style="io1">3. संगमा यीसु को सेवा को काम वोना जुनो करार लक बेस से जोन ला परमेस्वर ना आपरो परजा को काजी मोसे को नियम दियो होतो। <char style="ior"><ref loc="HEB 8:1-10:31">8:1—10:31</ref> </char></para>
  <para style="io1">4. यो समजावन को मघानी का यीसु हरेक परकार लक साजरो से, लेखक लगत परकार लक बरताव को निरदेस देवासे। <char style="ior"><ref loc="HEB 10:32-13:17">10:32—13:17</ref></char></para>
  <para style="io1">5. अखट्ट मा लेखक काही बढ़ावा अखीन नमस्कार को संग चिठ्ठी ला खतम करासे। <char style="ior"><ref loc="HEB 13:18-25">13:18-25</ref></char></para>
  <chapter number="1" style="c" sid="HEB 1" />
  <para style="s">परमेस्वर आमरो लक आपरो टूरा को लक गोस्टी करीसेस</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 1:1" />जूनो जमाना मा, परमेस्वर आपरो कन लक बोलन वालोगिन लक, लगत परकार ले पुरखागिन संग बोलयो। <verse eid="HEB 1:1" /><verse number="2" style="v" sid="HEB 1:2" />परंतु या अखट्ट दिवस मा उ अमी लक आपरो टूरा लक बोलला, जोनला परमेस्वर ना सप्पा गोस्टी को वारिस बनाइसेस। वोनाच सप्पा दुनिया ला बनाइसेस। <verse eid="HEB 1:2" /><verse number="3" style="v" sid="HEB 1:3" />उ ता टूरा परमेस्वर को गौरव को उजाड़ सेत। अना उ जनमन परमेस्वर जसोच सेत। अना सप्पा काही वोकोच सामरथ लक संभालासे। सर्वांना पाप पासुन मुक्त करायो अना असो करन को मंघा उ सरग मा महान गौरव लक परमेस्वर को उजो हातमा बस्यो।<verse eid="HEB 1:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="HEB 1:4" />वोको पद सरग दूतगिन लक वरता भेटयो सेत। काहे का वोला जोन नाव वारसाना भेटयो सेत। उ उनको नाव लक लगत साजरो सेत। <verse eid="HEB 1:4" /><verse number="5" style="v" sid="HEB 1:5" />“का परमेस्वर ना कदी कोनी सरगदुत लक असो नही कव्हयो?”</para>
  <para style="q1" vid="HEB 1:5">“तु मोरो टूरा आस!</para>
  <para style="q2" vid="HEB 1:5">आज मि तोला जलमायो सेउ।”</para>
  <para style="p" vid="HEB 1:5">अना मी वोको लाय,</para>
  <para style="q1" vid="HEB 1:5">अजी बनयो सेऊ,</para>
  <para style="q2" vid="HEB 1:5">“अना उ मोरो टूरा होयेत।”<verse eid="HEB 1:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="HEB 1:6" />मंग परमेस्वर दुनिया समोर आपरो “पहेलो टूरा” लाय असो कव्हसे का</para>
  <para style="q1" vid="HEB 1:6">“परमेस्वर को सप्पा देवदूत वोको अराधना करो।”<verse eid="HEB 1:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="HEB 1:7" />जबा परमेस्वर देवदूत को बारे मा कव्हासेत।</para>
  <para style="q1" vid="HEB 1:7">“उ आपरो देवदूत ला वारा,</para>
  <para style="q2" vid="HEB 1:7">अना आपरो सेवकहुन ला स्तो की लपट बनावासे।”<verse eid="HEB 1:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="HEB 1:8" />पर टूरा को बारे मा, “ओ परमेस्वर! तोरो सिघासन हरामेसा जुग-जुग तकन टिकेत अना तुमरो राज करन को छड़ी नियाव को कारज छेतर सेत।” <verse eid="HEB 1:8" /><verse number="9" style="v" sid="HEB 1:9" />तोला साजरापन भावासेत अना पाप लक नफरत करासेत। एकोलाय परमेस्वर ना तोला पिरेम लक निवाड़ो सेत। “अना यो आदर मान तोला तोरो संगीगिन लक जास्ता देईसेस।” <verse eid="HEB 1:9" /><verse number="10" style="v" sid="HEB 1:10" />अना मंग,</para>
  <para style="q1" vid="HEB 1:10">“हे पिरभु सुरुच मा तुचना धरती को पाया डाकिस,</para>
  <para style="q2" vid="HEB 1:10">अना बादल तोरोच हात को बनायो से।”<verse eid="HEB 1:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="HEB 1:11" />वोको नास होहेत, पर तु बनयो रव्हजोस।</para>
  <para style="q2" vid="HEB 1:11">सप्पा वय कपरा सारखे जुनो हो जाहेत पर तु एक सो बनो रव्हसेस।<verse eid="HEB 1:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="HEB 1:12" />अना उनला चद्दर जसो लपेटून देहिन।</para>
  <para style="q2" vid="HEB 1:12">मजे वा कपरा जसो बदलीन जाहेत।</para>
  <para style="q1" vid="HEB 1:12">पर तुम्ही एक सारखे सेव अना तोरो सालगिन को अंत होनार नाही।</para>
  <para style="q2" vid="HEB 1:12">अखीन तु वोला चद्दर को जसो लपेटजोस अना वय सबच कपरा को जसो जुनो भई जाहेति अना फट जाहेति।<verse eid="HEB 1:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="HEB 1:13" />अना कोन तो देवदूत ला उ असो कव्हयो होतो की,</para>
  <para style="q1" vid="HEB 1:13">“मी तोरो बैरी</para>
  <para style="q2" vid="HEB 1:13">ना तोरो पाय खाल्या ओयना देहिन</para>
  <para style="q2" vid="HEB 1:13">मोरो उज्जो कना बस।”<verse eid="HEB 1:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="HEB 1:14" />वय सप्पा आतमा परमेस्वर को सेवा नही करासेत काय? का सबच सरगदुत दास नाहती जोन उन लोकगीन को सेवा साठी धाड़यो जासेत जोन मुकती को बारिस सेत।<verse eid="HEB 1:14" /></para>
  <chapter eid="HEB 1" />
  <chapter number="2" style="c" sid="HEB 2" />
  <para style="s">मोठो सूटकारा</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 2:1" />एकोलाय अमीला जोन खबर भेटयो सेत। वोको कन आपरो बारीकी लक धियान देवनो पाहिजे। वा गमावू नका अना मारग भटक जाबिन। <verse eid="HEB 2:1" /><verse number="2" style="v" sid="HEB 2:2" />कारन देवदूत जोन सबद बोलयो वा पक्को रव्हयो अना हरेक झन ला सजा अना हुकूम तोड़न को नेमको बदला भेटयो, <verse eid="HEB 2:2" /><verse number="3" style="v" sid="HEB 2:3" />“इतरो मोठ्या तारन लक अमी धियान नही दियो सेत ता अमी कसौ सूट जाबोन?” जबकि स्वता पिरभु ना पयले सूटकारा को मुनादी करयो होतो। अना जोन लोकगीन ना वोकी आयेकले, उनना यो सही सेत असो सिध्ध करयो। <verse eid="HEB 2:3" /><verse number="4" style="v" sid="HEB 2:4" />वोच बेरा परमेस्वर ना सप्पा परकार को चिमत्कार अना अद्भुत गोस्टी करयो, अना पवितर आतमा भेटी वोको इक्सा अनुसार बाटयो। उ ना वोकी गवाही ला बड़ायो।<verse eid="HEB 2:4" /></para>
  <para style="s">मसिहा सूटकारा देवनवारा सेत</para>
  <para style="p">
    <verse number="5" style="v" sid="HEB 2:5" />जोन आवनवालो नवीन दुनिया सेत। वोको बारे मा परमेस्वर ना देवदूतगिन ला नियुक्त नाही करयो। <verse eid="HEB 2:5" /><verse number="6" style="v" sid="HEB 2:6" />धरम गिरथ मा एक जघा असो चेताय गयो सेत</para>
  <para style="q1" vid="HEB 2:6">“ओ परमेस्वर, मानूस का सेत का तू वोको देख रेख करतोस?</para>
  <para style="q2" vid="HEB 2:6">मजे मानूस को टूरा को तु चिन्ता करजोस<verse eid="HEB 2:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="HEB 2:7" />तू जरासो बेरा साठी वोला देवदूत लक लहान कियो सेत। अना ओला गौरव</para>
  <para style="q2" vid="HEB 2:7">अखिन सन्मान को मुकुट दियो से, अना वोला तैय्यारी मा आपरो हात को काम पर हक्क देइसेस।<verse eid="HEB 2:7" /></para>
  <para style="q2">
    <verse number="8" style="v" sid="HEB 2:8" />अना वोना उनला सप्पा गोस्टी मा राज दियोसेत।”</para>
  <para style="p" vid="HEB 2:8">असो कह्यो सेत का परमेस्वर ना “सप्पा गोस्टी” मा नियुक्त कियो। एको साप मतलब सेत, सप्पा काही समायो सेत। <verse eid="HEB 2:8" /><verse number="9" style="v" sid="HEB 2:9" />परंतु, मानूस अबा सप्पा गोस्टी मा राज करतो दिसत नाही। पर आपरो यीसुला चोवो, जोनला काही बेरा साठी देवदूत को मुकाबला मा नीचो कियो। या साठी की, परमेस्वर को किरपा लाय वा सर्वांसाठी मरयो। अता आपरो मरनो को दुख को कारन वोला गौरव व सन्मान को मुगुट पहनायो गयो। <verse eid="HEB 2:9" /><verse number="10" style="v" sid="HEB 2:10" />फक्त इतरोच खरो च सेत, का जोनना सप्पा गोस्टी बनायो। अना वा सर्वां को रक्सन करयो, या साठी का वोना लगत सो टूरा-टूरी ला वोको गौरव वाटन साठी मसीह ला दुख देके पुरो करयो। अबा यीसु उनको सूटकारा ठैयरो अता कोन सेत?<verse eid="HEB 2:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="HEB 2:11" />परमेस्वर ना उनला पाप पासुन सुद्ध करासे। अना जोन सुद्ध सेत, उ सबको एकच अजी सेत। एकोलाय यीसु ला उनला कुटुंब माननो मा कोनी लाज नही लगासेत। <verse eid="HEB 2:11" /><verse number="12" style="v" sid="HEB 2:12" />अना उ परमेस्वर ला कव्हसेत</para>
  <para style="q1" vid="HEB 2:12">“तू जोन करयो सेत, उ मी मोरो लोकगीन ला सांगिन,</para>
  <para style="q2" vid="HEB 2:12">मी उनको सभा मा तोरो स्तुती करीन।”<verse eid="HEB 2:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="HEB 2:13" />उ अखिन कव्हसेत “मी मोरो विस्वास वोको मा ठेविन।” अना उ मंग कव्हसेत “इतानी मी सेऊ” मजे मोरो बरोबर परमेस्वर ना जोन सन्तान देइसेस, अमी समेर सेत।<verse eid="HEB 2:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="HEB 2:14" />उ लेकरागिन ला सांगतो, “यो लोकगिन मोरो स्वता को देह अना रक्त सेत, एकोलाय यीसु स्वता उनको सारखा भयो अखिन वोको स्वभाव मानूस सारखा भय गयो, यासाठी की वोना आपरो मरनो लक सैतान को नास करे।” जोन को मरनो मा हक सेत। <verse eid="HEB 2:14" /><verse number="15" style="v" sid="HEB 2:15" />अना जोन लोक ला सप्पा जीवन मा मरनो को भेव सेत। अना वय मरन को दास सारखे जगत मा होतीन, उनला त मुक्त करावे। <verse eid="HEB 2:15" /><verse number="16" style="v" sid="HEB 2:16" />यो कारन उ देवदूतगिन को नही तर अबराहम को खानदान को लोक गिन ला सभांला सेत। <verse eid="HEB 2:16" /><verse number="17" style="v" sid="HEB 2:17" />यो कारन खुद सप्पा गोस्टी को बिच मा उ उनको भाऊ सरिसो होवनो पाहिजे। एको लाय का लोकगिन को पाप को लाय को बदला मा बली देवन साठी परमेस्वर को संबंधित असो गोस्टी तो दयालू अना बिस्वासी असो परमुख याजक सेत। <verse eid="HEB 2:17" /><verse number="18" style="v" sid="HEB 2:18" />कारन जबा उ ना परिक्सा को बेरा दुख सहयो सेत। एकोलाय उ परिक्सा मा पड़यो मानूस गिन को मदत करू सकासेत।<verse eid="HEB 2:18" /></para>
  <chapter eid="HEB 2" />
  <chapter number="3" style="c" sid="HEB 3" />
  <para style="s">यीसु मोसेस लक महान सेत</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 3:1" />एकोलाय पवीतर भाऊ अना बहिन हुन! तुमी सरग मा हाकलो जान को हिस्सादार सेव। यीसु पर धियान लगाव जोन आमी ला पेरीत अना मुखिया याजक मानिसेजन। <verse eid="HEB 3:1" /><verse number="2" style="v" sid="HEB 3:2" />जसो परमेस्वर को सारो घराना मा मोसे भरोसा को काबिल बनो रहयो, वसोच उभी आपरो ठहरानवारा को डोरा मा भरोसा को काबिल बनो रहयो। <verse eid="HEB 3:2" /><verse number="3" style="v" sid="HEB 3:3" />जसो घरको बनावन वारा घर लक जादा आदर को काबिल होवासेत वसोच यीसु भी मोसे लक बड़के महिमा अना आदर को लायक समझो गयो। <verse eid="HEB 3:3" /><verse number="4" style="v" sid="HEB 3:4" />काहेका हरेक घर कोनी ना कोनी लक बनायो जासेत। पर सक्ड़या चीजला बनावन वारा परमेस्वर सेत। <verse eid="HEB 3:4" /><verse number="5" style="v" sid="HEB 3:5" />परमेस्वर को सारो घराना मा मोसे तो नौकर जसो भरोसा को काबिल रहयो का मघा मा होवनवालो गोस्टी को पुरुप भई जाय। <verse eid="HEB 3:5" /><verse number="6" style="v" sid="HEB 3:6" />पर मसिहा तो टूरा जसो परमेस्वर को घराना को वारिस सेत। अदी आमी आपरो भरोसा अना आस मा घमंड ला आखीर तकन मजबुति लक थाम सेजन त हमच वोको घराना सेजन।<verse eid="HEB 3:6" /></para>
  <para style="s">परमेस्वर को लोकगीन काजी आराम</para>
  <para style="p">
    <verse number="7" style="v" sid="HEB 3:7" />एकोलाय जसो पवीतर आतमा कव्हसेत “अदी आज तुम वोको हाकलनो आयको <verse eid="HEB 3:7" /><verse number="8" style="v" sid="HEB 3:8" />तो आपरो मन ला गोटा वानी नोको करो। जसो जगंल मा परिक्सा को बेरा उनना करिया होता जेनको लक परमेस्वर हिजर गयो होतो।” <verse eid="HEB 3:8" /><verse number="9" style="v" sid="HEB 3:9" />उता तुमरो आजा बाबा गीन ना मोला परखिन अना चाड़ीस साल तकन मोरो काम चोविन। <verse eid="HEB 3:9" /><verse number="10" style="v" sid="HEB 3:10" />एकोलाय मीना यो बेरा को लोकगीन लक हिजर के सागयो इनको मन हमेसा लक इतानी उतानी हिंडा सेत अना ऐना ना मोरो रस्ता ला नही चिन्होसेत <verse eid="HEB 3:10" /><verse number="11" style="v" sid="HEB 3:11" />तबा मीना हिजर के किरिया खायो वय मोरो बिसराम को जघा मा नही जाय सकेत।<verse eid="HEB 3:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="HEB 3:12" />अगो भाऊ अना बहिनहुन होसियार रव्हो कदि असो नोको होये का तुमरो लक कोनी को मन दुस्ट स अना अबिस्वासी भई जाय अना तुम जित्तो परमेस्वर लक दुहुर भई जावो। <verse eid="HEB 3:12" /><verse number="13" style="v" sid="HEB 3:13" />जब तकन “आज को दिवस” कहलावसेत तबा तकन तुमी रोज एक दूजो ला बढ़ावा देव, कदी असो नोको भई जाय का तुमरो लक कोनी मानूस पाप मा पड जाय अना वोको मन गोटा जसो भई जाय। <verse eid="HEB 3:13" /><verse number="14" style="v" sid="HEB 3:14" />अदी आमी आपरो पहेलो भरोसा पर आखीर तकन मजबूत बनो रव्हसेत तो आमी मसीह को हिस्सादार बनयो सेत।<verse eid="HEB 3:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="HEB 3:15" />जबकि कव्हयो गयो सेत,</para>
  <para style="q1" vid="HEB 3:15">“अदी आज तुमी वोको आवाज आयको,</para>
  <para style="q2" vid="HEB 3:15">तो आपरो मन ला असो कड़ो नोको करो,</para>
  <para style="q2" vid="HEB 3:15">जसो का उनना हिजरान को बेरा कियो होतो।”<verse eid="HEB 3:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="HEB 3:16" />काहेका कोन लोक गिनना आयक के मोसे ला हिजराइन? का सहीमा उन लोकगीन नही जोन मोसे को सगं मिसर देस लक हिटी होतिन। <verse eid="HEB 3:16" /><verse number="17" style="v" sid="HEB 3:17" />उ कोन लोकगीन लक चाड़ीस साल तकन गुस्सा करीस का उन लक नही जोन ना पाप करिया अना उनको लास जगंल मा पडयो रहयो। <verse eid="HEB 3:17" /><verse number="18" style="v" sid="HEB 3:18" />“परमेस्वर ना कोनी लक किरिया खाईस? का तुमी मोरो अराम को जघामा नही जा सकेत। का उन लक नही का जोनना हुकूम नही मानिन?” <verse eid="HEB 3:18" /><verse number="19" style="v" sid="HEB 3:19" />तो एकोलाय आमी चोवसेजन का अबिस्वास होवन को कारन लक वय धसनो नही पाइन।<verse eid="HEB 3:19" /></para>
  <chapter eid="HEB 3" />
  <chapter number="4" style="c" sid="HEB 4" />
  <para style="p">
    <verse number="1" style="v" sid="HEB 4:1" />एकोलाय जबा वोको बिसराम को जघा मा धसनो को वायदा अबा तकन बनयो हुयो सेत, तो आमी ला सतरक रव्हनो पाहिजे। का तुमरो लक कोनी वोको लायक ना रव्हेत। <verse eid="HEB 4:1" /><verse number="2" style="v" sid="HEB 4:2" />काहेका अमीला उनको च जसो साजरो बारता आयकु आय गयो सेत। पर जोन साजरा बारता उनना आयकयो वोको कोनी फायदा नही भयो। काहेका आयकन वालो बिस्वास नही करयो। <verse eid="HEB 4:2" /><verse number="3" style="v" sid="HEB 4:3" />अबा चोवो, अमीला जोन बिस्वास सेजन। वोना बिसराम मा धसयो सेत। जसो का परमेस्वर ना सांगयो से। “मीना गुस्सा मा किरिया खाय के कव्हयो होतो। ‘वय कदीच मोरो बिसराम मा सामिल नही होयेत।’” जबा संसार को बनानको मघा वोको काम पूरो हो गयो होतो। <verse eid="HEB 4:3" /><verse number="4" style="v" sid="HEB 4:4" />वोना सातवो दिवस को बारे मा गीरंथ मा कही असो कव्हयो सेत। “परमेस्वर ना सातवो दिवस आपरो सब काम निपटा केन बिसराम करीसेस।” <verse eid="HEB 4:4" /><verse number="5" style="v" sid="HEB 4:5" />अना मंग यो जघा मा भी कव्हयो “वय कदी मोरो बिसराम मा सामिल नही होयेत।” <verse eid="HEB 4:5" /><verse number="6" style="v" sid="HEB 4:6" />जोनला पयले साजरा बारता आयकायो गयो होतो। वय अपरो हुकूम नही मानन को कारन बिसराम मा नहि धस सकयो। पर दुसरो मानूस लाय अबा भी बिसराम को बेसकुड़ खुल्यो सेत। <verse eid="HEB 4:6" /><verse number="7" style="v" sid="HEB 4:7" />एकोलाय परमेस्वर ना मंग एक खास दिवस पक्को करयो। अना वोला नाव दियो “आज” काही साल बितन को मघा दाऊद लक परमेस्वर ना वोना दिवस को बारे मा गीरंथ मा कह्यो होतो। “जोनको बारे मा अमी अबा कव्हसेजन।” अदी आज वोको आवाज आयको, “तो आपरो मनला निठ्ठूर नोको करो।”<verse eid="HEB 4:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="HEB 4:8" />काहेका अदी यहोसु ना उनला बिसराम दियो होतो। तो उ एको मघा आवनवालो कोनी अखीन दिवस को चरचा नही करतो। <verse eid="HEB 4:8" /><verse number="9" style="v" sid="HEB 4:9" />एकोलाय परमेस्वर को लोकगीन को लाय अबा भी बिसराम को दिवस बाकी सेत। <verse eid="HEB 4:9" /><verse number="10" style="v" sid="HEB 4:10" />काहेका जोन कोनी परमेस्वर को बिसराम मा धसा सेत, आपरो काम ले बिसराम पाय जावासते। वसोच जसो परमेस्वर ना आपरो काम लक पाय गयो। <verse eid="HEB 4:10" /><verse number="11" style="v" sid="HEB 4:11" />एकोलाय, आमी भी वोना बिसराम को जघा मा धसनो काजी भीड़यो रव्हो। कहि असो ना होहे की वसोच हुकूम नही मानन को कारन, कोनी मानूस गडढा मा पड जाय।<verse eid="HEB 4:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="HEB 4:12" />काहेका परमेस्वर को बचन जित्तो, अना ताकतवर, अना कोनी भी दुइ धारवालो तरवार लक पैनो सेत। उ जान मन जोड अना मास ला आर को पार छेदन लायक सेत, अना मनको बिचार अखीन भावना ला परखसेत। <verse eid="HEB 4:12" /><verse number="13" style="v" sid="HEB 4:13" />परमेस्वर लक कोनी भी चीज लुको नाहती। वोको डोरा को सामोर सब काही उघड़ो सेत। वोकोच लेखा अमी ला देवनो सेत।<verse eid="HEB 4:13" /></para>
  <para style="s">मोठो याजक यीसु</para>
  <para style="p">
    <verse number="14" style="v" sid="HEB 4:14" />परमेस्वर को टूरा यीसु आमरो मुखिया याजक से। जोन सरग लक आयो से, अना लवट गयो। एकोलाय अमी आपरो बिस्वास को बचन ला मजबूती लक धरयो रहबीन। <verse eid="HEB 4:14" /><verse number="15" style="v" sid="HEB 4:15" />काहेका आमरो मुखिया याजक असो नाहती का आमरो कमजोरी मा अमी लक दुहुर भयी जाय। काहे का पाप ला सोड़ के सब गोस्टी मा आमरो जसो परखो गयो सेत। पर उ बेकसूर हिटयो। <verse eid="HEB 4:15" /><verse number="16" style="v" sid="HEB 4:16" />एकोलाय आमी पूरो भरोसा को संग, किरपा को सिघासन को जवर जाबिन, जोनलक अमीला दया भेटेत। यो आमरो जरुरत मा आमरो सायता करहेत।<verse eid="HEB 4:16" /></para>
  <chapter eid="HEB 4" />
  <chapter number="5" style="c" sid="HEB 5" />
  <para style="p">
    <verse number="1" style="v" sid="HEB 5:1" />हरेक महायाजक मानुसगिन लक लियो जावासेत। अना मानूसगिन को कन लक, परमेस्वर को बारे मा काम करासेत। वोला एकोलाय ठहरायो जासे का पाप को भेट अना बली दुई चघाय। <verse eid="HEB 5:1" /><verse number="2" style="v" sid="HEB 5:2" />काहेकी वा खुद च कमजोरी लक घिरो रव्हसेत। यो काजी वा अगियानी अना भुलो भटको को संग सहनभुती को बरताव करे। <verse eid="HEB 5:2" /><verse number="3" style="v" sid="HEB 5:3" />एकोलाय वोला आपरो पापगिन लाय अना वसोच लोकगिन को लाय पापगिन को बली चघानो पड़ासेत। <verse eid="HEB 5:3" /><verse number="4" style="v" sid="HEB 5:4" />यो मान कोनी ला आपरो आप नही भेटासेत। जब तकन हारून जसो परमेस्वर को कन लक ठैयरायो नही जावासेत।<verse eid="HEB 5:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="HEB 5:5" />असोच मसीह ना भी महायाजक बनन को गौरव स्वता नही लियो।</para>
  <para style="q1" vid="HEB 5:5">बल्कि परमेस्वर ना वोको लक कह्यो,</para>
  <para style="q2" vid="HEB 5:5">“तू मोरो टूरा आस आज मीना तोला जलमायो सेउ ।”<figure style="fig" alt="High priest with his priestly clothes and censer" file="HK00267C.TIF" size="col" copy="Horace Knowles ©" ref="5:5">महायाजक आपरो कपरा अना धुपदानी को संग</figure><verse eid="HEB 5:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="HEB 5:6" />असोच उ अखीन एक जघा मा कव्हसेत,</para>
  <para style="q1" vid="HEB 5:6">“तू मलिकिसिदक को रित लक</para>
  <para style="q2" vid="HEB 5:6">सदा को याजक सेत।”<verse eid="HEB 5:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="HEB 5:7" />यीसु आपरी देह मा रव्हत बेरा, हकल-हकल के अना आसू बोहा-बोहा के परमेस्वर लक पिराथना अना बिनती करीस, अना बिनती, भगती को कारन वोको आयको गई। <verse eid="HEB 5:7" /><verse number="8" style="v" sid="HEB 5:8" />टूरा होवनो को बाउजुद भी वोना दुख उचल-उचल के हुकूम माननो सिकिस। <verse eid="HEB 5:8" /><verse number="9" style="v" sid="HEB 5:9" />अना एक बार पुरो होवन को मघा उन सबको लाय जोन वोको हुकूम मानासेत। उ अमर सूटकारा को ठिकान बन गयो। <verse eid="HEB 5:9" /><verse number="10" style="v" sid="HEB 5:10" />अना परमेस्वर को कन लक मलिकिसिदक को रीत लक वोला महायाजक बनायो गयो।<verse eid="HEB 5:10" /></para>
  <para style="s">भरोसा खंडित करनवारा को बिरोध चीतोनी</para>
  <para style="p">
    <verse number="11" style="v" sid="HEB 5:11" />एको बारेमा आमरो जवर कव्हन लाय लगत सेत मंग समझानो कठीन सेत। काहेका तुम्हरो समज लगत मध्दो सेत। <verse eid="HEB 5:11" /><verse number="12" style="v" sid="HEB 5:12" />सहीमा तुमीला अबा तकन सिक्सक बन जानो होतो। पर तुम्हीला तो अबा कोनी असो मानूस को जरुरत सेत। जोन तुम्हिला नवा सिरो लक परमेस्वर को सिक्सा को सुरुवात को गोस्टी सिकायेत। तुम्हिला बस अबा दूध च पाहीजे, जेवन नही। <verse eid="HEB 5:12" /><verse number="13" style="v" sid="HEB 5:13" />जोन अबा दुध-मुहा लेकरा सेत। वोला नियम को बचन ला चिन्हनो नही आवासेत। <verse eid="HEB 5:13" /><verse number="14" style="v" sid="HEB 5:14" />पर जेवन तो सियानो काजी सेत जोनला खरो-खोटो को गियान सेत।<verse eid="HEB 5:14" /></para>
  <chapter eid="HEB 5" />
  <chapter number="6" style="c" sid="HEB 6" />
  <para style="p">
    <verse number="1" style="v" sid="HEB 6:1" />एकोलाय आव अमी मसीह को बुनियाद को सिक्सा ला सोड़के पक्को बनन को सिक्सा कन बड़बीन। अमीला उन सूरुवाती गोस्टी कन नहि बड़नो सेत। ज सो मरनो कन ले जावन वालो काम, को लाय मन मुरकानो, परमेस्वर पर बिस्वास परमेस्वर में बिस्वास, <verse eid="HEB 6:1" /><verse number="2" style="v" sid="HEB 6:2" />बपतिस्मा को सिक्सा, अखीन हात धरनो, अना मरो हुवो लक जित्तो उठनो, अना न्याव जोनलक आमरो अमर जीवन पक्को होहेत। <verse eid="HEB 6:2" /><verse number="3" style="v" sid="HEB 6:3" />अना अदी परमेस्वर चव्हसेत तो आमी असोच करबीन। <verse eid="HEB 6:3" /><verse number="4" style="v" sid="HEB 6:4" />जोनला एक बार उजाड़ भेटयो सेत, जोन सरग को बरदान चीख लियो सेत। जोन पवितर आतमा को हिस्सादार बन गयोसेत।<verse eid="HEB 6:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="HEB 6:5" />जोन परमेस्वर को बचन को साजरोपन अना आवन वालो जुग को ताकत को अनुभव भय गयो सेत। <verse eid="HEB 6:5" /><verse number="6" style="v" sid="HEB 6:6" />यदि वय भटक जाहिन तो उनला मन मुरकाके लवटानो मुस्किल सेत। उनना जसो आपरो ढंग लक नवा सिरा लक परमेस्वर को टूरा ला मंग कूरूस मा चघायो अना वोको सबको सामोर बेइज्जती करयो।<verse eid="HEB 6:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="HEB 6:7" />जोन जघा मा बार-बार पानी पड़ासेत। धरती बरसात को पानी पिवासेत। तबा जोतन बोवन वारा लाय फायदा होवासेत। मंग धरती झाड़ उपजाय के परमेस्वर को आसिरवाद पावासेत। <verse eid="HEB 6:7" /><verse number="8" style="v" sid="HEB 6:8" />पर अदी उ काँटादार झाड़ उपजान वारा ज़मीन सेत। तो बेकाम अना सापित होवन को कारन, आखीर मा स्तो पेटानो पड़येत।<verse eid="HEB 6:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="HEB 6:9" />मोरो चहेतो भाऊहुन! मंग आमी असोच सांगिसेजन। मंग अमीला पक्को भरोसा सेत। का तुमरो दसा एको लक कही साजरा सेत। अना तुमी मुकती को मारग पर चलासेव। <verse eid="HEB 6:9" /><verse number="10" style="v" sid="HEB 6:10" />परमेस्वर बैईमान नाहती। उ तुमारो काम अना तुमरो पिरेम ला, नही बिसरा सकत। जो तुमी ना वोको नाव को महिमा को लाय करयो सेव। अना पवीतर सन्तगिन को सेवा करासो, अना अबा भी करासो। <verse eid="HEB 6:10" /><verse number="11" style="v" sid="HEB 6:11" />अमी चाव्हसेजन, का तुमरो मा लक हरेक जिंदगी भर असोच कड़ो मेहनत करतो रव्हे। अदि तुम्ही असो करासेव, ता तुम्ही पक्को च जोनको आस राखासेव वोला पाय जाहो। <verse eid="HEB 6:11" /><verse number="12" style="v" sid="HEB 6:12" />तुमी लोक अलाली नोको करो। पर उन लोकगीन को नकल करो। जोन आपरो भरोसा अना धिरज को कारन लक उन चीज गिनला पा रहयो सेत जोनको परमेस्वर वायदा कियो होतो।<verse eid="HEB 6:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="HEB 6:13" />जब अबराहम लक परमेस्वर ना परन कियो होतो। तबा परमेस्वर ना चोवयो, मोरो लक मोठो कोनी नाहती, जेनको मी करिया खाऊ ता वोना आपरो च किरिया खायो। <verse eid="HEB 6:13" /><verse number="14" style="v" sid="HEB 6:14" />अना कव्हयो “मी सच्ची-मुच्ची मा तुम्हिला लगत आसीरवाद देहिन। अना तोरो खानदान को लोकगीन ला बेगिनती कर देहिन।” <verse eid="HEB 6:14" /><verse number="15" style="v" sid="HEB 6:15" />अबराहम ना लगत बेरा तकन धिरज धरन को मघा वायदा को फर पाइस। <verse eid="HEB 6:15" /><verse number="16" style="v" sid="HEB 6:16" />लोक आपरो लक मोठो को नाव को, किरिया खावासेत। अना उनको झगड़ा रार करार को संग, खतम भई जासे। <verse eid="HEB 6:16" /><verse number="17" style="v" sid="HEB 6:17" />एकोलाय जब परमेस्वर ना करार को वारसाना गिन पर। अवर सफा-सफा आपरो करार ला बिना बदले पूरो करनो चव्हत होतो। एकोलाय वोना किरिया खा के करार करीस। <verse eid="HEB 6:17" /><verse number="18" style="v" sid="HEB 6:18" />उ ऐना दुई नही बदलन वारा गोस्टी, मन्जे करिया अना करार, खोटो नही होय सकत। एकोलक अमी जोन परमेस्वर को सरनमा सेत। अमीला असो लगासेत का आमरो आस बिलकुल सही सेत। <verse eid="HEB 6:18" /><verse number="19" style="v" sid="HEB 6:19" />यो आस आमरो आतमा को लाय एक मजबूत लंगर को जसो सेत। जोन पड़दा को वोनागन भीतर सरग को मंदिर मा पहुचावा सेत। <verse eid="HEB 6:19" /><verse number="20" style="v" sid="HEB 6:20" />जहान यीसु आमरो सब लक पहेलो दूत को रूप मा धस चुकयो सेत। काहेका उ मलिकिसिदक को जसो सदा को काजी महायाजक बन गयो सेत।<verse eid="HEB 6:20" /></para>
  <chapter eid="HEB 6" />
  <chapter number="7" style="c" sid="HEB 7" />
  <para style="s">मलिकिसेदक याजक</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 7:1" />यो मिलिकिसिदक सालेम को राजा होतो। अना सब लक मोठयो परमेस्वर को याजक होतो। जब अबराहम राजागीन ला मार के लवट रहयो होतो। ता उ अबराहम लक मिलयो अना वोला आसीरवाद दियो। <verse eid="HEB 7:1" /><verse number="2" style="v" sid="HEB 7:2" />अबराहम ना सब चीज को दसवा अंस दियो। मलकीसेदेक को मजे “धरमी राजा”। उ सालेम को भी राजा से। मन्जे “सान्ती को राजा।” <verse eid="HEB 7:2" /><verse number="3" style="v" sid="HEB 7:3" />उ राजा को न तो अजी सेत, ना माय सेत, अना कोनी खानदान सेत। वोको जिंदगी को नातो सुरुवात से, ना आखीर सेत। उ परमेस्वर को टूरा जसो सेत। अना उ हमेसा लक याजक बनो रव्हासेत।<verse eid="HEB 7:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="HEB 7:4" />अबा तुमी यो विचार करो का, मलकीसेदेक कीतरो महान सेत। जोनला आजा-पुरखा अबराहम ना आपरो लूट को, सब लक साजरा हिस्सा को, दसवा हिस्सा दियो। <verse eid="HEB 7:4" /><verse number="5" style="v" sid="HEB 7:5" />मोसे को नियम अनुसार लेवी को सन्तान गिनमा जोन याजक पद पावत होतिन। उनला च अबराहम को खानदानी आपरो भाऊ गीन लक दसवा हिस्सा लेवन को हुकूम होतो। <verse eid="HEB 7:5" /><verse number="6" style="v" sid="HEB 7:6" />मंग मिलिकिसिदक ना, जोन लेवी को खानदानी नहीं होतो। अबराहम लक दसवा हिस्सा लियो। अना वोना अबराहम ला आसीरवाद दियो। अखीन जोनको जवर परमेस्वर को करार होतो। <verse eid="HEB 7:6" /><verse number="7" style="v" sid="HEB 7:7" />यो गोस्टी मा कोनी सक नाहती का जोन आसीरवाद देवासेत। उ आसीरवाद लेवन वालो लक मोठो होवासेत। <verse eid="HEB 7:7" /><verse number="8" style="v" sid="HEB 7:8" />गिरंथ कव्हसेत का जोन दसवा हिस्सा लेवासेत उ हरामेसा जित्तो रव्हसेत। मंग जोन लेवीगिन दसवा हिस्सा लेवा सेत, वय सब मरनवालो सेत। <verse eid="HEB 7:8" /><verse number="9" style="v" sid="HEB 7:9" />तो अमी यो कव्ह सकसेत का दसवा अंस लेवनवारा लेवीगिन ना मलिकिसिदक ला अबराहम लक दसवा अंस दियो। <verse eid="HEB 7:9" /><verse number="10" style="v" sid="HEB 7:10" />काहेका वोना बेरा मा वय आपरो अजी अबराहम को देहमा होतीन। जबा अबराहम ना मलिकिसिदक ला भेट दियो होतो।<verse eid="HEB 7:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="HEB 7:11" />इसरायली जनता ला लेवी गिनको याजक को आधार मा, नियम मिलयो होतो। यदी यो याजकपन को लक पूरो भयी जातो। मंग एक दुसरो याजक को चरचा कायको लाय कियो जातो। जोन हारून को खानदान लक नही, बल्की मलिकिसिदक को जसो आ जाय। <verse eid="HEB 7:11" /><verse number="12" style="v" sid="HEB 7:12" />जबा मोठो याजक बदल गयो तो नियम बदलनो जरुरी सेत। <verse eid="HEB 7:12" /><verse number="13" style="v" sid="HEB 7:13" />यो गोस्टी जोन याजक को बारेमा कव्हयो गयो सेत, उ दुजो खानदान को सेत। अना उ खानदान को कोनी मानूस ला वेदी को सेवा को हक नही मिलयो सेत। <verse eid="HEB 7:13" /><verse number="14" style="v" sid="HEB 7:14" />काहेका यो गोस्टी सफा सेत, का आमरो पिरभू यीसु यहूदा कुर लक सेत। अना मोसे ना यो कुर को याजक पद को बारेमा काही चरचा नही करयो सेत।<verse eid="HEB 7:14" /></para>
  <para style="s">मलिकसेदक जसो याजक कोनी नाहती</para>
  <para style="p">
    <verse number="15" style="v" sid="HEB 7:15" />आमरो दावा अखीन साफ भई जासेत, जबा मलिकिसिदक को जसो अखीन एक याजक पैदा हो जासेत। <verse eid="HEB 7:15" /><verse number="16" style="v" sid="HEB 7:16" />जोन देह को हुकूम को नियम लक नाहती। पर कदी नास नही होवनवारा जिंदगी, को ताकत को लक ठहरायो गयो सेत। <verse eid="HEB 7:16" /><verse number="17" style="v" sid="HEB 7:17" />काहेका वोको बारेमा असो गवाही लिखयो सेत। “तू मलिकिसिदक को रित मा सदा को याजक सेत।” <verse eid="HEB 7:17" /><verse number="18" style="v" sid="HEB 7:18" />असो पहेलो हुकूम कमजोर अना बेफर होवन को कारन मीट गयो। <verse eid="HEB 7:18" /><verse number="19" style="v" sid="HEB 7:19" />काहेका नियम काही पूरो नही कर सकयो। सब को सब अधुरो सेत, तबा अमीला एको लक साजरा आस दियो गयो सेत। अना एको कन लक आमी परमेस्वर को कठा पहुच सकासेजन।<verse eid="HEB 7:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="HEB 7:20" />यो वादा को सगं च यीसु ला ठहरायो गयो। जबकि वय बीन करार को याजक ठैयरायो गयो। <verse eid="HEB 7:20" /><verse number="21" style="v" sid="HEB 7:21" />काहेका मसीह को ठहरायो जानको बेरा पिरभू परमेस्वर ना किरिया खाई होती। “जसो का पवीतर गिरथ कव्हसेत।”</para>
  <para style="q1" vid="HEB 7:21">पिरभु ना करार कियो से,</para>
  <para style="q2" vid="HEB 7:21">मंग उ ना ओकोलक पस्तावा करेत,</para>
  <para style="q1" vid="HEB 7:21">की तू सदा लक याजक बनो रव्हजोस।<verse eid="HEB 7:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="HEB 7:22" />असो आमी चोवा सेजन का यीसु जोन नियम को करार लेवासेत। उ कही जादा साजरा सेत।<verse eid="HEB 7:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="HEB 7:23" />एको अलावा पयले को याजक लगत गिनतीमा ठहरायो जावत होतो। काहेका मरनो को कारन जादा बेरा लक याजक पदमा बनयो रव्हनो मुस्किल होतो। <verse eid="HEB 7:23" /><verse number="24" style="v" sid="HEB 7:24" />पर यीसु सदा लक बनयो रव्हन वालो याजक सेत। एकोलाय वोको याजकपद कोनी को नाहती, पर हमेसा वोकोच सेत।<verse eid="HEB 7:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="HEB 7:25" />योच कारन सेत का जोन लोक गीन यीसु लक परमेस्वर को सरन लेवासेत वा उनला पूरो रित लक बचावनो को ताकत राखासेत। काहेका उ उनको कन लक बिनती करन काजी हमेसा लक जित्तो सेत। <verse eid="HEB 7:25" /><verse number="26" style="v" sid="HEB 7:26" />अबा अमीला असो महायाजक मिलयो सेत। जोन एक पवीतर, निरदोस, बेदाग, पापगिन लक बेगरो, अना सरग लक वरता होयेत। यो गोस्टी सहीच होत्यो। <verse eid="HEB 7:26" /><verse number="27" style="v" sid="HEB 7:27" />पर जोन दुसरो महायाजक गीन, पयले आपरो पाप को काजी, मंग परजा को पाप को काजी हर रोज बली चघावसेत। पर यीसु ला एको जरुरत नाहती। काहेका वोना यो काम हमेसा लाय, एक च बार मा कर डाखिसेस। जबा वोना आपरो बली चघायो। <verse eid="HEB 7:27" /><verse number="28" style="v" sid="HEB 7:28" />काहेका मोसे को नियम तो कमजोर मानूस ला महायाजक ठैयरावा सेत। पर नियम खतम होवन को मघा, परमेस्वर को करार लक उ टूरा महायाजक ठैयरावो जावासेत, जोन सदा को लाय पूरो सिध्ध बना दियो गयो सेत।<verse eid="HEB 7:28" /></para>
  <chapter eid="HEB 7" />
  <chapter number="8" style="c" sid="HEB 8" />
  <para style="s">यीसु आमरो मोठो याजक</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 8:1" />यो गोस्टी को सार यो सेत का, आमरो एक असो महायाजक सेत। जोन सरग मा मोठो गौरव को काबिल परमेस्वर को सिघासन को उजो कन बिराजमान भई गयो। <verse eid="HEB 8:1" /><verse number="2" style="v" sid="HEB 8:2" />वोना सही अना पवीतर जघा अना तम्बु को सेवक सेत। जोन मानूसगिन को लक नही, पर परमेस्वर लक स्थापित कियो गयो सेत।<verse eid="HEB 8:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="HEB 8:3" />हरेक महायाजक बली चघाव, अना भेट चघान को लाय ठहरायो सेत। एकोलाय यो जरुरी सेत का वोको जवर चघान काजी काही ना काही हो। <verse eid="HEB 8:3" /><verse number="4" style="v" sid="HEB 8:4" />अदी यीसु धरती मा रव्हतो तो उ याजक भी नही होतो। काहेका मोसे को नियम लक भेट चघान को लाय याजक सेत। <verse eid="HEB 8:4" /><verse number="5" style="v" sid="HEB 8:5" />पवितर आरधना को जघा, उनको सेवा सरग को सही गोस्टी को सावली सेत। एकोलाय जबा मोसे पवितर तम्बू ला बनावन वालो होतो। तबा च वोला चितायो गयो होतो। “धियान रव्हे का तू हरेक चीज ठीक वोको च नकल करजोस जोन तोला पहाड़ी मा दिसायो होतो।” <verse eid="HEB 8:5" /><verse number="6" style="v" sid="HEB 8:6" />अबा जोन सेवा मसिहा ला भेटयो से, वा कहीं जादा वरता सेत। काहेका उ एक असो करार को बिचवई सेत। जोन जादा लक जादा से, अना वा साजरा वायदा पर अधारित सेत।<verse eid="HEB 8:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="HEB 8:7" />अदी पहेलो करार साजरो होतो। तो वोको जघा मा दुसरो को का जरुरत सेत? <verse eid="HEB 8:7" /><verse number="8" style="v" sid="HEB 8:8" />परमेस्वर उन लोकगीन को निंदा करतो हुया कव्हसेत</para>
  <para style="q1" vid="HEB 8:8">“पिरभू यो कव्हसेत, वा दिवस आवासेत जबा मी इसरायल को घराना</para>
  <para style="q2" vid="HEB 8:8">अना यहूदा को घराना काजी एक नवा करार स्थापित करुहू।<verse eid="HEB 8:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="HEB 8:9" />यो वोना विधान को जसो नाहती,</para>
  <para style="q2" vid="HEB 8:9">जोनला मी उनको आजा बाबा को लाय वोना बेरा दियो होतो।</para>
  <para style="q1" vid="HEB 8:9">जबा मीना उनला मिसर देस लक हेडन काजी उनको हात धरयो होतो।” पिरभू असो कव्हसेत “उनना मोरो करार लक हट गईन। वोको पालन नही करीन,</para>
  <para style="q2" vid="HEB 8:9">यो काजी मीना भी उनला तज दियो।<verse eid="HEB 8:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="HEB 8:10" />पिरभू असो कव्हसेत, वा बेरा बितन को मघा मी इसरायल को लाय यो करार करहू।</para>
  <para style="q2" vid="HEB 8:10">मी आपरो नवा करार,</para>
  <para style="q1" vid="HEB 8:10">उनको मन मा ठेव देहू,</para>
  <para style="q2" vid="HEB 8:10">अना उनको दिलमा लिख देहू।</para>
  <para style="q1" vid="HEB 8:10">मी उनको परमेस्वर होहुँ,</para>
  <para style="q2" vid="HEB 8:10">अना वय मोरी परजा होहेत।”<verse eid="HEB 8:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="HEB 8:11" />यो जरुरी नाहती का एक मानूस दुसरो ला सिक्सा देवे।</para>
  <para style="q2" vid="HEB 8:11">मजे भाऊ एक दुजो ला सागेत</para>
  <para style="q2" vid="HEB 8:11">“पिरभू को गियान ले लेव।</para>
  <para style="q1" vid="HEB 8:11">काहेका लहान अना मोठो सबको सब ला</para>
  <para style="q2" vid="HEB 8:11">मोरो बारे मा पता चल जाहेति।”<verse eid="HEB 8:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="HEB 8:12" />काहेका मी उनको बदी को बारे मा दयावन्त रहू</para>
  <para style="q2" vid="HEB 8:12">अना उनको पाप ला कदी हेत नही करू।<verse eid="HEB 8:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="HEB 8:13" />नवा करार आन के पहेलो करार ला जूनो ठहरा दियो सेव। अना जोन चीज जुनो अना जर-जर हो जासे वोको मिट जानो जरुरि सेत।<verse eid="HEB 8:13" /></para>
  <chapter eid="HEB 8" />
  <chapter number="9" style="c" sid="HEB 9" />
  <para style="s">संसारीक अना सरगीय अराधना</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 9:1" />अबा आयको, पहेलो करार मा भी सेवा को बारेमा हुकूम होतो, अखिन एक मानूस को हात को बनयो, आपरो अराधना को पवीतर जघा होतो। <verse eid="HEB 9:1" /><verse number="2" style="v" sid="HEB 9:2" />एक तम्बु उभो कर दियो गयो। वोको पुड़ा खोली मा टवरी राखन को चीज टेबिल मा होतो। अना चढावा को भाकर होति, वा पवीतर जघा कहलात होतो। <verse eid="HEB 9:2" /><verse number="3" style="v" sid="HEB 9:3" />तम्बु मा दुसरो पड़दा को मघा को खोली, परम पवीतर जघा कहलात होतो। <verse eid="HEB 9:3" /><verse number="4" style="v" sid="HEB 9:4" />उता धुपदान को सोनो को वेदी, अना करार को सोनो मढो मन्जुसा होति। अना मन्जुसा मा सोना को कटोरा मा मन्ना होती। हारून को छड़ी जोन मा फर लग गयो होती, उ भी वोच जघा मा होती। अना कानून को गोटा को पटिया होति। <verse eid="HEB 9:4" /><verse number="5" style="v" sid="HEB 9:5" />अना मन्नजुसा को वरता दया को आसन ला ढाकन वारा महिमा मय करुब होतिन। ऐना सबको बारे मा लम्बो चौड़ो लिखन को कोनी जरुरत नाहती।<figure style="fig" alt="Interior of tabernacle" file="BK00278C.TIF" size="span" copy="Horace Knowles ©" ref="9:2">आराधना लय को तंबू को भितर को हिस्सा</figure><verse eid="HEB 9:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="HEB 9:6" />परमेस्वर ना असो च तम्बु मा अराधना को जघा बनान ला कव्हयो होतो। सेवा को बिधी बिधान करन काजी याजक हरेक बेरा पुड़ा को खोली मा जात होतो। <verse eid="HEB 9:6" /><verse number="7" style="v" sid="HEB 9:7" />पर महायाजक साल मा एकच बार दुसरो खोली मा, रकत लेके जावत होतो। जोनला वो आपरो पाप अना जनता को पाप छिमा काजी चघावत होतो। <verse eid="HEB 9:7" /><verse number="8" style="v" sid="HEB 9:8" />एकोलक पवीतर आतमा, तम्बु मा यो दिसानो चाव्हसेत, का जबा तकन वोको पुड़ा पवीतर जघा उभो सेत। तबा तकन दुसरो खोली को रस्ता बंद सेत। <verse eid="HEB 9:8" /><verse number="9" style="v" sid="HEB 9:9" />उ तम्बू आज को बेरा मा एक उदाहरन सेत। जोन मा असो चघावा अना बली चघायो जावासेत। जोन लक अराधना करनवालो को मन सिध्द नही होवा सेत। <verse eid="HEB 9:9" /><verse number="10" style="v" sid="HEB 9:10" />काहेका वय बस जेवन-वेवन को चीज अना रकम-रकम को आँग धोवनो सेत। जोन हुकूम वोना बेरा मा देह को सुधार को लाय ठहरायो गयो होतो।<verse eid="HEB 9:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="HEB 9:11" />पर जबा मसिहा आवनवारा साजरो-साजरो चीज को महायाजक बनके आयो। अखीन मोठो अना सिध्द तम्बु लक होयके आयो। जोन हात को बनयो यो दुनिया को नाहती। <verse eid="HEB 9:11" /><verse number="12" style="v" sid="HEB 9:12" />अना बोकरा अना नाटा को रकत लक नही, पर आपरो च रकत लेके, एक च बार, पवीतर जघा मा धस गयो। अना अमरता को सूटकारा मिल गयो से। <verse eid="HEB 9:12" /><verse number="13" style="v" sid="HEB 9:13" />काहेकि जबा बकरा गीन अना बैइल बछेरु को रकत, अना कलोर को राख, असुध्द लोकगीन पर छिड़को जानो, उनको देह ला, सुधद करन को लाई उनला पवीतर करासे। <verse eid="HEB 9:13" /><verse number="14" style="v" sid="HEB 9:14" />मग मसीह को रकत, जोन ना अपरो आप ला अमर आतमा लक, बेकसूर बली को रूप मा परमेस्वर ला दे दियो। आमरो मन ला मरो हुवो काम लक, काहे पवीतर नही करयेत। अना अमला जित्तो परमेस्वर को काबिल काहे नही बनाहेत।<verse eid="HEB 9:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="HEB 9:15" />मसीह पहेलो करार को भितर, कियो गयो गुनाह, को छिमा को लाय मर गयो सेत। अना अबा उ एक नवा करार को बिचवई से। परमेस्वर जोन ला हाकल सेत, उनला अबा वोको करार लक अमर काल तकन सूटकारा को हक मिलासेत।<verse eid="HEB 9:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="HEB 9:16" />करार को बारे मा करार करनवारा को मिरतू को परमान पतर देवनो पड़सेत। <verse eid="HEB 9:16" /><verse number="17" style="v" sid="HEB 9:17" />काहेकि असो करार मरनोच पर पक्को होवासेत। अना जबा तकन करार बाँधनवालो जित्तो रव्हसे, तबा तकन इकरार नामा कोनी काम को नाहती। <verse eid="HEB 9:17" /><verse number="18" style="v" sid="HEB 9:18" />एकोलाय रकत को बिना पहेलो करार को सुरुवात नही भयो होतो। <verse eid="HEB 9:18" /><verse number="19" style="v" sid="HEB 9:19" />काहेका जब मोसे ना सारो जनता को पुड़ा करार को किताब को सबा हुकूम ला पढ़के आयकाईस। तो वोना पानी, लाल चोगा, अना जूफा को संग बछिया अना बोकरा को रकत लियो। अना वोला पवीतर गिरथ अना सप्पा जनता पर छिड़क हुया, <verse eid="HEB 9:19" /><verse number="20" style="v" sid="HEB 9:20" />उ ना हुकूम दियो होतो। यो वोना करार को रकत सेत। जोनला परमेस्वर ना तुमरो लाय ठेविसेस। <verse eid="HEB 9:20" /><verse number="21" style="v" sid="HEB 9:21" />मोसे ना तम्बु अना सेवा मा लगनवारा सबा बरतन पर भी, रकत छिड़क दियो होतो। <verse eid="HEB 9:21" /><verse number="22" style="v" sid="HEB 9:22" />करार को लक हमेसा, सबा काही खून को बव्हनो लक पवीतर कियो जावत होतो। अना रकत को बिना छिमा नही मिलासेत।<verse eid="HEB 9:22" /></para>
  <para style="s">पाप को लाय यीसु को बली</para>
  <para style="p">
    <verse number="23" style="v" sid="HEB 9:23" />जोन सरग को चीज गीन को बस सावली होती। अदी उनको सुध्द होवन काजी असो नेम जरुरी होतो। तो खुद सरग को चीजगिन ला सूद्द करन काजी, एक साजरा लक साजरा बली तो जरुरी च सेत। <verse eid="HEB 9:23" /><verse number="24" style="v" sid="HEB 9:24" />मसीह हात को बनयो हुया वोना पवीतर जघा मा नही धसयो। जोन सही को पवीतर जघा को सावली सेत। वोना सिद्दो सरग मा च धसयो। जोन लक मसीह अबा आमरो कन लक सरग मा परमेस्वर को कठा हाजिर हो सके। <verse eid="HEB 9:24" /><verse number="25" style="v" sid="HEB 9:25" />यहान को तम्बू को महायाजक कोनी दुसरो को रकत आन के हर साल पवीतर जघा मा धसत होतो। पर मसीह ला बार-बार आपरो आप ला चघान को जरुरत नहती। <verse eid="HEB 9:25" /><verse number="26" style="v" sid="HEB 9:26" />अदी असो होतो, तो दुनिया को सुरुवात लक वोला बार-बार दुख उठानो पड़तो। पर अबा जुग को आखीर मा एक च बार परगट भयो। जोको लक खुद को बली देके पाप ला मिटा देवे। <verse eid="HEB 9:26" /><verse number="27" style="v" sid="HEB 9:27" />जसो मानूस को लाय एक बार मरनो, अना एको मघा उनको नियाव होवनो लेखा सेत। <verse eid="HEB 9:27" /><verse number="28" style="v" sid="HEB 9:28" />वसोच मसीह, लगत लोकगीन को पाप लक मुकती काजी, एकच बार आपरो आप ला चघा दियो। मसीह अबा दूसरो बार परगट होयेत। पाप को कारन नही, पर जोन लोक वोको रस्ता चोवासेत। उनला मुक्ती दिलावन आहेत।<verse eid="HEB 9:28" /></para>
  <chapter eid="HEB 9" />
  <chapter number="10" style="c" sid="HEB 10" />
  <para style="s">एकच मोठो बली</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 10:1" />काहेका करार, जोनमा आवन वारा साजरो चीज को छाप सेत। पर उ असल नाहती, एकोलाय वय लोकगीन एक जसो बलिदान हर साल बिना चूके चघाव सेत। पर उ जवर आवनवारा ला सिध्द नही बना सकेत। <verse eid="HEB 10:1" /><verse number="2" style="v" sid="HEB 10:2" />नही तो उनको चघानो काय लाय बंद नही होवा सेत। यदि सेवा करन वालो को मन एकच बार मा पवीतर भई जासेत। तो बार-बार अखीन बली चघानो जरूरी नाहती। अना उनको मन उनला बारम्बार पाप मा नही ठहरायती। <verse eid="HEB 10:2" /><verse number="3" style="v" sid="HEB 10:3" />पर वय हर साल पाप ला हेत करासेत। <verse eid="HEB 10:3" /><verse number="4" style="v" sid="HEB 10:4" />काहेका बकरा अना बैइल को रकत मानूस को पाप ला दुहुर नही करासेत।<verse eid="HEB 10:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="HEB 10:5" />योच कारन दुनिया मा आवन को बेरा असो कव्हसेत।</para>
  <para style="q1" vid="HEB 10:5">“बली अना चढावा तू नही चाव्हसेत</para>
  <para style="q2" vid="HEB 10:5">पर मोरो काजी एक देह तैय्यार कियो गयो सेत।<verse eid="HEB 10:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="HEB 10:6" />जनावर को बली अना होमन पाप बली चढावा लक</para>
  <para style="q2" vid="HEB 10:6">तू खूसी नही होवासेत<verse eid="HEB 10:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="HEB 10:7" />मोरो बारे मा पवीतर किताब को एक हिस्सा मा असो लिखयो सेत</para>
  <para style="q2" vid="HEB 10:7">तबा मीना कव्हयो चोव मी आवासू</para>
  <para style="q2" vid="HEB 10:7">जेनको लक परमेस्वर को मनसा पूरो करू।”<verse eid="HEB 10:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="HEB 10:8" />मोसे को नियम मा वरता तो असो कव्हसेत “हे भगवान बलीदान तोरो काजी चघायो जावासेत पर वोको लक भी तू खूस नहास तोला पाप बली होम बली अना भेंट बलिदान काही नही पाहिजेत।” <verse eid="HEB 10:8" /><verse number="9" style="v" sid="HEB 10:9" />मग उ असो भी कव्हसेत, चोव! “मी तोरो मनसा पूरो करन काजी आवासू। असो परकार उ पहेलो करार ला रद्द करासेत, अना दुसरो ला चलावसेत।” <verse eid="HEB 10:9" /><verse number="10" style="v" sid="HEB 10:10" />“वोच भगवान को मनसा को लक, यीसु मसीह को देह ला एकच बार चघानो लक पूरो भयो, अना आमी सब पवीतर भई गईन”। <figure style="fig" alt="Burnt offering on an altar" file="HK00256C.TIF" size="col" copy="Horace Knowles ©" ref="10:10">होमन कुन्ड मा होमबलि</figure><verse eid="HEB 10:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="HEB 10:11" />हरेक याजक तो उभो भयके हर रोज सेवा करासेत, अना बार-बार एकच बली ला चघाव सेत। जोन कदी पाप लक दुहुर नही कर सका सेत। <verse eid="HEB 10:11" /><verse number="12" style="v" sid="HEB 10:12" />पर यो मानूस तो पाप को एवज मा हमेसा काजी एकच बलिदान चघायके परमेस्वर को जेवनो कन बस गयो। <verse eid="HEB 10:12" /><verse number="13" style="v" sid="HEB 10:13" />जहान यीसु यो बात को लाय बाट चोव रहयो सेत का वोको बैरी वोको पाय को पीढ़ो कब बनहेती <verse eid="HEB 10:13" /><verse number="14" style="v" sid="HEB 10:14" />काहेका वोना एकच बार चढावा चघाके जोन पवीतर कियो जानो सेत उनला हमेसा काजी सिध्द बना दियो।<verse eid="HEB 10:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="HEB 10:15" />एको बारेमा पवीतर आतमा को गवाही आमरो कठा सेत काहेका पवीतर गिरथ मा पिरभू असो कव्हसेत<verse eid="HEB 10:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="HEB 10:16" />“बेरा आवनो पर,</para>
  <para style="q2" vid="HEB 10:16">मी उनको लक नवा करार करहू पिरभू कव्हसेत,</para>
  <para style="q1" vid="HEB 10:16">मी आपरो नियम उनको मन मा राखू,</para>
  <para style="q2" vid="HEB 10:16">अना उनको दिल मा लिखू।”<verse eid="HEB 10:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="HEB 10:17" />मंग उ असो भी कव्हसेत “मी उनको पाप हुन ला अना उनको खोटो करम अधरम को काम ला कदी हेत नही करीन।” <verse eid="HEB 10:17" /><verse number="18" style="v" sid="HEB 10:18" />अना जबा इनको पाप छिमा भई गई सेत, तो मंग पाप को बली नही रहयो<verse eid="HEB 10:18" /></para>
  <para style="s">आमी भरोसा आन कन परमेस्वर को कठा आवबिन</para>
  <para style="p">
    <verse number="19" style="v" sid="HEB 10:19" />अगो भाऊ अना अवो बहिनहुन, अबा अमीला पूरो भरोसा भई गयो सेत का आमी यीसु को रकत लक पवीतर जघा मा धस सकसेत। <verse eid="HEB 10:19" /><verse number="20" style="v" sid="HEB 10:20" />यीसु ना आमरो काजी जित्तो अना नवा रस्ता हेड़ ख दियो सेत। जोन वोको देह रुपी पड़दा लक होयके जावासेत। <verse eid="HEB 10:20" /><verse number="21" style="v" sid="HEB 10:21" />अबा आमरो कठा एक महान याजक सेत जो परमेस्वर को घर मा ठहरायो गयो सेत <verse eid="HEB 10:21" /><verse number="22" style="v" sid="HEB 10:22" />एकोलाय आव आमी आपरो दोसी मन ला खरो करन काजी दिलमा छिड़काव करबीन अना आपरो देह ला सफा पानी लक धोवके बेकपट दिल लक पूरो भरोसा लक परमेस्वर को कठा जाबिन। <verse eid="HEB 10:22" /><verse number="23" style="v" sid="HEB 10:23" />आमी आपरो आस को गवाही देवन काजी पक्को अना अटल रहन को परन करिया सेत। काहेका जोन ना अमीला बचन देइसेस वा भरोसा काबिल सेत। <verse eid="HEB 10:23" /><verse number="24" style="v" sid="HEB 10:24" />अमीला यो बात पर धियान देवनो सेत की आमी कसो एक दुसरो ला पिरेम अखीन दुसरो को उपकार काजी उकसात रव्हबिन। <verse eid="HEB 10:24" /><verse number="25" style="v" sid="HEB 10:25" />अना एक दुसरो संग जमा होवनो नोको छोड़ो। जसो कितरो लोकगीन को असोच रित सेत। अना एक दुसरो ला बढ़ावा देवत रव्हो, जसो-जसो विपदा को दिवस जवर आवता चोवो असोच करो।<verse eid="HEB 10:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="HEB 10:26" />काहेका खरो ला जानन को मघा अदी आमी जानबुझके पाप करतो रहबीन तो पाप को लाय कोनी बली बाकी नाहती। <verse eid="HEB 10:26" /><verse number="27" style="v" sid="HEB 10:27" />पर एक खूब भयानक दन्ड बाकी रव्हसेत नियाय को अना एक गजब को स्तो जोन हुकूम नही मानन वालो ला गिटक लेहेत। <verse eid="HEB 10:27" /><verse number="28" style="v" sid="HEB 10:28" />जबा मोसे को नियम नही मनन वारा ला दोन अना तिन झन को गवाही लक बिना दया को मारन लाय हुकूम लिखिसेस <verse eid="HEB 10:28" /><verse number="29" style="v" sid="HEB 10:29" />तो जोनना परमेस्वर को टूरा को हुकूम ला तोड़के वोला आपरो पाय मा खुंदिसेस, अना वोको रकत को करार जोन वोला पवीतर ठहरसेस वोन वोला असुध्द ठहरा देइसेस अना दया को आतमा को अपमान करीसेस वोको काजक हाल होहेत वोला आपरो डिमाक लक सोचो। <verse eid="HEB 10:29" /><verse number="30" style="v" sid="HEB 10:30" />काहेका आमी वोला जानासेजन जोनना कहिसेस “का बदला लेवनो मोरो काम सेत, मीच बदला देहू अना मंग यो का पिरभू आपरो लोकगीन को न्याय करयेत।” <verse eid="HEB 10:30" /><verse number="31" style="v" sid="HEB 10:31" />जित्तो परमेस्वर को हातमा पडनो कितरो भयानक गोस्टी सेत।<verse eid="HEB 10:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="HEB 10:32" />पर तुमी वोना मघा को गोस्टी ला हेत करो। जोन मा तुमी उजाड पाय के दुख अना मोठो विपदा मा पक्को रहयो होतो। <verse eid="HEB 10:32" /><verse number="33" style="v" sid="HEB 10:33" />तुमी लोकगीन मा काही ला सब को चोवत-चोवत बेइज्जती अना अतियाचार सहनो पडयो मजे काही को असो हालत को हिस्सादार बननो पडयो। <verse eid="HEB 10:33" /><verse number="34" style="v" sid="HEB 10:34" />तुमीना आपरो जोन लोकगीन जेलमा होतिन उनको सुदी लियो अना जबा तुमी लोकगीन को धन जपत कर लियो गयो तो तुमीना हूँ लक चूँ नही कव्हयो, काहेका तुमी जानत होतो का एको लक कही साजरा अना हमेसा को संपति तुमरो कठा सेत। <verse eid="HEB 10:34" /><verse number="35" style="v" sid="HEB 10:35" />एकोलाय तुम लोकगीन आपरो पूरो भरोसा नोको छोडो एको ईनाम मोठो सेत। <verse eid="HEB 10:35" /><verse number="36" style="v" sid="HEB 10:36" />तुम लोकगीन ला धिरज को जरुरत सेत जोन लक परमेस्वर को मनसा पूरो करन को मघा तुमिला वा मिल जाय जोन को वायदा परमेस्वर कर चूकयो सेत। <verse eid="HEB 10:36" /><verse number="37" style="v" sid="HEB 10:37" />काहेका पवीतर गिरथ असो कव्हसेत “जोन आवन वारा सेत उ जरासि बेरा मघा आहेत उ उसीर नही करयेत। <verse eid="HEB 10:37" /><verse number="38" style="v" sid="HEB 10:38" />पर मोरो न्यायी जन भरोसा लक जित्तो रहेत, अना उ मघा हट जाय तो मोरो मन वोको लक खूसी नही होयेत।” <verse eid="HEB 10:38" /><verse number="39" style="v" sid="HEB 10:39" />पर आमी हटनवालो नही का नास भई जाबिन पर भरोसा राखनवारा सेत का आपरो जानला बचाबिन।<verse eid="HEB 10:39" /></para>
  <chapter eid="HEB 10" />
  <chapter number="11" style="c" sid="HEB 11" />
  <para style="s">भरोसा</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 11:1" />बिस्वास मन्जे जोन आस अमी करे सेजन, वोको लाय पक्को होवनो। अना अमी जोन गोस्टी ला नही चोवासेजन। पर वोको खातिर निस्चित होवनो ला बिस्वास कव्हसेत। <verse eid="HEB 11:1" /><verse number="2" style="v" sid="HEB 11:2" />एकोलाय जूनो जमाना मा लोकगिन परमेस्वर को मान भेटयो।<verse eid="HEB 11:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="HEB 11:3" />बिस्वास को कारन अमीला समजमा आवासेत, का यो जगत ला, परमेस्वर ना सबद लक बनायो सेत। यासाठी जोन-जोन दिसासेत, वा जेन दिसत नाही, वोको पासुन बनायो गयो सेत।<verse eid="HEB 11:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="HEB 11:4" />हाबिल को बिस्वास को कारन काईन को लक साजरा बलिदान परमेस्वर ला देइसेस। वोको छय को कारन वोको देवन को परसंसा भयी उ नेक मानुसमा आदरनीय होता। अना बिस्वास को कारन उ अजून च मरन को तरी च बोलासेत। <verse eid="HEB 11:4" /><verse number="5" style="v" sid="HEB 11:5" />हनोक ला मरनार नाही यो गोस्टी मा बिस्वास होता। वोना ऐवज मा वोला परमेस्वर आपरो संग लेगयो। परंतु कोनीच वोला सापड़ा नहि सक्यो, यो कारन लक वोला लेजात होतिन। पवितर गींरथ सांग सेत का हनोक ला लेजावन को पयले वोना परमेस्वर ला खुस करयो। <verse eid="HEB 11:5" /><verse number="6" style="v" sid="HEB 11:6" />अना बिस्वास को सिवाय कोनी गोस्टी लक परमेस्वर ला खुस नही कर सकत। कारन हरेक झन जोन वोको जवर आवासे, वोला असा बिस्वास होवनो जरूरी सेत। का परमेस्वर सेत, अना जोन वोला सच्चो लक तपासन वालो ला वोको जवाब देवासेत।<verse eid="HEB 11:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="HEB 11:7" />बिस्वास को च कारन लक नूह ला भबिस्य मा घटनवालो घटना को बारे मा परमेस्वर को इसारा ला समजयो, अना जोन ला तो चोव सकत नहोती। वा परमेस्वर को हुकूम ला मानयो अना एक जहाज नाव बनायो, ज्यामध्ये उ अना वोको कुटुंब वाचले। एको परिनाम असा भयो की, जघा को निंदा भयो। अना बिस्वास लक नूह ला परमेस्वर जवर ला नेक मानूस ठैरायो गयो। <verse eid="HEB 11:7" /><verse number="8" style="v" sid="HEB 11:8" />बिस्वास को कारन को कारन अबराहम ला असो सांगयो का वोला जोन जघा मा जावन साठी परात जानको होतयो, पर उ कितानी जात होता उनला मालूम नही होता। तरी उ ना हुकूम मानयो अना गयो। <verse eid="HEB 11:8" /><verse number="9" style="v" sid="HEB 11:9" />बिस्वास को कारन जोन धरती को वायदा कियो गयो होतो। उ धरती मा वय इसहाक अना याकूब तकन परदेसी जसो तम्बू मा रव्हन लगयो। अना वारसाना हक्क नही तजयो। <verse eid="HEB 11:9" /><verse number="10" style="v" sid="HEB 11:10" />अबराहम ना असो करयो, काहेका उ वोना पक्को पाया वालो नगर को बाट चोवत होतिन। जेनको बनान वारा परमेस्वर सेत।<verse eid="HEB 11:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="HEB 11:11" />बिस्वास को कारन च, अबराहम बूड़गा भयी गयो होतो। अना सारा वाखड़ होती। जोनना बचन दियो होतो। वोको पर बिस्वास करके पोट लक भयी अना अबराहम बाप बना दियो। <verse eid="HEB 11:11" /><verse number="12" style="v" sid="HEB 11:12" />अखिन असो परकार यो एका मानूस पासुन जोन मरियल सारखा होता। बादल को तारागिन अना सागर कगर को रेत जसो बेगिनत अवलाद भयी। <verse eid="HEB 11:12" /><verse number="13" style="v" sid="HEB 11:13" />बिस्वास ला आपरो मनमा ठेयके लोकगिन मरन पाय लियो। पर बचन दियो चीज भेटयो नाही। उनना दूहुर च लक वोको स्वागत करीन। अना वय ओरख ला का अमी तो यो धरती मा परदेसी अना अनजान सेत। <verse eid="HEB 11:13" /><verse number="14" style="v" sid="HEB 11:14" />वय लोक जोन असो गोस्टी करासेत, वय असो दीसात होतिन जसो एक असो देस को खोज मा होतिन जोन उनको आपरो सेत। <verse eid="HEB 11:14" /><verse number="15" style="v" sid="HEB 11:15" />अदी वय वोना देस को बारेमा सोचयो होतो जोनला सोड़ दियो होतिन। तो उनको दुबारा लवटन को मौका होतो। <verse eid="HEB 11:15" /><verse number="16" style="v" sid="HEB 11:16" />परंतु उनला सरग को एक उत्‍तम राज इक्सा सेत। एकोलाय परमेस्वर उनको परमेस्वर कहलानो मा अजिबात संकोच नाही करासेत। कारन वोना उनको साठी एक नगर तइयार कियो सेत।<verse eid="HEB 11:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="HEB 11:17" />बिस्वास को कारन च अबराहम ना, जब परमेस्वर वोला परखत होतो। इसहाक को बलि चघायो। वोच जोन लक करार कियो होतो। अपरो एकठिया टूरा को जबा बलि देवन वालो होतो। <verse eid="HEB 11:17" /><verse number="18" style="v" sid="HEB 11:18" />तरी च परमेस्वर वोला कह्यो, “इसहाक लक तोरो खानदान वाढेल।” <verse eid="HEB 11:18" /><verse number="19" style="v" sid="HEB 11:19" />परंतु अबराहम ला लगयो का, परमेस्वर ना मरयो हुयो ला भी जित्तो कर सकासेत। अना उपमा दियो जाय ता वोना इसहाक ला मरन को मंघा उलट पाय लियो।<verse eid="HEB 11:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="HEB 11:20" />बिस्वास को कारन च इसहाक ना याकूब अना एसाव ला उनको भबिस्य को बारेमा आसिरवाद दियो।<verse eid="HEB 11:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="HEB 11:21" />बिस्वास को कारन च याकूब ना ने, जब उ मर रहयो होतो। यूसुफ को हरेक टूराहुन ला आसीरवाद दियो अना अपरो लठीको को सहारा वोवन के परमेस्वर को पिराथना करयो।<verse eid="HEB 11:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="HEB 11:22" />बिस्वास को कारन च जबा युसुफ को मरन को बेरा आयो, तबा वोना मिसर देस लक हिटन काजी इसरायल लोकहुन ला सांगयो अना वोको हाड़ को बारेमा हुकूम दियो।<verse eid="HEB 11:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="HEB 11:23" />बिस्वास को आधार मा च मोसे को माय-बाप ना वोला तीन महिना लुकाउन कारन पयलेच उनला मालूम होतो का यो कौनी साधारन लेकरा नाहती। अना वय राजा को हुकूम लक भेव नही खायो।<verse eid="HEB 11:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="HEB 11:24" />बिस्वास को कारन च मोसे जब मोठो भयो, तबा उ ना फिरौन को नाती कहलावन लक नकार दियो। <verse eid="HEB 11:24" /><verse number="25" style="v" sid="HEB 11:25" />वोना पाप को छिनभर को सूक को ऐवज मा परमेस्वर को संतगिन को गैरव मा पर सहन करन्या साठी निवड़ले। <verse eid="HEB 11:25" /><verse number="26" style="v" sid="HEB 11:26" />मिसर देस को खजाना को अपेक्सा मसीह साठी बेइज्जत होवनो वोला जादा किमती लगयो। कारन वोको नजर आवन वालो बेरा मा भेटनवालो बक्सीस मा होतो।<verse eid="HEB 11:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="HEB 11:27" />बिस्वास को कारन च उनना मिसर देस ला राजा को भेव को परवा कियो बगेर सोड दियो। काहेका उ नही दिसनवालो परमेस्वर ला चोवत होतिन। <verse eid="HEB 11:27" /><verse number="28" style="v" sid="HEB 11:28" />बिस्वास को कारन ओरान्डा को तिहार मा मोसे ना नेम को पालन करयो अना रकत छिड़काव करयो। या साठी का सिग को टूरागिन को नास करनवारा दूत इसरायिल को सिग को टूरा गिनला नोको छिये।<verse eid="HEB 11:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="HEB 11:29" />बिस्वास च को कारन लोक वारले धरती सारखे लाल सागर पार कर लियो। परंतु जबा मिसरी लोकगीन यो करत होतिन तो बुडले।<verse eid="HEB 11:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="HEB 11:30" />बिस्वास को कारन, लोक सात दिवस भोवती फिरले मघा यरीहो को सहर को बाजू को मोठो दिवाल पड गयो। <verse eid="HEB 11:30" /><verse number="31" style="v" sid="HEB 11:31" />बिस्वास को कारन राहाब नावकी बेसिया हुकूम नही माननवालो को संग नास नही भयी काहेकी वा ने भेदिया गिनला सान्ती लक लूका के राखयो होतो।<verse eid="HEB 11:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="HEB 11:32" />अता मी अखिन काय सांगू? गिदोन, बारक, सीमसोन, इफ्ताह, राजा दाऊद, समूएल अना भविस्यवक्ता गिनको बारे मा का सांगू? <verse eid="HEB 11:32" /><verse number="33" style="v" sid="HEB 11:33" />उनना आपरो बिस्वास लक राजगिनला आपरो अधिन कर लियो, नियाव को पालन करयो, वादा को फर पायो। अना बाघ को तोंड बंद कर दियो। <verse eid="HEB 11:33" /><verse number="34" style="v" sid="HEB 11:34" />स्तो को धगाड़ी ला सान्त करीन, तरवार को धार लक बच गइन, कमजोरी ला ताकत बनाइन, लडाई मा बीर बनिन, अना परदेसी सेना ला मारके भगाइन।<verse eid="HEB 11:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="HEB 11:35" />आई-माई गिनना दुबारा जित्तो होवन को कारन लक, आपरो मरोयो हुया ला दुबारा पाइन। काही लोकगीन ला मोठयो दुख दियो गयो पर उनना सूटकारा नही चाहयो, जेनको लक की वय एक साजरा मग जित्तो होवनो ला पाय सकेत। <verse eid="HEB 11:35" /><verse number="36" style="v" sid="HEB 11:36" />काहींना बेड्या ठोकली अना काहींना चाबूक मारयो मजाक उड़ानो सांकल बेड़ी अना जेल लक काही लोकगीन को परिक्सा लियो गयो सेत। <verse eid="HEB 11:36" /><verse number="37" style="v" sid="HEB 11:37" />काहींना गोटा फेकयो, अना आरीमा फाड डाखिन, अना काहिला तलवारमा मारयो। वय गरीब होतिन, छल अना वाईट अतियाचार को सिकार बन गईन। वय मेंढा को अना सेरी को चमड़ा पघंर के इतानी-उतानी फिरले। <verse eid="HEB 11:37" /><verse number="38" style="v" sid="HEB 11:38" />योदुनिया उनको काबील नही होतो, वय रेतिला ज़मीन पहाड कन्दरा अना धरती को खोह मा लुकत हिडीन।<verse eid="HEB 11:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="HEB 11:39" />उनको बिस्वास को कारन यो सर्वां को कौतुक भयो। परंतु जोनना परमेस्वर ला दियो मोठा करार को फर नही भेटयो। सब को साजरो गवाही दियो गयो। <verse eid="HEB 11:39" /><verse number="40" style="v" sid="HEB 11:40" />काहेका परमेस्वर ना आमरो पर नजर राखके एक योजना बनायो होतो। उ चाव्हत होतो का आमरो संग सिध्ध बन जाबिन।<verse eid="HEB 11:40" /></para>
  <chapter eid="HEB 11" />
  <chapter number="12" style="c" sid="HEB 12" />
  <para style="p">
    <verse number="1" style="v" sid="HEB 12:1" />काहेका अमी गवाही को इतरो मोठ्यो गरदी लक घिरयो हुयो सेजन। जोन अमीला बिस्वास को मन्जे काय सेत? यो गोस्टी को पुरुप सेत। एकोलाय आओ बाधा पहुँचान वालो हरेक चीजला अना वोना पाप को जोन सरड़ मा अमीला उलझा लेवासेत। फटाकनारी फेंकके अना उ दौड़मा धावनो सेत, आओ अमी धीरज लक धावबिन। <verse eid="HEB 12:1" /><verse number="2" style="v" sid="HEB 12:2" />आमरो बिस्वास को नेता अना वोला पुरो लक उसे सिद्ध करन वालो यीसु पर नजर लगावो। जोनला आपरो समोर हाजिर आँनद को लाय कूरूस मा दुख झेलयो, वोको लाजको कोनी चिंता नहीं होतयो। अना परमेस्वर को सिंघासन को उजो हातमा बस गयो।<verse eid="HEB 12:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="HEB 12:3" />वोको धियान करो! जोनना जिसने पापीहुन को असो बिरोध एकोलाय सहयो। जोन लक थक हार के तुमरो मन नोको बस जाय। <verse eid="HEB 12:3" /><verse number="4" style="v" sid="HEB 12:4" />पाप को विरोध मा आपरो लड़ाईमा तुमला एतरो सहनो नही पड़यो का रकत बोहानो पड़यो। <verse eid="HEB 12:4" /><verse number="5" style="v" sid="HEB 12:5" />तुमी वोना हिम्मत को बचन ला बिसार दियो सेव। जोन तुमीला टूरा होवन को नातोलक कह्यो गयो सेत।</para>
  <para style="q1" vid="HEB 12:5">“ओ मोरो टूरा पिरभू को अनुसासन ला नोको टालजोस,</para>
  <para style="q2" vid="HEB 12:5">वोको डाट को कभीच बुरो नको मानजोस,<verse eid="HEB 12:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="HEB 12:6" />काहेका पिरभू उनला डाँटासेत जोन लक पिरेम करासेत।</para>
  <para style="q2" vid="HEB 12:6">वसोच जसो अजी आपरो लेकरा ला सजा देवासेत। जोन वोको चहेतोसेत।”<verse eid="HEB 12:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="HEB 12:7" />मुस्किल ला अनुसासन को रूपमा सहन करो। परमेस्वर तुम्हारो संग आपरो टूरा को जसो बरताव करासेत। असो कोनतो टूरा सेत जोनला आपरो अजी लक सजा नही दियो गयो सेत? <verse eid="HEB 12:7" /><verse number="8" style="v" sid="HEB 12:8" />यदि तुम्हिला वसोच सजा नही दियो गयो सेत जसो सबला सजा दियो जावासेत। तो तुम्ही आपरो अजी लक जलम लियो टूरा नही सव अना आपरो बाप को सच्चो संतान नहीं सेऊ। <verse eid="HEB 12:8" /><verse number="9" style="v" sid="HEB 12:9" />अना मंग यो भी का इन सब ला वय अजी भी जोनना आमरो देहला जलम दियो सेत। अमीला सजा देवासेत। अना एकोलाय अमी उनला मान देवासेत। मंग अमी अपरो आत्माहुन को अजी को अनुसासन को कितरो जादा अधिन रव्हतो हुयो जीवनो पाहिजे <verse eid="HEB 12:9" /><verse number="10" style="v" sid="HEB 12:10" />आमरो अजीगिन ना जरा सो बेरालाय जसो उनला साजरो लगयो, अमीला सजा दियो, पर परमेस्वर अमीला आमरो भलाई को लाय सजा देइसेस। जोनलक अमी वोको पवितरपन को हिस्सादार बनबीन। <verse eid="HEB 12:10" /><verse number="11" style="v" sid="HEB 12:11" />जोन बेरा सजा दियो जाय रहयो होती, वोना बेरा सजा साजरो नही लगासेत। बल्कि दुख लगासेत। पर काही भी होय, वय जोन सजा को अनुभव करासेत। वोको लाय मंग नेकी अना सान्ति अना साजरा फर भेटासेत।<verse eid="HEB 12:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="HEB 12:12" />एकोलाय लिलवा भाजी जसो हात, अना दरद वारा टोघरा ला ताकतवर बनालेव। <verse eid="HEB 12:12" /><verse number="13" style="v" sid="HEB 12:13" />आपरो पाय साठी एक मारग तइयार करा, जेनको लक अपंग भटकेत नाही, तर चागलो भयी जाहेत।<verse eid="HEB 12:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="HEB 12:14" />सर्वां संग सान्ती लक पवितर बनन को कोसीस करा। काहेका पवितर मानूस च पिरभू ला चोहेत। <verse eid="HEB 12:14" /><verse number="15" style="v" sid="HEB 12:15" />एना गोस्टी को ध्यान राखो का कोनी मानूस परमेस्वर को किरपा लक मुरक ना जाय, अना तुम्हीला दुख देवन काजी अखिन लगत लोक गिनला खराब करन काजी कोनी झंझट को जड़ नोको फूटेत। <verse eid="HEB 12:15" /><verse number="16" style="v" sid="HEB 12:16" />आयको कोनी भी छिनालापन नोको करे, या वोना एसाव को जसो परमेस्वर लक दुहुर अना बुरो ना भयी जाय, जोनना सबलक मोठो टूरा होवन को अधिकार ला बस एक निवाला भर जेवन को लाय बिक दियो होतो। <verse eid="HEB 12:16" /><verse number="17" style="v" sid="HEB 12:17" />तुमिला मालुम सेत। वोला जोन बरदान भेटयो होतो। वोला मंग पावन लाय खूप रडला, तरी आपरो अजी को मन बदलन मा नाकबिल रहयो।<verse eid="HEB 12:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="HEB 12:18" />तुम्ही स्तो लक जरतो हुयो वोना पहाड़ को जवर नहि आयो, जोनला छिव सकासेत। ये नातो स्तो को धगाड़ी सेत, ना कारो बद्दल सेत, न आँधड़ सेत। <verse eid="HEB 12:18" /><verse number="19" style="v" sid="HEB 12:19" />यो ना तो तुर्रा फुकन को सोर या असी कोनी आवाज जोनला आयकन वारा गीन ना बिनती करीन की अबा मंग आमरो लक काही नोको कहे। <verse eid="HEB 12:19" /><verse number="20" style="v" sid="HEB 12:20" />कारन उनला जोन हुकूम दियो गयो होतो वोला सहनो कठीन होतो। “अगर कोनतोच जनावर पहाड़ ला छीवे तर वोला गोटा लकमारयो जाहेती।” <verse eid="HEB 12:20" /><verse number="21" style="v" sid="HEB 12:21" />उ नजारा ते इतरो भयानक होतो का मोसे कह्यो, “मी भीतर लक थरथर कापत होता।”<verse eid="HEB 12:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="HEB 12:22" />पर तुम्ही सरग को यरुसलेम जवर, जित्तो परमेस्वर को सहेर, सिओन पहाड़ मा पहुचयो सेत। वहान आपरो हजारो देवदूत को संग आनंद मनावा सेत। <verse eid="HEB 12:22" /><verse number="23" style="v" sid="HEB 12:23" />परमेस्वर को पहेलो संतानहुन, जोनको नाव सरग मा लिखयो सेत। उनको सभा को जवर पहुँच चुकयो सेव। तुम्ही सबको न्याय करनवालो परमेस्वर अखिन वोना नेक, सिद्ध मानूस को आत्माहुन, <verse eid="HEB 12:23" /><verse number="24" style="v" sid="HEB 12:24" />अना नवीन करार को बिचवई यीसु विराजमान सेत। जोन को सींचो गयो रकत हाबिल को रकत को अपेक्सा जादा चांगलो सबद बोलासेत।<verse eid="HEB 12:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="HEB 12:25" />सतरक रव्हो, का कोनी बोलनवारा को सबद नोको नकारो, जोनना धरती मा चेतायो होतो। उनको सबद ला नही आयकलो। वय नहि बच सकयो। ता सरग कन भेटयो चेतावनि लक कसो बच सकासेत? <verse eid="HEB 12:25" /><verse number="26" style="v" sid="HEB 12:26" />वोको आवाज ना वोना बेरा धरती ला डोलाय दियो होतो। परंतु अता वोना बचन दियो सेत का, “मी पुन्हा एक बेर धरती नाही तर सरग ला डोलहिन।” <verse eid="HEB 12:26" /><verse number="27" style="v" sid="HEB 12:27" />यो सबद “पुन्हा एक बेर” तइयार करयो हरेक गोस्टी को बारे मा इसारा मिलासेत। का जोन चीज डोलायो जाहेत मजे वोको नास होहेत, अना जोन नही डोलहेत मन्जे हरामेसा लक रव्हेत।<verse eid="HEB 12:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="HEB 12:28" />एकोलाय जबा अमीला असो अटल राज भेटनवारा सेत। तो आव आमी परमेस्वर को धनवाद मानके भेव को संग, परमेस्वर को असो भगती करबीन जोन वोला पावन भई जाय। <verse eid="HEB 12:28" /><verse number="29" style="v" sid="HEB 12:29" />कारन आपरो परमेस्वर भस्म करनवारा स्तो सेत।<verse eid="HEB 12:29" /></para>
  <chapter eid="HEB 12" />
  <chapter number="13" style="c" sid="HEB 13" />
  <para style="s">आमी परमेस्वर ला कसो खुस करबीन</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 13:1" />भाऊ बन्ध जसो एकमेक लक पिरेम करो। <verse eid="HEB 13:1" /><verse number="2" style="v" sid="HEB 13:2" />पाहुनायी आव भगत करनो नोको बिसरो। काहेका काही लोकहुन योच विसरू नोको, काहेका अनजानो मा लोकगिन ना देवदूत को स्वागत करयो सेत। <verse eid="HEB 13:2" /><verse number="3" style="v" sid="HEB 13:3" />कैदीहुन को सूदी लेव जसो तुम्ही उनको बरोबर कैदी सेऊ, जोन पर अतियाचार होवासेत, उनला भी हेत करो। काहेका तुमरो पर भी अतियाचार होय सकासेत।<verse eid="HEB 13:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="HEB 13:4" />लग्न को सबला आदर करनो पाहिजे लग्न को सेज ला पवितर राखो। काहेका परमेस्वर छिनाला करनवारा, गाली बकन वालो ला सजा देहेत।<verse eid="HEB 13:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="HEB 13:5" />पैसा को लोभा पासुन आपरो जीवन मुक्त करा। तुमरो जवर जोन सेत वोकोच लक समाधान करो। काहेका परमेस्वर खूदच कव्हसेत, “मी तोला कधीच नही सोड़ीन, अना नाही मी तोला आपरो लक बगरो करहीन।” <verse eid="HEB 13:5" /><verse number="6" style="v" sid="HEB 13:6" />एको लाई हमि हिम्मत लक कव्हसेजन,</para>
  <para style="q1" vid="HEB 13:6">“पिरभु मोरो मदत करासेते,</para>
  <para style="q2" vid="HEB 13:6">मोला कधीच भेव नाही।</para>
  <para style="q2" vid="HEB 13:6">एखादी मानूस मोरो काय कर सकेत?”<verse eid="HEB 13:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="HEB 13:7" />आपरो पेरीत को हेत राखो, जिनना तुमिला परमेस्वर को गोस्टी आयक वाईन अना ध्यान लक उनको चालचलन को फर ला चोयके उनको भरोसा को मंघा होय जाव। <verse eid="HEB 13:7" /><verse number="8" style="v" sid="HEB 13:8" />यीसु मसीह कल भी वसोच होतो, जसो आज सेत, अना हरामेसा वसोच रव्हेत। <verse eid="HEB 13:8" /><verse number="9" style="v" sid="HEB 13:9" />हर प्रकार को अजब को सिक्सा मा नोको भरमो, तुम्हारो मन कोलाय यो साजरो सेत। का किरपा लक मजबूत बनयो रवहो, जेवनो पिवनो को नेम धरम लक नही। जोन लक कदिच कोनी को भलो नही भयो सेत। जोनना यो सब मानीसेत।<verse eid="HEB 13:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="HEB 13:10" />आमरो च जवर एक वेदी सेत। जोन संसार को तम्बु मा भगती करासेत उनला यो वेदी को जेवन को अधिकार नाहती। <verse eid="HEB 13:10" /><verse number="11" style="v" sid="HEB 13:11" />काहेका मुख्य याजक जोन बली को जनावर को रकत पापबली को लाय पवितर जघा मा ले जावासेत। वोला तम्बु को बाहेर धड़कावासेत। <verse eid="HEB 13:11" /><verse number="12" style="v" sid="HEB 13:12" />एकोलाय यीसु ना सहेर को बेसकुड़ को बाहेर दुख भोगयो, जोनलक उ आपरो रकत लक जनता ला पवितर करे। <verse eid="HEB 13:12" /><verse number="13" style="v" sid="HEB 13:13" />तर मग आपरो जोन तरास को सामना करयो। वोच अपमान सहन करतो हुयो वोको बरोबर तम्बू को बाहेर चलो। <verse eid="HEB 13:13" /><verse number="14" style="v" sid="HEB 13:14" />कारन आपरो जवर इतानी आमरो कोनी कायम नगर नाहती, अमी तो आवनवालो नगर को खोजमा लग्यो सेत। <verse eid="HEB 13:14" /><verse number="15" style="v" sid="HEB 13:15" />अता आओ अमी यीसु को लक परमेस्वर ला स्तुति रूपी बलि चघाव जोन उनको होठ को फर सेत। जोनना वोको नाव चिन्हा सेत। <verse eid="HEB 13:15" /><verse number="16" style="v" sid="HEB 13:16" />भलाई करनो अना संग मा दया चोवानो ना भुलो, काहेकि असी बली लक परमेस्वर खुस होवासे।<verse eid="HEB 13:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="HEB 13:17" />आपरो मारग दिसावन वालो को हुकूम मानो, वोको अधिन रव्हो। हुकूम मानो। वय तुमरो असो देख-रेख करासेत। जसो उन मानूस को लेखा जोखा उनला च देवनो सेत। उनको हुकूम मानो, जोनलक उनको काम खुसी बन जाय, उनला बोझा जसो नोको लगे। काहेका वोको लक तुम्हिला कोनी फायदा नाहती।<verse eid="HEB 13:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="HEB 13:18" />आमरो साठी पिराथना करत रव्हो। अमीला भरोसा सेत का आमरो मन सूध्ध सेत। काहेका आमी सबच गोस्टी मा साजरी चाल चलन को बरताव राखसेजन। <verse eid="HEB 13:18" /><verse number="19" style="v" sid="HEB 13:19" />मी बिनती करुसेउ की तुमी अखीन लगत आमरो लाय पिराथना करो जोनलक मी तुमरो कठा मंग लवकर आय सकू।<verse eid="HEB 13:19" /></para>
  <para style="s">आसिरवाद</para>
  <para style="p">
    <verse number="20" style="v" sid="HEB 13:20" />जोनना मेढा गीन को महान रखवालो, आमरो पिरभु यीसु को रकत लक वोना अमर सांती करार मा मोहर लगाके परमेस्वर मरयो हुयो लक जित्तो कर देइस। <verse eid="HEB 13:20" /><verse number="21" style="v" sid="HEB 13:21" />तुमला सबा साजरो साधन लक भर देवे, जेनको लक तुमी वोको मनसा पूरो करो। अना यीसु मसीह लक उ आमरो भीतर वोना सब काही परगट करे जोन वोला भावासेत। ओकी महिमा सदा तकन बनयो रव्हे। आमिन।<verse eid="HEB 13:21" /></para>
  <para style="s">निचोड़</para>
  <para style="p">
    <verse number="22" style="v" sid="HEB 13:22" />अगो भाऊहुन मी तुमी लक बिनती करासू, का एना सिक्सा ला तुमी धियान धरके आयको, काहेका मी एला बिस्तार लक नही पर सार-सार लिखिसेव। <verse eid="HEB 13:22" /><verse number="23" style="v" sid="HEB 13:23" />तुमीला मालूम होहे का, आमरो भाऊ तीमुथियुस सूट गयो सेत, अदी वा लवकर आ जाहेत, तो मी भी वोको संग आयके तुमरो लक भेंट करू।<verse eid="HEB 13:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="HEB 13:24" />आपरो सबा नेतागीन अना सब संतहुन ला नमस्कार सांगजोस। इटली को रव्हनवारा तुमीला नमस्कार कव्हसेत।<verse eid="HEB 13:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="HEB 13:25" />तुम सब पर परमेस्वर को किरपा होहे। आमिन<verse eid="HEB 13:25" /></para>
  <chapter eid="HEB 13" />
</usx>