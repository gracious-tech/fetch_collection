<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="JAS" style="id">- Powari Standard Project</book>
  <para style="h">याकूब</para>
  <para style="toc3">याकूब</para>
  <para style="toc2">याकूब</para>
  <para style="toc1">याकूब को चिठ्ठी</para>
  <para style="mt2">याकूब का पत्र</para>
  <para style="mt1">याकूब को चिठ्ठी</para>
  <para style="imt">परिचय</para>
  <para style="ip">याकूब को किताब याकूब नामको कोनी मानूस लक लिख्यो गयो से। यो साइद यीसु को भाऊ होतो जोन सुरुवाती चरच को नेता होतो। अखीन यरुसलेम को कमेटी को एक भागीदार होतो। <char style="xt"><ref loc="ACT 15:13">पेरीत 15:13</ref></char> पेरीत पौलुस ने वोला <char style="xt"><ref loc="GAL 2:9">गलातियो 2:9</ref> </char>मा कलीसिया को मुंडा भी कह्यो होतो। विद्वान गिनको असो माननो होतो का यो किताब ईसा के जलम को करीब 50 साल मघानी लिख्यो गयो से। पर याकूब अबा यरुसलेम को कलीसिया को नेता होतो। वोना वहान रहतो बेरा च साइद यो किताब लिख्यो होतो।</para>
  <para style="ip">याकूब आपरो किताब मा गैरयहुदी मा बगरो हुयो 12 गोत को नाव ला संबोधित करासे। <char style="xt"><ref loc="JAS 1:1">1:1</ref> </char> याकूब को पाठ सब ईसाई लोक गीनमा लागू होवासेत। पर “बारा गोत” सबद ला बवजनो पर यो संभव हो जासे का याकूब सिद्दो यहूदी ईसाई गिनला लिख रहयो होतो। पर यो किताब वाचन वारो को एक मोठो समूह तकन पोहचन को लाय होतो। वोना लगत बिसय ला संबोधित कियो से। याकूब भरोसा अखीन काम को बीच मा जोन नातो से वोको पर धियान दिलानो चाव्हासे। सच्चो भरोसा काम कर के दिसायो जावासेत। <char style="xt"><ref loc="JAS 2:17">2:17</ref></char> उ धनी लोक गिनको पक्स लेवन को बिरोध करासेत अना चेतावासे। <char style="xt"><ref loc="JAS 2:1-4">2:1-4</ref> </char>अखीन कव्हासे का अमी जोन कव्हा सेजन वोको लाय अमीला सतरक रव्हनो पाहिजे। <char style="xt"><ref loc="JAS 3:1-12">3:1-12</ref> </char></para>
  <para style="iot">रूपरेखा</para>
  <para style="io1">1. याकूब मा आपरो वाचन वारो ला नमस्कार कव्हासे। <char style="ior"><ref loc="JAS 1:1">1:1</ref></char></para>
  <para style="io1">2. मघानी वा मसीह गिनला दुख झेलन को बारेमा अना मजबूत रव्हन काजी उकसावा सेत। <char style="ior"><ref loc="JAS 1:2-27">1:2-27</ref> </char></para>
  <para style="io1">3. मंग उ कव्हासे का भरोसा को लाय करम लक चोवानो कसो जरुरी से। <char style="ior"><ref loc="JAS 2:1-26">2:1-26</ref> </char></para>
  <para style="io1">4. मंग उ कव्हसे का सबद कितरो ताकतवर होय सका से। <char style="ior"><ref loc="JAS 3:1-12">3:1-12</ref> </char></para>
  <para style="io1">5. तबा याकूब समजावासे का कसो परमेस्वर को अक्ल संसार को अक्ल लक बेगरो से। <char style="ior"><ref loc="JAS 3:13-4:10">3:13—4:10</ref></char></para>
  <para style="io1">6. मंग उ आपरो वाचन वालो ला गरब करन को खिलाप चेतावासे। <char style="ior"><ref loc="JAS 4:11-5:6">4:11—5:6</ref> </char></para>
  <para style="io1">7. याकूब काही सरल निरदेस देयके आपरो किताब ला पूरो करासेत। <char style="ior"><ref loc="JAS 5:7-20">5:7-20</ref> </char></para>
  <chapter number="1" style="c" sid="JAS 1" />
  <para style="s">नमस्कार</para>
  <para style="p">
    <verse number="1" style="v" sid="JAS 1:1" />परमेस्वर को अना पिरभू यीसु मसीह को दास याकूब को कन लक वोना बारा गोत को लोकगीन जोन तितिर-बितिर होयके रव्हसेत नमस्कार भेटेत।<verse eid="JAS 1:1" /></para>
  <para style="s">भरोसा अना अक्लवरी</para>
  <para style="p">
    <verse number="2" style="v" sid="JAS 1:2" />मोरो चहेतो भाऊगीन, जब तुमी लगत परकार को परिक्सा को सामना करसेव, त एला निरो खुसी को बात समझो। <verse eid="JAS 1:2" /><verse number="3" style="v" sid="JAS 1:3" />काहेका तुमी जानसो का तुमारो भरोसा ला परखो लक धीरज जलम लेवसेत। <verse eid="JAS 1:3" /><verse number="4" style="v" sid="JAS 1:4" />धीरज ला अपरो काम पूरो करन देव। जोनलक तुमी निरदोस अना सिद्ध भई जाओ; अना तुमरो मा कोनी परकार को कमी न रव्ह जाएत। <verse eid="JAS 1:4" /><verse number="5" style="v" sid="JAS 1:5" />अदी तुम मा कोनी ला गियान को कमी सेत, ता उ परमेस्वर लक बिनती करेत, जोन बिन तिरस्कार को सबा लोकगीन ला भी को दरिया दिल लक देवसेत, अर वोला जरूर भेटेत। <verse eid="JAS 1:5" /><verse number="6" style="v" sid="JAS 1:6" />पर भरोसा लक माँगे अना काही संका नही करेहे काहेकी संका करन वारा समुंदर लहर को जसो से, जोन वारा बोह से कुदासेती। <verse eid="JAS 1:6" /><verse number="7" style="v" sid="JAS 1:7" />मानूस असो नोको समझा का मोला पिरभू लक काही नही मिलेत। <verse eid="JAS 1:7" /><verse number="8" style="v" sid="JAS 1:8" />असो मानूस जोन को मन दुविधा लक घेरीयो हुयो सेत, अना उ आपरो सब सुभाव मा अटल नाहती।<verse eid="JAS 1:8" /></para>
  <para style="s">गरीबी अना धनी</para>
  <para style="p">
    <verse number="9" style="v" sid="JAS 1:9" />गरीब भाऊगीन आपरो वरता पद मा गरब करे। <verse eid="JAS 1:9" /><verse number="10" style="v" sid="JAS 1:10" />अना धनी आपरो गरीबी दसा मा गरब करे काहेका वोको जिंदगानी; जंगल को फूल अना गवथ जसो बीत जाहेती। <verse eid="JAS 1:10" /><verse number="11" style="v" sid="JAS 1:11" />दिवस को ऊन मा गवथ मुरझा जावा सेत। अना वोका खिलो फूल झड़ जावा सेत। वोको खुबसुरती नास हो जावा सेत असो च धनी मानूस आपरो धनको संग-संग धूरो मा मिल जाहेती।<verse eid="JAS 1:11" /></para>
  <para style="s">लोभ अना परिक्सा</para>
  <para style="p">
    <verse number="12" style="v" sid="JAS 1:12" />धन्य सेत उ मानूस, जोन परिक्सा मा उभो रव्हसेत। काहेका परिक्सा मा खरा साबीत होवासे उ जीवन को मुकुट पावन को काबील सेत। असो परमेस्वर ना उनको लाय वायदा करीसेस जोन वोको लक माया राखासेत। <verse eid="JAS 1:12" /><verse number="13" style="v" sid="JAS 1:13" />परिक्सा मा पड़न मा कोनी असो ना सांगेत; “का परमेस्वर मोला परिक्सा मा डाखी सेत।” काहेका परमेस्वर कोनी ला परिक्सा मा नही डाखा सेत अना कोनी परमेस्वर को परिक्सा ले सकसेत। <verse eid="JAS 1:13" /><verse number="14" style="v" sid="JAS 1:14" />हरेक मानूस खुदच आपरो मरजी लक अभिलासा मा पड़के अना फँसके परिक्सा मा पड़सेत। <verse eid="JAS 1:14" /><verse number="15" style="v" sid="JAS 1:15" />मंग अभिलासा गरभ धरासेत, अना पाप ला जलम देवा सेत। मंग पाप बड़ सेत अना मिरतु ला आना सेत।<verse eid="JAS 1:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="JAS 1:16" />एकोलाय मोरो चहेतो भाऊगीन, धोका मा नोको रव्हो। <verse eid="JAS 1:16" /><verse number="17" style="v" sid="JAS 1:17" />हरेक साजरो अना भरयो पुरयो दान-वरदान वरता लक भेटासेत। अना वय उजाड़ को मोठयो दआजी कन लक जेने सरग को उजाड़ ला जलम दियोसेस, खाल्या आनीयो जासे। जोनमा कोनी फेरबदल नाहती। <verse eid="JAS 1:17" /><verse number="18" style="v" sid="JAS 1:18" />खराई को साजरो बारता को कन लक आपरी औलाद बनावन को साठी ओने आमला निवड़ीसेस। मनजे आमी सबच जीवधारी हुन को बीच ओकी फसल को पुढ़ा फर सिध्द होय।<verse eid="JAS 1:18" /></para>
  <para style="s">आयकनो अखीन करनो</para>
  <para style="p">
    <verse number="19" style="v" sid="JAS 1:19" />अगो मोरो चहेतो भाऊगीन, हेत रखो, हर कोनी सजग रूप को संग आयकनो चाहिसे, कव्हन मा जल्दीच नोको करोह, गुस्सा करनो मा लाहकी नोको बरतेव। <verse eid="JAS 1:19" /><verse number="20" style="v" sid="JAS 1:20" />काहेका मानूस को गुस्सा लक परमेस्वर को धरमिपन नहीं मिल सकसेत। <verse eid="JAS 1:20" /><verse number="21" style="v" sid="JAS 1:21" />एकोलाय सप्पा खोटो सुभाव अखीन बैर ला तजके, नरमताई लक तुमरो दिल मा डाकयो गयो परमेस्वर को गोस्टी ला अपनावनो। जोन तुमरो सूटकारा लाय बेहद ताकतवर सेत।<verse eid="JAS 1:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="JAS 1:22" />परमेस्वर को सिक्सा मा चलनवारो बनो, केवल आयकन वालो नही, अदि तुमी केवल ओला आयकन वारो सेव तो खुद ला धोका देय रव्हसेव। <verse eid="JAS 1:22" /><verse number="23" style="v" sid="JAS 1:23" />यदि कोनी परमेस्वर को बचन ला आयकन वारो सेत पर वोको पर नही चलासेत, उ असो मानूस जसो सेत जोन आपरो रूप ला आरसा मा चोवासेत। <verse eid="JAS 1:23" /><verse number="24" style="v" sid="JAS 1:24" />उ खुदच ला साजरो तरीका लक चोवासे, पर जब वहान लक चलो जअसे ता गदने भूल जासे का उ कसो चोव रही होतो। <verse eid="JAS 1:24" /><verse number="25" style="v" sid="JAS 1:25" />पर जोनना निरदोस पवीतर गिरंथ ला साजरो लक बाच लेय सेत। जोन असल मा सूटकारा को करार सेत, अना वोच मा अटल रव्हसेत। उ आयक के बिसरनवालो नही, पर हेत रखके वोको हुकूम ला मानन वालो सेत, असो मानूस आपरो हरेक काम मा आसीस पावन वालो होहेत।<verse eid="JAS 1:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="JAS 1:26" />अदि कोनी मानूस अपरो आप ला भविस्यवक्ता समझ सेत। मंग अपरो जुबान मा लगाम नहीं लगावसेत, उ अपरो मन ला धोखा मा राखयो हुया सेत, अखीन वोको भगती बेकार सेत। <verse eid="JAS 1:26" /><verse number="27" style="v" sid="JAS 1:27" />आमरो परमेस्वर अना अजी को नजर मा बिलकुल सफा अना निरदोस भगती यो से; मुसीबत मा पड़यो अनाथगिन अना बेवागिन को सुधि लेवनो, अना खुदच ला कोनी संसारिक बुराई लक बेदाग राखनो।<verse eid="JAS 1:27" /></para>
  <chapter eid="JAS 1" />
  <chapter number="2" style="c" sid="JAS 2" />
  <para style="p">
    <verse number="1" style="v" sid="JAS 2:1" />अगो मोरो चहेतो भाऊहुन, आमरो महिमा वारो पिरभु मसीह यीसु मा जोन तुमरो भरोसा सेत; उ बिन पक्सपात को होय। <verse eid="JAS 2:1" /><verse number="2" style="v" sid="JAS 2:2" />तुमरी सभाघर मा अदी कोनी मानूस सोनो को छल्ला अना उचो किसम को कपरा घालयो हुयो आवासे अखीन वहान एक गरीब मानूस भी मैलो कपरा मा आवासे। <verse eid="JAS 2:2" /><verse number="3" style="v" sid="JAS 2:3" />अदि तुमी साजरो कपरा वारो को संगा मान ईज्जत करोसेव। अना ओको लक कव्हसेव, आव यहान साजरो आसन मा बस। पर गरीब मानूस ला कसो, वहान लक उभो होय मनजे कुरसी लक अना मोरो पाय को खाल्या को जघा मा बस। <verse eid="JAS 2:3" /><verse number="4" style="v" sid="JAS 2:4" />असो करत हुयो का तुमीना आपरो बीच कोनी भेदभाव नही करियो अना बुरो बिचार को संगा न्याय करता नही बन गयेत?<verse eid="JAS 2:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="JAS 2:5" />ओ मोरो चहेतो भाऊगीन, आयको। का परमेस्वर न संसार को नजर मा ओना गरीबहून ला भरौसा मा धनी अना ओना राज को वारसाना को रूप मा नही निवड़ीसेस, जेनला परमेस्वर ना, जोन ओला माया करासेत, देवनो को बचन देयीसेस। <verse eid="JAS 2:5" /><verse number="6" style="v" sid="JAS 2:6" />पर तुमना ता ओना गरीब मानूस को पुढ़ा मनमुटाव करिया सेव। अना का असो अमीर मानूस वयच नोहोति, जोन तुमरो पर अतियाचार करासेत अना तुमीला अदालत तकन घस-टतसेत? <verse eid="JAS 2:6" /><verse number="7" style="v" sid="JAS 2:7" />का वय याच नोहोति का जोन मसीह को नाव की निन्दा करासेत, जोन का तुमी कहलावासे।<verse eid="JAS 2:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="JAS 2:8" />तबा भी अदी तुमी पवितर गिरंथ को मोसे को नियम को पालन करासेव, जसो का तु अपरो सैजार लक अपरो जसो माया राखबिन तुमी सही मा वोनो करार ला पूरी करासेव त साजरो करासेव। <verse eid="JAS 2:8" /><verse number="9" style="v" sid="JAS 2:9" />पर अदी तुमी पक्सपात करासेव त पाप करासेव अना करार तुमला अपराधी ठहरावासे। <verse eid="JAS 2:9" /><verse number="10" style="v" sid="JAS 2:10" />काहेकी कोनी भी अदि सप्पा मोसे को नियम ला पालन करासे अना एक गोस्टी मा चूक जावासे ता उ सप्पा मोसे को नियम को तोड़न को दोसी भय जासे। <verse eid="JAS 2:10" /><verse number="11" style="v" sid="JAS 2:11" />एकोलाय का जोन न यो कह्यो होतो, “छिनालापन नोको करबीन” वोना यो भी कह्यो होतो, “रकत नोको करबीन।” एकोलाय अदी तुमी छिनालापन त नही करोसो पर खून करोसो ता तुमी मोसे को नियम ला नही माननवारा ठहरासो। <verse eid="JAS 2:11" /><verse number="12" style="v" sid="JAS 2:12" />तुमरो गोस्टी अना तुमरो सुभाव उन लोकहुन को जसो होय, जिनको न्याय छुड़ोती देनवारो मोसे को नियम को जसो कियो जाहे। <verse eid="JAS 2:12" /><verse number="13" style="v" sid="JAS 2:13" />जेना दया नही चोवायीसेस, ओको न्याय दया को संगा नही कियो जाहे; पर दया न्याय पर जीत पाय लेहे।<verse eid="JAS 2:13" /></para>
  <para style="s">भरोसा अना भलो काम</para>
  <para style="p">
    <verse number="14" style="v" sid="JAS 2:14" />अगा मोरो भाऊगीन, अदि कोनी मानूस कव्हसे का उ बिस्वासी से ता एको का नफा? जबा तकन का ओको काम बिस्वास को जसो नहोत। असो बिस्वास का ओको सूटकारा कर सकासे? <verse eid="JAS 2:14" /><verse number="15" style="v" sid="JAS 2:15" />अदी भाऊहुन या बहिनीहुन ला कपरा को पायजे, उनको जवर खान तकन को नहोत। <verse eid="JAS 2:15" /><verse number="16" style="v" sid="JAS 2:16" />ता तुमरो ओन्हीसीन कव्हनो यो बेस से, का परमेस्वर तुमला आसीरवाद देहे सांती लक रव्हो! गरम-गरम कपरा घालयो अना भरपेट खावहो। लेकिन तुमी उनला जरुरत को चीजहुन ला नही देसो ता का नफा <verse eid="JAS 2:16" /><verse number="17" style="v" sid="JAS 2:17" />ऐना पिरकार लक अदि बिस्वास, काम को संगा नाहती ता उ आपरो आपच मा मरयो हुयो से।<verse eid="JAS 2:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="JAS 2:18" />अता कोनी मानूस कवह सकेत, “तोला बिस्वास से, अना मि काम करासेऊ। तु आपला बिस्वास मोला बगेर काम को दिसाव; अना मि आपरो बिस्वास आपला काम लक तोला दिसाहुँ।” <verse eid="JAS 2:18" /><verse number="19" style="v" sid="JAS 2:19" />का तोला बिस्वास से का परमेस्वर एकच से? तू साजरो करासेस! बुरो आतमा भी बिस्वास धरासेत का परमेस्वर से अना वय कपकपात रव्हसेत। <verse eid="JAS 2:19" /><verse number="20" style="v" sid="JAS 2:20" />पर ओ मुरख मानूस का तू यो भी नही जानस, का करम को बगेर बिस्वास फालतू सेत? <verse eid="JAS 2:20" /><verse number="21" style="v" sid="JAS 2:21" />का आमरो पुरखा अबराहम ना जबा आपरो टूरा इसहाक ला वेदी मा चघाय दियो होता? तो का उ वोनो बेरा आपरो करम लक धरमी नही ठहरायो गयो होतो? <verse eid="JAS 2:21" /><verse number="22" style="v" sid="JAS 2:22" />पर अबा तूना चोवलियो का बिस्वास ना वोको करम को संग मिलके परभाव डाखी सेत। अना करम लक बिस्वास पूरो होवासेत। <verse eid="JAS 2:22" /><verse number="23" style="v" sid="JAS 2:23" />अखीन पवितर गीरंथ को यो बचन पूरो होवासेत; “अबराहम ना परमेस्वर मा बिस्वास करीस, अना यो वोको लाय नेकी गीनो गयो अना वा परमेस्वर को संगी गिनो गयो।” <verse eid="JAS 2:23" /><verse number="24" style="v" sid="JAS 2:24" />एना परकार तुमी ना चोवलियो, का मानूस सिरप बिस्वास लक नही पर करम लक भी धरमी ठैयरासेत।<verse eid="JAS 2:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="JAS 2:25" />वसोच राहब बेसिया भी, जबा वोना दूतगिन ला आपरो घरमा राखीस, अना दुसरो रस्तालक बिदा करीस, ता कर लक वा धरमी नही भई?<verse eid="JAS 2:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="JAS 2:26" />एकोलाय जसो देह आतमा को बिन मरिया हुया सेत, वसोच बिस्वास भी करम को बिन मरया हुया सेत।<verse eid="JAS 2:26" /></para>
  <chapter eid="JAS 2" />
  <chapter number="3" style="c" sid="JAS 3" />
  <para style="p">
    <verse number="1" style="v" sid="JAS 3:1" />अगा मोरो भाऊगीन गीन तुमरो मा लक लगत सा सिक्सा देवन वारा नोको बनहेत, काहेकी जानासेव, का हमी सिक्सा देवन वारा अखीन नियाव ठहराया जाहेति। <verse eid="JAS 3:1" /><verse number="2" style="v" sid="JAS 3:2" />एकोलाय का हमी सबरी लगत बार चूक जाहेत जोन कोनी बचन मा नही चूकासेत उ च त सिद्ध मानूस से अना सारी तन मा पर लगाम लगाय सकासेत। <verse eid="JAS 3:2" /><verse number="3" style="v" sid="JAS 3:3" />खरो खर जबा हमी अपरो बस मा करनो को लाई घोड़ा गीन को टोंड मा लगाम लगावासेजन त हमी उनकी सबरी बदन घुमाय सकासेजन। <verse eid="JAS 3:3" /><verse number="4" style="v" sid="JAS 3:4" />मोठो डोंगा को भी उदाहरन लियो जाव सकासे। चाव्ह वय केतरोच मोठा होवासेत अना ताकत को संगा चलाय जावासेत, किन्तु एक नहान सी डोंगी लक उनको नाविक उनला जहान कहीं ले जावनो से, <verse eid="JAS 3:4" /><verse number="5" style="v" sid="JAS 3:5" />एने तरीका जिबली, जोन बदन को एक नहान सो आंग सेत, मोठी-मोठी गोस्टी कर डाकन को डींग मारासे।</para>
  <para style="p" vid="JAS 3:5">अता जरा सौचो एक जरा सी लपट समुचे जंगल ला जलाय सकासे। <verse eid="JAS 3:5" /><verse number="6" style="v" sid="JAS 3:6" />जिबली एक स्तो को धगाड़ी को जसो से। यव बुराई को एक सप्पा सरमसार से। यव जिबली आमरो तन को आंगहुन मा एक असो आँग से, जो सप्प तन ला नास कर डाकासे अना आमरो सप्पा जिंदगी चक्कर माच स्तो लगाय देसे। यव जुबान नरक को स्तो लक पैटत रव्हसे। <verse eid="JAS 3:6" /><verse number="7" style="v" sid="JAS 3:7" />काहेकी हर पिरकार की जंगली जनावर पक्सी अना रेंगन वारा जीव जन्तु अना जलचर त मानूस जात की बस मा होय सकासेत अना होय भी गयोव सेत। <verse eid="JAS 3:7" /><verse number="8" style="v" sid="JAS 3:8" />पर जिबली ला मानूस गीन मा लक कोनी बस मा नही कर सकासे वा एक असी बला से जोन कबच रुका नही उ पिरान लेवन वालो जहेर लक भरी से। <verse eid="JAS 3:8" /><verse number="9" style="v" sid="JAS 3:9" />हम एकोच लक हमी पिरभू अना मोठो परमेस्वर की बड़ाई करासेजन अखीन एकोच लक जनमन परमेस्वर का जसो बनायो गयो मानूस ला भी सराप देवा सेजन। <verse eid="JAS 3:9" /><verse number="10" style="v" sid="JAS 3:10" />एकच टोंड लक आसीस अना सराप दुई हिटा सेत अगा मोरा भाऊगीन असो नही होवनो पायजे। <verse eid="JAS 3:10" /><verse number="11" style="v" sid="JAS 3:11" />का एकच झिरिया लक का गोड़ अना खारो पानी दुई हिटसे? <verse eid="JAS 3:11" /><verse number="12" style="v" sid="JAS 3:12" />अगा मोरा भाऊगीन, “जसो अंजीर को झाड़ मा जैतून को फर नही लग सकासे वसोच खारो झिरिया लक मीठ्ठो पानी कसो हिटहेत।” <figure style="fig" alt="Rider on a horse" file="LB00035C.TIF" size="col" copy="Horace Knowles ©" ref="3:3">घोड़ो मा सवारी</figure><verse eid="JAS 3:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="JAS 3:13" />भला तुमरो मा लक अक्कल वर कोन सेत? जोन सेत वोला अपरो बरताव लक असो देखवनो चाव्हसे का वोका करम वोनो ईमानदारी को संगा करियो गयो सेत जोन अक्कल लक जुड़या सेत। <verse eid="JAS 3:13" /><verse number="14" style="v" sid="JAS 3:14" />पर अदी तुमी लोक गीन मा लगत ईरसा अना सुवारत, भरियो से ता अपरो अक्कल को डिंडोरा नोको पिटो असो करन लक त तुमी खराई पर परदा डाकके ना खोटो सांगसो। <verse eid="JAS 3:14" /><verse number="15" style="v" sid="JAS 3:15" />पर असो गियान ता सरग लक नही आयेव से पर यव ता संसार को से, यव ता परमेस्वर को नाहती पर सैतान को से। <verse eid="JAS 3:15" /><verse number="16" style="v" sid="JAS 3:16" />काहेकी जहान डाह अना बिरोध होवासे वहान झगड़ा-राड़ अना हर पिरकार को पाप भी होवासे। <verse eid="JAS 3:16" /><verse number="17" style="v" sid="JAS 3:17" />पर जोन अक्ल वरता लक आवासे उ पहेल त पवीतर होवासे मंग मेल-मिलाप नरम अखीन भला सुभाव अना दया सान्ती अखीन साजरो फर गीन लक लदी हुई अना पक्स-पात को बगर अखीन निस्कपट होवासे। <verse eid="JAS 3:17" /><verse number="18" style="v" sid="JAS 3:18" />मिलाप करान वालो ओनो बीज ला नेकी को संगा सान्ति लक बोयो जासे।<verse eid="JAS 3:18" /></para>
  <chapter eid="JAS 3" />
  <chapter number="4" style="c" sid="JAS 4" />
  <para style="p">
    <verse number="1" style="v" sid="JAS 4:1" />तुमरो मा लडाई अना झगड़ा कहान लक आई गइन? का वोनो सुख सुबितागीन लक नही जोन तुमरो अंग गीन मा लड़त-भीड़त से? <verse eid="JAS 4:1" /><verse number="2" style="v" sid="JAS 4:2" />तुमी ता आस राखा सेव अखीन तुमला नही मिला एकोलाय तुमी जान लक मार डाकासेव तुमी जरन करासेव अना मंग तुमीला नही भेटेत ता तुमी झगड़ा राड़ करासेव। तुमला एकोलाय नही भेटत का तुमी नही मांगासेव। <verse eid="JAS 4:2" /><verse number="3" style="v" sid="JAS 4:3" />काहेका तुमी बुरी आस लक मंगा सेव एकोलाय तुमी मंगा सेव पर तुमी ला नही भेटत, अपरो भोगविलास मा खरचा कर देवो। <verse eid="JAS 4:3" /><verse number="4" style="v" sid="JAS 4:4" />अरे पापी छिनालापन करन वालो मी तुमला नही जानासेउ का संसार लक मिताई जोड़न वारा परमेस्वर को सतरु बननोसे? अना जोन कोनी संसार को संगी होवनो चाव्हसे उ अपरो आप ला परमेस्वर को बैरी बनावासे। <verse eid="JAS 4:4" /><verse number="5" style="v" sid="JAS 4:5" />का तुमला असो समझा से का पवितर गिरंथ मा गलत कव्हसे “जेना आतमा ला हमरो भीतर बसाइसेस का उ असी कामना करासे जोन को परिनाम डाय होहे?” <verse eid="JAS 4:5" /><verse number="6" style="v" sid="JAS 4:6" />उ त अखीन भी आसीरवाद देवासे एना कारन यो लिखी से “परमेस्वर गरबिला गीनको बिरोध करासे पर गरीब गीन पर किरपा करासे।”<verse eid="JAS 4:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="JAS 4:7" />एकोलाय परमेस्वर को सरन मा होय जावो; अना सैतान को सामना करो त उ तुमरो जवर लक पराय जाहे। <verse eid="JAS 4:7" /><verse number="8" style="v" sid="JAS 4:8" />परमेस्वर को जवर आव त उ भी तुमरो जवर आहे। अरे पापी गीन अपरो हात सुध्द करो; अखीन अरे भटकया हुया लोक गीन अपरो मन ला पवीतर करो। <verse eid="JAS 4:8" /><verse number="9" style="v" sid="JAS 4:9" />दुखी होवने अना सोक करो अना रोवो। तुमरी हासी सोक मा अना तुमरो खुसहाली उदासी मा बदल जाहे। <verse eid="JAS 4:9" /><verse number="10" style="v" sid="JAS 4:10" />पिरभु को पुड़ा गरीब बनो त उ तुमला उचो महान बनाय देहे।<verse eid="JAS 4:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="JAS 4:11" />अगा भाऊ एक दुसरो की बदनामी नोको करो। जोन अपरो भाउ की बदनामी करासे अना भाउ पर दोस लगावासे उ करार की बदनामी करासे अखीन नियम पर दोस लगावासे अना अदी तु करार पर दोस लगवासे त तु नियम मानन वालो नही पर तु वोको पर मुकदमा करन वालो ठहरायो जाजोस। <verse eid="JAS 4:11" /><verse number="12" style="v" sid="JAS 4:12" />देख-रेख देवन वालो न्यायी करनवालो त एकच से जोन बचा वन अना नास करनो मा ताकत से पर तु कोन से जोन अपरो सेजारी पर दोस लगावासेस?<verse eid="JAS 4:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="JAS 4:13" />तुमी जोन यो कव्हसेव “आज नही त काल हमी अखीन कोनी नगर मा जायके वहान एक बरस बितावबो अना धन्दा करके कमावबो।” <figure style="fig" alt="Customer, merchant with his wares" file="HK00172C.TIF" size="col" copy="Horace Knowles ©" ref="4:13">गिराहिक अना बयपारी अपरो समान को संग</figure><verse eid="JAS 4:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="JAS 4:14" />अखीन यो नही जानासेव का काल काजक होहे आयक त लेव लेने तुमरो जीवन से का? तुमी त धुंगा को जसो सेव जोन जरासी बेरा चोवासे अना लोप भईजासे। <verse eid="JAS 4:14" /><verse number="15" style="v" sid="JAS 4:15" />एको विपरीत तुमला असो कव्हनो चाव्हसे का “अदी पिरभु चाहे त हमी जित्तो रहबो अना उ काम भी करबीन।” <verse eid="JAS 4:15" /><verse number="16" style="v" sid="JAS 4:16" />पर अबा तुमी अपरो डींग मारनो<note caller="+" style="f"><char style="fr" closed="false">4:16 </char><char style="ft" closed="false">आपरो बड़ाई</char></note> पर घमंड करासेव असो सबा घमंड बुरो होवासे।<verse eid="JAS 4:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="JAS 4:17" />एकोलाय जोन कोनी भलाई करनो जानासे अना नही करा वोको लाई यो पाप से।<verse eid="JAS 4:17" /></para>
  <chapter eid="JAS 4" />
  <chapter number="5" style="c" sid="JAS 5" />
  <para style="p">
    <verse number="1" style="v" sid="JAS 5:1" />अगो धनी गीन, आयक लेव, तुमी अपरो आवन वारा दुख गीन लाय चील्लाय-चील्लाय के रड़ो। <verse eid="JAS 5:1" /><verse number="2" style="v" sid="JAS 5:2" />तुमरो धन बिगड गईसे, अना तुमरो कपरा ला किड़ा-काटकुर खाय गईसेत। <verse eid="JAS 5:2" /><verse number="3" style="v" sid="JAS 5:3" />तुमरो सोनो-खुरो मा काई लगी गईसे। अना वा काई तुमरो पर गवाही देहे, अखीन इस्तो को जसो तुमरो माँस ला खाय डाकेत। <verse eid="JAS 5:3" /><verse number="4" style="v" sid="JAS 5:4" />चोवो जोन कामदार गीन न तुमरो खेत कापन उनकी वा मजदुरी जोन तुमी न धोखा देयके राख लेई सेस चिलाय रही से अना लेवन वालो की दोहाई सेना गीन को पिरभू को कान गीन तकन पहुच गईसे। <verse eid="JAS 5:4" /><verse number="5" style="v" sid="JAS 5:5" />तुमी धरती पर भोग-विलास मा मन लगया रहोवो अना मोठो सुख भोगो तुमी न एना मरन को दिवस को लाई अपरो आतमा को पालन-पोसन करके वोको मोठो ताजो करीस। <verse eid="JAS 5:5" /><verse number="6" style="v" sid="JAS 5:6" />तुमी न न्यायी ला दोसी ठहरायके मार डाकिस उ तुमरो सामना नही करतो।<verse eid="JAS 5:6" /></para>
  <para style="s">धिरज अना विनती</para>
  <para style="p">
    <verse number="7" style="v" sid="JAS 5:7" />एकोलाय अरे भाऊ गीन पिरभू को आवनो तकन धीर-धरो। देखो किसान जमीन की बेस किमती फसल की आसा राखतो हुयो पहेल अना आखीर बरसआ होवनो तकन धीरज धरो। <verse eid="JAS 5:7" /><verse number="8" style="v" sid="JAS 5:8" />तुमी भी मन मा धीरज धरो अना अपरो आतमा ला पक्को करो काहेकी पिरभू को आवन जवर से।<verse eid="JAS 5:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="JAS 5:9" />अगा भाऊ गीन एक दुसरो पर दोस नही लगावो ताकि तुमी दोसी नही ठहरावो देखो न्याय करनवालो बेसकुड़ मा उभो से। <verse eid="JAS 5:9" /><verse number="10" style="v" sid="JAS 5:10" />अगा भाऊगीन जोन भविस्यवक्ता गीन न पिरभू को नाव लक गोस्टी करीसेत उनको दुख उठावन अना धीरज धरन को एक साजरो समझो। <verse eid="JAS 5:10" /><verse number="11" style="v" sid="JAS 5:11" />दिसो हमी धीरज धरन वारा ला धन्य कव्हसेजन। तुमी न अय्युब को धीरज को बिसय मा त आयकासेव अना पिरभू को कन लक जोन उनको प्रतिफर भयो वोला भी जानलेइसेव। जोको लक मालुम होवासेत का पिरभू कितरो दयालु सेत। अना उ लगत करुना करासेत।<verse eid="JAS 5:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="JAS 5:12" />पर अगा मोरा भाऊ गीन सबरी गोस्टी लक मोठा सेव का किरया नही खाना नही सरग की न धरती की न कोनी अना चीज पर तुमरी गोस्टी होय को होय अना नही को नही तुमी दंड को योग न ठहयारावो। <verse eid="JAS 5:12" /><verse number="13" style="v" sid="JAS 5:13" />अदी तुमी मा लक कोनी ला दुख से त उ पिराथना करहे अदी खुसी से त उ स्तुति को गाना गाहे। <verse eid="JAS 5:13" /><verse number="14" style="v" sid="JAS 5:14" />अदी तुमी मा लक कोनी बीमार से त कलीसिया को सयानो गीन ला बुलावो अना वय पिरभू को नाव लक वोको पर तेल लगाय के वोको लाई पिराथना करेत। <verse eid="JAS 5:14" /><verse number="15" style="v" sid="JAS 5:15" />अना बिस्वास की पिराथना लक बीमार बच जाहे अना पिरभू वोला उभो करके अखीन अदी पाप भी करी रहेस त उनकी भी छिमा भय जाहे। <verse eid="JAS 5:15" /><verse number="16" style="v" sid="JAS 5:16" />एकोलाय तुमी आपसी मा एक दुसरो को पुड़ा अपरो-अपरो पाप गीन ला मान लेव लेने अना एक दुसरो को लाई पिराथना करो जेनको लक साजरा भय जाहो धरमी जन की पिराथना लक लगत काही होहे सकासे। <verse eid="JAS 5:16" /><verse number="17" style="v" sid="JAS 5:17" />एलिय्याह भी त हमरो जसो दुख-सुख भोगी मानूस होतो अखीन वोना गिडगिडायके पिराथना करीस बादर नही बरसे अना साडे तीन बरस तकन धरती पर बादर नही बरसे। <verse eid="JAS 5:17" /><verse number="18" style="v" sid="JAS 5:18" />मंग वोना पिराथना की त बादर लक बरसा हुई अना धरती फर वालो भई।<verse eid="JAS 5:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="JAS 5:19" />अगा मोरा भाऊ गीन अदी तुमी मा लक कोनी खरो रास्ता लक भटक जाहे अना कोनी वोला फेरा लक मजे। <verse eid="JAS 5:19" /><verse number="20" style="v" sid="JAS 5:20" />त उ यो जान लेहे का जोन कोनी भटकयो हुयो पापी ला लौटायके आनेत, उ एक जियान ला मरनो लक बचायो अना लगत सा पाप गीन पर परदा डाके।<verse eid="JAS 5:20" /></para>
  <chapter eid="JAS 5" />
</usx>