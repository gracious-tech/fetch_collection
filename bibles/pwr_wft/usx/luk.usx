<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="LUK" style="id">- Powari Standard Project</book>
  <para style="h">लूका</para>
  <para style="toc3">लूका</para>
  <para style="toc2">लूका</para>
  <para style="toc1">लूका लक लिख्यो यीसु मसीह को साजरा बारता</para>
  <para style="mt2">लूका के व्दारा लिखा यीसु मसीह का सुसमाचार</para>
  <para style="mt1">लूका लक लिख्यो यीसु मसीह को साजरा बारता</para>
  <para style="imt">परिचय</para>
  <para style="ip">लूका रचित सुसमाचार नवा करार की उन चार किताब गीन लक एक आय, जेको मा यीसु को जिंदगी को बारे मा से। उन हर एक किताब गीनला साजरा बारता कह्यो गयो सेत। यीसु को मरन को बाद मत्ती, मरकुस, अखिन योहन ना यो किताब गिनला लिख्यो से। लूका न सीरप यीसु को जिंदगी को बारता च नही लिख्यो, बल्की ओको मरन को बाद ओको चेलागिन को काम को बारे म भी लिख्यो। “पेरीत को काम” नाव की किताब मा एको बारे मा वाचन ला भेटयो सेत। लूका को साजरा बारता कहांन अखिन कब लिख्यो गयो से एको बारे मा पक्को मालूम नहाय? पर लगत सो वाचन वालो यो माना सेत का लूका लक लिख्यो साजरा बारता यीसु को जलम को करीब 70 साल को बाद लिख्यो गयो से।</para>
  <para style="ip">या किताब को लेखक खुद लूका आय जोन बईद होतो। ओको लिखन को तरीका अखीन भासा लक यो पता चला से का लूका एक पढ़यो लिख्यो मानूस होतो। लूका चाहत होतो की यीसु को जिंदगी को घटना ला सही-सही लिख्यो जाये, अखिन घटनागीन जसो भयी ठीक वसोच लिख्यो जाये, जोन लक उनको बारेमा वाच के फायदा होये। लूका यहूदी नहीं होतो। <char style="xt"><ref loc="COL 4:10-14">कुलुस्सियो 4:10-14</ref></char> ओना असो परकार लक लिख्यो का गैरयहूदी भी ओकी लिखित साजरा बारता सरलता लक समज सके, जोन परकार लक यहूदी रीति रिवाज गिनको बारे मा लिखयो गयो से, ओको लक यो पता चलयो से। <char style="xt"><ref loc="LUK 1:8">1:8</ref></char></para>
  <para style="ip">लगत मातरा मा लूका लक लिख्यो साजरा बारता मत्ती अना मरकुस को किताब गीन जसी से। तीन च किताब गीनमा उच घटना गीनको बारेमा एक जसो सांगयो गयो सेत। पर लूका को किताब मा बप्तिस्मा देवन वालो योहन को जलम को बारे मा सब लक ज्यादा जानकारी मिला से। लूका मा “माफी को बारे मा सब लक ज्यादा लिख्यो से।” अध्याय <char style="xt"><ref loc="LUK 3:3">3:3</ref>; <ref loc="LUK 11:4">11:4</ref>; <ref loc="LUK 17:3-4">17:3-4</ref>; <ref loc="LUK 23:24">23:24</ref>; <ref loc="LUK 24:47">24:47</ref></char> अना पिराथना <char style="xt"><ref loc="LUK 3:21">3:21</ref>; <ref loc="LUK 5:16">5:16</ref>; <ref loc="LUK 6:12">6:12</ref>; <ref loc="LUK 11:1-12">11:1-12</ref>; <ref loc="LUK 22:32">22:32</ref></char> वालो मा जोर देवासे।</para>
  <para style="iot">रुपरेखा</para>
  <para style="io1">1. भूमिका <char style="ior"><ref loc="LUK 1:1-4">1:1-4</ref> </char></para>
  <para style="io1">2. योहन बप्तिस्मा देवनवारा, अना यीसु को जलम, बचपना। <char style="ior"><ref loc="LUK 1:5-2:52">1:5—2:52</ref> </char></para>
  <para style="io1">3. योहन बप्तिस्मा देवनवारा को जनता सेवा। <char style="ior"><ref loc="LUK 3:1-20">3:1-20</ref></char></para>
  <para style="io1">4. यीसु को बप्तिस्मा अना परखो जानो। <char style="ior"><ref loc="LUK 3:21-4:13">3:21—4:13</ref> </char></para>
  <para style="io1">5. गलील नगर मा यीसु को जनसेवा। <char style="ior"><ref loc="LUK 4:14-9:50">4:14—9:50</ref></char></para>
  <para style="io1">6. गलील ले येरुसलेम नगर तकन यातरा। <char style="ior"><ref loc="LUK 9:51-19:27">9:51—19:27</ref> </char></para>
  <para style="io1">7. येरुसलेम नगर मा आखीर हफ्ता। <char style="ior"><ref loc="LUK 19:28-23:56">19:28—23:56</ref> </char></para>
  <para style="io1">8. परभू को जित्तो होवनो, चोवनो अना सरग जानो। <char style="ior"><ref loc="LUK 24:1-53">24:1-53</ref> </char></para>
  <chapter number="1" style="c" sid="LUK 1"/>
  <para style="s">परिचय</para>
  <para style="s">थियुफिलुस को समरथन</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 1:1"/>ओ पियारो थियुफिलुस, जोन गोस्टी हमरो संग मा बितो से। मि ना उनला लिखन को मन बनाइ सेव हमरो लक <verse eid="LUK 1:1"/><verse number="2" style="v" sid="LUK 1:2"/>पयले यीसु को उन गोस्टी ला चोवन अखीन आयकन वालो दास होतिन। उनना सबच गोस्टी ला हमि तकन धाडिसेस। <verse eid="LUK 1:2"/><verse number="3" style="v" sid="LUK 1:3"/>एकोलाई अगो थियुफिलुस अबा मोला यो साजरो लगि से, का उनच, गोस्टी ला खरो-खरो जाँचकेना, एक को मघा एक, ठिख-ठाख मालुम करके लिखु। <verse eid="LUK 1:3"/><verse number="4" style="v" sid="LUK 1:4"/>जेनको लक तू जानले, का वा गोस्टी, अना जोन को गियान तुना पाईसेस। कसो अटल से?<verse eid="LUK 1:4"/></para>
  <para style="s">योहन बप्तिस्मा देवन वालो को जनम को बारे सांगनो</para>
  <para style="p">
    <verse number="5" style="v" sid="LUK 1:5"/>यहुदिया को राजा हेरोदेस<note caller="+" style="f"><char style="fr" closed="false">1:5 </char><char style="ft" closed="false">यहुदिया को राजा </char></note> को बेरा मा, अबिय्याह को दल मा, जकरयाह नाव को एक याजक होत्यो। अखीन वोको बायको हारून<note caller="+" style="f"><char style="fr" closed="false">1:5 </char><char style="ft" closed="false">मुसा गुरुजी को संगी</char></note> को खानदान की होति। अखीन वोको नाव एलीसीबा होती। <verse eid="LUK 1:5"/><verse number="6" style="v" sid="LUK 1:6"/>वय दुई परमेस्वर<note caller="+" style="f"><char style="fr" closed="false">1:6 </char><char style="ft" closed="false">यहोवा परमेस्वर</char></note> को नजर मा नेक होतीन। वय पिरभु को सबच, हुकूम ला मानत होतीन। <verse eid="LUK 1:6"/><verse number="7" style="v" sid="LUK 1:7"/>उन को कोनी लेकरा बारा नही होतिन। काहेका एलीसीबा वाखड होती, अखीन उ बुड़गा भई गई होतो।<verse eid="LUK 1:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="LUK 1:8"/>जब जकरयाह आपरो दल को सगंमा परमेस्वर को पुजा-पाट करत होतिन। <verse eid="LUK 1:8"/><verse number="9" style="v" sid="LUK 1:9"/>तबा धुप-जलावन काजी, जकरयाह याजक को नाव लक चिठ्ठी हिट्यो। का उ मंदिर मा पिरभु को पूढा धुप जलाये। <verse eid="LUK 1:9"/><verse number="10" style="v" sid="LUK 1:10"/>तबा धूप जालावन को बेरा मा, सबच बिनती करत होतिन।<verse eid="LUK 1:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="LUK 1:11"/>ओच बेरा मा पिरभु को सरगदूत ओला धुप वेदी<note caller="+" style="f"><char style="fr" closed="false">1:11 </char><char style="ft" closed="false">एक बरतन जोनमा स्‍तो रखकर सुगँधित द्रव्य जलावासे।</char></note> को उज्जो कन चोवयो। <verse eid="LUK 1:11"/><verse number="12" style="v" sid="LUK 1:12"/>जकरयाह डराय गयो, अखीन ओको “घिघगि बंध गयो।” <verse eid="LUK 1:12"/><verse number="13" style="v" sid="LUK 1:13"/>पर सरगदूत<note caller="+" style="f"><char style="fr" closed="false">1:13</char><char style="ft" closed="false">खास स्वरगीय जीव जोन परमेस्वर को काम करासेत। </char></note> न ओला सांगिस, ओ जकरयाह, भेव नोको खावजोस, काहेका तोरो पिराथना परमेस्वर ना आयक, लेइस। अखीन तोरि बायको एलीसीबा लक, तोरो लाय एक टूरा होहेत, अखीन तु वोको नाव योहन राखजोस। <verse eid="LUK 1:13"/><verse number="14" style="v" sid="LUK 1:14"/>तोला खुसी होहे। अखीन गजब लोकगीन, वोको जनम को कारन, खुसी मनाहेत। <verse eid="LUK 1:14"/><verse number="15" style="v" sid="LUK 1:15"/>काहे का उ पिरभु को पुढ़ा, मा महान होयेत। अखीन अंगूर को रस, अर दारु, कभी नही पिहेत। अखीन उ आपरो माय को पोट लक, पवीतर आतमा लक भरो होयेत। <verse eid="LUK 1:15"/><verse number="16" style="v" sid="LUK 1:16"/>अखीन भटको हुओ, इसरायल<note caller="+" style="f"><char style="fr" closed="false">1:16 </char><char style="ft" closed="false">इसहाक को टूरा याकूब जोन बारा गोत को अजी भयो। </char></note> को गजब लोकगीन ला, उनको परमेस्वर को रास्ता मा आनेत। <verse eid="LUK 1:16"/><verse number="17" style="v" sid="LUK 1:17"/>उ एलिय्याह<note caller="+" style="f"><char style="fr" closed="false">1:17 </char><char style="ft" closed="false">जूनो करार को लगत मोठो भबिस्यवक्ता</char></note> को आतमा अखीन ताकत मा, पुढा-पुढा चलेत, क आजा पुरखागीन को मन ला, लेकरा-बारा मा लगा देहेत। अखीन हुकूम नही मानन वालो ला, नेक बना देहेत। अखीन पिरभु को लाई, साजरो लोकगीन ला, तैय्यार करयेत।<verse eid="LUK 1:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="LUK 1:18"/>जकरयाह ना सरगदूत सांग्यो, यो कसो होयेत? काहेकी मी, अखीन मोरो बायको, दूई को बुडगापन से।<verse eid="LUK 1:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="LUK 1:19"/>तब सरगदूत ना वोला जवाब दियो, मी जिबराइल सरगदूत सेव। जोन परमेस्वर को पुढा उभो रहुसु, अखीन तोरो लक बात करन, अखीन यो खबर आयकावन काजी इता आईसेव। <verse eid="LUK 1:19"/><verse number="20" style="v" sid="LUK 1:20"/>जोन दिवस तकन यो गोस्टी पूरो होहेत, ओना दिवस तकन तू गुंगो रव्हजो। काहेका तू मोरी गोस्टी पर भरोसा नही मानीसेस।<verse eid="LUK 1:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="LUK 1:21"/>लोग गीन जकरयाह को “बाट जोहत होतिन” अखीन चकित भईन। काहे का मंदिर मा, वोला उसीर भई गई होती। <verse eid="LUK 1:21"/><verse number="22" style="v" sid="LUK 1:22"/>जब उ बाहेर हिटयो, तो उ बोल ना सकयो, तब लोकगीन जान गईन, का मंदिर <note caller="+" style="f"><char style="fr" closed="false">1:22 </char><char style="ft" closed="false">यहुदि गिनको मंदिर जोनला राजा सुलेमान ना बनवायो होतो। </char></note>पर कोनी दरस-परस भयो से। अखीन उ ईसारा करत होतो, अखीन गुगों भय गयो होतो।<verse eid="LUK 1:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="LUK 1:23"/>जब वोको सेवा को दिवस पूरो भयो, तो उ आपरो घर चलो गयो। <verse eid="LUK 1:23"/><verse number="24" style="v" sid="LUK 1:24"/>काही बेरा को बादमा वोको बायको एलीसीबा पेट लक भई। वो 5 मास तकन आपरो ला छुपाय राखयो। <verse eid="LUK 1:24"/><verse number="25" style="v" sid="LUK 1:25"/>अखीन कव्हन लगयो, मोरो कलंक दुर करन काजी, पिरभु न किरपा करीसेस।<verse eid="LUK 1:25"/></para>
  <para style="s">यीसु को जनम को पूढा सांगनो</para>
  <para style="p">
    <verse number="26" style="v" sid="LUK 1:26"/>छँटवो महीना मा, परमेस्वर कन लक, एक कुँवारी को कन जिबराइल सरगदूत<note caller="+" style="f"><char style="fr" closed="false">1:26 </char><char style="ft" closed="false">परमेस्वर को मुख्य स्वरगदूत जोन सँदेस आनत अखिन लेजात होतीन। </char></note> नाव को, सरग दूत ला धाडिस। वा टूरी गलील छेतर को, नासरत नगर मा, रव्हन वालो होती। <verse eid="LUK 1:26"/><verse number="27" style="v" sid="LUK 1:27"/><note caller="-" style="x"><char style="xo" closed="false">1:27 </char><char style="xt" closed="false"><ref loc="MAT 1:18">मत्ती 1:18</ref></char></note>जोकि पक्की राजा दाऊद<note caller="+" style="f"><char style="fr" closed="false">1:27 </char><char style="ft" closed="false">यिसै को टूरा जोन भेड़ चरावन वालो होतीन। </char></note> को खानदान मा, यूसुफ नामको टूरा संग भई होती। ओ कुँवारी टूरी को नाव मरियम होती। <verse eid="LUK 1:27"/><verse number="28" style="v" sid="LUK 1:28"/>सरग दूत ना, ओको कठा जायके सांगिस, नमस्कार<note caller="+" style="f"><char style="fr" closed="false">1:28 </char><char style="ft" closed="false">खुसहाली अना जय तोरो होय। </char></note> मरियम, पिरभु को किरपा तोरो पर भईसे।<verse eid="LUK 1:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="LUK 1:29"/>अखीन, यो बात ला आयक के, वा टूरी घबराय गई, अखी मनमा सोचन लगी, यो कसी गोस्टिसे? <verse eid="LUK 1:29"/><verse number="30" style="v" sid="LUK 1:30"/>तबा सरगदूत ना कहीस, मरियम तु भेव नोको कर, परमेस्वर को किरपा तोरो पर भईसे। <verse eid="LUK 1:30"/><verse number="31" style="v" sid="LUK 1:31"/>चोव! तु पोट लक होवजोस, अखीन तोरो लक एक टूरा जनम लेहे, तु ओको नाव यीसु<note caller="+" style="f"><char style="fr" closed="false">1:31</char><char style="ft" closed="false">परमेस्वर आमरो संग से</char></note> राखजो।<note caller="-" style="x"><char style="xo" closed="false">1:31 </char><char style="xt" closed="false"><ref loc="MAT 1:21">मत्ती 1:21</ref></char></note> <verse eid="LUK 1:31"/><verse number="32" style="v" sid="LUK 1:32"/>उ महान होहे अखीन पिरभु को टूरा कहलाहे। परमेस्वर वोको आजा-पुरखा, दाऊद को सिघासन<note caller="+" style="f"><char style="fr" closed="false">1:32</char><char style="ft" closed="false">दाउद को राज-पद</char></note> वोला देहे। <verse eid="LUK 1:32"/><verse number="33" style="v" sid="LUK 1:33"/>अना उ तोरो पुरखा, याकूब को घराना मा, जुग-जुग लक राज करहे, अखीन वोको राज अमर<note caller="+" style="f"><char style="fr" closed="false">1:33</char><char style="ft" closed="false">हमेसा को लाय बनो रहेत </char></note> रहेत।<verse eid="LUK 1:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="LUK 1:34"/>मरियम ना सरगदूत ला कहीस, यो कसो होहे, मी तो, कोनी मरद को संग नही सोयी सेऊ।<verse eid="LUK 1:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="LUK 1:35"/>सरगदूत ना वोला साँगिस, पवीतर आतमा को ताकत तोरो पर आहेत, अखीन मोठो परमेस्वर तोरी, रक्सा करहे। एको लाई उ पवीतर, जो जनम लेवन-वालो से, परमेस्वर को टूरा कहलाहे। <verse eid="LUK 1:35"/><verse number="36" style="v" sid="LUK 1:36"/>अखीन देख, तोरो कुटुम्ब मा एलीसीबा लक वोला बुड़गीपन मा टूरा होवन वालो से। अब वोको छँटवो महीना से। <verse eid="LUK 1:36"/><verse number="37" style="v" sid="LUK 1:37"/>काहे की परमेस्वर की गोस्टी खरी ठयरासे। कभी खोटो<note caller="+" style="f"><char style="fr" closed="false">1:37 </char><char style="ft" closed="false">निस्फल </char></note> नही होवासे।<verse eid="LUK 1:37"/></para>
  <para style="p">
    <verse number="38" style="v" sid="LUK 1:38"/>मरियम ना सांगिस, चोव, मी, पिरभु की सेविका सेउ। मोला तु जसो सांगासे, वसोच गोस्टी भई जाहे। तब सरगदूत ओको कठा लक चलो गयो।<verse eid="LUK 1:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="LUK 1:39"/>वो ना बेरा मा, मरियम लवकर तैय्यार भई अखीन आपरो कुटुम्बी एलीसीबा को यहूदा देस को पहाड़ी गांव मा गई। <verse eid="LUK 1:39"/><verse number="40" style="v" sid="LUK 1:40"/>वो जकरयाह को घर मा गई। अखीन एलीसीबा ला नमस्कार करीस। <verse eid="LUK 1:40"/><verse number="41" style="v" sid="LUK 1:41"/>जेंधावर एलीसीबा ना, मरियम को नमस्कार आयकिस, तसोच, वोको लेकरा पोट मा उचलो, अना उ पवीतर आतमा लक भर गई। <verse eid="LUK 1:41"/><verse number="42" style="v" sid="LUK 1:42"/>अना वा चिल्ला के कहीस, तु सबच आई-माई गीनमा धन्य से। अना धन्य से तोरो पोट को फर। <verse eid="LUK 1:42"/><verse number="43" style="v" sid="LUK 1:43"/>मोरो ऊँचो किस्मत से का, मोरो पर दया कसो भई? पिरभू को माय मोरो घरमा आई सेस। <verse eid="LUK 1:43"/><verse number="44" style="v" sid="LUK 1:44"/>काहेका, जसो तोरो नमस्कार मीना आयकीसेव, लेकरा मोरो पोट मा, खुसी लक उछल पडयो। <verse eid="LUK 1:44"/><verse number="45" style="v" sid="LUK 1:45"/>तू धन्य सेस, जोन ना बिस्वास लक असो करीसेस, का पिरभू ना जोन गोस्टी साँगीसेस, वो पूरी भई जाहेत।<verse eid="LUK 1:45"/></para>
  <para style="s">मरियम को गाना</para>
  <para style="p">
    <verse number="46" style="v" sid="LUK 1:46"/>एको पर मरियम असो गावन लगी,</para>
  <para style="q1" vid="LUK 1:46">“मोरी जीव (मन) पिरभु को गुन-गान करासे।” <verse eid="LUK 1:46"/><verse number="47" style="v" sid="LUK 1:47"/>मोरो जीव, आपरो मुक्ती देवन वालो,</para>
  <para style="q2" vid="LUK 1:47">परमेस्वर को खुसी मनावसे। <verse eid="LUK 1:47"/><verse number="48" style="v" sid="LUK 1:48"/>काहे का वोना आपरो सेविका को गरीबी<note caller="+" style="f"><char style="fr" closed="false">1:48 </char><char style="ft" closed="false">दीनता</char></note> पर,</para>
  <para style="q2" vid="LUK 1:48">किरपा करीसेस। अब लक सब पीड़ी,</para>
  <para style="q1" vid="LUK 1:48">मोला धन्य कहेति। <verse eid="LUK 1:48"/><verse number="49" style="v" sid="LUK 1:49"/>काहे का, गजब सक्तिसाली परमेस्वर ना,</para>
  <para style="q2" vid="LUK 1:49">मोरो लाय मोठयो काम करीसेस,</para>
  <para style="q1" vid="LUK 1:49">पवीतर से वोको नाव। <verse eid="LUK 1:49"/><verse number="50" style="v" sid="LUK 1:50"/>वोको तरस वोको भविस्यवक्ता गीन पर,</para>
  <para style="q2" vid="LUK 1:50">पीढ़ी-पीढ़ी लक बनो रव्हसे। <verse eid="LUK 1:50"/><verse number="51" style="v" sid="LUK 1:51"/>परमेस्वर ना अपरो ताकत दिखाईसेस, वोना घमन्डी गीन ला,</para>
  <para style="q2" vid="LUK 1:51">छितराय देईसे। <verse eid="LUK 1:51"/><verse number="52" style="v" sid="LUK 1:52"/>वोना मोठो अधिकारी गिनला,</para>
  <para style="q1" vid="LUK 1:52">उनको सिघासन लक उतार दियो से।</para>
  <para style="q2" vid="LUK 1:52">अखीन, गरिब<note caller="+" style="f"><char style="fr" closed="false">1:52 </char><char style="ft" closed="false">दीन </char></note> ला, महान बनायो से।<verse eid="LUK 1:52"/></para>
  <para style="q1">
    <verse number="53" style="v" sid="LUK 1:53"/>वोना भुखो-लाघो गिनला, साजरो-साजरो जेवन देइसेस।</para>
  <para style="q2" vid="LUK 1:53">अखीन धनी गिनला,</para>
  <para style="q2" vid="LUK 1:53">रिकामो हात लौटा दियो से।<verse eid="LUK 1:53"/></para>
  <para style="q1">
    <verse number="54" style="v" sid="LUK 1:54"/>वोना अपरो दया, ला ध्यान देके ना, आपरो दास इसरायल ला</para>
  <para style="q2" vid="LUK 1:54">संभालयो से। <verse eid="LUK 1:54"/><verse number="55" style="v" sid="LUK 1:55"/>जसो कसम, हमरो बाप-दादा लक खायो होतो।</para>
  <para style="q1" vid="LUK 1:55">का अबराहम अखीन ओको सन्तान पर,</para>
  <para style="q2" vid="LUK 1:55">परमेस्वर को करुना सदा बनो रहेत।<verse eid="LUK 1:55"/></para>
  <para style="p">
    <verse number="56" style="v" sid="LUK 1:56"/>तीन महीना मरियम एलीसीबा को घर रहकेना, अपरो घर आय गई।<verse eid="LUK 1:56"/></para>
  <para style="s">योहन बप्तिस्मा देवन वालो को जलम</para>
  <para style="p">
    <verse number="57" style="v" sid="LUK 1:57"/>एलीसीबा को जचकी को बेरा पूरो भयी। अखीन वोना एक टूरा ला जलम दियो। <verse eid="LUK 1:57"/><verse number="58" style="v" sid="LUK 1:58"/>जब वोको पड़ोसी, अखीन रिस्तेदार ना यो बात आयकिन, का पिरभु को किरपा से। तब सब वोको संग खुसी मा सामील भईन।<verse eid="LUK 1:58"/></para>
  <para style="p">
    <verse number="59" style="v" sid="LUK 1:59"/>आठवा दिवस टूरा को खतना<note caller="+" style="f"><char style="fr" closed="false">1:59 </char><char style="ft" closed="false">नाव रखना</char></note> को बेरा आयो। तब लोकगीन वोको नाव वोको बाबूजी जकरयाह को नाव पर, राखन चाव्हत होतीन। <verse eid="LUK 1:59"/><verse number="60" style="v" sid="LUK 1:60"/>पर वोको माय ना सांगीस, नही, एको नाव योहन राखबिन।<verse eid="LUK 1:60"/></para>
  <para style="p">
    <verse number="61" style="v" sid="LUK 1:61"/>तब वोना लोकगीन कव्हन लगीन, तुम्हारो कुटुम्ब मा, कोनी को असो नाव नहात। <verse eid="LUK 1:61"/><verse number="62" style="v" sid="LUK 1:62"/>तब लोकगीन ईसारा करके वोको बाबूजी लक पुसन लगीन, उ का नाव राखन चाव्हसेस।<verse eid="LUK 1:62"/></para>
  <para style="p">
    <verse number="63" style="v" sid="LUK 1:63"/>वोना पाटी मागंके ओमा योहन नाव लिख्यो। <verse eid="LUK 1:63"/><verse number="64" style="v" sid="LUK 1:64"/>वोच बेरा मा, जकरयाह को जुबान खुल गयो, अखीन उ परमेस्वर को धन्यवाद करन लगयो। <verse eid="LUK 1:64"/><verse number="65" style="v" sid="LUK 1:65"/>तब सब सेजारीगीन मा भेव छाय गयो। अखीन उनको गांव को आखा-पाखा मा अना यहुदिया देस मा यो गोस्टी को चरचा फैल गयो। <verse eid="LUK 1:65"/><verse number="66" style="v" sid="LUK 1:66"/>सब आयकन वारा मन मा विचार के, ना कव्हन लगीन, का यो लेकरा का बनहेत? काहे का सचमूच मा पिरभु को “वोको पर हात होतो।”<verse eid="LUK 1:66"/></para>
  <para style="s">जकरयाह को भजन</para>
  <para style="p">
    <verse number="67" style="v" sid="LUK 1:67"/>योहन को दादजी जकरयाह, पवीतर आतमा लक भर गयो। अखीन असो कव्हत, आवन वारो गोस्टी साँगन लग्यो।<verse eid="LUK 1:67"/></para>
  <para style="q1">
    <verse number="68" style="v" sid="LUK 1:68"/>धन्य से इसरायल को परमेस्वर, वोना आपरो लोकगीन को सूधी लेवासे,</para>
  <para style="q2" vid="LUK 1:68">अखीन उनको मोक्स करोसे। <verse eid="LUK 1:68"/><verse number="69" style="v" sid="LUK 1:69"/>अखीन आपरो दास दाऊद को घराना,</para>
  <para style="q1" vid="LUK 1:69">लक एक सूटकारा देवन वालो</para>
  <para style="q2" vid="LUK 1:69">सींग<note caller="+" style="f"><char style="fr" closed="false">1:69</char><char style="ft" closed="false">यो ताकत को निसान से। </char></note> हिटिसे। <verse eid="LUK 1:69"/><verse number="70" style="v" sid="LUK 1:70"/>उ आपरो पवीतर भविस्यवक्ता को टोन्ड ले,</para>
  <para style="q1" vid="LUK 1:70">पूरानो जमाना लक, यो कव्हतो आयो सेस। <verse eid="LUK 1:70"/><verse number="71" style="v" sid="LUK 1:71"/>क उ बैरी अखीन सब</para>
  <para style="q2" vid="LUK 1:71">बैरी हुन को हात लक,</para>
  <para style="q2" vid="LUK 1:71">हमीला सूटकारा करीसेस। <verse eid="LUK 1:71"/><verse number="72" style="v" sid="LUK 1:72"/>का आमरो बाबूजी दादजी पर</para>
  <para style="q1" vid="LUK 1:72">दया करके आपरी</para>
  <para style="q2" vid="LUK 1:72">पवीतर वायदा ला हेत करयेत। <verse eid="LUK 1:72"/><verse number="73" style="v" sid="LUK 1:73"/>वोना किरया खायके ना,</para>
  <para style="q1" vid="LUK 1:73">हमारो पुरखा अबराहम लक, असो सांग्यो होतो। <verse eid="LUK 1:73"/><verse number="74" style="v" sid="LUK 1:74"/>क उ हमारो दुस्मन को हाथ लक,</para>
  <para style="q2" vid="LUK 1:74">हमीला छुड़ाय लेहेत।<verse eid="LUK 1:74"/></para>
  <para style="q1">
    <verse number="75" style="v" sid="LUK 1:75"/>जोन को लक हमी बेधड़क,</para>
  <para style="q1" vid="LUK 1:75">पवीतर, अखीन न्यायी पन लक</para>
  <para style="q2" vid="LUK 1:75">वोको सेवा करयेत। <verse eid="LUK 1:75"/><verse number="76" style="v" sid="LUK 1:76"/>उ टूरा सब लक मोठो परमेस्वर को भविस्यवक्ता कहलाव जोस,</para>
  <para style="q1" vid="LUK 1:76">तू पिरभू को पूढ़ा चलन वालो दूत बनजो!</para>
  <para style="q1" vid="LUK 1:76">तू वोको मारग</para>
  <para style="q2" vid="LUK 1:76">तैय्यार करजो। <verse eid="LUK 1:76"/><verse number="77" style="v" sid="LUK 1:77"/>अखीन वोको लोकगीन ला,</para>
  <para style="q1" vid="LUK 1:77">उनको पाप छिमा को कन लक,</para>
  <para style="q2" vid="LUK 1:77">मुकती को गियान देवजोस। <verse eid="LUK 1:77"/><verse number="78" style="v" sid="LUK 1:78"/>हमारो परमेस्वर को यो माया,</para>
  <para style="q1" vid="LUK 1:78">अखीन दया लक, हमी ला सरग लक,</para>
  <para style="q1" vid="LUK 1:78">उजाड़ो मिलहेत। <verse eid="LUK 1:78"/><verse number="79" style="v" sid="LUK 1:79"/>जेनको लाय उ इन्धीयारो अखीन,</para>
  <para style="q2" vid="LUK 1:79">मरन को सावली मा, जो लोग बस्यो से,</para>
  <para style="q2" vid="LUK 1:79">वोला उजाडो देवजो! अखीन हामरो पाय ला सान्ती को रास्ता मा ले जाहेत।<verse eid="LUK 1:79"/></para>
  <para style="p">
    <verse number="80" style="v" sid="LUK 1:80"/>लेकरा योहन मोठो होवन लग्यो, अखीन वोको आतमा बल बढन लगयो! उ इसरायल को सामने चोवनो को पूढ़ा सुनसान जघा मा रव्हन लग्यो।<verse eid="LUK 1:80"/></para>
  <chapter eid="LUK 1"/>
  <chapter number="2" style="c" sid="LUK 2"/>
  <para style="s">पिरभू यीसु को जनम</para>
  <para style="r">(<ref loc="MAT 1:18-25">मत्ती 1:18-25</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 2:1"/>ओना बेरा मा राजा औगुस्तुस कैसर को कना लक हुकूम हिटयो, क सारो जग का लोकईन को नाव लिखवान की जाये। <verse eid="LUK 2:1"/><verse number="2" style="v" sid="LUK 2:2"/>यो पयलो नाव लिखवाई वोना बेरा भयो, जब किवरिनियुस सीरिया को राजा होतो। <verse eid="LUK 2:2"/><verse number="3" style="v" sid="LUK 2:3"/>सब लोग आपरो-आपरो नाव लिखवान काजी आपरो नगर मा गइन।<verse eid="LUK 2:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="LUK 2:4"/>मंघा यूसुफ अखीन मरियम, आपरो नाव लिखावन काजी गलील को नासरत नगर ले, यहुदिया मा दाऊद को नगर बैतलेहम मा गईन। <verse eid="LUK 2:4"/><verse number="5" style="v" sid="LUK 2:5"/>वहान दूई युसूफ अना मरियम जोनको पक्की भयी होती जायके आपरो नाव लिखवान गईन। <verse eid="LUK 2:5"/><verse number="6" style="v" sid="LUK 2:6"/>जब उ दोई वोच नगर मा होतीन, तब मरियम को जचकि को बेरा भई गयी।<verse eid="LUK 2:6"/></para>
  <para style="s">चरवाहागिन ला सरगदूत को सन्देसा</para>
  <para style="p">
    <verse number="7" style="v" sid="LUK 2:7"/>उनको रुकन को लाय सराय मा, जघा नही होतो। यो काजी वय गाई-बईल को कोठा मा रुकिन। अखीन वोको पयलो टूरा वहांच भयो, अखीन वोला कपरा मा लपेट केना, गव्हान मा राखीस। <verse eid="LUK 2:7"/><verse number="8" style="v" sid="LUK 2:8"/>देस मा केतरा गडेरिया होतीन, जोई रात ला मैदान मा रहके, आपरो करप को निगरानी करत होतिन। <verse eid="LUK 2:8"/><verse number="9" style="v" sid="LUK 2:9"/>तबा परमेस्वर को एक सरगदूत, उनको जवर आयके, उभो भयो। अना पिरभू को तेज, चमकन लगयो, तबा उन गजब डराय गईन। <verse eid="LUK 2:9"/><verse number="10" style="v" sid="LUK 2:10"/>परमेस्वर को सरगदूत उनला कव्हसे, नोको डराव चोवो, मी तुम्ही ला मोठयो खुसी को साजरो बारता सांगसू। जो सब लोग लाय होहे। <verse eid="LUK 2:10"/><verse number="11" style="v" sid="LUK 2:11"/>आज दाऊद को नगर मा तुमरो लाय एक पाप मोचक जन्म लेईसे योच मसीह<note caller="+" style="f"><char style="fr" closed="false">2:11</char><char style="ft" closed="false">अभिसिक्त</char></note> पिरभू से। <verse eid="LUK 2:11"/><verse number="12" style="v" sid="LUK 2:12"/>योको यो निसान सेत का तुमही एक टूरा ला कपरा मा लिपटो गव्हान मा रख्यो पावजो।<verse eid="LUK 2:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="LUK 2:13"/>तबा एकाएक लक उ परमेस्वर को सरग दूत संग अना दूतगिन भी परमेस्वर की भक्ती करत अना यो सांगत चोवयो।<verse eid="LUK 2:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="LUK 2:14"/>सरग मा परमेस्वर की बड़ाई अना</para>
  <para style="q2" vid="LUK 2:14">धरती मा उन मानूस लक जिन लक खुस से, अखीन सान्ती होय।<verse eid="LUK 2:14"/></para>
  <para style="s">मेढा चरावनवारो गीन लक भेंट</para>
  <para style="p">
    <verse number="15" style="v" sid="LUK 2:15"/>जब पिरभू को सरगदूत उनको जवर लक सरग मा गईन। तो गडरिया ना आपस मा कव्हन लगीन। आओ हमि बैतलेहम जायके, जो हमला परमेस्वर को दुत सांगिसेस देखबिन।<verse eid="LUK 2:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="LUK 2:16"/>तब उनना गदने जायके मरियम अना यूसुफ ला, अखी गव्हान मा उ टूरा ला पड़यो चोविन। <verse eid="LUK 2:16"/><verse number="17" style="v" sid="LUK 2:17"/>ऐना ला चोवके, उनना वा सबद जो यो टूरा को बारे मा सरगदूत सागयो होतो, उन लक सांगन लगीन <verse eid="LUK 2:17"/><verse number="18" style="v" sid="LUK 2:18"/>अना गडरिया को गोस्टी आयक के सब आयकन वालो ना अचंभा करीन। <verse eid="LUK 2:18"/><verse number="19" style="v" sid="LUK 2:19"/>पर मरियम यो सब कव्हनो ला, आपरो मन मा सोचत होती। <verse eid="LUK 2:19"/><verse number="20" style="v" sid="LUK 2:20"/>अखीन गडरिया जसो उनला कव्हयो होतो, वसोच चोवके, वोना लोकगीन, परमेस्वर को बड़ाई अना भक्ति करत-करत लवट गईन।<verse eid="LUK 2:20"/></para>
  <para style="s">यीसु को नाव राखनो</para>
  <para style="p">
    <verse number="21" style="v" sid="LUK 2:21"/>सरगदूत को कव्हन को लक, आठ दिवस को मंघा, जब लेकरा को खतना<note caller="+" style="f"><char style="fr" closed="false">2:21</char><char style="ft" closed="false">नावकरन</char></note> को बेरा आयो। तब वोको नाव यीसु राखयो, काहे का सरगदुत ना, पुढा मा असोच सांगयो होतो<note caller="-" style="x"><char style="xo" closed="false">2:21 </char><char style="xt" closed="false"><ref loc="LUK 1:31">लूका 1:31</ref></char></note>।<verse eid="LUK 2:21"/></para>
  <para style="s">यीसु को अरपन कियो जानो</para>
  <para style="p">
    <verse number="22" style="v" sid="LUK 2:22"/>मोसे को नियम को लक, जब लेकरा को अरपन लक सुध्द करन को दिवस आयो। ता वय ओला येरुसलेम मा आनीन की पिरभू को पुढा<note caller="+" style="f"><char style="fr" closed="false">2:22 </char><char style="ft" closed="false">परमेस्वर को पुढ़ा </char></note> लाहेत। <verse eid="LUK 2:22"/><verse number="23" style="v" sid="LUK 2:23"/>जसो का मोसे को नियम मा लिख्योसे, हर एक पयलो टूरा, पिरभू को लाय पवीतर मानो जाय। <verse eid="LUK 2:23"/><verse number="24" style="v" sid="LUK 2:24"/>अखीन एको लाय भी का, उ मोसे को नियम को हुकूम लक, परेवा को एक जोड़ा, या दोन बच्चा पिरभू को लाय बली चघाइन। <note caller="+" style="f"><char style="fr" closed="false">2:24 </char><char style="ft" closed="false">बलिदान चघायो </char></note><verse eid="LUK 2:24"/></para>
  <para style="s">सिमोन को गाना</para>
  <para style="p">
    <verse number="25" style="v" sid="LUK 2:25"/>ओना बेरा येरुसलेम नगर मा, सिमोन नाव को, एक नेक मानूस रव्हत होतो। उ इसरायल को सान्ती को बाट चोवत होतो। पवीतर आतमा ओको पर होतो। <verse eid="LUK 2:25"/><verse number="26" style="v" sid="LUK 2:26"/>अखीन पवीतर आतमा लक, मिल्यो जानकारी को लक, जब तकन उ मसीह पिरभू को दरसन ना करलेहे नही मरन को, असो वोला बरदान होतो। <verse eid="LUK 2:26"/><verse number="27" style="v" sid="LUK 2:27"/>उ पवीतर आतमा ले मिलो जानकारी<note caller="+" style="f"><char style="fr" closed="false">2:27</char><char style="ft" closed="false">आतमा को सिकावनो लक</char></note> को लक, मंदिर मा आयो। “जब माय-बाप लेकरा यीसु को लाय, मोसे को नियम पूरो करन, वोला भित्तर लाईन।” <verse eid="LUK 2:27"/><verse number="28" style="v" sid="LUK 2:28"/>तबा सिमोन ना लेकरा ला, अपरो कन्हिया मा लियो, अखीन परमेस्वर को धन्य करत कव्हन लगयो।<verse eid="LUK 2:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="LUK 2:29"/>हे मालीक! अब तु अपरो कव्हन को लक,</para>
  <para style="q2" vid="LUK 2:29">सान्ती लक आपरो दास सार कर।<verse eid="LUK 2:29"/></para>
  <para style="q1">
    <verse number="30" style="v" sid="LUK 2:30"/>काहेका मोरो डोरा ना</para>
  <para style="q2" vid="LUK 2:30">ओको सूटकारा मोला चोविसे।<verse eid="LUK 2:30"/></para>
  <para style="q1">
    <verse number="31" style="v" sid="LUK 2:31"/>जो ला तुना सब लोकगीन</para>
  <para style="q2" vid="LUK 2:31">को पूढा मा दिखवा सेस।<verse eid="LUK 2:31"/></para>
  <para style="q1">
    <verse number="32" style="v" sid="LUK 2:32"/>यो दुसरो लोकगीन लाय लुको गोस्टी</para>
  <para style="q1" vid="LUK 2:32">को खुलासा<note caller="+" style="f"><char style="fr" closed="false">2:32</char><char style="ft" closed="false">उजाड़ देवन लाय </char></note> लाई आखिन तोरी पर जा इसरायल ला मान<note caller="+" style="f"><char style="fr" closed="false">2:32</char><char style="ft" closed="false">महिमा</char></note></para>
  <para style="q2" vid="LUK 2:32">देवन वालो उजाड़ो से।<verse eid="LUK 2:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="LUK 2:33"/>टूरा को बारे मा यो गोस्टी आयक के ओको माय बाप चकित भय गईन। <verse eid="LUK 2:33"/><verse number="34" style="v" sid="LUK 2:34"/>सिमोन ना उनला, अखीन आसीस दियो। अना लेकरा को माय मरियम ला कहीस। अवो यो लेकरा, एक असो निसान से, जोन को लोकईन विरोध करयेत, यो कारन लक इसरायल मा बहुत लोकगीन को पड़नो, अखीन जी उचलनो होयहेत। <verse eid="LUK 2:34"/><verse number="35" style="v" sid="LUK 2:35"/>अखीन एक तरवार, वोको हिरदय को आरपार, छेद देहेत। जेनको लक लोकगीन को, मन को बात टोन्ड मा आ जाहे।<verse eid="LUK 2:35"/></para>
  <para style="s">हन्ना की गवाही</para>
  <para style="p">
    <verse number="36" style="v" sid="LUK 2:36"/>हन्ना नाव को एक भविस्यवक्तनी बाई होती। जो आसेर को खानदान मा, फनुऐल को टुरि होती। वा गजब बुड़गी होती। वा लगन को बाद मा, केवल सात साल, अपरो नवरा संग जित्तो रहि होती। <verse eid="LUK 2:36"/><verse number="37" style="v" sid="LUK 2:37"/>अखीन मंघा, वा बेवा भई गई होती अना ओको चऊरासी बरस लक बेवा होती। वा मंदिर को बाहेर नही हिटत होती, अखीन उपास पिराथना करत-करत, रात दिवस परमेस्वर को सेवा मा रव्हत होती। <verse eid="LUK 2:37"/><verse number="38" style="v" sid="LUK 2:38"/>वा भी वोच बेरा मा आयकेना, परमेस्वर ला धनवाद देवन लगी। अखीन जोन लोग येरुसलेम नगर को सूटकारा को रस्ता, चोवत होतीन, उन सबला वा लेकरा को बारे मा सांगन लगि।<verse eid="LUK 2:38"/></para>
  <para style="s">नासरत नगर ला वापस लवटनो</para>
  <para style="p">
    <verse number="39" style="v" sid="LUK 2:39"/>मोसे को नियम को लक पिरभू लाय सब कुछ पूरो करन को मंघा, ओना गलील छेतर मा, अपरो नगर नासरत<note caller="+" style="f"><char style="fr" closed="false">2:39 </char><char style="ft" closed="false">नासरत एक पहाड़ी छेतर जोन गलील कहलावासे। </char></note> मा लवट गइन<note caller="-" style="x"><char style="xo" closed="false">2:39 </char><char style="xt" closed="false"><ref loc="MAT 2:23">मत्ती 2:23</ref></char></note>। <verse eid="LUK 2:39"/><verse number="40" style="v" sid="LUK 2:40"/>लेकरा यीसु मोठो होवन लग्यो, अखीन उ अक्ल लक भरपुर होतो गयो। काहे का “परमेस्वर को हात वोको पर होतो” मजे किरपा होतो।<verse eid="LUK 2:40"/></para>
  <para style="s">मंदिर मा लेकरा यीसु</para>
  <para style="p">
    <verse number="41" style="v" sid="LUK 2:41"/>यीसु को माय-बाप हर साल बलिदान तिहार<note caller="+" style="f"><char style="fr" closed="false">2:41 </char><char style="ft" closed="false">बलिदान को तिहार </char></note> मनावन ला, येरुसलेम नगर जावत होतयो। <verse eid="LUK 2:41"/><verse number="42" style="v" sid="LUK 2:42"/>जबा यीसु बारा साल को भयो, तबा उ आपरो रीती को लक, तिहार मनावन काजी, येरुसलेम नगर मा गईन। <verse eid="LUK 2:42"/><verse number="43" style="v" sid="LUK 2:43"/>तिहार को रोज, पूरो होवन को मंघा, वो लवट गईन, मंग लेकरा यीसु येरुसलेम मा रह गयो, वोको माय-बाप यो बात नही जानत होतीन। <verse eid="LUK 2:43"/><verse number="44" style="v" sid="LUK 2:44"/>वय समझत होतीन का, उ यातरी दलमा सेत। येको लाय उ एक दिवस को यातरा पूरो करन को बाद मा, वोला आपरो कुटूम्ब अखीन जान-पहचान का लोकगीन मा ढुन्ढ-ढान्ड करन लगीन। <verse eid="LUK 2:44"/><verse number="45" style="v" sid="LUK 2:45"/>जब यीसु उनला नही मीलयो, तब ढुंढत-ढान्डत येरुसलेम नगर पँहुचिन। <verse eid="LUK 2:45"/><verse number="46" style="v" sid="LUK 2:46"/>तीन दिवस को बाद मा, उनला यीसु मंदिर मा मिल्यो। उ बसके ना, धरम गुरूगीन लक सवाल-जवाब करत पायो गयो। <verse eid="LUK 2:46"/><verse number="47" style="v" sid="LUK 2:47"/>सब आयकन वारा, अक्ल अखीन सवाल-जवाब पर चकीत भई गईन। <verse eid="LUK 2:47"/><verse number="48" style="v" sid="LUK 2:48"/>वोको माय-बाप भी वोला चोवके ना, अचंभा भई गइन। वोको माय ना वोला कहीस, टूरा, तू ना आमरो संग मा असो काहे करीसेस? देख, तोरो बाप अखीन मी, चिन्ता मा होतीन, अखीन तोला ढुढ़त होतिन। <figure style="fig" alt="Temple in Jerusalem" file="LB00250C.TIF" size="span" copy="Horace Knowles ©" ref="2:41">यरूसलेम मा मंदिर</figure><verse eid="LUK 2:48"/></para>
  <para style="p">
    <verse number="49" style="v" sid="LUK 2:49"/>तब यीसु ना कव्हयो, का तुम्ही मोला काहे ढुन्ढ-ढान्ढ काहे करासो? तुम्ही नही जानसो, की मी पक्को, आपरो बाबूजी को घर मा रहू। <verse eid="LUK 2:49"/><verse number="50" style="v" sid="LUK 2:50"/>पर यो गोस्टी, कोनी ला समझ नही आयो।<verse eid="LUK 2:50"/></para>
  <para style="p">
    <verse number="51" style="v" sid="LUK 2:51"/>यीसु उनको संग येरूसलेम नगर लक आपरो घर नासरत नगर मा आयो। अखीन, उ आपरो माय-बाप को आधीन रहयो। वोको माय ना यो सब गोस्टी आपरो मन मा, सजोय के राखीस। <verse eid="LUK 2:51"/><verse number="52" style="v" sid="LUK 2:52"/>यीसु अक्ल अना ताकत<note caller="+" style="f"><char style="fr" closed="false">2:52 </char><char style="ft" closed="false">आयु</char></note> मा, अखीन परमेस्वर अना मानूस को किरपा मा बढतो गयो।<verse eid="LUK 2:52"/></para>
  <chapter eid="LUK 2"/>
  <chapter number="3" style="c" sid="LUK 3"/>
  <para style="s">योहन बप्तिस्मा देवन वालो को साजरो बारता</para>
  <para style="r">(<ref loc="MAT 3:1-12">मत्ती 3:1-12</ref>; <ref loc="MRK 1:1-8">मरकुस 1:1-8</ref>; <ref loc="JHN 1:19-28">योहन 1:19-28</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 3:1"/>तिबेरियुस को, सरकार को पांचवा साल होत्यो। कैसर को राज मा पोंतियुस पिलातुस, यहुदिया गलील को राजपाल होतयो। दोनी भाऊ, फिलिपी इतूरैया, तरखोनीतिस राज को राजा, अखीन लुसानियस, अबिलेने राज को, राजा होत्यो, अना गलील मा हेरोदेस राजा होतो। <verse eid="LUK 3:1"/><verse number="2" style="v" sid="LUK 3:2"/>हन्ना अखीन काइफा, मुखिया याजक होतो। वोना दिवस मा, परमेस्वर को कव्हनो, सूनसान जघा मा जकरयाह को टूरा, योहन को कठा पहुचो। <verse eid="LUK 3:2"/><verse number="3" style="v" sid="LUK 3:3"/>उ यरदन नदी को आजू-बाजू को छेतर मा, घुम-घाम के न पाप छिमा, अखीन पाप लक मन हटाव, बप्तिस्मा, को बारे मा, परचार करन लगयो। <verse eid="LUK 3:3"/><verse number="4" style="v" sid="LUK 3:4"/>जसो भविस्यवक्ता यसायाह को पवीतर किताब मा लिख्यो से,</para>
  <para style="q1" vid="LUK 3:4">“सून-सान जघा मा चिलावन वालो को आवाज।</para>
  <para style="q1" vid="LUK 3:4">पिरभू को रास्ता ला तैय्यार करो!</para>
  <para style="q2" vid="LUK 3:4">अखीन वोको रास्ता</para>
  <para style="q2" vid="LUK 3:4">ला सीधो करो”<verse eid="LUK 3:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="LUK 3:5"/>दुई टवरिया को बीच को खोदरा, भर दियो जाय,</para>
  <para style="q2" vid="LUK 3:5">हर एक पहाड-पहाड़ी खाल्या करो।</para>
  <para style="q1" vid="LUK 3:5">टेडो-टाडो रस्ता सिधो करो,</para>
  <para style="q2" vid="LUK 3:5">उबड-खाबड रस्ता ला समान करो। <verse eid="LUK 3:5"/><verse number="6" style="v" sid="LUK 3:6"/>अना हरेक लोकगीन परमेस्वर को आतमा छुट्टकारा<note caller="+" style="f"><char style="fr" closed="false">3:6</char><char style="ft" closed="false">मोक्स</char></note></para>
  <para style="q1" vid="LUK 3:6">ला चोवयेत।<verse eid="LUK 3:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="LUK 3:7"/>
    <note caller="-" style="x">
      <char style="xo" closed="false">3:7</char>
      <char style="xt" closed="false">
        <ref loc="MAT 12:34">मत्ती 12:34</ref>; <ref loc="MAT 23:33">23:33</ref></char>
    </note>जोन लोक बप्तिस्मा लेवन ला आवत होतीन, योहन उनला कव्हत होत्यो, हे सरप को लेकरा कोन तुम्हीला सांगीसेस, की परमेस्वर को हिजरनो लक पराय जाओ। <verse eid="LUK 3:7"/><verse number="8" style="v" sid="LUK 3:8"/><note caller="-" style="x"><char style="xo" closed="false">3:8</char><char style="xt" closed="false"><ref loc="JHN 8:33">योहन 8:33</ref> </char></note>आपरो मन ला पाप लक हटाय के पस्तावा करो, अना साजरो भई जाओ, अखीन साजरो-साजरो काम करो। तुम्ही आपरो मन मा असो मत सोचो, हमी अबराहम को खानदान को सेत। मि तुम्ही ला सांगासु, परमेस्वर ऐना गोटा लक, अबराहम को लाय, लेकरा जनमा सकसे। <verse eid="LUK 3:8"/><verse number="9" style="v" sid="LUK 3:9"/><note caller="-" style="x"><char style="xo" closed="false">3:9 </char><char style="xt" closed="false"><ref loc="MAT 7:19">मत्ती 7:19</ref> </char></note>अबा झाड़ को जड़ मा, टँगिया से। जो झाड़ साजरा फर नही देवासे, वोला काटपीट के ना, स्तो मा पेटाय दियो जाहेत।<verse eid="LUK 3:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="LUK 3:10"/>तबा लोग गीन योहन लक पुसयो, तो हमि काजक करबीन?<verse eid="LUK 3:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="LUK 3:11"/>तबा वोना जवाब दियो, जोको कना दोन कुरता से, वोला देदो, जोन को कठा नहाती, अना जोन को कठा जेवन को सेत, वो भी वसोच करयेत।<verse eid="LUK 3:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="LUK 3:12"/>
    <note caller="-" style="x">
      <char style="xo" closed="false">3:12 </char>
      <char style="xt" closed="false">
        <ref loc="LUK 7:29">लूका 7:29</ref> </char>
    </note>अना जमा पटानवारा <note caller="+" style="f"><char style="fr" closed="false">3:12 </char><char style="ft" closed="false">टेक्स, कर </char></note> अधिकारी गीन ओको जवर बप्तिस्मा-लेवन आइन, अखीन वोला पुछीन, गुरूजी हमला का करनो से सांगो?<verse eid="LUK 3:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="LUK 3:13"/>तब योहन ना कव्हयो, जितरो ठहरायो गयोसे वोको लक जादा नोको लेवने।<verse eid="LUK 3:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="LUK 3:14"/>सीपाहि गीन पुसन लगीन, अखीन आमरो लाय काजक हुकूम से? तबा उ सांगयो, कोनी लक पैसा नोको एठने। अखीन झुठो दोस नोको लगावने,</para>
  <para style="p" vid="LUK 3:14">पर आपरो तनखा मा जिन्दगी करो, घूस नोको लेवने।<verse eid="LUK 3:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="LUK 3:15"/>जबा आस लगायके होतीन अना योहन को बारे मा आपरो मन मा सोच बिचार कर रही होतीन। का योच ता मसीह नहात? <verse eid="LUK 3:15"/><verse number="16" style="v" sid="LUK 3:16"/>यो काजी योहन कहीस, तुम्ही अपरो-आपरो मनमा काजक सोचसो, कही मी मसीह सेऊ? सच-मूच मा मी मसीह नही सेव। काहे का मि, तो तुम्ही ला पानी मा बप्तिस्मा<note caller="+" style="f"><char style="fr" closed="false">3:16 </char><char style="ft" closed="false">पानी मे बप्तिस्मा, डुबकी लगाना या जल स्संकार</char></note> देवासू, पर उ आवन वालो मसीहा, मोरो ले जादा ताकतवर से। मी वोको जूता को दोरी, खोलन को काबील नही सेव, उ तुम्हीला, पवीतर आतमा, अखीन स्तो लक बप्तिस्मा देहेत। <verse eid="LUK 3:16"/><verse number="17" style="v" sid="LUK 3:17"/>वोको हात मा सूपड़ो से, उ आपरी खरीयान ला साजरो रीती लक सफा करहे। अपरो गँहु ला कोठी मा जमा करयेत। अखीन भुसा-भासी ला, कभ्भू नही बुझन वालो स्तो मा, डाक देहेत।<verse eid="LUK 3:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="LUK 3:18"/>योहन असो अजब-गजब उदाहरन समेत सिक्सा, जनता ला आयकावत होतो। <verse eid="LUK 3:18"/><verse number="19" style="v" sid="LUK 3:19"/><note caller="-" style="x"><char style="xo" closed="false">3:19</char><char style="xt" closed="false"><ref loc="MAT 14:3-4">मत्ती 14:3-4</ref>; <ref loc="MRK 6:17-18">मरकुस 6:17-18</ref></char></note>पर योहन ना राजा हेरोदेस ला, वोको भाऊ हेरोदियास बहू को बारे मा, अखीन वोको सब गलत काम को लाई, वोला बूरो-भलो ठासन लगयो। <verse eid="LUK 3:19"/><verse number="20" style="v" sid="LUK 3:20"/>तब राजा ना, योहन ला धरवायके जेल मा डाक देईस। अखीन आपरो खोटो काम को, हद पार कर देईस।<verse eid="LUK 3:20"/></para>
  <para style="s">यीसु को बप्तिस्मा</para>
  <para style="r">(<ref loc="MAT 3:13-17">मत्ती 3:13-17</ref>; <ref loc="MRK 1:9-11">मरकुस 1:9-11</ref>)</para>
  <para style="p">
    <verse number="21" style="v" sid="LUK 3:21"/>जबा सबा लोकगीन बप्तिस्मा लेईन, तबा यीसु भी बप्तिस्मा लेवन को बाद, परमेस्वर लक पिराथना करन लगीस। तबा बादल खुल गयो। <verse eid="LUK 3:21"/><verse number="22" style="v" sid="LUK 3:22"/><note caller="-" style="x"><char style="xo" closed="false">3:22</char><char style="xt" closed="false"><ref loc="MAT 3:17">मत्ती 3:17</ref>; <ref loc="MRK 1:11">मरकुस 1:11</ref>; <ref loc="LUK 9:35">लूका 9:35</ref></char></note>अखीन परेवा को देह जसो, पवीतर आतमा वोको पर उतर गयो, अखीन सरग लक यो आवाज आयो, तू मोरो चहेतो टूरा आस, मी तोरो लक गजब खुसी सेव।<verse eid="LUK 3:22"/></para>
  <para style="s">यीसु को खानदान</para>
  <para style="r">(<ref loc="MAT 1:1-17">मत्ती 1:1-17</ref>)</para>
  <para style="p">
    <verse number="23" style="v" sid="LUK 3:23"/>जब यीसु ना परमेस्वर को सेवा सुरु करीस। ओना बेरा उ तीस बरस को होतो। लोग ओला यूसुफ को टूरा समझत होतिन। यूसुफ एली को टूरा होतो, <verse eid="LUK 3:23"/><verse number="24" style="v" sid="LUK 3:24"/>अखीन उ मत्तात को टूरा, अखीन उ लेवी को टूरा, अखीन उ मलकी को टूरा, अखीन उ यन्ना को टूरा, अखीन उ यूसुफ को, टूरा <verse eid="LUK 3:24"/><verse number="25" style="v" sid="LUK 3:25"/>अखीन उ मत्तित्याह को टूरा, अखीन उ आमोस को टूरा, अखीन उ नहूम को टूरा, अखीन उ असल्याह को टूरा, अखीन उ नोगहा को टूरा, <verse eid="LUK 3:25"/><verse number="26" style="v" sid="LUK 3:26"/>अखीन उ मात को टूरा, अखीन मत्तित्याह को, अखीन उ सिमी को, अखीन उ योसेख को, अखीन उ योदाह को, <verse eid="LUK 3:26"/><verse number="27" style="v" sid="LUK 3:27"/>उ योहान को, अखीन उ रेसा को, अखीन उ जरुब्बाबिल को, अखीन उ सालतिएल को, अखीन उ नेरी को, <verse eid="LUK 3:27"/><verse number="28" style="v" sid="LUK 3:28"/>अखीन उ मलकी को, अखीन उ अद्दि को, अखीन उ कोसाम को, अखीन उ इलमोदाम को, अखीन उ एर को, <verse eid="LUK 3:28"/><verse number="29" style="v" sid="LUK 3:29"/>अखीन उ यहोसु को, अखीन उ एलीएजर को, अखीन उ योरीम को, अखीन उ मत्तात को, अखीन उ लेवी को <verse eid="LUK 3:29"/><verse number="30" style="v" sid="LUK 3:30"/>अखीन उ सिमोन को, अखीन उ यहूदा को, अखीन उ यूसुफ को, अखीन उ योनाम को, अखीन उ इलयाकीम को <verse eid="LUK 3:30"/><verse number="31" style="v" sid="LUK 3:31"/>अखीन उ मेलेआह को, अखीन उ मिन्नाह को, अखीन उ मत्तात को, अखीन उ नातान को, अखीन उ दाऊद को, <verse eid="LUK 3:31"/><verse number="32" style="v" sid="LUK 3:32"/>अखीन उ यिसै को, अखीन उ ओबेद को, अखीन उ बोअज को, अखीन उ सेलह को, अखीन उ नहसोन को, <verse eid="LUK 3:32"/><verse number="33" style="v" sid="LUK 3:33"/>अखीन उ अम्मीनादाब को, अखीन उ अरनी को, अखीन उ हिसरोन को, अखीन उ पेरेस को, अखीन उ यहूदा को, <verse eid="LUK 3:33"/><verse number="34" style="v" sid="LUK 3:34"/>अखीन उ याकूब को, अखीन उ इसहाक को, अखीन उ अबराहम को, अखीन उ तेरह को, अखीन उ नाहोर को, <verse eid="LUK 3:34"/><verse number="35" style="v" sid="LUK 3:35"/>सरुग को, अखीन उ रऊ को, अखीन उ पेलेग को, अखीन उ एबर को, अखीन उ सेलेह को <verse eid="LUK 3:35"/><verse number="36" style="v" sid="LUK 3:36"/>अखीन उ केनान को, अखीन उ अरपछद को, अखीन उ सेम को, अखीन उ नूह को, अखीन उ लामेक को, <verse eid="LUK 3:36"/><verse number="37" style="v" sid="LUK 3:37"/>अखीन उ मथूसेलह को, अखीन उ हनोक को, अखीन उ यारेद को, अखीन उ महल्लेल को, अखीन उ केनान को, <verse eid="LUK 3:37"/><verse number="38" style="v" sid="LUK 3:38"/>अखीन उ एनोस को, अखीन उ सेत को, अखीन उ आदम को, अउर अखीन उ परमेस्वर को टूरा होतो।<verse eid="LUK 3:38"/></para>
  <chapter eid="LUK 3"/>
  <chapter number="4" style="c" sid="LUK 4"/>
  <para style="s">यीसु को परिक्सा</para>
  <para style="r">(<ref loc="MAT 4:1-11">मत्ती 4:1-11</ref>; <ref loc="MRK 1:12">मरकुस 1:12</ref>,<ref loc="MRK 1:13">13</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 4:1"/>यीसु पवीतर आतमा लक पूरो भरके ना, यरदन नदी लक लवटयो। तबा आतमा वोला सूनसान मा लेगइस। <verse eid="LUK 4:1"/><verse number="2" style="v" sid="LUK 4:2"/>वोना जघा बालजबूल<note caller="+" style="f"><char style="fr" closed="false">4:2</char><char style="ft" closed="false">सैतान</char></note> चालीस दिवस तकन वोको परीक्सा लेवत रहयो। यीसु उन दिवस मा काही नही जेविस, जबा चालीस दिवस बीत गयो, तबा वोला गजब भूख लग्यो।<verse eid="LUK 4:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="LUK 4:3"/>बालजबूल ना वोला सांग्यो, यदी तु परमेस्वर को टूरा आस, तो यो गोटा ला हुकूम देव, का यो भाकर बन जाहेत।<verse eid="LUK 4:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="LUK 4:4"/>पर यीसु ना जवाब देइस। गिरंथ मा लिखीसे। मानूस भाकर लक नही, पर परमेस्वर को गोस्टी लक जित्तो रहेत।<verse eid="LUK 4:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="LUK 4:5"/>मंग बालजबूल वोला, वरता उठायके ना ले गईस, अखीन पलभर मा जग को राज चोवाइस। <verse eid="LUK 4:5"/><verse number="6" style="v" sid="LUK 4:6"/>अखीन बालजबूल ना वोला कहीस, मी तोला यो सबच राज अना महिमा देदेहू। यो मोरो अधिकार मा से, मि जोनला चाँहू ओला दे सकासू। <verse eid="LUK 4:6"/><verse number="7" style="v" sid="LUK 4:7"/>यदी तू मोरो पाँय पड़जोस अना नमस्कार करजोस, ता यो सबा तोला देदेहू।<verse eid="LUK 4:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="LUK 4:8"/>तबा यीसु ना जवाब देइस, गिरंथ मा लिखीसे, तू आपरो पिरभू परमेस्वर ला नमस्कार <note caller="+" style="f"><char style="fr" closed="false">4:8 </char><char style="ft" closed="false">पिराथना</char></note> करजो, अखीन वोको च सेवा<note caller="+" style="f"><char style="fr" closed="false">4:8 </char><char style="ft" closed="false">महिमा</char></note> करजो।<verse eid="LUK 4:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="LUK 4:9"/>तबा बालजबूल ना, वोला येरुसलेम नगर, को मंदिर को छेन्डी मा, उभो करयो। अखीन कव्हयो, यदि तू परमेस्वर को टूरा से, तो खाल्या कूद जाय। <verse eid="LUK 4:9"/><verse number="10" style="v" sid="LUK 4:10"/>काहेका गिरंथ मा लिखीसे, तोरो लाय परमेस्वर आपरो सरगदूत ला हुकूम देहेत, अखीन वो तोला बचाहेत। <verse eid="LUK 4:10"/><verse number="11" style="v" sid="LUK 4:11"/>कही तोरो पाँय मा खोद्दा, नोको लग जाय।<verse eid="LUK 4:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="LUK 4:12"/>यीसु ना जवाब देइस, यो लिखी से, तू आपरो पिरभू परमेस्वर को परिक्सा<note caller="+" style="f"><char style="fr" closed="false">4:12 </char><char style="ft" closed="false">परखना</char></note> नोको करजो।<verse eid="LUK 4:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="LUK 4:13"/>असो परिक्सा लेवन को बाद, बालजबूल सैतान वोको जवर लक, पराय गयो।<verse eid="LUK 4:13"/></para>
  <para style="s">यीसु को सेवा काम को सुरुवात</para>
  <para style="r">(<ref loc="MAT 4:12-17">मत्ती 4:12-17</ref>; <ref loc="MRK 1:14">मरकुस 1:14</ref>,<ref loc="MRK 1:15">15</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="LUK 4:14"/>यीसु आतमा को ताकत लक भरके, गलील छेतर मा हिट आयो। वोको चरचा, आखा-पाखा को सबा जघा मा फैल गयो। <verse eid="LUK 4:14"/><verse number="15" style="v" sid="LUK 4:15"/>उ सभाघर मा जायके ना, सिक्सा देवन लग्यो। अखीन लोकगीन वोको बड़ाई करन लगीन।<verse eid="LUK 4:15"/></para>
  <para style="s">नासरत नगर मा यीसु को बेइज्जती</para>
  <para style="r">(<ref loc="MAT 13:53-58">मत्ती 13:53-58</ref>; <ref loc="MRK 6:1-6">मरकुस 6:1-6</ref>)</para>
  <para style="p">
    <verse number="16" style="v" sid="LUK 4:16"/>जबा यीसु आपरो नगर नासरत मा आयो। जहाँ उ पालो गयो होतो। तबा उ आपरो आदत को लक पवीतर दिवस<note caller="+" style="f"><char style="fr" closed="false">4:16 </char><char style="ft" closed="false">सब्त को दिवस</char></note> सभाघर मा गयो। उ गिरंथ बाचन ला उभो भयो। <verse eid="LUK 4:16"/><verse number="17" style="v" sid="LUK 4:17"/>तबा वोला भविस्यवक्ता यसायाह को किताब दियो गयो, गिरंथ खोलके ना उ जघा हेड़यो, जहा लिखो से।<verse eid="LUK 4:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="LUK 4:18"/>पिरभू को आतमा मोरो वरतासे, काहेका वोना मोला निवाड़ी सेस,</para>
  <para style="q2" vid="LUK 4:18">का मी गरीब-गोर ला साजरो बारता आयकावाहु,</para>
  <para style="q1" vid="LUK 4:18">वोना मोला धाड़ीसेस। जोको लाया मी बन्दी लोकगीन को सूटकारा,</para>
  <para style="q2" vid="LUK 4:18">अखीन अँधरा गीन ला डोरा चोवन को,</para>
  <para style="q1" vid="LUK 4:18">खबर सुनाऊ। मी दलीत लोकगीन ला, सोड़ाऊ।<verse eid="LUK 4:18"/></para>
  <para style="q2">
    <verse number="19" style="v" sid="LUK 4:19"/>अखिन पिरभू को किरपा को साल, <note caller="+" style="f"><char style="fr" closed="false">4:19</char><char style="ft" closed="false">परमेस्वर को खुसी होवन को साल </char></note></para>
  <para style="q2" vid="LUK 4:19">ला सबला साजरा बारता आयकावसू। <figure style="fig" alt="Scroll" file="HK00150C.TIF" size="col" copy="Horace Knowles ©" ref="4:16">गुंडो हुयो किताब</figure><verse eid="LUK 4:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="LUK 4:20"/>यीसु ना किताब ला बंद कर दियो, अखीन दास को हात मा धरा दियो, अखीन सबा बस गईन। सभाघर मा, सबकी नजर यीसु पर होतो। <verse eid="LUK 4:20"/><verse number="21" style="v" sid="LUK 4:21"/>तबा यीसु ना कव्हयो, यो गोस्टी आज पवितर गीरंथ मा पूरो भई।<verse eid="LUK 4:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="LUK 4:22"/>सब लोग गीन वोकी किरपा को बात आयक के चकीत भई गईन। अखीन आपस मा कव्हन लगीन। का यो सचमा यूसुफ को टूरा नहाय?<verse eid="LUK 4:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="LUK 4:23"/>वोना उन लक कहीस, तुम्ही मोरो पर यो हाना जरुर कहजोस, हे बईद, अपरो आप ला साजरो कर, जो काही हमि न आयकी सेजन। जोन काम कफरनहुम नगर मा किरीसेस, ओला अपरो देस मा कर। <verse eid="LUK 4:23"/><verse number="24" style="v" sid="LUK 4:24"/>अना वोना कहीस मि तुमी लक खरो कव्हसू, कोनी खरो भविस्यवक्ता अपरो देस मा मान-सम्मान नही पावासे।<note caller="-" style="x"><char style="xo" closed="false">4:24 </char><char style="xt" closed="false"><ref loc="JHN 4:44">योहन 4:44</ref></char></note> <verse eid="LUK 4:24"/><verse number="25" style="v" sid="LUK 4:25"/>अना मी तुमी ला खरो कव्हसू, की एलिय्याह को दिवस मा जबा साढ़े तीन साल तकन बादल बन्द रहीसेस, यहान तकन क सारो देस मा मोठयो गिरहानी पडयो, त इसरायल मा लगत बेवा होतिन। <verse eid="LUK 4:25"/><verse number="26" style="v" sid="LUK 4:26"/>पर एलिय्याह उनमा लक कोनी को जवर नही धाड़यो गयो होतो। उ एकच सैदा को सारपत को एक बेवा को जवर धाड़ो गयो होतो। <verse eid="LUK 4:26"/><verse number="27" style="v" sid="LUK 4:27"/>अखीन एलिसा भविस्यवक्ता को बेरा इसरायल म गजब सो कोढी होतिन, पर नामान सिरयानी ला छोड़ उनमा लक, कोनी ला साजरो नही करीस।<verse eid="LUK 4:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="LUK 4:28"/>यो गोस्टी ला आयक के, जेतरा लोग गीन सभाघर मा होतिन, सबच “लाल-पिवरो” भयी गईन। <verse eid="LUK 4:28"/><verse number="29" style="v" sid="LUK 4:29"/>अना उठके ओला नगर लक बाहेर हेड़ीन, अना जोन पहाड मा उन को नगर बसो से, ओको वरता मा ले चलिन, की ओला वहान लक खाल्या ढकल दे। <verse eid="LUK 4:29"/><verse number="30" style="v" sid="LUK 4:30"/>पर उ उनको बिचमा लक, हिटके चली गयो।<verse eid="LUK 4:30"/></para>
  <para style="s">भूत लग्यो मानूस ला साजरो करनो</para>
  <para style="r">(<ref loc="MRK 1:21-28">मरकुस 1:21-28</ref>)</para>
  <para style="p">
    <verse number="31" style="v" sid="LUK 4:31"/>मग उ गलील छेतर को, कफरनहुम नगर मा गयो, अना पवीतर दिवस<note caller="+" style="f"><char style="fr" closed="false">4:31 </char><char style="ft" closed="false">मोसे के नियम लक सब्त का दिवस यहुदियो का सप्ताह का पहेला एक खास दिवस जोनमा वय सिरप अराधना करत होतिन अना कोनी भी काम करन को मनाही होतो।</char></note> मा लोग गीन ला, सिक्सा देवन लग्यो। <verse eid="LUK 4:31"/><verse number="32" style="v" sid="LUK 4:32"/>उनना वोको सिक्सा ले चकित भई गईन।<note caller="-" style="x"><char style="xo" closed="false">4:32</char><char style="xt" closed="false"><ref loc="MAT 7:28-29">मत्ती 7:28-29</ref></char></note> काहेका उ गोस्टी अधिकार सकट होत्यो। <verse eid="LUK 4:32"/><verse number="33" style="v" sid="LUK 4:33"/>सभाघर मा, एक मानूस होतो, जोन एक असुध्द भुत-पलित झोमो होतो। ओना चिल्लायके कव्हयो। <verse eid="LUK 4:33"/><verse number="34" style="v" sid="LUK 4:34"/>ओ यीसु, नासरी, हमरो लक तोरो काजक काम से? का तु आमीला नास करन ला आईसेस? मी तोला जानासू, तू कोन आस? तु परमेस्वर को पवीतर मानूस आस।<verse eid="LUK 4:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="LUK 4:35"/>यीसु न वोला डटकार के हुकूम देइस, उघा-मूघा रव्ह अना वोको लक हीट जाय, तब भूत वोला बीच मा पटककर बिना हानि पहुचाए, हीट गयो।<verse eid="LUK 4:35"/></para>
  <para style="p">
    <verse number="36" style="v" sid="LUK 4:36"/>योच लाइ सबा ला, अचंभा भयो, अना वय आपस मा बोलन लगीन। ये कसो ताकत अना हक से, यो भूत ला हुकूम देवासे, अना वा हिट जासे। <verse eid="LUK 4:36"/><verse number="37" style="v" sid="LUK 4:37"/>तबा यीसु की यो गोस्टी अगल-बगल जघा मा होवन लगी।<verse eid="LUK 4:37"/></para>
  <para style="s">यीसु ना गजब लोकगीन ला, साजरो करीस</para>
  <para style="r">(<ref loc="MAT 8:14-17">मत्ती 8:14-17</ref>; <ref loc="MRK 1:29-34">मरकुस 1:29-34</ref>)</para>
  <para style="p">
    <verse number="38" style="v" sid="LUK 4:38"/>उ सभाघर लक उभो होयके, समौन के घर मा गईस। अखीन समौन की सास ला गजब बुखार होतो। अना उनना वोको लाय वोको लक बिनती करीन। <verse eid="LUK 4:38"/><verse number="39" style="v" sid="LUK 4:39"/>तबा यीसु ना ओको जवर उभो, होयके, बुखार ला हुकूम देयके डाटीस, अना बुखार उतर गयो। अना उ एकदम उठके उनको सेवा करन लग्यो।<verse eid="LUK 4:39"/></para>
  <para style="p">
    <verse number="40" style="v" sid="LUK 4:40"/>दिवस बुड़तो बेरा मा, जोन-जोन को घर मा बिमार होतिन उनना वोको जवर आनीन, अना उन सबपर हात ठेवके सबला साजरो करीस। <verse eid="LUK 4:40"/><verse number="41" style="v" sid="LUK 4:41"/>भूत बेमियात-बेमियात कव्हन लगीन, तु परमेस्वर को टूरा आस, अना हीट गइन, पर यीसु उनला डाटके नही बोलन को हुकूम देइस।</para>
  <para style="p" vid="LUK 4:41">काहेका भूत जानत होतिन का यो मसीह सूटकारा देवनवारा सेत।<verse eid="LUK 4:41"/></para>
  <para style="s">सभाघर मा सिक्सा देवनो</para>
  <para style="r">(<ref loc="MRK 1:35-39">मरकुस 1:35-39</ref>)</para>
  <para style="p">
    <verse number="42" style="v" sid="LUK 4:42"/>यीसु पहट को बेरा घर लक हिटके, अना एकांत जघा मा गयो। लोग वोला ढुढ़त-ढाढ़त ओको जवर आइन। अखीन बिनती करके कव्हन लगीन, तु हमि ला सोड़के नोको जास। <verse eid="LUK 4:42"/><verse number="43" style="v" sid="LUK 4:43"/>पर वोना उनलक कव्हयो, मोला अखीन देस मा जावनो से, अना परमेस्वर को साजरो बारता, आयकानो जरुरी से, काहेका मोला योच काजी धाड़ो गयो से।<verse eid="LUK 4:43"/></para>
  <para style="p">
    <verse number="44" style="v" sid="LUK 4:44"/>अना उ गलील छेतर यहुदिया <note caller="+" style="f"><char style="fr" closed="false">4:44</char><char style="ft" closed="false">यहुदिया परदेस</char></note> को सब, सभाघर मा, साजरा बारता सांगन लगयो।<verse eid="LUK 4:44"/></para>
  <chapter eid="LUK 4"/>
  <chapter number="5" style="c" sid="LUK 5"/>
  <para style="s">पहलो चेला गीनला हाकलनो</para>
  <para style="r">(<ref loc="MAT 4:18-22">मत्ती 4:18-22</ref>; <ref loc="MRK 1:16-20">मरकुस 1:16-20</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 5:1"/>
    <note caller="-" style="x">
      <char style="xo" closed="false">5:1</char>
      <char style="xt" closed="false">
        <ref loc="MAT 13:1-2">मत्ती 13:1-2</ref>; <ref loc="MRK 3:9-10">मरकुस 3:9-10</ref></char>
    </note>जनता जबा, परमेस्वर को गोस्टी आयकन को लाई, सबा जमा होय गईन। तबा यीसु गनेसरत झील को कीनार मा, उभो होत्यो। <verse eid="LUK 5:1"/><verse number="2" style="v" sid="LUK 5:2"/>वोना झील को किनार मा, दुई नाव होतो, अखीन ढीमर जाल धोवत होतीन। <verse eid="LUK 5:2"/><verse number="3" style="v" sid="LUK 5:3"/>वोना मा लक एक नाव, समोन को होतो। नाव मा यीसु बस गयो, अखीन समोन ला जघा लक जरा हटान ला, कव्हयो, अखीन यीसु सिक्सा<note caller="+" style="f"><char style="fr" closed="false">5:3</char><char style="ft" closed="false">परमेस्वर को बचन</char></note> देवन लगयो।<verse eid="LUK 5:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="LUK 5:4"/>जबा सिक्सा देके ना भई गयो, तबा यीसु ना समोन ला कव्हयो, गहरो मा नाव लेचल, अखीन अपरो जाल डाख।<figure style="fig" alt="Fishermen in boat and catch fish" file="HK00208C.TIF" size="span" copy="Horace Knowles ©" ref="5:4">डोगा मा ढीमर मसरी धरतो हुयो</figure><verse eid="LUK 5:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="LUK 5:5"/>समोन ना कव्हयो, हे मालीक, हमी रात भर मेहनत करीसेजन, अखीन काही “हात नही लगयो<note caller="+" style="f"><char style="fr" closed="false">5:5 </char><char style="ft" closed="false">काही नही मिलयो</char></note>” तोरो कव्हनो को सनुसार, मी जाल डाखासु।<note caller="-" style="x"><char style="xo" closed="false">5:5</char><char style="xt" closed="false"><ref loc="JHN 21:3">योहन 21:3</ref></char></note> <verse eid="LUK 5:5"/><verse number="6" style="v" sid="LUK 5:6"/>जबा वोना जाल डाखीस, तबा गजब मसरी<note caller="+" style="f"><char style="fr" closed="false">5:6 </char><char style="ft" closed="false">लगत सो मसरी </char></note> जाल मा फस गईन, अखीन जाल फाटन लगी।<note caller="-" style="x"><char style="xo" closed="false">5:6</char><char style="xt" closed="false"><ref loc="JHN 21:6">योहन 21:6</ref> </char></note> <verse eid="LUK 5:6"/><verse number="7" style="v" sid="LUK 5:7"/>तबा समोन आपरो संगीइन ला, हाकलिस, अखीन सबा आय केन, जाल हेड़न लगीन, नाव मसरी लक एतरो भर गयो, का नाव बुड़न लगी। <verse eid="LUK 5:7"/><verse number="8" style="v" sid="LUK 5:8"/>असो चमत्कार चोवकेना, समोन यीसु को पाय मा पड़ गयो। अखीन वोला कहीस, हे मालीक मोरो जवर लक जाय, काहे का मी पापी मानूस सेव।<verse eid="LUK 5:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="LUK 5:9"/>काहेकि एतरो मसरी ला समट लेवन को कारन ओला अना ओको संगीगिन ला अचंभा भयो। <verse eid="LUK 5:9"/><verse number="10" style="v" sid="LUK 5:10"/>वहान जबदी को टूरा याकूब, अखीन योहन भी होत्यो। तब जोन समोन को संगी होतिन, अचंभा करन लगीन, तबा यीसु, समोन लक कहीस, भेव नोको करो अबा, लक तू मानूस ला, परमेस्वर को राज मा आनजोस। <verse eid="LUK 5:10"/><verse number="11" style="v" sid="LUK 5:11"/>अना उनना नाव ला किनारे जघा मा, आनीन अना सबा काही ला सोड़के वोको मंघा गईन।<verse eid="LUK 5:11"/></para>
  <para style="s">कोढ को रोगी ला साजरो करनो</para>
  <para style="r">(<ref loc="MAT 8:1-4">मत्ती 8:1-4</ref>; <ref loc="MRK 1:40-45">मरकुस 1:40-45</ref>)</para>
  <para style="p">
    <verse number="12" style="v" sid="LUK 5:12"/>जबा उ कोनी नगर मा गयो होत्यो, ता वहान एक कोढी मानूस आयो। अना यीसु को पायमा, तोन्ड को बल पड़के ना बिनती करन लगयो, हे पिरभू! यदि तु चाव्हजोस, ता मोला साजरो कर सकासेस।<verse eid="LUK 5:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="LUK 5:13"/>वोना हात छिवके कहीस, मी चाव्हसू, तू साजरो भय जास, वोच बेरा वोको कोढ साजरो भय गयो। <verse eid="LUK 5:13"/><verse number="14" style="v" sid="LUK 5:14"/>यीसु ना वोला हुकूम दियो, यो गोस्टी तू कोनीला नोको सांगजोस, पर आपरो आप ला मुखिया याजक ला दिसाजोस, अना जोन चढावा चढ़ावन ला मोसे गुरूजी ना सांगिसेस, उ भेंट चढाजोस, तबा लोक गीन ला गवाही भई जाहे, का तू साजरो भय गइसेस।<verse eid="LUK 5:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="LUK 5:15"/>मंग यीसु की गोस्टी गजब फैलत गई, भीड़ वोकी गोस्टी आयकन लाई, अना अपरी बीमारि लक साजरो होवन लाई, जमा भईन। <verse eid="LUK 5:15"/><verse number="16" style="v" sid="LUK 5:16"/>पर यीसु उन लक बेगरो होयके जगंल मा जायकेना, पिराथना करन लगियो।<verse eid="LUK 5:16"/></para>
  <para style="s">लकवा को रोगिला साजरो करनो</para>
  <para style="r">(<ref loc="MAT 9:1-8">मत्ती 9:1-8</ref>; <ref loc="MRK 2:1-12">मरकुस 2:1-12</ref>)</para>
  <para style="p">
    <verse number="17" style="v" sid="LUK 5:17"/>एक रोज यीसु, सिक्सा दे रहयो होतो। मोसे को नियम को गुरू अखीन मुखिया याजकगिन, वोको कठा बस्या होतिन। वय गलील, अना यहुदिया छेतर को हर, एक गाँव लक येरुसलेम नगर मा आयो होतिन। रोगिन ला साजरो करन को लाय, पिरभू को ताकत यीसु को संग होत्यो। <verse eid="LUK 5:17"/><verse number="18" style="v" sid="LUK 5:18"/>वोच बेरा काही लोग गीन खाट मा एक लकवा को रोगि ला आनीन। वय वोला भीतर ली जायके, यीसु को पूढा राखन चाव्हत होतिन। <verse eid="LUK 5:18"/><verse number="19" style="v" sid="LUK 5:19"/>पर गरदी को कारन लक, वोला भीतर नही आन सकिन, ता वय सपरी मा चघ गईन। अना सड्डन कापके, रोगिला जहान यीसु बस्यो होतो, वहान पूढा मा खाट ला, खाल्या उतार देइन। <verse eid="LUK 5:19"/><verse number="20" style="v" sid="LUK 5:20"/>उनको भरोसा ला चोवके, यीसु कव्हयो, जा भाऊ, तोरो पाप छिमा भय गयो।<verse eid="LUK 5:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="LUK 5:21"/>एको पर मोसे को नियम को गुरू लेखक, अना पुरोहित एक दुसरो ला, जवाब करन लगीन। का यो परमेस्वर को निन्दा करन वारा कोन से? परमेस्वर को सिवाय कोन, पाप छिमा कर सकासे?<verse eid="LUK 5:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="LUK 5:22"/>उनको यो जवाब जान के यीसु ना उनला जवाब दियो। तुमारो मन मा यो जवाब काहे, उभो रहयो से? <verse eid="LUK 5:22"/><verse number="23" style="v" sid="LUK 5:23"/>सबा लक सरल का से? यो कव्हनो तोरो पाप छिमा भय गयो। का उठ चल? <verse eid="LUK 5:23"/><verse number="24" style="v" sid="LUK 5:24"/>पर एकोलाय का तुमला मालूम भई जाये, का मानूस को टूरा ला, धरती मा पाप छिमा करन को अधिकार से। तबा उ लकवा को रोगी ला कहीस, उभो होयके आपरी खाट उचल, अना घर जाय।<verse eid="LUK 5:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="LUK 5:25"/>वोनोच बेरा उ सबको पूढा उभो भयो, अना जोन खाट मा उ झोपयो होतो, वोला उचल के परमेस्वर को बड़ाई करत-करत आपरो घर चली गयो। <verse eid="LUK 5:25"/><verse number="26" style="v" sid="LUK 5:26"/>वय सबा चकीत भय गईन, अना परमेस्वर को भजन बड़ाई करन लगीन। अना सबा डराय के कव्हन लगीन। आज तकन अमीना असो काम नही परख पायी सेजन।<verse eid="LUK 5:26"/></para>
  <para style="s">लेवी ला हाकलनो</para>
  <para style="r">(<ref loc="MAT 9:9-13">मत्ती 9:9-13</ref>; <ref loc="MRK 2:13-17">मरकुस 2:13-17</ref>)</para>
  <para style="p">
    <verse number="27" style="v" sid="LUK 5:27"/>मंघा उ बाहेर गयो अना उ लेवी नाव को एक जमा वसूल करन वालो ला वसूल करन को नाका पर जायके बसयो चोयो, अना उ वोला कहीस मोरो मंघा भई जाय। <verse eid="LUK 5:27"/><verse number="28" style="v" sid="LUK 5:28"/>तबा उ सारी चिज ला सोड़के उभो भयो अना ओको मंघा भय गयो।<verse eid="LUK 5:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="LUK 5:29"/>तबा लेवी ना अपरो घर मा वोको लाय एक मोठो जेवन देईस, अना वहान पर जमा वसूल करन वालो, अखीन बेजा लोग वोको संग मा जेवन करन ला बस गईन, वहान लगत मानूस होतिन। <verse eid="LUK 5:29"/><verse number="30" style="v" sid="LUK 5:30"/>एको पर मोसे को नियम को गुरू, अना लेखक भन्नात यीसु को चेला गीन ला कव्हन लगीन, तूमी जमा वसूल करन वालो अधिकारी अना पापी गीन<note caller="+" style="f"><char style="fr" closed="false">5:30 </char><char style="ft" closed="false">अधरमी </char></note> को संग मा काहे जेवन करासो?<note caller="-" style="x"><char style="xo" closed="false">5:30</char><char style="xt" closed="false"><ref loc="LUK 15:1-2">लूका 15:1-2</ref></char></note><verse eid="LUK 5:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="LUK 5:31"/>यीसु ना जवाब देईस बइद साजरोगिन लाई नाहाय, लेकिन बिमार लाई जरुरी से। <verse eid="LUK 5:31"/><verse number="32" style="v" sid="LUK 5:32"/>नेक मानूस गीन ला नही पर पापी गी ला पस्तावा करन काजी हाकलन आईसेव।<verse eid="LUK 5:32"/></para>
  <para style="s">उपास को सवाल</para>
  <para style="r">(<ref loc="MAT 9:9-13">मत्ती 9:9-13</ref>; <ref loc="MRK 2:13-17">मरकुस 2:13-17</ref>)</para>
  <para style="p">
    <verse number="33" style="v" sid="LUK 5:33"/>उनना यीसु ला कहिन, योहन को चेला गीन बार-बार उपास राखासे। अना पिराथना मा लग्यो रव्हसे, अना मोसे को नियम को गुरू चेलागिन भी वसोच करासेत पर तोरा चेलागिन काहे जेवत रव्हासेत?<verse eid="LUK 5:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="LUK 5:34"/>तबा यीसु ना उन लक कहीस की जबा तकन बराती नवरदेव को संग मा रव्हासे, त बराति कसो उपास रव्ह सकासेत? <verse eid="LUK 5:34"/><verse number="35" style="v" sid="LUK 5:35"/>पर वोना दिवस आवन वारा से। जबा मि इनको लक दुहुर भई जाहू उना दिवस मा वय उपास करयेत।<verse eid="LUK 5:35"/></para>
  <para style="p">
    <verse number="36" style="v" sid="LUK 5:36"/>वोना अखीन एक उदाहरन उनको लक कहीस। कोनी मानूस नयो कपरा मा जुनो कपरा को तनी नही लगाय सकासेत। काहेकि जूनो कपरा फट जाहे अखीन जुनो कपरा मा नवतो कपरा को तनी नही लगा सकासे काहेका जूनो तनी टुट जाहेत। एकोलाय नयो मेल नही खायेत। <verse eid="LUK 5:36"/><verse number="37" style="v" sid="LUK 5:37"/>अखीन कोनी नवा अंगूर को रस जुनो चमड़ा को कुप्पा मा नही डाखत। नही तो नयो वालो अंगूर रस छागल ला फाड़के बोह जाएत अखीन छागल नास भई जाहेत। <verse eid="LUK 5:37"/><verse number="38" style="v" sid="LUK 5:38"/>मंग नवा अंगूर को रस नवो छागल मा डाखनो खरो से। <verse eid="LUK 5:38"/><verse number="39" style="v" sid="LUK 5:39"/>कोनी मानूस जुनो अंगूर को रस पिवके नयो नही चाव्हासे। सांगासे क जुनो च साजरो से।<verse eid="LUK 5:39"/></para>
  <chapter eid="LUK 5"/>
  <chapter number="6" style="c" sid="LUK 6"/>
  <para style="s">बिसराम दिवस को सवाल</para>
  <para style="r">(<ref loc="MAT 12:1-8">मत्ती 12:1-8</ref>; <ref loc="MRK 2:23-28">मरकुस 2:23-28</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 6:1"/>तबा यीसु अखीन वोको चेला गीन, पवीतर दिवस <note caller="+" style="f"><char style="fr" closed="false">6:1</char><char style="ft" closed="false">सब्त को दिवस</char></note>मा, एक खेत मा लक जावत होतो। आखिन वोको चेला गीन, सेंग तोडके, अना हात लक मल के, जेवत-जेवत जावत होतीन। <verse eid="LUK 6:1"/><verse number="2" style="v" sid="LUK 6:2"/>तबा मोसे को नियम को गुरू मा, काही कव्हन लगीन, मोसे को नियम लक जोन काम पवीतर दिवस मा, करनो मनाहिसेत, तुमी वोच काम कायलाय करोसो।<verse eid="LUK 6:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="LUK 6:3"/>मंग यीसु न उनला जवाब देइस, का तुमीना यो नही बाचिसेव? दाऊद राजा अखीन वोको संगी गीनला, जबा भूख<note caller="+" style="f"><char style="fr" closed="false">6:3</char><char style="ft" closed="false">खाली पोट</char></note> लग्यो होतो। तबा वय का करीन? <verse eid="LUK 6:3"/><verse number="4" style="v" sid="LUK 6:4"/>वय परमेस्वर को घर मा गईन, अना भेंट की भाखर ला आन के, अपरो संगीगिन सगं जेविन, जोनला मोसे को नियम लक याजक<note caller="+" style="f"><char style="fr" closed="false">6:4</char><char style="ft" closed="false">मंदिर को पुजारी</char></note> ला सोड़के, कोनी ला जेवन करनो खरो नहात।<verse eid="LUK 6:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="LUK 6:5"/>अखीन वोना उनला सांग्यो, मानूस को टूरा पवीतर दिवस को भी पिरभू सेत।<verse eid="LUK 6:5"/></para>
  <para style="s">सुकयो हात वालो ला साजरो करनो</para>
  <para style="r">(<ref loc="MAT 12:9-14">मत्ती 12:9-14</ref>; <ref loc="MRK 3:1-6">मरकुस 3:1-6</ref>)</para>
  <para style="p">
    <verse number="6" style="v" sid="LUK 6:6"/>एक बेरा यीसु, पवीतर दिवस सभाघर मा जायके, सिक्सा देवन लगयो। अना वहान एक मानूस होतो, जेनको उज्जो हात सूकयो होतो। <verse eid="LUK 6:6"/><verse number="7" style="v" sid="LUK 6:7"/>मोसे को नियम को गुरू आना धरमगुरू, एना गोस्टी को तक्का मा होतीन, की अदी यीसु पवीतर दिवस मा साजरो करासे, ता वय ओको पर दोस लगाय सकसेत। <verse eid="LUK 6:7"/><verse number="8" style="v" sid="LUK 6:8"/>यीसु उनको मन को विचार जानत होतो, येको लाय वोना सुक्को हातवालो मानूस ला कहीस, बीच मा उभो होय जाय! तब उ उठ के उभो भय गयो। <verse eid="LUK 6:8"/><verse number="9" style="v" sid="LUK 6:9"/>यीसु ना उनला कव्हयो, मि तुमी लक पुससू मोसे को नियम लक पवीतर दिवस मा भलो करनो साजरो से का खोटो से? जान बचानो या जान ला लेवनो? <verse eid="LUK 6:9"/><verse number="10" style="v" sid="LUK 6:10"/>तबा वोना इता-उता सबला चोवीस, अना मानूस लक कहीस, अपरो हात बढ़ाव, वोना वसोच करीस अखीन वोको हात जसो को तसोच साजरो भई गयो।<verse eid="LUK 6:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="LUK 6:11"/>वय लोग गीन गजब गुस्सा भय गईन, अना आपसी मा बिचार करन लगीन, का हमी यीसु को संग मा का करबीन?<verse eid="LUK 6:11"/></para>
  <para style="s">बारा चेला गीन ला निवाड़नो</para>
  <para style="r">(<ref loc="MAT 10:1-4">मत्ती 10:1-4</ref>; <ref loc="MRK 3:13-19">मरकुस 3:13-19</ref>)</para>
  <para style="p">
    <verse number="12" style="v" sid="LUK 6:12"/>यीसु वोना दिवस मा पहाड़ी मा पिराथना करन गयो, अना परमेस्वर लक पिराथना करनो मा पूरी रात बिताइस। <verse eid="LUK 6:12"/><verse number="13" style="v" sid="LUK 6:13"/>जबा दिवस भयो तो वोना अपरो, चेला गीनला हाकल के ओमा लक बारा चेला गीनला निवाड़ो, अखीन उनला पेरीत<note caller="+" style="f"><char style="fr" closed="false">6:13</char><char style="ft" closed="false">खबर देके धाड़यो गयो खबरी</char></note> कहीस। <verse eid="LUK 6:13"/><verse number="14" style="v" sid="LUK 6:14"/>अना वय यो सेत, समोन जेनको नाव, वोना पतरस राखीस। अखीन वोको भाऊ अन्दिरयास, अना याकूब, अना योहन, अना फिलिप्पुस, आना बरतुल्मै। <verse eid="LUK 6:14"/><verse number="15" style="v" sid="LUK 6:15"/>अना मत्ती, अना थोमा, आना हलफई को टूरा याकूब अना सिमोन ला जोन धरमोत्साही<note caller="+" style="f"><char style="fr" closed="false">6:15 </char><char style="ft" closed="false">जेलोतेस</char></note> कहलावासेत, <verse eid="LUK 6:15"/><verse number="16" style="v" sid="LUK 6:16"/>याकूब को टूरा यहूदा अना युदस इस्करियोति ला जोन बिन भरोसावालो होतो, जेना यीसु ला धरवायो भी होतियो।<verse eid="LUK 6:16"/></para>
  <para style="s">सिक्सा देनो अना साजरो करनो</para>
  <para style="r">(<ref loc="MAT 4:23-25">मत्ती 4:23-25</ref>)</para>
  <para style="p">
    <verse number="17" style="v" sid="LUK 6:17"/>तबा यीसु उनको संगा मा, खाल्या आयके, बर्रा मा उभो भयो। अना वोको चेलागीन, अना जनता को गरदि, सप्पा यहुदिया छेतर, येरुसलेम नगर, आना सूर अना सैदा, सागर को जवर लक लगत सा लोक, <verse eid="LUK 6:17"/><verse number="18" style="v" sid="LUK 6:18"/>जसो की वोको आयकन वारा, आपरी बीमारी लक, साजरो होवन लाय, वोको कठा आइन। वय भुत-पलित लक भुकतन वारा, लोकगीन ला साजरो करत होतो। <verse eid="LUK 6:18"/><verse number="19" style="v" sid="LUK 6:19"/>सबा लोकगीन यीसुला छिवन को कोसीस करत होतिन, काहेका वोको लक ताकत हिटके ना, सबला साजरो करत होतो।<verse eid="LUK 6:19"/></para>
  <para style="s">आसीरवाद अना सोक गोस्टी</para>
  <para style="r">(<ref loc="MAT 5:1-12">मत्ती 5:1-12</ref>)</para>
  <para style="q1">
    <verse number="20" style="v" sid="LUK 6:20"/>यीसु ना आपरो चेला गीन, को कना चोवयो, अना यो कहीस,</para>
  <para style="q2" vid="LUK 6:20">“धन्य सेव तुमी जो गरिब सेव काहेका, परमेस्वर को राज तुमरोच सेत।”<verse eid="LUK 6:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="LUK 6:21"/>धन्य सेव तुम्ही जोन भुखो सेव,</para>
  <para style="q2" vid="LUK 6:21">काहेका तुमी अघाय जाहो।</para>
  <para style="q1" vid="LUK 6:21">धन्य सेव तुमी, अबा रोवसो</para>
  <para style="q2" vid="LUK 6:21">काहेका तुमला हसनो पड़हेत।<verse eid="LUK 6:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="LUK 6:22"/>धन्य सेव तुमी जबा मानूस को टूरा को कारन लक लोक तुमरो लक बुराई करे, अना तुम ला हेड देहेत, आना तुमरो निंदा करते, अखीन तुमरो नाव ला बुरो जानके काप<note caller="+" style="f"><char style="fr" closed="false">6:22 </char><char style="ft" closed="false">मसीह लक तुम्ही बेगरो कियो जाहो।</char></note> देहेत।<note caller="-" style="x"><char style="xo" closed="false">6:22</char><char style="xt" closed="false"><ref loc="1PE 4:14">1 पतरस 4:14</ref></char></note> <verse eid="LUK 6:22"/><verse number="23" style="v" sid="LUK 6:23"/>वोच दिवस खुसी होवने, अखीन खुसहाली मनाने काहेका, सरग मा मोठो फर<note caller="+" style="f"><char style="fr" closed="false">6:23</char><char style="ft" closed="false">सरग को अमर जीवन</char></note> सेत, उनको आजा पुरखा भविस्यवक्ता गीनको संग, असोच करयो सेत।<note caller="-" style="x"><char style="xo" closed="false">6:23</char><char style="xt" closed="false"><ref loc="ACT 7:52">पेरीत 7:52</ref></char></note><verse eid="LUK 6:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="LUK 6:24"/>अखीन हाय तुमरो पर जोकी धनवान सेव,</para>
  <para style="q2" vid="LUK 6:24">येको लाय तुमी आपरो सान्ती पाय गयो सेव।<verse eid="LUK 6:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="LUK 6:25"/>धिक्कार सेत “तुमरो पर, अता अघाय सेव,</para>
  <para style="q2" vid="LUK 6:25">काहेका तुम, ला भुखो रव्हनो पडे़त।”</para>
  <para style="q1" vid="LUK 6:25">धिक्कार सेत तुमला, जोन अबा हासोसेव काहेका,</para>
  <para style="q2" vid="LUK 6:25">तुमला रोवनो अखीन दुख मनानो पड़हेत।<verse eid="LUK 6:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="LUK 6:26"/>धिक्कार से जबा मानूस तुमला भला कहेत, काहेकि उनको बाप-आजा ना, भी खोटो भविस्यवक्ता गीनको सँगा असोच बरताव करयो होतीन।<verse eid="LUK 6:26"/></para>
  <para style="s">बयरी लक माया</para>
  <para style="r">(<ref loc="MAT 5:38-48">मत्ती 5:38-48</ref>; <ref loc="MAT 7:12">7:12</ref>)</para>
  <para style="p">
    <verse number="27" style="v" sid="LUK 6:27"/>पर मि तुमी आयकन वारा गिनला कहुँसू आपरो बैरी गीन लक माया राखो, जोन तुमरो लक बैर राखासे, उनको भलाई करो। <verse eid="LUK 6:27"/><verse number="28" style="v" sid="LUK 6:28"/>तुम ला जोन सराप देवासे उनला आसीस देव। जो तुमरो बेईज्जति करासे, उनको लाय पिराथना करो। <verse eid="LUK 6:28"/><verse number="29" style="v" sid="LUK 6:29"/>अना तोरो एक गाल मा झापड़ मारासे तबा दुसरो गाल ला भि देदे। जोन तोरी पचिया ला हिसकवासे वोला झंगा भी देदे। <verse eid="LUK 6:29"/><verse number="30" style="v" sid="LUK 6:30"/>जोन कोनी तोरो लक मांगासे, वोला देवने, अखीन जो चिज ला हिसकासे वोको लक नोको मागंने। <verse eid="LUK 6:30"/><verse number="31" style="v" sid="LUK 6:31"/>जसो तुमी चाव्हासेव का लोग गीन तुमरो संग करेत, तुमी भि उनको संग मा वसोच करो।<note caller="-" style="x"><char style="xo" closed="false">6:31</char><char style="xt" closed="false"><ref loc="MAT 7:12">मत्ती 7:12</ref></char></note><verse eid="LUK 6:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="LUK 6:32"/>अखीन तुमी आपरो चाव्हन वालो को संग मा माया राखासेव, ओमा का बड़ाई से? काहे की पापी गीन भी आपरो चाव्हन वालो को संग मा असोच करासे। <verse eid="LUK 6:32"/><verse number="33" style="v" sid="LUK 6:33"/>अखीन तुमी आपरो भलो करन वालो संग मा, भलो करासो, असो मा तुमरो का बड़ाई से? काहे की पापी भी असोच करासे। <verse eid="LUK 6:33"/><verse number="34" style="v" sid="LUK 6:34"/>जोन लक मिलन को भरोसा ठेवा सो उनला उधार देवासो, तो तुमरो काजक बड़ाई से? काहेकी पापी भी सबला, उधारी देव से। क मंग वोतरोच पाय सके। <verse eid="LUK 6:34"/><verse number="35" style="v" sid="LUK 6:35"/>पर मिले न नोको मिले, पर माँगन वालो ला उधारी देव, यो तुमरो लाय मोठो फर होयेत। अना तुम्ही परमेस्वर को, टूरा-टूरी कहलाने, काहे की जोन परमेस्वर ला नही मानासे, अखीन बुरो भी सेत, ओको पर भी, परमेस्वर भलो सेत। अना आपरो सतरु लक, माया करो। <verse eid="LUK 6:35"/><verse number="36" style="v" sid="LUK 6:36"/>जसो परमेस्वर दयालू से, वसोच तुमी दयालु बनो।<verse eid="LUK 6:36"/></para>
  <para style="s">दोस नोको लगाव</para>
  <para style="r">(<ref loc="MAT 7:1-4">मत्ती 7:1-4</ref>)</para>
  <para style="p">
    <verse number="37" style="v" sid="LUK 6:37"/>तुम्हि न्याय नोको करो अना “नोको बोट उठाव, नही तो तुमरो पर भी उठायो जाहेत।” छिमा देदो, तो तुमला भी छिमा कर दियो जाहेत। <verse eid="LUK 6:37"/><verse number="38" style="v" sid="LUK 6:38"/>देवो तो तुमला भी दियो जाहेत, लोकगीन ठुस-ठुस के गजब, तुमरो आचर मा डाखेत। काहेकि जोन नाप लक तुम नापिसेव, वोच लक तुमरो लाय नापयो जाहेत।<verse eid="LUK 6:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="LUK 6:39"/>मंग वोना उनला यो हाना डाखिस, “का अँधरा-अँधरा ला रस्ता चोवाय सकासे? दुई खोदरा मा पड़ जाहेत<note caller="-" style="x"><char style="xo" closed="false">6:39</char><char style="xt" closed="false"><ref loc="MAT 15:14">मत्ती 15:14</ref></char></note>।” <verse eid="LUK 6:39"/><verse number="40" style="v" sid="LUK 6:40"/>का चेला आपरो गुरूले मोठो होयेत, नही, आपरो गुरू को जसो भई जाहेत योच लगत से।<note caller="-" style="x"><char style="xo" closed="false">6:40</char><char style="xt" closed="false"><ref loc="MAT 10:24-25">मत्ती 10:24-25</ref>; <ref loc="JHN 13:16">योहन 13:16</ref>; <ref loc="JHN 15:20">15:20</ref></char></note><verse eid="LUK 6:40"/></para>
  <para style="p">
    <verse number="41" style="v" sid="LUK 6:41"/>तु आपरो भाऊ को डोरा मा तिनका, काय लइ चोवासेस, पयले आपरो डोरा मा को लठ्ठा नही चोवसे। <verse eid="LUK 6:41"/><verse number="42" style="v" sid="LUK 6:42"/>जबा तोला आपरो डोरा को, लठ्ठा नही चोवासे, तबा आपरो भाऊ ला कसो कह सकसे? अगा भाउ, रव्हजोस, तोरो डोराको तिनका हेड़देसू। अगा कपटी पयले, आपरो डोरा लक लट्टा हेड, तबा, आपरो भाऊ को डोरा मा लक, तिनका हेड़न काजी, साजरो लक चोवजोस।<verse eid="LUK 6:42"/></para>
  <para style="s">जसो झाड़ वसोच फर</para>
  <para style="r">(<ref loc="MAT 7:16-20">मत्ती 7:16-20</ref>; <ref loc="MAT 12:33-35">12:33-35</ref>)</para>
  <para style="p">
    <verse number="43" style="v" sid="LUK 6:43"/>असो साजरो झाड़ नोहोय जेव निकम्मो फर आनेत, अखीन असो नोहोय का निकम्मा झाड़ सजरो फर आनेत। <verse eid="LUK 6:43"/><verse number="44" style="v" sid="LUK 6:44"/>अना सप्पा झाड़ अपरो फर लक चिन्हो जासेत काहेका लोग गीन झाड़ी मा लक अँजीर नही तोड़त अखीन कांटा को झाड़ लक अंगूर नही तोड़ासेत।<note caller="-" style="x"><char style="xo" closed="false">6:44</char><char style="xt" closed="false"><ref loc="MAT 12:33">मत्ती 12:33</ref></char></note> <verse eid="LUK 6:44"/><verse number="45" style="v" sid="LUK 6:45"/>साजरो मानूस अपरो मन को साजरा पेटखोली लक सजरो गोस्टी हेड़ासे अना बुरो मानूस अपरो आतमा को पेटखोली लक बुरी- बुरी गोस्टी हेड़ासेस काय की जेनो आतमा मा ठुसीसे वाच वोको टोंड पर अवासे।<note caller="-" style="x"><char style="xo" closed="false">6:45</char><char style="xt" closed="false"><ref loc="MAT 12:34">मत्ती 12:34</ref> </char></note><verse eid="LUK 6:45"/></para>
  <para style="s">घर बनावनवारा दुई मानूस</para>
  <para style="r">(<ref loc="MAT 7:24-27">मत्ती 7:24-27</ref>)</para>
  <para style="p">
    <verse number="46" style="v" sid="LUK 6:46"/>जबा तुमी मोरो कव्हनो नही मानो ता कायलाय मोला हे पिरभू, हे पिरभू! कव्हसो <verse eid="LUK 6:46"/><verse number="47" style="v" sid="LUK 6:47"/>जोन मोरो जवर आवासे अखीन मोरी गोस्टी आयकासे वोला मी ओरखूसु अना मी तुमला सांगसू का उ कोन को जसो से। <verse eid="LUK 6:47"/><verse number="48" style="v" sid="LUK 6:48"/>उ वोनो मानूस को जसो से जोन घर बनावतो बेरा मा धरती ला खोदकर गहेरी करके ना वोना चट्टान मा पाया डाकीस अखीन जबा पूरा को धार वोना घर मा लगी अना वोनो घर ला नही हलाय सकीस काहेकी उ घर पक्को बनयो होतो। <verse eid="LUK 6:48"/><verse number="49" style="v" sid="LUK 6:49"/>पर जोन आयक के नही मानसे उ मानूस वोको जसो से जोन चट्टान मा पाया खोदन को जघा जमीन मा बिना पाया को घर बनावासे अना जबा पूर आवासे, त वोको घर नास भय जासे।<verse eid="LUK 6:49"/></para>
  <chapter eid="LUK 6"/>
  <chapter number="7" style="c" sid="LUK 7"/>
  <para style="s">सुबेदार को भरोसा</para>
  <para style="r">(<ref loc="MAT 8:5-13">मत्ती 8:5-13</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 7:1"/>जबा उ लोग गीन ला, गजब सी गोस्टी सांग चुकयो तबा कफरनहुम नगर मा आयो। <verse eid="LUK 7:1"/><verse number="2" style="v" sid="LUK 7:2"/>वहान एक सूबेदार को, एक नौकर बिमारी लक, मरन वालो होतो। सुबेदार वोला गजब चाव्हत होत्यो। <verse eid="LUK 7:2"/><verse number="3" style="v" sid="LUK 7:3"/>यीसु की गोस्टी ला आयक के, सुबेदार यहूदिगीन आपरा सयानो गीनला, अना कई नावी मानूस, ला यीसु को जवर, बिनती करन धाड़िन, का जायके वोको नौकर ला बचाय लेय। <verse eid="LUK 7:3"/><verse number="4" style="v" sid="LUK 7:4"/>गुरू गीन यीसु को कठा आइन, अखीन बिनती करके कव्हन लगीन। उ सूबेदार यो काबील सेत, का वोको नौकर ला, तू साजरो कर दे। <verse eid="LUK 7:4"/><verse number="5" style="v" sid="LUK 7:5"/>काहे का, यो सभाघर ला वोच ना बनवाइसेस। अना उ आमरो लोक गीन लक माया राखासे।<verse eid="LUK 7:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="LUK 7:6"/>यीसु उनको, संग-संग गयो, वय वोको, घर को, कठा पहुचयो होतिन, सुबेदार ना आपरो संगी गीनको जवर, यीसु को लाय यो खबर धाडीस। पिरभू दुख नोको उठावस, काहेकी, मी यो काबिल नही सेव, का तुमी मोरो छत मा आव। <verse eid="LUK 7:6"/><verse number="7" style="v" sid="LUK 7:7"/>एको काजी मी तोरो कठा नही आईसेव, पर तू वहाँच लक हुकूम दे, अना मोरो दास साजरो भय जाहेत। <verse eid="LUK 7:7"/><verse number="8" style="v" sid="LUK 7:8"/>मी खुदच सरकारी अधिकारी सेव। अना सिपाई मोरो हात को खाल्या सेत, अना जबा मी, एक ला कव्हसू, तु जाय, तो उ जासे अना दूसरो ला कव्हासू तू आव तो उ आवासे। अखीन अपरो दास ला कव्हासू का तु यो कर त उ करासे।<verse eid="LUK 7:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="LUK 7:9"/>यो आयक के यीसु ला अचंभा भयो, वोना आपरो मंघा आवन वालो ला कव्हयो, असो भरोसा ठेवन वालो मी, इसरायल लोक मा नही चोवीसेव।<verse eid="LUK 7:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="LUK 7:10"/>अना खबरिया, जबा घर मा आइन, तबा उ दास सजरो भय गयो होतो।<verse eid="LUK 7:10"/></para>
  <para style="s">बेवा बायको को टूरा ला जित्तो करनो</para>
  <para style="p">
    <verse number="11" style="v" sid="LUK 7:11"/>काही दिवस को मंघा, यीसु नाईन नाव को नगर मा गयो। गजब जनता, अखीन चेला गीन वोको संगमा होतिन। <verse eid="LUK 7:11"/><verse number="12" style="v" sid="LUK 7:12"/>जब वय नगर मा भीतर धसन को जघा मा गयीन, तब लोक साकोली मा एक लास बाहेर ले जावत होतीन। उ आपरो माय को एकच टूरा होतो, अना वोकी माय बेवा होती, नगर को लगत जनता वोको संग होतीन। <verse eid="LUK 7:12"/><verse number="13" style="v" sid="LUK 7:13"/>वोला चोवके यीसु पिरभू दया लक भर गयो, अखीन वोको लक काहीस, रड़स नोको <verse eid="LUK 7:13"/><verse number="14" style="v" sid="LUK 7:14"/>तबा वोना जवर आयके सकोली ला छिइस अखीन उचलन वारा उभो भईन। तबा वोना कव्हासे ओ जुवान तोला कव्हसू का उठ जाय, <verse eid="LUK 7:14"/><verse number="15" style="v" sid="LUK 7:15"/>तबा मुरदा जाग के ना बस गयो, अखीन वोना वोकी माय ला सोप देइस।<verse eid="LUK 7:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="LUK 7:16"/>यो चोवके सबा डराय गईन, अउर वय, परमेस्वर को बड़ाई करके कव्हन लगीन, का हमारो बिच मा एक मोठयो भविस्यवक्ता आईसे, अखीन परमेस्वर आपरो लोक-बाग गीन पर किरपा करीसेस।<verse eid="LUK 7:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="LUK 7:17"/>अना ओको बारे मा यो गोस्टी सप्पा यहुदिया अना अगल-बगल को सब देस मा फैल गयो।<verse eid="LUK 7:17"/></para>
  <para style="s">योहन बप्तिस्मा देवनवारा को सवाल</para>
  <para style="r">(<ref loc="MAT 11:2-19">मत्ती 11:2-19</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="LUK 7:18"/>योहन को चेला गीन, यो गोस्टी वोला सांगिन। <verse eid="LUK 7:18"/><verse number="19" style="v" sid="LUK 7:19"/>तबा योहन आपरो चेला मा लक दोन ला, यीसु पिरभू को कठा, यो पूसन ला धाड़िस, का आवनवालो तू च आस? का दुसरो सेत, हमि वोको बाट चोयबीन।<verse eid="LUK 7:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="LUK 7:20"/>तबा वय लोक ओको जवर आवा सेत ता उनना कहिन योहन बप्तिस्मा देन वालो यो कव्हके पूसन ला धाड़िसेस। “का आवनवालो तू च आस, का अखीन कोनी सेत?” <verse eid="LUK 7:20"/><verse number="21" style="v" sid="LUK 7:21"/>ओना बेरा, ओना गजब बिमार ला दया लक साजरो करीस, अँधरा गीनको डोरा उघाड़ो, अना भूत-पलीत ला भगायो। <verse eid="LUK 7:21"/><verse number="22" style="v" sid="LUK 7:22"/>वोना उनलक कहीस, जोन काही तुम्ही ना चोवीसेव, अखीन आइकू सेव, जायके योहन लक साँगने का, अँधरा चोवा से, लंगडा हिडंसे, कोढी साजरो होवासे, बहेरा आयकासेत, मरयो हुयो जित्तो होवासे, अखीन गरिब गोर<note caller="+" style="f"><char style="fr" closed="false">7:22</char><char style="ft" closed="false">कंगाल</char></note> गीनला, परमेस्वर को साजरो बारता सांगासेत। <verse eid="LUK 7:22"/><verse number="23" style="v" sid="LUK 7:23"/>अना धन्य “किस्मत वारा से” उ जोन मोरो बारे मा ठोकर ना खाय।,<verse eid="LUK 7:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="LUK 7:24"/>जबा योहन को चेला चले गइन, त यीसु योहन को बारे मा लोग गीन ला संगिस, “तुमी जंगल मा का चोवन गयो होतो? का हवा लक हिलतो, झाड़-झड़ुला ला। <verse eid="LUK 7:24"/><verse number="25" style="v" sid="LUK 7:25"/>तुमी का चोवन गयो होतो? का नरम कपरा पहरो हुवो मानूस ला, जोन सजरा कपरा पहिरिसेस, अना सुख लक रव्हसे? उ महीमा लक राज दरबार मा रव्हसे। <verse eid="LUK 7:25"/><verse number="26" style="v" sid="LUK 7:26"/>तबा तुमी का चोवन ला गयो होतो, का कोनी भविस्यवक्ता ला? मि तुमरो लक कव्हसु, उ भविस्यवक्ता लक मोठो सेत। <verse eid="LUK 7:26"/><verse number="27" style="v" sid="LUK 7:27"/>यो वोच से जेनको बारे मा लिखिसे, चोव मी, आपरो दूत ला, तोरो पूढ़ा-पूढ़ा धाड़सु, जो तोरो पूढ़ा लक रस्ता सीधो<note caller="+" style="f"><char style="fr" closed="false">7:27</char><char style="ft" closed="false">रास्ता साजरो करहेत।</char></note> करयेत। <verse eid="LUK 7:27"/><verse number="28" style="v" sid="LUK 7:28"/>मि तुमी ला कव्हसू, जोन बायको लक जलमो से, उनमा कोनी योहन लक मोठो नहात। पर जोन परमेस्वर को राज मा, सबा लक नाहनो सेत, उ योहन लक मोठो सेत।”<verse eid="LUK 7:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="LUK 7:29"/>सबा जनता अखीन जमा लेवन वारा अधिकारी गीन, जबा यो आयकिन तो, उनना योहन को बप्तिस्मा लेवन को कारन, परमेस्वर को न्यायीपन ला खरो मान<note caller="+" style="f"><char style="fr" closed="false">7:29</char><char style="ft" closed="false">परमेस्वर पर भरोसा </char></note> लेईन। <verse eid="LUK 7:29"/><verse number="30" style="v" sid="LUK 7:30"/>अखीन धरमगुरू अना मोसे को नियम को गुरू ना, वोको बप्तिस्मा नही लेइन, अखीन परमेस्वर ना उनको लाय, जोन तरकिब हेड़ो होतो, वोला नापास<note caller="+" style="f"><char style="fr" closed="false">7:30</char><char style="ft" closed="false">परमेस्वर को गोस्टी ला सांगनो </char></note> कर देईन।<verse eid="LUK 7:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="LUK 7:31"/>यीसु ना कव्हयो, अता मी, यो जुग को लोकगीन ला, कोनी को जसो समझू, यो कोनी को समान सेत? <verse eid="LUK 7:31"/><verse number="32" style="v" sid="LUK 7:32"/>वय वोना टूरागिन को जसो से, जो हाट मा बस्यो एक दुसरो लक हाकलके कव्हासे, अमीना तुमरो लाय बंसरी बजाया, अखीन तुमी नही नाचिसेउ, हमी दुखी भयी सेजन, अखीन तुमी नही रड़ीसेव। <verse eid="LUK 7:32"/><verse number="33" style="v" sid="LUK 7:33"/>योहन बप्तिस्मा देवन वालो कभी जेवन नही जेवो, न कभी दारू पिविस, मंग तुमीना कव्हयो, एको मा बालजबुल से। <verse eid="LUK 7:33"/><verse number="34" style="v" sid="LUK 7:34"/>मानूस को टूरा जेवन करतो अना पिवतो आयो सेत अना तुम्ही कव्हसो चोवो, यो मानूस कसो अघोरी सेत? यो तो, बरगन लेवन वारा पापी गिनको संगी सेत। <verse eid="LUK 7:34"/><verse number="35" style="v" sid="LUK 7:35"/>पर परमेस्वर की अक्कल अपरो सबा परजा को लक खरो दिसाईसेस।<verse eid="LUK 7:35"/></para>
  <para style="s">फरीसी को घरमा पापनी बायको ला छिमा करनो</para>
  <para style="p">
    <verse number="36" style="v" sid="LUK 7:36"/>कोनी मोसे को नियम को गुरू न बिनती करीस, की मोरो संग जेवन कर, तबा धरमगुरू को संग, ठाव मा बस्यो। <verse eid="LUK 7:36"/><verse number="37" style="v" sid="LUK 7:37"/>नगर मा एक पापी बायको होति। वोला पता चलयो, का यीसु मोसे को नियम को गुरू को घर मा जेवन ला बसीसे, वहान वोना एक सीसी मा इतर आनिस। <verse eid="LUK 7:37"/><verse number="38" style="v" sid="LUK 7:38"/>अखीन रड़त-रड़त यीसु को पाय को जवर उभी भई, अना अपरो आसूँ लक, ओको पाय ला धोवन लगी, अखीन अपरो चुन्दी लक पाय ला पोछन लगी। अना पाय को चुम्मा लेवन लगी, अना इतर ला मलन लगी। <verse eid="LUK 7:38"/><verse number="39" style="v" sid="LUK 7:39"/>जोन मोसे को नियम को गुरू यीसु ला निवता देई होतिस, असो चोवके! मन च मा कव्हन लग्यो “यदि यो मानूस भविस्यवक्ता होतो तो जान लेतो का यो बायको कसी से अना काजक करासे? काहे की वातो पापी होती।”<verse eid="LUK 7:39"/></para>
  <para style="p">
    <verse number="40" style="v" sid="LUK 7:40"/>वोको मन को बिचार जान के यीसु वोला कव्हयो ओ सिमोन! मि तोला काही कव्हनो चाव्हसू।</para>
  <para style="p" vid="LUK 7:40">वोना जवाब देइस गुरूजि सांगो।<verse eid="LUK 7:40"/></para>
  <para style="p">
    <verse number="41" style="v" sid="LUK 7:41"/>तबा यीसु न कहीस, कोनी साउकार का दुई करजदार होतिन, एक पाँच सौ दीनार<note caller="+" style="f"><char style="fr" closed="false">7:41</char><char style="ft" closed="false">एक दिवस को बन्नी</char></note>, अना दुजो पचास दीनार लेई होतिस। <verse eid="LUK 7:41"/><verse number="42" style="v" sid="LUK 7:42"/>उनको जवर काही पटावन ला नही होतो। तो उ साउकार ना उनको करजा छिमा कर देईस। वोना दुई मा कोनी साउकार लक लगत माया करयेत।<verse eid="LUK 7:42"/></para>
  <para style="p">
    <verse number="43" style="v" sid="LUK 7:43"/>सिमोन ना उत्तर दियो, मोरो समज मा मी तय करासू वोच से, जोनला लगत दे दियो गयो से।</para>
  <para style="p" vid="LUK 7:43">वोना वोको लक कहीस, की तु साजरो कव्हासेस। <verse eid="LUK 7:43"/><verse number="44" style="v" sid="LUK 7:44"/>अना वोनो बायको कन मुरकके, सिमोन ला सांगिस, का तु या बायको ला चोयोसेस, मि तोरो घर मा आयो, पर तु मोरो पाय धोवन लाई पानी नही देईस। पर या बायको, मोरो पाय ला आसूँ लक भिगोय के, अपरो चुन्दी लक पोछिसेस। <verse eid="LUK 7:44"/><verse number="45" style="v" sid="LUK 7:45"/>तुना मोला चूमा नही देईस, पर जबा लक मि आईसेऊ, या मोरो पाय ला चुमनो नही छोड़िस। <verse eid="LUK 7:45"/><verse number="46" style="v" sid="LUK 7:46"/>तुना डोस्का पर जैतून तेल लगावन नही देईस, पर येना मोरो पाय मा इतर मलन लगी। <verse eid="LUK 7:46"/><verse number="47" style="v" sid="LUK 7:47"/>येको लाय मि तोला सांगसु, या बायको को लगत पाप, छिमा भई सेति। काहेका यो मोरो लक, लगत माया करासे। पर जेनको जरासो छिमा भयोसे, वा जरासो माया करासे।<verse eid="LUK 7:47"/></para>
  <para style="p">
    <verse number="48" style="v" sid="LUK 7:48"/>तबा यीसु वोना बायको ला कहीस, आव बाया जाय तोरो पाप छिमा भय गई सेति।<verse eid="LUK 7:48"/></para>
  <para style="p">
    <verse number="49" style="v" sid="LUK 7:49"/>तबा जोन, यीसु को संग जेवन लाय बसाया होतीन। वय बिचारन लगीन यो कोन से? जो पाप ला छिमा करासे।<verse eid="LUK 7:49"/></para>
  <para style="p">
    <verse number="50" style="v" sid="LUK 7:50"/>तबा यीसु न वा बायको लक कहीस, तोला तोरो बिस्वास साजरो मोक्स देइसेस, तु सान्ती लक घर जाय।<verse eid="LUK 7:50"/></para>
  <chapter eid="LUK 7"/>
  <chapter number="8" style="c" sid="LUK 8"/>
  <para style="s">यीसु की चेलीगिन</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 8:1"/>योको मंघा उ नगर-नगर अना गाँव-गाँव परमेस्वर को राज को साजरो बारता साँगत होतो। <verse eid="LUK 8:1"/><verse number="2" style="v" sid="LUK 8:2"/>अना बारा चेला भी वोका संग होत्यो, अना गजब आई-माई गीन, जोन भुत-पलित लक, अखीन बिमारी लक, साजरी भयी होतिन। अना उनको नाव यो सेत। मरियम मगदलीनी जेनको मा सात भूत<note caller="+" style="f"><char style="fr" closed="false">8:2</char><char style="ft" closed="false">बुरी आतमा</char></note> होतिन। <verse eid="LUK 8:2"/><verse number="3" style="v" sid="LUK 8:3"/>अना राजा हेरोदेस को खजांची खोजा की बायको, अना योअन्ना अना सुसन्ना अना लगत आई-माई गीन होतिन, अना यो आपरो धन-माया<note caller="+" style="f"><char style="fr" closed="false">8:3</char><char style="ft" closed="false">संपति</char></note> लक, पिरभू को सेवा करत होतिन।<verse eid="LUK 8:3"/></para>
  <para style="s">बीज बोवन वालो को उदाहरन</para>
  <para style="r">(<ref loc="MAT 13:1-9">मत्ती 13:1-9</ref>; <ref loc="MRK 4:1-9">मरकुस 4:1-9</ref>)</para>
  <para style="p">
    <verse number="4" style="v" sid="LUK 8:4"/>जबा, मोठि भीड़ ओको कठा एकठ्ठो भईन, <note caller="+" style="f"><char style="fr" closed="false">8:4 </char><char style="ft" closed="false">बोधकथा </char></note>अना नगर-नगर को लोक हुन जमा होवन लगीन, तबा वोना उदाहरन लक सांगिस।<verse eid="LUK 8:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="LUK 8:5"/>एक बीज-बोवनवालो, बीज-बोवन हिटयो। बोनी करत बेरा, काही बीज रास्ता को कठा पड़यो। अना उनला बादल को पक्सी न आयके खाय लियो। <verse eid="LUK 8:5"/><verse number="6" style="v" sid="LUK 8:6"/>अना काही बीज चट्टान पर पड़यो अना उगयो, अखीन माटी न मिलन लक सूक गयो। <verse eid="LUK 8:6"/><verse number="7" style="v" sid="LUK 8:7"/>काही बीज कांटा को झाड़ को बिच मा पड़यो अना झाड़ झकड़ संग-संग बढके ना ओला दबाय देईस। <verse eid="LUK 8:7"/><verse number="8" style="v" sid="LUK 8:8"/>अना काही बीज साजरो जघा मा पड़यो अना उगके सौ गुना फर लायो। यो कहके ओना उचो आवाज लक कहीस, सबा ध्यान धरके आयको।<verse eid="LUK 8:8"/></para>
  <para style="s">उदाहरन को काय मतलब से?</para>
  <para style="r">(<ref loc="MAT 13:10-17">मत्ती 13:10-17</ref>; <ref loc="MRK 4:10-12">मरकुस 4:10-12</ref>)</para>
  <para style="p">
    <verse number="9" style="v" sid="LUK 8:9"/>वोको चेला गीन पुसन लगीन, यो उदाहरन को काजक मतलब से? तबा वोना सांगिस, <verse eid="LUK 8:9"/><verse number="10" style="v" sid="LUK 8:10"/>“तुम ला परमेस्वर को राज को, छुपयो गोस्टी को समझाय दियो गयो से। पर परायो ला, उदाहरन लक आयकवायो जासे। एकोलाय का वय चोवकेना बिना चोवो जसो भयी जाय, अखीन आयकनो पर भी नही समजेत<note caller="+" style="f"><char style="fr" closed="false">8:10</char><char style="ft" closed="false">मन मा अँधरापन हो जाहेत। </char></note>।”<verse eid="LUK 8:10"/></para>
  <para style="s">बीज बोवन वालो उदाहरन को मतलब</para>
  <para style="r">(<ref loc="MAT 13:18-23">मत्ती 13:18-23</ref>; <ref loc="MRK 4:13-20">मरकुस 4:13-20</ref>)</para>
  <para style="p">
    <verse number="11" style="v" sid="LUK 8:11"/>उदाहरन को मतलब असो से, बीज तो परमेस्वर को गोस्टी से। <verse eid="LUK 8:11"/><verse number="12" style="v" sid="LUK 8:12"/>“रास्ता को किनार का बीज वय सेती। जोना आयकीस, तबा बालजबूल <note caller="+" style="f"><char style="fr" closed="false">8:12</char><char style="ft" closed="false">सैतान</char></note>उनको मन लक, गोस्टी उचल ले जासे। कही असो नाहती की भरोसा राखेत, अना साजरो बिस्वास लक सूटकारा मिल जाये। <verse eid="LUK 8:12"/><verse number="13" style="v" sid="LUK 8:13"/>चट्टान मा पड़ियो बीज वय सेत, जोन परमेस्वर को गोस्टी ला खुसी-खुसी लक आयकासेव सेत, अना मानन लगासे। पर उथलो भरोसा राखासे, काहेका उनमा जड़ नही रव्हासे, अखीन परिक्सा को बेरा मा सब भरोसा खतम होय जासे। <verse eid="LUK 8:13"/><verse number="14" style="v" sid="LUK 8:14"/>जोन बीज कांटा को झाड़ पर पड़ासे, उ वय लोग सेत, जोन परमेस्वर को गोस्टी ला, आयकन पर, पयले धन-माया की चिंता, रोज को जिंदगी को सुक, लोभ-माया को कारन, उन मा फर नही लगासे। <verse eid="LUK 8:14"/><verse number="15" style="v" sid="LUK 8:15"/>साजरी जघा पर पड़ियो हुयो बीज, वय लोक होत्यो, जोन गोस्टी ला आयक केना, वोना बिचारीस, अखीन साजरो मन लक, अपनावसेत, अना धिरज लक फर आनासे।”<verse eid="LUK 8:15"/></para>
  <para style="s">फूला पर दियो</para>
  <para style="r">(<ref loc="MRK 4:21-25">मरकुस 4:21-25</ref>)</para>
  <para style="p">
    <verse number="16" style="v" sid="LUK 8:16"/>दियो पेटावनो को मंघा, बरतन लक नही ढाकासे, अखीन ना खाट को खाल्या ठेवासे। मंघ फूल मा राखसेत, का भीतर अवन वालो ला, उजाड़ो दिसेत<note caller="+" style="f"><char style="fr" closed="false">8:16</char><char style="ft" closed="false">दिया को फुल मे मडनो पर उजाड़ो </char></note>।<verse eid="LUK 8:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="LUK 8:17"/>काही, लुको नहात, जोन उघाड़ो ना जाहेत, अखीन उ सबला दिसेत, अखीन काही लुकयो नहात, जोन सबला ना दिसेत। <note caller="+" style="f"><char style="fr" closed="false">8:17</char><char style="ft" closed="false">उजाले से सब चीज उजागर होती</char></note><verse eid="LUK 8:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="LUK 8:18"/>“एको लाय होसियार रव्हो, का तुमी काजक आयकसेव? काहेका जेनको जवर सेत, वोला अखीन दियो जाहेत। अखीन जेनको जवर नहात, पर जोन सेत, उ सप्पा ले लियो जाहेत, जोनला वो आपरो समजासे।”<verse eid="LUK 8:18"/></para>
  <para style="s">यीसु की माय अखीन भाऊ</para>
  <para style="r">(<ref loc="MAT 12:46-50">मत्ती 12:46-50</ref>; <ref loc="MRK 3:31-35">मरकुस 3:31-35</ref>)</para>
  <para style="p">
    <verse number="19" style="v" sid="LUK 8:19"/>वोको भाऊ, अखीन माय, वोको जवर आइन। पर भिड को कारन लक, यीसु लक, नही मिल सकिन। <verse eid="LUK 8:19"/><verse number="20" style="v" sid="LUK 8:20"/>कोनी ना सांगिस का, “तोरो माय अखीन भाऊ, बाहेर उभो सेत, वय भेंट करन आइसेस।”<verse eid="LUK 8:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="LUK 8:21"/>वोना फट ने जवाब देईस, मोरी माय अखीन भाऊ वोच से, जोन परमेस्वर को गोस्टी आयका सेत, अखीन मानासेत।<verse eid="LUK 8:21"/></para>
  <para style="s">यीसु आँधड़ गरड़ ला सान्त करासे</para>
  <para style="r">(<ref loc="MAT 8:23-27">मत्ती 8:23-27</ref>; <ref loc="MRK 4:35-41">मरकुस 4:35-41</ref>)</para>
  <para style="p">
    <verse number="22" style="v" sid="LUK 8:22"/>अना एक दिवस यीसु, अखीन वोको चेला, डोंगा पर चढिन। वोना अपरो चेला लक कहीस, “आव हमी झिल को वोना गन जाबिन।” अना वोना नाव ला खोल देईन। <verse eid="LUK 8:22"/><verse number="23" style="v" sid="LUK 8:23"/>जबा नाव चलन लगी, तो यीसु झोप गयो, तबा झिल मा आँधड़ चली, अना डोंगा पानी मा, बुड़न लगयो। अना वय संकट मा पड़ गेईन।<verse eid="LUK 8:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="LUK 8:24"/>तबा उनना, जवर आयके वोला जगाईन, अना कव्हयो, मालीक-मालीक हमी नास भई जाबिन, तबा वोना, आँधड़ अखीन पानी ला डटकार के हुकूम देइस, अखीन आँधड़ थम गयो, अना उनको मन मा, सुकुन आयो।<verse eid="LUK 8:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="LUK 8:25"/>तबा वोना उनला कहीस, “कसो, तुमरो भरोसा कहांन से?” अना वय डराय गयो होतीन, अना चकित होय के कव्हन लगीन “उ कोन आय जोकी हुकूम पानी अना आँधड़ भी मान सेती।”<verse eid="LUK 8:25"/></para>
  <para style="s">भूत झोमयो मानूस ला साजरो करनो</para>
  <para style="r">(<ref loc="MAT 8:28-34">मत्ती 8:28-34</ref>; <ref loc="MRK 5:1-20">मरकुस 5:1-20</ref>)</para>
  <para style="p">
    <verse number="26" style="v" sid="LUK 8:26"/>अना वय गिरोसेनियो नाव को देस मा पहुचीन। जोन ओनागन गलील परदेस को पुढा मा से। <verse eid="LUK 8:26"/><verse number="27" style="v" sid="LUK 8:27"/>जबा व डोंगा लक खालया मा उतरियो, तो उ नगर मा एक मानूस होतो। जेनको मा भूत-पलित धसी होतीन। उ बिना कपरा को रव्हत होतो, न तो घर मा रव्हत होतो, उ मरघट्टी को जघा मा रहोत होत्यो। <verse eid="LUK 8:27"/><verse number="28" style="v" sid="LUK 8:28"/>व यीसु ला चोवयो, तो चिलवन लग्यो, अना ओको पुढा मा, पड़यो, अना उच्चो आवाज लक कव्हन लग्यो। “ओ मोठो, परमेस्वर को टूरा यीसु! मोला तोरो लक का काम से? तोरो लक बिनती करासू, मोला दुख नोको दे।” <verse eid="LUK 8:28"/><verse number="29" style="v" sid="LUK 8:29"/>काहेका उ भूत-पलित ला हिटन को हुकूम देवत होतो। व ओला घड़ी-घड़ी झूमत होतो अना ओला साँकल अना बेड़ी मा बांधत होतिन, पर उ बंधन ला पटा-पट तोड़ देत होतो। अना जंगल मा भागतो फिरतो रहोत होतो।<verse eid="LUK 8:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="LUK 8:30"/>यीसु न ओको लक पुसीस की, तोरो काजक नाव से।</para>
  <para style="p" vid="LUK 8:30">वोना सांगिस, मोरो नाव सार संगाड़ से, काहेका वोको भितर मा, लगत सारी बुरो आतमा होती। <verse eid="LUK 8:30"/><verse number="31" style="v" sid="LUK 8:31"/>वोना बिनती करीस हमला नरक मा जावन को हुकूम नोको देव।<verse eid="LUK 8:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="LUK 8:32"/>वहान, पहाड मा खालमानी को एक मोठो करप चर रहयो होतो। एको लाय उनना, ओको लक बिनती करीन, हमला उनमा धसन देव। यीसु ना कहीस जाय! <verse eid="LUK 8:32"/><verse number="33" style="v" sid="LUK 8:33"/>तबा भूत-पलित ओनो मानूस लक हिटके, खालमानी मा धस गईन। अना हेड जोर लक झपटयो, अना झिल मा जायके बुड़ गयीन, अना मर गयीन।<verse eid="LUK 8:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="LUK 8:34"/>तबा चरानवारा गीन, असो कान्ड चोय के पारय गेईन। अना नगर मा जाय के सबला सांगिन। <verse eid="LUK 8:34"/><verse number="35" style="v" sid="LUK 8:35"/>लोग यो चोवन, लाई यीसु को कठा आइन, अखीन उ भुत वालो मानूस ला चोवके ना भेव मा पड़ गईन। काहेका उ मानूस कपरा घाल केना सान्त यीसु को कठा बस्यो होतो। <verse eid="LUK 8:35"/><verse number="36" style="v" sid="LUK 8:36"/>अना चोवनवारा गीनना उनला सांगीन का भुत लक झोमयो हुयो मानूस कसो रिति लक साजरो भयी से।<verse eid="LUK 8:36"/></para>
  <para style="p">
    <verse number="37" style="v" sid="LUK 8:37"/>तबा गिरोसेनियो छेतर को आखा-पाखा को लोकगीन, बिनती करन लगीन, तुम्ही यहान लक चली जाव, काहे का लोग गजब भेव मा पड गई होतीन। यीसु नाव मा चघ के ना लवट गयो। <verse eid="LUK 8:37"/><verse number="38" style="v" sid="LUK 8:38"/>जोन मानूस लक बुरो आतमा हिटी होती। उ यीसु लक बिनती करके कव्हन लग्यो, मोला आपरो सँगा रव्हन दे। तबा<verse eid="LUK 8:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="LUK 8:39"/>यीसु ना कव्हयो, “का तु घर जाय, अखीन लोकगीन ला सांगजो, का परमेस्वर ना तोरो लाय, काजक-काजक काम करीसेस।” उ चले गयो अखीन सबा, नगर-नगर मा, यो गोस्टी ला परचार करन लग्यो।</para>
  <para style="p" vid="LUK 8:39">का यीसु ना मोरो लाय कसो मोठो काम करयो से।<verse eid="LUK 8:39"/></para>
  <para style="s">याईर की मरी टूरी अना धोवा को रोगी बायका</para>
  <para style="r">(<ref loc="MAT 9:18-26">मत्ती 9:18-26</ref>; <ref loc="MRK 5:21-43">मरकुस 5:21-43</ref>)</para>
  <para style="p">
    <verse number="40" style="v" sid="LUK 8:40"/>जबा यीसु लवट गयो, तबा लोग गीन वोको मान करीन, काहे का सबा वोको बाट जोहत होतीन। <verse eid="LUK 8:40"/><verse number="41" style="v" sid="LUK 8:41"/>वोना बेरा सभाघर मा, याईर नाव को एक मुखिया आयो। अखीन यीसु को पाव पड़के, ना बिनती करन लग्यो, का मोरो घर चल,<verse eid="LUK 8:41"/></para>
  <para style="p">
    <verse number="42" style="v" sid="LUK 8:42"/>काहेका वोकी एकच टूरी होती। वोको, उमर 12 साल होति, व आखीर सांस लेवत होति। यीसु वोको संग जावन लग्यो। रस्ता मा भीड़, यीसु ला, दबान लगीन। <verse eid="LUK 8:42"/><verse number="43" style="v" sid="LUK 8:43"/>एक बायको बारा बरस लक लाल धोवा को बीमारी लक, परेसान होती, वा साजरो होवन को लायक भी नहोती। वा आपरो सबा धन, बैद को जवर, इलाज मा लगा देयि होती, पर उ साजरो नही भई। <verse eid="LUK 8:43"/><verse number="44" style="v" sid="LUK 8:44"/>वा आयके ना, कपरा को छोर ला, छिव लेयी, अखीन वोको रकत बहनो, बंद भई गई। <verse eid="LUK 8:44"/><verse number="45" style="v" sid="LUK 8:45"/>तबा यीसु ना कव्हयो, “मोला कोन छिवी से?” सबको मना करन को मघा, पतरस ना कव्हयो,</para>
  <para style="p" vid="LUK 8:45">“गुरूजी, तुम्ही भीड़ लक घिरोसव, अखीन भीड़ तोरो पर पड़ासे।”<verse eid="LUK 8:45"/></para>
  <para style="p">
    <verse number="46" style="v" sid="LUK 8:46"/>यीसु ना कव्हयो, “कोनी ना जरुर मोला छिवी सेस, काहे का मी ना समज गई सेव, का मोरो लक, साजरो होवन वालो ताकत हिटी से।” <verse eid="LUK 8:46"/><verse number="47" style="v" sid="LUK 8:47"/>तबा वा बायको ना चोयी, का मी लुक नही सकसू, तबा थरथारान लगी, यीसु को पाय पड़के ना, सब लोकगीन को पूढा सांगन लगी, का काहे छिवीसेव, अखीन उ कसो साजरो भई गई। <verse eid="LUK 8:47"/><verse number="48" style="v" sid="LUK 8:48"/>यीसु ना वोला कव्हयो “बेटी, तोरो भरोसा ना तोला साजरो करीसेस। तू सान्ती लक घर जाय।”<verse eid="LUK 8:48"/></para>
  <para style="p">
    <verse number="49" style="v" sid="LUK 8:49"/>यीसु साँगत होत्यो, तबच उ सभाघर को मुखिया लक एक मानूस आयो। अखीन कव्हयो, “तोरी टूरी मर गई, तु गुरूजी ला सांग दे।”<verse eid="LUK 8:49"/></para>
  <para style="p">
    <verse number="50" style="v" sid="LUK 8:50"/>यो आयक के, यीसु न कव्हयो, “भेव नोको खाय, भरोसा राख, उ साजरो भई जाहेती।”<verse eid="LUK 8:50"/></para>
  <para style="p">
    <verse number="51" style="v" sid="LUK 8:51"/>जब यीसु याईर को घर मा, पहुचयो। तो वोना पतरस योहन अना याकूब, अखीन टूरी को माय-बाबूजी को सीवा कोनी ला भीतर नही, आवन दियो। <verse eid="LUK 8:51"/><verse number="52" style="v" sid="LUK 8:52"/>सब रड़त होतीन, यीसु ना कहेयो “नोको रडो, यो मरी नहाति, पर जप मा से।”<verse eid="LUK 8:52"/></para>
  <para style="p">
    <verse number="53" style="v" sid="LUK 8:53"/>लोकगीन यीसु को मजाक उडावन लगीन, काहेका, सब जानत होतीन। का वा मर गईसे। <verse eid="LUK 8:53"/><verse number="54" style="v" sid="LUK 8:54"/>यीसु ना टूरी को हाथ धरके ना कव्हयो, टूरी उठ ओ। <verse eid="LUK 8:54"/><verse number="55" style="v" sid="LUK 8:55"/>तबा टूरी को जीव लवट के आई गई, अखीन उ जाग के ना बस गई। यीसु न कव्हयो, एला काही जेवन देव। <verse eid="LUK 8:55"/><verse number="56" style="v" sid="LUK 8:56"/>वाको माय-बाबूजी चकीत भई गईन। पर यीसु न कव्हयो, यो चरचा कोनीला नोको सागजोस।<verse eid="LUK 8:56"/></para>
  <chapter eid="LUK 8"/>
  <chapter number="9" style="c" sid="LUK 9"/>
  <para style="s">बारा पेरीतगिन ला धाड़नो</para>
  <para style="r">(<ref loc="MAT 10:5-15">मत्ती 10:5-15</ref>; <ref loc="MRK 6:7-13">मरकुस 6:7-13</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 9:1"/>तबा यीसु ना, 12 चेला गिनला हाकलिस। अना उनला, भुत-पलित, बुरो आतमा हेड़न अना बिमारी साजरो करन की ताकत, अखीन अधिकार देईस। <verse eid="LUK 9:1"/><verse number="2" style="v" sid="LUK 9:2"/>अना उनला, परमेस्वर को राज को परचार करन लाई, अखीन बिमार गीनला, साजरो करन लाई, धाडीस। <verse eid="LUK 9:2"/><verse number="3" style="v" sid="LUK 9:3"/>वोना उनको लक कहीस, का रास्ता लाई काही नोको आनने रुपिया-पैसा, लाठी-वाठी, खानो-पिनो को समान, कुरता-पचिया झोला-झंकड़ नोको राखने। <verse eid="LUK 9:3"/><verse number="4" style="v" sid="LUK 9:4"/>जेनो घर मा, तुमी उतरनो, वहान रव्हने, अखीन वहान लक, सार होवने। <verse eid="LUK 9:4"/><verse number="5" style="v" sid="LUK 9:5"/>जोन कोनी तुम्हिला नही पुसेत, उ नगर लक हिटके ना, आपरो पाय को बारू ला झड़ाय लेने जोन उनको विरोध मा, गवाही होयेत।<verse eid="LUK 9:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="LUK 9:6"/>अखीन वोना हिटके ना, गांव-गांव मा परमेस्वर को साजरो बारता, आयकावत होतिन। अखीन गजब लोग गिनला, हिन्ड-हिन्ड के, साजरो करन लगीन।<verse eid="LUK 9:6"/></para>
  <para style="s">हेरोदेस को उलझन</para>
  <para style="r">(<ref loc="MAT 14:1-12">मत्ती 14:1-12</ref>; <ref loc="MRK 6:14-29">मरकुस 6:14-29</ref>)</para>
  <para style="p">
    <verse number="7" style="v" sid="LUK 9:7"/>तबा चौथाई देस को राजा हेरोदेस, यो सबा ला आयक के, भेव खाय गयो। अखीन सांगन लग्यो, योहन मरयो हुयो जित्तो, भई से। <verse eid="LUK 9:7"/><verse number="8" style="v" sid="LUK 9:8"/>अना काही कव्हन लग्यो, का भविस्यवक्ता एलिय्याह, अखीन काही सांगत होतिन, का कोनी जुनो भविस्यवक्ता, <note caller="+" style="f"><char style="fr" closed="false">9:8 </char><char style="ft" closed="false">जूनो भविस्यवक्ता </char></note> जिव गईसे। <verse eid="LUK 9:8"/><verse number="9" style="v" sid="LUK 9:9"/>तबा हेरोदेस राजा ने कहीस, योहन जोनको मिना, डोस्का कपवायो डाखिसेव, यो कोन आय? जेनको बारे मा, असो गोस्टी आयकुसु, अना उ यीसु ला देखनो की मन कर लेइस।<verse eid="LUK 9:9"/></para>
  <para style="s">यीसु लक पाँच हजार मानूस ला जेवन करानो</para>
  <para style="r">(<ref loc="MAT 14:13-21">मत्ती 14:13-21</ref>; <ref loc="MRK 6:30-44">मरकुस 6:30-44</ref>; <ref loc="JHN 6:1-14">योहन 6:1-14</ref>)</para>
  <para style="p">
    <verse number="10" style="v" sid="LUK 9:10"/>मंग पेरीतगीन लवट के, जोन काही करयो होतो, उ यीसु ला सांगीन, अना उ उनला, आपरो संग, बैतसेदा नाव को नगर मा ले गईस। <verse eid="LUK 9:10"/><verse number="11" style="v" sid="LUK 9:11"/>यो जान के, भिड़ ओको माघा भई गई, अना उ खुसी लक ओको संग मा मिलयो। अखीन उन को लक, परमेस्वर को राज गोस्टी करन लगयो। अखीन जोन लोग गीन साजरो होवनो चाव्हत होतिन, उनला साजरो करीस।<verse eid="LUK 9:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="LUK 9:12"/>जबा दिवस बुड़ता बेरा भयो, तबा 12 पेरीतगीन ना, आयके वोको लक कहिन, भीड़ ला सार कर दे, वय चारो कन का गांव, अना बस्ती मा जाय के, रव्हन को इन्तेजाम करयेत, काहे की हमि, एक सुनसान जघा मा, सेजन।<verse eid="LUK 9:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="LUK 9:13"/>ओना उनको लक कहीस, तुमी उनला जेवन ला देव,</para>
  <para style="p" vid="LUK 9:13">उनना कहिन, हमरो जवर पांच भाकर अना दूई मसरी, ला सोड़ अखीन कहि नहात। का तू कव्हसे, की हमि जायके, सबा लोकगीन लाय, जेवन आनबीन?<verse eid="LUK 9:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="LUK 9:14"/>वहान पाँच हजार मानूस होतिन। मघं उ आपरो चेला गीनला, कहीस, उन ला पचास-पचास की पंगत मा बसाय देव।<verse eid="LUK 9:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="LUK 9:15"/>उन ना असोच करीन, सबला बसाय देईन। <verse eid="LUK 9:15"/><verse number="16" style="v" sid="LUK 9:16"/>तबा वोना पांच भाकर अना दोई मसरी लेईस, अउर सरग को कन चोवके ना, धन्य वाद कहीस, अउर तोड़-तोड़ के चेला गीनला देईस, क वय लोग गीन ला परसे। <verse eid="LUK 9:16"/><verse number="17" style="v" sid="LUK 9:17"/>तबा सारा लोग खायकर खुसी भईन, अना चेला गीन ना, बचया हुयो टुकड़ा गीन ला, 12 डलीया मा उठाईन।<verse eid="LUK 9:17"/></para>
  <para style="s">पतरस को यीसु ला मसीह माननो</para>
  <para style="r">(<ref loc="MAT 16:13-20">मत्ती 16:13-20</ref>; <ref loc="MRK 8:27-30">मरकुस 8:27-30</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="LUK 9:18"/>जबा उ एकांत मा, पिराथना कर रहयो होतो। अखीन चेला वोको संग मा होतीन। ता वोना उनको लक पुसीस, लोकगीन मोला का कव्हसे?<verse eid="LUK 9:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="LUK 9:19"/>तबा चेलागिन जवाब देईन, योहन बप्तिस्मा देवन वालो, अना कोनी-कोनी, एलिय्याह अखीन गियान की सजरी-सजरी गोस्टी सांगन वालो, जुनो भविस्यवक्ता जिव गई से।<verse eid="LUK 9:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="LUK 9:20"/>वोना वोको लक पुसिस, अखीन तुमी मोला, का कसो?</para>
  <para style="p" vid="LUK 9:20">पतरस ना जवाब देईस, तू परमेस्वर का मसीह <note caller="+" style="f"><char style="fr" closed="false">9:20 </char><char style="ft" closed="false">परमेस्वर को अभिसिक्त</char></note>आस।<verse eid="LUK 9:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="LUK 9:21"/>यीसु ना अपरो चेलागिन ला, कड़ाई लक हुकूम देइस, का यो गोस्टी कोनी ला, नोको सांगने।<verse eid="LUK 9:21"/></para>
  <para style="s">आपरी मौत को बारे यीसु को सांगनो</para>
  <para style="r">(<ref loc="MAT 16:21-23">मत्ती 16:21-23</ref>; <ref loc="MRK 8:31-33">मरकुस 8:31-33</ref>)</para>
  <para style="p">
    <verse number="22" style="v" sid="LUK 9:22"/>यीसु ना सांग्यो मानूस को टूरा लाय लगत दुख उठानो जरूरी से, अखीन सियानो अना मुखिया याजक अना मोसे को नियम को गूरू लक उ नकारो जाय, अना उ तिसरो दिवस मरयो हुयो लक जित्तो होहेत।<verse eid="LUK 9:22"/></para>
  <para style="s">यीसु को मंघा चलन को मतलब</para>
  <para style="r">(<ref loc="MAT 16:24-28">मत्ती 16:24-28</ref>; <ref loc="MRK 8:34-9:1">मरकुस 8:34—9:1</ref>)</para>
  <para style="p">
    <verse number="23" style="v" sid="LUK 9:23"/>तबा यीसु ना सबा लक कव्हयो, जो मोरो मघ आवन चाव्हासे, आपरो आप ला नकारे, रोज कूरूस उठायके<note caller="+" style="f"><char style="fr" closed="false">9:23 </char><char style="ft" closed="false">दुख उचल के मोरो मघा चलो </char></note> मोरो मघा आहेत। <verse eid="LUK 9:23"/><verse number="24" style="v" sid="LUK 9:24"/>काहे का, जोन आपरो जान बचावनो चाव्हासे, उ वोला खो देहेत, अना जोन मोरो कारन आपरो जान खो देहेत<note caller="+" style="f"><char style="fr" closed="false">9:24</char><char style="ft" closed="false">जो मोरो लाय आपरो परान दे</char></note>, वोच वोला पाहेत। <verse eid="LUK 9:24"/><verse number="25" style="v" sid="LUK 9:25"/>वोना मानूस ला, का फायदा? जोन खुदला नास कर दे, अखीन जगत को धन पाय जाय। <verse eid="LUK 9:25"/><verse number="26" style="v" sid="LUK 9:26"/>जोन मोला अखीन, मोरो कव्हनो ला मानन लाय, लाज करयेत, मानूस को टूरा आपरो तेज को संग आहेत तो वोला सबको पुआ नकार देहत, अखीन जोन सबको पुढा वोला मान लेहेत, वो वोला परमेस्वर अखीन पवीतर सरगदूत, को पुढा मान लेहेत। <verse eid="LUK 9:26"/><verse number="27" style="v" sid="LUK 9:27"/>मि तुम्ही लोक गीन ला, खरोखर सांगासू, यहान काही लोकगीन सेत, जबा लक परमेस्वर को राज ला नही चोव लेत, वो नही मरहेत।<verse eid="LUK 9:27"/></para>
  <para style="s">यीसु को रुप बदलनो</para>
  <para style="r">(<ref loc="MAT 17:1-8">मत्ती 17:1-8</ref>; <ref loc="MRK 9:2-8">मरकुस 9:2-8</ref>)</para>
  <para style="p">
    <verse number="28" style="v" sid="LUK 9:28"/>यो गोस्टी को हपता भर बाद मा, यीसु पतरस योहन अना याकूब ला, आपरो सगंमा, पहाड़ मा ले गयो। अना वहान परमेस्वर लक पिराथना करन लगीन। <verse eid="LUK 9:28"/><verse number="29" style="v" sid="LUK 9:29"/>पिराथना करत-करत, यीसु को टोंड चमकन लग्यो, कपरा उजरो भय गयो। <verse eid="LUK 9:29"/><verse number="30" style="v" sid="LUK 9:30"/>एकदम चेला गीनला, यीसु को संग, दुई मानूस गोस्टी करत चोवयो, वोना मोसे, अखीन एलिय्याह भविस्यवक्ता होत्यो। <verse eid="LUK 9:30"/><verse number="31" style="v" sid="LUK 9:31"/>वय दुई मा लगत तेज होत्यो, उ काही येरुसलेम मा होवन वारा, घटना को बारेमा, सांगत होत्यो। <verse eid="LUK 9:31"/><verse number="32" style="v" sid="LUK 9:32"/>पतरस अखीन वोको सगीं जपमा होतिन, मंग वय जप लक जाग गयो होतिन। ता वोना यीसु अखीन वय दुई ला तेज समेत चोईन। <verse eid="LUK 9:32"/><verse number="33" style="v" sid="LUK 9:33"/>वय दुई, यीसु को जवर लक, बिदा हो रहयो होतो। तबा पतरस, यीसु ला कव्हयो, मालीक, कितरो साजरो होतो, का हमि तिन मान्डो गाड़बोन, एक तोरो, एक मोसे, अखीन एक एलिय्याह काजी, वोला पता नही होत्यो। क उ काजक, सांग रहि सेस?<verse eid="LUK 9:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="LUK 9:34"/>उ सांग रहयो होतो, का एक बादल न आयके, वोना पर छाय गयो, अना वय डराय गइन। <verse eid="LUK 9:34"/><verse number="35" style="v" sid="LUK 9:35"/>बादल लक यो आवाज आयो, यो मोरो चहेतो टूरा आय अना मोरो निवाड़ो हुया से, एको आयको।<verse eid="LUK 9:35"/></para>
  <para style="p">
    <verse number="36" style="v" sid="LUK 9:36"/>आवाज आवन को मघा, यीसु एकलो चोवयो, चेलागिन यो बारे मा काही, नही सांगिन।<verse eid="LUK 9:36"/></para>
  <para style="s">बुरो आतमा वालो टूरा ला साजरो करनो</para>
  <para style="r">(<ref loc="MAT 17:14-18">मत्ती 17:14-18</ref>; <ref loc="MRK 9:14-27">मरकुस 9:14-27</ref>)</para>
  <para style="p">
    <verse number="37" style="v" sid="LUK 9:37"/>दुसरो दिवस जबा, वय पहाड़ लक उतरीन, तबा गजब लोकगीन मिलन ला आइन। <verse eid="LUK 9:37"/><verse number="38" style="v" sid="LUK 9:38"/>अना भिड़ मा लक, एक मानूस ना चिल्लाय के कव्हयो, हे गुरू मी तोरो लक बिनती करासू, का मोरो एकच टूरा से, वोको पर किरपा कर। <verse eid="LUK 9:38"/><verse number="39" style="v" sid="LUK 9:39"/>वोला एक भूत धरसे, अना उ एकदम बेमियासे, आँग ऐठासे, टोन्ड मा फेसकुड़ आवासे, अखीन वो भूत वोलो कठनाई लक छोड़ासे। <verse eid="LUK 9:39"/><verse number="40" style="v" sid="LUK 9:40"/>मि ना तोरो चेला गीन, लक बिनती करीसेव, का वोला हेड़ देव, पर कोनी नही हेड सकिन।<verse eid="LUK 9:40"/></para>
  <para style="p">
    <verse number="41" style="v" sid="LUK 9:41"/>तबा यीसु ना जवाब दियो, ओ अबिस्वासी अना केड मानूस, मि कबा तकन तुमरो संग मा रहु? वोला यहान आनो।<verse eid="LUK 9:41"/></para>
  <para style="p">
    <verse number="42" style="v" sid="LUK 9:42"/>जसो टूरा समोर मा आयो, बुरो आतमा वोला धर के ना मरोड़ दियो, पर यीसु ना वोला डटकार के वोला परान को हुकूम दियो, उ टूरा साजरो भय गयो, अखीन वोला वोको बाबूजी ला सोप देइस।<verse eid="LUK 9:42"/></para>
  <para style="s">आपरी मौत को बारे मा यीसु मंग सांगासे</para>
  <para style="r">(<ref loc="MAT 17:22">मत्ती 17:22</ref>,<ref loc="MAT 17:23">23</ref>; <ref loc="MRK 9:30-32">मरकुस 9:30-32</ref>)</para>
  <para style="p">
    <verse number="43" style="v" sid="LUK 9:43"/>सबा लोग गीन परमेस्वर कन लक यीसु को काम चोवके ना, चकित भई गईन। तब यीसु ना आपरो चेला गीन ला कह्यो <verse eid="LUK 9:43"/><verse number="44" style="v" sid="LUK 9:44"/>तुम कान धरके ना मोरो गोस्टी ला आयको, मानूस को टूरा मानूसगिन लक धराय जान वारा सेत। <verse eid="LUK 9:44"/><verse number="45" style="v" sid="LUK 9:45"/>पर यो गोस्टी उनला, समज मा नही आयो, काहेका परमेस्वर ना, उनको समजन को बुध्धि ला, हर लियो होतो। उनला यो बारे मा, बिनती करनलाय लाय भेव लगत होतयो।<verse eid="LUK 9:45"/></para>
  <para style="s">सब लक मोठो कोन?</para>
  <para style="r">(<ref loc="MAT 18:1-5">मत्ती 18:1-5</ref>; <ref loc="MRK 9:33-37">मरकुस 9:33-37</ref>)</para>
  <para style="p">
    <verse number="46" style="v" sid="LUK 9:46"/>चेलागिन, आपसी मा कव्हन लगीन। आमी मा कोन मोठो सेत? <verse eid="LUK 9:46"/><verse number="47" style="v" sid="LUK 9:47"/>यीसु ना उनको दिल को गोस्टी जान, एक लेकरा ला उभो करके, <verse eid="LUK 9:47"/><verse number="48" style="v" sid="LUK 9:48"/>अना उन लक कव्हयो, जोन मोरो नाव लक, असो लेकरा ला आपरो समजा से, उ मोला आपरो समजा से, अना जोन कोनी मोला आपरो समजा से, परमेस्वर वोला आपरो समजा से, काहेका तुम्ही लक, जोन कोनी नान्हो सेत, वोच सबा मा मोठयो सेत।<verse eid="LUK 9:48"/></para>
  <para style="s">जोन विरोध नही करा उ पक्स मा से</para>
  <para style="r">(<ref loc="MRK 9:38-40">मरकुस 9:38-40</ref>)</para>
  <para style="p">
    <verse number="49" style="v" sid="LUK 9:49"/>योहन यीसु को जवर आयके ना, कव्हन लग्यो, गुरूजी एक मानूस से, जो तोरो नाव लक बुरो आतमा हेड़ासे, पर उ हमरो संगी नहाय।<verse eid="LUK 9:49"/></para>
  <para style="p">
    <verse number="50" style="v" sid="LUK 9:50"/>तबा यीसु ना कहीस, वोला मना नोको करो। जोन आमरो विरोध मा नहात उ आमरो कना से।<verse eid="LUK 9:50"/></para>
  <para style="s">सामरिया छेतर मा विरोध</para>
  <para style="p">
    <verse number="51" style="v" sid="LUK 9:51"/>यीसु येरुसलेम नगर जावन लाय, आपरो मन मा ठान लियो, काहेका वोको वरता उचलन को, बेरा जवर, आय गयो होतो। <verse eid="LUK 9:51"/><verse number="52" style="v" sid="LUK 9:52"/>यीसु ना आपरो पुढा सन्देसा देवन वालो ला धाडीस, समरिस्थान मा, सामरी लोक को लोकगीन रव्हत होतिन। <verse eid="LUK 9:52"/><verse number="53" style="v" sid="LUK 9:53"/>पर उन लोकगीन ना वोला नही रोखिन, काहे की वय येरुसलेम जावत होतिन। <verse eid="LUK 9:53"/><verse number="54" style="v" sid="LUK 9:54"/>यो चोव के वोको चेला याकूब अखीन योहन कव्हासेत, हे पिरभू तु हुकूम दे, हमि बादल लक स्तो पड़ाये के ना, गाँव ला भस्म कर डाकबो?<verse eid="LUK 9:54"/></para>
  <para style="p">
    <verse number="55" style="v" sid="LUK 9:55"/>पर यीसु ना उनला डटकार देइस अना कहीस, तुमला मालुम सेत तुमी कोनतो आतमा को सेव? काहेका मानूस को टूरा लोकगीन ला मारन नही पर बचान आइसेत।<verse eid="LUK 9:55"/></para>
  <para style="s">यीसु को चेला बनन को किमत</para>
  <para style="r">(<ref loc="MAT 8:19-22">मत्ती 8:19-22</ref>)</para>
  <para style="p">
    <verse number="56" style="v" sid="LUK 9:56"/>अखीन उ दुसरो गाँव मा चले गईन।<verse eid="LUK 9:56"/></para>
  <para style="p">
    <verse number="57" style="v" sid="LUK 9:57"/>रस्ता मा जावत-जावत, कोनी ना वोला सांगिस, तुम्ही जँहा-जँहा जावासो, मि संग-संग आवासू।<verse eid="LUK 9:57"/></para>
  <para style="p">
    <verse number="58" style="v" sid="LUK 9:58"/>तबा यीसु ना वोला कव्हयो, कोल्हिया को, रव्हन को ठिकनो से, बादर को पक्सी चिड़िया-चुनगुन काजी गोदा से, पर मानूस को टूरा ला डोस्का लुकान को जघा नहती। <figure style="fig" alt="Fox with kits in a hole" file="BK00051C.TIF" size="col" copy="Horace Knowles ©" ref="9:58">पहाड़ी को खोदरा मा लेकरागिन को संग कोल्हिया</figure><verse eid="LUK 9:58"/></para>
  <para style="p">
    <verse number="59" style="v" sid="LUK 9:59"/>वोना दुसरो ला कहीस, मोरो मंघा आय, पर वोना जवाब दियो, हे पिरभू मोला पयले मोरो बाबूजी ला गाड़ के ना आवन दे,<verse eid="LUK 9:59"/></para>
  <para style="p">
    <verse number="60" style="v" sid="LUK 9:60"/>यीसु ना कव्हयो, मुरदा ला मुरदा गाड़न दे। पर तुम्ही जायके ना, परमेस्वर को राज को गोस्टी, सबला सांगो।<verse eid="LUK 9:60"/></para>
  <para style="p">
    <verse number="61" style="v" sid="LUK 9:61"/>दुसरो ना कव्हयो, हे पिरभू मि आपरो घर लक बिदाई लेके आवासेऊ, तबा मी तोरो मंघा आँहू<verse eid="LUK 9:61"/></para>
  <para style="p">
    <verse number="62" style="v" sid="LUK 9:62"/>यीसु ना कव्हयो, जो नांगर को मुठ मा हात धरके ना, मंघा चोवासे वो परमेस्वर को राज मा काबिल नहात।<verse eid="LUK 9:62"/></para>
  <chapter eid="LUK 9"/>
  <chapter number="10" style="c" sid="LUK 10"/>
  <para style="s">सत्तर चेलागिन ला धाड़नो</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 10:1"/>यो सबको मंघा पिरभू अखीन बहात्तर चेला गीनला निवाड़ के जोन-जोन गाँव-नगर मा जावनवालो होत्यो, उता दुई-दुई करके आपरो पूढा धाड़िस। <verse eid="LUK 10:1"/><verse number="2" style="v" sid="LUK 10:2"/>यीसु ना उनला कहीस, पिक्को फसल गजब सेत, पर बनीहार जरासो सेत। यो काजी खेत को मालीक लक बिनती करो, का फसल कापन लाय, बनीहार धाड़हे। <verse eid="LUK 10:2"/><verse number="3" style="v" sid="LUK 10:3"/>जावो मि तुम्ही ला बिघा गीन को बीच मा, मेढा-सेरी को बच्चा जसो धाड़ासू। <verse eid="LUK 10:3"/><verse number="4" style="v" sid="LUK 10:4"/>तुम्ही झोला पियुसी, सेंडिल, कपरा काही नोको आनने अखीन रास्ता मा कोनी लक, नमस्कार नोको करने। <verse eid="LUK 10:4"/><verse number="5" style="v" sid="LUK 10:5"/>जबा कोनी घरमा भितर जावो, तबा सबा लक पूढा असो सांगने, का “यो घर को कल्यान होय।” <verse eid="LUK 10:5"/><verse number="6" style="v" sid="LUK 10:6"/>अदी कोनी कल्यान को काबिल सेत, तो वा घर मा, कल्यान रुक जाहेत, नही तो उ, तुमरो कठा लवट आहेत। <verse eid="LUK 10:6"/><verse number="7" style="v" sid="LUK 10:7"/>वोच घर मा रव्हने, अखीन उनको कठा जो सेत, वोच जेवन करने, घर-घर नोको फिरने। काहेका बनीहार ला वोको बन्नी मिलन को<note caller="+" style="f"><char style="fr" closed="false">10:7</char><char style="ft" closed="false">बनीहार ला बनी मिलनो पाहिजे। </char></note>, हक सेत। <verse eid="LUK 10:7"/><verse number="8" style="v" sid="LUK 10:8"/>कोनी गावँ-नगर मा तुम्ही जावासो, आदर को सगं जोन परसा से, जेवन करने। <verse eid="LUK 10:8"/><verse number="9" style="v" sid="LUK 10:9"/>उता को बिमार गिनला साजरो करने, अखीन उनला सांगने, “परमेस्वर को राज तुमरो कना सेत।” <verse eid="LUK 10:9"/><verse number="10" style="v" sid="LUK 10:10"/>पर जोन गाँव-नगर मा जावासो, अखीन वहान को लोग गीन, तुमारो आदर नही करासेत, तो बजार-हाट मा जायके कव्हने, <verse eid="LUK 10:10"/><verse number="11" style="v" sid="LUK 10:11"/>आमरो पाय मा धुल सेत, आमी झाड़ देसेजन। पर तुम्ही जान लेव, का परमेस्वर को राज, तुमरो कठा आईसे। <verse eid="LUK 10:11"/><verse number="12" style="v" sid="LUK 10:12"/>मि तुम्ही ला सांगासु, वो दिवस लक सदोम-अमोरा नगर जसो, उ नगर मा सत्यानास<note caller="+" style="f"><char style="fr" closed="false">10:12</char><char style="ft" closed="false">मन नहि मुरकायो गयो से ता नास भई जाहेत। </char></note> आय जाहेत।<verse eid="LUK 10:12"/></para>
  <para style="s">बिस्वास नही करनवालो सहेर ला धिक्कार</para>
  <para style="r">(<ref loc="MAT 11:20-24">मत्ती 11:20-24</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="LUK 10:13"/>यीसु कव्हयो, “खुराजिन अखीन बैतसेदा नगर ला, धिक्कार से, जोन अचंभा को काम परमेस्वर को ताकत लक, यो नगर मा भयोसे, सूर अखीन सिदोन नगर मा होतो, तो वय लोकगीन पस्तावा कर, मन बदल के, परमेस्वर को कठा, आय गईन होतिन। <verse eid="LUK 10:13"/><verse number="14" style="v" sid="LUK 10:14"/>यो काजी, न्याय को बेरामा, सूर अना सैदा नगर को दसा, जादा खराब होहेत। <verse eid="LUK 10:14"/><verse number="15" style="v" sid="LUK 10:15"/>अना हे कफरनहुम नगर, तू का सरग लक वरता कियो जावजोस? नही, तू खाल्या नरक लक गिराय दियो जाहेत।”<verse eid="LUK 10:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="LUK 10:16"/>जोन तुम्हारो आयक सेत, उ मोरि आयकासे, जोन तुम्हारो बेइज्जती करासे, उ मोरो बेइज्जती करासे, अखीन परमेस्वर<note caller="+" style="f"><char style="fr" closed="false">10:16</char><char style="ft" closed="false">परमेस्वर मोला जोन ना मोला धड़यो से</char></note> को भी बेइज्जती करासे।<verse eid="LUK 10:16"/></para>
  <para style="s">सत्तर चेलाहुन को लवटनो</para>
  <para style="p">
    <verse number="17" style="v" sid="LUK 10:17"/>सत्तर चेला गीन खुसी लक, लवट के आयके कव्हन लगीन, हे पिरभू, तोरो नाव लक बुरो आतमा भी आमरो कब्जा मा सेत।<verse eid="LUK 10:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="LUK 10:18"/>यीसु ना जवाब दियो, मी ना सैतान ला, बिजली को घाई सरग लक पड़तो, चोविसेव। <verse eid="LUK 10:18"/><verse number="19" style="v" sid="LUK 10:19"/>मि ना सरप, मेहदल, अखीन बयरी को सारो ताकत ला, कुचलन को हक<note caller="+" style="f"><char style="fr" closed="false">10:19</char><char style="ft" closed="false">बैरी की सक्ति मा तुम्हरो हक से</char></note> देवासू, अखी काही भी तुम्हिला, हानी नही करयेत। <verse eid="LUK 10:19"/><verse number="20" style="v" sid="LUK 10:20"/>तरि यो काजी खुस नोको होवने, का बुरो आतमा तुमरो बस मा सेत पर एकोलक खुस होवो का तुमरो नाव सरग मा लिख्यो सेत।<verse eid="LUK 10:20"/></para>
  <para style="s">यीसु खुसी ले भर गयो</para>
  <para style="r">(<ref loc="MAT 11:25-27">मत्ती 11:25-27</ref>; <ref loc="MAT 13:16">13:16</ref>,<ref loc="MAT 13:17">17</ref>)</para>
  <para style="p">
    <verse number="21" style="v" sid="LUK 10:21"/>वोच बेरा उ पवीतर आतमा लक खुसी मा भर गयो अना कव्हसेत, “हे बाबूजी, सरग अना धरती को मालीक, मि तोरो धनवाद करासू, का तूना यो गोस्टी ला, मोसे को नियम को गुरू अखीन समजदार लक लुकाके राखिसेस। अखीन नहानो लेकरा गीन पर, उजागर करीसेस। हाँ हे बाबूजी तोला, असोच साजरो लगिसेस।”<verse eid="LUK 10:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="LUK 10:22"/>मोरो बाबूजी न मोला सबा कछु सोप देईसेस। अना कोनी नही जानासे, का टूरा कोन आय? केवल बाबूजी, अना बाबूजी, कोन सेत, कोनी नही जानासे, केवल टूरा? अखीन जोन पर टूरा उजागर<note caller="+" style="f"><char style="fr" closed="false">10:22</char><char style="ft" closed="false">बेटा जोन पर उजागर करनो चाहेत वोच जानेत। </char></note> करनो चाव्हासे, वोको पर उजागर करासे।<verse eid="LUK 10:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="LUK 10:23"/>तबा चेला गीन कन, मुरकके ना एकलो मा कव्हयो, “धन्य सेत तुमरो डोरा, जोन यो गोस्टी चोवासे। <verse eid="LUK 10:23"/><verse number="24" style="v" sid="LUK 10:24"/>काहे का, मि तुम्ही लक कव्हसू, का गजब राजा भविस्यवक्ता, यो चोवनो चाहत होत्यो। पर उ नही चोव सकिन, आयकन चाव्हत होतिन, पर उ नहि आयकिन।”<verse eid="LUK 10:24"/></para>
  <para style="s">साजरो सामरी को उदाहरन</para>
  <para style="p">
    <verse number="25" style="v" sid="LUK 10:25"/>एक मोसे को नियम को गुरू, यीसु को परिक्सा लेवन काजी आयो। अना पुसिस, हे गुरूजी, अमर जीवन को अधिकारी होवन लाय, मी काजक करु?<verse eid="LUK 10:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="LUK 10:26"/>यीसु ना कव्हयो, मोसे को नियम मा का लिखी सेस? अता तुमी का बाचासो?<verse eid="LUK 10:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="LUK 10:27"/>वोना जवाब दियो, तू आपरो पिरभू परमेस्वर लक आपरो सारो मन अना आपरो सारो परान अना आपरो सारो ताकत अना आपरो सारो अक्ल को संग पिरेम<note caller="+" style="f"><char style="fr" closed="false">10:27</char><char style="ft" closed="false">पूरी तौर लक परमेस्वर ला जान</char></note> करो। अखीन आपरो सेजारी, लक आपरो जसो माया राखो।<verse eid="LUK 10:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="LUK 10:28"/>यीसु ना वोला ला सांगीस, तु ना खरो सांगीसेस योच कर, तो तू जित्तो रव्हजोस।<verse eid="LUK 10:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="LUK 10:29"/>एको पर एक गुरू ना आपरो आप ला, जादा खरो दिसान काजी यीसु ला सवाल करीस, लेकिन मोरो सेजारी कोन आय?<verse eid="LUK 10:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="LUK 10:30"/>यीसु वोला एक उदाहरन सांगन लग्यो। एक मानूस येरुसलेम लक, येरीयो नगर जावत होत्यो। वोला डाकू गीन घेर लेइन, वोला मारपीट के लुट लेइन अखीन अधमरो करके सोड़ देइन। <verse eid="LUK 10:30"/><verse number="31" style="v" sid="LUK 10:31"/>एकाएक एक याजक वहान लक, पार भयो। वोला चोवके ना उतरा के चलीगयो। <verse eid="LUK 10:31"/><verse number="32" style="v" sid="LUK 10:32"/>असोच एक लेवी आयो उ भी चोवके, कतरा के चले गयो। <verse eid="LUK 10:32"/><verse number="33" style="v" sid="LUK 10:33"/>अबा एक सामरी लोक को आदमी वोला चोवके ना, दया<note caller="+" style="f"><char style="fr" closed="false">10:33</char><char style="ft" closed="false">तरस करया </char></note> लक भर गयो। <verse eid="LUK 10:33"/><verse number="34" style="v" sid="LUK 10:34"/>उ वोको कना गयो अखीन, अंगूर को रस डालके ना, मरहम पट्टी करीस, अना आपरो सवारी मा बसाय के, बइद को जवर लेगइस। ताकि ओको सेवा<note caller="+" style="f"><char style="fr" closed="false">10:34</char><char style="ft" closed="false">देख-रेख </char></note> कियो जाहे। <verse eid="LUK 10:34"/><verse number="35" style="v" sid="LUK 10:35"/>बइद ला दोन सौ दीनार देके कहीस, का अखीन लगहे तो मी आनके दे देहू अखीन रोगी को सेवा करजोस।<verse eid="LUK 10:35"/></para>
  <para style="p">
    <verse number="36" style="v" sid="LUK 10:36"/>यीसु ना गुरू ला पुसयो उन तीनो लक, कोन उ मानूस को सेजारी पड़ोसी कहलावासे। <verse eid="LUK 10:36"/><verse number="37" style="v" sid="LUK 10:37"/>वोना जवाब देइस का, जोन ना वोको काम आइसे, यीसु कव्हयो जाओ तुमी असोच किरपा करो।<verse eid="LUK 10:37"/></para>
  <para style="s">मरियम अना मारथा को घर मा यीसु</para>
  <para style="p">
    <verse number="38" style="v" sid="LUK 10:38"/>यीसु चेलागीन को संग एक गाँव मा गईन अखीन, वोना गाव मा मरियम अखीन, मारथा नाव को दूई बहिन रव्हत होतीन उनको घर यीसु अखीन वोको चेलागीन, पहूनाई मा गईन। <verse eid="LUK 10:38"/><verse number="39" style="v" sid="LUK 10:39"/>मरियम नाव ओकी एक बहिन होती, सबा काम धाम छोड़ केना यीसु को कठा, बस के पिरभू को गोस्टी ध्यान लक, आयकत<note caller="+" style="f"><char style="fr" closed="false">10:39 </char><char style="ft" closed="false">पिरभू की गोस्टी ला ध्यान लक आयकनो </char></note> होती। <verse eid="LUK 10:39"/><verse number="40" style="v" sid="LUK 10:40"/>अखीन मारथा काम करत-करत हिजड़ गई अखीन कहीस, पिरभू तोला मोरो चिन्ता नही सेती की मोरी बहिन ना मोला सेवा को काम करन को लाई एकलोच छोड़ देईसेस? एको लाई ओला हुकूम दे का मोरी हात बटाये।<verse eid="LUK 10:40"/></para>
  <para style="p">
    <verse number="41" style="v" sid="LUK 10:41"/>तबा पिरभू ना सागींस मारथा, तू गजब चिंता करासेस। <verse eid="LUK 10:41"/><verse number="42" style="v" sid="LUK 10:42"/>मरियम ना मोरो कठा, बसके संसार को सबा लक<note caller="+" style="f"><char style="fr" closed="false">10:42 </char><char style="ft" closed="false">संसार को सब लक अच्छी चीज गोस्टी जोन मरियम ला भेटयो </char></note>, साजरो हिस्सा निवाड़ो सेस, ऊ कभी नही सुड़ायो जाहेत।<verse eid="LUK 10:42"/></para>
  <chapter eid="LUK 10"/>
  <chapter number="11" style="c" sid="LUK 11"/>
  <para style="s">यीसु चेलागिन ला पिराथना सिकानो</para>
  <para style="r">(<ref loc="MAT 6:9-13">मत्ती 6:9-13</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 11:1"/>यीसु कोनी जघा मा, पिराथना करत होतो। जबा पिराथना पूरो भयो, तो वोको चेला गीन मा, एक ना कव्हयो, पिरभू योहन गुरूजि ना, आपरो चेला गिनला, जसो पिराथना सिकाइसेस, वसोच अमीला पिराथना करनो सिकाव।<verse eid="LUK 11:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="LUK 11:2"/>वोना कव्हयो जबा तु पिराथना करने, तो असो कव्हने, हे, आमरो बाबूजी</para>
  <para style="q1" vid="LUK 11:2">तोरो नाव पवीतर मानो जाहेत, तोरो राज आहेत।<verse eid="LUK 11:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="LUK 11:3"/>अमरो दिवस भर को जेवन, अमीला देव।<verse eid="LUK 11:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="LUK 11:4"/>हमिना जसो हरेक बुराई करनवालो ला,</para>
  <para style="q2" vid="LUK 11:4">छिमा करीसेजन वसोच,</para>
  <para style="q2" vid="LUK 11:4">आमरो बुराई ला छिमा कर,</para>
  <para style="q2" vid="LUK 11:4">अखीन हमीला परिक्सा मा नोको डाख।<verse eid="LUK 11:4"/></para>
  <para style="s">पिराथना को बारेमा यीसु को सिक्सा</para>
  <para style="r">(<ref loc="MAT 7:7-11">मत्ती 7:7-11</ref>)</para>
  <para style="p">
    <verse number="5" style="v" sid="LUK 11:5"/>तबा यीसु ना, उन लक कव्हयो, तुम्ही मा लक कोन सेत। वोको एक संगी अरधो रात मा, जायके वोला कहे, मोला तीन भाकर देव<note caller="+" style="f"><char style="fr" closed="false">11:5</char><char style="ft" closed="false">भाकर उधार लेवना</char></note>, <verse eid="LUK 11:5"/><verse number="6" style="v" sid="LUK 11:6"/>मोरो घर मा संगी आइसे। वोला जेवन परसन लाय, काही नाहत। <verse eid="LUK 11:6"/><verse number="7" style="v" sid="LUK 11:7"/>उ भीतर लक कव्हन लग्यो, मोला दुख नोको देव, किवाड़ बंद से, अखीन लेकरा-बारा झोपीसेस। यो काजी बिछोना लक जाग के ना, काही नही दे सकसू। <verse eid="LUK 11:7"/><verse number="8" style="v" sid="LUK 11:8"/>मी तुम्हिला सागंसू, का उ टोन्ड फोड के मांगीसेस, यो काजी जेतरो जरुरत से, वोको संगी वोला जरुर देहेत। <verse eid="LUK 11:8"/><verse number="9" style="v" sid="LUK 11:9"/>अखीन मी सांगसू, क मांगजोस तबा दियो जाहेत, ढुढने, पावने, किवाड़ खटखटाने, तो उघाडो, जाहेत। <verse eid="LUK 11:9"/><verse number="10" style="v" sid="LUK 11:10"/>काहेका जो कोनी मांगा से, वोला भेटासे। अखीन जो ढुढासे, उ पावासे, अखीन जोन खटखटासे वोको काजी किवाड़ उघाड़ासे। <verse eid="LUK 11:10"/><verse number="11" style="v" sid="LUK 11:11"/>तुम्ही मा कोनतो आसो बाबूजी से, जबा टूरा भाकर मांगहे, त वोला गोटा दे देहे, मसरी मांगहे, त सरप दे देहेत। <verse eid="LUK 11:11"/><verse number="12" style="v" sid="LUK 11:12"/>ना डिम, मांगेत तो मेहदल देहेत। <verse eid="LUK 11:12"/><verse number="13" style="v" sid="LUK 11:13"/>अता जबा तुम्ही बुरो होयके, आपरो लेकरा बारो-ला, साजरो चीज देवनो जानासो, तो सरग को बाबूजी, परमेस्वर आपरो मांगन वालो ला, पवीतर आतमा काहे नही देहेत।<verse eid="LUK 11:13"/></para>
  <para style="s">यीसु अना सैतान को बालजबुल</para>
  <para style="r">(<ref loc="MAT 12:22-30">मत्ती 12:22-30</ref>; <ref loc="MRK 3:20-27">मरकुस 3:20-27</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="LUK 11:14"/>मंग वोना, एक गुंगो बुरो आतमा ला कहाड़िस। जबा उ बुरो आतमा हिट गयो तो, गुंगो हाका देवन लगयो, अखीन लोकगीन चकित भई गईन। <verse eid="LUK 11:14"/><verse number="15" style="v" sid="LUK 11:15"/>पर काही लोग गीन कव्हन लगीन, का, यो बुरो आतमा को मुखिया, बालजबुल को सहायता लक बुरो आतमा ला हेड़ासे।<verse eid="LUK 11:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="LUK 11:16"/>काही लोग गीन वोको परिक्सा लेवन काजी, बादल लक निसान<note caller="+" style="f"><char style="fr" closed="false">11:16 </char><char style="ft" closed="false">बादल का चिन्ह</char></note> मांगन लगीन। <verse eid="LUK 11:16"/><verse number="17" style="v" sid="LUK 11:17"/>उनको मन को बात जानके ना, यीसु कव्हन लगयो, जोन राज मा फुट पड़ जासे, उ सत्यानास हो जासे, अना जोन घरमा फुट पड़ जासे उ नास होवजासे। <verse eid="LUK 11:17"/><verse number="18" style="v" sid="LUK 11:18"/>अदी बालजबुल आपरो विरोध करयेत, तो वोको राज कसो बनो रहेत? काहेका, तुम्ही कव्हसो का, मि सैतान<note caller="+" style="f"><char style="fr" closed="false">11:18</char><char style="ft" closed="false">बालजबूल</char></note> को सहयाता लक बुरो आतमा हेड़ासु। <verse eid="LUK 11:18"/><verse number="19" style="v" sid="LUK 11:19"/>अदी मि बालजबुल की सहायता लक बुरो आतमा ला हेड़ासेत तबा तूमी तय करो, तुमरो औलाद कोनी को साहयता लक हेड़ासेत? एकोलाय वोच तुमरो न्याय करयेत। <verse eid="LUK 11:19"/><verse number="20" style="v" sid="LUK 11:20"/>पर अदी मि परमेस्वर को ताकत<note caller="+" style="f"><char style="fr" closed="false">11:20</char><char style="ft" closed="false">परमेस्वर की सक्ती</char></note> लक बुरो आतमा हेडासु, तो परमेस्वर को राज तुम्हारो कठा आईसेस।<verse eid="LUK 11:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="LUK 11:21"/>जबा कोनी ताकतवर मानूस, हतियार बान्ध लेवासे अना आपरो घर को चौकीदारी आँगन मा कर रहयो से, तो धन को सुरक्सा को चिन्ता नही रव्हासे। <verse eid="LUK 11:21"/><verse number="22" style="v" sid="LUK 11:22"/>पर कोनी मोठयो पहलवान चढ़ाई करके, वोको हतियार जोनमा वोला भरोसा होतो वोला हिसकसे, अखीन वोको सम्पती लुटा से, अखीन बाट देवासे।<verse eid="LUK 11:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="LUK 11:23"/>जोन मोरो संग नहात, उ मोरो बिरोध मा सेत, अखीन जो मोरो संग नही सेत, उ बटोरनो सोड़ केना, छितरावा सेत।<verse eid="LUK 11:23"/></para>
  <para style="s">अधूरो चँगाई लक मुसीबत</para>
  <para style="r">(<ref loc="MAT 12:43-45">मत्ती 12:43-45</ref>)</para>
  <para style="p">
    <verse number="24" style="v" sid="LUK 11:24"/>जबा भूत पलीत, मानूस लक हीट जावासे, अखीन सूखो जमीन मा, चैन नही मिलासे। तो, उ जहान लक हिटयो से, वहान लक जावासे। <verse eid="LUK 11:24"/><verse number="25" style="v" sid="LUK 11:25"/>अखीन आके आपरो घरला, झाड़ो बोहरो, सजो पावासे। <verse eid="LUK 11:25"/><verse number="26" style="v" sid="LUK 11:26"/>ता उ जायकेना, अपरो लक सात बुरो आतमा ला, आपरो सगं ले आवासे, अखीन वय वो मा समाके बास करासेत। अखीन उ मानूस को हाल, मंघा पूढा लक बूरो भई जासे।<verse eid="LUK 11:26"/></para>
  <para style="s">साजरो कोन से?</para>
  <para style="p">
    <verse number="27" style="v" sid="LUK 11:27"/>जबा उ यो गोस्टी सांग रहयो होतो, तबा भीड़ मा लक, एक बाई ना जोर लक हाकलीस। धन्य से उ पोट, जेनको लक तू जनम लेइसेस। अखीन जोन माय को दूध पीवी सेस।<verse eid="LUK 11:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="LUK 11:28"/>यीसु ना कव्हयो, हाँ पर धन्य सेत उ, जोन परमेस्वर को गोस्टी आयक के, वोला मानसे।<verse eid="LUK 11:28"/></para>
  <para style="s">भविस्यवक्ता योना को निसान</para>
  <para style="r">(<ref loc="MAT 12:38-42">मत्ती 12:38-42</ref>)</para>
  <para style="p">
    <verse number="29" style="v" sid="LUK 11:29"/>जब गजब भीड़ हो लोक होत्यो तो, उ कव्हन लग्यो, यो जूग<note caller="+" style="f"><char style="fr" closed="false">11:29</char><char style="ft" closed="false">पीढ़ी</char></note> को लोक गीन खोटो सेत, उ हिदान ढुन्ड़ासे, पर योना भविस्यवक्ता को हिदान ला सोड़, अखीन कोनी हिदान, उनला नही दियो जाहेत। <verse eid="LUK 11:29"/><verse number="30" style="v" sid="LUK 11:30"/>जसो योना भविस्यवक्ता, निनवे माहानगर को लोग गिनको लाय, एक हिदान बन गयो होतो। वसोच मानूस को टूरा, यो पीढ़ी काजी हिदान<note caller="+" style="f"><char style="fr" closed="false">11:30</char><char style="ft" closed="false">यीसु इस पीढ़ी का चिन्ह</char></note> सेव। <verse eid="LUK 11:30"/><verse number="31" style="v" sid="LUK 11:31"/>न्याय को दिवस, दक्सिन देस को महारानी, यो पीढ़ी को लोग गीन संग मा, उभी होयती, अखीन इनला खोटो ठहराय देहेत। काहेका, उ राजा सुलेमान को अक्ल को, गोस्टी आयकन काजी, धरती को छोर<note caller="+" style="f"><char style="fr" closed="false">11:31</char><char style="ft" closed="false">दुहुर देस को निवास</char></note> लक आई होति। अखीन चोवो मि वोको लक महान सेव, <verse eid="LUK 11:31"/><verse number="32" style="v" sid="LUK 11:32"/>न्याय को दिवस, निनवे नगर को लोकगीन, यो पीढ़ी को लोकगीन संग उभो होहेत, अना इनला दोसी मानेत, काहेका उनना, योना भविस्यवक्ता को संदेसा आयकके ना पस्तावा करयो होतो, अखीन चोयो सेस, क मी योना लक भी मोठो सेव।<verse eid="LUK 11:32"/></para>
  <para style="s">आँग को दियो</para>
  <para style="r">(<ref loc="MAT 5:15">मत्ती 5:15</ref>; <ref loc="MAT 6:22">6:22</ref>,<ref loc="MAT 6:23">23</ref>)</para>
  <para style="p">
    <verse number="33" style="v" sid="LUK 11:33"/>दियो पेटाके कोनी वोला तहखाना मा, मंग डलीया उबड़ा के नही ठेवासे, पर फूल मा ठेवासे, जोन लक भीतर आन जान वालो<note caller="+" style="f"><char style="fr" closed="false">11:33</char><char style="ft" closed="false">जो घर मे अँदर मजे जाने वालो लोग</char></note> ला उजारो चोहे। <verse eid="LUK 11:33"/><verse number="34" style="v" sid="LUK 11:34"/>तुमरो, तन को, दियो तुमरो डोरा सेत, अदी तुमरो डोरा साजरो से, तर तुमरो सारो आँग मा उजाड़ो से, पर उ खराब भयि जाहेत, तर आँग भी इन्धार भई जाहेत। <verse eid="LUK 11:34"/><verse number="35" style="v" sid="LUK 11:35"/>एको लाय दोन गोस्टी ध्यान राखन को से, जोन यो उजाड़ो तुमरो मा से उ कहिं, इन्धार न होयेत जायेत। <verse eid="LUK 11:35"/><verse number="36" style="v" sid="LUK 11:36"/>अदी तुम्हारो सारो तन मा उजाड़ो सेत, अखीन वोको कोनी भी हिस्सा, इन्धारो मा नाहत, तो उ वसोच हमेसा लक चमकत रव्हासे जसो दियो आपरो उजाड़ो लक सबा ला चकाचक कर देसे।<verse eid="LUK 11:36"/></para>
  <para style="s">सास्तरी अना फरीसी पर हाय!</para>
  <para style="r">(<ref loc="MAT 23:1-36">मत्ती 23:1-36</ref>; <ref loc="MRK 12:38-40">मरकुस 12:38-40</ref>)</para>
  <para style="p">
    <verse number="37" style="v" sid="LUK 11:37"/>यीसु सागंत होतो, तबच एक मोसे को नियम को गुरू ना कव्हयो, गुरूजी हमरो संग जेवन कर, यीसु भीतर जायके न, जेवन करन बस गयो। <verse eid="LUK 11:37"/><verse number="38" style="v" sid="LUK 11:38"/>मोसे को नियम को गुरू यो चोवके, चकीत भय गयो, का यीसु बिना हात पाय धोवके, जेवन बस गयो। <verse eid="LUK 11:38"/><verse number="39" style="v" sid="LUK 11:39"/>पिरभू ना कव्हयो, हे मोसे को नियम को गुरू, तुम्ही विधि-विधान लक हात-पाय धोवके ना, गडू-गिलास भानी ला बहार लक माजा सो, पर तुम्हारो भीतर मा ला लक बुराई भरोसे। <verse eid="LUK 11:39"/><verse number="40" style="v" sid="LUK 11:40"/>अरे मुरख, जो बाहेर को हिस्सा बनइसेस, वोच भीतर भी बनाइसेस। <verse eid="LUK 11:40"/><verse number="41" style="v" sid="LUK 11:41"/>जोन भीतर सेत, वोला तुम्ही दान करदेव, अखीन चोवो सबच सुध्द भय जाहेत।<verse eid="LUK 11:41"/></para>
  <para style="p">
    <verse number="42" style="v" sid="LUK 11:42"/>हे मोसे को नियम को गुरू, तुम लक धिक्कार से, काहेका पोदीना, सोप, अखीन हरेक हिवरो साग को, दसवा पराय लेवासो, पर परमेस्वर को, माया अखीन न्याय को लक, तुम्ही लापरवाही करा सेव। तुम्हारो लायक यो साजरो होवतो, का तुम्ही वोला भी मानासेव, अखीन येला भी।<verse eid="LUK 11:42"/></para>
  <para style="p">
    <verse number="43" style="v" sid="LUK 11:43"/>मोसे को नियम को गुरू तुम्हारो पर धिक्कार सेत, तुम्ही सभाघर मा, हरेक समाजीक काम मा, ऊचो आसन चाव्हासो, अखीन बजार मा सबा परनाम करहेती, तुम्ही यो सबा माया राखासेव। <verse eid="LUK 11:43"/><verse number="44" style="v" sid="LUK 11:44"/>धिक्कार से तुम पर, काहेका, तुम्ही चुना पुतो सफा मरघट्टी सेव, जोन नही दिससे का, भितर मा का सेत, लोग तुमीला साजरो समज के, लोग तुमरो कव्हनो मा चलासे।<verse eid="LUK 11:44"/></para>
  <para style="p">
    <verse number="45" style="v" sid="LUK 11:45"/>एक मोसे को नियम को गुरू कव्हसे, हे गुरूजी, तुम्ही असो कव्हसो, आखिन आमरो बेइज्जती करासो।<verse eid="LUK 11:45"/></para>
  <para style="p">
    <verse number="46" style="v" sid="LUK 11:46"/>यीसु ना कव्हयो, हे मोसे को नियम को गुरू गीन तुमला धिक्कार सेत, तुम्ही मोठो-मोठो नियम को बोझा जनता पर लाद देसो, जो उ नही उचल सक से। अखीन वो भारी बोझा ला तुम्ही बोट भी नही, लगा सकासो। <verse eid="LUK 11:46"/><verse number="47" style="v" sid="LUK 11:47"/>तुम पर धिक्कर सेत, जुनो जमाना मा, मोठो-मोठो भविस्यवक्ता गीनला, तुमारो बाप-दादा गीन मार डाखिन अखीन तुम्ही उनको मठ बनासेव <verse eid="LUK 11:47"/><verse number="48" style="v" sid="LUK 11:48"/>असोमा तुम्ही गवाही सेव का तुम्हरो बाप दाद ना खोटो काम करी सेस मारके उनको मठ बनाइसेस <verse eid="LUK 11:48"/><verse number="49" style="v" sid="LUK 11:49"/>यो कारन परमेस्वर कव्हासे, मि उनको जवर चेलागीन ला धाड़ासू उन मा लक काही ला सताहेत अखीन काही भविस्यवक्ता ला मार डाखेत <verse eid="LUK 11:49"/><verse number="50" style="v" sid="LUK 11:50"/>जोन लक दुनिया बनान को बेरा ले अब तकन जितरो भविस्यवक्ता गीनको खून बोहाय गयो सेत वोको हिसाब योच पीढ़ी को लोकईन लक लियो जाहेत। <verse eid="LUK 11:50"/><verse number="51" style="v" sid="LUK 11:51"/>मि कव्हसू भविस्यवक्ता हाबिल पासुन जकरयाह वरीच जोनला भविस्यवानी को घर अना वेदी को भितर म खून कर दियेत।<verse eid="LUK 11:51"/></para>
  <para style="p">
    <verse number="52" style="v" sid="LUK 11:52"/>मोसे को नियम को गुरू तुम पर धिक्कार सेत, तुम्ही ना गियान को कुन्जी हिसकसेव, अना तुम्ही खुदच नही धसेव अखीन कोनी ला भी नही धसन देसो।<verse eid="LUK 11:52"/></para>
  <para style="p">
    <verse number="53" style="v" sid="LUK 11:53"/>यीसु वहान लक जावन लग्यो, त मोसे को नियम को गुरू गीन वोला फसावन काजी, सवाल-जवाब करन लगीन। <verse eid="LUK 11:53"/><verse number="54" style="v" sid="LUK 11:54"/>अखीन वोको विरोध मा वोला मार डाखन लाय डाव ढुढन लगीन।<verse eid="LUK 11:54"/></para>
  <chapter eid="LUK 11"/>
  <chapter number="12" style="c" sid="LUK 12"/>
  <para style="s">बगला भगतगिन को विरोध</para>
  <para style="r">(<ref loc="MAT 10:26-27">मत्ती 10:26-27</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 12:1"/>यीसु कोनी जघा मा पिराथना करत होतो। जबा पिराथना पूरो भई गयो हो तो। गरदी एतरो तकन बढ गई की लोकगीन एक दुजो पर पड़त होतीन। तबा यीसु चेला गीन लक कव्हन लग्यो। मोसे को नियम को गुरूगीन को कपट<note caller="+" style="f"><char style="fr" closed="false">12:1</char><char style="ft" closed="false">खमीर</char></note> लक सतरक रव्हने। <verse eid="LUK 12:1"/><verse number="2" style="v" sid="LUK 12:2"/>असो काही झाको नाहत जोन उघाडो न जाहेत अखीन अदी लुको नहात जोन जानो ना जाये। <verse eid="LUK 12:2"/><verse number="3" style="v" sid="LUK 12:3"/>एकोलाय जो काही तुम्हीना इन्धार मा सांग सेव उ उजयाला मा आयको जाहेत। अखीन जो काही तुम्हीला खोली मा सांगे सेव उ अटारी को वोरता लक सबला परचार करो।<verse eid="LUK 12:3"/></para>
  <para style="s">कोनी लक भेव खावनो?</para>
  <para style="r">(<ref loc="MAT 10:28-31">मत्ती 10:28-31</ref>)</para>
  <para style="p">
    <verse number="4" style="v" sid="LUK 12:4"/>ओ मोरो संगी हुन तुम्हीला सांगसू जो तुमी लोक गीनको तन ला नास करयेत उन लक नोको डराव पर एको मघा अखीन काही नही कर सकेत। <verse eid="LUK 12:4"/><verse number="5" style="v" sid="LUK 12:5"/>मी तुम्ही ला चोवके कव्हसू कोनी लक डराव ये वोको लक डरो जो मरनो को बाद मा जोनला नरक मा डाकन को अधिकार सेत वोको लक डराओ।<verse eid="LUK 12:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="LUK 12:6"/>उ दुई पैसा मा पाँच चिड़िया मिलासे मंग भी परमेस्वर उन मा लक एक ला नही भूलासे। <verse eid="LUK 12:6"/><verse number="7" style="v" sid="LUK 12:7"/>तुम्ही भेव नोको खाव तुम्हारो जान गजब सो चिड़िया गीन लक जादा कीमती सेत परमेस्वर ना तुम्हारो डोस्का को चुन्दी गिनके राखिसेस।<verse eid="LUK 12:7"/></para>
  <para style="s">यीसु ला माननो अना नोको माननो</para>
  <para style="r">(<ref loc="MAT 10:32">मत्ती 10:32</ref>,<ref loc="MAT 10:33">33</ref>; <ref loc="MAT 12:32">12:32</ref>; <ref loc="MAT 10:19">10:19</ref>,<ref loc="MAT 10:20">20</ref>)</para>
  <para style="p">
    <verse number="8" style="v" sid="LUK 12:8"/>मि तुम्‍ही लक कव्हासू जो कोनी मानूस गीनको पुढा मोला मानसे मानूस को टूरा सरगदूत अखीन परमेस्वर को सामने मान लेवासु का यो ला मी जानासू। <verse eid="LUK 12:8"/><verse number="9" style="v" sid="LUK 12:9"/>पर जो मानूस गीन को पुढा मोला मुकर जायेत अखीन सांगासे कोन यीसु से? तो मी परमेस्वर अखीन सरगदूत गीन को पूढा सांगू मी भी यो ला नही जानासू यो कोन सेत?<verse eid="LUK 12:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="LUK 12:10"/>जोन कोनी मानूस को टूरा को विरोध मा गोस्टी सांगेत वोको दोस छिमा हो जाहेत, पर जोन कोनी पवीतर आतमा<note caller="+" style="f"><char style="fr" closed="false">12:10 </char><char style="ft" closed="false">सुध्द आतमा </char></note> को विरोध मा निन्दा करेत वोको अपराध छिमा नही होयेत। <verse eid="LUK 12:10"/><verse number="11" style="v" sid="LUK 12:11"/>जबा लोग गीन तुम्हीला सभाघर मा न्यायलय मा अधिकारी<note caller="+" style="f"><char style="fr" closed="false">12:11</char><char style="ft" closed="false">न्यायधीस</char></note> गीन को कठा लिजायेत तो हमी काजक सांगबीन सोचके नोको घबराने। <verse eid="LUK 12:11"/><verse number="12" style="v" sid="LUK 12:12"/>काहेका वोच बेरा मा काजक कव्हनो सेत पवीतर आतमा तुम्ही ला सीका देहेत।<verse eid="LUK 12:12"/></para>
  <para style="s">एक मूरख धनवान को उदाहरन</para>
  <para style="p">
    <verse number="13" style="v" sid="LUK 12:13"/>भीड़ लक एक मानूस चिल्लायो, हे गुरू! मोरो भाऊ लक हुकूम देव, का धन को बटवारा कर देवे।<verse eid="LUK 12:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="LUK 12:14"/>यीसु ना कव्हयो कोन ना मोला तुम्हारो न्यायी ठहराई सेस। <verse eid="LUK 12:14"/><verse number="15" style="v" sid="LUK 12:15"/>यीसु ना भीड़ लक कव्हयो कोनी को सम्पती वोको जान लक बड़के नही होय सका से, पर यो काजी आपरो आप ला लोभ लक बचाये राखो।<verse eid="LUK 12:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="LUK 12:16"/>वोना एक उदाहरन लक समजावन लग्यो कोनी धनवान को जमीन मा गजब फसल पीकी। <verse eid="LUK 12:16"/><verse number="17" style="v" sid="LUK 12:17"/>तबा उ आपरो मन मा विचार करन लग्यो फसल राखन काजी अता मी काजक करु? <verse eid="LUK 12:17"/><verse number="18" style="v" sid="LUK 12:18"/>अखीन वोना सोचीस का घर मा ढोला गिनला तोड के उनला मोठी बनाके ना वहान गँहु ठे देहू। <verse eid="LUK 12:18"/><verse number="19" style="v" sid="LUK 12:19"/>तबा मि आपरो मन ला सांगू, “हे मोरो मन, तोरो जवर लगत बरस को साठी लगत सी जायदाद राखीसे। सुख मनाय अना जेवन कर, खुसी मनाव।”<note caller="+" style="f"><char style="fr" closed="false">12:19</char><char style="ft" closed="false">खुसहाली करना</char></note> साजरो-साजरो रव्हो अखीन चैन लक जिंदगानी करेत। <verse eid="LUK 12:19"/><verse number="20" style="v" sid="LUK 12:20"/>पर परमेस्वर ना ओला साँगीस, हे मन्द डिमाक! आजच रात मा तोरो पिरान तोरो लक हर लियो जाहे, तबा तु अपरो धन सम्पती ला काजक करजोस अखीन जोन राखी सेस कोन को भई जाहेत?<verse eid="LUK 12:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="LUK 12:21"/>जोन मानूस आपरो काजी धन जोड़ासे वा यो मुरख जसो सेत, परमेस्वर को नजर मा कोनी धनी नहात।<verse eid="LUK 12:21"/></para>
  <para style="s">परमेस्वर पर भरोसा</para>
  <para style="r">(<ref loc="MAT 6:25-34">मत्ती 6:25-34</ref>)</para>
  <para style="p">
    <verse number="22" style="v" sid="LUK 12:22"/>मंग आपरो चेला गीन ला कव्हासे, ऐना करन लक मि तुमरो लक कव्हसू, “आपरो जान लाई असो कव्हके चिन्ता नोको करने, की हमी काजक जेवन करबीन देह मा काजक पहनबीन? <verse eid="LUK 12:22"/><verse number="23" style="v" sid="LUK 12:23"/>काहेका जान सेत तो जेवन सेत, अखीन तन सेत तो कपरा सेत। <verse eid="LUK 12:23"/><verse number="24" style="v" sid="LUK 12:24"/>कावरा पर ध्यान देव! वा ना बोवासे ना कापासे ना कोठी मा ठेवासे तबा भी परमेस्वर वोला पालासे तुम्ही कावरा अखीन पंखेरु ला बढ़के सेव। <verse eid="LUK 12:24"/><verse number="25" style="v" sid="LUK 12:25"/>तुम्ही मा असो कोन सेत जो चिन्ता करके ना आपरो जिंदगी को बेरा बढा सकासे? <verse eid="LUK 12:25"/><verse number="26" style="v" sid="LUK 12:26"/>अदी एतरो नान्होसो काम तुम्ही नही कर सकसो ता काजक लाय चिन्ता करोसेव?”<verse eid="LUK 12:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="LUK 12:27"/>“पहाड़ी को तराई कन ध्यान देव वहान जंगल को फुल कसो बढासे वोना आसो चोवसे का राजा सुलेमान को महिमा अना राजसी कपरा वोको पूढा फैल सेत। <verse eid="LUK 12:27"/><verse number="28" style="v" sid="LUK 12:28"/>यो काजी बर्रा को गवथ ला जोन आज सेत कल स्तो को भट्टा मा डाख्यो जाहेत परमेस्वर वोला असो हरो भरो राखासे, तो हे कच्चो भरोसा राखन वालो! तुम्हीला काहे साजरो कपरा नही पहनायेत?”<verse eid="LUK 12:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="LUK 12:29"/>“तुम्ही सक नोको करो का काजक जेवबीन अखीन काजक पहनबीन? <verse eid="LUK 12:29"/><verse number="30" style="v" sid="LUK 12:30"/>काहेका संसार को सप्पा मानूस मजे गैरयहुदी खुद जानासे का तुम्ही ला ये पाहिजेत। <verse eid="LUK 12:30"/><verse number="31" style="v" sid="LUK 12:31"/>पर सब लक पुढा परमेस्वर को राज अखीन न्याय ला खोजो तबा सबा चीज तुम्ही ला मिल जाहेत। <verse eid="LUK 12:31"/><verse number="32" style="v" sid="LUK 12:32"/>हे नान्हो हेड़ डराव नोको! परमेस्वर को इक्सा सेत, का तुम्ही ला राज देहेत।”<verse eid="LUK 12:32"/></para>
  <para style="s">सरग म धन</para>
  <para style="r">(<ref loc="MAT 6:19-21">मत्ती 6:19-21</ref>)</para>
  <para style="p">
    <verse number="33" style="v" sid="LUK 12:33"/>“आपरो धन-सम्पती बिक देव अना दान कर देव, अना आपरो कना असो पियुसी राखो, जोन जूनो नही होवासे, मजे सरग मा असो धन जमा करो जोन कमी नही होवासेत अना जोन को जवर चोर नही जावासेत, अना किड़ा काही बिगाड़ सकत। <verse eid="LUK 12:33"/><verse number="34" style="v" sid="LUK 12:34"/>काहे का जहा तिजोरी मा तुमरो धन से, वहाच तुमरो मन लगो रव्हेत।”<verse eid="LUK 12:34"/></para>
  <para style="s">झोपो नोको</para>
  <para style="p">
    <verse number="35" style="v" sid="LUK 12:35"/>“दियो पेटाव के ठेयो अखीन अपरो कमर बान्ध के ना तैय्यार रव्हने, <verse eid="LUK 12:35"/><verse number="36" style="v" sid="LUK 12:36"/>अना तुम्ही वोना दास को जसो बनो, जोन आपरो मालीक को बाट जोहत रव्हसे का लग्न को जेवन करके ला कबा आहेत? अखीन मी किवाड़ खोलू। <verse eid="LUK 12:36"/><verse number="37" style="v" sid="LUK 12:37"/>धन्य सेत वय दास जेनला वोको मालीक को आवनो पर जागतो मिल्हेत, मी तुम्ही लक खरो कव्हसू, मालीक उन ला पूरी तैय्यारी को सँगा जेवन लाय बसाहे, अना जवर आयके उनको सेवा करहे। <verse eid="LUK 12:37"/><verse number="38" style="v" sid="LUK 12:38"/>धन्य सेत उ दास, जबा वोको मालीक रात मा कभ्भू भी आहेत, अना वोला निगरानी करतो पाहेत। <verse eid="LUK 12:38"/><verse number="39" style="v" sid="LUK 12:39"/>यो साजरो लक समजलो का, यदि घर को मालीक ला मालूम हो तो का चोर कबा आवन वालो सेत, तो घर मा सेन्ध नही लगन देतो। <verse eid="LUK 12:39"/><verse number="40" style="v" sid="LUK 12:40"/>तुमी तैय्यार रव्हने जोन बेरा तुम्हि वोको आवन को मन मा विचार नही आनिसेव वोच बेरा मानूस को टूरा आय जाहेत।”<verse eid="LUK 12:40"/></para>
  <para style="s">भरोसा को लायक अना नालायक नौकर</para>
  <para style="r">(<ref loc="MAT 24:45-51">मत्ती 24:45-51</ref>)</para>
  <para style="p">
    <verse number="41" style="v" sid="LUK 12:41"/>तबा पतरस पुसयो पिरभू का यो उदाहरन तुम्ही हमरो लाय सांगासो का सबको लाय सेत?<verse eid="LUK 12:41"/></para>
  <para style="p">
    <verse number="42" style="v" sid="LUK 12:42"/>तबा यीसु ना कव्हयो, उ बिस्वास को काबील को ईमानदार मूनीम कौन सेत? जेनको मालीक आपरो नौकर चाकर पर मूनीम ठयरावा सेत, जोनलक उनला बेरा मा जेवन भेटेत। <verse eid="LUK 12:42"/><verse number="43" style="v" sid="LUK 12:43"/>धन्य सेत उ दास जो मालीक को अवन को बेरा मा वसोच करतो पाहेत। <verse eid="LUK 12:43"/><verse number="44" style="v" sid="LUK 12:44"/>मी तुम्ही लक खरोखर सांगसू उ वोला आपरो सब सम्पती पर अधिकारी बनायेत। <verse eid="LUK 12:44"/><verse number="45" style="v" sid="LUK 12:45"/>पर उ दास असो मन मा सोचन लगे, का मोरो मालीक ला आवन ला उसीर सेत, अना नौकर बनिहारिन ला मारन पीटन लगे, अना नसा बाजी एसो अराम करन लगेत। <verse eid="LUK 12:45"/><verse number="46" style="v" sid="LUK 12:46"/>तबा उ दास को मालीक असो दिवस आहेत, जोन दिवस को बारे मा उ मन मा विचार नही आनो होतो। तबा वोला गजब मोठो दन्ड देहेत, अना वोको हिस्सा भरोसा नही राखन वारा लोकगीन को संग होहेत।<verse eid="LUK 12:46"/></para>
  <para style="p">
    <verse number="47" style="v" sid="LUK 12:47"/>आपरो मालीक को मन को गोस्टी जानके न जोन दास ना काही तैय्यार नही करयो, ना वोकी मन मुताबीक काम करीस, उ गजब मार खायेत। <verse eid="LUK 12:47"/><verse number="48" style="v" sid="LUK 12:48"/>पर जोना अनजान मा मार खावन को काम करी सेस, उ जरासो मार खायेत, जोनला दियो गयो सेत, वोको लक गजब हीसाब मागो जाहेत। जोन ला गजब सोपो गई सेस वोको लक गजब लियो जाहेत।<verse eid="LUK 12:48"/></para>
  <para style="s">यीसु को आवन को बारेमा</para>
  <para style="r">(<ref loc="MAT 10:34-36">मत्ती 10:34-36</ref>)</para>
  <para style="p">
    <verse number="49" style="v" sid="LUK 12:49"/>मी धरती मा स्तो पेटावन काजी आई सेव। मी कीतरो चाव्हसू क उभो होयके धधक जाहेत। <verse eid="LUK 12:49"/><verse number="50" style="v" sid="LUK 12:50"/>मोला एक अखीन बप्तिस्मा लेनो से। अखीन जबा तकन यो पूरो नही होवासे मी गजब दुखीसेव। <verse eid="LUK 12:50"/><verse number="51" style="v" sid="LUK 12:51"/>का तुम्ही सोचसो का मी धरती मा सान्ती अना मेल करान आयो सेऊ, नही मी फूट डालन आइसेव। <verse eid="LUK 12:51"/><verse number="52" style="v" sid="LUK 12:52"/>काहे का एक घर मा पाँच मानूस सेत तो उन मा फूट होहेत, तीन दोन को विरोध अना दोन तीन को विरोध करेत। <verse eid="LUK 12:52"/><verse number="53" style="v" sid="LUK 12:53"/>वय एकमेक को विरोध करेत बाप टूरा को अखीन टूरा बाप को, माय टूरी को अना टूरी माय को, सास बहु को अखीन बहु सास को विरोध करेत।<verse eid="LUK 12:53"/></para>
  <para style="s">बेरा को लच्छन</para>
  <para style="r">(<ref loc="MAT 16:2">मत्ती 16:2</ref>,<ref loc="MAT 16:3">3</ref>)</para>
  <para style="p">
    <verse number="54" style="v" sid="LUK 12:54"/>यीसु ना भीड़ ला कव्हन लगीस, अदी तुमी दिवस डूबती लक बादल चोवासो तो कव्हसो, का बरसात होवन वालो सेत, अखीन असोच होवासे। <verse eid="LUK 12:54"/><verse number="55" style="v" sid="LUK 12:55"/>जबा दक्सिन को वारा चलासे तो कव्हासो का लपट चलहेत अखीन असोच होवासे। <verse eid="LUK 12:55"/><verse number="56" style="v" sid="LUK 12:56"/>वो कपटी गीन, तुम्ही बादल अखीन धरती को मौसम ला चीन्हासो तबा यो बेरा को लच्छन ला काय नही परख सकसो?<verse eid="LUK 12:56"/></para>
  <para style="s">नालिस करनवारा लक समजोता</para>
  <para style="r">(<ref loc="MAT 5:25">मत्ती 5:25</ref>,<ref loc="MAT 5:26">26</ref>)</para>
  <para style="p">
    <verse number="57" style="v" sid="LUK 12:57"/>तुम्ही खुदच न्याय काहे नही करासो, का काजक भलो सेत? <verse eid="LUK 12:57"/><verse number="58" style="v" sid="LUK 12:58"/>जबा तुम आपरो विरोधी को संग अदालत मा जावासो तो रास्ता मा वोको लक रिहाई को कोसिस करने, कही असो ना होयेत का उ तुमला न्यायी को कठा ले जाहेत। <verse eid="LUK 12:58"/><verse number="59" style="v" sid="LUK 12:59"/>मी तुम्ही लक कव्हसू जबा तकन एक-एक कवड़ी नही भरजो तबा तकन सूटकारा नही होवेत।<verse eid="LUK 12:59"/></para>
  <chapter eid="LUK 12"/>
  <chapter number="13" style="c" sid="LUK 13"/>
  <para style="s">आपरो पाप लक पस्तावा करो</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 13:1"/>वोना बेरा काही लोग गीन, यीसु ला, काही गलीली मानूस गीनको बारे मा सांगन आइन, जिनको खून को बरोबरी बलिदान कियो गयो जनावर लक, राजपाल पिलातुस ना करयो होतो। <verse eid="LUK 13:1"/><verse number="2" style="v" sid="LUK 13:2"/>तबा यीसु ना उन लोग गीनला कहीस, तुम्ही काजक सोचासो का यो गलीली मानूस बाकी लोकगीन लक लगत पापी सेत, यो कारन लक, उन पर आफद आइसेस। <verse eid="LUK 13:2"/><verse number="3" style="v" sid="LUK 13:3"/>असो गोस्टी नहात मी तुमी ला सागंसू, का तुमी पस्तावा कर मन नही बदलने, तो वसोच नास होय जाने। <verse eid="LUK 13:3"/><verse number="4" style="v" sid="LUK 13:4"/>अखीन तुमी काजक, सोचासो का सीलोह मा मीनार पड़न को कारन 18 लोकगीन मर गईन, उ येरुसलेम को सब रव्हन वारा लक जादा पापी होतिन। <verse eid="LUK 13:4"/><verse number="5" style="v" sid="LUK 13:5"/>असो नहात अदी तुमी पस्तावा कर, मन नही बदलने तो असोच नास भई जाने।<verse eid="LUK 13:5"/></para>
  <para style="s">बेफर अँजीर को झाड</para>
  <para style="p">
    <verse number="6" style="v" sid="LUK 13:6"/>तबा यीसु ना उनला, एक उदाहरन सांग्यो, कोनी, मानूस को अंगूर को बारी मा, एक अँजीर को झाड़ होत्यो। उ वोमा फर खोजन आयो पर वोला, एक भी फर नही मिलयो। <verse eid="LUK 13:6"/><verse number="7" style="v" sid="LUK 13:7"/>तबा वोना अंगूर को बगीचा को माली ला कहीस, चोव! मी तीन- साल लक, यो अँजीर को झाड़ मा फर खोजन आयो, पर एकच फर नही पायो। एला, काप डाखो काहे का यो फालतू मा जघा घेरासेत। <verse eid="LUK 13:7"/><verse number="8" style="v" sid="LUK 13:8"/>पर माली ना कव्हयो, मालीक यो साल अखीन रव्हन दे, मी एको, चारि कन खन्दकेना येको, जड़ मा मी खात डाखसू। <verse eid="LUK 13:8"/><verse number="9" style="v" sid="LUK 13:9"/>तबा मंग भी नही फलेत, त काप दियो जाहेत।<verse eid="LUK 13:9"/></para>
  <para style="s">कुबड़ी बायको ला पवीतर दिवस मा साजरो करनो</para>
  <para style="p">
    <verse number="10" style="v" sid="LUK 13:10"/>पवीतर दिवस<note caller="+" style="f"><char style="fr" closed="false">13:10</char><char style="ft" closed="false">सब्त</char></note> मा यीसु कोनी, सभाघर मा उपदेस देवत होत्यो। <verse eid="LUK 13:10"/><verse number="11" style="v" sid="LUK 13:11"/>वहान एक बाई होती जोन ला 18 साल लक, एक कमजोर करन वालो, बुरो आतमा झोमो होत्यो वा वोवन केना, कुबड़ी भई गई होती। वा कसी, भी सीधी नही होय सकत होती। <verse eid="LUK 13:11"/><verse number="12" style="v" sid="LUK 13:12"/>यीसु ना वोला चोवके, ना बुलायो अखीन वोला कहीस, हे बाई तु साजरी भई गइसेस। <verse eid="LUK 13:12"/><verse number="13" style="v" sid="LUK 13:13"/>अखीन वोना वोको, पर हात रख्यो, उ वोच बेरा साजरो भई गई अखीन, परमेस्वर ला धन्यवाद बड़ाई देवन लगी।<verse eid="LUK 13:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="LUK 13:14"/>तबा सभाघर को मुखिया गीन, हिजड़<note caller="+" style="f"><char style="fr" closed="false">13:14</char><char style="ft" closed="false">गुस्सा लक भर गयो </char></note> गईन काहेका, यीसु ना पवीतर दिवस मा बाई ला साजरो करीस, तबा लोकगीन कव्हन, लगीन 6 दिवस काम को सेत, वोना दिवस मा साजरो होव, अना पवीतर दिवस मा नोको आव।<verse eid="LUK 13:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="LUK 13:15"/>पर पिरभू ना कहीस, हे कपटी गीन का पवीतर दिवस मा तुम आपरो जानवर गधा बईल गीनला डोगा मा पानी देवसो का नही? <verse eid="LUK 13:15"/><verse number="16" style="v" sid="LUK 13:16"/>का साजरो नाहती, का यो बायका जोन अबराहम को टूरी सेत, जोनला सैतान ना अठरा साल लक बन्धो होतो, पवीतर दिवस यो बंधन लक सुटाई जाय? <verse eid="LUK 13:16"/><verse number="17" style="v" sid="LUK 13:17"/>यीसु को यो गोस्टी आयक केना, वोको सब बिरोध करनवारा लजा गईन, अना सप्पा लोकगीन वोना महीमा को काम चोवके खुसी लक भर गईन।<verse eid="LUK 13:17"/></para>
  <para style="s">राई को दाना</para>
  <para style="r">(<ref loc="MAT 13:31">मत्ती 13:31</ref>,<ref loc="MAT 13:32">32</ref>; <ref loc="MRK 4:30-32">मरकुस 4:30-32</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="LUK 13:18"/>यीसु ना कव्हयो परमेस्वर को, राज कोन को जसो सेत, मी एको बरोबरी काजक लक करु? <verse eid="LUK 13:18"/><verse number="19" style="v" sid="LUK 13:19"/>सरग को राज एक राई को दाना जसो सेत, जोनला कोनी मानूस ना बगीचा मा लगायो, वा गजब मोठयो भयी गयो, अखीन पक्सी ओना झाड़ को डार मा बसेरा करन लगीन।<verse eid="LUK 13:19"/></para>
  <para style="s">खमीर को कहानी</para>
  <para style="r">(<ref loc="MAT 13:33">मत्ती 13:33</ref>)</para>
  <para style="p">
    <verse number="20" style="v" sid="LUK 13:20"/>मंघा यीसु ना कव्हयो, “परमेस्वर को राज को बरोबरी काजक लक करु? <verse eid="LUK 13:20"/><verse number="21" style="v" sid="LUK 13:21"/>वो खमीर को जसो सेत जोनला लेय के, एक बायको ना दहा किलो कनीक मा मिला दियो सबा 10 कीलो आप खमीर बन गयो।”<verse eid="LUK 13:21"/></para>
  <para style="s">तंगगल्लि</para>
  <para style="r">(<ref loc="MAT 7:13">मत्ती 7:13</ref>; <ref loc="MAT 14:21-23">14:21-23</ref>)</para>
  <para style="p">
    <verse number="22" style="v" sid="LUK 13:22"/>यीसु गाँव-गाँव नगर-नगर सीकावत, येरुसलेम नगर को कन, जाय रहयो होतो। <verse eid="LUK 13:22"/><verse number="23" style="v" sid="LUK 13:23"/>कोनी ना पुसयो ओ पिरभू! का जरा सो लोक गीन सूटकारा पाहेत?</para>
  <para style="p" vid="LUK 13:23">एको पर यीसु ना कव्हयो, <verse eid="LUK 13:23"/><verse number="24" style="v" sid="LUK 13:24"/>सकड़ो किवाड़ लक, धसनो को पूरो-पूरो कोसीस करो, काहेकि मी तुमी ला कव्हसू, कोसीस करनो पर भी गजब लोकगीन धसन को लायक भी नही रहेत। <verse eid="LUK 13:24"/><verse number="25" style="v" sid="LUK 13:25"/>जब घरा को मालीक उभो भई केना, किवाड़ लगा देहेत, तबा तुम्हि बाहेर लक खट-खाटावने, अखीन कव्हने आमरो लाय किवाड़ उघाड़!तब उ तुम्हिला सांग देहत, तुम्ही कहान लक आइसेव, मी नही जानासू? <verse eid="LUK 13:25"/><verse number="26" style="v" sid="LUK 13:26"/>तबा तुमच कव्हने, आमी तोरो संग जेवन करीसेस, तुमी बजार मा उपदेस देत होतो। <verse eid="LUK 13:26"/><verse number="27" style="v" sid="LUK 13:27"/>पर उ तुमरो लक, कव्ह देहत, “अरे अन्याय को काम करन वालो, <note caller="+" style="f"><char style="fr" closed="false">13:27</char><char style="ft" closed="false">बुरा करन वालो</char></note> मी तुम्ही ला नही जानासू तुम्ही कोन सेव? तुमी मोरी नजर लक हट जाओ!” <verse eid="LUK 13:27"/><verse number="28" style="v" sid="LUK 13:28"/>जबा तुमी ही अबराहम इसहाक याकूब अखीन, सबा भविस्यवक्ता गीनला, परमेस्वर को राज मा चोवने, पर अपरो आप ला उन लक बेगरो चोयके तुम्हि रोवने अखीन पस्तावा करने <note caller="+" style="f"><char style="fr" closed="false">13:28</char><char style="ft" closed="false">तड़प-तड़प कर रोवना</char></note>। <verse eid="LUK 13:28"/><verse number="29" style="v" sid="LUK 13:29"/>दिन उगती, दिन बुड़ती, उत्तर अखीन दक्सिन का लोक गीन आहेत अखीन, परमेस्वर को राज मा मोठोयो, जेवनार मा जेवन करयेत<note caller="+" style="f"><char style="fr" closed="false">13:29</char><char style="ft" closed="false">परमेस्वर को राज मा जेवन करेत </char></note>। <verse eid="LUK 13:29"/><verse number="30" style="v" sid="LUK 13:30"/>चोवो जोन मघा सेत, उ पुढा भई जाहेत। अखीन जो पुढा सेत, उ मंघा भई जाहेत।<verse eid="LUK 13:30"/></para>
  <para style="s">राजा हेरोदेस को कपट</para>
  <para style="r">(<ref loc="MAT 23:37-39">मत्ती 23:37-39</ref>)</para>
  <para style="p">
    <verse number="31" style="v" sid="LUK 13:31"/>वोच बेरा मा काही मोसे को नियम को गुरू जी गीन, आयके सांगन लगीन, हे गुरूजी तुम्ही यहान लक, बिदाई लेलो काहेका, राजा हेरोदेस तुमी, ला मार डाखनो चाव्हासे।<verse eid="LUK 13:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="LUK 13:32"/>यीसु ना उनला कव्हयो, जाके ना उ कोल्हिया ला कव्हने, मी आज काल अखीन परो, बुरो आतमा गीन ला हेड़ासू, अखीन रोगी गीनला साजरो करासू, अखीन परो को दिवस मोरो काम पूरो भई जाहेत। <verse eid="LUK 13:32"/><verse number="33" style="v" sid="LUK 13:33"/>आज काल अखीन परो को दिवस मोला चलनो से, काहेका यो नही होय सकासे, का कोनी परमेस्वर को भविस्यवक्ता येरुसलेम तीरथ लक, बाहेर मारो जाहेत।<verse eid="LUK 13:33"/></para>
  <para style="s">येरुसलेम नगर को लाय यीसु को माया</para>
  <para style="r">(<ref loc="MAT 23:37-39">मत्ती 23:37-39</ref>)</para>
  <para style="p">
    <verse number="34" style="v" sid="LUK 13:34"/>यो येरुसलेम नगर तु भविस्यवक्ता गीनको हत्‍या करासे अखीन तोरो कना, जोन परमेस्वर को गोस्टी आना सेत, वोला गोटा लक मार डाकासेत, मीना कितरो बार चाहयोसेव, का तोरो सन्तान गीनला, इक्कठो करू, जसो कुकडी आपरो बच्चा गीन, ला पंखा को खाल्या, लुकाय लेवासे असोच सबा ला, लुकाय लेऊ, पर तु ना मोरो एक नही चलन दियो। <verse eid="LUK 13:34"/><verse number="35" style="v" sid="LUK 13:35"/>अता तुम्हारो घर तोरो लय, छोड़ दियो<note caller="+" style="f"><char style="fr" closed="false">13:35</char><char style="ft" closed="false">तुमरा जीवन उजडो हुया</char></note> जाहेत। मी तुमी लक खरो सांगासू, तुम्हि मोला जबा तकन नही चोवने, तबा तकन तुम्हि आवन वारो बेरा मा असो नही सागंने, का धन्य से उ जोन पिरभू को नाव लक आवासे।<verse eid="LUK 13:35"/></para>
  <chapter eid="LUK 13"/>
  <chapter number="14" style="c" sid="LUK 14"/>
  <para style="s">फरीसी को घरमा यीसु</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 14:1"/>यीसु पवीतर दिवस मा कोनी, मोसे को नियम को गुरू को यहान जेवनार मा गयो होतो, लोग वोला फसावन को ताक मा होतिन। <verse eid="LUK 14:1"/><verse number="2" style="v" sid="LUK 14:2"/>यीसु को पुढा एक जलोदर को रोगी आयो। <verse eid="LUK 14:2"/><verse number="3" style="v" sid="LUK 14:3"/>यीसु ना मोसे को नियम को गुरू गीन ला पुसिस, “का मोसे को नियम लक पवीतर दिवस मा कोनी रोगीला साजरो करनो खरो काम सेत का खोटो काम सेत?”<verse eid="LUK 14:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="LUK 14:4"/>तबा वोना ऊगा-मूगा रह गईन, तबा यीसु ना उ रोगि ला हात धरके ना साजरो कर देइस, अना वोला बिदाई दे देइस। <verse eid="LUK 14:4"/><verse number="5" style="v" sid="LUK 14:5"/>तबा यीसु ना उनला कहीस, अदी कोनी को टूरा या बईल बिहर मा पड़ जाहेत, तो तुमी मा कोन सेत जो पवीतर दिवस मा वोला बिहर लक नही हेडेत?<verse eid="LUK 14:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="LUK 14:6"/>अखीन वय वोको जवाब देवन को लायक भी ना होतिन।<verse eid="LUK 14:6"/></para>
  <para style="s">लहान बननो</para>
  <para style="p">
    <verse number="7" style="v" sid="LUK 14:7"/>जेवनार मा आयो लोग गीन बसन लाय ऊचो-ऊचो जघा निवाड़न लगीन, असो चोवके ना यीसु एक उदाहरन लक, समजावन लगीन। <verse eid="LUK 14:7"/><verse number="8" style="v" sid="LUK 14:8"/>जबा कोनी लगन मा नेवता देवासे, ता सबा लक मूख जघा मा नोको बसने। का मालुम तुमरो लक मोठो लोक ला घरवाला ना नेवता<note caller="+" style="f"><char style="fr" closed="false">14:8</char><char style="ft" closed="false">कोनी लहान मानूस ला मोठो बसन को जघा मा नही बसन देवनो </char></note> देइसेस। <verse eid="LUK 14:8"/><verse number="9" style="v" sid="LUK 14:9"/>अना जोना दुई ला निवता देइसेस, वोच आय के सांगेत, का उभो भय अखीन खाल्या जायके बस, तबा लजानो पड़ेत। <verse eid="LUK 14:9"/><verse number="10" style="v" sid="LUK 14:10"/>यो काजी जबा तुमला न्योता मिल्हे तो पूढा नोको बसने, मंघा जायके, बसने, तबा घर को मालीक आयके सागेत, अगो संगी पूढा बस, ता तुमरो महिमा होयेत,<note caller="+" style="f"><char style="fr" closed="false">14:10</char><char style="ft" closed="false">तेरी मान बढाई करेंत</char></note> <verse eid="LUK 14:10"/><verse number="11" style="v" sid="LUK 14:11"/>काहेका जोन आपरो आप ला, मोठयो मानासे उ लहान कियो जाहेत, अखीन जो लहान सेत, उ मोठयो करो जाहेत<note caller="+" style="f"><char style="fr" closed="false">14:11</char><char style="ft" closed="false">वोला मोठो कियो जाहेत </char></note>।<verse eid="LUK 14:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="LUK 14:12"/>मंग यीसु ना निवता देवन वालो, ला सांग्यो। जबा तुमी दूफर या रात मा जेवनार देवो, तबा संगी गीन ला नोको हाकलो अना आपरो, भाऊ कुटुम्ब, धनी सेजारी गीनला नोको हाकलो, कही असो ना होय का आपरो, घर मा नेवता देके, ना बदाला चुकाय देहेत। <verse eid="LUK 14:12"/><verse number="13" style="v" sid="LUK 14:13"/>पर जब तुमी, जेवनार देव तो अँधरा लगंडा लूलो ला हाकलो। <verse eid="LUK 14:13"/><verse number="14" style="v" sid="LUK 14:14"/>तबा उ तुमी धन्य भई जाने, काहेका, उनको कठा बदला देन काजी काही नहात, अखीन तुमला परमेस्वर को अदालत मा, नेक गिनको जित्तो होवन को मघा फर भेटेत।<verse eid="LUK 14:14"/></para>
  <para style="s">मोठो जेवनार को उदाहरन</para>
  <para style="r">(<ref loc="MAT 22:1-10">मत्ती 22:1-10</ref>)</para>
  <para style="p">
    <verse number="15" style="v" sid="LUK 14:15"/>वोको संग जेवन करन वालो मा लक, एक मानूस यो गोस्टी आयक के सांगिस, धन्य से उ जोन परमेस्वर को राज मा जेवन करयेत।<verse eid="LUK 14:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="LUK 14:16"/>वोना ओको लक कव्हयो, कोनी मानूस ना गजब मोठो जेवनार दियो। अना गजब लोक हीनला न्योता दियो। <verse eid="LUK 14:16"/><verse number="17" style="v" sid="LUK 14:17"/>जबा जेवन तैय्यार भय गयो, ता वोना आपरो दास को हात मा न्योता हारो गीनला, सांग के धाडिस, “आव अबा जेवन तैय्यार से”। <verse eid="LUK 14:17"/><verse number="18" style="v" sid="LUK 14:18"/>पर वय सबा वोको लक माफी माँगन लगीन, पहलो ना नौकर लक, कव्हयो, “मी ना खेत लेयी सेव, वोला चोवन जानो से तोरो लक मोरो अरज से, का मोरो कन लक माफी मांग लेवजो।” <verse eid="LUK 14:18"/><verse number="19" style="v" sid="LUK 14:19"/>अखीन एक ना कव्हयो “मी ना पाँच जोड़ी बईल लेईसेव, अना उनला परख करनो से। तोरो लक मोरो बिनती से, का मोरो कन लक माफी मांग लेव जोस।” <verse eid="LUK 14:19"/><verse number="20" style="v" sid="LUK 14:20"/>अखीन एक ना कव्हयो, “मोरो लगन भइ सेस एको लाय मी नही आ सकसू।” <verse eid="LUK 14:20"/><verse number="21" style="v" sid="LUK 14:21"/>दास ना लवट के आपरो मालीक ला यो सबा हाल सांगीस, तबा मालक हिजड़ के ना आपरो नौकर ला कहीस, “लवकर नगर को बाजार सरक, गली मा जायके ना गरीब गोर, अँधरा लगडा लूलो गीन ला यहान ले आओ।” <verse eid="LUK 14:21"/><verse number="22" style="v" sid="LUK 14:22"/>तबा दास कहीस, मालीक तोरो हुकूम पूरो भई से, पर अबा जघा खाली सेस। <verse eid="LUK 14:22"/><verse number="23" style="v" sid="LUK 14:23"/>ता मालीक ना दास ला कहीस, “सड़क मा अखीन रुधान बाहेर जितरो लोक, चोहेत सबला आनो जीनको लक घर भर जाहेत।” <verse eid="LUK 14:23"/><verse number="24" style="v" sid="LUK 14:24"/>काहेका मी सबा लक कव्हसू, जोनला न्योता दियो होतो, उनमा लक कोनी जेवन नही जेव पाहेत।<verse eid="LUK 14:24"/></para>
  <para style="s">चेला बनन को कीमत</para>
  <para style="r">(<ref loc="MAT 10:37-38">मत्ती 10:37-38</ref>)</para>
  <para style="p">
    <verse number="25" style="v" sid="LUK 14:25"/>यीसु को संग-संग एक मोठयो भीड़ चलत होत्यो, यीसु ना भीड़ को लोग गीन लक असो सांग्यो, <verse eid="LUK 14:25"/><verse number="26" style="v" sid="LUK 14:26"/>“अदी कोनी मोरो कन आवासे अखीन आपरो माय बाप नवरी, सन्तान, भाऊ बहिन अखीन यहाँ लक की आपरो जान लक बैर<note caller="+" style="f"><char style="fr" closed="false">14:26</char><char style="ft" closed="false">आपरो जीवन लक पिरेम नही राखासे</char></note> नही करत, तो उ मोरो चेला नही होय सकासे?” <verse eid="LUK 14:26"/><verse number="27" style="v" sid="LUK 14:27"/>जोन आपरो कूरूस उचलके, नही ले जावासे, अखीन मोरो मंघा नही चलासे, उ मोरो चेला नही होय सकेत<note caller="+" style="f"><char style="fr" closed="false">14:27</char><char style="ft" closed="false">नही होय सकत</char></note>।<verse eid="LUK 14:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="LUK 14:28"/>तुमी मा कोन असो सेत, जोन मीनार बनवानो चाव्हासे, अखीन पुढा घर मा बस के, ना खरचा को अन्दाज हिसाब नही करयेत। अखीन यो ना चोवेत, का वोको जवर केतरा रुपया सेत। <verse eid="LUK 14:28"/><verse number="29" style="v" sid="LUK 14:29"/>कही असो ना होयेत, का पाया डाकन को मघा, घर को काम अधूरो छोड़ देहेत, अखीन चोवन वोरो, मजाक उड़ावत कहेत, “यो घर बनान को लायक भी नाहती।” <verse eid="LUK 14:29"/><verse number="30" style="v" sid="LUK 14:30"/>यो मानूस ना घर बनान काजी नीव डाखीस, पर पूरो करन को लायक भी नहाय। <verse eid="LUK 14:30"/><verse number="31" style="v" sid="LUK 14:31"/>अना कोन राजा होयेत, जोन दूसरो राजा लक, लडाई मा जावासे, अखीन पूढा बसके, यो विचार नही करासे, का जोन राजा बीस हजार सेना को, फौज को संग वोको पर चढ़ाई कर रही सेस, तो का उ दहा हजार सैनीक को फौज लक, सामना कर सकासे का नही। <verse eid="LUK 14:31"/><verse number="32" style="v" sid="LUK 14:32"/>यदि उ सामना नही कर सकासेत, तबा दूसरो राजा को, कन सान्ती को लाय, राजदूत लक बिनती धाड़ देहेत। <verse eid="LUK 14:32"/><verse number="33" style="v" sid="LUK 14:33"/>असोच तुम्ही लक जोन कोनी, सबा काही नही छोड़ देसे, उ मोरो चेला नहात।<verse eid="LUK 14:33"/></para>
  <para style="s">बे सवाद नोन</para>
  <para style="r">(<ref loc="MAT 5:13">मत्ती 5:13</ref>; <ref loc="MRK 9:50">मरकुस 9:50</ref>)</para>
  <para style="p">
    <verse number="34" style="v" sid="LUK 14:34"/>“नोन साजरो सेत, पर वोको स्वाद बिगड जाय, तो कसो नमकीन होय सकासेत? <verse eid="LUK 14:34"/><verse number="35" style="v" sid="LUK 14:35"/>उ ना तो जमीन को खात को काम को से, एकोलाय लोकगीन वोला बाहेर फेक देवासे। जोन को कान होयेत, उ आयक लेव।”<verse eid="LUK 14:35"/></para>
  <chapter eid="LUK 14"/>
  <chapter number="15" style="c" sid="LUK 15"/>
  <para style="s">गुमयो हुयो मेंढा की किस्सा</para>
  <para style="r">(<ref loc="MAT 18:12-14">मत्ती 18:12-14</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 15:1"/>यीसु को सिक्सा आयकन लाय, सबा पापी अना जमा लेवन वारा, अधिकारी<note caller="+" style="f"><char style="fr" closed="false">15:1</char><char style="ft" closed="false">बुरा करने वाला करज ब्याज वसुलने वालो सरकार</char></note> आवत होतिन। <verse eid="LUK 15:1"/><verse number="2" style="v" sid="LUK 15:2"/>पर सास्तरी अखीन मोसे को नियम को गुरू मोसे को नियम को गुरुगीन, कुडकूडान लगीन, अना कव्हन लगीन यो तो पापी लोक गीन, संग मिलसे उनको च संग जेवन करासे। <verse eid="LUK 15:2"/><verse number="3" style="v" sid="LUK 15:3"/>तबा वोना एक उदाहरन सांगन लग्यो<verse eid="LUK 15:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="LUK 15:4"/>तूम्ही लक कोन सेत, जेनको जवर 100 मेढा सेत, अखिन वोमा लक, एक गुम जाहेत, तबा 99 ला जंगल मा छोड़के, उ एक ला जबा तकन ना भेटेत, ढुन्ढत ना रह। <verse eid="LUK 15:4"/><verse number="5" style="v" sid="LUK 15:5"/>अखीन जबा उ मिल जावसे, तबा उ गजब खुसी होवासे, अखीन मेंढा ला कन्धा मा उचल लेवसे। <verse eid="LUK 15:5"/><verse number="6" style="v" sid="LUK 15:6"/>अखीन आस पड़ोस को लोक घर को लोक संगी गीन, ला इक्कठो करके कव्हसे, का खुसी मनावो मेढा गुम गयो, होत्यो मिल गयो से। <verse eid="LUK 15:6"/><verse number="7" style="v" sid="LUK 15:7"/>मी तुमी लक सांगसू, असोच एक पाप लक मन ला हटाव अना पस्तावा करन वालो, पापी को बारे मा सरग मा इतरोच खुसी होवासे, जितरो की 99 असो न्यायी को बारे मा नही होवासे। जोन ला मन बदलन को जरूरत नही सेती।<verse eid="LUK 15:7"/></para>
  <para style="s">गुमयो हुयो सिक्का</para>
  <para style="p">
    <verse number="8" style="v" sid="LUK 15:8"/>कोनी असो बाया होवती जोको जवर दहा मुन्दरी को सिक्का <note caller="+" style="f"><char style="fr" closed="false">15:8 </char><char style="ft" closed="false">दहा चलन के सिक्के</char></note> होहेत, वोमा लक एक गुम जाये, ता उ दियो पेटाय के, अखीन घर झाड बुहार के, जबा तकन ना मिल जाहेत, जान लगाय के ढुन्ढत रही। <verse eid="LUK 15:8"/><verse number="9" style="v" sid="LUK 15:9"/>अखीन जबा उ मुन्दरी को सिक्का मिल जासे, उ आपरो सहेली अना सेजारीन ला इक्कठो करासे, अखीन कव्हसे, का मोरी सिक्का गुम गयो, होतो मिल गयो से, मोर संग खुसी मनाओ। <verse eid="LUK 15:9"/><verse number="10" style="v" sid="LUK 15:10"/>मी तुमी लक कव्हसू, का असोच एक पाप ला सोड़ो हुया, पापी को बारेमा, सरग मा परमेस्वर को, सरगदूत गीन खुस होवासेत।<verse eid="LUK 15:10"/></para>
  <para style="s">भूलीयो हुयो पोरगा</para>
  <para style="p">
    <verse number="11" style="v" sid="LUK 15:11"/>मंग यीसु ना कव्हयो, कोनी मानूस को दोन टूरा होतीन। <verse eid="LUK 15:11"/><verse number="12" style="v" sid="LUK 15:12"/>उनमा लक लहान ना आपरो, बाबूजी लक कव्हसे, बाबूजी, धन मा लक जोन मोरो हिस्सा सेत, मोला देदे। वोना आपरो धन बाँट दियो। <verse eid="LUK 15:12"/><verse number="13" style="v" sid="LUK 15:13"/>लगत दिवस बीत गयो, लहान टूरा सब धन जमा करके, ना लगत दूर देस मा जिंदगी बितान चले गयो। अखीन वहान आपरो धन खरचा कर डाखीस, अखीन कंगाल भई गयो। <verse eid="LUK 15:13"/><verse number="14" style="v" sid="LUK 15:14"/>तबा उ देस मा गजब गीरानी पड गयो, अखीन वोको कन, जेवन लाय दाना नही होतो। <verse eid="LUK 15:14"/><verse number="15" style="v" sid="LUK 15:15"/>तबा उ देस मा एक मानूस को, कन उ गयो, अखीन वोला वोना खालमानी चरावन को, लाय नौकरी मा राख लियो। <verse eid="LUK 15:15"/><verse number="16" style="v" sid="LUK 15:16"/>वोको मालीक खालमानी गीन ला, खावन काजी जो सेंगा देवत होतो वोच ला उ लहानो टूरा भी खावत होतो। <verse eid="LUK 15:16"/><verse number="17" style="v" sid="LUK 15:17"/>जबा उ एक दिवस सोचन लग्यो, मोरो बाबूजी को घर मा कितरो बनिहार सेत, उनला भरपेट जेवन भेटासे अखिन मी भूखो मर रहीसेव। <verse eid="LUK 15:17"/><verse number="18" style="v" sid="LUK 15:18"/>अबा मी उठके, ना आपरो बाबूजी को कठा जाहू, अखीन वोको लक सांगू, का बाबूजी मी ना सरग को विरोध मा अखीन तोरो विरोध मा पाप करीसेव। <verse eid="LUK 15:18"/><verse number="19" style="v" sid="LUK 15:19"/>अबा मी तोरो टूरा कहलान को, काबील नहिसेव, अबा मोला आपरो एक बनिहार जसो राखले। <verse eid="LUK 15:19"/><verse number="20" style="v" sid="LUK 15:20"/>तबा उभो भयो अखीन आपरो, बाबूजी को कठा जावन लग्यो। वा अबा दूहूरच होत्यो, का वोको बाबूजी ना वोला चोवके उ तरस लक, भर गयो।</para>
  <para style="p" vid="LUK 15:20">अखीन परायके ना गरो लगाय लियो अना चुमन लग्यो। <verse eid="LUK 15:20"/><verse number="21" style="v" sid="LUK 15:21"/>तबा टूरा ना वोला कव्हयो, बाबूजी मी ना सरग को विरोध मा अखीन तोरो नजर मा पाप करीसेव। अबा मि यो लायक नही सेव, का तोरो टूरा कहलाउ। <verse eid="LUK 15:21"/><verse number="22" style="v" sid="LUK 15:22"/>पर वोना आपरो दास गीन ला कहीस, झटाक ना साजरो लक साजरो कपरा हेडके वोला पहनाव, अखीन वोको बोट मा मुन्दरी अना पायमा पनहि पहनवो। <verse eid="LUK 15:22"/><verse number="23" style="v" sid="LUK 15:23"/>अखीन पलियो हुओ बोकरा आनके, मारो जेवन करो खुसी मनाओ। <verse eid="LUK 15:23"/><verse number="24" style="v" sid="LUK 15:24"/>काहेका मोरो टूरा मर गयो होतो, मंग लक जित्तो भय गयो से। गुम गयो होतो, अबा मिल गयो से। अना सबा खुसी मनान लगीन।<verse eid="LUK 15:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="LUK 15:25"/>पर वोको मोठो टूरा खेत मा होत्यो। जबा उ घर को कठा, आयो ता वोना गानो बजानो को आवाज आयकिस। <verse eid="LUK 15:25"/><verse number="26" style="v" sid="LUK 15:26"/>तबा दास ला हाकल के पुसिस, यो सबा काजक से? <verse eid="LUK 15:26"/><verse number="27" style="v" sid="LUK 15:27"/>तबा वोना वोला कहीस, तोरो भाऊ आइसे, अना तोरो बाबूजी ना बोकरा कटवायो सेस।<verse eid="LUK 15:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="LUK 15:28"/>एको पर उ हिजड़ गयो अखिन भीतर नही गयो। तबा वोको बाबूजी वोला बाहेर आयके, वोला मनान लग्यो। <verse eid="LUK 15:28"/><verse number="29" style="v" sid="LUK 15:29"/>तबा मोठयो टूरा ना आपरो, बाबूजी ला जवाब दियो, मि एतरो साल तोरो चाकरी करीसेव, अखीन मि तोरो हुकूम ला कभीच नही टालेसेव, तो तु ना कभी मोला सेरी को पाठी नही दियो से का मि आपरो संगी गीन को संग खुसी मनाऊ। <verse eid="LUK 15:29"/><verse number="30" style="v" sid="LUK 15:30"/>पर जब तोरो लहान पोरगा, आयो जो रन्डीबाजि सरो धन खरचा कर दियो से मंग तू बोकरा कटवायो से। <verse eid="LUK 15:30"/><verse number="31" style="v" sid="LUK 15:31"/>तबा बाबूजी कव्हसे बेटा मि हमेसा तोरो संग सेव जोन काही मोरोसे उ सबा तोरो से। <verse eid="LUK 15:31"/><verse number="32" style="v" sid="LUK 15:32"/>पर अबा खुसी मनाव काहेका, तोरो लहान भाऊ मर गयो होतो, मंग जित्तो भई गई से। गुम गयो होतो अबा मिल गयो से।<verse eid="LUK 15:32"/></para>
  <chapter eid="LUK 15"/>
  <chapter number="16" style="c" sid="LUK 16"/>
  <para style="s">बैमान भंडारी</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 16:1"/>यीसु ना चेला गीनला कव्हयो, “एक धनवान को एक मूनीम होत्यो। धनवान को पूढा लोकगीन, कव्हन लगीन का खँजाचि तोरो, माल ला उड़वासे।” <verse eid="LUK 16:1"/><verse number="2" style="v" sid="LUK 16:2"/>तबा धनवान ना मूनीम ला हाकल के, पुसिस, यो काजक आयकसु? तू आपरो हिसाब-किताब जचवा मि तोला नौकरी लक हेडसू। <verse eid="LUK 16:2"/><verse number="3" style="v" sid="LUK 16:3"/>तबा दिवान कव्हसेत मि काय करु, माती खदन को ताकत नाहती यो काम तो मोरो लक, नही होयेत? मोला कोनी भिख भी नही देहेत, मालीक तो हेड देहेत। <verse eid="LUK 16:3"/><verse number="4" style="v" sid="LUK 16:4"/>दिवान कसे तबा का करनो से मोला समजमा आय गई से। लोग गीनको फायदा कराय देसू, जोन मुसिबत मा काम आहेत।<verse eid="LUK 16:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="LUK 16:5"/>वोना आपरो मालीक को एक-एक करजदार गीन ला बुलायो अखीन पहलो ला पुछिस, तोरो पर कितरो करजा सेत? <verse eid="LUK 16:5"/><verse number="6" style="v" sid="LUK 16:6"/>वोना कव्हयो तीन हजार लीटर जैतून तेल, तबा खंजाचि कव्हयो, आपरो करजा को रसिद आन बसके ना वोमा 15 संबर लीटर लिख दे। <verse eid="LUK 16:6"/><verse number="7" style="v" sid="LUK 16:7"/>अखीन दुसरो ला पुसयो, तू कितरो को करजदार सेत? तबा वोना जवाब देइस, 100 मन गँहु तबा खंजाची ना कहीस, 80 लिख दे<verse eid="LUK 16:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="LUK 16:8"/>मालीक ना वो अन्यायी मूनीम को बडाई करीस, काहेका उ चलाकी लक काम करीस, यो जुग मा भी असोच लोग परमेस्वर को लोकगीन लक लगत चतुर सेत।<verse eid="LUK 16:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="LUK 16:9"/>एको लक मी सांगा सेऊ, यो अन्याय को धन लक, आपरो लाय असोच संगी बनाय लेव, जसो खंजाची ना बनायो होतीस, ताकि सरग मा तुमी अमर निवास मा रव्हने। <verse eid="LUK 16:9"/><verse number="10" style="v" sid="LUK 16:10"/>जोन नहान-नहान गोस्टी मा बिस्वास काबिल सेत, उ लगत मा भी बिस्वास को काबिल सेत, अना जो लहान-लहान गोस्टी मा अबिस्वासी सेत, उ लगत मा अबिस्वासी ईमानदार सेत। <verse eid="LUK 16:10"/><verse number="11" style="v" sid="LUK 16:11"/>अदी तुमी संसार को, धन मा बिस्वास को काबिल नही सेव, तो खरो धन परमेस्वर तुमी ला, काहे सौपे <verse eid="LUK 16:11"/><verse number="12" style="v" sid="LUK 16:12"/>अदी तुमी परायो धन मा बिस्वास को काबिल नही सेव तो तुमरो आपरो, धन तुम्ही ला कसो मिलेहेत।<verse eid="LUK 16:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="LUK 16:13"/>कौनी मानूस दुई मालीक को चाकरी नही कर सका; उ एक लक बैर धरे अखीन, दुजो लक माया धरे या एक ला, आदर देहेत अखीन दुजोलक अपमान करयेत, तुमी परमेस्वर अना धन दुई को सेवा एक संग नही कर सकसेव।<verse eid="LUK 16:13"/></para>
  <para style="s">यीसु को काही सिक्सा</para>
  <para style="r">(<ref loc="MAT 11:12">मत्ती 11:12</ref>,<ref loc="MAT 11:13">13</ref>; <ref loc="MAT 5:31">5:31</ref>,<ref loc="MAT 5:32">32</ref>; <ref loc="MRK 10:11">मरकुस 10:11</ref>,<ref loc="MRK 10:12">12</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="LUK 16:14"/>मोसे को नियम को गुरू गिन धन-दौलत लक माया करत होतीन एकोलाय, यीसु को गोस्टी आयक के मजाक उड़ावत होतीन, <verse eid="LUK 16:14"/><verse number="15" style="v" sid="LUK 16:15"/>एको पर यीसु ना कव्हयो, तुमी लोकगीन को पुढ़ा सच्चो होवन को ढोंग करासो पर परमेस्वर तुमरो दिल ला जानासे, जोन चीज मानूस को नजर मा उच्चो से दुनिया को धन-दौलत, वा परमेस्वर को नजर मा बेकार से।<verse eid="LUK 16:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="LUK 16:16"/>मोसे को नियम अना भविस्यवक्ता योहन बप्तिस्मा देवन वालो तकन रहयो, वोना बेरा लक परमेस्वर को राज को साजरो बारता, आयकोआय रव्होसेत, अना हरेक वोमा जान काजी जबरन कोसीस करासेत। <note caller="+" style="f"><char style="fr" closed="false">16:16 </char><char style="ft" closed="false">धरम </char></note> <verse eid="LUK 16:16"/><verse number="17" style="v" sid="LUK 16:17"/><note caller="+" style="f"><char style="fr" closed="false">16:17</char><char style="ft" closed="false">आकास</char></note> बादल अना धरती दुई सरक जाहेत, पर मोसे को नियम को एक-एक गोस्टी <note caller="+" style="f"><char style="fr" closed="false">16:17</char><char style="ft" closed="false">मातरा</char></note> नही टलयेत बल्कि सबा पूरो होयेत।<verse eid="LUK 16:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="LUK 16:18"/>
    <note caller="+" style="f">
      <char style="fr" closed="false">16:18 </char>
      <char style="ft" closed="false">दुस्करम</char>
    </note> जोन नवरा अपरी बायको ला छोड़के अना दुसरो पाठ करयेत, उ वोको संग छिंडरापन करासे, अना जो अपरो नवरा ला छोड़के, दुसरो मानूस लक संग रव्होसे, व वोको संग पाप करासे।<verse eid="LUK 16:18"/></para>
  <para style="s">धनी मानूस अखीन गरीब लाजर</para>
  <para style="p">
    <verse number="19" style="v" sid="LUK 16:19"/>एक धनवान मानूस रव्हत होतो। उ गजब मंहगो ऊचो-ऊचो कपरा घालत होत्यो, अना रोज साजरो-साजरो जेवन करत होतो। <verse eid="LUK 16:19"/><verse number="20" style="v" sid="LUK 16:20"/>वोको घर को बेसकूड़ मा एक गरिब लाचार मानूस पडयो रहत होत्यो, वोको नाव लाजर होत्यो, वोको आँग भर फोडा-फुन्सि होत्यो। <verse eid="LUK 16:20"/><verse number="21" style="v" sid="LUK 16:21"/>उ धनवान मानूस को जूठो-काठो गिरो-पड़ो जेवन जेत होत्यो, अखीन कुतरा वोको फोडा ला जिबली चाटत होत्यो।<verse eid="LUK 16:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="LUK 16:22"/>उ गरिब एक दिवस मर गयो, अखीन सरगदूत वोला धरकेना अबराहम को कोरा मा राखदेइन। मंग धनवान भी मर गयो, अना वोला भी माती देइन। <verse eid="LUK 16:22"/><verse number="23" style="v" sid="LUK 16:23"/>उ नरक मा दूख भोगन लग्यो, आपरो डोरा वरता उठायके ना, दूर लक अबराहम अखीन वोको कोरा मा गरिब लाजर ला चोवयो। <verse eid="LUK 16:23"/><verse number="24" style="v" sid="LUK 16:24"/>वोना हाकलिस, अबराहम दादजी मोरो पर दया कर, अखीन लाजर ला धाड़, उ आपरो बोट ला पानी मा फिलायके, मोरो तोन्ड मा डाखेत काहेका, मि इस्तो मा तड़पासू।<verse eid="LUK 16:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="LUK 16:25"/>तबा अबराहम ना वोला सांगिस, हेतकर मोरो लाल, तोरो जीवन मा कसो-कसो सुख मिलिसेस, अखीन लाजर को जीवन मा कितरो मोठो-मोठो दुख होतो, अबा वोला चैन मिलि सेस, अना तोला दुख। <verse eid="LUK 16:25"/><verse number="26" style="v" sid="LUK 16:26"/>अखीन तोरो अना हमारो, बिच मा गहरो खोदरा सेत, एको लाय यदि कोनी तोरो कठा, जावन चाव्हासे, तो भि नही जाय सकत, ना कोनी वोना गन लक एनागन आय सकत। <verse eid="LUK 16:26"/><verse number="27" style="v" sid="LUK 16:27"/>तबा धनवान ना जवाब दियो दादजी, मोरो बिनती सेत क लाजर ला मोरो बाबूजी को गाँव मा धाड, <verse eid="LUK 16:27"/><verse number="28" style="v" sid="LUK 16:28"/>काहेका मोरो पाँच भाऊ सेत, उ उनको पुढ़ा एना गोस्टी ला चेतायेत, असो नहोय की वय भी एना तकलीफ की जघा मा आहेत।<verse eid="LUK 16:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="LUK 16:29"/>तबा अबराहम ना कव्हयो, उनको कना मोसे को नियम अना भविस्यवक्ता गिनको पवीतर गिरंथ से, वय उनको गोस्टी मानेत <verse eid="LUK 16:29"/><verse number="30" style="v" sid="LUK 16:30"/>तबा धनवान मानूस कव्हासे, अबराहम दादजी, वोना कहान आयकेसी? पर मूरदा लक कोनी उनको कठा जाहेत, तबा वय पस्तावा करके ना मन बदलेत। <verse eid="LUK 16:30"/><verse number="31" style="v" sid="LUK 16:31"/>एको पर अबराहम कव्हसे, जबा वय मोसे को नियम अना भविस्यवक्ता गिनको पवीतर गिरंथ को नही मानासे, तो कोनी मूरदा लक, जी उठेत ता वोको भि नही समजेत।<verse eid="LUK 16:31"/></para>
  <chapter eid="LUK 16"/>
  <chapter number="17" style="c" sid="LUK 17"/>
  <para style="s">पाप अना छिमा</para>
  <para style="r">(<ref loc="MAT 18:6">मत्ती 18:6</ref>; <ref loc="MAT 7">7</ref>; <ref loc="MAT 21">21</ref>; <ref loc="MAT 22">22</ref>; <ref loc="MRK 9:42">मरकुस 9:42</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 17:1"/>यीसु ना आपरो चेला गीन, ला कव्हासे, “पक्को पाप को लोभ मानूस को पूढा जरुर आहेत, मंग उ मानूस ला धिक्कार सेत, जोन को लक मानूस पाप को लोभ मा पड़ासे! <verse eid="LUK 17:1"/><verse number="2" style="v" sid="LUK 17:2"/>जोन मानूस ऐना लहान लोक गीनको पाप को कारन सेत, वोको सजा यो से का, गरो मा चकिया को गोटा बान्धके, ना सागर मा डाख दियो जाये।”<verse eid="LUK 17:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="LUK 17:3"/>
    <note caller="+" style="f">
      <char style="fr" closed="false">17:3 </char>
      <char style="ft" closed="false">जोन पछताए वोला माफ करो</char>
    </note> “एकोलाय सतरक रव्हने, अदी तुमारो कोनी भाऊ गलति पाप करासे ता वोला नोको डाटो पर समजा लेव, अखीन उ पस्तावा करासे, ता वोला छिमा कर। <verse eid="LUK 17:3"/><verse number="4" style="v" sid="LUK 17:4"/>अदी कोनी दिवस मा सात बार तोरो विरोध मा पाप करासे, अखीन पस्तावा के छिमा मांगासे ता छिमा करदेव।”<verse eid="LUK 17:4"/></para>
  <para style="s">भरोसा</para>
  <para style="p">
    <verse number="5" style="v" sid="LUK 17:5"/>तबा चेलागीन पिरभू ला कव्हासेत, आमरो भरोसा ला बढ़ाव,<verse eid="LUK 17:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="LUK 17:6"/>पिरभू कव्हासेत, अदी तुमला राई को दाना बरोबर भरोसा होत्यो, अना सहतूत को झाड़ ला हुकूम देवतो, का उखड अना सागर मा लगी जाय! ता उ तोरो हुकूम ला मानतो।<verse eid="LUK 17:6"/></para>
  <para style="s">एक नांगरिया को फरज</para>
  <para style="p">
    <verse number="7" style="v" sid="LUK 17:7"/>“यदि तुमारो दास नांगर धरकेना खेत लक लवटसे, या सेरकी सेरी चरा के ना लवटासे, तो तुमी मा लक असो कोन सेत? जोन सांगेत आ अबा जेवन करले। <verse eid="LUK 17:7"/><verse number="8" style="v" sid="LUK 17:8"/>अना यो नही कहे, की मोरो जेवन तैय्यार कर, अना मि जबा तकन जेव नही लेऊ, तबा पासुन तैय्यार रव्हके मोरी सेवा कर, एको मंघा तु भी जेव लेजोस। <verse eid="LUK 17:8"/><verse number="9" style="v" sid="LUK 17:9"/>का मालीक आपरो दास ला एको, लई धनबाद देनो चाव्हासे, का ओना कव्हनो मानीसेस? <verse eid="LUK 17:9"/><verse number="10" style="v" sid="LUK 17:10"/>हमी भी वसोच सेजन, जसो सबरई हुकूम को माननो को मंघ, हमी नालायक दास सेजन, काहेकी हमना अपरो करम करी सेजन।”<verse eid="LUK 17:10"/></para>
  <para style="s">दहा कोढी गिनला साजरो करनो</para>
  <para style="p">
    <verse number="11" style="v" sid="LUK 17:11"/>यीसु येरुसलेम नगर जावत-जावत सामरिया अना गलील, परदेस को सिवमेढो मा लक होय कना, जाय रहिया होतिन। <verse eid="LUK 17:11"/><verse number="12" style="v" sid="LUK 17:12"/>कोनी गाँव मा धसीन, ता उन ला दहा कोढी मिलिन वय गाँव को सिव मेढो पर उभा होतिन। <verse eid="LUK 17:12"/><verse number="13" style="v" sid="LUK 17:13"/>वय उच्चो आवाज मा कहिन, का यीसु हमरो पर दया कर!<verse eid="LUK 17:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="LUK 17:14"/>यीसु ना उनला चोवके उनला कहीस, जावो!</para>
  <para style="p" vid="LUK 17:14">“अना अपरो आप ला याजक ला देखाव<note caller="+" style="f"><char style="fr" closed="false">17:14 </char><char style="ft" closed="false">आपरो गुरू ला दिखा</char></note>” जबा वय जाय रहया होतीन, त रास्ता मा च साजरा भय गईन। <verse eid="LUK 17:14"/><verse number="15" style="v" sid="LUK 17:15"/>तबा वोमा लक एक असो चोय केना, का मी सजरो भय गयो कहेकर उच्चो आवाज लक, परमेस्वर को पिराथना बड़ाई करत, लवट गयो। <verse eid="LUK 17:15"/><verse number="16" style="v" sid="LUK 17:16"/>उ यीसु ला धन्यवाद देता-देता वोको पाय पर टोन्ड को बल पड़ गयो, अना उ सामरी होतो। <verse eid="LUK 17:16"/><verse number="17" style="v" sid="LUK 17:17"/>एको मघा यीसु ना सांग्यो, “का दहा साजरो नही भयो, तो मंग नउ कहान सेत? <verse eid="LUK 17:17"/><verse number="18" style="v" sid="LUK 17:18"/>अखीन ऐना परदेसी ला छोड़ केना, असो कोनी नई हिटयो जेव लवट केना, परमेस्वर की बड़ाई करतो?” <verse eid="LUK 17:18"/><verse number="19" style="v" sid="LUK 17:19"/>तबा यीसु न वोको लक कहीस, “का उभो होय जाय काहेका, तोरो भरोसा ना तोला साजरो करीसेस।”<verse eid="LUK 17:19"/></para>
  <para style="s">परमेस्वर को राज को आनो</para>
  <para style="r">(<ref loc="MAT 24:23-28">मत्ती 24:23-28</ref>,<ref loc="MAT 24:37-41">37-41</ref>)</para>
  <para style="p">
    <verse number="20" style="v" sid="LUK 17:20"/>एक बेरा मा मोसे को नियम को गुरू ना यीसु लक पुसिस, का परमेस्वर को राज कबा आहेत? तबा यीसु न वोला जवाब दियो, “परमेस्वर को नही चोवन वारा रुप मा राज आहेत, काहेका वा परगट नाहत। तो लोग गीनला कसो चोहेत? <verse eid="LUK 17:20"/><verse number="21" style="v" sid="LUK 17:21"/>लोक यो नही सांगासे ता चोवो उ यहान से उता सेत, काहेका परमेस्वर को, राज तुमारो बीच मा सेत।”<verse eid="LUK 17:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="LUK 17:22"/>यीसु ना आपरो चेला गीनला सांगिस, एक बेरा असो आहेत, जबा तुम मानूस को टूरा एक दिवस चोवनो चाव्हने, पर वोला नही चोवने। <verse eid="LUK 17:22"/><verse number="23" style="v" sid="LUK 17:23"/>लोक तुम्ही लक कव्हेत, चोवो उ वहान से, चोवा उ यहान से, ता तुमी उता नोको जावने, अखीन उनको मंघा नोको जावने। <verse eid="LUK 17:23"/><verse number="24" style="v" sid="LUK 17:24"/>काहेका जसो बादल मा बिजली कड़कासे अखीन यो छोर लक उ छोर तकन चमका से, वसोच तुमी मानूस को टूरा को आवन को बेरा होयेत। <verse eid="LUK 17:24"/><verse number="25" style="v" sid="LUK 17:25"/>पर पुढा बेजा दुख उठानो पडे़त, यो जरुरी सेत का लोक गीन, वोला नकारेत। <verse eid="LUK 17:25"/><verse number="26" style="v" sid="LUK 17:26"/>जसो भविस्यवक्ता नूह को बेरा मा हुओ होत्यो, वसोच मानूस को टूरा को दिवस मा भी होयेत। <note caller="+" style="f"><char style="fr" closed="false">17:26 </char><char style="ft" closed="false">लोग बेफिकर होतीन </char></note> <verse eid="LUK 17:26"/><verse number="27" style="v" sid="LUK 17:27"/>भविस्यवक्ता नूह को पानी जहाज मा बसन तकन, लोकगीन जेवन अना सादी ब्याह करत होतीन। तबा परलय आयो अना सबला बुड़ा देइस अना सबा सत्यानास<note caller="+" style="f"><char style="fr" closed="false">17:27</char><char style="ft" closed="false">नास होय गयीन</char></note> भई गइन। <verse eid="LUK 17:27"/><verse number="28" style="v" sid="LUK 17:28"/>लूत को बेरामा भी असोच भयो, लोग जेवन करत रहयो, घर बनावत होत्यो<note caller="+" style="f"><char style="fr" closed="false">17:28</char><char style="ft" closed="false">न्याय आ गयो। </char></note> पौधा लगावत होतिन <verse eid="LUK 17:28"/><verse number="29" style="v" sid="LUK 17:29"/>पर जोन दिवस लूत ना सदोम नगर सोड़यो परमेस्वर ना बादल लक स्तो बरसायके, सबला नास कर डाख्यो। <note caller="+" style="f"><char style="fr" closed="false">17:29 </char><char style="ft" closed="false">जूनो एक नगर जोनको नाव सदोम होतो</char></note> <verse eid="LUK 17:29"/><verse number="30" style="v" sid="LUK 17:30"/>मानूस को टूरा को आवन को बेरा मा असोच होयेत।<verse eid="LUK 17:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="LUK 17:31"/>वोना दिवस जोन अटारी मा सेत, वो समान लेवन लाय घर मा खाल्या नोको आहेत, अखीन जोन खेत मा सेत, उ मंघा नोको लवटे। <verse eid="LUK 17:31"/><verse number="32" style="v" sid="LUK 17:32"/>लूत को बायको ला हेत करो<note caller="+" style="f"><char style="fr" closed="false">17:32</char><char style="ft" closed="false">लुत की बायको नोन को मुन्डा बन गई</char></note>। <verse eid="LUK 17:32"/><verse number="33" style="v" sid="LUK 17:33"/>जोन आपरो जान सुरक्षीत रखनो चाव्हासे, उ वोला गुमा देहेत अखीन, जोन आपरो जान देहेत, उ जित्तो रहेत<note caller="+" style="f"><char style="fr" closed="false">17:33 </char><char style="ft" closed="false">अमर रहेत </char></note>। <verse eid="LUK 17:33"/><verse number="34" style="v" sid="LUK 17:34"/>मी तुम लक कव्हसू, वोना रात दूई झन एक खाट मा झोपेत, एक उचल लियो जाहेत, अखीन दुजो सोड़ दियो जाहेत<note caller="+" style="f"><char style="fr" closed="false">17:34 </char><char style="ft" closed="false">धरती मा रह जाहेती </char></note>। <verse eid="LUK 17:34"/><verse number="35" style="v" sid="LUK 17:35"/>“दोन बाया संग-संग चक्कीया मा दरत रहेत अना एक ला उचल लियो जाहेती अखीन दुसरी ला सोड़ दियो जाहेती।” <verse eid="LUK 17:35"/><verse number="36" style="v" sid="LUK 17:36"/>“दुई जन खेत मा सेत, एक उचल लियो जाहेत, अखीन दुजो सोड़यो जाहेत<note caller="+" style="f"><char style="fr" closed="false">17:36 </char><char style="ft" closed="false">परमेस्वर को मन मुताबिक न्याय होहेत। </char></note>।”<verse eid="LUK 17:36"/></para>
  <para style="p">
    <verse number="37" style="v" sid="LUK 17:37"/>यो आयक के चेलागिन, न पुसयो, “हे पिरभू यो कहान, होयेत?”</para>
  <para style="p" vid="LUK 17:37">तबा यीसु ना कव्हयो, “जहान लास सेत, वहाँच गीधाड़ इक्कठो होवासे।”<verse eid="LUK 17:37"/></para>
  <chapter eid="LUK 17"/>
  <chapter number="18" style="c" sid="LUK 18"/>
  <para style="s">न्यायधीस अना बेवा को किस्सा</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 18:1"/>मंग यीसु ना हमेसा पिराथना करनो से, अखीन हिम्मत नही छोडनो से समझावन काजी, एक किस्सा सांगीस। <verse eid="LUK 18:1"/><verse number="2" style="v" sid="LUK 18:2"/>कोनी नगर मा एक न्यायी रव्हत होतो, जोन नातो परमेस्वर को भगती करत होतो ना डरत होतो अना मानूस गीन को भेव खावत होत्यो। <verse eid="LUK 18:2"/><verse number="3" style="v" sid="LUK 18:3"/>वोच नगर मा एक बेवा रव्हत होती, जो वोका कठा आय आयके, कव्हत होती, मोरो बदला, देव अखीन मोला, मुकदमा करन वालो लक बचा। <verse eid="LUK 18:3"/><verse number="4" style="v" sid="LUK 18:4"/>काही बेरा तकन उ नही मानिस, पर आखीर मा मन मा बिचारन लगीस, का मोला ना तो परमेस्वर को भेव से ना ता कोनी लोकगीन को भेव सेत। <verse eid="LUK 18:4"/><verse number="5" style="v" sid="LUK 18:5"/>पर मोला रोज वा बेवा परेसान कर डाखीस, एको लाय मी आज एको, न्याय कर देसू कही असो ना होयेत, का बार-बार आयके, ना मोरो नाक मा दम कर देहेत।<verse eid="LUK 18:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="LUK 18:6"/>यीसु पिरभू कव्हसे, आयको! यो अन्यायी न्यायी का कव्हसे? <verse eid="LUK 18:6"/><verse number="7" style="v" sid="LUK 18:7"/>एकोलाय का परमेस्वर आपरो पूढा, बेचयो लोक गीनको, बदला लेहे जो रात दिवस, वोकी दोहाई देवासे। का उ उनको बारे मा देर करयेत? <verse eid="LUK 18:7"/><verse number="8" style="v" sid="LUK 18:8"/>मी तुमरो लक कव्हसू, उ एक दम सटाकना उनको बदला लेहे, तबा मानूस को टूरा जबा आहेत त का उ धरती मा बिस्वास पाहेत?<verse eid="LUK 18:8"/></para>
  <para style="s">फरीसी अखीन जमा लेवन वालो को उदाहरन</para>
  <para style="p">
    <verse number="9" style="v" sid="LUK 18:9"/>जोन आपरो उपर न्यायी होवनको, भरोसा राखत होतिन, उन लक एक उदाहरन सांगीस। <verse eid="LUK 18:9"/><verse number="10" style="v" sid="LUK 18:10"/>“दोन मानूस मंदिर मा पिराथना करन लाय, गइन एक मोसे को नियम को गुरू होतो, अखीन एक जमा लेवन वारा होतो।”<verse eid="LUK 18:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="LUK 18:11"/>मोसे को नियम को गुरू उभो-उभो असो, पिराथना<note caller="+" style="f"><char style="fr" closed="false">18:11</char><char style="ft" closed="false">बिनती</char></note> करत होतो। “परमेस्वर मी तोला धनवाद देवासू, का मी दुसरो लोकगीन जसो, लोभी, अन्यायी, गलत काम करन वालो नहि सेव, अखीन यो जमा वसूली करन वालो, अन्धेर करन वालो जसो नही सेव। <verse eid="LUK 18:11"/><verse number="12" style="v" sid="LUK 18:12"/>मी हफ्ता मा दूई दिवस उपास रव्हसू, अखीन आपरो सप्पा आय, को दसवा हिस्सा दान करासू।”<verse eid="LUK 18:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="LUK 18:13"/>जमा वसूली करन वालो, पापी अधिकारी काही दूहुर मा उभो होतो, वोला सरग कना, डोरा उठानो तकन को हिम्मत नही होतो। उ आपरो छाती पीट-पीट के ना कव्हत होत्यो, “परमेस्वर मोरो पर दयाकर।” <verse eid="LUK 18:13"/><verse number="14" style="v" sid="LUK 18:14"/>यीसु ना कव्हयो, “मी तुमरो लक कव्हसू, उ पहलो नही पर यो मानूस पाप लक सूटकारा पाय के अना न्यायी ठहराय के आपरो घर गयो।” काहेका “जोन कोनी आपरो आप ला ऊचो करासे, उ खाल्या कियो जाहेत, पर जोन आपरो आप ला खाल्या करासे, उ ऊचो कियो जाहेत।” <note caller="+" style="f"><char style="fr" closed="false">18:14 </char><char style="ft" closed="false">जोन लहान से वा मोठो कियो जाहेत।</char></note><verse eid="LUK 18:14"/></para>
  <para style="s">लेकरा गिनला आसिरवाद</para>
  <para style="r">(<ref loc="MAT 19:13-15">मत्ती 19:13-15</ref>; <ref loc="MRK 10:13-16">मरकुस 10:13-16</ref>)</para>
  <para style="p">
    <verse number="15" style="v" sid="LUK 18:15"/>लोक गीन यीसु को कठा, लहान- लहान लेकरा ला जवर आनीन का उ उनला छिव दे। चेला गीन ना यो चोवके, ना डाटन लगीन। <verse eid="LUK 18:15"/><verse number="16" style="v" sid="LUK 18:16"/>पर यीसु न लेकरा गीनला, आपरो जवर बुलायो, अखीन कव्हयो, लेकरा गीनला मोरो कठा, आवन देव, नोको मना करो, काहेका परमेस्वर को राज इनको जसा लोक गीनको सेत। <verse eid="LUK 18:16"/><verse number="17" style="v" sid="LUK 18:17"/>मी तुमरो लक खरो कव्हसू, जोन मानूस लहान-लहान लेकरा गीन जसो, परमेस्वर को राज ला नही अपनायेत, उ वोमा कभी नही धसनो पाहेत।<verse eid="LUK 18:17"/></para>
  <para style="s">धनी मानूस अना अमर जिन्दगी</para>
  <para style="r">(<ref loc="MAT 19:16-30">मत्ती 19:16-30</ref>; <ref loc="MRK 10:17-31">मरकुस 10:17-31</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="LUK 18:18"/>एक मुखिया ना यीसु लक असो पुसयो, ओ सब लक साजरो गुरु, अमर जीवन को वारसान, बनन लाय मी काजक करु?<verse eid="LUK 18:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="LUK 18:19"/>यीसु ना वोला सागीस, “मोला साजरो गुरू काहे कव्हसो? परमेस्वर ला सोड़ अखीन कोनी साजरो नहाय। <verse eid="LUK 18:19"/><verse number="20" style="v" sid="LUK 18:20"/>तुमी सप्पा हुकूम ला तो जानसो, बूरो नजर लक नोको चोवो, छिनाली नोको करो, कोनी ला जान लक नोको मारो, चोरी नोको करो खोटो, गवाही नोको देव, आपरो माय बाप को आदर करो।”<note caller="+" style="f"><char style="fr" closed="false">18:20</char><char style="ft" closed="false">माय-बाप की सेवा</char></note><verse eid="LUK 18:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="LUK 18:21"/>वोना जवाब दियो “यो सबा मी तो बचपन लक मानसू।”<verse eid="LUK 18:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="LUK 18:22"/>यीसु ना यो आयक के ओको, लक सांगीस, “तोरो मा एक बात की कमीसे। आपरो सप्पा बिग दे तिजोरी खोलके अखीन गरीब गोर मा बाट के ना मोरो मंघा आव। तब सरग मा धन मिल्हेत।” <verse eid="LUK 18:22"/><verse number="23" style="v" sid="LUK 18:23"/>उ यो आयक के ना गजब उदास भय गयो, काहेका उ गजब धनवान होत्यो।<verse eid="LUK 18:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="LUK 18:24"/>यीसु ना वोला उदास चोवके ना कहीस, “धनवान लोक गीनको, परमेस्वर को राज मा धसनो कठीन सेत <verse eid="LUK 18:24"/><verse number="25" style="v" sid="LUK 18:25"/>पर ऊँट को सूज्जी को नाक लक हीटनो सरल से। ” पर उनको परमेस्वर को राज मा धसनो कठीन से।<verse eid="LUK 18:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="LUK 18:26"/>येको पर आयकन वालो, लोक गीन कव्हन लगीन, तो कोन सूटकारा पाय सकासे?<verse eid="LUK 18:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="LUK 18:27"/>यीसु ना जवाब दियो जोन मानूस लक नही होय सकासे वा परमेस्वर कर सकासे।<verse eid="LUK 18:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="LUK 18:28"/>तबा पतरस ना कव्हयो, चोव, अमी लोकगीन आपरो सबा कही छोड़-छोड़ केना, तोरो माघा-मघा आय गयो सेजन। <verse eid="LUK 18:28"/><verse number="29" style="v" sid="LUK 18:29"/>यीसु ना जवाब दियो, मी तुम्ही लोक हिनला खरो सांगसू, असो कोनी नहात जोन ना परमेस्वर को राज लाय, घर बार, अना बायको अना भाऊ गीन अना माय-बाबूजी अना बाल-बच्चा छोड़-छाड़ देईसेस। <verse eid="LUK 18:29"/><verse number="30" style="v" sid="LUK 18:30"/>यो जुग मा वोला, कई गुना मील्हेत अखीन अमर जीवन भी मील्हेत।<verse eid="LUK 18:30"/></para>
  <para style="s">दुख भोगन को बारे मा तीसरो बारा सांगनो।</para>
  <para style="r">(<ref loc="MAT 20:17-19">मत्ती 20:17-19</ref>; <ref loc="MRK 10:32-34">मरकुस 10:32-34</ref>)</para>
  <para style="p">
    <verse number="31" style="v" sid="LUK 18:31"/>मंग यीसु बारा चेला गीनला अलग-थलग करके उन लक सांगीस, आयको हमी येरुसलेम नगर जाय रहयो सेत, मानूस को टूरा बारे मा जोन काही भविस्यवक्ता गीनना पवीतर गीरंथ मा लिखयो सेत, उ सप्पा पूरयो होवन वालो सेत। <verse eid="LUK 18:31"/><verse number="32" style="v" sid="LUK 18:32"/>काहेकि मी गैरयहुदी गीनको हात मा सौप दियो जाहेत, वोना मोरो मजाक उड़ाहेत, मोरो बेईज्जती करयेत अना मोरो पर थूकेत। <verse eid="LUK 18:32"/><verse number="33" style="v" sid="LUK 18:33"/>वय वोला कोड़ा मारेत अखीन मार डाखेत। पर उ तीन दिवस मा जित्तो भई जाहेत।<verse eid="LUK 18:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="LUK 18:34"/>उनला यो सबद समजमा नही आयो काहेका, परमेस्वर ना उनको, समज ला बंद कर दियो।<verse eid="LUK 18:34"/></para>
  <para style="s">अँधरा ला डोरा देवनो।</para>
  <para style="r">(<ref loc="MAT 20:17-19">मत्ती 20:17-19</ref>; <ref loc="MRK 10:32-34">मरकुस 10:32-34</ref>)</para>
  <para style="p">
    <verse number="35" style="v" sid="LUK 18:35"/>जब यीसु येरीयो नगर को कठा पहुचयो, वहान एक अँधरा रास्ता को कीनार मा बसके, भीख माँग रहयो होतो। <verse eid="LUK 18:35"/><verse number="36" style="v" sid="LUK 18:36"/>वोना भीड़ भाड़ जावन को आवाज आयकीस, अखीन पुसो यो काजक होवासे?<verse eid="LUK 18:36"/></para>
  <para style="p">
    <verse number="37" style="v" sid="LUK 18:37"/>तबा लोकगीन वोला सांगिन यीसु नासरी जाय रहि सेस।<verse eid="LUK 18:37"/></para>
  <para style="p">
    <verse number="38" style="v" sid="LUK 18:38"/>तबा उ जोर लक हाकलन लग्यो, “ओ यीसु दाऊद को खानदान मोरो पर दया कर!”<verse eid="LUK 18:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="LUK 18:39"/>तबा पूढा चलन वालो लोग गीन, ना चुप्प होवन काजी डाटन लगीन, पर उ अखीन जोर लक, वसोच हाकलीस। “ओ दाऊद को औलाद, मोरो पर दया कर।”<verse eid="LUK 18:39"/></para>
  <para style="p">
    <verse number="40" style="v" sid="LUK 18:40"/>यीसु थम गयो अखीन वोला वोको कठा, लावन को हुकूम दियो जबा उ जवर आयो, तबा यीसु ना पुछयो <verse eid="LUK 18:40"/><verse number="41" style="v" sid="LUK 18:41"/>तु काजक चाव्हासे, मी तोरो लाय काजक करु?</para>
  <para style="p" vid="LUK 18:41">वोना जवाब दियो मालीक मी चोवन चाव्हासू।<verse eid="LUK 18:41"/></para>
  <para style="p">
    <verse number="42" style="v" sid="LUK 18:42"/>यीसु कव्हसे, तो चोव, तोरो भरोसा ना तोला साजरो करीसेस।<verse eid="LUK 18:42"/></para>
  <para style="p">
    <verse number="43" style="v" sid="LUK 18:43"/>वोच बेरा उ चोवन लग्यो, अखीन उ परमेस्वर को स्तुती बड़ाई करन लग्यो अखीन यीसु को, मघा जावन लग्यो सारी जनता यो चोवके, ना परमेस्वर को स्तूती करन लगीन।<verse eid="LUK 18:43"/></para>
  <chapter eid="LUK 18"/>
  <chapter number="19" style="c" sid="LUK 19"/>
  <para style="s">जमा लेवन वालो जक्कई</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 19:1"/>यीसु येरीयो नगर मा धसके, ना जाय रहयो होतो। <verse eid="LUK 19:1"/><verse number="2" style="v" sid="LUK 19:2"/>वहान जक्कई नाव को एक मानूस होत्यो, जो जमा लेवन वालो को मुखीया होतो, उ गजब धनवान सेत। <verse eid="LUK 19:2"/><verse number="3" style="v" sid="LUK 19:3"/>उ यीसु ला चोवनो चाव्हत होतो, उ चोव नही सकत होत्यो, काहेका उ खुज्जा होतो। <verse eid="LUK 19:3"/><verse number="4" style="v" sid="LUK 19:4"/>वोना यीसु ला देखन काजी पुढा धावके, ना उमर को झाड़ मा चघ गयो, काहेका यीसु वोच रस्ता लक, जावन वालो होतो। <verse eid="LUK 19:4"/><verse number="5" style="v" sid="LUK 19:5"/>जबा यीसु वोना जघा मा पहूचो तबा वरता, नजर घुमाय के कव्हन लग्यो, ओ जक्कई तू खटाक ने खाल्या आव! काहेका, आज मी तोरो घर मा रुकन वालो सेव।<verse eid="LUK 19:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="LUK 19:6"/>उ एक दम उतर केना, खुसी लक आपरो घर ले गयो। <verse eid="LUK 19:6"/><verse number="7" style="v" sid="LUK 19:7"/>यो चोवकर सप्पा लोक गीन, कुड़ कुड़ा के कव्हन लगीन, उ तो एक पापी मानूस को, यहाँ पाहूना सेत<verse eid="LUK 19:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="LUK 19:8"/>जक्कई न उभो होयके पिरभू यीसु ला कव्हयो। हे मालीक चोव! मी आपरो धन को आरधो हिस्सा मी कंगाल गीन ला देवासू, अखीन काही अन्याव करके, ना राखीसेव तो वोला, मी चौगुना वापस देवासू।<verse eid="LUK 19:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="LUK 19:9"/>तबा यीसु ना कव्हयो, अबा यो घर मा सूटकारा आयो से, एको लाय का यो भी अबराहम को एक टूरा सेत। <verse eid="LUK 19:9"/><verse number="10" style="v" sid="LUK 19:10"/>काहे का मानूस को टूरा गुमो हुओ ला ढुढ़न अखीन वोला सूटकारा देवन काजी आई सेव<note caller="+" style="f"><char style="fr" closed="false">19:10 </char><char style="ft" closed="false">खोये हुए ला मोक्स देवना</char></note>।<verse eid="LUK 19:10"/></para>
  <para style="s">दहा मूहर को उदाहरन</para>
  <para style="r">(<ref loc="MAT 25:14-30">मत्ती 25:14-30</ref>)</para>
  <para style="p">
    <verse number="11" style="v" sid="LUK 19:11"/>जबा वोना यो गोस्टी ला आयकत होतिन, तो वोना एक उदाहरन सांगन लगीस। काहेका वय लोकगीन, येरुसलेम नगर को कठा होतिन अखीन उ समजत होतिन, का परमेस्वर को राज अबासीन आवन वालो सेत। <verse eid="LUK 19:11"/><verse number="12" style="v" sid="LUK 19:12"/>एक धनी मानूस होतो, उ दुर देस जावन लग्यो, का राज पद पाय केना आपस लवट आयो। <verse eid="LUK 19:12"/><verse number="13" style="v" sid="LUK 19:13"/>वोना आपरो दास मा लक, दहा ला बुलायके, ना उनला दहा मोहर दियो, अखीन कव्हयो मोरो लवट के आवत तकन धन्धा करने। <verse eid="LUK 19:13"/><verse number="14" style="v" sid="LUK 19:14"/>पर उ नगर को रव्हासी गीन, वोको लक बैर राखत होतिन, अखीन वोको मंघा दूत गीन लक खबर पायो, हमी नही चाव्हसेत का तू आमरो पर राज करयेत।<verse eid="LUK 19:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="LUK 19:15"/>जबा उ राज पद पाय के, लवटो तो असो भयो का वोना, आपरो दास गीनला बुलायो, अखीन पुसन लग्यो का, कोन-कोन न कितरो कमाई सेस? <verse eid="LUK 19:15"/><verse number="16" style="v" sid="LUK 19:16"/>तबा पहलो ना आयके कव्हयो, मालीक तोरो दहा मोहर लक मी अखीन दहा कमाई सेव। <verse eid="LUK 19:16"/><verse number="17" style="v" sid="LUK 19:17"/>तब वोना कव्हयो वाह साजरो दास गीन, मा तू एकच बिस्वास को काबील सेस। अबा 10 नगर मा अधिकार राख। <verse eid="LUK 19:17"/><verse number="18" style="v" sid="LUK 19:18"/>तबा दूसरो ना कव्हयो मालीक मी तोरो, मोहर लक पाँच मुहर कमाई सेव। <verse eid="LUK 19:18"/><verse number="19" style="v" sid="LUK 19:19"/>तबा वोना वोला भी कव्हयो, तु पाँच नगर पर अधिकार राख।<verse eid="LUK 19:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="LUK 19:20"/>तीसरो ना आयके कव्हयो, हे मालीक देख यो तोरो मोहर से जसो को तसो मी गमछा मा बान्ध के राखी सेव। <verse eid="LUK 19:20"/><verse number="21" style="v" sid="LUK 19:21"/>काहेका मी जानासू, तू गजब कठोर मानूस से एको, लाय मोला तोरो लक भेव लगीस, का कहि मी जानासू, जोन तू ना नही राखीसेस, वोला उचल लेवासे अखीन जो तू ना नही बोयो सेस, वोला काप लेवासे? <verse eid="LUK 19:21"/><verse number="22" style="v" sid="LUK 19:22"/>तबा वोना वोला कव्हयो, हे दुस्ट दास! मी तोरो टोन्ड लक, हिटयो गोस्टी लक, तोला दन्ड देवासू, तू मोला जानत होतो का मी कठोर मानूस सेव, जो मीना नही ठेवी सेव, वोला उचल लेवासू, अखीन मी जो नही बोयि सेव, वोला मी कापसू। <verse eid="LUK 19:22"/><verse number="23" style="v" sid="LUK 19:23"/>तो तूना यो मोहर ला माहाजन कठा ठेव देतो मी आकेना, ब्याज समेत ले लेतो।<verse eid="LUK 19:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="LUK 19:24"/>अखीन जोन कठा होतिन, उनलक कव्हयो का उ मोहर वोको लक, ले लेव अखीन जोको कठा, दहा मोहर सेत वोला, देदो। <verse eid="LUK 19:24"/><verse number="25" style="v" sid="LUK 19:25"/>उनना कव्हयो, मालीक वोको, कठा तो दहा मोहर सेत। <verse eid="LUK 19:25"/><verse number="26" style="v" sid="LUK 19:26"/><note caller="+" style="f"><char style="fr" closed="false">19:26 </char><char style="ft" closed="false">लगत दिया जायेत </char></note> मी तुम्ही लक कव्हसू, का जोको कठा सेत, वोला अखीन दियो जाहेत, अखीन जोको कठा नही सेत, वोको लक जो सेत, वे भी ले लियो जाहेत। <verse eid="LUK 19:26"/><verse number="27" style="v" sid="LUK 19:27"/>पर मोरो उन बैरी गीनला जोन नही चाव्हत, होतिन का मी राज करु, उनला आन केना मार डाखो।<verse eid="LUK 19:27"/></para>
  <para style="s">येरुसलेम नगर मा यीसु को धसनो</para>
  <para style="r">(<ref loc="MAT 21:1-11">मत्ती 21:1-11</ref>; <ref loc="MRK 11:1-11">मरकुस 11:1-11</ref>; <ref loc="JHN 12:12-19">योहन 12:12-19</ref>)</para>
  <para style="p">
    <verse number="28" style="v" sid="LUK 19:28"/>अखीन यीसु ये गोस्टी कव्हयो अना उ येरुसलेम नगर को कना, उनको पूढा चलयो। <verse eid="LUK 19:28"/><verse number="29" style="v" sid="LUK 19:29"/>जबा यीसु जैतून पहाड़ को कठा, बैतफगे अना बैतनिय्याह गाँव को जवर पहूचयो, तबा वोना, दोन चेला गीनला <verse eid="LUK 19:29"/><verse number="30" style="v" sid="LUK 19:30"/>“असो सांगत पठाय दियो का पूढा को गाँव मा, जाव जबा तुम्ही वहाँन, पहूचजो तबा तुम्हिला, खूटा मा बन्धो एक गधी को बछेरु मिल्हेत, जोको पर अबा कोनी, सवारी नही करीसेन <verse eid="LUK 19:30"/><verse number="31" style="v" sid="LUK 19:31"/>वोला छोड़ केना आनो यदि कोनी तुमला पूछेत, तो कव्हजोस का यीसु पिरभू ला, एको जरुरत से।”<verse eid="LUK 19:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="LUK 19:32"/>जोन चेला गीनला धाड़ीस होतीस, वोना जसो यीसु ना सांग्यो होतो, तसोच पाईन। <verse eid="LUK 19:32"/><verse number="33" style="v" sid="LUK 19:33"/>जबा वय बछेरु ला छोड़त होतिन, तबा वोको मालीक आयकेना कव्हसे “तुम्हि काहे छोड़ोसो।”<verse eid="LUK 19:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="LUK 19:34"/>तबा उनना जवाब देइन का, “यीसु पिरभू ला एको जरुरत से, वोच हमीला धाडीसेस।” <verse eid="LUK 19:34"/><verse number="35" style="v" sid="LUK 19:35"/>वय बछेरु ला वोको कठा, आनीन अखीन लोक गीन ना चद्दर बिछा के वोमा यीसु ला, बसाय देइन। <verse eid="LUK 19:35"/><verse number="36" style="v" sid="LUK 19:36"/>जसो-जसो यीसु पूढा बड़तो गयो, लोक गीन वोको पूढा रास्ता मा, चद्दर बिछात होतिन।<figure style="fig" alt="Jesus’ Triumphant entry to Jerusalem" file="LB00315C.TIF" size="span" copy="Horace Knowles ©" ref="19:36">यरूसलेम मा यीसु को जीत को जुलुस</figure><verse eid="LUK 19:36"/></para>
  <para style="p">
    <verse number="37" style="v" sid="LUK 19:37"/>जबा वय जैतून पहाड़ को, उतार मा पहुचियो तबा सब चेला गीन, खुसी होयके ना जोन काम उनना चोयो होतो, उ सबा अचंभा होवन वालो काम को, हेत कर केना सबा लक, उच्चो आवाज मा परमेस्वर को, स्तुती करन लगीन <verse eid="LUK 19:37"/><verse number="38" style="v" sid="LUK 19:38"/><note caller="+" style="f"><char style="fr" closed="false">19:38 </char><char style="ft" closed="false">महिमा हो</char></note> धन्य से उ राजा जो पिरभू को, नाव लक आवासे सरग मा सान्ती सबा लक, ऊचो सरग मा महिमा।<verse eid="LUK 19:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="LUK 19:39"/>भीड़ मा काही मोसे को नियम को गुरू होतिन, वोना यीसु लक कहिन गरुजी चेला गीनला डटकार <verse eid="LUK 19:39"/><verse number="40" style="v" sid="LUK 19:40"/>यको पर यीसु ना जवाब दियो “मी तुम लक कव्हसू, यदि वोना चूप रहयो, ता गोटा चिलावन लगेत।”<verse eid="LUK 19:40"/></para>
  <para style="s">येरुसलेम नगर को लाय रोवनो</para>
  <para style="p">
    <verse number="41" style="v" sid="LUK 19:41"/>जबा यीसु जवर आयो अना, नगर ला चोवयो अखीन उ रोवन लग्यो। <verse eid="LUK 19:41"/><verse number="42" style="v" sid="LUK 19:42"/>अना बोलयो, “कितरो साजरो, होतो का तू आज को दिवस, यो समज पातो का कोनतो, बात मा तोरि सान्ती, से?” पर अबा यो बात तोरी डोरा लक लुको हुओ सेत। <verse eid="LUK 19:42"/><verse number="43" style="v" sid="LUK 19:43"/>तोरो पर उ दिवस आहेत, जबा तोरो बैरी तोरो चारो लक घेर लेहति अखीन, तोरो पर दड़ब डाखेत। <verse eid="LUK 19:43"/><verse number="44" style="v" sid="LUK 19:44"/>तोला अखीन तोरो मा निवास करन वालो, तोरि सन्तान ला माती मा मिला देहति, अखीन तोरो मा एक भी गोटा तरा उपर नही रव्हेत, काहेका तूना उ साजरो दिवस ला नही चिन्हिसेस, जब परमेस्वर ना तोरि सुधि लेइसेस।<verse eid="LUK 19:44"/></para>
  <para style="s">मंदिर म बिकनवालो ला कहाड़नो</para>
  <para style="r">(<ref loc="MAT 21:12-17">मत्ती 21:12-17</ref>; <ref loc="MRK 11:15-19">मरकुस 11:15-19</ref>; <ref loc="JHN 2:13-22">योहन 2:13-22</ref>)</para>
  <para style="p">
    <verse number="45" style="v" sid="LUK 19:45"/>यीसु मंदिर मा धसिस अखीन, बिकन वालो ला यो सांगत बाहेर कहाडिस, का <verse eid="LUK 19:45"/><verse number="46" style="v" sid="LUK 19:46"/>लिखो से परमेस्वर को घर पिराथना को, घर होयेत, पर तूमना वोला डाकू को, अड्डा बना दियो से<note caller="+" style="f"><char style="fr" closed="false">19:46</char><char style="ft" closed="false">डाकू को रव्हन को जघा </char></note>।<verse eid="LUK 19:46"/></para>
  <para style="p">
    <verse number="47" style="v" sid="LUK 19:47"/>यीसु हर रोज मंदिर मा उपदेस देवत होतो, अखीन मोसे को नियम को गुरू मुखिया याजक अखीन, जनता गीन यो डाव ढुढत होतिन<note caller="+" style="f"><char style="fr" closed="false">19:47 </char><char style="ft" closed="false">मौका खोजत होतीन </char></note>, का यीसु को कसो नास कियो, जाय। <verse eid="LUK 19:47"/><verse number="48" style="v" sid="LUK 19:48"/>पर उनला नही सुझत होतो का, काजक करे? काहेका, जनता यीसु को बात लक खुसी होतिन।<verse eid="LUK 19:48"/></para>
  <chapter eid="LUK 19"/>
  <chapter number="20" style="c" sid="LUK 20"/>
  <para style="s">यीसु को अधिकार पर सवाल</para>
  <para style="r">(<ref loc="MAT 21:23-27">मत्ती 21:23-27</ref>; <ref loc="MRK 11:27-33">मरकुस 11:27-33</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 20:1"/>एक रोज यीसु मंदिर मा, जनता ला साजरो बारता सांगत होतो। का मोसे को नियम को गुरू, लेखक, मुखिया याजक ओको कठा आइन। <verse eid="LUK 20:1"/><verse number="2" style="v" sid="LUK 20:2"/>अखीन वोला पुसीन, यो तू हमला सांग का कोनतो, अधिकार लक यो काम करासे? उ कोन आय जोना तोला यो अधिकार देइसेस?<verse eid="LUK 20:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="LUK 20:3"/>तबा यीसु ना जवाब दियो, मि भी तुम्ही लक एक सवाल पूसासू, अखीन तुमी सांगो <verse eid="LUK 20:3"/><verse number="4" style="v" sid="LUK 20:4"/>योहन बप्तिस्मा देवन वालो को बप्तिस्मा, सरग कन लक होतो, का मानूस को कन लक होतो?<verse eid="LUK 20:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="LUK 20:5"/>वय आपसी मा सलाह करासे, हमि सरग कन लक सांगबीन तो उ कहेत, का तुम्ही योहन पर भरोसा काहे नही ठेवासो? <verse eid="LUK 20:5"/><verse number="6" style="v" sid="LUK 20:6"/>अदी हमि सांगबीन का मानूस कन लक तबा जनता हमला गोटा लक मार-मार के ना मार डाखेत। काहेका लोक गीन ला यो भरोसा होतो, का योहन परमेस्वर को भविस्यवक्ता आय। <verse eid="LUK 20:6"/><verse number="7" style="v" sid="LUK 20:7"/>एको लाय उनना जवाब दियो का, आमी नही जानसेजन, का योहन कोन कन लक से।<verse eid="LUK 20:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="LUK 20:8"/>एको पर यीसु ना उन लक, कव्हयो “तबा मि भी तुम्ही लक नही सांगसू, का मि कोनतो अधिकार लक यो काम करासू।”<verse eid="LUK 20:8"/></para>
  <para style="s">अंगूर को बाडी का उदाहरन</para>
  <para style="r">(<ref loc="MAT 21:33-46">मत्ती 21:33-46</ref>; <ref loc="MRK 12:1-12">मरकुस 12:1-12</ref>)</para>
  <para style="p">
    <verse number="9" style="v" sid="LUK 20:9"/>तबा यीसु जनता ला यो उदाहरन सागन लग्यो, एक किसान आपरी अंगूर को बारी, किसान गीनला ठेका मा देयके, ना गजब दिवस काजी, परदेस मा चले गयो। <verse eid="LUK 20:9"/><verse number="10" style="v" sid="LUK 20:10"/>जबा बेरा भयो ता उ मालीक ना आपरो एक दास ला धाड़िस, का अंगूर को बारी को बटाई देय दे। पर किसान गीन वोला, मर-पीट के ना रिकामो हात पराय देइन। <verse eid="LUK 20:10"/><verse number="11" style="v" sid="LUK 20:11"/>मंग उ मालीक ना दुसरो दास ला धाड़िस, अना वोला भि वसोच मार-पीटके ना रिकामो हात लवटा दियो। <verse eid="LUK 20:11"/><verse number="12" style="v" sid="LUK 20:12"/>मंग मालीक ना तिसरो नौकर ला धाड़िस, अखीन उनना वोला भी घायल करके ना कहाड़ देइन। <verse eid="LUK 20:12"/><verse number="13" style="v" sid="LUK 20:13"/>तबा अंगूर को बारी को मालीक ना सोचिस, का मी काय करू? मि आपरो चहेतो टूरा ला धाड़सु, साइद वोना लोक गीन वोको आदर करयेत। <verse eid="LUK 20:13"/><verse number="14" style="v" sid="LUK 20:14"/>जबा किसान ना वोला चोविन तो, आपस मा बिचारन लगीन, यो ता ओको वारिस आय, आओ एला मार डाखो, का यो बारी हमेसा लक आमरो भई जाहेत। <verse eid="LUK 20:14"/><verse number="15" style="v" sid="LUK 20:15"/>अखीन वोला अंगूर को बारी लक, बाहेर कहाड़ केना मार डाखिन।</para>
  <para style="p" vid="LUK 20:15">एकोलाय अबा अंगूर को बारी को मालीक उनको संग का, करयेत? <verse eid="LUK 20:15"/><verse number="16" style="v" sid="LUK 20:16"/>उ आयके ना वोना किसान गीनला नास करयेत, अखीन अंगूर को बारी ला दुसरो ला देहेत।</para>
  <para style="p" vid="LUK 20:16">उनना यो आयक के ना ओला कहिन, परमेस्वर करे असो नोको होयहेत।<verse eid="LUK 20:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="LUK 20:17"/>वोना उनको कना चोवके ना कहीस,</para>
  <para style="q1" vid="LUK 20:17">अखीन का लिखोसे? जोन गोटा ला मिस्तरी ना नकारो सेस,</para>
  <para style="q2" vid="LUK 20:17">वोच कोनटा<note caller="+" style="f"><char style="fr" closed="false">20:17 </char><char style="ft" closed="false">सिरे का पत्थर </char></note> को सप्पा बजन सहन वालो, गोटा भई गईस।<verse eid="LUK 20:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="LUK 20:18"/>जोन कोनी वो गोटा मा पडे़त, चकनाचूर भई जाहेत। अखीन गोटा जोनको पर पडहेत उ पिस जाहेत।<verse eid="LUK 20:18"/></para>
  <para style="s">कैसर राजा ला जमा पटानो</para>
  <para style="r">(<ref loc="MAT 22:15-22">मत्ती 22:15-22</ref>; <ref loc="MRK 12:13-17">मरकुस 12:13-17</ref>)</para>
  <para style="p">
    <verse number="19" style="v" sid="LUK 20:19"/>वोच बेरा मुखिया याजक, अखीन मोसे को नियम को गुरू लिखनवारा, समज गइन का यो उदाहरन आमरो पर लक सांगिसेस, ओना यीसु ला पकड़न चाहत होतिन, पर जनता लक भेव खाइन। <verse eid="LUK 20:19"/><verse number="20" style="v" sid="LUK 20:20"/>वय यो ताका मा होतिन, का भेद लेवन काजी कोनि मानूस ला धाड़ेत जोन झुठो बहाना लक नेक बनके वोला कोनी ना कोनी गोस्टी मा पकड़ेत, अना वोला अधिकारी को हात को सुपरुत करहेत। <verse eid="LUK 20:20"/><verse number="21" style="v" sid="LUK 20:21"/>वोना गीनना वोला पुसिन, हे गुरू हमि जानसेजन का तू खरो, सांगासेस अखीन सिकावासे। परमेस्वर को मारग खराई लक, सांगासेस अखीन कोनी, तरफदारी नही करासे। <verse eid="LUK 20:21"/><verse number="22" style="v" sid="LUK 20:22"/>ता अबा सांग मोसे को नियम लक का अमीला राजा कैसर ला, जमा को सिक्का देवनो खरो, से का खोटो से?<verse eid="LUK 20:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="LUK 20:23"/>वोना उनको होसियारी, समज गयो अखीन कव्हयो, <verse eid="LUK 20:23"/><verse number="24" style="v" sid="LUK 20:24"/>एक रुपया को सिक्का<note caller="+" style="f"><char style="fr" closed="false">20:24 </char><char style="ft" closed="false">दीनार एक दिवस को बनी </char></note> मोरो कठा आनो,</para>
  <para style="p" vid="LUK 20:24">तबा जनता लक पुछयो योमा कोन को छापा सेत अखीन कोको नाव सेत? लोगगीन कहिन राजा कैसर को।<verse eid="LUK 20:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="LUK 20:25"/>तबा उ उनला कहीस, जोन राजा कैसर को सेत, उ राजा कैसर ला देव, अखीन जो परमेस्वर को, से वो परमेस्वर ला देव।<verse eid="LUK 20:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="LUK 20:26"/>वय लोकगीन वोला मिसा लक पकड़न को ताका मा होतिन, यो काजी नेकी को भेस धरके ना काही लोक गिनला ओको कठा मिसा लक धाड़िन, का वय वोको कोनी सबद पकड़े, अखीन वोला अधिकारी गीन लक, सिकायत करके ना धराय देहत।<verse eid="LUK 20:26"/></para>
  <para style="s">दुबारा जित्तो होवनो अना बिहा</para>
  <para style="r">(<ref loc="MAT 22:23-35">मत्ती 22:23-35</ref>; <ref loc="MRK 12:18-27">मरकुस 12:18-27</ref>)</para>
  <para style="p">
    <verse number="27" style="v" sid="LUK 20:27"/>एको बाद काही सदूकी गुरूगीन, यीसु को जवर आइन जोन मरन को बाद जी उचलनो नही<note caller="+" style="f"><char style="fr" closed="false">20:27</char><char style="ft" closed="false">सदूकी</char></note> मानत होतिन। उनना वोला यो सवाल करीन, <verse eid="LUK 20:27"/><verse number="28" style="v" sid="LUK 20:28"/>गुरूजी, मोसे गुरूजी ना आमरो लाय, एक नियम बनाइसेस, का कोनी को भाऊ बिना सन्तान को मर जासे, तो वोको भाऊ उ बेवा ले बिहा करके ना आपरो भाऊ को, काजी सन्तान पैदा करेत<note caller="+" style="f"><char style="fr" closed="false">20:28</char><char style="ft" closed="false">खानदान </char></note>। <verse eid="LUK 20:28"/><verse number="29" style="v" sid="LUK 20:29"/>एक परिवार मा सात भाऊ होतिन मोठो ना बिहा करकेना नवरी आनीस, अखीन उ बझला मर गयो। <verse eid="LUK 20:29"/><verse number="30" style="v" sid="LUK 20:30"/>दुजो अखीन तिसरो <verse eid="LUK 20:30"/><verse number="31" style="v" sid="LUK 20:31"/>असो सातो भाऊ वा बायको, लक बिहा करके ना बिना सन्तान को मर जावासे। <verse eid="LUK 20:31"/><verse number="32" style="v" sid="LUK 20:32"/>आखीर मा उ बायको भी मर जासे। <verse eid="LUK 20:32"/><verse number="33" style="v" sid="LUK 20:33"/>अबा सांगो जित्तो होवनो को बाद मा वा बायको, कोन की बायको होयेत? उ तो सातो को बायको होति।<verse eid="LUK 20:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="LUK 20:34"/>यीसु ना कव्हयो एना जुग मा मरद-बायको, को बिहा होवासे। अखीन नवरा-नवरी होवासे। <verse eid="LUK 20:34"/><verse number="35" style="v" sid="LUK 20:35"/>पर आवन वालो जुग मा जबा, सप्पा मुरदा जित्तो होवनो भई जाहेत<note caller="+" style="f"><char style="fr" closed="false">20:35 </char><char style="ft" closed="false">मरनो मा लग्न नही होहेत। </char></note>, वहान बर-बिहा नही होयेत। <verse eid="LUK 20:35"/><verse number="36" style="v" sid="LUK 20:36"/>पर सबा जी उचलनो को मंघा अमर होयके ना, सरग दुत जसो परमेस्वर को सन्तान बन जाहेत। <verse eid="LUK 20:36"/><verse number="37" style="v" sid="LUK 20:37"/><note caller="+" style="f"><char style="fr" closed="false">20:37 </char><char style="ft" closed="false">मी जिन्दो को परमेस्वर सेऊ</char></note> पर यो गोस्टी को की मरयो हुयो जित्तो जित्ता होवासे, मोसे ना स्तो पेटायो झाड़ी को किस्सा मा सांगिसेस, जहान उ पिरभू कव्हासे का मि अबराहम, इसहाक अना याकूब को परमेस्वर सेउ। <verse eid="LUK 20:37"/><verse number="38" style="v" sid="LUK 20:38"/>उ मुरदा को नही पर जित्तो को परमेस्वर सेत। कायको लाय का वोको, पूढा सबा जित्तो सेत।<verse eid="LUK 20:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="LUK 20:39"/>एको मंघा मोसे को नियम को गुरू अना लेखक गीन कहिन का, तू ना साजरो सांगिसेस। <verse eid="LUK 20:39"/><verse number="40" style="v" sid="LUK 20:40"/>अखीन यीसु लक कोनी सवाल पुसन को, हिम्मत नही भयो।<verse eid="LUK 20:40"/></para>
  <para style="s">मसीह कोनको सन्तान?</para>
  <para style="r">(<ref loc="MAT 22:41-46">मत्ती 22:41-46</ref>; <ref loc="MRK 12:35-37">मरकुस 12:35-37</ref>)</para>
  <para style="p">
    <verse number="41" style="v" sid="LUK 20:41"/>मंग यीसु ना उनला पुसयो, मसीह ला राजा दाऊद को, सन्तान काहे कव्हासेत? <verse eid="LUK 20:41"/><verse number="42" style="v" sid="LUK 20:42"/>राजा दाऊद खुदच आपरो भजन को पवीतर किताब मा कव्हासे, परमेस्वर ना मोरो मालीक लक कव्हयो। <verse eid="LUK 20:42"/><verse number="43" style="v" sid="LUK 20:43"/>मोरो उज्जो बस जबा तकन मि तोरो बयरी गीन ला तोरो पाँय को खाल्या को पीढ़ो नही कर देवासू। <note caller="+" style="f"><char style="fr" closed="false">20:43 </char><char style="ft" closed="false">चरनो की चौकी </char></note> <verse eid="LUK 20:43"/><verse number="44" style="v" sid="LUK 20:44"/>राजा दाऊद ता वोला पिरभू कव्हासे त मंग वा कसो वोको सन्तान से?<verse eid="LUK 20:44"/></para>
  <para style="s">गियानी गीन लक होसियार</para>
  <para style="r">(<ref loc="MAT 23:1-36">मत्ती 23:1-36</ref>; <ref loc="MRK 12:38-40">मरकुस 12:38-40</ref>)</para>
  <para style="p">
    <verse number="45" style="v" sid="LUK 20:45"/>जबा सबा लोक गीन आयकत होतिन, तबा वोना आपरो चेला गीनला कव्हासे, <verse eid="LUK 20:45"/><verse number="46" style="v" sid="LUK 20:46"/>लेखक मोसे को नियम को गुरू ले होसियार रव्हो। जोन ला, लम्बो-लम्बो कपरा पहननो अखीन, फिरनो चाव्हासेत अखीन उनला, बजार मा नमस्कार अखीन, सभाघर मा उच्चो आसन <verse eid="LUK 20:46"/><verse number="47" style="v" sid="LUK 20:47"/>वय बेवा गीनको घर अना धन चट करासे अना दिसावन को लाय लम्बो-लम्बो पिराथना करोसे, उनला कठोर दन्ड मिलहेत।<verse eid="LUK 20:47"/></para>
  <chapter eid="LUK 20"/>
  <chapter number="21" style="c" sid="LUK 21"/>
  <para style="s">कंगाल बेवा को दान</para>
  <para style="r">(<ref loc="MRK 12:41-44">मरकुस 12:41-44</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 21:1"/>मंग वोना डोरा उठय के, ना धनी गीनला आपरो-आपरो दान पेटी मा डाखत चोवो, <verse eid="LUK 21:1"/><verse number="2" style="v" sid="LUK 21:2"/>वोना एक गरिब बेवा ला, वोमा दोन दमड़ी डाखत चोयो, तबा वोना कव्हयो, मि तुम्ही लक खरो सांगासू, का यो गरिब बेवा ना सबा मा बड़के दान डाखयो से। <verse eid="LUK 21:2"/><verse number="3" style="v" sid="LUK 21:3"/>तबा वोना कव्हयो, मी तुम्ही लक खरोखर सांगासू, का यो गरिब बेवा ना सबा मा बड़के, दान डाखिसे। <verse eid="LUK 21:3"/><verse number="4" style="v" sid="LUK 21:4"/>यो तो आपरो सप्पा कमाई को धन दान कर देइसेस, बाकि लोग गीन आपरो बढत लक, उलफा रुपिया डाखिन।<verse eid="LUK 21:4"/></para>
  <para style="s">मंदिर को नास को बारे मा सांगनो</para>
  <para style="r">(<ref loc="MAT 24:1">मत्ती 24:1</ref>,<ref loc="MAT 24:2">2</ref>; <ref loc="MRK 13:1">मरकुस 13:1</ref>,<ref loc="MRK 13:2">2</ref>)</para>
  <para style="p">
    <verse number="5" style="v" sid="LUK 21:5"/>जबा काही लोकगीन मंदिर को, बारे मा कव्हत होतिन, का यो कसो सुन्दर गोटा अना भेंट को, चीज लक सजायो गयो से? <verse eid="LUK 21:5"/><verse number="6" style="v" sid="LUK 21:6"/>तबा यीसु ना कव्हयो, वोना दिवस आहेत, जोन मा यो जोन काही तूम्हि चोवासो, उनमा लक कोनी गोटा लक गोटा नही बचेत, सबा नास कर दियो जाहेत।<verse eid="LUK 21:6"/></para>
  <para style="s">संकट को बारे मा सांगनो</para>
  <para style="r">(<ref loc="MAT 24:3-14">मत्ती 24:3-14</ref>; <ref loc="MRK 13:3-13">मरकुस 13:3-13</ref>)</para>
  <para style="p">
    <verse number="7" style="v" sid="LUK 21:7"/>उनना वोला पुसिन “हे गुरू यो सबा कबा होयेत? अना यो बात पूरो होवन को, का निसान सेत?”<verse eid="LUK 21:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="LUK 21:8"/>तबा उ कव्हसे “होसियार रव्हो का कोनी, तुमिला नोको भरमाय, काहेका गजब लोकगीन मोरो, नाव लक आहेत अखीन सांगेत, का मी वोच सेव अना यो, भी का बेरा जवर आय गयो से, तुमी उनको मंघा नोको जावने।” <verse eid="LUK 21:8"/><verse number="9" style="v" sid="LUK 21:9"/>जबा तुम्ही लडाई-बलवा को, चरचा आयकने तो नोको, घबराने, इनको पुढा होवनो जरुरी से, पर वोना बेरा अन्त नही होयेत।<verse eid="LUK 21:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="LUK 21:10"/>तबा वोना उन लक कव्हयो, लोक पर लोक अखीन, राज पर राज चढ़ाई करयेत। <verse eid="LUK 21:10"/><verse number="11" style="v" sid="LUK 21:11"/>अखीन मोठयो-मोठयो भुईडोल होयेत, अना जघा-जघा गिरानी पड़ेत, मरही आहेत अना वरता बादल मा, मोठो-मोठो निसान चोवेत। <verse eid="LUK 21:11"/><verse number="12" style="v" sid="LUK 21:12"/>पर इनलक पूढा लोग मोरो नाव को कारन, तुमला धराय देहेत, अखीन तगांयेत अना सभाघर मा सोपेत, अना जेल मा डाख देयेत, अना राजा न्यायईगिन को पूढा लेजायेत। <verse eid="LUK 21:12"/><verse number="13" style="v" sid="LUK 21:13"/>यो तुमारो लाय गवाही को बेरा होयेत। <verse eid="LUK 21:13"/><verse number="14" style="v" sid="LUK 21:14"/>एकोलाय आपरो-आपरो, मन मा ठान लेवका हमि उनको पूढा का कव्हनो से? यो चिन्ता नोको करने। <verse eid="LUK 21:14"/><verse number="15" style="v" sid="LUK 21:15"/>काहेका मि तुमीला असो बोल अना अक्ल देहू, का तुमारो विरोध करनवालो, काप नही सकेत। <verse eid="LUK 21:15"/><verse number="16" style="v" sid="LUK 21:16"/>तुमारो माय-बाप अना, भाऊ कुटुम्ब, अना संगी भी तूमीला धराय देहेत, अना यहान तकन का तुमी लक कोनी-कोनी, ला मरवा डाखेत। <verse eid="LUK 21:16"/><verse number="17" style="v" sid="LUK 21:17"/>मोरो नाव को कारन सबा लोक तूमी लक बैर करेत। <verse eid="LUK 21:17"/><verse number="18" style="v" sid="LUK 21:18"/>पर तुमरो डोस्का को, एक चुन्दी भी नहीं उखान सकेत। <verse eid="LUK 21:18"/><verse number="19" style="v" sid="LUK 21:19"/>पर आपरो धिरज लक, तूमी आपरो पिरान बचाय राखो।<verse eid="LUK 21:19"/></para>
  <para style="s">येरुसलेम नगर को नास को बारे मा सांगनो</para>
  <para style="r">(<ref loc="MAT 24:15-21">मत्ती 24:15-21</ref>; <ref loc="MRK 13:14-19">मरकुस 13:14-19</ref>)</para>
  <para style="p">
    <verse number="20" style="v" sid="LUK 21:20"/>जबा तूमी चोवने का, येरुसलेम नगर सेना लक, घिरो सेत तबा जान लेवने, का वोको नास कठा सेत। <verse eid="LUK 21:20"/><verse number="21" style="v" sid="LUK 21:21"/>वोना बेरा जो यहुदिया परदेस मा सेत, उ पहाड़ी मा पराय जाय, अना जोन येरुसलेम नगर को भीतर सेत, उ बाहेर हीट जाय, अखीन जोन देस मा नाहती उ सहर मा नोको जाय। <verse eid="LUK 21:21"/><verse number="22" style="v" sid="LUK 21:22"/>काहेका उ बदला को दिवस होयेत, जोन मा पवीतर गिरंथ मा लिखयो सबा बात पूरो भई जाहेत। <verse eid="LUK 21:22"/><verse number="23" style="v" sid="LUK 21:23"/>वोना बायको को लाय, दूख को दिवस होयेत, जोन पेट ले सेत, अना वा लेकरा ला दूध पिलाय सेति। काहे का धरती मा गजब मोठो विपदा आ जाहेत। <verse eid="LUK 21:23"/><verse number="24" style="v" sid="LUK 21:24"/>लोकगीन तलवार लक, काप दियो जाहेत। अना उनला बन्दी बनाय के ना, गैरयहुदी लोकिगीन मा लीजाय लेहेत। अना गैरयहुदी लोकगीन को लक, येरुसलेम नगर, जबा तकन बेरा पूरो ना भई जाय रवदो जाहेत।<verse eid="LUK 21:24"/></para>
  <para style="s">मानूस को टूरा को दुबारा आवनो</para>
  <para style="r">(<ref loc="MAT 24:29-31">मत्ती 24:29-31</ref>; <ref loc="MRK 13:24-27">मरकुस 13:24-27</ref>)</para>
  <para style="p">
    <verse number="25" style="v" sid="LUK 21:25"/>दिन-चन्दा तारा मा हिदान होयेत, सागर गरजेत अखीन पूरा-पानी लक, धरती को सबा मानूस लोक घबरा जाहेत। <verse eid="LUK 21:25"/><verse number="26" style="v" sid="LUK 21:26"/>भेव को कारन मा अना संसार मा होवन वारा अचंभा को काम को कारन आवनवालो बेरा को बाट जोहत-जोहत, लोकगीन को जान ठिकानो पर नही रहेत। काहे का बादल को ताकत डुलायो जाहेत। <verse eid="LUK 21:26"/><verse number="27" style="v" sid="LUK 21:27"/>तबा उ मानूस को टूरा मोठो ताकत न महिमा को, संग बादल म आवत चोहेत। <verse eid="LUK 21:27"/><verse number="28" style="v" sid="LUK 21:28"/>जबा यो बात होवन लगेत, तबा आपरो, मान सीधो करके ना उठने, काहेका तुमारो सूटकारा जवर होहेत।<verse eid="LUK 21:28"/></para>
  <para style="s">अंजीर को झाड़ को उदाहरन</para>
  <para style="r">(<ref loc="MAT 24:32-35">मत्ती 24:32-35</ref>; <ref loc="MRK 13:28-31">मरकुस 13:28-31</ref>)</para>
  <para style="p">
    <verse number="29" style="v" sid="LUK 21:29"/>वोना एक उदाहरन लक समजायो, अँजीर को झाड़ ला चोवो, <verse eid="LUK 21:29"/><verse number="30" style="v" sid="LUK 21:30"/>जबा उन मा नवा पान आवासे, तबा तुम्ही जान लेवासो का उनहारी को मौसम आय गयो सेत। <verse eid="LUK 21:30"/><verse number="31" style="v" sid="LUK 21:31"/>तुमी जबा असो होवत चोवने, तबा यो जान लेने का परमेस्वर को राज जवर सेत।<verse eid="LUK 21:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="LUK 21:32"/>मी तुम्ही लक खरो सांगासू, का जबा लक यो बात नही होयेत, यो पीढ़ी को अन्त नही होयेत। <verse eid="LUK 21:32"/><verse number="33" style="v" sid="LUK 21:33"/>बादल अना धरती टल जाहेत, पर मोरो बात नही टलहेत।<verse eid="LUK 21:33"/></para>
  <para style="s">जागली करो</para>
  <para style="r">(<ref loc="MAT 24:36-44">मत्ती 24:36-44</ref>; <ref loc="MRK 13:32-37">मरकुस 13:32-37</ref>)</para>
  <para style="p">
    <verse number="34" style="v" sid="LUK 21:34"/>एकोलाय होसियार रव्हने, असो ना होहेत एने जीवन को, भोग-विलास, नसा-पानी अना संसार को, चिन्ता मा तुमारो मन लग जाहेत, अना एकदम वोना दिवस जाल जसो आ जाहेत। <verse eid="LUK 21:34"/><verse number="35" style="v" sid="LUK 21:35"/>काहेका धरती मा रव्हन वालो, सबा पर असोच एकदम लक आफत आ जाहेत। <verse eid="LUK 21:35"/><verse number="36" style="v" sid="LUK 21:36"/>एकोलाय जागतो रव्हो अखीन, पिराथना करो का आवन वालो घटना लक, बचके न असो ताकत लक भर जावो का मानूस को टूरा पुढा उभो रह सको।<verse eid="LUK 21:36"/></para>
  <para style="p">
    <verse number="37" style="v" sid="LUK 21:37"/>यीसु दिवस मा मंदिर मा उपदेस देवत होतो, अना रात मा उ नगर को बाहेर हिटके ना जैतून पहाड़ मा रात बितात होतो। <verse eid="LUK 21:37"/><verse number="38" style="v" sid="LUK 21:38"/>अना पहेट मा उपदेस आयकन काजी मंदिर मा लोक आवत होत्यो।<verse eid="LUK 21:38"/></para>
  <chapter eid="LUK 21"/>
  <chapter number="22" style="c" sid="LUK 22"/>
  <para style="s">यीसु को विरोध मा चाल</para>
  <para style="r">(<ref loc="MAT 26:1-5">मत्ती 26:1-5</ref>; <ref loc="MRK 14:1-2">मरकुस 14:1-2</ref>; <ref loc="JHN 11:45-53">योहन 11:45-53</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 22:1"/>बेखमिरी भाकर को तिहार जोन ला, बलिदान तिहार कव्हसेत, <note caller="+" style="f"><char style="fr" closed="false">22:1</char><char style="ft" closed="false">फसह; बलिदान करन वालो तिहार </char></note> जवर आय गई। <verse eid="LUK 22:1"/><verse number="2" style="v" sid="LUK 22:2"/>मोसे को नियम को गुरू अना लेखक, मुखिया याजक, यीसु ला मार डाखन को उपाय ढूढत होतिन, पर वय जनता लक भेव करत होतिन।<verse eid="LUK 22:2"/></para>
  <para style="s">बिस्वास घाती चेला</para>
  <para style="r">(<ref loc="MAT 26:14-16">मत्ती 26:14-16</ref>; <ref loc="MRK 14:10">मरकुस 14:10</ref>,<ref loc="MRK 14:11">11</ref>)</para>
  <para style="p">
    <verse number="3" style="v" sid="LUK 22:3"/>वोना बेरा मा सैतान ना यूदस इस्करियोति, मा धस गयो, यूदस बारा चेला मा एक होत्यो। <verse eid="LUK 22:3"/><verse number="4" style="v" sid="LUK 22:4"/>वोना मोसे को नियम को गुरू अना मुखिया याजक लक, यीसु ला धरान को बारेमा चरचा करीस, का यीसुला उनको, हात धराय देयेत। <verse eid="LUK 22:4"/><verse number="5" style="v" sid="LUK 22:5"/>वोना खुस भई गयिन अना धन देवन को लोभ देईन। <verse eid="LUK 22:5"/><verse number="6" style="v" sid="LUK 22:6"/>यूदस भिड लक अलग यीसुला, धरान को डाव ढुढन लगिस।<verse eid="LUK 22:6"/></para>
  <para style="s">चेला गीनको संग बलीदान को आखीर जेवनो</para>
  <para style="r">(<ref loc="MAT 26:17-25">मत्ती 26:17-25</ref>; <ref loc="MRK 14:12-21">मरकुस 14:12-21</ref>; <ref loc="JHN 13:21-30">योहन 13:21-30</ref>)</para>
  <para style="p">
    <verse number="7" style="v" sid="LUK 22:7"/>बेखमिरी भाकर को दिवस आयो, वोना दिवस पाठी को बलिदान करनो जरुरी होत्यो। <verse eid="LUK 22:7"/><verse number="8" style="v" sid="LUK 22:8"/>यीसु पतरस अना योहन ला यो सांगके धाड़िस, “जाओ बलिदान तिहार को तैयारी करो, का अपन सबा संग-संग जेवन करबीन।”<verse eid="LUK 22:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="LUK 22:9"/>उनना यीसुला पुसिन, “कहाँ तैयारी करबीन हमला सांग का तोरो मन मा काय सेत?”<verse eid="LUK 22:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="LUK 22:10"/>यीसु ना जवाब दियो, “जसो नगर मा धसने वसोच तुम्ही ला, एक मानूस घघरा मा पानी लेयके जावतो चोयेत, वोको मघा-मघा जावने अना उ जोन घर मा जायेत, वोच घर मा जावने। <verse eid="LUK 22:10"/><verse number="11" style="v" sid="LUK 22:11"/>अना उ घर को मालक ला सांगने का, गुरूजी यहान बलिदान तिहार मनानवालो सेत, मिजवान खोली कोनतो से? जहा उ आपरो चेला गीनको संग जेवन करहेत। <verse eid="LUK 22:11"/><verse number="12" style="v" sid="LUK 22:12"/>उ तुमला सजो अटारी मा खोली दिसाएत वहाँच तैयारी करने।”<verse eid="LUK 22:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="LUK 22:13"/>वोना चले गइन अखीन यीसु ना जसो सांगो होतो, वसोच पाइन अखीन वहान बलिदान तिहार को जेवन तैय्यार करन लगीन।<verse eid="LUK 22:13"/></para>
  <para style="s">पवीतर जेवन</para>
  <para style="r">(<ref loc="MAT 26:26-30">मत्ती 26:26-30</ref>; <ref loc="MRK 14:22-26">मरकुस 14:22-26</ref>; <ref loc="1CO 11:23-25">1 कुरिन्थियो 11:23-25</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="LUK 22:14"/>जबा बेरा भयो, तबा यीसु चेला गीनको संग जेवन लाय बस्यो। <verse eid="LUK 22:14"/><verse number="15" style="v" sid="LUK 22:15"/>यीसु ना उनलक कव्हयो, “मोरो दिल मा यो गोस्टी होत्यो, का मी को बलिदान तिहार मा तुमारो संग मा जेऊ। <verse eid="LUK 22:15"/><verse number="16" style="v" sid="LUK 22:16"/>काहेका जबा तकन परमेस्वर को, राज पूरो रिती लक नहि आ जाहेत, मी मंग जेवन नहि करु।”<verse eid="LUK 22:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="LUK 22:17"/>एको मंघा यीसु ना बटकी लियो, अना परमेस्वर ला धनवाद देके कव्हयो “एला, आपसी मा बाट लेने <verse eid="LUK 22:17"/><verse number="18" style="v" sid="LUK 22:18"/>काहेका मि तूमी लक कव्हसू, का अज को मघा जबा तकन परमेस्वर को राज पूरी रिति लक नही आ जाहेत, मी अंगूर रस नही पिवन को।”<verse eid="LUK 22:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="LUK 22:19"/>यीसु ना भाकर लियो अखीन, परमेस्वर लक पिराथना करके चेलागिन ला भाकर दियो, अखीन सांगीस यो मोरी देह आय, मोरो हेत करन को लाय असोच करने। <verse eid="LUK 22:19"/><verse number="20" style="v" sid="LUK 22:20"/>यो जेवन को बाद मा यो सांगत बटकी दियो अना कहो, “यो बटकी मोरो रकत को वायदा को नवतो करार सेत जो तुमरो लाई बहायो गयो से।”<verse eid="LUK 22:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="LUK 22:21"/>चोवो! जोन पातर मा जेवसे, वोच मा छेद करन वारा मोरो, संग से अखीन वोको हात ठाव मा से<note caller="+" style="f"><char style="fr" closed="false">22:21 </char><char style="ft" closed="false">भजन 41:9 मोरो संग उ से जोन मोला धराहेत।</char></note>। <verse eid="LUK 22:21"/><verse number="22" style="v" sid="LUK 22:22"/>काहेका मानूस को टूरा ता जसो वोको लाय पक्को, करयो गयो से वसोच होहेत। “पर धिक्कार से वो मानूस ला, जो वोला धराय रहीसेस।”<verse eid="LUK 22:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="LUK 22:23"/>वोना एक दूजो लक पूसन लग्यो का, हमी लोक गीनमा कोन सेत?<verse eid="LUK 22:23"/></para>
  <para style="s">मोठयो कोन सेत?</para>
  <para style="p">
    <verse number="24" style="v" sid="LUK 22:24"/>चेला गीन मा विवाद बड़ गयो का, हमरो मा मोठयो कोन से?<note caller="+" style="f"><char style="fr" closed="false">22:24</char><char style="ft" closed="false">मत्ती 18:1 आमरो मा मोठो कोन से?</char></note> <verse eid="LUK 22:24"/><verse number="25" style="v" sid="LUK 22:25"/>तबा यीसु ना कव्हयो, “गैरयहुदी लोकिगीन को, राजा उन पर सासन करासे, अना जोन उन पर अधिकार राखासे, उ उपकार करन वालो कहलावासे”<note caller="+" style="f"><char style="fr" closed="false">22:25</char><char style="ft" closed="false">जोनको हात मा बिधि से उ ताकतवर उपकार करन वालो सेत।</char></note>। <verse eid="LUK 22:25"/><verse number="26" style="v" sid="LUK 22:26"/>पर तुमी असो नोको होवने, पर जो तुमरो मा मोठयो से, उ लहान जसो अना जो मुखिया से उ सेवा करन वालो को जसो बनेत। <verse eid="LUK 22:26"/><verse number="27" style="v" sid="LUK 22:27"/>कायलाई का मोठयो कोन से, जो जेवन करन बस्यो से? का उ जोन सेवा करासे ? का उ नही जो जेवन करन बसो सेस? पर मी तुमारो बीचमा नौकर जसो सेव।<verse eid="LUK 22:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="LUK 22:28"/>पर तुम्ही मोरो परिक्सा मा, हमेसा मोरो सगं रहयो। <verse eid="LUK 22:28"/><verse number="29" style="v" sid="LUK 22:29"/>अना जसो परमेस्वर ना मोरो लाय एक राज ठयरायो से। <verse eid="LUK 22:29"/><verse number="30" style="v" sid="LUK 22:30"/>वसोच मी तुमारो लाया ठयरावासू, जोन लक तुम्ही मोरो राज मा मोरो संग राजगद्दी मा बसो, संग जेवन करो, अना इसरायल राज को 12 गोत को नियायी<note caller="+" style="f"><char style="fr" closed="false">22:30</char><char style="ft" closed="false">मत्ती 19:28; जोन पिरभू को संग बनयो से, उ न्याय करन काबील होहेत</char></note> बन जाओ।<verse eid="LUK 22:30"/></para>
  <para style="s">पतरस को मुकरन को बारे मा सांगनो</para>
  <para style="r">(<ref loc="MAT 26:31-35">मत्ती 26:31-35</ref>; <ref loc="MRK 14:27-31">मरकुस 14:27-31</ref>; <ref loc="JHN 13:36-38">योहन 13:36-38</ref>)</para>
  <para style="p">
    <verse number="31" style="v" sid="LUK 22:31"/>पतरस ओ समौन चोव सैतान ना तुम्ही लोग गीनला मांग लियो से का गँहु जसो तुम्ही ला फटके। <verse eid="LUK 22:31"/><verse number="32" style="v" sid="LUK 22:32"/>पर मी तोरो लाय पिराथना करूसेव का तोरो भरोसा, ना चलो जाय, अना जबा, तु वापस आवजोस, ता आपरो संगी भाऊ गीनला थामजोस।<verse eid="LUK 22:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="LUK 22:33"/>पतरस ना वोला कहीस, का पिरभू!मी तोरो संग मा जेल जान लाय अखीन मरन लाय राजी सेव।<verse eid="LUK 22:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="LUK 22:34"/>पर यीसु न कव्हयो, पतरस मी तोरो लक कव्हसू का आज कुकड़ा को चिल्वनो को पूढा, तू मोला तीन बार नकारजोस।<verse eid="LUK 22:34"/></para>
  <para style="s">पीवसी झोला अना तरवार</para>
  <para style="p">
    <verse number="35" style="v" sid="LUK 22:35"/>यीसु ना चेला गीनला कहीस, जबा मीना पियुसी, झोला अखीन सेंडिल को, बिना धाड़यो होतो तबा,</para>
  <para style="p" vid="LUK 22:35">“काही चीज की कमी भई का?”<note caller="+" style="f"><char style="fr" closed="false">22:35 </char><char style="ft" closed="false">काही नही होतो पर कोनी कमी नही हुयो। </char></note><verse eid="LUK 22:35"/></para>
  <para style="p">
    <verse number="36" style="v" sid="LUK 22:36"/>वय जवाब देईन का कोनी चीज की नहीं, एतरो पर यीसु ना कव्हयो, पर अबा मी कव्हसू अबा जेनको, कठा पियुसी से वोला धर लेव वसोच, झोला अखीन तरवार आपरो झंगा बिक केना आनलो। <verse eid="LUK 22:36"/><verse number="37" style="v" sid="LUK 22:37"/>काहे का मी तुम्ही लक कव्हसू, का यो जोन लिखयो से का उ दोसीगीन को संग गिनो गयो<note caller="+" style="f"><char style="fr" closed="false">22:37</char><char style="ft" closed="false">यसायाह 53:12 उ बुरा करन वालो को संग गिनयो गयो।</char></note>। वोको मोरो पर पूरो होवनो जरुरी से, काहेका मोरो बारे मा यो गोस्टी पूरो होवनो पर सेत।<verse eid="LUK 22:37"/></para>
  <para style="p">
    <verse number="38" style="v" sid="LUK 22:38"/>उनमा कव्हयो, हे पिरभू चोव यहान दोन तरवार सेत! वोना कव्हयो लगत से?<verse eid="LUK 22:38"/></para>
  <para style="s">जैतून पहाड़ मा यीसु को पिराथना</para>
  <para style="r">(<ref loc="MAT 26:31-35">मत्ती 26:31-35</ref>; <ref loc="MRK 14:27-31">मरकुस 14:27-31</ref>; <ref loc="JHN 13:36-38">योहन 13:36-38</ref>)</para>
  <para style="p">
    <verse number="39" style="v" sid="LUK 22:39"/>तबा उ बाहेर हिटके आपरो आदत लक जैतून पहाड़ मा गयो अना चेला गीन, उनको मंघा भई गइन। <verse eid="LUK 22:39"/><verse number="40" style="v" sid="LUK 22:40"/>वोना जघा पहूचकेना वोना उन लक, कव्हयो तुम्ही परिक्सा मा नोको, पडजोस यो काजी पिराथना करो।<verse eid="LUK 22:40"/></para>
  <para style="p">
    <verse number="41" style="v" sid="LUK 22:41"/>तबा उ काही जरासो दूरी बनाय के, ना चेला गीन लगी अलग पिराथना करन लग्यो। <verse eid="LUK 22:41"/><verse number="42" style="v" sid="LUK 22:42"/>हे परमेस्वर मोरो बाप, यदि तोरी इक्सा से तो यो दुख ला मोरो पूढा लक हटाय, ले। मंग मोरो नही तोरो मनसा, मोरो जीवन मा पूरो होहे। <verse eid="LUK 22:42"/><verse number="43" style="v" sid="LUK 22:43"/>तबा यीसु ला एक सरगदूत दिख्यो, जोना, वोला ताकत देतो रहयो। <verse eid="LUK 22:43"/><verse number="44" style="v" sid="LUK 22:44"/>यीसु संकट लक दूखी भय गयो अखीन गजब दूखी मन लक परमेस्वर लक पिराथना करन लग्यो। अखीन वोको पसी रकत को बुन्द जसो, थेम-थेम जघा मा टपकन लगीन।<verse eid="LUK 22:44"/></para>
  <para style="p">
    <verse number="45" style="v" sid="LUK 22:45"/>तबा उ पिराथना करके ना उठयो, तबा आपरो चेला गीन, को जवर आयो चेला गीन उदास मन लक सो रहयो होतीन, तबा यीसु ना कव्हयो, तुमी काहेला सोवसो। <verse eid="LUK 22:45"/><verse number="46" style="v" sid="LUK 22:46"/>उठो अखीन पिराथना करो, क तुम्ही परिक्सा मा नोको पड़ो।<verse eid="LUK 22:46"/></para>
  <para style="s">यीसु ला धोका लक पकड़वानो</para>
  <para style="r">(<ref loc="MAT 26:47-56">मत्ती 26:47-56</ref>; <ref loc="MRK 14:43-50">मरकुस 14:43-50</ref>; <ref loc="JHN 18:3-12">योहन 18:3-12</ref>)</para>
  <para style="p">
    <verse number="47" style="v" sid="LUK 22:47"/>तबा उ कव्हत होतो का एक भीड़ को, पूढा-पूढा, यीसु को चेला यूदस आयो, उ यीसु को कना चूमा लेवन काजी, बढयो। <verse eid="LUK 22:47"/><verse number="48" style="v" sid="LUK 22:48"/>तबा यीसु ना कव्हयो हे यूदस का तू चुम्मा लेयके, मानूस को टूरा धरा रहोसे।<verse eid="LUK 22:48"/></para>
  <para style="p">
    <verse number="49" style="v" sid="LUK 22:49"/>तबा यीसु को चेला गीन कव्हन लगीन, पिरभू का हमी तरवार चलाबीन? <verse eid="LUK 22:49"/><verse number="50" style="v" sid="LUK 22:50"/>अखीन उनमा लक एक ना तरवार कहाडके ना मुखिया पुजारी को, दास को जेवनो कान उड़ाय देईस।<verse eid="LUK 22:50"/></para>
  <para style="p">
    <verse number="51" style="v" sid="LUK 22:51"/>तबा यीसु न कव्हयो बंद करो<note caller="+" style="f"><char style="fr" closed="false">22:51</char><char style="ft" closed="false">यहाँन तकन रव्हन देव। </char></note> यो खून खराबा, अखीन वोको कान ला, वोको जगहा मा धरके ना, साजरो कर दियो।<verse eid="LUK 22:51"/></para>
  <para style="p">
    <verse number="52" style="v" sid="LUK 22:52"/>तबा यीसु ना मुखिया पुजारी अखीन, मंदिर को रक्सक को मुखीया, अना सयानो गीन, जो वोना भीड़ मा लाठी-वाठी तरवार धरके ना आयो होतिन, उनला कव्हयो का तुम्ही मोला, डाकू वाकू समझकेन, हथीयार धर के मोला मारन आयीसेव। <verse eid="LUK 22:52"/><verse number="53" style="v" sid="LUK 22:53"/>जबा मी मंदिर मा हर रोज तुमारो, संग होतो तबा तुमना मोला नही धरयात<note caller="+" style="f"><char style="fr" closed="false">22:53 </char><char style="ft" closed="false">लूका 19:47;21:37 मोला नही धरयो</char></note> पर यो तुमारो बेरा से, वोका पर इन्धारो को अधिकार से। मतलब मोला मालूम से का सैतान मोरो, संग काजक करन वालो से।<verse eid="LUK 22:53"/></para>
  <para style="s">पतरस को मुकरनो</para>
  <para style="r">(<ref loc="MAT 26:57">मत्ती 26:57</ref>,<ref loc="MAT 26:58">58</ref>,<ref loc="MAT 26:69-75">69-75</ref>; <ref loc="MRK 14:53">मरकुस 14:53</ref>,<ref loc="MRK 14:54">54</ref>,<ref loc="MRK 14:66-72">66-72</ref>; <ref loc="JHN 18:12-18">योहन 18:12-18</ref>,<ref loc="JHN 18:25-27">25-27</ref>)</para>
  <para style="p">
    <verse number="54" style="v" sid="LUK 22:54"/>मंग वोला धरकेना, मुखिया याजक को घर मा पहूचा देइन। पतरस काही दूरी बनाय के, ना यीसु को मघा-मघा जावन लग्यो। <verse eid="LUK 22:54"/><verse number="55" style="v" sid="LUK 22:55"/>अखीन आँगन मा अघेटा पेटायो होतीन, वहांच पतरस उनको बीच मा जायके बस गयो। <verse eid="LUK 22:55"/><verse number="56" style="v" sid="LUK 22:56"/>एक टूरी जो उनकी दासी होती पतरस ला, स्तो को उजाड़ो मा, चोवके ना कव्हन लगीस, यो भी वोको संग होतो।<verse eid="LUK 22:56"/></para>
  <para style="p">
    <verse number="57" style="v" sid="LUK 22:57"/>पर पतरस मना करके ना कव्हासे, बाई मी वोला नही जानासू।<verse eid="LUK 22:57"/></para>
  <para style="p">
    <verse number="58" style="v" sid="LUK 22:58"/>जरा देर को मघा कोनी दूसरो ना पतरस ला चोवके कव्हयो, “तू भी वोमा लोक गीनको संगी मा लक एक आस! पतरस ना कव्हयो, नही भाऊ मी नही सेउ।”<verse eid="LUK 22:58"/></para>
  <para style="p">
    <verse number="59" style="v" sid="LUK 22:59"/>एक तासको बाद मा कोनी मानूस ना पक्को चीन्ह केना कव्हयो “खरो खर यो वोको संग होतो काहेका, यो भी गलीली मानूस से।”<verse eid="LUK 22:59"/></para>
  <para style="p">
    <verse number="60" style="v" sid="LUK 22:60"/>पतरस ना कव्हयो “हुट भाऊ, मी नही जानासू, का तुम्ही काजक सागसो?” उ जसो बोल रहयो होतो।</para>
  <para style="p" vid="LUK 22:60">वसोच कुकड़ा ना चील्लायो, कोक रे कोक। <verse eid="LUK 22:60"/><verse number="61" style="v" sid="LUK 22:61"/>अना पीरभू ना लवट के पतरस कना चोवयो, तबा पतरस ला हेत आयो का पिरभू ना वोला, काय कव्हयो होतो? का अज कुकड़ा को चिल्लान को पूढा तो मोरो, तीन बेरा मुकर करजोस। <verse eid="LUK 22:61"/><verse number="62" style="v" sid="LUK 22:62"/>अना उ बाहेरे हिटके ना बिलख-बिलख के रोवन लग्यो।<verse eid="LUK 22:62"/></para>
  <para style="s">यीसु को बेइज्जती</para>
  <para style="r">(<ref loc="MAT 26:67">मत्ती 26:67</ref>,<ref loc="MAT 26:68">68</ref>; <ref loc="MRK 14:65">मरकुस 14:65</ref>)</para>
  <para style="p">
    <verse number="63" style="v" sid="LUK 22:63"/>यीसु को पहरा देवन वालो सीपाही गीन, यीसु ला मजाक मा उड़ान लगीन अखीन वोला मारन पीटन लगीन। <verse eid="LUK 22:63"/><verse number="64" style="v" sid="LUK 22:64"/>ओनो डोरा मा पट्टी बान्धके ना वोला मारत होतिन अना कव्हत होतीन, का आवन वारो गोस्टी सांग अबा तोला कोन ना मारेत।<verse eid="LUK 22:64"/></para>
  <para style="s">पंचायत मा यीसु</para>
  <para style="r">(<ref loc="MAT 26:59-66">मत्ती 26:59-66</ref>; <ref loc="MRK 14:55-64">मरकुस 14:55-64</ref>; <ref loc="JHN 18:19-24">योहन 18:19-24</ref>)</para>
  <para style="p">
    <verse number="65" style="v" sid="LUK 22:65"/>अखीन उनना योको गजब निन्दा करके ना, वोको विरोध मा गजब गोस्टी सांगन लगीन। <verse eid="LUK 22:65"/><verse number="66" style="v" sid="LUK 22:66"/>जबा दिवस हिटयो ता गजब सयानो, अना मुखिया याजक मोसे को नियम को गुरू गीन लेखक, इक्कठो भईन अना वोला, आपरो पंचायत मा आनके पुसन लगीन।<verse eid="LUK 22:66"/></para>
  <para style="p">
    <verse number="67" style="v" sid="LUK 22:67"/>अदी तुम्ही मसीह सेव ता हमला सांग!</para>
  <para style="p" vid="LUK 22:67">अना उनना कहीस, यदि मी तुम्ही लक कँहू ता, भरोसा नही करबीन। <verse eid="LUK 22:67"/><verse number="68" style="v" sid="LUK 22:68"/>अना यदि मी पुसू ता जवाब नही देवजोस। <verse eid="LUK 22:68"/><verse number="69" style="v" sid="LUK 22:69"/>पर अता मानूस को टूरा सबा लक मोठो, ताकत को परमेस्वर को उज्जो बस्यो चोवने।<verse eid="LUK 22:69"/></para>
  <para style="p">
    <verse number="70" style="v" sid="LUK 22:70"/>एतरो पर सप्पा को सप्पा सांगन लगीन, ता का तूच परमेस्वर को टूरा आस?</para>
  <para style="p" vid="LUK 22:70">यीसु ना जवाब दियो तुम्ही कव्हासो का मीच आँव!<verse eid="LUK 22:70"/></para>
  <para style="p">
    <verse number="71" style="v" sid="LUK 22:71"/>येको पर उनना कव्हयो “अबा आमला अखीन गवाही को, का जरुरत से?” आमी ना ता खुद वोकोच तोन्ड लक आयकसेजन।<verse eid="LUK 22:71"/></para>
  <chapter eid="LUK 22"/>
  <chapter number="23" style="c" sid="LUK 23"/>
  <para style="s">पिलातूस राजा को पूढा यीसु</para>
  <para style="r">(<ref loc="MAT 27:1">मत्ती 27:1</ref>,<ref loc="MAT 27:2">2</ref>,<ref loc="MAT 27:11-14">11-14</ref>; <ref loc="MRK 15:1-5">मरकुस 15:1-5</ref>; <ref loc="JHN 18:28-38">योहन 18:28-38</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 23:1"/>तबा सबा पंचायत उभो भय गइन, अखीन पिलातुस न्यायी को कठा ला गइन। <verse eid="LUK 23:1"/><verse number="2" style="v" sid="LUK 23:2"/>अना सबा असो दोस लगावन लगीन, का यो राजा कैसर ला जमा देवन लाय मना करासे, अखीन आपरो आप ला राजा कव्हासे, अना लोग लोक गीनला राजा को खिलाफ भड़कावसे।<verse eid="LUK 23:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="LUK 23:3"/>तबा पिलातुस न्यायी ना पूसयो का यो बात खरो सेत? का तू यहूदी लोकी को राजा आस?</para>
  <para style="p" vid="LUK 23:3">तबा यीसु ना कव्हयो, तू खुदच सांगासे।<verse eid="LUK 23:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="LUK 23:4"/>तबा पिलातुस ना मोसे को नियम को गुरू अना, मुखिया याजक लोक गीनला सांगीस, मोला यो मानूस मा काही खोट नही चोवासे।<verse eid="LUK 23:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="LUK 23:5"/>पर वय मजबूती लक सांगीन, यो गलील परदेस लक सबा यहुदिया मा उपदेस देके ना, लोकगीन ला उकसावासे। <verse eid="LUK 23:5"/><verse number="6" style="v" sid="LUK 23:6"/>यो आयक के पिलातुस ना पुसयो, का यो गलीली मानूस आय? <verse eid="LUK 23:6"/><verse number="7" style="v" sid="LUK 23:7"/>अना यो जानके का यो राजा हेरोदेस को राज को अधिकार मा सेत, वोना वोला राजा हेरोदेस को कठा धाड़ीस, काहेका उ वोना दिवस मा येरुसलेम नगर मा होतो।<verse eid="LUK 23:7"/></para>
  <para style="s">राजा हेरोदेस को पूढा यीसु</para>
  <para style="p">
    <verse number="8" style="v" sid="LUK 23:8"/>राजा हेरोदेस ना यीसु ला चोवके गजब खुसी भयो, काहेका वोला गजब दिवस लक चोवन को आस होत्यो। काहेका व आयको होतो का यीसु गजब अचंभा भरो निसान चोवासेत। <verse eid="LUK 23:8"/><verse number="9" style="v" sid="LUK 23:9"/>उ वोको लक गजब सवाल करत रहयो, पर यीसु उघा मुघा रहयो। <verse eid="LUK 23:9"/><verse number="10" style="v" sid="LUK 23:10"/>अना पुरोहित अना मोसे को नियम को गुरू, मुखिया याजक देह मन लक वोको, पर दोस मढन लगीन। <verse eid="LUK 23:10"/><verse number="11" style="v" sid="LUK 23:11"/>तबा राजा हेरोदेस ना आपरो सीपाही गीनको संग, वोला खरो-खोटो कव्हके वोको मजाक उड़ाइन, अना माजाकी कपरा घालके वोला, पिलातुस न्यायी को जवर लवटा देइन। <verse eid="LUK 23:11"/><verse number="12" style="v" sid="LUK 23:12"/>वोच दिवस लक न्यायी पिलातुस अना राजा हेरोदेस संगी-संगी बन गइन, एको मंघा एकमेक को बैरी होतिन।<verse eid="LUK 23:12"/></para>
  <para style="s">पिलातुस कन लक यीसु ला पिरान दन्ड देवनो</para>
  <para style="r">(<ref loc="MAT 27:15-26">मत्ती 27:15-26</ref>; <ref loc="MRK 15:6-15">मरकुस 15:6-15</ref>; <ref loc="JHN 18:39">योहन 18:39</ref>; <ref loc="JHN 19:16">19:16</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="LUK 23:13"/>पिलातुस न मोसे को नियम को गुरू अना मुखिया याजकगीन ला बुलाके सांगयो, <verse eid="LUK 23:13"/><verse number="14" style="v" sid="LUK 23:14"/>“तुम्हिना यो मानूस ला जनता ला, बहकावन वालो सांग के ना मोरो कठा आनी सेव, अना मीना तुमरो पूढा जायके यो मानूस मा जाँच करयो, अना एकोमा कोनी खोट नही पाइसेव। <verse eid="LUK 23:14"/><verse number="15" style="v" sid="LUK 23:15"/>न राजा हेरोदेस ना, काहेका वोना वोला मोरो कठा धाड़ देइसेस, अना चोवो, मी वोको मा असो खोट नही पायोसेऊ, का वोला पिरान दन्ड दियो जायेत। <verse eid="LUK 23:15"/><verse number="16" style="v" sid="LUK 23:16"/>यो काजी मी वोला, पिटवा केना सोड़ देसू।” <verse eid="LUK 23:16"/><verse number="17" style="v" sid="LUK 23:17"/>काहे का यो तिहार मा एक कैदी ला सोड़नो जरुरी<note caller="+" style="f"><char style="fr" closed="false">23:17</char><char style="ft" closed="false">सोड़ने को लाय मजबूर होवना</char></note> होत्यो।<verse eid="LUK 23:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="LUK 23:18"/>पर सप्पा चिलावन लगीन, का अमरो काजी बरब्बा नाव को कैदी ला, सोड़ देव अना येला मार डाको। <verse eid="LUK 23:18"/><verse number="19" style="v" sid="LUK 23:19"/>बरब्बा कोनी झगड़ा को कारन लक, बन्दी घर मा टाक दियो होत्यो।<verse eid="LUK 23:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="LUK 23:20"/>पर राजा पिलातुस ना यीसु ला, सोड़न को मनसा लक, जनता ला अखीन समजायो। <verse eid="LUK 23:20"/><verse number="21" style="v" sid="LUK 23:21"/>पर जनता चिलान लगीन, का “ वोला कूरूस मा चघावो! कूरूस मा चघावो!”<verse eid="LUK 23:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="LUK 23:22"/>राजा ना तिसरो बार कव्हयो, “काहे यो मा कोनतो, खोट सेत?” मीना वोको मा कूरूस मा चघावन को लाय कोनी गोस्टी नही पाई सेव! एकोलाय मी वोला, पिटावाये केना सोड़ा सेऊ।<verse eid="LUK 23:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="LUK 23:23"/>पर जनता चिल्ला चिल्लाके, वोको मंघा पड़गइन,</para>
  <para style="p" vid="LUK 23:23">अना चिल्लानो गजब बढ गयो। अना चिलावन लगीन का, वोला कूरूस पर चघावो। <verse eid="LUK 23:23"/><verse number="24" style="v" sid="LUK 23:24"/>तबा राजा पिलातुस ना हुकूम देइस, का उनको निरनय को अनूसार कियो जाय। <verse eid="LUK 23:24"/><verse number="25" style="v" sid="LUK 23:25"/>तबा बरब्बा जोन हिन्सा अना जानलक मारन को आरोप मा होतो वोला छोड़ देइस, अना यीसु ला उनको मनसा को लक उनला सोप देइस।<verse eid="LUK 23:25"/></para>
  <para style="s">यीसु ला कूरूस मा चघायो जानो</para>
  <para style="r">(<ref loc="MAT 27:32-44">मत्ती 27:32-44</ref>; <ref loc="MRK 15:21-32">मरकुस 15:21-32</ref>; <ref loc="JHN 19:17-27">योहन 19:17-27</ref>)</para>
  <para style="p">
    <verse number="26" style="v" sid="LUK 23:26"/>एक कुरेनी नगर को मानूस जोको नाव सिमोन होतो, उ गाव लक आ रहयो होतो। वोला धरकेना वोको पर कूरूस ला लाद देइन, अना वोला यीसु को मंघा मंघा चलन को हुकूम देइन।<verse eid="LUK 23:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="LUK 23:27"/>जनता को गजब भीड़ उनको मंघा- मंघा चल रहयो होतिन। उनमा काही आई माई होतिन, जो आपरो छाती पीटत वोको लाय रोवत होतिन। <verse eid="LUK 23:27"/><verse number="28" style="v" sid="LUK 23:28"/>यीसु ना उनको कन मुरक के कव्हयो, वो येरुसलेम नगर को टूरी तुम्ही मोरो लाई नोको, रड़ो पर आपरो लाय अना आपरो, लेकरा गीन लाई रोओ। <verse eid="LUK 23:28"/><verse number="29" style="v" sid="LUK 23:29"/>काहेका उ दिवस आय आहेती, जबा लोक गीन कहेत का वा बायको धन्य से जो वाखाड से, अना लेकरा को जलम पासुन दुध नही पिवाइसेस। <verse eid="LUK 23:29"/><verse number="30" style="v" sid="LUK 23:30"/>तबा लोक गीन पहाड़ी ला कहेत, का आमरो पर पहाड़ी पड़ जाय अना पहाड़ ला कहेत, का हमला ढाक लेव।<note caller="-" style="x"><char style="xo" closed="false">23:30 </char><char style="xt" closed="false"><ref loc="HOS 10:8">होसे 10:8</ref>; <ref loc="REV 6:16">परकासित वाक्य 6:16</ref></char></note> <verse eid="LUK 23:30"/><verse number="31" style="v" sid="LUK 23:31"/>काहे का यदि कोनी हरो-भरो झाड लक असो करासेत, ता वोको सूक्को काड़ी को काजक हाल होवते।<verse eid="LUK 23:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="LUK 23:32"/>वय यीसु को संग दूई आपराधी गीन ला मारन लाय ले गइन। <verse eid="LUK 23:32"/><verse number="33" style="v" sid="LUK 23:33"/>वय कवटी नाव की जघा मा पहूचीन वहान, उनना यीसु ला अना दोन अपराधी इनला कूरूस पर चघाइन, एक ला वोको उज्जो कन अना दुजो ला डाख्या कना। <verse eid="LUK 23:33"/><verse number="34" style="v" sid="LUK 23:34"/>यीसु ना कहीस, हे बाबूजी इनला, छिमा कर काहेका यो नही जानासे, का यो काजक कर रहीसेत,</para>
  <para style="p" vid="LUK 23:34">तबा उनना चिठ्ठी टाक केना यीसु का कपरा ला आपस मा बाट लेइन<note caller="+" style="f"><char style="fr" closed="false">23:34 </char><char style="ft" closed="false">जुआ खेले; भजन 22:18</char></note>। <verse eid="LUK 23:34"/><verse number="35" style="v" sid="LUK 23:35"/>जनता उभी होयके यो सब चोय रही होतीन। मुखिया गीन यो कहके, <note caller="+" style="f"><char style="fr" closed="false">23:35 </char><char style="ft" closed="false">मजाक; भजन 22:7</char></note> येसु को मजाक करत होतीन, का वोना दूसरो ला बचाइसेस। यदि यो परमेस्वर को मसीह से अना यदि परमेस्वर येला बेचयो सेस, ता यो आपरो आप ला बचाये।<verse eid="LUK 23:35"/></para>
  <para style="p">
    <verse number="36" style="v" sid="LUK 23:36"/>सीपाही गीन मजाक करन लगीन, वोना वोला सिरका देता<note caller="+" style="f"><char style="fr" closed="false">23:36 </char><char style="ft" closed="false">अंगूर का कड़वा रस </char></note> कव्हन लगीन। <verse eid="LUK 23:36"/><verse number="37" style="v" sid="LUK 23:37"/>यदि तू यहूदिगीन को राजा आस, ता आपरो आप ला बचाव।<verse eid="LUK 23:37"/></para>
  <para style="p">
    <verse number="38" style="v" sid="LUK 23:38"/>येसु को कूरूस पर भी लिखयो होत्यो। “यो यहूदी गीन को राजा से।”<verse eid="LUK 23:38"/></para>
  <para style="s">मन बदलनवालो पापी</para>
  <para style="p">
    <verse number="39" style="v" sid="LUK 23:39"/>कूरूस पर टगों एक खोटो काम करन वालो यीसु निन्दा करके, ना कव्हन लगीस, तू मसीह आस ना? ता खुद बच अना हमला बचाव।<verse eid="LUK 23:39"/></para>
  <para style="p">
    <verse number="40" style="v" sid="LUK 23:40"/>पर दूसरो न वोला डटकार देईस अखीन कव्हयो, का तोला परमेस्वर को भेव नहात? तू भी वोच दन्ड भोग रहयो सेस, जोन वोला मीलो से? <verse eid="LUK 23:40"/><verse number="41" style="v" sid="LUK 23:41"/>पर हमी आपरो करनी को दन्ड पाय रही सेजन, पर यो तो नेक से। <verse eid="LUK 23:41"/><verse number="42" style="v" sid="LUK 23:42"/>तबा यीसु ला कहीस येसु जब तोरो राज आहेत तो मोला हेत राखजोस।<verse eid="LUK 23:42"/></para>
  <para style="p">
    <verse number="43" style="v" sid="LUK 23:43"/>येसु ना वोला कहीस, मी तोरो लक खरो, सागांसू का आजच तू सरग मा मोरो संग होवजोस।<verse eid="LUK 23:43"/></para>
  <para style="s">यीसु को पिरान तजनो</para>
  <para style="r">(<ref loc="MAT 27:45-56">मत्ती 27:45-56</ref>; <ref loc="MRK 15:33-41">मरकुस 15:33-41</ref>; <ref loc="JHN 19:28-30">योहन 19:28-30</ref>)</para>
  <para style="p">
    <verse number="44" style="v" sid="LUK 23:44"/>दोफारी को बेरा होतो वोना बखत तीसरो पहर मा सप्पा देस मा इन्धार छाय गयो। <verse eid="LUK 23:44"/><verse number="45" style="v" sid="LUK 23:45"/>दिनो उजयारी चेले गयो अना मंदिर को पड़दा<note caller="+" style="f"><char style="fr" closed="false">23:45 </char><char style="ft" closed="false">मंदिर को कपरा जोनमा पवीतर अखीन परम पवीतर जघा बेगरो रव्हासेत। </char></note> बीच लक फटके दोन टुकड़ा भय गयो। <verse eid="LUK 23:45"/><verse number="46" style="v" sid="LUK 23:46"/>यीसु ना ऊचो लक चिल्लायो हे दाअजी जी मी आपरो आतमा ला तोरो हात मा सोपसू<note caller="+" style="f"><char style="fr" closed="false">23:46</char><char style="ft" closed="false">आतमा परमेस्वर को जवर सौपना </char></note> अखीन वोको जान हिट गयो।<verse eid="LUK 23:46"/></para>
  <para style="p">
    <verse number="47" style="v" sid="LUK 23:47"/>सेना को मुखीया यो चोवके ना परमेस्वर को भजन बड़ाई करन लग्यो, अना कव्हयो खरो खर यो मानूस न्यायी होतो।<verse eid="LUK 23:47"/></para>
  <para style="p">
    <verse number="48" style="v" sid="LUK 23:48"/>गजब जनता यो चोवन लाय इक्कठो भय गयो होतो, उ सब यो चोवके ना अपरो मन मा रोवत ललावत लवट गइन। <verse eid="LUK 23:48"/><verse number="49" style="v" sid="LUK 23:49"/>यीसु को जान पहचान को लोक गीन दूहर उभो होतीन, अना उनमा काही आई-माई होतीन, वा गलील परदेस लक यीसु को मंघा-मंघा आई होतीन। अना यो सब चोवत होतीन।<verse eid="LUK 23:49"/></para>
  <para style="s">यीसु को गाड़ो जानो</para>
  <para style="p">
    <verse number="50" style="v" sid="LUK 23:50"/>यूसुफ नाव को एक भला मानूस होतो, वोको अँदर कोनी कपट नही होत्यो, अना उ नेक मानूस होतो। <verse eid="LUK 23:50"/><verse number="51" style="v" sid="LUK 23:51"/>वोको यो काम मा कोनी हात नही होतो, उ यहूदिगीन को परदेस अरिमितिया गाँव को निवासी होत्यो। अना उ परमेस्वर को राज को बाट जोहत होत्यो। <verse eid="LUK 23:51"/><verse number="52" style="v" sid="LUK 23:52"/>वोना राजा पिलातुस को कठा जायके, ना यीसु को लास ला मांग लेइस। <verse eid="LUK 23:52"/><verse number="53" style="v" sid="LUK 23:53"/>वोना लास ला कूरूस लक खाल्या उतार केना, मलमल को साजरो कफन मे लपेट केना, असो खोली जसो मरघट्टी मा ठेव दियो जहान कोनी ला नही राखयो होत्यो, उ कबर चट्टान मा खुदो होतो। <verse eid="LUK 23:53"/><verse number="54" style="v" sid="LUK 23:54"/>वोना दिवस सूकीरवार होतो, अना पवीतर दिवस सुरु होवन वोरो होतो।<verse eid="LUK 23:54"/></para>
  <para style="p">
    <verse number="55" style="v" sid="LUK 23:55"/>जोन आई माई गलील परदेस लक आयी होतीन, उनना यूसूफ को मघा-मघा जायके ना मरघट्टी ला चोवीन, का यीसु को लास ला कसो ठेयो गयो से?<verse eid="LUK 23:55"/></para>
  <para style="p">
    <verse number="56" style="v" sid="LUK 23:56"/>तबा उनना आयके सुगंधित चीज अना इतर तैय्यार करीन अखीन पवीतर दिवस मा हुकूम को लक आराम करीन।<verse eid="LUK 23:56"/></para>
  <chapter eid="LUK 23"/>
  <chapter number="24" style="c" sid="LUK 24"/>
  <para style="s">यीसु को जित्तो होवनो</para>
  <para style="r">(<ref loc="MAT 28:1-10">मत्ती 28:1-10</ref>; <ref loc="MRK 16:1-8">मरकुस 16:1-8</ref>; <ref loc="JHN 20:1-10">योहन 20:1-10</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 24:1"/>हफ्ता को पहलो दिवस मा दिवस उगन को पूढा, बेजा सुगंधित चीज इतर आन के तैय्यार करयो होतीन लेके मरघट्टी मा आइन। <verse eid="LUK 24:1"/><verse number="2" style="v" sid="LUK 24:2"/>अना उनना मरघट्टी को गोटा लुड़को पाइन, <verse eid="LUK 24:2"/><verse number="3" style="v" sid="LUK 24:3"/>अना खोली जसो कबर मा धसके चोवीन, पर पिरभू यीसु की लास नहोती। <verse eid="LUK 24:3"/><verse number="4" style="v" sid="LUK 24:4"/>वा ऐना बात ला चोवके चकीत भई गइन, तबा दोन मानूस चमकतो जामा घालयो उनको जवर आयके उभो भय गइन। <verse eid="LUK 24:4"/><verse number="5" style="v" sid="LUK 24:5"/>जबा वय थरथराय के जमीन कना नजर ला खाल्या करके उनना उनला कहीन, का तुम्ही जित्तो ला मरया हुवा मा काहे ढुडासेव? <verse eid="LUK 24:5"/><verse number="6" style="v" sid="LUK 24:6"/>उ यहान नहात पर मरयो हुयो जित्तो भय गईसे, अना हेत करो का वोना गलील मा रव्हतो बेरा काजक कव्हयो होतो? <verse eid="LUK 24:6"/><verse number="7" style="v" sid="LUK 24:7"/>का यो जरुरी से, का मानूस को टूरा पापी लोक गीनको, हात लक धरयो जाहे अना कूरूस पर चघावो जाहे, अना परो को दिवस जित्तो भय जाहे।<verse eid="LUK 24:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="LUK 24:8"/>तबा उनला वोको यो गोस्टी हेत आई। <verse eid="LUK 24:8"/><verse number="9" style="v" sid="LUK 24:9"/>तबा मरघट्टी लक लवट केना, उनना वय अकरा लोक गीनला अना सबला गोस्टी कहीन, अखीन आयकवाइन। <verse eid="LUK 24:9"/><verse number="10" style="v" sid="LUK 24:10"/>जोन चेलागीन लक यो गोस्टी कहीन, कबर मा जान वालो आई-माई वा मरियम मगदलीनी अना योअन्ना अखीन याकूब की माय मरियम अना लगत आई-माई होतीन। <verse eid="LUK 24:10"/><verse number="11" style="v" sid="LUK 24:11"/>पर उनला यो गोस्टी किस्सा-कन्था जसो लग्यो, यो काजी उनना उनको भरोसा नही करीन। <verse eid="LUK 24:11"/><verse number="12" style="v" sid="LUK 24:12"/>तबा पतरस उभो भयो अना मरघट्टी चोवन काजी पराय गयो, अना उ वोनो होयके, चोयो वहान पर कफन च होतो, जोन भयो वोला सोचत-सोचत अचंभा करत आपरो घर चलो गयीन।<verse eid="LUK 24:12"/></para>
  <para style="s">इम्माऊस ला जानो</para>
  <para style="r">(<ref loc="MRK 16:12">मरकुस 16:12</ref>,<ref loc="MRK 16:13">13</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="LUK 24:13"/>वोच दिवस उन मा लक दुई जन इम्माऊस नाव को गाँव मा जावत होतीन, उ गाँव येरुसलेम नगर लक कोनी अकरा किलो मीटर दुहुर होतो। <verse eid="LUK 24:13"/><verse number="14" style="v" sid="LUK 24:14"/>अना यो सबा घटना जो येरुसलेम नगर मा हुयो होतो, वोच मा आपस मा बातचीत करत होतीन। <verse eid="LUK 24:14"/><verse number="15" style="v" sid="LUK 24:15"/>जबा वय आपस मा बात करत होतिन, तबच यीसु उनको संग-संग चलन लगयो। <verse eid="LUK 24:15"/><verse number="16" style="v" sid="LUK 24:16"/>पर उनको डोरा ला असो बंद कर दियो होतो, का वय वोला नही चीन्ह सकिन। <verse eid="LUK 24:16"/><verse number="17" style="v" sid="LUK 24:17"/>वोना उनला पुसयो तुम्ही आपस मा चलत-चलत काजक बोलासो गा?</para>
  <para style="p" vid="LUK 24:17">तबा वय उभो होयके उदास भय गईन। <verse eid="LUK 24:17"/><verse number="18" style="v" sid="LUK 24:18"/>यो आयक के क्लियूपास नाव को मानूस ना कव्हयो, का तम्ही येरुसलेम नगर मा एकलो परदेसी सेस, जोन यो नही जानासो का? येना दिवस मा काजक-काजक भयो से।<verse eid="LUK 24:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="LUK 24:19"/>यीसु ना उनला पुसयो कोनतो, बात गा?</para>
  <para style="p" vid="LUK 24:19">उनना वोको लक कव्हयो परमेस्वर को भविस्यवक्ता यीसु नासरी को बारे मा उ सबा लोक गीनको बीच परमेस्वर को काम अना गोस्टी ला <verse eid="LUK 24:19"/><verse number="20" style="v" sid="LUK 24:20"/>मोसे को नियम को गुरू अना मुखिया याजक ना वोला धरवाके, वोला जान लक मारन को दन्ड दिलवाइन अना कूरूस पर चघाय डाकिन <verse eid="LUK 24:20"/><verse number="21" style="v" sid="LUK 24:21"/>हमिला यो आस होत्यो का योच हमरो इसरायल लोक ला सूटकारा दिलाहेत, अना यो घटना परो को दिवस घटो होतो। <verse eid="LUK 24:21"/><verse number="22" style="v" sid="LUK 24:22"/>अमरो बीच लक काही आई-माई सक्कारी मरघट्टी मा गई होतीन, उनना हमला चकित कर देइन। <verse eid="LUK 24:22"/><verse number="23" style="v" sid="LUK 24:23"/>वोना कव्हत होतीन, का लास गायब से अना, सरगदूत ना हमला सांगिसेस का यीसु जित्तो से। <verse eid="LUK 24:23"/><verse number="24" style="v" sid="LUK 24:24"/>तबा हमरा संगी गीन मरघट्टी मा गईन, अना उनना चोइन का खरो-खर, लास गायब से।<verse eid="LUK 24:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="LUK 24:25"/>तबा यीसु कव्हासेत, हे कम भरोसा को, तुमरी अक्कल मा गोटा पड गयो का, तुम्ही भविस्यवक्ता गीन पवीतर गीरंथ ला नही समजासो? <verse eid="LUK 24:25"/><verse number="26" style="v" sid="LUK 24:26"/>का यो जरुरी नहात? का मसीह यो सबा दुख उठायके, महिमा मा जाय। <verse eid="LUK 24:26"/><verse number="27" style="v" sid="LUK 24:27"/>तबा यीसु ना मोसे गुरूजी अना, सब भविस्यवक्ता गीनको पवितर गीरंथ लक, वोको बारे मा जोन काही लिख्यो से उ सबा समजाय दियो।<verse eid="LUK 24:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="LUK 24:28"/>येतरो मा उनको गाँव आय गयो पर यीसु पुढा बढन लगयो। तबा <verse eid="LUK 24:28"/><verse number="29" style="v" sid="LUK 24:29"/>उनना यीसु ला कहिन, का गोधुली बेरा भय गईसे, अता तु हमरो घर मा रुक जा। <verse eid="LUK 24:29"/><verse number="30" style="v" sid="LUK 24:30"/>जबा उ उनको संग जेवन करन बस्यो, ता वोना भाकर लेय के परमेस्वर ला धन्य वाद देके तोड़िस, अना उनला देवन लग्यो। <verse eid="LUK 24:30"/><verse number="31" style="v" sid="LUK 24:31"/>तबा उनको डोरा उघड़ गयो अना उनना वोला चिन्ह लेइन। तबा उ वहान लक गायब हो गयो।<verse eid="LUK 24:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="LUK 24:32"/>उनना आपसी मा सांगन लगीन, जबा उ रस्ता म आमी लक, गोस्टी करत होतो अना पवितर गीरंथ लक सांगत होतो, ता हमरो मन मा खुसी होयेत होतो।<verse eid="LUK 24:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="LUK 24:33"/>वय वोच बेरा उभो भईन, अना येरुसलेम नगर लवट गइन, अना उन अकरा चेला अखीन उनको संगि गिनला जमा भयो पाइन।<verse eid="LUK 24:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="LUK 24:34"/>उ कव्हत होतिन पिरभू खरो-खर, मरयो हुयो जित्तो भयो से। अना वोको, चेला समौन ला चोविसेस।<verse eid="LUK 24:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="LUK 24:35"/>तबा उनना रस्ता को सकड्या गोस्टी उनना सांग दियो।<verse eid="LUK 24:35"/></para>
  <para style="s">यीसु चेलागिन ला दिसनो</para>
  <para style="r">(<ref loc="MAT 28:16-20">मत्ती 28:16-20</ref>; <ref loc="MRK 16:14-18">मरकुस 16:14-18</ref>; <ref loc="JHN 20:19-23">योहन 20:19-23</ref>; <ref loc="ACT 1:6-8">पेरीत 1:6-8</ref>)</para>
  <para style="p">
    <verse number="36" style="v" sid="LUK 24:36"/>वोना यो घटना को पर गोस्टी करत होतीन, का यीसु उनको बीच मा आयके, उभो भयो अना कव्हयो, तुमला सान्ती मिल्हे।<verse eid="LUK 24:36"/></para>
  <para style="p">
    <verse number="37" style="v" sid="LUK 24:37"/>पर वोन चकीत भई गइन अना, डर के सोचन लगीन कोनी आतमा भूत से। <verse eid="LUK 24:37"/><verse number="38" style="v" sid="LUK 24:38"/>यीसु ना उन लक कव्हयो, तुम लोग गीन काहे घबरा रही सेव? तुमरो मन मा काहे सका से? <verse eid="LUK 24:38"/><verse number="39" style="v" sid="LUK 24:39"/>मोरो हात अना पाय चोवयो मीच सेव, मोला टटोर के चोवो काहेका, आतमा को हाड-मास नही होतो, जसो तुम्ही मोला चोव रही सेव।<verse eid="LUK 24:39"/></para>
  <para style="p">
    <verse number="40" style="v" sid="LUK 24:40"/>यो सांग के ओना कहकर उ ना वोला आपरो, हात अना पाय दिसायो। <verse eid="LUK 24:40"/><verse number="41" style="v" sid="LUK 24:41"/>जबा खुसी को मारे ले, वोला भरोसा नही भयो, ता वय आचरज करन लगीन, ता वोना उनको लक पुसिस, का तुमरो कठा कहि जेवन को सेत। <verse eid="LUK 24:41"/><verse number="42" style="v" sid="LUK 24:42"/>वोना वोला भुजिं मसरी को टुक्का देईस। <verse eid="LUK 24:42"/><verse number="43" style="v" sid="LUK 24:43"/>वोना वोला लेइस, अना उनको पूढा जेव लेइस।<verse eid="LUK 24:43"/></para>
  <para style="p">
    <verse number="44" style="v" sid="LUK 24:44"/>यीसु ना चेला गीन ला कहीस, मीना तुमरो संग रहतो बेरा कव्हयो होतो, की जो काही मोसे को नियम अना, भजन भविस्यवक्ता गिनको कीताब मा लिखयो, से सबा को पूरो होवना जरूरी से।<verse eid="LUK 24:44"/></para>
  <para style="p">
    <verse number="45" style="v" sid="LUK 24:45"/>तबा वोना उनको अक्कल ला उघाड़ देइस, का उनला पवितर गीरंथ समजमा आ सके। <verse eid="LUK 24:45"/><verse number="46" style="v" sid="LUK 24:46"/>अना उन लक कहीस, पवीतर गिरंथ मा असो लिखयो, से का मसीह दुख उठायेत अना परो को दिवस मरो लक, जिव जाहेत। <verse eid="LUK 24:46"/><verse number="47" style="v" sid="LUK 24:47"/>अना येरुसलेम लक सुरू करके सबच लोक गीनमा वोको नाव लक पाप की छिमा लाई मनफिरावन अना पस्तावा को परचार करयो। <verse eid="LUK 24:47"/><verse number="48" style="v" sid="LUK 24:48"/>तुमी यो गोस्टी को गवाह सेव। <verse eid="LUK 24:48"/><verse number="49" style="v" sid="LUK 24:49"/>चोवो! जोनको वादा मोरो बाबूजी ना कियो से, मी वोला तुमरो पर उतारीन, अखीन जब तकन सरग लक सक्ती नही भेटेत तुम्ही येरुसलेम-नगर मा रव्हने काहेका, जबा उ वरदान आहेत, तबा तुम्ही परमेस्वर को ताकत लक, भरपूर होय जाने।<verse eid="LUK 24:49"/></para>
  <para style="s">यीसु को सरग मा उचलनो</para>
  <para style="r">(<ref loc="MRK 16:19">मरकुस 16:19</ref>,<ref loc="MRK 16:20">20</ref>; <ref loc="ACT 1:9-11">पेरीत 1:9-11</ref>)</para>
  <para style="p">
    <verse number="50" style="v" sid="LUK 24:50"/>असो सांगत-सांगत वो चेला गीनला बैतनिय्याह गाँव तकन ले गयो, अना उनना आपरो हात उठायके, न आसीस देइस।<note caller="+" style="f"><char style="fr" closed="false">24:50 </char><char style="ft" closed="false">आसीरवाद </char></note> <verse eid="LUK 24:50"/><verse number="51" style="v" sid="LUK 24:51"/>यीसु आसीस देत-देत उन लक बेगरो भय गयो, अना सरग मा उचल लियो गयो<note caller="+" style="f"><char style="fr" closed="false">24:51 </char><char style="ft" closed="false">उचल लिया गया</char></note>। <verse eid="LUK 24:51"/><verse number="52" style="v" sid="LUK 24:52"/>चेलागिन वोला परनाम करके वोको स्तुति करत खुसी लक, येरुसलेम नगर लवट गइन। <verse eid="LUK 24:52"/><verse number="53" style="v" sid="LUK 24:53"/>अना मंदिर मा परमेस्वर को बड़ाई करन लगीन।<verse eid="LUK 24:53"/></para>
  <chapter eid="LUK 24"/>
</usx>
