<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="PHM" style="id">- Powari Standard Project</book>
  <para style="h">फिलेमोन</para>
  <para style="toc3">फिलेमोन</para>
  <para style="toc2">फिलेमोन</para>
  <para style="toc1">फिलेमोन को नाव पौलुस की चिठ्ठी</para>
  <para style="mt2">फिलेमोन के नाव पौलुस का पत्र</para>
  <para style="mt1">फिलेमोन को नाव पौलुस की चिठ्ठी</para>
  <para style="imt">परिचय</para>
  <para style="ip">फिलमोन को नहानी किताब पेरीत पौलुस कन लक लिख्यो गयी होती <char style="xt"><ref loc="PHM 1:1">1:1</ref></char> पौलुस जेल मा होतो जबा ओना एला लिख्यो होतीस, जेको अरथ से का उ सायद रोम लक लिख रहयो होतो। अदी उ रोम मा होतो ता यो ईसा को जलम को लगभग 61 बरस मंघा लिख्यो गयो होहे, जोन का ओनाच बेरा से जबा ओना ईसाई लिख्यो होतो।</para>
  <para style="ip">उनना यो चिठ्ठी फिलमोन नाव को एक मानूस ला लिख्यो होतो। फिलमोन चरच को एक सदस्य होतो अना एक सेवक को मालीक भी होतो। पौलुस ना ओला यो पुसन को साठी रोकयो का उ आपरो सेवक उनसिमुस ला सजा नोको देहे जोन फिलमोन लक पराय गयो होतो। रोम देस को कानून को कनलक फिलमोन ला उनेसिमुस को मौत को घाट उतारन को हक होतो। पौलुस उनेसिमुस ला ईसाई भाऊ को नाव मा अपनावन को साठी फिलमोन ला बढ़ावा देवन को लाई पौलुस पेरीत तरक ला काम मा आनासे अना यो भी सलाह देवासे का उनेसिमुस ला पौलुस को संगा सेवा करन को अनुमती दियो जाहे। <char style="xt"><ref loc="PHM 1:13-14">1:13-14</ref></char></para>
  <para style="iot">रूपरेखा</para>
  <para style="io1">1. पौलुस मा फिलमोन को आवभगत करासे। <char style="ior"><ref loc="PHM 1:3">1:3</ref></char></para>
  <para style="io1">2. तबा पौलुस उनेसिमुस को कना लक पुसासे का फिलमोन ओला एक ईसाई भाऊ को रूप मा अपनाय लेहे। <char style="ior"><ref loc="PHM 1:4-21">1:4-21</ref></char></para>
  <para style="io1">3. पौलुस यातरा करन साठी आपरो मरजी को ऐलान करके खतम करासे। अना सुब कामना गीनला धाड़ासे। <char style="ior"><ref loc="PHM 1:13-14">1:13-14</ref></char></para>
  <chapter number="1" style="c" sid="PHM 1" />
  <para style="s">भुमिका</para>
  <para style="p">
    <verse number="1" style="v" sid="PHM 1:1" />मसीह यीसु को बँदी बनयो पौलुस कन लक अना भाऊ तीमुथियुस को कन लक जोन आमरो माया को संग कामकाज करन वालो से, फिलेमोन <verse eid="PHM 1:1" /><verse number="2" style="v" sid="PHM 1:2" />अना बहिन अफफिया अना आमरो संगी सैनिक अरखिप्पुस अना फिलमोन को घर की कलीसिया को नाव।<verse eid="PHM 1:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="PHM 1:3" />आमरो बाबूजी परमेस्वर अना पिरभू यीसु मसीह को कन लक दया अना सान्ती तुमला भेटासे।<verse eid="PHM 1:3" /></para>
  <para style="s">फिलमोन को माया अना बिस्वास</para>
  <para style="p">
    <verse number="4" style="v" sid="PHM 1:4" />मी फिलमोन सबच बेरा परमेस्वर को धनवाद करुसेउ, अना आपरी पिराथना मा भी तोला हेत करुसेउ। <verse eid="PHM 1:4" /><verse number="5" style="v" sid="PHM 1:5" />काहेकि मि तोरो उ भरोसा अना माया को चरचा आयकीसेऊ जोन सबच पवीतर लोकगीन को सँगा अना पिरभु यीसु पर से। <verse eid="PHM 1:5" /><verse number="6" style="v" sid="PHM 1:6" />मि पिराथना करासेऊ का भरोसा मा तोरो संगती होवनो तुमरी सप्पा भला को पहिचान मा, मसीह को लाई परभाव डाखन वालो भइ जाहेत। <verse eid="PHM 1:6" /><verse number="7" style="v" sid="PHM 1:7" />काहेकि हे भाऊ मोला तोरो माया लक लगत खुसहाली अना सान्ती भेटासे, काहे की तुना परमेस्वर को सप्पा पवीतर लोकगीन को “मन ला हिवरो कर देईसेस।”<verse eid="PHM 1:7" /></para>
  <para style="s">उनेसिमुस को साठी बिनती</para>
  <para style="p">
    <verse number="8" style="v" sid="PHM 1:8" />यो काजी मि जोन गोस्टी साजरी से, ओकोसाठी अदी मोला मसीह मा मोठयो हिम्मत से, मजे असो करन साठी तुमला हुकूम दियो जाय सके की काजक करनो जरुरी से। <verse eid="PHM 1:8" /><verse number="9" style="v" sid="PHM 1:9" />लेकिन मि बुड़गा पौलुस तुमी लक माया करुसु, मि एको अलावा तुमी लक बिनती करुसेऊ। मि असो एकोलाय करुसेउ की मि मसीह यीसु को राजदुत सेव, अना अबा को बेरा मा ओको लाई बँदी सेव। <verse eid="PHM 1:9" /><verse number="10" style="v" sid="PHM 1:10" />मि तुमरो लक बिनती करासू। आपरो लेकरा उनेसिमुस को साठी जोन मोरो बंधन मा पैदा भयो से। <verse eid="PHM 1:10" /><verse number="11" style="v" sid="PHM 1:11" />उ तो पुढ़ा तुमरो लाई काही काम को नाहोतो, पर अबा तुमरो अना मोरो लाई मोठो काम को से।<verse eid="PHM 1:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="PHM 1:12" />ओला मजे जो “मोरो दिल को टुकड़ा से,” मि ओला अबा तुमरो कठा लवटाय देईसेऊ। <verse eid="PHM 1:12" /><verse number="13" style="v" sid="PHM 1:13" />मि ओला यहान आपरो कठा राखनो चाव्हउसु होतो की उ तोरी कन लक यो बंधन मा जोन साजरो बारता को काजी से, मोरी सेवा करहेत। <verse eid="PHM 1:13" /><verse number="14" style="v" sid="PHM 1:14" />पर मीना तोरो मरजी को बिना काही नही करन चाव्हयो, की तोरी यो किरपा दबाव लक नही पर खुसहाली लक होय।<verse eid="PHM 1:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="PHM 1:15" />काय का मालुम होव्हे की उ तोरो लक काही दिवस को साठी यो कारन लक अलग भयो की हरामेसा तोरो कठा रहेत। <verse eid="PHM 1:15" /><verse number="16" style="v" sid="PHM 1:16" />पर अब लक दास को जसो नही पर दास लक भी साजरो, मजे भाऊ को जसो रह। जोन मोरो ता खास चहेतो से पर अब देह मा अना पिरभु मा भी, तोरो भी खास पयारो होय।<verse eid="PHM 1:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="PHM 1:17" />एकोलाय अदी तु मोला आपरो सँगा को संगी समझीसेस, ता ओला असो रीती लक आपनावजो जसो की मोला। <verse eid="PHM 1:17" /><verse number="18" style="v" sid="PHM 1:18" />अदी ओना तोरी काही अन्याव करीसेस, या ओको पर तोरो करज आवासेत, ता मोरो नाव लक लिख लेव जोस। <verse eid="PHM 1:18" /><verse number="19" style="v" sid="PHM 1:19" />मि पौलुस आपरो हात लक लिखसेउ की मि आपच भर देहू। अना एको कव्हन को काही जरुरत नही की मोरो करजा जोन तोरो पर से, उ तु च आस। <verse eid="PHM 1:19" /><verse number="20" style="v" sid="PHM 1:20" />अगो भाऊ यो खुसी मोला तोरो कन लक मिलेह। पिरभू मसीह मा मोरो जी हिवरो कर देहे।<verse eid="PHM 1:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="PHM 1:21" />मि तोरो हुकूम मानन को भरोसा राखके तोला लिख सेव, अना यो जानासेऊ की जोन काही मि कव्हुसेउ, तु ओको लक कहीं बड़के करजोस। <verse eid="PHM 1:21" /><verse number="22" style="v" sid="PHM 1:22" />अना असो भी की मोरो लाई मिजवान खोली तैय्यार राखजोस। मोला आस से की तुमरी पिराथना कन लक मि तुमला दे दियो जाहुँ।<verse eid="PHM 1:22" /></para>
  <para style="s">अखट्ट नमस्कार</para>
  <para style="p">
    <verse number="23" style="v" sid="PHM 1:23" />एपफ्रास जोन मसीह यीसु मा मोरो सँग बँदी से, <verse eid="PHM 1:23" /><verse number="24" style="v" sid="PHM 1:24" />अना मरकुस अना अरिस्तखुरस अना देमास अना लूका जोन मोरो संग काम करनवारा सेत, इनको तोला नमस्कार।<verse eid="PHM 1:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="PHM 1:25" />आमरो पिरभु यीसु मसीह को दया तुमरो आतमा पर होवती रह। आमीन।<verse eid="PHM 1:25" /></para>
  <chapter eid="PHM 1" />
</usx>