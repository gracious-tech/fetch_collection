<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="TIT" style="id">- Powari Standard Project</book>
  <para style="h">तीतुस</para>
  <para style="toc3">तीतुस</para>
  <para style="toc2">तीतुस</para>
  <para style="toc1">तीतुस को नाव पौलुस की चिठ्ठी</para>
  <para style="mt2">तीतुस के नाव पौलुस का पत्र</para>
  <para style="mt1">तीतुस को नाव पौलुस की चिठ्ठी</para>
  <para style="imt">परिचय</para>
  <para style="ip">तीतुस को किताब पौलुस को चार चिठ्ठी मा लक एक से जेला एक चरच को अलावा एक मानूस को नाव लक राखासे। अखीन तीन अक्सर 1 तीमुथियुस, 2 तीमुथियुस अना फिलमोन सेत। पौलुस तीतुस ला लिख रहयो होतो। पर उनना यो भी लिख्यो होतो का चिठ्ठी ला सबको समोर जोर लक बाचयो जाय सकासे। आमी यो जान सकासेजन काहेकि उ आपरो काबिलयत ला एक पेरीत को रूप मा सांगासे, काही असो जोन तीतुस ला पयले लक च मालुम होहे। पौलुस ना करीबन ईसा को जलम को 63-65 बरस को बीच यो चिठ्ठी लिख्यो होतो</para>
  <para style="ip">पौलुस ना तीतुस ला क्रेत को टापु पर कलीसिया ला हुकूम दियो होतो। चरच को पेरीत गीन को चुनाव अना सिक्सा पर तीतुस ला हुकूम देवन साठी पौलुस ना यो चिठ्ठी ला लिखी होतीस। उनना आपरो चिठ्ठी गीन मा एने रीती को हुकूम तीमुथियुस ला दियो। उनको चिठ्ठी मा चरचा करयो गयो से का चरच को पेरीत गीनला उच्चो जघा पर कसो राखयो जानो जरुरी से। चरचगीन अना चरच को पेरीत ला आज अगुवाई मा जरुरी मा नियम पर धियान देवनो जरुरी से।</para>
  <para style="iot">रूपरेखा</para>
  <para style="io1">1. पौलुस ना तीतुस ला परमेस्वर लक जुड़यो अगुवागीन ला ठयरावन को हुकूम देयी होतो। <char style="ior"><ref loc="TIT 1:1-16">1:1-16</ref> </char></para>
  <para style="io1">2. मंग, उ ओला लोकगीन ला परमेस्वर लक जुड़यो जिंदगी जीवनो साठी अभ्यास करन को भी हुकूम देयो होतो। <char style="ior"><ref loc="TIT 2:1-3:11">2:1—3:11</ref></char></para>
  <para style="io1">3. आखरी मा, पौलुस आपरी काही नीति गीन ला जोड़के अना सुब कामना गीन ला धाड़ के खतम करासे। <char style="ior"><ref loc="TIT 3:12-15">3:12-15</ref></char></para>
  <chapter number="1" style="c" sid="TIT 1" />
  <para style="s">पौलुस का अभिवादन</para>
  <para style="p">
    <verse number="1" style="v" sid="TIT 1:1" />पौलुस को कन लक जोन ला</para>
  <para style="p" vid="TIT 1:1">परमेस्वर को बेचयो गयो दास लोकहुन ला उनको बिस्वास मा सहायता देवन लाई अना आमरी नेकी को काम अना खराई को पुरो गियान सिकावन साठी धाड़यो गयो से। <verse eid="TIT 1:1" /><verse number="2" style="v" sid="TIT 1:2" />अमर जीवन की ओना आसा मा जेकी परन परमेस्वर ना जोन झुठो नाहती जुनो जमाना लक करीसेस, <verse eid="TIT 1:2" /><verse number="3" style="v" sid="TIT 1:3" />अबा सही बेरा मा, वोना आपरो मतलब की गोस्टी वोना सन्देसा लक साप कर दियो। जोन को परचार आमरो बचावन वालो परमेस्वर को हुकूम अना भरोसा लक मोला सोपो गयो सेत।<verse eid="TIT 1:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="TIT 1:4" />तीतुस को नाव जोन भरोसा को भागी होवन लक मोरो खरो टूरा से। परमेस्वर बाबूजी अना आमरो बचावन वालो मसीह यीसु को कन लक तुमला दया अना सान्ती मिलत रव्हे।<verse eid="TIT 1:4" /></para>
  <para style="s">क्रेते टापु मा तीतुस को काज</para>
  <para style="p">
    <verse number="5" style="v" sid="TIT 1:5" />मि यो साठी तोला क्रेत मा छोड़ आयो होतो की तु बचयो गोस्टीहुन ला सुधारजोस, अना मोरो हुकूम को कन लक नगर-नगर मुखिया गीन लक ला ठहराजोस। <verse eid="TIT 1:5" /><verse number="6" style="v" sid="TIT 1:6" />जोन निरदोस अना एकच बायको को नौरा होय, जिनको लेकरा बिस्वास करनवालो होहेत। अना उनमा लुच्चापन अना बे लगाम नोको होय। <verse eid="TIT 1:6" /><verse number="7" style="v" sid="TIT 1:7" />काहेका मुखिया ला परमेस्वर को खजांची होवन को कारन कलिसीया को मुखिया ला निरदोस होवनो चाव्हसे। न ता जिद्दी, न ता गुस्सा करनवालो, न ता पियक्कड़, न मारपीट करन वालो, न ता नीच कमाई को लोभी होय, <verse eid="TIT 1:7" /><verse number="8" style="v" sid="TIT 1:8" />पर मिजवानी करन मा मान महत्तम करन वालो होय, भलाई चाव्हन वालो होय, धीरज राखन वालो, न्याय करनवालो, पवीतर अना आपरो मन ला कब्जा मा करनवालो होय। <verse eid="TIT 1:8" /><verse number="9" style="v" sid="TIT 1:9" />अना उ बिस्वास लायक बचन मा जोन धरम को सिक्सा को लक सेत, ओमा, अडिग रव्हके खरी सिक्सा लक बढ़ावा देय सके, अना बिरोध करनवारा को टोंड बंद कर सकेत।<verse eid="TIT 1:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="TIT 1:10" />काहेका लगत सा लोकगीन बेलगाम, बकवादी अना धोखा देवनवारा सेती; खास करके खतना वारा मा लक सेत। <verse eid="TIT 1:10" /><verse number="11" style="v" sid="TIT 1:11" />इनको टोंड बंद करनो चाव्हसे। यो लोकगीन नीच कमाई को साठी बेकार गोस्टी सिखायके घर को घर बिगाड़ासेति। <verse eid="TIT 1:11" /><verse number="12" style="v" sid="TIT 1:12" />उनमा लक एक मानूस ना जो उनको च भविस्यवक्ता से कहिसेस, “क्रेती टापु को लोक सदा झुठो, दुस्ट जनावर अना अलाल अघोरी होवासेत।” <verse eid="TIT 1:12" /><verse number="13" style="v" sid="TIT 1:13" />या गवाही खरो से, एकोसाठी उनला कड़ाई लक चेताव का वय भरोसा मा पक्को होय जाहेत। <verse eid="TIT 1:13" /><verse number="14" style="v" sid="TIT 1:14" />अना यहुदिगिन को कथा बारता मा अना उन मानूस की हुकूम गीन पर मन न लगाहेत, जोन खराई लक भटक जासेत। <verse eid="TIT 1:14" /><verse number="15" style="v" sid="TIT 1:15" />सुध्द लोकगीन को लाई सबच चीजगीन सुध्द से, पर असुध्द अना अबिस्वासी गीन साठी काही भी सुध्द नाहती लेकिन उनकी मन अना डिमाक दुही असुध्द सेत। <verse eid="TIT 1:15" /><verse number="16" style="v" sid="TIT 1:16" />वय परमेस्वर ला जानन को दावा करासेत पर उनको काम असो चोवसे जसो ओला नही जानासेत। वय घिरना को काम करनवालो, अना हुकूम नही मानन वालो सेत। अना कोनी भी नेक काम करन को काबिल नही सेत।<verse eid="TIT 1:16" /></para>
  <chapter eid="TIT 1" />
  <chapter number="2" style="c" sid="TIT 2" />
  <para style="s">सुभाव को साठी खरी सिक्सा</para>
  <para style="p">
    <verse number="1" style="v" sid="TIT 2:1" />पर तुमी असी गोस्टी सांगो जोन खरो सिक्सा को लायक सेत। <verse eid="TIT 2:1" /><verse number="2" style="v" sid="TIT 2:2" />मजे बुजरुक मानूस हुसियार अना गम्भिर नरम अना आपरो मन ला कबजा मे राखनवारा<note caller="+" style="f"><char style="fr" closed="false">2:2</char><char style="ft" closed="false">संयमी, जितेन्द्रिय</char></note> होहे, अना वोको भरोसा अना माया अना धीरज पक्का होहे। <verse eid="TIT 2:2" /><verse number="3" style="v" sid="TIT 2:3" />असी रिती लक सेविका बुजुरुग बायकागीन को चाल-चलन मा पवीतर लोकगीन जसो होय। वय लान-छान लगावन वाली अना दरवा नही, पर साजरी गोस्टी सिकावनवारी होय। <verse eid="TIT 2:3" /><verse number="4" style="v" sid="TIT 2:4" />ताकि वय जवान बायकागीन ला चेतात रव्हे। की आपरो नवरागीन अना लेकरागीन लक माया राखे। <verse eid="TIT 2:4" /><verse number="5" style="v" sid="TIT 2:5" />अना धीरज धरन वारो, पवीतर, घर को काम करनवारी, साजरी अना आपरो-आपरो घरवालो को बसमा रव्हनवारी होय, ताकि परमेस्वर को गोस्टी को निन्दा न होवनो पाय।<verse eid="TIT 2:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="TIT 2:6" />असोच जुवान मानूसगिन ला भी आदर समेत समजावने की धीरजवन्त होवो। <verse eid="TIT 2:6" /><verse number="7" style="v" sid="TIT 2:7" />सब गोस्टीहुन मा आपरो आप ला साजरो कामकाज को नमुना बनाव। तोरो पिरवचन मा सफाई, गम्भीरता, <verse eid="TIT 2:7" /><verse number="8" style="v" sid="TIT 2:8" />अना असी खराई पाई जाहे, की कोनी ओला बुरो कव्ह नही सकत, जोको लक विरोध करनवारा गीन आमी पर कोनी “उँगठी उठानो” को मौका न पायके लज्जाहेति।<verse eid="TIT 2:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="TIT 2:9" />दास गीन ला समझाव की आपरो-आपरो मालिक को बस मा रहेति, अना सब गोस्टीहुन मा उनला खुस राखेति, अना पलट के ना जवाब नही देहेति। <verse eid="TIT 2:9" /><verse number="10" style="v" sid="TIT 2:10" />चोरी चालाकी नोको करने, पर सबच परकार लक साजरो भरोसा करनवारा हिटेत, की वय सबच गोस्टीहुन मा आमरो बचावन वालो परमेस्वर को उपदेस को सोभा बढ़ाहेत।<verse eid="TIT 2:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="TIT 2:11" />काहेका परमेस्वर को उ दया दिसायी गयो से, जोन सबच मानूस को मुक्ति को कारन से। <verse eid="TIT 2:11" /><verse number="12" style="v" sid="TIT 2:12" />अना आमी चेतावनी देवा सेजन, की आमी बिना भक्ति को, अना दुनिया को मन मरजी लक मन हटाव के, ना यो जुग मा धीरज अना नेकी अना भक्ति लक जिंदगी बितावबिन। <verse eid="TIT 2:12" /><verse number="13" style="v" sid="TIT 2:13" />अना ओनो धन्य आसा को, मजे मोठो परमेस्वर, अना बचावन वालो यीसु मसीह, को महिमा को दिसायो जावनो की रस्ता चोवासेजन। <verse eid="TIT 2:13" /><verse number="14" style="v" sid="TIT 2:14" />जेने आपरो आप ला आमरो साठी दे देईसेस, की आमी ला हरेक परकार लक दुस्टपन लक छुड़ाय लेहे। अना आपरो बेचयोगयो लोकहुन को रूप मा आमीला पवितर करलेव, जोन लक नेक काम करन लाई आमी हरमेसा तैय्यार रव्हे।<verse eid="TIT 2:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="TIT 2:15" />पूरो हक को सँगा यो गोस्टी बढ़ावा देव, अना समजने अना सिकावने की कोनी तुमरो गोस्टी आयक के लापरवाही नोको करेत।<verse eid="TIT 2:15" /></para>
  <chapter eid="TIT 2" />
  <chapter number="3" style="c" sid="TIT 3" />
  <para style="s">मसीही गीन को चालचलन</para>
  <para style="p">
    <verse number="1" style="v" sid="TIT 3:1" />लोकहुन ला हेत दिलायो जाहे का सरकार को अना हक राखन वारा गीन को कब्जा मा रहेत। अना उनको हुकूम ला मनाहेत। अना हरेक साजरो काम काज लाय तइयार रहेत। <verse eid="TIT 3:1" /><verse number="2" style="v" sid="TIT 3:2" />कोनी ला बदनाम नोको करयेत, झगड़ा करनवारा नही होहेत। पर नरम सुभाव, अना साजरो मानूस होहेत। अना सबच मानूस गीन को सँगा नरम दिली रहेत। <verse eid="TIT 3:2" /><verse number="3" style="v" sid="TIT 3:3" />काहेका आमी पुढ़ा बेअक्ल का रहत होता अना हुकूम ला नही मानत होता अना संका मा पड़या रव्हत होता। अना काई परकार को लोभ अना सुख सुविदा को चाकरी करत होता अना बइर, अना जरनाहि मा जिंदगी बितावत होता। अना आमी लक लोक घिरना करत होतीन अना आमी भी एकमेक लक घिरना करत होतो। <verse eid="TIT 3:3" /><verse number="4" style="v" sid="TIT 3:4" />पर जबा आमरो बचावन वालो परमेस्वर को मानुसपन को लाई किरपा अना ओको माया चोयो। <verse eid="TIT 3:4" /><verse number="5" style="v" sid="TIT 3:5" />तबा ओना आमला बचायो अना यो आमरो निरदोस ठहरानो को लाई कोनी नेक काम को कारन नही हुयो, लेकिन ओको किरपा लक हुयो। ओना आमरो रक्सा करके आँग धोवावनो लक आमला दुबारा जलम देयीसेस। अना पवितर आतमा लक नयो बनायो जावासे। <verse eid="TIT 3:5" /><verse number="6" style="v" sid="TIT 3:6" />जेनला ओने आमरो बचावन वालो यीसु मसीह को कन लक आमी पर लगत रिती लक उबड़ायो गयो से। <verse eid="TIT 3:6" /><verse number="7" style="v" sid="TIT 3:7" />जोको लक आमी ओको दया लक धरमी ठहरायो, अमर जीवन को आस को वारिस बनायो गयो सेजन।<verse eid="TIT 3:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="TIT 3:8" />यो गोस्टी खरी से, अना मी चाव्हसु की तु ऐना गोस्टी गीन को बारे मा मजबुती लक बोलजोस। एकोसाठी की जिनना परमेस्वर पर बिस्वास करयो सेत। वय भलो-भलो कामगीन मा लगयो रव्हन को धियान करेत। जोन गोस्टी साजरी अना मानूस को फायदा की रव्हे। <verse eid="TIT 3:8" /><verse number="9" style="v" sid="TIT 3:9" />पर मुरखगीन को बकवास लक अना खानदान, अना विरोध अना झगड़ा लक जोन कानुन को बारे मा होवासेत, ओको लक बचयो रव्हअ। काहेका वय बिनफर को अना बेकार सेत। <verse eid="TIT 3:9" /><verse number="10" style="v" sid="TIT 3:10" />कोनी पाखन्डी<note caller="+" style="f"><char style="fr" closed="false">3:10 </char><char style="ft" closed="false">अराजक, झगड़ालु पाँखडी</char></note> ला एक दुई गन समझाव के ओकोलक अलग रव्हने। <verse eid="TIT 3:10" /><verse number="11" style="v" sid="TIT 3:11" />यो जान करके की असो मानूस भटक गयो से, अना आपरो आपला दोसी ठहरावके पाप करतो रव्हसे।<verse eid="TIT 3:11" /></para>
  <para style="s">अखट्ट हुकूम</para>
  <para style="p">
    <verse number="12" style="v" sid="TIT 3:12" />जबा मि तोरो कठा अरतिमास या तुखिकुस ला धाड़ु ता मोरो कठा निकोपुलिस आवन को कोसिस करनो, काहेकि मीना वहान “जाड़ो कापन” को तय करीसेव। <verse eid="TIT 3:12" /><verse number="13" style="v" sid="TIT 3:13" />जेनास नाव को नियम को गुरु अना अपुल्लोस<note caller="+" style="f"><char style="fr" closed="false">3:13</char><char style="ft" closed="false">पेरीत18:41-42 अपुल्लोस ; यो एक यहुदी होतो अना एको जलम सिकन्दरिया मा हुयो होतो वा एक विद्वान मानूस होतो। अखीन पवीतर सास्तर ला साजरो लक जानत होतो। उ इफिसुस लक आयो होतो, उ यीसु की सिक्सा ला सिकावत होतो। </char></note> ला कोसिस करके पुढ़ा धाड़ देव। अना चोव लेव की उनला कोनी चीज को कमी नोको होय। <verse eid="TIT 3:13" /><verse number="14" style="v" sid="TIT 3:14" />आमरो लोकगीन भी जरुरत को पुरा करन लाई साजरो काम मा लगयो रव्हनो सीकेत। मजे बिनफर नोको रहेत।<verse eid="TIT 3:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="TIT 3:15" />मोरो सबच संगीगिन को तोला नमस्कार।</para>
  <para style="p" vid="TIT 3:15">जोन भरोसा को कारन अमी लक माया राखा सेत। उनला नमस्कार तुम सब मा किरपा होहेत।<verse eid="TIT 3:15" /></para>
  <chapter eid="TIT 3" />
</usx>