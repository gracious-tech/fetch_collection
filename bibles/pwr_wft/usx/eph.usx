<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="EPH" style="id">- Powari Standard Project</book>
  <para style="h">इफिसियो</para>
  <para style="toc3">इफिसियो</para>
  <para style="toc2">इफिसियो</para>
  <para style="toc1">इफिसियो को नाव पौलुस की चिठ्ठी</para>
  <para style="mt2">इफिसियो के नाव पौलुस का पत्र</para>
  <para style="mt1">इफिसियो को नाव पौलुस की चिठ्ठी</para>
  <para style="imt">परिचय</para>
  <para style="ip">मसीह को जनम को 60 साल पहिले इफिसियों की चिठ्ठी अखिन कुलुस्सियों की चिठ्ठी करीब संग मा लिख्यो गयो। पेरीत पौलुस यो सुचित करयो का वा चिठ्ठी को लेखक वोच आय <char style="xt"><ref loc="EPH 1:1">1:1</ref>।</char></para>
  <para style="ip">कुलुस्सियों की चिठ्ठी को जसो नीजी सुभेच्छा नहीं पायो जावासेत। मंग लगत विद्वान गिनको यो माननो से का पौलुस नाच यो चिठ्ठी लिख्यो सेत। योच वजह लक पिरान्त को बेगरो-बेगरो मन्डली मा या चिठ्ठी घुमाय के बाचयो जाय। असो पौलुस को इरादा होतो, जब ओना या चिठ्ठी लिखी तब पौलुस यो बतायो से का वय जेल मा होतो, <char style="xt"><ref loc="EPH 3:1">3:1</ref>; <ref loc="EPH 4:1">4:1</ref>; <ref loc="EPH 6:20">6:20</ref></char> जब तुखिकुस इफिसियों की कलिसीया ला मिलन इफिसियों जाय रह्यो होतो तब पौलुस न या चिठ्ठी ओको हात मा धाड़यो <char style="xt"><ref loc="EPH 6:21-22">6:21-22</ref></char></para>
  <para style="ip">इफिसियों लगत मोठो सहर होतो, वोना बेरा मा एसिया माइनर पिरान्त को राजधानी होती। सहर म अर्तमिस नामको गीरीक देवता को एक मोठो मंदिर होतो जेनको कारन लक इफिसियों नगर जग जाहीर होतो, <char style="xt"><ref loc="ACT 19:23-31">पेरीत 19:23-31</ref></char> यो इफिसियों की मन्डली की सुरूवात जोरदार भयी पर बाद म वा कमजोर होतयो चोवन लगयो <char style="xt"><ref loc="REV 2:1-7">परकासित वाक्य 2:1-7</ref></char> परमेस्वर न अपरो लोक गीनला निवाड़ के यीसु मसीह लक कसो उनको पाप गीन लक सूटकारा दिलायो या गोस्टी पौलुस को चिठ्ठी को पहलो हिस्सा मा सपा-सपा से, वा कलिसीया को बरोबरी उ तन लक करयो से का जोनको डोस्का मसीहच आय अखिन वोको कोना को गोटा वा इमारत से जेनको कोना को गोटा मसीह आय किताब को दूसरों हिस्सा मा मसीह जीवन कसो जीवनो पाहिजे एको बारेमा सांगयो से। हय।</para>
  <para style="iot">रुपरेखा</para>
  <para style="io1">1. पौलुस खुद को परिचय देय के इफिसियों ला सुभेच्छा देवा से। अध्याय <char style="ior"><ref loc="EPH 1:1-2">1:1-2</ref></char></para>
  <para style="io1">2. बाद मा वा कलिसीया लक मसीह को रिस्ता कसो होवनो पाहिजे सांगा सेत। <char style="ior"><ref loc="EPH 1:3-3:21">1:3—3:21</ref></char></para>
  <para style="io1">3. बाद मा पौलुस मसीही जीवन कसो जीवनो पाहिजे एको बारे मा सांगा सेत। <char style="ior"><ref loc="EPH 4:1-6:20">4:1—6:20</ref></char></para>
  <para style="io1">4. पौलुस आखरी सब्द लिख के चिठ्ठी ला खतम करासेत। <char style="ior"><ref loc="EPH 6:21-24">6:21-24</ref></char></para>
  <chapter number="1" style="c" sid="EPH 1" />
  <para style="p">
    <verse number="1" style="v" sid="EPH 1:1" />यो चिठ्ठी पौलुस को कन लक, जोन परमेस्वर को मरजी लक मसीह यीसु को पेरीत से, इफिसुस का रव्हनवारा सन्तगिन अना मसीह यीसु मा बिस्वासी गिन को नाव से। <verse eid="EPH 1:1" /><verse number="2" style="v" sid="EPH 1:2" />तुमला आमरो बाबूजी परमेस्वर अना पिरभु यीसु मसीह को कन दया अना सान्ती भेटयो जाय।<verse eid="EPH 1:2" /></para>
  <para style="s">मसीह मा रव्हन वालो ला आतमिक आसीस</para>
  <para style="p">
    <verse number="3" style="v" sid="EPH 1:3" />आमरो पिरभु यीसु मसीह को बाबूजी अना परमेस्वर धन्य होय। जेना आमीला मसीह मा सरगीय जघा मा सप्पा परकार की आतमिक आसिरवाद देईसेस। <verse eid="EPH 1:3" /><verse number="4" style="v" sid="EPH 1:4" />परमेस्वर आमी ला संसार को पैदा होवनो लक पयले मसीह मा, ओको पुड़ा पवीतर अना बेकसूर होवन लाय निवाड़ी सेस। <verse eid="EPH 1:4" /><verse number="5" style="v" sid="EPH 1:5" />आमरो पुढ़ा ओको जो पिरेम से ओकोच काजी ओना यीसु मसीह को कन लक आमीला आपरो लेकरा को रूप मा आपनायो जान को लाई ठहरायीसेस। योच ओको मरजी होती अना योच ओको मकसद भी होतो। <verse eid="EPH 1:5" /><verse number="6" style="v" sid="EPH 1:6" />ओना असो एकोलाई करीस की उ आपरी महिमा वालो किरपा को काजी खुदच ला खुस करे। ओना आमीला जोन ओको चहेतो लेकरा मा से, छुट्टो भाव लक देयीसेस। <verse eid="EPH 1:6" /><verse number="7" style="v" sid="EPH 1:7" />ओको चढ़ावा मिरतु को कन लक अब आमी आपरो पाप हुन लक सूटकारा को मजा ले रही सेजन। ओको भरपुर किरपा को काजी आमीला आपरो पापहुन को माफी मिलसेत। आपरो वोच पिरेम को जसो जेनला उ मसीह को कन लक आमी पर दिसान चाव्हत होतो। <verse eid="EPH 1:7" /><verse number="8" style="v" sid="EPH 1:8" />ओना आमीला आपरी मरजी को भेद ला सांगीसेस। <verse eid="EPH 1:8" /><verse number="9" style="v" sid="EPH 1:9" />जसो की मसीह को कन लक उ हमला दिसानो चाव्हत होतो। <verse eid="EPH 1:9" /><verse number="10" style="v" sid="EPH 1:10" />परमेस्वर की असी योजना होती की सही बेरा आवनो पर सरग मा अना धरती मा को सबच चीजहुन ला मसीह मा संगरो जाहेत।<verse eid="EPH 1:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="EPH 1:11" />सबच गोस्टी परमेस्वर को नियाव अना योजना को कन लक कियो जावसे। परमेस्वर ना आपरो निजि मकसद को काजी च हमला ओनोच मसीह मा संत बनन लाई बेचयो से। यो ओकोच कन लक भयो जेनला परमेस्वर ना सब लक सूरू लक पयलेच लक ठहरायीसेस। <verse eid="EPH 1:11" /><verse number="12" style="v" sid="EPH 1:12" />जेकोलक आमी ओकी महिमा को तारीफ को काजी बन सकबिन। आमी मनजे जिनना आपरी सबच आसा मसीह पर निसान ला कर दियासेजन।<verse eid="EPH 1:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="EPH 1:13" />जबा तुमना ओनो सत्य को खबर ला आयकियात जो तुमरो मोक्स को साजरो बारता होतो, अना जेने मसीह पर तुमना बिस्वास करिया होता, ता जेने पवितर आतमा को बचन दियो होतो, मसीह को जरीया लक ओको छाप परमेस्वर को कन लक तुमी लोकहून पर लगायी गयी होती। <verse eid="EPH 1:13" /><verse number="14" style="v" sid="EPH 1:14" />उ आतमा आमरो वारिसपन को छुड़ोती को रूप मा ओनो बेरा तक को लाई हमला देयि गयी से, जब तक का उ हमला जो ओको आपरो सेत, सप्पा परकार लक सूटकारा नही दे देहे। ऐको काजी लोक ओकी महिमा को बड़ाई करेहेत।<verse eid="EPH 1:14" /></para>
  <para style="s">इफिसिगीन लाई पौलुस को पिराथना</para>
  <para style="p">
    <verse number="15" style="v" sid="EPH 1:15" />एकोलाई जबा लक मीना पिरभु यीसु मा तुमरो ओना भरोसा को खबर तुमरो माया को बारे मा जोन सबच पवीतर लोकगीन लाई से, आयकीसेऊ <verse eid="EPH 1:15" /><verse number="16" style="v" sid="EPH 1:16" />मी तुमरो लाई परमेस्वर को सदा धनवाद कर रही सेउ। आपरी बिनती गीन मा तुमला हेत करूसेव, <verse eid="EPH 1:16" /><verse number="17" style="v" sid="EPH 1:17" />मि पिराथना कियो करुसेउ की हमरो पिरभु यीसु मसीह को परमेस्वर तुमला विवेक अना दैवीय दरसन की असी आतमा को ताकत देवासे जेकोलक तुमी ओनो महिमा वान मोठो बाबूजी ला जान सको। <verse eid="EPH 1:17" /><verse number="18" style="v" sid="EPH 1:18" />मि बिनती करूसेव की तुमरो मन को डोरा उघड़ जाहेत अना तुमी उजाड़ को दरसन कर सकने ताकि तुमला मालुम चल जाहे की उ आसा काजक से जेनको लाई तुमला ओना हाकलीसे। अना जेने उतराधिकार ला उ आपरो सबच लोकहुन ला देहे, उ केतरो बलवानना भरपुर से। <verse eid="EPH 1:18" /><verse number="19" style="v" sid="EPH 1:19" />आमी बिस्वासी गीन लाई ओकी ताकत बिन तुलना रूप लक केतरी महान से। यो ताकत आपरी महान ताकत को ओनो काम को जसो से, <verse eid="EPH 1:19" /><verse number="20" style="v" sid="EPH 1:20" />जेनला ओना मसीह मा पूरी करीसेस, जबा ओना ओला मरयो हुयो मा लक जित्तो करके आपरी जेवनो कना सरगीय जघा मा <verse eid="EPH 1:20" /><verse number="21" style="v" sid="EPH 1:21" />परमेस्वर ना उनला हरेक अधिकार पन, हक, ताकत, पिरभुपन अना नामी पद लक लगत वरता जघा देवासे चाव्ह यो ऐना जमाना का होय अना आवन वार जमाना को, <verse eid="EPH 1:21" /><verse number="22" style="v" sid="EPH 1:22" />ओना सबच काही मसीह को पाय को खाल्या डाक देइस, अना उनच को सब पर हक देयके कलीसिया को वरता ठहरायीसेस। <verse eid="EPH 1:22" /><verse number="23" style="v" sid="EPH 1:23" />कलीसिया मसीह की तन से, मसीह को सबरो रूप से, जोन सब काही सब तरीका लक पूरो रूप तक धाड़ देसे।<verse eid="EPH 1:23" /></para>
  <chapter eid="EPH 1" />
  <chapter number="2" style="c" sid="EPH 2" />
  <para style="s">मसीह कन लक जीवन मिलनो</para>
  <para style="p">
    <verse number="1" style="v" sid="EPH 2:1" />एक बेरा होतो जब तुमी लोक उन गुनाह हुन अना पापहुन को काजी आत्मिक रूप लक मरया हुयो होता। <verse eid="EPH 2:1" /><verse number="2" style="v" sid="EPH 2:2" />जोन मा तुमी पयले ऐना संसार की बुरी रिती पर चलत हुयो अना ओनो आतमा को पिछा करत हुयो जीवत होता जो ऐना धरती को वरता की आत्मिक सक्तिहुन को मालिक सेत। वा आतमा अब उन मानुसहुन मा काम कर रही सेजोन परमेस्वर की हुकूम नही मानासेत। <verse eid="EPH 2:2" /><verse number="3" style="v" sid="EPH 2:3" />उनमा आमी भी पयले आपरो देह की मोह मा दिवस बितात होता, देह अना मन को मरजी ला पूरो करत होता, अना अखीन संसार को दुसरो लोकगीन को जसो बरताव लक परमेस्वर को गुस्सा की लेकरा होता।<verse eid="EPH 2:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="EPH 2:4" />पर परमेस्वर जोन दया को धनी से, आपरो ओना मोठो माया को कारन जेना ओना आमी लक माया राखिसेस। <verse eid="EPH 2:4" /><verse number="5" style="v" sid="EPH 2:5" />ओनो बेरा जबकि आमी आपरो पापहुन को काजी आमी आत्मिक रूप लक अबा मरया हुया होता ओना आमीला मसीह को संग-संग ओना हमला भी जिंदगी देईसेस, परमेस्वर को किरपा लक तुमरो सूटकारा भयीसे।<verse eid="EPH 2:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="EPH 2:6" />काहेकि आमी यीसु मसीह मा सेजन एकोलाई परमेस्वर ना हमला मसीह कोसंग च मंग लक जित्तो उचलीस अना ओको संगा च सरग को सिहासन पर बसाईस। <verse eid="EPH 2:6" /><verse number="7" style="v" sid="EPH 2:7" />ताकि उ आवन वालो हर युग मा आपरो दया को साजरो धनला दिसाये जेनला ओना मसीह यीसु मा आपरी दया को रूप मा आमी पर चिन्हित करीसेत। <verse eid="EPH 2:7" /><verse number="8" style="v" sid="EPH 2:8" />परमेस्वर को दया कन लक आपरो भरोसा को काजी तुमरो सूटकारा भयीसे। योयो तुमला तुमरी कन लक नही मिलीसे, पर यो ता परमेस्वर को दियो हुयो दान से। <verse eid="EPH 2:8" /><verse number="9" style="v" sid="EPH 2:9" />अखिन नाता करम लक असो ना होय का कोनी गरब करयेत। <verse eid="EPH 2:9" /><verse number="10" style="v" sid="EPH 2:10" />काहेकि परमेस्वर हमरो बनावन वालो से। ओना मसीह यीसु मा हमारो बनावनो एकोलाई करीस सेस हमि भलो काम करबीन जिनला परमेस्वर ना पयले लक च एकोलाई तैयार करीसे का उनला करतो हुयो आपरो जिंदगी बिताबिन।<verse eid="EPH 2:10" /></para>
  <para style="s">मसीह मा इक्का लक रव्हनो</para>
  <para style="p">
    <verse number="11" style="v" sid="EPH 2:11" />एकोलाई तुमी हेत राखो वय लोक जोन आपरो तन मा मानूस को हात लक कियो हुयो खतना को काजी आपरो आपला “खतना करयो वालो” सांगासेत, विधरमी को रूप मा जन्मो तुमी लोकहुन ला “खतना को बिना” कव्हत होतीन। <verse eid="EPH 2:11" /><verse number="12" style="v" sid="EPH 2:12" />ओनो बेरा तुमी बिना मसीह को होतत, तुमी इसरायल को पंगत लक बाहेर होतीन। परमेस्वर ना आपरो भविस्यवक्ता गीनला जोन वचन देयि होतीस उन पर आधार पर वायदा से अनजान होतो। अना ऐना संसार मा बिना परमेस्वर को निरासा मा जिंदगी जिवत होता। <verse eid="EPH 2:12" /><verse number="13" style="v" sid="EPH 2:13" />पर तुम जोन पयले परमेस्वर मा दुहुर रव्हत होता अना अबा मसीह यीसु को बलिदान को कन लक तुमी जवर आई गया सेव। <verse eid="EPH 2:13" /><verse number="14" style="v" sid="EPH 2:14" />यहुदी अना गैरयहुदी बीच मा एक दुसरो लक नफरत करत होतीन अना बेगरो भय गयी होतीन। बेस असो जसो उन को बीच कोनी भीत उभी होय गयी होय। लेकिन मसीह ना खुदच आपरी तन को बलिदान देय के नफरत की ओनो भीत ला गिराय देइस अना मेल कर दियो। <verse eid="EPH 2:14" /><verse number="15" style="v" sid="EPH 2:15" />अना आपरो देह मा गुस्सा मजे, मोसे को नियम ला जोन हुकूम नियम गिरंथको सहारा पर होतीन, मिटाय देइसेस, की दुही ला आपरो मा एक नवो मानूस बनायके मेल कराय देइसेस। <verse eid="EPH 2:15" /><verse number="16" style="v" sid="EPH 2:16" />अना कूरूस मा गुस्सा ला निपटाय करके दुही ला एक देह बनायके परमेस्वर लक मेल कराइसेस। <verse eid="EPH 2:16" /><verse number="17" style="v" sid="EPH 2:17" />ओना आयके तुमला जो दुहुर होता अना उनला भी जोन जवर होतीन; मेल मिलाप को साजरो बारता ला आयकवाइसेस। <verse eid="EPH 2:17" /><verse number="18" style="v" sid="EPH 2:18" />काहेकि यीसु मसीह को कन लक यहुदी अना गैरयहुदी दुही एकच आतमा लक परमेस्वर बाबुजी को जवर धाड़ियो गयो।<verse eid="EPH 2:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="EPH 2:19" />अब एको कन लक ना ता तुम्ही अनजान रहयो अना ना च परायो रहयो पर अब त तुमी संत मानूस हुन को संगा परमेस्वर को देस का संगी साथी भय गया सेव। <verse eid="EPH 2:19" /><verse number="20" style="v" sid="EPH 2:20" />तुमी एक असा घर सेव जोन पेरीतहुन अना भविस्यवक्ता हुन को नीव पर उभो से, अना खुदच मसीह यीसु जेनको लगत महत्तम को कोनटा को गोटा से। <verse eid="EPH 2:20" /><verse number="21" style="v" sid="EPH 2:21" />जोको लक सप्पा बनयो हुयो काम एक सँगा मिलके पिरभु मा एक पवीतर मंदिर बनतो जावसे, <verse eid="EPH 2:21" /><verse number="22" style="v" sid="EPH 2:22" />जोन मा तुम आतमा लक परमेस्वर को रव्हन वालो जघा होवन साठी एक सँग बनाया जावोसो।<verse eid="EPH 2:22" /></para>
  <chapter eid="EPH 2" />
  <chapter number="3" style="c" sid="EPH 3" />
  <para style="s">गैरयहुदीगीन मा पौलुस को सेवा को काम</para>
  <para style="p">
    <verse number="1" style="v" sid="EPH 3:1" />एकोलाई मि, पौलुस तुमी गैरयहुदीहुन लाई मसीह यीसु को काजी बन्दी सेव, तुमिलक एक बिनती करनो चाव्हसु। <verse eid="EPH 3:1" /><verse number="2" style="v" sid="EPH 3:2" />तुमरो कल्यान काजी बढ़ावा देवन को लाई परमेस्वर ना दया को संग जो काम मोला सोपीसेस, ओको बारे मा तुमीना जरुरच आयकयो होहे। <verse eid="EPH 3:2" /><verse number="3" style="v" sid="EPH 3:3" />का उ यो भेदभरी योजना दरसन को कन लक मोला दिसायी गयी होती, जसो की मि तुमला सार रूप मा लिख चुकी सेउ। <verse eid="EPH 3:3" /><verse number="4" style="v" sid="EPH 3:4" />अना अदि तुमी ओला वाचन करोह ता मसीह को बारे मा भेद भरयो सत्य मा मोरी बारिक नजर को समझ तुमला भय जाहेत। <verse eid="EPH 3:4" /><verse number="5" style="v" sid="EPH 3:5" />यो भेद बखान पयलो को पीढ़ी को लोकहून ला वसो नही दिसायो गयो होतो जसो अबा ओको आपरो पवितर पेरीत हुन अना भविस्यवक्ता हुन को आत्मा को कन लक दिसायो जाय चुकी से। <verse eid="EPH 3:5" /><verse number="6" style="v" sid="EPH 3:6" />यो भेद से का यहुदीहुन को संगा गैरयहुदी भी संग वारिस सेत, एकच देह को आंग सेत अना मसीह यीसु मा जोन बचन आमला दियो गयी से, ओमा संग हिस्सादार सेत।<verse eid="EPH 3:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="EPH 3:7" />साजरो बारता को काजी मि ओनो साजरो बारता को पिरचार करन वारा एक सेवक बन गयो, जोन ओको ताकत को जसो परमेस्वर को दया परमेस्वर को दियो दान को रूप मोला सोपयो गयो होतो। <verse eid="EPH 3:7" /><verse number="8" style="v" sid="EPH 3:8" />अदि अखिन सभच संतहुन मा मि नहानो लक भी नहानो सेउ पर मसीह को अमर धन रुपी साजरो बारता को गैरयहुदी मा पिरचार करन को यो दया मोला दियो गयो। <verse eid="EPH 3:8" /><verse number="9" style="v" sid="EPH 3:9" />अखीन मि सबच मानूसगिन पर उ भेद खोलन की कोसिस करुँह, जोन जुग-जुग लक सप्पा संसार को बनावनवालो परमेस्वर मा छुपयो रही से। <verse eid="EPH 3:9" /><verse number="10" style="v" sid="EPH 3:10" />एकोलाय अबा कलीसिया लक परमेस्वर को कई तरीका को गियान ओना मुखिया अना अधिकारी पर जोन सरगीय जघा मा सेति, प्रकट कियो जाहेत। <verse eid="EPH 3:10" /><verse number="11" style="v" sid="EPH 3:11" />ओना जूनो जमाना मनसा को जसो पुरो भयो जोन ओना आमरो पिरभु मसीह यीसु मा पुरो कियो होतो। <verse eid="EPH 3:11" /><verse number="12" style="v" sid="EPH 3:12" />मसीह पर बिस्वास को काजी आमी परमेस्वर तकन भरोसा अना निडरपन को संगा पहुच राखासेजन। <verse eid="EPH 3:12" /><verse number="13" style="v" sid="EPH 3:13" />एकोलाय मि बिनती करुसेव की जोन दुख तुमरो लाई मोला होई रही सेत, उनको लाई हिम्मत ठेवने, कायसेकि ओमा तुमरो महिमा सेत।<verse eid="EPH 3:13" /></para>
  <para style="s">इफिसि लोकगीन को लाई मसीह को माया</para>
  <para style="p">
    <verse number="14" style="v" sid="EPH 3:14" />मि योच लाई ओना मोठोबाबूजी को पुड़ा टोंगरा टेकसेऊ। <verse eid="EPH 3:14" /><verse number="15" style="v" sid="EPH 3:15" />ओकोच लक सरगमा अना धरती पर, हर एक घराना को नाव राखियो जावसे, <verse eid="EPH 3:15" /><verse number="16" style="v" sid="EPH 3:16" />मि पिराथना करुसेउ की उ आपरी महिमा को आपरो धन लक आपरी आतमा को कनलक तुमरो भीतरी मानुसपन ला ताकत रूप लक सक्ती देहे। <verse eid="EPH 3:16" /><verse number="17" style="v" sid="EPH 3:17" />अना भरोसा लक मसीह तुमरो दिल मा निवास करेत, तुमी जड़ अना पाया माया टिकेहेत। <verse eid="EPH 3:17" /><verse number="18" style="v" sid="EPH 3:18" />जेकोलक तुम्ही सबच पवीतर लोकगीन को सँगा यो समझन को सक्ति मिल जाहे का मसीह को माया केतरो फैलो, सबच जघा, मोठो अना गम्भीर से। <verse eid="EPH 3:18" /><verse number="19" style="v" sid="EPH 3:19" />अना तुमी मसीह को ओना माया ला जान लेव जोन सबच पिरकार लक गियान लक हटके से जेकोलक का तुमी परमेस्वर को सबच भरपुरी लक भरपुर होय जाहो।<verse eid="EPH 3:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="EPH 3:20" />अबा ओनो परमेस्वर को लाई जोन असो ताकतवर से, ओना ताकत कन लक जोन हमि मा काम करासे, की आमरी बिनती अना मन लक कहीं लगत बढ़के काम कर सकसे, <verse eid="EPH 3:20" /><verse number="21" style="v" sid="EPH 3:21" />ओको महिमा कलीसिया मा अना मसीह यीसु मा पीढ़ी लक पीढ़ी तकन जुग-जुग होवत रव्ह। आमीन।<verse eid="EPH 3:21" /></para>
  <chapter eid="EPH 3" />
  <chapter number="4" style="c" sid="EPH 4" />
  <para style="s">मसीह को बदन मा एकता</para>
  <para style="p">
    <verse number="1" style="v" sid="EPH 4:1" />एकोलाय मि जोन पिरभु को होवन को काजी बन्दी बनो हुयो सेव, तुमी लक बिनती करुसेउ का तुमला आपरो जिंदगी वसोच जीवनो चाहिसे जसो का संतहुन को से। <verse eid="EPH 4:1" /><verse number="2" style="v" sid="EPH 4:2" />हमेसा दीन रूप अना कोमलता रूप अना धीरज को सँगा बरताव करने। एक दुजो को माया लक सव्हतो रव्हने। <verse eid="EPH 4:2" /><verse number="3" style="v" sid="EPH 4:3" />उ सांती, जोन तुमला आपसी मा बांधी राखासे, ओकोलक पैदा आतमा को एकता ला बनाय राखन को लाई हर पिरकार को कोसिस करत रव्हो। <verse eid="EPH 4:3" /><verse number="4" style="v" sid="EPH 4:4" />एकच बदन अना एकच आतमा से: असोच तुमला भी जबा हाकलया गयत ता एकच आसा मा भागीदार होवन को लाई हाकलयो गयो। <verse eid="EPH 4:4" /><verse number="5" style="v" sid="EPH 4:5" />एकच पिरभु एकच, भरोसा एकच बपतिस्मा <verse eid="EPH 4:5" /><verse number="6" style="v" sid="EPH 4:6" />परमेस्वर एकच से अना उ सबको बाबूजी से। ओच सबको मालिक से हर कोनी को लक उ कामकरन वालो से, अना हर कोनी मावाच समायो हुयो से।<verse eid="EPH 4:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="EPH 4:7" />पर आमी मा लक हर मानूस ला मसीह को दया लक एक खास दान मिलीसेस। <verse eid="EPH 4:7" /><verse number="8" style="v" sid="EPH 4:8" />एकोसाठी गिंरथ कव्हसे,</para>
  <para style="q1" vid="EPH 4:8">“उ वरता पर चघयो,</para>
  <para style="q2" vid="EPH 4:8">अना बन्धुवाई ला बाँध ले गइसेस।</para>
  <para style="q2" vid="EPH 4:8">अना मानूसगिन ला दान देईसेस।”<verse eid="EPH 4:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="EPH 4:9" />अबा चोवो, जबा उ कव्हसे, उ उचो पर चघयो काजक मतलब से? केवल योच की उ धरती को खाल्या जघा मा उतरीसेस। <verse eid="EPH 4:9" /><verse number="10" style="v" sid="EPH 4:10" />अना उ जो उतरी से यो वाच से जोन सबच बादल गीन लक भी वरता चघ गयो की सबच काही पूरो कर देहे। <verse eid="EPH 4:10" /><verse number="11" style="v" sid="EPH 4:11" />ओना काही ला पेरीत, काही ला भविस्यवक्ता<note caller="+" style="f"><char style="fr" closed="false">4:11</char><char style="ft" closed="false">भविस्यवकता</char></note> काही ला साजरो बारता को सांगन वालो अना काही ला परमेस्वर को मानूस को रक्सा करनवालो पासवान<note caller="+" style="f"><char style="fr" closed="false">4:11</char><char style="ft" closed="false">रखवाला</char></note> अना काही ला गुरुजी<note caller="+" style="f"><char style="fr" closed="false">4:11</char><char style="ft" closed="false">पढ़ानेवाला</char></note> ठहराय देईसेस। <verse eid="EPH 4:11" /><verse number="12" style="v" sid="EPH 4:12" />मसीह ना उनला यो दियो दान संत मानूस की सेवा को काम को लाई तैयार करन ला देइस ताकि हमी जोन मसीह को तन सेजन, आतमा मा अखिन पिक्को होवबिन। <verse eid="EPH 4:12" /><verse number="13" style="v" sid="EPH 4:13" />जबा तकन की आमी सबच भरोसा मा अना परमेस्वर को लेकरा को गियान मा एक नही होय जावबिन। अना पक्को मानूस ना बन जावबिन, अना मसीह को पूरो डीलडोल तकन न बढ़ जावबिन। <verse eid="EPH 4:13" /><verse number="14" style="v" sid="EPH 4:14" />एकोलाई हमी असो लेकराच न बनबिन जो हर कोनी असी नयी सिक्सा को हवा लक उछल जावबिन, जो आमरो रस्ता मा बव्हसे, लोकगीन को छल परन बेवहार लक, असी कपटता लक, जो ठगावन लक भरी योजना ला पेरीत करासे, इता-उता भटकाय दियो जावसे। <verse eid="EPH 4:14" /><verse number="15" style="v" sid="EPH 4:15" />पर हमी माया को संग सत्य कव्हत हुयो हरेक पिरकार लक मसीह को जसो बनन काजी तरक्की करत जावबिन। मसीह डोस्का से, <verse eid="EPH 4:15" /><verse number="16" style="v" sid="EPH 4:16" />जोको लक सप्पा बदन, सप्पा जोड़ मा एक सँगा बँधके अना संची होयके, सप्पा बदन को बेस तरीका लक ओमा होवासे, आपरो आप ला बढ़ावसे, अना माया मा तरक्की होवासे।<verse eid="EPH 4:16" /></para>
  <para style="s">मसीह मा नवो जिंदगी</para>
  <para style="p">
    <verse number="17" style="v" sid="EPH 4:17" />एकोलाय मि यो कव्हसू अना पिरभु मा चिताव सेव की जसो खोटो काम करनवालो आपरो मन को बेकार बिचार पर जीवन करत होतीन, तुमी वसो नोको जीवन करने, <verse eid="EPH 4:17" /><verse number="18" style="v" sid="EPH 4:18" />उनको अक्कल अंधार भय गयी। वय परमेस्वर लक मिलन वारो जिंदगी लक दुहूर होय गयीसेत। काहेकि वय अगियानी अना उनको मन कठोर भय गयी से। <verse eid="EPH 4:18" /><verse number="19" style="v" sid="EPH 4:19" />वय लाज सरम ला तजके लुचपन मा लगी गयीन अना उनना आपरो आप ला इन्दरी तपस्या मा लगाय देईन। का सबरो परकार को नीच काम, लालची होयके करन लगीसेत।<verse eid="EPH 4:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="EPH 4:20" />पर मसीह को बारे मा तुमीना जोन जानीसेव, उ ता असो नहाय। <verse eid="EPH 4:20" /><verse number="21" style="v" sid="EPH 4:21" />मोलाकोनी संका नही से का तुमीना ओको बअरे मआयकिया सेव, अना उ सत्य जोन यीसु मा पायो जावसे, ओको जसो तुमला ओको चेला हुन को रूप मा सिक्सा भी दियो गयीसे। <verse eid="EPH 4:21" /><verse number="22" style="v" sid="EPH 4:22" />यहान तक तुमरो जुनो जिंदगी को तरीका को सम्बन्ध से तुमला सिक्सा दियो गयो होती का तुमी आपरो जुनो मानुसपन ला उतार फेकने जोन ओको भटकावन वारो मरजी हुन को लाई खराब बनयो हुयोसे। <verse eid="EPH 4:22" /><verse number="23" style="v" sid="EPH 4:23" />जेकोलक बुध्दि अना आतमा मा तुमला नयो कियो जाय सके। <verse eid="EPH 4:23" /><verse number="24" style="v" sid="EPH 4:24" />अना नयो मानूस रूप ला डाक लेवने, जोन परमेस्वर को जसो खराई की धरमिपन अना पवितरता मा बनायो गयो से।<verse eid="EPH 4:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="EPH 4:25" />यो काजी तुमी खोटो कव्हनो तज देने। अना आपरो पड़ोसी लक खरो सांगने, कायसेकि आमी आपस मा एक दुसरो का आँग सेजन। <verse eid="EPH 4:25" /><verse number="26" style="v" sid="EPH 4:26" />गुस्सा मा आयके पाप नोको करने। दिवस बुढ़न लक पयले अपरो गुस्सा ला साँत कर लेने। <verse eid="EPH 4:26" /><verse number="27" style="v" sid="EPH 4:27" />सैतान ला आपरो पर मौका नोको देने। <verse eid="EPH 4:27" /><verse number="28" style="v" sid="EPH 4:28" />जो चोरी करनवालो से मंग चोरी नोको करेत, पर आपरो हात लक मेहनत करेत खुदच आपरो हात लक कोनी काम, जेकोलक जरुरत मा पड़यो हुयो ला देवनको लाई ओको कठा काही होहे। <verse eid="EPH 4:28" /><verse number="29" style="v" sid="EPH 4:29" />कोनी फालतू गोस्टी तुमरो टोंड लक नही निकलनो पाहिजे, पर केवल असी गोस्टी हिटनो पाहिजे जोन ओना बेरा की जरुरत को जसो तरक्की को साठी साजरो होय, जोको लक की आयकन वालो पर दया होय। <verse eid="EPH 4:29" /><verse number="30" style="v" sid="EPH 4:30" />परमेस्वर की पवीतर आतमा ला दुखाने नोको, कहेका परमेस्वर को धन को रूप मा जोको लक तुमी पर सूटकारा को दिवस को साठी आतमा को संगा छाप लगय दियो गईसे। <verse eid="EPH 4:30" /><verse number="31" style="v" sid="EPH 4:31" />सब परकार की कडुवाहट, ताव, गुस्सा, मुसीबत अना निन्दा सब परकार को ईरसा तुमी आपरो भीतर लक हेड़ फेकने। <verse eid="EPH 4:31" /><verse number="32" style="v" sid="EPH 4:32" />आपसी मा एक दुसरो को दया अना रहमसील बनने, अना परमेस्वर ना मसीह मा जसो तुमरो गलती ला छिमा कियो गईसे। वसोच तुमी भी एक दुसरो की गलती ला छमा करने।<verse eid="EPH 4:32" /></para>
  <chapter eid="EPH 4" />
  <chapter number="5" style="c" sid="EPH 5" />
  <para style="p">
    <verse number="1" style="v" sid="EPH 5:1" />तुमी लोकगीन परमेस्वर को चहेतो सन्तान सेव एकोलाय साजरो लेकरा को जसो परमेस्वर लक जित्तो रव्हने <verse eid="EPH 5:1" /><verse number="2" style="v" sid="EPH 5:2" />अना माया मा चलोह जसो मसीह ना भी आमी लक माया करीस अना आपरो खुदच ला परमेस्वर को कठा सुख देवनवारी खुसबुदार चढ़ावा बनके आमरो लाई परमेस्वर ला चढ़ाय देईसेस<verse eid="EPH 5:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="EPH 5:3" />तुमरो बीच छीनाला अना हर कोनी तरीका को असुध्दता अना लोभ को चरचा तक नही होवनो चाहिसे, जसो का संत लोकगीन को लाई बेस से, <verse eid="EPH 5:3" /><verse number="4" style="v" sid="EPH 5:4" />तुमी मा ना त घिनोनी भासा ला काम मा नही आननो चाहसे, ना मुरखताको गोस्टी या भद्दा हसी अना ठठ्ठा। यो तुमरो जसो नही से। लेकिन तुमरो बीच धनवाद च दियो जाहे। <verse eid="EPH 5:4" /><verse number="5" style="v" sid="EPH 5:5" />कायसेकि तुमी पिक्को लक जानसेव का असो कोनी भी मानूस जोन दुराचारी सेत, अपवितर अना लोभी सेत, जो एक मुरतिपूजक होवन जसो से। मसीह को अना परमेस्वर को राज को वारसाना नही पाय सका।<verse eid="EPH 5:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="EPH 5:6" />तुमला कोनी कोरी गोस्टी लक नोको ठगेह, कायसेकि एनेच गोस्टी को कारन लक हुकूम ला नही मानन वालो पर परमेस्वर को गुस्सा कोप भई जासे। <verse eid="EPH 5:6" /><verse number="7" style="v" sid="EPH 5:7" />एकोलाय तुमी असो लोकगीन को सँगी नोको बनने। <verse eid="EPH 5:7" /><verse number="8" style="v" sid="EPH 5:8" />यो मि एकोलाई कव्ह रही सेउ का एक बेरा होतो जबा तुमी अँधार लक भरयो होतो पर अबा तुमी पिरभु को मंगा चलन वारा को रूप मा उजाड़ो लक भरपुरो होय। एकोलाई उजाड़ो को टूरा को जसो सुभाव करने। <verse eid="EPH 5:8" /><verse number="9" style="v" sid="EPH 5:9" />काहेकि उजियाड़ो को फर सब परकार को भलो काम अना धरमिपन अना सत्य से। <verse eid="EPH 5:9" /><verse number="10" style="v" sid="EPH 5:10" />हरेक बेरा यो परखन को जतन करो का परमेस्वर ला कोनतो गोस्टी खुस करासे। <verse eid="EPH 5:10" /><verse number="11" style="v" sid="EPH 5:11" />असो काम जोन अंधार लक भरयो सेत, उन बेकार को काम मा हिस्सा नोको बाटने पर उनको भाडा फोड़ करने। <verse eid="EPH 5:11" /><verse number="12" style="v" sid="EPH 5:12" />काहेकि जोन काम छुपयो मा उनको कन लक कियो जासे। उनको गोस्टी ला करनो भी सरम करनो जसो से। <verse eid="EPH 5:12" /><verse number="13" style="v" sid="EPH 5:13" />पर जोन काम ला परगट कियो जासे। वय सबच उजियाड़ो लक परगट होसेत, काहेकि जोन सबच काही ला परगट करासे, उ उजियाड़ो से। <verse eid="EPH 5:13" /><verse number="14" style="v" sid="EPH 5:14" />येनेच कारन लक यीसु कवत होतो की अगो झोपन वालो,</para>
  <para style="q1" vid="EPH 5:14">जपलक उठना,</para>
  <para style="q2" vid="EPH 5:14">अना मरयो हुयो लक जित्तो होय,</para>
  <para style="q1" vid="EPH 5:14">तो मसीह की उजियाड़ो तोरो पर चमकेह।<verse eid="EPH 5:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="EPH 5:15" />एकोलाय सतरक रवह, की तुमी कसी चाल चला सो। बेअकल को जसो नही बल्कि अकलवर को जसो चलोह। <verse eid="EPH 5:15" /><verse number="16" style="v" sid="EPH 5:16" />बेरा ला पूरो-पूरो साजरो करम करन लाई बोवजने, कायसेकि दिवस बुरा सेति। <verse eid="EPH 5:16" /><verse number="17" style="v" sid="EPH 5:17" />ऐना कारन बेअकल नोको बनो, पर यो जान लेव की पिरभु की मनसा काजक से।<verse eid="EPH 5:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="EPH 5:18" />दारू ला पीवके बोलनवारा ना होवने, काहेकि एको लक लुच्चाई होवासे, पर एको उलट आतमा लक भरजाव। <verse eid="EPH 5:18" /><verse number="19" style="v" sid="EPH 5:19" />आपसी मा भजन पिराथना गान अना आतमिक गीत गावने अना आपरो-आपरो मन मा पिरभु लाई गावत अना किरतन करत रव्हने। <verse eid="EPH 5:19" /><verse number="20" style="v" sid="EPH 5:20" />सबच कोनी गोस्टी को लाई आमरो पिरभु यीसु मसीह को नाव पर हमरो मोठो बाबूजी परमेस्वर को हरदम धनवाद करने।<verse eid="EPH 5:20" /></para>
  <para style="s">बायको अना मरदमाना</para>
  <para style="p">
    <verse number="21" style="v" sid="EPH 5:21" />अना मसीह को डर लक एक दुसरो को आसरीत रव्हने।<verse eid="EPH 5:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="EPH 5:22" />ओ बायकोहुन आपरो-आपरो घरवालो को आसरीत रव्होने, जसो की तुमी पिरभु को आसरीत सेव। <verse eid="EPH 5:22" /><verse number="23" style="v" sid="EPH 5:23" />कायसेकि नौरा ता बायको को डोस्का से, जोन परकार लक मसीह भी कलीसिया को डोस्का से। अना खुदच बदन को पाप हरन वालो पाप मोचक से। <verse eid="EPH 5:23" /><verse number="24" style="v" sid="EPH 5:24" />पर जसो कलीसिया मसीह को वस मा सेत, वसोच बायकोगीन भी हरेक गोस्टी मा आपरो-आपरो घरवालो को वस मा रव्हनो जरुरि सेत।<verse eid="EPH 5:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="EPH 5:25" />ओय घरवालो आपरी बायको लक माया करने। वसोच का जसो मसीह ना भी कलीसिया लक माया राखिसेस, अना आपरो खदच ला ओन्हीसीन लाई चघाय देइसेस। <verse eid="EPH 5:25" /><verse number="26" style="v" sid="EPH 5:26" />जेकोलक का उ ओला पिरभु को सेवा मा पानी को नहावनो लक पवीतर करके हमरो आवाज पुकारन लक परमेस्वर ला चघायके पवीतर बनाय। <verse eid="EPH 5:26" /><verse number="27" style="v" sid="EPH 5:27" />एने रीती उ कलीसिया ला एक असी नवती नौरी को उपमा मा खुदच को लाई पेस कर सकासे जोन बेडाग होय, बेझुर्रि होय असी अखिन कोनी कमी नही होय। बल्कि उ पवितर रव्हे अना हरदम बेकसूर होय। <verse eid="EPH 5:27" /><verse number="28" style="v" sid="EPH 5:28" />ऐना तरीका लक जरुरी से की नौरा भी आपरो बायको लक आपरो बदन को जसो माया करेत, जोन आपरो बायको लक माया करासे। उ खुदच आपरो आप लक माया राखासे। <verse eid="EPH 5:28" /><verse number="29" style="v" sid="EPH 5:29" />कोनी आपरो बदन लक ता कबच गुस्सा नही राखा पर उ ओला पाला पोससे, अना ओको धियान राखासे वसोच जसो मसीह आपरी कलीसिया को <verse eid="EPH 5:29" /><verse number="30" style="v" sid="EPH 5:30" />काहेकि आमी ओको बदन को हिस्सा सेजन। <verse eid="EPH 5:30" /><verse number="31" style="v" sid="EPH 5:31" />एकोलाई गिरंथ कव्हसे: “मानूस आपरो माय-बाबूजी ला छोड़के आपरी बायको लक मिलयो रहयो। अना वय दुही एक बदन होयेती।” <verse eid="EPH 5:31" /><verse number="32" style="v" sid="EPH 5:32" />यो छुपयो गोस्टी लगत काम की से, पर मि यो गोस्टी मसीह अना कलीसिया को बारे मा कव्ह रही सेव। <verse eid="EPH 5:32" /><verse number="33" style="v" sid="EPH 5:33" />एकोलाई काही भी होय, तुममा ला हरेक ला आपरी बायको लक वसोच माया करनो चाहिसे जसो तुमी खुदच अपरो आपला करोसो। अना एक बायको ला भी आपरो मरद को डर मानत हुयो ओको मान करनो चाहिसे।<verse eid="EPH 5:33" /></para>
  <chapter eid="EPH 5" />
  <chapter number="6" style="c" sid="EPH 6" />
  <para style="s">लेकरा अना माय बाबूजी</para>
  <para style="p">
    <verse number="1" style="v" sid="EPH 6:1" />अरे लेकरागीन, पिरभु मा आपरो माय-बाबूजी को हुकूम ला मानोह, काहेकि योच बेस से। <verse eid="EPH 6:1" /><verse number="2" style="v" sid="EPH 6:2" />“आपरो माय बाबूजी को आदर करो”, यो पयली हुकूम से, जोको सँग परन भी से। <verse eid="EPH 6:2" /><verse number="3" style="v" sid="EPH 6:3" />“जोको लक तोरो सँग साजरो होय अना तु धरती पर लगत दिवस जित्तो रव्हजोस।” <verse eid="EPH 6:3" /><verse number="4" style="v" sid="EPH 6:4" />अगो बाबूजी गीन, तुमी आपरो लेकरागीन ला गुस्सा नोको दिलाने, पर पिरभु को सिक्सा अना दियो गयो हुकूम मा उनको पालन पोसन करहो।<verse eid="EPH 6:4" /></para>
  <para style="s">नौकर अना मालिक</para>
  <para style="p">
    <verse number="5" style="v" sid="EPH 6:5" />हे नौकर गीन जसो तुमी मसीह को हुकूम मानसो, ओनो रिती लक डरात अना कापत बिनकपट को सच्चो मन लक उनको भी हुकूम मानोह जोन आँग को रितीलक तुमरो मालिक सेत। <verse eid="EPH 6:5" /><verse number="6" style="v" sid="EPH 6:6" />मानूस ला खुस करन जसो नही, पर मसीह को नौकर को जसो हिरदय लक परमेस्वर को मरजी ला पूरी करहो। <verse eid="EPH 6:6" /><verse number="7" style="v" sid="EPH 6:7" />जोस को संगा एक नौकर को रूप मा असो काम करोह मानोह जसो यो सेवा ला मानूस की नही पर, पिरभु को जानके साजरी मरजी लक करहो। <verse eid="EPH 6:7" /><verse number="8" style="v" sid="EPH 6:8" />असो जानके क, चाहे नौकर होय, छुट्टो होय, अदि कोनी साजरो काम करासे, उ पिरभु लक वसोच ईनाम पाहे।<verse eid="EPH 6:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="EPH 6:9" />हे मालिक गीन, तुमी भी धमकी देवनो छोड़ो अना उनको सँग असो बेवहार करने। हेत राखो, काहेका तुमी जानसो, का उनको अना तुमरो दुई को मालिक सरग मा सेत, अना उ कोनी को पक्स नही करासेत।<verse eid="EPH 6:9" /></para>
  <para style="s">पिरभु को अभेद हतियार धर लेव</para>
  <para style="p">
    <verse number="10" style="v" sid="EPH 6:10" />मतलब यो से का पिरभु मा रव्ह के ओकी लगत च ताकत को संग आपरो आपला ताकतवर बनावो। <verse eid="EPH 6:10" /><verse number="11" style="v" sid="EPH 6:11" />परमेस्वर को पुरोच हतियार ला धर लेवो। ताकि तुमी सैतान को योजना ला सामना कर सकोह। <verse eid="EPH 6:11" /><verse number="12" style="v" sid="EPH 6:12" />काहेकि आमरो लड़ाई ता तन को लक नहाय, बल्कि सब लक मोठो मुखिया, अधिकारी अँधियारो को संसारिक ताकत अना दुस्टता राखन वालो आतमिक सेना लक से, जोन बादल मा रव्हसेत। <verse eid="EPH 6:12" /><verse number="13" style="v" sid="EPH 6:13" />एकोलाय परमेस्वर को सबच हतियार डाक लेवने, जोको लक तुमी बुरो दिवस मा सामना कर सकहो अना सबच काही पूरो करके पक्को रव्ह सकने।<figure style="fig" alt="Roman soldier" file="LB00196C.TIF" size="col" copy="Horace Knowles ©" ref="6:10">रोमन सिपाही</figure><verse eid="EPH 6:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="EPH 6:14" />ऐना रिती लक खराई लक नोको चुकने अना धरमी बनयो रव्हने, <verse eid="EPH 6:14" /><verse number="15" style="v" sid="EPH 6:15" />पाय मा मेल मिलाप को साजरो बारता को तैय्यारी को पनही डाकके पक्को रव्हने। <verse eid="EPH 6:15" /><verse number="16" style="v" sid="EPH 6:16" />एने सबलक मोठी गोस्टी यो से का भरोसा को ढाल को रूप मा ले लेवो। जोको लक तुमी ओनो सबच जलतो हुयो तीर हुन ला बुझाय सको, जो बदी को कनलक छोड़यो गयी सेत। <verse eid="EPH 6:16" /><verse number="17" style="v" sid="EPH 6:17" />अना सूटकारा को टोप अना आतमा को तलवार, जोन को परमेस्वर गोस्टी जो की आतमा को तलवार से, लेव लेने। <verse eid="EPH 6:17" /><verse number="18" style="v" sid="EPH 6:18" />हरेक बिनती अना बिनती लक पवीतर आतमा मा सदा पिराथना करत रव्हने। अना यो मन मा हेत राखके सतरक रव्हने की कोसिस लक सबच पवीतर लोकगीन को साठी सदा पिराथना करतो रवहने। <verse eid="EPH 6:18" /><verse number="19" style="v" sid="EPH 6:19" />अना मोरो लाई भी पिराथना करने की बोलतो बेरा मोला असो ताकत को गोस्टी दियो जाय की मि हिम्मत लक साजरो बारता को छुपयो गोस्टी ला दिखाय सकुह। <verse eid="EPH 6:19" /><verse number="20" style="v" sid="EPH 6:20" />जोको लाई मि साकल लक बँधयो हुयो राजदुत जसो सेवा कर रही सेउ। पिराथना करने की मि जेना रीती लक मोला बोलनो से, ओनोच रिती लक बगैर डर को संगा साजरो बारता को पिरवचन कर सकू।<verse eid="EPH 6:20" /></para>
  <para style="s">आखरी हात जोड़नो</para>
  <para style="p">
    <verse number="21" style="v" sid="EPH 6:21" />तुखिकुस, जोन माया वालो भाऊ से अना पिरभु मा बिस्वास लायक दास से, तुमला मोरो हाल को बारे मा सांगेह की तुमी जान सकोह की मि कोन सो हाल मा सेव। <verse eid="EPH 6:21" /><verse number="22" style="v" sid="EPH 6:22" />मि ओला यो मतलब लक तुमरो कठा धाड़ रही सेव की तुमी आमरो बारे मा जान सकोह अना उ तुमरो दिल मा सान्ती दे सके।<verse eid="EPH 6:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="EPH 6:23" />अगो भाऊहुन, तुमी सब ला मोठो परमेस्वर बाबूजी अना पिरभु यीसु मसीह कन लक सान्ती अना भरोसा सकट माया मिलेह। <verse eid="EPH 6:23" /><verse number="24" style="v" sid="EPH 6:24" />जोन आमरो पिरभु यीसु मसीह लक खरो माया राखासे; उन पर परमेस्वर को किरपा होवती रह।<verse eid="EPH 6:24" /></para>
  <chapter eid="EPH 6" />
</usx>