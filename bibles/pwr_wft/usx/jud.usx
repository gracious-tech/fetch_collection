<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="JUD" style="id">- Powari Standard Project</book>
  <para style="h">यहूदा</para>
  <para style="toc3">यहूदा</para>
  <para style="toc2">यहूदा</para>
  <para style="toc1">यहूदा को चिठ्ठी</para>
  <para style="mt2">यहूदा का पत्र</para>
  <para style="mt1">यहूदा को चिठ्ठी</para>
  <para style="imt">परिचय</para>
  <para style="ip">यहूदा नावको चिठ्ठी एको लेखक को नाव पर राखयो गयो से। यहूदा खुदला यीसु को भाऊ, याकूब को रूपमा पेहचान करावासे। एकोलाय वोला यीसु को भाऊ गीन लक एक मानो जावासे 1। अमीला मालुम नाहती का यो चिठ्ठी एक खास चरच को लाय होतो। अखीन जूनो करार को परसंग को कारन, यहूदा को मूल वाचन वारो यहुदीगीन होतिन। हालाँकि, उ आपरो चिठ्ठी ला “उन सबा को नाव संबोधित करासे, जोन बुलायो गयो सेत। जोन परमेस्वर अजी लक पिरेम कियो जावासे, अखीन यीसु मसीह को लाय रखो जावासे।” यो चिठ्ठी साईद यीसु को जलम को 60 साल को आखापाखा लिखयो गयो से।</para>
  <para style="ip">सब ईसाई गिनला चिठ्ठी लिखन को वोको उद्देस्य उनला खोटो सिक्सक कन लक बरगलान को खिलाप चेतावनी देवासे। <char style="xt"><ref loc="JUD 1:4">यहूदा 4</ref></char> उ आपरो तरक ला बल देवन को लाय जूनो करार को घटना परसंग देवासे। यो चिठ्ठी 2 पतरस को संग लगत बिचार को साझा करासे। जोन लक खोटो सिक्सक को खिलाप चेतावनी <char style="xt"><ref loc="JUD 1:4">यहूदा 1:4</ref></char> <char style="xt"><ref loc="2PE 2:1">2 पतरस 2:1</ref></char> को संग-संग सरगदूत गीन अखीन सदोम अना अमोरा को सर्न्दभ सामिल से।</para>
  <para style="iot">रूपरेखा</para>
  <para style="io1">1. यहूदा पहले आपरो बाचन वालो ला संबोधित करासे। <char style="ior"><ref loc="JUD 1:1-2">1:1-2</ref></char></para>
  <para style="io1">2. मंग उ लिखन को आपरो कारन सांगासे। जोन वोला खोटो सिक्सक गीनको खिलाप चेतावनी देवनो से। <char style="ior"><ref loc="JUD 1:3-4">1:3-4</ref> </char></para>
  <para style="io1">3. मंग उ जूनो करार मा लोक गिनको घटना को उदाहरन देवासे। <char style="ior"><ref loc="JUD 1:5-16">1:5-16</ref></char></para>
  <para style="io1">4. मंग उनला सांगासे का चेतावनी को लाय उनको काजक परतिकिरिया होवनो पाहिजे। <char style="ior"><ref loc="JUD 1:17-23">1:17-23</ref></char></para>
  <para style="io1">5. अखट्ट मा परमेस्वर को स्तुति करतो हुयो चिठ्ठी ला बंद करासे। <char style="ior"><ref loc="JUD 1:24-25">1:24-25</ref></char></para>
  <chapter number="1" style="c" sid="JUD 1"/>
  <para style="s">अभिवादन</para>
  <para style="p">
    <verse number="1" style="v" sid="JUD 1:1"/>यो चिठ्ठी यीसु मसीह को दास अना याकूब को भाऊ यहूदा को कन लक, उन हाक्लियो लोकगीन को नाव लाई से जोन परमेस्वर बाबूजी मा चहेतो, अना यीसु मसीह को आवन को लाई सुरक्सित सेत।<verse eid="JUD 1:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="JUD 1:2"/>तुमी लोकहुन ला दया, सान्ती अना माया लगत भरपुरी मा मिलतो रव्हे।<verse eid="JUD 1:2"/></para>
  <para style="s">वाईट सिक्सा देवनवारा सिक्सक</para>
  <para style="p">
    <verse number="3" style="v" sid="JUD 1:3"/>अगो चहेतो संगी हुन, अखिन भी मि लगत चाव्हत होतो का तुमला ओनो सूटकारा को बिसय मा लिखु, जोको आमी हिस्सेदार सेजन। मिना तुमीला लिखन की अना तुमला बढ़ावा देन की जरुरत सोचयो ताकि तुमी ओनो बिस्वास को लाई मेहनत करत रव्हो जेनला सब लक मोठो परमेस्वर ना संत मानूस हुन ला हमेसा को लाई दे दियो से। <verse eid="JUD 1:3"/><verse number="4" style="v" sid="JUD 1:4"/>काहेकि आमरो बीच मा काही लोक चोरी लक आय घुसी सेत ऐना लोकहुन को सजा को बारे मा गिरंथ ना लगत पयलेच भविस्यवानी कर देयि होतिस। यो लोक बिना परमेस्वर को सेत। एना लोकहुन परमेस्वर को किरपा ला सुख सुविदा को एक बहाना बनाय डाकीसेत अना यो आमरो पिरभु अना केवल एक मालिक यीसु मसीह ला नही मानासेत।<verse eid="JUD 1:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="JUD 1:5"/>मि तुमला हेत करावनो चाव्हसेउ अना तुमी ता ऐना सबच गोस्टी ला जानासो का जोन पिरभु ना पयले आपरो लोकहुन ला मिसर की धरती लक हेड़ के आनिस, मंग मा जिनना बिस्वास ला नकार देईन उनला कसो लक नास कर देयो गयो। <verse eid="JUD 1:5"/><verse number="6" style="v" sid="JUD 1:6"/>मंग जेना सरगदूत गीन ना आपरो पद ला संभाल नही सकिन अना खुद को रव्हन को जघा ला तज देईन, ओना उनला ओना मुसीबत को दिवस को नियाव को लाई इंधारो मा जोन अमर बेरा को लाई से, बंधन मा राखीसेस। <verse eid="JUD 1:6"/><verse number="7" style="v" sid="JUD 1:7"/>जेना रिति लक सदोम गमोरा अना उनको आखा पाखा को नगर ना उन सरगदुतगीन को जसो छिंडरा करीन अखिन वय सुभाव को बिरोध वासना को दास बन गयीन। उनला कबच ना बुझनवारी स्तो मा झोक देन को सजा दियो गयीसे। वय आमला चेतावनी देन को रुप मा पायी जासे।<verse eid="JUD 1:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="JUD 1:8"/>बेस ऐना रिती आमरो झुंड मा घुसन वारा यो लोक आपरो सपना को मंघा परात हुया आपरो तन ला अपवितर कररही सेत यो पिरभु को ताकत ला उचलके ताक पर राख देसेत अना पिरभुता ला बेकार समझत अना सरग को रव्हन वारो भेद को निन्दा करासेत। <verse eid="JUD 1:8"/><verse number="9" style="v" sid="JUD 1:9"/>पर मोठो सरगदुत मीकाईल न, जबा सैतान को संगा विवाद करतो हुयो मोसे को लास को बारे मा बैस कर रहयो होतो त वोला निन्दा कव्हके नियाव करन की हिम्मत नही जुटा सकिस। पर ओना केवल असो कहीस का “पिरभु तोला डाटहे।” <verse eid="JUD 1:9"/><verse number="10" style="v" sid="JUD 1:10"/>पर असो लोकगीन जोन गोस्टी ला नही समझासेत पर उनला बदनाम करासेत, जोन गोस्टी गीन ला बेडीमाक जनावर को जसो सुभाव च लक जसो जानासेत अना उनमा अपरो आपच ला नास करासेत। <verse eid="JUD 1:10"/><verse number="11" style="v" sid="JUD 1:11"/>उन लोक हुन को लाई यो लगत बुरो से का उनना कैन को सो वाच रास्ता बेचयीसेस। न कमान को लाई उनना आपरो आपला वसोच गलतीको सुपुरुत कर देईस जसो बिलाम ना करयो होतो। एकोलाई वयच नास होय जाहेत जसो कोरह को बिरोध मा पराय लेवन वालो नास कर देयो गयो होतीन। <verse eid="JUD 1:11"/><verse number="12" style="v" sid="JUD 1:12"/>यो लोकगीन तुमरी जेवनार मा उन छुपी हुयी चट्टानगीन को जसो सेत जो नुकसानदायक से। यो लोक बिना डर को संगा तुमरो संग खासेत पीसेत पर उनला केवल आपरो सुवारत को च चिंता रव्हसेत। वय बिना पानी को बादर सेत। वय पतझड़ को कसा झाड़ सेत जिन पर फर नही होवासे। वय जोड़ामरा हुया सेत। उनला उखाड़ो जा चकी से। <verse eid="JUD 1:12"/><verse number="13" style="v" sid="JUD 1:13"/>वय समुंदर को असो भयानक हिलोर सेत, जोन अपरी लाज की फेस उचलासे यो डावाडोल तारा सेत, जोन लाई सदा बेरा तकन घोर अंधार ठहरायी गई से।<verse eid="JUD 1:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="JUD 1:14"/>हनोक न भी जोन आदम लक सातई पीड़ी मा होतो, ऐको बारे मा असो आवन वारो गोस्टी कव्हसे, “देखो, पिरभु आपरो हजारो हजार सरगदुतहुन को संगा। <verse eid="JUD 1:14"/><verse number="15" style="v" sid="JUD 1:15"/>सबच लोकहुन को नियाव करन लाई आय रही से। ताकि लोकहुन ना जोन खोटो काम करीसेत, उनला उनको लाई अना उनना जोन परमेस्वर को बिरोध मा खोटो गोस्टी बोलीसेत, उनको लाई सजा देहे।”<verse eid="JUD 1:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="JUD 1:16"/>यो लोक चुगली करनवारा सेत, अना दोस खोजन वारा सेत। यो लोक आपरी मरजी हुन को दास सेत अना आपरो टोंड लक घमन्ड भरी गोस्टी बोलसेत आपरो फायदा को लाई यो दुसरो की मियामिठठु करासेत।<verse eid="JUD 1:16"/></para>
  <para style="s">चेतावनी अना सिक्सा</para>
  <para style="p">
    <verse number="17" style="v" sid="JUD 1:17"/>अगा चहेतो, तुमी वोना अक्सर गीन ला हेत राखो, जोन हमरो पिरभु यीसु मसीह को पेरीत पहेले च कह चुकयो से। <verse eid="JUD 1:17"/><verse number="18" style="v" sid="JUD 1:18"/>वय तुमला कव्हत होतीन “अखठ्ठ बेरा मा असो ठट्ठा करनवारा लोक होहेत जोन परमेस्वर लक जोन काही चीज जुड़यो से। जोन अपरी अभक्‍ति की आस को जसो चलहेत<note caller="-" style="x"><char style="xo" closed="false">1:18 </char><char style="xt" closed="false"><ref loc="2PE 3:3">2 पतरस 3:3</ref></char></note>।” <verse eid="JUD 1:18"/><verse number="19" style="v" sid="JUD 1:19"/>यो लोक वाच सेत जोन फूट डाकासेत; <verse eid="JUD 1:19"/><verse number="20" style="v" sid="JUD 1:20"/>यो वय लोक सेत, जोन मा आतमा नाहती पर अगा चहेतो संगी, तुमी एक दुसरो ला आत्मिक रुप लक आपरो लगत पवितर भरोसा मा पिक्को करत रव्हो। पवितर आतमा को संगा पिरातना करने। <verse eid="JUD 1:20"/><verse number="21" style="v" sid="JUD 1:21"/>आमरो पिरभु यीसु मसीह को दया अना पिरेम को रास्ता चोतो हुयो जोन तुमला अमर जिंदगी तक ले जाहे परमेस्वर को भक्ति मा लीन रव्हो।<verse eid="JUD 1:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="JUD 1:22"/>उन्ही पर जोन संका मा सेत दया करने; <verse eid="JUD 1:22"/><verse number="23" style="v" sid="JUD 1:23"/>अना लगतगीन ला स्तो मा लक झपटके बचाय लेव अना लगत च पर भेव को संगा दया करनो, पर उनको उन कपरा लक भी घिरना करो जो पाप को सुभाव को कन लक कलंकित भय गयो से।<verse eid="JUD 1:23"/></para>
  <para style="s">परमेस्वर को स्तुति</para>
  <para style="p">
    <verse number="24" style="v" sid="JUD 1:24"/>अबा जोन तुमला ठोकर खानो लक बचाय सकासे, अना अपरी महिमा की भरपूरी पुड़ा मगन अना बेकसूर करके उभो कर सकासे। <verse eid="JUD 1:24"/><verse number="25" style="v" sid="JUD 1:25"/>हमरो पिरभु यीसु मसीह को कन लक हमरो परमेस्वर आमरो पाप मोचक की महिमा अना उचो नाव अखीन मोठो ताकत अना अधिकार, जसो अमर बेरा लक से। अबा तक होवासे अना जुगन जुग तक बनो रव्हे। आमेन!<verse eid="JUD 1:25"/></para>
  <chapter eid="JUD 1"/>
</usx>
