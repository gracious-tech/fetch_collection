<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="2TH" style="id">- Powari standard Project</book>
  <para style="h">2 थिस्सलुनीकियो</para>
  <para style="toc3">2 थिस्सलुनीकियो</para>
  <para style="toc2">2 थिस्सलुनीकियो</para>
  <para style="toc1">थिस्सलुनीकियो को नाव पौलुस को दुसरो चिठ्ठी</para>
  <para style="mt2">थिस्सलुनीकियो के नाव पौलुस की दुसरा पत्र</para>
  <para style="mt1">थिस्सलुनीकियो को नाव पौलुस की दुसरो चिठ्ठी</para>
  <para style="imt">परिचय</para>
  <para style="ip">यो थिस्सलुनीकियों ला लिख्यो गयो पौलुस को दूसरो चिठ्ठी <char style="xt"><ref loc="2TH 1:1">1:1</ref></char> पहिली चिठ्ठी लिखन को बाद यो चिठ्ठी करीब मसीह को जलम को 51 साल बाद लिख्यो से। जब ओना यो चिठ्ठी लिख्यो तब वा कुरिन्थियों सहर मा होतो यो चिठ्ठी जोन थिस्सलुनीकियों कलीसिया मा लिख्यो गयो होतो, यो पौलुस ना आपरो दूसरो मिसनरी यातरा को बीचमा स्थापित करयो <char style="xt"><ref loc="ACT 17:1-10">पेरीत 17:1-10</ref></char> यो कलीसिया यहूदी अखिन गैरयहूदी गीन लक बनयो होतो।</para>
  <para style="ip">यो कलीसिया को लोख आखरी बेरा मा अखिन पिरभू को दूसरों बार आवनो को बारे मा जानन को लायी लगत लहाकी करत होतिन, येकोलायी पौलुस आपरो दोयी चिठ्ठी मा यो गोस्टी को जिकर करत होतो। यो दूसरी थिस्सलुनीकियों की चिठ्ठी आय अरधो लक जादा हिस्सा आखरी बेरा को बारे मा से, जोन अलाल सेत, उनको बारेमा भी जिकर करयो से। अखिन यो कह्यो से का हर एक मानूस आपरो जीवन करन को लायी काम करे <char style="xt"><ref loc="2TH 3:6-10">3:6-10</ref></char></para>
  <para style="iot">रुपरेखा</para>
  <para style="io1">1. पौलुस खुद को अखिन आपरो संगी गिनको को परिचय देवा से। <char style="ior"><ref loc="2TH 1:1-2">1:1-2</ref></char></para>
  <para style="io1">2. पौलुस परमेस्वर को थिस्सलुनीकियों की कलीसिया को लाय धन्यवाद करासे, अखिन उनको लायी पिराथना करासे। <char style="ior"><ref loc="2TH 1:3-12">1:3-12</ref> </char></para>
  <para style="io1">3. आखरी बेरा को बारेमा चरचा। <char style="ior"><ref loc="2TH 2">2</ref> </char></para>
  <para style="io1">4. अलाली को विरोध मा अखिन मेहनत की जरूरत को बारे मा पौलुस की सिक्सा। <char style="ior"><ref loc="2TH 3:1-15">3:1-15</ref></char></para>
  <para style="io1">5. पौलुस को कलीसिया ला दूबारा लक नमस्कार। <char style="ior"><ref loc="2TH 3:16-18">3:16-18</ref> </char></para>
  <chapter number="1" style="c" sid="2TH 1"/>
  <para style="s">सुभ कामना</para>
  <para style="p">
    <verse number="1" style="v" sid="2TH 1:1"/>पौलुस अना सिलवानुस अना तीमुथियुस को कन लक चिठ्ठी थिस्सलुनीकिया की कलीसिया को नाव, जोन आमरो बाबूजी परमेस्वर अना पिरभु यीसु मसीह मा आय। <verse eid="2TH 1:1"/><verse number="2" style="v" sid="2TH 1:2"/>आमरो बाबूजी परमेस्वर अना पिरभु यीसु मसीह को कन लक तुमला दया अना सान्ती मिलहे।<verse eid="2TH 1:2"/></para>
  <para style="s">नियाव को दिवस मसीह को आवनो</para>
  <para style="p">
    <verse number="3" style="v" sid="2TH 1:3"/>अगो भाऊगीन, तुमरो बारे मा आमला सबच बेरा परमेस्वर को धनवाद करनो चाव्हसे, यो जरुरी से, एको साठी की तुमरो भरोसा लगत बढ़ जावसे, अना तुमी सबच को माया आपसी मा लगत बढ़ जावसे। <verse eid="2TH 1:3"/><verse number="4" style="v" sid="2TH 1:4"/>यहान तका की आमी खुदच परमेस्वर की कलीसिया मा तुमरो बारे मा घमंड करसेजन की जेतरा सताव अना दुख तुमी सहिसेव, ओनो सबच मा तुमरो धीरज अना भरोसा परगट होवासेत।<verse eid="2TH 1:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="2TH 1:5"/>तुमी परमेस्वर को राज मा काबिल ठहरायो जाहो, जोकोलक तुमी दुख भी उचल रही सेव। यो परमेस्वर को खरो न्याय को खरो सबुत से <verse eid="2TH 1:5"/><verse number="6" style="v" sid="2TH 1:6"/>जोन तुमीला दुख देवासेत, उनला ओको बदला मा दुख दियो जाहे। काहेका परमेस्वर को कठा असो न्याय से। <verse eid="2TH 1:6"/><verse number="7" style="v" sid="2TH 1:7"/>तुमी जोन दुख पावासो, आमरो सँग मा सुख देहे; ओनो बेरा मा पिरभु यीसु आपरो ताकत वर सरगदूत गीन को सँगा सरग लक धधकती स्तो को जसो परगट होहेत। <verse eid="2TH 1:7"/><verse number="8" style="v" sid="2TH 1:8"/>अना जोन परमेस्वर ला नही चिन्हसेत अना आमरो पिरभु यीसु को साजरो बारता ला नही मानासेत, उनलक बदला लेहे। <verse eid="2TH 1:8"/><verse number="9" style="v" sid="2TH 1:9"/>वय पिरभु को पुढ़ा लक महिमा अना ओको ताकत लक दुर भय जाहेत अना अमर नास को सजा पाहेति। <verse eid="2TH 1:9"/><verse number="10" style="v" sid="2TH 1:10"/>यो दिवस तबा होहे जबा यीसु आपरो पवीतर लोकगीन मा महिमा पावन अना सबच भरोसा करनवालो मा अचंभा<note caller="+" style="f"><char style="fr" closed="false">1:10</char><char style="ft" closed="false">अचंभा</char></note> को कारन होवन साठी आहे। काहेका तुमीना आमरो गवाही पर भरोसा करयत।<verse eid="2TH 1:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="2TH 1:11"/>आमरो परमेस्वर तुमला यो बुलाहट काजी काबिल समझसे, अना भलाई को मनसा अना भरोसा को काज-काम ला ताकत सकट पूरो करेत एकोसाठी आमी तुमरो लाई पिराथना भी करसेजन। <verse eid="2TH 1:11"/><verse number="12" style="v" sid="2TH 1:12"/>आमरो परमेस्वर जोन सब लक वरता से अना पिरभु यीसु मसीह को किरपा को काजी जसो तुममा पिरभु यीसु मसीह को नाव बड़ाई पावसे अना तुमी ओको कारन बड़ाई पावासो।<verse eid="2TH 1:12"/></para>
  <chapter eid="2TH 1"/>
  <chapter number="2" style="c" sid="2TH 2"/>
  <para style="s">अधरमी मानूस</para>
  <para style="p">
    <verse number="1" style="v" sid="2TH 2:1"/>अगो भाऊगीन अबा आमी आपरो पिरभु यीसु मसीह को आवन को बारे मा अना ओको कठा तुमरो एकठ्ठो होवन को बारे मा तुमी लक बिनती करसेजन <verse eid="2TH 2:1"/><verse number="2" style="v" sid="2TH 2:2"/>का कोनी आतमा लक या गोस्टी या चिठ्ठी लक जोन की मानो आमरो कनलक होवासे, यो आयक के का पिरभु को दिवस आय गई से, तुमरो मन एकदम बेचित्त नही होयहेत अना तुमरो मन नोको घबराहे। <verse eid="2TH 2:2"/><verse number="3" style="v" sid="2TH 2:3"/>काही रिती लक कोनी को दगा मा नोको आवनो, काहेका उ दिवस आहे जबा तकन धरम ला तज दियो जाहे। अखीन “खोटो करम वालो नास वालो मानूस” परगट ना होयहेत। <verse eid="2TH 2:3"/><verse number="4" style="v" sid="2TH 2:4"/>जोन विरोध करासे, अना हरेक जोन परमेस्वर या पुजा को लायक<note caller="+" style="f"><char style="fr" closed="false">2:4</char><char style="ft" closed="false">महान</char></note> कहलावासे, उनलक आपरो आप ला मोठो दिसावसे। यहान तकन की उ सब लक वरता पायो जावनवालो परमेस्वर को मंदिर मा बसके आपरो आप ला परमेस्वर साँगासे।<verse eid="2TH 2:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="2TH 2:5"/>का तुमला हेत नहाति का मि तुमरो यहान होतो, ता तुमला यो गोस्टी साँगत होतो? <verse eid="2TH 2:5"/><verse number="6" style="v" sid="2TH 2:6"/>जो ओला अबा रोक लेई सेस का उ आपरो बेरा मा दिसे। तुमी ओनो चीज ला जानासो <verse eid="2TH 2:6"/><verse number="7" style="v" sid="2TH 2:7"/>काहेकि अन्याय को राज<note caller="+" style="f"><char style="fr" closed="false">2:7</char><char style="ft" closed="false">सैतान का भेद</char></note> अबा भी काम कर रही से काहेका एक रोकनवालो खोटो करम से; अना जबा तकन उ दुहुर नही होहे, उ रोकत रह। <verse eid="2TH 2:7"/><verse number="8" style="v" sid="2TH 2:8"/>तबा उ अधरमी दिसे जेनला पिरभु यीसु आपरो टोंड लक फुँक के जान लक मार डाकेह अना आपरो आवन को तेज लक भस्म कर देहे। <verse eid="2TH 2:8"/><verse number="9" style="v" sid="2TH 2:9"/>ओनो अधरमी को आनो असो होहे जसो सैतान को कामकाज को जसो का सबच तरीको को झुठी ताकत अना चिन्ह अना अचँभा काम को सँगा <verse eid="2TH 2:9"/><verse number="10" style="v" sid="2TH 2:10"/>अना नास होवन वालो को साठी अन्याय को धोखा को सँगा होहे; काहेकि उनना खराई लक माया नही राखिन जेनको लक उनको सुटकारा होतो। <verse eid="2TH 2:10"/><verse number="11" style="v" sid="2TH 2:11"/>योच कारन लक परमेस्वर उनमा एक भटकावन वालो ताकत ला धाड़े जोकोलक की वय झुठो को भरोसा करहेति, <verse eid="2TH 2:11"/><verse number="12" style="v" sid="2TH 2:12"/>जेनको लक जेतरा लोक खराई लक भरोसा नही राखेहेत वरन अधरम लक खुस रहेत, वय सबच दन्ड भोग हेत।<verse eid="2TH 2:12"/></para>
  <para style="s">तुमी सुटकारा पावन साठी बेचया गया</para>
  <para style="p">
    <verse number="13" style="v" sid="2TH 2:13"/>ओह भाऊगीन अना पिरभु का माया वारा लोकगीन, आमी तुमरो बारे मा परमेस्वर ला सदा धनबाद ऐकोलाई देसेजन, की परमेस्वर ना सुरु मा किरिया की अनुसार तुमला बेचके राखीसेस, जोको लक तुमी आतमा कन लक पवीतर बनके अना खराई मा भरोसा राखके मुकती मिल्हेत। <verse eid="2TH 2:13"/><verse number="14" style="v" sid="2TH 2:14"/>जोन को साठी ओने तुमला आमरो साजरो बारता कन लक हाकलीसेस, की तुमी आमरो पिरभु यीसु मसीह को महिमा ला पाहो। <verse eid="2TH 2:14"/><verse number="15" style="v" sid="2TH 2:15"/>एकोसाठी अगो भाऊगीन तुमी अडिग रव्हने; जोन जोनसी सिक्सा तुमी ना गोस्टी या चिठ्ठी कन लक सीकायो सेव ओला धरो रव्हने।<verse eid="2TH 2:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="2TH 2:16"/>आमरो पिरभु यीसु मसीह खुदच अना आमरो बाबूजी परमेस्वर जेनला आमी ना माया राखिसेजन, वाच आमला दया अना हरामेसा को सान्ती लक साजरो आस देइसेस। <verse eid="2TH 2:16"/><verse number="17" style="v" sid="2TH 2:17"/>तुमरो मन ला सान्ती देहे। अना तुमला सबच साजरो काज अना गोस्टी मा पक्को राखेह।<verse eid="2TH 2:17"/></para>
  <chapter eid="2TH 2"/>
  <chapter number="3" style="c" sid="2TH 3"/>
  <para style="s">पिराथना करन साठी बिनती</para>
  <para style="p">
    <verse number="1" style="v" sid="2TH 3:1"/>आखरी मा ओ भाऊगीन, आमरो लाई पिराथना करने की पिरभु को गोस्टी असी बढ़े अना बड़ाई पाहे, जसो तुममा भयो सेत। <verse eid="2TH 3:1"/><verse number="2" style="v" sid="2TH 3:2"/>अना आमी तिरपट अना बुरो<note caller="+" style="f"><char style="fr" closed="false">3:2</char><char style="ft" closed="false">दुस्ट</char></note> मानूस लक बचया रहबीन काहेका हरेक मा भरोसा नहाति।<verse eid="2TH 3:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="2TH 3:3"/>पर पिरभु भरोसा को काबिल<note caller="+" style="f"><char style="fr" closed="false">3:3 </char><char style="ft" closed="false">विस्वसनीय</char></note> सेत, उ तुमला पक्को रिति लक उभो करेत। अना वा बुरो दुस्ट लक बचायके राखेत। <verse eid="2TH 3:3"/><verse number="4" style="v" sid="2TH 3:4"/>आमीला पिरभु मा तुमरो पर भरोसा से की जोन-जोन हुकूम हमी तुमला देसेजन, ओला तुमी मान सेव। अना तुमी सचमा मानतो रव्हबिन।<verse eid="2TH 3:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="2TH 3:5"/>परमेस्वर को माया अना मसीह को धीरज को कन, पिरभु तुमरो मन ला आन कन जाय।<verse eid="2TH 3:5"/></para>
  <para style="s">आलसी को विरोध मा चेतावनी</para>
  <para style="p">
    <verse number="6" style="v" sid="2TH 3:6"/>ओ भाऊ आमी तुमला आपरो पिरभु यीसु मसीह को नाव लक हुकूम देसेजन की तुमी हर कोनी एक असो भाऊ लक दुर रवहने जोन बिगड़ी चाल<note caller="+" style="f"><char style="fr" closed="false">3:6 </char><char style="ft" closed="false">अनुचित चाल</char></note> जसो चाल चलन मा रव्हसे जोन सिक्सा ला ओना आमी लक पाइसे ओको जसो नही करासे। <verse eid="2TH 3:6"/><verse number="7" style="v" sid="2TH 3:7"/>काहेका तुमी आपच जान लेईसेव की कोनी रिती लक आमरी जसी चाल चलनो चाव्हसे। काहेकि कोनी आमरो बीच लक आलसी को जसो चाल नोको चलो। <verse eid="2TH 3:7"/><verse number="8" style="v" sid="2TH 3:8"/>काहेका कोनी ना फुकट मा जेवन नही जेविन पर मेहनत करीन। अना दुख भोग के रात दिवस मेहनत को काम धँधा करयो, का कोनी लाई बोझ नही होय। <verse eid="2TH 3:8"/><verse number="9" style="v" sid="2TH 3:9"/>असो नही से की हमला हक नही होतो, पर एकोसाठी का खुदला तुमरो लाई नमुना<note caller="+" style="f"><char style="fr" closed="false">3:9 </char><char style="ft" closed="false">उदाहरन</char></note> बनाय गया की तुमी आमरो जसी चाल चलो। <verse eid="2TH 3:9"/><verse number="10" style="v" sid="2TH 3:10"/>काहेकि जब आमी तुमरो यहान होता तबा यो हुकूम तुमला साँगत होता की अदी कोनी काम नही करासे, ता वा जेवन नही जेवनो पाहेत।<verse eid="2TH 3:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="2TH 3:11"/>आमी ना आयकीसेजन की तुमरो यहान कोनी-कोनी बेकार की चाल चलसेत अना काही काम काज नही करत पर “आयतो मा रेड़ा” सियानो बनसेत। <verse eid="2TH 3:11"/><verse number="12" style="v" sid="2TH 3:12"/>असो गीन ला आमी पिरभु यीसु मसीह मा हुकूम देके, सीखा सेजन की चूपचाप रहके काम करके आपरो रुजुक भाकर कमाय अना जेवन करे।<verse eid="2TH 3:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="2TH 3:13"/>तुमी अगो भाऊ साजरो करनो मा हिम्मत नोको छोड़ने।<verse eid="2TH 3:13"/></para>
  <para style="s">आखरी को परनाम</para>
  <para style="p">
    <verse number="14" style="v" sid="2TH 3:14"/>अदी कोनी आमरी येने चिठ्ठी की गोस्टी नही मानेह ता ओको पर नजर राखने, अना ओको संगति नही करने। जोको लक की उ लजाय जाहेती। <verse eid="2TH 3:14"/><verse number="15" style="v" sid="2TH 3:15"/>पर ओला बैरी नोको समझने, पर भाऊ जानके ओला चेताय देव।<verse eid="2TH 3:15"/></para>
  <para style="s">अखट्ट सबद अखीन आसीरबाद</para>
  <para style="p">
    <verse number="16" style="v" sid="2TH 3:16"/>अबा पिरभु जो सान्ती को राखन वालो से आपच तुमला सदा अना हर परकार लक सान्ती देहे। पिरभु तुमरो सँग रह।<verse eid="2TH 3:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="2TH 3:17"/>मी पौलुस आपरो हात लक नमस्कार लिखयो सेउ। सबच चिठ्ठी मा मोरो योच चिन्हानी से; मि योच रिती लक लिखसू।<verse eid="2TH 3:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="2TH 3:18"/>अता पिरभु यीसु मसीह को किरपा<note caller="+" style="f"><char style="fr" closed="false">3:18</char><char style="ft" closed="false">दया</char></note> तुमरो पर होवत रह।<verse eid="2TH 3:18"/></para>
  <chapter eid="2TH 3"/>
</usx>
