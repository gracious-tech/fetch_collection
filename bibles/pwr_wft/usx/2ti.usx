<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="2TI" style="id">- Powari Standard Project</book>
  <para style="h">2 तीमथियुस</para>
  <para style="toc3">2 तीमथियुस</para>
  <para style="toc2">2 तीमुथियुस</para>
  <para style="toc1">तीमुथियुस को नाव पौलुस को दुसरो चिठ्ठी</para>
  <para style="mt2">तीमथियुस के नाव पौलुस का दुसरा पत्र</para>
  <para style="mt1">तीमुथियुस को नाव पौलुस की दुसरो चिठ्ठी</para>
  <para style="imt">परिचय</para>
  <para style="ip">2 तीमुथियुस को किताब, पेरीत पौलुस को आपरो चेला तीमुथियुस को दुसरो चिठ्ठी से। 2 तिमोथी पौलुस को जिंदगी को अखट्ट को जवर लिख्यो गयो उ येने बेरा <char style="xt"><ref loc="2TI 1:16">1:16</ref></char> को दौरान रोम मा कैद होतो। पौलुस को तीमुथियुस को संगा गाड़ो नाता होतो अना वाकि उनला लेकरा को रुप मा पहचानो जावत होतो <char style="xt"><ref loc="PHP 2:22">फिलिप्पियो 2:22</ref></char> <char style="xt"><ref loc="1TI 1:2">1 तीमुथियुस 1:2</ref>; <ref loc="1TI 1:18">1:18</ref></char></para>
  <para style="ip">यो पौलुस को चार चिठ्ठी मा लक एक से जो एक चरच को बजाय एक मानूस ला सांगा से। अखीन तीन असो चिठ्ठी सेत 1 तीमुथियुस, तीतुस अना फिलमोन। ओना बेरा को मंघा जबा 2 तीमुथियुस ला लिख्यो गयो होतो, रोमन सरकार मा ईसाईगिन ला सतायो जाय रहयो होतो सायद योच कारन होतो, का पाल जेल मा होतो। अना तीमुथियुस ला तकलीफ सव्हन को हुकूम दे रहयो होतो।</para>
  <para style="ip">1 तीमुथियुस को जसो पौलुस ना तीमुथियुस ला खोटो गुरूगीन <char style="xt"><ref loc="1TI 1:16-18">1 तीमुथियुस 1:16-18</ref></char> को बारेमा कई चितावनी देयीसेस उ तीमुथियुस ला यो भी सांगासे का पुढ़ा को बेरा तकलीफ होहे। <char style="xt"><ref loc="2TI 3:1">3:1</ref></char></para>
  <para style="iot">रूपरेखा</para>
  <para style="io1">1. पौलुस तीमुथियुस ला नमस्कार करतो हुयो सुरु होवासे अना मंग ओला बढ़ावा देवासे। <char style="ior"><ref loc="2TI 1:1-18">1:1-18</ref></char></para>
  <para style="io1">2. मंग ओना तीमुथियुस को सव्हन करन की चुनौती देइस। <char style="ior"><ref loc="2TI 2:1-13">2:1-13</ref> </char></para>
  <para style="io1">3. पुढ़ा उ ओला काही आम हुकूम देवासे। <char style="ior"><ref loc="2TI 2:14-26">2:14-26</ref></char></para>
  <para style="io1">4. मंग उ ओला भविस्य को घटनागीन अना जवाब को काम देवन को खरो तरीका को बारे मा चेतावनी देवासे। <char style="ior"><ref loc="2TI 3:1-4:8">3:1—4:8</ref></char></para>
  <para style="io1">5. पौलुस तीमुथियुस को लाई काही जातिगत टिप्पनी को संगा खतम होवासे। <char style="ior"><ref loc="2TI 4:9-22">4:9-22</ref></char></para>
  <chapter number="1" style="c" sid="2TI 1"/>
  <para style="s">नमस्कार</para>
  <para style="p">
    <verse number="1" style="v" sid="2TI 1:1"/>पौलुस को कन लक जोन, जिंदगी की परन को जसो जोन मसीह यीसु मा से। परमेस्वर की आस लक मसीह यीसु को पेरीत से। <verse eid="2TI 1:1"/><verse number="2" style="v" sid="2TI 1:2"/>चहेतो टूरा तीमुथियुस को नाव परमेस्वर बाप अना हमरो पिरभू मसीह यीसु को कन लक तोला आसिरवाद अना दया अखीन सान्ती भेटत रव्हे।<verse eid="2TI 1:2"/></para>
  <para style="s">धनवाद अना बढावा</para>
  <para style="p">
    <verse number="3" style="v" sid="2TI 1:3"/>जेना परमेस्वर की सेवा मा अपरो बाप-दादा गीन की रिवाज पर सुध्द अक्कल लक करासेऊ वोको धनवाद होहे का मी अपरी पिराथना गीन मा तोला रात दिवस हेत करासेऊ। <verse eid="2TI 1:3"/><verse number="4" style="v" sid="2TI 1:4"/>अना तोरो आँसु को हेत करके राती दिवस तोरो लक भेटन लाई लगत बेरा तकन तरसा सेव, का मी खुसी लक भर जाऊ, <verse eid="2TI 1:4"/><verse number="5" style="v" sid="2TI 1:5"/>मोला तोरो वोना सलपा दिल लक भरोसा को हेत आवासे जोन पहेल तोरी माम माँय लोइस अना तोरी माय युनीके मा होतो अना मोला पक्को भरोसा से का तोरो मा भी से। <verse eid="2TI 1:5"/><verse number="6" style="v" sid="2TI 1:6"/>एना कारन मा तोला हेत देवासू का तु परमेस्वर को वोना बरदान जोन मोरो हात राखन लाई तोला मिलसे वोला जित्तो राख। <verse eid="2TI 1:6"/><verse number="7" style="v" sid="2TI 1:7"/>काहेकि परमेस्वर न हमला भेव की नही पर ताकत अना पिरेम अना संयम की आतमा देईसेस।<verse eid="2TI 1:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="2TI 1:8"/>एकोलाय हमरो पिरभू की गवाही लक अना मोरो लक जोन वोको जेली सेऊ लज्जित नोको होवो पर वोनो परमेस्वर की ताकत को जसो साजरो बारता लाई मोरो संग दुख उठाव। <verse eid="2TI 1:8"/><verse number="9" style="v" sid="2TI 1:9"/>जेना आमरो सुटकारा करीस, अना पवीतर बुलावा लक हाकलीस अना यो हमरो काम गीन को लक नाहती, पर वोको मकसद अना वोनो किरपा को लक सेत, जोन मसीह यीसु मा हरामेसा लक भयो सेत। <verse eid="2TI 1:9"/><verse number="10" style="v" sid="2TI 1:10"/>पर अबा हमरो पाप मोचक मसीह यीसु को परगट होवनो लक प्रकासीत भयो जेना मिरतु को नास करीस अना जीवन अखीन अमरता की वोना साजरो बारता लक उजाडो जसो कर देईस।<verse eid="2TI 1:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="2TI 1:11"/>जेनको लाई मी परचार करन वारा अना पेरीत अखीन सिक्सा वालो भी ठहरायो। <verse eid="2TI 1:11"/><verse number="12" style="v" sid="2TI 1:12"/>एना कारन मी एना दुखगीन ला भी उचला सेऊ पर सरमाऊ नही काहेकी मी वोला जेनको पर मीना भरोसा करीसेऊ जानासेउ अना मोरो पक्को से का उ मोरी पुंजी की वोनो दिवस तकन देख-रेख कर सकासे। <verse eid="2TI 1:12"/><verse number="13" style="v" sid="2TI 1:13"/>जोन खरी गोस्टी तु न मोला लक आयकिसेस उनला वोना भरोसा अना पिरेम को संग जोन मसीह यीसु मा से अपरो नमूना बनायके राखे। <verse eid="2TI 1:13"/><verse number="14" style="v" sid="2TI 1:14"/>अना पवीतर आतमा को कन लक जोन अमी मा बसीयो हुयोसे एना साजरी पुंजी की देख-रेख कर।<verse eid="2TI 1:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="2TI 1:15"/>तु जानासेस का आसिया देस वारा सब मोरो लक बेगरो भय गईसेत जेनको मा फूगिलूस अना हिरमुगिनेस से। <verse eid="2TI 1:15"/><verse number="16" style="v" sid="2TI 1:16"/>उनेसिफुरुस को खानदान पर पिरभू दया करेहे काहेकी वोना लगत बार मोरो जीव ला थन्डो करीसेस अना मोरी हतकड़ी गीन लक लज्जित नही भयो। <verse eid="2TI 1:16"/><verse number="17" style="v" sid="2TI 1:17"/>पर जबा उ रोम मा आयो त मोठो जतन लक ढुंढके मोरो लक भेंट करीस। <verse eid="2TI 1:17"/><verse number="18" style="v" sid="2TI 1:18"/>पिरभू करेहे का वोना दिवस वोको पर पिरभू की दया होहे अना जोन-जोन सेवा वोना इफिसुस मा करीसेस उनला भी तु साजरो लक जानासेस।<verse eid="2TI 1:18"/></para>
  <chapter eid="2TI 1"/>
  <chapter number="2" style="c" sid="2TI 2"/>
  <para style="p">
    <verse number="1" style="v" sid="2TI 2:1"/>एको लाई अरे मोरो टूरा तु वोना किरपा लक सेस जोन मसीह यीसु मा से ताकतवर होय जाहे। <verse eid="2TI 2:1"/><verse number="2" style="v" sid="2TI 2:2"/>अना जोन गोस्टी तु न लगत सा गवाह गीन को पुड़ा मोरो लक आयकिसेस वय बिस्वासी मानूस गीन ला सोप दे जोन दुसरो ला सिकावन कबील होहेत।<verse eid="2TI 2:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="2TI 2:3"/>मसीह यीसु ला साजरो योध्दा को जसो मोरो संग दुख उठाव। <verse eid="2TI 2:3"/><verse number="4" style="v" sid="2TI 2:4"/>जबा कोनी योध्दा लड़ाई पर जासे त एको लाई का अपरी भरती करवावन वालो ला खुस करके अपरो जिंदगी ला संसार को काम गीन मा नही फसावासेत। <verse eid="2TI 2:4"/><verse number="5" style="v" sid="2TI 2:5"/>मंग अखाडा मा लड़नवारा अदी जसो नेम लक लड़े त मुकुट नही पाहे। <verse eid="2TI 2:5"/><verse number="6" style="v" sid="2TI 2:6"/>जोन कासतकार महेनत करासे फर को पहेल हिस्सा वोला च मिलनो चाव्हसे। <verse eid="2TI 2:6"/><verse number="7" style="v" sid="2TI 2:7"/>जेव मी कव्हसू वोको पर ध्यान देवो अना पिरभू तोला सबरी गोस्टी की समझ देहे।<verse eid="2TI 2:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="2TI 2:8"/>यीसु मसीह ला हेत राखो जोन दाऊद को खानदान मा भईसे अखीन मरयो हुयो मा लक जित्तो भईसे अना या मोरो साजरो बारता को अनुसार सेत। <verse eid="2TI 2:8"/><verse number="9" style="v" sid="2TI 2:9"/>जेनको लाई मी बुरो काम करन वारा को जसो दुख उठावासेव अना बन्धन भी सेउ पर परमेस्वर को बचन बंधन मा नाहाती। <verse eid="2TI 2:9"/><verse number="10" style="v" sid="2TI 2:10"/>एना कारन मी बेचयो हुया लोक गीन को लाई सबच काही सहन करासु का वय भी वोनच मुकती ला जोन मसीह यीसु मा से अमर महिमा को संग पाहेत। <verse eid="2TI 2:10"/><verse number="11" style="v" sid="2TI 2:11"/>या गोस्टी सही से का,</para>
  <para style="q1" vid="2TI 2:11">अदी हमी उनको संग मर गईसे त</para>
  <para style="q2" vid="2TI 2:11">उनको संग जीवबीन भी।<verse eid="2TI 2:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="2TI 2:12"/>अदी हमी धीरो लक सहतो रह त</para>
  <para style="q2" vid="2TI 2:12">उनको संग राज भी करेहेत।</para>
  <para style="q1" vid="2TI 2:12">अदी हमी उनला मुकरेत</para>
  <para style="q2" vid="2TI 2:12">त उ भी हमरो मुकर करेहेत।<verse eid="2TI 2:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="2TI 2:13"/>अदी हमी अबिस्वासी भी होय</para>
  <para style="q2" vid="2TI 2:13">तबा भी उ बिस्वास कबील बनायो रह</para>
  <para style="q2" vid="2TI 2:13">काहेकी उ आप अपरो मुकर नही कर सकासे।<verse eid="2TI 2:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="2TI 2:14"/>एना गोस्टी की उनला हेत कराओ अना पिरभू को पुड़ा चेताय देना का सबद गीन पर टिका-टिप्पनी नोको करो जेनको लक काही लाभ नही होतो वरन आयकान वालो बिगड जासे। <verse eid="2TI 2:14"/><verse number="15" style="v" sid="2TI 2:15"/>अपरो आप ला परमेस्वर ला पावनो काबील अना असो काम करन वालो ठहरानो को जतन कर जोन लज्जित होवन नही पाहे अना जोन खरो बचन ला सही रीती लक काम मा आनासेत। <verse eid="2TI 2:15"/><verse number="16" style="v" sid="2TI 2:16"/>पर बुरी सबद लक बचया रव्हो काहेकी असो लोक अखीन भी अभक्ती मा बढता जासेत। <verse eid="2TI 2:16"/><verse number="17" style="v" sid="2TI 2:17"/>अना उनका बचन केन्सर को जसो फैलता जाहेत हुमिनयुस अना फिलेतुस उनको च मा लक से। <verse eid="2TI 2:17"/><verse number="18" style="v" sid="2TI 2:18"/>जोन यो कहेके का मरके जित्तो भयो से खरो-खर भटक गयो अना केतरा गीन को बिस्वास ला उलट पुलट कर देवासे। <verse eid="2TI 2:18"/><verse number="19" style="v" sid="2TI 2:19"/>तबा भी परमेस्वर की पक्की नींव बनी रहवासे अखीन वोको पर यो छाप लगीसे पिरभू अपरो ला चिन्हासे अना जोन कोनी पिरभू को नाव लेवासे उ अन्याय लक बचयो रह।<verse eid="2TI 2:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="2TI 2:20"/>मोठो घर मा नही बल्कि सोनो-चांदी च का पर काड़ी अना माटी का बरतन भी होवासे कोनी-कोनी आदर अखीन कोनी-कोनी अनादर को लाई। <verse eid="2TI 2:20"/><verse number="21" style="v" sid="2TI 2:21"/>अदी कोनी अपरो आप ला इनको लक सूद करेहे त उ आदर को बरतन अना पवीतर ठहरायो अना मालिक को काम आहे अखीन हर साजरो काम को लाई तैय्यार होहेत। <verse eid="2TI 2:21"/><verse number="22" style="v" sid="2TI 2:22"/>जुवानी को मन मरजी आस लक परावो, अना जोन सुध्द मन लक पिरभू को नाव लेवसेत, उनको संग धरम अना बिस्वास अखीन पिरेम अखीन मेल मिलाप को पीछा करो। <verse eid="2TI 2:22"/><verse number="23" style="v" sid="2TI 2:23"/>पर बेअक्कल अना कम अक्ल को झगड़ा लक अगल रहवो काहेकी तु जाना से का इनको झगड़ा पैदा होवासे। <verse eid="2TI 2:23"/><verse number="24" style="v" sid="2TI 2:24"/>पिरभू को दास झगड़ालु नही होवनो चाव्हसे पर उ सब को संग नरम अना सिक्सा मा महीर अखीन सहन करन वालो होहे। <verse eid="2TI 2:24"/><verse number="25" style="v" sid="2TI 2:25"/>उ बिरोधी गीन ला नरमता लक समझयो का जानो परमेस्वर उनला पाप लक मन हटाव। का आतमा देहे का वय भी खराई ला ओरखेत। <verse eid="2TI 2:25"/><verse number="26" style="v" sid="2TI 2:26"/>अना इनको कन लक उनकी आस पूरी करनो को लाई सचेत होयके सैतान को जाल लक छुट जाहे।<verse eid="2TI 2:26"/></para>
  <chapter eid="2TI 2"/>
  <chapter number="3" style="c" sid="2TI 3"/>
  <para style="p">
    <verse number="1" style="v" sid="2TI 3:1"/>पर यो हेत राखो का आखरी दिवस गीन मा कठिन बेरा आहे। <verse eid="2TI 3:1"/><verse number="2" style="v" sid="2TI 3:2"/>काहेकी मानूस सुवारथी, धन दौलत लक माया करनवारा डींगमार, गरबिला, बिरोध करनवारा, माय-बाप को हुकूम नही मानन वालो बिरोधी अपवीतर। <verse eid="2TI 3:2"/><verse number="3" style="v" sid="2TI 3:3"/>दया रहित, क्षमारहित लान-छान लगावन वालो असंयमी कठोर साजरो को बैयरी। <verse eid="2TI 3:3"/><verse number="4" style="v" sid="2TI 3:4"/>बिसवासघाती ढीठ घंमडी अना परमेस्वर लक पिरेम नही, तरी सूक सुबिता का चाव्हवन वारा होहेत। <verse eid="2TI 3:4"/><verse number="5" style="v" sid="2TI 3:5"/>वय भक्ती को हुलीया त धरेहेत पर वोकी ताकत ला नही मानहेत असा गीन लक दुहुर रव्हना। <verse eid="2TI 3:5"/><verse number="6" style="v" sid="2TI 3:6"/>इनको च मा लक वय लोक सेत जोन घर मा चोरी लक धसावसेत अना वोना कमजोर आई-माई गीन ला बस मा कर लेसेत जोन पाप लक दबी अना हर पिरकार की आस को बस मा से। <verse eid="2TI 3:6"/><verse number="7" style="v" sid="2TI 3:7"/>अना हमेसा सिकावता रहवासेत पर खराई की पहिचान तकन कबच नही पहुचा सेत। <verse eid="2TI 3:7"/><verse number="8" style="v" sid="2TI 3:8"/>जसो यत्रेस अना यम्ब्रेस न मोसे को बिरोध करीस होतीस वसोच यो खराई को बिरोध करासे यो मानूस से जेकी अक्ल चली गईसे अना वय बिस्वास को बारे मा निकामा से। <verse eid="2TI 3:8"/><verse number="9" style="v" sid="2TI 3:9"/>पर वय एकोलक पुड़ा नही बढ सकासेत काहेकी जसो उनकी कम अक्ल सबच मानूस गीन पर परगट भय गई होती वसोच इनकी भी भय जाहे।<verse eid="2TI 3:9"/></para>
  <para style="s">तीमुथियुस का खास निरदेस</para>
  <para style="p">
    <verse number="10" style="v" sid="2TI 3:10"/>पर तु न सिक्सा चालचलन मनसा बिस्वास सहन करन को ताकत पिरेम धीरज अना सताय जानो अना दुख उठावन मा मोरो संग देईस। <verse eid="2TI 3:10"/><verse number="11" style="v" sid="2TI 3:11"/>अना असो दुख गीन मा भी जोन अन्ताकिया अना इकुनियुम अखीन लुस्तरा मा मोरो पर पडया होतो अना कई दुख गीन मा भी जोन मीना उठाइसेस पर पिरभू न मोला उन सब लक छुड़ाय लेईस। <verse eid="2TI 3:11"/><verse number="12" style="v" sid="2TI 3:12"/>पर जेतरा मसीह यीसु मा भक्ती को संग जित्तो रव्हनो चाहवसे वय सब सताय जाहे। <verse eid="2TI 3:12"/><verse number="13" style="v" sid="2TI 3:13"/>पर पापी अना बहकावन वालो धोखा देवासे अना धोखा खाता हुयो बिगडता चली जाहे। <verse eid="2TI 3:13"/><verse number="14" style="v" sid="2TI 3:14"/>पर तु एना गोस्टी गीन पर जोन तु नही सीको सेस अना बिस्वास करीसेस यो समझके पक्को बनया रहवो का तु न उनला कोनता लोक गीन ला सीकाइसेस। <verse eid="2TI 3:14"/><verse number="15" style="v" sid="2TI 3:15"/>अना बचपन लक पवीतर गीरंथ तोरो दिल मा लिख्यो सेत जोन तोला मसीह यीसु मा बिस्वास करन लक मुकती पावन लाई अक्कलवर बनाय सकासे। <verse eid="2TI 3:15"/><verse number="16" style="v" sid="2TI 3:16"/>पूरो पवितर गीरंथ परमेस्वर की पिरेना लक रचयो गयो से अना सिक्सा अना समझावन अखीन सुधारन वालो अना धरमिपन की सिक्सा को लाई लाभ दायकसे। <verse eid="2TI 3:16"/><verse number="17" style="v" sid="2TI 3:17"/>ताकी परमेस्वर को जन सिध्द बनावनो अना हर एक भला काम को लाई पक्को होय जाहे।<verse eid="2TI 3:17"/></para>
  <chapter eid="2TI 3"/>
  <chapter number="4" style="c" sid="2TI 4"/>
  <para style="p">
    <verse number="1" style="v" sid="2TI 4:1"/>परमेस्वर अना मसीह यीसु की गवाहि करके जोन जित्तो अना मरयो हुयो को न्याय करेहे अना ओको परगट होवनो अना राज की हेत कराय के मी तोला हुकूम देवासु। <verse eid="2TI 4:1"/><verse number="2" style="v" sid="2TI 4:2"/>का तु बचन को परचार करतो बेरा अखीन हर बेरा तैय्यार रहवो सब पिरकार की सहनसीलता अना सिक्सा को संग बढ़ावा देव अना उलाहना देके समझावो। <verse eid="2TI 4:2"/><verse number="3" style="v" sid="2TI 4:3"/>काहेकी असो बेरा आहे जबा लोक खरो सिक्सा नही सह सको पर कान गीन की खुजली को कारन अपरी आस को जसो अपरो लाई लगत सी सिक्सक बटोर लेहेत। <verse eid="2TI 4:3"/><verse number="4" style="v" sid="2TI 4:4"/>अना अपरो कान खराई लक अलग करके कथा कहानी गीन पर लगायहेत। <verse eid="2TI 4:4"/><verse number="5" style="v" sid="2TI 4:5"/>पर तु सब गोस्टी गीन मा तैय्यार रहवो दुख उठाव साजरी खबर को परचार को काम करो अखीन अपरी सेवा ला पूरो करो।<verse eid="2TI 4:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="2TI 4:6"/>काहेकी अबा मोरो बलिदान होन को बेरा आय गयो से। काहेकि ऐना जिंदगी को तजन को बेरा जवर से। <verse eid="2TI 4:6"/><verse number="7" style="v" sid="2TI 4:7"/>मी साजरी कुस्ती लड़ चुकी सेउ मीना अपरी दौड पूरी कर लेई सेस मीना बिस्वास की देख-रेख करीसेस। <verse eid="2TI 4:7"/><verse number="8" style="v" sid="2TI 4:8"/>अबा मोरो लाई धरम को उ मुकुट सजायके राखयो गयो से जोन पिरभू नेक अना न्याय करन वालो सेव मोला वोना दिवस देहे अना मोला च नही वरन वय सब ला जोन पिरेम को संग वोको परगट होवन को बाट चोविसेत।</para>
  <para style="p" vid="2TI 4:8">निजि सूचना<verse eid="2TI 4:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="2TI 4:9"/>मोरो जवर लवकर आवन को जतन करो। <verse eid="2TI 4:9"/><verse number="10" style="v" sid="2TI 4:10"/>काहेकि देमास न एना संसार लक जादा माया करके मोला छोड़ देईसेत अखीन थिस्सलुनीके ला चली गयो क्रेसक्रेंस गलातिया ला अना तीतुस दलमतिया ला चली गयो। <verse eid="2TI 4:10"/><verse number="11" style="v" sid="2TI 4:11"/>बल्कि लूका मोरो संग से मरकुस ला आन कन चली आयो काहेकी सेवा को लाई उ मोरो लगत काम को से। <verse eid="2TI 4:11"/><verse number="12" style="v" sid="2TI 4:12"/>तुखिकुस ला मीना इफिसुस धाडिस सेस। <verse eid="2TI 4:12"/><verse number="13" style="v" sid="2TI 4:13"/>जोन जामा मी तोरआस नगर मा करपुस को यहान छोड़ आईसेऊ जबा तु आवजोस त वोला किताब गीन को पक्को करके चमड़ा को चिठ्ठी गीन ला आनजोस। <figure style="fig" alt="Scrolls standing by ink well" file="HK00153C.TIF" size="col" copy="Horace Knowles ©" ref="4:13">चमड़ा को चिठ्ठी</figure><verse eid="2TI 4:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="2TI 4:14"/>सिकन्दर कसार मोरो लक लगत बुराई करीसेस पिरभू वोला वोको काम गीन को जसो बदल देहे। <verse eid="2TI 4:14"/><verse number="15" style="v" sid="2TI 4:15"/>तु भी वोको लक होसियार रहवो काहेकी वोना हमारो गोस्टी को लगत बिरोध करीसेस। <verse eid="2TI 4:15"/><verse number="16" style="v" sid="2TI 4:16"/>मोरो पहेल विवाद को बेरा कोनी न भी मोरो संग नही देईस वरन सब न मोला छोड़ देईन भला होय का इनको उनको लेखा देनो नही पड़ेहे। <verse eid="2TI 4:16"/><verse number="17" style="v" sid="2TI 4:17"/>पर पिरभू मोरो सहायक रहयो अना मोला ताकत देईस ताकी मोरो कन पूरो-पूरो परचार होहे अना सब परजात आयक लेहेत मी सेर को टोन्ड लक सुड़ायो गयो सेउ। <verse eid="2TI 4:17"/><verse number="18" style="v" sid="2TI 4:18"/>अना पिरभू मोला हर एक बुरो काम लक छुड़ाय लेहेत, अना अपरो सरगीय राज मा सुरक्सित पहुचायहे वोकी महिमा जुगनजुग होवती रह आमेन।</para>
  <para style="p" vid="2TI 4:18">अखट्ट नमस्कार<verse eid="2TI 4:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="2TI 4:19"/>प्रिस्किल्ला अना अक्विला को अखीन उनेसिफुरुस को खानदान ला नमस्कार। <verse eid="2TI 4:19"/><verse number="20" style="v" sid="2TI 4:20"/>इरास्तुस कुरिन्थुस मा रहगयो अना तुरफियुस को मीना मिलेतुस नगर मा बीमार छोड़ीसेस।<verse eid="2TI 4:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="2TI 4:21"/>दव को पयले चली आवन को जतन करीया यूबूलुस अना पूदेंस अना लीनुस अना क्लौदिया अखीन सब भाऊगीन ला तोरो नमस्कार।<verse eid="2TI 4:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="2TI 4:22"/>पिरभू तोरी आतमा को संग रहयो</para>
  <para style="p" vid="2TI 4:22">तुमरो पर किरपा होवतो रह।<verse eid="2TI 4:22"/></para>
  <chapter eid="2TI 4"/>
</usx>
