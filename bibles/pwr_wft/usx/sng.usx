<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="SNG" style="id">- Powari Standard Project</book>
  <para style="h">साजरो गीत</para>
  <para style="toc3">साजरो गीत</para>
  <para style="toc2">साजरो गीत</para>
  <para style="toc1">साजरो गीत</para>
  <para style="mt2">श्रेष्‍ठगीत</para>
  <para style="mt1">साजरो गीत</para>
  <para style="imt">साजरो गीत किताब को परिचय</para>
  <para style="ip">साजरो गान को महान गीत इसरायली पिरेम कवितागिन को एक किताब से, सायद लगत लेखकगीन को लक। हिबरु मा “साजरो गीत” यो कव्हन को एक तरीका आय का यो सबलक महान गीत से। जसो सबद को रचना "राजागिन को राजा" को अरथ सबलक वोरता को राजा आय। किताब को सुरुवात राजा सुलैमान <char style="xt"><ref loc="SNG 1:1">1:1</ref></char>को बखान लक होवासे, पर एको मतबल यो नहाय का वोना येला लिख्यो से। सायद असो भी होय सकासे का किताब सुलैमान ला आदर-मान देवन को लाय कोना भी लिख्यो से।</para>
  <para style="ip">विद्बानगिन ला नहि मालूम से का यो किताब कबा लिखी गयी होती, पर यो सुलैमान को जीवन काल (970-931 ईसा को पहेले) को बख्त लक लिख्यो होय सकासेत। अना बाद मा फिर लक सुधार कियो गयो होय सकासेत। साजरो गीत कलपना को पिरेम को बड़ाई करासे। पुरो किताब मा एक मानूस अना एक बायको एक-मेक को लाय आपरी मनसा को पिरेम को बड़ाई को इक्सा ला परकट करासेत। कभ्भु-कभ्भु वोका संगी गिन भी टिप्पनी करासेत अना उनको खुसी मा सामिल होवासेत <char style="xt"><ref loc="SNG 1:8">1:8</ref></char>जियादा तर विद्वान येना गोस्टी लक सहमत सेत का किताब साजरो बिन्दु <char style="xt"><ref loc="SNG 8:5-7">8:5-7</ref> </char> मा पायो जासेत। वहाँन बायका कव्हासेती का पिरेम मरन को जसो ताकतवर होवासेत। पिरेम सबलक मजबूत चीज आय जोन ला आमी महसूस करासेत अना येला रोक नहि सकासेत जसो मरन ला। सायद योच कारन आय का बायका तीन बार चेतावन भी देवासेत का लोगहुन ला सही बेरा को पहेलो पिरेम ला नही जगावन पाहिजे <char style="xt"><ref loc="SNG 2:7">2:7</ref>; <ref loc="SNG 3:5">3:5</ref>; <ref loc="SNG 8:4">8:4</ref></char></para>
  <para style="iot">साजरो गीत को रूपरेखा:</para>
  <para style="io1">1. किताब को सीरसक दियो गयो से। <char style="ior"><ref loc="SNG 1:1">1:1</ref> </char></para>
  <para style="io1">2. सीरसक को बाद, पहेलो कविता. <char style="ior"><ref loc="SNG 1:2-2:7">1:2—2:7</ref> </char></para>
  <para style="io1">3. दूसरो कविता <char style="ior"><ref loc="SNG 2:8-3:5">2:8—3:5</ref> </char>।</para>
  <para style="io1">4. तीसरी कविता <char style="ior"><ref loc="SNG 3:6-5:1">3:6—5:1</ref> </char>।</para>
  <para style="io1">5. चौवथी कविता <char style="ior"><ref loc="SNG 5:2-6:3">5:2—6:3</ref> </char>।</para>
  <para style="io1">6. पाँचवीं कविता<char style="ior"><ref loc="SNG 6:4-8:4">6:4—8:4</ref> </char>।</para>
  <para style="io1">7. अखट्ट मा, छटठी कविता <char style="ior"><ref loc="SNG 8:5-14">8:5—8:14</ref> </char>।</para>
  <chapter number="1" style="c" sid="SNG 1" />
  <para style="p">
    <verse number="1" style="v" sid="SNG 1:1" />साजरो गाना जो राजा सुलैमान को सेत<note caller="+" style="x"><char style="xo" closed="false">1:1 </char><char style="xt" closed="false"><ref loc="1KI 4:32">1 राजा 4:32</ref> </char></note>।<verse eid="SNG 1:1" /></para>
  <para style="s">पहेलो गाना</para>
  <para style="sp">नवरी</para>
  <para style="q1">
    <verse number="2" style="v" sid="SNG 1:2" />उ आपरो टोन्ड को चुम्मा गिन लक मोला चुमे!</para>
  <para style="q2" vid="SNG 1:2">काहेका तोरो पिरेम अंगुर को रस लक साजरो से,<verse eid="SNG 1:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="SNG 1:3" />तोरो बेगरो-बेगरो को इतर को महेक भी साजरो से,</para>
  <para style="q2" vid="SNG 1:3">तोरो नाव उबड़ाय हुयो इतर को जसो से;</para>
  <para style="q2" vid="SNG 1:3">एकोलाय कुवारीगिन तोरो लक पिरेम राखासेत।<verse eid="SNG 1:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="SNG 1:4" />मोला झीक ले; आमी तोरो मंघा धावबिन।</para>
  <para style="q2" vid="SNG 1:4">राजा मोला अपरो खोली मा आन लियो से।</para>
  <para style="q2" vid="SNG 1:4">आमी तोरो मा मगन अना खुस होवबिन;</para>
  <para style="q2" vid="SNG 1:4">आमी अंगूर को रस लक जादा तोरो पिरेम की गोस्टि करबीन;</para>
  <para style="q2" vid="SNG 1:4">वय कुमारीगिन सच मा तोरो लक पिरेम राखासेत।<verse eid="SNG 1:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="SNG 1:5" />अवो! यरूसलेम नगर की टूरीगिन, मी कारी ता सेंऊ पर खोबसूरत चोवासु,</para>
  <para style="q2" vid="SNG 1:5">केदार वंसी को तम्बुगिन का, अना सुलैमान को महेल को</para>
  <para style="q2" vid="SNG 1:5">पड़दा जसो खोबसूरत सेंऊ,जोनला यरूसलेम की बायको गिन पिरेम लक बुनयो सेति।<verse eid="SNG 1:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="SNG 1:6" />मोला एकोलायी घूरस नोको का सावरी सेंऊ,</para>
  <para style="q2" vid="SNG 1:6">काहेका मी धूप मा मुरझाय गयीसे।</para>
  <para style="q2" vid="SNG 1:6">मोरी माय का टूरागिन मोरो लक गुस्सा होतिन,</para>
  <para style="q2" vid="SNG 1:6">वय मोला अंगूर को बाड़ी गिन की रखवालीन बनायो से;</para>
  <para style="q2" vid="SNG 1:6">पर मी ना आपरी अँगूर को बारी को धियान नही रखायो ।<verse eid="SNG 1:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="SNG 1:7" />होय मोरो जान लक पियारो मोला सांग,</para>
  <para style="q2" vid="SNG 1:7">तू अपरा सेरी-मेढ़ा कहां चरावासेस,</para>
  <para style="q2" vid="SNG 1:7">दुफारी ला तू करप ला किता बसावासे,</para>
  <para style="q2" vid="SNG 1:7">मी कायको लाय तोरो मीतगीन को</para>
  <para style="q2" vid="SNG 1:7">सेरी मेन्डी को जवर</para>
  <para style="q2" vid="SNG 1:7">सेव डाक के भटकतो हिन्डु?</para>
  <para style="q1" vid="SNG 1:7">नवरा<verse eid="SNG 1:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="SNG 1:8" />अवो! बायका मा खोपसुरत,</para>
  <para style="q2" vid="SNG 1:8">अदि तोला मालूम नहात ता</para>
  <para style="q2" vid="SNG 1:8">सेरी-मेढ़ा गिन का को खुर का निसान गिनमा चल</para>
  <para style="q2" vid="SNG 1:8">अना हेड़ चरावन वारो को तम्बुगिन जवर,</para>
  <para style="q2" vid="SNG 1:8">अपरी सेरी का पाठी गिनला चराव।<verse eid="SNG 1:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="SNG 1:9" />अवो! मोरी पियारी मीना तोरी बरोबरी</para>
  <para style="q2" vid="SNG 1:9">फिरौन का रथगिन मा जुपी हुयी घोड़ी लक करयो से।<verse eid="SNG 1:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="SNG 1:10" />तोरो गाल केसगिन को बीच मा</para>
  <para style="q2" vid="SNG 1:10">का खोपसूरत सेत,</para>
  <para style="q2" vid="SNG 1:10">अना तोरो गरो को बीच मा हीरा गिनकी माला कितरो खोप सूरत से।<verse eid="SNG 1:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="SNG 1:11" />आमी तोरो लायी खूरो-सोन्नो का फूल जसो,</para>
  <para style="q2" vid="SNG 1:11">जेवर बनावबिन।<verse eid="SNG 1:11" /></para>
  <para style="sp">नवरी</para>
  <para style="q1">
    <verse number="12" style="v" sid="SNG 1:12" />जबा राजा अपरी मेज जवर बसयो होतो,</para>
  <para style="q2" vid="SNG 1:12">मोरी इतर की महेक फैल रही होती।<verse eid="SNG 1:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="SNG 1:13" />मोरी पिरेमी मोरो लायी लोबान की पिवसी</para>
  <para style="q2" vid="SNG 1:13">जसी से,</para>
  <para style="q2" vid="SNG 1:13">जो मोरी छाती गिनको बीच मा पड़ी रव्हासे।<verse eid="SNG 1:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="SNG 1:14" />मोरो पिरेमी मोरो लायी महेदी को फूल को गुच्छा</para>
  <para style="q2" vid="SNG 1:14">जसो से,</para>
  <para style="q2" vid="SNG 1:14">जोन एनगदी<note caller="+" style="f"><char style="fr" closed="false">1:14 </char><char style="ft" closed="false">मिरत सागर को दिन बुड्ती कन को किनार मा एनगदी से।</char></note> की अंगूर को बाड़ी गिन मा होवासे।<verse eid="SNG 1:14" /></para>
  <para style="s">नवरदेव</para>
  <para style="q1">
    <verse number="15" style="v" sid="SNG 1:15" />अवो, मोरी पिरेमी तू खोपसुरत सेस;</para>
  <para style="q2" vid="SNG 1:15">तोरा डोरा परेवा जसी सेत।<verse eid="SNG 1:15" /></para>
  <para style="sp">नवरी</para>
  <para style="q1">
    <verse number="16" style="v" sid="SNG 1:16" />अगो! मोरो पिरेमी तू खोपसुरत अना मन ला लुभान वारो से।</para>
  <para style="q2" vid="SNG 1:16">अना आमरो हतरोना हिवरो गवथ होहे ।<verse eid="SNG 1:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="SNG 1:17" />आमरो घर को आड़ा को खम्बा देवदार सेत,</para>
  <para style="q2" vid="SNG 1:17">अना हमरो सिंवार सनोवर की सेत।<verse eid="SNG 1:17" /></para>
  <chapter eid="SNG 1" />
  <chapter number="2" style="c" sid="SNG 2" />
  <para style="q1">
    <verse number="1" style="v" sid="SNG 2:1" />मी सारोन <note caller="+" style="f"><char style="fr" closed="false">2:1 </char><char style="fq" closed="false">सारोन</char><char style="ft" closed="false">इसराइल को दिनुगती हिस्सा को किनार को जघा।</char></note>को गुलाब सेऊ,</para>
  <para style="q2" vid="SNG 2:1">अना मी पहाड़ को घोन्दी को सोसन फूल सेंऊ।<verse eid="SNG 2:1" /></para>
  <para style="sp">नवरा</para>
  <para style="q1">
    <verse number="2" style="v" sid="SNG 2:2" />जसो सोसन फूल कटीलो झाड़ को बीच मा</para>
  <para style="q2" vid="SNG 2:2">वसोच मोरी पिरेमी टूरी गिनको बीच मा से।<verse eid="SNG 2:2" /></para>
  <para style="sp">वधू</para>
  <para style="q1">
    <verse number="3" style="v" sid="SNG 2:3" />जसो सेब को झाड़ जंगल को झाड़गिन को बीच मा,</para>
  <para style="q2" vid="SNG 2:3">वसोच मोरो पिरेमी जुवान गिनको बीच मा से।</para>
  <para style="q2" vid="SNG 2:3">मी वोको सावली मा खुस होयके बस गयी,</para>
  <para style="q2" vid="SNG 2:3">अना वोको फर मोला खावन मा मीठ्ठो लगयो।<verse eid="SNG 2:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="SNG 2:4" />वोय मोला अंगुर रस की खोली मा लेय आयो,</para>
  <para style="q2" vid="SNG 2:4">अना वोको जोन झन्डा मोरो वोरता फयरावत होतो,</para>
  <para style="q2" vid="SNG 2:4">ऊ पिरेम होतो<verse eid="SNG 2:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="SNG 2:5" />मोला अंगूर कि टिकी अना</para>
  <para style="q2" vid="SNG 2:5">सेब खवाय के, मोरो भीतर ताकत देव!</para>
  <para style="q2" vid="SNG 2:5">काहेका मी पिरेम को जूनून लक कमजोर सेंऊ।<verse eid="SNG 2:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="SNG 2:6" />वोको डाव हात,</para>
  <para style="q2" vid="SNG 2:6">मोरी डोस्की को खाल्या,</para>
  <para style="q2" vid="SNG 2:6">अना आपरो ऊजो हात लक ऊ मोला सयलातो<verse eid="SNG 2:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="SNG 2:7" />अवो यरूसलेम कि टुरीगिन, मी मिरगगिन</para>
  <para style="q2" vid="SNG 2:7">अना हिरनी गिनकी कसम खवायके कव्हसू,</para>
  <para style="q2" vid="SNG 2:7">का जबा तकन पिरेम खुद च उभो ना होवनो चाहे,</para>
  <para style="q2" vid="SNG 2:7">तबा तकन वोला नोको उसकावो अना जगावो।<verse eid="SNG 2:7" /></para>
  <para style="s1">दूसरा गीत</para>
  <para style="sp">नवरी</para>
  <para style="q1">
    <verse number="8" style="v" sid="SNG 2:8" />आयको-आयको! मोरो पिरेमी को सबद आयकुआय,</para>
  <para style="q2" vid="SNG 2:8">चोवो, ऊ परबतगिन ला पार करके,</para>
  <para style="q2" vid="SNG 2:8">पहाड़ी गिनमा लक कूदत-फांदत आवासे।<verse eid="SNG 2:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="SNG 2:9" />मोरो पिरेमी एक</para>
  <para style="q2" vid="SNG 2:9">जुवान हिरन को जसो से,</para>
  <para style="q2" vid="SNG 2:9">चोवो ऊ आमरी भीत को मंघा उभो से।</para>
  <para style="q2" vid="SNG 2:9">ऊ खिड़की कन लक ताका से, अना जाली मा लक ढुका से।<verse eid="SNG 2:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="SNG 2:10" />“मोरो पिरेमी मोला कह रही से,”</para>
  <para style="sp" vid="SNG 2:10">नवरा</para>
  <para style="q2" vid="SNG 2:10">“होय मोरी पियारी, सुन्दरी उभी होयके आव;<verse eid="SNG 2:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="SNG 2:11" />काहेका चोव, जाड़ो जातो रहयो;</para>
  <para style="q2" vid="SNG 2:11">बरसात भी होयके चली गयी।<verse eid="SNG 2:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="SNG 2:12" />बर्रा फूल चोय रही सेत,</para>
  <para style="q2" vid="SNG 2:12">चिड़ीगिन को गाना गावन की बेरा भय गयी से,</para>
  <para style="q2" vid="SNG 2:12">अना आमरो देस मा परेवा को सबद</para>
  <para style="q2" vid="SNG 2:12">आयकु आवासे।<verse eid="SNG 2:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="SNG 2:13" />अँजीर पिकन लगीसेत,</para>
  <para style="q2" vid="SNG 2:13">अंगूर फूलाय के महेक रह्यो से;</para>
  <para style="q2" vid="SNG 2:13">अवो! मोरी चहेती, मोरी सुन्दरी।</para>
  <para style="q2" vid="SNG 2:13">उभी होयके आव।<verse eid="SNG 2:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="SNG 2:14" />अवो मोरी परेवा, पहाड़ की दराड़ मा अना</para>
  <para style="q2" vid="SNG 2:14">चट्टान गिनको खोव को बीच मा तोरो टोंड मोला चोवन दे,</para>
  <para style="q2" vid="SNG 2:14">तोरो सबद मोला आयकन दे,</para>
  <para style="q2" vid="SNG 2:14">काहेका तोरो बोल अना टोंड लगत खोपसूरत से।<verse eid="SNG 2:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="SNG 2:15" />जोन नहान, कोल्हिया अंगूर को बाड़ी मा</para>
  <para style="q2" vid="SNG 2:15">गिनला बिगाड़ा सेत, उनला धरले,</para>
  <para style="q2" vid="SNG 2:15">काहेका आमरी बाड़ी फुलाय रही से।”<verse eid="SNG 2:15" /></para>
  <para style="sp">नवरी</para>
  <para style="q1">
    <verse number="16" style="v" sid="SNG 2:16" />मोरो पिरेमी मोरो आय, अना मी वोकी सेंऊ।</para>
  <para style="q2" vid="SNG 2:16">ऊ चट्टान को लीली को बीच मा अपरी करप ला सोसन को चरावासे।<verse eid="SNG 2:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="SNG 2:17" />जबा तकन सावली लम्बी होता-होता</para>
  <para style="q2" vid="SNG 2:17">मिट ना जाय अना दिन ना बुड़ा तबा तकन</para>
  <para style="q2" vid="SNG 2:17">होय मोरो चहेतो वोना जुवान हिरन जसो बन,</para>
  <para style="q2" vid="SNG 2:17">जो बेतेर<note caller="+" style="f"><char style="fr" closed="false">2:17 </char><char style="ft" closed="false">उबड़- खाबड़ पहाड़ीगीन</char></note> को पहाड़गिन मा फिरासे।<verse eid="SNG 2:17" /></para>
  <chapter eid="SNG 2" />
  <chapter number="3" style="c" sid="SNG 3" />
  <para style="q1">
    <verse number="1" style="v" sid="SNG 3:1" />राती मी आपरो खाट मा लेटी होती,</para>
  <para style="q2" vid="SNG 3:1">अना मी अपरो पिरान लक जादा चहेतो ला ढुंड़त रही;</para>
  <para style="q2" vid="SNG 3:1">पर ऊ नही मिलयो।<verse eid="SNG 3:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="SNG 3:2" />“मीना कह्यो, मी अता उठके नगर मा</para>
  <para style="q2" vid="SNG 3:2">अना गल्ली, चौराहा गिन मा</para>
  <para style="q2" vid="SNG 3:2">अपरो चहेतो ला ढुंडी।”</para>
  <para style="q2" vid="SNG 3:2">मी वोला तपासत रही पर उ मोला नही भेटयो।<verse eid="SNG 3:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="SNG 3:3" />जोन पहरेदार नगर मा घुमत होतिन</para>
  <para style="q2" vid="SNG 3:3">वय मोला मिल्यो, मीना उनला पुसयो,</para>
  <para style="q2" vid="SNG 3:3">“का तुमी ना मोरो चहेतो ला चोयो से?”<verse eid="SNG 3:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="SNG 3:4" />मी उनको जवर लक जाय रही होति,</para>
  <para style="q2" vid="SNG 3:4">का मोरो चहेतो मिल गयो।</para>
  <para style="q2" vid="SNG 3:4">मीना वोला धर लियो</para>
  <para style="q2" vid="SNG 3:4">अना तबा तकन जान नही दियो,</para>
  <para style="q2" vid="SNG 3:4">जबा तकन अपरी माय की घर जहान मी जलमी होती मजे खोली मा</para>
  <para style="q2" vid="SNG 3:4">आन ना लियो।<verse eid="SNG 3:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="SNG 3:5" />अवो, यरूसलेम की टूरी हो,</para>
  <para style="q2" vid="SNG 3:5">मि तुमला मिरग अना हिरनी गिनकी कसम</para>
  <para style="q2" vid="SNG 3:5">देसु, जबा तकन मोरो चहेतो</para>
  <para style="q2" vid="SNG 3:5">खुद ना उठा तबा तक वोला उकसाव अना नोको जगाव।<verse eid="SNG 3:5" /></para>
  <para style="s1">तीसरो गाना</para>
  <para style="sp">वधू</para>
  <para style="q1">
    <verse number="6" style="v" sid="SNG 3:6" />यो काजक आय जोन धुंगा को खम्बा जसो,</para>
  <para style="q2" vid="SNG 3:6">लोबान को महेक अना ब्यापरी की सबच</para>
  <para style="q2" vid="SNG 3:6">पिरकार की महेकन वालो धूप को बुकनी लगाय के</para>
  <para style="q2" vid="SNG 3:6">जंगल लक आय रही से?<verse eid="SNG 3:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="SNG 3:7" />चोवो, यो सुलैमान को सिंघासन वालो पालकी से!</para>
  <para style="q2" vid="SNG 3:7">वोको चारीआंगन इसराइल का साजरो साठ</para>
  <para style="q2" vid="SNG 3:7">सुरवीर गिन वोको संगा चल रही सेत।<verse eid="SNG 3:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="SNG 3:8" />वय सब तलवार बांधके सेत,</para>
  <para style="q2" vid="SNG 3:8">अना उनला पुरो लड़ाई करता आवासे,</para>
  <para style="q2" vid="SNG 3:8">सबच अदमी रात को खतरा को भेव</para>
  <para style="q2" vid="SNG 3:8">लक जांघ मा तलवार लटकाय के रव्हासेत।<verse eid="SNG 3:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="SNG 3:9" />सुलैमान राजा ना अपरो लायी</para>
  <para style="q2" vid="SNG 3:9">लबानोन देस को देवदार को लकड़ी</para>
  <para style="q2" vid="SNG 3:9">की एक पालकी बनवाय लियो।<verse eid="SNG 3:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="SNG 3:10" />एको खम्बा खूरो लक झाकयो हुयो से, एको वरता सोन्नो लक कढाई कियो कपरा से। एको खोर लाल बैंगनी कपरा लक झको से, जोनला यरूसलेम को बायको गिन ना पिरेम लक बुनयो सेत।<verse eid="SNG 3:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="SNG 3:11" />अवो सिय्योन की टुरीगिन हिटके सुलैमान</para>
  <para style="q2" vid="SNG 3:11">राजा पर निघा डाको, चोवो, यो उच मुकुट</para>
  <para style="q2" vid="SNG 3:11">घालयो हुयो से, जेला वोकी माय ना</para>
  <para style="q2" vid="SNG 3:11">वोको सादी को, अना मन की</para>
  <para style="q2" vid="SNG 3:11">खुसी को दिवस, वोको डोई मा राखयो होतो।<verse eid="SNG 3:11" /></para>
  <chapter eid="SNG 3" />
  <chapter number="4" style="c" sid="SNG 4" />
  <para style="s">नवरदेव</para>
  <para style="q1">
    <verse number="1" style="v" sid="SNG 4:1" />ओ मोरी चहेती, तू सुन्दर सेस!</para>
  <para style="q2" vid="SNG 4:1">तोरा डोरा तोरो केसगिन को बीच</para>
  <para style="q2" vid="SNG 4:1">मा परेवा जसो चोवा से।</para>
  <para style="q2" vid="SNG 4:1">तोरो चुन्दि ऊन सेरी को हेड़ को जसो से,</para>
  <para style="q2" vid="SNG 4:1">जोन गिलाद पहाड़ को उतार मा लटकयो हुयो से।<verse eid="SNG 4:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="SNG 4:2" />तोरा दात ऊन कतरयो मेढ़ा को करप जसा सेत,</para>
  <para style="q2" vid="SNG 4:2">जोन आंग धोयके आयी सेत</para>
  <para style="q2" vid="SNG 4:2">वय सब का दुई-दुई जुड़वा लेकरु सेत</para>
  <para style="q2" vid="SNG 4:2">उनको मा लक कोनी नही मरयो।<verse eid="SNG 4:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="SNG 4:3" />तोरा ओठ लगत खोबसूरत दोरी जसो लाल- लाल सेत,</para>
  <para style="q2" vid="SNG 4:3">तोरो मुख मन ला लुभावासेत।</para>
  <para style="q2" vid="SNG 4:3">तोरा जुल्फे को खाल्या गाल अनार की</para>
  <para style="q2" vid="SNG 4:3">फक्की जसा चोवा सेत।<verse eid="SNG 4:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="SNG 4:4" />तोरो गरो दाऊद को खम्बा जसो लम्बो से,</para>
  <para style="q2" vid="SNG 4:4">जोन औजार गिन लायी बनयो से</para>
  <para style="q2" vid="SNG 4:4">अना जेमा हजार ढाल टंगी सेत;</para>
  <para style="q2" vid="SNG 4:4">वय सब सुरवीरगिन की आत।<verse eid="SNG 4:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="SNG 4:5" />तोरी दुही छाती मिरग का लेकरु जसो से,</para>
  <para style="q2" vid="SNG 4:5">जोन सोसन को फूल को बीच मा चरासेत।<verse eid="SNG 4:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="SNG 4:6" />दिवस बुढ़त, थंडो बेरा होत तकन मी गन्धरस</para>
  <para style="q2" vid="SNG 4:6">अना लोबान को पहाड़ मा चली जांहु।<verse eid="SNG 4:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="SNG 4:7" />अवो मोरी चहेती तोरी हरेक आंग</para>
  <para style="q2" vid="SNG 4:7">सुन्दर सेस, तोरो मा कोनी दोस नहाय।<verse eid="SNG 4:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="SNG 4:8" />ओ मोरी नवरी तू मोरो संगा</para>
  <para style="q2" vid="SNG 4:8">लबानोन पहाड़ लक चली आव,</para>
  <para style="q2" vid="SNG 4:8">तू अमाना पहाड़ लक, सनीर पहाड़, अना हेमरोन पहाड़,</para>
  <para style="q2" vid="SNG 4:8">सेर गिनकी गुफा, लक अना चीता गिनकी</para>
  <para style="q2" vid="SNG 4:8">पहाड़ी मा लक चली आव।<verse eid="SNG 4:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="SNG 4:9" />अवो, मोरी लगत चहेती,</para>
  <para style="q2" vid="SNG 4:9">तूना मोरो मन मोह लियो से,</para>
  <para style="q2" vid="SNG 4:9">तूना अपरी निघा अना अपरो गरो</para>
  <para style="q2" vid="SNG 4:9">एकच माला लक मोरो मन ला चोराय लियो से।<verse eid="SNG 4:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="SNG 4:10" />होय मोरी चहेती, अवो मोरी लगत चहेती,</para>
  <para style="q2" vid="SNG 4:10">तोरो पिरेम केतरो मन ला लुभान वालो से,</para>
  <para style="q2" vid="SNG 4:10">तोरो पिरेम अंगूर को रस लक भी साजरो से!</para>
  <para style="q2" vid="SNG 4:10">अना तोरो इतर को महेक सब परकार को मसाला लक जादा मेहकन वालो सेत।<verse eid="SNG 4:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="SNG 4:11" />अवो मोरी नवरी तोरो ओठ लक सहेद</para>
  <para style="q2" vid="SNG 4:11">टपका से; तोरी जिबली खाल्या सहेद</para>
  <para style="q2" vid="SNG 4:11">अना दूध रव्हासे;</para>
  <para style="q2" vid="SNG 4:11">तोरो कपरा की महेक लबानोन को जसी से।<verse eid="SNG 4:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="SNG 4:12" />मोरी लगत चहेती, वोना बाड़ी जसो से,</para>
  <para style="q2" vid="SNG 4:12">जेको किवाड़ बंद रव्हासे, अना मोहरबन्द झरना से।<verse eid="SNG 4:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="SNG 4:13" />तोरा अंकुर वोना मोठी अनार की बाड़ी जसो से,</para>
  <para style="q2" vid="SNG 4:13">जेमा महेदी अना जटामासी।<verse eid="SNG 4:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="SNG 4:14" />जटामासी अना केसर, लोबान सबच पिरकार</para>
  <para style="q2" vid="SNG 4:14">का झाड़, मुस्क, दालचीनी, गन्धरस अगर, सबच</para>
  <para style="q2" vid="SNG 4:14">पिरकार का सुगन्ध वाला चीज सेत।<verse eid="SNG 4:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="SNG 4:15" />बाड़ी गिनको सोता से,</para>
  <para style="q2" vid="SNG 4:15">जीवन को पानी की बेहेर तू,</para>
  <para style="q2" vid="SNG 4:15">लबानोन पहाड़ लक हिटयो पानी की धारा से।<verse eid="SNG 4:15" /></para>
  <para style="s">नवरी</para>
  <para style="p">
    <verse number="16" style="v" sid="SNG 4:16" />ओ उत्तर दिसा की वारा उठ,</para>
  <para style="q2" vid="SNG 4:16">दक्खिन की वारा चली आव!</para>
  <para style="q2" vid="SNG 4:16">मोरी बाड़ी मा बोहो,</para>
  <para style="q2" vid="SNG 4:16">जेको लक वोकी महेक फैला।</para>
  <para style="q2" vid="SNG 4:16">मोरो पिरेमी अपरी बाड़ी मा आवा,</para>
  <para style="q2" vid="SNG 4:16">अना वोका साजरो- साजरो फर खावन देव।<verse eid="SNG 4:16" /></para>
  <chapter eid="SNG 4" />
  <chapter number="5" style="c" sid="SNG 5" />
  <para style="q1">
    <verse number="1" style="v" sid="SNG 5:1" />अवो मोरी लगत चहेती, मोरी चहेती,</para>
  <para style="q2" vid="SNG 5:1">मी अपरी बाड़ी मा आयो सेऊ,</para>
  <para style="q2" vid="SNG 5:1">मीना अपरो गन्धरस अना बलसान</para>
  <para style="q2" vid="SNG 5:1">जमा कर लियो से;</para>
  <para style="q2" vid="SNG 5:1">मीना छत्ता लक टपकतो सहेद खायो से,</para>
  <para style="q2" vid="SNG 5:1">मीना दुध अना अंगूर को रस पी लियो से।</para>
  <para style="sp" vid="SNG 5:1">सखी</para>
  <para style="q2" vid="SNG 5:1">ओ संगीहुन,तुम्हि भी खाव</para>
  <para style="q2" vid="SNG 5:1">ओ चहेतो, पियो मनमाने पिवो!<verse eid="SNG 5:1" /></para>
  <para style="s1">चवथो गाना</para>
  <para style="sp">नवरी</para>
  <para style="q1">
    <verse number="2" style="v" sid="SNG 5:2" />मी जपमा होती पर मोरो मन जाग चेतो होतो।</para>
  <para style="q2" vid="SNG 5:2">आयक! मोरो चहेतो किवाड़ खटखटावा से,</para>
  <para style="q2" vid="SNG 5:2">अना कसे, “होय मोरी चहेती, मोरी जियान, मोरी परेवा,</para>
  <para style="q2" vid="SNG 5:2">होय मोरी निरमल, मोरी लायी किवाड़ खोल;</para>
  <para style="q2" vid="SNG 5:2">काहेका मोरी डोई ओस लक ओदो से,</para>
  <para style="q2" vid="SNG 5:2">रात की पड़ी बूंद लक मोरो लटा तर से।”<verse eid="SNG 5:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="SNG 5:3" />मी अपरा कपरा उतार दियो होतो</para>
  <para style="q2" vid="SNG 5:3">मंग मी वोला कसी पेहरु?</para>
  <para style="q2" vid="SNG 5:3">मी ता अपरा पाय धोय लियो होतो</para>
  <para style="q2" vid="SNG 5:3">अता उनला कसो मयलो करु?<verse eid="SNG 5:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="SNG 5:4" />मोरो चहेतो ना अपरो हात किवाड़ को छेद</para>
  <para style="q2" vid="SNG 5:4">लक अपरो हात भीतर डाक दियो से,</para>
  <para style="q2" vid="SNG 5:4">तबा मोरो हिरदा वोको लायी बेचेन भयो।<verse eid="SNG 5:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="SNG 5:5" />मी अपरो चहेतो लायी किवाड़ खोलन उठी,</para>
  <para style="q2" vid="SNG 5:5">अना मोरो हात लक गन्धरस पड़यो,</para>
  <para style="q2" vid="SNG 5:5">अना टपकतो हुयो बेड़ागिन को मूठ मा पड़यो।<verse eid="SNG 5:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="SNG 5:6" />मीना अपरो चहेतो लायी किवाड़ ता खोल्यो</para>
  <para style="q2" vid="SNG 5:6">पर मोरो पिरेमी पहेले च लक चली गयो होतो,</para>
  <para style="q2" vid="SNG 5:6">तबा मी वोला आयकनो चाव्हत होती।</para>
  <para style="q2" vid="SNG 5:6">मीना वोला ढुंडयो पर नही मिलयो।</para>
  <para style="q2" vid="SNG 5:6">मीना वोला बुलायो पर,</para>
  <para style="q2" vid="SNG 5:6">वोको जवाब नही मिलयो।<verse eid="SNG 5:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="SNG 5:7" />पहरेदार जोन नगर मा घूमत होतिन,</para>
  <para style="q2" vid="SNG 5:7">मोला मिलिन, वय गिनना मोला मारिन</para>
  <para style="q2" vid="SNG 5:7">अना घायल कर दियो; परकोट का</para>
  <para style="q2" vid="SNG 5:7">पहरेदार गिनना मोरी चद्दर</para>
  <para style="q2" vid="SNG 5:7">मोरो लक सोड़ाय लियो।<verse eid="SNG 5:7" /></para>
  <para style="sp">सखी</para>
  <para style="q1">
    <verse number="8" style="v" sid="SNG 5:8" />अवो यरूसलेम की टुरीगिन,</para>
  <para style="q2" vid="SNG 5:8">मी तुमला कसम देके कव्हासु,</para>
  <para style="q2" vid="SNG 5:8">अदि मोरो चहेतो तुमला मिल जाय,</para>
  <para style="q2" vid="SNG 5:8">ता वोको लक कव्हनात का</para>
  <para style="q2" vid="SNG 5:8">मी पिरेम मा दीवानी भय गयी सेंऊ।<verse eid="SNG 5:8" /></para>
  <para style="s">नवरी</para>
  <para style="q1">
    <verse number="9" style="v" sid="SNG 5:9" />अवो बायको गिनमा तोरो पिरेमी बाकीगिन लक का बेगरो से जोन,वोमा असो का अदभूत से का तू कसम देवासेत?<verse eid="SNG 5:9" /></para>
  <para style="sp">वधू</para>
  <para style="q1">
    <verse number="10" style="v" sid="SNG 5:10" />मोरो पिरेमी सुंदर अना ताकतवर से,</para>
  <para style="q2" vid="SNG 5:10">ऊ दहा हजार मा एक च साजरो से।<verse eid="SNG 5:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="SNG 5:11" />वोको डोसका चोखो सोन्नो को जसो से,</para>
  <para style="q2" vid="SNG 5:11">वोकी लटकती लटा कावरा जसी कारी सेत।<verse eid="SNG 5:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="SNG 5:12" />वोका डोरा वोना परेवा जसा सेत,</para>
  <para style="q2" vid="SNG 5:12">जोन दूध मा बुड़के अपरो झुंड संगा</para>
  <para style="q2" vid="SNG 5:12">नद्दी को किनारी मा आपरो एक पंगत मा बसया सेत।<verse eid="SNG 5:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="SNG 5:13" />वोका गाल असो खोपसुरत जसी पूरो भरयो महेक वालो जड़ी बूटी अना गंधरस को बगीचा जसो से।</para>
  <para style="q2" vid="SNG 5:13">वोको ओठ सोसन की फूल अना पिघलो हुयो गधरस जसी टपकासेत।</para>
  <para style="q2" vid="SNG 5:13">जिनको लक गन्धरस टपकासे।<verse eid="SNG 5:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="SNG 5:14" />वोका हात फीरोजा मनी जड़यो सोन्नो की छड़ी को जसी से,</para>
  <para style="q2" vid="SNG 5:14">वोको बदन मानलो हत्ती को दांत लक बनयो से,</para>
  <para style="q2" vid="SNG 5:14">अना वोमा किमती गोटा गिन लक जड़यो गयो से।<verse eid="SNG 5:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="SNG 5:15" />वोका पाय सोन्नो मा जड़यो संगमरमर का खम्बा जसो सेत,</para>
  <para style="q2" vid="SNG 5:15">वय चोवन मा लबानोन पहाड़ अना सुन्दरता मा</para>
  <para style="q1" vid="SNG 5:15">देवदार का झाड़ जसा मन ला लुभान वारो सेत।<verse eid="SNG 5:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="SNG 5:16" />वोकी बानी लगत मिठ्ठो से,</para>
  <para style="q2" vid="SNG 5:16">हव वा बेझा सुन्दर से,</para>
  <para style="q2" vid="SNG 5:16">अवो यरूसलेम की टूरीगिन योच मरो चहेतो</para>
  <para style="q2" vid="SNG 5:16">अना संगी से।<verse eid="SNG 5:16" /></para>
  <chapter eid="SNG 5" />
  <chapter number="6" style="c" sid="SNG 6" />
  <para style="sp">सहेली</para>
  <para style="q1">
    <verse number="1" style="v" sid="SNG 6:1" />ओ बायको गिनमा परमसुन्दरी तोरो चहेतो किता चली गयो?</para>
  <para style="q2" vid="SNG 6:1">तोरो चहेतो किता गयो का आमी तोरी संग वोला</para>
  <para style="q2" vid="SNG 6:1">ढुंडन हिटासेजन?<verse eid="SNG 6:1" /></para>
  <para style="sp">नवरी</para>
  <para style="q2">
    <verse number="2" style="v" sid="SNG 6:2" />मोरो चहेतो अपरी बगीचा मा चलयो गयो से,</para>
  <para style="q2" vid="SNG 6:2">जिता बलसान को झाड़ उगासेत। उ बगीचा मा आपरो करप ला चरवासे, अना सोसन फूल जमा करासेत।<verse eid="SNG 6:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="SNG 6:3" />मी अपरो चहेतो की सेंऊ,</para>
  <para style="q2" vid="SNG 6:3">अना मोरो चहेतो मोर से,</para>
  <para style="q2" vid="SNG 6:3">ऊ अपरी सेरी-मेढ़ागिन ला</para>
  <para style="q2" vid="SNG 6:3">सोसन फूलगिन को बीच मा चरावासे।<verse eid="SNG 6:3" /></para>
  <para style="s">पाँचवाँ गीत</para>
  <para style="sp">नवरा</para>
  <para style="q1">
    <verse number="4" style="v" sid="SNG 6:4" />अवो मोरी चहेती, तू तिरजा नगर खोपसूरत अना</para>
  <para style="q2" vid="SNG 6:4">यरूसलेम नगर को जसी रूपवान से,</para>
  <para style="q2" vid="SNG 6:4">अना झंड़ा फयरावती हुयी</para>
  <para style="q2" vid="SNG 6:4">सेना को जसो ताकतवर से।<verse eid="SNG 6:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="SNG 6:5" />अपरी निघा मोरो कन लक फिराय ले,</para>
  <para style="q2" vid="SNG 6:5">काहेका मी उनको लक घबरासू;</para>
  <para style="q2" vid="SNG 6:5">तोरा केस असी सेरी गिनको करप को</para>
  <para style="q2" vid="SNG 6:5">जसो से, जोन गिलाद पहाड़ की उतार मा सोयी चोवासेत।<verse eid="SNG 6:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="SNG 6:6" />तोरा दाँत असो मेन्ढी को जसो से,</para>
  <para style="q2" vid="SNG 6:6">जोनला आंग खोराय गयो से,</para>
  <para style="q1" vid="SNG 6:6">करप लक सब जोड़वा लेकरु देसेत</para>
  <para style="q2" vid="SNG 6:6">जेको मा लक कोनी को संगी नही मरयो।<verse eid="SNG 6:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="SNG 6:7" />तोरा गाल तोरो केस खाल्या</para>
  <para style="q2" vid="SNG 6:7">अनार की फाक जसो चोवासेत।<verse eid="SNG 6:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="SNG 6:8" />साठ रानीगिन अना अस्सी रखेल</para>
  <para style="q2" vid="SNG 6:8">अना बेगिनित कुवारी भी से।<verse eid="SNG 6:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="SNG 6:9" />पर मोरी परेवा, मोरी सुन्दरी,</para>
  <para style="q2" vid="SNG 6:9">अपरी माय एक एखली लाड़ की टूरी से,</para>
  <para style="q2" vid="SNG 6:9">वय सब ना वोला चोयो ना धन्य कह्यो;</para>
  <para style="q2" vid="SNG 6:9">रानीगिन अना रखेल गिनना वोला चोय के वोकी बड़ाई करयो।<verse eid="SNG 6:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="SNG 6:10" />यो कोन आय जेकी सोभा भुमसारे</para>
  <para style="q2" vid="SNG 6:10">जसी से, सुन्दर चन्दा अना दिन को जसो निरमल, अना</para>
  <para style="q1" vid="SNG 6:10">फयरावतो हुयी झंडा को सेना जसो ताकतवर चोवा से?<verse eid="SNG 6:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="SNG 6:11" />मी अखरोट को घाटी को बीच मा उतर गयी, चोऊ,</para>
  <para style="q2" vid="SNG 6:11">का अंगूर फुलायो का नही,</para>
  <para style="q2" vid="SNG 6:11">अनार का फूल फुलायो का नही।<verse eid="SNG 6:11" /></para>
  <para style="q2">
    <verse number="12" style="v" sid="SNG 6:12" />मोला मालुम भी नोहोतो का</para>
  <para style="q2" vid="SNG 6:12">मोरो मनसा ना मोला अपरो राजकुमार</para>
  <para style="q2" vid="SNG 6:12">को रथ पर चघाय दियो।<verse eid="SNG 6:12" /></para>
  <para style="sp">सहेली</para>
  <para style="q1">
    <verse number="13" style="v" sid="SNG 6:13" />लौट आव, लौट आव, का आमी तोरो पर</para>
  <para style="q2" vid="SNG 6:13">निघा करजन।</para>
  <para style="sp" vid="SNG 6:13">नवरी</para>
  <para style="q1" vid="SNG 6:13">का तुमी सुलेमीन<note caller="+" style="f"><char style="fr" closed="false">6:13 </char><char style="ft" closed="false">सान्तीवारी</char></note> टूरी ला असो चोहो?</para>
  <para style="q2" vid="SNG 6:13">जसो कोनी दुई मडंली को नाच होय?<verse eid="SNG 6:13" /></para>
  <chapter eid="SNG 6" />
  <chapter number="7" style="c" sid="SNG 7" />
  <para style="sp">नवरा</para>
  <para style="q">
    <verse number="1" style="v" sid="SNG 7:1" />अवो राजकुमारी,</para>
  <para style="q2" vid="SNG 7:1">तोरो पाय जूतिगिन मा कसो साजरो लगा सेत!</para>
  <para style="q" vid="SNG 7:1">तोरी जाघंगिन की गोलायी असा जेवर जसो से,</para>
  <para style="q" vid="SNG 7:1">जेला कोनी चतुर कारीगीर ना बनायो से।<verse eid="SNG 7:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="SNG 7:2" />तोरी बोमली सुन्दर कटोरी जसी से,</para>
  <para style="q" vid="SNG 7:2">वोना हरामेसा अंगूर को रस लक भरयो हुयो रव्हासे।</para>
  <para style="q" vid="SNG 7:2">तोरो पोट गंहू को बोझा जसो से जेको</para>
  <para style="q" vid="SNG 7:2">चारीआंगन सोसन का फूल रव्हासे।<verse eid="SNG 7:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="SNG 7:3" />तोरी दूही छाती</para>
  <para style="q" vid="SNG 7:3">हिरनी का जोड़वा लेकरुगिन जसो से।<verse eid="SNG 7:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="SNG 7:4" />तोरो गरो हाती को दात जसो खम्बा से<note caller="+" style="f"><char style="fr" closed="false">7:4 </char><char style="ft" closed="false">हात्ती दाँत को मिनार सेत। यो साईद सुलैमान लक बनायो हत्ती को दाँत की मीनार होती जोनको बरोबरी करयो जाय रह्यो होती।</char></note></para>
  <para style="q" vid="SNG 7:4">तोरा डोरा हेसबोन सहेर का वय कुन्डगिन को जसो से,</para>
  <para style="q" vid="SNG 7:4">जोन बेतरब्बीम को बेसकूड़ जवर से।</para>
  <para style="q" vid="SNG 7:4">तोरी नाक एतरी सुन्दर से जसी लबानोन को खम्बा आय,</para>
  <para style="q" vid="SNG 7:4">जेको टोंड दमिस्क कन से।<verse eid="SNG 7:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="SNG 7:5" />तोरो डोसका तोरो पर</para>
  <para style="q2" vid="SNG 7:5">करमेल परबत जसो सोभा देसे,</para>
  <para style="q2" vid="SNG 7:5">अना तोरी डोई का केस लाल बैंगनी</para>
  <para style="q2" vid="SNG 7:5">कपरा जसो सेत;</para>
  <para style="q2" vid="SNG 7:5">राजा उनला चोयके कैदी भय गयो से।<verse eid="SNG 7:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="SNG 7:6" />अवो! चहेती अना मनमोहनी कुवारी,</para>
  <para style="q2" vid="SNG 7:6">तू केतरी सुन्दर टूरी सेस!<verse eid="SNG 7:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="SNG 7:7" />तोरो कद खजूर को झाड़ जसो ऊच्चो से,</para>
  <para style="q2" vid="SNG 7:7">अना तोरी छाती अंगूर को गुच्छा जसो से।<verse eid="SNG 7:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="SNG 7:8" />मीना कह्यो, “मी एना खजूर मा</para>
  <para style="q2" vid="SNG 7:8">चघके वोकी खंदाली गिनला धरु।”</para>
  <para style="q2" vid="SNG 7:8">तोरो छाती अंगूर को गुच्छा सेत।</para>
  <para style="q2" vid="SNG 7:8">अना तोरी सांस की महेक सेब गिन जसो से<verse eid="SNG 7:8" /></para>
  <para style="s">नवरी</para>
  <para style="p">
    <verse number="9" style="v" sid="SNG 7:9" />तोरो चुम्मा चोखो अंगूर को रस जसो से। यो ओठ लक धिरू-धीरू बोहासे।<verse eid="SNG 7:9" /></para>
  <para style="q2">
    <verse number="10" style="v" sid="SNG 7:10" />मी अपरो चहेतो की सेंऊ,</para>
  <para style="q2" vid="SNG 7:10">अना वोको मन मोला पान को से।<verse eid="SNG 7:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="SNG 7:11" />होय मोरी चहेती, आव आमी खेतगिन मा</para>
  <para style="q2" vid="SNG 7:11">चली जाबोन अना गांव मा रात बितावाबोन ।<verse eid="SNG 7:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="SNG 7:12" />मंग पहाट ला उठके अंगूर को बाड़ी मा</para>
  <para style="q2" vid="SNG 7:12">जाबोन, अना चोवबिन का वोमा फूल</para>
  <para style="q2" vid="SNG 7:12">फुलयो का नही अनार फुलयो का नही</para>
  <para style="q2" vid="SNG 7:12">वोमा मी तोला</para>
  <para style="q2" vid="SNG 7:12">अपरो पिरेम चोवाहूं।<verse eid="SNG 7:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="SNG 7:13" />दोदा फर गिन<note caller="+" style="f"><char style="fr" closed="false">7:13 </char><char style="ft" closed="false">फूल को मिठ्ठो सुगंध </char></note> लक महेक आय रही से,</para>
  <para style="q2" vid="SNG 7:13">अना आमरो डेहरी मा लगत पिरकार का</para>
  <para style="q2" vid="SNG 7:13">चोखा फर सेती, नवा-जुना सब होय मोरी</para>
  <para style="q2" vid="SNG 7:13">चहेती मीना तोरो लायी ठेयोसे।<verse eid="SNG 7:13" /></para>
  <chapter eid="SNG 7" />
  <chapter number="8" style="c" sid="SNG 8" />
  <para style="q1">
    <verse number="1" style="v" sid="SNG 8:1" />अदी तू मोरो भाऊ होतो, अना मोरो खुद को परीवार लक एक होतो तो मी तोला बाहेर चुम लेती अना कोनी मोरो पर दोस नही लगावतो।<verse eid="SNG 8:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="SNG 8:2" />मी तोला अपरी माय घरा लिजाती,</para>
  <para style="q2" vid="SNG 8:2">अना वा मोला सिखावती,</para>
  <para style="q2" vid="SNG 8:2">मी तोला मसाला मिलयो अंगूर को</para>
  <para style="q2" vid="SNG 8:2">अखिन अनार को रस पिवावती।<note caller="+" style="x"><char style="xo" closed="false">8:2 </char><char style="xt" closed="false"><ref loc="PRO 9:2">नीतीवचन 9:2</ref></char></note><verse eid="SNG 8:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="SNG 8:3" />असो होतो का, वोको डावो हात</para>
  <para style="q2" vid="SNG 8:3">मोरो डोई खाल्या अना ऊजो हात लक</para>
  <para style="q2" vid="SNG 8:3">ऊ मोला सहेला लेवतो ।<verse eid="SNG 8:3" /></para>
  <para style="q2">
    <verse number="4" style="v" sid="SNG 8:4" />अवो! यरूसलेम की टूरीगिन</para>
  <para style="q2" vid="SNG 8:4">मी तुमला कसम खवावसू का,</para>
  <para style="q2" vid="SNG 8:4">तुमी मोरो पिरेम ला नोको उठावनात</para>
  <para style="q2" vid="SNG 8:4">जबा तकन ऊ खुद ना उठनो चाहेत।<verse eid="SNG 8:4" /></para>
  <para style="s1">छठा गीत</para>
  <para style="sp">नवरी</para>
  <para style="q1">
    <verse number="5" style="v" sid="SNG 8:5" />वय कोन आत जोन मोरो चहेतो</para>
  <para style="q2" vid="SNG 8:5">को हात मा हात डाकयो बन्जर रेगिस्थान लक आवासेती?</para>
  <para style="q" vid="SNG 8:5">सेब को झाड़ को खाल्या मीना तोला जगायो,</para>
  <para style="q3" vid="SNG 8:5">वहाँ तेरी मायना तोला तोरी माय ने जलमायो।</para>
  <para style="q2" vid="SNG 8:5">वहाँ तेरी माय ला दरद उठयो।<verse eid="SNG 8:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="SNG 8:6" />मोला आपरो दिल मा एक मूहर को जसो राखो</para>
  <para style="q2" vid="SNG 8:6">अना आपरो बाही मा एक ताबीज को जसो,</para>
  <para style="q2" vid="SNG 8:6">काहेका पिरेम मवत को जेतरो मजबूत से,</para>
  <para style="q2" vid="SNG 8:6">एको ईरसा समाधी को जसो निरदयी से</para>
  <para style="q2" vid="SNG 8:6">यो धड़कतो स्तो को जसो जरासेत,</para>
  <para style="q2" vid="SNG 8:6">एक ताकतवर धगाड़ी की जसी।<verse eid="SNG 8:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="SNG 8:7" />पानी की पूरा लक भी, अखिन ना</para>
  <para style="q2" vid="SNG 8:7">महानदीगिन लक पिरेम नही बुड़ सका से</para>
  <para style="sp" vid="SNG 8:7">बायको को भाऊ</para>
  <para style="q2" vid="SNG 8:7">अदि कोनी आपरी सप्फा सम्पति भी</para>
  <para style="q2" vid="SNG 8:7">पिरेम को बदला मा दे-दे</para>
  <para style="q2" vid="SNG 8:7">तबा भी फिकी पड़ जाहे।<verse eid="SNG 8:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="SNG 8:8" />आमरी एक नहानी बहिन से</para>
  <para style="q2" vid="SNG 8:8">जेकी छाती अबा नही उभरी से,</para>
  <para style="q2" vid="SNG 8:8">जेना दिवस वा बिहाव लायी होय जाहे</para>
  <para style="q2" vid="SNG 8:8">तबा आमी का करबीन?<verse eid="SNG 8:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="SNG 8:9" />अदि वा नगर को परकोट रव्हती ता आमी</para>
  <para style="q2" vid="SNG 8:9">वोको पर खूरो का मिनार बनावता,</para>
  <para style="q2" vid="SNG 8:9">अना वा किवाड़ होति ता वोको पर</para>
  <para style="q2" vid="SNG 8:9">देवदार का तख्ता लगावता।<verse eid="SNG 8:9" /></para>
  <para style="sp">वधू</para>
  <para style="q1">
    <verse number="10" style="v" sid="SNG 8:10" />मी नगर को परकोट होती अना मोरी छाती</para>
  <para style="q2" vid="SNG 8:10">वोको लाय खम्बा आय। तबा मी अपरो चहेतो</para>
  <para style="q2" vid="SNG 8:10">की निघा मा सांती देनवाली जसी होती।<note caller="+" style="x"><char style="xo" closed="false">8:10 </char><char style="xt" closed="false"><ref loc="EZK 16:7">यहेजकेल 16:7</ref>; <ref loc="1KI 4:24-25">1 राजा 4:24-25</ref></char></note><verse eid="SNG 8:10" /></para>
  <para style="sp">वर</para>
  <para style="q1">
    <verse number="11" style="v" sid="SNG 8:11" />बाल् हामोन नगर मा राजा सुलैमान को</para>
  <para style="q2" vid="SNG 8:11">एक अंगूर को बाड़ी होतो;</para>
  <para style="q2" vid="SNG 8:11">वोना वोला किसान गिनला</para>
  <para style="q2" vid="SNG 8:11">ठेका मा दे दियो,अ ना</para>
  <para style="q2" vid="SNG 8:11">हरेक किसानगिन वोला वोको फरगिन लायी</para>
  <para style="q2" vid="SNG 8:11">खुरो का एक हजार सिक्का देत होतिन।<verse eid="SNG 8:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="SNG 8:12" />सुलैमान ला एक हजार सिक्का अखीन किसान गिनला दोन सव सिक्का दियो जाहेत;अना मोरो कन एक अंगूर को बाड़ी से।<verse eid="SNG 8:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="SNG 8:13" />तू जोन बाड़ीगिन मा रव्हासेस मोरा संगी</para>
  <para style="q2" vid="SNG 8:13">तोरी अवाज आयकनो चाव्हासेत; मोला</para>
  <para style="q2" vid="SNG 8:13">भी अपरी अवाज आयकन दे।<verse eid="SNG 8:13" /></para>
  <para style="sp">नवरी</para>
  <para style="q1">
    <verse number="14" style="v" sid="SNG 8:14" />ओ मोरी पिरेमी, लहाकी कर,</para>
  <para style="q2" vid="SNG 8:14">अना महेक वाला पहाड़गिन मा मिरग या जुवान हिरन जसो बनके जाय।<verse eid="SNG 8:14" /></para>
  <chapter eid="SNG 8" />
</usx>