<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="REV" style="id">- Powari Standard Project</book>
  <para style="h">प्रकासित वाक्य</para>
  <para style="toc3">परकासित वाक्य</para>
  <para style="toc2">परकासित वाक्य</para>
  <para style="toc1">योहन को परकासित वाक्य</para>
  <para style="mt2">यहुन्ना का प्रकासितवाक्य</para>
  <para style="mt1">योहन को परकासित वाक्य</para>
  <para style="imt">परिचय</para>
  <para style="ip">यो परकासितवाक्य किताब नवा करार को अखट्ट किताब आय। यो भी पेरीत योहन लक मसीह को जलम को 95 साल बाद लिख्यो गयो होतो। <char style="xt"><ref loc="REV 1:1">1:1</ref></char> वोना योहन लक लिख्यो साजरा बारता अखीन तीन चिठ्ठी 1 योहन, 2 योहन अखीन 3 योहन भी लिख्यो से। योहन ला यीसु पिरेम करत होतो, को रूपमा भी जानो जावासे। <char style="xt"><ref loc="JHN 13:23">योहन 13:23</ref> </char> वोना पतमुस द्वीप मा परकासित वाक्य को किताब एकोलाय लिख्यो काहेका वोला यीसु मसीह को साजरा बारता परचार करन को जुरुम मा हेड़ो गयो होतो। <char style="xt"><ref loc="REV 1:9">परकासित वाक्य 1:9</ref> </char></para>
  <para style="ip">परकासित वाक्य को किताब ला लिखनो मा योहन को लक्छ वाचन वारो ला यीसु मसीह को लाय बिस्वास को काबिल बनयो रहनो मा उनला आस देवन को लाय जोस पैदा करनो से काहेका वोको वापिस आवनो को बेरा जवर से। <char style="xt"><ref loc="REV 1:3">परकासित वाक्य 1:3</ref>; <ref loc="REV 22:7">22:7</ref> </char> वोना सबा ईसाई गिनको सधारन तरीका लक सात बिसेस चरच ला अध्याय <char style="xt"><ref loc="REV 2-3">2—3</ref> </char> मा लिख्यो होतो। योहन आपरो खुद को लेख ला भविस्यवानी को रूपमा दरसावासे। <char style="xt"><ref loc="REV 1:3">1:3</ref> </char>अखीन जोन काही वोना चोवयो वोको बारेमा सांगन को लाय लगत फोटू जसो वापरासेत। यो किताब जूनो करार को काही हिस्सा जसो से। खास रुप लक <char style="xt"><ref loc="ZEC 6:1-8">जकर्याह 6:1-8</ref> </char>सात तुर्रा अना सात बटकी वोना आफद को जसो से जोनला परमेस्वर ना मिसर ला सजा देवन को लाय धाड़यो होतो। <char style="xt"><ref loc="EXO 7-9">हिटनो 7—9</ref> </char> रहस्योद्घाटन को बेरा आखीर को बारेमा गोस्टी करासे जोनमा यीसु जीत जाहेत। अखीन वय सप्पा जोन वोको पर भरोसा करासेत। वोको संग हरामेसा को लाय रहेत। यो किताब सबला सजग करासे अना आस देवासे का यीसु लवकर आवन वारो से।</para>
  <para style="iot">रूपरेखा</para>
  <para style="io1">1. योहन यो कव्हन को लक सुरु करासे, का वा कोन आय? अना वोला होवनवारो गोस्टी को बारेमा कसो दरसन भेटयो से। <char style="ior"><ref loc="REV 1:1-20">1:1-20</ref> </char></para>
  <para style="io1">2. उ सिद्दो यीसु को कन लक सात समूह ला खबर देवासे। <char style="ior"><ref loc="REV 1:1-3:22">1:1—3:22</ref></char></para>
  <para style="io1">3. मंग उ सात मुहरगिन अना सात तुर्रा को बारेमा सांगा से। <char style="ior"><ref loc="REV 4:1-8:5">4:1—8:5</ref>; <ref loc="REV 8:6-11:19">8:6—11:19</ref> </char></para>
  <para style="io1">4. मंग योहन सात डोस्का को संग अजगर को खिलाप नर लेकरा को लड़ाई को बारेमा सांगासे। <char style="ior"><ref loc="REV 12:1-14:20">12:1—14:20</ref> </char></para>
  <para style="io1">5. मंग उ गुस्सा को सात बटकी को बारे मा लिखा से। <char style="ior"><ref loc="REV 15:1-16:18">15:1—16:18</ref> </char></para>
  <para style="io1">6. मंग योहन लिखा से का कसो परमेस्वर सरग मा आपरो बैरी गिनला हरावा से। <char style="ior"><ref loc="REV 17:1-20:15">17:1—20:15</ref> </char></para>
  <para style="io1">7. अखट्ट मा नवा सरग अखीन नवा धरती को बारेमा लिख्यो से। अना वा अखट्ट मा आहेत। <char style="ior"><ref loc="REV 21:1-22:21">21:1—22:21</ref> </char></para>
  <chapter number="1" style="c" sid="REV 1"/>
  <para style="p">
    <verse number="1" style="v" sid="REV 1:1"/>यो यीसु मसीह को अदभुत सन्देसा सेत। जेनला परमेस्वर को कन लक एकोलाय दियो होतो। का जोन गोस्टी लवकर पुरो होवन वालो सेत। उनला आपरो दास गिनला दरसायो जाय। आपरो सरगदूत धाड़के यीसु ना आपरो दास योहन इसारा मा साँगीसेस। <verse eid="REV 1:1"/><verse number="2" style="v" sid="REV 1:2"/>योहन ना जोन काही चोवयो होतो, वोको बारेमा सांगिस वा खरो सेत। जोनला यीसु मसीह ना सांगयो होतो। यो वा खबर से, जोन परमेस्वर कन लक सेत। <verse eid="REV 1:2"/><verse number="3" style="v" sid="REV 1:3"/>धन्य सेत वय जोन यो परमेस्वर को यो खबर ला आयक सेत, अना यो मा लिखयो गोस्टी ला माना सेत। काहेका मुसिबत को बेरा जवर सेत।<verse eid="REV 1:3"/></para>
  <para style="s">सात कलीसिया को नमस्कार</para>
  <para style="p">
    <verse number="4" style="v" sid="REV 1:4"/>योहन को कन लक एसिया प्रान्त को सात कलीसिया गिनको नाव, वोना परमेस्वर को कन लक, जो अबा से, अना हरामेसा होतो अना जोन आवनवाला सेत। अना उन सात आत्मा गिनको कन लक जोन वोको सिघासन को समोर सेत। <verse eid="REV 1:4"/><verse number="5" style="v" sid="REV 1:5"/>अना यीसु मसीह कन लक जो भरोसा लायक गवाह, मरयो हुयो मा लक जी उचलनो मा पयलो, अना सारो जगत को राजा गीन को मुखिया से। तुमला किरपा अना सान्ती मिलत रव्हे।</para>
  <para style="p" vid="REV 1:5">उ आमरो लक माया राखासेत, अखिन आपरो रकत लक अमिला पाप लक छुड़ायो से। <verse eid="REV 1:5"/><verse number="6" style="v" sid="REV 1:6"/>वोना अमीला एक राज अना अपरो परमेस्वर दआजी को सेवामा याजक होवन लाय रचयो। ओको गौरव अना ताकत जुगजुग तकन बनयो रह। आमेन<verse eid="REV 1:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="REV 1:7"/>चोवो, बदली को संग मसीह आवा से। हरेक डोरा वोला चोवयेत। उनमा वय भी सेत जोनना वोला छेदयो होतिन। दुनिया मा सबा लोकहुन वोको कारन रड़ेत। असोच होवनो पाहिजे। आमीन!<verse eid="REV 1:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="REV 1:8"/>परमेस्वर जो सब लक ताकत वर से, यो कव्हसे, “कवन से? कवन होतो? अना कवन आवन वालो से? मी च पयलो अना आखीर सेऊ।”<verse eid="REV 1:8"/></para>
  <para style="s">योहन ला मसीह को चोवनो</para>
  <para style="p">
    <verse number="9" style="v" sid="REV 1:9"/>मी योहन, तुम्हारो भाऊ सेऊ, अना यीसु को चेला को रूप मा, मी उन लोक गिनको लाय धीरज लक धीरज राखअ सेऊ, जोन उनको राज को बारेमा सेत। मोला पतमोस टापु मा डाख दियो गयो। काहेका मीना परमेस्वर को बचन अना यीसु कन लक सांगयो गयो सच्चाई को मुनादी कियो होतो। <verse eid="REV 1:9"/><verse number="10" style="v" sid="REV 1:10"/>यहोवा को दिवस मा आतमा ना मोला आपरो बसमा कर लियो। तबा मीना जोरलक आवाज आयकुआय। जोन तुर्रा जसो लग रह्यो होतो। मोरो मघा बोलत होतो। <verse eid="REV 1:10"/><verse number="11" style="v" sid="REV 1:11"/>की जो काही तु देखीसेस ओला किताब मा लिख अना सात कलीसिया गीन को नाव धाड़ मजे इफिसुस, स्मुरना, पिरगमुन, थुआतीरा, सरदीस फिलोदिपिया अना लौदीकिया ला धाड़ देव। <figure style="fig" alt="Map of seven churches in Asia" file="HK00378C.tif" size="span" copy="Horace Knowles ©" ref="1:11">एसिया में सात चरच गिनको नक्सा</figure><verse eid="REV 1:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="REV 1:12"/>यो चोवन लाय मि मुरक गयो, का कवन मोरो लक गोस्टी करा से? अना मी ना सात सोन्नो को दियोदानी चोवयो। <verse eid="REV 1:12"/><verse number="13" style="v" sid="REV 1:13"/>अना उन टवरी गीन को बीच मानूस को टूरा जसो एक मानूस जो पाय हिन तकन लम्बो कुरता घाल्यो अना छाती पर एक सुनहरो पट्टा बांधयो हुयो होतो। <verse eid="REV 1:13"/><verse number="14" style="v" sid="REV 1:14"/>ओको डोस्की अना ओको चुन्दी ऊन जसो पाँढरो अना बरफ को जसो जगाजग पाँढरो होतो। अना ओको डोरा स्तो को स्तो को जसो होतीन। <verse eid="REV 1:14"/><verse number="15" style="v" sid="REV 1:15"/>ओको पाय असो चमकिलो पीतल को जसो होतीन जो भट्टी मा तपयो के चमकायो गयो होयहेत। ओको आवाज पानी को आवाज जसी होती। <verse eid="REV 1:15"/><verse number="16" style="v" sid="REV 1:16"/>उ जेवनो हात को सात तारागीन ला धरयो हुयो होतो। ओको टोंड लक ताकत वालो तेज जसी तलवार हिटत होती। ओको टोंड को सोभा दुफार को सुरज को जसो चमक रहयो होतो। <verse eid="REV 1:16"/><verse number="17" style="v" sid="REV 1:17"/>जबा मिना ओला दिसयो ता मरो हुयो जसो ओको पाय मा गिर पड़यो, वोना मोरो पर आपरो उजो हात राख के सागयो नको भेव खाय मी पयलो अना अखट्ट जिवित सेव। <verse eid="REV 1:17"/><verse number="18" style="v" sid="REV 1:18"/>मि मर गयो होतो अता मि सदा लक जित्तो सेव। मिरतु अना नरक को कुन्जी मोरो जवर से। <verse eid="REV 1:18"/><verse number="19" style="v" sid="REV 1:19"/>एको लाई जो गोस्टी तु ना देखीसेस, जो गोस्टी होय रही सेत, उनला लिख लेव जोस। <verse eid="REV 1:19"/><verse number="20" style="v" sid="REV 1:20"/>वोय सात तारा गीन को भेद जो तुना मोरो जेवनो हात मा देखीसेस अना सात सोनो को टवरी को भेद यो आय; सात तारागीन, सात कलीसियागीन को दूत सेत, अना वय सात दियो सात कलीसिया गीन सेत।<verse eid="REV 1:20"/></para>
  <chapter eid="REV 1"/>
  <chapter number="2" style="c" sid="REV 2"/>
  <para style="s">इफिसुस ला खबर</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 2:1"/>“इफिसुस को कलीसिया को सरगदूत को नाव असो लिख, उ जो आपरो हात मा सात तारा धरीसेस।” अना उ जो सात सोन्नो को दियो दानी को बीच चलत फिरत रव्हसे। उ असो कव्हसे। <verse eid="REV 2:1"/><verse number="2" style="v" sid="REV 2:2"/>“मि तोरो करयो गयो काम, मेहनत आना धीरज ला जानुसू।” का तू बुरो लोकईन ला, फूटयो डोरा नही भअवा सेत। अना जोन आपरो आपच ला पेरीत ठहरायो सेत। पर उ नहाय तुना उनला परख के खोटो पायो सेत। <verse eid="REV 2:2"/><verse number="3" style="v" sid="REV 2:3"/>मोला मालूम सेत का तोरो मा धीरज से, अना मोरो नाव को कारन तु दुख उठात-उठात थकयो नही सेत। <verse eid="REV 2:3"/><verse number="4" style="v" sid="REV 2:4"/>पर मोला तोरो विरोध मा असो कव्हन ला से। की तुना आपरो पयलो जसो माया ला छोड़ देइसेस। <verse eid="REV 2:4"/><verse number="5" style="v" sid="REV 2:5"/>एकोलाय तु हेत कर की तु कहान लक पड़ीसेस। अना पाप लक मन ला हटाव, अना पयलो को जसो काम नही करसेस तो मि तोरो जवर आवसेऊ। अना मन नही फिरावजोस त तोरो दियोदानी ला तोरो हात लक छुड़ाय लेहुँ। <verse eid="REV 2:5"/><verse number="6" style="v" sid="REV 2:6"/>पर ऐतरो भलो से की तु नीकुलीयो को काम लक घिरना बैर करासेस जिनलक मि भी बैर करसू।<verse eid="REV 2:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="REV 2:7"/>जेनको कान सेत ता वा आयक लेव का आतमा कलीसिया लक काजक कव्हसे।</para>
  <para style="p" vid="REV 2:7">जो जीत जाहे मी ओला परमेस्वर को सरग म लक “जीवन को झाड़ को फर खान ला देहूं।”<verse eid="REV 2:7"/></para>
  <para style="s">स्मुरना को कलीसिया</para>
  <para style="p">
    <verse number="8" style="v" sid="REV 2:8"/>स्मुरना को कलीसिया को सरगदूत ला असो लिख,</para>
  <para style="p" vid="REV 2:8">“उ जोन पयलो अना आखीर से। जिन मर गयो होतो अबा जोन दुबारा जित्तो भयो से। उ असो कव्हसेत।” <verse eid="REV 2:8"/><verse number="9" style="v" sid="REV 2:9"/>“मी तुमरो दुख अखिन तुमरो गरीबी को बारेमा जाना सेऊ।” मंग सहीमा तुम्ही धनवान सेव! जोन अपरो आपला यहूदी कव्हसेत। तुमरो जोन निन्दा करतत, वोला भी जाना सेऊ। मंग वय यहूदी नाहती। बल्कि वय तो सैतान को भगती करन वालो को एक जमघट सेत। <verse eid="REV 2:9"/><verse number="10" style="v" sid="REV 2:10"/>उन दुख तकलीफ लक तू नोको डराय जोन तोला झेलनो सेत। आयको सैतान तुम लोक मा काही ला जेलमा डाखेत जोनलक तुमरो परिक्सा लेहेत। अना तुमला यो दुख दहा दिवस तकन भोगनो सेत। चाहे तोला मौत आ जाय, पर सच्चो बनेयो रव्जोस। अना मि तोला अमर जीवन को जीत को मुकुट देहिन।<verse eid="REV 2:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="REV 2:11"/>“जोन आयक सका सेत वा आयके आतमा कलीसिया लक काजक कव्हसेत? जोनला जीत मिल्हेत वोला दुबारा मरन को हान नही होयेत।<verse eid="REV 2:11"/></para>
  <para style="s">पिरगमुन को कलीसिया</para>
  <para style="p">
    <verse number="12" style="v" sid="REV 2:12"/>“पेरगाम को कलीसिया को सरगदूत ला लिख।”</para>
  <para style="p" vid="REV 2:12">यो वोना मानूस को खबर सेत जोन को जवर दुई धार वालो तरवार से। <verse eid="REV 2:12"/><verse number="13" style="v" sid="REV 2:13"/>मी जाना सेऊ का तुम्ही कितानी रव्हअ सो? जितानी सैतान को सिघासन सेत। तुम मोरो लाय सच्चो सेव। अना तुमीना वोन बेरा भी बिस्वास नहि सोड़यो, जबा मोरो बिस्वासी गवाह अन्तापस मारयो गयो। जितानी सैतान रव्हत होतो। <verse eid="REV 2:13"/><verse number="14" style="v" sid="REV 2:14"/>परा मोला तोरो विरोध मा काही कव्हनो सेत। तुमरो मा काही लोक सेत। जोन बिलाम को सिक्सा को पालन करा सेत। बिलाम ला सिक्सा दियो होतो। का इजरायली गिन मुरती पर चघायो जेवन जेये, अखिन छिनाला करन लाय राजी कियो जाय। <verse eid="REV 2:14"/><verse number="15" style="v" sid="REV 2:15"/>असो परकार तोरो यहान काही असो लोक भी सेत। जोन नीकुलीयो गिनको सिक्सा चलअ सेत। <verse eid="REV 2:15"/><verse number="16" style="v" sid="REV 2:16"/>अपरो आप ला पाप लक दुहूर करो। अदी तुम्ही असो नही करासेव ता मी लवकर तुमरो जवर आहिन। अना उन लोक गिनलक मोरो तोन्ड लक हिटयो तरवार लक लड़ाई करबिन।<verse eid="REV 2:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="REV 2:17"/>“अगर तुमरो कान से, तो आयको, आतमा कलीसिया लक काजक कव्हसेत।”</para>
  <para style="p" vid="REV 2:17">“जोन लोक जीत जाहेत, मी उनला काही ला लुकायो मन्ना देहिन।” मी उनलक हरेक ला एक पांढरो गोटा देहुँ। जोनमा एक नवा नाव लिखयो गयो से। जोनला कोनी भी नहीं जाना सेत। जोनला यो भेटासेत।<verse eid="REV 2:17"/></para>
  <para style="s">थुआतीरा को कलीसिया</para>
  <para style="p">
    <verse number="18" style="v" sid="REV 2:18"/>थुआतीरा को कलीसिया को सरगदूत ला लिख, परमेस्वर को टूरा, जेकी डोरा स्तो को धगाड़ी जसो अना जेनको पाय चमचमातो सुध्द काँसो जसो सेत, यो कव्हसेत, <verse eid="REV 2:18"/><verse number="19" style="v" sid="REV 2:19"/>मि तोरो काम अना माया भरोसा, तोरो सेवा अना धिरज लक सहनो ला जानूसेव, अना यो भी की तोरो अबा को काम मंघा को कामगीन लक बढ़के सेत। <verse eid="REV 2:19"/><verse number="20" style="v" sid="REV 2:20"/>पर मोला तोरो विरोध मा मोला यो कव्हनो से, की तु ओनो आई-माई ईजबेल ला आपरो बीच रव्हन देसेस, जो आपरो आपच ला भविस्यवक्तनी कव्हसे, अना मोरो दास गीन ला छिनालापन काम करन अना मुरत गीन को पुड़ा चघायो हुयो मांस खान को लाई, सिखावसे अना भटकावसे। <verse eid="REV 2:20"/><verse number="21" style="v" sid="REV 2:21"/>मिना ओला मौका दियो की पस्तावा करयेत, पर उ आपरो छिंडरापन लक पसतावा करनो नही चाहव्त होती। <verse eid="REV 2:21"/><verse number="22" style="v" sid="REV 2:22"/>देख, मि ओला खाट पर डाक देसू, अना जो ओको जवर छिंडरापन करासेत, अदी वय ओको जसो कामगीन पस्तावा नही करयेत, ता उनला मोठो संकट मा डाखू। <verse eid="REV 2:22"/><verse number="23" style="v" sid="REV 2:23"/>मि ओको महामारी लक वोको लेकरा गिनला मारुँह अना सप्पा कलीसिया ला मालूम भय जाहे का मन ला अखीन आतमा ला जाँचन वालो मि च सेव। अना मि तुमी मा लक हरेक ला ओको कामगीन को अनुसार फर देहबिन।<verse eid="REV 2:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="REV 2:24"/>अबा मि थुआतीरा को बचयो लोकगीन लक कव्हसू, जो एने सिक्सा ला नही मानासे अना जसो की वय कव्हसेत, की सैतान को गहरो गोस्टी गीन ला जानासे, मंग नही जानासे, मि तुमी पर अना लगत बोझ डाखनो नही चाव्हअ सेऊ। <verse eid="REV 2:24"/><verse number="25" style="v" sid="REV 2:25"/>मंग जो भी काही तुमरो जवर सेत, ओला मोरो आवन तकन ताकत पुर्वक संभाल लेव। <verse eid="REV 2:25"/><verse number="26" style="v" sid="REV 2:26"/>जो जीत पाहे अना जो मोरो कामगीन ला आखरी तकन करत रह, ओला मि देस-देस पर हक देहुं। <verse eid="REV 2:26"/><verse number="27" style="v" sid="REV 2:27"/>उ उनको पर लोहा को छड़ी लक हुकूम चलाहे, जसो माती को भान्डो चकनाचुर होय जासे वसोच उनको हाल कर देहेत। <verse eid="REV 2:27"/><verse number="28" style="v" sid="REV 2:28"/>मि ओला भुमसारे को तारा जसो दे देहूं। यो वोच हक सेत, जोनला मिना परमेस्वर दआजि लक पायोसेउ। मि ओना मानूस ला भुमसारे को तारा देहूं।<verse eid="REV 2:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="REV 2:29"/>जेका कान होयेत, उ आयक लेहेत की आतमा कलीसिया लक काजक कव्हसे।<verse eid="REV 2:29"/></para>
  <chapter eid="REV 2"/>
  <chapter number="3" style="c" sid="REV 3"/>
  <para style="s">सरदीस को संदेसा</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 3:1"/>सरदीस की कलीसिया को दूत ला असो लिख।</para>
  <para style="p" vid="REV 3:1">जेनको जवर परमेस्वर की सात आतमा अना सात तारा सेत। उ यो कव्हसे, मि तोरो काम ला जानासू, तु जित्तो ता कहलावासे, पर मरयो हुयो सेत। <verse eid="REV 3:1"/><verse number="2" style="v" sid="REV 3:2"/>जागत रव्हो, अना जो चीजगीन बचयो सेत। अना मिटन ला सेत, उनला पिक्को-पिक्को बना, काहेकि मिना आपरो परमेस्वर को नजर मा तोरो कोनी काम ला साजरि नही पाईसेऊ। <verse eid="REV 3:2"/><verse number="3" style="v" sid="REV 3:3"/>एकोलाय तुना जोना सिक्सा ला आयकयो सेत वोला हेतकर अना ओमा च चल। आपरो मनला पाप लक हटाव। अदि तु जागत नोको रव्हजोस, ता मि एकाएक चोर जसो आहुं। मी तोला कब अचरज मा डाख देहू, तोला पता भी नही चलहेत। <verse eid="REV 3:3"/><verse number="4" style="v" sid="REV 3:4"/>काही भी होय, सरदीस मा तोरो जवर काही लोक असा सेत। जिनना आपरो कपरा अपवीतर नही करयो सेत। वय पाँढरो कपरा घालत हुयो, मोरो सँगा चलेत फिरेत। काहेकि वय यो काबिल सेत।<verse eid="REV 3:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="REV 3:5"/>उ जो जीत जाहे, उ असोच रिति लक पांढरो कपरा घालयेत। मी जिंदगी को किताब मा लक वोको नाव नही मिटाहुं। बलकी मी ता वोको नाव ला, आपरो दआजि परमेस्वर अना ओको सरगदूत गीन को पुढ़ा मनता देहिन। नाव मान लेहूं। <verse eid="REV 3:5"/><verse number="6" style="v" sid="REV 3:6"/>जेनको कान सेत वा आयक लेव, की आतमा कलीसिया लक काजक कव्हसे।<verse eid="REV 3:6"/></para>
  <para style="s">फिलदिलफिया ला खबर</para>
  <para style="p">
    <verse number="7" style="v" sid="REV 3:7"/>“फिलोदिपिया को कलीसिया को सरगदूत ला यो लिख, उ जोन पवीतर अना खरो से।” अना जेनको जवर दाऊद की कुन्जी सेत। जोन असो किवाड़ उघाड़ा सेत जोनला कोनी बंद नही कर सका सेत। अना असो बंद करासे जोनला कोनी उघाड़ नही सका। उ असो कव्हसेत।<verse eid="REV 3:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="REV 3:8"/>मि तोरो काम ला जानासू, देख! मिना तोरो लाई एक किवाड़ उघाड़ी सेऊ, जोनला कोनी बंद नही कर सका। मोला पता सेत का, तोरो जवर जरासो ताकत सेत। मंग तुना मोरो गोस्टी का पालन करीसेस अना मोरो नाव लक मघा नही हटयो सेत। <verse eid="REV 3:8"/><verse number="9" style="v" sid="REV 3:9"/>आयको! काही असो सेत, जोन सैतान की सभाघर को सेत। अना आपरो आपच ला यहूदी कव्हसेत। पर वय खोटो सेत। मि उनला यहान आवन को लाय मजबुर करके, तोरो पायको खाल्या कर देहिन। तबा उनला पता लगहेत, का तम्ही मोरो चहेतो सेव। <verse eid="REV 3:9"/><verse number="10" style="v" sid="REV 3:10"/>काहेका तुम्ही ना धिरज लक सहन करता हुया मोरो हुकूम ला मानीसेव। बदल मी परिक्सा को बेरामा तुमारो रक्सा करीन। जोन यो दुनिया मा रव्हन वालों ला परखन लाय पुरो संसार मा बस आवन वालो सेत। <verse eid="REV 3:10"/><verse number="11" style="v" sid="REV 3:11"/>मी लगत लवकर आवा सेऊ। जोन कही तुमरो जवर सेत, वोमा डटो रव्हो, जोनलक तुमरो जीत को मुकुट कोनी तुमरो लक ना ले लेवे। <verse eid="REV 3:11"/><verse number="12" style="v" sid="REV 3:12"/>जोन जिते वोला मी आपरो परमेस्वर को मंदिर को खम्बा बनाहिन। मंग कदी उ यो मंदिर लक बाहेर नहीं हीटेयेत। अना मी आपरो परमेस्वर को नगर को नवा यरूसलेम को नाव वको मा लिखूँ। जोन मोरो परमेस्वर को कनलक सरग लक खाल्या उतरन वालो सेत। वोमा मी अपरो नवा नाव लिखिन।<verse eid="REV 3:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="REV 3:13"/>जेका कान सेत, उ आयक लेव की आतमा कलीसिया लक काजक कव्हसेत।<verse eid="REV 3:13"/></para>
  <para style="s">लौदीकिया को कलीसिया</para>
  <para style="p">
    <verse number="14" style="v" sid="REV 3:14"/>“लौदीकिया को कलीसिया को दूत ला लिख।”</para>
  <para style="p" vid="REV 3:14">जो आमीन, बिस्वास लायक अना खरो गवाह से, अना परमेस्वर को संसार को मुख कारन सेत, उ यो कव्हसे, <verse eid="REV 3:14"/><verse number="15" style="v" sid="REV 3:15"/>मि तोरो काम गीन ला जानासू का तू ना ता थन्डो सेस ना तातो सेस। भलो होतो की तू थन्डो रव्हतो, या तातो होतो! <verse eid="REV 3:15"/><verse number="16" style="v" sid="REV 3:16"/>एकोलाय की तू कुनकुनो सेत, न थन्डो से अना नाच तातो सेत, मि तोला आपरो टोंड लक ओकारी कर देहूं। <verse eid="REV 3:16"/><verse number="17" style="v" sid="REV 3:17"/>तू कव्हसेत की मि धनी सेउ, अना मोला कोनी चीज को जरुरत नाहती। पर तू नही जानासेस का? तू अभागो, निकम्मो, अँधरो अना नंगरा सेस। अना दया को काबिल नाहस। <verse eid="REV 3:17"/><verse number="18" style="v" sid="REV 3:18"/>एकोलाय मि तोला सलाह देवसू, की स्तो मा सुध्द कियो हुयो सोन्नो मोरो लक मोल लेव। अना तु धनी भय जाय। अना बेडाग पांढरो कपरा लेलेव, अना घाल तोरो नंगोपन दिसायो नही जाय, अना आपरी डोरा मा लगावन को लाई सुरमा ले लेव, की तु चोय सकजोस। <verse eid="REV 3:18"/><verse number="19" style="v" sid="REV 3:19"/>मि जोनलक माया करासू उनला डाटा सेऊ, अना सरको रस्ता मा आना सेऊ। एको लाई कठिन जतन करो अना पाप लक मन ला हटाव। <verse eid="REV 3:19"/><verse number="20" style="v" sid="REV 3:20"/>आयको, मि देहरी मा उभो होयके किवाड़ ला खटखटायसू। अदी कोनी मोरी आवाज आयक के किवाड़ उघाड़ेत, ता मि उनको घर मा धसू, उनको संग जेहुँ। अना वय मोरो संग जेहेत।<verse eid="REV 3:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="REV 3:21"/>जोन लोक जीत हासिल करहेत। उनला मी आपरो सिहासन मा बसन को हक देहिन जसो मि जित गयो सेऊ। अना अबा आपरो दआजी कनलक आपरो सिहासन मा बसो सेऊ। <verse eid="REV 3:21"/><verse number="22" style="v" sid="REV 3:22"/>जेका कान होयेत उ आयक लेव, “का आतमा कलीसिया लक काजक कव्हसे।”<verse eid="REV 3:22"/></para>
  <chapter eid="REV 3"/>
  <chapter number="4" style="c" sid="REV 4"/>
  <para style="s">सरग मा भकति</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 4:1"/>यको मंघा मिना चोवयो, अना सरग को उघड़ो किवाड़ मोरो सामोर होतो। अना वसोच अवाज जोनला पयले आयको होतो। तुर्रा को आवाज जसो मोरो लक कह रहयो होतो। “इता वरता आव! अना मि तोला वोय गोस्टी गीन ला दिसाऊ जोन एको मंघा होवनो जरुरी से।” <verse eid="REV 4:1"/><verse number="2" style="v" sid="REV 4:2"/>मंग मी एकाएक आतमा को बसमा भयी गयो। अना दिसयो, सरग मा एक राजगद्दी ठेयो होतो अना ओनो पर कोनी बसयो होतो। <verse eid="REV 4:2"/><verse number="3" style="v" sid="REV 4:3"/>जो वहान बसो होतो। वोको चेहेरा यसब अना गोमेद को जसो होतो। वोको सिघासन को आखा-पाखा एक मेघधनुस होतो। जोन पन्ना जसो चमकत होतो। <verse eid="REV 4:3"/><verse number="4" style="v" sid="REV 4:4"/>ओनो राजगद्दी को आखा-पाखा चौबीस कुरसी होतीन, अना ओना कुरसी मा मिना चौबीस सयानो ला पाँढरो कपरा घालियो अना डोस्की पर सोनो को मुकुट डाकयो चोयो। <verse eid="REV 4:4"/><verse number="5" style="v" sid="REV 4:5"/>ओनो राजगद्दी लक बिजली को चकचवधी बादर को गड़गड़ानो जसि आवाज हिटासे। अना राजगद्दी को पुढ़ा लपलपातो स्तो को सात टेमा पटायो होतीन। यो टेमा परमेस्वर को सात आतमा सेत। <verse eid="REV 4:5"/><verse number="6" style="v" sid="REV 4:6"/>अना सिघासन को पुढ़ा महंगो पथरा को जसो मानो का काँच समुंदर होतो।</para>
  <para style="p" vid="REV 4:6">अना सिघासन को बीच अना आखा-पाखा चार जीवधारी होतीन। जिनको पुढ़ा मंघा डोरा च डोरा होतीन। <verse eid="REV 4:6"/><verse number="7" style="v" sid="REV 4:7"/>पयलो जीवधारी सेर को जसो, दुसरो जीवधारी बईल को जसो, अना तीसरो जीवधारी को मुख मानूस को जसो, अना चौथो जीवधारी उड़तो गरूड़ पक्सी को जसो होतो। <verse eid="REV 4:7"/><verse number="8" style="v" sid="REV 4:8"/>ऐना चारो जीवधारी मा लक हरेक को सह-सह पंख होतीन। उनको चारो कना, अना भीतर डोराच डोरा होतीन। दिवस अना राती बिना रुकयो यो गावत होतिन।</para>
  <para style="q1" vid="REV 4:8">“पवीतर पिरभु परमेस्वर सब लक ताकत वर से,</para>
  <para style="q2" vid="REV 4:8">जो होतो, अना जो से अना जोन आवनवालो से।”<verse eid="REV 4:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="REV 4:9"/>जबा यो जित्तो जीवधारी, वोना अजर अमर को महिमा, आदर अना धनवाद कर रहयो होतिन। जोन कुरसी मा विराजमान होतो। <verse eid="REV 4:9"/><verse number="10" style="v" sid="REV 4:10"/>वय यो चौबीस सयानो वोको पायमा पड़के, जोन सदा जित्तो रव्हन वालो को अराधना करा सेत। वय सिघासन को समोर आपरो मुकुट डाक देवासेत। अना कव्हसेत,<verse eid="REV 4:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="REV 4:11"/>ओ आमरो पिरभु अना परमेस्वर, तुच महिमा मान</para>
  <para style="q2" vid="REV 4:11">अना ताकत को लायक सेस।</para>
  <para style="q1" vid="REV 4:11">काहेकि तुनच सबच चीजगीन ला बनाईसेस,</para>
  <para style="q2" vid="REV 4:11">अना ओको बनयो हुयो काम अना ओको दुनिया तोरीच मरजी लक भयी।<verse eid="REV 4:11"/></para>
  <chapter eid="REV 4"/>
  <chapter number="5" style="c" sid="REV 5"/>
  <para style="s">चुढ़ीबंध किताब अना पाठी</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 5:1"/>मंग मिना चोवयो, जोन सिघासन मा बसो होतो, ओको उजो हात मा एक पावती मजे एक असो किताब जिनला लिख के लपट देत होतिन। जोन मा भीतर बहेर लिखी हुयी होती। अना सात सिक्का लगायके बंद करी गयी होती। <verse eid="REV 5:1"/><verse number="2" style="v" sid="REV 5:2"/>मंग मिना एक ताकतवर सरगदूत ला देख्यो, उ जोरलक कव्हत होतो, “सिक्के तोड़न्यार साठी अना पावती उघाड़न काबिल कोन सेत?” <verse eid="REV 5:2"/><verse number="3" style="v" sid="REV 5:3"/>पर ना सरग मा, न धरती मा कोनी ओनो पावती ला उघाड़न अना सिक्का तोड़न्यार लायक भेटयो। किताब को खोलन अना ओको पर नजर डाकन को लायक हिटयो। <verse eid="REV 5:3"/><verse number="4" style="v" sid="REV 5:4"/>तबा मि फुट-फुट के रड़न लगयो, काहेका कोनी भी असो नही भेटयो जोन सिक्का उघाड़न अना पावती मा चोव सके। <verse eid="REV 5:4"/><verse number="5" style="v" sid="REV 5:5"/>मंग एक बुजरुक ना मोला कव्हयो, “नोको रड़ो, चोवो! दाऊद को खानदान को महान यहूदा गोत को सेर ना जीत हासिल करिसेत। अना वाच सात सिक्का ला तोड़ सकासेत। अना पावती उघाड़ सकासेत।”<verse eid="REV 5:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="REV 5:6"/>मंग मीना चोवयो का वोना सिघासन अना वोना चार जीव को समोर अना उन सियानो गिन को हाजिर मा एक पाठी उभो सेत। उ असो चोवासेत जसो वोको बली चघायो गयो सेत। वोको सात सींघ होतिन जोन परमेस्वर को सात डोरा होतिन। जोन सपा धरती मा धाड़यो गयो होतो। <verse eid="REV 5:6"/><verse number="7" style="v" sid="REV 5:7"/>पाठी ना जायके सिघासन मा बसन वालो को उजो हात लक पावती लियो। <verse eid="REV 5:7"/><verse number="8" style="v" sid="REV 5:8"/>जब वोना उ पावती ले लियो, ता उन च्यार जीव अना चौबीस बुजरुक ना पाठी ला पाय पड़के परनाम करीन। उनमा लक हरेक को जवर बिना होतो। अना वय सुगन्धित चीज लक भरयो सोन्नो को धूपदानी राखयो होतिन। जोन संतगिन को पिराथना होतो।<verse eid="REV 5:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="REV 5:9"/>वय लोकगीन यो नयो गाना गावन लगीन।</para>
  <para style="q1" vid="REV 5:9">तु ऐना पावती धरन अना येकी सिक्का खोलन को लायक से।</para>
  <para style="q2" vid="REV 5:9">येको एवज मा तुना बली होयके,</para>
  <para style="q1" vid="REV 5:9">आपरो रकत लक, हर एक कुल, अना भासा,</para>
  <para style="q2" vid="REV 5:9">अना लोक अना जात लक परमेस्वर को लाई लोक हिन ला मोल ले लेई सेस।<verse eid="REV 5:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="REV 5:10"/>अना ओना आमरो परमेस्वर को लाई एक राज अना याजक बनाईसेस।</para>
  <para style="q2" vid="REV 5:10">अना वय धरती पर राजपाठ करासेत।<verse eid="REV 5:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="REV 5:11"/>तबा मीना चोवयो, अना लगत सरगदूत गिनको अवाज आयकयो। वय वोना सिघासन, उन जीव अना बुजरुक गिनको आखा-पाखा उभो होतिन। सरगदूत गिनको गिनती लाखों अना करोड़ों होतिन।<verse eid="REV 5:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="REV 5:12"/>अना वय उचो आवाज लक कव्हत होतीन</para>
  <para style="q2" vid="REV 5:12">“वा पाठी जोन मार दियो गयो होतो। उ बिरता, ताकत अना धन अना अक्ल अना ताकत अना मान</para>
  <para style="q2" vid="REV 5:12">अना स्तुति अना सदा धनवाद को लायक से।”<verse eid="REV 5:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="REV 5:13"/>मंग मि ना आयकयो, सरग मा अना धरती अना धरती को खाल्या अना समुंदर की बनयो हुयी चीज को, अना सबच काही जो उनमा से,</para>
  <para style="q1" vid="REV 5:13">जो राजगद्दी पर बसयो सेत ओको</para>
  <para style="q2" vid="REV 5:13">अना पाठी को धनवाद मान अना</para>
  <para style="q2" vid="REV 5:13">बड़ाई अना राजपाठ सदा रव्हे।<verse eid="REV 5:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="REV 5:14"/>अना चारो जीवधारी ना आमेन कहीन अना बुजरुक गीन ना पड़के नमस्कार करीन।<verse eid="REV 5:14"/></para>
  <chapter eid="REV 5"/>
  <chapter number="6" style="c" sid="REV 6"/>
  <para style="s">सात सिक्का ला उघाड़ो जावनो।</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 6:1"/>मंग मि चोवसू का मेढ़ा ना ओनो सात सिक्का मा लक एक को सिक्का ला उघाड़ देइस अना ओनो चार जीव मा लक एक गरजन जसो आवाज मा कहीस, “आव।” <verse eid="REV 6:1"/><verse number="2" style="v" sid="REV 6:2"/>जबा मिना चोवयो तो मोरो समोर एक पांढरो घोड़ा होतो। घोड़ा को सवार धनूस बान लियो होतो। वोला जीत को मुकुट पहनायो गयो। अना उ जितन को लाय बाहेर हीट गयो। अना उ जीत जाहेत।<verse eid="REV 6:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="REV 6:3"/>जब ओना दुसरी सिक्का ला उघाड़ लेइस, ता मिना दुसरो जीव ला यो कव्हत हुयो आयकयो, “आव” <verse eid="REV 6:3"/><verse number="4" style="v" sid="REV 6:4"/>मंग एक अखीन लाल रँग को घोड़ा हिटयो। ओको सवार ला यो हक मिलयो होतो का धरती लक सान्ती हिसक लेय, जोनलक लोक एक दुसरा को हत्या करेहत। अना एक मोठो तलवार वोको सुपरुत करयो गयो।<verse eid="REV 6:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="REV 6:5"/>मंग ओने तीसरो सीक्का उघाड़यो। ता मिना तीसरो जीव ला यो साँगत आयकयो, “आव!” मिना का देखयो, “एक कारो घोड़ा से, अना ओको चाकर को हात मा एक तखड़ी से,” <verse eid="REV 6:5"/><verse number="6" style="v" sid="REV 6:6"/>अना मिना उन चार जीव को बीच लक एक आवाज आयकयो “सिक्का को सेर भरयो गहूँ, अना सिक्का को तीन सेर जौ, पर तेल अना अंगूर को रस को हानी नोको करो।”<verse eid="REV 6:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="REV 6:7"/>जब ओना चवथो सीक्का ला उघाड़यो, ता मिना चवथो जीव को आवाज आयकियो, आव! <verse eid="REV 6:7"/><verse number="8" style="v" sid="REV 6:8"/>मिना नजर भरके चोवुसू एक पीवरो रँग को घोड़ा से अना ओको सवार को नाव मिरतू से। अना नरक ओको मंघा मंघा से, अना ओको यो हक से, धरती की एक पाव हिस्सा मा तरवार अना गिरानी, अना महामारी, अना धरती को जनावर गीन लोकईन ला मार डाकेत।<verse eid="REV 6:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="REV 6:9"/>जब मिना पाचवो सिक्का ला उघाड़त चोवयो। मोला बलीकरन वालो कुन्ड को खाल्या उनको जान दिसयो जोन परमेस्वर को गोस्टी, अना ओना गवाही लक जो ओन्हीसीन देयि होतीन। यो कारनलक हत्या कियो गयो होतो। <verse eid="REV 6:9"/><verse number="10" style="v" sid="REV 6:10"/>उनको आतमा जोरलक हाकल के कव्हन लगीन, “ओ परमेस्वर! पवितर सच्चो, का तू संसार को न्याय नही करजोस?” अना आमरो रकत को बदला नही लेवजोस? <verse eid="REV 6:10"/><verse number="11" style="v" sid="REV 6:11"/>अना उनमा लक हरेक ला पान्डरो कपरा दियो गयो। अना कहयो गयो जरासो उसीर मा जबा तुमरो संगी गिनको गिनती पूरो भयी जाहेत। तबा तकन बिसराम करो। काहे का अबा सहिद गिनको गिनती कम सेत।<verse eid="REV 6:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="REV 6:12"/>जब छटवी सिक्का उघाड़यो, तबा मी ना चोवयो का एक मोठयो भुइंडोल भयी। अना सूरज कम्बल जसो कारो, अना पूरो चँदा खून जसो लाल भय गयो। <verse eid="REV 6:12"/><verse number="13" style="v" sid="REV 6:13"/>अना बादल को तारागीन धरती पर असा पड़न लगीन जसी तेज आँधी लक चलन पर अँजीर को झाड़ मा लक कच्चा फर झड़ा सेत। <verse eid="REV 6:13"/><verse number="14" style="v" sid="REV 6:14"/>अना बादल ता असो खसक गयो जसो कागद लपटनो पर खसक जासे। हरेक पहाड़ अना टापू आपरो-आपरो जघा लक पलट के हट गईन। <verse eid="REV 6:14"/><verse number="15" style="v" sid="REV 6:15"/>तब धरती को राजा, अधिकारी, अना मुखिया अना सेना को सेनापती, अना का धनी, अना ताकतवर लोक, अना हर कोनी दास, अना हरेक मालिक पहाड़गीन को सुरँग मा अना चट्टानगीन को चेर मा जायकर लुक गयिन। <verse eid="REV 6:15"/><verse number="16" style="v" sid="REV 6:16"/>उनना पहाड़ अना गोटा ला हाकलीन आमरो पर गिरो अना, सिघासन मा बसयो मानूस को गुस्सा लक अना वोको डोरा लक अमी ला बचाव। <verse eid="REV 6:16"/><verse number="17" style="v" sid="REV 6:17"/>काहेका वोको गुस्सा को आफद वालो दिवस आय पहुचयी से। “अता वोको बिरोध मा को उभा राहू सकेत।” कोन बच सकसे?<verse eid="REV 6:17"/></para>
  <chapter eid="REV 6"/>
  <chapter number="7" style="c" sid="REV 7"/>
  <para style="s">इसरायल चुनयो हुयो को एक लाख चौवालीस हजार गीनती को लोक</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 7:1"/>“एको मंघा मि ना धरती को च्यार कोन्टा मा च्यार सरग दूत उभो चोवयो। वय धरती को चारो कन को वारा ला थाम लियो होतीन। जोनलक धरती या समुंदर या कोनी झाड़ मा वारा नही चलहेति” <verse eid="REV 7:1"/><verse number="2" style="v" sid="REV 7:2"/>मंग मिना चोवयो, एक अखिन सरगदूत से। जोन दिवस उगती कन लक आ रहयो से। वोना जित्तो परमेस्वर को सिक्का राख्यो होतो। अना वोना च्यार सरगदूत जोनला धरती अना बाल नास करन को हक होतो। उनला जोरलक हाकलीस, <verse eid="REV 7:2"/><verse number="3" style="v" sid="REV 7:3"/>“जबा तकन आमी आपरो परमेस्वर को दास गीन को डोस्का पर सील नही लगा देबीन तबा तकन तुमी धरती अना समूंदर अना झाड़ गीन ला हानी नोको पहुचाव।” <verse eid="REV 7:3"/><verse number="4" style="v" sid="REV 7:4"/>जेनला सिक्का लगयो होतो। मिना उनको गिनती आयकियो, का इसरायल की खानदान मा एक लाख चौवालीस हजार पर सिक्का लगी होती। <verse eid="REV 7:4"/><verse number="5" style="v" sid="REV 7:5"/>यहूदा को खानदान मा लक बारह हजार, रुबेन को खानदान मा लक बारह हजार, गाद को बारह हजार, <verse eid="REV 7:5"/><verse number="6" style="v" sid="REV 7:6"/>आसेर मा लक बारा हजार, मनस्से मा बारा हजार, नपताली को बारा हजार, <verse eid="REV 7:6"/><verse number="7" style="v" sid="REV 7:7"/>समौन को खानदान को बारा हजार, लेवी को खानदान मा बारा हजार, इस्साकार को खानदान मा लक बारा हजार, <verse eid="REV 7:7"/><verse number="8" style="v" sid="REV 7:8"/>जबूलून को खानदान मा लक बारा हजार, यूसुफ को खानदान लक बारा हजार, अना बिन्यामीन को खानदान को बारा हजार मा सिक्का लगायो होतो।<verse eid="REV 7:8"/></para>
  <para style="s">एक मोठी भीड़</para>
  <para style="p">
    <verse number="9" style="v" sid="REV 7:9"/>एको बाद मिना चोवयो, अना दिसयो का हरेक कबिला, अना कुल अना लोकगीन अना भासा मा लक, एक असी लोक को गरदी, जेनला कोनी नही गीन सकत होतो। पाँढरो कपरा डाकयो, अना आपरो हात गीन मा खजुर की डारी गीन लियो हुयो, राजगद्दी को पुढ़ा अना मेढ़ा को पुढ़ा उभी दिसयो। <verse eid="REV 7:9"/><verse number="10" style="v" sid="REV 7:10"/>अना मोठो आवाज लक चिल्लात कव्हत आयकियो, “सूटकारा को लाय, आमरो परमेस्वर को, जो राजगद्दी पर बसयो से। अना मेढ़ा को जीत होयहेत।” <verse eid="REV 7:10"/><verse number="11" style="v" sid="REV 7:11"/>अना पूरो सरगदूत ओनो राजगद्दि, बुजरुक गिन अना चार जीव को पुढ़ा उभा सेती। मंग वय राजगद्दी को पुढ़ा टोंड को बल पड़के, परमेस्वर ला नमस्कार कहिन, <verse eid="REV 7:11"/><verse number="12" style="v" sid="REV 7:12"/>“आमेन” आमरो परमेस्वर को बड़ाई अना महिमा अना अक्ल अना धनवाद अना, मान अना ताकत जुगजुग तकन होवत रह। “आमेन”<verse eid="REV 7:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="REV 7:13"/>एतरो मा बुजरुक मा लक एक ना मोला कहीस, “यो पाढ़रो कपरा डाकयो हुयो कोन आय?”<verse eid="REV 7:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="REV 7:14"/>मिना ओला कव्हयो, “ओ मालिक, तुच जानासेस।”</para>
  <para style="p" vid="REV 7:14">ओना मोला कहिसेस, यो वय आय, जो ओना मोठो संकट मा लक हिटके आईसेत। इनना अपरो-अपरो कपरा मेढ़ा को रकत मा धोयके उजला करिसेत। <verse eid="REV 7:14"/><verse number="15" style="v" sid="REV 7:15"/>ऐना कारन लक वय परमेस्वर को राजगद्दी को पुढ़ा सेत, अना ओको मंदिर मा दिवस रात ओको सेवा करीसेत। अना जो राजगद्दी पर बसीसे। उ उनको बीच वरता आपरो सभा लगाहे। <verse eid="REV 7:15"/><verse number="16" style="v" sid="REV 7:16"/>मंग ओय भुखो अना तहान नही होहेत, अना नाच उनपर धुप, नाच कोनी तपन लगहे। <verse eid="REV 7:16"/><verse number="17" style="v" sid="REV 7:17"/>काहेकि मेढ़ा जो राजगद्दी को बीच मा बसयो से, ओको निगरानी राखेह। उनला जिंदगी को झरना को जवर ले जाहे। परमेस्वर उनको सब आँसू ला पोस डाकेह।<verse eid="REV 7:17"/></para>
  <chapter eid="REV 7"/>
  <chapter number="8" style="c" sid="REV 8"/>
  <para style="s">सातच छाप अना सोनो को धुपदान</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 8:1"/>जबा ओने सातवी सिक्का ला उघाड़िस, ता सरग मा अरधो तास तकन सून-सपाट होय गयो। <verse eid="REV 8:1"/><verse number="2" style="v" sid="REV 8:2"/>तबा मि ना उन च सात सरगदूत ला चोयो, जोन परमेस्वर को पुढ़ा उभो होतीन। उन ला सात तुर्रा दिय गयो होतिन।<verse eid="REV 8:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="REV 8:3"/>तबा एक सरगदूत आयो। अना वेदी को जवर उभो भयी गयो। वोको जवर एक सोन्नो को धुपदान होतो। वोला सोन्नो को वेदी मा संत गिन को पिराथना संग चढ़ावन ला धूप दियो गयो। जोन वेदी सिहासन को समोर होतो। <verse eid="REV 8:3"/><verse number="4" style="v" sid="REV 8:4"/>मंग सरगदूत को हात लक धूप को धुंगा पवीतर लोकगीन को बिनती सँगा परमेस्वर को जवर पहुचयो। <verse eid="REV 8:4"/><verse number="5" style="v" sid="REV 8:5"/>एको मघा सरगदूत ना वोना धुपदान ला उचलो अना वेदि को स्तो भरके धरती मा फेक दियो। तबा बदली को गरजन-तरजन, भयंकर सबद बिजुरी को चमक अना भुयी डोल होवन लगयो।<verse eid="REV 8:5"/></para>
  <para style="s">सात तुर्रा को भेद</para>
  <para style="p">
    <verse number="6" style="v" sid="REV 8:6"/>मंग वय सात सरगदूत, जोनको जवर सात तुर्रा होतो। तबा वय तुर्रा फूँकन तैयार भयी गयीन।<verse eid="REV 8:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="REV 8:7"/>पयलो सरगदूत ना जसोच तुर्रा फुकिस, तसोच रकत गारगोटी अना स्तो एक संग मलयो जुलो दिसयो। अना उनला धरती कन उबड देयीन, जोनलक एक तिहाई धरती बर गयो। अना भसम भयी गयो। एक तिहाई झाड़ हिवरो गवथ राखड़ भयी गयो।<verse eid="REV 8:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="REV 8:8"/>वोको दुसरो सरगदूत ना तुर्रा फुकिस, ता मान लेव जसो की एक पहाड़ समुंदर मा जलतो हुयो डाकयो गयो। अना समूंदर को एक तिहाई हिस्सा रकत लक भर गयो। <verse eid="REV 8:8"/><verse number="9" style="v" sid="REV 8:9"/>अना समूंदर को एक तिहाई हिस्सा को जीव-जन्तू मर गईन, अना एक तिहाई को जहाज नास भयी गईन।<verse eid="REV 8:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="REV 8:10"/>तीसरो सरगदूत ना जबा तुर्रा बजायो ता बादल लक पेटायो टेमा को जसो एक मोठयो तारा पड़यो। यो तारा एक तिहाई नद्दी पिझरा को पानीमा पड़यो। <verse eid="REV 8:10"/><verse number="11" style="v" sid="REV 8:11"/>यो तारा को नाव नागदौना होतो। यो काजी पानी को एक तिहाई नागदौना मा च बदल गयो। वा पानी पीवनो लक लगत लोक गिन मर गयीन।<verse eid="REV 8:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="REV 8:12"/>चौथो सरगदूत ना तुर्रा फुकिस, ता सूरज को एक तिहाई अना चँदा की एक तिहाई अना तारागीन की एक तिहाई हिस्सा पर कस्ट अना संकट छाय गयो। यहान तकन की पूरो एक तिहाई हिस्सा मा इँधारो भय गयो। अना दिवस को एक तिहाई हिस्सा इँधारो मा गयो। वसो रात मा भी भयो।<verse eid="REV 8:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="REV 8:13"/>मंग मिना चोवयो का एक गरूड़ बादल को बीच वरता मा उड़ा से। मिना वोला जोर लक हाकलत आयकू, “उन बाकी का तीन सरगदूत जो बाकी सेत, उनको तुर्रा फुकन को कारन धरती का सब रव्हन वारा पर फजीता, फजीता, फजीता।”<verse eid="REV 8:13"/></para>
  <chapter eid="REV 8"/>
  <chapter number="9" style="c" sid="REV 9"/>
  <para style="p">
    <verse number="1" style="v" sid="REV 9:1"/>जब पाँचवो सरगदूत ना तुर्रा फुकिस तबा मिना सरग लक धरती पर एक तारा पड़तो दिसयो अना ओला वोना चिमनी की कुन्जी देयि गयी जोन पताल मा उतरा सेत। <verse eid="REV 9:1"/><verse number="2" style="v" sid="REV 9:2"/>मंग वोना तारा ना ओना चिमनी को कुलुप ला उघाड़ देइस। जोन पताल मा उतरत होतयो। अना चिमनी लक वसोच धुवा उठयो, जसो एक मोठो भट्टी ले धुँआ उठा सेत। अना चिमनी लक हिटयो धुँआ लक सूरज अना बादल कारो भयी गयो। <verse eid="REV 9:2"/><verse number="3" style="v" sid="REV 9:3"/>तबा वोना धुवा लक धरती मा टिड्डी दल उतर आयो। उनला धरती मा मेहदल को जसो ताकत दियो गयो होतो। <verse eid="REV 9:3"/><verse number="4" style="v" sid="REV 9:4"/>उन लक कव्हयो गयो, “का ना धरती को गवथ ला ना कोनी हरियाली ला न कोनी झाड़ ला हानि पहुचाव, बलकि ओनो मानूस गीन ला हानी पहुचाव जिनको मस्तक पर परमेस्वर को छाप नाहती।” <verse eid="REV 9:4"/><verse number="5" style="v" sid="REV 9:5"/>टिड्डी दल ला को निरदेस दियो गयो होतो। का वय लोकगिन को परान नोको लेवे? बल्कि पाँच महीना तकन उनला दुख पहुचावत रव्हे। वसोच जसो कोनी मानूस ला मेहदल चाबन लक होवा सेत। <verse eid="REV 9:5"/><verse number="6" style="v" sid="REV 9:6"/>ओनो दिवस मा मानूस मिरतु ला ढुँढेत अना नही पाहेत अना मरन को लालसा करयेत अना मिरतू उनला चकमा देहेत।<verse eid="REV 9:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="REV 9:7"/>ओनो टिड्डी को रुप घोड़ा फाफा को जसो होतो अना उनको मूकूट सोन्नो को जसो होतीन। अना उनका टोंड मानूस को जसो होतो। <verse eid="REV 9:7"/><verse number="8" style="v" sid="REV 9:8"/>उनका चुन्दी आई-माई गीन को चुन्दी जसो अना दाँत बब्बर सेर गीन जसो होतीन। <verse eid="REV 9:8"/><verse number="9" style="v" sid="REV 9:9"/>वय लोहा गीन को जसो कपरा डाकयो होतीन। उनको पंखगीन को आवाज असो होती जसो रथ अना लगत सा घोड़ा गीन की, जोन लड़ाई मा दौड़सेती। <verse eid="REV 9:9"/><verse number="10" style="v" sid="REV 9:10"/>उनकी पुछी मेहदल जसी होती, अना उनमा डंक होतीन अना उनला पाँच महिना तकन मानूस गीन ला हानी पहुचावन की अधिकार मिलयो होतो। जो उनको पुछी मा होती, <verse eid="REV 9:10"/><verse number="11" style="v" sid="REV 9:11"/>नरक को दूत उन पर राजा होतो। ओको नाव इबरानी मा अबद्दोन अना यूनानी मा अपुल्लयोन से।<verse eid="REV 9:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="REV 9:12"/>पयलो आफद कट गयो अता ऐको मंघा दूई मुसीबत अखीन आवन वालो सेत।<verse eid="REV 9:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="REV 9:13"/>जब छँटवो सरगदूत ना तुर्रा फुकिस त सोन्नो की वेदी जोन परमेस्वर को पूढ़ा से। ओको सींग मा लक मिना असो आवाज आयकयो, <verse eid="REV 9:13"/><verse number="14" style="v" sid="REV 9:14"/>मानो कोनी छटवो सरगदूत लक, जोको जवर तुर्रा को आवाज होती कव्ह रहयो से, “ओनो च्यार सरगदूत ला जोन मोठी नदी फरात को जवर बन्धया सेत, खोल देव।” <verse eid="REV 9:14"/><verse number="15" style="v" sid="REV 9:15"/>ओ च्यार सरगदूत खोल दियो गईन। जोन ओना पासुन अना दिवस अना माहिना अना बरस को लाय मानूस को एक तिहाई ला मारन लाय तैय्यार करयो होतीन। <verse eid="REV 9:15"/><verse number="16" style="v" sid="REV 9:16"/>सेना को घुड़सवार की संख्या बीस करोड़ होती; मिना उनको गिनती आयकियो। <verse eid="REV 9:16"/><verse number="17" style="v" sid="REV 9:17"/>वोना मोरो दरसन मा वय घोड़ा अना उनको सवार असो चोवयो, उनना स्तो को धगाड़ी वानी लाल, गहरो नीलो, अना गंधक वानी पिवरो होतिन। अना घोड़ा को पाय सेर वानी होतिन अना उनको टोन्ड लक धुवा अना गंधक जसो स्तो हिटत होतो। <verse eid="REV 9:17"/><verse number="18" style="v" sid="REV 9:18"/>तीन मोठयो बिनास लक मजे तोन्डा वर हिटन वारो, स्तो, गन्धक अना धुवा लक, एक तिहाई मानूस नास होय गयीन। <verse eid="REV 9:18"/><verse number="19" style="v" sid="REV 9:19"/>यो घोड़ा को ताकत उनको ताकत तोन्ड अना पुसटी मा होतो। काहेका यनको पूसटी सरप को जसो होतीन। जोनला मानूस नास करन काजी बवजत होतिन।<verse eid="REV 9:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="REV 9:20"/>एको मा बाकी असो लोक जोन यो मोठयो नास लक नही मरयो होतिन। उनना आपरो हात को काम लक अबा मन नही मुरकायो होतिन। अना भूत-पलित को अना सोन्नो खुरो, कासो, गोटा अना काड़ी को वोना मुरती को अराधना नहीं सोड़यो। जोनना चोव सका सेत। न आयक सका सेत। न च रेग सका सेत। <verse eid="REV 9:20"/><verse number="21" style="v" sid="REV 9:21"/>उनना आपरो लक करयो हुया जानलक मारनो, जादू टोटका, छिनाला पन अना चोरी-चकारी करनो लक आपरो मन नहि बदलयो होतिन।<verse eid="REV 9:21"/></para>
  <chapter eid="REV 9"/>
  <chapter number="10" style="c" sid="REV 10"/>
  <para style="s">सरगदुत अना नहान सी किताब</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 10:1"/>मंग मी अखीन एक ताकतवर, सरगदूत ला सरग लक आवता चोवयो। वा बादल ला असो ढगात गुंडयो होता। अना वोको डोक्सा मा मेघधनुस होतयो। वोको चहेरा सूरज सारखा होता। अना वोको पाय स्तो को मुन्डा सारखे होतो। <verse eid="REV 10:1"/><verse number="2" style="v" sid="REV 10:2"/>वोको हात मा एक लहान पावती उघड़ो होता। उनना वोको उजो पाय समुदर मा ठेवला होता। अना डावा पाय जमीन मा वर ठेवला होता। <verse eid="REV 10:2"/><verse number="3" style="v" sid="REV 10:3"/>अना सेर गरजन सारखे आवाज मा हाक मारयो। <verse eid="REV 10:3"/><verse number="4" style="v" sid="REV 10:4"/>जबा सात गरजन हो गयो अना मी लिखन वोलो होता। तरी मी सरग लक एक सबद आयकली। “सात मेघ गरजन काजक सांगयो, वोला लूका लेव लिखजोस नोको।”<verse eid="REV 10:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="REV 10:5"/>मंग मी, जोन सरगदूत ला समुंदर अना जमीन मा पयले उभो होता। वा ना आपरो ला उज्जो हात सरग कन उचलयो। <verse eid="REV 10:5"/><verse number="6" style="v" sid="REV 10:6"/>अना परमेस्वर को नाव को किरिया खाय के कव्हयो, जोन अमरकाल लक जित्तो सेत। जोनना सरग, धरती समुदर अना सप्पा काही बनायो सेत। वोको सरगदूत कव्हसे। “अबा अखीन उसीर नही होयेत।” <verse eid="REV 10:6"/><verse number="7" style="v" sid="REV 10:7"/>पर जबा सातवो सरगदूत ना तुर्रा बजायो, तबा परमेस्वर आपरो सेवक अना भविस्यवक्ता गिनला सुचीत करयो होतो। तसोच परमेस्वर आपरो गोस्टी पूरो करयेत।<verse eid="REV 10:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="REV 10:8"/>मग जोन सबद मी सरग लक बोलतो आयकयो होतो, वोना आवाज दुबारा मोला कहयो, “जाय अना समुदर अना जमीन मा उभयो सरगदूत को हात लक उ किताब लेव”<verse eid="REV 10:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="REV 10:9"/>तबा मी सरगदूत कन गयो अना मोला वा लहान पावती देवत गन सांगयो, “यो घेव अना खाय। यो तोरो पोटमा आंबट पर तोरो तोंडाला यो सहेद सारखे गोड लगहेत।”<verse eid="REV 10:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="REV 10:10"/>मी वोको हात लक लहान पावती लेय के खायो। मोला वा ते गोड-गोड लगयो। पर मी वोला गिटकयो तो मोरो पोटात खवखवले। <verse eid="REV 10:10"/><verse number="11" style="v" sid="REV 10:11"/>वोना मोला सांगयो का मंग एक बार दुबारा, “सब कबिला, देस बंस अना भासा अना लगत राजा गिन लाय भविस्यवानी करनो सेत।”<verse eid="REV 10:11"/></para>
  <chapter eid="REV 10"/>
  <chapter number="11" style="c" sid="REV 11"/>
  <para style="s">दूई गवाह</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 11:1"/>मंग मोला नापन को लाय एक छड़ी दियो गयो। अना मोला कव्हयो गयो। “उभो होय अना परमेस्वर को मंदिर अना वेदी ला नाप, अना जोन लोकहुन मंदिर को भीतर अराधना करा सेत, उनको गिनती कर। <verse eid="REV 11:1"/><verse number="2" style="v" sid="REV 11:2"/>परअ मंदिर को बाहेर आँगन ला रव्हन देव, वोला नोको नाप काहेका यो गैरयहुदी लोकगीन ला दियो गयो सेत। वय बयचाड़िस महिना तकन पवीतर येरुसलेम नगर ला अपरो पाय लक रवदेत। <verse eid="REV 11:2"/><verse number="3" style="v" sid="REV 11:3"/>मि आपरो दुय गवाह गीन ला जेनको कपरा बोरा को से, बारा सम्बर साठ दिवस तकन भविस्यवानी कराहिन।”<verse eid="REV 11:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="REV 11:4"/>यो गवाह जैतून को दुय झाड़ अना दुयी दयोदानी सेत। जोन धरती को पिरभू को पुढ़ा उभा सेति। <verse eid="REV 11:4"/><verse number="5" style="v" sid="REV 11:5"/>अदी कोनी उनको हानी करनो चाव्हसे। ता उनको टोंड लक स्तो हिटा सेत जोन उनको बैरी गीनला नास कर देहेत। उनला असो मरनो होहेत। <verse eid="REV 11:5"/><verse number="6" style="v" sid="REV 11:6"/>वय बादल ला बाँधन को ताकत राखत होतीन। जोन लक वय भविस्यवानी कर रव्हयो सेत। तबा तकन कोनी बरसात नही होहेत। उनको झरना को पानी पर हक होतो। जोनलक वय पानी ला रकत मा बदल सकत होतिन। अना उनला धरती मा जबा-जबा चाहेत, तबा-तबा हर परकार को मरही धाड़न को अधिकार सेत।<verse eid="REV 11:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="REV 11:7"/>उनको गवही देवन को मघा, वा पसु महा गरत लक बाहेर हिटेत अना उनपर धावा करहेत। अना पसु उनला हराके मार डाखेत। <verse eid="REV 11:7"/><verse number="8" style="v" sid="REV 11:8"/>उनको मुरदा वोना महा नगर को चौकमा रखो रहेत। वो नगर को संकेतिक नाव सदोम या मिसर सेत। जहान उनको पिरभू ला कूरूस मा चघायो होतिन। <verse eid="REV 11:8"/><verse number="9" style="v" sid="REV 11:9"/>साडे तीन दिवस तकन सबरी कुल अना भासा अना देस-देस को लोकगीन उनको लास ला चोहेत। अना कबर मा राखन को हुकूम नही रव्हेत। <verse eid="REV 11:9"/><verse number="10" style="v" sid="REV 11:10"/>अना सब धरती को लोकगिन यो गोस्टी लक खुसी मनाहेत। अना एक दुसरो ला भेट देहेत। काहेका यो दुयी भविस्यवक्ता गीनना धरती को रव्हनवारा गिनला लगत दुख दियो होतिन। <verse eid="REV 11:10"/><verse number="11" style="v" sid="REV 11:11"/>पर साढ़े तीन दिवस मघा परमेस्वर को कनलक वय जित्तो भयी गयीन। अना आपरो पाय मा उभो भयी गयीन। जोनना उनना चोवीन लगत डराय गयो होतिन। <verse eid="REV 11:11"/><verse number="12" style="v" sid="REV 11:12"/>मंग वय दुयी भगतगिन लाय जोरलक बादल लक आवाज आयो। “यहान वरता आव।” तो वय बादलको वरता चले गयीन। उनला वरता जावत उनको बैरी चोवीन। <verse eid="REV 11:12"/><verse number="13" style="v" sid="REV 11:13"/>उतरो च बेरा मोठयो भुयीडोल आयो, अना नगर को दसवा हिस्सा पड़ गयो। अना 7,000 लोकगीन मर गयीन। अना जोन लोक बचयो होतिन वय डराय गयीन। अना सरग को परमेस्वर को महीमा करन लगीन।<verse eid="REV 11:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="REV 11:14"/>असो परकार लक अबा दूसरो आफद बीत गयो। पर सुसियार तिसरो आफत लवकर आवन वालो सेत।<verse eid="REV 11:14"/></para>
  <para style="s">सातवी आवाज</para>
  <para style="p">
    <verse number="15" style="v" sid="REV 11:15"/>“सातवो सरगदूत ना जबा आपरो तुर्रा फूँकीस तो बादल मा लगत आवाज होवन लगयो।” वय कव्हत होतिन, “अबा जगत को राज आमरो पिरभू को सेत। अना वोको मसिहा को। अबा वा साजरो सासन लक हरामेसा राज करहेत।” <verse eid="REV 11:15"/><verse number="16" style="v" sid="REV 11:16"/>तब वय चौबीस बुजरूक गीन ना, जोन आपरो-आपरो कुरसी मा बसयो होतीन। परमेस्वर को पुढ़ा तोन्ड को बल पड़के नमस्कार करत यो कव्हत धन्यवाद करीन।<verse eid="REV 11:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="REV 11:17"/>“सब लक ताकत वर परमेस्वर, जोन अबा से, अना जोन होतो।”</para>
  <para style="q1" vid="REV 11:17">अना हरामेसा रहेत, काहेका तू ना आपरो बल लक यो राज को सरुवात करयो सेत। अना येको अधिकारी सेत।<verse eid="REV 11:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="REV 11:18"/>गैर यहुदीगीन हिजड़ गयो सेत।</para>
  <para style="q2" vid="REV 11:18">पर उन पर तोरो पर कोप भड़क गयो।</para>
  <para style="q2" vid="REV 11:18">अब बेरा आय गयो से, की मरयो हुयो को न्याय कियो जाहे।</para>
  <para style="q1" vid="REV 11:18">अना तोरो दास गीन भविस्यवक्ता गीन,</para>
  <para style="q2" vid="REV 11:18">पवीतर लोकगीन अना उन लहान मोठयो जोन</para>
  <para style="q2" vid="REV 11:18">तोरो नाव को भेव मानत होतिन, उनको बदला लियो जाये।</para>
  <para style="q1" vid="REV 11:18">अना भूई ला बिगाड़न वालो ला मिटायो जाय।<verse eid="REV 11:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="REV 11:19"/>तब परमेस्वर को मंदिर जोन सरग मा से, उघाड़ दियो गयो। अना ओनो मंदिर मा उनको करार को संदूक दिसयो। ओना बेरा बिजली कौन्धी, गड़गड़ाहट अना बादल को गरजन हुयो। एक डरावनो भुईडोल आयो, अना मोठो-मोठो ओला पड़िन।<verse eid="REV 11:19"/></para>
  <chapter eid="REV 11"/>
  <chapter number="12" style="c" sid="REV 12"/>
  <para style="s">बायका अना पंख वालो साँप</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 12:1"/>तबा सरग मा एक अदभुत निसान चोवयो, एक बायको सूरज जेनको कपरा होती। अना चन्दा जेनको पाय को खाल्या होती। अना जेनको डोस्की मा बारा तारा को एक मुकुट होतो। <verse eid="REV 12:1"/><verse number="2" style="v" sid="REV 12:2"/>पोट लक होती, अना वोको जचकी को दरद सुरू भयी अना कलपन लगी।<verse eid="REV 12:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="REV 12:3"/>ओनो बेरा सरग मा एक अखीन निसान दिसय। लाल रँग को एक मोठयो पंखा वालो सरप जेनको सात डोस्की अना दहा सींग होतीन। हरेक डोस्की मा एक-एक राज मुकुट होतो। <verse eid="REV 12:3"/><verse number="4" style="v" sid="REV 12:4"/>ओना बादल को एक तिहाई तारागीन ला आपरी पुँछ लक समेट के धरती पर फेंक देईस। अना उ पंखा वालो सरप, वा बायको को समोर जोन लेकरा जलम देवन वाली होती, वोको उभो होय गयो। का लेकरा को जलम लेवन को संग वोला लील लेय। <verse eid="REV 12:4"/><verse number="5" style="v" sid="REV 12:5"/>ओनो बायको ना एक टूरा ला जनम देईस, जेनको सबच देस गीन पर लोहा को छड़ी लक राज करनो पक्को होतो। ऐना लेकरा ला तुरन्त च परमेस्वर को राजगद्दी को जवर पहुचाय दियो गयो होतो। <verse eid="REV 12:5"/><verse number="6" style="v" sid="REV 12:6"/>लेकिन उ बायको जंगल को कना पराय गयी, जहान परमेस्वर कन लक ओको लाय एक जघा तैय्यार कियो गयो होतो। की वहान बारा सम्बर साठ दिवस तकन ओकी निगरानी लक पालो पोसो जाहे।<verse eid="REV 12:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="REV 12:7"/>तबा सरग मा दूबारा लड़ाई सुरू होय गयो। सरगदूत मीकाईल अना ओको दूत ला उ पंखा वालो सरप लक लड़नो पड़यो <verse eid="REV 12:7"/><verse number="8" style="v" sid="REV 12:8"/>पर वय सरप अना वोको संगी सरगूत गिनलक हार गयिन। अना सरग लक हेड़ दियो गयीन। <verse eid="REV 12:8"/><verse number="9" style="v" sid="REV 12:9"/>तबा ओनो पंखा वालो सरप ला-ओना जुनो सरप ला, जोन सैतान कहलावासे अना जोन जगत को सबच रव्हनवारा गीन ला भरमाव से। वोला वोको संगी गिगन को संग धरती पर फेंक दियो गयो।<verse eid="REV 12:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="REV 12:10"/>तबा मोला सरग मा एक ऊचो आवाज यो मुनादी करतो हुयो आयकयो दियो;</para>
  <para style="q1" vid="REV 12:10">“अब मुकती, ताकत, आमरो परमेस्वर को राज,</para>
  <para style="q2" vid="REV 12:10">अना मसीह को राज करन बेरा आय गयो से।”</para>
  <para style="q1" vid="REV 12:10">आमरो भाऊगीन पर जोन परमेस्वर को समोर हरामेसा दोस लगावत होतो।</para>
  <para style="q2" vid="REV 12:10">वोला हेड़ दियो गयो से।<verse eid="REV 12:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="REV 12:11"/>उनना मेढ़ा को रकत, अना आपरो गवाही को कारन लक ओला हराय देईन। “आखरी साँस तकन उनना आपरो जीवन को माया नही करीन।” <verse eid="REV 12:11"/><verse number="12" style="v" sid="REV 12:12"/>एकोलाय सप्पा सरग अना ओको रव्हन वारा, खुस होयेत! हाय से तुमी पर धरती अना समुंदर! काहेकि सैतान तुमी तकन पहुँच गयो। उ लगत गुस्सा मा भर गयो से, काहेकि ओला मालूम से का ओको बेरा लगत ही कम से।<verse eid="REV 12:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="REV 12:13"/>जबा पंखा वालो सरप ला यो मालुम हुयो। का ओला धरती पर फेंक दियो गयो से। ता उ ओनो बायको ला, जेने ओनो टूरा ला जनम देइसेस, परेसान करन लगयो। <verse eid="REV 12:13"/><verse number="14" style="v" sid="REV 12:14"/>तबा ओनो बायको ला एक मोठयो गरूड़ को दुय पंख दियो गयी। की वा उड़के ओनो सरप लक दुहूर जंगल मा आपरो रव्हन की जघा मा चली जाय। जहान वोला साडे तीन साल रव्हनो सेत। काहे का वहानवोको जेवन रव्हन को बेवस्था कियो गयोहोतो। <verse eid="REV 12:14"/><verse number="15" style="v" sid="REV 12:15"/>मंग सरप ना ओनो बायको को मंघा, आपरो टोंड लक नदी को जसो पानी ला बोहाईस। का ओला पानी को पूरा मा बोहाय ले जाय। <verse eid="REV 12:15"/><verse number="16" style="v" sid="REV 12:16"/>पर धरती ना बायको को मदद करीस। अना सरप को टोंड लक हिटयो नदी को सप्पा पानी ला सोक लेयीस। <verse eid="REV 12:16"/><verse number="17" style="v" sid="REV 12:17"/>अना पंखा वालो सरप बायको पर हिजड़ गयो। अना ओकी बचयो औलाद जोन परमेस्वर को हुकूम ला मानसेत। अना यीसु को गवाही पर पक्को सेत। उन लक लड़ाई करन ला हिट गयो। <verse eid="REV 12:17"/><verse number="18" style="v" sid="REV 12:18"/>अखीन उ समुंदर को रेत पर जायके उभो होय गयो।<verse eid="REV 12:18"/></para>
  <chapter eid="REV 12"/>
  <chapter number="13" style="c" sid="REV 13"/>
  <para style="s">समूंदर लक हिटयो जनावर</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 13:1"/>तबा मिना एक जनावर ला समन्दुर मा लक हिटत चोवयो। जोनको दहा सिंग अना सात डोस्का होतीन। ओको सींग मा दहा राज मुकुट होतीन। अना ओको डोस्की मा परमेस्वर की निन्दा को नाव होतो। <verse eid="REV 13:1"/><verse number="2" style="v" sid="REV 13:2"/>जो जनावर मिना चोयो उ चीता को जसो होतो। अखीन ओको पाय रीछ को जसो, अना ओको टोन्ड सेर जसो होतो। ओना पंखा वालो सरप ना आपरो ताकत, आपरो सिघासन, आपरो अधिकार वोला दियो। <verse eid="REV 13:2"/><verse number="3" style="v" sid="REV 13:3"/>मिना चोवयो ओको डोस्की मा एक भारी घाव से। जोनलक वा मर जाहेत। पर चोवत। चोवत उ घाव साजरा भयी गयो। ऐतरो पर सप्पा धरती को रव्हनवारा लोक अकचकाके ओनो जनावर मंघा चल लगीन। <verse eid="REV 13:3"/><verse number="4" style="v" sid="REV 13:4"/>उनना पंखा वालो सरप को पूजा करीन। काहेकि ओना आपरो हक जनावर ला दियो होतो। उनना असो कव्हके जनावर को पूजा करीन, “यो जनावर को जसो कोन से? कोन एको सँग लड़ाई कर सकसे?”<verse eid="REV 13:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="REV 13:5"/>अना जनावर को टोन्ड ला भगवानको निन्दा करके घंमड को सबद बोलन को लाय 42 महिना को अधिकार दियो गयो। <verse eid="REV 13:5"/><verse number="6" style="v" sid="REV 13:6"/>तबा वोना जनावर ना परमेस्वर को विरोध मा निन्दा करन साठी आपरो टोन्ड खोल्यो। वोना सरग मा रव्हन वारो लोकगिन को निन्दा करयो। <verse eid="REV 13:6"/><verse number="7" style="v" sid="REV 13:7"/>वोना जनावर ला पवीतर लोकगीन सँग लड़ाई करके जितन को, अना हरेक कुल गोत अना भासा को लोकगीन पर अधिकार दियो। <verse eid="REV 13:7"/><verse number="8" style="v" sid="REV 13:8"/>धरती को हरेक मानूस जोन को नाव मारयो गयो पाठी को जिंदगी को किताब मा नाहती। वय लोक वा जनावर को पूजा करयेत।<verse eid="REV 13:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="REV 13:9"/>जोनको कान से वा आयको। <verse eid="REV 13:9"/><verse number="10" style="v" sid="REV 13:10"/>अना जोन बाँधो जावन लाई ठयरायो गयी से, उ बन्दीघर मा डाको जाहे। अना जो तलवार लक मारासे। उ तलवार लक मारो जाहे। पवीतर लोकईन को धीरज अना बिस्वास योच मा से।<verse eid="REV 13:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="REV 13:11"/>मंग मिना जमीन मा एक अखीन जनावर ला हिटयो दिसयो। मेढ़ा को जसो ओको सींग होतीन। अना उ अजगर को जसो बोलत होतो। <verse eid="REV 13:11"/><verse number="12" style="v" sid="REV 13:12"/>ओना पहलो जनावर को हाजरी मा उ सबच हक ला काम मा आनत होतो। वोको पाठी जसो सींग होतो। अना अजगर जसो बोलत होतो। पयलो वालो जनावर को समोर मा वोको अधिकार ला बवजत होतो। अना जोन पयलो जनावर होतो जोन को घाव साजरो होयो होतो। वोको धरती को निवासीगिन लक पूजा करवात होतो। अना <verse eid="REV 13:12"/><verse number="13" style="v" sid="REV 13:13"/>उ मोठो-मोठो अदभूत काम दिसात होतो। येतरो का बादल लक धरती मा स्तो बरसा देत होतो। <verse eid="REV 13:13"/><verse number="14" style="v" sid="REV 13:14"/>येना अदभूत काम दिसावन को ताकत ओनो जनावर पुढ़ा भेटयो होतो। अना धरती को रव्हन वालो गिनलक दगाबाजी करत होतो। अना उनला कव्हत होतो। की ओनो जनावर को मुरत बनाव, जेनको पर तलवार को निसान सेत अना वा दुबारा जित्तो होय गयो से। <verse eid="REV 13:14"/><verse number="15" style="v" sid="REV 13:15"/>अना ओला ओनो जनावर को मूरति मा जान डाकन को हक मिल गयो। का जसो जनावर की मूरति मा परा न डाखेत वा बोलन लगयेत। अना जेतरा लोक इन ओनो जनावर की मुरत की पूजा-पाठ नही करयेत, उनला मरवाय डाकहेत। <verse eid="REV 13:15"/><verse number="16" style="v" sid="REV 13:16"/>अना ओना नहानो-मोठो, धनी-गरीब, मालिक-नौकर सबच को उजो हात या उनको कपार मा एक-एक छाप कराय देयीस, <verse eid="REV 13:16"/><verse number="17" style="v" sid="REV 13:17"/>ओला छोड़ जेनको पर छाप मजे ओनो जनावर को नाव या ओको नाव को गिनती नही होहे। उ कोनी लेनदेन नही कर सकेत।<verse eid="REV 13:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="REV 13:18"/>अक्ल ऐमा से जेनला डिमाक होय, उ ऐना जनावर को गिनती जोड़ लेवे, काहेकि उ मानूस को गिनति को नम्बर 666 सेत।<verse eid="REV 13:18"/></para>
  <chapter eid="REV 13"/>
  <chapter number="14" style="c" sid="REV 14"/>
  <para style="s">मेढ़ा अना एक लाख चौवालीस हजार</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 14:1"/>मंग मीना चोवयो, मोरो समोर मा सिय्योन परवत मा पाठी उभो सेत। वोको संग च एक लाख चवालीस हज़ार, वय लोक भी उभो होतिन। जोनको कपार मा वोको, अना वोको परमेस्वर दआजी को नाव लिखयो होतो। <verse eid="REV 14:1"/><verse number="2" style="v" sid="REV 14:2"/>मंग मीना एक बादल लक आवाज आयको। एक मोठो नद्दी को अवाज जसो होतो, या घनघोर मेघ गरजन को वानी होतो। जोन आवाज मीना आयको होतो। वा लगत सो बीना एक संग बजासेत जसो अवाज होतो। <verse eid="REV 14:2"/><verse number="3" style="v" sid="REV 14:3"/>वय लोक सिघासन, च्यार जीव अना बुजरुक को समोर एक नवा गाना गावत होतिन। जोन एक लाख चवालीस हज़ार लोक ला धरती मा फिरौती देयकर बन्धन लक सोड़ा लियो होतो। उनला सोड़ कोनी मानूस वोना गाना नहीं सीक सकत होतिन। <verse eid="REV 14:3"/><verse number="4" style="v" sid="REV 14:4"/>वय असो मानूस होतिन। जोनना कोनी बायको को संग सोय के अपवितर नही भयो होतिन। काहेका वय कुंवारो होतिन। यो वय होतिन जोन पाठी को मघा-मघा जावत होतिन। यो लोकगिन सारी मानूस जाति लक उनला दाम देयकर बन्धन ले छुड़ायो गयो लोक होतिन। वय परमेस्वर अना पाठी को लाय फसल के पयलो फर को रूपमा होतिन। <verse eid="REV 14:4"/><verse number="5" style="v" sid="REV 14:5"/>उनना कभी झूठ नहीं बोलयो होतिन।<verse eid="REV 14:5"/></para>
  <para style="s">तीन सरगदूको मुनादी</para>
  <para style="p">
    <verse number="6" style="v" sid="REV 14:6"/>मंग मोला एक अना सरगदूत ला बादल को बीच मा उड़तो हुयो दिसयो। जोनको जवर धरती पर का रव्हनवारा हरेक कबिला, कूल, भासा अना लोकगीन ला आयकावन लाय अमर साजरो बारता होतो। <verse eid="REV 14:6"/><verse number="7" style="v" sid="REV 14:7"/>अना ओना मोठो आवाज लक साँगीस, “परमेस्वर लक भेव करो, अना वोको च महिमा करो। काहेका वोको नियाव को बेरा भयी गयो सेत। ओको च पूजा करो जोनना, सरग धरती सागर अना पानी को झरना बनायो सेत।”<verse eid="REV 14:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="REV 14:8"/>मंग एको मंघा एक अखिन दुसरो सरगदूत आयो, अना कव्हन लगयो, “वोको सत्यानास भयी गयो सेत। मोठो नगर बेबीलोन को सत्यानास भयी गयो। वोना सब देस ला खोटो काम को नसा करायो होतो।”<verse eid="REV 14:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="REV 14:9"/>मंग इनको मंघा एक अखीन तीसरो सरगदूत मोठो आवाज लक यो कव्हतो हुयो आयो, “जोन कोनी वोना जनावर, अना ओको मूरति को पूजा करेत। अना आपरो मस्तक या आपरो हात पर ओकी छाप लेहेत, <verse eid="REV 14:9"/><verse number="10" style="v" sid="REV 14:10"/>ता उ परमेस्वर को भयकर गुस्सा को सिकार बनहेत। अना उ पवितर सरगदूत अना पाठी को समोर स्तो अना गंधक मा सजा पाहेत। <verse eid="REV 14:10"/><verse number="11" style="v" sid="REV 14:11"/>जोन लोकगिन वोना जनावर या वोको मुरती को पूजा करतत, अना वोको नाव को छापा लगवासेत। ता उनको दुख हरामेसा जादा होहेत अना कदी राती दिवस चैन नही भेटेत।”<verse eid="REV 14:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="REV 14:12"/>परमेस्वर को हुकूम मानन वालो अना यीसु मा बिस्वास राखनवालो सन्तगिन को अबा धिरज धरन को बेरा आय गयो सेत।<verse eid="REV 14:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="REV 14:13"/>मिना सरग मा कोनी ला मोरो लक असो कव्हतो आयकियो, “लिख धन्य सेत, उ मरयो मानूस जोन आखीर दम तकन पिरभू मा बिस‍वास करतो मरयो सेत।” आतमा कव्हसे, “असोच होय, जोनलक वय आपरो काम को मघा बिसराम करहेत। काहेका वोको नेकी वोको संग जाहेत।”<verse eid="REV 14:13"/></para>
  <para style="s">धरती को उन्हारी को कटाई</para>
  <para style="p">
    <verse number="14" style="v" sid="REV 14:14"/>मिना चोवयो का, एक पांढरो बदली सेत। वोमा मानूस को टूरा जसो कोनी बसो नजर आवत होता। जोनको डोस्की मा सुन्नो को मुकुट अना हातमा पैनो इरा सेत। <verse eid="REV 14:14"/><verse number="15" style="v" sid="REV 14:15"/>मंग एक अखीन सरगदूत मंदिर मा लक हिटके, अना जोर लक हाकलत, बदली मा बसन वालो ला कहयो, “फसल पिक्क गयो सेत, कापन को बेरा सेत, इरा चलाव!” <verse eid="REV 14:15"/><verse number="16" style="v" sid="REV 14:16"/>तबा बदली मा बसन वालो ना इरा चलायो अना धरती को फसल कट गयो।<verse eid="REV 14:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="REV 14:17"/>मंग एक अखीन सरगदूत सरग को मंदिर मा लक हिटयो, उ खुद पैनो इरा लियो हुवो होतो।<verse eid="REV 14:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="REV 14:18"/>मंग एक अखीन सरगदूत, जोनको स्तो मा हक होतो, होमन कुन्ड लक हिटयो, अना जोरलक पैनो इरा लियो सरगदूत ला कहयो, “अपरो पैनो इरा चला अना धरती को अंगूर को बारी को गुच्छा ला बटोर काहेका अंगूर पीक्क गयो सेत।” <verse eid="REV 14:18"/><verse number="19" style="v" sid="REV 14:19"/>येकोमा सरगूतना आपरो इरा चलायो अना तबा ओय सरगदूत ना धरती को अंगूर को बेला को फर कापके, आपरो परमेस्वर को गुस्सा रुपी मोठो रसकुन्ड मा डाक देईस। <verse eid="REV 14:19"/><verse number="20" style="v" sid="REV 14:20"/>अना नगर को बाहेर ओनो रसकुन्ड मा अंगूर खुंदयो गयो। अना रसाकुन्ड मा लक एतरो रकत हिटयो का घोड़ा को लगाम तकन पहुच गयो, अना तीन सौ किलोमीटर तकन बोहाय गयो।<verse eid="REV 14:20"/></para>
  <chapter eid="REV 14"/>
  <chapter number="15" style="c" sid="REV 15"/>
  <para style="s">आखरी आफदगीन को सँग सरगदूत</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 15:1"/>मंग मिना बादल मा एक अखिन परमेस्वर को मोठयो अना अद्भूत निसान चोवयो, का सात सरगदूत सेत। जोन सात आखीर मोठो सत्या नास ला धरो होतिन।<verse eid="REV 15:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="REV 15:2"/>मंग मोला एक काँच को सागर चोवयो, जोनमा स्तो होतो। अना मिना चोवयो का ओनो जनावर अना ओको मुरत, अना ओको नाव गिनती लक जीत गयो होतिन। अना परमेस्वर को सरगदूत वोना काँच को सागर मा उभो होतिन। <verse eid="REV 15:2"/><verse number="3" style="v" sid="REV 15:3"/>वय परमेस्वर को सेवक, मोसे अना पाठी को यो गाना गावत होतिन,</para>
  <para style="q1" vid="REV 15:3">“हे सब लक ताकत वर पिरभू,</para>
  <para style="q2" vid="REV 15:3">परमेस्वर तोरो काम मोठा अना चमत्कार जसो सेत,</para>
  <para style="q1" vid="REV 15:3">हे जूग-जूग को राजा,</para>
  <para style="q2" vid="REV 15:3">तु न्यायी अना खरो सेत।”<verse eid="REV 15:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="REV 15:4"/>“हे पिरभू कोन तोरो लक नही भेव मानहेत?</para>
  <para style="q2" vid="REV 15:4">अना तोरो नाव को बड़ाई नही करेत?</para>
  <para style="q2" vid="REV 15:4">काहेकि तुच केवल एक पवीतर से,</para>
  <para style="q1" vid="REV 15:4">अना सबरो लोक गीन आयके</para>
  <para style="q2" vid="REV 15:4">तोरो पूजा नहि करहेत,</para>
  <para style="q2" vid="REV 15:4">काहेकी तोरो नियाव को काम दिसाय गयो सेत।”<verse eid="REV 15:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="REV 15:5"/>एको मंघा मिना दिसयो, का सरग मा करार को तम्बु को मंदिर खोलयो गयो, <verse eid="REV 15:5"/><verse number="6" style="v" sid="REV 15:6"/>अना वय सात सरगदूत जोनको जवर सात, सरगदूत जोनको जवर सात सत्यानास होतो। मंदिर लक बाहेर हिटीन, वय सरग दूत चकमक साजरो सन को साजरा कपरा घाल्यो हुयो होतिन। अना आपरो सीना मा सोन्नो को पट्टी बान्धयो होतिन। <verse eid="REV 15:6"/><verse number="7" style="v" sid="REV 15:7"/>मंग मीना उन चार जीव मा लक एक ला उन सातो सरगूत ला सोन्नो को बटका दियो जोन हरामेसा को काजी अमर परमेस्वर को कोप लक भरयो हुयो होतो। <verse eid="REV 15:7"/><verse number="8" style="v" sid="REV 15:8"/>उ मंदिर परमेस्वर को महीमा अना वोको ताकत को धुँगा भरयो हुयो होतो। तबा तकन वोना सात सरगदूत क सात बिनास को बेरा पूरो ना भयी जाय तबा तकन कोनी तम्बू को भितर नही धस सकेत।<verse eid="REV 15:8"/></para>
  <chapter eid="REV 15"/>
  <chapter number="16" style="c" sid="REV 16"/>
  <para style="s">परमेस्वर को गुस्सा की सात बटकी</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 16:1"/>तबा मि ना मंदिर मा जोरलक लक उन सात सरगदूत इन ला असो कव्हतो आयकयो। “जाव! परमेस्वर को सात गुस्सा वालो बटका ला धरती मा उबड़ाय देव।”<verse eid="REV 16:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="REV 16:2"/>तबा पयलो सरगदूत ना जायके, आपरो बटका धरती मा, उबड़ देईस। एना कारन लक उन मानूस गीनला, जोन पर ओनो हिसंक जनावर को छाप होतीन, अना जोन ओको मुरती को पूजा करत होतीन। उनला कस्ट देनवारी अना मारन वालो फोड़ा हिटन।<verse eid="REV 16:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="REV 16:3"/>दुसरो सरगदुत ना जबा आपरो बटका समुंदर पर उबड़ायो ता मरयो हुयो मानूस को रकत जसो पानी होय गयो। अना समुंदर को हरेक जीव मर गयिन।<verse eid="REV 16:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="REV 16:4"/>तीसरो सरगदूत ना जबा आपरो बटका नदी अना पानी को झरना पर उबड़ायो, ता वय रकत बन गईन। <verse eid="REV 16:4"/><verse number="5" style="v" sid="REV 16:5"/>तबा मिना सप्पा पानी को हकदार सरगदूत ला यो कव्हत हुयो आयकियो: “तुमी जो सेव, जो होतीन, धरमी अना सब लक पवीतर! बेस सेत तोरो न्याय!” <verse eid="REV 16:5"/><verse number="6" style="v" sid="REV 16:6"/>एकोलाय का उनना पवीतर लोकगीन अना भविस्यवक्ता गीन को रकत बोहायो सेत। “यो काजी पिवन को लाई उनला तुना रकत च दे दियोस। वय यो लायक सेत।” <verse eid="REV 16:6"/><verse number="7" style="v" sid="REV 16:7"/>तबा मिना सहमती मा वेदी ला असो सांगत हुयो आयकयो: “खरो से, उ सब लक ताकत वर परमेस्वर! बेस अना धरमी सेत तोरो नियाव।”<verse eid="REV 16:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="REV 16:8"/>सूरज पर चौथो सरगदूत ना आपरो बटका उबड़ाईस, अना ओला मानूसगिन ला स्तो लक जलाय देवन को हक देयो गयो। <verse eid="REV 16:8"/><verse number="9" style="v" sid="REV 16:9"/>मानूस मोठो तपन लक जर गइन। अना परमेस्वर को नाव को जेनला ऐना आफद पर हक से, लोक निन्दा करीन। पर पस्तावा करके ओको बड़ाई करन ला मन नही बदलिन।<verse eid="REV 16:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="REV 16:10"/>पाँचवा सरगदूत ना आपरो बटका ओनो जनावर को सिघासन पर उबड़ाईस, अना ओको राज मा इंधारो भय गयो। लोक कस्ट को मारे आपरो-आपरो जुबान चबावन लगीन। <verse eid="REV 16:10"/><verse number="11" style="v" sid="REV 16:11"/>अना आपरी दूख अना फोड़ा को कारन सरग को परमेस्वर को निन्दा करीन। पर आपरो-आपरो कामगीन लक मनमा पस्तावा कर मन नही बदलीन।<verse eid="REV 16:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="REV 16:12"/>छटो सरगदूत ना आपरो बटका महानदी फरात पर उबाड़ायो। अना ओको पानी सूक गयो का पूरब दिसा को राजा इन को लाई रस्ता सुधर जाहे। <verse eid="REV 16:12"/><verse number="13" style="v" sid="REV 16:13"/>मंग मिना अजगर को टोंड लक, अना ओनो जनावर को टोंड लक, अना ओनो खोटो भविस्यवक्ता को टोंड लक तीन बेकार आतमा ला मेडका को रूप मा हिटतो दिसयो। <verse eid="REV 16:13"/><verse number="14" style="v" sid="REV 16:14"/>यो निसान दिसान वालो बुरो आतमा सेत। जो सप्पा संसार को राजा गिनको जवर हिटके एकोलाय जावासेत। का उनला सब लक ताकत वर परमेस्वर को बिरोधमा ओनो मोठो दिवस को लड़ाई को लाई जमा करेत।<verse eid="REV 16:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="REV 16:15"/>“आयको, मि चोर को जसो आवुसू। धन्य उ सेत जो जागत रव्हसे, अना आपरो कपरा को चौकसी करासे का नंगरो नोको फिरेहत अना लोक ओको नंगरोपन नही दिसेत।”<verse eid="REV 16:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="REV 16:16"/>अना उनना राजागिनला ओनो जघा जमा करीन जोन इबरानी मा हर मगीदोन कहलावासे।<verse eid="REV 16:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="REV 16:17"/>सातवो सरगदूत ना आपरो बटका वारा पर उबड़ायो, अना मंदिर को सिघासन लक एक उचो आवाज आयकु आयो, “पूरो भय गयो!” <verse eid="REV 16:17"/><verse number="18" style="v" sid="REV 16:18"/>तबा बिजली चमकी, अना आवाज अना गरजन हुयो। अना एक असो मोठो भुयीडोल आयो। का जब लक मानूस धरती पर पैदा भयी से, तब लक असो मोठो भुयीडोल कबच नही आयो होतो। <verse eid="REV 16:18"/><verse number="19" style="v" sid="REV 16:19"/>एको लक मोठो नगर को तीन टुकड़ा भय गयो। अना देस-देस को नगर पड़ गयीन। तबा परमेस्वर ना मोठो बेबीलोन ला हेत करयो। का आपरो भयानक गुस्सा वोको पर उतारेत। <verse eid="REV 16:19"/><verse number="20" style="v" sid="REV 16:20"/>अना हरेक पहाड़ी आपरी-आपरी जघा लक हट गयीन, अना दीपगीन को नाव निसान मिट गयो। <verse eid="REV 16:20"/><verse number="21" style="v" sid="REV 16:21"/>बादर लक मानूस गीन पर मन-मन भर को मोठा गारगोटा पड़या, अना एकोलाय का यो आफद लगत च भारी भरकम होती। लोक इन ना गारगोटा को आफद को कारन परमेस्वर को निन्दा करीन।<verse eid="REV 16:21"/></para>
  <chapter eid="REV 16"/>
  <chapter number="17" style="c" sid="REV 17"/>
  <para style="s1">मोठी बेसिया</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 17:1"/>तबा सात सरगदूत जोन सात बटका धरयो होतिन, उनमा लक एक ना कह्यो, “आव, अना एक महा बेसिया को सजा चोव।” वो बेसिया वा महानगर सेत, जोन नद्दीगिन को कगर मा बसो सेत। <verse eid="REV 17:1"/><verse number="2" style="v" sid="REV 17:2"/>“धरती को राजागिन वा नगर मा खोटो काम करीन। अना वोना छिनाला पन को कारन धरती को निवासी मत गयीन।”<verse eid="REV 17:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="REV 17:3"/>तबा उ मोला आत्मा मा बसमा करके जंगल ले गयो। अना मी लाल रंग को जनावर मा जोनमा परमेस्वर को नाव को निन्दा छपयो होतो। अना वोको सात डोस्का अना दहा सींग होतो। क बायका वा मा बसी होति। <verse eid="REV 17:3"/><verse number="4" style="v" sid="REV 17:4"/>वा बायको बैंगनी अना लाल रंग को कपरा अना सोन्नो, रतन अना मोती को जेवर घाल्यो हुयो होती। ओको हात मा सोन्नो को बटका होतो, जोन अपवितर चीज लज्जा अना खुदच ओकी छिंडरापन की गंदगी लक भरयो हुयो होतो। <verse eid="REV 17:4"/><verse number="5" style="v" sid="REV 17:5"/>ओको कपार मा एक नाव, एक भेद लिखयो होतो। आलीसान मोठोनगरी बेबीलोन धरती मा छिंनालापन की माय, अना सप्पा बेकार अना नीच काम की मातामाय।<verse eid="REV 17:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="REV 17:6"/>मीना चोवयो, का वा बायका संतगीन अना उन मानूस गिनको रकत पीवके मता गयी सेती। जोनना यीसु को लाय आपरो बिस्वास को गवाहि को कारन आपरो जियान दे दियो। वोला चोवके मोला लगत अचरज भयी। <verse eid="REV 17:6"/><verse number="7" style="v" sid="REV 17:7"/>तबाच मोरोलक दूत ना पूसिस, “तू काहे अचरज मा सेत?” मि तोला यो जनावर अना यो मा बसी बायको को काजक मतलब सेत सांग सेऊ। सात डोस्का अना दहा सींग को यो जनावर <verse eid="REV 17:7"/><verse number="8" style="v" sid="REV 17:8"/>जोन तु ना चोवीसे, पयले कदी जित्तो होतो। पर अबा जित्तो नाहती। मंग उ पताल लक हीटन वालो सेत। अना वोको नास भयी जाहेत। मंग धरती को वय लोक जिनको नाव जगत को सुरू लक जिंदगी को किताब मा नही लिख्यो सेत। वा जनावर ला चोवके, चकित होयेत। काहेका वा कदी जित्तो होतो, पर अबा जित्तो नाहती। <verse eid="REV 17:8"/><verse number="9" style="v" sid="REV 17:9"/>“योच अकलवर मानुसको लाय बिचारन को चीज सेत।” को यो सात डोस्का, वय सात परवत सेत। जोनमा वा बायको बसी सेत। वय सात डोस्का सात राजा को निसान सेत। <verse eid="REV 17:9"/><verse number="10" style="v" sid="REV 17:10"/>जोनमा पयले पाँच को नास भयि गयो सेत। एक अबा भी राज करासेत। अना दूसरो अबा तकन आयो नाहती। पर जबा उ आहेत ता कही च बेरा रहेत। <verse eid="REV 17:10"/><verse number="11" style="v" sid="REV 17:11"/>वा जनावर जोन पयले कदी जित्तो होतो, पर अबा जित्तो नाहती। वा खुदच आठवो राजा सेत। जोन वोना सात मा लक एक से, वोको भी नास होवन वालो सेत। <verse eid="REV 17:11"/><verse number="12" style="v" sid="REV 17:12"/>“जोन दहा सींग तु ना चोवीसेत। वय दहा राजा सेत, जोनना अबा राज करनो सुरू नही करीसेत। पर जनावर को संग घड़ी भर लाय राज करन को उनला हक दियो जाहे। <verse eid="REV 17:12"/><verse number="13" style="v" sid="REV 17:13"/>इन दहा राजा गिनको एकच मकसद सेत। का वय आपरो बल अना हक वा जनावर ला दे देहेत। <verse eid="REV 17:13"/><verse number="14" style="v" sid="REV 17:14"/>वय पाठी को बिरोध मा लड़ाई करहेत, पर पाठी आपरो हाकलो गयो, अना निवाड़ो गयो, चेला गिनको संग उनला हरा देहेत। काहेका उ राजा गिनको राजा अना पिरभू गिनको पिरभू आय।”<verse eid="REV 17:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="REV 17:15"/>वोना दूत ना मंग मोरो लक कह्यो, “वय नद्दी जोनला तुमीना चोवीसेव, जिता उ बेसिया बसी होती। दुसर-दुसर कबिला, समाज, भासा को निसान सेत। <verse eid="REV 17:15"/><verse number="16" style="v" sid="REV 17:16"/>वय दहा सींग जोनला तू ना चोवी सेत, अना वा जनावर वा बेसिया लक लगत गुस्सा करहेत। अना वोको सबा चीज हिसक लेहेत। अना वोला बिना कपरा को सोड़ देहेत। वय वोको आंग ला नास कर देहेत। अना स्तो मा जला डाखेत। <verse eid="REV 17:16"/><verse number="17" style="v" sid="REV 17:17"/>अपरो मतलब पुरो करनो को लाय परमेस्वर ना उन सबला एक मन करके उनको डिमाक मा असो बसा दियो सेत का जब तकन परमेस्वर को बचन पुरो नही होयेत, तबा तकन को लाय वय राजा हुन आपरो हक वोना जनावर ला देवे। <verse eid="REV 17:17"/><verse number="18" style="v" sid="REV 17:18"/>वा बायका जोन तूना चोवीसेत। वा मोठो सहर सेत, जोन धरती को राजा गिन पर राज करत होती।”<verse eid="REV 17:18"/></para>
  <chapter eid="REV 17"/>
  <chapter number="18" style="c" sid="REV 18"/>
  <para style="s">सरगदूत कन लक बेबीलोन को नास होवनो</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 18:1"/>एको मंघा मिना अखिन एक सरगदूत ला सरग लक आवता चोयो। वोको जवर मोठो अधिकार होतो। अना वोको गौरव को तेज लक धरती मा उजाड़ फैल गयो। <verse eid="REV 18:1"/><verse number="2" style="v" sid="REV 18:2"/>ओना जोरलक चिल्लाय के कव्हयो “पड़ गयो! पड़ गयो! सुंदर मोठो नगर बेबीलोन पड़ गयो। अब यो बुरो आतमा को घर, असुद्ध आतमा का आसरा, अना हर एक असुध्द अना घिरनावारा पक्सी का बसेरा बन गयो से। <verse eid="REV 18:2"/><verse number="3" style="v" sid="REV 18:3"/>सब देस ना ओको छिनालापन को नसा मा मत गयो सेत। अना धरती को सबा राजा गीन ना ओको सँगा छिंडरापन करीसेस। अना बिना रोक टोक को धनवान भयी गयो।”<verse eid="REV 18:3"/></para>
  <para style="s">परमेस्वर को लोक गीन ला बेगरो करयो जानो</para>
  <para style="p">
    <verse number="4" style="v" sid="REV 18:4"/>तब मीना बादल लक एक अखीन आवाज आयकियो</para>
  <para style="q1" vid="REV 18:4">“ओ मोरी परजा, ओनो नगरी लक बाहेर हिट जाव!</para>
  <para style="q2" vid="REV 18:4">तुमी, ओको पाप मा ओको संगी नोको बनो,</para>
  <para style="q2" vid="REV 18:4">ओकी सजा को हिस्सादार नोको बनो।”<verse eid="REV 18:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="REV 18:5"/>ओको पापगीन को गठ्ठा सरग लक वरता सेत।</para>
  <para style="q2" vid="REV 18:5">परमेस्वर ना वोको खोटो काम ला हेत करीसेस।<verse eid="REV 18:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="REV 18:6"/>वोको लक जसो ला तसाच को बरताव करो। वोको बुरो काम को बदला न मा देहला देव।</para>
  <para style="q2" vid="REV 18:6">अना जोन बटका तुमरो लाय तैय्यार करीसेस, तुमी ओको लाय दुई गुना तेज तैयार करो।<verse eid="REV 18:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="REV 18:7"/>वा जेतरी आपरो बड़ाई करके जितरो सुक भोगिसेत, तुमी भी ओला ओतरो च परेसानी अना कस्ट देव।</para>
  <para style="q2" vid="REV 18:7">काहेकि उ मन च मन कव्ह से, “मि ता रानी जसो सेव। मि बेवा नहीं सेव, मोरो कबच आंसु नही बहेत।”<verse eid="REV 18:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="REV 18:8"/>“यो कारन से की एक च दिवस मा</para>
  <para style="q2" vid="REV 18:8">असो पर आफद आ पड़ेत।</para>
  <para style="q1" vid="REV 18:8">मरही, रोवनो अना गिरानी। ओला स्तो मा जला दियो जाहे,</para>
  <para style="q2" vid="REV 18:8">काहेकि परमेस्वर ताकतवर सेत। अना न्याय करा सेत।”<verse eid="REV 18:8"/></para>
  <para style="s1">धरती मा बाबेल देस को रोवनो</para>
  <para style="p">
    <verse number="9" style="v" sid="REV 18:9"/>“सबा धरती को राजा जोन वोको संग मा छिनालापन मा मगन रहवत होतिन। जोन वोको संग अय्यासी करत होतिन। वोना स्तो को धुंगा चोवके रोवन अना चिल्लावन लगीन।” <verse eid="REV 18:9"/><verse number="10" style="v" sid="REV 18:10"/>वोकी दुख ला हेत करके भेव के मारे, दूहुर उभा होयके वय कव्हन लगीन। धिक्कार! धिक्कार, हे ताकतवर मोठोनगरी बेबीलोन! धिक्कार तोरो पर से! तास भर मा च तोरो दन्ड की बेरा आय गईसे।<verse eid="REV 18:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="REV 18:11"/>धरती का व्यापार करन वारा वोको पर चिलावत रड़ेत “काहेकी उनकी चीजगीन ला अता कोनी नही लेहेत।” <verse eid="REV 18:11"/><verse number="12" style="v" sid="REV 18:12"/>सोन्नो, चांदी, कीमती रतन, मोती, बढ़िया मलमल, बैंगनी कपरा अना लाल रेसम, सब प्रकार की सुगन्धित काड़ी अना हाथी-दाँत की चीज, कीमती काड़ी लक बनयो चीज, काँसो, लोहा अना संगमरमर लक बनयो चीज, <verse eid="REV 18:12"/><verse number="13" style="v" sid="REV 18:13"/>दालचीनी, मसाला, धूप, इतर, मुर्र, लुभान, अंगूर को रस, जैतून को तेल, मैदा, गहूँ, जनावर, मेढा, घोड़ा अखिन चौपहिया वाहन, “दासगीन को तन अखिन मानूसगिन को कोनी खरीददार नहीं रहयो।” <verse eid="REV 18:13"/><verse number="14" style="v" sid="REV 18:14"/>बयपारी वोको लक कव्हसेत, “तुमरो जवर जोन साजरो चीज होतयो, वय सब गायब भयी गयी। अना तुमरो सप्पा दौलत अना सान सौकत, चलयो गयो सेत अबा कदी नही मिल्हेत।”<verse eid="REV 18:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="REV 18:15"/>बैपारी जोन सहर मा धंधा करके धनवान होय गयी सेत। वय दुख को कारन लक भेव को मारे, दुहूर उभो होयके रोहेत। अना दुख मनाहेत, <verse eid="REV 18:15"/><verse number="16" style="v" sid="REV 18:16"/>अना कहेत, “हाय, हाय मोठो नगरी जो बढ़िया मलमल, बैंगनी अना किरमिजी कपरा घालत होतीन, अना सोनो को चीजगीन जसो अना मोतीगीन लक सजायो होतीन। <verse eid="REV 18:16"/><verse number="17" style="v" sid="REV 18:17"/>घन्टा भर मा ओको असो मोठो धन नास भय गयो।” अना डोंगा को हरेक मुखिया, अना हरेक यातरी अना ढीमर अना सब लोकगीन, जोन समुंदर लक आपरो गुजर बसर करासेत। दुहूर उभा रहीसेत। <verse eid="REV 18:17"/><verse number="18" style="v" sid="REV 18:18"/>अना ओको जलन को धुँआ ला चोवके चिल्ला उठी सेत। “कोनतो नगर यो मोठो नगर को जसो से।” <verse eid="REV 18:18"/><verse number="19" style="v" sid="REV 18:19"/>उनना आपरो-आपरो डोस्का पर धुल डाकिन अना चिल्लात रोवत अना कलपत होयो सांगीन, “हाय-हाय मोठो नगर जो की सम्पती लक सबच नाव वारा धनी होय गयो होतीन, अता घन्टा भर मा उ उजड़ गयो।”<verse eid="REV 18:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="REV 18:20"/>ओ सरग अना पवीतर लोकगीन, पेरीत गीन, अना भविस्यवक्ता गीन, ओको पर खुसी मनाव, काहेकि परमेस्वर ना तुमरो पक्स मा अना ओको विरोध मा न्याय करीसेस।<verse eid="REV 18:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="REV 18:21"/>तबा एक ताकतवर सरगदूत ना चकिया को पाट को जसो एक मोठो पत्थरा ला उचलके यो कव्हत हुयो समुंदर मा फेक देइस, “ऐना रिती लक मोठो नगरी बेबीलोन भी ताकत सँग फेक दियो जाहे। अना ओको पता भी नही चलेत।” <verse eid="REV 18:21"/><verse number="22" style="v" sid="REV 18:22"/>अना तोरो मा वीना बजानवारा, संगीतवारा, बंसरी को धुन अना तुर्रा फुकन वारा, को आवाज मंग कबच नहि आयकु आय। नाच कोनी कला को सिल्पकार तोरो मा मंग कभी पायो जाहेत। नाच तोरो मा कोनी चकिया को आवाज कबच आयकुआयत। <verse eid="REV 18:22"/><verse number="23" style="v" sid="REV 18:23"/>ना च दियो को उजाड़ा मंग कबच तोरो मा चमकेत। अना नाच नौरा नौरीको बोली तोरो मा आयकुआयेत। तोरो धन्धाकरनवारा धरती को मोठो आदमी होतीन। अना तोरो जादू लक सबच लोक गीन भरमाया गयो होतीन। <verse eid="REV 18:23"/><verse number="24" style="v" sid="REV 18:24"/>भविस्यवक्ता गीन, पवीतर संतगीन अना धरती मा मारयो गयो लोकगीन को रकत ओमा पायो गयीसे।<verse eid="REV 18:24"/></para>
  <chapter eid="REV 18"/>
  <chapter number="19" style="c" sid="REV 19"/>
  <para style="p">
    <verse number="1" style="v" sid="REV 19:1"/>ऐना गोस्टी को मंघा मोला सरग लक एक असो आवाज आयकयो! लोक कव्हत होतिन, “हाल्लेलूयाह! सूटकारा अना महिमा अना ताकत आमरो परमेस्वर को से।” <verse eid="REV 19:1"/><verse number="2" style="v" sid="REV 19:2"/>“ओको न्याय खरो अना धरमी से, काहेका ओना ओनो बूरो बेसिया ला सजा देईसेस। जो आपरो छिंनालापन लक धरती ला खराब कर डाखि सेत। यो काजी परमेस्वर ना आपरो दास गीनको खून को बदला लेई सेस।” <verse eid="REV 19:2"/><verse number="3" style="v" sid="REV 19:3"/>उनना दुबारा गाना गायिन, “हाल्लेलूयाह! ओला भस्म करतो लपक को धुँआ सदा-सदा उठत रव्हेत।” <verse eid="REV 19:3"/><verse number="4" style="v" sid="REV 19:4"/>वय चौबीस बुजरूक अना चयार जित्तो जीव परमेस्वर को पुढ़ा, जो सिघासन पर विराजमान से, नमस्कार करीन अना बड़ाई करत होत कव्हन लगसेत: “आमेन, हाल्लेलूयाह!”<verse eid="REV 19:4"/></para>
  <para style="s">पाठी को बिहाव</para>
  <para style="p">
    <verse number="5" style="v" sid="REV 19:5"/>तबा सिघासन लक एक आवाज आयो “तुमी सब, जो परमेस्वर को भगत सेव, तुमी सब, जो उनको भरोसा ठेवन वारा सेव। दास अना खास परमेस्वर को बड़ाई करो।” <verse eid="REV 19:5"/><verse number="6" style="v" sid="REV 19:6"/>मंग मिना एक मोठयो सागर को जसो सब आयकयो जोन लगत मोठयो पुरा को अवाज अना बादल गरजन को अवाज जसो होतो। लोक गावत होतिन। “हल्लिलूय्याह! वोको जय हो, काहेका आमरो पिरभू परमेस्वर! सबलक बलवान राज कर रहयो सेत।” <verse eid="REV 19:6"/><verse number="7" style="v" sid="REV 19:7"/>एकोलाय आओ, खुसी होयके, आँनद मनाव, आओ, वोला महिमा देबिन! काहेका अब पाठी को बिहा को बेरा आय गयो सेत, नवरी सजी-धजी तैयार सेत। <verse eid="REV 19:7"/><verse number="8" style="v" sid="REV 19:8"/>वोला यो हुकूम मिलयो सेत, का “साफ बेदाग मलमल को धोत घाले।”<note caller="+" style="f"><char style="fr" closed="false">19:8</char><char style="ft" closed="false">यो मलमल संत गीनको धरम को काम को निसान आय। </char></note><verse eid="REV 19:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="REV 19:9"/>मंग मोरो लक उ कहन लगयो, “लिख जोन यो बिहा मा बुलायो गयो सेत, उ धन्य सेत।” मंग वोना कहयो, “यो परमेस्वर को खरो बचन सेत।” <verse eid="REV 19:9"/><verse number="10" style="v" sid="REV 19:10"/>अना मी वोको अराधना करन लाय वोको पाय मा पड़ गयो। पर उ मोरो लक कहयो, आयक! असो कायलाय करतत? मि ता तोरो अना तुमरो भाऊगीन को जसोच, जोन मसीह यीसु को गवाही सेत, “उनको संगी सेऊ, परमेस्वर ला डोस्का टेको! काहेकि मसीह यीसु को बारे मा गोस्टी साँगनो च भविस्यवानी को आतमा से।”<verse eid="REV 19:10"/></para>
  <para style="s">घुड़सवार पाँढरो घोड़ो पर</para>
  <para style="p">
    <verse number="11" style="v" sid="REV 19:11"/>मंग मिना सरग ला उघड़तो चोवयो, अना उतनी मोरो समोर एक पान्ढ़रो घोड़ा होतो। वा घोड़ा को सवार सच्चो होतो, अना बिस्वास काबील कहलात होतो। काहेका उ न्याय को संग फैसला करत होतो, अना लड़ाई करत होतो। <verse eid="REV 19:11"/><verse number="12" style="v" sid="REV 19:12"/>वोको डोरा सतो को धगाड़ी जसो होतो, वोको डोस्का मा लगत मुकुट होतो। वोमा एक नाव लिख्यो होतो। जोनला वोको सिवा कोनी नही जानत होतिन। <verse eid="REV 19:12"/><verse number="13" style="v" sid="REV 19:13"/>वोना खून मा डुबायो होय कपरा डाकयो हुयो से। अना वोला नाव दीयो गयो होतो। “परमेस्वर को सबद” <verse eid="REV 19:13"/><verse number="14" style="v" sid="REV 19:14"/>पान्डरो घोड़ा मा बसयो सरग को सेना वोको मघा-मघा चलत होतिन। उनना पान्डरो मलमल को कपरा घालयो होतिन। <verse eid="REV 19:14"/><verse number="15" style="v" sid="REV 19:15"/>देस-देस को खोटो मानूस गिनला मारन को लाय वोको टोन्ड लक एक तेज धार वालो तरवार हिटा सेत। अना लोहा को छड़ी लियो हुयो उ उनको पर राज करहेत। अना उ सबलक बलवान परमेस्वर को लगत तेज गुस्सा अना हिजड़नो को घानी मा अंगूर को रस निचोहेत। <verse eid="REV 19:15"/><verse number="16" style="v" sid="REV 19:16"/>वोको कपरा अना जाँघ मा लिखयो होतो। राजागीन को राजा, पिरभुगीन को पिरभु।<verse eid="REV 19:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="REV 19:17"/>तबा मिना एक सरग को दूत ला सुरज मा उभा चोयो। वोना वरता बादल मा उड़नवारा पक्सी गीनला हाका देत साँगीस, “आव, परमेस्वर को तैय्यार जेवन को लई जमा भय जाव।” <verse eid="REV 19:17"/><verse number="18" style="v" sid="REV 19:18"/>अना तुमी राजा गीन, सेनापतिगीन, ताकतवर मानूस, घोड़ा मा बसन वालो, अना सब मानूसगिन को-मालिक अना दास, साधारन अना खास, “सबको माँस जेव।”<verse eid="REV 19:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="REV 19:19"/>तबा मिना चोयो का वा जनावर अना धरती को राजा अना उनको सेनागीन, जोन घोड़ा पर बसया सेत। अना ओको सेना लक लड़ाई करन को लाई जमा होय गयीन। <verse eid="REV 19:19"/><verse number="20" style="v" sid="REV 19:20"/>तबा पाठी को सेना ओनो जनावर ला धर लेयीन। ओको संगा च ओनो खोटो भविस्यवक्ता ला भी, जो ओनो जनावर को नाव मा चमत्कार निसान दिसायके उनला छल रहयो होतो, जिन पर ओनो हिंसक जनावर को छाप होती अना जो ओकी मूरति को पूजा करत होतीन। ऐना दुही ला जित्तो च गंधक लक सुलगी स्तोको झील मा फेक दियो गयो। <verse eid="REV 19:20"/><verse number="21" style="v" sid="REV 19:21"/>उन घोड़ा सवार को टोंड लक हिटयो हुयो तरवार लक बाकी सैनिक मार दियो गयो। अना सबच पक्सी गीन ना ठुस-ठुस के उनको माँस खाईन।<verse eid="REV 19:21"/></para>
  <chapter eid="REV 19"/>
  <chapter number="20" style="c" sid="REV 20"/>
  <para style="s">हजार बरस को राज</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 20:1"/>एको मंघा मिना एक सरग को दूत ला सरग लक खाल्या उतरतो चोवयो। ओको हात मा नरक को कुन्जी अना एक भारी साकल होती। <verse eid="REV 20:1"/><verse number="2" style="v" sid="REV 20:2"/>सरगदूत ना ओना पंखा वालो जुनो सरप ला जोन सैतान भी कहलावा सेत, एक हजार बरस को लाई बाँध दियो। <verse eid="REV 20:2"/><verse number="3" style="v" sid="REV 20:3"/>तबा सरगदूत ना ओला नरक मा फेक देईस। अना ओला बंद करके ओको मा सील लगाय देईस। का उ हजार बरस पूरो होवन तकन कैद रहेत। अबा उ कोनी भी देस ला अखिन जादा नोको भरमा पायेत। यो सब होवन को मंघा यो जरूरी होतो की ओला जरा सो बेरा को लाई छुट दियो जाहे।<verse eid="REV 20:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="REV 20:4"/>मगं मि ना सिघासन चोवयो। ओनो पर वय लोक बसी होतीन। जिनला नियाव करन को हक दियो होतो। तबा मिना उन आतमा गीन ला चोवयो, जिनको डोस्का यीसु मसीह को गवाही को कारन अना परमेस्वर को गोस्टी को आयकावन लक काप दियो गयो होतीन। उनना ओना जनावर मजे ओको मुरत को पूजा नही करयो होतीन। जिनको कपार मा अना हात पर ओको सील नही लगाईन होतिन। वय जित्तो होय गईन, अना उनना हजार बरस तकन मसीह को सँग राज करीन। <verse eid="REV 20:4"/><verse number="5" style="v" sid="REV 20:5"/>योच से पयलो जी उचलनो-बाकी मरयो हुयो तबा तकन जित्तो नही होयो। जबा तकन हजार बरस पूरो नही होय गयीन। <verse eid="REV 20:5"/><verse number="6" style="v" sid="REV 20:6"/>पवीतर अना धन्य सेति वय, जिनला यो पयलो जी उचलनो मा सामिल करयो गयो से। दुसरी मिरतु को उन पर कोनी हक नाहती। तर वय परमेस्वर अना मसीह को याजक होयेती। अना हजार बरस तकन उनको सँग राज करयेत।<verse eid="REV 20:6"/></para>
  <para style="s">सैतान ला नास करनो</para>
  <para style="p">
    <verse number="7" style="v" sid="REV 20:7"/>मंग हजार बरस को बेरा पूरो होवनो मा सैतान ला सोड़ दियो जाहे। <verse eid="REV 20:7"/><verse number="8" style="v" sid="REV 20:8"/>अना उ पुरो धरती मा फैलो हरेक देसला छलन को लाय हीट जाहेत, अना वा गोग अना मागोग ला छलेत। उ उनला लड़ाई को लाय जमा करयेत। वय समुन्दर को रेता को बराबर होतिन। <verse eid="REV 20:8"/><verse number="9" style="v" sid="REV 20:9"/>सैतान को सेना सबा धरती मा फैल जाहेत। अना वय संतगिन को डेरा अना चहेतो नगरला घेर लेहेत। तर स्तो गरता लक बरसेत अना सबको नास कर देहेत। <verse eid="REV 20:9"/><verse number="10" style="v" sid="REV 20:10"/>तबा सैतान ला, जेना उनको सँग छल करी होतीन, स्तो अना गन्धक को झील मा फेक दियो जाहेत, जहान ओना जनावर अना खोटो भविस्यवक्ता ला फेक गयो से। वहान उनला सदा को लाई तड़पत रहेत।<verse eid="REV 20:10"/></para>
  <para style="s">मोठो पाँढरो सिघासन अना आखरी नियाव</para>
  <para style="p">
    <verse number="11" style="v" sid="REV 20:11"/>तबा मिना पांढरो रंग को एक महिमा भरयो सिघासन अना ओको मा बसन वालो ला चोवयो, जिनको हाजरी लक धरती अना बादल पराय गयो, अना मंग कबच नही चोवयो। <verse eid="REV 20:11"/><verse number="12" style="v" sid="REV 20:12"/>मंग मिना सबच मरयो हुयो लहान अना मोठयो ला सिघासन को समोर चोवयो। तबा किताब खोलियो गयो, अना एक अखीन न्याय को किताब खोलयो गयो। <verse eid="REV 20:12"/><verse number="13" style="v" sid="REV 20:13"/>समुंदर ना आपरो मा समाये हुयो मरयो लोकगीन ला पुढ़ा कियो। हर कोनी को न्याय ओको काम को अनुसार करयो गयो। <verse eid="REV 20:13"/><verse number="14" style="v" sid="REV 20:14"/>मिरतु अना नरक को स्तो को झील मा उनला फेक दियो गयो। योच से दुसरो मिरतु-स्तो को झील। <verse eid="REV 20:14"/><verse number="15" style="v" sid="REV 20:15"/>ओला जोको नाव जीवन को किताब मा नही पायो गयो से, स्तो को झील मा फैक दियो गयो।<verse eid="REV 20:15"/></para>
  <chapter eid="REV 20"/>
  <chapter number="21" style="c" sid="REV 21"/>
  <para style="s">नयो सरग अना नयो धरती</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 21:1"/>तबा मिना एक नयो सरग अना एक नयी धरती देखियो, अबा पहलो सरग अना पहलो धरती को नाव निसान नही रहयो। <verse eid="REV 21:1"/><verse number="2" style="v" sid="REV 21:2"/>तबा मिना पवीतर नगरी, नयो यरुसलेम ला सरग लक, परमेस्वर को कन लक उतरतो हुयो चोयो। उ आपरो नौरा को लाई खबसुरती लक सजायो गयी नौरी को जसो होती। <verse eid="REV 21:2"/><verse number="3" style="v" sid="REV 21:3"/>तबा मिना सिघासन लक एक उचो सबद मा यो कव्हतो आयकियो, “चोवो! मानूसगिन को बीच मा परमेस्वर को रव्हनो!” अब परमेस्वर उनको बीच रव्हे। वय उनको जनता होहेत अना खुदच परमेस्वर उनको बीच अमर निवास करहेत। <verse eid="REV 21:3"/><verse number="4" style="v" sid="REV 21:4"/>परमेस्वर उनको डोरा लक हरेक आँसू पोछ देहे। अता लक मिरतू पायो न जाहे। अता ना कलपनो, ना रोवनो अना नाच कोनी दरद रहेत। काहेकि जो पहली गोस्टी होतीन, अता वय नही रहीन।<verse eid="REV 21:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="REV 21:5"/>उनना जो सिघासन पर बसयो से, कव्हसे, “चोवो! अता मि नई दुनिया ला बनावन वालो सेव!” तब ओना मोला नाव आन के सांगीस, “लिख देव, काहेका जो काही कव्हयो जावअ सेत, वा खरो अना भरोसा लायक से।” <verse eid="REV 21:5"/><verse number="6" style="v" sid="REV 21:6"/>तबा ओना मोला साँगीस, यो सब गोस्टी पूरी होय गयी सेत! मिच पयलो अना आखीर सेऊ, जोन तहान से, जिंदगी को पानी को पिझरा लक बिना कीमत को पीवन भटेत। <verse eid="REV 21:6"/><verse number="7" style="v" sid="REV 21:7"/>जो जीत जाहे, व ओला यो वारिसपन मिलेह। मि ओको परमेस्वर होहुँ अना उ मोरी औलाद। <verse eid="REV 21:7"/><verse number="8" style="v" sid="REV 21:8"/>“पर डरपोकगीन, अबिस्वासी, निन्दक, हत्यारागीन, छिनाल अना छिंडरागीन, टोन्हा, मुरत पुजा करनवारा, अना सबच झूठो को जघा ओना झील मा होहे, जो स्तो अना गन्धक लक पेटा से। योच से दुसरी मिरतु।”<verse eid="REV 21:8"/></para>
  <para style="s">मसीहा को यरुसलेम</para>
  <para style="p">
    <verse number="9" style="v" sid="REV 21:9"/>तबा जिन सात सरगदूत गीन को कठा सात आखरी मुसीबत लक भरयो सात बटका होतीन। उनमा लक एक ना मोरो कठा आयके मोला सांगीस, “आव, मि तुमला नौरी मेढ़ा को नौरी दिसाऊ।” <verse eid="REV 21:9"/><verse number="10" style="v" sid="REV 21:10"/>तबा उ मोला मोरी आतमा मा को बसमा एक मोठो पहाड़ को वरता ले गयो। अना मोला परमेस्वर को कना लक सरग लक उतरतो हुयो पवीतर नगर यरुसलेम दिसायो। <verse eid="REV 21:10"/><verse number="11" style="v" sid="REV 21:11"/>परमेस्वर को बड़ाई लक तैय्यार ओको तेज किमती पत्थरा जसो अना लगत कीमती रतन, सुरज की लाली को जसो होती। <verse eid="REV 21:11"/><verse number="12" style="v" sid="REV 21:12"/>नगर को सहरपनाह को दिवाल ऊची अना मोठी होती। ओमा बारा बेसकुड़ होतीन अना बारा बेसकुड़ मा रेह बारा सरगदूत होतीन। ओनो बेसकुड़मा इसरायल को बारा कुल को नाव लिखयो होती। <verse eid="REV 21:12"/><verse number="13" style="v" sid="REV 21:13"/>तीन फटका दिवस उगती कन, तीन उत्तर कन, तीन दिवस बुढता कन अना तीन दक्सिन कना होतीन। <verse eid="REV 21:13"/><verse number="14" style="v" sid="REV 21:14"/>नगर को परकोट को बाहेर को रद्दा गोटा को होतीन, उन पर मेढ़ा को बारा पेरीतगीन को नाव होतीन। <verse eid="REV 21:14"/><verse number="15" style="v" sid="REV 21:15"/>जोन सरगदूत, मोरो लक गोस्टी करत होता। वोको जवर सोन्नो को नापन को एक छड़ी होतो। जोनलक वा सहेर को बेसकुड़ अना परकोट ला नाप सकेत। <verse eid="REV 21:15"/><verse number="16" style="v" sid="REV 21:16"/>नगर को निरमान चौरस होती। ओको लम्बाई अना चौड़ाई बराबर होतो। वा नगर ला यो नाप लक नापीन नगर को नाप दूई हजार दुई सौ बीस किलोमीटर लम्बो, एतरोच चौड़ो, अना एतरोच उचो होती। <verse eid="REV 21:16"/><verse number="17" style="v" sid="REV 21:17"/>तबा ओना दिवाल ला नापीस। उ पैंसठ मीटर होती। योच माप सरगदूत की भी होती। <verse eid="REV 21:17"/><verse number="18" style="v" sid="REV 21:18"/>ओको परकोट सुरज को लालमनी अना नगर सुध्द सोन्नो को बनयो होतो। जोकि चमक निरमल काँच को जसो होती। <verse eid="REV 21:18"/><verse number="19" style="v" sid="REV 21:19"/>बाड़ा को नींव को दिवाल हरेक प्रकार को कीमती पत्थरगीन लक सजायो गयो होती। पहलो पत्थर सुरज को कान्ति, दुसरो नीलकान्त, तीसरो स्फिटक, चौथो पन्ना <verse eid="REV 21:19"/><verse number="20" style="v" sid="REV 21:20"/>पाँचवो गोमेद, छटवा मनी, सातवां स्वरनमनी, आठवां हरितमनी नवाँ पुखराज; दसवां चन्द्रकान्त; ग्यारहवाँ धुरमकान्त अना बारहवाँ नीलम। <verse eid="REV 21:20"/><verse number="21" style="v" sid="REV 21:21"/>नगर को बारा बेसकुड़ मा बारा मोती होतीन। हरेक बेसकुड़ मा एक मोती होतो। अना नगर को मुख रास्ता सुध्द सोन्नो को बनयो होतो, जोकी चमक निरमल काँच को जसी होती।<verse eid="REV 21:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="REV 21:22"/>यो नगर मा मोला कोनी मंदिर नही चोवयो, काहेकि खुदच ताकत वर पिरभु परमेस्वर अना मेढ़ा एको मंदिर से। <verse eid="REV 21:22"/><verse number="23" style="v" sid="REV 21:23"/>नगर ला उजाडो देवन लाई न ता सुरज को जरुरत से, नाच चन्दा को काहेकि परमेस्वर को तेज ओला उजाड़ा देवासे अना खुदच मेढ़ा एको दियो से। <verse eid="REV 21:23"/><verse number="24" style="v" sid="REV 21:24"/>देस ओको रोसनी मा रव्हसे अना धरती को राजा ऐमा आपरो महिमा आनहेत। <verse eid="REV 21:24"/><verse number="25" style="v" sid="REV 21:25"/>दिवस को बुड़नो मा नगर को बेसकुड़ कभीच बंद नही कियो जाहेत। काहेकि यहान रात कभी च नही होयेत। <verse eid="REV 21:25"/><verse number="26" style="v" sid="REV 21:26"/>सबच देस गीन को महिमा, अना मान ऐमा आनयो जाहे। <verse eid="REV 21:26"/><verse number="27" style="v" sid="REV 21:27"/>कोनी भी असुध्द चीज यो नगर मा ना ता धस पाहेत, ना च उ, जेनको सुभाव सरमनाक अना गोस्टी झुठो लक भरी सेति, ऐमा धस पायेत, जिनको नाव मेढ़ा को जिंदगानी को किताब मा लिखयो से।<verse eid="REV 21:27"/></para>
  <chapter eid="REV 21"/>
  <chapter number="22" style="c" sid="REV 22"/>
  <para style="s">जीवन को नदी</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 22:1"/>ऐको मंघा ओना सरगदुत ना मोला जिंदगी को पानी को नदी दीसायो, जोन स्फिटक को जसो निरमल, अना वोमा आरपार दिसत होतो, जोन परमेस्वर अना मेढ़ा को सिघासन लक हिटके, <verse eid="REV 22:1"/><verse number="2" style="v" sid="REV 22:2"/>यो नदी नगर को मुख रास्ता लक होतो बोहत होतो। नदी को दुही कना जीवन को झाड़ से। जिनमा बारा परकार को फर पैदा होसेत। यो झाड़ हर मास फर देसेत। यो झाड़ को पान गीन मा देस ला चँगा करन की ताकत से।<verse eid="REV 22:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="REV 22:3"/>अता लक वहान सराप नाहती। परमेस्वर अना मेढ़ा को सिघासन ओनो नगर मा सेत। उनको दास उनको भगती करयेत। <verse eid="REV 22:3"/><verse number="4" style="v" sid="REV 22:4"/>वय उनको चेहेरा ला दिसेत अना उनको नाव उनको मस्तक पर लिखो होहे। <verse eid="REV 22:4"/><verse number="5" style="v" sid="REV 22:5"/>वहान अता लक रात होहेत नही। नाच ता उनला दियो को उजाड़ा को जरुरत होहे अना नाच सूरज को उजाड़ा, काहेका खुदच पिरभु परमेस्वर उनको उजाडो होहे। उ सदा राज करेहेती।<verse eid="REV 22:5"/></para>
  <para style="s">मसीह यीसु को जवर आवता आवनो</para>
  <para style="p">
    <verse number="6" style="v" sid="REV 22:6"/>तबा सरगदूत ना मोला सांगीस, “उ दास खरो अना भरोसा लायक से। पिरभु ना जो भविस्यवक्ता गीन को आतमा को परमेस्वर से। आपरो सरगदूत ला आपरो भविस्यवक्ता गीनको कठा उ सब दिसावन ला धाड़ीसेस। जोको लवकर पूरो होवनो जरुरी से।”<verse eid="REV 22:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="REV 22:7"/>चोवो, मि लवकर आवनवालो सेव! धन्य सेत उ जो येने किताब को भविस्यवानी को गोस्टी मानासे।<verse eid="REV 22:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="REV 22:8"/>चोवो, मि योहन वाच सेउ। जो ना खुदच यो सब आयकयो, अना चोवीसेऊ। यो सब आयकन अना दिसन पर, मि ओना सरगदूत ला नमस्कार करके ओको पाय मा पड़ गयो, जोना मोला यो सब दिसायो होतो। <verse eid="REV 22:8"/><verse number="9" style="v" sid="REV 22:9"/>पर ओना मोरो लक सांगीस, “चौव, असो नोको कर! काहेकि मि तोरो अना तोरो भाऊ भविस्यवक्ता गीन, अना ऐना किताब को गोस्टी ला मानन वालो को संगी दास सेउ। परमेस्वर च ला नमस्कार कर।” <verse eid="REV 22:9"/><verse number="10" style="v" sid="REV 22:10"/>मंग ओना मोला कहीस, “ऐना किताब को भविस्यवानी ला सील नोको करस काहेकि बेरा जवर से। <verse eid="REV 22:10"/><verse number="11" style="v" sid="REV 22:11"/>जो अन्याव करासे, उ अन्याव ही करत रह; अना जो मलिन से, उ मलिन बनयो रह; अना जो न्यायी से उ न्यायी बनयो रह अना जो पवीतर सेउ पवीतर बनयो रह।”<verse eid="REV 22:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="REV 22:12"/>चोव, मि लवकर आवनवारा सेव। अना हरेक काम को जसो बदला देवन को लाई प्रतिफर मोरो जवर से। <verse eid="REV 22:12"/><verse number="13" style="v" sid="REV 22:13"/>मि, पयलो अना आखीर, आदि अना अन्त सेव।<verse eid="REV 22:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="REV 22:14"/>धन्य सेत वय, जो आपरो कपरा धोय लेसेत, काहेकि उनला जिंदगी को झाड़ को जवर आवन को हक मिलेह। अना वय बेसकुड़ लक होयके नगर मा धस जाहेत। <verse eid="REV 22:14"/><verse number="15" style="v" sid="REV 22:15"/>पर कुतरा अना टोनहा अना छिंडरावारा अना खूनी अना मुरत पुजा करनवारा, अना हरेक झुठो को चहेतो अना बनानवारा बाहेर रह।<verse eid="REV 22:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="REV 22:16"/>मोला यीसु ना आपरो सरगदूत ला एकोलाय धाड़ियो। की तुमरो पुढ़ा कलीसिया ला एको बारे मा गवाही देव। उ कव्हसेत मि दाऊद को जड़ अना खानदान अना भोर को चमकत हुयो तारा सेव।<verse eid="REV 22:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="REV 22:17"/>आतमा अना नौरी दुही सांग सेत, “आव।”</para>
  <para style="p" vid="REV 22:17">अना आयकन वालो भी कहे, आव!</para>
  <para style="p" vid="REV 22:17">“जो तहान से उ आय अना जो कोनी चाहे उ जिंदगी को पानी फुकट मा लेहे।”<verse eid="REV 22:17"/></para>
  <para style="s">निचोड़</para>
  <para style="p">
    <verse number="18" style="v" sid="REV 22:18"/>मि हरेक ला, जो ऐना किताब को भविस्यवानी को गोस्टी आयकसे, गवाही देवसु अदी कोनी मानूस ऐना गोस्टीहुन मा काही बढ़ाय ता परमेस्वर ओना मुसीबत गीन ला, जो ऐना किताब मा लिखी से, ओको पर बढ़ाये।<verse eid="REV 22:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="REV 22:19"/>अदी कोनी ऐना भविस्यवानी को किताब को गोस्टी मा लक काही हेड़ डाकेह, ता परमेस्वर ओना जिंदगी को झाड़ अना पवीतर नगर मा लक, जेनको बयान ऐना किताब मा से, ओको पराय हेड़ देहे।<verse eid="REV 22:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="REV 22:20"/>जो ऐना गोस्टी को गवाही देवासे उ यो कव्हसे, “हव, मि जल्दीच आवनवालो सेव।” आमेन। हे पिरभु यीसु आव!<verse eid="REV 22:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="REV 22:21"/>पिरभु यीसु को दया पवीतर लोकगीन को सँग रव्हे। आमीन।<verse eid="REV 22:21"/></para>
  <chapter eid="REV 22"/>
</usx>
