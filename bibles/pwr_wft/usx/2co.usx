<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="2CO" style="id">- Powari Standard Project</book>
  <para style="h">2 कुरिन्थियो</para>
  <para style="toc3">2 कुरिन्थियो</para>
  <para style="toc2">2 कुरिन्थियो</para>
  <para style="toc1">दुसरो कुरिन्थियो को नाव पौलुस को चिठ्ठी</para>
  <para style="mt2">दुसरी कुरिन्थियो के नाव पौलुस का पतर</para>
  <para style="mt1">दुसरो कुरिन्थियो को नाव पौलुस की चिठ्ठी</para>
  <para style="imt">परिचय</para>
  <para style="ip">या चिठ्ठी पेरीत पौलुस न यीसु मसीह को जनम को 55-56 साल बाद लिख्यो। <char style="xt"><ref loc="2CO 1:1">1:1</ref></char> या दोय चिठ्ठी मा लक यो दूसरी चिठ्ठी आय। लगत विदवान असो समजा से का या चिठ्ठी को पहिले कुरिन्थियों ला एक लगत कठोर चिठ्ठी लिखी गयी होती। <char style="xt"><ref loc="2CO 2:3-4">2:3-4</ref></char>, यो वचन म या चिठ्ठी को बारे म उल्लेख करयो से। बल्की या चिठ्ठी को फोटु कापी हमरो जवर नहाय। या दूसरी कुरिन्थियों की चिठ्ठी पौलुस न मकिदुनिया मा लक लिख्यो होतो। <char style="xt"><ref loc="2CO 2:13">2:13</ref></char></para>
  <para style="ip">दूसरी कुरिन्थियों की चिठ्ठी की बिसेसता या से की यो मानूस गीनको भावनात्मक गोस्टी को चरचा करयो गयो, या चिठ्ठी मा पौलुस खुसी मनायो से का या चिठ्ठी मा जोन समस्या कुरिन्थियों को बारेमा तीतुस लक हासिल करयो खुसी ला जाहीर कर रहयो, या चिठ्ठी देवन को बारे मा बिस्तार को सिक्सा नवा करार को दिरस्टिकोन मा दियो गयो से। या सिक्सा वा विभाग मा पौलुस पैसा को दान को उल्लेख करयो से अखिन यरूसलेम मा बिस्वासी गीनको मदद लायी लिख्यो गयो होतो, <char style="xt"><ref loc="2CO 8-9">8—9</ref></char> या मन्डली मा काही लोक पौलुस को विरोध मा होतो। अखिन काही बाहेर को आयो हुयो झूठो पेरीत यो विरोध को फायदा उठाय के पौलुस ला दबाय का खुदला बढ़ाय रह्यो होतो। उनना पौलुस को अधिकार पर सवाल करयो। येकोलायी या चिठ्ठी को आखरी हिस्सा मा अपरो अधिकार ला यीसु मसीह मा पेरीत होवन को नाता लक जोन अधिकार भेटयो से उ अधिकार पर जोर देवा से। अखिन ओको पर दावा ठोकयो से।</para>
  <para style="iot">रूपरेखा</para>
  <para style="io1">1. पौलुस ला आपरो मन्डली को सुरूवात मा नमस्कार करयो से। <char style="ior"><ref loc="2CO 1:1-17">1:1-17</ref> </char></para>
  <para style="io1">2. पौलुस अपनी यातरा की योजना म बदलाव करयो ओना जोन समस्या कुरिन्थियो को बारे मा भेटयो होती अखिन पिछली कठोर चिठ्ठी जेनको बारे म उनना सवाल पैदा करयो होतो ओको बारे मा बतायो से। <char style="ior"><ref loc="2CO 1:8-7:16">1:8—7:16</ref> </char></para>
  <para style="io1">3. यरूसलेम म रहन वालो बिस्वासी लायी दान जमा करन को बारे या पौलुस को सुचना। <char style="ior"><ref loc="2CO 8:1-9:15">8:1—9:15</ref> </char></para>
  <para style="io1">4. आखरी मा पौलुस अपरो पेरीत पन को बचाव करय हय अखिन अपनी आवन वाली भेंट को बारे मा चेतावनी। <char style="ior"><ref loc="2CO 10:1-13:10">10:1—13:10</ref> </char></para>
  <chapter number="1" style="c" sid="2CO 1"/>
  <para style="p">
    <verse number="1" style="v" sid="2CO 1:1"/>अखया कुरिन्थुस नगर मा परमेस्वर यीसु मसीह को कलीसिया अना सबा युनान देस को रहवासी सबा पवीतर संतहुन को नाव पौलुस जोन परमेस्वर को मनसा को कन लक पेरीत सेत, अना भाऊ तीमुथियुस को चिठ्ठी। <verse eid="2CO 1:1"/><verse number="2" style="v" sid="2CO 1:2"/>आमरो परमेस्वर बाबूजी, अना पिरभू यीसु मसीह तुमी लोकगीन ला दया अखीन सान्ती भेटेत।<verse eid="2CO 1:2"/></para>
  <para style="s">परमेस्वर ला धनवाद</para>
  <para style="p">
    <verse number="3" style="v" sid="2CO 1:3"/>धन्य सेत परमेस्वर, आमरो पिरभू यीसु मसीह को बाबूजी, उ दयालु अना सब परकार को सान्ती को परमेस्वर सेत। <verse eid="2CO 1:3"/><verse number="4" style="v" sid="2CO 1:4"/>उ सब दुख मा अमीला, सान्ती देतो रव्हसेत। जोन लक, परमेस्वर को कन लक, अमीला जोन सान्ती भेटासेत, वोच को लक आमी दुसरो ला भी, उनको हरेक दुख मा सान्ती देवन को ताकत अमीला मिल जाय। <verse eid="2CO 1:4"/><verse number="5" style="v" sid="2CO 1:5"/>काहेका जसो मसीह को दुख आमरो जिंदगी मा लगत सेत वसोच आमरो जिंदगानी मा वोको सान्ती भी लगत सेत। <verse eid="2CO 1:5"/><verse number="6" style="v" sid="2CO 1:6"/>अदी अमी दुख उचलबिन, ता वा तुमरो खुसी अना सूटकारा को लाय सेत। यदि अमी खुसी सेजन। ता तुमरो खुसी लाय सेत। यो खुसी उन दुख गिनला जोन अमी सह रह्यो सेजन। तुमिला धिरज को संग सहन करन को ताकत देवा सेत। जसो का अमीला जोस देवासेत। <verse eid="2CO 1:6"/><verse number="7" style="v" sid="2CO 1:7"/>तुमरो बारेमा अमिला पुरो आस सेत काहेका अमीला मालुम सेत का जसो आमरो दुख ला बाटा करा सो, वसोच आमरो खुसी मा भी तुमरो बाटा सेत।<verse eid="2CO 1:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="2CO 1:8"/>अगो संगीहुन अमी यो चव्हा सेजन का तुमी वा दुख को बारेमा जानो जोन अमिला एसिया मा झेलनो पड़ीयो होतो। वहान आमरो सहनो सक्ती लक बाहेर होतो। वा दुख को बोझा मा अमी दब गयो होता। यहाँन तकन का आमरो जित्तो रव्हन को चारा नोहोतो <verse eid="2CO 1:8"/><verse number="9" style="v" sid="2CO 1:9"/>हव! आपरो-आपरो मन मा अमिला असो लगत होतो, जसो अमिला मरनो को हुकूम भयी गयो सेत। जोन लक अमी आपरो आप पर नही पर परमेस्वर को भरोसा भयि गयो जोन मरयो हुवो ला जित्तो करा सेत। <verse eid="2CO 1:9"/><verse number="10" style="v" sid="2CO 1:10"/>अमी वोना भयानक मिरतु लक परमेस्वर ना बचायो अना आमरो अबा को बेरा मा भी वोच बचा हेत। आमरो आस वोकोमा टिकयो सेत। <verse eid="2CO 1:10"/><verse number="11" style="v" sid="2CO 1:11"/>अदि तुमी आमरो कन लक पिराथना करके सहयोग देवने। ता अमिला लगत सो लोकगिन को पिराथना लक, परमेस्वर को जोन किरपा भेटयो सेत। वोको लाय लगत सो लोक गिनला, आमरो कन लक धनवाद देवन को कारन मिल जाहेत।<verse eid="2CO 1:11"/></para>
  <para style="s">पौलुस को यातरा मा बदलाव</para>
  <para style="p">
    <verse number="12" style="v" sid="2CO 1:12"/>हमला एको गरब से, का यो गोस्टी अमी सफा मन लक कव्हा सेजन। का अमिना यो जगत को संग अना खास तुमरो संग परमेस्वर को किरपा को साथ बरताव करयो सेजन। हमिना ईमानदारी अना खराई लक बरताव करी सेजन। जोन परमेस्वर लक भेटा सेत। दुनिया को अक्कलवरी लक नही। <verse eid="2CO 1:12"/><verse number="13" style="v" sid="2CO 1:13"/>हमी तुमला अखीन काही नही लिखीसेजन बस उ जोन तुमी बाचिसेव अना मानासो, अना मोला असो आस सेत का आखीर तकन मानतो रव्हजोस। <verse eid="2CO 1:13"/><verse number="14" style="v" sid="2CO 1:14"/>जेनको लक तुमी न काही-काही समजा सेत, का जसो हमी तुमरो गरब को कारन से वसोच तुमी भी हमरो पिरभू यीसु को दिवस मा हमरो पर गरब ठहरयो जाहे।<verse eid="2CO 1:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="2CO 1:15"/>एनाच भरोसा को संग मोरो लक पयले तुमरो जवर आवन को पक्को होतो क तुमी दुसरी बेरा किरपा पाय सको। <verse eid="2CO 1:15"/><verse number="16" style="v" sid="2CO 1:16"/>अना मी तुमरो जवर होतो मकीदुनिया देस जाऊ अना मकीदुनिया लक मंग तुमरो जवर आहू अना तुमरो यहुदिया की यातरा को लाई मदद पाहेत। <verse eid="2CO 1:16"/><verse number="17" style="v" sid="2CO 1:17"/>जबा मीना असो पक्को करयो त का मी दुविधा<note caller="+" style="f"><char style="fr" closed="false">1:17 </char><char style="ft" closed="false">संकट मा</char></note> मे होतो? अना जोन मा पक्को करासेऊ का उ देह को अनूसार करासेऊ का एकच बेरा मा हव-हव कँहू अना नही-नही भी? <verse eid="2CO 1:17"/><verse number="18" style="v" sid="2CO 1:18"/>जसो का परमेस्वर भरोसा को लायक से वसोच तुमरो लाई हमरो बचन मा हव अना नही दुई एको संग नही पायो जाहेत। <verse eid="2CO 1:18"/><verse number="19" style="v" sid="2CO 1:19"/>काहेकी परमेस्वर को टूरा यीसु मसीह मा जोको परचार तुमरो बीच हमरो अना सिलवानुस, तीमुथियुस<note caller="+" style="f"><char style="fr" closed="false">1:19</char><char style="ft" closed="false">पौलुस को एक चेला </char></note> अखीन मीना करयो, वोको कबच हव अना कबच नही से वरन उनमा सिरप हव से। <verse eid="2CO 1:19"/><verse number="20" style="v" sid="2CO 1:20"/>काहेकी परमेस्वर की जेतरी भी परन सेत। वा सप्पा यीसु मा हव से एको लाई वोको कन हमारो आमेन भी परमेस्वर की महिमा को लाई होय। <verse eid="2CO 1:20"/><verse number="21" style="v" sid="2CO 1:21"/>अबा जोन तुमरो संग हमी मसीह मा पक्को करासे अना जेना हमला निवाड़ी सेस। उ परमेस्वर से। <verse eid="2CO 1:21"/><verse number="22" style="v" sid="2CO 1:22"/>परमेस्वर ना आमरो पर आपरो मूहर लगाई सेत, अना बियाना को रुपमा आमरो दिल मा आतमा देइसेत।<verse eid="2CO 1:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="2CO 1:23"/>परमेस्वर गवाह सेत मी आपरो जिंदगी को किरिया सांग सेऊ। का मी यो काजी अब तकन कुरिन्थुस नही आईसेव का मी तुमीला दुख बचायो राखनो चाव्हत होतो। <verse eid="2CO 1:23"/><verse number="24" style="v" sid="2CO 1:24"/>असो गोस्टी नाहती का आमी तुमरो भरोसा को बारेमा हक जमानो चाव्हासेजन, पर आमी तुमरो खुसी मा संग काम करनवारा सेजन काहेका तुमरो भरोसा पक्को से।<verse eid="2CO 1:24"/></para>
  <chapter eid="2CO 1"/>
  <chapter number="2" style="c" sid="2CO 2"/>
  <para style="p">
    <verse number="1" style="v" sid="2CO 2:1"/>एकोलाय मीना आपरो आप मा यो तय कर लेईसेव, का तुमी लोक गिनला दुबारा दुख देवन साठी मी तुमरो बीचमा नोको आऊ।<note caller="-" style="x"><char style="xo" closed="false">2:1 </char><char style="xt" closed="false"><ref loc="1CO 4:21">1 कुरिन्थियो 4:21</ref>; <ref loc="2CO 12:21">2 कुरिन्थियो 12:21</ref></char></note> <verse eid="2CO 2:1"/><verse number="2" style="v" sid="2CO 2:2"/>काहेका अदी मि तुमी लोक गिनला दुखी करीन, मंग मोला सुखी कोन करहेत? सिवाय तुम जोनला मीना दुखि करिसेऊ। <verse eid="2CO 2:2"/><verse number="3" style="v" sid="2CO 2:3"/>अना योच गोस्टी मीना तुमिला एकोलाय लिखी सेऊ, का जबा मी तुमरो जवर आहिन, ता जोन लक मोला खुसी मीलनो से, उनको लक मोला दुख ना पोहचायो जाय। मोला तुमी सब मा यो गोस्टी को भरोसा सेत, का जोन मरो खुसी सेत वा तुम सब को सेत। <verse eid="2CO 2:3"/><verse number="4" style="v" sid="2CO 2:4"/>काहेका मीना तुमीला यो गोस्टी दुखी दिल लक, डोरा लक पानी बोहाय-बोहाय के लिखि सेउ। यो साठी नाहय का तुमला दुख लगे, पर यो साठी सेत, का तुम यो जान सको का मी तुमरो लक कितरो माया राखासू।<note caller="-" style="x"><char style="xo" closed="false">2:4 </char><char style="xt" closed="false"><ref loc="ACT 20:31">पेरीत 20:31</ref></char></note><verse eid="2CO 2:4"/></para>
  <para style="s">गुनागार ला माफी</para>
  <para style="p">
    <verse number="5" style="v" sid="2CO 2:5"/>पर अदि कोनी न दुख देईसेत, त वोनो मोला नही, पर काही-काही तुमी सबच ला भी दुख देई सेत।<note caller="-" style="x"><char style="xo" closed="false">2:5 </char><char style="xt" closed="false"><ref loc="1CO 5:1">1 कुरिन्थियो 5:1</ref></char></note> <verse eid="2CO 2:5"/><verse number="6" style="v" sid="2CO 2:6"/>असो मानूस ला जोन दन्ड तुमरो दल ना देई सेत, उतरो च लगत सेत। <verse eid="2CO 2:6"/><verse number="7" style="v" sid="2CO 2:7"/>एको लाई उलटो तुमी वोला माफी दे देव, अना सान्ती देव, काहेका असो नोको होय का उ लगत सोक मा डूब जाय। <verse eid="2CO 2:7"/><verse number="8" style="v" sid="2CO 2:8"/>एको लाई मोरो तुमरो लक बिनती से का तुमी वोला अपरो पिरेम को पुरुप देवो। <verse eid="2CO 2:8"/><verse number="9" style="v" sid="2CO 2:9"/>यो मीना तुमला यो चोवन लाय लिखीयो सेऊ। का तुमी परखा सेऊ का हर गोस्टी मा, हुकूम मानन वालो सेव का नही? <verse eid="2CO 2:9"/><verse number="10" style="v" sid="2CO 2:10"/>जबा तुमी कोनी ला माफी देवा सेव, तो उनना जोन काही कियो सेत वोला मी भी माफ करा सेऊ। जबा मी छिमा करा सेऊ, ता सहीमा मी मसिहा को हाजीर मा माफ करा सेऊ। काहेका तुम पर सैतान को जोर नोको चले।<note caller="-" style="x"><char style="xo" closed="false">2:10 </char><char style="xt" closed="false"><ref loc="LUK 10:16">लूका 10:16</ref></char></note> <verse eid="2CO 2:10"/><verse number="11" style="v" sid="2CO 2:11"/>काहेका भीतरी गोस्टी अमीला मालूम नाहती का सैतान को काजक योजना सेत।<verse eid="2CO 2:11"/></para>
  <para style="s">तरोआस मा पौलुस की चिंता अना आराम</para>
  <para style="p">
    <verse number="12" style="v" sid="2CO 2:12"/>जबा मी मसीह को साजरा बारता आयकावन को लाई तोराआस आयो, अना पिरभू न जबा मोरो लाई बेसकुड़ उघाडो। <verse eid="2CO 2:12"/><verse number="13" style="v" sid="2CO 2:13"/>तबा अपरो भाऊ तितुस ला नही पायके मोरी आतमा मा चैन नही लग्यो, अना वोला सार होयके मी मकीदुनिया को कना चली गयो।<verse eid="2CO 2:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="2CO 2:14"/>पर परमेस्वर को धनवाद होय, जोन मसीह को कन लक अपरो जीत को खुसी मा हमारो देख-रेख करत होतो। अना हमरो कन लक अपरो अक्कल की मीठ्ठो खुसबू हर जघा फैलावा से। <verse eid="2CO 2:14"/><verse number="15" style="v" sid="2CO 2:15"/>काहेकि बचनवालो अना नास होवन वालो, दुई को लाई परमेस्वर को पक्को अमीच मसीह को खुसबू सेत। <verse eid="2CO 2:15"/><verse number="16" style="v" sid="2CO 2:16"/>उन लोक गिनको लाय, जोन नास को रस्ता मा सेत, मरन को बदबू सेत। जोन उनला मार डाकेत। परा बचायो हुयो लोक गिनको लाय, एक खुसबो जसो सेत। जो जिंदगी देवा सेत। परा यो काम को लाय कोन साजरो सेत? <verse eid="2CO 2:16"/><verse number="17" style="v" sid="2CO 2:17"/>परमेस्वर को बचन ला लोकगिन जसो मिलावट करके बिकन वालो जसो अमी नही सेजन। परअ परमेस्वर ना अमीला धाड़ी सेत, का वोको हाजरी मा ईमानदारी लक वोको बचन ला सांगनो सेत।<verse eid="2CO 2:17"/></para>
  <chapter eid="2CO 2"/>
  <chapter number="3" style="c" sid="2CO 3"/>
  <para style="p">
    <verse number="1" style="v" sid="2CO 3:1"/>का हमी मंग अपरी सीपारिस करन लगबीन? अना मानूस गीन को जसो का हमी भी तुमरो लक सीपारिस की चिठ्ठी लेवन अना तुमला देनो जरुरी से। <verse eid="2CO 3:1"/><verse number="2" style="v" sid="2CO 3:2"/>हमारो चिठ्ठी त तुमला च होय जाहे हमरो हिरदय मा लिखी से अना जेनला सबच लोक जानासेत अना वाचासेत। <verse eid="2CO 3:2"/><verse number="3" style="v" sid="2CO 3:3"/>अना असो पिरगट करयेत का मसीह की चिठ्ठी तुमी सेव जेकी देख-रेख अना जोन त स्याही लक नही अखीन न गोटा की पाटी पर जित्तो परमेस्वर की आतमा लक मानूस को देह हिरदय<note caller="+" style="f"><char style="fr" closed="false">3:3</char><char style="ft" closed="false">दिल मा सेत</char></note> पर लिखयो गयो से।<verse eid="2CO 3:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="2CO 3:4"/>अना मसीह को कन लक परमेस्वर पर हमी असोच भरोसा राखीसेजन। <verse eid="2CO 3:4"/><verse number="5" style="v" sid="2CO 3:5"/>असो नहाय का हमी अपरो आप ला एना काबील समझा सेजन का हमी खुदच काही कर सकासेजन पर अमीला काबिल बनावन वारा परमेस्वर से। <verse eid="2CO 3:5"/><verse number="6" style="v" sid="2CO 3:6"/>जोनना अमीला नवा करार को दास होवनको काबिल बनाइसेस, यो लिख्यो करार नाहती पर आतमा को करार सेत काहेका लिखयो सबद मारसेत पर आतमा जित्तो करासेत सेत।<verse eid="2CO 3:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="2CO 3:7"/>पर अदी मरन को यो करार<note caller="+" style="f"><char style="fr" closed="false">3:7 </char><char style="ft" closed="false">नियम</char></note> जेन को सबद गोटा को पटिया मा लिख्यो सेत, एतरो तेज बनके आयो का इसरायली गीन मोसे को तोन्ड को तेज ला जो घटत होतो, नही चोव सकिन। <verse eid="2CO 3:7"/><verse number="8" style="v" sid="2CO 3:8"/>तो मग आतमा को करार अना तेज कसो ना होयेत? <verse eid="2CO 3:8"/><verse number="9" style="v" sid="2CO 3:9"/>काहेका जबा दोसी ठहरावन वालो करार तेज से त नेक ठहरावन वालो करार अखीन लगत तेज होय जासे। <verse eid="2CO 3:9"/><verse number="10" style="v" sid="2CO 3:10"/>सहीमा उ जोन तेज होत्यो अता वोना तेज को पुड़ा जोन वोको लक बढकेन तेज से उ कम होय जाहे। <verse eid="2CO 3:10"/><verse number="11" style="v" sid="2CO 3:11"/>काहेका अदी उ कम होवन वालो तेज होत्यो त उ जोन पक्को से अखीन लगत तेज से।<verse eid="2CO 3:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="2CO 3:12"/>असो आस होवन को कारन हमी मोठो हिम्मत लक बोला से। <verse eid="2CO 3:12"/><verse number="13" style="v" sid="2CO 3:13"/>अना आमी मोसे को जसो नही जोन अपरो चेहेरा पर सेव डाकयो राखत होत्यो का इसरायल की आवलाद<note caller="+" style="f"><char style="fr" closed="false">3:13 </char><char style="ft" closed="false">खानदान</char></note> एकटक होयके उ लोप होतो हुयो तेज को अंत ला नही देख सके। <verse eid="2CO 3:13"/><verse number="14" style="v" sid="2CO 3:14"/>पर उनको मन कड़ो भय गयो काहेकी अबा भी एना जुनो करार ला परदा उ सेव संची पढ़यो रहयो काहेकी उ बल्कि मसीह मा हटायो जाहे। <verse eid="2CO 3:14"/><verse number="15" style="v" sid="2CO 3:15"/>आज को दिवस जबा कदी मोसे को नियम पढ़यो जावासेत। तो उनको दिल सेव लक ढकयो रव्ह सेत। <verse eid="2CO 3:15"/><verse number="16" style="v" sid="2CO 3:16"/>पर जबा कदी कोनी मानूस पिरभू कन आपरो मनला लगाव सेत, तो वोना सेव हट जावा सेत। <verse eid="2CO 3:16"/><verse number="17" style="v" sid="2CO 3:17"/>अबा यो पिरभू तो आतमा सेत, अना जितानी पिरभू को आतमा सेत उता कोनी बन्धन नाहती। <verse eid="2CO 3:17"/><verse number="18" style="v" sid="2CO 3:18"/>पर आमी सबा उघाडो तोन्ड लक पिरभू को तेज जसो आरसा मा चोवतो हुया पिरभू मजे आतमा लक आमी वोको तेजपन को रुप मा जरा-जरा करके बदलत जावासेत।<verse eid="2CO 3:18"/></para>
  <chapter eid="2CO 3"/>
  <chapter number="4" style="c" sid="2CO 4"/>
  <para style="s">माती को भान्डो मा आतमिक खजानो</para>
  <para style="p">
    <verse number="1" style="v" sid="2CO 4:1"/>यीसु को दया लक परमेस्वर ना अमीला यो सेवा करन काजी देइसेस, अना एकोलाय आमी बेआस नको होहे सेजन। <verse eid="2CO 4:1"/><verse number="2" style="v" sid="2CO 4:2"/>अमिना सबच लुकयो अना लाज को काम लक बेगरो भईसेजन, आमी कोनी धोका को काम नही करतत, ना आमी परमेस्वर को बचन ला खोटो साबीत करसेजन। अना खराई लक आमी परमेस्वर को डोरा को पुड़ा रव्हसेजन। हरेक को डिमाक लक भलाई करन को कोसीस मा रव्हसेजन <verse eid="2CO 4:2"/><verse number="3" style="v" sid="2CO 4:3"/>आमी जोन साजरा बारता सांगीसेजन, अगर उ परदा<note caller="+" style="f"><char style="fr" closed="false">4:3 </char><char style="ft" closed="false">लुकयो सेत मजे समझमा नही आवासेत</char></note> सेत तो सिरप वोना लोकगीन काजी सेत जोन गुम गयो सेत। <verse eid="2CO 4:3"/><verse number="4" style="v" sid="2CO 4:4"/>काहेका अबिस्वासी गीन को डिमाक ला यो दुनिया को दुस्ट देव ना अंधार मा ठेविसेत। उ वोना पर उजाड़ होवन काजी रोकसेत। जो साजरा बारता लक मसीह को बारे मा आवासे, यीसु मसीह जनमन परमेस्वर को रुप जसो सेत। <verse eid="2CO 4:4"/><verse number="5" style="v" sid="2CO 4:5"/>काहेका आमी खुदच को परचार नही करसेजन, पर आमी पिरभू यीसु मसीह ला परमेस्वर को रुप मा परचार करसेजन। अना आपरो बारेमा असो कव्हसेजन का आमी यीसु को कारन तुमारो दास सेजन। <verse eid="2CO 4:5"/><verse number="6" style="v" sid="2CO 4:6"/>परमेस्वर ना कव्हयो “अँधार मा उजाड भई जाहेत” जोन आमरो दिल मा उजाडो करासेत। ताकी अमीला यीसु मसीह को तोंड मा चमकत हुया परमेस्वर को महिमा को गियान भेटेत।<verse eid="2CO 4:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="2CO 4:7"/>पर आमी माती को भान्डो<note caller="+" style="f"><char style="fr" closed="false">4:7 </char><char style="ft" closed="false">माती को बरतन</char></note> सेजन। अना आमी मा यो धन यो काजी ठेवो गई सेत का यो ताकत को बड़कपन आमरो कन लक नही पर परमेस्वर को कन लक से असो मालुम भई जाये। <verse eid="2CO 4:7"/><verse number="8" style="v" sid="2CO 4:8"/>आमी कई गन परेसानी मा होत रहया लेकिन नास नही भयो; कभी-कभी संका मा रहया लेकिन निरास नही रहया; <verse eid="2CO 4:8"/><verse number="9" style="v" sid="2CO 4:9"/>कई बैरी सेति लेकिन आमी कबच दोस्त को बगैर नही रहया; अना कई गन बुरो तरह ठोस लगी अखीन नास नही हुया। <verse eid="2CO 4:9"/><verse number="10" style="v" sid="2CO 4:10"/>कई गन जबा आमी आपरो पिरान ला यीसु को मिरतु मा लेय जासेजन, जोको लक आमरो देह मा भी ओको जीवन चोयो जाय सकेह <verse eid="2CO 4:10"/><verse number="11" style="v" sid="2CO 4:11"/>आमरो जिंदगी को मंघा आमी सदा यीसु को लाई मिरतु को खतरा मा सेजन ताकि आमरो जीवन को यो पिरान घातक देह मा ओको जीवन चोयो जाय सकेह। <verse eid="2CO 4:11"/><verse number="12" style="v" sid="2CO 4:12"/>एको मायना<note caller="+" style="f"><char style="fr" closed="false">4:12</char><char style="ft" closed="false">मजे</char></note> से की मिरतु आमरो मा काम कर रही से लेकिन जीवन तुमरो काम मा से।<verse eid="2CO 4:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="2CO 4:13"/>पवीतर गिरंथ कव्हसे, “मिना गोस्टी कियो, काहेका मोला भरोसा होतो।” को एकच आतमा मा आमी भी बोलासेजन कायसेकि आमी भरोसा करसेजन। <verse eid="2CO 4:13"/><verse number="14" style="v" sid="2CO 4:14"/>आमी जानासेजन का परमेस्वर जेने पिरभु यीसु ला जित्तो करिसेत, वाच आमीला यीसु को हिस्सादार समझके जित्तो करयेत। अना आमीला तुमरो सँगा आपरो हाजरी मा ले जाहे। <verse eid="2CO 4:14"/><verse number="15" style="v" sid="2CO 4:15"/>यो सब तुमरो साठी से; अना जसो की परमेस्वर की किरपा लगत स लोकगीन तकन पहुचसे, वय परमेस्वर की बड़ाई को धनवाद देन को साठी लगत पिराथना ला पेस करहेति।<verse eid="2CO 4:15"/></para>
  <para style="s">भरोसा लक रव्हनो</para>
  <para style="p">
    <verse number="16" style="v" sid="2CO 4:16"/>एकोलाय आमी कबच निरास नही हुया, भलो ही आमरो नासवान सरीर धीरे-धीरे नास होवासे, मंग भी आमरो आतमिक देह<note caller="+" style="f"><char style="fr" closed="false">4:16</char><char style="ft" closed="false">भीतरी देह</char></note> दिवस को मंघा नयो रुप कियो जाहे। <verse eid="2CO 4:16"/><verse number="17" style="v" sid="2CO 4:17"/>काहेकि आमरो जरासो देर को दुख आमरो लाई लगतच काम की अना अमर महिमा परगट करत जावसे, <verse eid="2CO 4:17"/><verse number="18" style="v" sid="2CO 4:18"/>काहे की जोन आमी ध्यान लक चोवसेजन ओना पर नही, लेकिन नही चोवन वारा चीज गीन पर आमरो ध्यान लगावा राखासेजन। का चोयो जाय सकसे, केवल एक बेरा को लाई रव्हसे, लेकिन अन चोवो चीज हरामेसा लाई रव्हसे।<verse eid="2CO 4:18"/></para>
  <chapter eid="2CO 4"/>
  <chapter number="5" style="c" sid="2CO 5"/>
  <para style="p">
    <verse number="1" style="v" sid="2CO 5:1"/>काहेकी हमी जानासेजन का अदी हमारो धरती मा का तम्बू मजे देह ला पूरो दिरस घर ला पाड़ दियो जाहे त परमेस्वर कन लक हमला सरग मा घर मिले जोन हात लक बनयो हुयो नही पर अमर सेत। <verse eid="2CO 5:1"/><verse number="2" style="v" sid="2CO 5:2"/>काहेकी एना घर मा त हमी कराहवता अना लगत पक्को आस राखासेजन का अपरो सरग को घर ला पेहर<note caller="+" style="f"><char style="fr" closed="false">5:2</char><char style="ft" closed="false">घाल लेवबोन</char></note> लेवबोन। <verse eid="2CO 5:2"/><verse number="3" style="v" sid="2CO 5:3"/>अखीन एला पेहरके हमी नंगरा नोको पाया जाबोन। <verse eid="2CO 5:3"/><verse number="4" style="v" sid="2CO 5:4"/>सही मा जबा तकन हमी एना तम्बू देह मा सेजन त हमी बोझ लक दबया हुया कराहव सेजन काहेकी हमी कपरा हेड़नो नही पर पेहरनो चाव्हासेजन का जोन कोनी मरनो को जसो से वा जिंदगी लक हेड दियो जाय। <verse eid="2CO 5:4"/><verse number="5" style="v" sid="2CO 5:5"/>अबा जेना हमला एना गोस्टी को लाई तैय्यार करीसेस। उ परमेस्वर से जेना हमला बयाना मा आतमा देईसेस।<verse eid="2CO 5:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="2CO 5:6"/>एको लाई हमी हमेस हिम्मत राखा सेजन अना यो जाना सेजन का जबा तकन हमी देह जसो घर मा रव्ह सेजन पिरभू लक दुहुर सेत। <verse eid="2CO 5:6"/><verse number="7" style="v" sid="2CO 5:7"/>काहेकी हमी रुप चोवयो नही पर भरोसा लक चला सेजन। <verse eid="2CO 5:7"/><verse number="8" style="v" sid="2CO 5:8"/>अना हमी पूरी हिम्मत राखासेजन देह लक अलग होयके पिरभू को संग रहवनो अना उच्चो समझयो जासे। <verse eid="2CO 5:8"/><verse number="9" style="v" sid="2CO 5:9"/>एको लाई हमारो आस योच से का संग मा रहवजन या अलग रव्हजन हमी वोला चाहतो लगासेजन। <verse eid="2CO 5:9"/><verse number="10" style="v" sid="2CO 5:10"/>काहेकी हमी सबच को मसीह को नियाव आसन को पुढ़ा हजीर रव्हनो जरुरी से का हर एक ला अपरो साजरो अना वाइट<note caller="+" style="f"><char style="fr" closed="false">5:10</char><char style="ft" closed="false">खोटो</char></note> काम को दन्ड मिलेत जोन वोना देह लक करयो से।<verse eid="2CO 5:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="2CO 5:11"/>अना हमी पिरभू को भेव मानतो हुयो लोक गीन ला समझावसे पर हमरो हाल परमेस्वर को पुढ़ा परगट से अना मी आस करासेऊ का हमरो यो हाल तुमरो अक्कल मा परगट होवासे। <verse eid="2CO 5:11"/><verse number="12" style="v" sid="2CO 5:12"/>हमी मंग अपरी सबासी तुमरो पुढ़ा नही कर रही से पर तुमला मोका दे रही से का हमरो पर गरब करो अना उनला जवाब देसका सेव जोन मन मा नही चोहे पर घमन्ड करासेव। <verse eid="2CO 5:12"/><verse number="13" style="v" sid="2CO 5:13"/>काहेकी अदी हमी बेसुध से त परमेस्वर को लाई अना अदी जगाया से त तुमरो लाई से। <verse eid="2CO 5:13"/><verse number="14" style="v" sid="2CO 5:14"/>काहेकी मसीह को पिरेम हमला परेसान करासे जेनको लक यो तय से का जबा एक सब को लाई मरयो त सबच मर गईन। <verse eid="2CO 5:14"/><verse number="15" style="v" sid="2CO 5:15"/>अना उ सबच को लाई मर के उ जित्तो से पुढो लाई अपरो लाई नोको जीवो पर वोको लाई जीवो जोन उनको लाई मरके जित्तो भई से।<verse eid="2CO 5:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="2CO 5:16"/>एकोलाय अबा लक हमी कोनी मानूस की देह को अनूसार नही समझेत हमेस हमरो मसीह की देह को जसो जानो से अबा लक हमी वोको असो नही जानयो जाहे। <verse eid="2CO 5:16"/><verse number="17" style="v" sid="2CO 5:17"/>एको लाई अदी कोनी मसीह मा से त उ नवी संसार से जुनी गोस्टी बीत गई देखो नवी गोस्टी आया गई से। <verse eid="2CO 5:17"/><verse number="18" style="v" sid="2CO 5:18"/>अबा यो सबच गोस्टी परमेस्वर को कन लक से जेना मसीह को कन लक हमरो मेल अपरो संग कर लेईन अना हमरो मेल मिलाप की सेवा देईसेस। <verse eid="2CO 5:18"/><verse number="19" style="v" sid="2CO 5:19"/>अना परमेस्वर लोक गीन को अपराध गीन को दोस उनको पर नही लगावते हुयो मसीह मा संसार मा मेल मिलाप अपरो संग कर रहयो होतो अना वोना हमरो मेल जोल को गोस्टी<note caller="+" style="f"><char style="fr" closed="false">5:19 </char><char style="ft" closed="false">गोस्टी</char></note> सौप देइसेस।<verse eid="2CO 5:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="2CO 5:20"/>एको लाई हमी मसीह को दास से मानो का परमेस्वर हमरो कन लक बिनती कर राही से हमी मसीह को कन लक तुमरो लक बिनती करा से का परमेस्वर को संग मा मेल मिलाप कर लेव लेने। <verse eid="2CO 5:20"/><verse number="21" style="v" sid="2CO 5:21"/>जोन पाप लक अनजान होतो वोला च वोना हमरो लाई पाप ठहराइस का हमी वोको मा परमेस्वर की न्यायीपन बन जाहे।<verse eid="2CO 5:21"/></para>
  <chapter eid="2CO 5"/>
  <chapter number="6" style="c" sid="2CO 6"/>
  <para style="p">
    <verse number="1" style="v" sid="2CO 6:1"/>परमेस्वर को संग हमारो काम मा, मंग हमी तुमरो लक बिनती करतत, का कोनी परमेस्वर की किरपा पायके उ नास होय जाहे। <verse eid="2CO 6:1"/><verse number="2" style="v" sid="2CO 6:2"/>आयको परमेस्वर का कव्हासे</para>
  <para style="q1" vid="2CO 6:2">“जबा मोरो लाई आपरी बेरा चोवन लाई आयो,</para>
  <para style="q2" vid="2CO 6:2">त मीना तुमला आयको;</para>
  <para style="q1" vid="2CO 6:2">जबा दिनमा तुमला बचावन को लाई मोरो जवर आयके,</para>
  <para style="q2" vid="2CO 6:2">त मीना अपरी मदद करया।” आयको! यो परमेस्वर को खुसी को बेरा सेत, चोवो अबा उ सूटकारा<note caller="+" style="f"><char style="fr" closed="false">6:2</char><char style="ft" closed="false">सूटकारा</char></note> को दिवससेत।<verse eid="2CO 6:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="2CO 6:3"/>आमी नहीं चाव्हसेजन की कोनी ला भी आमरो सेवा मा दोस मिल जाहे, एकोलाय आमी कोनी ला भी रस्ता मा रोड़ा लावन की कोसिस नहीं कर रही से। <verse eid="2CO 6:3"/><verse number="4" style="v" sid="2CO 6:4"/>एको अलावा, आमी जोन सजरो बरताव काही भी करसेजन आमी चोवासेजन की आमी धीरज लक परेसानी, कठिनाइगीन को धीरज लक परमेस्वर के दास से। <verse eid="2CO 6:4"/><verse number="5" style="v" sid="2CO 6:5"/>कोड़ा खावनो लक, अना जेल जानो लक हल्ला गुला लक महेनत लक चेतया रव्हनो लक उपवास करनो लक। <verse eid="2CO 6:5"/><verse number="6" style="v" sid="2CO 6:6"/>पवीतर लक अक्ल लक धीरज लक किरपा लक पवीतर आतमा लक। सच्चो पिरेम लक <verse eid="2CO 6:6"/><verse number="7" style="v" sid="2CO 6:7"/>सच्चो बचन लक परमेस्वर की ताकत लक नेकीपन को हतियार लक जोन उज्जो अना डावो हात मा से। <verse eid="2CO 6:7"/><verse number="8" style="v" sid="2CO 6:8"/>जस-अपजस मा, मान-बेइज्जति मा, बदनामी अना सजरा नाव मा, हमला लोक धोकादेवन वारा समजासे पर आमी खरो सेजन। <verse eid="2CO 6:8"/><verse number="9" style="v" sid="2CO 6:9"/>अन्जान रूप मा आमी सेजन, मग आमी जग-जाहिर सेजन। लोकगिनला आवता च मेला का जबच मेला असो आमी चोवासेजन, पर आमी जित्तो सेजन, आमी ला अबा पिटाई पड़नवारा सेत आमी मर जाबिन असो लगसेत पर, अबा आमी जित्तो सेजन। <verse eid="2CO 6:9"/><verse number="10" style="v" sid="2CO 6:10"/>आमी दुखी चोवसेजन, पर आमी खुस सेजन, आमी गरिब सेजन, पर नगद लोकगीन ला धनी बनावसेजन। असो आमी चोवसेजन का अमरो कठा काही नाहती पर आमरो कठा सारी जुनुस सेत।<verse eid="2CO 6:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="2CO 6:11"/>अगा कुरिन्थी नगर को लोक गीन, आमी ना खुल्लमखुल्ला सक्कडिया गोस्टी सांगेसेजन, आमरो दिल तुमरो लाय उघडोसेत, <verse eid="2CO 6:11"/><verse number="12" style="v" sid="2CO 6:12"/>आमरो मन मा तुमरो काजी कोनी इरादा नाहती, पर तुमरो मनमा सेत। <verse eid="2CO 6:12"/><verse number="13" style="v" sid="2CO 6:13"/>पर आपरो लेकरा समजके मी तुमिला सांगसू का तुमी खुलके आपरो दिल को बात सांगो, अना आपरो दिलमा अमीला चौरस जघा देव।<verse eid="2CO 6:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="2CO 6:14"/>परमेस्वर पर भरोसा नही राखन वारा मानूस को संग बरोबरी करन को कोसीस असो खोटो करम नोको करो! भरोसा नही करन वालो लोकगीन संग संगती नही होय सकत, काहेका नेक मानूस अना खोटो मानूस को कोनी नातो नाहती। उजाड़ो अना अंधार दुई संग-संग कसो रव्ह सकसेत? <verse eid="2CO 6:14"/><verse number="15" style="v" sid="2CO 6:15"/>यीसु मसीह को लोकगीन को बलियाल देवता को संग काजक रिस्ता सेत? अखीन यीसु पर भरोसा राखन वारा को, भरोसा नही राखन वारा को संग कसो नाता? <verse eid="2CO 6:15"/><verse number="16" style="v" sid="2CO 6:16"/>मुरती को पूजा करनवारा को जित्तो परमेस्वर को मंदिर<note caller="+" style="f"><char style="fr" closed="false">6:16 </char><char style="ft" closed="false">बिस्वासी</char></note> लक काजक लेवनो-देवनो सेत।</para>
  <para style="q1" vid="2CO 6:16">“काहेका आमी जित्तो परमेस्वर को मंदिर सेजन। जसो परमेस्वर ना खुदच</para>
  <para style="q2" vid="2CO 6:16">मी आपरो लोकगीन को संग आपरो घर बनाहिन अना उनको बीच मा रव्हिन।</para>
  <para style="q1" vid="2CO 6:16">अना मी उनको परमेस्वर रव्हिन</para>
  <para style="q2" vid="2CO 6:16">अना वय मोरो लोक कहलायेत।”<verse eid="2CO 6:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="2CO 6:17"/>एकोलाय पिरभू कव्हसेत</para>
  <para style="q1" vid="2CO 6:17">“उनको बीच लक हीटो</para>
  <para style="q2" vid="2CO 6:17">अना बेगरो रव्हो,”</para>
  <para style="q1" vid="2CO 6:17">अना असुध्द चीज ला नोको छिवो,</para>
  <para style="q2" vid="2CO 6:17">तो मी तुमीला अपनाइन।<verse eid="2CO 6:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="2CO 6:18"/>अना मी तुमी लोकगीन को अजी बनयो सेऊ, अना तु मोरो टूरा आस! यो सब लक ताकत वर “पिरभू असो कव्हसेत।”<verse eid="2CO 6:18"/></para>
  <chapter eid="2CO 6"/>
  <chapter number="7" style="c" sid="2CO 7"/>
  <para style="p">
    <verse number="1" style="v" sid="2CO 7:1"/>एकोलाय ओ मोरो चहेतो भाऊ अना बहिन हुन, यो सब वायदा आमरो च लाय कियो गयो सेत। तो आव आमी आपरो आप ला उन सब लक जोन आमीला असुध्द करासेत वोको लक सुध्द करबिन, या जोन अमरो देह ला आतमा ला असुध्द बनावसेत। काहेका अमीला परमेस्वर को भेव मा जीवन काजी पूरो पवीतर होवनो पाईजे।<verse eid="2CO 7:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="2CO 7:2"/>आपरो दिल मा हमारो लाय जघा बनाओ। हमीना कोनी को हानी नहीं करेसेजन। ना अमीना कोनीला बरबाद करीसेजन। ना कोनीलक फायदा लेवन को कोसिस करीसेजन। <verse eid="2CO 7:2"/><verse number="3" style="v" sid="2CO 7:3"/>मी तुमिला निंदा करन काजी असो नहीं कव्हसू; काहेका, जसो मीना पयले सांगिसेव, तुमी आमरो दिल को आमरो दिल मा असो बस गयो सेव, हमी हमेस एक सग रव्हसेजन। चाहे हमी संग जीवबीन या मर जाबीन। <verse eid="2CO 7:3"/><verse number="4" style="v" sid="2CO 7:4"/>मी तुमारो पर एतरो यकीन राखासू। मी यो गोस्टी मा गरब करासू का आमरो सबच परेसानी मा मी अबा भी हिम्मत मा बढ़ावा सेत; अना मी खुसी लक।<verse eid="2CO 7:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="2CO 7:5"/>मकीदुनिया देस पहुंचन को मघा, अमीला देह मा चैन नहोतो। चारिकनी लक दूसरों के संग झगड़ा, दिल मा भेव अना परेसानी होती। <verse eid="2CO 7:5"/><verse number="6" style="v" sid="2CO 7:6"/>पर परमेस्वर निरास लोक गिनला आस देवासेत। तबच तो तितुस को आवन मा अमीला चैन मिली। <verse eid="2CO 7:6"/><verse number="7" style="v" sid="2CO 7:7"/>केवल यो गोस्टी नाहती का उ आवनवारा होतो पर वोको उ सान्ती लक भी अमीला खुसी करिसेत। वोना सांगिस का तुमी मोला चोवनो चाव्हासो, अना तुमी सरमावा सेव मोला बचान काजी तुम कितरो तैय्यार सेव एना सब गोस्टी लक अबा मी खूब खुस सेव।<verse eid="2CO 7:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="2CO 7:8"/>यहांन तकन का अगर वोना चिठ्ठी मा तुम्हिला दुख लगिसेत तो मोला कोनी गम नाहती मोला गम होय सकत होतो जबा जरा उसीर काजी तुमीला पस्तावा होतो। <verse eid="2CO 7:8"/><verse number="9" style="v" sid="2CO 7:9"/>लेकिन अब मी खुस सेउ काहेका मीना पुढ़ा तुम्हिला दुखी नहीं करीसेव। लेकिन तुम्हरो उदासी ना तुम्हरो मन बदलन को मौका देवासेत। वोना दुखला परमेस्वर बवजासे, अना यो काजी कोनी नुकसान नही भयो। <verse eid="2CO 7:9"/><verse number="10" style="v" sid="2CO 7:10"/>काहेका परमेस्वर लक बवजनवारा उदासी को लाय दिल, मा एक बदलाव आवासेत जोन सूटकारा को कन जावासेत। अना वोमा कोनी पस्तावा नाहती। लेकिन वोच उदासी मानूस को मरन को कारन बनासेत। <verse eid="2CO 7:10"/><verse number="11" style="v" sid="2CO 7:11"/>चोवो परमेस्वर ना तुमरो यो उदासी लक का भयो, तुमी कितरो ईमानदार सेव, अना निरदोस सेव यो साबीत करन काजी असो भई सेत। तुम मा जोन गुस्सा अना पलटा लेवन को बिचार, भेव अना खूब जोस पैदा भयो तुमीना हरेक परकार लक दिसायो का तुम निरदोस सेव।<verse eid="2CO 7:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="2CO 7:12"/>मंग मी ना जोन तुमला चिठ्ठी मा लिखयो होतो वोमा ना तो वोको कारन लिखयो होतो जोनना हानी करिसेत अना वोको कारन जोन पर अन न्याय भई सेत पर एकोलाय का तुमरो जोस जोन आमरो काजी सेत परमेस्वर को पुढ़ा चोव जाय, का तोरी भक्ती केतरी सेत। <verse eid="2CO 7:12"/><verse number="13" style="v" sid="2CO 7:13"/>योच कारन सेत का हमला सान्ती भेटिस। आमरो यो सान्ती अना तितुस को कारन लक खुसी यो दुई गोस्टी मिलके सबको दिल गदगद<note caller="+" style="f"><char style="fr" closed="false">7:13</char><char style="ft" closed="false">खुसी</char></note> भई गयो। अना तुमी ना अखीन जीव ला लगत खुस कर दियो। <verse eid="2CO 7:13"/><verse number="14" style="v" sid="2CO 7:14"/>मीना तुमरो पर घमन्ड करयात, अना तुमीना मोला निरास नहीं करीसेव। हमेस अमीना तुमिला खरो सगिसेत, अना वसोच अमिना गरब करतत आमरो गरब करनो सहि सेत। अना तितुस ना जनमन सांगयो, तो यो गोस्टी खरो साबीत भयो। <verse eid="2CO 7:14"/><verse number="15" style="v" sid="2CO 7:15"/>जब वोला तुम सब को हेत आवासेत, का तुमी कसो हुकूम मानत होतो? आना, कसो डराय के अना थर्रा के वोको लक भेंट करियो, तो वोको पिरेम अखीन जादा बढ जावासेत। <verse eid="2CO 7:15"/><verse number="16" style="v" sid="2CO 7:16"/>मोला हरेक बातमा तुमरो पर पूरो भरोसा सेत यो गोस्टी लक मी लगत खुससेव।<verse eid="2CO 7:16"/></para>
  <chapter eid="2CO 7"/>
  <chapter number="8" style="c" sid="2CO 8"/>
  <para style="p">
    <verse number="1" style="v" sid="2CO 8:1"/>आमरो संगी भाऊ, आमी चाव्हासेजन, का तुमीला मालुम भई जाये का मकीदुनिया देस को कलीसिया मा परमेस्वर को कसो किरपा सेत। <verse eid="2CO 8:1"/><verse number="2" style="v" sid="2CO 8:2"/>उनना परेसान होय-होय के ना परिक्सा मा पास भई सेत। लेकिन वय लगत खुस होतिन, अना गरिब होवन को बाउजुद वय गजब दान करन वारा सेती। <verse eid="2CO 8:2"/><verse number="3" style="v" sid="2CO 8:3"/>उनको बारेमा मोरो यो गवाही सेत, का आपरो खुद को मरजी लक, जितरो उनको अवकात होतिन, वोको लक जादा देईन। <verse eid="2CO 8:3"/><verse number="4" style="v" sid="2CO 8:4"/>उनना आमरो लक बिनती करीन अना यहूदिया देसमा परमेस्वर को पवीतर लोकगीन को सेवा करनलाय अमीला भी मौका देव असो कव्हन लगीन। <verse eid="2CO 8:4"/><verse number="5" style="v" sid="2CO 8:5"/>यो आमरो समज लक जादा आस होतो, काहेका उनना पयले आपरो आप ला पिरभू ला दे देइन अना मघा, परमेस्वर को मरजी लक खुदला भी अमीला दे देइन। <verse eid="2CO 8:5"/><verse number="6" style="v" sid="2CO 8:6"/>एकोलाय हमीना तितुस लक बिनती करयो का, जोनना यो काम ला सुरू करया, अना एला चालू राखन काजी अना पिरेम लक यो सेवा ला पूरो करन लाय तुमरो मदद करीस। <verse eid="2CO 8:6"/><verse number="7" style="v" sid="2CO 8:7"/>पर जसो तुमी सक्ड़िया गोस्टी मा मजे भरोसा, बचन अना गियान मा अना हरेक परकार को जोस मा अना पिरेम मा बढसो वसोच यो किरपा को सेवा मा भी बड़तो जावो।<verse eid="2CO 8:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="2CO 8:8"/>मी कोनी नवा नेम नहीं देवासू। पर मी यो चोवाय के परख को कोसिस मा सेव का दुसर लोक हुन ला कितरो जोस से, अना यो भी का तुमरो पिरेम मा कितरो दम सेत। <verse eid="2CO 8:8"/><verse number="9" style="v" sid="2CO 8:9"/>तुम आमरो पिरभु यीसु मसीह को किरपा जानासेव। का उ धनी होतो पर तुमरो काजी उ कंगाल भई गयो, जोन लक वोको कगांल होवन को कारन तुमी धनी भई जावो।<verse eid="2CO 8:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="2CO 8:10"/>मोरो असो राय सेत का, बितो साल तुमीना जोन सुरू कियो होतो, नातो वोच काम करत होतो पर यो गोस्टी ला चाव्हन मा भी पयलो सेव। <verse eid="2CO 8:10"/><verse number="11" style="v" sid="2CO 8:11"/>एकोलाय अबा वा काम पूरो करो, का जोन ला करनलाय तुमी आपरो मरजी लक तैय्यार होतो वोला आपरो पूंजी को अनूसार करो। <verse eid="2CO 8:11"/><verse number="12" style="v" sid="2CO 8:12"/>यदि तुमरो मन तैय्यार सेत तो दान वोको अनूसार लेव लेने, जोन वोको कठासेत वाच पर जोन वोको कठा नाहती, तो वोको कोनी सवाल नाहती।<verse eid="2CO 8:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="2CO 8:13"/>काहेका यो नही का दुसरो सुख अना तुम्हारो दुख को लाय नोको पर बरोबरी पर बिचार करो। <verse eid="2CO 8:13"/><verse number="14" style="v" sid="2CO 8:14"/>तुम्हारो धनी होवनो उनको कँगाली मा काम आये। जोन लक तुमी बरोबर भई जावो। <verse eid="2CO 8:14"/><verse number="15" style="v" sid="2CO 8:15"/>जैस का पवीतर गिरंथ कव्हसेत। “जोन ना लगत जमा करीन उ लगत नाहती।”<verse eid="2CO 8:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="2CO 8:16"/>परमेस्वर को धनवाद हो, जोनना तुमारो लाय वोच जोस तितुस को दिल मा डाख दियो सेत। काहेका तुमी आमरो मदद कर रहयो सेव। <verse eid="2CO 8:16"/><verse number="17" style="v" sid="2CO 8:17"/>उनना सिरप आमरो बात राखिसेत, अना उ अपरो मरजी ला बढ़ाय के खुसी लक तुमरो कठा आवन को फैसला करिसेत। <verse eid="2CO 8:17"/><verse number="18" style="v" sid="2CO 8:18"/>आमी ना वोको संग उ भाऊ ला भी धड़यो से, जेनको नाव साजरो बारता को बारेमा कलीसिया मा फैलो हुया से। <verse eid="2CO 8:18"/><verse number="19" style="v" sid="2CO 8:19"/>अना इतरोच नही पर उ कलीसिया लक निवाड़ो गयो सेत। का यो दान को काम काजी आमरो संग जाय। आमी यो सेवा यो लाय करतत का पिरभू को महिमा अना दया लक आमरो मन को तैय्यारी सबको पुढ़ा परगट भई जाय।<verse eid="2CO 8:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="2CO 8:20"/>आमी यो गोस्टी काजी चवकन्ना रव्हसेजन का यो सेवा को काम जोन आमी करसेजन, कोनी आमरो बदी नोको करनो पाय। <verse eid="2CO 8:20"/><verse number="21" style="v" sid="2CO 8:21"/>कायको लाय का जोन गोस्टी केवल पिरभू को कठा नही पर मानूसगिन को जवर भी सजरा सेत आमी वोचको चिन्ता करासेजन।<verse eid="2CO 8:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="2CO 8:22"/>अमीना वोको संग आपरो भाऊ ला भी धाड़िसेजन। जोनला अमीना घडी-घडी परख के लगत गोस्टी मा अगाडी पायोसेजन अना वोला यो काम करन को हुलहुली<note caller="+" style="f"><char style="fr" closed="false">8:22</char><char style="ft" closed="false">जोस</char></note> सेत। <verse eid="2CO 8:22"/><verse number="23" style="v" sid="2CO 8:23"/>अना कोनी तितुस को बारे मा पुसेत, तो उ मोरो संगी अखीन तुमरो लाय मोरो संग काम करनवारा पेरीत सेत, अना कोनी भाऊ गीन को बारेमा पुसेत, तो वय कलीसिया को कन लक धाडयो गयो मसीह को महिमा सेत। <verse eid="2CO 8:23"/><verse number="24" style="v" sid="2CO 8:24"/>अता आमरो पिरेम अना तुमरो बारे मा आमी जोन गरब करसेजन, कलीसिया मा पुरुप करो।<verse eid="2CO 8:24"/></para>
  <chapter eid="2CO 8"/>
  <chapter number="9" style="c" sid="2CO 9"/>
  <para style="p">
    <verse number="1" style="v" sid="2CO 9:1"/>अबा वोना सेवा को बारे मा जोन पवीतर लोकगीन काजी करयो जावासेत मोला तुमला लिखन को जरुरी नाहती। <verse eid="2CO 9:1"/><verse number="2" style="v" sid="2CO 9:2"/>काहेका मी तुमरो आतमा की तैय्यारी ला जानासु जेनको कारन मी तुमरो बारेमा मकिदुनिया का रहवन वालो को पुड़ा खूब घमंड लक देखासेऊ की अखया का लोक एक बरस लक तैय्यार भयो अना तुमरी खुसी न अखीन लगत स गीन ला बढाईसेस। <verse eid="2CO 9:2"/><verse number="3" style="v" sid="2CO 9:3"/>पर मीना भाऊ गीन ला एकोच लाई धाडिसेऊ का हमी न जोन घमंड तुमरो बिसय मा देखाईस उ एना गोस्टी मा कोनी मतलब को नोको रहवा पर जसो मीना कहीसेउ वसोच तुमी तैय्यार रव्हो। <verse eid="2CO 9:3"/><verse number="4" style="v" sid="2CO 9:4"/>असो नोको होवा का अदी कोनी मकिदुनिया<note caller="+" style="f"><char style="fr" closed="false">9:4</char><char style="ft" closed="false">एक सहर को नाव सेत</char></note> को रहवन वालो मोरो संग आहे अना तुमला तैय्यार नही देखके त होय सकासे का एना भरोसा को कारन हमी यो नही कव्हजन का तुमरी बेईज्जती होय। <verse eid="2CO 9:4"/><verse number="5" style="v" sid="2CO 9:5"/>एकोलाय मीना भाऊ गीन लक या बिनती करन की जरूरी समझीस का वय पहेल लक तुमरो जवर जाहे अखीन तुमरो दयालूपन को फर जेनको बारे मा पहेल लक परन कियो गयो होतो।<verse eid="2CO 9:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="2CO 9:6"/>पर गोस्टी असी से जो जरासो बोवसेत, उ जरासो च कापासेत, अना जोन लगत बोवासेत वा लगत कापेत। <verse eid="2CO 9:6"/><verse number="7" style="v" sid="2CO 9:7"/>हरेक झन जितरो मन मा ठानिसेत वा वोतरोच दान करे कुढ-कुढाय के अना दबाव मा दान नोको करो। काहेका परमेस्वर खुसी लक दान देवनवारा लक पिरेम करासेत। <verse eid="2CO 9:7"/><verse number="8" style="v" sid="2CO 9:8"/>परमेस्वर सब परकार को किरपा तुमला देव सकसेत। जोन लक हरेक बात मा हरेक बेरा मा, सबच काही जोन तुमला जरुरी सेत, तुमरो कठा रहेत अना हरेक साजरो काम काजी, तुमरो जवर लगत काही होहे। <verse eid="2CO 9:8"/><verse number="9" style="v" sid="2CO 9:9"/>जसो की लिखयो सेत,</para>
  <para style="q1" vid="2CO 9:9">वोना छितराई<note caller="+" style="f"><char style="fr" closed="false">9:9 </char><char style="ft" closed="false">बाटी सेत</char></note> सेत वोना कंगाल गिनला दान देइसेस,</para>
  <para style="q2" vid="2CO 9:9">वोको धरम सदा लक बनो रहेत।<verse eid="2CO 9:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="2CO 9:10"/>अता जोन बोनी करन वारा ला बीज अना जेवन को लाय पोडी देवसेत। उ तुमला बीज देहेत अना वोको मा फर आनहेत अना तुमरो धरम को फरला बढाहेत। <verse eid="2CO 9:10"/><verse number="11" style="v" sid="2CO 9:11"/>तुम हरेक बातमा सब परकार लक दयालूपन लाय जो आमरो लक परमेस्वर धनवाद करवासेत धनवान बन जावो। <verse eid="2CO 9:11"/><verse number="12" style="v" sid="2CO 9:12"/>काहेका यो सेवा ला पूरो करनो लक ना सिरप पवीतर लोकगीन को जरुरत पूरो होवासेत पर लोकगीन को कन लक परमेस्वर ला लगत सरो धनवाद होवासेत। <verse eid="2CO 9:12"/><verse number="13" style="v" sid="2CO 9:13"/>काहेका एना सेवा को परिनाम स्वीकार करके वय परमेस्वर की महिमा परगट करासेत का तुमी मसीह की साजरा बारता ला मानके वोको कन रहवा सेत अना वोकी अखीन सब पवीतर लोकगीन को सेवा करनो मा दयालूपन परगट करता रहवत होत्यो। <verse eid="2CO 9:13"/><verse number="14" style="v" sid="2CO 9:14"/>अना वय तुमरो लाई पिराथना करासेत अना एकोलाय का तुमी पर परमेस्वर को मोठो किरपा से तुमरी आस कराता रहवासेजन। <verse eid="2CO 9:14"/><verse number="15" style="v" sid="2CO 9:15"/>परमेस्वर वोको एना दान को लाई जोन हिसाब लक बाहेर लक धनवाद होहे।<verse eid="2CO 9:15"/></para>
  <chapter eid="2CO 9"/>
  <chapter number="10" style="c" sid="2CO 10"/>
  <para style="p">
    <verse number="1" style="v" sid="2CO 10:1"/>मी उ पौलुस जोन तुमरो पुड़ा गरीब सेव पर पाठ को मंघा तुमरो कन हिम्मत करके बिनती करासेऊ तुमला मसीह की कोमलता अना दयालुपन को कारन समझासेउ। <verse eid="2CO 10:1"/><verse number="2" style="v" sid="2CO 10:2"/>मी यो बिनती करासेऊ का तुमरो पुड़ा मोला बीना डर को होयके हिम्मत करनो नही पडे जसो मीना कोनी लोक गीन पर जोन हमरो देह को जसो चलन वालो समझसे हिम्मत देखावन को बिचार करासेऊ। <verse eid="2CO 10:2"/><verse number="3" style="v" sid="2CO 10:3"/>काहेकी अदी हमी देह मा चला सेजन फिरासेजन तोभी त देह को जसो नही लड सकत। <verse eid="2CO 10:3"/><verse number="4" style="v" sid="2CO 10:4"/>काहेकी हमरो झगड़ा को अवजार देहिक नही, पर किला गीन<note caller="+" style="f"><char style="fr" closed="false">10:4</char><char style="ft" closed="false">किला बुराबिचार</char></note> ला चूरा-चूरा करन लाय परमेस्वर को कन लक ताकतवर सेत। <verse eid="2CO 10:4"/><verse number="5" style="v" sid="2CO 10:5"/>एकोलाय हमी कल्पना गीन अना हर एक ओरता गोस्टी को जोन परमेस्वर की ओरख के वोको विरोध मा उचली से खंडित करासेत अना हर एक बिचार ला कैद करके मसीह को हुकूम मानन वालो बनावसेत। <verse eid="2CO 10:5"/><verse number="6" style="v" sid="2CO 10:6"/>अखीन तैय्यार रव्हसे का जबा तुमरो हुकूम पूरो होय जाहे त हर एक पिरकार को हुकूम ला तोड़हेत त सजा देहेत।<verse eid="2CO 10:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="2CO 10:7"/>तुमी वोनच गोस्टी गीन ला देखो जोन डोरा को पुड़ा से अदी कोनी को अपरो पर यो भरोसा होहे का मी मसीह को सेव त उ असो जानले का जसो उ मसीह को से वसोच हमी भी सेजन। <verse eid="2CO 10:7"/><verse number="8" style="v" sid="2CO 10:8"/>काहेकी अदी मी वोना अधिकार को बारे मा अना घमंड दिखावसू जोन पिरभू न तुमरो बिगाड़न को लाई नही पर बनावन लाई हमला देईसेस त बेइज्जती नही होवन देहू। <verse eid="2CO 10:8"/><verse number="9" style="v" sid="2CO 10:9"/>यो मी एको लाई कव्हासेऊ का चिठ्ठी कन लक तुमला डरावन वारा नही बनु। <verse eid="2CO 10:9"/><verse number="10" style="v" sid="2CO 10:10"/>काहेकी वय कव्हसेत वोकी चिठ्ठी त गहरो परभाव डाखन वालो से पर जबा उ पुड़ा होवासे त उ देह मा कमजोर अना बोलनो मा हलको मालूम पड़ से। <verse eid="2CO 10:10"/><verse number="11" style="v" sid="2CO 10:11"/>जोन असो कव्हसे उ यो समझ राखे का, जसो पाठ को मंघा चिठ्ठी गीन मा हमरो गोस्टी से वसोच तुमरो पुड़ा हमरो काम भी होहेत।<verse eid="2CO 10:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="2CO 10:12"/>काहेकी हमी असी हिम्मत नही का, हमी अपरो आप ला उन मा लक असो काही को संग गीनन या उनला अपरो ला मिलाहे जोन अपरी साबासी खुदच करासेत अखीन अपरो आप आपसी तवल के एक दुसरो लक मिलके कम अक्ल ठहराहेत। <verse eid="2CO 10:12"/><verse number="13" style="v" sid="2CO 10:13"/>हमी त सिव मेंढो<note caller="+" style="f"><char style="fr" closed="false">10:13 </char><char style="ft" closed="false">हद</char></note> लक बाहेर घमंड कबच नही करेत पर वोनच सिव मेंढो तकन जोन परमेस्वर न हमरो लाई ठहराइसेस अखीन उनमा तुमी भी आय गईसेव अना वोकोच जसो घमंड भी करो। <verse eid="2CO 10:13"/><verse number="14" style="v" sid="2CO 10:14"/>काहेकि हमी अपरो सिव मेंढो लक बाहेर अपरो आप ला बढावन नही चाव्हासे जसो का तुमरो तकन नही पहुचीनो की दहा मा होत्यो मसीह की साजरो बारता आयकावत होयो तुमरो तकन धाड़ी सेत। <verse eid="2CO 10:14"/><verse number="15" style="v" sid="2CO 10:15"/>हमी सिव मेंढो लक बाहेर दुसरो की मेहनत पर घमंड नही करेत पर हमला आस से का जसो-जसो तुमरो भरोसा बड़तो जाहे वसो-वसो हमी अपरी सिव मेंढो को जसो तुमरो कारन अखीन भी बढता जाबीन <verse eid="2CO 10:15"/><verse number="16" style="v" sid="2CO 10:16"/>ताकी हमी तुमरी सिव मेंढो लक पुड़ा बड़के साजरो बारता आयकबीन अना यो नही का हमी दुसरो की सिव मेंढो को अंदर बनया काम गीन पर घमंड करेत।<verse eid="2CO 10:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="2CO 10:17"/>पर जोन घमंड करेत उ पिरभू मा घमंड करहे। <verse eid="2CO 10:17"/><verse number="18" style="v" sid="2CO 10:18"/>काहेकी जोन अपरी बड़ाई करासे उ मंजूर नही पर जेकी बढाई पिरभू करासे वोलाच अपनायो जासे।<verse eid="2CO 10:18"/></para>
  <chapter eid="2CO 10"/>
  <chapter number="11" style="c" sid="2CO 11"/>
  <para style="p">
    <verse number="1" style="v" sid="2CO 11:1"/>अदी तुमी लोकगीन मोरी जरासी कम अक्ल<note caller="+" style="f"><char style="fr" closed="false">11:1</char><char style="ft" closed="false">मुरखपन</char></note> ला सह लेतो त का साजरो भय जातो हव मोरी सह भी लेवने। <verse eid="2CO 11:1"/><verse number="2" style="v" sid="2CO 11:2"/>काहेकी मी तुमरो बिसय मा परमेस्वर की खूब धुन मा लगयो रव्हा सेऊ एकोलाय का मीना एकच मानूस लक तुमरी पक्की करी सेउ, का तुमीला पवीतर कुवारी को जसो मसीह ला सोप देहू। <verse eid="2CO 11:2"/><verse number="3" style="v" sid="2CO 11:3"/>पर मी डरावा सेव का जसो सरप<note caller="+" style="f"><char style="fr" closed="false">11:3 </char><char style="ft" closed="false">सैतान</char></note> न अपरी चलाकी लक हव्वा<note caller="+" style="f"><char style="fr" closed="false">11:3 </char><char style="ft" closed="false">सप्पा मानूस गीन को माय</char></note> ला बहकायो वसोच तुमरो आतमा वोना सीधो अना पवीतर लक जोन मसीह को संग रव्हनो चाव्हसे कदी खराब नोको कर दे। <verse eid="2CO 11:3"/><verse number="4" style="v" sid="2CO 11:4"/>अदी कोनी तुमरो जवर आयके कोनी दुसरो यीसु को परचार करयेत जेनको परचार हमी ना नही करयो कोनी अखीन आतमा तुमला मिलहेत जोन पहेल नही मिलयो होत्यो अना कोनी साजरो बारता आयकावत जेनको लक तुमी न पहेल नही मानयो होत्यो त तुमी वोला सह लेवासो।<verse eid="2CO 11:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="2CO 11:5"/>मी त समजाय सेऊ का मी कोनी गोस्टी मा मोठो पेरीत गीन<note caller="+" style="f"><char style="fr" closed="false">11:5</char><char style="ft" closed="false">चेले लोग</char></note> लक कम नही सेव। <verse eid="2CO 11:5"/><verse number="6" style="v" sid="2CO 11:6"/>अदी मी बोलनो मा अनाड़ी सेव, तबच अक्ल मा नही, हमी न एको हर एक गोस्टी मा सबच पिरकार लक तुमरो लाई परगट करीसेजन। <verse eid="2CO 11:6"/><verse number="7" style="v" sid="2CO 11:7"/>का एको मा न कोनी पाप करी सेजन का मीना तुमला परमेस्वर की साजरो बारता फुकट आयकावइस अना अपरो आप खाल्या करीस का तुमी वोरता होय जाव? <verse eid="2CO 11:7"/><verse number="8" style="v" sid="2CO 11:8"/>मीना दुसरी कलीसिया गीन ला लूटयो अना मीना उनको लक मजदुरी लियो ताकी तुमरी सेवा करू। <verse eid="2CO 11:8"/><verse number="9" style="v" sid="2CO 11:9"/>अना जबा मी तुमरो संग होतो अना मोला कमी भई त मीना कोनी पर बोझ नही डाकयो काहेकी भाऊ गीन न मकीदुनिया लक आयके मोरी कमी ला पूरो करियो अना मीना हर गोस्टी मा अपरो आप ला तुमरो पर बोझ बनन लक रोखीस अना <verse eid="2CO 11:9"/><verse number="10" style="v" sid="2CO 11:10"/>अदी मसीह को खराई मोरो मा सेत, तो अखया छेतर मा कोनी मोला यो गरब करन लाय नही रोखेत। <verse eid="2CO 11:10"/><verse number="11" style="v" sid="2CO 11:11"/>कायको लाय? काय, एकोलाय का तुमरो लक मी पिरेम नही राखसू? परमेस्वर जानासेत का मी पिरेम राखासू।<verse eid="2CO 11:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="2CO 11:12"/>पर जोन मी करासू वोच करत रव्हिन, का जोन लोकगीन डाव ढूढसेत, उनला डाव नोको मिल्हेत जोन लक, जोन गोस्टी मा वय गरब करासेत, वोमा वय आमरो बरोबर ठहरेत। <verse eid="2CO 11:12"/><verse number="13" style="v" sid="2CO 11:13"/>कायका असो लोक झूठो पेरीत अखीन छल बल करनवारा अना मसीह को पेरीत को रुप धरनवारा सेत <verse eid="2CO 11:13"/><verse number="14" style="v" sid="2CO 11:14"/>यो काही अचंभा को गोस्टी नाहती, काहेका सैतान भी खुदच जग मंग तो सरगदूत को रुप धरसेत। <verse eid="2CO 11:14"/><verse number="15" style="v" sid="2CO 11:15"/>एकोलाय अदी वोको सेवा करनवारा, धरम को दास जसो रुप धरेति तो कोनतो मोठी गोस्टी सेत। पर उनको आखीर उनको काम को अनूसार होयेती।<verse eid="2CO 11:15"/></para>
  <para style="s">पेरीत को रुप मा पौलुस को दुख काटनो</para>
  <para style="p">
    <verse number="16" style="v" sid="2CO 11:16"/>मी अखीन सांगसू कोनी मोला एड़ा नोको समझे नही तो एड़ा च समझ के मोरो सह लेव जेनको लक मी गरब कर सुक। <verse eid="2CO 11:16"/><verse number="17" style="v" sid="2CO 11:17"/>असो भरोसा लक मी बेधड़ाक गरब करके ना जो काही कव्हसू, उ पिरभू को हुकूम को अनूसार नही, पर मान लेव मोरो अठ्ठियापन लक मी कव्हसू <verse eid="2CO 11:17"/><verse number="18" style="v" sid="2CO 11:18"/>तर गजब मानूस गीन देह को अनूसार गरब करासेत तो मी भी करासू। <verse eid="2CO 11:18"/><verse number="19" style="v" sid="2CO 11:19"/>तुमी भी अक्कलवर सेव, पर खुस होयके अठ्ठियागीन को सहसेव। <verse eid="2CO 11:19"/><verse number="20" style="v" sid="2CO 11:20"/>काहेका जबा कोनी तुमला गुलामी करावा सेत, खाय जावासेत, आपरो जालमा फसा लेवासेत। अना आपरो आप ला मोठयो साबीत करासेत, या तुमरो तोन्ड मा झापड़ मारासेत, अना तुमी सहन कर लेवासो, <verse eid="2CO 11:20"/><verse number="21" style="v" sid="2CO 11:21"/>मानलेव आमी कमजोर सेजन एकोलाय आमी तुमरो बेइज्जति करासेजन,</para>
  <para style="p" vid="2CO 11:21">पर मी कम अक्ल वारा मोठो हिम्मत करके साँगा सेऊ <verse eid="2CO 11:21"/><verse number="22" style="v" sid="2CO 11:22"/>का वोच इबरानी सेत, मी भी सेव? का वोच इसरायली सेत, मी भी सेव? का वोच अबराहम को खानदान को सेत मी भी सेव? <verse eid="2CO 11:22"/><verse number="23" style="v" sid="2CO 11:23"/>का वोच मसीह को दास सेत? मी बैताड को जसो कव्हसू मी उनलक मोठयो सेव। जादा मेहनत करनो मा, बार-बार जेल जानो मा, कोडा लक मार खानो मा, बार-बार मरते-मरते बचनो मा, <verse eid="2CO 11:23"/><verse number="24" style="v" sid="2CO 11:24"/>पाँच बेरा मीना यहूदिगीन को हात लक एक उनचाडिस कोड़ा मार खायो। <verse eid="2CO 11:24"/><verse number="25" style="v" sid="2CO 11:25"/>तिन बार मीना बेत लक मार खायो, एक बार मोला गोटा लक मार पडयो, तीन बार जोन जहाज मा बस्यो होतो वोच टूट गयो। एक रात दिवस मी ना सगर मा काटयो। <verse eid="2CO 11:25"/><verse number="26" style="v" sid="2CO 11:26"/>बार-बार यातरा मा नदी को जोखिम मा डाकुगीन को जोखिम मा, आपरो जातवाहि को जोखिम मा, परजात को जोखिम मा, नगर को जोखिम मा, जंगल को जोखिम मा, सागर को जोखिम मा, झूठ बोलन वारा भाऊगिन को जोखिम मा रव्हो। <verse eid="2CO 11:26"/><verse number="27" style="v" sid="2CO 11:27"/>मेहनत अखीन दूख मा, बार-बार जगनो मा, भूखओ अना तहान रव्हनो मा, बार-बार उपासी रव्हन मा, थंड मा, उघाडो रव्हनोमा, <verse eid="2CO 11:27"/><verse number="28" style="v" sid="2CO 11:28"/>अना लगत गोस्टी जोनला मी सागंनो नही चाव्हसू, सब कलीसिया हुन को फिकर, मोला राती-दिवस सतावा सेत, <verse eid="2CO 11:28"/><verse number="29" style="v" sid="2CO 11:29"/>कोनी को कमजोरी लक मी कमजोर नही होवासू, कोनी को ठोकर खावन लक मोरो जीव नही दुखसेत।<verse eid="2CO 11:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="2CO 11:30"/>अदी गरब करनो जरुरी सेत, तो मी आपरो कमजोरी पर गरब करहीन। <verse eid="2CO 11:30"/><verse number="31" style="v" sid="2CO 11:31"/>पिरभू यीसु को परमेस्वर बाबूजी सदा धन्य सेत। उ जाना सेत का मी खोटो नही सागसू। <verse eid="2CO 11:31"/><verse number="32" style="v" sid="2CO 11:32"/>दमिसक नगर मा अरितास राजा को कन लक जोन राजपाल होत्यो, उ मोला धरान काजी दमिस्क नगर मा पहेरा लगा दियो होतो। <verse eid="2CO 11:32"/><verse number="33" style="v" sid="2CO 11:33"/>अना मी डलिया मा खिड़की लक सहेर को दिवाल मा लक खाल्या उतारो गयो अखीन मी बच गयो।<figure style="fig" alt="Entrance to the city gate and wall" file="HK00238C.TIF" size="col" copy="Horace Knowles ©" ref="11:32">सहेर को बेसकुड़ अखिन परकोट मा धसनो</figure><verse eid="2CO 11:33"/></para>
  <chapter eid="2CO 11"/>
  <chapter number="12" style="c" sid="2CO 12"/>
  <para style="s">पौलुस ला चमत्कारी दरसन मिलनो अना कमजोर होवनो</para>
  <para style="p">
    <verse number="1" style="v" sid="2CO 12:1"/>मँग गरब करनो मोरो काजी सजरा नाहती, मँग करनो पड़से। एकोलाय मी पिरभू ना जोन दरसन देइसेत वोको बारे मा तुमीला सांगसू, <verse eid="2CO 12:1"/><verse number="2" style="v" sid="2CO 12:2"/>मी मसीह मा एक मानूस ला जानासू, चवदा बरस बित गयो, का मालुम देह समेत, का बिन देह को, परमेस्वर जानासे; असो मानूस तिसरो सरग<note caller="+" style="f"><char style="fr" closed="false">12:2</char><char style="ft" closed="false">बादल मा</char></note> मा उचल लियो गयो। <verse eid="2CO 12:2"/><verse number="3" style="v" sid="2CO 12:3"/>मी असो मानूस ला जानासू ना जाने देह समेत, ना जानेह बिन देह को, परमेस्वर जानासे <verse eid="2CO 12:3"/><verse number="4" style="v" sid="2CO 12:4"/>का सरग लोक मा उचल लियो गयो अना असो गोस्टी आयकियो जोन सांगन को नही; अना वोला तोन्ड मा आननो साजरो नाहती। <verse eid="2CO 12:4"/><verse number="5" style="v" sid="2CO 12:5"/>असो मानूस पर तो मी गरब करासू पर आपरो पर आपरो कमजोरी ला छोड़, आपरो बारे मा गरब नही करन को। <verse eid="2CO 12:5"/><verse number="6" style="v" sid="2CO 12:6"/>काहेका अदी मी गरब करनो चाव्हू तो मी मुरख नही सेउ, काहेका मी खरो सांगसू, ता भी रुक जावासू, असो नोको होव्हे का जसो कोनी मोला चोवसेत या मोरो लक आयक सेत; मोला वोको लक मोठयो समझे।<verse eid="2CO 12:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="2CO 12:7"/>एकोलाय का मी दरसन को लगत गोस्टी मा कही गरब लक फूल ना जाऊ, एकोलाय मोरो देह मा एक काटा गडायो जावासेत, मजे सैतान को एक दुत मोला मुक्का मारहेत<note caller="+" style="f"><char style="fr" closed="false">12:7 </char><char style="ft" closed="false">परेसान करासेत</char></note>, जोन लक मी घमंड नही करू। <verse eid="2CO 12:7"/><verse number="8" style="v" sid="2CO 12:8"/>एको बारेमा मीना पिरभू लक तीन बार बिनती करिसेऊ, का यो मोरो लक दूहुर भई जाय। <verse eid="2CO 12:8"/><verse number="9" style="v" sid="2CO 12:9"/>पर वोना मोरो लक सँगीस, “मोरो किरपा तोरो लाय गजब सेत, काहेका मोरो ताकत कमजोरी मा च चोवासेत यो काजी मी खुसी-खुसी लक आपरो कमजोरी पर गरब करबिन का मसीह को ताकत मरो पर सवली करत रव्हे।” <verse eid="2CO 12:9"/><verse number="10" style="v" sid="2CO 12:10"/>योच कारन मी मसीह को लाय कमजोरी मा अना निन्दा मा, अना गरिबी मा, अखीन उपदरा मा, अना दुखमा खुस रव्हसू। काहेका जबा मी कमजोर होवासू तबच मी बलवान होय जावासू।<verse eid="2CO 12:10"/></para>
  <para style="s">कुरुन्थी को कलीसिया सँठी पौलुस को चिन्ता</para>
  <para style="p">
    <verse number="11" style="v" sid="2CO 12:11"/>मी मुरख तो बन गयो, पर तुमी ना मोला मुरख बनन काजी बेबस करीसेव। तुमला तो मोरी बडाई करनो होत्यो, काहेकि अदी मी काही भी नही सेव, ताभि मी उन मोठो लक मोठो पेरीत गीन लक काही गोस्टी मा कम नही सेव। <verse eid="2CO 12:11"/><verse number="12" style="v" sid="2CO 12:12"/>पेरीत को गुन भी तुमारो बीच मा सब परकार लक धिरज धरके निसान अना अचँभा काम, अना ताकत को काम तकन चोवायो गयो। <verse eid="2CO 12:12"/><verse number="13" style="v" sid="2CO 12:13"/>तुम कोनतो गोस्टी लक दुसरो कलीसिया लक कम होता। बस एतरो का मीना आपरो भार तुमरो पर नही डाकयो। मोरो यो अन्याय ला छिमा कर देव।<verse eid="2CO 12:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="2CO 12:14"/>चोवो, मी तिसरो बार तुमरो कठा आवन काजी तैय्यार सेव। अना मी तुमरो पर कोनी खरचा नही राखनवारा सेव। काहेका मी तुमारो करजा नही पर तुमला चाव्हसू। काहेका माय बाप लेकराहुन को पूरो खरचा सहवसेत, पर लेकरा नही। <verse eid="2CO 12:14"/><verse number="15" style="v" sid="2CO 12:15"/>मी तुमारो आतमा लाय खुसी-खुसी खरच कर हिन, वरन मि खुद भी खरच भई जाहिन। का मी जितरो जादा तुमरो लक पिरेम करासू, ओतरो च कम रुप लक तुमी मोरो लक पिरेम राखना? <verse eid="2CO 12:15"/><verse number="16" style="v" sid="2CO 12:16"/>असो होय सकसेत का मीना तुमरो पर बोझा नही डाकिसेऊ, पर चलाकी लक तुमला धोका लक फस लेईसेऊ। <verse eid="2CO 12:16"/><verse number="17" style="v" sid="2CO 12:17"/>भला मीना जोन ला मीना तुमरो कठा धाडिसेऊ, का कोनी को लक तुमला चुथिया बनाके ना काही लेइसेऊ? <verse eid="2CO 12:17"/><verse number="18" style="v" sid="2CO 12:18"/>मीना तितुस ला समझाके ना वोको संग मा एक भाऊ धाडिसेऊ, तो का तितुस ना तुमला चुथिया बनाके काही माँगीसेस? का आमी एकच आतमा को चलाय नही चलबिन? का आमी एक लाईन लक नही चलबिन?<verse eid="2CO 12:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="2CO 12:19"/>तुमी अबा तकन समझ रहया होव्हो क अमीना जवाब देइसेत, अमी तो परमेस्वर ला हाजिर जानके ना मसीह मा संगसेजन, अना वो मोरो चहेतो लोक हुन, यो सब गोस्टी तुमरोच उन्नती साठी संगसेजन। <verse eid="2CO 12:19"/><verse number="20" style="v" sid="2CO 12:20"/>काहेका मोला असो भेव सेत, का कदी असो तो नही भई जाय, का मी आय के ना जसो मी तुमी ला चोवनो चव्हासू वसो तुमी मोला नही भेटयो, अना तुमरो मा लडाई रार जलन चुगली अना गरब होहे। <verse eid="2CO 12:20"/><verse number="21" style="v" sid="2CO 12:21"/>अना कदी असो ना भई जाय का मोरो परमेस्वर मोला तुमरो कठा आवन काजी मंग मजबुर करे। अना तुमरो लाय मोला दुख उठानो पडहेत। जोनना पयले पाप कियो होतो, अना खोटो करम, अना दुसरो संग सोवनो को पाप अना वय अबा भी पाप लक मन ला हटाव नही भयो सेत।<verse eid="2CO 12:21"/></para>
  <chapter eid="2CO 12"/>
  <chapter number="13" style="c" sid="2CO 13"/>
  <para style="s">आखरी चेतावनी अना बधाई</para>
  <para style="p">
    <verse number="1" style="v" sid="2CO 13:1"/>अबा मी तिसरो बार तुमी लोकगीन कना आवासू दुई या तीन पुरुप को संग हरेक गोस्टी को निवारन<note caller="+" style="f"><char style="fr" closed="false">13:1</char><char style="ft" closed="false">न्याय</char></note> होहेत। जसो का पवीतर गिरंथ कव्हसेत। <verse eid="2CO 13:1"/><verse number="2" style="v" sid="2CO 13:2"/>जसो मी जबा दुसरो बार तुमरो संग होतो। वसोच अबा दुहुर लक, उन लोकगीन ला जोन ना पाप करिसेत अना तुमी सबला मी सांगसू, का मि आहिन तो तुमरो खैरियत नाहती। <verse eid="2CO 13:2"/><verse number="3" style="v" sid="2CO 13:3"/>काहेका तुमी तो असो गोस्टी को सबुत माँगसेव। का मसीह मोरोलक गोस्टी करासे, जोन तुमरो काजी कमजोर नही पर तुममा ताकतवर से। <verse eid="2CO 13:3"/><verse number="4" style="v" sid="2CO 13:4"/>उ कमजोरी को कारन कूरूस मा चघायो, पर उ परमेस्वर को ताकत लक जित्तो से। आमी भी ओमा कमजोर सेजन। पर परमेस्वर को ताकत लक जोन तुमरो लाय सेत, वोको सँग जित्तो रव्हबिन।<verse eid="2CO 13:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="2CO 13:5"/>आपरो आप ला परखो, का भरोसा मा सेव का नही। आपरो आप ला जाँच लेव। का तुमी आपरो बारे मा यो मालुम नाहती का यीसु मसीह तुमरो मा सेत? नही तो तुमी जाच मा निकम्मा हिटासेव। <verse eid="2CO 13:5"/><verse number="6" style="v" sid="2CO 13:6"/>पर मोरी आस असो सेत का तुमिला मालुम भई जाय का आमी निकम्मो<note caller="+" style="f"><char style="fr" closed="false">13:6 </char><char style="ft" closed="false">बेकाम को</char></note> नाहती। <verse eid="2CO 13:6"/><verse number="7" style="v" sid="2CO 13:7"/>आमी आपरो परमेस्वर लक असो पिराथना करीसेजन, का तुमी कोनी बुराई नोको करो। लोकगीन ला साजरा चोवन काजी नही पर एकोलाय तुमी भलाई को काम करो का चाहे कोनी अमीला नाव धरेत यो मंजूर सेत आमी भलाई च करबिन। <verse eid="2CO 13:7"/><verse number="8" style="v" sid="2CO 13:8"/>काहेका हमी खराई को बिरोध मा काही नही कर सकत पर सच को काजी कर सका सेजन। <verse eid="2CO 13:8"/><verse number="9" style="v" sid="2CO 13:9"/>जबा हमी कमजोर सेजन अना तुमी ताकतवर सेव, ता आमी खुस होव्हसेजन, अना यो पिराथना भी करासेजन की तुमी मजबुत होय जावो। <verse eid="2CO 13:9"/><verse number="10" style="v" sid="2CO 13:10"/>यो कारन मी तुमरो गयर हाजीर मा यो गोस्टी लिखासेऊ की हाजिर होयके मोला ओना हक को जसो जोनला पिरभु ना बिगाड़न को साठी नही पर बनावन को साठी मोला दियो से, कड़ाई लक काही करनो नही पड़ेह।<verse eid="2CO 13:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="2CO 13:11"/>एकोलाय अगो भाऊ खुस रव्हो! साजरो पक्को बनतो जावो अना धिरज राखो। एक बिचार राखो, मिलाप लक रव्हो! पिरेम अना सान्ती देवन वारा, परमेस्वर तुमरो संग होहेत।<verse eid="2CO 13:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="2CO 13:12"/>एक दुसरो ला पिरेम लक पवीतर नमस्कार करो!<verse eid="2CO 13:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="2CO 13:13"/>परमेस्वर को पिरेम लक सबा पवीतर लोक तुम्हिला पिरभू यीसु मसीह मा नमस्कार कव्हसेत <verse eid="2CO 13:13"/><verse number="14" style="v" sid="2CO 13:14"/>पिरभू यीसु मसीह को किरपा अना परमेस्वर को पिरेम अना पवीतर आतमा को संगति तुम सक्कडया<note caller="+" style="f"><char style="fr" closed="false">13:14 </char><char style="ft" closed="false">सप्पा</char></note> लोक को सग होत्यो रव्हे आमीन!<verse eid="2CO 13:14"/></para>
  <chapter eid="2CO 13"/>
</usx>
