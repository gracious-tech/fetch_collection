<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="PHP" style="id">- Powari Standard Project</book>
  <para style="h">फिलिप्पियो</para>
  <para style="toc3">फिलिप्पियो</para>
  <para style="toc2">फिलिप्पियो</para>
  <para style="toc1">फिलिप्पयो को नाव पौलुस की चिठ्ठी</para>
  <para style="mt2">फिलिप्पियो के नाव पौलुस का पत्र</para>
  <para style="mt1">फिलिप्पियो को नाव पौलुस की चिठ्ठी</para>
  <para style="imt">परिचय</para>
  <para style="ip">पौलुस ना फिलिप्पियो मा बिस्वासीगीन ला ईसा मसीह को जलम को करीबन 61 साल मंघा चिठ्ठी लिख्यो। जेल मा रव्हन को बाद उनना सायद रोम मा लिख्यो होतीस <char style="xt"><ref loc="PHP 1:13">1:13</ref></char> यो चिठ्ठी फिलिप्पियो नगर मा पायो जावन वालो चरच ला लिख्यो होतीस। फिलिप्पी को बारे मा आमी पेरीत को काम को किताब लक जरा लगत जान सकासेजन। फिलिप्पियो मकीदुनिया राज को राजधानी होती। यो पयलो चरच भी होतो जेला मकीदुनिया मा बनायो गयो होतो। पौलुस अना सिलास ना एक संगा चरच सुरुवात करी होतीन अना उनला एक रात को लाई जेल मा भी राखियो गयो होतो जबा वय वहान होतीन <char style="xt"><ref loc="ACT 16">पेरीत 16</ref></char></para>
  <para style="ip">एने चिठ्ठी ला लिखनो मा पौलुस को कई मकसद होय सकासेत। उनना ओना मौका को साठी चरच ला धनवाद देवन को लाई काम करीन। जो उनना होतिन जबा उनना आयकिन का उ जेल मा धाड़ियो होतो <char style="xt"><ref loc="PHP 4:10-19">4:10-19</ref> </char> उनना जेल मा उनकी हाल मा उनला बढ़ावा देईन अना तीमुथियुस अना एपाफरोडिटस ला चरच को बिनती करीन मजे वय उनको सुवागत करेत अना उनको अगुवाई को मान करेत। <char style="xt"><ref loc="PHP 2:19-30">2:19-30</ref> </char></para>
  <para style="iot">रूपरेखा</para>
  <para style="io1">1. पौलुस फलिप्पीयो मा चरच नमस्कार लेक चिठ्ठी सुरुवात करासे। <char style="ior"><ref loc="PHP 1:1-11">1:1-11</ref></char></para>
  <para style="io1">2. एको मंघा उ हालचाल को बारे मा काही जानकारी अना काही चिंतागीन ला मिलावासे जो ओको कठा से। <char style="ior"><ref loc="PHP 1:3-2:30">1:3—2:30</ref> </char></para>
  <para style="io1">3. मंग उ ईसाई जिंदगी जीवनो को लाई कई बेवहारिक हुकूम देवासे। <char style="ior"><ref loc="PHP 3:1-4:9">3:1—4:9</ref> </char></para>
  <para style="io1">4. पौलुस ना फिलिप्पियो चरच को उनको ईनाम को लाई धनवाद देयके अना आपरो नमस्कार धाड़के खतम करीस। <char style="ior"><ref loc="PHP 4:10-23">4:10-23</ref></char></para>
  <chapter number="1" style="c" sid="PHP 1"/>
  <para style="s">भुमिका</para>
  <para style="p">
    <verse number="1" style="v" sid="PHP 1:1"/>मसीह यीसु को दास पौलुस अना तीमुथियुस को कन लक, सबच पवीतर लोगहुन को नाव जोन मसीह यीसु मा होयके कलिसीया को मुखिया अना दासगीन को सकट फिलिप्पी नगर मा रव्हसेत। <figure style="fig" alt="City of Philippi" file="HK00363C.TIF" size="span" copy="Horace Knowles ©" ref="1:1">फिलिप्पियों को सहेर</figure><verse eid="PHP 1:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="PHP 1:2"/>आमरो बाबूजी परमेस्वर अना पिरभु यीसु मसीह कन लक तुमला दया अना सान्ती मिलत रव्हे।<verse eid="PHP 1:2"/></para>
  <para style="s">पौलुस को पिराथना अना धनवाद</para>
  <para style="p">
    <verse number="3" style="v" sid="PHP 1:3"/>मि जबा-जबा तुमला हेत करूसेऊ तबा-तबा आपरो परमेस्वर को धनवाद करासेऊ, <verse eid="PHP 1:3"/><verse number="4" style="v" sid="PHP 1:4"/>अना जबा कभी तुमी सबच को लाई बिनती करूसेऊ, ता हमेसा खुसी को संगा पिराथना करसेऊ। <verse eid="PHP 1:4"/><verse number="5" style="v" sid="PHP 1:5"/>एकोलाय की तुमी पयले दिवस लक आन के आज तकन साजरो बारता को फैलान मा मोरो संग रव्हसेव। <verse eid="PHP 1:5"/><verse number="6" style="v" sid="PHP 1:6"/>मोला यो गोस्टी को भरोसा से की जेने तुमी मा साजरो काम सुरू करीसेस वाच ओला यीसु मसीह को दिवस तकन पूरो करेत। <verse eid="PHP 1:6"/><verse number="7" style="v" sid="PHP 1:7"/>तुमी मोरो मन मा आय बसी सेव, एकोलाय का मि तुमी सब को लाई असोच बिचार करूसेऊ अना मोरी संग बंधन मा रव्हन मा अना साजरो बारता को लाई जवाब अना सबुती देवनो मा तुमी मोरो संगा धरमी अना दया मा संगी सेव। <verse eid="PHP 1:7"/><verse number="8" style="v" sid="PHP 1:8"/>ऐमा परमेस्वर मोरो गवाह से का मि मसीह यीसु को जसी माया राखके तुमरो सबको मोठो लालसा करासेऊ।<verse eid="PHP 1:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="PHP 1:9"/>मि यो पिराथना करासेऊ का तुमरो माया गियान अना सप्पा तरीका को अक्ल सकट अखीन भी बड़त जाय। <verse eid="PHP 1:9"/><verse number="10" style="v" sid="PHP 1:10"/>यहान तकन का तुमी साजरो लक साजरो गोस्टीहुन ला चहेतो जाननो, अना मसीह को दिवस तकन खरो बनयो रव्हो अना परख नोको जावनो। <verse eid="PHP 1:10"/><verse number="11" style="v" sid="PHP 1:11"/>ओना धरमिपन को फर लक जोन यीसु मसीह को कन लक होवासेत, भरपुर होवत जावो जोको काजी परमेस्वर को महिमा अना बड़ाई होवती रह।<verse eid="PHP 1:11"/></para>
  <para style="s">पौलुस को बँदी रव्हन लक साजरो बारता को बड़ावा</para>
  <para style="p">
    <verse number="12" style="v" sid="PHP 1:12"/>अगा भाऊगीन मि चाव्हसेऊ का तुमी जानलेव का मोरो पर जोन बीतयो से, ओकोलक साजरो बारता को बड़ावा भयी से। <verse eid="PHP 1:12"/><verse number="13" style="v" sid="PHP 1:13"/>यहान तकन का कैसर को राजभवन को सप्पा जनता अना बचयो सब लोकगीन मा यो दिसयो से। का मि मसीह मा बंधन मा सेव। <verse eid="PHP 1:13"/><verse number="14" style="v" sid="PHP 1:14"/>मोरो बेड़ी मा होवन को काजी उन मा लक कई लोकगीन पिरभु मा जोन मोरा भाऊ सेत, भरोसा बांधके परमेस्वर को बचन बिन डर को आयकावान को अखीन भी हिम्मत करासेत।<verse eid="PHP 1:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="PHP 1:15"/>काही ता छल अना झगड़ा को काजी मसीह को परचार करासेत अना काही भलो मरजी को काजी। <verse eid="PHP 1:15"/><verse number="16" style="v" sid="PHP 1:16"/>कई एक गीन ता असो जानके का मि साजरो बारता को लाई जवाब देवन को लाई राखयो गयो सेव, माया लक परचार करासेत। <verse eid="PHP 1:16"/><verse number="17" style="v" sid="PHP 1:17"/>अना कई एक ता सीधोपन लक नही पर बिरोध लक मसीह को कथा आयकोवासेत, असो सोचके का मोरो बंधन मा होवनो लक मोरो लाई संकट पैदा होहेत।<verse eid="PHP 1:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="PHP 1:18"/>ता का भयो? चाव्ह यो का हर तरीको लक, चाव्ह बहान लक चाव्ह खरो रूप लक, मसीह को कथा आयकावायो जावसे, अखीन मि एकोलक खुस सेव अना खुस रहूँ भी।<verse eid="PHP 1:18"/></para>
  <para style="s">जित्तो रव्हनो मसीह से</para>
  <para style="p">
    <verse number="19" style="v" sid="PHP 1:19"/>काहेका मि जानसेऊ का तुमरो पिराथना लक, अना यीसु मसीह को आतमा को दान कन लक एको फर मोरो सूटकारा होहे। <verse eid="PHP 1:19"/><verse number="20" style="v" sid="PHP 1:20"/>मि यो खुल्लो दिल लक मनसा अना आसा राखासेऊ का मि कोनी गोस्टी मा नोको सरमाऊ, पर मोरो तन लक हमेसा मसीह को बड़ाई मोठो ताकत लक होत रव्हे, अबा मि चाव्ह जित्तो रव्हु या मर जाहुँ, पर वसोच बड़ाई होवतो रव्हे। <verse eid="PHP 1:20"/><verse number="21" style="v" sid="PHP 1:21"/>काहेकि जित्तो रव्हनो मसीह से, अना मर जावनो फायदा से। <verse eid="PHP 1:21"/><verse number="22" style="v" sid="PHP 1:22"/>पर अदी तन मा जित्तो रव्हनोच मोरो काम को लाई फायदामन्द से ता मि नही जानासेऊ का कोन ला बेचूँ। <verse eid="PHP 1:22"/><verse number="23" style="v" sid="PHP 1:23"/>काहेकि मि दुही को बीच मा अथपर मा टँगीसेऊ; मरजी ता चलासे का हिटके मसीह को जवर जाऊ, काहेकि यो लगतच साजरो से। <verse eid="PHP 1:23"/><verse number="24" style="v" sid="PHP 1:24"/>पर आँग मा रव्हनो तुमरो काजी अखीन जरूरी से। <verse eid="PHP 1:24"/><verse number="25" style="v" sid="PHP 1:25"/>एकोलाय मोला असो भरोसा से ऐना रिती लक मि जानासेऊ की मि जित्तो रहुँ, अना तुमी सब को सँग रहुँ एना रिती लक तुमी भरोसा मा पक्को होता जाव अना ओमा खुसी रव्हो। <verse eid="PHP 1:25"/><verse number="26" style="v" sid="PHP 1:26"/>अखीन तुमी मोरो बारे मा जोन घमन्ड करोसो, मंग उ मोरो तुमरो जवर आवन को मंघा मसीह यीसु मा लगत बड़ जाये।<verse eid="PHP 1:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="PHP 1:27"/>एतरो करो का तुम्हारा चाल-चलन मसीह को साजरोबारता को काबिल होय का चाव्ह मि आयके तुमला चोऊ, चाव्ह नही आऊँ, तुमरो बारे मा योच आयकू का तुमी एकच आतमा मा पक्को सेव। अना एक चित्त भयके साजरो बारता को भरोसा को लाई मेहनत करत रव्हना। <verse eid="PHP 1:27"/><verse number="28" style="v" sid="PHP 1:28"/>अना कोनी गोस्टी मा बिरोधिगीन लक भय नही खावासो। यो उनको लाई सत्यानास को खुल्लो हिदान से, पर तुमरो लाई मुकती को अना यो परमेस्वर कन लक से। <verse eid="PHP 1:28"/><verse number="29" style="v" sid="PHP 1:29"/>काहेका मसीह काजी तुमी पर यो दया भयी का नाच ओको पर भरोसा करो पर ओको लाई दुख भी उचलो। <verse eid="PHP 1:29"/><verse number="30" style="v" sid="PHP 1:30"/>तुमला वसोच मेहनत करनो से, जसो तुमी ना मोला करता चोयोसेव, अना अबा भी आयकासेव का मि वसोच करूसेऊ।<verse eid="PHP 1:30"/></para>
  <chapter eid="PHP 1"/>
  <chapter number="2" style="c" sid="PHP 2"/>
  <para style="s">मसीह की रहम अना मोठो दिल</para>
  <para style="p">
    <verse number="1" style="v" sid="PHP 2:1"/>ऐना तरीका लक अदी मसीह मा काही सान्ती, अना माया लक हिम्मत, अना आतमा को संगती अना काही करूना अना दया से, <verse eid="PHP 2:1"/><verse number="2" style="v" sid="PHP 2:2"/>ता मोरो यो खुसी पूरी करो का एकच मन रव्हो, अना एकच माया, एकच चित, एकच मनसा एकच बिचार राखो। <verse eid="PHP 2:2"/><verse number="3" style="v" sid="PHP 2:3"/>बिरोध अना बनावटी बड़ाई को लाई काही नोको करो, पर दीनता लक एक दुजो ला साजरो समझो। <verse eid="PHP 2:3"/><verse number="4" style="v" sid="PHP 2:4"/>हर एक आपरो हित को नही, पर दुजो को हित को भी चिन्ता करेत। <verse eid="PHP 2:4"/><verse number="5" style="v" sid="PHP 2:5"/>जसो मसीह यीसु को बिचार, सुभाव होतो वसोच तुमरो भी सुभाव होय।<verse eid="PHP 2:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PHP 2:6"/>जेना परमेस्वर को खुदच रूप मा होयके भी,</para>
  <para style="q2" vid="PHP 2:6">परमेस्वर को बरोबर होवन को आपरो बस मा राखन को चीज नही समझीस।<verse eid="PHP 2:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PHP 2:7"/>पर आपरो खुदच ला काही नही असो कर देईस,</para>
  <para style="q2" vid="PHP 2:7">अना दास को खुदच रूप धारन कर लेईस,</para>
  <para style="q1" vid="PHP 2:7">अखीन गरीब मानूस को,</para>
  <para style="q2" vid="PHP 2:7">जसो बन गयो।<verse eid="PHP 2:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PHP 2:8"/>अखीन मानूस को रूप मा आयके आपरो आप ला खुदच दिनहिन कर लेईस, अना यहान तकन हुकूम मानन वालो रहयो की मिरतु हव,</para>
  <para style="q2" vid="PHP 2:8">कूरूस को मिरतु ला सह लेईस।<verse eid="PHP 2:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PHP 2:9"/>एने काजी परमेस्वर ना ओला लगत मोठो कर देईस,</para>
  <para style="q2" vid="PHP 2:9">अना ओला उ नाव दे दियो जोन सबच नावगीन मा वरता से।<verse eid="PHP 2:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PHP 2:10"/>काहेका जोन सरग मा अना धरती मा अना पाताल मा से,</para>
  <para style="q2" vid="PHP 2:10">वय सबच यीसु को नाव,</para>
  <para style="q2" vid="PHP 2:10">पर टोंगरा टेकेत।<verse eid="PHP 2:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PHP 2:11"/>अना परमेस्वर बाबूजी को बड़ाई को साठी हरेक जुबान कबुल करेहेत का,</para>
  <para style="q2" vid="PHP 2:11">यीसु मसीह च पिरभु से।<verse eid="PHP 2:11"/></para>
  <para style="s">संसार मा उजाडो जसो चमको</para>
  <para style="p">
    <verse number="12" style="v" sid="PHP 2:12"/>एकोलाई अगा मोरो चहेतो, जेना तरीका लक तुमी हमेसा लक हुकूम मानतो आयासेव, वसोच अबा भी नही केवल मोरो संग रव्हत हुयो पर खास रुप लक अबा मोरो दुहूर रव्हन पर भी भेव लक अना कापत हुयो आपरो-आपरो मुकती को काम पूरो करत जावो; <verse eid="PHP 2:12"/><verse number="13" style="v" sid="PHP 2:13"/>काहेकि परमेस्वर च से जोन ना आपरी साजरो मरजी को लाई तुमरो मन मा मरजी अना काम, दुही गोस्टी को करन को असर डाकीसेस। <verse eid="PHP 2:13"/><verse number="14" style="v" sid="PHP 2:14"/>सबच काम बगर कोसे अना बगर बिवाद को करने। <verse eid="PHP 2:14"/><verse number="15" style="v" sid="PHP 2:15"/>मजे तुमी निरदोस नेक अना सीधो होयके टेड़ो अना जिद्दी लोकगीन को बीच परमेस्वर को बेकसूर औलाद बनया रव्हो, जिनको बीच मा तुमी जिंदगी को बचन लियो हुयो संसार मा जलतो दियो को जसो दिससो।<verse eid="PHP 2:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="PHP 2:16"/>की मसीह को दिवस मोला घमन्ड करन को काजी होय की न मोरो दौड़ अना मोरो मेहनत करनो बेकार भयो।<verse eid="PHP 2:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="PHP 2:17"/>अदी मोला तुमरो भरोसा रुपी बलिदान अना सेवा को संगा आपरो खून भी बोहानो पड़ेह, मंग भी मि खुस सेऊ अना तुमी सब को संगा खुसी मनावसेऊ। <verse eid="PHP 2:17"/><verse number="18" style="v" sid="PHP 2:18"/>वसोच तुमी भी खुसी मनावो अना मोरो संगा खुस रव्हो।<verse eid="PHP 2:18"/></para>
  <para style="s">तीमुथियुस अना इपफ्रुदीतुस</para>
  <para style="p">
    <verse number="19" style="v" sid="PHP 2:19"/>मोला पिरभु यीसु मा आस से की मि तीमुथियुस ला तुमरो जवर तुरुतच धाड़ुह, जोकोलक तुमरो दसा आयक के मोला सान्ती मिलेह। <verse eid="PHP 2:19"/><verse number="20" style="v" sid="PHP 2:20"/>काहेकि अता मोरो जवर कोनी असो नाहती जो सुध्द मन लक तुमरी चिन्ता करहे। <verse eid="PHP 2:20"/><verse number="21" style="v" sid="PHP 2:21"/>काहेकि सबच आपरी सुवारत को खोज मा रव्हसेत, नाच यीसु मसीह की। <verse eid="PHP 2:21"/><verse number="22" style="v" sid="PHP 2:22"/>पर ओला ता तुमीना ता परखया सेव, अना जानच लेईसेव, की जसो टूरा बाबूजी को संगा करासे, वसोच ओना साजरो बारता को फैलावन मा मोरो संगा सेवा करीसेस। <verse eid="PHP 2:22"/><verse number="23" style="v" sid="PHP 2:23"/>एकोलाई मोला आस से का जसोच मोला जान पड़हेत का मोरी का दसा होहे, तसोच मि ओला तुरंत च धाड़ देहुँ। <verse eid="PHP 2:23"/><verse number="24" style="v" sid="PHP 2:24"/>अना मोला पिरभु मा भरोसा से की मि खुदच जल्दीच आहू।<verse eid="PHP 2:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="PHP 2:25"/>पर मिना इपफ्रुदीतुस ला जोन मोरो भाऊ अना संगकरमी अना संग को पेरीत अना तुमरो दूत अना कामवारी गोस्टी मा मोरी दास से, तुमरो जवर धाड़नो जरुरी समझियो। <verse eid="PHP 2:25"/><verse number="26" style="v" sid="PHP 2:26"/>काहेकि ओको मन लगत तुमी सबच मा लगयो होतो, यो काजी उ बैचेन रव्हत होतो, काहेकि तुमी ना ओकी बीमारी को हाल आयकिया होतो। <verse eid="PHP 2:26"/><verse number="27" style="v" sid="PHP 2:27"/>बाकई मा उ बीमार ता होय गयो होतो यहान तक का मरन पर होतो, पर परमेस्वर न ओको पर दया करीसेस, अना नाच केवल ओको पर, मोरो पर भी की मोला सोक पर सोक नही होहे। <verse eid="PHP 2:27"/><verse number="28" style="v" sid="PHP 2:28"/>एकोलाई मिना ओला धाड़न को अखीन भी कोसिस करियो की तुमी ओला मंग भेटके खुसी भयी जावो। अना मोरो भी सोक घट जाहे। <verse eid="PHP 2:28"/><verse number="29" style="v" sid="PHP 2:29"/>एकोलाई तुमी पिरभु मा ओला लगत खुसी को संग भेंट करने अना असोहुन को मान करने। <verse eid="PHP 2:29"/><verse number="30" style="v" sid="PHP 2:30"/>काहेकि उ मसीह को काम को लाई आपरो परान पर मुसीबत उचलके मिरतु को जवर आय गयो होतो मन्जे जोन घटी तुमरो कन लक मोरी सेवा मा हुयी ओला पूरो करो।<verse eid="PHP 2:30"/></para>
  <chapter eid="PHP 2"/>
  <chapter number="3" style="c" sid="PHP 3"/>
  <para style="s">खरो धारमिकता</para>
  <para style="p">
    <verse number="1" style="v" sid="PHP 3:1"/>एकोलाई अगा भाऊ मोला तुमला यो घड़ी-घड़ी लिखनो मा, काही दुख नही होवा का पिरभु मा खुसी रव्हो। काहेकि ऐमा तुमरो रक्सा होवासे। <verse eid="PHP 3:1"/><verse number="2" style="v" sid="PHP 3:2"/>कुतरा गीन, बुरो करनवारा गीन अना खोटो खतना लक सजग रव्हो। <verse eid="PHP 3:2"/><verse number="3" style="v" sid="PHP 3:3"/>खरो खतना वारा ता आमिच सेजन जोन परमेस्वर को आतमा मा भगती करसेजन, मसीह यीसु पर घमन्ड करसेजन अना तन पर भरोसा नही राखासेजन। <verse eid="PHP 3:3"/><verse number="4" style="v" sid="PHP 3:4"/>मि ता तन पर भरोसा राख सकत होतो। अदि कोनी को तन पर भरोसा राखन को बिचार से ता मोला ओकोलक कही लगत होय सकासे। <verse eid="PHP 3:4"/><verse number="5" style="v" sid="PHP 3:5"/>आठवो दिवस मोरो खतना भयो। इसरायल जाति को बिन्यामीन गोत को सेऊ। इबरानी हुन को इबरानी, नियम को कानुन पालनो को नजर लक फरिसी सेऊ। <verse eid="PHP 3:5"/><verse number="6" style="v" sid="PHP 3:6"/>कट्टरता को बारेमा मि कलीसिया को खूब सतावन वालो अना मोसे को नियम को धरमिपन को कन लक खरो अना निरदोस होतो। <verse eid="PHP 3:6"/><verse number="7" style="v" sid="PHP 3:7"/>पर जोन गोस्टी मोरो फायदा को होती उनला च मिना मसीह को काजी हानि समझ लेईसेउ। <verse eid="PHP 3:7"/><verse number="8" style="v" sid="PHP 3:8"/>एकोलक बड़के मि आपरो पिरभु यीसु मसीह को गियान को मोठो महिमा को काजी सबच गोस्टी ला बेकार समझासेउ। जोको काजी मिना सब चीजगीन को हानि उचली सेऊ। <verse eid="PHP 3:8"/><verse number="9" style="v" sid="PHP 3:9"/>मि ओनो धरमिपन लक मसीह मा पायो जाऊ जो मोसे को नियम लक नही पैदा होवासे पर मसीह पर बिस्वास करन लक मिलासे, मजे ओनो धारमिकता लक जो केवल भरोसा को साठी परमेस्वर लक मिलासे। <verse eid="PHP 3:9"/><verse number="10" style="v" sid="PHP 3:10"/>का मि ओको मिरतु को समानता ला पाय सकुह, जोकोलक ओको अना ओको जित्तो उचलन को ताकत ला अना ओको संगा दुखहुन मा संग होवन को भेद ला जान लेहुँ। <verse eid="PHP 3:10"/><verse number="11" style="v" sid="PHP 3:11"/>का मि भी मरयो हुयो को मंग लक जित्तो होवन ला पाय सकु।<verse eid="PHP 3:11"/></para>
  <para style="s">मसीहगीन लाई निसाना</para>
  <para style="p">
    <verse number="12" style="v" sid="PHP 3:12"/>यो नही की मोला मिल गयो से या पक्को होय गयो सेऊ पर मकसद ला पुरो करन लाई पुढा बड़त जावासेऊ जोन को लाई मसीह यीसु ना मोला धरयो होतो। <verse eid="PHP 3:12"/><verse number="13" style="v" sid="PHP 3:13"/>अगा भाऊगीन, मोरो सोच असो नहोय की मि पाय लेईसेउ पर यो एक काम करासेऊ की जो गोस्टी मंघा रव्ह गयीसेत, उनला भुलके पुढा को गोस्टी को कना बड़तो हुयो <verse eid="PHP 3:13"/><verse number="14" style="v" sid="PHP 3:14"/>निसाना कना धाव रहीसेऊ का उ ईनाम पाहुँ जोको लाई परमेस्वर ना मोला मसीह यीसु मा वरता हाकलीसेस।<verse eid="PHP 3:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="PHP 3:15"/>एकोलाई आमी मा लक जेतरो पक्को सेत योच बिचार राखेत, अना कोनी गोस्टी मा तुमरो अलग-अलग बिचार सेत ता परमेस्वर वोला भी तुम पर आन दिसाय देहे। <verse eid="PHP 3:15"/><verse number="16" style="v" sid="PHP 3:16"/>जेना नाप तक आमी पहुच गयी सेजन ओनाच लक आचरन करबिन।<verse eid="PHP 3:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="PHP 3:17"/>भाऊगीन तुमी सब मिलके मोरो जसो चाल चलो। अना उनला धियान लक दिसो, जोन ऐना रिती लक चलसेत। जेनको नमुना तुमी आमी मा दिससो। <verse eid="PHP 3:17"/><verse number="18" style="v" sid="PHP 3:18"/>काहेका मि तुम लक कई लोक खोटो चालचलन राखसेत। पुढा कई गन कव्ह चुकी सेऊ अना अबा भी रोय-रोय के कव्हसू की असा लगत सेत, जोन आपरो चाल चलन अना सुभाव लक मसीह को कूरूस को दुस्मन सेत। <verse eid="PHP 3:18"/><verse number="19" style="v" sid="PHP 3:19"/>उनको खातमा नास से, उनको पोट देवता से, वय आपरो बेसरमी को गोस्टी ला महिमा करासेत अना संसारिक चीजगीन पर मन लगाय रव्हसेती। <verse eid="PHP 3:19"/><verse number="20" style="v" sid="PHP 3:20"/>पर आमरो रव्हन साठी जघा सरग मा से, जहान लक आमी सुटकारा करनवालो पिरभु यीसु मसीह को आवन को रस्ता बड़ी बेसबरी लक कर रहया सेजन। <verse eid="PHP 3:20"/><verse number="21" style="v" sid="PHP 3:21"/>उ आपरी ताकत को असर लक जेनको लक उ सबच चीजगीन ला आपरो बस मा कर सकासे, आमरो दुखी तन सुखी तन को रूप बदल के, आपरो महिमा वालो तन जसो बनाय देहे।<verse eid="PHP 3:21"/></para>
  <chapter eid="PHP 3"/>
  <chapter number="4" style="c" sid="PHP 4"/>
  <para style="p">
    <verse number="1" style="v" sid="PHP 4:1"/>एकोलाई अगा मोरो चहेतो भाऊ तुमी जोन मोरो आँनद अना मुकुट सेव, तुमला चोवन ला मोरो जीव तरससे, हे चहेतोगीन, पिरभु मा ऐना रिति पक्को रव्हो।<verse eid="PHP 4:1"/></para>
  <para style="s">बरताव की सिक्सा</para>
  <para style="p">
    <verse number="2" style="v" sid="PHP 4:2"/>मि यूओदिया अना सन्तुखे दुही ला बिनती करासेऊ की वय पिरभु मा एक मन एक बिचार रव्हे। <verse eid="PHP 4:2"/><verse number="3" style="v" sid="PHP 4:3"/>अगा मोरो खरो संग करमी, मि तोला लक भी बिनती करासेऊ की तु ऐना आई माईगीन को सहायता करजोस जिन्होसीन मोरो संग अना क्लेमेन्स अना मोरो अखिन संग करमी सकट जिनको नाव जीवन को किताब मा लिखयो से, साजरो बारता को साठी मेहनत करीसेस।<verse eid="PHP 4:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="PHP 4:4"/>पिरभु मा हमेसा खुसी मनाव, मि मंग कव्हसू की खुसी मनाव।<verse eid="PHP 4:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="PHP 4:5"/>तुमरो कोमलता सब भला मानूस पर दिसायी जाहे। पिरभु जवर सेस। <verse eid="PHP 4:5"/><verse number="6" style="v" sid="PHP 4:6"/>कोनी भी गोस्टी को चिंता नोको करहो, पर हरेक गोस्टी मा पिराथना अना निवेदन लक तुमरो बिनती, धनवाद को संग परमेस्वर को पुढा पेस कियो जाहे। <verse eid="PHP 4:6"/><verse number="7" style="v" sid="PHP 4:7"/>तबा परमेस्वर को सान्ती, जो समझ लक हटके से, तुमरो हिरदय अना तुमरो बिचारहुन ला मसीह यीसु मा संभालके राखे।<verse eid="PHP 4:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="PHP 4:8"/>एकोलाई हे भाऊगीन जोन-जोन गोस्टी खरो सेत, अना सुहानो मान भाव को सेत अना जोन-जोन नियाव वारो सेत, जोन-जोन गोस्टी पवीतर सेत, जोन-जोन गोस्टी मन ला खुस करासेत अना साजरो अना बड़ाई वालो सेत उन ला मन लगाय राखो। <verse eid="PHP 4:8"/><verse number="9" style="v" sid="PHP 4:9"/>जोन काही तुमना मोरो लक सीखयासेव अना अपनायो सेव, आयकिया अना चोयासेव, उनको मंघा चलोह अना परमेस्वर जो सान्ती को सोता से, तुमरो संगा रह।<verse eid="PHP 4:9"/></para>
  <para style="s">दान को लाई धनवाद</para>
  <para style="p">
    <verse number="10" style="v" sid="PHP 4:10"/>मि पिरभु मा लगत धनवाद देवसेऊ का एतरो दिवस को मंघा मोरो लाई तुमरो चिन्ता मंग लक जाग गयी से। एमा बगर संका को पयलेच तुमला मोरो चिन्ता होतो पर यो बिचार ला सांगन लाई मौका नही मिलयो। <verse eid="PHP 4:10"/><verse number="11" style="v" sid="PHP 4:11"/>मि आपरो कोनी कमी को लाई यो नही कव्हसू, काहेका मिना हरेक हाल मा संतोस रव्हनो सीक लेईसेउ। <verse eid="PHP 4:11"/><verse number="12" style="v" sid="PHP 4:12"/>मि हिनो दसा अना भरयो पुरयो दसा मा रव्हनो जानासेऊ, हरेक गोस्टी अना हरेक हाल मा मिना संतोस होवनो भुखो रव्हनो अना घटनो बढनो सीक लेईसेऊ <verse eid="PHP 4:12"/><verse number="13" style="v" sid="PHP 4:13"/>जो मोला ताकत देवासे ओको लक मि सबच काही कर सकासेउ।<verse eid="PHP 4:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="PHP 4:14"/>मंगच तुमना भलो करयासेव का मोरो दुख मा संगी रहयात। <verse eid="PHP 4:14"/><verse number="15" style="v" sid="PHP 4:15"/>अगो फिलिप्पिन हुन, जसो का तुमी खुदच जानासेव, साजरो बारता को पिरचार को काम मा जबा मि मकीदुनिया लक सार भयो ता तुमला छोड़ कोनी अखिन कलीसिया लेवन देन को बारे मा मोरो संगा सामिल नही भयी। <verse eid="PHP 4:15"/><verse number="16" style="v" sid="PHP 4:16"/>ऐना रिती लक थिस्सलुनीके नगर मा भी तुमना मोरो सहायता को लाई एकच गन नहि, पर कई गन धन धाड़यात। <verse eid="PHP 4:16"/><verse number="17" style="v" sid="PHP 4:17"/>यो गोस्टी नोहोय की मि धन चाव्हसेउ, पर असो फर चाव्हसेउ जोन तुमरो लाभ को लाई बड़तो जाये। <verse eid="PHP 4:17"/><verse number="18" style="v" sid="PHP 4:18"/>मोरो जवर सब काही से अना लगत से। तुमना इपफ्रुदीतुस को हात लक जोन दान धाड़ीसेव वोला पायके मि संतोस सेऊ। उ ता मन ला खुस कर देवन वालो खुसबु अना अपनायो जावन वालो बलिदान से, जोको लक परमेस्वर खुस होवासे। <verse eid="PHP 4:18"/><verse number="19" style="v" sid="PHP 4:19"/>मोरो परमेस्वर भी आपरो ओना धन लक जो महिमा सकट मसीह यीसु मा से तुमरो हरेक जरुरत ला पूरी करेत। <verse eid="PHP 4:19"/><verse number="20" style="v" sid="PHP 4:20"/>आमरो परमेस्वर अना बाबूजी को महिमा जुग-जुग तकन होवत रव्हे। आमेन।<verse eid="PHP 4:20"/></para>
  <para style="s">आखरी नमस्कार</para>
  <para style="p">
    <verse number="21" style="v" sid="PHP 4:21"/>हरेक पवीतर मानूस ला जोन मसीह यीसु मा से, मोरो नमस्कार। जोन मोरो संगी भाऊ से, तुमला नमस्कार कव्हसेजन। <verse eid="PHP 4:21"/><verse number="22" style="v" sid="PHP 4:22"/>सब पवीतर लोकगीन को, खास रीतीलक कैसर को घराना को, तुमला नमस्कार! <verse eid="PHP 4:22"/><verse number="23" style="v" sid="PHP 4:23"/>पिरभु यीसु मसीह को किरपा तुमरो आतमा को संग रव्हे।<verse eid="PHP 4:23"/></para>
  <chapter eid="PHP 4"/>
</usx>
