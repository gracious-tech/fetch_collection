\v 4  \w Les|strong="H3068"\w* \w grenouilles|strong="H6854"\w* monteront \w sur|strong="H3068"\w* \w toi|strong="H3068"\w*, \w sur|strong="H3068"\w* \w ton|strong="H3068"\w* \w peuple|strong="H5971"\w* \w et|strong="H3068"\w* \w sur|strong="H3068"\w* \w tous|strong="H5971"\w* \w tes|strong="H3068"\w* \w serviteurs|strong="H7121"\w*. »'"  
\v 5 Yahvé \w dit|strong="H4872"\w* \w à|strong="H1004"\w* \w Moïse|strong="H4872"\w* : « Dis \w à|strong="H1004"\w* \w Aaron|strong="H4872"\w* : « Étends \w la|strong="H5921"\w* main \w de|strong="H1004"\w* \w ta|strong="H5921"\w* verge \w sur|strong="H5921"\w* \w les|strong="H1004"\w* \w rivières|strong="H2975"\w*, \w sur|strong="H5921"\w* \w les|strong="H1004"\w* \w ruisseaux|strong="H2975"\w* \w et|strong="H4872"\w* \w sur|strong="H5921"\w* \w les|strong="H1004"\w* étangs, \w et|strong="H4872"\w* \w fais|strong="H3772"\w* \w monter|strong="H1004"\w* \w les|strong="H1004"\w* \w grenouilles|strong="H6854"\w* \w sur|strong="H5921"\w* \w le|strong="H5971"\w* \w pays|strong="H5971"\w* d'Égypte. »"  
\v 6  \w Aaron|strong="H3068"\w* étendit \w sa|strong="H3068"\w* \w main|strong="H3068"\w* \w sur|strong="H3068"\w* \w les|strong="H3068"\w* eaux d'Égypte ; \w les|strong="H3068"\w* grenouilles montèrent \w et|strong="H3068"\w* couvrirent \w le|strong="H3068"\w* \w pays|strong="H3068"\w* d'Égypte.  
