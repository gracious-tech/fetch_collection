\v 8  \w Alors|strong="H3318"\w* \w Pharaon|strong="H6547"\w* \w appela|strong="H7760"\w* \w Moïse|strong="H4872"\w* \w et|strong="H3068"\w* \w Aaron|strong="H4872"\w*, \w et|strong="H3068"\w* \w dit|strong="H1697"\w* : « Prie Yahvé \w qu|strong="H1697"\w*'\w il|strong="H3068"\w* éloigne \w les|strong="H3068"\w* \w grenouilles|strong="H6854"\w* \w de|strong="H1697"\w* \w moi|strong="H3318"\w* \w et|strong="H3068"\w* \w de|strong="H1697"\w* \w mon|strong="H3068"\w* \w peuple|strong="H3318"\w* ; \w et|strong="H3068"\w* \w je|strong="H3068"\w* \w laisserai|strong="H3068"\w* \w aller|strong="H3318"\w* \w le|strong="H3068"\w* \w peuple|strong="H3318"\w* \w pour|strong="H3318"\w* \w qu|strong="H1697"\w*'\w il|strong="H3068"\w* sacrifie \w à|strong="H3068"\w* Yahvé. »   
\p
\v 9  \w Moïse|strong="H4872"\w* \w dit|strong="H1697"\w* \w à|strong="H3068"\w* Pharaon : « \w Je|strong="H3068"\w* \w te|strong="H3068"\w* \w fais|strong="H6213"\w* l'honneur \w de|strong="H1004"\w* fixer \w le|strong="H3068"\w* \w moment|strong="H3068"\w* \w où|strong="H1004"\w* \w je|strong="H4191"\w* prierai \w pour|strong="H6213"\w* \w toi|strong="H3068"\w*, \w pour|strong="H6213"\w* \w tes|strong="H6213"\w* \w serviteurs|strong="H6213"\w* \w et|strong="H3068"\w* \w pour|strong="H6213"\w* \w ton|strong="H6213"\w* \w peuple|strong="H3068"\w*, \w afin|strong="H3068"\w* \w que|strong="H1697"\w* \w les|strong="H3068"\w* \w grenouilles|strong="H6854"\w* \w soient|strong="H1697"\w* détruites \w chez|strong="H1004"\w* \w toi|strong="H3068"\w* \w et|strong="H3068"\w* \w dans|strong="H6213"\w* \w tes|strong="H6213"\w* \w maisons|strong="H1004"\w*, \w et|strong="H3068"\w* \w qu|strong="H1697"\w*'\w elles|strong="H3068"\w* \w ne|strong="H3068"\w* restent \w que|strong="H1697"\w* \w dans|strong="H6213"\w* \w le|strong="H3068"\w* fleuve. »   
\p
\v 10 Pharaon \w a|strong="H3068"\w* dit : « Demain. »  
\p Moïse dit : « Qu'il en soit ainsi, afin que vous sachiez qu'il n'y \w a|strong="H3068"\w* personne comme Yahvé notre Dieu.  
\v 11  \w Les|strong="H3068"\w* grenouilles s'éloigneront \w de|strong="H3820"\w* \w vous|strong="H3068"\w*, \w de|strong="H3820"\w* \w vos|strong="H8085"\w* \w maisons|strong="H3068"\w*, \w de|strong="H3820"\w* \w vos|strong="H8085"\w* serviteurs \w et|strong="H3068"\w* \w de|strong="H3820"\w* \w votre|strong="H1961"\w* \w peuple|strong="H3068"\w*. \w Elles|strong="H3588"\w* \w ne|strong="H3808"\w* \w resteront|strong="H1961"\w* \w que|strong="H3588"\w* \w dans|strong="H7200"\w* \w le|strong="H3068"\w* fleuve. »   
\p
