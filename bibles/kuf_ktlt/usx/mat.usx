  <book code="MAT" style="id">EN_KTLT kuf_Katu,⋅Western_ltr Wed Mar 05 2025 09:34:19 GMT+0700 (Indochina Time) tc</book>
  <para style="usfm">3.0</para>
  <para style="ide">UTF-8</para>
  <para style="h">Matthew</para>
  <para style="toc1">Taruuih Liêm Ma-thi-ơ</para>
  <para style="toc2">Ma-thi-ơ</para>
  <para style="toc3">Mat</para>
  <para style="mt">Ma-thi-ơ</para>
  <chapter number="1" style="c" sid="MAT 1" />
  <para style="p">
    <verse number="1" style="v" sid="MAT 1:1" />Bha-aar dhong nooi ưng Jê-su Chuôq Paq Manưih, akóón chachau Đa-viit, akóón chachau Ap-ra-haam: <verse eid="MAT 1:1" /><verse number="2" style="v" sid="MAT 1:2" />Ap-ra-haam n'niên I-saak; I-saak n'niên Ja-kôôp; Ja-kôôp n'niên Ju-đa lơq adhi anó ưng ađó; <verse eid="MAT 1:2" /><verse number="3" style="v" sid="MAT 1:3" />Ju-đa tââq Ta-ma n'niên Phê-rêêt lơq Sê-rech, Phê-rêêt n'niên Hêt-rôôn, Hêt-rôôn n'niên A-raam. <verse eid="MAT 1:3" /><verse number="4" style="v" sid="MAT 1:4" />A-raam n'niên A-mi-na-đaap, A-mi-na-đaap n'niên Na-et-soon, Na-et-soon n'niên Senh-môôn, <verse eid="MAT 1:4" /><verse number="5" style="v" sid="MAT 1:5" />Senh-môôn tââq Ra-haap n'niên Bô-ô, Bô-ô tââq Ru-tơ n'niên Ô-bêêt, Ô-bêêt n'niên Je-sê, <verse eid="MAT 1:5" /><verse number="6" style="v" sid="MAT 1:6" />Je-sê n'niên bhua Đa-viit, Đa-viit tââq kađiêl ưng U-ri n'niên Sa-lô-môôn,<verse eid="MAT 1:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 1:7" />Sa-lô-môôn n'niên Rô-bô-aam, Rô-bô-aam n'niên A-bi-ja, A-bi-ja n'niên A-sa, <verse eid="MAT 1:7" /><verse number="8" style="v" sid="MAT 1:8" />A-sa n'niên Jô-sa-phaat, Jô-sa-phaat n'niên Jô-raam, Jô-raam n'niên Ô-xia. <verse eid="MAT 1:8" /><verse number="9" style="v" sid="MAT 1:9" />Ô-xia n'niên Jô-taam, Jô-taam n'niên A-cha, A-cha n'niên Ê-xê-chia, <verse eid="MAT 1:9" /><verse number="10" style="v" sid="MAT 1:10" />Ê-xê-chia n'niên Ma-na-se, Ma-na-se n'niên A-môôn, A-môôn n'niên Jô-si-a, <verse eid="MAT 1:10" /><verse number="11" style="v" sid="MAT 1:11" />Jô-si-a n'niên Jê-kô-nia lơq adhi anó ưng ađó mót galuh đââng têêng xól leq Ba-bi-lôôn,<verse eid="MAT 1:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 1:12" />lơq xong galuh đââng têêng xól leq Ba-bi-lôôn, Jê-kô-nia n'niên Sa-la-thi-êên, Sa-la-thi-êên n'niên Xô-rô-ba-bêên, <verse eid="MAT 1:12" /><verse number="13" style="v" sid="MAT 1:13" />Xô-rô-ba-bêên n'niên A-bi-uut, A-bi-uut n'niên Ê-li-a-kiim, Ê-li-a-kiim n'niên A-xô, <verse eid="MAT 1:13" /><verse number="14" style="v" sid="MAT 1:14" />A-xô n'niên Sa-đôk, Sa-đôk n'niên A-chiim, A-chiim n'niên Ê-li-uut, <verse eid="MAT 1:14" /><verse number="15" style="v" sid="MAT 1:15" />Ê-li-uut n'niên Ê-lê-a-xa, Ê-lê-a-xa n'niên Ma-thaan, Ma-thaan n'niên Ja-kôôp, <verse eid="MAT 1:15" /><verse number="16" style="v" sid="MAT 1:16" />Ja-kôôp n'niên Jô-seep, kayiik ưng Ma-ri, hơq tââq ađó, Chuôq Jê-su, Yaang bâân đóók nek Chuôq Paq Manưih, bâân yuur n'niên. <verse eid="MAT 1:16" /><verse number="17" style="v" sid="MAT 1:17" />Kơi achêk, tabhơt nôôq klaang đơơi tââq Ap-ra-haam tơk Đa-viit nek majêt puôn klaang đơơi, tââq Đa-viit tơk galuh đââng têêng xól leq Ba-bi-lôôn nek majêt puôn klaang đơơi, lơq tââq galuh đââng têêng xól leq Ba-bi-lôôn tơk Chuôq Paq Manưih nek majêt puôn klaang đơơi.<verse eid="MAT 1:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 1:18" />Rau dhaluônh n'niên ưng Jê-su Chuôq Paq Manưih nek kơi ađô: Xók Ma-ri, akan Ađó, ơi hươq đóng palơq Jô-seep, bơơi xók bhêêl nhiđó kah ơi cha tơơt palơq xóng nhiđó, ađó bâân n'nal ve đađââng nek tââq Chuôq Yaang Liêm. <verse eid="MAT 1:18" /><verse number="19" style="v" sid="MAT 1:19" />Dyơq Jô-seep, kayiik ađó, nek manưih bhơt liêm, lơq taai kah kiêng pakah đóng palââng n'nal ađó, Jô-seep kanóq lơơi lalââp Ma-ri. <verse eid="MAT 1:19" /><verse number="20" style="v" sid="MAT 1:20" />Bơơi xók ađó dyơq kanóq leq nôôq tarnêêng achêk, nek hơq lêi tôôh, dhơn pleng ưng Chuôq tabhral palơq ađó kalóng parnó m'pó, kayua: “Jô-seep, akóón chachau Đa-viit, amei óóq ka-chiit pei Ma-ri têêng kađiêl, taai akóón paniên bâân đađââng kalóóng ađó achêk nek ơi tââq Chuôq Yaang Liêm. <verse eid="MAT 1:20" /><verse number="21" style="v" sid="MAT 1:21" />Ađó achêk e n'niên mưi akóón padruuih, lơq amei e đóók achak akóón nek Jê-su, ơi akóón achêk e paq dhanuôr ađêi gluh tââq matu lơt piđó.” <verse eid="MAT 1:21" /><verse number="22" style="v" sid="MAT 1:22" />Dyóp tarnêêng ađô yuur vaaih buôn bâân têêng tajaap rau ơi bâân Chuôq praaq dhiq manưih đââng taruuih, kơi ađô:<verse eid="MAT 1:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="MAT 1:23" />“Nek lêi tôôh, pađiil kamór e ve đađââng lơq n'niên mưi akóón padruuih, lơq palââng e đóók dhanóók Ađó nek Em-ma-nu-êên” — bâân lók nek “Yaang Pleng tơơt palơq nôôq he.”<verse eid="MAT 1:23" /></para>
  <para style="b" />
  <para style="m">
    <verse number="24" style="v" sid="MAT 1:24" />Hayơq xong xók bâân taach mat tââq bhanêch bêch, Jô-seep ơi têêng i kơi dhơn pleng ưng Chuôq ơi praaq pató lơq pei pađiil achêk têêng kađiêl ađêi. <verse eid="MAT 1:24" /><verse number="25" style="v" sid="MAT 1:25" />Bơơi ađó kah cha tơơt palơq pađiil achêk đóng tơk xók ađó n'niên mưi akóón padruuih. Hayơq ađó đóók achak akóón achêk nek Jê-su.<verse eid="MAT 1:25" /></para>
  <chapter eid="MAT 1" />
  <chapter number="2" style="c" sid="MAT 2" />
  <para style="p">
    <verse number="1" style="v" sid="MAT 2:1" />Xong xók Chuôq Jê-su ơi bâân n'niên dhiq Bêêt-lê-heem parah Ju-đê kalóóng đơơi bhua Hê-rôôt, nek phaai lêi tôôh, nôôq manưih đu tarbech tââq charhóóng mat blo tơk dhiq Jê-ru-sa-leem, <verse eid="MAT 2:1" /><verse number="2" style="v" sid="MAT 2:2" />tamóh kơi ađô: “Yaang ơi bâân yuur n'niên nek bhua dhanuôr Jo Thaaiq tơơt n'dhiq? Ơi nôôq yi ơi lêi chatur xamenh ưng Ađó dhiq charhóóng mat blo lơq tơk buôn bhuôih haanh Ađó.” <verse eid="MAT 2:2" /><verse number="3" style="v" sid="MAT 2:3" />Bơơi xong xók xâng rau achêk, bhua Hê-rôôt bâân karaang kakhin, lơq tabhơt kanóón Jê-ru-sa-leem kung kơi ađó. <verse eid="MAT 2:3" /><verse number="4" style="v" sid="MAT 2:4" />Hayơq xong xók kayua dhaloong tabhơt nôôq takóh kala kadhâng bhanuôih lơq nôôq manưih pachóóm gani kalóóng dhanuôr, ađó tho tamóh piđó: “Chuôq Paq bâân n'niên n'đó dhiq?” <verse eid="MAT 2:4" /><verse number="5" style="v" sid="MAT 2:5" />Piđó ââi palơq bhua: “Dhiq Bêêt-lê-heem parah Ju-đê, taai ơi bâân xaraq kơi achêk tââq manưih đââng taruuih,<verse eid="MAT 2:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="MAT 2:6" />‘Dyơq Bêêt-lê-heem, katiêk Ju-đa,</para>
  <para style="q1" vid="MAT 2:6">amei eh rau nek katưưiq kiêt kalóóng kabhuh têêng gamak ưng Ju-đa,</para>
  <para style="q1" vid="MAT 2:6">ơi tââq amei e gluh mưi Yaang têêng kala</para>
  <para style="q1" vid="MAT 2:6">nek Yaang e jư kađââng I-sơ-ra-êên, dhanuôr Aku.’”<verse eid="MAT 2:6" /></para>
  <para style="b" />
  <para style="m">
    <verse number="7" style="v" sid="MAT 2:7" />Bhêêl ađek, xong xók kadrêi lalââp dhaloong nôôq manưih đu tarbech tơk, Hê-rôôt tho tamóh piđó ganah m'bhêêl yuur vaaih ưng chatur xamenh. <verse eid="MAT 2:7" /><verse number="8" style="v" sid="MAT 2:8" />Xók ơi lơơi piđó vôôiq tơk Bêêt-lê-heem, ađó pató: “Xong xók vôôiq, nôôq pe nek tho tamóh pagiit pagóói leq akóón paniên. Hayơq bhêêl nôôq pe ơi bâân lêi, nek móón đóng aku buôn aku kung tơk bhi kakoh Ađó.” <verse eid="MAT 2:8" /><verse number="9" style="v" sid="MAT 2:9" />Xong xók ơi xâng bhua, piđó bâân yuur vôôiq, lơq nek lêi tôôh, chatur xamenh hơq piđó ơi chalaang lêi tơơt hót mat blo vôôiq laloom piđó đóng tơk xók ơi bhral nek ađó kayơng parngau dhiq dham akóón paniên tơơt. <verse eid="MAT 2:9" /><verse number="10" style="v" sid="MAT 2:10" />Xók ơi ve lêi chatur xamenh, piđó yayar marhaal kalóóng rau bhuui lóng pabhlơng. <verse eid="MAT 2:10" /><verse number="11" style="v" sid="MAT 2:11" />Xong xók mót kalóóng đong, piđó lêi akóón paniên palơq Ma-ri, amêêq Ađó. Hayơq n'drươh ơi chakoh tarkól nek piđó bhuôih haanh Ađó, lơq xók ơi lương pagluh drươp karvaan ưng ađêi, piđó tapôông leq Ađó nôôq đô-bhanuôih: vaang, dhaak galơu lơq dyet thum. <verse eid="MAT 2:11" /><verse number="12" style="v" sid="MAT 2:12" />Lơq taai ơi bâân kamêch óóq palâh val lóóiq palơq Hê-rôôt kalóóng mưi parnó m'pó, piđó chô katiêk ađêi hót kalơng lââng.<verse eid="MAT 2:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 2:13" />Bhêêl piđó ơi yuur vôôiq, nek phaai lêi tôôh, mưi dhơn pleng ưng Chuôq tabhral pakah palơq Jô-seep dhiq mưi parnó m'pó, móón kơi ađô: “Xong xók yuur meh, nek đââng ting ađêi akóón paniên palơq amêêq akóón paniên achêk lơq paklôôn leq Ai Kơp, hayơq phaai tơơt lóóiq dhiq ađek đóng tơk nh'xók aku kayua amei, taai Hê-rôôt kanóq tabâân akóón paniên buôn leng vaq.” <verse eid="MAT 2:13" /><verse number="14" style="v" sid="MAT 2:14" />Hayơq xong xók yuur blââk, ađó ơi đââng akóón paniên palơq amêêq Ađó klôôn leq Ai Kơp kalóóng hayum, <verse eid="MAT 2:14" /><verse number="15" style="v" sid="MAT 2:15" />lơq ađó tơơt lóóiq dhiq ađek đóng tơk xók Hê-rôôt ơi chêt, achêk nek buôn bâân tajaap paraaq rau ơi bâân praaq tââq Chuôq dhiq manưih đââng taruuih, kơi ađô: “Aku ơi dhaloong akóón Aku gluh tââq Ai Kơp.”<verse eid="MAT 2:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 2:16" />Bhêêl achêk, xók lêi kơi ađêi ơi bâân nôôq manưih đu tabech bharlưưk kađiq, Hê-rôôt lóng môôp lóóm, xong xók đââng taruuih vôôiq, ađó leng chêt tabhơt nôôq paniên padruuih tââq bơơr tuôi leq chooh dhiq Bêêt-lê-heem lơq tabhơt kalóóng xưưq ưng parah ađek, ting kơi ganah bhêêl hơq ađó ađek tho tamóh tââq nôôq manưih đu tabech. <verse eid="MAT 2:16" /><verse number="17" style="v" sid="MAT 2:17" />Kơi achêk nek bâân tajaap paraaq rau ơi bâân praaq tââq Jê-rê-mi manưih đââng taruuih, kơi ađô:<verse eid="MAT 2:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="MAT 2:18" />“Mưi dhariêng dhaloong bâân xâng lêi kalóóng kanóón Ra-ma,</para>
  <para style="q" vid="MAT 2:18">dhariêng chaxih kagôh lơq ta-óóh taxung karuôq lóóm, Ra-chêên nhiim đóng nôôq akóón ađêi,</para>
  <para style="q" vid="MAT 2:18">lơq ađó kah đơơp bâân tabhơơl, taai piđó kah dyơq ve.”<verse eid="MAT 2:18" /></para>
  <para style="b" />
  <para style="p">
    <verse number="19" style="v" sid="MAT 2:19" />Bhêêl achêk, xók Hê-rôôt ơi chêt, nek phaai lêi tôôh, mưi dhơn pleng ưng Chuôq tabhral palơq Jô-seep tââq mưi parnó m'pó dhiq Ai Kơp, <verse eid="MAT 2:19" /><verse number="20" style="v" sid="MAT 2:20" />móón kơi ađô: “Xók ơi taach mat yuur, phaai đââng ting ađêi akóón paniên palơq amêêq akóón paniên achêk lơq vôôiq tơk katiêk I-sơ-ra-êên, ơi nôôq đu tabâân leng parhââm ưng akóón paniên ơi chêt.” <verse eid="MAT 2:20" /><verse number="21" style="v" sid="MAT 2:21" />Hayơq xók ơi yuur blââk, ađó đââng ting ađêi akóón paniên palơq amêêq Ađó, lơq mót kalóóng katiêk I-sơ-ra-êên. <verse eid="MAT 2:21" /><verse number="22" style="v" sid="MAT 2:22" />Dhơ kơi ađek, xók xâng kơi A-chê-la-u xók têêng kala dhiq parah Ju-đê klóóih đóng Hê-rôôt, ama ađêi, ađó kakhin vôôiq tơk leq ađek. Bơơi xók ơi bâân kamêch dhiq parnó m'pó, ađó val chô parah Ga-li-lê, <verse eid="MAT 2:22" /><verse number="23" style="v" sid="MAT 2:23" />lơq xók ơi tơk ađek hayơq, ađó tơơt mamông kalóóng mưi kanóón bâân đóók nek Na-xa-reet, buôn bâân tajaap paraaq rau ơi bâân praaq dhiq nôôq manưih đââng taruuih, kơi Ađó e bâân đóók nek manưih Na-xa-reet.<verse eid="MAT 2:23" /></para>
  <chapter eid="MAT 2" />
  <chapter number="3" style="c" sid="MAT 3" />
  <para style="p">
    <verse number="1" style="v" sid="MAT 3:1" />Kalóóng nôôq tangêi ađek, Jang Bap-tiit tơk truuih taruuih kalóóng kruung vơng parah Ju-đê, <verse eid="MAT 3:1" /><verse number="2" style="v" sid="MAT 3:2" />kơi ađô: “Phaai klôôq lóóm, taai katiêk pleng ơi đan.” <verse eid="MAT 3:2" /><verse number="3" style="v" sid="MAT 3:3" />Ơi ađôk nek manưih ơi bâân praaq tơk tââq Ê-saai manưih đââng taruuih, kơi ađô:</para>
  <para style="q" vid="MAT 3:3">“Ve dhariêng dhaloong karơ kalóóng kruung vơng:</para>
  <para style="q" vid="MAT 3:3">‘Phaai dhoon lơơi kalơng ưng Chuôq,</para>
  <para style="q" vid="MAT 3:3">phaai têêng đóng tapat nôôq charlah Ađó.’”<verse eid="MAT 3:3" /></para>
  <para style="b" />
  <para style="m">
    <verse number="4" style="v" sid="MAT 3:4" />Jang ađô xơp aau tââq xok kamel, xeet janiich palơq ng'kar praang tarveng, dyơq tarmông ưng ađó nek amiit lơq đơơk gayơơiq booiq. <verse eid="MAT 3:4" /><verse number="5" style="v" sid="MAT 3:5" />Hayơq dhanuôr kanóón Jê-ru-sa-leem, tabhơt parah Ju-đê lơq tabhơt parah pruq praang xirvir karuung Jô-đen tơk palơq ađó, <verse eid="MAT 3:5" /><verse number="6" style="v" sid="MAT 3:6" />lơq xók bhêêl truuih matu ađêi, piđó bâân ađó têêng bap-teem dhiq karuung Jô-đen. <verse eid="MAT 3:6" /><verse number="7" style="v" sid="MAT 3:7" />Xong xók ve lêi bơk manưih Pha-ri-si lơq Sa-đu-sê tơk ơi pheep bap-teem ưng ađêi, ađó móón palơq piđó: “Kabhuh akóón chachau ưng kaxênh ve chapââr tôôh! Ngaai ơi kamêch nôôq pe klôôn mut tââq galuh pagrâ janah ravang tơk? <verse eid="MAT 3:7" /><verse number="8" style="v" sid="MAT 3:8" />Kơi achêk hayơq, phaai mayưưm đóng đaang palơq klôôq lóóm. <verse eid="MAT 3:8" /><verse number="9" style="v" sid="MAT 3:9" />Lơq nôôq pe kung óóq ngóq hơq tapraaq xóng ađêi: ‘Nôôq he ve abhươp avuôq Ap-ra-haam.’ Ơi aku móón palơq nôôq pe nek Yaang Pleng ve chóóm yuur paxar akóón chachau đóng Ap-ra-haam tââq nôôq khuk dhơl ađô. <verse eid="MAT 3:9" /><verse number="10" style="v" sid="MAT 3:10" />Bơơi pla chuung ơi bâân ng'gơq dhiq gađơr n'lóóng. Đóng hayơq, tabhơt nôôq n'lóóng la kah bóóng pale liêm nek bâân takươl kalơm lơq m'peq leq óih. <verse eid="MAT 3:10" /><verse number="11" style="v" sid="MAT 3:11" />Aku têêng bap-teem leq rau klôôq lóóm đóng adhi anó palơq đơơk. Bơơi Yaang tơk tatun aku ve mataai raman lơh aku, leq Yaang achêk nek aku hơq đu kah chóóm đaang buôn tayel jêi ưng Ađó. Ađó e têêng bap-teem đóng adhi anó palơq Chuôq Yaang Liêm lơq palơq óih; <verse eid="MAT 3:11" /><verse number="12" style="v" sid="MAT 3:12" />beq chraauq ưng Ađó dhiq kalóóng têi Ađó, hayơq Ađó e kaau sek se taang m'bhrah aviq ađêi lơq karong aviq ưng Ađó leq jơơng. Bơơi Ađó e óch róh n'drang palơq óih kah mơ chóóm đuôh tapat.”<verse eid="MAT 3:12" /></para>
  <para style="b" />
  <para style="p">
    <verse number="13" style="v" sid="MAT 3:13" />Bhêêl achêk, Chuôq Jê-su vôôiq tââq xưưq Ga-li-lê tơk karuung Jô-đen, dhiq ưng Jang, buôn bâân ađó têêng bap-teem. <verse eid="MAT 3:13" /><verse number="14" style="v" sid="MAT 3:14" />Bơơi Jang bhiêk mưi kơi kadhuông kajơq Ađó kơi ađô: “Aku hayơq ve chóóm kiêng bâân Amei têêng bap-teem đóng, kơi achêk hơq Amei vil tơk palơq aku hơ?” <verse eid="MAT 3:14" /><verse number="15" style="v" sid="MAT 3:15" />Bơơi xók ââi lóóiq, Chuôq Jê-su praaq palơq ađó: “Xók ađôk, phaai têêng kơi achêk nek, ơi kơi achêk nek pâng dhalam palơq nôôq he buôn têêng paxong dyóp rau bhơt liêm.” Hayơq Ađó lơơi Jang têêng. <verse eid="MAT 3:15" /><verse number="16" style="v" sid="MAT 3:16" />Xók achêk, xong xók đơơp bap-teem hayơq, Chuôq Jê-su n'drươh yuur tââq đơơk, lơq lêi tôôh, nôôq talaang pleng bâân tayaah đóng Ađó, hayơq Ađó ve lêi Yaang Liêm ưng Yaang Pleng dhaluônh jaq thê kơi achim paraap, bóq dhiq Ađó, <verse eid="MAT 3:16" /><verse number="17" style="v" sid="MAT 3:17" />lơq lêi tôôh, mưi dhariêng praaq tââq nôôq talaang pleng kơi ađô: “Ađôk nek Akóón nh'nhơr bhlơng ưng Aku. Aku iêm lóóm dhiq Akóón achêk.”<verse eid="MAT 3:17" /></para>
  <chapter eid="MAT 3" />
  <chapter number="4" style="c" sid="MAT 4" />
  <para style="p">
    <verse number="1" style="v" sid="MAT 4:1" />Hayơq Chuôq Jê-su bâân đââng mót kruung vơng tââq Yaang Liêm buôn đơơp abhưi dharơơl galơơk. <verse eid="MAT 4:1" /><verse number="2" style="v" sid="MAT 4:2" />Tatun ađek, bhêêl ơi điêng cha puôn jêt tangêi lơq puôn jêt hayum, nek Ađó ha-ul. <verse eid="MAT 4:2" /><verse number="3" style="v" sid="MAT 4:3" />Xong xók tơk đan, đu dharơơl galơơk móón palơq Ađó: “La amei nek Akóón Yaang Pleng, nek kayua đóng nôôq khuk dhơl ađô vaaih xar beng nek.” <verse eid="MAT 4:3" /><verse number="4" style="v" sid="MAT 4:4" />Bơơi ââi lóóiq, Ađó praaq: “Ve paraaq bâân xaraq: ‘Akóón manưih e mamông eh rau đươi beng hơq giêl, bơơi nek đươi dyóp paraaq yuur praaq tââq bóóp Yaang Pleng.’” <verse eid="MAT 4:4" /><verse number="5" style="v" sid="MAT 4:5" />Hayơq abhưi đââng Ađó mót kalóóng kanóón liêm, đóng Ađó dyương dhiq piing đu yaal tââm ưng đong bhanuôih, <verse eid="MAT 4:5" /><verse number="6" style="v" sid="MAT 4:6" />lơq praaq palơq Ađó: “La amei nek Akóón Yaang Pleng, nek chrơm ađêi chok leq, ơi ve paraaq bâân xaraq, kơi ađô:</para>
  <para style="q" vid="MAT 4:6">‘Ađó e paraaq râng leq akóón đóng nôôq dhơn pleng Ađó,’ lơq:</para>
  <para style="q" vid="MAT 4:6">‘Piđó e tapââng akóón ganơơm dhiq têi piđó, yươq dyung akóón ve chóóm n'đóih leq khuk dhơl.’”<verse eid="MAT 4:6" /></para>
  <para style="b" />
  <para style="m">
    <verse number="7" style="v" sid="MAT 4:7" />Chuôq Jê-su ââi lóóiq ađó: “Kơi lââng, ve paraaq bâân xaraq: ‘Amei e kah chóóm klêêu Chuôq, nek Yaang Pleng ưng amei.’” <verse eid="MAT 4:7" /><verse number="8" style="v" sid="MAT 4:8" />Mưi chu dyơq, abhưi đââng Ađó đơk mưi kachruôch bôôl lóng yaal lơq đóng Ađó lêi tabhơt nôôq katiêk dhiq hóng katiêk palơq rau liêm kra ưng piđó. <verse eid="MAT 4:8" /><verse number="9" style="v" sid="MAT 4:9" />Lơq abhưi móón palơq Ađó: “Aku e đóng amei tabhơt nôôq rau ađô, la amei bhuôih kakoh aku, palơq pađam ađêi chok leq.” <verse eid="MAT 4:9" /><verse number="10" style="v" sid="MAT 4:10" />Bhêêl ađek, Chuôq Jê-su praaq palơq ađó: “Sa-taan, phaai yuur xooq! Ơi ve paraaq bâân xaraq:</para>
  <para style="q" vid="MAT 4:10">‘Akóón e bhuôih haanh Chuôq, nek Yaang Pleng ưng akóón, lơq akóón e têêng yaauq chapiên mưi Ađó.’”<verse eid="MAT 4:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 4:11" />Hayơq abhưi xooq tââq Ađó, lơq lêi tôôh, nôôq dhơn pleng tơk lơq tââp têêng yaauq Ađó.<verse eid="MAT 4:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 4:12" />Xók achêk, xong xók xâng kơi Jang ơi bâân takóóp, Ađó róch chô leq xưưq Ga-li-lê. <verse eid="MAT 4:12" /><verse number="13" style="v" sid="MAT 4:13" />Xók ơi xooq tââq Na-xa-reet, Ađó tơk mamông dhiq kanóón Ka-bê-na-um tóór taxiiq, kalóóng parah katiêk Sa-bu-lôôn lơq Neep-ta-li, <verse eid="MAT 4:13" /><verse number="14" style="v" sid="MAT 4:14" />buôn bâân tajaap paraaq rau ơi bâân praaq dhiq Ê-saai, manưih đââng taruuih kơi ađô:<verse eid="MAT 4:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="MAT 4:15" />“Katiêk Sa-bu-lôôn lơq katiêk Neep-ta-li,</para>
  <para style="q" vid="MAT 4:15">charlah kalơng gluh hót taxiiq, hót tôôh karuung Jô-đen,</para>
  <para style="q" vid="MAT 4:15">hơq nek xưưq Ga-li-lê ưng nôôq dhanuôr manưih nguôi —<verse eid="MAT 4:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="MAT 4:16" />Dhanuôr tơơt kalóóng bóng kanam</para>
  <para style="q" vid="MAT 4:16">ơi ve lêi taklaaq brương gamak,</para>
  <para style="q" vid="MAT 4:16">lơq palơq nôôq đu tơơt kalóóng parah katiêk lơq a-ô akan chêt,</para>
  <para style="q" vid="MAT 4:16">nek taklaaq brương ơi klaaq dyóól dhiq piđó.”<verse eid="MAT 4:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 4:17" />Tââq bhêêl ađek, Chuôq Jê-su tanââp tââp truuih đuui lơq praaq: “Phaai klôôq lóóm, ơi katiêk pleng ơi tơk đan.” <verse eid="MAT 4:17" /><verse number="18" style="v" sid="MAT 4:18" />Xók achêk, bhêêl xók vôôiq dyung dhiq taxiiq Ga-li-lê, Ađó ve lêi bơơr adhi anó, Si-môôn, bâân đóók nek Phi-e-rơ, lơq En-rê, adhi ađó achêk, xók trah jươl dhiq taxiiq taai piđó nek manưih tabâân kadhóóng. <verse eid="MAT 4:18" /><verse number="19" style="v" sid="MAT 4:19" />Lơq Ađó móón piđó: “Hêq vôôiq ting thêi, nek thêi e têêng adhi anó xar nôôq têi trah jươl manưih.” <verse eid="MAT 4:19" /><verse number="20" style="v" sid="MAT 4:20" />N'drươh, xók ơi xooq lơơi jươl ađêi, piđó ting Ađó. <verse eid="MAT 4:20" /><verse number="21" style="v" sid="MAT 4:21" />Xong xók tââq ađek vôôiq kơơq, Ađó lêi bơơr adhi anó lââng, nek Ja-kơ akóón ưng Xê-bê-đê, lơq Jang adhi ađó, kalóóng bhuông, nek palơq Xê-bê-đê, ama ưng nhiđó, xók bươl jươl ađêi lơq Chuôq dhaloong nhiđó, <verse eid="MAT 4:21" /><verse number="22" style="v" sid="MAT 4:22" />Hayơq n'drươh, xók ơi lơơi bhuông lơq ama ađêi, nhiđó ting Ađó.<verse eid="MAT 4:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 4:23" />Lơq Ađó vôôiq leq đi leq tôôh plok kalóóng xưưq Ga-li-lê, pató pachóóm kalóóng nôôq đong gươl ưng manưih dhanuôr, truuih pachóóm Taruuih Liêm leq katiêk pleng, palơq payươh dyóp rau mabinh lơq dyóp rau dhuôr ka-ai kalóóng dhanuôr manưih. <verse eid="MAT 4:23" /><verse number="24" style="v" sid="MAT 4:24" />Tanđôôr leq Ađó yuur đââr patơk plok tabhơt xưưq Si-ri, lơq palââng đââng tơk leq Ađó dyóp đu ve ka-ai, bâân pâng mơk bơk rau ka-ai lơq karuôq kakêch n'tua rau, bâân abhưi bóq, đu ahơt, rabóót dyung têi, lơq Ađó payươh đóng piđó. <verse eid="MAT 4:24" /><verse number="25" style="v" sid="MAT 4:25" />Nôôq tanóói dhanuôr bơk vôôiq ting Ađó tââq Ga-li-lê, Đê-ka-bô-lơ, Jê-ru-sa-leem, Ju-đê lơq tóór hót tôôh karuung Jô-đen.<verse eid="MAT 4:25" /></para>
  <chapter eid="MAT 4" />
  <chapter number="5" style="c" sid="MAT 5" />
  <para style="p">
    <verse number="1" style="v" sid="MAT 5:1" />Xók achêk, xong xók lêi tanóói dhanuôr, Ađó vôôiq đơk dhiq bôôl, lơq xók Ađó ơi tơơt, nôôq môôn-đô Ađó tơk palơq Ađó. <verse eid="MAT 5:1" /><verse number="2" style="v" sid="MAT 5:2" />Ađó pơơh bóóp pató pachóóm piđó, kơi ađô:<verse eid="MAT 5:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="MAT 5:3" />“Phươk đóng nek nôôq manưih ngeeo hadhơơp kalóóng lóóm yaang,</para>
  <para style="q2" vid="MAT 5:3">ơi katiêk pleng nek ưng piđó.<verse eid="MAT 5:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="MAT 5:4" />Phươk đóng nek nôôq manưih nhiim griit,</para>
  <para style="q2" vid="MAT 5:4">ơi piđó e bâân tabhơơl.<verse eid="MAT 5:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="MAT 5:5" />Phươk đóng nek nôôq manưih moor dha-iiq,</para>
  <para style="q2" vid="MAT 5:5">ơi piđó e bâân đươi katiêk.<verse eid="MAT 5:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="MAT 5:6" />Phươk đóng nek nôôq manưih ha-ul lơq rahaal rau bhơt liêm,</para>
  <para style="q2" vid="MAT 5:6">ơi piđó e bâân kabhôôq dyóp.<verse eid="MAT 5:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="MAT 5:7" />Phươk đóng nek nôôq manưih buôn kayô ka-er,</para>
  <para style="q2" vid="MAT 5:7">ơi piđó e bâân kayô ka-er.<verse eid="MAT 5:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="MAT 5:8" />Phươk đóng nek nôôq manưih sek tabah kalóóng lóóm,</para>
  <para style="q2" vid="MAT 5:8">ơi piđó e ve lêi Yaang Pleng.<verse eid="MAT 5:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="MAT 5:9" />Phươk đóng nek nôôq manưih paliêm lóóiq,</para>
  <para style="q2" vid="MAT 5:9">ơi piđó e bâân đóók nek nôôq akóón ưng Yaang Pleng.<verse eid="MAT 5:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="MAT 5:10" />Phươk đóng nek nôôq manưih pâng kóóp róp ơi taai rau bhơt liêm,</para>
  <para style="q2" vid="MAT 5:10">ơi katiêk pleng nek ưng piđó.<verse eid="MAT 5:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 5:11" />Adhi anó ve phươk xók palââng kađiq tamôôp adhi anó, palơq têêng pahư lơq praaq dyóp rau môôp baauq uôn huông palơq adhi anó ơi taai thêi. <verse eid="MAT 5:11" /><verse number="12" style="v" sid="MAT 5:12" />Phaai bhuui marhaal lơq sương si, ơi kaliim haanh ưng adhi anó lóng gamak dhiq katiêk pleng, taai palââng ơi kóóp róp nôôq manưih đââng taruuih laloom adhi anó i kơi achêk.<verse eid="MAT 5:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 5:13" />Adhi anó nek abhóh ưng katiêk. Bơơi la abhóh bâân bil kariêq, nek ađó e bâân têêng đóng kariêq palơq hau rau? Chapiên bâân m'peq leq nguôi buôn bâân palââng đâq kadhaat, taai nek ađó kah malơơi malaai đóng hau rau dyơq. <verse eid="MAT 5:13" /><verse number="14" style="v" sid="MAT 5:14" />Adhi anó nek kalaaq brương ưng hóng katiêk. Mưi kanóón manưih bơk tơơt dhiq kachruôch bôôl nek kah ve chóóm bâân tapađơp. <verse eid="MAT 5:14" /><verse number="15" style="v" sid="MAT 5:15" />Kung kah ngaai bat dhơu lơq patơơt ađó dhiq kalóóng hôk, bơơi nek dhiq dyung dhơu, lơq ađó dyóól brương đóng dyóp ngaai kalóóng đong. <verse eid="MAT 5:15" /><verse number="16" style="v" sid="MAT 5:16" />Tarvaai ađek, kalaaq brương ưng adhi anó phaai yuur klaaq toom mat palââng, ng'kơi đóng palââng ve chóóm lêi nôôq tarnêêng liêm ưng adhi anó lơq bhi haanh Ama ưng adhi anó dhiq pleng.<verse eid="MAT 5:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 5:17" />Óóq ngóq kơi thêi ơi tơk buôn pahư tabil gani môôiq nôôq paraaq manưih đââng taruuih. Thêi ơi tơk eh rau buôn pahư tabil, bơơi nek buôn têêng đóng paxong. <verse eid="MAT 5:17" /><verse number="18" style="v" sid="MAT 5:18" />Ơi nek lalua, Aku praaq palơq adhi anó, patơk xók pleng lơq katiêk lơh bil, nek kah mưi rau môôiq mưi râ kalóóng gani dhakơi kah chóóm bil patơk n'đó bhêêl dyóp rau bâân chóóm ve. <verse eid="MAT 5:18" /><verse number="19" style="v" sid="MAT 5:19" />Taai kơi achêk, la ngaai pahư lơơi mưi kalóóng nôôq rau katưưiq tââm ưng nôôq rau gani ađô lơq pachóóm palââng kơi achêk nek e bâân đóók nek katưưiq tââm kalóóng katiêk pleng. Bơơi ngaai đu yuur têêng lơq truuih pachóóm piđó, manưih ađek e bâân đóók nek gamak kalóóng katiêk pleng. <verse eid="MAT 5:19" /><verse number="20" style="v" sid="MAT 5:20" />Ơi thêi praaq palơq adhi anó kơi la rau bhơt liêm ưng adhi anó kah đuôh lơh rau bhơt liêm ưng nôôq manưih pachóóm gani lơq manưih Pha-ri-si, nek adhi anó dhakơi e kah bâân mót kalóóng katiêk pleng.<verse eid="MAT 5:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 5:21" />Adhi anó ơi xâng nô kơi, rau ơi bâân truuih đóng manưih hanua: ‘Kah chóóm leng manưih,’ hơq ‘ngaai đu leng manưih nek e phaai đơơp rau praaq xêi.’ <verse eid="MAT 5:21" /><verse number="22" style="v" sid="MAT 5:22" />Bơơi thêi praaq palơq adhi anó kơi dyóp đu vaaih pagrâ palơq adhi anó ađêi e đơơp rau praaq xêi. Hơq ngaai đu móón adhi anó ađêi: ‘Đu ngôôk!’ nek e đơơp nôôq kabhuh xêi xanêi. Dyơq ngaai đu teng: ‘Đu ngôôk abhưưl!’ nek e đơơp rau janah dhiq bóng óih. <verse eid="MAT 5:22" /><verse number="23" style="v" sid="MAT 5:23" />Taai ađek, la adhi anó xók đââng tapôông bhanuôih ađêi dhiq para bhanuôih hayơq dhiq ađek, adhi anó hei lóóiq kơi mưi nak adhi anó ưng ađêi ve rauriq ađek huông palơq ađêi, <verse eid="MAT 5:23" /><verse number="24" style="v" sid="MAT 5:24" />nek phaai lơơi lóóiq bhanuôih ađêi dhiq toom para bhanuôih lơq yuur chô; laloom kơ phaai chô paliêm palơq manưih adhi anó ưng ađêi ađek, lơq hayơq, xong xók chô, nek tapôông bhanuôih ađêi. <verse eid="MAT 5:24" /><verse number="25" style="v" sid="MAT 5:25" />Phaai praaq paliêm kalóóng lóóm bóóp palơq manưih đu kaauq ađêi kơi chóóm đâh hơq xók bhêêl adhi anó dyơq vôôiq dhiq kalơng nek palơq manưih achêk, óóq manưih đu kaauq ve chóóm pajaau adhi anó đóng kuôn xêi xanêi, lơq kuôn xêi xanêi đââng đóng kabhuh linh, hayơq adhi anó e bâân m'peq mót đong kanam. <verse eid="MAT 5:25" /><verse number="26" style="v" sid="MAT 5:26" />Alua, thêi praaq palơq adhi anó, adhi anó dhakơi e kah bâân gluh tââq ađek patơk nh'xók adhi anó ve chóóm chróót đông-jêên tatun xariêq.<verse eid="MAT 5:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 5:27" />Adhi anó ơi xâng nô kơi, paraaq ơi bâân truuih: ‘Kah chóóm têêng matu tapiing.’ <verse eid="MAT 5:27" /><verse number="28" style="v" sid="MAT 5:28" />Bơơi thêi praaq palơq adhi anó kơi bhơt dhơ dhangaai lêi mưi pađiil palơq karnóq kaniêng kiêng marlóóch pađiil achêk, nek manưih ađek ơi têêng tapiing matu lơt palơq pađiil achêk kalóóng lóóm ađêi ơi. <verse eid="MAT 5:28" /><verse number="29" style="v" sid="MAT 5:29" />Kơi lââng, la kaliêng mat hót atươm ưng adhi anó têêng ađêi lơt matu, phaai bhalok ađó gluh lơq m'peq changaai tââq adhi anó. Ơi kơi achêk nek liêm lơh đóng adhi anó xók mưi phơn kalóóng nôôq achak araang ưng adhi anó bâân hư bil, hơq tabhơt achak araang ađêi yươq bâân m'peq leq bóng óih. <verse eid="MAT 5:29" /><verse number="30" style="v" sid="MAT 5:30" />Lơq la têi atươm ưng adhi anó têêng ađêi lơt matu, phaai rakóh ađó lơq m'peq changaai tââq adhi anó. Ơi kơi achêk nek liêm lơh đóng adhi anó xók mưi phơn kalóóng achak araang ưng adhi anó bâân hư bil, hơq tabhơt achak araang ađêi yươq vôôiq mót bóng óih. <verse eid="MAT 5:30" /><verse number="31" style="v" sid="MAT 5:31" />Dyơq paraaq ơi bâân truuih: ‘Ngaai đu lơơi kađiêl ađêi, nek manưih achêk phaai đóng leq ađó mưi bha-aar xaraq tarlơơi.’ <verse eid="MAT 5:31" /><verse number="32" style="v" sid="MAT 5:32" />Bơơi thêi praaq palơq adhi anó kơi dhơ dhangaai tarlơơi kađiêl ađêi, hơq kah ve kaauq patu leq matu têêng tapiing, nek têêng đóng ađó đơơp matu têêng tapiing. Lơq la ngaai nhan manưih glêh bâân tarlơơi nek matu lơt têêng tapiing.<verse eid="MAT 5:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 5:33" />Adhi anó vil ơi xâng nô kơi, paraaq ơi bâân truuih đóng manưih hanua: ‘Kah chóóm ng'kóh chachââr, bơơi phaai yuur têêng paraaq ng'kóh ưng ađêi palơq Chuôq.’ <verse eid="MAT 5:33" /><verse number="34" style="v" sid="MAT 5:34" />Bơơi, thêi móón adhi anó óóq ng'kóh marau marâ; kung óóq chaleq pleng hơq ng'kóh, ơi ađek nek tanơơt ưng Yaang Pleng; <verse eid="MAT 5:34" /><verse number="35" style="v" sid="MAT 5:35" />kung óóq chaleq katiêk hơq ng'kóh, ơi ađek nek parđâq dyung ưng Ađó; kung óóq chaleq kanóón Jê-ru-sa-leem hơq ng'kóh, ơi ađek nek kanóón ưng Bhua gamak. <verse eid="MAT 5:35" /><verse number="36" style="v" sid="MAT 5:36" />Adhi anó kung óóq chaleq akoq ađêi hơq ng'kóh, ơi adhi anó kah ve chóóm đuôh buôn têêng mưi n'dreh xok val xar bhóók môôiq tam. <verse eid="MAT 5:36" /><verse number="37" style="v" sid="MAT 5:37" />Bơơi paraaq ưng adhi anó phaai nek ‘Ve, nek ve,’ môôiq ‘Kah, nek kah.’ Dyơq hau rau kuôq lơh tarnêêng ađô nek tââq abhưi.<verse eid="MAT 5:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="MAT 5:38" />Adhi anó ơi xâng nô kơi, paraaq ơi bâân truuih: ‘Mat chróót mat, lơq kaniêng chróót kaniêng.’ <verse eid="MAT 5:38" /><verse number="39" style="v" sid="MAT 5:39" />Bơơi, thêi móón adhi anó óóq tarjơl đu aak. Klóóih dhiq ađek, dhơ dhangaai m'pah adhi anó leq tabók hót atươm, kung nek đóng tabók đu dyơq đóng manưih ađek. <verse eid="MAT 5:39" /><verse number="40" style="v" sid="MAT 5:40" />Palơq đu kiêng kaauq adhi anó leq đu xêi xanêi lơq pei paxooq aau kalóóng ưng adhi anó, phaai lơơi manưih achêk pei luôn aau nguôi ađêi. <verse eid="MAT 5:40" /><verse number="41" style="v" sid="MAT 5:41" />Lơq ngaai ađek e pa-eep adhi anó vôôiq mưi n'lóóch kalơng, nek phaai vôôiq palơq ađó achêk bơơr n'lóóch kalơng. <verse eid="MAT 5:41" /><verse number="42" style="v" sid="MAT 5:42" />Phaai đóng manưih tamóh nhan adhi anó, lơq óóq vih mat lơh tââq ađó kiêng nhan vaq tââq dhiq adhi anó.<verse eid="MAT 5:42" /></para>
  <para style="p">
    <verse number="43" style="v" sid="MAT 5:43" />Adhi anó ơi xâng nô kơi, paraaq ơi bâân truuih: ‘Nh'nhơr manưih đan tóór ađêi, lơq geet manưih brau ađêi.’ <verse eid="MAT 5:43" /><verse number="44" style="v" sid="MAT 5:44" />Bơơi thêi móón adhi anó, phaai nh'nhơr manưih brau ađêi lơq gavơh nhan klóóih đóng manưih đu janah ađêi, <verse eid="MAT 5:44" /><verse number="45" style="v" sid="MAT 5:45" />ng'kơi đóng adhi anó ve chóóm bâân val xar akóón ưng Ama ađêi dhiq pleng. Achêk nek ơi Ađó têêng mat tangêi ưng Ađó klaaq dhiq manưih jar-ââih palơq manưih liêm, lơq Ađó đóng bó dhiq manưih đu liêm palơq manưih đu môôp. <verse eid="MAT 5:45" /><verse number="46" style="v" sid="MAT 5:46" />Ơi la adhi anó nh'nhơr nôôq manưih nh'nhơr ađêi, nek adhi anó ve kaliim haanh harau? Kah alua nôôq manưih pagoop jêên kung têêng i kơi chêk alua? <verse eid="MAT 5:46" /><verse number="47" style="v" sid="MAT 5:47" />Lơq la adhi anó mơ pơh kóóp têi nôôq manưih adhi anó ađêi, nek adhi anó têêng hau rau đu lơh? Kah alua nôôq dhanuôr manưih nguôi kung têêng i kơi achêk alua? <verse eid="MAT 5:47" /><verse number="48" style="v" sid="MAT 5:48" />Kơi achêk, adhi anó nek e bhơt liêm, thê kơi Ama dhiq pleng ưng adhi anó nek bhơt liêm.<verse eid="MAT 5:48" /></para>
  <chapter eid="MAT 5" />
  <chapter number="6" style="c" sid="MAT 6" />
  <para style="p">
    <verse number="1" style="v" sid="MAT 6:1" />Phaai chagơn leq tarnêêng bhơt liêm ưng ađêi ng'kơi đóng óóq têêng toom mat palââng đóng bâân palââng lêi giêl, bơơi la kah kơi achêk, nek e kakhin adhi anó kah ve kaliim haanh kalóóng rau pakah mat ưng Ama ađêi dhiq pleng. <verse eid="MAT 6:1" /><verse number="2" style="v" sid="MAT 6:2" />Taai ađek, bhêêl adhi anó pađơơp ưng poor đóng, óóq plong keeng toom mat ađêi dhiêp kơi nôôq đu têêng paliêm galơơk têêng kalóóng nôôq đong gươl lơq dhiq chóók kalơng bơk manưih, ng'kơi đóng piđó bâân bhi haanh tââq palââng. Alua thêi praaq palơq adhi anó, piđó ve dyóp kaliim haanh ưng ađêi. <verse eid="MAT 6:2" /><verse number="3" style="v" sid="MAT 6:3" />Bơơi xók adhi anó pađơơp ưng poor đóng, óóq lơơi đóng têi ađaai ưng adhi anó n'nal tarnêêng têi atươm ađêi xók têêng, <verse eid="MAT 6:3" /><verse number="4" style="v" sid="MAT 6:4" />ng'kơi đóng tarnêêng poor đóng ưng adhi anó ve chóóm tơơt kalóóng dhiq đu lââp, lơq Ama ưng adhi anó, Yaang đu lêi dhiq kalóóng đu lââp, e đóng kliim leq adhi anó.<verse eid="MAT 6:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 6:5" />Lơq bhêêl adhi anó gavơh nhan, nek óóq kơi đu pathê paliêm galơơk, ơi piđó kiêng gavơh nhan xók ơi dyương dhiq nôôq đong gươl lơq dhiq nôôq tóór kalơng, ng'kơi đóng piđó ve chóóm bâân palââng dhamơn lêi. Alua, thêi praaq palơq adhi anó, piđó ve dyóp kaliim haanh ưng ađêi. <verse eid="MAT 6:5" /><verse number="6" style="v" sid="MAT 6:6" />Dyơq adhi anó, xók adhi anó gavơh nhan, phaai mót kalóóng buông n'tua ưng adhi anó, lơq xók ơi kađơp palóng buông ađêi lóóiq, nek gavơh nhan palơq Ama ađêi, kalóóng dhiq đu lââp achêk, lơq Ama ưng adhi anó, Yaang đu lêi kalóóng dhiq đu lââp, e đóng kliim leq adhi anó. <verse eid="MAT 6:6" /><verse number="7" style="v" sid="MAT 6:7" />Lơq dyơq xók gavơh nhan, adhi anó óóq praaq palâh palaang vil kơi kah malơơi i kơi nôôq dhanuôr manưih nguôi, ơi piđó ngóq kơi đươi rau bơk praaq ưng ađêi, piđó e bâân tameng xâng. <verse eid="MAT 6:7" /><verse number="8" style="v" sid="MAT 6:8" />Taai ađek, adhi anó óóq hayơq thê kơi piđó, ơi Ama ưng adhi anó n'nal adhi anó ve kiêng hau rau xók kah ơi adhi anó gavơh nhan Ađó. <verse eid="MAT 6:8" /><verse number="9" style="v" sid="MAT 6:9" />Kơi achêk, adhi anó phaai gavơh nhan nô kơi:</para>
  <para style="q" vid="MAT 6:9">‘Kakoh Ama nôôq akóón dhiq pleng,</para>
  <para style="q2" vid="MAT 6:9">nhan Dhanóók Amei bâân bhi liêm.<verse eid="MAT 6:9" /></para>
  <para style="q2">
    <verse number="10" style="v" sid="MAT 6:10" />Nhan katiêk Amei đâh tơk,</para>
  <para style="q2" vid="MAT 6:10">nhan karnóq kiêng Amei bâân yuur vaaih</para>
  <para style="q2" vid="MAT 6:10">dhiq katiêk kung kơi dhiq pleng.<verse eid="MAT 6:10" /></para>
  <para style="q2">
    <verse number="11" style="v" sid="MAT 6:11" />Nhan đóng leq nôôq akóón mađôk tarmông dyóp tangêi ưng nôôq akóón;<verse eid="MAT 6:11" /></para>
  <para style="q2">
    <verse number="12" style="v" sid="MAT 6:12" />lơq nhan lơơi lơt nôôq akóón leq nôôq matu lơt ưng nôôq akóón,</para>
  <para style="q2" vid="MAT 6:12">kơi nôôq akóón kung ơi lơơi lơt nôôq đu matu lơt palơq nôôq akóón;<verse eid="MAT 6:12" /></para>
  <para style="q2">
    <verse number="13" style="v" sid="MAT 6:13" />lơq nhan óóq đââng nôôq akóón leq dharơơl galơơk,</para>
  <para style="q2" vid="MAT 6:13">bơơi jóói paq nôôq akóón tââq đu aak.’<verse eid="MAT 6:13" /></para>
  <para style="b" />
  <para style="m">
    <verse number="14" style="v" sid="MAT 6:14" />Ơi la adhi anó lơơi lơt đóng palââng nôôq rau lơt ưng piđó, nek Ama dhiq pleng ưng adhi anó kung e lơơi lơt đóng adhi anó. <verse eid="MAT 6:14" /><verse number="15" style="v" sid="MAT 6:15" />Dyơq la adhi anó kah lơơi lơt đóng palââng, nek Ama ưng adhi anó kung e kah lơơi rau nôôq têêng lơt ưng adhi anó.<verse eid="MAT 6:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 6:16" />Kơi lââng, xók adhi anó điêng cha, óóq têêng lóng kơi nôôq đu ranguôq mat têêng paliêm galơơk, ơi piđó kachrik kachrââq moh mat ưng ađêi buôn piđó ve chóóm pakah đóng palââng lêi nek xók drơng cha. Alua, thêi praaq palơq adhi anó, piđó ve dyóp kaliim haanh ưng ađêi. <verse eid="MAT 6:16" /><verse number="17" style="v" sid="MAT 6:17" />Dyơq adhi anó, xók điêng cha, phaai xut dhơu dhiq akoq ađêi lơq buôch mat ađêi, <verse eid="MAT 6:17" /><verse number="18" style="v" sid="MAT 6:18" />ng'kơi đóng adhi anó óóq ve pakah đóng palââng lêi nek xók điêng cha, bơơi nek đóng Ama ađêi kalóóng dhiq kiêr lââp; lơq Ama ưng adhi anó, Yaang đu lêi kalóóng dhiq đu kiêr lââp, e kliim haanh đóng adhi anó.<verse eid="MAT 6:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 6:19" />Óóq karong ha-ơu đóng ađêi kala drươp karvaan dhiq katiêk, nek dhiq hơq kamuôr akóót palơq ateet aróóq pahư tabil, kung nek dhiq hơq manưih tatông tông mót lơq tông pei. <verse eid="MAT 6:19" /><verse number="20" style="v" sid="MAT 6:20" />Bơơi phaai karong ha-ơu đóng ađêi drươp karvaan dhiq pleng, nek dhiq yươq ve kamuôr akóót môôiq ateet aróóq pahư tabil, lơq nek dhiq hơq manưih tatông yươq tông mót môôiq tông pei. <verse eid="MAT 6:20" /><verse number="21" style="v" sid="MAT 6:21" />Ơi drươp karvaan ưng adhi anó tơơt n'dhiq, nek lóóm ưng adhi anó kung e dhiq ađek. <verse eid="MAT 6:21" /><verse number="22" style="v" sid="MAT 6:22" />Kaliêng mat nek dhơu ưng achak araang. Taai ađek, la mat adhi anó nek liêm, hơq tabhơt achak araang adhi anó e bâân bhlaai xưa brương braang. <verse eid="MAT 6:22" /><verse number="23" style="v" sid="MAT 6:23" />Bơơi la mat adhi anó nek môôp, nek tabhơt achak araang adhi anó e bâân bing bhlaai bóng kanam. Kơi achêk, la kalaaq brương kalóóng adhi anó nek bóng kanam, nek bóng kanam achêk tagah gamak n'nal mơ! <verse eid="MAT 6:23" /><verse number="24" style="v" sid="MAT 6:24" />Kah ngaai ve chóóm têêng yaauq bơơr kala, ơi manưih ađek môôiq e geet kala ađô hơq nh'nhơr kala tôôh, môôiq e bhơt lóóm palơq kala ađô hơq lêi kađiq kala tôôh. Adhi anó kah ve chóóm têêng yaauq Yaang Pleng palơq jêên karvaan. <verse eid="MAT 6:24" /><verse number="25" style="v" sid="MAT 6:25" />Ơi taai rau ađô, thêi praaq palơq adhi anó, óóq karaang leq parmông ưng adhi anó, leq hau rau ađêi cha môôiq hau rau ađêi ơm, môôiq leq achak araang ưng adhi anó, leq hau rau ađêi xơp. Kah alua parmông nek đu kiiq lơh tarmông, lơq achak araang đu kiiq lơh rau n'đóh xơp eh alua? <verse eid="MAT 6:25" /><verse number="26" style="v" sid="MAT 6:26" />Phaai chamet lêi dhiq nôôq dhong achim pleng, kơi piđó kah chóói, kung kah xóót, môôiq karong ha-ơu leq póóm jơơng, hơq Ama dhiq pleng ưng adhi anó ban piđó. Adhi anó kah ve kiiq liêm lơh piđó eh alua? <verse eid="MAT 6:26" /><verse number="27" style="v" sid="MAT 6:27" />Kơi lââng, ngaai đu dhiq m'pơng adhi anó xók karaang kakhin nek ve chóóm tatrul mưi ganah leq đơơi ưng ađêi? <verse eid="MAT 6:27" /><verse number="28" style="v" sid="MAT 6:28" />Lơq ng'kơi adhi anó karaang leq kun aau? Phaai chamet lêi padrêh leq nôôq pô dhalôôm dhiq hare, n'đó kơi hơq piđó yuur chat. Piđó kah gleh nhok, kung kah bhliiq hangươn. <verse eid="MAT 6:28" /><verse number="29" style="v" sid="MAT 6:29" />Bơơi thêi praaq palơq adhi anó kơi dhơ nek bhua Sa-lô-môôn, kalóóng tabhơt rau liêm kra ưng ađó, kung kah bâân xơp kun aau đóng ađêi thê kơi mưi kalóóng nôôq pô ađek. <verse eid="MAT 6:29" /><verse number="30" style="v" sid="MAT 6:30" />Hayơq la Yaang Pleng lơơi kơi achêk đóng bhơơi dhiq klung, nek rau ađôk dyơq, lơq rayiiu bâân m'peq leq óih, nek nôôq đu m'bưưiq lóóm huuiq tôôh, vil Ađó kah chóóm têêng bơk lơh môôiq kơq? <verse eid="MAT 6:30" /><verse number="31" style="v" sid="MAT 6:31" />Taai ađek, adhi anó óóq karaang hơq móón: ‘Nôôq he hau cha?’ môôiq nek ‘nôôq he hau ơm?’ môôiq nek ‘Nôôq he hau xơp?’ <verse eid="MAT 6:31" /><verse number="32" style="v" sid="MAT 6:32" />Ơi nôôq dhanuôr manưih nguôi chêk-tabâân tabhơt nôôq rau ađô; lơq ơi Ama dhiq pleng ưng adhi anó n'nal kơi adhi anó kơng tabhơt nôôq rau achêk. <verse eid="MAT 6:32" /><verse number="33" style="v" sid="MAT 6:33" />Bơơi laloom tââm phaai chêk tabâân katiêk lơq rau bhơt liêm ưng Ađó nek tabhơt nôôq rau ađek e bâân đóng kơơq leq adhi anó. <verse eid="MAT 6:33" /><verse number="34" style="v" sid="MAT 6:34" />Taai ađek, adhi anó óóq chóóm karaang leq tangêi rayiiu, ơi tangêi rayiiu e gamang đóng tangêi rayiiu. Ve dyóp đóng mưi tangêi chiên kadhaap nhok ưng tangêi ađek.<verse eid="MAT 6:34" /></para>
  <chapter eid="MAT 6" />
  <chapter number="7" style="c" sid="MAT 7" />
  <para style="p">
    <verse number="1" style="v" sid="MAT 7:1" />Óóq xêi lơt, buôn adhi anó yươq bâân xêi lơt. <verse eid="MAT 7:1" /><verse number="2" style="v" sid="MAT 7:2" />Ơi kalóóng rau tabóq patu hơq adhi anó xêi lơt, adhi anó e đơơp xêi lơt, lơq tââq chadhaq dhanang hơq adhi anó đang bang, chadhaq dhanang achêk e bâân đang bang nek palơq adhi anó. <verse eid="MAT 7:2" /><verse number="3" style="v" sid="MAT 7:3" />Hơq hau adhi anó tabâân lêi nanah kađaq kalóóng mat manưih adhi anó ađêi, bơơi adhi anó kah ve lêi khal n'lóóng kalóóng mat ađêi. <verse eid="MAT 7:3" /><verse number="4" style="v" sid="MAT 7:4" />Môôiq palơq n'đó kơi hơq amei e móón manưih adhi anó ađêi: ‘Nek lơơi aku pei nanah kađaq pagluh tââq mat amei,’ hơq lêi tôôh, khal n'lóóng dyơq tơơt kalóóng mat adhi anó? <verse eid="MAT 7:4" /><verse number="5" style="v" sid="MAT 7:5" />Manưih têêng paliêm galơơk tôôh! Laloom kơ, nek pei khal n'lóóng pagluh tââq mat ađêi, nek tatun ađek, adhi anó e lêi drêh buôn pei nanah kađaq pagluh tââq mat manưih adhi anó ađêi. <verse eid="MAT 7:5" /><verse number="6" style="v" sid="MAT 7:6" />Adhi anó óóq đóng kabhuh anuq rau liêm, kung óóq m'peq ngok-traai ưng ađêi toom mat kabhuh adhââk. E vaaih piđó đâq kadhaat nôôq rau ađek dhiq dyung piđó, lơq xong xók palâh lóóiq nek piđó kap tech adhi anó xar ting paleh.<verse eid="MAT 7:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 7:7" />Phaai nhan, lơq rau ađek e bâân đóng leq adhi anó. Phaai tabâân, lơq adhi anó e lum. Phaai takóq, lơq palóng e bâân lóng đóng adhi anó. <verse eid="MAT 7:7" /><verse number="8" style="v" sid="MAT 7:8" />Ơi dhơ ngaai nhan nek bâân; ngaai chik-chêk nek lum; lơq, palóng e bâân lóng đóng ngaai takóq. <verse eid="MAT 7:8" /><verse number="9" style="v" sid="MAT 7:9" />Môôiq, ve ngaai dhiq kalóóng adhi anó, nek manưih hơq akóón ađêi nhan beng — ve kơq manưih ađek e đóng panong akóón khuk dhơl? <verse eid="MAT 7:9" /><verse number="10" style="v" sid="MAT 7:10" />Môôiq panong akóón kung nhan kadhóóng — ve kơq manưih ađek e đóng ađó kaxênh? <verse eid="MAT 7:10" /><verse number="11" style="v" sid="MAT 7:11" />Kơi achêk, la adhi anó, nek môôp, n'nal đóng akóón anaaq ađêi nôôq kaliim kliim kre liêm, nek Ama ưng adhi anó dhiq katiêk pleng e đóng leq nôôq ngaai nhan Ađó bơk rau kre liêm lơh n'nal n'đơq mơ? <verse eid="MAT 7:11" /><verse number="12" style="v" sid="MAT 7:12" />Taai ađek, kalóóng dyóp rau tarnêêng, la adhi anó kiêng bhơt dhơ dharau buôn palââng têêng đóng ađêi, nek adhi anó kung phaai têêng kơi achêk đóng piđó, ơi ađek nek gani lơq nôôq paraaq đââng taruuih.<verse eid="MAT 7:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 7:13" />Phaai vôôiq mót hót palóng jeet, ơi palóng bhươh lơq kalơng thuông gamak đââng tơk rau chêt bil, lơq ve bơk manưih vôôiq mót hót ađó. <verse eid="MAT 7:13" /><verse number="14" style="v" sid="MAT 7:14" />Achêk nek taai palóng jeet lơq kalơng bâân têêng đóng jeet đââng tơk parmông, hơq ve m'bưưiq manưih bâân lêi ađó.<verse eid="MAT 7:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 7:15" />Phaai hêch lêi leq nôôq manưih đââng taruuih galơơk, nek nôôq đu xơp gróh trưưu tơk palơq adhi anó, bơơi hót kalóóng, piđó nek dhong axing n'thaam đah. <verse eid="MAT 7:15" /><verse number="16" style="v" sid="MAT 7:16" />Adhi anó e bâân n'nal piđó tââq dhiq pale ưng piđó. Palââng kah ve mơ leh nho tââq tââm axông, môôiq pale tarung tââq tââm atóch? <verse eid="MAT 7:16" /><verse number="17" style="v" sid="MAT 7:17" />Tarvaai kơi ađek, dyóp n'lóóng liêm nek bóóng pale liêm, dyơq n'lóóng môôp nek bóóng pale môôp. <verse eid="MAT 7:17" /><verse number="18" style="v" sid="MAT 7:18" />N'lóóng liêm kah chóóm bóóng pale môôp, n'lóóng môôp kung kah chóóm bóóng pale liêm. <verse eid="MAT 7:18" /><verse number="19" style="v" sid="MAT 7:19" />Dyóp n'lóóng kah bóóng pale liêm nek bâân takươl lơq m'peq leq óih. <verse eid="MAT 7:19" /><verse number="20" style="v" sid="MAT 7:20" />Kơi achêk hayơq, bhơt kah nek adhi anó e phaai n'nal piđó tââq dhiq pale ưng piđó. <verse eid="MAT 7:20" /><verse number="21" style="v" sid="MAT 7:21" />Eh rau dyóp ngaai praaq palơq thêi: ‘Kakoh Chuôq, kakoh Chuôq’, e mót kalóóng katiêk pleng, bơơi nek manưih đu têêng karnóq kiêng ưng Ama thêi dhiq pleng. <verse eid="MAT 7:21" /><verse number="22" style="v" sid="MAT 7:22" />Kalóóng tangêi ađek, bơk ngaai e móón palơq thêi: ‘Kakoh Chuôq, kakoh Chuôq, kah alua nôôq yi ơi vơn dhanóók Amei loom đââng taruuih, ơi vơn dhanóók Amei viêng abhưi lơq ơi vơn dhanóók Amei têêng bơk tarnêêng karơ mataai alua?’ <verse eid="MAT 7:22" /><verse number="23" style="v" sid="MAT 7:23" />Lơq bhêêl ađek, thêi e praaq karơ drêh palơq piđó kơi ađô: ‘Aku kah ve glêh n'nal nôôq pe mơ! Kabhuh têêng aak tôôh, phaai yuur xooq tââq Aku!’<verse eid="MAT 7:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 7:24" />Taai ađek, ting chanak, hơq nek dhơ dhangaai tameng xâng nôôq paraaq ađô ưng thêi lơq yuur têêng ađó e bâân m'priing kơi mưi manưih tabech galang, nek manưih têêng đong ađêi dhiq hóng dhơl. <verse eid="MAT 7:24" /><verse number="25" style="v" sid="MAT 7:25" />Bó n'toh, đơơk tuh chô, adhiiq pruung lơq kabhrung pakhơp leq đong achêk, hơq ađó yươq hachươp taai ađó ơi bâân têêng dhiq hóng dhơl. <verse eid="MAT 7:25" /><verse number="26" style="v" sid="MAT 7:26" />Lơq dyóp đu tameng xâng nôôq paraaq ađô ưng thêi hơq kah yuur têêng ađó nek e bâân m'priing kơi mưi manưih đu ngôôk, nek đu têêng đong ađêi dhiq xuôr. <verse eid="MAT 7:26" /><verse number="27" style="v" sid="MAT 7:27" />Bó n'toh, đơơk tuh chô, adhiiq pruung lơq pakhơp leq đong achêk, nek ađó kalơm hachươp lơq rau preh jir ưng ađó nek lóng gamak.”<verse eid="MAT 7:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 7:28" />Tarnêêng yuur vaaih ađek nek bhêêl Chuôq Jê-su truuih xong nôôq paraaq ađô, tanóói dhanuôr lóng chrih xâng tââq rau truuih pachóóm ưng Ađó, <verse eid="MAT 7:28" /><verse number="29" style="v" sid="MAT 7:29" />Ơi Ađó pató pachóóm palââng kơi ve mataai raman, hơq yươq thê nôôq manưih pachóóm gani ưng piđó.<verse eid="MAT 7:29" /></para>
  <chapter eid="MAT 7" />
  <chapter number="8" style="c" sid="MAT 8" />
  <para style="p">
    <verse number="1" style="v" sid="MAT 8:1" />Xók achêk, xong xók Ađó tư tââq bôôl vôôiq dhaluônh, nôôq tanóói dhanuôr ganơr vôôiq ting Ađó. <verse eid="MAT 8:1" /><verse number="2" style="v" sid="MAT 8:2" />Lêi tôôh, mưi manưih ka-ai tơơt bhơơi xong xók vôôiq tơk, ơi chakoh toom Ađó, móón: “Kakoh Chuôq, la Amei iêm lóóm, Amei ve mataai buôn têêng aku chóóm sek.” <verse eid="MAT 8:2" /><verse number="3" style="v" sid="MAT 8:3" />Hayơq xók ơi hayuur têi charó, Chuôq kadhâng leq ađó, praaq: “Aku iêm lóóm. Phaai sek aq.” N'drươh ađek, ađó ađek bâân sek bhơt ka-ai tơơt bhơơi ưng ađêi. <verse eid="MAT 8:3" /><verse number="4" style="v" sid="MAT 8:4" />Chuôq Jê-su praaq palơq ađó: “Phaai chagơn, amei óóq chêk praaq palơq ngaai, bơơi phaai vôôiq pakah ađêi kala palơq takóh kadhâng bhanuôih lơq tapôông bhanuôih hơq Môôi-se ơi truuih pachóóm, kơi mưi paraaq truuih đóng piđó.”<verse eid="MAT 8:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 8:5" />Xók achêk, xong xók Ađó vôôiq mót kalóóng kanóón Ka-bê-na-um, mưi bhalơng linh ơi tơk palơq Ađó, gavơh nhan Ađó <verse eid="MAT 8:5" /><verse number="6" style="v" sid="MAT 8:6" />kơi ađô: “Kakoh Chuôq, dhơn ratơơq ưng aku bêch ligleng dhiq đong, đơơp ka-ai karuôq kah kơi bhlơng.” <verse eid="MAT 8:6" /><verse number="7" style="v" sid="MAT 8:7" />Chuôq praaq palơq ađó: “Xók ơi tơk, aku e payươh đóng ađó achêk.” <verse eid="MAT 8:7" /><verse number="8" style="v" sid="MAT 8:8" />Xók ââi lóóiq, bhalơng linh móón: “Kakoh Chuôq, aku nek kah chóóm đaang đóng Amei ve kơq vôôiq mót leq parlóng đong aku, dhơ kơi ađek nhan Amei chapiên praaq mưi paleh, nek dhơn ratơơq ưng aku e bâân yươh. <verse eid="MAT 8:8" /><verse number="9" style="v" sid="MAT 8:9" />Ơi aku kung nek mưi manưih bâân patơơt raal kataai đu lââng, ve nôôq kabhuh linh dhiq raal ađêi. Aku praaq palơq manưih ađô: ‘vôôiq aq,’ nek ađó yuur vôôiq, palơq manưih lââng: ‘Phaai tơk,’ nek ađó ađek tơk, lơq palơq dhơn ratơơq ađêi: ‘Phaai têêng rau ađô,’ nek ađó têêng.” <verse eid="MAT 8:9" /><verse number="10" style="v" sid="MAT 8:10" />Bơơi xók xâng kơi achêk, Chuôq Jê-su chrih xâng lơq praaq palơq nôôq manưih xók vôôiq ting Ađó: “Alua, thêi praaq palơq adhi anó, thêi kah glêh lêi lóóm huuiq gamak kơi achêk tââq mưi nak ngaai kalóóng I-sơ-ra-êên. <verse eid="MAT 8:10" /><verse number="11" style="v" sid="MAT 8:11" />Palâh lóóiq, thêi móón adhi anó kơi bơk manưih e bhral tââq charhóóng mat blo lơq charhóóng mat blót, hayơq piđó e bâân tơơt cha nek palơq Ap-ra-haam, I-saak lơq Ja-kôôp kalóóng katiêk pleng. <verse eid="MAT 8:11" /><verse number="12" style="v" sid="MAT 8:12" />Bơơi nôôq akóón ưng katiêk e bâân m'peq leq bóng kanam kadhiiq hót nguôi, nek dhiq e ve rau kalau nhiim lơq takachênh kaniêng.” <verse eid="MAT 8:12" /><verse number="13" style="v" sid="MAT 8:13" />Hayơq Chuôq Jê-su praaq palơq bhalơng linh: “Nek chô aq! Kơi amei ơi huuiq, tarnêêng achêk phaai bâân têêng paxong đóng amei.” Lơq manưih dhơn ratơơq achêk ơi chóóm bâân yươh xók bhêêl ađek.<verse eid="MAT 8:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 8:14" />Xong xók Chuôq Jê-su mót kalóóng đong ưng Phi-e-rơ, Ađó lêi akan kađiêl ưng Phi-e-rơ bêch dhiq dharââng lơq xók ka-ai kahiir. <verse eid="MAT 8:14" /><verse number="15" style="v" sid="MAT 8:15" />Ađó kadhâng leq têi ưng amooq, lơq ka-ai kahiir yươh tââq amooq, hayơq amooq yuur tơơt lơq nek ting yaauq Ađó. <verse eid="MAT 8:15" /><verse number="16" style="v" sid="MAT 8:16" />Xók achêk, bhêêl ơi tơk habu blót, palââng đââng tơk leq Ađó bơk manưih đu abhưi bóq, Ađó viêng pagluh nôôq yaang achêk palơq mưi paraaq praaq lơq payươh đóng bhơt dyóp nôôq ngaai mơk ka-ai, <verse eid="MAT 8:16" /><verse number="17" style="v" sid="MAT 8:17" />ng'kơi đóng tarnêêng achêk bâân tajaap paraaq ơi bâân praaq tââq Ê-saai manưih đââng taruuih kơi ađô: “Chênh Ađó ơi pei gưi nôôq rau ka-ai dhuôr ưng nôôq he lơq ơi đơơp geng ka-ai karuôq ưng nôôq he.”<verse eid="MAT 8:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 8:18" />Xók achêk, bhêêl xók lêi tanóói dhanuôr xirvir praang ađêi, Chuôq Jê-su nek kayua yuur vôôiq chaang tóór hót tôôh. <verse eid="MAT 8:18" /><verse number="19" style="v" sid="MAT 8:19" />Hayơq mưi manưih pachóóm gani, xong xók tơk đan, ơi móón palơq Ađó: “Thêi ơơi, aku e ting thêi dhơ dhaleq thêi vôôiq.” <verse eid="MAT 8:19" /><verse number="20" style="v" sid="MAT 8:20" />Chuôq Jê-su praaq palơq ađó: “Axing ve bóng, lơq achim pleng ve xaruh, bơơi Akóón Manưih kah ve dhiq hơq Ađó ve chóóm ta-ââih akoq.” <verse eid="MAT 8:20" /><verse number="21" style="v" sid="MAT 8:21" />Kơi achêk hayơq, mưi chanak lââng kalóóng nôôq môôn-đô móón palơq Ađó: “Kakoh Chuôq, nhan đóng pheep aku laloom kơ nek yuur chô lơq tơp ama aku” <verse eid="MAT 8:21" /><verse number="22" style="v" sid="MAT 8:22" />Bơơi Chuôq Jê-su praaq palơq ađó: “Bhiêk ting thêi, lơq nek lơơi manưih chêt tơp manưih chêt ưng piđó.”<verse eid="MAT 8:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 8:23" />Xók Ađó ơi mót leq kalóóng bhuông, nôôq môôn-đô ưng Ađó vôôiq ting Ađó. <verse eid="MAT 8:23" /><verse number="24" style="v" sid="MAT 8:24" />Lêi tôôh, mưi ganơt adhiiq lóng gamak yuur vaaih dhiq taxiiq, tơk mơ bhuông bâân ga-uul đơơk dhuum. Bơơi Ađó xók bêch. <verse eid="MAT 8:24" /><verse number="25" style="v" sid="MAT 8:25" />Hayơq xók tơk đan, piđó payuur Ađó, móón: “Kakoh Chuôq, nhan Amei paq jóói; nôôq he ravang chêt aq!” <verse eid="MAT 8:25" /><verse number="26" style="v" sid="MAT 8:26" />Lơq Chuôq praaq palơq piđó: “Nôôq manưih m'bưưiq lóóm huuiq tôôh, hau adhi anó kakhin kapơn?” Xong ađek, xók ơi yuur, Ađó katah adhiiq lơq taxiiq, nek yuur vaaih pat parngau liglia. <verse eid="MAT 8:26" /><verse number="27" style="v" sid="MAT 8:27" />Dyơq nôôq manưih achêk hêq lêi, móón: “Manưih ađô nek ng'kơi dhơq, taai patơk mơ adhiiq lơq taxiiq maar xâng bóóp Ađó?”<verse eid="MAT 8:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 8:28" />Hayơq bhêêl Ađó ơi vôôiq chaang tóór hót tôôh, tơk parah Ga-đa-ra, bơơr chanak bâân abhưi bóq nek tơk lum Ađó, xong xók vôôiq gluh tââq dham ping xaal, nhiđó lóng tagah kakhin lêi tơk mơ kah ngaai ve khin buôn vôôiq hót kalơng ađek. <verse eid="MAT 8:28" /><verse number="29" style="v" sid="MAT 8:29" />Lêi tôôh, nhiđó yuur treeh, kơi ađô: “Kakoh Akóón Yaang Pleng, Nôôq yi palơq Amei ve rau dhơq? Amei tơk leq ađô buôn têêng janah nôôq yi laloom ganah kơq?” <verse eid="MAT 8:29" /><verse number="30" style="v" sid="MAT 8:30" />Bhêêl achêk, ve mưi kanan adhââk lóng bơk xók tatưưk tââq piđó yươq rau changaai. <verse eid="MAT 8:30" /><verse number="31" style="v" sid="MAT 8:31" />Kơi achêk hayơq, nôôq abhưi mââl nhan Ađó, kơi ađô: “La Amei pagluh nôôq yi, nhan đóng nôôq yi jaq leq kanan adhââk tôôh.” <verse eid="MAT 8:31" /><verse number="32" style="v" sid="MAT 8:32" />Chuôq yua piđó: “Vôôiq aq!” Kơi achêk nek xong xók ơi gluh, kabhuh piđó jaq leq kanan adhââk; lơq nek lêi tôôh, tabhơt kanan yuur n'tôq tââq dharluônh traan tanjơt tơk leq taxiiq, hayơq piđó chêt dhiq đơơk. <verse eid="MAT 8:32" /><verse number="33" style="v" sid="MAT 8:33" />Bhêêl achêk, nôôq manưih jư adhââk xooq mut, lơq xong xók chô tơk kanóón, piđó truuih lóóiq dyóp rau, tabhơt nôôq chiên ve pâng tơk nôôq manưih bâân abhưi bóq. <verse eid="MAT 8:33" /><verse number="34" style="v" sid="MAT 8:34" />Lơq nek lêi tôôh, bhơt kanóón karu gluh buôn lum Chuôq Jê-su. Xók ơi lêi Ađó, piđó mââl nhan ng'kơi đóng Ađó yuur xooq leq lââng lơh tââq xưưq xaang ưng piđó.<verse eid="MAT 8:34" /></para>
  <chapter eid="MAT 8" />
  <chapter number="9" style="c" sid="MAT 9" />
  <para style="p">
    <verse number="1" style="v" sid="MAT 9:1" />Bhêêl ơi mót kalóóng bhuông, Ađó chaang taxiiq lơq chô tơk kanóón ưng ađêi. <verse eid="MAT 9:1" /><verse number="2" style="v" sid="MAT 9:2" />Lêi tôôh, palââng đââng tơk leq Ađó mưi chanak đu rabóót achak xók bêch dhiq alơơq. Xók Chuôq Jê-su lêi lóóm huuiq ưng piđó, Ađó praaq lơq manưih đu rabóót achak: “Nô akóón, phaai yuur nhóól lóóm. Nôôq matu lơt akóón ơi bâân lơơi lơt.” <verse eid="MAT 9:2" /><verse number="3" style="v" sid="MAT 9:3" />Lơq lêi tôôh, mưi phơn kalóóng nôôq manưih pachóóm gani móón palơq xóng piđó: “Manưih ađô praaq chôlô.” <verse eid="MAT 9:3" /><verse number="4" style="v" sid="MAT 9:4" />Taai ơi n'nal nôôq karnóq ưng piđó, Chuôq Jê-su praaq: “Nôôq pe kanóq môôp maap kalóóng lóóm ađêi hau rau đươi? <verse eid="MAT 9:4" /><verse number="5" style="v" sid="MAT 9:5" />Ơi hau rau nek khe lơh ngi praaq: ‘Nôôq matu lơt akóón ơi bâân lơơi lơt,’ môôiq praaq: ‘Nek yuur dyương lơq jađaang vôôiq’? <verse eid="MAT 9:5" /><verse number="6" style="v" sid="MAT 9:6" />Bơơi buôn nôôq pe ve chóóm n'nal kơi Akóón Manưih ve karơ mataai tơơt dhiq katiêk buôn lơơi matu …” nek xók bhêêl ađek, Ađó yua manưih rabóót achak: “Nek yuur dyương, halooq alơơq, lơq yuur chô leq đong ađêi.” <verse eid="MAT 9:6" /><verse number="7" style="v" sid="MAT 9:7" />Lơq xong xók yuur dyương, manưih ađek chô leq đong ađêi. <verse eid="MAT 9:7" /><verse number="8" style="v" sid="MAT 9:8" />Kơi achêk nek, xók lêi kơi achêk, tanóói dhanuôr braaih kakhin lơq bhi haanh Yaang Pleng, taai ơi đóng leq akóón manưih karơ mataai kơi achêk. <verse eid="MAT 9:8" /><verse number="9" style="v" sid="MAT 9:9" />Xók ơi tââq ađek yuur vôôiq, Chuôq Jê-su ve lêi mưi chanak achak Ma-thi-ơ xók tơơt dhiq đong pagoop jêên, hayơq Chuôq yua ađó: “Hêq ting thêi.” Lơq xong xók yuur dyương, ađó vôôiq ting Chuôq.<verse eid="MAT 9:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 9:10" />Tarnêêng yuur vaaih xók Ađó tơơt cha kalóóng đong, nek lêi tôôh, bơk đu têêng pagoop jêên lơq đu ve matu pơh tơk, ơi tơơt leq baang cha palơq Chuôq Jê-su lơq nôôq môôn-đô Ađó. <verse eid="MAT 9:10" /><verse number="11" style="v" sid="MAT 9:11" />Xók bâân lêi kơi achêk, nôôq manưih Pha-ri-si móón palơq nôôq môôn-đô Ađó: “Ơi taai harau hơq thêi ưng nôôq pe cha madhiq palơq kabhuh pagoop jêên lơq đu ve matu?” <verse eid="MAT 9:11" /><verse number="12" style="v" sid="MAT 9:12" />Bơơi xong xók xâng lêi, Ađó praaq: “Manưih karơ khe kah ve rau đươi leq manưih payươh, hơq nek manưih đu ka-ai. <verse eid="MAT 9:12" /><verse number="13" style="v" sid="MAT 9:13" />Dyơq xong xók vôôiq lơh, phaai hok n'nal xayar ađô nek ng'kơi: ‘Aku kiêng lóóm kayô ka-er, eh rau adhah bhanuôih.’ Ơi eh rau aku bhral buôn dhaloong manưih đu liêm, bơơi nek đu ve matu.”<verse eid="MAT 9:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 9:14" />Bhêêl ađek, nôôq môôn-đô ưng Jang tơk lum Ađó, tamóh: “Ơi taai harau hơq nôôq yi lơq manưih Pha-ri-si đóók drơng cha, dyơq nôôq môôn-đô ưng thêi nek kah drơng cha?” <verse eid="MAT 9:14" /><verse number="15" style="v" sid="MAT 9:15" />Chuôq Jê-su praaq palơq piđó: “Ve kơq nôôq parjơơk ting tơơt bhiêk nhan mamaai ve chóóm ranguôq rabaang kalóóng ganah mơ đươnh hơq chaxaau tơơt nek palơq piđó? Bơơi e tơk tangêi xók hơq chaxaau bâân đââng vôôiq tââq piđó, nek bhêêl ađek piđó e drơng cha. <verse eid="MAT 9:15" /><verse number="16" style="v" sid="MAT 9:16" />Lơh tââq ađek, kah ngaai bươl mưi paleh bhaai tame yươq ơi karnhól leq beq aau ti, ơi bhaai rabươl chatang tanteek tââq beq aau achêk, lơq mưi dham tanteek yuur vaaih gamak lơh. <verse eid="MAT 9:16" /><verse number="17" style="v" sid="MAT 9:17" />Kung kah ngaai jrung alak tame leq aluui ng'kar ti. Bơơi la eh rau kơi achêk, nek kakhin e aluui ng'kar bâân pađóh bhriq, alak bâân tantoh lơq aluui bâân bhraaiq. Klóóih leq ađek, palââng jrung alak tame leq aluui ng'kar tame, lơq miq bơơr bâân jư paliêm.”<verse eid="MAT 9:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 9:18" />Bhêêl xók Ađó papraaq nôôq paraaq achêk palơq piđó, nek lêi tôôh, mưi nak jư lêi đong gươl xong xók tơk pađan, ơi chakoh chok leq toom Ađó, móón kơi ađô: “Akóón pađiil aku nôk tame chêt, hơq bơơi bhêêl tơk ađek, nhan nek lơơi têi thêi dhiq akóón paniên, nek akóón paniên e mamông.” <verse eid="MAT 9:18" /><verse number="19" style="v" sid="MAT 9:19" />Xong xók yuur dyương, Chuôq Jê-su lơq nôôq môôn-đô Ađó ting vôôiq lơq ađó achêk. <verse eid="MAT 9:19" /><verse number="20" style="v" sid="MAT 9:20" />Lơq lêi tôôh, mưi akan pađiil đơơp jruôn ka-ai hóói ahaam bhluuch majêt bơơr kamó, xók tơk pađan hót hóng Ađó hayơq, nek ơi xuui leq xrooi aau ưng Ađó, <verse eid="MAT 9:20" /><verse number="21" style="v" sid="MAT 9:21" />Ơi ađó tư kanóq: “La ađêi mơ xuui leq aau Ađó giêl, nek ađêi e bâân yươh ka-ai.” <verse eid="MAT 9:21" /><verse number="22" style="v" sid="MAT 9:22" />Bơơi xong xók palâh lóóiq lơq lêi ađó, Chuôq Jê-su móón: “Akóón pađiil ơơi, phaai mưng lóóm; lóóm huuiq akóón ơi payươh akóón.” Lơq manưih akan pađiil achêk bâân yươh ka-ai tââq bhêêl ađek. <verse eid="MAT 9:22" /><verse number="23" style="v" sid="MAT 9:23" />Hayơq Chuôq Jê-su, xong xók vôôiq tơk đong manưih jư lêi đong gươl achêk lơq lêi nôôq đu plong aluôt palơq manưih ganơr ka-uôih kadhuôih, <verse eid="MAT 9:23" /><verse number="24" style="v" sid="MAT 9:24" />ơi praaq: “Nek róch dhun, ơi akóón pađiil yươq rau chêt, bơơi nek xók bêch.” Hayơq piđó kachang jóóch Ađó. <verse eid="MAT 9:24" /><verse number="25" style="v" sid="MAT 9:25" />Kơi achêk nek, bhêêl manưih ganơr ơi bâân tađuôi gluh leq nguôi, nek xong xók mót kalóóng, Ađó kadhâng têi akóón paniên, lơq akóón pađiil achêk tư yuur tơơt. <verse eid="MAT 9:25" /><verse number="26" style="v" sid="MAT 9:26" />Taruuih ađô yuur tanđôôr plok kalóóng parah ađek.<verse eid="MAT 9:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 9:27" />Xók bhêêl Chuôq Jê-su tââq dhiq ađek yuur vôôiq, nek bơơr chanak kabaang ơi vôôiq ting Ađó, lalơu karơ, lơq móón: “Kakoh Akóón bhua Đa-viit, nhan kayô ka-er nôôq yi!” <verse eid="MAT 9:27" /><verse number="28" style="v" sid="MAT 9:28" />Bhêêl achêk, xók ơi mót leq kalóóng đong, bơơr chanak kabaang tơk pađan Ađó lơq Chuôq Jê-su praaq palơq nhiđó: “Ve alua nôôq anó huuiq kơi Aku ve chóóm yuur têêng tarnêêng achêk?” Nhiđó móón palơq Ađó: “Alua, Chuôq ơơi.” <verse eid="MAT 9:28" /><verse number="29" style="v" sid="MAT 9:29" />Xók ađek, Ađó rapơq leq mat nhiđó, praaq: “Tarnêêng achêk phaai bâân yuur vaaih đóng nôôq anó ting kơi lóóm huuiq ưng nôôq anó,” <verse eid="MAT 9:29" /><verse number="30" style="v" sid="MAT 9:30" />Mat nhiđó bâân tapơơh, lơq Chuôq Jê-su pagat nhiđó, kơi ađô: “Phaai chagơn, nôôq anó óóq đóng ngaai n'nal.” <verse eid="MAT 9:30" /><verse number="31" style="v" sid="MAT 9:31" />Bơơi xong xók gluh leq nguôi, nhiđó truuih đuui tarnêêng achêk plok kalóóng parah ađek.<verse eid="MAT 9:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 9:32" />Xók achêk, dyơq xók nhiđó vôôiq gluh, nek lêi tôôh, palââng đââng tơk leq Ađó mưi chanak a-ơp bâân abhưi bóq. <verse eid="MAT 9:32" /><verse number="33" style="v" sid="MAT 9:33" />Bhêêl abhưi ơi bâân tapagluh, nek manưih a-ơp chóóm praaq, lơq manưih ganơr hêq lêi, praaq: “Mưi tarnêêng kơi achêk kah ve glêh bâân tapakah kalóóng I-sơ-ra-êên!” <verse eid="MAT 9:33" /><verse number="34" style="v" sid="MAT 9:34" />Bơơi nôôq manưih Pha-ri-si biêh móón: “Ađó viêng abhưi đươi leq takóh abhưi.”<verse eid="MAT 9:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="MAT 9:35" />Chuôq Jê-su vôôiq val plok bhơt nôôq kanóón lơq bhươl veel, pachóóm pató kalóóng nôôq đong gươl ưng manưih dhanuôr, truuih đuui Taruuih Liêm ưng katiêk pleng lơq payươh ting rau dhuôr palơq dyóp ka-ai dhur. <verse eid="MAT 9:35" /><verse number="36" style="v" sid="MAT 9:36" />Xók achêk, bhêêl lêi nôôq tanóói dhanuôr ganơr, Ađó kayô ka-er lêi đóng piđó, taai piđó xók bâân m'bhiiq vei lơq jruôn rau tachêh tavươk, ngóq kơi trưưu kah ve manưih jư. <verse eid="MAT 9:36" /><verse number="37" style="v" sid="MAT 9:37" />Xong ađek, Ađó praaq palơq nôôq môôn-đô ađêi: “Dhơ nil xóót nek bơk aviq, bơơi manưih xóót nek m'bưưiq. <verse eid="MAT 9:37" /><verse number="38" style="v" sid="MAT 9:38" />Taai ađek, phaai gavơh nhan Kala ưng nil xóót, ng'kơi đóng Ađó kayua nôôq manưih xóót mót kalóóng nil xóót ưng ađêi.”<verse eid="MAT 9:38" /></para>
  <chapter eid="MAT 9" />
  <chapter number="10" style="c" sid="MAT 10" />
  <para style="p">
    <verse number="1" style="v" sid="MAT 10:1" />Xong xók dhaloong majêt bơơr môôn-đô ưng ađêi tơk, Ađó ơi đóng leq piđó paraaq mataai dhiq nôôq yaang anhuq, buôn pagluh piđó lơq payươh ting rau khuch dhuôr palơq dyóp ka-ai dhur. <verse eid="MAT 10:1" /><verse number="2" style="v" sid="MAT 10:2" />Achak ưng majêt bơơr sưưq-đô nek nô kơi: Laloom tââp, Si-môôn (bâân đóók nek Phi-e-rơ) lơq En-rê, adhi padruuih ađó; Ja-kơ akóón ưng Xê-bê-đê lơq Jang, adhi padruuih ađó; <verse eid="MAT 10:2" /><verse number="3" style="v" sid="MAT 10:3" />Phi-liip lơq Ba-thê-lê-mi; Thô-ma lơq Ma-thi-ơ, manưih đu pagoop jêên; Ja-kơ akóón ưng A-phê, lơq Tha-đê; <verse eid="MAT 10:3" /><verse number="4" style="v" sid="MAT 10:4" />Si-môôn Xê-lôôt, lơq Ju-đa Ich-ka-ri-ôôt, kung nek đu ơi tamôôp Ađó.<verse eid="MAT 10:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 10:5" />Chuôq Jê-su ơi kayua majêt bơơr nak ađô vôôiq, xong xók praaq pató piđó kơi ađô: “Óóq vôôiq dhiq kalơng ưng nôôq dhanuôr manưih nguôi, kung óóq mót kalóóng kanóón ưng manưih Sa-ma-ri. <verse eid="MAT 10:5" /><verse number="6" style="v" sid="MAT 10:6" />Bơơi nek vôôiq palơq nôôq akóón trưưu xraang bil ưng đong I-sơ-ra-êên nek lơh. <verse eid="MAT 10:6" /><verse number="7" style="v" sid="MAT 10:7" />Xók achêk, bhêêl vôôiq kalơng, adhi anó phaai truuih đuui, praaq kơi ađô: ‘Katiêk pleng ơi tơk đan.’ <verse eid="MAT 10:7" /><verse number="8" style="v" sid="MAT 10:8" />Phaai payươh manưih ka-ai dhur, têêng manưih chêt mamông lóóiq, têêng pasek manưih tơơt bhơơi lơq pagluh nôôq abhưi. Adhi anó ơi đơơp kagóh, nek phaai đóng kagóh. <verse eid="MAT 10:8" /><verse number="9" style="v" sid="MAT 10:9" />Óóq koom ha-ơu vaang, môôiq baak, môôiq đông jêên kalóóng bhiiq dhiq hóng ưng adhi anó, <verse eid="MAT 10:9" /><verse number="10" style="v" sid="MAT 10:10" />kah chadhung talek đóng galuh vôôiq, môôiq bơơr aau, môôiq jêi, môôiq tarlââng, ơi manưih têêng makông đaang bâân phơn cha ađêi. <verse eid="MAT 10:10" /><verse number="11" style="v" sid="MAT 10:11" />Dyơq kalóóng kanóón môôiq n'đó bhươl hơq adhi anó vôôiq mót, nek tabâân n'nal mưi ngaai ađek kalóóng dhiq ađô nek manưih đu ađaang, nek tơơt dhiq ađek đóng patơk xók bhêêl adhi anó yuur vôôiq. <verse eid="MAT 10:11" /><verse number="12" style="v" sid="MAT 10:12" />Xók achêk, xók mót kalóóng đong ađek, nek nhan yươq rauha đóng dhiq achêk. <verse eid="MAT 10:12" /><verse number="13" style="v" sid="MAT 10:13" />Mưi phơn, la đong ađek nek dhiq đu ađaang, nek yươq rauha ưng adhi anó phaai tơk dhiq ađó, kơi lââng, la ađó eh rau nek dhiq đu ađaang, nek yươq rauha ưng adhi anó phaai bâân val chô palơq adhi anó. <verse eid="MAT 10:13" /><verse number="14" style="v" sid="MAT 10:14" />Lơq ngaai đu kah pơh yaauq adhi anó, kung kah tameng xâng nôôq paraaq ưng adhi anó, nek xók vôôiq gluh tââq đong môôiq kanóón ađek, nek tapiêh puui dhiq dyung adhi anó. <verse eid="MAT 10:14" /><verse number="15" style="v" sid="MAT 10:15" />Alua, thêi praaq palơq adhi anó, e nek nh'jang khe đóng katiêk Sô-đôôm lơq Gô-mô-rơ kalóóng tangêi xêi xanêi lơh nek đóng kanóón ađek.<verse eid="MAT 10:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 10:16" />Lêi nô, thêi kayua adhi anó vôôiq kơi trưưu tơơt dhiq m'pơng kabhuh axing, đóng hayơq nek val xar tabech galang kơi kaxênh lơq moor m'pheep kơi achim paraap. <verse eid="MAT 10:16" /><verse number="17" style="v" sid="MAT 10:17" />Bơơi nek hêch lêi leq palââng, ơi piđó e pajaau đââng adhi anó leq kabhuh xêi xanêi, lơq palââng e m'bhiiq adhi anó palơq rooi kalóóng đong gươl ưng piđó; <verse eid="MAT 10:17" /><verse number="18" style="v" sid="MAT 10:18" />hayơq adhi anó patơk mơ e bâân tađââng tơk toom nôôq kuôn gamak lơq nôôq bhua ơi taai thêi, buôn kơi mưi paraaq truuih đóng piđó lơq đóng nôôq dhanuôr đu lââng. <verse eid="MAT 10:18" /><verse number="19" style="v" sid="MAT 10:19" />Bơơi bhêêl piđó pajaau đââng adhi anó, óóq karaang kakhin leq n'đó kơi môôiq hau rau ađêi kơng praaq, ơi rau hơq adhi anó kơng praaq e bâân đóng leq adhi anó xók bhêêl ađek. <verse eid="MAT 10:19" /><verse number="20" style="v" sid="MAT 10:20" />Ơi eh rau adhi anó nek manưih praaq, bơơi nek Yaang Liêm ưng Ama adhi anó praaq kalóóng adhi anó. <verse eid="MAT 10:20" /><verse number="21" style="v" sid="MAT 10:21" />Lơh ađek, anó e pajaau adhi mót leq chêt, lơq akonh nek pajaau akóón, lơq akóón anaaq e yuur vaaih huông palơq akonh akan lơq e têêng piđó phaai chêt. <verse eid="MAT 10:21" /><verse number="22" style="v" sid="MAT 10:22" />Lơq adhi anó e bâân dyóp ngaai gaam geet taai dhanóók thêi, bơơi ngaai đu đuôh jruôn tơk tatun xariêq, manưih achêk e bâân paq. <verse eid="MAT 10:22" /><verse number="23" style="v" sid="MAT 10:23" />Bơơi n'đó bhêêl palââng kóóp róp adhi anó kalóóng kanóón ađô, hơq nek mut leq kanóón tôôh, ơi alua, thêi praaq palơq adhi anó, dhơ dhakơi adhi anó kah chóóm đuôh vôôiq bhơt nôôq kanóón ưng I-sơ-ra-êên đóng patơk xók bhêêl Akóón Manưih bhral.<verse eid="MAT 10:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 10:24" />Môôn-đô nek kah lơh thêi, dhơn ratơơq kung kah lơh kala ađêi. <verse eid="MAT 10:24" /><verse number="25" style="v" sid="MAT 10:25" />Nek palơq môôn-đô, ng'kơi đóng manưih achêk ve chóóm bâân kơi thêi ađêi, lơq dhơn ratơơq nek kơi kala ađêi, nek dyóp aq. La palââng ơi đóók kala đong nek Bê-êên-xê-buun, nek manưih đong ưng kala dyơq parneq lơh tơk n'nal mơ! <verse eid="MAT 10:25" /><verse number="26" style="v" sid="MAT 10:26" />Kơi achêk, óóq kakhin piđó, ơi kah ve hau rau bâân gơp pađơp hơq e kah bâân tapakah, bâân kadrêi palââp hơq e kah bâân palââng n'nal. <verse eid="MAT 10:26" /><verse number="27" style="v" sid="MAT 10:27" />Rau thêi truuih móón adhi anó tơơt dhiq kanam, phaai yuur praaq tơơt dhiq brương, lơq rau adhi anó xâng dhiq katór, phaai truuih karơ dhiq pabhung đong. <verse eid="MAT 10:27" /><verse number="28" style="v" sid="MAT 10:28" />Óóq braaih kakhin toom nôôq đu leng chêt achak araang hơq yươq chóóm leng chêt ravaai. Bơơi phaai braaih kakhin Yaang ve chóóm leng kaxiêt tabhơt ravaai palơq achak araang dhiq kalóóng bóng óih nek lơh. <verse eid="MAT 10:28" /><verse number="29" style="v" sid="MAT 10:29" />Kah alua bơơr panong achim a-iih chóóm baan palơq janaaq mưi xu kah alua? Lơq yươq mưi panong panâ kalóóng nôôq piđó e n'tôq leq katiêk lơh tââq karnóq kiêng ưng Ama adhi anó. <verse eid="MAT 10:29" /><verse number="30" style="v" sid="MAT 10:30" />Hơq nek chênh xok dhiq akoq adhi anó, tabhơt nek kung ơi bâân yaap. <verse eid="MAT 10:30" /><verse number="31" style="v" sid="MAT 10:31" />Taai ađek, óóq kakhin; adhi anó kiiq liêm bơk lơh akóón achim a-iih. <verse eid="MAT 10:31" /><verse number="32" style="v" sid="MAT 10:32" />Kơi achêk, ting chanak, hơq nek tabhơt dhơ dhangaai e đơơp chanót leq thêi toom mat palââng, nek thêi kung e đơơp chanót leq manưih ađek toom mat Ama thêi dhiq pleng. <verse eid="MAT 10:32" /><verse number="33" style="v" sid="MAT 10:33" />Bơơi dhơ dhangaai đu dyiin thêi toom mat palââng, nek thêi kung e dyiin manưih ađek toom mat Ama thêi dhiq pleng.<verse eid="MAT 10:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 10:34" />Óóq ngóq kơi thêi bhral buôn đââng yươq rauha dhiq katiêk. Thêi kah bhral buôn đââng yươq rauha, hơq nek bhươt dhaau. <verse eid="MAT 10:34" /><verse number="35" style="v" sid="MAT 10:35" />Ơi thêi bhral buôn têêng akóón padruuih tarjơl lóóiq akonh ađêi, akóón pađiil tarjơl lóóiq akan ađêi, mamaai tarjơl lóóiq akan kayiik ađêi; <verse eid="MAT 10:35" /><verse number="36" style="v" sid="MAT 10:36" />lơq manưih brau ưng mưi nak nek nôôq ngaai kalóóng parlóng đong ưng manưih achêk. <verse eid="MAT 10:36" /><verse number="37" style="v" sid="MAT 10:37" />Ngaai nh'nhơr akonh môôiq akan lơh thêi nek kah chóóm ađaang palơq thêi; ngaai nh'nhơr akóón padruuih môôiq akóón pađiil lơh thêi nek kung kah chóóm ađaang palơq thêi. <verse eid="MAT 10:37" /><verse number="38" style="v" sid="MAT 10:38" />Lơq ngaai đu kah đuôl n'lóóng m'baang chatông ađêi lơq ting tapun thêi nek kah chóóm đaang palơq thêi. <verse eid="MAT 10:38" /><verse number="39" style="v" sid="MAT 10:39" />Ngaai chêk tabâân parmông ađêi e têêng tabil ađó, hơq ngaai bil parmông ađêi ơi taai thêi e ve bâân ađó.<verse eid="MAT 10:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="MAT 10:40" />Ngaai pơh yaauq adhi anó nek pơh yaauq thêi, lơq ngaai pơh yaauq thêi nek pơh yaauq Yaang ơi đu kayua thêi. <verse eid="MAT 10:40" /><verse number="41" style="v" sid="MAT 10:41" />Ngaai pơh yaauq mưi manưih đââng taruuih nek taai dhanóók tarnêêng manưih đââng taruuih e bâân đơơp kaliim haanh ưng manưih đââng taruuih, lơq ngaai pơh yaauq mưi chanak bhơt liêm nek taai dhanóók tarnêêng manưih bhơt liêm e bâân đơơp kaliim haanh ưng manưih bhơt liêm. <verse eid="MAT 10:41" /><verse number="42" style="v" sid="MAT 10:42" />Lơq la ngaai đóng mưi kalóóng nôôq đu katưưiq katit ađô ơm mưi choom đơơk chriêt mơ taai dhanóók tarnêêng môôn-đô, nek alua thêi praaq palơq adhi anó, manưih ađek dhơ dhakơi kah bil kaliim haanh ưng ađêi.”<verse eid="MAT 10:42" /></para>
  <chapter eid="MAT 10" />
  <chapter number="11" style="c" sid="MAT 11" />
  <para style="p">
    <verse number="1" style="v" sid="MAT 11:1" />Tarnêêng yuur vaaih xók Chuôq Jê-su ơi truuih pachóóm majêt bơơr môôn-đô ưng ađêi xong, Ađó xooq tââq ađek buôn pató pachóóm lơq truuih đuui kalóóng nôôq kanóón ưng manưih dhanuôr. <verse eid="MAT 11:1" /><verse number="2" style="v" sid="MAT 11:2" />Xók achêk, Jang, xong xók tââq kalóóng đong kanam xâng truuih lóóiq leq nôôq tarnêêng têêng ưng Chuôq Paq Manưih, nek móón dhiq nôôq môôn-đô ađêi ơi kayua vôôiq, <verse eid="MAT 11:2" /><verse number="3" style="v" sid="MAT 11:3" />ơi móón palơq Ađó: “Thêi nek Yaang phaai tơk, môôiq nôôq yi dyơq đương rââm mưi Yaang lââng?” <verse eid="MAT 11:3" /><verse number="4" style="v" sid="MAT 11:4" />Buôn ââi lóóiq, Chuôq Jê-su praaq palơq piđó: “Xong xók yuur vôôiq, phaai truuih lóóiq leq Jang nôôq rau adhi anó lêi lơq xâng. <verse eid="MAT 11:4" /><verse number="5" style="v" sid="MAT 11:5" />Manưih kabaang chóóm lêi, manưih khuch chóóm vôôiq, manưih tơơt bhơơi bâân kajut sek, manưih tung chóóm xâng, manưih chêt bâân têêng mamông lóóiq lơq manưih ngeeo hadhơơp bâân truuih đóng Taruuih Liêm. <verse eid="MAT 11:5" /><verse number="6" style="v" sid="MAT 11:6" />Lơq hơq ngaai yươq bâân n'đóih kalơm ơi taai thêi nek manưih bâân phươk.”<verse eid="MAT 11:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 11:7" />Xók achêk, xók nôôq manưih ađek ơi yuur vôôiq, Chuôq Jê-su tââp praaq palơq manưih ganơr leq Jang: “Adhi anó vôôiq gluh leq kruung vơng buôn lêi harau — tââm karbho bâân ng'kơr taai adhiiq alua? <verse eid="MAT 11:7" /><verse number="8" style="v" sid="MAT 11:8" />Eh dhơq kơi achêk nek adhi anó vôôiq gluh buôn lêi harau — mưi nak bâân xơp kun aau liêm kalóóng kadhók kayór môôiq kơq? Lêi tôôh, manưih xơp n'đóh kadhók kayór nek tơơt kalóóng đong bhua. <verse eid="MAT 11:8" /><verse number="9" style="v" sid="MAT 11:9" />Palâh lóóiq, adhi anó vôôiq gluh buôn lêi harau — mưi manưih đââng taruuih eh alua? Aku praaq palơq adhi anó, alua lơq patơk mơ lơh tabhơt mưi manưih đââng taruuih. <verse eid="MAT 11:9" /><verse number="10" style="v" sid="MAT 11:10" />Achêk nek leq ađó hơq paraaq ađô ơi bâân xaraq:</para>
  <para style="q" vid="MAT 11:10">‘Lêi tôôh, Aku xók kayua manưih đââng taruuih ưng Aku vôôiq toom mat akóón, ađó e dhoon kalơng ưng akóón toom mat akóón.’<verse eid="MAT 11:10" /></para>
  <para style="b" />
  <para style="m">
    <verse number="11" style="v" sid="MAT 11:11" />Alua, aku praaq palơq adhi anó, kah mưi ngaai bâân tahayuur kalóóng nôôq manưih bâân manưih pađiil yuur n'niên nek bhi chap lơh Jang Bap-tiit, hơq manưih katưưiq tââm kalóóng katiêk pleng nek bhi chap lơh ađó. <verse eid="MAT 11:11" /><verse number="12" style="v" sid="MAT 11:12" />Bơơi tââq tangêi ưng Jang Bap-tiit patơk leq ađôk, katiêk pleng đơơp tajơl palơq m'bhiiq vei, lơq nôôq đu jar-ââih huông vech praan karơ pei n'drooih ađó. <verse eid="MAT 11:12" /><verse number="13" style="v" sid="MAT 11:13" />Ơi tabhơt nôôq manưih loom đââng taruuih lơq gani ơi loom móón patơk Jang; <verse eid="MAT 11:13" /><verse number="14" style="v" sid="MAT 11:14" />lơq la adhi anó ve lóóm đơơp đươi, nek ađó achêk nek Ê-li, manưih phaai bhral. <verse eid="MAT 11:14" /><verse number="15" style="v" sid="MAT 11:15" />Ngaai ve katór buôn xâng, nek xâng. <verse eid="MAT 11:15" /><verse number="16" style="v" sid="MAT 11:16" />Bơơi Aku e marchơng dhong nooi ađô palơq hau rau? Piđó nek thê kơi kabhuh akóón paniên tơơt dhiq kalóóng chơơq, hơq piđó dhaloong dhabơ xóng piđó, <verse eid="MAT 11:16" /><verse number="17" style="v" sid="MAT 11:17" />kơi ađô: ‘Nôôq yi plong aluôt đóng nôôq pe, hơq nôôq pe kah yuur tanâât. Nôôq yi kayô châq hơq nôôq pe kah nhiim.’ <verse eid="MAT 11:17" /><verse number="18" style="v" sid="MAT 11:18" />Ơi Jang bhral, kah cha kung kah ơm, nek piđó móón: ‘Ađó ađek bâân abhưi bóq.’ <verse eid="MAT 11:18" /><verse number="19" style="v" sid="MAT 11:19" />Akóón Manưih bhral, cha lơq ơm, nek piđó móón: ‘Lêi ađó ađek tôôh, mưi chanak n'thaam cha, mưi chanak giêng alak, parjơơk ưng kabhuh pagoop jêên lơq kabhuh manưih matu lơt!’ Bơơi hayơq rau tabech galang bâân tapaq tââq nôôq akóón anaaq ưng ađó.”<verse eid="MAT 11:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 11:20" />Xong ađek, Ađó tââp trêh teng nôôq kanóón hơq nek tabhơt nôôq mataai chrih ưng Ađó bâân yuur têêng dhiq nôôq dham achêk, taai piđó ơi kah klôôq lóóm. <verse eid="MAT 11:20" /><verse number="21" style="v" sid="MAT 11:21" />“Ayô xarngaat đóng amei, Kô-ra-xiin! Ayô xarngaat đóng amei, Bêêt-saai-đa! Ơi la nôôq tarnêêng karơ mataai yuur vaaih m'pơng nôôq pe ơi bâân yuur têêng dhiq Ti-rơ lơq Si-đôôn, hơq dhakơi nek piđó ơi klôôq lóóm kalóóng bhaai agruuq lơq vươk bló tââq đươnh ơi. <verse eid="MAT 11:21" /><verse number="22" style="v" sid="MAT 11:22" />Dhơ kơi achêk, Aku praaq palơq nôôq pe, e ve rau buôn khe lơh đóng Ti-rơ lơq Si-đôôn kalóóng tangêi xêi xanêi lơh nek đóng nôôq pe. <verse eid="MAT 11:22" /><verse number="23" style="v" sid="MAT 11:23" />Hayơq amei, Ka-bê-na-um, ve kơq amei e bâân padyók yaal tơk leq pleng? Amei e vôôiq dhaluônh tơk dhiq bóng maraaih. Ơi la nôôq tarnêêng mataai karơ yuur vaaih dhiq amei ơi bâân yuur têêng dhiq Sô-đôôm, hơq dhakơi nek kanóón achêk ơi dyơq lóóiq patơk leq tangêi mađôk. <verse eid="MAT 11:23" /><verse number="24" style="v" sid="MAT 11:24" />Dhơ kơi achêk, Aku praaq palơq nôôq pe, kalóóng tangêi xêi xanêi, dyóp rau e buôn khe đóng katiêk Sô-đôôm lơh nek đóng nôôq pe.”<verse eid="MAT 11:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 11:25" />Mót bhêêl ađek, Chuôq Jê-su pơơh bóóp praaq: “Kakoh Ama, nek Chuôq ưng pleng lơq katiêk, Aku bhi haanh Ama, taai Ama ơi kadrêi pađơp nôôq rau ađô tââq manưih tabech galang lơq đu thuông n'nal, hơq pakah piđó đóng paniên katưưiq. <verse eid="MAT 11:25" /><verse number="26" style="v" sid="MAT 11:26" />Ơơq, Ama ơơi, ơi kơi achêk nek rau pâng karnóq toom mat Ama. <verse eid="MAT 11:26" /><verse number="27" style="v" sid="MAT 11:27" />Dyóp tarnêêng ơi bâân Ama aku pajaau leq aku; kah ngaai n'nal Akóón chapiên Ama, kung kah ngaai n'nal Ama chapiên Akóón lơq nôôq ngaai hơq la Akóón kiêng pakah đóng. <verse eid="MAT 11:27" /><verse number="28" style="v" sid="MAT 11:28" />Nek tơk palơq aku, tabhơt nôôq ngaai nhưh nhok lơq đơơp geng haleng, lơq aku e đóng adhi anó bâân dhêi drơq. <verse eid="MAT 11:28" /><verse number="29" style="v" sid="MAT 11:29" />Nek pei bak et ưng aku dhiq adhi anó lơq hok tââq dhiq aku, ơi aku ve lóóm moor dha-iiq lơq lóóm pakatưưiq, hayơq adhi anó e bâân tarlum rau dhêi drơq đóng ravaai ađêi. <verse eid="MAT 11:29" /><verse number="30" style="v" sid="MAT 11:30" />Ơi et ưng aku buôn khe lơq ganeng ưng aku nek khe hangiil.”<verse eid="MAT 11:30" /></para>
  <chapter eid="MAT 11" />
  <chapter number="12" style="c" sid="MAT 12" />
  <para style="p">
    <verse number="1" style="v" sid="MAT 12:1" />Kalóóng mơ ganah ađek, Chuôq Jê-su vôôiq hót nôôq hare aviq mót tangêi Sa-baat, hơq nôôq môôn-đô ưng Ađó ha-ul hayơq piđó tââp xruôt kanuung aviq lơq mók. <verse eid="MAT 12:1" /><verse number="2" style="v" sid="MAT 12:2" />Bơơi xong xók lêi rau ađek, nôôq manưih Pha-ri-si móón palơq Ađó: “Lêi tôôh, nôôq môôn-đô ưng thêi têêng chiên kah chóóm pheep têêng kalóóng tangêi Sa-baat.” <verse eid="MAT 12:2" /><verse number="3" style="v" sid="MAT 12:3" />Dhơ kơi ađek, Ađó praaq palơq piđó: “Nôôq pe ơi kah đok lêi chiên Đa-viit ơi têêng xók bhêêl bhua lơq nôôq manưih vôôiq palơq ađêi bâân ha-ul nek ng'kơi? <verse eid="MAT 12:3" /><verse number="4" style="v" sid="MAT 12:4" />N'đó kơi bhua ơi mót kalóóng đong ưng Yaang Pleng lơq cha beng bhanuôih, hơq beng achêk nek kah đóng pheep bhua lơq nôôq manưih vôôiq palơq bhua buôn cha, chapiên mưi đóng leq takóh kadhâng bhanuôih? <verse eid="MAT 12:4" /><verse number="5" style="v" sid="MAT 12:5" />Môôiq nôôq pe ơi kah đok lêi kalóóng gani kơi mót tangêi Sa-baat, nôôq takóh kadhâng bhanuôih kalóóng đong bhanuôih têêng lơt tangêi Sa-baat hơq piđó nek yươq matu alua? <verse eid="MAT 12:5" /><verse number="6" style="v" sid="MAT 12:6" />Bơơi aku praaq palơq nôôq pe kơi mưi Yaang gamak lơh đong bhanuôih tơơt dhiq ađôk. <verse eid="MAT 12:6" /><verse number="7" style="v" sid="MAT 12:7" />Bơơi la nôôq pe biêh ơi n'nal kiêng móón xayar ađô nek hau: ‘Aku kiêng lóóm kayô ka-er hơq eh rau adhah bhanuôih,’ nek alua nek nôôq pe ơi yươq xêi lơt nôôq manưih yươq lơt. <verse eid="MAT 12:7" /><verse number="8" style="v" sid="MAT 12:8" />Ơi Akóón Manưih nek Chuôq ưng tangêi Sa-baat.”<verse eid="MAT 12:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 12:9" />Lơq xók ơi yuur vôôiq tââq ađek, Ađó mót kalóóng đong gươl ưng piđó. <verse eid="MAT 12:9" /><verse number="10" style="v" sid="MAT 12:10" />Lêi tôôh, mưi chanak ve têi bâân dyóói, lơq piđó tamóh pajal Chuôq Jê-su kơi ađô: “Ve alua chóóm pheep payươh ka-ai kalóóng tangêi Sa-baat?” hơq đóng piđó ve chóóm patu Ađó. <verse eid="MAT 12:10" /><verse number="11" style="v" sid="MAT 12:11" />Bơơi Ađó praaq palơq piđó: “Ve ngaai manưih kalóóng nôôq pe, hơq manưih achêk ve mưi panong trưưu, lơq la ađó n'tôq leq trôông xók tangêi Sa-baat, nek manưih achêk e kah dyuôch kadhâng tamưng ađó lơq galôôi padyók kơq? <verse eid="MAT 12:11" /><verse number="12" style="v" sid="MAT 12:12" />Lơq hayơq akóón manưih nek kiiq liêm lơh akóón trưưu n'nal mơ! Hayơq kơi achêk, ve pheep têêng tarnêêng liêm xók tangêi Sa-baat.” <verse eid="MAT 12:12" /><verse number="13" style="v" sid="MAT 12:13" />Xong ađek, Ađó praaq palơq manưih achêk: “Nek hayuur têi ưng amei.” Manưih achêk hayuur têi lơq ađó bâân yươh khe karơ, i kơi tapaang têi tôôh. <verse eid="MAT 12:13" /><verse number="14" style="v" sid="MAT 12:14" />Bơơi xong xók vôôiq gluh, nôôq manưih Pha-ri-si tabâân mangê jaklâk Ađó ng'kơi đóng piđó ve chóóm leng Ađó.<verse eid="MAT 12:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 12:15" />Bơơi taai ơi n'nal kơi achêk, Chuôq Jê-su yuur xooq tââq dhiq ađek. Bơk manưih ơi vôôiq ting Ađó, hayơq Ađó payươh đóng tabhơt piđó, <verse eid="MAT 12:15" /><verse number="16" style="v" sid="MAT 12:16" />lơq Ađó móón lơơi piđó buôn piđó óóq têêng đóng Ađó pakah mat, <verse eid="MAT 12:16" /><verse number="17" style="v" sid="MAT 12:17" />hơq đóng paraaq ơi bâân praaq dhiq Ê-saai manưih đââng taruuih bâân tajaap, kơi ađô:<verse eid="MAT 12:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="MAT 12:18" />“Lêi nô, dhơn ratơơq Aku, Manưih hơq Aku ơi chââih;</para>
  <para style="q" vid="MAT 12:18">Manưih nh'nhơr tââm ưng Aku, hơq dhiq Ađó, ravaai Aku tabhơt iêm lóóm.</para>
  <para style="q" vid="MAT 12:18">Aku e patơơt Yaang Aku dhiq Ađó,</para>
  <para style="q" vid="MAT 12:18">lơq Ađó e truuih karơ rau bhơt liêm đóng nôôq dhanuôr manưih nguôi.<verse eid="MAT 12:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="MAT 12:19" />Ađó e yươq tarkaai tarlak môôiq lalơu lalaang;</para>
  <para style="q" vid="MAT 12:19">kung yươq ngaai e xâng dhariêng Ađó dhiq kalơng bhlơng.<verse eid="MAT 12:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="MAT 12:20" />Ađó e kah veh tââm karbho ơi bâân bhrươm;</para>
  <para style="q" vid="MAT 12:20">Ađó e kah tapat tiim dhơu róh rariq,</para>
  <para style="q" vid="MAT 12:20">đóng patơk xók bhêêl Ađó đóng rau bhơt liêm tơk bhuui yayar, <verse eid="MAT 12:20" /><verse number="21" style="v" sid="MAT 12:21" />lơq nôôq dhanuôr manưih nguôi e rââm dhiq dhanóók Ađó.”<verse eid="MAT 12:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 12:22" />Xong ađek, mưi chanak kabaang lơq abơq pâng abhưi bóq bâân đââng tơk đóng Ađó, hayơq Ađó payươh đóng manưih ađek, tơk mơ manưih abơq ađô chóóm praaq lơq chóóm lêi. <verse eid="MAT 12:22" /><verse number="23" style="v" sid="MAT 12:23" />Tabhơt tanóói dhanuôr maar hêq lêi lơq móón: “Ve kơq manưih ađô nek Akóón ưng Đa-viit?” <verse eid="MAT 12:23" /><verse number="24" style="v" sid="MAT 12:24" />Hayơq nôôq manưih Pha-ri-si, xong xók xâng chiên ađô, ơi móón: “Ađó ađô kah đuôh chóóm đuôi abhưi la eh alua nek tââq Bê-êên-xê-buun, hơq nek takóh abhưi.” <verse eid="MAT 12:24" /><verse number="25" style="v" sid="MAT 12:25" />Bơơi biêh ơi n'nal lóóm karnóq ưng piđó, Ađó praaq palơq piđó: “Dyóp katiêk bâân tablah tarjơl lóóiq chênh ađêi nek bâân bhahi bhatoong, lơq dyóp kanóón môôiq đong bâân tablah tarvei palơq chênh ađó nek e kah đuôh dyương mưng. <verse eid="MAT 12:25" /><verse number="26" style="v" sid="MAT 12:26" />La Sa-taan pagluh Sa-taan, nek ađó bâân tablah tajơl lóóiq chênh ađó. Kơi achêk nek, ng'kơi chóóm têêng katiêk ađó e dyương mưng? <verse eid="MAT 12:26" /><verse number="27" style="v" sid="MAT 12:27" />Lơq la Aku tââq Bê-êên-xê-buun pagluh nôôq abhưi, nek akóón nôôq pe tââq ngaai pagluh piđó? Ơi taai rau ađô, piđó e nek nôôq manưih xêi xanêi nôôq pe. <verse eid="MAT 12:27" /><verse number="28" style="v" sid="MAT 12:28" />Bơơi la aku pagluh nôôq abhưi tââq Yaang Liêm ưng Yaang Pleng, kơi achêk nek katiêk Yaang Pleng ơi tơk dhiq nôôq pe. <verse eid="MAT 12:28" /><verse number="29" style="v" sid="MAT 12:29" />Môôiq ng'kơi têêng hơq ngaai ngiq ađek ve chóóm mót kalóóng đong ưng manưih karơ praan lơq tatông đô-đaak ưng ađó la laloom kơ manưih ađek kah klooiq manưih karơ praan achêk kơ, hayơq xong ađek, manưih ađô e pei tabhơt drươp đong ađó ađek? <verse eid="MAT 12:29" /><verse number="30" style="v" sid="MAT 12:30" />Ngaai kah tơơt palơq aku nek jơl lóóiq aku, lơq ngaai kah nhoom karong madhiq palơq aku nek tachêh tavươk. <verse eid="MAT 12:30" /><verse number="31" style="v" sid="MAT 12:31" />Ơi taai rau ađô, aku praaq palơq nôôq pe, dyóp matu lơt lơq paraaq praaq chôlô e bâân lơơi lơt đóng palââng, bơơi paraaq lơt tơk Yaang Liêm nek e kah bâân lơơi matu. <verse eid="MAT 12:31" /><verse number="32" style="v" sid="MAT 12:32" />La ngaai praaq paraaq jơl huông Akóón Manưih, nek manưih achêk e bâân lơơi lơt. Bơơi ngaai đu praaq huông palơq Chuôq Yaang Liêm, nek manưih ađek e kah bâân lơơi lơt, tabhơt kalóóng đơơi ađô môôiq kalóóng đơơi ravang tơk. <verse eid="MAT 12:32" /><verse number="33" style="v" sid="MAT 12:33" />Môôiq nek, ngaam n'lóóng liêm nek pale ađó liêm, môôiq ngaam n'lóóng môôp, nek pale ađó môôp, ơi n'lóóng bâân ngi n'nal đươi pale ưng ađó. <verse eid="MAT 12:33" /><verse number="34" style="v" sid="MAT 12:34" />Dhong nooi kaxênh karviêng tôôh, taai nek aak, nôôq pe ng'kơi têêng ve chóóm praaq rau liêm? Ơi bóóp gluh paraaq tââq rau bing bhlaai kalóóng lóóm. <verse eid="MAT 12:34" /><verse number="35" style="v" sid="MAT 12:35" />Manưih liêm, vaaih gluh tââq rau koom ha-ơu liêm kre ưng ađêi, yuur vaaih rau liêm, hơq manưih aak, yuur vaaih tââq rau koom ha-ơu lơt aak ưng ađêi, yuur vaaih rau aak. <verse eid="MAT 12:35" /><verse number="36" style="v" sid="MAT 12:36" />Bơơi Aku praaq palơq nôôq pe kơi dyóp paraaq kah malơơi malaai hơq palââng praaq, piđó e đââng pagluh paraaq truuih pakah leq ađó kalóóng tangêi xêi xanêi. <verse eid="MAT 12:36" /><verse number="37" style="v" sid="MAT 12:37" />Ơi tââq dhiq nôôq gluh paraaq ưng ađêi, nôôq pe e bâân đóók bhơt liêm, lơq tââq dhiq nôôq gluh paraaq ưng ađêi, nôôq pe e bâân patu.”<verse eid="MAT 12:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="MAT 12:38" />Xong ađek, masôôq manưih pachóóm gani lơq manưih Pha-ri-si ơi ââi bóóp palơq Ađó, kơi ađô: “Thêi ơơi, nôôq yi kiêng lêi dhiq Thêi mưi karnal chrih.” <verse eid="MAT 12:38" /><verse number="39" style="v" sid="MAT 12:39" />Bơơi buôn ââi lóóiq, Ađó praaq palơq piđó: “Mưi klaang đơơi lơt aak lơq têêng tapiing chêk tabâân mưi karnal chrih, Bơơi kah ve ađó karnal chrih e bâân đóng leq piđó, chapiên karnal chrih ưng Jô-na manưih đââng taruuih. <verse eid="MAT 12:39" /><verse number="40" style="v" sid="MAT 12:40" />Ơi Jô-na glêh tơơt kalóóng luônh kadhóóng gamak pe tangêi lơq pe hayum n'đó kơi, nek Akóón Manưih e tơơt pe tangêi lơq pe hayum kalóóng bóng katiêk kơi achêk. <verse eid="MAT 12:40" /><verse number="41" style="v" sid="MAT 12:41" />Kalóóng tangêi xêi xanêi, dhanuôr Ni-ni-ve e yuur dyương nek palơq klaang đơơi ađô lơq e yuur kaauq ađó. Ơi piđó ơi klôôq lóóm toom paraaq truuih pachóóm ưng Jô-na, hơq lêi nô, Yaang bhi chap lơh Jô-na tơơt dhiq ađô. <verse eid="MAT 12:41" /><verse number="42" style="v" sid="MAT 12:42" />Kalóóng tangêi xêi xanêi, bhua pađiil charhóóng hót hóng e yuur dyương nek palơq klaang đơơi ađô lơq e yuur kaauq ađó, ơi tââq nôôq dhiq tơk luch ưng katiêk, ađó ơi tơk buôn xâng rau tarbech galang ưng Sa-lô-môôn, hơq lêi nô, Yaang bhi chap lơh Sa-lô-môôn tơơt dhiq ađô. <verse eid="MAT 12:42" /><verse number="43" style="v" sid="MAT 12:43" />Lơh tââq ađek, xók yaang anhuq ơi xooq tââq mưi chanak, ađó vôôiq hót nôôq dhiq góh xâât, tabâân dhiq dhêi hơq kah lêi. <verse eid="MAT 12:43" /><verse number="44" style="v" sid="MAT 12:44" />Bhêêl ađek, ađó móón: ‘Aku e val lóóiq dhiq đong aku hơq aku ơi yuur vôôiq tââq dhiq achêk.’ Xong xók tơk, ađó nek lêi dhanong đong kagóh kagóói, ơi bâân piih dhoon sek se lơq rapaq ralap tapat liêm. <verse eid="MAT 12:44" /><verse number="45" style="v" sid="MAT 12:45" />Xong ađek, ađó vôôiq lơq đââng chô madhiq palơq ađó tapól abhưi lââng dyơq lơt aak lơh ađó, lơq xók ơi mót kalóóng, tabhơt kabhuh mamông dhiq ađek. Hayơq xariêq ưng manưih achêk val xar môôp lơh xók tarnââp. Chiên kung e nek kơi achêk nek palơq dhong nooi lơt aak ađô.”<verse eid="MAT 12:45" /></para>
  <para style="p">
    <verse number="46" style="v" sid="MAT 12:46" />Xók bhêêl Ađó bhiêk dyơq xók praaq palơq manưih ganơr, lêi tôôh, amêêq lơq nôôq adhi ưng Ađó biêh ơi dyương hót nguôi, tabâân kơi buôn praaq chiên palơq Ađó. <verse eid="MAT 12:46" /><verse number="47" style="v" sid="MAT 12:47" />Xók achêk, mưi chanak achêk móón palơq Ađó: “Lêi tôôh, amêêq thêi lơq nôôq adhi ưng thêi ơi dyương hót nguôi, tabâân kơi buôn praaq chiên palơq thêi.” <verse eid="MAT 12:47" /><verse number="48" style="v" sid="MAT 12:48" />Bơơi xók ââi paraaq, Ađó praaq palơq manưih đu móón palơq ađêi: “Ngaai nek amêêq aku lơq ngaai nek nôôq adhi ưng aku?” <verse eid="MAT 12:48" /><verse number="49" style="v" sid="MAT 12:49" />Hayơq xong xók charó têi ađêi malóóm leq nôôq môôn-đô ưng ađêi, Ađó praaq: “Lêi tôôh, amêêq aku lơq nôôq adhi ưng aku ađô! <verse eid="MAT 12:49" /><verse number="50" style="v" sid="MAT 12:50" />Ơi hơq ngaai đu ting têêng karnóq kaniêng ưng Ama aku dhiq pleng, manưih ađek nek adhi padruuih, adhi pađiil lơq amêêq ưng aku.”<verse eid="MAT 12:50" /></para>
  <chapter eid="MAT 12" />
  <chapter number="13" style="c" sid="MAT 13" />
  <para style="p">
    <verse number="1" style="v" sid="MAT 13:1" />Kalóóng tangêi ađek, xong xók vôôiq gluh tââq đong, Chuôq Jê-su tơơt hót tóór taxiiq. <verse eid="MAT 13:1" /><verse number="2" style="v" sid="MAT 13:2" />Tanóói dhanuôr lóng bơk ơi karong lóóiq praang xirvir Ađó. Tơk mơ, xong xók jađaang dyók leq mưi beq bhuông, Ađó tơơt chok leq, hơq tabhơt tanóói dhanuôr nek dyương dhiq kakóóng. <verse eid="MAT 13:2" /><verse number="3" style="v" sid="MAT 13:3" />Hayơq Ađó praaq palơq piđó bơk rau palơq babi, kơi ađô: “Lêi nô, mưi chanak chóói m'ma vôôiq gluh buôn chóói. <verse eid="MAT 13:3" /><verse number="4" style="v" sid="MAT 13:4" />Bhêêl chóói m'ma, mưi phơn kaliêng ruuh tóór kalơng, nek achim pleng pơh lơq chóh bhơt piđó. <verse eid="MAT 13:4" /><verse number="5" style="v" sid="MAT 13:5" />Mưi phơn lââng ruuh dhiq katiêk dhơl dyriên, nek dhiq kah ve bơk katiêk liêm. N'drươh, kaliêng m'ma kavââng, taai tabuur katiêk kah ve lââp dhơuq. <verse eid="MAT 13:5" /><verse number="6" style="v" sid="MAT 13:6" />Bơơi xong xók mat tangêi yuur klaaq, ađó ơi bâân óch róh lơq xeu rang taai kah ve riêh. <verse eid="MAT 13:6" /><verse number="7" style="v" sid="MAT 13:7" />Hayơq mưi phơn lââng ruuh m'pơng nôôq tââm axông, nek nôôq tââm axông yuur gamak lơq dhuum garet piđó. <verse eid="MAT 13:7" /><verse number="8" style="v" sid="MAT 13:8" />Hơq phơn lââng dyơq ruuh dhiq katiêk liêm lơq ve bóóng pô pale, makaliêng nek mưi hariêng bơk lơh, makaliêng nek chapat jêt, makaliêng nek pe jêt. <verse eid="MAT 13:8" /><verse number="9" style="v" sid="MAT 13:9" />Ngaai ve katór, nek xâng.”<verse eid="MAT 13:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 13:10" />Hayơq nôôq môôn-đô, xong xók tơk pađan, ơi móón palơq Ađó: “Ơi taai harau hơq thêi vil praaq palơq nôôq babi palơq manưih dhanuôr?” <verse eid="MAT 13:10" /><verse number="11" style="v" sid="MAT 13:11" />Kơi achêk nek, xók ââi paraaq, Ađó ơi praaq palơq piđó kơi ađô: “Nek palơq adhi anó nek ơi bâân jaau đóng buôn đơơp n'nal nôôq rau lalââp leq katiêk pleng, hayơq nek palơq nôôq đu ađek nek kah bâân ve đóng. <verse eid="MAT 13:11" /><verse number="12" style="v" sid="MAT 13:12" />Ơi ngaai đu ve, nek leq phơn manưih achêk e bâân đóng kơơq, lơq manưih achêk e bâân xưa raai. Bơơi ngaai đu kah ve, nek e bâân pei paxooq tââq ađó chênh bhơt rau manưih achêk xók ve. <verse eid="MAT 13:12" /><verse number="13" style="v" sid="MAT 13:13" />Ơi taai ađô, thêi praaq palơq piđó palơq babi; taai dhơ ve lêi, piđó kah đơơp chamet; lơq dhơ tameng katór, piđó kah chóóm xâng, kung kah chóóm n'nal. <verse eid="MAT 13:13" /><verse number="14" style="v" sid="MAT 13:14" />Lơq paraaq ưng Ê-saai manưih đââng taruuih nek bâân tajaap dhiq piđó, kơi ađô:</para>
  <para style="q" vid="MAT 13:14">‘Nek palơq rau xâng, nôôq akóón e tameng katór, hơq dhakơi nôôq akóón e kah n'nal;</para>
  <para style="q" vid="MAT 13:14">hayơq xók lêi, nôôq akóón e tangôôq lêi, hơq dhakơi nôôq akóón e kah chóóm n'nal.<verse eid="MAT 13:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="MAT 13:15" />Ơi lóóm dhanuôr ađô ơi val kơi ngôôk ngaak;</para>
  <para style="q" vid="MAT 13:15">taai piđó ơi xâng kơi kadhaap tavơr,</para>
  <para style="q" vid="MAT 13:15">lơq piđó ơi kaxir mat ađêi,</para>
  <para style="q" vid="MAT 13:15">vaaih e piđó ve chóóm lêi palơq mat,</para>
  <para style="q" vid="MAT 13:15">tameng xâng palơq katór,</para>
  <para style="q" vid="MAT 13:15">n'nal palơq lóóm</para>
  <para style="q" vid="MAT 13:15">hayơq palâh val lóóiq,</para>
  <para style="q" vid="MAT 13:15">lơq Aku e payươh piđó.’<verse eid="MAT 13:15" /></para>
  <para style="b" />
  <para style="m">
    <verse number="16" style="v" sid="MAT 13:16" />Bơơi phươk đóng nek mat ưng adhi anó, ơi chóóm lêi, lơq katór ưng adhi anó, ơi chóóm xââng. <verse eid="MAT 13:16" /><verse number="17" style="v" sid="MAT 13:17" />Alua, thêi praaq palơq adhi anó kơi, bơk manưih đââng taruuih lơq manưih bhơt liêm kiêng tabâân buôn lêi nôôq rau adhi anó lêi, hơq piđó ơi kah bâân lêi, lơq buôn xâng nôôq rau adhi anó xâng, hơq piđó ơi kah bâân xâng. <verse eid="MAT 13:17" /><verse number="18" style="v" sid="MAT 13:18" />Kơi achêk, adhi anó nek xâng babi leq manưih chóói m'ma. <verse eid="MAT 13:18" /><verse number="19" style="v" sid="MAT 13:19" />Dyóp ngaai xâng taruuih liêm ưng katiêk pleng hơq kah n'nal, nek abhưi abhóch tơk lơq pei n'drooih rau ơi bâân chóói kalóóng lóóm manưih ađek. Ađô nek kaliêng m'ma bâân chóói tóór kalơng. <verse eid="MAT 13:19" /><verse number="20" style="v" sid="MAT 13:20" />Hayơq kaliêng m'ma bâân chóói leq katiêk dhơl dyriên, ađek nek manưih xâng taruuih liêm lơq n'drươh pei đơơp taruuih liêm nek palơq lóóm bhuui yayar; <verse eid="MAT 13:20" /><verse number="21" style="v" sid="MAT 13:21" />hơq manưih ađek kah ve riêh kalóóng ađêi, bơơi nek kah chóóm đuôh đươnh; nek hayơq kadhaap jarnah môôiq m'bhiiq vei vaaih tơk ơi taai taruuih liêm, nek manưih ađek n'drươh bil lóóm huuiq. <verse eid="MAT 13:21" /><verse number="22" style="v" sid="MAT 13:22" />Hayơq kaliêng m'ma bâân chóói m'pơng nôôq tââm axông, ađôk nek manưih xâng taruuih liêm, hơq lóóm châq karaang leq đơơi ađô lơq ahươu kanóq ưng rau karvaan kabhôôq têêng đóng taruuih liêm achêk nhanhuk pabhlu lơq ađó val xar kah bóóng pale. <verse eid="MAT 13:22" /><verse number="23" style="v" sid="MAT 13:23" />Bơơi kaliêng m'ma bâân chóói dhiq katiêk liêm, ađek nek manưih xâng taruuih liêm lơq n'nal, manưih ađek lalua bóóng pale, lơq yuur vaaih mưi chaq mahariêng, mưi chaq chapat jêt, mưi chaq pe jêt.”<verse eid="MAT 13:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 13:24" />Ađó pakah toom piđó mưi babi lââng, kơi ađô: “Katiêk pleng bâân babi kơi mưi chanak ơi chóói m'ma liêm kalóóng hare ađêi. <verse eid="MAT 13:24" /><verse number="25" style="v" sid="MAT 13:25" />Bơơi bhêêl palââng bêch, manưih brau ưng ađó achêk tơk lơq chóói bhơơi drươm kachóóq leq m'pơng aviq mi hayơq xooq lơh. <verse eid="MAT 13:25" /><verse number="26" style="v" sid="MAT 13:26" />Xók aviq yuur gamak lơq xrôh bhalooch, nek bhơơi drươm kung bâân yuur jaluôh. <verse eid="MAT 13:26" /><verse number="27" style="v" sid="MAT 13:27" />Xók achêk, nôôq dhơn ratơơq ưng manưih kala achêk, xong xók tơk, ơi móón palơq ađó: ‘Kala ơơi, eh dhơq amei ơi chóói kaliêng m'ma liêm kalóóng hare ađêi kah alua? Kơi achêk, bhơơi drươm tââq tiq hơq ve?’ <verse eid="MAT 13:27" /><verse number="28" style="v" sid="MAT 13:28" />Kơi achêk nek ađó ââi piđó: ‘Mưi chanak manưih brau ơi têêng tarnêêng ađô.’ Hayơq nôôq dhơn ratơơq móón palơq ađó: ‘Kơi achêk, abhươp ve kiêng xók gluh leq ađek, nôôq yi rôôq tabhơt piđó kah?’ <verse eid="MAT 13:28" /><verse number="29" style="v" sid="MAT 13:29" />Bơơi kala ââi: ‘Óóq, vaaih xók bhêêl rôôq bhơơi drươm, nôôq pe e rôôq tarluk pâng aviq madhiq palơq piđó. <verse eid="MAT 13:29" /><verse number="30" style="v" sid="MAT 13:30" />Bhiêk lơơi miq bơơr bâân mandrươh yuur gamak đóng patơk nil xóót peh, lơq mót bhêêl ganah xóót peh, aku e yua nôôq manưih xóót: Laloom kơ, nek karong bhơơi drươm lóóiq lơq choq piđó xar ting booq buôn óch piđó vóq, bơơi nek karong aviq leq kalóóng póóm jơơng ưng aku.’”<verse eid="MAT 13:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 13:31" />Ađó yuur truuih toom piđó mưi babi lââng, kơi ađô: “Katiêk pleng nek thê kơi mưi kaliêng habhêi hơq xong xók pei, mưi chanak ơi chóói kalóóng hare ađêi; <verse eid="MAT 13:31" /><verse number="32" style="v" sid="MAT 13:32" />hơq kaliêng m'ma achêk dhơ nek katưưiq tââm kalóóng tabhơt nôôq dyóp rau kaliêng, bơơi xók ađó n'dhương gamak, ađó gamak lơh nôôq m'ma n'lóóng kalóóng bhươn lơq val xar mưi tââm n'lóóng, tơk mơ achim pleng tơk lơq têêng xaruh dhiq nôôq đóóng ưng ađó.” <verse eid="MAT 13:32" /><verse number="33" style="v" sid="MAT 13:33" />Ađó truuih leq palââng mưi babi đu lââng. “Katiêk pleng nek thê kơi piêng hơq xong xók pei, manưih pađiil ơi xrơu palơq pe jahương amun đóng tơk xók tabhơt nôôq amun yuur chơh.”<verse eid="MAT 13:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 13:34" />Chuôq Jê-su ơi praaq dyóp rau ađek palơq tanóói dhanuôr palơq paraaq babi, lơq Ađó kah dhơ dharau praaq palơq piđó hơq kah palơq paraaq babi, <verse eid="MAT 13:34" /><verse number="35" style="v" sid="MAT 13:35" />ng'kơi đóng paraaq ơi bâân paraaq dhiq manưih đââng taruuih bâân tajaap, kơi ađô:</para>
  <para style="q" vid="MAT 13:35">“Aku e pơơh bóóp Aku palơq nôôq praaq babi.</para>
  <para style="q" vid="MAT 13:35">Aku e truuih karơ nôôq rau glêh takadrêi lââp tââq bhêêl têêng tavaaih pleng katiêk.”<verse eid="MAT 13:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="MAT 13:36" />Xong ađek, xók ơi xooq tââq tanóói dhanuôr bơk, Ađó mót leq đong. Nôôq môôn-đô Ađó tơk đan Ađó, móón: “Nhan lók đóng nôôq yi paraaq babi leq bhơơi drươm dhiq kalóóng hare.” <verse eid="MAT 13:36" /><verse number="37" style="v" sid="MAT 13:37" />Xók achêk, xók ââi bóóp, Ađó praaq: “Manưih chóói m'ma liêm nek Akóón Manưih, <verse eid="MAT 13:37" /><verse number="38" style="v" sid="MAT 13:38" />hơq hare ruông nek talaang katiêk, hayơq kaliêng m'ma liêm — ađôk nek akóón anaaq ưng katiêk pleng. Palâh lóóiq, bhơơi drươm nek akóón anaaq ưng đu aak, <verse eid="MAT 13:38" /><verse number="39" style="v" sid="MAT 13:39" />lơq manưih brau, nek đu ơi chóói piđó, nek abhưi abhóch. Hayơq nil xóót nek tơk tangêi marngi, hơq nôôq manưih xóót nek nôôq dhơn pleng. <verse eid="MAT 13:39" /><verse number="40" style="v" sid="MAT 13:40" />Kơi chêk, ng'kơi hơq bhơơi drươm bâân kaboq lóóiq lơq bâân óch kalóóng óih, nek tarnêêng kung e yuur vaaih kơi chêk mót tơk tangêi marngi. <verse eid="MAT 13:40" /><verse number="41" style="v" sid="MAT 13:41" />Akóón Manưih e kayua nôôq dhơn pleng ưng ađêi, lơq piđó e karong pagluh tââq katiêk Ađó tabhơt nôôq đu têêng lơt môôp palơq nôôq đu têêng rau matu lơt. <verse eid="MAT 13:41" /><verse number="42" style="v" sid="MAT 13:42" />Lơq dhơn pleng e m'peq piđó leq bóng óih, nek dhiq e ve rau nhiim griit lơq takachrââq kaniêng. <verse eid="MAT 13:42" /><verse number="43" style="v" sid="MAT 13:43" />Bhêêl ađek, nôôq manưih bhơt liêm e brương cha-iil kơi mat tangêi kalóóng katiêk ưng Ama piđó. Ngaai ve katór, nek xâng.”<verse eid="MAT 13:43" /></para>
  <para style="p">
    <verse number="44" style="v" sid="MAT 13:44" />“Katiêk pleng nek thê kơi mưi jơơng drươp bâân pađơp kadrêi kalóóng mưi dham hare, nek rau hơq mưi chanak ơi vôôiq kadrêi xong xók bâân lêi. Vaaih tââq lóóm rau bhuui sương ưng ađêi, manưih achêk yuur vôôiq, baan tabhơt pasek dyóp rau ađêi ve lơq kơl dham hare achêk. <verse eid="MAT 13:44" /><verse number="45" style="v" sid="MAT 13:45" />Hơq dyơq, katiêk pleng nek thê kơi mưi chanak, nek manưih kakơl, chêk tabâân ngok-traai đu kiiq. <verse eid="MAT 13:45" /><verse number="46" style="v" sid="MAT 13:46" />Kơi achêk hayơq, bhêêl ơi bâân lum mưi kaliêng ngok-traai mat jêên kah mơ móón, nek xong xók yuur vôôiq, ađó ơi baan tabhơt pasek dyóp rau đu ađêi ve lơq kơl ađó.<verse eid="MAT 13:46" /></para>
  <para style="p">
    <verse number="47" style="v" sid="MAT 13:47" />Hayơq dyơq, katiêk pleng nek thê kơi mưi takei jươl bâân trah leq taxiiq lơq bâân yuur mơk dyóp rau n'dreh m'ma, <verse eid="MAT 13:47" /><verse number="48" style="v" sid="MAT 13:48" />hơq bhêêl jươl ơi bing, palââng galôôi leq kakóóng, lơq xong xók tơơt chok leq, piđó karong nôôq đu liêm leq kalóóng jong kađôôq, hayơq nôôq rau kah chóóm đươi, piđó m'peq leq nguôi. <verse eid="MAT 13:48" /><verse number="49" style="v" sid="MAT 13:49" />Dyóp rau e nek kơi achêk xók tơk bhêêl marngi: Nôôq dhơn pleng e vôôiq gluh, lơq e blah kabhuh đu aak tââq m'pơng nôôq manưih đu liêm, <verse eid="MAT 13:49" /><verse number="50" style="v" sid="MAT 13:50" />hayơq piđó e m'peq kabhuh ađek leq bóng óih, nek dhiq e ve đu nhiim griit lơq kachrââq kaniêng.<verse eid="MAT 13:50" /></para>
  <para style="p">
    <verse number="51" style="v" sid="MAT 13:51" />Adhi anó ơi n'nal bhơt nôôq rau ađôk kah?” Piđó ââi palơq Ađó: “Ơơq.” <verse eid="MAT 13:51" /><verse number="52" style="v" sid="MAT 13:52" />Xók achêk, Ađó praaq palơq piđó: “Ơi taai rau ađô, dyóp manưih pachóóm gani ơi bâân chaleq pachóóm leq katiêk pleng nek thê kơi mưi manưih kala đong, nek manưih pei pagluh drươp ti palơq drươp tame tââq kalóóng jơơng ưng ađêi.” <verse eid="MAT 13:52" /><verse number="53" style="v" sid="MAT 13:53" />Tarnêêng yuur vaaih ađek nek xók Chuôq Jê-su luch xong nôôq paraaq babi ađô, Ađó ơi yuur vôôiq lơh tââq ađek.<verse eid="MAT 13:53" /></para>
  <para style="p">
    <verse number="54" style="v" sid="MAT 13:54" />Xong xók chô tơk bhươl kanóón ađêi, Ađó ơi truuih pachóóm manưih dhanuôr kalóóng đong gươl ưng piđó, tơk mơ têêng palââng chrih xâng lơq móón: “Rau tabech galang achêk palơq nôôq mataai chrih tââq dhiq ađó ađô avaaih n'tââq tiq? <verse eid="MAT 13:54" /><verse number="55" style="v" sid="MAT 13:55" />Eh dhơq ađó ađô nek akóón padruuih abhươp thơơq kóóch chan alua? Eh dhơq akan ađó achêk ngi đóók nek Ma-ri, lơq nôôq adhi padruuih ưng ađó ađek nek Ja-kơ, Jô-seep, Si-môôn lơq Ju-đa eh? <verse eid="MAT 13:55" /><verse number="56" style="v" sid="MAT 13:56" />Eh dhơq tabhơt nôôq adhi pađiil ưng ađó ađek maar tơơt palơq nôôq he alua? Kơi achêk, dyóp rau ađô nek dhiq ađó achêk avaaih n'tââq?” <verse eid="MAT 13:56" /><verse number="57" style="v" sid="MAT 13:57" />Piđó bâân n'đóih kalơm dhiq Ađó. Bơơi Chuôq Jê-su praaq palơq piđó: “Manưih đââng taruuih yươq bâân takađiq, chapiên lơh dhiq bhươl kanóón ađêi lơq kalóóng parlóng đong ađêi.” <verse eid="MAT 13:57" /><verse number="58" style="v" sid="MAT 13:58" />Ađó ơi kah têêng bơk mataai chrih dhiq ađek taai lóóm kah huuiq ưng piđó.<verse eid="MAT 13:58" /></para>
  <chapter eid="MAT 13" />
  <chapter number="14" style="c" sid="MAT 14" />
  <para style="p">
    <verse number="1" style="v" sid="MAT 14:1" />Mót bhêêl ganah ađek, Hê-rôôt bhua katưưiq xâng tanđôôr leq Chuôq Jê-su. <verse eid="MAT 14:1" /><verse number="2" style="v" sid="MAT 14:2" />Bhua praaq palơq nôôq dhơn ratơơq ađêi: “Achêk nek Jang Bap-tiit. Ađó chêk ơi bâân têêng mamông lóóiq tââq kan chêt, hayơq taai ađek, nôôq tarnêêng mataai karơ xók vôôiq veq dhiq manưih ađô.” <verse eid="MAT 14:2" /><verse number="3" style="v" sid="MAT 14:3" />Taai Hê-rôôt, xong xók kóóp Jang, ơi đóng klooiq ađó lơq król leq đong kanam, ơi taai Hê-rô-đia, kađiêl ưng Phi-liip, adhi padruuih bhua. <verse eid="MAT 14:3" /><verse number="4" style="v" sid="MAT 14:4" />Taai Jang ơi praaq palơq bhua: “Leq phơn bhua, kah chóóm pheep pei akan ađek.” <verse eid="MAT 14:4" /><verse number="5" style="v" sid="MAT 14:5" />Lơq dhơ kiêng leng ađó achêk vóq, bơơi bhua kakhin manưih dhanuôr, taai palââng lêi Jang kơi mưi manưih đââng taruuih. <verse eid="MAT 14:5" /><verse number="6" style="v" sid="MAT 14:6" />Bơơi xók tơk cha bhiêk hei tangêi n'niên ưng Hê-rôôt, akóón pađiil ưng Hê-rô-đia tanâât yayaq dhiq m'pơng cha bhiêk lơq têêng iêm lóóm Hê-rôôt, <verse eid="MAT 14:6" /><verse number="7" style="v" sid="MAT 14:7" />taai kơi achêk, bhua ơi hươq nek palơq mưi paraaq ng'kóh buôn đóng leq akóón pađiil hơq hau rau đu akóón pađiil nhan. <verse eid="MAT 14:7" /><verse number="8" style="v" sid="MAT 14:8" />Xók achêk, xók ơi bâân paxuq laloom ađek tââq akan ađêi, akóón pađiil móón: “Nhan đóng akóón n'drươh dhiq ađôk, akoq ưng Jang Bap-tiit kađôôq dhiq pươih.” <verse eid="MAT 14:8" /><verse number="9" style="v" sid="MAT 14:9" />Lơq dhơ lóng ranguôq lóóm, bơơi ơi taai paraaq ng'kóh ưng ađêi lơq nôôq kuôn tamóói palơq tơơt cha, bhua ơi kayua buôn akóón pađiil bâân ve đóng. <verse eid="MAT 14:9" /><verse number="10" style="v" sid="MAT 14:10" />Xong xók kayua manưih vôôiq, bhua đóng têch akoq Jang kalóóng đong kanam. <verse eid="MAT 14:10" /><verse number="11" style="v" sid="MAT 14:11" />Akoq ưng ađó bâân đââng tơk kađôôq dhiq pươih hayơq bâân pajaau đóng akóón pađiil, lơq akóón pađiil đââng leq akan ađêi. <verse eid="MAT 14:11" /><verse number="12" style="v" sid="MAT 14:12" />Xók ơi bâân tarlum, nôôq môôn-đô ưng ađó pei xaak lơq tơp buur ađó. Lơq bhêêl ơi vôôiq tơk, palââng truuih lóóiq leq Chuôq Jê-su.<verse eid="MAT 14:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 14:13" />Xók achêk, xók bâân xâng, Chuôq Jê-su xooq tââq ađek kalóóng mưi beq bhuông vôôiq tơk dhiq bhahi bhatoong tơơt n'tua mưi ađêi. Taai xâng n'nal kơi achêk, nôôq tanóói dhanuôr tââq nôôq kanóón vôôiq dyung ting Ađó. <verse eid="MAT 14:13" /><verse number="14" style="v" sid="MAT 14:14" />Lơq xong xók yuur vôôiq, Ađó lêi mưi tanóói dhanuôr ganơr bơk, nek vaaih lóóm kayô ka-er palơq nôôq manưih dhanuôr lơq Ađó payươh nôôq manưih ka-ai dhur ưng piđó. <verse eid="MAT 14:14" /><verse number="15" style="v" sid="MAT 14:15" />Xók achêk, xók tơk habu blót, nôôq môôn-đô tơk palơq Ađó, móón: “Dhiq ađô nek bhahi bhatoong, lơq bhêêl ađô nek ơi ravang blót. Nhan thêi đóng tanóói dhanuôr buôn xók chô tơk nôôq bhươl hayơq, piđó ve chóóm kơl tarmông đóng ađêi.” <verse eid="MAT 14:15" /><verse number="16" style="v" sid="MAT 14:16" />Bơơi Chuôq Jê-su móón palơq piđó: “Piđó kah ve kiêng yuur chô. Adhi anó phaai đóng piđó chacha.” <verse eid="MAT 14:16" /><verse number="17" style="v" sid="MAT 14:17" />Bhêêl achêk, piđó móón palơq Ađó: “Dhiq ađô nôôq yi kah ve rau lơh tââq xââng beq beng lơq bơơr panong kadhóóng.” <verse eid="MAT 14:17" /><verse number="18" style="v" sid="MAT 14:18" />Hayơq Ađó kayua: “Nek đââng nôôq ađek tơk leq ađô đóng thêi.” <verse eid="MAT 14:18" /><verse number="19" style="v" sid="MAT 14:19" />Lơq xók kayua đóng tanóói dhanuôr tơơt chok leq dhiq bhơơi xong, bhêêl kadhâng xââng beq beng lơq bơơr panong kadhóóng, chaling mat leq pleng, Ađó ma-ơơn, lơq veh, Ađó pađơơp tarmông đóng nôôq môôn-đô, hayơq nôôq môôn-đô nh'xóóng đóng tanóói dhanuôr. <verse eid="MAT 14:19" /><verse number="20" style="v" sid="MAT 14:20" />Tabhơt dhanuôr piđó ơi cha lơq bâân kabhôôq kajrê. Hayơq palââng chââih phơn xưa lóóiq tââq nôôq beng veh lêêk — đuôh majêt bơơr jong bing. <verse eid="MAT 14:20" /><verse number="21" style="v" sid="MAT 14:21" />Xók achêk, nôôq manưih cha nek mơ xââng ngaan manưih padruuih, kah xêi pađiil parkan lơq paniên katưưiq.<verse eid="MAT 14:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 14:22" />N'drươh ađek, Ađó hôôiq kayua nôôq môôn-đô jađaang mót kalóóng bhuông lơq vôôiq loom Ađó chaang tóór hót tôôh, xók bhêêl Ađó dyơq kayua tanóói dhanuôr chô. <verse eid="MAT 14:22" /><verse number="23" style="v" sid="MAT 14:23" />Bhêêl ơi đóng manưih dhanuôr chô, Ađó vôôiq đơk leq bôôl buôn tư praaq chiên n'tua. Tơk kanam, Ađó tơơt dhiq ađek mưi ađêi. <verse eid="MAT 14:23" /><verse number="24" style="v" sid="MAT 14:24" />Hayơq beq bhuông tơơt dhiq m'pơng taxiiq ơi nek bâân ga-uul đơơk n'dhươi karơ taai adhiiq chachriik. <verse eid="MAT 14:24" /><verse number="25" style="v" sid="MAT 14:25" />Xók achêk, mót đan brương hayum achêk, Ađó tơk palơq piđó, xók vôôiq dyung dhiq taxiiq. <verse eid="MAT 14:25" /><verse number="26" style="v" sid="MAT 14:26" />Bơơi xong xók lêi Ađó bhadyaang vôôiq dhiq taxiiq, nôôq môôn-đô bâân kakhin bhlơng, móón kơi ađô: “Ađek nek abhưi,” hayơq piđó yuur reen dheek kalóóng kakhin kapơn bhlơng. <verse eid="MAT 14:26" /><verse number="27" style="v" sid="MAT 14:27" />Kơi achêk nek, Chuôq Jê-su n'drươh yuur praaq lơq piđó kơi ađô: “Tamưng lóóm nek! Nô thêi ađôk. Óóq kakhin!” <verse eid="MAT 14:27" /><verse number="28" style="v" sid="MAT 14:28" />Xók achêk, xók ââi lóóiq Ađó, Phi-e-rơ móón: “Kakoh Chuôq, la nek thêi, nhan kayua đóng aku vôôiq dhiq đơơk tơk palơq thêi.” <verse eid="MAT 14:28" /><verse number="29" style="v" sid="MAT 14:29" />Hayơq Ađó kayua: “Nek vôôiq aq.” Lơq xong xók jađaang lơh tââq bhuông, Phi-e-rơ ơi jađaang vôôiq dhiq đơơk buôn tơk palơq Chuôq Jê-su. <verse eid="MAT 14:29" /><verse number="30" style="v" sid="MAT 14:30" />Bơơi xók lêi adhiiq karơ, ađó kakhin bhlơng, lơq bhêêl tââp ravang klêch n'dhương, ađó yuur lalơu kơi ađô: “Chuôq ơơi, nhan trôông aku!” <verse eid="MAT 14:30" /><verse number="31" style="v" sid="MAT 14:31" />N'drươh nek, xong xók yuur jarơ têi, Chuôq Jê-su pei dyuôch Phi-e-rơ lơq móón ađó: “Ađô manưih m'bưưiq lóóm huuiq, ơi taai harau hơq amei paangra?” <verse eid="MAT 14:31" /><verse number="32" style="v" sid="MAT 14:32" />Bhêêl piđó jađaang dyók leq bhuông hayơq, adhiiq parngau pruung. <verse eid="MAT 14:32" /><verse number="33" style="v" sid="MAT 14:33" />Hayơq nôôq manưih kalóóng bhuông nek bhuôih kakoh Ađó, kơi ađô: “Alua, thêi nek Akóón Yaang Pleng.”<verse eid="MAT 14:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 14:34" />Bhêêl vôôiq kóh hót tôôh ơi, piđó tơk leq tóór dhiq Gê-nê-xa-rêêt. <verse eid="MAT 14:34" /><verse number="35" style="v" sid="MAT 14:35" />Xong xók n'nal Ađó, manưih dhanuôr tơơt dhiq achêk kayua manưih đââng truuih tơk plok parah paroong praang xirvir ađek, lơq palââng đââng tơk leq Ađó dyóp ngaai đu dhuôr ka-ai. <verse eid="MAT 14:35" /><verse number="36" style="v" sid="MAT 14:36" />Piđó nhan Ađó mơ buôn ađêi ve chóóm xuui leq grưưi aau ưng Ađó, lơq nek dhơ dhangaai mơ xuui nek bâân yươh ka-ai.<verse eid="MAT 14:36" /></para>
  <chapter eid="MAT 14" />
  <chapter number="15" style="c" sid="MAT 15" />
  <para style="p">
    <verse number="1" style="v" sid="MAT 15:1" />Tââq ađek, nôôq manưih Pha-ri-si lơq thêi pachóóm gani tââq Jê-ru-sa-leem tơk palơq Chuôq Jê-su, móón kơi ađô: <verse eid="MAT 15:1" /><verse number="2" style="v" sid="MAT 15:2" />“Hau kơi nôôq môôn-đô ưng thêi têêng lơt nôôq taruuih hanua ưng nôôq takóh taha? Taai kabhuh piđó kah raau têi xók chacha.” <verse eid="MAT 15:2" /><verse number="3" style="v" sid="MAT 15:3" />Bơơi xók ââi lóóiq, Ađó praaq palơq piđó: “Hau kơi nôôq pe vil têêng lơt gani pachóóm ưng Yaang Pleng ơi taai nôôq taruuih hanua ưng ađêi? <verse eid="MAT 15:3" /><verse number="4" style="v" sid="MAT 15:4" />Ơi Yaang Pleng ve truuih pachóóm kơi ađô: ‘Phaai bhi nh'nhơr akonh akan ưng amei,’ lơq ‘Ngaai đu tóh taaiq akonh môôiq akan phaai leng chêt ađó ađek.’ <verse eid="MAT 15:4" /><verse number="5" style="v" sid="MAT 15:5" />Bơơi nôôq pe móón: ‘Ngaai đu praaq palơq ama môôiq amêêq ađêi: “La hau rau tư tââq akóón ve chóóm malơơi đóng amêêq ama maar nek bhanuôih ơi yuur tapôông leq Yaang Pleng,”’ <verse eid="MAT 15:5" /><verse number="6" style="v" sid="MAT 15:6" />nek manưih ađek e tabhơt yươq rau bhi nh'nhơr ama ađêi. Kơi achêk, nôôq pe ơi m'peq lơơi paraaq Yaang Pleng ơi taai taruuih hanua ưng ađêi. <verse eid="MAT 15:6" /><verse number="7" style="v" sid="MAT 15:7" />Kabhuh paliêm hót nguôi tôôh! Ê-saai ơi loom móón lóng pâng leq nôôq pe, kơi ađô:<verse eid="MAT 15:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="MAT 15:8" />‘Dhanuôr ađô bhi chap Aku dhiq bưưr bóóp kachrooch n'taak,</para>
  <para style="q" vid="MAT 15:8">bơơi lóóm piđó nek changaai tââq Aku.<verse eid="MAT 15:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="MAT 15:9" />Hơq piđó bhuôih haanh Aku kơi kah malơơi,</para>
  <para style="q" vid="MAT 15:9">xók pachóóm nôôq paraaq taruuih nek nôôq gani ưng akóón manưih.’”<verse eid="MAT 15:9" /></para>
  <para style="b" />
  <para style="m">
    <verse number="10" style="v" sid="MAT 15:10" />Hayơq xong xók dhaloong tanóói dhanuôr tơk, Chuôq praaq palơq piđó: “Nek xâng lơq n'nal: <verse eid="MAT 15:10" /><verse number="11" style="v" sid="MAT 15:11" />Yươq hau rau vôôiq mót kalóóng bóóp têêng đóng anhuq mưi chanak. Bơơi nek rau tââq bóóp gluh, rau ađô têêng đóng anhuq manưih achêk.” <verse eid="MAT 15:11" /><verse number="12" style="v" sid="MAT 15:12" />Xong ađek, xók ơi tơk đan, nôôq môôn-đô móón palơq Ađó: “Thêi n'nal kơi nôôq manưih Pha-ri-si ơi lêi bâân têêng tamôôp xong xók xâng paraaq achêk kah?” <verse eid="MAT 15:12" /><verse number="13" style="v" sid="MAT 15:13" />Bơơi xók ââi bóóp Ađó praaq: “Dyóp n'lóóng hơq Ama dhiq pleng ưng thêi kah choh e bâân rôôq tabhơt. <verse eid="MAT 15:13" /><verse number="14" style="v" sid="MAT 15:14" />Kê piđó nek! Piđó nek nôôq manưih đu kađââng kabaang kapôk. Hơq la manưih kabaang kađââng manưih kabaang, nek miq bơơr e n'tôq leq harlaang.” <verse eid="MAT 15:14" /><verse number="15" style="v" sid="MAT 15:15" />Xók achêk xók ââi lóóiq, Phi-e-rơ móón palơq Chuôq: “Nhan lók đóng nôôq yi paraaq babi achêk.” <verse eid="MAT 15:15" /><verse number="16" style="v" sid="MAT 15:16" />Bơơi Ađó praaq: “Pađơq mơ tơk bhêêl ađô, adhi anó kung kah n'nal kơq? <verse eid="MAT 15:16" /><verse number="17" style="v" sid="MAT 15:17" />Adhi anó kah n'nal kơi dyóp rau vôôiq mót kalóóng bóóp nek vôôiq dhaluônh leq luônh hayơq bâân vôôiq gluh kalóóng đong kapóóng kah lua? <verse eid="MAT 15:17" /><verse number="18" style="v" sid="MAT 15:18" />Bơơi nôôq rau dhơơm gluh tââq bóóp vaaih gluh tââq kalóóng lóóm, lơq piđó têêng đóng anhuq akóón manưih. <verse eid="MAT 15:18" /><verse number="19" style="v" sid="MAT 15:19" />Ơi tââq lóóm vaaih gluh nôôq karnóq môôp lơt, leng manưih, têêng tapiing, têêng taniêt, tatông papei, truuih chachââr lơq nôôq paraaq kah matich. <verse eid="MAT 15:19" /><verse number="20" style="v" sid="MAT 15:20" />Ađek nek nôôq rau têêng đóng anhuq manưih, dyơq cha palơq têi kah raau nek yươq têêng đóng anhuq akóón manưih.”<verse eid="MAT 15:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 15:21" />Hayơq xong xók vôôiq gluh tââq ađek, Chuôq Jê-su róch chô leq nôôq xưưq ưng Ti-rơ lơq Si-đôôn. <verse eid="MAT 15:21" /><verse number="22" style="v" sid="MAT 15:22" />Lơq lêi tôôh, mưi pađiil parkan manưih Ka-na-aan, xong xók tââq xưưq ađek bhral, ơi dhaloong lalơu, kơi ađô: “Kakoh Chuôq, Akóón bhua Đa-viit, nhan kayô ka-er aku! Akóón pađiil aku bâân abhưi bóq lóng xaryô bhlơng.” <verse eid="MAT 15:22" /><verse number="23" style="v" sid="MAT 15:23" />Bơơi Chuôq kah ââi lóóiq ađó m'paleh m'palâ. Xong xók tơk đan Chuôq, nôôq môôn-đô gavơh nhan Chuôq, kơi ađô: “Nhan thêi kayua pađiil ađek vôôiq aq, taai ađó bhiêk dhaloong lalơu hót hóng nôôq he.” <verse eid="MAT 15:23" /><verse number="24" style="v" sid="MAT 15:24" />Hayơq bhêêl ââi bóóp Chuôq praaq: “Thêi ơi yươq bâân kayua tơk, la eh rau đóng nôôq trưưu xraang ưng đong I-sơ-ra-êên.” <verse eid="MAT 15:24" /><verse number="25" style="v" sid="MAT 15:25" />Bơơi xong xók tơk, ađó achêk chakoh tarkól toom Chuôq, móón: “Kakoh Chuôq, nhan paq jóói aku.” <verse eid="MAT 15:25" /><verse number="26" style="v" sid="MAT 15:26" />Xók achêk, xók ââi lóóiq, Chuôq praaq: “Pei beng ưng akóón anaaq hayơq bhơt đóng akóón anuq nek kah kre.” <verse eid="MAT 15:26" /><verse number="27" style="v" sid="MAT 15:27" />Bơơi akan achêk ââi: “Kakoh Chuôq, pâng kơi achêk, chapiên nek chênh tabhơt nôôq akóón anuq nek bâân cha tââq nôôq paleh lêêk ruuh n'tôq tââq baang kala ưng piđó.” <verse eid="MAT 15:27" /><verse number="28" style="v" sid="MAT 15:28" />Bhêêl ađek, buôn ââi lóóiq, Chuôq Jê-su praaq palơq ađó: “Nô manưih pađiil tôôh, lóóm huuiq ưng amei gamak bhlơng. Tarnêêng phaai bâân vaaih đóng amei ting kơi amei kiêng.” Lơq akóón pađiil ưng ađó bâân payươh tââq bhêêl ađek.<verse eid="MAT 15:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 15:29" />Xong xók yuur vôôiq lơh parah achêk, Chuôq Jê-su vôôiq chóók taxiiq Ga-li-lê, lơq bhêêl đơk dhiq mưi kachruôch bôôl hayơq, Ađó tơơt dhiq ađek. <verse eid="MAT 15:29" /><verse number="30" style="v" sid="MAT 15:30" />Hayơq nôôq tanóói dhanuôr bơk vôôiq đơk palơq Ađó, ve nôôq manưih khuch, manưih kabaang, manưih dyóói arool, manưih bơq, lơq bơk manưih lââng nek palơq piđó. Palââng đââng lơơi nôôq manưih ađek dhiq dyung Ađó lơq Ađó payươh đóng piđó, <verse eid="MAT 15:30" /><verse number="31" style="v" sid="MAT 15:31" />Tơk mơ, tanóói dhanuôr hêq lêi xók lêi manưih bơq chóóm praaq, manưih dyóói arool nek yươh liêm, manưih khuch jađaang vôôiq lơq manưih kabaang chóóm lêi, hayơq piđó bhi haanh Yaang Pleng ưng I-sơ-ra-êên.<verse eid="MAT 15:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 15:32" />Xók achêk, xong xók dhaloong nôôq môôn-đô vôôiq leq ađêi, Chuôq Jê-su praaq: “Thêi kayô ka-er palơq tanóói dhanuôr, taai piđó ơi tơơt palơq thêi pe tangêi ơi hơq kah ve rau buôn cha. Thêi kah kiêng đóng piđó chô luônh ha-ul, vaaih piđó e nek chabươp dhiq chóók kalơng.” <verse eid="MAT 15:32" /><verse number="33" style="v" sid="MAT 15:33" />Nôôq môôn-đô ââi palơq Ađó: “Kalóóng kruung vơng nek tââq ve gluh bơk beng kơi achêk buôn nôôq yi đóng tanóói dhanuôr bơk kơi tôôh cha kabhôôq?” <verse eid="MAT 15:33" /><verse number="34" style="v" sid="MAT 15:34" />Chuôq Jê-su praaq palơq piđó: “Adhi anó ve mơ beq beng?” Hayơq piđó ââi: “Tapól beq, lơq nôôq panong kadhóóng katưưiq.” <verse eid="MAT 15:34" /><verse number="35" style="v" sid="MAT 15:35" />Lơq xong xók kayua đóng tanóói dhanuôr tơơt chok leq katiêk, <verse eid="MAT 15:35" /><verse number="36" style="v" sid="MAT 15:36" />Ađó kadhâng tapól beq beng lơq nôôq panong kadhóóng, lơq xong xók ma-ơơn, Ađó veh pađơơp đóng nôôq môôn-đô, hayơq nôôq môôn-đô chêk-nh'xóóng đóng tanóói dhanuôr. <verse eid="MAT 15:36" /><verse number="37" style="v" sid="MAT 15:37" />Dhanuôr piđó maar cha lơq bâân kabhôôq kajrê. Piđó karong tapól jong bing phơn xưa ưng nôôq beng lêêk. <verse eid="MAT 15:37" /><verse number="38" style="v" sid="MAT 15:38" />Xók achêk, parbơk manưih cha nek puôn ngaan manưih padruuih, kah kê pađiil parkan lơq akóón paniên. <verse eid="MAT 15:38" /><verse number="39" style="v" sid="MAT 15:39" />Xók ơi đóng manưih dhanuôr chô, Ađó mót kalóóng bhuông lơq vôôiq tơk parah Ma-ga-đaan.<verse eid="MAT 15:39" /></para>
  <chapter eid="MAT 15" />
  <chapter number="16" style="c" sid="MAT 16" />
  <para style="p">
    <verse number="1" style="v" sid="MAT 16:1" />Xong xók tơk đan, nôôq manưih Pha-ri-si lơq Sa-đu-sê — taai klêêu Chuôq — ơi nhan Chuôq pakah đóng piđó mưi kanal chrih tââq pleng. <verse eid="MAT 16:1" /><verse number="2" style="v" sid="MAT 16:2" />Bơơi bhêêl ââi lóóiq, Chuôq praaq palơq piđó: [“Xók tơk habu blót, nôôq pe móón: ‘Pleng liêm, taai pleng bhrôông.’ <verse eid="MAT 16:2" /><verse number="3" style="v" sid="MAT 16:3" />Yayóng yayương ađô nek móón: ‘Pleng grơm adhiiq, taai pleng bhrôông, nguut tun.’ Dhơ nôôq pe n'nal kơi lêi karnal dhiq pleng, bơơi kah ve đuôh n'nal leq nôôq karnal ưng ganah.”] <verse eid="MAT 16:3" /><verse number="4" style="v" sid="MAT 16:4" />“Mưi klaang đơơi lơt aak lơq têêng tapiing chêk-tabâân karnal chrih, bơơi karnal chrih e kah bâân đóng leq ađó, chapiên karnal chrih ưng Jô-na.” Lơq bhêêl ơi lơơi piđó lóóiq, nek Ađó vôôiq lơh.<verse eid="MAT 16:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 16:5" />Hayơq nôôq môôn-đô nek ơi havil đââng beng, xong xók vôôiq tơk tóór hót tôôh. <verse eid="MAT 16:5" /><verse number="6" style="v" sid="MAT 16:6" />Xók achêk, Chuôq Jê-su praaq palơq piđó: “Phaai chagơn lơq hêch lêi leq piêng ưng manưih Pha-ri-si lơq Sa-đu-sê.” <verse eid="MAT 16:6" /><verse number="7" style="v" sid="MAT 16:7" />Bơơi kơi achêk, piđó bhiêk tarkaai palơq xóng piđó kơi ađô: “Ađek nek taai nôôq he ơi kah đââng beng.” <verse eid="MAT 16:7" /><verse number="8" style="v" sid="MAT 16:8" />Bơơi xók n'nal rau ađô, Chuôq Jê-su praaq: “Nôôq đu m'bưưiq lóóm huuiq tôôh, hau adhi anó tarkaai palơq xóng ađêi kơi achêk nek taai ađêi kah ve beng? <verse eid="MAT 16:8" /><verse number="9" style="v" sid="MAT 16:9" />Adhi anó dyơq kah thuông n'nal lơq kung kah hei xââng beq beng đóng xââng ngaan manưih hayơq adhi anó karong bâân ađó mơ jong alua? <verse eid="MAT 16:9" /><verse number="10" style="v" sid="MAT 16:10" />Môôiq tapól beq beng đóng puôn ngaan manưih, hayơq adhi anó ơi chêk-karong bâân ađó mơ jong alua? <verse eid="MAT 16:10" /><verse number="11" style="v" sid="MAT 16:11" />N'đó kơi dhơq hơq adhi anó kah chóóm n'nal kơi Aku ơi kah praaq palơq adhi anó leq beng? Bơơi phaai hêch lêi leq piêng ưng manưih Pha-ri-si lơq Sa-đu-sê.” <verse eid="MAT 16:11" /><verse number="12" style="v" sid="MAT 16:12" />Bhêêl ađek piđó n'nal kơi na Ađó eh móón piđó hêch lêi leq piêng ưng beng, bơơi nek leq paraaq pachóóm ưng manưih Pha-ri-si lơq Sa-đu-sê.<verse eid="MAT 16:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 16:13" />Xók achêk, xong xók vôôiq tơk xưưq xaang kanóón Sê-sa-rê Phi-liip, Chuôq Jê-su ơi tamóh nôôq môôn-đô ađêi, kơi ađô: “Palââng móón Akóón Manưih nek ngaai?” <verse eid="MAT 16:13" /><verse number="14" style="v" sid="MAT 16:14" />Hayơq piđó ââi: “Mưi phơn manưih móón nek Jang Bap-tiit; hayơq mưi phơn móón nek Ê-li; hơq phơn lââng móón nek Jê-rê-mi môôiq mưi kalóóng nôôq manưih đââng taruuih.” <verse eid="MAT 16:14" /><verse number="15" style="v" sid="MAT 16:15" />Ađó praaq palơq piđó: “Hayơq adhi anó móón Aku nek ngaai?” <verse eid="MAT 16:15" /><verse number="16" style="v" sid="MAT 16:16" />Kơi achêk nek, xók ââi bóóp, Si-môôn Phi-e-rơ móón: “Amei nek Chuôq Paq Manưih, Akóón Yaang Pleng taluôn mamông.” <verse eid="MAT 16:16" /><verse number="17" style="v" sid="MAT 16:17" />Bhêêl achêk, xók ââi lóóiq, Chuôq Jê-su praaq palơq ađó: “Si-môôn, akóón Jô-na, amei ve phươk bhlơng, taai eh rau m'bech lơq ahaam ơi pakah đóng amei, bơơi nek Ama ưng Aku dhiq pleng. <verse eid="MAT 16:17" /><verse number="18" style="v" sid="MAT 16:18" />Hayơq thêi kung praaq palơq amei kơi amei nek Phi-e-rơ, lơq dhiq dharaaq dhơl ađô, thêi e têêng kadhơng Kabhuh Akóón Dhơn Chuôq ưng thêi, lơq nôôq palóng ưng bóng maraaih e kah đuôh chóóm jơl lóóiq kabhuh ađek. <verse eid="MAT 16:18" /><verse number="19" style="v" sid="MAT 16:19" />Thêi e pajaau đóng amei nôôq kaliêng parlóng ưng katiêk pleng, hơq hau rau amei kliêng dhiq katiêk nek e bâân takliêng dhiq pleng, lơq hơq hau rau amei lóng dhiq katiêk nek e bâân tarlóng dhiq pleng.” <verse eid="MAT 16:19" /><verse number="20" style="v" sid="MAT 16:20" />Tââq ađek, Ađó praaq pagat nôôq môôn-đô buôn piđó óóq móón palơq ngaai kơi Ađó nek Chuôq Paq Manưih.<verse eid="MAT 16:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 16:21" />Tââq xók ganah ađek, Chuôq Jê-su Paq Manưih tââp tarnââp đóng nôôq môôn-đô ưng ađêi n'nal kơi Ađó kơng phaai vôôiq tơk Jê-ru-sa-leem, lơq đơơp bơk karuôq jarnah tư tââq nôôq takóh bhươl, nôôq takóh kadhâng bhanuôih bhơt liêm palơq nôôq manưih pachóóm gani. Hayơq bâân taleng chêt lơq bâân têêng mamông lóóiq leq tangêi thưưq pe. <verse eid="MAT 16:21" /><verse number="22" style="v" sid="MAT 16:22" />Lơq xong xók ruiq Ađó leq mưi hót, Phi-e-rơ tââp tarnââp trêh Ađó, kơi ađô: “Chuôq ơơi, Yaang Pleng pakah lóóm moor m'pheep palơq thêi. Chiên ađek e kah mơ chóóm vaaih tơk đóng thêi.” <verse eid="MAT 16:22" /><verse number="23" style="v" sid="MAT 16:23" />Bơơi hadhiêr achak lóóiq, Ađó praaq palơq Phi-e-rơ: “Sa-taan tôôh, phaai vôôiq lââp hót hóng Aku! Amei nek khuk dhơl têêng n'đóih dyung đóng thêi, taai amei kah ve kanóq tơk nôôq tarnêêng ưng Yaang Pleng, bơơi nek nôôq tarnêêng ưng akóón manưih.” <verse eid="MAT 16:23" /><verse number="24" style="v" sid="MAT 16:24" />Tââq ađek, Chuôq Jê-su praaq palơq nôôq môôn-đô ưng Ađó: “La ngaai kiêng vôôiq ting hóng thêi, nek manưih ađek phaai havơơi lơơi ađêi kala, palơq đuôl n'lóóng m'baang chatông ưng ađêi lơq ting thêi. <verse eid="MAT 16:24" /><verse number="25" style="v" sid="MAT 16:25" />Ơi hơq ngaai kiêng paq parmông ađêi nek e bil ađó, hayơq ngaai đu bil parmông ađêi ơi taai thêi nek e bâân lum ađó. <verse eid="MAT 16:25" /><verse number="26" style="v" sid="MAT 16:26" />Ơi mưi nak e bâân malơơi harau la bâân jeng tabhơt talaang katiêk, bơơi bâân bil parmông ađêi? Môôiq mưi chanak e yuur đóng hau rau kalóóng tarnêêng rakơl lóóiq parmông ađêi? <verse eid="MAT 16:26" /><verse number="27" style="v" sid="MAT 16:27" />Ơi Akóón Manưih ravang tơk kalóóng cha-iil tabah ưng Ama Ađó nek palơq nôôq dhơn pleng Ađó. Lơq xók bhêêl ađek, Ađó e chróót đóng dyóp chanak ting kơi hau dhơơm ưng piđó. <verse eid="MAT 16:27" /><verse number="28" style="v" sid="MAT 16:28" />Alua, Aku praaq palơq adhi anó kơi ve nôôq manưih xók dyương dhiq ađôk, nek nôôq manưih dhơ dhakơi e yươq n'nal kơi akan chêt đóng tơk xók bhêêl piđó lêi Akóón Manưih bhral kalóóng katiêk Ađó.”<verse eid="MAT 16:28" /></para>
  <chapter eid="MAT 16" />
  <chapter number="17" style="c" sid="MAT 17" />
  <para style="p">
    <verse number="1" style="v" sid="MAT 17:1" />Chapat tangêi tatun, Chuôq Jê-su đââng Phi-e-rơ, palơq Ja-kơ lơq Jang, adhi ađó, hayơq Ađó đââng n'tua piđó palơq xóng ađêi đơk tơk mưi kachruôch bôôl yaal. <verse eid="MAT 17:1" /><verse number="2" style="v" sid="MAT 17:2" />Hót nguôi ưng Ađó bâân vaaih xar toom mat piđó, lơq mat Ađó taklaaq cha-iil kơi mat tangêi, dyơq aau Ađó val xar tabah chalóng kơi taklaaq brương. <verse eid="MAT 17:2" /><verse number="3" style="v" sid="MAT 17:3" />Lơq lêi tôôh, Môôi-se palơq Ê-li tabhral toom piđó, praaq chiên palơq Ađó. <verse eid="MAT 17:3" /><verse number="4" style="v" sid="MAT 17:4" />Xók achêk, xók pơơh paraaq, Phi-e-rơ móón palơq Chuôq Jê-su: “Kakoh Chuôq, alua nek liêm đóng nôôq he buôn tơơt dhiq ađô. La Amei kiêng, aku e kadhơng dhiq ađô pe beq pơơq — mưi đóng Amei, mưi đóng Môôi-se lơq mưi đóng Ê-li.” <verse eid="MAT 17:4" /><verse number="5" style="v" sid="MAT 17:5" />Xók bhêêl ađó bhiêk dyơq xók papraaq nek lêi tôôh, mưi garboq dhaluk brương braang dhuum pađơp piđó, lơq lêi ađô, mưi dhariêng praaq tư tââq garboq dhaluk, kơi ađô: “Ađô nek Akóón nh'nhơr tââm ưng Aku, hơq Aku lóng liêm lóóm dhiq Akóón. Phaai xâng bóóp Akóón achêk.” <verse eid="MAT 17:5" /><verse number="6" style="v" sid="MAT 17:6" />Xók ơi xâng, nôôq môôn-đô kalơm bharóp mat lơq lóng braaih kakhin bhlơng. <verse eid="MAT 17:6" /><verse number="7" style="v" sid="MAT 17:7" />Hayơq Chuôq Jê-su, xong xók vôôiq pađan lơq kadhâng leq piđó, hơq praaq: “Nek yuur dyương lơq óóq braaih kakhin.” <verse eid="MAT 17:7" /><verse number="8" style="v" sid="MAT 17:8" />Bơơi xók yuur chaling mat ađêi, piđó kah lêi ngaai chapiên mưi Chuôq Jê-su giêl.<verse eid="MAT 17:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 17:9" />Bhêêl xók piđó tââq dhiq bôôl vôôiq dhaluônh, Chuôq Jê-su praaq parâng leq piđó kơi ađô: “Óóq truuih lóóiq rau ơi lêi palơq ngaai đóng tơk xók Akóón Manưih ơi tââq akan chêt mamông lóóiq.” <verse eid="MAT 17:9" /><verse number="10" style="v" sid="MAT 17:10" />Nôôq môôn-đô achêk tamóh Ađó, kơi ađô: “Kơi achêk hau kơi nôôq manưih pachóóm gani móón nek Ê-li kơng phaai bhral laloom?” <verse eid="MAT 17:10" /><verse number="11" style="v" sid="MAT 17:11" />Xók achêk, xók ââi bóóp, Ađó praaq: “Dhơ Ê-li phaai bhral lơq e hayuur paliêm dyóp tarnêêng. <verse eid="MAT 17:11" /><verse number="12" style="v" sid="MAT 17:12" />Bơơi thêi praaq palơq adhi anó kơi Ê-li nek ơi abhral, lơq piđó ơi kah đơơp n'nal ađó. Klóóih dhiq ađek, piđó têêng dyóp kơi rau piđó kiêng palơq ađó. Kung mưi kơi achêk, Akóón Manưih ravang phaai đơơp jarnah tââq piđó.” <verse eid="MAT 17:12" /><verse number="13" style="v" sid="MAT 17:13" />Bhêêl ađek, nôôq môôn-đô n'nal kơi Ađó praaq palơq piđó leq Jang Bap-tiit.<verse eid="MAT 17:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 17:14" />Xók ơi bhral palơq tanóói dhanuôr, mưi ngaai manưih padruuih ơi tơk đan Ađó, chakoh tarkól dhiq toom Ađó <verse eid="MAT 17:14" /><verse number="15" style="v" sid="MAT 17:15" />lơq móón: “Chuôq ơơi, nhan kayô ka-er akóón padruuih aku, taai ađó ka-ai kah praang goq lơq bâân ngơn bhlơng, ơi ađó buôn kalơm leq óih, lơq buôn kalơm leq đơơk. <verse eid="MAT 17:15" /><verse number="16" style="v" sid="MAT 17:16" />Aku ơi đââng ađó tơk leq nôôq môôn-đô ưng Amei, bơơi piđó kah ve chóóm đuôh payươh đóng ađó.” <verse eid="MAT 17:16" /><verse number="17" style="v" sid="MAT 17:17" />Xók achêk, xók ââi lóóiq, Chuôq Jê-su praaq: “Dhong nooi kah huuiq lơq chêt bil tôôh, aku e tơơt palơq nôôq pe patơk mơ bhêêl? E đơơp jruôn nôôq pe patơk mơ đươnh? Nek đââng akóón paniên tơk leq ađô đóng aku.” <verse eid="MAT 17:17" /><verse number="18" style="v" sid="MAT 17:18" />Chuôq Jê-su trêh teng ađó, nek abhưi yuur xooq tââq akóón paniên, lơq ađó bâân yươh tââq bhêêl ađek.<verse eid="MAT 17:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 17:19" />Tââq ađek, xong xók tơk pađan n'tua palơq Chuôq Jê-su, nôôq môôn-đô tamóh: “Ơi taai harau chóóm nôôq yi kah đuôh paxooq abhưi gluh?” <verse eid="MAT 17:19" /><verse number="20" style="v" sid="MAT 17:20" />Hayơq Ađó praaq palơq piđó: “Taai lóóm huuiq kuôq m'bưưiq ưng adhi anó. Ơi alua, Aku praaq palơq adhi anó, la adhi anó ve lóóm huuiq kơi mưi kaliêng habhêi, nek adhi anó e kayua đóng bôôl ađô: ‘Phaai tââi tââq dham ađô leq dham tôôh,’ nek ađó e tââi vôôiq, lơq e yươq ve rau nek kah chóóm palơq adhi anó.” <verse eid="MAT 17:20" /><verse number="21" style="v" sid="MAT 17:21" />(Bơơi rau abhưi ađô kah đuôh paxooq la kah palơq gavơh nhan lơq điêng chacha.)<verse eid="MAT 17:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 17:22" />Xók achêk, bhêêl xók piđó nhoom xóng piđó lóóiq dhiq Ga-li-lê, Chuôq Jê-su praaq palơq piđó: “Akóón Manưih ravang bâân tapajaau leq têi palââng, <verse eid="MAT 17:22" /><verse number="23" style="v" sid="MAT 17:23" />lơq palââng e leng Ađó vóq, hayơq mót tangêi thưưq pe, Ađó e bâân têêng mamông lóóiq.” Nôôq môôn-đô val xar lóng ranguôq bhlơng.<verse eid="MAT 17:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 17:24" />Bhêêl achêk, xók piđó ơi vôôiq tơk kanóón Ka-bê-na-um, nôôq manưih pagoop jêên đong bhanuôih tơk palơq Phi-e-rơ lơq tamóh: “Thêi ưng amei kah goop jêên leq đong bhanuôih alua?” <verse eid="MAT 17:24" /><verse number="25" style="v" sid="MAT 17:25" />Ađó ââi: “Ve.” Lơq bhêêl ơi mót kalóóng đong, Chuôq Jê-su ơi yuur paraaq palơq ađó laloom, kơi ađô: “Si-môôn, ng'kơi amei kanóq? Nôôq bhua dhiq katiêk pei jêên môôiq pagoop ngaai tââq? Tââq akóón anaaq piđó môôiq tââq manưih nguôi?” <verse eid="MAT 17:25" /><verse number="26" style="v" sid="MAT 17:26" />Xong xók ââi: “Tââq manưih nguôi”, Chuôq Jê-su praaq palơq ađó: “Kơi achêk akóón anaaq nek bâân yươh pagoop. <verse eid="MAT 17:26" /><verse number="27" style="v" sid="MAT 17:27" />Bơơi buôn nôôq he yươq têêng kanóq lơt đóng palââng, nek bhêêl vôôiq leq taxiiq, amei m'peq rabeh lơq hayuur ađó kadhóóng chóót laloom. Xong xók vaaq bóóp ađó, amei e lêi mưi siêk-lơ. Bâân pei jêên ađek hayơq, nek pagoop leq piđó klóh mơ phơn ưng thêi lơq amei.”<verse eid="MAT 17:27" /></para>
  <chapter eid="MAT 17" />
  <chapter number="18" style="c" sid="MAT 18" />
  <para style="p">
    <verse number="1" style="v" sid="MAT 18:1" />Mót jơ ađek, nôôq môôn-đô tơk đan Chuôq Jê-su, tamóh: “Tatun xariêq nek ngaai đu gamak lơh tabhơt kalóóng katiêk pleng?” <verse eid="MAT 18:1" /><verse number="2" style="v" sid="MAT 18:2" />Hayơq xong xók dhaloong mưi chanak paniên tơk palơq ađêi, Ađó patơơt paniên tơơt m'pơng piđó <verse eid="MAT 18:2" /><verse number="3" style="v" sid="MAT 18:3" />lơq praaq: “Alua, thêi praaq palơq adhi anó, la adhi anó kah bâân dhơ klôôq lơq val xar kơi nôôq akóón paniên nek dhakơi adhi anó e kah vôôiq mót kalóóng katiêk pleng. <verse eid="MAT 18:3" /><verse number="4" style="v" sid="MAT 18:4" />Kơi achêk, dhơ dhangaai pa-êêp ađêi thê kơi akóón paniên ađô, nek manưih ađek gamak lơh tabhơt kalóóng katiêk pleng. <verse eid="MAT 18:4" /><verse number="5" style="v" sid="MAT 18:5" />La ngaai vơn dhanóók thêi yaauq mưi akóón paniên kơi ađô, nek manưih ađek pơh yaauq thêi. <verse eid="MAT 18:5" /><verse number="6" style="v" sid="MAT 18:6" />Bơơi ngaai đu têêng lơt đóng mưi kalóóng nôôq manưih paniên katưưiq ađô, nek nôôq manưih huuiq dhiq thêi, nek rau đu lalua đóng manưih ađek chênh nek mưi beq tapal pakoom đóng axeh bâân yông praang tuôr ađó, hayơq ađó bâân m'peq paklêch leq taxiiq dhơuq.<verse eid="MAT 18:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 18:7" />Ayô xarngaat đóng manưih hóng katiêk ơi taai nôôq rau têêng lơt môôp! Ơi taai nôôq rau têêng lơt môôp phaai tơk nek dhakơi phaai ve, dhơ kơi achêk, ayô xarngaat đóng manưih hơq taai têêng lơt môôp tơk dhiq manưih achêk! <verse eid="MAT 18:7" /><verse number="8" style="v" sid="MAT 18:8" />Kơi lââng, la têi môôiq dyung adhi anó têêng đóng adhi anó lơt môôp, phaai têch lơơi ađó lơq m'peq changaai tââq adhi anó. Achêk nek rau liêm leq adhi anó buôn bâân kabhul têi môôiq khuch dyung hayơq mót kalóóng parmông lơh nek xók ve bơơr têi môôiq bơơr dyung buôn hayơq bâân m'peq leq óih tơk nh'chró. <verse eid="MAT 18:8" /><verse number="9" style="v" sid="MAT 18:9" />La mat adhi anó têêng đóng adhi anó lơt môôp, phaai bhalok ađó gluh lơq m'peq changaai tââq adhi anó. Achêk nek rau liêm leq adhi anó buôn chapiên dyơq mưi mat hayơq mót kalóóng parmông, lơh nek xók ve bơơr mat buôn hayơq bâân m'peq leq bóng óih. <verse eid="MAT 18:9" /><verse number="10" style="v" sid="MAT 18:10" />Phaai hêch lêi, adhi anó kah chóóm kađiq kađiêp mưi kalóóng nôôq manưih paniên katưưiq ađô. Ơi thêi praaq palơq adhi anó kơi nôôq dhơn pleng ưng piđó dhiq pleng taluôn luôn dhamơn lêi mat Ama thêi dhiq pleng. <verse eid="MAT 18:10" /><verse number="11" style="v" sid="MAT 18:11" />(Ơi Akóón Manưih ơi bhral buôn paq đu bâân xraang bil.) <verse eid="MAT 18:11" /><verse number="12" style="v" sid="MAT 18:12" />Adhi anó kanóq ng'kơi? La mưi chanak achêk ve mưi hariêng akóón trưưu, hơq mưi kalóóng nôôq piđó vôôiq xraang, nek kah alua xong xók lơơi lóóiq takiêh jêt takiêh dhiq bôôl lơq yuur vôôiq, manưih achêk chêk-tabâân akóón trưưu đu xraang môôiq alua? <verse eid="MAT 18:12" /><verse number="13" style="v" sid="MAT 18:13" />La manưih achêk ve chóóm bâân lêi ađó, nek alua, thêi praaq palơq adhi anó kơi manưih ađek e bhuui marhaal leq ađó lơh nek leq takiêh jêt takiêh akóón trưưu yươq bâân xraang. <verse eid="MAT 18:13" /><verse number="14" style="v" sid="MAT 18:14" />Kiêng kơi ađek, karnóq kiêng toom mat Ama dhiq pleng ưng adhi anó eh rau nek đóng mưi kalóóng nôôq paniên katưưiq katit ađô bâân hư bil.<verse eid="MAT 18:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 18:15" />Kơi lââng, la mưi chanak adhi anó ưng adhi anó têêng lơt palơq adhi anó, phaai vôôiq, phaai trêh teng ađó m'pơng adhi anó palơq manưih ađek hơq giêl. La manưih ađek đơơp xâng adhi anó, nek adhi anó bâân lóóiq manưih adhi anó ađêi. <verse eid="MAT 18:15" /><verse number="16" style="v" sid="MAT 18:16" />Bơơi la manưih ađek kah ting xâng, phaai đââng ting ađêi mưi môôiq bơơr chanak dyơq, buôn đóng tââq bóóp ưng bơơr môôiq pe chanak truuih móón nek dyóp paraaq ve chóóm bâân lêi lalua. <verse eid="MAT 18:16" /><verse number="17" style="v" sid="MAT 18:17" />Hayơq la manưih ađek kah đươi ting xâng piđó, phaai truuih móón leq Kabhuh Akóón Dhơn Chuôq. Hơq la manưih ađek kung kah đươi ting xâng Kabhuh Akóón Dhơn Chuôq, nek palơq adhi anó, manưih ađek patơk mơ phaai kơi nek dhanuôr manưih nguôi lơq đu pagoop jêên. <verse eid="MAT 18:17" /><verse number="18" style="v" sid="MAT 18:18" />Alua, thêi praaq palơq adhi anó, la adhi anó chauq kah xêi hau rau dhiq katiêk, nek rau achêk e bâân chauq dhiq pleng; lơq la adhi anó lêh kah xêi hau rau tơơt dhiq katiêk, nek rau achêk e bâân lêh dhiq pleng. <verse eid="MAT 18:18" /><verse number="19" style="v" sid="MAT 18:19" />Mưi chu dyơq, alua, thêi praaq palơq adhi anó, kơi la bơơr chanak kalóóng adhi anó markơi lóóm palơq xóng ađêi dhiq katiêk leq dyóp rau hơq la piđó gavơh nhan, nek rau ađek e bâân têêng xong leq piđó tââq Ama thêi, dhiq pleng. <verse eid="MAT 18:19" /><verse number="20" style="v" sid="MAT 18:20" />Ơi n'đó dhiq ve bơơr môôiq pe chanak markơi lóóm karong madhiq kalóóng dhanóók thêi, nek thêi tơơt dhiq ađek dhalam m'pơng piđó.”<verse eid="MAT 18:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 18:21" />Tââq ađek, xong xók tơk đan, Phi-e-rơ tamóh palơq Ađó: “Kakoh Chuôq, mưi chanak adhi anó aku e têêng lơt huông palơq aku, lơq aku e lơơi lơt ađó ađek mơ chu? Mơ patơk tapól chu?” <verse eid="MAT 18:21" /><verse number="22" style="v" sid="MAT 18:22" />Chuôq Jê-su praaq palơq ađó: “Aku kah móón palơq amei tơk tapól chu, bơơi nek tơk mơ tapól jêt chu tapól. <verse eid="MAT 18:22" /><verse number="23" style="v" sid="MAT 18:23" />Ơi taai rau ađô, katiêk pleng ve chóóm bâân babi kơi mưi chanak têêng bhua, hơq manưih achêk kiêng yaap xêi bha-aar bhatơ palơq nôôq dhơn ratơơq ađêi. <verse eid="MAT 18:23" /><verse number="24" style="v" sid="MAT 18:24" />Xók achêk, xók bhua tanââp tââp yaap bha-aar, mưi manưih manơơq majêt ngaan ta-lơng bâân đââng tơk leq bhua. <verse eid="MAT 18:24" /><verse number="25" style="v" sid="MAT 18:25" />Bơơi manưih ađek kah ve chóóm đuôh chróót, hayơq bhua ơi kayua leq ađó ađek phaai bâân tabaan, palơq kađiêl, akóón lơq tabhơt dyóp rau ađêi ve, hayơq chróót nơơq. <verse eid="MAT 18:25" /><verse number="26" style="v" sid="MAT 18:26" />Kơi achêk nek xong xók chip mat, ađó têêng xól achêk chakoh toom bhua, móón: ‘Abhươp ơơi, nhan raan đương palơq aku, hayơq aku e chróót lóóiq leq amei tabhơt.’ <verse eid="MAT 18:26" /><verse number="27" style="v" sid="MAT 18:27" />Xók achêk, tââq lóóm kayô ka-er, kala ưng ađó têêng xól ađek ơi đơơp paloh lơq lơơi nơơq đóng ađó ađek. <verse eid="MAT 18:27" /><verse number="28" style="v" sid="MAT 18:28" />Bơơi bhêêl ơi gluh leq nguôi, ađó têêng xól ađek bâân lum mưi nak kalóóng nôôq đu têêng xól palơq ađêi, nek manưih manơơq ađó mưi hariêng đơ-ni-ê, lơq xong xók pei kóóp manưih ađek, ađó garet tuôr, móón: ‘Amei manơơq harau nek chróót aq.’ <verse eid="MAT 18:28" /><verse number="29" style="v" sid="MAT 18:29" />Kơi achêk nek, xong xók chakoh tarkól, manưih mađó têêng xól palơq ađó bhiêl panhel ađó, kơi ađô: ‘Nhan raan đương palơq aku, hayơq aku e chróót leq amei.’ <verse eid="MAT 18:29" /><verse number="30" style="v" sid="MAT 18:30" />Bơơi ađó ađek kah đơơp. Klóóih dhiq ađek, xók yuur vôôiq, ađó đóng tamót manưih tôôh leq đong kanam đóng tơk xók ađó ađek chróót bhơt jêên manơơq. <verse eid="MAT 18:30" /><verse number="31" style="v" sid="MAT 18:31" />Kơi achêk, xong xók lêi tarnêêng ơi yuur vaaih, nôôq đu mađó têêng xól ưng ađó lóng ka-ai lóóm. Xók ơi vôôiq tơk piđó truuih dyóp bhơt palơq kala ađêi dyóp chiên ơi yuur vaaih. <verse eid="MAT 18:31" /><verse number="32" style="v" sid="MAT 18:32" />Tââq ađek, xong xók kayua đóng ađó têêng xól achêk tơk, kala ưng ađó praaq palơq ađó: ‘Đu têêng xól lơt aak tôôh, aku ơi lơơi bhơt nơơq ađek đóng amei taai amei ơi nhan panhel aku. <verse eid="MAT 18:32" /><verse number="33" style="v" sid="MAT 18:33" />Tarnêêng kung kơng têêng pakoom đóng amei eh rau nek kayô ka-er manưih mađó têêng xól palơq ađêi, kung kơi aku ơi kayô ka-er amei?’ <verse eid="MAT 18:33" /><verse number="34" style="v" sid="MAT 18:34" />Taai bâân ơơr kabhróónh kơi achêk, kala ưng ađó ơi pajaau ađó leq kabhuh đương m'bhiiq đóng tơk xók ađó chróót bhơt dyóp rau dyơq manơơq. <verse eid="MAT 18:34" /><verse number="35" style="v" sid="MAT 18:35" />Ama dhiq pleng ưng thêi kung e têêng praaq palơq adhi anó ting i kơi achêk, la dyóp chanak kalóóng adhi anó kah lơơi lơt đóng manưih adhi anó ưng ađêi gluh tââq tala lóóm ađêi.”<verse eid="MAT 18:35" /></para>
  <chapter eid="MAT 18" />
  <chapter number="19" style="c" sid="MAT 19" />
  <para style="p">
    <verse number="1" style="v" sid="MAT 19:1" />Tarnêêng yuur vaaih nek xók Chuôq Jê-su ơi praaq parluch nôôq paraaq achêk, Ađó xooq tââq Ga-li-lê lơq vôôiq tơk parah Ju-đê tơơt hót tôôh karuung Jô-đen. <verse eid="MAT 19:1" /><verse number="2" style="v" sid="MAT 19:2" />Nôôq tanóói dhanuôr ganơr ting Ađó lơq Ađó payươh ka-ai đóng piđó dhiq ađek.<verse eid="MAT 19:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 19:3" />Nôôq manưih Pha-ri-si tơk pađan Ađó, klêêu Ađó lơq tamóh: “Ve kre kah đóng pheep mưi chanak manưih padruuih tarlơơi lơq kađiêl ađêi ơi taai nek dhơ dharau?” <verse eid="MAT 19:3" /><verse number="4" style="v" sid="MAT 19:4" />Xók ââi bóóp, Ađó praaq: “Nôôq pe kah đok kơi Yaang tavaaih tââq bhêêl tââp tarnââp ơi têêng tavaaih piđó, mưi chanak padruuih lơq mưi chanak pađiil, <verse eid="MAT 19:4" /><verse number="5" style="v" sid="MAT 19:5" />lơq praaq: ‘Ơi taai achêk, manưih padruuih e tââi tââq akonh lơq akan hơq panjoop madhiq maleq palơq kađiêl ađêi, lơq miq bơơr e nek mưi ng'kar m'bech?’ <verse eid="MAT 19:5" /><verse number="6" style="v" sid="MAT 19:6" />Tơk mơ, piđó kah dyơq nek bơơr, bơơi nek mưi ng'kar m'bech. Taai ađek, rau hơq Yaang Pleng ơi panjoop lóóiq, nek akóón manưih kah chóóm têêng tablah.” <verse eid="MAT 19:6" /><verse number="7" style="v" sid="MAT 19:7" />Piđó tamóh palơq Ađó: “Kơi achêk, hau kơi Môôi-se ơi truuih pachóóm phaai pađơơp tala bha-aar tarlơơi hayơq ve lơơi kađiêl?” <verse eid="MAT 19:7" /><verse number="8" style="v" sid="MAT 19:8" />Ađó móón piđó kơi ađô: “Taai rau nhâng lóóm ưng nôôq pe hơq Môôi-se ơi đóng pheep nôôq pe tarlơơi kađiêl ađêi, bơơi tââq tarnââp, rau ađek eh rau nek kơi achêk. <verse eid="MAT 19:8" /><verse number="9" style="v" sid="MAT 19:9" />Bơơi Aku praaq palơq nôôq pe kơi chapiên ơi matu têêng tapiing, ngaai manưih tarlơơi kađiêl ađêi hayơq nhan manưih lââng nek matu lơt têêng tapiing; đu nhan manưih ơi bâân tarlơơi kung matu lơt têêng tapiing.” <verse eid="MAT 19:9" /><verse number="10" style="v" sid="MAT 19:10" />Nôôq môôn-đô móón palơq Ađó: “La rau chiên ưng manưih padruuih nek palơq kađiêl ađêi hơq kơi achêk, nek n'jang kah pei kađiêl.” <verse eid="MAT 19:10" /><verse number="11" style="v" sid="MAT 19:11" />Bơơi Ađó praaq palơq piđó: “Eh rau dyóp ngaai kung ve chóóm đơơp paraaq ađô, bơơi nek pakoom đóng nôôq ngaai hơq rau achêk bâân tađóng. <verse eid="MAT 19:11" /><verse number="12" style="v" sid="MAT 19:12" />Ơi ve nôôq manưih tablươt, nek nôôq manưih bâân n'niên tââq kalóóng luônh akan ơi kơi achêk; ve nôôq manưih tablươt hơq bâân palââng têêng tablươt; lơq ve nôôq manưih tablươt nek nôôq manưih tư blươt chênh ađêi ơi taai katiêk pleng. Ngaai ve đuôh pei đơơp paraaq ađô, manưih ađek nek pei đơơp.”<verse eid="MAT 19:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 19:13" />Tââq ađek, nôôq akóón paniên katưưiq bâân đââng tơk leq Ađó buôn Ađó kadhâng têi dhiq piđó lơq gavơh nhan, bơơi nôôq môôn-đô trêh teng piđó. <verse eid="MAT 19:13" /><verse number="14" style="v" sid="MAT 19:14" />Dhơ kơi ađek, Chuôq Jê-su praaq: “Phaai lơơi đóng akóón paniên tơk palơq thêi, lơq óóq châq kajơq piđó, ơi katiêk pleng nek ưng nôôq ngaai kơi achêk.” <verse eid="MAT 19:14" /><verse number="15" style="v" sid="MAT 19:15" />Xong xók lơơi têi dhiq piđó, Ađó tââq ađek yuur vôôiq.<verse eid="MAT 19:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 19:16" />Lơq lêi tôôh, mưi chanak tôôh xók tơk pađan Ađó, ơi tamóh: “Thêi ơơi, harau tarnêêng liêm aku phaai têêng buôn aku ve bâân parmông tơk nh'chró?” <verse eid="MAT 19:16" /><verse number="17" style="v" sid="MAT 19:17" />Hayơq Chuôq praaq palơq ađó: “Hau amei tamóh aku leq tarnêêng liêm? Chapiên mưi Yaang nek bhơt liêm, hayơq la amei kiêng mót kalóóng parmông, phaai jư nôôq gani pachóóm.” <verse eid="MAT 19:17" /><verse number="18" style="v" sid="MAT 19:18" />Manưih ađek móón palơq Ađó: “Nôôq n'đó dhơơm gani pachóóm?” Hayơq Chuôq Jê-su ââi: “Óóq leng manưih, óóq têêng matu tapiing, óóq tatông papei, óóq truuih móón chachââr, <verse eid="MAT 19:18" /><verse number="19" style="v" sid="MAT 19:19" />Phaai bhi nh'nhơr akonh lơq akan, lơq nh'nhơr manưih đan tóór ưng amei kơi ađêi kala.” <verse eid="MAT 19:19" /><verse number="20" style="v" sid="MAT 19:20" />Padruuih n'dhóm achêk móón palơq Chuôq: “Aku ơi xâng jư tabhơt nôôq rau achêk. Hau rau hayơq aku thiêuq dyơq?” <verse eid="MAT 19:20" /><verse number="21" style="v" sid="MAT 19:21" />Chuôq Jê-su praaq palơq ađó: “La amei kiêng bâân liêm dyóp, nek vôôiq, chô baan nôôq rau ađêi ve hayơq poor đóng leq manưih ngeeo, nek amei e ve jơơng drươp dhiq pleng; lơq nek ting aku mơq!.” <verse eid="MAT 19:21" /><verse number="22" style="v" sid="MAT 19:22" />Bơơi xók xâng praaq achêk xong, padruuih n'dhóm ơi yuur xooq taai ranguôq rangóót, ơi ađó ađek biêh xók ve lóng bơk drươp karvaan.<verse eid="MAT 19:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 19:23" />Xók achêk, Chuôq Jê-su praaq palơq nôôq môôn-đô ađêi: “Alua, thêi praaq palơq adhi anó kơi ađô: manưih karvaan e mót kalóóng katiêk pleng mưi kơi kadhaap bhlơng. <verse eid="MAT 19:23" /><verse number="24" style="v" sid="MAT 19:24" />Hơq thêi vil praaq palơq adhi anó, lơơi akóón adhah kamel paliên hót bóng jarum nek rau buôn khe lơh marchơng palơq manưih karvaan mót kalóóng katiêk ưng Yaang Pleng.” <verse eid="MAT 19:24" /><verse number="25" style="v" sid="MAT 19:25" />Xók achêk, xong xók xâng kơi achêk, nôôq môôn-đô lóng chrih xâng, móón: “Kơi achêk nek ngaai ve chóóm bâân paq?” <verse eid="MAT 19:25" /><verse number="26" style="v" sid="MAT 19:26" />Padrêh chamet lêi piđó, Chuôq Jê-su praaq palơq piđó: “Palơq akóón manưih, tarnêêng ađô nek kah chóóm, bơơi palơq Yaang Pleng, dyóp tarnêêng nek ve chóóm.” <verse eid="MAT 19:26" /><verse number="27" style="v" sid="MAT 19:27" />Bhêêl ađek, buôn ââi lóóiq, Phi-e-rơ móón palơq Ađó: “Thêi lêi nek, nôôq yi ơi lơơi dyóp rau lơq ting thêi. Kơi achêk nek e ve hau rau pakoom đóng nôôq yi?” <verse eid="MAT 19:27" /><verse number="28" style="v" sid="MAT 19:28" />Hayơq Chuôq Jê-su praaq palơq piđó: “Alua, thêi praaq palơq adhi anó, kơi adhi anó, hơq nek nôôq manưih ơi ting thêi, kalóóng tangêi vaaih tame, xók Akóón Manưih tơơt dhiq tanơơt brương cha-iil ađêi, nek adhi anó kung e tơơt dhiq majêt bơơr tanơơt xêi xanêi majêt bơơr kabhuh I-sơ-ra-êên. <verse eid="MAT 19:28" /><verse number="29" style="v" sid="MAT 19:29" />Ting chanak, hơq nek ngaai ơi lơơi đong xaang, adhi anó, miing móóq, akonh, akan, kađiêl, akóón môôiq katiêk hare ơi taai dhanóók ưng thêi, e đơơp bơk mưi hariêng chu lơq bâân đơơp parmông tơk nh'chró. <verse eid="MAT 19:29" /><verse number="30" style="v" sid="MAT 19:30" />Bơơi ve bơk ngaai laloom e val xar tatun, lơq nôôq manưih tatun e val xar laloom.<verse eid="MAT 19:30" /></para>
  <chapter eid="MAT 19" />
  <chapter number="20" style="c" sid="MAT 20" />
  <para style="p">
    <verse number="1" style="v" sid="MAT 20:1" />Ơi katiêk pleng nek thê kơi mưi nak kala katiêk, nek manưih vôôiq gluh xók vaar yayóng tarưưp buôn cher manưih têêng đóng bhươn nho ađêi. <verse eid="MAT 20:1" /><verse number="2" style="v" sid="MAT 20:2" />Xók achêk, xong ơi klóh bóóp palơq nôôq manưih têêng palơq mưi đơ-ni-ê đóng mưi tangêi, ađó kayua palââng mót leq bhươn nho ưng ađêi. <verse eid="MAT 20:2" /><verse number="3" style="v" sid="MAT 20:3" />Lơq xók vôôiq gluh mót mơ takiêh jơ yayóng, ađó lêi nôôq lââng xók dyương kah rau têêng kalóóng parah chơơq. <verse eid="MAT 20:3" /><verse number="4" style="v" sid="MAT 20:4" />Ađó móón palơq piđó: ‘Nôôq pe kung nek mót kalóóng bhươn nho, lơq kông janaaq n'đó nek kơi dhalam, nek aku e chróót leq nôôq pe.’ <verse eid="MAT 20:4" /><verse number="5" style="v" sid="MAT 20:5" />Hayơq piđó ting vôôiq. Xong xók vôôiq gluh lóóiq mót mơ majêt bơơr jơ, lơq pe jơ habu, ađó kung têêng kơi achêk. <verse eid="MAT 20:5" /><verse number="6" style="v" sid="MAT 20:6" />Kơi achêk hayơq, bhêêl vôôiq gluh mơ xââng jơ habu, ađó ve lêi nôôq đu lââng xók dyương, lơq ađó praaq palơq piđó: ‘Hau nôôq anó dyương kagóh tóóng tangêi dhiq ađôk?’ <verse eid="MAT 20:6" /><verse number="7" style="v" sid="MAT 20:7" />Piđó móón palơq ađó: ‘Taai kah ngaai cher nôôq yi.’ Ađó móón palơq piđó: ‘Nôôq anó kung nek vôôiq mót kalóóng bhươn nho.’ <verse eid="MAT 20:7" /><verse number="8" style="v" sid="MAT 20:8" />Hayơq tơk habu blót, kala bhươn nho kayua manưih đương lêi ưng ađêi: ‘Nek dhaloong nôôq manưih têêng makông tơk lơq chróót kông leq piđó, tarnââp tââq nôôq manưih tatun patơk nôôq manưih laloom.’ <verse eid="MAT 20:8" /><verse number="9" style="v" sid="MAT 20:9" />Xong xók vôôiq patơk, nôôq manưih bâân cher mót mơ habu xââng jơ, ting chanak bâân đơơp mưi đơ-ni-ê. <verse eid="MAT 20:9" /><verse number="10" style="v" sid="MAT 20:10" />Hayơq nôôq manưih makông laloom tarnââp, bhêêl vôôiq patơk, ơi kanóq kơi ađêi e đơơp bơk lơh, hơq piđó kung đơơp mưi đơ-ni-ê đóng ting chanak. <verse eid="MAT 20:10" /><verse number="11" style="v" sid="MAT 20:11" />Bơơi xong xók ơi đơơp, piđó m'bhoonh leq manưih kala katiêk, <verse eid="MAT 20:11" /><verse number="12" style="v" sid="MAT 20:12" />kơi ađô: ‘Nôôq manưih makông tatun kiêt ađek ơi têêng tarnêêng mưi jơ, hơq kala đóng piđó marđơq palơq nôôq yi, nek nôôq manưih ơi đơơp jarnah nhok tóóng tangêi palơq nek puih parang róh.’ <verse eid="MAT 20:12" /><verse number="13" style="v" sid="MAT 20:13" />Bơơi ââi lóóiq, manưih kala praaq palơq mưi nak kalóóng nôôq piđó: ‘Nô parjơơk ơơi, aku kah ve chróót kađiq palơq nôôq pe. Eh dhơq nôôq pe ơi klóh bóóp palơq aku mưi đơ-ni-ê kah alua? <verse eid="MAT 20:13" /><verse number="14" style="v" sid="MAT 20:14" />Phaai đơơp phơn ưng amei lơq vôôiq aq. Hayơq aku nek kiêng đóng leq nôôq manưih tatun ađô kung i kơi leq amei. <verse eid="MAT 20:14" /><verse number="15" style="v" sid="MAT 20:15" />Môôiq kah ve pheep đóng aku buôn têêng rau aku kiêng palơq nôôq dhơơm ưng ađêi? Môôiq mat amei nek dyââng lêi taai aku ve lóóm liêm?’ <verse eid="MAT 20:15" /><verse number="16" style="v" sid="MAT 20:16" />Markơi ađek, manưih tatun e val xar laloom lơq manưih laloom val xar tatun.”<verse eid="MAT 20:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 20:17" />Xók bhêêl vôôiq đơk kanóón Jê-ru-sa-leem, Chuôq Jê-su đââng ting majêt bơơr môôn-đô pantua palơq ađêi, lơq dhiq kalơng vôôiq, Chuôq praaq palơq piđó: <verse eid="MAT 20:17" /><verse number="18" style="v" sid="MAT 20:18" />“Lêi nô, nôôq he xók vôôiq đơk tơk Jê-ru-sa-leem, lơq Akóón Manưih e bâân pajaau đóng nôôq takóh kala kadhâng bhanuôih lơq nôôq manưih pachóóm gani, hayơq piđó e patu leng chêt Aku <verse eid="MAT 20:18" /><verse number="19" style="v" sid="MAT 20:19" />lơq e pajaau Ađó leq nôôq dhanuôr manưih nguôi buôn ajóóch paxê, m'bhiiq vei, lơq teeng đinh Ađó dhiq n'lóóng m'baang chatông. Hayơq mót tangêi thưưq pe, Ađó e mamông lóóiq.”<verse eid="MAT 20:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 20:20" />Bhêêl ađek, akan ưng bơơr akóón padruuih Xê-bê-đê nek palơq nôôq akóón amooq tơk đan Ađó, kóp kakoh lơq mââl nhan mưi rau tââq Ađó. <verse eid="MAT 20:20" /><verse number="21" style="v" sid="MAT 20:21" />Hayơq Ađó praaq palơq amooq: “Amei kiêng hau rau?” Amooq móón palơq Ađó: “Nhan kayua ng'kơi đóng bơơr panong akóón padruuih ađô ưng aku, mưi chanak ve chóóm bâân tơơt hót atươm, lơq mưi chanak tơơt hót ađaai thêi, kalóóng katiêk ưng thêi.” <verse eid="MAT 20:21" /><verse number="22" style="v" sid="MAT 20:22" />Bơơi xók ââi lóóiq, Chuôq Jê-su móón: “Pe nak kah n'nal ađêi xók gavơh nhan hau rau dhơq. Bơơr anhưa ve đuôh ơm choom hơq thêi ravang ơm kah?” Nhiđó ââi palơq Ađó: “Yưa ve đuôh ơm.” <verse eid="MAT 20:22" /><verse number="23" style="v" sid="MAT 20:23" />Ađó praaq palơq piđó: “Dhơ adhi anó e ơm choom ưng thêi, bơơi buôn tơơt dhiq hót atươm lơq dhiq hót ađaai ưng thêi eh rau nek tarnêêng ưng thêi đóng pheep, bơơi nek pakoom đóng nôôq manưih ơi bâân ravang lơơi tââq Ama thêi.” <verse eid="MAT 20:23" /><verse number="24" style="v" sid="MAT 20:24" />Xong xók xâng chiên ađô, majêt môôn-đô tôôh vaaih kabhróónh palơq bơơr nhiđó. <verse eid="MAT 20:24" /><verse number="25" style="v" sid="MAT 20:25" />Bơơi bhêêl ơi dhaloong piđó tơk palơq Ađêi, Chuôq Jê-su praaq: “Adhi anó n'nal kơi nôôq bhua chuôq ưng nôôq dhanuôr manưih nguôi nek pa-eep dhanuôr, lơq nôôq manưih têêng gamak nek pakah karơ kataai dhiq palââng. <verse eid="MAT 20:25" /><verse number="26" style="v" sid="MAT 20:26" />Kalóóng adhi anó nek kah kơi achêk. Klóóih dhiq ađek, la ngaai kiêng val xar gamak dhiq m'pơng adhi anó, nek manưih achêk e têêng manưih têêng yaauq adhi anó, <verse eid="MAT 20:26" /><verse number="27" style="v" sid="MAT 20:27" />lơq ngaai đu kiêng têêng akoq kalóóng adhi anó nek e têêng dhơn ratơơq ưng adhi anó, <verse eid="MAT 20:27" /><verse number="28" style="v" sid="MAT 20:28" />patơk mơ kơi Akóón Manưih ơi eh bhral buôn bâân palââng têêng yaauq, bơơi nek buôn têêng yaauq, lơq buôn pajaau parmông ađêi kơi janaaq pók pei klóóih đóng bơk manưih.”<verse eid="MAT 20:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 20:29" />Hayơq xók piđó tââq kanóón Jê-ri-kô vôôiq gluh, mưi tanóói dhanuôr bơk vôôiq ting Ađó. <verse eid="MAT 20:29" /><verse number="30" style="v" sid="MAT 20:30" />Lơq lêi tôôh, bơơr chanak kabaang xók tơơt dhiq tóór kalơng. Xong xók xâng kơi Chuôq Jê-su xók vôôiq lalơh, nhiđó yuur lalơu, kơi ađô: “Kakoh Chuôq, Akóón bhua Đa-viit, nhan kayô ka-er nôôq yi.” <verse eid="MAT 20:30" /><verse number="31" style="v" sid="MAT 20:31" />Bơơi tanóói dhanuôr trêh teng bơơr nhiđó, buôn nhiđó parngau aq, kơi achêk hơq nhiđó tơk mơ lalơu karơ lơh dyơq, kơi ađô: “Kakoh Chuôq, Akóón bhua Đa-viit, nhan kayô ka-er nôôq yi.” <verse eid="MAT 20:31" /><verse number="32" style="v" sid="MAT 20:32" />Xók dyương lóóiq hayơq, Chuôq Jê-su dhaloong nhiđó tơk lơq praaq: “Nôôq anó kiêng aku hau rau têêng đóng nôôq anó?” <verse eid="MAT 20:32" /><verse number="33" style="v" sid="MAT 20:33" />Nhiđó ââi palơq Ađó: “Kakoh Chuôq, achêk nek nhan đóng mat nôôq yi bâân brương.” <verse eid="MAT 20:33" /><verse number="34" style="v" sid="MAT 20:34" />Xók achêk, tââq lóóm kayô ka-er, Chuôq Jê-su kadhâng leq mat nhiđó. N'drươh, nhiđó bâân brương mat lơq vôôiq ting Ađó.<verse eid="MAT 20:34" /></para>
  <chapter eid="MAT 20" />
  <chapter number="21" style="c" sid="MAT 21" />
  <para style="p">
    <verse number="1" style="v" sid="MAT 21:1" />Xók piđó đan tơk kanóón Jê-ru-sa-leem, lơq vôôiq tơk Bê-pha-jê, malóóm leq bôôl Ô-liiu, bhêêl achêk Chuôq Jê-su kayua bơơr môôn-đô, <verse eid="MAT 21:1" /><verse number="2" style="v" sid="MAT 21:2" />yua piđó: “Phaai vôôiq mót leq bhươl toom mat adhi anó, hayơq adhi anó e lêi dhalam mưi panong axeh kan bâân tadhâng, palơq mưi axeh akóón tơơt palơq ađó. Xong xók lêh tarlêi tadhâng, nek đââng tơk leq thêi. <verse eid="MAT 21:2" /><verse number="3" style="v" sid="MAT 21:3" />Lơq la ve ngaai ađek rau móón palơq adhi anó, nek adhi anó e praaq kơi ađô: ‘Chuôq ve kiêng vech ađó,’ hayơq manưih ađek e n'drươh lơơi piđó vôôiq.” <verse eid="MAT 21:3" /><verse number="4" style="v" sid="MAT 21:4" />Kơi lââng, tarnêêng ađô yuur vaaih buôn đóng paraaq ơi bâân praaq tapâng dhiq manưih đââng taruuih ve chóóm bâân tajaap kơi ađô:<verse eid="MAT 21:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="MAT 21:5" />“Phaai móón akóón pađiil ưng Si-ôôn:</para>
  <para style="q" vid="MAT 21:5">Lêi tôôh, Bhua amei vôôiq palơq amei,</para>
  <para style="q" vid="MAT 21:5">pa-êêp ađêi lơq dhââng axeh</para>
  <para style="q" vid="MAT 21:5">hơq nek dhiq mưi axeh akóón, akóón ưng axeh kan.”<verse eid="MAT 21:5" /></para>
  <para style="b" />
  <para style="m">
    <verse number="6" style="v" sid="MAT 21:6" />Xók achêk, nôôq môôn-đô, xong xók vôôiq lơq têêng i kơi Chuôq Jê-su ơi chaleq pachóóm piđó, <verse eid="MAT 21:6" /><verse number="7" style="v" sid="MAT 21:7" />ơi đââng axeh kan palơq axeh akóón chô, lơq bhalêêp aau chaguôk ưng ađêi dhiq axeh, hayơq Ađó dhââng dhiq ađek. <verse eid="MAT 21:7" /><verse number="8" style="v" sid="MAT 21:8" />Xók achêk, Bơk bhlơng nôôq manưih dhanuôr bhalêêp aau chaguôk ưng ađêi dhiq kalơng, hayơq masôôq lââng nek têch nôôq đóóng n'lóóng lơq yuur bhalêêp dhiq kalơng. <verse eid="MAT 21:8" /><verse number="9" style="v" sid="MAT 21:9" />Kơi achêk hayơq, nôôq tanóói bơk vôôiq laloom Ađó lơq ting tatun ơi yuur driêu, kơi ađô:</para>
  <para style="q" vid="MAT 21:9">“Hô-sa-na Akóón bhua Đa-viit!</para>
  <para style="q" vid="MAT 21:9">Đaang bhi haanh Yaang tơk kalóóng dhanóók Chuôq!</para>
  <para style="q" vid="MAT 21:9">Hô-sa-na tơơt dhiq bhơt yaal!”<verse eid="MAT 21:9" /></para>
  <para style="b" />
  <para style="m">
    <verse number="10" style="v" sid="MAT 21:10" />Xong xók Ađó mót kalóóng kanóón Jê-ru-sa-leem, bhơt kanóón bâân nhôôn nhaauq, tamóh: “Ađek nek ngaai?” <verse eid="MAT 21:10" /><verse number="11" style="v" sid="MAT 21:11" />Kơi achêk hayơq tanóói dhanuôr ââi: “Achêk nek Jê-su manưih đââng taruuih, tââq Na-xa-reet, xưưq Ga-li-lê.”<verse eid="MAT 21:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 21:12" />Chuôq Jê-su vôôiq mót kalóóng đong bhanuôih, hayơq Ađó đuôi tabhơt nôôq đu kơl baan kalóóng đong bhanuôih, lơq talâh tantoh baang ưng kabhuh raxal jêên palơq tanơơt ưng kabhuh baan paraap. <verse eid="MAT 21:12" /><verse number="13" style="v" sid="MAT 21:13" />Ađó praaq palơq piđó: “Paraaq ơi bâân xaraq: ‘Đong Aku e bâân đóók nek đong gavơh nhan,’ bơơi nôôq pe ơi têêng ađó xar gơơp tatông papei.” <verse eid="MAT 21:13" /><verse number="14" style="v" sid="MAT 21:14" />Hayơq nôôq manưih kabaang lơq manưih khuch tơk đan Ađó kalóóng đong bhanuôih, lơq Ađó payươh đóng piđó. <verse eid="MAT 21:14" /><verse number="15" style="v" sid="MAT 21:15" />Bơơi nôôq takóh kala kadhâng bhanuôih lơq nôôq manưih pachóóm gani, xong ơi lêi nôôq tarnêêng chrih liêm hơq Ađó ơi têêng, lơq kabhuh akóón paniên driêu gahơ kalóóng đong bhanuôih, kơi ađô: “Hô-sa-na Akóón bhua Đa-viit,” piđó vaaih kabhróónh. <verse eid="MAT 21:15" /><verse number="16" style="v" sid="MAT 21:16" />Piđó praaq palơq Ađó: “Thêi ve xâng piđó praaq harau kah?” Bơơi Chuôq Jê-su ââi piđó: “Ve! Nôôq pe kah mơ glêh đok kơi ađô: ‘Chuôq ơi loom ravang lơơi rau bhi haanh tââq bóóp ưng nôôq paniên katưưiq lơq nôôq paniên dyơq mam,’ dhơq?” <verse eid="MAT 21:16" /><verse number="17" style="v" sid="MAT 21:17" />Xong ơi xooq lơơi piđó, Ađó vôôiq gluh tââq kanóón tơk Bê-tha-ni lơq dhêi hayum dhiq ađek.<verse eid="MAT 21:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 21:18" />Tơk brương, xók val chô leq kanóón, nek Ađó ha-ul. <verse eid="MAT 21:18" /><verse number="19" style="v" sid="MAT 21:19" />Xong xók lêi mưi tââm tarung tóór kalơng, Ađó vôôiq tơk n'lóóng achêk lơq lêi na kah ve rau dhiq ađó chapiên axơq hơq giêl. Chuôq praaq palơq ađó: “Pale kah mơ ve dyơq dhiq amei patơk nh'chró,” lơq N'drươh, n'lóóng tarung ađek yoot rang. <verse eid="MAT 21:19" /><verse number="20" style="v" sid="MAT 21:20" />Lêi kơi achêk hayơq, nôôq môôn-đô chrih lêi, móón: “Ng'kơi têêng hơq n'lóóng tarung ơi n'drươh yoot rang?” <verse eid="MAT 21:20" /><verse number="21" style="v" sid="MAT 21:21" />Hayơq xók ââi, Chuôq Jê-su praaq palơq piđó: “Alua, thêi praaq palơq adhi anó, la adhi anó ve lóóm huuiq lơq yươq paangra, nek adhi anó e chóóm têêng eh mơ rau ađô leq n'lóóng tarung, hơq patơk mơ la adhi anó kayua palơq bôôl ađô: ‘Phaai bâân tahayuur lơq bâân m'peq leq taxiiq,’ nek tarnêêng achêk e yuur vaaih. <verse eid="MAT 21:21" /><verse number="22" style="v" sid="MAT 21:22" />Dyóp rau, tabhơt nôôq dhơ dharau n'đó adhi anó mââl nhan kalóóng paraaq gavơh nhan, nek adhi anó e bâân đơơp xók huuiq ganơơm.”<verse eid="MAT 21:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 21:23" />Lơq xók Ađó ơi mót kalóóng đong bhanuôih, nôôq takóh kadhâng bhanuôih bhơt liêm palơq nôôq takóh bhươl kalóóng manưih dhanuôr tơk lum Ađó dyơq xók Ađó truuih pachóóm, tamóh: “N'đó tââq karơ mataai thêi têêng nôôq tarnêêng ađô? Lơq ngaai ơi đóng thêi karơ mataai achêk?” <verse eid="MAT 21:23" /><verse number="24" style="v" sid="MAT 21:24" />Bơơi buôn ââi paraaq, Chuôq Jê-su praaq palơq piđó: “Aku kung nek tamóh nôôq pe mưi xayar, hơq la nôôq pe ve chóóm ââi paraaq Aku, nek Aku kung e praaq đóng nôôq pe n'nal xók Aku têêng nôôq rau ađô n'đó tââq karơ mataai. <verse eid="MAT 21:24" /><verse number="25" style="v" sid="MAT 21:25" />Pheep bap-teem ưng Jang — pheep achêk nek n'đó tââq? Tââq pleng môôiq tââq akóón manưih?” Kơi achêk hayơq, piđó tapraaq palơq xóng piđó, kơi: “La nôôq he móón: ‘Tââq pleng,’ nek ađó e praaq palơq nôôq he: ‘Kơi achêk ơi taai hau hơq nôôq pe kah huuiq ađó?’ <verse eid="MAT 21:25" /><verse number="26" style="v" sid="MAT 21:26" />Hayơq la nôôq he ââi: ‘Tââq akóón manưih,’ nek nôôq he kakhin manưih dhanuôr, ơi tabhơt piđó lêi Jang nek mưi manưih đââng taruuih.” <verse eid="MAT 21:26" /><verse number="27" style="v" sid="MAT 21:27" />Hayơq xók ââi paraaq Chuôq Jê-su, piđó móón: “Nôôq yi kah n'nal.” Ađó kung ââi piđó: “Aku kung kah đóng nôôq pe n'nal Aku têêng nôôq tarnêêng ađô n'đó tââq karơ mataai. <verse eid="MAT 21:27" /><verse number="28" style="v" sid="MAT 21:28" />Kơi achêk bơơi, nôôq pe kanóq ng'kơi? Mưi chanak ve bơơr akóón padruuih, lơq xong xók tơk palơq chanak đu mưi, ađó kayua: ‘Avok ơơi, mađôk amei nek vôôiq têêng tarnêêng dhiq bhươn nho.’ <verse eid="MAT 21:28" /><verse number="29" style="v" sid="MAT 21:29" />Hơq xók ââi lóóiq, ađó móón: ‘Aku kah vôôiq,’ bơơi xong ađek, xók ơi dhơ karnóq, nek ađó vôôiq. <verse eid="MAT 21:29" /><verse number="30" style="v" sid="MAT 21:30" />Hayơq xong xók tơk lum chanak đu bơơr, akonh praaq i kơi achêk. Hayơq xók ââi paraaq, ađó móón: ‘Ve akóón, ơơq ama,’ hơq ađó ađek kah vôôiq. <verse eid="MAT 21:30" /><verse number="31" style="v" sid="MAT 21:31" />Ngaai kalóóng bơơr akóón padruuih ađek ơi têêng kơi karnóq kiêng ưng akonh ađêi?” Piđó ââi: “Chanak đu laloom.” Chuôq Jê-su praaq palơq piđó: “Alua, Aku móón nôôq pe kơi, nôôq đu pagoop jêên lơq pađiil baan achak vôôiq mót kalóóng katiêk ưng Yaang Pleng laloom nôôq pe. <verse eid="MAT 21:31" /><verse number="32" style="v" sid="MAT 21:32" />Ơi Jang ve bhral palơq nôôq pe kalóóng kalơng đu bhơt liêm, hơq nôôq pe kah huuiq ađó. Hayơq nôôq đu pagoop jêên lơq pađiil baan achak nek huuiq ađó. Bơơi nôôq pe, dhơ ve lêi, ơi kah klôôq lóóm xong ađek buôn huuiq ađó.<verse eid="MAT 21:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 21:33" />Nek xâng mưi babi lââng. Ve mưi chanak kala katiêk, nek manưih ơi choh mưi bhươn nho, têêng garóóng praang xirvir bhươn achêk, uôch bóng galiq buôh kalóóng ađek, têêng pơơq đương jư lơq đóng kabhuh choh nho mươn ađó, hayơq ađó vôôiq leq changaai. <verse eid="MAT 21:33" /><verse number="34" style="v" sid="MAT 21:34" />Xók achêk, mót bhêêl nil leh pale nho đan tơk, ađó kayua nôôq manưih dhơn ratơơq ađêi tơk palơq kabhuh choh nho buôn pei phơn pale bhakó ưng ađó. <verse eid="MAT 21:34" /><verse number="35" style="v" sid="MAT 21:35" />Hơq xók kadhâng jư kabhuh dhơn ratơơq ưng kala ơi, kabhuh choh nho m'bhiiq chanak ađô, leng chanak tôôh, glơm dhơl chanak atêêh. <verse eid="MAT 21:35" /><verse number="36" style="v" sid="MAT 21:36" />Ađó vil kayua nôôq dhơn ratơơq lââng tơk, bơk lơh kabhuh laloom, hơq piđó têêng palââng i kơi achêk. <verse eid="MAT 21:36" /><verse number="37" style="v" sid="MAT 21:37" />Hayơq tatun kiêt, ađó kayua chênh akóón padruuih ađêi tơk palơq piđó, kơi ađô: ‘Piđó e bhi chap akóón padruuih ađêi.’ <verse eid="MAT 21:37" /><verse number="38" style="v" sid="MAT 21:38" />Bơơi kabhuh choh nho, xong xók lêi chanak akóón achêk, ơi tapraaq palơq xóng piđó: ‘Ađô nek chanak đu đơơp drươp. Vêq, nôôq he phaai leng ađó hayơq pei pakala drươp karvaan ưng ađó.’ <verse eid="MAT 21:38" /><verse number="39" style="v" sid="MAT 21:39" />Bhêêl kadhâng jư chanak akóón hayơq, piđó m'peq ađó pagluh tââq bhươn nho lơq leng vóq. <verse eid="MAT 21:39" /><verse number="40" style="v" sid="MAT 21:40" />Kơi achêk, xók manưih kala bhươn nho tơk, ađó e hau têêng palơq kabhuh choh nho achêk?” <verse eid="MAT 21:40" /><verse number="41" style="v" sid="MAT 21:41" />Piđó móón palơq Chuôq: “Ađó achêk e leng tabhơt kabhuh lơt aak tôôh kơi janah ka-ai, hayơq e đóng nôôq manưih choh nho lââng têêng bhươn, nek nôôq manưih e goop lóóiq đóng ađó phơn pale malơơi mót nil leh ưng piđó.” <verse eid="MAT 21:41" /><verse number="42" style="v" sid="MAT 21:42" />Chuôq Jê-su praaq palơq piđó: “Kah alua nôôq pe kah glêh đok kalóóng Bha-aar Yaang Pleng:</para>
  <para style="q" vid="MAT 21:42">‘Khuk dhơl hơq nôôq thơơq têêng m'peq lơơi,</para>
  <para style="q" vid="MAT 21:42">ađó ơi bâân val xar dhơl đu tââm ưng n'tól đong.</para>
  <para style="q" vid="MAT 21:42">Tarnêêng ađô avaaih tơk tââq Chuôq,</para>
  <para style="q" vid="MAT 21:42">lơq ađó alua nek kre liêm kalóóng mat nôôq he?’<verse eid="MAT 21:42" /></para>
  <para style="b" />
  <para style="m">
    <verse number="43" style="v" sid="MAT 21:43" />Ơi taai ađôk, Aku praaq palơq nôôq pe kơi katiêk ưng Yaang Pleng e bâân pei ha-ơu tââq nôôq pe lơq e bâân đóng leq mưi dhanuôr chaq jơr bóóng pale ưng katiêk achêk. <verse eid="MAT 21:43" /><verse number="44" style="v" sid="MAT 21:44" />Ngaai kalơm pâng khuk dhơl ađô e bâân bhriq lêêk. Hayơq khuk dhơl n'tôq pâng ngaai dhiq, ađó e đươn lêêk manưih ađek.” <verse eid="MAT 21:44" /><verse number="45" style="v" sid="MAT 21:45" />Xong xók xâng nôôq paraaq babi ưng Ađó, nôôq takóh kadhâng bhanuôih bhơt liêm lơq nôôq manưih Pha-ri-si xâng n'nal kơi Chuôq xók praaq leq piđó. <verse eid="MAT 21:45" /><verse number="46" style="v" sid="MAT 21:46" />Xók tabâân kơi kóóp Chuôq, piđó vil nek kakhin kabhuh bơk, taai manưih dhanuôr lêi Chuôq nek mưi manưih đââng taruuih.<verse eid="MAT 21:46" /></para>
  <chapter eid="MAT 21" />
  <chapter number="22" style="c" sid="MAT 22" />
  <para style="p">
    <verse number="1" style="v" sid="MAT 22:1" />Lơq ââi lóóiq, Chuôq Jê-su mưi chu dyơq praaq palơq piđó lơq, paraaq babi kơi ađô: <verse eid="MAT 22:1" /><verse number="2" style="v" sid="MAT 22:2" />“Katiêk pleng bâân babi kơi mưi nak bhua, hơq bhua achêk ravang ravưa bhiêk nhan kađiêl đóng akóón padruuih ađêi. <verse eid="MAT 22:2" /><verse number="3" style="v" sid="MAT 22:3" />Bhua kayua nôôq dhơn ratơơq ưng ađêi vôôiq buôn yua nôôq manưih ơi bâân kayua vôôiq cha bhiêk, hơq palââng kah kiêng vôôiq. <verse eid="MAT 22:3" /><verse number="4" style="v" sid="MAT 22:4" />Bhua vil kayua nôôq dhơn ratơơq lââng, kơi ađô: ‘Phaai móón palơq nôôq manưih ơi bâân kayua: “Lêi tôôh, aku ơi dhoon bhiêk ưng aku. Nôôq karók lơq adhah ramaq ưng aku ơi bâân paxêêt, lơq dyóp rau ơi ravang lơơi. Nek vôôiq palơq cha bhiêk.”’ <verse eid="MAT 22:4" /><verse number="5" style="v" sid="MAT 22:5" />Bơơi piđó yuur xooq taai kah ming mang, manưih ađô gluh leq hare ađêi, manưih tôôh malóóm tơk tarnêêng têêng malơơi ưng ađêi. <verse eid="MAT 22:5" /><verse number="6" style="v" sid="MAT 22:6" />Hơq nôôq dyơq lóóiq, xong xók kadhâng jư nôôq dhơn ratơơq ưng bhua, nek praaq bharlưưk lơq leng vóq. <verse eid="MAT 22:6" /><verse number="7" style="v" sid="MAT 22:7" />Kơi achêk hayơq, bhua bâân kabhróónh, hayơq xong xók kayua linh ađêi vôôiq, ađó ơi đóng leng kabhuh leng manưih ađek lơq óch kanóón ưng piđó. <verse eid="MAT 22:7" /><verse number="8" style="v" sid="MAT 22:8" />Xong ađek, bhua kayua nôôq dhơn ratơơq ưng ađêi: ‘Dhơ bhiêk nhan mamaai ơi ravang lơơi, bơơi nôôq manưih glêh bâân kayua ađek nek kah ve đaang. <verse eid="MAT 22:8" /><verse number="9" style="v" sid="MAT 22:9" />Kơi achêk, nek vôôiq tơk nôôq charlah kalơng, hayơq la nôôq pe lum dhơ dhangaai dhơ dhamơ chanak, nek bhiêk kayua tơk cha bhiêk.’ <verse eid="MAT 22:9" /><verse number="10" style="v" sid="MAT 22:10" />Lơq nôôq dhơn ratơơq ađek, xong xók vôôiq leq dhiq nôôq paleh kalơng, ơi pajươk karong tabhơt nôôq ngaai hơq piđó lum, nôôq môôp palơq liêm, hayơq đong bhiêk ơi bâân bing libhleq nôôq manưih tamóói. <verse eid="MAT 22:10" /><verse number="11" style="v" sid="MAT 22:11" />Bơơi xók mót buôn lêi nôôq tamóói tơơt cha, bhua lêi mưi chanak tôôh kah xơp n'đóh kun aau cha bhiêk. <verse eid="MAT 22:11" /><verse number="12" style="v" sid="MAT 22:12" />Bhua móón manưih ađek: ‘Ni parjơơk, ng'kơi dhơq amei mót leq ađô chóóm kah ve kun aau cha bhiêk?’ Bơơi manưih ađek kah chóóm ââi. <verse eid="MAT 22:12" /><verse number="13" style="v" sid="MAT 22:13" />Tââq ađek, bhua kayua nôôq dhơn ratơơq: ‘Phaai klooiq têi dyung ưng manưih ađô lóóiq hayơq m'peq ađó leq dhiq kanam kajeem leq tôôh, dhiq e ve đu nhiim griit lơq takachik kaniêng.’ <verse eid="MAT 22:13" /><verse number="14" style="v" sid="MAT 22:14" />Ơi bơk manưih bâân dhaloong, bơơi m'bưưiq manưih bâân chââih.”<verse eid="MAT 22:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 22:15" />Bhêêl ađek, xong xók yuur xooq, nôôq manưih Pha-ri-si tapraaq chik mangê karnóq ng'kơi đóng piđó ve chóóm paxruuk Ađó kalóóng paraaq praaq. <verse eid="MAT 22:15" /><verse number="16" style="v" sid="MAT 22:16" />Piđó kayua nôôq môôn-đô ađêi, palơq nôôq manưih mađó kabhuh Hê-rôôt, tơk palơq Ađó, móón: “Thêi ơơi, nôôq yi n'nal kơi thêi nek manưih bhơt lóóm lơq truuih pachóóm ploong kalơng ưng Yaang Pleng palơq paraaq dhalam, lơq yươq ve rau bharni tơơt dhiq thêi leq bhơt dhơ dhangaai, ơi thêi yươq lêi dhiq hót nguôi ưng akóón manưih. <verse eid="MAT 22:16" /><verse number="17" style="v" sid="MAT 22:17" />Taai kơi achêk, nhan đóng nôôq yi n'nal thêi kanóq n'đó kơi? Ve chóóm goop jêên leq Sê-sa môôiq kah?” <verse eid="MAT 22:17" /><verse number="18" style="v" sid="MAT 22:18" />Bơơi taai ơi n'nal luônh lóóm môôp lơt ưng piđó, Chuôq Jê-su praaq: “Nôôq manưih mơ paliêm hót nguôi tôôh, hau nôôq pe klêêu aku? <verse eid="MAT 22:18" /><verse number="19" style="v" sid="MAT 22:19" />Nek đóng aku lêi đông jêên pagoop.” Piđó đââng leq Chuôq đông mưi đơ-ni-ê. <verse eid="MAT 22:19" /><verse number="20" style="v" sid="MAT 22:20" />Chuôq praaq palơq piđó: “A-ô lơq dhanóók achak ađô nek ưng ngaai?” <verse eid="MAT 22:20" /><verse number="21" style="v" sid="MAT 22:21" />Piđó ââi: “Ưng Sê-sa.” Bhêêl achêk, Chuôq praaq palơq piđó: “Kơi achêk, nek pachô leq Sê-sa nôôq dhơơm ưng Sê-sa, lơq leq Yaang Pleng nôôq dhơơm ưng Yaang Pleng.” <verse eid="MAT 22:21" /><verse number="22" style="v" sid="MAT 22:22" />Xong xók xâng paraaq achêk, piđó lóng chrih xâng, hayơq piđó yuur xooq, lơơi Ađó lóóiq.<verse eid="MAT 22:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 22:23" />Mót tangêi achêk, nôôq manưih Sa-đu-sê tơk pađan Ađó, taai đóók móón nek kah ve rau mamông lóóiq, hayơq piđó ơi tamóh Ađó, <verse eid="MAT 22:23" /><verse number="24" style="v" sid="MAT 22:24" />kơi ađô: “Thêi ơơi, Môôi-se móón: ‘La mưi chanak ngaai ađek chêt xók kah ve akóón, nek adhi padruuih manưih achêk e pei kađiêl ưng anó lơq n'niên akóón leq anó ưng ađêi.’ <verse eid="MAT 22:24" /><verse number="25" style="v" sid="MAT 22:25" />Bơơi m'pơng nôôq yi ve tapól adhi anó padruuih, manưih taha tââm, xong xók bâân kađiêl, nek ơi chêt. Lơq ađó lơơi lóóiq kađiêl ưng ađó leq adhi ađêi xók kah ve akóón. <verse eid="MAT 22:25" /><verse number="26" style="v" sid="MAT 22:26" />Manưih đu bơơr hayơq manưih đu pe, patơk manưih đu tapól, kung kơi achêk. <verse eid="MAT 22:26" /><verse number="27" style="v" sid="MAT 22:27" />Hayơq tatun leq xariêq, manưih pađiil kung chêt. <verse eid="MAT 22:27" /><verse number="28" style="v" sid="MAT 22:28" />Kơi achêk, kalóóng tangêi mamông lóóiq, ađó e nek kađiêl ưng ngaai kalóóng tapól adhi anó? Ơi tabhơt piđó ơi pei ađó.” <verse eid="MAT 22:28" /><verse number="29" style="v" sid="MAT 22:29" />Bơơi xók ââi, Chuôq Jê-su praaq palơq piđó: “Nôôq pe talơt xraang aq, taai kah n'nal Bha-aar Yaang Pleng palơq mataai raman ưng Yaang Pleng. <verse eid="MAT 22:29" /><verse number="30" style="v" sid="MAT 22:30" />Ơi xók mamông lóóiq, palââng kah nhan kađiêl kung kah đóng akóón. Bơơi piđó nek thê kơi nôôq dhơn pleng dhiq pleng. <verse eid="MAT 22:30" /><verse number="31" style="v" sid="MAT 22:31" />Dyơq leq mamông lóóiq ưng đu chêt, nôôq pe kah glêh đok paraaq ơi bâân Yaang Pleng praaq palơq ađêi, kơi ađô: <verse eid="MAT 22:31" /><verse number="32" style="v" sid="MAT 22:32" />‘Aku nek Yaang Pleng ưng Ap-ra-haam, Yaang Pleng ưng I-saak lơq Yaang Pleng ưng Ja-kôôp’? Yaang Pleng eh rau nek ưng đu chêt, bơơi nek ưng manưih mamông.” <verse eid="MAT 22:32" /><verse number="33" style="v" sid="MAT 22:33" />Bhêêl xâng kơi achêk, manưih dhanuôr lóng chrih xâng leq paraaq pachóóm ưng Ađó.<verse eid="MAT 22:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 22:34" />Hayơq nôôq manưih Pha-ri-si xong xók xâng kơi Ađó ơi têêng nôôq manưih Sa-đu-sê pat paraaq, nek ơi karong madhiq palơq xóng piđó. <verse eid="MAT 22:34" /><verse number="35" style="v" sid="MAT 22:35" />Mưi chanak kalóóng nôôq piđó, nek manưih pachóóm gani, ơi tamóh buôn klêêu Ađó — <verse eid="MAT 22:35" /><verse number="36" style="v" sid="MAT 22:36" />“Nhan tamóh thêi, n'đó gani pachóóm gamak tââm kalóóng gani?” <verse eid="MAT 22:36" /><verse number="37" style="v" sid="MAT 22:37" />Hayơq Ađó praaq palơq ađó ađek: “‘Phaai bhi nh'nhơr Chuôq, nek Yaang Pleng ưng akóón, palơq tabhơt tââq lóóm akóón, palơq tabhơt ravaai akóón lơq tabhơt karnóq akóón.’ <verse eid="MAT 22:37" /><verse number="38" style="v" sid="MAT 22:38" />Ađek nek gani pachóóm gamak lơq đu akiiq tââm. <verse eid="MAT 22:38" /><verse number="39" style="v" sid="MAT 22:39" />Hayơq gani pachóóm đu bơơr kung thê kơi achêk — ‘Phaai nh'nhơr manưih đan tóór ưng akóón kơi achak araang ađêi.’ <verse eid="MAT 22:39" /><verse number="40" style="v" sid="MAT 22:40" />Tabhơt dyóp gani lơq nôôq manưih đââng taruuih bâân tamưng dhiq bơơr gani pachóóm ađô.”<verse eid="MAT 22:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="MAT 22:41" />Xók achêk, xong xók nôôq manưih Pha-ri-si bâân karong palơq xóng piđó, Chuôq Jê-su tamóh piđó, <verse eid="MAT 22:41" /><verse number="42" style="v" sid="MAT 22:42" />kơi ađô: “Nôôq pe kanóq ng'kơi leq Chuôq Paq Manưih? Ađó nek akóón ưng ngaai?” Piđó ââi Ađó: “Ưng bhua Đa-viit.” <verse eid="MAT 22:42" /><verse number="43" style="v" sid="MAT 22:43" />Chuôq praaq palơq piđó: “Kơi achêk ng'kơi chóóm hơq Đa-viit, kalóóng Yaang Liêm, đóók Ađó nek Chuôq, xók praaq:<verse eid="MAT 22:43" /></para>
  <para style="q">
    <verse number="44" style="v" sid="MAT 22:44" />‘Chuôq praaq palơq Chuôq aku:</para>
  <para style="q" vid="MAT 22:44">“Phaai tơơt dhiq hót tươm Aku,</para>
  <para style="q" vid="MAT 22:44">patơk xók bhêêl Aku patơơt nôôq manưih brau ưng akóón raal dyung akóón”’?<verse eid="MAT 22:44" /></para>
  <para style="b" />
  <para style="m">
    <verse number="45" style="v" sid="MAT 22:45" />Kơi achêk la Đa-viit đóók Ađó nek ‘Chuôq,’ nek ng'kơi chóóm Ađó nek akóón bhua achêk?” <verse eid="MAT 22:45" /><verse number="46" style="v" sid="MAT 22:46" />Kah ngaai ve chóóm ââi lóóiq Ađó parleh parlâ, kung kah mưi chanak chanâ khin tamóh Ađó dyơq tư tââq tangêi vaar ađek.<verse eid="MAT 22:46" /></para>
  <chapter eid="MAT 22" />
  <chapter number="23" style="c" sid="MAT 23" />
  <para style="p">
    <verse number="1" style="v" sid="MAT 23:1" />Tââq ađek, Chuôq Jê-su praaq palơq manưih dhanuôr lơq nôôq môôn-đô ađêi, <verse eid="MAT 23:1" /><verse number="2" style="v" sid="MAT 23:2" />kơi ađô: “Nôôq manưih pachóóm gani lơq nôôq manưih Pha-ri-si tơơt dhiq tanơơt ưng Môôi-se. <verse eid="MAT 23:2" /><verse number="3" style="v" sid="MAT 23:3" />Taai ađek, la piđó truuih pachóóm adhi anó tabhơt dhơ dharau, nek yuur têêng lơq đuui jư tabhơt. Bơơi óóq ting têêng nôôq tarnêêng lơt ưng piđó, ơi piđó praaq hơq kah têêng. <verse eid="MAT 23:3" /><verse number="4" style="v" sid="MAT 23:4" />Piđó pagưi nôôq ganưi haleng haluq lơq hadhơơp gưi, hayơq piđó chalôôm dhiq charlaang palââng, bơơi ađêi kala piđó kah kiêng paveq chabô têi ađêi leq ađek. <verse eid="MAT 23:4" /><verse number="5" style="v" sid="MAT 23:5" />Piđó têêng dyóp tarnêêng ưng ađêi đóng bâân palââng lêi. Ơi piđó têêng nôôq trap kađôôq bha-aar gani ưng ađêi đóng pagamak lơq têêng nôôq grưưi aau ađêi đóng payaal. <verse eid="MAT 23:5" /><verse number="6" style="v" sid="MAT 23:6" />Piđó lóng kiêng dhiq dham đu yaal tââm kalóóng bhiêk đaam, lơq nôôq dhiq tơơt bhi chap tââm kalóóng đong gươl, <verse eid="MAT 23:6" /><verse number="7" style="v" sid="MAT 23:7" />palơq nôôq paraaq chap yayar dhiq manưih bơk dhiq chơơq, lơq bâân dhanuôr manưih đóók ađêi nek ‘Ra-bi.’ <verse eid="MAT 23:7" /><verse number="8" style="v" sid="MAT 23:8" />Bơơi adhi anó kah chóóm đóng đóók ađêi nek ‘Ra-bi,’ ơi thêi ưng adhi anó chapiên ve mưi, hayơq tabhơt adhi anó nek bhóng ađêi. <verse eid="MAT 23:8" /><verse number="9" style="v" sid="MAT 23:9" />Lơq adhi anó óóq đóók bhơt dhơ dhangaai dhiq katiêk nek ‘ama’ ơi adhi anó chapiên ve mưi Ama dhiq pleng. <verse eid="MAT 23:9" /><verse number="10" style="v" sid="MAT 23:10" />Kung óóq đóng ađêi bâân đóók nek ‘kala tavaaih,’ ơi kala tavaaih ưng adhi anó chapiên ve mưi — hơq nek Chuôq Paq Manưih. <verse eid="MAT 23:10" /><verse number="11" style="v" sid="MAT 23:11" />Bơơi manưih gamak tââm dhiq kalóóng adhi anó e nek dhơn ratơơq adhi anó. <verse eid="MAT 23:11" /><verse number="12" style="v" sid="MAT 23:12" />Hayơq ngaai tư hayuur ađêi payaal e bâân bhlêh pa-êêp; lơq ngaai tư pa-êêp ađêi e bâân hayuur payaal.<verse eid="MAT 23:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 23:13" />Bơơi ayô ka-er đóng nôôq pe, nôôq manưih pachóóm gani lơq manưih Pha-ri-si, kabhuh paliêm hót nguôi tôôh! Taai nôôq pe kađơp palóng katiêk pleng lóóiq toom mat palââng. Ơi nôôq pe nek kah mót kalóóng, kung kah lơơi đóng ngaai bâân ting jađaang mót leq kalóóng. <verse eid="MAT 23:13" /><verse number="14" style="v" sid="MAT 23:14" />(Ayô ka-er đóng nôôq pe, nôôq manưih pachóóm gani lơq manưih Pha-ri-si, kabhuh paliêm dhiq bóóp tôôh! Taai nôôq pe đah galuôn đong nôôq dharit kamaai, hơq gavơh nhan kơi pađươnh val vôôiq kalóóng galơơk pathê. Ơi taai achêk, nôôq pe e đơơp bha-aar patu haleng lơh.) <verse eid="MAT 23:14" /><verse number="15" style="v" sid="MAT 23:15" />Ayô ka-er đóng nôôq pe, nôôq manưih pachóóm gani lơq manưih Pha-ri-si, kabhuh paliêm hót nguôi tôôh! Taai nôôq pe vôôiq praang taxiiq palơq katiêk góh buôn têêng đóng mưi chanak ting taruuih ađêi, lơq xók manưih ađek ơi val xar kơi achêk, nôôq pe hajuuk têêng manưih achêk xar panong akóón ưng bóng óih lơh bơơr chu nôôq pe.<verse eid="MAT 23:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 23:16" />Ayô ka-er đóng nôôq pe, nôôq đu đââng kalơng kabaang kapôk, hơq nek nôôq đu móón: ‘Ngaai đu ng'kóh taai đong bhanuôih nek yươq rau kơi. Bơơi ngaai đu ng'kóh taai vaang ưng đong bhanuôih achêk nek mơk dhakơi.’ <verse eid="MAT 23:16" /><verse number="17" style="v" sid="MAT 23:17" />Nôôq đu ngôôk abhưưl lơq kabhuh kabaang kapôk tôôh! Ơi n'đó rau nek kiiq lơh, vaang môôiq đong bhanuôih têêng vaang bâân liêm? <verse eid="MAT 23:17" /><verse number="18" style="v" sid="MAT 23:18" />Hayơq vil: ‘Ngaai đu ng'kóh taai para bhanuôih nek yươq rau kơi. Bơơi ngaai đu ng'kóh taai bhanuôih hót piing para bhanuôih nek achêk dhakơi mơk.’ <verse eid="MAT 23:18" /><verse number="19" style="v" sid="MAT 23:19" />Nôôq đu ngôôk abhưưl lơq kabhuh kabaang kapôk tôôh! Ơi n'đó rau kiiq lơh, bhanuôih môôiq para bhanuôih têêng bhanuôih bâân liêm? <verse eid="MAT 23:19" /><verse number="20" style="v" sid="MAT 23:20" />Taai ađek, ngaai ơi ng'kóh taai para bhanuôih nek ng'kóh taai para bhanuôih lơq taai dyóp rau hót piing ađek. <verse eid="MAT 23:20" /><verse number="21" style="v" sid="MAT 23:21" />Ngaai ơi ng'kóh tââq đong bhanuôih nek ng'kóh tââq đong bhanuôih lơq tââq Yaang jaq kalóóng ađek. <verse eid="MAT 23:21" /><verse number="22" style="v" sid="MAT 23:22" />Lơq ngaai ơi ng'kóh tââq pleng nek ng'kóh tââq tanơơt ưng Yaang Pleng lơq tââq Yaang jaq dhiq ađek.<verse eid="MAT 23:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 23:23" />Ayô ka-er đóng nôôq pe, nôôq manưih pachóóm gani lơq manưih Pha-ri-si, kabhuh paliêm hót nguôi tôôh! Ơi nôôq pe goop maphơn majêt bak ha, thi-la lơq bhơơi kơng, hơq palơh lơơi nôôq rau đu kiiq lơh ưng gani — hơq nek rau bhơt liêm, lóóm ka-er kayô lơq rau bhơt lóóm. Kơi lââng, achêk nek rau đu tââm buôn yuur têêng nôôq tarnêêng ađô, lơq yươq palơh lơơi nôôq tarnêêng tôôh. <verse eid="MAT 23:23" /><verse number="24" style="v" sid="MAT 23:24" />Kabhuh đââng kalơng kabaang kapôk tôôh, hơq nek nôôq đu dyreng m'peq mưi panong raróói katưưiq katit, bơơi galuôn lơh mưi panong kamel!<verse eid="MAT 23:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 23:25" />Ayô ka-er đóng nôôq pe, nôôq manưih pachóóm gani lơq manưih Pha-ri-si, kabhuh paliêm hót nguôi tôôh! Ơi nôôq pe kaxaal pasek hót nguôi ưng choom lơq dhia, bơơi hót kalóóng nek piđó bing rau n'drooih pei lơq mak mơ. <verse eid="MAT 23:25" /><verse number="26" style="v" sid="MAT 23:26" />Nôôq manưih Pha-ri-si abhơơm kabaang tôôh! Laloom kơ, phaai kaxaal pasek hót kalóóng choom lơq dhia, buôn hót nguôi ưng piđó kung val xar sek se.<verse eid="MAT 23:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 23:27" />Ayô ka-er đóng nôôq pe, nôôq manưih pachóóm gani lơq manưih Pha-ri-si, kabhuh paliêm hót nguôi tôôh! Ơi nôôq pe thê nôôq beq ping bâân n'dha tabhóók, nek nôôq rau dhơ pakah liêm kra hót nguôi, bơơi hót kalóóng nek bing ng'haang ng'glóng manưih chêt lơq dyóp rau khung anhuq. <verse eid="MAT 23:27" /><verse number="28" style="v" sid="MAT 23:28" />Kung tarvaai thê kơi achêk, dhơ hót nguôi nôôq pe lóng thê bhơt liêm nek palơq palââng, bơơi hót kalóóng nôôq pe nek bing keen galơơk chachââr lơq kah magani.<verse eid="MAT 23:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 23:29" />Ayô ka-er đóng nôôq pe, nôôq manưih pachóóm gani lơq manưih Pha-ri-si, kabhuh paliêm hót nguôi tôôh! Ơi nôôq pe têêng ping agrup ưng nôôq manưih đââng taruuih lơq klôôq paliêm ping xaal ưng nôôq manưih bhơt liêm. <verse eid="MAT 23:29" /><verse number="30" style="v" sid="MAT 23:30" />Nôôq pe móón: ‘La nôôq yi tơơt kalóóng klaang ưng nôôq abhươp avuôq ađêi, hơq dhakơi nek nôôq yi ơi kah têêng nôôq đu ting tapâng palơq piđó dhiq ahaam ưng nôôq manưih đââng taruuih.’ <verse eid="MAT 23:30" /><verse number="31" style="v" sid="MAT 23:31" />Kơi achêk hayơq, nôôq pe tư truuih móón leq ađêi kơi ađêi nek akóón chachau ưng nôôq đu ơi leng nôôq manưih đââng taruuih, <verse eid="MAT 23:31" /><verse number="32" style="v" sid="MAT 23:32" />lơq nôôq pe nek têêng liêm bing m'beq bhanang matu aak ưng abhươp avuôq ađêi! <verse eid="MAT 23:32" /><verse number="33" style="v" sid="MAT 23:33" />Kabhuh kaxênh chapââr tôôh, dhong nooi ưng kaxênh karviêng, nôôq pe e mut paloh tââq rau xanêi janah ưng bóng óih palơq n'đó kơi? <verse eid="MAT 23:33" /><verse number="34" style="v" sid="MAT 23:34" />Ơi taai rau ađô, nek lêi tôôh, aku kayua nôôq manưih đââng taruuih, manưih tabech galang lơq manưih pachóóm gani bhral palơq nôôq pe. Tââq m'pơng kalóóng piđó, nôôq pe e leng chêt lơq teeng đinh, kung tââq m'pơng kalóóng piđó, nôôq pe e m'bhiiq vei kalóóng nôôq đong gươl ađêi lơq viêng dharuuh tââq kanóón ađô tơk kanóón tôôh, <verse eid="MAT 23:34" /><verse number="35" style="v" sid="MAT 23:35" />ng'kơi đóng ve chóóm tơk dhiq nôôq pe tabhơt ahaam bhơt liêm ơi bâân tantoh dhiq katiêk, tââq ahaam ưng A-bêên, manưih bhơt liêm, patơk ahaam ưng Xa-cha-ri, akóón padruuih Ba-ra-chi, manưih hơq nôôq pe ơi leng chêt m'pơng đong bhanuôih lơq para bhanuôih. <verse eid="MAT 23:35" /><verse number="36" style="v" sid="MAT 23:36" />Alua, aku praaq palơq nôôq pe, dyóp tarnêêng ađek e avaaih tơk dhiq klaang đơơi ađôk.<verse eid="MAT 23:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="MAT 23:37" />Jê-ru-sa-leem, Jê-ru-sa-leem, amei ơi leng chêt nôôq manưih đââng taruuih lơq glơm dhơl nôôq manưih bâân kayua tơk palơq amei! N'đó mơ chu aku kiêng panhoom karong akóón anaaq ưng amei lóóiq, ting kơi hơq atưưch kan kakrok akóón ađêi dhiq nanang, hơq amei kah đươi! <verse eid="MAT 23:37" /><verse number="38" style="v" sid="MAT 23:38" />Lêi nô, đong ưng nôôq pe e bâân lơơi lóóiq bhahi bhatoong đóng nôôq pe. <verse eid="MAT 23:38" /><verse number="39" style="v" sid="MAT 23:39" />Ơi aku praaq palơq nôôq pe, nôôq pe dhơ dhakơi e kah lêi Aku tââq ađôk patơk xók bhêêl nôôq pe praaq: ‘Bhi haanh Yaang bhral kalóóng dhanóók Chuôq!’”<verse eid="MAT 23:39" /></para>
  <chapter eid="MAT 23" />
  <chapter number="24" style="c" sid="MAT 24" />
  <para style="p">
    <verse number="1" style="v" sid="MAT 24:1" />Xong xók gluh tââq đong bhanuôih, Chuôq Jê-su yuur vôôiq kơơq. Hayơq nôôq môôn-đô Ađó tơk đan buôn chaleq đóng Ađó lêi nôôq tarnêêng ưng đong bhanuôih. <verse eid="MAT 24:1" /><verse number="2" style="v" sid="MAT 24:2" />Bơơi xók ââi lóóiq, Chuôq móón piđó: “Adhi anó kah ve lêi dyóp rau ađek alua? Alua, thêi praaq palơq adhi anó, dhiq ađôk dhơ dhakơi e kah ve dyơq bhangôh dhơl ađô dhiq bhangôh dhơl tôôh hơq kah pâng pahư haglêh.”<verse eid="MAT 24:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 24:3" />Xók achêk, xók Ađó dyơq tơơt dhiq bôôl Ô-liiu, nôôq môôn-đô vôôiq n'tua pađan Ađó tamóh: “Nhan đóng nôôq yi n'nal n'đó bhêêl nôôq rau tarnêêng achêk e yuur avaaih, lơq pakanal xók bhral ưng thêi lơq ưng tangêi marngi bhơt nek hau?” <verse eid="MAT 24:3" /><verse number="4" style="v" sid="MAT 24:4" />Xók ââi, Chuôq Jê-su praaq palơq piđó: “Phaai chagơn buôn yươq ngaai ve chóóm têêng đóng adhi anó lơt xraang. <verse eid="MAT 24:4" /><verse number="5" style="v" sid="MAT 24:5" />Ơi bơk ngaai e bhral kalóóng dhanóók thêi, đóók: ‘Aku nek Chuôq Paq Manưih,’ lơq e têêng đóng bơk manưih lơt xraang. <verse eid="MAT 24:5" /><verse number="6" style="v" sid="MAT 24:6" />Kơi lââng, adhi anó ravang xâng leq tarvei tarjeng lơq nôôq taruuih đââr leq tarvei tarjeng. Adhi anó phaai hêch lêi, óóq ting nhok karnóq, ơi tarnêêng achêk phaai yuur vaaih, bơơi kah ơi alua nek tatun xariêq. <verse eid="MAT 24:6" /><verse number="7" style="v" sid="MAT 24:7" />Ơi dhanuôr ađô e yuur vaaih jơl lóóiq dhanuôr tôôh, katiêk ađô huông lóóiq katiêk tôôh, hayơq e ve ha-ul cha lơq dha-ơr katiêk vaaih bơk dhiq. <verse eid="MAT 24:7" /><verse number="8" style="v" sid="MAT 24:8" />Bơơi tabhơt nôôq tarnêêng ađô nek hơq tââp tarnââp ưng nôôq garluh ka-ai ayaai ravang n'niên akóón. <verse eid="MAT 24:8" /><verse number="9" style="v" sid="MAT 24:9" />Tââq ađek, palââng e đââng adhi anó leq xâng jarnah xarngaat hayơq leng adhi anó vóq, lơq adhi anó e bâân dyóp dhanuôr gaam geet ơi taai dhanóók thêi. <verse eid="MAT 24:9" /><verse number="10" style="v" sid="MAT 24:10" />Hayơq bơk ngaai e bâân têêng lơt, tamôôp xóng ađêi lơq gaam geet xóng ađêi. <verse eid="MAT 24:10" /><verse number="11" style="v" sid="MAT 24:11" />Bơk manưih đââng taruuih chachââr e bâân yuur vaaih lơq têêng đóng bơk ngaai lơt xraang. <verse eid="MAT 24:11" /><verse number="12" style="v" sid="MAT 24:12" />Taai yuur vaaih kah magani nek n'dhương bơk, lóóm tanhơr ưng bơk ngaai e nek achriêt <verse eid="MAT 24:12" /><verse number="13" style="v" sid="MAT 24:13" />Bơơi ngaai mưng lóóm patơk tatun xariêq, manưih ađek e bâân paq. <verse eid="MAT 24:13" /><verse number="14" style="v" sid="MAT 24:14" />Taruuih Liêm ađô leq katiêk pleng e bâân truuih đuui plok dhiq talaang katiêk buôn têêng mưi paraaq truuih đóng dyóp dhanuôr, lơq hayơq rau tatun xariêq e tơk.<verse eid="MAT 24:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 24:15" />Taai ađek, xók adhi anó lêi rau harek haper rau dhơơm bhahi bhaha, nek rau ơi Đa-ni-êên manưih đââng taruuih loom paraaq, patơơt dhiq kalóóng liêm” (ngaai đok phaai n'nal), <verse eid="MAT 24:15" /><verse number="16" style="v" sid="MAT 24:16" />“Bhêêl ađek, ngaai kalóóng parah Ju-đê phaai mut klôôn tơk parah kakóóng, <verse eid="MAT 24:16" /><verse number="17" style="v" sid="MAT 24:17" />ngaai tơơt dhiq pabhung đong, óóq vôôiq dhaluônh buôn pei ve rau tââq đong ađêi, <verse eid="MAT 24:17" /><verse number="18" style="v" sid="MAT 24:18" />lơq ngaai tơơt dhiq hare óóq val chô buôn pei aau chaguôk ađêi. <verse eid="MAT 24:18" /><verse number="19" style="v" sid="MAT 24:19" />Bơơi alua xaryô đóng manưih pađiil bhaq đađââng lơq nôôq ngaai xók đóng akóón mam kalóóng nôôq tangêi ađek! <verse eid="MAT 24:19" /><verse number="20" style="v" sid="MAT 24:20" />Bơơi phaai gavơh nhan buôn rau mut kadrêi ưng adhi anó óóq yuur vaaih xók nil ha-ót, môôiq pâng tangêi Sa-baat. <verse eid="MAT 24:20" /><verse number="21" style="v" sid="MAT 24:21" />Ơi bhêêl achêk e ve rau bhrê hư gamak, kah glêh yuur vaaih thê kơi achêk tââq bhêêl tââp tarnââp pleng katiêk patơk tangêi ađôk, lơq dhakơi kung e kah ve. <verse eid="MAT 24:21" /><verse number="22" style="v" sid="MAT 24:22" />La nôôq tangêi achêk kah chóóm ha-ơt, hơq dhakơi nek dyóp achak araang nek kah bâân paq. Bơơi ơi taai nôôq manưih bâân chââih, nôôq tangêi ađek e bâân n'dhương bil. <verse eid="MAT 24:22" /><verse number="23" style="v" sid="MAT 24:23" />Bhêêl ađek, la ve ngaai ađek móón palơq adhi anó: ‘Lêi tôôh, Chuôq Paq Manưih tơơt dhiq ađô!’ môôiq ‘Tơơt dhiq tôôh!’ nek adhi anó óóq huuiq. <verse eid="MAT 24:23" /><verse number="24" style="v" sid="MAT 24:24" />Ơi nôôq chuôq paq galơơk palơq nôôq manưih đââng taruuih galơơk e bâân yuur vaaih lơq pakah nôôq kanal palơq nôôq raman chrih gamak bhlơng tơk mơ têêng đóng lơt xraang, la ve đuôh, chênh nôôq manưih bâân chââih. <verse eid="MAT 24:24" /><verse number="25" style="v" sid="MAT 24:25" />Lêi nô, Aku ơi praaq loom leq adhi anó ađek. <verse eid="MAT 24:25" /><verse number="26" style="v" sid="MAT 24:26" />Kơi achêk, la palââng móón palơq adhi anó: ‘Lêi tôôh, Ađó xók dhiq kalóóng kruung vơng,’ nek adhi anó kah chóóm vôôiq leq ađek. Môôiq ‘Lêi nô, dhiq nôôq buông lââp,’ nek adhi anó kah chóóm huuiq. <verse eid="MAT 24:26" /><verse number="27" style="v" sid="MAT 24:27" />Ơi briil kamlaaq yuur chaach tââq charhóóng mat blo hayơq bliich brương tơk dhiq charhóóng mat blót n'đó kơi, nek rau bhral tơk ưng Akóón Manưih e nek kơi achêk. <verse eid="MAT 24:27" /><verse number="28" style="v" sid="MAT 24:28" />Hơq n'đó dhiq ve xaak chêt, kêên-kêên prơu lóóiq dhiq ađek.<verse eid="MAT 24:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 24:29" />Bơơi chênh xong garluh bhrê hư ưng nôôq tangêi ađek, mat tangêi e bâân têêng đóng kanam kajeem, mat bharương e kah klaaq kalaaq brương ưng ađó, nôôq chatur xamenh e tââq pleng ruuh n'tôq, lơq nôôq kataai karơ ưng nôôq klaang pleng e bâân veq dha-ơr. <verse eid="MAT 24:29" /><verse number="30" style="v" sid="MAT 24:30" />Bhêêl ađek, kanal leq Akóón Manưih e bâân pakah dhiq talaang pleng, lơq hayơq tabhơt nôôq dhanuôr manưih dhiq katiêk e kalau nhiim. Piđó e lêi Akóón Manưih bhral dhiq nôôq garboq dhaluk pleng palơq mataai raman lơq cha-iil tabah gamak. <verse eid="MAT 24:30" /><verse number="31" style="v" sid="MAT 24:31" />Ađó e kayua nôôq dhơn pleng ưng Ađó nek palơq dhariêng karyóól karơ, lơq piđó e karong kaboq lóóiq nôôq manưih bâân chââih ưng Ađó tââq puôn charhóóng, tââq xriêq parah pleng ađô tơk leq xariêq parah pleng tôôh.<verse eid="MAT 24:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 24:32" />Kơq lââng, phaai hok n'nal paraaq babi ađô tââq n'lóóng tarung. Xók đóóng ađó val xar ramaanh lơq ơi chamat axơq, nek adhi anó n'nal kơi nil hapaang đan tơk. <verse eid="MAT 24:32" /><verse number="33" style="v" sid="MAT 24:33" />Kung ting kơi ađek, xók adhi anó lêi dyóp rau ađô, nek adhi anó n'nal kơi Ađó xók tơơt đan, dhalam dhiq palóng. <verse eid="MAT 24:33" /><verse number="34" style="v" sid="MAT 24:34" />Alua, Aku praaq palơq adhi anó, kơi klaang đơơi ađô dhơ dhakơi e kah lơh bil patơk xók bhêêl tabhơt nôôq rau achêk ơi yuur vaaih. <verse eid="MAT 24:34" /><verse number="35" style="v" sid="MAT 24:35" />Pleng lơq katiêk e lơh bil, bơơi nôôq paraaq ưng thêi dhơ dhakơi e kah lơh bil. <verse eid="MAT 24:35" /><verse number="36" style="v" sid="MAT 24:36" />Dyơq tapâng tơk leq tangêi lơq jơ ađek nek kah ngaai n'nal, dhơ bhơt nôôq dhơn pleng dhiq pleng môôiq Akóón, chapiên Ama hơq giêl. <verse eid="MAT 24:36" /><verse number="37" style="v" sid="MAT 24:37" />Bơơi klaang Nô-ê n'đó kơi, nek rau bhral ưng Akóón Manưih e nek kung kơi achêk. <verse eid="MAT 24:37" /><verse number="38" style="v" sid="MAT 24:38" />Ơi kơi kalóóng nôôq tangêi n'loom garluh đơơk tuh, palââng biêh cha ơm, póói đóng patơk tangêi Nô-ê mót kalóóng bhuông, <verse eid="MAT 24:38" /><verse number="39" style="v" sid="MAT 24:39" />lơq piđó kah n'nal patơk bhêêl đơơk tuh tơk lơq palóóng piđó lóóng — rau bhral ưng Akóón Manưih kung e nek kơi achêk. <verse eid="MAT 24:39" /><verse number="40" style="v" sid="MAT 24:40" />Bhêêl achêk, bơơr chanak padruuih xók tơơt dhiq hare — mưi chanak bâân đââng vôôiq, mưi chanak bâân lơơi lóóiq. <verse eid="MAT 24:40" /><verse number="41" style="v" sid="MAT 24:41" />Bơơr pađiil xók xe tapal — mưi chanak bâân đââng vôôiq, mưi chanak bâân lơơi lóóiq. <verse eid="MAT 24:41" /><verse number="42" style="v" sid="MAT 24:42" />Taai kơi achêk, phaai hêch lêi ơi adhi anó kah n'nal n'đó bhêêl tangêi Chuôq ađêi e bhral. <verse eid="MAT 24:42" /><verse number="43" style="v" sid="MAT 24:43" />Bơơi adhi anó phaai n'nal tarnêêng ađô, kơi la kala đong ơi n'nal manưih tatông bhral xók n'đó bhêêl ưng hayum, hơq dhakơi nek ađó chêk ơi đương hêch lơq nek kah lơơi đóng đong ađêi bâân đu tatông mót. <verse eid="MAT 24:43" /><verse number="44" style="v" sid="MAT 24:44" />Ơi taai rau ađô, adhi anó kung phaai val xar ravang lơơi, ơi Akóón Manưih e bhral xók bhêêl adhi anó kah bharnê.<verse eid="MAT 24:44" /></para>
  <para style="p">
    <verse number="45" style="v" sid="MAT 24:45" />Hayơq, ngaai nek dhơn ratơơq bhơt lóóm lơq tabech galang, hơq kala chaleq patơơt jư lêi dhiq manưih đong ưng kala buôn đóng blah tarmông leq piđó mót dhalam xók vaar? <verse eid="MAT 24:45" /><verse number="46" style="v" sid="MAT 24:46" />Phươk đóng nek manưih dhơn ratơơq ađek, nek manưih hơq kala ưng ađó, xong tââq chô, e lêi ađó xók matêêng kơi achêk. <verse eid="MAT 24:46" /><verse number="47" style="v" sid="MAT 24:47" />Alua, thêi praaq palơq adhi anó, kơi kala e patơơt đóng ađó ađek jư lêi dhiq dyóp rau đu kala ve. <verse eid="MAT 24:47" /><verse number="48" style="v" sid="MAT 24:48" />Bơơi la chanak dhơn ratơơq lơt aak ađek praaq kalóóng lóóm ađêi: ‘Kala aku kah bhênh chô,’ <verse eid="MAT 24:48" /><verse number="49" style="v" sid="MAT 24:49" />hayơq nek yuur m'bhiiq póh nôôq manưih mađó nek dhơn ratơơq palơq ađêi, hơq cha ơm palơq kabhuh ból alak, <verse eid="MAT 24:49" /><verse number="50" style="v" sid="MAT 24:50" />nek manưih kala ưng chanak dhơn ratơơq ađek e chô xók tangêi hơq ađó kah rââm đương lơq xók bhêêl hơq ađó kah n'nal. <verse eid="MAT 24:50" /><verse number="51" style="v" sid="MAT 24:51" />Abhươp achêk e m'bhiiq lêêk achak ađó kơi kah ka-er lơq e patơơt dham ưng ađó madhiq palơq kabhuh paliêm hót nguôi giêl, dhiq dham ađek e ve đu nhiim griit lơq kakreet kaniêng.<verse eid="MAT 24:51" /></para>
  <chapter eid="MAT 24" />
  <chapter number="25" style="c" sid="MAT 25" />
  <para style="p">
    <verse number="1" style="v" sid="MAT 25:1" />Kơi achêk, katiêk pleng e bâân babi kơi majêt pađiil kamór, nek nôôq manưih kadhâng đong dhơu ađêi yuur vôôiq tơk dham đương kêch chaxaau. <verse eid="MAT 25:1" /><verse number="2" style="v" sid="MAT 25:2" />Bơơi xââng chanak kalóóng nôôq piđó nek ngôôk, lơq xââng chanak nek tabech. <verse eid="MAT 25:2" /><verse number="3" style="v" sid="MAT 25:3" />Ơi xââng chanak ngôôk, xong xók kadhâng đong dhơu ưng piđó vôôiq, ơi kah đââng dhơu ting palơq ađêi. <verse eid="MAT 25:3" /><verse number="4" style="v" sid="MAT 25:4" />Hayơq nôôq pađiil tabech nek ơi đââng dhơu ting kalóóng toq nek palơq đong dhơu ađêi. <verse eid="MAT 25:4" /><verse number="5" style="v" sid="MAT 25:5" />Xók achêk, taai chaxaau kah bhênh bhral, tabhơt piđó ơi val xar bêch ngangơơt hayơq bêch kơơq. <verse eid="MAT 25:5" /><verse number="6" style="v" sid="MAT 25:6" />Bơơi mót m'pơng hayum, ve dhariêng dhaloong: ‘Tôôh, chaxaau bhral! Nek vôôiq gluh tơk pơh kêch ađó.’ <verse eid="MAT 25:6" /><verse number="7" style="v" sid="MAT 25:7" />Bhêêl ađek, tabhơt nôôq pađiil kamór achêk bâân payuur blââk lơq ravang ravưa dhơu ađêi. <verse eid="MAT 25:7" /><verse number="8" style="v" sid="MAT 25:8" />Xók achêk, nôôq pađiil ngôôk móón palơq nôôq pađiil tabech: ‘Nhan đóng nôôq yi mưi phơn dhơu ưng nôôq pe, taai dhơu ưng nôôq yi kiêng pat.’ <verse eid="MAT 25:8" /><verse number="9" style="v" sid="MAT 25:9" />Bơơi xók ââi lóóiq, nôôq pađiil tabech móón: ‘Kakhin nek e kah mơ chóóm ve dyóp đóng nôôq yi lơq nôôq pe. Nh'jang tha, nek vôôiq tơk nôôq manưih baan dhơu hơq kơl leq ađêi.’ <verse eid="MAT 25:9" /><verse number="10" style="v" sid="MAT 25:10" />Dhơ kơi ađek, xók bhêêl piđó vôôiq kơl, chaxaau ơi bhral, lơq nôôq ngaai ravang lơơi nek palơq chaxaau hơq mót kalóóng cha đaam bhiêk, hayơq palóng bâân kađơp lóóiq. <verse eid="MAT 25:10" /><verse number="11" style="v" sid="MAT 25:11" />Hayơq xong ađek, nôôq pađiil kamór tôôh kung tơk, móón: ‘Kala ơơi, Kala ơơi, Nhan lóng palóng leq nôôq yi.’ <verse eid="MAT 25:11" /><verse number="12" style="v" sid="MAT 25:12" />Bơơi xók ââi lóóiq, kala praaq: ‘Alua, aku praaq palơq nôôq pe, aku kah n'nal nôôq pe.’ <verse eid="MAT 25:12" /><verse number="13" style="v" sid="MAT 25:13" />Kơi achêk, phaai đương meh, ơi adhi anó kah n'nal tangêi môôiq jơ.<verse eid="MAT 25:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 25:14" />Ơi thê kơi mưi chanak ravang vôôiq changaai, Ađó ơi dhaloong nôôq dhơn ratơơq ưng ađêi lóóiq lơq pajaau piđó drươp karvaan ưng ađó. <verse eid="MAT 25:14" /><verse number="15" style="v" sid="MAT 25:15" />Ađó đóng manưih ađô xââng ta-lơng, manưih tôôh bơơr ta-lơng manưih lââng dyơq mưi ta-lơng — nek palơq dyóp chanak ting mơ ađêi đuôh têêng. Hayơq ađó n'drươh yuur vôôiq leq changaai. <verse eid="MAT 25:15" /><verse number="16" style="v" sid="MAT 25:16" />Xók ađó ơi vôôiq, manưih đơơp xââng ta-lơng ơi têêng malơơi tââq jêên ađek lơq ve bâân xââng ta-lơng lââng. <verse eid="MAT 25:16" /><verse number="17" style="v" sid="MAT 25:17" />Kung kơi ađek, manưih ve bơơr ta-lơng kung ve bâân bơơr ta-lơng lââng. <verse eid="MAT 25:17" /><verse number="18" style="v" sid="MAT 25:18" />Bơơi manưih ơi đơơp mưi ta-lơng, xong ơi vôôiq gluh, ơi uôch katiêk lơq kadrêi jêên ưng kala ađêi. <verse eid="MAT 25:18" /><verse number="19" style="v" sid="MAT 25:19" />Xók achêk, xong mưi ganah đươnh, kala ưng nôôq manưih dhơn ratơơq achêk chô lơq yaap bha-aar bhatơ palơq piđó. <verse eid="MAT 25:19" /><verse number="20" style="v" sid="MAT 25:20" />Xong xók tơk đan, manưih đơơp xââng ta-lơng ơi đââng xââng ta-lơng lââng, móón kơi ađô: ‘Abhươp ơơi, abhươp ơi pajaau leq aku xââng ta-lơng. Bơơi nhan lêi nô, aku ơi têêng malơơi kơơq xââng ta-lơng.’ <verse eid="MAT 25:20" /><verse number="21" style="v" sid="MAT 25:21" />Kala ưng ađó praaq palơq ađó: ‘Chóóm bhlơng, amei dhơn ratơơq liêm kre lơq bhơt lóóm! Amei ơi bhơt lóóm dhiq nôôq tarnêêng. Aku e patơơt amei lêi kadhâng dhiq bơk tarnêêng. Nek mót kalóóng đu bhuui ưng kala ađêi.’ <verse eid="MAT 25:21" /><verse number="22" style="v" sid="MAT 25:22" />Manưih ve bơơr ta-lơng, xong xók tơk đan, kung ơi móón: ‘Abhươp ơơi, abhươp ơi pajaau leq aku bơơr ta-lơng, bơơi nhan lêi nô, aku ơi têêng malơơi kơơq bơơr ta-lơng.’ <verse eid="MAT 25:22" /><verse number="23" style="v" sid="MAT 25:23" />Kala ưng ađó praaq palơq ađó: ‘Chóóm bhlơng, amei dhơn ratơơq liêm kre lơq bhơt lóóm! Amei ơi bhơt lóóm dhiq nôôq tarnêêng. Aku e patơơt amei kadhâng lêi dhiq bơk tarnêêng. Nek mót kalóóng đu bhuui ưng kala ađêi.’ <verse eid="MAT 25:23" /><verse number="24" style="v" sid="MAT 25:24" />Hayơq manưih đơơp mưi ta-lơng, kung vôôiq tơk, ơi móón: ‘Abhươp ơơi, aku n'nal amei, kơi amei nek mưi manưih kơi praaq kơi têêng, xóót tââq dham ađêi kah chóói lơq karong chô tââq dham ađêi kah gluh vươk. <verse eid="MAT 25:24" /><verse number="25" style="v" sid="MAT 25:25" />Taai kakhin kapơn, hayơq xong xók vôôiq gluh, aku ơi kadrêi ta-lơng ưng amei dhiq katiêk. Nhan lêi nô, amei pakala phơn ưng ađêi.’ <verse eid="MAT 25:25" /><verse number="26" style="v" sid="MAT 25:26" />Bơơi bhêêl ââi lóóiq, manưih kala ưng ađó achêk praaq palơq ađó: ‘Tadhươm dhơn ratơơq lơt aak lơq đu dyââng tôôh! Amei biêh ơi n'nal kơi aku xóót tââq dham aku kah chóói lơq karong chô tââq dham aku kah gluh vươk. <verse eid="MAT 25:26" /><verse number="27" style="v" sid="MAT 25:27" />Kơi achêk nek, parpâng amei kơng phaai đââng lơơi jêên ưng aku dhiq đong jêên, hayơq xong xók chô, hơq dhakơi nek aku e đơơp lóóiq bhôôn ưng aku palơq jêên lơơi. <verse eid="MAT 25:27" /><verse number="28" style="v" sid="MAT 25:28" />Kơi achêk, phaai pei ta-lơng tââq tadhươm ađô lơq đóng ađó leq manưih đu ve majêt ta-lơng. <verse eid="MAT 25:28" /><verse number="29" style="v" sid="MAT 25:29" />Ơi palơq manưih xók ve, nek dyóp rau e bâân đóng kơơq — patơk mơ e bâân xưa raai. Bơơi nek palơq manưih kah ve, nek chênh rau ađó ve e bâân pei paxooq tââq ađó. <verse eid="MAT 25:29" /><verse number="30" style="v" sid="MAT 25:30" />Lơq nek m'peq tadhươm dhơn ratơơq kah matich ađek leq dhiq kanam kajeem hót nguôi, nek dhiq e ve nhiim griit lơq takachik kaniêng.’<verse eid="MAT 25:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 25:31" />Dyơq bhêêl Akóón Manưih bhral kalóóng brương cha-iil Ađó lơq tabhơt dhơn pleng nek palơq Ađó, nek xók achêk, Ađó e tơơt dhiq tanơơt brương cha-iil ađêi. <verse eid="MAT 25:31" /><verse number="32" style="v" sid="MAT 25:32" />Tabhơt nôôq dhanuôr e bâân karong toom mat Ađó, lơq Ađó e blah pantua palơq xóng piđó, kơi ngóq manưih jư blah pantua trưưu gluh tââq beeq. <verse eid="MAT 25:32" /><verse number="33" style="v" sid="MAT 25:33" />Ađó e lơơi trưưu tơơt hót atươm ađêi, hayơq beeq tơơt hót ađaai. <verse eid="MAT 25:33" /><verse number="34" style="v" sid="MAT 25:34" />Xong ađek, Bhua e móón nôôq ngaai tơơt hót atươm ađêi: ‘Nôôq manưih ơi bâân Ama Aku đóng phươk, tơk leq ađô, nek đơơp katiêk ơi bâân pasam lơơi đóng ađêi tââq bhêêl tââp tavaaih pleng katiêk. <verse eid="MAT 25:34" /><verse number="35" style="v" sid="MAT 25:35" />Ơi Aku ha-ul, nek nôôq akóón đóng Aku cha; Aku rahaal, nek nôôq akóón đóng Aku ơm; Aku nek tamóói chrih, nek nôôq akóón pơh yaauq Aku; <verse eid="MAT 25:35" /><verse number="36" style="v" sid="MAT 25:36" />Aku lalôh lalut, nek nôôq akóón paxơp đóng Aku; Aku ka-ai dreh, nek nôôq akóón gamang Aku; Aku tơơt kalóóng đong kanam, nek nôôq akóón tơk palơq Aku.’ <verse eid="MAT 25:36" /><verse number="37" style="v" sid="MAT 25:37" />Xók achêk, nôôq manưih bhơt liêm e ââi lóóiq Ađó, kơi ađô: ‘Kakoh Chuôq, nôôq akóón ve dhơq lêi Amei ha-ul hơq đóng cha, môôiq nek rahaal hơq đóng ơm n'đó bhêêl dhơq? <verse eid="MAT 25:37" /><verse number="38" style="v" sid="MAT 25:38" />Hayơq nôôq akóón ơi lêi Amei kơi tamóói chrih hơq pơh yaauq, môôiq lalôh lalut hơq paxơp đóng n'đó bhêêl dhơq? <verse eid="MAT 25:38" /><verse number="39" style="v" sid="MAT 25:39" />Lơq nôôq akóón ơi lêi Amei ka-ai dreh môôiq tơơt kalóóng đong kanam n'đó bhêêl hơq tơk palơq Amei?’ <verse eid="MAT 25:39" /><verse number="40" style="v" sid="MAT 25:40" />Xók ââi bóóp, Bhua e praaq palơq piđó: ‘Alua Aku praaq palơq nôôq akóón, lêi dhiq dyóp tarnêêng nôôq akóón ơi têêng đóng mưi kalóóng nôôq manưih paniên katưưiq tââm dhiq nôôq adhi anó ađô ưng Aku, nek nôôq akóón ơi têêng leq Aku.’ <verse eid="MAT 25:40" /><verse number="41" style="v" sid="MAT 25:41" />Hayơq nek, Bhua kung e praaq nôôq đu tơơt hót ađaai: ‘Nek xooq changaai tââq Aku, nôôq đu bâân ngi tóh tôôh, malóóm leq óih tơk nh'chró ơi pasam lơơi đóng abhưi abhóch lơq nôôq abhưi dhơn ưng ađó. <verse eid="MAT 25:41" /><verse number="42" style="v" sid="MAT 25:42" />Ơi Aku ha-ul hơq nôôq pe kah đóng Aku cha; Aku rahaal hơq nôôq pe kah đóng Aku ơm; <verse eid="MAT 25:42" /><verse number="43" style="v" sid="MAT 25:43" />Aku nek tamóói chrih, hơq nôôq pe kah pơh yaauq Aku; lalôh lalut nek nôôq pe kah paxơp đóng Aku; ka-ai dreh lơq tơơt kalóóng đong kanam, nek nôôq pe kah gamang Aku.’ <verse eid="MAT 25:43" /><verse number="44" style="v" sid="MAT 25:44" />Xók achêk, piđó kung e ââi, kơi ađô: ‘Chuôq ơơi, nôôq akóón mơq lêi Amei ha-ul, môôiq rahaal, môôiq kơi tamóói chrih, môôiq lalôh lalut, môôiq ka-ai dreh, môôiq tơơt kalóóng đong kanam n'đó bhêêl hơq kah têêng yaauq Amei?’ <verse eid="MAT 25:44" /><verse number="45" style="v" sid="MAT 25:45" />Kơi achêk hayơq, Bhua e ââi bóóp piđó, kơi ađô: ‘Alua, Aku praaq palơq nôôq pe, dhiq dyóp rau tarnêêng nôôq pe ơi kah têêng đóng mưi nak kalóóng nôôq manưih paniên katưưiq tââm dhiq nôôq manưih ađô, nek nôôq pe ơi kah têêng đóng Aku.’ <verse eid="MAT 25:45" /><verse number="46" style="v" sid="MAT 25:46" />Nôôq manưih ađek e vôôiq mót leq rau janah dyơq yayóóng, hayơq nôôq manưih bhơt liêm nek mót leq parmông tơk nh'chró.”<verse eid="MAT 25:46" /></para>
  <chapter eid="MAT 25" />
  <chapter number="26" style="c" sid="MAT 26" />
  <para style="p">
    <verse number="1" style="v" sid="MAT 26:1" />Tarnêêng yuur vaaih xók Chuôq Jê-su ơi xong luch tabhơt nôôq paraaq ađek, Ađó móón nôôq môôn-đô ađêi: <verse eid="MAT 26:1" /><verse number="2" style="v" sid="MAT 26:2" />“Adhi anó n'nal nek bơơr tangêi dyơq e tơk bhiêk Jalơh, lơq Akóón Manưih e bâân pajaau buôn đơơp teeng đinh dhiq n'lóóng m'baang chatông.” <verse eid="MAT 26:2" /><verse number="3" style="v" sid="MAT 26:3" />Xók achêk, nôôq takóh kadhâng bhanuôih bhơt liêm lơq nôôq takóh bhươl kalóóng manưih dhanuôr ơi bâân trong nhoom dhiq đong ưng takóh kadhâng bhanuôih bhơt liêm, achak nek Kaai-phe. <verse eid="MAT 26:3" /><verse number="4" style="v" sid="MAT 26:4" />Piđó palơq xóng ađêi tapraaq buôn piđó ve chóóm lơq mangê kơi kóóp kadhuông Chuôq Jê-su lơq leng Ađó vóq. <verse eid="MAT 26:4" /><verse number="5" style="v" sid="MAT 26:5" />Bơơi piđó móón: “Kah chóóm kalóóng tangêi bhiêk, óóq đóng yuur vaaih nhôôn nhaauq dhiq m'pơng manưih dhanuôr.”<verse eid="MAT 26:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 26:6" />Xók achêk, xók Chuôq Jê-su ơi tơơt dhiq Bê-tha-ni kalóóng đong Si-môôn, manưih ka-ai tơơt bhơơi, <verse eid="MAT 26:6" /><verse number="7" style="v" sid="MAT 26:7" />mưi manưih pađiil đââng m'beq klóng ngok kađôôq rau dhơu thum mat jêên bhlơng tơk đan Ađó, lơq pađiil ađek n'toh leq koq Ađó, dyơq xók tơơt chacha. <verse eid="MAT 26:7" /><verse number="8" style="v" sid="MAT 26:8" />Bơơi xong xók lêi kơi achêk, nôôq môôn-đô vaaih kabhróónh, móón: “Ng'kơi dhơq chóóm ra-uôh kơi ađô? <verse eid="MAT 26:8" /><verse number="9" style="v" sid="MAT 26:9" />Ơi dhơu ađô ve chóóm baan bâân bơk jêên lơq poor jóói đóng manưih ngeeo.” <verse eid="MAT 26:9" /><verse number="10" style="v" sid="MAT 26:10" />Bơơi n'nal rau ađô, Chuôq Jê-su móón piđó: “Hau adhi anó têêng pagei manưih pađiil ađô? Ơi ađó nek têêng mưi tarnêêng liêm leq thêi. <verse eid="MAT 26:10" /><verse number="11" style="v" sid="MAT 26:11" />Bơơi adhi anó taluôn ve manưih ngeeo tơơt palơq ađêi, bơơi eh rau adhi anó taluôn ve thêi. <verse eid="MAT 26:11" /><verse number="12" style="v" sid="MAT 26:12" />Ơi xók pađiil n'toh dhơu ađô leq chak thêi, ađó ơi têêng kơi chêk đóng tarnêêng tơp thêi. <verse eid="MAT 26:12" /><verse number="13" style="v" sid="MAT 26:13" />Alua, thêi praaq palơq adhi anó, hơq n'đó dhiq Taruuih Liêm ađô bâân yuur truuih dhiq plok talaang katiêk, nek tarnêêng pađiil ađô ơi têêng kung e bâân praaq tơk dhiq rau katiêu hei leq ađó.”<verse eid="MAT 26:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 26:14" />Bhêêl ađek, mưi nak kalóóng majêt bơơr sưưq-đô, achak nek Ju-đa Ich-ka-ri-ôôt, xong xók vôôiq tơk palơq nôôq takóh kala kadhâng bhanuôih, <verse eid="MAT 26:14" /><verse number="15" style="v" sid="MAT 26:15" />ơi móón: “Nôôq pe ve lóóm chróót leq aku ađó mơ, hayơq aku e đââng pajaau manưih achêk đóng nôôq pe?” Kơi achêk nek piđó kơng đóng ađó pe jêt parleh baak. <verse eid="MAT 26:15" /><verse number="16" style="v" sid="MAT 26:16" />Lơq tââq ganah ađek, ađó tââp tabâân bhêêl bâân buôn ve chóóm kóóp pajaau Ađó.<verse eid="MAT 26:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 26:17" />Xók achêk, mót tangêi đu laloom bhiêk Beng kah Mapiêng, nôôq môôn-đô tơk đan Chuôq Jê-su, tamóh: “Thêi kiêng nôôq yi ravang lơơi đóng thêi cha bhiêk Jalơh n'đó dhiq?” <verse eid="MAT 26:17" /><verse number="18" style="v" sid="MAT 26:18" />Hayơq Ađó yua: “Nek vôôiq mót kanóón, tơk palơq mưi chanak achêk lơq móón palơq ađó: ‘Thêi praaq: “Gani ưng thêi nek xók đan tơk; thêi e têêng bhiêk Jalơh dhiq đong amei nek palơq nôôq môôn-đô thêi.”’” <verse eid="MAT 26:18" /><verse number="19" style="v" sid="MAT 26:19" />Nôôq môôn-đô têêng kơi Chuôq Jê-su chaleq kađââng piđó, lơq piđó ravang lơơi bhiêk Jalơh.<verse eid="MAT 26:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 26:20" />Xók achêk, xók habu blót tơk, Ađó tơơt cha nek palơq majêt bơơr sưưq-đô. <verse eid="MAT 26:20" /><verse number="21" style="v" sid="MAT 26:21" />Xók piđó dyơq chacha, Ađó praaq: “Alua, thêi praaq palơq adhi anó, kơi mưi chanak kalóóng adhi anó e baan thêi.” <verse eid="MAT 26:21" /><verse number="22" style="v" sid="MAT 26:22" />Piđó ranguôq rangóót bhlơng, ting chanak manưih tââq ađek tamóh palơq Ađó: “Chuôq ơơi, eh rau nek aku alua?” <verse eid="MAT 26:22" /><verse number="23" style="v" sid="MAT 26:23" />Bơơi buôn ââi bóóp, Ađó praaq: “Manưih đu tuq têi ađêi leq kalóóng dhia mađó palơq thêi, manưih ađek e baan thêi. <verse eid="MAT 26:23" /><verse number="24" style="v" sid="MAT 26:24" />Dhơ Akóón Manưih e yuur vôôiq, ting kơi paraaq ơi bâân xaraq leq Ađó, bơơi ayô ka-er đóng manưih achêk, taai ađó hơq Akóón Manưih bâân tabaan! La manưih achêk nh'jang óóq bâân n'niên nek liêm lơh đóng ađó.” <verse eid="MAT 26:24" /><verse number="25" style="v" sid="MAT 26:25" />Bơơi xók ââi lóóiq, Ju-đa, manưih baan Ađó, móón: “Thêi ơơi, ve kơq nek aku?” Chuôq praaq palơq ađó: “Amei nek tư móón ơi.”<verse eid="MAT 26:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 26:26" />Xók achêk, xók piđó dyơq chacha, xók pei beng lơq ơi ma-ơơn, Chuôq Jê-su ơi veh beng. Lơq xong xók pađơơp leq nôôq môôn-đô, Ađó praaq: “Nek pei đơơp, cha nek. Ađô nek achak araang ưng Aku.” <verse eid="MAT 26:26" /><verse number="27" style="v" sid="MAT 26:27" />Lơq bhêêl pei choom lơq ơi ma-ơơn, Ađó ơi pađơơp leq piđó, praaq: “Tabhơt nek ơm dhiq choom ađô. <verse eid="MAT 26:27" /><verse number="28" style="v" sid="MAT 26:28" />Ơi ađô nek ahaam raket bóóp ưng thêi bâân tantoh nek palơq bơk manưih đóng leq rau tarlơơi matu lơt. <verse eid="MAT 26:28" /><verse number="29" style="v" sid="MAT 26:29" />Bơơi thêi praaq palơq adhi anó tư tââq bhêêl đôk thêi dhơ dhakơi e kah ơm đơơk nho ađô, patơk tangêi achêk, nek bhêêl hơq thêi ơm đơơk nho tame madhiq palơq adhi anó kalóóng katiêk ưng Ama thêi.”<verse eid="MAT 26:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="MAT 26:30" />Xong xók babóóch chaxuul, piđó yuur vôôiq đơk leq bôôl Ô-liiu. <verse eid="MAT 26:30" /><verse number="31" style="v" sid="MAT 26:31" />Bhêêl ađek, Chuôq Jê-su praaq palơq piđó: “Chênh kalóóng hayum đôk, tabhơt adhi anó e bâân n'đóih kalơm dhiq thêi, ơi paraaq ve bâân xaraq:</para>
  <para style="q" vid="MAT 26:31">‘Aku e m'bhiiq manưih jư</para>
  <para style="q" vid="MAT 26:31">hayơq trưưu ưng kanan e bâân xooq gloong.’<verse eid="MAT 26:31" /></para>
  <para style="b" />
  <para style="m">
    <verse number="32" style="v" sid="MAT 26:32" />Hayơq xong xók thêi bâân têêng mamông lóóiq, thêi e vôôiq loom adhi anó tơk Ga-li-lê.”<verse eid="MAT 26:32" /></para>
  <para style="b" />
  <para style="m">
    <verse number="33" style="v" sid="MAT 26:33" />Bơơi ââi lóóiq, Phi-e-rơ móón palơq Ađó: “Dhơ tabhơt e bâân n'đóih kalơm taai thêi, bơơi aku e kah ve mơ n'đóih kalơm.” <verse eid="MAT 26:33" /><verse number="34" style="v" sid="MAT 26:34" />Chuôq Jê-su praaq palơq ađó: “Alua, thêi praaq palơq amei, kơi chênh kalóóng hayum ađô, kah ơi atưưch takar, amei e dyiin thêi pe chu.” <verse eid="MAT 26:34" /><verse number="35" style="v" sid="MAT 26:35" />Phi-e-rơ móón palơq Ađó: “Patơk mơ la patu aku phaai chêt palơq thêi, dhơ dhakơi aku e kah dyiin thêi.” Lơq tabhơt nôôq môôn-đô kung praaq i kơi achêk.<verse eid="MAT 26:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="MAT 26:36" />Xong ađek, Chuôq Jê-su vôôiq nek palơq piđó tơk mưi dhiq bâân đóók nek Gêêt-sê-ma-nê, lơq Ađó móón nôôq môôn-đô: “Phaai tơơt dhiq ađôk bhluuch bhêêl thêi vôôiq leq tôôh gavơh nhan.” <verse eid="MAT 26:36" /><verse number="37" style="v" sid="MAT 26:37" />Xong xók đââng Phi-e-rơ ting lơq bơơr akóón padruuih ưng Xê-bê-đê, Ađó yuur vaaih ka-ai ranguôq lơq nhok karnóq. <verse eid="MAT 26:37" /><verse number="38" style="v" sid="MAT 26:38" />Bhêêl ađek, Ađó praaq palơq piđó: “Ravaai thêi xók ranguôq rangóót bhlơng patơk chêt. Phaai tơơt lóóiq dhiq ađôk lơq đương meh madhiq palơq thêi.” <verse eid="MAT 26:38" /><verse number="39" style="v" sid="MAT 26:39" />Xók ơi vôôiq changaai m'bưưiq dyơq, Ađó chip mat ađêi leq katiêk gavơh nhan lơq móón: “Ama ưng akóón ơơi, la rau ađô nek ve chóóm, nhan đóng choom ađô lơh tââq Akóón. Dhơ kơi achêk, eh kơi Akóón kiêng, hơq nek kơi Ama.” <verse eid="MAT 26:39" /><verse number="40" style="v" sid="MAT 26:40" />Hayơq Ađó tơk palơq nôôq môôn-đô lơq lêi piđó dyơq bêch, nek Ađó praaq palơq Phi-e-rơ: “Kơi achêk nek, adhi anó kah chóóm đuôh đương blââk palơq thêi mơ machên alua? <verse eid="MAT 26:40" /><verse number="41" style="v" sid="MAT 26:41" />Phaai đương blââk lơq gavơh nhan buôn adhi anó yươq bâân mơk dharơơl galơơk. Dhơ karnóq lóóm nek kiêng bhlơng, hơq achak araang nek druôi nhưh.” <verse eid="MAT 26:41" /><verse number="42" style="v" sid="MAT 26:42" />Mưi chu dyơq, xók vôôiq lơh mót chu đu bơơr, Ađó gavơh nhan, kơi ađô: “Ama ưng Akóón ơơi, la chiên ađô kah ve đuôh chóóm lơh, la nek Akóón ơm choom achêk, nek nhan karnóq Ama bâân liêm.” <verse eid="MAT 26:42" /><verse number="43" style="v" sid="MAT 26:43" />Xong xók val machu dyơq, Ađó lêi piđó dyơq bêch, ơi mat piđó ơi bâân jarliiq haleng. <verse eid="MAT 26:43" /><verse number="44" style="v" sid="MAT 26:44" />Lơq mưi chu dyơq, xong xók lơơi piđó lóóiq hayơq vôôiq, Ađó gavơh nhan mót chu đu pe, praaq palơq nôôq paraaq kơi achêk dyơq. <verse eid="MAT 26:44" /><verse number="45" style="v" sid="MAT 26:45" />Xong ađek, Ađó tơk palơq nôôq môôn-đô lơq praaq palơq piđó: “Adhi anó bhiêk dyơq bêch lơq dhêi drơq alua? Lêi tôôh, jơ ơi đan tơk, lơq Akóón Manưih xók bâân pajaau leq têi nôôq đu matu lơt. <verse eid="MAT 26:45" /><verse number="46" style="v" sid="MAT 26:46" />Nek yuur dyương, nôôq he chóóm vôôiq aq. Lêi ađô, đu baan thêi ơi ruul bhral.”<verse eid="MAT 26:46" /></para>
  <para style="p">
    <verse number="47" style="v" sid="MAT 26:47" />Xók Ađó bhiêk dyơq papraaq, nek lêi tôôh, Ju-đa, mưi nak kalóóng majêt bơơr sưưq-đô, bhral, hơq mandrươh palơq ađó nek mưi kabhuh manưih bơk bhlơng palơq bhươt lơq tarlââng, tư tââq nôôq takóh kadhâng bhanuôih bhơt liêm lơq nôôq takóh bhươl kalóóng manưih dhanuôr. <verse eid="MAT 26:47" /><verse number="48" style="v" sid="MAT 26:48" />Xók achêk, đu baan Chuôq ơi đóng piđó mưi kanal, kơi ađô: “N'đó manưih hơq aku chum nek chênh manưih ađek. Nek kóóp ađó achêk.” <verse eid="MAT 26:48" /><verse number="49" style="v" sid="MAT 26:49" />N'drươh, xong xók tơk đan Chuôq Jê-su, ađó móón: “Nhan chap yayar Ra-bi!” hayơq ađó chum Ađó. <verse eid="MAT 26:49" /><verse number="50" style="v" sid="MAT 26:50" />Bơơi Chuôq Jê-su praaq palơq ađó: “Parjơơk ơơi, ơi tarnêêng ađô hơq amei tơk leq ađôk.” Tââq ađek, xong xók tơk đan, palââng kóóp kadhâng dhiq Chuôq Jê-su lơq kóóp jư Ađó. <verse eid="MAT 26:50" /><verse number="51" style="v" sid="MAT 26:51" />Lơq lêi tôôh, mưi kalóóng nôôq manưih vôôiq palơq Chuôq Jê-su, hayuur têi ơi thuôt pagluh bhươt ađêi lơq têch chanak dhơn ratơơq ưng takóh kadhâng bhanuôih bhơt liêm, tatươt katór ưng ađó ađô. <verse eid="MAT 26:51" /><verse number="52" style="v" sid="MAT 26:52" />Bhêêl ađek, Chuôq Jê-su kayua manưih achêk: “Nek ha-ơu lóóiq bhươt ưng amei leq xóór ưng ađó, ơi tabhơt nôôq ngaai kadhâng bhươt e chêt taai bhươt. <verse eid="MAT 26:52" /><verse number="53" style="v" sid="MAT 26:53" />Môôiq amei ngóq kơi thêi kah ve mataai dhaloong gavơh Ama thêi, hayơq Ađó e kayua bhral n'drươh leq thêi lơh majêt bơơr kabhuh dhơn pleng môôiq kơq? <verse eid="MAT 26:53" /><verse number="54" style="v" sid="MAT 26:54" />Kơi achêk nek, ng'kơi chóóm nôôq paraaq Bha-aar Yaang Pleng bâân tajaap, kơi chiên ađô phaai yuur vaaih kơi achêk?” <verse eid="MAT 26:54" /><verse number="55" style="v" sid="MAT 26:55" />Mót bhêêl ađek, Chuôq Jê-su praaq palơq kabhuh bơk: “Nôôq pe vôôiq gluh nek palơq bhươt lơq tarlââng dhuui buôn kóóp aku kơi jơl lóóiq mưi nak tatông alua? Dyóp tangêi, aku tơơt truuih pachóóm kalóóng đong bhanuôih hơq nôôq pe vil kah kóóp aku. <verse eid="MAT 26:55" /><verse number="56" style="v" sid="MAT 26:56" />Bơơi dyóp tarnêêng ađô yuur vaaih buôn nôôq bha-aar xaraq ưng nôôq manưih đââng taruuih ve chóóm bâân tajaap.” Bhêêl ađek, xók ơi lơơi Ađó lóóiq, tabhơt nôôq môôn-đô ơi mut klôôn.<verse eid="MAT 26:56" /></para>
  <para style="p">
    <verse number="57" style="v" sid="MAT 26:57" />Xók achêk, nôôq đu kóóp Chuôq Jê-su ơi đââng Ađó tơk leq Kaai-phe takóh kadhâng bhanuôih bhơt liêm, nek dhiq hơq nôôq manưih pachóóm gani lơq nôôq takóh bhươl bâân nhoom karong palơq xóng piđó. <verse eid="MAT 26:57" /><verse number="58" style="v" sid="MAT 26:58" />Hayơq Phi-e-rơ vôôiq ting Chuôq tââq changaai tơk leq taang ưng takóh kala kadhâng bhanuôih. Xók ơi mót leq kalóóng, ađó tơơt madhiq palơq kabhuh linh đương jư buôn lêi xariêq ng'kơi. <verse eid="MAT 26:58" /><verse number="59" style="v" sid="MAT 26:59" />Xók achêk, nôôq takóh kadhâng bhanuôih bhơt liêm lơq tabhơt Kabhuh Xêi Xanêi xók tabâân paraaq lơt jơl lóóiq Chuôq Jê-su, ng'kơi đóng piđó ve chóóm patu bâân leng Ađó. <verse eid="MAT 26:59" /><verse number="60" style="v" sid="MAT 26:60" />Lơq piđó kah tarting tabâân rau, dhơ bơk đu yuur dyương truuih móón chachââr. Bơơi xong ađek, ve bơơr chanak ruul đơk, <verse eid="MAT 26:60" /><verse number="61" style="v" sid="MAT 26:61" />ơi praaq: “Manưih ađô ơi yuur praaq: ‘Aku ve chóóm têêng pahư đong bhanuôih ưng Yaang Pleng lơq têêng kadhơng lóóiq kalóóng pe tangêi.’” <verse eid="MAT 26:61" /><verse number="62" style="v" sid="MAT 26:62" />Xong xók yuur dyương, takóh kadhâng bhanuôih bhơt liêm móón Ađó: “Amei kah rau ââi alua? Nôôq manưih ađô xók truuih móón jơl lóóiq amei harau chiên kơi tôôh?” <verse eid="MAT 26:62" /><verse number="63" style="v" sid="MAT 26:63" />Bơơi Chuôq Jê-su parngau. Takóh kadhâng bhanuôih bhơt liêm praaq palơq Ađó: “Taai Yaang Pleng taluôn mamông, aku kayua amei buôn amei praaq đóng nôôq yi n'nal ve kơq amei ve alua nek Chuôq Paq Manưih, Akóón Yaang Pleng môôiq eh?” <verse eid="MAT 26:63" /><verse number="64" style="v" sid="MAT 26:64" />Chuôq Jê-su praaq palơq ađó: “Chênh amei ơi tư praaq kơi achêk. Dhơ kơi achêk, aku praaq đóng nôôq pe n'nal, tư tââq bhêêl ađô, nôôq pe e lêi Akóón Manưih tơơt hót têi atươm ưng Yaang Mataai Karơ, lơq tơk tabhral dhiq nôôq garboq dhaluk pleng.” <verse eid="MAT 26:64" /><verse number="65" style="v" sid="MAT 26:65" />Bhêêl achêk, takóh kadhâng bhanuôih bhơt liêm ơi n'teek aau yaal ađêi móón: “Ađó praaq chalô! Hau nôôq he hayơq kơng manưih đu truuih dyơq? Tôôh tôôh, xók đôk nôôq pe ơi xâng paraaq praaq chalô achêk ơi. <verse eid="MAT 26:65" /><verse number="66" style="v" sid="MAT 26:66" />Nôôq pe kanóq ng'kơi?” Hayơq xók ââi bóóp, piđó móón: “Ađó alua nek đaang chêt.” <verse eid="MAT 26:66" /><verse number="67" style="v" sid="MAT 26:67" />Xong ađek, piđó kathui leq mat Ađó, m'bhiiq Ađó, hayơq m'pah Ađó, <verse eid="MAT 26:67" /><verse number="68" style="v" sid="MAT 26:68" />kơi ađô: “Nô, Chuôq Paq Manưih, praaq loom taruuih leq nôôq yi nek. Ngaai nek đu ơi m'bhiiq amei?”<verse eid="MAT 26:68" /></para>
  <para style="p">
    <verse number="69" style="v" sid="MAT 26:69" />Xók achêk, Phi-e-rơ xók tơơt dhiq taang hót nguôi, lơq mưi dhơn ratơơq pađiil tơk đan ađó, móón: “Amei kung tơơt madhiq palơq Jê-su, manưih Ga-li-lê.” <verse eid="MAT 26:69" /><verse number="70" style="v" sid="MAT 26:70" />Bơơi ađó dyiin toom mat dyóp ngaai, kơi ađô: “Aku kah n'nal harau amei papraaq.” <verse eid="MAT 26:70" /><verse number="71" style="v" sid="MAT 26:71" />Hayơq xong xók vôôiq gluh tơk palóng kariing, mưi dhơn ratơơq pađiil lââng ơi riing lêi ađó lơq móón palơq nôôq manưih tơơt dhiq ađek: “Akonh đik tơơt madhiq palơq Jê-su, manưih Na-xa-reet.” <verse eid="MAT 26:71" /><verse number="72" style="v" sid="MAT 26:72" />Lơq ađó vil dyiin nek palơq praaq ng'kóh, kơi ađô: “Aku kah n'nal manưih ađek!” <verse eid="MAT 26:72" /><verse number="73" style="v" sid="MAT 26:73" />Bơơi maxưưiq ađek, nôôq manưih glêh dyương dhiq ađek, xong xók tơk đan, ơi praaq palơq Phi-e-rơ: “Dhơ dhakơi amei kung tơơt kalóóng nôôq kabhuh piđó, ơi chênh kơi paraaq ưng amei têêng đóng amei tanêch aan.” <verse eid="MAT 26:73" /><verse number="74" style="v" sid="MAT 26:74" />Bhêêl achêk, ađó nek yuur tóh, lơq ng'kóh kơi ađô: “Aku kah n'nal manưih ađek,” hayơq n'drươh nek, atưưch takar. <verse eid="MAT 26:74" /><verse number="75" style="v" sid="MAT 26:75" />Lơq Phi-e-rơ hei lóóiq nôôq paraaq ưng Chuôq Jê-su ơi praaq, kơi ađô: “Loom xók tưưch takar, amei e dyiin thêi pe chu.” Hayơq xók ơi vôôiq gluh leq nguôi, ađó nhiim griit kơi tang ahaaq.<verse eid="MAT 26:75" /></para>
  <chapter eid="MAT 26" />
  <chapter number="27" style="c" sid="MAT 27" />
  <para style="p">
    <verse number="1" style="v" sid="MAT 27:1" />Xók achêk, mót bhêêl yayóng tarưưp, tabhơt nôôq takóh kadhâng bhanuôih bhơt liêm lơq nôôq takóh bhươl kalóóng manưih dhanuôr ơi tapraaq mangê kanóq kơi jơl lóóiq Chuôq Jê-su buôn leng Ađó vóq. <verse eid="MAT 27:1" /><verse number="2" style="v" sid="MAT 27:2" />Xók ơi klooiq Ađó lóóiq, piđó đââng Ađó vôôiq lơq pajaau đââng leq Phi-laat kuôn têêng gamak.<verse eid="MAT 27:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 27:3" />Bhêêl ađek, xong xók Ju-đa, manưih baan Ađó, lêi kơi Ađó ơi bâân patu, nek ơi dhơ kanóq, ađó ơi pachô lóóiq pe jêt parleh baak leq nôôq takóh kadhâng bhanuôih bhơt liêm lơq nôôq takóh bhươl, <verse eid="MAT 27:3" /><verse number="4" style="v" sid="MAT 27:4" />praaq kơi ađô: “Aku ơi têêng matu lơt ơi baan pajaau ahaam kah ve matu.” Bơơi piđó móón: “Harau chóóm pâng tơk nôôq yi? Amei tư đơơp.” <verse eid="MAT 27:4" /><verse number="5" style="v" sid="MAT 27:5" />Lơq xong xók m'peq nôôq parleh baak leq kalóóng đong bhanuôih, ađó val xooq, lơq xók ơi vôôiq changaai, ađó n'dret tuôr leng ađêi kala. <verse eid="MAT 27:5" /><verse number="6" style="v" sid="MAT 27:6" />Xók achêk, xong ơi chââih nôôq parleh baak achêk, nôôq takóh kadhâng bhanuôih bhơt liêm móón: “Lơơi nôôq parleh baak ađô leq jơơng ưng đong bhanuôih nek kah kre dhalam taai achêk nek janaaq ưng ahaam.” <verse eid="MAT 27:6" /><verse number="7" style="v" sid="MAT 27:7" />Bơơi xók ơi yuur xêi praaq xong, piđó ơi kơl kalung klung ưng manưih thơơq maai katiêk palơq nôôq baak achêk pakoom đóng tarnêêng tơp buur nôôq tamóói chrih. <verse eid="MAT 27:7" /><verse number="8" style="v" sid="MAT 27:8" />Ơi kơi achêk, kalung klung ađek bâân đóók nek “Klung ahaam” patơk tangêi ađôk. <verse eid="MAT 27:8" /><verse number="9" style="v" sid="MAT 27:9" />Kơi achêk nek, rau bâân praaq truuih tââq Jê-rê-mi manưih đââng taruuih, ơi bâân tajaap, kơi ađô: “Piđó pei pe jêt parlek baak, nek janaaq ưng manưih ơi đóng pheep, nek manưih hơq ơi bâân yaap janaaq tư tââq akóón anaaq I-sơ-ra-êên, <verse eid="MAT 27:9" /><verse number="10" style="v" sid="MAT 27:10" />lơq piđó ơi đóng nôôq baak achêk buôn pei kalung klung ưng thơơq maai katiêk, i kơi Chuôq ơi kayua aku.”<verse eid="MAT 27:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 27:11" />Xók achêk, Chuôq Jê-su dyương toom mat kuôn gamak, lơq chanak kuôn achêk tamóh Ađó, kơi ađô: “Alua kơq Amei nek Bhua dhanuôr Jo Thaaiq?” Hayơq Chuôq Jê-su praaq palơq ađó: “Amei đu móón achêk.” <verse eid="MAT 27:11" /><verse number="12" style="v" sid="MAT 27:12" />Lơq bhêêl xók Ađó bâân takaauq matu tââq nôôq takóh kadhâng bhanuôih bhơt liêm lơq nôôq takóh bhươl, nek Ađó kah ââi lóóiq marau marâ. <verse eid="MAT 27:12" /><verse number="13" style="v" sid="MAT 27:13" />Tââq ađek, Phi-laat móón palơq Ađó: “Amei kah xâng n'nal mơ rau piđó xók truuih móón jơl lóóiq amei nek?” <verse eid="MAT 27:13" /><verse number="14" style="v" sid="MAT 27:14" />Lơq Chuôq ơi kah ââi bóóp ađó, patơk mơ palơq mưi parleh kung kah, tơk mơ kuôn gamak lêi lóng chrih bhlơng. <verse eid="MAT 27:14" /><verse number="15" style="v" sid="MAT 27:15" />Xók achêk, dhalam tangêi bhiêk, kuôn gamak biêh ve kơi kaxu paloh đóng manưih dhanuôr mưi chanak matu đu piđó ơi chââih. <verse eid="MAT 27:15" /><verse number="16" style="v" sid="MAT 27:16" />Kơi lââng, xók bhêêl ganah ađek, palââng dyơq król mưi chanak tơơt đong kanam tanđôôr huông tatông bâân đóók nek Ba-ra-ba. <verse eid="MAT 27:16" /><verse number="17" style="v" sid="MAT 27:17" />Kơi achêk, xong xók piđó bâân nhoom karong, Phi-laat praaq palơq piđó: “Nôôq pe kiêng aku paloh ngaai đóng nôôq pe? Ba-ra-ba, môôiq Jê-su, manưih bâân đóók nek Chuôq Paq Manưih?” <verse eid="MAT 27:17" /><verse number="18" style="v" sid="MAT 27:18" />Ơi ađó n'nal kơi piđó ơi đââng pajaau Chuôq leq ađó taai lóóm dyââng lêi. <verse eid="MAT 27:18" /><verse number="19" style="v" sid="MAT 27:19" />Xók achêk, xók bhêêl ađó dyơq tơơt dhiq tanơơt xêi xanêi, kađiêl ưng ađó ơi kayua pató bóóp tơk ađó kơi ađô: “Nhan yươq rau chiên vaaih tơk leq amei lơq leq manưih bhơt liêm ađek. Ơi mađôk, aku kaxaal lóóm bhlơng taai m'pó lêi leq manưih ađô.” <verse eid="MAT 27:19" /><verse number="20" style="v" sid="MAT 27:20" />Hayơq nôôq takóh kadhâng bhanuôih bhơt liêm lơq nôôq takóh bhươl paxuq kayua manưih dhanuôr buôn piđó nhan paloh Ba-ra-ba hơq leng Chuôq Jê-su. <verse eid="MAT 27:20" /><verse number="21" style="v" sid="MAT 27:21" />Bơơi buôn ââi lóóiq, kuôn gamak praaq palơq piđó: “Nôôq pe kiêng ngaai aku paloh kalóóng bơơr chanak ađô leq nôôq pe?” Hayơq piđó móón: “Ba-ra-ba.” <verse eid="MAT 27:21" /><verse number="22" style="v" sid="MAT 27:22" />Phi-laat praaq palơq piđó: “Kơi achêk, aku kơng têêng harau palơq Jê-su, manưih bâân đóók nek Chuôq Paq Manưih?” Tabhơt kabhuh piđó ââi: “Ađó phaai bâân teeng đinh dhiq n'lóóng m'baang chatông.” <verse eid="MAT 27:22" /><verse number="23" style="v" sid="MAT 27:23" />Bơơi ađó praaq: “Ơi n'đó hơq rau aak Ađó achêk ơi têêng?” Dhơ kơi ađek, piđó n'dhương lalơu karơ lơh, kơi ađô: “Ađó phaai bâân teeng đinh dhiq n'lóóng m'baang chatông.” <verse eid="MAT 27:23" /><verse number="24" style="v" sid="MAT 27:24" />Xók achêk, Phi-laat, xong xók lêi kơi ađêi kah chóóm poor rau, bơơi klóóih dhiq ađek, mưi ganơt panhôôn panhaauq xók ravang vaaih, nek bhêêl đóng pei đơơk hayơq, ađó raau têi ađêi toom mat dhanuôr manưih, praaq: “Aku kah tapâng dhiq ahaam ưng manưih ađô. Nôôq pe tư đơơp.” <verse eid="MAT 27:24" /><verse number="25" style="v" sid="MAT 27:25" />Lơq xók ââi lóóiq, tabhơt manưih dhanuôr praaq: “Ahaam ưng ađó n'toh dhiq nôôq yi lơq dhiq akóón chachau nôôq yi.” <verse eid="MAT 27:25" /><verse number="26" style="v" sid="MAT 27:26" />Xong ađek, ađó paloh Ba-ra-ba leq piđó, hayơq xók ơi đóng m'bhiiq Chuôq Jê-su, ađó đóng đââng Chuôq vôôiq buôn đơơp teeng đinh dhiq n'lóóng m'baang chatông.<verse eid="MAT 27:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 27:27" />Bhêêl achêk, xong xók đââng Chuôq Jê-su mót kalóóng đong kuôn gamak, nôôq kabhuh linh ưng kuôn gamak ơi kaboq karong lóóiq toom mat Chuôq tabhơt pe jêt linh. <verse eid="MAT 27:27" /><verse number="28" style="v" sid="MAT 27:28" />Xong xók lôh aau Chuôq, piđó yuur paxơp mưi beq aau chaguôk parhóm bhrôông ar leq Ađó. <verse eid="MAT 27:28" /><verse number="29" style="v" sid="MAT 27:29" />Bhêêl taanh mưi beq panơơng palơq axông hayơq, piđó tapơơng leq akoq Ađó, palơq n'dreh karbho pakadhâng leq têi atươm Ađó, lơq xong xók chakoh toom mat Ađó, piđó ajóóch bharlưưk Ađó, kơi ađô: “Bhi kakoh Bhua dhanuôr Jo Thaaiq!” <verse eid="MAT 27:29" /><verse number="30" style="v" sid="MAT 27:30" />Hayơq xong xók kathui havi leq Ađó, piđó pei karbho lơq bhiêk m'bhiiq leq akoq Ađó. <verse eid="MAT 27:30" /><verse number="31" style="v" sid="MAT 27:31" />Xók piđó praaq ajóóch Ađó xong, piđó lôh aau chadhoop lơq paxơp đóng leq Ađó aau ưng Ađó, hayơq galôôi Ađó vôôiq buôn teeng đinh dhiq n'lóóng m'baang chatông.<verse eid="MAT 27:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 27:32" />Xók achêk, dyơq xók vôôiq gluh, piđó lêi mưi chanak tââq Si-reen, achak Si-môôn, hơq piđó pa-eep buôn ađó đuôl n'lóóng m'baang chatông ưng Ađó. <verse eid="MAT 27:32" /><verse number="33" style="v" sid="MAT 27:33" />Xong xók vôôiq tơk mưi dhiq ngi đóók nek Gô-gô-tha, hơq dhiq achêk kiêng móón nek Dhiq “Paliing akoq.” <verse eid="MAT 27:33" /><verse number="34" style="v" sid="MAT 27:34" />Piđó đóng Chuôq ơm alak bâân luk palơq mơt atang. Xók ơi tadyep xâng, nek Ađó kah đơơp ơm. <verse eid="MAT 27:34" /><verse number="35" style="v" sid="MAT 27:35" />Xók achêk, bhêêl teeng đinh Ađó dhiq n'lóóng m'baang chatông hayơq, piđó nh'xóóng xóng piđó aau ưng Ađó palơq kơi thuôt padhơơch, <verse eid="MAT 27:35" /><verse number="36" style="v" sid="MAT 27:36" />lơq piđó đương jư Ađó, xók tơơt dhiq ađek. <verse eid="MAT 27:36" /><verse number="37" style="v" sid="MAT 27:37" />Dhiq m'piing akoq Ađó, piđó lơơi kơơq kaauq patu ưng Ađó, bâân xaraq kơi ađô: “Ađô nek Jê-su, bhua dhanuôr Jo Thaaiq.” <verse eid="MAT 27:37" /><verse number="38" style="v" sid="MAT 27:38" />Bhêêl ađek, ve bơơr chanak manưih tatông bâân tateeng đinh palơq Ađó, mưi nak tơơt hót atươm lơq mưi nak tơơt hót ađaai. <verse eid="MAT 27:38" /><verse number="39" style="v" sid="MAT 27:39" />Nôôq manưih vôôiq lalơh praaq bharlưưk Ađó, tangơr akoq ađêi <verse eid="MAT 27:39" /><verse number="40" style="v" sid="MAT 27:40" />lơq praaq: “Đu chanak têêng pahư đong bhanuôih lơq têêng lóóiq kalóóng pe tangêi atêêh, nek tư paq ađêi nek! La Amei nek Akóón Yaang Pleng, hơq nek dhaluônh tââq n'lóóng m'baang chatông!” <verse eid="MAT 27:40" /><verse number="41" style="v" sid="MAT 27:41" />Kung i kơi achêk, nôôq takóh kadhâng bhanuôih bhơt liêm, nek palơq nôôq manưih pachóóm gani lơq nôôq takóh bhươl, xók praaq ajóóch Ađó, ơi móón: <verse eid="MAT 27:41" /><verse number="42" style="v" sid="MAT 27:42" />“Ađó ơi paq nôôq đu lââng; Ađó nek kah ve chóóm đuôh tư paq Ađêi. Ađó nek Bhua ưng I-sơ-ra-êên. Xók ađôk, Ađó phaai dhaluônh tââq n'lóóng m'baang chatông, nek nôôq he e huuiq dhiq Ađó. <verse eid="MAT 27:42" /><verse number="43" style="v" sid="MAT 27:43" />Ađó huuiq ganơơm dhiq Yaang Pleng; ađôk nek phaai lơơi Yaang Pleng trôông paq Ađó la Yaang Pleng kiêng Ađó. Taai Ađó ơi praaq kơi ađô: ‘Aku nek Akóón Yaang Pleng.’” <verse eid="MAT 27:43" /><verse number="44" style="v" sid="MAT 27:44" />Kơi lââng, chênh nôôq manưih tatông, nek nôôq đu bâân tateeng đinh palơq Ađó, kabhuh piđó kung praaq bharlưưk Ađó.<verse eid="MAT 27:44" /></para>
  <para style="p">
    <verse number="45" style="v" sid="MAT 27:45" />Xók achêk, tââq jơ đu chapat, yuur vaaih kanam dhiq plok bhơt xưưq patơk jơ đu takiêh. <verse eid="MAT 27:45" /><verse number="46" style="v" sid="MAT 27:46" />Hayơq mơ jơ đu takiêh, Chuôq Jê-su dhaloong mưi parleh karơ, kơi ađô: “Ê-li, Ê-li, la-ma sa-bech-tha-ni?” nek kiêng móón “Yaang Pleng Aku ơơi, Yaang Pleng Aku ơơi, hau Amei xooq lơơi Aku?” <verse eid="MAT 27:46" /><verse number="47" style="v" sid="MAT 27:47" />Bơơi xong xók xâng kơi achêk, nôôq đu biêh dyương dhiq ađek móón kơi ađô: “Ađó dhaloong Ê-li.” <verse eid="MAT 27:47" /><verse number="48" style="v" sid="MAT 27:48" />N'drươh, mưi nak kalóóng nôôq piđó, xong xók mut vôôiq lơq pei parleh tapô taxiiq, n'drươh tươm bing đơơk kadyuôq, n'drươh tabóq leq karbho, hơq đââng leq Ađó ơm. <verse eid="MAT 27:48" /><verse number="49" style="v" sid="MAT 27:49" />Bơơi nôôq đu dyơq lóóiq móón: “Nek lơơi mak kơi Ađó. Nôôq he lêi e Ê-li ve tơk paq Ađó kah.” <verse eid="MAT 27:49" /><verse number="50" style="v" sid="MAT 27:50" />Kơi achêk hayơq, xong xók dhaloong lóóiq mưi parleh karơ, Chuôq Jê-su pat parhââm. <verse eid="MAT 27:50" /><verse number="51" style="v" sid="MAT 27:51" />Lơq lêi tôôh, bhaai yoong ưng đong bhanuôih bâân tanteek têêng bơơr tââq piing leq raal, hayơq katiêk bâân veq dha-ơr, lơq dhơl gamak bâân yuur havóh. <verse eid="MAT 27:51" /><verse number="52" style="v" sid="MAT 27:52" />Bơk ping xaal bâân tapơơh tarlóng lơq bơk achak ưng nôôq manưih liêm ơi chêt bâân têêng mamông lóóiq. <verse eid="MAT 27:52" /><verse number="53" style="v" sid="MAT 27:53" />Lơq bhêêl gluh lơh tââq ping xong rau mamông lóóiq ưng Ađó, piđó ơi mót kalóóng kanóón liêm lơq tabhral pakah leq bơk manưih. <verse eid="MAT 27:53" /><verse number="54" style="v" sid="MAT 27:54" />Xók achêk, xong xók lêi dha-ơr katiêk lơq nôôq tarnêêng yuur vaaih, bharlơng kađââng linh palơq nôôq đu xók đương jư Chuôq Jê-su madhiq palơq ađó ơi bâân kakhin kapơn bhlơng, móón kơi ađô: “Alua manưih ađô nek Akóón Yaang Pleng.” <verse eid="MAT 27:54" /><verse number="55" style="v" sid="MAT 27:55" />Hayơq ve bơk manưih pađiil dhiq ađek, lêi padrêh tââq changaai, nek nôôq manưih ơi vôôiq ting Chuôq Jê-su, têêng yaauq Ađó tââq xưưq Ga-li-lê. <verse eid="MAT 27:55" /><verse number="56" style="v" sid="MAT 27:56" />Kalóóng nôôq piđó ve Ma-ri Ma-đơ-leen, Ma-ri akan Ja-kơ lơq Jô-seep, palơq akan ưng nôôq akóón padruuih Xê-bê-đê.<verse eid="MAT 27:56" /></para>
  <para style="p">
    <verse number="57" style="v" sid="MAT 27:57" />Xók achêk, xók ơi tơk habu blót, mưi manưih karvaan, ơi bhral tââq A-ri-ma-thê, achak nek Jô-seep, hơq ađó kala achak kung đơơp têêng môôn-đô ting Chuôq Jê-su. <verse eid="MAT 27:57" /><verse number="58" style="v" sid="MAT 27:58" />Xong xók tơk lum Phi-laat, ađó nhan xaak Chuôq Jê-su. Bhêêl ađek, Phi-laat kayua buôn xaak bâân pajaau leq ađó. <verse eid="MAT 27:58" /><verse number="59" style="v" sid="MAT 27:59" />Bhêêl ơi pei xaak, Jô-seep pươr xaak achêk lóóiq kalóóng bhaai ramaanh sek, <verse eid="MAT 27:59" /><verse number="60" style="v" sid="MAT 27:60" />hayơq tabêch xaak leq ping tame ưng chênh ađêi đu ađó ơi têêng kalóóng bóng dhơl. Xók talâh mưi beq dhơl gamak kađơp palóng ping hayơq ađó yuur chô. <verse eid="MAT 27:60" /><verse number="61" style="v" sid="MAT 27:61" />Xók achêk, Ma-ri Ma-đơ-leen lơq mưi Ma-ri lââng dhiq ađek, tơơt chaang-gan palơq ping.<verse eid="MAT 27:61" /></para>
  <para style="p">
    <verse number="62" style="v" sid="MAT 27:62" />Hayơq tangêi rayiiu, hơq nek xong tangêi Ravang Ravưa, nôôq takóh kadhâng bhanuôih bhơt liêm lơq nôôq manưih Pha-ri-si ơi bâân karong nhoom lóóiq toom Phi-laat, <verse eid="MAT 27:62" /><verse number="63" style="v" sid="MAT 27:63" />móón kơi ađô: “Abhươp ơơi, nôôq yi hei kơi bhêêl dyơq mamông, chanak galơơk chachââr tôôh ơi praaq: ‘Xong pe tangêi, nek Aku bâân têêng mamông lóóiq.’ <verse eid="MAT 27:63" /><verse number="64" style="v" sid="MAT 27:64" />Taai kơi ađek, nhan kayua buôn ping bâân đương jư tamưng patơk tangêi đu pe. La kah, nôôq môôn-đô ưng ađó tơk hayơq, ve chóóm tông xaak ađó, hơq móón palơq manưih dhanuôr: ‘Ađó ơi bâân têêng mamông lóóiq tââq kan chêt,’ nek rau galơơk chachââr leq tatun e dyơq môôp lơh bhêêl tarnââp.” <verse eid="MAT 27:64" /><verse number="65" style="v" sid="MAT 27:65" />Kơi achêk hayơq Phi-laat praaq palơq piđó: “Nôôq pe ve linh đương. Vôôiq aq, phaai jư paliêm tamưng kơi nôôq pe n'nal.” <verse eid="MAT 27:65" /><verse number="66" style="v" sid="MAT 27:66" />Hayơq xong xók vôôiq, jư kađơl bhangôh dhơl nek palơq linh đương, piđó jư ping paliêm tamưng.<verse eid="MAT 27:66" /></para>
  <chapter eid="MAT 27" />
  <chapter number="28" style="c" sid="MAT 28" />
  <para style="p">
    <verse number="1" style="v" sid="MAT 28:1" />Xók achêk, xong tangêi Sa-baat, bhêêl yayóng marư rư tangêi laloom kalóóng tapól tangêi xók tơk, Ma-ri Ma-đơ-leen lơq mưi Ma-ri lââng vôôiq tham ping. <verse eid="MAT 28:1" /><verse number="2" style="v" sid="MAT 28:2" />Lêi tôôh, mưi garluh dha-ơr katiêk karơ ơi yuur vaaih, ơi mưi dhơn pleng ưng Chuôq, xong xók tââq pleng dhaluônh lơq tơk đan, ơi chir bhangôh dhơl hayơq tơơt dhiq ađek. <verse eid="MAT 28:2" /><verse number="3" style="v" sid="MAT 28:3" />Bhêêl achêk, moh mat ưng chanak achêk nek thê kơi achaach, hayơq aau ưng ađó nek bhóók kơi dhaluk. <verse eid="MAT 28:3" /><verse number="4" style="v" sid="MAT 28:4" />Kơi achêk hayơq, taai tââq braaih kakhin taai chanak achêk, kabhuh linh jư ping hayer papreh lơq val xar kơi manưih chêt. <verse eid="MAT 28:4" /><verse number="5" style="v" sid="MAT 28:5" />Bơơi xók pơơh bóóp, dhơn pleng praaq palơq nôôq manưih pađiil: “Nôôq pe óóq kakhin, ơi aku n'nal kơi nôôq pe chik-chêk Jê-su, Yaang ơi bâân tateeng đinh. <verse eid="MAT 28:5" /><verse number="6" style="v" sid="MAT 28:6" />Ađó kah tơơt dhiq ađô mơ, ơi Ađó bâân têêng ơi mamông lóóiq, dhalam kơi Ađó ơi praaq. Tơk nô leq, nek lêi dhiq hơq Ađó ơi bêch. <verse eid="MAT 28:6" /><verse number="7" style="v" sid="MAT 28:7" />Hayơq xong xók lóng pađâh yuur vôôiq, nek truuih leq nôôq môôn-đô Ađó kơi ađô: ‘Ađó ơi bâân têêng mamông lóóiq tââq kan chêt. Lơq lêi tôôh, Ađó xók vôôiq loom adhi anó tơk Ga-li-lê. Dhiq ađek, adhi anó e lum Ađó.’ Lêi nô, aku ve móón leq nôôq pe n'nal ơi ađek.” <verse eid="MAT 28:7" /><verse number="8" style="v" sid="MAT 28:8" />Lơq bhêêl lóng pađâh xooq tââq ping palơq braaih kakhin, lơq bhuui yayar bhlơng piđó ơi mut vôôiq buôn truuih móón leq nôôq môôn-đô ưng Ađó. <verse eid="MAT 28:8" /><verse number="9" style="v" sid="MAT 28:9" />Lêi nô, Chuôq Jê-su lum piđó, praaq: “Yayar đóng nôôq pe!” Hayơq xong xók tơk đan, piđó kuôr dyung Chuôq lơq bhuôih kakoh Ađó. <verse eid="MAT 28:9" /><verse number="10" style="v" sid="MAT 28:10" />Tââq ađek, Chuôq Jê-su praaq palơq piđó: “ÓÓq kakhin. Nek vôôiq truuih móón leq adhi anó ưng thêi buôn piđó ve chóóm yuur vôôiq tơk Ga-li-lê, lơq dhiq ađek, piđó e lum thêi.”<verse eid="MAT 28:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 28:11" />Xók achêk, xók bhêêl piđó vôôiq kalơng, lêi nô, ve đu kalóóng nôôq kabhuh linh đương jư, xong xók mót kalóóng kanóón, ơi truuih lóóiq leq nôôq takóh kadhâng bhanuôih bhơt liêm dyóp tarnêêng ơi yuur vaaih. <verse eid="MAT 28:11" /><verse number="12" style="v" sid="MAT 28:12" />Lơq bhêêl ơi bâân nhoom karong nek palơq nôôq takóh bhươl, chadrươh yuur praaq xêi xong, piđó ơi đóng kabhuh linh masôôq jêên bơk bhlơng, <verse eid="MAT 28:12" /><verse number="13" style="v" sid="MAT 28:13" />móón kơi ađô: “Phaai praaq: ‘Xong xók tơk mót bhêêl hayum, nôôq môôn-đô ưng Ađó ơi tông xaak Ađó xók bhêêl nôôq yi dyơq bêch.’ <verse eid="MAT 28:13" /><verse number="14" style="v" sid="MAT 28:14" />Lơq la taruuih ađô bâân móón leq kuôn gamak, nôôq yi e praaq nhan ađó achêk lơq têêng đóng nôôq pe yươq lum hadhơơp.” <verse eid="MAT 28:14" /><verse number="15" style="v" sid="MAT 28:15" />Kơi achêk hayơq, xong xók đơơp jêên, kabhuh ađek têêng kơi ơi bâân pató kayua. Taruuih ađô bâân yuur tanđôôr tư xưưq dhiq dhanuôr Jo Thaaiq, patơk mơ tơk leq tangêi mađôk.<verse eid="MAT 28:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 28:16" />Xók achêk, majêt muui môôn-đô ơi vôôiq tơk Ga-li-lê, tơk kachrooch bôôl hơq Chuôq Jê-su ơi chaleq đóng piđó. <verse eid="MAT 28:16" /><verse number="17" style="v" sid="MAT 28:17" />Lơq xók ơi lum Ađó, piđó bhuôih haanh Ađó, bơơi ve nak dyơq paangra. <verse eid="MAT 28:17" /><verse number="18" style="v" sid="MAT 28:18" />Xong xók ruul tơk đan, Chuôq Jê-su praaq chiên palơq piđó, kơi ađô: “Dyóp mataai raman dhiq pleng lơq dhiq katiêk ơi bâân pajaau leq thêi. <verse eid="MAT 28:18" /><verse number="19" style="v" sid="MAT 28:19" />Ơi kơi achêk, xók vôôiq, adhi anó nek paxar tabhơt dhanuôr xar môôn-đô, têêng bap-teem đóng piđó kalóóng dhanóók Ama, Akóón lơq Chuôq Yaang Liêm; <verse eid="MAT 28:19" /><verse number="20" style="v" sid="MAT 28:20" />pachóóm pató piđó buôn huuiq jư dyóp rau đu thêi ơi truuih leq adhi anó. Lơq lêi nô, Aku tơơt palơq adhi anó dyóp tangêi patơk leq marngi.”<verse eid="MAT 28:20" /></para>
  <chapter eid="MAT 28" />
</usx>