  <book code="1TI" style="id">EN_KTLT kuf_Katu,⋅Western_ltr Wed Mar 05 2025 09:32:18 GMT+0700 (Indochina Time) tc</book>
  <para style="usfm">3.0</para>
  <para style="ide">UTF-8</para>
  <para style="h">1 Timothy</para>
  <para style="toc1">Thơ Ti-mô-thê đu mưi</para>
  <para style="toc2">1 Ti-mô-thê</para>
  <para style="toc3">1Ti</para>
  <para style="mt">1 Ti-mô-thê</para>
  <chapter number="1" style="c" sid="1TI 1" />
  <para style="p">
    <verse number="1" style="v" sid="1TI 1:1" />Phaau-lô, sưưq-đô ưng Jê-su Chuôq Paq Manưih ting paraaq kayua ưng Yaang Pleng, Chuôq Paq nôôq he, lơq ưng Chuôq, nek Chuôq Jê-su Paq Manưih, lóóm parââm ưng nôôq he, <verse eid="1TI 1:1" /><verse number="2" style="v" sid="1TI 1:2" />pagơơi đóng Ti-mô-thê, akóón lalua ưng aku klóóng lóóm huuiq: Nhan akóón bâân ơơn phươk liêm, rau ayô ka-er, yươq rauha tââq Yaang Pleng nek Ama lơq Jê-su Chuôq Paq Manưih, Chuôq nôôq he.<verse eid="1TI 1:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="1TI 1:3" />Kơi bhêêl vôôiq kalơng tơk Ma-xê-đoan, aku ơi bhơơl chut akóón tơơt lóóiq dhiq Ê-phê-sô buôn akóón ve chóóm truuih móón nôôq manưih tôôh kah pachóóm taruuih đu lââng, <verse eid="1TI 1:3" /><verse number="4" style="v" sid="1TI 1:4" />kung óóq katiêu lóóm tơk nôôq chiên kah makoq machak lơq nôôq bha-aar dhong nooi đươnh điêq, nek nôôq rau đââng tơk rau tarkaai tarlak, lơh nek tarnêêng jư lêi đong Yaang Pleng, nek tarnêêng tââq lóóm huuiq. <verse eid="1TI 1:4" /><verse number="5" style="v" sid="1TI 1:5" />Bơơi kanóq kaniêng ưng paraaq kayua ađô nek lóóm tanhơr avaaih gluh tââq lóóm sek chadhah, lơq lóóm kanóq liêm nek palơq lóóm huuiq yươq galơơk pathê, <verse eid="1TI 1:5" /><verse number="6" style="v" sid="1TI 1:6" />hơq mưi phơn manưih, taai lơt kanóq kaniêng, ơi palâh lơơi buôn malóóm tơk tarnêêng xêi tapraaq ngôôk ngaak, <verse eid="1TI 1:6" /><verse number="7" style="v" sid="1TI 1:7" />kiêng têêng manưih pachóóm gani, xók kah n'nal eh mưi nôôq paraaq ađêi praaq hơq dyơq leq nôôq rau ađêi praaq panhit.<verse eid="1TI 1:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1TI 1:8" />Dhơ kơi ađek, nôôq he n'nal kakơi gani nek liêm kre la akóón manưih pei vech ađó kơi pâng dhalam, <verse eid="1TI 1:8" /><verse number="9" style="v" sid="1TI 1:9" />taai n'nal rau ađô, ađek nek gani kah chóóm yuur tavaaih đóng manưih bhơt liêm, hơq đóng đu kah ve gani lơq kah xâng bóóp, đu kah charnap lơq matu lơt, đu kah ve taruuih liêm lơq praaq chôlô, đu leng akonh lơq leng akan, đu leng manưih, <verse eid="1TI 1:9" /><verse number="10" style="v" sid="1TI 1:10" />đu têêng taniêt, đu vah-va, đu kóóp dhiêt baan manưih, đu praaq chachââr, đu truuih đuui galơơk, lơq dhơ dharau ngaai đu lââng tajơl huông palơq rau pachóóm pató liêm kre, <verse eid="1TI 1:10" /><verse number="11" style="v" sid="1TI 1:11" />dhalam kơi Taruuih Liêm cha-iil tabah ưng Yaang Pleng phươk liêm, nek rau đu aku ơi bâân pajaau đóng.<verse eid="1TI 1:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="1TI 1:12" />Aku ma-ơơn Yaang đóng kataai karơ leq aku, hơq nek Jê-su Chuôq Paq Manưih, Chuôq nôôq he, taai Ađó ơi lêi aku nek đaang huuiq ganơơm, xók patơơt aku leq tarnêêng têêng, <verse eid="1TI 1:12" /><verse number="13" style="v" sid="1TI 1:13" />dhơ n'loom hei aku nek đu praaq chôlô, têêng mahaai, lơq grô jar-ââih, bơơi aku ơi bâân kayô ka-er taai dyơq bhêêl kah n'nal rau, aku ơi têêng vôôiq kalóóng rau kah ve lóóm huuiq. <verse eid="1TI 1:13" /><verse number="14" style="v" sid="1TI 1:14" />Bơơi, ơơn phươk liêm ưng Chuôq nôôq he nek taluôn lóng xưa raai nek palơq lóóm huuiq lơq lóóm tanhơr kalóóng Jê-su Chuôq Paq Manưih.<verse eid="1TI 1:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="1TI 1:15" />Taruuih liêm ađô nek đaang huuiq lơq đaang pơh đơơp tabhơt, ađek nek: “Jê-su Chuôq Paq Manưih ơi bhral kalóóng hóng katiêk buôn paq manưih matu” hơq kalóóng ađek aku nek đu têêng akoq. <verse eid="1TI 1:15" /><verse number="16" style="v" sid="1TI 1:16" />Dhơ kơi ađek, aku ơi bâân kayô ka-er, taai ơi taai ađôk, achêk nek buôn Jê-su Chuôq Paq Manưih ve chóóm têêng pakah tabhơt lóóm jruôn parngau kalóóng aku, đu matu lơt nek tââm, kơi mưi rau pakah leq nôôq manưih e huuiq dhiq Ađó buôn bâân rau mamông taluôn nh'chró. <verse eid="1TI 1:16" /><verse number="17" style="v" sid="1TI 1:17" />Nhan rau bhi chap lơq cha-iil tabah chô leq Bhua ưng dyóp klaang đơơi, nek Yaang Pleng mưi giêl kah bil, kah chóóm lêi, patơk nh'chró taluôn luôn. A-meen.<verse eid="1TI 1:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="1TI 1:18" />Ti-mô-thê, akóón aku, aku pajaau paraaq kayua ađôk đóng akóón, ting nôôq paraaq manưih đââng taruuih n'loom hei leq akóón, buôn đươi piđó, akóón ve chóóm ruul tơk kalóóng ganơt tarjơl liêm kiiq, <verse eid="1TI 1:18" /><verse number="19" style="v" sid="1TI 1:19" />xók kadhâng jư lóóm huuiq lơq lóóm karnóq liêm, hơq mưi phơn manưih, taai jơl m'peq, ơi têêng klêch bil lóóm huuiq ađêi, <verse eid="1TI 1:19" /><verse number="20" style="v" sid="1TI 1:20" />kalóóng nôôq ađek nek Hi-mê-nê lơq A-lek-xan-đơ, nek nôôq manưih đu aku ơi pajaau đóng Sa-taan buôn đóng piđó ve chóóm bâân pató pachóóm đóng kah praaq chôlô.<verse eid="1TI 1:20" /></para>
  <chapter eid="1TI 1" />
  <chapter number="2" style="c" sid="1TI 2" />
  <para style="p">
    <verse number="1" style="v" sid="1TI 2:1" />Kơi achêk hơq, laloom bhơt, aku chut kayua nôôq paraaq mââl nhan, praaq chiên, gavơh đóng, n'nal ma-ơơn chóóm bâân yuur tapôông đóng dyóp ngaai, <verse eid="1TI 2:1" /><verse number="2" style="v" sid="1TI 2:2" />đóng nôôq bhua lơq tabhơt nôôq ngaai dyơq tơơt kalóóng dhiq tanơơt kataai karơ, buôn nôôq he ve chóóm mamông mưi đơơi yươq rauha lơq khe liêm palơq dyóp rau huuiq bhi lơq paraaq tarnêêng. <verse eid="1TI 2:2" /><verse number="3" style="v" sid="1TI 2:3" />Ađek nek rau liêm kre lơq dhalam đaang toom mat Yaang Pleng, Chuôq Paq nôôq he, <verse eid="1TI 2:3" /><verse number="4" style="v" sid="1TI 2:4" />nek Yaang kiêng dyóp ngaai bâân paq lơq vôôiq tơk dhiq đơơp n'nal paraaq dhalam. <verse eid="1TI 2:4" /><verse number="5" style="v" sid="1TI 2:5" />Taai chapiên ve mưi Yaang Pleng lơq mưi Yaang dhiq m'pơng Yaang Pleng lơq akóón manưih, ađek nek Jê-su Chuôq Paq Manưih, mưi akóón manưih, <verse eid="1TI 2:5" /><verse number="6" style="v" sid="1TI 2:6" />Yaang ơi pajaau chênh ađêi têêng panók pók đóng dyóp ngaai, kơi paraaq taruuih leq pâng bhêêl ganah, <verse eid="1TI 2:6" /><verse number="7" style="v" sid="1TI 2:7" />tââq paraaq taruuih achêk hơq aku ơi bâân tabóq têêng manưih truuih taruuih liêm lơq sưưq-đô, aku praaq lalua kalóóng Chuôq Paq Manưih, aku kah praaq chachââr, hơq nek têêng manưih pachóóm đóng nôôq dhanuôr katiêk lââng leq lóóm huuiq lơq paraaq dhalam.<verse eid="1TI 2:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1TI 2:8" />Taai kơi chêk, aku kiêng nôôq padruuih tơơt dyóp dhiq phaai gavơh nhan, jarơ têi yuur sek chadhah kah ting đââng rau grâ jar-ââih lơq tarkaai tarlak, <verse eid="1TI 2:8" /><verse number="9" style="v" sid="1TI 2:9" />markơi ađek, nôôq adhi anó pađiil phaai têêng paliêm chênh ađêi kalóóng chanam pâng dhalam palơq lóóm pa-katưưiq lơq pakala, eh rau palơq tarnêêng klaanh xok, nek palơq vaang, môôiq ngok, môôiq kun aau mat jêên, <verse eid="1TI 2:9" /><verse number="10" style="v" sid="1TI 2:10" />hơq palơq rau targlap palơq manưih pađiil đóók móón ve lóóm bhi kakhin Yaang Pleng ve nôôq tarnêêng liêm.<verse eid="1TI 2:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="1TI 2:11" />Pađiil parkan phaai hok tamóh kalóóng moor parngau, kalóóng rau huuiq xâng bhơt dyóp. <verse eid="1TI 2:11" /><verse number="12" style="v" sid="1TI 2:12" />Mat lââng, aku kah đóng pheep pađiil parkan pachóóm pahêêl môôiq têêng kala dhiq padruuih, hơq phaai parngau. <verse eid="1TI 2:12" /><verse number="13" style="v" sid="1TI 2:13" />Taai A-đaam ơi bâân tavaaih laloom, hayơq ve tơk Ê-va, <verse eid="1TI 2:13" /><verse number="14" style="v" sid="1TI 2:14" />lơq A-đaam yươq bâân galơơk chachââr, bơơi manưih pađiil, xók tabhơt bâân dharơơl galơơk, ơi ruul tơk dhiq matu lơt. <verse eid="1TI 2:14" /><verse number="15" style="v" sid="1TI 2:15" />Dhơ kơi ađek, manưih pađiil e bâân paq dhiq tarnêêng n'niên akóón, la kơi piđó bhiêk tơơt kalóóng lóóm huuiq, lóóm tanhơr lơq rau sek chadhah, palơq lóóm karnóq liêm karơ.<verse eid="1TI 2:15" /></para>
  <chapter eid="1TI 2" />
  <chapter number="3" style="c" sid="1TI 3" />
  <para style="p">
    <verse number="1" style="v" sid="1TI 3:1" />Paraaq ađô nek đaang huuiq ganơơm: “La ngaai ađek rââm têêng manưih muk sư, nek manưih achêk rââm kiêng mưi tarnêêng yaal liêm.” <verse eid="1TI 3:1" /><verse number="2" style="v" sid="1TI 3:2" />Kơi achêk hơq, manưih muk sư phaai nek manưih yươq dhiq chóóm bâân trêh, kayiik ưng mưi kađiêl, bhriêl chagơn, jư ađêi kala, matư ma-iiq, yaauq tamóói, ve chóóm đuôh pachóóm pahêêl, <verse eid="1TI 3:2" /><verse number="3" style="v" sid="1TI 3:3" />kah giêng buôh, kah buôn tavaaih tarvei, hơq phaai moor liêm, mapheep dha-iiq kah n'thaam jêên, <verse eid="1TI 3:3" /><verse number="4" style="v" sid="1TI 3:4" />trêh pachóóm paliêm đong ađêi, ve akóón anaaq xâng bóóp palơq tabhơt lóóm bhi chap <verse eid="1TI 3:4" /><verse number="5" style="v" sid="1TI 3:5" />(ơi la mưi chanak kah n'nal kơi trêh pachóóm đong ađêi, nek manưih achêk e gamang lêi Akóón Dhơn Chuôq ưng Yaang Pleng ng'kơi chóóm?), <verse eid="1TI 3:5" /><verse number="6" style="v" sid="1TI 3:6" />kah chóóm nek manưih tame huuiq, đóng yươq ơi taai yuur laach jơơr hơq manưih achêk xruuk leq rau xêi janah kơi abhưi. <verse eid="1TI 3:6" /><verse number="7" style="v" sid="1TI 3:7" />Palâh lóóiq, manưih têêng muk sư kung phaai ve paraaq móón liêm tââq manưih eh akóón dhơn Chuôq, buôn manưih achêk kah pâng leq rau kađiq kachiit lơq mơk tarnêêng ưng abhưi.<verse eid="1TI 3:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1TI 3:8" />Markơi ađek, nôôq chơp sưưq phaai charnap, kah praaq bơơr kơi, kah giêng buôh alak, kah n'thaam dhahik, <verse eid="1TI 3:8" /><verse number="9" style="v" sid="1TI 3:9" />jư lêi rau đu lalââp ưng lóóm huuiq palơq lóóm karnóq sek chadhah. <verse eid="1TI 3:9" /><verse number="10" style="v" sid="1TI 3:10" />Mat lââng, piđó kung phaai bâân klêêu klôôq laloom, hayơq xong ađek phaai lơơi piđó têêng yaauq xók yươq bâân trêh jươm.<verse eid="1TI 3:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="1TI 3:11" />Nôôq manưih kađiêl kung kơi achêk, phaai charnap, kah praaq tamôôp, jư ađêi kala, bhơt lóóm kalóóng dyóp rau.<verse eid="1TI 3:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="1TI 3:12" />Nôôq chơp sưưq phaai nek kayiik ưng mưi kađiêl, trêh pachóóm paliêm akóón anaaq lơq bhơt đong ađêi. <verse eid="1TI 3:12" /><verse number="13" style="v" sid="1TI 3:13" />Taai nôôq manưih têêng yaauq dhalam liêm đââng chô đóng ađêi dhiq tarnơơt liêm kre lơq bơk rau grâ nhóól kalóóng lóóm huuiq dhiq Jê-su Chuôq Paq Manưih.<verse eid="1TI 3:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="1TI 3:14" />Aku xaraq nôôq paraaq ađô đóng akóón, rââm tơk tham akóón đâh bhlơng, <verse eid="1TI 3:14" /><verse number="15" style="v" sid="1TI 3:15" />bơơi la aku jih tơk, nek akóón ve chóóm n'nal phaai praaq têêng ng'kơi kalóóng đong ưng Yaang Pleng, hơq ađek nek Akóón Dhơn ưng Yaang Pleng taluôn mamông, jarơng lơq tanól đương jaklâk ưng paraaq dhalam. <verse eid="1TI 3:15" /><verse number="16" style="v" sid="1TI 3:16" />La lââp leq rau huuiq bhi alua nek gamak bhlơng kah đuôh chóóm tarkaai, nek:</para>
  <para style="q2" vid="1TI 3:16">“Yaang bâân pakah kalóóng ng'kar m'bech,</para>
  <para style="q2" vid="1TI 3:16">bâân đóók bhơt liêm kalóóng Yaang Liêm,</para>
  <para style="q2" vid="1TI 3:16">bâân chalaang lêi tââq dhơn Pleng,</para>
  <para style="q2" vid="1TI 3:16">bâân truuih karơ dhiq m'pơng nôôq dhanuôr,</para>
  <para style="q2" vid="1TI 3:16">bâân huuiq ganơơm dhiq hóng katiêk,</para>
  <para style="q2" vid="1TI 3:16">bâân yuur padyók kalóóng cha-iil tabah.”<verse eid="1TI 3:16" /></para>
  <chapter eid="1TI 3" />
  <chapter number="4" style="c" sid="1TI 4" />
  <para style="p">
    <verse number="1" style="v" sid="1TI 4:1" />Yaang Liêm praaq drêh dróói kơi kalóóng ganah tatun ki, bơk manưih e m'peq lơơi lóóm huuiq, đââng achak ting nôôq yaang galơơk chachââr lơq taruuih pachóóm ưng abhưi, <verse eid="1TI 4:1" /><verse number="2" style="v" sid="1TI 4:2" />taai rau galơơk a-ô ưng kabhuh galơơk chachââr, lóóm karnóq ưng kabhuh ađek ơi bâân nhâng kakơu, <verse eid="1TI 4:2" /><verse number="3" style="v" sid="1TI 4:3" />xók jơl châq póói đóng, nhan dhaniêng habưưn nôôq chana dhanah đu Yaang Pleng tavaaih buôn pei đơơp palơq lóóm n'nal ơơn tââq manưih huuiq ganơơm lơq kanóq n'nal paraaq dhalam. <verse eid="1TI 4:3" /><verse number="4" style="v" sid="1TI 4:4" />Taai dyóp n'dreh m'ma ưng Yaang Pleng nek kre liêm, lơq yươq ve harau đaang m'peq lơơi xók bâân pei đơơp palơq lóóm n'nal ơơn, <verse eid="1TI 4:4" /><verse number="5" style="v" sid="1TI 4:5" />tââq chana dhanah bâân têêng pasek ve paraaq Yaang Pleng lơq paraaq gavơh nhan.<verse eid="1TI 4:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="1TI 4:6" />Xók patơơt nôôq rau achêk toom mat adhi anó, akóón e nek dhơn ratơơq dhalam liêm ưng Jê-su Chuôq Paq Manưih, bâân ban paar tââq paraaq ưng lóóm huuiq lơq taruuih pachóóm liêm kre đu akóón ơi huuiq xâng. <verse eid="1TI 4:6" /><verse number="7" style="v" sid="1TI 4:7" />Bơơi phaai jơl jak nôôq chiên kah makoq machak hóng katiêk ưng nôôq amooq takóh. Klóóih dhiq ađek, phaai pakeen chênh ađêi leq rau bhi huuiq, <verse eid="1TI 4:7" /><verse number="8" style="v" sid="1TI 4:8" />tââq “rau pachóóm pakeen achak araang nek malơơi malaai kalóóng tangêi kaxe gađóq bơơi pachóóm pakeen lóóm bhi huuiq nek malơơi malaai đóng dyóp tarnêêng, taai ve paraaq hươq đóng klaang ađôk lơq klaang tatun.” <verse eid="1TI 4:8" /><verse number="9" style="v" sid="1TI 4:9" />Paraaq achêk nek đaang huuiq ganơơm lơq đaang pơh đơơp tabhơt, <verse eid="1TI 4:9" /><verse number="10" style="v" sid="1TI 4:10" />tââq nôôq he nhưh nhok lơq tarvei tajơl đóng rau ađôk, taai nôôq he tabóq lóóm rââm dhiq Yaang Pleng taluôn mamông, Ađó nek Chuôq Paq ưng dyóp ngaai, tââm nek ưng manưih huuiq.<verse eid="1TI 4:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="1TI 4:11" />Phaai truuih kayua lơq pató pachóóm nôôq rau achêk. <verse eid="1TI 4:11" /><verse number="12" style="v" sid="1TI 4:12" />Óóq đóng ngaai kađiq lêi tuôi n'dhóm ưng akóón, hơq phaai val xar têêng panloom đóng nôôq manưih huuiq, kalóóng paraaq praaq, kalóóng kơi tarnêêng parvôôiq, kalóóng lóóm tanhơr, kalóóng lóóm huuiq, kalóóng rau sek chadhah. <verse eid="1TI 4:12" /><verse number="13" style="v" sid="1TI 4:13" />Phaai taraang lóóm leq đok bha-aar, bhơơl trêh, pató pachóóm đóng tơk xók aku bhral. <verse eid="1TI 4:13" /><verse number="14" style="v" sid="1TI 4:14" />Óóq m'peq lơơi ơơn tơơt kalóóng akóón, nek ơơn ơi bâân đóng leq akóón tââq paraaq manưih đââng taruuih, nek palơq rau lơơi têi ưng nôôq takóh bhươl.<verse eid="1TI 4:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="1TI 4:15" />Phaai pachóóm pakeen nôôq tarnêêng achêk, phaai taluôn chamet leq piđó, buôn rau tadhơ taklôôq ưng akóón val xar drêh dróói palơq dyóp ngaai. <verse eid="1TI 4:15" /><verse number="16" style="v" sid="1TI 4:16" />Phaai chagơn chamet lêi chênh achak akóón lơq tarnêêng têêng pató pachóóm. Phaai jêi tarang kalóóng nôôq tarnêêng achêk, taai têêng kơi achêk akóón e paq bhơt achak ađêi kala lơq nôôq manưih xâng akóón.<verse eid="1TI 4:16" /></para>
  <chapter eid="1TI 4" />
  <chapter number="5" style="c" sid="1TI 5" />
  <para style="p">
    <verse number="1" style="v" sid="1TI 5:1" />Kah chóóm pagrươq bóóp palơq nôôq padruuih taha tuôi, bơơi phaai bhơơl pahei manưih achêk kơi ama, n'dhóm nek kơi adhi anó, <verse eid="1TI 5:1" /><verse number="2" style="v" sid="1TI 5:2" />nôôq pađiil taha tuôi nek kơi amêêq, nôôq pađiil kamór nek kơi mamóóq adhi, kalóóng rau sek chadhah tabhơt.<verse eid="1TI 5:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="1TI 5:3" />Phaai bhi chap nôôq manưih kamaai, nôôq manưih kamaai lalua. <verse eid="1TI 5:3" /><verse number="4" style="v" sid="1TI 5:4" />Bơơi la ngaai manưih kamaai ve akóón môôiq chachau, nek laloom tââm akóón chachau piđó phaai đuui đóng bhi chap manưih đong ưng chênh ađêi, lơq pakah lóóm đóng chróót leq nôôq manưih đu tavaaih achêk, taai ađô nek rau pâng dhalam toom mat Yaang Pleng. <verse eid="1TI 5:4" /><verse number="5" style="v" sid="1TI 5:5" />Dhơ kơi ađek, manưih kamaai lalua lơq chapiên mưi achak mưi ađêi, nek đương rââm tââq Yaang Pleng, lơq bhiêk markơi kơi kalóóng rau nhan panhel lơq gavơh nhan hayum tangêi. <verse eid="1TI 5:5" /><verse number="6" style="v" sid="1TI 5:6" />Hayơq đu chik chêk rau bhuui kiêng nek ơi chêt, dhơ ve biêh dyơq mamông. <verse eid="1TI 5:6" /><verse number="7" style="v" sid="1TI 5:7" />Kung phaai truuih nôôq paraaq kayua ađô, buôn piđó ve chóóm yươq ve dhiq chóóm trêh. <verse eid="1TI 5:7" /><verse number="8" style="v" sid="1TI 5:8" />Bơơi la ngaai ađek kah nh'xóóng đóng leq kabhuh xóng ađêi, hơq đu griêq tââm nek manưih đong ađêi, nek manưih achêk ơi dyiin lơơi lóóm huuiq lơq nek đu môôp lơh manưih kah huuiq.<verse eid="1TI 5:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="1TI 5:9" />Mưi manưih kamaai kơng phaai bâân xaraq achak nek kah m'bưưiq lơh chapat jêt tuôi, nek kađiêl ưng mưi kayiik, <verse eid="1TI 5:9" /><verse number="10" style="v" sid="1TI 5:10" />bâân haliq lêi dhiq nôôq tarnêêng liêm; ađó ve ban pachóóm akóón anaaq kah, ađó ve pơh yaauq tamóói chrih kah, ađó ve raau dyung nôôq đu huuiq Chuôq kah, ađó ve poor jóói đu bhrê hư kah, ađó ve bhơt lóóm palơq dyóp tarnêêng liêm kah.<verse eid="1TI 5:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="1TI 5:11" />Bơơi phaai m'bhraq lơơi nôôq manưih kamaai dyơq paniên, taai xók marlóóch kiêng tââq lóóm yuur vaaih huông palơq Chuôq Paq Manưih, nek piđó kiêng bâân lóóiq kayiik, <verse eid="1TI 5:11" /><verse number="12" style="v" sid="1TI 5:12" />pei đơơp rau xêi xanêi taai piđó ơi m'peq lơơi raket bóóp tââq tarnââp ưng ađêi. <verse eid="1TI 5:12" /><verse number="13" style="v" sid="1TI 5:13" />Dhơ nek, piđó kung e akeen tóóch têêng dyââng, bhiêk tơơt bóóng tââq đong ađô đong tôôh, hơq kah chapiên tóóch dyââng têêng, bơơi dyơq tóóch praaq bhông haau lơq kiêng kachrua leq tarnêêng ưng palââng, praaq nôôq rau palââng kah chóóm praaq. <verse eid="1TI 5:13" /><verse number="14" style="v" sid="1TI 5:14" />Taai kơi achêk, aku kiêng nôôq manưih kamaai dyơq paniên phaai bâân kayiik, n'niên akóón, gamang lêi đong ađêi, buôn óóq tavaaih bhêêl bâân đóng đu jaklâk jơl ve paraaq xuôq bha. <verse eid="1TI 5:14" /><verse number="15" style="v" sid="1TI 5:15" />Taai mưi phơn manưih ơi tablah xooq vôôiq ting abhưi Sa-taan aq.<verse eid="1TI 5:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="1TI 5:16" />La ngaai pađiil đu huuiq ve manưih kamaai kalóóng đong, nek phaai poor jóói piđó, lơq óóq lơơi Akóón Dhơn Chuôq bâân haleng jong, buôn đóng Akóón Dhơn Chuôq ve chóóm poor jóói nôôq manưih kamaai lalua.<verse eid="1TI 5:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="1TI 5:17" />Nôôq takóh bhươl n'nal kơi kadhâng lêi phaai bâân lêi nek đaang bhi chap bơk lơh, đu tââm nek nôôq manưih đơơp jarnah kalóóng Paraaq Chuôq lơq rau pató pachóóm. <verse eid="1TI 5:17" /><verse number="18" style="v" sid="1TI 5:18" />Taai Bha-aar Paraaq Yaang Pleng pachóóm: “Amei kah chóóm xróp bóóp akóón karók dyơq xók ađó đâq aviq,” lơq “Manưih têêng makông ađaang palơq jêên kông ưng ađêi.” <verse eid="1TI 5:18" /><verse number="19" style="v" sid="1TI 5:19" />Óóq ting xâng paraaq kaauq patu jaklâk lóóiq mưi takóh bhươl, la lơh tââq ganơơm dhiq bhơt m'bưưiq nek bơơr môôiq pe chanak truuih. <verse eid="1TI 5:19" /><verse number="20" style="v" sid="1TI 5:20" />Phaai trêh teng đu têêng lơt toom mat dyóp ngaai buôn nôôq manưih dyơq lóóiq ve chóóm kung n'nal kakhin. <verse eid="1TI 5:20" /><verse number="21" style="v" sid="1TI 5:21" />Aku bhơt lóóm praaq kayua akóón toom mat Yaang Pleng lơq Jê-su Chuôq Paq Manưih, palơq nôôq dhơn Pleng bâân tachââih, kơi akóón phaai jư nôôq paraaq kayua ađô hơq yươq n'dróók palơq kanóq môôp, yươq têêng rau ting lóóm paq katơq.<verse eid="1TI 5:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="1TI 5:22" />Óóq tahươk lơơi têi dhiq dhangaai, kung óóq ting tapâng leq matu lơt ưng palââng. Phaai jư ađêi sek liêm.<verse eid="1TI 5:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="1TI 5:23" />Akóón óóq hơq chapiên ơm đơơk, hơq phaai ơm m'bưưiq buôh ơi taai palung ưng akóón lơq nôôq rau ka-ai buôn lum.<verse eid="1TI 5:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="1TI 5:24" />Matu ưng mưi phơn manưih nek drêh dróói, đââng tơk dhiq xêi xanêi, bơơi kung ve nôôq matu chapiên haleh gluh xók praaq xêi. <verse eid="1TI 5:24" /><verse number="25" style="v" sid="1TI 5:25" />Markơi ađek, kung ve nôôq tarnêêng liêm nek drêh dróói, dyơq nôôq tarnêêng liêm ve chóóm parngau lalââp nek kah chóóm bhiêk bâân kadrêi lââp.<verse eid="1TI 5:25" /></para>
  <chapter eid="1TI 5" />
  <chapter number="6" style="c" sid="1TI 6" />
  <para style="p">
    <verse number="1" style="v" sid="1TI 6:1" />Dhơ dhangaai dyơq tơơt raal et têêng xól, phaai lêi kala ađêi nek đaang bhơt lóóm bhi chap, buôn dhanóók Yaang Pleng lơq rau pató pachóóm yươq bâân praaq tamôôp. <verse eid="1TI 6:1" /><verse number="2" style="v" sid="1TI 6:2" />Mat lââng, nôôq têêng xól ve nôôq manưih kala nek manưih huuiq Chuôq kah chóóm ơi taai piđó nek adhi anó hơq kah bhi chap, bơơi phaai têêng yaauq kaang lơh dyơq, taai piđó nek manưih huuiq Chuôq lơq manưih bâân nh'nhơr, manưih pâng phơn leq rau têêng yaauq. Akóón phaai pató pachóóm lơq bhơơl chut nôôq rau achêk.<verse eid="1TI 6:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="1TI 6:3" />La ngaai manưih pató pachóóm n'tua lơq kah đơơp đươi nôôq paraaq liêm kre, hơq nek paraaq ưng Chuôq nôôq he, nek Jê-su Chuôq Paq Manưih, nek palơq paraaq parchóóm leq rau bhi huuiq, <verse eid="1TI 6:3" /><verse number="4" style="v" sid="1TI 6:4" />nek manưih ađek nek đu praaq parlaach, kah n'nal rarau, hơq ve malóóch kiêng keen tóóch kalóóng rau tarkaai pađươk lơq pachooi kaleh leq chư paraaq, tââq ađek yuur tavaaih rau chriik lêi, tarvei tarchuh, praaq tamôôp, targeet tarkhinh môôp lơt, <verse eid="1TI 6:4" /><verse number="5" style="v" sid="1TI 6:5" />margit, m'pơng nôôq đu bâân khung nh'xoq kalóóng lóóm karnóq lơq bâân tabhuch bil paraaq dhalam, lêi rau bhi huuiq nek rau tabâân đóng malơơi.<verse eid="1TI 6:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="1TI 6:6" />Bơơi rau bhi huuiq nek palơq rau iêm lóóm nek tââq malơơi gamak. <verse eid="1TI 6:6" /><verse number="7" style="v" sid="1TI 6:7" />Taai nôôq he ơi kah rau đââng leq hóng katiêk, hơq nôôq he kung kah ve chóóm đââng rau ting vôôiq. <verse eid="1TI 6:7" /><verse number="8" style="v" sid="1TI 6:8" />Mat lââng, xók ve chana cha, aau xơp, nek nôôq he e bâân iêm lóóm palơq nôôq rau achêk. <verse eid="1TI 6:8" /><verse number="9" style="v" sid="1TI 6:9" />Dyơq nôôq đu kiêng val xar karvaan kabhôôq nek xruuk leq dharơơl galơơk, lơq mơk biêng, palơq bơk kiêng malóóch ngôôk ngaak, mahaai mahư, hơq nek nôôq rau dyruq paklêch akóón manưih mót leq hư huông lơq chêt bil. <verse eid="1TI 6:9" /><verse number="10" style="v" sid="1TI 6:10" />Taai tââm riêh ưng dyóp rau đu aak nek rau n'thaam jêên, hơq mưi phơn manưih, taai malóóch rahaal ađó, ơi bâân đââng dharơơl gluh tââq lóóm huuiq lơq têêng tarơh tachơơng đóng ađêi palơq bơk ranguôq jarnah.<verse eid="1TI 6:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="1TI 6:11" />Bơơi akóón, manưih ưng Yaang Pleng ơơi, phaai viêr changaai nôôq rau achêk, hơq viêng tapun rau bhơt liêm, huuiq bhi, lóóm huuiq, lóóm tanhơr, lóóm đơơp jruôn, lơq m'pheep dha-iiq. <verse eid="1TI 6:11" /><verse number="12" style="v" sid="1TI 6:12" />Phaai tarjeng tarvei kalóóng galuh pađuôh tarjơl yaal liêm ưng lóóm huuiq, phaai jư tamưng rau parmông nh'chró, nek rau đu akóón ơi bâân dhaloong tơk lơq ơi ng'kóh paraaq đơơp n'tóól liêm kre toom bơk manưih lêi. <verse eid="1TI 6:12" /><verse number="13" style="v" sid="1TI 6:13" />Aku truuih kayua đóng akóón toom mat Yaang Pleng, Yaang têêng đóng dyóp rau bâân mamông, lơq toom mat Jê-su Chuôq Paq Manưih, Yaang gluh pakah paraaq đơơp n'tóól liêm kre dhiq Bôôn-xơ Phi-laat, <verse eid="1TI 6:13" /><verse number="14" style="v" sid="1TI 6:14" />kơi akóón phaai xâng jư paraaq trêh pachóóm ađô kơi óóq anhuq anhaach, yươq dhiq trêh jươm, đóng tơk tangêi bhral ưng Chuôq nôôq he, nek Chuôq Jê-su Paq Manưih, <verse eid="1TI 6:14" /><verse number="15" style="v" sid="1TI 6:15" />nek Yaang đu Yaang Pleng Bhơt Yaal đaang bhi haanh lơq mưi giêl, nek Bhua ưng nôôq bhua lơq Chuôq ưng nôôq chuôq, e gluh pakah leq dhalam tangêi kaxe, <verse eid="1TI 6:15" /><verse number="16" style="v" sid="1TI 6:16" />chapiên mưi Ađó ve yươq chóóm chêt, jaq kalóóng đu brương kah chóóm tơk pađan, nek Yaang kah ngaai ơi glêh lêi, kung kah ngaai ve chóóm bâân lêi, nhan rau bhi chap lơq mataai raman nh'chró chô leq Ađó. A-meen.<verse eid="1TI 6:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="1TI 6:17" />Phaai truuih móón manưih karvaan dhiq đơơi ađôk óóq praaq laach, kung óóq rââm ganơơm dhiq drươp karvaan dhakơi kah mưng, hơq rââm ganơơm dhiq Yaang Pleng, Yaang đóng leq nôôq he dyóp rau kơi bơk ơơl buôn bhuui đơơp, <verse eid="1TI 6:17" /><verse number="18" style="v" sid="1TI 6:18" />lơq truuih yua piđó têêng rau liêm, xưa raai kalóóng tarnêêng liêm, ve lóóm bhươh rông, đương ravang paak blah, <verse eid="1TI 6:18" /><verse number="19" style="v" sid="1TI 6:19" />katiêq lơơi đóng chênh ađêi mưi janơơng liêm kre đóng rau ravang tơk, buôn piđó ve chóóm jư tamưng parmông lalua.<verse eid="1TI 6:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="1TI 6:20" />Ti-mô-thê ơơi, akóón phaai jư lêi rau bâân huuiq pajaau đóng akóón, viêr n'đóch nôôq chiên kah makoq machak dhiq katiêk, lơq nôôq tarkaai tarlak khin móón nek bhriêl tabech, <verse eid="1TI 6:20" /><verse number="21" style="v" sid="1TI 6:21" />hơq mưi phơn manưih taai praaq karơ kơi achêk, ơi vôôiq lơt hót lóóm huuiq.</para>
  <para style="p" vid="1TI 6:21">Nhan ơơn phươk liêm tơơt palơq nôôq adhi anó.<verse eid="1TI 6:21" /></para>
  <chapter eid="1TI 6" />
</usx>