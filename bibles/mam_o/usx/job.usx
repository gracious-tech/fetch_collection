<?xml version="1.0" encoding="utf-8"?>
<usx version="2.6">
  <book code="JOB" style="id">JOB.TXT Enero 2,009 Pedro D. Mam Ostuncalco. Updated for DBL by G. Grasso and E. Canales, December 2012, standardization after migration to PT8 by A. Camus March, 2019.</book>
  <para style="h">Job</para>
  <para style="toc3">Job</para>
  <para style="toc2">Job</para>
  <para style="toc1">Tu'jil Job' (Job)</para>
  <para style="mt1">JOB'</para>
  <para style="mt2">(Job)</para>
  <para style="imt">CHIK'B'AB'L</para>
  <para style="ip">Tuk'i'ltzunju' u'j Job' nqo oka' kyoju' ch'ix u'j kye tb'anilxim. Nyolin u'j lu ti'j jun ojtxi' chmanb'aj, Job' tb'i, nb'etje, b'a'n xjal, nimaq q'inun ex nim txqan tk'wal, tzaj jun k'ulb'a'n ti'j majx kub'o'lj: kub'aj tkyaqilju' ati te, eb'aj kyimju' tk'wal toj txqan xitb'il, ex tzaj jun yab'il kuwxi'x ti'j, majx ponxtwitz.</para>
  <para style="ip">A lab'te'nju' ti'j tu'n tpaj tzaj txqan yajb'il ti'j, extzun kukxju' b'a'n xjaltoq, intoq niman te Dyos ex b'a'n tnab'l. Kyximaju' tamiw qa ati te Job' til, naq a toj ewaj, qu'mtzun intoq yajta' b'a'nxi'x.</para>
  <chapter number="1" style="c" />
  <para style="s1">Taj Dyos tu'n tkub'yajti Job'</para>
  <para style="p">
    <verse number="1" style="v" />Atitoq jun ichan Job' tb'i toju' tx'otx' Us, intoq anq'in toj ttxolilti'j ex mixti' jun taq'wix ntb'incha'n, ex b'a'n ajb'eltoq te Dyos, intoq oktq'o'n tilil tu'n lalun tb'incha taq'wix te juntl xjal. <verse number="2" style="v" />Ate'toq wuq tk'walu' Job' ex oxe' tmyal, <verse number="3" style="v" />ex ate'toq wuqlajk'al lajnaq (7,000) trit, wuqk'al lajnaq (3,000) tchej kamey, junk'al jo'naq (500) muj twakyix ex junk'al jo'naq (500) tb'ur. Ex ikx nim txqan tmajin lq'o'n. Atoq nimaq q'inunju' toj tkyaqilju' tx'otx' tjawetzq'ij.</para>
  <para style="p">
    <verse number="4" style="v" />Naq'lqe'toqju' tk'wal Job' tu'n kyok nimaqwan kyu'n tjayile junjunkye, txoli'n nche'xa' ex intoq che kytxko'nju' oxe' kyanab'. <verse number="5" style="v" />Tb'ajlenxi'tzu'n nimaqwan kyu'n, intoq che txko'njtz tu'n Job', prim njawe', q'ol chojb'il k'ok'sb'il tu'n junjunju' tk'wal. Intoq tb'incha'n Job' ja'lu kukxju', qu'n nkub' t-xima'n qaj ma che b'inchan ilju' tk'wal ex qaj mache' ilin ti'j Dyos toj kyanmi.</para>
  <para style="p">
    <verse number="6" style="v" />Jun q'ij eponju' ajb'el toj kya'j twitz Qman Dyos, ex ikx ponju' anjl poqol kxol. <verse number="7" style="v" />Xitqani'n Qman Dyos te:</para>
  <para style="q">—¿Jasaja'ya? chij.</para>
  <para style="q">Atzun anjl poqol xittzaq'we'n:</para>
  <para style="p">—Ntx'anje' b'etel toj tkyaqil twitz tx'otx' ex mab'aj nxb'etzane' ti'jile', chij.</para>
  <para style="p">
    <verse number="8" style="v" />Xi'tzun tma'n Qman Dyos te:</para>
  <para style="pi">—¿Ma matz'ok tka'yi'na nmajine' Job'? Mix-a'lo' juntl xjal twitz tx'otx' kse'nte, inwt ajb'en weye' b'a'nxi'x ex inwt nanq'in toj tu'me'l ex inwt oktq'o'n tilil tu'n lalun tb'incha jun taq'wix ti'j juntel, chi Dyos.</para>
  <para style="p">
    <verse number="9" style="v" />Atzunte' anjl poqol xittzaq'we'n:</para>
  <para style="p">—Myana' naqkukx najb'ente' b'a'nxi'x teya. <verse number="10" style="v" />Mixnati' ntjo'na tu'n t-xiyeku'n, e'tojtja exju' ati te; inkub' tky'i'wla'na tkyaqilju' ntb'incha'n, extzun ate nimaq q'inun, nim txqan twaqix toj tkyaqilju' tx'otx'. <verse number="11" style="v" />Q'imilchaqa tkyaqil te, atzun q'iju' kjawil miltz'uj ti'ja, chij. <verse number="12" style="v" />Xi'tzun ttzaq'we'n Qman Dyos teju' anjl poqol:</para>
  <para style="p">—B'a'natzun, B'inchama tajb'ila ti'j tkyaqilju' ati te Job', atzunte lalun tb'inchaya jun taq'wix ti'j, chi Dyos te. Ik'b'ettzuntz twitz Qman Dyos.</para>
  <para style="p">
    <verse number="13" style="v" />Jun q'ij, intoq kyb'incha'n tk'wal Job' exqe' tmyal jun ninwan tja tzikb'aj, <verse number="14" style="v" />pon jun ichan tja Job' q'malte jun tqanil:</para>
  <para style="p">—Intoq qokjone' toj kojb'il kyuk'i'l wakx; exqe' ttxu b'ur intoq che wan nqaku'; <verse number="15" style="v" />naq minab'enx e'pon aj Sab'a, ex mache'x kyelq'an wakx ex mache kub' kyb'yo'n ichan tu'n kchil. Noq o'qinkxe' ẍin tzaqpaj tu'n wule' q'malte teya, chij.</para>
  <para style="p">
    <verse number="16" style="v" />Na'mxtoqpe' tb'aj yolinju' ichan lu, tej tpon juntl q'malte:</para>
  <para style="p">—Makub' jun q'ankyaq ex mache kyimju' k'ik'lel tu'n exqe' rit. Noq oqinkxwe' ẍin klet tu'n ntzaje' q'malte teya, chij. <verse number="17" style="v" />Na'mxtoq tb'aj yolinju' ichan lu, tej tponju' toxi'n:</para>
  <para style="p">—Mache pon oxe' tnej kaldey q'ojil qi'je' ex mache b'ajx kyelq'an kamey, ex mache kub' kyb'yo'n ichan tu'n k'uẍtx'e'nb'il. Noq o'qinkxwe' ẍin klet tu'n wule' q'malte teya, chij.</para>
  <para style="p">
    <verse number="18" style="v" />Ex na'mxtoq tb'aj yolinju' ichan lu, tej tpon juntl ex tma:</para>
  <para style="p">—Ate'toqu' tk'wala ex tmyala toj jun ninwan tjaju' tzikb'aj, <verse number="19" style="v" />noqminab'en saj jun kyq'iq' toj chq'ajlaj ex matz'ok tjuma'ntib' kyi'ju' tkyajil ttx'u'k ja, ex makub' tz'aq kyib'aju' tk'wala. Kykyaqilx ẍekyim. Noq o'qinkxwe' ẍin klet tu'n wule' q'malte teya.</para>
  <para style="p">
    <verse number="20" style="v" />Jawtzun we' Job', tzaj txqan tb'is ex kub' tlaqu'n t-xb'alun, el t-sk'o'ji'n twi' ex kub' tzipe k'ulul. <verse number="21" style="v" />Tmatzuntz:</para>
  <para style="p">—Ẍb'iqlqine' tej wule' twitz tx'otx', ex ẍb'iqlqine' ajwik'e'. Ate Qman Dyos saj q'onte tkyaqil weye', ex axte sel q'inte weye'; ¡Ky'i'wla'nxwit tb'i Qman Dyos! chij.</para>
  <para style="p">
    <verse number="22" style="v" />Tu'ntzun tkyaqil ja'lu, mixti' b'inchan il Job' ex mixti' jun taq'wixil tma ti'j Qman Dyos.</para>
  <chapter number="2" style="c" />
  <para style="p">
    <verse number="1" style="v" />Tetzunj tpon q'ij tu'n kyponju' ajb'el toj kya'j twitz Qman Dyos, ex ikx pon anjl poqol kyxol. <verse number="2" style="v" />Xitqani'n Qman Dyos te:</para>
  <para style="p">—¿Jasaja'ya?</para>
  <para style="p">Xi'tzun ttzaq'we'n poqol te:</para>
  <para style="p">—Matxi' b'aj nẍchu'ne' tkyaqil twitz tx'otx'.</para>
  <para style="p">
    <verse number="3" style="v" />Atzunte Qman Dyos xitma'n te:</para>
  <para style="p">—¿Ma matxi' tz'ok tka'yi'na nmajine' Job'? Mixti' juntl xjal twitz tx'otx' kse'nte, o'kxtzu' najb'ena' weye' ex nanq'in toj tnik'alti'j, mixti' ttzakajil, ex nxitka'yi'n, tu'n lalun tb'incha jun taq'wix te juntl. Maskye matxi' tz'oktb'incha'na taq'wix ti'j ex mixti' tpaj, wa'lxi'xte toju' tchwinqlal mixti' ttzakajil, chi Dyos.</para>
  <para style="p">
    <verse number="4" style="v" />Atzunte' poqol xittzaq'we'n te Qman Dyos:</para>
  <para style="p">—Qa min sokyeku'n aku', tkyaqil b'a'nile. Jaku' tzik'x tu'nte' ichan naq tu'n tkletju' tchwinqlal. <verse number="5" style="v" />K'ixb'sankchaqa, atzun tila qa min xyasun ti'ja twitzku'ya, chij te Dyos.</para>
  <para style="p">
    <verse number="6" style="v" />Atzunte Qman Dyos xittzaq'we'n teju' poqol:</para>
  <para style="p">—B'a'natzun, b'inchama te aju' tajb'ila, naq o'kx lalun kub' tb'yo'na, chi Dyos.</para>
  <para style="p">
    <verse number="7" style="v" />Ik'b'ettzuntz twitz Qman Dyos, ex tzaj t-sma'n jun yab'il taq'wixi'x ti'j tchib'jil Job' tzajx t-xe tqan japumnix toj twi'. <verse number="8" style="v" />Atzunte Job' xi' qeb'il tk'etz jun ch'uq tz'is, ex tzaj tiq'i'n jun piẍ ttx'anqa'n k'wil jotz'b'il ti'j. <verse number="9" style="v" />Atzu'n t-xu'jil xitma'n te:</para>
  <para style="p">¿Ma ljo'ntzun tanq'ina b'a'n? ¡Yasunxa Dyos, kyimkutzunja! chij.</para>
  <para style="p">
    <verse number="10" style="v" />Atzunte Job' xittzaq'we'n:</para>
  <para style="p">—¡Qya, lalun tz'ok toj twi'ya! Ina' qk'mo'nju' ti'xti' b'a'n ntzaj tq'o'n Dyos qe, ¿tiqu'ntzun lay qk'amu' myab'a'n? chij.</para>
  <para style="p">Iktzu'n, toj tkyaqil ja'lu min b'inchan il Job', tk'i'xpe'wt tu'n tyol.</para>
  <para style="s1">E'ponju' tamiw Job' ka'yilte</para>
  <para style="p">
    <verse number="11" style="v" />Ate'toq oxe' tamiw Job': a junju' Elipas, najli toju' tx'otx' Teman, ex B'iltad, najli toju' tx'otx' Swa, ex Sopar, najli toju' tx'otx' Naamat. Tej kyb'inte tkyaqilju' taq'wix tzaj ti'j Job', kub' kyxima'n tu'n kxi' q'uqb'alte tk'u'j ex tu'n kyten tuk'i'l toju' k'ixk'oj. <verse number="12" style="v" />Atixtoq tu'n kypon tk'etz, kyilu' Job', ex peni ela' kynik' te, e'aq'witzuntz ẍch'il ex oq'el, tu'nju' exch'yon toj kyk'u'j, xikyẍilu'n kxb'alun ex jaw kychto'n quq toj kyq'iq' ex tzaj chitj toj kwi'. <verse number="13" style="v" />E'kub' qetzuntz twitz tx'otx' tuk'i'l, e'kub'ten wuq q'ij ex wuq qonik'an tk'etz, mixti'xte jun kyol kyma, qu'n okkyka'yi'n kuwtoqju' k'ixk'oj ti'j Job'.</para>
  <chapter number="3" style="c" />
  <para style="s1">Tna' Job' k'ixk'oj</para>
  <para style="p">
    <verse number="1-2" style="v" />Chab'ax tjaw yolin Job', ex yasun ti'ju' q'ij titz'jlen.</para>
  <para style="sp">Job'</para>
  <para style="q">
    <verse number="3" style="v" />¡Mixyab'a'nju' qonik'an tej tok iqan nwiye' tu'n ntxuye'!</para>
  <para style="q">¡Mixwit nitz'ja'ye' tej tpon nq'ijlalile'! <verse number="4" style="v" />¡Naqwit kub' qloljix toju' q'ij lu,</para>
  <para style="q">exwit ik'tna'l tu'n Dyos</para>
  <para style="q">ex mixwit sqixa'ju' q'ij lu! <verse number="5" style="v" />¡Junwt leku'n qxopinxi'x tzaj qloljsalte,</para>
  <para style="q">mujqa jun q'eqmuj kub' juptz'ante,</para>
  <para style="q">mujqa jun klis tzaj xob'tzalte!</para>
  <para style="q">
    <verse number="6" style="v" />¡Kub'wit naju' qonik'an lu toj qlolj</para>
  <para style="q">exju' q'ij miwtlo junti' okq'o'n toj tajlal xjaw! <verse number="7" style="v" />¡Mixwitloti'xte jun itz'ji toju' qonik'an lu,</para>
  <para style="q">mixwitloti'xte sich' te tzalajb'il lu! <verse number="8" style="v" />¡Noqwit ikj kyqani ajk'a taq'wix ti'j,</para>
  <para style="q">ju' ati kyipumal tib'aj Leb'yatan! <verse number="9" style="v" />¡Noqwit min e'qoptz'aj che'w toju' prim lu,</para>
  <para style="q">exwitlo min ulju' spik'un nayonjtz,</para>
  <para style="q">exwitlo min ilwi tej ttzaj t-xe kya'j!</para>
  <para style="q">
    <verse number="10" style="v" />¡Tzajwit txko'n toj twi' qonik'an tej witz'jiye'</para>
  <para style="q">miwtlo jun xwilju'ye' txqan yajb'il!</para>
  <para style="q">
    <verse number="11" style="v" />¿Tiqu'n min nkyime' ti'j ntxuye',</para>
  <para style="q">mujqa nkyimwite' tej witz'jiye'?</para>
  <para style="q">
    <verse number="12" style="v" />¿Tiqu'n nkub'a' chle'ne' tib'aj tqan ntxuye'</para>
  <para style="q">ex nch'une' ti'j?</para>
  <para style="q">
    <verse number="13" style="v" />Naqwit ikj nkyime' atxi'xju',</para>
  <para style="q">inwtlo chin wtane' ja'lo</para>
  <para style="q">inwtlo chin ojlane' toj nak'b'il,</para>
  <para style="q">
    <verse number="14" style="v" />kyuk'i'l nimaqkawil exqe' nuk'ul toj kawb'il</para>
  <para style="q">b'incha'n kyja nimaq kywe' toj muqb'il,</para>
  <para style="q">
    <verse number="15" style="v" />mujqa kyuk'i'lju' nche' kawin</para>
  <para style="q">nkynojsa'n tja nimaqkawb'il tu'n q'anpwaq ex saqpwaq.</para>
  <para style="q">
    <verse number="16" style="v" />¿Tiqu'n min nku'x mqu'ne' kse'nkye e'li'n,</para>
  <para style="q">kse'nkye' k'wal nche kyim na'mxtoq kyitz'ji?</para>
  <para style="q">
    <verse number="17" style="v" />Toju' muqb'il nb'aja' yajte'n kye' b'inchal myab'a'n,</para>
  <para style="q">ex nche ojlanju' siktniqe';</para>
  <para style="q">
    <verse number="18" style="v" />atzu' nkneta' nak'b'il kyu'nju' jpu'nqe',</para>
  <para style="q">ex lay kyb'itlju' kyẍalb'e'n chq'ol aq'unal;</para>
  <para style="q">
    <verse number="19" style="v" />Junelnitzunte' kyilwi nimaq ex k'oke' atzu',</para>
  <para style="q">exqe' lq'o'n majen nche tzaqpaj toj kyq'ob'ju' kyajaw.</para>
  <para style="b" />
  <para style="q">
    <verse number="20" style="v" />¿Tiqu'ntzunlo ntjo'na' Dyos tu'n tlonteju' nyajt spik'un?</para>
  <para style="q">¿Tiqu'n ati tchwinqlalju' noqnk'ayix toj ttzi,</para>
  <para style="q">
    <verse number="21" style="v" />aju' ntqani'n tkamik mixjun kyim,</para>
  <para style="q">maskye nik'xi'x tjoyli tu'n kyetwitz jun k'uwenj e'wa'n?</para>
  <para style="q">
    <verse number="22" style="v" />ktzalajelte' ichan lu</para>
  <para style="q">tzmaxi'j ajtpon toj muqb'il.</para>
  <para style="q">
    <verse number="23" style="v" />Naq ntakanjete xjal tu'n Dyos,</para>
  <para style="q">jaxja matxa' mqonilete' tb'e.</para>
  <para style="b" />
  <para style="q">
    <verse number="24" style="v" />A nwaju'ye' jiq'cha'n;</para>
  <para style="q">ex a nk'wa'ju'ye' t'i'nje'n toj k'ixk'oj.</para>
  <para style="q">
    <verse number="25" style="v" />Tkyaqilju' ntzaj tchi wi'je'</para>
  <para style="q">exju' nxob'le'ne',</para>
  <para style="q">matxi' tz'oktz'aq wi'je'.</para>
  <para style="q">
    <verse number="26" style="v" />Mixti'x ojb'il weye';</para>
  <para style="q">naqx yajb'il atinqina'ye', mixti'xte nak'b'il, chi Job'.</para>
  <chapter number="4" style="c" />
  <para style="s1">Tnejel tnej yol kyxol</para>
  <para style="r">(Caps. <ref loc="JOB 4-14">4—14</ref>)</para>
  <para style="sp">Elipas</para>
  <para style="q">
    <verse number="1-2" style="v" />Axxi'x, Job', miloyab'a'n toj twitza</para>
  <para style="q">tu'n tokten jun xjal yolil tuk'i'la,</para>
  <para style="q">naqtzun aju' ilti'j tu'n tb'ajx q'met teya.</para>
  <para style="q">
    <verse number="3" style="v" />A pena'ya xnaq'tzalkye txqan xjal</para>
  <para style="q">ex nche'x tkuwsa'na mixti' kyipumal;</para>
  <para style="q">
    <verse number="4" style="v" />ana'ya, njaw wab'anteju' nkub' tz'aq tu'n tjawe'</para>
  <para style="q">ex ntoni'nju'ya xi' tkub' tz'aq,</para>
  <para style="q">
    <verse number="5" style="v" />Atzu'n ja'lo tu'nju' makub' tz'aqa toj,</para>
  <para style="q">nkub'numja ex matzaj tchewal ti'ja.</para>
  <para style="q">
    <verse number="6" style="v" />Aya jun b'a'n ajb'el te Dyos,</para>
  <para style="q">jun ichan tnik'alti'j,</para>
  <para style="q">¿Tiqu'ntzun min nqe tk'u'ja?</para>
  <para style="q">
    <verse number="7" style="v" />Ximanku'ya, na'ntza</para>
  <para style="q">¿jtoje tila jun xjal kub'ajsa'n qa mixti' til?.</para>
  <para style="q">
    <verse number="8" style="v" />A twitzlalilju' oje wile',</para>
  <para style="q">aye'ju' nkuxkawa'n b'yojwnaqi'n ex myab'a'n</para>
  <para style="q">ax nkykotzi'nju' kuxni kyawa'n.</para>
  <para style="q">
    <verse number="9" style="v" />Ajttzaj ttx'u'jil Qman Dyos, jun jub'chanqe'x tu'n t-xew</para>
  <para style="q">ex majx nche kub' tnajsa'n.</para>
  <para style="q">
    <verse number="10" style="v" />Maskye nche tzanin ex nche xo'jin kse'n b'alun,</para>
  <para style="q">che qenb'il tzmaxi'j ajtetz q'uchi'n kywitzte tu'n Dyos.</para>
  <para style="q">
    <verse number="11" style="v" />Che kyimel kse'nqe' b'alun min nknetl kychi',</para>
  <para style="q">aye'tzu'n kyal che b'ajex slamj.</para>
  <para style="q">
    <verse number="12" style="v" />Matzaj jask'u'n jun tqanil weye',</para>
  <para style="q">chab'a ex penixi'x xnb'iye'.</para>
  <para style="q">
    <verse number="13" style="v" />Matz'ok txqan toj nwitze' qonik'an tej ẍeb'jik'wtan xjal,</para>
  <para style="q">majx ẍinkub' tyoq'o'ne'.</para>
  <para style="q">
    <verse number="14" style="v" />Majx sok jun tchiylal wi'je';</para>
  <para style="q">ex majx ẍin jaw lu'lune'</para>
  <para style="q">
    <verse number="15" style="v" />Matzaj xupi'n toj nwitze'</para>
  <para style="q">ex majx saj salan wi'je'.</para>
  <para style="q">
    <verse number="16" style="v" />Wa'ltoq jun atzu',</para>
  <para style="q">xinka'yine' tewin</para>
  <para style="q">atzu'n ka'yin min wile'</para>
  <para style="q">mix-a'loxte' nyukchi... Xitzun nb'i'ne' jun tq'ojq'ojel wi'yj, tma:</para>
  <para style="q">
    <verse number="17" style="v" />¿Ma jaku'tzun tz'okju' ichan tz'aqli twitz Dyos?</para>
  <para style="q">¿Ma ẍnu'lxixtzunlo twitzju' ch'isalte?</para>
  <para style="q">
    <verse number="18" style="v" />Mipena' jun nqexi'x tk'u'j kyi'ju' ajb'el te toj kya'j.</para>
  <para style="q">In pena' elyal kytzakajilju' anjl tu'n,</para>
  <para style="q">
    <verse number="19" style="v" />¡mitzunloyate' ichan majx numjni</para>
  <para style="q">iku' se'n jun ja xoq'l t-xe jawni b'incha'n toj tz'awun,</para>
  <para style="q">naq tu'n ch'i'n kb'el quqix kse'n pok' ajtkub' wab'e'n!</para>
  <para style="q">
    <verse number="20" style="v" />Ajtex q'ij matxitoq kub' xitj;</para>
  <para style="q">kb'ajel tejumajx ex mix-a'lo' ati toklen ti'j.</para>
  <para style="q">
    <verse number="21" style="v" />Intaqk'uj tchwinqlal kse'n jun q'in;</para>
  <para style="q">layx japun kanun ti'ju' nab'l ajtkyim.</para>
  <chapter number="5" style="c" />
  <para style="q">
    <verse number="1" style="v" />Ẍch'ina, Job', alkyetzun matzaj tzaq'wenteya.</para>
  <para style="q">¿Alkye jun anjl kxela' tma'na?</para>
  <para style="q">
    <verse number="2" style="v" />Nche kyimju' xnak</para>
  <para style="q">tu'n kypi'sal ex kytx'u'jil.</para>
  <para style="q">
    <verse number="3" style="v" />Oje wile' xnak xi'toq tjaw b'ent,</para>
  <para style="q">ex lwiy kutxa'jtl.</para>
  <para style="q">
    <verse number="4" style="v" />Mix-a'lo' onilkyeju' tk'wal;</para>
  <para style="q">min nb'inchanjtz tnik'alilti'j kye toju' kawb'il</para>
  <para style="q">ex mix-a'lo' jun klol kye.</para>
  <para style="q">
    <verse number="5" style="v" />Nxiwanju' twitz kyawal kyu'n nche we'yajti</para>
  <para style="q">inb'aj kyjyo'n kyxol ch'i'x,</para>
  <para style="q">aye'tzu'n nxi'x che k'wajti majx nwalti'j kyk'u'j tu'nju kyq'inumal.</para>
  <para style="q">
    <verse number="6" style="v" />Myatzu' ntzaja' poq'lite' il twitz tx'otx';</para>
  <para style="q">ex myatzu' ntzaja' anq'inju' yajb'il toj tx'otx':</para>
  <para style="q">
    <verse number="7" style="v" />axte xjal ntzaj q'inte tq'ob' tze toj twi',</para>
  <para style="q">kse'n txqan q'aq' axtzu' netza' tx'itj tqan taq' ti'jx.</para>
  <para style="q">
    <verse number="8" style="v" />Noqwit ayinwe' aya, jaku' txinqani'nwe' o'nb'il te Dyos</para>
  <para style="q">atzunju' wile' jaku' kub' nq'o'ne' toj tq'ob';</para>
  <para style="q">
    <verse number="9" style="v" />¡Intb'incha'nte txqan ti'xti' nim toklen te lab'te'n,</para>
  <para style="q">e'ti'xti' mix-a'lo'x jun nkane' toj twitz!</para>
  <para style="q">
    <verse number="10" style="v" />Ate ntzaj q'onte jb'al twitz tx'otx',</para>
  <para style="q">tu'ntzunju' ntak'sana' twitz tx'otx';</para>
  <para style="q">
    <verse number="11" style="v" />a njaw nimsankye me'sqe'</para>
  <para style="q">ex ntq'uqb'a'n kyk'u'ju' teqe' toj b'is;</para>
  <para style="q">
    <verse number="12" style="v" />ate nkub' xitu'nte t-ximju' xjal tx'yan tuk'i'l,</para>
  <para style="q">ex a nb'inchante tu'n mijapuna'.</para>
  <para style="q">
    <verse number="13" style="v" />A nxpatxab'inte xjal tx'yan tuk'i'l tojxju' ttx'yamal,</para>
  <para style="q">ex a nb'inchante tu'n mijapuna' t-xim taq'wix:</para>
  <para style="q">
    <verse number="14" style="v" />¡naq nche takajla tojku' tqan q'ij,</para>
  <para style="q">juplikyi'j tu'n qlolj, naku'xwitloj te qonik'an!</para>
  <para style="q">
    <verse number="15" style="v" />Ate Dyos klolte prow exju' yajla'n</para>
  <para style="q">toj kyq'ob'ju' b'inchal taq'wixil;</para>
  <para style="q">
    <verse number="16" style="v" />ate Dyos q'uqb'al kyk'u'ju' nche numj,</para>
  <para style="q">¡ate njpunte kytziju' b'inchal taq'wixil!</para>
  <para style="b" />
  <para style="q">
    <verse number="17" style="v" />B'a'nte' teju' xjal ntzak'unjtz tu'n Dyos;</para>
  <para style="q">lalun tz'el tik'u'na ttzak'b'il Dyos nimtipumal.</para>
  <para style="q">
    <verse number="18" style="v" />Qama k'ixb'san, ex in tq'a'na';</para>
  <para style="q">qama b'ujun tu'n tq'ob' ex tzul chewsalte.</para>
  <para style="q">
    <verse number="19" style="v" />Kklonjtzela tu'n kukxju' teju' xob'ajil,</para>
  <para style="q">ex lay taj tu'n toktz'aq taq'wixil ti'ja.</para>
  <para style="q">
    <verse number="20" style="v" />Toj tq'ijlalil we'yaj kyklonjtzela tu'n twitz kamik,</para>
  <para style="q">ex toj tq'ijlalil q'oj kyklonjtzela tu'n teju' k'uẍtx'e'nb'il.</para>
  <para style="q">
    <verse number="21" style="v" />Kklonjtzela tu'n kyeju' mya'l kyaq',</para>
  <para style="q">ex lay xob'ta aj tk'ulb'ana.</para>
  <para style="q">
    <verse number="22" style="v" />Kjawil tze'na ti'ju' we'yaj ex yajb'il ajttzaj ti'ja,</para>
  <para style="q">ex lay xob'a kyeju' tojk'ul txkup.</para>
  <para style="q">
    <verse number="23" style="v" />Lay tokpaja kyi'j ab'j toj tkojb'ila,</para>
  <para style="q">ex che okyelju' tojk'ul txkup te tamiwa.</para>
  <para style="q">
    <verse number="24" style="v" />Kjawil b'enta toj tjaya,</para>
  <para style="q">ex tz'aqliqe' twakyixa ajkyxi tka'yi'na.</para>
  <para style="q">
    <verse number="25" style="v" />Ktenb'el txqan tk'wala</para>
  <para style="q">kse'n itzaj nb'ajtzaj ch'iy toj kojb'il.</para>
  <para style="q">
    <verse number="26" style="v" />Kuwxta ajttijina,</para>
  <para style="q">kse'n jun pchoj triy tijtl b'a'nxi'x.</para>
  <para style="q">
    <verse number="27" style="v" />Tu'nju' twitzlalil nela' qnik' ti'j;</para>
  <para style="q">b'inxpe'ya, ex b'inchanxa aku'ya, chi Elipas.</para>
  <chapter number="6" style="c" />
  <para style="sp">Job'</para>
  <para style="q">
    <verse number="1-2" style="v" />Noqwit b'a'nt tmlet tkyaqilju' nb'ise' toj jun tqan peẍ</para>
  <para style="q">exju' matxi' chin nik'a'ye',</para>
  <para style="q">
    <verse number="3" style="v" />jaku'lo alxi'x kyetwitz tz'awun ttzi ninnjab'.</para>
  <para style="q">Qu'mtzun ma'x tzaj yol toj ntziye'.</para>
  <para style="q">
    <verse number="4" style="v" />Machin tzajt-smaji'ne' Dyos nimtipumal,</para>
  <para style="q">ex matxi' tz'ex meq'eq'enju' tb'iyb'il toj nwinqile'.</para>
  <para style="q">Matxi' tzaj tchewal wi'je' tu'n nchin tzajt-xone' Dyos.</para>
  <para style="q">
    <verse number="5" style="v" />¿Ma ntzun noq'ju' chej qa ati twa?</para>
  <para style="q">¿Ma noq'ju' tman wakx qa ati twa?</para>
  <para style="q">
    <verse number="6" style="v" />¿Alkye jun nwan qa mixti' tatz'mil t-xilel twa?</para>
  <para style="q">¿Ma b'a'ntzun jun ti'xti' mixti' tk'ok'jal?</para>
  <para style="q">
    <verse number="7" style="v" />Aju' min wajb'ile' tu'n nwanteye'</para>
  <para style="q">atzun nwaju'ye' ja'lo.</para>
  <para style="q">
    <verse number="8" style="v" />¡Noqwit tzaj ttzaq'we'n Dyos weye' aju' nxi' nqanine' te;</para>
  <para style="q">noqwit japunju' wajb'ile' tu'n!</para>
  <para style="q">
    <verse number="9" style="v" />¡Noqwit ikj kub' t-xima'n Dyos tu'n nkub' tb'ajsa'ne',</para>
  <para style="q">ex tu'n nmankune' tejumajx!</para>
  <para style="q">
    <verse number="10" style="v" />Jakuxi'xlo qewe' nk'u'j ikju',</para>
  <para style="q">qu'n kuwte' tchib'l k'ixk'oj,</para>
  <para style="q">ina' nnima'nwe' xjan tkawb'il Qman Dyos kukxju'.</para>
  <para style="q">
    <verse number="11" style="v" />Matxi' b'aj wipumale' tu'n tik'x wu'ne',</para>
  <para style="q">ex mixti'tl tu'me'l tu'n wanq'ine'.</para>
  <para style="q">
    <verse number="12" style="v" />Myana' ab'jqine' kse'n pik,</para>
  <para style="q">ex mya kuwqine' kse'n q'ank'uxb'il.</para>
  <para style="q">
    <verse number="13" style="v" />Mixti'tl wajb'ene' njunalxe',</para>
  <para style="q">ex mix-a'lo' onilweye'.</para>
  <para style="q">
    <verse number="14" style="v" />Ink'u'jlanjtzju' amiw qa nyajti,</para>
  <para style="q">maskye mya' wa'lxi'x twitz Dyos nimtipumal.</para>
  <para style="q">
    <verse number="15" style="v" />Aye'tzunkye' wamiwqeye', taq'wix xkyb'inchaye' weye',</para>
  <para style="q">naku'j a' nche kub' tzqij.</para>
  <para style="q">
    <verse number="16" style="v" />Kse'n a' nku'tz tziltwitz,</para>
  <para style="q">smo'n twitz tk'i' txun che'w ex saqche'w;</para>
  <para style="q">
    <verse number="17" style="v" />ajtzun tkub' naju' che'w,</para>
  <para style="q">che tzqijelju' ttxiklil a', ajtjaw q'ij nkunaju' a'.</para>
  <para style="q">
    <verse number="18" style="v" />Tu'ntzunju' nela' kypa'n kyib'ju' ajb'etil ti'j kyb'e,</para>
  <para style="q">xi'n che'xa'tl toj chq'ajlaj ex majx nche kyim.</para>
  <para style="q">
    <verse number="19" style="v" />Aye' ajb'etil nche tzaj Tema ex Sab'a</para>
  <para style="q">q'uqlok kyk'u'j nik'tjoyli a' kyu'n,</para>
  <para style="q">
    <verse number="20" style="v" />Ajtzun kypon naq nelyal kyka'yin</para>
  <para style="q">ex nche jaw k'olin.</para>
  <para style="q">
    <verse number="21" style="v" />Ikyqetzunju'ye' weye':</para>
  <para style="q">nok kyka'yine' se'n ta'qine' ex nche b'ajxob'e'.</para>
  <para style="q">
    <verse number="22" style="v" />Mixti'we' nxi'nqani'n kyeye',</para>
  <para style="q">tu'n ttzaj kyq'o'n pwaqe' kolb'ilweye',</para>
  <para style="q">
    <verse number="23" style="v" />mo tu'nwt nklete' kye waq'oje,</para>
  <para style="q">mo tu'n welkyklo'ne' toj kyq'ob' eleq'. <verse number="24" style="v" />Kyxnaqtzantz chaqe' weye', atzun chin kub'numeye':</para>
  <para style="q">kyek'untze' jata' myab'a'n xnb'inchaye'.</para>
  <para style="q">
    <verse number="25" style="v" />Mix-a'lo'te k'elel ik'unte jun yol ttxolilti'j;</para>
  <para style="q">aye'tzunkye' nchin kyb'ajsane' mya' toj tu'me'l.</para>
  <para style="q">
    <verse number="26" style="v" />Nche yoline' wi'je' tu'nju' nyole',</para>
  <para style="q">yol mixti'x tnab'l noq tiqitz kyq'iq'.</para>
  <para style="q">
    <verse number="27" style="v" />¡Jaku' kub' kyb'ajsankye' jun meb'a</para>
  <para style="q">ex jaku' txikyk'a'yi'ne' jun kamiwxixe'!</para>
  <para style="q">
    <verse number="28" style="v" />Kyka'yintzpe'ye' toj nwitze';</para>
  <para style="q">kmantze' qa naq wak'a'ne'.</para>
  <para style="q">
    <verse number="29" style="v" />Kyka'yinxe' kyole' wi'je', che okxe' tnik'alti'j;</para>
  <para style="q">kanex toj kywitze' qa tu'me'lwe' nyol.</para>
  <para style="q">
    <verse number="30" style="v" />¿Maqa chalyolqine' kyeye'</para>
  <para style="q">qa min na'n wu'ne' titi' in nma'ne'?</para>
  <chapter number="7" style="c" />
  <para style="q">
    <verse number="1" style="v" />Ikyte tchwinqlal xjal tzalu twitz tx'otx'</para>
  <para style="q">kse'n jun xjal q'ojil naq njapun tajb'eb'l,</para>
  <para style="q">
    <verse number="2" style="v" />Kse'n jun lq'o'nmajin nxi'x ka'ylaj ti'jun txleku'n,</para>
  <para style="q">ex kse'n jun majin nxi'x ayon ti'j twitk'u'j.</para>
  <para style="q">
    <verse number="3" style="v" />Matxi chin yajti b'a'npun xjawe' ex mixti'xte',</para>
  <para style="q">tkyaqil qonik'an nchin yajtiye' toj k'ixk'oj.</para>
  <para style="q">
    <verse number="4" style="v" />Aj nku kẍeye' mixjun nxi'te qonik'an;</para>
  <para style="q">siktb'ilxte' kukx ntolojlaju'ye' ajttzaj t-xe kya'j,</para>
  <para style="q">¿jtojtzulo chin jawe'ye'? nchije' nkub' nxima'ne'.</para>
  <para style="q">
    <verse number="5" style="v" />Matxi' che kub' b'ent ẍchuq' wi'je' ex naq nqowjtl,</para>
  <para style="q">ex nxi'x pojin nk'ixb'lene'.</para>
  <para style="q">
    <verse number="6" style="v" />Xi'tjapun b'ajwe' toj nq'ij, mixti'x q'uqb'ab'l nk'u'je',</para>
  <para style="q">ojqel tel kse'n jun twa chemuj.</para>
  <para style="q">
    <verse number="7" style="v" />Na'ntza Qman Dyos, naku'j jun jiq'chanju' nchwinqlale',</para>
  <para style="q">ex layx chin tzalajtle'.</para>
  <para style="q">
    <verse number="8" style="v" />Mix-a'lo'xtl k'okyel ka'yinweye';</para>
  <para style="q">naq ajntzaj tka'yi'na chin b'ajeltzuntze'.</para>
  <para style="q">
    <verse number="9-10" style="v" />Kse'nte muj nik' ex nkub'naj,</para>
  <para style="q">iktzun xjalju' ajt-xi' toj muqb'il,</para>
  <para style="q">layx tz'anjtztlti'j,</para>
  <para style="q">lay tz'okka'yi'ntl kyu'n toj tja.</para>
  <para style="q">
    <verse number="11" style="v" />Qu'mtzun lay b'ent nkyaj numeye'.</para>
  <para style="q">Kxel nlanu'n nyole'</para>
  <para style="q">toj tchib'lju' k'ixk'oj ex tk'ayil.</para>
  <para style="q">
    <verse number="12" style="v" />¿Ma nintxkupqine' xob'ajilx toj ninnjab',</para>
  <para style="q">tu'nju' nxi'x xq'uqina wi'je'?</para>
  <para style="q">
    <verse number="13" style="v" />Ajtkub' nxima'ne' qa toj kuẍb'il chin ojlala'ye'</para>
  <para style="q">exqa tu'n watl kqeb'ela' nk'u'je',</para>
  <para style="q">
    <verse number="14" style="v" />Intzaj tq'o'na xob'ajil toj nwatle';</para>
  <para style="q">¡kyexi'x toktojnwitze' tu'na!</para>
  <para style="q">
    <verse number="15" style="v" />B'a'nwtlo naqwit kub'tjtz'o'na nqule';</para>
  <para style="q">wajb'ile' tu'n wele' twitz tejumajx.</para>
  <para style="q">
    <verse number="16" style="v" />Layx wipatle'. Min wajb'ile' tu'n wanq'intle'.</para>
  <para style="q">Chin tq'onkja, qu'n mixti'x tajb'enju' nchwinqlale'.</para>
  <para style="q">
    <verse number="17" style="v" />¿Titi'xixtzu'n toklenju' xjal, tu'nju' nxi'x b'ajx tk'u'ja ti'j?</para>
  <para style="q">¿Tiqu'n nxi'x lab'tiya ti'j?</para>
  <para style="q">
    <verse number="18" style="v" />¿Titiqu'n majx toktwitza ti'j tkyaqil q'ij,</para>
  <para style="q">ex jachq'al nok tq'o'na toj joyb'ilti'j?</para>
  <para style="q">
    <verse number="19" style="v" />¿Ma laytzun chin kyej tq'o'n jun kmuja</para>
  <para style="q">naq tu'n tb'ilq'etku' ntzub'e'?</para>
  <para style="q">
    <verse number="20" style="v" />Qatzun ati wile',</para>
  <para style="q">¿ti'tzu'n matxi' nb'inchaye', xq'uqil xjal?</para>
  <para style="q">¿Tiqu'n ayinxixe' nchin tzaj tnik'u'na kyu'n tal t-smaja?</para>
  <para style="q">¿Mujqa iqa'nqine' tu'na?</para>
  <para style="q">
    <verse number="21" style="v" />¿Ma laytzun kub' tnajsa'na wile'?</para>
  <para style="q">¿Laytzun kub' tnajsa'na taq'wix xnb'inchaye'?</para>
  <para style="q">Naqch'intl nxi'we' toj tx'otx':</para>
  <para style="q">kchin tjya'ya, ex mixti' qintlwe', chi Job'.</para>
  <chapter number="8" style="c" />
  <para style="sp">B'ildad</para>
  <para style="q">
    <verse number="1-2" style="v" />¿Jtoj qjen tyolina ikju'na'j,</para>
  <para style="q">naku'j jun kyq'iq' jb'al?</para>
  <para style="q">
    <verse number="3" style="v" />Min nxmletz'jete Dyos nimtipumal,</para>
  <para style="q">ti'ju' tnik'alilti'j exju' oklenj.</para>
  <para style="q">
    <verse number="4" style="v" />Malo che b'inchan ilju' tk'wala twitz Dyos,</para>
  <para style="q">qu'mtzun xkub' tz'e'ysa'na' kywitz.</para>
  <para style="q">
    <verse number="5" style="v" />Jyoma Dyos nimtipumal,</para>
  <para style="q">ex qaninxa tu'n ttzaj laqj tk'u'j ti'ja.</para>
  <para style="q">
    <verse number="6" style="v" />Qa b'a'nta tel ex ttxolil tb'eya,</para>
  <para style="q">axte kxq'uqilteya,</para>
  <para style="q">ex ktzajel tq'o'n tjaya tojxi'x tu'me'l.</para>
  <para style="q">
    <verse number="7" style="v" />Mixti' tz'oka'te' tq'inumala atitoq nej</para>
  <para style="q">kyetwitzju' ktenb'el yajxi'tl.</para>
  <para style="b" />
  <para style="q">
    <verse number="8" style="v" />Qaninxa kyeju' tijwnaq,</para>
  <para style="q">ex knoma ti'ju' twitzlalil kyu'n ojtxi' xjal.</para>
  <para style="q">
    <verse number="9" style="v" />Tzmana' k'walqoqe', ex mixti'xqe b'a'n qu'n;</para>
  <para style="q">naku'j xlekumal qekye' qq'ijlalil nche ik' twitz tx'otx',</para>
  <para style="q">
    <verse number="10" style="v" />Aye'tzunkye' ojtxi' xjal jaku' tzaj kytx'olb'a'n teya tkyaqil,</para>
  <para style="q">jaku' b'aj kychik'b'a'n nim ti'xti'.</para>
  <para style="q">
    <verse number="11" style="v" />O'kxtzu' nche ch'iya'kye'</para>
  <para style="q">ajlaj ex tqan u'j ja atiya' a';</para>
  <para style="q">
    <verse number="12" style="v" />Nejtlpe' nche kub' tzqij kywitz txqantl k'ul</para>
  <para style="q">maskye min nche jaw tx'emet.</para>
  <para style="q">
    <verse number="13" style="v" />Ikxtzun nb'aju' kyi'ju' b'inchal taq'wixil</para>
  <para style="q">ex kyi'ju' nik'tna'l Dyos kyu'n:</para>
  <para style="q">mixti'x njapunju' tb'is kyk'u'j.</para>
  <para style="q">
    <verse number="14" style="v" />Aju' ja q'uqloka' kyk'u'j ex kykuwal</para>
  <para style="q">iku' se'n tchemoj xin.</para>
  <para style="q">
    <verse number="15" style="v" />Kyajb'iltzun tu'n kytzyuntekyib' ti'ju' tq'imal, lay che ky'isj tu'n;</para>
  <para style="q">mujqa tu'n kyoklak'e ti'ju' tchemoj xin ex lay tipa.</para>
  <para style="q">
    <verse number="16" style="v" />Ikyqe' b'inchal taq'wixju' kse'n itzaj k'a tu'n q'ij,</para>
  <para style="q">nb'ajx mlen toj tkyaqil awal;</para>
  <para style="q">
    <verse number="17" style="v" />nb'ajx kyawa'nkyib'ju' kylok' toj pik</para>
  <para style="q">ex majx nb'ajx kyaq'in kyib' kyib'aj ab'j,</para>
  <para style="q">
    <verse number="18" style="v" />qatzun mache jaw xb'oqi'n</para>
  <para style="q">mix-a'lo'te kb'ilte qa eb'aj ten atzu'.</para>
  <para style="q">
    <verse number="19" style="v" />Iktzun che b'ajela'ju',</para>
  <para style="q">ex che tzajel ch'iy txqantl te kyxel.</para>
  <para style="b" />
  <para style="q">
    <verse number="20" style="v" />Min nche kyej ttzaqpi'nte Dyos xjal mixti' kyil,</para>
  <para style="q">ex min nonin kyi'ju' b'inchal taq'wixil.</para>
  <para style="q">
    <verse number="21" style="v" />Ate kb'inchalte tu'n ttze'n jumajtla</para>
  <para style="q">ex ktzalajela b'a'nxi'x;</para>
  <para style="q">
    <verse number="22" style="v" />aye'tzunkye' tajq'oja k'elel kych'ixaw</para>
  <para style="q">ex kb'ajel xitj kyja b'inchal myab'a'n, chi B'ildad.</para>
  <chapter number="9" style="c" />
  <para style="sp">Job'</para>
  <para style="q">
    <verse number="1-2" style="v" />B'inawe' wu'n qa ikyttenju',</para>
  <para style="q">lay b'ent tik'nejte' ichan tyolin twitz Dyos.</para>
  <para style="q">
    <verse number="3" style="v" />Qa tajb'il jun tu'n twulj tuk'i'l,</para>
  <para style="q">layx b'ent tmojtzet jun tyol kyu'n kab'k'al lajnaq (1,000) tu'me'l.</para>
  <para style="q">
    <verse number="4" style="v" />Nimte' Dyos tipumal ex tojtzqib'l,</para>
  <para style="q">¿alxi'xkye jun k'okyelwe' twitz ex mixti' k'ik'ela'?</para>
  <para style="q">
    <verse number="5" style="v" />Nche yukchi witz tu'n ttx'u'jil Dyos;</para>
  <para style="q">nche b'ajt-xitu'n ex mix-a'lo' nlonte.</para>
  <para style="q">
    <verse number="6" style="v" />Ate nyukchante tx'otx'</para>
  <para style="q">kyuk'i'lxi' tq'uqlil.</para>
  <para style="q">
    <verse number="7" style="v" />A inq'mante tu'n mijawula' q'ij,</para>
  <para style="q">ex tu'n lalun che qoptz'aju' che'w.</para>
  <para style="q">
    <verse number="8" style="v" />Mix-a'lo' onilte tej txit-slik'u'n kya'j</para>
  <para style="q">ex kub' we' tib'aju' ttolob' ninnjab'.</para>
  <para style="q">
    <verse number="9" style="v" />E'kub' tb'incha'n che'w:</para>
  <para style="q">exju' wotz, q'inb'il,</para>
  <para style="q">exju' ninche'w</para>
  <para style="q">kyuk'i'lju' tzb'oj che'w toj tnayajkya'j.</para>
  <para style="q">
    <verse number="10" style="v" />¡A nb'inchante txqan b'a'nq'ob'aj te lab'te'nxi'x,</para>
  <para style="q">mix-a'lo'xte nkane ti'j!</para>
  <para style="q">
    <verse number="11" style="v" />Qama tzik' Dyos ntx'u'kye', layx wile';</para>
  <para style="q">k'ik'el ex layx txinka'yi'ne'.</para>
  <para style="q">
    <verse number="12" style="v" />Qama kub' ttzyu'n jun ti'xti', ¿alkye kxel q'mante qa myate?</para>
  <para style="q">¿Alkye b'a'n t-xiqaninte ti'ju' ntb'incha'n?</para>
  <para style="q">
    <verse number="13" style="v" />Qama tzaj ttx'u'jil Dyos, ch'uẍ tu'n tkub' tk'u'j;</para>
  <para style="q">k'elel kych'ixawju' mujlikytzi tuk'i'l Raab' t-xe tqan.</para>
  <para style="q">
    <verse number="14" style="v" />¿Jatzun ktzajela'tlwe' nyol</para>
  <para style="q">tu'n ntzaq'wene' te Dyos?</para>
  <para style="q">
    <verse number="15" style="v" />Maskye mixti' wile', lay b'ant t-xintzaq'we'ne';</para>
  <para style="q">ate ajkawil weye', naq o'kx b'a'n txinqani'ne' tu'n ttzaj laqj tk'u'j wi'je'.</para>
  <para style="q">
    <verse number="16" style="v" />Qama ntxoke' Dyos twitz jun ajkawil, extzun qama pon,</para>
  <para style="q">laylo che'x tb'i'nju' nyole'.</para>
  <para style="q">
    <verse number="17" style="v" />Jaku'lo tzaj tq'o'n jun qa'nkyaq wib'aje',</para>
  <para style="q">exlo naqxtak'i'n chin tk'ixb'sa'xi'xtle';</para>
  <para style="q">
    <verse number="18" style="v" />naqlo toj tk'ayil chintenb'ela'ye' tu'n,</para>
  <para style="q">ex layx taj tu'n nxewtiye'.</para>
  <para style="q">
    <verse number="19" style="v" />¿Qa ilxi'xti'j wu'ne'? Ate Dyos nimxi'x tipumal.</para>
  <para style="q">¿Qatzun mantxoke' twitz jun ajkawil? ¿Alxixkye kweb'el twitz?</para>
  <para style="q">
    <verse number="20" style="v" />B'a'ntzunqa tnik'alwi'je' ex mixti' wile',</para>
  <para style="q">ate kq'malte q'a ati wile' ex taq'wix nb'inchb'aje'.</para>
  <para style="q">
    <verse number="21" style="v" />Mixti'we' wil, extzun ikxtz'ela'ju';</para>
  <para style="q">min wajb'iltle' tu'n wanq'ine'.</para>
  <para style="q">
    <verse number="22" style="v" />Junxte' tkyaqil. Atzunwe' nkub' nxima'n:</para>
  <para style="q">nche kub'tb'ajsa'n ati kyil junx tuk'i'l mixti' til.</para>
  <para style="q">
    <verse number="23" style="v" />Qama che k'ulb'an xjal mixti' kyil ex mache kyim,</para>
  <para style="q">naq njawtze'n Dyos ajttzaju' yajb'il kyi'j.</para>
  <para style="q">
    <verse number="24" style="v" />Nkyajtq'o'n twitz tx'otx' toj kyq'ob'ju' b'inchal myab'a'n</para>
  <para style="q">ex noktjpu'n kywitzju' ajkawil.</para>
  <para style="q">¿Alkyetzun nb'inchante qa mya Dyos?</para>
  <para style="q">
    <verse number="25" style="v" />Ojqel telju' wab'q'iye',</para>
  <para style="q">ex mixti'x nchin tzalaje' toj.</para>
  <para style="q">
    <verse number="26" style="v" />Sululun tel kse'n b'ark toj a',</para>
  <para style="q">kse'n q'anjel lepchix ti'j tchi'.</para>
  <para style="q">
    <verse number="27" style="v" />Wajb'ilxwite' tu'n tik'tna'lju' nb'ise'</para>
  <para style="q">naku'xwitloj nchin tzalaje'.</para>
  <para style="q">
    <verse number="28" style="v" />Tkyaqil nk'ixk'oje nul jumajtl xob'tzal weye',</para>
  <para style="q">b'i'n we'wu'n min nchinx toksla'ne' Dyos qa mixti' wile'.</para>
  <para style="q">
    <verse number="29" style="v" />Qana' ti wile' twitz,</para>
  <para style="q">noqxgan noktilil wu'ne'.</para>
  <para style="q">
    <verse number="30" style="v" />B'a'ntzunqa machin tx'ajune' tuk'i'l q'eq,</para>
  <para style="q">exqa mab'je'l nqcho'n nq'ob'e' tu'n ta'l tza'j,</para>
  <para style="q">
    <verse number="31" style="v" />chin b'elex tlmo'ne' Qman Dyos toj xoq'l,</para>
  <para style="q">tzulpe' molmon kyk'u'ju' nxb'alune' weye'.</para>
  <para style="q">
    <verse number="32" style="v" />Lay b'ant tmoje nwitze' tuk'i'l Dyos kse'n tuk'i'l jun ichan,</para>
  <para style="q">ex lay b'ent txinma'ne' tu'n qxi'ye' tuk'i'l twitz kawil.</para>
  <para style="q">
    <verse number="33" style="v" />¡Noqwit ati jun ajkawil qxole'</para>
  <para style="q">atiwt toklen qib'aje' tuk'i'l Dyos,</para>
  <para style="q">
    <verse number="34" style="v" />tu'nwtlo lanlun taj tu'n tkub' ttz'e'ysa'ntl Dyos nwitze'</para>
  <para style="q">ex tu'n lalun chin okt-xob'santle'!</para>
  <para style="q">
    <verse number="35" style="v" />Laytzun chin xob'tze' tu'n nyoline',</para>
  <para style="q">qu'n na'nwe' wu'n mixti' wile' twitz.</para>
  <chapter number="10" style="c" />
  <para style="q">
    <verse number="1" style="v" />¡Wixwit chin kyimwe'!</para>
  <para style="q">Kqeb'el nk'u'je' ajtjatz nma'ne' tkyaqil,</para>
  <para style="q">chexe'l nlanu'n nyole' tu'n tchib'l nik'x wu'ne'.</para>
  <para style="q">
    <verse number="2" style="v" />¡Nman Dyos, lalun tz'oktq'o'na te wile'!</para>
  <para style="q">¡Q'mantza weye' titi'ju' npaje'!</para>
  <para style="q">
    <verse number="3" style="v" />Ana'ya tzaj q'onweye',</para>
  <para style="q">¿ma b'a'ntzun tu'nju' nchin tyajla'na, ex nchin eltik'u'na,</para>
  <para style="q">ex ntzalaja ti'j kyximju' b'inchal myab'a'n?</para>
  <para style="q">
    <verse number="4" style="v" />¿Ma ikxtzun nche tka'yina' ti'xti'ju'ya</para>
  <para style="q">kse'n nkyka'yi'na' xjal?</para>
  <para style="q">
    <verse number="5" style="v" />¿Ma ikytzun tchwinqlalju'ya,</para>
  <para style="q">kse'n toj tchwinqlal jun wnaq nkyim?</para>
  <para style="q">
    <verse number="6" style="v" />¿Tiqu'ntzun nt-xpich'u'na nchu'ksb'ene' ex wile',</para>
  <para style="q">
    <verse number="7" style="v" />b'i'na' tu'na mixti'we' npaj,</para>
  <para style="q">extzun mix-a'lo' klol weye' toj tq'ob'a?</para>
  <para style="q">
    <verse number="8" style="v" />Aya b'inchanweye' kyu'nku' tq'ob'a,</para>
  <para style="q">¡atzu'n ja'lo tajb'ila tu'n nkub' t-xitu'na!</para>
  <para style="q">
    <verse number="9" style="v" />Na'ntza qa kuw tx'otx'ju' ntx'otx'ale':</para>
  <para style="q">¿Oktzun chin b'el tquqi'n jumajtla ja'lo?</para>
  <para style="q">
    <verse number="10" style="v" />Tb'inchaya nxmilale'</para>
  <para style="q">kse'n nb'enta' kyes ajtkub' qtz'aku'nix lech;</para>
  <para style="q">
    <verse number="11" style="v" />Tb'inchaju'ya chib'jile',</para>
  <para style="q">b'aj tmujb'a'na nb'aqile' kyuk'i'l twonsil;</para>
  <para style="q">
    <verse number="12" style="v" />tzaj tq'o'na nchwinqlale' ex intk'u'jlaya</para>
  <para style="q">ex aya ẍaqlunweye' tu'n wanq'ine',</para>
  <para style="q">
    <verse number="13" style="v" />Atzu'n ja'lo nel nnik'e' teya</para>
  <para style="q">atitoq jun tb'is tk'u'ja toj ewaj:</para>
  <para style="q">
    <verse number="14" style="v" />naqtoq nka'yina wi'je' qama chin b'inchan ile',</para>
  <para style="q">tu'n tb'ant tkub' ttz'e'ysa'na nwitze' tu'n tpaj wile'.</para>
  <para style="q">
    <verse number="15" style="v" />Qatzun tinpaje', matxitzun chinb'o'ljtze';</para>
  <para style="q">qatzun mixti' npaje', jaku'x chin tzalajch'ine',</para>
  <para style="q">qu'n nchin k'oline' tu'n ẍin kutme'ssa'na.</para>
  <para style="q">
    <verse number="16" style="v" />Qatzun majaw wi'nwib'e', k'okyel lpeya wi'je' kse'n jun b'alun,</para>
  <para style="q">expe' ktb'incha'ya b'a'nq'ob'aj tu'n nkub' t-xitu'na.</para>
  <para style="q">
    <verse number="17" style="v" />Nche tch'exb'enta tztiyal wi'je';</para>
  <para style="q">xi'ttzajxi'xtl ttx'ujila wi'je';</para>
  <para style="q">¡kukxtq'ojinju'ya wi'je' kse'n jun k'loj q'ojil!</para>
  <para style="b" />
  <para style="q">
    <verse number="18" style="v" />¿Tiqu'n taja'ya tu'n witz'jiye'?</para>
  <para style="q">Nkyimwitloye' na'mxku'toq nlonjtze'.</para>
  <para style="q">
    <verse number="19" style="v" />Nkyimwitloye' tej wel itz'je' ti'j ntxuye';</para>
  <para style="q">nakuxwitloj mixti'x nitz'jiye'.</para>
  <para style="q">
    <verse number="20" style="v" />Naqpena' ch'i'n toju' nchwinqlale', ¡chin ttzaqpikja!</para>
  <para style="q">Chin tq'onkch'i'na toj tzalajb'il.</para>
  <para style="q">
    <verse number="21" style="v" />Na'mxku' nxi'ye' toju' nb'eye' ja lay tz'anjtza' wi'je',</para>
  <para style="q">toju' tx'otx' qxopin ex qlolj,</para>
  <para style="q">
    <verse number="22" style="v" />toju' tx'otx' sjumj ex tzpeti'n,</para>
  <para style="q">ja tu'me'l ikx spik'unju' kse'n qlolj, chi Job'.</para>
  <chapter number="11" style="c" />
  <para style="sp">Sopar</para>
  <para style="q">
    <verse number="1-2" style="v" />Tkyaqilu' txqan yol lu nojqelan tzaq'web'lte,</para>
  <para style="q">myana' tu'nwt txqan qyol qoxe'l oksla'n.</para>
  <para style="q">
    <verse number="3" style="v" />¿Yajtzu'n chita qa tu'nju' txqan tyola kjpetala' qtziye',</para>
  <para style="q">exqa mix-a'lo' jun kb'entel ttzaq'wenteju' t-xmayb'ila?</para>
  <para style="q">
    <verse number="4" style="v" />Intma'na qa ttxolilti'ju' t-xnaq'tzb'ila,</para>
  <para style="q">ex axa nokq'ontetib'a ẍtilun.</para>
  <para style="q">
    <verse number="5" style="v" />¡Noqwit yolin Dyos tu'n ttzaj tma'n teya!</para>
  <para style="q">
    <verse number="6" style="v" />Jaku' tzaj t-xnaq'tza'n nab'l e'wa'n teya,</para>
  <para style="q">ch'uẍ tu'n telkynik'tzil.</para>
  <para style="q">Jakutzun tz'eltnik'tza qa min xtz'e'ysanjtz twitza</para>
  <para style="q">kse'nxju' nojqelan, tu'n Qman Dyos.</para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" />¿Ma jakutzun tz'el tnik'a ti'j tkyaqilju' e'wa'n tu'n Dyos</para>
  <para style="q">ex tkyaqilju' tku'x toj tanmi?</para>
  <para style="q">
    <verse number="8" style="v" />¿Ti'xi'xti' kb'antel tu'na,</para>
  <para style="q">nimxi'xna' tokxa'te' twitz kya'j?</para>
  <para style="q">¿Titi'ta b'a'n tu'n, jana'lo ta'te' t-xelo?</para>
  <para style="q">
    <verse number="9" style="v" />nimaqxi'x kyetwitz tx'otx'</para>
  <para style="q">ex nimxi'x twitz kyetwitz ninnjab'.</para>
  <para style="q">
    <verse number="10" style="v" />Tzulwittzun Dyos, che okxwit tjpu'n xjal ex che ttxokwit tu'n kyok toj xjel,</para>
  <para style="q">¿alxi'xkye kmyolte?</para>
  <para style="q">
    <verse number="11" style="v" />Tojtzqi'nte alkye chalyol;</para>
  <para style="q">ex tojtzqi'n myab'a'n, ¿Yajtzu'n tojtwitzta, ma min b'i'n tu'n?</para>
  <para style="q">
    <verse number="12" style="v" />Ajtkub'naju' toj k'ul b'ur,</para>
  <para style="q">atzun q'iju' kkaneb'il toj twitzju' mixti' tnab'l.</para>
  <para style="q">
    <verse number="13" style="v" />B'isunku'ya tu'n tanq'ina toj ttxolil,</para>
  <para style="q">ex kub'sana twitz Dyos.</para>
  <para style="q">
    <verse number="14" style="v" />Qa nim txqan tila, tzaqpinqe'kja;</para>
  <para style="q">lan taq' anb'ila teju' taq'wixil toj tjaya.</para>
  <para style="q">
    <verse number="15" style="v" />Ktzalajeltzuntza ex lay xob'a,</para>
  <para style="q">ex ktenb'ela toj nak'b'il;</para>
  <para style="q">
    <verse number="16" style="v" />K'ik'eltzun tna'l yajb'iltz tu'na;</para>
  <para style="q">k'ik'eltna'l tu'na kse'n ajtik' jb'al.</para>
  <para style="q">
    <verse number="17" style="v" />Kqoptz'ajelxi'x tchwinqlala kyetwitzju' q'ij te wanq'ij;</para>
  <para style="q">ikyk'okyela' kmoju' qxopin teya</para>
  <para style="q">kse'n spik'un.</para>
  <para style="q">
    <verse number="18" style="v" />Kqeb'el tk'u'ja ex mixti'ku' tzik'a' tk'u'ja;</para>
  <para style="q">toj tq'ob' Dyos kwtalaya toj nak'b'il.</para>
  <para style="q">
    <verse number="19" style="v" />Ajtkub'txaleya mix-a'lo' ksak'pulteya.</para>
  <para style="q">Nim che ul qanil xtalb'il teya.</para>
  <para style="q">
    <verse number="20" style="v" />Aye'tzunkye' b'inchal myab'a'n, noqxgan che jyol o'nb'il;</para>
  <para style="q">layx knet jatu'n kyklonteya' kyib',</para>
  <para style="q">naqx kamik nayon kye, chi Sopar.</para>
  <chapter number="12" style="c" />
  <para style="sp">Job'</para>
  <para style="q">
    <verse number="1-2" style="v" />¡Mixti' tu'n ttzaj qxim kyi'je' qu'n aye'kye' yolil ti'ju' tnam,</para>
  <para style="q">ajtzun kykyime' mixti'tlte nab'ltzu'!</para>
  <para style="q">
    <verse number="3" style="v" />Ikxna' atiwe' nnab'l,</para>
  <para style="q">ex junxwe' woklen kse'nkye'.</para>
  <para style="q">¿Alxixkye min b'i'n tkyaqil ja'lu tu'n?</para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" />B'a'ntzun qa mixti' wile' ex npaje',</para>
  <para style="q">ex intoq tzaj tb'i'n Qman Dyos nkub'sb'ile' tnejel,</para>
  <para style="q">nche b'ajtze'n wamiwe' wi'je'.</para>
  <para style="q">
    <verse number="5" style="v" />Aju' b'a'n ta' inel tik'u'nju' nyajti;</para>
  <para style="q">mixti'x toklenju' xi'tex tz'aq te, nxitk'o'pi'n.</para>
  <para style="q">
    <verse number="6" style="v" />Ati nak'b'il toj kyja eleq';</para>
  <para style="q">ex mixti' tzik'a'kyk'u'ju' nokky'ik'le'n Dyos,</para>
  <para style="q">toj kywitz qa toj kyq'ob' ta'.</para>
  <para style="q">
    <verse number="7" style="v" />Qaninxa kye txkup mujqa kye pich':</para>
  <para style="q">jaku' xnaq'tzanjtza kyu'n.</para>
  <para style="q">
    <verse number="8" style="v" />Ex b'a'n tu'n txitqani'na te tx'otx' ex kye kyiẍ toj ninnjab'</para>
  <para style="q">tu'n ttzaj xnaq'tza'na kyu'n.</para>
  <para style="q">
    <verse number="9" style="v" />¿Ma ati junkye' na'mx tkane' toj twitz</para>
  <para style="q">qa aku' Dyos b'inchante tkyaqil?</para>
  <para style="q">
    <verse number="10" style="v" />Toj tq'ob' ta' kychwinqlal</para>
  <para style="q">kykyaqilju' itz'qe'.</para>
  <para style="q">
    <verse number="11" style="v" />Ntb'i'n ẍkyinb'aj tu'me'lju' yol,</para>
  <para style="q">ikxju' kse'n qaq' ntna'n tk'ok'jal.</para>
  <para style="b" />
  <para style="q">
    <verse number="12" style="v" />Ati kynab'lju' tijwnaq;</para>
  <para style="q">tu'nju' kyab'q'i matxi' tz'ok kynab'l.</para>
  <para style="q">
    <verse number="13" style="v" />Atzunte Dyos ati tnab'l ex nimtipumal;</para>
  <para style="q">nche kub'tnk'u'n t-xim ex nche japun tu'n.</para>
  <para style="q">
    <verse number="14" style="v" />Aju' makub' t-xitu'n Dyos,</para>
  <para style="q">mix-a'lo kb'antel tjaw b'inchantlte;</para>
  <para style="q">aju' kjpetel tu'n Dyos mix-a'lo' kb'antel ttzaqpinte.</para>
  <para style="q">
    <verse number="15" style="v" />Qa min ntzaj tq'o'n jb'al, tkyaqil kb'el tzqij;</para>
  <para style="q">qama tzaj tq'o'n kb'ajel pune twitz tx'otx'.</para>
  <para style="q">
    <verse number="16" style="v" />Ati kanb'ab'l kukxju' tu'n tipumal.</para>
  <para style="q">Toj tq'ob' ta'ju' inkub' sb'u'n exju' insb'un.</para>
  <para style="q">
    <verse number="17" style="v" />Tu'nte min nb'enta'tl kyximanju ati kynab'l</para>
  <para style="q">ex tu'n tok toj kywi'ju' ajkawil.</para>
  <para style="q">
    <verse number="18" style="v" />Nelti'n kyoklenju' nimaqkawil</para>
  <para style="q">ex nchexti'n toj jitz'jtib'il ẍb'iqlqe'.</para>
  <para style="q">
    <verse number="19" style="v" />Nche eltiq'i'n pale toju' kyajb'eb'l</para>
  <para style="q">ex nche eltiq'i'nju' ate'k toj kyoklen.</para>
  <para style="q">
    <verse number="20" style="v" />Ntjpu'n kytziju' q'ol nab'l q'uqli kyk'u'jlalil</para>
  <para style="q">ex neltiq'i'n kynab'lju' tijwnaq.</para>
  <para style="q">
    <verse number="21" style="v" />Ntb'incha'n tu'n tel kych'ixawju' nimaq kyoklen</para>
  <para style="q">ex tu'n tb'aj kyipumalju' kuwqe'.</para>
  <para style="q">
    <verse number="22" style="v" />Nche tyek'u'nju' ti'xti' e'wa'nqexi'x</para>
  <para style="q">ex nche elt-spik'cha'nju' ti'xti' min q'ancha'lqe'.</para>
  <para style="q">
    <verse number="23" style="v" />Nche jaw tch'isa'n nimaqtnam ex nche kub't-xitu'n,</para>
  <para style="q">nche b'ajx t-sputi'n ex nche ok tb'u'yi'n.</para>
  <para style="q">
    <verse number="24" style="v" />Neltiq'i'n kynab'lju' nejenel tejun nintnam</para>
  <para style="q">ex nche'x ttzpet-san toj jun chq'ajlaj mixti'x tb'eyil,</para>
  <para style="q">
    <verse number="25" style="v" />janche takanjeya' toj qxopin,</para>
  <para style="q">nche ẍutujla kse'nqe' tx'ojtenel.</para>
  <chapter number="13" style="c" />
  <para style="q">
    <verse number="1" style="v" />Tkyaqil ja'lu matxi' wile' kyu'nku' nwitze',</para>
  <para style="q">matxi' nb'iye' kyu'nku' nẍkyine'.</para>
  <para style="q">
    <verse number="2" style="v" />Wojtzqi'nwe'ju' kyojtzqi'ne',</para>
  <para style="q">myana' nimaqxi'xkye' kyoklen kye nwitze'.</para>
  <para style="q">
    <verse number="3" style="v" />Awajb'ilju'ye' tu'n nyoline' tuk'i'lku' Dyos,</para>
  <para style="q">awajb'ilju'ye' tu'n nwulje' tuk'i'lju' Nimtipumal.</para>
  <para style="q">
    <verse number="4" style="v" />Nkub' kyewa'ne' ax tu'n kychajyolile';</para>
  <para style="q">q'anal qeye' extzun mix-a'lo'x jun yab' nkyq'a'na'ne'.</para>
  <para style="q">
    <verse number="5" style="v" />¡Tuk'ilxpe'wt nche kub'numeye',</para>
  <para style="q">jaku'wtlo q'manjtz qa ati kynab'le'!</para>
  <para style="b" />
  <para style="q">
    <verse number="6" style="v" />Kyb'incham xtalb'ile', kyb'intze'</para>
  <para style="q">chik'b'ab'l wu'ne'.</para>
  <para style="q">
    <verse number="7" style="v" />¿Yajtzun chechikye' qa nkyklo'ne' Dyos tu'n kychajyolile',</para>
  <para style="q">exqa nche ajb'ene' tu'nju' ksb'ub'le'?</para>
  <para style="q">
    <verse number="8" style="v" />Matz'ok kyq'o'n kyib'e' tuk'i'l,</para>
  <para style="q">ex tu'n kykolone' ti'j,</para>
  <para style="q">
    <verse number="9" style="v" />¿Titi' kb'ajel qama che okye' toj xjel tu'n Dyos?</para>
  <para style="q">¿Majaku'lo sb'et kyu'ne' kse'n jun xjal?</para>
  <para style="q">
    <verse number="10" style="v" />Qa naqkyak'a'ne' nok kyq'o'n kyib'e' tuk'i'l,</para>
  <para style="q">che tzak'unjtzel b'a'nxi'x tu'n.</para>
  <para style="q">
    <verse number="11" style="v" />Ktzajel tchi kyi'je' ex che xob'ele'</para>
  <para style="q">teju' toklen Dyos nim.</para>
  <para style="q">
    <verse number="12" style="v" />Naq quqte' tu'me'l kynab'le';</para>
  <para style="q">ikyte' kse'n kyajb'ile' tu'n kyklete' toj nintapi xoq'lile.</para>
  <para style="b" />
  <para style="q">
    <verse number="13" style="v" />Atzu'n ja'lo, ¡k'ulkytziye', qu'n chin yolile',</para>
  <para style="q">tixku' mab'aj weye'!</para>
  <para style="q">
    <verse number="14" style="v" />Knq'a' wib'e',</para>
  <para style="q">kxel woyi'n nchwinqlale'.</para>
  <para style="q">
    <verse number="15" style="v" />B'a'ntzun qama chin kub' tb'yo'ne', kb'el nwab'a'n wib'e',</para>
  <para style="q">tu'n txinma'ne' kolb'il wib'e' twitzku'.</para>
  <para style="q">
    <verse number="16" style="v" />Qape'tzunlo atzu' chin kletela'ye',</para>
  <para style="q">qu'n lay b'ent tokx jun b'inchal taq'wix twitz Dyos.</para>
  <para style="q">
    <verse number="17" style="v" />Kyb'inkutzune' chik'b'ab'l b'a'nxi'x</para>
  <para style="q">kxe'l nq'o'ne' kyeye'.</para>
  <para style="q">
    <verse number="18" style="v" />Kxe'l nma'ne' kolb'il wib'e',</para>
  <para style="q">kanli nwitze' ttxolilti'jwe' nyol.</para>
  <para style="q">
    <verse number="19" style="v" />Qa alo' jun machik'b'ante wile',</para>
  <para style="q">chin b'el numeye' ex chin kyimele'.</para>
  <para style="b" />
  <para style="q">
    <verse number="20" style="v" />Q'ontz kab'e' tixti'ya weye' Dyos,</para>
  <para style="q">ex lay kub' wewa'n wib'e' twitza.</para>
  <para style="q">
    <verse number="21" style="v" />Lalun kub' ttz'e'ysa'ntla nwitze'</para>
  <para style="q">ex lalun taja tu'n nxob'e'.</para>
  <para style="q">
    <verse number="22" style="v" />Chin ttxkoma, ex kxe'l ntzaq'we'ne';</para>
  <para style="q">mujqa nejtl chin yolile', atzun tzaj ttzaq'we'na.</para>
  <para style="q">
    <verse number="23" style="v" />Q'mantza weye', ¿alkyeqe' wile' ex npaje'?</para>
  <para style="q">¿Alkyeqe' wile' nimaq ilxi'x?</para>
  <para style="q">
    <verse number="24" style="v" />¿Tiqu'n nxa'tewa'n tib'a nwitze'?</para>
  <para style="q">¿Tiqu'n nchin noka' tq'o'na naku'j jun ajq'oj?</para>
  <para style="q">
    <verse number="25" style="v" />Naku'j t-xaq tzeqine' toj kyq'iq',</para>
  <para style="q">¿Tiqu'n tajb'ila'ya tu'n nkub' t-xitu'na?</para>
  <para style="q">Ikyqinju'ye' kse'n ttxa triy tzqij,</para>
  <para style="q">¿tiqu'n ljo'n toj nq'ije' tu'na?</para>
  <para style="q">
    <verse number="26" style="v" />Nchin tpoqi'na tu'n tkyaq tk'u'ja;</para>
  <para style="q">ntxjelu'na nchuksb'ene' atxi'x toj nku'xumale'.</para>
  <para style="q">
    <verse number="27" style="v" />Noktk'lo'na nqane' toj xpatx'k'uxb'il,</para>
  <para style="q">majx toktwitza wi'je' janchin b'eta'ye'</para>
  <para style="q">ex majx ntka'yi'na ja nkub'a' nqane'.</para>
  <para style="q">
    <verse number="28" style="v" />Xi'nkub'aje' kse'n jun ti'xti' npsuq'in,</para>
  <para style="q">kse'n xb'alun nkub' t'uqj.</para>
  <chapter number="14" style="c" />
  <para style="q">
    <verse number="1" style="v" />Naq tchwinqlalju' ichan tal jun qya,</para>
  <para style="q">ex nim yajb'il ntzaj ti'j.</para>
  <para style="q">
    <verse number="2" style="v" />Kse'n jun b'ech npoq'chaj ex lwiy nkub' tzqij;</para>
  <para style="q">nik' kse'n jun leku'n ex nkub'naj.</para>
  <para style="q">
    <verse number="3" style="v" />¿Ma ti'jtzu'n ichan lu soka'ten twitza,</para>
  <para style="q">ex tajb'ila tu'n toktq'o'na toj xjel?</para>
  <para style="q">
    <verse number="4" style="v" />Mix-a'lo'te jun</para>
  <para style="q">jaku' b'ant tetz ẍtilun tu'n toju' tz'il.</para>
  <para style="q">
    <verse number="5" style="v" />A na'ta q'malte</para>
  <para style="q">jni'toj tchwinqlalju' ichan,</para>
  <para style="q">ex lay tzi'k' tib'aju' tzajni tq'o'na,</para>
  <para style="q">
    <verse number="6" style="v" />q'imil twitza ti'j ex tzaqpinkja;</para>
  <para style="q">¡q'onkja tu'n tnik'b'ente taq'unb'en itz'xku'!</para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" />Inxulin jumajtlte' tze ajtkub' tx'emet,</para>
  <para style="q">ex kukx che tzajetl t-xul ak'a'j.</para>
  <para style="q">
    <verse number="8" style="v" />B'a'ntzun qa matxi'toq tijin tlok'</para>
  <para style="q">ex nq'ayjtlu' t-ẍwankyil twitz tx'otx',</para>
  <para style="q">
    <verse number="9" style="v" />Ajtna'nte t-ẍb'ajunil jb'al, kcha'xixel jumajtl;</para>
  <para style="q">che tzajel tq'ob' kse'n jun awal.</para>
  <para style="q">
    <verse number="10" style="v" />Atzunte' ichan ajtkyim mixti'tl tu'me'l tu'n tklet;</para>
  <para style="q">ex ajtkyim, ¿jakpomela'?</para>
  <para style="b" />
  <para style="q">
    <verse number="11" style="v" />Kjawil b'akaxinju' a' toj ninnjab',</para>
  <para style="q">exqetzu'n tnimal a' che tzqijel;</para>
  <para style="q">
    <verse number="12" style="v" />atzunte' ichan, lay jawe' toj muqb'il</para>
  <para style="q">ex lay tzaj tna'ntib' toj twatl,</para>
  <para style="q">atixku'ju' kya'j.</para>
  <para style="b" />
  <para style="q">
    <verse number="13" style="v" />¡Naqwit chinx tewi'na toj tkawb'il kamik</para>
  <para style="q">akx nik' ttx'ujila',</para>
  <para style="q">exwit kub' tq'o'na jun tq'ijlalil tu'n ntzaj tna'na'!</para>
  <para style="q">
    <verse number="14" style="v" />¿Ma ktzulo k'anq'itl jun xjal qama kyim?</para>
  <para style="q">Jaku' nyowe' tq'ijlalil wajb'eb'le' nojqelan</para>
  <para style="q">tzmax aj ntzaqpaje'.</para>
  <para style="q">
    <verse number="15" style="v" />Atzulotza ktzajel txkon weye', extzulo kxel ntzaqwe'ne';</para>
  <para style="q">ktzunlo chin tzajel tk'ujla'ntza, ana'ya ch'isalweye'.</para>
  <para style="q">
    <verse number="16" style="v" />Qa toktwitza kyi'j nqane' nchin b'ete' ja'lo,</para>
  <para style="q">laytzun tiltza wile';</para>
  <para style="q">
    <verse number="17" style="v" />ktzunlo k'ik'el tna'l npajtze' tu'na</para>
  <para style="q">extzulo chin t-ẍtilsa'tza toju' wile'.</para>
  <para style="b" />
  <para style="q">
    <verse number="18" style="v" />Expena' che tzajel niq'ju' witz,</para>
  <para style="q">ex che ik'elju' pik ja ta'qe'.</para>
  <para style="q">
    <verse number="19" style="v" />Kse'n a' nche b'aj tjqu'n ab'j</para>
  <para style="q">exju' jb'al nxitiq'i'n tquqil tx'otx',</para>
  <para style="q">ikytzunta' nkub' t-xitu'na ja q'uqla' tk'u'j xjal.</para>
  <para style="q">
    <verse number="20" style="v" />Nkub' tb'ajsa'na tejumajx, nex t-xla'ja'na ti'jxi' ttx'otx',</para>
  <para style="q">ex majx nchukji tilb'ilal.</para>
  <para style="q">
    <verse number="21" style="v" />Qa nkanb'et ninb'ilkyeju' tk'wal, min npon tqanil te;</para>
  <para style="q">qama che kub' yajt, min ntlo'n;</para>
  <para style="q">
    <verse number="22" style="v" />o'kxte ntna'nju' k'ixk'oj toj t-xmilal,</para>
  <para style="q">aju' yajb'il toj twinqil, chi Job'.</para>
  <chapter number="15" style="c" />
  <para style="s1">Tkab' tnej yol</para>
  <para style="r">(Caps. <ref loc="JOB 15-21">15—21</ref>)</para>
  <para style="sp">Elipas</para>
  <para style="q">
    <verse number="1-2" style="v" />Ate' xjal ati tnab'l minxittzaq'we'n kyuk'i'l yol mixti' kyoklen</para>
  <para style="q">ex min jaw tnima'ntib' kyu'n tyol naq tiqatz kyq'iq';</para>
  <para style="q">
    <verse number="3" style="v" />Minti' naqxwit nyolinxi'</para>
  <para style="q">ex min najb'en tyol mixwitti' toklen.</para>
  <para style="q">
    <verse number="4" style="v" />Atzunta min nimantla te Dyos:</para>
  <para style="q">¡nkub' t-xitu'nju'ya k'u'lb'il axi'x!</para>
  <para style="q">
    <verse number="5" style="v" />Myab'a'n tokx toj twi'ya qu'mtzun nyolina ikju'</para>
  <para style="q">ex nyolina tuk'i'l sb'ub'l.</para>
  <para style="q">
    <verse number="6" style="v" />Min nojqelan tu'n t-xinpoqo'na,</para>
  <para style="q">tojxpena' ttziya netza'.</para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" />¿Mamixtzunti' jun xjal toj twitza tej titz'jiya,</para>
  <para style="q">ex mamixti'qe'toqju' witz?</para>
  <para style="q">
    <verse number="8" style="v" />¿Ma atzuna q'ol tnab'l Dyos,</para>
  <para style="q">mujqa o'kxa ajnab'lil twitz tx'otx'?</para>
  <para style="q">
    <verse number="9" style="v" />¿Titzu'n b'a'n tu'nju' min nb'et qu'ne'?</para>
  <para style="q">¿Titi' tojtzqi'na ju' min qojtzqi'ne'?</para>
  <para style="q">
    <verse number="10" style="v" />¡Matxina' tzajqe' qwinqil,</para>
  <para style="q">nimxi'xpena'qe' twitzlalil qu'n kyetwitz tmana!</para>
  <para style="b" />
  <para style="q">
    <verse number="11" style="v" />¿Maminqe tk'u'ja tu'nju' ntq'uqb'a'n Dyos tk'u'ja</para>
  <para style="q">ex chab'a nqo' yoline' teya?</para>
  <para style="q">
    <verse number="12" style="v" />¿Tiqu'n nxa'tq'o'na toj twinqila</para>
  <para style="q">ex noq nsq'iluna tu'n tpaj?</para>
  <para style="q">
    <verse number="13" style="v" />¿Tiqu'n ntx'u'jina'ya ti'j Dyos</para>
  <para style="q">ex nim txqan tyola ti'j?</para>
  <para style="q">
    <verse number="14" style="v" />Mixti'te jun xjal japumniti'j</para>
  <para style="q">ex mixti'wt tpaj.</para>
  <para style="q">
    <verse number="15" style="v" />Mipena' jun q'uqlixi'x tk'u'j kyi'ju' anjl,</para>
  <para style="q">myape'na' ẍtilunju' kya'j twitz.</para>
  <para style="q">
    <verse number="16" style="v" />¡Mitzunloyate' xjal, ntzu'wix ex ik'b'ajilx,</para>
  <para style="q">naqx il nb'incha'n kse'n nk'wan a'!</para>
  <para style="b" />
  <para style="q">
    <verse number="17" style="v" />B'inkupe'ya, kxel nma'nch'ine' teya</para>
  <para style="q">aju' matxi' tzik' nwitze' ti'j,</para>
  <para style="q">
    <verse number="18" style="v" />aju' nkyxnaq'tza'n ajnab'lil qe'.</para>
  <para style="q">Makykan kyi'ju' ijtxi' kychman,</para>
  <para style="q">
    <verse number="19" style="v" />Aye'j xiq'o'n tx'otx' kye</para>
  <para style="q">ex min xi'kysmo'nkyib' kyuk'i'l najchaq xjal.</para>
  <para style="b" />
  <para style="q">
    <verse number="20" style="v" />Naq ch'i'ntoj tchwinqlalju' xjal b'inchal myab'a'n,</para>
  <para style="q">exju' mya'l yajb'ilxi'x nanq'ina'.</para>
  <para style="q">
    <verse number="21" style="v" />Nxob' kye tq'ojq'ojel nche'x tb'i'n;</para>
  <para style="q">kse'n q'uqlixi'x tk'u'j, nkub' alq'a'n.</para>
  <para style="q">
    <verse number="22" style="v" />Layx b'ent toq toj qxopin:</para>
  <para style="q">¡nayon jun xuyb'il b'iyb'ilte!</para>
  <para style="q">
    <verse number="23" style="v" />k'okyel te kychi' k'utz;</para>
  <para style="q">b'i'n tu'n qa kb'ajel.</para>
  <para style="q">
    <verse number="24" style="v" />Tzul xob'el ti'j tu'n qlolj,</para>
  <para style="q">tzul b'is ti'j ex kk'ulb'al,</para>
  <para style="q">kse'n jun nimaqkawil ajt-xi' q'ojil.</para>
  <para style="b" />
  <para style="q">
    <verse number="25" style="v" />Ikytzun nb'aju' ti'ju' njaw ti'ntib' ti'j Dyos</para>
  <para style="q">ti'ju' nok pi's teju' nimtipumal,</para>
  <para style="q">
    <verse number="26" style="v" />aju' klo'n tu'n kolb'il,</para>
  <para style="q">mixti'x tnab'l noktzaqpaj ti'j Dyos.</para>
  <para style="q">
    <verse number="27" style="v" />T-xuq'exi'x twitz ex tq'eb'exi'x.</para>
  <para style="q">
    <verse number="28" style="v" />Che b'elxitju' nimaqtnam janajla';</para>
  <para style="q">che b'ajkjel kolb'e'n ja</para>
  <para style="q">junch'yuq ttx'anqa'n jatl che kjela'.</para>
  <para style="q">
    <verse number="29" style="v" />Mya nimtoj kq'inumaxel,</para>
  <para style="q">ex lay txi' tlok' toj tx'otx'.</para>
  <para style="q">
    <verse number="30" style="v" />Lay tzoqpaj toj qxopin.</para>
  <para style="q">K'okyel kse'n jun awal nb'aj tz'e'y t-xul tu'n q'aq'</para>
  <para style="q">mujqa nche eljub'cha'n tub'chil tu'n kyq'iq'.</para>
  <para style="q">
    <verse number="31" style="v" />Lalun tz'okqe tk'u'ja ti'ju' sb'ub'l toj xnakyil,</para>
  <para style="q">qu'n o'kx ktkanb'a'ju'ya kb'el t-sb'u'n tib'a.</para>
  <para style="q">
    <verse number="32" style="v" />Kb'el tzqijte' sb'ub'l na'mxtoq tpon tq'ijlalil</para>
  <para style="q">ex lay t-xulin jumajtl.</para>
  <para style="q">
    <verse number="33" style="v" />Ikyk'okyela' kse'n junwi' ub'a na'mxtoq tq'nax twitz ajtb'ajku'tz t'uxj,</para>
  <para style="q">kse'n junwi' olib' naq nku'tz tz'aq tub'chil.</para>
  <para style="q">
    <verse number="34" style="v" />Lay kyej kyyajajilju min nche okslan te Dyos,</para>
  <para style="q">kb'ajel pati'n kyja tb'anilqexi'x naq tu'n kyeleq'.</para>
  <para style="q">
    <verse number="35" style="v" />Ch'onwi'qe' tu'n taq'wixil ex nche alan k'ulb'a'n;</para>
  <para style="q">naq sb'ub'l kywitz nkyq'o'n, chi Elipas.</para>
  <chapter number="16" style="c" />
  <para style="sp">Job'</para>
  <para style="q">
    <verse number="1-2" style="v" />B'a'npun majxi' nb'iye' ti'xti' kse'n ja'lu.</para>
  <para style="q">Naq ate'kkye' yajul weye' mya inwt kyq'uqb'a'ne' nk'u'je'.</para>
  <para style="q">
    <verse number="3" style="v" />¿Ma b'ajxtzun b'aja' ttxa'nju' yol mixti'x kyoklen?</para>
  <para style="q">¿Tiqu'ntzun nela' kyik'o'ne' nyole'?</para>
  <para style="q">
    <verse number="4" style="v" />Aye'wttzunju'ye' kse'n ntina'ye',</para>
  <para style="q">ikxwitlo jaku' chin yolinwe' kse'nkye';</para>
  <para style="q">inwtlo xinyukcha'n nwi'ye' te xmayb'il</para>
  <para style="q">jaku' txinlanu'n txqan nyole' kyeye',</para>
  <para style="q">
    <verse number="5" style="v" />mujqa jaku' b'a'nqe' nyole' ex q'uqb'ab'l k'u'jb'aj</para>
  <para style="q">tu'n tqe kyk'u'je' ex tu'n tok kyipumale'.</para>
  <para style="q">
    <verse number="6" style="v" />B'a'ntzun qa atite yol layx tz'elte' k'ixk'oj,</para>
  <para style="q">exqa mixti'te yol ikxte'.</para>
  <para style="q">
    <verse number="7" style="v" />Matxi' tz'elti'n Dyos wipumale';</para>
  <para style="q">mache elti'n kykyaqil wamiwe'.</para>
  <para style="q">
    <verse number="8" style="v" />Machin okxtjpu'ne'.</para>
  <para style="q">Majawtiq'i'n yol wi'je';</para>
  <para style="q">machin tpoqiye' tuk'i'l chajyolil.</para>
  <para style="q">
    <verse number="9" style="v" />Ljo'n toj nq'ije' tu'n Qman Dyos ex nchin b'ajttzaqu'ne',</para>
  <para style="q">naku'j jun txkup nchin t-xob'sa'ne'.</para>
  <para style="q">
    <verse number="10" style="v" />Nche jawtilju' xjal wi'je',</para>
  <para style="q">nche xk'ob'in weye'</para>
  <para style="q">ex nchin okkyt'ob'ine' te me'sb'il weye'.</para>
  <para style="q">
    <verse number="11" style="v" />Ma chinx tq'o'ne' Qman Dyos</para>
  <para style="q">toj kyq'ob' b'inchal myab'a'n ex b'yolxjal.</para>
  <para style="q">
    <verse number="12" style="v" />B'a'ntoqwe' nten, atzunte kub' ttzyu'n nqule';</para>
  <para style="q">machin b'ajtpch'u'ne', majx ẍinb'aj tpuẍi'ne'.</para>
  <para style="q">Majx ayine' nchin tzaj t-smaji'n.</para>
  <para style="q">
    <verse number="13" style="v" />Nchintza t-smaji'ne' tkyaqil plaj;</para>
  <para style="q">mixti'x tlaqb'il tk'u'j majx nb'je'x jlajin talt-smaj toj nxmilale',</para>
  <para style="q">matxi' b'je'tz chij toj nk'u'je'.</para>
  <para style="q">
    <verse number="14" style="v" />Matxixi'x chin b'ajk'ixb'iye' tu'n,</para>
  <para style="q">noktzapaj wi'je' naku'j jun q'ojil.</para>
  <para style="b" />
  <para style="q">
    <verse number="15" style="v" />Matzaj nb'ise', matz'ok nq'o'ne' nxb'alune' te b'is,</para>
  <para style="q">ex kuxnxuqu'n nwiye' toj quq.</para>
  <para style="q">
    <verse number="16" style="v" />Matxi' b'aj mal nwitze' tu'n oq'e'n;</para>
  <para style="q">makub' sjumjix kyi'j nwitze',</para>
  <para style="q">
    <verse number="17" style="v" />B'ajxpena' chin b'ujuna'we' te jun xjal</para>
  <para style="q">ex b'a'nju' nna'j Dyose'.</para>
  <para style="b" />
  <para style="q">
    <verse number="18" style="v" />¡Lalun kub' tewa'na nkub'sb'ile' tx'otx'!,</para>
  <para style="q">qu'n ntqani'n b'yojwnaqi'n lu tu'n tok tu'me'l t-xel weye'. <verse number="19" style="v" />Atilo junte' toj kya'j</para>
  <para style="q">kchik'b'alte qa mixti'we' wil,</para>
  <para style="q">
    <verse number="20" style="v" />Tu'n tpjunte nxime' twitz Qman Dyos,</para>
  <para style="q">ex tu'n tka'yinte ta'l nwitze';</para>
  <para style="q">
    <verse number="21" style="v" />Tu'n tyolin wi'je' twitz Dyos,</para>
  <para style="q">kse'n nyolin jun xjal ti'j juntl.</para>
  <para style="q">
    <verse number="22" style="v" />Xi'na' tb'ajte' jte' ab'q'itlwe' nchwinqlal,</para>
  <para style="q">chin ik'elwe' ex lay chin ul jumajtle'.</para>
  <chapter number="17" style="c" />
  <para style="q">
    <verse number="1" style="v" />xi' nkub' b'aje';</para>
  <para style="q">ch'inxtl tb'ajwe' nchwinqlal;</para>
  <para style="q">naq tu'n nxi'tlwe' toj jul.</para>
  <para style="q">
    <verse number="2" style="v" />Naq nche xmayinkye' xjal nk'etze';</para>
  <para style="q">q'ijtl ex qonik'an nche pa'nyol nwitze'.</para>
  <para style="q">
    <verse number="3" style="v" />Atzuntz Nman Dyos, nyolin wi'je';</para>
  <para style="q">¿alkyexixtzuntl, aya k'onil weye'?</para>
  <para style="q">
    <verse number="4" style="v" />Aya nchuksante kynab'l,</para>
  <para style="q">lalun taja tu'n nkub'e' kyu'n.</para>
  <para style="q">
    <verse number="5" style="v" />Che we'yajtelkye' kyk'walju',</para>
  <para style="q">naq tu'n pwaq nche kypoqona' kamiw.</para>
  <para style="q">
    <verse number="6" style="v" />Oje tb'inchaya tu'n kyolin taq'wix kykyaqilx wi'je'</para>
  <para style="q">ex tu'n tokxkytzub'a'n toj nwitze'.</para>
  <para style="q">
    <verse number="7" style="v" />Matz'ok muj kyi'j nwitze' tu'n k'ixk'oj;</para>
  <para style="q">ex naku'j leku'n qine'.</para>
  <para style="q">
    <verse number="8" style="v" />Nche jaw lab'ti b'a'n xjal ajkyka'yinte;</para>
  <para style="q">ntzaj kytx'u'jil ex nchin nokkyq'o'ne' te aj il.</para>
  <para style="q">
    <verse number="9" style="v" />Ilxi'xti'j kyu'n qa aye'kye tnik'alkyi'j,</para>
  <para style="q">exqa ẍtilun kyq'ob'.</para>
  <para style="q">
    <verse number="10" style="v" />Kytzajchaqe' kykyaqilxe',</para>
  <para style="q">ex layxlo knet jun ati tnab'l kyxole'.</para>
  <para style="b" />
  <para style="q">
    <verse number="11" style="v" />Xi' tb'aj tq'ijlalil nchwinqlale'</para>
  <para style="q">ex min nche japunju' tb'is nk'u'je' e' nxime'.</para>
  <para style="q">
    <verse number="12" style="v" />Aye'tzunkye' nok kyq'o'ne' qonik'an te q'ijtl;</para>
  <para style="q">¡Lu soyk'un tzun, chechije' extzun qxopin!</para>
  <para style="q">
    <verse number="13" style="v" />Naq kamiktlwe' nwayo'n,</para>
  <para style="q">tu'n nkub' kẍeye' ktal toj qlolj.</para>
  <para style="q">
    <verse number="14" style="v" />¡Aye'we' nman, ntxu, ex witz'in,</para>
  <para style="q">aye' ẍchuq' ex muqb'il!</para>
  <para style="q">
    <verse number="15" style="v" />¿Jatzun xkyaja' q'uqb'ab'l nk'u'je'?</para>
  <para style="q">¿Jatzunta' b'a'n ja'lo?</para>
  <para style="q">
    <verse number="16" style="v" />¿Ma junxtzun kxela' wuk'i'le' toj tkawb'il kamik,</para>
  <para style="q">tu'n qojlane' junx toj tx'otx'? chi Job'.</para>
  <chapter number="18" style="c" />
  <para style="sp">B'ildad</para>
  <para style="q">
    <verse number="1-2" style="v" />¿Jtojlo qjen tyolinju' xjal lu?</para>
  <para style="q">noqwit b'a'n t-ximante, mawitlo qo yoline'.</para>
  <para style="q">
    <verse number="3" style="v" />¿Tiqu'n nqo' t-se'na' naku'j txkup</para>
  <para style="q">ex matxi' qo okq'o'n te xnak?</para>
  <para style="q">
    <verse number="4" style="v" />¿Yajtzu'n chita qa tu'nju' kb'ajel tb'yo'n tib'a tu'n ttx'u'jila</para>
  <para style="q">kb'el chq'ajlajixju' tx'otx'</para>
  <para style="q">mujqa che ik'elju' pik ja ta'qe'?</para>
  <para style="q">
    <verse number="5" style="v" />Kb'el yupj ttxa'n ttzaju' b'inchal myab'a'n,</para>
  <para style="q">ex layx k'antju' tq'aq'.</para>
  <para style="q">
    <verse number="6" style="v" />Kb'el yupju' tkantil;</para>
  <para style="q">lay k'antju' ttzaj.</para>
  <para style="q">
    <verse number="7" style="v" />Kb'el b'aj tipumal ajtb'et kuw,</para>
  <para style="q">ex kb'eltz'aq tojxju' t-xpatxab'.</para>
  <para style="q">
    <verse number="8" style="v" />Kb'eltq'o'n jun xyub'pa tojx tb'e,</para>
  <para style="q">tojxtzunju' xyub'pa kb'ela' tz'aq.</para>
  <para style="q">
    <verse number="9" style="v" />Kb'eltq'o'n taqwil t-xe tqan,</para>
  <para style="q">ex k'okyel t-xmo'ntib' tqul tqan.</para>
  <para style="q">
    <verse number="10" style="v" />Min q'ancha'lju' xpatxab' toj b'e</para>
  <para style="q">tu'n tjaw tz'aq toj ajtik'.</para>
  <para style="q">
    <verse number="11" style="v" />Jaxjaku' ta' nxob'je;</para>
  <para style="q">ntna'n qa njyontz atl junjun kmuj.</para>
  <para style="q">
    <verse number="12" style="v" />Nkub'aj tipumal tu'n we'yaj;</para>
  <para style="q">matxitoq tz'ok tz'aqju' taq'wixil ti'j;</para>
  <para style="q">
    <verse number="13" style="v" />Tk'wal kamikte' yab'il kye tilwi tu'n,</para>
  <para style="q">chab'a nb'aju' chib'j tu'n.</para>
  <para style="q">
    <verse number="14" style="v" />Neltiq'i'n nak'b'il te xjal toj tja</para>
  <para style="q">ex inxitjwo'n twitz tajawil kamik.</para>
  <para style="q">
    <verse number="15" style="v" />In oktq'o'n tq'aq'ilu' tja;</para>
  <para style="q">nxitqo'n q'ol kyib'aju' ti'xti' te.</para>
  <para style="q">
    <verse number="16" style="v" />Kse'n jun tze tzqij tlok'</para>
  <para style="q">ex tzqijqe'tl tq'ob'.</para>
  <para style="q">
    <verse number="17" style="v" />Majx k'ik'eltna'l twitz tx'otx'</para>
  <para style="q">ex lay tzaj na'tlju' tb'i.</para>
  <para style="q">
    <verse number="18" style="v" />K'eletz q'i'n toj spik'un ex kxel xon toj qlolj;</para>
  <para style="q">k'elex xla'ja'n twitzju' tx'otx' lu.</para>
  <para style="q">
    <verse number="19" style="v" />Lay kyej tyajil toju' ttanam;</para>
  <para style="q">mix-a'lote jun kjel anq'in toj tja.</para>
  <para style="q">
    <verse number="20" style="v" />Ajtzun tb'injtz tjawetzq'ij ex tkub'exq'ij kse'n xb'aja'</para>
  <para style="q">che b'ajel sak'puj tu'n kyxob'il.</para>
  <para style="q">
    <verse number="21" style="v" />Ikytzu'n nb'aja' tchwinqlalju' b'inchal il,</para>
  <para style="q">aju' xjal nel tik'u'n Dyos, chi B'ildad.</para>
  <chapter number="19" style="c" />
  <para style="sp">Job'</para>
  <para style="q">
    <verse number="1-2" style="v" />¿Jtoj qen ttzaj kylanu'n kyole' weye'</para>
  <para style="q">ex tu'n lan chin yajtitle'?</para>
  <para style="q">
    <verse number="3" style="v" />Kukx kywulinjuye' weye';</para>
  <para style="q">¿ma min nkub' kych'ixwle'ju'ye' nkyb'incha'ne' weye'?</para>
  <para style="q">
    <verse number="4" style="v" />Maskyetzunlo npaje',</para>
  <para style="q">ayinawe' chin chjolte.</para>
  <para style="q">
    <verse number="5" style="v" />Nkynima'nkye'kyib' nwitze',</para>
  <para style="q">ntzaj kychitpu'ne' nplaje' se'n nchin nik'a'ye'.</para>
  <para style="q">
    <verse number="6" style="v" />Kaneku' toj kywitze' qa a Dyos xkub'o'ljsanweye',</para>
  <para style="q">ex tu'nte ẍinkub' tz'aqa'ye' toj xpatxab'.</para>
  <para style="q">
    <verse number="7" style="v" />Njaw ẍch'i'ne' kjalu: ¡chin b'elb'yo'ne'! ex mix-a'lo'te ntzaq'wi;</para>
  <para style="q">nchin qanin onb'ile' ex mix-a'lo' ntzaj b'inweye'.</para>
  <para style="q">
    <verse number="8" style="v" />Matxi' kub' tjpu'n Dyos nb'eye' tu'n lan chinik'e';</para>
  <para style="q">matxi' kub' tq'o'n qlolj toj nb'eye'.</para>
  <para style="q">
    <verse number="9" style="v" />Mab'je'l ti'q'i'n nq'inumale'</para>
  <para style="q">matz'el tiq'in woklene'.</para>
  <para style="q">
    <verse number="10" style="v" />Matxi' chin kyej ẍji'lixe' tu'n;</para>
  <para style="q">¡majx makub' tyupi'n q'uqb'ab'l nk'u'je'!</para>
  <para style="q">
    <verse number="11" style="v" />Majx sajtb'ajsa'n ttx'u'jil wi'je'</para>
  <para style="q">ex machin oktq'o'ne' kse'n jun tajq'oj.</para>
  <para style="q">
    <verse number="12" style="v" />Kykyaqilju' t-xjal te q'oj ẍe oktilj wi'je';</para>
  <para style="q">kub' kyq'o'n kyxmuj ti'jele njaye'</para>
  <para style="q">tu'n kyok tzaqpaj wi'je'.</para>
  <para style="b" />
  <para style="q">
    <verse number="13" style="v" />Matb'incha Dyos tu'n nkyaj kyleb'a'ne' witz'ine' ex wamiwe'</para>
  <para style="q">naku'j min ojtzqi'n qintle' kyu'n.</para>
  <para style="q">
    <verse number="14-15" style="v" />Machin kyajkyleb'a'ne' nwitze'le' exqe' wamiwe';</para>
  <para style="q">matxi' tzik'nna'le' kyu'n najlqe'toq toj njaye'.</para>
  <para style="q">Naku'j min ojtzqi'n qintle' kyu'nju' nmajine';</para>
  <para style="q">min netlkynik' weye'.</para>
  <para style="q">
    <verse number="16" style="v" />Qama tzaj ntxko'n jun nmajine',</para>
  <para style="q">min ntzaq'wi, maskye machin kub'sa'ne' te.</para>
  <para style="q">
    <verse number="17" style="v" />Qama chinx lq'eye' tk'etzu' nxu'jile', nchin eltik'u'ne';</para>
  <para style="q">ntzaj molmon kyk'u'ju' nk'wale' weye'.</para>
  <para style="q">
    <verse number="18" style="v" />In pena' chin el kyik'o'ne' k'wal;</para>
  <para style="q">naqpe' ajnjawe'ye', nche aq'wi yolil wi'je'.</para>
  <para style="q">
    <verse number="19" style="v" />Nchinel kyik'u'ne' wamiwe' kyexi'x qtene' kyuk'i'l;</para>
  <para style="q">exqepe' kye kyilwi wu'ne' mache okmiltz'uj wi'je'.</para>
  <para style="q">
    <verse number="20" style="v" />Matxi' tz'ok b'aju' ntz'umale' ti'j nb'aqile',</para>
  <para style="q">naqna' tuk'ilxi'tl we'wu'n.</para>
  <para style="q">
    <verse number="21" style="v" />Q'aq'antz kyk'u'je' wi'je', wamiw,</para>
  <para style="q">qu'n matxi' chin kub' tz'aqe' toj tq'ob' Dyos.</para>
  <para style="q">
    <verse number="22" style="v" />¿Tiqu'n ljo'n toj nq'ije' kyu'ne', ma Dyos qeye'?</para>
  <para style="q">¡Matxina' chin b'aj kyẍjak'unxiye'!</para>
  <para style="q">
    <verse number="23" style="v" />¡Atiwt jun tz'ib'alkyeju' nyole'</para>
  <para style="q">ex tu'nwt tkyaj twitz jun k'uxb'il!</para>
  <para style="q">
    <verse number="24" style="v" />¡Atiwt jun kyej q'onte twitz ab'j tejumajx</para>
  <para style="q">tu'n plom mujqa tu'n tzqub' k'uxb'il!</para>
  <para style="q">
    <verse number="25" style="v" />B'i'n wu'ne' qa itz'we' klolwe,</para>
  <para style="q">ex ate kyolil wi'je' tzalu twitz tx'otx'.</para>
  <para style="q">
    <verse number="26" style="v" />B'a'ntzun qa mab'je'l qowju' nchib'jile' toj piẍi'n,</para>
  <para style="q">knla'we' Qman Dyos.</para>
  <para style="q">
    <verse number="27" style="v" />Knla'ku'we' kyu'nku' nwitze',</para>
  <para style="q">ayinku'we' ex mya' juntlwit.</para>
  <para style="b" />
  <para style="q">Noqtzun a nkub'aju' wipumale'</para>
  <para style="q">
    <verse number="28" style="v" />ajnb'inteye' kyole':</para>
  <para style="q">¿Se'ntzunlo kb'ela'ti'j qu'n?</para>
  <para style="q">Tu'nxnate' saja' taq'wix ti'j, chechije'</para>
  <para style="q">
    <verse number="29" style="v" />Che xob'tzune' te tk'uẍtx'e'nb'il Dyos,</para>
  <para style="q">ju' najb'en tu'n Dyos ttz'e'yb'il twitzju' b'inchal taq'wix.</para>
  <para style="q">Kaneku' toj kywitze' qa ati jun ajkawil, chi Job'.</para>
  <chapter number="20" style="c" />
  <para style="sp">Sopar</para>
  <para style="q">
    <verse number="1-2" style="v" />Matxi' b'aj npasense' ti'ja;</para>
  <para style="q">qu'mtzun kxe'l nma'ne' teya.</para>
  <para style="q">
    <verse number="3" style="v" />Ink'ixb'sanju' tyola weye',</para>
  <para style="q">ayintzunwe' kanli nwitze' se'n kxela' nmojtza'ne' teya.</para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" />B'i'na' tu'na ikxte ttenju'</para>
  <para style="q">atxi'x tkub'len q'o'n xjal twitz tx'otx':</para>
  <para style="q">
    <verse number="5" style="v" />Lwiy nkub'ajte' ttzalajb'ilju' b'inchal myab'a'n;</para>
  <para style="q">noq jun kmuj ntzalaj.</para>
  <para style="q">
    <verse number="6" style="v" />B'a'ntzun qa nimin twe' kse'n kya'j</para>
  <para style="q">ex njapunkanun twi' tzmax toj muj,</para>
  <para style="q">
    <verse number="7" style="v" />kb'elnaj kse'n tz'a'lj</para>
  <para style="q">ex layx kyiltlju' tamiw jakpomela'.</para>
  <para style="q">
    <verse number="8" style="v" />K'ik'eltna'l kse'n jun witzik' te qonik'an,</para>
  <para style="q">ex mix-a'lo'x k'okyel yalsante.</para>
  <para style="q">
    <verse number="9" style="v" />Lay tz'ilwitl kyu'nju' najliqetoq tuk'i'l ex makyil twitz.</para>
  <para style="q">
    <verse number="10" style="v" />K'anjel kyanjsa'ntl tk'wal</para>
  <para style="q">ju' ojetoq b'je'l talq'a'n kyeju' prow.</para>
  <para style="q">
    <verse number="11" style="v" />Tojkuxi'x tku'xumal kkyimela'.</para>
  <para style="q">
    <verse number="12" style="v" />Majx k'ok'j k'elila' taq'wixil te,</para>
  <para style="q">okxi'x kb'el tnik'b'e'n;</para>
  <para style="q">
    <verse number="13" style="v" />kb'el tnik'b'e'n b'a'nxi'x</para>
  <para style="q">ex chab'a kjulil ti'j.</para>
  <para style="q">
    <verse number="14" style="v" />Atzu'n aj tku'pun toj tk'u'j,</para>
  <para style="q">kjawil b'ent te b'iyb'il kan.</para>
  <para style="q">
    <verse number="15" style="v" />Kjawitz t-xa'n jumajtlju' q'inumal b'aj tu'n;</para>
  <para style="q">aku'te Dyos k'elil q'inte ti'j.</para>
  <para style="q">
    <verse number="16" style="v" />Intoq ttz'ub'a'n tb'iyb'il kan,</para>
  <para style="q">atzunte kb'yolteju'.</para>
  <para style="q">
    <verse number="17" style="v" />Lay tnik'b'e txqan lech ex ta'lkab',</para>
  <para style="q">nche' tolaq'in kse'n nin a'.</para>
  <para style="q">
    <verse number="18" style="v" />Ati tu'n tanj tanjsa'nju' ojetoq b'ajkub' tetza'n;</para>
  <para style="q">lay tnik'b'e ex lay tzalaj ti'ju' tq'inumal.</para>
  <para style="q">
    <verse number="19" style="v" />Matz'ok wan kyi'ju' prow ex mache kyej tleb'a'n;</para>
  <para style="q">mache kub'tzyu'n ja mya tb'inchb'ajqe'.</para>
  <para style="q">
    <verse number="20" style="v" />Mixtoqti'x nqe tk'u'j</para>
  <para style="q">ex inxi'xtoq jamjonk kyi'j kykyaqil;</para>
  <para style="q">
    <verse number="21" style="v" />inb'aj tkyaqil tu'n.</para>
  <para style="q">Qu'mtzun lay tzalaj nimtoj.</para>
  <para style="q">
    <verse number="22" style="v" />Tu'npe' nim txqan ati te, ninxi'x yajb'il tzul ti'j;</para>
  <para style="q">kb'eltz'aq toj kyq'ob' b'inchal myab'a'n.</para>
  <para style="q">
    <verse number="23" style="v" />Ajtaq'wi wal tu'n tnoj b'a'nxi'x,</para>
  <para style="q">tzultzun ttx'u'jil Dyostz ti'j:</para>
  <para style="q">naku'j txqan jb'al ajttzaj chitj.</para>
  <para style="q">
    <verse number="24" style="v" />Qama tzaqpaj te jun q'ojb'il k'uxb'il,</para>
  <para style="q">kb'elti'j tu'n jun smaj q'ank'uxb'il.</para>
  <para style="q">
    <verse number="25" style="v" />Majx k'elex jlajinju' talsmaj toj t-xmilal,</para>
  <para style="q">majx k'elex xopq'iju' tk'a.</para>
  <para style="q">Majx k'okyeltchi ti'j;</para>
  <para style="q">
    <verse number="26" style="v" />kjel take toj qlolj.</para>
  <para style="q">Kb'ajel tuk'i'lxi' tkyaqilju' tja</para>
  <para style="q">tu'n jun q'aq' kjawil k'ant tjunalx.</para>
  <para style="q">
    <verse number="27" style="v" />Kb'el yek'u'n til tu'n kya'j,</para>
  <para style="q">ex kjawil we'ju' tx'otx' poqilte.</para>
  <para style="q">
    <verse number="28" style="v" />Aj ttzaj tilj tx'u'jil Dyos tib'aj,</para>
  <para style="q">che b'elb'aju' tq'inumal.</para>
  <para style="q">
    <verse number="29" style="v" />Atzun oje kub' tq'o'n Dyos teju' b'inchal il;</para>
  <para style="q">axtzun teju' kyajni q'o'n, chi Sopar, chi Sopar.</para>
  <chapter number="21" style="c" />
  <para style="sp">Job'</para>
  <para style="q">
    <verse number="1-2" style="v" />Ate q'uq'b'ab'l nk'u'ju'ye' tu'n ttzaj kyq'o'ne'</para>
  <para style="q">aju' tu'n tkub'kyb'inju'ye' nyole'.</para>
  <para style="q">
    <verse number="3" style="v" />Tenku' kypasensiye' akx nchin yoline',</para>
  <para style="q">qatzun kyajb'ile' yajxi'tl a che tze'ne'.</para>
  <para style="q">
    <verse number="4" style="v" />Mya tuk'i'l jun xjal ta'we' nq'oj;</para>
  <para style="q">qu'mtzun matxb'aj npasense'.</para>
  <para style="q">
    <verse number="5" style="v" />Qama kub'kyb'i'ne',</para>
  <para style="q">che kjel meyixe' tu'n xob'il.</para>
  <para style="q">
    <verse number="6" style="v" />Ayinxpenawe' ajtkub' nximane', majx nchin sak'puje';</para>
  <para style="q">Majx nchin jaw lu'lune'.</para>
  <para style="q">
    <verse number="7" style="v" />¿Titiqu'n itz'qexu' b'inchal myab'a'n,</para>
  <para style="q">ex nche kub' tijin, ati kyipumal?</para>
  <para style="q">
    <verse number="8" style="v" />Inkylo'n ajkyb'aj ch'iyu' kyk'wal exqe' kychman,</para>
  <para style="q">nche b'aj anq'in tk'etz mixti'te kyb'is.</para>
  <para style="q">
    <verse number="9" style="v" />Mixti'te xob'el toj kyja;</para>
  <para style="q">min nkub' ttz'e'ysa'n Dyos kywitz.</para>
  <para style="q">
    <verse number="10" style="v" />Nche puqinju' kywakyix;</para>
  <para style="q">min nche ik'san.</para>
  <para style="q">
    <verse number="11" style="v" />Nche b'aj ch'akakanje kyk'wal kse'nqe' tal qpoj tman rit,</para>
  <para style="q">
    <verse number="12" style="v" />tzalajb'ilx nche' b'ixin ex nche' xlik'pun</para>
  <para style="q">toju' chnab' arpa, e'tunk'al ex e'chun.</para>
  <para style="q">
    <verse number="13" style="v" />Toj b'anil nche anq'ina';</para>
  <para style="q">ex chab'aku' nche'x toj muqb'il.</para>
  <para style="q">
    <verse number="14" style="v" />Inxikyma'n te Dyos: ¡Qo' tq'okja toj nak'b'il</para>
  <para style="q">min qajb'ile' tu'n qb'inteye' tkawb'ila!</para>
  <para style="q">
    <verse number="15" style="v" />¿Alkyetzu'n Nimtipumal, tu'n qajb'en te?</para>
  <para style="q">¿Titi' qkanb'a' tu'n qk'ulun twitz? chechij.</para>
  <para style="q">
    <verse number="16" style="v" />(Myaye'nakye' b'inchal myab'a'n tajaw kychwinqlal.</para>
  <para style="q">¡Miwtjun kub' nximane' kse'nkye!)</para>
  <para style="b" />
  <para style="q">
    <verse number="17" style="v" />¿Jtojewtlo yupj kytzaju' b'inchal myab'a'n?</para>
  <para style="q">¿Jtoje e'kub'o'lj?</para>
  <para style="q">¿Jtoje tzaj ttx'u'jil Dyos kyi'j ex mawt che yajti?</para>
  <para style="q">
    <verse number="18" style="v" />¿Jtoje che'x sputj se'n ttxa triy</para>
  <para style="q">ajt-xilik'ik'in toj jun saqchanpach?</para>
  <para style="q">
    <verse number="19" style="v" />Aju' nq'umli qa a Dyos ntb'inchante</para>
  <para style="q">tu'n kychjonte k'walb'aju' kyil kyman.</para>
  <para style="q">Aku'na'te b'inchal myab'a'n</para>
  <para style="q">kchjolte ex kyajtel tu'nju' til.</para>
  <para style="q">
    <verse number="20" style="v" />Ate kb'el tz'e'ysa'n twitz</para>
  <para style="q">tu'n ttx'ujilju' nimtipumal.</para>
  <para style="q">
    <verse number="21" style="v" />¿Titi'tzuntl toklen kyi'ju' toj tja</para>
  <para style="q">matxitoqna' kyim?</para>
  <para style="q">
    <verse number="22" style="v" />(¿Alkyetzun kb'antel t-xnaq'tzante Dyos,</para>
  <para style="q">ju' nche okju' te toj kya'j toj xjel tu'n?)</para>
  <para style="b" />
  <para style="q">
    <verse number="23" style="v" />Ate'kye' nche kyim,</para>
  <para style="q">ati kyipumal, tzalajb'il ex nak'b'il,</para>
  <para style="q">
    <verse number="24" style="v" />B'a'nqe' ex b'a'n te'qe'ya'.</para>
  <para style="q">
    <verse number="25" style="v" />Aye'tzun junjuntl, nche anq'in toj tka'yil</para>
  <para style="q">ex mixti'x nkylo'n tzalajb'il ajkykyim.</para>
  <para style="q">
    <verse number="26" style="v" />Atzu'nte' toj muqb'il junelnite';</para>
  <para style="q">kykyaqilx nche b'ajwan kyu'n ẍchuq'.</para>
  <para style="q">
    <verse number="27" style="v" />B'i'nwe' wu'n titi' kyxime' wi'je'</para>
  <para style="q">jni'xju' kynab'le' taq'wix.</para>
  <para style="q">
    <verse number="28" style="v" />Inkyxjelu'ne': ¿Jata' tja b'inchal myab'a'n</para>
  <para style="q">ju' kuw tchaq'b'il? chechije'.</para>
  <para style="q">
    <verse number="29" style="v" />¿Na'mxtzun kyoline' kyuk'i'lju' xjal nche b'et najchaq?</para>
  <para style="q">¿Ma na'mx kyb'inteju'ye' nkyma'n:</para>
  <para style="q">
    <verse number="30" style="v" />qa ajttzaj ttx'u'jil Dyos, ntzaj tq'o'n yajb'il</para>
  <para style="q">atzunte' b'inchal myab'a'n mixti' nnik'a'?</para>
  <para style="q">
    <verse number="31" style="v" />Mixalote' nxipajunte tplaj aju' ntb'incha'n,</para>
  <para style="q">ex mix-a'lo' nokq'onte tu'me'l t-xel te.</para>
  <para style="q">
    <verse number="32-33" style="v" />Ajtzun tmankun nxi' muqb'aj,</para>
  <para style="q">kykyaqilxtzun txoli'nkyib' ajkyxi' wab'alte,</para>
  <para style="q">junjun nejlqe' twitz ex junjuntl lepchqe'x ti'j,</para>
  <para style="q">ex nche' xq'uqin ti'ju' muqb'il,</para>
  <para style="q">expe' b'uninju' tx'otx' te.</para>
  <para style="b" />
  <para style="q">
    <verse number="34" style="v" />¡Mixti'xte' tajb'enju' q'uq'b'ab'l nk'u'je' kyu'ne'!</para>
  <para style="q">¡Qu'n tkyaqilju' nkyma'ne' weye' chajyolil! chi Job'.</para>
  <chapter number="22" style="c" />
  <para style="s1">Toxi'n tnej yol kyxol</para>
  <para style="r">(Caps. <ref loc="JOB 22-27">22—27</ref>)</para>
  <para style="sp">Elipas</para>
  <para style="q">
    <verse number="1-2" style="v" />¿Yajtzun chita qa aju' xjal atixi'x tnab'l,</para>
  <para style="q">qa jaku' tz'ajb'en te Dyos?</para>
  <para style="q">
    <verse number="3" style="v" />¿Titi' tajb'ena' ex titi' ntkanb'a'n Nimtipumal</para>
  <para style="q">tu'nju' tnik'alti'ja ex mixti' tila?</para>
  <para style="q">
    <verse number="4" style="v" />Qa ntzak'unjtza ex nq'ontz tnab'la tu'n,</para>
  <para style="q">mya tu'nwtju' nxi'x ajb'ena te,</para>
  <para style="q">
    <verse number="5" style="v" />Anate' tu'n nim tila</para>
  <para style="q">matxi'xi'x chmet txqan tila.</para>
  <para style="q">
    <verse number="6" style="v" />Nneltiq'i'na tprentil ch'ex kye titz'ina, maskye minojqelan;</para>
  <para style="q">nneltiq'i'na kyxb'alun ex nche kyej t-ẍb'iqb'a'na.</para>
  <para style="q">
    <verse number="7" style="v" />Qa ati jun nk'wajti min nxitq'o'na tk'wa';</para>
  <para style="q">ex ati jun nq'aq'an min nxitq'o'na twa.</para>
  <para style="q">
    <verse number="8" style="v" />¡Qu'n kuwtoqa ex nima'na kyu'n xjal,</para>
  <para style="q">toj twitza qa aya tajaw tx'otx'!</para>
  <para style="q">
    <verse number="9" style="v" />Kukx nanjkyi'ju' qya kyimni kychmil mixti'te nxi' tq'o'na kye,</para>
  <para style="q">ex myab'a'n kyilwiju' meb'a tu'na.</para>
  <para style="q">
    <verse number="10" style="v" />Qu'mtzun tok xob'el ti'ja ja'lo,</para>
  <para style="q">majx matz'oktchi ti'ja.</para>
  <para style="q">
    <verse number="11" style="v" />Qlolj tkyaqil, mixti'xte' q'ancha'l;</para>
  <para style="q">txqan tnimal a' matxi' tz'ex yotz'b'iya tu'n.</para>
  <para style="b" />
  <para style="q">
    <verse number="12" style="v" />Atzu' ta'te Dyos jawnixi' toj kya'j;</para>
  <para style="q">tjaq' tqan te'qe'ju' che'w ate' jawnixi'x.</para>
  <para style="q">
    <verse number="13-14" style="v" />¿Tiqu'n ntma'na qa min ntka'yi'n Dyos,</para>
  <para style="q">qa tu'nju' jupli muj min nb'ent tka'yinte?</para>
  <para style="q">¿Se'ntaq'wi ntma'na qa min nka'yin Dyos</para>
  <para style="q">qu'n nb'etinje toj tkyaqil twitz kya'j?</para>
  <para style="q">
    <verse number="15" style="v" />¿Atzun tajb'iljuya tu'n t-xitljo'na b'e toj qlolj</para>
  <para style="q">aju' ljo'n kyu'n b'inchal myab'a'n?</para>
  <para style="q">
    <verse number="16" style="v" />Lwiytzun ẍeb'aj kyim</para>
  <para style="q">naku'j naqẍe'x b'lo'n tu'n tnimal a'.</para>
  <para style="q">
    <verse number="17" style="v" />Inxikyma'n te Dyos: ¡Qo ttzaqpinkja!</para>
  <para style="q">¿Titi' kb'incha' Nimtipumal qeye'? chechij.</para>
  <para style="q">
    <verse number="18" style="v" />(Extzun a Dyos tzaj q'onteju' ati toj kyja.</para>
  <para style="q">¡Mixwit tzaja' nna'ne' kyxim b'inchal myab'a'n!)</para>
  <para style="q">
    <verse number="19" style="v" />Ajkylonte tnik'alkyi'j nche tzalaj;</para>
  <para style="q">aye'tzu'n mixti' kyil nche' tze'n</para>
  <para style="q">
    <verse number="20" style="v" />ajkyka'yite ljo'n tb'aj kyq'inumal</para>
  <para style="q">b'inchal myab'a'n tu'n q'aq'.</para>
  <para style="b" />
  <para style="q">
    <verse number="21" style="v" />B'incham jumajtltib'a tuk'i'l Dyos,</para>
  <para style="q">oktzun q'inumaxel jumajtltza.</para>
  <para style="q">
    <verse number="22" style="v" />K'momju'ya t-xnaq'tzb'il;</para>
  <para style="q">majx q'onkja tyol toj twi'ya.</para>
  <para style="q">
    <verse number="23" style="v" />Qama kub' tme'ssa'n tib'a, exqa matz'anjti'ja tuk'i'l Nimtipumal,</para>
  <para style="q">exqa matz'el ti'njuya taq'wixil toj tjaya.</para>
  <para style="q">
    <verse number="24" style="v" />Expe' qama tz'okju' q'anpwaq tb'anilxi'x,</para>
  <para style="q">naku'j quq teya, ex naku'j txqan ab'j toj a',</para>
  <para style="q">
    <verse number="25" style="v" />atzun Dyos nimtipumaltz</para>
  <para style="q">k'okyel te q'anpwaq ex saqpwaq teya.</para>
  <para style="q">
    <verse number="26" style="v" />A k'okyelju' te ttzalajb'ila,</para>
  <para style="q">ex k'okyel qe tk'u'ja ti'j.</para>
  <para style="q">
    <verse number="27" style="v" />Qama txitqani'na jun ti'xti' te, ktzajel b'i'na tu'n,</para>
  <para style="q">ex kjapumel tyola tu'na xi'ni ttziyana' te.</para>
  <para style="q">
    <verse number="28" style="v" />K'elelb'a'n tkyaqilju' ktb'incha'ya;</para>
  <para style="q">kqoptz'ajel spik'un toj tb'eya.</para>
  <para style="q">
    <verse number="29" style="v" />Qu'n inkub' tme'ssa'n Dyos njaw tnima'ntib'</para>
  <para style="q">ex nkletju' me's tu'n.</para>
  <para style="q">
    <verse number="30" style="v" />Ate klolteya, qa mixti' tpaja,</para>
  <para style="q">qa mixti' tila, chi Elipas.</para>
  <chapter number="23" style="c" />
  <para style="sp">Job'</para>
  <para style="q">
    <verse number="1-2" style="v" />Chin yolil jumajtle' toj tk'ayil</para>
  <para style="q">qu'n matxi' tz'oktq'ob' Dyos wi'je'.</para>
  <para style="q">
    <verse number="3" style="v" />¡Noqwit b'i'n wu'ne' jakknetela',</para>
  <para style="q">ex tu'n npone' janajla'!</para>
  <para style="q">
    <verse number="4" style="v" />Jaku'wtlo txinma'nju'ye' nchin nik'a'ye' te,</para>
  <para style="q">qu'n nimwe' nyol kolb'ilweye'.</para>
  <para style="q">
    <verse number="5" style="v" />¡Kanliwtlo nwitze' titi' kxel ntzaq'we'ne' te</para>
  <para style="q">titi' matzaj tma'n weye'!</para>
  <para style="q">
    <verse number="6" style="v" />Lay tz'okten yolil kuw wuk'i'le',</para>
  <para style="q">xi'pe' jaku' chin kub'a' tb'i'ne'.</para>
  <para style="q">
    <verse number="7" style="v" />Jaku'wtlo tz'el tnik' qa tu'me'l wu'ne'</para>
  <para style="q">jaku'wtlo tma qa mixti' wile',</para>
  <para style="q">¡jaku' chin kyej ttzaqpi'ne' tejumajx!</para>
  <para style="q">
    <verse number="8" style="v" />Qama chinxe' jyolte Dyos toj tjawetzq'ij, myatzu' ta';</para>
  <para style="q">qama chinxtle' jyolte toj tkub'exq'ij, layx knet wu'ne'.</para>
  <para style="q">
    <verse number="9" style="v" />Qama chinxe' toj tb'a'nq'ob'kya'j, lay wile';</para>
  <para style="q">qama chinxtle' toj tnayajkya'j, lay tz'el yal wu'ne'.</para>
  <para style="q">
    <verse number="10" style="v" />Tojtzqi'n se'n nchin b'eta'ye';</para>
  <para style="q">ajtik'twitz wi'je', ẍnu'l qine' kse'n q'anpwaq.</para>
  <para style="q">
    <verse number="11" style="v" />Lepchqi'nxwe' kukxu' ti'ju' b'e tzajni tyek'u'n weye'</para>
  <para style="q">ex min nchin nel txalpuje' ti'j.</para>
  <para style="q">
    <verse number="12" style="v" />Nche japun tkawb'il ex tchaq'b'il wu'ne' kukxju',</para>
  <para style="q">ex myaju'we' wajb'il nb'incha'n.</para>
  <para style="q">
    <verse number="13" style="v" />Ajtkub' t-xima'n tu'n tb'inchante jun ti'xti', ktb'incha';</para>
  <para style="q">mix-a'lo' nch'exb'ente t-xim.</para>
  <para style="q">
    <verse number="14" style="v" />Aju' oje t-xima Dyos tu'n tb'inchante wi'je', atzun ktb'incha'ju',</para>
  <para style="q">kyuk'i'l txqantl ti'xti'.</para>
  <para style="q">
    <verse number="15" style="v" />Qu'mtzun nchin xob'e' te;</para>
  <para style="q">noqpe' qama kub' nxima'ne' majx ntzaj tchi wi'je'.</para>
  <para style="q">
    <verse number="16" style="v" />Matxi' chin xob'e',</para>
  <para style="q">tu'n Qman Dyos Nimtipumal.</para>
  <para style="q">
    <verse number="17" style="v" />¡Noqwit chin kub'tnajsa'ne' qonik'an,</para>
  <para style="q">ex chin kub'wit tb'altz'i'ne' qxopin!</para>
  <chapter number="24" style="c" />
  <para style="q">
    <verse number="1" style="v" />¿Tiqu'ntzun min ntma'n Nimtipumal jun tajlal xjaw jtoj tu'n tb'inchante jun ti'xti',</para>
  <para style="q">tu'nwtzunlo kyk'ayinte tamiw?</para>
  <para style="q">
    <verse number="2" style="v" />Inche laq'b'an nqachju' b'inchal myab'a'n,</para>
  <para style="q">ex nche elq'an rit tu'n kychmet kyrit,</para>
  <para style="q">
    <verse number="3" style="v" />nb'jel kyxk'a'yu'n kyalu'n meb'a</para>
  <para style="q">ex kyalu'n qya kyimni kychmil.</para>
  <para style="q">
    <verse number="4" style="v" />Inche b'je'lkypa'n prow ti'ju' b'e,</para>
  <para style="q">aye'tzu'n me's xjal noq nche' ewan.</para>
  <para style="q">
    <verse number="5" style="v" />Aye'tzunkye' prow, naku'j tojk'ul chejqe' toj chq'ajlaj,</para>
  <para style="q">ncheb'jex jyol kywa ex penexi'x nkneta',</para>
  <para style="q">tojtzu'n chq'ajlaj ntzaja' kywaju' kyk'wal.</para>
  <para style="q">
    <verse number="6" style="v" />Inche'x jyol spiy toj kykojb'il xjal,</para>
  <para style="q">mujqa nche'x sakwil toj kyawb'iju' b'inchal il,</para>
  <para style="q">
    <verse number="7" style="v" />Nexju' qonik'an kyu'n mixti'te' kytxo'w,</para>
  <para style="q">mixti'xte' ch'i'n kutxb'ilkye teju' che'w.</para>
  <para style="q">
    <verse number="8" style="v" />Inche exyotz'b'i tu'n jb'al kywi'witz,</para>
  <para style="q">xi'nkyklo'na'kyib' nche oklak'e kyxe pik.</para>
  <para style="b" />
  <para style="q">
    <verse number="9" style="v" />In elkyiq'in kyneẍu' qya kyimni kychmil,</para>
  <para style="q">ex nb'je'l kyiq'i'n prent kyeju' prow.</para>
  <para style="q">
    <verse number="10" style="v" />Ẍla'q kyi'ju' prow,</para>
  <para style="q">nche' iqan triy extzun nchenaj tu'n we'yaj.</para>
  <para style="q">
    <verse number="11" style="v" />Inkyukcha'n ab'j cheb'l aseyt;</para>
  <para style="q">nkub' kywab'e'n ub'a tu'n telset b'in</para>
  <para style="q">ch'inxtzun kyelkyim tu'n k'waj.</para>
  <para style="q">
    <verse number="12" style="v" />Nxi'x che oq' ex nche t'i'njneju'</para>
  <para style="q">naqx tu'n kykyimtl toju' nintnam,</para>
  <para style="q">atzunte Dyos min ntzaj tb'i'n kyna'j Dyos.</para>
  <para style="b" />
  <para style="q">
    <verse number="13" style="v" />Ate' junjun nelkyik'u'nju' spik'un,</para>
  <para style="q">ex nche eltxalpuj ti'j toj tkyaqilju' kyb'e.</para>
  <para style="q">
    <verse number="14" style="v" />Prim njawe'ju' b'yolxjal b'yolte' prow,</para>
  <para style="q">ajtzu'n qok yupj naq'witzuntz elq'al.</para>
  <para style="q">
    <verse number="15" style="v" />Intayo'n ajpajil ajqok yupj,</para>
  <para style="q">ex nkub' tktxu'n twitz b'a'nxi'x,</para>
  <para style="q">nkub' t-xima'n: Mix-a'lo' kka'yil weye', chij.</para>
  <para style="q">
    <verse number="16" style="v" />Qonik'an nokxte' leq' kyojile ja.</para>
  <para style="q">Atzun q'ijtl nokx kyjpu'nkyib' kykyaqilx;</para>
  <para style="q">kyajq'oju' spik'un.</para>
  <para style="q">
    <verse number="17" style="v" />Qxopin nela' t-spik'umal q'ij kye;</para>
  <para style="q">axi'x kyajb'ilu' xob'ajil te qonik'an, chi Job'.</para>
  <para style="sp">Sopar</para>
  <para style="q">
    <verse number="18" style="v" />Nxi' iqa'nte' b'inchal myab'a'n tu'n a'.</para>
  <para style="q">Qani'n tib'aju' kytx'otx'</para>
  <para style="q">mix-a'lotlte naq'unan twitz.</para>
  <para style="q">
    <verse number="19" style="v" />Inkub' niwju' txun che'w tu'n q'ijal;</para>
  <para style="q">ikxtzu'n nkub'aju' aj il toj muqb'il.</para>
  <para style="q">
    <verse number="20" style="v" />Kpena' k'ik'eltna'l tu'nku' ttxu;</para>
  <para style="q">kb'ajel wan kyu'n ẍchuq',</para>
  <para style="q">ex mix-a'lo' ktzajel na'ntetl.</para>
  <para style="q">Kb'el tz'aqju' b'inchal myab'a'n se'n jun tze okni tx'emu'n.</para>
  <para style="q">
    <verse number="21" style="v" />Matz'ok mya'l kyeju' qya mixti' kyal</para>
  <para style="q">ex kyeju' kyimni kychmil, mixti'x sonin kyi'j.</para>
  <para style="q">
    <verse number="22" style="v" />Tuk'iltzunte Dyos tipumal, nche' jaw tjub'cha'n kuwqe';</para>
  <para style="q">ajtjawti'ntib', mixalotlte' kjelten.</para>
  <para style="q">
    <verse number="23" style="v" />Inche kyej tq'o'n Dyos tu'n kyanq'in q'uqli kyk'u'j,</para>
  <para style="q">extzun nt-xq'uqi'n se'n nche b'eta'.</para>
  <para style="q">
    <verse number="24" style="v" />Inche jawb'entju' b'inchal il,</para>
  <para style="q">ex ch'intqan nche kub'ajtl.</para>
  <para style="q">Nche kub' tzqij kse'n k'ul ajtjaw xb'oqit,</para>
  <para style="q">kse'n spiy ajttzaj majtz'uj.</para>
  <para style="q">
    <verse number="25" style="v" />Qatzun mikxa'ju' ¿alkyetzu'n kq'malte qa nchin chanyole'</para>
  <para style="q">ex kyek'ulte qa naq wak'a'ne'? chi Sopar.</para>
  <chapter number="25" style="c" />
  <para style="sp">B'ildad</para>
  <para style="q">
    <verse number="1-2" style="v" />Kuwte' Dyos ex xob'ajilx;</para>
  <para style="q">ate nq'onte nak'b'il toj kya'j.</para>
  <para style="q">
    <verse number="3" style="v" />Layx b'ent kyajletju' t-xjal te q'oj,</para>
  <para style="q">in qoptz'aju' t-spik'umal kyib'aj tkyaqil.</para>
  <para style="q">
    <verse number="4" style="v" />¿Oktzunlo kb'antel tok jun xjal,</para>
  <para style="q">ẍtilun ex mixti' til twitz Dyos?.</para>
  <para style="q">
    <verse number="5" style="v" />Mixpenati' ntilky'aju' xjaw</para>
  <para style="q">ex mya ẍtilunqe' che'w twitz Qman Dyos,</para>
  <para style="q">
    <verse number="6" style="v" />Mitzunloyate' xjal;</para>
  <para style="q">naku'j ẍchuq', chi B'ildad.</para>
  <chapter number="26" style="c" />
  <para style="sp">Job'</para>
  <para style="q">
    <verse number="1-2" style="v" />¡Atzunlo tu'me'lju' tu'n tonit jun numjni,</para>
  <para style="q">tu'n tkletju' mixti'tl tipumal!</para>
  <para style="q">
    <verse number="3" style="v" />¡B'a'nte' tu'me'l tu'n tq'on nab'la</para>
  <para style="q">ex tu'n t-xnaq'tzana teju' mixti' b'a'n tu'n!</para>
  <para style="q">
    <verse number="4" style="v" />¿Alkyetzun onilteya tu'n tyola kju'na'j?</para>
  <para style="q">¿alkye saj q'mante tu'n tyolina ikju'? chij.</para>
  <para style="sp">B'ildad</para>
  <para style="q">
    <verse number="5" style="v" />Inche lu'lunju' kyimni, ate'qe' toj ninnjab' nim t-xe,</para>
  <para style="q">tu'n xob'ajil tzmax t-xexi' ninnjab'.</para>
  <para style="q">
    <verse number="6" style="v" />Nya miwtjun b'i'nju' muqb'il</para>
  <para style="q">tkawb'il kamik tu'n Dyos.</para>
  <para style="q">
    <verse number="7" style="v" />Xit-slik'u'n Dyos kya'j tib'aju' mixti' ttx'o'lajil</para>
  <para style="q">ex kub' tq'o'n tx'otx' jamixti'x ati.</para>
  <para style="q">
    <verse number="8" style="v" />Ntchmo'nju' a' toju' muj</para>
  <para style="q">ex min ntzaj tz'aqju' muj tjaq' talal;</para>
  <para style="q">
    <verse number="9" style="v" />Inkub' tjpu'n twitz xjaw</para>
  <para style="q">tu'n txqan muj;</para>
  <para style="q">
    <verse number="10" style="v" />kub' tq'o'n ninnjab' te nqach</para>
  <para style="q">jakpomela' b'aju' spik'un exju' qxopin.</para>
  <para style="q">
    <verse number="11" style="v" />Ajtyolin Dyos kuw,</para>
  <para style="q">majx nche lu'lun nimaq witz tu'n kyxob'il.</para>
  <para style="q">
    <verse number="12" style="v" />Tu'nju' tipumal kub'a' ti'ju' ninnjab';</para>
  <para style="q">ex tu'n tnab'l kub'a' ti'ju' nin txkup Raab'.</para>
  <para style="q">
    <verse number="13" style="v" />Tu'n jun xupinx kyeja' t-ẍtilsa'n kya'j;</para>
  <para style="q">kub' tb'yo'n xjutz kan tu'n tq'ob'.</para>
  <para style="q">
    <verse number="14" style="v" />Naqpe' ch'i'nte' lu ti'ju' taq'unb'en;</para>
  <para style="q">naq jun tq'ojq'ojelte' matxi' qb'i.</para>
  <para style="q">¿Alkye k'elil tnik' ti'ju' tq'ojq'ojel nimtipumal? chi Job'.</para>
  <chapter number="27" style="c" />
  <para style="sp">Job'</para>
  <para style="q">
    <verse number="1-2" style="v" />¡Yajxitzuntl tma Job': Majx lu Qman Dyos Nimtipumal,</para>
  <para style="q">aju' min ntb'i'ncha'n tnik'alilti'j weye'</para>
  <para style="q">ex machin nokye' toj tk'ayil tu'n,</para>
  <para style="q">
    <verse number="3" style="v" />atixku' wipumale' tu'n nxewtiye' tu'n,</para>
  <para style="q">
    <verse number="4" style="v" />layx chin chanyole'</para>
  <para style="q">ex layx txinma'n chajyolile'!</para>
  <para style="q">
    <verse number="5" style="v" />Akxku' itz'qine', axwe' nyol, qu'n mixti'we' wil;</para>
  <para style="q">¡lay waje' aye'xi'xwitkye' ati tu'me'l kyol ajnxi' kypoqo'ne'!</para>
  <para style="q">
    <verse number="6" style="v" />Kukxwe' nmante qa b'a'n xjal qine',</para>
  <para style="q">qu'n mixti'we' wil.</para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" />¡Kykyaqilju' makyek'ukyib' qa wajq'oj qe'ye',</para>
  <para style="q">ikx che ik'ela' kse'n b'inchal myab'a'n ex kse'n mya tnik'alti'j!</para>
  <para style="q">
    <verse number="8" style="v" />¿Titi' q'uqb'ab'l tk'u'ju' min nokslan te Dyos</para>
  <para style="q">ajtel tiq'i'n Dyos tchwinqlal?</para>
  <para style="q">
    <verse number="9" style="v" />Ajtok takpuj twitz jun ti'xti',</para>
  <para style="q">lay t-xitb'i'n Dyos tkub'sb'il.</para>
  <para style="q">
    <verse number="10" style="v" />Layx knet ttzalajb'il tuk'i'l Dyos Nimtipumal,</para>
  <para style="q">mixna'jun nna'n Dyos.</para>
  <para style="b" />
  <para style="q">
    <verse number="11" style="v" />Kxe'l nyek'u'ne' tipumal Dyos nimxi'x kye,</para>
  <para style="q">ex t-ximju' Nimtipumal.</para>
  <para style="q">
    <verse number="12" style="v" />Qatzun oje kyile' kykyaqile',</para>
  <para style="q">¿tiqu'ntzun mixya b'a'n nkyma'ne'? chi Job'.</para>
  <para style="sp">Sopar</para>
  <para style="q">
    <verse number="13" style="v" />Atzun tz'e'ysb'il kywitz xjalju' mya'lqe' ex b'inchal myab'a'n</para>
  <para style="q">tzultq'o'n Dyos Nimtipumal:</para>
  <para style="q">
    <verse number="14" style="v" />b'a'ntzun qa nim txqan kyk'wal,</para>
  <para style="q">che kyimel toj q'oj mujqa tu'n we'yaj.</para>
  <para style="q">
    <verse number="15" style="v" />Aye'tzu'n che kjel anq'in, che kyimel tu'n tx'u'j yab'il,</para>
  <para style="q">ex lay che oq'ju' kyxu'jil kyi'j.</para>
  <para style="b" />
  <para style="q">
    <verse number="16" style="v" />B'a'ntzun qa mab'aj tb'u'yi'n b'inchal myab'a'n txqan t-saqpwaq naku'j ch'uq tx'otx',</para>
  <para style="q">ex nim txqan t-xb'alun b'u'yi'n,</para>
  <para style="q">
    <verse number="17" style="v" />junlo ichan b'a'n xjal k'oksalkye xb'alun lu</para>
  <para style="q">ex jun b'a'n xjal kwal ti'ju' saqpwaq lu.</para>
  <para style="q">
    <verse number="18" style="v" />Naqtokxju' tja b'inchal myab'a'n kse'n tja pich',</para>
  <para style="q">kse'n pach xq'uqb'il kojb'il.</para>
  <para style="q">
    <verse number="19" style="v" />Q'inun ajtkub' kẍe mankb'il maj,</para>
  <para style="q">ajtzun ttzaj tna'ntib', ma'toq kuprowix.</para>
  <para style="q">
    <verse number="20" style="v" />K'okyel xob'el kyi'j te q'ijtl,</para>
  <para style="q">che b'ajeltzuntz tu'n q'ankyaq te qonik'an.</para>
  <para style="q">
    <verse number="21" style="v" />K'eletz jub'cha'n toju' tja</para>
  <para style="q">tu'n kyq'iq' jb'al tzul tjawetzq'ij;</para>
  <para style="q">
    <verse number="22" style="v" />kjub'il b'a'nxi'x ti'j ex layx k'achji ch'i'n,</para>
  <para style="q">maskye tajb'il tu'n tklontetib'.</para>
  <para style="q">
    <verse number="23" style="v" />Majx nok lpe kyq'iq' ti'j, njub'in ex nxuk'in ti'j.</para>
  <chapter number="28" style="c" />
  <para style="q">
    <verse number="1" style="v" />Ati ttx'otx'al saqpwaq janetza'</para>
  <para style="q">ex ati janb'incheta' q'anpwaq tu'n tb'ent tz'umin.</para>
  <para style="b" />
  <para style="q">
    <verse number="2" style="v" />Toj tx'otx' njatza' ttx'otx'al k'uxb'il,</para>
  <para style="q">aye'tzu'n ab'j ajkytzq'ajset, nel q'ank'uxb'il kyi'j.</para>
  <para style="q">
    <verse number="3" style="v" />Ma knet tb'eyil tu'n xjal toj qxopin:</para>
  <para style="q">nku'x lq'e tzmax kub'l,</para>
  <para style="q">atzuntzu' nela' yal tb'anil ab'j tu'n.</para>
  <para style="q">
    <verse number="4" style="v" />In ik'tjoyli kyu'n nche xtunin ti'j aqwil twitz pik,</para>
  <para style="q">nche lukjne najchaq kyi'jxi' nimaqtnam,</para>
  <para style="q">ja mixti' nik'a' jun xjal.</para>
  <para style="q">
    <verse number="5" style="v" />Intzaj triy toju' tx'otx' tib'ajxi',</para>
  <para style="q">atzu'n tjaq'xi' naku'j q'aq' nk'ant.</para>
  <para style="q">
    <verse number="6" style="v" />Atzuntzu' ta'te' ab'j sapiro,</para>
  <para style="q">ex nknet q'anpwaq toj tx'otx'.</para>
  <para style="q">
    <verse number="7" style="v" />B'ajxpena' kyila' t'iw exqe' k'utz</para>
  <para style="q">qa ate' jutz'b'e tjaq' tx'otx'.</para>
  <para style="q">
    <verse number="8" style="v" />B'ajx che ik'a' tojk'ul txkup atzu',</para>
  <para style="q">ex min nche b'etju' b'alun toj.</para>
  <para style="q">
    <verse number="9" style="v" />Nche jatztlku'n xjal ab'j toj pik</para>
  <para style="q">ex majx nche kyej sjile kylok' tze tu'n.</para>
  <para style="q">
    <verse number="10" style="v" />In okx tlku'n tb'eyil kyoj pik</para>
  <para style="q">ex njyet tkyaqil tlok'al k'uwenj tu'n.</para>
  <para style="q">
    <verse number="11" style="v" />Nb'aj tka'yi'n tkyaqil t-xiklil nin a'</para>
  <para style="q">ex nche elyal tu'n tkyaqil ti'xti' e'wa'n.</para>
  <para style="q">
    <verse number="12" style="v" />¿Jatzunja ntzaja' nab'l?</para>
  <para style="q">¿Ja tu'me'l ta'ju' k'atzil?</para>
  <para style="q">
    <verse number="13" style="v" />Min b'i'n tu'n xjal jte' twi' nab'l lu,</para>
  <para style="q">ex min nknet tu'n twitz tx'otx'.</para>
  <para style="q">
    <verse number="14" style="v" />Mixti'te' tzalu, chiju' ttxuylal a',</para>
  <para style="q">ex Mixti'we' woj, chiju' ninnjab'.</para>
  <para style="q">
    <verse number="15" style="v" />Layx jyet tu'n q'anpwaq,</para>
  <para style="q">ex lay b'ent tlq'et tu'n saqpwaq.</para>
  <para style="q">
    <verse number="16" style="v" />Layx b'ent tchjet tu'n tb'anil q'anpwaq,</para>
  <para style="q">mo tu'n tb'anil ab'j kornalina mo sapir.</para>
  <para style="q">
    <verse number="17" style="v" />Wi'yilxi'xte' kyetwitz q'anpwaq ex ẍtil-ab'j;</para>
  <para style="q">lay b'ent tch'exb'et tuk'i'l juntl ti'xti' q'anpwaqxi'x.</para>
  <para style="q">
    <verse number="18" style="v" />Majx tb'anilxi'xte' nab'l kyetwitz koral,</para>
  <para style="q">ex kyetwitz ẍtil-ab'j ntzaj ti'j pik ex cha'x ab'j.</para>
  <para style="q">
    <verse number="19" style="v" />Layx pon twi' ab'j krisolit ntzaj Etyopiy kse'n nab'l,</para>
  <para style="q">ex lay b'ent tchjet tu'n q'anpwaq tz'uminxi'x.</para>
  <para style="q">
    <verse number="20" style="v" />¿Jatzunja ntzaja' nab'l?</para>
  <para style="q">¿Jatzun ta'ya' k'atzil?</para>
  <para style="q">
    <verse number="21" style="v" />E'wa'n kywitzju' tojk'ul txkup,</para>
  <para style="q">ex e'wa'n kywitzju' pich' twitz kya'j.</para>
  <para style="q">
    <verse number="22" style="v" />Inpe' kyma'n xitul ex kamik kjalu:</para>
  <para style="q">Naqx nxiqb'i'nqe', chechij.</para>
  <para style="q">
    <verse number="23" style="v" />Atzunte Dyos tojtzqi'n tb'eyil nab'l;</para>
  <para style="q">o'kxte b'ilte jakknetela',</para>
  <para style="q">
    <verse number="24" style="v" />qu'n in tka'yi'n tkyaqil twitz tx'otx'</para>
  <para style="q">ex tkyaqilju' ati tjaq' kya'j.</para>
  <para style="q">
    <verse number="25" style="v" />Tej ttzaj tq'o'n Dyos tipumalju' kyq'iq'</para>
  <para style="q">ex kajtq'o'n tmaqb'ilju' a',</para>
  <para style="q">
    <verse number="26" style="v" />tej tmante tu'n ttzaj jb'al</para>
  <para style="q">ex tkyej tq'o'n tb'eyil q'ankyaq,</para>
  <para style="q">
    <verse number="27" style="v" />Ex til Dyosju' nab'l, tilju' tajb'eb'l</para>
  <para style="q">b'aj tka'yi'n ex tma qa b'a'n.</para>
  <para style="q">
    <verse number="28" style="v" />Ex tma Qman Dyos kyeju' xjal kjalu:</para>
  <para style="q">Ate nab'lju', nche ajb'ene' weye' ayine' Dyos Manb'aj,</para>
  <para style="q">ex a k'atzilju' qama tz'el kypa'n kyib'e' ti'ju' taq'wix, chi Dyos, chi Sopar.</para>
  <chapter number="29" style="c" />
  <para style="sp">Job'</para>
  <para style="q">
    <verse number="1-2" style="v" />¡Noqwit ikyj tz'anj wi'je' kyoju' tq'ijlalil</para>
  <para style="q">tej ntoq chin tklo'ne' Dyos!</para>
  <para style="q">
    <verse number="3" style="v" />Tej ntoq tzaj ttxqo'n t-spik'u'mal wib'aje',</para>
  <para style="q">ex ntoq b'ant nb'ete' toj qxopin,</para>
  <para style="q">
    <verse number="4" style="v" />tej k'walqinxtoqe'</para>
  <para style="q">ex intoq t-xq'uqi'n Dyos njaye',</para>
  <para style="q">
    <verse number="5" style="v" />tej atitoqju' Nimtipumal wuk'i'le'</para>
  <para style="q">ex ate'toqju' nk'wale' nk'etze';</para>
  <para style="q">
    <verse number="6" style="v" />tej ntoq qojli lech twitz tx'otx'</para>
  <para style="q">ex intoq netz qojli aseyt toj pik;</para>
  <para style="q">
    <verse number="7" style="v" />tej ntoq chin kub' qeye'</para>
  <para style="q">toju' b'uyjtib'il toj nintnam.</para>
  <para style="q">
    <verse number="8" style="v" />Nche elju' ku'xun toj nb'eye' ajwik'e' kyk'etz</para>
  <para style="q">aye'tzu'n tijwnaq ntoq che kub' we'.</para>
  <para style="q">
    <verse number="9" style="v" />Exqepe' xjal nimaq kyoklen nqjen kyolin</para>
  <para style="q">ex nxikyse'n kyq'ob' tu'n kykub' nume.</para>
  <para style="q">
    <verse number="10" style="v" />Chab'atoq nche yolinju' kawil;</para>
  <para style="q">intoq kyej lak'e kyaq' toj kyk'o'n.</para>
  <para style="b" />
  <para style="q">
    <verse number="11" style="v" />Ajwlonjtze' kyu'n xjal ex ajkyb'inte toj nwi'ye',</para>
  <para style="q">intoq chin tzajkykuwsa'ne' ex b'a'n kyol wi'je',</para>
  <para style="q">
    <verse number="12" style="v" />Intoq chin oninwe' kyi'j meb'a ex prow,</para>
  <para style="q">aye' xjal mix-a'lo'x onilkye.</para>
  <para style="q">
    <verse number="13" style="v" />Intoq q'o'n chjonteju' kub'ni b'o'lj weye';</para>
  <para style="q">inxi'xtoq che tzalaju' qya kyimni kychmil tu'nju' wonb'ile'.</para>
  <para style="q">
    <verse number="14" style="v" />Tnik'alixi'xtoq ti'ju' nchwinqlale':</para>
  <para style="q">oksa'nktoqju' tnik'alilti'j wu'ne' tkyaqil q'ij.</para>
  <para style="q">
    <verse number="15" style="v" />¡Witzb'aj qintoqe' kye moẍ</para>
  <para style="q">ex qanb'aj qintoqe' kye kox,</para>
  <para style="q">
    <verse number="16" style="v" />manb'aj qintoqe' kye prow</para>
  <para style="q">ex kolol kyeju' najchaq xjal!</para>
  <para style="q">
    <verse number="17" style="v" />intoq b'ajnpa'ne' tjaq'kytziju' b'inchal myab'a'n</para>
  <para style="q">ex nel winq'i'ne' kychi' toj kytzi.</para>
  <para style="b" />
  <para style="q">
    <verse number="18" style="v" />Intoq kub' nxima'ne': Ikylo tq'ijlalil nchwinqlalju'ye' kse'n tz'awun;</para>
  <para style="q">tijwnaq qintle' ajnkyime' axtzu' toj njaye'.</para>
  <para style="q">
    <verse number="19" style="v" />Ikyqinju'ye' kse'n jun tze awa'n ttzi a',</para>
  <para style="q">nche ak' tq'ob' tu'n ta'l che'w te qonik'an.</para>
  <para style="q">
    <verse number="20" style="v" />Nch'ixpuju' nspik'umale',</para>
  <para style="q">ex lay b'aj wipumale', nchije'.</para>
  <para style="b" />
  <para style="q">
    <verse number="21" style="v" />Kykyaqilxtoq nche kub' b'inweye'</para>
  <para style="q">ex intoq kub'kyb'i'n kynab'l nxinq'o'ne'.</para>
  <para style="q">
    <verse number="22" style="v" />Ajnb'aj yoline', mix-a'lo'te ntzaj mojtzante.</para>
  <para style="q">B'a'nile nche b'je'la' nyole' kye,</para>
  <para style="q">
    <verse number="23" style="v" />inxi'x che tzalaj ti'j,</para>
  <para style="q">kse'n ajttzaj jb'al toj q'ijal.</para>
  <para style="q">
    <verse number="24" style="v" />Min nkyoksla'nxi'x qa nchin tze'ne' kye,</para>
  <para style="q">ex majx nche ka'yintz weye' ntze'n nwitze'.</para>
  <para style="q">
    <verse number="25" style="v" />Intoq kub' nq'o'ne' nkawb'ile' kyib'aj</para>
  <para style="q">ex nkub' nximane' titi' tu'n kyb'inchante,</para>
  <para style="q">kse'n jun nimaqkawil kywitz t-xjal te q'oj.</para>
  <para style="q">Intoq nq'uqb'a'ne' kyk'u'j qa nche b'isun.</para>
  <chapter number="30" style="c" />
  <para style="q">
    <verse number="1" style="v" />Atzu'n ja'lo nxi'x chin kub'tze'ne'</para>
  <para style="q">kyu'n q'a ku'xunqe'x nwitze',</para>
  <para style="q">mixpeti'x kyajb'enju' kyman</para>
  <para style="q">kyuk'i'l ntx'yane' xq'uqil rit.</para>
  <para style="q">
    <verse number="2" style="v" />¿Tixi'xti' kyajb'enju' kyq'ob' weye'?</para>
  <para style="q">naqna' nche numjkye' xjal lu.</para>
  <para style="q">
    <verse number="3" style="v" />Tu'n nin we'yaj ex nche yajti.</para>
  <para style="q">Naq tlok' tze tzqij te'qe'k walte</para>
  <para style="q">te qonik'an toj chq'ajlaj.</para>
  <para style="q">
    <verse number="4" style="v" />Intoq che xb'oqin k'ak'ul,</para>
  <para style="q">intoq xikywan, naku'j t-xe xmasin.</para>
  <para style="q">
    <verse number="5" style="v" />Ik'o'n qekye' lu kyu'n xjal,</para>
  <para style="q">xla'ja'nqe' kyu'n xjal kse'nqe' eleq';</para>
  <para style="q">
    <verse number="6" style="v" />expe' e'najan kyoj jyom,</para>
  <para style="q">kyoj pik ex kyoj xaq;</para>
  <para style="q">
    <verse number="7" style="v" />intoq che ẍch'in toj q'u'sin,</para>
  <para style="q">b'u'yi'nkyib' kyxol ch'i'x.</para>
  <para style="q">
    <verse number="8" style="v" />Xjal mixti'x kyajb'en, tojb'e k'walb'ajqe',</para>
  <para style="q">exni xla'ja'nqe' toj tnam.</para>
  <para style="b" />
  <para style="q">
    <verse number="9" style="v" />Atzu'n ja'lo nche' xmayin</para>
  <para style="q">matxi' chin okye' te kytzeb'l.</para>
  <para style="q">
    <verse number="10" style="v" />Nche molmon ex nche el lq'e wi'je',</para>
  <para style="q">expe' nokx kytzub'a'n toj nwitze'.</para>
  <para style="q">
    <verse number="11" style="v" />Tu'ntzu'n mixti' wipumale' ex me'ssa'nqine',</para>
  <para style="q">mixti'x nche niman weye'.</para>
  <para style="q">
    <verse number="12" style="v" />Inxi'x tzajkyb'uyi'nkyib' wi'je',</para>
  <para style="q">nche q'ojin wi'je', nchin kub' tz'aqe' kyu'n,</para>
  <para style="q">ex kyajb'il tu'n nkub' kyb'yo'ne'.</para>
  <para style="q">
    <verse number="13" style="v" />Nkub' kymqo'n nb'eye', tu'n nkyime' kyu'n,</para>
  <para style="q">ex mix-a'lo' nxi' myonkye.</para>
  <para style="q">
    <verse number="14" style="v" />Naku'j jutzliqe' toj jun t-xopajil nintapi</para>
  <para style="q">nche etz tzaqpaj wi'je'.</para>
  <para style="q">
    <verse number="15" style="v" />Matzaj tilj xob'ajilx wib'aje';</para>
  <para style="q">matxi lik'puju' woklene' nakuj kyq'iq';</para>
  <para style="q">ex makub'naju' nq'inumale' kse'n muj.</para>
  <para style="q">
    <verse number="16" style="v" />Min wajb'iltle' tu'n wanq'ine';</para>
  <para style="q">matxi' tz'ok b'is wi'je'.</para>
  <para style="q">
    <verse number="17" style="v" />Matxi' tz'ok k'ixk'oj toj nb'aqile';</para>
  <para style="q">kukx nyajtiju'ye' junjun qonik'an.</para>
  <para style="q">
    <verse number="18" style="v" />Matxi' tzyet ti'j nqule' tu'n Dyos,</para>
  <para style="q">ex nchin t-xtuni'ne' kuw.</para>
  <para style="q">
    <verse number="19" style="v" />Ma chinx t-xone' toj xoq'l,</para>
  <para style="q">naku'j quq ex tza'j qine'.</para>
  <para style="b" />
  <para style="q">
    <verse number="20" style="v" />Nchin qanin o'nb'ile' teya, Nman Dyos, ex min ntzaj tzaq'we'na,</para>
  <para style="q">nchin kub'san teya ex min nchin tzaj tb'i'na.</para>
  <para style="q">
    <verse number="21" style="v" />Matz'oka kuw weye',</para>
  <para style="q">majx ljo'n toj nq'ije' tu'na.</para>
  <para style="q">
    <verse number="22" style="v" />Inchin njaw tjub'cha'na tu'n kyq'iq',</para>
  <para style="q">ex nchin jaw t-xt'iju'na tu'n q'ankyaq.</para>
  <para style="q">
    <verse number="23" style="v" />B'i'n wu'ne' a tajb'ilju'ya tu'n nkyime',</para>
  <para style="q">ja che pomela' b'aj kykyaqilju' itz'qe'.</para>
  <para style="q">
    <verse number="24" style="v" />¿Ma b'ajxtzun txa' woni'na'ye' prow?</para>
  <para style="q">ina' nklo'nwe' toju' t-ẍji'lil.</para>
  <para style="q">
    <verse number="25" style="v" />¿Ma b'ajxtzun chin noq'aye' ti'ju' nyajti?</para>
  <para style="q">¿Ma b'ajxtzun tzaja' laqj nk'u'je' ti'ju' ati nojqelan te?</para>
  <para style="q">
    <verse number="26" style="v" />Wajb'il toqju'ye' tzalajb'il, yajb'iltlte' saj;</para>
  <para style="q">wajb'iltoqe' spik'un, qxopintlte' sul.</para>
  <para style="q">
    <verse number="27" style="v" />Nxi'x punjne wanmiye', mixti'x ojb'il te;</para>
  <para style="q">naqx yajb'ilte' ntzaj wi'je'.</para>
  <para style="q">
    <verse number="28" style="v" />B'isb'ajilxte' nchwinqlale', qu'n min nlo'ne' q'ij;</para>
  <para style="q">nchin qanin o'nb'ile' kywitz kykyaqil xjal.</para>
  <para style="q">
    <verse number="29" style="v" />Naku'j qitz'in qib'e' kyuk'i'l ẍal,</para>
  <para style="q">ex qamiw qib'e' kyuk'i'l ab'estrus.</para>
  <para style="q">
    <verse number="30" style="v" />Matxi' b'aj q'eqax nchib'jile',</para>
  <para style="q">nq'aq'b'ix toj nwinqile' tu'n kyaq.</para>
  <para style="q">
    <verse number="31" style="v" />Te oq'e'n tu'n k'ixk'oj</para>
  <para style="q">ẍe oka' chnab' arpa ex xux weye'.</para>
  <chapter number="31" style="c" />
  <para style="q">
    <verse number="1" style="v" />Makub' njk'u'n wib'e'</para>
  <para style="q">expe' tu'n lalun pon nk'u'je' kyi'j txin.</para>
  <para style="q">
    <verse number="2" style="v" />¿Alkyetzu'n tu'me'l t-xel ntzaj tq'o'n Nimtipumal</para>
  <para style="q">tzmax toj kya'j te junjun xjal?</para>
  <para style="q">
    <verse number="3" style="v" />¿Ma myatzu'n ati tu'n tkub' b'o'lju'</para>
  <para style="q">b'inchal myab'a'n ex aj il?</para>
  <para style="q">
    <verse number="4" style="v" />¿Ma mitzun jun ntka'yi'n Dyos nb'incha'ne'</para>
  <para style="q">ex ma min ntka'yi'n se'n chin b'ete'?</para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" />Majx lu Dyos b'ajx nb'inchaye' taq'wixil</para>
  <para style="q">ex b'ajx kub'a' nxima'na'ye' tu'n t-sb'et jun xjal.</para>
  <para style="q">
    <verse number="6" style="v" />¡Chin kub'xwit tmlo'ne' Dyos toj tqan peẍ tz'aqli,</para>
  <para style="q">k'eleltzun tnik'tz qa mixti' wile'!</para>
  <para style="q">
    <verse number="7" style="v" />Qa matxi' chin eltxalpuje' ti'ju' tzinun b'e,</para>
  <para style="q">qa matxi' pon nk'u'je' ti'j jun ti'xti',</para>
  <para style="q">exqa matz'elyal jun ti'xti' wi'je',</para>
  <para style="q">
    <verse number="8" style="v" />junxi'tlwit wanteju' wawale'</para>
  <para style="q">ex jatzwit xb'oqi'n wawale'.</para>
  <para style="b" />
  <para style="q">
    <verse number="9" style="v" />Qama chin sb'ete' tu'n jun qya</para>
  <para style="q">mujqa mapon nk'u'je' ti'j t-xu'jil nb'sine'.</para>
  <para style="q">
    <verse number="10" style="v" />Tz'aq'unanxwitju' nxu'jile' te juntl</para>
  <para style="q">ex junxi'chaqwit ichan kub'kẍe tuk'i'l</para>
  <para style="q">
    <verse number="11" style="v" />Qawt mixyab'a'n nb'incha'ne';</para>
  <para style="q">iltzunti'jtz tu'n ttz'e'yset nwitze'.</para>
  <para style="q">
    <verse number="12" style="v" />Naku'xwitloj q'aq' nb'aj txqan ti'xti' tu'n</para>
  <para style="q">jaku' b'aj tkyaqilju' ati weye' tu'n.</para>
  <para style="b" />
  <para style="q">
    <verse number="13" style="v" />Qa intoq kyqani'n nmajine' jun ti'xti' weye',</para>
  <para style="q">nxinq'o'ne' kyqanb'etz kukxju'.</para>
  <para style="q">
    <verse number="14" style="v" />¿Se'nxixtzulo juntl tu'me'l chin pomilaye' twitz Dyos?</para>
  <para style="q">¿ti'tzunlo kxel ntzaq'we'ne' ajwoke' toj xjel tu'n?</para>
  <para style="q">
    <verse number="15" style="v" />Junxte Dyos b'inchanqe ti'j qtxu,</para>
  <para style="q">tzaj tq'o'n nchwinqlale' ex ikxkye.</para>
  <para style="q">
    <verse number="16" style="v" />Mixti' junmaj miwitjun xi'woninju'ye' prow,</para>
  <para style="q">ex min waje' tu'n tik' we'yaj kyi'ju' qya kyimni kychmil.</para>
  <para style="q">
    <verse number="17" style="v" />Mixti' njunalwite' nchin wan,</para>
  <para style="q">nxinq'o'nwe' twa meb'a kukxju'.</para>
  <para style="q">
    <verse number="18" style="v" />Kye tilwi meb'a wu'ne' kukxju', naku'j nk'wale';</para>
  <para style="q">mache nkolwe' qya kyimni kychmil kukxju'.</para>
  <para style="q">
    <verse number="19" style="v" />Ajt-xinka'yinwe' qati jun xjal nyajti mixti' t-xb'alun,</para>
  <para style="q">mujqa jun prow mixti' ttxo'w,</para>
  <para style="q">
    <verse number="20" style="v" />noknq'o'ne' kysmal nrite' ti'j tu'n tmoq'ti,</para>
  <para style="q">ex nq'o'n chjonte weye'.</para>
  <para style="q">
    <verse number="21" style="v" />Mixjun xjaw wiq'i'n wib'e' kyi'j meb'a</para>
  <para style="q">tu'nwtu' ati woklene' kyuk'i'l ajkawil.</para>
  <para style="q">
    <verse number="22" style="v" />Qatzun mya ax weye',</para>
  <para style="q">che toqjxwitju' nq'ob'e';</para>
  <para style="q">che elxwit q'ulpaj ti'j nsemu'le'.</para>
  <para style="q">
    <verse number="23" style="v" />Intoq chin xob'e' teju' tz'e'ysb'il witzb'aj tu'n Dyos;</para>
  <para style="q">¡mixti' tu'me'l tu'n nwe'ye' twitz!</para>
  <para style="b" />
  <para style="q">
    <verse number="24" style="v" />B'ajx tz'oka'xi'we' q'anpwaq wu'n</para>
  <para style="q">axi'xwit q'uqb'ab'l nk'u'ju'ye'.</para>
  <para style="q">
    <verse number="25" style="v" />Myaxi'xtzu' ta'we' ntzalajb'il ti'ju' q'inumal</para>
  <para style="q">mujqa tu'n tkanb'et txqan npwaqe'.</para>
  <para style="q">
    <verse number="26" style="v" />Oje wile' q'ij nk'ant</para>
  <para style="q">exju' xjaw nqoptz'aj b'a'nxi'x.</para>
  <para style="q">
    <verse number="27" style="v" />Ex b'ajx chin k'ulunaye' toj ewaj kye</para>
  <para style="q">ex b'ajx che'x nk'lu'ne' tu'n nq'ob'e'.</para>
  <para style="q">
    <verse number="28" style="v" />B'a'nwttzulo ttz'e'yset nwitztze'</para>
  <para style="q">¡naqwit makub' wewa'ne' Dyos toj kya'j!</para>
  <para style="b" />
  <para style="q">
    <verse number="29" style="v" />Mixjun ẍin tzalaje' ti'ju' taq'wix ntzaj ti'j wajq'oje,</para>
  <para style="q">b'a'npe'tzulo qama tzaj jun k'ulb'a'n ti'j.</para>
  <para style="q">
    <verse number="30" style="v" />B'ajx chin qaninaye' tib'aj</para>
  <para style="q">ex min ntxokwe' tkamik.</para>
  <para style="q">
    <verse number="31" style="v" />Qajtzun kyajb'il junjunju' najlqe' nk'etze'</para>
  <para style="q">tu'n kyb'inchante myab'a'n kyi'ju' najchaq xjal,</para>
  <para style="q">
    <verse number="32" style="v" />Min waje' tu'n kywtan jun qonik'an najchaq xjal toj b'e.</para>
  <para style="q">Nxinq'o'nwe' anb'il kye kukxju' toj njaye'.</para>
  <para style="q">
    <verse number="33" style="v" />B'ajx kub'a' wewa'nwe' wil kse'n nkyb'incha'n junjuntl,</para>
  <para style="q">ex mya' toj ewaj ta'we' wil.</para>
  <para style="q">
    <verse number="34" style="v" />B'ajx tz'okxa' njpu'n wib'e'</para>
  <para style="q">tu'n nxob'ele' kye xjal</para>
  <para style="q">noqwit tu'n tpaju' ik'o'n qine' kyu'n toj njaye'.</para>
  <para style="b" />
  <para style="q">
    <verse number="35" style="v" />¡Atiwt jun b'il weye'!</para>
  <para style="q">tu'nku' nb'iye' nkuwseta'ju' nyole';</para>
  <para style="q">awtju' Nimtipumal tzaj tzaq'wente ja'lo.</para>
  <para style="q">Qanatzun ati wile', kytz'ib'anku'ye' poqb'il weye',</para>
  <para style="q">
    <verse number="36" style="v" />che jawil wiqa'ne' te ninb'ilweye';</para>
  <para style="q">che jawix nq'o'ne' te koron toj nwi'ye'.</para>
  <para style="q">
    <verse number="37" style="v" />Kxe'l nq'o'nwe' tajlal tkyaqilju' nb'inchb'ene' te Dyos,</para>
  <para style="q">lay chin xob'e' ajnpon lq'eye' twitz.</para>
  <para style="q">
    <verse number="38" style="v" />Min nxikyqani'n ntx'otx'e' taq'wix wi'je' toj kya'j,</para>
  <para style="q">ex min nche oq'u' kytxolil awal.</para>
  <para style="q">
    <verse number="39" style="v" />Qatzun matz'el welq'a'ne' tawal jun xjal,</para>
  <para style="q">mujqa matxi' che kub'nsb'u'ne' aq'unal toj kojb'il,</para>
  <para style="q">
    <verse number="40" style="v" />¡Ch'i'xwit che tzaj ch'iy toju' ntx'otx'e' t-xel triy,</para>
  <para style="q">ex taq'wix k'ulwit te t-xel seb'ad! chi Job'.</para>
  <para style="b" />
  <para style="q">B'ajtzun yolin Job' te kolb'iltib'.</para>
  <chapter number="32" style="c" />
  <para style="p">
    <verse number="1" style="v" />Tej kyka'yinte oxe' ichan kukxtoq tmante Job' qa mixti' til, mixti'tlte xikyma'n te. <verse number="2" style="v" />Atzun jun ichan Elyu tb'i, tk'wal B'arakyel aj B'us, tyajajil Ram, tzaj ttx'u'jil ti'j Job' tej tka'yinte kukxtoq tmanteju' qa mixti' tpaj twitz Dyos, ex tkyaqil nok tq'o'n te tpaj Dyos. <verse number="3" style="v" />Ex tzaj ttx'u'jil kyi'ju' oxe' tamiw Job', tu'nju' min b'ent ttzaq'wetl kyu'n, ela'tzuntz naku'j ate Dyos ati tpaj ex mya Job'. <verse number="4" style="v" />Kub' tyo'n Elyu ex min yolinaj tu'nju' k'walxtoq kyekywitzju' txqantl tamiw Job'; <verse number="5" style="v" />Atzunj tka'yinte mixti'tl b'ent ttzaq'wet kyu'n, min ik'xtl tu'n <verse number="6" style="v" />aq'witzuntz yolil.</para>
  <para style="s1">Tnejel ttx'olb'ab'l Elyu</para>
  <para style="sp">Elyu</para>
  <para style="q">K'walqinxnawe', aye'tzu'nkye' tijwnaq qe'tle',</para>
  <para style="q">mixtoqti' xxinma'n junwe' nyol.</para>
  <para style="q">
    <verse number="7" style="v" />Ex kub' nxima'ne': Yolinku'ju' twitzlalil;</para>
  <para style="q">tu'ntzun kyyek'unteju' kynab'l tu'n txqan kyab'q'i.</para>
  <para style="q">
    <verse number="8" style="v" />Kykyaqilpenakye xjal ati kynab'l,</para>
  <para style="q">qu'n tzaj tq'o'n Nimtipumal t-xew kye.</para>
  <para style="q">
    <verse number="9" style="v" />Mya tu'nte' nim tab'q'i jun xjal ati tnab'l,</para>
  <para style="q">ex mya tu'n tijwnaqil nche kaneya'xi'xtl ti'j.</para>
  <para style="q">
    <verse number="10" style="v" />Qu'mtzun nxinma'ne': Chin kyb'intztzune' ja'lo,</para>
  <para style="q">ikxwe' ati jte'we' nyol.</para>
  <para style="b" />
  <para style="q">
    <verse number="11" style="v" />Makub' nb'i'ne' ex matxi' nb'iye' tu'me'l kyole'.</para>
  <para style="q">Mawile' tej xkjoye' tu'me'l yol tb'anilxi'x,</para>
  <para style="q">
    <verse number="12" style="v" />ex mawile' mixti'x junkye'</para>
  <para style="q">xb'entl ttzaq'wente b'a'nxi'x te Job'.</para>
  <para style="q">
    <verse number="13" style="v" />Tu'ntzun lalun kymaye' qa atixi'x kynab'le',</para>
  <para style="q">aku'te Dyos kq'olte tzaq'web'lte.</para>
  <para style="q">
    <verse number="14" style="v" />B'ajxpena' tzaj yolina' Job' weye',</para>
  <para style="q">ex lay txi' ntzaq'we'ne' te kse'nkye'.</para>
  <para style="b" />
  <para style="q">
    <verse number="15" style="v" />Job', tzpeniqekye' oxe' xjal lu ti'j</para>
  <para style="q">ex mixti'tl kyol tu'n kytzaq'wente;</para>
  <para style="q">
    <verse number="16" style="v" />ex naqtmaya qa mixti'we' nyol kse'nkye mache kub'nume,</para>
  <para style="q">qu'n majpet kytzi.</para>
  <para style="q">
    <verse number="17" style="v" />Ikxwe' chin yolile' ti'ju' lu,</para>
  <para style="q">ati junwe' nyol tu'n t-xinma'n teya.</para>
  <para style="q">
    <verse number="18" style="v" />Nim txqanwe' nyol,</para>
  <para style="q">lay b'ent tkub' nyo'ntle',</para>
  <para style="q">
    <verse number="19" style="v" />majx nk'atjne weye' tu'n kyxinma'ne',</para>
  <para style="q">kse'n ak'a'j tz'u'n nel laqj tu'n b'in qama kyejten toj.</para>
  <para style="q">
    <verse number="20" style="v" />Chin yolile' tu'ntzun tb'ajx nma'ne' tkyaqil,</para>
  <para style="q">kxe'l nq'o'n jun tzaq'web'le' teya.</para>
  <para style="q">
    <verse number="21" style="v" />Lay naqwit jun kjawil nnima'ne';</para>
  <para style="q">chin yolile' junelni kye kykyaqil.</para>
  <para style="q">
    <verse number="22" style="v" />Axxi'x min naq'liqinwe' tu'n tjaw nnima'n jun xjal;</para>
  <para style="q">¡jaku' kub' tz'e'ysa'n nwitze' tu'n B'inchalte tkyaqil qama nb'inchaye'!</para>
  <chapter number="33" style="c" />
  <para style="q">
    <verse number="1" style="v" />Qu'mtzun, b'inqeku'ya nyole' Job';</para>
  <para style="q">b'intzju'ya kxe'l nma'ne' teya.</para>
  <para style="q">
    <verse number="2" style="v" />Atitlwe' ntzaq'web'l twi' waq':</para>
  <para style="q">
    <verse number="3" style="v" />chin yolile' axxi'x</para>
  <para style="q">majx kxel nchik'b'a'ne' nxime'.</para>
  <para style="q">
    <verse number="4" style="v" />A Dyos Nimtipumal b'inchanweye',</para>
  <para style="q">ex q'onte nxewe'.</para>
  <para style="q">
    <verse number="5" style="v" />Tzaq'wentz chaqa, qama b'ant tu'na,</para>
  <para style="q">b'inchamtib'a tu'n tyolina wuk'i'le'.</para>
  <para style="q">
    <verse number="6" style="v" />Junqo'xte' tuk'i'la twitz Dyos;</para>
  <para style="q">ex tx'otx' qinwe' kse'nta.</para>
  <para style="q">
    <verse number="7" style="v" />Qu'mtzun lalun xob'a weye',</para>
  <para style="q">lay kub' nkawi'na.</para>
  <para style="b" />
  <para style="q">
    <verse number="8" style="v" />Naku'j tmaya xinb'i'ne'</para>
  <para style="q">(aye' yolju' nb'iye' lu):</para>
  <para style="q">
    <verse number="9" style="v" />B'a'nqinwe' ex mixti'we' npaj,</para>
  <para style="q">mixti'we' npaj ex mixti' wile'.</para>
  <para style="q">
    <verse number="10" style="v" />Atzunte' Dyos ntjyo'n tu'me'l tu'n npoqete',</para>
  <para style="q">ex nchin noktq'o'ne' nakuj tajq'ojqine';</para>
  <para style="q">
    <verse number="11" style="v" />Matz'ok tq'o'n xpatx'k'uxb'il kyi'j nqane'</para>
  <para style="q">ex toktwitz wi'je' se'n nchin b'ete', chija.</para>
  <para style="q">
    <verse number="12" style="v" />Myatzun ttxolilte' ti'ju' ntma'na lu,</para>
  <para style="q">nimna'te Dyos toklen kyekywitz xjal.</para>
  <para style="q">
    <verse number="13" style="v" />¿Titiqu'n nxi' tchitpu'na te</para>
  <para style="q">tu'nju' min ntzaj ttzaq'we'n tu'me'l tyola?</para>
  <para style="q">
    <verse number="14" style="v" />Nyolinte Dyos toj chukchaq tu'me'l,</para>
  <para style="q">extzun min nelqnik' ti'j.</para>
  <para style="q">
    <verse number="15" style="v" />Ati maj nyolin qonik'an,</para>
  <para style="q">toj jun watl mujqa toj jun witzik',</para>
  <para style="q">ajkyb'ajik' wtan xjal,</para>
  <para style="q">ajkytzyet tu'n watl.</para>
  <para style="q">
    <verse number="16" style="v" />Nyolinte Dyos kye xjal;</para>
  <para style="q">nche ttzak'u'n ex nche tzaj t-xob'sa'n,</para>
  <para style="q">
    <verse number="17" style="v" />Tu'n kyeltpa'n kyi'ju' kyb'inchb'en myab'a'n</para>
  <para style="q">ex tu'n lalun jaw kynima'n kyib'.</para>
  <para style="q">
    <verse number="18" style="v" />Iktzu'n nche tklo'na' te muqb'il,</para>
  <para style="q">nche tklo'n te kamik.</para>
  <para style="q">
    <verse number="19" style="v" />Atzun junjun majtl toj yab'il ntzak'unjtza' xjal tu'n Dyos,</para>
  <para style="q">majx nch'yon toj tkyaqil twinqil.</para>
  <para style="q">
    <verse number="20" style="v" />Mixpeti' nel b'a'n tkyaqilju' tb'anil wab'j te,</para>
  <para style="q">maskye aju' ntwan kukxju'.</para>
  <para style="q">
    <verse number="21" style="v" />Xi'tkub'aju' tchib'jil,</para>
  <para style="q">q'ancha'l qe'tl tb'aqil.</para>
  <para style="q">
    <verse number="22" style="v" />Xi'tpon b'aju' tchwinqlal ttzi muqb'il,</para>
  <para style="q">naq atitl twitz kamik.</para>
  <para style="b" />
  <para style="q">
    <verse number="23" style="v" />Qatzun nqaku' ta' jun anjl tk'etz,</para>
  <para style="q">tu'npe jun kyxol kab'k'al lajnaq (1,000) tu'n tyolin ti'j,</para>
  <para style="q">ex tu'n tmante qa nanq'in toj ttzinunal,</para>
  <para style="q">
    <verse number="24" style="v" />tu'n tlaqjtk'u'j ti'j ex tu'nt-xitma'n te Dyos:</para>
  <para style="q">Kloma te kamik,</para>
  <para style="q">matxi' knet kolpib'lte wu'ne', chiku'.</para>
  <para style="q">
    <verse number="25" style="v" />Kb'anixeltzun jumajtl</para>
  <para style="q">kpomil jumajtl kse'n toj tku'xumal.</para>
  <para style="q">
    <verse number="26" style="v" />Kkub'sal twitz Dyos, ex ktzajel b'i'n;</para>
  <para style="q">k'okyelku' tka'yi'n twitz Dyos tuk'i'l tzalajb'il,</para>
  <para style="q">ex kb'itzal ti'ju' t-xtalb'il Dyos kywitz xjal.</para>
  <para style="q">
    <verse number="27" style="v" />Oktma': Machin b'inchan ile', mixya tnik'alti'ju' xnb'inchaye',</para>
  <para style="q">atzunte Dyos min xkub' ttz'e'ysa'n nwitze';</para>
  <para style="q">
    <verse number="28" style="v" />mape' chin tkole' te kamik</para>
  <para style="q">ex inx chin ka'yi'n spik'une', chiku'.</para>
  <para style="b" />
  <para style="q">
    <verse number="29" style="v" />Ikytzu'n ntb'incha'n Dyos</para>
  <para style="q">b'a'npun maj kye xjal;</para>
  <para style="q">
    <verse number="30" style="v" />intklo'n te kamik</para>
  <para style="q">ntq'o'n anb'il te tu'n tlonte spik'un.</para>
  <para style="b" />
  <para style="q">
    <verse number="31" style="v" />Chin tb'iku'ya b'a'nxi'x Job',</para>
  <para style="q">numekuya akx nchin yoline'.</para>
  <para style="q">
    <verse number="32" style="v" />Qa ati jun tyola, tzaq'wentza;</para>
  <para style="q">qatzun tu'me'l, kb'el nb'i'ne' b'a'nxi'x;</para>
  <para style="q">
    <verse number="33" style="v" />qatzun min, k'uttziya</para>
  <para style="q">atzun txinxnaq'tza'na tu'n tten tnab'la, chi Elyu.</para>
  <chapter number="34" style="c" />
  <para style="s1">Tkab' ttx'olb'ab'l Elyu</para>
  <para style="q">
    <verse number="1-2" style="v" />Kyb'inku'ye' nyole',</para>
  <para style="q">aye'ye' ati kynab'le' ex xnaq'tza'nqeye'.</para>
  <para style="q">
    <verse number="3" style="v" />Nel tnik'ju' ẍkyinb'aj teju' yol,</para>
  <para style="q">kse'n qqul ntna'n tk'ok'jal.</para>
  <para style="q">
    <verse number="4" style="v" />Ikyxtzu'n, qka'yinku' lu b'a'nxi'x,</para>
  <para style="q">qximanku'tzuntz alkye b'a'n toj qwitz.</para>
  <para style="q">
    <verse number="5" style="v" />Ntma'nte Job': Mixti'we' wil,</para>
  <para style="q">atzunte Dyos min ntb'incha'n tnik'alilti'j weye'.</para>
  <para style="q">
    <verse number="6" style="v" />Jun chajyolilte' qama nmaye' ati wile';</para>
  <para style="q">mixti'x nq'anette' nk'ixb'lene', maskye mixti' wile', chij.</para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" />¡Mix-a'lo' juntl kse'n Job'!</para>
  <para style="q">Nxi'x xmayin ti'j Dyos.</para>
  <para style="q">
    <verse number="8" style="v" />Mujli tten kyuk'i'lju' b'inchal myab'a'n,</para>
  <para style="q">nb'et kyuk'i'lju' xjal taq'wix kynab'l.</para>
  <para style="q">
    <verse number="9" style="v" />Ntma'n qa mixti'x ntkanb'a'nju' xjal</para>
  <para style="q">b'a'n ntb'incha'n twitz Dyos.</para>
  <para style="q">
    <verse number="10" style="v" />Aye'tzunkye', xjal ati kynab'le', kyb'intzpeye'.</para>
  <para style="q">¡Lalun kyximaye' qa ate Qman Dyos Nimtipumal,</para>
  <para style="q">nb'inchante taq'wix mujqa mya tnik'alilti'j!</para>
  <para style="q">
    <verse number="11" style="v" />Ntq'o'n tu'me'l t-xel teyile junjun kse'nxju' tb'inchb'aj;</para>
  <para style="q">ntq'o'n tz'e'ysb'il twitz junjun kse'nxu' til.</para>
  <para style="q">
    <verse number="12" style="v" />Axxi'x, min ntb'incha'nte Dyos Nimtipumal,</para>
  <para style="q">taq'wixil ex mya tnik'alilti'j;</para>
  <para style="q">
    <verse number="13" style="v" />Mix-aloqe tk'ama' toklen</para>
  <para style="q">tu'n tkawin tib'aj tkyaqil twitz tx'otx'.</para>
  <para style="q">
    <verse number="14-15" style="v" />Qama tz'el tiq'in</para>
  <para style="q">kyxewju' xjal,</para>
  <para style="q">kykyaqilx che kyimel</para>
  <para style="q">ex che b'elquqix.</para>
  <para style="b" />
  <para style="q">
    <verse number="16" style="v" />Qa ati tnab'la, chin tb'inku'ya;</para>
  <para style="q">b'inqeku'ya nyole'.</para>
  <para style="q">
    <verse number="17" style="v" />Noqwit nel tik'un Dyos tnik'alilti'j, laywitlo b'ant tkawin.</para>
  <para style="q">¿Se'n taq'wi nelnej tyolina ti'ju' tnik'alxi'xti'j?</para>
  <para style="q">
    <verse number="18" style="v" />Qa b'inchal taq'wixqe' nimaqkawil exqe' nimaq kyoklen</para>
  <para style="q">Min nxob' te Dyos tu'n txi' tma'n kyil kyplajku'.</para>
  <para style="q">
    <verse number="19" style="v" />Myatzu' ntq'o'na'tib' kyuk'i'lju' nche kawin,</para>
  <para style="q">ex mya o'kxntb'incha'na' xtalb'il kye q'inun, kyekywitz prow;</para>
  <para style="q">qu'n anate b'inchalkye kykyaqil.</para>
  <para style="q">
    <verse number="20" style="v" />Jun kmujx nche kyima' xjal tk'u'j aq'b'il;</para>
  <para style="q">nche jaw tilj xjal ex nche kub'naj;</para>
  <para style="q">mya kyu'n xjal nche b'aja'ju' nim kyipumal.</para>
  <para style="q">
    <verse number="21" style="v" />Nxb'etzante Dyos tiju' xjal</para>
  <para style="q">ex tojtzqi'n jachaq nb'eta'.</para>
  <para style="q">
    <verse number="22" style="v" />Mixti' jun qlolj qtakunxi'x</para>
  <para style="q">tu'nwt tewit jun b'inchal myab'a'n.</para>
  <para style="q">
    <verse number="23" style="v" />Mixti' jun tq'ijlalil tu'n Dyos teju' xjal</para>
  <para style="q">tu'n tpon twitz tu'n tok toj xjel.</para>
  <para style="q">
    <verse number="24" style="v" />Min nojqelan tu'n tjyet ojtzqib'l</para>
  <para style="q">tu'n kyxitetju' nimaq kyoklen</para>
  <para style="q">ex tu'n txiq'o'n kyoklen te juntl.</para>
  <para style="q">
    <verse number="25" style="v" />Tojtzqi'n Dyos kyb'inchb'en</para>
  <para style="q">nche kub' t-xitu'n te qonik'an.</para>
  <para style="q">
    <verse number="26" style="v" />Nche b'aj tjikyu'n kse'nqe' nimaq kyil,</para>
  <para style="q">kywitz kykyaqil xjal,</para>
  <para style="q">
    <verse number="27" style="v" />qu'n min kyaj tu'n kyb'i'n</para>
  <para style="q">ex min nkyk'mo'nju' nuk'b'il tu'n kyanq'in b'a'n.</para>
  <para style="q">
    <verse number="28" style="v" />Tu'nkypaj pona' kykub'sb'ilju' prow exqe' jtz'o'nqe',</para>
  <para style="q">tk'etz Dyos, ex e'tzaj b'i'n.</para>
  <para style="q">
    <verse number="29" style="v" />Qatzun mixti'te Dyos xtma, ¿alkyetzu'n kq'malte til?,</para>
  <para style="q">Qama txitewa'n twitz ¿alkyetzu'n kyka'yilte?</para>
  <para style="q">Ina' xq'uqinte Dyos kyi'j tnam ex kyi'j xjal</para>
  <para style="q">
    <verse number="30" style="v" />tu'ntzun lalun kawin jun b'inchal myab'a'n ex sb'ul</para>
  <para style="q">tib'aju' tnam.</para>
  <para style="b" />
  <para style="q">
    <verse number="31" style="v" />¿Ma ojetzun txi'tma'na' te Dyos:</para>
  <para style="q">Matxi' chin sb'ete', lay chin b'inchantl ile'.</para>
  <para style="q">
    <verse number="32" style="v" />Yek'untza alkyeqe' npaltile' min nel nik'e' ti'j.</para>
  <para style="q">Qa taq'wix xnb'inchaye', lay nb'inchantle', ma chija?</para>
  <para style="q">
    <verse number="33" style="v" />¿Ma tajb'iltzuna tu'me'l t-xel tu'n Dyos</para>
  <para style="q">kse'nxju' b'a'n toj twitza,</para>
  <para style="q">b'a'ntzun qa matxi' tz'el tik'u'na?</para>
  <para style="q">A na'ta q'malte, myayinwe',</para>
  <para style="q">q'mantza aju' kanli twitza.</para>
  <para style="b" />
  <para style="q">
    <verse number="34" style="v" />Aye' xjal ati kynab'l nche b'in,</para>
  <para style="q">exqe' xjal nkane' toj kywitz, oklo kyma' weye':</para>
  <para style="q">
    <verse number="35" style="v" />Naq nyolinte Job' extzun min kanli twitz;</para>
  <para style="q">mixti'x kytx'o'lajilju' tyol.</para>
  <para style="q">
    <verse number="36" style="v" />¡Ati tu'n txi' xjelit te Job' b'a'nxi'x,</para>
  <para style="q">ikx ttzaq'web'lju' kse'n ttzaq'web'l jun b'inchal myab'a'n!</para>
  <para style="q">
    <verse number="37" style="v" />Mya o'kx aj il te' Job', ex pi's;</para>
  <para style="q">qwitzku' nxmayina' ti'j Dyos</para>
  <para style="q">ex nche jaw wulj tuk'i'l, chechilo, chi Elyu.</para>
  <chapter number="35" style="c" />
  <para style="s1">Toxi'n ttx'olb'ab'l Elyu</para>
  <para style="q">
    <verse number="1-2" style="v" />¿Ma tu'me'ltzulo toj twitza Job', tu'nju' ntma'na</para>
  <para style="q">qa aya tu'n t-xib'i'n tu'n Dyos?</para>
  <para style="q">
    <verse number="3" style="v" />Oje txi' tma'na te Dyos: ¿Titi' toklena ti'j qama chin b'inchan ile'?</para>
  <para style="q">¿Titi'tzun knkanb'a'ye' qa min ẍin b'inchan ile'? chija.</para>
  <para style="q">
    <verse number="4" style="v" />Kxe'l ntzaq'we'n teya</para>
  <para style="q">ex kye tamiwa.</para>
  <para style="q">
    <verse number="5" style="v" />Ka'yinxpe'ya twitz kya'j,</para>
  <para style="q">ex ka'yinxa najchaq ta'te' muj tib'aja.</para>
  <para style="q">
    <verse number="6" style="v" />Qama b'inchan ila, mixti'te' ntb'incha'n te Dyos;</para>
  <para style="q">b'a'ntzun qa nim txqan tila,</para>
  <para style="q">mixti'te' ntb'incha'na te.</para>
  <para style="q">
    <verse number="7" style="v" />Qatzun matb'inchaya b'a'n, mixti'xte nxitq'o'na te;</para>
  <para style="q">ex mixti'te' ntb'incha'n te.</para>
  <para style="q">
    <verse number="8" style="v" />Kyekye xjalju' kse'n aya nk'ixb'sana' il</para>
  <para style="q">mujqa najb'ena'ju' b'a'n ntb'incha'na.</para>
  <para style="b" />
  <para style="q">
    <verse number="9" style="v" />Tjaq'ju' jitz'b'il, nche' ẍch'ina' xjal</para>
  <para style="q">nkyklo'ntzun kyib'tz kyeju' ati kyipumal;</para>
  <para style="q">
    <verse number="10" style="v" />ex min nkyjyo'n Dyos ch'isankye,</para>
  <para style="q">aju' nq'onte ipumalj kyoju' kmuj kuw,</para>
  <para style="q">
    <verse number="11" style="v" />aju' xnaq'tzanqe ex ntzajtq'o'n qnab'l</para>
  <para style="q">kyu'nelju' txkup exqe' pich'.</para>
  <para style="q">
    <verse number="12" style="v" />Nche' ẍch'in, ex min nche tzaj ttzaq'we'n Dyos,</para>
  <para style="q">qu'n taq'wix xjalqe' ex nkynima'n kyib'.</para>
  <para style="q">
    <verse number="13" style="v" />Ate' Dyos, Nimtipumal,</para>
  <para style="q">min nche'x tb'i'nju' chalyol</para>
  <para style="q">
    <verse number="14" style="v" />Expe' ajtmanteya qa b'ajx tila'ya Dyos,</para>
  <para style="q">ayonku'ya, qu'n toj tq'ob' ta' ja'lo.</para>
  <para style="q">
    <verse number="15" style="v" />Intma'na qa min ntzaj ttx'u'jil ex min nttz'e'ysa'n qwitz,</para>
  <para style="q">qa min ntzaj tka'yi'n txqan il, chija.</para>
  <para style="q">
    <verse number="16" style="v" />¡Naq nel tlani'nta tyol Job',</para>
  <para style="q">nim tyola mixti' tnab'l qu'n min nximana ti'j! chi Elyu.</para>
  <chapter number="36" style="c" />
  <para style="s1">Tkyaji'n ttx'olb'ab'l Elyu</para>
  <para style="q">
    <verse number="1-2" style="v" />Tenku' ch'i'n tpasensiya, atzun nchik'b'anx teya,</para>
  <para style="q">qu'n atixwe' nyol b'a'n tu'n nmante ti'j Dyos.</para>
  <para style="q">
    <verse number="3" style="v" />K'ajb'el txqan wojtzqib'le' wu'ne'</para>
  <para style="q">tu'n tyek'et qa tu'me'l tu'n ch'isalweye'.</para>
  <para style="q">
    <verse number="4" style="v" />Axxi'x kxe'l nma'ne' teya, mya chajyolil;</para>
  <para style="q">aju' wa'l twitza jun xjal tz'aqli tnab'l.</para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" />Ate Dyos nimtipumal ex nimxi'x tnab'l,</para>
  <para style="q">ex min neltik'u'nju' mixti' til.</para>
  <para style="q">
    <verse number="6" style="v" />Min nkub' tnajsa'n kyilju' b'inchal il,</para>
  <para style="q">aye'tzu'n prow kye kyilwiju' tu'n;</para>
  <para style="q">
    <verse number="7" style="v" />Kukxtkolinju' kyi'ju' xjal wa'lqe'xi'x;</para>
  <para style="q">nche tkuwsa'n nimaqkawil toj kyq'uqlil,</para>
  <para style="q">ex nche ten tu'n toj nimaq kyoklen.</para>
  <para style="q">
    <verse number="8" style="v" />Qatzun k'lo'nqe' toj xpatx'k'uxb'il</para>
  <para style="q">ex nche' yajlanjtz tu'n k'ixk'oj,</para>
  <para style="q">
    <verse number="9" style="v" />nxityek'u'nte Dyos kyil kye b'aj kyb'incha'n</para>
  <para style="q">ex se'n xa'kyq'o'nkyib' toju' nimjtib'il.</para>
  <para style="q">
    <verse number="10" style="v" />Nyolin kye tu'n kytzak'et</para>
  <para style="q">ex tu'n tkyaj kytzaqpi'n myab'a'n.</para>
  <para style="q">
    <verse number="11" style="v" />Qama txi'kyb'i'n ex nche ajb'en te,</para>
  <para style="q">nche ten toj tzalajb'il</para>
  <para style="q">toj tkyaqilju' jni'tl kychwinqlal.</para>
  <para style="q">
    <verse number="12" style="v" />Qatzun min nkub' kyb'i'n,</para>
  <para style="q">nche kyim ex nche'x toj muqb'il</para>
  <para style="q">na'mxtoqpe' telkynik' ti'j.</para>
  <para style="q">
    <verse number="13" style="v" />Ntzaj kytx'u'jilju' min nche okslan te Dyos,</para>
  <para style="q">maskyepe' jpu'nqe'kx min nkyqani'n o'nb'il.</para>
  <para style="q">
    <verse number="14" style="v" />Nche kyim toj kyku'xumal,</para>
  <para style="q">ex ch'ixb'ajilx npona' b'aju' kychwinqlal.</para>
  <para style="q">
    <verse number="15" style="v" />Intklo'nte Dyos nyajti, toju' yajb'il;</para>
  <para style="q">ex tu'nelju' k'ixk'oj noka' tnab'l.</para>
  <para style="q">
    <verse number="16" style="v" />Ex ikxta makleta tu'n toju' xob'ajil,</para>
  <para style="q">ex nimxi'x tzaqpib'l txitq'o'n teya;</para>
  <para style="q">matnojsa twi' tmesa tu'n wab'j tk'ok'jalxi'x.</para>
  <para style="q">
    <verse number="17" style="v" />Ti'ja njapuna' b'aj til b'inchal myab'a'n,</para>
  <para style="q">ex lay b'ent tmyet tu'n toka toj jitz'b'il.</para>
  <para style="q">
    <verse number="18" style="v" />Ka'yinxa tu'n lalun b'lona</para>
  <para style="q">tu'n lalun kub'twitza tu'n txqan pwaq.</para>
  <para style="q">
    <verse number="19" style="v" />Lay tz'ajb'en toklena exqa nẍch'ina</para>
  <para style="q">toju' t-uxi'na ex toq'ela.</para>
  <para style="q">
    <verse number="20" style="v" />Lalun pon tk'u'ja ti'ju' qonik'an,</para>
  <para style="q">ajkykub'naju' tnam.</para>
  <para style="q">
    <verse number="21" style="v" />Ka'yinxa tu'n lalun tz'anjtl ti'ja toj il,</para>
  <para style="q">aya matxi' tzik'twitza toj yajb'il.</para>
  <para style="b" />
  <para style="q">
    <verse number="22" style="v" />Tz'elku' tnik'a ti'ju' tipumal Dyos.</para>
  <para style="q">Mixti' jun xnaq'tzal ikyju' kse'nte</para>
  <para style="q">
    <verse number="23" style="v" />Mix-a'lo' tu'n txiq'mante te ti'ti' ktb'incha',</para>
  <para style="q">ex mix-a'lo' tu'n txi' q'mante</para>
  <para style="q">qa taq'wixju' xtb'incha.</para>
  <para style="q">
    <verse number="24" style="v" />Kykyaqil xjal twitz tx'otx' nche' tzalaj kyi'ju' taq'unb'en,</para>
  <para style="q">ex ikxta tzalajxa kyi'j.</para>
  <para style="q">
    <verse number="25" style="v" />Kykyaqil xjal b'a'n kyka'yinte</para>
  <para style="q">b'a'ntzun qa najchaq ta'.</para>
  <para style="q">
    <verse number="26" style="v" />Nimxi'xte' Dyos, layx b'ent telqnik' te;</para>
  <para style="q">ex lay b'ent qojlante tab'q'i.</para>
  <para style="q">
    <verse number="27" style="v" />Njaw tiq'in a' toj jun tk'b'el toj txati'n,</para>
  <para style="q">ex njaw tmeltz'u'n te jb'al.</para>
  <para style="q">
    <verse number="28" style="v" />Toj muj netza' chitju' jb'al</para>
  <para style="q">ex nkub' ten txqan a' twitz tx'otx'.</para>
  <para style="q">
    <verse number="29" style="v" />¿Alkye neltnik' ti'j, titiqu'n nb'eta' muj,</para>
  <para style="q">ex titiqu'n nche q'ajta' q'a'nkyaq twitz kya'j?</para>
  <para style="q">
    <verse number="30" style="v" />Nxi' t-slik'u'nte Dyos xloq'lokya'j tib'aj ninnjab',</para>
  <para style="q">ex nkyej tewa'n t-xeju' ttxuylal a'.</para>
  <para style="q">
    <verse number="31" style="v" />Ikytzu'n nche tk'a'chana' tnam</para>
  <para style="q">ex ntzaj tq'o'n kywa nimxi'x.</para>
  <para style="q">
    <verse number="32" style="v" />Nkub' ttzyu'n q'ankyaq kyoj tq'ob',</para>
  <para style="q">ex majx npon, janxa' tma'na'.</para>
  <para style="q">
    <verse number="33" style="v" />Intma'n tpakb'alil Dyos ajtjulin jb'al,</para>
  <para style="q">atzu'n q'ankyaq ntma'nju' ttx'u'jil.</para>
  <chapter number="37" style="c" />
  <para style="q">
    <verse number="1" style="v" />Aj wlonteye' q'ankyaq, majx nlu'lun wanmiye'</para>
  <para style="q">naku'j kjawitz oq.</para>
  <para style="q">
    <verse number="2" style="v" />Kyb'inxju'ye' tq'ojq'ojel twi' Dyos,</para>
  <para style="q">aju' q'ankyaq netz toj ttzi.</para>
  <para style="q">
    <verse number="3" style="v" />Ntzaj t-xon xloq'lokya'j twitz kya'j</para>
  <para style="q">ex toj jun ttxa'n tx'otx' tu'n tpon toj jun plajtl.</para>
  <para style="q">
    <verse number="4" style="v" />Ex nb'injtz jun tq'ojq'ojel,</para>
  <para style="q">ajtq'ajti toj twi' nimxi'x toklen;</para>
  <para style="q">akx nb'iyitju' tq'ojq'ojel</para>
  <para style="q">min nche qjenju' xloq'lokya'j.</para>
  <para style="q">
    <verse number="5" style="v" />Ajtyolinte Dyos,</para>
  <para style="q">nb'ant txqan ti'xti' te lab'te'n tu'n;</para>
  <para style="q">nb'ant txqan ti'xti' tu'n, mix-a'lo'x jun nkane toj twitz.</para>
  <para style="q">
    <verse number="6" style="v" />Nxitma'n te txun che'w tu'n tkub' tib'aj tx'otx'</para>
  <para style="q">ex nkub' jb'al kuw tu'n.</para>
  <para style="q">
    <verse number="7" style="v" />Tu'n nche kyeja' ten xjal toj kyja,</para>
  <para style="q">tu'n telkynik' kykyaqil qa a te nb'inchante.</para>
  <para style="q">
    <verse number="8" style="v" />Nche okxju' txkup toj kyjul,</para>
  <para style="q">ex axtzu' nche kyaja' ewin.</para>
  <para style="q">
    <verse number="9" style="v" />Toj tnayajkya'j ntzaja'te' kyq'iq' jb'al,</para>
  <para style="q">ex toj tb'a'nq'ob'kya'j ntzaja' che'w.</para>
  <para style="q">
    <verse number="10" style="v" />Nkub' tx'e'jixu' che'w tu'n t-xew Dyos</para>
  <para style="q">ex inxi' tx'e'jixju' tnimal a' tu'n.</para>
  <para style="q">
    <verse number="11" style="v" />Tu'nte nẍb'ub'jixa' muj,</para>
  <para style="q">ex toj muj ntzaja' xloq'lokya'j tu'n;</para>
  <para style="q">
    <verse number="12" style="v" />nt-xkuyi'n tib'u' xloq'lokya'j twitz kya'j,</para>
  <para style="q">ikytzu'n ntb'incha'na' tchaq'b'il Dyos</para>
  <para style="q">toj tkyaqil twitz tx'otx'.</para>
  <para style="q">
    <verse number="13" style="v" />Tkyaqiltzun ja'lu najb'en tu'n Dyos</para>
  <para style="q">tu'n ttz'e'yset twitzju' tx'otx'</para>
  <para style="q">mujqa tu'n tye'k'unte tk'u'jlalil.</para>
  <para style="b" />
  <para style="q">
    <verse number="14" style="v" />Tenku' tpasensiya Job' ex b'inku'ya,</para>
  <para style="q">ximana kyi'ju' ti'xti' tb'anilqe' nche tb'incha'n Dyos.</para>
  <para style="q">
    <verse number="15" style="v" />¿Ma b'i'n tu'na se'n ntb'incha'n Dyos tkyaqil ja'lu,</para>
  <para style="q">ex se'n taq'wi njaw qoptz'aju' xloq'lokya'j toj muj tu'n?</para>
  <para style="q">
    <verse number="16" style="v" />¿B'i'ntzun tu'na se'n nb'eta' muj toj kyq'iq',</para>
  <para style="q">qa atzu' nela' tnik'tzilju' tnab'l Dyos tz'aqlixi'x?</para>
  <para style="q">
    <verse number="17" style="v" />In na'n kyeqa toju' ti'ja</para>
  <para style="q">ajtnak'eju' kyq'iq' ntzaj toj tnayajkya'j twitz tx'otx'.</para>
  <para style="q">
    <verse number="18" style="v" />¿Makb'entil tonina ti'j Dyos tu'n t-slik'etju' kya'j</para>
  <para style="q">ex tu'n tkyaj kuw kse'n jun plaj k'uxb'il?</para>
  <para style="q">
    <verse number="19" style="v" />Ye'k'untza qeye' titi' b'a'n tu'n txi' qma'ne' te Dyos,</para>
  <para style="q">qu'n sjumj ta'qo' ex mixti' tu'me'lju' qyol.</para>
  <para style="q">
    <verse number="20" style="v" />Laype' txi' nma'nwe' qa wajb'ile' tu'n nyoline',</para>
  <para style="q">qu'n nakuloj wajb'ile' tu'n nkyime'.</para>
  <para style="b" />
  <para style="q">
    <verse number="21" style="v" />Lay b'ent qka'yinte t-spik'umal q'ij</para>
  <para style="q">kse'n qa jupli muj;</para>
  <para style="q">qatzun matzaj kyq'iq', kspik'eb'il twitz kya'j.</para>
  <para style="q">
    <verse number="22" style="v" />Ntzaj qoptz'aj jun tb'anil spik'un toj tb'a'nq'ob'kya'j,</para>
  <para style="q">ajtnoj ti'jile Dyos tu'n tajwalil xjan.</para>
  <para style="q">
    <verse number="23" style="v" />Lay kaneju' nimtipumal toj qwitz,</para>
  <para style="q">qu'n kuwxi'xte' ex tnik'alxi'xti'j;</para>
  <para style="q">tzinunxi'x ti'j ex min nkub' tjtz'o'n jun xjal.</para>
  <para style="q">
    <verse number="24" style="v" />Qu'mtzun nche' xob'ju' xjal te;</para>
  <para style="q">mixti' nche oka' nimaq kynab'l te, chi Elyu.</para>
  <chapter number="38" style="c" />
  <para style="s1">Ok Job' toj xjel tu'n Dyos</para>
  <para style="q">
    <verse number="1" style="v" />Tzajtzun yolin Qman Dyos te Job' tojxi'xtej q'ankyaq.</para>
  <para style="sp">Qman Dyos</para>
  <para style="q">
    <verse number="2" style="v" />¿Alkyetzuna tu'nju' min nxitoksla'na nxime',</para>
  <para style="q">extzun ntyek'u'na tu'n tyola qa min tojtzqi'na?</para>
  <para style="q">
    <verse number="3" style="v" />Yek'untztzuna tkuwala ja'lo,</para>
  <para style="q">ex tzaq'we'nqe'tza nxjele' lu:</para>
  <para style="q">
    <verse number="4" style="v" />¿Jatzun toqta tej tkub' nq'o'ne' tq'uqb'il tx'otx'?</para>
  <para style="q">¡Q'mantza weye', qa ax atixi'x txqan tojtzqib'la!</para>
  <para style="q">
    <verse number="5" style="v" />¿B'i'ntzun tu'na alkye q'mante jni' echb'ente,</para>
  <para style="q">ex alkyeju' b'inchante?</para>
  <para style="q">
    <verse number="6" style="v" />¿Ti'ti' tku'x tjaq'ju' tq'uqlil?</para>
  <para style="q">¿Alkye ku'x q'onteju' nin ab'j te tkuwal,</para>
  <para style="q">
    <verse number="7" style="v" />akxtoq nkymujtza'n che'wju' b'itz ajttzaj t-xe kya'j</para>
  <para style="q">toj kytzalajb'ilju' ajb'el weye' toj kya'j?</para>
  <para style="b" />
  <para style="q">
    <verse number="8" style="v" />Tej tetzb'entju' ninnjab' toj tk'u'j tx'otx',</para>
  <para style="q">¿alkye kub' q'onte tjpel tu'n tq'e'tj?</para>
  <para style="q">
    <verse number="9" style="v" />Xinq'o'ne' muj te t-xb'alun</para>
  <para style="q">ex kub' nb'altz'i'ne' toj jupli muj.</para>
  <para style="q">
    <verse number="10" style="v" />Kub' nq'o'ne' tnaqachil ninnjab'</para>
  <para style="q">ex kyej wik'sa'ne' talju' tjpel.</para>
  <para style="q">
    <verse number="11" style="v" />Xinma'ne' te: Axtzuntzu' kpomela'ya tzalu,</para>
  <para style="q">ex axtzuntzu' kjela'tena;</para>
  <para style="q">atzu' che b'ajela' poq'ju' ttolob'a nim kyipumal tzalu.</para>
  <para style="q">
    <verse number="12" style="v" />¿Ma oje tchaq'xi' jumaja toj tchwinqlala</para>
  <para style="q">tu'n ttzaj t-xe kya'j ex tu'n qsqix,</para>
  <para style="q">
    <verse number="13" style="v" />tu'n tpon b'aj spik'un toj tkyaqil twitz tx'otx'</para>
  <para style="q">ex tu'n kyxi' b'inchal myab'a'n ewil?</para>
  <para style="q">
    <verse number="14" style="v" />Kq'ancha'lixeltzun twitz tx'otx'tz</para>
  <para style="q">majx nẍtile' naku'j jun xb'alun;</para>
  <para style="q">
    <verse number="15" style="v" />nkub' t-xk'ayu'n Dyos spik'un kye b'inchal myab'a'n</para>
  <para style="q">ex kb'ajel ttxa'n tu'n kyxob'san.</para>
  <para style="b" />
  <para style="q">
    <verse number="16" style="v" />¿Ma oje pona tzmax t-xexi' ninnjab'</para>
  <para style="q">jata' t-xiklil ttxuylal a'?</para>
  <para style="q">
    <verse number="17" style="v" />¿Ma oje tila jata' kyokex xjal</para>
  <para style="q">toju' tkawb'il kamik xob'ajilx?</para>
  <para style="q">
    <verse number="18" style="v" />¿Ma nel tnik'a ti'j jni'ju' twitz tx'otx'?</para>
  <para style="q">¡Q'mantza weye' qa ax b'i'n tu'na tkyaqil!</para>
  <para style="b" />
  <para style="q">
    <verse number="19" style="v" />¿Jatzun tu'me'l</para>
  <para style="q">k'u'nqe'ya' spik'un exju' qxopin?</para>
  <para style="q">
    <verse number="20" style="v" />¿Manb'ent tu'na tu'n kypon tzmax mankb'il twitz tx'otx',</para>
  <para style="q">ex tu'n tanjtzkyi'j tojxu' kynajb'il?</para>
  <para style="q">
    <verse number="21" style="v" />¡B'i'nlo tu'na, qu'n matxina tzaj twinqila</para>
  <para style="q">qu'n ojetoqnalo tz'itz'ji'ya!</para>
  <para style="b" />
  <para style="q">
    <verse number="22" style="v" />¿Ma oje pona ka'yilte</para>
  <para style="q">jak'u'maqe' txun che'w ex saqb'aqun</para>
  <para style="q">
    <verse number="23" style="v" />tu'n kyxiq'et toj tq'ijlalil k'ulb'a'n,</para>
  <para style="q">ex toj tq'ijlalil q'oj?</para>
  <para style="q">
    <verse number="24" style="v" />¿Alkye b'e nxa' spik'un ajt-ximlen?</para>
  <para style="q">¿Se'n nxa' mlenju' kyq'iq' ntzaj tjawetzq'ij toj tkyaqil twitz tx'otx'?</para>
  <para style="q">
    <verse number="25" style="v" />¿Alkye njqonte tb'eyilju' jb'al</para>
  <para style="q">ex alkye yek'ulte tb'e q'ankyaq ex kyq'iq' jb'al,</para>
  <para style="q">
    <verse number="26" style="v" />tu'ntzun tkub' jb'al toj chq'ajlaj</para>
  <para style="q">jamix-a'lo' xjal najli,</para>
  <para style="q">
    <verse number="27" style="v" />Tu'ntzu'n ta'k'ju' tzqij tx'otx'</para>
  <para style="q">ex tu'n ttzaj puqli k'ul toj?</para>
  <para style="b" />
  <para style="q">
    <verse number="28" style="v" />¿Alkyetzu'n kymanju' jb'al ex ta'l che'w?</para>
  <para style="q">
    <verse number="29" style="v" />¿Ex alkye kytxuju' tx'e'jche'w exju' txu'nche'w?</para>
  <para style="q">
    <verse number="30" style="v" />¿Alkye ntx'e'jsante a' kse'n ab'j</para>
  <para style="q">ex nkub' ch'uxixju' ttziyile ttxuylal a' tu'n?</para>
  <para style="b" />
  <para style="q">
    <verse number="31" style="v" />¿Ma aya nok mujb'ankye che'w wotz</para>
  <para style="q">ex nel pa'nkye txqantl che'w q'inb'il kyb'i?</para>
  <para style="q">
    <verse number="32" style="v" />¿Ma tu'na njawula' ninche'w te prim?</para>
  <para style="q">¿Ma aya nk'ulkye ninche'w ex b'o's che'w nakuj txkup oso?</para>
  <para style="q">
    <verse number="33" style="v" />¿Ma tojtzqi'nqe'ya kawb'il nche kawinte kya'j?</para>
  <para style="q">¿Ma aya nkub' q'onkye kawb'il lu tu'n kyb'inchet twitz tx'otx'?</para>
  <para style="q">
    <verse number="34" style="v" />¿Ma jaku' b'ant tchq'onteju'ya muj</para>
  <para style="q">tu'n tq'o'n txqan jb'al tib'aja?</para>
  <para style="q">
    <verse number="35" style="v" />Qama tchaq'a te xloq'lokya'j tu'n txi' toj jun plaj,</para>
  <para style="q">¿Ma jaku'tzun tzaj tma'n teya. Luqine', chin tchq'onxa, machi?</para>
  <para style="q">
    <verse number="36" style="v" />¿Alkye kyej q'onte</para>
  <para style="q">tu'n kyel k'atzu' pich' ex tmanek'?</para>
  <para style="q">
    <verse number="37" style="v" />¿Alkye jun atixi'x tnab'l b'in tu'n jni' muj ati?</para>
  <para style="q">¿Alkye b'a'n ttzaj qonte jb'al,</para>
  <para style="q">
    <verse number="38" style="v" />Tu'ntzun tjaw b'entju' quq te q'antx'otx'</para>
  <para style="q">ex tu'n kytzyunte kyib'ju' waka'j tx'otx'?</para>
  <para style="b" />
  <para style="q">
    <verse number="39" style="v" />¿Ma aya ntzaj jyonte kychi' ttxu b'alun,</para>
  <para style="q">tu'ntzun kywanju' kyal tzmaxi' ajkynoj,</para>
  <para style="q">
    <verse number="40" style="v" />Aj kyokx ewal toj kyjul</para>
  <para style="q">mujqa ajkyxi' jutzeb'il ti'j kychi' toj k'ul?</para>
  <para style="q">
    <verse number="41" style="v" />¿Alkye nxi' q'onte kywa joj,</para>
  <para style="q">ajkyxi'ju' kyal jyol kywa</para>
  <para style="q">ex noq nche ch'iwj aj ttzaj kyqani'n kywa?</para>
  <chapter number="39" style="c" />
  <para style="q">
    <verse number="1" style="v" />¿Ma b'i'n tu'na jtoj tu'n kyalan tojk'ul chib'?</para>
  <para style="q">¿Ma oje tila ajtalanju' ttxu msat?</para>
  <para style="q">
    <verse number="2" style="v" />¿Ma b'i'n tu'na toj jte' xjaw</para>
  <para style="q">nche' alina'?</para>
  <para style="q">
    <verse number="3" style="v" />Ajkyalan nkub' kyk'oyi'n kyib',</para>
  <para style="q">nnitz'jtzun kyaltz.</para>
  <para style="q">
    <verse number="4" style="v" />Nche kuwixtzuntz, ex ch'iy toj kojb'il,</para>
  <para style="q">ex nche'xtzuntz ex mixjun nanjtztl kyi'j.</para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" />¿Alkye xi'tzaqpinte tojk'ul b'ur?</para>
  <para style="q">¿Alkye xi'tzaqpinte tu'n tb'et?</para>
  <para style="q">
    <verse number="6" style="v" />Ayine' nxi' yek'unte, jatu'n tanq'ina,</para>
  <para style="q">toj chq'ajlaj kyoj plan tx'otx' min ntzaj kyawal.</para>
  <para style="q">
    <verse number="7" style="v" />Min nkub'u' q'ajte'n toj nintnam toj twitz,</para>
  <para style="q">ex min ntb'i'n ajt-ẍch'inju' ajchejil.</para>
  <para style="q">
    <verse number="8" style="v" />Nb'et ttxa'nile witz jyol twa,</para>
  <para style="q">njyon ti'j cha'x k'ul te twa.</para>
  <para style="b" />
  <para style="q">
    <verse number="9" style="v" />¿Ma oktzun k'ajb'elu' tojk'ul tman wakx teya toj twitza</para>
  <para style="q">exqa kyejten jun qonik'an toj tja twakyixa?</para>
  <para style="q">
    <verse number="10" style="v" />¿Ma kb'entel tk'let tu'na ti'j yuw tu'n tkjon,</para>
  <para style="q">mujqa kxe'l lpe ti'ja txijil tx'otx' toj kojb'il?</para>
  <para style="q">
    <verse number="11" style="v" />¿Ma kqeb'il tk'u'ja ti'j, tu'nju' kuwxi'x,</para>
  <para style="q">exqa kb'entel taq'una tu'n?</para>
  <para style="q">
    <verse number="12" style="v" />¿Ma oktzun k'ajb'el tu'n tb'uyetju' twitz tawala toj twitza</para>
  <para style="q">ex tu'n tb'uyitu' twitz ttriya toj er?</para>
  <para style="b" />
  <para style="q">
    <verse number="13" style="v" />Matilju'ya pich' ab'estrus tb'i:</para>
  <para style="q">ntzalaj nlipan tk'i' t-xik',</para>
  <para style="q">naku'j kse'n t-xik' pich' siwenya,</para>
  <para style="q">
    <verse number="14" style="v" />nche kyej tq'o'n tjos toj tz'awun</para>
  <para style="q">tu'n kymoq'ti tu'n ttantonil q'ij.</para>
  <para style="q">
    <verse number="15" style="v" />Min nximan ti'j qaj xkub' txeq'j toj tqan,</para>
  <para style="q">ex qaj xkub' twab'e'n jun txkup.</para>
  <para style="q">
    <verse number="16" style="v" />Txkup kyeju' tal, nakuj mya talqe',</para>
  <para style="q">min nximan qa naq nkub'naju' taq'un.</para>
  <para style="q">
    <verse number="17" style="v" />Min xi'nq'o'nwe' tnab'l;</para>
  <para style="q">ex min xinq'o'ne' te tu'n telk'atz.</para>
  <para style="q">
    <verse number="18" style="v" />Ajtzun tjawe' nxi' ojqel,</para>
  <para style="q">naq ntze'n kyi'j chej ex kyi'j aj chejil.</para>
  <para style="b" />
  <para style="q">
    <verse number="19" style="v" />¿Ma atzuna xiq'onte tipumal chej,</para>
  <para style="q">ma aya xiq'o'nteju' twi' txayli ti'j tqul?</para>
  <para style="q">
    <verse number="20" style="v" />¿Ma tu'na nlipana' kse'n jun ẍt'ikt'u'l,</para>
  <para style="q">xob'ajilx ajtaq'wi xopil?</para>
  <para style="q">
    <verse number="21" style="v" />Nlukun toju' plan tx'otx',</para>
  <para style="q">ex min nxob' ajt-xi' toj q'oj.</para>
  <para style="q">
    <verse number="22" style="v" />Ntze'n ti'ju' xob'ajil min njaw sak'puj,</para>
  <para style="q">ex min njawxob' teju' k'uẍtx'e'nb'il,</para>
  <para style="q">
    <verse number="23" style="v" />Maskye nq'ajtiju' tkb'el talsmaj tu'n aj chejil</para>
  <para style="q">maskye nel spoqj q'aq' ti'j ch'ut ex ti'j k'ok'e' ch'ut.</para>
  <para style="q">
    <verse number="24" style="v" />Tuk'i'l ttx'u'jil nkub'a'ti'ju' b'e tu'n;</para>
  <para style="q">layx myet ajtq'ajti chun.</para>
  <para style="q">
    <verse number="25" style="v" />Tu'n tjiq'cha'n nttzaq'we'na' tq'ojq'ojel chun;</para>
  <para style="q">najchaq nt-sqo'na' q'oj</para>
  <para style="q">ex ntb'i'n tq'ojq'ojel wi'yj te chaq'b'il exqe' xjal nche ẍch'in.</para>
  <para style="b" />
  <para style="q">
    <verse number="26" style="v" />¿Ma nimtzun tnab'la tu'n t-xnaq'tzanteya q'anjel tu'n tlipan,</para>
  <para style="q">ex tu'nt-xi' nlipan toj tnayajkya'j?</para>
  <para style="q">
    <verse number="27" style="v" />¿Ma aya chaq'un teju' t'iw</para>
  <para style="q">tu'n tkub' tq'o'n tpaqb'il jawlxi'x?</para>
  <para style="q">
    <verse number="28" style="v" />Najlite' t'iw toj pik q'ijtl ex qonik'an,</para>
  <para style="q">nkub' tb'incha'n tja twi'xi' pik.</para>
  <para style="q">
    <verse number="29" style="v" />Tzmaxtzuntz nka'yintza'</para>
  <para style="q">ex nk'utzin ti'j tchi'.</para>
  <para style="q">
    <verse number="30" style="v" />Chik' kywaju' tal,</para>
  <para style="q">axtzuntzu' ta'qe' ja ta'qe' kyimni txkup.</para>
  <chapter number="40" style="c" />
  <para style="q">
    <verse number="1-2" style="v" />Aya, tajb'iltoqa tu'n wok tq'o'na toj xjel</para>
  <para style="q">ayine' Dyos, Nimwipumale',</para>
  <para style="q">¿ma ilxi'xti'j tu'na tu'n ttzaq'wena? chi Dyos.</para>
  <para style="sp">Job'</para>
  <para style="q">
    <verse number="3-4" style="v" />¿Titi'we' kxe'l ntzaq'we'n, extzun naqch'i'n woklene'?</para>
  <para style="q">Alote b'a'n tu'n nkub' numeye'.</para>
  <para style="q">
    <verse number="5" style="v" />Matxi' chin yolin b'a'npun maje',</para>
  <para style="q">ex mixti'tlwe' nyol, chi Job'.</para>
  <para style="s1">Okjumajtl Job' toj xjel tu'n Dyos</para>
  <para style="q">
    <verse number="6" style="v" />Yolin jumajtl Dyos tuk'i'l Job'</para>
  <para style="q">tojxi'x txqan q'ankyaq.</para>
  <para style="sp">Qman Dyos</para>
  <para style="q">
    <verse number="7" style="v" />Ye'k'untza tipumala ja'lo,</para>
  <para style="q">ex tzaq'we'nqe'tza xjel lu:</para>
  <para style="q">
    <verse number="8" style="v" />¿Tajb'ila tu'n tmanteya qa mya tnik'alwi'je' exqa ati wile',</para>
  <para style="q">tu'nwtzunlo toka mixti' tila?</para>
  <para style="q">
    <verse number="9" style="v" />¿Ma kuwxi'xtzuna kse'nwe'?</para>
  <para style="q">¿Ma aju' tq'ojq'ojel toj twi'ya kuw kse'nwe'?</para>
  <para style="q">
    <verse number="10" style="v" />Qonknatzun ti'ja tb'anilxi'x toj tajwalila,</para>
  <para style="q">ktxunk ti'ja te ajwalb'il nqoptz'aj.</para>
  <para style="q">
    <verse number="11" style="v" />Ka'yinqe'xa kkyaqilju' njaw kynima'n kyib':</para>
  <para style="q">tzaqpintzju'ya ttx'ujila ex me'ssa'nqe'ku'ya.</para>
  <para style="q">
    <verse number="12" style="v" />Iku', xitunqe'ku'ya tu'n twitza,</para>
  <para style="q">b'ajsanqeku'ya b'inchal myab'a'n ja ta'qe'.</para>
  <para style="q">
    <verse number="13" style="v" />Mqunqe'ku'xa kykyaqil toj tx'otx',</para>
  <para style="q">jpunqe'kxa kyxol kyimni.</para>
  <para style="q">
    <verse number="14" style="v" />K'elel nnik'tze',</para>
  <para style="q">qa tu'nju' tkuwala kub'a' ti'j tu'na.</para>
  <para style="q">
    <verse number="15" style="v" />Luju' nin txkup B'eemot, nch'isaje' kse'nx aya;</para>
  <para style="q">nwan k'ul kse'nkye wakx;</para>
  <para style="q">
    <verse number="16" style="v" />Ka'yinxpe'ya ti'j tqul kuwxi'x,</para>
  <para style="q">exju' tchib'jil majx kuwqe'.</para>
  <para style="q">
    <verse number="17" style="v" />Exju' tje kuwxi'x kse'n k'ute,</para>
  <para style="q">exqe' tb'o'tx'il tqan naku'j xmonqe'.</para>
  <para style="q">
    <verse number="18" style="v" />Aye'ju' tb'aqil naku'j tub'qe' q'ank'uxb'il,</para>
  <para style="q">naku'j tqan k'uxb'il.</para>
  <para style="q">
    <verse number="19" style="v" />Aju' waq'unb'ene' tb'anil b'inchb'ente;</para>
  <para style="q">naq o'kx ayine' b'inchalte b'a'n tkub' nxitine'.</para>
  <para style="q">
    <verse number="20" style="v" />Kwi' witz janche b'aja' ẍchan txkup,</para>
  <para style="q">intzaj iq'ina' k'ul tu'n twan.</para>
  <para style="q">
    <verse number="21" style="v" />Inkub' paqe tjaq'ju' k'ul loto,</para>
  <para style="q">inxi' ewil kxol ptz'an toj sob'on.</para>
  <para style="q">
    <verse number="22" style="v" />Aju' k'ul loto najb'en te t-xleku'n,</para>
  <para style="q">aye'tzunju' chjaj ate' ttzi a' ti'jele.</para>
  <para style="q">
    <verse number="23" style="v" />Qama ch'iyju' nin a' minti' nxob';</para>
  <para style="q">maskye ma japun a' tjaq' ttzi,</para>
  <para style="q">minxi' toj twinqil.</para>
  <para style="q">
    <verse number="24" style="v" />¿Alkyetzu'n ktq'a'tib' tu'n ttzyunte ex tu'n kyetz tiq'i'n twitz,</para>
  <para style="q">mujqa tu'n tex tq'o'n jun aqwil toj ttxa'n?</para>
  <chapter number="41" style="c" />
  <para style="q">
    <verse number="1" style="v" />Tzun Leb'yatan, ¿ma ktzyetil tu'na tu'n jun tzuyb'il kyiẍ?</para>
  <para style="q">¿Oktzun kb'entel t-ẍpetu' taq' tu'na tu'n jun ky'jaj?</para>
  <para style="q">
    <verse number="2" style="v" />¿Ma kk'elix jun ky'jaj tu'na toj ttxa'n</para>
  <para style="q">mujqa tu'n tokx jun ch'ok k'uxb'il toj ttxa'n?</para>
  <para style="q">
    <verse number="3" style="v" />¿Ma oktzun kub'sal teya tu'n ttzaj laqj tk'u'ja ti'j,</para>
  <para style="q">ex tu'n tkub'san teya tuk'i'l che'w yol?</para>
  <para style="q">
    <verse number="4" style="v" />¿Ma jaku' b'ent tu'na tu'n tmante</para>
  <para style="q">tu'n tok te loq'aj tmajina toj tkyaqilju' tchiwnqlal?</para>
  <para style="q">
    <verse number="5" style="v" />¿Ma jaku' ẍchana tuk'i'l kse'n tuk'i'l jun pich'?</para>
  <para style="q">¿Ma kb'el tk'lona kse'n jun t-saqchb'il tk'wala?</para>
  <para style="q">
    <verse number="6" style="v" />¿Ma ktzunlo che xjelib'tele' toj k'wik?</para>
  <para style="q">¿Ma oklo kb'ajel kypuẍi'ne' tu'n txi' k'ayit?</para>
  <para style="q">
    <verse number="7" style="v" />¿Ma oklo k'elixju' tal t-smaja toju' ttz'umil,</para>
  <para style="q">mo aju' twi' tu'n tch'uta?</para>
  <para style="q">
    <verse number="8" style="v" />Qama tzaq'pon tq'ob'a ti'j</para>
  <para style="q">kq'ojil ti'ja aj layx tzik'tna'l tu'na,</para>
  <para style="q">ex lay tb'incha jun majtla.</para>
  <para style="q">
    <verse number="9" style="v" />Naqpena' qama kyilju' Leb'yatan,</para>
  <para style="q">alchaqxkyeku' kb'el tz'aq tu'n t-xob'il.</para>
  <para style="q">
    <verse number="10" style="v" />Qa a'lo' jun sok yekunte, intzaj ttx'u'jil;</para>
  <para style="q">mix-a'lo' nkub'sante ti'j.</para>
  <para style="q">
    <verse number="11" style="v" />¿Alkye matz'okx yekunte, ma oklo k'eletz toj b'anil?</para>
  <para style="q">¡Mixti'x jun toj tkyaqil twitz tx'otx'!</para>
  <para style="q">
    <verse number="12" style="v" />Layx qjen tu'n nyoline' tqan</para>
  <para style="q">exju' tipumal nimxi'x.</para>
  <para style="q">
    <verse number="13" style="v" />¿Alkye k'elil q'inteju' ttz'umal ktxub'lte,</para>
  <para style="q">mujqa tu'n tjlajinte ttxk'owil pin?</para>
  <para style="q">
    <verse number="14" style="v" />¿Alkye kb'entel tjqonte toj ttzi,</para>
  <para style="q">tuk'i'lju' txqan twitzte txoli'n kyten xob'ajilqe'x?</para>
  <para style="q">
    <verse number="15" style="v" />Txoli'n tten ti'j tqul jpu'nile te kolb'il</para>
  <para style="q">ex majx kuwqe' kse'n ab'j.</para>
  <para style="q">
    <verse number="16" style="v" />Mujb'a'nkyib' b'a'nxi'x jun tuk'i'l juntl,</para>
  <para style="q">laype' b'ant tokx kyq'iq' kxol.</para>
  <para style="q">
    <verse number="17" style="v" />Mujb'a'nk kyib' b'a'nxi'x ex tzyu'mile kyib',</para>
  <para style="q">mix-a'lo' b'a'ntel pa'nkye.</para>
  <para style="q">
    <verse number="18" style="v" />Aju' t-kẍam naku'j xloq'lokya'j;</para>
  <para style="q">inche qoptz'aju' twitz kse'n q'ij ajqsqix.</para>
  <para style="q">
    <verse number="19" style="v" />Inetz tqan q'aq' toj ttzi</para>
  <para style="q">ex netz tx'itj q'aq' toj.</para>
  <para style="q">
    <verse number="20" style="v" />Inetz txqan sib' toj ttxa'n,</para>
  <para style="q">kse'n jun k'wil nloqlon toj q'aq'.</para>
  <para style="q">
    <verse number="21" style="v" />Aju' t-xew njaw k'antju' ttxalq'aq' tu'n,</para>
  <para style="q">ex netz tqan taq' q'aq' toj ttzi.</para>
  <para style="q">
    <verse number="22" style="v" />Aju' tqul kuwxi'x</para>
  <para style="q">kykyaqilx nche' xob' te.</para>
  <para style="q">
    <verse number="23" style="v" />Ikxpenate' txqan tchib'jil,</para>
  <para style="q">kuwxi'x naku'j tzqa'jsa'n k'uxb'il.</para>
  <para style="q">
    <verse number="24" style="v" />Ch'uẍju' tanmi kse'n pik,</para>
  <para style="q">ch'uẍ kse'n ka cheb'l wab'j.</para>
  <para style="q">
    <verse number="25" style="v" />Ajtjawe'; aye'ju' nimaq kyoklen</para>
  <para style="q">inche jawsak'puj ex inche'x oq.</para>
  <para style="q">
    <verse number="26" style="v" />Aye'ju' k'uẍtx'e'nb'il, ch'ut, smaj</para>
  <para style="q">ex b'o'sch'ut layx b'ent tb'yet kyu'n.</para>
  <para style="q">
    <verse number="27" style="v" />Iky k'uxb'ilju' te kse'n ttxa triy</para>
  <para style="q">atzunju' q'ank'uxb'il kse'n q'u'chun tze.</para>
  <para style="q">
    <verse number="28" style="v" />Lay xob' kye smaj;</para>
  <para style="q">qama txi'xon ab'j ti'j nakuj ttxa triy nela' te.</para>
  <para style="q">
    <verse number="29" style="v" />Qama tz'okb'yet tu'n mans ikytz'ela' naku'j jun tqan ptz'an;</para>
  <para style="q">naq ntze'n ti'ju' tq'ojq'ojel tkb'el smaj.</para>
  <para style="q">
    <verse number="30" style="v" />Aj txi' qititin twitz tx'otx', majx nkyaj qotx' tu'n,</para>
  <para style="q">naku'j ati twitzteju' txk'owil.</para>
  <para style="q">
    <verse number="31" style="v" />Injaw loqlonju' t-xe ninnjab' tu'n naku'j jun k'wil;</para>
  <para style="q">kse'n jun k'wil nimin najb'en tu'n tb'aj smetju' k'ok'sb'il.</para>
  <para style="q">
    <verse number="32" style="v" />Majx nkyaj lememen a' tu'n</para>
  <para style="q">saq ex ntiltz'aj kse'n txqan twi' b'alun t-txaye slub'in.</para>
  <para style="q">
    <verse number="33" style="v" />Mixti'x jun ikwitju' twitz tx'otx';</para>
  <para style="q">tkub'lenx b'incha'n mixti'x tu'n t-xob'.</para>
  <para style="q">
    <verse number="34" style="v" />In twab'i'n tib' kwitzju' kuwqe'xi'x,</para>
  <para style="q">a te nimaqkawil kyxolju' txqantl txkup, chi Dyos te Job'.</para>
  <chapter number="42" style="c" />
  <para style="s1">Eltnik' Job' ti'ju' tnab'l Dyos</para>
  <para style="sp">Job'</para>
  <para style="q">
    <verse number="1-2" style="v" />Matxi' wile' qa tkyaqil kb'entel tu'na,</para>
  <para style="q">ex mixti' jun ti'xti' laywit b'ent.</para>
  <para style="q">
    <verse number="3" style="v" />¿Alokyeqine' tu'n njawjeye' ti'ju' t-xima,</para>
  <para style="q">tu'ntzun nela tnik'tzil qa mixti' b'a'n wu'ne'?</para>
  <para style="q">Intoq chin yoline' kyi'ju' tixti' min kane toj nwitze',</para>
  <para style="q">tb'anilqexi'x ex minti' npon nab'le' ti'j.</para>
  <para style="q">
    <verse number="4" style="v" />Matzaj tma'na weye': B'intza, qu'n wajb'ile' tu'n nyoline' tuk'ila;</para>
  <para style="q">tzaq'wenqe'tza nxjele' lu, chija.</para>
  <para style="q">
    <verse number="5" style="v" />Tzmaxte' ja'lo, naqtoq b'i'na wu'ne',</para>
  <para style="q">atzu'n ja'lo mawilku'ye' kyu'nku' nwitze'.</para>
  <para style="q">
    <verse number="6" style="v" />Qu'mtzun k'anjetzti'j wanmiye',</para>
  <para style="q">q'uqliqine' toj quq ex toj tza'j, chi Job' te Dyos.</para>
  <para style="s1">Tzaj tq'o'ntl Dyos tq'inumal Job'</para>
  <para style="p">
    <verse number="7" style="v" />Tb'ajlenxi' tma'n Qman Dyos ti'xti' lu te Job', ex ikx xitma'n te Elipas: Nchin tx'u'jine' ti'ja ex kyi'ju' kab'e'tl tamiwa, qu'n min e'yoline' ax wi'je', kse'n tb'inchaju' nmajine' Job'. <verse number="8" style="v" />Ja'lo kyiq'intztzune' wuq tman wakx ex wuq tman rit ex kukxi'ye' ka'yilte nmajine' Job', kyq'onqeku'ye' te chojb'il k'ok'sb'il tu'n tpaj kyile'. Kkub'salju' nmajine' Job' kyi'je', knk'ma'ye' tna'j Dyos ex lay nb'incha jun taq'wixe' kyi'je', tu'npe'tzun atixi'x kyile' qu'n min e'yoline' ax wi'je', kse'n tb'inchaju' nmajine' Job', chi Dyos te.</para>
  <para style="p">
    <verse number="9" style="v" />Exi'tzun Elipas, B'ildad, ex Sopar xi'kb'inchanju' tma Qman Dyos kye, atzunte Qman Dyos tk'amju' tna'j Dyos Job'.</para>
  <para style="p">
    <verse number="10" style="v" />Tb'ajlenxi' tnaj Dyos Job' kyi'ju' tamiw, tzaj tq'o'n Dyos jumajtlu' tq'inumal, kab'e'pe' kyintlu' tzaj tq'o'n Dyos te. <verse number="11" style="v" />Eb'ajpontzun xb'et-salte tkyaqilju' ttzik ex titz'in kyuk'ilju' tamiw ikqexju' ojtzqi'n kywitz tu'n ojtxi', kyuk'i'ltzun kyb'incha jun nimaqwan tja, xikyq'uq'b'a'n tk'u'j ex b'aj kso'jla'n tu'n tkyaqil yajb'il tzaj tq'o'n Qman Dyos ti'j, teyile junjunkye xitq'o'n jun tajlal pwaq ex jun xmilq'ob'aj q'anpwaq.</para>
  <para style="p">
    <verse number="12" style="v" />Tky'i'wla Qman Dyos Job' nimxi'x kyoju' mankb'il tab'q'iyil kyetwitzju' tnejel. Ten junmutx' o'lajk'al trit (14,000), ex o'lajk'al (6,000) tkamey, ex kab'k'al lajnaq (1,000) muj twakyix, ex kab'k'al lajnaq (1,000) tb'ur. <verse number="13" style="v" />Ex tentl kyajlajoj tk'wal ex oxe' tmyal. <verse number="14" style="v" />Oktq'o'n tb'iju' tzikb'aj, Jemima, atzu'n tkab', kesya, atzu'n toxi'n, qeren-apuk. <verse number="15" style="v" />Mixti'tlte' qya toj tkyaqil twitz tx'otx' tb'anilqexi'x kse'nqe' tmyal Job'. Xitq'o'n kyman kyetzb'il ti'ju' tq'inumal junx kyuk'i'lju' kyxib'en.</para>
  <para style="p">
    <verse number="16-17" style="v" />Tik'lenxi'tzun tkyaqil ja'lu, anq'in wuqnaq (140) ab'q'itl Job' twitz tx'otx', ex ti'jwnaqxi'xtl tej tkyim, e'tilju' tk'wal, e'tchman, e'kyk'wal tchman ex kychman ttchman.</para>
</usx>