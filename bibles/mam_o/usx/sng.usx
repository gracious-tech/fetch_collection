<?xml version="1.0" encoding="utf-8"?>
<usx version="2.6">
  <book code="SNG" style="id">SNG. TXT Febrero 2009 Pedro D. Cabrera Mam Ostuncalco. Updated for DBL by G. Grasso and E. Canales, December 2012, standardization after migration to PT8 by A. Camus March, 2019.</book>
  <para style="h">El Cantar de los Cantares</para>
  <para style="toc3">Cnt</para>
  <para style="toc2">Cnt</para>
  <para style="toc1">Tb'anil B'itz (Cantares)</para>
  <para style="mt1">E' TB'ANIL B'ITZ</para>
  <para style="mt2">(Cantares)</para>
  <para style="imt">CHIK'B'AB'L</para>
  <para style="ip">A tb'i u'j lu a tz'elpuna'ju' Tb'anilxi'x Kyxolju' Txqantl B'itz mujqa Aye' Tb'anil B'itz. A nq'manjtzju' matxi' tzajxi' qa a Salomon tz'ib'alte u'j lu. Qaq tb'anilxim mujqa b'itz tku'x toj, ikykytenju' kse'n nyolin jun q'a tuk'i'l jun txin, ex ate' jun k'loj mojtzalte toj kmoji'n, a tnab'lju' tk'u'jlalil axxi'x, ẍtilun ex chik'li.</para>
  <para style="ip">Ntyek'u'n xjanb'il toj jun mjeb'le'n. Tu'ntzunju' ntyek'u'n mujb'ab'l tu'n Dyos tuk'i'lju' ttanam, ex a tnab'lju' npjet kyu'n aj Juda toju' kyokslab'l, atzu'n toju' okslab'l ti'j Qajaw, npjet tnab'l ti'ju' tb'anil tmujb'ab'l Qajaw Jesukrist kyuk'i'lju' okslal (toj klesi).</para>
  <chapter number="1" style="c" />
  <para style="p">
    <verse number="1" style="v" />E'tb'itz Salomon tb'anilxi'x kyxol txqantl.</para>
  <para style="s1">Tnejel b'itz</para>
  <para style="sp">Tyol xu'jilb'aj</para>
  <para style="q">
    <verse number="2" style="v" />¡Chin tma'tzima b'a'nxi'x!</para>
  <para style="q">majx b'a'n nela' ajttz'ulina kyetwitz b'in chi',</para>
  <para style="q">
    <verse number="3" style="v" />inxi'x che puk'chaju' tk'ok'sb'ila,</para>
  <para style="q">Iky tb'iju'ya kse'n k'ok'sb'il in ok qi'j.</para>
  <para style="q">¡Qu'mtzun nxi'x che laqj qya ti'ja!</para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" />¡Lwix chin tiq'inxa tk'etza!</para>
  <para style="q">¡Chin tiq'inxa toju' tjaya, nimaqkawil! chij.</para>
  <para style="sp">Kyyol mojtzal</para>
  <para style="q">Tzalajb'ilxi'x qotenb'ela'ye' tuk'i'la;</para>
  <para style="q">kjawil qnima'xi'xe' ttz'uli'na kyetwitzju' b'in.</para>
  <para style="q">¡Qu'npe'natzunlo nxi'x che laqj qya ti'ja! chechij.</para>
  <para style="sp">Tyol xu'jilb'aj</para>
  <para style="q">
    <verse number="5" style="v" />Aye'ye' qya aj Jerusalen,</para>
  <para style="q">q'eqinin qinwe', ex tb'anil chin ka'yine';</para>
  <para style="q">q'eqinin qine' kse'n che ka'yin xmuj toj kyedar,</para>
  <para style="q">Tb'anilqine' kse'nqe' xb'alun ttzi tokext-spik'un Salomon.</para>
  <para style="q">
    <verse number="6" style="v" />Myate tu'n tok kyka'yi'ne' qa q'eqinin qine',</para>
  <para style="q">ex myate' qa matxi' chin kub'q'eqaxe' tu'n q'ij.</para>
  <para style="q">Tzaj toj kywitzju' nxib'ene' wi'je'</para>
  <para style="q">in okkyq'o'ne' ka'yilte kyawal ub'a</para>
  <para style="q">¡Atzu'nwe' wawal kub' yajti!</para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" />Q'mantza weye' aya nxi'x chin laqje' ti'ja,</para>
  <para style="q">¿janche tk'ik'le'na'ju'ya trita?,</para>
  <para style="q">¿ja nche'xa' tiq'i'na tu'n kyojlan te wanq'ij?</para>
  <para style="q">¿Tiqu'n naqnchin takanjeye' jyolteya,</para>
  <para style="q">kyxol kyritju' txqantl tuk'i'la k'ik'lelqe'? chij.</para>
  <para style="sp">Kyyol mojtzal</para>
  <para style="q">
    <verse number="8" style="v" />Qa min b'i'n tu'na,</para>
  <para style="q">aya tb'anilxi'x ka'yina kyxolju' qya tb'anilqe',</para>
  <para style="q">lpexa ti'j kyqanb'enju' rit</para>
  <para style="q">ex k'ik'lemqe'ju'ya tal tchib'a</para>
  <para style="q">tk'etz kyja k'ik'lel, chechij.</para>
  <para style="sp">Tyol chmilb'aj</para>
  <para style="q">
    <verse number="9" style="v" />Ikta' weye' qya, aya nxi'x chin laqje' ti'ja,</para>
  <para style="q">kse'n tb'anil ttxu b'anchej jk'ul tkarwaj Paraon.</para>
  <para style="q">
    <verse number="10" style="v" />¡Majx tb'anilju' twitza</para>
  <para style="q">kyoju' xpatx'b'ente twi'ya!</para>
  <para style="q">¡Tb'anilxi'x tka'yinxju' tqula</para>
  <para style="q">kyu'nju' tuya!</para>
  <para style="q">
    <verse number="11" style="v" />¡Che b'elqb'incha'n toj t-ẍkyina q'anpwaqqe'</para>
  <para style="q">b'incha'nqe'k saqpwaq kyi'j! chij.</para>
  <para style="sp">Tyol xu'jilb'aj</para>
  <para style="q">
    <verse number="12" style="v" />Ajtkub' qe nimaqkawil ti'j mes,</para>
  <para style="q">nkub' puk'chaju' nk'ok'sb'ile'.</para>
  <para style="b" />
  <para style="q">
    <verse number="13" style="v" />Iky nela' nchin laqju'ye' ti'j kse'n tk'ok'jil mir</para>
  <para style="q">tku'x ttzi nk'u'je'.</para>
  <para style="q">
    <verse number="14" style="v" />Iky nela' nchin laqju'ye' ti'j kse'n jun pchoj b'ech</para>
  <para style="q">toj tqan ub'a toj En-kadi, chij.</para>
  <para style="sp">Tyol chmilb'aj</para>
  <para style="q">
    <verse number="15" style="v" />¡Majx tb'anilxi'xa, aya nchin laqje' ti'ja,</para>
  <para style="q">majx xa'wanku'xi'xa!</para>
  <para style="q">¡Naku'j kab'e' palomsqe' tb'aq' twitza! chij.</para>
  <para style="sp">Tyol xu'jilb'aj</para>
  <para style="q">
    <verse number="16" style="v" />¡Majx tb'anilxi'xa, aya nxi'x chin laqje' ti'ja,</para>
  <para style="q">majx xa'wanku'xi'xa! chij.</para>
  <para style="sp">Tyol chmilb'aj</para>
  <para style="q">¡Majx cha'x k'ulju' qkuẍb'il!</para>
  <para style="q">
    <verse number="17" style="v" />K'ute tptzo'nilju' qja,</para>
  <para style="q">atzun tzis te twi' qja.</para>
  <chapter number="2" style="c" />
  <para style="sp">Tyol xu'jilb'aj</para>
  <para style="q">
    <verse number="1" style="v" />Ayine' b'ech toju' plan tx'otx' te Saron,</para>
  <para style="q">ayine' rojs kyoju' b'ya', chij.</para>
  <para style="sp">Tyol chmilb'aj</para>
  <para style="q">
    <verse number="2" style="v" />Iky nchin laqju'ye' ti'j kyxol txqantl qya,</para>
  <para style="q">kse'n jun rojs kyxol ch'i'x, chij.</para>
  <para style="sp">Tyol xu'jilb'aj</para>
  <para style="q">
    <verse number="3" style="v" />Iky nchin laqju'ye' ti'j kyxol txqantl ichan,</para>
  <para style="q">kse'n junwi' mansan toj k'ul.</para>
  <para style="b" />
  <para style="q">¡Majx tzalajb'il ajnkub' qeye' tjaq'ju' tewan!</para>
  <para style="q">¡Majx chi' nnela' tlob'jil weye'!</para>
  <para style="q">
    <verse number="4" style="v" />Inxi'tiq'i'ne' toju' tja kye nimaqwan</para>
  <para style="q">intoq tzaj ka'yin weye' tuk'i'l tk'u'jlalil.</para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" />¡Chin tkuwsama tu'n wab'j b'incha'n ti'j ub'a,</para>
  <para style="q">chin tk'a'chama tu'n lob'j mansan,</para>
  <para style="q">qu'n naqx tu'n nkyimtle' tu'nju' nxi'x chin laqje' ti'ja!</para>
  <para style="q">
    <verse number="6" style="v" />¡Q'onku'ya tnayaj tq'ob'a tjaq' nwi'ye',</para>
  <para style="q">ex chin tchleka tu'n tb'a'nq'ob'a! chij.</para>
  <para style="sp">Tyol chmilb'aj</para>
  <para style="q">
    <verse number="7" style="v" />Kytziyantze' weye', qya aj Jerusalen,</para>
  <para style="q">tu'n t-xikyka'yi'ne' tal tojk'ul msat,</para>
  <para style="q">tu'n lan tz'el twatlju' qya nchin laqje' ti'j.</para>
  <para style="q">¡Wtanku'j tzmaxi'j ajtel twatl! chij.</para>
  <para style="s1">Tkab' b'itz</para>
  <para style="sp">Tyol xu'jilb'aj</para>
  <para style="q">
    <verse number="8" style="v" />¡Luju' ichan nchin laqje' ti'j tzul!</para>
  <para style="q">¡Inxinb'i'ne' tq'ojq'ojel toj twi'!</para>
  <para style="q">Lu tzul nxlik'pun kyib'aju' k'ul,</para>
  <para style="q">lu tzul nxlik'pun kyib'aj witz.</para>
  <para style="q">
    <verse number="9" style="v" />Iky ichanju' nchin laqje' ti'j kse'n jun msat:</para>
  <para style="q">kse'n jun tal msat.</para>
  <para style="q">¡Lu pena' atitl twitz tjpel ja,</para>
  <para style="q">in ka'yinktz ttzi tokex spik'un,</para>
  <para style="q">in ka'yinktz toj xopa'j!</para>
  <para style="q">
    <verse number="10" style="v" />Tzaj tma'n ichan nchin laqje' ti'j kjalu:</para>
  <para style="q">We'ktza tal nmsat;</para>
  <para style="q">lwixa, qo'ya, inxi'x chin laqje' ti'ja.</para>
  <para style="q">
    <verse number="11" style="v" />¡Ka'yinxpe'ya! Matxi' tzik'te' jb'alil</para>
  <para style="q">majx matxitiq'i'n jb'al.</para>
  <para style="q">
    <verse number="12" style="v" />Matxi' che poq'chaju' b'ech toj kojb'il,</para>
  <para style="q">matxi' pon tq'ijlalil tu'n qb'itzan,</para>
  <para style="q">matxi' che aq' oq'ilju' tal paloms</para>
  <para style="q">tzalu toju' qnajb'il.</para>
  <para style="q">
    <verse number="13" style="v" />Atitl twitzju' lob'j iw,</para>
  <para style="q">ex nche puk'chajtlju' tqan ub'a.</para>
  <para style="b" />
  <para style="q">We'ktza, tal nmsat;</para>
  <para style="q">lwixa, qo'ya, inxi'x chin laqje' ti'ja.</para>
  <para style="b" />
  <para style="q">
    <verse number="14" style="v" />Aya tal npalomse', nokx tewa'ntib'a toj kyk'atxub' piky,</para>
  <para style="q">newanjxa kywitz nimaq pik,</para>
  <para style="q">yek'untz twitza weye',</para>
  <para style="q">wajb'ile' tu'n nb'inteye' toj twi'ya.</para>
  <para style="q">¡Majx tzalajb'ilte' ajtok nka'yi'na!</para>
  <para style="q">¡Majx tzalajb'il ajtyolina! chij.</para>
  <para style="sp">Kyyol kykab'il</para>
  <para style="q">
    <verse number="15" style="v" />Che kytzyume' chuẍ, aye' chuẍ b'o'sqe',</para>
  <para style="q">qu'n ate'qe'k yajulkye qawale',</para>
  <para style="q">aju' qawale' tzmaxi'x nub'chin, chechij.</para>
  <para style="sp">Tyol xu'jilb'aj</para>
  <para style="q">
    <verse number="16" style="v" />Wewe' ichan nchin laqje' ti'j, ex teqine'.</para>
  <para style="q">Nk'ik'len kyi'j trit kyxol b'ech rojs.</para>
  <para style="b" />
  <para style="q">
    <verse number="17" style="v" />Kutanjtz ti'ja, aya nchin laqje' ti'ja,</para>
  <para style="q">akx njawu'l q'ij ex nkub'naj qxopin;</para>
  <para style="q">kutetz oqa naku'j msat,</para>
  <para style="q">naku'j jun tal b'o's msat</para>
  <para style="q">kywitz nimaq k'ul.</para>
  <chapter number="3" style="c" />
  <para style="q">
    <verse number="1" style="v" />Njoye' ichan nchin laqje' ti'j</para>
  <para style="q">toj nkuẍb'ile' te qonik'an.</para>
  <para style="q">Njoye' ex min knet wu'ne'.</para>
  <para style="q">
    <verse number="2" style="v" />Njawe'tzuntze'</para>
  <para style="q">b'je'lpunx wu'ne' toj nintnam,</para>
  <para style="q">tu'n tjoyliju' nchin laqje' ti'j</para>
  <para style="q">kyoj b'e ex jachaq ta'qe' xjal.</para>
  <para style="q">Njoye' ex min knet wu'ne'.</para>
  <para style="q">
    <verse number="3" style="v" />Xinqani'ne' kyeju' xq'uqil</para>
  <para style="q">nche xq'uqin te qonik'a'n ti'jile nintnam:</para>
  <para style="q">¿Ma min xkyilkye' ichan nchin laqje' ti'j? nchije'.</para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" />Naqtzun ch'i'n wik'len b'ete' kyk'etz,</para>
  <para style="q">tej tel yalju' nchin laqje' ti'j.</para>
  <para style="q">Tzaj ntzyu'ne' tq'ob', ex min xintzaqpi'ne',</para>
  <para style="q">xiwiq'i'ntzuntze' kyoju' tja ntxuye', chij.</para>
  <para style="sp">Tyol chmilb'aj</para>
  <para style="q">
    <verse number="5" style="v" />Kytziyantze' weye', qya aj Jerusalen,</para>
  <para style="q">tu'n txi' kyka'yi'ne' tal toj k'ul msat,</para>
  <para style="q">tu'n lalun tz'el twatlju' qya nchin laqje' ti'j.</para>
  <para style="q">¡Wtanku'j tzmax ajttzaj tna'ntib'! chij.</para>
  <para style="s1">Toxi'n b'itz</para>
  <para style="sp">Kyyol mojtzal</para>
  <para style="q">
    <verse number="6" style="v" />¿Ti'tzu'n xi' ttzaj toj chq'ajlaj</para>
  <para style="q">xi' ttzaj toj jun tnej sib',</para>
  <para style="q">toj jun tnej t-sb'el mir ex sturak,</para>
  <para style="q">ex toj t-sb'el chukchaq k'ok'sb'il?</para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" />¡Ate iqalte Salomonju'!</para>
  <para style="q">txoli'n ti'j kyu'n oxnaq (60) xjal te q'oj,</para>
  <para style="q">aye' kuwqe'xi'x kyxol aj Israel;</para>
  <para style="q">
    <verse number="8" style="v" />kykyaqilx b'a'n che q'ojin tuk'i'l k'uẍtx'e'nb'il</para>
  <para style="q">nimaq q'ojilqe';</para>
  <para style="q">K'lo'mile kyk'uẍtx'e'nb'il kyk'u'j,</para>
  <para style="q">te kolb'ilkye toj qonik'an.</para>
  <para style="b" />
  <para style="q">
    <verse number="9" style="v" />Matxi' kub' tb'incha'nte nimaqkawil Salomon jun iqb'ilte</para>
  <para style="q">kyuk'i'l tz'umin tze toj Lib'ano.</para>
  <para style="q">
    <verse number="10" style="v" />Saqpwaqqe' tqan;</para>
  <para style="q">q'anpwaq tqejb'il ttze'lti'j;</para>
  <para style="q">ktxu'n jankub' qeya' tu'n xb'alun kyeq sq'ib'un;</para>
  <para style="q">atzu'n tojxi' wiqo'n tb'anilxi'x</para>
  <para style="q">kyu'n qya aj Jerusalen.</para>
  <para style="b" />
  <para style="q">
    <verse number="11" style="v" />Aye'ye' qya aj Syon,</para>
  <para style="q">¡kukyetze' ka'yilte nimaqkawil Salomon!</para>
  <para style="q">Tokx tkoron te oklenj</para>
  <para style="q">ju' kub' tb'incha'n ttxu te, tej tmje,</para>
  <para style="q">toju' q'ij majx tzalajb'ilxi'x toju' tchwinqlal, chechij.</para>
  <chapter number="4" style="c" />
  <para style="s1">Tyol chmilb'aj</para>
  <para style="q">
    <verse number="1" style="v" />¡Majx tb'anilxi'xa qya, nchin laqje' ti'ja!</para>
  <para style="q">¡Majx tb'anilxi'xa!</para>
  <para style="q">Tal palomsqe' tb'aq' twitza</para>
  <para style="q">e'wa'n tu'n ttxo'wa toj twi'ya;</para>
  <para style="q">ikytka'yinx t-smal twi'ya kse'nqe' tal chib'</para>
  <para style="q">nche ẍchan twi' witz Kalaad.</para>
  <para style="q">
    <verse number="2" style="v" />B'a'nileqe' twitzteya kykyaqil,</para>
  <para style="q">ikqe' kse'n jun tnej rit</para>
  <para style="q">akxtoq kyb'aj ichet</para>
  <para style="q">tu'n tel joyet kyi'j.</para>
  <para style="q">
    <verse number="3" style="v" />Ẍkyeqqe' ttziya</para>
  <para style="q">kse'n q'in kyeqka'yin,</para>
  <para style="q">majx tzalajb'ilqe' tyola.</para>
  <para style="q">ẍkyaqqe' junjun plaj ttziya e'wa'n toju' kutxb'il twitza</para>
  <para style="q">naku'j kranad ajtkub' aq'pet.</para>
  <para style="q">
    <verse number="4" style="v" />Tb'anilxi'xju' tqula</para>
  <para style="q">kse'n tja Dab'i nimin twe'.</para>
  <para style="q">b'incha'n kyuk'i'l ab'j jso'n kywitz</para>
  <para style="q">Yob'a'nqe'k kab'k'al lajnaq (1,000) kolb'il ti'j,</para>
  <para style="q">kykolb'ilju' xjal min nche xob'.</para>
  <para style="q">
    <verse number="5" style="v" />Ikyqe' timi'ẍju'ya kse'n kab'e' tal msat</para>
  <para style="q">kab'e' tal msat yuẍqe'</para>
  <para style="q">nche wan kyxol b'ech rojs.</para>
  <para style="b" />
  <para style="q">
    <verse number="6" style="v" />Akx njawu'l q'ij</para>
  <para style="q">ex nkub'naj qxopin,</para>
  <para style="q">chin xe'le' twi' witz jata' mir,</para>
  <para style="q">twi' witz jata' sturak.</para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" />¡Majx tb'anilxi'xa, aya nchin laqje' ti'ja;</para>
  <para style="q">tb'anilxi'xa tzajx t-xe tqana japumnix toj twi'ya!</para>
  <para style="q">¡Mixti' junta ttzakajil!</para>
  <para style="b" />
  <para style="q">
    <verse number="8" style="v" />Qoku'tz wuk'i'le' twi' witz Lib'ano, tal nxu'jil;</para>
  <para style="q">qoku'tz wuk'i'le' twi' witz Lib'ano.</para>
  <para style="q">Ka'yinxpe'ya b'ya' tzmax twi' witz Amana,</para>
  <para style="q">tzmax twi' witz Senir ex Ermon;</para>
  <para style="q">tzmax kyoj kyjul b'alun,</para>
  <para style="q">tzmax twi' witz ja ta'qe' txkup leopa'rt kyb'i.</para>
  <para style="b" />
  <para style="q">
    <verse number="9" style="v" />Inxi'x ẍilj wanmiye' ti'ja,</para>
  <para style="q">tal wanab', tal nxu'jil;</para>
  <para style="q">nxi'x ẍilj wanmiye' ti'ja</para>
  <para style="q">naqx tu'n saj ka'yina wi'je'</para>
  <para style="q">naqx tu'n jun taq'e'l tuya.</para>
  <para style="b" />
  <para style="q">
    <verse number="10" style="v" />¡Tzalajb'ilxi'xte' ajttz'ulina</para>
  <para style="q">tal wanab', tal nxu'jil!</para>
  <para style="q">¡Tzalajb'ilxi'xte' ajttz'ulina kyetwitz tchi'yal b'in,</para>
  <para style="q">ex majx tk'ok'jalxi'xju' tk'ok'sb'ila</para>
  <para style="q">kyetwitz tkyaqil k'ok'sb'il!</para>
  <para style="q">
    <verse number="11" style="v" />Tal nxu'jil,</para>
  <para style="q">majx chi' ta'lkab' toj ttziya.</para>
  <para style="q">¡Ta'lkab' ex lech ati tjaq' taq'a!</para>
  <para style="q">¡Iky tk'ok'jal ti'ju'ya</para>
  <para style="q">kse'n kyk'ok'jal tze toj Lib'ano!</para>
  <para style="b" />
  <para style="q">
    <verse number="12" style="v" />Tal wanab', tal nxu'jil</para>
  <para style="q">jun awalta ch'laji'n ti'j,</para>
  <para style="q">t-xiklil a' jpu'n b'a'nxi'x;</para>
  <para style="q">xoch tok techel,</para>
  <para style="q">
    <verse number="13" style="v" />jun awal toj tqan lob'j kranad</para>
  <para style="q">toj kyqan tb'anil lob'j;</para>
  <para style="q">jun awb'il ja ta'qe' b'ech alenya tb'i</para>
  <para style="q">
    <verse number="14" style="v" />b'ech nardo ex asapran kyb'i,</para>
  <para style="q">ptz'an k'ok'j ex kanel,</para>
  <para style="q">ex chukchaq tze tqan sturak,</para>
  <para style="q">mir ex alowe;</para>
  <para style="q">¡kykyaqilxju' tb'anilxi'x k'ok'sb'il!</para>
  <para style="q">
    <verse number="15" style="v" />Ikyju'ya kse'n jun t-xiklil a' toj awb'il</para>
  <para style="q">kse'n jun xoch janjatza' piq'chaj a'</para>
  <para style="q">aju' a' nku'tz twi' witz Lib'ano.</para>
  <para style="b" />
  <para style="q">
    <verse number="16" style="v" />¡Jub'ina kyq'iq'!, toj tb'a'nq'ob'kya'j.</para>
  <para style="q">¡Kutzaja!, kyq'iq' toj tnayajkya'j.</para>
  <para style="q">¡Kyxupinxe' toju' wawale' tu'nt-xi' puk'chaju' tk'ok'jal! chiju' chmilb'aj.</para>
  <para style="s1">Tyol xu'jilb'aj</para>
  <para style="q">Kutzaja toju' tawala, aya nchin laqje' ti'ja,</para>
  <para style="q">ex lo'na kyi'ju' twitz tb'anilqexi'x, chij.</para>
  <chapter number="5" style="c" />
  <para style="sp">Tyol chmilb'aj</para>
  <para style="q">
    <verse number="1" style="v" />Atinqintlna'we' toju' wawale',</para>
  <para style="q">tal wanab', tal nxu'jil.</para>
  <para style="q">matxi' b'je'l wiq'i'ne' mir ex nk'ok'sb'ile',</para>
  <para style="q">matxi' txinnik'b'e'ne' ta'lkab' toj aq,</para>
  <para style="q">ex matxi' txi nk'wa'ne' b'in ex lech, chij.</para>
  <para style="sp">Kyyol mojtzal</para>
  <para style="q">Che wanqe'tzune' ex che k'wanqe'ye',</para>
  <para style="q">wamiw kyeqten kyuk'i'le',</para>
  <para style="q">¡kyk'wanxe' tkyaqilju' mab'aj kyu'ne'! chechij.</para>
  <para style="s1">Tkyaji'n b'itz</para>
  <para style="sp">Tyol xu'jilb'aj</para>
  <para style="q">
    <verse number="2" style="v" />Intoq chin wtane', atzu'n wanmiye' itz'.</para>
  <para style="q">Ex nb'iye' intoq txokonju' nchin laqje' ti'j ttzija:</para>
  <para style="q">¡Jqo'nkxa ja, aya nchin laqje' ti'ja;</para>
  <para style="q">wanab',</para>
  <para style="q">q'poja, kse'n jun tal paloms!</para>
  <para style="q">¡Matxi' b'aj ak' nwi'ye' tu'n ta'l che'w!</para>
  <para style="q">¡Ntx'ab'u'n nwi'ye' tu'n ta'l che'w nkub' qonik'an! Chij.</para>
  <para style="b" />
  <para style="q">
    <verse number="3" style="v" />Matxi' tz'el wiq'i'ne' wi'je';</para>
  <para style="q">¡Oklo k'okyel nq'o'n jumajtle'!</para>
  <para style="q">Matxi' tz'el ntx'jo'ne' nqane';</para>
  <para style="q">¡oklo k'okyel jumajtl quq kyi'j! nchije'.</para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" />Atzunju' ichan nchin laqje' ti'j</para>
  <para style="q">okxtq'o'n tq'ob' toj t-xopajil tjpel ja.</para>
  <para style="q">¡Majx njaw tzalaje' b'a'nxi'x tu'n!</para>
  <para style="q">
    <verse number="5-6" style="v" />Njawe'tzuntze'</para>
  <para style="q">jqolte ja teju' nchin laqje' ti'j.</para>
  <para style="q">El txatj ta'l mir kyi'ju' nq'ob'e' ex kyi'j twinq'ob'e'</para>
  <para style="q">tib'aju' jupb'ilte ja.</para>
  <para style="q">¡Tej t-xinb'i'ne' tjaw yolin, majx nkub' b'aje'!</para>
  <para style="b" />
  <para style="q">Okx njqo'ne' ja teju' nchin laqje' ti'j,</para>
  <para style="q">atzunte mix-a'lo'tltoq.</para>
  <para style="q">Njoye' ex min knet wu'ne',</para>
  <para style="q">tzaj ntxko'ne' ex mix-a'lo'te tzaj tzaq'wi.</para>
  <para style="q">
    <verse number="7" style="v" />Nnelyale' kwitzju' xq'uqil</para>
  <para style="q">nche xq'uqin qonik'a'n ti'jileju' nintnam;</para>
  <para style="q">nb'aj kyjuma'ne', nk'ixb'iye' kyu'n;</para>
  <para style="q">¡aye'tzu'n nche xq'uqin ttzi nintnam</para>
  <para style="q">elkyjk'u'n ntxo'we' tuk'i'l kytx'u'jil!</para>
  <para style="b" />
  <para style="q">
    <verse number="8" style="v" />E'qya aj Jerusalen,</para>
  <para style="q">qama tz'el yalju' nchin laqje' ti'j kywitze',</para>
  <para style="q">kytziyantze' qa kxe'l kyma'n ch'i'ne' te</para>
  <para style="q">qa ch'intl nkukyime' ti'j, chij.</para>
  <para style="sp">Kyyol mojtzal</para>
  <para style="q">
    <verse number="9" style="v" />¿Ti'xi'xtzu'n majx b'a'n ati teju' nlaqja ti'j,</para>
  <para style="q">qya tb'anilxi'xa kyekywitzju' txqantl qya tb'anilqe'?</para>
  <para style="q">¿Ti'xi'xtzu'n majx b'a'n ati teju' nlaqja ti'j</para>
  <para style="q">tu'nju' ntma'na tu'nqtziyanteye' yol lu teya? chechij.</para>
  <para style="sp">Tyol xu'jilb'aj</para>
  <para style="q">
    <verse number="10" style="v" />Qchulinwe' nchin laqj ti'j,</para>
  <para style="q">q'ancha'lxi'x kyxol junmutx' jo'k'al (10,000) ichan.</para>
  <para style="q">
    <verse number="11" style="v" />Iky twi' kse'n q'anpwaq;</para>
  <para style="q">ẍwilo'kyile t-xya'mal twi'</para>
  <para style="q">ex q'eq kse'n ti'j jun joj;</para>
  <para style="q">
    <verse number="12" style="v" />Ikyqe' twitzju' kse'n kab'e' paloms ichi'nqe' toj lech,</para>
  <para style="q">inche ojlan ttzi a';</para>
  <para style="q">
    <verse number="13" style="v" />naku'j awa'n b'echqe' junjun plaj ttzi</para>
  <para style="q">ati b'ech tb'anil tk'ok'jal toj.</para>
  <para style="q">Naku'j ros b'echu' ttzi</para>
  <para style="q">k'ok'ju' ta'l ajtel tx'atj nakuj mir;</para>
  <para style="q">
    <verse number="14" style="v" />ikyqe' tq'ob'ju' kse'nqe' tqul q'ob'aj q'anpwaq ate'k ab'j topasyo ti'j;</para>
  <para style="q">atzu'n t-xmilal naku'j tb'anil saqb'aq</para>
  <para style="q">b'incha'nqe'k tal ab'j sapiro kyoj kykb'el ti'j;</para>
  <para style="q">
    <verse number="15" style="v" />ikyqe' tkuxju' kse'nqe' tqan ja saq ab'j</para>
  <para style="q">awa'nqe' b'a'nxi'x kyib'aj kyq'uqlil q'anpwaqxi'x;</para>
  <para style="q">q'ancha'lxi'xju' ka'yin</para>
  <para style="q">kse'nqe' k'ute toj Lib'ano;</para>
  <para style="q">
    <verse number="16" style="v" />majx tchi'yalxi'x toj tk'o'n.</para>
  <para style="q">¡Tzalajb'ilxi'xju' ichan lu toj tkyaqil!</para>
  <para style="b" />
  <para style="q">Ikytzunte ichanju' nchin laqje' ti'j,</para>
  <para style="q">ikytzunte nxi'x chin laqju'ye' ti'j,</para>
  <para style="q">qya aj Jerusalen, chi xu'jilb'aj.</para>
  <chapter number="6" style="c" />
  <para style="sp">Kyyol mojtzal</para>
  <para style="q">
    <verse number="1" style="v" />¿Ja xxa'ju' k'u'jlalteya,</para>
  <para style="q">qya majx xa'wanku'xi'xa kyekywitz txqantl qya xa'wanqeku'?</para>
  <para style="q">¿Jatzunlo jaxxa'?</para>
  <para style="q">¡Qo xe'le' tuk'i'la jyolte! chechij.</para>
  <para style="sp">Tyol xu'jilb'aj</para>
  <para style="q">
    <verse number="2" style="v" />Xi' xxa'te' nchin laqje' ti'j toju' tawal,</para>
  <para style="q">toju' tawb'il npuk'chaj k'ok'sb'il toj,</para>
  <para style="q">matxi' k'ik'lel kye trit</para>
  <para style="q">ex k'usilkyeju' rojs b'ech.</para>
  <para style="b" />
  <para style="q">
    <verse number="3" style="v" />Te qinweju'ye' nchin laqje' ti'j, ex ikxte weye'.</para>
  <para style="q">Inche tk'ik'le'n trit kyxolju' rojs b'ech, chij.</para>
  <para style="s1">Tjwe'yi'n b'itz</para>
  <para style="sp">Tyol chmilb'aj</para>
  <para style="q">
    <verse number="4" style="v" />Qya, nchin laqje' ti'ja,</para>
  <para style="q">xa'wanku'xi'xa ex inxi'x chin tzalaje' ajt-xinka'yina</para>
  <para style="q">ikyju'ya kse'nqe' nimaqtnam Tirsa ex Jerusalen;</para>
  <para style="q">lay mqet twitza kse'n jun tnej xjal nk'u'n kyten ljo'nkyxi' toj q'oj.</para>
  <para style="q">
    <verse number="5" style="v" />¡Lan tzaj ka'yina wi'je',</para>
  <para style="q">qu'n matxi' kub'wi'je' kyu'n twitza!</para>
  <para style="b" />
  <para style="q">Iky t-xya'mal twi'ju'ya kse'nqe' tal chib'</para>
  <para style="q">nche saqchan kywi' witz toj Kalaad.</para>
  <para style="q">
    <verse number="6" style="v" />B'a'nileqe' twitzteya kykyaqil,</para>
  <para style="q">ikyqe' kse'n jun tnej rit</para>
  <para style="q">tzma ẍe b'aj ichi'n</para>
  <para style="q">tu'n tel jon kyi'j.</para>
  <para style="q">
    <verse number="7" style="v" />Ikyqe' junjun plaj ttziju'ya kse'n nik'janchaq lob'j kranad</para>
  <para style="q">e'wa'n toju' kutxb'il twitza.</para>
  <para style="b" />
  <para style="q">
    <verse number="8" style="v" />Oxnaq (60) kyb'aj t-xu'jil nimaqkawil,</para>
  <para style="q">kyajnaq (80) tqya,</para>
  <para style="q">atzun txqan kyb'aju' tqpoj</para>
  <para style="q">
    <verse number="9" style="v" />atzunwe' naqjun tal nqpoj npalomse',</para>
  <para style="q">naq o'kx kuxi'xte</para>
  <para style="q">kye tilwi tu'n ttxu.</para>
  <para style="q">Ky'i'wla'nxi'xta chechiju' txin te, ajt-xi' kyka'yi'n;</para>
  <para style="q">njaw nima'n kyu'n kyxu'jil ex kyqya nimaqkawil, chij.</para>
  <para style="sp">Kyyol mojtzal</para>
  <para style="q">
    <verse number="10" style="v" />¿Alkyetzunte' xi' ttzaj</para>
  <para style="q">kse'n ajttzaj t-xe kya'j?</para>
  <para style="q">Xa'wanku'xi'x kse'n xjaw,</para>
  <para style="q">nqoptz'aj kse'n q'ij,</para>
  <para style="q">¡layx mqettwiz kse'n jun tnej xjal nk'u'n kyten ljo'nkyxi' toj q'oj! chechij.</para>
  <para style="sp">Tyol xu'jilb'aj</para>
  <para style="q">
    <verse number="11" style="v" />Nxi'ye' toju' k'ul ja ta'qe' tze nokal kyb'i</para>
  <para style="q">nlab'tiye' ti'ju' tcha'xil ttzi a';</para>
  <para style="q">wajb'iltoqe' tu'n nlonteye' se'n njawula' twi' ub'a,</para>
  <para style="q">ex kyb'echil lob'j kranad.</para>
  <para style="q">
    <verse number="12" style="v" />Yajxi'tzuntl titi'lo b'ajweloye'</para>
  <para style="q">o'kx nna'nteye' tinqinkxe' toj karwaj tk'etzju' tk'wal nnimaqkawil nchin laqje' ti'j, chij.</para>
  <para style="sp">Kyyol mojtzal</para>
  <para style="q">
    <verse number="13" style="v" />¡Kutanjtz ti'ja, txin aj Sulam, kutanjtz ti'ja!</para>
  <para style="q">¡Kutanjtzti'ja, qajb'ile' tu'n tokqka'yina! chechij.</para>
  <para style="sp">Tyol xu'jilb'aj</para>
  <para style="q">¿Titi'tzu'n kyajb'ile' tu'n kyka'yinteye' ti'j aj Sulam? chij.</para>
  <para style="sp">Kyyol mojtzal</para>
  <para style="q">¡Tu'n tb'ixana, kse'n nb'inchet kyoj xmuj! chechij.</para>
  <chapter number="7" style="c" />
  <para style="sp">Tyol chmilb'aj</para>
  <para style="q">
    <verse number="1" style="v" />¡Xa'wanqeku'xi'xu' tqana</para>
  <para style="q">kyoju' t-xajab'a, tmyal nimaqkawil!</para>
  <para style="q">Majx tulin ti'ju' tal t-ẍo'pa,</para>
  <para style="q">kse'nqe' tilb'ilal b'incha'n q'anpwaqqe',</para>
  <para style="q">b'incha'n kyu'n xjal b'a'n kyb'inchante.</para>
  <para style="q">
    <verse number="2" style="v" />Iky tmuxju'ya kse'n jun tkb'el k'wab'j tulinti'j</para>
  <para style="q">kukx tk'wet b'inju' toj;</para>
  <para style="q">iky tk'u'ju'ya kse'n jun b'yoj triy</para>
  <para style="q">txoli'n ti'j tu'n b'ech rojs.</para>
  <para style="q">
    <verse number="3" style="v" />Ikqe' timi'ẍju'ya kse'n kab'e' ttxu msat,</para>
  <para style="q">kab'e' tal msat yuẍqe'.</para>
  <para style="q">
    <verse number="4" style="v" />Iky tqulju'ya kse'n jun ja nimin twe' ẍnu'lb'aqile ti'j;</para>
  <para style="q">ikyqe' twitzju'ya kse'n kab'e' xoch ẍtilunqe'</para>
  <para style="q">toju' nintnam Esb'on,</para>
  <para style="q">tu'me'l ttzi nintnam B'at-rab'im;</para>
  <para style="q">iky ttxa'na kse'n ja nimin twe' twi' Lib'ano,</para>
  <para style="q">t'ikylo'ktz tu'me'l nintnam Damask.</para>
  <para style="q">
    <verse number="5" style="v" />Ikytka'yinx twi'ju'ya</para>
  <para style="q">kse'n toktza' witz Karmelo;</para>
  <para style="q">ikyqe' t-xya'mal twi'ya kse'n q'in kyeq smo'n tk'i' cha'x:</para>
  <para style="q">¡kyajni ye' jun nimaqkawil toju' xpatx'b'ente twi'ya!</para>
  <para style="b" />
  <para style="q">
    <verse number="6" style="v" />Aya qya nchin laqje' ti'ja, qtze'tz kyoj twitza,</para>
  <para style="q">¡achb'ajila ex xa'wankuxi'xa!</para>
  <para style="q">
    <verse number="7" style="v" />iky tka'yinxju'ya kse'n tka'yinx jun tut;</para>
  <para style="q">ikyqe' timi'ẍju'ya kse'n jun tq'ob' lob'j txijli twitz.</para>
  <para style="q">
    <verse number="8" style="v" />Wajb'ile' tu'n njaxpwe'tzane' ti'ju' tut</para>
  <para style="q">tu'ntku'tz wiq'i'ne' tq'ob' txijli.</para>
  <para style="q">Che okyeltzun timi'ẍtza kse'n tq'ob' ub'a txijli;</para>
  <para style="q">iky t-xewju'ya kse'n mansan npuk'chaj;</para>
  <para style="q">
    <verse number="9" style="v" />iky toj tk'o'nju'ya kse'n tb'anil ta'l ub'a,</para>
  <para style="q">chab'a nku'x b'ililin toj ttziya</para>
  <para style="q">ex kyxe twitzteya, chij.</para>
  <para style="sp">Tyol xu'jilb'aj</para>
  <para style="q">
    <verse number="10" style="v" />Te qinwe' ichan nchin laqje' ti'j:</para>
  <para style="q">tu'nju' nxi'x laqj wi'je' nula' nk'etze'.</para>
  <para style="b" />
  <para style="q">
    <verse number="11" style="v" />¡Kuwxa, aya nchin laqje' ti'ja, qo'ya toj kojb'il!</para>
  <para style="q">K'elix qonik'an qu'n kyxol b'ech alenya.</para>
  <para style="q">
    <verse number="12" style="v" />Qo xe'l toj tqan ub'a te prim,</para>
  <para style="q">ka'yilte qa matxi' che b'echin,</para>
  <para style="q">ka'yilte qa nche poq'chaj,</para>
  <para style="q">qa matxi' che b'echinju' kranad.</para>
  <para style="q">¡Atzuntzu' kxe'la' nq'o'n nyole' teya!</para>
  <para style="q">
    <verse number="13" style="v" />Inxi'x che puk'chaju' lob'j mandrakora.</para>
  <para style="q">Chukchaq lob'j ati ttzi qja:</para>
  <para style="q">twitz lob'j tzqijsa'n ex tzmaxi'x ẍetzaj t'uxit,</para>
  <para style="q">mache elnpa'ne' teya, aya nchin laqje' ti'ja.</para>
  <chapter number="8" style="c" />
  <para style="q">
    <verse number="1" style="v" />¡Naqwit ikyj nxib'ena,</para>
  <para style="q">awttzu' xch'u'na'ya kyi'j timi'ẍ ntxuye'!</para>
  <para style="q">Ajwittzunlo tokyala wu'ne' toj b'e,</para>
  <para style="q">jaku' tz'ok nma'tzina ex mix-a'lo' tu'n t-xmayin wi'je';</para>
  <para style="q">
    <verse number="2" style="v" />jaku'wtlo txiwiq'i'na tja ntxuye',</para>
  <para style="q">jaku'wtlo tz'okx wiq'i'na tuja,</para>
  <para style="q">tu'n toka xnaq'tzalweye'.</para>
  <para style="q">Jaku'wtlo txinq'o'n tk'wa'ya tb'anil b'in</para>
  <para style="q">ex ta'l lob'j kranad.</para>
  <para style="b" />
  <para style="q">
    <verse number="3" style="v" />¡Q'onku' tnayaj tq'ob'a tjaq' nwi'ye',</para>
  <para style="q">chin tchleku'tzunta tu'n tb'a'nq'ob'a! chi xu'jilb'aj.</para>
  <para style="sp">Tyol chmilb'aj</para>
  <para style="q">
    <verse number="4" style="v" />Kytziyantze', qya aj Jerusalen,</para>
  <para style="q">tu'n lan txikyk'asu'ne' qya nchin laqje' ti'j.</para>
  <para style="q">¡Wtanku'j tzmax ajttzaj tna'ntib'! chij.</para>
  <para style="s1">Tqaqi'n b'itz</para>
  <para style="sp">Kyyol mojtzal</para>
  <para style="q">
    <verse number="5" style="v" />¿Alkyetzu'n tzul toj chq'ajlaj,</para>
  <para style="q">kuẍlok ti'j t-semu'lju' nlaqj ti'j? chechij.</para>
  <para style="sp">Tyol chmilb'aj</para>
  <para style="q">Tjaq' junwi' mansan xxa' nk'asu'na:</para>
  <para style="q">ja oka' ttxuya toj k'ixk'oj;</para>
  <para style="q">ja itz'ja'ya tu'n ttxuya, chij.</para>
  <para style="sp">Tyol xu'jilb'aj</para>
  <para style="q">
    <verse number="6" style="v" />Lalun chin ele' ti'j tanmiya,</para>
  <para style="q">¡chin tiq'ixa kse'n jun techil ti'j tq'ob'a!</para>
  <para style="q">Lay b'entte' tk'u'jlalil tmyet kse'n kamik;</para>
  <para style="q">ikyte tb'isju' kse'n muqb'il min yukchi.</para>
  <para style="q">¡Iky tk'u'jlalilju' kse'n q'aq' inxi'x ja'yun,</para>
  <para style="q">kse'n jun taq' q'aq' te Dyos!</para>
  <para style="q">
    <verse number="7" style="v" />Lay b'ent tyupetju' tk'u'jlalil</para>
  <para style="q">tu'n a' kyoj kykyaqilju' ninnjab';</para>
  <para style="q">ex lay b'ent tyupit kyu'n tnimal a'.</para>
  <para style="q">Naqwit alkye jun txiq'onte tkyaqilju' tq'inumal</para>
  <para style="q">te t-xelju' tk'u'jlalil,</para>
  <para style="q">jaku'lo b'aj xmayi'n, chij.</para>
  <para style="sp">Kyyol mojtzal</para>
  <para style="q">
    <verse number="8" style="v" />Mixti'te' tal qanab' timi'ẍ.</para>
  <para style="q">¿Ti'tzu'n qse' ti'j ajtul qanb'aj?</para>
  <para style="q">
    <verse number="9" style="v" />Naqwit jun nintapi,</para>
  <para style="q">jaku'wtlo jaw qb'incha'n jun b'o's ja saqpwaq tib'aj;</para>
  <para style="q">naqwit tjpel ja,</para>
  <para style="q">jaku'wtlo tz'ok qktxu'n tu'n tz'len k'ute, chechij.</para>
  <para style="sp">Tyol xu'jilb'aj</para>
  <para style="q">
    <verse number="10" style="v" />Ikqinwe' kse'n jun nintapi,</para>
  <para style="q">aye'tzu'n wimi'ẍe' ikqe' kse'n ja nimaq kywe' te ka'yb'il.</para>
  <para style="q">qu'mtzun toj twitz,</para>
  <para style="q">qa matxi' tz'el yalju' tzalajb'il wu'ne'.</para>
  <para style="b" />
  <para style="q">
    <verse number="11" style="v" />Atitoq jun tawal Salomon ub'a toj B'aal-amon.</para>
  <para style="q">kyej tq'o'n toj kyq'ob' junjun xjal tu'n t-xikyka'yi'n,</para>
  <para style="q">teyiletzun junjun tu'ntoq txi' tq'o'n kab'k'al lajnaq (1,000) saqpwaq te</para>
  <para style="q">aj tjawju' twitz tawal.</para>
  <para style="q">
    <verse number="12" style="v" />Te teju'ya kab'k'al lajnaq (1,000) medi, Salomon,</para>
  <para style="q">atzun lajnaq (100) kyeju' xq'uqil;</para>
  <para style="q">¡atzun nxq'uqinxwe' wawal! chij.</para>
  <para style="sp">Tyol chmilb'aj</para>
  <para style="q">
    <verse number="13" style="v" />¡Q'oma anb'il tu'n t-xinb'i'ne' toj twi'ya,</para>
  <para style="q">t-xu'jil nimaqkawila toj awal!</para>
  <para style="q">¡Kyajb'ilju' qamiw tu'n t-xib'i'na kyu'n! chij.</para>
  <para style="sp">Tyol xu'jilb'aj</para>
  <para style="q">
    <verse number="14" style="v" />¡Ojqelxa nk'u'jlb'e'tz,</para>
  <para style="q">tz'ojqelana kse'n jun msat,</para>
  <para style="q">kse'n jun tal msat</para>
  <para style="q">kywi' witz inxi'x che puk'chaj! chij.</para>
</usx>