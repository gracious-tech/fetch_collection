<?xml version="1.0" encoding="utf-8"?>
<usx version="2.6">
  <book code="JON" style="id">JON Abril 2009 Pedro D. Cabrera Mam Ostuncalco. Updated for DBL by G. Grasso and E. Canales, December 2012, standardization after migration to PT8 by A. Camus March, 2019.</book>
  <para style="h">Jonás</para>
  <para style="toc3">Jon</para>
  <para style="toc2">Jon</para>
  <para style="toc1">Tuj Jonas (Jonás)</para>
  <para style="mt1">TUJ JONAS</para>
  <para style="mt2">(Jonás)</para>
  <para style="imt">CHIK'B'AB'L</para>
  <para style="ip">Aju' u'j lu naq jun tx'olb'ab'l, mikxa'tlu' kse'nqeju' txqantl u'j tz'ib'a'n kyu'nju' t-sanjelal Dyos aj nche' yolin ti'j jun pakb'ab'l. Atzu' nyolina' ti'j Jonas aj mixti'toq japunju' tchaq'b'il Dyos tu'n, tej txi' chq'o'n pakb'alte tyol Dyos kye xjal te Ninib'e tu'n tanjtzti'j kyanmi (cap. 1) Ch'inxtlmi kyima' tu'n tpaj min xitb'incha'n tzajtma'n Dyos te, naqtzun aju' lwiy anjtzti'j tk'u'j ex xi'tzuntz b'inchalte ojetoq tchaq' Dyos te, xi' toju' nintnam ex atzuntzu' xa' tpakb'ana' tyol Dyos kyeju' xjal tu'n tanjtz ti'j kyanmi. Yajxi'tzuntel tzaj ttx'u'jil tu'n tpaj mixti' b'aj kyi'ju' xjal kse'nju' matxitoq txitpakb'a'n, qu'n anjtzna' ti'j kyanmi, qu'mtzun mixti'x kub' tz'e'ysa'n kwitz tu'n Dyos (caps. 2 ex 3). B'ajtzun tzak'u'n tu'n Dyos tuk'i'l jun techlal tu'n tpaj tzaj toj twitz tu'n min kub' tz'e'ysa'n kwitzju' xjal toj Ninib'e.</para>
  <para style="ip">Aju' u'j lu nyolin ti'ju' toklen Dyos nimin kyib'aju' tch'isb'en, expe' nyolin ti'ju' tk'u'jlalil ex tu'nju' ntzaj laqj tk'u'j Dyos kyi'j xjal. Qama tz'anjtz ti'j kyanmi xjal, nkub'najsa'n kyil tu'n Dyos maskyepe' ajq'ojqe' ti'ju' ttanam, ilti'j nche' klet tu'n, na'mxtoq tkub' tz'e'ysa'n kwitz. Tzaj xitb'il toj tnami Jonas tu'n tpaj atzu' ok qeya' tk'u'j tijx tib'xtib', ex tu'n tpaja tzaj laqj tk'u'j Dyos kyi'ju' xjal najlqe' Ninib'e, qu'n atoq tajb'ilju' tu'n lalun che kletju' xjal lu, o'kxtaq tajb'ilju' tu'n kyklet aj Israel.</para>
  <chapter number="1" style="c" />
  <para style="s1">Kub' oq Jonas twitz Qman Dyos</para>
  <para style="p">
    <verse number="1" style="v" />Tzaj yolin Qman Dyos te Jonas, tk'wal Amitay, ex xitma'n te: <verse number="2" style="v" />Kuxtxiya toju' nintnam Ninib'e ex q'manxa kye xjal qa kb'el nxitu'ne' nintnam, qu'n matxi' tzulkanun tqanil nk'etze' ti'ju' kyil.</para>
  <para style="p">
    <verse number="3" style="v" />Atzunte Jonas kub' oq twitz Qman Dyos, mya tu'nwt txi' tb'i'nju' tyol, xi' toj tnam Jope janche pona' txqan b'ark, elyal jun b'ark tu'n ch'inxtltoq txi' toju' tx'otx' Spanya; xi' chjolte iqb'ilte, jaxtzuntz toju' b'ark tu'nt-xi' toju' tx'otx' lu. <verse number="4" style="v" />Atzunte Qman Dyos tzaj tq'o'n jun nin kyq'iq', jawtzun b'ent jun nin q'ankyaq xob'ajilx naku'jtoq kb'ajel xitju' b'ark tu'n. <verse number="5" style="v" />Majx ok jun xob'il kyi'ju' aq'unal toju' b'ark, teyiletzun junjun aq'wi kub'sal teju' tdyos. Kub' kxima'ntzuntz tu'n tku'x kyxonju' iqtz toj ninnjab', noqxwitlo tu'n telju' talal. Atzunte Jonas matxi'toq ku'x ja nche' k'u'yita ti'xti' toju' b'ark, atzuntzu' kub'a' kẍeya' ex majx tzyet tu'n watl b'a'nxi'x. <verse number="6" style="v" />Atzunju' nejenel toju' b'ark ku'x ja ta'toq Jonas, ex xitma'n te: ¡lwix we'ktza ẍwat! ¡Kub'sana te Tdyosa! Qaj nab'en matzajq'aq'an tk'u'j qi'j tu'n qklet tu'n, chij.</para>
  <para style="p">
    <verse number="7" style="v" />Tjawu'lenxi'tzun Jonas kyk'etzju' aq'unal toju' b'ark, intoq kyma'n kxolilex:</para>
  <para style="p">—Qsenx tu'n tel yal alkye ati tpaj tu'nju' myab'a'n saj qi'j, chechij.</para>
  <para style="p">Tetzunj t-xikyse'nti'j, elyal qa a Jonas ati tpaj. <verse number="8" style="v" />Xikyma'ntzuntz te:</para>
  <para style="p">—Q'mantza titiqu'n saja' taq'wix lu qib'aj. ¿Titi'tzun taq'una? ¿Jasaja'ya? ¿Alkye ttx'otx'a? ¿Ja tzajna' tyajila? chechij.</para>
  <para style="p">
    <verse number="9" style="v" />Atzunte Jonas xittzaq'we'n kye:</para>
  <para style="p">—Eb'reyqine', ex nchin k'ulune' te Dyos Manb'aj, Dyos te toj kya'j, b'inchalte ninnjab' ex tx'otx', chij.</para>
  <para style="p">
    <verse number="10-11" style="v" />Xitma'n Jonas kyeju' nche aq'unan toju' b'ark qa intoq oq twitz Dyos Manb'aj, aye'tzunkye tej t-xikyb'i'n, ex tej kyka'yinte ljo'nxi'xtoq tichinju' ninnjab', tzajxi'xtl xob'il kyi'j, xi'kyqani'ntzuntz te:</para>
  <para style="p">—¿Tiqu'n xtb'inchaju'ya lu? ¿Titi' kqb'incha'ye' ti'ja naqx tu'n twe'ju' ninnjab'? chechij.</para>
  <para style="p">
    <verse number="12" style="v" />Chin kyxonku'xe' toj ninnjab', oktzun kb'el nak'ete ninnjab'tzu'. Tu'na' npajwe' saja'ju' nin kyq'iq' kyib'aje', chi Jonas xittzaq'we'n.</para>
  <para style="p">
    <verse number="13" style="v" />Aye'tzunju' aq'unal toju' b'ark, e'aq'wi lmolte b'ark tuk'i'l tkyaqil kyipumal tu'nkyelpun ttzi tx'otx', ex mixti' b'enti kyu'n, qu'n xi'toq tichinxi'xtlju' ninnjab'. <verse number="14" style="v" />E'aq'witzuntz kub'sal twitz Qman Dyos ex kyma: Qman Dyos lalun taja tu'n qkyime' naqx tu'n tpaju' ichan lu. Qatzun mixti' til, lalun tz'ok tq'o'na tkamik te qile', qu'n in aq'unanta Nman Dyos kse'nxju' tajb'ila.</para>
  <para style="p">
    <verse number="15" style="v" />Tb'ajlenxi'tzun kyma'nju' lu, xi'kyxon Jonas toj ninnjab', kub' nak'etzun ninnjab'tzu'. <verse number="16" style="v" />Tetzunj kyka'yinteju' aq'unal toj b'ark tkub' nak'eju' ninnjab', kyna' toj kyanmi tu'n kyniman te Qman Dyos, kub' kyq'o'n chojb'il te, ex xikytziya'n tu'n kyk'ulun te.</para>
  <para style="p">
    <verse number="17" style="v" />Atzunte Qman Dyos matxi'toq kub' tq'o'n jun nin kyiẍ toj ninnjab' tu'n t-xi'tb'ilq'u'n Jonas. Oxe' q'ij ex oxe' qonik'an ten Jonas toj tk'u'ju' kyiẍ.</para>
  <chapter number="2" style="c" />
  <para style="s1">Tna'j Dyos Jonas</para>
  <para style="p">
    <verse number="1" style="v" />Kub'santzun Jonas te Qman Dyos, tzmax toj tk'u'ju' kyiẍ, <verse number="2" style="v" />tma:</para>
  <para style="b" />
  <para style="q">Nkub'sane' teya Nman Dyos toju' yajb'ilweye',</para>
  <para style="q">atzunta ntzaj ttzaq'we'na,</para>
  <para style="q">Tzmax t-xexi' muqb'il te kamik nkub'saniye' teya,</para>
  <para style="q">ex ntzaj ttzaq'we'na.</para>
  <para style="q">
    <verse number="3" style="v" />Nku'x t-xona tzmax t-xe ninnjab',</para>
  <para style="q">ex majx nkyej mulq'aje' tjaq' tnimal a'.</para>
  <para style="q">E ik'ju' nimaq ttolob' a' wib'aje' aju' tzaj tq'o'na.</para>
  <para style="q">
    <verse number="4" style="v" />Oje nna'ye' qa matoq chinetz tiq'i'na twitza;</para>
  <para style="q">ex majxkub' nximane' qa layxtoq tz'ok nka'yi'ntlju'ye' tjaya xjan.</para>
  <para style="q">
    <verse number="5" style="v" />Majx nkyej mulq'aje' tjaq'ju' a';</para>
  <para style="q">majx nku'x naje' t-xe ninnjab';</para>
  <para style="q">b'aj tb'alq'intib'ju' k'ul ti'j nwi'ye' toj a'.</para>
  <para style="q">
    <verse number="6" style="v" />Nku'x mulq'aje' tzmax t-xexi' ninnjab';</para>
  <para style="q">¡kub' nximane' qa majxtoq chin kjeltene' toj tejumajx!</para>
  <para style="q">Atzunta Nman Dyos machin tkola teju' kamik.</para>
  <para style="q">
    <verse number="7" style="v" />Tej nna'nteye' ch'inxtltoq nkyime';</para>
  <para style="q">tzaj nna'na, Nman Dyos;</para>
  <para style="q">japun nna'j dyose' teya toju' tjaya xjan.</para>
  <para style="q">
    <verse number="8" style="v" />Aye'ju' kukx kyk'ulun kyeju' witzileb'</para>
  <para style="q">minti' nche okslantl teya;</para>
  <para style="q">
    <verse number="9" style="v" />ayi'ntzuwe' tuk'i'l b'itz te aq'b'il chjonte,</para>
  <para style="q">che kb'el nq'o'ne' chojb'il twitza;</para>
  <para style="q">che kjapumelju' nyole' xintziya'ne' teya.</para>
  <para style="q">¡O'kxna'ta Nman Dyos, nkolon!</para>
  <para style="b" />
  <para style="p">
    <verse number="10" style="v" />Tchaq'tzun Qman Dyos teju' kyiẍ tu'n tjatz t-xa'n Jonas tib'aj tx'otx'.</para>
  <chapter number="3" style="c" />
  <para style="s1">Anjtzti'j kyanmi xjal toj Ninib'e</para>
  <para style="p">
    <verse number="1" style="v" />Tzaj yolin jumajtl Qman Dyos te Jonas, ex xitma'n te: <verse number="2" style="v" />Kuxtxi'ya toju' nintnam Ninib'e ex pakb'anxa kye aju' kxe'l nma'ne' teya.</para>
  <para style="p">
    <verse number="3-4" style="v" />Xi'tzun Jonas Ninib'e, kse'nxju' tchaq' Qman Dyos te. Nintnam toqte Ninib'e, te oxe' q'ij qb'e tu'n tb'aj qb'eti'n. Okx Jonas toju' nintnam, b'et jun q'ij q'malte tuk'i'l tq'ojq'ojel twi' kuw: ¡Kb'el xitu'nte' Ninib'e ajtjapun kab'naq q'ij! chij.</para>
  <para style="p">
    <verse number="5" style="v" />Aye'tzu'n xjal toju' nintnam, nimaq kyoklen ex ch'i'n kyoklen, eb'aj okslan te Qman Dyos, etz jun tqanil kyu'n tu'n kymewayin ex okkyq'o'n kyi'j jochin te b'is. <verse number="6" style="v" />Tetzunj tpon tqanil teju' nimaqkawil te Ninib'e, ex ikxte jawe' toju' tq'uqb'il te tkawb'il, eb'je'l tiq'i'nju' ti'j te oklenj, ex oktq'o'n ti'j jochin te b'is ex kub' qe toj tza'j. <verse number="7" style="v" />Etztzun tq'o'n nimaqkawil jun chaq'b'il toj tkyaqilju' nintnam, kjalu: Mix-a'lo' jun tu'n twan. Ex mixti' tu'n txi' q'et kwaju' wakx ex rit. <verse number="8" style="v" />Kyq'onk kyi'je' jochin ex che kyktxunqe'me' kyalu'ne' tu'n xb'alun jochin te yek'b'il k'ixk'oj, ex che kub'sane' twitz Qman Dyos tuk'i'l tkyaqil kyipumale'. Kytzaqpinkju'ye' taq'wix nkyb'incha'ne' ja'lo teyile junjun; <verse number="9" style="v" />qape' jaku' kub' tnajsa'n Qman Dyos qil ex qaj nkub'ku' tk'u'j, laytzun qokyimtzu', chij.</para>
  <para style="p">
    <verse number="10" style="v" />Tzaj tka'yi'n Qman Dyosu' ntoq kyb'incha'n xjal aj Ninib'e exqa ntoq kyej kytzaqpi'n kyb'inchb'aj taq'wix, kub't-xima'n tu'n lalun tzaj tq'o'ntlju' taq'wix kyib'aj kse'n ojetoq tma kye.</para>
  <chapter number="4" style="c" />
  <para style="s1">Tzaj ttx'u'jil Jonas ti'j Dyos</para>
  <para style="p">
    <verse number="1" style="v" />Tzaj ttx'u'jil Jonas tu'n tpaju' tb'incha Qman Dyos ikju', ex min kub' toj twitz. <verse number="2" style="v" />Qu'mtzun kub'ten na'l Dyos ex xitma'n te:</para>
  <para style="p">—Nman Dyos, ikyna'tzun nmaju'ye' lu tej tinqinxtoqe' toj ntx'otx'e' qa ikytoq kb'ajelju'. Qu'npe'na' lwiy nxi' oqe' toj tx'otx' Spanya, qu'n b'i'nxi'x wu'ne' lwiy ntzaj q'aq'an tk'u'ja, ex mya lwiy ntzaj ttx'u'jila, ex b'i'n wu'ne' nimxi'x tk'u'jlalila, qu'n ntpakb'a'n jun tz'e'ysb'ilwitzb'aja, ex lwiy najtzti'j tk'u'ja. <verse number="3" style="v" />Qu'mtzun Nman Dyos, nchin kub'sane' teya tu'n nkub' tb'yo'na. Ate b'a'nju' tu'n nkyime' kyetwitz tu'n wanq'ine', chij.</para>
  <para style="p">
    <verse number="4" style="v" />Atzunte Qman Dyos tzaj ttzaq'we'n te:</para>
  <para style="p">—¿Ma atzun b'a'n toj twitza tu'n ttx'u'jina? chij.</para>
  <para style="p">
    <verse number="5" style="v" />Etztzun Jonas toju' nintnam ex kub'ten toj tjawetzq'ij teju' nintnam; kub' tb'incha'n jun t-xmuj atzu' ex kub' qe tjaq'ju' tewun, intoq nayon titi' kb'ajel ti'ju' nintnam. <verse number="6" style="v" />Atzunte Qman Dyos tb'incha tu'n ttzaj ch'iy junwi' tze tu'n ttenxi'xtl t-xlekun Jonas, tu'ntzun tten b'a'nxch'i'ntl. Nxi'xtoq tzalaj Jonas ti'ju tal wi' tze lu. <verse number="7" style="v" />Tetzunj qsqix te juntl q'ij, tb'incha Qman Dyos tu'n tokten jun xton walteju' wi' tze, ex kub' tzqij tu'n. <verse number="8" style="v" />Tetzunj tjawu'l q'ij, tzaj tq'o'n Qman Dyos jun kyq'iq' moq'moj toj tjawetzq'ij, tu'ntzun yalxju' q'ij toj twi' Jonas, tna' Jonas qa majxtoq kb'el numj ex tajb'iltoq tu'n tkyim.</para>
  <para style="p">—Masb'a'n tu'n nkyime' kyetwitz tu'n wanq'ine', chij intoq tma'n.</para>
  <para style="p">
    <verse number="9" style="v" />Atzunte Qman Dyos xittzaq'we'n te:</para>
  <para style="p">—¿Ma b'a'n toj twitza tu'n ttzaj ttx'u'jila naq tu'nju' makub' tzqiju' wi' tze?</para>
  <para style="p">—¡B'a'na'tzun nela' toj nwitze'! ¡Naq ch'i'naqx min chin kyimaye' tu'n ntx'u'jile'!, chi Jonas xittzaq'we'n te Dyos.</para>
  <para style="p">
    <verse number="10" style="v" />Atzunte Qman Dyos xitma'n te:</para>
  <para style="p">In pena' nexch'yonta jun tal wi' tze toj tk'u'j, extzun myaya xi' awante ex mya tu'na xch'iya'; toj junx qonik'an xch'iya' ex toj juntl xkub'a' tzqij. <verse number="11" style="v" />¿Ma laytzun b'ajxwe' nk'u'j ti'ju' Ninib'e, jun nintnam nintzku' ja ta'qe' kab'mutx' lajk'al (20,000) xjal mixti' b'i'n kyu'n se'n tu'n kykleta', ex nim txqan kyalu'n? chi Dyos.</para>
</usx>