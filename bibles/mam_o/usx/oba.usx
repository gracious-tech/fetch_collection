<?xml version="1.0" encoding="utf-8"?>
<usx version="2.6">
  <book code="OBA" style="id">OBA.TXT Febrero 2009 Pedro D. Cabrera Mam Ostunkalko. Updated for DBL by G. Grasso and E. Canales, December 2012, standardization after migration to PT8 by A. Camus March, 2019.</book>
  <para style="h">Abdías</para>
  <para style="toc3">Abd</para>
  <para style="toc2">Abd</para>
  <para style="toc1">Tuj Ab'diy (Abdías)</para>
  <para style="mt1">TUJ AB'DIY</para>
  <para style="mt2">(Abdías)</para>
  <para style="imt">CHIK'B'AB'L</para>
  <para style="ip">Aju' b'o's tpakb'alil tku'x toju' u'j lu nyolin ti'ju' kyb'inchb'aj aj Edom kyi'j aj Juda, kyjonku'xi'x tej tkub'ti'j Jerusalen ex tej tkub' xitu'n, myanaq o'kx e'onin kyuk'i'l ajq'oj ex eb'aj tzalaj tej kykub'o'lju' aj Juda, qu'n ex b'je'x kyalq'a'nju' atitoq toju' nintnam ex kub' kytzyu'n jni'ju' tx'otx'. Xitma'n Ab'diy tqanil qa tzul tz'e'ysb'il kywitz aj Edom tu'n tpaju' kyb'incha lu (vs. 1-14) exqa ch'inxtltoq tul q'ij tu'n ttz'e'yset twitzju' tnam lu, aye'tzunkye aj Juda kb'anteltoq jumajtlju' kytanam (vs. 15-21).</para>
  <chapter number="1" style="c" />
  <para style="s1">Tz'e'ysb'il twitz Edom</para>
  <para style="p">
    <verse number="1" style="v" />Tzaj tyek'u'n Qman Dyos tpakb'alil te Ab'diy kjalu.</para>
  <para style="b" />
  <para style="q">Maqb'i jun tpakb'alil tu'n Qman Dyos;</para>
  <para style="q">matxichq'o'n jun sanjelal q'malte kye nimaqtnam kjalu:</para>
  <para style="q">¡Lwiyqe'xe'! ¡Qo'qe' q'ojil ti'j Edom! chij.</para>
  <para style="b" />
  <para style="q">Intma'n Qman Dyos kye aj Edom kjalu:</para>
  <para style="q">
    <verse number="2" style="v" />Che b'el nb'oẍsa'ne' kyxol nimaqtnam</para>
  <para style="q">ex che elel ik'u'ne' b'a'nxi'x kyu'n.</para>
  <para style="q">
    <verse number="3" style="v" />Tu'nx kyninb'ilkyib'e' ẍesb'eta'ye'.</para>
  <para style="q">Najlqe'ye' kyoj kyk'atxab' pik</para>
  <para style="q">ex ate'qe'kxe' tzmax jawl,</para>
  <para style="q">qu'mtzun nkub' kyxima'ne'</para>
  <para style="q">qa mix-a'lo'x jun kb'elsalte kyi'je'.</para>
  <para style="q">
    <verse number="4" style="v" />B'a'ntzun qama che jaw lq'eye' kse'n q'anjel</para>
  <para style="q">ex makub' kyq'o'n kyjaye' kyxol che'w,</para>
  <para style="q">tzmaxtzuntzu' che tzajela' nxone' na'tz, chi Dyos.</para>
  <para style="b" />
  <para style="q">Chi Qman Dyos kjalu:</para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" />Naqwit qonik'an che ok eleq' kyi'je',</para>
  <para style="q">lay b'ent tu'n txikyiq'i'n tkyaqil ati kyeye';</para>
  <para style="q">naqwit che ul xilul ub'a kyi'je',</para>
  <para style="q">okx kjel kyq'o'n jte' tq'ob' ub'a tuk'i'l twitz.</para>
  <para style="q">Aye'tzunkye' kyajq'oje'</para>
  <para style="q">majx che b'elb'ajsa'ne' kyu'n.</para>
  <para style="q">
    <verse number="6" style="v" />¡Majx che b'je'lel iq'i'n kyeye', tyajajil Esawu!</para>
  <para style="q">¡Kb'ajxel elq'a'n tkyaq'ilju' kyq'inumale'!</para>
  <para style="q">
    <verse number="7" style="v" />Che b'el sb'u'ne' kyu'n kykyaqilju' mojli kyole' kyuk'i'l,</para>
  <para style="q">tojku' kytx'otx'e' che eletza' xla'ja'ne' kyu'n.</para>
  <para style="q">Naq pe'naqe' kamiwe'</para>
  <para style="q">che okyel miltz'uj kyi'je',</para>
  <para style="q">exqe' kamiwe' q'uqli kyk'u'je' kyi'j kb'el kyq'o'n xpatxab' kyeye'.</para>
  <para style="q">¡Mixti'x nche ximane' aj Edom! chi Dyos.</para>
  <para style="b" />
  <para style="q">
    <verse number="8" style="v" />Intma'n Qman Dyos kjalu:</para>
  <para style="q">Ajtkub' ntz'e'ysa'ne' kywitz aj Edom,</para>
  <para style="q">che kb'el nb'yo'ne' kykyaqilju' kyxjal ati kynab'l</para>
  <para style="q">ex k'elel wiq'i'ne' kyk'atzal xjal</para>
  <para style="q">najlqe' kywi' witz kye tyajajil Esawu.</para>
  <para style="q">
    <verse number="9" style="v" />K'okyeltchi kyi'ju' xjal aj Teman q'ojilqe',</para>
  <para style="q">ex mix-a'lo'tlte kjel anq'in</para>
  <para style="q">toj kytx'otx' tyajajil Esawu kywi' witz.</para>
  <para style="s1">Aye' til Edom</para>
  <para style="q">
    <verse number="10" style="v" />Tu'n tpaj e'kub' kyalq'a'ne' ex e'kub' kyb'yo'ne' tyajajil Jakob' ju' kytzikye'</para>
  <para style="q">k'elel kych'ixawe' ex che kjel xitu'ne' tejumajx.</para>
  <para style="q">
    <verse number="11" style="v" />Tej tokx kypa'n najchaq xjal te q'oj</para>
  <para style="q">tjpel Jerusalen</para>
  <para style="q">tej tb'ajx kyelq'a'n ajq'oj q'inumal toju' nintnam,</para>
  <para style="q">¡naq exika'yine' ti'j!</para>
  <para style="q">Tej t-xikyse'n tu'n telkynik' alqechaq kxe'la' b'je'x kyalq'q'a'n</para>
  <para style="q">ex b'ajx kyiq'i'n kyq'inumal aj Jerusalen,</para>
  <para style="q">¡ikx kyb'inchaju'ye' kse'n kyb'incha!</para>
  <para style="q">
    <verse number="12" style="v" />Miwtlojun e'tzalaje' kyi'ju' kytzike'</para>
  <para style="q">toju' tq'ijlalil kykub'o'lj,</para>
  <para style="q">exwitlo min e'tzalaje' ti'j Juda</para>
  <para style="q">toju' q'ij tej tkyaj xitu'n,</para>
  <para style="q">exwitlo min e'xmayine' kyi'j</para>
  <para style="q">tej intoq che oq'.</para>
  <para style="q">
    <verse number="13" style="v" />Mixwitloti' e'okxe' toju' nintam weye'</para>
  <para style="q">tej kyok toj yajb'il,</para>
  <para style="q">exwitlo min e'tzalaje' tej kykub'o'lj</para>
  <para style="q">toju' tq'ijlalil tej kyk'ulb'an,</para>
  <para style="q">exwitlo min b'je'x kyalq'a'ne' kyq'inumal</para>
  <para style="q">tej inxi'xtoq che yajlanjtz.</para>
  <para style="q">
    <verse number="14" style="v" />Mixwitloti' e'kub'we'ye' kyoj xky'ichb'e</para>
  <para style="q">tu'n kykub' kyb'yo'ne' ntoq che'x oq,</para>
  <para style="q">exwitlo min e'pon kyq'o'ntle' intoq che matxitoq che oq</para>
  <para style="q">toju' q'ij intoq che oq'.</para>
  <para style="q">
    <verse number="15" style="v" />Ikx kb'inchetelju' teya kse'n tb'inchaya kye txqantl:</para>
  <para style="q">¡kb'el tz'e'yset twitza tojx tila!</para>
  <para style="s1">Ninb'ilkye aj Israel</para>
  <para style="q">Matxi' tzul lq'e tq'ijlalil Qman Dyos</para>
  <para style="q">kye kykyaqil nimaqtnam.</para>
  <para style="q">
    <verse number="16" style="v" />K'axi'xna' xkyk'waye' aj Israel</para>
  <para style="q">ju' ẍek'wane' ti'j twi' witz xjan,</para>
  <para style="q">ikxtzunkye' txqantl nimaqtnam</para>
  <para style="q">kxel kyk'wa'n tkyaqil;</para>
  <para style="q">ex majx che b'elnajsa'n.</para>
  <para style="q">
    <verse number="17" style="v" />Atzunte' witz Syon k'okyel te najb'il xjan</para>
  <para style="q">ja che kletela' junjun toj.</para>
  <para style="q">Ktzyetel jumajtl kytx'otx'ju' tyajajil Jakob';</para>
  <para style="q">
    <verse number="18" style="v" />che okyel kyyajajil Jakob' ex Jse</para>
  <para style="q">te q'aq' ex taq' q'aq',</para>
  <para style="q">aye'tzu'n tyajajil Esawu, maj che okyila'</para>
  <para style="q">majx che b'ajel tu'n q'aq' lu.</para>
  <para style="q">¡Mix-a'lo'x jun tyajajil Esawu ktzaq'pajel!</para>
  <para style="q">Ayine' Dyos Manb'aj nchin q'mante, chi Dyos.</para>
  <para style="p">
    <verse number="19-20" style="v" />Kytzyu' aj Israel ate' Nekeb' kytx'otx' toj kyk'ul tyajajil Esawu, aye'tzu'n ate' toju' plan tx'otx' kb'el kytzyu'n kytx'otx' pilistey. Ex kytzyu' kytx'otx' toju' kye tyajajil Eprayin ex toj kyatx'otx' aj Samarya, aye'tzu'n tyajajil B'enjamin kb'el kytzyu'n Kalaad. Kytzyu' tnam xjal aj Israel b'je'xni xla'ja'nqe' lu kytx'otx' aj Kanaan, kpomelx toj tnam Sarepta, aye'tzu'n aj Jerusalen yaju'nqe' toj Separad che tzyulkye nimaqtnam Nekeb'. <verse number="21" style="v" />Che jawix twi' witz Siyon matxitoq che kanb'n, tu'n kymante tz'e'ysb'il kywitzju' witz toj kytx'otx' tyajajil Esawu, ex aku'te Qman Dyos kkawil.</para>
</usx>