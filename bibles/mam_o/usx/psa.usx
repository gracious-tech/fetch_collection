<?xml version="1.0" encoding="utf-8"?>
<usx version="2.6">
  <book code="PSA" style="id">PSA.TXT Febrero 2009 Pedro D. Cabrera Mam Ostuncalco. Updated for DBL by G. Grasso and E. Canales, December 2012, standardization after migration to PT8 by A. Camus March, 2019.</book>
  <para style="h">Salmos</para>
  <para style="toc3">Sal</para>
  <para style="toc2">Sal</para>
  <para style="toc1">Kyu'jil B'itz (Salmos)</para>
  <para style="mt1">E' B'ITZ</para>
  <para style="mt2">(Salmos)</para>
  <para style="imt">CHIK'B'AB'L</para>
  <para style="ip">Aju' u'j Salmos a b'itzb'ilju' ex kyu'jil na'j Dyos toj Tyol Dyos. A in ajb'enju' nimxi'x toj kyokslab'l aj Juda ex kyu'n okslal ti'j Krist toj kyk'u'lb'il kyoju' tab'q'iyil matxi' tzaj. Expe' ajun u'j ja'lu tku'qe'x k'loj tb'anilxim te okslab'l toj, kyxolu' chukchaq u'j tz'ib'a'nqe' tzmax toju' tq'ijlalil ja'lo.</para>
  <para style="ip">Wuqnaq lajoj (150) b'itz tz'ib'a'n toju' u'j lu, aq'pu'nqe' toj jwe' nimaqk'loj mujqa u'j: tnejel u'j, jun tzmax kab'naq jun (1-41); tkab' u'j, kab'naq kab'e' tzmax oxnaq kab'lajoj (42-72); toxi'n u'j, oxnaq oxlajoj tzmax kyajnaq b'eljoj (73-89); tkyaji'n u'j, kyajnaq lajoj tzmax jo'naq qaq (90-106); tjwe'yi'n u'j, jo'naq wuq tzmax wuqnaq lajoj (107-150).</para>
  <para style="ip">Atl junjunju' u'j lu nche ponb'aj tuk'i'l jun b'itz ajwalb'ilte Qman Dyos, b'a'npunju' tz'ib'ankye toj jun tq'ijlalil nimtoj.</para>
  <chapter number="1" style="c" />
  <para style="ms">Tnejel U'j</para>
  <para style="mr">(E' b'itz <ref loc="PSA 1-41">1—41</ref>)</para>
  <para style="s1">Jun tzalajb'il axxi'x</para>
  <para style="q">
    <verse number="1" style="v" />Tzalajb'il teju' xjal</para>
  <para style="q">min nxitb'i'n kynab'lju' b'inchal myab'a'n,</para>
  <para style="q">ex min nb'et toj kyb'e aj il,</para>
  <para style="q">ex min nkub' qe la'jil kyxolju' xjal nche xmayin ti'j Dyos,</para>
  <para style="q">
    <verse number="2" style="v" />o'kxtzu' ntzalaja' ti'j tkawb'il Qman Dyos</para>
  <para style="q">nximan ti'j q'ijtl ex qonik'an.</para>
  <para style="q">
    <verse number="3" style="v" />Ikyte xjal ja'lu kse'n junwi' tze</para>
  <para style="q">awa'n ttzi jun nin a',</para>
  <para style="q">intq'o'n twitz tojxi'x tq'ijlalil</para>
  <para style="q">ex min nkub' tzqiju' t-xaq.</para>
  <para style="q">¡Tkyaqilju' ntb'incha'n, b'a'n nnela'!</para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" />Aye'tzu'n b'inchal myab'a'n mikxa' nb'ajkyeju',</para>
  <para style="q">qu'n ikyqe'ju' kse'n mu'p, nxi' iqa'n tu'n kyq'iq'.</para>
  <para style="q">
    <verse number="5" style="v" />Layx che kletju' b'inchal myab'a'n ajkyok toj xjel tu'n Dyos;</para>
  <para style="q">ex lay che ten aj il kyxolju' tnik'alkyi'j.</para>
  <para style="q">
    <verse number="6" style="v" />Ate Qman Dyos xq'uqilkyeju' tnik'alkyi'j toj kyb'e,</para>
  <para style="q">aye'tzu'n b'inchal myab'a'n tojxju' kyb'e che b'ajela', chiju' b'itzal.</para>
  <chapter number="2" style="c" />
  <para style="s1">Nk'wal ta</para>
  <para style="q">
    <verse number="1" style="v" />¿Titiqu'n njawa' kyiq'i'n kyib'ju' tnam min ojtzqi'n Dyos kyu'n?</para>
  <para style="q">¿Titiqu'n nkub' kynk'u'na' jun kyxim myab'a'n?</para>
  <para style="q">
    <verse number="2" style="v" />Min kyajb'ilju' nimaqkawil exqe' nche kawin twitz tx'otx'</para>
  <para style="q">tu'n kyniman te Qman Dyos,</para>
  <para style="q">ex nkyb'u'yi'nkyib' tu'n kyq'ojin ti'j Dyos ex ti'ju' nimaqkawil sk'o'ntl tu'n.</para>
  <para style="b" />
  <para style="q">
    <verse number="3" style="v" />Ex inkyma'n:</para>
  <para style="q">¡Qiq'imilju' kyxpatx'k'uxb'il qi'j!</para>
  <para style="q">¡Ex qpjumilju' k'alb'ilqe kyu'n!, chechij.</para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" />Naq nxmayinte Qman Dyos kyi'j,</para>
  <para style="q">naq nche jawttze'nju' nkawin toj kya'j;</para>
  <para style="q">
    <verse number="5" style="v" />tuk'i'ltzun ttx'u'jil nche'x t-xob'tza'n;</para>
  <para style="q">ex tuk'i'l tq'oj nxitma'n kye:</para>
  <para style="q">
    <verse number="6" style="v" />Matxi' tz'ok nq'o'ne' nimaqkawil</para>
  <para style="q">tib'aj Syon, aju' witz xjan, chij.</para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" />Kxe'l nma'ne' tma Qman Dyos tu'n tb'inchet,</para>
  <para style="q">tzaj tma'n weye': aya nk'wale';</para>
  <para style="q">mank'waliya ja'lo.</para>
  <para style="q">
    <verse number="8" style="v" />Qaninqe'tzju'ya tnam weye' tu'n kyxi' nq'o'ne' te tetzb'ila,</para>
  <para style="q">ex tkyaqilju' twitz tx'otx',</para>
  <para style="q">che kxe'l nq'o'nwe' teya.</para>
  <para style="q">
    <verse number="9" style="v" />Che b'elt-xitu'na kawil twitz tx'otx' tu'n jun b'ar k'uxb'il;</para>
  <para style="q">¡Majx che b'elttxiju'na kse'n jun tx'otx' k'wil!</para>
  <para style="b" />
  <para style="q">
    <verse number="10" style="v" />Kaneku' toj kywitze' nimaqkawil kyib'aj xjal</para>
  <para style="q">¡kyknome' xnaq'tzb'il lu e'kawil twitz tx'otx'!</para>
  <para style="q">
    <verse number="11" style="v" />Che ajb'enqe'ye' te Qman Dyos tuk'i'l tchiylal;</para>
  <para style="q">che k'ulun qe'ye' te tuk'i'l ninb'il.</para>
  <para style="q">
    <verse number="12" style="v" />Che tzipeku'ye' twitz tuk'i'l xob'ajil,</para>
  <para style="q">qu'n jaku' tzaj ttx'u'jil jaku'tzun che b'ajtzu'ye' toj b'e,</para>
  <para style="q">qu'n lwiy ntzajte Qman Dyos tq'oj.</para>
  <para style="b" />
  <para style="q">¡Tzalajb'ilte' kyeju' q'uqlok kyk'u'j ti'j! chiju' b'itzal</para>
  <chapter number="3" style="c" />
  <para style="s1">Na'j Dyos qanb'il o'nb'il te Qman Dyos</para>
  <para style="q">
    <verse number="1" style="v" />Nimu' wajq'oje, Nman Dyos,</para>
  <para style="q">nimqe' matxi' che b'jo'k miltz'uj wi'je',</para>
  <para style="q">
    <verse number="2" style="v" />¡nim xjal inq'mante wi'je':</para>
  <para style="q">Mixti'tlte' kolb'ilte tu'n Dyos! chechij.</para>
  <para style="b" />
  <para style="q">
    <verse number="3" style="v" />Atzunta Taye,</para>
  <para style="q">aya klol weye' b'a'nxi'x,</para>
  <para style="q">nim woklene' tu'na,</para>
  <para style="q">aya in kuwsante wanmiye'.</para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" />Njaw tq'ojq'ojel nwi'ye' tu'n nqanin o'nb'ile' te Qman Dyos</para>
  <para style="q">ex nchin tzaj ttzaq'we'ne' tzmajx twi' witz xjan.</para>
  <para style="q">
    <verse number="5" style="v" />Ajnkub' kẍeye' ex ajwik'wtane', ex ajttzaj nna'n wib'e',</para>
  <para style="q">ate Qman Dyos xq'uqilweye'.</para>
  <para style="q">
    <verse number="6" style="v" />Min nchin xob'e' kyeju' tnam xjal</para>
  <para style="q">txoli'nkyib' wi'je' tu'n kyok tzaqpaj wi'je'.</para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" />¡Iq'i'nktz tib'a Taye!</para>
  <para style="q">¡Chin tkloma, Nman Dyos!</para>
  <para style="q">Poq'ima kywitzju' wajq'oje;</para>
  <para style="q">¡q'uchimitza kywitzte b'inchal myab'a'n!</para>
  <para style="q">
    <verse number="8" style="v" />Aya Nman Dyos inkolon;</para>
  <para style="q">¡ky'iwlanku'ya ttanama! chiju' b'itzal.</para>
  <chapter number="4" style="c" />
  <para style="s1">Tu'n tqe qk'u'j ti'j Qman Dyos</para>
  <para style="q">
    <verse number="1" style="v" />Nman Dyos klol weye',</para>
  <para style="q">¡chin ttzaq'wetza ajntxokone' teya!</para>
  <para style="q">Aya klonweye', tej intoq chin yajtiye',</para>
  <para style="q">¡q'aq'antz tk'u'ja wi'je' ex b'intzju'ya nna'j Dyose'!</para>
  <para style="b" />
  <para style="q">
    <verse number="2" style="v" />Aye'ye', nkynima'n kyib'e',</para>
  <para style="q">¿ma kukx wel kyik'o'nju'ye'?,</para>
  <para style="q">¿makukxju' kyu'ne'</para>
  <para style="q">kyajb'ile' tu'n kyjyonteye'</para>
  <para style="q">mixti' tajb'en?</para>
  <para style="q">
    <verse number="3" style="v" />Tz'elku' kynik'e' qa nche tk'u'jla'n Qman Dyosju' xjal nche niman te;</para>
  <para style="q">tz'elx kynik'e' inchin tzaj ttzaq'we'nwe' Qman Dyos ajnkub'sane' te.</para>
  <para style="q">
    <verse number="4" style="v" />¡Che xob'xe' ex lalun che b'inchantl ile'!</para>
  <para style="q">Ajkykub' kẍeye', tkyaqil nak'litl,</para>
  <para style="q">kyximanku'xi'xe' titi' nkyb'incha'ne';</para>
  <para style="q">
    <verse number="5" style="v" />Kyq'onxe' chojb'il axxi'x te Qman Dyos</para>
  <para style="q">ex qek kyk'u'je' ti'j.</para>
  <para style="b" />
  <para style="q">
    <verse number="6" style="v" />Nim xjal inkyma'n: ¿Alkye ktzajel yek'unte tzalajb'il qeye'? chechij</para>
  <para style="q">¡Nman Dyos, qo tka'yitza tuk'i'l tk'u'jlalila!</para>
  <para style="q">
    <verse number="7" style="v" />Nimxi'x tzalajb'il saj tq'o'na toj wanmiye'</para>
  <para style="q">kyekwitzju' ati txqan kytriy ex lob'j ub'a.</para>
  <para style="b" />
  <para style="q">
    <verse number="8" style="v" />Inchin kub' kẍeye' ex nchin wtane' toj nak'b'il,</para>
  <para style="q">qu'n o'kxta xq'uqilweye' Nman Dyos, chiju' b'itzal.</para>
  <chapter number="5" style="c" />
  <para style="s1">Na'j Dyos ajqsqix</para>
  <para style="q">
    <verse number="1-2" style="v" />Nman Dyos, b'intzju'ya nyole',</para>
  <para style="q">chin tb'intza ajtjaw tq'ojq'ojel nwi'ye', Nimaqkawil weye'</para>
  <para style="q">b'intzju'ya nkub'sb'ile',</para>
  <para style="q">qu'n teya nchin k'ulna'ye'.</para>
  <para style="b" />
  <para style="q">
    <verse number="3" style="v" />Intzaj tb'i'nju'ya tq'ojq'ojel nwi'ye' te prim;</para>
  <para style="q">qlax inxi' nchik'b'a'n wib'e' teya,</para>
  <para style="q">ex nchin ayone' te ttzaq'web'la.</para>
  <para style="q">
    <verse number="4" style="v" />Qu'n aya Dyos minti' ntzalaj ti'ju' il;</para>
  <para style="q">lay b'ent kyanq'inju' b'inchal myab'a'n tuk'i'la,</para>
  <para style="q">
    <verse number="5" style="v" />exqe'ju' njaw kynima'n kyib' lay che ten twitza.</para>
  <para style="q">Inche el tik'o'nteju'ya b'inchal taq'wix,</para>
  <para style="q">
    <verse number="6" style="v" />inche kub' t-xitu'nju'ya chalyol ex nche el tik'o'nju'ya xmletz' exqe' b'yol wnaq.</para>
  <para style="q">
    <verse number="7" style="v" />Ayintzunwe', kb'antel wokxe' toju' tjaya,</para>
  <para style="q">tu'nju' tk'u'jlalila wi'je';</para>
  <para style="q">¡kb'entel nk'ulune' teya tuk'i'l tkyaqil ninb'il</para>
  <para style="q">tu'n nxi' ka'yine' tu'me'lju' tjaya xjan!</para>
  <para style="b" />
  <para style="q">
    <verse number="8" style="v" />Nman Dyos, chin tiq'ima toju' tnik'alilti'j,</para>
  <para style="q">tu'n lalun chin b'o'lje' kyu'n wajq'oje.</para>
  <para style="q">Chin tiq'inxa toju' b'e b'a'n.</para>
  <para style="q">
    <verse number="9" style="v" />Min nche yolinkye' xjal lu ax;</para>
  <para style="q">¡nojniqe' tu'n taq'wixil!</para>
  <para style="q">Ikykyqulju' kse'n tjulil kyimni k'ab'li;</para>
  <para style="q">¡twi' chalyolju' kyaq'!</para>
  <para style="b" />
  <para style="q">
    <verse number="10" style="v" />¡Tz'e'ysanku'ya kywitz, Nman Dyos!</para>
  <para style="q">¡Xitunku'ya kyxim myab'a'n!</para>
  <para style="q">ik'unqe'mila tu'n tpaju' kyil nim,</para>
  <para style="q">qu'n matxi' jawkyi'nkyib' ti'ja.</para>
  <para style="q">
    <verse number="11" style="v" />Che tzalajxju' q'uqlok kyk'u'j ti'ja;</para>
  <para style="q">che b'itzanx tu'n kytzalajb'il kukxju'</para>
  <para style="q">qu'n aya klol kye.</para>
  <para style="q">Inche tzalaju' inche k'u'jlanteya,</para>
  <para style="q">
    <verse number="12" style="v" />Nman Dyos, nche tky'i'wla'n teju'ya tnik'alkyi'j;</para>
  <para style="q">ex ktxu'milekyi'j tu'na, naku'j tu'n jun kolb'il tu'nju' t-xtalb'ila, chiju' b'itzal.</para>
  <chapter number="6" style="c" />
  <para style="s1">Na'j Dyos toj k'ixk'oj</para>
  <para style="q">
    <verse number="1" style="v" />Nman Dyos,</para>
  <para style="q">lalun chin ttzak'uya tuk'i'l ttx'u'jila,</para>
  <para style="q">lalun kub' ttz'e'ysa'na nwitze' toj tq'oja.</para>
  <para style="b" />
  <para style="q">
    <verse number="2" style="v" />Nman Dyos, q'aq'antz tk'u'ja wi'je',</para>
  <para style="q">qu'n mixti'tl wipumale'.</para>
  <para style="q">Chin tq'anama Nman Dyos,</para>
  <para style="q">qu'n inxi'x ch'yon tkyaqil toj nwinqile'.</para>
  <para style="q">
    <verse number="3" style="v" />¡Nchin lu'lune' tu'n xob'el!</para>
  <para style="q">Nman Dyos, ¿jtojtzun tzula?</para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" />Kutzaja Nman Dyos, ¡chin tkloma!,</para>
  <para style="q">¡chin tkloma tu'n tk'u'jlalila kukxju'!</para>
  <para style="q">
    <verse number="5" style="v" />Mixti' jun xjal kyimnitl tzulwit na'ntla tu'n;</para>
  <para style="q">¿alxi'xwitlokye knimalteya toj muqb'il?</para>
  <para style="b" />
  <para style="q">
    <verse number="6" style="v" />Matxi' chin siktiye' tu'n woq'e'.</para>
  <para style="q">Inxi'x exta'l nkuẍb'ile' tu'n woq'ele' atl junjun qonik'an</para>
  <para style="q">ex nxi'x ex ak' nq'axweye' tu'n ta'l nwitze'.</para>
  <para style="q">
    <verse number="7" style="v" />Matxi' che kub'sjumjixju' nwitze' tu'n k'ixk'oj;</para>
  <para style="q">¡matxi' che kub' b'o'lj naq tu'n kpaju' wajq'oje!</para>
  <para style="b" />
  <para style="q">
    <verse number="8" style="v" />¡Kypa'mil kyib'e' wi'je', b'inchal taq'wix,</para>
  <para style="q">qu'n matxi' tb'ite Qman Dyos woq'ele'!</para>
  <para style="q">
    <verse number="9" style="v" />Matxi' tb'i te Qman Dyos nkub'sb'ile,</para>
  <para style="q">¡matxi' tk'amju' nna'j Dyose'!</para>
  <para style="q">
    <verse number="10" style="v" />Che b'elb'aju' wajq'oje tu'n kyxob'el,</para>
  <para style="q">majx che kb'el ch'ixwi;</para>
  <para style="q">¡naq toj jun kmujx che oqel tu'n kych'ixaw! chiju' b'itzal.</para>
  <chapter number="7" style="c" />
  <para style="s1">Ate Qman Dyos ajkawil tnik'alti'j</para>
  <para style="q">
    <verse number="1-2" style="v" />Nman Dyos, o'kxtzu' in njyo'na'ye' kolb'il tuk'i'la;</para>
  <para style="q">¡chin tkloma kye kykyaqilju' inche jyon wi'je'!</para>
  <para style="q">¡Chin tkloma, qu'n naku'j b'alunqe';</para>
  <para style="q">jaku' chin b'ajkytzaqu'ne'</para>
  <para style="q">ex mix-a'lo' jun klol weye'!</para>
  <para style="b" />
  <para style="q">
    <verse number="3" style="v" />Nman Dyos,</para>
  <para style="q">¿ti'tzu'n matxi' nb'inchaye'?</para>
  <para style="q">¿Mujqa matxi' nb'icha jun nin ile'?</para>
  <para style="q">
    <verse number="4" style="v" />¿Mujqa matxinq'o'ne' jun tu'me'l t-xel taq'wix te jun wuk'i'le' tu'nju' b'a'n xtb'incha weye'?</para>
  <para style="q">¿Mujqa matxi' b'aj nyajla'ne' wajq'oje mya toj tu'me'l?</para>
  <para style="q">
    <verse number="5" style="v" />Qa matxi' nb'inchaye' ikju', b'a'ntzun njyonjtztze' tu'nju' wajq'oje;</para>
  <para style="q">tu'n tkub' wi'je' ex tu'n njowajlaye' tu'n twitz tx'otx',</para>
  <para style="q">ex tu'n tkub' t-xonju' woklene' twitz tx'otx'.</para>
  <para style="b" />
  <para style="q">
    <verse number="6" style="v" />¡Iq'i'nktz tib'a Nman Dyos tuk'i'l ttx'u'jila!</para>
  <para style="q">¡We'ka twitz kytx'u'jilju' wajq'oje!</para>
  <para style="q">qu'n ojena' tchaq'ta tu'n tb'inchetju' tnik'alilti'j,</para>
  <para style="q">¡q'onk tib'a te nxele'!</para>
  <para style="q">
    <verse number="7" style="v" />B'uyinqe'tzju'ya tnam twitza</para>
  <para style="q">ex q'onku'ju'ya tkawb'ila kyib'aj.</para>
  <para style="b" />
  <para style="q">
    <verse number="8" style="v" />Nman Dyos, aya nokq'onkye tnam toj xjel:</para>
  <para style="q">b'inchama tkawb'ila weye' kse'nxju' nb'inchb'aje' b'a'n;</para>
  <para style="q">kanli twitza mixti'we' wil.</para>
  <para style="q">
    <verse number="9" style="v" />Aya Dyos tz'aqli,</para>
  <para style="q">qu'n inxi'x el tnik'a teju' qxime'</para>
  <para style="q">exju' b'is toj qanmiye',</para>
  <para style="q">¡xitunku'ya kyb'inchb'aju' b'inchal myab'a'n,</para>
  <para style="q">atzunju' tnik'alti'j tzyuma tu'n lalun kub' tz'aq!</para>
  <para style="b" />
  <para style="q">
    <verse number="10" style="v" />Awe' kolb'il we aju' Dyos ati jawnixi',</para>
  <para style="q">aju' in klonte xjal mixti' sb'ub'l toj tanmi.</para>
  <para style="q">
    <verse number="11" style="v" />Jun ajkawilte' Dyos tz'aqlixi'x</para>
  <para style="q">inel tik'o'nju' taq'wixil toj tkyaqil tab'q'iyil.</para>
  <para style="q">
    <verse number="12" style="v" />Qa min sanjtz ti'j tk'u'ju' xjal,</para>
  <para style="q">kb'ajel tjqu'n te Dyos tk'uẍtx'e'nb'il;</para>
  <para style="q">naq tu'n txi' ttzaqpi'ntlju' t-smaj,</para>
  <para style="q">
    <verse number="13" style="v" />naq tu'n kyxi' t-xontlju' tch'ut nche jayjon,</para>
  <para style="q">¡matxi' b'ent kytenju' tq'aq' tu'n tb'iyun!</para>
  <para style="q">
    <verse number="14" style="v" />Kyka'yinxpe'ye' b'inchal myab'a'n:</para>
  <para style="q">ati tk'ixk'ojal yab'wnaq ti'j,</para>
  <para style="q">ch'onwi' tu'n taq'wixil</para>
  <para style="q">ex ktala' chajyolil</para>
  <para style="q">
    <verse number="15" style="v" />Matxi' kub' tb'incha'n jun tjul nim t-xe,</para>
  <para style="q">tojxtzunju' tjul kb'elixa' tz'aq.</para>
  <para style="q">
    <verse number="16" style="v" />¡Tib'ajx kb'ela' tz'aqju'</para>
  <para style="q">tb'inchb'en taq'wix ex ttx'u'jil!</para>
  <para style="b" />
  <para style="q">
    <verse number="17" style="v" />Kwajwali'ye' Qman Dyos qu'n tnik'alti'j;</para>
  <para style="q">knb'itza'ye' tb'i Qman Dyos</para>
  <para style="q">aju' ati toj kya'j, chiju' b'itzal.</para>
  <chapter number="8" style="c" />
  <para style="s1">Tajwalil Dyos exu' toklen xjal</para>
  <para style="q">
    <verse number="1" style="v" />Nman Dyos, nimaqkawil qib'aje'</para>
  <para style="q">¡tb'anilxi'xju' tb'iya tib'aj tkyaqil twitz tx'otx'!,</para>
  <para style="q">¡nimxi'x tajwalila tib'ajxi' kya'j!</para>
  <para style="q">
    <verse number="2" style="v" />Inpe' xikyb'itza'n tal k'wal exqe' tal ne'ẍ.</para>
  <para style="q">Jawtb'incha'na jun ja kuwsa'n</para>
  <para style="q">tu'n tkleta kyeju' tajq'oja,</para>
  <para style="q">tu'n tjpet kytziju' nche jawmiltz'uj ti'ja exqe' ajq'oj.</para>
  <para style="b" />
  <para style="q">
    <verse number="3" style="v" />Ajt-xi nka'yi'ne' kya'j kub' tb'incha'na,</para>
  <para style="q">exju' xjaw exqe' che'w e'kub' tq'o'na twitz,</para>
  <para style="q">
    <verse number="4" style="v" />inkub' nxima'ne':</para>
  <para style="q">¿Titi' toklenju' xjal?</para>
  <para style="q">¿Titi'xi'xtzu'n toklenju' wnaq,</para>
  <para style="q">tu'nju' ntzaj tna'na ex nb'ajx tk'u'ja ti'j?</para>
  <para style="q">
    <verse number="5" style="v" />Kub' tb'incha'na naq ch'intlmi kse'n jun anjl,</para>
  <para style="q">okttxoli'na ti'j tu'n oklenj,</para>
  <para style="q">
    <verse number="6" style="v" />kub' tq'o'na tu'n tkawin tib'aju' tb'inchb'ena,</para>
  <para style="q">xitq'o'na toklen tib'aj tkyaqil:</para>
  <para style="q">
    <verse number="7" style="v" />kyib'aj rit ex wakx,</para>
  <para style="q">kyib'aj tojk'ul txkup,</para>
  <para style="q">
    <verse number="8" style="v" />kyib'aj pich' nche' lipan twitz kya'j,</para>
  <para style="q">kyib'aj kyiẍ toj ninnjab',</para>
  <para style="q">¡ex kyib'aj tkyaqilju' ati toj ninnjab'!</para>
  <para style="b" />
  <para style="q">
    <verse number="9" style="v" />Nman Dyos, aya nkawin qib'aje',</para>
  <para style="q">¡tb'anilxi'xju' tb'iya tib'aj tkyaqil twitz tx'otx'! chiju' b'itzal.</para>
  <chapter number="9" style="c" />
  <para style="s1">Ninb'ilte Dyos tu'nju' taq'unb'en</para>
  <para style="q">
    <verse number="1" style="v" />Nman Dyos,</para>
  <para style="q">wajb'ile' tu'n nb'itzane' teya tu'n tkyaqil nk'u'je'</para>
  <para style="q">ex tu'nt-xi nchik'b'a'ne' nim tb'inchb'ena tb'anilxi'x.</para>
  <para style="q">
    <verse number="2" style="v" />Aya atiya toj kya'j,</para>
  <para style="q">naq tu'nela wajb'ile' tu'n nẍch'ine' tu'n tzalajb'il;</para>
  <para style="q">¡wajb'ile' tu'n nb'itzane' b'itz toj tb'iya!</para>
  <para style="b" />
  <para style="q">
    <verse number="3" style="v" />In cheb'aj oqu' wajq'oje twitza;</para>
  <para style="q">inche kub' tz'aq ex nche kyim.</para>
  <para style="q">
    <verse number="4" style="v" />Machin tkola toj tnik'alilti'j:</para>
  <para style="q">nche oktq'o'na xjal toj xjel tojxi'x tu'me'l kukxju' toj tq'uqb'ila.</para>
  <para style="q">
    <verse number="5" style="v" />Matxi' che'x ttzak'u'na nche niman kye txqantl dyos,</para>
  <para style="q">matxi' che kub't-xitu'na b'inchal taq'wix,</para>
  <para style="q">¡matxi' kub' tnajsa'nju'ya kyb'i tejumajx!</para>
  <para style="q">
    <verse number="6" style="v" />Matxi' kyimju' ajq'oj,</para>
  <para style="q">ex matxi' che b'aju' nimaqttanam tuk'i'l;</para>
  <para style="q">aya xkub' xitunkye,</para>
  <para style="q">ex mixti' jun nab'ab'lkye xkyaj.</para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" />Atzunte Qman Dyos nimaqkawil tejumajx;</para>
  <para style="q">makub' tq'o'n tkawb'il tu'n kyok xjal toj xjel tu'n:</para>
  <para style="q">
    <verse number="8" style="v" />kykyaqilu' xjal twitz tx'otx' che okyel tq'o'n toj xjel tojxi'x tu'me'l,</para>
  <para style="q">kb'el ttz'e'ysa'n kywitzju' tnam kse'nxju' kyb'inchb'en.</para>
  <para style="q">
    <verse number="9" style="v" />A Qman Dyos nklonkyeju' nche yajlanjtz;</para>
  <para style="q">inche tklo'n toj tq'ijlalil yajb'il.</para>
  <para style="b" />
  <para style="q">
    <verse number="10" style="v" />Nman Dyos,</para>
  <para style="q">aye'ju' ojtzqilteya q'uqli kyk'u'ju' ti'ja,</para>
  <para style="q">mixti' nche kyej ttzaqpi'nju'ya nche jyon ti'ja.</para>
  <para style="q">
    <verse number="11" style="v" />Che b'itzanqe' b'itze' te Qman Dyos, ju' nkawin toj Syon;</para>
  <para style="q">kymanxe' kye tnam aju' matxi' tb'incha.</para>
  <para style="q">
    <verse number="12" style="v" />Inche tzaj tna'n Dyosju' xjal nche yajti</para>
  <para style="q">ex min in ik'tna'lju' kyb'is tu'n;</para>
  <para style="q">inkub' ttz'e'ysa'n kywitzju' nche b'iyun kye.</para>
  <para style="b" />
  <para style="q">
    <verse number="13" style="v" />Nman Dyos, q'aq'antz tk'u'ja wi'je',</para>
  <para style="q">ka'yintzpe'ya nchin yajtiye' kyu'n ik'ul weye',</para>
  <para style="q">¡chin tiq'imitza ttziju' kamik!</para>
  <para style="q">
    <verse number="14" style="v" />Kxel nma'ntzuntze' kye xjal ttziju' tnam Jerusalen,</para>
  <para style="q">qa o'kxa b'a'n tu'n tjaw nimeta,</para>
  <para style="q">exqa nchin tzalaje' tu'nju' ẍin tkola.</para>
  <para style="b" />
  <para style="q">
    <verse number="15" style="v" />Tojx kyjulju' min nche okslan teya nche ku'xtz'aqa';</para>
  <para style="q">inche kyej q'e'tju' kyqan</para>
  <para style="q">tojxju' kyxpatxab' e'wa'n kyu'n.</para>
  <para style="q">
    <verse number="16" style="v" />Matxi' tyek'utib' Qman Dyos:</para>
  <para style="q">¡tu'nju' tnik'alilti'j xtb'incha!</para>
  <para style="q">Nkyaj jupliju' b'inchal myab'a'n</para>
  <para style="q">tojxju' t-xpatxab' kub'ni tq'o'n.</para>
  <para style="q">
    <verse number="17" style="v" />Che b'ajelkye' b'inchal myab'a'n exqe' nche niman kye txqantl dyos, toj tkawb'il kamik;</para>
  <para style="q">aye' in ik'tna'l Dyos kyu'n;</para>
  <para style="q">
    <verse number="18" style="v" />lay tzik'kyna'lju' prow tu'n,</para>
  <para style="q">ex lay b'aju' q'uqb'ab'l kyk'u'j.</para>
  <para style="b" />
  <para style="q">
    <verse number="19" style="v" />Iq'i'nktz tib'a Nman Dyos;</para>
  <para style="q">lalun taja tu'n tjaw ti'ntib'ju' xjal;</para>
  <para style="q">¡Q'onqe'ka nche niman kye txqantl dyos toj xjel!</para>
  <para style="q">
    <verse number="20" style="v" />Nman Dyos, q'onk tchiylala kye;</para>
  <para style="q">¡q'manxa kye qa naq xjalqe'xi'! chiju' b'itzal.</para>
  <chapter number="10" style="c" />
  <para style="s1">Na'j Dyos qanb'il o'nb'il te Dyos</para>
  <para style="q">
    <verse number="1" style="v" />Nman Dyos, ¿tiqu'n nkyaja' tena najchaq?,</para>
  <para style="q">¿tiqu'n nkub' tewa'ntib'a tojxi'x tq'ijlalil k'ixk'oj?</para>
  <para style="q">
    <verse number="2" style="v" />Aye' xjal b'inchal taq'wix, tuk'i'l nimjtib'il</para>
  <para style="q">nche okten ljoltojkyq'iju' xjal me's;</para>
  <para style="q">¡che kub'xwit tz'aq tu'na Dyos tojx kyxpatxab' kub'ni kyq'o'n!.</para>
  <para style="q">
    <verse number="3" style="v" />Nkynima'n kyib'ju' b'inchal myab'a'n ti'jxju' kyajb'il;</para>
  <para style="q">nche txkon taq'wixu' jamjol, ex nel kyik'o'n Qman Dyos.</para>
  <para style="q">
    <verse number="4" style="v" />Nkynima'n kyib'ju' b'inchal taq'wix, ex min nche jyon ti'ja Dyos.</para>
  <para style="q">Mixti'x nkyq'o'n anb'il tu'n kyximan ti'ja Dyos.</para>
  <para style="q">
    <verse number="5" style="v" />Kukx kych'iyju' toju' nkyb'incha'n.</para>
  <para style="q">Najchaq ta' tkawb'ila kye,</para>
  <para style="q">min nnel kynik' ti'j.</para>
  <para style="q">Nche xmayin kyi'ju' kyajq'oj,</para>
  <para style="q">
    <verse number="6" style="v" />toj kynab'l qa mix-a'lo' kb'elsantekyi'j,</para>
  <para style="q">exqa mixti' che ik'ela'.</para>
  <para style="q">
    <verse number="7" style="v" />Naqx txkoj il e'chaj yolil</para>
  <para style="q">ex wuli'n tokx toj kytzi;</para>
  <para style="q">ajkyyolin nkub' kyewa'n yajb'il ex taq'wix nkyb'incha'n.</para>
  <para style="q">
    <verse number="8" style="v" />Nche kub'ten xq'uqil kyoju' kojb'il,</para>
  <para style="q">ex nche kub' kyb'yo'n xjal mixti' kyil toj ewaj.</para>
  <para style="q">Majx tokkywitz kyi'ju' tal xjal mixti' kolb'ilkye:</para>
  <para style="q">
    <verse number="9" style="v" />naku'jxi'xtej jun b'alun toj tjul,</para>
  <para style="q">nnxq'uqin tzmax toj tewb'il,</para>
  <para style="q">nnayon tu'n txi' t-xontib' kyib'aju' prow,</para>
  <para style="q">ajtzun kytzyet tu'n, nchex tjwo'ntzuntz toj t-xpatxab'.</para>
  <para style="q">
    <verse number="10" style="v" />Nche kub' tz'aqu' mixti' kolb'ilkye toj tq'ob',</para>
  <para style="q">majx nche kub'b'aj tjaq' tipumal.</para>
  <para style="b" />
  <para style="q">
    <verse number="11" style="v" />Chiloju' b'inchal myab'a'n qa matxi' tzik'tna'lju' til,</para>
  <para style="q">exqa ntjpu'nte Dyos twitz ex mintlo'n titi' nb'aj.</para>
  <para style="q">
    <verse number="12" style="v" />¡Iq'i'nktz tib'a Nman Dyos, q'oma te!</para>
  <para style="q">¡Lalun tzik' kyna'lu' nt'uẍjne kyk'u'j tu'na!</para>
  <para style="q">
    <verse number="13" style="v" />¿Nman Dyos, tiqu'n nche xmayina' b'inchal myab'a'n ti'ja,</para>
  <para style="q">tu'nju' nkub' kyxima'n qa lay kub' ttz'e'ysa'na kywitz tu'n tpaju' kyil?</para>
  <para style="q">
    <verse number="14" style="v" />Aku'ya matxi' ka'yinteju' kyil taq'wixi'x;</para>
  <para style="q">¡matxi' tka'yita ex kb'el ttz'e'ysa'na kywitz!</para>
  <para style="q">In kyoqxena'n kyib'ju' mixti' kolb'ilkye tuk'i'la;</para>
  <para style="q">aya nnoninkyeju' meb'a.</para>
  <para style="q">
    <verse number="15" style="v" />¡Xitunku'ya kyipumalju' b'inchal myab'a'n!</para>
  <para style="q">¡Tz'e'ysama kywitz tu'n tpaj tkyaqilju' kyb'inchb'en taq'wix!</para>
  <para style="b" />
  <para style="q">
    <verse number="16" style="v" />Ate Qman Dyos nimaqkawil tejumajx;</para>
  <para style="q">¡che elex t-xla'ja'nju' nche niman kye txqantl dyos ti'jxi' ttanam!</para>
  <para style="q">
    <verse number="17" style="v" />Nman Dyos, intzaj tb'i'nta kyna'j Dyosu' me's,</para>
  <para style="q">intq'uqb'a'na kyk'u'j ex nche tzaj ttzaq'we'na.</para>
  <para style="q">
    <verse number="18" style="v" />B'inchama tnik'alilti'j teju' meb'a ex teju' nyajlanjtz:</para>
  <para style="q">¡tu'ntzun lalun yajuntlu' xjal,</para>
  <para style="q">tzajni ti'j tx'otx'!, chiju' b'itzal.</para>
  <chapter number="11" style="c" />
  <para style="s1">Tu'n tqexi'x qk'u'j ti'j Qman Dyos</para>
  <para style="q">
    <verse number="1" style="v" />Tuk'i'l Qman Dyos nklo'na' we'wib'</para>
  <para style="q">Maskye matzaj q'ma'n weye':</para>
  <para style="q">Kutoqa toj k'ul kse'nkye pich'.</para>
  <para style="q">
    <verse number="2" style="v" />Ka'yinqe'xpe'ju'ya b'inchal myab'a'n:</para>
  <para style="q">inok kyq'o'n tal kysmaj,</para>
  <para style="q">nxikyqinu'n kysmaj</para>
  <para style="q">ex toj ewaj nche tzaja' kysmaji'nju' tnik'alkyi'j.</para>
  <para style="q">
    <verse number="3" style="v" />Qatzun makub' xitj tkyaqilju' tu'me'l chwinqlal,</para>
  <para style="q">¿ti'xi'xti' kb'antel tu'nju' b'a'n xjal?</para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" />Atite Qman Dyos toju' tja xjan,</para>
  <para style="q">ex atzu' ta' tkawb'il toj kya'j,</para>
  <para style="q">in ka'yin b'a'nxi'x,</para>
  <para style="q">titi' nkyb'incha'n xjal.</para>
  <para style="q">
    <verse number="5" style="v" />Nka'yinte Qman Dyos kyi'ju' japumniqe' ex kyi'ju' b'inchal myab'a'n,</para>
  <para style="q">ex majx nche el tik'u'nju' kuw kytx'u'jil.</para>
  <para style="q">
    <verse number="6" style="v" />Ktzajel tq'o'n Qman Dyos q'aq' naku'j jb'al tuk'i'l txtaji'n q'ol,</para>
  <para style="q">kyib'aju' b'inchal myab'a'n,</para>
  <para style="q">ex ktzajel tq'o'n jun kyq'iq' tkyaqil kb'ajel ttz'e'ysa'n.</para>
  <para style="q">¡A Qman Dyos kb'el tz'e'ysante kywitz!</para>
  <para style="q">
    <verse number="7" style="v" />Tz'aqlite Qman Dyos</para>
  <para style="q">ex intk'u'jla'nju' japumniti'j;</para>
  <para style="q">¡qu'mtzun aye' mya xmletz'qe' k'okyel kyka'yi'nku' Qman Dyos!, chiju' b'itzal.</para>
  <chapter number="12" style="c" />
  <para style="s1">Na'j Dyos qanb'il o'nb'il te Dyos</para>
  <para style="q">
    <verse number="1" style="v" />Qo tkloma Nman Dyos, qu'n mixti'qe'tl okslal wa'lqe'xi'x;</para>
  <para style="q">mixti'qe'tlkye xjal ax che yolin.</para>
  <para style="q">
    <verse number="2" style="v" />Nche b'ajchanyol kyxolilex;</para>
  <para style="q">kyexi'x che yolin tuk'i'l xmletz'il.</para>
  <para style="b" />
  <para style="q">
    <verse number="3" style="v" />Nman Dyos,</para>
  <para style="q">xb'oqinqe'ktza xmletz' exqe' nimal kyib',</para>
  <para style="q">
    <verse number="4" style="v" />aye'ju' nkyma'n:</para>
  <para style="q">Yaqi'n petzunte' ati qtziye';</para>
  <para style="q">tu'nqe' qyol nqo' kleta'ye'.</para>
  <para style="q">¿Alxi'xkye kb'el kawinqeye'? chechij.</para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" />A ntma'n Qman Dyos kjalu:</para>
  <para style="q">Ina' che kub' yaju'n prow exqe' mixti' kyipumal</para>
  <para style="q">ex majx jtz'o'nqe'.</para>
  <para style="q">Qu'mtzun kjawil wiq'i'n wib'e' onilkye,</para>
  <para style="q">kse'nxju' kyajb'il, chij.</para>
  <para style="b" />
  <para style="q">
    <verse number="6" style="v" />Slub'in qe'xi'xju' yol kyejni ttziya'n Qman Dyos;</para>
  <para style="q">¡ikyqe'ju' kse'n saqpwaq ẍk'atu'n,</para>
  <para style="q">tzq'ajsa'n wuq maj toj q'aq'!</para>
  <para style="q">
    <verse number="7" style="v" />Aya Nman Dyos kxq'uqil qeye';</para>
  <para style="q">¡kqo tkla'ya kukxju' kyeju' xjal lu!</para>
  <para style="q">
    <verse number="8" style="v" />Jaxjaku' ta'qe'ju' b'inchal myab'a'n</para>
  <para style="q">ex kkyaqilxju' xjal twitz tx'otx' nche niman te taq'wixil, chiju' b'itzal.</para>
  <chapter number="13" style="c" />
  <para style="s1">Na'j Dyos qanb'il o'nb'il</para>
  <para style="q">
    <verse number="1" style="v" />Nman Dyos,</para>
  <para style="q">¿Jtojtzun chin tzaj tna'na?</para>
  <para style="q">¿Ma oktzun k'ik'el nna'le' tu'na tejumajx?</para>
  <para style="q">¿Ma kuxtzun kb'el tewa'n tib'ju'ya nwitze'?</para>
  <para style="q">
    <verse number="2" style="v" />¿Jtojtzun tz'elju' yajb'il toj wanmiye'</para>
  <para style="q">exju' b'is wi'je' tkyaqil q'ij?</para>
  <para style="q">¿Jtoj chin tzaqpete' toj tq'ob'ju' wajq'oje?</para>
  <para style="q">
    <verse number="3" style="v" />Nman Dyos,</para>
  <para style="q">¡chin tka'yitza, chin ttzaq'wentza, spik'b'ama toj nwitze'!</para>
  <para style="q">¡Tu'n lalun chinx tz'aqe' toj watl te kamik!</para>
  <para style="q">
    <verse number="4" style="v" />¡Tu'n lalun tma wajq'oje: Matxi' kub'ti'j wu'ne'! chiwt.</para>
  <para style="q">¡Tu'n lalun tzalaj qama chin kub' tz'aqe'!</para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" />Q'uqliwe' nk'u'j ti'ju' tk'u'jlalila;</para>
  <para style="q">inxi'x chin tzalaje' qu'n aya klol weye'.</para>
  <para style="q">
    <verse number="6" style="v" />¡Kchin b'itzale' teya Nman Dyos tu'nju' b'a'n xtb'incha weye'!, chiju' b'itzal.</para>
  <chapter number="14" style="c" />
  <para style="s1">Kyb'inchb'aj xjal myab'a'n</para>
  <para style="r">(<ref loc="PSA 53">Sal 53</ref>)</para>
  <para style="q">
    <verse number="1" style="v" />Inkyxima'n mixti' kynab'l qa mixti'te Dyos:</para>
  <para style="q">kykyaqil matxi' che b'aj kub' tzpet;</para>
  <para style="q">taq'wixi'xju' nkyb'incha'n;</para>
  <para style="q">¡mix-a'lo' jun nb'inchan b'a'n!</para>
  <para style="q">
    <verse number="2" style="v" />Inka'yintz Qman Dyos tzmax toj kya'j kyib'aju' xjal</para>
  <para style="q">qa ate' junjun ati kynab'l,</para>
  <para style="q">exqa nche jyon ti'j Dyos.</para>
  <para style="q">
    <verse number="3" style="v" />Aye'tzunkye xjal matxi' che b'ajx toju' b'e taq'wix;</para>
  <para style="q">kykyaqilx matxi' che b'aj kub'tzpet.</para>
  <para style="q">¡Mix-a'lo'tl jun nb'inchan b'a'n!</para>
  <para style="q">¡K'i'xpe'wt jun!</para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" />Mixti'x kynab'lju' b'inchal il,</para>
  <para style="q">aye' ate'qe'k kutz'ilkyeju' ntaname' naku'j wab'j kye,</para>
  <para style="q">aye' mixti'x ntzaj kyna'n Qman Dyos.</para>
  <para style="q">
    <verse number="5" style="v" />Kche lu'lulkye' tu'n kyxob'il,</para>
  <para style="q">qu'n atite Dyos kyuk'i'lju' nche okslan te.</para>
  <para style="q">
    <verse number="6" style="v" />Nche xmayin ti'j tb'is tk'u'ju' me's,</para>
  <para style="q">atzunte Qman Dyos nklonte.</para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" />¡Naqwit tzaju' kolb'ilte Israel,</para>
  <para style="b" />
  <para style="q">ti'ju' witz Syon!</para>
  <para style="q">Aj tch'exb'ente Qman Dyos tchwinqlalju' ttanam,</para>
  <para style="q">Che tzalajelju' tyajajil Jakob',</para>
  <para style="q">tkyaqilju' tnam Israel, chiju' b'itzal.</para>
  <chapter number="15" style="c" />
  <para style="s1">Aju' tajb'il Dyos tu'n kyb'inchante xjal</para>
  <para style="q">
    <verse number="1" style="v" />Nman Dyos,</para>
  <para style="q">¿Alkye kb'entel tnajan toju' tjaya xjan?,</para>
  <para style="q">¿alkye knajal twi' witz xjan?</para>
  <para style="q">
    <verse number="2" style="v" />O'kxju' xjal b'a'n tb'inchb'aj ex mixti' ttzakaj;</para>
  <para style="q">ax yolin tu'n tkyaqil tk'u'j;</para>
  <para style="q">
    <verse number="3" style="v" />aju' min nyolin taq'wix ti'j juntl;</para>
  <para style="q">mixti' taq'wixil ntb'incha'n ti'j twnaqil</para>
  <para style="q">ex b'a'n tten tuk'i'l tb'esin;</para>
  <para style="q">
    <verse number="4" style="v" />aju' nnel ik'u'nteju' inel tik'u'n Dyos</para>
  <para style="q">ex nniman kyeju' nche niman te Qman Dyos;</para>
  <para style="q">aju' in japun tyol tu'n, maskye nyajti tu'n tpaj;</para>
  <para style="q">
    <verse number="5" style="v" />aju' inq'on pwaq ch'ex ex min ntqani'n tub'chil;</para>
  <para style="q">aju' min nk'mon medi naqx tu'n tb'o'lju' xjal mixti' til.</para>
  <para style="q">Milo kb'ela' tz'aqu' in nanq'in ikju', chiju' b'itzal.</para>
  <chapter number="16" style="c" />
  <para style="s1">Mixti' juntl etzb'il tb'anilxi'x</para>
  <para style="q">
    <verse number="1" style="v" />¡Chin t-xq'uqima Nman Dyos, qu'n tuk'i'la njyo'na'ye' kolb'ilweye'!</para>
  <para style="q">
    <verse number="2" style="v" />Oje txi' nma'ne' teya:</para>
  <para style="q">Aya Nman Dyos, aya ntzaj q'onte b'a'n weye';</para>
  <para style="q">mixti' juntl kse'n aya.</para>
  <para style="b" />
  <para style="q">
    <verse number="3" style="v" />Nxi'x chin tzalaje' kyu'nju' xjal toju' ntaname'</para>
  <para style="q">o'kxtzu' nche k'uluna' teya,</para>
  <para style="q">
    <verse number="4" style="v" />aye'ju' nche kub' kychmo'n kywitzileb'</para>
  <para style="q">ex nche k'ulun kye tuk'i'l ninb'il.</para>
  <para style="q">¡Milo najchi'j tu'n telwe' chik' wu'n te chojb'il kywitzu' kydyos!</para>
  <para style="b" />
  <para style="q">¡Milo najchi'j tu'n tjaw nma'nwe' kyb'i!</para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" />Nman Dyos, aya wetzb'ile';</para>
  <para style="b" />
  <para style="q">aya nky'i'wlana weye';</para>
  <para style="q">toj tq'ob'a ta'ju' nchwinqlale'.</para>
  <para style="q">
    <verse number="6" style="v" />Achb'ajilxi'xju' nnajb'ile' yab'o'k;</para>
  <para style="q">¡tb'anilxi'xju' etzb'il nk'ame' teya!</para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" />Kjawil nnima'nwe' Qman Dyos, qu'n ate ẍaqlul weye',</para>
  <para style="q">ex nyolin toj wanmiye' kyoj qonik'an tu'n nb'inchanteye' b'a'n.</para>
  <para style="q">
    <verse number="8" style="v" />Majx na'n Qman Dyos wu'ne';</para>
  <para style="q">qa ati Dyos wuk'i'le', lay chin kub' tz'aqe'.</para>
  <para style="q">
    <verse number="9" style="v" />Qu'mtzun nojni wanmiye' tu'n tzalajb'il.</para>
  <para style="b" />
  <para style="q">Kchin anq'ile' q'uqlixi'x nk'u'je',</para>
  <para style="q">
    <verse number="10" style="v" />layna' chin kyej tq'o'na toju' muqb'il,</para>
  <para style="q">¡lay kyej tq'o'na nniman teya toj jul!</para>
  <para style="b" />
  <para style="q">
    <verse number="11" style="v" />Ktzajel tyek'u'na tb'eyil chwinqlal weye'.</para>
  <para style="q">Nim tzalajb'il ati twitza;</para>
  <para style="q">ati tzalajb'il tejumajx tuk'i'la, chiju' b'itzal.</para>
  <chapter number="17" style="c" />
  <para style="s1">Na'j Dyos qanb'il tnik'alilti'j</para>
  <para style="q">
    <verse number="1" style="v" />Nman Dyos, b'intzju'ya nqanb'e'tze' toj tu'me'l,</para>
  <para style="q">b'intzju'ya nkub'sb'ile',</para>
  <para style="q">chin tb'itza,</para>
  <para style="q">qu'n min nchin chanyole'.</para>
  <para style="b" />
  <para style="q">
    <verse number="2" style="v" />¡Aya q'malte qa ktz'e'ysetel nwitze',</para>
  <para style="q">qu'n tojtzqi'nju'ya japumni twitza!</para>
  <para style="q">
    <verse number="3" style="v" />Chik'li twitza aju' xim toj wanmiye';</para>
  <para style="q">in ka'yina wi'je' te qonik'an;</para>
  <para style="q">matzik' twitza wi'je' kse'n tu'n q'aq',</para>
  <para style="q">ex min xknet taq'wixil woje' tu'na.</para>
  <para style="q">B'ajx txa' nma'n jun ti'xti'ye' myab'a'n,</para>
  <para style="q">
    <verse number="4" style="v" />kse'n nkyb'incha'n txqantl;</para>
  <para style="q">matxi' tz'el npa'nwib'e' kyi'ju' jyol q'oj,</para>
  <para style="q">kse'nxju' tchaq'b'ila.</para>
  <para style="q">
    <verse number="5" style="v" />B'ajx tz'ela' npa'nwib'e' ti'j tb'eyila;</para>
  <para style="q">qu'n wa'lqine' toj wokslab'le'.</para>
  <para style="b" />
  <para style="q">
    <verse number="6" style="v" />Nman Dyos, twitza in jawa' tq'ojq'ojel nwi'ye',</para>
  <para style="q">qu'n inchin tzaj ttzaq'we'na;</para>
  <para style="q">chin tb'itza, ex b'intzju'ya nyole'.</para>
  <para style="q">
    <verse number="7" style="v" />Q'ontza jun yek'b'il chik'li ti'ju' tk'u'jlalila,</para>
  <para style="q">qu'n inche tklo'na q'uqlok kyk'u'j ti'ja,</para>
  <para style="q">kyeju' kyajq'oj.</para>
  <para style="q">
    <verse number="8" style="v" />Chin t-xq'uqima kse'n tyuẍil twitza;</para>
  <para style="q">chin tkloma tjaq'ju' t-xlekumal t-xik'a.</para>
  <para style="q">
    <verse number="9" style="v" />Kyeju' b'inchal myab'a'n nche oktzaqpaj wi'je',</para>
  <para style="q">¡kyeju' wajq'oje txoli'nkyib' wi'je' tu'n nkub' kyb'yo'ne'!</para>
  <para style="q">
    <verse number="10" style="v" />Mixti' xtalb'il kyuk'i'l, ajkyyolin inkynima'n kyib';</para>
  <para style="q">
    <verse number="11" style="v" />nqaku' lepchqe'ka' wi'je'</para>
  <para style="q">nche ayon alkye kmuj tu'n nkub' tz'aqe' kyu'n.</para>
  <para style="q">
    <verse number="12" style="v" />Naku'j b'alunqe', inxi'x che elje ti'j kychi'</para>
  <para style="q">nche okxjutze toj kyewb'il</para>
  <para style="q">tu'ntzun nb'aje' kyu'n.</para>
  <para style="b" />
  <para style="q">
    <verse number="13" style="v" />Taye, iq'i'nktz tib'a, ¡ex we'ka kywitz!</para>
  <para style="q">¡B'inchama tu'n kykub' meje twitza!</para>
  <para style="q">Chin tkloma twitzju' b'inchal myab'a'n tu'n tk'uẍtx'e'nb'ila;</para>
  <para style="q">
    <verse number="14" style="v" />Nman Dyos, chin tkloma tuk'i'l tipumala toj kyq'ob';</para>
  <para style="q">¡najsanqeku'ya twitz tx'otx',</para>
  <para style="q">ana' kyetzb'ilju' toju' chwinqlal ja'lo!</para>
  <para style="q">Q'oma anb'il kye tu'n kyjaw q'inumax,</para>
  <para style="q">che wanku' kyk'walj tzmaxi'j ajkyel link'aj,</para>
  <para style="q">expe' tu'n tkyajtentl kyeju' kychman.</para>
  <para style="q">
    <verse number="15" style="v" />Ayintzunwe', okxi'x qeb'ilwe' nk'u'j</para>
  <para style="q">ajtok nka'yi'nku'ye' twitza,</para>
  <para style="q">¡ajttzaj nna'n wib'e' twitza!, chiju' b'itzal.</para>
  <chapter number="18" style="c" />
  <para style="s1">Jun b'itz te kanb'ab'l</para>
  <para style="r">(<ref loc="2SA 22:1-51">2 S 22.1-51</ref>)</para>
  <para style="q">
    <verse number="1" style="v" />Nman Dyos, aya wipumale';</para>
  <para style="q">¡inchin laqje' ti'ja!</para>
  <para style="q">
    <verse number="2" style="v" />Aya klol weye',</para>
  <para style="q">wewb'ile',</para>
  <para style="q">tzaqpil weye',</para>
  <para style="q">Nmane' Dyos,</para>
  <para style="q">aya pik te kolb'il wib'e',</para>
  <para style="q">aya kolb'ilweye',</para>
  <para style="q">aya ipumalj nklonweye',</para>
  <para style="q">jun wewb'ile' tb'anilxi'x.</para>
  <para style="q">
    <verse number="3" style="v" />Nman Dyos, o'kxa b'a'n tu'n tjaw nimeta:</para>
  <para style="q">ajttzaj ntxko'na inchin tklo'na kye wajq'oje.</para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" />Machin b'ajt-xwaku'ne' kamik kyoju' taqwil;</para>
  <para style="q">nna'ye' xob'ajilxju' tipumal.</para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" />Machin b'ajtb'alq'i'ne' kamik kyoju' taqwil;</para>
  <para style="q">¡kxi'toq nxiqititine' tu'n toju' t-xpatxab'!</para>
  <para style="q">
    <verse number="6" style="v" />Ntxoke' Qman Dyos toju' yajb'il,</para>
  <para style="q">xinqani'ne' o'nb'il te,</para>
  <para style="q">ex intzaj tb'i'ne';</para>
  <para style="q">¡ponju' tq'ojq'ojel nwi'ye' tzmax toj tja Dyos!</para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" />Tzajtzun jun nin kyejnajnab'tz twitz tx'otx':</para>
  <para style="q">majxpe' eb'aj yukchi kyq'uqlilju' witz;</para>
  <para style="q">eb'aj yukchi b'a'nxi'x tu'n ttx'u'jil Qman Dyos.</para>
  <para style="q">
    <verse number="8" style="v" />Intoq etz sib' toj ttxa'n,</para>
  <para style="q">atzu'n toj ttzi q'aq' te xitb'il;</para>
  <para style="q">¡b'je'tz t-xon ttxalq'aq' toj ttzi inxi'x ja'yon!</para>
  <para style="q">
    <verse number="9" style="v" />El tjqo'n xb'alun twitz kya'j ex ku'tztzuntz.</para>
  <para style="q">¡Atitoq nimaq tnej muj tjaq' tqan!</para>
  <para style="q">
    <verse number="10" style="v" />Jaxqe tib'aj jun kyerb'in, xi' lik'ik'intzuntz</para>
  <para style="q">tzaj lipantzuntz toj kyq'iq'.</para>
  <para style="q">
    <verse number="11" style="v" />Ajb'enju' qlolj te tewb'il</para>
  <para style="q">exju' q'eqmuj tuk'i'l jb'al,</para>
  <para style="q">naku'j t-xmuj.</para>
  <para style="q">
    <verse number="12" style="v" />Tzaj qoptz'aj jun q'ankyaq tzmax tk'etz;</para>
  <para style="q">ex tzaj saqb'aqun toju' muj ex ttxalq'aq' in ja'yon.</para>
  <para style="b" />
  <para style="q">
    <verse number="13" style="v" />Tb'incha Qman Dyos te jawnixi',</para>
  <para style="q">tu'n tb'injtzu' tq'ojq'ojel twi' ntinun tzmax toj kya'j;</para>
  <para style="q">tzaj tq'o'n saqb'aqun ex ttxalq'aq' njayun.</para>
  <para style="q">
    <verse number="14" style="v" />E'tzaj t-xonju' tq'ankyaq naku'j talsmaj,</para>
  <para style="q">aye'tzu'n wajq'oje eb'aj oq ex eb'ajx slamj.</para>
  <para style="q">
    <verse number="15" style="v" />Kyej q'ancha'lix t-xeju' ninnjab';</para>
  <para style="q">b'aj kyej q'ancha'lixju' tq'uqlil tx'otx'</para>
  <para style="q">tu'nju' tq'ojq'ojel twi' Qman Dyos xob'ajilx,</para>
  <para style="q">tu'nju' tzaj t-xupi'n kuw.</para>
  <para style="b" />
  <para style="q">
    <verse number="16" style="v" />Tzaj tnuqpi'n Qman Dyos tq'ob' weye' tzmax toj kya'j,</para>
  <para style="q">ex in jatz tiq'i'ne' toju' tnimal ninnjab'.</para>
  <para style="q">
    <verse number="17" style="v" />Machin tkole' kyeju' wajq'oje kuwqe'</para>
  <para style="q">aye' ntx'a'lti'j kyk'u'j wi'je' ex nimxi'x kyipumal kye nwitze'.</para>
  <para style="q">
    <verse number="18" style="v" />E' b'jo'k tzaqpaj wi'je' tej nkub' yajtiye',</para>
  <para style="q">atzunte Qman Dyos oninweye':</para>
  <para style="q">
    <verse number="19" style="v" />in jatz tiq'i'ne' tu'n ntzaqpete';</para>
  <para style="q">¡intkole' qu'n intoq chin tk'u'jla'ne'!</para>
  <para style="q">
    <verse number="20" style="v" />Matzaj tq'o'n Qman Dyos tu'me'l t-xel weye'</para>
  <para style="q">tu'nju' b'a'n nchin anq'ina'ye' twitz,</para>
  <para style="q">
    <verse number="21" style="v" />kukxwe' nb'et toj tb'e Qman Dyos;</para>
  <para style="q">¡b'ajx kub'a' nxk'a'yi'nwe' wib' te Nmane' Dyos!</para>
  <para style="q">
    <verse number="22" style="v" />Majx na'nqe' kykyaqilju' tchaq'b'il wu'ne';</para>
  <para style="q">¡mixti' jumaj matxi'wt che elwik'o'ne' tkawb'il!</para>
  <para style="q">
    <verse number="23" style="v" />Nchin b'etwe' mixti' wile' twitz;</para>
  <para style="q">matxi' tz'el npa'nwib'e' ti'ju' taq'wixil.</para>
  <para style="q">
    <verse number="24" style="v" />Matzaj tq'o'n Qman Dyos tu'me'l t-xel weye'</para>
  <para style="q">tu'nju' b'a'n nchwinqlale' twitz.</para>
  <para style="b" />
  <para style="q">
    <verse number="25" style="v" />Nman Dyos, majx atita tuk'i'lju' majx ati tuk'i'la,</para>
  <para style="q">ex b'a'nta tuk'i'lju' xjal b'a'n,</para>
  <para style="q">
    <verse number="26" style="v" />ax tyola tuk'i'lju' xjal ax yolin,</para>
  <para style="q">atzu'n teju' tx'yan tuk'i'l kuwa.</para>
  <para style="q">
    <verse number="27" style="v" />Aya nklonkyeju' me's,</para>
  <para style="q">aye'tzu'n nkynima'n kyib' nche kub' tme'ssa'na.</para>
  <para style="q">
    <verse number="28" style="v" />Nman Dyos, intzaj tq'o'na spik'un weye';</para>
  <para style="q">Nman Dyos, intzaj ttxqo'na spik'un weye' toju' qxopin.</para>
  <para style="q">
    <verse number="29" style="v" />Tu'nju' t-o'nb'ila chin okyel tzaqpaje' q'ojil ti'ju' wajq'oje,</para>
  <para style="q">ex chin okyixe' tib'aju' nintapi kyi'jile nimaqkytanam.</para>
  <para style="b" />
  <para style="q">
    <verse number="30" style="v" />Ttzinunte' tb'eyil Qman Dyos;</para>
  <para style="q">ex b'a'n tu'n tqe qk'u'j ti'ju' yol ntzaj ttziya'n;</para>
  <para style="q">¡Inche tklo'nte Qman Dyos ju' inqe kyk'u'j ti'j!</para>
  <para style="q">
    <verse number="31" style="v" />¿Alkye juntl dyos ti'jxi' Qman Dyos?</para>
  <para style="q">¿Alkye juntl dyos jaku' qoklet tu'n?</para>
  <para style="q">
    <verse number="32" style="v" />Ate Dyos nq'onte wipumale',</para>
  <para style="q">tu'n b'a'n wela'ye' twitz,</para>
  <para style="q">
    <verse number="33" style="v" />intzaj tq'o'n kyipumalu' nqane' tu'n wojqelane' kse'n msat,</para>
  <para style="q">ex tojawl ta'qine', qu'n tzyu'nqine' tu'n,</para>
  <para style="q">
    <verse number="34" style="v" />nchin t-xnaq'tza'ne' te q'oj,</para>
  <para style="q">intq'o'n wipumale' tu'n tjk'etju' smaj q'ank'uxb'il wu'ne'.</para>
  <para style="b" />
  <para style="q">
    <verse number="35" style="v" />Aya nxq'uqin weye' ex nklonweye',</para>
  <para style="q">tzyu'nqine' tu'n tb'a'nq'ob'a;</para>
  <para style="q">ex tu'n t-xtalb'ila ẍin jawa' b'enta'ye'.</para>
  <para style="q">
    <verse number="36" style="v" />Nqaku' sela' nb'eye' tu'na,</para>
  <para style="q">ex min ẍin jawtz'aqe'.</para>
  <para style="b" />
  <para style="q">
    <verse number="37" style="v" />Mankan toj kyq'iju' wajq'oje ex makub'kyi'j wu'ne',</para>
  <para style="q">ex tzmaxi' sanjtzwi'ju'ye' tej ẍeb'aj wu'ne'.</para>
  <para style="q">
    <verse number="38" style="v" />Mache b'ajnpẍu'ne' ex min ẍeb'jawe'tl.</para>
  <para style="q">¡Mache kub' tz'aq tjaq' nqane'!</para>
  <para style="q">
    <verse number="39" style="v" />Matzaj tq'o'na wipumale' toj q'oj;</para>
  <para style="q">mache kub'tzipeju' mib'a'n che b'in nwitze' tu'na,</para>
  <para style="q">
    <verse number="40" style="v" />ex e'kub' oqju' wajq'oje nwitze'.</para>
  <para style="q">Iktzu'n ekub'a' nb'ajsa'ne' ntx'a'lti'j kyk'u'j wi'je'.</para>
  <para style="q">
    <verse number="41" style="v" />Eqanin o'nb'il, ex mix-a'lo' oninkye;</para>
  <para style="q">ekub'san twitza Nman Dyos, ex minti' e'tzaj tb'i'na.</para>
  <para style="q">
    <verse number="42" style="v" />¡E'kub'naj wu'ne' kse'n quq nxi' tiqa'n kyq'iq'!</para>
  <para style="q">¡Eb'aj nwab'e'ne' kse'n tz'is toj b'e!</para>
  <para style="q">
    <verse number="43" style="v" />Machin tkola te jun tnam pi's,</para>
  <para style="q">machin nok tq'o'na te nejenel kyib'aj tnam</para>
  <para style="q">nche ajb'en xjal weye', ju' min ojtzqi'nqe' wu'ne'.</para>
  <para style="q">
    <verse number="44" style="v" />Naqa xinma'ne', nche b'in weye';</para>
  <para style="q">e'najchaq xjal nche okslan weye',</para>
  <para style="q">
    <verse number="45" style="v" />e'xjal te juntl tnam nche xob' weye'</para>
  <para style="q">ex nche lu'lun aj kyb'je'tz toju' kyewb'il.</para>
  <para style="b" />
  <para style="q">
    <verse number="46" style="v" />¡Nimanjtzxwit Qman Dyos! ¡Nimanjtzxwitju' klol weye'!</para>
  <para style="q">¡Jawxwit nima'n Dyos klol weye'!</para>
  <para style="q">
    <verse number="47" style="v" />Ate Dyos xq'onte tu'me'l t-xel kyeju' wajq'oje</para>
  <para style="q">ex mache kyej tq'o'n tnam tjaq' nkawb'ile'.</para>
  <para style="q">
    <verse number="48" style="v" />Ate nklonweye' te kytx'u'jilju' wajq'oje,</para>
  <para style="q">kyeju' nkych'uẍsa'n kyib' xjaw kyi'nkyib' wi'je'.</para>
  <para style="q">¡Aya Nman Dyos nklonweye' kyeju' xjal tx'u'jqe'!</para>
  <para style="q">
    <verse number="49" style="v" />Qu'mtzun njaw wajwali'na kyxolju' tnam</para>
  <para style="q">ex nchin b'itzane' toj tb'iya.</para>
  <para style="q">
    <verse number="50" style="v" />Intq'o'na tipumalju' nimaqkawil jawni t-sk'o'na tu'n tkanb'an;</para>
  <para style="q">In tk'u'jla'nju'ya Dab'i kukxju' kyuk'i'lju' tyajajil, chiju' b'itzal.</para>
  <chapter number="19" style="c" />
  <para style="s1">Tajwalil Qman Dyos toju' tb'inchb'en</para>
  <para style="q">
    <verse number="1" style="v" />Intma'n kya'j ninb'ilte Dyos;</para>
  <para style="q">aju' twitz kya'j nyek'unteju' taq'unb'en tq'ob'.</para>
  <para style="q">
    <verse number="2" style="v" />Atl junjun q'ij nkyma'nju' tb'inchb'en Dyos;</para>
  <para style="q">exju' qonik'an nxitma'n tqanil te juntl qonik'an.</para>
  <para style="q">
    <verse number="3" style="v" />Maskyepe' mixti' jun tqanil tu'n tyol</para>
  <para style="q">ex mixti' jun tq'ojq'ojel yol nb'injtz,</para>
  <para style="q">
    <verse number="4" style="v" />atiju' tqanil toj tkyaqil twitz tx'otx',</para>
  <para style="q">tzmax toj mankb'il t-xe kya'j,</para>
  <para style="q">atzuntzu' kub'a' tq'o'n Dyos tkub'elu' q'ij.</para>
  <para style="q">
    <verse number="5" style="v" />Ntzyet tb'ettzuntz kse'n jun ku'xun ajtmje,</para>
  <para style="q">kse'n jun xjal aj txi' ojqelanjeb'il,</para>
  <para style="q">
    <verse number="6" style="v" />In jawu'lu' q'ij toj jun plaj kya'j</para>
  <para style="q">ex innex toj jun plajtl,</para>
  <para style="q">ex mix-a'lo' jun nb'ent tewan teju' ttantonil.</para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" />Ttzinunalxi'xte' t-xnaq'tzb'il Qman Dyos,</para>
  <para style="q">qu'n intq'o'n ak'a'j chwinqlal.</para>
  <para style="q">Tnik'alti'jte' tchaq'b'il Qman Dyos,</para>
  <para style="q">qu'n intq'o'n tnab'lju' xjal mixti' xnaq'tzb'il te.</para>
  <para style="q">
    <verse number="8" style="v" />Tz'aqliqe'ju' tkawb'il Qman Dyos,</para>
  <para style="q">qu'n intzalaj qanmi kyu'n.</para>
  <para style="q">Tb'anilxi'xte' tchaq'b'il Qman Dyos,</para>
  <para style="q">in t-spik'b'a'n toj qwitz.</para>
  <para style="b" />
  <para style="q">
    <verse number="9" style="v" />Majx Ẍtilunte' nqo niman te Qman Dyos,</para>
  <para style="q">ex ati tejumajx.</para>
  <para style="q">Ax qe'kye' tchaq'b'il Qman Dyos,</para>
  <para style="q">kykyaqil tz'aqliqe',</para>
  <para style="q">
    <verse number="10" style="v" />¡nimxi'x kyoklen kyetwitz tb'anil q'anpwaq!,</para>
  <para style="q">¡maj chi'xi'x kyetwitzju' ta'lkab' nb'ent kyu'n onon!</para>
  <para style="q">
    <verse number="11" style="v" />Ex k'asb'ilqe' weye' ayine' tmajena,</para>
  <para style="q">ex b'a'nxi'x tu'n kyxi' nnb'i'ne'.</para>
  <para style="b" />
  <para style="q">
    <verse number="12" style="v" />¿Alxi'xkye jun inel tnik' ti'jxu' tchuksb'en?</para>
  <para style="q">¡Nman Dyos, najsanku'ya jni'xu' nb'inchb'ene' min inel nnik'e' kyi'j!</para>
  <para style="q">
    <verse number="13" style="v" />Iq'imilju'ya nimjtib'il woje';</para>
  <para style="q">lalun taja tu'n tkub' wi'je' tu'nju' nimjtib'il.</para>
  <para style="q">Tu'ntzun wokye' mixti' ntz'ilile' twitza;</para>
  <para style="q">ex tu'n ntzaqpete' te nimaq il.</para>
  <para style="b" />
  <para style="q">
    <verse number="14" style="v" />Che elxwit b'a'nju' nyole' exju' nxime' toj twitza,</para>
  <para style="q">Nman Dyos, wewb'ile' ex tzaqpil weye', chiju' b'itzal.</para>
  <chapter number="20" style="c" />
  <para style="s1">Na'j Dyos ti'j kanb'ab'l</para>
  <para style="q">
    <verse number="1" style="v" />Tzajxwit b'i'na tu'n Qman Dyos aj ttena toj yajb'il;</para>
  <para style="q">awt Qman Dyos ja k'uluna' Jakob' klonteya.</para>
  <para style="q">
    <verse number="2" style="v" />Tzajxwit t-sma'n jun onilteya ex klolteya</para>
  <para style="q">tzmax toju' ja xjan twi' Syon.</para>
  <para style="q">
    <verse number="3" style="v" />Tzajxwit tna'n tkyaqilju' toyaja</para>
  <para style="q">ex tk'amxwit toj tzalajb'il tkyaqilu' nkub' tq'o'na te chojb'il k'ok'sb'il.</para>
  <para style="q">
    <verse number="4" style="v" />Tzajxwit ttzaq'we'n tkyaqilju' tb'is tk'u'ja</para>
  <para style="q">ex che japunxwit tkyaqilju' t-xima.</para>
  <para style="q">
    <verse number="5" style="v" />Kb'eltzun qik'sa'nju' q'ij ajtkanb'ana,</para>
  <para style="q">che jawil qyob'a'nju' t-sut tnam twitz kya'j</para>
  <para style="q">toj tb'i Qman Dyos.</para>
  <para style="q">¡Che tzajxwit tq'o'n Qman Dyos tkyaqilju' tqanb'etza!</para>
  <para style="b" />
  <para style="q">
    <verse number="6" style="v" />Matxi' tz'el nnik'e' b'a'nxi'x qa ktzajel tq'o'nte Qman Dyos</para>
  <para style="q">tu'n tkanb'anju' nimaqkawil jaw t-sk'o'n;</para>
  <para style="q">qa ktzajel ttzaq'we'n tzmax toju' kya'j xjan,</para>
  <para style="q">ktzajel tq'o'n nimaq kanb'ab'l te tu'nju' tipumal.</para>
  <para style="q">
    <verse number="7" style="v" />Ate' junjun q'uqlok kyk'u'j kyi'j kykarwaj te q'oj,</para>
  <para style="q">ex junjuntl kyi'j kychej;</para>
  <para style="q">atzunqe atzu' q'uqloka' qk'u'j ti'j Qman Dyos.</para>
  <para style="q">
    <verse number="8" style="v" />Inche kub' tz'umj kye kych'eky ex nche kub' tz'aq,</para>
  <para style="q">ayo'tzunqe wa'lqo'xi'x ex minti' nqo'kub' tz'aq.</para>
  <para style="b" />
  <para style="q">
    <verse number="9" style="v" />Nman Dyos, ¡q'ontzju'ya kanb'ab'l teju' nimaqkawil!</para>
  <para style="q">¡Qo' ttzaq'wetza ajqtxokone' teya!, chiju' b'itzal.</para>
  <chapter number="21" style="c" />
  <para style="s1">B'itz te kanb'ab'l</para>
  <para style="q">
    <verse number="1" style="v" />Nman Dyos,</para>
  <para style="q">intzalaju' nimaqkawil tu'nju' matxi' tq'o'na tipumal;</para>
  <para style="q">¡inxi'x tzalaj tu'nju' ma kanb'an tu'na!</para>
  <para style="q">
    <verse number="2" style="v" />Mache tzaj tq'o'na tb'is tk'u'j;</para>
  <para style="q">minti' xkub' t-xk'a'yi'nju'ya tqanb'etz.</para>
  <para style="q">
    <verse number="3" style="v" />Matk'ama tuk'i'l nim ky'i'wb'il</para>
  <para style="q">ex majaxtq'o'na jun q'anpwaq koron toj twi'.</para>
  <para style="q">
    <verse number="4" style="v" />Xitqani'n tchwinqlal teya, ex matzaj tq'o'na:</para>
  <para style="q">nimtoj ex tejumajx.</para>
  <para style="q">
    <verse number="5" style="v" />Chjonte tu'nju' t-o'nb'ila, nimte' tipumal tu'na;</para>
  <para style="q">matxi' tq'o'na oklenj ex ninb'ilte.</para>
  <para style="q">
    <verse number="6" style="v" />Matxi' kub' tky'i'wla'na tejumajx;</para>
  <para style="q">intzalaj nimxi'x qu'n atiya tuk'i'l.</para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" />Layxna' kub'tz'aqta, nimaqkawil, q'uqlina' tk'u'ja ti'j Qman Dyos;</para>
  <para style="q">¡q'uqli tk'u'ja ti'ju' tk'u'jlalil Manb'aj te toj kya'j!</para>
  <para style="q">
    <verse number="8" style="v" />Kpomelju' tipumala kyib'aju' tajq'oja;</para>
  <para style="q">kpomel kanunju' tb'a'nq'ob'a kyib'aju' nche i'k'un teya;</para>
  <para style="q">
    <verse number="9" style="v" />che okyex tq'o'na toj tq'aq'al jun chuj</para>
  <para style="q">ajtula malul kyib'aj.</para>
  <para style="q">Atzunte Qman Dyos tu'n ttx'u'jil,</para>
  <para style="q">che kb'el tnajsa'n tu'n q'aq'.</para>
  <para style="q">
    <verse number="10" style="v" />Che b'el tnajsa'nju'ya kyk'wal ex kyyajajil</para>
  <para style="q">Kyxolju' xjal twitzju' tx'otx'</para>
  <para style="q">che kb'el tnajsa'nju'ya kyk'wal exqe' kyyajajil.</para>
  <para style="q">
    <verse number="11" style="v" />B'a'ntzun qa kyajb'il tu'n kyb'inchante jun taq'wix ti'ja</para>
  <para style="q">exqa makub' kyxima'n jun ti'xti' myab'a'n,</para>
  <para style="q">lay b'ent kyu'n,</para>
  <para style="q">
    <verse number="12" style="v" />che kb'el oqkye' teya;</para>
  <para style="q">kxe'l tnik'u'na t-smaja kyi'j.</para>
  <para style="b" />
  <para style="q">
    <verse number="13" style="v" />¡Iq'i'nktz tib'a Nman Dyos tuk'i'l tipumala,!</para>
  <para style="q">¡Che kb'el qtzalajsa'ne' tkanb'ab'la kyu'n b'itz!, chiju' b'itzal.</para>
  <chapter number="22" style="c" />
  <para style="s1">Sich' toj yajb'il ex b'itz te ajwalb'il</para>
  <para style="q">
    <verse number="1" style="v" />Nman Dyos, Nman Dyos,</para>
  <para style="q">¿tiqu'n ẍin kyeja' ttzaqpi'na?</para>
  <para style="q">¿titiqu'n minti' ntzaja' klol weye'?</para>
  <para style="q">¿titiqu'n minti' ntzaj tb'i'nju'ya nkub'sb'ile'?</para>
  <para style="q">
    <verse number="2" style="v" />Taye,</para>
  <para style="q">intzaj ntxko'na q'ijtl ex qonik'an, ex min nchin tzaj ttzaq'we'na;</para>
  <para style="q">¡mixti'x nchin ojlane'!</para>
  <para style="b" />
  <para style="q">
    <verse number="3" style="v" />Xjan na'ta Nman Dyos;</para>
  <para style="q">aya nkawin ex nima'na kyu'n aj Israel.</para>
  <para style="q">
    <verse number="4" style="v" />Okqe kyk'u'ju' qmane' ti'ja;</para>
  <para style="q">qe kyk'u'j ti'ja ex e'tzaqpet tu'na;</para>
  <para style="q">
    <verse number="5" style="v" />e'qanin o'nb'il teya, ex aya tzaqpinkye;</para>
  <para style="q">okqe kyk'u'j ti'ja ex min e'kyaj tkolb'e'na.</para>
  <para style="b" />
  <para style="q">
    <verse number="6" style="v" />Naqna' jun xton qinwe', mya jun ichan;</para>
  <para style="q">¡matxi' chin okye' te kytzeb'l xjal!</para>
  <para style="q">
    <verse number="7" style="v" />Nchin xmayinjtze' kyu'nju' nche okka'yin weye';</para>
  <para style="q">nxi' kyokcha'n kytzi ex kywi'</para>
  <para style="q">
    <verse number="8" style="v" />ex inkyma'n:</para>
  <para style="q">Q'uqlitoq te'lu tk'u'j ti'j Qman Dyos;</para>
  <para style="q">tzajku'na'tzuntz klolte.</para>
  <para style="q">Ina' laqj ti'j, klonjtz ku'natzuntz tu'n, chechij.</para>
  <para style="b" />
  <para style="q">
    <verse number="9" style="v" />Ikytzu'n Nman Dyos:</para>
  <para style="q">tb'inchaya tu'n witz'je' ti'j ntxuye';</para>
  <para style="q">tu'na nnojlana'ye' ttzitk'u'j.</para>
  <para style="q">
    <verse number="10" style="v" />Atxi'x na'mxtoq witz'jiye',</para>
  <para style="q">inkub' q'o'ne' toj tq'ob'a;</para>
  <para style="q">tej atinqintoqe' toj t-xmilal ntxuye',</para>
  <para style="q">ti'ja q'uqla' nk'u'je'.</para>
  <para style="q">
    <verse number="11" style="v" />Lalun tz'el tpa'ntib'a wi'je',</para>
  <para style="q">qu'n xi' woke' toju' yajb'il</para>
  <para style="q">ex mix-a'lo' jun klol weye'.</para>
  <para style="b" />
  <para style="q">
    <verse number="12" style="v" />Txoli'ntl kyib'ju' wajq'oje wi'je' naku'j tman wakxqe',</para>
  <para style="q">ikyqe' kse'n tman wakx toj B'asan tx'u'jqe';</para>
  <para style="q">
    <verse number="13" style="v" />nche tzanun naku'j b'alun,</para>
  <para style="q">inxi' kyk'ab'a'n toj kytzi ex ntzaj kyxonkyib' wib'aje'.</para>
  <para style="q">
    <verse number="14" style="v" />Ikyqinju'ye' kse'n a' kub' ẍa'lj;</para>
  <para style="q">qutz'jni qe'ju' nb'aqile'.</para>
  <para style="q">Inkub' yulju' wanmiye' woje'</para>
  <para style="q">kse'n ser.</para>
  <para style="q">
    <verse number="15" style="v" />Matxi tzqiju' ntziye' naku'j jun xk'o'n;</para>
  <para style="q">matxi' tz'oklak'e waq'e' toj nk'o'ne'.</para>
  <para style="q">¡Matxi' chin kyej tq'o'na ex machin ponxe' twitz kamik!</para>
  <para style="q">
    <verse number="16" style="v" />Naku'j tx'yan qe'ju' b'inchal taq'wix</para>
  <para style="q">matxi' tz'ok kytxoli'n kyib' wi'je';</para>
  <para style="q">matxi' b'aj kyk'ixb'sa'n nq'ob'e' ex nqane'.</para>
  <para style="q">
    <verse number="17" style="v" />¡Jaku' b'ent kyajletu' nb'aqile' wu'ne'!</para>
  <para style="q">Majx tokkywitzju' wajq'oje wi'je';</para>
  <para style="q">
    <verse number="18" style="v" />matxi' b'ajx kysipa'n nxb'alune' kyxol,</para>
  <para style="q">ex nche' ẍchan alkye kkanb'al ti'j.</para>
  <para style="b" />
  <para style="q">
    <verse number="19" style="v" />Atzunta Nman Dyos, aya wipumale',</para>
  <para style="q">¡lalun txi' lq'eya!, ¡lwix kuttzaja onilweye'!</para>
  <para style="q">
    <verse number="20" style="v" />Chin tkloma tu'n lan chin b'aje' tu'n k'uẍtx'e'nb'il,</para>
  <para style="q">lalun taja tu'n nkub' kyb'yo'ne' twak'utz lu,</para>
  <para style="q">
    <verse number="21" style="v" />chin tkloma toj kytziju' b'alun lu,</para>
  <para style="q">¡chin tkloma te kyuk'aju' tman wakx lu!</para>
  <para style="b" />
  <para style="q">
    <verse number="22" style="v" />Kxe'l nyoli'na kyeju' witz'ine' ex ntzike',</para>
  <para style="q">kjawil nnima'na toju' b'u'yb'ilkyib'.</para>
  <para style="q">
    <verse number="23" style="v" />¡Che b'itzan qe'ye' te Qman Dyos!, aye'ye' nche nimane' te.</para>
  <para style="q">¡Che nimanqe'ye' te, kykyaqile' tyajajil Jakob'!</para>
  <para style="q">¡Che k'ulun qe'ye' te, kykyaqile' tyajajil Israel!</para>
  <para style="q">
    <verse number="24" style="v" />Qu'n minti' nche eltik'o'n</para>
  <para style="q">ex min nnik'tna'lu' yajb'ilkye prow tu'n,</para>
  <para style="q">ex minti' nkub' ewan kywitz.</para>
  <para style="q">¡Inche tzaj tb'i'n aj txi' kyqani'n o'nb'il te!</para>
  <para style="q">
    <verse number="25" style="v" />Kjawil nb'itza'ne' tyola njapun;</para>
  <para style="q">kywitzju' ttanama nim kyajlal,</para>
  <para style="q">kywitzju' nche niman teya</para>
  <para style="q">kjapumelju' nyole' xintziya'ne' teya.</para>
  <para style="b" />
  <para style="q">
    <verse number="26" style="v" />Che wanqe'kye', ju' nche yajlanjtze',</para>
  <para style="q">che nojxe' b'a'nxi'x;</para>
  <para style="q">che b'itzan qe'ye' ju' nche jyone' ti'j Dyos,</para>
  <para style="q">ex che anq'inxwite' b'a'npun ab'q'i.</para>
  <para style="q">
    <verse number="27" style="v" />Kykyaqil kyyajajil xjal ex kykyaqil nimaqtnam,</para>
  <para style="q">e'xjal toj tkyaqil twitz tx'otx':</para>
  <para style="q">kyna'ntze' Qman Dyos, ex kukytzaje' tk'etz;</para>
  <para style="q">¡che mejeku'ye' twitz!</para>
  <para style="q">
    <verse number="28" style="v" />Qu'n ate Qman Dyos nimaqkawil,</para>
  <para style="q">ex ate nkawin kyib'aj kykyaqil nimaqtnam.</para>
  <para style="q">
    <verse number="29" style="v" />Che tzipeku'ye' ex che k'ulun qe'ye' o'kxte</para>
  <para style="q">kykyaqile' b'a'n te'qe'ye',</para>
  <para style="q">kykyaqile' ju' k'anjetl kyi'je' toj tx'otx',</para>
  <para style="q">qu'n mixti' kychwinqlale' kyu'nx kyib'e'.</para>
  <para style="b" />
  <para style="q">
    <verse number="30" style="v" />Kche k'ululkye' nyajajile' te Qman Dyos</para>
  <para style="q">ex kche yolil ti'j toj tkyaqilju' kychwinqlal;</para>
  <para style="q">
    <verse number="31" style="v" />kxe'l kyoli'nju' tkawb'il ex taq'unb'en</para>
  <para style="q">kyeju' che itz'jel yajxi'tel, chiju' b'itzal.</para>
  <chapter number="23" style="c" />
  <para style="s1">A Qman Dyos k'ik'lel weye'</para>
  <para style="q">
    <verse number="1" style="v" />Ate Qman Dyos k'ik'lel weye';</para>
  <para style="q">ntzaj tq'o'n tkyaqilju' nnojqelan weye'.</para>
  <para style="q">
    <verse number="2" style="v" />Nchin ojlane' tu'n kyoj cha'x k'ul,</para>
  <para style="q">ex nchinx tiq'i'ne' kytzi a' chab'a kyel,</para>
  <para style="q">
    <verse number="3" style="v" />ntzaj tq'o'ntl wipumale'</para>
  <para style="q">ex nchinx tiq'ine' kyoj b'a'n b'e,</para>
  <para style="q">te ninb'ilte tb'i.</para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" />Maskye machin nik'e' toj jun b'e xob'ajilx,</para>
  <para style="q">lay chin xob'e',</para>
  <para style="q">qu'n atiya wuk'i'le', Nman Dyos;</para>
  <para style="q">q'uqli nk'u'je' kyi'ju' ttzeya.</para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" />Matxi' kub' tb'incha'na jun ninwan weye'</para>
  <para style="q">kywitzku' wajq'oje;</para>
  <para style="q">majaxtqo'na aseyt toj nwi'ye' naku'j nimaqxjal qine',</para>
  <para style="q">ex matzaj tnojsa'na nb'ase' b'a'nxi'x.</para>
  <para style="q">
    <verse number="6" style="v" />Atiju' t-xtalb'ila ex tk'u'jlalila wuk'i'le',</para>
  <para style="q">ex chin najale' toju' tjaya Nman Dyos</para>
  <para style="q">toj tkyaqilju' nchwinqlale', chiju' b'itzal.</para>
  <chapter number="24" style="c" />
  <para style="s1">Nimaqkawil nim tajwalil</para>
  <para style="q">
    <verse number="1" style="v" />Tete' Qman Dyos tkyaqilju' tx'otx',</para>
  <para style="q">kyuk'i'l tkyaqilju' ati twitz,</para>
  <para style="q">kyuk'i'l kykyaqilju' itz'qe' twitz.</para>
  <para style="q">
    <verse number="2" style="v" />Qu'n ana'te Qman Dyos kub' q'onteju' tq'uqlil tx'otx'</para>
  <para style="q">ex kub' tq'o'n tib'aj njab' ex kyib'aj a'.</para>
  <para style="b" />
  <para style="q">
    <verse number="3" style="v" />¿Alkye kjapumel twi'ju' witz te Qman Dyos?</para>
  <para style="q">¿Alkye ktenb'il toj tja Dyos xjan?</para>
  <para style="q">
    <verse number="4" style="v" />Aju' ẍtilun tq'ob' ex tnab'l</para>
  <para style="q">te tkyaqil il;</para>
  <para style="q">aju' min nk'ulun kywitz witzleb'</para>
  <para style="b" />
  <para style="q">ex min ntzaj tna'n tb'i Dyos ti'j chajyolil.</para>
  <para style="q">
    <verse number="5" style="v" />A Qman Dyos kolol kb'el k'i'wlanteju' ichan lu,</para>
  <para style="q">ex ktb'incha' b'a'n te.</para>
  <para style="q">
    <verse number="6" style="v" />Ikyqe'tzun xjalju' nche k'ulun te Dyos,</para>
  <para style="q">aye' nche jyon ti'ju' Dyos ja k'uluna' Jakob'.</para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" />¡E' tjpel tnam tejumajx,!</para>
  <para style="q">¡Kukykyaje' jqo'n qe'ye',</para>
  <para style="q">tu'n tokxju' nimaqkawil nim tajwalil!</para>
  <para style="b" />
  <para style="q">
    <verse number="8" style="v" />¿Alkyetzu'n nimaqkawil nim tajwalil?</para>
  <para style="q">¡Ate Qman Dyos nimtipumal ex kuw!</para>
  <para style="q">¡Kuwte' Qman Dyos toj q'oj!</para>
  <para style="b" />
  <para style="q">
    <verse number="9" style="v" />¡Kyjqom kyib'e' tjpel tnam tejumajx!</para>
  <para style="q">¡Kukykyaje' jqo'n qe'ye',</para>
  <para style="q">tu'n tokxju' nimaqkawil nim tajwalil!</para>
  <para style="b" />
  <para style="q">
    <verse number="10" style="v" />¿Alkyetzu'n nimaqkawil nim tajwalil lu?</para>
  <para style="q">¡A Qman Dyos nimtipumal tib'aj tkyaqil!</para>
  <para style="b" />
  <para style="q">¡Ate nimaqkawilju' nim tajwalil! chiju' b'itzal.</para>
  <chapter number="25" style="c" />
  <para style="s1">Qanb'il o'nb'il te Dyos toj na'j Dyos</para>
  <para style="q">
    <verse number="1" style="v" />Nman Dyos, teya nchin kub'sana'ye';</para>
  <para style="q">
    <verse number="2" style="v" />Taye, ti'ja q'uqla' nk'u'je':</para>
  <para style="q">lalun taja tu'n tel nch'ixawe'.</para>
  <para style="q">¡Tu'n lalun chin kub'kytze'ne' wajq'oje!</para>
  <para style="q">
    <verse number="3" style="v" />¡Miwt tz'ela' kych'ixawju'</para>
  <para style="q">q'uqlok kyk'u'j ti'ja!</para>
  <para style="q">¡Aye'wt tz'el kych'ixawju'</para>
  <para style="q">naqx kyak'a'n njaw kyiq'i'n kyib' ti'ja!</para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" />Nman Dyos,</para>
  <para style="q">yek'unqe'tzju'ya tb'eya weye';</para>
  <para style="q">chin t-xb'etzama kyoj;</para>
  <para style="q">
    <verse number="5" style="v" />chin t-ẍaqluma, chin t-xb'etzama toju' ax,</para>
  <para style="q">qu'n a na'ta Dyos ja q'uqla' nk'u'je' ex klol weye'.</para>
  <para style="q">¡Tkyaqil kmuj q'uqlok nk'u'je' ti'ja!</para>
  <para style="b" />
  <para style="q">
    <verse number="6" style="v" />Nman Dyos,</para>
  <para style="q">na'ntza ttzalajb'ila tuk'i'l tk'u'jlalila</para>
  <para style="q">ju' ntzaj tyek'u'na qeye' kukxju',</para>
  <para style="q">
    <verse number="7" style="v" />lantzun tzaj tna'nteju'ya wile'</para>
  <para style="q">exju' taq'wix xnb'inchaye' toj nku'xumale'.</para>
  <para style="q">Nman Dyos, chin tna'tza,</para>
  <para style="q">tuk'i'l tk'u'jlalila ex t-xtalb'ila.</para>
  <para style="b" />
  <para style="q">
    <verse number="8" style="v" />Majx b'a'nte' Qman Dyos ex tnik'alti'j;</para>
  <para style="q">intzak'un ti'j kyb'inchb'enju' aj il</para>
  <para style="q">
    <verse number="9" style="v" />aye'tzu'n min nkynima'n kyib' inche t-ẍaqlu'n toju' tb'eyil;</para>
  <para style="q">¡nche t-xnaq'tza'n tu'n kyb'et toj tnik'alti'j!</para>
  <para style="q">
    <verse number="10" style="v" />Tkyaqilju' tb'e Qman Dyos tk'u'jlalil ex ax qe',</para>
  <para style="b" />
  <para style="q">kyeju' xjal njapunju' tyol ex tchaq'b'il kyu'n.</para>
  <para style="b" />
  <para style="q">
    <verse number="11" style="v" />Nman Dyos, nimwe' wil twitza;</para>
  <para style="q">najsama, nimanjtzwitu' tb'iya.</para>
  <para style="q">
    <verse number="12" style="v" />In xityek'u'n Qman Dyos b'e,</para>
  <para style="q">teju' xjal nniman te;</para>
  <para style="q">
    <verse number="13" style="v" />intb'incha'n tu'n tanq'in b'a'n</para>
  <para style="q">ex kxe'l tq'o'n kytx'otx'ju' tyajajil toju' tx'otx'.</para>
  <para style="q">
    <verse number="14" style="v" />In nokte Qman Dyos te kamiwju' nche niman te,</para>
  <para style="q">ex nxityek'u'nju' tyol kyejni b'entti'j kye.</para>
  <para style="q">
    <verse number="15" style="v" />Majx tokwe' nwitz ti'j Qman Dyos,</para>
  <para style="q">qu'n inchin tklo'ne' toj tkyaqil xob'ajil.</para>
  <para style="b" />
  <para style="q">
    <verse number="16" style="v" />Chin tka'yintza, Nman Dyos, ex q'aq'antz tk'u'ja wi'je',</para>
  <para style="q">qu'n njunale' intinqine' ex nchin b'isune'.</para>
  <para style="q">
    <verse number="17" style="v" />Inxi'x chin b'isune' atl junjun q'ij;</para>
  <para style="q">chin tkloma toju' yajb'ilweye'.</para>
  <para style="q">
    <verse number="18" style="v" />Ka'yintzju'ya nchin nik'a'ye' toju' aq'untl ex toju' b'is,</para>
  <para style="q">ex najsama wile'.</para>
  <para style="q">
    <verse number="19" style="v" />Ka'yintza, nim wajq'oje</para>
  <para style="q">inxi'x walti'j kyk'u'j wi'je'.</para>
  <para style="q">
    <verse number="20" style="v" />¡Chin t-xq'uqima, klomju'ya nchwinqlale'!</para>
  <para style="q">¡Lalun taja tu'n tel nch'ixawe',</para>
  <para style="q">qu'n tuk'i'la njyona'ye' kolb'il!</para>
  <para style="q">
    <verse number="21" style="v" />Chin kletxwite' tu'nju' b'a'n wele' mixti' wile' twitza,</para>
  <para style="q">qu'n matxi' tz'okqe nk'u'je' ti'ja.</para>
  <para style="b" />
  <para style="q">
    <verse number="22" style="v" />¡Nman Dyos,</para>
  <para style="q">klomqe'ju'ya aj Israel toj tkyaqilju' yajb'ilkye!, chiju' b'itzal.</para>
  <chapter number="26" style="c" />
  <para style="s1">Jun chwinqlal ẍtilun q'uqli tk'u'jlalil</para>
  <para style="q">
    <verse number="1" style="v" />Nman Dyos, b'inchama tnik'alilti'j weye',</para>
  <para style="q">qu'n mixti' taq'wix toju' nchwinqlale'.</para>
  <para style="q">Q'uqlokxi'xwe' nk'u'j ti'ja Nman Dyos;</para>
  <para style="q">
    <verse number="2" style="v" />chin t-xpich'uma, ¡kutik' twitza wi'je'!,</para>
  <para style="q">¡kutik' twitza kyi'ju' nxime'</para>
  <para style="q">ex kyi'ju' nna'ne' toj wanmiye'!</para>
  <para style="q">
    <verse number="3" style="v" />Minti' in ik'tna'lju' tk'u'jlalila wu'ne'</para>
  <para style="q">ex in nb'incha'nju'ye' tajb'ila;</para>
  <para style="q">
    <verse number="4" style="v" />b'ajx chin tena'we' kyuk'i'lju' chalyol</para>
  <para style="q">ex b'ajx chin uk'ilana'ye' kyuk'i'lju' xmletz'.</para>
  <para style="q">
    <verse number="5" style="v" />Inel wik'u'ne' b'u'yb'il kyib'ju' b'inchal il;</para>
  <para style="q">¡b'ajx chin tena'we' kyuk'i'lju' b'inchal myab'a'n!</para>
  <para style="b" />
  <para style="q">
    <verse number="6" style="v" />Nman Dyos, wajb'ile' tu'n woklq'eye' ti'ju' q'olb'eb'l teya,</para>
  <para style="q">txjo'nqe'tlwe' nq'ob' ex ẍnu'lqe'tl te il,</para>
  <para style="q">
    <verse number="7" style="v" />tu'ntzun nb'itzane' te ajwalb'il tb'iya,</para>
  <para style="q">ex tu'n t-xi'npakb'a'ne' taq'unb'ena tb'anilxi'x.</para>
  <para style="b" />
  <para style="q">
    <verse number="8" style="v" />Nman Dyos, ink'u'jla'nwe' ja, janajla'ya,</para>
  <para style="q">ja tkub'a' tajwalila.</para>
  <para style="q">
    <verse number="9" style="v" />Lalun tz'el tiq'i'na nchwinqlale' junx kyuk'i'lju' aj il;</para>
  <para style="q">ex lalun tb'inchaya weye' kse'n nche t-se'na'ju'ya b'yolxjal,</para>
  <para style="q">
    <verse number="10" style="v" />kse'nqe' naq'li kyq'ob' tu'n kyb'inchan il</para>
  <para style="q">ex tu'n kyk'mon medi ti'j jun taq'wixil.</para>
  <para style="b" />
  <para style="q">
    <verse number="11" style="v" />Atzunwe' mixti'we' ttz'ilil nchwinqlal;</para>
  <para style="q">¡chin tkloma, q'aq'antz tk'u'ja wi'je'!</para>
  <para style="q">
    <verse number="12" style="v" />Wa'lqe' nqane' b'a'nxi'x twitz tx'otx';</para>
  <para style="q">¡kjawil nnima'na Wajaw, kywitzju' ttanama!, chiju' b'itzal.</para>
  <chapter number="27" style="c" />
  <para style="s1">A Qman Dyos spik'un es kolb'il weye'</para>
  <para style="q">
    <verse number="1" style="v" />Ate Qman Dyos spik'un ex klol weye',</para>
  <para style="q">¿altzun qe chin xob'ila'ye'?</para>
  <para style="q">Ate Qman Dyos nklonte nchwinqlale',</para>
  <para style="q">¿altzun qe chin xob'ila'ye'?</para>
  <para style="q">
    <verse number="2" style="v" />Aye' aj il exqe' ju' wajq'oje,</para>
  <para style="q">ajtb'aj kb'u'yi'n kyib' tu'n kq'ojin wi'je' ex tu'n nkub' kb'yo'ne';</para>
  <para style="q">aye'pekye inche jaw trakpuj ex inche kub' tz'aq.</para>
  <para style="q">
    <verse number="3" style="v" />Maskye matz'ok kytxoli'n kyib'ju' xjal q'ojil wi'je',</para>
  <para style="q">lay chin xob'we';</para>
  <para style="q">b'a'ntzun qa makyb'inchakyib' tu'n kyul q'ojil wi'je'</para>
  <para style="q">q'uqliwe' nk'u'j.</para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" />Noq jun ti'xti' matxi' txi' nqanine' te Dyos,</para>
  <para style="q">noq jun ti'xti' wajb'ile':</para>
  <para style="q">tu'n ntene' toj tja Dyos</para>
  <para style="q">toj tkyaqilju' nchwinqlale',</para>
  <para style="q">tu'ntzun nk'ulune' te, toj tja</para>
  <para style="q">ex tu'n toknka'yi'nju'ye' tajwalil.</para>
  <para style="q">
    <verse number="5" style="v" />Ajtzun tulju' tq'ijlalil myab'a'n,</para>
  <para style="q">kchin kletile' tja;</para>
  <para style="q">ex tjaq'ju' t-xlekumal kchin tenb'ila'ye'.</para>
  <para style="q">¡Ex tib'aj ju' pik chin kletela'ye' tu'n!</para>
  <para style="q">
    <verse number="6" style="v" />Oktzun kjawil wi'n nwi'tzu'ye'</para>
  <para style="q">kyib'aj wajq'oje;</para>
  <para style="q">kchin xe'ltzuntze' q'ol chojb'il toj tja Dyos,</para>
  <para style="q">ex kchin ẍch'ile' tu'n tzalajb'il, ex chin b'itzale' te Qman Dyos.</para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" />inchin kub'sane' twitza Wajaw: chin tb'itza.</para>
  <para style="q">Q'aq'antz tk'u'ja wi'je', ¡chin ttzaq'wetza!</para>
  <para style="q">
    <verse number="8" style="v" />Intma'n wanmiye' weye' kjalu:</para>
  <para style="q">Jyoma Qman Dyos.</para>
  <para style="q">Qu'mtzun Wajaw, inchin jyone' ti'ja.</para>
  <para style="q">
    <verse number="9" style="v" />¡Lalun txi' tewa'ntib'a nwitze'!</para>
  <para style="q">¡Lalun chin nel tik'u'na tuk'i'l ttx'u'jila!</para>
  <para style="q">¡Qu'n o'kxta onilweye'!</para>
  <para style="q">Lalun chin kyej tq'o'na njunale' mixti' kolb'ilweye',</para>
  <para style="q">qu'n a na'ta Ndyose' ex klol weye'.</para>
  <para style="q">
    <verse number="10" style="v" />Maskye machin kyej kykolb'e'ne' nmane' ex ntxuye',</para>
  <para style="q">aya Nman Dyos, kxe'l ka'yinweye'.</para>
  <para style="b" />
  <para style="q">
    <verse number="11" style="v" />Nman Dyos, yek'untza tb'eya weye';</para>
  <para style="q">chin t-ẍaqluma toju' tb'eya b'a'n</para>
  <para style="q">noqx tu'n kpaju' wajq'oje;</para>
  <para style="q">
    <verse number="12" style="v" />lalun taja tu'n nkub' tz'aqe' toj kyq'ob',</para>
  <para style="q">qu'n matxi' jawkyi'nkyib'</para>
  <para style="q">tziyal chalyolqe' ex mya'lqe' wi'je'.</para>
  <para style="q">
    <verse number="13" style="v" />Ayintzunwe' q'uqlixi'xwe' nk'u'j</para>
  <para style="q">qa k'okyel nka'yine' t-xtalb'il Dyos</para>
  <para style="q">toju' nchwinqlale'.</para>
  <para style="b" />
  <para style="q">
    <verse number="14" style="v" />¡Qek tk'u'ja ti'j Qman Dyos!</para>
  <para style="q">¡Tenx tipumala, lalun kub' numja!</para>
  <para style="q">¡Axxi'x, qek tk'u'ja ti'j Qman Dyos!, chiju' b'itzal.</para>
  <chapter number="28" style="c" />
  <para style="s1">Ntzaj tb'i'n Qman Dyos qkub'sb'il</para>
  <para style="q">
    <verse number="1" style="v" />inchin kub'sane' teya Nman Dyos,</para>
  <para style="q">aya klol weye'.</para>
  <para style="q">¡Chin ttzaq'wetza, lalun kub' t-xk'a'yi'n tib'a!</para>
  <para style="q">Qu'n qama kub' tewa'ntib'a nwitze',</para>
  <para style="q">matxi'tzun chin noktzu'ye' kyajlal kyimni.</para>
  <para style="q">
    <verse number="2" style="v" />B'intzju'ya tq'ojq'ojel nwi'ye' ajt-xi' nqani'ne' o'nb'il teya,</para>
  <para style="q">aj txi' nmujb'a'n nq'ob'e' tu'me'lju' tjaya xjan.</para>
  <para style="b" />
  <para style="q">
    <verse number="3" style="v" />Lalun kub' ttz'e'ysa'na nwitze' junx kyuk'i'lju' b'inchal myab'a'n,</para>
  <para style="q">lalun tb'inchaya weye' kse'n kb'ajel kyi'ju' b'inchal il,</para>
  <para style="q">qu'n naq kywitz xjal ati kyk'u'jlalil</para>
  <para style="q">atzu'n toj kyanmi nojni tu'n taq'wixil.</para>
  <para style="q">
    <verse number="4" style="v" />Q'onxju'ya tu'me'l t-xel kye,</para>
  <para style="q">kse'nxju' kyaq'unb'en;</para>
  <para style="q">tz'e'ysanku'ya kywitz,</para>
  <para style="q">kse'nxju' kyb'inchb'en taq'wix.</para>
  <para style="q">
    <verse number="5" style="v" />Qu'n min ntzaj kyna'n</para>
  <para style="q">jni'ju' taq'unb'en Qman Dyos,</para>
  <para style="q">¡awt kub' xitunkye ex mixwit che jawa' we'tl!</para>
  <para style="b" />
  <para style="q">
    <verse number="6" style="v" />¡Nimanjtzwitju' Qman Dyos, matxi' tzaj tb'i'nju' nkub'sb'ile'!</para>
  <para style="q">
    <verse number="7" style="v" />Ate Dyos klol weye' nimtipumal;</para>
  <para style="q">ti'j sokqeya' nk'u'je', ex matz'onin wi'je'.</para>
  <para style="q">inchin tzalaje';</para>
  <para style="q">kchin b'itzale' ex chin q'ol chjonteye' te Qman Dyos.</para>
  <para style="b" />
  <para style="q">
    <verse number="8" style="v" />Ate Qman Dyos kyipumalju' ttanam;</para>
  <para style="q">ate onil ex klolb'ilteju' nimaqkawil jawni t-sk'o'n.</para>
  <para style="q">
    <verse number="9" style="v" />Nman Dyos, klomju'ya ttanama;</para>
  <para style="q">ky'iwlanqeku'ya tk'wala.</para>
  <para style="q">Xq'uqimqe'ya kse'n jun k'ik'lel;</para>
  <para style="q">¡iq'imqe'ya toj tq'ob'a tejumajx!, chiju' b'itzal.</para>
  <chapter number="29" style="c" />
  <para style="s1">Tq'ojq'ojel twi' Qman Dyos nimtipumal</para>
  <para style="q">
    <verse number="1" style="v" />Kyajwalinktze' Qman Dyos aye'ye' anjl te toj kya'j:</para>
  <para style="q">kyajwalinktze' tipumal ex tajwalil,</para>
  <para style="q">
    <verse number="2" style="v" />kyajwanlinkju'ye' tb'i Qman Dyos,</para>
  <para style="q">che k'ulun qe'ye' twitz toju' tja xjan tb'anilxi'x.</para>
  <para style="b" />
  <para style="q">
    <verse number="3" style="v" />In q'ajti tq'ojq'ojel twi' Qman Dyos tib'aj ninnjab';</para>
  <para style="q">tu'n Dyos nim tajwalil nq'ajta':</para>
  <para style="q">¡atite Qman Dyos tib'ajile tnimal ninnjab'!</para>
  <para style="q">
    <verse number="4" style="v" />Inxi'x q'ajtiju' tq'ojq'ojel twi' Qman Dyos kuw;</para>
  <para style="q">inxi'x tinun tq'ojq'ojel twi' b'a'nxi'x;</para>
  <para style="q">
    <verse number="5" style="v" />inche kub' jachju' tq'ob' tze k'ute tu'nju' tq'ojq'ojel twi' Qman Dyos.</para>
  <para style="q">¡Inche kub'tjachu'n Qman Dyos tze toj Lib'ano!</para>
  <para style="q">
    <verse number="6" style="v" />Nche lu'lunju' witz Lib'ano ex Siriyon tu'n;</para>
  <para style="q">¡nche t'ikpuj tu'n, kse'nqe' tman wakx ex qpoj tman wakx!</para>
  <para style="q">
    <verse number="7" style="v" />Intzaj t-xon tq'ojq'ojel twi' Qman Dyos tqan taq' q'aq';</para>
  <para style="q">
    <verse number="8" style="v" />inche lu'lun chq'ajlaj tu'n tq'ojq'ojel twi' Qman Dyos;</para>
  <para style="q">¡tu'n inlu'luna' chq'ajlaj Kades!</para>
  <para style="q">
    <verse number="9" style="v" />Majx nche b'ajtchto'n tq'ojq'ojel twi' Qman Dyos b'ansi</para>
  <para style="q">ex mixti' jun wi'tl tze in kyej tq'o'n toj k'ul.</para>
  <para style="q">Kykyaqil nche nimam te toju' tja.</para>
  <para style="b" />
  <para style="q">
    <verse number="10" style="v" />Ate Qman Dyos in nk'unteju' jb'al;</para>
  <para style="q">¡a Qman Dyos nimaqkawil nkawin tejumajx!</para>
  <para style="q">
    <verse number="11" style="v" />Intq'o'n Qman Dyos tipumalju' ttanam;</para>
  <para style="q">ex inkub' tky'i'wla'n tuk'i'l nak'b'il, chiju' b'itzal.</para>
  <chapter number="30" style="c" />
  <para style="s1">B'itz aq'b'il chjonte te Qman Dyos</para>
  <para style="q">
    <verse number="1" style="v" />Kjawil nnima'na, Nman Dyos</para>
  <para style="q">qu'n machin klete' tu'na,</para>
  <para style="q">ex min xtaja</para>
  <para style="q">tu'n nb'aj xmayine' kyu'n wajq'oje.</para>
  <para style="q">
    <verse number="2" style="v" />Nman Dyos,</para>
  <para style="q">xinqanine' o'nb'il teya, ex machin tq'anaya;</para>
  <para style="q">
    <verse number="3" style="v" />Nman Dyos, machin tkola teju' kamik;</para>
  <para style="q">matzaj tq'o'na nchwinqlale', ex min ẍin kyime'.</para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" />Aye'ye' tnik'alkyi'je' twitz Qman Dyos, ¡che b'itzan b'itze' te!,</para>
  <para style="q">¡kyb'itzanxju'ye' tb'i xjan!</para>
  <para style="q">
    <verse number="5" style="v" />Qu'n naq jun kmuj ntenju' ttx'u'jil,</para>
  <para style="q">atzu'n t-xtalb'il kukx ttenju' toj tkyaqil qchwinqlal.</para>
  <para style="q">Qama qo oq' te qonik'an,</para>
  <para style="q">qo tzalajel te prim.</para>
  <para style="b" />
  <para style="q">
    <verse number="6" style="v" />Okqexi'xwe' nk'u'j, ex kub' nxima'ne':</para>
  <para style="q">Milo najchi'j tu'nkub' tz'aqwe'.</para>
  <para style="q">
    <verse number="7" style="v" />Atzunta Nman Dyos,</para>
  <para style="q">matxitoq chin kub'twab'a'na b'a'nxi'x tu'n t-xtalb'ila.</para>
  <para style="q">Tetzunj min sonintla wi'je'</para>
  <para style="q">machin kub'chukjiye' tu'nju' xob'il.</para>
  <para style="b" />
  <para style="q">
    <verse number="8" style="v" />Nman Dyos, teya njawa' tq'ojq'ojel nwi'ye';</para>
  <para style="q">twitza nchin kub'sana'ye', Nman Dyos:</para>
  <para style="q">
    <verse number="9" style="v" />¿titi' tajb'en qama chin kyime',</para>
  <para style="q">ex tu'n nxi'q'i'ne' toj muqb'il?</para>
  <para style="q">¡lay b'entl tnimanju' quq teya</para>
  <para style="q">ex lay yolintl ti'ju' tyola ax!</para>
  <para style="q">
    <verse number="10" style="v" />Nman Dyos, chin tb'itza ex q'aq'antz tk'u'ja wi'je';</para>
  <para style="q">Nman Dyos, ¡chin toniya!</para>
  <para style="b" />
  <para style="q">
    <verse number="11" style="v" />Matz'okju' njiq'cha'ne' tu'na te tzalajb'il;</para>
  <para style="q">matz'el tiq'i'nju'ya b'is wi'je',</para>
  <para style="q">ex machin oktktxu'na tu'n tzalajb'il.</para>
  <para style="q">
    <verse number="12" style="v" />Qu'mtzun, Nman Dyos,</para>
  <para style="q">lay chin kyejtene' kukxju':</para>
  <para style="q">¡kjawil wajwali'ne' tb'iya kyuk'i'l b'itz</para>
  <para style="q">ex kxe'l nq'o'n chjonteye' teya kukxju'!, chiju' b'itzal.</para>
  <chapter number="31" style="c" />
  <para style="s1">Tu'n tqexi'x qk'u'j ti'j Qman Dyos</para>
  <para style="q">
    <verse number="1" style="v" />Nman Dyos, tuk'i'la in njyo'na'ye' kolb'il;</para>
  <para style="q">¡lalun taja tu'n tel nch'ixawe'!</para>
  <para style="q">¡Chin tkloma, qu'n tz'aqli ta!</para>
  <para style="q">
    <verse number="2" style="v" />Chin tb'intza;</para>
  <para style="q">¡chin tkloma ja'loxi'x!</para>
  <para style="q">Tz'okxwita kse'n jun nin ab'j te kolb'ilweye',</para>
  <para style="q">¡tz'okxwita te wewb'ile' tu'n nklete'!</para>
  <para style="q">
    <verse number="3" style="v" />¡Aya nin ab'j ex ja te kolb'ilweye'!</para>
  <para style="b" />
  <para style="q">¡Chin t-ẍaqluma ex chin t-xq'uqima; tu'n tb'ent nnimanteye' tb'iya!</para>
  <para style="q">
    <verse number="4" style="v" />¡Chin tiq'imitza toju' xpatxab' kub'ni q'o'n nwitze',</para>
  <para style="q">qu'n a na'ta klol weye'!</para>
  <para style="q">
    <verse number="5" style="v" />Kxe'l woqxena'ne' wanmiye' toj tq'ob'a;</para>
  <para style="q">¡chin tkloma, Wajaw, aya Dyos axxi'x!</para>
  <para style="b" />
  <para style="q">
    <verse number="6" style="v" />Inche elwik'o'ne' k'lul witzileb' mixti' kyajb'en.</para>
  <para style="q">Matxi' tz'okqewe' nk'u'j ti'j Qman Dyos.</para>
  <para style="q">
    <verse number="7" style="v" />Intzaj tq'o'n tk'u'jlalila tzalajb'il ex nak'b'il weye'.</para>
  <para style="q">Matila machin b'isune',</para>
  <para style="q">tojtzqi'na k'ixk'oj ntzaj wi'je';</para>
  <para style="q">
    <verse number="8" style="v" />min ẍinx tq'o'na toj kyq'ob'ju' wajq'oje;</para>
  <para style="q">¡Machin kub'we'ye' toj nkub'ele' b'a'n tu'na!</para>
  <para style="b" />
  <para style="q">
    <verse number="9" style="v" />Nman Dyos, q'aq'antz tk'u'ja wi'je',</para>
  <para style="q">qu'n xob'ajilx atinqina'ye'.</para>
  <para style="q">Matxi' tz'el kyipumalju' nwitze',</para>
  <para style="q">¡tkyaqil toj nwinqile' in ch'yon!</para>
  <para style="q">
    <verse number="10" style="v" />¡Matxi' chin kub'e' tu'n k'ixk'oj ex oq'el</para>
  <para style="q">ex noq ch'inx nkyime'!</para>
  <para style="q">Matxi' chin kub' numje' tu'n b'is,</para>
  <para style="q">¡Mixti'tl wipumale'!</para>
  <para style="b" />
  <para style="q">
    <verse number="11" style="v" />Matxi' chin nokye' te kytzeb'e'tz wajq'oje,</para>
  <para style="q">ex te kyxmayb'il najlqe' wi'jileye',</para>
  <para style="q">xob'ajilqinxe' kyeju' ojtzqi'nqine' kyu'n.</para>
  <para style="q">¡Kykyaqilju' nche okyal nwitze' nche el oq!</para>
  <para style="q">
    <verse number="12" style="v" />Majx matxi' tzik'nna'le' kyu'n,</para>
  <para style="q">naku'j oje chin kyime' kye.</para>
  <para style="q">Ikqinju'ye' kse'n jun xar kub'ni b'uchj.</para>
  <para style="q">
    <verse number="13" style="v" />In nb'i'ne' nche jasjne xjal wi'je':</para>
  <para style="q">Jaxjaku' atinqina'ye' nchin xob'e'.</para>
  <para style="q">Inkb'u'yi'nkyib' tu'n kyyolin wi'je';</para>
  <para style="q">¡inche ximan tu'n nkub' kyb'yo'ne'!</para>
  <para style="b" />
  <para style="q">
    <verse number="14" style="v" />Ayintzunwe', q'uqlok nk'u'je' ti'ja, Nman Dyos;</para>
  <para style="q">oje nmaye': ¡Ateju'ya Nman Dyos!</para>
  <para style="q">
    <verse number="15" style="v" />Toj tq'ob'a ta'ju' nchwinqlale';</para>
  <para style="q">¡chin tkloma kyeju' wajq'oje, inche jyon wi'je'!</para>
  <para style="q">
    <verse number="16" style="v" />Chin tka'yintza tu'n t-xtalb'ila ayine' tmajena,</para>
  <para style="q">chin tkloma, tu'n tk'u'jlalila.</para>
  <para style="q">
    <verse number="17" style="v" />inchin kub'sane' teya Nman Dyos;</para>
  <para style="q">¡lalun taja tu'n tel nch'ixawe'!</para>
  <para style="q">¡Aye'wtu' aj il tz'el kych'ixaw;</para>
  <para style="q">che ku'xwit qoptz'aj tzmax t-xexi' muqb'il!</para>
  <para style="q">
    <verse number="18" style="v" />Jpet-xwit kytziju' chalyol,</para>
  <para style="q">aye' nche yolin tuk'i'l xmayb'il ex i'k'jtib'ill,</para>
  <para style="q">ex nche yolin ti'ju' xjal tnik'alti'j.</para>
  <para style="b" />
  <para style="q">
    <verse number="19" style="v" />¡Nimta t-xtalb'il kyeju' nche niman teya!</para>
  <para style="q">Intk'u'na kse'n jun k'uwenj</para>
  <para style="q">ex kywitzku' xjal,</para>
  <para style="q">nxa' t-sipa'na kyeju' q'uqlok kyk'u'j ti'ja.</para>
  <para style="q">
    <verse number="20" style="v" />Tu'nju' atiya kyuk'i'l,</para>
  <para style="q">inche tklo'na te tkyaqilju' kyxim xjal myab'a'n;</para>
  <para style="q">inche tklo'na toj tjaya</para>
  <para style="q">kyeju' kyajq'oj nche ok ik'lenkye.</para>
  <para style="b" />
  <para style="q">
    <verse number="21" style="v" />Nimanxwit tb'i Qman Dyos tu'nju' tk'u'jlalil</para>
  <para style="q">nim t-xtalb'il xtb'incha weye',</para>
  <para style="q">tej antintoqe' toj k'ixk'oj.</para>
  <para style="q">
    <verse number="22" style="v" />Tej njaw ximane' nmaye'</para>
  <para style="q">qa matxi' tzik'nna'le' tu'na;</para>
  <para style="q">atzunj txi' nqani'ne' o'nb'il teya,</para>
  <para style="q">tzaj tb'i'na tq'ojq'ojel nwi'ye'.</para>
  <para style="b" />
  <para style="q">
    <verse number="23" style="v" />Kyk'u'jlame' Qman Dyos, kykyaqile' okslalqe'xi'xe' te.</para>
  <para style="q">Inche t-xq'uqi'nte Qman Dyos ax che yolin,</para>
  <para style="q">aye'tzu'n nkynima'n kyib'</para>
  <para style="q">inkub' ttz'e'ysa'n kywitz b'a'nxi'x.</para>
  <para style="q">
    <verse number="24" style="v" />Kykuwsam kyk'u'je'</para>
  <para style="q">kykyaqile' q'uqlok kyk'u'je' ti'j Qman Dyos, chiju' b'itzal.</para>
  <chapter number="32" style="c" />
  <para style="s1">Q'mab'l il ex najsb'il il</para>
  <para style="q">
    <verse number="1" style="v" />Tzalajb'ilte' teju' xjal</para>
  <para style="q">matxi' kub' najsa'n til ex tb'inchb'aj myab'a'n.</para>
  <para style="q">
    <verse number="2" style="v" />Tzalajb'ilte' teju' xjal mixti' t-xim taq'wix</para>
  <para style="q">ex mixti' jun til nnelyal tu'n Qman Dyos.</para>
  <para style="b" />
  <para style="q">
    <verse number="3" style="v" />Tej na'mxtoq tjatz nma'ne' wile',</para>
  <para style="q">kxi'toq nkub'numje'</para>
  <para style="q">tu'n oq'e'n atl junjun q'ij,</para>
  <para style="q">
    <verse number="4" style="v" />qu'n q'ijtl ex qonik'an</para>
  <para style="q">nchin k'ixb'iye' tu'n tq'ob'a,</para>
  <para style="q">naku'j jun b'ech nkub' tzqij toj q'ijal,</para>
  <para style="q">iktoqtzun nna'ju'ye' xi'toq nkub'numje'.</para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" />B'jatztzun npa'n wiltze' ex nb'inchb'aje' myab'a'n teya</para>
  <para style="q">mixti' kub' wewa'n juntle',</para>
  <para style="q">b'jaw nma'ne' wile' teya,</para>
  <para style="q">atzunta Nman Dyos, b'ajkub' tnajsa'na.</para>
  <para style="b" />
  <para style="q">
    <verse number="6" style="v" />Qu'mtzun che kub'salju' okslalqe'xi'x teya</para>
  <para style="q">toju' kmuj te k'ixk'oj,</para>
  <para style="q">b'a'ntzun qa ati tnimal a' in toloq'in,</para>
  <para style="q">lay pon kanun kyi'j.</para>
  <para style="q">
    <verse number="7" style="v" />Aya kolb'ilweye':</para>
  <para style="q">nchin tklo'na teju' xob'ajil,</para>
  <para style="q">nttxoli'na wi'je' kyu'n sich' te tzaqpib'l.</para>
  <para style="b" />
  <para style="q">
    <verse number="8" style="v" />Intma'n Qman Dyos kjalu:</para>
  <para style="q">Majx toknwitze' ti'ja.</para>
  <para style="q">Ayine' chin xnaq'tzalteya,</para>
  <para style="q">kxe'l nq'o'n tnab'la,</para>
  <para style="q">kxe'l nyek'u'ne' b'e teya ju' ati tu'n txi' tiq'i'na.</para>
  <para style="q">
    <verse number="9" style="v" />Lalun tz'oka naku'j chej,</para>
  <para style="q">minti' nb'in ex mixti' tnab'l</para>
  <para style="q">ati tu'n tokx k'uxb'il toj ttzi tu'n ttzaj jk'et,</para>
  <para style="q">qatzun min lay tzaj lq'e tk'etza.</para>
  <para style="b" />
  <para style="q">
    <verse number="10" style="v" />Aju' tk'u'jlalil Qman Dyos,</para>
  <para style="q">nktxunkyeju' q'uqlok kyk'u'j ti'j,</para>
  <para style="q">aye'tzu'n b'inchal il kche yajtel b'a'nxi'x.</para>
  <para style="q">
    <verse number="11" style="v" />Che tzalajxe' ti'j Qman Dyos,</para>
  <para style="q">aye'ye' b'a'n xjal qe'ye' ex tnik'alkyi'je' twitz Dyos;</para>
  <para style="q">¡che tzalajxe' ex che ẍch'inqe'ye' tu'n kytzalajb'ile'!, chiju' b'itzal.</para>
  <chapter number="33" style="c" />
  <para style="s1">B'itz aq'b'il chjonte te Qman Dyos</para>
  <para style="q">
    <verse number="1" style="v" />Che kub'sanqe'ye' twitz Qman Dyos b'a'n xjal;</para>
  <para style="q">tb'anilxi'xte' b'itz inetz toj kytziju' b'a'n xjal.</para>
  <para style="q">
    <verse number="2" style="v" />Kyq'onx chjonteye' te Qman Dyos tuk'i'l chnab' arpa,</para>
  <para style="q">kyb'itzanxe' b'itz tuk'i'l tq'ojq'ojel chnab' tzintzin,</para>
  <para style="q">
    <verse number="3" style="v" />kyb'itzanxe' jun ak'a'j b'itz,</para>
  <para style="q">¡kyq'ajtzanx kychinab'e' nk'u'n tb'anilxi'x aj kyb'itzane'!</para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" />Axxi'xte' tyol Qman Dyos;</para>
  <para style="q">kyu'nju' tb'inchb'en nq'ancha'lixa'.</para>
  <para style="q">
    <verse number="5" style="v" />Intk'u'jla'nte Qman Dyos tnik'alilti'j exju' tzinun;</para>
  <para style="q">¡ati tk'u'jlalil toj tkyaqil twitz tx'otx'!</para>
  <para style="q">
    <verse number="6" style="v" />B'aj b'entju' kya'j ex kykyaqilju' che'w</para>
  <para style="q">tu'n tyol Qman Dyos</para>
  <para style="q">tu'nju' t-xew xit-xupi'n.</para>
  <para style="q">
    <verse number="7" style="v" />Ate Dyos k'u'lteju' a'</para>
  <para style="q">toju' ninnjab' nim t-xe.</para>
  <para style="b" />
  <para style="q">
    <verse number="8" style="v" />Kynimanktze' Qman Dyos kykyaqile' ate'ye' twitz tx'otx';</para>
  <para style="q">¡che nimane' te, kykyaqile' najlqe'ye' toj tkyaqil twitz tx'otx'!</para>
  <para style="q">
    <verse number="9" style="v" />Qu'n yolin, ex b'enti tkyaqil;</para>
  <para style="q">a q'mante, ex tkyaqil kyej b'enti.</para>
  <para style="b" />
  <para style="q">
    <verse number="10" style="v" />Ate Qman Dyos inkub' xitunte</para>
  <para style="q">tkyaqil kyximju' tnam nche niman kye txqantl dyos,</para>
  <para style="q">
    <verse number="11" style="v" />aye'tzunkye tb'is tk'u'j Qman Dyos</para>
  <para style="q">kukx kytenju' tejumajx.</para>
  <para style="q">
    <verse number="12" style="v" />Tzalajb'il ta'te' tnam nk'ulun teku' Qman Dyos,</para>
  <para style="q">aju' jawni t-sk'o'n te ttanam.</para>
  <para style="b" />
  <para style="q">
    <verse number="13" style="v" />In ka'yin te Qman Dyos kyib'aj kykyaqil xjal</para>
  <para style="q">tzmax toj kya'j;</para>
  <para style="q">
    <verse number="14" style="v" />tzmax janajla'</para>
  <para style="q">nka'yin kyeju' najlqe' twitz tx'otx';</para>
  <para style="q">
    <verse number="15" style="v" />Ate kub' b'inchanteju' kyanmi</para>
  <para style="q">ex in tka'yi'n tkyaqilju' nkyb'incha'n.</para>
  <para style="b" />
  <para style="q">
    <verse number="16" style="v" />Mixti'te nimaqkawil nklet kyu'n txqan t-xjal te q'oj,</para>
  <para style="q">ex lay kletju' xjal te q'oj tu'nx tipumal;</para>
  <para style="q">
    <verse number="17" style="v" />mixti'x kyajb'entu' chej tu'n tklet jun xjal;</para>
  <para style="q">b'a'ntzun qa nim kyipumal, lay b'ent kykolon.</para>
  <para style="b" />
  <para style="q">
    <verse number="18" style="v" />Atzunte Qman Dyos kukx t-xq'uqinju'</para>
  <para style="q">kyi'ju' nche niman te ex q'uqlok kyk'u'j ti'ju' tk'u'jlalil,</para>
  <para style="q">
    <verse number="19" style="v" />tu'n kyklet te kamik</para>
  <para style="q">ex tu'n tq'o'nte kychwinqlal toj tq'ijlalil we'yaj.</para>
  <para style="b" />
  <para style="q">
    <verse number="20" style="v" />Q'uqliqe qk'u'j ti'j Qman Dyos;</para>
  <para style="q">¡Ate onilqe ex xq'uqilqe!</para>
  <para style="q">
    <verse number="21" style="v" />Intzalaj qanmi ti'j Qman Dyos;</para>
  <para style="q">q'uqli qk'u'j b'a'nxi'x ti'ju' tb'i xjan.</para>
  <para style="q">
    <verse number="22" style="v" />¡Tenwtju' tk'u'jlalila quk'i'le', Nman Dyos</para>
  <para style="q">qu'n atzu' q'uqla' qk'u'je' ti'ja!, chiju' b'itzal.</para>
  <chapter number="34" style="c" />
  <para style="s1">B'itz te Qman Dyos tu'nju' t-xtalb'il</para>
  <para style="q">
    <verse number="1" style="v" />Kjawil nnima'ne' Qman Dyos tkyaqil kmuj;</para>
  <para style="q">kchin b'itzale' kukxju' te.</para>
  <para style="q">
    <verse number="2" style="v" />Inxi'x chin tzalajwe' ti'j Qman Dyos;</para>
  <para style="q">¡Kyb'ime' ex che tzalajxe', me's qe'ye'!</para>
  <para style="q">
    <verse number="3" style="v" />Qo'qe' b'itzan junx,</para>
  <para style="q">ti'ju' nim toklen tb'i Qman Dyos.</para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" />Inkub'sane' te Qman Dyos, ex intzaj ttzaq'we'ne',</para>
  <para style="q">ex machin tkole' te tkyaqil xob'ajil</para>
  <para style="q">
    <verse number="5" style="v" />Okxi'x che tzalajelju'</para>
  <para style="q">tokkywitz ti'j Qman Dyos</para>
  <para style="q">ex layx tz'el kych'ixaw.</para>
  <para style="q">
    <verse number="6" style="v" />Jaw ẍch'inju' prow lu, ex tzaj tb'i'n Qman Dyos</para>
  <para style="q">ex tkol toj tkyaqilju' yajb'ilte.</para>
  <para style="q">
    <verse number="7" style="v" />In xq'uqinju' tanjl Qman Dyos ex inkolon</para>
  <para style="q">kyi'ju' nche niman te.</para>
  <para style="q">
    <verse number="8" style="v" />Tz'elx kynik'e', qa b'a'n te Qman Dyos.</para>
  <para style="q">¡Tzalajb'il ta'te' xjal q'uqlok tk'u'j ti'j!</para>
  <para style="q">
    <verse number="9" style="v" />Kynimanktze' Qman Dyos, xjansa'n kyib'e',</para>
  <para style="q">qu'n ntzaj tq'o'n tkyaqilju' ati tajb'en kyeju' nche niman te.</para>
  <para style="q">
    <verse number="10" style="v" />Inche kub'prowixju' q'inun, ex nche ok toj we'yaj,</para>
  <para style="q">aye'tzu'n nche jyon ti'j Dyos, ktenb'il tkyaqilju' b'a'n kye.</para>
  <para style="b" />
  <para style="q">
    <verse number="11" style="v" />Che lq'etze' nk'wal, ex chin kyb'inku'ye':</para>
  <para style="q">che kxe'l nxnaq'tza'ne' tu'n kynimane' te Qman Dyos.</para>
  <para style="q">
    <verse number="12" style="v" />¿Ma tajb'ila tu'n tanq'ina nimtoj?</para>
  <para style="q">¿Ma tajb'ila tu'n ttzalaja toju' chwinqlal?</para>
  <para style="q">
    <verse number="13" style="v" />Jk'um taq'a kyi'j xlab'yol,</para>
  <para style="q">ex lalun chanyola.</para>
  <para style="q">
    <verse number="14" style="v" />Pa'mil tib'a ti'ju' myab'a'n, ex b'inchamju'ya b'a'n;</para>
  <para style="q">jyomju'ya nak'b'il ex ljonxa.</para>
  <para style="b" />
  <para style="q">
    <verse number="15" style="v" />Ate Qman Dyos xq'uqilkyeju' tnik'alkyi'j</para>
  <para style="q">ex ntzaj tb'i'nju' kykub'sb'il.</para>
  <para style="q">
    <verse number="16" style="v" />Inq'ojin Qman Dyos kyi'ju' b'inchal myab'a'n,</para>
  <para style="q">tu'n kynaj twitz tx'otx' ex tu'n miche tzaja' na'ntl.</para>
  <para style="q">
    <verse number="17" style="v" />Intzaj tb'i'n te Qman Dyos tkub'sb'ilju' xjal tnik'alti'j,</para>
  <para style="q">ex intklo'n toj tkyaqilju' yajb'ilte.</para>
  <para style="q">
    <verse number="18" style="v" />Nqaku' ta'te Qman Dyos klolkyeju' nche' b'isun</para>
  <para style="q">ex mixjaloja tu'n toka'qe kyk'u'j.</para>
  <para style="b" />
  <para style="q">
    <verse number="19" style="v" />Inik'ju' xjal tnik'alti'j toj chukchaq joyb'ilti'j,</para>
  <para style="q">atzunte Qman Dyos nklonte toj tkyaqil ja'lu.</para>
  <para style="q">
    <verse number="20" style="v" />Tkyaqilju' tb'aqil xq'uqi'n tu'n Dyos;</para>
  <para style="q">ex mix-a'lo' jun kb'el toqinte.</para>
  <para style="q">
    <verse number="21" style="v" />Aye'tzu'n aj il tu'nxju' kyil nche kyima';</para>
  <para style="q">kb'el tz'e'ysa'n kywitzju' ntx'a'lti'j kyk'u'j kyi'ju' tnik'alkyi'j.</para>
  <para style="q">
    <verse number="22" style="v" />Atzunte Qman Dyos inklonkyeju' tmajen;</para>
  <para style="q">¡lay kub' ttz'e'ysa'n kywitzju' q'uqlok kyk'u'j ti'j!, chiju' b'itzal.</para>
  <chapter number="35" style="c" />
  <para style="s1">Na'j Dyos qanb'il o'nb'il te Qman Dyos</para>
  <para style="q">
    <verse number="1" style="v" />Nman Dyos, mqom kywitzju'ya wajq'oje;</para>
  <para style="q">q'ojina kyuk'i'lju' kyajb'il tu'n kyq'ojin wi'je'.</para>
  <para style="q">
    <verse number="2" style="v" />Q'intzju'ya tkolb'ila ex kuttzaja onilweye';</para>
  <para style="q">
    <verse number="3" style="v" />q'intza tch'uta ex we'ku'ya kywitzju' ljol weye';</para>
  <para style="q">¡q'mantza qa aya klol weye'!</para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" />Che kub'xwit oq tu'n kych'ixaw</para>
  <para style="q">ju' kyajb'il tu'n nkub' kyb'yo'ne';</para>
  <para style="q">che kub'xwit oq tu'n kych'ixaw</para>
  <para style="q">ju' kyajb'il tu'n kyb'inchante jun taq'wixil wi'je';</para>
  <para style="q">
    <verse number="5" style="v" />¡che okxwit kse'n ttxa triy nche'x iqi'n tu'n kyq'iq',</para>
  <para style="q">ajkyex xla'ja'n tu'n tanjl Qman Dyos!</para>
  <para style="q">
    <verse number="6" style="v" />¡Tz'okxwitju' kyb'e qxopin ex ẍb'ilun</para>
  <para style="q">ajkyb'jik' xla'ja'n tu'n tanjl Qman Dyos!</para>
  <para style="q">
    <verse number="7" style="v" />Mixti' wile' kye, ex makub' kyq'o'n jun xpatxab' weye';</para>
  <para style="q">mixti' xnb'inchaye' kye, ex ma ku'x kyb'incha'n jun jul tu'n nku'x tz'aqe' toj.</para>
  <para style="q">
    <verse number="8" style="v" />¡Tzajxwit jun taq'wixil kyxol!</para>
  <para style="q">¡Che kub'xwit tz'aq tojxju' kyxpatxab'!</para>
  <para style="q">¡Kub'xwit kyk'ulb'a'n jun ti'xti' myab'a'n!</para>
  <para style="b" />
  <para style="q">
    <verse number="9" style="v" />Chin tzalajeltzuntze' ti'j Qman Dyos,</para>
  <para style="q">qu'n matxi'toq chin klete' tu'n.</para>
  <para style="q">
    <verse number="10" style="v" />Knma'ye' tu'n tkyaqil nk'u'je':</para>
  <para style="q">¿Alxi'xkye jun kse'n aya Nman Dyos?</para>
  <para style="q">Inche tklo'nju'ya prow exqe' ati nojqelan kye</para>
  <para style="q">toj kyq'ob'ju' kuwqe' kyekywitz,</para>
  <para style="q">ex kyeju' nche elq'an kyi'j, nchiky'ye'.</para>
  <para style="b" />
  <para style="q">
    <verse number="11" style="v" />Inkyma'n b'inchal myab'a'n chajyolil wi'je'</para>
  <para style="q">ex nchin kypoqo'ne' kyi'j ti'xti' min kanli nwitze'.</para>
  <para style="q">
    <verse number="12" style="v" />Taq'wix xkyb'incha weye' tu'nju' b'a'n xnb'inchaye' kye,</para>
  <para style="q">intzaj txqan nb'ise' tu'n tpaj ja'lu;</para>
  <para style="q">
    <verse number="13" style="v" />qu'n tej ntoq che kub' yab'ti</para>
  <para style="q">tzaj nb'ise' kyi'j,</para>
  <para style="q">intoq oknq'o'n wi'je' te b'is ex intoq chin mewayine',</para>
  <para style="q">ex mixtoqti' nchin q'jene' tu'n nna'n Dyose' toj wanmiye'.</para>
  <para style="q">
    <verse number="14" style="v" />Intoq chin numje' nchin b'ete' tu'n b'is,</para>
  <para style="q">naku'j makyim ntxuye',</para>
  <para style="q">jun wuk'i'le' mujqa jun ntzikku'ye'.</para>
  <para style="q">
    <verse number="15" style="v" />Tetzu'n ẍinkub' tz'aqe',</para>
  <para style="q">kykyaqil ẍeb'jaw tze'n wi'je';</para>
  <para style="q">naku'j najchaq xjal qine' ex min ojtzqi'nqine' kye,</para>
  <para style="q">ex min nche qen tu'n kywulin wi'je'.</para>
  <para style="q">
    <verse number="16" style="v" />Machin b'ajkyyajla'ne' ex machin b'ajkxmayine',</para>
  <para style="q">inxi'x tx'u'jin kywitz ajkytzaj ka'yin weye'.</para>
  <para style="b" />
  <para style="q">
    <verse number="17" style="v" />Nman Dyos, ¿jte'lo q'ijtl naq kka'yila ti'j ja'lu?</para>
  <para style="q">¡Klom ch'iwe' nchwinqlale',</para>
  <para style="q">kyeju' b'alun nche' tzanunk wi'je' lu!</para>
  <para style="q">
    <verse number="18" style="v" />Chin q'olwe' chjonte teya kywitzju' ttanama nim kyajlal;</para>
  <para style="q">¡kjawil wajwali'na kywitzju' tnam xjal!</para>
  <para style="b" />
  <para style="q">
    <verse number="19" style="v" />Lalun che b'jaw tzalaju' wajq'oje wi'je';</para>
  <para style="q">lalun taq'a anb'il tu'n kyxmayin wi'je', mixti'we' wil kye.</para>
  <para style="q">
    <verse number="20" style="v" />Qu'n min nkyjyo'n kye'lu nak'b'il,</para>
  <para style="q">xi'pe' nkyximana' tu'n kyb'inchan jun ti'xti' taq'wix</para>
  <para style="q">kyi'ju' xjal me'sqe' toju' tnam;</para>
  <para style="q">
    <verse number="21" style="v" />inxi' kyk'ab'u'n toj kytzi wi'je', ex inkyma'n ¡ja ja'!</para>
  <para style="q">¡Ka'yinxtzuna la, matxi' qila tu'n qwitze'! chechij.</para>
  <para style="b" />
  <para style="q">
    <verse number="22" style="v" />¡Matilta Taye!</para>
  <para style="q">¡Lalun noqxwit tzaj b'ina!</para>
  <para style="q">¡Lalun tz'el tpa'ntib'a wi'je'!</para>
  <para style="q">
    <verse number="23" style="v" />Iq'i'nktz tib'a, Nman Dyos,</para>
  <para style="q">b'inchama tu'me'l b'a'n weye', yolina wi'je'.</para>
  <para style="q">
    <verse number="24" style="v" />Chin tq'onka toj xjel, Nman Dyos,</para>
  <para style="q">qu'n tz'aqli ta.</para>
  <para style="q">¡Tu'n lalun che b'jaw tze'n wi'je'!</para>
  <para style="q">
    <verse number="25" style="v" />Tu'n lalun kyma ex tu'n lan kub' kyxima'n:</para>
  <para style="q">¡Atzun qajb'ilju'ye' lu!</para>
  <para style="q">¡Majx matxi' kub'o'lj qu'ne'! chechiwt.</para>
  <para style="q">
    <verse number="26" style="v" />Tz'elxwit kych'ixaw</para>
  <para style="q">ju' nche tzalaj tu'n nkub' b'o'lje';</para>
  <para style="q">tz'elxwit kych'ixaw b'a'nxi'x</para>
  <para style="q">ju' nkyxima'n qa nimxi'x kynab'l nwitze'.</para>
  <para style="b" />
  <para style="q">
    <verse number="27" style="v" />Aye'tzu'n kyajb'il tu'n nkanb'ane'</para>
  <para style="q">che tzalajxwit ex che ẍch'inxwit tu'n kytzalajb'il;</para>
  <para style="q">ex tu'n kmante kukxju':</para>
  <para style="q">¡Nim te Qman Dyos toklen,</para>
  <para style="q">ex a ttzalajb'ilju' tu'n tten tmajen b'a'n! chechiku'.</para>
  <para style="q">
    <verse number="28" style="v" />Kchin yolile' ti'ju' tz'aqli ntb'incha'na;</para>
  <para style="q">¡kb'ajel q'ij wu'ne' tu'n nb'itzane' teya!, chiju' b'itzal.</para>
  <chapter number="36" style="c" />
  <para style="s1">Til xjal ex t-xtalb'il Dyos</para>
  <para style="q">
    <verse number="1" style="v" />Tokju' il jask'ulte toj tanmiju' b'inchal myab'a'n.</para>
  <para style="q">Mixti'xtzun nximan</para>
  <para style="q">qa ati tu'n qxob' te Dyos.</para>
  <para style="q">
    <verse number="2" style="v" />Toj twitz qa b'a'n tu'n tjaw nima'n,</para>
  <para style="q">exqa lay tz'el ik'o'nju' til.</para>
  <para style="q">
    <verse number="3" style="v" />Taq'wix yolin ex chalyol,</para>
  <para style="q">matz'el tzpet tnab'l, ex mixti'tl ntb'incha'n.</para>
  <para style="q">
    <verse number="4" style="v" />Kse'n kuẍli toj tkuẍb'il, innaq'wi ximal tu'nt-xi' b'inchalte myab'a'n;</para>
  <para style="q">matxi' nq'et toju' tb'e myab'a'n</para>
  <para style="q">ex min tajb'il tu'n tkyej ttzaqpi'nju' il.</para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" />Atzunta tk'u'jlalil, Nman Dyos, nimxi'x, npon tzmax twitz ẍkul kya'j;</para>
  <para style="q">in nik'ju' tyola tzmax tib'ajxi' muj.</para>
  <para style="q">
    <verse number="6" style="v" />Ikyqe' tkawb'ilju'ya kse'nqe' nimaq witz;</para>
  <para style="q">ikyqe' tchaq'b'ilju'ya kse'n ninnjab' nim t-xe.</para>
  <para style="q">Nman Dyos, nche t-xq'uqi'n teju'ya xjal ex alu'mj.</para>
  <para style="q">
    <verse number="7" style="v" />¡Tb'anilxi'xju' tk'u'jlalila Nman Dyos!</para>
  <para style="q">¡Nkyjyo'n xjal kolb'ilkye tjaq' t-xik'a!</para>
  <para style="q">
    <verse number="8" style="v" />Ex majx nqe kyk'u'j</para>
  <para style="q">tu'nju' nim wab'j ati toj tjaya;</para>
  <para style="q">nxitq'o'na kyk'wa' ti'ju' nin a' tchi'yalxi'x,</para>
  <para style="q">
    <verse number="9" style="v" />qu'n ti'jta ta'ya'ju' a' te chwinqlal</para>
  <para style="q">ex in qka'yi'nju'ye' spik'un toju' t-spik'umala.</para>
  <para style="b" />
  <para style="q">
    <verse number="10" style="v" />K'u'jlana kukxju' ex b'inchama tnik'alilti'j</para>
  <para style="q">kyeju' ojtzqi'na kyu'n,</para>
  <para style="q">kyeju' tnik'alkyi'j twitza.</para>
  <para style="q">
    <verse number="11" style="v" />Lalun taja tu'n nkub' wab'e'ne' kyu'nju' nimal kyib'</para>
  <para style="q">ex tu'n lalun chin b'aj kyxt'u'yla'ne' b'inchal myab'a'n.</para>
  <para style="q">
    <verse number="12" style="v" />¡Kyka'yinxe' se'ntaq'wi nche kub' tz'aqju' b'inchal il!</para>
  <para style="q">¡Majx nche kub' tz'aq tu'n lalun che jawe'tl!, chiju' b'itzal.</para>
  <chapter number="37" style="c" />
  <para style="s1">Qek tk'u'ja ti'j Qman Dyos</para>
  <para style="q">
    <verse number="1" style="v" />Lalun tzaj ttx'u'jila tu'n kypaju' b'inchal myab'a'n,</para>
  <para style="q">ex lalun tzaj tx'a'lti'j tk'u'ja kyi'ju' b'inchal il,</para>
  <para style="q">
    <verse number="2" style="v" />qu'n ikyqe'ju' kse'n k'ul lwiy nche kub' tzqij;</para>
  <para style="q">¡ex nche kub'ch'u'ẍix kse'n itzaj!</para>
  <para style="b" />
  <para style="q">
    <verse number="3" style="v" />Qek tk'u'ja ti'j Qman Dyos ex b'inchamju'ya b'a'n,</para>
  <para style="q">tz'anq'ina twitz tx'otx' ex we'ku'ya toj tokslab'la.</para>
  <para style="q">
    <verse number="4" style="v" />K'u'jlama Dyos tu'n tkyaqil tanmiya,</para>
  <para style="q">ktzajel q'onte' tkyaqilju' tajb'ila.</para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" />Q'onkja tchwinqlala toj tq'ob' Qman Dyos;</para>
  <para style="q">qek tk'u'ja ti'j, tzulte' onilteya.</para>
  <para style="q">
    <verse number="6" style="v" />Tu'nte kqoptz'ajelju' ttxolilti'j ex tnik'alilti'j ntb'incha'na</para>
  <para style="q">kse'n nqoptz'aj q'ij te wanq'ij.</para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" />Numeku'ya twitz Qman Dyos;</para>
  <para style="q">naq tz'ayona te ajtul onilteya.</para>
  <para style="q">Lalun tzaj ttx'u'jila ti'ju' xjal xi'tjaw b'ent,</para>
  <para style="q">ti'ju' nximan tu'n tb'inchante myab'a'n.</para>
  <para style="b" />
  <para style="q">
    <verse number="8" style="v" />Tzaqpinkju'ya q'oj, ex lalun tx'u'jintla;</para>
  <para style="q">qu'n tu'nju' q'oj nche kub'a' ichinxi'xju' ti'xti'.</para>
  <para style="q">
    <verse number="9" style="v" />Kna' che elix xla'ja'nkye' b'inchal myab'a'n toju' tnam,</para>
  <para style="q">aye'tzu'n q'uqlok kyk'u'j ti'j Qman Dyos</para>
  <para style="q">kche etzal ti'ju' tx'otx'.</para>
  <para style="b" />
  <para style="q">
    <verse number="10" style="v" />Naqch'inxtl kyb'aju' b'inchal myab'a'n;</para>
  <para style="q">b'a'n qama jyona kyi'j, lay che okyaltl tu'na.</para>
  <para style="q">
    <verse number="11" style="v" />Aye'tzu'n me'sqe' kkyetza'ju' tx'otx'</para>
  <para style="q">ex kche anq'il tojxi'x nak'b'il.</para>
  <para style="b" />
  <para style="q">
    <verse number="12" style="v" />Intjyo'n b'inchal myab'a'n tu'me'l tu'n tb'inchan taq'wixil ti'ju' xjal tnik'alti'j,</para>
  <para style="q">ex aj t-xika'yin te ntx'a'lti'j tk'u'j.</para>
  <para style="q">
    <verse number="13" style="v" />Atzunte Qman Dyos naq ntze'n,</para>
  <para style="q">qu'n kanli twitz qa tzma nq'naxju' b'inchal myab'a'n.</para>
  <para style="b" />
  <para style="q">
    <verse number="14" style="v" />In jatz kyiq'i'n aj il kyk'uẍtx'e'nb'il toj tja ex inel kyqinu'n kysmaj</para>
  <para style="q">tu'n kykub'ju' prow exqe'ju' me's kyu'n,</para>
  <para style="q">¡tu'n kyb'yetju' b'a'n kychwinqlal!</para>
  <para style="q">
    <verse number="15" style="v" />Axtzu'n kyk'uẍtx'e'nb'il k'okyix xuyli toj kyanmi,</para>
  <para style="q">exqe'tzu'n kysmaj che b'ajel toqj.</para>
  <para style="b" />
  <para style="q">
    <verse number="16" style="v" />Aju' ch'i'n ati teju' xjal b'a'n</para>
  <para style="q">tb'anilxi'x kyetwitz txqan kyq'inumalu' b'inchal myab'a'n.</para>
  <para style="q">
    <verse number="17" style="v" />Qu'n che kb'el tnajsa'n Qman Dyosju' xjal aj il,</para>
  <para style="q">aye'tzu'n b'a'n xjal lalun che kub' tnajsa'n.</para>
  <para style="b" />
  <para style="q">
    <verse number="18" style="v" />Nxq'uqinte Qman Dyos kyi'ju' xjal mixti' kytz'ilil,</para>
  <para style="q">ex ktenb'elju' kyetzb'il tejumajx.</para>
  <para style="q">
    <verse number="19" style="v" />Lay tz'el kych'ixaw toju' tq'ijlalil yajb'il,</para>
  <para style="q">ajttzaj we'yaj, qu'n ktenb'il kywa nim.</para>
  <para style="b" />
  <para style="q">
    <verse number="20" style="v" />Kche k'antelju' b'inchal myab'a'n, naku'j tzqij k'ul;</para>
  <para style="q">Exqe'ju' ajq'oj ti'j Qman Dyos che kb'el naj kse'n sib'.</para>
  <para style="b" />
  <para style="q">
    <verse number="21" style="v" />In qanin tch'exju' b'inchal myab'a'n ex min ntchjo'ntl,</para>
  <para style="q">atzu'n xjal tnik'alti'j nchjon tk'as ex inq'on chjonte.</para>
  <para style="q">
    <verse number="22" style="v" />Aye' nche tky'iwla'n Qman Dyos, kkyetza'ju' tx'otx',</para>
  <para style="q">aye'tzu'n txko'n taq'wix kyb'aj, che b'elt-xitu'n.</para>
  <para style="b" />
  <para style="q">
    <verse number="23" style="v" />Ate Qman Dyos ẍaqlulkye xjal</para>
  <para style="q">ex nche kub' tq'o'n toju' b'e b'a'n toj twitz;</para>
  <para style="q">
    <verse number="24" style="v" />exqa mache jaw tz'aq, lay che kyejten axtzu',</para>
  <para style="q">qu'n tzyu'nqe' tu'n Qman Dyos.</para>
  <para style="b" />
  <para style="q">
    <verse number="25" style="v" />Machin nokye' ku'xun, ja'lo matxi' chin tijine',</para>
  <para style="q">ex min ẍewil jumaju'ye' ichan tnik'alkyi'j, ma'wt che kyej ttzaqpi'n Dyos</para>
  <para style="q">ex mixjaloja ẍe oka' nka'yi'n jumajuye' kyk'wal inwt che mon.</para>
  <para style="q">
    <verse number="26" style="v" />Tkyaqil maj nq'aq'an tk'u'j, ex inq'on ch'ex;</para>
  <para style="q">ky'i'wla'nqe'ju' tk'wal.</para>
  <para style="b" />
  <para style="q">
    <verse number="27" style="v" />Pa'mil tib'a ti'ju' taq'wix, ex b'inchamju'ya b'a'n,</para>
  <para style="q">ktenb'iltzun jun najb'iltzu' teya ja knajala'ya.</para>
  <para style="q">
    <verse number="28" style="v" />Qu'n intk'u'jla'nte Qman Dyos tnik'alilti'j</para>
  <para style="q">ex min nche kyajttzaqpi'nju' wa'lqe' toj kyokslab'l;</para>
  <para style="q">aye'tzu'n b'inchal myab'a'n nche kub't-xitu'n</para>
  <para style="q">ex mixti' nkyajtq'o'n kyyajil.</para>
  <para style="q">
    <verse number="29" style="v" />Kche etzalju' xjal tnik'alkyi'j ti'ju' tx'otx'</para>
  <para style="q">ex kche anq'il twitz tejumajx.</para>
  <para style="b" />
  <para style="q">
    <verse number="30" style="v" />Nyolinju' xjal tnik'alti'j tuk'i'l nab'l;</para>
  <para style="q">ex ax yolin.</para>
  <para style="q">
    <verse number="31" style="v" />Atiju' t-xnaq'tzb'il Qman Dyos toj tanmi;</para>
  <para style="q">¡layx che jaw jiktz'aju' tqan!</para>
  <para style="b" />
  <para style="q">
    <verse number="32" style="v" />Inche ka'ylaju' b'inchal myab'a'n kyi'ju' xjal tnik'alti'j,</para>
  <para style="q">tu'n kykub' tb'yo'n;</para>
  <para style="q">
    <verse number="33" style="v" />atzunte Dyos lay taj tu'n kykub'tz'aq toj kyq'ob',</para>
  <para style="q">expe' lay taj tu'n tjaw chan il kyi'j.</para>
  <para style="b" />
  <para style="q">
    <verse number="34" style="v" />Qek tk'u'ja ti'j Qman Dyos, ex okslanku'ya,</para>
  <para style="q">kjawil nima'nta tu'n, ex ktzajel tq'o'nju' tnam te tetzb'ila.</para>
  <para style="q">¡Ktka'yi'ya ajtkub' tz'e'ysa'n kywitzu' b'inchal myab'a'n!</para>
  <para style="b" />
  <para style="q">
    <verse number="35" style="v" />Matxi' wile' b'inchal myab'a'n, nojni tu'n nimjtib'il,</para>
  <para style="q">kse'n jun tze pujin toj t-xaq;</para>
  <para style="q">
    <verse number="36" style="v" />makub'naj;</para>
  <para style="q">machin jyone' ti'j, ex mixti' sokyal.</para>
  <para style="b" />
  <para style="q">
    <verse number="37" style="v" />Ka'yinxpe'ju'ya xjal tnik'alti'j ex mixti' til:</para>
  <para style="q">ktenb'el nak'b'il te toju' tq'ijlalil tzul.</para>
  <para style="q">
    <verse number="38" style="v" />Aye'tzu'n b'inchal myab'a'n che kb'el xitu'n;</para>
  <para style="q">lay che anq'intl toju' tq'ijlalil tzul.</para>
  <para style="b" />
  <para style="q">
    <verse number="39" style="v" />Atzu' ntzaja' o'nb'il kyeju' xjal tnik'alkyi'j tk'etz Dyos,</para>
  <para style="q">qu'n a kolb'ilju' kye kyoju' tq'ijlalil ch'uẍ.</para>
  <para style="b" />
  <para style="q">
    <verse number="40" style="v" />A Qman Dyos noninkye tu'n kytzaqpaj.</para>
  <para style="q">Inche ttzaqpi'n toj kyq'ob'ju' b'inchal myab'a'n, ex nche tklo'n,</para>
  <para style="q">qu'n ti'j te nkyjyo'na'ju' kolb'ilkye, chiju' b'itzal.</para>
  <chapter number="38" style="c" />
  <para style="s1">Na'j Dyos qanb'il o'nb'il te Qman Dyos</para>
  <para style="q">
    <verse number="1" style="v" />Nman Dyos, lalun chin ttzak'uya tuk'i'l ttx'u'jila</para>
  <para style="q">expe' lalun kub' ttz'e'ysa'na nwitze' toj tq'oja.</para>
  <para style="q">
    <verse number="2" style="v" />Qu'n matxi' chin k'ixb'iye' kyu'n tal t-smaja;</para>
  <para style="q">¡makub' talal tq'ob'a wib'aje'!</para>
  <para style="q">
    <verse number="3" style="v" />Tu'n ttx'u'jila wi'je' tu'n tpaju' wile',</para>
  <para style="q">yab' tkyaqil toj nwinqile'.</para>
  <para style="q">¡mixti' jun nb'aqile' b'a'nwt ta'!</para>
  <para style="q">
    <verse number="4" style="v" />Inchin yajtiye' kyu'nju' wile';</para>
  <para style="q">jun iqtz tokx wib'aje' ex lay k'is wu'ne'.</para>
  <para style="q">
    <verse number="5" style="v" />Tu'n tpaj nxnakyile',</para>
  <para style="q">nche q'ayju' nk'ixb'lene' ex nche tzu'wix.</para>
  <para style="q">
    <verse number="6" style="v" />Tkyaqil q'ij nchin b'isune',</para>
  <para style="q">tzipin wele' ex inchin numje'.</para>
  <para style="q">
    <verse number="7" style="v" />Inxi'x q'aq'lixju' tze'lwi'je' tu'n kyeq;</para>
  <para style="q">¡tkyaqil nxmilale' yab'!</para>
  <para style="q">
    <verse number="8" style="v" />Matxi' chin b'ajtx'uyje' ex mixti'tl wipumale';</para>
  <para style="q">¡inchin uxine' tu'n k'ixk'oj toj wanmiye'!</para>
  <para style="b" />
  <para style="q">
    <verse number="9" style="v" />Nman Dyos, tojtzqi'n teju'ya tb'is nk'u'je',</para>
  <para style="q">¡mya ewaj nchin jiq'chana'ye' twitza!</para>
  <para style="q">
    <verse number="10" style="v" />Inxi'x lipan wanmiye',</para>
  <para style="q">ex mixti'tl wipumale',</para>
  <para style="q">¡exqe' nche kub' sjumjixju' nwitze'!</para>
  <para style="q">
    <verse number="11" style="v" />Min nche oklq'eju' wamiwe' kyetoq qtene' kyuk'i'l exqe' nwitze'le' nk'etze',</para>
  <para style="q">tu'n tpaju' tx'a'k wi'je'.</para>
  <para style="q">
    <verse number="12" style="v" />Aye' kyajb'il tu'n nkub' kyb'yo'ne', inkub' kyq'o'n xpatxab' toj nb'eye';</para>
  <para style="q">exqe' kyajb'il tu'n kyxitun wi'je', nche yolin tu'n nb'o'lje' kyu'n</para>
  <para style="q">tkyaqil kmuj nkyxima'n myab'a'n wi'je'.</para>
  <para style="b" />
  <para style="q">
    <verse number="13" style="v" />Atzunwe' nkub' nẍkyinsa'n wib'e', naku'j min nchin b'ine';</para>
  <para style="q">ex min njqo'n ntziye', naku'j me qine'.</para>
  <para style="q">
    <verse number="14" style="v" />Ikqinju'ye' kse'n jun xjal chkyin</para>
  <para style="q">ex min jqet ttzi tu'n tklontetib'.</para>
  <para style="q">
    <verse number="15" style="v" />inchin ayone' ti'ja Nman Dyos,</para>
  <para style="q">awta txi' tzaq'wente kye.</para>
  <para style="q">
    <verse number="16" style="v" />Naq o'kx in nqani'nju'ye' tu'n lalun che tze'n wi'je',</para>
  <para style="q">tu'n lalun che b'itzan b'itz te kanb'ab'l aj nkub' tz'aqe'.</para>
  <para style="b" />
  <para style="q">
    <verse number="17" style="v" />Axxi'x, naqch'inxtl nkub' tz'aqe';</para>
  <para style="q">mixjun nq'jen junkmuju' k'ixk'oj wi'je'.</para>
  <para style="q">
    <verse number="18" style="v" />¡Kjawitz npa'nju'ye' wile',</para>
  <para style="q">qu'n matxi' tzaj nb'ise' tu'n tpaj!</para>
  <para style="q">
    <verse number="19" style="v" />Matxi' che chmetju' wajq'oje;</para>
  <para style="q">nimqe'ju' ntx'a'lti'j kyk'u'j wi'je' ex mixti' wile' kye.</para>
  <para style="q">
    <verse number="20" style="v" />Myab'a'nju' tu'me'l t-xel nkyq'o'n weye' tu'nju' b'a'n nb'incha'ne' kye;</para>
  <para style="q">qu'n nche okmiltz'uj wi'je' tu'nju' lepchqinkye' ti'ju' b'a'n.</para>
  <para style="b" />
  <para style="q">
    <verse number="21" style="v" />Nman Dyos, ¡lalun chin kyej tq'o'na njunale'!</para>
  <para style="q">Taye, ¡lalun tz'el tpa'ntib'a wi'je'!</para>
  <para style="q">
    <verse number="22" style="v" />Nman Dyos ex klol weye', ¡lwix ku'tzaja onilweye'!, chiju' b'itzal.</para>
  <chapter number="39" style="c" />
  <para style="s1">Naqch'i'n toju' qchwinqlal</para>
  <para style="q">
    <verse number="1" style="v" />Ojetoq ntziyaye' tu'n wanq'ine' b'a'n,</para>
  <para style="q">tu'n lalun chin b'inchan ile' tu'n waq'e',</para>
  <para style="q">ex tu'n njk'unte ntziye'</para>
  <para style="q">kwitzju' b'inchal myab'a'n.</para>
  <para style="q">
    <verse number="2" style="v" />Ex oknq'o'n wib'e' me: mixtoqti' nchin yoline'.</para>
  <para style="q">¡Mixtoqpe'ti'x nchin yoline' ti'ju' b'a'n!</para>
  <para style="q">Atzu'n nk'ixk'oje' xitoq tichin;</para>
  <para style="q">
    <verse number="3" style="v" />¡Inxi'xtoq q'aq'lixju' wanmiye' ttzi nk'u'je'!</para>
  <para style="q">ex kub' nximane' qa q'aq' ati woje',</para>
  <para style="q">nmatzuntze' tuk'i'l tq'ojq'ojel nwi'ye' kuw:</para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" />Taye, yek'untza weye' ja chin pomela' b'aje'</para>
  <para style="q">ex jte' ab'q'i chin anq'ile';</para>
  <para style="q">tu'n tkane toj nwitze' qa naqch'i'n toju' nchwinqlale'</para>
  <para style="q">
    <verse number="5" style="v" />Noq ch'i'n toju' nchwinqlale' saj tq'o'na;</para>
  <para style="q">mixti'x tz'oka' twitza.</para>
  <para style="q">¡Kykyaqil xjal noq jun kmuj nche ten, kse'n jun jiq'cha'n!</para>
  <para style="q">
    <verse number="6" style="v" />¡Kykyaqil xjal nche ik' twitz tx'otx' kse'n jun leku'n!</para>
  <para style="q">Mixti'x tajb'en qama kub' tchmo'n txqan tq'inumal,</para>
  <para style="q">qu'n min b'i'n tu'n alkye kjelten tajaw.</para>
  <para style="q">
    <verse number="7" style="v" />Qu'mtzun Nman Dyos, ¿Titi'tzun kb'el nyo'ne'?</para>
  <para style="q">¡Anatzu' q'uqla'we' nk'u'j ti'ja!</para>
  <para style="q">
    <verse number="8" style="v" />Chin tkloma te tkyaqilju' wile';</para>
  <para style="q">lalun taja tu'n kyxmayinju' xnak wi'je'.</para>
  <para style="b" />
  <para style="q">
    <verse number="9" style="v" />Matz'oknq'o'n wib'e' me ex min ẍin yoline',</para>
  <para style="q">qu'n aya b'inchalte tten.</para>
  <para style="q">
    <verse number="10" style="v" />Iq'imila yajb'il wib'aje';</para>
  <para style="q">matxi' chin kub'aje' tjaq'ju' yajb'il tu'n tq'ob'a.</para>
  <para style="q">
    <verse number="11" style="v" />Inttzak'u'n teju'ya xjal ajtkub' ttz'e'ysa'na twitz tu'n tpaju' til,</para>
  <para style="q">tkyaqilju' nlaq ti'j, inok kse'n quq ajtkub' t-xitu'na.</para>
  <para style="q">¡Kykyaqilju' xjal naq jun jiq'cha'nqe'!</para>
  <para style="b" />
  <para style="q">
    <verse number="12" style="v" />Nman Dyos, b'intzju'ya nna'j Dyose',</para>
  <para style="q">¡b'intzju'ya nkub'sb'ile'!,</para>
  <para style="q">¡lalun naq chin tzaj tka'yi'na ajtel ta'l nwitze'!</para>
  <para style="q">Jun najchaq xjal qinwe' teya,</para>
  <para style="q">naq ajb'etun, kse'nqe' ojtxi' nyajilb'ene'.</para>
  <para style="q">
    <verse number="13" style="v" />Iq'imil jun kmuj twitza wi'je', q'ontza anb'il tu'n ntzalaj jun kmuje',</para>
  <para style="q">na'mxku' nkyime', chiju' b'itzal.</para>
  <chapter number="40" style="c" />
  <para style="s1">Nchin tzalaje' tu'n nb'inchanteye' tajb'ila, Nman Dyos</para>
  <para style="r">(<ref loc="PSA 70">Sal 70</ref>)</para>
  <para style="q">
    <verse number="1" style="v" />Matz'ok qe nk'u'je' ti'j Qman Dyos,</para>
  <para style="q">ex tzaj tb'i'nju' tq'ojq'ojel nwi'ye' tej nkub'sane' te;</para>
  <para style="q">
    <verse number="2" style="v" />machinjatz tiq'i'ne' toju' jul te kamik,</para>
  <para style="q">machin tkole' tu'n lalun chinx mulq'aje' toj sob'on.</para>
  <para style="q">Machin kub'twab'a'ne' tib'aj pik;</para>
  <para style="q">machin tkuwsa'ye' toj nb'eye'.</para>
  <para style="q">
    <verse number="3" style="v" />Makub' tq'o'n ak'a'j b'itz toj ntziye',</para>
  <para style="q">jun b'itz te ajwalb'ilte Qman Dyos.</para>
  <para style="q">Nim xjal eb'jaw lab'ti tej kyka'yinte ja'lu</para>
  <para style="q">ex okqe kyk'u'j ti'j Qman Dyos.</para>
  <para style="q">
    <verse number="4" style="v" />¡Tzalajb'ilte' teju' xjal q'uqlok tk'u'j ti'j Qman Dyos</para>
  <para style="q">ex min ntmujb'a'ntib' kyuk'i'lju' pi'sqe' twitz Qman Dyos</para>
  <para style="q">ex kyuk'i'lju' nche k'ulun kywitz txqantl dyos!</para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" />Taye, Nman Dyos,</para>
  <para style="q">nimte' ti'xti' tb'anilqexi'x matxi' che tb'inchaya</para>
  <para style="q">nimju' t-xtalb'ila qib'aje'.</para>
  <para style="q">¡Mixti' juntl kse'n aya!</para>
  <para style="q">Naqwit b'ajx npakb'a'ne' ex tu'n nyoline' kyi'j,</para>
  <para style="q">layxlo b'aj nchik'b'anteye' tkyaqil.</para>
  <para style="b" />
  <para style="q">
    <verse number="6" style="v" />Min ntzalajta kyi'ju' chojb'il</para>
  <para style="q">ex kyi'ju' oyaj twitz awal k'ok'e'kywitz;</para>
  <para style="q">ex b'ajx tzaja' tqani'na jun chojb'il k'ok'sb'il</para>
  <para style="q">e'oyaj tu'n tnajset il.</para>
  <para style="b" />
  <para style="q">Mape' che tjaqju'ya nẍkyine' tu'n nb'inteye' tyola.</para>
  <para style="q">
    <verse number="7" style="v" />Qu'mtzun oje nmaye': Luqine' lu,</para>
  <para style="q">kse'nx tz'ib'a'n toju' tu'jil nyolin wi'je'. Nchije'.</para>
  <para style="q">
    <verse number="8" style="v" />Inchin tzalajwe' tu'n nb'inchanteye' tajb'ila Nman Dyos;</para>
  <para style="q">¡majx na'nqe'ju' t-xnaq'tzb'ila wu'ne'!</para>
  <para style="q">
    <verse number="9" style="v" />Oje txinma'ne' kywitzku' ttanama nim kyajlal</para>
  <para style="q">qa aya tz'aqlixi'x.</para>
  <para style="q">¡Nman Dyos, ojtzqi'n tu'na minti' ẍin kyej numeye'!</para>
  <para style="q">
    <verse number="10" style="v" />Min xkub' njpu'ne' kolb'il tz'aqlixi'x tu'na;</para>
  <para style="q">matxi' txinma'ne' qa in japun tyola ex ati kolb'il tu'na.</para>
  <para style="q">B'ajx kub'a' wewana'ye' tk'u'jlalila exju' tyola ax,</para>
  <para style="q">kywitzju' ttanama nim kyajlal.</para>
  <para style="b" />
  <para style="q">
    <verse number="11" style="v" />Atzunta Nman Dyos, ¡lalun txi' tewa'n twitza weye'!</para>
  <para style="q">¡Chin tkloma tu'nju' tk'u'jlalila ex tu'nju' tyola ax!</para>
  <para style="q">
    <verse number="12" style="v" />Matxi'na' chin ik'xi'ye' kyoj txqan yajb'il</para>
  <para style="q">layxpena' b'ent kyajlet wu'ne'.</para>
  <para style="q">Matxi' chin kub'jitz'liye' tu'nxju' wile';</para>
  <para style="q">¡expe' matxi' che naju' nwitze'!</para>
  <para style="q">Nimxi'x kyajlalju' wile' kywitzju' t-xya'mal nwi'ye',</para>
  <para style="q">expe' matxi' chin kub' numje'.</para>
  <para style="b" />
  <para style="q">
    <verse number="13" style="v" />Najsama Nman Dyos, ¡kuttzaja kolpilweye'!</para>
  <para style="q">Taye, ¡Lwix kuttzaja onilweye'!</para>
  <para style="q">
    <verse number="14" style="v" />¡Che kub'xwit ch'ixwi ex che kub'xwit oq</para>
  <para style="q">ju' kyajb'il tu'n nb'o'lje' kyu'n!</para>
  <para style="q">¡Che kub'xwit oq toj kych'ixaw</para>
  <para style="q">ju' kyajb'il tu'n nb'o'lje' kyu'n!</para>
  <para style="q">
    <verse number="15" style="v" />¡Che kub'xwit oqju' nche xmayin wi'je'</para>
  <para style="q">toj kych'ixaw!</para>
  <para style="q">
    <verse number="16" style="v" />Aye'tzu'n nche jyon ti'ja</para>
  <para style="q">che tzalajxwit;</para>
  <para style="q">exqe'ju' nche tzalaj ti'ju' kolb'il tu'na</para>
  <para style="q">kymaxwit kukxju': ¡Nim toklen Qman Dyos! Chechiwt.</para>
  <para style="b" />
  <para style="q">
    <verse number="17" style="v" />Lalun tzik'nna'le' tu'na, Nman Dyos</para>
  <para style="q">qu'n prowqine' ex nchin b'isune'.</para>
  <para style="q">A na'ta onilweye' ex klol weye';</para>
  <para style="q">¡Lwix kuttzaja, Nman Dyos!, Chiju' b'itzal.</para>
  <chapter number="41" style="c" />
  <para style="s1">Tna'j Dyos jun yab'</para>
  <para style="q">
    <verse number="1" style="v" />Tzalajb'ilte' teju' nximan kyi'ju' prow ex mixti' kyipumal,</para>
  <para style="q">qu'n kkletel tu'n Qman Dyos toju' tq'ijlalil ch'uẍ.</para>
  <para style="q">
    <verse number="2" style="v" />Kxq'uqinjtzel tu'n Qman Dyos,</para>
  <para style="q">kxe'l tq'o'n tchwinqlala ex ktzalajel twitz tx'otx' tu'n,</para>
  <para style="q">ex lay kyej ttzaqpi'n toj kyq'ob'ju' tajq'oj.</para>
  <para style="q">
    <verse number="3" style="v" />Ktzajel tq'o'n Qman Dyos tipumal toj k'ixk'oj twitz kuẍb'il;</para>
  <para style="q">¡kb'anixel tu'n toju' yab'il!</para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" />Oje nmaye' ikjalu:</para>
  <para style="q">Nman Dyos, q'aq'antz tk'u'ja wi'je';</para>
  <para style="q">chin tq'anama, b'a'nqa matxi' chin b'inchan ile' twitza. Nchije'</para>
  <para style="q">
    <verse number="5" style="v" />In txkonjtz toj nwi'ye' kyu'n wajq'oje, inkyma'n:</para>
  <para style="q">¿Jtojlo kyim ex tu'n tik' tna'l tejumajx? Chechij.</para>
  <para style="q">
    <verse number="6" style="v" />Mya tu'n tkyaqil kyk'u'j nche ula' nelweye';</para>
  <para style="q">ex noq k'u'jla'nju' kq'oj kyu'n,</para>
  <para style="q">ajtzun kyex toj b'e nche yolintzuntz wi'je'.</para>
  <para style="q">
    <verse number="7" style="v" />Nb'aj kyb'u'yi'n kyib'ju' ntx'a'lti'j kyk'u'j wi'je' tu'n kyolin;</para>
  <para style="q">inkyma'n qa tu'n tpaj wile' nchin yajta'ye',</para>
  <para style="q">
    <verse number="8" style="v" />ex inkyma'n:</para>
  <para style="q">Tu'nte tajaw ilju' tyab'il;</para>
  <para style="q">matxi' kub' twitz kuẍb'il ex lay jawe'tl. Chechij.</para>
  <para style="q">
    <verse number="9" style="v" />Naqpena' wamiwe' q'uqlitoq nk'u'je' ti'j,</para>
  <para style="q">aju' ntoq wan wuk'i'le', matxi' tz'ok miltz'uj wi'je'.</para>
  <para style="q">
    <verse number="10" style="v" />Atzunta Nman Dyos, q'aq'antz tk'u'ja wi'je';</para>
  <para style="q">chin tiq'i'nktza twitz kuẍb'il, tu'n nq'onte tu'me'l t-xele' kye.</para>
  <para style="q">
    <verse number="11" style="v" />Kkaneb'eltzuntz toj nwitze' qa ntzalaja wi'je':</para>
  <para style="q">qa min xtaja tu'n tkub' wi'je' kyu'n wajq'oje.</para>
  <para style="q">
    <verse number="12" style="v" />Tu'nju' nchin anq'ine' b'a'n twitza,</para>
  <para style="q">chin ttzyuma tu'n tq'ob'a,</para>
  <para style="q">chin tq'o'nku'ya twitza tejumajx.</para>
  <para style="b" />
  <para style="q">
    <verse number="13" style="v" />¡Nimanjtzxwitju' Qman Dyos janche k'uluna' Israel,</para>
  <para style="q">ja'lo ex tejumajx!</para>
  <para style="q">¡Ikxwitju'!, Chiju' b'itzal.</para>
  <chapter number="42" style="c" />
  <para style="ms">Tkab' u'j</para>
  <para style="mr">(E' b'itz <ref loc="PSA 42-72">42—72</ref>)</para>
  <para style="s1">Ti'j Dyos q'uqla'we' nk'u'j</para>
  <para style="q">
    <verse number="1" style="v" />Nman Dyos, in njyo'na,</para>
  <para style="q">ikyqinju'ye' kse'n jun msat nk'o'k'on ex njyon tk'wa' a'.</para>
  <para style="q">
    <verse number="2" style="v" />Nchin nelb'aje' ti'ja Dyos, tajaw chwinqlal.</para>
  <para style="q">¿Jtojtzunlo chinx junmajtle' twitza Nman Dyos?</para>
  <para style="q">
    <verse number="3" style="v" />Min nchin wane' tu'n tpaj nchin oq'e' q'ijtl ex qonik'an,</para>
  <para style="q">aye'tzunkye' xjal jachq'al ntzaj kyqani'n weye':</para>
  <para style="q">¿Jatzunta' Tdyosa? Chechij.</para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" />Ajtkub' nximane' tkyaqilju' ti'xti' lu,</para>
  <para style="q">majx noktchib'l ti'nk'u'je'.</para>
  <para style="q">Ajttzaj nna'ne' tej ntoq chinxe' kyuk'i'l xjal,</para>
  <para style="q">intoq che'x wiq'i'ne' toj tja Qman Dyos</para>
  <para style="q">tuk'i'l sich' te tzalajb'il ex aq'b'il chjonte.</para>
  <para style="q">¡Juntoq tzalajb'il tb'anilxi'x!</para>
  <para style="b" />
  <para style="q2">
    <verse number="5" style="v" />¿Tiqu'ntzun chin b'ela' numje'?</para>
  <para style="q2">¿Tiqu'ntzun kb'ajxe'la' nk'u'je'?</para>
  <para style="q2">Matxi'na' tz'okqewe' nk'u'j ti'ja Nman Dyos,</para>
  <para style="q2">chin b'itzale' teya kukxju'.</para>
  <para style="q2">¡Tena'ta nchin k'uluna'ye' ex aya klol weye'!</para>
  <para style="b" />
  <para style="q">
    <verse number="6" style="v" />Inxi'x ch'yon wanmiye'.</para>
  <para style="q">Qu'mtzun nxi'x chin ximane' ti'ja,</para>
  <para style="q">tzmax toj tx'otx' jata' nin a' Jordan,</para>
  <para style="q">ex tzmax ja ta'qe' witz Ermon ex Misar.</para>
  <para style="q">
    <verse number="7" style="v" />Nxi'x jukyin a' ntzaj twi' xaq</para>
  <para style="q">ajtkb'u'l tzmax t-xexi';</para>
  <para style="q">aye' tnimal t-spinpujal a' ntzaj tq'o'na</para>
  <para style="q">matxi' che ik' wib'aje'.</para>
  <para style="b" />
  <para style="q">
    <verse number="8" style="v" />Inchin tzajtk'u'jla'ne' Qman Dyos te q'ijtl,</para>
  <para style="q">tetzun qonik'an min nchin q'jene' tu'n nb'itzane'</para>
  <para style="q">ex tu'n nk'ulune' twitzju' Dyos tajaw nchwinqlale'.</para>
  <para style="q">
    <verse number="9" style="v" />Inxi' nma'ne' te Dyos, ju' klol weye':</para>
  <para style="q">¿Titiqu'n ẍin kyeja' ttzaqpi'na?</para>
  <para style="q">¿Titiqu'n ati tu'n nb'ete' toj b'is</para>
  <para style="q">ex toj yajb'il kyu'n wajq'oje? Nchije' te.</para>
  <para style="q">
    <verse number="10" style="v" />Majx inexch'yon toj nwinqile'</para>
  <para style="q">tu'nju' nchinok ik'le'ne' kyu'n wajq'oje</para>
  <para style="q">qu'n tkyaqil q'ij ntzaj kyma'n weye':</para>
  <para style="q">¿Jatzunta'ju' Tdyosa? Chechij.</para>
  <para style="b" />
  <para style="q2">
    <verse number="11" style="v" />¿Titiqu'n chin kb'ela' numje'?</para>
  <para style="q2">¿Titiqu'n kb'ajxe'la' nk'u'je'?</para>
  <para style="q2">Matxi'na' tz'okqewe' nk'u'j ti'j Qman Dyos,</para>
  <para style="q2">kchin b'itzale' te kukxju'</para>
  <para style="q2">¡Tena'te nchin k'uluna'ye' ex a klol weye'! Chiju' b'itzal.</para>
  <chapter number="43" style="c" />
  <para style="q">
    <verse number="1" style="v" />Nman Dyos, b'inchama tnik'alilti'j weye';</para>
  <para style="q">¡Chin tkloma kyeju' nche niman kye txqantl dyos!</para>
  <para style="q">¡Chin tkloma toj ttziju' chalyol ex teju' b'inchal myab'a'n,</para>
  <para style="q">
    <verse number="2" style="v" />qu'n teya nchin k'uluna'ye' ex aya klol weye'!</para>
  <para style="q">¿Titiqu'n ẍin ela' tik'u'na?</para>
  <para style="q">¿Titiqu'n ati tu'n ntene' toj b'is</para>
  <para style="q">ex toj yajb'il kyu'n wajq'oje?</para>
  <para style="q">
    <verse number="3" style="v" />Q'ontzju'ya t-spik'umala exju' tyola ax,</para>
  <para style="q">tu'ntzun woklpeye' kyi'j</para>
  <para style="q">tu'n npone' twi' witz xjan,</para>
  <para style="q">ja najla'ya.</para>
  <para style="q">
    <verse number="4" style="v" />Kchin pomiltzuntze' twitzju' q'olb'eb'l teya Nman Dyos,</para>
  <para style="q">atzuntzu' chin b'itzala'ye' teya tuk'i'l tq'ojq'ojel chnab' arpa,</para>
  <para style="q">a na'ta Nman Dyos, intzalajsanweye'</para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" />¿Titiqu'n kchin b'ela' numje'?</para>
  <para style="q">¿Titiqu'n kb'ajxe'la' nk'u'je'?</para>
  <para style="q">Matxi'na' tz'okqewe' nk'u'j ti'ja Nman Dyos,</para>
  <para style="q">chin b'itzale' teya kukxju'</para>
  <para style="q">¡Tena'ta nchin k'uluna'ye' ex aya klol weye'! Chiju' b'itzal.</para>
  <chapter number="44" style="c" />
  <para style="s1">Na'j Dyos qanb'il o'nb'il te Dyos</para>
  <para style="q">
    <verse number="1" style="v" />Nman Dyos,</para>
  <para style="q">oje qb'iye' tu'nku' qẍkyine',</para>
  <para style="q">kyej q'ma'n qeye' kyu'n qmane'</para>
  <para style="q">aju' tb'inchaya kye,</para>
  <para style="q">kyoju' tq'ijlalil ojtxi':</para>
  <para style="q">
    <verse number="2" style="v" />aku'ya ex xla'jankyeju' xjal</para>
  <para style="q">nche niman kye txqantl dyos,</para>
  <para style="q">kub' ttz'e'ysa'na kwitzju' nimaqtnam</para>
  <para style="q">ex e'kub' tq'o'nju'ya qmane' toju' kytx'otx'.</para>
  <para style="q">
    <verse number="3" style="v" />Qu'n mya tu'n kyq'ob' ex mya tu'n kyk'uẍtx'e'nb'il;</para>
  <para style="q">ẍe kanb'ana'</para>
  <para style="q">myana' kyu'nkye xkanb'eta'ju' tx'otx'.</para>
  <para style="q">¡Tu'nate tq'ob'ju'ya, tu'n tipumala!</para>
  <para style="q">¡Ulku'ya tuk'i'l tajwalila,</para>
  <para style="q">qu'n intoq che tk'u'jla'na!</para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" />¡Nman Dyos! ¡Nnimaqkawil!</para>
  <para style="q">Tu'na e'kanb'ana'ju' ttanama;</para>
  <para style="q">
    <verse number="5" style="v" />tu'na nkub'a' kyi'ju' qajq'oje' qu'ne';</para>
  <para style="q">¡toj tb'iya nche b'aju' nche oktzaqpaj qi'je' qu'ne'!</para>
  <para style="q">
    <verse number="6" style="v" />Qu'n layna' tz'okqewe' nk'u'j ti'ju' nsmaje',</para>
  <para style="q">ex lay chin kanb'ane' tu'n nk'uẍtx'e'nb'ile';</para>
  <para style="q">
    <verse number="7" style="v" />tu'nateju'ya xkub'a' kyi'ju' qajq'oje' qu'ne',</para>
  <para style="q">tu'na sela' kych'ixawju' nche el ik'onqe'ye'</para>
  <para style="q">
    <verse number="8" style="v" />¡Qo tzalajele' kukxju' ti'ja Nman Dyos,</para>
  <para style="q">kjawil qajwali'na tkyaqil q'ij!</para>
  <para style="b" />
  <para style="q">
    <verse number="9" style="v" />Naqtzun aju' matxi' qo' eltik'o'na;</para>
  <para style="q">matxi' tz'el qch'ixawe' tu'na.</para>
  <para style="q">Minti' nxi'tla kyuk'i'lju' qxjale' te q'oj.</para>
  <para style="q">
    <verse number="10" style="v" />Maqo kub' oqe' tu'na kywitzju' qajq'oje';</para>
  <para style="q">In qo alq'anjtze' kyu'nju' nche el ik'unqeye',</para>
  <para style="q">inxikyiq'i'n tkyaqilju' kyajb'il.</para>
  <para style="q">
    <verse number="11" style="v" />Maqo'x tq'o'na</para>
  <para style="q">naku'jxi'xtej rit aj txi' toj b'i'yb'il;</para>
  <para style="q">maqo'x t-sputi'na kyxolju' xjal nche niman kye txqantl dyos;</para>
  <para style="q">
    <verse number="12" style="v" />naqxi'x xxi' t-suqu'na ttanama,</para>
  <para style="q">mixti'te qoklene' toj twitza.</para>
  <para style="q">
    <verse number="13" style="v" />Mataja tu'n qb'aj yasune';</para>
  <para style="q">nqo' el ik'u'ne' kyu'nju' najlqe' nqayin qk'etze' ex inel qch'ixawe' kyu'n.</para>
  <para style="q">
    <verse number="14" style="v" />Mataja tu'n qb'aj xmayine' kyu'n nche niman kye txqantl dyos;</para>
  <para style="q">ajkytzaj ka'yin qeye', nxi' kyukcha'n kywi' te xmayb'ilqeye'.</para>
  <para style="q">
    <verse number="15" style="v" />Tzipin wele' tu'n nch'ixawe';</para>
  <para style="q">tkyaqil q'ij inel nch'ixawe'</para>
  <para style="q">
    <verse number="16" style="v" />tu'n i'lb'ilweye' tu'n wajq'oje</para>
  <para style="q">nchin noktik'le'ne' ex nchin tyasu'ne'.</para>
  <para style="b" />
  <para style="q">
    <verse number="17" style="v" />Tkyaqilju' saj qi'je' lu,</para>
  <para style="q">mya tu'nwtju' matzik'tna'la qu'ne'.</para>
  <para style="q">¡B'ajx qoela' txalpujqe' ti'ju' tyola kyejni b'entti'j!</para>
  <para style="q">
    <verse number="18" style="v" />B'ajx kub'a' qxima'ne' tu'n tkyej qtzaqpi'na</para>
  <para style="q">ex b'ajx kyeja' qtzaqpi'nju'ye' tb'eyila.</para>
  <para style="q">
    <verse number="19" style="v" />Extzun nqo yajtijtle' tu'na</para>
  <para style="q">kyoj kyjul xo'j.</para>
  <para style="q">¡Matzaj tq'o'na t-xlekumil kamik qib'aje'!</para>
  <para style="q">
    <verse number="20" style="v" />Nman Dyos, naqwit matzik'tna'la qu'ne'</para>
  <para style="q">ex ma'wt qo k'ulune' twitz juntl dyos min ojtzqi'n,</para>
  <para style="q">
    <verse number="21" style="v" />ma'wtlo tila,</para>
  <para style="q">qu'n tojtzqi'na'ta tkyaqilju' toj tanmi xjal.</para>
  <para style="q">
    <verse number="22" style="v" />Naqpena' tu'nela inelje qi'je'</para>
  <para style="q">tu'n qkub' b'yo'ne';</para>
  <para style="q">nqo senjtze' kse'nqe' rit nche'x iq'i'n toj b'i'yb'il.</para>
  <para style="b" />
  <para style="q">
    <verse number="23" style="v" />¿Nman Dyos, titiqu'n nnik'a' wtana?</para>
  <para style="q">¡Na'ntztib'a, ex we'ktza!</para>
  <para style="q">¡Lalun qo' eltik'o'na tejumajx!</para>
  <para style="q">
    <verse number="24" style="v" />¿Titiqu'ntzun in xa' tewa'n twitza qeye'?</para>
  <para style="q">¿Titiqu'ntzun nnik'a' qna'le' tu'na,</para>
  <para style="q">extzun luqo'ye' inxi'x qoyajtiye'?</para>
  <para style="q">
    <verse number="25" style="v" />Matxi' kub'qi'je' ex matxi' tz'el qch'ixawe',</para>
  <para style="q">inqo' jwonjtze' twitz tx'otx'.</para>
  <para style="q">
    <verse number="26" style="v" />¡Iq'i'nktz tib'a</para>
  <para style="q">kuttzaja onilqeye'</para>
  <para style="q">qo' tkloma, qu'n nimta tk'u'jlalil!, Chiju' b'itzal.</para>
  <chapter number="45" style="c" />
  <para style="s1">Tnej yol te tmjeb'le'n nimaqkawil</para>
  <para style="q">
    <verse number="1" style="v" />Nim yol tb'anilqexi'x nche b'ju'l toj nwi'ye';</para>
  <para style="q">ik waq'ju'ye' kse'n ttz'ib'il jun b'a'n ajtz'ib'al.</para>
  <para style="q">¡Kxe'l nma'ne' nyole' tb'anilqexi'x teju' nimaqkawil!</para>
  <para style="b" />
  <para style="q">
    <verse number="2" style="v" />¡O'kxta tb'anilxi'x kyxol kykyaqil ichan!</para>
  <para style="q">¡O'kx yol tb'anilqexi'x nche etz toj ttziya tma'na!</para>
  <para style="q">Qu'mtzun xky'i'wlanjtza'ya tu'n Dyos tejumajx.</para>
  <para style="q">
    <verse number="3" style="v" />¡K'lonka tk'uẍtx'e'nb'ila tk'u'ja, aya min nxob'a!</para>
  <para style="q">¡Qu'n a tachb'ilju'ya inxi'x qoptz'aj!</para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" />Iq'i'nktz tib'a, kawina,</para>
  <para style="q">tu'n tb'inchetju' ax</para>
  <para style="q">exju' tnik'alilti'j kyeju' min nkynima'n kyib'.</para>
  <para style="b" />
  <para style="q">¡B'inchamqe'ya nimaq ti'xti' tb'anilqexi'x tu'n tb'a'nq'ob'a!</para>
  <para style="q">
    <verse number="5" style="v" />Kche kb'el tz'aqju' tnam t-xe tqana, nimaqkawil;</para>
  <para style="q">ch'ut qe'xi'xju' tal t-smaja</para>
  <para style="q">kche pomel xuyli toj kyk'u'ju' tajq'oja.</para>
  <para style="b" />
  <para style="q">
    <verse number="6" style="v" />Te junmajxte' tkawb'ila, Nman Dyos,</para>
  <para style="q">jun kawb'il tnik'alti'j.</para>
  <para style="q">
    <verse number="7" style="v" />In tk'u'jla'nju'ya b'a'n ex inel tik'u'na myab'a'n.</para>
  <para style="q">Qu'mtzun jaw sk'o'na tu'n Qman Dyos,</para>
  <para style="q">nimxi'x tzalajb'il tzaj tq'o'n teya</para>
  <para style="q">kyekywitzju' tuk'i'la.</para>
  <para style="q">
    <verse number="8" style="v" />Inche k'ok'b'ixu' t-xb'aluna tu'n mir, alowe ex kanel;</para>
  <para style="q">injaw tzalajsa'na tu'n kyq'ojq'ojel chnab' tzintzin</para>
  <para style="q">kyoju' tja nimaqkawb'il uk'sa'n kyu'n tb'aq elepant.</para>
  <para style="q">
    <verse number="9" style="v" />Ate' kymyal nimaqkawil kyxolju' qya ate' toj tjaya te kawb'il;</para>
  <para style="q">atzu'n t-xu'jila toj tb'a'nq'ob'ju' tq'uqb'ila ta',</para>
  <para style="q">txoli'n ti'ju' t-xb'alun tu'n q'anpwaq tb'anilxi'x.</para>
  <para style="b" />
  <para style="q">
    <verse number="10" style="v" />B'intza tal nmyal;</para>
  <para style="q">q'onk twi'ya ti'ju' kxe'l nma'ne' teya:</para>
  <para style="q">Tzik'x kyna'lju' kyb'aje' toj kyjaye' tu'na exqe' twnaqila,</para>
  <para style="q">
    <verse number="11" style="v" />qu'n intzalaju' nimaqkawil ti'ju' tilb'ilala tb'anilxi'x;</para>
  <para style="q">nimana te qu'n ate tajawju'ya.</para>
  <para style="q">
    <verse number="12" style="v" />Tzulu' tmyal nimaqkawil te Tiro twitza,</para>
  <para style="q">aye'ju' nimaq q'inun toju' tnam</para>
  <para style="q">kyuk'i'l oyaj te ninb'ilteya.</para>
  <para style="b" />
  <para style="q">
    <verse number="13" style="v" />¡Luju' tmyal nimaqkawil tz'okpun tb'anilxi'x!</para>
  <para style="q">¡Chmo'n t-xb'alun smo'n tk'i' q'anpwaq!</para>
  <para style="q">
    <verse number="14" style="v" />Tz'okpun iq'i'n twitz nimaqkawil tuk'i'l t-xb'alun nqoptz'aj,</para>
  <para style="q">lepchqe'xju' txin ti'j, aye'ju' tuk'i'l q'poj qe'.</para>
  <para style="q">
    <verse number="15" style="v" />Inche b'et tuk'i'l nim tzalajb'il;</para>
  <para style="q">nche tzalaj ljo'n kyb'jo'kx toju' tja nimaqkawil.</para>
  <para style="b" />
  <para style="q">
    <verse number="16" style="v" />Aye'tzu'n tk'wala, nimaqkawil</para>
  <para style="q">kche okyex qe toj kyq'uqb'ilju' tyajilb'ena,</para>
  <para style="q">che okyel kawil toj tkyaqilju' tnam.</para>
  <para style="q">
    <verse number="17" style="v" />Knb'incha'ye' tu'n ttzaj na'nju' tb'iya</para>
  <para style="q">toj junjun ak'a'j tyajajil,</para>
  <para style="q">ex tu'n tjaw nima'na kukxju' kyu'n tnam, chiju' b'itzal.</para>
  <chapter number="46" style="c" />
  <para style="s1">Ati Qman Dyos quk'i'l</para>
  <para style="q">
    <verse number="1" style="v" />Ate Qman Dyos qipumal ex kolb'ilqe;</para>
  <para style="q">lwiy nqo tklo'n toj b'is.</para>
  <para style="q">
    <verse number="2" style="v" />Qu'mtzun mixti' tu'n qxob',</para>
  <para style="q">maskye makub' xitju' tx'otx',</para>
  <para style="q">b'a'n qama che'x mulq'aju' witz t-xe ninnjab',</para>
  <para style="q">
    <verse number="3" style="v" />b'a'nqa ntx'u'jinju' ninnjab', ex nche tinunju' ttolob',</para>
  <para style="q">maskye mache yukchiju' witz tu'n ttx'u'jil.</para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" />Tzalajb'ilxi'x teju' ninttanam Qman Dyos tu'n jun nin a' kyuk'i'l tq'ob',</para>
  <para style="q">ju' xjanxi'x kyxolju' nimaqttanam Qman Dyos nim toklen tib'aj tkyaqil.</para>
  <para style="q">
    <verse number="5" style="v" />Atite Qman Dyos toj, ex lay kub' xitj;</para>
  <para style="q">k'onil ti'j ajttzaj t-xe kya'j.</para>
  <para style="q">
    <verse number="6" style="v" />Inche ẍch'inju' nimaqtnam tu'n kyxob'el, nche lu'lunju' kawb'il,</para>
  <para style="q">inkub' xitju' tx'otx' aj txi' kyb'i'n tq'ojq'ojel twi' Dyos.</para>
  <para style="b" />
  <para style="q2">
    <verse number="7" style="v" />¡Atite Qman Dyos nimtipumal quk'i'l!</para>
  <para style="q2">¡Ate kolb'ilqeju' Dyos ja k'uluna' Jakob'!</para>
  <para style="b" />
  <para style="q">
    <verse number="8" style="v" />kukytzaje' ka'yilteju' ti'xti' te lab'te'nxi'x</para>
  <para style="q">xtb'incha Qman Dyos twitz tx'otx':</para>
  <para style="q">
    <verse number="9" style="v" />matxi' b'aj ttxa'nju' q'oj tu'n,</para>
  <para style="q">toj tkyaqil twitz tx'otx';</para>
  <para style="q">matxi' che b'aj kub'ttoqi'nju' smaj,</para>
  <para style="q">matxi' che b'aj kub'ttoqi'nju' ch'ut,</para>
  <para style="q">¡Matxi' tz'oktq'o'n kyq'aq'alju' karwaj te q'oj!</para>
  <para style="q">
    <verse number="10" style="v" />Chi Qman Dyos kye nimaqtnam: ¡Kytzaqpinkju'ye' q'oj! ¡Tz'elx kynik'e' weye' qa ayine' Dyos!</para>
  <para style="q">¡Qu'n ayine' atinqin kyib'aj nimaqtnam!</para>
  <para style="q">¡Ayine' atinqin tib'aj tkyaqil twitz tx'otx'! Chi Dyos.</para>
  <para style="b" />
  <para style="q2">
    <verse number="11" style="v" />¡Atite Qman Dyos nimtipumal quk'i'l!</para>
  <para style="q">¡Ate kolb'ilqeju' Dyos ja k'uluna' Jakob'!, Chiju' b'itzal.</para>
  <chapter number="47" style="c" />
  <para style="s1">A Qman Dyos nimaqkawil tib'aj tkyaqil twitz tx'otx'</para>
  <para style="q">
    <verse number="1" style="v" />¡Kypoq'cham toj kyq'ob'e' tnam kykyaqile'!</para>
  <para style="q">¡Kynimanktze' Qman Dyos tuk'i'l tq'ojq'ojel kywi'ye' te tzalajb'il!</para>
  <para style="q">
    <verse number="2" style="v" />Qu'n xob'le'nte' Qman Dyos ati toj kya'j;</para>
  <para style="q">ate nimaqkawil nim toklen tib'aj tkyaqil twitz tx'otx'.</para>
  <para style="q">
    <verse number="3" style="v" />Mache kub't-xitu'n b'o's tnam ex nimaqtnam</para>
  <para style="q">ex mache kub' tq'o'n tjaq' qkawb'il.</para>
  <para style="q">
    <verse number="4" style="v" />Majaw t-sk'o'nju' tx'otx' te qetzb'il,</para>
  <para style="q">ex nqo tzalaj ayo' tyajajil Jakob'</para>
  <para style="q">tu'nju' k'u'jla'nqo' tu'n Qman Dyos.</para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" />¡Matxi' japunte Qman Dyos toj tq'uqb'il</para>
  <para style="q">tuk'i'l sich' te tzalajb'il ex tq'ojq'ojel chun!</para>
  <para style="q">
    <verse number="6" style="v" />¡Che b'itzan qe'ye', che b'itzanqe' b'itze' te Qman Dyos!</para>
  <para style="q">¡Che b'itzan qe'ye' teju' nimaqkawil!</para>
  <para style="q">
    <verse number="7" style="v" />¡Kyb'itzanx jun kyb'itze' te Qman Dyos,</para>
  <para style="q">qu'n ate nimaqkawil tib'aj tkyaqil twitz tx'otx'!</para>
  <para style="q">
    <verse number="8" style="v" />¡Ate Qman Dyos nimaqkawil kyib'aju' nimaqtnam!</para>
  <para style="q">¡Q'uqlite' Qman Dyos toj tkawb'il xjan!</para>
  <para style="q">
    <verse number="9" style="v" />In kymujb'a'nkyib'ju' ichan nimaq kyoklen kyoj nimaqtnam</para>
  <para style="q">kyuk'i'lju' ttanam Tdyos Abraam,</para>
  <para style="q">
    <verse number="10" style="v" />qu'n te Qman Dyos qekye' nimaq kyoklen twitz tx'otx'.</para>
  <para style="q">¡Ate nkawin tib'aj tkyaqil! Chiju' b'itzal.</para>
  <chapter number="48" style="c" />
  <para style="s1">Nim toklen Syon ttanam Qman Dyos</para>
  <para style="q">
    <verse number="1" style="v" />¡Nimte Qman Dyos toklen!</para>
  <para style="q">¡O'kxte' Qman Dyos b'a'n tu'n tjaw qnima'n</para>
  <para style="q">toju' ninttanam ex twi' witz xjan!</para>
  <para style="b" />
  <para style="q">
    <verse number="2" style="v" />¡Tb'anilxi'xju' witz Syon, tu'nju' nimin twe',</para>
  <para style="q">ati toj tnayajkya'j!</para>
  <para style="b" />
  <para style="q">¡A kytzalajb'il xjalju' toj tkyaqil twitz tx'otx'!</para>
  <para style="q">¡A ninttanam nimaqkawilju' nim toklen!</para>
  <para style="b" />
  <para style="q">
    <verse number="3" style="v" />Atite Qman Dyos kyoju' ja te kawb'il toj Jerusalen;</para>
  <para style="q">matxi' tyek'utib' Qman Dyos kse'n jun kolb'il kuwsa'n.</para>
  <para style="q">
    <verse number="4" style="v" />Qu'n b'aj kyb'u'yi'n kyib'u' nimaqkawil</para>
  <para style="q">ex junx kyb'ajtzaj tilj ti'j;</para>
  <para style="q">
    <verse number="5" style="v" />tetzunj kyka'yinteju' nintnam eb'jaw lab'ti,</para>
  <para style="q">tzaj xob'il kyi'j ex e'kub' oq.</para>
  <para style="q">
    <verse number="6" style="v" />Majx oktchi kyi'j:</para>
  <para style="q">intoq kxq'ipla'n kyib' tu'n k'ixk'oj, kse'n jun qya yo'lok tch'yon wnaq ti'j;</para>
  <para style="q">
    <verse number="7" style="v" />kse'n kyq'iq' ntzaj tjawetzq'ij, nche b'aj kub't-xitu'n b'ark te Tarsis.</para>
  <para style="b" />
  <para style="q">
    <verse number="8" style="v" />Matxi' qil kyu'nku' qwitz</para>
  <para style="q">toj ninttanam Qman Dyos,</para>
  <para style="q">ju' Dyos Manb'aj nimtipumal,</para>
  <para style="q">kse'nxu' oje b'aj tzaj q'ma'n qe:</para>
  <para style="q">¡Kjel tkuwsa'nte Qman Dyos Jerusalen tejumajx!</para>
  <para style="b" />
  <para style="q">
    <verse number="9" style="v" />Nman Dyos,</para>
  <para style="q">nqo' ximane' toju' tjaya</para>
  <para style="q">ti'ju' tk'u'jlalila nimxi'x.</para>
  <para style="q">
    <verse number="10" style="v" />Nman Dyos,</para>
  <para style="q">injaw nima'na toj tkyaqil twitz tx'otx'</para>
  <para style="q">kse'nxu' toklen tb'iya.</para>
  <para style="q">In kawina tojxi'x tu'me'l tuk'i'l tipumala.</para>
  <para style="b" />
  <para style="q">
    <verse number="11" style="v" />¡Tzalajxwitu' witz Syon!</para>
  <para style="q">¡Che xlik'punxwitu' nimaqtnam toj Juda tu'n kytzalajb'il</para>
  <para style="q">tu'nju' tkawb'ila tz'aqlixi'x!</para>
  <para style="b" />
  <para style="q">
    <verse number="12" style="v" />Che b'ete' ti'jile tnam Syon</para>
  <para style="q">ex kyajlanxe' jte' kyb'aju' ja nimaq kywe' te ka'yb'il;</para>
  <para style="q">
    <verse number="13" style="v" />kyka'yinxi'xpe'ju'ye' ninttapiyil exqe' tja ninkawb'il,</para>
  <para style="q">tu'ntzun txi' kyoli'ne'</para>
  <para style="q">kyeju' che b'ju'l itz'j yajxi'tl</para>
  <para style="q">
    <verse number="14" style="v" />qa ikyte Qman Dyosju' tejumajx.</para>
  <para style="q">¡Ate ẍaqlulqe tejumajx! Chiju' b'itzal.</para>
  <chapter number="49" style="c" />
  <para style="s1">Mya q'uqb'ank'u'jalte' pwaq</para>
  <para style="q">
    <verse number="1" style="v" />Kyb'intzpe'ju'ye' lu ex kyq'onk kywi'ye' ti'j,</para>
  <para style="q">e'tnam ex kykyaqile' najlqe'ye' toj tkyaqil twitz tx'otx',</para>
  <para style="q">
    <verse number="2" style="v" />nimaqxjal exqe' xjal mixti' b'a'n kyu'n,</para>
  <para style="q">e' q'inun ex e'prow.</para>
  <para style="q">
    <verse number="3" style="v" />Kchin yolile' tuk'i'l nab'l</para>
  <para style="q">che kxe'lnchik'b'a'ne' nimaq nab'l;</para>
  <para style="q">
    <verse number="4" style="v" />k'okyel nq'o'n nwi'ye' kyi'ju' q'unb'en tuk'i'l nab'l,</para>
  <para style="b" />
  <para style="q">ex kxe'l nchik'b'a'ne' tkub' toj nnab'le' tuk'i'l chnab' arpa.</para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" />¿Titi' chin xob'ila'ye'</para>
  <para style="q">ajkyul kanunju' tq'ijlalil ch'uẍ,</para>
  <para style="q">ajtok txoli'n wi'je'</para>
  <para style="q">tu'nju' taq'wix nkyb'incha'n wajq'oje?</para>
  <para style="q">
    <verse number="6" style="v" />Q'uqlokkye kyk'u'j ti'ju' kyq'inumal</para>
  <para style="q">in kla'ji'n kyib' ti'j tkyaqilu' ati kye,</para>
  <para style="q">
    <verse number="7" style="v" />mixna' a'lo'te' jun okwit kletil tu'nxtib'</para>
  <para style="q">exwit tu'n txi' tchjo'n te Qman Dyos tu'n tkletu' tchwinqlal.</para>
  <para style="q">
    <verse number="8" style="v" />¡Mixti'te jun xjal okwit kb'entel tlq'et tchwinqlal tu'n tpwaq,</para>
  <para style="q">
    <verse number="9" style="v" />tu'nwt tanq'in tejumajx ex tu'nwt tklet teju' kamik!</para>
  <para style="q">
    <verse number="10" style="v" />B'i'na' qu'n qa qkyaqil qokyimel,</para>
  <para style="q">b'a'ntzun ati tnab'l mujqa xnak,</para>
  <para style="q">atzu'n kyq'inumal kjelten te juntl.</para>
  <para style="q">
    <verse number="11" style="v" />B'a'n qama kyej kyq'o'n kyb'i ti'ju' kytx'otx';</para>
  <para style="q">toj muqb'il che tenb'ela'kye'</para>
  <para style="q">¡Atzuntzu' che tenb'ela' tejumajx!.</para>
  <para style="b" />
  <para style="q2">
    <verse number="12" style="v" />Lay tz'anq'inte' xjal tejumajx, b'a'nqa nimaq q'inun;</para>
  <para style="q2">ikyx nkyima' kse'nqe' txkup.</para>
  <para style="b" />
  <para style="q">
    <verse number="13" style="v" />Ikytzun nche b'aja' xjalju' inok qe kyk'u'j kyi'jx;</para>
  <para style="q">exqe' njaw kynima'n kyib' kyib'xkyib'.</para>
  <para style="q">
    <verse number="14" style="v" />Naku'j ritqe', a kamik k'iklel kyi'j</para>
  <para style="q">ex xi'kyxitiq'i'n toj muqb'il.</para>
  <para style="q">Ajtzun ttzaj t-xe kya'j,</para>
  <para style="q">Che kanb'alju' b'a'n xjal kyib'aj;</para>
  <para style="q">chab'a' kb'ajel kyipumal</para>
  <para style="q">ex aju' muqb'il k'okyel te kyja.</para>
  <para style="q">
    <verse number="15" style="v" />Atzunte Qman Dyos kklol weye' te tipumal kamik,</para>
  <para style="q">qu'n chin xe'l tiq'i'ne' tuk'i'l.</para>
  <para style="b" />
  <para style="q">
    <verse number="16" style="v" />Lalun tzaj tb'isa qa a'lo jun majaw q'inumax</para>
  <para style="q">exqa matxi' jawtb'incha'n tja achb'ajilxi'x,</para>
  <para style="q">
    <verse number="17" style="v" />qu'n mixti'te kxe'l tiq'i'n ajtkyim,</para>
  <para style="q">ex lay che'x tiq'i'n achb'il ati te toj muqb'il.</para>
  <para style="q">
    <verse number="18" style="v" />Maskye ma'xi'x tz'achin twitz tx'otx',</para>
  <para style="q">exqa nima'nxi'x kyu'n xjal tu'nju' tq'inumal,</para>
  <para style="q">
    <verse number="19" style="v" />kpomilte' tq'ijlalil tu'n tkyim,</para>
  <para style="q">ex lay til jumajtlu' spik'un.</para>
  <para style="b" />
  <para style="q2">
    <verse number="20" style="v" />Lay tz'anq'inte' xjal tejumajx, b'a'nqa nimaq q'inun;</para>
  <para style="q2">ikx nkyima' kse'nqe' txkup. Chiju' b'itzal.</para>
  <chapter number="50" style="c" />
  <para style="s1">Ate Qman Dyos jun ajkawil tz'aqli</para>
  <para style="q">
    <verse number="1" style="v" />Oje yolinte Qman Dyos nim toklen kyib'aj txqantl dyos;</para>
  <para style="q">oje txokon kyeju' xjal najlqe' twitz tx'otx'</para>
  <para style="q">toj tjawetzq'ij ex tkub'exq'ij.</para>
  <para style="q">
    <verse number="2" style="v" />In qoptz'ajte' Qman Dyos tzmax Syon,</para>
  <para style="q">ju' nintnam tb'anilxi'x ka'yin.</para>
  <para style="q">
    <verse number="3" style="v" />Tzulte' Qman Dyos, mya toj ewaj:</para>
  <para style="q">nejli jun q'aq' xitul twitz;</para>
  <para style="q">atzu'n ti'jile jun nin kyq'iq' tk'i' q'ankyaq.</para>
  <para style="q">
    <verse number="4" style="v" />Ntxokon Qman Dyos tzmax jawl teju' kya'j ex te tx'otx'</para>
  <para style="q">tu'n kyka'yinteju' xitb'il tib'aju' ttanam:</para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" />Kyb'uyinqe'tze' kykyaqilju' njapun nyole' kyu'n,</para>
  <para style="q">aye' oje kyej b'entti'j kyyol wuk'i'le'</para>
  <para style="q">tej tkub' kyq'o'n chojb'il nwitze'. Chij</para>
  <para style="q">
    <verse number="6" style="v" />Atzu'n kya'j nyek'u'nte qa a Qman Dyos ajkawil tz'aqli.</para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" />B'intza Israel, ntanam;</para>
  <para style="q">tkyaqilju' ti'xti' kb'ajxel nma'ne' tplaja.</para>
  <para style="q">¡Ayinwe' Dyos Manb'aj!</para>
  <para style="q">
    <verse number="8" style="v" />Min ntzak'u'na tu'n kpaju' chojb'il ex chojb'il k'ok'sb'il</para>
  <para style="q">nche kub' tq'o'na weye' kukxju'.</para>
  <para style="q">
    <verse number="9" style="v" />Min nche'x nqanine' tal tman twakyixa</para>
  <para style="q">ex tman tchib'a ate' toj tch'laja,</para>
  <para style="q">
    <verse number="10" style="v" />qu'n weqewe' tkyaqilju' tojk'ul txkup,</para>
  <para style="q">exqe' ate'qe' kywi'witz;</para>
  <para style="q">
    <verse number="11" style="v" />Weqe'weye' pich' ate' toj nimaq k'ul</para>
  <para style="q">ex kykyaqilju' txkup ate' toj kojb'il.</para>
  <para style="q">
    <verse number="12" style="v" />Naqwit nchin q'aq'ane', lay txi' nma'nwe' teya,</para>
  <para style="q">qu'n wewe' tx'otx' ex tkyaqilju' ati twitz.</para>
  <para style="q">
    <verse number="13" style="v" />¿Ma ntzun nk'a'cha'nwe' wib' ti'j tchib'jil tman wakx,</para>
  <para style="q">mujqa in nk'wa'ne' tchk'el tman chib'?</para>
  <para style="q">
    <verse number="14" style="v" />¡Aye'wt toyaju'ya aye' tb'itza te aq'b'il chjonte weye', ayine' Dyos Manb'aj;</para>
  <para style="q">japunxju' tyola tzaj ttziya'na weye'!</para>
  <para style="q">
    <verse number="15" style="v" />Chin ttxkoma kse'n atiya toj b'is ex yajb'il;</para>
  <para style="q">knkla'ya, kchin jawil tnima'ntzuntza. Chi Qman Dyos.</para>
  <para style="b" />
  <para style="q">
    <verse number="16" style="v" />Atzu'n teju' xjal b'inchal myab'a'n, chi Qman Dyos:</para>
  <para style="q">¿Titi' toklena tu'n tyolina kyi'ju' nkawb'ile'</para>
  <para style="q">ex tu'n tyolina ti'ju' yol kyejni b'entti'j wu'ne',</para>
  <para style="q">
    <verse number="17" style="v" />qu'n mina'jon ntq'a' kawi tib'a weye'</para>
  <para style="q">ex naq inik' tolju' nyole' ti'twi'ya?</para>
  <para style="q">
    <verse number="18" style="v" />Majx kye tilwiju' eleq' tu'na;</para>
  <para style="q">¡kyexi'x kytene' kyuk'i'lju' ajpajil!</para>
  <para style="q">
    <verse number="19" style="v" />Minti' ntjk'u'n taq'a,</para>
  <para style="q">kyi'ju' xlab'yol ex chajyolil.</para>
  <para style="q">
    <verse number="20" style="v" />Injaw ti'n yola ti'j ttzika mujqa titz'ina;</para>
  <para style="q">¡ti'jku' ttzika mujqa titz'ina nxa' tlanu'n tyola!</para>
  <para style="q">
    <verse number="21" style="v" />Matxi' tb'inchaya tkyaqil ja'lu, ex mixti'xi' txi' nma'ne' teya;</para>
  <para style="q">toj tnab'la qa junqinxe' tuk'i'la.</para>
  <para style="q">Kxel nchik'b'a'nwe' tilas tplajku'ya</para>
  <para style="q">¡kb'el ntz'e'ysa'n twitza ja'lo!</para>
  <para style="b" />
  <para style="q">
    <verse number="22" style="v" />Kyb'intzju'ye' lu, aye'ye' in ik'tna'l Dyos kyu'ne',</para>
  <para style="q">qu'n jaku' o'kx aj woktene' pẍulkyeye'</para>
  <para style="q">ex mix-a'lo' jun tzul klolkyeye':</para>
  <para style="q">
    <verse number="23" style="v" />alkyete nq'on chjonte weye', inchin tnima'ne'.</para>
  <para style="q">¡In nklo'nweju'ye' ati toj nb'eye'! Chi Qman Dyos, chiju' b'itzal.</para>
  <chapter number="51" style="c" />
  <para style="s1">Q'aq'antz tk'u'ja wi'je' Nman Dyos</para>
  <para style="q">
    <verse number="1" style="v" />Nman Dyos, q'aq'antz tk'u'ja wi'je';</para>
  <para style="q">najsanku'ya wile', qu'n nimta tk'u'jlalil.</para>
  <para style="q">
    <verse number="2" style="v" />¡Chin ttxjoma te tkyaqilju' nb'inchb'aje' myab'a'n!</para>
  <para style="q">¡Chin t-ẍtilsama te tkyaqilju' wile'!</para>
  <para style="q">
    <verse number="3" style="v" />In kane toj nwitze' qa myab'a'nju' nb'inchb'aje' twitza;</para>
  <para style="q">minti' in ik'tna'lju' wile' wu'ne'.</para>
  <para style="q">
    <verse number="4" style="v" />Matxi'xi'x chin b'inchan ile' twitza, extzun twitzku'ya,</para>
  <para style="q">myab'a'n xnb'inchaye', aku'xi'xju' nel tik'u'na.</para>
  <para style="q">Qu'mtzun tu'me'lte' tz'e'ysb'il nwitze' tu'na;</para>
  <para style="q">lay tz'el wik'u'ne' se'n ẍinoka'tq'ona toj xjel.</para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" />Axxi'x, aj ilqinwe' atxi'x witz'jlene';</para>
  <para style="q">aj ilqine' atxi'xj tej toklen iqa'n nwi'ye' tu'n ntxuye'.</para>
  <para style="q">
    <verse number="6" style="v" />Axxi'x, intk'u'jla'nta' xjal ax yolin,</para>
  <para style="q">ex makub' tq'o'na nab'l toj wanmiye'.</para>
  <para style="q">
    <verse number="7" style="v" />Chin t-ẍtilsama tu'n k'ul isopo, tu'n nkyeje' ẍnu'l;</para>
  <para style="q">chin ttxjoma, tu'n nkyeje' saqxi'x kyetwitz txun che'w.</para>
  <para style="q">
    <verse number="8" style="v" />Chin ttzalajsama b'a'nxi'x;</para>
  <para style="q">q'ontz jumajtlju'ya tzalajb'il weye', maskye matxi' kub' ttz'e'ysa'na nwitze'.</para>
  <para style="q">
    <verse number="9" style="v" />Laq'b'amilju'ya wile' twitza</para>
  <para style="q">ex najsanku'ya nb'inchb'aje' taq'wix.</para>
  <para style="b" />
  <para style="q">
    <verse number="10" style="v" />Nman Dyos, ¡ẍtilsama wanmiye'!,</para>
  <para style="q">¡chin tch'exb'ema tu'n wokye' tnik'alti'j!</para>
  <para style="q">
    <verse number="11" style="v" />Lalun chin nel tlaq'b'a'na twitza</para>
  <para style="q">ex lalun tz'el tiq'i'nju'ya T-xewa woje'.</para>
  <para style="q">
    <verse number="12" style="v" />Chin ttzalajsamtla tu'n tzalajb'il ti'ju' kolb'il tu'na;</para>
  <para style="q">q'onku'ya toj wanmiye' tu'n wokslane' b'a'n teya,</para>
  <para style="q">
    <verse number="13" style="v" />tu'ntzun txi' nyek'u'ne' tb'eyila kyeju' min nche okslan teya</para>
  <para style="q">tu'n tanjtzkyi'ju' aj il tk'etza.</para>
  <para style="q">
    <verse number="14" style="v" />Nman Dyos klol weye',</para>
  <para style="q">chin tkloma tu'n lan chin b'yon xjale',</para>
  <para style="q">kxe'l npakb'a'ntzuntze' tuk'i'l b'itz qa tz'aqliya.</para>
  <para style="b" />
  <para style="q">
    <verse number="15" style="v" />Nman Dyos, jqomju'ya ntziye',</para>
  <para style="q">tu'ntzun tjaw nnima'na kyu'n b'itz.</para>
  <para style="q">
    <verse number="16" style="v" />Myana'teju'ya tajb'il chojb'il ex oyaj tz'e'ysa'n;</para>
  <para style="q">ma'wtlo txi' nq'o'nwe' teya, naqwit intzalaja ti'j.</para>
  <para style="q">
    <verse number="17" style="v" />Aye'kye chojb'ilju' b'a'n toj twitza, Nman Dyos, aju' tu'n ttzaj tb'is xjal tu'n tpaj til;</para>
  <para style="q">¡Nman Dyos, nin nnel tik'u'nteju'ya xjal matz'anjtzti'j tanmi!</para>
  <para style="b" />
  <para style="q">
    <verse number="18" style="v" />B'inchama b'a'n teju' tnam Syon, tu'nju' t-xtalb'ila;</para>
  <para style="q">wab'a'nktz jumajtlju'ya nintapi ti'jele Jerusalen.</para>
  <para style="q">
    <verse number="19" style="v" />Ktzalajeltzuntza kyi'ju' chojb'il q'ma'n toj chaq'b'il,</para>
  <para style="q">kyi'ju' oyaj ex kyi'ju' chojb'il k'ok'sb'il,</para>
  <para style="q">che b'eltzun q'o'n qpoj tman wakxtz tchojb'il tib'aj q'olb'eb'l teya, chiju' b'itzal.</para>
  <chapter number="52" style="c" />
  <para style="s1">Mixti'x tajb'en nkynima'n kyib'ju' b'inchal myab'a'n</para>
  <para style="q">
    <verse number="1" style="v" />¡Nimaq b'inchal myab'a'n! ¿titiqu'n ntla'ji'na' tib'a tu'nju' taq'wixil xntb'inchaya teju' b'a'n ajb'el te Dyos?</para>
  <para style="q">
    <verse number="2" style="v" />O'kxtzu' nximana'ta tu'n tb'inchanteya myab'a'n;</para>
  <para style="q">iky taq'ju'ya kse'n jun kuchil ati twitzte nmiltz'je.</para>
  <para style="q">
    <verse number="3" style="v" />Xi' nlaqja'ya ti'ju' taq'wixil, mya ti'jwitu' b'a'n,</para>
  <para style="q">axi'x tajb'ilju'ya chajyolil twitzu' ax.</para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" />Twi' chalyol,</para>
  <para style="q">majx tjonku'ya tu'n t-xituna tu'n tyola;</para>
  <para style="q">
    <verse number="5" style="v" />Atzunte Dyos kb'el xitunteya tejumajx:</para>
  <para style="q">k'elitz xla'ja'na tu'n toj tjaya; k'elil tiq'i'n tchwinqlala.</para>
  <para style="b" />
  <para style="q">
    <verse number="6" style="v" />Aye'tzu'n nche okslan te Dyos, kkyla' ja'lu ex ktzajel tchiylal kyi'j;</para>
  <para style="q">che xmayiltzuntz ti'ju' xjal lu ex kkyma':</para>
  <para style="q">
    <verse number="7" style="v" />Kyka'yinxpe'ye' xjal min njyon kolb'il tuk'i'l Dyos;</para>
  <para style="q">aju' q'uqlok tk'u'j kyi'j txqan tq'inumal</para>
  <para style="q">ex matxi' nq'et ti'ju' myab'a'n. Chechilo</para>
  <para style="q">
    <verse number="8" style="v" />Ayintzunwe' ikqine' kse'n jun tze olib'o ẍq'ayun toj tja Qman Dyos;</para>
  <para style="q">¡k'okyel qewe' nk'u'j ti'ju' tk'u'jlalil kukxju'!</para>
  <para style="b" />
  <para style="q">
    <verse number="9" style="v" />Nman Dyos, chin q'ol chjonteye' teya kukxju', tu'nju' xtb'inchaya;</para>
  <para style="q">chin ayole' ti'ja, kywitzku' tnik'alkyi'j.</para>
  <para style="q">qu'n majx b'a'nta, chiju' b'itzal.</para>
  <chapter number="53" style="c" />
  <para style="s1">Kypi'sil xjal</para>
  <para style="r">(<ref loc="PSA 14">Sal 14</ref>)</para>
  <para style="q">
    <verse number="1" style="v" />Nkyma'nju' xnak toj kynab'l qa mixti'te Dyos,</para>
  <para style="q">matxi' che kub' tzpet kykyaqilx,</para>
  <para style="q">taq'wixi'xju' kyb'inchb'aj</para>
  <para style="q">¡mixti'xte jun inwt b'inchan b'a'n!</para>
  <para style="q">
    <verse number="2" style="v" />Inka'yintz te Qman Dyos tzmajxtzu' toj kya'j kyib'aju' xjal;</para>
  <para style="q">qa ati jun ati tnab'l,</para>
  <para style="q">exqa ati jun njyon ti'j Qman Dyos.</para>
  <para style="q">
    <verse number="3" style="v" />Aye'tzunkye' xjal kykyaqilx matxi' che b'je'l txalpuj,</para>
  <para style="q">kykyaqilx ẍekub' tzpet.</para>
  <para style="q">¡Mix-a'lo'x jun inwt b'inchan b'a'n!</para>
  <para style="q">¡Tk'i'xpe'wt jun!</para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" />Mixti'x kynab'lju' b'inchal myab'a'n,</para>
  <para style="q">ate'k walkyeju' ntaname', naku'j kywa</para>
  <para style="q">mixpeti'x ntzaj kyna'n Qman Dyos</para>
  <para style="q">
    <verse number="5" style="v" />Kche lu'lulkye' tu'n xob'il,</para>
  <para style="q">maskye mix-a'lo' nxixob'sankye,</para>
  <para style="q">qu'n kb'ajel t-sputi'n Qman Dyos kyb'aqilju' ajq'oj.</para>
  <para style="q">K'elel kych'ixaw, qu'n che elel ik'u'n tu'n Qman Dyos.</para>
  <para style="b" />
  <para style="q">
    <verse number="6" style="v" />¡Naqwit tzaju' kolb'ilte Israel</para>
  <para style="q">twi'ju' witz Syon!</para>
  <para style="q">Ajttzaqpinte Dyos ttanam,</para>
  <para style="q">kche tzalajelju' tyajajil Jakob',</para>
  <para style="q">tkyaqilju' tnam Israel, chiju' b'itzal</para>
  <chapter number="54" style="c" />
  <para style="s1">Qanb'il o'nb'il te Qman Dyos</para>
  <para style="q">
    <verse number="1" style="v" />¡Nman Dyos, chin tkloma tu'n tb'iya!</para>
  <para style="q">¡Chin tkloma tuk'i'l tipumala!</para>
  <para style="q">
    <verse number="2" style="v" />Nman Dyos b'intza nna'j Dyose',</para>
  <para style="q">chin ttzaq'wetza,</para>
  <para style="q">
    <verse number="3" style="v" />qu'n matxi' jawkyi'nkyib' xjal nkynima'n kyib' wi'je',</para>
  <para style="q">Kyajb'ilju' ajq'oj tx'u'j kywi' tu'n nkub' kyb'yo'ne'.</para>
  <para style="q">¡Min nche ximan ti'ja Dyos!</para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" />Tu'npetzunju', oni'n qinwe' tu'n Dyos;</para>
  <para style="q">ate Qman Dyos q'ol nchwinqlale'.</para>
  <para style="q">
    <verse number="5-6" style="v" />Ate Qman Dyos kb'inchalte</para>
  <para style="q">tu'n tkub' tz'aqju' kyb'inchb'en wajq'oje kyib'ajx.</para>
  <para style="b" />
  <para style="q">¡Xitunqeku'ya Nman Dyos, qu'n njapunta tyol!</para>
  <para style="q">Che kxe'lnq'o'nwe' chojb'il teya tu'n tkyaqil nk'u'je',</para>
  <para style="q">ex kjawil nnima'nju'ye' tb'iya, qu'n b'a'nxi'xta,</para>
  <para style="q">
    <verse number="7" style="v" />qu'n matxi' chin tkola toj tkyaqilju' yajb'ilweye'</para>
  <para style="q">ex mawile' xkub' kyi'ju' wajq'oje.</para>
  <chapter number="55" style="c" />
  <para style="s1">Tna'j Dyos jun xjal ljo'n toj tq'ij</para>
  <para style="q">
    <verse number="1" style="v" />Nman Dyos, b'intzju'ya nna'j Dyose',</para>
  <para style="q">lalun txi'tewa'n twitza ajnkub'sane' teya.</para>
  <para style="q">
    <verse number="2-3" style="v" />Chin tb'intza ex chin ttzaq'wetza;</para>
  <para style="q">nchin kub'sane' teya toju' yajb'ilweye'</para>
  <para style="q">Nchin lu'lune' noqx tu'n tq'ojq'ojel twi'ju' wajq'oje</para>
  <para style="q">ex tu'n nche ẍch'inju' b'inchal myab'a'n.</para>
  <para style="b" />
  <para style="q">Matxi' tz'ok nb'ise' kyu'n;</para>
  <para style="q">nche oktzaqpaj wi'je' tuk'i'l kytx'u'jil.</para>
  <para style="q">
    <verse number="4" style="v" />Int'uẍjne wanmiye',</para>
  <para style="q">ex matxi' tz'oktenju' tchiylal kamik wi'je'.</para>
  <para style="q">
    <verse number="5" style="v" />Matxi' tz'ok jun tchiylal wi'je' xob'ajilxi'x;</para>
  <para style="q">¡nchin lu'lune' tu'n xob'il!</para>
  <para style="q">
    <verse number="6" style="v" />Ex a inma'ne':</para>
  <para style="q">Noqwit ikj ate' nxik'e' kse'nte paloms;</para>
  <para style="q">jaku'wtlo chinx lipane' tu'n wojlane'.</para>
  <para style="q">
    <verse number="7" style="v" />Jaku' chinx lipane' najchaq,</para>
  <para style="q">jaku' chin kyej tentzuntze' najal toj chq'ajlaj.</para>
  <para style="q">
    <verse number="8" style="v" />Jaku' ja'lo chinxe' ewal</para>
  <para style="q">teju' tipumal kyq'iq' ex q'ankyaq. Nchije'.</para>
  <para style="b" />
  <para style="q">
    <verse number="9" style="v" />Xitunqe'ku'ya Nman Dyos, chuksanku'ya kyyol;</para>
  <para style="q">qu'n o'kx q'oj ex ik'b'il nnok nka'yine',</para>
  <para style="q">
    <verse number="10" style="v" />inkytxoli'nkyib' ti'ju' nintnam q'ijtl ex qonik'an</para>
  <para style="q">Ati il ex ik'b'il toju' tnam;</para>
  <para style="q">ati sb'ub'l ex taq'wixil toj;</para>
  <para style="q">
    <verse number="11" style="v" />nojniqe' t-xk'ichb'e tu'n taq'wixil ex sb'ub'l.</para>
  <para style="b" />
  <para style="q">
    <verse number="12" style="v" />Mya jun wajq'oje sok ik'len weye',</para>
  <para style="q">qu'n ma'wtlo tzik'x wu'ne';</para>
  <para style="q">ex myaju' ntx'a'lti'j tk'u'j xjaw ti'ntib' wi'je',</para>
  <para style="q">qu'n ma'wtlo chin kub' ewane' twitz.</para>
  <para style="q">
    <verse number="13" style="v" />¡Kuchaqa a pe'lota nwnaqila,</para>
  <para style="q">kyexi'x ntene' tuk'i'la,</para>
  <para style="q">
    <verse number="14" style="v" />intoq qb'u'yi'n qib' tuk'i'la toj tja Dyos</para>
  <para style="q">q'uqlixi'xtoq qk'u'j te qib' kyi'ju' qyol</para>
  <para style="q">tej intoq qob'et kyxol xjal!</para>
  <para style="b" />
  <para style="q">
    <verse number="15" style="v" />¡Mixwitti' kynab'enju' wajq'oje ajtul kamik kyi'j!</para>
  <para style="q">¡Itz'qe'xwit ajkyb'ajx qoptz'aj toj jul!</para>
  <para style="q">qu'n majx atiju' taq'wixil toj kyanmi.</para>
  <para style="b" />
  <para style="q">
    <verse number="16" style="v" />Ayintzunwe' kchin kub'sale' te Dyos;</para>
  <para style="q">ate Qman Dyos kklol weye'.</para>
  <para style="q">
    <verse number="17" style="v" />Chin kub'sale' tuk'i'l oq'el prim, qale ex qonik'an</para>
  <para style="q">ktzajel tb'i'ntzun tq'ojq'ojel nwi'tze'.</para>
  <para style="q">
    <verse number="18" style="v" />Kchin tkla'ye' kyoj q'oj;</para>
  <para style="q">kkletel nchwinqlale' tu'n,</para>
  <para style="q">b'a'nqa txqan kyb'etju' wajq'oje.</para>
  <para style="b" />
  <para style="q">
    <verse number="19" style="v" />Aku' Dyos nkawin tejumajx,</para>
  <para style="q">ktzajel b'inweye' ex che kb'el tme'ssa'n,</para>
  <para style="q">qu'n mixti'x nkych'exb'e'n kye'lu kychwinqlal</para>
  <para style="q">ex mixti' tchi Dyos kye.</para>
  <para style="q">
    <verse number="20" style="v" />In aq'pon kyq'ob' kyi'j kamiw;</para>
  <para style="q">min njapun kyol tziya'n kyu'n.</para>
  <para style="q">
    <verse number="21" style="v" />Majxpetzun me's che yolin,</para>
  <para style="q">atzu'n kynab'l o'kxtzu' toka' ti'j q'oj.</para>
  <para style="q">Majx b'uninxi'xju' kyoj nnajb'en kyetwitz aseyt,</para>
  <para style="q">extzun ikyqe'ju' kse'n k'uẍtx'e'nb'il jqu'n kywitzte.</para>
  <para style="b" />
  <para style="q">
    <verse number="22" style="v" />Q'onkja tkyaqilju' nnik'xtu'na toj tq'ob' Qman Dyos,</para>
  <para style="q">qu'n ate kwab'alteya b'a'nxi'x;</para>
  <para style="q">lay taj tu'n tkub' tz'aqu' xjal b'a'n b'in te.</para>
  <para style="b" />
  <para style="q">
    <verse number="23" style="v" />Nman Dyos,</para>
  <para style="q">lay che kub' anq'in kyeju' b'yolxjal exqe' chalyol,</para>
  <para style="q">laype' japun nik'janju' kychwinqlal;</para>
  <para style="q">che kb'elex tz'aq tu'na toj muqb'il,</para>
  <para style="q">ayintzunwe' q'uqlokwe' nk'u'j ti'ja. Chiju' b'itzal.</para>
  <chapter number="56" style="c" />
  <para style="s1">Q'uqli nk'u'je' ti'j Dyos ex in nima'ne' tyol</para>
  <para style="q">
    <verse number="1" style="v" />Nman Dyos, q'aq'antz tk'u'ja wi'je',</para>
  <para style="q">ate'kye xjal ljo'n toj nq'ije' kyu'n;</para>
  <para style="q">q'achq'alx nche q'ojin wi'je' ex nche okten yajul weye'.</para>
  <para style="q">
    <verse number="2" style="v" />Tkyaqil kmuj nchin jyonjtze' kyu'n wajq'oje</para>
  <para style="q">nim kyb'aju' nche oktzaqpaj wi'je' tuk'i'l nimjtib'il.</para>
  <para style="b" />
  <para style="q2">
    <verse number="3" style="v" />Qa nchin xob'e' inok qe nk'u'je' ti'ja.</para>
  <para style="q2">
    <verse number="4" style="v" />Q'uqli nk'u'je' ti'j Dyos ex in nnima'nju'ye' tyol;</para>
  <para style="q2">q'uqli nk'u'je' ti'j Dyos ex min chin xob'e'.</para>
  <para style="q2">¿Titi' k'okyel tb'incha'n xjal wi'je'?</para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" />Tkyaqil kmuj nchin kyk'ixb'sa'ne' tu'n kyyol;</para>
  <para style="q">o'kx nkyxima'ju' tu'n kyb'inchante taq'wixil wi'je'.</para>
  <para style="q">
    <verse number="6" style="v" />Inxi'x che jutzajla xq'uqilweye',</para>
  <para style="q">tokkywitz wi'je'.</para>
  <para style="q">ja chin okyela' yale' kyu'n tu'n nkub' kyb'yo'ne'.</para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" />¿Ma oktzun che tzaqpajel toju' kyil?</para>
  <para style="q">Nman Dyos, xitunqe'ku'ya tnam tu'n ttx'u'jila.</para>
  <para style="q">
    <verse number="8" style="v" />Q'i'na'ta tajlal tu'n jte'xi' maj chin kub' oqe';</para>
  <para style="q">ex aya inel sunte ta'l nwitze'.</para>
  <para style="b" />
  <para style="q">¿Ma mixtzunti' tz'ib'a'n tu'na toju' tuja?</para>
  <para style="q">
    <verse number="9" style="v" />Che xe'l oqu' wajq'oje</para>
  <para style="q">naqa xxi'nqanine' o'nb'il teya.</para>
  <para style="q">B'i'nxi'xwe' wu'n qa ati Dyos wuk'i'le'.</para>
  <para style="b" />
  <para style="q2">
    <verse number="10" style="v" />Q'uqliwe' nk'u'j ti'j Dyos ex njaw nnima'ne' tyol,</para>
  <para style="q2">q'uqli nk'u'je' ti'j Qman Dyos ex njaw nnima'ne' tyol.</para>
  <para style="q2">
    <verse number="11" style="v" />Q'uqliwe' nk'u'j ti'j Dyos ex min nchin xob'e'.</para>
  <para style="q2">¿Titi' k'okyel tb'incha'n xjal weye'?</para>
  <para style="b" />
  <para style="q">
    <verse number="12" style="v" />Nman Dyos, che japumelwe' nyol wu'n xintziya'ne' teya</para>
  <para style="q">kyuk'i'l nb'itze' teya,</para>
  <para style="q">
    <verse number="13" style="v" />Qu'n machin tkola teju' kamik,</para>
  <para style="q">mana' chin tkola tu'n lalun chin kub' tz'aqe',</para>
  <para style="q">tu'ntzun nb'ete' toju' t-spik'umal chwinqlal</para>
  <para style="q">twitz Qman Dyos, chiju' b'itzal.</para>
  <chapter number="57" style="c" />
  <para style="s1">Na'j Dyos qanb'il o'nb'il te Qman Dyos</para>
  <para style="r">(<ref loc="PSA 108:1-5">Sal 108.1-5</ref>)</para>
  <para style="q">
    <verse number="1" style="v" />Q'aq'antz tk'u'ja wi'je' Nman Dyos, q'aq'antz tk'u'ja wi'je',</para>
  <para style="q">qu'n tuk'i'la njyo'na'ye' kolb'il,</para>
  <para style="q">wajb'ile' tu'n nklete' tjaq' t-xik'a</para>
  <para style="q">tzmax ajtik'ju' yajb'il.</para>
  <para style="q">
    <verse number="2" style="v" />Kjawil tq'ojq'ojel nwi'ye' te Dyos jawnixi',</para>
  <para style="q">Aju' Qman Dyos ntzaj oninweye' toj tkyaqil.</para>
  <para style="q">
    <verse number="3" style="v" />Ktzajel tq'o'n tk'u'jlalil exju' ax tzmax toj kya'j,</para>
  <para style="q">ex chin tkla'ye' te kytx'u'jilju' ljo'n toj nq'ije' kyu'n.</para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" />Matxi' chin kub' tz'aqe',</para>
  <para style="q">kyxolju' b'alun inche ch'yon xjal;</para>
  <para style="q">iky kywitzteju' kse'n ch'ut ex talsmaj,</para>
  <para style="q">iky kyaq'ju' kse'n k'uẍtx'e'nb'il jqu'n twitzte.</para>
  <para style="b" />
  <para style="q2">
    <verse number="5" style="v" />Nman Dyos, atiya tib'aju' kya'j.</para>
  <para style="q2">¡Nojni tkyaqil twitz tx'otx' tu'n tajwalila!</para>
  <para style="b" />
  <para style="q">
    <verse number="6" style="v" />Makub' kyq'o'n wajq'oje jun xpatxab' toj nb'eye'</para>
  <para style="q">naq tu'n ttzaj xob'il wi'je'</para>
  <para style="q">ma ku'x kyb'incha'n jun jul toj nb'eye',</para>
  <para style="q">ex aye'x ẍeku'x tz'aq toj.</para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" />Nman Dyos, matxi' qexi'x nk'u'je' ti'ja</para>
  <para style="q">inchin tzalaje' tu'n nb'itzane' teya.</para>
  <para style="q">
    <verse number="8" style="v" />Nna'ntztzun wib'e'</para>
  <para style="q">kyna'ntzkyib'e' chnab' arpa ex tzintzin;</para>
  <para style="q">¡kchin jawil weye' q'ol chjonte te Dyos ajttzaj t-xe kya'j!</para>
  <para style="q">
    <verse number="9" style="v" />Kchin b'itzale' teya, Nman Dyos</para>
  <para style="q">kyxolju' k'ok'e' tnam ex nimaqtnam.</para>
  <para style="q">
    <verse number="10" style="v" />Tb'anilxi'xte' tk'u'jlalila toj kya'j</para>
  <para style="q">nojni twitz ẍkul kya'j tu'nju' toklena.</para>
  <para style="b" />
  <para style="q2">
    <verse number="11" style="v" />Nman Dyos, atiya tib'aj kya'j.</para>
  <para style="q2">¡Nojni tkyaqil twitz tx'otx' tu'n tajwalila! Chiju' b'itzal.</para>
  <chapter number="58" style="c" />
  <para style="s1">Qanb'ilte tu'n tokju' kawb'il b'a'n</para>
  <para style="q">
    <verse number="1" style="v" />Aye'ye' nimaq kyoklene',</para>
  <para style="b" />
  <para style="q">¿ma ax, ma nkyb'incha'ne' tz'e'ysb'il witzb'aj tojxi'x tu'me'l</para>
  <para style="q">ex manche kawine' tojxi'x ttxolilti'j?</para>
  <para style="b" />
  <para style="q">
    <verse number="2" style="v" />Minti', inpena' che kawine' tuk'i'l kyxime' myab'a'n;</para>
  <para style="q">nb'aj qojli chik' kyu'ne' toj tkyaqilju' tx'otx'.</para>
  <para style="b" />
  <para style="q">
    <verse number="3" style="v" />Majx nche tzajb'entju' b'inchal taq'wix exqe' chalyol</para>
  <para style="q">toj t-xmilalju' kytxu.</para>
  <para style="q">
    <verse number="4" style="v" />Ikyqe' kse'n kan wotz, ati kyb'i'yb'il</para>
  <para style="q">ikyqe' kse'n jun kan ati tb'iyb'il</para>
  <para style="q">naq nkub' t-ẍkyinsa'n tib'.</para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" />Min tajb'il tu'n t-xitb'i'n tchinab'ju' mansil kan</para>
  <para style="q">ju' nxitq'ajtza'n tu'n tmanset.<note caller="+" style="f"><char style="fr" closed="false">58.5 </char><char style="ft" closed="false">Nota: Toj juntl plaj te tx'otx', ate' xjal nche b'ixin wotz kan ati kyb'iyb'il kyu'n ajt-xi kyq'ajtza'n kychinab', ex nchikub' mansix kyu'n.</char></note></para>
  <para style="b" />
  <para style="q">
    <verse number="6" style="v" />Taye, ¡q'uchimitzju'ya kywitzte!</para>
  <para style="q">Nman Dyos, ¡q'uchimitza kykaju' b'alun na'j!</para>
  <para style="q">
    <verse number="7" style="v" />Che kub'xwit naj kse'n a' ajtik' qojli,</para>
  <para style="q">che kub'xwit tzqij kse'n k'ul toj b'e.<note caller="+" style="f"><char style="fr" closed="false">58.7 </char><char style="ft" closed="false">Nota: Jun tu'me'l ja'lu tu'n tpjet, qu'n ch'uẍ tu'n tkane toju' yol eb'rey.</char></note></para>
  <para style="q">
    <verse number="8" style="v" />Che kub'xwit yulj kse'n xqortxa'n tu'n atz'an,</para>
  <para style="q">¡kse'n jun k'wal min tkno'n tq'ij!,</para>
  <para style="q">
    <verse number="9" style="v" />mixwitti' kynab'en ti'j ajkytzyet tu'n q'aq' kse'n ch'i'x ajkytz'e'y;</para>
  <para style="q">che jawxwit xb'oqi'n tuk'i'l tx'u'jilj, kse'n cha'x k'ul.</para>
  <para style="b" />
  <para style="q">
    <verse number="10" style="v" />Ktzalajelju' xjal tnik'alti'j ajtok tu'me'l t-xel tu'n;</para>
  <para style="q">¡ajtb'aj twab'e'n tchk'elju' b'inchal myab'a'n!</para>
  <para style="q">
    <verse number="11" style="v" />Kq'manjtzeltzuntz.</para>
  <para style="q">¡Tb'anilxi'xte' qa tnik'alqi'j!</para>
  <para style="q">¡Qu'n ati jun Dyos nkawin tib'aj tkyaqil twitz tx'otx'! Chiku' kq'umjeb'el. Chiju' b'itzal.</para>
  <chapter number="59" style="c" />
  <para style="s1">A Qman Dyos klolqe</para>
  <para style="q">
    <verse number="1" style="v" />Nman Dyos, chin tkloma kyeju' wajq'oje,</para>
  <para style="q">chin ttzaqpima toj kyq'ob'ju' njaw kyi'nkyib' wi'je'.</para>
  <para style="q">
    <verse number="2" style="v" />Chin tkloma kyeju' b'inchal il,</para>
  <para style="q">chin tkloma kyeju' nche b'yon xjal,</para>
  <para style="q">
    <verse number="3" style="v" />qu'n ate' xjal nim kyipumal</para>
  <para style="q">naq nche ayon tu'n nkub' kyb'yo'ne'.</para>
  <para style="b" />
  <para style="q">Nman Dyos, b'ajx chin jawa' miltz'uja'we' ti'ja ex b'ajx nb'inchaya'we' il</para>
  <para style="q">
    <verse number="4" style="v" />b'ajxa' nb'inchawe' jun ti'xti'ye' myab'a'n,</para>
  <para style="q">extzun noktilil kyu'n tu'n kytzaj q'ojil wi'je'</para>
  <para style="q">¡Iq'i'nktz tib'a! ¡Kutzaja ex chin tka'yintza!</para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" />Nman Dyos,</para>
  <para style="q">aya te tkyaqil ipumalj, janche k'uluna' aj Israel,</para>
  <para style="q">na'ntztib'a ex tz'e'ysanku'ya kywitzju' nimal kye txqantl dyos;</para>
  <para style="b" />
  <para style="q">lalun tzaj q'aq'an tk'u'ja kyi'ju' njaw kyi'nkyib' b'inchal myab'a'n.</para>
  <para style="q">
    <verse number="6" style="v" />In anjtzkyi'j qonik'an ex nche chiyon naku'j tx'yan,</para>
  <para style="q">ex inche b'ajb'et ti'jile nintnam.</para>
  <para style="q">
    <verse number="7" style="v" />Inel kylanu'n kyol,</para>
  <para style="q">inkyma'n tu'n kytx'u'jil:</para>
  <para style="q">¡Mix-a'lo'te kb'il qe! Chechij.</para>
  <para style="b" />
  <para style="q">
    <verse number="8" style="v" />Atzunta Nman Dyos, naq njaw tze'nta kyi'j;</para>
  <para style="q">inxmayinta kyi'ju' nimal lu kye txqantl dyos.</para>
  <para style="q">
    <verse number="9" style="v" />Ti'ja nklo'na' wib'e', Nman Dyos,</para>
  <para style="q">qu'n aya wipumale' ex klol weye'.</para>
  <para style="q">
    <verse number="10" style="v" />Aju' Dyos ink'u'jlan weye' tzul k'ulul weye';</para>
  <para style="q">tu'nte knla'ju'ye' kanb'ab'l kyib'aju' wajq'oje.</para>
  <para style="b" />
  <para style="q">
    <verse number="11" style="v" />Lalun tzaj laqj tk'u'ja kyi'j,</para>
  <para style="b" />
  <para style="q">tu'ntzun lalun tzik'tna'l tu'nju' ntaname';</para>
  <para style="q">spuntinqe'xa tu'n tipumala, ex me'ssanqe'ku'ya.</para>
  <para style="q">¡Ate Qman Dyos, kolol qi'j!</para>
  <para style="b" />
  <para style="q">
    <verse number="12" style="v" />Inche b'inchan il tu'n tkyaqilju' inkyma'n;</para>
  <para style="q">¡che kyajxwit muqli tjaq'ju' nimjtib'il ati kyoj</para>
  <para style="q">ex tjaq'ju' chajyolil nkyma'n!</para>
  <para style="q">
    <verse number="13" style="v" />¡Najsanqeku'ya, najsanqe'ku'ya tuk'i'l ttx'u'jila!</para>
  <para style="q">¡Tu'n lalun che anq'intl!</para>
  <para style="q">¡Tu'ntzun tel tnik'tzil qa a Dyos nimaqkawil</para>
  <para style="q">kyib'aj tyajajil Jakob' ex tib'aj tkyaqil twitz tx'otx'!</para>
  <para style="q">
    <verse number="14-15" style="v" />Ajtanjtzkyi'j qonik'an nche chiyon naku'j tx'yan,</para>
  <para style="q">ajkyb'aj b'et ti'jile nintnam jyol kywa,</para>
  <para style="q">kche jawil xo'jin qu'n lay tz'okyal kywa nim.</para>
  <para style="b" />
  <para style="q">
    <verse number="16" style="v" />Ayintzunwe', kchin b'itzale' teya te prim;</para>
  <para style="q">kxe'l nma'ne' tk'u'jlalila ex tipumala tuk'i'l tq'ojq'ojel nwi'ye'.</para>
  <para style="q">Qu'n aya matxi' tz'ok te kolb'ilweye',</para>
  <para style="q">e'wb'il weye' kyoju' kmuj te k'ixk'oj.</para>
  <para style="q">
    <verse number="17" style="v" />O'kx teya kchin b'itzala'ye' Nman Dyos,</para>
  <para style="q">qu'n aya ipumalj weye' ex kolb'ilweye';</para>
  <para style="q">¡a na'ta Dyos ink'u'jlan weye'! Chiju' b'itzal.</para>
  <chapter number="60" style="c" />
  <para style="s1">Na'j Dyos qanb'il o'nb'il te toj kya'j</para>
  <para style="r">(<ref loc="PSA 108:6-13">Sal 108.6-13</ref>)</para>
  <para style="q">
    <verse number="1" style="v" />Nman Dyos, maqokyej tkolb'e'na toju' ttx'u'jila,</para>
  <para style="q">matxi' qokub' t-xitu'na;</para>
  <para style="q">¡ja'lo q'ontz jumajtla qipumale'!</para>
  <para style="q">
    <verse number="2" style="v" />Tb'inchaya tu'n tyukchiju' tx'otx' ex tu'n txi' jaqli;</para>
  <para style="q">¡ja'lo jpunku' jumajtla xb'aj jaqj, qu'n in qotx'j!</para>
  <para style="q">
    <verse number="3" style="v" />Matb'inchaya tu'n tik'ju' ttanama toj yajb'il kuw,</para>
  <para style="q">matzaj tq'o'na jun q'e'n qeye' nnok toj kywitz xjal tu'n;</para>
  <para style="q">
    <verse number="4" style="v" />¡Tzaj tq'o'na jun techlal kyeju' inche niman teya,</para>
  <para style="q">tu'ntoq kyklet kyeju' smaj nche tzaj xon!</para>
  <para style="q">
    <verse number="5" style="v" />¡Qo ttzaq'wetza, qo tkloma tu'n tipumala!</para>
  <para style="q">¡Klomqe'ju'ya nche tk'u'jla'na!</para>
  <para style="b" />
  <para style="q">
    <verse number="6" style="v" />Oje tma Qman Dyos toju' tja xjan;</para>
  <para style="q">¡Kb'el waq'pu'nju'ye' tx'otx' Sikyem tuk'i'l tzalajb'il</para>
  <para style="q">ex kb'ajel nsipa'ne' b'ya' Sukot!</para>
  <para style="q">
    <verse number="7" style="v" />Weqe'weye' Kalaad ex Manases;</para>
  <para style="q">ate Eprayin kolb'il tokx toj nwi'ye';</para>
  <para style="q">atzu'n Juda ntzeye' te aq'b'il chaq'b'il.</para>
  <para style="q">
    <verse number="8" style="v" />A nk'o'ẍju'ye' Moab' te ntx'ajb'ile';</para>
  <para style="q">kb'el nxone' nxajab'e' tib'aj Edom;</para>
  <para style="q">¡kchin jawil ẍch'ine' ajnkanb'ane' kyib'aj pilistey! Chi Dyos.</para>
  <para style="b" />
  <para style="q">
    <verse number="9" style="v" />¿Alxi'xkye k'onil weye' tu'n tkub'ti'ju' nintnam jpu'mile ti'j tu'n nintapi?</para>
  <para style="q">¿Alkye kpomel q'inweye' toju' tnam Edom?</para>
  <para style="q">
    <verse number="10" style="v" />Aya Nman Dyos, ju' o eltik'o'na,</para>
  <para style="q">¡minti' nnextla kyuk'i'lju' qxjale' te q'oj!</para>
  <para style="q">
    <verse number="11" style="v" />Qo tonima tu'n tkub'ti'ju' qajq'oje',</para>
  <para style="q">qu'n aju' qe' qipumal mixti'x tz'oka'.</para>
  <para style="q">
    <verse number="12" style="v" />Tu'nju' t-o'nb'il Dyos kb'entel nimaq ti'xti' qu'n;</para>
  <para style="q">¡ate kb'el najsankyeju' qajq'oj! Chiju' b'itzal.</para>
  <chapter number="61" style="c" />
  <para style="s1">Tu'n tqe qk'u'j ti'ju' kolb'il tu'n Dyos</para>
  <para style="q">
    <verse number="1" style="v" />Nman Dyos, b'intza tq'ojq'ojel nwi'ye' toj k'ixk'oj;</para>
  <para style="q">¡b'intza nna'j Dyose'!</para>
  <para style="q">
    <verse number="2" style="v" />Inchin kub'sane' twitza tzmaxtzu' toj mankb'il ttxa'n tx'otx',</para>
  <para style="q">qu'n kxi' nkub'aje'.</para>
  <para style="q">Chin tkloma tib'aj jun pik nimin twe',</para>
  <para style="q">
    <verse number="3" style="v" />ana'ya kolb'ilweye'.</para>
  <para style="q">¡Ikju'ya kse'n jun ja nimin twe' ex kuw</para>
  <para style="b" />
  <para style="q">inchin tklo'na kyeju' wajq'oje!</para>
  <para style="q">
    <verse number="4" style="v" />Wajb'ile' tu'n ntene' toju' tjaya tejumajx,</para>
  <para style="q">tu'n nklete' tjaq' t-xik'a.</para>
  <para style="q">
    <verse number="5" style="v" />Matxi' che tzaj tb'i'nta nyole' xintziya'ne' teya, Nman Dyos,</para>
  <para style="q">ex matxi' tzaj tq'o'nju'ya wetzb'ile'</para>
  <para style="q">ti'j kyetzb'ilju' nche niman te tb'iya.</para>
  <para style="b" />
  <para style="q">
    <verse number="6" style="v" />Q'ontza tchwinqlalju' nimaqkawil nimtoj;</para>
  <para style="q">tz'anq'inxwit b'a'npun ab'q'i,</para>
  <para style="q">
    <verse number="7" style="v" />ex kawinxwit kukxju' tuk'i'l tky'i'wb'ila.</para>
  <para style="q">Xq'uqima tuk'i'l tk'ujlalila ex tyola ax;</para>
  <para style="q">
    <verse number="8" style="v" />tu'ntzun nb'itzane' ti'ju' tb'iya kukxju'</para>
  <para style="q">ex kche japumelwe' nyol tziya'ntl wu'ne' twitza atl junjun q'ij, chiju' b'itzal.</para>
  <chapter number="62" style="c" />
  <para style="s1">O'kx Qman Dyos kolb'ilqe</para>
  <para style="q">
    <verse number="1" style="v" />Naq o'kx tuk'i'l Dyos nkneta' nak'b'il wu'ne',</para>
  <para style="q">tk'etzte ntzaja' kolb'ilweye'.</para>
  <para style="q">
    <verse number="2" style="v" />Naq o'kxte klol weye' ex xq'uqilweye'.</para>
  <para style="q">Lay chin kub' tz'aqe', qu'n ate e'wb'il weye'.</para>
  <para style="b" />
  <para style="q">
    <verse number="3" style="v" />¿Ma kukx che okyil tzaqpaju'ye' wi'je'</para>
  <para style="q">tu'n nkub' kyxone' twitz tx'otx',</para>
  <para style="q">kse'n jun tapi ajttzaj tz'aq</para>
  <para style="q">mujqa kse'n ch'laj noqx tu'n ttzajtz'aqtel twitz tx'otx'?</para>
  <para style="q">
    <verse number="4" style="v" />O'kxtzu' nche ximana'ye' tu'n nkub' kyxitune';</para>
  <para style="q">axi'x kytzalajb'ilju'ye' chajyolil.</para>
  <para style="q">Naq tu'n kytziye' nchin jawa' kynimane',</para>
  <para style="q">atzu'n kynab'le' nche yasune' wi'je'.</para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" />O'kx tuk'i'l Dyos nkneta' nak'b'il wu'ne';</para>
  <para style="q">qu'n tuk'i'l ntzaja' q'uqb'ab'l nk'u'je'.</para>
  <para style="q">
    <verse number="6" style="v" />O'kxte nklonweye' ex inxq'uqinweye'.</para>
  <para style="q">Lay chin kub' tz'aqe', qu'n ate e'wb'il weye'.</para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" />Tuk'i'l Dyos ntzaja' kolb'ilweye' exju' ninb'ilweye';</para>
  <para style="q">ate inklonweye' ex e'wb'il weye'.</para>
  <para style="q">
    <verse number="8" style="v" />¡Nwnaqil, qek kyk'u'je' ti'j Qman Dyos kukxju'!</para>
  <para style="q">¡Che yolinqe'ye' tuk'i'l toj na'j Dyos q'uqlixi'x kyk'u'je'!</para>
  <para style="q">¡Ate Dyos e'wb'il qe!</para>
  <para style="b" />
  <para style="q">
    <verse number="9" style="v" />Naqxgante' xjal,</para>
  <para style="q">b'a'nqa q'inun mujqa prow;</para>
  <para style="q">naqwit che kub' mlo'n junx toj jun malb'il,</para>
  <para style="q">mixpeloti'xte kyalal kyetwitz kyq'iq'.</para>
  <para style="q">
    <verse number="10" style="v" />Lalun qe kyk'u'je' ti'ju' q'oj kyib'aj xjal;</para>
  <para style="q">¡lalun jawkynima'n kyib'e' ti'j kyeleq'e'!</para>
  <para style="q">qama che jaw q'inumaxe',</para>
  <para style="q">lalun tz'okqe kyk'u'je' ti'j pwaq.</para>
  <para style="b" />
  <para style="q">
    <verse number="11-12" style="v" />B'a'npunxi' maj nb'iye' te Dyos</para>
  <para style="b" />
  <para style="q">qa te qe'ju' ipumalj exju' tk'u'jlalil</para>
  <para style="q">ex intq'o'n tu'me'l t-xel teyile junjun</para>
  <para style="q">kse'nxju' tb'inchb'en, chiju' b'itzal.</para>
  <chapter number="63" style="c" />
  <para style="s1">In qe tk'u'ju' xjal tu'n Dyos</para>
  <para style="q">
    <verse number="1" style="v" />¡Nman Dyos, teya nchin nimana'ye'!</para>
  <para style="q">Inxi'x chin jyone' ti'ja, qu'n inchin k'wajtiye' ti'j;</para>
  <para style="q">inxi'x chin elb'aje' ti'ja,</para>
  <para style="q">kse'n tx'otx' tzqij, in ojqelan a' te.</para>
  <para style="q">
    <verse number="2" style="v" />¡Wajb'ile' tu'n nka'yinteya toju' tjaya xjan,</para>
  <para style="q">ex tu'n nka'yinteju'ye' tipumala ex tajwalila.</para>
  <para style="q">
    <verse number="3" style="v" />nimxi'xte' toklenju' tk'u'jlalila kyetwitzju' chwinqlal!</para>
  <para style="q">Kchin b'itzale' teya tu'n ntziye';</para>
  <para style="q">
    <verse number="4" style="v" />tkyaqil tq'ijlalil nchwinqlale' kjawil nnima'na,</para>
  <para style="q">ex kjawil nmujb'a'n nq'ob'e' teya toj na'j Dyos.</para>
  <para style="q">
    <verse number="5" style="v" />Kqeb'iltzun nk'u'jtze',</para>
  <para style="q">kse'n xjal nxi' toj jun ninwan,</para>
  <para style="q">ex kchin b'itzale' teya tuk'i'l tzalajb'il,</para>
  <para style="b" />
  <para style="q">
    <verse number="6" style="v" />Nkub'lenxi' kẍeye' toj qonik'an,</para>
  <para style="q">intzaj nna'na ex inchin ximane' ti'ja,</para>
  <para style="q">
    <verse number="7" style="v" />qu'n a na'ta nnonin weye'.</para>
  <para style="q">¡Inchin tzalaje' kyjaq'ju' t-xik'a!</para>
  <para style="q">
    <verse number="8" style="v" />Tkyaqilju' nchwinqlale' ati tuk'i'la;</para>
  <para style="q">min nchin kyej ttzaqpi'ne' tb'anq'ob'a.</para>
  <para style="q">
    <verse number="9" style="v" />Aye'kye' kyajb'il tu'n nkub' kyb'yo'ne'</para>
  <para style="q">che b'elix tz'aq tzmajx t-xe muqb'il;</para>
  <para style="q">
    <verse number="10" style="v" />¡tu'n k'uẍtx'e'nb'il kb'ajela' tokywi'</para>
  <para style="q">ex che b'ajel ch'yo'n kyu'n xo'j!</para>
  <para style="q">
    <verse number="11" style="v" />Atzunte' nimaqkawil ktzalajel ti'j Dyos;</para>
  <para style="q">kche b'itzalju' inkyma'n kyol ax twitz Dyos,</para>
  <para style="q">aye'tzu'n nche chanyol lay jqet kytzi. Chiju' b'itzal.</para>
  <chapter number="64" style="c" />
  <para style="s1">Na'j Dyos qanb'il kolb'il te Dyos</para>
  <para style="q">
    <verse number="1" style="v" />Nman Dyos, b'intzju'ya tq'ojq'ojel nwi'ye',</para>
  <para style="q">klomju'ya nchwinqlale' kyeju' wajq'oje xob'ajilqe'xi'x.</para>
  <para style="q">
    <verse number="2" style="v" />Chin tewanku'ya kywitzju' b'inchal myab'a'n</para>
  <para style="q">ex teju' kyxim nk'u'n toj ewaj;</para>
  <para style="q">chin tkloma kye b'inchal myab'a'n xjaw kyb'u'yi'n kyib' wi'je',</para>
  <para style="q">
    <verse number="3" style="v" />Naku'j k'uẍtx'e'nb'ilju' kyaq' jqu'n twitzte</para>
  <para style="q">inkylanu'n kyyol te k'ixb'sab'l kse'n smaj.</para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" />Inche tzaj xon tzmajx toj kyewb'il ti'ju' xjal mixti' til;</para>
  <para style="q">naq myanim ajkytzaj xon ex min nche xob'.</para>
  <para style="q">
    <verse number="5" style="v" />Inkyoni'nkyib' kyxolilex tu'n kyb'inchante myab'a'n;</para>
  <para style="q">inkub' kyxima'n tu'n tkub' kyq'o'n kyxpatxab' toj ewaj</para>
  <para style="q">ex toj kynab'l qa mix-a'lo' kka'yilkye,</para>
  <para style="q">
    <verse number="6" style="v" />qa mix-a'lo' kxpich'ulteju' kyb'inchb'en myab'a'n.</para>
  <para style="q">Ate kxpich'ulkyeju'</para>
  <para style="q">aju' inel tnik' ti'j tkyaqilju' t-xim xjal toj tanmi.</para>
  <para style="q">
    <verse number="7" style="v" />Ate Dyos kk'ixb'salkye kyu'n t-smaj,</para>
  <para style="q">naq minab'en ajkyok tk'ixb'sa'n.</para>
  <para style="q">
    <verse number="8" style="v" />Che kb'eltz'aq tu'nxju' kyol,</para>
  <para style="q">aye'tzu'n che okyel ka'yinkye kche xmayil kyi'j.</para>
  <para style="q">
    <verse number="9" style="v" />Kykyaqiltzuntz kche nimal te Dyos</para>
  <para style="q">ex kche yolil ti'ju' tb'inchb'en;</para>
  <para style="q">k'elelkynik' ti'ju' matxi' b'aj tb'incha'n.</para>
  <para style="q">
    <verse number="10" style="v" />Ktzalajelju' b'a'n xjal ti'j Qman Dyos</para>
  <para style="q">ex ktjya' kolb'il tuk'i'l,</para>
  <para style="q">ex kykyaqilju' xjal tnik'alkyi'j</para>
  <para style="q">kqeb'el kyk'u'j tu'n, chiju' b'itzal.</para>
  <chapter number="65" style="c" />
  <para style="s1">A Qman Dyos b'a'n tu'n tajwalet</para>
  <para style="q">
    <verse number="1" style="v" />Nman Dyos atiya toj Syon,</para>
  <para style="q">¡aya ati tu'n tjaw ajwaleta!,</para>
  <para style="q">¡aya ati toklena tu'n tjapun qyole' twitza,</para>
  <para style="q">
    <verse number="2" style="v" />qu'n intzaj tb'i'nju'ya na'j Dyos!</para>
  <para style="b" />
  <para style="q">Kykyaqilju' xjal toj tkyaqil twitz tx'otx' inche ul tk'etza.</para>
  <para style="q">
    <verse number="3" style="v" />Inkub'qi'je' tu'nju' qb'inchb'ene' taq'wix,</para>
  <para style="q">atzunta inkub' tnajsa'na qile'.</para>
  <para style="q">
    <verse number="4" style="v" />Tzalajb'ilte' teju' xjal injaw t-sk'o'na</para>
  <para style="q">ex inxitiq'i'na najal tk'etza,</para>
  <para style="q">kyoju' najb'il toju' tjaya.</para>
  <para style="q">¡Qo' tnajsama tu'nju' tb'anil ati toj tjaya,</para>
  <para style="q">tu'nju' xjanb'il ati toj tjaya!</para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" />Nman Dyos ex klol qeye',</para>
  <para style="q">inqotzaj ttzaq'we'nta</para>
  <para style="q">kyu'n tb'inchb'ena tb'anilqexi'x ex tnik'alkyi'j;</para>
  <para style="q">kykyaqilju' xjal twitz tx'otx' q'uqlok kyk'u'j ti'ja,</para>
  <para style="q">exqe'ju' xjal najlqe' najchaq toj ninnjab';</para>
  <para style="q">
    <verse number="6" style="v" />tu'nju' tipumala ex toklena</para>
  <para style="q">wa'lqe'ju' witz.</para>
  <para style="q">
    <verse number="7" style="v" />Inkub' nak'eju' ttolob' ninnjab' tu'na</para>
  <para style="q">exju' xitb'il kyxol tnam;</para>
  <para style="q">
    <verse number="8" style="v" />exqepe'ju' xjal te najchaq tx'otx'</para>
  <para style="q">inche lu'lun kywitzju' tb'inchb'ena tb'anilqexi'x;</para>
  <para style="q">naq tu'nela ati sich' te tzalajb'il</para>
  <para style="q">toj tjawetzq'ij ex tkub'exq'ij.</para>
  <para style="q">
    <verse number="9" style="v" />B'a'n tilwiju' tx'otx' tu'na;</para>
  <para style="q">intzaj tq'o'nju'ya jb'al tib'aj tu'n tjaw awal twitz</para>
  <para style="q">ex kyuk'i'l nin a',</para>
  <para style="b" />
  <para style="q">inche ch'iyju' triy tu'na.</para>
  <para style="q">¡Iktzu'n intaq'una'n tx'otx'ju'ya toj kojb'il!</para>
  <para style="q">
    <verse number="10" style="v" />Nb'aj tak'sa'nju'ya tx'otx'</para>
  <para style="q">aj tb'ajkjet tkyaqil inb'aj ak';</para>
  <para style="q">ajttzaj tq'o'na jb'al nim tib'aj</para>
  <para style="q">ex intzaj tky'i'wla'nju'ya awal twitz.</para>
  <para style="q">
    <verse number="11" style="v" />Intnojsa'nju'ya ab'q'i kyu'n ky'i'wb'il</para>
  <para style="q">nim intzaj tq'o'na kyu'nju' muj;</para>
  <para style="q">
    <verse number="12" style="v" />cha'x qe'ju' k'ul toj kojb'il te kywa alu'mj</para>
  <para style="q">exqe'ju' tze toj k'ul inche tzalaj qu'n cha'xqe';</para>
  <para style="q">
    <verse number="13" style="v" />inche b'ajnoju' chq'ajlaj kyu'n rit,</para>
  <para style="q">exqe' b'ya' nojniqe' kyu'n triy;</para>
  <para style="q">¡Kykyaqil nche b'itzan ex nche ẍch'in tu'n kytzalajb'il! chiju' b'itzal.</para>
  <chapter number="66" style="c" />
  <para style="s1">Te lab'te'n qe'xi'xju' taq'unb'ena</para>
  <para style="q">
    <verse number="1" style="v" />Che' b'itzan qe'ye' te Dyos tuk'i'l tzalajb'il,</para>
  <para style="q">ju' najlqe'ye' toj tkyaqil twitz tx'otx';</para>
  <para style="q">
    <verse number="2" style="v" />kyb'itzanqe'xe' b'itz toju' tb'anilxi'x tb'i Qman Dyos;</para>
  <para style="q">che kyb'itzanqe'xe' tb'anil b'itz te.</para>
  <para style="q">
    <verse number="3" style="v" />Kymanxe' te Qman Dyos:</para>
  <para style="q">Tb'anilqe'xi'xju' tb'inchb'ena.</para>
  <para style="q">Inche kub' tz'aqju' tajq'oja twitza;</para>
  <para style="q">tu'nju' nimtipumala;</para>
  <para style="q">
    <verse number="4" style="v" />kykyaqilju' xjal nche k'ulun twitza</para>
  <para style="q">ex inche b'itzan b'itz toj tb'iya. Chechiku'ye' te.</para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" />Kukytzaje' ka'yilteju' taq'unb'en Dyos,</para>
  <para style="q">e' tb'inchb'en tb'anilxi'x matxi' b'aj tb'incha'n kye xjal:</para>
  <para style="q">
    <verse number="6" style="v" />Xitaq'pu'nju' ninnjab' toj kab'e' plaj ex kyej tenju' tx'otx' tzqij,</para>
  <para style="q">ex e'ik'x b'etju' ojtxi' qchman tu'n kyjlajinte nin a' Jordan;</para>
  <para style="q">¡qo'qe' tzalaj ti'j Dyos!</para>
  <para style="q">
    <verse number="7" style="v" />Tu'nju' tipumal, in kawin tejumajx.</para>
  <para style="q">inxq'uqin kyi'ju' nimaqtnam,</para>
  <para style="q">tu'ntzun lalun jawkyi'n kyib'ju' xjal</para>
  <para style="q">mib'a'n che b'in te Dyos.</para>
  <para style="b" />
  <para style="q">
    <verse number="8" style="v" />¡Kyajwalinktze' Qman Dyos e'nimaqtnam!</para>
  <para style="q">¡che b'itzane' tu'n tajwalitju' tb'i!</para>
  <para style="q">
    <verse number="9" style="v" />Qu'n ati qchwinqlal tu'n;</para>
  <para style="q">ex min ntjo'n tu'n qkub' tz'aq.</para>
  <para style="b" />
  <para style="q">
    <verse number="10" style="v" />Nman Dyos, matxi' qo ik'e' toj joyb'il qi'je' tu'na,</para>
  <para style="q">¡matxi' qob'aj t-ẍtilsa'na kse'n saqpwaq!</para>
  <para style="q">
    <verse number="11" style="v" />Maqo jawtz'aqe' tu'na toj pa;</para>
  <para style="q">majawx tq'o'na jun qiqatze' alxi'x.</para>
  <para style="q">
    <verse number="12" style="v" />Mataja tu'n qkub' yaju'ne' tu'n jun alkyexku' xjal;</para>
  <para style="q">matxi' qoyajtiye' toj a' ex toj q'aq',</para>
  <para style="q">te b'ajsb'iltzun matzaj q'aq'an tk'u'ja qi'je'.</para>
  <para style="q">
    <verse number="13" style="v" />Chin okyixe' toju' tjaya ex che kb'el nq'o'ne' chojb'il k'ok'sb'il twitza;</para>
  <para style="q">kjapumeltzun nyoltze' twitza,</para>
  <para style="q">
    <verse number="14" style="v" />aye'ju' nyole' e'nmaye' teya tu'n nb'inchanteye'</para>
  <para style="q">tej xob'ajilxtoq ta'qine'.</para>
  <para style="q">
    <verse number="15" style="v" />Che kb'el nq'o'ne' alu'mj q'u'sqe' te chojb'il k'ok'sb'il twitza;</para>
  <para style="q">che kxe'l nq'o'ne' tman wakx ex tman chib',</para>
  <para style="q">ex rit te chojb'il teya.</para>
  <para style="b" />
  <para style="q">
    <verse number="16" style="v" />¡Kukytzaje' kykyaqile',</para>
  <para style="q">aye'ye' inche xob'e' te Dyos!</para>
  <para style="q">¡Kyb'intzpe'ye', kxe'l nma'ne' kyeye'</para>
  <para style="q">tkyaqilju' t-xtalb'il Dyos matxi' tb'incha weye'!</para>
  <para style="q">
    <verse number="17" style="v" />Machin kub'sane' te</para>
  <para style="q">ex majaw wajwali'ne' tu'n ntziye'.</para>
  <para style="q">
    <verse number="18" style="v" />Noqwit ati nxime' myab'a'n,</para>
  <para style="q">mixti'wtlo ẍin tzaj tb'i'ne' Qman Dyos;</para>
  <para style="q">
    <verse number="19" style="v" />¡atzunte' ma chintzaj tb'i'ne' toj nna'j Dyose'!</para>
  <para style="b" />
  <para style="q">
    <verse number="20" style="v" />¡Nimanxwitju' tb'i Dyos,</para>
  <para style="q">min sel tik'u'nju' nna'j Dyose'</para>
  <para style="q">ex min xkub' tewa'nju' tk'u'jlalil weye'! chiju' b'itzal.</para>
  <chapter number="67" style="c" />
  <para style="s1">¡Jawxwit ajwali'na kyu'n kykyaqilju' tnam!</para>
  <para style="q">
    <verse number="1" style="v" />Nman Dyos,</para>
  <para style="q">Q'aq'antz tk'u'ja qi'je', ex qo' tky'iwlaku'ya;</para>
  <para style="q">qo' tka'yitza tuk'i'l tzalajb'il,</para>
  <para style="q">
    <verse number="2" style="v" />tu'ntzun telkynik' kykyaqilju' tnam</para>
  <para style="q">teju' t-xtalb'ila exju' kolb'il tu'na.</para>
  <para style="b" />
  <para style="q2">
    <verse number="3" style="v" />Nman Dyos,</para>
  <para style="q2">tz'ajwalinjtzxwita kyu'nju' tnam;</para>
  <para style="q2">¡kykyaqilxwitju' tnam che jaw ajwalinteya!</para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" />Che ẍch'inxwitju' nimaqtnam tu'n kytzalajb'il,</para>
  <para style="q">ina' kawinta kyib'aju' tnam toj tnik'alti'j;</para>
  <para style="q">¡aya ẍaqlulkye nimaqtnam toj tkyaqil twitz tx'otx'!</para>
  <para style="b" />
  <para style="q2">
    <verse number="5" style="v" />Nman Dyos,</para>
  <para style="q2">tz'ajwanlinjtzxwita kyu'nju' tnam;</para>
  <para style="q2">¡kykyaqilxwitju' tnam che ajwalin teya!</para>
  <para style="b" />
  <para style="q">
    <verse number="6" style="v" />Matxi' taq'te tx'otx' tawal;</para>
  <para style="q">¡matxi' qotzaj tky'i'wla'n Qman Dyos!</para>
  <para style="q">
    <verse number="7" style="v" />¡Awt Qman Dyos ky'iwlanqe!</para>
  <para style="q">¡Kykyaqilxwitju' xjal twitz tx'otx' che q'on ninb'ilte! chiju' b'itzal.</para>
  <chapter number="68" style="c" />
  <para style="s1">Nnche kanb'an aj Israel</para>
  <para style="q">
    <verse number="1" style="v" />Ajtaq'wi Dyos q'ojil,</para>
  <para style="q">inche'x slamju' tajq'oj;</para>
  <para style="q">aye'ju' ntx'a'lti'j kyk'u'j ti'j inche kub' oq twitz;</para>
  <para style="q">
    <verse number="2" style="v" />inche kub'naj kse'n sib' toj kyq'iq',</para>
  <para style="q">inche kub' niwj kse'n ser toj q'aq';</para>
  <para style="q">¡tzpetni qe'kye' xjal b'inchal myab'a'n twitz Dyos!</para>
  <para style="q">
    <verse number="3" style="v" />Aye'tzu'n b'a'n xjal nche tzalaj;</para>
  <para style="q">ati nak'b'il kyetwitz Dyos,</para>
  <para style="q">¡inche xlik'pun tu'n kytzalajb'il!</para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" />Che b'itzan qe'kye' te Dyos,</para>
  <para style="q">kyb'itzanxe' b'itz toj tb'i;</para>
  <para style="q">kyajwalinktzju'ye' ati tib'aj muj.</para>
  <para style="b" />
  <para style="q">¡Che tzalajxe' ti'j Qman Dyos!</para>
  <para style="q">¡Che tzalajxe' twitz!</para>
  <para style="q">
    <verse number="5" style="v" />Ate Dyos najli toju' tja xjan,</para>
  <para style="q">Manb'aj kye meb'a</para>
  <para style="q">ex kolol kyi'ju' qya kyimni kychmil;</para>
  <para style="q">
    <verse number="6" style="v" />Intq'o'nte Dyos najb'il teju' xjal mixti' najb'il te,</para>
  <para style="q">inche ttzaqpi'nju' jpu'nqe' ex intq'o'n kytzalajb'il;</para>
  <para style="q">aye'tzu'n nche jaw meltz'uj kche najal toj tx'otx' min tq'o'n tawal.</para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" />Nman Dyos, tej nejlitoqa kywitzju' ttanama</para>
  <para style="q">intoq b'eta kyuk'i'l toj chq'ajlaj,</para>
  <para style="q">
    <verse number="8" style="v" />jaw lu'lunju' tx'otx',</para>
  <para style="q">tzaj chitj jb'al twitz kya'j,</para>
  <para style="q">exju' witz Sinayi jawlu'lun twitzju' Qman Dyos,</para>
  <para style="q">janche k'uluna' aj Israel.</para>
  <para style="q">
    <verse number="9" style="v" />Nman Dyos, nim jb'al tzaj tq'o'na</para>
  <para style="q">matxitoq kub' b'aju' ttanama, ex tzaj tq'o'na tipumal.</para>
  <para style="q">
    <verse number="10" style="v" />Atzu' ekyeja' najana' ttanama na'tz</para>
  <para style="q">atzunta Nman Dyos, noqx tu'n tk'u'jlalila,</para>
  <para style="q">xitq'o'na aju' nnojqelan kyeju' prow.</para>
  <para style="b" />
  <para style="q">
    <verse number="11" style="v" />Tzaj tq'o'n Qman Dyos jun tqanil;</para>
  <para style="q">nim qya intoq che pakb'ante:</para>
  <para style="q">
    <verse number="12" style="v" />¡Ljo'n kyb'ajx oqju' nimaqkawil kyuk'i'lju' kyxjal te q'oj! Chechij.</para>
  <para style="q">Aye'tzu'n qya eb'jo'kx toj kyja</para>
  <para style="q">b'aj kysipa'n ti'xti' b'je'l kyiq'i'n kyi'ju' ajq'oj kyxolilex,</para>
  <para style="q">
    <verse number="13" style="v" />aye'tzunkye' e'kyajtene' kyxol ch'laj,</para>
  <para style="q">¡kse'n kyxik' paloms ktxu'n kyi'j tu'n saqpwaq!</para>
  <para style="q">¡Exju' kytzmal ktxu'n kyi'j tu'n q'anpwaq tb'anil!</para>
  <para style="q">
    <verse number="14" style="v" />Tetzu'n kyb'aj oqju' nimaqkawil tu'n Dyos nimtipumal,</para>
  <para style="q">kub' saqche'w tib'aju' witz Salmon.</para>
  <para style="b" />
  <para style="q">
    <verse number="15" style="v" />¡Nim kyoklenju' witz B'asan</para>
  <para style="q">ex nimaq kywe'!</para>
  <para style="q">
    <verse number="16" style="v" />Aye'ye' txqantl tnam,</para>
  <para style="q">¿titiqu'n ntx'a'lti'j kyk'u'je' ajt-xikyka'yinju'ye' witz</para>
  <para style="q">ja oje tmaya' Dyos tu'n tnajan?</para>
  <para style="q">¡Ate Qman Dyos, knajal atzu' tejumajx!</para>
  <para style="b" />
  <para style="q">
    <verse number="17" style="v" />Ku'tz Qman Dyos twi' witz Sinayi ex ul toju' tja xjan;</para>
  <para style="q">kyoju' tkarwaj nimxi'xtoq txqan kyb'aj.</para>
  <para style="q">
    <verse number="18" style="v" />Nman Dyos, jawxa tzmax twi' witz ex eb'ajx tiq'i'nju'ya pres;</para>
  <para style="q">etk'ama chojb'il te tnam kyu'n xjal</para>
  <para style="q">expe' makyaq'kyib'ju' njaw kyiq'i'n kyib' ti'ja tuk'i'la, Nman Dyos.</para>
  <para style="b" />
  <para style="q">
    <verse number="19" style="v" />¡Nimanjtzxwit tb'i Qman Dyos ex klolqe,</para>
  <para style="q">ju' nqo toni'n atl junjun q'ij toj tkyaqilju' ti'xti'!</para>
  <para style="q">
    <verse number="20" style="v" />Ate Qman Dyos nkolon</para>
  <para style="q">ex inqo klet tu'n teju' kamik.</para>
  <para style="q">
    <verse number="21" style="v" />Ate Dyos kb'el pa'nte kywi' tajq'oj,</para>
  <para style="q">kywi'ju' mixti'x nkyaj kytzaqpi'nju' b'inchaj il.</para>
  <para style="b" />
  <para style="q">
    <verse number="22" style="v" />Oje tma Qman Dyos:</para>
  <para style="q">K'eletz wiq'i'ntla toju' tx'otx' B'asan;</para>
  <para style="q">ex toju' ninnjab' nim t-xe,</para>
  <para style="q">
    <verse number="23" style="v" />tu'n tb'aj twab'ena</para>
  <para style="q">kychk'elju' tajq'oja</para>
  <para style="q">ex tu'n txi' kyk'wa'nju' ttx'yana. Chi Dyos.</para>
  <para style="b" />
  <para style="q">
    <verse number="24" style="v" />Nman Dyos, nnimaqkawile',</para>
  <para style="q">q'ancha'lqe' xjal txoli'n kyel toju' tjaya xjan</para>
  <para style="q">inche ik'san ninb'il teya.</para>
  <para style="q">
    <verse number="25" style="v" />Nejliqe'ju' aj b'itzal</para>
  <para style="q">lepchqe'xtlju' aj chinb'al,</para>
  <para style="q">kyxoltzun ta'qe'ju qpoj</para>
  <para style="q">inche q'ajtzan tanb'orin.</para>
  <para style="q">
    <verse number="26" style="v" />¡Kynimanktze' Qman Dyos kykyaqile'!</para>
  <para style="q">¡Kyb'uyim kyib'e' aj Israel ex kyajwali'nktze'!</para>
  <para style="q">
    <verse number="27" style="v" />Nejli B'enjamin itz'inb'aj kywitz,</para>
  <para style="q">kyuk'i'l b'a'npun nejenel kye aj Juda,</para>
  <para style="q">aj Sab'ulon ex aj Neptali.</para>
  <para style="b" />
  <para style="q">
    <verse number="28" style="v" />Nman Dyos, yek'untza tipumala;</para>
  <para style="q">¡b'incham jumajtla t-xtalb'ila tb'inchaya qeye'!</para>
  <para style="q">
    <verse number="29" style="v" />Tzmax toju' tjaya xjan, toj Jerusalen,</para>
  <para style="q">janpona' kyiq'i'n nimaqkawil oyaj teya,</para>
  <para style="q">
    <verse number="30" style="v" />tzak'unqe'xju'ya aj Ejipt, naku'j txkupqe' toj ajlaj q'ajun,</para>
  <para style="q">aye' jun k'loj tman wakx tx'u'jqe' exqe' qpoj tman wakx</para>
  <para style="q">nkynima'kyib' tu'n kyq'inumal ex nche kub'kyme'sa'n tnam;</para>
  <para style="q">¡sputinqe'xju'ya xjal kyajb'il tu'n kyq'ojin!</para>
  <para style="q">
    <verse number="31" style="v" />Toj Ejipt kche tzajela' sanjelj;</para>
  <para style="q">kjawil kymujb'a'n aj Etyopiy kyq'ob' twitz Dyos.</para>
  <para style="q">
    <verse number="32" style="v" />¡Che b'itzan qe'ye' te Dyos kykyaqile' nche kawine' twitz tx'otx',</para>
  <para style="q">kyb'itzanxe' b'itz te Qman Dyos,</para>
  <para style="q">
    <verse number="33" style="v" />teju' nb'et toj kya'j,</para>
  <para style="q">toju' kya'j tejumajx!</para>
  <para style="q">Kyb'intze' se'ntaq'wi nq'ajtiju' tq'ojq'ojel twi',</para>
  <para style="q">aju' tq'ojq'ojel twi' nimtipumal.</para>
  <para style="q">
    <verse number="34" style="v" />Tz'elx kynik'e' ti'ju' tipumal Dyos:</para>
  <para style="q">aju' ati toklen tib'aj Israel,</para>
  <para style="q">npon kanun tipumal tzmax toj ẍkul kya'j.</para>
  <para style="q">
    <verse number="35" style="v" />Tb'anilxi'xte Dyos toju' tja xjan;</para>
  <para style="q">intzaj tq'o'n Qman Dyos toklen ex tipumalju' ttanam.</para>
  <para style="b" />
  <para style="q">¡Nimanjtzxwitju' Dyos! chiju' b'itzal.</para>
  <chapter number="69" style="c" />
  <para style="s1">Sich' toj k'ixk'oj</para>
  <para style="q">
    <verse number="1" style="v" />Chin tkloma, Nman Dyos,</para>
  <para style="q">qu'n naqxi'x ch'inxtl njaq'wiye' toj a';</para>
  <para style="q">
    <verse number="2" style="v" />kxi' nxi' mulq'aje' toj sob'on nim t-xe</para>
  <para style="q">ex mixjalojax tu'n nkub'a' we'ye'.</para>
  <para style="q">Matxi' chin ku'pune' t-xexi' a'</para>
  <para style="q">ex xi' nxi' iqane' tu'n tnimal a'.</para>
  <para style="q">
    <verse number="3" style="v" />Matxi' ku'x tzqij toj nqule' tu'n tpaj nchin ẍch'ine' nim;</para>
  <para style="q">in ch'yon toj nqule';</para>
  <para style="q">¡matxi' che siktiju' nwitze'</para>
  <para style="q">ayob'ente Qman Dyos!</para>
  <para style="q">
    <verse number="4" style="v" />Nimxi'x kyb'aju' nche el ik'unweye'</para>
  <para style="q">kyetwitzju' t-xya'mal nwi'ye', extzun mixti' wile';</para>
  <para style="q">matxi' che chmetju' wajq'oje,</para>
  <para style="q">aye'ju' naqx kyak'a'n nche okten yajlal weye'</para>
  <para style="q">ex inxi'x kyqani'n tu'n txi' wanjsa'n ti'ju'ye' mixti' sajwelq'a'ne'.</para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" />Nman Dyos, b'i'nxi'x tu'na, xnakqine' twitza;</para>
  <para style="q">lay b'ent wewanteju'ye' wile' twitza.</para>
  <para style="q">
    <verse number="6" style="v" />Taye, aya Dyos nimtipumal,</para>
  <para style="q">¡lalun tz'el kych'ixawju' q'uqlok kyk'u'j ti'ja</para>
  <para style="q">noqx tu'n npaje'!</para>
  <para style="q">aya Dyos nkyk'lu'n aj Israel,</para>
  <para style="q">¡lalun che kub'numju' nche jyon ti'ja</para>
  <para style="q">noqx tu'n npaje'!</para>
  <para style="q">
    <verse number="7" style="v" />Noqx tu'n nk'u'jlalile' ti'ja inchin yajtiye';</para>
  <para style="q">matxi' tz'elxi' nch'ixawe';</para>
  <para style="q">
    <verse number="8" style="v" />¡ikqinju'ye' kse'n jun xjal min ojtzqi'n twitz</para>
  <para style="q">kyeju' witz'ine' ex ntzike'!</para>
  <para style="b" />
  <para style="q">
    <verse number="9" style="v" />Xi' nkub' b'aje' tu'n xky'aqli'n ti'ju' tjaya;</para>
  <para style="q">machin ok ik'le'ne'</para>
  <para style="q">kyu'n nche ok ik'lenteya.</para>
  <para style="q">
    <verse number="10" style="v" />Ajnkub' oq'e' ex aj nmewayine', inche xmayin weye';</para>
  <para style="q">
    <verse number="11" style="v" />qa nnoknq'o'n wi'je' te b'is, tzeb'ajilqine' kye.</para>
  <para style="q">
    <verse number="12" style="v" />Noq oqinkxe' nchin kub' kyyoli'n xjal,</para>
  <para style="q">exqe' tx'ujtenil in b'je'l kyb'itz xmayb'il weye'.</para>
  <para style="b" />
  <para style="q">
    <verse number="13" style="v" />Ayintzunwe', Taye, inchin kub'sane' teya.</para>
  <para style="q">Nman Dyos, ¡chin toniya ja'lo!</para>
  <para style="q">Naq tu'n tk'u'jlalila nimxi'x, ¡chin ttzaq'wentza!</para>
  <para style="q">Noq tu'nju' t-o'nb'ila kukxju', ¡chin tkloma!</para>
  <para style="q">
    <verse number="14" style="v" />¡Lalun taja tu'n nxi' mulq'aje' toju' xoq'l!</para>
  <para style="q">¡Chin tkloma kyeju' nche el ik'unweye'</para>
  <para style="q">ex tu'n michinxa' mulq'aje' toju' a' nim t-xe!</para>
  <para style="q">
    <verse number="15" style="v" />¡Lalun taja tu'n nxi' iqane' tu'n tnimal a'!</para>
  <para style="q">¡Lalun taja tu'n nxitjk'u'ne'</para>
  <para style="q">ttolob' a' nim t-xe!</para>
  <para style="b" />
  <para style="q">
    <verse number="16" style="v" />Nman Dyos, chin ttzaq'wetza;</para>
  <para style="q">¡b'a'nata ex nim tk'u'jlalila!</para>
  <para style="q">Chin tka'yitza, qu'n nimta tlaqb'il tk'u'j;</para>
  <para style="q">
    <verse number="17" style="v" />¡Lalun tz'el tik'u'nju'ya tmajena lu!</para>
  <para style="q">¡Chin ttzaq'wetza lwiy, qu'n xob'ajilx atinqina'ye'!</para>
  <para style="q">
    <verse number="18" style="v" />Lq'etza nk'etze' ex chin tkloma;</para>
  <para style="q">¡chin tkloma kyeju' wajq'oje!</para>
  <para style="q">
    <verse number="19" style="v" />Ojtzqi'n tu'na jni'xju' matxi' chin ok ik'le'ne',</para>
  <para style="q">matxi'xi'x b'je'l nch'ixawe';</para>
  <para style="q">tojtzqi'nxi'xa alkyeqe' wajq'oje.</para>
  <para style="q">
    <verse number="20" style="v" />Matxi' k'ixb'i wanmiye' tu'nju' nchinok ik'le'ne';</para>
  <para style="q">¡mixti'tl wipumale'!</para>
  <para style="q">Manjoye' jun q'uqb'al nk'u'je',</para>
  <para style="q">ex jun tu'n ttzaj q'aq'an tk'u'j wi'je', ex mixti' sokyal.</para>
  <para style="q">
    <verse number="21" style="v" />Ku'x q'o'n b'i'yb'il toju' nwaye',</para>
  <para style="q">ex tej ttzaj k'waj wi'je' tzaj q'o'n b'inayr te nk'wa'ye'.</para>
  <para style="b" />
  <para style="q">
    <verse number="22" style="v" />¡Axwitju' kymes ex kywa nkukyq'o'n tu'n kytzalaj</para>
  <para style="q">jawb'ent te jun xpatxab' kye!</para>
  <para style="q">
    <verse number="23" style="v" />¡B'inchama tu'n kykyaj moẍix</para>
  <para style="q">ex tu'n kylu'lunju' kyqan kukxju'!</para>
  <para style="q">
    <verse number="24" style="v" />Tzaqpintzju'ya ttx'u'jila kyib'aj;</para>
  <para style="q">¡che b'ajxwit tu'n tq'oja ajtkb'u'l kanun!</para>
  <para style="q">
    <verse number="25" style="v" />Kyajxwitju' kynajb'il te chq'ajlaj,</para>
  <para style="q">ex mix-a'lo'xwit najan toju' kyja;</para>
  <para style="q">
    <verse number="26" style="v" />qu'n inkub' kyljo'n toj tq'iju' matxi' tzaj tb'is tu'na</para>
  <para style="q">ex inche xmayink ti'ju' b'ajni tk'ixb'sa'na.</para>
  <para style="q">
    <verse number="27" style="v" />Anjsanxju'ya taq'wix kye, tu'nju' taq'wix nkyb'incha'n;</para>
  <para style="q">¡ex tu'n lalun kyk'amju' najsb'il kyil!</para>
  <para style="q">
    <verse number="28" style="v" />¡Najsanku'xju'ya kyb'i toju' u'j te chwinqlal!</para>
  <para style="b" />
  <para style="q">¡Lalun ku'x tq'o'na kyb'i jatku'xa' kyb'iju' tnik'alkyi'j!</para>
  <para style="q">
    <verse number="29" style="v" />Ayintzunwe', yab'qine' ex nchin b'isune',</para>
  <para style="q">chin twab'aktza, Nman Dyos ex chin tkloma.</para>
  <para style="b" />
  <para style="q">
    <verse number="30" style="v" />Kjawil wajwali'ne' tb'i Dyos kyu'n b'itz</para>
  <para style="q">kwajwali'ye' tuk'i'l aq'b'il chjonte,</para>
  <para style="q">
    <verse number="31" style="v" />Ex kjel tzalajxi'x Qman Dyos ti'j</para>
  <para style="q">kyetwitzju' chojb'il tman wakx</para>
  <para style="q">mujqa jun qpoj wakx kyuk'i'l tuk'a ex t-xky'eq</para>
  <para style="q">
    <verse number="32" style="v" />Kche tzalajelju' nche b'isun aj txi' ka'yi'n ja'lu</para>
  <para style="q">ex kkuwixel kyanmiju' nche jyon ti'j Dyos;</para>
  <para style="q">
    <verse number="33" style="v" />ina' che tzaj tb'i'nte Dyos prow</para>
  <para style="q">ex min nche eltik'o'n jpu'nqe' ju' teqe'.</para>
  <para style="b" />
  <para style="q">
    <verse number="34" style="v" />¡Kyajwalinktze' Qman Dyos kya'j, tx'otx' ex ninnjab',</para>
  <para style="q">ex kykyaqile' nche anq'ine' kyoj!</para>
  <para style="q">
    <verse number="35-36" style="v" />Ate Qman Dyos kklolte Syon</para>
  <para style="q">ex che jawil tb'incha'n jumajtlu' nimaqtnam toj Juda.</para>
  <para style="q">Kkyetza' kyk'wal kymajinju' nintnam;</para>
  <para style="q">atzu' che najala' ex kytzyu' kytx'otx';</para>
  <para style="q">¡aye' nkyk'u'jla'n tb'i Dyos che najal toj! Chiju' b'itzal.</para>
  <chapter number="70" style="c" />
  <para style="s1">Lwix kuttzaja onilweye'</para>
  <para style="r">(<ref loc="PSA 40:13-17">Sal 40.13-17</ref>)</para>
  <para style="q">
    <verse number="1" style="v" />Nman Dyos, ¡kuttzaja klol weye'!</para>
  <para style="q">Taye, ¡lwix kuttzaja onilweye'!</para>
  <para style="q">
    <verse number="2" style="v" />¡Tz'elxwit kych'ixawju' xjal</para>
  <para style="q">kyajb'il tu'n nkub' kyb'yo'ne'!</para>
  <para style="q">¡Che kub'xwit oqju' kyajb'il tu'n nb'o'lje' kyu'n</para>
  <para style="q">tu'n kych'ixaw!</para>
  <para style="q">
    <verse number="3" style="v" />¡Che kub'xwit oqju' nche xmayin wi'je'</para>
  <para style="q">tu'n kych'ixaw!</para>
  <para style="q">
    <verse number="4" style="v" />Kykyaqilxwitju' nche jyon ti'ja</para>
  <para style="q">tenxwit ktzalajb'il;</para>
  <para style="q">kymaxwitju' kyajb'ilju' tkolb'ila</para>
  <para style="q">ikjalu: ¡Ate Dyos nim toklen!</para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" />Atzunwe', prowqine' ex nchin b'isune',</para>
  <para style="q">Nman Dyos, ¡lwix kuttzaja onilweye'!</para>
  <para style="q">Ateju'ya nnonin weye' ex nklonweye';</para>
  <para style="q">¡lwix kuttzaja, Nman Dyos! chiju' b'itzal.</para>
  <chapter number="71" style="c" />
  <para style="s1">Tna'j Dyos jun tijwnaq</para>
  <para style="q">
    <verse number="1" style="v" />Nman Dyos, tuk'i'la njyo'na'ye' kolb'ilweye';</para>
  <para style="q">¡lalun chin kyej tkolb'e'na!</para>
  <para style="q">
    <verse number="2" style="v" />¡Chin tkloma ex chin ttzaqpima,</para>
  <para style="q">tnik'alna'tati'j!</para>
  <para style="q">B'incham xtalb'ila chin tb'itza, ex chin tkloma.</para>
  <para style="q">
    <verse number="3" style="v" />Tz'okxwita jun pik kolb'ilweye',</para>
  <para style="q">¡tz'okxwita te jun nin ja te kolb'ilweye'!</para>
  <para style="q">¡Ateju'ya wipumale' ex pik e'wb'il wib'e'!</para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" />Nman Dyos,</para>
  <para style="q">chin tkloma toj tq'ob'ju' b'inchal myab'a'n,</para>
  <para style="q">toj tq'ob'ju' b'yol wnaq ex teju' tx'u'j twi',</para>
  <para style="q">
    <verse number="5" style="v" />Taye, ateju'ya q'uqb'ab'l nk'u'je'</para>
  <para style="q">atxi'x kuxunqintoqe' q'uqlok nk'u'je' ti'ja.</para>
  <para style="q">
    <verse number="6" style="v" />Iqa'nxtoq nwi'ye' tu'n ntxuye'</para>
  <para style="q">intoq okqe nk'u'je' ti'ja.</para>
  <para style="q">¡Initz'je' tu'na!</para>
  <para style="q">¡Kchin b'itzale' kukxju' teya!</para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" />Majx nchin jaw lab'ti xjal weye',</para>
  <para style="q">atzunta kolb'ilweye'.</para>
  <para style="q">
    <verse number="8" style="v" />Nim txqan nyole' te ajwalb'ilteya</para>
  <para style="q">inb'aj q'ij tu'n nyoline' kyi'j</para>
  <para style="q">
    <verse number="9" style="v" />lalun chin nel tik'u'na aj ntijine';</para>
  <para style="q">lalun chin kyej ttzaqpi'na ajtb'aj wipumale'.</para>
  <para style="q">
    <verse number="10" style="v" />Kyajb'ilju' wajq'oje tu'n nkub' kyb'yo'ne',</para>
  <para style="q">inkyb'u'yi'n kyib' ex in b'ajb'ent ti'j kxim wi'je'.</para>
  <para style="q">
    <verse number="11" style="v" />Ex inkyma'n: ¡Che lpexe' ti'j ex kytzyunku'ye',</para>
  <para style="q">qu'n matxi' kyej kolb'e'n tu'n Dyos</para>
  <para style="q">ex mix-a'lo' kklolte! Chechij.</para>
  <para style="b" />
  <para style="q">
    <verse number="12" style="v" />Lalun tz'el tpa'ntib'a wi'je', Nman Dyos;</para>
  <para style="q">¡Lwix kuttzaja klol weye'!</para>
  <para style="q">
    <verse number="13" style="v" />¡Tz'elxwit kych'ixawju' wi'je'</para>
  <para style="q">ex che kub'xwit naj!</para>
  <para style="q">¡Tz'elxwit kych'ixaw</para>
  <para style="q">ju' kyajb'il tu'n nkub' yajtiye'!</para>
  <para style="q">
    <verse number="14" style="v" />Ayintzuwe' chin ayole' ti'ja kukxju',</para>
  <para style="q">ex kjawil nnima'nxi'xtla;</para>
  <para style="q">
    <verse number="15" style="v" />kb'ajel q'ij wu'ne' kxe'l nchik'b'a'ne' kye xjal</para>
  <para style="q">qama qo' tkola ex matb'inchaya tnik'alilti'j qeye'.</para>
  <para style="q">¡Layx kane te'lu toj nwitze'!</para>
  <para style="q">
    <verse number="16" style="v" />Nman Dyos, kxe'l ntx'olb'a'nju'ye' tb'inchb'ena tb'anilxi'x;</para>
  <para style="q">¡kxe'l npakb'a'ne' qa o'kxta tz'aqli!</para>
  <para style="b" />
  <para style="q">
    <verse number="17" style="v" />Nman Dyos,</para>
  <para style="q">aya tzaj xnaq'tzan weye' atxi'x toj ju' nku'xumale',</para>
  <para style="q">ex inx che'x npakb'a'ne' tb'inchb'ena tb'anilqexi'x.</para>
  <para style="q">
    <verse number="18" style="v" />Nman Dyos lalun chin kyej tkolb'i'na</para>
  <para style="q">maskye matxi' chin tijine' ex saqtl nwi'ye',</para>
  <para style="q">na'mxna' nb'aj yolinwe' ti'ju' tipumala</para>
  <para style="q">kyeju' xjal ate' ja'lo ex kyeju' che ul yajxi'tel.</para>
  <para style="b" />
  <para style="q">
    <verse number="19" style="v" />Nimxi'x toklenju' tkawb'ila tnik'alti'j Nman Dyos;</para>
  <para style="q">nim ti'xti' matxi' che tb'inchaya;</para>
  <para style="q">¡mix-a'lo' juntl kse'n aya!</para>
  <para style="q">
    <verse number="20" style="v" />Maskyepe' matxi' tb'inchaya tu'n nlonteye'</para>
  <para style="q">txqan yajb'il ex b'is,</para>
  <para style="q">ktzajel tq'o'n jumajtlju'ya nchwinqlale';</para>
  <para style="q">kchin jawitz tiq'i'na tzmax t-xexi' tx'otx',</para>
  <para style="q">
    <verse number="21" style="v" />ktzajel tq'o'na woklene' nimxi'x</para>
  <para style="q">ex ktzajel tq'uqb'a'n jumajtla nk'u'je'.</para>
  <para style="b" />
  <para style="q">
    <verse number="22" style="v" />Ayintzunwe', tu'nju' toklena nim,</para>
  <para style="q">kchin b'itzale' teya ex kjawil nnimsa'na</para>
  <para style="q">tuk'i'l chnab' arpa ex tzintzin,</para>
  <para style="q">Nman Dyos, aya Xjan Kydyos aj Israel.</para>
  <para style="q">
    <verse number="23" style="v" />Okxi'x chin tzalaje'le' ajnb'itzane' teya,</para>
  <para style="q">ex tu'n tkyaqil nk'u'je', tu'n oje chin tkola.</para>
  <para style="q">
    <verse number="24" style="v" />Ex tkyaqil kmuj kxe'l ntx'olb'a'ne' qa tnik'alti'ja,</para>
  <para style="q">matxi' tz'el kych'ixawju'</para>
  <para style="q">kyajb'iltoq tu'n nkub' yajtiye', chiju' b'itzal.</para>
  <chapter number="72" style="c" />
  <para style="s1">Na'j Dyos ti'ju' nimaqkawil</para>
  <para style="q">
    <verse number="1" style="v" />Nman Dyos, onintzju'ya nimaqkawil,</para>
  <para style="q">tu'n tb'ent tkawin kse'nta, ex tojxi'x tnik'alti'j,</para>
  <para style="b" />
  <para style="q">
    <verse number="2" style="v" />tu'ntzun tkawin toj tu'me'l ex toj tnik'alilti'j</para>
  <para style="q">tib'aju' ttanama ex kyib'aju' prow.</para>
  <para style="q">
    <verse number="3" style="v" />Tzajxwit kyiq'i'n nimaq k'ul exqe' witz</para>
  <para style="q">nak'b'il ex tnik'alilti'j teju' tnam.</para>
  <para style="q">
    <verse number="4" style="v" />¡Kawinxwitju' nimaqkawil toj tnik'alilti'j kyib'aj prow!</para>
  <para style="q">¡Che tkolxwit kyk'walju' ati nnojqelan kye</para>
  <para style="q">ex che kub'xwit tnajsa'nju' ate'k yajulkye xjal!</para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" />¡Tenxwit tchiylala teju' nimaqkawil kukxju';</para>
  <para style="q">atixku'ju' q'ij ex xjaw!</para>
  <para style="q">
    <verse number="6" style="v" />¡Tz'okxwit kse'n jb'al ex ẍmu's</para>
  <para style="q">intak'sa'nju' tx'otx' ex k'ul!</para>
  <para style="q">
    <verse number="7" style="v" />¡Tenxixtlwit nak'b'il ex tnik'alilti'j</para>
  <para style="q">toju' tq'ijlalil tkawb'il,</para>
  <para style="q">atixku'ju' xjaw!</para>
  <para style="q">
    <verse number="8" style="v" />¡Kawinxwit tib'aj tkyaqil twitz tx'otx',</para>
  <para style="q">tzyet-x ttzi nin a' Ewprates tu'n tpon tzmax mankb'il ttxa'n tx'otx'!</para>
  <para style="b" />
  <para style="q">
    <verse number="9" style="v" />¡Kyaq'xwit kyib'ju' tajq'oj najlqe' toj chq'ajlaj tuk'i'l,</para>
  <para style="q">ex tu'n tkub' kyme'ssa'nkyib' twitz!</para>
  <para style="q">
    <verse number="10" style="v" />¡Tzajxwit iq'i'n oyaj ex chojb'il kawb'il te</para>
  <para style="q">kyu'n nimaqkawil toj Tarsis ex kyoju' tnej tx'otx' toj ninnjab'.</para>
  <para style="q">ex kyu'n nimaqkawil toj Sab'a ex toj Seb'a!</para>
  <para style="q">
    <verse number="11" style="v" />¡Che kub'xwit meje kykyaqilju' nimaqkawil twitz!</para>
  <para style="q">¡Che ajb'enxwit kykyaqilju' nimaqtnam te!</para>
  <para style="q">
    <verse number="12" style="v" />Qu'n ate kklolteju' prow inkub'san</para>
  <para style="q">exju' ati nnojqelan te ex mix-a'lo' onilte.</para>
  <para style="q">
    <verse number="13" style="v" />Ktzajel q'aq'an tk'u'j kyi'ju' me'sqe'</para>
  <para style="q">ex che tkla'ju' prow.</para>
  <para style="q">
    <verse number="14" style="v" />Kche tkla' toju' jitz'jtib'il ex toj b'yojxjali'n,</para>
  <para style="q">qu'n nim toklenju' kychwinqlal te.</para>
  <para style="b" />
  <para style="q">
    <verse number="15" style="v" />¡Tz'anq'inxwitju' nimaqkawil!</para>
  <para style="q">¡Txi'wt q'o'nju' q'anpwaq toj Sab'a te!</para>
  <para style="q">¡Kukxwit tok kub'sb'ilju' ti'j twitz Dyos!</para>
  <para style="q">¡Tzajxwit ky'i'wla'n kukxju'!</para>
  <para style="q">
    <verse number="16" style="v" />¡Tenxwit nim triy toju' tx'otx'</para>
  <para style="q">ex chmet-xwit kywi'witz!</para>
  <para style="q">¡Witzanxwit kse'n tze Lib'ano</para>
  <para style="q">ex tenxwit txqan kyspiyil kse'n k'ul toj kojb'il!</para>
  <para style="q">
    <verse number="17" style="v" />¡Tenxwit tb'iju' nimaqkawil tejumajx;</para>
  <para style="q">tenxwitju' ninb'ilte kse'n q'ij!</para>
  <para style="q">¡Kykyaqilxwitju' nimaqtnam twitz tx'otx'</para>
  <para style="q">che k'monte ky'i'wb'il noqx tu'nel!</para>
  <para style="q">¡Kykyaqilxwitju' nimaqtnam che q'mante, tzalajb'ilxta!</para>
  <para style="b" />
  <para style="q">
    <verse number="18" style="v" />Nimanjtzxwitju' Qman Dyos, kydyos aj Israel,</para>
  <para style="q">o'kxte nb'inchankye ti'xti' tb'anilqexi'x;</para>
  <para style="q">
    <verse number="19" style="v" />Nimanjtzxwitju' tb'i tb'anilxi'x tejumajx.</para>
  <para style="q">¡Tkyaqilxwit twitz tx'otx' kub' noj tu'n tajwalil!</para>
  <para style="q">¡Ikxwitju'! Chiju' b'itzal.</para>
  <para style="b" />
  <para style="q">
    <verse number="20" style="v" />Atzu' nb'aja' tna'j Dyos Dab'i, tk'wal Jese, tzalu.</para>
  <chapter number="73" style="c" />
  <para style="ms">Toxi'n U'j</para>
  <para style="mr">(E' b'itz <ref loc="PSA 73-89">73—89</ref>)</para>
  <para style="s1">T-xtalb'il Dyos</para>
  <para style="q">
    <verse number="1" style="v" />¡Majx b'a'nte' Dyos tuk'i'l Israel,</para>
  <para style="q">kyuk'i'lju' ẍtilun kyanmi!</para>
  <para style="q">
    <verse number="2" style="v" />Noq ch'intlmi ẍin kub'a' tz'aqe';</para>
  <para style="q">qu'n e'jawtoq jilpuju' nqane'.</para>
  <para style="q">
    <verse number="3" style="v" />Qu'n matzaj tx'a'lti'j nk'u'je' tej xxinka'yine' nche b'jawb'ent</para>
  <para style="q">ju' b'inchal myab'a'n ex inkynima'n kyib'.</para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" />Minti' nche ximankye' lu qa kche kyimel,</para>
  <para style="q">qu'n b'a'nqe' toj kyxmilal;</para>
  <para style="q">
    <verse number="5" style="v" />na'mx tik' twitzlalil kyu'n, ti'ju' yajb'il ati twitz tx'otx'</para>
  <para style="q">ex na'mx kyajti kse'nqe' txqantl xjal.</para>
  <para style="q">
    <verse number="6" style="v" />Qu'mtzun a kyachb'ilju' nimjtib'il</para>
  <para style="q">ex majx ati kytx'u'jil naku'j kyxb'alun;</para>
  <para style="q">
    <verse number="7" style="v" />matxi' b'je'tz kywitz,</para>
  <para style="q">nimxi'xju' myab'a'n nkub' kyxima'n.</para>
  <para style="q">
    <verse number="8" style="v" />Tuk'i'l xmayb'il, nimjtib'il ex taq'wix yol,</para>
  <para style="q">nche xob'tzana' tu'n kyb'inchan myab'a'n ex b'yojxjali'n,</para>
  <para style="q">
    <verse number="9" style="v" />inche xon kyol ti'j Dyos te toj kya'j</para>
  <para style="q">in elpunxju' kyol toj tkyaqil twitz tx'otx'.</para>
  <para style="b" />
  <para style="q">
    <verse number="10" style="v" />Qu'mtzun nche jaw nima'n kyu'n xjal</para>
  <para style="q">ex min nnel kynik' ti'ju' taq'wixil nkyb'incha'n.</para>
  <para style="q">
    <verse number="11" style="v" />Inkyma'n: ¿Ma oktzun ktb'i' Dyos?</para>
  <para style="q">¿Ma ktzunlo tzajel tka'yi'n Dyos tzmax toj kya'j? Chechij.</para>
  <para style="q">
    <verse number="12" style="v" />¡Kyka'yinqe'xpe'ye' b'inchal myab'a'n!</para>
  <para style="q">Min nche yajti ex in chmet kyq'inumal.</para>
  <para style="q">
    <verse number="13" style="v" />¡Naqx wak'a'we' nb'aj nẍtilsa'n wanmiye'</para>
  <para style="q">ex nche b'aj ntxjo'ne' nq'ob'e' te tkyaqil il!</para>
  <para style="q">
    <verse number="14" style="v" />Naqx k'ixk'oj ink'mo'ne' tkyaqil kmuj,</para>
  <para style="q">intz'e'ysanjtz nwitze' atl junjun prim.</para>
  <para style="b" />
  <para style="q">
    <verse number="15" style="v" />Naqwit machin ximane' kse'nkye,</para>
  <para style="q">matxi'wtlo che kub'nsb'u'ne' tk'wala.</para>
  <para style="q">
    <verse number="16" style="v" />Matz'oktilil wu'ne' tu'n tel nnik'e' ti'j ja'lu,</para>
  <para style="q">ex ch'uẍxi'x sela' weye'.</para>
  <para style="q">
    <verse number="17" style="v" />Tzmaxi'j ẍin nokxe' toj tja Dyos xjan</para>
  <para style="q">xkanetzuntz toj nwitze' ja che web'ela'kye' lu:</para>
  <para style="q">
    <verse number="18" style="v" />Matxi' che kub' tq'o'na toju' b'e ẍb'ilun</para>
  <para style="q">ex inche'x tlmo'na toj yajb'il.</para>
  <para style="q">
    <verse number="19" style="v" />¡Toj jun kmujx che kjel xitu'n!</para>
  <para style="q">¡Kche b'ajel tu'n kxob'el!</para>
  <para style="q">
    <verse number="20" style="v" />Ajtzun tjaw tiq'i'ntib'a Nman Dyos,</para>
  <para style="q">kse'n ajttzaj tna'tib' jun xjal toj watl,</para>
  <para style="q">k'elil tik'u'nju'ya che ka'yin.</para>
  <para style="b" />
  <para style="q">
    <verse number="21" style="v" />Machin tenwe' toj nim yajb'il</para>
  <para style="q">ex atitoq k'ixk'oj toj wanmiye',</para>
  <para style="q">
    <verse number="22" style="v" />qu'n xnak qintoqe' mixtoqti'x noktojnwi'ye';</para>
  <para style="q">¡ikqintoqju'ye' kse'n jun chej twitza!</para>
  <para style="q">
    <verse number="23" style="v" />Tu'npetzunju', antine' tuk'i'la kukxju'.</para>
  <para style="q">Machin jawtiq'i'na tuk'i'l nb'a'nq'ob'e',</para>
  <para style="q">
    <verse number="24" style="v" />matxi' chin tzajt-ẍaqlu'na kyu'nju' tnab'la</para>
  <para style="q">te b'ajsb'iltzun kchin tk'ma'ya kyuk'i'l oklenj.</para>
  <para style="q">
    <verse number="25" style="v" />¿Alkyetzun juntl ati toj kya'j? ¡O'kx aya!</para>
  <para style="q">Ajntene' tuk'i'la mixti'tl wajb'ile' te twitz tx'otx'.</para>
  <para style="q">
    <verse number="26" style="v" />Xi' nkub' b'ajwe',</para>
  <para style="q">atzunte Dyos wetzb'ile' tejumajx</para>
  <para style="q">ex a tzyulte wanmiye'.</para>
  <para style="b" />
  <para style="q">
    <verse number="27" style="v" />Che kyimelju' inel kypa'n kyib' ti'ja;</para>
  <para style="q">kb'el t-xitu'na xjal minti' nnokslan teya.</para>
  <para style="q">
    <verse number="28" style="v" />Ayintzunwe' chin kxe'l lq'eye' tk'etz Dyos,</para>
  <para style="q">qu'n a b'a'nju' weye'.</para>
  <para style="q">Aya, Nman Dyos, kolb'ilweye',</para>
  <para style="q">ex kxe'l npakb'a'ne' tkyaqilju' tb'inchb'ena. Chiju' b'itzal.</para>
  <chapter number="74" style="c" />
  <para style="s1">Na'j Dyos qanb'il tzaqpib'lteju' tnam</para>
  <para style="q">
    <verse number="1" style="v" />Nman Dyos,</para>
  <para style="q">¿Titiqu'n xqokyej tkolb'e'na tejumajx?</para>
  <para style="q">¿Titiqu'n saja' ttx'u'jila</para>
  <para style="q">kyi'ju' rit toj tch'laja?</para>
  <para style="q">
    <verse number="2" style="v" />Na'ntzju'ya ttanama,</para>
  <para style="q">ju' jawni t-sk'o'na ojtxi',</para>
  <para style="q">ex klet tu'na tu'n tok te ttanama;</para>
  <para style="q">na'ntzju'ya witz Syon, ja matxi' najana'ya.</para>
  <para style="q">
    <verse number="3" style="v" />Kutzaja ka'yilteju' tnam majx kub'ni xitu'n;</para>
  <para style="q">¡oktenju' ajq'oj xitulte tkyaqilju' tjaya xjan!</para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" />Inche b'itzanju' tajq'oja tu'n ẍekanb'an ti'ju' tjaya xjan;</para>
  <para style="q">¡matxi' kub' kyq'o'n kyb'ander te juntl tnam</para>
  <para style="q">
    <verse number="5" style="v" />tib'aju' ttzija, janche okxa' xjal!</para>
  <para style="q">Naku'j si'wilqe' kyxol tze toj k'ul q'ajin,</para>
  <para style="q">
    <verse number="6" style="v" />eb'jo'kten pa'lkye tilb'ilal toj tjaya</para>
  <para style="q">tu'n k'uxb'il te si'wb'il ex tu'n pojb'il</para>
  <para style="q">
    <verse number="7" style="v" />Okkyq'o'n tq'aq'alju' tjaya xjan;</para>
  <para style="q">¡naku'j mixti'x toklen,</para>
  <para style="q">kub' kytx'u'yi'n twitz tx'otx'!</para>
  <para style="q">
    <verse number="8" style="v" />Kyma tu'n qkub' kyxitu'ne' qkyaqile';</para>
  <para style="q">¡eb'jo'kten xitulkyeju' ja te k'u'lb'il toj tnam</para>
  <para style="q">ja nqb'u'yi'natoq qib'e' tu'n qk'ulune' teya!</para>
  <para style="q">
    <verse number="9" style="v" />Mixti' nche qka'yintlju'ye' techlal xjan;</para>
  <para style="q">mixti' juntl t-sanjela xkyej,</para>
  <para style="q">expe' min b'i'n qu'ne' jtoj we' ttxa'njalu.</para>
  <para style="b" />
  <para style="q">
    <verse number="10" style="v" />Nman Dyos,</para>
  <para style="q">¿ma kukxtzun kyajun ajq'oju' qi'je'?</para>
  <para style="q">¿Ma kukxtzun tu'n kyolil taq'wixju' ti'ja?</para>
  <para style="q">
    <verse number="11" style="v" />¿Tiqu'n nxa' tewa'nju'ya tipumal tq'ob'a?</para>
  <para style="q">¿Tiqu'n nkyeja' tchle'n tq'ob'a ttzitk'u'ja?</para>
  <para style="q">
    <verse number="12" style="v" />Atxi'x ojtxi' aya nninaqkawile'.</para>
  <para style="b" />
  <para style="q">Nimxi' kanb'ab'l matxi' kub'ti'n tu'na, Nman Dyos</para>
  <para style="q">tza'lu twitz tx'otx':</para>
  <para style="q">
    <verse number="13" style="v" />kub' taq'pu'nju'ya ninnjab' tu'n tipumala,</para>
  <para style="q">kub' tpa'na kywi'ju' nimaqtxkup toj ninnjab',</para>
  <para style="q">
    <verse number="14" style="v" />b'ajkub' tpch'u'na twi'ju' nin txkup Leb'yatan</para>
  <para style="b" />
  <para style="q">ex xitq'o'na te kychi' txkup toj chq'ajlaj.</para>
  <para style="q">
    <verse number="15" style="v" />Eb'jatz poq'chaj a' ex eb'et nin a' tu'na,</para>
  <para style="q">ex e'kub' ttzqijsa'nju'ya nin a' min nche kub' tzqij.</para>
  <para style="q">
    <verse number="16" style="v" />Te teya q'ij exju' qonik'an;</para>
  <para style="q">aya b'inchante xjaw exju' q'ij;</para>
  <para style="q">
    <verse number="17" style="v" />aya kyej q'onte techelju' b'ajsb'il ttxa'n tx'otx';</para>
  <para style="q">kyej tnk'u'na q'ijal tuk'i'lju' jb'alil.</para>
  <para style="b" />
  <para style="q">
    <verse number="18" style="v" />Na'nku'ya Nman Dyos, nnok ik'le'na tu'n ajq'oj,</para>
  <para style="q">exqe' xjal mixti' kynab'l nche yolin taq'wix ti'ja.</para>
  <para style="q">
    <verse number="19" style="v" />¡Lalun tzik'xi'x qna'le' tu'na!</para>
  <para style="q">Mixti'x qipumale' kse'nqe' paloms b'o's kyyajil;</para>
  <para style="q">¡lalun qo'x tq'o'na kyeju' tojk'ul txkup!</para>
  <para style="q">
    <verse number="20" style="v" />¡Na'ntzju'ya tyola kyej b'entti'j tu'na,</para>
  <para style="q">qu'n nojniju' tnam tu'n taq'wixil</para>
  <para style="q">expe' toj tkyaqil twitz tx'otx'!</para>
  <para style="q">
    <verse number="21" style="v" />Lalun taja tu'n tkub' me'sa'nju' xjal nyajunjtz;</para>
  <para style="q">¡b'inchama tu'n tjaw nima'na tu'n prow ex tu'n me's!</para>
  <para style="b" />
  <para style="q">
    <verse number="22" style="v" />¡Iq'i'nktz tib'a Nman Dyos! ¡B'inchama tkawb'ila!</para>
  <para style="q">¡Na'ntza nche oktenju' xnak q'ol ttx'u'jila kukxju'!</para>
  <para style="q">
    <verse number="23" style="v" />Lalun tzik'tna'l tq'ojq'ojel kywi' tajq'oja tu'na,</para>
  <para style="q">ex inxi'x che ẍch'inju' min nche okslan teya. Chiju' b'itzal.</para>
  <chapter number="75" style="c" />
  <para style="s1">A Dyos ajkawil</para>
  <para style="q">
    <verse number="1" style="v" />Nxiqq'o'ne' chjonte teya Nman Dyos,</para>
  <para style="q">nxiqq'o'n chjonteye' teya;</para>
  <para style="q">ntzaj qna'ne' tb'iya ex nxiqb'itza'ne' tb'inchb'ena tb'anilqexi'x.</para>
  <para style="q">
    <verse number="2" style="v" />A ntma'n Qman Dyos ja'lu:</para>
  <para style="q">Ajtpon tq'ijlalil tu'n kyb'jaw nsk'o'ne',</para>
  <para style="q">che okyil toj xjel wu'ne' tojxi'x tu'me'l.</para>
  <para style="q">
    <verse number="3" style="v" />Aj tlu'lunju' tx'otx' kyuk'i'lxi' najlqe' twitz,</para>
  <para style="q">ayinweju'ye' tzyulte tq'uqlil b'a'nxi'x. Chi Dyos.</para>
  <para style="q">
    <verse number="4" style="v" />Inxi'nma'ne' kyeju' nimalkyib' ex b'inchal myab'a'n:</para>
  <para style="q">Lalun jaw kynima'n kyib'e';</para>
  <para style="q">
    <verse number="5" style="v" />lalun kyla'jikyib'e' qa ati kyipumale'</para>
  <para style="q">ex lalun noq tz'el kylanu'n kyole'. Nchije' kye.</para>
  <para style="b" />
  <para style="q">
    <verse number="6" style="v" />Qu'n myatzu' ntzaja'te' xjel qe</para>
  <para style="q">toj tjawetzq'ij mo toj tkub'exq'ij,</para>
  <para style="q">ex mya toj chq'ajlaj mo kywi'witz,</para>
  <para style="q">
    <verse number="7" style="v" />ana'te Dyos Ajkawil:</para>
  <para style="q">junjun nche kub'tme'ssa'n atzun junjuntl nche b'jaw tlaq'b'a'n.</para>
  <para style="q">
    <verse number="8" style="v" />Tzyu'n tk'wab'l Qman Dyos,</para>
  <para style="q">smo'n twitz ex tx'amjsa'n, aju' tk'ayil ttx'u'jil.</para>
  <para style="q">Ajtzun ttzaj tqo'nju' b'in lu,</para>
  <para style="q">kykyaqilju' b'inchal myab'a'n twitz tx'otx'</para>
  <para style="q">tik'x kb'ajel kyk'wa'n.</para>
  <para style="b" />
  <para style="q">
    <verse number="9" style="v" />Kxe'l npakb'a'ne' Qman Dyos ja k'uluna' Jakob' kukxju'</para>
  <para style="q">ex chin b'itzale' ajwalb'ilte;</para>
  <para style="q">
    <verse number="10" style="v" />qu'n kb'el t-xitu'n kyninb'ilkyib'ju' b'inchal myab'a'n,</para>
  <para style="q">atzu'n xjal tnik'alti'j kxe'l tq'o'nxi'xtl tipumal, chiju' b'itzal.</para>
  <chapter number="76" style="c" />
  <para style="s1">Tkyaqil nkub'ti'j tu'n Dyos</para>
  <para style="q">
    <verse number="1" style="v" />Ojtzqi'nte Dyos kyu'n aj Juda;</para>
  <para style="q">b'i'nxi'xte' tb'i kyu'n kykyaqil aj Israel.</para>
  <para style="q">
    <verse number="2" style="v" />Tkub'ju' tja twi' witz Syon,</para>
  <para style="q">toj Jerusalen;</para>
  <para style="q">
    <verse number="3" style="v" />Atzuntzu' ekub'a' ttoqi'na' q'ojb'il:</para>
  <para style="q">e'kolb'il, e'k'uẍtx'e'nb'il, e' smaj kyuk'i'l tal.</para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" />¡Nman Dyos, tb'anilxi'xta!</para>
  <para style="q">¡Nimxi'xta toklen kyekywitzju' witz te kanb'ab'l!</para>
  <para style="q">
    <verse number="5" style="v" />Aye'ju' min nche xob' b'je'l iq'i'n ti'xti' kye;</para>
  <para style="q">mixti'xte b'ent kyu'nju' kuwqe';</para>
  <para style="q">¡noq eb'jik'ktan!</para>
  <para style="q">
    <verse number="6" style="v" />Mixpe'ti'x b'ent kyyukchanteju' karwaj ex b'a'nchej</para>
  <para style="q">tej kyxi' t-xob'sa'na Dyos, ju' k'lunjtza tu'n Jakob'.</para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" />¡Xob'le'nxi'xta twitz, Dyos!</para>
  <para style="q">¿Alxi'xkye kb'entel twe' twitza</para>
  <para style="q">ajttzaj ttx'u'jila?</para>
  <para style="q">
    <verse number="8" style="v" />Ntzaj tq'o'na xjel tzmax toj kya'j;</para>
  <para style="q">nxob'ju' tx'otx' ex nkub' nak'e twitza,</para>
  <para style="q">
    <verse number="9" style="v" />Nman Dyos,</para>
  <para style="q">aj tb'inchanteju'ya tnik'alti'j</para>
  <para style="q">tu'n kykletju' nche yajti twitz tx'otx'.</para>
  <para style="b" />
  <para style="q">
    <verse number="10" style="v" />Kmiltz'ujel kytx'u'jilju' xjal te ajwalb'ilteya;</para>
  <para style="q">¡naqpena' ch'i'n kytx'u'jil k'okyil te tkorona toj twi'ya!</para>
  <para style="q">
    <verse number="11" style="v" />Che kytziyanx kyole' te Qman Dyos,</para>
  <para style="q">ex che japunx kyu'ne'.</para>
  <para style="q">Aye'ye' txolchiqe'ye' ti'ju' ati t-xob'il kyi'je',</para>
  <para style="q">¡Kyiq'intz oyaje' te!</para>
  <para style="q">
    <verse number="12" style="v" />Ana'te in elq'inte kychwinqlalju' nche kawin</para>
  <para style="q">ex ati tchi kyi'ju' nimaqkawil twitz tx'otx'. Chiju' b'itzal.</para>
  <chapter number="77" style="c" />
  <para style="s1">Xinb'e'tz kyib'aju' tb'inchb'aj Qman Dyos</para>
  <para style="q">
    <verse number="1" style="v" />Injaw tq'ojq'ojel nwi'ye' te Dyos</para>
  <para style="q">tu'n ntzaj tb'i'ne'.</para>
  <para style="q">
    <verse number="2" style="v" />In njyo'ne' Qman Dyos toju' q'ij qa nchin b'isune',</para>
  <para style="q">ex min nchin q'jene' tu'n tjaw nmujb'a'n nq'ob'e'</para>
  <para style="q">toj na'j Dyos te qonik'an.</para>
  <para style="q">Min nknet jatu'n toka'qe nk'u'je'.</para>
  <para style="q">
    <verse number="3" style="v" />Ajttzaj nna'ne' Dyos, inchin noq'e';</para>
  <para style="q">inchin kub' tene' ximal ex nchin kub' numje'.</para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" />Layx chin wtane' Nman Dyos qa min ẍintzaj ttzaq'we'na;</para>
  <para style="q">¡mixti'x nb'entl nyoline' tu'n txqan b'is wi'je'!</para>
  <para style="q">
    <verse number="5" style="v" />Inchin ximane' kyi'ju' q'ij exqe' ab'q'i ojtxi';</para>
  <para style="q">
    <verse number="6" style="v" />na'n wu'ne' intoq chin b'itzane' te qonik'an.</para>
  <para style="q">Inchin xjelune' ex nchin ximane' toj wanmiye' tib'aj:</para>
  <para style="q">
    <verse number="7" style="v" />¿Ma kukxtzunlo ttx'u'jin Qman Dyosju'?</para>
  <para style="q">¿Ma laytzunlo qotk'u'jla jumajtl?</para>
  <para style="q">
    <verse number="8" style="v" />¿Mamatxi'tzunlo b'aju' tk'u'jlalil?</para>
  <para style="q">¿Ma majxtzunlo oje kyajb'aju' tyol tziya'n tu'n?</para>
  <para style="q">
    <verse number="9" style="v" />¿Ma matxi' tzik'tna'lju' t-xtalb'il Dyos tu'n?</para>
  <para style="q">¿Mamajxtzun matzaj ttx'u'jil, tu'n min nlaqltk'u'j qi'j?</para>
  <para style="q">
    <verse number="10" style="v" />Axi'xwe' nch'yon we ajtkub' nxima'ne'</para>
  <para style="q">¿min nqo toni'ntl Qman Dyos kse'n tnejel?</para>
  <para style="q">
    <verse number="11" style="v" />Che tzajel nna'nju'ye' tb'inchb'en Dyos</para>
  <para style="q">tb'anilqexi'x ẍeb'aj tb'incha'n ojtxi';</para>
  <para style="q">
    <verse number="12" style="v" />kchin ximale' ti'j tkyaqilju' taq'un oje tb'incha.</para>
  <para style="b" />
  <para style="q">
    <verse number="13" style="v" />Nman Dyos, xjanta toj tkyaqilju' tb'inchb'ena;</para>
  <para style="q">¿alxi'xkye juntl dyos nim toklen kse'n aya?</para>
  <para style="q">
    <verse number="14" style="v" />¡Ateju'ya Dyos nb'inchankye tb'anil b'a'nq'ob'aj!</para>
  <para style="q">¡xityek'u'na tipumala kyeju' nimaqtnam!</para>
  <para style="q">
    <verse number="15" style="v" />E' tkolju'ya ttanama tu'n tipumala,</para>
  <para style="q">aye' tk'wal Jakob' ex tk'wal Jse.</para>
  <para style="b" />
  <para style="q">
    <verse number="16" style="v" />Nman Dyos,</para>
  <para style="q">tzaj xob'il ti'ju' ninnjab' tej txi' ka'yi'na tu'n,</para>
  <para style="q">ex ku'pun tyukchi tzmaxtzu' t-xexi';</para>
  <para style="q">
    <verse number="17" style="v" />tzaj nim jb'al kyu'nju' muj,</para>
  <para style="q">ojexi'x tinun twitz kya'j tu'n q'ankyaq</para>
  <para style="q">toj tkyaqil twitz tx'otx'.</para>
  <para style="q">
    <verse number="18" style="v" />B'injtzu' tq'ojq'ojela ntinun toj saqchanpach;</para>
  <para style="q">tkyaqil twitz tx'otx' kub' spik'e' tu'n xloq'lokya'j</para>
  <para style="q">ex b'aj yukchiju' tx'otx' tu'n kyejnajnab'.</para>
  <para style="q">
    <verse number="19" style="v" />Jqet b'e tu'na toj ninnjab';</para>
  <para style="q">ik'xa kyoj txqan a',</para>
  <para style="q">ex mix-a'lo'xte ka'yinteju' tqanb'ena.</para>
  <para style="q">
    <verse number="20" style="v" />Eb'ajx t-ẍaqlu'nju'ya ttanama kse'n txqan rit,</para>
  <para style="q">kyu'nel Moyses ex Aaron. Chiju' b'itzal.</para>
  <chapter number="78" style="c" />
  <para style="s1">Tb'inchb'aj Dyos b'a'n kyeju' ttanam</para>
  <para style="q">
    <verse number="1" style="v" />Ntanam, b'intzju'ya nxnaq'tzb'ile';</para>
  <para style="q">¡b'inku'ya kxe'l nma'ne' teya!</para>
  <para style="q">
    <verse number="2" style="v" />Chin yolile' toj techlal;</para>
  <para style="q">kyi'ju' ti'xti' e'wa'nqe' ttzajlenx ojtxi'.</para>
  <para style="q">
    <verse number="3" style="v" />Aju' oje qb'i ex ojtzqi'n qu'n</para>
  <para style="q">aju' kyej q'ma'n qe kyu'n qman,</para>
  <para style="q">
    <verse number="4" style="v" />lalun che kub'qewa'n kywitz qk'wal.</para>
  <para style="q">Qajwali'nktz Qman Dyos kyuk'i'lju' che itz'jel yajxi'tl</para>
  <para style="q">ex qajwali'nktz tu'nju' tipumal ex tb'inchb'en te lab'te'nqe'.</para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" />kub' tq'o'n Qman Dyos jun kawb'il te Jakob';</para>
  <para style="q">kub' tq'o'n jun nuk'b'il tu'n kyoklpe aj Israel ti'j,</para>
  <para style="q">ex tchaq' kyeju' ojtxi' qyajilb'en tu'n t-xikyek'u'n kye kyyajajil che ul yajxi'tel,</para>
  <para style="q">
    <verse number="6" style="v" />tu'ntzun kyojtzqinteju' kyyajajil che b'ju'l yajxi'tel,</para>
  <para style="q">e'kyk'wal che ul itz'ji,</para>
  <para style="q">tu'n txi' kyxnaq'tza'ntl kye kyk'wal;</para>
  <para style="q">
    <verse number="7" style="v" />tu'ntzun tokqe kyk'u'j ti'j Dyos</para>
  <para style="q">ex tu'n lalun tzik'tna'lju' b'aj tb'incha'n kyu'n;</para>
  <para style="q">tu'n kyxi'kynima'n tchaq'b'il</para>
  <para style="q">
    <verse number="8" style="v" />ex tu'n lalun che ok kse'nqe' ojtxi' kychman,</para>
  <para style="q">eb'jaw miltz'uj ex xnakqe',</para>
  <para style="q">min qe kyk'u'j toj kyanmi;</para>
  <para style="q">¡min xjapun kyol twitz Dyos!</para>
  <para style="b" />
  <para style="q">
    <verse number="9" style="v" />Aye' tyajajil Eprayin,</para>
  <para style="q">b'entnitoq kyten tu'n kyq'ojin tu'n smaj,</para>
  <para style="q">eb'ajkub' oq toju' q'ij tej tokju' q'oj;</para>
  <para style="q">
    <verse number="10" style="v" />Min xikynima'n kyol b'entniti'j tuk'i'l Dyos</para>
  <para style="q">ex min kyaj tu'n txi' kyb'i'n t-xnaq'tzb'il.</para>
  <para style="q">
    <verse number="11" style="v" />Ik'tna'lju' tb'incha Dyos kyu'n,</para>
  <para style="q">aye' b'a'nq'ob'aj tb'incha Dyos kywitz.</para>
  <para style="q">
    <verse number="12" style="v" />E'tb'incha Dyos b'a'nq'ob'aj kywitzju' kyman</para>
  <para style="q">toju' tx'otx' Soan, toj Ejipt:</para>
  <para style="q">
    <verse number="13" style="v" />kub' taq'pu'n ninnjab' toj kab'e', ex eb'jik'x tiq'i'n toj,</para>
  <para style="q">kyej tenju' a' naku'j tapi tu'n.</para>
  <para style="q">
    <verse number="14" style="v" />Nejlitoq kywitz toj jun tnej muj te q'ijtl,</para>
  <para style="q">atzu'n qonik'an tu'n t-spik'umal jun tnej q'aq'.</para>
  <para style="q">
    <verse number="15" style="v" />E'tjaqju' pik toj chq'ajlaj,</para>
  <para style="q">ex nim a' etz kyoj te kyk'wa' tu'n.</para>
  <para style="q">
    <verse number="16" style="v" />¡Tb'incha Dyos tu'n tetz chitj nim a' toj pik</para>
  <para style="q">exb'et kse'n jun nin a'!</para>
  <para style="b" />
  <para style="q">
    <verse number="17" style="v" />Aye'tzunkye kukxtoq kyb'inchan ilju';</para>
  <para style="q">jawkyiq'i'nkyib' ti'j Dyos te jawnixi' toj chq'ajlaj.</para>
  <para style="q">
    <verse number="18" style="v" />Oktoq kyq'o'n Dyos toj joyb'ilti'j</para>
  <para style="q">xikyqani'n kywa kse'nxtoqu' kyajb'il.</para>
  <para style="q">
    <verse number="19" style="v" />Eb'aj yolin ti'j ex kyma:</para>
  <para style="q">¿Ma oktzun kb'entel tkub' tq'o'n Dyos qwa toj chq'ajlaj?</para>
  <para style="q">
    <verse number="20" style="v" />Axte' tjaqte Dyos pik;</para>
  <para style="q">ex nim a' etzchitj toj</para>
  <para style="q">kub' qojli twitz tx'otx', kse'n jun nin a';</para>
  <para style="q">atzu'n ja'lu, ¿ma jaku'tzun b'ent ttzaj tq'o'n Dyos wab'j?</para>
  <para style="q">¿ma jaku' b'ent ttzaj tq'o'n kychi'ju' ttanam? Chechij.</para>
  <para style="b" />
  <para style="q">
    <verse number="21" style="v" />Tetzunj tb'inte Dyos ja'lu, tzaj ttx'u'jil;</para>
  <para style="q">¡ojexi'x jaw ja'yon ti'j Jakob',</para>
  <para style="q">kse'n jun q'aq'!</para>
  <para style="q">
    <verse number="22" style="v" />Qu'n min okqe kyk'u'j ti'j Dyos</para>
  <para style="q">ex min kyokslaju' kolb'ilkye.</para>
  <para style="q">
    <verse number="23" style="v" />Tu'npetzunju', tzaj tchq'o'n Dyos muj</para>
  <para style="q">ex tjaqju' kya'j;</para>
  <para style="q">
    <verse number="24" style="v" />¡tzaj tchitu'n mana tib'aju' ttanam,</para>
  <para style="q">aju' triy te toj kya'j, tu'n kywan ti'j!</para>
  <para style="q">
    <verse number="25" style="v" />¡E'wanju' xjal ti'j kywa anjl!</para>
  <para style="b" />
  <para style="q">¡Nim kywa tzaj tq'o'n Dyos!</para>
  <para style="q">
    <verse number="26" style="v" />Tzaj jub'inju' kyq'iq' twitz kya'j</para>
  <para style="q">toj tjawetzq'ij ex toj tnayajkya'j;</para>
  <para style="q">¡tu'n tipumal Dyos!</para>
  <para style="q">
    <verse number="27" style="v" />Tzaj tchitu'n kychi'ju' ttanam;</para>
  <para style="q">¡e'tzaj chitj pich' twitz kya'j kse'n tz'awun ttzi ninnjab'!</para>
  <para style="q">
    <verse number="28" style="v" />E'kub' tchitu'n Dyos toju' xmuj</para>
  <para style="q">ex kyi'jileju' kypach xb'alun.</para>
  <para style="q">
    <verse number="29" style="v" />Eb'aj wantzuntz tzmax kyb'ajnoj b'a'nxi'x,</para>
  <para style="q">iktzun tb'incha Dyosju' kye kse'nxtoqu' kyajb'il.</para>
  <para style="q">
    <verse number="30" style="v" />Na'mxtoqpe' tqe kyk'u'j tu'n kywan,</para>
  <para style="q">atixtoqju' kywa toj kytzi,</para>
  <para style="q">
    <verse number="31" style="v" />tej tzaj ttx'u'jil Dyos kyib'aj</para>
  <para style="q">Eb'ajkub' tb'yo'nju' ichan nim kyipumal.</para>
  <para style="q">¡E'kub'tb'yo'nju' ichan atixi'x kynab'l tij Israel!</para>
  <para style="b" />
  <para style="q">
    <verse number="32" style="v" />Tu'npetzu'n tkyaqil ja'lu, eb'inchantl il twitz Dyos;</para>
  <para style="q">mixti'x kyokslaju' tb'inchb'en Dyos te lab'te'n.</para>
  <para style="q">
    <verse number="33" style="v" />Qu'mtzun eltiq'i'n Dyos kychwinqlal</para>
  <para style="q">naku'j jun jiq'cha'nqe'</para>
  <para style="q">ex e'kub' tq'o'n toj yajb'il xob'ajilx.</para>
  <para style="q">
    <verse number="34" style="v" />Qa nche b'yonjtz tu'n Dyos, nche jyontzuntz ti'j;</para>
  <para style="q">inok qe kyk'u'j ti'j, ex inxi'x che jyon ti'j;</para>
  <para style="q">
    <verse number="35" style="v" />inultzuntz toj kyk'u'j qa a Dyos te toj kya'j</para>
  <para style="q">intoq xq'uqinkye ex in klonkye.</para>
  <para style="q">
    <verse number="36" style="v" />Tb'anilxi'xpetzun che yolin</para>
  <para style="q">extzun naq chajyolil nb'je'tz toj ktzi,</para>
  <para style="q">
    <verse number="37" style="v" />najchaqtoq ta' kyanmi ti'j Dyos</para>
  <para style="q">ex min nkb'incha'n kse'nxju' yol kyejni b'entti'j.</para>
  <para style="b" />
  <para style="q">
    <verse number="38" style="v" />Atzunte Dyos nimxi'x tk'u'jlalil,</para>
  <para style="q">kub' tnajsa'n kyil myab'a'n ex min e'kub' t-xitu'n;</para>
  <para style="q">b'a'npumaj tjuk' ttx'u'jil</para>
  <para style="q">ex min xitq'o'n anb'il teju' tq'oj.</para>
  <para style="q">
    <verse number="39" style="v" />Tzaj tna'n Dyos qa naq xjalqe';</para>
  <para style="q">qa ikyqe' kse'n kyq'iq' inik' jumj ex min in anjtztlti'j.</para>
  <para style="b" />
  <para style="q">
    <verse number="40" style="v" />¡Jte' majlo min nche b'in te Dyos</para>
  <para style="q">ex okkyq'o'n ttx'u'jil toj chq'ajlaj!</para>
  <para style="q">
    <verse number="41" style="v" />Ex intoq okkyq'o'ntl toj joyb'ilti'j;</para>
  <para style="q">¡intoq okkyq'o'n tb'is Dyos xjan tib'aj Israel!</para>
  <para style="q">
    <verse number="42" style="v" />Min tzaj kyna'nju' q'ij</para>
  <para style="q">tej kyklet tu'n Dyos tu'n tkyaqil ipumalj, kyeju' kyajq'oj;</para>
  <para style="q">
    <verse number="43" style="v" />tej tb'inchante nimaq ti'xti' te lab'te'n</para>
  <para style="q">kyoj kojb'il Soan, toj Ejipt;</para>
  <para style="q">
    <verse number="44" style="v" />tej kyjaw b'entju' nin a' tu'n te chik',</para>
  <para style="q">ex min b'ent txi' kyk'wa'n aj Ejipt.</para>
  <para style="q">
    <verse number="45" style="v" />E'tzaj tq'o'n xtx'o ex ta'jinchej kyib'aj,</para>
  <para style="q">b'aj kyaju'n tkyaqil ex kub' kyxitu'n;</para>
  <para style="q">
    <verse number="46" style="v" />xitq'o'n twitz kyawal matxi'toq b'aj kyaq'una'n</para>
  <para style="q">kye ẍt'ikt'u'l tu'n tb'aj kywan.</para>
  <para style="q">
    <verse number="47" style="v" />B'ajkub' t-xitu'n tqan kylob'aj iw ex kyawal</para>
  <para style="q">tu'n saqb'aqun ex txun che'w.</para>
  <para style="q">
    <verse number="48" style="v" />Eb'aj kyimju' kywakyix ex kyrit</para>
  <para style="q">tu'n saqb'aqun tuk'i'l q'ankyaq.</para>
  <para style="q">
    <verse number="49" style="v" />Tzaj tq'o'n Qman Dyos ttx'u'jil kyib'aj:</para>
  <para style="q">tx'u'jilj, k'ixk'oj ex yajb'il,</para>
  <para style="q">sanjelalqe' te kamik.</para>
  <para style="q">
    <verse number="50" style="v" />¡Tzaj ttx'u'jil b'a'nxi'x!</para>
  <para style="q">Mix kub'a' tnajsa'n kyil,</para>
  <para style="q">tzajpe' tq'o'n kamik kyib'aj;</para>
  <para style="q">
    <verse number="51" style="v" />¡tb'incha tu'n kyb'ajkyimju' tnejel k'wa'lb'aj</para>
  <para style="q">kye kykyaqil aj Ejipt tojx kytanam!</para>
  <para style="b" />
  <para style="q">
    <verse number="52" style="v" />Eb'je'tz tiq'i'n aj Israel kse'n jun k'loj rit;</para>
  <para style="q">xitiq'i'nju' ttanam toj chq'ajlaj.</para>
  <para style="q">
    <verse number="53" style="v" />Xq'uqi'nqe' b'a'nxi'x tu'n tej kyb'je'tz tiq'i'n</para>
  <para style="q">tu'n lalun tzaj xob'il kyi'j,</para>
  <para style="q">aye'tzu'n kyajq'oj eb'ajkyaj muqli tjaq' ninnjab'.</para>
  <para style="q">
    <verse number="54" style="v" />Tzaj tiq'i'n Dyos ttanam toju' tx'otx' xjan,</para>
  <para style="q">¡kywi'witz eb'aj kanb'et tu'nku'!</para>
  <para style="q">
    <verse number="55" style="v" />Eb'je'l tiq'i'n xjal witzleb'ilqe' kywitzju' aj Israel;</para>
  <para style="q">ex b'ajx t-sipa'n tx'otx' kyxolju' kyyajajil,</para>
  <para style="q">ex e'kub' najan tu'n kyoju' kypach xb'alun.</para>
  <para style="b" />
  <para style="q">
    <verse number="56" style="v" />Aye'tzunkye okkyq'o'n Dyos te toj kya'j toj joyb'ilti'j</para>
  <para style="q">jawkyi'nkyib' ti'j</para>
  <para style="q">ex min exi' kynima'nju' tchaq'b'il;</para>
  <para style="q">
    <verse number="57" style="v" />qu'n ikqe'xju' kse'nqe' kyman,</para>
  <para style="q">kyej kykolb'e'n Dyos ex min e'okslan te;</para>
  <para style="q">¡eb'ajkub' ch'okyix toj kyb'e naku'j jun tze ch'okti'j!</para>
  <para style="q">
    <verse number="58" style="v" />Okkyq'o'n ttx'u'jil Dyos tu'n kyq'olb'eb'l te witzileb';</para>
  <para style="q">eb'aj k'ulun kywitz ex jaw xky'aqlin kyi'j.</para>
  <para style="q">
    <verse number="59" style="v" />Tzaj ttx'u'jil Dyos tej tka'yinte ja'lu,</para>
  <para style="q">ex majx eb'je'l t-suchu'n aj Israel,</para>
  <para style="q">
    <verse number="60" style="v" />ex kyej tkolb'i'n ja xjan toj Silo,</para>
  <para style="q">ju' tjatoq kyxolju' xjal.</para>
  <para style="q">
    <verse number="61" style="v" />Taq' anb'il kyeju' tajq'oj tu'n t-xikyiq'i'n</para>
  <para style="q">techlal tajwalil ex toklen.</para>
  <para style="q">
    <verse number="62" style="v" />Ojexi'x tx'u'jin kyi'ju' ttanam,</para>
  <para style="q">eb'ajx tq'o'n te twa kyk'uẍtx'e'nb'ilju' kyajq'oj.</para>
  <para style="q">
    <verse number="63" style="v" />Eb'ajkyimju' ku'xun toj q'aq';</para>
  <para style="q">¡mixti'x ok tzalajb'il te mjeb'le'n kyi'ju' qpoj!</para>
  <para style="q">
    <verse number="64" style="v" />Ex eb'aj kyimju' pale tu'n k'uẍtx'e'nb'il,</para>
  <para style="q">ex min e'oq'ju' kyxu'jil kyi'j.</para>
  <para style="b" />
  <para style="q">
    <verse number="65" style="v" />O'kx ttzaj tna'nttib' Qman Dyos naku'j intoq wtan,</para>
  <para style="q">naku'j jun xjal te q'oj inel q'e'n toj twi',</para>
  <para style="q">
    <verse number="66" style="v" />ex kub'kyi'ju' tajq'oj, ex eb'ajkub' oq tu'n;</para>
  <para style="q">¡el kych'ixaw tejumajx!</para>
  <para style="q">
    <verse number="67" style="v" />Expe' eb'je'l tik'u'n toj tja Jse,</para>
  <para style="q">ex min e'jaw t-sk'o'n tyajajil Eprayin;</para>
  <para style="q">
    <verse number="68" style="v" />eye'kye' tyajajil Juda eb'jaw t-sk'o'n</para>
  <para style="q">extzu'n witz Syon k'u'jla'n tu'n.</para>
  <para style="q">
    <verse number="69" style="v" />Jawtb'incha'n jun ja xjan, nimin twe' kse'n kya'j,</para>
  <para style="q">ex tkuwsa tu'n tten tejumajx kse'n tx'otx'.</para>
  <para style="q">
    <verse number="70" style="v" />Jaw t-sk'o'n Dab'i ju' tmajen</para>
  <para style="q">aju' k'ik'leltoq rit;</para>
  <para style="q">
    <verse number="71" style="v" />eltiq'i'n ti'ju' k'ik'lej rit,</para>
  <para style="q">tu'n t-xq'uqinteju' ttanam,</para>
  <para style="q">tu'n tok k'ik'lel kyi'ju' aj Israel.</para>
  <para style="q">
    <verse number="72" style="v" />Ex e't-xq'uqi Dab'i ttanam Dyos;</para>
  <para style="q">e't-xq'uqi ex eb'ajx t-ẍaqlu'n</para>
  <para style="q">tuk'i'l nab'l ex tuk'i'l tkyaqil tk'u'j. Chiju' b'itzal.</para>
  <chapter number="79" style="c" />
  <para style="s1">K'ixk'oj tej tkub' xitu'n Jerusalen</para>
  <para style="q">
    <verse number="1" style="v" />¡Nman Dyos,</para>
  <para style="q">matxi' b'aj kyetza'n xjal ttx'otx'a, ju' nche niman kye txqantl dyos!</para>
  <para style="q">¡Matxi' b'aj kyxmayi'n tjaya xjan</para>
  <para style="q">ex matxi' b'aj kyxitu'n tnam Jerusalen!</para>
  <para style="q">
    <verse number="2" style="v" />¡Matxi' che b'aj kub' kyb'yo'n tmajina tnik'alkyi'j,</para>
  <para style="q">ex matxi' che b'ajkyej kyq'o'n</para>
  <para style="q">te kychi' k'utz ex kychi' tojk'ul txkup!</para>
  <para style="q">
    <verse number="3" style="v" />Makub' qojli kychk'el naku'j a'</para>
  <para style="q">toj tkyaqil Jerusalen,</para>
  <para style="q">ex mix-a'lo' te' tu'n tku'x muqunkye.</para>
  <para style="q">
    <verse number="4" style="v" />Matxi' qo okye' te kyxmayb'il qb'esine';</para>
  <para style="q">ex te kytzeb'lju' xjal ate' qi'jileye'.</para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" />Nman Dyos,</para>
  <para style="q">¿ma tejumajxtzun ju' ttx'u'jila?</para>
  <para style="q">¿Ma oktzun k'entil kukxju' qi'je' kse'n q'aq'?</para>
  <para style="q">
    <verse number="6" style="v" />¡Tzaqpinxa ttx'u'jila kyib'aj kykawb'ilju' nimal kye txqantl dyos</para>
  <para style="q">ju' min ojtzqi'na kyu'n ex min nche kub'san twitza!</para>
  <para style="q">
    <verse number="7" style="v" />Qu'n eb'jo'kten walkye tk'wal Jakob'</para>
  <para style="q">ex naq tik'lentl kyejten kyu'n.</para>
  <para style="q">
    <verse number="8" style="v" />Lalun tb'inchaya tu'n qchjonteju'ye'</para>
  <para style="q">il kyb'inchaju' ojtxi' qchmane';</para>
  <para style="q">¡tzajxwitju' tk'u'jlalila lwiy k'lulqeye',</para>
  <para style="q">qu'n matxi' qokub'aje'!</para>
  <para style="b" />
  <para style="q">
    <verse number="9" style="v" />Nman Dyos, aya klol qeye',</para>
  <para style="q">¡qotoniya, qo tkloma ex najsanku'ya qile',</para>
  <para style="q">tu'n tnimetju' tb'iya!</para>
  <para style="q">
    <verse number="10" style="v" />Mixti' tu'n kymantekye' nche niman kye txqantl dyos:</para>
  <para style="q">¿Jatzunta' Kydyos? Chechiwt.</para>
  <para style="q">¡Q'ontza anb'il tu'n qlonteye' tu'me'l t-xel kyeju' ẍekub' b'yonkye tmajena!</para>
  <para style="q">¡Ex tu'n kyb'inteju' xjal nche niman kye txqantl dyos!</para>
  <para style="q">
    <verse number="11" style="v" />B'intza tq'ojq'ojel kywi'ju' jpu'nqe',</para>
  <para style="q">ex klonqe'mju'ya b'entni ti'j tu'n kykyim</para>
  <para style="q">tu'n tipumala.</para>
  <para style="b" />
  <para style="q">
    <verse number="12" style="v" />Nman Dyos,</para>
  <para style="q">q'onka wuq maj tu'me'l t-xel kyeju' qb'esine'</para>
  <para style="q">tu'nju' myab'a'n matxi' kyb'incha teya;</para>
  <para style="q">
    <verse number="13" style="v" />ayo'tzunqe' ottanamqo'ya,</para>
  <para style="q">ex t-ritqo'ya toj tch'laja,</para>
  <para style="q">qo q'ol chjonteye' teya kukxju',</para>
  <para style="q">¡qo b'itzale' te ninb'ilteya toj tkyaqil tab'q'iyil! Chiju' b'itzal.</para>
  <chapter number="80" style="c" />
  <para style="s1">Q'aq'antz tk'u'ja qi'je'</para>
  <para style="q">
    <verse number="1" style="v" />Aya k'ik'lel kye aj Israel,</para>
  <para style="q">in t-ẍaqlu'na tyajajil Jse kse'n jun k'loj rit,</para>
  <para style="q">ati tq'uqb'ila kyib'aju' kyerb'in,</para>
  <para style="q">¡qo' tb'itza!</para>
  <para style="q">¡Q'aq'antz tk'u'ja kyi'ju' kyyajajil Eprayin,</para>
  <para style="q">
    <verse number="2" style="v" />B'enjamin ex Manases!</para>
  <para style="q">¡Na'ntztib'a ex kuttzaja klol qeye' tuk'i'l tipumala!</para>
  <para style="b" />
  <para style="q">
    <verse number="3" style="v" />Nman Dyos,</para>
  <para style="q">¡Anjsama qi'je' tu'n qokye' kse'n tnejel!</para>
  <para style="q">¡Qo' tka'yitza tuk'i'l tk'u'jlalila tu'ntzun qklete'!</para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" />Nman Dyos, nimtipumala,</para>
  <para style="q">¿jtoj q'jenju' ttx'u'jila</para>
  <para style="q">tu'n ttzaj tb'i'na tna'j Dyos ttanama?</para>
  <para style="q">
    <verse number="5" style="v" />Matxi' tzaj tq'o'na b'is te t-xel qwaye';</para>
  <para style="q">ex ta'l qwitze' te t-xel qk'wa'ye'.</para>
  <para style="q">
    <verse number="6" style="v" />Matxi' qo oktq'o'na te kyxmayb'ilju' qb'esine',</para>
  <para style="q">ex inche tze'nju' qajq'oje' qi'je'.</para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" />Nman Dyos nimtipumala,</para>
  <para style="q">¡Anjsama qi'je' tu'n qokye' kse'n tnejel!</para>
  <para style="q">¡Qo' tka'yitza tuk'i'l tk'u'jlalila tu'ntzun qklete'!</para>
  <para style="b" />
  <para style="q">
    <verse number="8" style="v" />Etz ti'na junwi' lob'j ub'a toj Ejipt;</para>
  <para style="q">eb'je'x t-xla'ja'na xjal nche niman kye txqantl dyos toj kytx'otx', tu'n kypon tq'o'na toj.</para>
  <para style="q">
    <verse number="9" style="v" />B'aj t-ẍtilsa'nju'ya tx'otx' te,</para>
  <para style="q">atzu'n junwi' lob'j lok'an ex noj twitz tx'otx' tu'n.</para>
  <para style="q">
    <verse number="10" style="v" />B'aj tktxu'n k'ul tu'n tewun,</para>
  <para style="q">exqe' nimaq tze eb'aj ktxet kyu'n tq'ob'.</para>
  <para style="q">
    <verse number="11" style="v" />Eb'ajx lik'j tzmax tib'aj ninnjab',</para>
  <para style="q">exqe' t-xul e'pon kanun tzmax toju' nin a' Ewprates.</para>
  <para style="q">
    <verse number="12" style="v" />¿Titiqu'n xkub'a' t-xitu'nju'ya tapi ti'jile,</para>
  <para style="q">naq tu'n kyel t'uxi'n twitz ub'a kyu'n xjal nche b'et toj b'e?</para>
  <para style="q">
    <verse number="13" style="v" />Tokju' tb'och k'ul yajulte;</para>
  <para style="q">¡nche oktenju' tojk'ul txkup walte!</para>
  <para style="b" />
  <para style="q">
    <verse number="14" style="v" />B'inchama xtalb'il, Dyos nimtipumala, kutanjtz ti'ja;</para>
  <para style="q">ka'yintza b'a'nxi'x tzmax toj kya'j</para>
  <para style="q">ex q'aq'antz tk'u'ja ti'ju' wi' lob'j lu,</para>
  <para style="q">
    <verse number="15" style="v" />ti'ju' tqan lob'j aku'ya ku'x awante,</para>
  <para style="q">ti'ju' t-xul aku'ya kyej q'onte.</para>
  <para style="q">
    <verse number="16" style="v" />Tu'n ttx'u'jila</para>
  <para style="q">xitu'nqe'ku'ya ate'k tx'emulte ex tz'e'ysalte;</para>
  <para style="q">
    <verse number="17" style="v" />atzu'n ichan xjaw t-sk'o'na onima,</para>
  <para style="q">ju' t-xul ichan aku'ya kyej q'onte,</para>
  <para style="q">
    <verse number="18" style="v" />ex lay tz'el qpa'ntl qib'e' ti'ja.</para>
  <para style="q">¡Q'ontza qchwinqlale', ex o'kxtzu' qo kub'sala'qe' twitza!</para>
  <para style="b" />
  <para style="q">
    <verse number="19" style="v" />Nman Dyos nimtipumala,</para>
  <para style="q">¡Anjsama qi'je' tu'n qokjumajltle' kse'n tnejel!</para>
  <para style="q">¡Q'aq'antz tk'u'ja qi'je' tu'ntzun qklete'! Chiju' b'itzal.</para>
  <chapter number="81" style="c" />
  <para style="s1">T-xtalb'il Dyos ex kyb'inchb'aj aj Israel myab'a'n</para>
  <para style="q">
    <verse number="1" style="v" />¡Che b'itzan qe'ye' te Dyos tuk'i'l tzalajb'il, qu'n ate qipumal!</para>
  <para style="q">¡Kyajwalinktze' Dyos ja ajb'ena' Jakob' tuk'i'l sich' te tzalajb'il!</para>
  <para style="q">
    <verse number="2" style="v" />Che b'itzan qe'ye' tuk'i'l tq'ojq'ojil tanb'orin,</para>
  <para style="q">tuk'i'l chnab' arpa ex tzintzin.</para>
  <para style="q">
    <verse number="3" style="v" />Che chinb'anqe'ye' ti'j chun aj tka'yin xjaw,</para>
  <para style="q">ex aj t-xk'o'mix xjaw,</para>
  <para style="q">qu'n a ninq'iju' qe.</para>
  <para style="q">
    <verse number="4" style="v" />Qu'n a chaq'b'ilju'</para>
  <para style="q">tzaj tq'o'n Dyos kye aj Israel ja k'uluna' Jakob';</para>
  <para style="q">
    <verse number="5" style="v" />a chaq'b'ilju' tzaj q'o'n te Jse</para>
  <para style="q">tej tetz Dyos ti'j Ejipt.</para>
  <para style="q">Xinb'i'ne' jun tq'ojq'ojel wi'yj min ojtzqi'n wu'ne':</para>
  <para style="q">
    <verse number="6" style="v" />Matxi' tz'el wiq'i'ne' iqtz ti'j tqula,</para>
  <para style="q">matxi' nkolpiya toju' aq'untl kuw.</para>
  <para style="q">
    <verse number="7" style="v" />Inttxoka toju' yajb'il ex makleta wu'ne';</para>
  <para style="q">tzaj ntzaq'we'na tzmaxtzu' toj muj in julin;</para>
  <para style="q">kub' nq'o'na toj joyb'ilti'ja ttzi a' Merib'a.</para>
  <para style="q">
    <verse number="8" style="v" />B'intzju'ya kxel woqxena'ne' teya ntanam;</para>
  <para style="q">¡noqwit ikj chinx tb'i'na, aya Israel!</para>
  <para style="q">
    <verse number="9" style="v" />Lalun che kub' tq'o'n tdyosa te junxi'tl tnamqe';</para>
  <para style="q">ex lalun k'uluna kye junxi'tl dyos.</para>
  <para style="q">
    <verse number="10" style="v" />Ayinwe' Dyos Manb'aj,</para>
  <para style="q">inetz q'inteya toj Ejipt;</para>
  <para style="q">qanintza twaya ex knnojsa'ya, nchije'.</para>
  <para style="b" />
  <para style="q">
    <verse number="11" style="v" />Atzunte' ntaname' mixti' ẍinx tb'i'ne';</para>
  <para style="q">¡Mixti'x ẍinx toksla'ne' Israel!</para>
  <para style="q">
    <verse number="12" style="v" />Qu'mtzun ẍe kyeja' ntzaqpi'ne' toju' tch'uẍal kyanmi.</para>
  <para style="q">ex mache anq'in kse'nxju' kyajb'il.</para>
  <para style="q">
    <verse number="13" style="v" />¡Noqwit ma chinx tb'i'nju'ye' ntaname'!</para>
  <para style="q">¡Noqwit mab'et Israel kyoju' nb'eye'</para>
  <para style="q">
    <verse number="14" style="v" />tojwitlo jun kmujx</para>
  <para style="q">ẍekub'a' nme'ssa'nju'ye' tajq'oj</para>
  <para style="q">ex mawtlo kub' ntz'e'ysa'n kywitzju'ye' ẍeokmiltz'uj ti'j! Chi Dyos.</para>
  <para style="b" />
  <para style="q">
    <verse number="15" style="v" />Ma'wtlo che kub'mejeju' nche el ik'unte Qman Dyos,</para>
  <para style="q">ex ma'wtlo kyej tenju' tz'e'ysb'il kywitz tejumajx.</para>
  <para style="q">
    <verse number="16" style="v" />Ma'wtlo tzaj tq'o'n Dyos tb'anil triy te kywaju' ttanam,</para>
  <para style="q">ex ta'lkab' witlo toj aq saj tq'o'n tu'n tel k'waj kyi'j. Chiju' b'itzal.</para>
  <chapter number="82" style="c" />
  <para style="s1">Ate Dyos ajkawil tib'aj tkyaqil</para>
  <para style="q">
    <verse number="1" style="v" />Q'uqlite Dyos toj tkawb'il toj kya'j</para>
  <para style="q">ex nchaq'un kyib'aju' ajkawil kjalu:</para>
  <para style="q">
    <verse number="2" style="v" />¿Ma kukx nxi' kypoqo'nju'ye' tuk'i'l chajyolil</para>
  <para style="q">ex q'o'n kyib'e' kukxju' kyuk'i'l b'inchal myab'a'n?</para>
  <para style="q">
    <verse number="3" style="v" />¡Kyb'inchame' tnik'alilti'j teju' numjni ex teju' meb'a!</para>
  <para style="q">¡Kyb'inchame' tnik'alilti'j teju' prow ex teju' ati nojqelan te!</para>
  <para style="q">
    <verse number="4" style="v" />¡Che kyklomju'ye' mixti' kyipumal ex prow,</para>
  <para style="q">che kyklome' toj kyq'ob'ju' b'inchal taq'wix!</para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" />Aye'tzunkye' min nb'ant kyu'ne', min nok toj kywi'ye';</para>
  <para style="q">toj qxopin nche b'eta'ye'.</para>
  <para style="q">Inxi'x yukchi tx'otx' kyu'ne' ex mixti'x nkych'exb'e'n kynab'le'.</para>
  <para style="q">
    <verse number="6" style="v" />Nmaye' qa dyos qe'ye';</para>
  <para style="q">ex kykyaqilxe' nk'walqe'ye' ayine' Dyos te toj kya'j.</para>
  <para style="q">
    <verse number="7" style="v" />Tu'npetzunju', che kyimele' kse'nqe' kykyaqil xjal,</para>
  <para style="q">¡che b'eltz'aqe' kse'n jun nimaqkawil min xkawin b'a'n! Chi Dyos.</para>
  <para style="b" />
  <para style="q">
    <verse number="8" style="v" />¡Atzun Nman Dyos, tzajku'ya kawil twitz tx'otx',</para>
  <para style="q">a na'ta kyajaw kykyaqilju' nimaqtnam! Chiju' b'itzal.</para>
  <chapter number="83" style="c" />
  <para style="s1">Na'j Dyos tu'n tkolon Dyos</para>
  <para style="q">
    <verse number="1" style="v" />Nman Dyos, ¡lalun kyej numeya!,</para>
  <para style="q">¡lalun noqx qotzaj tb'i'na, qo' ttzaq'wetza!</para>
  <para style="q">
    <verse number="2" style="v" />Ka'yinqe'tzju'ya tajq'oja, aye' intx'a'lti'j kyk'u'j ti'ja:</para>
  <para style="q">matxi' che b'jaw tilj ex matxi' che b'jo'k miltz'uj ti'ja.</para>
  <para style="q">
    <verse number="3" style="v" />Matxi' b'ajkub' kyxima'n ti'xti' taq'wix</para>
  <para style="q">ti'ju' ttanama,</para>
  <para style="q">¡kyi'ju' xq'uqi'nqe' tu'na!</para>
  <para style="q">
    <verse number="4" style="v" />Matxi' kub' kyxima'n tu'n kyul xitulqeye'</para>
  <para style="q">tu'n tkub' naju' qtaname',</para>
  <para style="q">tu'ntzun lalun tzaj na'ntl tb'i Israel.</para>
  <para style="q">
    <verse number="5" style="v" />Kykyaqil matxi' kyej b'entti'j kyu'n,</para>
  <para style="q">matxi' kymujb'a kyib' tu'n kyb'jo'k miltz'uj ti'ja:</para>
  <para style="q">
    <verse number="6" style="v" />aye' kyxmuj aj Edom ex aj Ismael,</para>
  <para style="q">exqe' kyyajajil Awar ex Moab',</para>
  <para style="q">
    <verse number="7" style="v" />Web'al, Amon ex Amalek,</para>
  <para style="q">exqe' pilistey najlqe' toj Tiro,</para>
  <para style="q">
    <verse number="8" style="v" />exqepe' aj Asirya matxi' kymujb'a kyib' kyuk'i'l,</para>
  <para style="q">ex aye' kyipumalju' tyajajil Lot.</para>
  <para style="b" />
  <para style="q">
    <verse number="9" style="v" />B'inchama kyi'j kse'n tb'inchaya ti'j Madyan,</para>
  <para style="q">kse'n tb'inchaya ti'j Sisara,</para>
  <para style="q">ex ti'j Jab'in toju' tnimal a' Kyison,</para>
  <para style="q">
    <verse number="10" style="v" />aye' majx eb'aj toj Endor,</para>
  <para style="q">¡ex eb'jo'k te ttz'isil tx'otx'!</para>
  <para style="q">
    <verse number="11" style="v" />B'inchama kyi'ju' kyxjal nimaq kyoklen</para>
  <para style="q">kse'n tb'inchaya ti'j Oreb' ex ti'j Seeb';</para>
  <para style="q">b'inchama kyi'j kykyaqilju' kynejel</para>
  <para style="q">kse'n tb'inchaya ti'j Seb'a ex ti'j Salmuna,</para>
  <para style="q">
    <verse number="12" style="v" />matoq kub'kyetza'n tk'ik'leb'l Dyos.</para>
  <para style="b" />
  <para style="q">
    <verse number="13" style="v" />Nman Dyos, b'inchama tu'n kysirun kse'n saqch'i'x,</para>
  <para style="q">kse'n t-xaq tze nche'x tiqa'n kyq'iq';</para>
  <para style="q">
    <verse number="14" style="v" />ex kse'n k'ul nb'aj tu'n q'aq'</para>
  <para style="q">ex nche b'aj tkyaqilju' tze tu'n,</para>
  <para style="q">
    <verse number="15" style="v" />¡iktzu'n ljoma toj kyq'ij kyu'n yajb'il</para>
  <para style="q">ex xob'sanqe'xa kyu'n tq'ankyaqa!</para>
  <para style="q">
    <verse number="16" style="v" />¡Tz'elx kych'ixaw tu'na Nman Dyos,</para>
  <para style="q">tu'ntzun kykub'san teya!</para>
  <para style="q">
    <verse number="17" style="v" />Tz'elxwit kych'ixaw tejumajx;</para>
  <para style="q">¡che kub'xwit ch'ixwi ex che kyimxwit!</para>
  <para style="q">
    <verse number="18" style="v" />¡Tu'n telkynik' qa o'kxta Dyos Manb'aj,</para>
  <para style="q">qa o'kxta Dyos te toj kya'j</para>
  <para style="q">tib'aj tkyaqil twitz tx'otx'! Chiju' b'itzal.</para>
  <chapter number="84" style="c" />
  <para style="s1">Wajb'ile' tu'n ntene' toj tja Dyos</para>
  <para style="q">
    <verse number="1" style="v" />¡Nman Dyos nimtipumala,</para>
  <para style="q">tb'anilxi'xte' tjaya xjan!</para>
  <para style="q">
    <verse number="2" style="v" />¡Inxi'x pon nk'u'je' ex nchin elb'aje'</para>
  <para style="q">tu'n ntene' tpenju' tjaya xjan!</para>
  <para style="q">¡Chin b'itzale' teya Dyos tajaw chwinqlal</para>
  <para style="q">tuk'i'l tkyaqil wanmiye'!</para>
  <para style="b" />
  <para style="q">
    <verse number="3" style="v" />Exqepe' tz'unin ex kolondrina</para>
  <para style="q">inokyal jatu'n kyb'inchante kypaqb'il kyal</para>
  <para style="q">ti'ju' tq'olb'eb'la,</para>
  <para style="q">Nman Dyos nimtipumala,</para>
  <para style="q">aya Ndyose' ex nnimaqkawile'.</para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" />¡Tzalajb'ilte' kyeju' nche najan toju' tjaya</para>
  <para style="q">ex min nche qen tu'n kyb'itzan teya!</para>
  <para style="q">
    <verse number="5" style="v" />¡Tzalajb'il kyeju' nknet o'nb'il kyu'n tuk'i'la,</para>
  <para style="q">aye' kyajb'il tu'n kyb'et toju' tb'eya xjan!</para>
  <para style="q">
    <verse number="6" style="v" />Aj kyb'ji'k' toju' b'ya' b'isb'ajilxi'x</para>
  <para style="q">che jawil b'ent t-xiklil a' toj,</para>
  <para style="q">expe' ajttzaj jb'al nche jawb'ent a' tu'n tky'iwb'il Dyos;</para>
  <para style="q">
    <verse number="7" style="v" />kljetel tch'iy kyipumal,</para>
  <para style="q">ex k'okyel kyka'yi'n Dyos nim toklen toj Syon.</para>
  <para style="b" />
  <para style="q">
    <verse number="8" style="v" />Nman Dyos, te tkyaqil ipumalj,</para>
  <para style="q">ja k'uluna' Jakob'</para>
  <para style="q">¡b'intzju'ya nna'j Dyose'!</para>
  <para style="q">
    <verse number="9" style="v" />Nman Dyos, ka'yintzju'ya klol qeye',</para>
  <para style="q">tuk'i'l tk'u'jlalila</para>
  <para style="q">aju' jawni t-sk'o'na te nimaqkawil.</para>
  <para style="b" />
  <para style="q">
    <verse number="10" style="v" />¡Nimxi'xte' toklen tu'n qten jun q'ije' tpenju' tjaya,</para>
  <para style="q">kyetwitz junmutx' q'ij ti'jxi'!</para>
  <para style="q">Ate b'a'n tu'n ntene' xq'uqil ttzi tja Dyos,</para>
  <para style="q">kyetwitz tu'n ntene' janche b'inchanjtza' taq'wix.</para>
  <para style="q">
    <verse number="11" style="v" />Qu'n intq'o'nte Qman Dyos spik'un qe ex nqo t-xq'uqi'n;</para>
  <para style="q">inche tk'u'jla'nte Qman Dyos nche anq'in toj ttxolilti'j ex inche jawtnima'n,</para>
  <para style="q">ex mixti'x nkub' t-xk'ayu'n jun b'a'n kye.</para>
  <para style="b" />
  <para style="q">
    <verse number="12" style="v" />Nman Dyos nimtipumala,</para>
  <para style="q">¡tzalajb'ilte' kyeju' q'uqlok kyk'u'j ti'ja! Chiju' b'itzal.</para>
  <chapter number="85" style="c" />
  <para style="s1">¡Qo tklom jumajtla!</para>
  <para style="q">
    <verse number="1" style="v" />Nman Dyos,</para>
  <para style="q">matxi' tz'okta majx b'a'n tuk'i'lju' ttanama lu.</para>
  <para style="q">matxi' tzaj tanjsa'n jumajtlju'ya ttzalajb'il Jakob';</para>
  <para style="q">
    <verse number="2" style="v" />matxi' kub' tnajsa'na tilju' ttanama</para>
  <para style="q">ex tkyaqilju' kyb'inchb'en myab'a'n;</para>
  <para style="q">
    <verse number="3" style="v" />majx matxi' kub' nak'e</para>
  <para style="q">tq'oja ex ttx'u'jila.</para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" />Nman Dyos ex Klol qeye',</para>
  <para style="q">¡qo' tkloma ja'lo</para>
  <para style="q">ex lalun tx'u'jintla qi'je'!</para>
  <para style="q">
    <verse number="5" style="v" />¿Ma kukxtzun tq'ojinju'ya qi'je'?</para>
  <para style="q">
    <verse number="6" style="v" />¿Ma laytzun tzaj tq'o'n jumajtlju'ya qchwinqlale',</para>
  <para style="q">tu'ntzun ttzalaju' ttanama ti'ja?</para>
  <para style="q">
    <verse number="7" style="v" />Nman Dyos,</para>
  <para style="q">¡yek'untza tk'u'jlalila qeye', ex qo' tkloma!</para>
  <para style="b" />
  <para style="q">
    <verse number="8" style="v" />Kxe'l nb'i'nwe' ktma' Qman Dyos;</para>
  <para style="q">qu'n kyolil ti'ju' nak'b'il te ttanam,</para>
  <para style="q">kyeju' b'a'n okslalqe' te,</para>
  <para style="q">tu'ntzun lalun kyb'incha jumajtlju' myab'a'n.</para>
  <para style="q">
    <verse number="9" style="v" />Axxi'x nqaku' ta'te Dyos,</para>
  <para style="q">kolol kyi'ju' nche niman te;</para>
  <para style="q">ktenb'elju' tajwalil twitzju' qtx'otx'.</para>
  <para style="b" />
  <para style="q">
    <verse number="10" style="v" />Kkymujb'a'kyib'ju' tk'u'jlalil exju' ax,</para>
  <para style="q">kkytz'u'li' kyib'ju' nak'b'il tuk'i'lju' tnik'alilti'j,</para>
  <para style="q">
    <verse number="11" style="v" />kpuqilju' ax twitz tx'otx'</para>
  <para style="q">atzu'n tnik'alilti'j ktzalajel twitz kya'j.</para>
  <para style="q">
    <verse number="12" style="v" />Aku'te Qman Dyos ktzajel q'onteju' jb'al,</para>
  <para style="q">ex ktq'a' tawalju' qtx'otx'.</para>
  <para style="q">
    <verse number="13" style="v" />Kb'el neju' tnik'alilti'j twitz,</para>
  <para style="q">ex kb'el tb'incha'nju' tb'e. Chiju' b'itzal.</para>
  <chapter number="86" style="c" />
  <para style="s1">O'kxta Dyos</para>
  <para style="q">
    <verse number="1" style="v" />Q'aq'antz tk'u'ja Nman Dyos, chin tb'itza,</para>
  <para style="q">qu'n nchin b'isune' ex prowqine';</para>
  <para style="q">
    <verse number="2" style="v" />Chin t-xq'uqima, okslan wnaq qina'we' teya.</para>
  <para style="q">Ateju'ya Dyos ink'lu'na;</para>
  <para style="q">¡chin tkloma ayine' tmajena q'uqli nk'u'je' ti'ja!</para>
  <para style="b" />
  <para style="q">
    <verse number="3" style="v" />Nman Dyos, q'aq'antz tk'u'ja wi'je',</para>
  <para style="q">atl kmuj nchin kub'sane' teya.</para>
  <para style="q">
    <verse number="4" style="v" />Nman Dyos, q'uqb'antz ch'i'nwe' nk'u'j ayine' tmajena,</para>
  <para style="q">qu'n teya nchin kub'sanaye'.</para>
  <para style="q">
    <verse number="5" style="v" />Qu'n majx b'a'nta Nman Dyos, ex nkub' tnajsa'na il;</para>
  <para style="q">nim tk'u'jlalila kyi'ju' nche kub'san teya.</para>
  <para style="b" />
  <para style="q">
    <verse number="6" style="v" />Taye, b'intzju'ya nna'j Dyose',</para>
  <para style="q">¡b'intzju'ya nkub'sb'ile'!</para>
  <para style="q">
    <verse number="7" style="v" />Inchin kub'sane' teya toju' yajb'ilweye',</para>
  <para style="q">qu'n inchin tzajttzaq'we'na.</para>
  <para style="q">
    <verse number="8" style="v" />¡Mixti' juntl dyos kse'n aya, Nman Dyos!</para>
  <para style="q">¡Mix-a'lo' juntl ikx tb'inchb'enju' kse'nta!</para>
  <para style="b" />
  <para style="q">
    <verse number="9" style="v" />Nman Dyos,</para>
  <para style="q">aya kub' b'inchankyeju' nimaqtnam,</para>
  <para style="q">ex che b'ju'l tk'etza tu'n kyk'ulun teya</para>
  <para style="q">ex tu'n tjaw kynima'n tb'iya.</para>
  <para style="q">
    <verse number="10" style="v" />Qu'n o'kxta Dyos;</para>
  <para style="q">¡nim toklena ex nche tb'incha'na ti'xti' te lab'te'n!</para>
  <para style="b" />
  <para style="q">
    <verse number="11" style="v" />Nman Dyos, yek'untza tb'eyila weye',</para>
  <para style="q">tu'ntzun nxilpeye' ti'ja toj ttxolilti'j.</para>
  <para style="q">Chin toniya tu'n nnimanteju'ye' tb'iya</para>
  <para style="q">
    <verse number="12" style="v" />Taye ex Ndyos,</para>
  <para style="q">kjawil wajwali'na tu'n tkyaqil wanmiye'</para>
  <para style="q">ex kjawil nnima'ne' tb'iya kukxju'.</para>
  <para style="q">
    <verse number="13" style="v" />¡Nimxi'xju' tk'u'jlalila wi'je'!</para>
  <para style="q">¡Machin tkola tu'n lalun chinxe' toj muqb'il!</para>
  <para style="b" />
  <para style="q">
    <verse number="14" style="v" />Nman Dyos,</para>
  <para style="q">jun k'loj xjal mixti' kynab'l ex tx'u'jqe',</para>
  <para style="q">ex mixti' tchiylala kye,</para>
  <para style="q">matxi' che okmiltz'uj wi'je' ex kyajb'il tu'n nkub' kyb'yo'ne'.</para>
  <para style="q">
    <verse number="15" style="v" />Atzunta Taye,</para>
  <para style="q">jun Dyosa tb'anilxi'x ex inlaq tk'u'ja.</para>
  <para style="q">ati tpasensi, nim tk'u'jlalila exju' tyola ax.</para>
  <para style="q">
    <verse number="16" style="v" />Chin tka'yitza, ¡q'aq'antz tk'u'ja wi'je'!</para>
  <para style="q">¡Chin tkloma ayine' tmajena! ¡q'ontza tipumala weye'!</para>
  <para style="q">
    <verse number="17" style="v" />Q'ontz jun yek'b'il chik'lixi'x weye' ti'ju' t-xtalb'ila,</para>
  <para style="q">ex che kub'xwit ch'ixwiju' ntx'a'lti'j kyk'u'j wi'je' ajtokkyka'yi'n.</para>
  <para style="q">¡Nman Dyos, inchin tzaj toni'na ex ntq'uqb'a'na nk'u'je'! Chiju' b'itzal.</para>
  <chapter number="87" style="c" />
  <para style="s1">Ajwalb'ilteju' ninttanam Dyos</para>
  <para style="q">
    <verse number="1" style="v" />Tkub'qe' tq'uqlil ninttanam Dyos</para>
  <para style="q">kyib'aju' witz xjan.</para>
  <para style="q">
    <verse number="2" style="v" />Inxi'x che tk'u'jla'n Qman Dyos tjpelju' tnam Syon</para>
  <para style="q">kyekwitzju' tja Jakob'.</para>
  <para style="q">
    <verse number="3" style="v" />Aya ttanam Dyos,</para>
  <para style="q">nim ti'xti' tb'anilqexi'x nche q'manjtz ti'ja:</para>
  <para style="q">
    <verse number="4" style="v" />Kxe'l nma'ne' kyb'i junjunju' tnam ojtzqi'nqine' kyu'n:</para>
  <para style="q">a junju' Ejipt ex B'ab'ilon,</para>
  <para style="q">Pilistey, Tiro ex Etiopiy;</para>
  <para style="q">kykyaqil ja'lu ti'ja ẍe tzaja' anq'in. Chiju' nq'omli.</para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" />Kkyma' ti'ju' nintnam Syon:</para>
  <para style="q">Ti'j ẍe itz'ja' ja'lu exju' chix. Chechiku'.</para>
  <para style="q">Aku'te Dyos Manb'aj te toj kya'j q'mante.</para>
  <para style="q">
    <verse number="6" style="v" />Inkub' ttz'ib'a'n Qman Dyos toju' u'j</para>
  <para style="q">ja tku'xa' kyb'iju' tnam:</para>
  <para style="q">Ti'j saja' anq'inju' lu. Chij.</para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" />Aye'tzu'n nche b'itzan exqe' nche chinb'an inkyma'n:</para>
  <para style="q">Aju' nnajb'ile' atzu' ta' ti'ja. Chechij. Chiju' b'itzal.</para>
  <chapter number="88" style="c" />
  <para style="s1">Nman Dyos, ¿tiqu'n nchin ela' tik'u'na?</para>
  <para style="q">
    <verse number="1" style="v" />Nman Dyos ex klol weye',</para>
  <para style="q">inchin qanin o'nb'ile' teya q'ijtl ex qonik'an,</para>
  <para style="q">
    <verse number="2" style="v" />¡k'momju'ya nna'j Dyose'!,</para>
  <para style="q">¡ex b'intzju'ya nkub'sb'ile'!</para>
  <para style="b" />
  <para style="q">
    <verse number="3" style="v" />Nim txqan taq'wix matxi' kub' tz'aq wib'aje',</para>
  <para style="q">ttzi jul te kamik ta'qine';</para>
  <para style="q">
    <verse number="4" style="v" />¡nchin okq'o'ntle' toj kyajlal kyimni,</para>
  <para style="q">qu'n matxi' chin kyaje' mixti'tl wipumale'!</para>
  <para style="q">
    <verse number="5" style="v" />Matxi' chin kyej kolb'ine' kyxol kyimni;</para>
  <para style="q">ikqinju'ye' kse'nqe' matxi' che b'ajkyim toj q'oj</para>
  <para style="q">ex matxi' che b'ajku'x mqu'n;</para>
  <para style="q">kse'nqe'ju' oje che kyej ttzaqpi'na</para>
  <para style="q">ex matxi' tzik' kyna'l tu'na.</para>
  <para style="q">
    <verse number="6" style="v" />Matxi' chin ku'x tq'o'na tzmax t-xexi' jul,</para>
  <para style="q">kyoj qxopin ex nin kyxe.</para>
  <para style="q">
    <verse number="7" style="v" />Matxi' tzaj tb'ajsa'nju'ya ttx'u'jila wib'aje',</para>
  <para style="q">¡matxi' chin ku'x tmulq'i'na tjaq' ttolob' a'!</para>
  <para style="q">
    <verse number="8" style="v" />Matb'inchaya tu'n nkyaj kykolb'e'ne' wamiwe';</para>
  <para style="q">machin nok tq'o'na taq'wixi'x kye.</para>
  <para style="q">¡Ikyqinju'ye' kse'n jun pres layx tzaqpaj!</para>
  <para style="q">
    <verse number="9" style="v" />Tu'nju' nxi'x chin oq'e' xi'nkyeje' moẍ.</para>
  <para style="q">¡Tkyaqil q'ij nchin kub'sane' teya Nman Dyos,</para>
  <para style="q">ex inche jaw wiq'i'nju'ye' nq'ob'e' twitza!</para>
  <para style="q">
    <verse number="10" style="v" />¿Ma oktzun b'entel tb'inchanteya b'a'nq'ob'aj kyi'ju' kyimqe'tl?</para>
  <para style="q">¿Ma oktzun b'entel kyq'on chjonteju' kyimni teya?</para>
  <para style="q">
    <verse number="11" style="v" />¿Ma oktzun b'entel tpakb'etju' tyola ax ex tk'u'jlalila</para>
  <para style="q">toj muqb'il ex toj tkawb'il kamik?</para>
  <para style="q">
    <verse number="12" style="v" />¿Ma ktzunlo k'elel tnik' jun ti'ju' t-xtalb'ila ex tb'inchb'ena tb'anilxi'x</para>
  <para style="q">toju' tqxopinil kamik, jannik'a' kyna'l tkyaqil?</para>
  <para style="b" />
  <para style="q">
    <verse number="13" style="v" />Ayintzunwe' Nman Dyos, teya nchin kub'sana'ye';</para>
  <para style="q">inchin kub'sane' teya toj nna'j Dyose' te prim.</para>
  <para style="q">
    <verse number="14" style="v" />¿Titiqu'n nchin ela' tik'una, Nman Dyos?</para>
  <para style="q">¿Titiqu'n nkub'a' tewantib'a nwitze'?</para>
  <para style="q">
    <verse number="15" style="v" />Ttzajlenx toj nku'xumale'</para>
  <para style="q">matxi' chin b'isunxi'ye' ex ch'inaqx min chin kyimaye';</para>
  <para style="q">matxi' tzik'x wu'ne' toju' yajb'il saj tq'o'na wib'aje'.</para>
  <para style="q">ex layx wipatle'.</para>
  <para style="q">
    <verse number="16" style="v" />Matxi' tzik'ju' ttx'u'jila xob'ajilx wib'aje';</para>
  <para style="q">ex matxi' kub'wi'je' tu'n;</para>
  <para style="q">
    <verse number="17" style="v" />tkyaqil kmuj txoli'n wi'je' tu'n,</para>
  <para style="q">kse'n tnimal a'.</para>
  <para style="q">
    <verse number="18" style="v" />Mache b'je'l tpa'nju'ya wamiwe' ex wuk'i'le' wi'je',</para>
  <para style="q">noqx qlolj ati wuk'i'le' ja'lo, chiju' b'itzal.</para>
  <chapter number="89" style="c" />
  <para style="s1">Yol kyej b'entti'j tu'n Dyos tuk'i'l Dab'i</para>
  <para style="q">
    <verse number="1" style="v" />Nman Dyos, kxel nb'itza'ne' kukxju'</para>
  <para style="q">qa b'inchal xtalb'ila;</para>
  <para style="q">kxe'l nma'ne' kukxju'</para>
  <para style="q">qa in japunxi'x tyola.</para>
  <para style="q">
    <verse number="2" style="v" />Kxe'l npakb'a'ne' qa tejumajxju' tk'u'jlalila;</para>
  <para style="q">ex minti' nch'exb'et tyola,</para>
  <para style="q">kse'n kya'j majx ati.</para>
  <para style="q">
    <verse number="3" style="v" />Kyej b'entti'j jun yol tu'na tuk'i'l Dab'i;</para>
  <para style="q">kyej ttziya'na teju' tmajena sk'o'ntl tu'na:</para>
  <para style="q">
    <verse number="4" style="v" />Knb'incha'ye' tu'n kykawinju'</para>
  <para style="q">tyajajila kukxju' te t-xela. Chija te.</para>
  <para style="q">
    <verse number="5" style="v" />Nman Dyos,</para>
  <para style="q">Kykyaqilxju' najlqe' toj kya'j</para>
  <para style="q">inche niman teya tu'nju' tyola njapun ex tkyaqilju' tb'inchb'ena tb'anilxi'x.</para>
  <para style="q">
    <verse number="6" style="v" />¡Mixti' jun dyos, mixti' jun toj kya'j</para>
  <para style="q">ikywitju' kse'n aya, Nman Dyos!</para>
  <para style="q">
    <verse number="7" style="v" />Aya Dyos nim tchiylala ex nim toklena,</para>
  <para style="q">txoli'nk ti'ja kyu'n anjl te toj kya'j.</para>
  <para style="b" />
  <para style="q">
    <verse number="8" style="v" />Nman Dyos, te tkyaqil ipumalj,</para>
  <para style="q">teya tkyaqilju' ipumalj ex txoli'n ti'ja tu'nju' ax;</para>
  <para style="q">¡mixti' juntel kse'n aya!</para>
  <para style="q">
    <verse number="9" style="v" />Aya ntzak'unteju' ninnjab' intx'u'jin</para>
  <para style="q">tu'na nkub'a' nak'eju' ttolob';</para>
  <para style="q">
    <verse number="10" style="v" />kub' tpech'u'na Raab'<note caller="+" style="f"><char style="fr" closed="false">89.10 </char><char style="ft" closed="false">Nota: Toj kywitz junjun tnam ojtxi' qa atitoq jun nin txkup taq'wixi'x ex xob'ajilx toj ninnjab'.</char></note></para>
  <para style="q">naku'xwitloj jun kyimni;</para>
  <para style="q">mache'x t-slama'nju'ya tajq'oja</para>
  <para style="q">tu'n tipumal tq'ob'a.</para>
  <para style="q">
    <verse number="11" style="v" />Te teju'ya kya'j ex tx'otx';</para>
  <para style="q">aya kub' b'inchante tx'otx' ex tkyaqilju' ate' twitz.</para>
  <para style="q">
    <verse number="12" style="v" />Aya b'inchanteju' ati, tzajx tnayajkya'j pomnix tb'a'nq'ob'kya'j;</para>
  <para style="q">nche b'itzanju' witz Tab'or ex Ermon tu'n kytzalajb'il toj tb'iya.</para>
  <para style="q">
    <verse number="13" style="v" />Nimtipumalju' tq'ob'a;</para>
  <para style="q">kuwju' tb'a'nq'ob'a ex inkub'ti'j tkyaqil tu'n.</para>
  <para style="q">
    <verse number="14" style="v" />A tq'uqlil tkawb'ilju'ya ttxolilti'j ex tnik'alilti'j;</para>
  <para style="q">nejlqe' tk'u'jlalil tuk'i'lju' ax twitza.</para>
  <para style="b" />
  <para style="q">
    <verse number="15" style="v" />Nman Dyos,</para>
  <para style="q">ky'i'wla'nte' tnam in niman teya tuk'i'l tzalajb'il</para>
  <para style="q">ex in b'et toju' t-spik'umala,</para>
  <para style="q">
    <verse number="16" style="v" />intzalaj tkyaqil kmuj toj tb'iya</para>
  <para style="q">ex intzalaj tu'nju' tz'aqlixi'xa.</para>
  <para style="q">
    <verse number="17" style="v" />Axxi'x aya tipumal ex tb'anil;</para>
  <para style="q">naq tu'n t-xtalb'ila nim qipumale' inten.</para>
  <para style="q">
    <verse number="18" style="v" />¡A Qman Dyos kolol qi'je'!</para>
  <para style="q">¡Ate Xjan tib'aj Israel nimaqkawil qe!</para>
  <para style="b" />
  <para style="q">
    <verse number="19" style="v" />Jun q'ij yolina toj witzik',</para>
  <para style="q">kyeju' tmajena tnik'alkyi'j ex tzaj tma'na kye:</para>
  <para style="q">Matxi' jawnsk'o'ne' jun ichan min nxob' toju' ntaname',</para>
  <para style="q">matxi' txi' nq'o'ne' toklen ex matxi' woniye'.</para>
  <para style="q">
    <verse number="20" style="v" />¡Matxi' knetju' nmajine' Dab'i wu'ne'!</para>
  <para style="q">Matz'oknq'o'ne' te nimaqkawil tu'n waseyte' xjan</para>
  <para style="q">
    <verse number="21" style="v" />ex tkyaqil kmuj kwoni'ye'.</para>
  <para style="q">¡Knkuwsa'ye' tu'n wipumale'!,</para>
  <para style="q">
    <verse number="22" style="v" />lay che q'ojinju' tajq'oj ti'j</para>
  <para style="q">ex lay kub'ti'j kyu'n b'inchal myab'a'n.</para>
  <para style="q">
    <verse number="23" style="v" />Che kb'el nb'yo'nju'ye' tajq'oj;</para>
  <para style="q">¡che elil wiq'i'ne' twitz!</para>
  <para style="q">¡Che kb'el ntoqi'nju'ye' ntx'a'lti'j kyk'u'j ti'j!</para>
  <para style="q">
    <verse number="24" style="v" />Ktenb'el nk'u'jlalile' ti'j ex kjapumel nyole' te,</para>
  <para style="q">ex nim tipumal ktenb'el wu'ne'.</para>
  <para style="q">
    <verse number="25" style="v" />Knkuwsa'ye' toklen tu'n tkawin</para>
  <para style="q">tzajx ttzi ninnjab' Mediteraney, tponx ttzi nin a' Ewprates.</para>
  <para style="q">
    <verse number="26" style="v" />Ktma' weye': Aya Nmane';</para>
  <para style="q">aya Ndyose', klol weye' ex xq'uqilweye'. Chiku'.</para>
  <para style="q">
    <verse number="27" style="v" />Kxe'l nq'o'ne' toklen te tnejil k'wa'lb'aj,</para>
  <para style="q">kyib'aj kykyaqilju' nimaqkawil twitz tx'otx'.</para>
  <para style="q">
    <verse number="28" style="v" />Ktenb'el nk'u'jlalile' ti'j kukxju',</para>
  <para style="q">ex majx kjeltenju' nyole' kyejni b'entti'j tuk'i'l.</para>
  <para style="q">
    <verse number="29" style="v" />Kche kawilju' tyajajil kukxju' te t-xel</para>
  <para style="q">akx atiju' kya'j.</para>
  <para style="b" />
  <para style="q">
    <verse number="30" style="v" />Qatzun makyej kykolb'i'nju' nxnaq'tzb'ile'</para>
  <para style="q">qa min nche anq'in kse'nqe'x nchaq'b'ile',</para>
  <para style="q">
    <verse number="31" style="v" />qa min ẍejapun nkawb'ile' kyu'n</para>
  <para style="q">exqa min nche'x kyb'i'n nchaq'b'ile',</para>
  <para style="q">
    <verse number="32" style="v" />kb'el ntz'e'ysa'ne' kywitz tu'n tpaj kypi'sal ex kyb'inchb'en myab'a'n</para>
  <para style="q">che b'ajel njumane' toj tze;</para>
  <para style="q">
    <verse number="33" style="v" />atzu'n Dab'i lay b'aj nk'u'jlanteye',</para>
  <para style="q">ex ilti'j kjapumel nyole' b'entniti'j tuk'i'l.</para>
  <para style="q">
    <verse number="34" style="v" />Lay kub' nxitu'nju'ye' nyole' kyej b'enti ti'j tuk'i'l</para>
  <para style="q">ex lay nch'exb'eju'ye' nyole' xintziya'ne' te.</para>
  <para style="q">
    <verse number="35" style="v" />Jumajx oje txi' ntziya'ne' te, toj nxjanile',</para>
  <para style="q">ex lay chin chanyole' te:</para>
  <para style="q">
    <verse number="36" style="v" />kche kawilju' tyajajil te t-xel kukxju',</para>
  <para style="q">akx atiju' q'ij.</para>
  <para style="q">
    <verse number="37" style="v" />¡Ktenb'el kukxju', kse'n xjaw!</para>
  <para style="q">¡Ktenb'el kukxju', akx atiju' kya'j! Chija Dyos.</para>
  <para style="b" />
  <para style="q">
    <verse number="38" style="v" />Tu'npetzunju', matxi' tz'el tik'u'nju'ya</para>
  <para style="q">nimaqkawil jawni t-sk'o'na;</para>
  <para style="q">¡matxi' jaw tx'u'jina te!</para>
  <para style="q">
    <verse number="39" style="v" />Matxi' kub' t-xitu'na tyola kyejni b'entti'j tuk'i'lju' tmajena;</para>
  <para style="q">matxi' kub't-xonju'ya toklen twitz tx'otx'.</para>
  <para style="q">
    <verse number="40" style="v" />Macheb'aj t-xopq'i'nju'ya ttapi:</para>
  <para style="q">¡ex mache b'ajt-xitu'na nimaqttanam!</para>
  <para style="q">
    <verse number="41" style="v" />Kykyaqilju' xjal nche b'jik' inb'ajx kyelq'a'n titi'xku' kyajb'il;</para>
  <para style="q">inche xmayinkju' tb'esin ti'j.</para>
  <para style="q">
    <verse number="42" style="v" />Matxitq'o'na kyipumalu' tajq'oj</para>
  <para style="q">ex mataja tu'n kyb'aj tzalaj tu'nju' ẍe kanb'an.</para>
  <para style="q">
    <verse number="43" style="v" />Matz'elti'na twitzteju' tk'uẍtx'e'nb'il</para>
  <para style="q">ex min xtkuwsaya toju' q'oj.</para>
  <para style="q">
    <verse number="44" style="v" />Matz'el ti'na tajwalil;</para>
  <para style="q">matxi' kub't-xonju'ya tq'uqb'il twitz tx'otx';</para>
  <para style="q">
    <verse number="45" style="v" />mattaqk'uya tab'q'iyil tchwinqlal</para>
  <para style="q">ex nim tch'ixaw sel tu'na.</para>
  <para style="b" />
  <para style="q">
    <verse number="46" style="v" />Nman Dyos,</para>
  <para style="q">¿ma kukxtzun tkub' tewa'n tib'ju'ya?</para>
  <para style="q">¿Ma kukxtzun ktenb'il ttx'u'jilju'ya kse'n q'aq' nk'ant?</para>
  <para style="q">
    <verse number="47" style="v" />Taye, na'ntza naqch'i'n toju' nchwinqlale';</para>
  <para style="q">naq jte' q'ij in anq'inju' ichan kub' tb'incha'na.</para>
  <para style="q">
    <verse number="48" style="v" />¡Mix-a'lo'te jun xjal in anq'in ex lay kyim!</para>
  <para style="q">¡Mix-a'lo' jun kkletil te tipumal kamik!</para>
  <para style="q">
    <verse number="49" style="v" />Nman Dyos,</para>
  <para style="q">¿jatzunta' tk'u'jlalila atitoq tnejel,</para>
  <para style="q">ju' kyej ttziya'na te Dab'i tu'n tjapun tu'na?</para>
  <para style="q">
    <verse number="50" style="v" />Nman Dyos, na'nqe'tzju'ya tmajena</para>
  <para style="q">nche ok ik'le'n kyu'n txqan xjal;</para>
  <para style="q">ex inche exch'yonju' ik'b'il lu toj nk'u'je'.</para>
  <para style="q">
    <verse number="51" style="v" />Nman Dyos,</para>
  <para style="q">¡iktzun nqo oka' ik'le'naju'ye' kyu'n tajq'oja!</para>
  <para style="q">¡iktzu'n noka' ik'le'n tmajenju'ya jawni t-sk'o'na!</para>
  <para style="b" />
  <para style="q">
    <verse number="52" style="v" />Nimanjtzxwitju' Qman Dyos tejumajx.</para>
  <para style="q">¡Ikxwitju'! Chiju' b'itzal.</para>
  <chapter number="90" style="c" />
  <para style="ms">Tkyaji'n U'j</para>
  <para style="mr">(E' b'itz <ref loc="PSA 90-106">90—106</ref>)</para>
  <para style="s1">Tejumajxte' Dyos, atzu'n xjal naq te jte' q'ij</para>
  <para style="q">
    <verse number="1" style="v" />Nman Dyos, matxi' tz'oka te kolb'ilqeye'</para>
  <para style="q">toj tkyaqil tab'q'iyil.</para>
  <para style="q">
    <verse number="2" style="v" />Atxi'x na'mxtoq kyb'aj b'entju' witz</para>
  <para style="q">ex na'mxtoq tb'entju' tx'otx' ex tkyaqilju' ati twitz,</para>
  <para style="q">atxi'x toju' tq'ijlalil ojtxi'xi'x</para>
  <para style="q">ex toju' tq'ijlalil tzul,</para>
  <para style="q">axteju'ya Dyos.</para>
  <para style="q">
    <verse number="3" style="v" />In nanjkyi'ju' xjal toj quq tu'na</para>
  <para style="q">ajtmanteya kjalu: Kutanj kyi'je' toj quq aye'ye' xjal. Chija.</para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" />Axxi'x, iky kab'k'al lajnaq (1,000) ab'q'iju' teya,</para>
  <para style="q">kse'n q'ij ewi.</para>
  <para style="q">¡Ikyqe'ju' kse'n jte' kmoj xq'uqb'il toj qonik'an!</para>
  <para style="q">
    <verse number="5" style="v" />Inche'x b'alalan tu'na naku'j tu'n tnimal a',</para>
  <para style="q">ex inik' kyna'l naku'j jun witzik';</para>
  <para style="q">
    <verse number="6" style="v" />ikyqe'ju' kse'n k'ul inche b'echin te prim,</para>
  <para style="q">ajtzun tok qale nche kub' tzqij ex nche kyim.</para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" />Axxi'x, inqo b'aje' tu'nju' ttx'u'jila,</para>
  <para style="q">¡inqo' kyej chukjiye' tu'n!</para>
  <para style="q">
    <verse number="8" style="v" />Q'ancha'l qexi'xju' qile'</para>
  <para style="q">ex qb'inchb'ene' myab'a'n twitza.</para>
  <para style="b" />
  <para style="q">
    <verse number="9" style="v" />Axxi'x, tkyaqilju' qchwinqlale'</para>
  <para style="q">kb'ajel tu'n ttx'u'jila;</para>
  <para style="q">naq jun jiq'chanx nche ik'a'ju' qab'q'iye'.</para>
  <para style="q">
    <verse number="10" style="v" />Oxnaq lajoj (70) ab'q'iju' qchwinqlale' njapun;</para>
  <para style="q">qatzun majx kuwqo'ye' njapun toj kyajnaq;</para>
  <para style="q">atzu'n qama qo tene' nimtoj</para>
  <para style="q">naqx yajb'il ex aq'untl ntzaj tq'o'n qeye'.</para>
  <para style="q">¡Lwiyxi'x nche b'jik'ju' ab'q'i, ikxu' kse'n ayo'ye'!</para>
  <para style="b" />
  <para style="q">
    <verse number="11" style="v" />¿Alxi'xkye ojtzqilte tipumal ttx'u'jila?</para>
  <para style="q">¿Alkye ojtzqilteju' tq'oja?</para>
  <para style="q">
    <verse number="12" style="v" />Qo' t-xnaq'tzama tu'n qximane' ti'ju' qchwinqlale' ch'i'ntoj,</para>
  <para style="q">tu'ntzun qanq'ine' tuk'i'l nab'l.</para>
  <para style="b" />
  <para style="q">
    <verse number="13" style="v" />¡Nman Dyos, kutanjtz ti'ja quk'i'le'!</para>
  <para style="q">¿Jtojtzun tzula?</para>
  <para style="q">¡q'aq'antz tk'u'ja qi'je' ayo'ye' tmajena!</para>
  <para style="q">
    <verse number="14" style="v" />Qo' tnajsama tu'n tk'u'jlalila ajtjawu'l q'ij,</para>
  <para style="q">tu'ntzun qb'itzane' toj tzalajb'il toj tkyaqilju' qchwinqlale'.</para>
  <para style="q">
    <verse number="15" style="v" />Q'ontz b'a'npun ab'q'iya te tzalajb'il qeye'</para>
  <para style="q">kse'nqe' ab'q'i te yajb'il matxi' tzik'x qu'ne'.</para>
  <para style="q">
    <verse number="16" style="v" />¡B'inchama tu'n kyka'yinteju' tmajena kyuk'i'lju' kyyajajil</para>
  <para style="q">ju' tb'inchb'ena ex tajwalila!</para>
  <para style="b" />
  <para style="q">
    <verse number="17" style="v" />Awtju' t-xtalb'ila Nman Dyos,</para>
  <para style="q">kub'ten qib'aj.</para>
  <para style="q">¡B'a'nwt tz'ela' qaq'une' twitza!</para>
  <para style="q">¡Iku', b'inchama tu'n telb'a'nju' qaq'une'! Chiju' b'itzal.</para>
  <chapter number="91" style="c" />
  <para style="s1">Ate Qman Dyos kolb'ilqe</para>
  <para style="q">
    <verse number="1" style="v" />Aju' nnajan tjaq' t-xlekumalju'</para>
  <para style="q">Qman Dyos ati toj kya'j te tkyaqil ipumalj,</para>
  <para style="q">
    <verse number="2" style="v" />kxe'l tma'n te Qman Dyos: Aya jun kolb'ilweye',</para>
  <para style="q">jun ja te kolb'il wib'e', ¡Ndyose', ja q'uqloka' nk'u'je'! Chij.</para>
  <para style="q">
    <verse number="3" style="v" />O'kxte ktzaqpilteya</para>
  <para style="q">kye xpatxab' ate' toj ewaj ex kyeju' yab'il b'iyul,</para>
  <para style="q">
    <verse number="4" style="v" />kb'ajel tktxu'n ti'ja kyu'n t-xik',</para>
  <para style="q">ex kkletila kyjaq' b'a'nxi'x.</para>
  <para style="q">¡Kkletela tu'nju' tyol njapun, kse'n tu'n jun kolb'il!</para>
  <para style="q">
    <verse number="5" style="v" />Lalun xob'a teju' xob'ajil toj qonik'an,</para>
  <para style="q">ex kyeju' talsmaj nche tzaj xon te q'ijtl,</para>
  <para style="q">
    <verse number="6" style="v" />ex kyeju' yab'il nche b'et toj qxopin,</para>
  <para style="q">ex kyeju' kamik nche b'iyun te q'ijtl;</para>
  <para style="q">
    <verse number="7" style="v" />qu'n che kb'eltz'aq kab'k'al lajnaq (1,000) tu'n kamik toj tnayaja</para>
  <para style="q">ex junmutx' jok'al (10,000) toj tb'a'nq'ob'a</para>
  <para style="q">atzunta mixti' k'ik'ela'ya.</para>
  <para style="q">
    <verse number="8" style="v" />Kche tka'yi'ya tu'n twitza:</para>
  <para style="q">aj tq'onjtz ju' tu'me'l t-xel kyeju' b'inchal taq'wix.</para>
  <para style="b" />
  <para style="q">
    <verse number="9" style="v" />Qu'n matxi'na tz'ok tq'o'na Qman Dyos te tewb'ila,</para>
  <para style="q">aju' Dyos te toj kya'j te klolteya,</para>
  <para style="q">
    <verse number="10" style="v" />lay tzaj jun ti'xti' taq'wix ti'ja</para>
  <para style="q">ex lay ponju' yab'il toj tjaya;</para>
  <para style="q">
    <verse number="11" style="v" />qu'n che tzajel tchq'o'n tanjl</para>
  <para style="q">xq'uqilteya jaxjaku' matxa'ya.</para>
  <para style="q">
    <verse number="12" style="v" />Kxe'l q'i'na kyu'n toj kq'ob'</para>
  <para style="q">tu'ntzun lalun che pon takpuju' tqana ti'j ab'j.</para>
  <para style="q">
    <verse number="13" style="v" />Kb'entel tb'eta kyxol b'alun,</para>
  <para style="q">kyxol kan ex kyxol nimaqtxkup.</para>
  <para style="b" />
  <para style="q">
    <verse number="14" style="v" />Knkla'ye',</para>
  <para style="q">kb'el nq'o'ne' ja lay che pon kanun txqantl ti'j,</para>
  <para style="q">qu'n ojtzqi'nqine' tu'n, ex nchin tk'u'jla'ne'.</para>
  <para style="q">
    <verse number="15" style="v" />Ajttxokon weye', kxe'l ntzaq'we'ne';</para>
  <para style="q">¡ayinku'we' chin tenb'il tuk'i'l!</para>
  <para style="q">Knkla'ye' toj b'is</para>
  <para style="q">ex kjawil nwab'a'ne' tuk'i'l oklenj;</para>
  <para style="q">
    <verse number="16" style="v" />ktzalajel wu'ne' toj jun tchwinqlal nimtoj:</para>
  <para style="q">¡kntzalajsa'ye' toju' kolb'il wu'ne'! Chi Dyos. Chiju' b'itzal.</para>
  <chapter number="92" style="c" />
  <para style="s1">Jun b'itz te ajwalb'il</para>
  <para style="q">
    <verse number="1" style="v" />Nimxi'x toklena Nman Dyos,</para>
  <para style="q">¡tb'anilxi'x tu'n qq'on chjonteye' teya</para>
  <para style="q">ex tu'n tjaw qnimane' tb'iya kyu'n b'itz!</para>
  <para style="q">
    <verse number="2" style="v" />Tu'n tpakb'etju' tk'u'jlalila nimxi'x ex tyola ax</para>
  <para style="q">atl junjun prim ex qonik'an,</para>
  <para style="q">
    <verse number="3" style="v" />toj kyq'ojq'ojel chnab' tzintzb'il,</para>
  <para style="q">tuk'i'l b'unin kyq'ojq'ojel arpa ex tzintzin.</para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" />Nman Dyos,</para>
  <para style="q">¡machin ttzalajsaya kyu'n tb'inchb'ena!</para>
  <para style="q">¡Inxi'x chin tzalaje' kyu'nju' taq'unb'ena!</para>
  <para style="q">
    <verse number="5" style="v" />Nman Dyos,</para>
  <para style="q">¡majx tb'anilqe'xi'xkye' taq'unb'ena!</para>
  <para style="q">¡Exqe' ju' tnab'la nimxi'x!</para>
  <para style="q">
    <verse number="6" style="v" />¡O'qe'kxju' mixti' kynab'l min nkane toj kywitz!</para>
  <para style="q">
    <verse number="7" style="v" />Qa nche ch'iyju' b'inchal myab'a'n ex b'inchal il</para>
  <para style="q">kse'n k'ul, ex nche q'inumax,</para>
  <para style="q">naqx tu'n kykub' xitu'nkye' tejumajx.</para>
  <para style="q">
    <verse number="8" style="v" />Atzunta Nman Dyos, kukx ttenju'ya toj kya'j.</para>
  <para style="q">
    <verse number="9" style="v" />Axxi'xte', Nman Dyos:</para>
  <para style="q">kche b'ajel xitu'nju' tajq'oja;</para>
  <para style="q">che b'ajel sputi'n kykyaqilju' b'inchal taq'wix.</para>
  <para style="b" />
  <para style="q">
    <verse number="10" style="v" />Intzaj tch'isa'na wipumale'</para>
  <para style="q">kse'n tipumal jun tman wakx,</para>
  <para style="q">ex njax tq'o'na k'ok'sb'il toj nwi'ye'.</para>
  <para style="q">
    <verse number="11" style="v" />Knka'yiye' se'n ajkykub'a' tz'aqju' wajq'oje;</para>
  <para style="q">¡knb'i'ye' ajkyẍch'inju' b'inchal myab'a'n lu toj k'ixk'oj!</para>
  <para style="b" />
  <para style="q">
    <verse number="12" style="v" />Inche b'echanju' b'a'n xjal kse'n tut</para>
  <para style="q">ex nche ch'iy kse'nqe' k'ute toj Lib'ano.</para>
  <para style="q">
    <verse number="13" style="v" />Awa'nqe' toj tja Qman Dyos;</para>
  <para style="q">inche b'inchan twi' tpen tja Dyos.</para>
  <para style="q">
    <verse number="14" style="v" />Expe' kche witzal aj kytijin;</para>
  <para style="q">ktenb'el kyipumalju' kukxju' ex kyxaq ẍlajun,</para>
  <para style="q">
    <verse number="15" style="v" />ex kxe'l kypakb'a'ntzuntz qa tzinunte' Qman Dyos klol weye',</para>
  <para style="q">ex mixti' jun myab'a'n toj. Chiju' b'itzal.</para>
  <chapter number="93" style="c" />
  <para style="s1">A Qman Dyos nimaqkawil</para>
  <para style="q">
    <verse number="1" style="v" />¡Ate Qman Dyos nimaqkawil!</para>
  <para style="q">¡Oksa'nte Qman Dyos ti'j te oklenj</para>
  <para style="q">txoli'n ti'j tu'n ipumalj!</para>
  <para style="q">Ate kyej kuwsante tx'otx' tu'n lay yukchi.</para>
  <para style="q">
    <verse number="2" style="v" />Atxi'xtzunj kyej qeju' tkawb'ila Nman Dyos.</para>
  <para style="q">¡Atiya tejumajx!</para>
  <para style="b" />
  <para style="q">
    <verse number="3" style="v" />Nman Dyos,</para>
  <para style="q">inche tinunju' nin a' ex njaw kytolob' nimaq;</para>
  <para style="q">
    <verse number="4" style="v" />Atzunta Nman Dyos, te toj kya'j,</para>
  <para style="q">nimxi'x tipumala kyekywitzju' kytolob'</para>
  <para style="q">ex kyetwitzju' ttx'u'jil ninnjab'.</para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" />Nman Dyos,</para>
  <para style="q">majx ateqe' tchaq'b'ila.</para>
  <para style="q">¡Wiqo'n ti'ju' tjaya tejumajx tu'n xjanb'il! Chiju' b'itzal.</para>
  <chapter number="94" style="c" />
  <para style="s1">A Qman Dyos Ajkawil tib'aj tkyaqil twitz tx'otx'</para>
  <para style="q">
    <verse number="1" style="v" />¡Yek'um tib'a Nman Dyos, aya ju' Dyos q'ol tu'me'l t-xel!</para>
  <para style="q">
    <verse number="2" style="v" />Aya Ajkawil tib'aj tkyaqil twitz tx'otx';</para>
  <para style="q">¡q'i'nktz tib'a kyi'ju' njaw kynima'nkyib'</para>
  <para style="q">tz'e'ysanku'ya kywitz!</para>
  <para style="b" />
  <para style="q">
    <verse number="3" style="v" />Nman Dyos,</para>
  <para style="q">¿jtoj b'aj kytzalajb'ilju' b'inchal myab'a'n?</para>
  <para style="q">
    <verse number="4" style="v" />Kykyaqilju' b'inchal il lu</para>
  <para style="q">mixti'x kynab'l ex naq nkynima'n kyib';</para>
  <para style="q">¡ex la'j qe'!</para>
  <para style="q">
    <verse number="5" style="v" />Nman Dyos,</para>
  <para style="q">ate'qe'k xitulteju' ttanama;</para>
  <para style="q">¡ate'k yajlalkyeju' xjal etza'nqe' tu'na!</para>
  <para style="q">
    <verse number="6" style="v" />Nche kub' kyb'yo'n qya kyimni kychmil ex najchaq xjal;</para>
  <para style="q">nche kub' kyb'yo'n meb'a.</para>
  <para style="q">
    <verse number="7" style="v" />Nkyma'n qa min nka'yin Dyos,</para>
  <para style="q">exqa min b'i'n tu'n Tdyos Jakob'.</para>
  <para style="b" />
  <para style="q">
    <verse number="8" style="v" />¡Kanex toj kywitze', mib'a'n che b'ine' ex mixti'x kynab'le'!</para>
  <para style="q">¿Jtoj kane toj kywitze'?</para>
  <para style="q">
    <verse number="9" style="v" />¿Ma laytzun txiqb'i'nju'</para>
  <para style="q">kub' b'inchante qẍkyin?</para>
  <para style="q">¿Ma laytzun txiqka'yi'nju'</para>
  <para style="q">kub' b'inchante qwitz?</para>
  <para style="q">
    <verse number="10" style="v" />¿Ma laytzun kub' tz'e'ysa'n twitz</para>
  <para style="q">tu'nju' nkawin kyib'aju' nimaqtnam?</para>
  <para style="q">¿Ex ma laytzun tb'iju' ntzaj q'onte kynab'l xjal?</para>
  <para style="q">
    <verse number="11" style="v" />Kanlite' twitz Qman Dyos</para>
  <para style="q">qa o'kxtzu' nximana' xjal ti'ju' mixti' tajb'en.</para>
  <para style="b" />
  <para style="q">
    <verse number="12" style="v" />Nman Dyos,</para>
  <para style="q">tzalajb'ilte' teju' xjal nxi' ttzak'u'na</para>
  <para style="q">ex nxitq'o'na t-xnaq'tzb'ila te</para>
  <para style="q">
    <verse number="13" style="v" />tu'ntzun tten tzalajb'il te</para>
  <para style="q">aj tulju' tq'ijlalil myab'a'n,</para>
  <para style="q">akxku' nb'inchet</para>
  <para style="q">kyjulju' b'inchal myab'a'n.</para>
  <para style="q">
    <verse number="14" style="v" />Lay che kyej tkolb'e'nte Qman Dyos ttanam,</para>
  <para style="q">ex lay che kyajttzaqpi'nju' etza'nqe' tu'n.</para>
  <para style="q">
    <verse number="15" style="v" />Tzul jumajtlju' tnik'alilti'j kyoju' kawb'il,</para>
  <para style="q">ex kykyaqilju' xjal tnik'alkyi'j che kxe'l lpe ti'j.</para>
  <para style="b" />
  <para style="q">
    <verse number="16" style="v" />¿Alkye kjawil tiq'i'ntib' klol weye'</para>
  <para style="q">toj kyq'ob'ju' b'inchal myab'a'n ex b'inchal il?</para>
  <para style="q">
    <verse number="17" style="v" />Naqwit mya Qman Dyos xklonweye',</para>
  <para style="q">ojewtlo tzik'x nna'le' tu'n kamik.</para>
  <para style="q">
    <verse number="18" style="v" />Tej txi' nma'n jumaje': Inche el jililin nqane', nchije'</para>
  <para style="q">ula onilweye', Nman Dyos, tuk'i'l tk'u'jlalila.</para>
  <para style="q">
    <verse number="19" style="v" />Kyoju' xim nb'ajx nk'u'je' ti'j</para>
  <para style="q">ajkyb'ju'l toj nwi'ye',</para>
  <para style="q">intq'uqb'a'na nk'u'je' ex nchin ttzalajsa'na.</para>
  <para style="q">
    <verse number="20" style="v" />Lay tmujb'atatib' kyuk'i'lju' ajkawil mya tnik'alkyi'j,</para>
  <para style="q">myab'a'n che kawin ex min nche oklpe ti'ju' kawb'il;</para>
  <para style="q">
    <verse number="21" style="v" />inb'aj kychmo'nkyib' ti'ju' mixti' til exju' tnik'alti'j,</para>
  <para style="q">ex inkyaj b'entti'j kyu'n tu'n tkub' kyb'yo'n.</para>
  <para style="q">
    <verse number="22" style="v" />Atzunte Qman Dyos kolb'ilweye';</para>
  <para style="q">ikyte Qman Dyos kse'n jun pik nklo'nwib'e' ti'j.</para>
  <para style="q">
    <verse number="23" style="v" />Ktb'incha'te Qman Dyos</para>
  <para style="q">tu'n kynaju' b'inchal myab'a'n tojxju' kyil.</para>
  <para style="q">¡A Qman Dyos kb'el najsankye! chiju' b'itzal.</para>
  <chapter number="95" style="c" />
  <para style="s1">Qoqe' b'itzan te Qman Dyos tuk'i'l tzalajb'il</para>
  <para style="q">
    <verse number="1" style="v" />Kukytzaje', qoqe' b'itzan tuk'i'l tzalajb'il te Qman Dyos;</para>
  <para style="q">qoqe' b'itzan teju' xq'uqilqe ex klolqe.</para>
  <para style="q">
    <verse number="2" style="v" />Qo okx twitz tuk'i'l aq'b'il chjonte,</para>
  <para style="q">ex qo b'itzan b'itz te ninb'ilte.</para>
  <para style="q">
    <verse number="3" style="v" />Qu'n nimte Qman Dyos toklen,</para>
  <para style="q">aju' nimaqkawil nim toklen kyib'aj kykyaqilju' dyos.</para>
  <para style="q">
    <verse number="4" style="v" />Qu'n toj tq'ob'</para>
  <para style="q">ta'ju' t-xe tx'otx';</para>
  <para style="q">ex te qe'ju' nimaq witz.</para>
  <para style="q">
    <verse number="5" style="v" />Tete' Dyos ninnjab', qu'n a kub' b'inchante;</para>
  <para style="q">¡kub' tb'incha'nju' tx'otx' tzqij kyu'nku' tq'ob'!</para>
  <para style="b" />
  <para style="q">
    <verse number="6" style="v" />Kukytzaje', qoqe' k'ulun mejliqo';</para>
  <para style="q">qoqe' mejeku' twitz Qman Dyos,</para>
  <para style="q">qu'n ate kub'inchanqe.</para>
  <para style="q">
    <verse number="7" style="v" />Ate Qman Dyos, ayo'tzunqe ttanamqo';</para>
  <para style="q">tritqo' toj tch'laj.</para>
  <para style="b" />
  <para style="q">Kyb'intzju'ye' ktma' ja'lo:</para>
  <para style="q">
    <verse number="8" style="v" />Lan kub' kych'uẍsa'n kyanmiye', kse'n toj Merib'a;</para>
  <para style="q">kse'nj toj Masa, toj chq'ajlaj,</para>
  <para style="q">
    <verse number="9" style="v" />tej nkub' kyq'o'ne' ojtxi' kyyajilb'ene' toj joyb'ilwi'je',</para>
  <para style="q">maskyepe' ojetoq che kyilju' waq'unb'ene'.</para>
  <para style="q">
    <verse number="10" style="v" />Kab'naq (40) ab'q'i ntx'u'jine'</para>
  <para style="q">kyi'ju' xjal lu,</para>
  <para style="q">ex nmaye': Matxi' che b'aj kub'tzpetkye' xjal lu;</para>
  <para style="q">¡min nche'x kyb'i'n nchaq'b'ile'! nchije'.</para>
  <para style="q">
    <verse number="11" style="v" />Qu'mtzun nmaye' toj ntx'u'jile'</para>
  <para style="q">qa lay che okx toju' najb'il te wojlab'le'. Chij. Chiju' b'itzal.</para>
  <chapter number="96" style="c" />
  <para style="s1">Jun ak'a'j b'itz te Qman Dyos</para>
  <para style="r">(<ref loc="1CH 16:23-33">1 Cr 16.23-33</ref>)</para>
  <para style="q">
    <verse number="1" style="v" />Kyb'itzanxe' jun ak'a'j b'itz te Qman Dyos;</para>
  <para style="q">che b'itzan qe'ye' te Qman Dyos, ju' najlqe'ye' toj tkyaqil twitz tx'otx';</para>
  <para style="q">
    <verse number="2" style="v" />che b'itzan qe'ye' te Qman Dyos, kyajwali'nktze' tb'i;</para>
  <para style="q">kypakb'anxe' tkolb'il atl junjun q'ij.</para>
  <para style="q">
    <verse number="3" style="v" />Kyolinxju'ye' tajwalil exqe' tb'inchb'en tb'anilqexi'x</para>
  <para style="q">kye kykyaqil b'o's tnam ex nimaqtnam,</para>
  <para style="q">
    <verse number="4" style="v" />qu'n nimte' Qman Dyos toklen</para>
  <para style="q">ex o'kxte ati tu'n tjaw ajwalit:</para>
  <para style="q">¡atzu' tu'n qxob'a' te ex mya kyeju' kydyos xjal!</para>
  <para style="q">
    <verse number="5" style="v" />Mixti'x che oka' kydyos txqantl xjal,</para>
  <para style="q">atzunte Qman Dyos kub' tb'incha'n kya'j.</para>
  <para style="q">
    <verse number="6" style="v" />¡In qoptz'aj ti'jile tu'n nim tajwalil!</para>
  <para style="q">¡Tb'anilxi'xju' tja xjan tu'n tipumal!</para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" />Kynimame' Qman Dyos kykyaqile' tnam te twitz tx'otx',</para>
  <para style="q">tz'elx kynik'e' ti'ju' tipumal ex tajwalil;</para>
  <para style="q">
    <verse number="8" style="v" />kynimanktze' Qman Dyos kse'nxju' toklen;</para>
  <para style="q">kukyokxe' toju' tja tuk'i'l kyoyaje',</para>
  <para style="q">
    <verse number="9" style="v" />che k'ulun qe'ye' te Qman Dyos toju' tja xjan tb'anilxi'x.</para>
  <para style="q">
    <verse number="10" style="v" />Kymanxe' kye nimaqtnam: ¡Ate Qman Dyos nimaqkawil! chechiku'ye'</para>
  <para style="q">Ate kuwsanteju' tx'otx' tu'n lay yukchi;</para>
  <para style="q">ex junelniju' tkawb'il kyib'aj kykyaqil tnam.</para>
  <para style="q">
    <verse number="11" style="v" />¡Che tzalajxju' kya'j ex tx'otx'!</para>
  <para style="q">¡Tinunxju' ninnjab' kyuk'i'lxi' ate' toj!</para>
  <para style="q">
    <verse number="12" style="v" />¡Tzalajxju' kojb'il kyuk'i'lxi' ate' twitz!</para>
  <para style="q">¡Che ẍch'inxju' tze toj k'ul tu'n kytzalajb'il,</para>
  <para style="q">
    <verse number="13" style="v" />twitzju' Qman Dyos, tzul!</para>
  <para style="q">¡Iku', tzul kawil twitz tx'otx',</para>
  <para style="q">kkawil tuk'i'l ax ex tnik'alilti'j</para>
  <para style="q">ex kkawil kyib'aj kykyaqilju' tnam twitz tx'otx'</para>
  <para style="q">tuk'i'l tnik'alilti'j ex ax! Chiju' b'itzal.</para>
  <chapter number="97" style="c" />
  <para style="s1">A Qman Dyos nimaqkawil</para>
  <para style="q">
    <verse number="1" style="v" />¡Ate Qman Dyos nimaqkawil!</para>
  <para style="q">¡Qu'mtzun tzalajx tkyaqilju' tx'otx'!</para>
  <para style="q">¡Che tzalajxju' swejtx'otx' toj ninnjab'!</para>
  <para style="q">
    <verse number="2" style="v" />Txoli'n ti'j tu'n muj jupin;</para>
  <para style="q">tzyu'n tq'uqb'il kyu'n tnik'alilti'j ex tz'aqli;</para>
  <para style="q">
    <verse number="3" style="v" />nejliju' q'aq' twitz</para>
  <para style="q">ex nche ttz'e'ysa'n tajq'oj txoli'nkyib' ti'j.</para>
  <para style="q">
    <verse number="4" style="v" />In qoptz'aj twitz tx'otx' kyu'n txloq'lojkya'j;</para>
  <para style="q">¡inlu'lunju' tx'otx' aj kyxitka'yi'n!</para>
  <para style="q">
    <verse number="5" style="v" />Inche kub'niwju' witz kse'n ser</para>
  <para style="q">twitz Qman Dyos, ju' tajaw tkyaqil tx'otx'.</para>
  <para style="q">
    <verse number="6" style="v" />Nyolinju' kya'j ti'ju' tkawb'il;</para>
  <para style="q">kykyaqilju' tnam nnok kyka'yi'n tajwalil.</para>
  <para style="q">
    <verse number="7" style="v" />Inkub'kyi'ju' nche k'ulun kywitz witzileb',</para>
  <para style="q">aye' nkynima'n kyib' kyi'j.</para>
  <para style="q">¡Kykyaqilju' dyos che kb'el tzipe twitz!</para>
  <para style="b" />
  <para style="q">
    <verse number="8" style="v" />Nman Dyos,</para>
  <para style="q">inxi'x che tzalaju' Syon exqe' nimaqtnam toj Juda</para>
  <para style="q">kyi'ju' tchaq'b'ila;</para>
  <para style="q">
    <verse number="9" style="v" />qu'n atiya Nman Dyos te toj kya'j,</para>
  <para style="q">tib'aj tkyaqil twitz tx'otx'</para>
  <para style="q">ex nim toklena kywitz kykyaqilju' dyos.</para>
  <para style="b" />
  <para style="q">
    <verse number="10" style="v" />Inche tk'u'jla'nte Qman Dyos xjal in elkyik'u'n myab'a'n;</para>
  <para style="q">intklo'n kychwinqlalju' wa'lqe' toj kyokslab'l;</para>
  <para style="q">inche tklo'n tu'n lalun che kub' tz'aq toj kyq'ob'ju' b'inchal myab'a'n.</para>
  <para style="q">
    <verse number="11" style="v" />In qoptz'aj spik'un teju' b'a'n xjal;</para>
  <para style="q">kyekye tnik'alkyi'ju' tzalajb'il.</para>
  <para style="b" />
  <para style="q">
    <verse number="12" style="v" />¡Che tzalajxe' ti'j Qman Dyos, aye'ye' b'a'n xjal qe'ye',</para>
  <para style="q">ex kynimanktzju'ye' tb'i xjan! Chiju' b'itzal.</para>
  <chapter number="98" style="c" />
  <para style="s1">Matxi' kanb'ante Qman Dyos</para>
  <para style="q">
    <verse number="1" style="v" />¡Kyb'itzanxe' jun ak'a'j b'itz te Qman Dyos,</para>
  <para style="q">qu'n matxi' che tb'incha ti'xti' te lab'te'n!</para>
  <para style="q">¡Matxi' kanb'an</para>
  <para style="q">tuk'i'l nim tipumal, tu'n tq'ob' xjan!</para>
  <para style="q">
    <verse number="2" style="v" />Matma Qman Dyos tpakb'alilju' kanb'ab'l,</para>
  <para style="q">matxi' kub' tyek'u'n tnik'alilti'j</para>
  <para style="q">kywitzju' nimaqtnam;</para>
  <para style="q">
    <verse number="3" style="v" />matzajtna'n tk'u'jlalil ti'ju' tnam Israel</para>
  <para style="q">ex njapunju' tyol ttziya kye.</para>
  <para style="q">¡Matxi' pon kanunju' kanb'ab'l tu'n Qman Dyos</para>
  <para style="q">tzmax toj mankb'il twitz tx'otx'!</para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" />Che b'itzan qe'ye' te Dyos tuk'i'l tzalajb'il,</para>
  <para style="q">aye'ye' najlqe'ye' toj tkyaqil twitz tx'otx';</para>
  <para style="q">che b'itzanqe' b'itze' te</para>
  <para style="q">tuk'i'l tkyaqil kytzalajb'ile'.</para>
  <para style="q">
    <verse number="5" style="v" />Kyb'itzanqe'xe' b'itz te Qman Dyos tuk'i'l arpa,</para>
  <para style="q">kyuk'i'l chnab' tzintzin.</para>
  <para style="q">
    <verse number="6" style="v" />Che b'itzan qe'ye' tuk'i'l tzalajb'il twitzju' Qman Dyos, nimaqkawil,</para>
  <para style="q">kyuk'i'l chnab' nche xupit.</para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" />Q'ajtixju' ninnjab' kyuk'i'lxi' ate' toj,</para>
  <para style="q">tkyaqilju' tx'otx' kyuk'i'lxi' najlqe' twitz;</para>
  <para style="q">
    <verse number="8" style="v" />kypoq'cham toj kyq'ob'ju' nin a,</para>
  <para style="q">kyb'uyim kyib'ju' witz tu'n kẍch'in tu'n kytzalajb'il</para>
  <para style="q">
    <verse number="9" style="v" />twitzju' Qman Dyos,</para>
  <para style="q">tzul kawilteju' twitz tx'otx'.</para>
  <para style="q">Ate kkawil kyib'aju' tnam toj tkyaqil twitz tx'otx'</para>
  <para style="q">toj ttzinunal ex junelni. Chiju' b'itzal.</para>
  <chapter number="99" style="c" />
  <para style="s1">A Qman Dyos nimaqkawil nimxi'x toklen</para>
  <para style="q">
    <verse number="1" style="v" />¡Ate Qman Dyos nimaqkawil!</para>
  <para style="q">¡Atiju' tq'uqb'il kyib'aju' kyerb'in!</para>
  <para style="q">Che lu'lunwtju' nimaqtnam, ex tkyaqilju' tx'otx'.</para>
  <para style="q">
    <verse number="2" style="v" />Nimte Qman Dyos toklen twi' witz Syon;</para>
  <para style="q">ati toklen Qman Dyos kyib'aj kykyaqil tnam.</para>
  <para style="q">
    <verse number="3" style="v" />Ajwalinjtzxwitju' tb'i nim toklen ex xob'ajilx;</para>
  <para style="b" />
  <para style="q2">¡Xjante' Dyos!</para>
  <para style="q">
    <verse number="4" style="v" />Jun Nimaqkawilta nimtipumala ntk'u'jla'na tnik'alti'j;</para>
  <para style="q">aku'ya kyej q'onte junelni kyoklen xjal.</para>
  <para style="q">Matxi' tb'inchaya tnik'alti'j ex ttxolilti'j</para>
  <para style="q">kyeju' tk'wal Jakob'</para>
  <para style="q">
    <verse number="5" style="v" />¡Kyajwalinktze' Qman Dyos,</para>
  <para style="q">ex che mejeku'ye' t-xe tqan!</para>
  <para style="b" />
  <para style="q2">¡Xjan te Dyos!</para>
  <para style="b" />
  <para style="q">
    <verse number="6" style="v" />Ate' Moyses tuk'i'l Aaron kyxolju' tpale;</para>
  <para style="q">atzunte Samwel kyxolju' e'jaw ajwalinte tb'i.</para>
  <para style="q">Intoq tzaj ttzaq'we'n Qman Dyos kye</para>
  <para style="q">aj txi' kyqani'n o'nb'il.</para>
  <para style="q">
    <verse number="7" style="v" />Yolin Dyos kyuk'i'l</para>
  <para style="q">tzmax toju' jun tnej muj,</para>
  <para style="q">ex e'japunju' tchaq'b'il kyu'n</para>
  <para style="q">exju' kawb'il tzaj q'o'n kye.</para>
  <para style="b" />
  <para style="q">
    <verse number="8" style="v" />Taye, Nman Dyos, ¡intoq che tzajttzaq'we'na!</para>
  <para style="q">Kub' tnajsa'nju'ya kyil,</para>
  <para style="q">ex kub'ttz'e'ysa'na kywitz tu'n tpaj kyil.</para>
  <para style="q">
    <verse number="9" style="v" />Kynimanktze' Qman Dyos,</para>
  <para style="q">¡che mejeku'ye' twi'ju' witz xjan te Dyos!</para>
  <para style="b" />
  <para style="q2">¡Xjante' Qman Dyos, ju' Dyos Manb'aj! Chiju' b'itzal.</para>
  <chapter number="100" style="c" />
  <para style="s1">Okub' tb'incha'n Qman Dyos ex teqo'</para>
  <para style="q">
    <verse number="1" style="v" />¡Che b'itzan qe'ye' te Qman Dyos tuk'i'l tzalajb'il,</para>
  <para style="q">aye'ye' najliqe'ye' toj tkyaqil twitz tx'otx'!</para>
  <para style="q">
    <verse number="2" style="v" />Che k'ulun qe'ye' te Qman Dyos tuk'i'l tzalajb'il;</para>
  <para style="q">¡che lq'eqetze' twitz, tuk'i'l sich' te tzalajb'il!</para>
  <para style="q">
    <verse number="3" style="v" />Tz'elx kynik'e' qa ate Dyos;</para>
  <para style="q">okub' tb'incha'n ex teqo'.</para>
  <para style="q">O'ttanamqo'</para>
  <para style="q">¡ex tritqo' toj tch'laj!</para>
  <para style="q">
    <verse number="4" style="v" />Che lq'etze' ttzija ex kyoj tpenju' tja</para>
  <para style="q">kyuk'i'l b'itz te ajwalb'ilte ex te aq'b'il chjonte.</para>
  <para style="q">¡Kyq'onx chjonteye' te, ex kynimanktze' tb'i!</para>
  <para style="q">
    <verse number="5" style="v" />Qu'n majx b'a'nte' Qman Dyos;</para>
  <para style="q">tejumajxju' tk'u'jlalil</para>
  <para style="q">ex njapunju' tyol ax kukxju'. Chiju' b'itzal.</para>
  <chapter number="101" style="c" />
  <para style="s1">Ttziya nimaqkawil tyol te Dyos</para>
  <para style="q">
    <verse number="1" style="v" />Wajb'ile' tu'n wajwalinteye' tk'u'jlalil ex tnik'alilti'j;</para>
  <para style="q">Nman Dyos, chin b'itzal b'itze' teya;</para>
  <para style="q">
    <verse number="2" style="v" />wajb'ile' tu'n wanq'ine' toj tnik'alilti'j.</para>
  <para style="q">¿Jtoj tzula nk'etze'?</para>
  <para style="q">Kchin anq'ile' b'a'n twitza</para>
  <para style="q">expe' ikx toju' njaye' te kawb'il;</para>
  <para style="q">
    <verse number="3" style="v" />lay tz'ok nq'o'nwe' nwitz</para>
  <para style="q">kyi'ju' xim myab'a'n.</para>
  <para style="b" />
  <para style="q">Inche wik'u'nwe'ju' min njapun kyol twitza Dyos;</para>
  <para style="q">¡layx waje' tu'n kytzaj lq'e nk'etze'!</para>
  <para style="q">
    <verse number="4" style="v" />Lay tz'ok nq'o'nwe' nwi' kyi'ju' myab'a'n nab'l:</para>
  <para style="q">¡min wajb'ile' tu'n nb'inchante jun taq'wixile'!</para>
  <para style="q">
    <verse number="5" style="v" />Kntenb'a'ye' kyolinju'</para>
  <para style="q">inche jk'un yol toj ewaj ti'j kyb'sin;</para>
  <para style="q">¡lay tzik'xju' ntnima'ntib' wu'ne'!</para>
  <para style="b" />
  <para style="q">
    <verse number="6" style="v" />Atzu' k'okyila' tenwe' nwitz kyi'ju' xjal njapun kyol,</para>
  <para style="q">tu'n qnajane' junx kyuk'i'l;</para>
  <para style="q">o'kxte xjalju' k'ajb'el weye'</para>
  <para style="q">aju' nnanq'in toj ttxolilti'j.</para>
  <para style="q">
    <verse number="7" style="v" />Lay tenju' xjal sb'ul toju' njaye' te kawb'il;</para>
  <para style="q">¡mixti' jun chalyol ktenb'il nk'etze'!</para>
  <para style="q">
    <verse number="8" style="v" />Atl junjun q'ij</para>
  <para style="q">che b'el nnajsa'ne' b'inchal myab'a'n toj tkyaqilju' tnam;</para>
  <para style="q">¡che b'je'lex nxla'ja'ne' kykyaqilju' b'inchal taq'wix</para>
  <para style="q">toju' ninttanam Qman Dyos! Chiju' b'itzal.</para>
  <chapter number="102" style="c" />
  <para style="s1">Tna'j Dyos jun xjal nb'isun</para>
  <para style="q">
    <verse number="1" style="v" />Nman Dyos, b'intzju'ya nna'j Dyose',</para>
  <para style="q">¡ponxwitju' nkub'sb'ile' twitza!</para>
  <para style="q">
    <verse number="2" style="v" />Lalun txitewa'n twitza weye'</para>
  <para style="q">qa nchin b'isune';</para>
  <para style="q">¡b'inchama xtalb'il chin tb'itza!,</para>
  <para style="q">¡lwiyx chin ttzaq'wetza ajntxokone' teya!</para>
  <para style="q">
    <verse number="3" style="v" />Qu'n xitkub' b'aju' nchwinqlale' kse'n sib',</para>
  <para style="q">inche k'antju' nb'aqile' naku'j ttxalq'aq',</para>
  <para style="q">
    <verse number="4" style="v" />matxi' kub'numj wanmiye'</para>
  <para style="q">kse'n k'ul nkub' tzqij;</para>
  <para style="q">¡expe' mixti'x q'aq'a'n wi'je'!</para>
  <para style="q">
    <verse number="5" style="v" />Matxi' tz'ok b'aju' ntz'umale' ti'j nb'aqile'</para>
  <para style="q">tu'nju' nchin oq'e'.</para>
  <para style="q">
    <verse number="6" style="v" />Ikyqinju'ye' kse'n jun tukru toj chq'ajlaj,</para>
  <para style="q">kse'n jun tukru kyxol ttx'anqa'n ja.</para>
  <para style="q">
    <verse number="7" style="v" />Min nchin wtane'.</para>
  <para style="q">Ikyqinju'ye' kse'n jun pich' tjunal twi' jun ja.</para>
  <para style="q">
    <verse number="8" style="v" />Kukx wok ik'le'nju'ye' kyu'n wajq'oje</para>
  <para style="q">ex nnajb'enju' nb'iye' kyu'n te qanb'il myab'a'n.</para>
  <para style="q">
    <verse number="9" style="v" />Tza'j nxinwane' te t-xel nwaye';</para>
  <para style="q">ex nxi' simli ta'l nwitze' toju' nk'wa'ye',</para>
  <para style="q">
    <verse number="10" style="v" />tej saj ttx'u'jila ex tq'oja,</para>
  <para style="q">injaw tiq'i'na tu'n nkub' t-xontla.</para>
  <para style="q">
    <verse number="11" style="v" />Kxi' tkub' naju' nchwinqlale' kse'n leku'n;</para>
  <para style="q">xi' wok tzqije' kse'n itzaj.</para>
  <para style="q">
    <verse number="12" style="v" />Atzunta Nman Dyos, in kawina tejumajx;</para>
  <para style="q">¡ktzajel na'n tb'iya kukxju'!</para>
  <para style="b" />
  <para style="q">
    <verse number="13" style="v" />Q'i'nktztib'a, q'aq'antz tk'u'ja ti'j Syon,</para>
  <para style="q">qu'n matxi' japun tq'ijlalil;</para>
  <para style="q">¡matxi' ponju' kmuj tu'n tnajsanteju'ya kyil!</para>
  <para style="q">
    <verse number="14" style="v" />Kye kyilwiju' tab'jil ttapi kyu'nju' tmajena;</para>
  <para style="q">¡inxi'x exch'yonju' xitb'il toj kyk'u'j!</para>
  <para style="b" />
  <para style="q">
    <verse number="15" style="v" />Kykyaqilju' nimaqtnam ex nimaqkawil twitz tx'otx'</para>
  <para style="q">kkynima' tb'i Qman Dyos tb'anilxi'x</para>
  <para style="q">
    <verse number="16" style="v" />ajtjaw tb'incha'n jumajtlju' tnam Syon</para>
  <para style="q">ex ajtyek'u'ntetib' toj tajwalil,</para>
  <para style="q">
    <verse number="17" style="v" />ajttzajtb'i'n tna'j Dyosju' xjal mixti'x te</para>
  <para style="q">ktzajel tb'i'nju' tkub'sb'il.</para>
  <para style="q">
    <verse number="18" style="v" />B'a'n tu'n tkyej tz'ib'et ja'lu</para>
  <para style="q">kyeju' che ul itz'ji yajxi'tl,</para>
  <para style="q">tu'n tjaw kynima'n Qman Dyos.</para>
  <para style="b" />
  <para style="q">
    <verse number="19" style="v" />Tzaj tka'yi'n Qman Dyos tx'otx' tzmax toj kya'j,</para>
  <para style="q">toju' tnajb'il xjan,</para>
  <para style="q">
    <verse number="20" style="v" />tu'n ttzaj tb'i'n tq'ojq'ojel kywi'ju' presi'nqe'</para>
  <para style="q">ex tu'n kykletju' b'entnitlti'j tu'n kykyim;</para>
  <para style="q">
    <verse number="21" style="v" />tu'ntzun tjaw nima'n tb'i Qman Dyos,</para>
  <para style="q">ex tu'n tpakb'anjtz toj tnam Syon ex toj Jerusalen</para>
  <para style="q">
    <verse number="22" style="v" />ajtb'aj kyb'u'yi'n kyib'ju' xjal</para>
  <para style="q">te kykyaqil nimaqtnam tu'n kyk'ulun te.</para>
  <para style="b" />
  <para style="q">
    <verse number="23" style="v" />Matz'el tiq'i'n wipumale' toj nik'jan b'e;</para>
  <para style="q">mattaqk'u tq'ijlalil nchwinqlale'.</para>
  <para style="q">
    <verse number="24" style="v" />Inxi' nkub'sa'ne' te: Nman Dyos,</para>
  <para style="q">lalun taja tu'n nkyimnaje' toj nik'janju' tq'ijlalil nchwinqlale' Nchije'.</para>
  <para style="b" />
  <para style="q">¡Mixti'ta b'ajsb'il te!</para>
  <para style="q">
    <verse number="25" style="v" />Tkuwsaju'ya tx'otx' atxi'x t-xe tnejel;</para>
  <para style="q">aku'ya kub' b'inchante kya'j.</para>
  <para style="q">
    <verse number="26" style="v" />Kykyaqil ja'lu kche b'ajel,</para>
  <para style="q">atzunta majx atiya.</para>
  <para style="q">Kb'ajel tkyaqil ja'lu, kse'n xb'alun;</para>
  <para style="q">¡ktch'ixpu'ya, kjeltzuntz ch'exb'e'ntl,</para>
  <para style="q">kse'n jun xjal ajtel tch'ixpu'n ti'j!</para>
  <para style="q">
    <verse number="27" style="v" />Atzunta axteju'ya;</para>
  <para style="q">mixti'x b'ajsb'il kyeju' tab'q'iyila.</para>
  <para style="q">
    <verse number="28" style="v" />B'a'n che anq'ila' kyk'walju' tmajena tu'na;</para>
  <para style="q">kche tenb'il twitza. Chiju' b'itzal.</para>
  <chapter number="103" style="c" />
  <para style="s1">Kjawil nnima'ne' Qman Dyos</para>
  <para style="q">
    <verse number="1" style="v" />Kjawil nnima'ne' Qman Dyos tu'n tkyaqil nk'u'je';</para>
  <para style="q">kjawil nnima'ne' tb'i xjan tu'n tkyaqil nk'u'je'.</para>
  <para style="q">
    <verse number="2" style="v" />Kjawil nnima'ne' Qman Dyos tu'n tkyaqil wanmiye';</para>
  <para style="q">lay tzik'tna'l junju' t-xtalb'il wu'ne'.</para>
  <para style="q">
    <verse number="3" style="v" />A nkub'najsante tkyaqilju' wile',</para>
  <para style="q">ex nchin tq'a'na'ne' te tkyaqil yab'il,</para>
  <para style="q">
    <verse number="4" style="v" />intklo'n nchwinqlale' te kamik,</para>
  <para style="q">nim xtalb'il nk'mo'ne' te tu'n tlaqb'il tk'u'j,</para>
  <para style="q">
    <verse number="5" style="v" />intq'uqb'a'n nk'u'je' tu'n tkyaqil tb'anil</para>
  <para style="q">ex nchin ku'xumix jumajtle' tu'n kse'n t'iw.</para>
  <para style="b" />
  <para style="q">
    <verse number="6" style="v" />Intb'incha'nte Qman Dyos tnik'alilti'j axxi'x</para>
  <para style="q">kyeju' nche yajti.</para>
  <para style="q">
    <verse number="7" style="v" />Tzaj tyek'u'n tb'eyil ex tb'inchb'en</para>
  <para style="q">te Moyses ex teju' tnam Israel.</para>
  <para style="q">
    <verse number="8" style="v" />Majx b'a'nte Qman Dyos ex nq'aq'an tk'u'j;</para>
  <para style="q">ati tpasens ex nim tk'u'jlalil.</para>
  <para style="q">
    <verse number="9" style="v" />Mya q'achq'alxwit tok tzak'ulqe ex min nkuxtk'u'n titk'u'j;</para>
  <para style="q">
    <verse number="10" style="v" />min nttz'e'ysa'n qwitz</para>
  <para style="q">kse'nxju' qb'inchb'en myab'a'n;</para>
  <para style="q">
    <verse number="11" style="v" />nimxi'x tk'u'jlalil kyi'ju' nche niman te</para>
  <para style="q">kse'n kya'j nim toktza' tib'aju' tx'otx'.</para>
  <para style="q">
    <verse number="12" style="v" />Matxi' tz'el tlaq'b'a'n qil qk'etz,</para>
  <para style="q">kse'n kyxolju' tjawetzq'ij tuk'i'lju' tkub'exq'ij.</para>
  <para style="q">
    <verse number="13" style="v" />In laqj tk'u'j Qman Dyos kyi'ju' nche niman te,</para>
  <para style="q">kse'n jun manb'aj nlaqj kyi'j tk'wal;</para>
  <para style="q">
    <verse number="14" style="v" />qu'n tojtzqi'n titi' qtx'otx'al:</para>
  <para style="q">b'i'nxi'x tu'n qa quqqo'.</para>
  <para style="b" />
  <para style="q">
    <verse number="15" style="v" />Ik tchwinqlal xjalju' kse'n k'ul;</para>
  <para style="q">intzaj ch'iy kse'n jun b'ech toj kojb'il:</para>
  <para style="q">
    <verse number="16" style="v" />ajtzun ttzaj jumj kyq'iq' tib'aj, nkyim,</para>
  <para style="q">ex mix-a'lo' b'ilte ja xxa'.</para>
  <para style="q">
    <verse number="17" style="v" />Atzunte Qman Dyos tk'u'jlalil ati tejumajx</para>
  <para style="q">kyeju' nche niman te;</para>
  <para style="q">mixti' b'ajsb'il teju' t-xtalb'il</para>
  <para style="q">kye kykyaqilju' che ul itz'ji yajxi'tl,</para>
  <para style="q">
    <verse number="18" style="v" />kyeju' njapun tyol kyu'n, aju' kyejni b'entti'j</para>
  <para style="q">ex min in ik'tna'l kyu'n tu'n kyb'inchante e'tchaq'b'il.</para>
  <para style="q">
    <verse number="19" style="v" />Kub' tq'o'n Qman Dyos tq'uqb'il te kawb'il toj kya'j,</para>
  <para style="q">ex in kawin tib'aj tkyaqil.</para>
  <para style="q">
    <verse number="20" style="v" />¡Kyajwali'nktze' Qman Dyos, anjl nim kyipumale'!</para>
  <para style="q">Aye'ye' nche japun tchaq'b'il kyu'ne',</para>
  <para style="q">majx tokkywi'ye' ti'j tu'n kyb'inchanteye'.</para>
  <para style="q">
    <verse number="21" style="v" />¡Kynimanktze' Qman Dyos kykyaqile' ttanam,</para>
  <para style="q">ju' nche ajb'ene' te ex nkyb'incha'ne' tajb'il!</para>
  <para style="q">
    <verse number="22" style="v" />¡Kyajwali'nktze' Qman Dyos kykyaqile' e'tch'isb'en qe'ye',</para>
  <para style="q">kyoj kykyaqil najb'il ja nkawina'!</para>
  <para style="b" />
  <para style="q">¡Kchin nimale' te Qman Dyos tu'n tkyaqil nk'u'je'! Chiju' b'itzal.</para>
  <chapter number="104" style="c" />
  <para style="s1">B'itz teju' B'inchalte tkyaqil</para>
  <para style="q">
    <verse number="1" style="v" />¡Kjawil nnima'na Nman Dyos tu'n tkyaqil nk'u'je'!</para>
  <para style="q">¡Nimxi'x toklena Taye, Nman Dyos!</para>
  <para style="q">Matxi' tz'ok toksa'na tajwalila tb'anilxi'x;</para>
  <para style="q">
    <verse number="2" style="v" />Matz'ok tktxu'na spik'un ti'ja naku'j jun xb'alun.</para>
  <para style="q">¡Xit-slik'u'na kya'j naku'j jun xb'alun!</para>
  <para style="q">
    <verse number="3" style="v" />¡E'kub' twab'a'nju'ya tqan tjaya</para>
  <para style="q">tib'aju' a' tzmaxtzu' jawnixi'!</para>
  <para style="q">In ajb'enju' muj tu'na te tkarwaja;</para>
  <para style="q">¡in b'eta tib'aj t-xik'ju' kyq'iq'!</para>
  <para style="q">
    <verse number="4" style="v" />Aye' t-sanjelalju'ya kyq'iq',</para>
  <para style="q">aye'tzu'n tqan taq' q'aq' nche ajb'en teya.</para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" />Kub' tq'o'na tx'otx' kyib'aju' tq'uqlil</para>
  <para style="q">tu'n lalun yukchi.</para>
  <para style="q">
    <verse number="6" style="v" />Ktxu'n toqju' tx'otx' tu'n ninnjab' nim t-xe</para>
  <para style="q">naku'xwitloj t-xb'alun.</para>
  <para style="q">Ktxu'nqe'toqju' witz tu'n a'.</para>
  <para style="q">
    <verse number="7" style="v" />Tetzunj txi' ttzak'una, ik' oq;</para>
  <para style="q">lwiy ik' oq tej txi' tb'i'nju' toj twi'ya nxi'x tinun.</para>
  <para style="q">
    <verse number="8" style="v" />Jax kywi' witz</para>
  <para style="q">ex ku'tz kyoju' b'ya',</para>
  <para style="q">xi'tzuntz toju' najb'il b'incha'ntl tu'na te,</para>
  <para style="q">
    <verse number="9" style="v" />kyej tq'o'nju'ya tnaqach tu'n lalun tzik'tz jlajintl,</para>
  <para style="q">tu'ntzun lalun tzulkanun jumajtl ktxulteju' tx'otx'.</para>
  <para style="b" />
  <para style="q">
    <verse number="10" style="v" />Inche jawb'entju' kyxiklil a' tu'na</para>
  <para style="q">exqe' a' nche b'et kyxol witz.</para>
  <para style="q">
    <verse number="11" style="v" />Ti'jtzu'n a' lu nche k'wana' tojk'ul txkup;</para>
  <para style="q">inel k'waj kyi'ju' toj k'ul chej tu'n.</para>
  <para style="q">
    <verse number="12" style="v" />Inkyb'incha'n pich' kyja</para>
  <para style="q">kytziju' nin a'</para>
  <para style="q">¡atzuntzu' nche oq'a' kyxolju' tq'ob' tze!</para>
  <para style="b" />
  <para style="q">
    <verse number="13" style="v" />Aya ntzaj chitunte jb'al kyib'aju' k'ul</para>
  <para style="q">tzmaxtzu' toj kya'j jata' tjaya;</para>
  <para style="q">inb'aj tak'sa'nju'ya twitz tx'otx' tu'n nin jb'al intzaj twitz kya'j.</para>
  <para style="q">
    <verse number="14" style="v" />In tch'isa'nju'ya k'ul te kywa alu'mj,</para>
  <para style="q">ex tawal xjal</para>
  <para style="q">tu'n tjawju' twa twitz tx'otx',</para>
  <para style="q">
    <verse number="15" style="v" />aju' twa nq'onte tipumal,</para>
  <para style="q">exju' tk'wa' ta'l ub'a ntzalajsante</para>
  <para style="q">ex nqoptz'ajxi'xju' twitz tu'n kyetwitz tu'n aseyt.</para>
  <para style="q">
    <verse number="16" style="v" />Inel k'waj kyi'ju' tze,</para>
  <para style="q">e' k'ute awa'nqe' tu'n Qman Dyos toj Lib'ano.</para>
  <para style="q">
    <verse number="17" style="v" />Kywi' tze lu nkyb'incha'na' kyja tal pich' b'o'sqe',</para>
  <para style="q">ex kywi' tzaj najlqe' nimaqpich' naku'j garsqe'.</para>
  <para style="q">
    <verse number="18" style="v" />Kywi' nimaq witz ta'qe' tojk'ul chib',</para>
  <para style="q">aye'tzu'n tojk'ul ẍiky najlqe' kyxol pik.</para>
  <para style="b" />
  <para style="q">
    <verse number="19" style="v" />Kub' tb'incha'na xjaw tu'n techitju' tq'ijlalil;</para>
  <para style="q">b'i'n tu'nju' q'ij alkye kmoj tu'n tex.</para>
  <para style="q">
    <verse number="20" style="v" />Ajttzaj tq'o'na qlolj te qonik'an,</para>
  <para style="q">inche b'je'tztzun talu'n k'ultz.</para>
  <para style="q">
    <verse number="21" style="v" />Inche tzanunju' b'alun tu'n tpaj kychi';</para>
  <para style="q">inxikyqani'n te Dyos tu'n txiq'o'n kywa.</para>
  <para style="q">
    <verse number="22" style="v" />Ajtzun tjawu'l q'ij, in nanjkyi'j</para>
  <para style="q">ex nche b'ajx paqeb'il toj kyjul.</para>
  <para style="q">
    <verse number="23" style="v" />Inextzun xjaltz aq'unal</para>
  <para style="q">ex nnaq'unan tzmax ajqok yupj.</para>
  <para style="b" />
  <para style="q">
    <verse number="24" style="v" />¡Taye, nim ti'xti' matxi' che tb'inchaya!</para>
  <para style="q">Tkyaqil kub' tb'incha'na tuk'i'l nab'l;</para>
  <para style="q">¡nojni twitz tx'otx' kyu'n kykyaqilju' kub' tb'incha'na!</para>
  <para style="q">
    <verse number="25" style="v" />Luju' ninnjab' nim twitz min nb'aj qka'yinte,</para>
  <para style="q">ja najlqe' txqan txkup layx b'ent kyajlet,</para>
  <para style="q">e'nimaq ex k'ok'e';</para>
  <para style="q">
    <verse number="26" style="v" />atzu' nche b'eta' b'ark, ex atzu' ta' nin txkup Leb'yatan,</para>
  <para style="q">ju' nin txkup kub'ni tb'incha'na tu'n t-ẍchan toj.</para>
  <para style="q">
    <verse number="27" style="v" />Kykyaqilju' txkup lu nche ayon ti'ja</para>
  <para style="q">inxitq'o'na kywa aj kyq'aq'an.</para>
  <para style="q">
    <verse number="28" style="v" />Inche tk'a'cha'na, ex nche wan;</para>
  <para style="q">intzaj tjqo'na kye ex nche noj b'a'nxi'x</para>
  <para style="q">
    <verse number="29" style="v" />qatzun matxitewa'n twitza kye, inche jaw b'isun;</para>
  <para style="q">qama tz'el tiq'i'nju'ya kyxew inche kyim</para>
  <para style="q">ex nche kub' quqix.</para>
  <para style="q">
    <verse number="30" style="v" />Qatzun ntzaj tq'o'na t-xewa te chwinqlal, inche poq'on,</para>
  <para style="q">ikytzun ntch'exb'e'n twitz tx'otx'ju'ya.</para>
  <para style="q">
    <verse number="31" style="v" />¡Tejumajxju' tajwalil Qman Dyos!</para>
  <para style="q">¡Intzalajte Qman Dyos ti'ju' tb'inchb'en!</para>
  <para style="q">
    <verse number="32" style="v" />Injaw lu'lunju' tx'otx' ajttzaj ka'yin Dyos te;</para>
  <para style="q">¡inche jaw qusinju' witz ajkyok ttzyu'n!</para>
  <para style="b" />
  <para style="q">
    <verse number="33" style="v" />Kchin b'itzalwe' te Qman Dyos,</para>
  <para style="q">toj tkyaqil nchwinqlale'.</para>
  <para style="q">
    <verse number="34" style="v" />Tzalajxwit Qman Dyos kyi'ju' nxime',</para>
  <para style="q">qu'n o'kxtzu' nkneta' ntzalajb'ile' tuk'i'l.</para>
  <para style="q">
    <verse number="35" style="v" />¡Che kub'xwit naju' aj il twitz tx'otx'!</para>
  <para style="q">¡Mixwit che anq'ina'tlju' b'inchal myab'a'n!</para>
  <para style="b" />
  <para style="q">¡Kjawil nnima'ne' Qman Dyos tu'n tkyaqil nk'u'je'!</para>
  <para style="q">¡Ajwalinjtzxwit! Chiju' b'itzal.</para>
  <chapter number="105" style="c" />
  <para style="s1">Tb'anil b'a'nq'ob'aj tb'incha Dyos kye aj Israel</para>
  <para style="q">
    <verse number="1" style="v" />¡Kyq'onx chjonteye' te Qman Dyos!</para>
  <para style="q">¡Kypakb'anxju'ye' tb'i!</para>
  <para style="q">Kymanqe'xju'ye' tb'inchb'aj kye tnam.</para>
  <para style="q">
    <verse number="2" style="v" />Che b'itzanqe' b'itze' te ninb'ilte.</para>
  <para style="q">¡Kyolinxju'ye' nimaq tb'inchb'en!</para>
  <para style="q">
    <verse number="3" style="v" />Che tzalajxe' tu'nju' tb'i xjan.</para>
  <para style="q">¡Che tzalajxe'</para>
  <para style="q">aye'ye' nche jyone' ti'j Qman Dyos!</para>
  <para style="q">
    <verse number="4" style="v" />Kyjyome' Qman Dyos, exju' tipumal;</para>
  <para style="q">kyjyome' toj tkyaqil kmuj.</para>
  <para style="q">
    <verse number="5" style="v" />Kyna'nqe'tzju'ye' nimaq tb'inchb'en tb'anilqexi'x,</para>
  <para style="q">exqe'ju' tchaq'b'il kyajni tma'n;</para>
  <para style="q">
    <verse number="6" style="v" />aye'ye' tyajajil Ab'raam ju' tmajin Dyos;</para>
  <para style="q">aye'ye' tk'wal Jakob', ju' sk'o'nqe'ye' tu'n.</para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" />Ate Dyosju' Qman Dyos;</para>
  <para style="q">¡ate nkawin tib'aj tkyaqil twitz tx'otx'!</para>
  <para style="q">
    <verse number="8" style="v" />Lay tzik'tna'lju' tyol kyejni b'entti'j tu'n</para>
  <para style="q">b'a'nqa jte'xku' wiq kyyajajil xjal mache ik' twitz tx'otx'</para>
  <para style="q">
    <verse number="9" style="v" />aju' tyol kyej b'entti'j tuk'i'l Ab'raam,</para>
  <para style="q">ju' kyej ttziya'n te Isaak</para>
  <para style="q">
    <verse number="10" style="v" />ex kyej tq'o'n te jun kawb'il te Jakob',</para>
  <para style="q">ex jun yol kyejni b'entti'j tejumajx kye aj Israel,</para>
  <para style="q">
    <verse number="11" style="v" />tej tmante:</para>
  <para style="q">Kxe'l nq'o'ne' tx'otx' Kanaan teya</para>
  <para style="q">tu'n tok te tetzb'ila. Chij.</para>
  <para style="b" />
  <para style="q">
    <verse number="12" style="v" />B'a'nqa naq ch'i'ntoq kyb'aj,</para>
  <para style="q">jte' ajb'etun toju' tx'otx' Kanaan,</para>
  <para style="q">
    <verse number="13" style="v" />intoq che ik' toj jun nintnam ex nche pon toj juntl</para>
  <para style="q">ex intoq che pon toj jun kawb'il ex inche'x toj juntl,</para>
  <para style="q">
    <verse number="14" style="v" />min taj Qman Dyos tu'n kyb'aj yajla'n,</para>
  <para style="q">expe' xitab'tzi'n kyeju' nimaqkawil:</para>
  <para style="q">
    <verse number="15" style="v" />Lalun tzaq'pon kyq'ob'e' kyi'ju' sk'o'nqe' wu'ne'</para>
  <para style="q">ex lalun che oktene' yajulkye nsanjelale'. Chij kye.</para>
  <para style="b" />
  <para style="q">
    <verse number="16" style="v" />Tzaj tq'o'n we'yaj toju' tx'otx' Kanaan,</para>
  <para style="q">tkyaqilju' kywa eltiq'i'n.</para>
  <para style="q">
    <verse number="17" style="v" />Matxi'toqtzun txitnejb'a'npun Jse kywitz,</para>
  <para style="q">xikyk'a'yi'n te majen.</para>
  <para style="q">
    <verse number="18" style="v" />Eb'aj k'ixb'sa'n tqan kyu'n xpatx'k'uxb'il;</para>
  <para style="q">¡okk'lo'n tqul tu'n k'uxb'il!</para>
  <para style="q">
    <verse number="19" style="v" />Ok Jse toj joyb'ilti'j tu'n tyol Dyos,</para>
  <para style="q">tzmaxi'j tjapunju' yol ojetoq tma Jse.</para>
  <para style="q">
    <verse number="20" style="v" />Tchaq'ju' nimaqkawil intoq kawin kyib'aj txqan xjal,</para>
  <para style="q">tu'n ttzaqpet Jse;</para>
  <para style="q">
    <verse number="21" style="v" />oktq'o'n te nejenel toj tja</para>
  <para style="q">ex tib'aj tkyaqilju' atitoq te,</para>
  <para style="q">
    <verse number="22" style="v" />tu'n t-xnaq'tzan kyeju' nejenel ex tijwnaq</para>
  <para style="q">tu'n kyok ati kynab'l.</para>
  <para style="b" />
  <para style="q">
    <verse number="23" style="v" />Yajxi'tzuntel ul Israel, aju' Jakob',</para>
  <para style="q">ex najan kse'n jun ajb'etun toj Ejipt,</para>
  <para style="q">toju' tx'otx' Kam.</para>
  <para style="q">
    <verse number="24" style="v" />Tb'incha Qman Dyos tu'n tchmet-xi'x kyajlalju' ttanam,</para>
  <para style="q">ex tu'n kyok kuwqe'xi'x kyekywitzju' aj Ejipt.</para>
  <para style="q">
    <verse number="25" style="v" />Tb'inchatzun tu'n kyok miltz'uju' aj Ejipt</para>
  <para style="q">ti'ju' ttanam</para>
  <para style="q">ex tu'n kykub' kysb'u'nju' tmajen Dyos.</para>
  <para style="b" />
  <para style="q">
    <verse number="26" style="v" />Exi'tzun tchq'o'n Dyos Moysestz ju' tmajen,</para>
  <para style="q">tuk'i'l Aaron ju' ojetoq che jaw t-sk'o'n,</para>
  <para style="q">
    <verse number="27" style="v" />eb'enttzun techlaltz kyu'n toj chq'ajlaj:</para>
  <para style="q">¡nimaq ti'xti' te lab'te'n kyb'incha toju' tx'otx' Kam!</para>
  <para style="q">
    <verse number="28" style="v" />Tzaj tq'o'n Dyos qxopin ex majx kyej qtakye',</para>
  <para style="q">mixtzunti'x xi'ju' tyol toj kywinqilu' aj Ejipt.</para>
  <para style="q">
    <verse number="29" style="v" />Eb'jaw b'entju' nin a' te chik' tu'n,</para>
  <para style="q">ex e'kub'tb'yo'nju' kyiẍ toj;</para>
  <para style="q">
    <verse number="30" style="v" />kub' tnojsa'n toju' tnam kyu'n tz'u'nxtx'o,</para>
  <para style="q">expe' ikx ja nwtana' nimaqkawil.</para>
  <para style="q">
    <verse number="31" style="v" />Yolin Qman Dyos, tzajtzun b'ent txqan ta'jin chejtz ex us naku'j muj</para>
  <para style="q">majxkub' noju' tx'otx' Ejipt kyu'n.</para>
  <para style="q">
    <verse number="32" style="v" />Tzaj tq'o'n saqb'aqun te t-xel jb'al,</para>
  <para style="q">tuk'i'l tqan taq' q'aq' tib'aju' tx'otx' Ejipt.</para>
  <para style="q">
    <verse number="33" style="v" />B'aj tyaju'n kyawal ex tqan kylob'aj iw;</para>
  <para style="q">¡eb'aj ttoqi'n tze toj Ejipt!</para>
  <para style="q">
    <verse number="34" style="v" />Yolin Dyos, ex eb'ju'l ẍt'ikt'u'l;</para>
  <para style="q">¡txqanxi'xtoq kyb'aj, layxtoq b'ent kyajlet!</para>
  <para style="q">
    <verse number="35" style="v" />¡Eb'jo'kten walteju' k'ul toj kojb'il</para>
  <para style="q">ex tkyaqilju' awal atitoq twitzu' tx'otx'!</para>
  <para style="q">
    <verse number="36" style="v" />¡E'kub'tb'yo'n tnejel k'wa'lb'aj tojile junjun ja,</para>
  <para style="q">toju' tx'otx' Ejipt!</para>
  <para style="b" />
  <para style="q">
    <verse number="37" style="v" />Yajxi'tzuntel etzti'n Qman Dyos ttanam</para>
  <para style="q">tuk'i'l nim q'anpwaq ex saqpwaq,</para>
  <para style="q">ex mixti'te jun yab'wit kyxolju' tnej kyyajajil tej kyetz.</para>
  <para style="q">
    <verse number="38" style="v" />Ojexi'x che tzalaju' aj Ejipt tej kyka'yinte kyb'je'tz,</para>
  <para style="q">qu'n matxi'toq che yajti tu'n kpaj.</para>
  <para style="q">
    <verse number="39" style="v" />Tzaj tq'o'n Qman Dyos jun tnej muj e'wb'ilkye</para>
  <para style="q">ex jun tnej q'aq' spik'b'alteju' kyb'e te qonik'an.</para>
  <para style="q">
    <verse number="40" style="v" />Xikyqani'n kychi', ex tzaj tq'o'n kychi' tz'chin,</para>
  <para style="q">eb'aj wan tu'n b'a'nxi'x ti'ju' kywa tzaj tq'o'n toj kya'j.</para>
  <para style="q">
    <verse number="41" style="v" />Tjaqju' pik, ex etzchitj a' toj</para>
  <para style="q">b'et kse'n jun nin a' toj chq'ajlaj.</para>
  <para style="q">
    <verse number="42" style="v" />Qu'n tzaj tna'nju' tyol xjan</para>
  <para style="q">tzaj ttziya'n te Ab'raam ju' tmajin.</para>
  <para style="q">
    <verse number="43" style="v" />Ikytzun eb'je'tza' tiq'i'n Dyos ttanam sk'o'nqe' tu'n,</para>
  <para style="q">tuk'i'l sich' te tzalajb'il,</para>
  <para style="q">
    <verse number="44" style="v" />ex tzaj tq'o'n kytx'otx' txqantl tnam kye</para>
  <para style="q">tuk'i'lxi' twitz kyaq'unb'en,</para>
  <para style="q">
    <verse number="45" style="v" />tu'ntoq kyjapunju' tkawb'il Qman Dyos kyu'n</para>
  <para style="q">ex tu'n txi' kyb'i'n t-xnaq'tzb'il.</para>
  <para style="b" />
  <para style="q">¡Ajwalinjtzxwit Qman Dyos! Chiju' b'itzal.</para>
  <chapter number="106" style="c" />
  <para style="s1">Kukx tjaw kyiq'i'n kyib' aj Israel</para>
  <para style="q">
    <verse number="1" style="v" />¡Ajwalinjtzxwitju' Qman Dyos!</para>
  <para style="b" />
  <para style="q">Kyq'onx chjonteye' te Dyos, qu'n majx b'a'nte,</para>
  <para style="q">qu'n tejumajxju' tk'u'jlalil.</para>
  <para style="q">
    <verse number="2" style="v" />¿Alxi'xkye kb'entel tchik'b'ankyeju' tkanb'ab'l Qman Dyos?</para>
  <para style="q">¿Alxi'xkye k'ajwalilte kse'nxju' toklen?</para>
  <para style="q">
    <verse number="3" style="v" />Tzalajb'ilte' kyeju' nkyb'incha'n tnik'alilti'j</para>
  <para style="q">ex kukx kyb'inchanteju'.</para>
  <para style="q">
    <verse number="4" style="v" />Taye, chin tna'ntza aj tb'inchanteju'ya b'a'n teju' ttanama;</para>
  <para style="q">a chin tna'ku'ya ajtula kolol,</para>
  <para style="q">
    <verse number="5" style="v" />tu'ntzun nka'yinteye' kytzalajb'ilju' tmajena sk'o'nqe' tu'na,</para>
  <para style="q">ex tu'n ntzalaje'</para>
  <para style="q">tuk'i'lju' ttanama.</para>
  <para style="b" />
  <para style="q">
    <verse number="6" style="v" />Matxi' qo b'inchan ile' kse'nkye qmane';</para>
  <para style="q">matxi' qokub' chukjiye'; matxi' qb'inchaju'ye' myab'a'n.</para>
  <para style="q">
    <verse number="7" style="v" />Tej kyten qmane' toj Ejipt,</para>
  <para style="q">min okkyq'o'n kyoklenju' tb'inchb'ena tb'anilqexi'x;</para>
  <para style="q">ik'tna'lju' tk'u'jlalila kyu'n,</para>
  <para style="q">ex jawkyi'nkyib' ti'ja ttziju' Kyeq Ninnjab'.</para>
  <para style="b" />
  <para style="q">
    <verse number="8" style="v" />Atzunte Qman Dyos e'tkol,</para>
  <para style="q">xityek'u'n tipumal te ninb'ilteju' tb'i.</para>
  <para style="q">
    <verse number="9" style="v" />Xittzak'u'nju' Kyeq Ninnjab' ex kyejten b'e tzqij toj.</para>
  <para style="q">Eb'jik'x tiq'i'n, t-xexi' ninnjab'</para>
  <para style="q">kse'n toj chq'ajlaj.</para>
  <para style="q">
    <verse number="10" style="v" />Ikytzu'n e'tkola' kyeju' kyajq'oj,</para>
  <para style="q">te kyipumalju' ntoq walti'j kyk'u'j kyi'j.</para>
  <para style="q">
    <verse number="11" style="v" />Eb'ajkyaj mulq'aju' kyajq'oj tjaq' ninnjab'</para>
  <para style="q">ex mixti'xte jun kyej anq'in.</para>
  <para style="q">
    <verse number="12" style="v" />Atzuntzu' xa'kyoksla'na' tyol Qman Dyos ojetoq kyej ttziya'n kye</para>
  <para style="q">ex jawkyajwali'n tu'n b'itz.</para>
  <para style="b" />
  <para style="q">
    <verse number="13" style="v" />Lwiyxi'xtzun ik'kyna'lju' tb'inchb'en Dyos kyu'n,</para>
  <para style="q">ex min kyxima tu'n telkynik' ti'ju' tb'is tk'u'j Dyos.</para>
  <para style="q">
    <verse number="14" style="v" />Kub' kyq'o'n Qman Dyos toj joyb'ilti'j</para>
  <para style="q">toj chq'ajlaj,</para>
  <para style="q">e'ok-il ti'j tu'n tb'inchanteju' kyajb'il.</para>
  <para style="q">
    <verse number="15" style="v" />Atzunte Qman Dyos tzaj tq'o'nju' ntoq kyqani'n,</para>
  <para style="q">ex tzaj tq'o'n jun yab'il te b'iyol kyi'j.</para>
  <para style="b" />
  <para style="q">
    <verse number="16" style="v" />Tzaj tx'a'lti'j kyk'u'j ti'j Moyses toju' kyxmuj,</para>
  <para style="q">ex ikx ti'j Aaron, ju' xjansa'n tu'n Qman Dyos.</para>
  <para style="q">
    <verse number="17" style="v" />Xi'tzun k'ab'chaj tx'otx'tz ex xiqoptz'aj Datan toj,</para>
  <para style="q">kyuk'i'lxi' jun k'loj xjal mujlikytzi tuk'i'l Ab'iram.</para>
  <para style="q">
    <verse number="18" style="v" />¡Ojexi'x k'antju' q'aq' kyi'j kykyaqil!</para>
  <para style="q">¡Majx eb'aj tz'e'yju' b'inchal myab'a'n!</para>
  <para style="b" />
  <para style="q">
    <verse number="19" style="v" />Kub' kyb'incha'n jun tilb'ilal tman wakx t-xeju' witz Oreb',</para>
  <para style="q">jun witzileb' q'anpwaq b'incha'n toj q'aq', e' k'uluntzuntz twitz:</para>
  <para style="q">
    <verse number="20" style="v" />¡kych'exb'eju' Dyos nim tajwalil</para>
  <para style="q">tuk'i'l tilb'ilal jun wakx nwan k'ul!</para>
  <para style="q">
    <verse number="21" style="v" />Ik'tna'l Qman Dyos kyu'n, ju' klol kye,</para>
  <para style="q">extzun ojetoq che tb'incha nimaq techlal toj Ejipt,</para>
  <para style="q">
    <verse number="22" style="v" />Ojetoq che tb'incha nim ti'xti' tb'anilqexi'x toj tx'otx' Kam</para>
  <para style="q">ex e'ti'xti' te lab'te'n toju' Kyeq Ninnjab'.</para>
  <para style="q">
    <verse number="23" style="v" />Tma Qman Dyos tu'n kykub' t-xitu'n;</para>
  <para style="q">atzunte Moyses ju' sk'o'n tu'n, kub'san kyi'j</para>
  <para style="q">we'tzun ttx'u'jil Dyos tu'n,</para>
  <para style="q">ex min e'kub' t-xitu'n.</para>
  <para style="b" />
  <para style="q">
    <verse number="24" style="v" />Yajxi'tzuntel el kyik'o'n jun tx'otx' tb'anilxi'x,</para>
  <para style="q">ex min xikyoksla'nju' ojetoq tma Qman Dyos kye;</para>
  <para style="q">
    <verse number="25" style="v" />e'yolin taq'wix ti'j Qman Dyos kyoj kypach</para>
  <para style="q">ex min xikyb'i'nju' tchaq'b'il.</para>
  <para style="q">
    <verse number="26" style="v" />Jawtzun tiq'i'n Qman Dyos tq'ob' ex majx tma'n kye</para>
  <para style="q">qa oktoq che kb'el tb'yo'n toj chq'ajlaj,</para>
  <para style="q">
    <verse number="27" style="v" />qa oktoq che b'eltb'yo'nju' kyyajajil</para>
  <para style="q">ex oktoq che kxe'l t-slamu'n kyxolju' tnam nche niman kye txqantl dyos.</para>
  <para style="b" />
  <para style="q">
    <verse number="28" style="v" />Eb'jo'k te tmajen k'a'yi'n B'aal-peor,</para>
  <para style="q">ex eb'aj wan ti'ju' chojb'il kub' kyq'o'n kywitzju' dyos mixti' kyimniqe'.</para>
  <para style="q">
    <verse number="29" style="v" />Okkyq'o'n ttx'u'jil Qman Dyos tu'n kyb'inchb'en taq'wix,</para>
  <para style="q">tzajtzun jun tx'u'j yajb'iltzu' kyi'j.</para>
  <para style="q">
    <verse number="30" style="v" />Jawtzun tiq'i'ntib' Pinees ex kub' tb'yo'nju' xjal intoq b'inchan il,</para>
  <para style="q">we'tzun tx'u'j yajb'iltz.</para>
  <para style="q">
    <verse number="31" style="v" />B'a'n ela'ju' tb'incha toj twitz Dyos,</para>
  <para style="q">intzaj tna'n kukxju' atl junjun tnej kyyajajil nche b'jik'.</para>
  <para style="b" />
  <para style="q">
    <verse number="32" style="v" />Ex okkyq'o'n ttx'u'jil Qman Dyos</para>
  <para style="q">ttziju' a' Merib'a,</para>
  <para style="q">tu'ntzun kypaj</para>
  <para style="q">toq'wix kyaja' Moyses,</para>
  <para style="q">
    <verse number="33" style="v" />qu'n tzaj ttx'u'jil Moyses tu'n kpaj</para>
  <para style="q">ex min ximan kyi'ju' tyol e'tma.</para>
  <para style="b" />
  <para style="q">
    <verse number="34" style="v" />Min e'kub' kyxitu'nju' tnam</para>
  <para style="q">ju' tchaq' Qman Dyos kye tu'n kyxitet.</para>
  <para style="q">
    <verse number="35" style="v" />B'ajxpe' kysmo'nkyib',</para>
  <para style="q">kyuk'i'lju' nche niman kye txqantl dyos</para>
  <para style="q">ex b'je'l kykno'nju' intoq kyb'incha'n:</para>
  <para style="q">
    <verse number="36" style="v" />ek'ulun kywitzju' kywitzileb' txqantl tnam</para>
  <para style="q">Qu'mtzun ekub'a' xitu'n,</para>
  <para style="q">
    <verse number="37" style="v" />e'xikyq'o'n kyk'wal ex kymyal</para>
  <para style="q">te chojb'il kyeju' tajaw il lu.</para>
  <para style="q">
    <verse number="38" style="v" />Kub' kyqo'n kychk'elju' mixti' kyil,</para>
  <para style="q">kychk'elju' kyk'wal ex kymyal,</para>
  <para style="q">ex kub' kyq'o'n te chojb'il kywitz witzileb' toj Kanaan.</para>
  <para style="q">B'aj txa'jju' tx'otx' lu toj chik',</para>
  <para style="q">
    <verse number="39" style="v" />eb'aj tz'ilix ex e'ok ajpajil twitz Dyos</para>
  <para style="q">tu'n kpaju' kyb'inchb'en myab'a'n.</para>
  <para style="b" />
  <para style="q">
    <verse number="40" style="v" />Tzaj ttx'u'jil Qman Dyos kyi'ju' ttanam,</para>
  <para style="q">ex eb'je'l t-suchu'nju' teqe';</para>
  <para style="q">
    <verse number="41" style="v" />E'kyaj tkolb'e'n toj kyq'ob'ju' nche niman kye txqantl dyos,</para>
  <para style="q">ex kub'kyi'j kyu'n kyajq'oj;</para>
  <para style="q">
    <verse number="42" style="v" />e'kub'jtz'o'n,</para>
  <para style="q">e'kub' yaju'n b'a'nxi'x tjaq' kykawb'ilju' kyajq'oj.</para>
  <para style="q">
    <verse number="43" style="v" />B'a'npun maj e' klonjtz tu'n Qman Dyos,</para>
  <para style="q">aye'tzunkye min xikynima'nju' t-xim</para>
  <para style="q">tu'nxtzunju' kyb'inchb'en myab'a'n ekub'a' yajta'.</para>
  <para style="q">
    <verse number="44" style="v" />Tu'npe'tzunju', tej kytzaj tka'yi'n nche yajti</para>
  <para style="q">ex tej tb'inte nche oq',</para>
  <para style="q">
    <verse number="45" style="v" />tzaj tna'nju' tyol kyej b'entti'j kyuk'i'l</para>
  <para style="q">ex tch'exb'eju' t-xim,</para>
  <para style="q">qu'n nimxi'x tk'u'jlalil kyi'j:</para>
  <para style="q">
    <verse number="46" style="v" />¡tb'incha tu'n ttzaj q'aq'an kyk'u'ju' kyajq'oj kyi'j</para>
  <para style="q">tu'ntzun b'a'nku' kyilwi tu'n!</para>
  <para style="b" />
  <para style="q">
    <verse number="47" style="v" />¡Qo' tkloma Nman Dyos!</para>
  <para style="q">¡Qo' tb'uyitza kyxolu' nimaqtnam</para>
  <para style="q">tu'ntzun qajwalinteju'ye' tb'iya xjan,</para>
  <para style="q">tu'ntzun qajwalinteya toj tzalajb'il!</para>
  <para style="b" />
  <para style="q">
    <verse number="48" style="v" />¡Nimanjtzxwit Qman Dyos, nkyk'lu'n aj Israel,</para>
  <para style="q">toj tkyaqil tab'q'iyil!</para>
  <para style="q">¡Kykyaqilxwit che q'mante: Ikxwitju'!.</para>
  <para style="b" />
  <para style="q">¡Ajwalinjtzxwit Qman Dyos! Chiju' b'itzal.</para>
  <chapter number="107" style="c" />
  <para style="ms">Tjwe'yi'n U'j</para>
  <para style="mr">(E' b'itz <ref loc="PSA 107-150">107—150</ref>)</para>
  <para style="s1">Tk'u'jlalil Qman Dyos kukxju'</para>
  <para style="q">
    <verse number="1" style="v" />Kyq'onx chjonteye' te Qman Dyos, qu'n majx b'a'nte,</para>
  <para style="q">qu'n tejumajxju' tk'u'jlalil.</para>
  <para style="q">
    <verse number="2" style="v" />Kymanxe' aye'ye' matxi' che klete' tu'n Qman Dyos,</para>
  <para style="q">ex matxi' che klonjtze' tjaq' kykawb'il ajq'oj,</para>
  <para style="q">
    <verse number="3" style="v" />aye'ye' ẍetzaj tb'u'yi'n kyoj nimaqtnam</para>
  <para style="q">toj tnayajkya'j ex tb'a'nq'ob'kya'j,</para>
  <para style="q">toj tjawetzq'ij ex tkub'exq'ij.</para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" />Tzpetniqe'toqe' nche b'ete' toj tz'awun toj chq'ajlaj,</para>
  <para style="q">mixtoqti' nknet tb'eyil jun nintnam kyu'ne', jatu'n kyxa'ye' najal;</para>
  <para style="q">
    <verse number="5" style="v" />intoq che q'aq'ane' ex intoq che k'wajtiye',</para>
  <para style="q">¡ch'inxtoq kykyime' tu'n we'yaj!</para>
  <para style="q">
    <verse number="6" style="v" />Ekub'santzuntze' toj k'ixk'oj te Qman Dyos,</para>
  <para style="q">e'klettzuntze' tu'n toju' yajb'il.</para>
  <para style="q">
    <verse number="7" style="v" />E'kub' q'o'ntzuntze' tu'n toj b'a'n b'e</para>
  <para style="q">tu'n kypone' toj jun nintnam, jatu'n kynajana'ye'.</para>
  <para style="b" />
  <para style="q2">
    <verse number="8" style="v" />Kyq'onx chjonteye' te Qman Dyos tu'nju' tk'u'jlalil,</para>
  <para style="q2">¡tu'nju' xtalb'il intb'incha'n kye xjal!</para>
  <para style="q2">
    <verse number="9" style="v" />Qu'n inqe tk'u'ju' nk'wajti tu'n</para>
  <para style="q2">ex nim twaju' nwe'yajti nxitq'o'n.</para>
  <para style="b" />
  <para style="q">
    <verse number="10" style="v" />Najlqe'toqe' toj qlolj,</para>
  <para style="q">intoq che b'isune' ex jtz'o'nqe'toqe' tu'n xpatx'k'uxb'il,</para>
  <para style="q">
    <verse number="11" style="v" />tu'n tpaju' min xikyb'i'ne' tchaq'b'il Qman Dyos,</para>
  <para style="q">tu'nju' b'je'l kysuchu'ne' t-xim Qman Dyos nim toklen.</para>
  <para style="q">
    <verse number="12" style="v" />E'kub' q'o'ne' toj kuw aq'untl tu'n Dyos;</para>
  <para style="q">e'kub' tz'aqe' ex mix-a'lo' oninkyeye' tu'n kyjawe'ye'.</para>
  <para style="q">
    <verse number="13" style="v" />Tojtzun k'ixk'oj ekub'sana'ye' te Qman Dyos,</para>
  <para style="q">e'klettzuntze' tu'n toju' yajb'il;</para>
  <para style="q">
    <verse number="14" style="v" />E'b'je'tz iq'i'ne' tu'n toj qxopin,</para>
  <para style="q">ex e'tzaqpete' tu'n kyeju' xpatx'k'uxb'il.</para>
  <para style="b" />
  <para style="q2">
    <verse number="15" style="v" />Kyq'onx chjonteye' te Qman Dyos tu'nju' tk'u'jlalil,</para>
  <para style="q2">¡tu'nju' xtalb'il ntb'incha'n kye xjal!</para>
  <para style="q2">
    <verse number="16" style="v" />¡E'kub' tpa'nju' tjpel ja q'ank'uxb'ilqe'!</para>
  <para style="q2">¡E'kub' ttoqi'nju' k'uxb'il xtanb'ilkye!</para>
  <para style="q">
    <verse number="17" style="v" />Yab' qe'toqe' tu'n b'is</para>
  <para style="q">tu'nxju' kyb'inchb'ene' myab'a'n ex kyile',</para>
  <para style="q">
    <verse number="18" style="v" />mixtoqti'tl nche wane';</para>
  <para style="q">¡ch'inxtltoq kypone' twitz kamik!</para>
  <para style="q">
    <verse number="19" style="v" />Tojtzunju' k'ixk'oj ekub'sane' te Qman Dyos,</para>
  <para style="q">e'klettzuntze' tu'n toju' yajb'il;</para>
  <para style="q">
    <verse number="20" style="v" />tzaj t-sma'n tyol kyeye' ex eb'anixe' tu'n;</para>
  <para style="q">¡eklete' tu'n teju' kamik!</para>
  <para style="b" />
  <para style="q2">
    <verse number="21" style="v" />Kyq'onx chjonteye' te Qman Dyos tu'nju' tk'u'jlalil,</para>
  <para style="q2">¡tu'nju' xtalb'il ntb'incha'n kye xjal!</para>
  <para style="q2">
    <verse number="22" style="v" />Kyajwali'nktze' te jun chojb'il twitz</para>
  <para style="q2">ex kyolinqe'xju'ye' tb'inchb'en tuk'i'l tzalajb'il.</para>
  <para style="b" />
  <para style="q">
    <verse number="23" style="v" />Aye'ye' xk'aẍlel nche b'ete' tib'aj ninnjab',</para>
  <para style="q">txoli'n kytenju' kyb'arke' toj a'</para>
  <para style="q">
    <verse number="24" style="v" />kyka'yiju'ye' taq'unb'en Qman Dyos tb'anilxi'x</para>
  <para style="q">tib'aj ninnjab'.</para>
  <para style="q">
    <verse number="25" style="v" />Jawb'ent jun nin kyq'iq' tu'n tq'ojq'ojel twi' Qman Dyos</para>
  <para style="q">intoq jaw t-xon nimaq ttolob' ninnjab';</para>
  <para style="q">
    <verse number="26" style="v" />Intoq che jaw xone' twitz kya'j</para>
  <para style="q">ex intoq che ku'x mulq'i'ne' t-xe ninnjab';</para>
  <para style="q">¡majx e'kub'numje' tu'n kyxob'ele'!</para>
  <para style="q">
    <verse number="27" style="v" />Naqxtoq nche woqajlatle' naku'j tx'ujtenil;</para>
  <para style="q">¡mixti'x ajb'ena' kyojtzqib'le'!</para>
  <para style="q">
    <verse number="28" style="v" />Ekub'santzuntze' twitz Qman Dyos toju' kyk'ixk'oje,</para>
  <para style="q">e'klettzuntze' tu'n toju' yajb'il;</para>
  <para style="q">
    <verse number="29" style="v" />naq el lemementlju' q'ankyaq tib'aj a' tu'n,</para>
  <para style="q">ex e'kyaj nak'eju' ttolob' ninnjab'.</para>
  <para style="q">
    <verse number="30" style="v" />Tetzunj kyka'yinteye' tkub' nak'eju' ttolob' ninnjab', eb'aj tzalaje',</para>
  <para style="q">exi' iq'i'ntzuntze' tu'n Dyos ttziju' ninnjab' jatu'n kypona'toqe'.</para>
  <para style="b" />
  <para style="q2">
    <verse number="31" style="v" />Kyq'onx chjonteye' te Qman Dyos tu'nju' tk'u'jlalil,</para>
  <para style="q2">¡tu'nju' xtalb'il ntb'incha'n kye xjal!</para>
  <para style="q2">
    <verse number="32" style="v" />¡Kynimanktze' toju' b'uyjtib'il te tnam!</para>
  <para style="q2">¡Kyajwali'nktze' toju' b'uyjtib'il kye tijwnaq!</para>
  <para style="b" />
  <para style="q">
    <verse number="33" style="v" />Inche b'jawb'ent nin a' ex t-xiklil a' tu'n Qman Dyos</para>
  <para style="q">te chq'ajlaj ex tzqij tx'otx';</para>
  <para style="q">
    <verse number="34" style="v" />intb'incha'n tb'anil tx'otx' te min ntq'o'ntl tawal,</para>
  <para style="q">tu'n tpaj kyilju' xjal najlqe' twitz;</para>
  <para style="q">
    <verse number="35" style="v" />Inche jawb'ent chq'ajlaj tu'n te njab'</para>
  <para style="q">ex t-xiklil a' toj tzqij tx'otx';</para>
  <para style="q">
    <verse number="36" style="v" />atzuntzu' nche kub'tq'o'na' nche we'yajti,</para>
  <para style="q">intzun kub' kyb'incha'n ninkytanamtz toj.</para>
  <para style="q">
    <verse number="37" style="v" />Nb'aj kyaq'una'nju' tx'otx' ex nb'ajx kyawa'n kyawal toj</para>
  <para style="q">ex nim twitz kyawal njaw.</para>
  <para style="q">
    <verse number="38" style="v" />Inche tzaj tky'i'wla'n Qman Dyos ex nchmet kyb'aj</para>
  <para style="q">ex nche chmet kywakyix.</para>
  <para style="q">
    <verse number="39" style="v" />Qatzun mache kyim exqa mako'pju' kyajlal</para>
  <para style="q">tu'n tpaju' b'is,</para>
  <para style="q">k'ixk'oj ex yajb'ilkye,</para>
  <para style="q">
    <verse number="40" style="v" />inche el tik'u'n Qman Dyosu' nchi yajlankye</para>
  <para style="q">nche kub'ttzpet-sa'n toj chq'ajlaj ex min nknetl kyb'e.</para>
  <para style="q">
    <verse number="41" style="v" />Inche etztiq'i'n prow toj b'is;</para>
  <para style="q">¡inche tchmet-sa'n kyk'wal, kse'n jun ch'laj rit!</para>
  <para style="q">
    <verse number="42" style="v" />Inche tzalaju' xjal tnik'alkyi'j ajkyka'yinte ja'lu,</para>
  <para style="q">aye'tzu'n b'inchal myab'a'n in jpet kytzi.</para>
  <para style="b" />
  <para style="q">
    <verse number="43" style="v" />Ati tu'n t-ximanju' xjal ati tnab'l,</para>
  <para style="q">ti'j ja'lu</para>
  <para style="q">ex tu'n tkaneju' tk'u'jlalil Qman Dyos toj twitz. Chiju' b'itzal.</para>
  <chapter number="108" style="c" />
  <para style="s1">Knq'a' wib'e'</para>
  <para style="r">(<ref loc="PSA 57:7-11">Sal 57.7-11</ref>; <ref loc="PSA 60:5-12">60.5-12</ref>)</para>
  <para style="q">
    <verse number="1" style="v" />Nman Dyos, luqine' nchin ayone' teya,</para>
  <para style="q">¡naqnchin ayontle' tu'n kyxi' nb'itza'ne' b'itz!</para>
  <para style="q">qu'n a ntzalajb'ilju'ye';</para>
  <para style="q">
    <verse number="2" style="v" />Kyna'ntzkyib'e' chnab' arpa ex tzintzin;</para>
  <para style="q">¡Kchin jawil we'ye' ajttzaj t-xe kya'j!</para>
  <para style="q">
    <verse number="3" style="v" />Kjawil wajwali'na Nman Dyos kyuk'i'l b'itz,</para>
  <para style="q">kyxol k'ok'e' ex nimaqtnam.</para>
  <para style="q">
    <verse number="4" style="v" />Qu'n nimxi'xju' tk'u'jlalila kyekywitzju' kya'j.</para>
  <para style="q">¡Inpon kanunju' tyola ax, tzmax twitz ẍkul kya'j!</para>
  <para style="q">
    <verse number="5" style="v" />¡Nman Dyos, aya atiya tib'ajxi' kya'j;</para>
  <para style="q">nojni tkyaqil twitz tx'otx' tu'n tajwalila!</para>
  <para style="q">
    <verse number="6" style="v" />Qo' tkloma tu'n tipumala,</para>
  <para style="q">tu'ntzun kykletju' nche tk'u'jla'na.</para>
  <para style="q">¡Qo ttzaq'wetza!</para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" />Tzaj tma'n Dyos tzmaxtzu' toju' tja xjan:</para>
  <para style="q">¡Kb'el waq'pu'ne' Sikyem tuk'i'l tzalajb'il</para>
  <para style="q">ex kxe'l nsipa'nju'ye' b'ya' Sukot!</para>
  <para style="q">
    <verse number="8" style="v" />Weqe'we' Kalaad ex Manases;</para>
  <para style="q">ate Eprayin jun kolb'il tokx toj nwi'ye';</para>
  <para style="q">atzu'n Juda ntzeye' q'ol nchaq'b'ile';</para>
  <para style="q">
    <verse number="9" style="v" />Atzu'n Moab' nk'o'ẍe' te ntx'ajb'ile';</para>
  <para style="q">atzun Edom naqtkb'el nxajab'e';</para>
  <para style="q">¡kchin b'itzale' te kanb'ab'l kyib'aju' pilistey! Chij.</para>
  <para style="b" />
  <para style="q">
    <verse number="10" style="v" />¿Alxi'xkye k'onil weye' tu'n tkub'ti'ju' nintnam jpu'mile ti'j tu'n nimaqtapi?</para>
  <para style="q">¿Alkye kpomil iq'inweye' tzmax toj Edom?</para>
  <para style="q">
    <verse number="11" style="v" />Matxi'na' qo eltik'o'na Nman Dyos;</para>
  <para style="q">¡min nnultla onilkye qxjale' toj q'oj!</para>
  <para style="q">
    <verse number="12" style="v" />Qo tonima toj kyq'ob'ju' qajq'oje',</para>
  <para style="q">qu'n mixti'x tz'oka'te' o'nb'il kyu'n xjal.</para>
  <para style="q">
    <verse number="13" style="v" />Kb'entel nimaq ti'xti' qu'n tu'n tonb'il Qman Dyos;</para>
  <para style="q">¡ate kb'el najsankye' qajq'oj! Chiju' b'itzal.</para>
  <chapter number="109" style="c" />
  <para style="s1">Kub'sb'il twitzju' ajkawil nim toklen</para>
  <para style="q">
    <verse number="1" style="v" />Nman Dyos,</para>
  <para style="q">tzaq'wentzju'ya nna'j Dyose',</para>
  <para style="q">
    <verse number="2" style="v" />qu'n aye' chalyol ex b'inchal myab'a'n</para>
  <para style="q">inche yolin taq'wix wi'je' tuk'i'l chajyolil</para>
  <para style="q">
    <verse number="3" style="v" />Nim txqan kyjk'ujyolil tuk'i'l tx'a'lti'jk'u'jb'aj wi'je';</para>
  <para style="q">¡inche q'ojink wi'je' extzun mixti' wile' kye!</para>
  <para style="q">
    <verse number="4" style="v" />Inche okmiltz'uj wi'je' te t-xelju' nk'u'jlalile' kyi'j;</para>
  <para style="q">ayintzunwe' nchin na'n Dyose'.</para>
  <para style="q">
    <verse number="5" style="v" />Taq'wix xkyb'incha weye', tu'nju' b'a'n xnb'inchaye' kye,</para>
  <para style="q">nchinel kyik'o'ne' te t-xelju' nk'u'jlalile' kyi'j.</para>
  <para style="b" />
  <para style="q">
    <verse number="6" style="v" />Q'onk jun xjala aj ilxi'x te ajkawil kyib'aj,</para>
  <para style="q">ex axwitju' yolil kyi'j poqonkye;</para>
  <para style="q">
    <verse number="7" style="v" />che elxwit yal toj kyil ajkyok toj xjel;</para>
  <para style="q">tu'nxwitju' kyyol te kolb'ilkye che'xa' toj q'aq'.</para>
  <para style="q">
    <verse number="8" style="v" />¡Noqwit jte' q'ijxju' kychwinqlal</para>
  <para style="q">junxi'tlwit kyejten tib'aju' kyq'inumal!</para>
  <para style="q">
    <verse number="9" style="v" />¡Che kyajxwitju' kyk'wal meb'a</para>
  <para style="q">ex che kyajxwitju' kyxu'jil mixti' kychmil!</para>
  <para style="q">
    <verse number="10" style="v" />¡Naqxwit che b'etenje kyk'wal mol najchaq!</para>
  <para style="q">¡Kyajxwitju' kyja naq tik'lentl!</para>
  <para style="q">
    <verse number="11" style="v" />Awtju' q'ol ch'ex medi</para>
  <para style="q">txi'q'inte tkyaqilju' ati kye.</para>
  <para style="q">Junxi'tlwit xjal</para>
  <para style="q">txi' elq'anteju' twitz kyaq'unb'en.</para>
  <para style="q">
    <verse number="12" style="v" />Mixwit alo'x tzaj q'aq'an tk'u'j kyi'j</para>
  <para style="q">ex kyi'ju' kyk'wal meb'aqe'.</para>
  <para style="q">
    <verse number="13" style="v" />Kyejxwitju' kyja mutztelaq,</para>
  <para style="q">kub'xwit naju' kyb'i tejumajx.</para>
  <para style="q">
    <verse number="14" style="v" />Tzajxwit tna'n Qman Dyos myab'a'n xkyb'inchaju' kyman</para>
  <para style="q">mixwit tzik'a' tna'l kyilju' kytxu tu'n;</para>
  <para style="q">
    <verse number="15" style="v" />kukxwit ttzaj na'n kyilju' tu'n Qman Dyos</para>
  <para style="q">mixwit che tzaj na'ntl twitz tx'otx'.</para>
  <para style="b" />
  <para style="q">
    <verse number="16" style="v" />Qu'n mixti'x saj q'aq'an kyk'u'j</para>
  <para style="q">kyi'ju' prow ex kyi'ju' me's ex nche b'isun</para>
  <para style="q">matz'ok kyljo'n toj kyq'ij ex mache kub' kyb'yo'n.</para>
  <para style="q">
    <verse number="17" style="v" />Anatzu' soka' kyxon kyk'u'j ti'ju' taq'wixil, ¡tzajxwittzun q'o'n taq'wixil kyib'aj!</para>
  <para style="q">Matz'el kyik'o'nju' ky'i'wb'il, ¡mixwittzun che tzaja' ky'i'wla'n!</para>
  <para style="q">
    <verse number="18" style="v" />Che ktxet-xwit tu'n myab'a'n kse'n jun xb'alun;</para>
  <para style="q">tz'exwit meq'eq'en toj kywinqil;</para>
  <para style="q">naku'j tu'n aseyt mujqa a'.</para>
  <para style="q">
    <verse number="19" style="v" />¡tz'okxwit te kutxb'ilkye</para>
  <para style="q">ex k'alb'il kyk'u'j!</para>
  <para style="q">
    <verse number="20" style="v" />¡Awttzun tz'e'ysb'il kywitz wajq'oju'ye' tzaj tq'o'n Qman Dyos</para>
  <para style="q">ex kyeju' nche jk'un yol wi'je'!</para>
  <para style="b" />
  <para style="q">
    <verse number="21" style="v" />Atzunta Nman Dyos,</para>
  <para style="q">b'a'nxwit wilwiye' tu'na tu'n tnimanjtzju' tb'iya.</para>
  <para style="q">¡Chin tkloma, noqx tu'nju' tk'u'jlalila!</para>
  <para style="q">
    <verse number="22" style="v" />Prowqine' ex nchin yajtiye',</para>
  <para style="q">matxb'aj k'ixb'i wanmiye',</para>
  <para style="q">
    <verse number="23" style="v" />xi' nkub'aje' kse'n leku'n,</para>
  <para style="q">¡inchinx iqane' tu'n kyq'iq' kse'n jun ẍt'ikt'u'l!</para>
  <para style="q">
    <verse number="24" style="v" />Inche lu'lun nch'ekye' tu'n min nchin wane';</para>
  <para style="q">matxi' tz'okwi'je' tu'nju' min nchin wane'.</para>
  <para style="q">
    <verse number="25" style="v" />¡Matxi' chin okye' te kytzeb'e'tz xjal!</para>
  <para style="q">¡Inche jaw xpak'lin ajntzaj kyka'yi'ne'!</para>
  <para style="b" />
  <para style="q">
    <verse number="26" style="v" />Chin tonima Nman Dyos;</para>
  <para style="q">¡chin tkloma tu'nju' tk'u'jlalila!</para>
  <para style="q">
    <verse number="27" style="v" />Nman Dyos, tz'elxwit kynik',</para>
  <para style="q">qa tu'n tq'ob'a xb'incheta' ja'lu.</para>
  <para style="q">
    <verse number="28" style="v" />B'a'n qama chin b'aj kyyasu'ne',</para>
  <para style="q">naqqa nchin tky'i'wla'nta.</para>
  <para style="q">Che kub'xwit ch'ixwi</para>
  <para style="q">ayintzunwe' chin tzalajele'.</para>
  <para style="q">
    <verse number="29" style="v" />¡Tz'elxwit kych'ixawju' wajq'oje!</para>
  <para style="q">¡Che kub'xwit ẍkyaqax tu'n kych'ixaw!</para>
  <para style="b" />
  <para style="q">
    <verse number="30" style="v" />Kchin q'ol chjonteye' kukxju' te Qman Dyos;</para>
  <para style="q">¡kjawil wajwali'ne' kyxol tnam xjal!</para>
  <para style="q">
    <verse number="31" style="v" />Qu'n inok yolil kyi'ju' prow</para>
  <para style="q">ex nche tklo'n kyeju' poqolkye. Chiju' b'itzal.</para>
  <chapter number="110" style="c" />
  <para style="s1">Intzaj tq'o'n Qman Dyos tipumalju' nimaqkawil</para>
  <para style="q">
    <verse number="1" style="v" />Xitma'n Qman Dyos te Wajawe' kjalu:</para>
  <para style="q">Qeku'ya toj nb'a'nq'ob'e',</para>
  <para style="q">tzmax ajkykub' nq'o'ne' tajq'oja</para>
  <para style="q">tjaq' tqana. Chij.</para>
  <para style="b" />
  <para style="q">
    <verse number="2" style="v" />Ktzajel tq'o'n Qman Dyos ttzeya te kawb'il</para>
  <para style="q">tzmax twi' Syon.</para>
  <para style="q">¡Kawintzuna kyib'aju' tajq'oja!</para>
  <para style="q">
    <verse number="3" style="v" />Kkyq'a'kyib'ju' ttanama tuk'i'la</para>
  <para style="q">toju' tq'ijlalil ajtkanb'ana.</para>
  <para style="q">kywi' witz xjan</para>
  <para style="q">inkuwixa toj tku'xumala atl junjun q'ij,</para>
  <para style="q">kse'n ta'l che'w nkub' ajttzaj t-xe kya'j.</para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" />Oje tma Qman Dyos jun tyol tu'n tb'inchante,</para>
  <para style="q">ex lay tz'anjtzti'tk'u'j, chij kjalu:</para>
  <para style="q">Aya pale tejumajx,</para>
  <para style="q">axtoklenju'ya kse'nte Melkisedek. Chij.</para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" />Atite Qman Dyos toj tb'anq'ob'a;</para>
  <para style="q">che b'elt-xitu'n nimaqkawil toju' q'ij ajttzaj ttx'u'jil;</para>
  <para style="q">
    <verse number="6" style="v" />kb'el ttz'e'ysa'n kywitzju' nimaqtnam;</para>
  <para style="q">nim txqan xjal che kb'el tb'yo'n;</para>
  <para style="q">¡kb'el tpa'n kywi'ju' xjal toj tkyaqil twitz tx'otx'!</para>
  <para style="q">
    <verse number="7" style="v" />Kk'wal ti'j jun a' toj b'e,</para>
  <para style="q">tu'ntzu'n a' k'okyelxi'x tipumal. Chiju' b'itzal.</para>
  <chapter number="111" style="c" />
  <para style="s">1 Ajwalb'ilkye tb'inchb'en Dyos</para>
  <para style="q">
    <verse number="1" style="v" />¡Ajwalinjtzxwit Qman Dyos!</para>
  <para style="b" />
  <para style="q">Kwajwali'ye' Qman Dyos tu'n tkyaqil nk'u'je'</para>
  <para style="q">toju' b'uyjtib'il kyeju' xjal tnik'alkyi'j,</para>
  <para style="q">toj tkyaqilju' tnam.</para>
  <para style="q">
    <verse number="2" style="v" />Nimaq kyoklenju' tb'inchb'en Qman Dyos,</para>
  <para style="q">aye'tzu'n nche k'u'jlante inche ximan ti'j.</para>
  <para style="q">
    <verse number="3" style="v" />Tb'anilxi'xju' tb'inchb'en ex nim toklen,</para>
  <para style="q">ex majx atiju' tnik'alti'j ntb'incha'n.</para>
  <para style="q">
    <verse number="4" style="v" />Che tzajel na'nju' tb'inchb'en tb'anilxi'x kukxju'.</para>
  <para style="b" />
  <para style="q">Inlaqjte Qman Dyos tk'u'j ex che'w tk'u'j;</para>
  <para style="q">
    <verse number="5" style="v" />intzaj tq'o'n kywaju' nche niman te;</para>
  <para style="q">¡min in ik'tna'lju' tyol kyejni b'entti'j!</para>
  <para style="q">
    <verse number="6" style="v" />Tzaj tyek'u'n tipumal teju' ttanam,</para>
  <para style="q">tej tel ti'n kytx'otx'ju' witzleb'il ex tzaj tq'o'n kye.</para>
  <para style="q">
    <verse number="7" style="v" />Tu'me'lte' ntb'incha'n ex ax;</para>
  <para style="q">b'a'n tu'n tokqe qk'u'j kyi'ju' tchaq'b'il,</para>
  <para style="q">
    <verse number="8" style="v" />qu'n majx ate'qe' toj tkyaqil tab'q'iyil</para>
  <para style="q">b'incha'nqe' txoli'nxi'xkyi'j ex ax qe'.</para>
  <para style="q">
    <verse number="9" style="v" />E'ttzaqpiju' ttanam</para>
  <para style="q">kyej tq'o'nxi'xju' tyol kyejni b'entti'j tejumajx.</para>
  <para style="q">Xjante' Qman Dyos ex xob'ajilx.</para>
  <para style="b" />
  <para style="q">
    <verse number="10" style="v" />Ate nimaq nab'lju' qama qnima Qman Dyos;</para>
  <para style="q">aye'ju' nche niman te, ati kynab'l.</para>
  <para style="q">¡K'ajwali'njtzel te Qman Dyos kukxju'! Chiju' b'itzal.</para>
  <chapter number="112" style="c" />
  <para style="s1">Ttzalajb'ilju' xjal tnik'alti'j</para>
  <para style="q">
    <verse number="1" style="v" />¡Ajwalinjtzxwit Qman Dyos!</para>
  <para style="b" />
  <para style="q">Tzalajb'ilte' teju' xjal nniman te Qman Dyos</para>
  <para style="q">ex ntzalaj tu'n kyjapu'nju' tchaq'b'il tu'n.</para>
  <para style="q">
    <verse number="2" style="v" />Che k'i'wlanjtzel tyajajil</para>
  <para style="q">ex ktenb'el kyipumal twitzju' tx'otx'.</para>
  <para style="q">
    <verse number="3" style="v" />Nim q'inumal ati toju' tja,</para>
  <para style="q">ex kukx tb'inchan xtalb'ilju'.</para>
  <para style="q">
    <verse number="4" style="v" />Ink'ant jun spik'un toj qlolj</para>
  <para style="q">kyeju' xjal tnik'alkyi'j,</para>
  <para style="q">kyeju' nlaqj kyk'u'j, che'w kyk'u'j ex tnik'alkyi'j.</para>
  <para style="q">
    <verse number="5" style="v" />Aju' b'a'n xjal inq'on ch'ex tu'n tkyaqil tk'u'j</para>
  <para style="q">ex toj tu'me'l nche tb'incha'na' taq'un;</para>
  <para style="q">
    <verse number="6" style="v" />qu'mtzun milo kb'ela' tz'aq.</para>
  <para style="q">¡Ktzajel na'nju' xjal tnik'alti'j kukxju'!</para>
  <para style="q">
    <verse number="7" style="v" />Min nxob' ajtb'inte jun tpakb'alil toq'wix,</para>
  <para style="q">q'uqlixi'x tk'u'j ti'j Qman Dyos.</para>
  <para style="q">
    <verse number="8" style="v" />Q'uqlixi'x tk'u'j; min nxob',</para>
  <para style="q">expe' naq ntze'n kyi'ju' tajq'oj ajkyxi' tka'yi'n.</para>
  <para style="q">
    <verse number="9" style="v" />In oyin kye prow,</para>
  <para style="q">kukx tb'inchan xtalb'ilju',</para>
  <para style="q">majx oksla'n ex njaw nima'n.</para>
  <para style="q">
    <verse number="10" style="v" />Inxi'x ku'xtwantib'ju' b'inchal myab'a'n aj txi' tka'yi'n;</para>
  <para style="q">naqxi'x nkuttx'a'n t-xe twitzte ajtkub'aj toj ttx'u'jil.</para>
  <para style="q">Lay japunte' npon kyk'u'ju' b'inchal myab'a'n ti'j. Chiju' b'itzal.</para>
  <para style="q">Ajwalb'ilte t-xtalb'il Qman Dyos.</para>
  <chapter number="113" style="c" />
  <para style="q">
    <verse number="1" style="v" />¡Ajwalinjtzxwit Qman Dyos!</para>
  <para style="q">¡Knima'nktze' tb'i! aye'ye' nche ajb'ene' te.</para>
  <para style="b" />
  <para style="q">
    <verse number="2" style="v" />¡Ajwalinjtzxwit tb'i Qman Dyos</para>
  <para style="q">ja'lo ex tejumajx!</para>
  <para style="q">
    <verse number="3" style="v" />¡Ajwalinjtzxwit tb'i Qman Dyos</para>
  <para style="q">tzajx tjawetzq'ij ponx tkub'exq'ij!</para>
  <para style="q">
    <verse number="4" style="v" />Atite Qman Dyos kyib'aj kykyaqil nimaqtnam;</para>
  <para style="q">¡tib'ajxi' kya'j ta'ju' tajwalil!</para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" />Alxi'xkye jun ikwitju' kse'n Dyos Manb'aj,</para>
  <para style="q">ju' nkawin tzmax toj kya'j;</para>
  <para style="q">
    <verse number="6" style="v" />exwittzun nkub' tzipe</para>
  <para style="q">tu'n tka'yinteju' kya'j ex tx'otx'.</para>
  <para style="q">
    <verse number="7" style="v" />Inetz tiq'i'n Qman Dyos prow toj yajb'il,</para>
  <para style="q">ex njaw tiq'i'n tal xjal mixti' ati te</para>
  <para style="q">
    <verse number="8" style="v" />Nnokxtq'o'ntzuntz kyxolju' xjal nimaq kyoklen,</para>
  <para style="q">kyxolju' nimaq kyoklen toju' ktanam.</para>
  <para style="q">
    <verse number="9" style="v" />Exju' qya min nalan</para>
  <para style="q">inxitq'o'n ttzalajb'il te tu'n tok te txub'aj</para>
  <para style="q">tu'n ttzalaj kyuk'i'lku' toj tja.</para>
  <para style="b" />
  <para style="q">¡Ajwalinjtzxwit Qman Dyos! Chiju' b'itzal.</para>
  <chapter number="114" style="c" />
  <para style="s1">Nab'ab'lteju' kyetzlen aj Israel toj Ejipt</para>
  <para style="q">
    <verse number="1" style="v" />Tej kyetz aj Israel, ju' tk'wal Jakob',</para>
  <para style="q">toj Ejipt, junxi'tl tnam,</para>
  <para style="q">
    <verse number="2" style="v" />Ok Juda te ja xjan te Dyos;</para>
  <para style="q">atzu'n Israel ok tjaq' tkawb'il.</para>
  <para style="b" />
  <para style="q">
    <verse number="3" style="v" />El oqju' ninnjab' tej tka'yinte kxi'toq kypon aj Israel,</para>
  <para style="q">exju' nin a' Jordan anjti'j ti'jxi'.</para>
  <para style="q">
    <verse number="4" style="v" />¡Eb'aj xlik'punju' witz exqe' nimaq k'ul</para>
  <para style="q">naku'j ritqe' ex nakuqe'j qpoj tman rit!</para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" />¿Titi' b'ajteya ninnjab' tu'nju' el oqa?</para>
  <para style="q">¿titi' iq'ina Jordan tu'nju' anj ti'ja ti'jxi'ya?</para>
  <para style="q">
    <verse number="6" style="v" />¿Titi' b'ajkyeye' witz ex nimaq k'ul,</para>
  <para style="q">tu'n e'jaw xlik'pune' kse'nqe' rit ex qpoj tman rit?</para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" />¡Kux tjaw lu'luna tx'otx',</para>
  <para style="q">twitz Qman Dyos, ja k'uluna' Jakob'!</para>
  <para style="q">
    <verse number="8" style="v" />¡Etz tnimal a' tu'n toj pik!</para>
  <para style="q">¡E'okju' pik tu'n te kyxiklil a'! Chiju' b'itzal.</para>
  <chapter number="115" style="c" />
  <para style="s1">Toj kya'j ta' Qman Dyos</para>
  <para style="q">
    <verse number="1" style="v" />Nman Dyos,</para>
  <para style="q">nimsa'nktzju'ya tb'iya ex myaqo'ye';</para>
  <para style="q">¡nimsa'nktztib'a, tu'nju' tk'u'jlalila exju' tyola ax!</para>
  <para style="q">
    <verse number="2" style="v" />Tu'ntzun lalun kyma ma' nimal txqantl dyos:</para>
  <para style="q">¿jata' Kydyose'? Chechiwt</para>
  <para style="q">
    <verse number="3" style="v" />Toj kya'j ta'qe' Qdyos;</para>
  <para style="q">tkyaqilju' b'a'n toj twitz oje tb'incha.</para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" />Aye'tzu'n kywitzleb' txqantl tnam q'anpwaq ex saqpwaqqe',</para>
  <para style="q">b'incha'nqe' kyu'n xjal:</para>
  <para style="q">
    <verse number="5" style="v" />ati kytzi extzun min nb'ent kyyolin;</para>
  <para style="q">ati kywitz extzun min nb'ent kyka'yin;</para>
  <para style="q">
    <verse number="6" style="v" />ati kyẍkyin extzun min nche b'in;</para>
  <para style="q">ati kytxa'n extzun min nb'ent kysiqun;</para>
  <para style="q">
    <verse number="7" style="v" />ati kyq'ob' extzun min nb'ent kytzuyun;</para>
  <para style="q">ati kyqan extzun min nb'ent kyb'et;</para>
  <para style="q">¡mixti'x jun tq'ojq'ojel yol nnetz toj kytzi!</para>
  <para style="q">
    <verse number="8" style="v" />Ikyqe'xtzun xjalju'</para>
  <para style="q">aye' nche kub' b'inchankye</para>
  <para style="q">exqe'ju' nche niman kye.</para>
  <para style="b" />
  <para style="q">
    <verse number="9" style="v" />¡Qek kyk'u'je' ti'j Qman Dyos, aj Israel!.</para>
  <para style="q2">Qu'n ate nnoninqe ex nklonqe.</para>
  <para style="q">
    <verse number="10" style="v" />¡E' pale, qek kyk'u'je' ti'j Qman Dyos!</para>
  <para style="q2">Qu'n ate nnoninqe ex nklonqe.</para>
  <para style="q">
    <verse number="11" style="v" />¡Qek kyk'u'je' ti'j Qman Dyos, aye'ye' nche nimane' te!</para>
  <para style="q2">Qu'n ate nnoninqe ex nklonqe.</para>
  <para style="b" />
  <para style="q">
    <verse number="12" style="v" />¡Matxi' qotzaj tna'n Qman Dyos</para>
  <para style="q">qo kb'el tky'i'wla'n!</para>
  <para style="q">Che kb'el tky'i'wla'n aj Israel,</para>
  <para style="q">che kb'el tky'i'wla'nju' pale,</para>
  <para style="q">
    <verse number="13" style="v" />che kb'el tky'i'wla'nju' nche niman te,</para>
  <para style="q">eb'o's ex nimaq.</para>
  <para style="b" />
  <para style="q">
    <verse number="14" style="v" />¡Chmet-xwitju' kyyajajile' tu'n Qman Dyos</para>
  <para style="q">ex kyyajajilju' kyk'wale'!</para>
  <para style="q">
    <verse number="15" style="v" />¡Che tzajxwit ky'i'wla'ne'</para>
  <para style="q">tu'n Qman Dyos b'inchante kya'j ex tx'otx'!</para>
  <para style="b" />
  <para style="q">
    <verse number="16" style="v" />Tete' Qman Dyos kya'j,</para>
  <para style="q">ex tzaj tq'o'nju' tx'otx' kyeju' xjal.</para>
  <para style="q">
    <verse number="17" style="v" />Aye'tzu'n oje che kyim</para>
  <para style="q">aye' oje cheponj toj kynajb'il kyimni, lay b'ent kyniman te Qman Dyos;</para>
  <para style="q">
    <verse number="18" style="v" />ayo'tzunqe, kqajwali'</para>
  <para style="q">te ja'lo ex tejumajx.</para>
  <para style="b" />
  <para style="q">¡Ajwalinjtzxwit Qman Dyos! Chiju' b'itzal.</para>
  <chapter number="116" style="c" />
  <para style="s1">Na'j Dyos aq'b'il chjonte</para>
  <para style="q">
    <verse number="1" style="v" />In nk'u'jla'ne' Qman Dyos, qu'n matxi' che tzaj tb'i'nju' nkub'sb'ile',</para>
  <para style="q">
    <verse number="2" style="v" />qu'n machin tzajtb'i'ne'.</para>
  <para style="q">¡Kchin kub'sale' te toj tkyaqil nchwinqlale'!</para>
  <para style="q">
    <verse number="3" style="v" />Tej nna'nteye' tipumal kamik,</para>
  <para style="q">tzaj k'ixk'oj wi'je' ex nb'isune'</para>
  <para style="q">ex njaw xob'e' teju' muqb'il.</para>
  <para style="q">
    <verse number="4" style="v" />Tzajtzun nna'ne' tb'i Qman Dyos</para>
  <para style="q">xinkub'sa'ne' te tu'n tklonte nchwinqlale'.</para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" />Tnik'alte Qman Dyos ti'j ex in q'aq'an tk'u'j;</para>
  <para style="q">che'wte Qman Dyos tk'u'j.</para>
  <para style="q">
    <verse number="6" style="v" />Xq'uqi'n qekye' mixti' kyoklen tu'n Qman Dyos.</para>
  <para style="q">Intkole' tej mixtoqti' wipumale'.</para>
  <para style="q">
    <verse number="7" style="v" />oktzun qeb'el nk'u'je' ja'lo</para>
  <para style="q">qu'n majx b'a'nte Qman Dyos weye',</para>
  <para style="q">
    <verse number="8" style="v" />qu'n machin tkole' te kamik,</para>
  <para style="q">min xtaj tu'n woq'e' ex tu'n nkub' tz'aqe'.</para>
  <para style="q">
    <verse number="9" style="v" />Chin nimale' te Qman Dyos</para>
  <para style="q">kyxolju' xjal twitz tx'otx'.</para>
  <para style="b" />
  <para style="q">
    <verse number="10" style="v" />Ati toqwe' wokslab'l</para>
  <para style="q">tu'npetzu'n intoq nma'ne' qa nimtoq yajb'il wi'je'.</para>
  <para style="q">
    <verse number="11" style="v" />Intoq chin b'isune'</para>
  <para style="q">nmaye' qa kykyaqil xjal chalyolqe'.</para>
  <para style="b" />
  <para style="q">
    <verse number="12" style="v" />¿Ti'xi'xti' kxe'l nq'o'ne' te Qman Dyos</para>
  <para style="q">te tu'me'l t-xel tkyaqilju' b'a'n matxi' tb'incha weye'?</para>
  <para style="q">
    <verse number="13" style="v" />¡Kjawil nnima'ne' Qman Dyos qu'n machin tkole'</para>
  <para style="q">ex chin kub'sale' toj tb'i!</para>
  <para style="q">
    <verse number="14" style="v" />Che nb'incha'ye' nyole' xi'ni ntziya'ne' te Qman Dyos</para>
  <para style="q">kwitz kykyaqilju' ttanam.</para>
  <para style="b" />
  <para style="q">
    <verse number="15" style="v" />Nimte' toklen toj twitz Qman Dyos</para>
  <para style="q">ajkykyimju' nche niman te.</para>
  <para style="q">
    <verse number="16" style="v" />¡Nman Dyos, tmajen qina!</para>
  <para style="q">¡Ayine' talju' tmajena qya!</para>
  <para style="q">B'je'l tlaqu'na aqwil k'lo'nqintoqe' toj.</para>
  <para style="q">
    <verse number="17" style="v" />Kxe'l nq'o'ne' chojb'il te aq'b'il chjonte teya,</para>
  <para style="q">ex chin kub'sale' toj tb'iya Nman Dyos.</para>
  <para style="q">
    <verse number="18" style="v" />Che japumelju' nyole' xi'ni ntziya'ne' te Qman Dyos</para>
  <para style="q">kywitz tkyaqilju' ttanam,</para>
  <para style="q">
    <verse number="19" style="v" />twi' tpenju' tja Qman Dyos</para>
  <para style="q">¡tnk'ejchaqila Jerusalen!</para>
  <para style="b" />
  <para style="q">¡Ajwalinjtzxwit Qman Dyos! Chiju' b'itzal.</para>
  <chapter number="117" style="c" />
  <para style="s1">B'itz te Qman Dyos</para>
  <para style="q">
    <verse number="1" style="v" />Che b'itzan qe'ye' te Qman Dyos,</para>
  <para style="q">kykyaqile' nimaqtnam ex k'ok'e'tnam,</para>
  <para style="q">
    <verse number="2" style="v" />qu'n nimxi'xju' tk'u'jlalil qi'j;</para>
  <para style="q">¡exju' tyol ax njapun tejumajx!</para>
  <para style="b" />
  <para style="q">¡Ajwalinjtzxwit Qman Dyos! Chiju' b'itzal.</para>
  <chapter number="118" style="c" />
  <para style="s1">Nimxi'x tipumal Qman Dyos</para>
  <para style="q">
    <verse number="1" style="v" />Kyq'onx chjonteye' te Qman Dyos, qu'n majx b'a'n te,</para>
  <para style="q">qu'n tejumajxju' tk'u'jlalil.</para>
  <para style="q">
    <verse number="2" style="v" />Kymame' aj Israel:</para>
  <para style="q2">Tejumajxte' tk'u'jlalil Qman Dyos. Chechiku'ye'.</para>
  <para style="q">
    <verse number="3" style="v" />Kymame' pale:</para>
  <para style="q2">Tejumajxte' tk'u'jlalil Qman Dyos. Chechiku'ye'.</para>
  <para style="q">
    <verse number="4" style="v" />Kymame' aye'ye' nkynima'ne' Qman Dyos:</para>
  <para style="q2">Tejumajxte' tk'u'jlalil Qman Dyos. Chechiku'ye'.</para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" />Inkub'sane' te Qman Dyos tej nchin b'isune';</para>
  <para style="q">intzaj tb'i'ne' ex inttzaqpiye'.</para>
  <para style="q">
    <verse number="6" style="v" />Ati te Qman Dyos wuk'i'le'; min nchin xob'e'.</para>
  <para style="q">¿Titi' ktb'incha'ju' xjal wi'je'?</para>
  <para style="q">
    <verse number="7" style="v" />Ati te Qman Dyos wuk'i'le'; inchin toni'ne'.</para>
  <para style="q">¡Knka'yiye' ajtkub'kyi'ju' ntx'a'lti' kyk'u'j wi'je'!</para>
  <para style="q">
    <verse number="8" style="v" />Ate b'a'nju' tu'n tokqe qk'u'j ti'j Qman Dyos</para>
  <para style="q">kyetwitz tu'n tokqe qk'u'j ti'j jun xjal.</para>
  <para style="q">
    <verse number="9" style="v" />Ate b'a'nju' tu'n tokqe qk'u'j ti'j Qman Dyos</para>
  <para style="q">kyetwitz tu'n tokqe qk'u'j kyi'j nimaqxjal.</para>
  <para style="b" />
  <para style="q">
    <verse number="10" style="v" />Kkytxoli'kyib' kykyaqilju' nimaqtnam wi'je',</para>
  <para style="q">ma'tzun kub'kyi'j wu'ne' toj tb'i Qman Dyos.</para>
  <para style="q">
    <verse number="11" style="v" />Okkytxoli'nkyib' wi'je' toj tkyaqil plaj,</para>
  <para style="q">extzun makub'kyi'j wu'ne' toj tb'i Qman Dyos.</para>
  <para style="q">
    <verse number="12" style="v" />Okkytxoli'nkyib' wi'je' naku'j secha'lqe',</para>
  <para style="q">ex lwiy kub' maytz'aju' kytx'u'jil kse'n tq'aq'al tzqij ch'i'x;</para>
  <para style="q">¡kub'kyi'j wu'ne' toj tb'i Qman Dyos!</para>
  <para style="q">
    <verse number="13" style="v" />Inxi' kylmo'ne' tu'n kytx'u'jil tu'n nkub' tz'aqe',</para>
  <para style="q">atzunte Qman Dyos ul onilweye'.</para>
  <para style="q">
    <verse number="14" style="v" />Inchin b'itzane' te Qman Dyos, intzaj q'onte wipumale'.</para>
  <para style="q">¡Ate klol weye'!</para>
  <para style="b" />
  <para style="q">
    <verse number="15" style="v" />Inche b'itzanju' xjal tnik'alkyi'j</para>
  <para style="q">tu'n kytzalajb'il tojile kyja, qu'n mache kanb'an:</para>
  <para style="q">¡Makub'kyi'j ajq'oj tu'n tipumal Qman Dyos!</para>
  <para style="q">
    <verse number="16" style="v" />¡Nimxi'x toklenju' tipumal Qman Dyos!</para>
  <para style="q">¡Kub'kyi'ju' ajq'oj tu'n tipumal Qman Dyos! Chechij.</para>
  <para style="q">
    <verse number="17" style="v" />¡Lay chin kyimnaje', chin anq'ilwe'</para>
  <para style="q">tu'n txi' nchik'b'a'nju'ye' xtb'incha Qman Dyos!</para>
  <para style="q">
    <verse number="18" style="v" />Makub' ttz'e'ysa'n Qman Dyos nwitze' kuw,</para>
  <para style="q">mixtzunti' xtaj tu'n nkyimnaje'.</para>
  <para style="b" />
  <para style="q">
    <verse number="19" style="v" />¡Kyjqome' tja Qman Dyos,</para>
  <para style="b" />
  <para style="q">wajb'ile' tu'n wokxe' q'ol chjonte te!</para>
  <para style="b" />
  <para style="q">
    <verse number="20" style="v" />A ttzi tja Qman Dyos ja'lu,</para>
  <para style="q">ja che okyixa' tnik'alkyi'j.</para>
  <para style="b" />
  <para style="q">
    <verse number="21" style="v" />Chjonte teya Taye, qu'n machin tzaj ttzaq'we'na</para>
  <para style="q">ex machin tkola.</para>
  <para style="q">
    <verse number="22" style="v" />Matxi' jawb'entju' ab'j kyej kysuchu'n b'inchal ja</para>
  <para style="q">te ab'j nim toklen.</para>
  <para style="q">
    <verse number="23" style="v" />Matb'incha Qman Dyos ja'lu,</para>
  <para style="q">ex lab'te'nxi'xte' ja'lu.</para>
  <para style="q">
    <verse number="24" style="v" />A q'ij ju'lu tb'inchante Qman Dyos:</para>
  <para style="q">¡qo'qe'tzun tzalaj toj ja'lo!</para>
  <para style="b" />
  <para style="q">
    <verse number="25" style="v" />Nman Dyos, b'inchama xtalb'il, ¡qo' tkloma!</para>
  <para style="q">Taye, b'inchama xtalb'il, ¡tu'n qtene' b'a'n!</para>
  <para style="b" />
  <para style="q">
    <verse number="26" style="v" />¡K'i'wla'nte' tzul toj tb'i Qman Dyos!</para>
  <para style="q">Inxi' qqani'ne' b'a'n kyib'aje' tzmaxtzu' toj tja Qman Dyos.</para>
  <para style="q">
    <verse number="27" style="v" />Ate Dyosju' Dyos Manb'aj ¡intzaj tq'o'n spik'un qe!</para>
  <para style="q">kynk'um kyib'e' tuk'i'l tq'ob' tze toj kyq'ob'e'</para>
  <para style="q">tzmajx ajkypone' tk'etz q'olb'eb'l.</para>
  <para style="b" />
  <para style="q">
    <verse number="28" style="v" />Chjonte teya Nman Dyos,</para>
  <para style="q">kjawil nnima'nju'ye' toklena, qu'n aya Dyos.</para>
  <para style="q">
    <verse number="29" style="v" />Kyq'onx chjonteye' te Qman Dyos, qu'n majx b'a'n te,</para>
  <para style="q">qu'n tejumajxju' tk'u'jlalil. Chiju' b'itzal.</para>
  <chapter number="119" style="c" />
  <para style="s1">B'itz ti'ju' tkawb'il Dyos</para>
  <para style="s2">Tnejel</para>
  <para style="q">
    <verse number="1" style="v" />Tzalajb'ilte' kyeju' xjal min nche b'inchan il</para>
  <para style="q">ex nkyb'incha'n kse'nx t-xnaq'tzb'il Qman Dyos.</para>
  <para style="q">
    <verse number="2" style="v" />Tzalajb'ilte' kyeju' nche japun tchaq'b'il Qman Dyos kyu'n</para>
  <para style="b" />
  <para style="q">ex nche jyon ti'j tu'n tkyaqil kyk'u'j,</para>
  <para style="q">
    <verse number="3" style="v" />aye' min nche b'inchan myab'a'n,</para>
  <para style="q">aye' nche b'et toju' tb'eyil Dyos.</para>
  <para style="q">
    <verse number="4" style="v" />Tzaj tab'tzi'nxi'xa</para>
  <para style="q">tu'n tjapunju' tchaq'b'ila ilxi'xti'j.</para>
  <para style="q">
    <verse number="5" style="v" />¡Chin b'et-xwite' b'a'n!</para>
  <para style="q">tu'n kyxinnima'ne' tkawb'ila.</para>
  <para style="q">
    <verse number="6" style="v" />Lay chin ch'ixwiye'</para>
  <para style="q">ajkyxi nnima'ne' tkyaqilju' tchaq'b'ila.</para>
  <para style="q">
    <verse number="7" style="v" />Chin b'itzale' teya tu'n tkyaqil nk'u'je'</para>
  <para style="q">ajkykaneju' tchaq'b'ila tz'aqliqe'xi'x toj nwitze'.</para>
  <para style="q">
    <verse number="8" style="v" />¡Wajb'ile' tu'n kyjapun tkawb'ila wu'ne'!</para>
  <para style="q">¡Lalun chin kyej tkolb'e'nch'i'na!</para>
  <para style="s2">Tkab'</para>
  <para style="q">
    <verse number="9" style="v" />¿Titi' ktb'incha'ju' ku'xun tu'n lalun b'inchan il?</para>
  <para style="q">¡Tu'n tanq'in kse'nxju' ntma'n tyola!</para>
  <para style="q">
    <verse number="10" style="v" />In njyo'na tu'n tkyaqil wanmiye';</para>
  <para style="q">lalun taja tu'n tel npa'nwib'e' kyi'ju' tchaq'b'ila.</para>
  <para style="q">
    <verse number="11" style="v" />Matxi' che kyej tenju' tyola toj wanmiye'</para>
  <para style="q">tu'ntzun lalun chin b'inchan ile' twitza.</para>
  <para style="q">
    <verse number="12" style="v" />¡Nimanjtzxwita, Nman Dyos!</para>
  <para style="q">¡Xnaq'tzanqe'tza tkawb'ila weye'!</para>
  <para style="q">
    <verse number="13" style="v" />Kxe'l npakb'a'ne'</para>
  <para style="q">tkyaqilju' tchaq'b'ila intma'na.</para>
  <para style="q">
    <verse number="14" style="v" />Inxi'x chin tzalaje' ajnxilpeye' kyi'ju' tchaq'b'ila,</para>
  <para style="q">kyetwitz kyi'j q'inumal.</para>
  <para style="q">
    <verse number="15" style="v" />Chin ximale' kyi'ju' tnuk'b'ila</para>
  <para style="q">ex k'okyil nxon nk'u'je' ti'ju' tb'eya.</para>
  <para style="q">
    <verse number="16" style="v" />Chin tzalajele' kyi'ju' tkawb'ila</para>
  <para style="q">ex lay tzik'tna'lju' tyola wu'ne'.</para>
  <para style="s2">Toxi'n</para>
  <para style="q">
    <verse number="17" style="v" />¡Q'ontza nchwinqlale' ayine' tmajena!</para>
  <para style="q">¡Kxe'l nnima'nwe' tyola!</para>
  <para style="q">
    <verse number="18" style="v" />Jqomqe'ju'ya nwitze'</para>
  <para style="q">tu'n nka'yinteye' kywitzlalilju' tchaq'b'ila tb'anilqexi'x.</para>
  <para style="q">
    <verse number="19" style="v" />Naq ajb'etunqine' twitzu' tx'otx' lu;</para>
  <para style="q">lalun che kub'tewa'na tchaq'b'ila nwitze'.</para>
  <para style="q">
    <verse number="20" style="v" />Xi' nkub'aje' atl junjun kmuj,</para>
  <para style="q">tu'n nchin elb'aje' tu'n wojtzqinteye' tchaq'b'ila.</para>
  <para style="q">
    <verse number="21" style="v" />Inche ttzak'u'nju'ya txko'n toj kywi' nkynima'n kyib',</para>
  <para style="q">inel kypa'n kyib' kyi'ju' tchaq'b'ila.</para>
  <para style="q">
    <verse number="22" style="v" />Chin tkloma teju' kyq'oj ex kyasb'il,</para>
  <para style="q">qu'n matxi' che'x nb'i'nju'ye' tchaq'b'ila.</para>
  <para style="q">
    <verse number="23" style="v" />Maskye nkyxima'n xjal nimaq kyoklen tu'n kyb'inchan taq'wix wi'je',</para>
  <para style="q">chin ximalwe' kyi'ju' tkawb'ila ayine' tmajena.</para>
  <para style="q">
    <verse number="24" style="v" />Inchin tzalaje' kyu'nju' tchaq'b'ila;</para>
  <para style="q">qu'n nkyq'o'n nnab'le'.</para>
  <para style="s2">Tkyaji'n</para>
  <para style="q">
    <verse number="25" style="v" />Naqch'inxtl nkyime';</para>
  <para style="q">¡Chin twab'a'nktza kse'nxju' yol tzaj ttziya'na!</para>
  <para style="q">
    <verse number="26" style="v" />Matxi' txinma'ne' teya se'n nchin b'eta'ye', ex matxi' chin tzaj ttzaq'we'na.</para>
  <para style="q">¡Xnaq'tzanqe'tzju'ya tkawb'ila weye'!</para>
  <para style="q">
    <verse number="27" style="v" />Q'ontza nnab'le' tu'n nxilpeye' kyi'ju' tchaq'b'ila,</para>
  <para style="q">wajb'ile' tu'n nximane' kyi'ju' tb'inchb'ena tb'anilqexi'x.</para>
  <para style="q">
    <verse number="28" style="v" />Matxi'xi'x ku'xch'yon ti'jnk'u'je' tu'n k'ixk'oj;</para>
  <para style="q">¡q'uqb'ama nk'u'je', kse'nxju' tzaj ttziya'na!</para>
  <para style="q">
    <verse number="29" style="v" />Chin tpa'mila ti'ju' b'e te chajyolil</para>
  <para style="q">ex yek'u'nqe'tza tchaq'b'ila weye' tu'n tk'u'jlalila.</para>
  <para style="q">
    <verse number="30" style="v" />Matxi' kub' nxima'ne' tu'n nb'i'ne' teya</para>
  <para style="q">inchin laqje' kyi'ju' tchaq'b'ila.</para>
  <para style="q">
    <verse number="31" style="v" />Nman Dyos, matxi' tz'ok nxon nk'u'je' kyi'ju' tchaq'b'ila;</para>
  <para style="q">¡lalun taja tu'n tel nch'ixawe'!</para>
  <para style="q">
    <verse number="32" style="v" />Nnoktilil wu'ne' tu'n kyjapunju' tchaq'b'ila</para>
  <para style="q">qu'n inxi'x chin tzalaje' tu'na.</para>
  <para style="s2">Tjwe'yi'n</para>
  <para style="q">
    <verse number="33" style="v" />Nman Dyos, xnaq'tzanqe'tzju'ya tkawb'ila weye',</para>
  <para style="q">wajb'ile' tu'n woklpeye' kyi'j toj tkyaqilju' nchwinqlale'.</para>
  <para style="q">
    <verse number="34" style="v" />Q'ontza nnab'le' tu'n kyjapun tchaq'b'ila wu'ne';</para>
  <para style="q">¡wajb'ile' tu'n kyxinb'incha'ne' tu'n tkyaqil nk'u'je'!</para>
  <para style="q">
    <verse number="35" style="v" />Yek'unqe'tza tchaq'b'ila weye',</para>
  <para style="q">qu'n atzu' nchin tzalaja'ye' kyi'j.</para>
  <para style="q">
    <verse number="36" style="v" />Chin toniya tu'n tokten nwitze' kyi'ju' tchaq'b'ila</para>
  <para style="q">mya ti'j jamjoni'n.</para>
  <para style="q">
    <verse number="37" style="v" />Lalun taja tu'n tokten nwitze' kyi'ju' noqxgan;</para>
  <para style="q">¡chin tonima tu'n nb'ete' toju' tb'eya!</para>
  <para style="q">
    <verse number="38" style="v" />Japunxtzunju' tyola weye'</para>
  <para style="q">e'ttziyaya kyeju' nche niman teya.</para>
  <para style="q">
    <verse number="39" style="v" />Chin tkloma teju' ik'b'il nchin xob'e' te,</para>
  <para style="q">qu'n tz'aqli qekye' tchaq'b'ila.</para>
  <para style="q">
    <verse number="40" style="v" />Ina' chin laqjwe' kyi'ju' tchaq'b'ila;</para>
  <para style="q">¡q'ontza nchwinqlale', qu'n tnik'altati'j!</para>
  <para style="s2">Tqaqi'n</para>
  <para style="q">
    <verse number="41" style="v" />Nman Dyos, yek'untza tk'u'jlalila ex chin tloma,</para>
  <para style="q">kse'nxju' kyajni ttziya'na.</para>
  <para style="q">
    <verse number="42" style="v" />Tu'n ttzaq'wet wu'ne' kyeju' nche ok ik'lenweye',</para>
  <para style="q">q'uqlina'we' nk'u'j ti'ju' tyola.</para>
  <para style="q">
    <verse number="43" style="v" />Lalun taja tu'n tb'aj nyolinteye' tyola ax,</para>
  <para style="q">matxina' tz'okqe nk'u'je' kyi'ju' tchaq'b'ila.</para>
  <para style="q">
    <verse number="44" style="v" />¡Wajb'ile' tu'n wanq'inteye' t-xnaq'tzb'ila,</para>
  <para style="q">kukxju', toj tkyaqil tq'ijlalil!</para>
  <para style="q">
    <verse number="45" style="v" />Chin anq'iltzuntze' toj tzaqpib'l,</para>
  <para style="q">matxina' chinx lpewe' kyi'ju' tchaq'b'ila.</para>
  <para style="q">
    <verse number="46" style="v" />Chin yolile' kyi'ju' tchaq'b'ila kywitzu' nimaqkawil</para>
  <para style="q">ex lay chin ch'ixwiye'.</para>
  <para style="q">
    <verse number="47" style="v" />Ina' che nk'u'jla'nwe' tchaq'b'ila</para>
  <para style="q">ex nchin tzalaje' kyi'j.</para>
  <para style="q">
    <verse number="48" style="v" />K'u'jla'nqe' tchaq'b'ila wu'ne' ex chi' nk'u'je' kyi'j,</para>
  <para style="q">ex nxi'x chin ximane' kyi'ju' tkawb'ila.</para>
  <para style="s2">Twuqi'n</para>
  <para style="q">
    <verse number="49" style="v" />Na'ntza tyola tzaj tma'na weye' ayine' tmajina:</para>
  <para style="q">qu'n ti'j soka'qe nk'u'je' tu'na.</para>
  <para style="q">
    <verse number="50" style="v" />Ate q'uqb'ab'l nk'u'jju'ye' toj b'is:</para>
  <para style="q">qu'n intq'o'na nchwinqlale' tu'nju' tyola tziya'n.</para>
  <para style="q">
    <verse number="51" style="v" />Kukx wok ik'le'nju'ye' kyu'nju' nknima'n kyib',</para>
  <para style="q">ayintzunwe' min nkyaj ntzaqpi'ne' t-xnaq'tzb'ila.</para>
  <para style="q">
    <verse number="52" style="v" />Inche tzaj nna'nju'ye' tchaq'b'ila te ojtxi',</para>
  <para style="q">ex inqe nk'u'je' kyi'j.</para>
  <para style="q">
    <verse number="53" style="v" />Inchin tx'u'jine' kyi'ju' b'inchal myab'a'n</para>
  <para style="q">ju' nkyej kykoli'nju' t-xnaq'tzb'ila.</para>
  <para style="q">
    <verse number="54" style="v" />Matxi' che okju' tkawb'ila te nb'itze'</para>
  <para style="q">twitzju' tx'otx' lu, ajb'etun xjal qine' toj.</para>
  <para style="q">
    <verse number="55" style="v" />Nman Dyos, intzaj nna'na toj qonik'an;</para>
  <para style="q">¡wajb'ile' tu'n wanq'inteju'ye' t-xnaq'tzb'ila!</para>
  <para style="q">
    <verse number="56" style="v" />Awe' waq'un:</para>
  <para style="q">tu'n kyxi' nb'incha'nju'ye' tchaq'b'ila.</para>
  <para style="s2">Twajxaqi'n</para>
  <para style="q">
    <verse number="57" style="v" />Nman Dyos, o'kxa nim toklena weye';</para>
  <para style="q">oje ntziyaye' tu'n wanq'inteju'ye' tyola.</para>
  <para style="q">
    <verse number="58" style="v" />Nnoktilil wu'ne' tu'n tkyaqil nk'u'je' tu'n ttzalaja wi'je';</para>
  <para style="q">q'aq'antz tk'u'ja wi'je' kse'nxju' kyej ttziya'na.</para>
  <para style="q">
    <verse number="59" style="v" />Inximane' ti'ju' tu'me'l nchin anq'ina'ye',</para>
  <para style="q">ex mache'x nb'incha'ntle' tchaq'b'ila.</para>
  <para style="q">
    <verse number="60" style="v" />Matz'oktilil wu'ne'</para>
  <para style="q">ex lwiy ẍe'x nb'inchanju'ye' tchaq'b'ila.</para>
  <para style="q">
    <verse number="61" style="v" />Mache oktxoli'n xpatxab' wi'je' kyu'n b'inchal myab'a'n,</para>
  <para style="q">ex min sik'tna'lju' t-xnaq'tzb'ila wu'ne'.</para>
  <para style="q">
    <verse number="62" style="v" />Inchin jawe'ye' tk'u'j aq'b'il q'ol chjonte teya</para>
  <para style="q">tu'nju' tz'aqlqe'xi'xju' tchaq'b'ila.</para>
  <para style="q">
    <verse number="63" style="v" />Wamiw qe'we' nche niman teya</para>
  <para style="q">exqe'ju' nche japun tchaq'b'ila kyu'n.</para>
  <para style="q">
    <verse number="64" style="v" />Nman Dyos, nojni twitz tx'otx' tu'n tk'u'jlalila;</para>
  <para style="q">¡xnaq'tzanqe'tzju'ya tkawb'ila weye'!</para>
  <para style="s2">Tb'eljoji'n</para>
  <para style="q">
    <verse number="65" style="v" />Nman Dyos, majx b'a'n wilwiye' tu'na ayine' tmajina,</para>
  <para style="q">kse'nxju' tyola ttziyaya.</para>
  <para style="q">
    <verse number="66" style="v" />Chin t-xnaq'tzantza tu'n tten nnab'le' ex wojtzqib'le',</para>
  <para style="q">q'uqliwe' nk'u'j kyi'ju' tchaq'b'ila.</para>
  <para style="q">
    <verse number="67" style="v" />Nim chuksb'il xnb'inchaye' na'mxtoq nkub' tme'ssa'na,</para>
  <para style="q">atzu'n ja'lo nxinb'i'ne' tyola.</para>
  <para style="q">
    <verse number="68" style="v" />Majx b'a'nta, ex nb'inchan xtalb'ila;</para>
  <para style="q">¡xnaq'tzanqe'tza tkawb'ila weye'!</para>
  <para style="q">
    <verse number="69" style="v" />Naqx kyak'a'nju' nkynima'n kyib' ate'qe'k poqol weye',</para>
  <para style="q">ayintzunwe' nwanq'i'ne' tchaq'b'ila tu'n tkyaqil nk'u'je'.</para>
  <para style="q">
    <verse number="70" style="v" />Tzpetni kye' xjal lu kynab'l,</para>
  <para style="q">ayintzunwe' nchin tzalaje' tu'nju' t-xnaq'tzb'ila.</para>
  <para style="q">
    <verse number="71" style="v" />B'a'nte' ẍin kub'messa'ne',</para>
  <para style="q">qu'n mache kaneju' tkawb'ila toj nwitze'.</para>
  <para style="q">
    <verse number="72" style="v" />Nimxi'x toklenju' t-xnaq'tzb'ila ntma'na weye',</para>
  <para style="q">kyetwitz txqan medi q'anpwaq ex saqpwaq.</para>
  <para style="s2">Tlajoji'n</para>
  <para style="q">
    <verse number="73" style="v" />Aku'ya kub' b'inchanweye'</para>
  <para style="q">¡q'oma tu'n nximane' tu'n tel nnik'e' kyi'ju' tchaq'b'ila!</para>
  <para style="q">
    <verse number="74" style="v" />Inche tzalaju' nche niman teya ajntzaj kyka'yine',</para>
  <para style="q">qu'n matxi' tz'okqewe' nk'u'j ti'ju' tyola.</para>
  <para style="q">
    <verse number="75" style="v" />Nman Dyos, b'i'n we'wu'n tz'aqliqe'xi'xju' tchaq'b'ila</para>
  <para style="q">ex toj tu'me'l nchin kub'ttzak'una'ya.</para>
  <para style="q">
    <verse number="76" style="v" />¡Tz'okxwitju' tk'u'jlalila te q'uqb'ab'l nk'u'je',</para>
  <para style="q">kse'nxju' tyola tzaj ttziya'na weye'!</para>
  <para style="q">
    <verse number="77" style="v" />Yek'untza tk'i'wlalila ex q'ontza nchwinqlale',</para>
  <para style="q">qu'n nchin tzalaje' kyi'ju' tchaq'b'ila.</para>
  <para style="q">
    <verse number="78" style="v" />Tz'elxwit kych'ixawju' nkynima'n kyib'</para>
  <para style="q">aye' noqxkyak'a'n nchin kywuli'ne';</para>
  <para style="q">chin ximalwe' kyi'ju' tchaq'b'ila.</para>
  <para style="q">
    <verse number="79" style="v" />Kymujb'axwit kyib'ju' nche niman teya wuk'i'le',</para>
  <para style="q">aye' ojtzqi'n tchaq'b'ila kyu'n.</para>
  <para style="q">
    <verse number="80" style="v" />Chin okxwite' tz'aqli kyoju' tkawb'ila,</para>
  <para style="q">tu'ntzun mitz'ela' nch'ixawe'.</para>
  <para style="s2">Tjunlajoji'n</para>
  <para style="q">
    <verse number="81" style="v" />Inxi'x chin elb'aje' tu'n tula klol weye';</para>
  <para style="q">¡qu'n o'kxtzu' q'uqla' nk'u'je' ti'ju' tyola!</para>
  <para style="q">
    <verse number="82" style="v" />Naq tuk'ilxtl kyu'n nwitze' oyb'enteju' ttziyaya,</para>
  <para style="q">¿Jtojtzun tzula q'uqb'alte nk'u'je'? nchije'.</para>
  <para style="q">
    <verse number="83" style="v" />Maskye matxi' chin tijine', mixti'tl wajb'ene' ex kyejni kolb'e'n qine',</para>
  <para style="q">min nnik'kyna'lju' tkawb'ila wu'ne'.</para>
  <para style="q">
    <verse number="84" style="v" />¿Jte'lo q'ijtl tu'n tkub' wayo'ne'?</para>
  <para style="q">¿Jtojtzun kub' ttz'e'ysa'n kywitzju'ya nche yajun weye'?</para>
  <para style="q">
    <verse number="85" style="v" />Matxi' che ku'xlku'n xpatxab' toj nb'eye',</para>
  <para style="q">kyu'nju' nkynima'n kyib' ex min lepchqe'k ti'ju' t-xnaq'tzb'ila,</para>
  <para style="q">
    <verse number="86" style="v" />¡Chin tonima, qu'n ljo'n toj nq'ije' extzun mixti' wile'!</para>
  <para style="q">¡Kykyaqilju' tchaq'b'ila ax qe'!</para>
  <para style="q">
    <verse number="87" style="v" />Ma'toq chin kub'a' najsa'ne' twitz tx'otx',</para>
  <para style="q">ex min sik' tna'lju' tchaq'b'ila wu'ne'.</para>
  <para style="q">
    <verse number="88" style="v" />Q'ontza nchwinqlale' tu'nju' tk'u'jlalila,</para>
  <para style="q">ex che japumel tchaq'b'ila e'tmaya wu'ne'.</para>
  <para style="s2">Tkab'lajoji'n (12)</para>
  <para style="q">
    <verse number="89" style="v" />Nman Dyos, tejumajxte' tyola;</para>
  <para style="q">¡majx ati toj kya'j!</para>
  <para style="q">
    <verse number="90" style="v" />In japunju' tyola tu'na tejumajx;</para>
  <para style="q">kub'tb'incha'nju'ya tx'otx' ex majx kyejten.</para>
  <para style="q">
    <verse number="91" style="v" />Kukxkyten ti'xti'ju', kse'nxju' tchaq'a,</para>
  <para style="q">qu'n kykyaqil nche ajb'en teya.</para>
  <para style="q">
    <verse number="92" style="v" />Noqwit myaju' t-xnaq'tzb'ila ntzalajsan weye',</para>
  <para style="q">matxi'wtlo chin b'aje' tu'n b'is.</para>
  <para style="q">
    <verse number="93" style="v" />Milo najchi'j tu'n tik'kyna'lju' tchaq'b'ila wu'ne',</para>
  <para style="q">mana' tzaj tq'o'na nchwinqlale' kyu'n.</para>
  <para style="q">
    <verse number="94" style="v" />¡Chin tkloma, qu'n teqina</para>
  <para style="q">ex inche wanq'i'nju'ye' tchaq'b'ila!</para>
  <para style="q">
    <verse number="95" style="v" />Inche xq'uqinju' b'inchal myab'a'n wi'je' tu'n nkub' kyb'yo'ne',</para>
  <para style="q">ayintzunwe' toknwi'ye' kyi'ju' tchaq'b'ila.</para>
  <para style="q">
    <verse number="96" style="v" />Matxi' wile' qa kykyaqilju' ti'xti' nche b'aj,</para>
  <para style="q">aye'tzu'nta tchaq'b'il milo che b'ajela'.</para>
  <para style="s2">Toxlajoji'n</para>
  <para style="q">
    <verse number="97" style="v" />¡Inxi'x che nk'u'jla'ne' tchaq'b'ila!</para>
  <para style="q">¡Nb'aj q'ij tu'n nximane' kyi'j!</para>
  <para style="q">
    <verse number="98" style="v" />Weqe'we' tchaq'b'ila tejumajx;</para>
  <para style="q">atixi'x nnab'le' kyu'n kyekywitzju' wajq'oje.</para>
  <para style="q">
    <verse number="99" style="v" />In kanexi'x toj nwitze' kyekywitzju' xnaq'tzalweye'</para>
  <para style="q">qu'n nxi'x chin ximane' kyi'ju' tchaq'b'ila.</para>
  <para style="q">
    <verse number="100" style="v" />Inxi'x kane toj nwitze' kyekywitzju' tijwnaq</para>
  <para style="q">qu'n nche'x nnima'nju'ye' tchaq'b'ila.</para>
  <para style="q">
    <verse number="101" style="v" />Matxi' tz'el npa'nwib'e' ti'ju' b'e myab'a'n</para>
  <para style="q">tu'n tjapunju' tyola wu'ne'.</para>
  <para style="q">
    <verse number="102" style="v" />B'ajx tz'ela' npa'nwe'wib' kyi'ju' tchaq'b'ila</para>
  <para style="q">qu'n aya xnaq'tzalweye'.</para>
  <para style="q">
    <verse number="103" style="v" />Chi'xi'xte' tyola ttziyaya</para>
  <para style="q">kyetwitz ta'lkab' toj ntziye'.</para>
  <para style="q">
    <verse number="104" style="v" />Tu'nju' tchaq'b'ila xtena' nnab'le';</para>
  <para style="q">qu'mtzun nche el wik'u'nju'ye' chajyoli'n.</para>
  <para style="s2">Tkyajlajoji'n</para>
  <para style="q">
    <verse number="105" style="v" />Jun spik'unte' tyola weye'</para>
  <para style="q">ex jun txaqb'ilte toj nb'eye'.</para>
  <para style="q">
    <verse number="106" style="v" />ntziyaye' jun yol, ex kjapumel wu'ne':</para>
  <para style="q">¡che b'el wanq'i'nju'ye' tchaq'b'ila tnik'alkyi'j!</para>
  <para style="q">
    <verse number="107" style="v" />Nman Dyos, inxi'x chin b'isune';</para>
  <para style="q">¡q'ontza nchwinqlale', kse'nxju' oje tmaya!</para>
  <para style="q">
    <verse number="108" style="v" />Nman Dyos, k'monxju'ya aq'b'il chjonte nxinma'ne' teya,</para>
  <para style="q">xnaq'tzanqe'tzju'ya tchaq'b'ila weye'.</para>
  <para style="q">
    <verse number="109" style="v" />Naq nneljeti'ju' nchwinqlale' tkyaqil q'ij,</para>
  <para style="q">ex min in ik'tna'lju' tchaq'b'ila wu'ne'.</para>
  <para style="q">
    <verse number="110" style="v" />Inche kub' kyq'o'n b'inchal myab'a'n xpatxab' toj nb'eye',</para>
  <para style="q">ex min nnel npa'nwe' wib' kyi'ju' tchaq'b'ila.</para>
  <para style="q">
    <verse number="111" style="v" />Aye' wetzb'ilju'ye' tchaq'b'ila tejumajx,</para>
  <para style="q">qu'n inxi'x chin tzalaje' kyu'n.</para>
  <para style="q">
    <verse number="112" style="v" />Oje kub' nxima'ne' tu'n kyxinb'incha'ne' tkawb'ila,</para>
  <para style="q">kukxju' ex tejumajx.</para>
  <para style="s2">T-o'lajoji'n</para>
  <para style="q">
    <verse number="113" style="v" />Inche el wik'u'nju'ye' xjal xmletz'qe',</para>
  <para style="q">aye'tzu'n t-xnaq'tzb'ila k'u'jla'nqe' wu'ne'.</para>
  <para style="q">
    <verse number="114" style="v" />Aya e'wb'il weye' ex klol weye';</para>
  <para style="q">atzu' matxi' tz'oka' qe nk'u'je' ti'j ju' tyola.</para>
  <para style="q">
    <verse number="115" style="v" />¡Kypa'mil kyib'e' wi'je' b'inchal myab'a'n,</para>
  <para style="q">qu'n wajb'ile' tu'n kyjapun tchaq'b'il Dyos wu'ne'!</para>
  <para style="q">
    <verse number="116" style="v" />Q'ontza wipumale' kse'nxju' ttziyaya, chin anq'iltzuntze';</para>
  <para style="q">¡lalun tz'el nch'ixawe' tu'nju' q'uqlok nk'u'je' ti'ja!</para>
  <para style="q">
    <verse number="117" style="v" />Chin tonima, tu'ntzun nklete';</para>
  <para style="q">che japumeltzun tkawb'iltzu'ya wu'ne' kukxju'.</para>
  <para style="q">
    <verse number="118" style="v" />Nche eltik'u'nju'ya min nche oklpe kyi'ju' tkawb'ila,</para>
  <para style="q">qu'n mixti'x nche ximan b'a'n.</para>
  <para style="q">
    <verse number="119" style="v" />Naku'j tz'is qe'ju' b'inchal myab'a'n twitz tx'otx' teya;</para>
  <para style="q">qu'mtzun nche nk'u'jla'nwe' tchaq'b'ila.</para>
  <para style="q">
    <verse number="120" style="v" />Inchin lu'lune' tu'n xob'il twitza;</para>
  <para style="q">¡inche nnima'nwe' tchaq'b'ila!</para>
  <para style="s2">Tqaqlajoji'n</para>
  <para style="q">
    <verse number="121" style="v" />Kukxwe' nb'inchante tnik'alilti'j;</para>
  <para style="q">lan chin kyej tq'o'na toj kyq'ob'ju' nche yajun weye'.</para>
  <para style="q">
    <verse number="122" style="v" />Chin tka'yima tu'n ntene' b'a'n;</para>
  <para style="q">tu'n lalun chin b'ajkyajla'ne' nkynima'n kyib'.</para>
  <para style="q">
    <verse number="123" style="v" />Matxi' che sikti nwitze' ayob'enteya tu'n tula klol weye',</para>
  <para style="q">inchin ayone' tu'n ntzaqpete' tu'na kse'nxju' ttziyaya.</para>
  <para style="q">
    <verse number="124" style="v" />Chin tka'yika ayine' tmajena kse'nxju' tk'u'jlalila;</para>
  <para style="q">¡yek'unqe'tzju'ya tkawb'ila weye'!</para>
  <para style="q">
    <verse number="125" style="v" />Ayinweju'ye' tmajena. Q'ontza nnab'le',</para>
  <para style="q">wajb'ilwe' tu'n tel nnik'e' kyi'ju' tchaq'b'ila.</para>
  <para style="q">
    <verse number="126" style="v" />Nman Dyos, matxi' pon tq'ijlalil tu'n tjaw tiq'i'ntib'a,</para>
  <para style="q">kyib'aju' min nxikyima'n t-xnaq'tzb'ila.</para>
  <para style="q">
    <verse number="127" style="v" />Qu'mtzun nche nk'u'jla'nwe' tchaq'b'ila</para>
  <para style="q">nimxi'x kyekywitzju' q'anpwaq tb'anil.</para>
  <para style="q">
    <verse number="128" style="v" />Qu'mtzun lepchqinxe' kyi'ju' tchaq'b'ila</para>
  <para style="q">atzu'n myab'a'n nkyb'incha'n xjal ik'o'n wu'ne'.</para>
  <para style="s2">Twuqlajoji'n</para>
  <para style="q">
    <verse number="129" style="v" />Majx tb'anilqe'kye' tchaq'b'ila;</para>
  <para style="q">qu'mtzun nche'x nnima'ne'.</para>
  <para style="q">
    <verse number="130" style="v" />Jun spik'unte' chik'b'ab'l tib'aju' tyola,</para>
  <para style="q">inten kynab'lju' xjal noq ch'i'n kyojtzqilb' tu'n.</para>
  <para style="q">
    <verse number="131" style="v" />Inxi'x che k'atjnenju' tchaq'b'ila weye',</para>
  <para style="q">qu'n nchin laqje' kyi'j.</para>
  <para style="q">
    <verse number="132" style="v" />Chin tka'yintza, ex q'aq'antz tk'u'ja wi'je',</para>
  <para style="q">kse'n ntb'incha'na kyeju' nche k'u'jlanteya.</para>
  <para style="q">
    <verse number="133" style="v" />B'inchama tu'n nb'ete' kse'nxju' ntma'n tyola;</para>
  <para style="q">lalun taja tu'n tkub' wi'je' tu'nju' myab'a'n.</para>
  <para style="q">
    <verse number="134" style="v" />Chin tkloma teju' yajb'il kyu'n xjal,</para>
  <para style="q">wajb'ile' tu'n kyjapunju' tchaq'b'ila wu'ne'.</para>
  <para style="q">
    <verse number="135" style="v" />Chin tka'yintza tuk'i'l tk'u'jlalila,</para>
  <para style="q">ex xnaq'tzanqe'tza tkawb'ila weye'.</para>
  <para style="q">
    <verse number="136" style="v" />Inxi'x el ta'l nwitze'</para>
  <para style="q">qu'n min nche'x nima'nju' t-xnaq'tzb'ila.</para>
  <para style="s2">Twajxaqlajoji'n</para>
  <para style="q">
    <verse number="137" style="v" />Nman Dyos, tz'aqlixi'xta;</para>
  <para style="q">ex tu'me'l qe'xi'xju' tchaq'b'ila.</para>
  <para style="q">
    <verse number="138" style="v" />Tkyaqilju' tchaq'b'ila</para>
  <para style="q">tz'aqliqe'xi'x ex ax qe'.</para>
  <para style="q">
    <verse number="139" style="v" />Xi' nkub'aje' tu'n xky'aqli'n ti'j ju' tyola,</para>
  <para style="q">qu'n matxi' tzik' kyna'l kyu'nju' wajq'oje.</para>
  <para style="q">
    <verse number="140" style="v" />Toj tkuwal oje tzik' twitzlalilju' tyola ttziyaya;</para>
  <para style="q">qu'mtzun k'u'jla'n wu'ne' ayine' tmajena.</para>
  <para style="q">
    <verse number="141" style="v" />B'a'ntzun qa mixti'we' woklen ex ik'u'nqine',</para>
  <para style="q">min nik' kyna'lju' tchaq'b'ila wu'ne'.</para>
  <para style="q">
    <verse number="142" style="v" />Te jumajxte' tnik'alilti'j tu'na,</para>
  <para style="q">ex ax qe' t-xnaq'tzb'ila.</para>
  <para style="q">
    <verse number="143" style="v" />Matxi' chin tene' toj b'is ex toj yajb'il,</para>
  <para style="q">aye'tzu'n tchaq'b'ila machin kytzalajsaye'.</para>
  <para style="q">
    <verse number="144" style="v" />Tz'aqliqe'kye' tchaq'b'ila kukxju';</para>
  <para style="q">¡q'ontza nnab'le' tu'ntzun tb'ent wanq'ine'!</para>
  <para style="s2">Tb'eljlajoji'n</para>
  <para style="q">
    <verse number="145" style="v" />Nman Dyos, in ntxko'na tu'n tkyaqil nk'u'je';</para>
  <para style="q">¡chin ttzaq'wentza, wajb'ilwe' tu'n kyjapun tkawb'ila wu'ne'!</para>
  <para style="q">
    <verse number="146" style="v" />Twitza nchin kub'sana'ye', chin tonima</para>
  <para style="q">tu'n kyjapunju' tchaq'b'ila wu'ne'.</para>
  <para style="q">
    <verse number="147" style="v" />Na'mxtoq qsqix nchin jawe'ye' qanil o'nb'il teya;</para>
  <para style="q">matxi' tz'okqe nk'u'je' ti'ju' tyola tzaj ttziya'na.</para>
  <para style="q">
    <verse number="148" style="v" />Ajqok yupj, min ntzajnaj nwatle'</para>
  <para style="q">tu'n nkub' tene' ximal ti'ju' tyola tzaj ttziya'na.</para>
  <para style="q">
    <verse number="149" style="v" />Nman Dyos, chin tb'intza tu'n tk'u'jlalila;</para>
  <para style="q">q'ontza nchwinqlale' kse'nxju' b'a'n toj twitza.</para>
  <para style="q">
    <verse number="150" style="v" />Okniqe' lq'eju' ljolte toj nq'ije' ti'ju' myab'a'n,</para>
  <para style="q">atzu'n ti'ju' t-xnaq'tzb'ila najchaq ta'qe'.</para>
  <para style="q">
    <verse number="151" style="v" />Nman Dyos, nqaku' ta'ta,</para>
  <para style="q">ex tkyaqilju' tchaq'b'ila ax qe'.</para>
  <para style="q">
    <verse number="152" style="v" />Wojtzqi'nqe'we' tchaq'b'ila atxi'x ojtxi',</para>
  <para style="q">e'kyajtq'o'na tejumajx.</para>
  <para style="s2">Tjunaqi'n</para>
  <para style="q">
    <verse number="153" style="v" />Ka'yintza nchin yajtiye' ex chin tkloma,</para>
  <para style="q">b'ajxna tzik'a' kyna'lju' t-xnaq'tzb'ila wu'ne'.</para>
  <para style="q">
    <verse number="154" style="v" />Chin tkloma toju' yajb'il lu;</para>
  <para style="q">¡q'ontza nchwinqlale' kse'nxju' tziya'n tu'na!</para>
  <para style="q">
    <verse number="155" style="v" />Min nnonina kyi'ju' b'inchal myab'a'n,</para>
  <para style="q">qu'n min nche anq'in kse'nxju' tkawb'ila.</para>
  <para style="q">
    <verse number="156" style="v" />Nimxi'xju' tk'u'jlalila Nman Dyos;</para>
  <para style="q">q'ontza nchwinqlale' kse'nxju' b'a'n toj twitza.</para>
  <para style="q">
    <verse number="157" style="v" />Nim kyb'aju' wajq'oje exqe' nche yajun wi'je',</para>
  <para style="q">atzunwe' min nelnpa'n wib'e' kyi'ju' tchaq'b'ila.</para>
  <para style="q">
    <verse number="158" style="v" />Lay che ik'xju' nche okmiltz'uj ti'ja wu'ne',</para>
  <para style="q">aye' min nche'x kynima'n tchaq'b'ila.</para>
  <para style="q">
    <verse number="159" style="v" />Ka'yintzpe'ya Nman Dyos, inche nk'u'jla'nwe' tchaq'b'ila;</para>
  <para style="q">¡q'ontza nchwinqlale' kse'nxju' tk'u'jlalila!</para>
  <para style="q">
    <verse number="160" style="v" />Atiju' ax toj tkyaqilju' tyola;</para>
  <para style="q">tkyaqilju' tchaq'b'ila tz'aqliqe' ex tejumajxqe'.</para>
  <para style="s2">Tjunaqi'n jun</para>
  <para style="q">
    <verse number="161" style="v" />Ljo'n toj nq'ije' kyu'n xjal nimaq kyoklen, extzun mixti' wile' kye,</para>
  <para style="q">ayintzunwe' inche'x nnima'nju'ye' tyola.</para>
  <para style="q">
    <verse number="162" style="v" />Inchin tzalajwe' kyi'ju' tyola tzajni ttziya'na,</para>
  <para style="q">kse'n nknet jun k'uwenj tb'anilxi'x tu'n jun xjal.</para>
  <para style="q">
    <verse number="163" style="v" />Inel wik'u'nwe' chajyolil, min nkub' toj nwitze'</para>
  <para style="q">atzu'n t-xnaq'tzb'ila in nk'u'jla'ne'.</para>
  <para style="q">
    <verse number="164" style="v" />Tkyaqil kmuj nchin b'itzane' teya</para>
  <para style="q">tu'nju' tz'aqliqe'xi'xju' tchaq'b'ila.</para>
  <para style="q">
    <verse number="165" style="v" />B'a'n ta'qe'kye' nche k'u'jlante t-xnaq'tzb'ila,</para>
  <para style="q">ex lay che kub' tz'aq.</para>
  <para style="q">
    <verse number="166" style="v" />Nman Dyos, awta klonweye',</para>
  <para style="q">qu'n matxi' che wanq'inju'ye' tchaq'b'ila.</para>
  <para style="q">
    <verse number="167" style="v" />Nche'x nb'i'nwe' tchaq'b'ila</para>
  <para style="q">ex nche nk'u'jla'ne' tu'n tkyaqil nk'u'je'.</para>
  <para style="q">
    <verse number="168" style="v" />Nche'x nb'i'nwe' tchaq'b'ila ex tyola;</para>
  <para style="q">¡ojtzqi'nta tu'n se'n tu'me'l nchin anq'ina'ye'!</para>
  <para style="s2">Tjunaqi'n kab'e' (22)</para>
  <para style="q">
    <verse number="169" style="v" />Nman Dyos, b'intzju'ya nkub'sb'ile';</para>
  <para style="q">¡q'ontza nnab'le' kse'nxju' ntma'n tyola!</para>
  <para style="q">
    <verse number="170" style="v" />Japunxwitju' nna'j Dyose' twitza;</para>
  <para style="q">¡chin tkloma, kse'nxju' tyola tzajni ttziya'na!</para>
  <para style="q">
    <verse number="171" style="v" />Chin b'itzanxwite' te ajwalilteya,</para>
  <para style="q">mache tzajtyek'u'na tkawb'ila weye'.</para>
  <para style="q">
    <verse number="172" style="v" />Kchin b'itzale' tu'nju' yol tzaj ttziya'na,</para>
  <para style="q">qu'n tkyaqilju' tchaq'b'ila tz'aqliqe'xi'x</para>
  <para style="q">
    <verse number="173" style="v" />Nman Dyos, lwiyxwit tzaja klol weye',</para>
  <para style="q">qu'n matxi' kub' nxima'ne' tu'n kyxi'nb'i'ne' tchaq'b'ila.</para>
  <para style="q">
    <verse number="174" style="v" />Nman Dyos, ¡wajb'ile' tu'n nklete' tu'na!</para>
  <para style="q">¡Nchin tzalaje' ti'ju' t-xnaq'tzb'ila!</para>
  <para style="q">
    <verse number="175" style="v" />Wajb'ile' tu'n wanq'ine' ajwalilteya;</para>
  <para style="q">awtju' tchaq'b'ila tz'oninweye'.</para>
  <para style="q">
    <verse number="176" style="v" />Matxi' chin tzpete' kse'n jun rit; ¡kuttzaja jyolweye',</para>
  <para style="q">min nik'tna'lwe' tchaq'b'ila wu'n! chiju' b'itzal.</para>
  <chapter number="120" style="c" />
  <para style="s1">Na'j Dyos toj jun xob'ajil</para>
  <para style="q">
    <verse number="1" style="v" />Inxinna'ne' Qman Dyos kse'n antine' toj k'ixk'oj,</para>
  <para style="q">ex nchin tzajttzaq'we'ne'.</para>
  <para style="q">
    <verse number="2" style="v" />Nman Dyos, chin tkloma toj kytziju' chalyol</para>
  <para style="q">ex toj kytziju' xmletz'.</para>
  <para style="b" />
  <para style="q">
    <verse number="3" style="v" />¿Ti'xi'xwitzuloti' ktkanb'a'ya chalyol?</para>
  <para style="q">
    <verse number="4" style="v" />¡Talsmaj ch'utkywi' te q'ojil!</para>
  <para style="q">¡Tuk'i'l ttxaltq'aq'al tze retama!</para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" />¡Qab'anx nwitze', nchin najane' naku'j ajb'etun toj Mesek,</para>
  <para style="q">najlqine' kyxolju' pach xb'alun toj Kedar!</para>
  <para style="q">
    <verse number="6" style="v" />Matxi' chin najane' nimtoj kyxolju' xjal min kyajb'ilju' nak'b'il;</para>
  <para style="q">
    <verse number="7" style="v" />¡ajnyoline' ti'j nak'b'il; inche yolin ti'j q'oj! Chiju' b'itzal.</para>
  <chapter number="121" style="c" />
  <para style="s1">A Qman Dyos klolteya</para>
  <para style="q">
    <verse number="1" style="v" />Ajkyxi nka'yi'nju'ye' witz, inxjelu'n wib'e':</para>
  <para style="q">¿Jaloja ktzajela' o'nb'il weye'? nchije'.</para>
  <para style="q">
    <verse number="2" style="v" />Tk'etz Qman Dyos tzula'te' o'nb'il weye',</para>
  <para style="q">ju' b'inchante kya'j ex tx'otx'.</para>
  <para style="b" />
  <para style="q">
    <verse number="3" style="v" />¡Layx taj tu'n tjaw jilpuja!</para>
  <para style="q">¡Layx tzik'wtante' xq'uqilteya!</para>
  <para style="q">
    <verse number="4" style="v" />Min nwtan te';</para>
  <para style="q">mixti' nwtanju' xq'uqil kyi'j aj Israel.</para>
  <para style="q">
    <verse number="5" style="v" />Ate Qman Dyos xq'uqilteya;</para>
  <para style="q">ate nklonteya,</para>
  <para style="q">majx ati tk'etza onilteya.</para>
  <para style="q">
    <verse number="6" style="v" />Lay kub' numja tu'n q'ij te q'ijtl,</para>
  <para style="q">ex mixti' k'ik'el ti'ja tu'n xjaw te qonik'an.</para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" />Xq'uqi'nta tu'n Qman Dyos te tkyaqil myab'a'n;</para>
  <para style="q">xq'uqi'n tchwinqlala tu'n.</para>
  <para style="q">
    <verse number="8" style="v" />Xq'uqi'na tu'n Qman Dyos toj tkyaqilju' tb'eya,</para>
  <para style="q">te ja'lo ex tejumajx. Chiju' b'itzal.</para>
  <chapter number="122" style="c" />
  <para style="s1">B'itz ti'j Jerusalen</para>
  <para style="q">
    <verse number="1" style="v" />¡inchin tzalaje' qama ttzaj q'ma'n weye':</para>
  <para style="q">Qo'qe'ye' toj tja Qman Dyos! Qa chi.</para>
  <para style="q">
    <verse number="2" style="v" />Jerusalen,</para>
  <para style="q">¡matxi' qo'okxe' kyoju' tjpela!</para>
  <para style="q">
    <verse number="3" style="v" />Jun nintnamte' Jerusalen,</para>
  <para style="q">b'incha'n tu'n kyb'u'yintekyib'ju' xjal toj.</para>
  <para style="q">
    <verse number="4" style="v" />Tojte nche ula' tnej kyyajajil ttanam Dyos</para>
  <para style="q">ajwalilteju' tb'i,</para>
  <para style="q">kse'nxju' tchaq' kye.</para>
  <para style="q">
    <verse number="5" style="v" />Toj ta'qe'ju' kawb'il te tnik'alilti'j,</para>
  <para style="q">aye' kawb'il toj tja Dab'i.</para>
  <para style="b" />
  <para style="q">
    <verse number="6" style="v" />Kyqaninxe' te Dyos tu'n tkyaqil kyk'u'je':</para>
  <para style="q2">Tenxwit nak'b'il toj Jerusalen;</para>
  <para style="q2">che najanxwitju' nche k'u'jlanteya toj nak'b'il.</para>
  <para style="q2">
    <verse number="7" style="v" />Tenxwit nak'b'il toju' nimaqtapi;</para>
  <para style="q2">tenxwit q'uqb'ab'l tk'u'jlalil kyoju' ja te nimaqkawb'il. Chechiku'ye'.</para>
  <para style="b" />
  <para style="q">
    <verse number="8" style="v" />Atzu'n ja'lo, naq kyu'nelju' wamiwe', ntzike' ex witz'ine', knma'ye':</para>
  <para style="q2">Tenxwit nak'b'il toja.</para>
  <para style="q2">
    <verse number="9" style="v" />Tu'nelju' tja Qman Dyos,</para>
  <para style="q2">k'okyeltilil wu'ne' tu'n tten nak'b'il toja, chiju' b'itzal.</para>
  <chapter number="123" style="c" />
  <para style="s1">Kub'sb'il tu'n tqe qk'u'j ti'j Dyos</para>
  <para style="q">
    <verse number="1" style="v" />Twitza Nman Dyos nchin kub'sana'ye';</para>
  <para style="q">twitza aya nkawina toj kya'j.</para>
  <para style="q">
    <verse number="2" style="v" />In qokub'san te Qman Dyos, ja q'uqla' qk'u'j.</para>
  <para style="q">inqo' ayon tu'n ttzaj q'aq'an tk'u'j qi'j,</para>
  <para style="q">kse'n jun majin ichan mujqa qya inok qe tk'u'j ti'ju' tajaw.</para>
  <para style="q">
    <verse number="3" style="v" />Q'aq'antz tk'u'ja qi'je' Nman Dyos;</para>
  <para style="q">q'aq'antz tk'u'ja qi'je',</para>
  <para style="q">qu'n lay tzik'xtlju' ik'b'ilqeye' qu'ne'.</para>
  <para style="q">
    <verse number="4" style="v" />¡Matxi'xi'x qoyajtiye'</para>
  <para style="q">tu'n xmayb'ilqeye' kyu'n q'inun</para>
  <para style="q">ex tu'n ik'o'n qo'ye' kyu'nju' nkynima'n kyib'! Chiju' b'itzal.</para>
  <chapter number="124" style="c" />
  <para style="s1">A Qman Dyos klol kye aj Israel</para>
  <para style="q">
    <verse number="1" style="v" />Naqwit min xten Qman Dyos onil quk'i'l</para>
  <para style="q2">kyximankupe'ye' aj Israel,</para>
  <para style="q">
    <verse number="2" style="v" />naqwit min xten Qman Dyos onil quk'i'l</para>
  <para style="q">tej xjaw kyi'nkyib'ju' xjal q'ojil qi'j,</para>
  <para style="q">
    <verse number="3" style="v" />itz'qo'xwitlo xqoku'x toj kylaq</para>
  <para style="q">tej saj kytx'u'jil qi'j.</para>
  <para style="q">
    <verse number="4" style="v" />Ma'wtlo qo'x tiqa'n a';</para>
  <para style="q">¡junwtlo tnimal a' sex qib'aj!</para>
  <para style="q">
    <verse number="5" style="v" />¡Ma'txi'wtlo qokyaj jaq'wi</para>
  <para style="q">tjaq'ju' tipumal a'!</para>
  <para style="b" />
  <para style="q">
    <verse number="6" style="v" />¡Nimanjtzxwit Qman Dyos,</para>
  <para style="q">min xtaj tu'n qb'aj tzaqun tu'n kywitzte!</para>
  <para style="q">
    <verse number="7" style="v" />Maqo tzaqpaj teju' xpatxab'</para>
  <para style="q">kse'n jun pich' xtzaqpaj tu'n aj ub'al;</para>
  <para style="q">laqju' xpatxab', qu'mtzun o' tzaqpaj.</para>
  <para style="q">
    <verse number="8" style="v" />Xi' saja'ju' o'nb'il qe tuk'i'l Qman Dyos,</para>
  <para style="q">b'inchalte kya'j ex tx'otx'. Chiju' b'itzal.</para>
  <chapter number="125" style="c" />
  <para style="s1">Nche tklo'n Qman Dyos e'te</para>
  <para style="q">
    <verse number="1" style="v" />Min nche yukchikye' q'uqlok kyk'u'j ti'j Qman Dyos;</para>
  <para style="q">ikyqe' kse'n witz Syon, ati tejumajx.</para>
  <para style="q">
    <verse number="2" style="v" />Ikyqe' kse'n Jerusalen txoli'nmile ti'j kyu'n witz,</para>
  <para style="q">klo'mile kyi'ju' ttanam Qman Dyos tu'n, te ja'lo ex tejumajx.</para>
  <para style="q">
    <verse number="3" style="v" />Lay tenju' kawb'il myab'a'n kukxju'</para>
  <para style="q">toju' tx'otx' xitq'o'n Qman Dyos kyeju' ttanam,</para>
  <para style="q">qu'n jaku' o'kx ajtaq'wiju' ttanam</para>
  <para style="q">b'inchal myab'a'n.</para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" />Nman Dyos, b'inchama b'a'n kyeju' b'a'n xjal,</para>
  <para style="q">kyeju' ax che yolin;</para>
  <para style="q">
    <verse number="5" style="v" />aye'tzu'n nche b'je'l txalpuj</para>
  <para style="q">tz'e'ysa'nku'ya kywitz junx kyuky'i'lju' b'inchal myab'a'n</para>
  <para style="q">¡Tenxwit nak'b'il toj Israel! chiju' b'itzal.</para>
  <chapter number="126" style="c" />
  <para style="s1">B'itz tu'n tanjtlkyi'ju' aj Israel toj Jerusalen</para>
  <para style="q">
    <verse number="1" style="v" />Tej tanjtzti'n Qman Dyos ttanam toj Jerusalen,</para>
  <para style="q">naku'j naq jun witzik' toj qwitze'.</para>
  <para style="q">
    <verse number="2" style="v" />Ojexi'x qo tzalaje' ex ob'itzane' tu'n qtzalajb'ile';</para>
  <para style="q">aye'tzu'n nche niman kye txqantl dyos, kyma:</para>
  <para style="q">¡Matxi' tb'incha Dyos nimaq ti'xti' kyeju' ttanam! Chechij.</para>
  <para style="q">
    <verse number="3" style="v" />Iku', tb'inchate Qman Dyos nimaq ti'xti' qeye',</para>
  <para style="q">qu'mtzun inxi'xtoq qo tzalaje'.</para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" />¡Nman Dyos, qo tq'ok jumajtla kse'n tnejel,</para>
  <para style="q">kse'n chq'ajlaj nch'ixpuj tu'n jb'al!</para>
  <para style="q">
    <verse number="5" style="v" />Aye'kye' nche oq' aj kyawan,</para>
  <para style="q">kjawil twitz kyawal toj tzalajb'il.</para>
  <para style="q">
    <verse number="6" style="v" />B'a'nqa nche oq' ajkyxi' awalteju' ij,</para>
  <para style="q">che tzalajel ajtanjtzkyi'j</para>
  <para style="q">iq'i'mile junjun pk'oj kytriy. Chiju' b'itzal.</para>
  <chapter number="127" style="c" />
  <para style="s1">A Qman Dyos ntzaj q'onte tkyaqil</para>
  <para style="q">
    <verse number="1" style="v" />Qa mya Qman Dyos njaw b'inchanteju' ja,</para>
  <para style="q">mixti'x nche oka'ju' nche aq'unan ti'j;</para>
  <para style="q">qa mya Qman Dyos nklonteju' nintnam,</para>
  <para style="q">mixti'x nche oka'kye' xq'uqil.</para>
  <para style="q">
    <verse number="2" style="v" />Mixti'x nnoka'te' b'a'n prim nqo' aq'unan ex yaj nqo qen</para>
  <para style="q">inxi'x qb'yo'nqib' tu'n tpaj qwa,</para>
  <para style="q">aye'tzu'n k'u'jla'nqe' tu'n Qman Dyos inche ojlan ex ky'i'wla'nqe'.</para>
  <para style="b" />
  <para style="q">
    <verse number="3" style="v" />Tb'anilxi'x qekye' qk'wal nche itz'ji</para>
  <para style="q">qu'n toyaj Dyos qe'.</para>
  <para style="q">
    <verse number="4" style="v" />Ikyqe'kye qk'walju' nche itz'ji toj qku'xumal</para>
  <para style="q">kse'n smaj toj tq'ob' jun q'ojil.</para>
  <para style="q">
    <verse number="5" style="v" />¡Tzalajb'ilte' teju' xjal ate' txqan tk'wal kse'nqe' talsmaj!</para>
  <para style="q">qu'n lay kub'ti'j kyu'n tajq'oj,</para>
  <para style="q">aj tklontetib' kyekywitz ajkawil. Chiju' b'itzal.</para>
  <chapter number="128" style="c" />
  <para style="s1">Tky'i'wb'il Qman Dyos</para>
  <para style="q">
    <verse number="1" style="v" />Tzalajb'ilte' teya, innimana te Qman Dyos</para>
  <para style="q">ex b'a'n b'ina te.</para>
  <para style="q">
    <verse number="2" style="v" />Kwala ti'ju' twitz taq'unb'ena,</para>
  <para style="q">ktzalajela ex b'a'n kxe'la'ya.</para>
  <para style="q">
    <verse number="3" style="v" />K'okyelju' t-xu'jila toj tjaya,</para>
  <para style="q">kse'n jun tqan ub'a txijli toj twitz;</para>
  <para style="q">q'uqliqe'kju' tk'wala ti'j tmesa,</para>
  <para style="q">ikqe' kse'n t-xul olib'o.</para>
  <para style="q">
    <verse number="4" style="v" />Iktzu'n kb'el tky'i'wla'n Qman Dyos xjal nniman te.</para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" />¡Awt Qman Dyos ky'iwlanteya tzmax twi' witz Syon!</para>
  <para style="q">¡Tka'yixwita b'a'n ta' Jerusalen</para>
  <para style="q">toj tkyaqilju' tchwinqlala!</para>
  <para style="q">
    <verse number="6" style="v" />¡Che' tilxwitju'ya tal tchmana!</para>
  <para style="b" />
  <para style="q">¡Tenxwit nak'b'il toj Israel! Chiju' b'itzal.</para>
  <chapter number="129" style="c" />
  <para style="s1">In qo ttzaqpi'n Qman Dyos</para>
  <para style="q">
    <verse number="1" style="v" />Nim yajb'il matxi' chin nik'a'ye'</para>
  <para style="q">atxi'x toj nku'xumale'</para>
  <para style="q">—ma ax Israel mujqa mya—,</para>
  <para style="q">
    <verse number="2" style="v" />Nim yajb'il matxi' chin nik'a'ye'</para>
  <para style="q">atxi'xj toj nku'xumale',</para>
  <para style="q">ex min nkub'wi'je' kyu'n.</para>
  <para style="q">
    <verse number="3" style="v" />Matxi' b'aj kyk'ixb'sa'n tze'lwi'je' tu'n sjikyb'enweye',</para>
  <para style="q">ex majx machin b'aj lanq'uje' kyu'n,</para>
  <para style="q">
    <verse number="4" style="v" />atzunte Qman Dyos tnik'alti'j,</para>
  <para style="q">machin tkole' toj kyq'ob'ju' b'inchal myab'a'n.</para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" />¡Tz'elxwit kych'ixawju' ajq'oj ti'j Syon</para>
  <para style="q">ex che kub'xwit oq!</para>
  <para style="q">
    <verse number="6" style="v" />¡Che okxwit kse'n k'ul intzaj ch'iy twi' ja,</para>
  <para style="q">na'mxtoqpe' kyjaw xb'oqi'n ajkytzqij!</para>
  <para style="q">
    <verse number="7" style="v" />Mixti'x tajb'enju' k'ul na'j</para>
  <para style="q">teju' ch'umal triy;</para>
  <para style="q">
    <verse number="8" style="v" />exqepe' nche b'jik' kyk'etz lay kma:</para>
  <para style="q">¡Ky'iwla'nxi'x tu'n Qman Dyos! chechiwt.</para>
  <para style="b" />
  <para style="q">In qqani'nqe' b'a'n kyib'aje' toj tb'i Qman Dyos, chiju' b'itzal.</para>
  <chapter number="130" style="c" />
  <para style="s1">Ti'j Qman Dyos q'uqla' qk'u'j</para>
  <para style="q">
    <verse number="1" style="v" />Inchin kub'sane' teya Nman Dyos</para>
  <para style="q">kse'n inxi'x chin yajtiye':</para>
  <para style="q">
    <verse number="2" style="v" />¡chin tb'intza, Nman Dyos!</para>
  <para style="q">¡tzaq'wentzju'ya nkub'sb'ile'!</para>
  <para style="b" />
  <para style="q">
    <verse number="3" style="v" />Taye, Nman Dyos,</para>
  <para style="q">noqwit min nik'tna'lju' qile' tu'na,</para>
  <para style="q">¿alxi'xwitlokye kb'entel tkyajwe' twitza?</para>
  <para style="q">
    <verse number="4" style="v" />A na'ta nkub'najsante qile',</para>
  <para style="q">tu'ntzun qnimane' teya.</para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" />Inchin ayone' te Qman Dyos tuk'i'l tkyaqil nk'u'je',</para>
  <para style="q">q'uqliwe' nk'u'j ti'ju' tyol.</para>
  <para style="q">
    <verse number="6" style="v" />Inxi'x chin ayonwe' ti'j Qman Dyos</para>
  <para style="q">kyekywitzju' xq'uqil tnam.</para>
  <para style="q">Kse'nqe' xq'uqil nche ayon tu'n qsqix,</para>
  <para style="q">
    <verse number="7" style="v" />ikxtzunkyeju'ye' aj Israel, che ayone' te Qman Dyos,</para>
  <para style="q">tuk'i'l na'te ta'ju' tk'u'jlalil ex tzaqpib'l axxi'x.</para>
  <para style="q">
    <verse number="8" style="v" />¡Ate tzaqpilkye aj Israel te tkyaqilju' kyb'inchb'en myab'a'n! Chiju' b'itzal.</para>
  <chapter number="131" style="c" />
  <para style="s1">Na'j Dyos q'uqlixi'x tk'u'jlalil</para>
  <para style="q">
    <verse number="1" style="v" />Nman Dyos, mixti' njaw nnima'nwe' wib',</para>
  <para style="q">ex mya mixwitti' tz'oka' juntl weye',</para>
  <para style="q">ex min nb'ajx nk'u'je' kyi'j txqan ti'xti' te lab'te'n</para>
  <para style="q">qa mixti' tu'me'l tu'n tten weye'.</para>
  <para style="q">
    <verse number="2" style="v" />Naqpena' k'otzlqiwe',</para>
  <para style="q">kse'n jun ne'ẍ akxtoq tb'aj ch'u'n</para>
  <para style="q">chle'n tu'n ttxu.</para>
  <para style="q">¡Ikyqinju'ye' kse'n jun ne'ẍ akxtoq tb'aj ch'u'n!</para>
  <para style="b" />
  <para style="q">
    <verse number="3" style="v" />Aj Israel, che ayonqe'ye' ti'j Qman Dyos ja'lo ex tejumajx. Chiju' b'itzal.</para>
  <chapter number="132" style="c" />
  <para style="s1">Aye' yol ttziya Qman Dyos te Dab'i</para>
  <para style="q">
    <verse number="1-2" style="v" />Nman Dyos nimtipumal, ja k'uluna' Jakob',</para>
  <para style="q">na'ntza Dab'i toj tkyaqilju' yajb'ilte;</para>
  <para style="q">na'ntzju'ya tyol xi'ni ttziya'n teya:</para>
  <para style="q">
    <verse number="3" style="v" />Lay chin okxe' toj njaye'</para>
  <para style="q">expe' lay chin kub' kẍeye' ojlal,</para>
  <para style="q">
    <verse number="4" style="v" />lay che kub' nmtz'u'n nwitze'</para>
  <para style="q">ex lay chinwtan jun kmuje',</para>
  <para style="q">
    <verse number="5" style="v" />qa na'mxtoq tknet jun najb'il wu'ne'</para>
  <para style="q">te Qman Dyos nimtipumal ja ajb'ena' Jakob', chij.</para>
  <para style="b" />
  <para style="q">
    <verse number="6" style="v" />Qb'iye' Eprata ntoq yolinjtz tkaxilju' tyol Dyos kyejni b'entti'j,</para>
  <para style="q">ex knet qu'ne' toj kojb'il tij Jaar.</para>
  <para style="q">
    <verse number="7" style="v" />¡Qo'qe'ye' toj tja Qman Dyos xjan!</para>
  <para style="q">¡Qoqe' mejeku' t-xe tqan!</para>
  <para style="b" />
  <para style="q">
    <verse number="8" style="v" />Iq'i'nktz tib'a, Nman Dyos, tuk'i'lju' kax te ipumalj,</para>
  <para style="q">ex kuttzaja twi' witz ja knajala'ya.</para>
  <para style="q">
    <verse number="9" style="v" />Che ktxet-xwitju' pale twitza tu'n tnik'alilti'j;</para>
  <para style="q">qo ẍch'inxwite' tuk'i'l tzalajb'il ayo'ye' nqo nimane' teya.</para>
  <para style="q">
    <verse number="10" style="v" />Lalun tz'el tik'o'na nimaqkawil jawni t-sk'o'na,</para>
  <para style="q">noqx tu'n tk'u'jlalila ti'ju' tmajena Dab'i.</para>
  <para style="b" />
  <para style="q">
    <verse number="11" style="v" />Tzaj ttziya'n Qman Dyos tyol te Dab'i,</para>
  <para style="q">ex lay tz'anjtzti'j tk'u'j:</para>
  <para style="q">
    <verse number="12" style="v" />K'okyex nq'o'n junju'ye' tk'wala toju' tkawb'ila</para>
  <para style="q">qama japun nyole' kyejni b'entti'j</para>
  <para style="q">exqe' nchaq'b'ile' che kxe'l nxnaq'tza'ne' kye,</para>
  <para style="q">ex che kb'elqeju' kyk'wal kukxju' toju' tq'uqb'ila. Chij.</para>
  <para style="b" />
  <para style="q">
    <verse number="13" style="v" />¡Matxi' jaw t-sk'o'n Qman Dyos witz Syon!</para>
  <para style="q">¡Matxi' jaw t-sk'o'n tu'n tnajan atzu'!</para>
  <para style="q">
    <verse number="14" style="v" />A witz ja'lu ja wajb'ila'ye' tu'n ntene' kukxju';</para>
  <para style="q">chin najale' tib'aj qu'n a kub'ju' toj nwitze'.</para>
  <para style="q">
    <verse number="15" style="v" />Okxi'xb'el nky'i'wla'nju'ye' kywa</para>
  <para style="q">nim kywaju' prow kxe'l nq'o'ne'.</para>
  <para style="q">
    <verse number="16" style="v" />Che okyel nktxu'ne' pale kyxol tu'nju' kolb'il</para>
  <para style="q">ex che ẍch'ilju' nche niman kye tu'n kytzalajb'il.</para>
  <para style="q">
    <verse number="17" style="v" />Atzuntzu' k'itz'jela'tlju' kykawb'il tyajajil Dab'i wu'ne'.</para>
  <para style="q">Matxi' kub' nb'incha'ne' jun spik'un</para>
  <para style="q">teju' nimaqkawil oje jawnsk'o'ne'.</para>
  <para style="q">
    <verse number="18" style="v" />K'elel kych'ixawju' tajq'oj wu'ne',</para>
  <para style="q">atzunte kqoptz'ajel tajwalil wu'ne'. Chi Dyos, chiju' b'itzal.</para>
  <chapter number="133" style="c" />
  <para style="s1">B'itz ti'ju' mujb'ab'l toj tk'u'jlalil</para>
  <para style="q">
    <verse number="1" style="v" />¡Kyka'yinxpe'ye', tb'anilxi'x ex tzalajb'ilju'</para>
  <para style="q">nche anq'inju' kyitz'inkyib' toj mujb'ab'ltib'il!</para>
  <para style="q">
    <verse number="2" style="v" />Tb'anilxi'x kse'n tk'ok'jal tb'anil k'ok'sb'il</para>
  <para style="q">njawx toj kywi' pale</para>
  <para style="q">inkb'u'l tib'aj kyxmatzi</para>
  <para style="q">ex nkb'u'l tib'aj tqulju' kyxb'alun.</para>
  <para style="q">
    <verse number="3" style="v" />Tb'anilxi'x kse'n ta'l muj nkub' twi' witz Ermon toj tb'a'nq'ob'kya'j</para>
  <para style="q">ex nkb'u'l tenenen tib'aju' witz Syon toj tnayajkya'j.</para>
  <para style="q">Aye'ju' nche anq'in ikyju', nche tzaj tky'i'wla'n Qman Dyos</para>
  <para style="q">tu'n jun chwinqlal nimtoj, chiju' b'itzal.</para>
  <chapter number="134" style="c" />
  <para style="s1">Awt Qman Dyos ky'i'wlanteya</para>
  <para style="q">
    <verse number="1" style="v" />¡Qo'qe'ye' e'tmajen Qman Dyos!</para>
  <para style="q">¡Kyajwali'nktze' Qman Dyos kykyaqile',</para>
  <para style="q">inche tene' toju' tja te qonik'an!</para>
  <para style="q">
    <verse number="2" style="v" />¡Kyiq'i'nktze' kyq'ob'e' tu'me'lju' ja xjan</para>
  <para style="q">ex kyajwali'nktze' Qman Dyos!</para>
  <para style="q">
    <verse number="3" style="v" />¡Awtju' Qman Dyos b'inchante kya'j ex tx'otx',</para>
  <para style="q">tzaj ky'iwlanteya tzmaxtzu' twi' witz Syon! Chiju' b'itzal.</para>
  <chapter number="135" style="c" />
  <para style="s1">Tb'inchb'aj Qman Dyos nimaq kyoklen</para>
  <para style="q">
    <verse number="1" style="v" />¡Ajwalinjtzxwit Qman Dyos!</para>
  <para style="b" />
  <para style="q">Kyajwali'nktze' tb'i Qman Dyos;</para>
  <para style="q">kyajwali'nktze' aye'ye' ajb'el te,</para>
  <para style="q">
    <verse number="2" style="v" />ate'qe'ye' toj tja Qman Dyos,</para>
  <para style="q">exqe'ye' ate'ye' tpen tja Qman Dyos.</para>
  <para style="q">
    <verse number="3" style="v" />Kyajwali'nktze' Qman Dyos, qu'n tb'anilte;</para>
  <para style="q">che b'itzan qe'ye' toj tb'i, qu'n in q'aq'an tk'u'j qi'j.</para>
  <para style="q">
    <verse number="4" style="v" />Qu'n jaw t-sk'o'n Jakob', aju' Israel,</para>
  <para style="q">tu'n tok naku'j tkuwenku'xi'x.</para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" />Kanlixi'x nwitze' nimxi'xte Qman Dyos toklen</para>
  <para style="q">kyekywitz kykyaqilju' kydyos xjal.</para>
  <para style="q">
    <verse number="6" style="v" />Intb'incha'nte Qman Dyos tkyaqilju' b'a'n toj twitz,</para>
  <para style="q">toj kya'j ex twitz tx'otx',</para>
  <para style="q">toj ninnjab' ex t-xexi' ninnjab'.</para>
  <para style="q">
    <verse number="7" style="v" />Injaw muj tu'n tib'aj tkyaqil twitz tx'otx',</para>
  <para style="q">intzaj tq'o'n xloq'lokya'j tu'n ttzaj jb'al,</para>
  <para style="q">ex nche etztiq'i'n kyq'iq' ja b'uyina'kyib'.</para>
  <para style="q">
    <verse number="8" style="v" />A kub' b'yonkye kykyaqil tnejel kyk'wal aj Ejipt</para>
  <para style="q">ex tnejel kyalju' kyalu'n.</para>
  <para style="q">
    <verse number="9" style="v" />E'tzaj tq'o'n techlal nimaq kyoklen</para>
  <para style="q">tojku'xi'xju' tnam Ejipt</para>
  <para style="q">tib'aj paraon ex kyib'aju' nche kawin tuk'i'l.</para>
  <para style="q">
    <verse number="10" style="v" />Eb'ajkub' tb'yo'n nimaqtnam,</para>
  <para style="q">eltiq'i'n kychwinqlalju' nimaqkawil nim kyipumal;</para>
  <para style="q">
    <verse number="11" style="v" />kub' tb'yo'n Siyon, nimaqkawil kye amorey,</para>
  <para style="q">ex Ow, nimaqkawil te B'asan,</para>
  <para style="q">ex kykyaqil nimaqkawil tij Kanaan e'kub'tb'yo'n;</para>
  <para style="q">
    <verse number="12" style="v" />atzu'n kytx'otx'ju' nimaqkawil lu</para>
  <para style="q">tzaj tq'o'n te kyetzb'ilju' ttanam aj Israel.</para>
  <para style="b" />
  <para style="q">
    <verse number="13" style="v" />Tejumajxte' tb'iya, Nman Dyos;</para>
  <para style="q">ktzajel na'na kukxju'.</para>
  <para style="q">
    <verse number="14" style="v" />Intb'incha'nte Qman Dyos tnik'alilti'j teju' ttanam;</para>
  <para style="q">in q'aq'an tk'u'j kyi'ju' tmajin.</para>
  <para style="q">
    <verse number="15" style="v" />Q'anpwaq ex saqpwaqqe' kywitzleb' txqantl tnam,</para>
  <para style="q">b'incha'nqe' tu'n q'ob'aj.</para>
  <para style="q">
    <verse number="16" style="v" />Ati kytzi, extzun min nb'ent kyolin;</para>
  <para style="q">ate' kywitz, extzun min nb'ent kyka'yin;</para>
  <para style="q">
    <verse number="17" style="v" />ate' kyẍkyin, extzun min nb'ent kyb'in;</para>
  <para style="q">¡mixpeti'x kychwinqlal!</para>
  <para style="q">
    <verse number="18" style="v" />Ikyqe'xtzun xjalju' nche kub' b'inchankye</para>
  <para style="q">exqe'ju' nche okslan kye.</para>
  <para style="b" />
  <para style="q">
    <verse number="19" style="v" />Kynimanktze' Qman Dyos aj Israel;</para>
  <para style="q">exqe'ye' pale, kynimanktze' Qman Dyos;</para>
  <para style="q">
    <verse number="20" style="v" />Kynimaktze' Qman Dyos aj Leb'i;</para>
  <para style="q">kyajwali'nktze' Qman Dyos, aye'ye' nche nimane' te.</para>
  <para style="q">
    <verse number="21" style="v" />¡Nimanjtzxwitju' Qman Dyos toj Syon</para>
  <para style="q">aju' najli toj Jerusalen!</para>
  <para style="b" />
  <para style="q">¡Ajwalinjtzxwit Qman Dyos! Chiju' b'itzal.</para>
  <chapter number="136" style="c" />
  <para style="s1">Tk'u'jlalil Qman Dyos tejumajx kyi'j aj Israel</para>
  <para style="q">
    <verse number="1" style="v" />Kyq'onx chjonteye' te Qman Dyos, qu'n majx b'a'n te,</para>
  <para style="q2">qu'n tejumajxju' tk'u'jlalil.</para>
  <para style="q">
    <verse number="2" style="v" />Kyq'onx chjonteye' te Dyos, aju' nimxi'x toklen kyib'aj txqantl dyos,</para>
  <para style="q2">qu'n tejumajxju' tk'u'jlalil.</para>
  <para style="q">
    <verse number="3" style="v" />Kyq'onx chjonteye' teju' Qman Dyos in kawin kyib'aj xjal ati kyoklen,</para>
  <para style="q2">qu'n tejumajxju' tk'u'jlalil.</para>
  <para style="q">
    <verse number="4" style="v" />Qu'n o'kxte nb'inchankye nimaq ti'xti' te lab'te'n,</para>
  <para style="q2">qu'n tejumajxju' tk'u'jlalil.</para>
  <para style="q">
    <verse number="5" style="v" />Teju' b'inchante kya'j tuk'i'l nab'l,</para>
  <para style="q2">qu'n tejumajxju' tk'u'jlalil.</para>
  <para style="q">
    <verse number="6" style="v" />Teju' kub' q'onte tx'otx' tib'aj a',</para>
  <para style="q2">qu'n tejumajxju' tk'u'jlalil.</para>
  <para style="q">
    <verse number="7" style="v" />Teju' kub' b'inchante q'ij ex xjaw,</para>
  <para style="q2">qu'n tejumajxju' tk'u'jlalil:</para>
  <para style="q">
    <verse number="8" style="v" />kub' tb'incha'n q'ij tu'n tk'ent te q'ijtl,</para>
  <para style="q2">qu'n tejumajxju' tk'u'jlalil;</para>
  <para style="q">
    <verse number="9" style="v" />exju' xjaw kyuk'i'lju' che'w tu'n kyk'ent te qonik'an,</para>
  <para style="q2">qu'n tejumajxju' tk'u'jlalil.</para>
  <para style="q">
    <verse number="10" style="v" />Kyq'onx chjonteye' teju' kub' b'yonkye tnejel kyk'wal kykyaqilju' aj Ejipt,</para>
  <para style="q2">qu'n tejumajxju' tk'u'jlalil.</para>
  <para style="q">
    <verse number="11" style="v" />Teju' etz iq'inkye aj Israel toj Ejipt,</para>
  <para style="q2">qu'n tejumajxju' tk'u'jlalil;</para>
  <para style="q">
    <verse number="12" style="v" />tej txi' tnuqpi'n tq'ob' tuk'i'l nim tipumal,</para>
  <para style="q2">qu'n tejumajxju' tk'u'jlalil.</para>
  <para style="q">
    <verse number="13" style="v" />Teju' aq'punte Kyeq Ninnjab',</para>
  <para style="q2">qu'n tejumajxju' tk'u'jlalil.</para>
  <para style="q">
    <verse number="14" style="v" />Teju' ik'xq'inkye aj Israel toj ninnjab',</para>
  <para style="q2">qu'n tejumajxju' tk'u'jlalil.</para>
  <para style="q">
    <verse number="15" style="v" />Teju' kyej mulq'inte Paraon kyuk'i'l t-xjal te q'oj toju' Kyeq Ninnjab',</para>
  <para style="q2">qu'n tejumajxju' tk'u'jlalil.</para>
  <para style="q">
    <verse number="16" style="v" />Teju' xiq'inte ttanam toj chq'ajlaj,</para>
  <para style="q2">qu'n tejumajxju' tk'u'jlalil.</para>
  <para style="q">
    <verse number="17" style="v" />Teju' kub' b'yonkye nimaqkawil,</para>
  <para style="q2">qu'n tejumajxju' tk'u'jlalil.</para>
  <para style="q">
    <verse number="18" style="v" />Teju' elq'inte kychwinqlalju' nimaqkawil nim kyipumal,</para>
  <para style="q2">qu'n tejumajxju' tk'u'jlalil:</para>
  <para style="q">
    <verse number="19" style="v" />Teju' kub' b'yonte Siyon, nimaqkawil kye amorey,</para>
  <para style="q2">qu'n tejumajxju' tk'u'jlalil;</para>
  <para style="q">
    <verse number="20" style="v" />Teju' kub' b'yonte Ow, nimaqkawil te B'asan,</para>
  <para style="q2">qu'n tejumajxju' tk'u'jlalil.</para>
  <para style="q">
    <verse number="21" style="v" />Teju' kub'sipante kytx'otx'ju' nimaqkawil lu,</para>
  <para style="q2">qu'n tejumajxju' tk'u'jlalil,</para>
  <para style="q">
    <verse number="22" style="v" />tzaj tq'o'ntzuntz te kyetzb'il aj Israel tmajen,</para>
  <para style="q2">qu'n tejumajxju' tk'u'jlalil.</para>
  <para style="q">
    <verse number="23" style="v" />Teju' ntzaj na'nqe kse'n ato'qo' toj yajb'il,</para>
  <para style="q2">qu'n tejumajxju' tk'u'jlalil.</para>
  <para style="q">
    <verse number="24" style="v" />Teju' nklonqe kyeju' qajq'oj,</para>
  <para style="q2">qu'n tejumajxju' tk'u'jlalil.</para>
  <para style="q">
    <verse number="25" style="v" />Teju' intzaj q'onte kwa xjal ex kwa alu'mj,</para>
  <para style="q2">qu'n tejumajxju' tk'u'jlalil.</para>
  <para style="q">
    <verse number="26" style="v" />¡Kyq'onx chjonteye' teju' Qman Dyos te toj kya'j,</para>
  <para style="q2">qu'n tejumajxju' tk'u'jlalil! Chiju' b'itzal.</para>
  <chapter number="137" style="c" />
  <para style="s1">Kytzi nin a' toj B'ab'ilon</para>
  <para style="q">
    <verse number="1" style="v" />Q'uqliqo'toqe' kytziju' nin a' B'ab'ilon,</para>
  <para style="q">nqo oq'e' ajttzaj qna'nju'ye' tnam Syon.</para>
  <para style="q">
    <verse number="2" style="v" />Intoq che jaw qyob'a'ne' qchinab'e' arpa</para>
  <para style="q">kyi'ju' tze chjaj ate' toju' nintnam.</para>
  <para style="q">
    <verse number="3" style="v" />Aye'tzu'n e'xiq'inqeye' tu'n qjpunjtze' atzu',</para>
  <para style="q">aye' eb'je'l q'inkye tkyaqilju' ti'xti' qeye',</para>
  <para style="q">intoq kyma'n tu'n qb'itzane' tuk'i'l tzalajb'il;</para>
  <para style="q">¡tu'n kyxi' qb'itza'nju'ye' b'itz ti'j Syon!</para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" />¿Se'n taq'wi qo b'itzal b'itze' te Qman Dyos</para>
  <para style="q">toj junxi'tl tx'otx'?</para>
  <para style="q">
    <verse number="5" style="v" />¡Kyajxwit tzqiju' nb'anq'ob'e',</para>
  <para style="q">qama tzik'tna'la Jerusalen wu'ne'!</para>
  <para style="q">
    <verse number="6" style="v" />¡Tz'okxwit lak'e waq'e' toj nk'o'ne'</para>
  <para style="q">qa min saj nna'na Jerusalen,</para>
  <para style="q">qa min xjaw nnima'na nejtl</para>
  <para style="q">twitz tkyaqil ntzalajb'ile'!</para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" />Nman Dyos, na'ntza titi' kyma aj Edom,</para>
  <para style="q">tej tkub' tz'aq Jerusalen:</para>
  <para style="q">¡Kyxitunku'ye', kyxitunku'ye' kyuk'i'lxi' tq'uqlil! chechij.</para>
  <para style="b" />
  <para style="q">
    <verse number="8" style="v" />¡Atzunta B'ab'ilon, kb'el xitu'na!</para>
  <para style="q">¡Tzalajb'ilte' teju' k'okyel q'onte tu'me'l t-xel teya</para>
  <para style="q">tu'nju' xtb'inchaya qeye'!</para>
  <para style="q">
    <verse number="9" style="v" />¡Tzalajb'ilte' teju' kb'eltzyunkyeju' tk'wala</para>
  <para style="q">tu'n kyok tb'uchi'n kyi'j pik! Chiju' b'itzal.</para>
  <chapter number="138" style="c" />
  <para style="s1">Na'j Dyos aq'b'il chjonte te Qman Dyos</para>
  <para style="q">
    <verse number="1" style="v" />Knq'a' chjonteye' teya Nman Dyos, tu'n tkyaqil nk'u'je';</para>
  <para style="q">kywitzku'pe' txqantl dyos chin b'itzale' teya.</para>
  <para style="q">
    <verse number="2" style="v" />Chin b'el mejeye' tu'me'lju' tjaya xjan</para>
  <para style="q">q'ol chjonte teya tu'nju' tk'u'jlalila ex tyola njapun,</para>
  <para style="q">qu'n majaw tq'o'nju'ya tb'iya ex tyola</para>
  <para style="q">tib'aj tkyaqil ti'xti'.</para>
  <para style="q">
    <verse number="3" style="v" />Tej nkub'sane' teya, intzaj ttzaq'we'na,</para>
  <para style="q">ex nim wipumale' tzaj tq'o'na.</para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" />Che b'itzal kykyaqil nimaqkawil te twitz tx'otx' teya</para>
  <para style="q">aj t-xikyb'i'nju' yol kyejni ttziya'na.</para>
  <para style="q">
    <verse number="5" style="v" />Kjawil ajwali'na Nman Dyos tu'n tkyaqilju' matxi' kub' t-xima'na,</para>
  <para style="q">qu'n nim toklenju' tajwalila.</para>
  <para style="q">
    <verse number="6" style="v" />B'a'nqa tzmaxtzu' toj kya'j ta'ya Nman Dyos,</para>
  <para style="q">majx ka'yi'nju' xjal me's tu'na,</para>
  <para style="q">atzunju' ntnima'ntib' najchaq ta' ti'ja.</para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" />Aya nxq'uqinte nchwinqlale',</para>
  <para style="q">tu'n tipumala</para>
  <para style="q">kse'n atinqine' toj xob'ajil,</para>
  <para style="q">inchin tklo'na te kytx'u'jilju' wajq'oje.</para>
  <para style="q">
    <verse number="8" style="v" />¡Ktb'incha'ta tb'is tk'u'j weye' Nman Dyos!</para>
  <para style="q">Nman Dyos, tejumajxte' tk'u'jlalila;</para>
  <para style="q">¡Lalun kyejteneju' taq'una oje tzyet tu'na! Chiju' b'itzal.</para>
  <chapter number="139" style="c" />
  <para style="s1">Tkyaqil chik'li twitz Qman Dyos</para>
  <para style="q">
    <verse number="1" style="v" />Nman Dyos, matxi' tzik'twitza wi'je' ex tojtzqi'n qina;</para>
  <para style="q">
    <verse number="2" style="v" />Tojtzqi'na tkyaqil nb'incha'ne';</para>
  <para style="q">b'a'nqa najchaq ta'ya, inel tnik'a ti'ju' nxima'ne'.</para>
  <para style="q">
    <verse number="3" style="v" />Tojtzqi'na tkyaqilju' nb'eye',</para>
  <para style="q">¡kanli twitza tkyaqilju' in nb'incha'ne'!</para>
  <para style="q">
    <verse number="4" style="v" />Na'mxtoqpe' tel nma'n jun nyole',</para>
  <para style="q">kanlinajtl twitza, Nman Dyos.</para>
  <para style="q">
    <verse number="5" style="v" />Atiya wi'jileye';</para>
  <para style="q">tkub'ju' tq'ob'a wib'aje' kolb'ilweye'.</para>
  <para style="q">
    <verse number="6" style="v" />Lab'te'nxi'xte' ojtzqib'l lu, min nchin kanune' ti'j;</para>
  <para style="q">¡nimxi'xte', layx kane toj nwitze'!</para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" />¿Jaloja tu'n nxa'ye' najchaq, ewal twitzju' t-xewa?</para>
  <para style="q">¿Jaloja tu'n nxa' oqe' twitza?</para>
  <para style="q">
    <verse number="8" style="v" />Qama chin jawxe' twitz kya'j,</para>
  <para style="q">atiya atzu';</para>
  <para style="q">qama chin ku'xe' tjaq' tx'otx',</para>
  <para style="q">ex atiya atzu';</para>
  <para style="q">
    <verse number="9" style="v" />qama chinx lipane' toj tjawetzq'ij,</para>
  <para style="q">mujqa chinxwite' najal jlajxi' Ninnjab' tkub'exq'ij,</para>
  <para style="q">
    <verse number="10" style="v" />ex atinqine' toj tq'ob'a atzu';</para>
  <para style="q">¡lay chin kyej ttzaqpi'ne' tb'a'nq'ob'a!</para>
  <para style="q">
    <verse number="11" style="v" />Qama kub' nxima'ne' tu'n wewane' toj qxopin,</para>
  <para style="q">mujqa jawwit b'entju' spik'un wi'jileye' te qonik'an,</para>
  <para style="q">
    <verse number="12" style="v" />laype' b'ent nkub' tewa'ne' qxopin twitza,</para>
  <para style="q">ex spik'unte' qonik'an teya, kse'nxju' q'ijtl.</para>
  <para style="q">¡Junqe'xkye' qxopin tuk'i'lju' spik'un teya!</para>
  <para style="q">
    <verse number="13" style="v" />Aya kub' b'inchante tkyaqil nxmilale';</para>
  <para style="q">inkub' tb'incha'na toj t-xmilal ntxuye'.</para>
  <para style="q">
    <verse number="14" style="v" />Njaw wajwali'na qu'n nchin lab'tiye' tu'nju' ntene' ẍinkub' tb'incha'na,</para>
  <para style="q">qu'n lab'te'nxi'xte' tb'inchb'aja.</para>
  <para style="q">¡Matxi' tz'el nnik'e' ti'j b'a'nxi'x!</para>
  <para style="q">
    <verse number="15" style="v" />Mya ewaj nch'iya'ye' twitza</para>
  <para style="q">tej ẍinaq' kuwixe' toj t-xmilal ntxuye',</para>
  <para style="q">tej nchin ch'iye' toj ewaj.</para>
  <para style="q">
    <verse number="16" style="v" />Tilya tej intoq tb'incha'ntib'ju' nxmilale' tu'n tch'iy;</para>
  <para style="q">tkyaqil ja'lu tz'ib'a'nqe'tltoq toju' tuja.</para>
  <para style="q">Na'mxtoqpe' witz'jiye'</para>
  <para style="q">matxi'toq kyej techi'nju'ya tab'q'iyil nchwinqlale'.</para>
  <para style="b" />
  <para style="q">
    <verse number="17" style="v" />Nman Dyos,</para>
  <para style="q">nimxi'x kyxilenju' t-xima weye';</para>
  <para style="q">¡ex layx b'ent kyajlet!</para>
  <para style="q">
    <verse number="18" style="v" />Chin okwit tene' ajlalkye, nimxi'xlo kyajlal kyetwitz twitz tz'awun;</para>
  <para style="q">qatzun mab'je'lpun kyajlet wu'ne', layxpe' cheb'aj kane toj nwitze'.</para>
  <para style="b" />
  <para style="q">
    <verse number="19" style="v" />Nman Dyos,</para>
  <para style="q">q'imila kychwinqlalju' b'inchal myab'a'n</para>
  <para style="q">ex laq'b'anqe'milju'ya b'yolxjal wi'je',</para>
  <para style="q">
    <verse number="20" style="v" />aye' nche yolin taq'wix ti'ja</para>
  <para style="q">ex naq kyak'a'n njaw kyi'nkyib' ti'ja.</para>
  <para style="b" />
  <para style="q">
    <verse number="21" style="v" />Nman Dyos,</para>
  <para style="q">Ina' che elwik'o'nwe' nche el ik'unteya</para>
  <para style="q">ex nche elnsuchu'nju'ye' nche q'ojink ti'ja.</para>
  <para style="q">
    <verse number="22" style="v" />¡Majx nche elwik'o'ne'!</para>
  <para style="q">¡Qu'n ex ajq'ojqe' wi'je'!</para>
  <para style="b" />
  <para style="q">
    <verse number="23" style="v" />Nman Dyos,</para>
  <para style="q">tzik'x twitza wi'je', tz'elx tnik'a ti'ju' wanmiye';</para>
  <para style="q">chin tq'oka toj joyb'ilwi'je', tz'elx tnik'a ti'ju' nnab'le';</para>
  <para style="q">
    <verse number="24" style="v" />ka'yintza qa nchin b'ete' toj tb'eyil taq'wixil,</para>
  <para style="q">chin t-ẍaqluxa toju' b'e tejumajx, chiju' b'itzal.</para>
  <chapter number="140" style="c" />
  <para style="s1">Na'j Dyos qanb'il kolb'il te Dyos</para>
  <para style="q">
    <verse number="1" style="v" />Nman Dyos, chin tkloma kyeju' b'inchal myab'a'n;</para>
  <para style="q">chin tkloma kyeju' nche q'ojin,</para>
  <para style="q">
    <verse number="2" style="v" />kyeju' o'kxtzu' toka' kywi' ti'ju' myab'a'n</para>
  <para style="q">ex q'achq'alx nche jyon q'oj.</para>
  <para style="q">
    <verse number="3" style="v" />Majx mya'l kyaq' kse'n ttz'u'lub' kan;</para>
  <para style="q">ikyqe' kyolju' kse'n tb'i'yb'il kan wotz.</para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" />Nman Dyos, chin tkloma toj kyq'ob'ju' b'inchal myab'a'n,</para>
  <para style="q">chin tkloma kyeju' nche q'ojin,</para>
  <para style="q">kyeju' nche ximan tu'n nkub' tz'aqe' kyu'n.</para>
  <para style="q">
    <verse number="5" style="v" />Matxi' kub' kyq'o'n ma' nkynima'n kyib' xpatxab' weye';</para>
  <para style="q">matxi' kub' kyq'o'n pa ex aqwil toj nb'eye'.</para>
  <para style="b" />
  <para style="q">
    <verse number="6" style="v" />Oje txinma'ne' te Qman Dyos: Teya nchin ajb'ena'ye';</para>
  <para style="q">¡b'intzju'ya tq'ojq'ojel nwi'ye' te kub'sb'il!</para>
  <para style="q">
    <verse number="7" style="v" />Taye, Nman Dyos, aya klol weye' nimtipumala,</para>
  <para style="q">intklo'na nchwinqlale' toj q'oj. Nchije'.</para>
  <para style="b" />
  <para style="q">
    <verse number="8-9" style="v" />Nman Dyos, lalun taja tu'n tjapu'n kyajb'ilju' b'inchal myab'a'n,</para>
  <para style="q">lalun taja tu'n tjapunju' kyxim.</para>
  <para style="q">Inkynima'nkyib'ju' txoli'nmile wi'je' kyu'n;</para>
  <para style="q">¡kyib'ajxwit kub'a' tz'aqju' taq'wixil nkytxko'n!</para>
  <para style="q">
    <verse number="10" style="v" />Kub'xwit tz'aq ttxalq'aq' nk'ant kyib'aj;</para>
  <para style="q">che ku'xxwit q'o'n toj jul, ja layx b'enta' kyjatz.</para>
  <para style="q">
    <verse number="11" style="v" />Mixwit tz'anq'ina'ju' nyolin xlab'yol twitz tx'otx';</para>
  <para style="q">kub'xwit xitu'nju' nq'ojin tu'n myab'a'n.</para>
  <para style="b" />
  <para style="q">
    <verse number="12" style="v" />B'i'n wu'ne' ntb'incha'nte Qman Dyos tnik'alilti'j teju' prow</para>
  <para style="q">ex nkolon ti'j toklenju' xjal prow.</para>
  <para style="q">
    <verse number="13" style="v" />Kjawil nima'n tb'iya kyu'n xjal tnik'alkyi'j;</para>
  <para style="q">¡che najalkye' xjal b'a'n kychwinqlal twitza! Chiju' b'itzal.</para>
  <chapter number="141" style="c" />
  <para style="s1">O'kxtzu' toka' nwitze' ti'ja</para>
  <para style="q">
    <verse number="1" style="v" />Nman Dyos, inchin kub'sane' teya: ¡lwix kuttzaja!,</para>
  <para style="q">¡b'intzju'ya tq'ojq'ojel nwi'ye' ajntxokone' teya!</para>
  <para style="q">
    <verse number="2" style="v" />Tz'okxwitju' nna'j Dyose' twitza kse'n sturak,</para>
  <para style="q">exqe' nq'ob'e' ate'ktz jawl che okxwit kse'n oyaj te qale.</para>
  <para style="b" />
  <para style="q">
    <verse number="3" style="v" />Nman Dyos, q'onka jun xq'uqilteju' ntziye'</para>
  <para style="q">lay taja naqx tu'n tel nma'n nyole'.</para>
  <para style="q">
    <verse number="4" style="v" />Lalun taja tu'n toknq'o'n nwi'ye' ti'ju' myab'a'n;</para>
  <para style="q">lalun taja tu'n nb'ete' toju' taq'wixil</para>
  <para style="q">ex tu'n lalun chin tene' kyoj ninwan kyuk'i'l b'inchal il.</para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" />Jun xtalb'ilte' ktb'incha' xjal tnik'alti'j weye' qama chin ttzak'uye',</para>
  <para style="q">k'elil weye' kse'n k'ok'sb'il qama chin ttzak'uye'.</para>
  <para style="q">Lay tz'el wik'o'ne';</para>
  <para style="q">ex nchin na'we' Dyos kukxju' tu'n tkub'aju' kyb'inchb'aj b'inchal il.</para>
  <para style="q">
    <verse number="6" style="v" />Che elix xonju' kynejel b'inchal myab'a'n twi' xaq,</para>
  <para style="q">kkaneb'iltzuntz toj kynab'l qa tb'anilxi'xju' nyole'.</para>
  <para style="q">
    <verse number="7" style="v" />Noqx che pomel xob'aj kyb'aqil toj jul,</para>
  <para style="q">kse'n nxichitu'n tx'otx' ajtjaw kjo'n.</para>
  <para style="q">
    <verse number="8" style="v" />Nman Dyos, majx tokwe' nnab'l ti'ja.</para>
  <para style="q">Ti'ja nklo'na' wib'e': lalun chin kyej tkolb'e'na.</para>
  <para style="q">
    <verse number="9" style="v" />Chin tkloma teju' xpatxab' xkub' qo'n weye'</para>
  <para style="q">te xpatxab' xkub' kyq'o'n b'inchal myab'a'n toj nb'eye'.</para>
  <para style="q">
    <verse number="10" style="v" />Che kub'xwit tz'aqu' b'inchal myab'a'n tojx kyxpatxab',</para>
  <para style="q">ayintzunwe' ljo'nwe' nb'e. Chiju' b'itzal.</para>
  <chapter number="142" style="c" />
  <para style="s1">Aya kolb'ilweye'</para>
  <para style="q">
    <verse number="1" style="v" />Inchin kub'sane' te Qman Dyos tuk'i'l tq'ojq'ojel nwi'ye' kuw,</para>
  <para style="q">inxinqani'ne' kuw tu'n ttzaj q'aq'an tk'u'j wi'je'.</para>
  <para style="q">
    <verse number="2" style="v" />Inxinchik'b'a'nju'ye yajb'ilweye' twitz Qman Dyos,</para>
  <para style="q">twitz nxa' nma'nju'ye' nb'ise'</para>
  <para style="q">
    <verse number="3" style="v" />Kse'n qa nchin b'isune' b'a'nxi'x.</para>
  <para style="b" />
  <para style="q">Nman Dyos, tojtzqi'n teju'ya nb'eye':</para>
  <para style="q">matxi' kub' q'o'n jun xpatxab'</para>
  <para style="q">toj ju' nb'eye'.</para>
  <para style="q">
    <verse number="4" style="v" />Inchinx ka'yine' toj nb'a'nq'ob'e'</para>
  <para style="q">mix-a'lo'x jun ntzaj klol weye'.</para>
  <para style="q">¡Mix-a'lo'x jun tu'n tkolon wi'je'!</para>
  <para style="q">¡Mix-a'lo'x jun nb'ajx tk'u'j wi'je'!</para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" />Nman Dyos, twitza nchin kub'sana'ye',</para>
  <para style="q">ex nxinma'ne' teya: Ateju'ya kolb'ilweye';</para>
  <para style="q">o'kxa q'uqb'al nk'u'je' toj nchwinqlale'. Nchije'.</para>
  <para style="q">
    <verse number="6" style="v" />B'intzju'ya nkub'sb'ile',</para>
  <para style="q">qu'n mixti'tl wipumale'.</para>
  <para style="q">Chin tkloma kyeju' ljo'n toj nq'ije' kyu'n,</para>
  <para style="q">qu'n nimxi'x kyipumal nwitze'.</para>
  <para style="q">
    <verse number="7" style="v" />Chin tiq'imitza toju' jitz'b'il weye'</para>
  <para style="q">tu'ntzun tjaw nnimsa'na.</para>
  <para style="q">Tzul kychmo'n kyib'ju' tnik'alkyi'j nk'etze'</para>
  <para style="q">aj tb'inchanteya b'a'n weye'. Chiju' b'itzal.</para>
  <chapter number="143" style="c" />
  <para style="s1">Matxi' tz'okqe nk'u'je' ti'ja</para>
  <para style="q">
    <verse number="1" style="v" />Nman Dyos, b'intzju'ya nna'j Dyose';</para>
  <para style="q">b'intzju'ya nkub'sb'ile' teya.</para>
  <para style="q">¡Chin ttzaq'wetza, tnik'altati'j ex njapun tyola!</para>
  <para style="q">
    <verse number="2" style="v" />Lalun ttxokju'ya tmajena tu'n tok toj xjel,</para>
  <para style="q">qu'n mix-a'lo'te jun mixwitti' til twitza.</para>
  <para style="b" />
  <para style="q">
    <verse number="3" style="v" />Inxi'x chin joyliye' kyu'n wajq'oje</para>
  <para style="q">matxi' chin kub'kyxone' twitz tx'otx';</para>
  <para style="q">nchin nexkyq'o'ne' tu'n nnajane' toj qlolj,</para>
  <para style="q">kse'nqe' ojtxi' kykyimlen.</para>
  <para style="q">
    <verse number="4" style="v" />Kxi' nkub'aje' tu'n b'is</para>
  <para style="q">inxi'x tzaj tchi wi'je'</para>
  <para style="q">
    <verse number="5" style="v" />Inche tzaj nna'nju'ye' tq'ijlalil ojtxi',</para>
  <para style="q">ex nchin ximane' kyi'j kykyaqilju' tb'inchb'ena.</para>
  <para style="q">
    <verse number="6" style="v" />Injaw wi'ne' nq'ob'e' twitza,</para>
  <para style="q">nchin k'wajtiye' ti'ja, kse'n tx'otx' tzqij.</para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" />Nman Dyos, ¡lwiyx chin tzaj ttzaq'we'na,</para>
  <para style="q">qu'n xi'tkub'aju' nxewe'!</para>
  <para style="q">Chin tonima, lalun kub' t-xk'ayi'ntib'a,</para>
  <para style="q">qu'n qatzun min, chin okyeltzuntze' kse'nqe' kyimni.</para>
  <para style="q">
    <verse number="8" style="v" />Yek'untza tk'u'jlalila weye' te prim,</para>
  <para style="q">qu'n ti'ja soka' qe nk'u'je'.</para>
  <para style="q">Q'mantza weye' kse'n tu'me'l tu'n wanq'ina'ye' twitza,</para>
  <para style="q">qu'n teya nxa' nkub'sa'na'ju'ye' wajb'ile'.</para>
  <para style="q">
    <verse number="9" style="v" />Nman Dyos, chin tkloma kyeju' wajq'oje,</para>
  <para style="q">qu'n tk'etza nnjyo'na'ye' kolb'il.</para>
  <para style="q">
    <verse number="10" style="v" />Chin t-xnaq'tzama tu'n nb'inchanteju'ye' tajb'ila,</para>
  <para style="q">qu'n teya nchin k'uluna'ye'.</para>
  <para style="q">¡Awtju' t-xewa txi' iq'inweye'</para>
  <para style="q">toju' b'e tzinun ti'j!</para>
  <para style="b" />
  <para style="q">
    <verse number="11" style="v" />¡Nman Dyos, q'ontza nchwinqlale' tu'nelju' tb'iya!</para>
  <para style="q">¡chin tiq'imitza toju' yajb'il! qu'n tz'aqlixi'xta,</para>
  <para style="q">
    <verse number="12" style="v" />¡Xitunqe'ku'ya wajq'oje! qu'n in japun ta tyol,</para>
  <para style="q">¡b'yonqe'ku'ya kykyaqil, qu'n ayine' tmajena! Chiju' b'itzal.</para>
  <chapter number="144" style="c" />
  <para style="s1">Aq'b'il chjonte te Dyos tu'n jun nimaqkawil</para>
  <para style="q">
    <verse number="1" style="v" />¡Nimanjtzxwit Qman Dyos, klol weye'!</para>
  <para style="q">Inchin t-xnaq'tza'ne' ex ntzaj tyek'u'n weye'</para>
  <para style="q">tu'ntzun tb'ent wu'ne' toj q'oj;</para>
  <para style="q">
    <verse number="2" style="v" />ate tb'anil wamiwe', jun kolb'il wib'e',</para>
  <para style="q">nin e'wb'il wib'e' ex tzaqpib'l weye';</para>
  <para style="q">ate kolb'ilweye', atzu' nnoka' nklo'nwib'e' ti'j;</para>
  <para style="q">ate inche kub' q'onkyeju' tnam tjaq' nkawb'ile'.</para>
  <para style="b" />
  <para style="q">
    <verse number="3" style="v" />Nman Dyos,</para>
  <para style="q">¿titi' toklenju' xjal, tu'nju' nximana ti'j?</para>
  <para style="q">¿Ti'xi'xtzu'n toklenju' wnaq, tu'nju' kye tilwi tu'na?</para>
  <para style="q">
    <verse number="4" style="v" />Ikyte xjalju' kse'n jun jiq'chan;</para>
  <para style="q">inik'ju' tchwinqlal kse'n jun leku'n.</para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" />Nman Dyos,</para>
  <para style="q">jqomju'ya twitz kya'j ex kutku'tza;</para>
  <para style="q">yekunqe'xju'ya witz tu'ntzun kysb'en;</para>
  <para style="q">
    <verse number="6" style="v" />xonqe'xju'ya t-smaja, aye' q'ankyaq,</para>
  <para style="q">ex b'inchama tu'n kyb'aj oqju' tajq'oja.</para>
  <para style="q">
    <verse number="7" style="v" />Q'ontz tq'ob'a tzmaxtzu' jawnixi',</para>
  <para style="q">ex chin tkloma teju' ninnjab' nimxi'x;</para>
  <para style="q">chin tkloma te kyipumalju' xjal te junxi'tl tnam,</para>
  <para style="q">
    <verse number="8" style="v" />kyeju' xjal nche chanyol</para>
  <para style="q">ex njaw kyiq'i'n kyb'a'nq'ob' te tziyb'il kychajyolil.</para>
  <para style="b" />
  <para style="q">
    <verse number="9" style="v" />Nman Dyos,</para>
  <para style="q">kxe'l nb'itzane' jun ak'a'j b'itz teya;</para>
  <para style="q">che kxe'l nb'itzane' b'itz teya tuk'i'l chnab' tzintzin.</para>
  <para style="q">
    <verse number="10-11" style="v" />Tu'na nche kanb'ana'ju' nimaqkawil;</para>
  <para style="q">aya klonte Dab'i ju' tmajena,</para>
  <para style="b" />
  <para style="q">chin tkloma teju' k'uẍtx'e'nb'il te b'iyb'il;</para>
  <para style="q">chin tkloma toj kyq'ob'ju' xjal te junxi'tl tnam,</para>
  <para style="q">kyeju' chalyol</para>
  <para style="q">ex njaw kyiq'i'n kyb'a'nq'ob' te tziyb'il kychajyolil.</para>
  <para style="b" />
  <para style="q">
    <verse number="12" style="v" />Che ch'iyxwitju' qk'wal kse'n awal toj awb'il;</para>
  <para style="q">ikyqe'wt qmyale' kse'nqe' tqan ja tb'anil b'inchb'enkye</para>
  <para style="q">nche ajb'en te tkuwal tja Dyos.</para>
  <para style="q">
    <verse number="13" style="v" />Che nojxwitju' qk'ujaye',</para>
  <para style="q">tu'n tkyaqil twitz awal te wab'j.</para>
  <para style="q">Che poq'onxwitju' qrite'</para>
  <para style="q">che chmet-xwit txqan kyajlal toju' qkojb'ile'.</para>
  <para style="q">
    <verse number="14" style="v" />Kyiqaxwit kyalju' qwakyixe',</para>
  <para style="q">ex japunxwit kyq'iju' kyal.</para>
  <para style="q">Mixwitti' sich' te xob'ajil kyoju' qxk'ichb'eye'.</para>
  <para style="q">
    <verse number="15" style="v" />¡Tzalajb'ilte' teju' tnam ati tkyaqil ja'lu te!</para>
  <para style="q">¡Tzalajb'ilte' teju' tnam in ajb'en teku' Qman Dyos! chiju' b'itzal.</para>
  <chapter number="145" style="c" />
  <para style="s1">Kykyaqil xjal tu'n kyajwalinte Qman Dyos</para>
  <para style="q">
    <verse number="1" style="v" />Kwajwali'ye' toklena Nman Dyos nnimaqkawil;</para>
  <para style="q">kjawil nnimsa'ne' tb'iya kukxju'.</para>
  <para style="q">
    <verse number="2" style="v" />Kjawil nnima'na atl junjun q'ij;</para>
  <para style="q">kjawil wajwali'ne' tb'iya kukxju' ex tejumajx.</para>
  <para style="q">
    <verse number="3" style="v" />Nimta toklen Nman Dyos ex o'kxta tu'n tajwalit;</para>
  <para style="q">layx qopon kanune' ti'ju' toklena.</para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" />Kjawil kyajwali'n manb'aj ex k'wa'lb'aj tb'inchb'ena,</para>
  <para style="q">che kxe'l pakb'a'nju' taq'unb'ena nimaq kyoklen.</para>
  <para style="q">
    <verse number="5" style="v" />Kxe'l kyoli'n toklena tb'anilxi'x,</para>
  <para style="q">ex che kxe'l nma'ne' tb'inchb'ena te lab'te'n.</para>
  <para style="q">
    <verse number="6" style="v" />Che kxe'l kyoli'nju' tb'inchb'ena nimaq kyoklen ex xob'ajilqe'x,</para>
  <para style="q">ayintzunwe' chin yolile' ti'ju' toklena.</para>
  <para style="q">
    <verse number="7" style="v" />kxe'l kyoli'nju' tk'u'jlalila nimxi'x,</para>
  <para style="q">ex kxe'l kyb'itza'n tnik'alilti'j ntb'incha'na.</para>
  <para style="b" />
  <para style="q">
    <verse number="8" style="v" />Che'wte Qman Dyos tk'u'j ex nq'aq'an tk'u'j,</para>
  <para style="q">ati tpasens ex nim tk'u'jlalil.</para>
  <para style="q">
    <verse number="9" style="v" />B'a'nxi'x te Qman Dyos kye kykyaqil,</para>
  <para style="q">ex kye tilwi taq'unb'en tu'n.</para>
  <para style="b" />
  <para style="q">
    <verse number="10" style="v" />¡Jawxwit ajwali'na Nman Dyos, kyu'n kykyaqilju' tb'inchb'aja!</para>
  <para style="q">¡Jawxwit nima'na kyu'nju' njapun tyola kyu'n!</para>
  <para style="q">
    <verse number="11" style="v" />¡Txi'wt kyoli'n t-spik'umalju' tkawb'ila!</para>
  <para style="q">¡Che'xwit kyoli'n tb'inchb'ena nimaq kyoklen!</para>
  <para style="q">
    <verse number="12" style="v" />¡Che'xwit kyma'nju' tipumala kye xjal</para>
  <para style="q">exju' t-spik'umal tkawb'ila!</para>
  <para style="q">
    <verse number="13" style="v" />Tejumajxte' tkawb'ila,</para>
  <para style="q">in kawina toj tkyaqil tab'q'iyil.</para>
  <para style="b" />
  <para style="q">
    <verse number="14" style="v" />Tzyu'n qekye' nche kub' tz'aq tu'na Nman Dyos</para>
  <para style="q">ex nche jaw twab'a'na numjniqe'.</para>
  <para style="q">
    <verse number="15" style="v" />Kykyaqil nche ayon ti'ja</para>
  <para style="q">tu'n txi' tq'o'na kywa tojxi'x tq'ijlalil.</para>
  <para style="q">
    <verse number="16" style="v" />Intzaj tq'o'na kywa tu'n tq'ob'a</para>
  <para style="q">inche noj kykyaqilju' tch'isb'ena tu'na.</para>
  <para style="q">
    <verse number="17" style="v" />Tz'aqlixi'xta Nman Dyos toj tkyaqilju' ntb'incha'na,</para>
  <para style="q">nim t-xtalb'ila kyib'aju' taq'unb'ena.</para>
  <para style="q">
    <verse number="18" style="v" />Nqaku' ta'ya Nman Dyos kyk'etzju' nche k'ulun teya,</para>
  <para style="q">inche kub'san tu'n tkyaqil kyk'u'j.</para>
  <para style="q">
    <verse number="19" style="v" />Intzaj ttzaq'we'na nkyqani'nju' nche niman te;</para>
  <para style="q">aj t-xikyqani'n o'nb'il teya, nche tzaj tb'i'na ex nche tklo'na.</para>
  <para style="q">
    <verse number="20" style="v" />Inche t-xq'uqi'na nche k'u'jlanteya Nman Dyos,</para>
  <para style="q">aye'tzu'n b'inchal myab'a'n nche kub' t-xitu'na.</para>
  <para style="b" />
  <para style="q">
    <verse number="21" style="v" />¡Kjawil wajwali'na Nman Dyos!</para>
  <para style="q">¡Kykyaqilxwit che niman teju' tb'iya xjan,</para>
  <para style="q">te ja'lo ex tejumajx! Chiju' b'itzal.</para>
  <chapter number="146" style="c" />
  <para style="s1">Ajwalb'ilte Dyos kyi'ju' tb'inchb'en</para>
  <para style="q">
    <verse number="1" style="v" />¡Ajwalinjtzxwit Qman Dyos!</para>
  <para style="b" />
  <para style="q">Chin b'itzale' te Qman Dyos tu'n tkyaqil nk'u'je'.</para>
  <para style="q">
    <verse number="2" style="v" />Kwajwali'ye' Qman Dyos toju' nchwinqlale'</para>
  <para style="q">che kxe'l nb'itzane' b'itz te Qman Dyos itz'qinku'ye' twitz tx'otx'.</para>
  <para style="q">
    <verse number="3" style="v" />Lalun tz'okqe kyk'u'je' kyi'ju' xjal nimaq kyoklen,</para>
  <para style="q">naq xjal qe'kye', lay b'ent kykolon,</para>
  <para style="q">
    <verse number="4" style="v" />qu'n ajkykyim in anjkyi'j toj tx'otx',</para>
  <para style="q">axtzun q'iju' nb'aj tkyaqilju' kyxim.</para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" />Tzalajb'ilte' teju' xjal oni'n tu'n Qman Dyos ja ajb'ena' Jakob',</para>
  <para style="q">aye' q'uqlok tk'u'j ti'j Qman Dyos.</para>
  <para style="q">
    <verse number="6" style="v" />A kub' b'inchante kya'j, tx'otx' ex ninnjab',</para>
  <para style="q">ex tkyaqilju' ti'xti' ati kywitz.</para>
  <para style="q">In japunte tyol kukxju'.</para>
  <para style="q">
    <verse number="7" style="v" />Intb'incha'n tnik'alilti'j kyeju' nche yajlanjtz</para>
  <para style="q">ex nxitq'o'n kywaju' nche we'yajti.</para>
  <para style="b" />
  <para style="q">Inche ttzaqpi'n Qman Dyosu' jpu'nqe';</para>
  <para style="q">
    <verse number="8" style="v" />Intjqo'n Qman Dyos kywitzju' moẍ;</para>
  <para style="q">inche jaw twab'a'n Qman Dyosu' kub'niqe' tz'aq;</para>
  <para style="q">inche tk'u'jla'n Qman Dyos xjal tnik'alkyi'j;</para>
  <para style="q">
    <verse number="9" style="v" />Inche t-xq'uqi'n Qman Dyos najchaq xjal</para>
  <para style="q">inche toni'nju' meb'a ex kyimni kychmil,</para>
  <para style="q">ex nche kub' ttzpet-sa'nju' b'inchal myab'a'n tojxju' kyb'e.</para>
  <para style="b" />
  <para style="q">
    <verse number="10" style="v" />Syon,</para>
  <para style="q">kkawilte Qman Dyos tejumajx;</para>
  <para style="q">kkawilte Qman Dyos toj tkyaqil tab'q'iyil.</para>
  <para style="b" />
  <para style="q">¡Ajwalinjtzxwit Qman Dyos! Chiju' b'itzal.</para>
  <chapter number="147" style="c" />
  <para style="s1">B'itz te Dyos tu'n t-xtalb'il te Jerusalen</para>
  <para style="q">
    <verse number="1" style="v" />¡Ajwalinjtzxwit Qman Dyos!</para>
  <para style="b" />
  <para style="q">¡Tb'anilxi'x tu'n qb'itzan te Qman Dyos!</para>
  <para style="q">¡O'kxte b'a'n tu'n qajwalinte!</para>
  <para style="q">
    <verse number="2" style="v" />Injaw tb'incha'ntl Qman Dyos Jerusalen</para>
  <para style="q">ex nche tzaj tb'u'yi'n aj Israel b'je'xniqe' slamj.</para>
  <para style="q">
    <verse number="3" style="v" />Intq'uqb'a'n kyk'u'ju' aj b'is,</para>
  <para style="q">ex nb'aj tq'a'na'nju' kyk'ixb'len.</para>
  <para style="q">
    <verse number="4" style="v" />A kyej q'onte kyajlanju' che'w,</para>
  <para style="q">ex oktq'o'n kyb'i teyle junjun.</para>
  <para style="q">
    <verse number="5" style="v" />Nimte' Qman Dyos toklen ex nimtipumal;</para>
  <para style="q">ex mixti' b'ajsb'il teju' tnab'l.</para>
  <para style="q">
    <verse number="6" style="v" />Inche jawtlaq'b'a'n Qman Dyos me's,</para>
  <para style="q">aye'tzu'n b'inchal myab'a'n nnel kych'ixaw tu'n.</para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" />Che b'itzan qe'ye' te Qman Dyos te aq'b'il chjonte;</para>
  <para style="q">kyb'itzanxe' b'itz te Qman Dyos, tuk'i'l chnab' arpa.</para>
  <para style="q">
    <verse number="8" style="v" />Intktxu'n twitz kya'j tu'n muj,</para>
  <para style="q">ntzaj tq'o'n jb'al tib'aj tx'otx',</para>
  <para style="q">in tch'isa'n k'ul kywi' witz,</para>
  <para style="q">
    <verse number="9" style="v" />intzaj tq'o'n kywaju' txkup</para>
  <para style="q">ex kywaju' kyal joj aj kyaq' oq'il.</para>
  <para style="q">
    <verse number="10" style="v" />Myatzu' ntzalaja' te Qman Dyos</para>
  <para style="q">ti'j tipumal chej ex tipumal ichan;</para>
  <para style="q">
    <verse number="11" style="v" />atzu' ntzalaja' te Qman Dyos kyi'ju' nche niman te,</para>
  <para style="q">aye' q'uqli kyk'u'j ti'ju' tk'u'jlalil.</para>
  <para style="b" />
  <para style="q">
    <verse number="12" style="v" />Kyajwali'nktze' Qman Dyos, aj Jerusalen;</para>
  <para style="q">ju' najlqe'ye' Syon, kyajwali'nktze'.</para>
  <para style="q">
    <verse number="13" style="v" />Qu'n e'kyaj t-xtanu'n tjpel kytaname'</para>
  <para style="q">ex e'kub' tky'i'wla'n kyk'wale' toju' nintnam.</para>
  <para style="q">
    <verse number="14" style="v" />Intzaj tq'o'n nak'b'il toju' kytx'otx'e'</para>
  <para style="q">ex ntq'uqb'a'n kyk'u'je' tu'n tb'anil triy.</para>
  <para style="q">
    <verse number="15" style="v" />Intzaj t-sma'n tyol twitz tx'otx',</para>
  <para style="q">ex lwiyxi'x nxipuqliju' tyol.</para>
  <para style="q">
    <verse number="16" style="v" />Intzaj tq'o'n che'w naku'j lan,</para>
  <para style="q">ex ntzaj t-sputi'n kse'n quq.</para>
  <para style="q">
    <verse number="17" style="v" />Intzaj tq'o'n txun che'w naku'j saqb'aqun;</para>
  <para style="q">nkub' qtx'e'jixju' a' tu'n che'w ntzaj tq'o'n.</para>
  <para style="q">
    <verse number="18" style="v" />Ajtzun ttzaj t-sma'nju' tyol, inkub' niwj tu'n;</para>
  <para style="q">intzaj t-xupi'n kyq'iq', ex nb'etju' a'.</para>
  <para style="q">
    <verse number="19" style="v" />Tzaj tyek'u'n tyol, e'tkawb'il ex tnuk'b'il</para>
  <para style="q">te Jakob', te Israel.</para>
  <para style="q">
    <verse number="20" style="v" />Minkxa' tb'inchaju' kye txqantl nimaqtnam,</para>
  <para style="q">ju' mixti'x kyojtzqiju' tchaq'b'il.</para>
  <para style="b" />
  <para style="q">¡Ajwalinjtzxwit Qman Dyos! Chiju' b'itzal.</para>
  <chapter number="148" style="c" />
  <para style="s1">In najwalinjtz Qman Dyos kyu'n tb'inchb'en</para>
  <para style="q">
    <verse number="1" style="v" />¡Ajwalinjtzxwit Qman Dyos!</para>
  <para style="b" />
  <para style="q">¡Kyajwali'nktze' Qman Dyos jata'qe'ye' toj kya'j!</para>
  <para style="q">¡Kyajwali'nktze' Qman Dyos jata'qe'ye' jawnixi'!</para>
  <para style="q">
    <verse number="2" style="v" />¡Kyajwali'nktze', kykyaqile' tanjl!</para>
  <para style="q">¡Kyajwali'nktze' aye'ye' nim txqan kyb'aje' toj kya'j!</para>
  <para style="q">
    <verse number="3" style="v" />¡Kyajwali'nktze' Qman Dyos, q'ij ex xjaw!</para>
  <para style="q">¡Kyajwali'nktze' Qman Dyos, che'w nche qoptz'aje'!</para>
  <para style="q">
    <verse number="4" style="v" />¡Ajwali'nktza, aya kya'j atiya jawnixi',</para>
  <para style="q">ex aya a' atiya toj muj twitz kya'j!</para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" />Kyajwali'nktze' tb'i Qman Dyos,</para>
  <para style="q">qu'n tchaq' ex tkyaqil b'ajb'ent tu'n tyol;</para>
  <para style="q">
    <verse number="6" style="v" />tkyaqil e'kyaj tq'o'n tejumajx,</para>
  <para style="q">ex tzaj tq'o'n jun kawb'il lay kub' txa'ju'n.</para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" />¡Kyajwali'nktze' Qman Dyos jata'qe'ye' twitz tx'otx',</para>
  <para style="q">e'nimaqtxkup toj ninnjab', ex ninnjab' nimtxe!</para>
  <para style="q">
    <verse number="8" style="v" />¡Q'ankyaq ex saqb'aqun, txun che'w ex q'eqmuj!</para>
  <para style="q">¡kyq'iq' nim tipumal njapun tchaq'b'il Dyos tu'na!</para>
  <para style="q">
    <verse number="9" style="v" />¡Nimaq witz ex k'ok'e' witz!</para>
  <para style="q">¡Kykyaqile' k'ute exqe' tze tqan lob'j!</para>
  <para style="q">
    <verse number="10" style="v" />¡E' alu'mj exqe' tojk'ul txkup!</para>
  <para style="q">¡Pich' ex e'txkup nche qititinjeye' twitz tx'otx'!</para>
  <para style="q">
    <verse number="11" style="v" />¡Kykyaqilju' nimaqkawil twitz tx'otx' kyuk'i'lju' tnam!</para>
  <para style="q">¡Exqe'ju' nejenel ex kawil toj tkyaqil twitz tx'otx'!</para>
  <para style="q">
    <verse number="12" style="v" />¡E' ichan ex qya, e'ku'xun ex tijwnaq!</para>
  <para style="b" />
  <para style="q">
    <verse number="13" style="v" />¡Kyajwali'nktze' tb'i Qman Dyos kykyaqile'.</para>
  <para style="q">o'kxnate nim toklenju' tb'i!</para>
  <para style="q">¡Nim toklen tib'aj kya'j ex tx'otx'!</para>
  <para style="q">
    <verse number="14" style="v" />¡Matxi' tzaj tq'o'n tipumalju' ttanam!</para>
  <para style="b" />
  <para style="q">¡Kyb'itze' kykyaqile' nche nimane' te,</para>
  <para style="q">kyb'itze' aj Israel, ju' ttanam nqaku' ta'qe'ye' tk'etz!</para>
  <para style="b" />
  <para style="q">¡Ajwalinjtzxwit Qman Dyos! chiju' b'itzal.</para>
  <chapter number="149" style="c" />
  <para style="s1">A Qman Dyos B'inchalte tkyaqil ex a Nimaqkawil</para>
  <para style="q">
    <verse number="1" style="v" />¡Ajwalinjtzxwit Qman Dyos!</para>
  <para style="b" />
  <para style="q">Kyb'itzanxe' jun ak'a'j b'itz te Qman Dyos;</para>
  <para style="q">kyajwali'nktze' kyxolju' tnik'alkyi'j.</para>
  <para style="q">
    <verse number="2" style="v" />Che tzalajxe' aj Israel, toju' tnam Syon,</para>
  <para style="q">qu'n a Dyos ch'isalkyeye' ex kynimaqkawile'.</para>
  <para style="q">
    <verse number="3" style="v" />Che b'ixinqe'ye' te ajwalb'ilte tb'i,</para>
  <para style="q">che b'itzan qe'ye' te tuk'i'l chnab' arpa ex txijtxij.</para>
  <para style="q">
    <verse number="4" style="v" />Qu'n intzalajte Qman Dyos kyi'ju' ttanam;</para>
  <para style="q">inxitq'o'n kyoklenju' me's tu'n kykanb'a'n.</para>
  <para style="q">
    <verse number="5" style="v" />Che tzalajxe' aye'ye' njapun tyol kyu'ne' tu'nju' kanb'ab'l,</para>
  <para style="q">b'a'nqa kuẍliqe'tle', che b'itzan qe'ye' tuk'i'l tzalajb'il.</para>
  <para style="q">
    <verse number="6" style="v" />Che b'itzan qe'ye' te Qman Dyos,</para>
  <para style="q">ex ktzyume' jun k'uẍtx'e'nb'il te kab'e' plaj twitzte</para>
  <para style="q">
    <verse number="7" style="v" />tu'ntzun toktq'o'n tu'me'l t-xel kye ma' witzleb'il,</para>
  <para style="q">tu'n tkub' ttz'e'ysa'n kywitzju' nimaqtnam,</para>
  <para style="q">
    <verse number="8" style="v" />tu'n kyb'ajkub' k'letju' nimaqkawil ex xjal nim kyoklen</para>
  <para style="q">kyu'n xpatx'k'uxb'il alqe'xi'x,</para>
  <para style="q">
    <verse number="9" style="v" />tu'ntzun tjapunju' tz'e'ysb'il witzb'aj tz'ib'a'ntl.</para>
  <para style="q">¡Jun ninb'ilte' kye kykyaqilju' tnik'alkyi'j!</para>
  <para style="b" />
  <para style="q">¡Ajwalinjtzxwit Qman Dyos! Chiju' b'itzal.</para>
  <chapter number="150" style="c" />
  <para style="s1">Qkyaqil tu'n qb'itzan te Qman Dyos</para>
  <para style="q">
    <verse number="1" style="v" />¡Ajwalinjtzxwit Qman Dyos!</para>
  <para style="b" />
  <para style="q">¡Kyajwali'nktze' Qman Dyos toju' tja xjan!</para>
  <para style="q">¡Kyajwali'nktze' aye'ye' ate'ye' twitzju' kya'j tb'anilxi'x!</para>
  <para style="q">
    <verse number="2" style="v" />¡Kyajwali'nktze' kyu'nju' tb'inchb'en nimaq kyoklen!</para>
  <para style="q">¡Kyajwali'nktze' tu'nju' nimxi'x toklen mixti' b'ajsb'il te!</para>
  <para style="q">
    <verse number="3" style="v" />¡Kyajwali'nktze' kyuk'i'l chun!</para>
  <para style="q">¡Kyajwali'nktze' tuk'i'l chnab' arpa ex tzintzin!</para>
  <para style="q">
    <verse number="4" style="v" />¡Che b'ixinqe'ye' ajwalb'ilte tuk'i'l chilchil!</para>
  <para style="q">¡Kyajwali'nktze' kyuk'i'l xux ex kyuk'i'l chnab' tzintzin!</para>
  <para style="q">
    <verse number="5" style="v" />¡Kyajwali'nktze' kyuk'i'l txijtxij k'ok'e' nche txijun!</para>
  <para style="q">¡Kyajwali'nktze' kyuk'i'l txijtxij nimaq nche k'onin!</para>
  <para style="q">
    <verse number="6" style="v" />¡Kykyaqile' ati kychwinqlale', kyajwali'nktze' Qman Dyos!</para>
  <para style="b" />
  <para style="q">¡Ajwalinjtzxwit Qman Dyos! chiju' b'itzal.</para>
</usx>