<?xml version="1.0" encoding="utf-8"?>
<usx version="2.6">
  <book code="3JN" style="id">3JN.TXT Febrero 2009 Pedro D. Cabrera Mam Ostuncalco. Updated for DBL by G. Grasso and E. Canales, December 2012, standardization after migration to PT8 by A. Camus March, 2019.</book>
  <para style="h">3 Juan</para>
  <para style="toc3">3 Jn</para>
  <para style="toc2">3 Jn</para>
  <para style="toc1">Toxi'n Tuj Xwan (3 Juan) Chik'b'ab'l</para>
  <para style="mt1">TOXI'N TUJ XWAN</para>
  <para style="mt2">(3 Juan)</para>
  <para style="imt">CHIK'B'AB'L</para>
  <para style="ip">Ikxju' u'j lu, tz'ib'a'n tu'n ju' tijwnaq, xisma'n te jun k'ik'lel mujqa jun okslal ati toklen, Kayo tb'i, xiq'o'n u'j lu teku' tuk'i'l tk'u'jlalil. Njaw nima'n tu'nju' txqan taq'un ntb'incha'n kyxol okslal (tqik' jun pomni toj wajxaq), ex nex ch'yon tchwinqlal jun xjal toj tk'u'j, njamjon ex nok tetzi'n jun ti'xti' (tqik' b'eljoj ex lajoj), ex ikx njaw tnima'n juntl okslal Demetryo tb'i (tqik' junlajoj ex kab'lajoj) ex nb'aj yolin tuk'i'l jun q'olb'eb'l kse'nxju' nt-se'n kyoj txqantl u'j (tqik' oxlajoj pomni toj o'lajoj).</para>
  <chapter number="1" style="c" />
  <para style="p">
    <verse number="1" style="v" />Ayine' tijwnaq, nxi' nq'olb'e'na Kayo, atixi'x nk'u'je' ti'ja.</para>
  <para style="s1">B'a'n tyolinjtz Kayo</para>
  <para style="p">
    <verse number="2" style="v" />Witz'in, atixi'x nk'u'je' ti'ja, nchin kub'sane' te Dyos tu'n ttena b'a'n toj tkyaqil, ex b'a'na toj t-xmilala, kse'n tanmiya b'a'n ta' twitz Dyos. <verse number="3" style="v" />Ojexi'x chin tzalaje' tej kyul junjun okslal e'tzaj kyxole' ex kyma qa atixa toju' ax tzaj t-xnaq'tza'n Jesukrist qe. <verse number="4" style="v" />Awe' ntzalajb'il nimxi'x aju' ajnb'inteye' qa nche anq'inju' nk'wale' toju' ax tzaj tkyek'u'n Dyos qe.</para>
  <para style="p">
    <verse number="5" style="v" />Witz'in, atixi'x nk'u'je' ti'ja, b'a'nte' ntb'incha'na tu'nju' n-onina kyi'j txqantl qtzik mo qitz'in, axi'xpe' kyeju' te junxi'tl najb'ilqe'. <verse number="6" style="v" />Kywitzku' okslal matxi' kymaya' qa nxi'x che tk'u'jla'na. B'inchama xtalb'il oninqe'xa toju' nojqelan kye tu'n txikyljo'n kyb'e, tu'n telb'a'n tajb'eb'la twitz Dyos. <verse number="7" style="v" />Qu'n matzyet kyb'e tu'n kyajb'en te Jesukrist, ex min nche k'mon o'nb'il kye xjal min nche niman te Dyos. <verse number="8" style="v" />Qu'mtzun ati tu'n qonin kyi'j toju' kyaq'un matxi' tzyet, tu'n kypakb'anteju' ax.</para>
  <para style="s1">Myab'a'n ntb'incha'n Dyotrepes</para>
  <para style="p">
    <verse number="9" style="v" />Xintz'ib'a'ne' jun u'j kye okslal, atzu'n Dyotrepes min ntoksla'n qoklene' qu'n a tajb'ilju' tu'n tchaq'un kyxol. <verse number="10" style="v" />Qu'mtzun kb'ajel ntzak'u'ne' ajnpone', qu'n naq tok jk'ulyol ex chalyol qi'je'. Ex min nqe tk'u'j tu'nju' ntb'incha'n, min nche tk'mo'n qtzik e'qitz'in nche pon, qatzun ate' okslal kyajb'il tu'n kyk'monkye, min ntjo'n ex nche ex t-xla'ja'n kyxol okslal.</para>
  <para style="p">
    <verse number="11" style="v" />Witz'in, lalun tz'el tkno'na taq'wix, a knomju'ya b'a'n. Ate' nb'inchante b'a'n, te Dyos; atzu'n nb'inchan myab'a'n, na'mx teltnik' te Dyos.</para>
  <para style="s1">B'a'n yek'b'il tu'n Demetryo</para>
  <para style="p">
    <verse number="12" style="v" />Kykyaqil nche yolin b'a'n ti'j Demetryo, expe' ax. Ikxqe' nqo yoline' b'a'n ti'j ex kanli twitza nqma'ne' ax.</para>
  <para style="s1">Yol te b'ajsb'il</para>
  <para style="p">
    <verse number="13" style="v" />Nimwe' nyol tu'n txinma'ne' teya, naq aju' lay txi ntz'ib'a'ne', <verse number="14" style="v" />qu'n wajb'ile' tu'n npone' tk'etza ex tu'n nyoline' tuk'i'la.</para>
  <para style="p">
    <verse number="15" style="v" />Tenxwita toj nak'b'il. Nxi' q'olb'e'na kyu'n amiw. B'inchama xtalb'il, q'olb'enqe'xa qamiw.</para>
</usx>