<?xml version="1.0" encoding="utf-8"?>
<usx version="2.6">
  <book code="ZEP" style="id">ZEP.TXT Febrero 2009 Pedro D. Cabrera Mam Ostuncalco. Updated for DBL by G. Grasso and E. Canales, December 2012, standardization after migration to PT8 by A. Camus March, 2019.</book>
  <para style="h">Sofonías</para>
  <para style="toc3">Sof</para>
  <para style="toc2">Sof</para>
  <para style="toc1">Tuj Soponiy (Sofonías)</para>
  <para style="mt1">TUJ SOPONIY</para>
  <para style="mt2">(Sofonías)</para>
  <para style="imt">CHIK'B'AB'L</para>
  <para style="ip">Ate' t-sanjelal Dyos Soponiy junx ten kyuk'i'l Nawum ex Ab'akuk, ex tu'nju' tz'ib'b'ente tuj in ka'yin qa pakb'an tej na'mxtoq tb'aj b'incha'nju' ch'exb'eb'l tu'n Josiy. Qu'mtzun yolina' b'a'nxi'x, kse'nqe' junjuntl t-sanjelal Dyos, ti'ju' tulel Qman Dyos, ti'ju' b'ajsb'il, ti'ju' tz'e'ysb'il witzb'aj exqa kb'el xitj tkyaqil (1.1—2.3). Ex yolin qa majx che b'el xitju' tnam tqe'k nqaku' kyk'etz aj Juda, aye'ju' ktanam pilistey Kasa, Askalon, Asdod ex Ekron (2.4-15). Ex ikx kb'ajela' ti'j Jerusalen tu'n tpaju' til. Maskyepe' atix q'uqb'ab'l tk'u'jlalil tu'nju' atix anb'il te tu'n tb'inchanjtz jumajtel, tu'ntzun ja'lu nb'aja' tu'n t-sanjelal Dyos tuk'i'l jun b'itz te tzalajb'il.</para>
  <chapter number="1" style="c" />
  <para style="s1">Tq'ijlalil ttx'u'jil Qman Dyos</para>
  <para style="p">
    <verse number="1" style="v" />A pakb'ab'l ja'lu tzaj tma'n Qman Dyos te Soponiy toj tq'ijlalil Josiy, tk'wal Amon nimaqkawiltoq toj Juda. Ate Soponiy tk'wal Kusi, atzunte Kusi tk'wal Kedaliy, ate Kedaliy tk'wal Amariy ex ate Amariy tk'wal Esekyiy.</para>
  <para style="b" />
  <para style="q">
    <verse number="2" style="v" />A ntma'n Qman Dyos ja'lu:</para>
  <para style="q">Kb'el nxitu'ne' tkyaqilju' ati twitz tx'otx'.</para>
  <para style="q">
    <verse number="3" style="v" />Kche kb'el nxitu'ne' xjal exqe'ju' txkup, ex kche b'el nnajsa'ne' pich' exqe'ju' kyiẍ,</para>
  <para style="q">kb'el nq'o'ne' trakpuje'n toj kb'eju' b'inchal myab'a'n</para>
  <para style="q">ex kb'el nnajsa'ne' xjal twitz tx'otx'.</para>
  <para style="b">Atzu'n ntma'n Qman Dyos ja'lu:</para>
  <para style="q">
    <verse number="4" style="v" />Kb'el ntz'e'ysa'ne' twitzju' tnam Juda</para>
  <para style="q">ex kykyaqilju' najlqe' toj Jerusalen.</para>
  <para style="q">Kb'el nnajsa'ne' tik'lenju' dyos B'aal tb'i toju' najb'il lu,</para>
  <para style="q">Ex ikx kb'iju' kpale kb'el najset.</para>
  <para style="q">
    <verse number="5" style="v" />Che kb'el nxitu'ne' xjal nche' jax tib'aj ja,</para>
  <para style="q">tu'n kyk'ulun kye che'w,</para>
  <para style="q">exqe'ju' nche kub' meje ntzaj kyna'n nb'iye'</para>
  <para style="q">ex tb'iju' dyos Milkom.</para>
  <para style="q">
    <verse number="6" style="v" />Ex kche b'el nxitu'nju'ye' nel kypa'n kyib' wi'je',</para>
  <para style="q">aye'ju' min nche' jyo'n ex minti' nche' ul yolil wuk'i'le'.</para>
  <para style="q">
    <verse number="7" style="v" />¡Che' numeku'ye' twitz Qman Dyos,</para>
  <para style="q">qu'n aju' tq'ijlalil Qman Dyos nqaku' ta'!</para>
  <para style="q">¡Ate Qman Dyos matxi' kub' tq'o'n jun chojb'il</para>
  <para style="q">ex matxi' che b'aj t-xjansa'nju' ttxokyin!</para>
  <para style="b" />
  <para style="q">
    <verse number="8" style="v" />Toju' tq'ijlalil chojb'il</para>
  <para style="q">kb'el ntz'e'ysa'ne' kwitzju' nejenel —chi Qman Dyos—,</para>
  <para style="q">exqe'ju' tk'wal nimaqkawil</para>
  <para style="q">ex kykyaqilju' nok kxb'alun junxi'tl.</para>
  <para style="q">
    <verse number="9" style="v" />Ex kb'el ntz'e'ysa'ne' kwitzju' nche okx lipan tib'aju' tjpel ja</para>
  <para style="q">toju' tq'ijlalil tzul,</para>
  <para style="q">exqe'ju' nche b'ajb'iyun toj ktx'u'jil ex nche b'ajsb'un toj tja tajaw aq'untl.</para>
  <para style="b" />
  <para style="q">
    <verse number="10" style="v" />Atzun ntma'n Qman Dyos ja'lu:</para>
  <para style="q">Tojtzunju' q'ij lu kche b'injtzel sich' te qanb'il o'nb'il</para>
  <para style="q">tzajx tk'etzju' tjpel kye kyiẍ tb'i.</para>
  <para style="q">Kche ẍchilju' xjal toju' tkab' najb'il</para>
  <para style="q">ex nim tq'ojq'ojel qotx' kwi'ju' ttxa'nwitz kb'injtzel.</para>
  <para style="q">
    <verse number="11" style="v" />¡Che' ẍch'inqe'ye' aye'ye', najliqe'ye' toju' najb'il Morter tb'i,</para>
  <para style="q">Qu'n kykyaqilju' xk'aẍlel che kyimel,</para>
  <para style="q">tkyaqilju' nche ch'exb'en pwaq tk'i' sb'ub'l kche b'ajel!</para>
  <para style="q">
    <verse number="12" style="v" />Tojtzunju' tq'ijlalil lu kb'ajel nka'yine' toj Jerusalen</para>
  <para style="q">tu'n jun t-spik'umal.</para>
  <para style="q">Ex kb'el ntz'e'ysa'ne' kwitzju' xjal mixti' tzik'a' kyk'u'j</para>
  <para style="q">nakuj te b'in punli,</para>
  <para style="q">ex tjunalx nkub' t-xima'n kjalu:</para>
  <para style="q">¡Ate Qman Dyos mixti'xte' ktb'incha', nipe' b'a'n ex taq'wix!</para>
  <para style="b" />
  <para style="q">
    <verse number="13" style="v" />Qu'mtzun, che b'je'lex elq'a'n tk'uwen</para>
  <para style="q">ex che b'el xitju' tja.</para>
  <para style="q">che jawil kyb'incha'n kyja extzun lay che najan kyoj;</para>
  <para style="q">che awal ub'a extzun lay che k'wan b'in ti'j.</para>
  <para style="b" />
  <para style="q">
    <verse number="14" style="v" />¡Matxi' tzul lq'eju' tq'ijlalil Qman Dyos!</para>
  <para style="q">¡Nqaku' ta', tzul ojqelxi'x!</para>
  <para style="q">Aju' tq'ojq'ojel tq'ij Qman Dyos ajtul tk'ayilxi'xlo:</para>
  <para style="q">¡aye'pena' majx kuwqe'xi'x kche ẍch'il!</para>
  <para style="q">
    <verse number="15" style="v" />Jun q'ijte' lu te ttx'u'jil Dyos:</para>
  <para style="q">te k'ixk'oj, ex te yajb'il,</para>
  <para style="q">te xitb'il ex te b'ajsb'il,</para>
  <para style="q">te qxopin ex qlolj,</para>
  <para style="q">te q'eqmuj ex sjumj b'a'nxi'x;</para>
  <para style="q">
    <verse number="16" style="v" />Jun q'ij tu'n tq'ajset chun ex te kub'sa'n.</para>
  <para style="q">Kyi'ju' nimaqtnam kuwsa'n kyi'j</para>
  <para style="q">exqe' ja nimaq kywe'.</para>
  <para style="q">
    <verse number="17" style="v" />Chi Qman Dyos Kja'lu:</para>
  <para style="q">Tzul yajb'il kyib'aj xjal wu'ne'.</para>
  <para style="q">Kche b'etel naku'j moẍqe',</para>
  <para style="q">Qu'n mache b'inchan il nwitze'.</para>
  <para style="q">K'elel chitju' kychk'el naku'j quq,</para>
  <para style="q">ex kb'el ch'uqeju' kychib'jil naku'j ttxa alu'mj.</para>
  <para style="b" />
  <para style="q">
    <verse number="18" style="v" />Tojtzunju' tq'ij ttx'u'jil Qman Dyos,</para>
  <para style="q">lay che kletju' xjal tu'n kysaqpwaq ex kyq'anpwaq,</para>
  <para style="q">qu'n naku'j q'aq'ju' ttx'u'jil Qman Dyos</para>
  <para style="q">kb'ajel twanju' tnam tkyaqil.</para>
  <para style="q">¡Che b'ajel mankunju' xjal najlqe' twitz tx'otx'</para>
  <para style="q">toj jun kmujx!</para>
  <chapter number="2" style="c" />
  <para style="q">
    <verse number="1" style="v" />Kyb'uyim kyib'e' junx aye'ye' xjal mixti' kych'ixawe',</para>
  <para style="q">
    <verse number="2" style="v" />na'mxku' kponxone'</para>
  <para style="q">kse'n ttxa triy, noq toj jun q'ijx nkub'a' naj;</para>
  <para style="q">na'mxku' tkub' tz'aq kyib'aje'</para>
  <para style="q">aju' ttx'u'jil Qman Dyos nk'anti;</para>
  <para style="q">na'mxku' tkub' tz'aq kyib'aje'</para>
  <para style="q">aju' tq'ijlalil ttx'u'jil Qman Dyos.</para>
  <para style="q">
    <verse number="3" style="v" />Kyjyome' Qman Dyos kykyaqile'</para>
  <para style="q">me's qe'ye' twitzju' tx'otx' lu,</para>
  <para style="q">aye'ye' nxikyb'i'ne' tchaq'b'il.</para>
  <para style="q">Che okxe' tnik'alkyi'je' ex me's,</para>
  <para style="q">qaj che kletiltzuntze'</para>
  <para style="q">toju' q'ij ajttzaj tq'o'n Qman Dyos ttx'u'jil.</para>
  <para style="s1">Tz'e'ysb'il kywitzju' nimaqtnam</para>
  <para style="q">
    <verse number="4" style="v" />Kjeltenju' nintnam Kasa chq'ajlajtl,</para>
  <para style="q">exju' Askalon xitjnitl;</para>
  <para style="q">tojxi'x q'ijtl che elex xla'ja'n xjal</para>
  <para style="q">nche najan toj Asdod,</para>
  <para style="q">ex majx che jawitz xb'oq'inju' xjal</para>
  <para style="q">nche najan toj Ekron.</para>
  <para style="q">
    <verse number="5" style="v" />¡Layqe'xwite' nche najane' toj kreta,</para>
  <para style="q">najlqe'ye' ttzi ninnjab'!</para>
  <para style="q">Matxi' tma Qman Dyos tu'n ttz'e'yset kywitze'.</para>
  <para style="q">¡Kanaan, ktanam pilistey,</para>
  <para style="q">kb'el nxitu'na ex mixti'tl xjal knajal toja!</para>
  <para style="q">
    <verse number="6" style="v" />Kjeltenju' tnam ati ttzi ninnjab'</para>
  <para style="q">wu'ne' te kywab'l wakx</para>
  <para style="q">jakyb'u'yiya' kyib'ju' k'ik'lel,</para>
  <para style="q">ex ja kb'elaju' kych'lajil rit.</para>
  <para style="q">
    <verse number="7" style="v" />Aye'ju' che kjel anq'in toju' tnam Juda</para>
  <para style="q">che kb'el najan toju' tnam lu</para>
  <para style="q">ajtul Qman Dyos onilkye</para>
  <para style="q">ex aj tch'exb'ente kyanq'ib'l.</para>
  <para style="q">Atzuntzu' che xq'uqila' ti'ju' krit,</para>
  <para style="q">ex che ojlal te qonik'an kyoju' ja te Askalon.</para>
  <para style="q">
    <verse number="8-9" style="v" />A ntma'n Qman Dyos nimtipumal kjalu:</para>
  <para style="q">Oje nb'iye' yol taq'wix kyu'n aj Moab'</para>
  <para style="q">exju' taq'wix xkyb'incha aj Amon.</para>
  <para style="q">Qu'n nim kyol taq'wix kyeju' ntaname'</para>
  <para style="q">ex matxi' che jawb'ent twitzju' kytx'otx'.</para>
  <para style="q">Qu'mtzun knma' jun nyole' axx'ix</para>
  <para style="q">ikykye aj Moab' che ik'ela' kse'n Sodom</para>
  <para style="q">exqetzu'n aj Amon ikyche kjela' kse'n Komor,</para>
  <para style="q">che jawil b'entju' kykojb'il te ch'ix,</para>
  <para style="q">ex te ttx'otx'al atz'an,</para>
  <para style="q">te jun tx'otx' noq tjunalx kukxju'.</para>
  <para style="q">Aye'tzu'n che kjel anq'in toju' ntaname' che eletz q'inteju' toj kyja</para>
  <para style="q">ex che kjelten twitzju' kytx'otx'.</para>
  <para style="q">
    <verse number="10" style="v" />Atzun chojb'ilju' kyk'ma' aj Moab' ex aj Amon.</para>
  <para style="q">Tu'n tpajju' xikylanu'n kyol kyeju' ttanam Dyos,</para>
  <para style="q">tu'n tpaju' mache b'jawb'ent noq tu'nelju' ttanam</para>
  <para style="q">Qman Dyos nimtipumal.</para>
  <para style="q">
    <verse number="11" style="v" />K'okyel te Qman Dyos xob'ajilx kye</para>
  <para style="q">Che' kb'el t-xitu'n kykyaqilju' dyos teju' tnam,</para>
  <para style="q">ex che k'ululju' xjal te toj tkyaqil najb'il,</para>
  <para style="q">expe' ikx kyu'nju' xjal najliqe' kyoju' piẍ tx'otx' toj ninnjab'.</para>
  <para style="q">
    <verse number="12" style="v" />¡Ex ikxkye', aye'ye' aj Etyopiy,</para>
  <para style="q">che k'ixb'ele' ex che b'eltz'aqe' tu'nju' tk'uẍtx'e'nb'il Qman Dyos!</para>
  <para style="q">
    <verse number="13" style="v" />Kxe'l tnuqpi'n tq'ob' toj tb'a'nq'ob' kya'j</para>
  <para style="q">tu'n tkub' t-xitu'n Asirya,</para>
  <para style="q">ex kjel t-xitu'nju' nintnam Ninib'e,</para>
  <para style="q">ex majx kjawil b'ent te jun chq'ajlaj tzqij tu'n.</para>
  <para style="q">
    <verse number="14" style="v" />Kjawitz xb'oqitju' ttzeylal kyja,</para>
  <para style="q">ex kyoj che b'jo'kyexa'ju' tnej rit</para>
  <para style="q">ex tkyaqil tnej txkup toj k'ul.</para>
  <para style="q">Aju' tukru exju' tol</para>
  <para style="q">kche wtal kyib'aju' tqan ja,</para>
  <para style="q">ex kche oq'el joj kyib'aju' tokexspik'un ex kyib'aju' nunb'ral.</para>
  <para style="q">
    <verse number="15" style="v" />Atzun nintnam ja'lu nxi'x tnima'ntib'</para>
  <para style="q">nanq'in q'uqlixi'xtoq tk'u'j,</para>
  <para style="q">ex intoq kma'nju' najlqe'toq toj</para>
  <para style="q">qa mixti' juntl xjal twitz tx'otx' kse'nkye.</para>
  <para style="q">¡Matxi'xi'x kyej xitj</para>
  <para style="q">ex matxi' tz'ok te knajb'il tojk'ul txkup!</para>
  <para style="q">Kykyaqilju' nche' ik' tk'etz, kche ẍut'il ex majx k'elel kyik'u'n.</para>
  <chapter number="3" style="c" />
  <para style="s1">Til Jerusalen ex kolb'ilte</para>
  <para style="q">
    <verse number="1" style="v" />¡Layxwitju' Jerusalen, pi's nintnam,</para>
  <para style="q">tz'ilsa'ntib' ex jtz'ol xjal!</para>
  <para style="q">
    <verse number="2" style="v" />Minti' xitb'i'nju' tq'ojq'ojel twi' Qman Dyos</para>
  <para style="q">ex minti' taq' tzak'u' tib';</para>
  <para style="q">minti' sok qetk'u'j ti'j;</para>
  <para style="q">ex minti' xi' lq'e tk'etz Dyos.</para>
  <para style="q">
    <verse number="3" style="v" />Nche' tzanunju' nejenel kye naku'j b'alun;</para>
  <para style="q">aye'tzunju' ajkawil kye, naku'j xo'jqe' toj chq'ajlaj</para>
  <para style="q">mixti' nkyaj kyq'o'n jun b'aq te prim.</para>
  <para style="q">
    <verse number="4" style="v" />Aye'ju' kysanjelal mixti'x knab'l,</para>
  <para style="q">nche' b'jaw meltz'uj;</para>
  <para style="q">aye'ju' kpale nkub' ktz'ilsa'nju' xjanb'il</para>
  <para style="q">ex nche' ik' tib'aju' tkawb'il Qman Dyos.</para>
  <para style="q">
    <verse number="5" style="v" />Atzunte Qman Dyos ati toju' nintnam;</para>
  <para style="q">ntb'incha'n b'a'n, myaju' taq'wix.</para>
  <para style="q">Atl prim nche ok xjal toj xjel tu'n.</para>
  <para style="q">Atzunte xjal b'inchal myab'a'n</para>
  <para style="q">mixpeti'x tojtzqi'n ch'ixaw.</para>
  <para style="b" />
  <para style="q">
    <verse number="6" style="v" />Ate Qman Dyos ntma'n kjalu:</para>
  <para style="q">Matxi' che b'ajnxitu'ne'</para>
  <para style="q">nimaqtnam</para>
  <para style="q">matxi' che b'aj kub' nxitu'ne'</para>
  <para style="q">ja nimaq kywe' exju' kytapi</para>
  <para style="q">ex matxi' che b'ajkyaju' kyxk'ichb'e</para>
  <para style="q">wu'ne' te chq'ajlaj,</para>
  <para style="q">mixti'tl jun xjal nb'et toj.</para>
  <para style="q">¡Toju' ninttanam tjunalx</para>
  <para style="q">mixti' jun xjal najli toj!</para>
  <para style="q">
    <verse number="7" style="v" />Kub' nximane': Aju' Jerusalen kxob'el weye'</para>
  <para style="q">ex oklo tq'a kawi tib' weye;</para>
  <para style="q">tu'ntzun lalun kyej xitju' tja</para>
  <para style="q">tu'nju' matxi' kub' tz'e'yset twitz.</para>
  <para style="q">Aye'tzunkye ma'pe' che'x xi'xtl</para>
  <para style="q">b'inchal chukchaq il.</para>
  <para style="q">
    <verse number="8" style="v" />Qu'mtzun, che ayone' ti'ju' q'ij</para>
  <para style="q">ajnjawe'ye' yolil taq'wix kyi'je'.</para>
  <para style="q">Ayine', Dyos Manb'aj nchin q'mante:</para>
  <para style="q">matxi' kub' nxima'ne' tu'n kytzaj b'u'yitju' nimaqtnam exqe' kawb'il</para>
  <para style="q">tu'n ttzaj nb'ajsa'ne' ntx'u'jile' kyib'aj,</para>
  <para style="q">aju' ntx'u'jile' inxi'x k'ant.</para>
  <para style="q">¡Tkyaqilju' tx'otx' kjel xitj</para>
  <para style="q">tu'n tkyeqil ntx'u'jile'!</para>
  <para style="b" />
  <para style="q">
    <verse number="9" style="v" />Ajtzun tponju' q'ij lu, knẍtilsa'ye'</para>
  <para style="q">kyolju' tnam,</para>
  <para style="q">tu'ntzun kykyaqilx che txokyil weye',</para>
  <para style="q">ex tu'n kykyaqilx tu'n kyajb'en weye'.</para>
  <para style="q">
    <verse number="10" style="v" />Toju' jun plajtl kyeju' a' te Etyopiy,</para>
  <para style="q">tzulju' ntaname' b'ajxni sputj kub'sal</para>
  <para style="q">tuk'i'l oyaj weye'.</para>
  <para style="q">
    <verse number="11" style="v" />Tojtzunju' tq'ijlalil lu,</para>
  <para style="q">lalun jaw ch'ixwitla ntanam</para>
  <para style="q">te junju' tb'inchb'aja</para>
  <para style="q">tej sel tpa'ntib'a wi'je',</para>
  <para style="q">oktzun che elel wiq'ine' ti'ja</para>
  <para style="q">aye'ju' la'jil kyib' ex nimal kyib',</para>
  <para style="q">ex lalun jaw tnima'ntl tib'a</para>
  <para style="q">twi'ju' witz xjan weye'.</para>
  <para style="q">
    <verse number="12" style="v" />Che kjel nq'o'ne' xjal me'sqe' kxole'</para>
  <para style="q">ex mya nimal kyib',</para>
  <para style="q">atzu' k'okyela' qe' kyk'u'j wi'je'.</para>
  <para style="q">
    <verse number="13" style="v" />Aye'ju' kche kjel anq'in toju' tnam te Israel</para>
  <para style="q">lalun che b'inchan mya tnik'alti'j,</para>
  <para style="q">lay che chanyol,</para>
  <para style="q">ex lay ten sb'ujtib'il toj ktzi.</para>
  <para style="q">Kche wal ex kche ojlal</para>
  <para style="q">mixti' xob'ajil kye.</para>
  <para style="s1">B'itz te tzalajb'il tu'n Jerusalen</para>
  <para style="q">
    <verse number="14" style="v" />¡B'itzana nintnam te Syon!</para>
  <para style="q">¡Che ẍch'ine' tu'n tzalajb'il, tnam te Israel!</para>
  <para style="q">¡Tzalajxa, Jerusalen,</para>
  <para style="q">tzalajxa tu'n tkyaqil tanmiya!</para>
  <para style="q">
    <verse number="15" style="v" />Matxi' tz'eltiq'i'nte Qman Dyos tz'e'ysb'il twitza</para>
  <para style="q">ex matxi' che eltik'o'n tajq'oja.</para>
  <para style="q">Ate Qman Dyos, nimaqkawil te Israel, ati kyxole':</para>
  <para style="q">Mixti'tl tu'n t-xob'a te jun taq'wix.</para>
  <para style="q">
    <verse number="16" style="v" />Tojtzunju' tq'ijlalil lu kxe'l q'ma'n te Jerusalen:</para>
  <para style="q">¡Lalun xob'a, Syon,</para>
  <para style="q">ex lalun taja tu'n tel kyipumalju' tq'ob'a!</para>
  <para style="q">
    <verse number="17" style="v" />Atite' Qman Dyos kxole';</para>
  <para style="q">¡kuwxi'xte', ex kkletela tu'n!</para>
  <para style="q">Ntzalaj te Qman Dyos ti'ja.</para>
  <para style="q">Kxe'l tq'o'nju' ak'a'j chwinqlal teya tu'nju' tk'ujlalil;</para>
  <para style="q">ex kb'itzil toju' ttzalajb'il</para>
  <para style="q">
    <verse number="18" style="v" />Kse'n toj ninq'ij.</para>
  <para style="q">Chi Qman Dyos kjalu:</para>
  <para style="q">Kntzaqpi'ya teju' taq'wix kxi'toq ttzaj ti'ja,</para>
  <para style="q">teju' ch'xawil ju' al tib'aja.</para>
  <para style="q">
    <verse number="19" style="v" />Knq'a'ye' tu'me'l t-xel kyeju'</para>
  <para style="q">kykyaqilju' mache okten yajulteya.</para>
  <para style="q">Kchin onile' ti'ju' rit nkoxjne</para>
  <para style="q">ex ktzajel wiq'inju'ye' xi'nitz'aq;</para>
  <para style="q">kche jawil nimane' ex b'a'n yolb'il kyeye'</para>
  <para style="q">toj tkyaqil twitz tx'otx',</para>
  <para style="q">aye'ju' ik'b'il kyeye' xb'inchanjtz.</para>
  <para style="q">
    <verse number="20" style="v" />Tojtzunju' tq'ijlalil lu</para>
  <para style="q">che ktzajel wiq'ine', kche tzajel nb'u'yine';</para>
  <para style="q">knch'exb'eye' kyanq'ib'le',</para>
  <para style="q">b'a'n kyolinjtze' ex ninb'el kyeye'</para>
  <para style="q">kxol kykyaqilju' tnam twitz tx'otx'.</para>
  <para style="q">Ayine', Dyos Manb'aj nchin q'mante.</para>
</usx>