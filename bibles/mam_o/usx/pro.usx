<?xml version="1.0" encoding="utf-8"?>
<usx version="2.6">
  <book code="PRO" style="id">PRO.TXT Febrero 2009 Pedro D. Cabrera Mam Ostuncalco. Updated for DBL by G. Grasso and E. Canales, December 2012, standardization after migration to PT8 by A. Camus March, 2019.</book>
  <para style="h">Proverbios</para>
  <para style="toc3">Pr</para>
  <para style="toc2">Pr</para>
  <para style="toc1">Kyu'jil Q'unb'en (Proverbios)</para>
  <para style="mt1">Q'UNB'EN</para>
  <para style="mt2">(Proverbios)</para>
  <para style="imt">CHIK'B'AB'L</para>
  <para style="ip">Aju' tu'jil Q'unb'en ati kyxolju' k'loj u'j te nab'l, ojexi'x ajb'en ojtxi' te xnaq'tzb'il. Aye'ju' q'unb'en mo yol ati tnab'l, tzak'b'il qekye', tzyu'nile kyten ex b'o'sqe', tu'n tb'ant kytzaj na'yet lwiy, tu'n kyb'ajx q'et xnaq'tzb'il mo nab'l tu'n kyanq'in xjal b'a'n ex tu'n kyokslan te Dyos. Tqik'i'n tzak'b'il qekye' tku'qe'x toju' u'j lu. Inb'ent kyxi' b'inchet ex ati jun tnab'l nim toklen toju' okslab'l, b'a'nqa nyolin kyi'j txqantl ti'xti'. Axi'x tb'is tk'u'ju' tu'n tkane toj qwitz qa ntzyetju' nab'l axxi'x tu'nju' nqo niman ex nqo b'in te Qman Dyos.</para>
  <para style="ip">Jun nab'lte' tojku'xi'xju' okslab'l, maskyepe' nyolin ti'j junjuntl ti'xti' ti'jxi' okslab'l, nim tzak'b'il toju' u'j lu.</para>
  <chapter number="1" style="c" />
  <para style="s1">Kyoklen q'unb'en</para>
  <para style="p">
    <verse number="1" style="v" />Aye' q'unb'en ja'lu tma Salomon nimaqkawil aj Israel, tk'wal Dab'i.</para>
  <para style="q">
    <verse number="2" style="v" />A kyajb'enju':</para>
  <para style="q">tu'n kyq'on nab'l, tu'n qelb'an,</para>
  <para style="q">ex tu'n tel kynik'tzilju' b'a'n nab'l.</para>
  <para style="q">
    <verse number="3" style="v" />Tu'n qanq'i'n tuk'i'l nab'l,</para>
  <para style="q">ex tu'n qok tnik'alqi'j, tz'aqli ex tu'n lalun qo eltxalpuj.</para>
  <para style="q">
    <verse number="4" style="v" />Tu'n tten kynab'lju' ku'xun na'mx ttenxi'x kynab'l,</para>
  <para style="q">tu'n kyel k'atz ex tu'n tb'ent kyximan b'a'nxi'x</para>
  <para style="q">
    <verse number="5" style="v" />Alkyete ati tnab'l ex b'a'n t-ximante, che kxeltb'i'n,</para>
  <para style="q">ktenb'elxi'xtzun tnab'ltz ex k'elel tnik'.</para>
  <para style="q">
    <verse number="6" style="v" />tu'n kykaneju' q'unb'en kyu'n ati kynab'l,</para>
  <para style="q">exju' kyyol, techlal, ex tu'n tpon toj kynab'l.</para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" />Inten qnab'l qama qnima Qman Dyos,</para>
  <para style="q">inel kyik'o'nkye xnakju' nab'l ex xnaq'tzb'il.</para>
  <para style="s1">Nab'l kye ku'xun</para>
  <para style="q">
    <verse number="8" style="v" />Nky'ajul, b'inxa nab'l nxinq'o'ne' teya</para>
  <para style="q">ex lalun tzik'tna'lju' t-xnaq'tzb'il ttxuya tu'na,</para>
  <para style="q">
    <verse number="9" style="v" />qu'n che okyelkye' te jun tuya</para>
  <para style="q">tb'anilqexi'x te achb'il tqula.</para>
  <para style="q">
    <verse number="10" style="v" />Qa kyajb'ilju' b'inchal il tu'n tkub' sb'u'na kyu'n,</para>
  <para style="q">¡lalun taja nky'ajul!</para>
  <para style="q">
    <verse number="11" style="v" />Qaj nkyma'nku' teya: Kuttzaja quk'i'le';</para>
  <para style="q">noqx qak'an qq'oku' xpatxab' toj b'e</para>
  <para style="q">tu'n tkyim jun b'a'nqa mixti' til.</para>
  <para style="q">
    <verse number="12" style="v" />Che b'elexkye' xjal tnik'alkyi'j toj qlaq</para>
  <para style="q">kse'nqe' kyimni nche'x tb'elq'u'n kamik toj muqb'il.</para>
  <para style="q">
    <verse number="13" style="v" />Ktenb'el txqan qq'inumal,</para>
  <para style="q">¡knojel tkyaqil toj qja tu'n qeleq'!</para>
  <para style="q">
    <verse number="14" style="v" />Qlana, toka quk'i'le',</para>
  <para style="q">ex tkyaqilju' ti'xti' kb'ajel qsipa'n qxolilex, qa chechi.</para>
  <para style="q">
    <verse number="15" style="v" />¡Laluntzun txi'ya kyuk'i'l nky'ajul!</para>
  <para style="q">Pa'mil tib'a ti'ju' kyb'e taq'wix,</para>
  <para style="q">
    <verse number="16" style="v" />qu'n nnoktilil kyu'n tu'n kyb'inchan il;</para>
  <para style="q">¡nnoktilil kyu'n tu'n tkub' qojl chik'!</para>
  <para style="b" />
  <para style="q">
    <verse number="17" style="v" />Mixti'x tajb'en jun xpatxab'</para>
  <para style="q">qa q'ancha'l kye pich',</para>
  <para style="q">
    <verse number="18" style="v" />aye'xkye' xjal lu nche kub' q'onte xpatxab' toj kyb'e</para>
  <para style="q">xob'ajilx ta'ju' kychwinqlal kyu'nx.</para>
  <para style="q">
    <verse number="19" style="v" />Ikytzun nche b'aja' jamjolju':</para>
  <para style="q">axju' kyjamjoni'n nkub'yonkye.</para>
  <para style="s1">Txokb'il tu'n nab'l</para>
  <para style="q">
    <verse number="20" style="v" />Inkub'sanju' nab'l tk'i' tq'ojq'ojel twi'</para>
  <para style="q">kyoj ninb'e ex kyoj xky'ichb'e;</para>
  <para style="q">
    <verse number="21" style="v" />npakb'an kytziju' tnam</para>
  <para style="q">jachaqja nkychmo'na' kyib' xjal toj nintnam.</para>
  <para style="b" />
  <para style="q">
    <verse number="22" style="v" />E' ku'xun mixti' b'a'n kyu'ne', twi'xmayil ex xnakqe'ye',</para>
  <para style="q">¿ma kukxtzun mache'xa'ju'ye' mixti' kynab'le',</para>
  <para style="q">ma kukxtzun kytzalaju'ye' toju' xmayb'il,</para>
  <para style="q">jtojtzun tz'ok kynab'le'?</para>
  <para style="q">
    <verse number="23" style="v" />Kyb'intzpe'ju'ye' ntzak'b'ile'</para>
  <para style="q">atzun nq'onxwe' nxew kyeye';</para>
  <para style="q">ex kxe'l nyek'u'nju'ye' nxime' kyeye'.</para>
  <para style="q">
    <verse number="24" style="v" />Oje che ntxokxi'ye', ex oje che nk'elxi'ye' tu'n kytzaje',</para>
  <para style="q">aye'tzunkye' min nkyb'i'ne'.</para>
  <para style="q">
    <verse number="25" style="v" />Inpe' el kyik'o'ne' nab'l xinq'o'ne';</para>
  <para style="q">min nkyq'a' tzak'u' kyib'e' weye'.</para>
  <para style="q">
    <verse number="26" style="v" />¡Kpomil tq'ijlalil chin tzele' kyi'je' ajkykub' b'o'lje'!</para>
  <para style="q">¡Chin jawiltzun xmayintze' kyi'je' ajkyb'aj ẍb'aje'ye' tu'n xob'il,</para>
  <para style="q">
    <verse number="27" style="v" />ajttzaju' xob'el ex yajb'il,</para>
  <para style="q">b'isb'ajil ex k'ixk'oj,</para>
  <para style="q">kse'n jun saqchanpach, nb'aj t-xitu'n tkyaqil!</para>
  <para style="b" />
  <para style="q">
    <verse number="28" style="v" />Atzun q'iju' chin kytxka'ye', laytzun chin tzaq'wiwe';</para>
  <para style="q">chin kyjyo'tzuntze', layx chin knete' kyu'ne';</para>
  <para style="q">
    <verse number="29" style="v" />qu'n nelkyik'u'nju'ye' nab'l</para>
  <para style="q">ex min kyajb'ile' tu'n kynimane' te Qman Dyos.</para>
  <para style="q">
    <verse number="30" style="v" />Min kyajb'ile' tu'n kyk'monteju'ye' nab'l;</para>
  <para style="q">ex nel kyik'o'nju'ye' tzak'b'il.</para>
  <para style="q">
    <verse number="31" style="v" />¡Aye'xe' cheb'o'ljel tu'n kyb'inchb'ene'!</para>
  <para style="q">¡ex aye'xe' che nik'b'elte kyxime' myab'a'n!</para>
  <para style="q">
    <verse number="32" style="v" />Tu'nx kynab'lju' mixti' b'a'n kyu'n che kyimela',</para>
  <para style="q">exqe' xnak che kb'el b'o'lj tu'nju' min nok toj kywi';</para>
  <para style="q">
    <verse number="33" style="v" />Atzunju' machin kub' tb'i'ne', k'anq'il toj nak'b'il</para>
  <para style="q">ex lay tzaj tchi jun xob'ajil ti'j. Chiju' nab'l.</para>
  <chapter number="2" style="c" />
  <para style="s1">B'a'n ntq'o'nju' nab'l</para>
  <para style="q">
    <verse number="1" style="v" />Nky'ajul, b'inxju'ya nyole';</para>
  <para style="q">che kyajxju' nchaq'b'ile' toj twi'ya.</para>
  <para style="q">
    <verse number="2" style="v" />B'inxju'ya ntma'nju' nab'l</para>
  <para style="q">ex xonk tk'u'ja tu'n tel k'atza.</para>
  <para style="q">
    <verse number="3" style="v" />Qaninxa tu'n tkyaqil tk'u'ja</para>
  <para style="q">tu'n tel k'atza ex tu'n t-ximana tojxi'x tu'me'l;</para>
  <para style="q">
    <verse number="4" style="v" />Q'onk tilila tu'n tjyonteya,</para>
  <para style="q">naku'xwitloj njyona ti'j saqpwaq mujqa ti'j jun k'uwenj e'wa'n.</para>
  <para style="q">
    <verse number="5" style="v" />Kkaneb'iltzuntz toj twitza tu'n tnimana te Qman Dyos;</para>
  <para style="q">¡K'eleltzun tnik'tza ti'j Qman Dyos!</para>
  <para style="q">
    <verse number="6" style="v" />Qu'n ate Qman Dyos ntzaj q'onte' nab'l;</para>
  <para style="q">toj ttzi netza' nab'l ex ojtzqib'l.</para>
  <para style="q">
    <verse number="7" style="v" />In oninte Qman Dyos ex nkolon</para>
  <para style="q">kyi'ju' nche anq'in toj tnik'alti'j ex mixti' kytzakajil;</para>
  <para style="q">
    <verse number="8" style="v" />Nche'x tka'yinju' nche b'et toj tnik'alti'j,</para>
  <para style="q">ex nkolon kyi'ju' njapun tyol kyu'n.</para>
  <para style="q">
    <verse number="9" style="v" />Ex k'elel tnik'a ti'ju' ttzinunal ex tnik'alilti'j</para>
  <para style="q">ex a ktb'incha'ju'ya b'a'n kukxju',</para>
  <para style="q">
    <verse number="10" style="v" />ktenb'il nim tnab'la</para>
  <para style="q">ex ktnik'b'e'ya tchi'yal ojtzqib'l.</para>
  <para style="q">
    <verse number="11" style="v" />Qa ati tnab'la ex b'a'n t-ximanteya</para>
  <para style="q">xq'uqi'n ttena kukxju';</para>
  <para style="q">
    <verse number="12" style="v" />Aye'tzun che klolteju'ya teju' tb'eyil myab'a'n</para>
  <para style="q">ex kyeju' xjal nche xitun tu'n kyol,</para>
  <para style="q">
    <verse number="13" style="v" />kyeju' nelkypa'n kyib' ti'ju' tb'eyil b'a'n</para>
  <para style="q">ex nche'x toju' tb'eyil qxopin,</para>
  <para style="q">
    <verse number="14" style="v" />nche tzalaj toju' myab'a'n nkyb'incha'n</para>
  <para style="q">ex nkub' kytzalajsa'n kyb'inchb'en taq'wix,</para>
  <para style="q">
    <verse number="15" style="v" />nche b'et kyoju' taq'wix b'e</para>
  <para style="q">ex matxi' che eltxalpuj ti'ju' b'a'n b'e.</para>
  <para style="q">
    <verse number="16" style="v" />Ex kkletela tu'n nab'l teju' qya ati tchmil,</para>
  <para style="q">chab'axi'x nxmoxon ex tb'anil tyol te juntl ichan,</para>
  <para style="q">
    <verse number="17" style="v" />nkyaj tkolb'e'n tchmil mje tuk'i'l txinxtoq</para>
  <para style="q">ex nik'tna'lju' tyol ttziya twitz Qman Dyos.</para>
  <para style="q">
    <verse number="18" style="v" />Alkyete matxi' tjaju' qya lu</para>
  <para style="q">toj tb'eyil kamik nb'eta';</para>
  <para style="q">
    <verse number="19" style="v" />aye'ju' nche'x tja layx tz'anjtztlkyi'j,</para>
  <para style="q">layx che pon jumajtl toju' tb'eyil chwinqlal.</para>
  <para style="q">
    <verse number="20" style="v" />Qu'mtzun b'eta toju' b'a'n b'e,</para>
  <para style="q">ex tz'anq'ina kse'nqe' tnik'alkyi'j.</para>
  <para style="q">
    <verse number="21" style="v" />Qu'n b'a'n che anq'ila'kye' tnik'alkyi'j ex b'a'n kychwinqlal</para>
  <para style="q">kukxju' twitz tx'otx';</para>
  <para style="q">
    <verse number="22" style="v" />aye'tzu'n b'inchal myab'a'n ex nche jawmiltz'uj</para>
  <para style="q">che jawil xb'oqi'n ex che b'je'lex xon.</para>
  <chapter number="3" style="c" />
  <para style="s1">Ab'tzib'l tu'n qpon kanun ti'ju' nab'l</para>
  <para style="q">
    <verse number="1" style="v" />Nky'ajul, lalun tzik'kyna'lju' nxnaq'tzb'ile' tu'na;</para>
  <para style="q">che kyajxju' nchaq'b'ile' toj twi'ya,</para>
  <para style="q">
    <verse number="2" style="v" />ktenb'iltzun tchwinqlaltza nimtoj</para>
  <para style="q">ex toj tzalajb'il.</para>
  <para style="q">
    <verse number="3" style="v" />Lalun naju' tk'ujlalila exju' ax yolina;</para>
  <para style="q">uwanqe'ka tqula nakuj tuya,</para>
  <para style="q">Majx na'nqeku'ya,</para>
  <para style="q">
    <verse number="4" style="v" />Laytzun b'ajta tk'monte</para>
  <para style="q">tu'n Qman Dyos ex kyu'n xjal</para>
  <para style="q">
    <verse number="5" style="v" />qek tk'uja ti'j Qman Dyos tuk'i'l tkyaqil tk'u'ja</para>
  <para style="q">ex lalun tz'okqe tk'u'ja ti'jxu' tnab'la.</para>
  <para style="q">
    <verse number="6" style="v" />Na'ntza Qman Dyos toj tkyaqilju' ntb'incha'na,</para>
  <para style="q">ate kxel q'inteya toju' tb'eyil b'a'n.</para>
  <para style="q">
    <verse number="7" style="v" />Lalun t-ximaya qa atixi'x tnab'la;</para>
  <para style="q">nimana te Qman Dyos ex tzaqpinkja myab'a'n:</para>
  <para style="q">
    <verse number="8" style="v" />¡Atzunte tb'anil q'a'nb'ilju'</para>
  <para style="q">tu'n tkuwix t-xmilala!</para>
  <para style="b" />
  <para style="q">
    <verse number="9" style="v" />Nimana te Qman Dyos tu'nju' ati teya</para>
  <para style="q">ex tuk'i'lju' tnejel twitz tawala,</para>
  <para style="q">
    <verse number="10" style="v" />ikytzu'n che nojel tk'ujatzu'ya</para>
  <para style="q">laype' b'ajxtl ex lay che kanun kykb'el ub'a.</para>
  <para style="b" />
  <para style="q">
    <verse number="11" style="v" />Nky'ajul, lalun tik'u'ya juk'b'il tu'n Qman Dyos,</para>
  <para style="q">ex lalun tzaj ttx'ujila tiju' ttzak'b'il;</para>
  <para style="q">
    <verse number="12" style="v" />qu'n in ttzak'u'nte Qman Dyosju' ntk'u'jla'nxi'x,</para>
  <para style="q">kse'n jun manb'aj nttzak'u'n tk'wal kye tilwi tu'n.</para>
  <para style="b" />
  <para style="q">
    <verse number="13" style="v" />Tzalajb'ilte' teju' xjal nknon nab'l,</para>
  <para style="q">ex nknon k'atzil;</para>
  <para style="q">
    <verse number="14" style="v" />qu'n nimxi'x tajb'en kyetwitz saqpwaq</para>
  <para style="q">ex wi'yalxi'x kyetwitz q'anpwaq.</para>
  <para style="q">
    <verse number="15" style="v" />Nim toklenju' nab'l kyekywitz tb'anil ab'j;</para>
  <para style="q">¡expena' min nche ponju' ti'xti' achb'ajil qe'xi'x ikyju'!</para>
  <para style="q">
    <verse number="16" style="v" />Ntq'o'n chwinqlal nimtoj tu'n tb'anq'ob',</para>
  <para style="q">atzu'n tu'n tnayaj, ntq'o'n q'inumal ex oklenj.</para>
  <para style="q">
    <verse number="17" style="v" />Tb'anilxi'xte' tu'n qlpe ti'j;</para>
  <para style="q">qo anq'il toj nak'b'il qama qob'et kyoju' tb'eyil.</para>
  <para style="q">
    <verse number="18" style="v" />Anq'ib'lte' nab'l teju' nk'monte,</para>
  <para style="q">¡tzalajb'ilte' kyeju' tokkywitz ti'j!</para>
  <para style="q">
    <verse number="19" style="v" />Kub' tb'incha'n Dyos tx'otx' tuk'i'l nab'l,</para>
  <para style="q">ex ximan b'a'nxi'x tej tkub' tb'incha'n kya'j;</para>
  <para style="q">
    <verse number="20" style="v" />tu'n nab'l kub'a' taq'pu'nju' ninnjab'</para>
  <para style="q">ex tu'n ntzaja' ẍmu's toj muj.</para>
  <para style="b" />
  <para style="q">
    <verse number="21" style="v" />Nky'ajul, tz'okxa ati tnab'la kukxju',</para>
  <para style="q">ex lalun tz'el txalpuja ti'j,</para>
  <para style="q">
    <verse number="22" style="v" />qu'n chwinqlalte' teya</para>
  <para style="q">ex naku'j u'wj te achb'il ti'ja.</para>
  <para style="q">
    <verse number="23" style="v" />Q'uqlixi'x tk'u'ja ajt-xiya toj b'e</para>
  <para style="q">ex layx jaw tz'aqiya.</para>
  <para style="q">
    <verse number="24" style="v" />Ajtzun txi'ya kẍeb'il, lay xob'a;</para>
  <para style="q">ajtzun txi'ya wtal, watlxte' teya.</para>
  <para style="q">
    <verse number="25" style="v" />Qa nab'en saj jun ti'xti' lay xob'ta</para>
  <para style="q">ex lay xob'a teju' tzul kyib'aju' b'inchal myab'a'n,</para>
  <para style="q">
    <verse number="26" style="v" />qu'n atite' Qman Dyos tuk'i'la</para>
  <para style="q">lay taj tu'n tkub' tz'aqa.</para>
  <para style="b" />
  <para style="q">
    <verse number="27" style="v" />Qama qaninjtz xtalb'il teya,</para>
  <para style="q">lalun kub' t-xk'a'yi'n tib'a qa ati tu'me'l tu'n tb'inchanteya.</para>
  <para style="q">
    <verse number="28" style="v" />Lalun kyej tq'o'na xtalb'il te najchi'jxi'</para>
  <para style="q">aju' kb'antel tb'inchanteya ja'lo.</para>
  <para style="q">
    <verse number="29" style="v" />Lalun kub't-xima'n jun ti'xti'ya myab'a'n</para>
  <para style="q">ti'ju' xjal q'uqlok tk'u'j ti'ja.</para>
  <para style="q">
    <verse number="30" style="v" />Lalun jyon q'oja tuk'i'l jun xjal,</para>
  <para style="q">qa mixti'te soktb'incha'n teya.</para>
  <para style="q">
    <verse number="31" style="v" />Lalun tx'a'lti'j tk'u'ja ti'ju' b'inchal taq'wix</para>
  <para style="q">ex lalun tz'el tkno'nju'ya ntb'incha'n;</para>
  <para style="q">
    <verse number="32" style="v" />qu'n ik'u'nqekye' b'inchal myab'a'n tu'n Qman Dyos,</para>
  <para style="q">aye'tzu'n b'a'n xjal ntzalaj kyi'j.</para>
  <para style="q">
    <verse number="33" style="v" />Nkub'ju' qanb'en tu'n Qman Dyos kyib'aj kyja b'inchal myab'a'n,</para>
  <para style="q">atzu'n toj kyja tnik'alkyi'j nche tzaj tk'iwla'n.</para>
  <para style="q">
    <verse number="34" style="v" />Nxmayinte Qman Dyos kyi'ju' twi' xmayilqe',</para>
  <para style="q">aye'tzu'n me'sqe' kye kyilwi tu'n.</para>
  <para style="q">
    <verse number="35" style="v" />Kyekye ati kynab'lju' ninb'il,</para>
  <para style="q">aye'tzu'n xnakqe', kych'ixaw nel.</para>
  <chapter number="4" style="c" />
  <para style="s1">Oqxenb'il tu'n qxi' toj b'a'n b'e</para>
  <para style="q">
    <verse number="1" style="v" />Nky'ajul, kyb'inxe' nab'l tu'n kymane';</para>
  <para style="q">kyq'onk kywi'ye' ti'j, tu'n tok kynab'le'.</para>
  <para style="q">
    <verse number="2" style="v" />Matxi' che'x nxnaq'tza'ne',</para>
  <para style="q">qu'mtzun lalun kub' kytxa'ju'ne'.</para>
  <para style="q">
    <verse number="3" style="v" />Ikxwe' machinokye' te k'wa'lb'aj:</para>
  <para style="q">kyexi'xtoq wilwiye' tu'n ntxuye'</para>
  <para style="q">
    <verse number="4" style="v" />Atoqwe' nq'umli we tu'n nman kjalu:</para>
  <para style="q">Kyejxju' nyole' toj twi'ya;</para>
  <para style="q">b'inchanxya nchaq'b'ile', k'anq'iltzuntza.</para>
  <para style="q">
    <verse number="5" style="v" />Knom tnab'la ex tz'okxa ati tnab'la;</para>
  <para style="q">lalun tzik'kyna'lju' nyole' tu'na.</para>
  <para style="q">
    <verse number="6" style="v" />Xonk tk'u'ja ti'ju' nab'l, lalun kyej ttzoqpi'na</para>
  <para style="q">qu'n kkletela tu'n.</para>
  <para style="q">
    <verse number="7" style="v" />Ate nojqelanju' tnejelxi'x kywitz txqantl ti'xti'</para>
  <para style="q">aju' tu'n tten tnab'la ex tu'n toka k'atz.</para>
  <para style="q">
    <verse number="8" style="v" />Xonk tk'u'ja ti'j, ex kjawil laq'b'a'na tu'n;</para>
  <para style="q">chlema, ex kjawil nima'na tu'n;</para>
  <para style="q">
    <verse number="9" style="v" />¡kjawix tq'o'n jun koron b'echile toj twi'ya</para>
  <para style="q">te jun oklenj tb'anilxi'x! chij.</para>
  <para style="q">
    <verse number="10" style="v" />Nky'ajul, b'intzju'ya nyole',</para>
  <para style="q">k'monqe'ma, k'anq'iltzuntza nimtoj.</para>
  <para style="q">
    <verse number="11" style="v" />Kxel wiq'i'na toju' tb'eyil nab'l:</para>
  <para style="q">kxel nxb'etza'na toju' b'a'n b'e.</para>
  <para style="q">
    <verse number="12" style="v" />Ja lay tz'ok tokpaja'ya,</para>
  <para style="q">expe' lay jaw tokpaja aj tojqelana.</para>
  <para style="q">
    <verse number="13" style="v" />Tuneka ti'ju' xnaq'tzb'il, lan kub' ttxa'ju'na;</para>
  <para style="q">chwinqlanku'ya qu'n ate chwinqlalju'.</para>
  <para style="q">
    <verse number="14" style="v" />Lalun txilpeya kyi'ju' b'inchal myab'a'n,</para>
  <para style="q">lalun txitkno'nju'ya kyb'inchb'en taq'wix.</para>
  <para style="q">
    <verse number="15" style="v" />Lalun txi'ya toju' kyb'e;</para>
  <para style="q">pa'mil tib'a kyi'j ex ljomta tb'e,</para>
  <para style="q">
    <verse number="16" style="v" />myab'a'n nkyna'n qa min nche b'inchan taq'wix;</para>
  <para style="q">nel kywatl, qa min nkyim jun xjal kyu'n.</para>
  <para style="q">
    <verse number="17" style="v" />¡Majx kywaju' taq'wixil</para>
  <para style="q">ex kyk'wa'ju' q'oj nkyb'incha'n!</para>
  <para style="b" />
  <para style="q">
    <verse number="18" style="v" />Iky kyb'e tnik'alkyi'ju' kse'n spik'un ajqsqix:</para>
  <para style="q">ch'i'naq t-spik'e', o'kx aj tjawul qoptz'aj b'a'nxi'x.</para>
  <para style="q">
    <verse number="19" style="v" />Atzu'nte' kyb'eju' b'inchal myab'a'n qlolj b'a'nxi'x;</para>
  <para style="q">¡mixpeti'x nelkynik' alqi'j nche jaw tokpaja'!</para>
  <para style="q">
    <verse number="20" style="v" />B'intzju'ya nyole', nky'ajul;</para>
  <para style="q">b'inqeku'ya.</para>
  <para style="q">
    <verse number="21" style="v" />Lalun tz'el tpa'ntib'a kyi'j,</para>
  <para style="q">¡che kyajx toj twi'ya!</para>
  <para style="q">
    <verse number="22" style="v" />Chwinqlalte' ex q'a'nb'il</para>
  <para style="q">kyeju' nokyal kyu'n.</para>
  <para style="q">
    <verse number="23" style="v" />Ka'yinxa tnab'la tib'aj tkyaqil,</para>
  <para style="q">qu'n a tlok' chwinqlalju'.</para>
  <para style="q">
    <verse number="24" style="v" />Lalun txitma'n jun ti'xti'ya mya ax;</para>
  <para style="q">pa'mil tib'a ti'ju' chajyolil.</para>
  <para style="q">
    <verse number="25" style="v" />O'kxtzu' ka'yinxa'ya twitza,</para>
  <para style="q">o'kxtzu' ka'yinxa'ya tzinun twitza.</para>
  <para style="q">
    <verse number="26" style="v" />Ka'yinxa b'a'nxi'x ja nb'eta'ya,</para>
  <para style="q">tu'ntzun tb'eta kukxu' toj b'a'n b'e.</para>
  <para style="q">
    <verse number="27" style="v" />Lalun txalpuja ti'ju' tb'eya;</para>
  <para style="q">lalun txi'ya toj tb'eyil taq'wixil.</para>
  <chapter number="5" style="c" />
  <para style="s1">Nkub'o'lju' ichan tu'n qya ajpajil</para>
  <para style="q">
    <verse number="1" style="v" />Nky'ajul, b'inku'ya nnab'le';</para>
  <para style="q">q'onk twi'ya ti'ju' xinb'ente wu'ne'.</para>
  <para style="q">
    <verse number="2" style="v" />Kximaltzuntza ti'j tyola</para>
  <para style="q">kyoliltzuntza tuk'i'l ojtzqib'l.</para>
  <para style="q">
    <verse number="3" style="v" />Qu'n majx tb'anilxi'x yolinju' qya ajpajil</para>
  <para style="q">Nxi'x so'jlan tuk'i'l tyol;</para>
  <para style="q">
    <verse number="4" style="v" />majxtzun k'axi'x npona' b'aj kse'n xmasin</para>
  <para style="q">majx tzayunxi'x kyetwitz k'uẍtx'e'nb'il kab'e' plaj twitzte.</para>
  <para style="q">
    <verse number="5" style="v" />Toj tb'eyil kamik ika' qxa' qama tz'okx qq'o'nqib' tuk'i'l;</para>
  <para style="q">toj muqb'il in pona' yalju' tb'e.</para>
  <para style="q">
    <verse number="6" style="v" />Min nximante' qya lu ti'ju' tb'eyil chwinqlal</para>
  <para style="q">ex min neltnik' qa myab'a'nju' tb'e ljo'n.</para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" />Qu'mtzun chin tb'iku'ya nky'ajul,</para>
  <para style="q">lan tz'el tpa'ntib'a kyi'ju' nxnaq'tzb'ile'.</para>
  <para style="q">
    <verse number="8" style="v" />Pa'mil tib'a ti'ju' qya ajpajil;</para>
  <para style="q">lalunpe' txi' lq'eya ttzi tja.</para>
  <para style="q">
    <verse number="9" style="v" />Tu'ntzun lalun b'ajx tq'o'na ati teya ex tchwinqlala</para>
  <para style="q">toj kyq'ob' junxi'tl xjal ex mya'lqe';</para>
  <para style="q">
    <verse number="10" style="v" />tu'ntzun mya junxi'tl jawb'ent</para>
  <para style="q">tu'nju' taq'unb'ena nnoktilil.</para>
  <para style="q">
    <verse number="11" style="v" />Tzul toj tk'u'ja qa min xtb'iya</para>
  <para style="q">ajtna'nteya xi'tkub'aja.</para>
  <para style="q">
    <verse number="12" style="v" />Ktma'tzuntza: ¡Se'n taq'wi min xnb'iju'ye' nab'l!</para>
  <para style="q">¡Se'n taq'wi min xwaq' tzak'u' wib'e'!</para>
  <para style="q">
    <verse number="13" style="v" />¡Mixti'x ẍe'x nb'i'ne' xnaq'tzalweye',</para>
  <para style="q">ex min ẍe'x nb'i'nju'ye q'ol nnab'le'.</para>
  <para style="q">
    <verse number="14" style="v" />Naqxi'x ch'intl miẍin k'ulb'ana'ye'</para>
  <para style="q">kywitz kykyaqil xjal! Chiloya.</para>
  <para style="b" />
  <para style="q">
    <verse number="15" style="v" />Qa nk'wajtiya</para>
  <para style="q">k'wana ti'jxju' t-xocha.</para>
  <para style="q">
    <verse number="16" style="v" />Lalun naq tz'oktena qolteju' taya;</para>
  <para style="q">lalun tz'oktena ẍa'lulte toj b'e.</para>
  <para style="q">
    <verse number="17" style="v" />Tenata' a' ex xoch, ex mya te juntl;</para>
  <para style="q">¡lalun kub' tmoji'na kyuk'i'l txqantl!</para>
  <para style="q">
    <verse number="18" style="v" />¡K'i'wla'nxwitju' t-xocha!</para>
  <para style="q">¡Tzalajxa tuk'i'l t-xu'jila tzajx toj tku'xumala,</para>
  <para style="q">
    <verse number="19" style="v" />tb'anil kse'n jun tal msat!</para>
  <para style="q">¡Kukxwit ttz'u'linjtzju'ya tu'n!</para>
  <para style="q">¡Kukxwit ttzalaja tu'n tk'ujlalil!</para>
  <para style="b" />
  <para style="q">
    <verse number="20" style="v" />¿Nky'ajul, sentaq'wi k'okyil ye'ya ti'j jun qya ajpajil?</para>
  <para style="q">¿se'n taq'wi kxe'l tq'a' tz'u'li' tib'a te?</para>
  <para style="q">
    <verse number="21" style="v" />Tokte Qman Dyos twitz ti'ju' tb'inchb'en xjal;</para>
  <para style="q">ex kanli twitz janb'eta'.</para>
  <para style="q">
    <verse number="22" style="v" />Nkub' tz'aqju' b'inchal myab'a'n tojxju' tb'inchb'en;</para>
  <para style="q">ax nb'aj t-xwaku'n tib' toju' tb'inchb'en naku'j toj aqwil.</para>
  <para style="q">
    <verse number="23" style="v" />Kkyimel tu'nx tnab'l;</para>
  <para style="q">knajel tu'nxju' t-xnakyil.</para>
  <chapter number="6" style="c" />
  <para style="s1">Oqxenb'il kyeju' nkyq'o'n kyyol ti'j tk'as juntl</para>
  <para style="q">
    <verse number="1" style="v" />Nky'ajul, qama taq'tib'a yolil ti'j tk'as tamiwa</para>
  <para style="q">mujqa ti'j tk'as juntl xjal,</para>
  <para style="q">
    <verse number="2" style="v" />Xpatxab' nkub' tq'o'na toj tb'eya:</para>
  <para style="q">Axju' tyola nkub' jtz'onteya.</para>
  <para style="q">
    <verse number="3" style="v" />Tu'ntzun ttzaqpeta nky'ajul,</para>
  <para style="q">atina'ya toj tq'ob' juntl,</para>
  <para style="q">a b'inchamju'ya:</para>
  <para style="q">me'ssankutib'a ex kutxi'ya yolil tuk'i'lju' jata' k'as tu'n ttzaqpinjtza tu'n.</para>
  <para style="q">
    <verse number="4" style="v" />Lalun wtana,</para>
  <para style="q">lalun txitq'o'n che'wa toj;</para>
  <para style="q">
    <verse number="5" style="v" />kutoqa kse'n jun msat ajtkub' oq twitz jun ub'al;</para>
  <para style="q">kse'n jun pich' ajtoq te xpatxab'.</para>
  <para style="s1">Tzak'b'ilkye ky'aj</para>
  <para style="q">
    <verse number="6" style="v" />Nimaqky'ej, ka'yi'k qepe'ju'ya snik;</para>
  <para style="q">ka'yinxa titi' nb'ajkye, ex knomil jun tnab'la kyi'j:</para>
  <para style="q">
    <verse number="7" style="v" />maskyepe' mixti' jun kynejel</para>
  <para style="q">ex mix-a'lo' chq'olkye ti'j kyaq'un,</para>
  <para style="q">
    <verse number="8" style="v" />nb'aj kyk'u'n kywa toj q'ijal,</para>
  <para style="q">nb'aj kychmo'n ajtb'uyet twitz awal.</para>
  <para style="q">
    <verse number="9" style="v" />¡Wix we'ktza ky'aj!</para>
  <para style="q">¡Wix jawe'ya!</para>
  <para style="q">
    <verse number="10" style="v" />Qu'n qa nxnakwiya ex nwitzk'ana,</para>
  <para style="q">inxi'x kub' tchle'n tq'ob'a tu'n twtana b'a'nxi'x,</para>
  <para style="q">
    <verse number="11" style="v" />tzul prowil ex k'okyel tzaqpaj ti'ja</para>
  <para style="q">naku'j jun eleq' iq'i'n tq'aq'.</para>
  <para style="s1">Se'n ka'yinju' b'inchal myab'a'n</para>
  <para style="q">
    <verse number="12" style="v" />Aju' b'inchal myab'a'n ex elsal ch'xaw</para>
  <para style="q">naq nchan yol kukxju';</para>
  <para style="q">
    <verse number="13" style="v" />nxmutz'mun twitz,</para>
  <para style="q">nkub' tjuma'n tqan</para>
  <para style="q">nyek'laj kyu'n twi'tq'ob';</para>
  <para style="q">
    <verse number="14" style="v" />naq taq'wix tokx toj twi',</para>
  <para style="q">o'kxtzu' nximana' tu'n tb'inchan myab'a'n</para>
  <para style="q">ex naq njyon q'oj.</para>
  <para style="q">
    <verse number="15" style="v" />Qu'mtzun, noqx minab'en ajtk'ulb'an;</para>
  <para style="q">naq jun mutz'inx kb'o'ljela'</para>
  <para style="q">ex layx b'entl.</para>
  <para style="s1">Ti'xti' nche eltik'o'n Qman Dyos</para>
  <para style="q">
    <verse number="16" style="v" />Ate' qaq ti'xti', wuq penate'</para>
  <para style="q">majx ik'o'nqe' tu'n Qman Dyos,</para>
  <para style="q">
    <verse number="17" style="v" />aye'ju' nimjtib'il,</para>
  <para style="q">chajyolil,</para>
  <para style="q">b'yojxjal mixti' kyil.</para>
  <para style="q">
    <verse number="18" style="v" />Aju' xjal majx nximan tu'n tb'inchan il,</para>
  <para style="q">exju' noktilil tu'n, tu'n tb'inchan myab'a'n,</para>
  <para style="q">
    <verse number="19" style="v" />aju' nok tq'o'ntib' tziyal chajyolil,</para>
  <para style="q">exju' njyon q'oj kyxol xjal kyitz'in kyib'.</para>
  <para style="s1">Aju' il ntzaj tu'n tpaj ajpaji'n</para>
  <para style="q">
    <verse number="20" style="v" />Nky'ajul, majx na'nqe'ku'ju'ya tchaq'b'il tmana</para>
  <para style="q">ex t-xnaq'tzb'il ttxuya.</para>
  <para style="q">
    <verse number="21" style="v" />Majx na'qeku'ya,</para>
  <para style="q">uwanqe'ka tqula,</para>
  <para style="q">
    <verse number="22" style="v" />kẍaqlunjtzela kyu'n aj txi'ya toj tb'eya,</para>
  <para style="q">kxq'uqinjtzela kyu'n aj twtana,</para>
  <para style="q">che yolil teya aj ttzaj tna'ntib'a.</para>
  <para style="b" />
  <para style="q">
    <verse number="23" style="v" />Axxi'x, spik'un qe'kye' chaq'b'il ex xnaq'tzb'il;</para>
  <para style="q">tb'eyil chwinqlalte' tzak'b'il ex nab'l.</para>
  <para style="q">
    <verse number="24" style="v" />Kklonjtzela kyu'n teju' qya b'inchal myab'a'n,</para>
  <para style="q">ex kye' tyolju' qya ajpajil kyexi'x tb'inx.</para>
  <para style="q">
    <verse number="25" style="v" />lalun tz'oklaqja ti'ju' ka'yin;</para>
  <para style="q">¡lalun txab'tzeta tu'n twitz ajttzaj ka'yin teya!</para>
  <para style="b" />
  <para style="q">
    <verse number="26" style="v" />Aju' qya eqch ntq'o'ntib' naq tu'n twa,</para>
  <para style="q">atzunte' qya ajpajil axi'x ntjyo'nju' ichan b'a'n ta'.</para>
  <para style="b" />
  <para style="q">
    <verse number="27" style="v" />Alkyete makub' tq'o'n q'aq' ttzitk'u'j,</para>
  <para style="q">kb'ajel tz'e'yju' t-xb'alun.</para>
  <para style="q">
    <verse number="28" style="v" />Alkyete' mab'et tib'aj ttxalq'aq',</para>
  <para style="q">kb'ajel tz'e'y tqan.</para>
  <para style="q">
    <verse number="29" style="v" />Ikxtzun matz'okx tq'o'n tib'ju' tuk'i'l t-xu'jil juntl,</para>
  <para style="q">ilti'j kyb'el tz'e'ysa'n twitz.</para>
  <para style="b" />
  <para style="q">
    <verse number="30" style="v" />Lay tz'el ik'u'n jun eleq'</para>
  <para style="q">qama tz'elq'an tu'n tpaj twa,</para>
  <para style="q">
    <verse number="31" style="v" />qatzun matz'elyal,</para>
  <para style="q">ati tu'n tchjonte wuq maju' teleq',</para>
  <para style="q">expe' kxel tb'ajsa'n tkyaqilju' ati te.</para>
  <para style="b" />
  <para style="q">
    <verse number="32" style="v" />¡Mixti'x tnab'lju' ichan nokx tq'o'ntib' tuk'i'lju' qya ati tchmil</para>
  <para style="q">Qu'n ax nkub' b'o'ljsantetib'!</para>
  <para style="q">
    <verse number="33" style="v" />Kb'ajel b'yo'n ex kb'ajel yasu'n,</para>
  <para style="q">ex layx tzik'tna'lju' tch'ixaw.</para>
  <para style="q">
    <verse number="34" style="v" />Qu'n ikyte ichan kuw xk'yaqlin kse'n q'aq',</para>
  <para style="q">layx kub' tnajsa'n til qama tzyet tu'n;</para>
  <para style="q">
    <verse number="35" style="v" />lay tk'am qama txiq'o'n jun oyaj te,</para>
  <para style="q">b'a'n qama txiq'o'n txqan oyaj te layx kub' tk'u'j.</para>
  <chapter number="7" style="c" />
  <para style="s1">Tsb'ub'lju' qya ajpajil</para>
  <para style="q">
    <verse number="1" style="v" />Nky'ajul, nimanqe'xju'ya nyole';</para>
  <para style="q">che kyajxju' nchaq'b'ile' toj twi'ya.</para>
  <para style="q">
    <verse number="2" style="v" />Che japunxju' nchaq'b'ile' tu'na exqe' nxnaq'tzb'ile';</para>
  <para style="q">k'u'jlamqe'ya kse'nqe' tyuẍil twitza, atitzunte anq'ib'ltz.</para>
  <para style="q">
    <verse number="3" style="v" />Q'onqe'ka te txmilq'ob'a,</para>
  <para style="q">majx na'nqeku'ya.</para>
  <para style="q">
    <verse number="4" style="v" />Q'onka nab'l naku'j tanab'a,</para>
  <para style="q">ex tu'nju' k'atz twi'ya q'onka naku'j tamiwa.</para>
  <para style="q">
    <verse number="5" style="v" />Aye'kye che klolteju'ya teju' qya ajpajil,</para>
  <para style="q">teju' qya eqch kyexi'x tb'inxju' tyol.</para>
  <para style="b" />
  <para style="q">
    <verse number="6" style="v" />Jun q'ij intoq chin ka'yimixe'</para>
  <para style="q">kyxolju' kutxb'il ti'ju' tokexspik'un</para>
  <para style="q">
    <verse number="7" style="v" />tej kyxi' nka'yi'ne' jte' ku'xun na'mxi'x tok kynab'l,</para>
  <para style="q">ex elnnik'e' ti'ju' jun mixti'x tnab'l kyxol.</para>
  <para style="q">
    <verse number="8" style="v" />tej tpon toj xky'ichb'e</para>
  <para style="q">tu'me'l tjaju' qya na'j.</para>
  <para style="q">
    <verse number="9" style="v" />Xi'toq tok qale,</para>
  <para style="q">ex xi'toq qok yupj.</para>
  <para style="q">
    <verse number="10" style="v" />Minab'en etzju' qya k'lulte,</para>
  <para style="q">b'inchla'n tib' ex inxi'x tze'je kse'n jun qya ajpajil,</para>
  <para style="q">
    <verse number="11" style="v" />Jun qya elsal ch'xaw ex min nxob'</para>
  <para style="q">naqx toj b'e ta'</para>
  <para style="q">
    <verse number="12" style="v" />nb'etinje kyojile b'e, jachaq ta'qe' xjal ex toj xky'ichb'e</para>
  <para style="q">nnayon tiju' tnejel matzik' tu'n tkub' tu'n.</para>
  <para style="q">
    <verse number="13" style="v" />Xi' chlelte ku'xun ex oktma'tzi'n,</para>
  <para style="q">ex mixti'x nch'ixwi xitma'n te:</para>
  <para style="q">
    <verse number="14" style="v" />Oje kub' nximane' tu'n txi' nq'o'ne' chojb'il te xk'ojb'il laq,</para>
  <para style="q">matxitzun che japun wu'ne' ja'lo.</para>
  <para style="q">
    <verse number="15" style="v" />Qu'mtzun machin tzaje' k'lulteya;</para>
  <para style="q">¡wajb'ilxi'xtoqe' tu'n toknka'yina, b'a'nxpetzulo selyala wu'ne'!</para>
  <para style="q">
    <verse number="16" style="v" />Matxi' kub' nsku'ne' jun tb'anil xb'alun sed tib'aj nkuẍb'ile'</para>
  <para style="q">tzajni Ejipt,</para>
  <para style="q">
    <verse number="17" style="v" />matxi' kub' nq'o'ne' k'ok'sb'il npuk'chaj</para>
  <para style="q">tk'ok'jal mir, alowe ex kanel.</para>
  <para style="q">
    <verse number="18" style="v" />Qo'ya, qo tz'ulin ex qo achin;</para>
  <para style="q">qo tzalajx, qo sqixel tu'n qtz'ulin,</para>
  <para style="q">
    <verse number="19" style="v" />qu'n mix-a'lo'we' nchmil ja:</para>
  <para style="q">matxi' toj jun tb'e najchaq;</para>
  <para style="q">
    <verse number="20" style="v" />majx matxi' b'ent txqan tpwaq</para>
  <para style="q">ex tzulxi' ajt-xk'o'mix xjaw. Chiju' qya te.</para>
  <para style="b" />
  <para style="q">
    <verse number="21" style="v" />Ok il b'a'nxi'x ti'ju' ku'xun</para>
  <para style="q">ex kub'ti'j tu'n tyolju' qya majx kyexi'x tb'inx,</para>
  <para style="q">
    <verse number="22" style="v" />o'kx tik'lpe ti'ju' qya:</para>
  <para style="q">kse'n wakx nik' xikyikyin ajt-xi' toj b'i'yb'ilte,</para>
  <para style="q">naku'j jun msat ajtkub' tz'aq toj jun xpatxab',</para>
  <para style="q">
    <verse number="23" style="v" />naqx tu'n taq'pon xontl tu'n talsmaj</para>
  <para style="q">kse'n jun pich' nokx jumtz'aj toj xpatxab'</para>
  <para style="q">ex min b'i'n tu'n qa atzu' kb'ajela'.</para>
  <para style="b" />
  <para style="q">
    <verse number="24" style="v" />Qu'mtzun nky'ajul, chin tb'iku'ya;</para>
  <para style="q">b'inqe'ku'ju'ya nyole'.</para>
  <para style="q">
    <verse number="25" style="v" />Lalun tz'okxten qya lu toj twi'ya;</para>
  <para style="q">naq txalpuja, lalun txilpeya ti'j,</para>
  <para style="q">
    <verse number="26" style="v" />qu'n b'a'npunxi' che'x tiq'i'n toj kamik;</para>
  <para style="q">¡expe' txqanxi' xjal che Kub' tb'yo'n!</para>
  <para style="q">
    <verse number="27" style="v" />aju' tb'eyil tja</para>
  <para style="q">a tb'eyil kamikju'.</para>
  <chapter number="8" style="c" />
  <para style="s1">Ntxokonju' nab'l</para>
  <para style="q">
    <verse number="1" style="v" />Intxokon nab'l;</para>
  <para style="q">ex njaw tq'ojq'ojel twi' k'atzil.</para>
  <para style="q">
    <verse number="2" style="v" />Inkub'we' twi' b'us,</para>
  <para style="q">nkub' we' toj kyajb'e,</para>
  <para style="q">
    <verse number="3" style="v" />nkub'ten janqo okxa' toj nintnam,</para>
  <para style="q">njaw tma'n kuw ttzi nintnam kjalu:</para>
  <para style="q">
    <verse number="4" style="v" />Inchin yoline' kyeye' xjal.</para>
  <para style="q">
    <verse number="5" style="v" />Ku'xun mixti' kyojtzqib'le' ex xnakqe'ye',</para>
  <para style="q">¡che okxe' ati kynab'le' ex che ximane' b'a'n!</para>
  <para style="q">
    <verse number="6" style="v" />Kyb'intzpeye', che kxe'l nma'ne' yol nim kyoklen</para>
  <para style="q">che kxe'l nma'ne' tu'me'lqexi'x kyeye'.</para>
  <para style="q">
    <verse number="7" style="v" />Axte' kxe'l nma'n kyeye';</para>
  <para style="q">inel wik'o'nwe' chajyolil.</para>
  <para style="q">
    <verse number="8" style="v" />tkyaqilju' nyole' japumnixi'x;</para>
  <para style="q">mixti' chajyolil toj.</para>
  <para style="q">
    <verse number="9" style="v" />Chik'li qe'we' nyol teju' xjal k'atz,</para>
  <para style="q">ttxolilti'j teju' nkane toj twitz.</para>
  <para style="q">
    <verse number="10" style="v" />Kyknome' xnaq'tzb'il ex ojtzqib'l wu'ne',</para>
  <para style="q">te t-xel q'anpwaq ex saqpwaq. Chij.</para>
  <para style="b" />
  <para style="q">
    <verse number="11" style="v" />Nimxi'x toklenju' nab'l kyekywitzju' tb'anil ab'j;</para>
  <para style="q">¡jni'xpe' achb'ajil toj kywitz xjal layx pon ikyju'!</para>
  <para style="b" />
  <para style="q">
    <verse number="12" style="v" />Ayine' nab'l, junx qele' tuk'i'lju' k'atzil,</para>
  <para style="q">ayine' q'ol tb'anil nab'l.</para>
  <para style="q">
    <verse number="13" style="v" />Qama jaw qnima'n Qman Dyos, k'elel qik'o'n taq'wixil.</para>
  <para style="q">nnel wik'o'ne' nimjtib'il ex jamjoni'n,</para>
  <para style="q">e'tb'eyil taq'wix ex chajyolil.</para>
  <para style="q">
    <verse number="14" style="v" />Weye' xim ex wu'ne' njapuna',</para>
  <para style="q">ayinwe' k'atzil exju' ipumalj.</para>
  <para style="q">
    <verse number="15" style="v" />Wu'ne' nb'enta' kykawin nimaqkawil</para>
  <para style="q">ex wu'ne' nkyq'o'n oklenju' ajkawil. <verse number="16" style="v" />Wu'ne' nche' kawinju' nejenel kye nimaqtnam</para>
  <para style="q">exqe' ati kyoklen nkub' kyq'o'n kykaws xjal.</para>
  <para style="q">
    <verse number="17" style="v" />Atiwe' nk'u'j kyi'ju' nche k'u'jlanweye',</para>
  <para style="q">ex nchin knete' kyu'nju' nche' jyon wi'ye'.</para>
  <para style="q">
    <verse number="18" style="v" />Wuk'i'le' ta' q'inumal ex oklenj,</para>
  <para style="q">nimaq oklenj ex tkyaqilju' nche jawb'ent.</para>
  <para style="q">
    <verse number="19" style="v" />Tb'anilxi'x ju'we' inq'o'n kyetwitz q'anpwaq;</para>
  <para style="q">tb'anilxi'x ju'we' inq'o'n kyetwitz saqpwaq.</para>
  <para style="q">
    <verse number="20" style="v" />Tzinun ti'ju' nb'eye',</para>
  <para style="q">toj tb'eyil tnik'alilti'j.</para>
  <para style="q">
    <verse number="21" style="v" />Inxi' nq'o'ne' kyetzb'ilju' nche' k'u'jlanweye':</para>
  <para style="q">noju' toj kyja tu'n k'uwenj wu'ne'.</para>
  <para style="b" />
  <para style="q">
    <verse number="22" style="v" />Ayinwe' nb'ent tnejelxi'x tu'n Qman Dyos,</para>
  <para style="q">na'mxtoq ttzyet tb'inchet tkyaqil.</para>
  <para style="q">
    <verse number="23" style="v" />Nkub' tb'incha'ne' atxi'x t-xe tnejel,</para>
  <para style="q">nej nkub' tb'incha'ne' twitzju' tx'otx'.</para>
  <para style="q">
    <verse number="24" style="v" />nitz'je' na'mxtoq tb'inchanjtzju' ninnjab',</para>
  <para style="q">na'mxtoq tpoq'chaju' nin a' exju' t-xiklil a'.</para>
  <para style="q">
    <verse number="25" style="v" />Na'mxpetoq kywe'xi'xu' witz exqe' k'ul,</para>
  <para style="q">ojetoq chin b'entwe' tu'n Qman Dyos;</para>
  <para style="q">
    <verse number="26" style="v" />na'mxtoq tkub' tb'inchanju' tx'otx' exqe' kojb'il,</para>
  <para style="q">jni'ju' quq kytx'otx'al tkyaqil.</para>
  <para style="q">
    <verse number="27" style="v" />Atinqintoqwe' twitz Qman Dyos</para>
  <para style="q">tej tkub' tb'incha'nju' kya'j tib'aj ninnjab'.</para>
  <para style="q">
    <verse number="28" style="v" />Tej tb'antju' muj twitz kya'j</para>
  <para style="q">ex kub' tb'incha'xixu' t-xiklil a' toj ninnjab',</para>
  <para style="q">
    <verse number="29" style="v" />tej txi' tma'n teju' ninnjab'</para>
  <para style="q">tu'n lalun tz'ex ttziyile,</para>
  <para style="q">tej tkub' tq'o'nju' tq'uqlil tx'otx',</para>
  <para style="q">
    <verse number="30" style="v" />majxtoq atinqine' tuk'i'l.</para>
  <para style="q">Ayinqintoqe' ttzalajb'il kukxju',</para>
  <para style="q">atl junjun kmuj nchin xchane' twitz;</para>
  <para style="q">
    <verse number="31" style="v" />nxchane' tej tb'antu' twitz tx'otx',</para>
  <para style="q">¡intoq chin tzalaje' kyi'ju' wnaq!</para>
  <para style="b" />
  <para style="q">
    <verse number="32" style="v" />Atzu'n ja'lo, nk'yajul chin kyb'itze';</para>
  <para style="q">tzalajb'ilte' kyeye' qama che lpeye' wi'je'.</para>
  <para style="q">
    <verse number="33" style="v" />Kyb'inxju'ye' xnaq'tzb'il;</para>
  <para style="q">lalun kyik'u'ye' nab'l.</para>
  <para style="q">
    <verse number="34" style="v" />B'a'nta'te' xjal nchinx tb'i'ne',</para>
  <para style="q">ex nchin tjyo'ne' toju' njaye' atl junjun q'ij.</para>
  <para style="q">
    <verse number="35" style="v" />Qu'n alkyete' machin knete' tu'n, inknet tchwinqlal</para>
  <para style="q">tuk'ilju' t-xtalb'il Qman Dyos;</para>
  <para style="q">
    <verse number="36" style="v" />alkyetzunte' matz'el tpa'ntib' wi'je', qab'anx twitz;</para>
  <para style="q">¡alkyete machin neltik'u'ne', nlaqj ti'j tkamik! Chiju' nab'l.</para>
  <chapter number="9" style="c" />
  <para style="s1">Min muje nab'l tuk'i'lju' xnakyil</para>
  <para style="q">
    <verse number="1" style="v" />Jawtb'incha'n nab'l tja,</para>
  <para style="q">tb'anil b'inchb'enkye wuq tqan;</para>
  <para style="q">
    <verse number="2" style="v" />E'tzaj tb'yo'n talu'n teju' ninwan,</para>
  <para style="q">kub' tb'incha'n jun k'wab'j tb'anilxi'x,</para>
  <para style="q">ex b'aj tb'incha'n mes</para>
  <para style="q">
    <verse number="3" style="v" />eb'jax tchq'o'n tmajen ẍch'ilte</para>
  <para style="q">kywi' ja nimaq kywe' toj nintnam kjalu:</para>
  <para style="q">
    <verse number="4" style="v" />¡Qlanqe'ye' tza'lu ku'xun na'mx tok kynab'le'! Chechij</para>
  <para style="q">B'ajx q'o'n tpakb'al kyeju' mixb'a'n che ximan kjalu:</para>
  <para style="q">
    <verse number="5" style="v" />Qlanqe'ye' qoqe' wan wuk'i'le'</para>
  <para style="q">che k'wanqeye', makux nb'incha'nwe' jun qk'wa'.</para>
  <para style="q">
    <verse number="6" style="v" />Lalun che oktle' mixti' kynab'le', atitzunte anq'b'iltz;</para>
  <para style="q">che b'et-xe' ati kynab'le'. Chij.</para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" />Qama ttzak'uju'ya mixti' tnab'l ex b'inchal myab'a'n,</para>
  <para style="q">atlpe'ta kb'ajel wuli'na tu'n ex k'okyil tlab'a'n twitz.</para>
  <para style="b" />
  <para style="q">
    <verse number="8" style="v" />Qama txi' ttzak'u'nju'ya mixti' tnab'l, k'elel i'ku'na tu'n;</para>
  <para style="q">qatzun matxi' ttzak'unju'ya ati tnab'l, kk'u'jlanjtzela tu'n.</para>
  <para style="b" />
  <para style="q">
    <verse number="9" style="v" />Q'onxa xnaq'tzb'il teju' ati tnab'l, ktenb'elxi'xtl tnab'l;</para>
  <para style="q">q'onxa xnaq'tzb'il teju' b'a'n xjal, ktenb'elxi'xtl tojtzqib'l.</para>
  <para style="b" />
  <para style="q">
    <verse number="10" style="v" />Qa nqo niman te Qman Dyos atzuntzu' ntzyeta' tten qnab'l;</para>
  <para style="q">atite' qnab'l qa ojtzqi'n Dyos Xjan qu'n.</para>
  <para style="b" />
  <para style="q">
    <verse number="11" style="v" />Tu'nju' nab'l k'anq'ila'ya nim,</para>
  <para style="q">ex knajal txqan ab'q'iya.</para>
  <para style="b" />
  <para style="q">
    <verse number="12" style="v" />Qa ati tnab'la, texa k'ajb'ela';</para>
  <para style="q">qatzun matz'el tik'u'na, axa kb'el chjonte.</para>
  <para style="b" />
  <para style="q">
    <verse number="13" style="v" />Ikyte xnakyilju' kse'n jun qya jk'ulyol,</para>
  <para style="q">mixti'x b'a'n tu'n majx xtrak.</para>
  <para style="q">
    <verse number="14" style="v" />Nkub' qe tib'aj jun q'a'jtz ttzi tja,</para>
  <para style="q">twi' jun nin ja toj nintnam,</para>
  <para style="q">
    <verse number="15" style="v" />Ntxokon kyeju' nche b'et</para>
  <para style="q">b'a'n kyel toj kyb'e,</para>
  <para style="q">
    <verse number="16" style="v" />intma'n: ¡Qlanqe'ye' tzalu ku'xun na'm tok kynab'le! Chij</para>
  <para style="q">Nxitma'n tq'umli kye mib'a'n che ximan:</para>
  <para style="q">
    <verse number="17" style="v" />Majx k'ok'jte' a' naq qelaq';</para>
  <para style="q">exju' wab'j toj ewaj majx ati tchi'yal. Chij.</para>
  <para style="q">
    <verse number="18" style="v" />Wichaqa min b'i'n kyu'n qa toj tkawb'il kamik</para>
  <para style="q">ta'qe' nxi' kyq'o'n kywi' ti'ju ttxokb'il lu.</para>
  <chapter number="10" style="c" />
  <para style="s1">Tnejel q'unb'en tma Salomon</para>
  <para style="q">
    <verse number="1" style="v" />Aye' yol ja'lu q'umli tu'n Salomon:</para>
  <para style="b" />
  <para style="q">Tzalajb'ilte' kyeju' manb'aj ati kynab'lju' kyk'wal ex kymyal;</para>
  <para style="q">aye'tzu'n k'walb'aj xnakqe' nche yajti kyu'n.</para>
  <para style="b" />
  <para style="q">
    <verse number="2" style="v" />Myab'a'nte' q'inumal myab'a'n kanb'ab'ente,</para>
  <para style="q">atzu'n tnik'alilti'j nqo tklo'n te kamik.</para>
  <para style="b" />
  <para style="q">
    <verse number="3" style="v" />Lay taj Qman Dyos tu'n tnaju' b'a'n xjal tu'n we'yaj,</para>
  <para style="q">atzu'n b'inchal myab'a'n min ntjo'n Dyos tu'n tqetk'u'j.</para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" />In qoprowix tu'n ky'ejil;</para>
  <para style="q">atzu'n sak'il nten qq'inumal tu'n.</para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" />Ati kynab'lju' nkyb'u'yi'n twitz kyawal toj q'ijal;</para>
  <para style="q">aye'tzu'n naq nex kyq'ij inel kych'ixaw.</para>
  <para style="b" />
  <para style="q">
    <verse number="6" style="v" />Nim ky'i'wb'il tib'aju' b'a'n xjal,</para>
  <para style="q">atzu'n b'inchal taq'wix nkub' tewa'n q'oj kyu'nju' tyol.</para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" />Ati jun nab'ab'lteju' b'a'n xjal;</para>
  <para style="q">atzu'n b'inchal myab'a'n majx nik'tna'l.</para>
  <para style="b" />
  <para style="q">
    <verse number="8" style="v" />Aju' ati tnab'l b'a'n b'in kye chaq'b'il;</para>
  <para style="q">atzu'n xnak kb'el b'o'lj tu'nx tnab'l.</para>
  <para style="b" />
  <para style="q">
    <verse number="9" style="v" />Aju' b'a'n nanq'ina', min nxob';</para>
  <para style="q">atzunju' myab'a'n tel, myab'a'n kpomila' b'aj.</para>
  <para style="b" />
  <para style="q">
    <verse number="10" style="v" />Alkyete nxmutz'mun twitz, til ntchmo'n,</para>
  <para style="q">atzu'n npa'nyol jun q'ij kb'ajel.</para>
  <para style="b" />
  <para style="q">
    <verse number="11" style="v" />Te chwinqlal qekye' tyolju' xjal tnik'alti'j,</para>
  <para style="q">atzu'n b'inchal taq'wix nkub' tewa'n q'oj kyu'nju' tyol.</para>
  <para style="b" />
  <para style="q">
    <verse number="12" style="v" />Tu'nju' tx'a'lti'j k'u'jb'aj ntzaja' q'oj,</para>
  <para style="q">atzunju' tk'u'jlalil nkub' tnajsa'n tkyaqilju' chuksb'en.</para>
  <para style="b" />
  <para style="q">
    <verse number="13" style="v" />Nyolinju' ati tnab'l tuk'i'l nab'l;</para>
  <para style="q">atzu'n mixti' tnab'l, tzete' ntqani'n.</para>
  <para style="b" />
  <para style="q">
    <verse number="14" style="v" />Aye'kye' ati kynab'l min nkla'ji'n kyib',</para>
  <para style="q">aye'tzu'n mixti' kynab'l ntzaj kyi'n xitb'il.</para>
  <para style="b" />
  <para style="q">
    <verse number="15" style="v" />Kuwte' q'inun tu'nju' tq'inumal;</para>
  <para style="q">atzunju' prow nyajti tu'nxju' tprowil.</para>
  <para style="b" />
  <para style="q">
    <verse number="16" style="v" />A tkanb'ab'lju' b'a'n xjal aju' tchwinqlal;</para>
  <para style="q">atzu'n il tkanb'ab'lju' myab'a'n xjal.</para>
  <para style="b" />
  <para style="q">
    <verse number="17" style="v" />Alkyete' b'a'n b'in, ljo'nju' tb'eyil chwinqlal tu'n;</para>
  <para style="q">atzunju' min nokslan, kb'el b'o'lj.</para>
  <para style="b" />
  <para style="q">
    <verse number="18" style="v" />Aju' xjal naq k'u'jla'n tq'oj, chalyol,</para>
  <para style="q">atzunju' jk'ulyol, mixti'x tnab'l.</para>
  <para style="b" />
  <para style="q">
    <verse number="19" style="v" />Alkyete' nim nyolin, nky'ixb'sanju' tyol;</para>
  <para style="q">atzunju' nkub' nume' ja nojqelana' ati tnab'l.</para>
  <para style="b" />
  <para style="q">
    <verse number="20" style="v" />A tyolju' b'a'n xjal naku'j saqpwaq tb'anilxi'x;</para>
  <para style="q">atzu'n b'inchal myab'a'n mixti'xte' tnab'l.</para>
  <para style="b" />
  <para style="q">
    <verse number="21" style="v" />Inxi'x xnaq'tzanju' tnik'alti'j,</para>
  <para style="q">atzunju' xnak tu'nx tnab'l nkyima'.</para>
  <para style="b" />
  <para style="q">
    <verse number="22" style="v" />Tu'nju' tk'iwb'il Qman Dyos nqo' q'inumaxa'</para>
  <para style="q">minojqelan tu'n kub'yo'n qib' tu'n tkanb'et.</para>
  <para style="b" />
  <para style="q">
    <verse number="23" style="v" />Majx ntzalaju' xnak tu'n tb'inchan taq'wixil;</para>
  <para style="q">atzu'n ati tnab'l ntzalaj ti'ju' nab'l.</para>
  <para style="b" />
  <para style="q">
    <verse number="24" style="v" />Aju' nt-xob'le'n b'inchal myab'a'n axtzun nb'aju' ti'j,</para>
  <para style="q">atzunju' xjal tnik'alti'j nche japunju' tb'is tk'u'j.</para>
  <para style="b" />
  <para style="q">
    <verse number="25" style="v" />Kb'el naju' b'inchal myab'a'n ajttzaj kyq'iq' jb'al,</para>
  <para style="q">atzunju' xjal tnik'alti'j kyjelten wa'lx.</para>
  <para style="b" />
  <para style="q">
    <verse number="26" style="v" />Iky noka' ky'aj teju' chq'olte,</para>
  <para style="q">kse'n sib' ajtokx toj qwitz, mo kse'n b'inayr tx'am t-xe qwitzte.</para>
  <para style="b" />
  <para style="q">
    <verse number="27" style="v" />Qa nqo nima'n Qman Dyos ati qchwinqlal nim,</para>
  <para style="q">aye'tzunju' b'inchal myab'a'n ntaqk'uju' kychwinqlal.</para>
  <para style="b" />
  <para style="q">
    <verse number="28" style="v" />Tzalajb'ilte' nkyayo'nju' tnik'alkyi'j;</para>
  <para style="q">aye'tzunju' b'inchal myab'a'n mixti'xte' kyoyb'il.</para>
  <para style="b" />
  <para style="q">
    <verse number="29" style="v" />Xq'uqi'n qekye' b'a'n xjal tu'n Qman Dyos,</para>
  <para style="q">aye'tzunju' b'inchal myab'a'n nche kub' tb'ajsa'n.</para>
  <para style="b" />
  <para style="q">
    <verse number="30" style="v" />Jaloja kub'ku' tnik'alti'j,</para>
  <para style="q">atzunju' b'inchan myab'a'n lay ten twitz tx'otx'.</para>
  <para style="b" />
  <para style="q">
    <verse number="31" style="v" />Nab'lte' netz toj ttziju' xjal tnik'alti'j,</para>
  <para style="q">atzunju' b'inchal myab'a'n lay txi' b'i'n tyol.</para>
  <para style="b" />
  <para style="q">
    <verse number="32" style="v" />Tb'anil tyolju' xjal tnik'alti'j;</para>
  <para style="q">Atzu'nju' b'inchal myab'a'n naqx xlab'yol netz toj ttzi.</para>
  <chapter number="11" style="c" />
  <para style="q">
    <verse number="1" style="v" />Inel tik'u'n Qman Dyos malb'il min tz'aqli</para>
  <para style="q">atzunju' malb'il tz'aqli b'a'n nela' toj twitz.</para>
  <para style="b" />
  <para style="q">
    <verse number="2" style="v" />Inel qch'ixaw tu'nju' nimjtib'il;</para>
  <para style="q">aye'tzu'n min nkynima'n kyib' ati kynab'l.</para>
  <para style="b" />
  <para style="q">
    <verse number="3" style="v" />Ẍaqlu'nqekye' xjal tz'aqliqe' tu'n kytzinunal;</para>
  <para style="q">aye'tzunkye' chalyol che b'o'ljel tu'nxju' kysb'ub'l.</para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" />Mixti'xte' q'inumal tajb'en ajtoka toj xjel,</para>
  <para style="q">atzu'n tnik'alilti'j kkletela tu'n te kamik.</para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" />Tzinjsa'nti'j tchwinlal b'a'n xjal tu'n tnik'alilti'j,</para>
  <para style="q">atzu'n b'inchal myab'a'n kb'eltz'aq tojxju' tb'inchb'en.</para>
  <para style="b" />
  <para style="q">
    <verse number="6" style="v" />Inche tzaqpetju' b'a'n xjal tu'n tnik'alilti'j,</para>
  <para style="q">atzunju' jamjoni'n kb'el jtz'o'nkye nche' jawmiltz'uj.</para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" />Ajtkyimju' b'inchal myab'a'n,</para>
  <para style="q">majx nkunaju' q'ub'ab'l tk'u'j ex jatoka' twitz.</para>
  <para style="b" />
  <para style="q">
    <verse number="8" style="v" />Intklo'n Qman Dyos tnik'alti'j toju' yajb'il,</para>
  <para style="q">ex nkyej tq'o'nju' b'inchal myab'a'n te t-xel.</para>
  <para style="b" />
  <para style="q">
    <verse number="9" style="v" />Inche b'o'lj wnaq tu'n tyolju' b'inchal myab'a'n,</para>
  <para style="q">tu'ntzu'n tk'atzilju' tnik'alti'j nche' kleta'.</para>
  <para style="b" />
  <para style="q">
    <verse number="10" style="v" />Tzalajb'ilte' toju' nintnam ajkyjaw b'entju' xjal tnik'alkyi'j;</para>
  <para style="q">ex nxi'x che tzalaj ajkykyimu' b'inchal myab'a'n.</para>
  <para style="b" />
  <para style="q">
    <verse number="11" style="v" />Tu'nju' ate' xjal tnik'alkyi'j nch'iya' jun nintnam;</para>
  <para style="q">atzu'n kyu'n b'inchal myab'a'n noq nche xitun.</para>
  <para style="b" />
  <para style="q">
    <verse number="12" style="v" />Aju' min nximan nyolin ti'j tamiw;</para>
  <para style="q">atzunte' ati tnab'l nkub' tjpu'n ttzi.</para>
  <para style="b" />
  <para style="q">
    <verse number="13" style="v" />Aju' jk'ulyol tkyaqil nxi' t-ẍtaq'i'n;</para>
  <para style="q">atzu'nte' xjal ati tnab'l minti' nb'aj tyoli'n.</para>
  <para style="b" />
  <para style="q">
    <verse number="14" style="v" />In b'o'ljte' tnam qa myab'a'nju' kawil;</para>
  <para style="q">qatzun b'a'npun q'ol nab'l, tkyaqil nel b'a'n.</para>
  <para style="b" />
  <para style="q">
    <verse number="15" style="v" />Alkyete mataq'tib' yolil tu'n tetz tk'as jun najchaq xjal, kb'o'ljel;</para>
  <para style="q">altzunkyete min ntq'o'ntib' yolil ti'j juntl, mixti'te' tb'is.</para>
  <para style="b" />
  <para style="q">
    <verse number="16" style="v" />Majx nima'nte' qya ati tnab'l,</para>
  <para style="q">atzunju' ichan sak' nten tq'inumal.</para>
  <para style="b" />
  <para style="q">
    <verse number="17" style="v" />Alkyete' ntzaj laqj tk'u'j ti'j juntl tex najb'ena';</para>
  <para style="q">alkyetzunte txkup xjal ax nchjonte.</para>
  <para style="b" />
  <para style="q">
    <verse number="18" style="v" />Mixti'x noka'te' twi' tk'u'ju' b'inchal myab'a'n;</para>
  <para style="q">atzu'n tkanb'ab'lju' b'a'n xjal npax twitz.</para>
  <para style="b" />
  <para style="q">
    <verse number="19" style="v" />B'a'n qoxe'la' qama txi' qb'incha'n tnik'alilti'j,</para>
  <para style="q">qatzun maqo'x lpe ti'ju' myab'a'n, xi' qxi' tb'eyil kamik.</para>
  <para style="b" />
  <para style="q">
    <verse number="20" style="v" />Inche el ik'u'nkye' taq'wix kynab'l tu'n Qman Dyos,</para>
  <para style="q">aye'tzunju' b'a'n kychwinlal ntzalaj kyi'j.</para>
  <para style="b" />
  <para style="q">
    <verse number="21" style="v" />Ilti'j kb'el kychjo'nkye' b'inchal myab'a'n,</para>
  <para style="q">aye'tzunju' tnik'alkyi'j che kletel.</para>
  <para style="b" />
  <para style="q">
    <verse number="22" style="v" />Aju' qya xa'wanku'xi'x ka'yin ex mixti' tnab'l,</para>
  <para style="q">ikxi'xu' kse'n jun xmilq'ob'j q'anpwaq ti'j ttxa'n b'och.</para>
  <para style="b" />
  <para style="q">
    <verse number="23" style="v" />Tkyaqil tb'iskyk'u'ju' tnik'alkyi'j b'a'n nela';</para>
  <para style="q">Atzu'n tb'iskyk'u'ju' b'inchal myab'a'n noq tokel tx'ujilj.</para>
  <para style="b" />
  <para style="q">
    <verse number="24" style="v" />Aju' xjal noyin nim tu'me'l t-xel intk'mo'n;</para>
  <para style="q">aye'tzun ẍk'u'ẍqe' nche kub' b'ajxi'tl.</para>
  <para style="b" />
  <para style="q">
    <verse number="25" style="v" />Alkyete b'a'n tz'oyin, njaw b'ent;</para>
  <para style="q">alkyete' noyin, ikxte ntk'mo'n.</para>
  <para style="b" />
  <para style="q">
    <verse number="26" style="v" />Alkyete nkub' t-xk'a'yi'n twitz awal naqx aj tjawx ti'j, intzaj txko'n toj twi';</para>
  <para style="q">atzunju' minti' nkub' t-xk'a'yi'n ntzaj qani'n b'a'n tib'aj.</para>
  <para style="b" />
  <para style="q">
    <verse number="27" style="v" />Alkyete' nb'et b'a'n, ex nb'inchanjtz xtalb'il te;</para>
  <para style="q">alkyetzunte' myab'a'n tel, myab'a'n kxe'la'.</para>
  <para style="b" />
  <para style="q">
    <verse number="28" style="v" />Ate' q'uqli tk'u'j ti'j tq'inumal kb'el pulj kse'n tzqij t-xaq tze,</para>
  <para style="q">aye'tzu'n tnik'alkyi'j che tzajel puqli kse'n cha'x t-xaq tze.</para>
  <para style="b" />
  <para style="q">
    <verse number="29" style="v" />Alkyete' min nchex tka'yi'n toj tja, kb'el b'aj;</para>
  <para style="q">alkyete naq takli k'okyil tmajen teju' ati tnab'l.</para>
  <para style="b" />
  <para style="q">
    <verse number="30" style="v" />A tkanb'ab'lju' tnik'alti'j aju' tchwinqlal,</para>
  <para style="q">atzunju' kykanb'ab'lju' ti tnab'l aju' nk'u'jlanjtz kyu'n xjal.</para>
  <para style="b" />
  <para style="q">
    <verse number="31" style="v" />Qa ntk'mo'nju' tnik'alti'j chojb'il tzalu twitz tx'otx',</para>
  <para style="q">¡mitzunloyate' b'inchal myab'a'n exju' aj il!</para>
  <chapter number="12" style="c" />
  <para style="q">
    <verse number="1" style="v" />Alkyete' nb'in tzak'b'il nok tnab'l;</para>
  <para style="q">alkyetzunte' mixb'a'nb'in, mixti'x b'a'n tu'n.</para>
  <para style="b" />
  <para style="q">
    <verse number="2" style="v" />Aju' b'a'n xjal ntk'mo'n t-xtalb'il Qman Dyos,</para>
  <para style="q">atzunju' pi's nkub' tz'e'ysa'n twitz.</para>
  <para style="b" />
  <para style="q">
    <verse number="3" style="v" />Lay b'ent tokqe qk'u'j ti'ju' taq'wixil</para>
  <para style="q">Aye'tzunkye' tnik'alkyi'j majx xini kylok'.</para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" />Aju' qya qa ti tnab'l tzajlajb'il teju' tchmil,</para>
  <para style="q">atzunju' myab'a'n xu'jilb'aj majx nkub' yajt tchmil.</para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" />Okxtzu' nche ximana'kye' xjal tnik'alkyi'j ti'ju' tnik'alilti'j;</para>
  <para style="q">aye'tzu'n b'inchal myab'a'n o'kxte' sb'ub'll.</para>
  <para style="b" />
  <para style="q">
    <verse number="6" style="v" />T-xpatxab' kamikte' kyyolju' b'inchal myab'a'n;</para>
  <para style="q">atzu'n kyyolju' xjal tnik'alkyi'j, kolb'il.</para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" />Nche kub' tz'aqju' b'inchal myab'a'n nche kub' tz'aq atzun kyajb'ilju',</para>
  <para style="q">Aye'tzu'n toj kyja tnik'alkyi'j che tenb'il kukxju'.</para>
  <para style="b" />
  <para style="q">
    <verse number="8" style="v" />Injaw nima'n xjal tu'nju' tnab'l,</para>
  <para style="q">atzunju' xnak nel ik'o'n.</para>
  <para style="b" />
  <para style="q">
    <verse number="9" style="v" />B'a'nte' ik'u'nqo' naqa te' qmajen,</para>
  <para style="q">kyetwitz nima'nqo' extzun mixti' qwa.</para>
  <para style="b" />
  <para style="q">
    <verse number="10" style="v" />Aju' b'a'n xjal kye kyilwiju' talu'n,</para>
  <para style="q">atzunju' b'inchal myab'a'n minti' nximan kyi'j.</para>
  <para style="b" />
  <para style="q">
    <verse number="11" style="v" />Alkyete nkub' taq'una'n ttx'otx' nimte' twa njaw;</para>
  <para style="q">atzunju' min ximan mixti'x nb'ajx tk'u'j.</para>
  <para style="b" />
  <para style="q">
    <verse number="12" style="v" />Axju' kyjamjoni'n b'inchal myab'a'n nok te jun xpatxab';</para>
  <para style="q">aye'tzu'n tnik'alkyi'j majx xini kylok'.</para>
  <para style="b" />
  <para style="q">
    <verse number="13" style="v" />Aju' b'inchal myab'a'n ax nb'aj tb'alq'i'n tib' toju' tchajyolil,</para>
  <para style="q">atzunju' xjal tnik'alti'j nklet toj ju' yajb'ilte.</para>
  <para style="b" />
  <para style="q">
    <verse number="14" style="v" />Teyile junjun ntk'mo'n twitzlalilju' tyol</para>
  <para style="q">ex ntk'mo'n chojb'ilte taq'unb'en.</para>
  <para style="b" />
  <para style="q">
    <verse number="15" style="v" />Toj tnab'lju' xnak qa tkyaqil ntb'incha'n b'a'nile,</para>
  <para style="q">atzunju' xjal ati tnab'l b'a'n b'in nab'l.</para>
  <para style="b" />
  <para style="q">
    <verse number="16" style="v" />Lwiyxi'x ntyek'u'n xnak ttx'u'jil;</para>
  <para style="q">atzunju' ati tnab'l minti' nxi' toj twinqil qama tz'ok ik'le'n.</para>
  <para style="b" />
  <para style="q">
    <verse number="17" style="v" />Aju' ax yolin, nttziya'n ax;</para>
  <para style="q">atzunju' chalyol noq njk'unyol.</para>
  <para style="b" />
  <para style="q">
    <verse number="18" style="v" />Ate' xjal nky'ixb'san kyol,</para>
  <para style="q">atzun kyolju' ati kynab'l tzalajb'ilx.</para>
  <para style="b" />
  <para style="q">
    <verse number="19" style="v" />Aju' ax yolin k'anq'il nimtoj,</para>
  <para style="q">atzu'nju' chalyol naq nul anj.</para>
  <para style="b" />
  <para style="q">
    <verse number="20" style="v" />Ati chajyolil toj kyximju' b'inchal myab'a'n;</para>
  <para style="q">atzu'n knab'lju' xjal nche' ximan nak'b'il ex tzalajb'il.</para>
  <para style="b" />
  <para style="q">
    <verse number="21" style="v" />Lay k'ulb'ante' xjal tnik'alti'j</para>
  <para style="q">atzunju' b'inchal myab'a'n tzul tilj taq'wixil ti'j.</para>
  <para style="b" />
  <para style="q">
    <verse number="22" style="v" />Ik'u'nqe'kye' chalyol tu'n Qman Dyos;</para>
  <para style="q">aye'tzunju' ax nche' yolin ntzalaj kyi'j.</para>
  <para style="b" />
  <para style="q">
    <verse number="23" style="v" />Aju' xjal b'a'n ximan mintla'ji'n tojtzqib'l;</para>
  <para style="q">atzu'n mixti' tnab'l ntnima'ntib' ti'ju' t-xnakyil.</para>
  <para style="b" />
  <para style="q">
    <verse number="24" style="v" />Alkyete twi' aq'unal kykawil</para>
  <para style="q">atzunju' ky'aj naq te majen ktenb'ila'.</para>
  <para style="b" />
  <para style="q">
    <verse number="25" style="v" />Nkub' yajti xjal tu'nju' b'is;</para>
  <para style="q">ajtzun so'j yol ntq'uqb'a'n tk'u'j.</para>
  <para style="q">
    <verse number="26" style="v" />Ate' xjal tnik'alti'j nche'x t-ẍaqlu'n twnaqil;</para>
  <para style="q">aye'tzunkye' b'inchal myab'a'n nche' tzpet.</para>
  <para style="b" />
  <para style="q">
    <verse number="27" style="v" />Aju' ub'al ky'aj minti' nokyal tchi';</para>
  <para style="q">atzunju' noktilil tu'n kjawil q'inumax.</para>
  <para style="b" />
  <para style="q">
    <verse number="28" style="v" />Chwinqlalte' tb'eyil tnik'alilti'j;</para>
  <para style="q">atzu'n tb'eyil myab'a'n toj kamik npona'.</para>
  <chapter number="13" style="c" />
  <para style="q">
    <verse number="1" style="v" />Aju' k'wal ati tnab'l inxi' tb'i'nju' tzak'b'il tu'n manb'aj;</para>
  <para style="q">atzunju' mixti' tnab'l naqnik' tb'i'nju' tzak'b'il.</para>
  <para style="b" />
  <para style="q">
    <verse number="2" style="v" />Teyile junjun ntk'mo'nju' twitzlalil tyol,</para>
  <para style="q">aye'tzunju' nche' jawmiltz'uj ati tu'n kychjonte kyil.</para>
  <para style="b" />
  <para style="q">
    <verse number="3" style="v" />Alkyete' nkub' tjk'u'n taq', b'a'n kyxe'la';</para>
  <para style="q">atzunju' mya'l yolin nb'o'lj tu'nx tnab'l.</para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" />In ka'ylaju' ky'ej ex mixti'te nokyal tu'n;</para>
  <para style="q">atzunju' naq'unan, nchmet ti'xti' te.</para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" />Myab'a'nte' chajyolil tojtwitzju' xjal tnik'alti'j;</para>
  <para style="q">atzunju' b'inchal myab'a'n ch'ixb'ilxte'.</para>
  <para style="b" />
  <para style="q">
    <verse number="6" style="v" />Aju' tzinun xq'uqilte' xjal tnik'alti'j;</para>
  <para style="q">atzunju' aj il nkub'o'lj toju' il.</para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" />Ate' xjal kuxi'xtej q'inunqe' extzun mixti'x ati kye;</para>
  <para style="q">ate'tzuntl nakutej mixti'xte' tixti'kye, wichaqa q'inunqe'.</para>
  <para style="b" />
  <para style="q">
    <verse number="8" style="v" />Aju' q'inun tu'nju' tq'inumal nelje ti'j;</para>
  <para style="q">atzunte' prow mixti'xte nelje ti'j.</para>
  <para style="b" />
  <para style="q">
    <verse number="9" style="v" />Nche qoptz'aju' tnik'alkyi'j kse'n spik'un ntilky'aj;</para>
  <para style="q">Aye'tzu'n b'inchal myab'a'n ikyqe' kse'n kantil yupjni.</para>
  <para style="b" />
  <para style="q">
    <verse number="10" style="v" />Noqx q'ojte' ntzaj tu'nju' nimjtib'il;</para>
  <para style="q">atzunju' nab'l atzu' ta' kyuk'i'lju' me's.</para>
  <para style="b" />
  <para style="q">
    <verse number="11" style="v" />Aju' pwaq nkanb'et tuk'i'l sb'ub'l lwiy nkub'naj;</para>
  <para style="q">atzunju' chab'a nkanb'et ika' tchmet.</para>
  <para style="b" />
  <para style="q">
    <verse number="12" style="v" />B'isb'ajilxte' q'uqb'ab'l k'u'j minti' njapun,</para>
  <para style="q">qatzun njapunju' qajb'il, ikyxixte' kse'n jun wi' tze txijli.</para>
  <para style="b" />
  <para style="q">
    <verse number="13" style="v" />Alkyete' minti' ntb'i'n tzak'b'il tzul toj tk'u'j;</para>
  <para style="q">alkyetzunte matxi tb'i'n ktk'ma' tu'me'l t-xel.</para>
  <para style="b" />
  <para style="q">
    <verse number="14" style="v" />Nim tajb'en tyoju' ati tnab'l toj chwinqlal</para>
  <para style="q">tu'n qklet toj tq'ob' kamik.</para>
  <para style="b" />
  <para style="q">
    <verse number="15" style="v" />Aju' b'a'n tnab'l b'a'n tilwi,</para>
  <para style="q">aye'tzu'n xmletz' nche kub'o'lj.</para>
  <para style="b" />
  <para style="q">
    <verse number="16" style="v" />Alkyete ati tnab'l nximan b'a'nxi'x,</para>
  <para style="q">atzunju' xjal mixti' tnab'l, ntzalaj toju' t-xnakyil.</para>
  <para style="b" />
  <para style="q">
    <verse number="17" style="v" />Aju' myab'a'n sanjelal nqo' b'o'lj tu'n,</para>
  <para style="q">atzunju' b'a'n sanjelal nqo klet tu'n.</para>
  <para style="b" />
  <para style="q">
    <verse number="18" style="v" />Alkyete minti' xtb'i nab'l kb'el prowix ex k'elel tch'ixaw;</para>
  <para style="q">atzunju' ntq'a' tzak'u'tib' nim oklenj ktk'ma'.</para>
  <para style="b" />
  <para style="q">
    <verse number="19" style="v" />Tzalajb'ilte' ajtjapunju' tb'isqk'u'j.</para>
  <para style="q">aye'tzu'n xnak layx kyej kytzaqpi'n myab'a'n.</para>
  <para style="b" />
  <para style="q">
    <verse number="20" style="v" />B'eta kyuk'i'lju' ati kynab'l, k'okyeltzun tnab'ltza;</para>
  <para style="q">qatzun matmujb'a tib'a kyuk'i'lju' xnak kb'el yajtiya.</para>
  <para style="b" />
  <para style="q">
    <verse number="21" style="v" />Aye'ju' aj il majx nche' joyli tu'nju' myab'a'n;</para>
  <para style="q">aye'tzu'n tnik'alkyi'j che tzajel k'i'wlana toju' b'a'n.</para>
  <para style="b" />
  <para style="q">
    <verse number="22" style="v" />A tq'inumalju' b'a'n xjal npon kanun kye tchman;</para>
  <para style="q">atzunte' aj il aju' tq'inumal nkyej toj kyq'ob'ju' tnik'alkyi'j.</para>
  <para style="b" />
  <para style="q">
    <verse number="23" style="v" />Nim twaju' prow nchmet toju' ttx'otx',</para>
  <para style="q">atzu'n ja mixti' tnik'alilti'j nim nkub' yajti.</para>
  <para style="b" />
  <para style="q">
    <verse number="24" style="v" />Qa nlaqja tiju' tk'wala, tzak'unxa;</para>
  <para style="q">alkyete' naq nka'yin ti'j, min ntk'u'jlan.</para>
  <para style="b" />
  <para style="q">
    <verse number="25" style="v" />Aju' xjal tnik'alti'j nwan b'a'nxi'x,</para>
  <para style="q">atzunju' b'inchal myab'a'n mixti'x nnoj.</para>
  <chapter number="14" style="c" />
  <para style="q">
    <verse number="1" style="v" />Aju' qya ati tnab'l nonin tuja;</para>
  <para style="q">atzunju' qya mixti' tnab'l noq nxitun.</para>
  <para style="b" />
  <para style="q">
    <verse number="2" style="v" />Alkyete' nb'et toj tnik'alti'j nniman Dyos;</para>
  <para style="q">atzunju' myab'a'n nb'eta' nel tik'u'n Dyos.</para>
  <para style="b" />
  <para style="q">
    <verse number="3" style="v" />Xnakte' xjal nyolin tuk'i'l nimjtib'il;</para>
  <para style="q">atzunju' xjal ati tnab'l nyolin yol te kolb'il.</para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" />Qa mixti'qe' alu'mj onilte xjal, mixti'xte' wab'j nb'uyit;</para>
  <para style="q">kyu'nju' kyonb'il alu'mj nchmet awal.</para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" />Aju' b'a'n tziyal minti' nchan yol;</para>
  <para style="q">atzunju' jk'ulyol noqx chajyolil ntma'n.</para>
  <para style="b" />
  <para style="q">
    <verse number="6" style="v" />Njyon pi's ti'ju' nab'l ex min nkanb'et tu'n;</para>
  <para style="q">Atzu'n xjal k'atz lwiy nkanb'et tu'n.</para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" />Pa'mil tib'a ti'ju' xtrak,</para>
  <para style="q">qu'n mixti'te' ojtzqib'l tuk'i'l.</para>
  <para style="b" />
  <para style="q">
    <verse number="8" style="v" />Tu'n nab'l nkaneya' toj twitzju' ati tnab'l se'n tz'anq'in,</para>
  <para style="q">atzu'n xtrak nkub' sb'u'n tu'nxju' t-xnakyil.</para>
  <para style="b" />
  <para style="q">
    <verse number="9" style="v" />Naq nche tze'n xnak ti'ju' kyil,</para>
  <para style="q">aye'tzu'n xjal tnik'alkyi'j b'a'n che b'in.</para>
  <para style="b" />
  <para style="q">
    <verse number="10" style="v" />teyele junjun k'u'nju' tb'is exju' ttzalajb'il, ex tkyaqilxju' nik'a'.</para>
  <para style="b" />
  <para style="q">
    <verse number="11" style="v" />Kb'el xitu'n kyja b'inchal myab'a'n;</para>
  <para style="q">atzu'n kyja tnik'alkyi'j kchmetel.</para>
  <para style="b" />
  <para style="q">
    <verse number="12" style="v" />Ate' b'e nakuj tzinun kyi'j,</para>
  <para style="q">atzun b'ajsb'il, tb'eyil kamik.</para>
  <para style="b" />
  <para style="q">
    <verse number="13" style="v" />Noqpena' qa nqotze'n nch'yon qanmi,</para>
  <para style="q">tb'ajlenxitzun tzalajb'il oq'e'ntlte' nb'aj.</para>
  <para style="b" />
  <para style="q">
    <verse number="14" style="v" />Taq'wixju' ktkotzi' b'inchal myab'a'n;</para>
  <para style="q">atzu'n b'a'nxjal ktk'ma' jun tu'me'l t-xel b'a'n.</para>
  <para style="b" />
  <para style="q">
    <verse number="15" style="v" />Nxitoksla'n xjal mixti' tnab'l tkyaqilju' nxiq'ma'n te;</para>
  <para style="q">atzu'n xjal ati tnab'l ntka'yi'n b'a'nxi'x ja tu'me'l nb'eta'.</para>
  <para style="b" />
  <para style="q">
    <verse number="16" style="v" />Aju' ati tnab'l nxob' teju' myab'a'n ex nel tpa'ntib' ti'j,</para>
  <para style="q">atzunju' mixti' tnab'l mixti'x toklen teju' ati twitz.</para>
  <para style="b" />
  <para style="q">
    <verse number="17" style="v" />aju' xjal mixti' tnab'l minti' inximan ajt-xi' b'inchal jun ti'xti';</para>
  <para style="q">atzunju' ati tnab'l nb'aj t-xima'n tnejelxi'x.</para>
  <para style="b" />
  <para style="q">
    <verse number="18" style="v" />A kyetzb'il mixti' kynab'lju' kyxnakyil;</para>
  <para style="q">aye'tzu'n k'atzkywi' nten kyojtzqib'l.</para>
  <para style="b" />
  <para style="q">
    <verse number="19" style="v" />Che kb'el tzipeju' b'inchal myab'a'n kytwitzju' b'a'n xjal;</para>
  <para style="q">aye'tzu'n txkupqe' kche kub'sal ttzi kyja tnik'alkyi'j.</para>
  <para style="b" />
  <para style="q">
    <verse number="20" style="v" />Jun prow, aye'ku' amiw nche el ik'unte;</para>
  <para style="q">atzunte q'inun nimte' tuk'i'l.</para>
  <para style="b" />
  <para style="q">
    <verse number="21" style="v" />Alkyete' nel ik'unte tuk'i'l nb'inchan il,</para>
  <para style="q">tzalajb'il teju' xjal ntzaj q'aq'an tk'u'j ti'j prow.</para>
  <para style="b" />
  <para style="q">
    <verse number="22" style="v" />Aye'ju' jyol il nche' tzpet ti'ju' kb'e;</para>
  <para style="q">aye'tzun b'inchal b'a'n kyk'ma' tk'u'jlalil ex nak'b'il.</para>
  <para style="b" />
  <para style="q">
    <verse number="23" style="v" />Tkyaqilju' noktilil tu'n ati tkanb'ab'l;</para>
  <para style="q">atzunju' la'j noqx nkub' prowix.</para>
  <para style="b" />
  <para style="q">
    <verse number="24" style="v" />Kq'inumaxela tu'n nab'l;</para>
  <para style="q">atzu'n xnakyil nqo'x tiq'i'n toj xnakyil.</para>
  <para style="b" />
  <para style="q">
    <verse number="25" style="v" />Aju' b'a'n tziyal che kletil kychwinqlal xjal tu'n;</para>
  <para style="q">atzun chalyol tziyal in tjyo'n kamik.</para>
  <para style="b" />
  <para style="q">
    <verse number="26" style="v" />Aye' nche niman te Qman Dyos nqexi'x kyk'u'j ti'j</para>
  <para style="q">ex a Qman Dyos klol kye ex q'olte kyipumalju' kyk'wal.</para>
  <para style="b" />
  <para style="q">
    <verse number="27" style="v" />Chwinqlalte' ninb'ilte Qman Dyos a'</para>
  <para style="q">in qo tzoqpaj tu'n kyoj t-sb'ub'l kamik.</para>
  <para style="b" />
  <para style="q">
    <verse number="28" style="v" />Aju' kawb'il kyib'aj txqan xjal ninb'ilte' te nimaqkawil;</para>
  <para style="q">atzunju' kawb'il kyib'aj jte' xjal xitb'il te' te.</para>
  <para style="b" />
  <para style="q">
    <verse number="29" style="v" />Aju' ati tnab'l ati tpasens;</para>
  <para style="q">atzunju' mixti' tnab'l lwiyxi'x injaw tx'u'jin.</para>
  <para style="b" />
  <para style="q">
    <verse number="30" style="v" />Qa che'w qwi' jun chwinqlal te qxmilal,</para>
  <para style="q">atzunju' tx'a'lti'j k'ub'aj majx nb'ajtwan qb'aqil.</para>
  <para style="b" />
  <para style="q">
    <verse number="31" style="v" />Alkyete' inkub' tyaju'n prow in nok tq'o'n t-tx'u'jil Dyos,</para>
  <para style="q">alkyetzunte' ink'u'jlante, in niman te Dyos.</para>
  <para style="b" />
  <para style="q">
    <verse number="32" style="v" />Axju' tb'inchb'enju' b'inchan myab'a'n nkub' xitunte;</para>
  <para style="q">atzunju' tnik'alti'j inklet tu'nxju' tnik'alilti'j.</para>
  <para style="b" />
  <para style="q">
    <verse number="33" style="v" />Atzu' ta' nab'l toj kynab'lju' nche ximan,</para>
  <para style="q">atzu'n kyxolju' mixti' kynab'l, mixti'x ojtzqi'n.</para>
  <para style="b" />
  <para style="q">
    <verse number="34" style="v" />Aju' tnik'alilti'j a ninb'ilju' te nintnam;</para>
  <para style="q">atzunju' il a tch'ixawju'.</para>
  <para style="b" />
  <para style="q">
    <verse number="35" style="v" />Aju' majen ati tnab'l in tkanb'a'n t-xtalb'il nimaqkawil,</para>
  <para style="q">atzunju' mixti' tnab'l intzaj ttx'u'jil nimaqkawil tu'n.</para>
  <chapter number="15" style="c" />
  <para style="q">
    <verse number="1" style="v" />Aju' tzaq'web'l tuk'i'l me'sb'il ntchewsa'n ttx'u'jil xjal;</para>
  <para style="q">atzun tzaq'web'l mya' ttxolilti'j majx ntzaj q'oj tu'n.</para>
  <para style="b" />
  <para style="q">
    <verse number="2" style="v" />Inche q'on nab'lju' xjal ati kynab'l;</para>
  <para style="q">aye'tzu'n xnak noqx xlab'yol netz toj kytzi.</para>
  <para style="b" />
  <para style="q">
    <verse number="3" style="v" />Atite Qman Dyos jaxjaku'</para>
  <para style="q">in ka'yin kyi'ju' tnik'alkyi'j ex kyi'ju' aj il.</para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" />Aju' yol tk'i' tk'u'jlalil nakuj jun tze te chwinqlal;</para>
  <para style="q">aye'tzun xlab'yol nk'ixb'san qanmi tu'n.</para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" />Aju' xnak min kub' tb'i'n ttzak'b'il tman;</para>
  <para style="q">atzunte' b'a'n b'i'n, ntyek'u'n qa ati tnab'l.</para>
  <para style="b" />
  <para style="q">
    <verse number="6" style="v" />Ati q'inumal toj tjaju' xjal tnik'alti'j,</para>
  <para style="q">atzu'n b'inchal myab'a'n min nku'x tnik'b'e'n tkanb'ab'l.</para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" />Aye'ju' ati kynab'l nche q'on nab'l;</para>
  <para style="q">aye'tzunju' xnak mikxa'qeju'.</para>
  <para style="b" />
  <para style="q">
    <verse number="8" style="v" />Min ntk'mo'nte Qman Dyos kyoyaju' b'inchal myab'a'n,</para>
  <para style="q">atzun kyna'j Dyos tnik'alkyi'j intzalaj ti'j.</para>
  <para style="b" />
  <para style="q">
    <verse number="9" style="v" />Inel tik'u'n Qman Dyos kychwinqlalju' b'inchal myab'a'n,</para>
  <para style="q">aye'tzu'n tnik'alkyi'j nche tk'u'jla'n.</para>
  <para style="b" />
  <para style="q">
    <verse number="10" style="v" />Alkyete makyej ttzaqpi'n tb'eyil b'a'n, kytzak'unjtzel kuw;</para>
  <para style="q">alkyetzunte' nel ik'unte tzak'b'il, kkyimel.</para>
  <para style="b" />
  <para style="q">
    <verse number="11" style="v" />Twitz Qman Dyos ta' kamik exju' muqb'il,</para>
  <para style="q">¡yajwittzunlo ju' t-xim xjal!</para>
  <para style="b" />
  <para style="q">
    <verse number="12" style="v" />Aju' mixti' tnab'l mya' b'a'n toj twitz qama txi' tzak'u'n,</para>
  <para style="q">ex minti' ntuk'i'la'n tib' kyuk'i'lu ati kynab'l.</para>
  <para style="b" />
  <para style="q">
    <verse number="13" style="v" />aju' xjal qa ntzalaj ntzalaju' twitz;</para>
  <para style="q">exqa ati tb'is ex in b'isun twitz.</para>
  <para style="b" />
  <para style="q">
    <verse number="14" style="v" />Njyon tojtzqib'lju' xjal k'atztwi'.</para>
  <para style="q">aye'tzu'n mixti' kynab'l nqe kyk'u'j toju' xnakyil.</para>
  <para style="b" />
  <para style="q">
    <verse number="15" style="v" />Aju' myab'a'n tten kukx nb'isun;</para>
  <para style="q">atzunte' xjal ntzalaj tkyaqil q'ij tzalajb'ilte'.</para>
  <para style="b" />
  <para style="q">
    <verse number="16" style="v" />B'a'nte' prowqo' qa nqnima'n Dyos,</para>
  <para style="q">kyetwitz q'inun ex nqo' anq'in toj q'oj.</para>
  <para style="b" />
  <para style="q">
    <verse number="17" style="v" />B'a'nxte' nqo' wan itzaj tk'i' tk'u'jlalil,</para>
  <para style="q">kyetwitz noq chib'j qchi' toj ik'jtib'il.</para>
  <para style="b" />
  <para style="q">
    <verse number="18" style="v" />Aju' txinwi' noqx njyon q'oj;</para>
  <para style="q">atzunju' me's ntq'o'n nak'b'il.</para>
  <para style="b" />
  <para style="q">
    <verse number="19" style="v" />Nojni toju' b'e tu'n ch'i'x teju' ky'aj;</para>
  <para style="q">atzu'n teju' tnik'alti'j ninb'e ex tb'anil.</para>
  <para style="b" />
  <para style="q">
    <verse number="20" style="v" />Nche tzalaju' manb'aj tu'n kyk'wal ati tnab'l;</para>
  <para style="q">atzu'n k'walb'aj xnak nche eltik'o'n.</para>
  <para style="b" />
  <para style="q">
    <verse number="21" style="v" />Ntzalaju' xnak toju' t-xnakyil;</para>
  <para style="q">atzunte' ati tnab'l ax nxika'yinte tib'.</para>
  <para style="b" />
  <para style="q">
    <verse number="22" style="v" />Qa min xqo xjelin aju' xim minti' nel b'a'n;</para>
  <para style="q">atzun b'a'npun q'ol nab'l b'a'n nela xim.</para>
  <para style="b" />
  <para style="q">
    <verse number="23" style="v" />¡Majx tzalajb'il aj tknet aku' tzaq'web'l,</para>
  <para style="q">ex majx tb'anil qa toj kuxi'xju' kmuj nojqelan!</para>
  <para style="b" />
  <para style="q">
    <verse number="24" style="v" />Wa'lxix twitzju' tb'eyil chwinqlal,</para>
  <para style="q">ex intklo'nju' ati tnab'l tu'n lay txi' toj tz'e'ysb'il witzb'aj.</para>
  <para style="b" />
  <para style="q">
    <verse number="25" style="v" />Nche kub't-xitu'n Qman Dyosju' nkynima'n kyib',</para>
  <para style="q">aye'tzu'n kyimni kychmil xq'uqi'nqe' tu'n Dyos.</para>
  <para style="b" />
  <para style="q">
    <verse number="26" style="v" />Min kub'ju' taq'wix xim toj twitz Qman Dyos,</para>
  <para style="q">atzun yol te tk'u'jlalil ntzalaj ti'j.</para>
  <para style="b" />
  <para style="q">
    <verse number="27" style="v" />Aju' pwaq myab'a'n kanb'ab'ente ntzaj tiq'i'n yajb'il tuja,</para>
  <para style="q">atzun nel tik'un pwaq tk'i' sb'ub'l, ktenb'il nim tchwinqlal.</para>
  <para style="b" />
  <para style="q">
    <verse number="28" style="v" />aju' xjal tnik'alti'j nximan nejtl ti'ju' ttzaq'web'l,</para>
  <para style="q">atzunju' b'inchal myab'a'n noqx nel tlanu'n tyol.</para>
  <para style="b" />
  <para style="q">
    <verse number="29" style="v" />Nel tpa'ntib' Qman Dyos kyi'ju' b'inchal myab'a'n,</para>
  <para style="q">aye'tzu'n tnik'alkyi'j intzaj tb'i'n kyna'j Dyos.</para>
  <para style="b" />
  <para style="q">
    <verse number="30" style="v" />Aju' witzb'aj ntzalaj ntq'o'n tzalajb'il toj qanmi;</para>
  <para style="q">exju' b'a'n tqanil ntq'o'n ak'a'j ipumalj.</para>
  <para style="b" />
  <para style="q">
    <verse number="31" style="v" />Alkyete' nb'in tzak'b'il ati tchwinqlal,</para>
  <para style="q">ex ktenb'il kxolju' ati kynab'l.</para>
  <para style="b" />
  <para style="q">
    <verse number="32" style="v" />Alkyete' nel tik'u'n tzak'b'il min tk'u'jlantib';</para>
  <para style="q">alkyetzunte nk'mon tzak'b'il nb'enxi'x t-ximan.</para>
  <para style="b" />
  <para style="q">
    <verse number="33" style="v" />Aju' ninb'ilte Qman Dyos ntq'o'n nab'l;</para>
  <para style="q">tnejelxi'x ati tu'n qok me's tu'n qk'monte oklenj.</para>
  <chapter number="16" style="c" />
  <para style="q">
    <verse number="1" style="v" />Ate' xjal nkub' ximante';</para>
  <para style="q">tojtzun tq'ob'te' Dyos ta' qa kjapumel.</para>
  <para style="b" />
  <para style="q">
    <verse number="2" style="v" />Tkyaqilju' ntb'incha'n xjal b'a'nile toj twitz,</para>
  <para style="q">atzunte Dyos inq'mante qa b'a'n mujqa mya.</para>
  <para style="b" />
  <para style="q">
    <verse number="3" style="v" />Q'onku'ya taq'una toj tq'ob' Dyos</para>
  <para style="q">ex tkyaqilju' t-xima che japumel.</para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" />Kub' tch'isa'n Dyos tkyaqil tuk'i'l jun tb'is tk'u'j:</para>
  <para style="q">ikxpena'ju' b'inchal myab'a'n toj mankb'il tq'ijlalil.</para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" />Myab'a'n qe' nkynima'n kyib' toj twitz Qman Dyos;</para>
  <para style="q">qu'n ilti'j kb'el tz'e'ysa'n kywitz.</para>
  <para style="b" />
  <para style="q">
    <verse number="6" style="v" />Nkub'najsetju' il tuk'i'l ax ex tk'u'jlalil;</para>
  <para style="q">qa nqnima'n Qman Dyos, nel qpa'nqib' ti'ju' myab'a'n.</para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" />Qa ntzalaj Dyos ti'ju' tu'me'l tz'anq'in jun xjal,</para>
  <para style="q">b'a'npe' nche tena' tajq'oj tuk'i'l tu'n Dyos.</para>
  <para style="b" />
  <para style="q">
    <verse number="8" style="v" />Ate b'a'nju' ch'i'n kanb'ab'l toj tnik'alti'j,</para>
  <para style="q">Kyetwitz txqan myab'a'n kanb'ab'ente.</para>
  <para style="b" />
  <para style="q">
    <verse number="9" style="v" />Ate' xjal nk'ulte t-xim,</para>
  <para style="q">atzunte Dyos kẍaqlulte tu'n tb'inchet.</para>
  <para style="b" />
  <para style="q">
    <verse number="10" style="v" />A Qman Dyos noninte' nimaqkawil tu'n tyolin toj tnik'alti'j</para>
  <para style="q">tu'n min tmaya' tz'e'ysb'il witzb'aj mya tojtu'me'l.</para>
  <para style="b" />
  <para style="q">
    <verse number="11" style="v" />Kanliyile qekye' malb'il twitz Qman Dyos;</para>
  <para style="q">qu'n ate b'inchalkye kykyaqil.</para>
  <para style="b" />
  <para style="q">
    <verse number="12" style="v" />Myab'a'n nela' nimaqkawb'il qama tb'incha jun taq'wixil,</para>
  <para style="q">qu'n nojqelan tu'n tkawin toj tnik'alilti'j.</para>
  <para style="b" />
  <para style="q">
    <verse number="13" style="v" />Nche tzalaju' nimaqkawil kyi'ju' xjal</para>
  <para style="q">qa nche yolin toj tnik'alilti'j ex njapun kyol.</para>
  <para style="b" />
  <para style="q">
    <verse number="14" style="v" />Aju' ttx'u'jil nimaqkawil jun techlal kamik,</para>
  <para style="q">atzunju' xjal ati tnab'l kymyetil tu'n.</para>
  <para style="b" />
  <para style="q">
    <verse number="15" style="v" />A b'a'nju' qa ntzalaju' nimaqkawil,</para>
  <para style="q">iky t-xtalb'ilju' kse'n ajtetz tqan jb'al.</para>
  <para style="b" />
  <para style="q">
    <verse number="16" style="v" />Ate b'a'nju' nab'l kyetwitz q'anpwaq;</para>
  <para style="q">ex ikx qa k'atzqwi' kyetwitz saqpwaq.</para>
  <para style="b" />
  <para style="q">
    <verse number="17" style="v" />A kynuk'b'il tnik'alkyi'ju' tu'n tel kypa'n kyib' ti'ju' myab'a'n;</para>
  <para style="q">nkyxq'uqi'n kychwinqlal qa nxikyka'yi'nkyib'.</para>
  <para style="b" />
  <para style="q">
    <verse number="18" style="v" />Tu'nju' nimjtib'il ntzaja' xitb'il;</para>
  <para style="q">ex tu'nju' la'jtib'il kb'el tz'aqi.</para>
  <para style="b" />
  <para style="q">
    <verse number="19" style="v" />Ate b'a'n tu'n qok prow kyuk'i'lju' me's</para>
  <para style="q">kyetwitz tu'n qok q'inun kyuk'i'lju' nkynima'kyib'.</para>
  <para style="b" />
  <para style="q">
    <verse number="20" style="v" />Aju' b'a'n nuk'ul b'a'n nela taq'un;</para>
  <para style="q">¡k'i'wla'nte' xjal q'uqlok tk'u'j ti'j Dyos!.</para>
  <para style="b" />
  <para style="q">
    <verse number="21" style="v" />Alkyete nkub' t-xima'n b'a'nxi'x, ati tnab'l;</para>
  <para style="q">alkyete' b'a'nyolin lwiy nkub' qi'j tu'n.</para>
  <para style="b" />
  <para style="q">
    <verse number="22" style="v" />T-xiklil a' te' te chwinqlal qa ati qnab'l;</para>
  <para style="q">xnakyilxte' tu'n kyxnaq'tzetju' xnakqe'.</para>
  <para style="b" />
  <para style="q">
    <verse number="23" style="v" />Alkyete' nkub' t-xima'n tyol,</para>
  <para style="q">majx kyexi'x tb'inxju' tyol.</para>
  <para style="b" />
  <para style="q">
    <verse number="24" style="v" />Ikyqe' tb'anil yolju' kse'n ta'lkab' kyu'n onon:</para>
  <para style="q">najb'en te kyq'a'nb'il xjal.</para>
  <para style="b" />
  <para style="q">
    <verse number="25" style="v" />Ati b'e naku'j tzinun kyi'j toj twitz xjal,</para>
  <para style="q">ajtzun tpon b'aj tb'eyil kamikte'.</para>
  <para style="b" />
  <para style="q">
    <verse number="26" style="v" />B'a'nte' qa nqo' we'yajti qu'n noktilil aq'untl;</para>
  <para style="q">tu'n tqe tk'u'j.</para>
  <para style="b" />
  <para style="q">
    <verse number="27" style="v" />Iky b'inchal myab'a'n kse'n jun chuj njayun;</para>
  <para style="q">¡naqpena' tyol naku'j tqan taq' q'aq'!</para>
  <para style="b" />
  <para style="q">
    <verse number="28" style="v" />Aju' b'inchal myab'a'n noq njyon q'oj;</para>
  <para style="q">exju' njk'unyol noqx nik'u'n kyxol tuk'i'l.</para>
  <para style="b" />
  <para style="q">
    <verse number="29" style="v" />Aju' kuw ttx'u'jil inche kub' t-sb'u'n tuk'i'l</para>
  <para style="q">ex nche' txalpuj tu'n.</para>
  <para style="b" />
  <para style="q">
    <verse number="30" style="v" />In txmutz'b'e'n twitzju' xjal nximan tu'n tb'inchan il;</para>
  <para style="q">atzunju' matxi' b'inchan il, naq nkub' ttx'a'n t-xe twitzte.</para>
  <para style="b" />
  <para style="q">
    <verse number="31" style="v" />Jun ninb'ilte' t-xya'mal twi' xjal saqtl,</para>
  <para style="q">kanb'ab'l tu'nju' tb'anil tchwinqlal.</para>
  <para style="b" />
  <para style="q">
    <verse number="32" style="v" />B'a'nxte' ati qpasens kyetwitz kuw xjalqo';</para>
  <para style="q">b'a'nte' tu'n qjk'unteqib' kyetwitz tu'n tkub'kyi'j nimaqtnam qu'n.</para>
  <para style="b" />
  <para style="q">
    <verse number="33" style="v" />Aye' xjal nkyqani'n kychwinqlal b'a'n,</para>
  <para style="q">atzunte' Qman Dyos q'malte qa b'a'n mujqa mya.</para>
  <chapter number="17" style="c" />
  <para style="q">
    <verse number="1" style="v" />Ate b'a'n tu'n qwan tmoj itzaj toj nak'b'il</para>
  <para style="q">kyetwitz tu'n qwan tmoj chib'j toj q'oj.</para>
  <para style="b" />
  <para style="q">
    <verse number="2" style="v" />Aju' b'a'n majen nkawin tib'aju'</para>
  <para style="q">k'walb'aj mixti' tnab'l,</para>
  <para style="q">ex ati toklen ti'ju' etzb'il kysenxju' txqantl k'wa'lb'aj.</para>
  <para style="b" />
  <para style="q">
    <verse number="3" style="v" />aye' q'anpwaq ex saqpwaq, q'aq'te' b'inchalkye;</para>
  <para style="q">atzun kyanmi xjal ate' Dyos ka'yilte.</para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" />Ayeju' xjal b'inchal il ex chalyol</para>
  <para style="q">inxi' kyb'i'nju' chajyolil.</para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" />Qama qo' xmayin ti'j jun prow, nakuj nqo' xmayin ti'j Dyos ch'isal;</para>
  <para style="q">exju' ntze'n ti'ju' nk'ulb'an, mixwittzun ti'te' chojb'il te.</para>
  <para style="b" />
  <para style="q">
    <verse number="6" style="v" />A kyninb'ilju' manb'aj aye' kyk'wal;</para>
  <para style="q">atzu'n kytzalajb'ilju' tijwnaq aye' kychman.</para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" />Myab'a'n nela' teju' xnak tu'n tyolin ttxolilti'j,</para>
  <para style="q">ex lay tz'elb'a'n tu'n tchan yol jun tnik'alti'j.</para>
  <para style="b" />
  <para style="q">
    <verse number="8" style="v" />Aju' nchojon tu'n tb'inchanjtz xtalb'il te,</para>
  <para style="q">toj twitz qa tkyaqil kb'entil tu'n jaxjaku' matxa'.</para>
  <para style="b" />
  <para style="q">
    <verse number="9" style="v" />Alkyete nkub' tnajsa'n til juntl ate'qe' tamiw;</para>
  <para style="q">atzunju' nxi' tchitpu'n til juntl nel ik'u'n.</para>
  <para style="b" />
  <para style="q">
    <verse number="10" style="v" />B'a'nxi'x nela' tzak'b'il te jun xjal ati tnab'l</para>
  <para style="q">kyetwitz qama b'aj syalit jun xjal xnak.</para>
  <para style="b" />
  <para style="q">
    <verse number="11" style="v" />Aju' pi's noq njyon q'oj,</para>
  <para style="q">ilti'jtzun k'okyel yal juntl kuwxi'x kyetwitz.</para>
  <para style="b" />
  <para style="q">
    <verse number="12" style="v" />B'a'npete' qama tz'okyal jun tx'u'j ttxu oso qwitz</para>
  <para style="q">kyetwitz tu'n tb'in jun xjal jip.</para>
  <para style="b" />
  <para style="q">
    <verse number="13" style="v" />Aju' min tq'o'n b'a'n tu'me'l t-xel kse'n nb'inchanjtz te</para>
  <para style="q">kukx atiju' taq'wixil toj tja.</para>
  <para style="b" />
  <para style="q">
    <verse number="14" style="v" />Ikyte q'oju' ajttzaj kse'n tnimal a' ajtex piq'j;</para>
  <para style="q">ate b'a'n tu'n qik'b'et kyetwitz tu'n txi' toj nim.</para>
  <para style="b" />
  <para style="q">
    <verse number="15" style="v" />Kab'e' ti'xti' taq'wix twitz Dyos qama txi' tzaqpetu' ati til</para>
  <para style="q">ex tu'n tjtz'etu' mixti' til.</para>
  <para style="b" />
  <para style="q">
    <verse number="16" style="v" />¿Titi' k'ajb'ela' teju' xnak</para>
  <para style="q">tu'n tlq'onte nab'l extzun mixti'x nximan?</para>
  <para style="b" />
  <para style="q">
    <verse number="17" style="v" />Jun qamiw kyeqten tuk'i'l,</para>
  <para style="q">nakuj jun qtzik ajqoktz'aq twitz b'is.</para>
  <para style="b" />
  <para style="q">
    <verse number="18" style="v" />O'kxte' mixti' tnab'l nkyej tziya'n tk'asju' tuk'i'l</para>
  <para style="q">ex nkyej tq'o'ntib' ka'yilte tu'n tchjetu' k'as.</para>
  <para style="b" />
  <para style="q">
    <verse number="19" style="v" />Alkyete noktik'le'n juntl, tajb'il tu'n tb'ujun;</para>
  <para style="q">alkyete' ntnima'ntib', axte'ntzaj q'inte tq'ob' tze toj twi'.</para>
  <para style="b" />
  <para style="q">
    <verse number="20" style="v" />Aju' xjal txlaj tnab'l layx ten toj b'a'nil;</para>
  <para style="q">exju' xjal mya'l taq' kb'eltz'aq toj.</para>
  <para style="b" />
  <para style="q">
    <verse number="21" style="v" />B'isb'ajilx tu'n qok manb'aj te jun xnak k'wal;</para>
  <para style="q">mixya tzalajb'ilte' tu'n qok tman jun xnak k'wal.</para>
  <para style="b" />
  <para style="q">
    <verse number="22" style="v" />Aju' wnaq ntzalaj majx nok te q'anb'il,</para>
  <para style="q">atzunju' nb'isin max ntzaj qb'is tu'n.</para>
  <para style="b" />
  <para style="q">
    <verse number="23" style="v" />Aju' b'inchal myab'a'n ntk'mo'n pwaq toj ewaj,</para>
  <para style="q">ntxalpuj ttxolil kawb'il tu'n.</para>
  <para style="b" />
  <para style="q">
    <verse number="24" style="v" />Aju' xjal b'a'n ximan, njyon nab'l,</para>
  <para style="q">atzu'n xnak noqx njawje ti'ju' t-xim.</para>
  <para style="b" />
  <para style="q">
    <verse number="25" style="v" />Naqx yajb'il ex q'ol tx'u'jilj</para>
  <para style="q">noka' k'walb'aj xnak kye' tman.</para>
  <para style="b" />
  <para style="q">
    <verse number="26" style="v" />Myab'a'n tu'n tz'e'yset twitzju' xjal mixti' til</para>
  <para style="q">ex mya tu'me'l tu'n tb'aj pejitju' xjal tnik'alti'j.</para>
  <para style="b" />
  <para style="q">
    <verse number="27" style="v" />Ati tnab'lju' xjal ntjk'u'n taq',</para>
  <para style="q">b'a'n t-ximanteju' min jaw tx'u'jin lwiy.</para>
  <para style="b" />
  <para style="q">
    <verse number="28" style="v" />Expena' nok q'o'n xnak te ati tnab'l</para>
  <para style="q">qama kub' tq'o'n nak'li.</para>
  <chapter number="18" style="c" />
  <para style="q">
    <verse number="1" style="v" />Aju' xjal o'kx ntjyo'n tajb'il, ẍk'u'ẍ,</para>
  <para style="q">ex tkyaqil b'a'n nab'l nel tik'u'n.</para>
  <para style="b" />
  <para style="q">
    <verse number="2" style="v" />Min tajb'il jun xnak tu'n tknonte xnaq'tzb'il;</para>
  <para style="q">noq njaw tnima'ntib' tu'nju' ch'i'n nb'ent tu'n.</para>
  <para style="b" />
  <para style="q">
    <verse number="3" style="v" />Ch'xawilte' nnel tu'n b'inchaj il;</para>
  <para style="q">exju' nimjtib'il nel qch'ixaw tu'n.</para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" />Iky tyol ati tnab'lju' kse'n a' nimt-xe,</para>
  <para style="q">nin a' nb'et, t-xochil nab'l.</para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" />Myab'a'n tu'n txi' tzaqpi'nju' aj il tu'n ajkawil</para>
  <para style="q">ex tu'n tkub' ktz'e'ysa'n twitzju' mixti' til.</para>
  <para style="b" />
  <para style="q">
    <verse number="6" style="v" />Aju' mixti' tnab'l tu'nx ttzi njyon q'oj;</para>
  <para style="q">ex asyal ntjyo'n tu'nju' tyol.</para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" />Tu'nx tyolju' xnak nkub'o'lja';</para>
  <para style="q">ex tu'nx ttzi noka' tq'o'n aqwil tqul.</para>
  <para style="b" />
  <para style="q">
    <verse number="8" style="v" />Naku'xixtej kab'ju' jk'ujyoli'n,</para>
  <para style="q">ajtzun tjapun b'aj, majx tk'ayil npon ti'j qanmi.</para>
  <para style="b" />
  <para style="q">
    <verse number="9" style="v" />¡Kyitz'in kyib'ju' ky'aj kyuk'i'lju' txa'ju'n tkub' kyu'n!</para>
  <para style="b" />
  <para style="q">
    <verse number="10" style="v" />Iky tb'i Qman Dyos kse'n jun ja nimin twe' ex kuw</para>
  <para style="q">janche pona' tnik'alkyi'j klolkyib'.</para>
  <para style="b" />
  <para style="q">
    <verse number="11" style="v" />Toj tnab'lu' q'inun qa iky tq'inumalu'</para>
  <para style="q">kse'n jun nintnam tok nintapi nimin twe' ti'jile.</para>
  <para style="b" />
  <para style="q">
    <verse number="12" style="v" />Tu'ju' nimjtib'il nqo b'o'lja';</para>
  <para style="q">ex tu'nelju' me'sb'il nqo k'i'wlanjtza'.</para>
  <para style="b" />
  <para style="q">
    <verse number="13" style="v" />Ch'ixb'ajilxte' tu'n txi' qma'n qyol</para>
  <para style="q">na'mxtoq qb'inte se'n tu'me'lxi'x.</para>
  <para style="b" />
  <para style="q">
    <verse number="14" style="v" />Ate' yab' ax nq'uqb'ante tk'u'j,</para>
  <para style="q">¿alkyexi'x kq'uqb'alte kyk'u'ju' nche' b'isun?</para>
  <para style="b" />
  <para style="q">
    <verse number="15" style="v" />Inknet ojtzqib'l kyu'n ati kynab'l ex kyu'n nkane toj kywitz</para>
  <para style="q">aju' nche jyon ti'j;</para>
  <para style="b" />
  <para style="q">
    <verse number="16" style="v" />Tu'n jun oyaj nb'ent qpon yolil</para>
  <para style="q">kyuk'i'l xjal nimaq kyoklen.</para>
  <para style="b" />
  <para style="q">
    <verse number="17" style="v" />Aju' tnejel xjal npon twitz kawil naku'j mixti' tpaj, ajtzun tpon tajq'oj atzuntzu' nela' yala' til.</para>
  <para style="b" />
  <para style="q">
    <verse number="18" style="v" />Tkyaqilju' q'oj kyq'onkyje' toj tq'ob' Dyos</para>
  <para style="q">ate nq'onte nak'b'il kyxolju' nche q'ojin.</para>
  <para style="b" />
  <para style="q">
    <verse number="19" style="v" />Jun tzikb'aj mo itz'inb'aj qama tz'ok ttx'u'jil</para>
  <para style="q">ikte' kse'n jun nintnam kuw.</para>
  <para style="q">Ikyte q'oju' kse'n k'uxb'il te maqb'il</para>
  <para style="q">ttzi nin tja kawb'il lay b'ent qokx toj.</para>
  <para style="b" />
  <para style="q">
    <verse number="20" style="v" />Qo walte' b'a'n mujqa myab'a'n kse'nxju' qo yolin.</para>
  <para style="b" />
  <para style="q">
    <verse number="21" style="v" />Tu'n qaq' atite' chwinqlal mo kamik;</para>
  <para style="q">aye'ju' mya'l che yolin aye'x che yajtel tu'nju' kyol.</para>
  <para style="b" />
  <para style="q">
    <verse number="22" style="v" />Alkyete' nokyal b'a'n t-xu'jil, nakuj jun q'inumal:</para>
  <para style="q">qu'n ntk'mo'n t-xtalb'il Dyos.</para>
  <para style="b" />
  <para style="q">
    <verse number="23" style="v" />Aju' prow nkub'san;</para>
  <para style="q">atzunte q'inun nxon tyol.</para>
  <para style="b" />
  <para style="q">
    <verse number="24" style="v" />Ate' amiw naq ate'qexi' quk'i'l,</para>
  <para style="q">atitzuntlte qamiw b'a'nxi'x tten quk'i'l kyetwitz qitz'inqib' tuk'i'l.</para>
  <chapter number="19" style="c" />
  <para style="q">
    <verse number="1" style="v" />Ate b'a'nju' prowqo' qa nqoksla'n Dyos,</para>
  <para style="q">kyetwitzju' xnak jk'ulyol.</para>
  <para style="b" />
  <para style="q">
    <verse number="2" style="v" />Myab'a'nte' nb'ajx qk'u'j ti'jun ti'xti'; ati tu'n qximan nej</para>
  <para style="q">ex min nel b'a'n naq wa'lq'e'l nb'incheta'.</para>
  <para style="b" />
  <para style="q">
    <verse number="3" style="v" />Tu'n t-xnakyil xjal, nela' txalpuj ti'ju' tb'e,</para>
  <para style="q">yajxi'tzuntel nnoktq'o'n te tpaj Dyos.</para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" />Qa ati qpwaq nim txqan qamiw,</para>
  <para style="q">Atzunte prow xipe' nel ik'u'na' kyu'n.</para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" />Ilti'j ktz'e'ysetel twitzju' mya ax tziyal;</para>
  <para style="q">exju' chalyol mixti'x kolb'ilte.</para>
  <para style="b" />
  <para style="q">
    <verse number="6" style="v" />Nimte' jyolte xjal b'a'n oyin,</para>
  <para style="q">ex kykyaqil tamiwileqe'.</para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" />In pena' nel ik'u'n prow kyu'n ttzik mo titz'in,</para>
  <para style="q">mitzunlo yakye' tamiw, majx nelkyik'u'n.</para>
  <para style="b" />
  <para style="q">
    <verse number="8" style="v" />Aju' xjal ntb'incha'n xnaq'tzb'il kse'nxju' ntkno'n,</para>
  <para style="q">intk'u'jla'n tib' ex nch'iy toj tkyaqil.</para>
  <para style="b" />
  <para style="q">
    <verse number="9" style="v" />Aju' mya ax tziyal, ilti'j kb'el tz'e'ysa'n twitz;</para>
  <para style="q">exju' chalyol ati tu'n tb'aj.</para>
  <para style="b" />
  <para style="q">
    <verse number="10" style="v" />Myab'a'n tka'yinx ntzalaju' xnak kyoj achb'il,</para>
  <para style="q">mitzunloya jun lq'o'n majen tu'n tkawin kyib'aj nimaqkawil.</para>
  <para style="b" />
  <para style="q">
    <verse number="11" style="v" />Inten tpasensju' xjal ati tnab'l,</para>
  <para style="q">extzun a tb'anilxi'xju' tu'n tkub'najsetju' il.</para>
  <para style="b" />
  <para style="q">
    <verse number="12" style="v" />A ttx'u'jilju' nimaqkawil kse'n tq'ojq'ojel twi' b'alun aj tzanun,</para>
  <para style="q">atzunju' t-xtalb'il kse'n ẍmu's tib'aj awal.</para>
  <para style="b" />
  <para style="q">
    <verse number="13" style="v" />Jun k'walb'aj xnak nche yajti tman tu'n.</para>
  <para style="q">ex ikyte qyaju' noqx nẍalb'i kse'n jun ja ntx'atjne kukxju'.</para>
  <para style="b" />
  <para style="q">
    <verse number="14" style="v" />Ntzaj kyq'o'n qman qtx'otx' ex qja te qetzb'il;</para>
  <para style="q">atzu'n xu'jilb'aj ati tnab'l a Qman Dyos ntzaj q'onte.</para>
  <para style="b" />
  <para style="q">
    <verse number="15" style="v" />Tu'nju' ky'ejil ntzaj txqan qwatl,</para>
  <para style="q">exju' ky'ej kyajtel tu'n we'yaj.</para>
  <para style="b" />
  <para style="q">
    <verse number="16" style="v" />Alkyete ntb'incha'n chaq'b'il ati tchwinqlal;</para>
  <para style="q">alkyetzunte nel ik'unte t-xnaq'tzb'il Qman Dyos, kb'ajel.</para>
  <para style="b" />
  <para style="q">
    <verse number="17" style="v" />Naku'j te Dyos nxa' tmajina'n xjal nonin tiju' prow,</para>
  <para style="q">ex aku'te Dyos ktzajel q'onte tu'me'l t-xel.</para>
  <para style="b" />
  <para style="q">
    <verse number="18" style="v" />Tzak'umju'ya tk'wala inxku' tq'a' tzak'u'tib',</para>
  <para style="q">laytzun majxkub' tb'yo'na toju' tzak'b'il.</para>
  <para style="b" />
  <para style="q">
    <verse number="19" style="v" />Alkyete' kuw ttx'u'jil ktk'ma' tu'me'l t-xel</para>
  <para style="q">myab'a'n tu'n txi' myet qu'n kytzajelxi'x ttx'u'jil.</para>
  <para style="b" />
  <para style="q">
    <verse number="20" style="v" />B'inkuya nab'l ex k'momju'ya tzak'b'il;</para>
  <para style="q">ktenb'eltzun tnab'ltzuya ajttijina.</para>
  <para style="b" />
  <para style="q">
    <verse number="21" style="v" />Aju' xjal nim txqan t-xim tu'n tb'inchante,</para>
  <para style="q">atzunte' Dyos kq'malte qa kjapumel.</para>
  <para style="b" />
  <para style="q">
    <verse number="22" style="v" />B'a'nte' qa tnik'alti'ju' xjal;</para>
  <para style="q">ate b'a'nju' prowqo' kyetwitz tu'n qok chalyol.</para>
  <para style="b" />
  <para style="q">
    <verse number="23" style="v" />Atite chwinqlal qanb'ina te Qman Dyos;</para>
  <para style="q">nqo' tzalaj ex mixti'te' nqo ik'a'.</para>
  <para style="b" />
  <para style="q">
    <verse number="24" style="v" />Aye'kye' ky'aj kyky'ajpe' tu'n kywan,</para>
  <para style="q">noqpe' tu'n txi' kyiq'i'n toj ktzi.</para>
  <para style="b" />
  <para style="q">
    <verse number="25" style="v" />Ate' xnak ilxi'xti'j kytz'e'ysetil twitz tu'ntzun teltnik';</para>
  <para style="q">atzunte' ati tnab'l tu'n jumajxte' q'unb'ente te.</para>
  <para style="b" />
  <para style="q">
    <verse number="26" style="v" />Alkye matz'ok miltz'ujti'j tman, ex matz'ex t-xla'ja'n ttxu tja</para>
  <para style="q">jun nimaq leq' mixti' tch'ixaw.</para>
  <para style="b" />
  <para style="q">
    <verse number="27" style="v" />Aya nk'yajul lalun tz'el tik'unjuya tzak'b'il</para>
  <para style="q">qatzun minti', k'elil txalpuja tiju' tb'eyil nab'l.</para>
  <para style="b" />
  <para style="q">
    <verse number="28" style="v" />Aju' mya ax tziyal nxmayin ti'ju' kawb'il;</para>
  <para style="q">exju' myab'a'n ntb'incha'n noq xlab'yol ntyoli'n.</para>
  <para style="b" />
  <para style="q">
    <verse number="29" style="v" />Noq tkub'ku'tlte' tz'e'ysb'il kwitzju' b'inchal myab'a'n;</para>
  <para style="q">exte' syal ktze'lti'ju' xnak.</para>
  <chapter number="20" style="c" />
  <para style="q">
    <verse number="1" style="v" />Aju' q'e'n in naj tnab'l xjal tu'n;</para>
  <para style="q">exqa matxi' kyk'wa'n nim nche elxja'ja' tu'n;</para>
  <para style="q">qa ntx'ujti minti' nximan ti'ju' ntb'incha'n.</para>
  <para style="b" />
  <para style="q">
    <verse number="2" style="v" />Iky ttx'u'jil nimaqkawil kse'n b'alun ntzanun;</para>
  <para style="q">alkyete' matxi' yekunte nelje tchwinqlal.</para>
  <para style="b" />
  <para style="q">
    <verse number="3" style="v" />Ninb'iltete xjalju' qama tnajsa'nju' wulji'n,</para>
  <para style="q">atzunte' xnak xipe' jyona' q'oj.</para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" />Ate' ky'ej minti' nkjon;</para>
  <para style="q">ajtzun tpon tq'ijlalil njyon twa, ex mixti'x nknet tu'n.</para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" />Ikyte ximju' e'wa'n kse'n jun nin a' nimin t-xe,</para>
  <para style="q">atzunju' xjal ati tnab'l neltnik' ti'j.</para>
  <para style="b" />
  <para style="q">
    <verse number="6" style="v" />Nimte' nkyma'n qa tnik'alkyi'j,</para>
  <para style="q">layxtzun knet jun qu'n jatu'n tok qeqk'u'j.</para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" />¡K'iwla'n qe'kye' k'wa'lb'aj</para>
  <para style="q">qama che lpe ti'j kyman tnik'alkyi'j!</para>
  <para style="b" />
  <para style="q">
    <verse number="8" style="v" />Aju' nimaqkawil ajtkub' qe tu'n tkawin,</para>
  <para style="q">noq ajt-xi' tka'yi'n toj kywitzju' b'ajsal majx npon tnab'l alkye ti tpaj.</para>
  <para style="b" />
  <para style="q">
    <verse number="9" style="v" />Mix-a'lokye kq'malte: ẍtilunwe' wanmi,</para>
  <para style="q">ex mixti'we' wil, chiwt.</para>
  <para style="b" />
  <para style="q">
    <verse number="10" style="v" />Kab'e' ti'xti' nel tik'u'n Qman Dyos</para>
  <para style="q">aju' tqan peẍ min tz'aqli, exju' malb'il tuk'i'l sb'ub'l.</para>
  <para style="b" />
  <para style="q">
    <verse number="11" style="v" />Tu'nju' tu'me'l se'n nanq'ina' ku'xun</para>
  <para style="q">nq'ancha'lixa' qa tnik'alti'j.</para>
  <para style="b" />
  <para style="q">
    <verse number="12" style="v" />Aju' ẍkyinb'aj tu'n tb'in atzu'n witzb'aj tu'n tka'yin</para>
  <para style="q">kykab'ilx tb'inchb'aj Dyos qe'.</para>
  <para style="b" />
  <para style="q">
    <verse number="13" style="v" />Lalun wtanxi'xa tu'n lalun kub'aja;</para>
  <para style="q">iq'imila twatla, we'ktza prim ktenb'iltzun twatziya.</para>
  <para style="b" />
  <para style="q">
    <verse number="14" style="v" />¡Mya'x b'a'nte' tk'a'ẍa!, ntma'nju' loq'ol,</para>
  <para style="q">tb'ajlenxi'tzun loq'o'n inxpetzun ntzalaj ti'j.</para>
  <para style="b" />
  <para style="q">
    <verse number="15" style="v" />Nimxi'x toklen tyolju' ati tnab'l,</para>
  <para style="q">kyetwitz q'anpwaq ex txqan ab'j tb'anilqexi'x.</para>
  <para style="b" />
  <para style="q">
    <verse number="16" style="v" />Jun xjal makyej tziyal ch'ex te jun xjal minti' tojtzqi'n,</para>
  <para style="q">Q'imil jun tixtiya te, tu'n tkyejten anjtzb'il k'as.</para>
  <para style="b" />
  <para style="q">
    <verse number="17" style="v" />B'a'nlote' toj twitza tu'n taq'unana tk'i' sb'ub'l</para>
  <para style="q">yajxi'tel kb'el tchjo'na.</para>
  <para style="b" />
  <para style="q">
    <verse number="18" style="v" />Qa ati jun t-xima, tnejel b'inx tnab'la</para>
  <para style="q">qama txi'ya q'ojil jyonx tu'me'la b'a'nxi'x.</para>
  <para style="b" />
  <para style="q">
    <verse number="19" style="v" />Min newit jun ti'xti' tu'n jk'ulyol,</para>
  <para style="q">qu'mtzun lalun qe tk'u'ja ti'j jun jk'ulyol.</para>
  <para style="b" />
  <para style="q">
    <verse number="20" style="v" />Aju' k'wa'lb'aj taq'wix tyol kyi'j tman</para>
  <para style="q">kb'el yupj ttxa'n ttzaj tojxixtej qlolj.</para>
  <para style="b" />
  <para style="q">
    <verse number="21" style="v" />Aju' ti'xti' lwiy nkub'ti'j,</para>
  <para style="q">ajxi'x tjapun kanun mixya tzalajb'ilte'.</para>
  <para style="b" />
  <para style="q">
    <verse number="22" style="v" />Lalun tmaya qa k'okyel tq'o'na tu'me'l t-xel;</para>
  <para style="q">qek tk'u'ja ti'j Qman Dyos, qu'n ate kb'inchalte tu'n tkanb'ana.</para>
  <para style="b" />
  <para style="q">
    <verse number="23" style="v" />Inche tik'o'nte Qman Dyos tqan peẍ min tz'aqli;</para>
  <para style="q">exju' malb'il myab'a'n.</para>
  <para style="b" />
  <para style="q">
    <verse number="24" style="v" />Ate Qman Dyos nxb'etzanqe;</para>
  <para style="q">¿se'n taq'wi tu'n qb'inte jaqopomela'?</para>
  <para style="b" />
  <para style="q">
    <verse number="25" style="v" />myab'a'n txiqtziya'n jun ti'xti' te Qman Dyos</para>
  <para style="q">qa na'mxtoq qximan qa kb'entel mujqa lay.</para>
  <para style="b" />
  <para style="q">
    <verse number="26" style="v" />Aju' nimaqkawil ati tnab'l majx nche kub' tb'yo'n</para>
  <para style="q">b'inchal myab'a'n tu'n kb'aj jumajx.</para>
  <para style="b" />
  <para style="q">
    <verse number="27" style="v" />Aju' Xewb'aj tzaj tq'o'n Dyos teju' xjal</para>
  <para style="q">a spik'unju' nk'anti tojxi'x tanmi.</para>
  <para style="b" />
  <para style="q">
    <verse number="28" style="v" />Aju' nimaqkawil ati tnab'l ntk'u'jla'n ex nyolin ax</para>
  <para style="q">atzunte' tzuyb'il tkawb'ilju' b'a'nxix'.</para>
  <para style="b" />
  <para style="q">
    <verse number="29" style="v" />A kykuwalju' ku'xun atzu' ta' toju' kyipumal;</para>
  <para style="q">atzunkye' tijwnaq ninb'ilkye qama saqax kywi'.</para>
  <para style="b" />
  <para style="q">
    <verse number="30" style="v" />Aju' aj il tzmaxi' nok tnab'lju' ex b'anixa' toj tchib'l asyal ex k'ixb'len.</para>
  <chapter number="21" style="c" />
  <para style="q">
    <verse number="1" style="v" />Aju' tnab'l nimaqkawil naku'j tnimal a' toj tq'ob' Dyos,</para>
  <para style="q">ex inxitiq'i'n jaxja tajb'ila'.</para>
  <para style="b" />
  <para style="q">
    <verse number="2" style="v" />Tkyaqilju' te xjal intb'incha'n majx b'a'nile toj twitz,</para>
  <para style="q">o'kxte Dyos neltnik' ti'ju' t-xim xjal.</para>
  <para style="b" />
  <para style="q">
    <verse number="3" style="v" />B'inchamju'ya tnik'alilti'j,</para>
  <para style="q">qu'n tb'anilxi'x nela' toj twitz Dyos kyetwitz chojb'il.</para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" />Aju' xjal in tnima'ntib' tk'i' tnab'l in q'ancha'lix tu'nju' twitz;</para>
  <para style="q">ex tkyaqilju' te intb'incha'n ilqe'kye'.</para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" />Aye'ju' xim b'a'n xinb'enkye inche elb'a'n;</para>
  <para style="q">atzunju' inche kub' nk'et toj ojqelb'il minti' in che elb'a'n.</para>
  <para style="b" />
  <para style="q">
    <verse number="6" style="v" />Tkyaqil q'inumal nk'met tu'n chajyolil</para>
  <para style="q">noq jun kmuj te' tzalajb'il tu'n kyeju' inche jyonte tb'eyil kamik.</para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" />Axju' kyb'inchb'en xjal b'inchal myab'a'n kb'el xitunkye,</para>
  <para style="q">tu'n tpaj min xkyaj tu'n kyb'inchante tnik'alilti'j.</para>
  <para style="b" />
  <para style="q">
    <verse number="8" style="v" />Tz'ilju' tu'me'l tk'i' tz'anq'inju' xjal b'inchal myab'a'n ex mya q'uqli tk'u'jlalil;</para>
  <para style="q">atzu'n xjal nanq'in toj tnik'alti'j ẍnu'l tchwinqlal.</para>
  <para style="b" />
  <para style="q">
    <verse number="9" style="v" />tb'anilxi'xte' tu'n qnajan toj jun ja xoq'l t-xe;</para>
  <para style="q">kyetwitz tu'n qnajan toj jun nin ja tb'anilxi'x tuk'i'l jun qya mixti'x tnab'l.</para>
  <para style="b" />
  <para style="q">
    <verse number="10" style="v" />Aju' in b'inchan myab'a'n o'kxtzu' in ximana' tu'n tb'inchan il;</para>
  <para style="q">ex min inche tk'u'jla'n twnaqil.</para>
  <para style="b" />
  <para style="q">
    <verse number="11" style="v" />Tu'n tz'e'ysb'il twitzju' pi's, nkaneya' toj twitzju' min nximan;</para>
  <para style="q">atzu'n xjal ati tnab'l nkane toj twitz noqx tu'n ajt-xi' chik'b'a'n te.</para>
  <para style="b" />
  <para style="q">
    <verse number="12" style="v" />Nximanju' tnik'alxi'xti'j ti'ju' taq'wixil ntzaj ti'ju' xjal aj il;</para>
  <para style="q">ajttzaj q'o'nju' yajb'il tib'aj.</para>
  <para style="b" />
  <para style="q">
    <verse number="13" style="v" />Alkyete min nxitb'i'n tkub'sb'ilju' prow</para>
  <para style="q">ex ikxte lay tzajb'i'n ajtqanin o'nb'il.</para>
  <para style="b" />
  <para style="q">
    <verse number="14" style="v" />Aju' xjal kuw ttx'u'jil</para>
  <para style="q">inkub' tk'u'j tu'n jun oyaj nxiq'o'n te toj ewaj.</para>
  <para style="b" />
  <para style="q">
    <verse number="15" style="v" />Intzalaju' xjal tnik'alti'j aj tb'inchetju' tnik'alilti'j,</para>
  <para style="q">atzu'n kyeju' b'inchal myab'a'n jun xitb'il nnul.</para>
  <para style="b" />
  <para style="q">
    <verse number="16" style="v" />Alkyete matz'el tpa'ntib' ti'j ju' tb'eyil nab'l,</para>
  <para style="q">atzu' kweb'ila' kxol kyimni.</para>
  <para style="b" />
  <para style="q">
    <verse number="17" style="v" />Alkyete' ntk'u'jla'n achb'il kb'el prowix,</para>
  <para style="q">exqe' nkyk'u'jla'n b'in e'k'ok'sb'il lay che jaw q'inumax.</para>
  <para style="b" />
  <para style="q">
    <verse number="18" style="v" />Kyajtelju' xjal b'inchal myab'a'n ex xmletz'</para>
  <para style="q">te t-xelju' xjal tnik'alti'j.</para>
  <para style="b" />
  <para style="q">
    <verse number="19" style="v" />Tb'anilxi'x tu'n qnajan toj chq'ajlaj</para>
  <para style="q">kyetwitz tu'n qnajan tuk'i'l jun qya mixti' tnab'l ex kuw t-tx'u'jil.</para>
  <para style="b" />
  <para style="q">
    <verse number="20" style="v" />Toj tjaju' xjal ati tnab'l ati nim q'inumal ex k'ok'sb'il,</para>
  <para style="q">atzunju' mixti' tnab'l mixti'xte ati te qu'n tkyaqil in kub' tnajsa'n.</para>
  <para style="b" />
  <para style="q">
    <verse number="21" style="v" />Alkyete noktilil tu'n, tu'n tok tnik'alti'j ex b'a'n xjal</para>
  <para style="q">in okyal chwinqlal tu'n ex oklenj.</para>
  <para style="b" />
  <para style="q">
    <verse number="22" style="v" />Nok tzaqpaju' xjal ati tnab'l ti'j jun nintnam jpu'nti'j,</para>
  <para style="q">majx nkub' tb'ajsa'n tkyaqilju' tipumal jaq'uqla'toq tk'u'j.</para>
  <para style="b" />
  <para style="q">
    <verse number="23" style="v" />Aju' xjal nximan tib'aju' tyol kxe'l tma'n,</para>
  <para style="q">lay txi'jk'u'n toj jun ti'xti' myab'a'n.</para>
  <para style="b" />
  <para style="q">
    <verse number="24" style="v" />Aju' xjal nimaltib', la'j ex xmayil</para>
  <para style="q">a tb'iju' xjal mixti' tnab'l.</para>
  <para style="b" />
  <para style="q">
    <verse number="25" style="v" />Aju' ky'ej nim ti'xti' tajb'il tu'n tten te,</para>
  <para style="q">aye'tzu'n tq'ob' mixjun nche aq'unan;</para>
  <para style="b" />
  <para style="q">
    <verse number="26" style="v" />tkyaqil q'ij npon tk'u'j ex nlab'ti.</para>
  <para style="q">Aye'tzunkye' tnik'alkyi'j nche tzalaj tu'n kyoyin.</para>
  <para style="b" />
  <para style="q">
    <verse number="27" style="v" />Nche tik'o'nte Dyos chojb'il kyu'n xjal b'inchal taq'wix,</para>
  <para style="q">qu'n inxi' kq'o'n tuk'i'l taq'wix nab'l.</para>
  <para style="b" />
  <para style="q">
    <verse number="28" style="v" />Aju' myab'a'n tziyal ati tu'n tkyim,</para>
  <para style="q">Atzunju' b'a'n tziyal ati tyol te kolb'il.</para>
  <para style="b" />
  <para style="q">
    <verse number="29" style="v" />Noktq'o'ntib'ju' b'inchal myab'a'n kuxi'xtej majx tnik'alti'j;</para>
  <para style="q">atzunte' tnik'alti'j q'uqlixi'x tk'u'j qa nanq'in b'a'n.</para>
  <para style="b" />
  <para style="q">
    <verse number="30" style="v" />Mixti'te nab'l, k'atztwi' ex b'a'n yol</para>
  <para style="q">majxwit nim toklen twitz Dyos.</para>
  <para style="b" />
  <para style="q">
    <verse number="31" style="v" />Aye'kye xjal inb'aj knk'u'n ju' kychej tu'n kb'jex toj q'oj,</para>
  <para style="q">atzunte Qajaw inq'onte kyipumal tu'n kykanb'an.</para>
  <chapter number="22" style="c" />
  <para style="q">
    <verse number="1" style="v" />Ate' tb'anilxi'xju' aju' b'a'n qb'injtz kyetwitz ati txqan qq'inumal,</para>
  <para style="q">exju' qyolinjtz kyetwitz txqan q'anpwaq ex saqpwaq.</para>
  <para style="b" />
  <para style="q">
    <verse number="2" style="v" />Junx kyoklenju' q'inun exju' prow</para>
  <para style="q">qu'n a Qman Dyos b'inchankye kykab'il.</para>
  <para style="b" />
  <para style="q">
    <verse number="3" style="v" />Aju' ati tnab'l ajtkub' tq'o'ntib' jun ti'xti' toj tb'e te joyb'ilti'j inximan nejtl ex inel tpa'ntib' ti'j;</para>
  <para style="q">atzunte' mixti' tnab'l mixti'x inximan ex ajtna'nte atitl toj yajb'il.</para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" />Aju' me'sb'il exju' ninb'ilte Dyos</para>
  <para style="q">inche tzaj tq'o'n oyaj, q'inumal, chwinqlal ex oklenj.</para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" />Aju' xjal b'inchal myab'a'n nim ti'xti' taq'wix tkub' toj tb'e;</para>
  <para style="q">atzunju' intk'u'jla'n tchwinqlal in kumin te tkyaqil lu.</para>
  <para style="b" />
  <para style="q">
    <verse number="6" style="v" />Xnaq'tzamju'ya k'wal tu'n b'a'n nab'l kyoju' tq'ijlalil ja'lo,</para>
  <para style="q">kse'nku'tzun aj ttijin lay tz'el tpa'ntib' ti'j.</para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" />Kxolju' prowqe', ate' q'inun in kawin;</para>
  <para style="q">exju' ajk'as nnok te tmajenju' q'ol majen.</para>
  <para style="b" />
  <para style="q">
    <verse number="8" style="v" />Alkyete nb'inchan taq'wix ex taq'wixil ktk'ma' te tu'me'l t-xel;</para>
  <para style="q">¡ate Dyos kb'el xitunte tu'n ttze te oklenj tk'i' ttx'u'jil!</para>
  <para style="b" />
  <para style="q">
    <verse number="9" style="v" />K'i'wla'nte' xjal inlaqjtk'u'j ti'j juntl</para>
  <para style="q">ex tu'nju' inkub' taq'pun twa kxolju' prow.</para>
  <para style="b" />
  <para style="q">
    <verse number="10" style="v" />Xla'jamixju'ya xjal kuw xmayin, kse'nku'tzun mixti'tl xitb'il kxole'</para>
  <para style="q">ex tu'n tb'aj ju' ik'jtib'il ex q'oj.</para>
  <para style="b" />
  <para style="q">
    <verse number="11" style="v" />Nche tk'u'jla'n nimaqkawilju' xjal ẍtilun kyanmi,</para>
  <para style="q">ex nokju' xjal nyolin tuk'i'l aq'b'il chjonte te tuk'i'l.</para>
  <para style="b" />
  <para style="q">
    <verse number="12" style="v" />Ate Dyos nxq'uqin ti'ju' xjal ati tnab'l</para>
  <para style="q">ex inb'aj tchuksa'n kximju' b'inchal myab'a'n, ju' in kyej b'entti'j kyu'n.</para>
  <para style="b" />
  <para style="q">
    <verse number="13" style="v" />aju' ky'aj noqx tu'n lalun tz'aq'unan inkub' t-xima'n txqan ti'xti'</para>
  <para style="q">lay chinxwe' aq'unal qu'n qaj sokyal jun b'alun nwitze' ex jaku' chinxtch'yo'ne'.</para>
  <para style="b" />
  <para style="q">
    <verse number="14" style="v" />Iky ttzi qya ajpajil kse'n jun xoch nimin t-xe</para>
  <para style="q">janche b'ajku'x tz'aqa' xjal intx'u'jin Dyos kyi'j.</para>
  <para style="b" />
  <para style="q">
    <verse number="15" style="v" />Xnakil ati toj tanmiju' ku'xun,</para>
  <para style="q">oktzun k'elil tu'n jun tzak'b'il tk'i' asyal.</para>
  <para style="b" />
  <para style="q">
    <verse number="16" style="v" />Alkyete' inkub' tyaju'n prow noqx tu'n tjaw q'inumax</para>
  <para style="q">mujqa matz'onin tuk'i'lju' q'inun kb'el prowix.</para>
  <para style="s1">Aye' junaq lajoj q'unb'en kyu'n ati kynab'l</para>
  <para style="q">
    <verse number="17" style="v" />Q'ontza anb'il ex b'inku'ya q'unb'en kyu'n ati kynab'l;</para>
  <para style="q">ximana ti'ju' kxe'l nxnaq'tza'ne' teya.</para>
  <para style="q">
    <verse number="18" style="v" />Ktzalajela ti'j qama tk'u'ya toj tnab'la</para>
  <para style="q">ex tu'n tb'ent tjaw tma'na kse'n nojqelan.</para>
  <para style="q">
    <verse number="19" style="v" />Che kxe'l nchik'b'a'ne' teya ja'lo</para>
  <para style="q">tu'n tokqe tk'u'ja ti'j Qman Dyos.</para>
  <para style="b" />
  <para style="q">
    <verse number="20" style="v" />E'kub' ntz'ib'a'ne' junaqlajoj q'unb'en teya</para>
  <para style="q">ati nab'l ex ojtzqib'l kyoj,</para>
  <para style="q">
    <verse number="21" style="v" />Tu'n t-xnaq'tzeta tu'n teltnik'a ti'ju' ax,</para>
  <para style="q">tu'ntzun tq'onteya jun b'a'n tqanil te jun xjal qama tqani teya.</para>
  <para style="s2">- 1 -</para>
  <para style="q">
    <verse number="22" style="v" />Lalun kub' t-sb'u'na prow naq tu'n toj tq'ob'a ta',</para>
  <para style="q">ex lalun kub' tyaju'na xjal mixti' klolte kywitz ajkawil.</para>
  <para style="q">
    <verse number="23" style="v" />qu'n aku' Qman Dyos kklolte</para>
  <para style="q">ex che b'eltyaju'nju' xjal ate'k yajulte.</para>
  <para style="s2">- 2 -</para>
  <para style="q">
    <verse number="24" style="v" />Lalun tz'uk'ilana kyuk'ilju' kuw kytx'u'jil</para>
  <para style="q">ex lalun b'eta junx kyuk'i'lju' mya'lqe'.</para>
  <para style="q">
    <verse number="25" style="v" />qu'n jaku' tz'el tkno'na tu'me'l kse'n che anq'in myab'a'n</para>
  <para style="q">ex jaku' axa kub'jtz'onte tqula.</para>
  <para style="s2">- 3 -</para>
  <para style="q">
    <verse number="26" style="v" />Lalun kyej tq'o'ntib'a</para>
  <para style="q">tjaq' tk'as juntl xjal,</para>
  <para style="q">
    <verse number="27" style="v" />qana' mixti'tl tu'me'l tu'n tchjet tu'na,</para>
  <para style="q">expe' jaku' tz'el iq'i'n tkuẍb'ila te chojb'ilte.</para>
  <para style="s2">- 4 -</para>
  <para style="q">
    <verse number="28" style="v" />Lalun tch'exb'eju'ya nqach</para>
  <para style="q">ju' kyejni q'o'n kyu'n ojtxi' tchmana.</para>
  <para style="s2">- 5 -</para>
  <para style="q">
    <verse number="29" style="v" />Alkyete ntb'incha'n taq'un b'a'n,</para>
  <para style="q">ktenb'el ajb'el kye nimaqkawil</para>
  <para style="q">mya ajb'el te jun xjalxi'.</para>
  <chapter number="23" style="c" />
  <para style="s2">- 6 -</para>
  <para style="q">
    <verse number="1" style="v" />Qama txkonjtza wal tja jun xjal ati toklen,</para>
  <para style="q">ximana b'a'nxi'x alqk'etz q'uqla'ya.</para>
  <para style="q">
    <verse number="2" style="v" />B'a'nqa nq'aq'ana,</para>
  <para style="q">jk'um tib'a ti'j twaya;</para>
  <para style="q">
    <verse number="3" style="v" />Lalun jaw tzalaja ti'ju' t-xilel wab'j tb'anil tka'yinx lu,</para>
  <para style="q">qu'n naq tka'yinkyte'.</para>
  <para style="s2">- 7 -</para>
  <para style="q">
    <verse number="4" style="v" />Lalun majx tz'ok ye'ya ti'ju' q'inumal;</para>
  <para style="q">tenx tnab'la, lalun b'ajx tk'u'ja ti'j.</para>
  <para style="q">
    <verse number="5" style="v" />Qama tz'el tnik'a b'a'nxi'x, naqch'i'n toka'te' q'inumal;</para>
  <para style="q">qu'n naqx minab'en ajt-xi lik'ik'in kse'n q'anjel.</para>
  <para style="s2">- 8 -</para>
  <para style="q">
    <verse number="6" style="v" />Lalun tz'okqeya ti'j tmes jun xjal ẍk'u'ẍ,</para>
  <para style="q">lalun jaw tzalaja ti'ju' t-xilil twa,</para>
  <para style="q">
    <verse number="7" style="v" />Qu'n mya tu'n tkyaqil tk'u'j ntxokona',</para>
  <para style="q">qu'n majx nka'yin se'n kwaliya;</para>
  <para style="q">
    <verse number="8" style="v" />atzu'n twaya xb'aj kb'jawil t-xa'ntla</para>
  <para style="q">mixti'x soka'te' ttzalajb'ila tuk'i'l.</para>
  <para style="s2">- 9 -</para>
  <para style="q">
    <verse number="9" style="v" />Lalun txitq'o'na kynab'lju' xnak,</para>
  <para style="q">qu'n naq kjawil xmayin ti'ju' tnab'l kxe'ltq'o'na.</para>
  <para style="s2">- 10 -</para>
  <para style="q">
    <verse number="10" style="v" />Lalun tch'exb'eju'ya ojtxi' nqach,</para>
  <para style="q">ex lalun kub' ttzyu'na kytx'otx' meb'a,</para>
  <para style="q">
    <verse number="11" style="v" />Qu'n aye'kye' lu ati jun onilkye nimtipumal</para>
  <para style="q">ex ate kyklolkye twitza.</para>
  <para style="s2">- 11 -</para>
  <para style="q">
    <verse number="12" style="v" />Xonk tk'u'ja ex q'onk tnab'la</para>
  <para style="q">ti'ju' xnaq'tzb'il ex kyi'ju' ojtzqib'l.</para>
  <para style="s2">- 12 -</para>
  <para style="q">
    <verse number="13" style="v" />Tzak'umju'ya ku'xun,</para>
  <para style="q">lay kyimte' tu'n jun k'iẍlob';</para>
  <para style="q">
    <verse number="14" style="v" />Ape'na' qama ttzak'uya,</para>
  <para style="q">kkletel tu'na te kamik.</para>
  <para style="s2">- 13 -</para>
  <para style="q">
    <verse number="15" style="v" />Nk'yajul ajtok tnab'la,</para>
  <para style="q">ayinwe' chin tzalajel b'a'nxi'x;</para>
  <para style="q">
    <verse number="16" style="v" />Ok nna' junwe' tzalajb'il nimxi'x toj wanmiye'</para>
  <para style="q">ajt-xi' nb'i'ne' nyolina tojxi'x tu'me'l.</para>
  <para style="s2">- 14 -</para>
  <para style="q">
    <verse number="17" style="v" />Lalun tx'a'lti'jtk'u'ja kyi'ju' b'inchal il;</para>
  <para style="q">nima'nkpete'ya Qman Dyos kukxju';</para>
  <para style="q">
    <verse number="18" style="v" />Oktzun ktenb'il tchwinqlaltzu'ya</para>
  <para style="q">ex ttzalajb'ila kukxju'.</para>
  <para style="s2">- 15 -</para>
  <para style="q">
    <verse number="19" style="v" />B'inkuya b'a'nxi'x nk'yajul ex knoma;</para>
  <para style="q">q'onk tilila tu'n txi' lpeya ti'ju' b'a'n b'e.</para>
  <para style="q">
    <verse number="20" style="v" />Lalun tz'uk'ilana kyuk'i'l twi' tx'ojtel,</para>
  <para style="q">expe' ikx kyuk'i'lju' tzeq,</para>
  <para style="q">
    <verse number="21" style="v" />Qu'n aye'kye' tx'ujtenil exqe' tzeq-qe' kche b'el yajti,</para>
  <para style="q">ikxqe' ky'ejqe' kb'el ẍla'qix kyi'j.</para>
  <para style="s2">- 16 -</para>
  <para style="q">
    <verse number="22" style="v" />Ka'yinx tmana ex ttxuya;</para>
  <para style="q">lalun che eltik'u'na aj kytijin, qu'n aye' ch'isalteju'ya.</para>
  <para style="q">
    <verse number="23" style="v" />Q'onktililju'ya ax ex nab'l,</para>
  <para style="q">xnaq'tzb'il ex tz'okxa k'atz, ¡lalun tz'el tpa'ntib'a kyi'j!</para>
  <para style="q">
    <verse number="24" style="v" />Jun b'a'n k'walb'aj ex ati tnab'l</para>
  <para style="q">tu'me'lx tu'n kytzalaju' tman ti'j;</para>
  <para style="q">
    <verse number="25" style="v" />¡Atzun b'inchamju'ya, tu'ntzun ttzalaj tmana ex ttxuya ti'ja!</para>
  <para style="s2">- 17 -</para>
  <para style="q">
    <verse number="26" style="v" />Chin tb'inku'ya nk'yajul,</para>
  <para style="q">ex ka'yinka b'a'nxi'x aju' in nb'incha'ne';</para>
  <para style="q">
    <verse number="27" style="v" />Qu'n ikyte qya eqch exju' ajpajil</para>
  <para style="q">kse'n jun xoch nim t-xe;</para>
  <para style="q">
    <verse number="28" style="v" />Ikyqe' kse'nqe' eleq' jutzliqe' ka'yilkye xjal,</para>
  <para style="q">ex nim ichan nche' tzpet kyu'n.</para>
  <para style="s2">- 18 -</para>
  <para style="q">
    <verse number="29" style="v" />¿Alkyetzu'n kyajtel? ¿Alkye kyt'i'njne? ¿Alkyetzu'n nq'ojin ex alkye noq'?</para>
  <para style="q">¿Alkyetzun nb'iyli extzun mixti' til?</para>
  <para style="q">¿Alkye nkub' yupj tuk'i'l?</para>
  <para style="q">
    <verse number="30" style="v" />Aye'ju' xjal min kyej kyk'wan q'e'n</para>
  <para style="q">ex nb'aj ksmo'n chukchaq q'e'n.</para>
  <para style="q">
    <verse number="31" style="v" />Aya q'a, lalun pon tk'u'ja ti'ju' k'waj q'e'n.</para>
  <para style="q">¡Nakuj ẍq'an twitz aj kux qo'n toj tkb'el!</para>
  <para style="q">¡majx tb'anil tka'yinx!</para>
  <para style="q">
    <verse number="32" style="v" />Tetzun b'ajsb'il kuw tchib'l</para>
  <para style="q">kse'n naqa xqo' oktx'a'n tu'n jun kan.</para>
  <para style="q">
    <verse number="33" style="v" />Milchaqx toj twitza k'okyel,</para>
  <para style="q">kb'el yupj tuk'ila, ti'xlo tyol loya;</para>
  <para style="q">
    <verse number="34" style="v" />Chiloya qa atiya nky'ajchaq ninnjab'</para>
  <para style="q">ex naku'j tokxa twi' jun nin tze,</para>
  <para style="q">
    <verse number="35" style="v" />Ktma'ya:</para>
  <para style="q">Machin b'ajb'yone', ex minti' xna'ye';</para>
  <para style="q">machin b'aj jikune', ex minti' xwile';</para>
  <para style="q">ajtzun ttzaj nna'n wib'e'</para>
  <para style="q">kchin xe'le' jyol txqantl q'e'n.</para>
  <chapter number="24" style="c" />
  <para style="s2">- 19 -</para>
  <para style="q">
    <verse number="1" style="v" />Lalun pon tk'u'ja kyi'ju' b'inchal myab'a'n</para>
  <para style="q">ex lalun tmujb'a tib'a kyuk'i'l.</para>
  <para style="b" />
  <para style="q">
    <verse number="2" style="v" />Qu'n o'kxtzu' nche' ximana' tu'n kyb'ujun</para>
  <para style="q">ex o'kx nkyoli'n, tu'n b'inchan myab'a'n.</para>
  <para style="s2">- 20 -</para>
  <para style="q">
    <verse number="3" style="v" />Tuk'i'l nab'l njaw b'incheta' jun ja,</para>
  <para style="q">ex tuk'i'l xim nku'x b'incheta' tq'uqlil;</para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" />Ex tu'n ojtzqib'l nb'aj noja' kyoju' ja.</para>
  <para style="q">kyu'n txqan ti'xti' nimaq kyoklen ex tb'anilqe'.</para>
  <para style="s2">- 21 -</para>
  <para style="q">
    <verse number="5" style="v" />Ate b'a'n jun ichan ati tnab'l kyetwitz jun ichan kuw;</para>
  <para style="q">ate b'a'n ojtzqib'l kyetwitz ipumalj.</para>
  <para style="b" />
  <para style="q">
    <verse number="6" style="v" />Qu'n qama txi'ya q'ojil ati tu'n t-ximana</para>
  <para style="q">nojqelan tu'n txi' tjyona tu'me'l tu'n tkanb'ana.</para>
  <para style="s2">- 22 -</para>
  <para style="q">
    <verse number="7" style="v" />Majx njpet ttziju' xnak ajtpon twitz kawil,</para>
  <para style="q">qu'n najchaq ta' ti'ju' ojtzqib'l.</para>
  <para style="s2">- 23 -</para>
  <para style="q">
    <verse number="8" style="v" />Alkyete noq nximan taq'uxil,</para>
  <para style="q">a tb'iju' nok q'o'n (taq'wix tnab'l).</para>
  <para style="q">
    <verse number="9" style="v" />A tnab'l xnakju' tu'n txi' b'inchal il;</para>
  <para style="q">mix-alo'xte' in ik'xtu'n tu'n tten tk'etzju' xjal twi'xmayil.</para>
  <para style="s2">- 24 -</para>
  <para style="q">
    <verse number="10" style="v" />Alkyete' nkub'numj ajttzaju' yajb'il,</para>
  <para style="q">na'ntzun ch'i'n tokslab'l tzu'.</para>
  <para style="s2">- 25 -</para>
  <para style="q">
    <verse number="11" style="v" />Klomqeya xjal xi' kxi' toj kamik;</para>
  <para style="q">tzaqpimqeya xjal ate'k twitz kamik.</para>
  <para style="b" />
  <para style="q">
    <verse number="12" style="v" />B'a'n qama tmaya qa mixti' tila;</para>
  <para style="q">mana' tz'ilwiya tu'nju' ojtzqil qanmi;</para>
  <para style="q">ex xq'uqilteya</para>
  <para style="q">aju' tzul chjonte teyele kse'nxju' taq'unb'en.</para>
  <para style="s2">- 26 -</para>
  <para style="q">
    <verse number="13" style="v" />Wana, q'a, ti'ju' ta'lkab' chi';</para>
  <para style="q">Nik'b'enxpe'ya tk'ok'jalxi'x.</para>
  <para style="b" />
  <para style="q">
    <verse number="14" style="v" />Ikytzu'n tchi'yal nab'lju' exju' ojtzqib'l;</para>
  <para style="q">qama knet tu'na, b'a'ntzun kxela'tza</para>
  <para style="q">jumajxtzun kqeb'il tk'u'jtza.</para>
  <para style="s2">- 27 -</para>
  <para style="q">
    <verse number="15" style="v" />Lalun kub' t-xima'na jun ti'xti' myab'a'n ti'ju' tnik'alti'j,</para>
  <para style="q">ex lalun che b'je'x telq'ana toj tja.</para>
  <para style="b" />
  <para style="q">
    <verse number="16" style="v" />Qu'n maskye wuq maj xkub' tz'aq, wuq maj kjawil we';</para>
  <para style="q">aye'tzunkye' b'inchal myab'a'n majx nche'x toj il.</para>
  <para style="s2">- 28 -</para>
  <para style="q">
    <verse number="17" style="v" />Lalun tzalaja ajtkub' tz'aqu' tajq'oja</para>
  <para style="q">ex lay tzalaj tanmiya aj txi' toj il,</para>
  <para style="q">
    <verse number="18" style="v" />Qu'n lay tzalaj Dyos ajtka'yinte ja'lu,</para>
  <para style="q">jaku' tib'aja kub'a tz'aqxju' ttx'u'jil.</para>
  <para style="s2">- 29 -</para>
  <para style="q">
    <verse number="19" style="v" />Lalun tx'u'jina kyeju' b'inchal myab'a'n</para>
  <para style="q">expe' lalun tx'a'lti'j tk'u'ja kyi'j,</para>
  <para style="b" />
  <para style="q">
    <verse number="20" style="v" />Qu'n myab'a'n kjapumela' b'ajte' tchwinqlal:</para>
  <para style="q">¡kyupjelte' b'inchal myab'a'n ttxa'n kytzaj!</para>
  <para style="s2">- 30 -</para>
  <para style="q">
    <verse number="21" style="v" />Nk'yajul nimana te Dyos ex kye nimaqkawil,</para>
  <para style="q">lalun tmujb'a tib'a kyuk'i'l ajq'oj,</para>
  <para style="b" />
  <para style="q">
    <verse number="22" style="v" />qu'n minab'enx ajttzaj xitb'il kyib'aj,</para>
  <para style="q">mix-a'loxte b'ilte se'n kb'ajila'.</para>
  <para style="s1">Jte'tl yol b'aj q'ma'n kyu'nju' ajnab'lil</para>
  <para style="p">
    <verse number="23" style="v" />Ikx aye'ju' yol lu q'ma'nqe' kyu'n ajna:</para>
  <para style="b" />
  <para style="q">Myab'a'n qa naq te jun nb'incheta' kawb'il.</para>
  <para style="q">
    <verse number="24" style="v" />Aju' kawil qama tz'oktq'o'n mixti' tilju' nimaq til,</para>
  <para style="q">k'elil ik'u'n kyu'n tnam ex kb'ajel yasu'n;</para>
  <para style="q">
    <verse number="25" style="v" />Qatzun nche kawin tojxi'x tnik'alti'j</para>
  <para style="q">nxi' qani'n ky'i'wb'il kyib'aj kyu'n xjal.</para>
  <para style="b" />
  <para style="q">
    <verse number="26" style="v" />Aju' b'a'n tzaq'web'l</para>
  <para style="q">iky nela' kse'n qma'tz.</para>
  <para style="b" />
  <para style="q">
    <verse number="27" style="v" />Nk'uma kkyaqilju' k'ajb'el teya</para>
  <para style="q">ex b'inchanxa taq'una toj kojb'il</para>
  <para style="q">b'inchanktzun tjatzuya.</para>
  <para style="b" />
  <para style="q">
    <verse number="28" style="v" />Lalun jawtiq'i'n jun yola ti'j twnaqila</para>
  <para style="q">ex lalun chanyola ti'j.</para>
  <para style="b" />
  <para style="q">
    <verse number="29" style="v" />Lalun taq' tu'me'l t-xela te juntl,</para>
  <para style="q">tu'nwt tb'inchanteya kse'n xb'inchanjtz teya.</para>
  <para style="b" />
  <para style="q">
    <verse number="30" style="v" />Mawile' ttx'otx'ju' ky'aj</para>
  <para style="q">ex tawalju' xnak xjal:</para>
  <para style="q">
    <verse number="31" style="v" />Noqx txqan ch'i'x matx tzaj b'ent toj,</para>
  <para style="q">ex matzaj juptz'aj txqan itzaj toj jni'ju' ttapi ti'jile matx tzaj tilj.</para>
  <para style="q">
    <verse number="32" style="v" />Tej nka'yinteye', majx kyej toj nwi'ye'</para>
  <para style="q">wile' ex el jun nnab'le' ti'j;</para>
  <para style="b" />
  <para style="q">
    <verse number="33" style="v" />naq tu'n ch'i'n qama tzajtwatla</para>
  <para style="q">exqa makub' tchle'n tq'ob'a,</para>
  <para style="q">
    <verse number="34" style="v" />Tzul prowil ex k'okyel tzaqpaj ti'ja</para>
  <para style="q">kse'n jun eleq' iq'i'n tq'aq'.</para>
  <chapter number="25" style="c" />
  <para style="s1">Tkab' tnej yol q'ma'n tu'n Salomon</para>
  <para style="p">
    <verse number="1" style="v" />Ati jte'tl q'unb'en tu'nx Salomon, tz'ib'a'nqe' kyu'n ajb'el te Esekyiy, nimaqkawil aj Juda:</para>
  <para style="b" />
  <para style="q">
    <verse number="2" style="v" />Injaw nimet Qman Dyos tu'nju' e'wa'n tu'n,</para>
  <para style="q">aye'tzu'n nimaqkawil tu'nju' noktilil kyu'n tu'n tchik'e jun ti'xti'.</para>
  <para style="b" />
  <para style="q">
    <verse number="3" style="v" />Ale'xju' twitz kya'j,</para>
  <para style="q">ex toj tk'u'j tx'otx',</para>
  <para style="q">ex ikxju' kyxim nimaqkawil.</para>
  <para style="q">layx che kane toj qwitz.</para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" />Qama b'je'l ttz'ililju' saqpwaq,</para>
  <para style="q">kb'antel jun tb'anil ti'xti' tu'n aq'unal ti'j saqpwaq;</para>
  <para style="q">
    <verse number="5" style="v" />Qama tz'el iq'etju' b'inchal myab'a'n toju' ajb'eb'l te nimaqkawil,</para>
  <para style="q">kb'antel jun kawb'il tnik'alti'j.</para>
  <para style="b" />
  <para style="q">
    <verse number="6" style="v" />Lalun tnima tib'a twitzju' nimaqkawil,</para>
  <para style="q">ex lalun kub' qeya toj kyq'a'jtzu' xjal nim kyoklen;</para>
  <para style="q">
    <verse number="7" style="v" />Ate' b'a'nju' qama jawx txko'na tu'n,</para>
  <para style="q">kyetwitz tu'n txiq'ma'n teya tu'n txitq'o'na tq'uqb'ila te juntl nimaqxi'x toklen.</para>
  <para style="b" />
  <para style="q">Qama tila jun ti'xti' kyu'nku' twitza.</para>
  <para style="q">
    <verse number="8" style="v" />lalun txi'naja q'malte lwiyxi'x twitz kawb'il,</para>
  <para style="q">qu'n jaku' pon juntl tziyal chik'b'alte se'nxi'x tu'me'l</para>
  <para style="q">jaku'tzun naq jawka'ylajtla.</para>
  <para style="b" />
  <para style="q">
    <verse number="9" style="v" />Yolina tuk'ilju' xjal ati jun myab'a'n kyxole' tuk'i'l, tu'n lalun txi' toj nim,</para>
  <para style="q">ex lalun txi' tyoli'na nxitjask'u'n juntl teya;</para>
  <para style="b" />
  <para style="q">
    <verse number="10" style="v" />qu'n kb'injtzela kyu'n kykyaqil xjal,</para>
  <para style="q">qa layx b'ent tewanteya jun ti'xti' ex k'elel ik'o'na tejumajx.</para>
  <para style="b" />
  <para style="q">
    <verse number="11" style="v" />Jun yol tojxi'x tu'me'l toju' kmuj ja nojqelana',</para>
  <para style="q">nok kse'n mansan q'anpwaq, saqpwaq ka'yin.</para>
  <para style="q">
    <verse number="12" style="v" />Ikyte tzak'b'ilju' kse'n u'wj q'anpwaqxi'x,</para>
  <para style="q">teju' xjal b'a'n tk'monte.</para>
  <para style="b" />
  <para style="q">
    <verse number="13" style="v" />Aju' b'a'n sanjelal</para>
  <para style="q">nok kse'n jun chewsb'il ti'j qanmi toj q'ijal,</para>
  <para style="q">majx ntzalaju' tajaw ti'j. <verse number="14" style="v" />Aju' xjal in tla'ji'n tib' qa noyin extzun naqxtak'u'n,</para>
  <para style="q">ikxi'xu' kse'n txqan muj ajttzaj tenenen mixti'xte' jb'al.</para>
  <para style="b" />
  <para style="q">
    <verse number="15" style="v" />Qati qpasensi nkub'ti'j jun kawb'il qu'n;</para>
  <para style="q">exju' yol toj ttxolilti'j, chab'ax nkub' qk'u'j tu'n.</para>
  <para style="b" />
  <para style="q">
    <verse number="16" style="v" />Qama tz'okyal ta'lkab' tu'na, lalun tz'ok k'e'ya ti'j,</para>
  <para style="q">qu'n jaku' xab'tla tu'n.</para>
  <para style="q">
    <verse number="17" style="v" />lalun txi'ya q'achq'al tja tamiwa,</para>
  <para style="q">jaku' sikti ex k'elel ik'una tu'n.</para>
  <para style="b" />
  <para style="q">
    <verse number="18" style="v" />Aju' nchan yol ti'ju' tamiw,</para>
  <para style="q">¡majx nk'ixb'san kse'n jun mans, qesb'il ex kse'n jun smaj ch'ut twi'!</para>
  <para style="b" />
  <para style="q">
    <verse number="19" style="v" />Tu'n tqe qk'u'j ti'j jun xjal ẍmu toj tq'ijlalil yajb'il,</para>
  <para style="q">ikju' kse'n nqo' b'et toqjni qqan</para>
  <para style="q">mujqa kse'n nch'yon jun qwitzte.</para>
  <para style="q">
    <verse number="20" style="v" />Myab'a'n tu'n tkub' tal chnab' te jun xjal nb'isun</para>
  <para style="q">ikju' kse'n ta'l atz'an nok twitz k'ixb'ni</para>
  <para style="q">mujqa kse'n qama qokub' ẍb'iqe toj tq'ijlalil txun che'w.</para>
  <para style="b" />
  <para style="q">
    <verse number="21" style="v" />Qa nq'aq'an tajq'oja, q'onxa twa;</para>
  <para style="q">exqa nk'wajti, q'onxa tk'wa';</para>
  <para style="q">
    <verse number="22" style="v" />qu'n qama tb'inchaya ikju', kb'el kyeqax tu'n tch'ixaw twitza,</para>
  <para style="q">atzunte' Dyos kq'olte tu'me'l t-xel teya.</para>
  <para style="b" />
  <para style="q">
    <verse number="23" style="v" />Qa ntzaj kyq'iq' toj qnayaj ntzaj jb'al,</para>
  <para style="q">ex tu'nju' jk'ujyolil ntzaj qtx'u'jil.</para>
  <para style="b" />
  <para style="q">
    <verse number="24" style="v" />B'a'npete' tu'n qnajan toj jun ja xoq'l t-xe,</para>
  <para style="q">kyetwitz tu'n qnajan toj jun nin ja tb'anilxi'x tuk'i'l jun qya txinwi'.</para>
  <para style="b" />
  <para style="q">
    <verse number="25" style="v" />Iky nela' jun b'a'n tqanilju' kyi'j najchaq tx'otx'</para>
  <para style="q">kse'n tb'anil che'wa' qa nqo k'wajti.</para>
  <para style="b" />
  <para style="q">
    <verse number="26" style="v" />Qa njawje jun tnik'alti'j twitz jun xjal b'inchal myab'a'n</para>
  <para style="q">iky noka' kse'n t-xiklil a' xoq'l twitz ex tz'il.</para>
  <para style="b" />
  <para style="q">
    <verse number="27" style="v" />Myab'a'n qa nb'aj txqan ta'lkab' qu'n,</para>
  <para style="q">ate tu'me'lju' qa ch'uẍ nkub'a' ti'j jun ti'xti' qu'n.</para>
  <para style="b" />
  <para style="q">
    <verse number="28" style="v" />Ikyte xjalju' min nb'ent tjk'unte tib',</para>
  <para style="q">kse'n jun nintnam mixti' nintapi ti'jile.</para>
  <chapter number="26" style="c" />
  <para style="q">
    <verse number="1" style="v" />Myab'a'n qa nkub' che'w toj jb'alil</para>
  <para style="q">ex myab'a'n qama kub' jb'al toj q'ijal</para>
  <para style="q">ikyxtzun xnakju' myab'a'n tu'n tjaw nimet.</para>
  <para style="b" />
  <para style="q">
    <verse number="2" style="v" />kse'n jun tz'unin tzpetni mujqa mixti' tpaqb'il,</para>
  <para style="q">iktzu'n qanb'ilju' lay pon kanun ti'ju' xjal mixti' til.</para>
  <para style="b" />
  <para style="q">
    <verse number="3" style="v" />Jun chej nxla'jit tu'n k'iẍlob',</para>
  <para style="q">atzunju' kuwchej njk'et tu'n k'uxb'il toj ttzi</para>
  <para style="q">ikxtzun xnakju' nkawit tu'n asyal.</para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" />Lalun txitmujtza'na xnak,</para>
  <para style="q">qu'n qama txittzaq'we'na jaku' tz'ela junx tuk'i'l.</para>
  <para style="q">
    <verse number="5" style="v" />Chik'b'anxa tb'inchb'enju' xnak,</para>
  <para style="q">tu'ntzun lalun tnimatib'.</para>
  <para style="b" />
  <para style="q">
    <verse number="6" style="v" />Qama txi' qq'o'n jun qsanjel te jun xtrak</para>
  <para style="q">layx pon tuk'i'l naqpe' nok te joyb'il q'oj</para>
  <para style="q">naku'j matz'el jun twi' qqan.</para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" />Jun xjal kox nqaku' nb'eta'</para>
  <para style="q">iktzun q'unb'enju' kyu'n xjal xnak.</para>
  <para style="b" />
  <para style="q">
    <verse number="8" style="v" />Mixti'x qnab'l qama tz'ok qk'lo'n ab'j ti'ju' chik'tze</para>
  <para style="q">ikxtzun tz'ela' qama txiqq'o'n ninb'ilte jun xnak.</para>
  <para style="b" />
  <para style="q">
    <verse number="9" style="v" />Jun tx'ujtenil mixti' ntna'nju' ch'i'x,</para>
  <para style="q">ikxtzun xnakju' mixti'x noku' q'unb'en toj twi'.</para>
  <para style="b" />
  <para style="q">
    <verse number="10" style="v" />Nxonju' ajsmajil kyi'j alkyechaqx xjal nche ik'</para>
  <para style="q">iky nela' kse'n jun xjal nxitk'le'n xnak tja.</para>
  <para style="b" />
  <para style="q">
    <verse number="11" style="v" />Aju' tx'yan nanjtl ti'j leq'ulte t-xab'</para>
  <para style="q">iktzun xnakju' ilti'j nxi' b'inchal il.</para>
  <para style="b" />
  <para style="q">
    <verse number="12" style="v" />Layx qe qk'u'j ti'j jun xjal xnak</para>
  <para style="q">mitzunyate' jun xjal nxi'x tnima'ntib' qa ati tnab'l.</para>
  <para style="b" />
  <para style="q">
    <verse number="13" style="v" />Aju' ky'ej noqx tu'n lalun tz'aq'unan ntma'n:</para>
  <para style="q">ati jun b'alun toj b'e inxq'uqin tu'n nxi' tch'yone'.</para>
  <para style="b" />
  <para style="q">
    <verse number="14" style="v" />Insutyanju' tjpel ja kyu'nju' tzuyb'ilte</para>
  <para style="q">ikxtzun ky'eju' nt-xtola'n tib' toj tkuẍb'il.</para>
  <para style="b" />
  <para style="q">
    <verse number="15" style="v" />Aju' ky'ej inpe' ttky'aji'n naqpe' tu'n twan.</para>
  <para style="b" />
  <para style="q">
    <verse number="16" style="v" />Aju' ky'aj a tyolju' qa nimxi'x tnab'l</para>
  <para style="q">kyekwitz wuq xjal.</para>
  <para style="b" />
  <para style="q">
    <verse number="17" style="v" />Qa nokx qq'o'nqib' toj kyq'oj txqantl</para>
  <para style="q">ikju' kse'n qama jaw qtzyu'n t-ẍkyin jun tx'yan.</para>
  <para style="b" />
  <para style="q">
    <verse number="18" style="v" />Ikyju' kse'n okni toj twi'</para>
  <para style="q">tok smajil ex xol ch'ut tu'n tb'iyun tuk'i'l q'aq'.</para>
  <para style="b" />
  <para style="q">
    <verse number="19" style="v" />Iktzun xjalju' nkub' t-sb'u'n tamiw</para>
  <para style="q">in tma'ntzuntz: noqtaq nchin yaqinwe'.</para>
  <para style="b" />
  <para style="q">
    <verse number="20" style="v" />Nkub' yupju' q'aq' qa min nokx pichk'et si,</para>
  <para style="q">ex in b'aj ttxa'nju' q'oj qa mixti' jk'ujyoli'n.</para>
  <para style="b" />
  <para style="q">
    <verse number="21" style="v" />In ajb'en sb'aq tu'n tkub' ttxalq'aq';</para>
  <para style="q">ex tu'n tkub' q'aq', najb'en si;</para>
  <para style="q">atzu'n tu'n qq'ojin, axixte' twi' q'ojil.</para>
  <para style="b" />
  <para style="q">
    <verse number="22" style="v" />Ikyte jk'ujyolil kse'n tzequl,</para>
  <para style="q">majxtzun nqo' b'o'lj tu'n.</para>
  <para style="b" />
  <para style="q">
    <verse number="23" style="v" />A tyolju' xmletz' majx tb'anilxi'x tb'inx</para>
  <para style="q">ikyju' kse'n tx'otx' xar uk'tza'nk tu'n saqpwaq.</para>
  <para style="b" />
  <para style="q">
    <verse number="24" style="v" />Aju' ntx'a'lti'j tk'u'j min tma'n ajtyolin,</para>
  <para style="q">atzun toj tanmi ati t-xim taq'wix.</para>
  <para style="q">
    <verse number="25" style="v" />Laluntzun txi' toksla'na qama tzaj yolin teya tk'i' tk'u'jlalil,</para>
  <para style="q">qu'n aju' tnab'l nojni tu'n txqan taq'wixil.</para>
  <para style="q">
    <verse number="26" style="v" />Maskyepe' min ntyek'u'n qa ntx'u'jin,</para>
  <para style="q">k'elil tnik'tzil kyu'n xjal.</para>
  <para style="b" />
  <para style="q">
    <verse number="27" style="v" />Alkyete' ntlku'n jul te kamik axte kb'elix tz'aq toj;</para>
  <para style="q">ex alkyete' ntolin ab'j twitz jawl tib'ajx ktzajela' tz'aq.</para>
  <para style="b" />
  <para style="q">
    <verse number="28" style="v" />Aju' chalyol nel tik'u'n ax,</para>
  <para style="q">exju' naq yoljne ntzaj ti'n xitb'il.</para>
  <chapter number="27" style="c" />
  <para style="q">
    <verse number="1" style="v" />Lalun b'ajx tk'u'ja ti'j ju' q'ij te najchi'j,</para>
  <para style="q">qu'n minti' b'i'n tu'na titi' tzultiq'i'n.</para>
  <para style="b" />
  <para style="q">
    <verse number="2" style="v" />Q'onxa anb'il kye txqantl tu'n tjaw nima'na kyu'n;</para>
  <para style="q">qu'n myab'a'n tu'n tjaw tnima'n tib'a.</para>
  <para style="b" />
  <para style="q">
    <verse number="3" style="v" />Al qekye' ab'j ex tz'awun,</para>
  <para style="q">mastzun alxi'xte' ttx'u'jilju' xnak.</para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" />Kuwxi'xte' tx'u'jilj exju' ik'jtib'il yajb'il,</para>
  <para style="q">atzunte' tx'a'lti'j k'u'jb'aj majx xob'ajilxi'x.</para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" />Nimxi'x toklenju' tzak'b'il axxi'x</para>
  <para style="q">kyetwitzju' tk'ujlali toj ewaj.</para>
  <para style="b" />
  <para style="q">
    <verse number="6" style="v" />B'a'nxi'x qama qo' tzak'unjtz tu'n qamiw</para>
  <para style="q">kyetwitz tu'n qoktz'u'li'n tu'n jun ajq'oj.</para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" />ate' min q'aq'in, mipe'jun nxi'tlte' ta'l tab' tu'n;</para>
  <para style="q">atzunte' xjal inxi'x q'aq'an tkyaqilu' ti'xti' b'lo'n tu'n.</para>
  <para style="b" />
  <para style="q">
    <verse number="8" style="v" />Aju' xjal nxi' najchaq</para>
  <para style="q">ikyju' kse'n pich' nlipan najchaq ti'jxi' tpaqb'il.</para>
  <para style="b" />
  <para style="q">
    <verse number="9" style="v" />Ikyte nela' jun nab'lju' ntzalaj qanmi ti'j;</para>
  <para style="q">kse'n k'ok'sb'il npuk'chaj b'a'n nela'.</para>
  <para style="b" />
  <para style="q">
    <verse number="10" style="v" />Lalun naqka'yina kyi'ju' tamiwa</para>
  <para style="q">mo kyi'ju' tamiw tmana.</para>
  <para style="b" />
  <para style="q">ex lalun txi'ya kyja ttzika</para>
  <para style="q">qama tzaj yajb'il ti'ja.</para>
  <para style="b" />
  <para style="q">ape'te b'a'nju' xjalxi' nqaku' tk'etza</para>
  <para style="q">kyetwitz jun twitz'ela najchaq.</para>
  <para style="b" />
  <para style="q">
    <verse number="11" style="v" />Tenx tnab'la nk'yajul, tzalajb'ilte';</para>
  <para style="q">b'a'n nyoljintze' kyu'n xjal.</para>
  <para style="b" />
  <para style="q">
    <verse number="12" style="v" />Ate' ati tnab'l ajtkub' tq'o'ntib' jun ti'xti' toj tb'e, nel tpa'ntib' ti'j;</para>
  <para style="q">atzunte' xjal min ximan ljo'nte' tb'e; ajtna'nte matxitoq kub' yajti.</para>
  <para style="b" />
  <para style="q">
    <verse number="13" style="v" />Q'inkj jun ti'xti'ya ti'j jun xjal qama tz'ok tziyal ch'ex, qa min tojtzqi'na.</para>
  <para style="b" />
  <para style="q">
    <verse number="14" style="v" />Myab'a'nte' naq nxit-ẍch'i'na tamiwa na'mxtoq tjawe',</para>
  <para style="q">xi' ktzajela' tx'u'jil ti'ja.</para>
  <para style="b" />
  <para style="q">
    <verse number="15" style="v" />Ikyte jun qya qa noq nẍalb'i</para>
  <para style="q">kse'n jun ja kukxju' ntxatjne toj jb'alil.</para>
  <para style="b" />
  <para style="q">
    <verse number="16" style="v" />Qama txiqmyo'n, naku'j qajb'il tu'n qwab'ante kyq'iq'</para>
  <para style="q">mujqa qajb'il tu'n tten aseyt toj tq'ob'.</para>
  <para style="b" />
  <para style="q">
    <verse number="17" style="v" />K'uxb'ilte' njqunte twitzte juntl k'uxb'il,</para>
  <para style="q">atzun jun xjal nok tnab'l tu'n t-xnaq'tzb'il juntl xjal.</para>
  <para style="b" />
  <para style="q">
    <verse number="18" style="v" />Alkyete' b'a'n ka'yin lob'j iw, klo'l ti'ju' twitz;</para>
  <para style="q">ikxtzun xjalju' qama txi' tka'yi'n taq'un tnejel, ktk'ma' oklenj.</para>
  <para style="b" />
  <para style="q">
    <verse number="19" style="v" />Toj a' q'ancha'l tilb'ilalju' xjal,</para>
  <para style="q">ikxqe'tzun xjalju' atzu' nela' knik'tzil tu'nju' kynab'l.</para>
  <para style="b" />
  <para style="q">
    <verse number="20" style="v" />Mixti'x nqe kyk'u'ju' kamik exju' muqb'il</para>
  <para style="q">ikxtzun xjalju' mixjun qen tu'n tjyon.</para>
  <para style="b" />
  <para style="q">
    <verse number="21" style="v" />Aju' q'anpwaq exju' saqpwaq atzu' nela' tnik'tzil toj q'aq';</para>
  <para style="q">atzunte' xjal atzu' nela' tnik'tzil qa b'a'n tyolinjtz.</para>
  <para style="b" />
  <para style="q">
    <verse number="22" style="v" />Layx kyej t-xonte' xnak t-xnakyil</para>
  <para style="q">b'a'nqa makub' tz'e'yset twitz kuw.</para>
  <para style="b" />
  <para style="q">
    <verse number="23" style="v" />Ka'yinqexju'ya trita,</para>
  <para style="q">ex xq'uqimqe'ya qa b'a'nile,</para>
  <para style="q">
    <verse number="24" style="v" />Qu'n aju' q'inumal exju' oklenj</para>
  <para style="q">min nten tejumajx.</para>
  <para style="q">
    <verse number="25" style="v" />Aj ttzajb'entju' chuẍq'e'n, ex ajtb'aj ẍlajunix,</para>
  <para style="q">ex ajkyb'uyitju' k'ul ex itzaj,</para>
  <para style="q">
    <verse number="26" style="v" />Kyi'ju' trita k'elil tlana tu'n tlq'et t-xb'aluna,</para>
  <para style="q">aye'tzunju' chib' tu'n tlq'et ttx'otx'a</para>
  <para style="q">
    <verse number="27" style="v" />Ex k'elil nim lech kyi'ju' tchib'a</para>
  <para style="q">teya ex kye tkyaqilju' toj tjaya ex ajb'el teya.</para>
  <chapter number="28" style="c" />
  <para style="q">
    <verse number="1" style="v" />Nkub' oqju' b'inchal myab'a'n maskye mix-a'lo' njyonte,</para>
  <para style="q">aye'tzunkye' tnik'alkyi'j nche anq'in q'uqli kyk'u'j kse'n jun b'alun.</para>
  <para style="b" />
  <para style="q">
    <verse number="2" style="v" />Qa myab'a'n ttenju' kawb'il toj tnam, mintzunte' tajb'il tu'n tkawin,</para>
  <para style="q">Atzunte' nejenel ati tnab'l tkyaqilju' ti'xti' inb'aj tnk'u'n.</para>
  <para style="b" />
  <para style="q">
    <verse number="3" style="v" />Ikyte prowju' nalq'an tijuntl prow</para>
  <para style="q">kse'n ajttzaj jun kyq'iq' jb'al ex majx nkub' yajti awal.</para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" />Nmuje kytzi nelkypa'n kyib' ti'ju' kawb'il kyuk'i'lju' b'inchal myab'a'n;</para>
  <para style="q">Aye'tzun njapun kyu'n min muje kytzi kyuk'i'l.</para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" />Min nkanete' tnik'alilti'j toj twitzju' b'inchal myab'a'n,</para>
  <para style="q">aye'tzunkye' nche jyon ti'j Dyos in kane tkyaqil toj kywitz.</para>
  <para style="b" />
  <para style="q">
    <verse number="6" style="v" />Ate b'a'nju' nqnima'n Dyos maskye toj prowil</para>
  <para style="q">kyetwitzu' q'inun min na'n Dyos tu'n.</para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" />Alkyete njapun tkawb'il Dyos tu'n, jun k'wa'lb'aj b'a'n ximan,</para>
  <para style="q">atzunte' naq wantkub' tu'n, tch'ixaw tman nel tu'n.</para>
  <para style="b" />
  <para style="q">
    <verse number="8" style="v" />Aju' xjal nq'on pwaq ch'ex tuk'i'l tub'chil, nchmet tq'inumal,</para>
  <para style="q">atzunte' q'inumal lu kxe'l q'o'n te juntl xjal nq'aq'an tk'u'j kyi'j prow.</para>
  <para style="b" />
  <para style="q">
    <verse number="9" style="v" />qa ati jun min tajb'il tu'n t-xitb'i'n tkawb'il Dyos,</para>
  <para style="q">ikxte Dyos min ntzaj tb'i'n tkub'sb'il.</para>
  <para style="b" />
  <para style="q">
    <verse number="10" style="v" />Alkyete matxi' q'inteju' tnik'alti'j toj myab'a'n b'e,</para>
  <para style="q">kb'el tz'aq tojxu' t-xpatxab';</para>
  <para style="q">aye'tzunkye' tnik'alkyi'j kyk'ma' t-xtalb'il Dyos.</para>
  <para style="b" />
  <para style="q">
    <verse number="11" style="v" />Ate' q'inun toj twitz qa o'kxte atixi'x tnab'l,</para>
  <para style="q">atzunte' prow qa ati tnab'l neltnik' qa mixti'te' b'a'n tu'n.</para>
  <para style="b" />
  <para style="q">
    <verse number="12" style="v" />Aj kykanb'anju' tnik'alkyi'j, tzalajb'il kye xjal;</para>
  <para style="q">qatzun aye' b'inchal myab'a'n, b'isb'ajilte' toj kanmi xjal.</para>
  <para style="b" />
  <para style="q">
    <verse number="13" style="v" />Alkyete inkub' tewa'n til, lay tz'anq'in toj b'a'nil;</para>
  <para style="q">atzunte' njawtz tpa'n til ex nkyej ttzaqpi'n, kb'el najsa'n.</para>
  <para style="b" />
  <para style="q">
    <verse number="14" style="v" />K'iwla'nte' xjal nxob' te Dyos kukxju';</para>
  <para style="q">atzunte' ch'uẍ tanmi kb'el yajti.</para>
  <para style="b" />
  <para style="q">
    <verse number="15" style="v" />Kse'n jun b'alun ntzanun mujqa jun oso nq'aq'an,</para>
  <para style="q">iktzun xjalju' b'inchal myab'a'n nkawin tib'aj jun tnam prow.</para>
  <para style="b" />
  <para style="q">
    <verse number="16" style="v" />Jun nimaqkawil min ximan, nimju' yajb'il tu'n;</para>
  <para style="q">atzunte' nimaqkawil mixti' jamjon ktenb'el nim tchwinqlal.</para>
  <para style="b" />
  <para style="q">
    <verse number="17" style="v" />Alkyete' matxi' b'yonxjal</para>
  <para style="q">tjunilxte' kxe'l toj muqb'il:</para>
  <para style="q">¡mix-a'lo'xte' kmayil ti'j!.</para>
  <para style="b" />
  <para style="q">
    <verse number="18" style="v" />Kkletelte' xjal tnik'alti'j,</para>
  <para style="q">atzunte' pi's kb'eltz'aq toj taq'wixil.</para>
  <para style="b" />
  <para style="q">
    <verse number="19" style="v" />Alkyete nkub' taq'una'n ttx'otx', nim twa ati;</para>
  <para style="q">atzunte' naq njaninje, k'anq'ila toj prowil.</para>
  <para style="b" />
  <para style="q">
    <verse number="20" style="v" />K'i'wla'nte' xjal tnik'alti'j;</para>
  <para style="q">atzunte' tajb'il tu'n q'inumax tu'n sb'ub'l, ati tz'e'ysb'il twitz.</para>
  <para style="b" />
  <para style="q">
    <verse number="21" style="v" />Myab'a'nte' qa mya' junelni kyilwi xjal qu'n;</para>
  <para style="q">qu'n jaku' noqx tu'nelju' qo' b'inchana' il.</para>
  <para style="b" />
  <para style="q">
    <verse number="22" style="v" />Aju' xjal noktilil tu'n tjaw q'inumax, noq njamjon,</para>
  <para style="q">minti' b'i'n tu'n titi' tzul ti'j.</para>
  <para style="b" />
  <para style="q">
    <verse number="23" style="v" />Qama kane toj qwitz b'a'nxpete' xjal ntzak'un kye witzu' naq nka'yin qi'j.</para>
  <para style="b" />
  <para style="q">
    <verse number="24" style="v" />Aju' inelq'an kyi'j tman ex intma'n: mya il te', chij,</para>
  <para style="q">junx kynab'l kyuk'i'lju' b'yolwnaq.</para>
  <para style="b" />
  <para style="q">
    <verse number="25" style="v" />Alkyete' npon tk'u'j ti'j txqan ti'xti', noqx in jyon q'oj;</para>
  <para style="q">alkyetzunte q'uqlok tk'u'j ti'j Dyos kch'iyel toj tkyaqil.</para>
  <para style="b" />
  <para style="q">
    <verse number="26" style="v" />Aju' xjal q'uqlok tk'u'j ti'j Dyos; nchmet ti'xti' te</para>
  <para style="q">atzunte' inxi'x njamjon, noq nq'ojin.</para>
  <para style="b" />
  <para style="q">
    <verse number="27" style="v" />Aju' nonin ti'j prow, lay kub' prowix;</para>
  <para style="q">atzunte' min na'nqe' tu'n, ktzajil txko'n toj twi'.</para>
  <para style="b" />
  <para style="q">
    <verse number="28" style="v" />Ajkykanb'an b'inchal myab'a'n inche b'aj ewan xjal;</para>
  <para style="q">ajtzun kykyim nimju' tnik'a kyi'j nchmet.</para>
  <chapter number="29" style="c" />
  <para style="p">
    <verse number="1" style="v" />Minab'enx kb'ajelte' mib'a'n b'in kawb'il</para>
  <para style="q">ex layx b'ant tklet.</para>
  <para style="b" />
  <para style="q">
    <verse number="2" style="v" />Qa tnik'alkyi'ju' nche' kawin, tzalajb'ilte' kye tman</para>
  <para style="q">qatzun aye' b'inchal myab'a'n, inche yajti tman.</para>
  <para style="b" />
  <para style="q">
    <verse number="3" style="v" />Ate' k'walb'aj ati tnab'l, tzalajb'il teju' tman;</para>
  <para style="q">qatzun naq kuky'i'l qya eqch nb'eta', kyb'ajil tyaji'nju' tpwaq.</para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" />Aju' nimaqkawil tnik'alti'j, b'a'n telu' ttanam tu'n</para>
  <para style="q">atzunte naq chojb'il ntqani'n, kyb'oljil tu'n.</para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" />Ate' xjal kukx tjaw tnima'n tamiw,</para>
  <para style="q">napelo' jun xpatxab' tu'n tjaw tz'aq.</para>
  <para style="b" />
  <para style="q">
    <verse number="6" style="v" />Ate' b'inchal myab'a'n tojxu' t-xpatxab' kb'el tz'aqa</para>
  <para style="q">atzunte' tnik'alti'j b'a'n nanq'ina' ex ntzalaj.</para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" />Max tok toklenju' prow tu'n tnik'alti'j</para>
  <para style="q">atzunte' b'inchal myab'a'n mixti'xte' nxi' tk'u'j kyi'j.</para>
  <para style="b" />
  <para style="q">
    <verse number="8" style="v" />Majx nche jawtilju' nimaqtnam kyu'n qil twitz jun q'oj;</para>
  <para style="q">aye'tzu'n ati kynab'l nb'ent txi' che'w toj kyu'n.</para>
  <para style="b" />
  <para style="q">
    <verse number="9" style="v" />Qama wuli'n jun xjal ati tnab'l tuk'i'l jun xnak</para>
  <para style="q">ktzajel ttx'u'jil, naq kxmayinjtzel, mixti'xte' kb'entil tu'n, qu'n layx tz'ok toj twi'.</para>
  <para style="b" />
  <para style="q">
    <verse number="10" style="v" />Aye'ju' b'yolwnaq</para>
  <para style="q">ntx'a'lti'j kyk'u'j b'a'nxi'x kyi'ju' b'a'n xjal.</para>
  <para style="b" />
  <para style="q">
    <verse number="11" style="v" />Min nik'xte' xnak ttx'u'jil tu'n</para>
  <para style="q">atzunte' ati tnab'l chab'a nxi' tka'yi'n se'n tu'me'l.</para>
  <para style="b" />
  <para style="q">
    <verse number="12" style="v" />Qa jun nimaqkawil nxi' tb'i'nju' chajyolil</para>
  <para style="q">tkyaqilju' tkawb'il che b'aje'l chalyol.</para>
  <para style="b" />
  <para style="q">
    <verse number="13" style="v" />Ate' prow tuk'ilju' nyajlante</para>
  <para style="q">axte' Dyos q'olte kychwinqlal.</para>
  <para style="b" />
  <para style="q">
    <verse number="14" style="v" />Kqrineb'el tkawb'ilju' nimaqkawil</para>
  <para style="q">qa nkawin toj tnik'alti'j <verse number="15" style="v" />Tu'n tzak'b'il ex asyal noka' qnab'l</para>
  <para style="q">atzunte' k'walb'aj naq chu'chi'n twitz, nel tch'ixaw ttxu tu'n.</para>
  <para style="b" />
  <para style="q">
    <verse number="16" style="v" />Nim il nchmet ajkykub' puqli b'inchal myab'a'n;</para>
  <para style="q">aye'tzu'n b'a'nxjal k'okyel kyka'yi'n ajkykub' b'o'lj.</para>
  <para style="b" />
  <para style="q">
    <verse number="17" style="v" />Tzak'unxa tk'wala, b'a'ntzun k'anq'ilatziya,</para>
  <para style="q">ktzalajila ex k'ojlala.</para>
  <para style="b" />
  <para style="q">
    <verse number="18" style="v" />Jamixti'x jun b'a'n kawil, min nkane toj kywitzju' tman ti'ti' kyb'incha';</para>
  <para style="q">¡Tzalajb'il teju' tnam njapun tkawb'il Dyos tu'n!</para>
  <para style="b" />
  <para style="q">
    <verse number="19" style="v" />Layx tb'ite' loq'aj majen qa naq tu'n yol</para>
  <para style="q">qu'n nkane toj twitz ex minti' nxi' tb'incha'n.</para>
  <para style="b" />
  <para style="q">
    <verse number="20" style="v" />B'a'nxpelo ch'i'ntlju' xnak tka'yink</para>
  <para style="q">kyetwitzju' naq nel tlanu'n kyol.</para>
  <para style="b" />
  <para style="q">
    <verse number="21" style="v" />Qa naq nka'yina te jun lq'o'n majen toj tch'inil</para>
  <para style="q">yajxitzuntl tzul toj tk'u'ja.</para>
  <para style="b" />
  <para style="q">
    <verse number="22" style="v" />Ate' xjal kuw ttx'u'jil</para>
  <para style="q">naqxi'x ntx'u'jin ex ati kmuj noq nel tlani'n tyol.</para>
  <para style="b" />
  <para style="q">
    <verse number="23" style="v" />Ate' noq tnima'ntib' nel tch'ixaw,</para>
  <para style="q">atzunte' me's njaw nima'n.</para>
  <para style="b" />
  <para style="q">
    <verse number="24" style="v" />Aju' noktuk'ila'ntib' kyuk'i'l eleq',</para>
  <para style="q">min ntk'u'jla'n tib'; qu'n qama che tzyet ax juntlte kytxkonjtzel.</para>
  <para style="b" />
  <para style="q">
    <verse number="25" style="v" />Aju' xob'le'n nakuj jun xpatxab',</para>
  <para style="q">atzunte' xjal q'uqlok tk'u'j ti'j Dyos b'a'ntel.</para>
  <para style="b" />
  <para style="q">
    <verse number="26" style="v" />Nimte' nkjyo'nju' xtalb'il kyeju' ajkawil,</para>
  <para style="q">noqtzun o'kxte' Qman Dyos q'olte xtalb'il.</para>
  <para style="b" />
  <para style="q">
    <verse number="27" style="v" />Aye'kye' tnik'alkyi'j nche el kyik'o'n b'inchal myab'a'n,</para>
  <para style="q">exqe' b'inchal myab'a'n kylab'qeju' tnik'alkyi'j.</para>
  <chapter number="30" style="c" />
  <para style="s1">Tyol Awur</para>
  <para style="p">
    <verse number="1" style="v" />Yol tu'n Awur, tk'wal Jakye aj Masa. Yolin Awur te Ityel ex tuk'i'l Ukalex tma kjalu:</para>
  <para style="b" />
  <para style="q">
    <verse number="2" style="v" />Oqinkxwe' mixti' ch'i'n xnaq'tzb'il we,</para>
  <para style="q">mixti'x nchin ximan ch'iwe' kse'nkye q'a.</para>
  <para style="q">
    <verse number="3" style="v" />Mixti' ẍinxe' toj xnaq'tzb'il,</para>
  <para style="q">ex mixti'x xnaq'tzb'ile' ti'j Dyos.</para>
  <para style="q">
    <verse number="4" style="v" />¿alkye oje japun toj kya'j ex kb'u'ltl?</para>
  <para style="q">¿Alkye nb'ent ttzyunte kyq'iq' toj tq'ob'?</para>
  <para style="q">¿alkye nb'ajxju' ninnjab' toj tpinpa't?</para>
  <para style="q">¿Ex alkye kyej b'inchante tnaqachil tx'otx'?</para>
  <para style="q">¿Titi' tb'i, ex titi' tb'iju' tk'wal, qa b'i'n tu'na?</para>
  <para style="q">
    <verse number="5" style="v" />Xq'uqi'n qekye' q'uqli kyk'u'j ti'j Qman Dyos tu'n;</para>
  <para style="q">qu'n ate' tyol ax b'a'n tu'n tqe qk'u'j ti'j.</para>
  <para style="q">
    <verse number="6" style="v" />Lalun tz'ok t-tz'aqtza'na tyol</para>
  <para style="q">tu'ntzun lalun tz'ok q'o'na chalyol.</para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" />Oje txi' nqanine' kab'e' ti'xti' teya nman Dyos;</para>
  <para style="q">b'inchama xtalb'il q'ontza weye' na'mxku' nkyime':</para>
  <para style="q">
    <verse number="8" style="v" />Pa'mila chajyolil wi'je',</para>
  <para style="q">ex lay chin q'inumaxe' ex mya' yajxi'x;</para>
  <para style="q">chin tpa'mila ti'ju' noq nkub'naj, noq o'kx q'ontzju'ya nwaye' atl junjun q'ij.</para>
  <para style="q">
    <verse number="9" style="v" />Qu'n qa ninxi'x ati weye', jaku' tzik'tna'la wu'ne'</para>
  <para style="q">ex jaku' nmaye' qa min ojtzqi'na wu'ne';</para>
  <para style="q">exqa yajqinxixe' jaku' chinxe' elq'al</para>
  <para style="q">ex jaku' tz'el tch'ixawa wu'ne'.</para>
  <para style="b" />
  <para style="q">
    <verse number="10" style="v" />Lalun yolina myab'a'n ti'j jun lq'o'n majin teju' tajaw,</para>
  <para style="q">qu'n jaku' tzajttxko'n toj twi'ya ex kyajtela.</para>
  <para style="b" />
  <para style="q">
    <verse number="11" style="v" />Ati wiq xjal nche yolin taq'wix ti'j kma'n</para>
  <para style="q">ex minti' nkynima'n ktxu.</para>
  <para style="q">
    <verse number="12" style="v" />Ate'qe' xjal nkma'n qa mixti' kyil,</para>
  <para style="q">extzun min nanjtzti'j kyanmi.</para>
  <para style="q">
    <verse number="13" style="v" />nimte' nok tq'o'ntib' nim toklen,</para>
  <para style="q">ex ntnima'ntib' twitzju' prow.</para>
  <para style="q">
    <verse number="14" style="v" />Ate'qe' xjal naku'j k'uẍtx'e'nb'ilqe' kywitzte</para>
  <para style="q">aye'tzu'n kyka naku'j kuchilqe',</para>
  <para style="q">nche ajb'en kyu'n tu'n kyb'aj</para>
  <para style="q">kkyaqilju' xjal prowqe' twitz tx'otx'.</para>
  <para style="q">
    <verse number="15" style="v" />Kab'e' talju' xton toj ttxa'n txkup,</para>
  <para style="q">o'kx nb'enti kyu'n, tu'n kyqanin ti'xti'.</para>
  <para style="b" />
  <para style="q">Ati kab'e' oxe' ti'xti' te,</para>
  <para style="q">ex mixti' nqe tk'u'j.</para>
  <para style="q">
    <verse number="16" style="v" />Aju' muqb'il, kux ntqani'n kyimni,</para>
  <para style="q">aju' ttxu k'u'jb'aj min nalan, tajb'il tal,</para>
  <para style="q">exju' tzqij tx'otx', mixti' nak'</para>
  <para style="q">exju' Q'aq', kukx tokx siju' toj.</para>
  <para style="b" />
  <para style="q">
    <verse number="17" style="v" />Aju' xjal nxmayin ti'j tman</para>
  <para style="q">ex minti' nokslan te ttxu matxi' tijin,</para>
  <para style="q">b'a'ntzunte' tu'n tetz q'i'n twitz kyu'n joj</para>
  <para style="q">ex tu'n tb'aj ch'yo'n kyu'n t'iw.</para>
  <para style="b" />
  <para style="q">
    <verse number="18" style="v" />Ati oxe' ti'xti', mujqa kyaje',</para>
  <para style="q">inchin lab'tiye' kyi'j ex min kane toj nwitze':</para>
  <para style="q">
    <verse number="19" style="v" />Se'n taq'wi nlipanju' pich' twitz kya'j,</para>
  <para style="q">ex se'ntaq'wi nb'etju' kan twi' pik,</para>
  <para style="q">Se'ntaq'wi nb'etju' b'ark tib'aj ninnjab'</para>
  <para style="q">ex se'ntaq'wiju' mejeb'le'n exju' itz'je'n.</para>
  <para style="b" />
  <para style="q">
    <verse number="20" style="v" />Aju' qya ajpajil nanq'in kjalu:</para>
  <para style="q">in wan, ex nb'aj ttxjo'n ttzi</para>
  <para style="q">extzun a tyolju' mixti' wil.</para>
  <para style="b" />
  <para style="q">
    <verse number="21" style="v" />Oxe' tu'me'lju' xjal, kyaje' pena'te',</para>
  <para style="q">layx tzik'x qu'n ex majx nb'aj chukji twitz tx'otx' kyu'n:</para>
  <para style="q">
    <verse number="22" style="v" />Aju' lq'o'n majin nok te nimaqkawil,</para>
  <para style="q">exju' xjal mixti' tnab'l nim ti'xti' te,</para>
  <para style="q">
    <verse number="23" style="v" />Aju' qya etzni xla'ja'n tja tchmil,</para>
  <para style="q">in mje jumajtl</para>
  <para style="q">exju' lq'o'n qya te majin nel tiq'i'n toklenju' tajaw qya.</para>
  <para style="b" />
  <para style="q">
    <verse number="24" style="v" />Ati kyaje' txkup twitz tx'otx' tal k'ok'e'qe'</para>
  <para style="q">inxi'xpe' nche ximan kyekywitzju' xjal ati knab'l:</para>
  <para style="q">
    <verse number="25" style="v" />aye'kye' snik, jun chquj txkup mixti' kyipumal</para>
  <para style="q">inpe' kb'uyi'nkye' kwa toj q'ijal;</para>
  <para style="q">
    <verse number="26" style="v" />Aye'ju' saqb'in, mya'xix nim kyb'aj ex mixti' kyipumal</para>
  <para style="q">in b'entju' kyja toj pik;</para>
  <para style="q">
    <verse number="27" style="v" />aye'ju' txil, mixti' knejel,</para>
  <para style="q">ex inche b'et tojxi'x tu'me'l ex nk'u'mile kten.</para>
  <para style="q">
    <verse number="28" style="v" />Aye' xmatx nb'ent kytzyet toj qq'ob'</para>
  <para style="q">najliqe' toj kyja nimaqkawil.</para>
  <para style="b" />
  <para style="q">
    <verse number="29" style="v" />Ati oxe' ti'xti' mujqa kyaje' min nche' xob',</para>
  <para style="q">exju' che b'et majx kb'anilqe':</para>
  <para style="q">
    <verse number="30" style="v" />Aju' b'alun, a txkupju' nimxi'x tipumal ex xob'ajilx,</para>
  <para style="q">min nkub' oq, ex minti' nxob' kye xjal;</para>
  <para style="q">
    <verse number="31" style="v" />aju' tmanek' achb'ajil ka'yin, exju' tman chib'</para>
  <para style="q">ikxju' nimaqkawil nejli kywitzju' t-xjal te q'oj.</para>
  <para style="b" />
  <para style="q">
    <verse number="32" style="v" />Qa tu'n t-xnakyila njaw tnima'n tib'a.</para>
  <para style="q">ex makub' tena ximilte myab'a'n, ximanku'ya b'a'nxi'x</para>
  <para style="q">
    <verse number="33" style="v" />qama jaw ttz'amina lech, kb'entel mantekyiy,</para>
  <para style="q">qama xkyipun ttxa'na kuw ktzajel chik' toj,</para>
  <para style="q">ex ikxtzun qama tz'oktena ik'lelte juntl njyon q'oja.</para>
  <chapter number="31" style="c" />
  <para style="s1">Tyol Lemwel</para>
  <para style="p">
    <verse number="1" style="v" />Aye'ju' yol q'umli tu'n nimaqkawil Lemwel aj Masa, aye'j yol ajb'en tu'n ttxu xnaq'tzalte:</para>
  <para style="b" />
  <para style="q">
    <verse number="2" style="v" />Aya wal, jun oyaja weye',</para>
  <para style="q">ex jun tzaq'web'l kye nkub'sb'ile' tu'n Dyos,</para>
  <para style="q">¿titi'tzuntl tu'n txi' nma'n teya?</para>
  <para style="q">
    <verse number="3" style="v" />Lalun kub' tena yajulte tipumala kyuk'i'l qya,</para>
  <para style="q">qu'n kyu'nkye qya, inche tzpetju' nimaqkawil.</para>
  <para style="q">
    <verse number="4" style="v" />Lemwel, myab'a'nte' kyeju' nejenel ex kyeju' nimaqkawil</para>
  <para style="q">tu'n kyk'wan q'e'n ex tu'n kytx'ujti,</para>
  <para style="q">
    <verse number="5" style="v" />Qu'n jaku' tzik'tna'lu' kawb'il kyu'n</para>
  <para style="q">ex jaku' mixti'tl kyilwiju' me's kyu'n.</para>
  <para style="b" />
  <para style="q">
    <verse number="6" style="v" />Q'onxta' q'e'n</para>
  <para style="q">kyeju' nche janinje ex kyeju' nche' yajti;</para>
  <para style="q">
    <verse number="7" style="v" />¡che tx'ujtiku'j</para>
  <para style="q">tu'ntzun tik'tna'l kyu'n qa inche yajti ex ẍji'lqe'!</para>
  <para style="b" />
  <para style="q">
    <verse number="8" style="v" />Ati tu'n tyolina kyi'ju' min nb'ent kyolin;</para>
  <para style="q">¡ex ati tu'n tkolona kyi'j mixti' klol kye!</para>
  <para style="q">
    <verse number="9" style="v" />Yolina kyi'j, ex b'inchama tnik'alilti'j;</para>
  <para style="q">¡klomqe'juya prowqe' exqe' me'sqe'!</para>
  <para style="s1">Ninb'ilte qya b'a'n xjal</para>
  <para style="q">
    <verse number="10" style="v" />Jun qya b'a'n xjal ch'uẍ tu'n tjyet;</para>
  <para style="q">¡qama tze'lyal, tb'anilxi'xte' kyekywitz txqan tb'anil ab'j!</para>
  <para style="q">
    <verse number="11" style="v" />Majx q'uqlok tk'u'ju' tchmil ti'j,</para>
  <para style="q">ex ate nb'inchante tkyaqilju' nojqelan te tchmil.</para>
  <para style="q">
    <verse number="12" style="v" />B'a'nile ntb'incha'n te tchmil</para>
  <para style="q">tkyaqil q'ij.</para>
  <para style="q">
    <verse number="13" style="v" />Nxi' jyol noq' ex xb'alin sed tb'i,</para>
  <para style="q">ex tuk'i'l tzalajb'il nxa' tchmo'na' xb'alun.</para>
  <para style="q">
    <verse number="14" style="v" />Najchaq nxa' jyolte nojqelan,</para>
  <para style="q">kse'nqe' ẍk'uẍta'l najchaq ntzaja' kyk'aẍ toj b'ark.</para>
  <para style="q">
    <verse number="15" style="v" />Primxtoq ajtjawe'</para>
  <para style="q">b'inchal kywa tal ex q'ol kyyaq'u'n tmajen qya.</para>
  <para style="q">
    <verse number="16" style="v" />Ajtka'yinte jun ky'jaj tx'otx' intlq'o'n,</para>
  <para style="q">tu'ntzun tkanb'ab'l noka' tawal toj.</para>
  <para style="q">
    <verse number="17" style="v" />Primtzun njawe'</para>
  <para style="q">ex tuk'i'l tzalajb'il naq'unana'.</para>
  <para style="q">
    <verse number="18" style="v" />In xitka'yi'n qa b'a'n telu' tk'a'ẍ,</para>
  <para style="q">inx aq'unan qonik'an.</para>
  <para style="q">
    <verse number="19" style="v" />in chqon noq',</para>
  <para style="q">ex ax b'inchalkye t-xb'alun.</para>
  <para style="q">
    <verse number="20" style="v" />kukx nb'inchan xtalb'il kye prow</para>
  <para style="q">ex kyeju' meb'a.</para>
  <para style="q">
    <verse number="21" style="v" />Minti' nxi' b'ajte' tk'u'j toj tq'ijlalil che'w,</para>
  <para style="q">kykyaqilju' toj tja atiyile kyxb'alun kutxb'ilkye.</para>
  <para style="q">
    <verse number="22" style="v" />Axte b'inchalkye ttxo'w,</para>
  <para style="q">exju' ti'j nche b'jo'k tq'o'n tb'anil ex tz'uminqexi'x.</para>
  <para style="q">
    <verse number="23" style="v" />Ojtzqi'nxi'xu' tchmil toj tnam,</para>
  <para style="q">qu'n junte kyxolju' ati kyoklen toju' nintnam.</para>
  <para style="q">
    <verse number="24" style="v" />Inche'x tb'incha'n xb'alun</para>
  <para style="q">kyeju' ẍk'uẍta'l</para>
  <para style="q">tu'n txi' kyk'a'yi'n najchaq.</para>
  <para style="q">
    <verse number="25" style="v" />jun qya kuw ex sak',</para>
  <para style="q">mixti' nb'ajx tk'u'j ti'ju' te najchi'j, te kab'j.</para>
  <para style="q">
    <verse number="26" style="v" />Nyolin tuk'i'l nab'l,</para>
  <para style="q">ex nten tk'u'jlalil</para>
  <para style="q">
    <verse number="27" style="v" />Inxi' tka'yi'nju' nojqelan toj tja,</para>
  <para style="q">ex mlayx wan qa na'mx tkanb'ante.</para>
  <para style="q">
    <verse number="28" style="v" />In nimanjtz tu'n tchmil ex kyu'nju' tal.</para>
  <para style="q">ex a kyyolju':</para>
  <para style="q">
    <verse number="29" style="v" />B'a'npunte' qya b'a'n xjal ex twi' aq'unal,</para>
  <para style="q">atzunta majx tb'anilxi'xu' taq'unb'ena kyekywitz.</para>
  <para style="q">
    <verse number="30" style="v" />Noqpelo qak'a'nte nok toj qwitz ti'ju' qya tb'anil ka'yin,</para>
  <para style="q">ate' qya nxob' twitz Qman Dyos,</para>
  <para style="q">atzunte' b'a'nju' <verse number="31" style="v" />¡Knimanktze' kwitz kykyaqil tnam!</para>
  <para style="q">¡ex kymanxe' tkyaqilju' tb'inchb'en!.</para>
</usx>