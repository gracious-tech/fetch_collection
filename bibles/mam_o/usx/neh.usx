<?xml version="1.0" encoding="utf-8"?>
<usx version="2.6">
  <book code="NEH" style="id">NEH.TXT Febrero 2009 Pedro D. Cabrera Mam Ostunkalko. Updated for DBL by G. Grasso and E. Canales, December 2012, standardization after migration to PT8 by A. Camus March, 2019.</book>
  <para style="h">Nehemías</para>
  <para style="toc3">Neh</para>
  <para style="toc2">Neh</para>
  <para style="toc1">Tuj Neemiy (Nehemías)</para>
  <para style="mt1">TUJ NEEMIY</para>
  <para style="mt2">(Nehemías)</para>
  <para style="imt">CHIK'B'AB'L</para>
  <para style="ip">Tok tb'iju' u'j lu: Tuj Neemiy, qu'n atzu' nyolina' ti'ju' tb'incha Neemiy. Kyoju' tnej jun ex kab'e' (caps. 1-2) ntma'na' tej tchq'onjtz Neemiy toj chaq'b'il tu'n Artajerjes nimaqkawil aj Persya, atzu'n kyoju' tnej oxe' pon toj wuq (caps. 3-7) intma'n tej tanjtzti'j ex tej kyjaw b'inchet jumajtlu' nimaqtapi ti'j Jerusalen. Junxtoqtzun telju' aq'untl kyu'n tu'n tb'ant jumajtlu' nuk'b'il kyxol xjal tuk'i'lju' kychwinqlal twitz Dyos, qu'mtzun onin Neemiy ti'j Esdras tu'n kyten aj Juda b'a'n twitz Dyos. Ikytzu'n intma'n kyoju' tnej wajxaq pomnix toj lajoj (caps. 8-10) qa xiq'o'n anb'il tu'n tjaw ẍch'i'n tu'jil chaq'b'il ex tej tkyaj b'ant jumajtl kyol aj Israel tuk'i'l Dyos. Atzu'n kyoju' b'ajsb'il oxe'tl tnej (caps. 11-13) intma'n tej kyb'aj nk'u'nju' ajb'el toj tja Dyos, tej t-xjansetu' nimaqtapi ex nyolin kyi'ju' ch'exb'eb'l tb'incha Neemiy.</para>
  <chapter number="1" style="c" />
  <para style="s1">Na'n Dyos Neemiy ti'ju' ttanam</para>
  <para style="p">
    <verse number="1" style="v" />Toju' xjaw kyislew toj tjunaqi'n (20) ab'q'i nkawin Artajerjes, ayine' Neemiy tk'wal Akaliy, atinqintoqe' toju' nintnam Susa <verse number="2" style="v" />tej tponju' ntzike' Anani kyuk'i'l jte' ichan tzajniqe' toj Juda. Xinqani'ntzuntze' kye ti'j Jerusalen ex kyi'j kykyaqilju' aj Juda e'kyaj anq'in toj qtanam teju' jitz'jtib'il. <verse number="3" style="v" />Ex tzaj kytzaq'we'n weye': Nche yajtikye' e'kyaj anq'in toj tx'otx' Juda teju' jitz'b'il ex ch'ixb'ilx te'qe'. Atzunte Jerusalen, majx oje kub' xitju' nintapi ti'jile ex majx eb'aju' tjpel tu'n q'aq', chechij.</para>
  <para style="p">
    <verse number="4" style="v" />Tej nb'inteju'ye' tqanil lu, inkub' qeye' oq'el, ex nkyaj b'isun jte' q'ije', nchin mewayine' ex nchin na'n Dyose' twitz Qman Dyos te toj kya'j. <verse number="5" style="v" />Xinma'ne' te: Nman Dyos atiya toj kya'j, aya Dyos nim toklena ex xob'ajilxa, min ntch'exb'e'nju'ya tyola ntzaj ttziya'na kyeju' nche k'u'jlanteya ex njapun tchaq'b'ila kyu'n; <verse number="6" style="v" />chin kub'sale' teya ja'lo tu'n ttzaj tb'i'nju'ya nna'j Dyose' twitza q'ijtl ex qonik'an kyi'ju' aj Israel tmajina. Inel nnik'e' qa ayo'ye' aj Israel matxi' qo b'inchan ile' twitza; ¡Ayo'xpe' junqe' kyuk'i'lju' nwitze'le' matxi' qo b'inchan ile'! <verse number="7" style="v" />Mixyab'a'n matxi' qb'inchaye' twitza; na'mx kyjapunju' tchaq'b'ila ex tkawb'ila qu'ne', tzaj tq'o'na qeye' tu'ne'lju' tmajina Moyses. <verse number="8" style="v" />Na'ntzju'ya tzajni tma'na te Moyses, qama qo b'inchan ile', atitoq tu'n qxi' t-sputi'na toj tkyaqil twitz tx'otx'; <verse number="9" style="v" />qatzun matz'anjtzti'j qanmiye' tuk'i'la exqa mache japunju' tchaq'b'ila qu'ne' tu'n qb'inchanteye', maskyepe' matxitoq qopone' tzmax b'ajsb'il twitz tx'otx', qo jawil tiq'i'na ja to'qo'ye' ex qopomel tiq'i'n jumajtla toju' najb'il xjan jaw t-sk'o'na jatu'n tna'njtza'ju' tb'iya. <verse number="10" style="v" />Ayo'ye' tmajina ex ttanama, ju' tkola tuk'i'l nimtipumala. <verse number="11" style="v" />Nchinkub'sa'ne' teya, Nman Dyos, tu'n ttzaj tb'i'nju'ya nna'j Dyose' ex kykub'sb'ilju' tmajina, ju' o'kx kyajb'ilju' tu'n tjaw nima'na kyu'n. Ex kxe'l nkub'sa'ne' teya tu'n wel b'a'ne' tuk'i'lju' nimaqkawb'il, nchije' toj nna'j Dyose'.</para>
  <para style="p">Qu'n ayintoqe' q'olte tk'wa' nimaqkawil Artajerjes.</para>
  <chapter number="2" style="c" />
  <para style="s1">Taq' nimaqkawil Artajerjes anb'il tu'n txi' Neemiy Jerusalen</para>
  <para style="p">
    <verse number="1" style="v" />Jun q'ij toju' xjaw Nisan, toj tjunaqi'n (20) ab'q'i nkawin nimaqkawil Artajerjes, tej intoq xinq'o'ne' tk'wa' b'in, oktka'yi'n nimaqkawil inxi'x chin b'isune' <verse number="2" style="v" />ex tzaj tqani'n weye':</para>
  <para style="p">—In nka'yine' twitza inxi'x b'isun. ¿Titi' niq'ina? mujqa yab'a, atilo jun ti'xti' myab'a'n, chij.</para>
  <para style="p">Tojtzu'n kmoj lu nna'ye' jun ninxob'el, <verse number="3" style="v" />ex xinma'ne' te nimaqkawil:</para>
  <para style="p">—¡Tz'anq'inxwita kukxju' nimaqkawil! ¿Se'ntaq'wi lay chin b'isune', extzun xitjniju' nintnam ja ta'qe' muqb'il kye qtzan nmane' ex b'ajniqe'ju' tjpel tu'n q'aq'? nchije' te.</para>
  <para style="p">
    <verse number="4" style="v" />—¿Titi' b'a'n tu'n nb'inchanteye' teya? chiju' nimaqkawil tzaj tqani'n.</para>
  <para style="p">Kub'tzun nq'o'n wib'tze' toj tq'ob' Qman Dyos toj kya'j, <verse number="5" style="v" />xi'tzun ntzaq'we'ntze' te nimaqkawil ikjalu:</para>
  <para style="p">—Qa b'a'n toj twitza nimaqkawil, exqa matzaj q'aq'an tk'u'ja wi'je', a kxel nqani'nju'ye' teya tu'n nxitchq'o'na toj Juda toju' nintnam ja mqu'na'qe' qtzan nmane', tu'ntzun tjaw nb'incha'n jumajtle', nchije' te.</para>
  <para style="p">
    <verse number="6" style="v" />Tzajtzun ttzaq'we'n nimaqkawil weye' tuk'i'lu' t-xu'jil q'uqloktoq tk'etz:</para>
  <para style="p">—¿Jte'tzunlo q'iju' tb'eya?</para>
  <para style="p">¿Jtojtzunlo tz'anjtzti'ja? chij.</para>
  <para style="p">Xinma'ne' tajlal xjaw te, ex kub' toj twitz tu'n nxi'ye'. <verse number="7" style="v" />Expe' xinma'ne' te, qa b'a'ntoq toj twitz, tu'n ttzaj ttz'ib'a'n jun u'j kyeju' kawil toj tkub'exq'ij te nin a' Ewprates, tu'n wik'x kytzaqpi'ne' tzmax ajnpone' toj Juda; <verse number="8" style="v" />ex tu'n ttzaj ttz'ib'a'n juntl u'j te Asap, ju' xq'uqil tk'ul nimaqkawil, tu'n ttzaj tq'o'n tze weye' tu'n kyb'inchetl tjpelju' nintnam jata' tja Dyos, ex tjpelu' nintapi ti'ju' nintnam ex tjpelju' ja jatu'n nnajana'ye'. Ex tzaj tq'o'n nimaqkawil tkyaqil weye' qu'n o'ni'nqintoqe' tu'n Qman Dyos nchin k'ulune' te.</para>
  <para style="p">
    <verse number="9" style="v" />Tetzunj npone' kywitzju' kawil toj tkub'exq'ij teju' a' Ewprates, b'ajx nq'o'nju'ye' u'j e'tzaj tq'o'n nimaqkawil kye, expe' e'tzaj tchq'o'n nimaqkawil jun tnej xjal te q'oj ti'j chej wuk'i'le' toj kychaq'b'il nejenel kye xjal te q'oj. <verse number="10" style="v" />Ate'toqtzun kab'e' ichan, aju' jun Sanb'alat tb'i aj Oron, atzu'n juntl Tob'iy tb'i, aj Amon nim toklen toju' kawb'il, tzaj kytx'u'jil b'a'nxi'x tej kyb'inte qa matxi'toq pon jun ati tb'is tk'u'j onilkye aj Israel.</para>
  <para style="s1">Aq'untl tu'n tjaw b'inchet Jumajtlu' nintapi</para>
  <para style="p">
    <verse number="11" style="v" />In pontzune' toj Jerusalen. Tojtzun toxi'n q'ij npomlene', <verse number="12" style="v" />injawe'ye' te qonik'an, k'le'nqe' junjun xjal wu'ne', ex mixti'xte xinma'ne' kye titi' matxi'toq tzaj t-xewsa'n Dyos weye' tu'n nb'inchanteye' ti'j Jerusalen. Mixti' juntl chej xi'wiq'i'ne', o'kxju' iqalweye'. <verse number="13" style="v" />Tojxu' qonik'an lu netze' ttziju' tjpel tnam te b'ya', tu'me'lju' t-xiklil a' wakxkan tb'i ex toju' tjpel te xob'l tz'is, b'aj nka'yi'ne' nintapi ti'j Jerusalen, kub'ni xitj ex b'ajni tz'e'yju' tjpel. <verse number="14" style="v" />Xi'tzun nljo'n nb'etze' tu'me'lju' tjpel te t-xiklil a' exju' tpil nimaqkawil; naqtzun a mixti' b'ent tik'xju' ncheje' atzu'. <verse number="15" style="v" />Qonik'anxtoq, njaxe' ttziyileju' a', tb'ajlenxi'tzun nka'yi'ne' nintapi, anjtz wi'je', noktze' toju' tjpel tu'me'l b'ya'.</para>
  <para style="p">
    <verse number="16" style="v" />Mixtoqti' b'i'n kyu'nju' kawil jamatxi'toq chin tx'anja'ye', ex titi' matxitoq chin tx'anje' b'inchalte. Ex na'mxtoq t-xinma'n tpakb'ale' kye aj Juda, aye' pale, e'nimaq kyoklen, e'kawil ex txqantl xjal atitoq tu'n kyten toju' aq'untl. <verse number="17" style="v" />Xinma'ntzuntze' kye:</para>
  <para style="p">—B'i'n kye'kyu'n qa ch'uẍxi'x to'qo', qu'n kub'ni xitju' Jerusalen ex b'ajniqe' tz'e'yju' tjpel. Kymujb'am kyib'e' wuk'i'le' ex qb'incha'nktz jumajtlju' nintapi ti'j Jerusalen, tu'ntzun lan qo oktl te xmayb'il, nchije' kye.</para>
  <para style="p">
    <verse number="18" style="v" />Tetzunj txi' nchik'b'a'ne' tu'me'l tb'anilxi'x matxitoq tz'onina' Dyos wi'je' kye, exqe' tyolu' nimaqkawil ojetoq tzaj tma'n weye', tzaj kytzaq'we'n:</para>
  <para style="p">—¡Qtzyu'kna' tu'n tjaw qb'incha'n jumajtl! chechij.</para>
  <para style="p">Ex inxi'xtoq che tzalaj, b'aj kyq'uqb'a'n kyk'u'j kyxolilex. <verse number="19" style="v" />Tetzunj kyb'inte Sanb'alat, Tob'iy ex Kyesem aj Arab'ya, e'xmayin qi'je' ex tzaj kyma'n qeye' tuk'i'l ik'jtib'il:</para>
  <para style="p">—¿Titi' nkyb'icha'ne'? ¿Ma kyajb'ile' tu'n tjaw kyiq'inkyib'e' ti'ju' nimaqkawil? chechij.</para>
  <para style="p">
    <verse number="20" style="v" />Xi'tzun ntzaq'we'ne' kye:</para>
  <para style="p">—Ate Qman Dyos toj kya'j k'onilqeye'. Tmajin qo'ye', k'okyel qtzyu'ne' tu'n tjaw qb'incha'n jumajtle', aye'tzunkye' myana' aj Israel qe'kye', mixti'kye' kyoklen tu'n kykawine' toju' nintnam lu ex myaye' junkye' ate'qe' toju' tqanil qtaname', nchije' kye.</para>
  <chapter number="3" style="c" />
  <para style="s1">Kub' kyaq'pu'n aq'untl kyxol</para>
  <para style="p">
    <verse number="1" style="v" />A Elyasib' kynejel pale kyuk'i'lju' pale, eb'inchanteju' tjpel tnam, rit tb'i. Okkyq'o'n ptzo'n tzuyb'ilte ex okkyq'o'n tjpel, ex jaw kyb'incha'ntlu' nintapi tzajx tk'etzju' ja nimin twe' Syen tb'i ex ponx tk'etzju' ja nimin twe' Ananel tb'i. <verse number="2" style="v" />Atzu'n jun tnejtl nintapi jaw kyb'incha'ntlu' xjal aj Jeriko, ex jun tnejtl jaw tb'incha'ntl Sakur, tk'wal Inb'ri. <verse number="3" style="v" />Aye'tzu'n tyajajil Senaa jaw kyb'incha'ntlu' tjpel, kyiẍ tb'i, okkyq'o'n ptzo'n tzuyb'ilte ex eb'jo'k kyq'o'nju' tjpel kyuk'i'lxi' jpub'lte ex t-xq'e'l. <verse number="4" style="v" />Atzu'n jun tnejtl nintapi oktkuwsa'n Meremot, tk'wal Uriy ex tchman Kos; atzun jun tnejtl nintapi a Mesulam, tk'wal B'erekyiy ex tchman Mesesab'el jaw b'inchante; atzun jun tnejtl nintapi jaw tb'incha'ntl Sadok, tk'wal B'aana. <verse number="5" style="v" />Atzu'n jun tnejtl aye' eb'aj b'inchanteju' aye' aj Tekoa, maskye min kyaju' kyxjal nimaq kyoklen tu'n kyonin kyi'ju' nejenel ti'ju' aq'untl. <verse number="6" style="v" />Aye' Joyada, tk'wal Pasea, ex mesulam, tk'wal B'esodiy, eb'inchanteju' tjpel Jesana tb'i. Okkyq'o'n ptzo'n tzuyb'ilte ex b'jo'k kyq'o'n tjpel kyuk'i'lxi' jupb'ilkye ex t-xq'e'l. <verse number="7" style="v" />Atzu'n jun tnejtl nintapi b'aj kyb'incha'n Melatiyas aj Kab'aon ex Jadon aj Meronot, exqe' xjal aj Kab'aon ex aj Mispa, ju' najb'il ate'qe' tjaq' tkawb'ilju' kawil toj tkub'exq'ij te nin a' Ewprates. <verse number="8" style="v" />Atzu'n jun tnejtl nintapi b'aj tb'incha'n Usyel, tk'wal Arayiy, aq'unal ti'j saqpwaq; atzun jun tnejtl b'aj tb'incha'n Ananiy, aq'unal ti'j k'ok'sb'il; kykab'il eb'aj b'inchanteju' nintapi ti'j Jerusalen tzmax tk'etzu' tapi nim twitz. <verse number="9" style="v" />Atzu'n jun tnejtl b'aj tb'incha'n Repayiy, tk'wal Ur, alkalt te nik'jan ttx'otx' Jerusalen. <verse number="10" style="v" />Atzu'n jun tnejtl tapi b'aj tb'incha'n Jedayiy, tk'wal Arumap, qu'n tpentoqu' tja ta'ya', atzun jun tnejtl b'aj tb'incha'n Atus, tk'wal Asab'niy. <verse number="11" style="v" />Aye'tzu'n Malkyiy, tk'wal Arim, ex Asub', tk'wal Paat-moab', b'aj kyb'incha'n jun tnejtl tapi exju' ja nimin twe' Orni tb'i. <verse number="12" style="v" />Atzu'n jun tnejtl b'aj kyb'incha'n Salum, tk'wal Aloes, ju' alkalt te nik'jantl ttx'otx' te Jerusalen, kyuk'i'lju' tmyal. <verse number="13" style="v" />Atzu'n Anun kyuk'i'lju' xjal najlqe' toj Sanoa b'aj kyb'incha'n tjpel b'ya' tb'i; b'aj kyb'incha'ntl ex b'jo'k kyq'o'n tjpel kyuk'i'lxi' jupb'ilte ex t-xq'e'l, ex jawkyb'incha'ntl junaq jun ky'jaj tk'i' nik'jan (21.53) tqanu' nintapi, tzmax tk'etzju' tjpel xob'l tz'is tb'i. <verse number="14" style="v" />Atzu'n Malkyiy, tk'wal Rekab', kawil toju' tx'otx' B'et-akyerem, b'inchantetlju' tjpel xob'l tz'is tb'i, b'jo'k tq'o'n tjpel kyuk'i'lxi' jupb'ilte ex t-xq'e'l. <verse number="15" style="v" />Atzu'n Salum, tk'wal Kolose, kawil toju' tx'otx' Mispa, b'inchantetlju' tjpel, t-xiklil a' tb'i: b'aj tb'incha'ntl ex jawx tq'o'n twi', ex b'jo'k tq'o'n tjpel kyuk'i'lxi' jupb'ilte ex t-xq'e'l, ex b'aj tb'incha'ntlju' nintapi tzajx jata' k'ub'l a', Siloe tb'i, tk'etzu' tawal nimaqkawil, pon tzmax ja ta'qe' peta'n nche ku'tz toju' Ninttanam Dab'i. <verse number="16" style="v" />Atzu'n Neemiy, tk'wal Asb'uk, kawil toj nik'janju' ttx'otx' B'et-sur, jaw b'inchante jun tnejtl nintapi tu'n tpon tzmax kywitzju' muqb'il te Dab'i, tu'n tpon tzmax tk'etzu' tkb'el a' ex tzmax tk'etz kyja xjal te q'oj.</para>
  <para style="p">
    <verse number="17" style="v" />Atzu'n jun tnejtl tapi b'aj kyb'incha'n aj Leb'i: a Reum, tk'wal B'ani; atzu'n jun tnejtl b'aj tb'incha'n Asab'iy, kawil toj nik'janju' ttx'otx' Kyeyla, tb'incha toj tb'iju' jankawina'. <verse number="18" style="v" />Atzun jun tnejtl tapi jaw kyb'incha'n tuk'i'l: aye' B'ab'ay, tk'wal Enadad, ju' kawil toju' nik'jantl ttx'otx' Kyeyla; <verse number="19" style="v" />atzu'n Eser, tk'wal Joswe, kawil toj Mispa, b'aj b'inchante jun tnejtl tu'me'lju' ja k'ub'lkye aq'unb'il te q'oj, ttx'u'k tb'i. <verse number="20" style="v" />Atzu'n B'aruk tk'wal Sab'ay, b'aj b'inchante jun tnejtl, txi'x toj ttx'u'k ponx ttziju' tja Elyasib', kynejel pale; <verse number="21" style="v" />atzu'n Meremot tk'wal Uriy ex tchman Kos, jaw b'inchante jun tnejtl, tzajx ttzi tja Elyasib' ex ponx japomna' b'aju' ja.</para>
  <para style="p">
    <verse number="22" style="v" />Atzun jun tnejtl tapi b'aj kyb'incha'n pale najlqe' toju' b'ya' Jordan. <verse number="23" style="v" />Aye'tzu'n B'enjamin ex Asub' eb'aj b'inchante jun tnejtl tapi tpenju' kyja. Atzu'n Asariy, tk'wal Maaseyiy ex tchman Ananiy, jaw b'inchante tk'etzju' tja. <verse number="24" style="v" />Atzun jun tnejtl b'aj tb'incha'n B'inuy, tk'wal Enadad, tzajx tk'etz tja Asariy, ponx ttx'u'k. <verse number="25" style="v" />Atzu'n Palal, tk'wal Usay, b'aj b'inchante jun tnejtl tapi tk'etzju' ttx'u'k ex tpenju' ja nimin twe', nimxi'xtl twe' kyetwitzju' tja nimaqkawil, ju' ati tpen tja xq'uqil. Atzun jun tnejtl b'aj tb'incha'n Pedayiy, tk'wal Paros, <verse number="26" style="v" />pon tzmax twitzju' tjpel, a' tb'i, tu'me'l tjawetzq'ij, ex tk'etzu' ja nimxi'x twe'. (Aye'toqu' nche ajb'en toj tja Dyos najliqe' toj Opel). <verse number="27" style="v" />Aye'tzu'n aj Tekoa eb'aj b'inchante jun tnejtl tapi, tzajx twitzju' ja nimxi'x twe' kyetwitzju' tapi ex ponx tk'etzju' nintapi Opel tb'i. <verse number="28" style="v" />Aye'tzu'n pale eb'aj b'inchante jun tnejtl nintapi, teyile junjun b'aj tb'incha'n tpenju' tja, tzajx twitzju' tjpel chej tb'i. <verse number="29" style="v" />Atzu'n Sadok tk'wal Imer, jawb'inchanteju' nintapi tpenju' tja; atzun jun tnejtl jawtb'incha'n Semayiy, tk'wal Sekaniy, ju' toktoq xq'uqil ttziju' tjpel te tjawetzq'ij. <verse number="30" style="v" />Atzun jun tnejtl b'aj kyb'incha'n Ananiy, tk'wal Selemiy, ex Anun, twaqaqi'n tk'wal Salap; atzun jun tnejtl b'aj tb'incha'n Mesulam, tk'wal B'erekyiy, tpenxju' tja. <verse number="31" style="v" />Atzun jun tnejtl nintapi b'aj tb'incha'n Malkyiy, aq'unal ti'j saqpwaq, pon tzmax tk'etz kyja nche ajb'en toj tja Dyos, ex tk'etz kyja xk'aẍlel, twitzju' tjpel xq'uqb'il tb'i, ponx tk'etzju' ja te xq'uqb'il ttx'u'k. <verse number="32" style="v" />Aye'tzu'n aq'unal ti'j saqpwaq kyuk'i'lju' xk'aẍlel eb'aj b'inchante jun tnejtl tapi tzajx tk'etzju' ja te xq'uqb'il toj ttx'u'k ex pon kanun tk'etzju' tjpel, rit tb'i.</para>
  <chapter number="4" style="c" />
  <para style="s1">Kyxmayb'il ajq'oj</para>
  <para style="p">
    <verse number="1" style="v" />Tej tb'inte Sanb'alat qa intoq jaw qb'incha'ntlju'ye' nintapi ti'jileju' nintnam, tzaj tq'oj, aq'witzuntz tuk'i'l ttx'u'jil xmayil kyi'ju' aj Juda <verse number="2" style="v" />xitma'n kyeju' tuk'i'l ex kyeju' xjal te q'oj toj Samarya: ¿Titi' kyximu' ajwe'yaj aj Juda? ¿Ma ktzunlo kxe'lq'o'ntl anb'il kye tu'n kyq'ontl chojb'il toj kywitz? ¿Mujqa kjapumel b'aju' kyaq'un toj jun q'ijx toj kywitz? ¿Mujqa nkyxima'n qa che b'entelju' ab'j b'ajniqe' tz'e'y toju' txqan twab'e'n q'aq' ch'uqu'j te tb'anil ab'j kyu'n? chij.</para>
  <para style="p">
    <verse number="3" style="v" />Atitoqtzun Tob'iy aj Amon tk'etz, ex axjunte q'mante: Naqpena' jun saqb'in jaku' tzaj tx'uyinte nintapi njaw kyb'incha'n qama jax tib'aj, chij.</para>
  <para style="s1">Tna'j Dyos Neemiy</para>
  <para style="p">
    <verse number="4" style="v" />In na'ntzun Dyose' ikjalu: Nman Dyos: b'intza nxi'x che xmayin xjal qi'je'. B'inchama tu'n tokmiltz'uju' taq'wix nkyma'n qi'je' kyib'ajx, ex tu'n tkub'kyij kyu'n kyajq'oj ex tu'n kyxi' iq'i'n toj yajb'il toju' jni'tl tx'otx'. <verse number="5" style="v" />Lalun kub' tnajsa'na kyil, ex lalun tzik'tna'lju kyil tu'na, qu'n matxi' che yolin myab'a'n kyi'ju' nche jaw b'inchantetlju' nintapi, nchije' toj nna'j Dyose'.</para>
  <para style="s1">Xob'tzb'il kyu'n ajq'oj</para>
  <para style="p">
    <verse number="6" style="v" />Xi'tzun qljo'ne' tu'n tjaw b'inchetju' nintapi, matxi'toq jawlq'e toj nik'jan. Intoq che aq'unankye' xjal tuk'i'l tzalajb'il. <verse number="7" style="v" />Atzu'n tej kyb'inte Sanb'alat, Tob'iy, aj Arab'ya, aj Amon exqe' aj Asdod, qa ljo'ntoq t-xi'lq'e tu'n tb'aj b'inchetlu' nintapi ti'jile Jerusalen, exqa matxi'toq tzyet kyjpetu' b'o's b'e, tzaj kytx'u'jil b'a'nxi'x. <verse number="8" style="v" />Kykyaqiltzun junx b'aj kyb'incha'n jun nuk'jtib'il tu'n kyok tzaqpaj q'ojil ti'j Jerusalen tu'n tb'aj kyxitu'n. <verse number="9" style="v" />Ona'ntzun Dyostze', ex e'kub' qq'o'ne' xq'uqil te q'ijtl ex qonik'an te klol qeye'. <verse number="10" style="v" />Kymatzunju' xjal aj Juda: Mache kub' siktiju' iqal tu'n tpaj nimxi'x txqan ttx'anqa'n ab'j, ex lay b'ent tu'n tb'aj qb'incha'ntle' nintapi lu, chechij.</para>
  <para style="p">
    <verse number="11" style="v" />Chechiloju' qajq'oje qa laytoq qb'iye' tpakb'alil exqa laytoq che qile' ajkyoktz b'yolqeye' ex tu'n tkyaj tzaqpaju' aq'untl. <verse number="12" style="v" />Tetzunj ljo'ntoq kyulu' aj Juda najliqe' nqayin kyk'etz q'malte qeye' qatoq che okyel tzaqpaju' xjal lu q'ojil qi'je' toj tkyaqil plaj, <verse number="13" style="v" />nchaq'e' tu'n kykub' tenju' xjal teyile junjun jatu'n kyxq'uqin ti'jxi'ju' nintapi ex toju' jachaq kub'ni lq'e ex ja ta'chaq b'o's b'e, tuk'i'l kyk'uẍtx'e'nb'il, e' kych'ut ex kysmaj. <verse number="14" style="v" />Tetzunj wlonteye' qa intoq che xob', nkub' weye' ex xinma'ne' kyeju' nimaqxjal, kyeju' kawil ex kye txqantl xjal teju' tnam: Lalun che xob'e' kye, kyna'ntze' qa nim te Qman Dyos tipumal ex xob'ajilx, ex che kuwan qeye' tu'n kykletju' txqantl kywnaqile', e'kyk'wale' ex kmyale', e' kxu'jile' ex kyjaye', nchije' kye.</para>
  <para style="p">
    <verse number="15" style="v" />Tetzunj kyb'inteju' qajq'oje qa nk'u'ntltoq qib'e' ex matxitoq kub' t-xitu'n Qman Dyosju' nk'u'ntl ti'j kyu'n, qkyaqilxe' anjqi'je' tk'etzju' nintapi, teyile junjun xi' toju' taq'un. <verse number="16" style="v" />Tzajxtzuntz teju' kmoj lu, nik'janju' nxjale' nche aq'unan toju' aq'untl, atzu'n nik'jantl b'incha'n kyib' iq'i'n kyq'ojb'il, kych'ut, kykolb'il, kysmaj ex kolb'ilkyi'j. Kyaq'kyib'ju' nejenel tu'n kyonin kyi'ju' xjal aj Juda <verse number="17" style="v" />ju' intoq jaw kyb'incha'ntlju' nintapi. Xikyljo'nju' iqal tu'n kyiqan iqtz, nche aq'unan tuk'i'l jun kyq'ob' ex tzyu'n kyq'ojb'il tu'n juntl kyq'ob'. <verse number="18" style="v" />Kykyaqilju' inche aq'unan tu'n tjaw b'inchetlu' tapi majx k'lo'mile kyk'uẍtx'e'nb'il kyk'u'j, ex atiju' q'ajtzalte chun ntx'u'ke', <verse number="19" style="v" />qu'n ojetoq txinma'ne' kyeju' nimaqxjal ex kyeju' kawil ex, kyeju' txqantl xjal teju' tnam: nimaqxi'xju' aq'untl ex nimaqkyqan, ex aq'pu'mile qib' ti'ju' nintapi, najchaqchaq kyxol junjun. <verse number="20" style="v" />Qu'mtzun, kyb'u'yim kyib'e' qk'etze' ja matxa' kyb'ine' chun, k'onilte Qman Dyos quk'i'l toju' q'oj, nchije' kye.</para>
  <para style="p">
    <verse number="21" style="v" />Ikytzu'n, nqo aq'unanxi'ye', njawu'l q'ij ex nex q'ij qu'ne' toju' aq'untl. Nik'janju' xjal majx tzyu'nile kych'ut. <verse number="22" style="v" />Expe' xinma'ntle' kyeju' xjal, toju' tq'ijlalil lu qa kykyaqilx kyuk'i'lxi'ju' onil, ati tu'n kykyajten qonik'an tojxi' Jerusalen, tu'ntzun kyxq'uqin qi'je' te qonik'an ex tu'n kyaq'unan te q'ijtl. <verse number="23" style="v" />Expe' mixti'x inel qiq'i'ne' qi'je', ayine', exqe' nwitze'le' exqe' onil, exqe' xq'uqil nche b'et wuk'i'le', teyile junjun tzyu'nile tch'ut.</para>
  <chapter number="5" style="c" />
  <para style="s1">Q'oj kyxolx aj Juda</para>
  <para style="p">
    <verse number="1" style="v" />Tzaj jun yol kyu'nju' tnam ex kyu'n kyxu'jil toju' tq'ijlalil lu kyi'jxju' kywnaqil aj Juda, <verse number="2" style="v" />junjun kyma qa b'a'npun kyk'wal ex kymyal ex intoq ojqelan tu'n kyxi' jyol triy tu'n lalun che kyim tu'n we'yaj; <verse number="3" style="v" />junjuntl kyma qa tu'n tpaju' mixti' kywa ojetoq kyej kyq'o'n tu'jil kytx'otx', e' kyawb'il ex kyja tu'n tpaj kych'ex, <verse number="4" style="v" />junjuntl kyma qa matxi'toq kyej kyq'o'n kytx'otx' ex kyawb'il ti'j pwaq ch'ex tu'n tchjetju' chojb'il te nimaqkawil. Expe' intoq kyma'ntl: <verse number="5" style="v" />Ikxse'nqe' qwnaqile' ikyqo'xtzun qe'ye', junx qyajile' kyuk'i'l; junqe'xju' qk'wale' kyuk'i'l kyk'wal. Tu'npetzunju', ati tu'n kyxi' qk'a'yi'ne' qk'wale' ex qmyale' te lq'o'n majin. Expe' matxi' che'x junjun qmyale' te lq'o'n majin, ex mixti'x juntl tu'me'l tu'n qb'inchanteye' tu'n tmyet, qu'n junxi'tl tajawju' qtx'otx'e' ex qawb'ile', chechij.</para>
  <para style="p">
    <verse number="6" style="v" />Tetzunj nb'inteye' kyol te yajte'n, tzaj ntx'u'jile' tu'n tpaj. <verse number="7" style="v" />Tb'ajlenxi'tzun nxima'ne' b'a'nxi'x, eb'aj ntzak'u'ne' nimaqxjal exqe' nche kawin tu'n tpaju' nkub' kyq'o'n jun iqtz lu kyib'aju' kywnaqil. Ex ok jun b'uyjtib'il kye kykyaqil xjal wu'ne' tu'n tnk'etti'j ja'lu, <verse number="8" style="v" />xi'tzun nma'ntze' kye: Matxi' tz'okqe' tilil qu'n ex matxi' che kolpetu' qxjalil aj Juda qu'ne' kyeju' nimaqtnam min nche niman te Dyos ja xa'na' k'a'yi'nqe'; ¿tzun ja'lu ma matxi' che'x kyk'ayi'n jumajtle' tu'n qxi'tle' kolpilkye?, nchije' kye.</para>
  <para style="p">Mixti'xte tzaj kyma'n, qu'n mixti'x b'ent ttzaq'wet kyu'n. <verse number="9" style="v" />Xi'tzun nma'ntle' kye: Myab'a'nte' nkyb'incha'ne'. Ma'wtlo txikyxob'le'n ch'i'ne' twitz Qman Dyos, tu'n miche xmayina'ju' qajq'oj qi'j, ju' min nche niman te Dyos. <verse number="10" style="v" />Ex ikxqe' kyuk'i'lu' nwitze'le' exqe' onilweye', matxi' txi'xi' qq'o'nqe' pwaq ex triy ch'ex kye; qu'mtzun ¡Kb'el qnajsa'nte' kyk'as lu! <verse number="11" style="v" />Ex kxe'l nkub'sa'ne' kyeye' tu'n t-xikyanjsa'n ti'ju'ye' kytx'otx', e' kyawb'il, e'tqan ky-olib'o ex kyja ja'loxi'x, ex tu'n kychjonteju' kyk'a's ati kyeye', qa pwaq, twitz awal k'ok'e'kywitz, b'in mujqa aseyt, nchije' kye. <verse number="12" style="v" />Tzajtzun kytzaq'we'n: K'anjel qanjsa'nqe' ti'j tkyaqil ja'lu, ex lay txi' qqani'ntle' kye. Qb'incha'qe' tkyaqil kse'nxju' matxi' tmaya, chechij.</para>
  <para style="p">E'tzajtzun ntxko'ne' pale, ex kywitzku' xinma'ne' kye tu'n kytziyante twitz Dyos tu'n tjapun kyu'n aju' matxi'toq kyma. <verse number="13" style="v" />Expe' elnchto'ne' ti'j nxb'alune' ex nmaye': Ikywittzun b'je'la' tchto'n Dyos ti'jxi'ju' kyja ex ti'ju' ati kye, kykyaqilju' min xjapunju' yol lu kyu'n, tu'n tb'je'l iq'i'nju' ati kye ja'lo, nchije'. Ikxwitju', chechi kykyaqilju' txqan tnam xjal tzaj kytzaq'we'n, ex jawkyajwali'n Qman Dyos.</para>
  <para style="s1">Xtalb'il tb'incha Neemiy</para>
  <para style="p">Japunju' yol kyu'n xjal kse'nxju' kyma, <verse number="14" style="v" />ex toju' kab'lajoj (12) ab'q'i, tzajx toju' q'ij te tjunaqi'n (20) ab'q'i tej woktq'o'ne' nimaqkawil Artajerjes te kawil toju' tnej tx'otx' Juda tzmax tpon toju' tjunaq kab'lajoji'n (32) ab'q'i toklen te nimaqkawil, mixti' ajb'en twi' wab' weye' ex kyeju' onilweye', kse'nxju' ati woklene' ti'j te jun kawil. <verse number="15" style="v" />Aye'tzunkye' kawil eb'aj ten nejtl nwitze', ma'xi'x che b'jo'kten yajulteju' tnam, qu'n atl junjun q'ij intoq kyqani'n kab'naq (40) saqpwaq te twi' kywa ex kyk'wa' b'in. Expe' intoq che yajunju' kymajin kyi'ju' tnam. Ayintzunwe' min xnb'inchaye' ikju', te jun ninb'il twitz Qman Dyos.</para>
  <para style="p">
    <verse number="16" style="v" />Ex juntl, japunwe' waq'un tu'n tjaw tb'inchetlju' nintapi ti'ju' nintnam, ex min xnloq'we' ntx'otx'. Exqe'tzu'n nmajine', kykyaqilx e'aq'unan ti'ju' aq'untl. <verse number="17" style="v" />Intoqpe' che kub' qe wuqnaq lajoj (150) xjal wal ti'ju' nmese', e'aj Juda toju' tnam, exqe' nimaq kyoklen toju' kawb'il, kyuk'i'lxi' nche tzaj kyoju' nimaqtnam nqaku' xb'etzalqeye'. <verse number="18" style="v" />Atzunju' ntoq kub' b'inchet te wab'j wu'nxe' atl junjun q'ij: jun wakx, waqaq tb'anil rit, ex txqan ek'; ex atitoq txqan b'in atl lajojchaq' q'ij. Tu'npetzu'n ayintoqe' kawil, min xinqani'nwe' twi' nwaye', qu'n nimxi'xtoqu' iqtz tib'aju' tnam lu. <verse number="19" style="v" />¡Ka'yintza tkyaqilju' matxi' nb'inchaye' teju' tnam lu Nman Dyos!</para>
  <chapter number="6" style="c" />
  <para style="s1">Jawkyiq'i'nkyib' xjal ti'j Neemiy</para>
  <para style="p">
    <verse number="1" style="v" />Tetzunj kyb'inte Sanb'alat, Tob'iy, Kyesem aj Arab'ya exqe' txqantl qajq'oje qamatxi'toq jaw nb'incha'n jumajtle' nintapi ex mixti'tl jun xopa'j kyejten (Maskyepe' na'mxtoq kyokq'etju' tjpel jatu'n kyoka'), <verse number="2" style="v" />tzaj kysma'n Sanb'alat ex Kyesem jun tqanil weye' tu'n qb'uyinte qib'e' kyuk'i'l toj junju' najb'il toju' b'ya' Ono. Atoqtzun kyajb'ilju' tu'n nb'o'lje' kyu'n. <verse number="3" style="v" />Exi'tzun nchq'o'ne' nsanjelale' q'malte kye qa nchin aq'unane' ti'j jun aq'untl nim toklen, ex lay b'ent tu'n nxiye', qu'n kjel tenpuju' aq'untl qama kyej nq'o'ne' tu'n qxi'ye' b'ilkye. <verse number="4" style="v" />Kyajmaj tzaj kysma'n axtqanilju', ayintzunwe' axtzaq'web'lju' xinq'o'ne' kye.</para>
  <para style="p">
    <verse number="5" style="v" />Tzajtzun tchq'o'n Sanb'alat jun tmajin, q'olte axtqanilju' weye' toj tjwe'yi'n maj, toj jun u'j jqo'n, <verse number="6" style="v" />intoq tma'n: inkyyoli'n xjal kyxol, ikyx intma'n Kyesem, qa nkynk'u'ne' ti'j kyuk'i'lju' aj Juda tu'n tjaw kyiq'inkyib'e' ti'ju' nimaqkawil, qu'mtzun njaw kyb'incha'n jumajtle' nintapi. A nq'manjtzu' toju' yol nb'et qa aya k'okyel te kynimaqkawil, <verse number="7" style="v" />ex matxi' che oktq'o'na t-sanjelal Dyos tu'n tokq'o'na kyu'n te nimaqkawil toj Jerusalen ex tu'n kymante qa atitl nimaqkawil toj Juda. Jaku' ponju' yol lu toj twi' nimaqkawil Artajerjes, qu'mtzun kuttzaja ex qo yolilku' tib'aj, chiju' tzaj kytz'ib'a'n.</para>
  <para style="p">
    <verse number="8" style="v" />Xi'tzun nsma'ne' tzaq'web'lte, xinma'ne' te qa mya axju' nq'umli lu, qu'n axte njaw ximante. <verse number="9" style="v" />Qu'n ate'ktoq xob'tzalqeye', kyajb'iltoq tu'n qkub'numje' ex tu'n laluntoq japun b'aju' aq'untl qu'ne'; ayintzunwe' oktililxi'xtl wu'ne'. <verse number="10" style="v" />Yajxitzuntl nxi'ye' tja Semayiy, tk'wal Delayiy ex tchman Meetab'el, ju' matxi'toq tz'okx tjpu'ntib' toju' tja, ex tzaj tma'n weye': Qb'u'yimqib' toju' tja Dyos, toju' ja xjan, ex che qjpumitzju' tjpel, qu'n inkyxima'n tu'n kyul b'yolteya toju' qonik'an ja'lo, chij. <verse number="11" style="v" />Ayintzunwe' xintzaq'we'ne' te: Minti' nche oqkye' ichan kse'n ayine' ex minti' nche okx toju' tja Dyos tu'n tkletju' kychib'jil. Ayinwe', lay chin okxe', nchije' te. <verse number="12" style="v" />Expe' elnnik'e' ti'j qa myaju' Dyos yolin toj ttzi, intoq tma'n tkyaqil ja'lu wi'je' qu'n ojetoq tk'am pwaq kye Sanb'alat ex Tob'iy. <verse number="13" style="v" />Chjonjtz te tu'n tokten xob'tzal weye', tu'ntzun nb'inchan ile' twitz Dyos. Iktzu'n tu'n kyolintzuntz taq'wix wi'je' ex tu'n tel nch'ixawe' kyu'n. <verse number="14" style="v" />¡Nman Dyos: na'nku'ya matxi' kyb'incha Sanb'alat ex Tob'iy! ¡Ex lalun tzik' kyna'lu' Noadiy, ju' sanjelal, tu'na, exqe' txqantl sanjelal eb'jo'kten xob'tzal weye'! <verse number="15" style="v" />Japun b'aju' nintapi toju' q'ij junaqjo' (25) tajlalju' xjaw Elul, b'aj kab'naq kab'lajoj (52) q'ij ti'ju' aq'untl. <verse number="16" style="v" />Tetzunj kyb'i'nteju' qajq'oje, tzajtzun nim xob'eltz kyi'j kykyaqilju' xjal ate' kyoju' nimaqtnam ate' qi'jileye' ex majxkub' naju' kyninb'ilkyib', qu'n kane toj kywitz qa tu'n tonb'il Qman Dyos b'enta'ju' aq'untl lu.</para>
  <para style="p">
    <verse number="17" style="v" />Nim u'j b'et kyxol Tob'iy kyuk'i'lju' xjal nimaq kyoklen toj Juda toju' tq'ijlalil lu. <verse number="18" style="v" />Qu'n nim xjal mujlitoq kytzi tuk'i'l Tob'iy, tu'n tpaju' jiyb'aj te Sekaniy, tk'wal Ara, ex tu'nju' ojetoq mje Joanan, ju' tk'wal, tuk'i'lu' tmyal Mesulam, tk'wal B'erekyiy. <verse number="19" style="v" />Inxi'xtoq kyma'n xjal nwitze' qa majx b'a'nju' Tob'iy, exju' in nma'ne' intoq b'ajx kyma'n te. Atzunte Tob'iy, intoq che tzaj t-sma'n u'j weye' tu'n nxob'e'.</para>
  <chapter number="7" style="c" />
  <para style="s1">Eb'jo'k tq'o'n Neemiy q'eltwitz aq'untl</para>
  <para style="p">
    <verse number="1" style="v" />Tej tb'aj b'inchet jumajtlu' nintapi ex eb'aj b'inchetju' tjpel, eb'jo'k q'et xq'uqil ttzi tjpel, e'aj b'itzal ex aj Leb'i. <verse number="2" style="v" />Aye' e'oknq'o'nju'ye' nuk'ul kyib'aju' xjal toj Jerusalen, a Anani, witz'ine', ex Ananiy, ju' chaq'ul kye xjal q'ojil kyoj nimaqtnam, jun ichan q'uqli tk'ujlalil ex nxob'xi'x te Dyos kwitz txqan xjal. <verse number="3" style="v" />Xinma'ne' kye qa mixti' tu'n kyjqet tjpelju' nintnam Jerusalen, ajxi' tjaw q'ij, ex ati tu'n kyjpet ex tu'n kyxtanet b'a'nxi'x ate'ku'ju' xq'uqil jachaq tu'n kyxq'uqina'. Ex eb'jo'k nq'o'ne' xq'uqil kyxolxu' xjal najliqe' toj Jerusalen, tu'n kyxq'uqin junjun jachaq tu'n kyxq'uqina', ex junjuntl tu'n kyxq'uqin twitzilexu' kyja. <verse number="4" style="v" />Nimtoqu' nintnam ex najchaq pomna' ttxa'n, aye'tzu'n xjal naq jte'xtoq najliqe' toj qu'n na'mxtoq kyjaw b'inchetlu' ja toj.</para>
  <para style="s1">Aye' anjtzkyi'j kyxolju' exniqe'toq iq'i'n</para>
  <para style="r">(<ref loc="EZR 2:1-70">Esd 2.1-70</ref>)</para>
  <para style="p">
    <verse number="5" style="v" />Kub'tzun tq'o'n Dyos toj nnab'le' tu'n kyb'aj b'u'yitju' xjal nimaq kyoklen, exqe' ati kyoklen toj kawb'il exqe' tnam, tu'n tku'x tz'ib'etju' kyib' te jayi'nchaq, ex knetju' u'j wu'ne' ja tz'ib'a'na'qe' eb'ju'l nejtl, teyile junjun k'loj toj kyjakyib'. A tz'ib'a'nju' toj ikjalu:</para>
  <para style="p">
    <verse number="6-7" style="v" />Aye' aj Israel ja'lu itz'jniqe' toj Juda eb'ajx tiq'i'n nimaqkawil Nab'ukodonosor toj B'ab'ilon, ex anjtzkyi'j yajxi'tl toj Jerusalen ex toj junjuntl najb'il toj Juda, teyile junjun tojilex ttanam, aye' nejenelju' kye aye' Sorob'ab'el, Joswe, Neemiy, Asariy, Raamiy, Naamani, Mardokyey, B'ilsan, Misperet, B'iwb'ay, Newum ex B'aana:</para>
  <para style="q">
    <verse number="8" style="v" />Jo'k'al wajxaqnaq kab'lajoj (2,172) tyajajil Paros;</para>
  <para style="q">
    <verse number="9" style="v" />atzun wajxalajnaq kab'lajoj (372) tyajajil Sepatiy;</para>
  <para style="q">
    <verse number="10" style="v" />atzun junk'al kab'lajnaq kab'lajoj (652) tyajajil Ara;</para>
  <para style="q">
    <verse number="11" style="v" />atzun wuqk'al wajxaqlajoj (2,818) tyajajil Paat-moab', tzajni kyyajil kyi'j Joswe ex Joab';</para>
  <para style="q">
    <verse number="12" style="v" />atzun oxk'al kab'naq kyajlajoj (1,254) tyajajil Elam;</para>
  <para style="q">
    <verse number="13" style="v" />atzun kab'k'al kab'naqjo' (845) tyajajil Satu;</para>
  <para style="q">
    <verse number="14" style="v" />atzun junk'al wajxaqlajnaq (760) tyajajil Sakay;</para>
  <para style="q">
    <verse number="15" style="v" />atzun junk'al kab'lajnaq wajxaq (648) tyajajil B'inuy;</para>
  <para style="q">
    <verse number="16" style="v" />atzun junk'al junlajnaq wajxaq (628) tyajajil B'eb'ay;</para>
  <para style="q">
    <verse number="17" style="v" />atzun jo'k'al qaqlajnaq kab'e' (2,322) tyajajil Askad;</para>
  <para style="q">
    <verse number="18" style="v" />atzun junk'al oxlajnaq qaq (666) tyajajil Adonikam;</para>
  <para style="q">
    <verse number="19" style="v" />atzun jo'k'al oxnaq wuq (2,067) tyajajil B'ikb'ay;</para>
  <para style="q">
    <verse number="20" style="v" />atzun junk'al kab'lajnaq o'lajoj (655) tyajajil Adin;</para>
  <para style="q">
    <verse number="21" style="v" />atzun kyajnaq wajxaqlajoj (98) tyajajil Ater, tzajni kyyajil ti'j Esekyiy;</para>
  <para style="q">
    <verse number="22" style="v" />atzun qaqlajnaq wajxaq (328) tyajajil Asum;</para>
  <para style="q">
    <verse number="23" style="v" />atzun qaqlajnaq kyaje' (324) tyajajil B'esay;</para>
  <para style="q">
    <verse number="24" style="v" />atzun jo'naq kab'lajoj (112) tyajajil Arip;</para>
  <para style="q">
    <verse number="25" style="v" />atzun kyajnaq o'lajoj (95) tyajajil Kab'aon;</para>
  <para style="q">
    <verse number="26" style="v" />atzun b'eljojnaq wajxaq (188) ichan aj B'elen ex aj Netopa;</para>
  <para style="q">
    <verse number="27" style="v" />atzun qaqnaq wajxaq (128) aj Anatot;</para>
  <para style="q">
    <verse number="28" style="v" />atzun kab'naq kab'e' (42) aj B'et-asmab'et;</para>
  <para style="q">
    <verse number="29" style="v" />atzun junk'al wuqlajnaq oxe' (743) aj Kyiryat-jearim, aj Kyepira ex aj B'eerot;</para>
  <para style="q">
    <verse number="30" style="v" />atzun junk'al junlajnaq jun (621) aj Rama ex aj Keb'a;</para>
  <para style="q">
    <verse number="31" style="v" />atzun qaqnaq kab'e' (122) aj Mikmas;</para>
  <para style="q">
    <verse number="32" style="v" />atzun qaqnaq oxe' (123) aj B'etel ex aj Ay;</para>
  <para style="q">
    <verse number="33" style="v" />atzun kab'naq kab'lajoj (52) aj Neb'o.</para>
  <para style="q">
    <verse number="34" style="v" />Oxk'al kab'naq kyajlajoj (1,254) tyajajilu' juntl Elam;</para>
  <para style="q">
    <verse number="35" style="v" />atzun qaqlajnaq (320) tyajajil Arim;</para>
  <para style="q">
    <verse number="36" style="v" />atzun wuqlajnaq jwe' (345) aj Jeriko;</para>
  <para style="q">
    <verse number="37" style="v" />atzun junk'al qaqlajnaq jun (721) aj Lod, aj Adid ex aj Ono;</para>
  <para style="q">
    <verse number="38" style="v" />atzun b'eljojk'al qaqlajnaq lajoj (3,930) aj Senaa.</para>
  <para style="q">
    <verse number="39" style="v" />Kab'k'al wajxaqnaq oxlajoj (973) pale tyajajil Jedayiy, kyxol tyajajil Joswe;</para>
  <para style="q">
    <verse number="40" style="v" />atzun kab'k'al kab'lajnaq kab'lajoj (1,052) tyajajil Imer;</para>
  <para style="q">
    <verse number="41" style="v" />atzun oxk'al kab'naq wuq (1,247) tyajajil Pasur;</para>
  <para style="q">
    <verse number="42" style="v" />atzun kab'k'al lajnaq wuqlajoj (1,017) tyajajil Arim.</para>
  <para style="p">
    <verse number="43" style="v" />Oxnaq kyajlajoj (74) aj Leb'i kyyajajil Joswe ex Kadmyel, ex tyajajil Odab'iy.</para>
  <para style="p">
    <verse number="44" style="v" />Wuqnaq wajxaq (148) aj b'itzal tyajajil Asap.</para>
  <para style="p">
    <verse number="45" style="v" />Atzun qaqnaq wajxaqlajoj (138) xq'uqil ttzija, kyyajajil Salum, Ater, Talmon, Akub', Atita ex Sob'ay. <verse number="46" style="v" />Aye' ajb'elju' toj tja Dyos kyyajajil Siya, Asupa, Tab'aot, <verse number="47" style="v" />Kyeros, Syaa, Padon, <verse number="48" style="v" />Leb'ana, Akab'a, Salmay, <verse number="49" style="v" />Anan, Kidel, Kaar, <verse number="50" style="v" />Reayiy, Resin, Nekoda, <verse number="51" style="v" />Kasam, Usa, Pasea, <verse number="52" style="v" />B'esay, Meunim, Nepusim, <verse number="53" style="v" />B'akb'uk, Akupa, Arur, <verse number="54" style="v" />B'aslut, Meyda, Arsa, <verse number="55" style="v" />B'arkos, Sisara, Tema, <verse number="56" style="v" />Nesiya ex Atipa.</para>
  <para style="p">
    <verse number="57" style="v" />Aye'tzu'n kyyajajil ajb'el te Salomon aye' kyyajajil Sotay, Soperet, Peruda, <verse number="58" style="v" />Jaala, Darkon, Kidel, <verse number="59" style="v" />Sepatiy, Atil, Pokyeret-aseb'ayim ex Amon. <verse number="60" style="v" />B'elajnaq kab'lajoj (392) kyb'aju' ajb'el toj tja Dyos kyuk'i'lxi' ajb'el te Salomon tu'n kykyaqil.</para>
  <para style="p">
    <verse number="61" style="v" />Aye'tzu'n e'tzaj kyoju' tnam Tel-mela, Tel-arsa, Kyerub', Adon ex Imer, ju' min b'ent kyek'unte qa aj Israel kyyajil mujqa naq witze'ljxi'qe', aye' ja'lu: <verse number="62" style="v" />kyyajajilu' Delayiy, Tob'iy, Nekoda, junk'al kab'lajnaq kab'e' (642) kyb'aj. <verse number="63" style="v" />Aye'tzu'n kywitze'lju' pale: kyyajajil Ob'ayiy, Kos ex B'arsilay, mje tuk'i'l jun tmyal B'arsilay aj Kalaad, ex axu' tb'i oktq'o'n te tb'i. <verse number="64" style="v" />E'jyon kyb'iju' xjal lu toju' u'j jatz'ib'ana' qe'ju' toj kyjakyib' kyuk'i'l, mixnati' knet kyu'n atzu', eb'je'l iq'i'n kyxolu' pale. <verse number="65" style="v" />Expe' tchaq'ju' kawil tu'n lalun txi kywanju' wab'j xjansa'n, tzmaxi'j ajtmante jun pale telenxi' tnik' tu'nel Urim ex Tumin.</para>
  <para style="p">
    <verse number="66" style="v" />Jo'mutx' jo'k'al wajxaqlajnaq (42,360) kyb'aju' tnam tu'n kykyaqil, <verse number="67" style="v" />expe' min eb'jo'kju' ichan ex qya lq'o'n kymajin toj tajlal, wajxaqlajk'al qaqnaq wuqlajoj (7,337) kyb'aj. Ex atitoq kab'lajnaq jwe' (245) aj b'itzal ichan ex qya kyxol. <verse number="68" style="v" />Expe' ate'toq junk'al qaqlajnaq qaqlajoj (736) kyb'a'nchej, kab'lajnaq jwe' (245) mul, <verse number="69" style="v" />junk'al junaq o'lajoj (435) kamey ex qaqlajk'al qaqlajnaq (6,720) b'ur.</para>
  <para style="p">
    <verse number="70" style="v" />Ate' junjun nejenel kye junjun ja xjal kyaq' oyaj te o'nb'il teju' aq'untl; xitq'o'n kawil masch'i'n wuqlajoj lib'r tk'i' nik'jan q'anpwaq toju' k'ub'l pwaq, atzun kab'naqlajoj (50) nimaqlaq ex junk'al qaqnaq lajoj (530) kyxb'alun pale ku'j. <verse number="71" style="v" />Aye'tzu'n nejenel kye junjun ja xjal xikyq'o'n oxe' kyintal tk'i' kab'naq kab'lajoj lib'r (3.52) q'anpwaq ex junaq qaq kyintal tk'i' oxnaq kab'e' lib'r (26.62) saqpwaq toju' k'ub'l pwaq teju' aq'untl; <verse number="72" style="v" />Aye'tzu'n jte'tl xjal toju' tnam xikyq'o'n oxe' kyintal tk'i' kab'naq kab'lajoj lib'r (3.52) q'anpwaq, junaq kyaje' kyintal tk'i' junaq lib'r (24.20) saqpwaq, ex oxnaq wuq (67) kyxb'alun pale ku'j.</para>
  <para style="p">
    <verse number="73" style="v" />Eb'ajkub' najanju' pale, aj Leb'i, xq'uqil ttzija, aj b'itzal, e'xjal toju' tnam, ajb'el toj tja Dyos ex kykyaqil aj Israel, tojilex kynajb'il.</para>
  <para style="s1">Jaw ẍch'i'n tkawb'il Dyos kywitz xjal</para>
  <para style="p">Tojtzu'n twuqi'n xjaw, matxitoq che kub'najan aj Israel tojile kynajb'il.</para>
  <chapter number="8" style="c" />
  <para style="p">
    <verse number="1" style="v" />B'ajtzun kyb'u'yi'n kyib' kykyaqilju' tnam ja nkychmo'na' kyib' xjal twitzju' tjpel a' tb'i, ex xikyma'n te Esdras xnaq'tzal tu'n ttzaj tiq'i'n tu'jil tkawb'il Moyses, ojetoq tzaj tq'o'n Qman Dyos kye aj Israel. <verse number="2" style="v" />Toj tnejel q'ij te twuqi'n xjaw, tzaj tiq'i'n pale Esdras tu'jil kawb'il kywitzju' b'u'yi'ntoqkyib', e'ichan ex qya ex kykyaqilju' intoq che ximantl; <verse number="3" style="v" />ex jawt-ẍch'i'n kywitz kykyaqil jamajx ate' xjal tpenju' tjpel a' tb'i, tzyet-x te prim ex tzmax te wanq'ij.</para>
  <para style="p">Tkyaqilju' tnam intoq kub' kyb'in tej tjaw ẍch'i'n tu'jil tkawb'il Dyos. <verse number="4" style="v" />Wa'ltoqju' xnaq'tzal Esdras tib'aj jun t-xwe'lb'il tze b'incha'n tu'n tajb'en te. Ex wa'lqe'toqju' Matatiy, Sema, Anyiy, Uriy, Ilkyiy ex Maaseyiy, toj tb'a'nq'ob'. Ex wa'lqe'toq Pedayiy, Misael, Malkyiy, Asum, Asb'adana, Sakariy ex Mesulam, toj tnayaj. <verse number="5" style="v" />Jawtzun tjqo'n Esdras u'j kywitz kykyaqilju' tnam, qu'n q'ancha'lxi'xtoq jawl kye kykyaqil; tetzunj tjaw tjqo'nju' u'j, kykyaqilu' xjal eb'ajkub' we'. <verse number="6" style="v" />Jawtzun tajwali'n Esdras Qman Dyos nimtipumal, ex tkyaqilju' tnam jaw kyq'o'n kyq'ob' jawtl ex xikytzaq'we'n: Ikxwitju', Ikxwitju', chechij. E'kub' joqetzuntz majx ku'pun kyplaj twitz tx'otx', ex ek'ulun te Qman Dyos.</para>
  <para style="p">
    <verse number="7" style="v" />Aye' aj Leb'i Joswe, B'ani, Sereb'iy, Jamin, Akub', Sab'tay, Odiy, Maaseyiy, Kyelit, Asariy, Josab'ad, Anan ex Pelayiy inche'x chik'b'a'nteju' tkawb'il Dyos kye tnam. Tej wa'lqe'toqju' xjal ja ta'qe', <verse number="8" style="v" />kuwtoq njaw kyẍch'i'n tu'jil kawb'il, ex ntoq jaw kypju'n tu'n tkyaj chik'exi'xu' ntma'n. <verse number="9" style="v" />Ex tkyaqilju' tnam intoq che o'q' tej kyb'inteju' ntma'n tkawb'il Dyos, ikxju' kawil Neemiy ex xnaq'tzal ju' pale Esdras, exqe' aj Leb'i nche'x chik'b'ante tkawb'il Dyos kye tnam, xikyma'n kye kykyaqil tu'n lalun che b'isun ex tu'n lalun che oq', qu'n aju' q'ij lu tu'n tajb'en te Qman Dyos. <verse number="10" style="v" />Xipetma'ntl Esdras kye: kukyxi'ye' ex che wanqe'ye' ti'ju' tb'anilxi'x, che k'wanqe' b'ine' chi' ex che kytxkonqe'xju'ye' mixti' kywa b'incha'n, qu'n xjansa'nte' q'ij lu te Qman Dyos. Lalun che b'isune', qu'n a qkuwalju' tzalajb'il te Qman Dyos.</para>
  <para style="p">
    <verse number="11" style="v" />Ikyqe'xju' aj Leb'i intoq che'x kymyo'n xjal, xikyma'n tu'n kyqjen ex tu'n lalun che oq'tl, qu'n te Qman Dyosju' q'ij lu. <verse number="12" style="v" />Kykyaqiltzunju' xjal eb'ajx wal ex k'wal, ex tu'n txikyq'o'n kywaju' mixti' kywa ex tu'n tkub' kyik'sa'nju' ninq'ij, qu'n matxi'toq tz'el kynik' ti'ju' xixnaq'tza'n kye.</para>
  <para style="s1">Ik'saj Kyq'ij pach tq'ob' tze</para>
  <para style="p">
    <verse number="13" style="v" />Te juntl q'ij, b'aj kyb'u'yi'n kyib' kykyaqilju' nejenel kye junjun ja xjal, exqe' pale exqe' aj Leb'i, tuk'i'l Esdras xnaq'tzal tu'n kyxnaq'tzantekyib' ti'ju' tkawb'il Dyos, <verse number="14" style="v" />ex b'je'l kyu'n tz'ib'a'n qa ojetoq tchaq' Qman Dyos toj ttzi Moyses, qa atitoq tu'n kynajan aj Israel kyoj pach tq'ob' tze toju' tq'ijlalilu' ninq'ij toju' twuqi'n xjaw. <verse number="15" style="v" />Extzun tqaniltz kyoj kykyaqilju' nimaqtnam ex toj Jerusalen, tu'n kyexju' xjal jyolte tq'ob' tze olib'o tuk'i'lxi' t-xaq kyoj k'ul, ex tq'ob' ktxab', tut ex alkyexku' juntl tze pujin tu'n kyb'inchetju' pach, kse'nxju' tz'ib'a'n toju' tkawb'il Dyos. <verse number="16" style="v" />Eb'je'xtzu'n xjal jyolte ex anjtzkyi'j iq'i'n tq'ob' tze kyu'n tuk'i'lxi' t-xaq tu'n tjaw kyb'incha'n kypach tq'ob' tzeyile, kyib'aj ja ex kywi' pe'n, ex tpenju' tja Dyos, ex ja nchi tena' nim xjal ttziju' nintjpel a' tb'i ex ttziju' nintjpel Eprayin tb'i. <verse number="17" style="v" />Kykyaqilu' tnam xjal b'je'xniqe'toq q'i'n ex eb'ju'l jumajtl, kyb'incha kypach tq'ob' tze ex eb'jo'kxten toj, qu'n b'ajxtoq b'inchet ja'lu ttzajlenx toj tq'ijlalil Joswe, tk'wal Num, tzmax toju' tq'ijlalil lu. Ex ojexi'x che tzalaj. <verse number="18" style="v" />Kub'kyik'sa'n wuq q'iju' ninq'ij; tzyet-x tnejel q'ij tzmax te b'ajsb'il, intoq jawt-ẍch'i'n Esdras tu'jil tkawb'il Dyos tkyaqil q'ij; tojtzun twajxaqi'n q'ij ok jun b'uyjtib'il nim toklen, kse'nxju' nb'inchet tnejel.</para>
  <chapter number="9" style="c" />
  <para style="s1">B'jatztpa'n Esdras kyil aj Israel</para>
  <para style="p">
    <verse number="1" style="v" />B'aj kyb'u'yi'n kyib'u' aj Israel toj junaq kyaje' (24) tajlalxju' xjaw tu'n kymewayin; b'jo'k kyq'o'n kyxb'alun te b'is ex jax kyq'o'n tx'otx' toj kywi', <verse number="2" style="v" />eltzun kypa'n kyib' kyi'ju' najchaq xjal, e'kub' we' ex okkyq'o'n kyil kyi'j ex kyilju' ojtxi' kychman. <verse number="3" style="v" />Tetzunj wa'lqe'toq jaxu' te'qe', oxe' or jaw ẍch'i'nju' tkawb'il Qman Dyos kywitz kykyaqil, ex oxe' ortl b'jawtz kypa'n kyil ex ek'ulun te Qman Dyos. <verse number="4" style="v" />Yajxi'tzuntl eb'jaxu' aj Leb'i Joswe, B'inuy, Kadmyel, Seb'aniy, B'inuy, Sereb'iy, B'ani ex Kyenani, twi' xwe'l ex ena'n Dyos tuk'i'l tq'ojq'ojel kywi' kuw; <verse number="5" style="v" />kymatzun aj Leb'i Joswe, Kadmyel, B'inuy, Asab'niy, Sereb'iy, Odiy, Seb'aniy ex Petaiy, kjalu: Che we'ktze', kyajwalinktze' Qman Dyos tejumajx ex kukxju'. ¡Ajwalinjtzxwitju' tb'i nim toklen ex tb'anilxi'x tuk'i'l ky'i'wb'il ex b'itz! chechij.</para>
  <para style="p">
    <verse number="6" style="v" />E'na'ntzun Dyosu' tnam kjalu: Ateju'ya Dyos Manb'aj ex mix-a'lo' juntl. Aya b'inchante kya'j ex tzmax tib'ajxi' kya'j, ex kykyaqilju' che'w; aya b'inchante tx'otx' ex tkyaqilju' ati twitz, exqe' ninnjab' ex kykyaqilju' ati kyoj. Aya nq'onte kychwinqlal kykyaqilju' ti'xti'. Qu'mtzun nche k'ulunju' che'w twitz kya'j teya.</para>
  <para style="p">
    <verse number="7" style="v" />Taye, aya Dyos jaw sk'onte Ab'ram; etztiq'i'na toj Ur, ninkytanam aj Kaldey, ex oktq'o'na tb'i Ab'raam. <verse number="8" style="v" />Tka'yiya qa jun ichan q'uqlitoq tk'u'j ti'ja, tb'inchaya jun nak'b'il tuk'i'l, ex kyej b'entti'j jun tyola tuk'i'l qatoq ktzajel tq'o'na kytx'otx' aj Kanaan, itit, amorey, aj Perisya, jeb'usey ex aj Jerjesey, kyeju' tyajajil; ¡ex matxi' japun tyola, qu'n kukxu' njapunta tyol! <verse number="9" style="v" />Tka'yiya qa intoq che yajtiju' ojtxi' qchmane' toj Ejipt, ex tb'iju'ya kyoq'el tk'etzju' ninnjab' tok tb'i kyaq. <verse number="10" style="v" />Tb'inchaya nimaq b'a'nq'ob'aj te lab'te'nqe' ti'j paraon, kyi'j kykyaqilju' tmajin ex kyi'j kykyaqilju' xjal toju' ttx'otx', qu'n tilju'ya myab'a'n intoq kyb'incha' kyi'ju' aj Israel. Ex tkanb'aya jun tyolinjtza b'a'n tzmax ja'lo. <verse number="11" style="v" />Kub' taq'pu'nju'ya ninnjab' toj kab'e' kywitz, ex eb'jik'x toj nky'ajchaqju' ninnjab' tib'aj tx'otx' tzqij; aye'tzu'n kyajq'oj eku'x tmulq'i'na tzmax t-xexi', kse'n jun ab'j toj a' nim t-xe. <verse number="12" style="v" />Ex eb'ajx t-ẍaqlu'na te q'ijtl tjaq' jun tnej muj, atzu'n te qonik'an tjaq' jun tnej q'aq', tu'n tk'ant toju' kyb'e ljo'ntoq kyu'n.</para>
  <para style="p">
    <verse number="13" style="v" />Yajxi'tzuntl kb'u'la twi' witz Sinayi, ex tzaj yolina kyuk'i'l tzmax toj kya'j; e'tzaj tq'o'na chaq'b'il tnik'alkyi'j kye, xnaq'tzb'il axqe'xi'x, e'kawb'il ex chaq'b'il tb'anilqe'. <verse number="14" style="v" />Ex xit-xnaq'tza'na kye tu'n kyxjansanteju' q'ij te ojlab'l, ex e'tzaj tq'o'na chaq'b'il, e'axxi'x xnaq'tzb'il kye toj ttzi tmajina Moyses. <verse number="15" style="v" />Expe' tzaj tq'o'na wab'j te toj kya'j kye tu'n tq'jen we'yaj kyi'j ex a' toj pik tu'n tq'jen k'waj kyi'j. Xitma'ntzuntza kye tu'n kyokx toju' tx'otx' tziya'ntltoq tu'n ttzaj tq'o'na kye. <verse number="16" style="v" />Aye'tzunkye exqe' ojtxi' qyajilb'ene' jaw kynima'n kyib' ex kub' kypi'sa'n kyib', ex mixti'x exi kyb'i'n tchaq'b'ila. <verse number="17" style="v" />Mixti'x xikyb'i'n ex min e'tzaj kyna'nju' b'a'nq'ob'aj te lab'te'n tb'inchaya te kolb'ilkye. Kub' kych'uẍsa'nkyib' ex okkyq'o'n jun nejenel kye tu'n tanj jumajtlkyi'j toju' yajb'ilkye toj Ejipt. Atzunta Dyos inkub' tnajsa'na il, che'w tk'u'ja ex ntzaj laqj tk'u'ja, min ntzajnaj ttx'u'jila ex nim tk'u'jlalila, mixti' e'kyaj tq'o'na. <verse number="18" style="v" />Expe' tej tkub' kyb'incha'n jun qpoj tman wakx k'uxb'il, ex kyma qa a dyosu' etzq'inkye toj Ejipt, ex kyb'incha txqan il nimxi'x, <verse number="19" style="v" />atzunta, tu'nju' nim tq'aq'b'il tk'u'ja, min e'kyajtq'o'na toj chq'ajlaj. Mixti' eltpa'n tib'ju' tnej muj kyi'j, ẍaqlulkye toju' kyb'e te q'ijtl, exju' tnej q'aq' te qonik'an q'olte spik'un toj kyb'e tu'n t-xikyljo'n. <verse number="20" style="v" />Expe' tzaj tq'o'na t-xewa b'a'n xnaq'tzalkye; tz'aqli kywa mana ntoq tzaj t-sma'na kye, ex tzaj tq'o'na a' kye tu'n tq'jenju' k'waj kyi'j. <verse number="21" style="v" />Kab'naq (40) ab'q'i tzaj tq'o'na kywa toj chq'ajlaj, ex mixti' jun ti'xti' mixwitti' kye: ex min ekub'aju' kyxb'alun ex min ximal kyqan tu'n kyb'etb'en.</para>
  <para style="p">
    <verse number="22" style="v" />E'kub' tq'o'na kawb'il ex nimaqtnam toj kyq'ob', ex b'ajx tpa'na tx'otx' toj tneji'n kye, kub'tzun kytzyu'n Esb'on, ttanamju' nimaqkawil Seon ex B'asan, ttanam nimaqkawil Ok. <verse number="23" style="v" />Tb'inchaya tu'n kychmet txqan kyk'wal kse'n kyajlalju' che'w twitz kya'j, ex eb'ajxtiq'i'na tu'n kytzyunte kytx'otx' toju' tx'otx' ojetoq ttziyaya tu'n ttzaj tq'o'na kye ojtxi' qyajilb'ene'. <verse number="24" style="v" />Eb'jo'kxtzuntz toj ex kub'ti'ju' kytx'otx' aj Kanaan kyu'n; eb'aj kub' tme'ssa'na najli qe'toq toju' tx'otx' lu kywitz, eb'aj kub' tq'o'na kynimaqkawil exqe' xjal toju' tnej tx'otx' lu toj kyq'ob' tu'n kyb'inchante kye aju' kyajb'il. <verse number="25" style="v" />Eb'jo'k te kyajawju' nintnam tok nimaqtapi kyi'j ex txqan tb'anil tx'otx', ex txqan ja nojniqe' kyu'n ti'xti' tb'anilqe', e'xoch ex tqan awal ub'a, e'tqan olib'o, ex nim txqantl tqan lob'j; inxi'xtoq che wan b'a'nxi'x ex b'je'tz kywitz, b'aj kynik'b'e'n txqan t-xtalb'ila.</para>
  <para style="p">
    <verse number="26" style="v" />Aye'tzunkye min eb'in teya, jawkyiq'i'nkyib' ti'ja ex el kyik'o'n tkawb'ila. Expe' eb'aj kub' kyb'yo'nju' t-sanjelala, eb'ajx q'mante kyekywitz tnam qa ati kyil ex tu'ntoq tanjtzkyi'j tuk'i'la, ex nim ttx'u'jila okkyq'o'n. <verse number="27" style="v" />Qu'mtzun exa' tq'o'na toj kyq'ob'ju' kyajq'oj, eb'ajkub' yajunkye. Yajxi'tzuntl, tej intoq che oq', e'qanin o'nb'il teya, atzunta, tu'nju' inxi'x q'aq'an tk'u'ja, e'tzaj tb'i'na tzmax toj kya'j, e'tzaj tq'o'na xjal klol kye toj kyq'ob'ju' nche yajunkye.</para>
  <para style="p">
    <verse number="28" style="v" />Aye'tzuntlkye, naqa xten ch'i'n nak'b'il kye, nche aq'witl b'inchal il twitza; qu'mtzun e'kyajtq'o'na tu'n kykub'tz'aq toj kyq'ob' kyajq'oj, ju' eb'jo'kten yajlalkye. Intoqtzun che qanintl o'nb'iltz teya, atzunta, inxi'x q'aq'an tk'u'ja, nche tzaj tb'i'na tzmax toj kya'j, b'a'npun maj e'ttzaqpiya. <verse number="29" style="v" />Intoq tzaj tq'o'na kynab'l tu'n kyjapuntlju' tkawb'ila kyu'n; aye'tzunkye atixi'x kynab'l toj kywitz ex min e'xikyb'i'n tchaq'b'ila; intoq che ik' kyib'aju' tchaq'b'ila, ju' ntq'o'n kychwinqalalju' nche'x b'inchante; jawkyiq'i'nkyib' ti'ja, min xikyb'i'n ex min xikynima'n. <verse number="30" style="v" />B'a'npun ab'q'i min ntzajnaj ttx'u'jila kyi'j ex b'ajx toqxena'na kye tu'nelju' t-xewa ex toj kytziju' t-sanjelala; extzun mixti'x xikyb'i'n, qu'mtzun exitq'o'na tjaq' kykawb'ilju' nimaqtnam twitz tx'otx'. <verse number="31" style="v" />Tu'ntzu'n nim tlaqb'il tk'u'ja, min e'kub' tb'ajsa'na ex minti' e'kyaj tq'o'na; qu'n aya Dyos che'w tk'u'j ex nq'aq'an tk'u'ja nimxi'x.</para>
  <para style="p">
    <verse number="32" style="v" />Qu'mtzun, aya Dyos Manb'aj qib'aje', nimxi'x toklena, nimtipumala ex xob'ajilxa, kukx tjapun tyolju'ya kyejni b'entti'j ex nim tk'ujlalila, myanaqwit ch'i'nte' txqan yajb'il matxi' tzajxi' kyi'ju' qnimaqkawile', e'qnejele', e'pale ex t-sanjelala, ex kyi'ju' ojtxi' qyajilb'ene', ex tkyaqilju' tnam, ttzajlenx toj kyq'ijlalilju' nimaqkawil aj Asirya tzmax ja'lo. <verse number="33" style="v" />Ex myata ati tpaj tu'n tkyaqilju' matxi' tzik' qi'je'; qu'n matxi' japunta tu'n, ayo' qeju'ye' matxi' qo b'inchan ile' twitza. <verse number="34" style="v" />Exqepe' qnimaqkawile', e'qnejenele', e'pale, exqe'ju' ojtxi' qyajilb'ene', mixti'x japunju' tkawb'ila kyu'n ex mixti'x exi kyb'i'n tchaq'b'ila exqe' eb'ajx toqxena'na kye. <verse number="35" style="v" />Ape' kyb'inchaju', maskyepe' nim txqan q'inumal ex jun nim tb'anil tx'otx' tzaj tq'o'na kye, mixti'x ek'ulun teya ex mixti'x kyej kytzaqpi'nju' kyb'inchb'aj myab'a'n toju' kykawb'il.</para>
  <para style="p">
    <verse number="36" style="v" />Qo tka'yintztzuna ja'lo, lq'o'n majinqo'ye tojxju' tx'otx' tzaj tq'o'na kyeju' ojtxi' qyajilb'ene' tu'nwtlo kywan ti'ju' tb'anil ex tawalju' tx'otx' njaw. <verse number="37" style="v" />Kyekye' nimaqkawil nxa' txqan tawalju' tx'otx' njaw, e'kub' tq'o'na qib'aje' tu'n tpaj qile'. Tjaq'ju' kyajb'il ta'qo'ye' kyuk'i'lxi' qalu'ne'. Qu'mtzun inxi'x qob'isune', chechij te Dyos.</para>
  <para style="s1">Kyej b'entti'j tyolu' tnam tu'n tjapun kawb'il tu'n</para>
  <para style="p">
    <verse number="38" style="v" />Tu'n tkyaqil ja'lu, qq'a'qib'e' ti'ju' qyole' kjel tz'ib'et, atzunju' u'j k'okyel seyaret kb'el kysqitu'n qnejenele' ti'j, e'aj Leb'i ex e'pale.</para>
  <chapter number="10" style="c" />
  <para style="p">
    <verse number="1" style="v" />Ayo'qo'ju'ye' lu makub' qq'o'n qb'iye' ti'ju' u'j:</para>
  <para style="b" />
  <para style="li1">Ayine' Neemiy tk'wal Akaliy, kawil qintoqe'.</para>
  <para style="b" />
  <para style="li1">Exqe' Sedekyiy, <verse number="2" style="v" />Serayiy, Asariy, Jeremiy,</para>
  <para style="li1">
    <verse number="3" style="v" />Pasur, Amariy, Malkyiy,</para>
  <para style="li1">
    <verse number="4" style="v" />Atus, Seb'aniy, Maluk,</para>
  <para style="li1">
    <verse number="5" style="v" />Arim, Meremot, Ab'diy,</para>
  <para style="li1">
    <verse number="6" style="v" />Danyel, Wineton, B'aruk,</para>
  <para style="li1">
    <verse number="7" style="v" />Mesulam, Ab'iy, Mijamin,</para>
  <para style="li1">
    <verse number="8" style="v" />Maasiy, B'ilkay ex Semayiy. Paleqe' ja'lu.</para>
  <para style="m">
    <verse number="9" style="v" />Aye'tzu'n aj Leb'i:</para>
  <para style="b" />
  <para style="li1">aye' Joswe tk'wal Asaniy, B'inuy, tyajajil Enadad, ex Kadmyel;</para>
  <para style="li1">
    <verse number="10" style="v" />exqe' titz'in mo ttzik, aye' Seb'aniy,</para>
  <para style="li1">Odiy, Kyelit, Pelayiy, Anan,</para>
  <para style="li1">
    <verse number="11" style="v" />Mikayiy, Reob', Asab'iy,</para>
  <para style="li1">
    <verse number="12" style="v" />Sakur, Sereb'iy, Seb'aniy,</para>
  <para style="li1">
    <verse number="13" style="v" />Odiy, B'ani ex B'eninu.</para>
  <para style="m">
    <verse number="14" style="v" />Aye'tzu'n nejenel te tnam:</para>
  <para style="b" />
  <para style="li1">Aye' Paros, Paat-moab', Elam, Satu, B'ani,</para>
  <para style="li1">
    <verse number="15" style="v" />B'inuy, Askad, B'eb'ay,</para>
  <para style="li1">
    <verse number="16" style="v" />Adoniy, B'ikb'ay, Adin,</para>
  <para style="li1">
    <verse number="17" style="v" />Ater, Esekyiy, Asur,</para>
  <para style="li1">
    <verse number="18" style="v" />Odiy, Asum, B'esay,</para>
  <para style="li1">
    <verse number="19" style="v" />Arip, Anatot, Neb'ay,</para>
  <para style="li1">
    <verse number="20" style="v" />Makpiy, Mesulam, Esir,</para>
  <para style="li1">
    <verse number="21" style="v" />Mesesab'el, Sadok, Jaduwa,</para>
  <para style="li1">
    <verse number="22" style="v" />Pelatiy, Anan, Anayiy,</para>
  <para style="li1">
    <verse number="23" style="v" />Osey, Ananiy, Asub',</para>
  <para style="li1">
    <verse number="24" style="v" />Aloes, Pila, Sob'ek,</para>
  <para style="li1">
    <verse number="25" style="v" />Reum, Asab'na, Maaseyiy,</para>
  <para style="li1">
    <verse number="26" style="v" />Ayiy, Anan, Anan,</para>
  <para style="li1">
    <verse number="27" style="v" />Maluk, Arim ex B'aana.</para>
  <para style="s1">Txqantl ti'xti' tu'n tb'inchanteju' tnam twitz Dyos</para>
  <para style="p">
    <verse number="28" style="v" />Aye'tzu'n txqantl xjal, aye' pale, e'aj Leb'i, e'xq'uqil ttzija, eb'itzal, e'ajb'el toj tja Dyos, ex kykyaqilju' matxi'toq tz'el kypa'n kyib' kyi'ju' xjal toju' tnej tx'otx' tu'n kyb'inchante tkawb'il Dyos, junx kyuk'i'l kyxu'jil ex kykyaqilu' kyk'wal ex kymyal intoq che ximantl, <verse number="29" style="v" />kymujb'a kyib' kyuk'i'lju' kywitze'l ex kyuk'i'lju' nejenel kye, ex kyma twitz Dyos tu'n kyxi'lpe ti'ju' tkawb'il Dyos ojetoq tma toj ttzi Moyses tmajin, ex tu'n kyjapun b'a'nxi'x kyu'n tkyaqilju' tchaq'b'il, tnuk'b'il ex e'tkawb'il Qman Dyos. <verse number="30" style="v" />Qu'mtzun kyma: lay che'x qq'o'nqe' qmyal tu'n kymje kyuk'i'lju' xjal toju' tx'otx' lu, ex lay qaje' tu'n kymjeju' kymyal kyuk'i'lju' qk'wale'. <verse number="31" style="v" />Ex ajkyulu' xjal najlqe' toju' tx'otx' k'ayilteju' kyk'a'ẍ ex tkyaqilju' twitz kyawal toju' q'ij te ojlab'l, lay qo loq'one' kye, b'a'ntzun toju' q'ij te ojlab'l mujqa alkyexku' juntl ninq'ij; ex ikx lay qo awane' toj twuqi'n ab'q'i ex che b'elqnajsa'ne' k'as. <verse number="32" style="v" />Ex ikx mab'entti'j qu'ne' tu'n qq'onteye' jun tal saqpwaq tkyaqil ab'q'i tu'n kychjetu' ajb'eb'l toju' tja Qman Dyos: <verse number="33" style="v" />Tu'n tkub'ju' wab'j twitz Dyos, e'oyaj twitz awal k'ok'e'kywitz inche kub' tkyaqil q'ij, e'oyaj te k'ok'sb'il tkyaqil q'ij, e'chojb'il te q'ij te ojlab'l ex te ak'a'j xjaw, ex kyeju' junjuntl ninq'ij; ex tkyaqilju' oyaj, e'chojb'il tu'n tk'met najsb'il kyil aj Israel, ex tkyaqilju' k'u'lb'il toj tja Qman Dyos.</para>
  <para style="p">
    <verse number="34" style="v" />Exqepe' pale, e'aj Leb'i ex kykyaqilju' tnam, kse'nx kyajlalju' junjun ja, xiqse'ne' tu'n tel yal alkye tu'n txi' iq'inteju' si k'ajb'el atl junjun ab'q'i toju' tja Qman Dyos toju' tq'ijlalil q'ma'ntl, tu'n ttz'e'yset tib'aju' q'olb'eb'l te Qman Dyos, kse'nxju' tz'ib'a'n toju' kawb'il. <verse number="35" style="v" />Ex makyej qna'ne' tu'n t-xiqiq'i'ne' tnejel twitz qawale' ex tnejel kywitz lob'j toj tja Qman Dyos atl junjun ab'q'i, <verse number="36" style="v" />ex ikx tu'n kyxi' qi'q'i'ne' tnejel qk'wale' e'tnejel tal qwakyixe' ex tnejel tal qrite' toju' tja Qman Dyos, kywitzju' pale nche ajb'en toju' tja Dyos, kse'nxju' tz'ib'a'n toju' kawb'il. <verse number="37" style="v" />Ex makyej qna'ne' tu'n kyxi' qiq'i'ne' tnejel arin, tnejel kywitz tkyaqilu' qtzeye', tnejel qb'ine' ex tnejel qaseyte', kyoju' k'ub'l toj tja Qman Dyos, tu'n tajb'en te o'nb'il kyeju' pale, ex tu'n kyxiqiq'i'ne' tlajoji'n tnej ti'ju' twitz qawale' kye aj Leb'i, qu'n aye' nche k'monte tlajoji'n teju' njaw toju' qkojb'ile'.</para>
  <para style="p">
    <verse number="38" style="v" />Ajtzun kyxi' aj Leb'i iq'ilteju' tlajoji'n, kxe'l jun pale tyajajil Aaron kyuk'i'l. Aye'tzu'n aj Leb'i kxe'l kyiq'i'n jun tlajoji'n toju' k'ub'l toj tja Dyos ti'ju' tlajoji'n nxikyiq'i'n, <verse number="39" style="v" />Qu'n aye' aj Israel exqe' aj Leb'i nche'x iq'inteju' o'nb'il triy, b'in ex aseyt kyoju' k'ub'l jata'qe'ju' ajb'eb'l xjanqe', ex ja ta'qe' pale ate' toj ajb'eb'l, e'xq'uqil ttzija exqe' aj b'itzal. Ex maqtziyaye' tu'n mikyaja' qtzaqpi'ne' tja Qman Dyos.</para>
  <chapter number="11" style="c" />
  <para style="s1">Aye' che najal toj Jerusalen</para>
  <para style="p">
    <verse number="1" style="v" />E'kub' najanju' ati kyoklen toju' kawb'il toj Jerusalen, aye'tzu'n txqantl xjal te nintnam xikyse'n tu'n tel yal jun kyxol lajoj jatu'n txi' najal toj Jerusalen, ju' xjan nintnam, aye'tzu'n b'eljoj chaqtl tu'n kykyajten kyoju' txqantl tnam. <verse number="2" style="v" />Aye'tzu'n tnam xjal xikyqani'n b'a'n kyib'aju' kyaq'kyib' tu'nkyk'u'j tu'n kynajan toj Jerusalen. <verse number="3" style="v" />E'kub' najanju' aj Israel, e'pale, e'aj Leb'i, e'ajb'el toj tja Dyos, exqe' kyyajajilju' e'ajb'en te Salomon, kyoju' nimaqtnam toj Juda, teyile junjun tojilex ttanam ex ttx'otx'. Aye'tzu'n nejenel nimaq kyoklen eb'ju'l jumajtl, e'kub' najan toj Jerusalen, atiju' kyb'i tz'ib'a'n. <verse number="4" style="v" />Junjun kyyajajil Juda ex B'enjamin e'kub' najan toj Jerusalen, kyxolu' tyajajil Juda, aye': Atayiy, tk'wal Osiy, ju' tk'wal Sakariy, ju' tk'wal Amariy, ju' tk'wal Sepatiy, ju' tk'wal Maalalel, tyajajil Pares; <verse number="5" style="v" />ex Maaseyiy, tk'wal B'aruk, ju' tk'wal Kolose, ju' tk'wal Asayiy, ju' tk'wal Adiy, ju' tk'wal Joyarib', ju' tk'wal Sakariy, ju' tk'wal Siloni. <verse number="6" style="v" />Junk'al oxnaq wajxaq (468) kyb'aju' tyajajil Pares te kykyaqilju' e'kyajten najal toj Jerusalen, kykyaqilxu' ichan lu b'a'nqe' te q'ojil. <verse number="7" style="v" />Atzu'n kyxolju' tyajajil B'enjamin, aye': Salu, tk'wal Mesulam, tk'wal Joed, tk'wal Pedayiy, tk'wal Kola'yiy, tk'wal Maaseyiy, tk'wal Ityel, tk'wal Isayiy; <verse number="8" style="v" />Exqe' Kab'ay ex Salay ju' titz'in mo ttzik. Kab'k'al qaqnaq wajxaq (928) kyb'aj te kykyaqil. <verse number="9" style="v" />Atoq Joel, tk'wal Sikri, nejenel kye; atzun Juda, tk'wal Senuwa, tkab' nejenel teju' nintnam. <verse number="10" style="v" />Atzu'n kyxolju' pale aye': Jedayiy tk'wal Joyarib', Jakyin, <verse number="11" style="v" />ex Serayiy, tk'wal Ilkyiy, ju' tk'wal Mesulam, ju' tk'wal Sadok, ju' tk'wal Merayot, ju' tk'wal Aytub', nejenel nim toklen toj tja Dyos. <verse number="12" style="v" />Exqe' tuk'i'l, ju' ntoq che aq'unan toju' ajb'eb'l toj tja Dyos, kab'k'al junaq kab'e' (822) kyb'aj; ex Adayiy tk'wal Jeroam, ju' tk'wal Pelaliy, ju' tk'wal Amasi, ju' tk'wal Sakariy, ju' tk'wal Pasur, ju' tk'wal Malkyiy. <verse number="13" style="v" />Kab'lajnaq kab'e' (242) kyb'aju' kywitze'l, nejenelqe' te junjun ja xjal; ex Amasay, tk'wal Asarel, ju' tk'wal Asay, ju' tk'wal Mesilemot, ju' tk'wal Imer. <verse number="14" style="v" />Qaqnaq wajxaq (128) kyb'aju' kywitze'l, ichan b'a'nqe' te q'oj, ex a Sab'dyel, tk'wal Kyedolim, nejenel kye. <verse number="15" style="v" />Atzu'n kyxol aj Leb'i: aye' Semayiy tk'wal Asub', ju' tk'wal Asrikam, ju' tk'wal Asab'iy, ju' tk'wal B'inuy; <verse number="16" style="v" />exqe' Sab'tay ex Josab'ad, kyxolju' nejenel kye aj Leb'i, toj kyq'ob'toq ta'ju' aq'untl ti'jxi' tja Dyos; <verse number="17" style="v" />ex Mataniy tk'wal Mikayiy, ju' tk'wal Sab'di, ju' tk'wal Asap, nejeneltoq kyeju' k'loj b'itzal intoq che b'itzanteju' b'itz te aq'b'il chjonte ajtpon kmoj te na'j Dyos; ex B'akb'ukyiy, ju' tkab' toju' kyja, ex Ab'da, tk'wal Samuwa, ju' tk'wal Kalal, ju' tk'wal Jedutun. <verse number="18" style="v" />Kyajlajnaq kyaje' (284) kyajlalu' aj Leb'i e'kyajten toju' nintnam xjan.</para>
  <para style="p">
    <verse number="19" style="v" />Aye'tzu'n xq'uqil ttzija: aye' Akub', Talmon exqe' kywitze'l, wajxaqnaq kab'lajoj (172) kyb'aj intoq che xq'uqin kytzi tja Dyos.</para>
  <para style="p">
    <verse number="20" style="v" />Aye'tzu'n txqantl aj Israel kykyaqil, ex txqantl pale ex aj Leb'i, eb'ajkub' najan kyoju' txqantl tnam te Juda, teyile junjun tojx tx'otx'; <verse number="21" style="v" />maskyepe' e'kub' najanju' ajb'el toj tja Dyos toj Opel, aye' kynejenelu' Sya ex Kyispa.</para>
  <para style="p">
    <verse number="22" style="v" />Atoq Usi nejenel kye aj Leb'i toj Jerusalen, ju' tk'wal B'ani, ju' tk'wal Asab'iy, ju' tk'wal Mataniy, ju' tk'wal Mikayiy, tyajajil Asap, aye'ju' intoq che kub'nej b'itzalkyeju' b'itz toju' ajb'eb'l toj tja Dyos, <verse number="23" style="v" />qu'n ojetoq tchaq' nimaqkawil ti'ju' tu'n kyb'inchante b'itzal atl junjun q'ij.</para>
  <para style="p">
    <verse number="24" style="v" />Atoq nokxju' twitz nimaqkawil tu'n tnk'et alkyexku' ti'xti' nb'aj kyxol xjal, a Petayiy, tk'wal Mesesab'el, ju' tyajajil Sera, tk'wal Juda.</para>
  <para style="s1">Txqantl jae'najana' aj Israel ti'jxi' Jerusalen</para>
  <para style="p">
    <verse number="25" style="v" />Junjun kyxolju' tnej tyajajil Juda e'kub' najan kyoju' tnam Kyiryat-arb'a, Dib'on, Jekab'seel, <verse number="26" style="v" />Joswe, Molada, B'et-pelet, <verse number="27" style="v" />Asar-swal, B'eerseb'a, <verse number="28" style="v" />Siklaj, Mekona, <verse number="29" style="v" />En-rimon, Sora, Jarmut, <verse number="30" style="v" />Sanoa, Adulam, Lakyis ex Aseka, kyuk'i'lxi' kykojb'il ex kynajb'il. Eb'ajkub' najan tzajx B'eerseb'a ponx tzmax toju' b'ya' Inom. <verse number="31" style="v" />Aye'tzu'n kyxolu' tnej tyajajil B'enjamin eb'ajkub' najan kyoju' tnam Kyeb'a, Mikmas, Ayiy, B'etel, kyuk'i'lxi' kykojb'il; <verse number="32" style="v" />ex kyoj Anatot, Nob', Ananiy, <verse number="33" style="v" />Asor, Rama, Witaym, <verse number="34" style="v" />Adid, Seb'oyim, Neb'alat, <verse number="35" style="v" />Lod, Ono, ex toju' b'ya' kyeju' kno'n tb'inchanjtz junjun ti'xti' kyu'n. <verse number="36" style="v" />Expe' xiq'o'n kytx'otx' junjun aj Leb'i toj kytx'otx' tyajajil Juda ex toj kytx'otx' tyajajil B'enjamin.</para>
  <chapter number="12" style="c" />
  <para style="s1">Aye' pale exqe' aj Leb'i</para>
  <para style="p">
    <verse number="1" style="v" />Aye'tzun pale ja'lu exqe' aj Leb'i anjtzkyi'j tuk'i'l Sorob'ab'el, tk'wal Salatyel, ex tuk'i'l Joswe:</para>
  <para style="p">Aye' pale: Serayiy, Jeremiy, Esdras, <verse number="2" style="v" />Amariy, Maluk, Atus, <verse number="3" style="v" />Sekaniy, Rewum, Meremot, <verse number="4" style="v" />Ido, Wineton, Ab'iy, <verse number="5" style="v" />Mijamin, Maadiy, B'ilka, <verse number="6" style="v" />Semayiy, Joyarib', Jedayiy, <verse number="7" style="v" />Salu, Amok, Ilkyiy ex Jedayiy. Aye'toqtzun kynejel paleju' kyuk'i'lju' kywitze'l toj tq'ijlalil Joswe.</para>
  <para style="p">
    <verse number="8" style="v" />Aye'tzu'n aj Leb'i: aye' Joswe, B'inuy, Kadmyel, Sereb'iy, Juda ex Mataniy, ju' tojtoq tq'ob' kyuk'i'lju' tuk'i'l ta'qe' b'itz te ajwalb'il; <verse number="9" style="v" />ex B'akb'ukyiy, ex Uni, kyuk'i'l qe'x, ate'toq kywitz tu'n kyb'inchanteju' kyaq'un.</para>
  <para style="p">
    <verse number="10" style="v" />Ate Joswe tman Joakyim, atzun Joakyim tman Elyasib', atzun Elyasib' tman Joyada, <verse number="11" style="v" />atzun Joyada tman Joanan, atzun Joanan tman Jaduwa. <verse number="12-21" style="v" />Aye'toq paleju' nejenel kye junjun ja toju' tq'ijlalil Joakyim:</para>
  <para style="b" />
  <table>
    <row style="tr">
      <cell style="th1" align="start">Nejenel </cell>
      <cell style="th2" align="start">Toj tja pale</cell>
    </row>
    <row style="tr">
      <cell style="tc1" align="start">a Merayiy </cell>
      <cell style="tc2" align="start">kye toj tja Serayiy</cell>
    </row>
    <row style="tr">
      <cell style="tc1" align="start">atzun Ananiy </cell>
      <cell style="tc2" align="start">kye toj tja Jeremiy</cell>
    </row>
    <row style="tr">
      <cell style="tc1" align="start">atzun Mesulam </cell>
      <cell style="tc2" align="start">kye toj tja Esdras</cell>
    </row>
    <row style="tr">
      <cell style="tc1" align="start">atzun Joanan </cell>
      <cell style="tc2" align="start">kye toj tja Amariy</cell>
    </row>
    <row style="tr">
      <cell style="tc1" align="start">atzun Jonatan </cell>
      <cell style="tc2" align="start">kye toj tja Meliku</cell>
    </row>
    <row style="tr">
      <cell style="tc1" align="start">atzun Jse </cell>
      <cell style="tc2" align="start">kye toj tja Sebaniy</cell>
    </row>
    <row style="tr">
      <cell style="tc1" align="start">atzun Adna </cell>
      <cell style="tc2" align="start">kye toj tja Arim</cell>
    </row>
    <row style="tr">
      <cell style="tc1" align="start">atzun Elkay </cell>
      <cell style="tc2" align="start">kye toj tja Merayot</cell>
    </row>
    <row style="tr">
      <cell style="tc1" align="start">atzun Sakariy </cell>
      <cell style="tc2" align="start">kye toj tja Ido</cell>
    </row>
    <row style="tr">
      <cell style="tc1" align="start">atzun Mesulam </cell>
      <cell style="tc2" align="start">kye toj tja Kineton</cell>
    </row>
    <row style="tr">
      <cell style="tc1" align="start">atzun Sikri </cell>
      <cell style="tc2" align="start">kye toj tja Ab'iy</cell>
    </row>
    <row style="tr">
      <cell style="tc1" align="start">atzun Piltay </cell>
      <cell style="tc2" align="start">kye toj tja Moadiy</cell>
    </row>
    <row style="tr">
      <cell style="tc1" align="start">atzun Samuwa </cell>
      <cell style="tc2" align="start">kye toj tja B'ilka</cell>
    </row>
    <row style="tr">
      <cell style="tc1" align="start">atzun Jonatan </cell>
      <cell style="tc2" align="start">kye toj tja Semayiy</cell>
    </row>
    <row style="tr">
      <cell style="tc1" align="start">atzun Matenay </cell>
      <cell style="tc2" align="start">kye toj tja Joyarib'</cell>
    </row>
    <row style="tr">
      <cell style="tc1" align="start">atzun Usi </cell>
      <cell style="tc2" align="start">kye toj tja Jedayiy</cell>
    </row>
    <row style="tr">
      <cell style="tc1" align="start">atzun Kalay </cell>
      <cell style="tc2" align="start">kye toj tja Salay</cell>
    </row>
    <row style="tr">
      <cell style="tc1" align="start">atzun Eb'er </cell>
      <cell style="tc2" align="start">kye toj tja Amok</cell>
    </row>
    <row style="tr">
      <cell style="tc1" align="start">atzun Asab'iy </cell>
      <cell style="tc2" align="start">kye toj tja Ilkyiy</cell>
    </row>
    <row style="tr">
      <cell style="tc1" align="start">atzun Natanael </cell>
      <cell style="tc2" align="start">kye toj tja Jedayiy</cell>
    </row>
  </table>
  <para style="b" />
  <para style="p">
    <verse number="22" style="v" />Atzu'n toj kyq'ijlalil Elyasib', Joyada, Joanan ex Jaduwa, ex tzmax tej tkawin Dariy aj Persya, aye' aj Leb'i exqe' pale b'aj ku'x tz'ib'a'n kyb'i te nejenel kye junjun ja xjal. <verse number="23" style="v" />Aye'tzu'n aj Leb'i, nejenel kye junjun ja xjal eku'x tz'ib'a'n toju' tu'jil tqanil tzmax toj tq'ijlalil Joanan, tchman Elyasib'. <verse number="24" style="v" />Aye' nejenel kye aj Leb'i ja'lu: Asab'iy, Sereb'iy, Joswe, B'inuy ex Kadmyel, exqe' kyuk'i'l ate'toq kywitz tu'n kyajwalin ex tu'n kyq'on chjonte te Qman Dyos toju' kmoj te tajb'eb'l, kse'nxju' ojetoq tchaq' Dab'i ajb'el te Dyos. <verse number="25" style="v" />Aye'tzu'n xq'uqil intoq che xq'uqin ttzija aye': Mataniy, B'akb'ukyiy, Ab'diy, Mesulam, Talmon Ex Akub'. <verse number="26" style="v" />Aye' ja'lu eb'aj anq'in toj tq'ijlalil Joakyim, tk'wal Joswe ex tchman Josadak; ex toj tq'ijlalil Neemiy ju' kawil ex toj tq'ijlalil Esdras ju' pale ex xnaq'tzal.</para>
  <para style="s1">Xjansetju' nintapi</para>
  <para style="p">
    <verse number="27" style="v" />Tej tpon tq'ijlalil tu'n t-xjansetju' nintapi ti'jile Jerusalen, eb'ajx joyb'aju' aj Leb'i kyoj kykyaqilju' najb'il janajla'qe'toq, ex eb'aj tzaj iq'i'n toj Jerusalen tu'n tkub' kyik'sa'nju' xjansb'ilte nintapi tuk'i'l tzalajb'il, tu'n kyajwalinte Qman Dyos kyu'n b'itz kyuk'i'l chnab' txijtxij, tzintzin ex arpa. <verse number="28" style="v" />Aye'tzu'n aj Leb'iju' b'itzal, eb'aj tzaj kyoju' najb'il ti'jile Jerusalen, kyoju' najb'il toj Netopa, <verse number="29" style="v" />toju' tzb'oj ja te Kyilkal ex kyoju' kojb'il Kyeb'a ex Asmab'et; qu'n matxitoq che b'jaw kyb'incha'n b'itzal kojb'il ti'jile Jerusalen. <verse number="30" style="v" />B'ajtzun kyẍtilsa'n kyib'ju' pale exqe' aj Leb'i; ex eb'aj kyẍtilsa'n nintnam exqe' tjpel, exju' nintapi kse'nx tchaq'b'il Dyos. <verse number="31" style="v" />Yajxi'tzuntl nb'inchaye' tu'n kyjaxju' tzyul kawb'il toj Juda tib'aju' nintapi, ex kub' nnuk'u'ne' kab'e' tnej b'itzal b'a'punchaq kyb'aj. Intoq che b'etju' tnejel tnej tib'aju' nintapi toj tb'a'nq'ob'kya'j, tu'me'lju' ttzi tnam xob'l tz'is tb'i. <verse number="32" style="v" />Lepchixtoqtzu'n Osayiy kyi'jxi'ju' tnej b'itzal kyuk'i'l nik'janju' tzyul kawb'il te Juda, <verse number="33" style="v" />kyuk'i'l Asariy, Esdras, Mesulam, <verse number="34" style="v" />Juda, B'enjamin, Semayiy ex Jeremiy. <verse number="35" style="v" />Aye'tzu'n pale nche q'ajtzan chun: aye' Sakariy tk'wal Jonatan, aye' ojtxi' tchmanju' Semayiy, Mataniy, Mikayiy, Sakur ex Asap; <verse number="36" style="v" />kyi'jxi'pe'tlju' kywitze'l Semayiy, Asarel, Milalay, Kyilalay, Maay, Natanael, Juda ex Anani, aye' intoq che q'ajtzankyeju' tchinab' Dab'i, ju' ajb'el te Dyos. Nejlitoq Esdras ju' xnaq'tzal kywitz. <verse number="37" style="v" />Ex tej kypon tib'aju' ttzi tnam t-xiklil a' tb'i, xikyljo'n kyb'e tib'aju' tapi nimin twe', eb'jax toju' peta'n njapun toju' Ninttanam Dab'i, tib'aju' tja Dab'i te kawb'il ex tzmax tib'aju' ttzi tnam tjpel A tb'i, ati toj tjawetzq'ij.</para>
  <para style="p">
    <verse number="38" style="v" />Aye'tzu'n tkab' tnej b'itzal xi' e'xa' toj tnayaj. Lepchqinxe' kyi'ju' tnej b'itzal tib'aju' nintapi kyuk'i'lju' nik'jantl xjal, tzajx tk'etzu' ja nimin twe' chuj tb'i, tzmax tk'etzju' tapi nim twitz, <verse number="39" style="v" />o'ik'e' ja ta'qe' ttzi tnam Eprayin tb'i, ttzi tnam Jesana tb'i, ttzi tnam kyiẍ tb'i, ex jata' ja Ananel nimin twe' exju' ja Syen nimin twe', tzmax ttzi tnam rit tb'i; ex o'we'ye' ttzi tnam te xq'uqb'il. <verse number="40" style="v" />E'kub' tentzu'n kab'e' tnej b'itzaltz toju' kykub'el toj tja Dyos; ex ikxwe', kyuk'i'l nik'janju' kawil lepchqe'toq wi'je'.</para>
  <para style="p">
    <verse number="41" style="v" />Aye' paleju' ja'lu nche q'ajtzan chun: Elyakyim, Maaseyiy, Minyamin, Mikayiy, Elyoenay, Sakariy, Ananiy, <verse number="42" style="v" />Maaseyiy, Semayiy, Eleasar, Usi, Joanan, Malkyiy, Elam ex Eser. Aye'tzu'n b'itzal, nk'u'nqe' tu'n Israyiy, eb'itzan junx toj tneji'n.</para>
  <para style="p">
    <verse number="43" style="v" />E'kub' q'o'n nim chojb'il toju' q'ij lu, ex eb'aj tzalaju' xjal nim qu'n e'tzalajsanjtz b'a'nxi'x tu'n Dyos. E'qya exqe' k'wal eb'aj tzalaj, ex q'ojq'oj toqju' tzalajb'il najchaq b'aj toj Jerusalen.</para>
  <para style="s1">Kywa pale ex aj Leb'i</para>
  <para style="p">
    <verse number="44" style="v" />Eb'jo'k q'et junjun xjal toju' tq'ijlalil lu tu'n txi' kyka'yi'nju' k'uwenj, oyaj, tnejel kywitz awal exqe' tlajoji'n tnej nche elkypa'n xjal, jatu'n tk'u'yeta'ju' nb'ajtzaj kyoj kojb'il kye junjun nimaqtnam tu'n tajb'en kye pale ex kye aj Leb'i kse'nxu' ntma'n kawb'il; qu'n intoq che tzalaju' aj Juda kyuk'i'lju' pale ex aj Leb'i ate'toq toj ajb'eb'l. <verse number="45" style="v" />Aye' kyuk'i'lju' b'itzal e'xq'uqil ttzija, intoq che b'inchanteju' k'u'lb'il te Dyos exju' ẍtilsab'l twitz Dyos, kse'nxju' ojetoq b'aj tnk'u'n Dab'i ex Salomon ju' tk'wal. <verse number="46" style="v" />Qu'n ate'toq nejenel kye aj b'itzal, b'itz te ajwalb'il ex aq'b'il chjonte te Dyos ojtxi' toj kyq'ijlalil Dab'i ex Asap.</para>
  <para style="p">
    <verse number="47" style="v" />Qu'mtzun kykyaqil aj Israel ex tkyaqil q'ij intoq xikyq'o'nju' ati tajb'en kye aj b'itzal ex kye xq'uqil ttzija, toj kyq'ijlalil Sorob'ab'el ex Neemiy; ex intoq xikyq'o'nju' kye aj Leb'i aju' ati kyoklen ti'j, ex ikxkye aj Leb'i elkypa'n ch'i'n ti'ju' kyk'am ex xikyq'o'n kye tyajajil Aaron.</para>
  <chapter number="13" style="c" />
  <para style="s1">Ch'exb'eb'l tu'n Neemiy</para>
  <para style="p">
    <verse number="1" style="v" />Jaw ẍch'etju' tuj Moyses kywitz kykyaqil xjal toju' tq'ijlalil lu, ex knet toju' u'j lu qa mixti'xtoq tu'n kyten aj Amon ex aj Moab' kyxolju' ttanam Dyos. <verse number="2" style="v" />Qu'n min eb'je'tz k'molkye aj Israel tuk'i'l wab'j ex k'wab'j, xi'pe' kychjo'n B'alaam tu'n ttxkonte taq'wix kyib'aj, Atzunte Qman Dyos tmiltz'uju' qanb'en lu te jun ky'i'wb'il. <verse number="3" style="v" />Tetzunj kyb'inteju' ntma'n kawb'il, eb'je'l kypa'n kykyaqilju' matxitoq b'ajx kysmo'nkyib' kyuk'i'lju' najchaq xjal kyi'ju' aj Israel.</para>
  <para style="p">
    <verse number="4" style="v" />Ma'toqtzun tzik'xi' b'a'npun ab'q'i, atoqu' pale Elyasib' tok ka'yilkyeju' k'ub'l toj tja Qman Dyos. Kyetoqna' kyten Elyasib' tuk'i'l Tob'iy, <verse number="5" style="v" />ojetoq txitq'o'n jun ja nimin te Tob'iy tu'n tnajan toj, jatoq nche k'uyeta' oyaj tnejel, ex sturak, e'aq'unb'il exju' tlajoji'n tnej ti'ju' triy, ti'ju' b'in ex aseyt ju' chq'o'n tu'n txiq'et kye aj Leb'i, eb'itzal ex kye xq'uqil ttzija, tib'ajxi'tlju' o'nb'il kye pale. <verse number="6" style="v" />Mix-a'lo'qin toqwe' toj Jerusalen tej tb'aj tkyaqil ja'lu, qu'n anjwi'je' tk'etzju' nimaqkawil Artajerjes toj B'ab'ilon toj tjunaq kab'lajoji'n (32) ab'q'i nkawin; expe' xinqani'ne' anb'il teju' nimaqkawil tb'ajlenxi' jte' q'ij, <verse number="7" style="v" />anjtztzun wi'jtze' toj Jerusalen. Atzuntzu' ela' nnik'e' ti'ju' taq'wix tb'incha Elyasib' naq tu'n tb'inchante b'a'n te Tob'iy, xitq'o'n jun tja tpen tja Dyos. <verse number="8" style="v" />Majx tzaj ntx'u'jile' tu'n tpaj ja'lu, eb'je'xtzun nq'o'ne' tkyaqilju' tiq'in Tob'iy ti'jxi' ja. <verse number="9" style="v" />Nchaq'tzuntze' tu'n tb'aj ẍtilset kse'nx tchaq'b'il Dyos, ex tu'n kyb'jo'kx q'o'n jumajtlu' ajb'eb'l toj tja Dyos jaxju' ta'qe'toq tnejel, e'oyaj ex sturak.</para>
  <para style="p">
    <verse number="10" style="v" />Ex nb'iye' qa na'mxtoq txiq'o'n kywa aj Leb'i, ex ojetoq che b'ajx oqu' aj Leb'i ex eb'itzal b'inchal k'u'lb'il, teyile junjun toj kytx'otx'. <verse number="11" style="v" />Eb'ajtzun ntzak'u'ne' kawil tu'n tpaju' min nxi'kyka'yi'n tja Dyos. Yajxi'tzuntl eb'aj nb'u'yi'ne' aj Leb'i exqe' b'itzal, ex eb'ajkub' nq'o'ne' toju' kyaq'un, <verse number="12" style="v" />kykyaqiltzu'n aj Juda b'aj tzaj kyiq'i'n tlajoji'n tnej ti'ju' kytriy, eb'in ex aseyt, kyoju' k'ub'l. <verse number="13" style="v" />Eb'jo'ktzun nq'o'ne' pale Selemiy, ex Sadok ju' tz'ib'al, ex Pedayiy jun aj Leb'i, ka'yilkyeju' k'ub'l; ex oknq'o'ne' Anan tk'wal Sakur ex tchman Mataniy onilte, qu'n b'a'nqe' q'uqli kyk'u'jlalil. Aye'tzun sipalte oyaju' kyxolju' kyuk'i'l. <verse number="14" style="v" />¡Taye: ka'yintzju'ya matxi' nb'inchaye' lu; ex na'nku'ju'ya b'a'n xnb'inchaye' ti'ju' tjaya ex ti'ju' k'u'lb'il teya Nman Dyos!</para>
  <para style="p">
    <verse number="15" style="v" />Wile' toj Juda kyoju' q'ij lu, ate' junjun intoq che pch'un ta'l ub'a te b'in toju' q'ij te ojlab'l, intoq che iqan triy, intoq che iqan b'in, ktxij twitz ub'a, iw ex tkyaqil iqtz kyi'j chej b'ur, ex intoq pon kyiq'i'n toj Jerusalen toj q'ij te ojlab'l. Eb'aj ntzak'u'ntzuntze' tu'n tpaju' inche k'ayin toju' q'ij lu. <verse number="16" style="v" />Expe' ate' junjun aj Tiro najlqe'toq atzu', intoq pon kyiq'i'n kyiẍ ex tkyaqil chukchaq k'aẍjel, ex intoq che kyk'a'yi'n kye aj Juda toju' q'ij te ojlab'l toj Jerusalen. <verse number="17" style="v" />Eb'ajtzun ntzak'u'ne' nejenel te Juda, xinma'ne' kye:</para>
  <para style="p">—¿Ti'tzu'n nkyb'incha'ne' tu'nju' nkub' kytxa'ju'ne' q'ij te ojlab'l? <verse number="18" style="v" />Ana' kyb'incha ojtxi' qchmanju', qu'mtzun tzaj tq'o'n Qman Dyos txqan yajb'il qib'aj ex tib'aju' nintnam lu. ¿Ma kyajb'iltzune' tu'n tokkyq'o'nxi'xtle' ttx'u'jil Dyos ti'ju' tnam Israel tu'n tpaju' nkub' kytxa'ju'nju'ye' q'ij te ojlab'l? nchije' kye.</para>
  <para style="p">
    <verse number="19" style="v" />Nchaq'tzuntze' tu'n kyjpetju' ttzi nintnam Jerusalen aj ch'inxtoq toku' q'ij te ojlab'l, ex mixti' tu'n kyjqet tzmaxi'j ajtik'ju' q'ij. Expe' e'oknq'o'ne' junjun ajb'el weye' xq'uqil tu'ntzun lalun tz'okx iq'i'n jun iqtz toju' q'ij te ojlab'l. <verse number="20" style="v" />B'a'npun maj e'kyajtenju' xk'aẍlel exqe' k'ayil chukchaq k'aẍjel nb'aj qonik'an kyu'n ti'jxi' Jerusalen, <verse number="21" style="v" />njawtzun wulje' kyuk'i'l ex eb'aj ntzak'u'ne' tu'n tpaju' nb'aj qonik'an kyu'n nche kyejten twitzu' nintapi, ex xinma'ne' kye qatoq makyb'incha junmajtl oktoq che kyex nq'o'ne'. Atxi'xtzunj mixti'tl eb'ju'l toju' q'ij te ojlab'l. <verse number="22" style="v" />Yajxi'tzuntl nchaq'e' kye aj Leb'i tu'n kyẍtilsante kyib' ex tu'n kyxi' xq'uqilkyeju' ttzi tnam tu'ntzun lalun che txa'junjtz toju' q'ij te ojlab'l. ¡Nman Dyos: ex chin tna'ku'ya tu'n ja'lu, ex q'aq'antz tk'u'ja wi'je' kse'nxju' t-xtalb'ila!</para>
  <para style="p">
    <verse number="23" style="v" />Ex wile' toju' tq'ijlalil lu qa ate' junjun aj Juda matxi'toq che b'ajmje kyuk'i'lju' qya aj Asdod, aj Amon ex aj Moab'; <verse number="24" style="v" />ex nik'janqe' kyk'wal intoq che yolin toj kyol aj Asdod ex toj kyol junjuntl nimaqtnam, mixtzunti' nb'ent kyolin toj kyol aj Juda. <verse number="25" style="v" />Njaw wulje' kyuk'i'l ex tzaj ntxko'ne' taq'wix kyib'aj. Eb'jo'k nb'yo'ne' junjunkye ex jaw ntzuqi'ne' tzmal kywi', ex e'oknchq'o'ne' tu'n kymante jun kyol twitz Dyos tu'n lalun kyajtl tu'n kymjeju' kymyal ex kyk'wal kyuk'i'lu' te junxi'tl tnam, ex tu'n lalun che kyk'amju' qya te junxi'tl tnam te kyxu'jil kyk'wal mujqa te kyxu'jilku'. Ex xinma'ntle' kye: <verse number="26" style="v" />¡Ana' ilju' tb'incha Salomon, nimaqkawil toj Israel! Mixpetzunti' juntl nimaqkawil ten kyoju' txqantl nimaqtnam kse'nte, extzun k'u'jlanjtz tu'n Dyos ex oktq'o'n te nimaqkawil tib'aj tkyaqilu' Israel, aye'tlju' qya te junxi'tl tx'otx' e'xiq'inte toj il. <verse number="27" style="v" />Qu'mtzun, lay tzik'x tna'l qama che b'inchan ile' nimxi'x twitz Qman Dyos, qama che mjeye' kyuk'i'lu' qya te junxi'tl tnamqe'.</para>
  <para style="p">
    <verse number="28" style="v" />Ati junju' tk'wal Joyada, ju' tk'wal kynejel pale Elyasib', tjitl Sanb'alat toqpe', ju' aj Oron, ex nxla'ja'ne' tu'n lalun tentl nk'itze'. <verse number="29" style="v" />¡Taye: na'nqe'tzju'ya matxi' b'aj kytz'ilsa'nju' kyoklen te pale exju' yol kyajni b'entti'ju' kyoklen pale ex aj Leb'i!</para>
  <para style="p">
    <verse number="30" style="v" />Ikytzu'n eb'aj nẍtilsa'ne' te tkyaqilju' te junxi'tl tnam ex eb'aj nnk'u'nju'ye' kyajb'eb'l pale ex aj Leb'i toj k'loji'n, teyile junjun toju' taq'un; <verse number="31" style="v" />tu'n tulu' si toju' tq'ijlalil q'ma'ntl, ex tu'n kyul kyiq'i'nju' tnejel kywitz awal. ¡Taye, chin tna'tza tu'n t-xtalb'ila!</para>
</usx>