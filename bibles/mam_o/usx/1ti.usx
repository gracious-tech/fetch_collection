<?xml version="1.0" encoding="utf-8"?>
<usx version="2.6">
  <book code="1TI" style="id">1TI. TXT Febrero 2009 Ruperto Romero Mam Ostuncalco. Updated for DBL by G. Grasso and E. Canales, December 2012, standardization after migration to PT8 by A. Camus March, 2019.</book>
  <para style="h">1 Timoteo</para>
  <para style="toc3">1 Ti</para>
  <para style="toc2">1 Ti</para>
  <para style="toc1">Tnejel U'j Xitz'ib'a'n Te Timotey (1 Timoteo) Chik'b'ab'l</para>
  <para style="mt1">TNEJEL U'J XITZ'IB'A'N TE TIMOTEY</para>
  <para style="mt2">(1 Timoteo)</para>
  <para style="imt">CHIK'B'AB'L</para>
  <para style="ip">Ate' tnejel u'ju' lu kxolju' b'ajx ttz'ib'a'n Pawl atok tb'i u'j te k'ik'leb'l. Ate' Timotey jun ku'xintoq, aj Juda ttxu atzun tman aj Krek, aj ojetoq tz'el yal tu'n Pawl toj tnam Listra (Hech. 6.1-3), intoq k'u'jlanjtz b'a'nxi'x tu'n Pawl ex intoq nonin tuk'i'l. Atzunju' u'j lu xitz'ib'a'n te Timotey exju' juntl u'j e'okq'o'n te Ttxu Kawb'il teju' ku'xun okslal aj k'ik'lel. Kykab'ilx tz'ib'a'n txqan nab'l toj, kye k'ik'lel, kye manb'aj.</para>
  <chapter number="1" style="c" />
  <para style="p">
    <verse number="1" style="v" />Ayine' Pawl chq'o'nqine' tu'n Qajaw Jesukrist, ex chq'onqine' tu'n Dyos aj klolqe ex q'uqlok qk'u'j ti'j, <verse number="2" style="v" />nxi' nq'olb'e'na Timotey, aya nk'walku'xi'xa toj okslab'l. Awt Qman Dyos ex Qajaw Jesukrist k'iwlanxi'x teya, tzajxwit laqj tk'u'j ti'ja ex tenxwita toj nak'b'il tu'n.</para>
  <para style="s1">Xitma'n Pawl kye okslal tu'n lalun txi' kb'i'n xnaq'tzb'il myab'a'n</para>
  <para style="p">
    <verse number="3" style="v" />Kse'n xinkub'sa'ne' teya tu'n tkyeja toju' tnam Epeso, tej nxi'ye' toju' tx'otx' Masedonya, ex ikxtzun wajb'ile' tu'n txi'ya q'malte kyeju' junjun xjal tu'n lalun kyaq' xnaq'tzb'il myab'a'n <verse number="4" style="v" />ex tu'n lalun txi' kb'inju' yol naqx la'j ex tu'n lalun b'ajx kk'u'j ti'ju' tz'ib'a'n kyi'ju' ojtxi' kyajilb'en. Qu'n tkyaqil ja'lu naqx wuli'n ntzaj tu'n ex mixti' nonin tu'n telxi'x qnik' ti'ju' tyol Dyos aj najb'en qe toj qokslab'l.</para>
  <para style="p">
    <verse number="5" style="v" />A tb'is tk'u'j yol lu aju' tu'n qk'u'jlante qib' qxolilex, tuk'ilju' jun tk'u'jlalil ntzaj anq'in toj qanmi majx ẍtilun, ex tu'n qb'inchante b'a'n intma'n qanmi ex tu'n tten qokslab'l axxi'x mya xmletz'. <verse number="6" style="v" />Qu'n ate' junjun matxi' che eltxalpuj ti'ju' okslab'l ex matxi' che b'ajxtzpet tu'n tpaj xi' nb'ajxa' kyk'u'j tiju' yol naqx la'j. <verse number="7" style="v" />Kyajb'il tu'n kyok xnaq'tzalte tkawb'il Dyos, extzun minti' nkane' toj kwitz aju' nkma'n extzunju' nkxnaq'tza'n.</para>
  <para style="p">
    <verse number="8" style="v" />Qu'n kanli toj qwitz qa aju' kawb'il b'a'nte', qama b'inchet se'nxju' intma'n. <verse number="9" style="v" />Ex ati tu'n tkane' toj qnab'l qa aju' kawb'il myatzu' ta'xixte' tajb'en kyeju' nkb'incha'n b'a'n, atzu' ta'te' tajb'en kyeju' pi's exqe'ju' min nche okslan, kyeju' b'inchal myab'a'n ex aj il, kyeju' mixti' tchiylal Dyos kye, kyeju' nche kub' b'yonte kman ex kye kykyaqilju' nche b'yon wnaq, <verse number="10" style="v" />ex kyeju' ajpajil, ex kyeju' ichan nche ajpajin tuk'ilx juntl ichan, ex kyeju' nche elq'an xjal, ex kyeju' chalyol, ex kyeju' ntzaj kna'n Dyos ti'j jun ti'xti', ex kyeju' nche b'inchan txqan ti'xti' taq'wixi'x ex mya nkb'incha'n se'n ntma'nju' xnaq'tzb'il b'a'n. <verse number="11" style="v" />Atzunju' xnaq'tzb'il b'a'n saj oqxenante weye' tu'n nyoline' ti'ju' tpakb'al b'a'n tzaj tq'o'n Dyos.</para>
  <para style="s1">Xitq'o'n Pawl chjonte te Dyos tu'n tzaj q'aq'an tk'u'j ti'j</para>
  <para style="p">
    <verse number="12" style="v" />Inxi' nq'o'ne' chjonte te Qajaw Jesukrist, tu'nju' matzaj tq'o'n wipumale' toju' taq'un ex tu'nju' maqe tk'u'j wi'je' ex machin oktq'o'ne' te ajb'el te, <verse number="13" style="v" />extzun nejku' intoq xinma'n txqan nyole' taq'wixi'x ti'j, oknljo'ne' toj tq'ij ex intoq chin wuline' ti'j. Atzun ja'lo matzaj laqj tk'u'j Dyos wi'je', qu'n na'mxtoqna' wokslane' te ex na'mtoq tkane toj nnab'le' qa mya'toq b'a'nju' nb'incha'ne'. <verse number="14" style="v" />Atzunte Qajaw Jesukrist xb'inchante xtalb'il we'ye', matzaj tq'o'nju' wokslab'le' ex tk'u'jlalil, tu'nju' mujli qten tuk'i'l Jesukrist.</para>
  <para style="p">
    <verse number="15" style="v" />Ate Jesukrist ul twitz tx'otx' klol kye aj il, expe' ayinx junwe' nimxi' wile', qu'mtzun qkyaqil ati tu'n qokslante. <verse number="16" style="v" />Atzunte Dyos tzaj laqj tk'u'j wi'je', tu'ntzun tel tnik'tzil qa nimte' Dyos tpasensi qi'j. Tu'ntzun ja'lu ẍi noka'ye' te jun yek'b'il kyeju' che okslal te Qajaw Jesukrist tu'n ttenju' kychwinqlal tejumajx. <verse number="17" style="v" />¡Qnimanktz ex qajwalinktz tb'i Qman Dyos, qu'n ate nimaqkawil tejumajx, milo kkyimela', mixti' q'ancha'l ex naq junku'! Ikxwitju'.</para>
  <para style="p">
    <verse number="18-19" style="v" />Aya Timotey nk'wala toj okslab'l, inxi' wab'tzine' teya tu'n tq'ojina b'a'nxi'x toju' q'oj ljo'n tuk'i'l tokslab'la, tpasensiya, ex na'ntzjuya yol aj kyejni q'ma'n teya kyu'nju' t-sanjelal Dyos. Qu'n ate junjun tu'n minti' kb'inchaju' ntma'n kyanmi matxi' che kub' b'o'lj toj kyokslab'l. <verse number="20" style="v" />Qu'n ik b'ajiju' kyi'j Imeney ex Ljantr; ex aye' ja'lu matxi' che'x nq'o'ne' toj tq'ob' Tajaw il, tu'ntzun telkynik' qa myab'a'n nxi' kma'n kyol taq'wix ti'j Dyos.</para>
  <chapter number="2" style="c" />
  <para style="s1">Chik'b'ab'l tib'aju' na'j Dyos</para>
  <para style="p">
    <verse number="1" style="v" />Tnejelxi'x kxe'l wab'tzi'n teya tu'n kna'n kkyaqil okslal, ex tu'n kkub'san twitz Dyos ex tu'n txi' kq'o'n chjonte te Dyos kyi'j kkyaqil xjal. <verse number="2" style="v" />Ati tu'n kna'n Dyos kyi'ju' nche kawin ex kyi'ju' ati kyoklen ti'j kawb'il, tu'ntzun tb'ent qanq'in toj nak'b'il kxol xjal, ex tu'n qten toj tzalajb'il, tu'ntzun qniman te Dyos ex tu'n qb'et toj tnik'alti'j. <verse number="3" style="v" />Qu'n tkyaqil ja'lu b'a'n toj twitz Qman Dyos aj klolqe, <verse number="4" style="v" />qu'n ate tajb'il tu'n kklet kkyaqil xjal ex tu'n telkynik' ti'ju' axx. <verse number="5" style="v" />Qu'n ate Dyos naq junte', ex naq junju' yolil ati kxol xjal tuk'i'l Dyos, atzunju' yolil lu a Jesukrist aj ok te xjal. <verse number="6" style="v" />Qu'n ate Jesukrist taq'tib' tu'n tkyim te chojb'il ex tu'n kklet kkyaqil xjal ex atzu' chik'eya ja'lu tej tjapun tq'ijlalil. <verse number="7" style="v" />Tu'ntzun tpakb'et ja'lu, ayine' nsk'onjtze' ex nchq'onjtze' tu'n Dyos, tu'ntzun nq'onteye' xnaq'tzb'il tib'aju' okslab'l exju' axx kyeju' xjal mya aj Judaqe'. Aju' nxi' nma'ne' axte'; ex mixti' nchin chanyole'.</para>
  <para style="p">
    <verse number="8" style="v" />Qu'mtzun awajb'ilju'ye' tu'n kna'n ichan Dyos jaxjaku', tu'n tjaw kyiq'in kq'ob' ajkyna'n Dyos tuk'i'l jun kyanmi ẍnu'l, mixti' q'oj ex ik'jtib'il toj. <verse number="9" style="v" />Ex wajb'ile' tu'n tok kyxb'alun qya b'incha'n tojxi'x tnik'alti'j ex mya te nimjtib'il, tu'n kyb'et tojxi'x tu'me'l, ex tu'n kyxeb'ante kywi' tojxi'x tu'me'l, ex tu'n lalun tz'ajb'en q'anpwaq kyu'n, tb'anil ab'j mujqa kyxb'alun twi' wi'yal kyu'n, tu'n lalun tz'ok b'ajkywitz xjal kyi'j. <verse number="10" style="v" />Awt kyachb'ilju' b'a'n aq'untl, kse'nxju' tu'n kb'inchante qya nkyk'u'jla'n Dyos ex nche niman te. <verse number="11" style="v" />Ex awajb'ilju'ye' tu'n kkub' nume qya naqa xxiq'etju' xnaq'tzb'il kye; <verse number="12" style="v" />ex mixti' wajb'ile' tu'n kq'onte qya xnaq'tzb'il kwitz txqan xjal ex ikx tu'n kkawin kyib'aju' ichan, naq o'kx ati tu'n kkub' nume, <verse number="13" style="v" />Qu'n nej kub' tb'inchante' Dyos ichan Adan tb'i, ex yajxi'xtl kub' tb'incha'n Eb'a; <verse number="14" style="v" />Ex myate Adan kub' sb'u'n tu'nju' kan, ate' Eb'aju'; tu'ntzunju' kub' sb'u'n, atzuntzu' kub'a' tz'aq toj il. <verse number="15" style="v" />Oktzun che kletelkye' qya qama che ok te txub'aj tnik'alxi'xkyi'j, exqa kukx kyktenju' toj okslab'l, toj tk'u'jlajil exqa matz'el kypa'n kyib' ti'j tkyaqil taq'wix exqa ati knab'l.</para>
  <chapter number="3" style="c" />
  <para style="s1">Se'n tu'n kyanq'ina' nejenel kxol okslal</para>
  <para style="p">
    <verse number="1" style="v" />Axte' kxe'l nma'ne' kyeye'. Qa ati jun xjal tajb'il tu'n tok nejenel kyxol okslal, jun b'a'n aq'untlte' tajb'il tu'n tb'inchante. <verse number="2" style="v" />Qu'mtzun alkyeju' xjal tok te nejenel ati tu'n tanq'in tojxi'x tnik'a ti'j. Ati tu'n tok chmilb'aj te junx qya ex ati tu'n tanq'in tojxi'x tu'me'l, ati tu'n tok tz'aqlixi'x tnab'l ex b'a'nwnaq. Ati tu'n tq'onte anb'il kye xjal tu'n kkyej tja ex ati tu'n tok te jun b'a'n xnaq'tzal; <verse number="3" style="v" />mixti' tu'n ttx'ujt ex mixti' tu'n tjyon q'oj kyuk'i'l xjal, ape' tb'inchaju' tu'n tok te jun xjal lwiy ntzaj q'aq'an tk'u'j ti'j juntel ex mixti' tu'n toktq'o'n twitz ti'j pwaq. <verse number="4" style="v" />Ati tu'n tkawin b'a'n kyib'aju' te toj tja ex tu'n tq'onte knab'lju' tk'wal tu'ntzun kyok b'a'nqe' ex nche okslan te Dyos; <verse number="5" style="v" />qu'n qa ati jun okslal mixti' nb'ent tkawin tojku' tja, ¿Se'n taq'wi tu'n tb'ent tkawin kxol okslal qama tz'ok te nejenel? <verse number="6" style="v" />Qu'mtzun aju' ati tu'n tok te nejenel kxol okslal mya jun ak'a'j okslal, qu'n jaku' jawtnima'n tib' ex atzuntzu' jaku' kub'a' tz'aq toj il se'nte tajaw il. <verse number="7" style="v" />Ex ati tu'n tok b'a'n tyolinjtz kwitz xjal mya okslalqe', tu'ntzun lalun tz'el tch'ixaw ex tu'n lalun kub' tz'aq toj t-xpatxab' tajaw il.</para>
  <para style="s1">Se'n tu'n kyanq'inaju' tmajen Dyos kxol okslal</para>
  <para style="p">
    <verse number="8" style="v" />Ex ikxqeju' tmajen Dyos ati tu'n kyok b'a'n kwitz xjal, mixti' tu'n kychan yol ex mixti' tu'n ktx'ujt ex mixti' tu'n kyjamjon ti'j pwaq. <verse number="9" style="v" />Ex ati tu'n tokqe kk'u'j kukx ti'ju' axxi'x tzajni tq'o'n Dyos qe, ex ati tu'n ttenju' kychwinqlal tojxi'x ẍtilun. <verse number="10" style="v" />Ati tu'n tik' kwitzlalil tnejelxi'x, qatzun mixti' jun kpaltil, b'a'ntzun kyoktzu' tmajen Dyos kxol okslal. <verse number="11" style="v" />Ex ikxqeju' qya ati tu'n kyok b'a'n kywitz xjal, mya jk'ul yolqe', jk'u'nkyib' ex njapun kyu'n toj tkyaqil. <verse number="12" style="v" />Aju' jun ichan tmajen Dyos ati tu'n tok chmilb'aj te naq jun qya, ex ati tu'n tb'ent tkawin kyib'aju' tk'wal ex tojku' tja. <verse number="13" style="v" />Qu'n aye'ju' tmajen Dyos nkb'incha'nju' kyaq'un b'a'nxi'x, in kkanb'anju' jun kyoklen ex nche nimanjtz kyu'n kkyaqilju' okslal ex ntenxi'x kyipumal toj kyokslab'l ti'j Qajaw Jesukrist.</para>
  <para style="s1">Aju' qokslab'l nimxi'x toklen</para>
  <para style="p">
    <verse number="14" style="v" />Inchin ximane' tu'n nxi'ye' ka'yilteya lwiyxi'x; tu'ntzun na'mx nxi'ye' nxi' ntz'ib'a'ne' u'j lu teya, <verse number="15" style="v" />tu'ntzun qa minti' ẍin pon kanune' lwiy, loq' b'i'ntl tu'na se'ntaq'wi tu'n tjapun qajb'eb'l kxolju' tk'wal Dyos, aye'ju' okslal ti'j Dyos itz', qu'n aye'ju' okslal lu tzyulte ex q'ilteju' tyol Dyos axxi'x. <verse number="16" style="v" />Qu'mtzun aju' yol saj yek'un qe ti'ju' qokslab'l axte' ex nimaq toklen qu'n:</para>
  <para style="b" />
  <para style="q">Ate Krist oktq'o'n tib' te xjal tu'n tyek'u'ntetib' qe,</para>
  <para style="q">ex chik'b'anjtz tu'nju' Xewb'aj Xjan qa tnik'alti'j</para>
  <para style="q">ok ka'yi'n kyu'n anjl.</para>
  <para style="q">Pakb'anjtz kye nimaqtnam,</para>
  <para style="q">ex nim xjal e'okslan te toj tkyaqil twitz tx'otx'</para>
  <para style="q">xiq'intzuntz toj kya'j.</para>
  <chapter number="4" style="c" />
  <para style="p">
    <verse number="1" style="v" />Atzunte Xewb'aj Xjan intma'n chik'lixi'x qa toju' mankb'il tq'ijlalil k'elel kypa'n kyib'ju' okslal ti'ju' kyokslab'l, ex che okyel lpe kyi'ju' xjal nche' sb'u'n ex chq'o'nqe' tu'n tajaw il ex kxe'l kb'i'nju' kxnaq'tzb'il tajaw il. <verse number="2" style="v" />Kche b'il kyeju' xjal xmletz'qe' ex kyeju' chalyol, aye'ju' xjal mixti'x ch'i'n kych'ixaw tu'nju' kb'inchb'en taq'wixi'x. <verse number="3" style="v" />Aye'ju' xjal lu lay kyej tu'n kmjeju' xjal ex tu'n kych'yonte jun chib'j aj kyejni tq'o'n Dyos tu'n kych'yonteju' okslal exqe'ju' ojtzqi'n axx kyu'n, ex tu'n kq'o'n chjonte te Dyos ti'j aj kych'yonte. <verse number="4" style="v" />Qu'n tkyaqilju' tch'isb'en Dyos b'a'nte'; ex mixti' tu'n tel qik'u'n, naq o'kx ati tu'n qq'o'n chjonte te Dyos ajt-xi' qch'yo'n. <verse number="5" style="v" />Qu'n tkyaqilju' qwa nk'i'wlanjtz tu'nju' tyol Dyos ex tu'n na'j Dyos.</para>
  <para style="s1">Jun b'a'n majen te Jesukrist</para>
  <para style="p">
    <verse number="6" style="v" />Xnaq'tzanxa lu kyeju' qitz'in mujqa qtzik, ex k'okyeltzuntza te jun majen b'a'n te Qajaw Jesukrist, jun majen k'a'cha'n tib' tuk'ilju' tyol Dyos te okslab'l ex tu'nju' b'a'n xnaq'tzb'il aju' matxi' tz'ok lpeya ti'j.</para>
  <para style="p">
    <verse number="7" style="v" />Ex lalun taq' anb'ila kyeju' la'j mixti'x kyajb'en ex mixti'x knab'l. Q'onkta tilil tu'n toka b'a'n ex tu'n tnimana te Dyos; <verse number="8" style="v" />atipena' tajb'enju' xqutz'b'il qxmilal tu'n lalun qo yab'ti, mitzunloyate' qama tz'ok tilil qu'n toju' qokslab'l ti'j Dyos, qu'n k'ajb'el qe tzalu twitz tx'otx' ex toju' juntl qchwinqlal tuk'i'l Dyos. <verse number="9" style="v" />Ate' lu axxi'x ex qkyaqil ati tu'n qokslante. <verse number="10" style="v" />Tu'ntzun ja'lu nqo aq'unana' ex noka' tilil qu'n, qu'n matxi' tz'okqe qk'u'j tiju' Dyos itz', aj Klol kye kkyaqil xjal, aye'xixju' nche okslan te.</para>
  <para style="p">
    <verse number="11" style="v" />Xnaq'tzanxa tkyaqil ja'lu kyeju' okslal. <verse number="12" style="v" />Lalun taja tu'n tel ik'una kyu'n xjal naq tu'nju' ku'xuna; naq o'kx tz'okxa te jun yek'b'il kxol kkyaqil okslal, tz'okxa b'a'n yolina, b'eta tojxi'x tu'me'l, tenx tk'u'jlalila, tenx tokslab'la ex ẍtilsam tanmiya. <verse number="13" style="v" />Akxtzun nchin pone', tenka ẍch'ilteju' tyol Dyos kwitz kkyaqil okslal, che t-xnaq'tzama ex che tkuwsanxa toj kyokslab'l. <verse number="14" style="v" />Lalun kub' tyajunjuya toklena oje tzaj q'o'n tu'n Dyos, aj tzaj tq'o'n Dyos teya tej tkub' q'o'n q'ob'aj toj twi'ya kyu'nju' tijwnaq, qu'n ax Dyos q'mante kye tu'n tk'monteya toklena.</para>
  <para style="p">
    <verse number="15" style="v" />Xonk tk'u'ja ti'j tkyaqil ja'lu, ex q'onk tilila tu'n tjapun tu'na, tu'ntzun kyka'yinte kykyaqil xjal qa nim xi' tb'enti tu'na. <verse number="16" style="v" />Ka'yinxtib'a ex ximana ti'ju' xnaq'tzb'il nxi' tq'o'na kyeju' okslal, we'ku'ya b'a'nxi'x toj tokslab'la. Qatzun matb'inchaya ikju', kkleteltzuntziya tib'xtib'a ex ikx che kletelju' nche' b'in teya.</para>
  <chapter number="5" style="c" />
  <para style="s1">Se'n tu'n qnajana' kxolju' txqantl okslal</para>
  <para style="p">
    <verse number="1" style="v" />Lalun tz'ok tilina jun tijwnaq; ape' b'inchamjuya, q'onxa tnab'l nakuxwitloj tmana; ex yolina b'a'nxi'x kyuk'ilju' ku'xun nakuxwitloj titz'ina mo ttzika. <verse number="2" style="v" />Ex q'onqe'ka qya matxi' tzaj kywinqil naku'xwitloj ttxuya; ex ikxqeju' txin nakuxwitloj tanab'a tuk'i'l tkyaqil tanmiya.</para>
  <para style="p">
    <verse number="3" style="v" />Tz'onina kyi'ju' qya mixti' kychmil aj atixi'x nojqelan toj kychwinqlal. <verse number="4" style="v" />Qatzun ati jun qya kyimni tchmil ate' tal mujqa tchman, ayekye' lu ati tu'n toktilil kyu'n tnejelxi'x tu'n tjapun kyu'n aju' tu'n kb'inchante toj kja, iku' se'nxju' ẍe'x ka'yi'n nejku' kyu'nju' kman, qu'n atzunte b'a'nju' toj twitz Dyos. <verse number="5" style="v" />Aju' qya qama kyejten axxi'x kyimni tchmil, qama kyejten tjunal, nok qexi'x tk'u'j ti'j Dyos ex inkub'san toj tnaj Dyos qonik'an ex q'ijtl. <verse number="6" style="v" />Atzunju' qya kyimni tchmil qa nxi' tq'o'ntib' toj achb'il, matxi' kyim maskye itz'x. <verse number="7" style="v" />Qu'mtzun q'maxa kye tkyaqilju' xinma'ne' teya, tu'ntzun mix-a'lo' jun kyolil kyi'j. <verse number="8" style="v" />Qu'n qa ati jun okslal minti' nb'ajx tk'u'j tu'n kyonitju' twitze'l exqe'ju' tojku' tja, matxi' tz'el tpa'n tib' ti'ju' tokslab'l expe' nimxi'x til kyekwitzju' na'm kyokslan.</para>
  <para style="p">
    <verse number="9" style="v" />Oqe'kx qyaju' tu'n ttz'ib'it kb'i kxolju' qya mixti' kychmil qa matxi' che pon toj oxnaq ab'q'i exqa naq jun kychmil ati. <verse number="10" style="v" />Ex atzu' k'elela' knik'tzil tu'nju' kb'inchb'aj b'a'n, qama che kych'isa kyal b'a'n, qama txi' kq'o'n kposad xjal kja, qa matxi' che ajb'en tojxi'x tnik'alti'j kxolju' okslal exqa matxi' che onin kyi'ju' nche' yajt. Mujqa makyaq'kyib' tu'n kb'inchante tkyaqilju' b'a'n.</para>
  <para style="p">
    <verse number="11" style="v" />Aye'tzunju' qya na'm tponju' kyab'q'i lalun che oktq'o'na toj tajlal; qu'n ajtpon kk'u'j ti'j jun ichan inel kypa'n kyib' ti'j Qajaw Jesukrist, ex kyajb'il tu'n kmje jumajtl <verse number="12" style="v" />ex tu'ntzun ja'lu noka' kyil tu'nju' minti' njapunju' xini kytziya'n. <verse number="13" style="v" />Ex ikx nche' nq'et tu'n kb'et jayi'n ex nche elky'ej; ex myanaq o'kx nche' b'je'l ky'ej, ex ikx nche' nq'et tu'n kjk'un yol, ex jaxjaku' nokxa' klmo'n kyib' ex nche okten q'mal yol myab'a'n tu'n kmante. <verse number="14" style="v" />Qu'mtzun awajb'ilju'ye' tu'n kmjeju' qya txinqe'x aj mixti' kychmil, ex tu'n kyalan, ex tu'n txi' kka'yinju' toj kja ex tu'n lalun txi' kq'o'n anb'il kyeju' kyajq'oj tu'n kxmayin kyi'j. <verse number="15" style="v" />Qu'n ate' junjun qya mixti' kychmil matxi' tz'el kpa'n kyib' ti'j Dyos ex matxi' che oklpe ti'j tajaw il.</para>
  <para style="p">
    <verse number="16" style="v" />Qa ati jun qya okslal ati jun qya kyimni tchmil tk'etz, ati tu'n tonin ti'j, tu'ntzun lalun tz'ok te kk'a'ch okslal; tu'ntzun kyoninkye' okslal o'kx kyi'ju' qya mixti'x ati kye.</para>
  <para style="p">
    <verse number="17" style="v" />Aye'ju' tijwnaq kxol okslal nkb'incha'n kyaq'un b'a'nxi'x, ati tu'n kxi' ka'yit b'a'nxi'x, ex aye'xi'xju' nche' pakb'an ex nche' xnaq'tzan ti'j tyol Dyos. <verse number="18" style="v" />Qu'n iku' ntma'n toju' Tu'jil tyol Dyos kjalu: Lalun tz'ok tq'o'na twi' ttxa'nju' wakx in triyan. Ex ikx intma'n: Aju' aq'unal ati toklen ti'ju' twi'tk'u'j.</para>
  <para style="p">
    <verse number="19" style="v" />Qa ati jun xjal npoqin ti'j jun tijwnaq in kawin kxol okslal, lalun txi' tb'ina qa mixti' kab'e' mujqa oxe' tziyal ti'j.</para>
  <para style="p">
    <verse number="20" style="v" />Qa ate junjun tijwnaq mache b'inchan il, tzak'unqe'xa kwitz kkyaqil okslal, tu'ntzun tten tchiylal kyeju' txqantl.</para>
  <para style="p">
    <verse number="21" style="v" />Inxi' wab'tzine' teya twitzku' Dyos, twitz Qajaw Jesukrist ex kwitzku' anjl sk'o'nqe' tu'n, b'inchanxa tkyaqil matxi' txi' nma'ne' teya, ex b'inchama junelni kyib'aj kkyaqil, mya junwit b'a'n tilwi atzun juntel myab'a'n tilwi tu'na. <verse number="22" style="v" />Lalun txi' tq'o'na toklenju' jun okslal lwiyxi'x, ximankuya b'a'nxi'x, tu'ntzun lalun jaw tiqanjuya til. Xq'uqimta tib' tu'ntzun ttenju' tchwinqlala toj jun ẍtilun.</para>
  <para style="p">
    <verse number="23" style="v" />Tu'ntzunju' jachq'al nyab'tiya tu'n tk'u'ja, lalun txi' tk'wana naq o'kx a', ex ikx k'wanxa ch'i'n b'in tuk'i'l.</para>
  <para style="p">
    <verse number="24" style="v" />Ate' xjal q'ancha'lxi'xju' kyil na'mtoq kyok toj xjel, atzun txqantl tzmaxi' kchik'eb'el ajkyok toj xjel. <verse number="25" style="v" />Ex ikxtzunte b'a'n aq'untlju' nkub' chik'e b'a'nxi'x; ex aye'tzunju' aq'untl myab'a'n layx b'ent kkub' e'wa'n.</para>
  <chapter number="6" style="c" />
  <para style="p">
    <verse number="1" style="v" />Aye'tzunju' okslal majenqe' ati tu'n kyokslan kyeju' tajaw aq'untl, tu'ntzun lalun che yolin xjal myab'a'n ti'j Dyos ex ti'ju' xnaq'tzb'il. <verse number="2" style="v" />Qatzun aye'ju' tajaw aq'untl okslalqe', lalun kximaju' majen qa mixti' tu'n kyokslan naq tu'nju' kyitz'inkyib' toj okslab'l. Ape' kb'inchaju', ati tu'n kyajb'en b'a'nxi'x, qu'n okslalqekye' janche ajb'ena' ex nkyk'u'jla'nkyib' kyuk'i'l.</para>
  <para style="s1">Aju' okslab'l exju' tzalajb'il ti'ju' ati qe</para>
  <para style="p">Atzun xnaq'tzanxjuya lu kye ex q'onxa knab'l: <verse number="3" style="v" />Qa ati jun xjal nq'o'n junxi'tl xnaq'tzb'il ex myaju' se'nju' xnaq'tzb'il tu'n Qajaw Jesukrist, exqa mya junx tnab'l tuk'ilju' qokslab'l, <verse number="4" style="v" />jun xjalte' naq njaw tnima'ntib' extzun mixti'xte b'a'n tu'n. Ate xjal lu ati tyab' twi'; qu'n a tajb'ilju' tu'n tq'ojin ex tu'n twulin kyi'ju' yol, ex tu'n tpajtzun ja'lu ntzaja' tx'a'lti'j kk'u'j xjal, inche yasun, ex nche' ximan myab'a'n kyi'j txqantl <verse number="5" style="v" />ex nche' wulin kukxju' qu'n tzpetjni knab'l ex minti' ojtzqi'nju' axx kyu'n, ex in kxima'n qa aju' okslab'l najb'en kye tu'n kq'inumax. <verse number="6" style="v" />B'ayte' iknatzunju' ate' okslab'l ti'j Dyos jun q'inumalte', qa nqo' tzalaj ti'ju' ati qe. <verse number="7" style="v" />Qu'n mixti'xte sul qi'n twitzju' tx'otx' lu ex mixti'xte' k'anjel qi'n; <verse number="8" style="v" />naqa ati qwa ex qi'j, yaqintzunte', qu'mtzun ati tu'n qten toj tzalajb'il. <verse number="9" style="v" />Aye'tzunkye' kyajb'il tu'n kjaw q'inumax lwiy nche kub' tz'aq toj t-xpatxab' tajaw il, ex majx nche'x b'inchal txqan ti'xti' mixti'x tajb'en ex nche' k'ixb'i xjal tu'n, ex majx nche' mulq'aj xjal tu'n tejumajx toj xitb'il ex naje'n. <verse number="10" style="v" />Qu'n tkyaqilju' taq'wixil atzu' ntzaja' ti'ju' tq'aq'al pwaq; ex ate' junjun matxi' che eltxalpuj ti'ju' kyokslab'l tu'n tpaj inxi'x nkyk'u'jla'nju' pwaq, ex tu'nxju' knab'l nche' yajtiya' toj nim k'ixk'oj.</para>
  <para style="s1">Aju' tu'n toktilil qu'n toj qokslab'l</para>
  <para style="p">
    <verse number="11" style="v" />Atzunta aya najb'ena te Dyos kutoqa te tkyaqil ja'lu. Q'onk tilila tu'n toka tnik'alxi'xti'j, ex nimana te Dyos, tenx tokslab'la, tenx tk'ujlalila, tenx tpasensiya ex tz'okxa me's. <verse number="12" style="v" />Tz'okx tilil tu'na toj tokslab'la se'n jun xjal te q'oj, tu'ntzun tkub'ti'j myab'a'n tu'na; ex lalun ttzaqpiya chwinqlal tejumajx, qu'n a xtxokla'ya tu'n Dyos ex oje tchik'b'aya tokslab'la kywitz b'a'npun tziyal. <verse number="13" style="v" />Atzun ja'lo twitzku' Dyos aju' nq'onte kychwinqlal kkyaqil ti'xti', ex twitzku' Jesukrist aj taq' jun tziyb'il b'a'nxi'x twitz Pons pilat kxe'l wab'tzina' teya tu'n <verse number="14" style="v" />txi' toksla'na matxi' b'ajx nma'ne' teya, tu'ntzun mix-a'lo' jun xjal kpoqolteya toj il, b'inchama tkyaqil ja'lu akxku' nul Qajaw Jesukrist. <verse number="15" style="v" />Ajtzun tjapunju' tq'ijlalil, ktzajel yek'un Jesukrist tu'n Dyos, qu'n ate in kawin kyib'aj tkyaqil, ate Dyos Nimaqkawil kyib'aj kykyaqil nimaqkawil ex ate nimxi'x toklen kyib'aj kykyaqilju' nimaq kyoklen. <verse number="16" style="v" />Qu'n o'kxte Dyos milo kkyimela', ex atzu' najla' toju' spik'un aj lay b'ent qpon lq'e tk'etz. Mix-a'lox jun ichan oje tz'ilwente ex mix-a'lox jun k'okyel ka'yinte. ¡O'kxwittzun Dyos nimanjtz ex tu'n tten tipumal tejumajx! Ikxwitju'.</para>
  <para style="p">
    <verse number="17" style="v" />Q'manxa kyeju' q'inun toju' tq'ijlalil ja'lo tu'n lalun jaw knima'nkyib' ex tu'n lalun tz'okqe kk'u'j ti'ju' kq'inumal, qu'n ate q'inumal mya q'uqlite tk'u'jlalil. Ate' b'a'nju' tu'n kb'inchante aju' tu'n tokqe kk'u'j ti'j Dyos, ntzaj q'onte tkyaqil ti'xti' qe ex ntzaj tq'o'n nimxi'x tu'n qtzalaj ti'j. <verse number="18" style="v" />Q'manxa kye tu'n kb'inchanteju' b'a'n, tu'n kq'inumax toju' b'a'n aq'untl ex tu'n kyaq'punteju' ati kye ex tu'n kq'onte se'nxju' tb'is kk'u'j. <verse number="19" style="v" />Iktzu'n ktenb'ila' kq'inumal mi b'ajel toju' juntl chwinqlal tuk'i'l Dyos ex q'uqlitzun kk'u'jtzu' ti'ju' chwinqlal te jumajx.</para>
  <para style="s1">Aju' xitab'tzi'n Pawl te Timotey tu'n tb'inchante</para>
  <para style="p">
    <verse number="20" style="v" />Aya Timotey, ka'yinxa taq'una matxi' tzaj q'o'n teya tu'n Dyos. Lalun txi' tb'ina kyol xjal mixti' tchiylal Dyos kye, qu'n aju' kyol mixti'x tajb'en, ex pa'mil tib'a kyi'ju' inkyma'n qa nim kyojtzqib'l extzun mixti' b'a'n kyu'n; <verse number="21" style="v" />qu'n ate' junjun matxi' txi' kb'i'n, ex matxi' che eltxalpuj ti'ju' kyokslab'l.</para>
  <para style="p">Awttzun Dyos k'iwlankyeye'. Ikxwitju'.</para>
</usx>