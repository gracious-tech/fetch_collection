<?xml version="1.0" encoding="utf-8"?>
<usx version="2.6">
  <book code="1TH" style="id">1TH.TXT Febrero 2009 Pedro D. Mam Ostuncalco. Updated for DBL by G. Grasso and E. Canales, December 2012, standardization after migration to PT8 by A. Camus March, 2019.</book>
  <para style="h">1 Tesalonisenses</para>
  <para style="toc3">1 Ts</para>
  <para style="toc2">1 Ts</para>
  <para style="toc1">Tnejel U'j Kye Aj Tesalonik (1 Tesalonicenses) Chik'b'ab'l</para>
  <para style="mt1">TNEJEL U'J KYE AJ TESALONIK</para>
  <para style="mt2">(1 Tesalonisenses)</para>
  <para style="imt">CHIK'B'AB'L</para>
  <para style="ip">Atitoqte' Pawl toju' tnam Korint tej txi' q'ma'n te tu'nju' tuk'i'l Timotey titi'toq nb'aj kyi'ju' okslal e'kub' tb'uyi'n kxol aj Tesalonik, aju' nimaqtnam te Masedonya, toj ktx'otx' aj Rom. Mk'onjtzte' tpakb'ab'l Pawl kyu'nju' mya aj Juda, aye'qe'j ma'toq che okslan teju' ktxol aj Juda, ex ma'toq che okslan te Jesukrist, tu'n tpaju' ma'toq jawkyi'nkyib' aj Juda ti'j Pawl, ex tu'ntzun tpaj exa'te Pawl toju' tnam lu. Ex iltoqti'j nche tzaj tna'nju' okslal ex atoq tajb'ilju' tu'n tb'inte se'n taqe'ya'.</para>
  <para style="ip">B'a'ntaqte' tqanil npon kanun te Pawl. Maskyepe'tzun nimtaq njaw kyi'nkyib' ti'j, nimqetaqju' okslal wa'lqetoq toj kyokslab'l ex jun yek'b'ilju' kychwinqlal kwitz txqantl okslal toju' tnej tx'otx' aju'. Intoq q'onte Pawl chjonte te Dyos ex kyeju' okslal tu'nju' ma'toq che kub' we' b'a'nxi'x toj kyokslab'l ex inxi'xtoq tzalaj tu'nju' nxi' ttz'ib'a'n, ex intoq tzaj tna'n tej atitoq kxol (1.1—3.13). Ex eb'ajx tzak'u'n tu'n Pawl tu'n kych'iy toj kyokslab'l, qu'n matxitoq kyek'unte ttzajlen qenx qa b'a'nqetoq (4.13—5.11) ex intoq che xjelun te Pawl tib'aju' ajkyjaw anq'in kyimni extzunju' ajtul jumajtl Jesus, qu'n kkyaqil inxi'xtoq che ximan tu'n tpaj ex kyajb'iltoq tu'n kb'inte se'nxixtoq. Atzunte Pawl xitma'n kye qa ikju' exqa titaq tu'n tokqe kk'u'j ti'j Jesus, ex okten q'malte knab'l tu'n kkub' we'xi'x toj kyokslab'l ex tu'n kk'u'jlante kyib'. Eb'ajtzun ttzak'u'n, b'ajx tma'n knab'l ex okten oqxenil txqan ti'xti' kye (5.12-28).</para>
  <para style="ip">Qapelo a u'ju' lu kub' tz'ib'a'n tnejelxi'x kxolju' u'j toj Xjan ak'a'j tu'jil. Kub' tz'ib'a'n tu'n Pawl qajpelo toju' kab'naqlajoj mujqa kab'naqlajoj jun ab'q'i toj tab'q'iyil ja'lo.</para>
  <chapter number="1" style="c" />
  <para style="p">
    <verse number="1" style="v" />Ayine' Pawl tuk'i'l Silb'ano ex Timotey, nche'x qq'olb'e'ne' okslalqe'ye' te Qman Dyos ex te Qajaw Jesukrist, ate' toju' nintnam Tesalonik. Awt t-xtalb'il Qman Dyos ex tnak'b'il ten kyib'aje'.</para>
  <para style="s1">Okju' kyokslab'l aj Tesalonik te yek'b'il kye txqantl</para>
  <para style="p">
    <verse number="2" style="v" />Nxi' qq'o'ne' chjonte te Dyos kukxju' kyi'je' kkyaqile', ex nche'x qoqxena'ne' toj qna'j Dyose'. <verse number="3" style="v" />Ntzaj qna'ne' taq'unb'en kyokslab'le' kukxju', tu'nju' kyk'u'jlalile' ex tu'n in ik'xkyu'ne' tu'nju' q'uqli kk'u'je' ti'j Qajaw Jesukrist twitz Qman Dyos. <verse number="4" style="v" />E'ntzik ex e'witz'in, k'u'jla'n qe'ye' tu'n Dyos, b'i'n qu'ne' ate jaw sk'on kyeye'. <verse number="5" style="v" />Qu'n tej txi' qma'ne' tpakb'al b'a'n kyeye', mya naqx tu'n yol, ex xiqyek'u'ne' tipumal Dyos ati quk'i'le' exju' ntb'incha'n Xewb'aj Xjan, tuk'i'l nim t-xtalb'il Dyos. Kanli kwitze' se'n o'anq'ina'ye' kxole', oktililu' tnik'alilti'j qu'ne' tejun b'a'n kyeye'.</para>
  <para style="p">
    <verse number="6" style="v" />Aye'tzunkye', el kykno'ne' qi'je' ex exilpeye' ti'j Qajaw, ex kk'ame' tpakb'al b'a'n tuk'i'l tzalajb'il ntzaj tq'o'n Xewb'aj Xjan kyeye' toju' yajb'il kyi'je'. <verse number="7" style="v" />Ikytzu'n e'oka'ye' te jun yek'b'il kye kkyaqil okslal kyoju' tx'otx' Masedon ex Akaya. <verse number="8" style="v" />Ma tzyet-x kyu'ne', matxi' t-xim len tqanilju' tyol Qajaw, mya o'kx kyoj Masedon ex Akaya, ex ikx toj tkyaqil plaj, matxi' b'injtz tqanil kyokslab'le' ti'j Dyos, min nojqelantl tu'n txiqma'ne'. <verse number="9" style="v" />Aye'xpekye nche q'mante qa o'kk'ame' b'a'n ex b'aj kyej kkolb'e'ne' witzleb'il ex antzkyi'je' tuk'i'l Qman Dyos itz' ex axxi'x, tu'n kyajb'ene' te <verse number="10" style="v" />ex nche ayone' tu'n tanjtztlti'j Jesus toj kya'j, ju' Tk'wal Dyos, jaw anq'in tu'n Dyos. Ate Jesus klolqe teju' tz'e'ysb'il witzb'aj xob'ajilx tzul.</para>
  <chapter number="2" style="c" />
  <para style="s1">Taq'un Pawl toj Tesalonik</para>
  <para style="p">
    <verse number="1" style="v" />Kanli kywitze' b'a'nxi'x, e'ntzik ex e'witz'in, qa ajb'enju' tej qpone' xb'etzalkyeye'. <verse number="2" style="v" />Kanlipena' kwitze' eb'jo'k tzaqpaj xjal qi'je' ex ob'aj i'li'ne' tnejel toj Pilipo, ex tzaj tq'o'n Dyos qipumale' tu'n txiqpakb'a'ne' tpakb'al b'a'n kyeye' tuk'i'l qkuwale'. <verse number="3" style="v" />Qu'n atoqju' ax nxi' qpakb'a'ne' kyeye', myatoq taq'wix qyole' nxiqma'ne' ex mix-a'lo' jun kub' qsb'u'ne'. <verse number="4" style="v" />Ik'ni pena' twitz Dyos qi'je' ex tzaj tq'o'n qeye' tu'n txiqma'ne' tpakb'al b'a'n, qu'mtzun nxi' qpakb'a'ne'. A noktilil qu'n aju' b'a'n toj twitz Dyos, myaju' b'a'n toj kwitz xjal, qu'n nik' twitz Dyos tiju' toj qanmi. <verse number="5" style="v" />B'i'ntl kyu'ne', b'ajx txa'qma'nqe' tb'anil yol kyeye', ex b'ajx che kub'a' qsb'u'ne' naqxwit tu'n ttzaj kq'o'ne' pwaq qeye'. Tojtzqi'n Dyos ja'lu. <verse number="6" style="v" />Mya nqjyo'ne' tu'n qjaw nima'ne': kyu'ne' mujqa kyu'n txqantl. <verse number="7" style="v" />Maskyepe' ati qoklene' tu'n qjaw knima'ne', chq'o'n qona'qe' tu'n Krist, ok qq'o'n qib'e' te k'wal kxole'. Kse'n jun txub'aj nche tch'isa'n ex nche'x tka'yi'n talku'xi'x. <verse number="8" style="v" />Ex atixi'x qk'u'je' kyi'je', mya o'kx tu'ntoq txiqpakb'a'ne' tpakb'al b'a'n tu'n Dyos kyeye', ex jaku'toq qaq' qib'e' tu'n qkyime' naqkyu'nele'. ¡Inxi'x qo tzalaje' kyi'je'! <verse number="9" style="v" />E'ntzik ex e'witz'in, na'n kyu'ne' inxi'xtoq qo aq'unane' ex oktilil qu'ne' tu'n tkanb'et telex qq'ije'. Intoq xiqma'ne' tyol Dyos kyeye' ex intoq qo aq'unane' q'ijtl ex qonik'an, tu'ntoq lalun qo okye' te iqtz kyeye'.</para>
  <para style="p">
    <verse number="10" style="v" />Kanlixi'x kwitze', ex ojtzqi'n tu'n Dyos, b'a'n qb'inchaye', toj ttzinunal ex mixti' jun myab'a'n qb'inchaye' kxole' okslalqe'ye'. <verse number="11" style="v" />Ex kanli kwitze' e'xiqkuwsa'ne' ex xiqq'uqb'a'ne' kk'u'je', kse'n ntb'incha'n jun manb'aj kye tk'wal. <verse number="12" style="v" />Xiqoqxe'na'ne' kyeye' tu'n kyanq'ine' kse'nx teku'xi'x Dyos qe'ye', aye' oje che txkonjtz tu'n tten kyoklen toju' tkawb'il ex toj tajwalil.</para>
  <para style="p">
    <verse number="13" style="v" />Tu'ntzunju' nqo q'on chjonteye' te Dyos kukxju', qu'n tej txiqpakb'a'ne' tyol Dyos kyeye', min kymaye' qa tyol xjal, kyk'ame' tyol ku'xi'x Dyos. Axtzunj ate tyol Dyosju', ntq'o'n twitzlalil toj kychwinqlale' aye'ye' matxi' kyokslaye'. <verse number="14" style="v" />Tej kyajtiye' toj kq'ob' kwnaqile', e'ntzik ex e'witz'in, ax b'aju' kyi'je' kse'n b'aj kyi'ju' okslal te Dyos te Krist qe' toj Juda, qu'n ikxkye ljonjtz toj kq'ij kyu'n kywnaqil aj Juda. <verse number="15" style="v" />Aye' aj Juda na'j kub' kyb'yo'n Qajaw Jesus, kse'nx tnejel eb'aj kub' kyb'yo'n t-sanjelal Dyos, ex o'etz kxla'ja'ne' kxol. Min nkb'incha'n b'a'n twitz Dyos ex ajq'ojqe' ti'j tkyaqil. <verse number="16" style="v" />Min nkjo'n tu'n txiqma'ne' tyol Dyos kye mya aj Juda tu'n kklet. Iktzu'n nkchmo'na'xi'xtl kyil. Tu'ntzun tpaj ja'lu tzul tz'e'ysb'il kwitz kuwxi'x tu'n Dyos.</para>
  <para style="s1">Tajb'il Pawl tu'n txi'tl xb'etzalkye okslal aj Tesalonik</para>
  <para style="p">
    <verse number="17" style="v" />E'ntzik ex e'witz'in, tej qik'b'ete' kxole', maskye min nokqka'yi'ntl qwitz, na'nqe'ye' qu'ne' toj qanmiye' kukxju' ex qajb'ilxi'xtoqe' tu'n qpontle' ka'yilkyeye'. <verse number="18" style="v" />Oxi'toqtzune'; expe' ayine' Pawl, b'a'npunxi'maj intoq chinxe', atzu'n tajaw il nqo tmqo'ne'. <verse number="19" style="v" />Qu'n ¿altzun qi'j tu'n tqe qk'u'je' ex tu'n qtzalaja'ye' twitz Qajaw Jesus ajtul? ¿Ma myatzun kyi'je' qo tzalajela'ye' tu'n qaq'unb'ene' twitz Qajaw? <verse number="20" style="v" />Kyi'je' qo nimanjtzela'ye' ex qo tzalajela'ye'.</para>
  <chapter number="3" style="c" />
  <para style="p">
    <verse number="1" style="v" />Mixtzunti' ik'xtl qu'ne' tu'n tex txqantl tq'ijlalil, kub' qxima'ne' tu'n qkyaje' o'kxtzu' toj Atenas <verse number="2" style="v" />ex tu'n txi' qchq'o'ne' qitz'in Timotey, tmajin Dyos ex onil quk'i'le' tu'n tpakb'et tpakb'al b'a'n tu'n Krist. Xiqchq'o'ne' onilkyeye' ex kuwsal kyeye' toj kyokslab'le', <verse number="3" style="v" />tu'ntzun mix-a'lo' kub' chukji kyu'n yajb'ilkyeye' lu. Kanli kwitze' ilxi'xti'j tu'n kyik'xju' yajb'il lu qu'n. <verse number="4" style="v" />Expe' tej ato'xtoqe' kxole', xiqab'tzi'ne' kyeye' qa atitoq tu'n kyi'kxu' yajb'il lu qu'n; kanli kwitze' ikxtzun ik'a'ju'. <verse number="5" style="v" />Qu'mtzun, ayine', min ik'xtl wu'ne' tu'n tex txqantl tq'ijlalil, xinqani'n tpakb'ale' se'ntoq ta'qeye' toj kyokslab'le', nchin xob'e' qaj nche okku'ye' toj joyb'ilkyi'je' tu'n tajaw il ex jaku' naq kub' naju' qaq'unb'ene'.</para>
  <para style="p">
    <verse number="6" style="v" />Atzu'n ja'lo matxi' tza'ntzti'j Timotey Tesalonik, ex matzul tiq'i'n b'a'n tqanil ti'ju' kyokslab'le' ex kk'u'jlalile'. Matzul tma'n qa nqo tzaj kna'ne' tuk'i'l kk'u'jlalile', ex kyajb'ilxi'xe' tu'n qok kka'yi'ntle' kse'nxqe' qajb'ile' tu'n kyok qka'yi'ntle'. <verse number="7" style="v" />Qu'mtzun e'ntzik ex e'witz'in, toj tkyaqilju' yajb'ilqeye' ex qb'ise', maqe qk'u'je' b'a'nxi'x tej xqb'inteye' ljo'n kyu'ne' wa'lqe'ye' toj kyokslab'le'. <verse number="8" style="v" />Matentl qipumale' tej qb'inteye' wa'lqe'ye' toj kyokslab'le'. <verse number="9" style="v" />¿Se'n tu'me'l jun aq'b'il chjonte tu'n qq'onteye' te Dyos kyi'je' ex tu'nju' ma'xi'x qo tzalaje' twitz Dyos? <verse number="10" style="v" />Nxi' qqani'ne' te Dyos q'ijtl ex qonik'an tu'n tq'onte anb'il qeye' tu'n kyok ku'xi'x qka'yi'ne' ex tu'n qonine' tu'n tqexi'x kk'u'je' toj kyokslab'le'.</para>
  <para style="p">
    <verse number="11" style="v" />Axwit Qman Dyos ex Qajaw Jesus tz'onin qeye' tu'n tb'ant qxi'ye' ka'yilkyeye'. <verse number="12" style="v" />Ex che ch'iyxwite' tu'n Qajaw ex tenxwitl kk'u'jlalile' kxolilexe' ex kyi'j kkyaqil, kse'nqe' nche qk'u'jla'ne'. <verse number="13" style="v" />Awt Qajaw kuwsan kyeye', tenxwit kyanmiye' ẍtilun ex mixti' ktz'ilile' twitz Qman Dyos ajtultl Qajaw Jesus kyuk'i'l kkyaqilju' ttanam xjan. Ikxwitju'.</para>
  <chapter number="4" style="c" />
  <para style="s1">Qo anq'in b'a'n twitz Dyos</para>
  <para style="p">
    <verse number="1" style="v" />Ja'lotzun e'ntzik ex e'witz'in, nxiqkub'sa'ne' ex nxiqma'ne' kyeye' toj tb'i Qajaw Jesus: tu'n kych'iyxi'xtle' atl junjun q'ij toju' che anq'ine' kse'nxju' xnaq'tzb'il xiqq'o'ne' kyeye', tu'n ttzalaj Dyos kyi'je'. <verse number="2" style="v" />Kyojtzqi'ne' xnaq'tzb'il xiqq'o'ne' kyeye' tu'nju' qoklene' tzaj tq'o'n Qajaw Jesukrist. <verse number="3" style="v" />Ate Dyos tajb'il tu'n ktene' b'a'n kychwinqlale', mix-a'lo' jun tu'n tajpajin <verse number="4" style="v" />teyile junjunkye' tu'n tten t-xu'jil ex tu'n tkub' tnima'n, <verse number="5" style="v" />ati tu'n tjk'u'ntetib', tu'n lalun tb'incha tajb'il tchib'jil kse'n nkb'incha'n xjal min kyojtzqi'n Dyos. <verse number="6" style="v" />Lalun kb'inchaye' taq'wix ex mix-a'lo' tu'n tkub' ksb'u'ne', intzaj tq'o'n Qajaw tz'e'ysb'il witzb'aj kuwxi'x tu'n tpaj ja'lu. <verse number="7" style="v" />Min xqo ttxok Dyos tu'n qten toj tz'il, maqo ttxok tu'n qten toj ẍtilun. <verse number="8" style="v" />Qu'mtzun, alkyete matz'el ik'onte xnaq'tzb'il lu, mya xjal neltik'u'n, aku' Dyos saj q'onte Xewb'aj Xjan kyeye' nel tik'u'n.</para>
  <para style="p">
    <verse number="9" style="v" />Atzu'n ti'ju' tk'u'jlalil kxolilexe', min nojqelan tu'n txi' qtz'ib'a'ntle' kyeye', qu'n aku'te Dyos matxi' xnaq'tzan kyeye' tu'n kk'u'jlante kyib'e' jun te juntl. <verse number="10" style="v" />Matxina' kb'inchaye' kyuk'i'lju' okslal najlqe' toj tkyaqil Masedon. Intzun xi'qma'ntle' kyeye' ntzik ex e'witz'in, tu'n ttenxi'xtl kk'u'jlalile'. <verse number="11" style="v" />Kyq'onk tilile' tu'n kyanq'ine' toj nak'b'il, che aq'unanqe'ye' ti'j kyaq'une' ex che aq'unanqe'ye' tu'n kq'ob'e' se'nx oje txiqma'ne' kyeye', <verse number="12" style="v" />tu'ntzun knimanjtze' kyu'n mya okslalqe', ex tu'n tkanun jni' ati tajb'en kyeye'.</para>
  <para style="s1">Se'n tzula'tl Qajaw</para>
  <para style="p">
    <verse number="13" style="v" />E'ntzik ex e'witz'in, min qajb'ile' mixwitti'x b'i'n kyu'ne' ti'nb'ajkyeju' kyimni, tu'n lalun che b'isune' se'nqe' xjal min q'uqli kk'u'j ti'j Dyos. <verse number="14" style="v" />Nqoksla'nqe qa kyim Jesus ex jaw anq'intl, ex inqoksla'n qa che jawil anq'in kyimni okslalqe' te Dyos, junx tuk'i'l Jesus tu'n Dyos.</para>
  <para style="p">
    <verse number="15" style="v" />Qu'mtzun nxiqma'ne' kyeye', se'nxju' xnaq'tzb'il tu'n Qajaw, o'yo' itz'qo'x ajtul jumajtl Qajaw, lay qo'x nej kwitzju' oje che kyim. <verse number="16" style="v" />Qu'n kb'injtzel jun ktzajel yolin tuk'i'l chaq'b'il, jun knejel anjl ktzajel yolin ex ktzajel q'ajti tchun Dyos, ex kb'eletzku' Qajaw toj kya'j. Aye'tzu'n oje che kyim okslalqe' ti'j Krist, nej che jawil anq'in; <verse number="17" style="v" />yajxi'tzuntl qo jawil q'i'n ayo' itz'qo'x, junx kyuk'i'l toj muj, tu'n qk'lunte qib' tuk'i'l Qajaw toj kyq'iq'; qotenb'eltzuntz tuk'i'l Qajaw tejumajx. <verse number="18" style="v" />Kkuwsamtzun kyib'e', junjun te junjuntl kyu'nju' yol lu.</para>
  <chapter number="5" style="c" />
  <para style="p">
    <verse number="1" style="v" />Atzu'n kyi'ju' tajlal xjaw mo ajtponju' tq'ijlalil, min nojqelan tu'n txi ntz'ib'a'ne' kyeye' e'ntzik ex e'witz'in. <verse number="2" style="v" />Kanlixi'xkye' kwitz, mixti'te qnab'en ajtul jumajtl Qajaw, kse'n ajtul jun eleq' qonik'an. <verse number="3" style="v" />Ajkymante xjal: Nak'b'il tkyaqil ex mixti'te nb'aj, chechi, naqtzun mixknab'en ajttzaju' xitb'il kyib'aj, kse'n ajttzaj k'ixk'oj ajtitz'ji tal jun qya; ex lay b'ent ktzaqpaj. <verse number="4" style="v" />Aye'tzunkye' e'ntzik ex e'witz'in, min takliqe'ye' toj qlolj, tu'nwt kjaw sak'puje' ajtul jumajtl Qajaw kse'n ajtul jun eleq'. <verse number="5" style="v" />Kkyaqile' nche anq'ine' toj spik'un ex te q'ijtl. Mya te qonik'anqo' ex mya toj qlolj ta'qo'; <verse number="6" style="v" />qu'mtzun lalun qo wtan kse'nqe' txqantl, qoqe' xq'uqin ex qo anq'in b'a'n. <verse number="7" style="v" />Aye'kye' nche wtan, qonik'an nche wtan, exqe' nche tx'ojt, qonik'an nche tx'ojt; <verse number="8" style="v" />ayo'tzunqe' nqo anq'in te qi'jtl, ati tu'n txi' qka'yi'n qib' toj qchwinqlal. Ati tu'n qktxunte qib', kse'n tok jun qkton k'uxb'il, tu'n qokslab'l ex qk'u'jlalil, ex ku'wtloj tokx k'uxb'il k'o'ẍ toj qwi' te kolb'ilqe te il. <verse number="9" style="v" />Qu'n min o'ttxok Dyos tu'n tkub' ttz'e'ysa'n qwitz, o'ttxok tu'n qklet tu'n Qajaw Jesukrist. <verse number="10" style="v" />Kyim Jesukrist tu'n qpaj, tu'n qanq'in junx tuk'i'l, qa itz'qo'x mujqa kyimniqo'tl ajtul. <verse number="11" style="v" />Qu'mtzun, kkuwsam kyib'e' ex kyonim kyib'e' tu'n kych'iye', kse'nx nkb'incha'ntle'.</para>
  <para style="s1">Ntq'o'n Pawl knab'l okslal</para>
  <para style="p">
    <verse number="12" style="v" />Nqo kub'sane' kyeye' ntzik ex e'witz'in, tu'n kynimane' kyeju' nche aq'unan kyxole', nejenelqe' kyxole' ex nq'onjtz kynab'le' kyu'n. <verse number="13" style="v" />B'a'nku' kyilwi kyu'ne' ex che kk'u'jlame' tu'nju kyaq'un nkb'incha'n. Che anq'inqe'ye' toj nak'b'il kxolilexe'.</para>
  <para style="p">
    <verse number="14" style="v" />Ex nxiqoqxena'ne' kyeye' ntzik ex e'witz'in, tu'n kxi ktzak'u'ne' min nche aq'unan, kyipumalinqe'xe' nche xob', kq'uqb'anxe' kk'u'ju' na'mx tqexi'x kk'u'j ex tenx kpasense' kyi'j kkyaqil.</para>
  <para style="p">
    <verse number="15" style="v" />B'a'nqe'xe', lalun kyaq'e' tu'me'l t-xel taq'wix te juntl qama tb'incha jun taq'wix kyeye'. Kyq'onkpe'kye' tilil tu'n kyb'inchanteye' b'a'n, kyxolilexe' ex kye kykyaqil xjal.</para>
  <para style="p">
    <verse number="16" style="v" />Che tzalajxe' kukxju'. <verse number="17" style="v" />Lalun qen kyna'n Dyose'. <verse number="18" style="v" />Kyq'onx chjonteye' te Dyos toj tkyaqil, qu'n atzun tajb'il Dyosju' kyeye' okslalqe'ye' te Jesukrist.</para>
  <para style="p">
    <verse number="19" style="v" />Lalun kyupiye' Xewb'aj Xjan. <verse number="20" style="v" />Lalun che b'je'l kyik'o'ne' pakb'ab'l. <verse number="21" style="v" />Tzik' kywitze' ti'j tkyaqil ex kytzyume' o'kxju' b'a'n. <verse number="22" style="v" />Kyik'umile' tkyaqil taq'wix.</para>
  <para style="p">
    <verse number="23" style="v" />Axwit Dyos te nak'b'il, xjansankyeye' b'a'nxi'x, awt k'u'nte kyamiye' ex kyxmilale' jumajx, tu'ntzun mixti' jun taq'wix kyi'je' ajtul Qajaw Jesukrist. <verse number="24" style="v" />Axxi'x te Dyos yolin aj txkonkyeye', ex kjapumel tkyaqil ja'lu tu'n.</para>
  <para style="s1">B'ajsb'il yol ex q'olb'eb'l tu'n Pawl</para>
  <para style="p">
    <verse number="25" style="v" />Ex che na'nqe Dyose' qi'je' ntzik ex e'witz'in.</para>
  <para style="p">
    <verse number="26" style="v" />Che kyq'olb'enqe'xe' kykyaqil okslal tuk'i'l jun xjan ma'tz.</para>
  <para style="p">
    <verse number="27" style="v" />Nxi' nkub'sa'ne' kyeye' tu'nju' woklene' tzaj tq'o'n Qajaw, kyẍch'inktze' u'j lu kye kykyaqil okslal.</para>
  <para style="p">
    <verse number="28" style="v" />Awt Qajaw Jesukrist tzaj k'iwlankyeye'.</para>
</usx>