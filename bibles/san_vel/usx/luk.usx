<?xml version="1.0" encoding="UTF-8"?>
<usx version="2.6">
  <book code="LUK" style="id">Sanskrit Bible (NT) in Velthuis Script (satyaveda.h ।)</book>
  <para style="rem">© SanskritBible.in । Licensed under CC BY-SA 4.0</para>
  <para style="h">Luke</para>
  <para style="toc1">luukalikhita.h susa.mvaada.h</para>
  <para style="toc2">luuka.h</para>
  <para style="toc3">luuka.h</para>
  <para style="mt1">luukalikhita.h susa.mvaada.h</para>
  <chapter number="1" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>prathamato ye saak.si.no vaakyapracaarakaa"scaasan te.asmaaka.m madhye yadyat sapramaa.na.m vaakyamarpayanti sma</para>
  <para style="p">
    <verse number="2" style="v"/>tadanusaarato.anyepi bahavastadv.rttaanta.m racayitu.m prav.rttaa.h|</para>
  <para style="p">
    <verse number="3" style="v"/>ataeva he mahaamahimathiyaphil tva.m yaa yaa.h kathaa a"sik.syathaastaasaa.m d.r.dhapramaa.naani yathaa praapno.si</para>
  <para style="p">
    <verse number="4" style="v"/>tadartha.m prathamamaarabhya taani sarvvaa.ni j naatvaahamapi anukramaat sarvvav.rttaantaan tubhya.m lekhitu.m matimakaar.sam|</para>
  <para style="p">
    <verse number="5" style="v"/>yihuudaade"siiyaherodnaamake raajatva.m kurvvati abiiyayaajakasya paryyaayaadhikaarii sikhariyanaamaka eko yaajako haaro.nava.m"sodbhavaa ilii"sevaakhyaa</para>
  <para style="p">
    <verse number="6" style="v"/>tasya jaayaa dvaavimau nirdo.sau prabho.h sarvvaaj naa vyavasthaa"sca sa.mmanya ii"svarad.r.s.tau dhaarmmikaavaastaam|</para>
  <para style="p">
    <verse number="7" style="v"/>tayo.h santaana ekopi naasiit, yata ilii"sevaa bandhyaa tau dvaaveva v.rddhaavabhavataam|</para>
  <para style="p">
    <verse number="8" style="v"/>yadaa svaparyyaanukrame.na sikhariya ii"svaasya samak.sa.m yaajakiiya.m karmma karoti</para>
  <para style="p">
    <verse number="9" style="v"/>tadaa yaj nasya dinaparipaayyaa parame"svarasya mandire prave"sakaale dhuupajvaalana.m karmma tasya kara.niiyamaasiit|</para>
  <para style="p">
    <verse number="10" style="v"/>taddhuupajvaalanakaale lokanivahe praarthanaa.m kartu.m bahisti.s.thati</para>
  <para style="p">
    <verse number="11" style="v"/>sati sikhariyo yasyaa.m vedyaa.m dhuupa.m jvaalayati taddak.si.napaar"sve parame"svarasya duuta eka upasthito dar"sana.m dadau|</para>
  <para style="p">
    <verse number="12" style="v"/>ta.m d.r.s.tvaa sikhariya udvivije "sa"sa"nke ca|</para>
  <para style="p">
    <verse number="13" style="v"/>tadaa sa duutasta.m babhaa.se he sikhariya maa bhaistava praarthanaa graahyaa jaataa tava bhaaryyaa ilii"sevaa putra.m praso.syate tasya naama yoेhan iti kari.syasi|</para>
  <para style="p">
    <verse number="14" style="v"/>ki nca tva.m saananda.h sahar.sa"sca bhavi.syasi tasya janmani bahava aanandi.syanti ca|</para>
  <para style="p">
    <verse number="15" style="v"/>yato heto.h sa parame"svarasya gocare mahaan bhavi.syati tathaa draak.saarasa.m suraa.m vaa kimapi na paasyati, apara.m janmaarabhya pavitre.naatmanaa paripuur.na.h</para>
  <para style="p">
    <verse number="16" style="v"/>san israayelva.m"siiyaan anekaan prabho.h parame"svarasya maargamaane.syati|</para>
  <para style="p">
    <verse number="17" style="v"/>santaanaan prati pit.r.naa.m manaa.msi dharmmaj naana.m pratyanaaj naagraahi.na"sca paraavarttayitu.m, prabho.h parame"svarasya sevaartham ekaa.m sajjitajaati.m vidhaatu nca sa eliyaruupaatma"saktipraaptastasyaagre gami.syati|</para>
  <para style="p">
    <verse number="18" style="v"/>tadaa sikhariyo duutamavaadiit kathametad vetsyaami? yatoha.m v.rddho mama bhaaryyaa ca v.rddhaa|</para>
  <para style="p">
    <verse number="19" style="v"/>tato duuta.h pratyuvaaca pa"sye"svarasya saak.saadvarttii jibraayelnaamaa duutoha.m tvayaa saha kathaa.m gaditu.m tubhyamimaa.m "subhavaarttaa.m daatu nca pre.sita.h|</para>
  <para style="p">
    <verse number="20" style="v"/>kintu madiiya.m vaakya.m kaale phali.syati tat tvayaa na pratiitam ata.h kaara.naad yaavadeva taani na setsyanti taavat tva.m vaktu.mma"sakto muuko bhava|</para>
  <para style="p">
    <verse number="21" style="v"/>tadaanii.m ye ye lokaa.h sikhariyamapaik.santa te madhyemandira.m tasya bahuvilambaad aa"scaryya.m menire|</para>
  <para style="p">
    <verse number="22" style="v"/>sa bahiraagato yadaa kimapi vaakya.m vaktuma"sakta.h sa"nketa.m k.rtvaa ni.h"sabdastasyau tadaa madhyemandira.m kasyacid dar"sana.m tena praaptam iti sarvve bubudhire|</para>
  <para style="p">
    <verse number="23" style="v"/>anantara.m tasya sevanaparyyaaye sampuur.ne sati sa nijageha.m jagaama|</para>
  <para style="p">
    <verse number="24" style="v"/>katipayadine.su gate.su tasya bhaaryyaa ilii"sevaa garbbhavatii babhuuva</para>
  <para style="p">
    <verse number="25" style="v"/>pa"scaat saa pa ncamaasaan sa.mgopyaakathayat lokaanaa.m samak.sa.m mamaapamaana.m kha.n.dayitu.m parame"svaro mayi d.r.s.ti.m paatayitvaa karmmed.r"sa.m k.rtavaan|</para>
  <para style="p">
    <verse number="26" style="v"/>apara nca tasyaa garbbhasya .sa.s.the maase jaate gaaliilprade"siiyanaasaratpure</para>
  <para style="p">
    <verse number="27" style="v"/>daayuudo va.m"siiyaaya yuu.saphnaamne puru.saaya yaa mariyamnaamakumaarii vaagdattaasiit tasyaa.h samiipa.m jibraayel duuta ii"svare.na prahita.h|</para>
  <para style="p">
    <verse number="28" style="v"/>sa gatvaa jagaada he ii"svaraanug.rhiitakanye tava "subha.m bhuuyaat prabhu.h parame"svarastava sahaayosti naarii.naa.m madhye tvameva dhanyaa|</para>
  <para style="p">
    <verse number="29" style="v"/>tadaanii.m saa ta.m d.r.s.tvaa tasya vaakyata udvijya kiid.r"sa.m bhaa.sa.namidam iti manasaa cintayaamaasa|</para>
  <para style="p">
    <verse number="30" style="v"/>tato duuto.avadat he mariyam bhaya.m maakaar.sii.h, tvayi parame"svarasyaanugrahosti|</para>
  <para style="p">
    <verse number="31" style="v"/>pa"sya tva.m garbbha.m dh.rtvaa putra.m praso.syase tasya naama yii"suriti kari.syasi|</para>
  <para style="p">
    <verse number="32" style="v"/>sa mahaan bhavi.syati tathaa sarvvebhya.h "sre.s.thasya putra iti khyaasyati; apara.m prabhu.h parame"svarastasya piturdaayuuda.h si.mhaasana.m tasmai daasyati;</para>
  <para style="p">
    <verse number="33" style="v"/>tathaa sa yaakuubo va.m"sopari sarvvadaa raajatva.m kari.syati, tasya raajatvasyaanto na bhavi.syati|</para>
  <para style="p">
    <verse number="34" style="v"/>tadaa mariyam ta.m duuta.m babhaa.se naaha.m puru.sasa"nga.m karomi tarhi kathametat sambhavi.syati?</para>
  <para style="p">
    <verse number="35" style="v"/>tato duuto.akathayat pavitra aatmaa tvaamaa"sraayi.syati tathaa sarvva"sre.s.thasya "saktistavopari chaayaa.m kari.syati tato hetostava garbbhaad ya.h pavitrabaalako jani.syate sa ii"svaraputra iti khyaati.m praapsyati|</para>
  <para style="p">
    <verse number="36" style="v"/>apara nca pa"sya tava j naatirilii"sevaa yaa.m sarvve bandhyaamavadan idaanii.m saa vaarddhakye santaanameka.m garbbhe.adhaarayat tasya .sa.s.thamaasobhuut|</para>
  <para style="p">
    <verse number="37" style="v"/>kimapi karmma naasaadhyam ii"svarasya|</para>
  <para style="p">
    <verse number="38" style="v"/>tadaa mariyam jagaada, pa"sya prabheraha.m daasii mahya.m tava vaakyaanusaare.na sarvvametad gha.tataam; ananatara.m duutastasyaa.h samiipaat pratasthe|</para>
  <para style="p">
    <verse number="39" style="v"/>atha katipayadinaat para.m mariyam tasmaat parvvatamayaprade"siiyayihuudaayaa nagarameka.m "siighra.m gatvaa</para>
  <para style="p">
    <verse number="40" style="v"/>sikhariyayaajakasya g.rha.m pravi"sya tasya jaayaam ilii"sevaa.m sambodhyaavadat|</para>
  <para style="p">
    <verse number="41" style="v"/>tato mariyama.h sambodhanavaakye ilii"sevaayaa.h kar.nayo.h pravi.s.tamaatre sati tasyaa garbbhasthabaalako nanartta| tata ilii"sevaa pavitre.naatmanaa paripuur.naa satii</para>
  <para style="p">
    <verse number="42" style="v"/>proccairgaditumaarebhe, yo.sitaa.m madhye tvameva dhanyaa, tava garbbhastha.h "si"su"sca dhanya.h|</para>
  <para style="p">
    <verse number="43" style="v"/>tva.m prabhormaataa, mama nive"sane tvayaa cara.naavarpitau, mamaadya saubhaagyametat|</para>
  <para style="p">
    <verse number="44" style="v"/>pa"sya tava vaakye mama kar.nayo.h pravi.s.tamaatre sati mamodarastha.h "si"suraanandaan nanartta|</para>
  <para style="p">
    <verse number="45" style="v"/>yaa strii vya"svasiit saa dhanyaa, yato hetostaa.m prati parame"svarokta.m vaakya.m sarvva.m siddha.m bhavi.syati|</para>
  <para style="p">
    <verse number="46" style="v"/>tadaanii.m mariyam jagaada| dhanyavaada.m pare"sasya karoti maamaka.m mana.h|</para>
  <para style="p">
    <verse number="47" style="v"/>mamaatmaa taarake"se ca samullaasa.m pragacchati|</para>
  <para style="p">
    <verse number="48" style="v"/>akarot sa prabhu rdu.s.ti.m svadaasyaa durgati.m prati| pa"syaadyaarabhya maa.m dhanyaa.m vak.syanti puru.saa.h sadaa|</para>
  <para style="p">
    <verse number="49" style="v"/>ya.h sarvva"saktimaan yasya naamaapi ca pavitraka.m| sa eva sumahatkarmma k.rtavaan mannimittaka.m|</para>
  <para style="p">
    <verse number="50" style="v"/>ye bibhyati janaastasmaat te.saa.m santaanapa.mkti.su| anukampaa tadiiyaa ca sarvvadaiva suti.s.thati|</para>
  <para style="p">
    <verse number="51" style="v"/>svabaahubalatastena praakaa"syata paraakrama.h| mana.hkumantra.naasaarddha.m vikiiryyante.abhimaanina.h|</para>
  <para style="p">
    <verse number="52" style="v"/>si.mhaasanagataallokaan balina"scaavarohya sa.h| pade.suucce.su lokaa.mstu k.sudraan sa.msthaapayatyapi|</para>
  <para style="p">
    <verse number="53" style="v"/>k.sudhitaan maanavaan dravyairuttamai.h paritarpya sa.h| sakalaan dhanino lokaan vis.rjed riktahastakaan|</para>
  <para style="p">
    <verse number="54" style="v"/>ibraahiimi ca tadva.m"se yaa dayaasti sadaiva taa.m| sm.rtvaa puraa pit.r.naa.m no yathaa saak.saat prati"sruta.m|</para>
  <para style="p">
    <verse number="55" style="v"/>israayelsevakastena tathopakriyate svaya.m||</para>
  <para style="p">
    <verse number="56" style="v"/>anantara.m mariyam praaye.na maasatrayam ilii"sevayaa saho.sitvaa vyaaghuyya nijanive"sana.m yayau|</para>
  <para style="p">
    <verse number="57" style="v"/>tadanantaram ilii"sevaayaa.h prasavakaala upasthite sati saa putra.m praaso.s.ta|</para>
  <para style="p">
    <verse number="58" style="v"/>tata.h parame"svarastasyaa.m mahaanugraha.m k.rtavaan etat "srutvaa samiipavaasina.h ku.tumbaa"scaagatya tayaa saha mumudire|</para>
  <para style="p">
    <verse number="59" style="v"/>tathaa.s.tame dine te baalakasya tvaca.m chettum etya tasya pit.rnaamaanuruupa.m tannaama sikhariya iti karttumii.su.h|</para>
  <para style="p">
    <verse number="60" style="v"/>kintu tasya maataakathayat tanna, naamaasya yohan iti karttavyam|</para>
  <para style="p">
    <verse number="61" style="v"/>tadaa te vyaaharan tava va.m"samadhye naamed.r"sa.m kasyaapi naasti|</para>
  <para style="p">
    <verse number="62" style="v"/>tata.h para.m tasya pitara.m sikhariya.m prati sa"nketya papracchu.h "si"so.h ki.m naama kaari.syate?</para>
  <para style="p">
    <verse number="63" style="v"/>tata.h sa phalakameka.m yaacitvaa lilekha tasya naama yohan bhavi.syati| tasmaat sarvve aa"scaryya.m menire|</para>
  <para style="p">
    <verse number="64" style="v"/>tatk.sa.na.m sikhariyasya jihvaajaa.dye.apagate sa mukha.m vyaadaaya spa.s.tavar.namuccaaryya ii"svarasya gu.naanuvaada.m cakaara|</para>
  <para style="p">
    <verse number="65" style="v"/>tasmaaccaturdiksthaa.h samiipavaasilokaa bhiitaa evametaa.h sarvvaa.h kathaa yihuudaayaa.h parvvatamayaprade"sasya sarvvatra pracaaritaa.h|</para>
  <para style="p">
    <verse number="66" style="v"/>tasmaat "srotaaro mana.hsu sthaapayitvaa kathayaambabhuuvu.h kiid.r"soya.m baalo bhavi.syati? atha parame"svarastasya sahaayobhuut|</para>
  <para style="p">
    <verse number="67" style="v"/>tadaa yohana.h pitaa sikhariya.h pavitre.naatmanaa paripuur.na.h san etaad.r"sa.m bhavi.syadvaakya.m kathayaamaasa|</para>
  <para style="p">
    <verse number="68" style="v"/>israayela.h prabhu ryastu sa dhanya.h parame"svara.h| anug.rhya nijaallokaan sa eva parimocayet|</para>
  <para style="p">
    <verse number="69" style="v"/>vipak.sajanahastebhyo yathaa mocyaamahe vaya.m| yaavajjiiva nca dharmme.na saaralyena ca nirbhayaa.h|</para>
  <para style="p">
    <verse number="70" style="v"/>sevaamahai tamevaikam etatkaara.nameva ca| svakiiya.m supavitra nca sa.msm.rtya niyama.m sadaa|</para>
  <para style="p">
    <verse number="71" style="v"/>k.rpayaa puru.saan puurvvaan nika.saarthaattu na.h pitu.h| ibraahiima.h samiipe ya.m "sapatha.m k.rtavaan puraa|</para>
  <para style="p">
    <verse number="72" style="v"/>tameva saphala.m kartta.m tathaa "satruga.nasya ca| .rृtiiyaakaari.na"scaiva karebhyo rak.sa.naaya na.h|</para>
  <para style="p">
    <verse number="73" style="v"/>s.r.s.te.h prathamata.h sviiyai.h pavitrai rbhaavivaadibhi.h|</para>
  <para style="p">
    <verse number="74" style="v"/>yathoktavaan tathaa svasya daayuuda.h sevakasya tu|</para>
  <para style="p">
    <verse number="75" style="v"/>va.m"se traataarameka.m sa samutpaaditavaan svayam|</para>
  <para style="p">
    <verse number="76" style="v"/>ato he baalaka tvantu sarvvebhya.h "sre.s.tha eva ya.h| tasyaiva bhaavivaadiiti pravikhyaato bhavi.syasi| asmaaka.m cara.naan k.seme maarge caalayitu.m sadaa| eva.m dhvaante.arthato m.rtyo"schaayaayaa.m ye tu maanavaa.h|</para>
  <para style="p">
    <verse number="77" style="v"/>upavi.s.taastu taaneva prakaa"sayitumeva hi| k.rtvaa mahaanukampaa.m hi yaameva parame"svara.h|</para>
  <para style="p">
    <verse number="78" style="v"/>uurdvvaat suuryyamudaayyaivaasmabhya.m praadaattu dar"sana.m| tayaanukampayaa svasya lokaanaa.m paapamocane|</para>
  <para style="p">
    <verse number="79" style="v"/>paritraa.nasya tebhyo hi j naanavi"sraa.nanaaya ca| prabho rmaarga.m pari.skarttu.m tasyaagraayii bhavi.syasi||</para>
  <para style="p">
    <verse number="80" style="v"/>atha baalaka.h "sariire.na buddhyaa ca varddhitumaarebhe; apara nca sa israayelo va.m"siiyalokaanaa.m samiipe yaavanna praka.tiibhuutastaastaavat praantare nyavasat|</para>
  <chapter number="2" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>apara nca tasmin kaale raajyasya sarvve.saa.m lokaanaa.m naamaani lekhayitum agastakaisara aaj naapayaamaasa|</para>
  <para style="p">
    <verse number="2" style="v"/>tadanusaare.na kurii.niyanaamani suriyaade"sasya "saasake sati naamalekhana.m praarebhe|</para>
  <para style="p">
    <verse number="3" style="v"/>ato heto rnaama lekhitu.m sarvve janaa.h sviiya.m sviiya.m nagara.m jagmu.h|</para>
  <para style="p">
    <verse number="4" style="v"/>tadaanii.m yuu.saph naama lekhitu.m vaagdattayaa svabhaaryyayaa garbbhavatyaa mariyamaa saha svaya.m daayuuda.h sajaativa.m"sa iti kaara.naad gaaliilprade"sasya naasaratnagaraad</para>
  <para style="p">
    <verse number="5" style="v"/>yihuudaaprade"sasya baitlehamaakhya.m daayuudnagara.m jagaama|</para>
  <para style="p">
    <verse number="6" style="v"/>anyacca tatra sthaane tayosti.s.thato.h sato rmariyama.h prasuutikaala upasthite</para>
  <para style="p">
    <verse number="7" style="v"/>saa ta.m prathamasuta.m praaso.s.ta kintu tasmin vaasag.rhe sthaanaabhaavaad baalaka.m vastre.na ve.s.tayitvaa go"saalaayaa.m sthaapayaamaasa|</para>
  <para style="p">
    <verse number="8" style="v"/>anantara.m ye kiyanto me.sapaalakaa.h svame.savrajarak.saayai tatprade"se sthitvaa rajanyaa.m praantare prahari.na.h karmma kurvvanti,</para>
  <para style="p">
    <verse number="9" style="v"/>te.saa.m samiipa.m parame"svarasya duuta aagatyopatasthau; tadaa catu.spaar"sve parame"svarasya tejasa.h prakaa"sitatvaat te.ati"sa"sa"nkire|</para>
  <para style="p">
    <verse number="10" style="v"/>tadaa sa duuta uvaaca maa bhai.s.ta pa"syataadya daayuuda.h pure yu.smannimitta.m traataa prabhu.h khrii.s.to.ajani.s.ta,</para>
  <para style="p">
    <verse number="11" style="v"/>sarvve.saa.m lokaanaa.m mahaanandajanakam ima.m ma"ngalav.rttaanta.m yu.smaan j naapayaami|</para>
  <para style="p">
    <verse number="12" style="v"/>yuuya.m (tatsthaana.m gatvaa) vastrave.s.tita.m ta.m baalaka.m go"saalaayaa.m "sayana.m drak.syatha yu.smaan pratiida.m cihna.m bhavi.syati|</para>
  <para style="p">
    <verse number="13" style="v"/>duuta imaa.m kathaa.m kathitavati tatraakasmaat svargiiyaa.h p.rtanaa aagatya kathaam imaa.m kathayitve"svarasya gu.naananvavaadi.su.h, yathaa,</para>
  <para style="p">
    <verse number="14" style="v"/>sarvvordvvasthairii"svarasya mahimaa samprakaa"syataa.m| "saantirbhuuyaat p.rthivyaastu santo.sa"sca naraan prati||</para>
  <para style="p">
    <verse number="15" style="v"/>tata.h para.m te.saa.m sannidhe rduutaga.ne svarga.m gate me.sapaalakaa.h parasparam avecan aagacchata prabhu.h parame"svaro yaa.m gha.tanaa.m j naapitavaan tasyaa yaatharya.m j naatu.m vayamadhunaa baitlehampura.m yaama.h|</para>
  <para style="p">
    <verse number="16" style="v"/>pa"scaat te tuur.na.m vrajitvaa mariyama.m yuu.sapha.m go"saalaayaa.m "sayana.m baalaka nca dad.r"su.h|</para>
  <para style="p">
    <verse number="17" style="v"/>ittha.m d.r.s.tvaa baalakasyaarthe proktaa.m sarvvakathaa.m te praacaarayaa ncakru.h|</para>
  <para style="p">
    <verse number="18" style="v"/>tato ye lokaa me.sarak.sakaa.naa.m vadanebhyastaa.m vaarttaa.m "su"sruvuste mahaa"scaryya.m menire|</para>
  <para style="p">
    <verse number="19" style="v"/>kintu mariyam etatsarvvagha.tanaanaa.m taatparyya.m vivicya manasi sthaapayaamaasa|</para>
  <para style="p">
    <verse number="20" style="v"/>tatpa"scaad duutavij naptaanuruupa.m "srutvaa d.r.s.tvaa ca me.sapaalakaa ii"svarasya gu.naanuvaada.m dhanyavaada nca kurvvaa.naa.h paraav.rtya yayu.h|</para>
  <para style="p">
    <verse number="21" style="v"/>atha baalakasya tvakchedanakaale.a.s.tamadivase samupasthite tasya garbbhasthite.h purvva.m svargiiyaduuto yathaaj naapayat tadanuruupa.m te tannaamadheya.m yii"suriti cakrire|</para>
  <para style="p">
    <verse number="22" style="v"/>tata.h para.m muusaalikhitavyavasthaayaa anusaare.na mariyama.h "sucitvakaala upasthite,</para>
  <para style="p">
    <verse number="23" style="v"/>"prathamaja.h sarvva.h puru.sasantaana.h parame"svare samarpyataa.m," iti parame"svarasya vyavasthayaa</para>
  <para style="p">
    <verse number="24" style="v"/>yii"su.m parame"svare samarpayitum "saastriiyavidhyukta.m kapotadvaya.m paaraavata"saavakadvaya.m vaa bali.m daatu.m te ta.m g.rhiitvaa yiruu"saalamam aayayu.h|</para>
  <para style="p">
    <verse number="25" style="v"/>yiruu"saalampuranivaasii "simiyonnaamaa dhaarmmika eka aasiit sa israayela.h saantvanaamapek.sya tasthau ki nca pavitra aatmaa tasminnaavirbhuuta.h|</para>
  <para style="p">
    <verse number="26" style="v"/>apara.m prabhu.naa parame"svare.naabhi.sikte traatari tvayaa na d.r.s.te tva.m na mari.syasiiti vaakya.m pavitre.na aatmanaa tasma praakathyata|</para>
  <para style="p">
    <verse number="27" style="v"/>apara nca yadaa yii"so.h pitaa maataa ca tadartha.m vyavasthaanuruupa.m karmma karttu.m ta.m mandiram aaninyatustadaa</para>
  <para style="p">
    <verse number="28" style="v"/>"simiyon aatmana aakar.sa.nena mandiramaagatya ta.m kro.de nidhaaya ii"svarasya dhanyavaada.m k.rtvaa kathayaamaasa, yathaa,</para>
  <para style="p">
    <verse number="29" style="v"/>he prabho tava daasoya.m nijavaakyaanusaarata.h| idaaniintu sakalyaa.no bhavataa sa.mvis.rjyataam|</para>
  <para style="p">
    <verse number="30" style="v"/>yata.h sakalade"sasya diiptaye diiptiruupaka.m|</para>
  <para style="p">
    <verse number="31" style="v"/>israayeliiyalokasya mahaagauravaruupaka.m|</para>
  <para style="p">
    <verse number="32" style="v"/>ya.m traayaka.m janaanaantu sammukhe tvamajiijana.h| saeva vidyate.asmaaka.m dhrava.m nayananagocare||</para>
  <para style="p">
    <verse number="33" style="v"/>tadaanii.m tenoktaa etaa.h sakalaa.h kathaa.h "srutvaa tasya maataa yuu.saph ca vismaya.m menaate|</para>
  <para style="p">
    <verse number="34" style="v"/>tata.h para.m "simiyon tebhya aa"si.sa.m dattvaa tanmaatara.m mariyamam uvaaca, pa"sya israayelo va.m"samadhye bahuunaa.m paatanaayotthaapanaaya ca tathaa virodhapaatra.m bhavitu.m, bahuunaa.m guptamanogataanaa.m praka.tiikara.naaya baalakoya.m niyuktosti|</para>
  <para style="p">
    <verse number="35" style="v"/>tasmaat tavaapi praa.naa.h "suulena vyatsyante|</para>
  <para style="p">
    <verse number="36" style="v"/>apara nca aa"serasya va.m"siiyaphinuuyelo duhitaa hannaakhyaa atijaratii bhavi.syadvaadinyekaa yaa vivaahaat para.m sapta vatsaraan patyaa saha nyavasat tato vidhavaa bhuutvaa catura"siitivar.savaya.hparyyanata.m</para>
  <para style="p">
    <verse number="37" style="v"/>mandire sthitvaa praarthanopavaasairdivaani"sam ii"svaram asevata saapi strii tasmin samaye mandiramaagatya</para>
  <para style="p">
    <verse number="38" style="v"/>parame"svarasya dhanyavaada.m cakaara, yiruu"saalampuravaasino yaavanto lokaa muktimapek.sya sthitaastaan yii"sorv.rttaanta.m j naapayaamaasa|</para>
  <para style="p">
    <verse number="39" style="v"/>ittha.m parame"svarasya vyavasthaanusaare.na sarvve.su karmmasu k.rte.su tau puna"sca gaaliilo naasaratnaamaka.m nijanagara.m pratasthaate|</para>
  <para style="p">
    <verse number="40" style="v"/>tatpa"scaad baalaka.h "sariire.na v.rddhimetya j naanena paripuur.na aatmanaa "saktimaa.m"sca bhavitumaarebhe tathaa tasmin ii"svaraanugraho babhuuva|</para>
  <para style="p">
    <verse number="41" style="v"/>tasya pitaa maataa ca prativar.sa.m nistaarotsavasamaye yiruu"saalamam agacchataam|</para>
  <para style="p">
    <verse number="42" style="v"/>apara nca yii"sau dvaada"savar.savayaske sati tau parvvasamayasya riityanusaare.na yiruu"saalama.m gatvaa</para>
  <para style="p">
    <verse number="43" style="v"/>paarvva.na.m sampaadya punarapi vyaaghuyya yaata.h kintu yii"surbaalako yiruu"saalami ti.s.thati| yuu.saph tanmaataa ca tad aviditvaa</para>
  <para style="p">
    <verse number="44" style="v"/>sa sa"ngibhi.h saha vidyata etacca budvvaa dinaikagamyamaarga.m jagmatu.h| kintu "se.se j naatibandhuunaa.m samiipe m.rgayitvaa taduddeे"samapraapya</para>
  <para style="p">
    <verse number="45" style="v"/>tau punarapi yiruu"saalamam paraav.rtyaagatya ta.m m.rgayaa ncakratu.h|</para>
  <para style="p">
    <verse number="46" style="v"/>atha dinatrayaat para.m pa.n.ditaanaa.m madhye te.saa.m kathaa.h "s.r.nvan tattva.m p.rccha.m"sca mandire samupavi.s.ta.h sa taabhyaa.m d.r.s.ta.h|</para>
  <para style="p">
    <verse number="47" style="v"/>tadaa tasya buddhyaa pratyuttarai"sca sarvve "srotaaro vismayamaapadyante|</para>
  <para style="p">
    <verse number="48" style="v"/>taad.r"sa.m d.r.s.tvaa tasya janako jananii ca camaccakratu.h ki nca tasya maataa tamavadat, he putra, kathamaavaa.m pratiittha.m samaacarastvam? pa"sya tava pitaaha nca "sokaakulau santau tvaamanvicchaava.h sma|</para>
  <para style="p">
    <verse number="49" style="v"/>tata.h sovadat kuto maam anvaicchata.m? piturg.rhe mayaa sthaatavyam etat ki.m yuvaabhyaa.m na j naayate?</para>
  <para style="p">
    <verse number="50" style="v"/>kintu tau tasyaitadvaakyasya taatparyya.m boddhu.m naa"saknutaa.m|</para>
  <para style="p">
    <verse number="51" style="v"/>tata.h para.m sa taabhyaa.m saha naasarata.m gatvaa tayorva"siibhuutastasthau kintu sarvvaa etaa.h kathaastasya maataa manasi sthaapayaamaasa|</para>
  <para style="p">
    <verse number="52" style="v"/>atha yii"so rbuddhi.h "sariira nca tathaa tasmin ii"svarasya maanavaanaa ncaanugraho varddhitum aarebhe|</para>
  <chapter number="3" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>anantara.m tibiriyakaisarasya raajatvasya pa ncada"se vatsare sati yadaa pantiiyapiilaato yihuudaade"saadhipati rherod tu gaaliilprade"sasya raajaa philipanaamaa tasya bhraataa tu yituuriyaayaastraakhoniitiyaaprade"sasya ca raajaasiit lu.saaniiyanaamaa aviliiniide"sasya raajaasiit</para>
  <para style="p">
    <verse number="2" style="v"/>haanan kiyaphaa"scemau pradhaanayaajaakaavaastaa.m tadaanii.m sikhariyasya putraaya yohane madhyepraantaram ii"svarasya vaakye prakaa"site sati</para>
  <para style="p">
    <verse number="3" style="v"/>sa yarddana ubhayata.taprade"saan sametya paapamocanaartha.m mana.hparaavarttanasya cihnaruupa.m yanmajjana.m tadiiyaa.h kathaa.h sarvvatra pracaarayitumaarebhe|</para>
  <para style="p">
    <verse number="4" style="v"/>yi"sayiyabhavi.syadvakt.rgranthe yaad.r"sii lipiraaste yathaa, parame"sasya panthaana.m pari.skuruta sarvvata.h| tasya raajapatha ncaiva samaana.m kurutaadhunaa|</para>
  <para style="p">
    <verse number="5" style="v"/>kaari.syante samucchraayaa.h sakalaa nimnabhuumaya.h| kaari.syante nataa.h sarvve parvvataa"scopaparvvataa.h| kaari.syante ca yaa vakraastaa.h sarvvaa.h saralaa bhuva.h| kaari.syante samaanaastaa yaa uccaniicabhuumaya.h|</para>
  <para style="p">
    <verse number="6" style="v"/>ii"svare.na k.rta.m traa.na.m drak.syanti sarvvamaanavaa.h| ityetat praantare vaakya.m vadata.h kasyacid rava.h||</para>
  <para style="p">
    <verse number="7" style="v"/>ye ye lokaa majjanaartha.m bahiraayayustaan sovadat re re sarpava.m"saa aagaamina.h kopaat palaayitu.m yu.smaan ka"scetayaamaasa?</para>
  <para style="p">
    <verse number="8" style="v"/>tasmaad ibraahiim asmaaka.m pitaa kathaamiid.r"sii.m manobhi rna kathayitvaa yuuya.m mana.hparivarttanayogya.m phala.m phalata; yu.smaanaha.m yathaartha.m vadaami paa.saa.nebhya etebhya ii"svara ibraahiima.h santaanotpaadane samartha.h|</para>
  <para style="p">
    <verse number="9" style="v"/>apara nca tarumuule.adhunaapi para"su.h sa.mlagnosti yastaruruttama.m phala.m na phalati sa chidyate.agnau nik.sipyate ca|</para>
  <para style="p">
    <verse number="10" style="v"/>tadaanii.m lokaasta.m papracchustarhi ki.m karttavyamasmaabhi.h?</para>
  <para style="p">
    <verse number="11" style="v"/>tata.h sovaadiit yasya dve vasane vidyete sa vastrahiinaayaika.m vitaratu ki.m nca yasya khaadyadravya.m vidyate sopi tathaiva karotu|</para>
  <para style="p">
    <verse number="12" style="v"/>tata.h para.m karasa ncaayino majjanaartham aagatya papracchu.h he guro ki.m karttavyamasmaabhi.h?</para>
  <para style="p">
    <verse number="13" style="v"/>tata.h sokathayat niruupitaadadhika.m na g.rhlita|</para>
  <para style="p">
    <verse number="14" style="v"/>anantara.m senaaga.na etya papraccha kimasmaabhi rvaa karttavyam? tata.h sobhidadhe kasya kaamapi haani.m maa kaar.s.ta tathaa m.r.saapavaada.m maa kuruta nijavetanena ca santu.sya ti.s.thata|</para>
  <para style="p">
    <verse number="15" style="v"/>apara nca lokaa apek.sayaa sthitvaa sarvvepiiti manobhi rvitarkayaa ncakru.h, yohanayam abhi.siktastraataa na veti?</para>
  <para style="p">
    <verse number="16" style="v"/>tadaa yohan sarvvaan vyaajahaara, jale.aha.m yu.smaan majjayaami satya.m kintu yasya paadukaabandhana.m mocayitumapi na yogyosmi taad.r"sa eko matto gurutara.h pumaan eti, sa yu.smaan vahniruupe pavitra aatmani majjayi.syati|</para>
  <para style="p">
    <verse number="17" style="v"/>apara nca tasya haste "suurpa aaste sa sva"sasyaani "suddharuupa.m praspho.tya godhuumaan sarvvaan bhaa.n.daagaare sa.mgrahii.syati kintu buu.saa.ni sarvvaa.nyanirvvaa.navahninaa daahayi.syati|</para>
  <para style="p">
    <verse number="18" style="v"/>yohan upade"senettha.m naanaakathaa lokaanaa.m samak.sa.m pracaarayaamaasa|</para>
  <para style="p">
    <verse number="19" style="v"/>apara nca herod raajaa philipnaamna.h sahodarasya bhaaryyaa.m herodiyaamadhi tathaanyaani yaani yaani kukarmmaa.ni k.rtavaan tadadhi ca</para>
  <para style="p">
    <verse number="20" style="v"/>yohanaa tirask.rto bhuutvaa kaaraagaare tasya bandhanaad aparamapi kukarmma cakaara|</para>
  <para style="p">
    <verse number="21" style="v"/>ita.h puurvva.m yasmin samaye sarvve yohanaa majjitaastadaanii.m yii"surapyaagatya majjita.h|</para>
  <para style="p">
    <verse number="22" style="v"/>tadanantara.m tena praarthite meghadvaara.m mukta.m tasmaacca pavitra aatmaa muurttimaan bhuutvaa kapotavat taduparyyavaruroha; tadaa tva.m mama priya.h putrastvayi mama parama.h santo.sa ityaakaa"savaa.nii babhuuva|</para>
  <para style="p">
    <verse number="23" style="v"/>tadaanii.m yii"su.h praaye.na tri.m"sadvar.savayaska aasiit| laukikaj naane tu sa yuu.sapha.h putra.h,</para>
  <para style="p">
    <verse number="24" style="v"/>yuu.saph ele.h putra.h, elirmattata.h putra.h, mattat leve.h putra.h, levi rmalke.h putra.h, malkiryaannasya putra.h; yaanno yuu.sapha.h putra.h|</para>
  <para style="p">
    <verse number="25" style="v"/>yuu.saph mattathiyasya putra.h, mattathiya aamosa.h putra.h, aamos nahuuma.h putra.h, nahuum i.sle.h putra.h i.slirnage.h putra.h|</para>
  <para style="p">
    <verse number="26" style="v"/>nagirmaa.ta.h putra.h, maa.t mattathiyasya putra.h, mattathiya.h "simiye.h putra.h, "simiyiryuu.sapha.h putra.h, yuu.saph yihuudaa.h putra.h|</para>
  <para style="p">
    <verse number="27" style="v"/>yihuudaa yohaanaa.h putra.h, yohaanaa rii.saa.h putra.h, rii.saa.h sirubbaabila.h putra.h, sirubbaabil "saltiiyela.h putra.h, "saltiiyel nere.h putra.h|</para>
  <para style="p">
    <verse number="28" style="v"/>nerirmalke.h putra.h, malki.h adya.h putra.h, addii ko.sama.h putra.h, ko.sam ilmodada.h putra.h, ilmodad era.h putra.h|</para>
  <para style="p">
    <verse number="29" style="v"/>er yo"se.h putra.h, yo"si.h iliiye.sara.h putra.h, iliiye.sar yoriima.h putra.h, yoriim mattata.h putra.h, mattata leve.h putra.h|</para>
  <para style="p">
    <verse number="30" style="v"/>levi.h "simiyona.h putra.h, "simiyon yihuudaa.h putra.h, yihuudaa yuu.supha.h putra.h, yuu.suph yonana.h putra.h, yaanan iliiyaakiima.h putra.h|</para>
  <para style="p">
    <verse number="31" style="v"/>iliyaakiim.h mileyaa.h putra.h, mileyaa mainana.h putra.h, mainan mattattasya putra.h, mattatto naathana.h putra.h, naathan daayuuda.h putra.h|</para>
  <para style="p">
    <verse number="32" style="v"/>daayuud yi"saya.h putra.h, yi"saya obeda.h putra, obed boyasa.h putra.h, boyas salmona.h putra.h, salmon naha"sona.h putra.h|</para>
  <para style="p">
    <verse number="33" style="v"/>naha"son ammiinaadaba.h putra.h, ammiinaadab araama.h putra.h, araam hi.sro.na.h putra.h, hi.sro.n perasa.h putra.h, peras yihuudaa.h putra.h|</para>
  <para style="p">
    <verse number="34" style="v"/>yihuudaa yaakuuba.h putra.h, yaakuub ishaaka.h putra.h, ishaak ibraahiima.h putra.h, ibraahiim teraha.h putra.h, terah naahora.h putra.h|</para>
  <para style="p">
    <verse number="35" style="v"/>naahor siruga.h putra.h, sirug riyva.h putra.h, riyuu.h pelaga.h putra.h, pelag evara.h putra.h, evar "selaha.h putra.h|</para>
  <para style="p">
    <verse number="36" style="v"/>"selah kainana.h putra.h, kainan arphak.sada.h putra.h, arphak.sad "saama.h putra.h, "saam noha.h putra.h, noho lemaka.h putra.h|</para>
  <para style="p">
    <verse number="37" style="v"/>lemak mithuu"selaha.h putra.h, mithuu"selah hanoka.h putra.h, hanok yerada.h putra.h, yerad mahalalela.h putra.h, mahalalel kainana.h putra.h|</para>
  <para style="p">
    <verse number="38" style="v"/>kainan ino"sa.h putra.h, ino"s "seta.h putra.h, "set aadama.h putra, aadam ii"svarasya putra.h|</para>
  <chapter number="4" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>tata.h para.m yii"su.h pavitre.naatmanaa puur.na.h san yarddananadyaa.h paraav.rtyaatmanaa praantara.m niita.h san catvaari.m"saddinaani yaavat "saitaanaa pariik.sito.abhuut,</para>
  <para style="p">
    <verse number="2" style="v"/>ki nca taani sarvvadinaani bhojana.m vinaa sthitatvaat kaale puur.ne sa k.sudhitavaan|</para>
  <para style="p">
    <verse number="3" style="v"/>tata.h "saitaanaagatya tamavadat tva.m cedii"svarasya putrastarhi prastaraanetaan aaj nayaa puupaan kuru|</para>
  <para style="p">
    <verse number="4" style="v"/>tadaa yii"suruvaaca, lipiriid.r"sii vidyate manuja.h kevalena puupena na jiivati kintvii"svarasya sarvvaabhiraaj naabhi rjiivati|</para>
  <para style="p">
    <verse number="5" style="v"/>tadaa "saitaan tamucca.m parvvata.m niitvaa nimi.saikamadhye jagata.h sarvvaraajyaani dar"sitavaan|</para>
  <para style="p">
    <verse number="6" style="v"/>pa"scaat tamavaadiit sarvvam etad vibhava.m prataapa nca tubhya.m daasyaami tan mayi samarpitamaaste ya.m prati mamecchaa jaayate tasmai daatu.m "saknomi,</para>
  <para style="p">
    <verse number="7" style="v"/>tva.m cenmaa.m bhajase tarhi sarvvametat tavaiva bhavi.syati|</para>
  <para style="p">
    <verse number="8" style="v"/>tadaa yii"susta.m pratyuktavaan duurii bhava "saitaan lipiraaste, nija.m prabhu.m parame"svara.m bhajasva kevala.m tameva sevasva ca|</para>
  <para style="p">
    <verse number="9" style="v"/>atha "saitaan ta.m yiruu"saalama.m niitvaa mandirasya cuu.daayaa upari samupave"sya jagaada tva.m cedii"svarasya putrastarhi sthaanaadito lamphitvaadha.h</para>
  <para style="p">
    <verse number="10" style="v"/>pata yato lipiraaste, aaj naapayi.syati sviiyaan duutaan sa parame"svara.h|</para>
  <para style="p">
    <verse number="11" style="v"/>rak.situ.m sarvvamaarge tvaa.m tena tvaccara.ne yathaa| na laget prastaraaghaatastvaa.m dhari.syanti te tathaa|</para>
  <para style="p">
    <verse number="12" style="v"/>tadaa yii"sunaa pratyuktam idamapyuktamasti tva.m svaprabhu.m pare"sa.m maa pariik.sasva|</para>
  <para style="p">
    <verse number="13" style="v"/>pa"scaat "saitaan sarvvapariik.saa.m samaapya k.sa.naatta.m tyaktvaa yayau|</para>
  <para style="p">
    <verse number="14" style="v"/>tadaa yii"suraatmaprabhaavaat punargaaliilprade"sa.m gatastadaa tatsukhyaati"scaturdi"sa.m vyaana"se|</para>
  <para style="p">
    <verse number="15" style="v"/>sa te.saa.m bhajanag.rhe.su upadi"sya sarvvai.h pra"sa.msito babhuuva|</para>
  <para style="p">
    <verse number="16" style="v"/>atha sa svapaalanasthaana.m naasaratpurametya vi"sraamavaare svaacaaraad bhajanageha.m pravi"sya pa.thitumuttasthau|</para>
  <para style="p">
    <verse number="17" style="v"/>tato yi"sayiyabhavi.syadvaadina.h pustake tasya karadatte sati sa tat pustaka.m vistaaryya yatra vak.syamaa.naani vacanaani santi tat sthaana.m praapya papaa.tha|</para>
  <para style="p">
    <verse number="18" style="v"/>aatmaa tu parame"sasya madiiyopari vidyate| daridre.su susa.mvaada.m vaktu.m maa.m sobhi.siktavaan| bhagnaanta.h kara.naallokaan susvasthaan karttumeva ca| bandiik.rte.su loke.su mukte rgho.sayitu.m vaca.h| netraa.ni daatumandhebhyastraatu.m baddhajanaanapi|</para>
  <para style="p">
    <verse number="19" style="v"/>pare"saanugrahe kaala.m pracaarayitumeva ca| sarvvaitatkara.naarthaaya maameva prahi.noti sa.h||</para>
  <para style="p">
    <verse number="20" style="v"/>tata.h pustaka.m badvvaa paricaarakasya haste samarpya caasane samupavi.s.ta.h, tato bhajanag.rhe yaavanto lokaa aasan te sarvve.ananyad.r.s.tyaa ta.m vilulokire|</para>
  <para style="p">
    <verse number="21" style="v"/>anantaram adyaitaani sarvvaa.ni likhitavacanaani yu.smaaka.m madhye siddhaani sa imaa.m kathaa.m tebhya.h kathayitumaarebhe|</para>
  <para style="p">
    <verse number="22" style="v"/>tata.h sarvve tasmin anvarajyanta, ki nca tasya mukhaannirgataabhiranugrahasya kathaabhi"scamatk.rtya kathayaamaasu.h kimaya.m yuu.sapha.h putro na?</para>
  <para style="p">
    <verse number="23" style="v"/>tadaa so.avaadiid he cikitsaka svameva svastha.m kuru kapharnaahuumi yadyat k.rtavaan tada"srau.sma taa.h sarvaa.h kriyaa atra svade"se kuru kathaametaa.m yuuyamevaava"sya.m maa.m vadi.syatha|</para>
  <para style="p">
    <verse number="24" style="v"/>puna.h sovaadiid yu.smaanaha.m yathaartha.m vadaami, kopi bhavi.syadvaadii svade"se satkaara.m na praapnoti|</para>
  <para style="p">
    <verse number="25" style="v"/>apara nca yathaartha.m vacmi, eliyasya jiivanakaale yadaa saarddhatritayavar.saa.ni yaavat jaladapratibandhaat sarvvasmin de"se mahaadurbhik.sam ajani.s.ta tadaaniim israayelo de"sasya madhye bahvyo vidhavaa aasan,</para>
  <para style="p">
    <verse number="26" style="v"/>kintu siidonprade"siiyasaariphatpuranivaasiniim ekaa.m vidhavaa.m vinaa kasyaa"scidapi samiipe eliya.h prerito naabhuut|</para>
  <para style="p">
    <verse number="27" style="v"/>apara nca ilii"saayabhavi.syadvaadividyamaanataakaale israayelde"se bahava.h ku.s.thina aasan kintu suriiyade"siiya.m naamaanku.s.thina.m vinaa kopyanya.h pari.sk.rto naabhuut|</para>
  <para style="p">
    <verse number="28" style="v"/>imaa.m kathaa.m "srutvaa bhajanagehasthitaa lokaa.h sakrodham utthaaya</para>
  <para style="p">
    <verse number="29" style="v"/>nagaraatta.m bahi.sk.rtya yasya "sikhari.na upari te.saa.m nagara.m sthaapitamaaste tasmaannik.septu.m tasya "sikhara.m ta.m ninyu.h</para>
  <para style="p">
    <verse number="30" style="v"/>kintu sa te.saa.m madhyaadapas.rtya sthaanaantara.m jagaama|</para>
  <para style="p">
    <verse number="31" style="v"/>tata.h para.m yii"surgaaliilprade"siiyakapharnaahuumnagara upasthaaya vi"sraamavaare lokaanupade.s.tum aarabdhavaan|</para>
  <para style="p">
    <verse number="32" style="v"/>tadupade"saat sarvve camaccakru ryatastasya kathaa gurutaraa aasan|</para>
  <para style="p">
    <verse number="33" style="v"/>tadaanii.m tadbhajanagehasthito.amedhyabhuutagrasta eko jana uccai.h kathayaamaasa,</para>
  <para style="p">
    <verse number="34" style="v"/>he naasaratiiyayii"so.asmaan tyaja, tvayaa sahaasmaaka.m ka.h sambandha.h? kimasmaan vinaa"sayitumaayaasi? tvamii"svarasya pavitro jana etadaha.m jaanaami|</para>
  <para style="p">
    <verse number="35" style="v"/>tadaa yii"susta.m tarjayitvaavadat maunii bhava ito bahirbhava; tata.h somedhyabhuutasta.m madhyasthaane paatayitvaa ki ncidapyahi.msitvaa tasmaad bahirgatavaan|</para>
  <para style="p">
    <verse number="36" style="v"/>tata.h sarvve lokaa"scamatk.rtya paraspara.m vaktumaarebhire koya.m camatkaara.h| e.sa prabhaave.na paraakrame.na caamedhyabhuutaan aaj naapayati tenaiva te bahirgacchanti|</para>
  <para style="p">
    <verse number="37" style="v"/>anantara.m caturdiksthade"saan tasya sukhyaatirvyaapnot|</para>
  <para style="p">
    <verse number="38" style="v"/>tadanantara.m sa bhajanagehaad bahiraagatya "simono nive"sana.m pravive"sa tadaa tasya "sva"sruurjvare.naatyanta.m pii.ditaasiit "si.syaastadartha.m tasmin vinaya.m cakru.h|</para>
  <para style="p">
    <verse number="39" style="v"/>tata.h sa tasyaa.h samiipe sthitvaa jvara.m tarjayaamaasa tenaiva taa.m jvaro.atyaak.siit tata.h saa tatk.sa.nam utthaaya taan si.seve|</para>
  <para style="p">
    <verse number="40" style="v"/>atha suuryyaastakaale sve.saa.m ye ye janaa naanaarogai.h pii.ditaa aasan lokaastaan yii"so.h samiipam aaninyu.h, tadaa sa ekaikasya gaatre karamarpayitvaa taanarogaan cakaara|</para>
  <para style="p">
    <verse number="41" style="v"/>tato bhuutaa bahubhyo nirgatya ciit"sabda.m k.rtvaa ca babhaa.sire tvamii"svarasya putro.abhi.siktatraataa; kintu sobhi.siktatraateti te vividuretasmaat kaara.naat taan tarjayitvaa tadvaktu.m ni.si.sedha|</para>
  <para style="p">
    <verse number="42" style="v"/>apara nca prabhaate sati sa vijanasthaana.m pratasthe pa"scaat janaastamanvicchantastannika.ta.m gatvaa sthaanaantaragamanaartha.m tamanvarundhan|</para>
  <para style="p">
    <verse number="43" style="v"/>kintu sa taan jagaada, ii"svariiyaraajyasya susa.mvaada.m pracaarayitum anyaani puraa.nyapi mayaa yaatavyaani yatastadarthameva preritoha.m|</para>
  <para style="p">
    <verse number="44" style="v"/>atha gaaliilo bhajanagehe.su sa upadide"sa|</para>
  <chapter number="5" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>anantara.m yii"surekadaa gine.sarathdasya tiira utti.s.thati, tadaa lokaa ii"svariiyakathaa.m "srotu.m tadupari prapatitaa.h|</para>
  <para style="p">
    <verse number="2" style="v"/>tadaanii.m sa hdasya tiirasamiipe naudvaya.m dadar"sa ki nca matsyopajiivino naava.m vihaaya jaala.m prak.saalayanti|</para>
  <para style="p">
    <verse number="3" style="v"/>tatastayordvayo rmadhye "simono naavamaaruhya tiiraat ki ncidduura.m yaatu.m tasmin vinaya.m k.rtvaa naukaayaamupavi"sya lokaan propadi.s.tavaan|</para>
  <para style="p">
    <verse number="4" style="v"/>pa"scaat ta.m prastaava.m samaapya sa "simona.m vyaajahaara, gabhiira.m jala.m gatvaa matsyaan dharttu.m jaala.m nik.sipa|</para>
  <para style="p">
    <verse number="5" style="v"/>tata.h "simona babhaa.se, he guro yadyapi vaya.m k.rtsnaa.m yaaminii.m pari"sramya matsyaikamapi na praaptaastathaapi bhavato nide"sato jaala.m k.sipaama.h|</para>
  <para style="p">
    <verse number="6" style="v"/>atha jaale k.sipte bahumatsyapatanaad aanaaya.h pracchinna.h|</para>
  <para style="p">
    <verse number="7" style="v"/>tasmaad upakarttum anyanausthaan sa"ngina aayaatum i"ngitena samaahvayan tatasta aagatya matsyai rnaudvaya.m prapuurayaamaasu ryai rnaudvaya.m pramagnam|</para>
  <para style="p">
    <verse number="8" style="v"/>tadaa "simonpitarastad vilokya yii"so"scara.nayo.h patitvaa, he prabhoha.m paapii naro mama nika.taad bhavaan yaatu, iti kathitavaan|</para>
  <para style="p">
    <verse number="9" style="v"/>yato jaale patitaanaa.m matsyaanaa.m yuuthaat "simon tatsa"ngina"sca camatk.rtavanta.h; "simona.h sahakaari.nau sivade.h putrau yaakuub yohan cemau taad.r"sau babhuuvatu.h|</para>
  <para style="p">
    <verse number="10" style="v"/>tadaa yii"su.h "simona.m jagaada maa bhai.siiradyaarabhya tva.m manu.syadharo bhavi.syasi|</para>
  <para style="p">
    <verse number="11" style="v"/>anantara.m sarvvaasu nausu tiiram aaniitaasu te sarvvaan parityajya tasya pa"scaadgaamino babhuuvu.h|</para>
  <para style="p">
    <verse number="12" style="v"/>tata.h para.m yii"sau kasmi.m"scit pure ti.s.thati jana eka.h sarvvaa"ngaku.s.thasta.m vilokya tasya samiipe nyubja.h patitvaa savinaya.m vaktumaarebhe, he prabho yadi bhavaanicchati tarhi maa.m pari.skarttu.m "saknoti|</para>
  <para style="p">
    <verse number="13" style="v"/>tadaanii.m sa paa.ni.m prasaaryya tada"nga.m sp.r"san babhaa.se tva.m pari.skriyasveti mamecchaasti tatastatk.sa.na.m sa ku.s.thaat mukta.h|</para>
  <para style="p">
    <verse number="14" style="v"/>pa"scaat sa tamaaj naapayaamaasa kathaamimaa.m kasmaicid akathayitvaa yaajakasya samiipa nca gatvaa sva.m dar"saya, lokebhyo nijapari.sk.rtatvasya pramaa.nadaanaaya muusaaj naanusaare.na dravyamutm.rjasva ca|</para>
  <para style="p">
    <verse number="15" style="v"/>tathaapi yii"so.h sukhyaati rbahu vyaaptumaarebhe ki nca tasya kathaa.m "srotu.m sviiyarogebhyo moktu nca lokaa aajagmu.h|</para>
  <para style="p">
    <verse number="16" style="v"/>atha sa praantara.m gatvaa praarthayaa ncakre|</para>
  <para style="p">
    <verse number="17" style="v"/>apara nca ekadaa yii"surupadi"sati, etarhi gaaliilyihuudaaprade"sayo.h sarvvanagarebhyo yiruu"saalama"sca kiyanta.h phiruu"silokaa vyavasthaapakaa"sca samaagatya tadantike samupavivi"su.h, tasmin kaale lokaanaamaarogyakaara.naat prabho.h prabhaava.h pracakaa"se|</para>
  <para style="p">
    <verse number="18" style="v"/>pa"scaat kiyanto lokaa eka.m pak.saaghaatina.m kha.tvaayaa.m nidhaaya yii"so.h samiipamaanetu.m sammukhe sthaapayitu nca vyaapriyanta|</para>
  <para style="p">
    <verse number="19" style="v"/>kintu bahujananivahasamvaadhaat na "saknuvanto g.rhopari gatvaa g.rhap.r.s.tha.m khanitvaa ta.m pak.saaghaatina.m sakha.tva.m g.rhamadhye yii"so.h sammukhe .avarohayaamaasu.h|</para>
  <para style="p">
    <verse number="20" style="v"/>tadaa yii"suste.saam iid.r"sa.m vi"svaasa.m vilokya ta.m pak.saaghaatina.m vyaajahaara, he maanava tava paapamak.samyata|</para>
  <para style="p">
    <verse number="21" style="v"/>tasmaad adhyaapakaa.h phiruu"sina"sca cittairittha.m pracintitavanta.h, e.sa jana ii"svara.m nindati koya.m? kevalamii"svara.m vinaa paapa.m k.santu.m ka.h "saknoti?</para>
  <para style="p">
    <verse number="22" style="v"/>tadaa yii"suste.saam ittha.m cintana.m viditvaa tebhyokathayad yuuya.m manobhi.h kuto vitarkayatha?</para>
  <para style="p">
    <verse number="23" style="v"/>tava paapak.samaa jaataa yadvaa tvamutthaaya vraja etayo rmadhye kaa kathaa sukathyaa?</para>
  <para style="p">
    <verse number="24" style="v"/>kintu p.rthivyaa.m paapa.m k.santu.m maanavasutasya saamarthyamastiiti yathaa yuuya.m j naatu.m "saknutha tadartha.m (sa ta.m pak.saaghaatina.m jagaada) utti.s.tha sva"sayyaa.m g.rhiitvaa g.rha.m yaahiiti tvaamaadi"saami|</para>
  <para style="p">
    <verse number="25" style="v"/>tasmaat sa tatk.sa.nam utthaaya sarvve.saa.m saak.saat nija"sayaniiya.m g.rhiitvaa ii"svara.m dhanya.m vadan nijanive"sana.m yayau|</para>
  <para style="p">
    <verse number="26" style="v"/>tasmaat sarvve vismaya praaptaa mana.hsu bhiitaa"sca vayamadyaasambhavakaaryyaa.nyadar"saama ityuktvaa parame"svara.m dhanya.m proditaa.h|</para>
  <para style="p">
    <verse number="27" style="v"/>tata.h para.m bahirgacchan karasa ncayasthaane levinaamaana.m karasa ncaayaka.m d.r.s.tvaa yii"sustamabhidadhe mama pa"scaadehi|</para>
  <para style="p">
    <verse number="28" style="v"/>tasmaat sa tatk.sa.naat sarvva.m parityajya tasya pa"scaadiyaaya|</para>
  <para style="p">
    <verse number="29" style="v"/>anantara.m levi rnijag.rhe tadartha.m mahaabhojya.m cakaara, tadaa tai.h sahaaneke karasa ncaayinastadanyalokaa"sca bhoktumupavivi"su.h|</para>
  <para style="p">
    <verse number="30" style="v"/>tasmaat kaara.naat ca.n.daalaanaa.m paapilokaanaa nca sa"nge yuuya.m kuto bha.mgdhve pivatha ceti kathaa.m kathayitvaa phiruu"sino.adhyaapakaa"sca tasya "si.syai.h saha vaagyuddha.m karttumaarebhire|</para>
  <para style="p">
    <verse number="31" style="v"/>tasmaad yii"sustaan pratyavocad arogalokaanaa.m cikitsakena prayojana.m naasti kintu sarogaa.naameva|</para>
  <para style="p">
    <verse number="32" style="v"/>aha.m dhaarmmikaan aahvaatu.m naagatosmi kintu mana.h paraavarttayitu.m paapina eva|</para>
  <para style="p">
    <verse number="33" style="v"/>tataste procu.h, yohana.h phiruu"sinaa nca "si.syaa vaara.mvaaram upavasanti praarthayante ca kintu tava "si.syaa.h kuto bhu njate pivanti ca?</para>
  <para style="p">
    <verse number="34" style="v"/>tadaa sa taanaacakhyau vare sa"nge ti.s.thati varasya sakhiga.na.m kimupavaasayitu.m "saknutha?</para>
  <para style="p">
    <verse number="35" style="v"/>kintu yadaa te.saa.m nika.taad varo ne.syate tadaa te samupavatsyanti|</para>
  <para style="p">
    <verse number="36" style="v"/>soparamapi d.r.s.taanta.m kathayaambabhuuva puraatanavastre kopi nutanavastra.m na siivyati yatastena sevanena jiir.navastra.m chidyate, nuutanapuraatanavastrayo rmela nca na bhavati|</para>
  <para style="p">
    <verse number="37" style="v"/>puraatanyaa.m kutvaa.m kopi nutana.m draak.saarasa.m na nidadhaati, yato naviinadraak.saarasasya tejasaa puraatanii kutuu rvidiiryyate tato draak.saarasa.h patati kutuu"sca na"syati|</para>
  <para style="p">
    <verse number="38" style="v"/>tato heto rnuutanyaa.m kutvaa.m naviinadraak.saarasa.h nidhaatavyastenobhayasya rak.saa bhavati|</para>
  <para style="p">
    <verse number="39" style="v"/>apara nca puraatana.m draak.saarasa.m piitvaa kopi nuutana.m na vaa nchati, yata.h sa vakti nuutanaat puraatanam pra"sastam|</para>
  <chapter number="6" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>acara nca parvva.no dvitiiyadinaat para.m prathamavi"sraamavaare "sasyak.setre.na yii"sorgamanakaale tasya "si.syaa.h ka.ni"sa.m chittvaa kare.su marddayitvaa khaaditumaarebhire|</para>
  <para style="p">
    <verse number="2" style="v"/>tasmaat kiyanta.h phiruu"sinastaanavadan vi"sraamavaare yat karmma na karttavya.m tat kuta.h kurutha?</para>
  <para style="p">
    <verse number="3" style="v"/>yii"su.h pratyuvaaca daayuud tasya sa"ngina"sca k.sudhaarttaa.h ki.m cakru.h sa katham ii"svarasya mandira.m pravi"sya</para>
  <para style="p">
    <verse number="4" style="v"/>ye dar"saniiyaa.h puupaa yaajakaan vinaanyasya kasyaapyabhojaniiyaastaanaaniiya svaya.m bubhaje sa"ngibhyopi dadau tat ki.m yu.smaabhi.h kadaapi naapaa.thi?</para>
  <para style="p">
    <verse number="5" style="v"/>pa"scaat sa taanavadat manujasuto vi"sraamavaarasyaapi prabhu rbhavati|</para>
  <para style="p">
    <verse number="6" style="v"/>anantaram anyavi"sraamavaare sa bhajanageha.m pravi"sya samupadi"sati| tadaa tatsthaane "su.skadak.si.nakara eka.h pumaan upatasthivaan|</para>
  <para style="p">
    <verse number="7" style="v"/>tasmaad adhyaapakaa.h phiruu"sina"sca tasmin do.samaaropayitu.m sa vi"sraamavaare tasya svaasthya.m karoti naveti pratiik.situmaarebhire|</para>
  <para style="p">
    <verse number="8" style="v"/>tadaa yii"suste.saa.m cintaa.m viditvaa ta.m "su.skakara.m pumaa.msa.m provaaca, tvamutthaaya madhyasthaane ti.s.tha|</para>
  <para style="p">
    <verse number="9" style="v"/>tasmaat tasmin utthitavati yii"sustaan vyaajahaara, yu.smaan imaa.m kathaa.m p.rcchaami, vi"sraamavaare hitam ahita.m vaa, praa.narak.sa.na.m praa.nanaa"sana.m vaa, ete.saa.m ki.m karmmakara.niiyam?</para>
  <para style="p">
    <verse number="10" style="v"/>pa"scaat caturdik.su sarvvaan vilokya ta.m maanava.m babhaa.se, nijakara.m prasaaraya; tatastena tathaa k.rta itarakaravat tasya hasta.h svasthobhavat|</para>
  <para style="p">
    <verse number="11" style="v"/>tasmaat te praca.n.dakopaanvitaa yii"su.m ki.m kari.syantiiti paraspara.m pramantritaa.h|</para>
  <para style="p">
    <verse number="12" style="v"/>tata.h para.m sa parvvatamaaruhye"svaramuddi"sya praarthayamaana.h k.rtsnaa.m raatri.m yaapitavaan|</para>
  <para style="p">
    <verse number="13" style="v"/>atha dine sati sa sarvvaan "si.syaan aahuutavaan te.saa.m madhye</para>
  <para style="p">
    <verse number="14" style="v"/>pitaranaamnaa khyaata.h "simon tasya bhraataa aandriya"sca yaakuub yohan ca philip barthalamaya"sca</para>
  <para style="p">
    <verse number="15" style="v"/>mathi.h thomaa aalphiiyasya putro yaakuub jvalantanaamnaa khyaata.h "simon</para>
  <para style="p">
    <verse number="16" style="v"/>ca yaakuubo bhraataa yihuudaa"sca ta.m ya.h parakare.su samarpayi.syati sa ii.skariiyotiiyayihuudaa"scaitaan dvaada"sa janaan manoniitaan k.rtvaa sa jagraaha tathaa prerita iti te.saa.m naama cakaara|</para>
  <para style="p">
    <verse number="17" style="v"/>tata.h para.m sa tai.h saha parvvataadavaruhya upatyakaayaa.m tasthau tatastasya "si.syasa"ngho yihuudaade"saad yiruu"saalama"sca sora.h siidona"sca jaladhe rodhaso jananihaa"sca etya tasya kathaa"srava.naartha.m rogamuktyartha nca tasya samiipe tasthu.h|</para>
  <para style="p">
    <verse number="18" style="v"/>amedhyabhuutagrastaa"sca tannika.tamaagatya svaasthya.m praapu.h|</para>
  <para style="p">
    <verse number="19" style="v"/>sarvve.saa.m svaasthyakara.naprabhaavasya prakaa"sitatvaat sarvve lokaa etya ta.m spra.s.tu.m yetire|</para>
  <para style="p">
    <verse number="20" style="v"/>pa"scaat sa "si.syaan prati d.r.s.ti.m kutvaa jagaada, he daridraa yuuya.m dhanyaa yata ii"svariiye raajye vo.adhikaarosti|</para>
  <para style="p">
    <verse number="21" style="v"/>he adhunaa k.sudhitalokaa yuuya.m dhanyaa yato yuuya.m tarpsyatha; he iha rodino janaa yuuya.m dhanyaa yato yuuya.m hasi.syatha|</para>
  <para style="p">
    <verse number="22" style="v"/>yadaa lokaa manu.syasuuno rnaamaheto ryu.smaan .rृtiiyi.syante p.rthak k.rtvaa nindi.syanti, adhamaaniva yu.smaan svasamiipaad duuriikari.syanti ca tadaa yuuya.m dhanyaa.h|</para>
  <para style="p">
    <verse number="23" style="v"/>svarge yu.smaaka.m yathe.s.ta.m phala.m bhavi.syati, etadartha.m tasmin dine prollasata aanandena n.rtyata ca, te.saa.m puurvvapuru.saa"sca bhavi.syadvaadina.h prati tathaiva vyavaaharan|</para>
  <para style="p">
    <verse number="24" style="v"/>kintu haa haa dhanavanto yuuya.m sukha.m praapnuta| hanta parit.rptaa yuuya.m k.sudhitaa bhavi.syatha;</para>
  <para style="p">
    <verse number="25" style="v"/>iha hasanto yuuya.m vata yu.smaabhi.h "socitavya.m roditavya nca|</para>
  <para style="p">
    <verse number="26" style="v"/>sarvvailaakai ryu.smaaka.m sukhyaatau k.rtaayaa.m yu.smaaka.m durgati rbhavi.syati yu.smaaka.m puurvvapuru.saa m.r.saabhavi.syadvaadina.h prati tadvat k.rtavanta.h|</para>
  <para style="p">
    <verse number="27" style="v"/>he "srotaaro yu.smabhyamaha.m kathayaami, yuuya.m "satru.su priiyadhva.m ye ca yu.smaan dvi.santi te.saamapi hita.m kuruta|</para>
  <para style="p">
    <verse number="28" style="v"/>ye ca yu.smaan "sapanti tebhya aa"si.sa.m datta ye ca yu.smaan avamanyante te.saa.m ma"ngala.m praarthayadhva.m|</para>
  <para style="p">
    <verse number="29" style="v"/>yadi ka"scit tava kapole cape.taaghaata.m karoti tarhi ta.m prati kapolam anya.m paraavarttya sammukhiikuru puna"sca yadi ka"scit tava gaatriiyavastra.m harati tarhi ta.m paridheyavastram api grahiitu.m maa vaaraya|</para>
  <para style="p">
    <verse number="30" style="v"/>yastvaa.m yaacate tasmai dehi, ya"sca tava sampatti.m harati ta.m maa yaacasva|</para>
  <para style="p">
    <verse number="31" style="v"/>parebhya.h svaan prati yathaacara.nam apek.sadhve paraan prati yuuyamapi tathaacarata|</para>
  <para style="p">
    <verse number="32" style="v"/>ye janaa yu.smaasu priiyante kevala.m te.su priiyamaa.ne.su yu.smaaka.m ki.m phala.m? paapilokaa api sve.su priiyamaa.ne.su priiyante|</para>
  <para style="p">
    <verse number="33" style="v"/>yadi hitakaari.na eva hita.m kurutha tarhi yu.smaaka.m ki.m phala.m? paapilokaa api tathaa kurvvanti|</para>
  <para style="p">
    <verse number="34" style="v"/>yebhya .r.napari"sodhasya praaptipratyaa"saaste kevala.m te.su .r.ne samarpite yu.smaaka.m ki.m phala.m? puna.h praaptyaa"sayaa paapiilokaa api paapijane.su .r.nam arpayanti|</para>
  <para style="p">
    <verse number="35" style="v"/>ato yuuya.m ripu.svapi priiyadhva.m, parahita.m kuruta ca; puna.h praaptyaa"saa.m tyaktvaa .r.namarpayata, tathaa k.rte yu.smaaka.m mahaaphala.m bhavi.syati, yuuya nca sarvvapradhaanasya santaanaa iti khyaati.m praapsyatha, yato yu.smaaka.m pitaa k.rtaghnaanaa.m durv.tattaanaa nca hitamaacarati|</para>
  <para style="p">
    <verse number="36" style="v"/>ata eva sa yathaa dayaalu ryuuyamapi taad.r"saa dayaalavo bhavata|</para>
  <para style="p">
    <verse number="37" style="v"/>apara nca paraan do.si.no maa kuruta tasmaad yuuya.m do.siik.rtaa na bhavi.syatha; ada.n.dyaan maa da.n.dayata tasmaad yuuyamapi da.n.da.m na praapsyatha; pare.saa.m do.saan k.samadhva.m tasmaad yu.smaakamapi do.saa.h k.sami.syante|</para>
  <para style="p">
    <verse number="38" style="v"/>daanaanidatta tasmaad yuuya.m daanaani praapsyatha, vara nca lokaa.h parimaa.napaatra.m pradalayya sa ncaalya pro ncaalya paripuuryya yu.smaaka.m kro.de.su samarpayi.syanti; yuuya.m yena parimaa.nena parimaatha tenaiva parimaa.nena yu.smatk.rte parimaasyate|</para>
  <para style="p">
    <verse number="39" style="v"/>atha sa tebhyo d.r.s.taantakathaamakathayat, andho jana.h kimandha.m panthaana.m dar"sayitu.m "saknoti? tasmaad ubhaavapi ki.m gartte na pati.syata.h?</para>
  <para style="p">
    <verse number="40" style="v"/>guro.h "si.syo na "sre.s.tha.h kintu "si.sye siddhe sati sa gurutulyo bhavitu.m "saknoti|</para>
  <para style="p">
    <verse number="41" style="v"/>apara nca tva.m svacak.suु.si naasaam ad.r.s.tvaa tava bhraatu"scak.su.si yatt.r.namasti tadeva kuta.h pa"syami?</para>
  <para style="p">
    <verse number="42" style="v"/>svacak.su.si yaa naasaa vidyate taam aj naatvaa, bhraatastava netraat t.r.na.m bahi.h karomiiti vaakya.m bhraatara.m katha.m vaktu.m "sakno.si? he kapa.tin puurvva.m svanayanaat naasaa.m bahi.h kuru tato bhraatu"scak.su.sast.r.na.m bahi.h karttu.m sud.r.s.ti.m praapsyasi|</para>
  <para style="p">
    <verse number="43" style="v"/>anya nca uttamastaru.h kadaapi phalamanuttama.m na phalati, anuttamataru"sca phalamuttama.m na phalati kaara.naadata.h phalaistaravo j naayante|</para>
  <para style="p">
    <verse number="44" style="v"/>ka.n.takipaadapaat kopi u.dumbaraphalaani na paatayati tathaa "s.rgaalakoliv.rk.saadapi kopi draak.saaphala.m na paatayati|</para>
  <para style="p">
    <verse number="45" style="v"/>tadvat saadhuloko.anta.hkara.naruupaat subhaa.n.daagaaraad uttamaani dravyaa.ni bahi.h karoti, du.s.to loka"scaanta.hkara.naruupaat kubhaa.n.daagaaraat kutsitaani dravyaa.ni nirgamayati yato.anta.hkara.naanaa.m puur.nabhaavaanuruupaa.ni vacaa.msi mukhaannirgacchanti|</para>
  <para style="p">
    <verse number="46" style="v"/>apara nca mamaaj naanuruupa.m naacaritvaa kuto maa.m prabho prabho iti vadatha?</para>
  <para style="p">
    <verse number="47" style="v"/>ya.h ka"scin mama nika.tam aagatya mama kathaa ni"samya tadanuruupa.m karmma karoti sa kasya sad.r"so bhavati tadaha.m yu.smaan j naaाpayaami|</para>
  <para style="p">
    <verse number="48" style="v"/>yo jano gabhiira.m khanitvaa paa.saa.nasthale bhitti.m nirmmaaya svag.rha.m racayati tena saha tasyopamaa bhavati; yata aaplaavijalametya tasya muule vegena vahadapi tadgeha.m laa.dayitu.m na "saknoti yatastasya bhitti.h paa.saa.nopari ti.s.thati|</para>
  <para style="p">
    <verse number="49" style="v"/>kintu ya.h ka"scin mama kathaa.h "srutvaa tadanuruupa.m naacarati sa bhitti.m vinaa m.rृdupari g.rhanirmmaatraa samaano bhavati; yata aaplaavijalamaagatya vegena yadaa vahati tadaa tadg.rha.m patati tasya mahat patana.m jaayate|</para>
  <chapter number="7" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>tata.h para.m sa lokaanaa.m kar.nagocare taan sarvvaan upade"saan samaapya yadaa kapharnaahuumpura.m pravi"sati</para>
  <para style="p">
    <verse number="2" style="v"/>tadaa "satasenaapate.h priyadaasa eko m.rtakalpa.h pii.dita aasiit|</para>
  <para style="p">
    <verse number="3" style="v"/>ata.h senaapati ryii"so rvaarttaa.m ni"samya daasasyaarogyakara.naaya tasyaagamanaartha.m vinayakara.naaya yihuudiiyaan kiyata.h praaca.h pre.sayaamaasa|</para>
  <para style="p">
    <verse number="4" style="v"/>te yii"sorantika.m gatvaa vinayaati"saya.m vaktumaarebhire, sa senaapati rbhavatonugraha.m praaptum arhati|</para>
  <para style="p">
    <verse number="5" style="v"/>yata.h sosmajjaatiiye.su loke.su priiyate tathaasmatk.rte bhajanageha.m nirmmitavaan|</para>
  <para style="p">
    <verse number="6" style="v"/>tasmaad yii"sustai.h saha gatvaa nive"sanasya samiipa.m praapa, tadaa sa "satasenaapati rvak.syamaa.navaakya.m ta.m vaktu.m bandhuun praahi.not| he prabho svaya.m "sramo na karttavyo yad bhavataa madgehamadhye paadaarpa.na.m kriyeta tadapyaha.m naarhaami,</para>
  <para style="p">
    <verse number="7" style="v"/>ki ncaaha.m bhavatsamiipa.m yaatumapi naatmaana.m yogya.m buddhavaan, tato bhavaan vaakyamaatra.m vadatu tenaiva mama daasa.h svastho bhavi.syati|</para>
  <para style="p">
    <verse number="8" style="v"/>yasmaad aha.m paraadhiinopi mamaadhiinaa yaa.h senaa.h santi taasaam ekajana.m prati yaahiiti mayaa prokte sa yaati; tadanya.m prati aayaahiiti prokte sa aayaati; tathaa nijadaasa.m prati etat kurvviti prokte sa tadeva karoti|</para>
  <para style="p">
    <verse number="9" style="v"/>yii"surida.m vaakya.m "srutvaa vismaya.m yayau, mukha.m paraavartya pa"scaadvarttino lokaan babhaa.se ca, yu.smaanaha.m vadaami israayelo va.m"samadhyepi vi"svaasamiid.r"sa.m na praapnava.m|</para>
  <para style="p">
    <verse number="10" style="v"/>tataste pre.sitaa g.rha.m gatvaa ta.m pii.dita.m daasa.m svastha.m dad.r"su.h|</para>
  <para style="p">
    <verse number="11" style="v"/>pare.ahani sa naayiinaakhya.m nagara.m jagaama tasyaaneke "si.syaa anye ca lokaastena saarddha.m yayu.h|</para>
  <para style="p">
    <verse number="12" style="v"/>te.su tannagarasya dvaarasannidhi.m praapte.su kiyanto lokaa eka.m m.rtamanuja.m vahanto nagarasya bahiryaanti, sa tanmaaturekaputrastanmaataa ca vidhavaa; tayaa saarddha.m tannagariiyaa bahavo lokaa aasan|</para>
  <para style="p">
    <verse number="13" style="v"/>prabhustaa.m vilokya saanukampa.h kathayaamaasa, maa rodii.h| sa samiipamitvaa kha.tvaa.m paspar"sa tasmaad vaahakaa.h sthagitaastamyu.h;</para>
  <para style="p">
    <verse number="14" style="v"/>tadaa sa uvaaca he yuvamanu.sya tvamutti.s.tha, tvaamaham aaj naapayaami|</para>
  <para style="p">
    <verse number="15" style="v"/>tasmaat sa m.rto janastatk.sa.namutthaaya kathaa.m prakathita.h; tato yii"sustasya maatari ta.m samarpayaamaasa|</para>
  <para style="p">
    <verse number="16" style="v"/>tasmaat sarvve lokaa.h "sa"sa"nkire; eko mahaabhavi.syadvaadii madhye.asmaakam samudait, ii"svara"sca svalokaananvag.rhlaat kathaamimaa.m kathayitvaa ii"svara.m dhanya.m jagadu.h|</para>
  <para style="p">
    <verse number="17" style="v"/>tata.h para.m samasta.m yihuudaade"sa.m tasya caturdiksthade"sa nca tasyaitatkiirtti rvyaana"se|</para>
  <para style="p">
    <verse number="18" style="v"/>tata.h para.m yohana.h "si.sye.su ta.m tadv.rttaanta.m j naapitavatsu</para>
  <para style="p">
    <verse number="19" style="v"/>sa sva"si.syaa.naa.m dvau janaavaahuuya yii"su.m prati vak.syamaa.na.m vaakya.m vaktu.m pre.sayaamaasa, yasyaagamanam apek.sya ti.s.thaamo vaya.m ki.m sa eva janastva.m? ki.m vayamanyamapek.sya sthaasyaama.h?</para>
  <para style="p">
    <verse number="20" style="v"/>pa"scaattau maanavau gatvaa kathayaamaasatu.h, yasyaagamanam apek.sya ti.s.thaamo vaya.m, ki.m saeva janastva.m? ki.m vayamanyamapek.sya sthaasyaama.h? kathaamimaa.m tubhya.m kathayitu.m yohan majjaka aavaa.m pre.sitavaan|</para>
  <para style="p">
    <verse number="21" style="v"/>tasmin da.n.de yii"suurogi.no mahaavyaadhimato du.s.tabhuutagrastaa.m"sca bahuun svasthaan k.rtvaa, anekaandhebhya"scak.su.m.si dattvaa pratyuvaaca,</para>
  <para style="p">
    <verse number="22" style="v"/>yuvaa.m vrajatam andhaa netraa.ni kha njaa"scara.naani ca praapnuvanti, ku.s.thina.h pari.skriyante, badhiraa.h "srava.naani m.rtaa"sca jiivanaani praapnuvanti, daridraa.naa.m samiipe.su susa.mvaada.h pracaaryyate, ya.m prati vighnasvaruupoha.m na bhavaami sa dhanya.h,</para>
  <para style="p">
    <verse number="23" style="v"/>etaani yaani pa"syatha.h "s.r.nutha"sca taani yohana.m j naapayatam|</para>
  <para style="p">
    <verse number="24" style="v"/>tayo rduutayo rgatayo.h sato ryohani sa lokaan vaktumupacakrame, yuuya.m madhyepraantara.m ki.m dra.s.tu.m niragamata? ki.m vaayunaa kampita.m na.da.m?</para>
  <para style="p">
    <verse number="25" style="v"/>yuuya.m ki.m dra.s.tu.m niragamata? ki.m suuk.smavastraparidhaayina.m kamapi nara.m? kintu ye suuk.smam.rduvastraa.ni paridadhati suuttamaani dravyaa.ni bhu njate ca te raajadhaanii.su ti.s.thanti|</para>
  <para style="p">
    <verse number="26" style="v"/>tarhi yuuya.m ki.m dra.s.tu.m niragamata? kimeka.m bhavi.syadvaadina.m? tadeva satya.m kintu sa pumaan bhavi.syadvaadinopi "sre.s.tha ityaha.m yu.smaan vadaami;</para>
  <para style="p">
    <verse number="27" style="v"/>pa"sya svakiiyaduutantu tavaagra pre.sayaamyaha.m| gatvaa tvadiiyamaargantu sa hi pari.skari.syati| yadarthe lipiriyam aaste sa eva yohan|</para>
  <para style="p">
    <verse number="28" style="v"/>ato yu.smaanaha.m vadaami striyaa garbbhajaataanaa.m bhavi.syadvaadinaa.m madhye yohano majjakaat "sre.s.tha.h kopi naasti, tatraapi ii"svarasya raajye ya.h sarvvasmaat k.sudra.h sa yohanopi "sre.s.tha.h|</para>
  <para style="p">
    <verse number="29" style="v"/>apara nca sarvve lokaa.h karama ncaayina"sca tasya vaakyaani "srutvaa yohanaa majjanena majjitaa.h parame"svara.m nirdo.sa.m menire|</para>
  <para style="p">
    <verse number="30" style="v"/>kintu phiruu"sino vyavasthaapakaa"sca tena na majjitaa.h svaan pratii"svarasyopade"sa.m ni.sphalam akurvvan|</para>
  <para style="p">
    <verse number="31" style="v"/>atha prabhu.h kathayaamaasa, idaaniintanajanaan kenopamaami? te kasya sad.r"saa.h?</para>
  <para style="p">
    <verse number="32" style="v"/>ye baalakaa vipa.nyaam upavi"sya parasparam aahuuya vaakyamida.m vadanti, vaya.m yu.smaaka.m nika.te va.m"siiravaadi.sma, kintu yuuya.m naanartti.s.ta, vaya.m yu.smaaka.m nika.ta arodi.sma, kintu yuya.m na vyalapi.s.ta, baalakairetaad.r"saiste.saam upamaa bhavati|</para>
  <para style="p">
    <verse number="33" style="v"/>yato yohan majjaka aagatya puupa.m naakhaadat draak.saarasa nca naapivat tasmaad yuuya.m vadatha, bhuutagrastoyam|</para>
  <para style="p">
    <verse number="34" style="v"/>tata.h para.m maanavasuta aagatyaakhaadadapiva nca tasmaad yuuya.m vadatha, khaadaka.h suraapa"scaa.n.daalapaapinaa.m bandhureko jano d.r"syataam|</para>
  <para style="p">
    <verse number="35" style="v"/>kintu j naanino j naana.m nirdo.sa.m vidu.h|</para>
  <para style="p">
    <verse number="36" style="v"/>pa"scaadeka.h phiruu"sii yii"su.m bhojanaaya nyamantrayat tata.h sa tasya g.rha.m gatvaa bhoktumupavi.s.ta.h|</para>
  <para style="p">
    <verse number="37" style="v"/>etarhi tatphiruu"sino g.rhe yii"su rbhektum upaavek.siit tacchrutvaa tannagaravaasinii kaapi du.s.taa naarii paa.n.daraprastarasya sampu.take sugandhitailam aaniiya</para>
  <para style="p">
    <verse number="38" style="v"/>tasya pa"scaat paadayo.h sannidhau tasyau rudatii ca netraambubhistasya cara.nau prak.saalya nijakacairamaark.siit, tatastasya cara.nau cumbitvaa tena sugandhitailena mamarda|</para>
  <para style="p">
    <verse number="39" style="v"/>tasmaat sa nimantrayitaa phiruu"sii manasaa cintayaamaasa, yadyaya.m bhavi.syadvaadii bhavet tarhi ena.m sp.r"sati yaa strii saa kaa kiid.r"sii ceti j naatu.m "saknuyaat yata.h saa du.s.taa|</para>
  <para style="p">
    <verse number="40" style="v"/>tadaa yaa"susta.m jagaada, he "simon tvaa.m prati mama ki ncid vaktavyamasti; tasmaat sa babhaa.se, he guro tad vadatu|</para>
  <para style="p">
    <verse number="41" style="v"/>ekottamar.nasya dvaavadhamar.naavaastaa.m, tayoreka.h pa nca"sataani mudraapaadaan apara"sca pa ncaa"sat mudraapaadaan dhaarayaamaasa|</para>
  <para style="p">
    <verse number="42" style="v"/>tadanantara.m tayo.h "sodhyaabhaavaat sa uttamar.nastayo r.r.ne cak.same; tasmaat tayordvayo.h kastasmin pre.syate bahu? tad bruuhi|</para>
  <para style="p">
    <verse number="43" style="v"/>"simon pratyuvaaca, mayaa budhyate yasyaadhikam .r.na.m cak.same sa iti; tato yii"susta.m vyaajahaara, tva.m yathaartha.m vyacaaraya.h|</para>
  <para style="p">
    <verse number="44" style="v"/>atha taa.m naarii.m prati vyaaghu.thya "simonamavocat, striimimaa.m pa"syasi? tava g.rhe mayyaagate tva.m paadaprak.saalanaartha.m jala.m naadaa.h kintu yo.side.saa nayanajalai rmama paadau prak.saalya ke"sairamaark.siit|</para>
  <para style="p">
    <verse number="45" style="v"/>tva.m maa.m naacumbii.h kintu yo.side.saa sviiyaagamanaadaarabhya madiiyapaadau cumbitu.m na vyara.msta|</para>
  <para style="p">
    <verse number="46" style="v"/>tva nca madiiyottamaa"nge ki ncidapi taila.m naamardii.h kintu yo.side.saa mama cara.nau sugandhitailenaamarddiit|</para>
  <para style="p">
    <verse number="47" style="v"/>atastvaa.m vyaaharaami, etasyaa bahu paapamak.samyata tato bahu priiyate kintu yasyaalpapaapa.m k.samyate solpa.m priiyate|</para>
  <para style="p">
    <verse number="48" style="v"/>tata.h para.m sa taa.m babhaa.se, tvadiiya.m paapamak.samyata|</para>
  <para style="p">
    <verse number="49" style="v"/>tadaa tena saarddha.m ye bhoktum upavivi"suste paraspara.m vaktumaarebhire, aya.m paapa.m k.samate ka e.sa.h?</para>
  <para style="p">
    <verse number="50" style="v"/>kintu sa taa.m naarii.m jagaada, tava vi"svaasastvaa.m paryyatraasta tva.m k.seme.na vraja|</para>
  <chapter number="8" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>apara nca yii"su rdvaada"sabhi.h "si.syai.h saarddha.m naanaanagare.su naanaagraame.su ca gacchan i"svariiyaraajatvasya susa.mvaada.m pracaarayitu.m praarebhe|</para>
  <para style="p">
    <verse number="2" style="v"/>tadaa yasyaa.h sapta bhuutaa niragacchan saa magdaliiniiti vikhyaataa mariyam herodraajasya g.rhaadhipate.h ho.se rbhaaryyaa yohanaa "suu"saanaa</para>
  <para style="p">
    <verse number="3" style="v"/>prabh.rtayo yaa bahvya.h striya.h du.s.tabhuutebhyo rogebhya"sca muktaa.h satyo nijavibhuutii rvyayitvaa tamasevanta, taa.h sarvvaastena saarddham aasan|</para>
  <para style="p">
    <verse number="4" style="v"/>anantara.m naanaanagarebhyo bahavo lokaa aagatya tasya samiipe.amilan, tadaa sa tebhya ekaa.m d.r.s.taantakathaa.m kathayaamaasa| eka.h k.r.siibalo biijaani vaptu.m bahirjagaama,</para>
  <para style="p">
    <verse number="5" style="v"/>tato vapanakaale katipayaani biijaani maargapaar"sve petu.h, tatastaani padatalai rdalitaani pak.sibhi rbhak.sitaani ca|</para>
  <para style="p">
    <verse number="6" style="v"/>katipayaani biijaani paa.saa.nasthale patitaani yadyapi taanya"nkuritaani tathaapi rasaabhaavaat "su"su.su.h|</para>
  <para style="p">
    <verse number="7" style="v"/>katipayaani biijaani ka.n.takivanamadhye patitaani tata.h ka.n.takivanaani sa.mv.rddhya taani jagrasu.h|</para>
  <para style="p">
    <verse number="8" style="v"/>tadanyaani katipayabiijaani ca bhuumyaamuttamaayaa.m petustatastaanya"nkurayitvaa "satagu.naani phalaani phelu.h| sa imaa kathaa.m kathayitvaa proccai.h provaaca, yasya "srotu.m "srotre sta.h sa "s.r.notu|</para>
  <para style="p">
    <verse number="9" style="v"/>tata.h para.m "si.syaasta.m papracchurasya d.r.s.taantasya ki.m taatparyya.m?</para>
  <para style="p">
    <verse number="10" style="v"/>tata.h sa vyaajahaara, ii"svariiyaraajyasya guhyaani j naatu.m yu.smabhyamadhikaaro diiyate kintvanye yathaa d.r.s.tvaapi na pa"syanti "srutvaapi ma budhyante ca tadartha.m te.saa.m purastaat taa.h sarvvaa.h kathaa d.r.s.taantena kathyante|</para>
  <para style="p">
    <verse number="11" style="v"/>d.r.s.taantasyaasyaabhipraaya.h, ii"svariiyakathaa biijasvaruupaa|</para>
  <para style="p">
    <verse number="12" style="v"/>ye kathaamaatra.m "s.r.nvanti kintu pa"scaad vi"svasya yathaa paritraa.na.m na praapnuvanti tadaa"sayena "saitaanetya h.rdayaat.r taa.m kathaam apaharati ta eva maargapaar"svasthabhuumisvaruupaa.h|</para>
  <para style="p">
    <verse number="13" style="v"/>ye katha.m "srutvaa saananda.m g.rhlanti kintvabaddhamuulatvaat svalpakaalamaatra.m pratiitya pariik.saakaale bhra"syanti taeva paa.saa.nabhuumisvaruupaa.h|</para>
  <para style="p">
    <verse number="14" style="v"/>ye kathaa.m "srutvaa yaanti vi.sayacintaayaa.m dhanalobhena eेhikasukhe ca majjanta upayuktaphalaani na phalanti ta evoptabiijaka.n.takibhuusvaruupaa.h|</para>
  <para style="p">
    <verse number="15" style="v"/>kintu ye "srutvaa saralai.h "suddhai"scaanta.hkara.nai.h kathaa.m g.rhlanti dhairyyam avalambya phalaanyutpaadayanti ca ta evottamam.rtsvaruupaa.h|</para>
  <para style="p">
    <verse number="16" style="v"/>apara nca pradiipa.m prajvaalya kopi paatre.na naacchaadayati tathaa kha.tvaadhopi na sthaapayati, kintu diipaadhaaroparyyeva sthaapayati, tasmaat prave"sakaa diipti.m pa"syanti|</para>
  <para style="p">
    <verse number="17" style="v"/>yanna prakaa"sayi.syate taad.rg aprakaa"sita.m vastu kimapi naasti yacca na suvyakta.m pracaarayi.syate taad.rg g.rpta.m vastu kimapi naasti|</para>
  <para style="p">
    <verse number="18" style="v"/>ato yuuya.m kena prakaare.na "s.r.nutha tatra saavadhaanaa bhavata, yasya samiipe barddhate tasmai punardaasyate kintu yasyaa"sraye na barddhate tasya yadyadasti tadapi tasmaat ne.syate|</para>
  <para style="p">
    <verse number="19" style="v"/>apara nca yii"so rmaataa bhraatara"sca tasya samiipa.m jigami.sava.h</para>
  <para style="p">
    <verse number="20" style="v"/>kintu janataasambaadhaat tatsannidhi.m praaptu.m na "seku.h| tatpa"scaat tava maataa bhraatara"sca tvaa.m saak.saat cikiir.santo bahisti.s.thanatiiti vaarttaayaa.m tasmai kathitaayaa.m</para>
  <para style="p">
    <verse number="21" style="v"/>sa pratyuvaaca; ye janaa ii"svarasya kathaa.m "srutvaa tadanuruupamaacaranti taeva mama maataa bhraatara"sca|</para>
  <para style="p">
    <verse number="22" style="v"/>anantara.m ekadaa yii"su.h "si.syai.h saarddha.m naavamaaruhya jagaada, aayaata vaya.m hradasya paara.m yaama.h, tataste jagmu.h|</para>
  <para style="p">
    <verse number="23" style="v"/>te.su naukaa.m vaahayatsu sa nidadrau;</para>
  <para style="p">
    <verse number="24" style="v"/>athaakasmaat prabalajha nbh"sagamaad hrade naukaayaa.m tara"ngairaacchannaayaa.m vipat taan jagraasa|tasmaad yii"sorantika.m gatvaa he guro he guro praa.naa no yaantiiti gaditvaa ta.m jaagarayaambabhuuvu.h|tadaa sa utthaaya vaayu.m tara"ngaa.m"sca tarjayaamaasa tasmaadubhau niv.rtya sthirau babhuuvatu.h|</para>
  <para style="p">
    <verse number="25" style="v"/>sa taan babhaa.se yu.smaaka.m vi"svaasa.h ka? tasmaatte bhiitaa vismitaa"sca paraspara.m jagadu.h, aho kiid.rgaya.m manuja.h pavana.m paaniiya ncaadi"sati tadubhaya.m tadaade"sa.m vahati|</para>
  <para style="p">
    <verse number="26" style="v"/>tata.h para.m gaaliilprade"sasya sammukhasthagideriiyaprade"se naukaayaa.m lagantyaa.m ta.te.avarohamaavaad</para>
  <para style="p">
    <verse number="27" style="v"/>bahutithakaala.m bhuutagrasta eko maanu.sa.h puraadaagatya ta.m saak.saaccakaara| sa manu.so vaaso na paridadhat g.rhe ca na vasan kevala.m "sma"saanam adhyuvaasa|</para>
  <para style="p">
    <verse number="28" style="v"/>sa yii"su.m d.r.s.tvaiva ciicchabda.m cakaara tasya sammukhe patitvaa proccairjagaada ca, he sarvvapradhaane"svarasya putra, mayaa saha tava ka.h sambandha.h? tvayi vinaya.m karomi maa.m maa yaataya|</para>
  <para style="p">
    <verse number="29" style="v"/>yata.h sa ta.m maanu.sa.m tyaktvaa yaatum amedhyabhuutam aadide"sa; sa bhuutasta.m maanu.sam asak.rd dadhaara tasmaallokaa.h "s.r"nkhalena niga.dena ca babandhu.h; sa tad bha.mktvaa bhuutava"satvaat madhyepraantara.m yayau|</para>
  <para style="p">
    <verse number="30" style="v"/>anantara.m yii"susta.m papraccha tava kinnaama? sa uvaaca, mama naama baahino yato bahavo bhuutaastamaa"si"sriyu.h|</para>
  <para style="p">
    <verse number="31" style="v"/>atha bhuutaa vinayena jagadu.h, gabhiira.m gartta.m gantu.m maaj naapayaasmaan|</para>
  <para style="p">
    <verse number="32" style="v"/>tadaa parvvatopari varaahavraja"scarati tasmaad bhuutaa vinayena procu.h, amu.m varaahavrajam aa"srayitum asmaan anujaaniihi; tata.h sonujaj nau|</para>
  <para style="p">
    <verse number="33" style="v"/>tata.h para.m bhuutaasta.m maanu.sa.m vihaaya varaahavrajam aa"si"sriyu.h varaahavrajaa"sca tatk.sa.naat ka.takena dhaavanto hrade praa.naan vij.rhu.h|</para>
  <para style="p">
    <verse number="34" style="v"/>tad d.r.s.tvaa "suukararak.sakaa.h palaayamaanaa nagara.m graama nca gatvaa tatsarvvav.rttaanta.m kathayaamaasu.h|</para>
  <para style="p">
    <verse number="35" style="v"/>tata.h ki.m v.rttam etaddar"sanaartha.m lokaa nirgatya yii"so.h samiipa.m yayu.h, ta.m maanu.sa.m tyaktabhuuta.m parihitavastra.m svasthamaanu.savad yii"so"scara.nasannidhau suupavi"santa.m vilokya bibhyu.h|</para>
  <para style="p">
    <verse number="36" style="v"/>ye lokaastasya bhuutagrastasya svaasthyakara.na.m dad.r"suste tebhya.h sarvvav.rttaanta.m kathayaamaasu.h|</para>
  <para style="p">
    <verse number="37" style="v"/>tadanantara.m tasya gideriiyaprade"sasya caturdiksthaa bahavo janaa atitrastaa vinayena ta.m jagadu.h, bhavaan asmaaka.m nika.taad vrajatu tasmaat sa naavamaaruhya tato vyaaghu.tya jagaama|</para>
  <para style="p">
    <verse number="38" style="v"/>tadaanii.m tyaktabhuutamanujastena saha sthaatu.m praarthayaa ncakre</para>
  <para style="p">
    <verse number="39" style="v"/>kintu tadartham ii"svara.h kiid.r"nmahaakarmma k.rtavaan iti nive"sana.m gatvaa vij naapaya, yii"su.h kathaametaa.m kathayitvaa ta.m visasarja| tata.h sa vrajitvaa yii"sustadartha.m yanmahaakarmma cakaara tat purasya sarvvatra prakaa"sayitu.m praarebhe|</para>
  <para style="p">
    <verse number="40" style="v"/>atha yii"sau paraav.rtyaagate lokaasta.m aadare.na jag.rhu ryasmaatte sarvve tamapek.saa ncakrire|</para>
  <para style="p">
    <verse number="41" style="v"/>tadanantara.m yaayiirnaamno bhajanagehasyaikodhipa aagatya yii"so"scara.nayo.h patitvaa svanive"sanaagamanaartha.m tasmin vinaya.m cakaara,</para>
  <para style="p">
    <verse number="42" style="v"/>yatastasya dvaada"savar.savayaskaa kanyaikaasiit saa m.rtakalpaabhavat| tatastasya gamanakaale maarge lokaanaa.m mahaan samaagamo babhuuva|</para>
  <para style="p">
    <verse number="43" style="v"/>dvaada"savar.saa.ni pradararogagrastaa naanaa vaidyai"scikitsitaa sarvvasva.m vyayitvaapi svaasthya.m na praaptaa yaa yo.sit saa yii"so.h pa"scaadaagatya tasya vastragranthi.m paspar"sa|</para>
  <para style="p">
    <verse number="44" style="v"/>tasmaat tatk.sa.naat tasyaa raktasraavo ruddha.h|</para>
  <para style="p">
    <verse number="45" style="v"/>tadaanii.m yii"suravadat kenaaha.m sp.r.s.ta.h? tato.anekairana"ngiik.rte pitarastasya sa"ngina"scaavadan, he guro lokaa nika.tasthaa.h santastava dehe ghar.sayanti, tathaapi kenaaha.m sp.r.s.ta_iti bhavaan kuta.h p.rcchati?</para>
  <para style="p">
    <verse number="46" style="v"/>yii"su.h kathayaamaasa, kenaapyaha.m sp.r.s.to, yato matta.h "sakti rnirgateti mayaa ni"scitamaj naayi|</para>
  <para style="p">
    <verse number="47" style="v"/>tadaa saa naarii svaya.m na gupteti viditvaa kampamaanaa satii tasya sammukhe papaata; yena nimittena ta.m paspar"sa spar"samaatraacca yena prakaare.na svasthaabhavat tat sarvva.m tasya saak.saadaacakhyau|</para>
  <para style="p">
    <verse number="48" style="v"/>tata.h sa taa.m jagaada he kanye susthiraa bhava, tava vi"svaasastvaa.m svasthaam akaar.siit tva.m k.seme.na yaahi|</para>
  <para style="p">
    <verse number="49" style="v"/>yii"soretadvaakyavadanakaale tasyaadhipate rnive"sanaat ka"scilloka aagatya ta.m babhaa.se, tava kanyaa m.rtaa guru.m maa kli"saana|</para>
  <para style="p">
    <verse number="50" style="v"/>kintu yii"sustadaakar.nyaadhipati.m vyaajahaara, maa bhai.sii.h kevala.m vi"svasihi tasmaat saa jiivi.syati|</para>
  <para style="p">
    <verse number="51" style="v"/>atha tasya nive"sane praapte sa pitara.m yohana.m yaakuuba nca kanyaayaa maatara.m pitara nca vinaa, anya.m ka ncana prave.s.tu.m vaarayaamaasa|</para>
  <para style="p">
    <verse number="52" style="v"/>apara nca ye rudanti vilapanti ca taan sarvvaan janaan uvaaca, yuuya.m maa rodi.s.ta kanyaa na m.rtaa nidraati|</para>
  <para style="p">
    <verse number="53" style="v"/>kintu saa ni"scita.m m.rteti j naatvaa te tamupajahasu.h|</para>
  <para style="p">
    <verse number="54" style="v"/>pa"scaat sa sarvvaan bahi.h k.rtvaa kanyaayaa.h karau dh.rtvaajuhuve, he kanye tvamutti.s.tha,</para>
  <para style="p">
    <verse number="55" style="v"/>tasmaat tasyaa.h praa.ne.su punaraagate.su saa tatk.sa.naad uttasyau| tadaanii.m tasyai ki ncid bhak.sya.m daatum aadide"sa|</para>
  <para style="p">
    <verse number="56" style="v"/>tatastasyaa.h pitarau vismaya.m gatau kintu sa taavaadide"sa gha.tanaayaa etasyaa.h kathaa.m kasmaicidapi maa kathayata.m|</para>
  <chapter number="9" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>tata.h para.m sa dvaada"sa"si.syaanaahuuya bhuutaan tyaajayitu.m rogaan pratikarttu nca tebhya.h "saktimaadhipatya nca dadau|</para>
  <para style="p">
    <verse number="2" style="v"/>apara nca ii"svariiyaraajyasya susa.mvaada.m prakaa"sayitum rogi.naamaarogya.m karttu nca prera.nakaale taan jagaada|</para>
  <para style="p">
    <verse number="3" style="v"/>yaatraartha.m ya.s.ti rvastrapu.taka.m bhak.sya.m mudraa dvitiiyavastram, e.saa.m kimapi maa g.rhliita|</para>
  <para style="p">
    <verse number="4" style="v"/>yuuya nca yannive"sana.m pravi"satha nagaratyaagaparyyanata.m tannive"sane ti.s.thata|</para>
  <para style="p">
    <verse number="5" style="v"/>tatra yadi kasyacit purasya lokaa yu.smaakamaatithya.m na kurvvanti tarhi tasmaannagaraad gamanakaale te.saa.m viruddha.m saak.syaartha.m yu.smaaka.m padadhuulii.h sampaatayata|</para>
  <para style="p">
    <verse number="6" style="v"/>atha te prasthaaya sarvvatra susa.mvaada.m pracaarayitu.m pii.ditaan svasthaan karttu nca graame.su bhramitu.m praarebhire|</para>
  <para style="p">
    <verse number="7" style="v"/>etarhi herod raajaa yii"so.h sarvvakarmma.naa.m vaarttaa.m "srutvaa bh.r"samudvivije</para>
  <para style="p">
    <verse number="8" style="v"/>yata.h keciduucuryohan "sma"saanaadudati.s.that| keciduucu.h, eliyo dar"sana.m dattavaan; evamanyalokaa uucu.h puurvviiya.h ka"scid bhavi.syadvaadii samutthita.h|</para>
  <para style="p">
    <verse number="9" style="v"/>kintu heroduvaaca yohana.h "siro.ahamachinadam idaanii.m yasyed.rkkarmma.naa.m vaarttaa.m praapnomi sa ka.h? atha sa ta.m dra.s.tum aicchat|</para>
  <para style="p">
    <verse number="10" style="v"/>anantara.m preritaa.h pratyaagatya yaani yaani karmmaa.ni cakrustaani yii"save kathayaamaasu.h tata.h sa taan baitsaidaanaamakanagarasya vijana.m sthaana.m niitvaa gupta.m jagaama|</para>
  <para style="p">
    <verse number="11" style="v"/>pa"scaal lokaastad viditvaa tasya pa"scaad yayu.h; tata.h sa taan nayan ii"svariiyaraajyasya prasa"ngamuktavaan, ye.saa.m cikitsayaa prayojanam aasiit taan svasthaan cakaara ca|</para>
  <para style="p">
    <verse number="12" style="v"/>apara nca divaavasanne sati dvaada"sa"si.syaa yii"sorantikam etya kathayaamaasu.h, vayamatra praantarasthaane ti.s.thaama.h, tato nagaraa.ni graamaa.ni gatvaa vaasasthaanaani praapya bhak.syadravyaa.ni kretu.m jananivaha.m bhavaan vis.rjatu|</para>
  <para style="p">
    <verse number="13" style="v"/>tadaa sa uvaaca, yuuyameva taan bhejayadhva.m; tataste procurasmaaka.m nika.te kevala.m pa nca puupaa dvau matsyau ca vidyante, ataeva sthaanaantaram itvaa nimittamete.saa.m bhak.syadravye.su na kriite.su na bhavati|</para>
  <para style="p">
    <verse number="14" style="v"/>tatra praaye.na pa ncasahasraa.ni puru.saa aasan|</para>
  <para style="p">
    <verse number="15" style="v"/>tadaa sa "si.syaan jagaada pa ncaa"sat pa ncaa"sajjanai.h pa.mktiik.rtya taanupave"sayata, tasmaat te tadanusaare.na sarvvalokaanupave"sayaapaasu.h|</para>
  <para style="p">
    <verse number="16" style="v"/>tata.h sa taan pa nca puupaan miinadvaya nca g.rhiitvaa svarga.m vilokye"svaragu.naan kiirttayaa ncakre bha"nktaa ca lokebhya.h parive.sa.naartha.m "si.sye.su samarpayaambabhuuva|</para>
  <para style="p">
    <verse number="17" style="v"/>tata.h sarvve bhuktvaa t.rpti.m gataa ava"si.s.taanaa nca dvaada"sa .dallakaan sa.mjag.rhu.h|</para>
  <para style="p">
    <verse number="18" style="v"/>athaikadaa nirjane "si.syai.h saha praarthanaakaale taan papraccha, lokaa maa.m ka.m vadanti?</para>
  <para style="p">
    <verse number="19" style="v"/>tataste praacu.h, tvaa.m yohanmajjaka.m vadanti; kecit tvaam eliya.m vadanti, puurvvakaalika.h ka"scid bhavi.syadvaadii "sma"saanaad udati.s.thad ityapi kecid vadanti|</para>
  <para style="p">
    <verse number="20" style="v"/>tadaa sa uvaaca, yuuya.m maa.m ka.m vadatha? tata.h pitara uktavaan tvam ii"svaraabhi.sikta.h puru.sa.h|</para>
  <para style="p">
    <verse number="21" style="v"/>tadaa sa taan d.r.dhamaadide"sa, kathaametaa.m kasmaicidapi maa kathayata|</para>
  <para style="p">
    <verse number="22" style="v"/>sa punaruvaaca, manu.syaputre.na vahuyaatanaa bhoktavyaa.h praaciinalokai.h pradhaanayaajakairadhyaapakai"sca sovaj naaya hantavya.h kintu t.rtiiyadivase "sma"saanaat tenotthaatavyam|</para>
  <para style="p">
    <verse number="23" style="v"/>apara.m sa sarvvaanuvaaca, ka"scid yadi mama pa"scaad gantu.m vaa nchati tarhi sa sva.m daamyatu, dine dine kru"sa.m g.rhiitvaa ca mama pa"scaadaagacchatu|</para>
  <para style="p">
    <verse number="24" style="v"/>yato ya.h ka"scit svapraa.naan rirak.si.sati sa taan haarayi.syati, ya.h ka"scin madartha.m praa.naan haarayi.syati sa taan rak.si.syati|</para>
  <para style="p">
    <verse number="25" style="v"/>ka"scid yadi sarvva.m jagat praapnoti kintu svapraa.naan haarayati svaya.m vina"syati ca tarhi tasya ko laabha.h?</para>
  <para style="p">
    <verse number="26" style="v"/>puna rya.h ka"scin maa.m mama vaakya.m vaa lajjaaspada.m jaanaati manu.syaputro yadaa svasya pitu"sca pavitraa.naa.m duutaanaa nca tejobhi.h parive.s.tita aagami.syati tadaa sopi ta.m lajjaaspada.m j naasyati|</para>
  <para style="p">
    <verse number="27" style="v"/>kintu yu.smaanaha.m yathaartha.m vadaami, ii"svariiyaraajatva.m na d.r.s.tavaa m.rtyu.m naasvaadi.syante, etaad.r"saa.h kiyanto lokaa atra sthane.api da.n.daayamaanaa.h santi|</para>
  <para style="p">
    <verse number="28" style="v"/>etadaakhyaanakathanaat para.m praaye.naa.s.tasu dine.su gate.su sa pitara.m yohana.m yaakuuba nca g.rhiitvaa praarthayitu.m parvvatameka.m samaaruroha|</para>
  <para style="p">
    <verse number="29" style="v"/>atha tasya praarthanakaale tasya mukhaak.rtiranyaruupaa jaataa, tadiiya.m vastramujjvala"sukla.m jaata.m|</para>
  <para style="p">
    <verse number="30" style="v"/>apara nca muusaa eliya"scobhau tejasvinau d.r.s.tau</para>
  <para style="p">
    <verse number="31" style="v"/>tau tena yiruu"saalampure yo m.rtyu.h saadhi.syate tadiiyaa.m kathaa.m tena saarddha.m kathayitum aarebhaate|</para>
  <para style="p">
    <verse number="32" style="v"/>tadaa pitaraadaya.h svasya sa"ngino nidrayaak.r.s.taa aasan kintu jaagaritvaa tasya tejastena saarddham utti.s.thantau janau ca dad.r"su.h|</para>
  <para style="p">
    <verse number="33" style="v"/>atha tayorubhayo rgamanakaale pitaro yii"su.m babhaa.se, he guro.asmaaka.m sthaane.asmin sthiti.h "subhaa, tata ekaa tvadarthaa, ekaa muusaarthaa, ekaa eliyaarthaa, iti tisra.h ku.tyosmaabhi rnirmmiiyantaa.m, imaa.m kathaa.m sa na vivicya kathayaamaasa|</para>
  <para style="p">
    <verse number="34" style="v"/>apara nca tadvaakyavadanakaale payoda eka aagatya te.saamupari chaayaa.m cakaara, tatastanmadhye tayo.h prave"saat te "sa"sa"nkire|</para>
  <para style="p">
    <verse number="35" style="v"/>tadaa tasmaat payodaad iyamaakaa"siiyaa vaa.nii nirjagaama, mamaaya.m priya.h putra etasya kathaayaa.m mano nidhatta|</para>
  <para style="p">
    <verse number="36" style="v"/>iti "sabde jaate te yii"sumekaakina.m dad.r"su.h kintu te tadaanii.m tasya dar"sanasya vaacamekaamapi noktvaa mana.hsu sthaapayaamaasu.h|</para>
  <para style="p">
    <verse number="37" style="v"/>pare.ahani te.su tasmaacchailaad avaruu.dhe.su ta.m saak.saat karttu.m bahavo lokaa aajagmu.h|</para>
  <para style="p">
    <verse number="38" style="v"/>te.saa.m madhyaad eko jana uccairuvaaca, he guro aha.m vinaya.m karomi mama putra.m prati k.rpaad.r.s.ti.m karotu, mama sa evaika.h putra.h|</para>
  <para style="p">
    <verse number="39" style="v"/>bhuutena dh.rta.h san sa.m prasabha.m ciicchabda.m karoti tanmukhaat phe.naa nirgacchanti ca, bhuuta ittha.m vidaaryya kli.s.tvaa praaya"sasta.m na tyajati|</para>
  <para style="p">
    <verse number="40" style="v"/>tasmaat ta.m bhuuta.m tyaajayitu.m tava "si.syasamiipe nyavedaya.m kintu te na "seku.h|</para>
  <para style="p">
    <verse number="41" style="v"/>tadaa yii"suravaadiit, re aavi"svaasin vipathagaamin va.m"sa katikaalaan yu.smaabhi.h saha sthaasyaamyaha.m yu.smaakam aacara.naani ca sahi.sye? tava putramihaanaya|</para>
  <para style="p">
    <verse number="42" style="v"/>tatastasminnaagatamaatre bhuutasta.m bhuumau paatayitvaa vidadaara; tadaa yii"sustamamedhya.m bhuuta.m tarjayitvaa baalaka.m svastha.m k.rtvaa tasya pitari samarpayaamaasa|</para>
  <para style="p">
    <verse number="43" style="v"/>ii"svarasya mahaa"saktim imaa.m vilokya sarvve camaccakru.h; ittha.m yii"so.h sarvvaabhi.h kriyaabhi.h sarvvairlokairaa"scaryye manyamaane sati sa "si.syaan babhaa.se,</para>
  <para style="p">
    <verse number="44" style="v"/>katheya.m yu.smaaka.m kar.ne.su pravi"satu, manu.syaputro manu.syaa.naa.m kare.su samarpayi.syate|</para>
  <para style="p">
    <verse number="45" style="v"/>kintu te taa.m kathaa.m na bubudhire, spa.s.tatvaabhaavaat tasyaa abhipraayaste.saa.m bodhagamyo na babhuuva; tasyaa aa"saya.h ka ityapi te bhayaat pra.s.tu.m na "seku.h|</para>
  <para style="p">
    <verse number="46" style="v"/>tadanantara.m te.saa.m madhye ka.h "sre.s.tha.h kathaametaa.m g.rhiitvaa te mitho vivaada.m cakru.h|</para>
  <para style="p">
    <verse number="47" style="v"/>tato yii"suste.saa.m manobhipraaya.m viditvaa baalakameka.m g.rhiitvaa svasya nika.te sthaapayitvaa taan jagaada,</para>
  <para style="p">
    <verse number="48" style="v"/>yo jano mama naamnaasya baalaasyaatithya.m vidadhaati sa mamaatithya.m vidadhaati, ya"sca mamaatithya.m vidadhaati sa mama prerakasyaatithya.m vidadhaati, yu.smaaka.m madhyeya.h sva.m sarvvasmaat k.sudra.m jaaniite sa eva "sre.s.tho bhavi.syati|</para>
  <para style="p">
    <verse number="49" style="v"/>apara nca yohan vyaajahaara he prabheा tava naamnaa bhuutaan tyaajayanta.m maanu.sam eka.m d.r.s.tavanto vaya.m, kintvasmaakam apa"scaad gaamitvaat ta.m nya.sedhaam| tadaanii.m yii"suruvaaca,</para>
  <para style="p">
    <verse number="50" style="v"/>ta.m maa ni.sedhata, yato yo janosmaaka.m na vipak.sa.h sa evaasmaaka.m sapak.so bhavati|</para>
  <para style="p">
    <verse number="51" style="v"/>anantara.m tasyaaroha.nasamaya upasthite sa sthiracetaa yiruu"saalama.m prati yaatraa.m karttu.m ni"scityaagre duutaan pre.sayaamaasa|</para>
  <para style="p">
    <verse number="52" style="v"/>tasmaat te gatvaa tasya prayojaniiyadravyaa.ni sa.mgrahiitu.m "somiro.niiyaanaa.m graama.m pravivi"su.h|</para>
  <para style="p">
    <verse number="53" style="v"/>kintu sa yiruu"saalama.m nagara.m yaati tato heto rlokaastasyaatithya.m na cakru.h|</para>
  <para style="p">
    <verse number="54" style="v"/>ataeva yaakuubyohanau tasya "si.syau tad d.r.s.tvaa jagadatu.h, he prabho eliyo yathaa cakaara tathaa vayamapi ki.m gaga.naad aagantum etaan bhasmiikarttu nca vahnimaaj naapayaama.h? bhavaan kimicchati?</para>
  <para style="p">
    <verse number="55" style="v"/>kintu sa mukha.m paraavartya taan tarjayitvaa gaditavaan yu.smaaka.m manobhaava.h ka.h, iti yuuya.m na jaaniitha|</para>
  <para style="p">
    <verse number="56" style="v"/>manujasuto manujaanaa.m praa.naan naa"sayitu.m naagacchat, kintu rak.situm aagacchat| pa"scaad itaragraama.m te yayu.h|</para>
  <para style="p">
    <verse number="57" style="v"/>tadanantara.m pathi gamanakaale jana ekasta.m babhaa.se, he prabho bhavaan yatra yaati bhavataa sahaahamapi tatra yaasyaami|</para>
  <para style="p">
    <verse number="58" style="v"/>tadaanii.m yii"sustamuvaaca, gomaayuunaa.m garttaa aasate, vihaayasiiyavihagaaाnaa.m nii.daani ca santi, kintu maanavatanayasya "sira.h sthaapayitu.m sthaana.m naasti|</para>
  <para style="p">
    <verse number="59" style="v"/>tata.h para.m sa itarajana.m jagaada, tva.m mama pa"scaad ehi; tata.h sa uvaaca, he prabho puurvva.m pitara.m "sma"saane sthaapayitu.m maamaadi"satu|</para>
  <para style="p">
    <verse number="60" style="v"/>tadaa yii"suruvaaca, m.rtaa m.rtaan "sma"saane sthaapayantu kintu tva.m gatve"svariiyaraajyasya kathaa.m pracaaraya|</para>
  <para style="p">
    <verse number="61" style="v"/>tatonya.h kathayaamaasa, he prabho mayaapi bhavata.h pa"scaad ga.msyate, kintu puurvva.m mama nive"sanasya parijanaanaam anumati.m grahiitum ahamaadi"syai bhavataa|</para>
  <para style="p">
    <verse number="62" style="v"/>tadaanii.m yii"susta.m proktavaan, yo jano laa"ngale karamarpayitvaa pa"scaat pa"syati sa ii"svariiyaraajya.m naarhati|</para>
  <chapter number="10" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>tata.h para.m prabhuraparaan saptati"si.syaan niyujya svaya.m yaani nagaraa.ni yaani sthaanaani ca gami.syati taani nagaraa.ni taani sthaanaani ca prati dvau dvau janau prahitavaan|</para>
  <para style="p">
    <verse number="2" style="v"/>tebhya.h kathayaamaasa ca "sasyaani bahuuniiti satya.m kintu chedakaa alpe; tasmaaddheto.h "sasyak.setre chedakaan aparaanapi pre.sayitu.m k.setrasvaamina.m praarthayadhva.m|</para>
  <para style="p">
    <verse number="3" style="v"/>yuuya.m yaata, pa"syata, v.rkaa.naa.m madhye me.sa"saavakaaniva yu.smaan prahi.nomi|</para>
  <para style="p">
    <verse number="4" style="v"/>yuuya.m k.sudra.m mahad vaa vasanasampu.taka.m paadukaa"sca maa g.rhliita, maargamadhye kamapi maa namata ca|</para>
  <para style="p">
    <verse number="5" style="v"/>apara nca yuuya.m yad yat nive"sana.m pravi"satha tatra nive"sanasyaasya ma"ngala.m bhuuyaaditi vaakya.m prathama.m vadata|</para>
  <para style="p">
    <verse number="6" style="v"/>tasmaat tasmin nive"sane yadi ma"ngalapaatra.m sthaasyati tarhi tanma"ngala.m tasya bhavi.syati, nocet yu.smaan prati paraavartti.syate|</para>
  <para style="p">
    <verse number="7" style="v"/>apara nca te yatki ncid daasyanti tadeva bhuktvaa piitvaa tasminnive"sane sthaasyatha; yata.h karmmakaarii jano bh.rtim arhati; g.rhaad g.rha.m maa yaasyatha|</para>
  <para style="p">
    <verse number="8" style="v"/>anyacca yu.smaasu kimapi nagara.m pravi.s.te.su lokaa yadi yu.smaakam aatithya.m kari.syanti, tarhi yat khaadyam upasthaasyanti tadeva khaadi.syatha|</para>
  <para style="p">
    <verse number="9" style="v"/>tannagarasthaan rogi.na.h svasthaan kari.syatha, ii"svariiya.m raajya.m yu.smaakam antikam aagamat kathaametaa nca pracaarayi.syatha|</para>
  <para style="p">
    <verse number="10" style="v"/>kintu kimapi pura.m yu.smaasu pravi.s.te.su lokaa yadi yu.smaakam aatithya.m na kari.syanti, tarhi tasya nagarasya panthaana.m gatvaa kathaametaa.m vadi.syatha,</para>
  <para style="p">
    <verse number="11" style="v"/>yu.smaaka.m nagariiyaa yaa dhuulyo.asmaasu samalagan taa api yu.smaaka.m praatikuulyena saak.syaartha.m sampaatayaama.h; tathaapii"svararaajya.m yu.smaaka.m samiipam aagatam iti ni"scita.m jaaniita|</para>
  <para style="p">
    <verse number="12" style="v"/>aha.m yu.smabhya.m yathaartha.m kathayaami, vicaaradine tasya nagarasya da"saata.h sidomo da"saa sahyaa bhavi.syati|</para>
  <para style="p">
    <verse number="13" style="v"/>haa haa koraasiin nagara, haa haa baitsaidaanagara yuvayormadhye yaad.r"saani aa"scaryyaa.ni karmmaa.nyakriyanta, taani karmmaa.ni yadi sorasiidono rnagarayorakaari.syanta, tadaa ito bahudinapuurvva.m tannivaasina.h "sa.navastraa.ni paridhaaya gaatre.su bhasma vilipya samupavi"sya samakhetsyanta|</para>
  <para style="p">
    <verse number="14" style="v"/>ato vicaaradivase yu.smaaka.m da"saata.h sorasiidonnivaasinaa.m da"saa sahyaa bhavi.syati|</para>
  <para style="p">
    <verse number="15" style="v"/>he kapharnaahuum, tva.m svarga.m yaavad unnataa kintu naraka.m yaavat nyagbhavi.syasi|</para>
  <para style="p">
    <verse number="16" style="v"/>yo jano yu.smaaka.m vaakya.m g.rhlaati sa mamaiva vaakya.m g.rhlaati; ki nca yo jano yu.smaakam avaj naa.m karoti sa mamaivaavaj naa.m karoti; yo jano mamaavaj naa.m karoti ca sa matprerakasyaivaavaj naa.m karoti|</para>
  <para style="p">
    <verse number="17" style="v"/>atha te saptati"si.syaa aanandena pratyaagatya kathayaamaasu.h, he prabho bhavato naamnaa bhuutaa apyasmaaka.m va"siibhavanti|</para>
  <para style="p">
    <verse number="18" style="v"/>tadaanii.m sa taan jagaada, vidyutamiva svargaat patanta.m "saitaanam adar"sam|</para>
  <para style="p">
    <verse number="19" style="v"/>pa"syata sarpaan v.r"scikaan ripo.h sarvvaparaakramaa.m"sca padatalai rdalayitu.m yu.smabhya.m "sakti.m dadaami tasmaad yu.smaaka.m kaapi haani rna bhavi.syati|</para>
  <para style="p">
    <verse number="20" style="v"/>bhuutaa yu.smaaka.m va"siibhavanti, etannimittat maa samullasata, svarge yu.smaaka.m naamaani likhitaani santiiti nimitta.m samullasata|</para>
  <para style="p">
    <verse number="21" style="v"/>tadgha.tikaayaa.m yii"su rmanasi jaataahlaada.h kathayaamaasa he svargap.rthivyorekaadhipate pitastva.m j naanavataa.m vidu.saa nca lokaanaa.m purastaat sarvvametad aprakaa"sya baalakaanaa.m purastaat praakaa"saya etasmaaddhetostvaa.m dhanya.m vadaami, he pitarittha.m bhavatu yad etadeva tava gocara uttamam|</para>
  <para style="p">
    <verse number="22" style="v"/>pitraa sarvvaa.ni mayi samarpitaani pitara.m vinaa kopi putra.m na jaanaati ki nca putra.m vinaa yasmai janaaya putrasta.m prakaa"sitavaan ta nca vinaa kopi pitara.m na jaanaati|</para>
  <para style="p">
    <verse number="23" style="v"/>tapa.h para.m sa "si.syaan prati paraav.rtya gupta.m jagaada, yuuyametaani sarvvaa.ni pa"syatha tato yu.smaaka.m cak.suu.m.si dhanyaani|</para>
  <para style="p">
    <verse number="24" style="v"/>yu.smaanaha.m vadaami, yuuya.m yaani sarvvaa.ni pa"syatha taani bahavo bhavi.syadvaadino bhuupataya"sca dra.s.tumicchantopi dra.s.tu.m na praapnuvan, yu.smaabhi ryaa yaa.h kathaa"sca "sruuyante taa.h "srotumicchantopi "srotu.m naalabhanta|</para>
  <para style="p">
    <verse number="25" style="v"/>anantaram eko vyavasthaapaka utthaaya ta.m pariik.situ.m papraccha, he upade"saka anantaayu.sa.h praaptaye mayaa ki.m kara.niiya.m?</para>
  <para style="p">
    <verse number="26" style="v"/>yii"su.h pratyuvaaca, atraarthe vyavasthaayaa.m ki.m likhitamasti? tva.m kiid.rk pa.thasi?</para>
  <para style="p">
    <verse number="27" style="v"/>tata.h sovadat, tva.m sarvvaanta.hkara.nai.h sarvvapraa.nai.h sarvva"saktibhi.h sarvvacittai"sca prabhau parame"svare prema kuru, samiipavaasini svavat prema kuru ca|</para>
  <para style="p">
    <verse number="28" style="v"/>tadaa sa kathayaamaasa, tva.m yathaartha.m pratyavoca.h, ittham aacara tenaiva jiivi.syasi|</para>
  <para style="p">
    <verse number="29" style="v"/>kintu sa jana.h sva.m nirddo.sa.m j naapayitu.m yii"su.m papraccha, mama samiipavaasii ka.h? tato yii"su.h pratyuvaaca,</para>
  <para style="p">
    <verse number="30" style="v"/>eko jano yiruu"saalampuraad yiriihopura.m yaati, etarhi dasyuunaa.m kare.su patite te tasya vastraadika.m h.rtavanta.h tamaahatya m.rtapraaya.m k.rtvaa tyaktvaa yayu.h|</para>
  <para style="p">
    <verse number="31" style="v"/>akasmaad eko yaajakastena maarge.na gacchan ta.m d.r.s.tvaa maargaanyapaar"svena jagaama|</para>
  <para style="p">
    <verse number="32" style="v"/>ittham eko leviiyastatsthaana.m praapya tasyaantika.m gatvaa ta.m vilokyaanyena paar"svena jagaama|</para>
  <para style="p">
    <verse number="33" style="v"/>kintveka.h "somiro.niiyo gacchan tatsthaana.m praapya ta.m d.r.s.tvaadayata|</para>
  <para style="p">
    <verse number="34" style="v"/>tasyaantika.m gatvaa tasya k.sate.su taila.m draak.saarasa nca prak.sipya k.sataani baddhvaa nijavaahanopari tamupave"sya pravaasiiyag.rham aaniiya ta.m si.seve|</para>
  <para style="p">
    <verse number="35" style="v"/>parasmin divase nijagamanakaale dvau mudraapaadau tadg.rhasvaamine dattvaavadat janamena.m sevasva tatra yo.adhiko vyayo bhavi.syati tamaha.m punaraagamanakaale pari"sotsyaami|</para>
  <para style="p">
    <verse number="36" style="v"/>e.saa.m trayaa.naa.m madhye tasya dasyuhastapatitasya janasya samiipavaasii ka.h? tvayaa ki.m budhyate?</para>
  <para style="p">
    <verse number="37" style="v"/>tata.h sa vyavasthaapaka.h kathayaamaasa yastasmin dayaa.m cakaara| tadaa yii"su.h kathayaamaasa tvamapi gatvaa tathaacara|</para>
  <para style="p">
    <verse number="38" style="v"/>tata.h para.m te gacchanta eka.m graama.m pravivi"su.h; tadaa marthaanaamaa strii svag.rhe tasyaatithya.m cakaara|</para>
  <para style="p">
    <verse number="39" style="v"/>tasmaat mariyam naamadheyaa tasyaa bhaginii yii"so.h padasamiipa uvavi"sya tasyopade"sakathaa.m "srotumaarebhe|</para>
  <para style="p">
    <verse number="40" style="v"/>kintu marthaa naanaaparicaryyaayaa.m vyagraa babhuuva tasmaaddhetostasya samiipamaagatya babhaa.se; he prabho mama bhaginii kevala.m mamopari sarvvakarmma.naa.m bhaaram arpitavatii tatra bhavataa ki ncidapi na mano nidhiiyate kim? mama saahaayya.m karttu.m bhavaan taamaadi"satu|</para>
  <para style="p">
    <verse number="41" style="v"/>tato yii"su.h pratyuvaaca he marthe he marthe, tva.m naanaakaaryye.su cintitavatii vyagraa caasi,</para>
  <para style="p">
    <verse number="42" style="v"/>kintu prayojaniiyam ekamaatram aaste| apara nca yamuttama.m bhaaga.m kopi harttu.m na "saknoti saeva mariyamaa v.rta.h|</para>
  <chapter number="11" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>anantara.m sa kasmi.m"scit sthaane praarthayata tatsamaaptau satyaa.m tasyaika.h "si.syasta.m jagaada he prabho yohan yathaa sva"si.syaan praarthayitum upadi.s.tavaan tathaa bhavaanapyasmaan upadi"satu|</para>
  <para style="p">
    <verse number="2" style="v"/>tasmaat sa kathayaamaasa, praarthanakaale yuuyam ittha.m kathayadhva.m, he asmaaka.m svargasthapitastava naama puujya.m bhavatu; tava raajatva.m bhavatu; svarge yathaa tathaa p.rthivyaamapi tavecchayaa sarvva.m bhavatu|</para>
  <para style="p">
    <verse number="3" style="v"/>pratyaham asmaaka.m prayojaniiya.m bhojya.m dehi|</para>
  <para style="p">
    <verse number="4" style="v"/>yathaa vaya.m sarvvaan aparaadhina.h k.samaamahe tathaa tvamapi paapaanyasmaaka.m k.samasva| asmaan pariik.saa.m maanaya kintu paapaatmano rak.sa|</para>
  <para style="p">
    <verse number="5" style="v"/>pa"scaat soparamapi kathitavaan yadi yu.smaaka.m kasyacid bandhusti.s.thati ni"siithe ca tasya samiipa.m sa gatvaa vadati,</para>
  <para style="p">
    <verse number="6" style="v"/>he bandho pathika eko bandhu rmama nive"sanam aayaata.h kintu tasyaatithya.m karttu.m mamaantike kimapi naasti, ataeva puupatraya.m mahyam .r.na.m dehi;</para>
  <para style="p">
    <verse number="7" style="v"/>tadaa sa yadi g.rhamadhyaat prativadati maa.m maa kli"saana, idaanii.m dvaara.m ruddha.m "sayane mayaa saha baalakaa"sca ti.s.thanti tubhya.m daatum utthaatu.m na "saknomi,</para>
  <para style="p">
    <verse number="8" style="v"/>tarhi yu.smaanaha.m vadaami, sa yadi mitratayaa tasmai kimapi daatu.m notti.s.thati tathaapi vaara.m vaara.m praarthanaata utthaapita.h san yasmin tasya prayojana.m tadeva daasyati|</para>
  <para style="p">
    <verse number="9" style="v"/>ata.h kaara.naat kathayaami, yaacadhva.m tato yu.smabhya.m daasyate, m.rgayadhva.m tata udde"sa.m praapsyatha, dvaaram aahata tato yu.smabhya.m dvaara.m mok.syate|</para>
  <para style="p">
    <verse number="10" style="v"/>yo yaacate sa praapnoti, yo m.rgayate sa evodde"sa.m praapnoti, yo dvaaram aahanti tadartha.m dvaara.m mocyate|</para>
  <para style="p">
    <verse number="11" style="v"/>putre.na puupe yaacite tasmai paa.saa.na.m dadaati vaa matsye yaacite tasmai sarpa.m dadaati</para>
  <para style="p">
    <verse number="12" style="v"/>vaa a.n.de yaacite tasmai v.r"scika.m dadaati yu.smaaka.m madhye ka etaad.r"sa.h pitaaste?</para>
  <para style="p">
    <verse number="13" style="v"/>tasmaadeva yuuyamabhadraa api yadi svasvabaalakebhya uttamaani dravyaa.ni daatu.m jaaniitha tarhyasmaaka.m svargastha.h pitaa nijayaacakebhya.h ki.m pavitram aatmaana.m na daasyati?</para>
  <para style="p">
    <verse number="14" style="v"/>anantara.m yii"sunaa kasmaaccid ekasmin muukabhuute tyaajite sati sa bhuutatyakto maanu.so vaakya.m vaktum aarebhe; tato lokaa.h sakalaa aa"scaryya.m menire|</para>
  <para style="p">
    <verse number="15" style="v"/>kintu te.saa.m keciduucu rjanoya.m baalasibuubaa arthaad bhuutaraajena bhuutaan tyaajayati|</para>
  <para style="p">
    <verse number="16" style="v"/>ta.m pariik.situ.m kecid aakaa"siiyam eka.m cihna.m dar"sayitu.m ta.m praarthayaa ncakrire|</para>
  <para style="p">
    <verse number="17" style="v"/>tadaa sa te.saa.m mana.hkalpanaa.m j naatvaa kathayaamaasa, kasyacid raajyasya lokaa yadi paraspara.m virundhanti tarhi tad raajyam na"syati; kecid g.rhasthaa yadi paraspara.m virundhanti tarhi tepi na"syanti|</para>
  <para style="p">
    <verse number="18" style="v"/>tathaiva "saitaanapi svalokaan yadi viru.naddhi tadaa tasya raajya.m katha.m sthaasyati? baalasibuubaaha.m bhuutaan tyaajayaami yuuyamiti vadatha|</para>
  <para style="p">
    <verse number="19" style="v"/>yadyaha.m baalasibuubaa bhuutaan tyaajayaami tarhi yu.smaaka.m santaanaa.h kena tyaajayanti? tasmaat taeva kathaayaa etasyaa vicaarayitaaro bhavi.syanti|</para>
  <para style="p">
    <verse number="20" style="v"/>kintu yadyaham ii"svarasya paraakrame.na bhuutaan tyaajayaami tarhi yu.smaaka.m nika.tam ii"svarasya raajyamava"syam upati.s.thati|</para>
  <para style="p">
    <verse number="21" style="v"/>balavaan pumaan susajjamaano yatikaala.m nijaa.t.taalikaa.m rak.sati tatikaala.m tasya dravya.m nirupadrava.m ti.s.thati|</para>
  <para style="p">
    <verse number="22" style="v"/>kintu tasmaad adhikabala.h ka"scidaagatya yadi ta.m jayati tarhi ye.su "sastraastre.su tasya vi"svaasa aasiit taani sarvvaa.ni h.rtvaa tasya dravyaa.ni g.rhlaati|</para>
  <para style="p">
    <verse number="23" style="v"/>ata.h kaara.naad yo mama sapak.so na sa vipak.sa.h, yo mayaa saha na sa.mg.rhlaati sa vikirati|</para>
  <para style="p">
    <verse number="24" style="v"/>apara nca amedhyabhuuto maanu.sasyaantarnirgatya "su.skasthaane bhraantvaa vi"sraama.m m.rgayate kintu na praapya vadati mama yasmaad g.rhaad aagatoha.m punastad g.rha.m paraav.rtya yaami|</para>
  <para style="p">
    <verse number="25" style="v"/>tato gatvaa tad g.rha.m maarjita.m "sobhita nca d.r.s.tvaa</para>
  <para style="p">
    <verse number="26" style="v"/>tatk.sa.nam apagatya svasmaadapi durmmatiin aparaan saptabhuutaan sahaanayati te ca tadg.rha.m pavi"sya nivasanti| tasmaat tasya manu.syasya prathamada"saata.h "se.sada"saa du.hkhataraa bhavati|</para>
  <para style="p">
    <verse number="27" style="v"/>asyaa.h kathaayaa.h kathanakaale janataamadhyasthaa kaacinnaarii tamuccai.hsvara.m provaaca, yaa yo.sit tvaa.m garbbhe.adhaarayat stanyamapaayayacca saiva dhanyaa|</para>
  <para style="p">
    <verse number="28" style="v"/>kintu sokathayat ye parame"svarasya kathaa.m "srutvaa tadanuruupam aacaranti taeva dhanyaa.h|</para>
  <para style="p">
    <verse number="29" style="v"/>tata.h para.m tasyaantike bahulokaanaa.m samaagame jaate sa vaktumaarebhe, aadhunikaa du.s.talokaa"scihna.m dra.s.tumicchanti kintu yuunasbhavi.syadvaadina"scihna.m vinaanyat ki nciccihna.m taan na dar"sayi.syate|</para>
  <para style="p">
    <verse number="30" style="v"/>yuunas tu yathaa niiniviiyalokaanaa.m samiipe cihnaruupobhavat tathaa vidyamaanalokaanaam e.saa.m samiipe manu.syaputropi cihnaruupo bhavi.syati|</para>
  <para style="p">
    <verse number="31" style="v"/>vicaarasamaye idaaniintanalokaanaa.m praatikuulyena dak.si.nade"siiyaa raaj nii protthaaya taan do.si.na.h kari.syati, yata.h saa raaj nii sulemaana upade"sakathaa.m "srotu.m p.rthivyaa.h siimaata aagacchat kintu pa"syata sulemaanopi gurutara eko jano.asmin sthaane vidyate|</para>
  <para style="p">
    <verse number="32" style="v"/>apara nca vicaarasamaye niiniviiyalokaa api varttamaanakaalikaanaa.m lokaanaa.m vaipariityena protthaaya taan do.si.na.h kari.syanti, yato hetoste yuunaso vaakyaat cittaani parivarttayaamaasu.h kintu pa"syata yuunasotigurutara eko jano.asmin sthaane vidyate|</para>
  <para style="p">
    <verse number="33" style="v"/>pradiipa.m prajvaalya dro.nasyaadha.h kutraapi guptasthaane vaa kopi na sthaapayati kintu g.rhaprave"sibhyo diipti.m daata.m diipaadhaaroparyyeva sthaapayati|</para>
  <para style="p">
    <verse number="34" style="v"/>dehasya pradiipa"scak.sustasmaadeva cak.su ryadi prasanna.m bhavati tarhi tava sarvva"sariira.m diiptimad bhavi.syati kintu cak.su ryadi maliimasa.m ti.s.thati tarhi sarvva"sariira.m saandhakaara.m sthaasyati|</para>
  <para style="p">
    <verse number="35" style="v"/>asmaat kaara.naat tavaanta.hstha.m jyoti ryathaandhakaaramaya.m na bhavati tadarthe saavadhaano bhava|</para>
  <para style="p">
    <verse number="36" style="v"/>yata.h "sariirasya kutraapya.m"se saandhakaare na jaate sarvva.m yadi diiptimat ti.s.thati tarhi tubhya.m diiptidaayiprojjvalan pradiipa iva tava savarva"sariira.m diiptimad bhavi.syati|</para>
  <para style="p">
    <verse number="37" style="v"/>etatkathaayaa.h kathanakaale phiru"syeko bhejanaaya ta.m nimantrayaamaasa, tata.h sa gatvaa bhoktum upavive"sa|</para>
  <para style="p">
    <verse number="38" style="v"/>kintu bhojanaat puurvva.m naamaa"nk.siit etad d.r.s.tvaa sa phiru"syaa"scaryya.m mene|</para>
  <para style="p">
    <verse number="39" style="v"/>tadaa prabhusta.m provaaca yuuya.m phiruu"silokaa.h paanapaatraa.naa.m bhojanapaatraa.naa nca bahi.h pari.skurutha kintu yu.smaakamanta rdauraatmyai rdu.skriyaabhi"sca paripuur.na.m ti.s.thati|</para>
  <para style="p">
    <verse number="40" style="v"/>he sarvve nirbodhaa yo bahi.h sasarja sa eva kimanta rna sasarja?</para>
  <para style="p">
    <verse number="41" style="v"/>tata eva yu.smaabhiranta.hkara.na.m (ii"svaraaya) nivedyataa.m tasmin k.rte yu.smaaka.m sarvvaa.ni "sucitaa.m yaasyanti|</para>
  <para style="p">
    <verse number="42" style="v"/>kintu hanta phiruu"siga.naa yuuya.m nyaayam ii"svare prema ca parityajya podinaayaa arudaadiinaa.m sarvve.saa.m "saakaanaa nca da"samaa.m"saan dattha kintu prathama.m paalayitvaa "se.sasyaala"nghana.m yu.smaakam ucitamaasiit|</para>
  <para style="p">
    <verse number="43" style="v"/>haa haa phiruu"sino yuuya.m bhajanagehe proccaasane aapa.ne.su ca namaskaare.su priiyadhve|</para>
  <para style="p">
    <verse number="44" style="v"/>vata kapa.tino.adhyaapakaa.h phiruu"sina"sca lokaayat "sma"saanam anupalabhya tadupari gacchanti yuuyam taad.rgaprakaa"sita"sma"saanavaad bhavatha|</para>
  <para style="p">
    <verse number="45" style="v"/>tadaanii.m vyavasthaapakaanaam ekaa yii"sumavadat, he upade"saka vaakyened.r"senaasmaasvapi do.sam aaropayasi|</para>
  <para style="p">
    <verse number="46" style="v"/>tata.h sa uvaaca, haa haa vyavasthaapakaa yuuyam maanu.saa.naam upari du.hsahyaan bhaaraan nyasyatha kintu svayam ekaa"nguुlyaapi taan bhaaraan na sp.r"satha|</para>
  <para style="p">
    <verse number="47" style="v"/>hanta yu.smaaka.m puurvvapuru.saa yaan bhavi.syadvaadino.avadhi.suste.saa.m "sma"saanaani yuuya.m nirmmaatha|</para>
  <para style="p">
    <verse number="48" style="v"/>tenaiva yuuya.m svapuurvvapuru.saa.naa.m karmmaa.ni sa.mmanyadhve tadeva sapramaa.na.m kurutha ca, yataste taanavadhi.su.h yuuya.m te.saa.m "sma"saanaani nirmmaatha|</para>
  <para style="p">
    <verse number="49" style="v"/>ataeva ii"svarasya "saastre proktamasti te.saamantike bhavi.syadvaadina.h preritaa.m"sca pre.sayi.syaami tataste te.saa.m kaa.m"scana hani.syanti kaa.m"scana taa.da"s.syinti|</para>
  <para style="p">
    <verse number="50" style="v"/>etasmaat kaara.naat haabila.h "so.nitapaatamaarabhya mandirayaj navedyo rmadhye hatasya sikhariyasya raktapaataparyyanta.m</para>
  <para style="p">
    <verse number="51" style="v"/>jagata.h s.r.s.timaarabhya p.rthivyaa.m bhavi.syadvaadinaa.m yatiraktapaataa jaataastatiinaam aparaadhada.n.daa e.saa.m varttamaanalokaanaa.m bhavi.syanti, yu.smaanaha.m ni"scita.m vadaami sarvve da.n.daa va.m"sasyaasya bhavi.syanti|</para>
  <para style="p">
    <verse number="52" style="v"/>haa haa vyavasthapakaa yuuya.m j naanasya ku ncikaa.m h.rtvaa svaya.m na pravi.s.taa ye prave.s.tu nca prayaasinastaanapi prave.s.tu.m vaaritavanta.h|</para>
  <para style="p">
    <verse number="53" style="v"/>ittha.m kathaakathanaad adhyaapakaa.h phiruu"sina"sca satarkaa.h</para>
  <para style="p">
    <verse number="54" style="v"/>santastamapavaditu.m tasya kathaayaa do.sa.m dharttamicchanto naanaakhyaanakathanaaya ta.m pravarttayitu.m kopayitu nca praarebhire|</para>
  <chapter number="12" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>tadaanii.m lokaa.h sahasra.m sahasram aagatya samupasthitaastata ekaiko .anye.saamupari patitum upacakrame; tadaa yii"su.h "si.syaan babhaa.se, yuuya.m phiruu"sinaa.m ki.nvaruupakaapa.tye vi"se.se.na saavadhaanaasti.s.thata|</para>
  <para style="p">
    <verse number="2" style="v"/>yato yanna prakaa"sayi.syate tadaacchanna.m vastu kimapi naasti; tathaa yanna j naasyate tad gupta.m vastu kimapi naasti|</para>
  <para style="p">
    <verse number="3" style="v"/>andhakaare ti.s.thanato yaa.h kathaa akathayata taa.h sarvvaa.h kathaa diiptau "sro.syante nirjane kar.ne ca yadakathayata g.rhap.r.s.thaat tat pracaarayi.syate|</para>
  <para style="p">
    <verse number="4" style="v"/>he bandhavo yu.smaanaha.m vadaami, ye "sariirasya naa"sa.m vinaa kimapyapara.m karttu.m na "sakruvanti tebhyo maa bhai.s.ta|</para>
  <para style="p">
    <verse number="5" style="v"/>tarhi kasmaad bhetavyam ityaha.m vadaami, ya.h "sariira.m naa"sayitvaa naraka.m nik.septu.m "saknoti tasmaadeva bhaya.m kuruta, punarapi vadaami tasmaadeva bhaya.m kuruta|</para>
  <para style="p">
    <verse number="6" style="v"/>pa nca ca.takapak.si.na.h ki.m dvaabhyaa.m taamrakha.n.daabhyaa.m na vikriiyante? tathaapii"svaraste.saam ekamapi na vismarati|</para>
  <para style="p">
    <verse number="7" style="v"/>yu.smaaka.m "sira.hke"saa api ga.nitaa.h santi tasmaat maa vibhiita bahuca.takapak.sibhyopi yuuya.m bahumuulyaa.h|</para>
  <para style="p">
    <verse number="8" style="v"/>apara.m yu.smabhya.m kathayaami ya.h ka"scin maanu.saa.naa.m saak.saan maa.m sviikaroti manu.syaputra ii"svaraduutaanaa.m saak.saat ta.m sviikari.syati|</para>
  <para style="p">
    <verse number="9" style="v"/>kintu ya.h ka"scinmaanu.saa.naa.m saak.saanmaam asviikaroti tam ii"svarasya duutaanaa.m saak.saad aham asviikari.syaami|</para>
  <para style="p">
    <verse number="10" style="v"/>anyacca ya.h ka"scin manujasutasya nindaabhaavena kaa ncit kathaa.m kathayati tasya tatpaapasya mocana.m bhavi.syati kintu yadi ka"scit pavitram aatmaana.m nindati tarhi tasya tatpaapasya mocana.m na bhavi.syati|</para>
  <para style="p">
    <verse number="11" style="v"/>yadaa lokaa yu.smaan bhajanageha.m vicaarakart.rraajyakart.r.naa.m sammukha nca ne.syanti tadaa kena prakaare.na kimuttara.m vadi.syatha ki.m kathayi.syatha cetyatra maa cintayata;</para>
  <para style="p">
    <verse number="12" style="v"/>yato yu.smaabhiryad yad vaktavya.m tat tasmin samayaeva pavitra aatmaa yu.smaan "sik.sayi.syati|</para>
  <para style="p">
    <verse number="13" style="v"/>tata.h para.m janataamadhyastha.h ka"scijjanasta.m jagaada he guro mayaa saha pait.rka.m dhana.m vibhaktu.m mama bhraataramaaj naapayatu bhavaan|</para>
  <para style="p">
    <verse number="14" style="v"/>kintu sa tamavadat he manu.sya yuvayo rvicaara.m vibhaaga nca karttu.m maa.m ko niyuktavaan?</para>
  <para style="p">
    <verse number="15" style="v"/>anantara.m sa lokaanavadat lobhe saavadhaanaa.h satarkaa"sca ti.s.thata, yato bahusampattipraaptyaa manu.syasyaayu rna bhavati|</para>
  <para style="p">
    <verse number="16" style="v"/>pa"scaad d.r.s.taantakathaamutthaapya kathayaamaasa, ekasya dhanino bhuumau bahuuni "sasyaani jaataani|</para>
  <para style="p">
    <verse number="17" style="v"/>tata.h sa manasaa cintayitvaa kathayaambabhuuva mamaitaani samutpannaani dravyaa.ni sthaapayitu.m sthaana.m naasti ki.m kari.syaami?</para>
  <para style="p">
    <verse number="18" style="v"/>tatovadad ittha.m kari.syaami, mama sarvvabhaa.n.daagaaraa.ni bha"nktvaa b.rhadbhaa.n.daagaaraa.ni nirmmaaya tanmadhye sarvvaphalaani dravyaa.ni ca sthaapayi.syaami|</para>
  <para style="p">
    <verse number="19" style="v"/>apara.m nijamano vadi.syaami, he mano bahuvatsaraartha.m naanaadravyaa.ni sa ncitaani santi vi"sraama.m kuru bhuktvaa piitvaa kautuka nca kuru| kintvii"svarastam avadat,</para>
  <para style="p">
    <verse number="20" style="v"/>re nirbodha adya raatrau tava praa.naastvatto ne.syante tata etaani yaani dravyaa.ni tvayaasaaditaani taani kasya bhavi.syanti?</para>
  <para style="p">
    <verse number="21" style="v"/>ataeva ya.h ka"scid ii"svarasya samiipe dhanasa ncayamak.rtvaa kevala.m svanika.te sa ncaya.m karoti sopi taad.r"sa.h|</para>
  <para style="p">
    <verse number="22" style="v"/>atha sa "si.syebhya.h kathayaamaasa, yu.smaanaha.m vadaami, ki.m khaadi.syaama.h? ki.m paridhaasyaama.h? ityuktvaa jiivanasya "sariirasya caartha.m cintaa.m maa kaar.s.ta|</para>
  <para style="p">
    <verse number="23" style="v"/>bhak.syaajjiivana.m bhuu.sa.naacchariira nca "sre.s.tha.m bhavati|</para>
  <para style="p">
    <verse number="24" style="v"/>kaakapak.si.naa.m kaaryya.m vicaarayata, te na vapanti "sasyaani ca na chindanti, te.saa.m bhaa.n.daagaaraa.ni na santi ko.saa"sca na santi, tathaapii"svarastebhyo bhak.syaa.ni dadaati, yuuya.m pak.sibhya.h "sre.s.thataraa na ki.m?</para>
  <para style="p">
    <verse number="25" style="v"/>apara nca bhaavayitvaa nijaayu.sa.h k.sa.namaatra.m varddhayitu.m "saknoti, etaad.r"so laako yu.smaaka.m madhye kosti?</para>
  <para style="p">
    <verse number="26" style="v"/>ataeva k.sudra.m kaaryya.m saadhayitum asamarthaa yuuyam anyasmin kaaryye kuto bhaavayatha?</para>
  <para style="p">
    <verse number="27" style="v"/>anyacca kaampilapu.spa.m katha.m varddhate tadaapi vicaarayata, tat ka ncana "srama.m na karoti tantuu.m"sca na janayati kintu yu.smabhya.m yathaartha.m kathayaami sulemaan bahvai"svaryyaanvitopi pu.spasyaasya sad.r"so vibhuu.sito naasiit|</para>
  <para style="p">
    <verse number="28" style="v"/>adya k.setre varttamaana.m "sva"scuullyaa.m k.sepsyamaana.m yat t.r.na.m, tasmai yadii"svara ittha.m bhuu.sayati tarhi he alpapratyayino yu.smaana ki.m na paridhaapayi.syati?</para>
  <para style="p">
    <verse number="29" style="v"/>ataeva ki.m khaadi.syaama.h? ki.m paridhaasyaama.h? etadartha.m maa ce.s.tadhva.m maa sa.mdigdhva nca|</para>
  <para style="p">
    <verse number="30" style="v"/>jagato devaarccakaa etaani sarvvaa.ni ce.s.tanate; e.su vastu.su yu.smaaka.m prayojanamaaste iti yu.smaaka.m pitaa jaanaati|</para>
  <para style="p">
    <verse number="31" style="v"/>ataeve"svarasya raajyaartha.m sace.s.taa bhavata tathaa k.rte sarvvaa.nyetaani dravyaa.ni yu.smabhya.m pradaayi.syante|</para>
  <para style="p">
    <verse number="32" style="v"/>he k.sudrame.savraja yuuya.m maa bhai.s.ta yu.smabhya.m raajya.m daatu.m yu.smaaka.m pitu.h sammatirasti|</para>
  <para style="p">
    <verse number="33" style="v"/>ataeva yu.smaaka.m yaa yaa sampattirasti taa.m taa.m vikriiya vitarata, yat sthaana.m cauraa naagacchanti, kii.taa"sca na k.saayayanti taad.r"se svarge nijaartham ajare sampu.take .ak.saya.m dhana.m sa ncinuta ca;</para>
  <para style="p">
    <verse number="34" style="v"/>yato yatra yu.smaaka.m dhana.m varttate tatreva yu.smaaka.m mana.h|</para>
  <para style="p">
    <verse number="35" style="v"/>apara nca yuuya.m pradiipa.m jvaalayitvaa baddhaka.tayasti.s.thata;</para>
  <para style="p">
    <verse number="36" style="v"/>prabhu rvivaahaadaagatya yadaiva dvaaramaahanti tadaiva dvaara.m mocayitu.m yathaa bh.rtyaa apek.sya ti.s.thanti tathaa yuuyamapi ti.s.thata|</para>
  <para style="p">
    <verse number="37" style="v"/>yata.h prabhuraagatya yaan daasaan sacetanaan ti.s.thato drak.syati taeva dhanyaa.h; aha.m yu.smaan yathaartha.m vadaami prabhustaan bhojanaartham upave"sya svaya.m baddhaka.ti.h samiipametya parive.sayi.syati|</para>
  <para style="p">
    <verse number="38" style="v"/>yadi dvitiiye t.rtiiye vaa prahare samaagatya tathaiva pa"syati, tarhi taeva daasaa dhanyaa.h|</para>
  <para style="p">
    <verse number="39" style="v"/>apara nca kasmin k.sa.ne cauraa aagami.syanti iti yadi g.rhapati rj naatu.m "saknoti tadaava"sya.m jaagran nijag.rhe sandhi.m karttayitu.m vaarayati yuuyametad vitta|</para>
  <para style="p">
    <verse number="40" style="v"/>ataeva yuuyamapi sajjamaanaasti.s.thata yato yasmin k.sa.ne ta.m naaprek.sadhve tasminneva k.sa.ne manu.syaputra aagami.syati|</para>
  <para style="p">
    <verse number="41" style="v"/>tadaa pitara.h papraccha, he prabho bhavaan kimasmaan uddi"sya ki.m sarvvaan uddi"sya d.r.s.taantakathaamimaa.m vadati?</para>
  <para style="p">
    <verse number="42" style="v"/>tata.h prabhu.h provaaca, prabhu.h samucitakaale nijaparivaaraartha.m bhojyaparive.sa.naaya ya.m tatpade niyok.syati taad.r"so vi"svaasyo boddhaa karmmaadhii"sa.h kosti?</para>
  <para style="p">
    <verse number="43" style="v"/>prabhuraagatya yam etaad.r"se karmma.ni prav.rtta.m drak.syati saeva daaso dhanya.h|</para>
  <para style="p">
    <verse number="44" style="v"/>aha.m yu.smaan yathaartha.m vadaami sa ta.m nijasarvvasvasyaadhipati.m kari.syati|</para>
  <para style="p">
    <verse number="45" style="v"/>kintu prabhurvilambenaagami.syati, iti vicintya sa daaso yadi tadanyadaasiidaasaan praharttum bhoktu.m paatu.m maditu nca praarabhate,</para>
  <para style="p">
    <verse number="46" style="v"/>tarhi yadaa prabhu.m naapek.si.syate yasmin k.sa.ne so.acetana"sca sthaasyati tasminneva k.sa.ne tasya prabhuraagatya ta.m padabhra.s.ta.m k.rtvaa vi"svaasahiinai.h saha tasya a.m"sa.m niruupayi.syati|</para>
  <para style="p">
    <verse number="47" style="v"/>yo daasa.h prabheाraaj naa.m j naatvaapi sajjito na ti.s.thati tadaaj naanusaare.na ca kaaryya.m na karoti sonekaan prahaaraan praapsyati;</para>
  <para style="p">
    <verse number="48" style="v"/>kintu yo jano.aj naatvaa prahaaraarha.m karmma karoti solpaprahaaraan praapsyati| yato yasmai baahulyena datta.m tasmaadeva baahulyena grahii.syate, maanu.saa yasya nika.te bahu samarpayanti tasmaad bahu yaacante|</para>
  <para style="p">
    <verse number="49" style="v"/>aha.m p.rthivyaam anaikyaruupa.m vahni nik.septum aagatosmi, sa ced idaaniimeva prajvalati tatra mama kaa cintaa?</para>
  <para style="p">
    <verse number="50" style="v"/>kintu yena majjanenaaha.m magno bhavi.syaami yaavatkaala.m tasya siddhi rna bhavi.syati taavadaha.m katika.s.ta.m praapsyaami|</para>
  <para style="p">
    <verse number="51" style="v"/>melana.m karttu.m jagad aagatosmi yuuya.m kimittha.m bodhadhve? yu.smaan vadaami na tathaa, kintvaha.m melanaabhaava.m karttu.mm aagatosmi|</para>
  <para style="p">
    <verse number="52" style="v"/>yasmaadetatkaalamaarabhya ekatrasthaparijanaanaa.m madhye pa ncajanaa.h p.rthag bhuutvaa trayo janaa dvayorjanayo.h pratikuulaa dvau janau ca trayaa.naa.m janaanaa.m pratikuulau bhavi.syanti|</para>
  <para style="p">
    <verse number="53" style="v"/>pitaa putrasya vipak.sa.h putra"sca pitu rvipak.so bhavi.syati maataa kanyaayaa vipak.saa kanyaa ca maatu rvipak.saa bhavi.syati, tathaa "sva"sruurbadhvaa vipak.saa badhuu"sca "sva"srvaa vipak.saa bhavi.syati|</para>
  <para style="p">
    <verse number="54" style="v"/>sa lokebhyoparamapi kathayaamaasa, pa"scimadi"si meghodgama.m d.r.s.tvaa yuuya.m ha.thaad vadatha v.r.s.ti rbhavi.syati tatastathaiva jaayate|</para>
  <para style="p">
    <verse number="55" style="v"/>apara.m dak.si.nato vaayau vaati sati vadatha nidaagho bhavi.syati tata.h sopi jaayate|</para>
  <para style="p">
    <verse number="56" style="v"/>re re kapa.tina aakaa"sasya bhuumyaa"sca lak.sa.na.m boddhu.m "saknutha,</para>
  <para style="p">
    <verse number="57" style="v"/>kintu kaalasyaasya lak.sa.na.m kuto boddhu.m na "saknutha? yuuya nca svaya.m kuto na nyaa.sya.m vicaarayatha?</para>
  <para style="p">
    <verse number="58" style="v"/>apara nca vivaadinaa saarddha.m vicaarayitu.h samiipa.m gacchan pathi tasmaaduddhaara.m praaptu.m yatasva nocet sa tvaa.m dh.rtvaa vicaarayitu.h samiipa.m nayati| vicaarayitaa yadi tvaa.m praharttu.h samiipa.m samarpayati praharttaa tvaa.m kaaraayaa.m badhnaati</para>
  <para style="p">
    <verse number="59" style="v"/>tarhi tvaamaha.m vadaami tvayaa ni.h"se.sa.m kapardake.su na pari"sodhite.su tva.m tato mukti.m praaptu.m na "sak.syasi|</para>
  <chapter number="13" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>apara nca piilaato ye.saa.m gaaliiliiyaanaa.m raktaani baliinaa.m raktai.h sahaami"srayat te.saa.m gaaliiliiyaanaa.m v.rttaanta.m katipayajanaa upasthaapya yii"save kathayaamaasu.h|</para>
  <para style="p">
    <verse number="2" style="v"/>tata.h sa pratyuvaaca te.saa.m lokaanaam etaad.r"sii durgati rgha.titaa tatkaara.naad yuuya.m kimanyebhyo gaaliiliiyebhyopyadhikapaapinastaan bodhadhve?</para>
  <para style="p">
    <verse number="3" style="v"/>yu.smaanaha.m vadaami tathaa na kintu mana.hsu na paraavarttite.su yuuyamapi tathaa na.mk.syatha|</para>
  <para style="p">
    <verse number="4" style="v"/>apara nca "siilohanaamna uccag.rhasya patanaad ye.a.s.taada"sajanaa m.rtaaste yiruu"saalami nivaasisarvvalokebhyo.adhikaaparaadhina.h ki.m yuuyamitya.m bodhadhve?</para>
  <para style="p">
    <verse number="5" style="v"/>yu.smaanaha.m vadaami tathaa na kintu mana.hsu na parivarttite.su yuuyamapi tathaa na.mk.syatha|</para>
  <para style="p">
    <verse number="6" style="v"/>anantara.m sa imaa.m d.r.s.taantakathaamakathayad eko jano draak.saak.setramadhya ekamu.dumbarav.rk.sa.m ropitavaan| pa"scaat sa aagatya tasmin phalaani gave.sayaamaasa,</para>
  <para style="p">
    <verse number="7" style="v"/>kintu phalaapraapte.h kaara.naad udyaanakaara.m bh.rtya.m jagaada, pa"sya vatsaratraya.m yaavadaagatya etasminnu.dumbaratarau k.salaanyanvicchaami, kintu naikamapi prapnomi taruraya.m kuto v.rthaa sthaana.m vyaapya ti.s.thati? ena.m chindhi|</para>
  <para style="p">
    <verse number="8" style="v"/>tato bh.rtya.h pratyuvaaca, he prabho punarvar.sameka.m sthaatum aadi"sa; etasya muulasya caturdik.su khanitvaaham aalavaala.m sthaapayaami|</para>
  <para style="p">
    <verse number="9" style="v"/>tata.h phalitu.m "saknoti yadi na phalati tarhi pa"scaat chetsyasi|</para>
  <para style="p">
    <verse number="10" style="v"/>atha vi"sraamavaare bhajanagehe yii"surupadi"sati</para>
  <para style="p">
    <verse number="11" style="v"/>tasmit samaye bhuutagrastatvaat kubjiibhuuyaa.s.taada"savar.saa.ni yaavat kenaapyupaayena .rju rbhavitu.m na "saknoti yaa durbbalaa strii,</para>
  <para style="p">
    <verse number="12" style="v"/>taa.m tatropasthitaa.m vilokya yii"sustaamaahuuya kathitavaan he naari tava daurbbalyaat tva.m muktaa bhava|</para>
  <para style="p">
    <verse number="13" style="v"/>tata.h para.m tasyaa gaatre hastaarpa.namaatraat saa .rjurbhuutve"svarasya dhanyavaada.m karttumaarebhe|</para>
  <para style="p">
    <verse number="14" style="v"/>kintu vi"sraamavaare yii"sunaa tasyaa.h svaasthyakara.naad bhajanagehasyaadhipati.h prakupya lokaan uvaaca, .sa.tsu dine.su lokai.h karmma karttavya.m tasmaaddheto.h svaasthyaartha.m te.su dine.su aagacchata, vi"sraamavaare maagacchata|</para>
  <para style="p">
    <verse number="15" style="v"/>tadaa pabhu.h pratyuvaaca re kapa.tino yu.smaakam ekaiko jano vi"sraamavaare sviiya.m sviiya.m v.r.sabha.m gardabha.m vaa bandhanaanmocayitvaa jala.m paayayitu.m ki.m na nayati?</para>
  <para style="p">
    <verse number="16" style="v"/>tarhyaa.s.taada"savatsaraan yaavat "saitaanaa baddhaa ibraahiima.h santatiriya.m naarii ki.m vi"sraamavaare na mocayitavyaa?</para>
  <para style="p">
    <verse number="17" style="v"/>e.su vaakye.su kathite.su tasya vipak.saa.h salajjaa jaataa.h kintu tena k.rtasarvvamahaakarmmakaara.naat lokanivaha.h saanando.abhavat|</para>
  <para style="p">
    <verse number="18" style="v"/>anantara.m sovadad ii"svarasya raajya.m kasya sad.r"sa.m? kena tadupamaasyaami?</para>
  <para style="p">
    <verse number="19" style="v"/>yat sar.sapabiija.m g.rhiitvaa ka"scijjana udyaana uptavaan tad biijama"nkurita.m sat mahaav.rk.so.ajaayata, tatastasya "saakhaasu vihaayasiiyavihagaa aagatya nyuu.su.h, tadraajya.m taad.r"sena sar.sapabiijena tulya.m|</para>
  <para style="p">
    <verse number="20" style="v"/>puna.h kathayaamaasa, ii"svarasya raajya.m kasya sad.r"sa.m vadi.syaami? yat ki.nva.m kaacit strii g.rhiitvaa dro.natrayaparimitagodhuumacuur.ne.su sthaapayaamaasa,</para>
  <para style="p">
    <verse number="21" style="v"/>tata.h krame.na tat sarvvagodhuumacuur.na.m vyaapnoti, tasya ki.nvasya tulyam ii"svarasya raajya.m|</para>
  <para style="p">
    <verse number="22" style="v"/>tata.h sa yiruu"saalamnagara.m prati yaatraa.m k.rtvaa nagare nagare graame graame samupadi"san jagaama|</para>
  <para style="p">
    <verse number="23" style="v"/>tadaa ka"scijjanasta.m papraccha, he prabho ki.m kevalam alpe lokaa.h paritraasyante?</para>
  <para style="p">
    <verse number="24" style="v"/>tata.h sa lokaan uvaaca, sa.mkiir.nadvaare.na prave.s.tu.m yataghva.m, yatoha.m yu.smaan vadaami, bahava.h prave.s.tu.m ce.s.ti.syante kintu na "sak.syanti|</para>
  <para style="p">
    <verse number="25" style="v"/>g.rhapatinotthaaya dvaare ruddhe sati yadi yuuya.m bahi.h sthitvaa dvaaramaahatya vadatha, he prabho he prabho asmatkaara.naad dvaara.m mocayatu, tata.h sa iti prativak.syati, yuuya.m kutratyaa lokaa ityaha.m na jaanaami|</para>
  <para style="p">
    <verse number="26" style="v"/>tadaa yuuya.m vadi.syatha, tava saak.saad vaya.m bheाjana.m paana nca k.rtavanta.h, tva ncaasmaaka.m nagarasya pathi samupadi.s.tavaan|</para>
  <para style="p">
    <verse number="27" style="v"/>kintu sa vak.syati, yu.smaanaha.m vadaami, yuuya.m kutratyaa lokaa ityaha.m na jaanaami; he duraacaari.no yuuya.m matto duuriibhavata|</para>
  <para style="p">
    <verse number="28" style="v"/>tadaa ibraahiima.m ishaaka.m yaakuuba nca sarvvabhavi.syadvaadina"sca ii"svarasya raajya.m praaptaan svaa.m"sca bahi.sk.rtaan d.r.s.tvaa yuuya.m rodana.m dantairdantaghar.sa.na nca kari.syatha|</para>
  <para style="p">
    <verse number="29" style="v"/>apara nca puurvvapa"scimadak.si.nottaradigbhyo lokaa aagatya ii"svarasya raajye nivatsyanti|</para>
  <para style="p">
    <verse number="30" style="v"/>pa"syatettha.m "se.siiyaa lokaa agraa bhavi.syanti, agriiyaa lokaa"sca "se.saa bhavi.syanti|</para>
  <para style="p">
    <verse number="31" style="v"/>apara nca tasmin dine kiyanta.h phiruu"sina aagatya yii"su.m procu.h, bahirgaccha, sthaanaadasmaat prasthaana.m kuru, herod tvaa.m jighaa.msati|</para>
  <para style="p">
    <verse number="32" style="v"/>tata.h sa pratyavocat pa"syataadya "sva"sca bhuutaan vihaapya rogi.no.arogi.na.h k.rtvaa t.rtiiyehni setsyaami, kathaametaa.m yuuyamitvaa ta.m bhuurimaaya.m vadata|</para>
  <para style="p">
    <verse number="33" style="v"/>tatraapyadya "sva.h para"sva"sca mayaa gamanaagamane karttavye, yato heto ryiruu"saalamo bahi.h kutraapi kopi bhavi.syadvaadii na ghaani.syate|</para>
  <para style="p">
    <verse number="34" style="v"/>he yiruu"saalam he yiruu"saalam tva.m bhavi.syadvaadino ha.msi tavaantike preritaan prastarairmaarayasi ca, yathaa kukku.tii nijapak.saadha.h sva"saavakaan sa.mg.rhlaati, tathaahamapi tava "si"suun sa.mgrahiitu.m kativaaraan aiccha.m kintu tva.m naiccha.h|</para>
  <para style="p">
    <verse number="35" style="v"/>pa"syata yu.smaaka.m vaasasthaanaani procchidyamaanaani parityaktaani ca bhavi.syanti; yu.smaanaha.m yathaartha.m vadaami, ya.h prabho rnaamnaagacchati sa dhanya iti vaaca.m yaavatkaala.m na vadi.syatha, taavatkaala.m yuuya.m maa.m na drak.syatha|</para>
  <chapter number="14" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>anantara.m vi"sraamavaare yii"sau pradhaanasya phiruu"sino g.rhe bhoktu.m gatavati te ta.m viik.situm aarebhire|</para>
  <para style="p">
    <verse number="2" style="v"/>tadaa jalodarii tasya sammukhe sthita.h|</para>
  <para style="p">
    <verse number="3" style="v"/>tata.h sa vyavasthaapakaan phiruu"sina"sca papraccha, vi"sraamavaare svaasthya.m karttavya.m na vaa? tataste kimapi na pratyuucu.h|</para>
  <para style="p">
    <verse number="4" style="v"/>tadaa sa ta.m rogi.na.m svastha.m k.rtvaa visasarja;</para>
  <para style="p">
    <verse number="5" style="v"/>taanuvaaca ca yu.smaaka.m kasyacid garddabho v.r.sabho vaa ced gartte patati tarhi vi"sraamavaare tatk.sa.na.m sa ki.m ta.m notthaapayi.syati?</para>
  <para style="p">
    <verse number="6" style="v"/>tataste kathaayaa etasyaa.h kimapi prativaktu.m na "seku.h|</para>
  <para style="p">
    <verse number="7" style="v"/>apara nca pradhaanasthaanamanoniitatvakara.na.m vilokya sa nimantritaan etadupade"sakathaa.m jagaada,</para>
  <para style="p">
    <verse number="8" style="v"/>tva.m vivaahaadibhojye.su nimantrita.h san pradhaanasthaane mopaavek.sii.h| tvatto gauravaanvitanimantritajana aayaate</para>
  <para style="p">
    <verse number="9" style="v"/>nimantrayitaagatya manu.syaayaitasmai sthaana.m dehiiti vaakya.m ced vak.syati tarhi tva.m sa"nkucito bhuutvaa sthaana itarasmin upave.s.tum udya.msyasi|</para>
  <para style="p">
    <verse number="10" style="v"/>asmaat kaara.naadeva tva.m nimantrito gatvaa.apradhaanasthaana upavi"sa, tato nimantrayitaagatya vadi.syati, he bandho proccasthaana.m gatvopavi"sa, tathaa sati bhojanopavi.s.taanaa.m sakalaanaa.m saak.saat tva.m maanyo bhavi.syasi|</para>
  <para style="p">
    <verse number="11" style="v"/>ya.h ka"scit svamunnamayati sa namayi.syate, kintu ya.h ka"scit sva.m namayati sa unnamayi.syate|</para>
  <para style="p">
    <verse number="12" style="v"/>tadaa sa nimantrayitaara.m janamapi jagaada, madhyaahne raatrau vaa bhojye k.rte nijabandhuga.no vaa bhraat.rृga.no vaa j naatiga.no vaa dhaniga.no vaa samiipavaasiga.no vaa etaan na nimantraya, tathaa k.rte cet te tvaa.m nimantrayi.syanti, tarhi pari"sodho bhavi.syati|</para>
  <para style="p">
    <verse number="13" style="v"/>kintu yadaa bhejya.m karo.si tadaa daridra"su.skakarakha njaandhaan nimantraya,</para>
  <para style="p">
    <verse number="14" style="v"/>tata aa"si.sa.m lapsyase, te.su pari"sodha.m karttuma"saknuvatsu "sma"saanaaddhaarmmikaanaamutthaanakaale tva.m phalaa.m lapsyase|</para>
  <para style="p">
    <verse number="15" style="v"/>anantara.m taa.m kathaa.m ni"samya bhojanopavi.s.ta.h ka"scit kathayaamaasa, yo jana ii"svarasya raajye bhoktu.m lapsyate saeva dhanya.h|</para>
  <para style="p">
    <verse number="16" style="v"/>tata.h sa uvaaca, ka"scit jano raatrau bheाjya.m k.rtvaa bahuun nimantrayaamaasa|</para>
  <para style="p">
    <verse number="17" style="v"/>tato bhojanasamaye nimantritalokaan aahvaatu.m daasadvaaraa kathayaamaasa, khadyadravyaa.ni sarvvaa.ni samaasaaditaani santi, yuuyamaagacchata|</para>
  <para style="p">
    <verse number="18" style="v"/>kintu te sarvva ekaika.m chala.m k.rtvaa k.samaa.m praarthayaa ncakrire| prathamo jana.h kathayaamaasa, k.setrameka.m kriitavaanaha.m tadeva dra.s.tu.m mayaa gantavyam, ataeva maa.m k.santu.m ta.m nivedaya|</para>
  <para style="p">
    <verse number="19" style="v"/>anyo jana.h kathayaamaasa, da"sav.r.saanaha.m kriitavaan taan pariik.situ.m yaami tasmaadeva maa.m k.santu.m ta.m nivedaya|</para>
  <para style="p">
    <verse number="20" style="v"/>apara.h kathayaamaasa, vyuu.dhavaanaha.m tasmaat kaara.naad yaatu.m na "saknomi|</para>
  <para style="p">
    <verse number="21" style="v"/>pa"scaat sa daaso gatvaa nijaprabho.h saak.saat sarvvav.rttaanta.m nivedayaamaasa, tatosau g.rhapati.h kupitvaa svadaasa.m vyaajahaara, tva.m satvara.m nagarasya sannive"saan maargaa.m"sca gatvaa daridra"su.skakarakha njaandhaan atraanaya|</para>
  <para style="p">
    <verse number="22" style="v"/>tato daaso.avadat, he prabho bhavata aaj naanusaare.naakriyata tathaapi sthaanamasti|</para>
  <para style="p">
    <verse number="23" style="v"/>tadaa prabhu.h puna rdaasaayaakathayat, raajapathaan v.rk.samuulaani ca yaatvaa madiiyag.rhapuura.naartha.m lokaanaagantu.m pravarttaya|</para>
  <para style="p">
    <verse number="24" style="v"/>aha.m yu.smabhya.m kathayaami, puurvvanimantritaanamekopi mamaasya raatribhojyasyaasvaada.m na praapsyati|</para>
  <para style="p">
    <verse number="25" style="v"/>anantara.m bahu.su loke.su yii"so.h pa"scaad vrajite.su satsu sa vyaaghu.tya tebhya.h kathayaamaasa,</para>
  <para style="p">
    <verse number="26" style="v"/>ya.h ka"scin mama samiipam aagatya svasya maataa pitaa patnii santaanaa bhraataro bhagimyo nijapraa.naa"sca, etebhya.h sarvvebhyo mayyadhika.m prema na karoti, sa mama "si.syo bhavitu.m na "sak.syati|</para>
  <para style="p">
    <verse number="27" style="v"/>ya.h ka"scit sviiya.m kru"sa.m vahan mama pa"scaanna gacchati, sopi mama "si.syo bhavitu.m na "sak.syati|</para>
  <para style="p">
    <verse number="28" style="v"/>durganirmmaa.ne kativyayo bhavi.syati, tathaa tasya samaaptikara.naartha.m sampattirasti na vaa, prathamamupavi"sya etanna ga.nayati, yu.smaaka.m madhya etaad.r"sa.h kosti?</para>
  <para style="p">
    <verse number="29" style="v"/>noced bhitti.m k.rtvaa "se.se yadi samaapayitu.m na "sak.syati,</para>
  <para style="p">
    <verse number="30" style="v"/>tarhi maanu.soya.m nicetum aarabhata samaapayitu.m naa"saknot, iti vyaah.rtya sarvve tamupahasi.syanti|</para>
  <para style="p">
    <verse number="31" style="v"/>apara nca bhinnabhuupatinaa saha yuddha.m karttum udyamya da"sasahasraa.ni sainyaani g.rhiitvaa vi.m"satisahasre.h sainyai.h sahitasya samiipavaasina.h sammukha.m yaatu.m "sak.syaami na veti prathama.m upavi"sya na vicaarayati etaad.r"so bhuumipati.h ka.h?</para>
  <para style="p">
    <verse number="32" style="v"/>yadi na "saknoti tarhi ripaavatiduure ti.s.thati sati nijaduuta.m pre.sya sandhi.m karttu.m praarthayeta|</para>
  <para style="p">
    <verse number="33" style="v"/>tadvad yu.smaaka.m madhye ya.h ka"scin madartha.m sarvvasva.m haatu.m na "saknoti sa mama "si.syo bhavitu.m na "sak.syati|</para>
  <para style="p">
    <verse number="34" style="v"/>lava.nam uttamam iti satya.m, kintu yadi lava.nasya lava.natvam apagacchati tarhi tat katha.m svaaduyukta.m bhavi.syati?</para>
  <para style="p">
    <verse number="35" style="v"/>tada bhuumyartham aalavaalaraa"syarthamapi bhadra.m na bhavati; lokaastad bahi.h k.sipanti|yasya "srotu.m "srotre sta.h sa "s.r.notu|</para>
  <chapter number="15" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>tadaa karasa ncaayina.h paapina"sca lokaa upade"skathaa.m "srotu.m yii"so.h samiipam aagacchan|</para>
  <para style="p">
    <verse number="2" style="v"/>tata.h phiruu"sina upaadhyaayaa"sca vivadamaanaa.h kathayaamaasu.h e.sa maanu.sa.h paapibhi.h saha pra.naya.m k.rtvaa tai.h saarddha.m bhu.mkte|</para>
  <para style="p">
    <verse number="3" style="v"/>tadaa sa tebhya imaa.m d.r.s.taantakathaa.m kathitavaan,</para>
  <para style="p">
    <verse number="4" style="v"/>kasyacit "satame.se.su ti.s.thatmu te.saameka.m sa yadi haarayati tarhi madhyepraantaram ekona"satame.saan vihaaya haaritame.sasya udde"sapraaptiparyyanata.m na gave.sayati, etaad.r"so loko yu.smaaka.m madhye ka aaste?</para>
  <para style="p">
    <verse number="5" style="v"/>tasyodde"sa.m praapya h.r.s.tamanaasta.m skandhe nidhaaya svasthaanam aaniiya bandhubaandhavasamiipavaasina aahuuya vakti,</para>
  <para style="p">
    <verse number="6" style="v"/>haarita.m me.sa.m praaptoham ato heto rmayaa saarddham aanandata|</para>
  <para style="p">
    <verse number="7" style="v"/>tadvadaha.m yu.smaan vadaami, ye.saa.m mana.hparaavarttanasya prayojana.m naasti, taad.r"saikona"satadhaarmmikakaara.naad ya aanandastasmaad ekasya mana.hparivarttina.h paapina.h kaara.naat svarge .adhikaanando jaayate|</para>
  <para style="p">
    <verse number="8" style="v"/>apara nca da"saanaa.m ruupyakha.n.daanaam ekakha.n.de haarite pradiipa.m prajvaalya g.rha.m sammaarjya tasya praapti.m yaavad yatnena na gave.sayati, etaad.r"sii yo.sit kaaste?</para>
  <para style="p">
    <verse number="9" style="v"/>praapte sati bandhubaandhavasamiipavaasiniiraahuuya kathayati, haarita.m ruupyakha.n.da.m praaptaaha.m tasmaadeva mayaa saarddham aanandata|</para>
  <para style="p">
    <verse number="10" style="v"/>tadvadaha.m yu.smaan vyaaharaami, ekena paapinaa manasi parivarttite, ii"svarasya duutaanaa.m madhyepyaanando jaayate|</para>
  <para style="p">
    <verse number="11" style="v"/>apara nca sa kathayaamaasa, kasyacid dvau putraavaastaa.m,</para>
  <para style="p">
    <verse number="12" style="v"/>tayo.h kani.s.tha.h putra.h pitre kathayaamaasa, he pitastava sampattyaa yama.m"sa.m praapsyaamyaha.m vibhajya ta.m dehi, tata.h pitaa nijaa.m sampatti.m vibhajya taabhyaa.m dadau|</para>
  <para style="p">
    <verse number="13" style="v"/>katipayaat kaalaat para.m sa kani.s.thaputra.h samasta.m dhana.m sa.mg.rhya duurade"sa.m gatvaa du.s.taacara.nena sarvvaa.m sampatti.m naa"sayaamaasa|</para>
  <para style="p">
    <verse number="14" style="v"/>tasya sarvvadhane vyaya.m gate tadde"se mahaadurbhik.sa.m babhuuva, tatastasya dainyada"saa bhavitum aarebhe|</para>
  <para style="p">
    <verse number="15" style="v"/>tata.h para.m sa gatvaa tadde"siiya.m g.rhasthamekam aa"srayata; tata.h sata.m "suukaravraja.m caarayitu.m praantara.m pre.sayaamaasa|</para>
  <para style="p">
    <verse number="16" style="v"/>kenaapi tasmai bhak.syaadaanaat sa "suukaraphalavalkalena pici.n.dapuura.naa.m vavaa ncha|</para>
  <para style="p">
    <verse number="17" style="v"/>"se.se sa manasi cetanaa.m praapya kathayaamaasa, haa mama pitu.h samiipe kati kati vetanabhujo daasaa yathe.s.ta.m tatodhika nca bhak.sya.m praapnuvanti kintvaha.m k.sudhaa mumuur.su.h|</para>
  <para style="p">
    <verse number="18" style="v"/>ahamutthaaya pitu.h samiipa.m gatvaa kathaametaa.m vadi.syaami, he pitar ii"svarasya tava ca viruddha.m paapamakaravam</para>
  <para style="p">
    <verse number="19" style="v"/>tava putra_iti vikhyaato bhavitu.m na yogyosmi ca, maa.m tava vaitanika.m daasa.m k.rtvaa sthaapaya|</para>
  <para style="p">
    <verse number="20" style="v"/>pa"scaat sa utthaaya pitu.h samiipa.m jagaama; tatastasya pitaatiduure ta.m niriik.sya dayaa ncakre, dhaavitvaa tasya ka.n.tha.m g.rhiitvaa ta.m cucumba ca|</para>
  <para style="p">
    <verse number="21" style="v"/>tadaa putra uvaaca, he pitar ii"svarasya tava ca viruddha.m paapamakarava.m, tava putra_iti vikhyaato bhavitu.m na yogyosmi ca|</para>
  <para style="p">
    <verse number="22" style="v"/>kintu tasya pitaa nijadaasaan aadide"sa, sarvvottamavastraa.nyaaniiya paridhaapayataina.m haste caa"nguriiyakam arpayata paadayo"scopaanahau samarpayata;</para>
  <para style="p">
    <verse number="23" style="v"/>pu.s.ta.m govatsam aaniiya maarayata ca ta.m bhuktvaa vayam aanandaama|</para>
  <para style="p">
    <verse number="24" style="v"/>yato mama putroyam amriyata punarajiiviid haarita"sca labdhobhuut tatasta aananditum aarebhire|</para>
  <para style="p">
    <verse number="25" style="v"/>tatkaale tasya jye.s.tha.h putra.h k.setra aasiit| atha sa nive"sanasya nika.ta.m aagacchan n.rtyaanaa.m vaadyaanaa nca "sabda.m "srutvaa</para>
  <para style="p">
    <verse number="26" style="v"/>daasaanaam ekam aahuuya papraccha, ki.m kaara.namasya?</para>
  <para style="p">
    <verse number="27" style="v"/>tata.h sovaadiit, tava bhraataagamat, tava taata"sca ta.m su"sariira.m praapya pu.s.ta.m govatsa.m maaritavaan|</para>
  <para style="p">
    <verse number="28" style="v"/>tata.h sa prakupya nive"sanaanta.h prave.s.tu.m na sammene; tatastasya pitaa bahiraagatya ta.m saadhayaamaasa|</para>
  <para style="p">
    <verse number="29" style="v"/>tata.h sa pitara.m pratyuvaaca, pa"sya tava kaa ncidapyaaj naa.m na vila.mghya bahuun vatsaraan aha.m tvaa.m seve tathaapi mitrai.h saarddham utsava.m karttu.m kadaapi chaagamekamapi mahya.m naadadaa.h;</para>
  <para style="p">
    <verse number="30" style="v"/>kintu tava ya.h putro ve"syaagamanaadibhistava sampattim apavyayitavaan tasminnaagatamaatre tasyaiva nimitta.m pu.s.ta.m govatsa.m maaritavaan|</para>
  <para style="p">
    <verse number="31" style="v"/>tadaa tasya pitaavocat, he putra tva.m sarvvadaa mayaa sahaasi tasmaan mama yadyadaaste tatsarvva.m tava|</para>
  <para style="p">
    <verse number="32" style="v"/>kintu tavaaya.m bhraataa m.rta.h punarajiiviid haarita"sca bhuutvaa praaptobhuut, etasmaat kaara.naad utsavaanandau karttum ucitamasmaakam|</para>
  <chapter number="16" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>apara nca yii"su.h "si.syebhyonyaamekaa.m kathaa.m kathayaamaasa kasyacid dhanavato manu.syasya g.rhakaaryyaadhii"se sampatterapavyaye.apavaadite sati</para>
  <para style="p">
    <verse number="2" style="v"/>tasya prabhustam aahuuya jagaada, tvayi yaamimaa.m kathaa.m "s.r.nomi saa kiid.r"sii? tva.m g.rhakaaryyaadhii"sakarmma.no ga.nanaa.m dar"saya g.rhakaaryyaadhii"sapade tva.m na sthaasyasi|</para>
  <para style="p">
    <verse number="3" style="v"/>tadaa sa g.rhakaaryyaadhii"so manasaa cintayaamaasa, prabhu ryadi maa.m g.rhakaaryyaadhii"sapadaad bhra.m"sayati tarhi ki.m kari.sye.aha.m? m.rda.m khanitu.m mama "sakti rnaasti bhik.situ nca lajji.sye.aha.m|</para>
  <para style="p">
    <verse number="4" style="v"/>ataeva mayi g.rhakaaryyaadhii"sapadaat cyute sati yathaa lokaa mahyam aa"sraya.m daasyanti tadartha.m yatkarmma mayaa kara.niiya.m tan nir.niiyate|</para>
  <para style="p">
    <verse number="5" style="v"/>pa"scaat sa svaprabhorekaikam adhamar.nam aahuuya prathama.m papraccha, tvatto me prabhu.naa kati praapyam?</para>
  <para style="p">
    <verse number="6" style="v"/>tata.h sa uvaaca, eka"sataa.dhakatailaani; tadaa g.rhakaaryyaadhii"sa.h provaaca, tava patramaaniiya "siighramupavi"sya tatra pa ncaa"sata.m likha|</para>
  <para style="p">
    <verse number="7" style="v"/>pa"scaadanyameka.m papraccha, tvatto me prabhu.naa kati praapyam? tata.h sovaadiid eka"sataa.dhakagodhuumaa.h; tadaa sa kathayaamaasa, tava patramaaniiya a"siiti.m likha|</para>
  <para style="p">
    <verse number="8" style="v"/>tenaiva prabhustamayathaarthak.rtam adhii"sa.m tadbuddhinaipu.nyaat pra"sa"sa.msa; ittha.m diiptiruupasantaanebhya etatsa.msaarasya santaanaa varttamaanakaale.adhikabuddhimanto bhavanti|</para>
  <para style="p">
    <verse number="9" style="v"/>ato vadaami yuuyamapyayathaarthena dhanena mitraa.ni labhadhva.m tato yu.smaasu padabhra.s.te.svapi taani cirakaalam aa"sraya.m daasyanti|</para>
  <para style="p">
    <verse number="10" style="v"/>ya.h ka"scit k.sudre kaaryye vi"svaasyo bhavati sa mahati kaaryyepi vi"svaasyo bhavati, kintu ya.h ka"scit k.sudre kaaryye.avi"svaasyo bhavati sa mahati kaaryyepyavi"svaasyo bhavati|</para>
  <para style="p">
    <verse number="11" style="v"/>ataeva ayathaarthena dhanena yadi yuuyamavi"svaasyaa jaataastarhi satya.m dhana.m yu.smaaka.m kare.su ka.h samarpayi.syati?</para>
  <para style="p">
    <verse number="12" style="v"/>yadi ca paradhanena yuuyam avi"svaasyaa bhavatha tarhi yu.smaaka.m svakiiyadhana.m yu.smabhya.m ko daasyati?</para>
  <para style="p">
    <verse number="13" style="v"/>kopi daasa ubhau prabhuu sevitu.m na "saknoti, yata ekasmin priiyamaa.no.anyasminnapriiyate yadvaa eka.m jana.m samaad.rtya tadanya.m tucchiikaroti tadvad yuuyamapi dhane"svarau sevitu.m na "saknutha|</para>
  <para style="p">
    <verse number="14" style="v"/>tadaitaa.h sarvvaa.h kathaa.h "srutvaa lobhiphiruu"sinastamupajahasu.h|</para>
  <para style="p">
    <verse number="15" style="v"/>tata.h sa uvaaca, yuuya.m manu.syaa.naa.m nika.te svaan nirdo.saan dar"sayatha kintu yu.smaakam anta.hkara.naanii"svaro jaanaati, yat manu.syaa.naam ati pra"sa.msya.m tad ii"svarasya gh.r.nya.m|</para>
  <para style="p">
    <verse number="16" style="v"/>yohana aagamanaparyyanata.m yu.smaaka.m samiipe vyavasthaabhavi.syadvaadinaa.m lekhanaani caasan tata.h prabh.rti ii"svararaajyasya susa.mvaada.h pracarati, ekaiko lokastanmadhya.m yatnena pravi"sati ca|</para>
  <para style="p">
    <verse number="17" style="v"/>vara.m nabhasa.h p.rthivyaa"sca lopo bhavi.syati tathaapi vyavasthaayaa ekabindorapi lopo na bhavi.syati|</para>
  <para style="p">
    <verse number="18" style="v"/>ya.h ka"scit sviiyaa.m bhaaryyaa.m vihaaya striyamanyaa.m vivahati sa paradaaraan gacchati, ya"sca taa tyaktaa.m naarii.m vivahati sopi paradaaraana gacchati|</para>
  <para style="p">
    <verse number="19" style="v"/>eko dhanii manu.sya.h "suklaani suuk.smaa.ni vastraa.ni paryyadadhaat pratidina.m parito.saruupe.naabhu.mktaapivacca|</para>
  <para style="p">
    <verse number="20" style="v"/>sarvvaa"nge k.satayukta iliyaasaranaamaa ka"scid daridrastasya dhanavato bhojanapaatraat patitam ucchi.s.ta.m bhoktu.m vaa nchan tasya dvaare patitvaati.s.that;</para>
  <para style="p">
    <verse number="21" style="v"/>atha "svaana aagatya tasya k.sataanyalihan|</para>
  <para style="p">
    <verse number="22" style="v"/>kiyatkaalaatpara.m sa daridra.h praa.naan jahau; tata.h svargiiyaduutaasta.m niitvaa ibraahiima.h kro.da upave"sayaamaasu.h|</para>
  <para style="p">
    <verse number="23" style="v"/>pa"scaat sa dhanavaanapi mamaara, ta.m "sma"saane sthaapayaamaasu"sca; kintu paraloke sa vedanaakula.h san uurddhvaa.m niriik.sya bahuduuraad ibraahiima.m tatkro.da iliyaasara nca vilokya ruvannuvaaca;</para>
  <para style="p">
    <verse number="24" style="v"/>he pitar ibraahiim anug.rhya a"ngulyagrabhaaga.m jale majjayitvaa mama jihvaa.m "siitalaa.m karttum iliyaasara.m preraya, yato vahni"sikhaatoha.m vyathitosmi|</para>
  <para style="p">
    <verse number="25" style="v"/>tadaa ibraahiim babhaa.se, he putra tva.m jiivan sampada.m praaptavaan iliyaasarastu vipada.m praaptavaan etat smara, kintu samprati tasya sukha.m tava ca du.hkha.m bhavati|</para>
  <para style="p">
    <verse number="26" style="v"/>aparamapi yu.smaakam asmaaka nca sthaanayo rmadhye mahadvicchedo.asti tata etatsthaanasya lokaastat sthaana.m yaatu.m yadvaa tatsthaanasya lokaa etat sthaanamaayaatu.m na "saknuvanti|</para>
  <para style="p">
    <verse number="27" style="v"/>tadaa sa uktavaan, he pitastarhi tvaa.m nivedayaami mama pitu rgehe ye mama pa nca bhraatara.h santi</para>
  <para style="p">
    <verse number="28" style="v"/>te yathaitad yaatanaasthaana.m naayaasyanti tathaa mantra.naa.m daatu.m te.saa.m samiipam iliyaasara.m preraya|</para>
  <para style="p">
    <verse number="29" style="v"/>tata ibraahiim uvaaca, muusaabhavi.syadvaadinaa nca pustakaani te.saa.m nika.te santi te tadvacanaani manyantaa.m|</para>
  <para style="p">
    <verse number="30" style="v"/>tadaa sa nivedayaamaasa, he pitar ibraahiim na tathaa, kintu yadi m.rtalokaanaa.m ka"scit te.saa.m samiipa.m yaati tarhi te manaa.msi vyaagho.tayi.syanti|</para>
  <para style="p">
    <verse number="31" style="v"/>tata ibraahiim jagaada, te yadi muusaabhavi.syadvaadinaa nca vacanaani na manyante tarhi m.rtalokaanaa.m kasmi.m"scid utthitepi te tasya mantra.naa.m na ma.msyante|</para>
  <chapter number="17" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>ita.h para.m yii"su.h "si.syaan uvaaca, vighnairava"syam aagantavya.m kintu vighnaa yena gha.ti.syante tasya durgati rbhavi.syati|</para>
  <para style="p">
    <verse number="2" style="v"/>ete.saa.m k.sudrapraa.ninaam ekasyaapi vighnajananaat ka.n.thabaddhape.sa.niikasya tasya saagaraagaadhajale majjana.m bhadra.m|</para>
  <para style="p">
    <verse number="3" style="v"/>yuuya.m sve.su saavadhaanaasti.s.thata; tava bhraataa yadi tava ki ncid aparaadhyati tarhi ta.m tarjaya, tena yadi mana.h parivarttayati tarhi ta.m k.samasva|</para>
  <para style="p">
    <verse number="4" style="v"/>punarekadinamadhye yadi sa tava saptak.rtvo.aparaadhyati kintu saptak.rtva aagatya mana.h parivartya mayaaparaaddham iti vadati tarhi ta.m k.samasva|</para>
  <para style="p">
    <verse number="5" style="v"/>tadaa preritaa.h prabhum avadan asmaaka.m vi"svaasa.m varddhaya|</para>
  <para style="p">
    <verse number="6" style="v"/>prabhuruvaaca, yadi yu.smaaka.m sar.sapaikapramaa.no vi"svaasosti tarhi tva.m samuulamutpaa.tito bhuutvaa samudre ropito bhava kathaayaam etasyaam etadu.dumbaraaya kathitaayaa.m sa yu.smaakamaaj naavaho bhavi.syati|</para>
  <para style="p">
    <verse number="7" style="v"/>apara.m svadaase hala.m vaahayitvaa vaa pa"suun caarayitvaa k.setraad aagate sati ta.m vadati, ehi bhoktumupavi"sa, yu.smaakam etaad.r"sa.h kosti?</para>
  <para style="p">
    <verse number="8" style="v"/>vara nca puurvva.m mama khaadyamaasaadya yaavad bhu nje pivaami ca taavad baddhaka.ti.h paricara pa"scaat tvamapi bhok.syase paasyasi ca kathaamiid.r"sii.m ki.m na vak.syati?</para>
  <para style="p">
    <verse number="9" style="v"/>tena daasena prabhoraaj naanuruupe karmma.ni k.rte prabhu.h ki.m tasmin baadhito jaata.h? nettha.m budhyate mayaa|</para>
  <para style="p">
    <verse number="10" style="v"/>ittha.m niruupite.su sarvvakarmmasu k.rte.su satmu yuuyamapiida.m vaakya.m vadatha, vayam anupakaari.no daasaa asmaabhiryadyatkarttavya.m tanmaatrameva k.rta.m|</para>
  <para style="p">
    <verse number="11" style="v"/>sa yiruu"saalami yaatraa.m kurvvan "somiro.ngaaliilprade"samadhyena gacchati,</para>
  <para style="p">
    <verse number="12" style="v"/>etarhi kutracid graame prave"samaatre da"saku.s.thinasta.m saak.saat k.rtvaa</para>
  <para style="p">
    <verse number="13" style="v"/>duure ti.s.thanata uccai rvaktumaarebhire, he prabho yii"so dayasvaasmaan|</para>
  <para style="p">
    <verse number="14" style="v"/>tata.h sa taan d.r.s.tvaa jagaada, yuuya.m yaajakaanaa.m samiipe svaan dar"sayata, tataste gacchanto rogaat pari.sk.rtaa.h|</para>
  <para style="p">
    <verse number="15" style="v"/>tadaa te.saameka.h sva.m svastha.m d.r.s.tvaa proccairii"svara.m dhanya.m vadan vyaaghu.tyaayaato yii"so rgu.naananuvadan taccara.naadhobhuumau papaata;</para>
  <para style="p">
    <verse number="16" style="v"/>sa caasiit "somiro.nii|</para>
  <para style="p">
    <verse number="17" style="v"/>tadaa yii"suravadat, da"sajanaa.h ki.m na pari.sk.rtaa.h? tahyanye navajanaa.h kutra?</para>
  <para style="p">
    <verse number="18" style="v"/>ii"svara.m dhanya.m vadantam ena.m vide"sina.m vinaa kopyanyo na praapyata|</para>
  <para style="p">
    <verse number="19" style="v"/>tadaa sa tamuvaaca, tvamutthaaya yaahi vi"svaasaste tvaa.m svastha.m k.rtavaan|</para>
  <para style="p">
    <verse number="20" style="v"/>atha kade"svarasya raajatva.m bhavi.syatiiti phiruu"sibhi.h p.r.s.te sa pratyuvaaca, ii"svarasya raajatvam ai"svaryyadar"sanena na bhavi.syati|</para>
  <para style="p">
    <verse number="21" style="v"/>ata etasmin pa"sya tasmin vaa pa"sya, iti vaakya.m lokaa vaktu.m na "sak.syanti, ii"svarasya raajatva.m yu.smaakam antarevaaste|</para>
  <para style="p">
    <verse number="22" style="v"/>tata.h sa "si.syaan jagaada, yadaa yu.smaabhi rmanujasutasya dinameka.m dra.s.tum vaa nchi.syate kintu na dar"si.syate, iid.rkkaala aayaati|</para>
  <para style="p">
    <verse number="23" style="v"/>tadaatra pa"sya vaa tatra pa"syeti vaakya.m lokaa vak.syanti, kintu te.saa.m pa"scaat maa yaata, maanugacchata ca|</para>
  <para style="p">
    <verse number="24" style="v"/>yatasta.did yathaakaa"saikadi"syudiya tadanyaamapi di"sa.m vyaapya prakaa"sate tadvat nijadine manujasuunu.h prakaa"si.syate|</para>
  <para style="p">
    <verse number="25" style="v"/>kintu tatpuurvva.m tenaanekaani du.hkhaani bhoktavyaanyetadvarttamaanalokai"sca so.avaj naatavya.h|</para>
  <para style="p">
    <verse number="26" style="v"/>nohasya vidyamaanakaale yathaabhavat manu.syasuuno.h kaalepi tathaa bhavi.syati|</para>
  <para style="p">
    <verse number="27" style="v"/>yaavatkaala.m noho mahaapota.m naarohad aaplaavivaaryyetya sarvva.m naanaa"sayacca taavatkaala.m yathaa lokaa abhu njataapivan vyavahan vyavaahaya.m"sca;</para>
  <para style="p">
    <verse number="28" style="v"/>ittha.m lo.to varttamaanakaalepi yathaa lokaa bhojanapaanakrayavikrayaropa.nag.rhanirmmaa.nakarmmasu praavarttanta,</para>
  <para style="p">
    <verse number="29" style="v"/>kintu yadaa lo.t sidomo nirjagaama tadaa nabhasa.h sagandhakaagniv.r.s.ti rbhuutvaa sarvva.m vyanaa"sayat</para>
  <para style="p">
    <verse number="30" style="v"/>tadvan maanavaputraprakaa"sadinepi bhavi.syati|</para>
  <para style="p">
    <verse number="31" style="v"/>tadaa yadi ka"scid g.rhopari ti.s.thati tarhi sa g.rhamadhyaat kimapi dravyamaanetum avaruhya naitu; ya"sca k.setre ti.s.thati sopi vyaaghu.tya naayaatu|</para>
  <para style="p">
    <verse number="32" style="v"/>lo.ta.h patnii.m smarata|</para>
  <para style="p">
    <verse number="33" style="v"/>ya.h praa.naan rak.situ.m ce.s.ti.syate sa praa.naan haarayi.syati yastu praa.naan haarayi.syati saeva praa.naan rak.si.syati|</para>
  <para style="p">
    <verse number="34" style="v"/>yu.smaanaha.m vacmi tasyaa.m raatrau "sayyaikagatayo rlokayoreko dhaari.syate parastyak.syate|</para>
  <para style="p">
    <verse number="35" style="v"/>striyau yugapat pe.sa.nii.m vyaavarttayi.syatastayorekaa dhaari.syate paraatyak.syate|</para>
  <para style="p">
    <verse number="36" style="v"/>puru.sau k.setre sthaasyatastayoreko dhaari.syate parastyak.syate|</para>
  <para style="p">
    <verse number="37" style="v"/>tadaa te papracchu.h, he prabho kutrettha.m bhavi.syati? tata.h sa uvaaca, yatra "savasti.s.thati tatra g.rdhraa milanti|</para>
  <chapter number="18" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>apara nca lokairaklaantai rnirantara.m praarthayitavyam ityaa"sayena yii"sunaa d.r.s.taanta eka.h kathita.h|</para>
  <para style="p">
    <verse number="2" style="v"/>kutracinnagare ka"scit praa.dvivaaka aasiit sa ii"svaraannaabibhet maanu.saa.m"sca naamanyata|</para>
  <para style="p">
    <verse number="3" style="v"/>atha tatpuravaasinii kaacidvidhavaa tatsamiipametya vivaadinaa saha mama vivaada.m pari.skurvviti nivedayaamaasa|</para>
  <para style="p">
    <verse number="4" style="v"/>tata.h sa praa.dvivaaka.h kiyaddinaani na tada"ngiik.rtavaan pa"scaaccitte cintayaamaasa, yadyapii"svaraanna bibhemi manu.syaanapi na manye</para>
  <para style="p">
    <verse number="5" style="v"/>tathaapye.saa vidhavaa maa.m kli"snaati tasmaadasyaa vivaada.m pari.skari.syaami nocet saa sadaagatya maa.m vyagra.m kari.syati|</para>
  <para style="p">
    <verse number="6" style="v"/>pa"scaat prabhuravadad asaavanyaayapraa.dvivaako yadaaha tatra mano nidhadhva.m|</para>
  <para style="p">
    <verse number="7" style="v"/>ii"svarasya ye .abhirucitalokaa divaani"sa.m praarthayante sa bahudinaani vilambyaapi te.saa.m vivaadaan ki.m na pari.skari.syati?</para>
  <para style="p">
    <verse number="8" style="v"/>yu.smaanaha.m vadaami tvarayaa pari.skari.syati, kintu yadaa manu.syaputra aagami.syati tadaa p.rthivyaa.m kimiid.r"sa.m vi"svaasa.m praapsyati?</para>
  <para style="p">
    <verse number="9" style="v"/>ye svaan dhaarmmikaan j naatvaa paraan tucchiikurvvanti etaad.rgbhya.h, kiyadbhya ima.m d.r.s.taanta.m kathayaamaasa|</para>
  <para style="p">
    <verse number="10" style="v"/>eka.h phiruu"syapara.h karasa ncaayii dvaavimau praarthayitu.m mandira.m gatau|</para>
  <para style="p">
    <verse number="11" style="v"/>tato.asau phiruu"syekapaar"sve ti.s.than he ii"svara ahamanyalokavat lo.thayitaanyaayii paaradaarika"sca na bhavaami asya karasa ncaayinastulya"sca na, tasmaattvaa.m dhanya.m vadaami|</para>
  <para style="p">
    <verse number="12" style="v"/>saptasu dine.su dinadvayamupavasaami sarvvasampatte rda"samaa.m"sa.m dadaami ca, etatkathaa.m kathayan praarthayaamaasa|</para>
  <para style="p">
    <verse number="13" style="v"/>kintu sa karasa ncaayi duure ti.s.than svarga.m dra.s.tu.m necchan vak.sasi karaaghaata.m kurvvan he ii"svara paapi.s.tha.m maa.m dayasva, ittha.m praarthayaamaasa|</para>
  <para style="p">
    <verse number="14" style="v"/>yu.smaanaha.m vadaami, tayordvayo rmadhye kevala.h karasa ncaayii pu.nyavattvena ga.nito nijag.rha.m jagaama, yato ya.h ka"scit svamunnamayati sa naamayi.syate kintu ya.h ka"scit sva.m namayati sa unnamayi.syate|</para>
  <para style="p">
    <verse number="15" style="v"/>atha "si"suunaa.m gaatraspar"saartha.m lokaastaan tasya samiipamaaninyu.h "si.syaastad d.r.s.tvaanet.rn tarjayaamaasu.h,</para>
  <para style="p">
    <verse number="16" style="v"/>kintu yii"sustaanaahuuya jagaada, mannika.tam aagantu.m "si"suun anujaaniidhva.m taa.m"sca maa vaarayata; yata ii"svararaajyaadhikaari.na e.saa.m sad.r"saa.h|</para>
  <para style="p">
    <verse number="17" style="v"/>aha.m yu.smaan yathaartha.m vadaami, yo jana.h "si"so.h sad.r"so bhuutvaa ii"svararaajya.m na g.rhlaati sa kenaapi prakaare.na tat prave.s.tu.m na "saknoti|</para>
  <para style="p">
    <verse number="18" style="v"/>aparam ekodhipatista.m papraccha, he paramaguro, anantaayu.sa.h praaptaye mayaa ki.m karttavya.m?</para>
  <para style="p">
    <verse number="19" style="v"/>yii"suruvaaca, maa.m kuta.h parama.m vadasi? ii"svara.m vinaa kopi paramo na bhavati|</para>
  <para style="p">
    <verse number="20" style="v"/>paradaaraan maa gaccha, nara.m maa jahi, maa coraya, mithyaasaak.sya.m maa dehi, maatara.m pitara nca sa.mmanyasva, etaa yaa aaj naa.h santi taastva.m jaanaasi|</para>
  <para style="p">
    <verse number="21" style="v"/>tadaa sa uvaaca, baalyakaalaat sarvvaa etaa aacaraami|</para>
  <para style="p">
    <verse number="22" style="v"/>iti kathaa.m "srutvaa yii"sustamavadat, tathaapi tavaika.m karmma nyuunamaaste, nija.m sarvvasva.m vikriiya daridrebhyo vitara, tasmaat svarge dhana.m praapsyasi; tata aagatya mamaanugaamii bhava|</para>
  <para style="p">
    <verse number="23" style="v"/>kintvetaa.m kathaa.m "srutvaa sodhipati.h "su"soca, yatastasya bahudhanamaasiit|</para>
  <para style="p">
    <verse number="24" style="v"/>tadaa yii"sustamati"sokaanvita.m d.r.s.tvaa jagaada, dhanavataam ii"svararaajyaprave"sa.h kiid.rg du.skara.h|</para>
  <para style="p">
    <verse number="25" style="v"/>ii"svararaajye dhanina.h prave"saat suuce"schidre.na mahaa"ngasya gamanaagamane sukare|</para>
  <para style="p">
    <verse number="26" style="v"/>"srotaara.h papracchustarhi kena paritraa.na.m praapsyate?</para>
  <para style="p">
    <verse number="27" style="v"/>sa uktavaan, yan maanu.se.naa"sakya.m tad ii"svare.na "sakya.m|</para>
  <para style="p">
    <verse number="28" style="v"/>tadaa pitara uvaaca, pa"sya vaya.m sarvvasva.m parityajya tava pa"scaadgaamino.abhavaama|</para>
  <para style="p">
    <verse number="29" style="v"/>tata.h sa uvaaca, yu.smaanaha.m yathaartha.m vadaami, ii"svararaajyaartha.m g.rha.m pitarau bhraat.rga.na.m jaayaa.m santaanaa.m"sca tyaktavaa</para>
  <para style="p">
    <verse number="30" style="v"/>iha kaale tato.adhika.m parakaale .anantaayu"sca na praapsyati loka iid.r"sa.h kopi naasti|</para>
  <para style="p">
    <verse number="31" style="v"/>anantara.m sa dvaada"sa"si.syaanaahuuya babhaa.se, pa"syata vaya.m yiruu"saalamnagara.m yaama.h, tasmaat manu.syaputre bhavi.syadvaadibhirukta.m yadasti tadanuruupa.m ta.m prati gha.ti.syate;</para>
  <para style="p">
    <verse number="32" style="v"/>vastutastu so.anyade"siiyaanaa.m haste.su samarpayi.syate, te tamupahasi.syanti, anyaayamaacari.syanti tadvapu.si ni.s.thiiva.m nik.sepsyanti, ka"saabhi.h prah.rtya ta.m hani.syanti ca,</para>
  <para style="p">
    <verse number="33" style="v"/>kintu t.rtiiyadine sa "sma"saanaad utthaasyati|</para>
  <para style="p">
    <verse number="34" style="v"/>etasyaa.h kathaayaa abhipraaya.m ki ncidapi te boddhu.m na "seku.h te.saa.m nika.te.aspa.s.tatavaat tasyaitaasaa.m kathaanaam aa"saya.m te j naatu.m na "seku"sca|</para>
  <para style="p">
    <verse number="35" style="v"/>atha tasmin yiriiho.h purasyaantika.m praapte ka"scidandha.h patha.h paar"sva upavi"sya bhik.saam akarot</para>
  <para style="p">
    <verse number="36" style="v"/>sa lokasamuuhasya gamana"sabda.m "srutvaa tatkaara.na.m p.r.s.tavaan|</para>
  <para style="p">
    <verse number="37" style="v"/>naasaratiiyayii"suryaatiiti lokairukte sa uccairvaktumaarebhe,</para>
  <para style="p">
    <verse number="38" style="v"/>he daayuuda.h santaana yii"so maa.m dayasva|</para>
  <para style="p">
    <verse number="39" style="v"/>tatogragaaminasta.m maunii ti.s.theti tarjayaamaasu.h kintu sa punaaruvan uvaaca, he daayuuda.h santaana maa.m dayasva|</para>
  <para style="p">
    <verse number="40" style="v"/>tadaa yii"su.h sthagito bhuutvaa svaantike tamaanetum aadide"sa|</para>
  <para style="p">
    <verse number="41" style="v"/>tata.h sa tasyaantikam aagamat, tadaa sa ta.m papraccha, tva.m kimicchasi? tvadarthamaha.m ki.m kari.syaami? sa uktavaan, he prabho.aha.m dra.s.tu.m labhai|</para>
  <para style="p">
    <verse number="42" style="v"/>tadaa yii"suruvaaca, d.r.s.ti"sakti.m g.rhaa.na tava pratyayastvaa.m svastha.m k.rtavaan|</para>
  <para style="p">
    <verse number="43" style="v"/>tatastatk.sa.naat tasya cak.su.sii prasanne; tasmaat sa ii"svara.m dhanya.m vadan tatpa"scaad yayau, tadaalokya sarvve lokaa ii"svara.m pra"sa.msitum aarebhire|</para>
  <chapter number="19" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>yadaa yii"su ryiriihopura.m pravi"sya tanmadhyena gaccha.mstadaa</para>
  <para style="p">
    <verse number="2" style="v"/>sakkeyanaamaa karasa ncaayinaa.m pradhaano dhanavaaneko</para>
  <para style="p">
    <verse number="3" style="v"/>yii"su.h kiid.rgiti dra.s.tu.m ce.s.titavaan kintu kharvvatvaallokasa.mghamadhye taddar"sanamapraapya</para>
  <para style="p">
    <verse number="4" style="v"/>yena pathaa sa yaasyati tatpathe.agre dhaavitvaa ta.m dra.s.tum u.dumbaratarumaaruroha|</para>
  <para style="p">
    <verse number="5" style="v"/>pa"scaad yii"sustatsthaanam itvaa uurddhva.m vilokya ta.m d.r.s.tvaavaadiit, he sakkeya tva.m "siighramavaroha mayaadya tvadgehe vastavya.m|</para>
  <para style="p">
    <verse number="6" style="v"/>tata.h sa "siighramavaruhya saahlaada.m ta.m jagraaha|</para>
  <para style="p">
    <verse number="7" style="v"/>tad d.r.s.tvaa sarvve vivadamaanaa vaktumaarebhire, sotithitvena du.s.talokag.rha.m gacchati|</para>
  <para style="p">
    <verse number="8" style="v"/>kintu sakkeyo da.n.daayamaano vaktumaarebhe, he prabho pa"sya mama yaa sampattirasti tadarddha.m daridrebhyo dade, aparam anyaaya.m k.rtvaa kasmaadapi yadi kadaapi ki ncit mayaa g.rhiita.m tarhi taccaturgu.na.m dadaami|</para>
  <para style="p">
    <verse number="9" style="v"/>tadaa yii"sustamuktavaan ayamapi ibraahiima.h santaano.ata.h kaara.naad adyaasya g.rhe traa.namupasthita.m|</para>
  <para style="p">
    <verse number="10" style="v"/>yad haarita.m tat m.rgayitu.m rak.situ nca manu.syaputra aagatavaan|</para>
  <para style="p">
    <verse number="11" style="v"/>atha sa yiruu"saalama.h samiipa upaati.s.thad ii"svararaajatvasyaanu.s.thaana.m tadaiva bhavi.syatiiti lokairanvabhuuyata, tasmaat sa "srot.rbhya.h punard.r.s.taantakathaam utthaapya kathayaamaasa|</para>
  <para style="p">
    <verse number="12" style="v"/>kopi mahaalloko nijaartha.m raajatvapada.m g.rhiitvaa punaraagantu.m duurade"sa.m jagaama|</para>
  <para style="p">
    <verse number="13" style="v"/>yaatraakaale nijaan da"sadaasaan aahuuya da"sasvar.namudraa dattvaa mamaagamanaparyyanta.m vaa.nijya.m kurutetyaadide"sa|</para>
  <para style="p">
    <verse number="14" style="v"/>kintu tasya prajaastamavaj naaya manu.syamenam asmaakamupari raajatva.m na kaarayivyaama imaa.m vaarttaa.m tannika.te prerayaamaasu.h|</para>
  <para style="p">
    <verse number="15" style="v"/>atha sa raajatvapada.m praapyaagatavaan ekaiko jano baa.nijyena ki.m labdhavaan iti j naatu.m ye.su daase.su mudraa arpayat taan aahuuyaanetum aadide"sa|</para>
  <para style="p">
    <verse number="16" style="v"/>tadaa prathama aagatya kathitavaan, he prabho tava tayaikayaa mudrayaa da"samudraa labdhaa.h|</para>
  <para style="p">
    <verse number="17" style="v"/>tata.h sa uvaaca tvamuttamo daasa.h svalpena vi"svaasyo jaata ita.h kaara.naat tva.m da"sanagaraa.naam adhipo bhava|</para>
  <para style="p">
    <verse number="18" style="v"/>dvitiiya aagatya kathitavaan, he prabho tavaikayaa mudrayaa pa ncamudraa labdhaa.h|</para>
  <para style="p">
    <verse number="19" style="v"/>tata.h sa uvaaca, tva.m pa ncaanaa.m nagaraa.naamadhipati rbhava|</para>
  <para style="p">
    <verse number="20" style="v"/>tatonya aagatya kathayaamaasa, he prabho pa"sya tava yaa mudraa aha.m vastre baddhvaasthaapaya.m seya.m|</para>
  <para style="p">
    <verse number="21" style="v"/>tva.m k.rpa.no yannaasthaapayastadapi g.rhlaasi, yannaavapastadeva ca chinatsi tatoha.m tvatto bhiita.h|</para>
  <para style="p">
    <verse number="22" style="v"/>tadaa sa jagaada, re du.s.tadaasa tava vaakyena tvaa.m do.si.na.m kari.syaami, yadaha.m naasthaapaya.m tadeva g.rhlaami, yadaha.m naavapa nca tadeva chinadmi, etaad.r"sa.h k.rpa.nohamiti yadi tva.m jaanaasi,</para>
  <para style="p">
    <verse number="23" style="v"/>tarhi mama mudraa ba.nijaa.m nika.te kuto naasthaapaya.h? tayaa k.rte.aham aagatya kusiidena saarddha.m nijamudraa apraapsyam|</para>
  <para style="p">
    <verse number="24" style="v"/>pa"scaat sa samiipasthaan janaan aaj naapayat asmaat mudraa aaniiya yasya da"samudraa.h santi tasmai datta|</para>
  <para style="p">
    <verse number="25" style="v"/>te procu.h prabho.asya da"samudraa.h santi|</para>
  <para style="p">
    <verse number="26" style="v"/>yu.smaanaha.m vadaami yasyaa"sraye vaddhate .adhika.m tasmai daayi.syate, kintu yasyaa"sraye na varddhate tasya yadyadasti tadapi tasmaan naayi.syate|</para>
  <para style="p">
    <verse number="27" style="v"/>kintu mamaadhipatitvasya va"satve sthaatum asammanyamaanaa ye mama ripavastaanaaniiya mama samak.sa.m sa.mharata|</para>
  <para style="p">
    <verse number="28" style="v"/>ityupade"sakathaa.m kathayitvaa sograga.h san yiruu"saalamapura.m yayau|</para>
  <para style="p">
    <verse number="29" style="v"/>tato baitphagiibaithaniiyaagraamayo.h samiipe jaitunaadrerantikam itvaa "si.syadvayam ityuktvaa pre.sayaamaasa,</para>
  <para style="p">
    <verse number="30" style="v"/>yuvaamamu.m sammukhasthagraama.m pravi"syaiva ya.m kopi maanu.sa.h kadaapi naarohat ta.m garddabha"saavaka.m baddha.m drak.syathasta.m mocayitvaanayata.m|</para>
  <para style="p">
    <verse number="31" style="v"/>tatra kuto mocayatha.h? iti cet kopi vak.syati tarhi vak.syatha.h prabheाratra prayojanam aaste|</para>
  <para style="p">
    <verse number="32" style="v"/>tadaa tau praritau gatvaa tatkathaaाnusaare.na sarvva.m praaptau|</para>
  <para style="p">
    <verse number="33" style="v"/>gardabha"saavakamocanakaale tatvaamina uucu.h, gardabha"saavaka.m kuto mocayatha.h?</para>
  <para style="p">
    <verse number="34" style="v"/>taavuucatu.h prabhoratra prayojanam aaste|</para>
  <para style="p">
    <verse number="35" style="v"/>pa"scaat tau ta.m gardabha"saavaka.m yii"sorantikamaaniiya tatp.r.s.the nijavasanaani paatayitvaa tadupari yii"sumaarohayaamaasatu.h|</para>
  <para style="p">
    <verse number="36" style="v"/>atha yaatraakaale lokaa.h pathi svavastraa.ni paatayitum aarebhire|</para>
  <para style="p">
    <verse number="37" style="v"/>apara.m jaitunaadrerupatyakaam itvaa "si.syasa.mgha.h puurvvad.r.s.taani mahaakarmmaa.ni sm.rtvaa,</para>
  <para style="p">
    <verse number="38" style="v"/>yo raajaa prabho rnaamnaayaati sa dhanya.h svarge ku"sala.m sarvvocce jayadhvani rbhavatu, kathaametaa.m kathayitvaa saanandam ucairii"svara.m dhanya.m vaktumaarebhe|</para>
  <para style="p">
    <verse number="39" style="v"/>tadaa lokaara.nyamadhyasthaa.h kiyanta.h phiruu"sinastat "srutvaa yii"su.m procu.h, he upade"saka sva"si.syaan tarjaya|</para>
  <para style="p">
    <verse number="40" style="v"/>sa uvaaca, yu.smaanaha.m vadaami yadyamii niiravaasti.s.thanti tarhi paa.saa.naa ucai.h kathaa.h kathayi.syanti|</para>
  <para style="p">
    <verse number="41" style="v"/>pa"scaat tatpuraantikametya tadavalokya saa"srupaata.m jagaada,</para>
  <para style="p">
    <verse number="42" style="v"/>haa haa cet tvamagre.aj naasyathaa.h, tavaasminneva dine vaa yadi svama"ngalam upaalapsyathaa.h, tarhyuttamam abhavi.syat, kintu k.sa.nesmin tattava d.r.s.teragocaram bhavati|</para>
  <para style="p">
    <verse number="43" style="v"/>tva.m svatraa.nakaale na mano nyadhatthaa iti heto ryatkaale tava ripavastvaa.m caturdik.su praaciire.na ve.s.tayitvaa rotsyanti</para>
  <para style="p">
    <verse number="44" style="v"/>baalakai.h saarddha.m bhuumisaat kari.syanti ca tvanmadhye paa.saa.naikopi paa.saa.nopari na sthaasyati ca, kaala iid.r"sa upasthaasyati|</para>
  <para style="p">
    <verse number="45" style="v"/>atha madhyemandira.m pravi"sya tatratyaan krayivikrayi.no bahi.skurvvan</para>
  <para style="p">
    <verse number="46" style="v"/>avadat madg.rha.m praarthanaag.rhamiti lipiraaste kintu yuuya.m tadeva cairaa.naa.m gahvara.m kurutha|</para>
  <para style="p">
    <verse number="47" style="v"/>pa"scaat sa pratyaha.m madhyemandiram upadide"sa; tata.h pradhaanayaajakaa adhyaapakaa.h praaciinaa"sca ta.m naa"sayitu.m cice.s.tire;</para>
  <para style="p">
    <verse number="48" style="v"/>kintu tadupade"se sarvve lokaa nivi.s.tacittaa.h sthitaastasmaat te tatkarttu.m naavakaa"sa.m praapu.h|</para>
  <chapter number="20" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>athaikadaa yii"su rmanidare susa.mvaada.m pracaarayan lokaanupadi"sati, etarhi pradhaanayaajakaa adhyaapakaa.h praa nca"sca tannika.tamaagatya papracchu.h</para>
  <para style="p">
    <verse number="2" style="v"/>kayaaj nayaa tva.m karmmaa.nyetaani karo.si? ko vaa tvaamaaj naapayat? tadasmaan vada|</para>
  <para style="p">
    <verse number="3" style="v"/>sa pratyuvaaca, tarhi yu.smaanapi kathaamekaa.m p.rcchaami tasyottara.m vadata|</para>
  <para style="p">
    <verse number="4" style="v"/>yohano majjanam ii"svarasya maanu.saa.naa.m vaaj naato jaata.m?</para>
  <para style="p">
    <verse number="5" style="v"/>tataste mitho vivicya jagadu.h, yadii"svarasya vadaamastarhi ta.m kuto na pratyaita sa iti vak.syati|</para>
  <para style="p">
    <verse number="6" style="v"/>yadi manu.syasyeti vadaamastarhi sarvve lokaa asmaan paa.saa.nai rhani.syanti yato yohan bhavi.syadvaadiiti sarvve d.r.dha.m jaananti|</para>
  <para style="p">
    <verse number="7" style="v"/>ataeva te pratyuucu.h kasyaaj nayaa jaatam iti vaktu.m na "saknuma.h|</para>
  <para style="p">
    <verse number="8" style="v"/>tadaa yii"suravadat tarhi kayaaj nayaa karmmaa.nyetaati karomiiti ca yu.smaan na vak.syaami|</para>
  <para style="p">
    <verse number="9" style="v"/>atha lokaanaa.m saak.saat sa imaa.m d.r.s.taantakathaa.m vaktumaarebhe, ka"scid draak.saak.setra.m k.rtvaa tat k.setra.m k.r.siivalaanaa.m haste.su samarpya bahukaalaartha.m duurade"sa.m jagaama|</para>
  <para style="p">
    <verse number="10" style="v"/>atha phalakaale phalaani grahiitu k.r.siivalaanaa.m samiipe daasa.m praahi.not kintu k.r.siivalaasta.m prah.rtya riktahasta.m visasarju.h|</para>
  <para style="p">
    <verse number="11" style="v"/>tata.h sodhipati.h punaranya.m daasa.m pre.sayaamaasa, te tamapi prah.rtya kuvyavah.rtya riktahasta.m visas.rju.h|</para>
  <para style="p">
    <verse number="12" style="v"/>tata.h sa t.rtiiyavaaram anya.m praahi.not te tamapi k.sataa"nga.m k.rtvaa bahi rnicik.sipu.h|</para>
  <para style="p">
    <verse number="13" style="v"/>tadaa k.setrapati rvicaarayaamaasa, mamedaanii.m ki.m karttavya.m? mama priye putre prahite te tamava"sya.m d.r.s.tvaa samaadari.syante|</para>
  <para style="p">
    <verse number="14" style="v"/>kintu k.r.siivalaasta.m niriik.sya paraspara.m vivicya procu.h, ayamuttaraadhikaarii aagacchataina.m hanmastatodhikaarosmaaka.m bhavi.syati|</para>
  <para style="p">
    <verse number="15" style="v"/>tataste ta.m k.setraad bahi rnipaatya jaghnustasmaat sa k.setrapatistaan prati ki.m kari.syati?</para>
  <para style="p">
    <verse number="16" style="v"/>sa aagatya taan k.r.siivalaan hatvaa pare.saa.m haste.su tatk.setra.m samarpayi.syati; iti kathaa.m "srutvaa te .avadan etaad.r"sii gha.tanaa na bhavatu|</para>
  <para style="p">
    <verse number="17" style="v"/>kintu yii"sustaanavalokya jagaada, tarhi, sthapataya.h kari.syanti graavaa.na.m yantu tucchaka.m| pradhaanaprastara.h ko.ne sa eva hi bhavi.syati| etasya "saastriiyavacanasya ki.m taatparyya.m?</para>
  <para style="p">
    <verse number="18" style="v"/>apara.m tatpaa.saa.nopari ya.h pati.syati sa bha.mk.syate kintu yasyopari sa paa.saa.na.h pati.syati sa tena dhuulivac cuur.niibhavi.syati|</para>
  <para style="p">
    <verse number="19" style="v"/>sosmaaka.m viruddha.m d.r.s.taantamima.m kathitavaan iti j naatvaa pradhaanayaajakaa adhyaapakaa"sca tadaiva ta.m dhartu.m vavaa nchu.h kintu lokebhyo bibhyu.h|</para>
  <para style="p">
    <verse number="20" style="v"/>ataeva ta.m prati satarkaa.h santa.h katha.m tadvaakyado.sa.m dh.rtvaa ta.m de"saadhipasya saadhuve"sadhaari.na"scaraan tasya samiipe pre.sayaamaasu.h|</para>
  <para style="p">
    <verse number="21" style="v"/>tadaa te ta.m papracchu.h, he upade"saka bhavaan yathaartha.m kathayan upadi"sati, kamapyanapek.sya satyatvenai"svara.m maargamupadi"sati, vayametajjaaniima.h|</para>
  <para style="p">
    <verse number="22" style="v"/>kaisararaajaaya karosmaabhi rdeyo na vaa?</para>
  <para style="p">
    <verse number="23" style="v"/>sa te.saa.m va ncana.m j naatvaavadat kuto maa.m pariik.sadhve? maa.m mudraameka.m dar"sayata|</para>
  <para style="p">
    <verse number="24" style="v"/>iha likhitaa muurtiriya.m naama ca kasya? te.avadan kaisarasya|</para>
  <para style="p">
    <verse number="25" style="v"/>tadaa sa uvaaca, tarhi kaisarasya dravya.m kaisaraaya datta; ii"svarasya tu dravyamii"svaraaya datta|</para>
  <para style="p">
    <verse number="26" style="v"/>tasmaallokaanaa.m saak.saat tatkathaayaa.h kamapi do.sa.m dhartumapraapya te tasyottaraad aa"scaryya.m manyamaanaa mauninastasthu.h|</para>
  <para style="p">
    <verse number="27" style="v"/>apara nca "sma"saanaadutthaanaana"ngiikaari.naa.m siduukinaa.m kiyanto janaa aagatya ta.m papracchu.h,</para>
  <para style="p">
    <verse number="28" style="v"/>he upade"saka "saastre muusaa asmaan pratiiti lilekha yasya bhraataa bhaaryyaayaa.m satyaa.m ni.hsantaano mriyate sa tajjaayaa.m vivahya tadva.m"sam utpaadayi.syati|</para>
  <para style="p">
    <verse number="29" style="v"/>tathaaca kecit sapta bhraatara aasan te.saa.m jye.s.tho bhraataa vivahya nirapatya.h praa.naan jahau|</para>
  <para style="p">
    <verse number="30" style="v"/>atha dvitiiyastasya jaayaa.m vivahya nirapatya.h san mamaara| t.rtiiya"sca taameva vyuvaaha;</para>
  <para style="p">
    <verse number="31" style="v"/>ittha.m sapta bhraatarastaameva vivahya nirapatyaa.h santo mamru.h|</para>
  <para style="p">
    <verse number="32" style="v"/>"se.se saa strii ca mamaara|</para>
  <para style="p">
    <verse number="33" style="v"/>ataeva "sma"saanaadutthaanakaale te.saa.m saptajanaanaa.m kasya saa bhaaryyaa bhavi.syati? yata.h saa te.saa.m saptaanaameva bhaaryyaasiit|</para>
  <para style="p">
    <verse number="34" style="v"/>tadaa yii"su.h pratyuvaaca, etasya jagato lokaa vivahanti vaagdattaa"sca bhavanti</para>
  <para style="p">
    <verse number="35" style="v"/>kintu ye tajjagatpraaptiyogyatvena ga.nitaa.m bhavi.syanti "sma"saanaaccotthaasyanti te na vivahanti vaagdattaa"sca na bhavanti,</para>
  <para style="p">
    <verse number="36" style="v"/>te puna rna mriyante kintu "sma"saanaadutthaapitaa.h santa ii"svarasya santaanaa.h svargiiyaduutaanaa.m sad.r"saa"sca bhavanti|</para>
  <para style="p">
    <verse number="37" style="v"/>adhikantu muusaa.h stambopaakhyaane parame"svara iibraahiima ii"svara ishaaka ii"svaro yaakuuba"sce"svara ityuktvaa m.rtaanaa.m "sma"saanaad utthaanasya pramaa.na.m lilekha|</para>
  <para style="p">
    <verse number="38" style="v"/>ataeva ya ii"svara.h sa m.rtaanaa.m prabhu rna kintu jiivataameva prabhu.h, tannika.te sarvve jiivanta.h santi|</para>
  <para style="p">
    <verse number="39" style="v"/>iti "srutvaa kiyantodhyaapakaa uucu.h, he upade"saka bhavaan bhadra.m pratyuktavaan|</para>
  <para style="p">
    <verse number="40" style="v"/>ita.h para.m ta.m kimapi pra.s.ta.m te.saa.m pragalbhataa naabhuut|</para>
  <para style="p">
    <verse number="41" style="v"/>pa"scaat sa taan uvaaca, ya.h khrii.s.ta.h sa daayuuda.h santaana etaa.m kathaa.m lokaa.h katha.m kathayanti?</para>
  <para style="p">
    <verse number="42" style="v"/>yata.h mama prabhumida.m vaakyamavadat parame"svara.h| tava "satruunaha.m yaavat paadapii.tha.m karomi na| taavat kaala.m madiiye tva.m dak.sapaar"sva upaavi"sa|</para>
  <para style="p">
    <verse number="43" style="v"/>iti kathaa.m daayuud svaya.m giitagranthe.avadat|</para>
  <para style="p">
    <verse number="44" style="v"/>ataeva yadi daayuud ta.m prabhu.m vadati, tarhi sa katha.m tasya santaano bhavati?</para>
  <para style="p">
    <verse number="45" style="v"/>pa"scaad yii"su.h sarvvajanaanaa.m kar.nagocare "si.syaanuvaaca,</para>
  <para style="p">
    <verse number="46" style="v"/>ye.adhyaapakaa diirghaparicchada.m paridhaaya bhramanti, ha.t.taapa.nayo rnamaskaare bhajanagehasya proccaasane bhojanag.rhasya pradhaanasthaane ca priiyante</para>
  <para style="p">
    <verse number="47" style="v"/>vidhavaanaa.m sarvvasva.m grasitvaa chalena diirghakaala.m praarthayante ca te.su saavadhaanaa bhavata, te.saamugrada.n.do bhavi.syati|</para>
  <chapter number="21" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>atha dhanilokaa bhaa.n.daagaare dhana.m nik.sipanti sa tadeva pa"syati,</para>
  <para style="p">
    <verse number="2" style="v"/>etarhi kaaciddiinaa vidhavaa pa.nadvaya.m nik.sipati tad dadar"sa|</para>
  <para style="p">
    <verse number="3" style="v"/>tato yii"suruvaaca yu.smaanaha.m yathaartha.m vadaami, daridreya.m vidhavaa sarvvebhyodhika.m nyak.sepsiit,</para>
  <para style="p">
    <verse number="4" style="v"/>yatonye svapraajyadhanebhya ii"svaraaya ki ncit nyak.sepsu.h, kintu daridreya.m vidhavaa dinayaapanaartha.m svasya yat ki ncit sthita.m tat sarvva.m nyak.sepsiit|</para>
  <para style="p">
    <verse number="5" style="v"/>apara nca uttamaprastarairuts.r.s.tavyai"sca mandira.m su"sobhatetaraa.m kai"scidityukte sa pratyuvaaca</para>
  <para style="p">
    <verse number="6" style="v"/>yuuya.m yadida.m nicayana.m pa"syatha, asya paa.saa.naikopyanyapaa.saa.nopari na sthaasyati, sarvve bhuusaadbhavi.syanti kaaloyamaayaati|</para>
  <para style="p">
    <verse number="7" style="v"/>tadaa te papracchu.h, he guro gha.taned.r"sii kadaa bhavi.syati? gha.tanaayaa etasyasa"scihna.m vaa ki.m bhavi.syati?</para>
  <para style="p">
    <verse number="8" style="v"/>tadaa sa jagaada, saavadhaanaa bhavata yathaa yu.smaaka.m bhrama.m kopi na janayati, khii.s.tohamityuktvaa mama naamraa bahava upasthaasyanti sa kaala.h praaye.nopasthita.h, te.saa.m pa"scaanmaa gacchata|</para>
  <para style="p">
    <verse number="9" style="v"/>yuddhasyopaplavasya ca vaarttaa.m "srutvaa maa "sa"nkadhva.m, yata.h prathamam etaa gha.tanaa ava"sya.m bhavi.syanti kintu naapaate yugaanto bhavi.syati|</para>
  <para style="p">
    <verse number="10" style="v"/>apara nca kathayaamaasa, tadaa de"sasya vipak.satvena de"so raajyasya vipak.satvena raajyam utthaasyati,</para>
  <para style="p">
    <verse number="11" style="v"/>naanaasthaane.su mahaabhuukampo durbhik.sa.m maarii ca bhavi.syanti, tathaa vyomama.n.dalasya bhaya"nkaradar"sanaanya"scaryyalak.sa.naani ca prakaa"sayi.syante|</para>
  <para style="p">
    <verse number="12" style="v"/>kintu sarvvaasaametaasaa.m gha.tanaanaa.m puurvva.m lokaa yu.smaan dh.rtvaa taa.dayi.syanti, bhajanaalaye kaaraayaa nca samarpayi.syanti mama naamakaara.naad yu.smaan bhuupaanaa.m "saasakaanaa nca sammukha.m ne.syanti ca|</para>
  <para style="p">
    <verse number="13" style="v"/>saak.syaartham etaani yu.smaan prati gha.ti.syante|</para>
  <para style="p">
    <verse number="14" style="v"/>tadaa kimuttara.m vaktavyam etat na cintayi.syaama iti mana.hsu ni"scitanuta|</para>
  <para style="p">
    <verse number="15" style="v"/>vipak.saa yasmaat kimapyuttaram aapatti nca karttu.m na "sak.syanti taad.r"sa.m vaakpa.tutva.m j naana nca yu.smabhya.m daasyaami|</para>
  <para style="p">
    <verse number="16" style="v"/>ki nca yuuya.m pitraa maatraa bhraatraa bandhunaa j naatyaa ku.tumbena ca parakare.su samarpayi.syadhve; tataste yu.smaaka.m ka ncana ka ncana ghaatayi.syanti|</para>
  <para style="p">
    <verse number="17" style="v"/>mama naamna.h kaara.naat sarvvai rmanu.syai ryuuyam .rtiiyi.syadhve|</para>
  <para style="p">
    <verse number="18" style="v"/>kintu yu.smaaka.m "sira.hke"saikopi na vina.mk.syati,</para>
  <para style="p">
    <verse number="19" style="v"/>tasmaadeva dhairyyamavalambya svasvapraa.naan rak.sata|</para>
  <para style="p">
    <verse number="20" style="v"/>apara nca yiruu"saalampura.m sainyave.s.tita.m vilokya tasyocchinnataayaa.h samaya.h samiipa ityavagami.syatha|</para>
  <para style="p">
    <verse number="21" style="v"/>tadaa yihuudaade"sasthaa lokaa.h parvvata.m palaayantaa.m, ye ca nagare ti.s.thanti te de"saantara.m palaayantaa, ye ca graame ti.s.thanti te nagara.m na pravi"santu,</para>
  <para style="p">
    <verse number="22" style="v"/>yatastadaa samucitada.n.danaaya dharmmapustake yaani sarvvaa.ni likhitaani taani saphalaani bhavi.syanti|</para>
  <para style="p">
    <verse number="23" style="v"/>kintu yaa yaastadaa garbhavatya.h stanyadaavya"sca taamaa.m durgati rbhavi.syati, yata etaallokaan prati kopo de"se ca vi.samadurgati rgha.ti.syate|</para>
  <para style="p">
    <verse number="24" style="v"/>vastutastu te kha"ngadhaaraparivva"nga.m lapsyante baddhaa.h santa.h sarvvade"se.su naayi.syante ca ki ncaanyade"siiyaanaa.m samayopasthitiparyyanta.m yiruu"saalampura.m tai.h padatalai rdalayi.syate|</para>
  <para style="p">
    <verse number="25" style="v"/>suuryyacandranak.satre.su lak.sa.naadi bhavi.syanti, bhuvi sarvvade"siiyaanaa.m du.hkha.m cintaa ca sindhau viiciinaa.m tarjana.m garjana nca bhavi.syanti|</para>
  <para style="p">
    <verse number="26" style="v"/>bhuubhau bhaavigha.tanaa.m cintayitvaa manujaa bhiyaam.rtakalpaa bhavi.syanti, yato vyomama.n.dale tejasvino dolaayamaanaa bhavi.syanti|</para>
  <para style="p">
    <verse number="27" style="v"/>tadaa paraakrame.naa mahaatejasaa ca meghaaruu.dha.m manu.syaputram aayaanta.m drak.syanti|</para>
  <para style="p">
    <verse number="28" style="v"/>kintvetaasaa.m gha.tanaanaamaarambhe sati yuuya.m mastakaanyuttolya uurdadhva.m drak.syatha, yato yu.smaaka.m mukte.h kaala.h savidho bhavi.syati|</para>
  <para style="p">
    <verse number="29" style="v"/>tatastenaitad.r.s.taantakathaa kathitaa, pa"syata u.dumbaraadiv.rk.saa.naa.m</para>
  <para style="p">
    <verse number="30" style="v"/>naviinapatraa.ni jaataaniiti d.r.s.tvaa nidaavakaala upasthita iti yathaa yuuya.m j naatu.m "saknutha,</para>
  <para style="p">
    <verse number="31" style="v"/>tathaa sarvvaasaamaasaa.m gha.tanaanaam aarambhe d.r.s.te satii"svarasya raajatva.m nika.tam ityapi j naasyatha|</para>
  <para style="p">
    <verse number="32" style="v"/>yu.smaanaha.m yathaartha.m vadaami, vidyamaanalokaanaame.saa.m gamanaat puurvvam etaani gha.ti.syante|</para>
  <para style="p">
    <verse number="33" style="v"/>nabhobhuvorlopo bhavi.syati mama vaak tu kadaapi luptaa na bhavi.syati|</para>
  <para style="p">
    <verse number="34" style="v"/>ataeva vi.samaa"sanena paanena ca saa.mmaarikacintaabhi"sca yu.smaaka.m citte.su matte.su taddinam akasmaad yu.smaan prati yathaa nopati.s.thati tadartha.m sve.su saavadhaanaasti.s.thata|</para>
  <para style="p">
    <verse number="35" style="v"/>p.rthiviisthasarvvalokaan prati taddinam unmaatha iva upasthaasyati|</para>
  <para style="p">
    <verse number="36" style="v"/>yathaa yuuyam etadbhaavigha.tanaa uttarttu.m manujasutasya sammukhe sa.msthaatu nca yogyaa bhavatha kaara.naadasmaat saavadhaanaa.h santo nirantara.m praarthayadhva.m|</para>
  <para style="p">
    <verse number="37" style="v"/>apara nca sa divaa mandira upadi"sya raacai jaitunaadri.m gatvaati.s.that|</para>
  <para style="p">
    <verse number="38" style="v"/>tata.h pratyuu.se laakaastatkathaa.m "srotu.m mandire tadantikam aagacchan|</para>
  <chapter number="22" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>apara nca ki.nva"suunyapuupotsavasya kaala upasthite</para>
  <para style="p">
    <verse number="2" style="v"/>pradhaanayaajakaa adhyaayakaa"sca yathaa ta.m hantu.m "saknuvanti tathopaayaam ace.s.tanta kintu lokebhyo bibhyu.h|</para>
  <para style="p">
    <verse number="3" style="v"/>etastin samaye dvaada"sa"si.sye.su ga.nita ii.skariyotiiyaruu.dhimaan yo yihuudaastasyaanta.hkara.na.m "saitaanaa"sritatvaat</para>
  <para style="p">
    <verse number="4" style="v"/>sa gatvaa yathaa yii"su.m te.saa.m kare.su samarpayitu.m "saknoti tathaa mantra.naa.m pradhaanayaajakai.h senaapatibhi"sca saha cakaara|</para>
  <para style="p">
    <verse number="5" style="v"/>tena te tu.s.taastasmai mudraa.m daatu.m pa.na.m cakru.h|</para>
  <para style="p">
    <verse number="6" style="v"/>tata.h so"ngiik.rtya yathaa lokaanaamagocare ta.m parakare.su samarpayitu.m "saknoti tathaavakaa"sa.m ce.s.titumaarebhe|</para>
  <para style="p">
    <verse number="7" style="v"/>atha ki.nva"suunyapuupotmavadine, arthaat yasmin dine nistaarotsavasya me.so hantavyastasmin dine</para>
  <para style="p">
    <verse number="8" style="v"/>yii"su.h pitara.m yohana ncaahuuya jagaada, yuvaa.m gatvaasmaaka.m bhojanaartha.m nistaarotsavasya dravyaa.nyaasaadayata.m|</para>
  <para style="p">
    <verse number="9" style="v"/>tadaa tau papracchatu.h kucaasaadayaavo bhavata.h kecchaa?</para>
  <para style="p">
    <verse number="10" style="v"/>tadaa sovaadiit, nagare pravi.s.te ka"scijjalakumbhamaadaaya yuvaa.m saak.saat kari.syati sa yannive"sana.m pravi"sati yuvaamapi tannive"sana.m tatpa"scaaditvaa nive"sanapatim iti vaakya.m vadata.m,</para>
  <para style="p">
    <verse number="11" style="v"/>yatraaha.m nistaarotsavasya bhojya.m "si.syai.h saarddha.m bhoktu.m "saknomi saatithi"saalaaा kutra? kathaamimaa.m prabhustvaa.m p.rcchati|</para>
  <para style="p">
    <verse number="12" style="v"/>tata.h sa jano dvitiiyaprako.s.thiiyam eka.m "sasta.m ko.s.tha.m dar"sayi.syati tatra bhojyamaasaadayata.m|</para>
  <para style="p">
    <verse number="13" style="v"/>tatastau gatvaa tadvaakyaanusaare.na sarvva.m d.r.sdvaa tatra nistaarotsaviiya.m bhojyamaasaadayaamaasatu.h|</para>
  <para style="p">
    <verse number="14" style="v"/>atha kaala upasthite yii"su rdvaada"sabhi.h preritai.h saha bhoktumupavi"sya kathitavaan</para>
  <para style="p">
    <verse number="15" style="v"/>mama du.hkhabhogaat puurvva.m yubhaabhi.h saha nistaarotsavasyaitasya bhojya.m bhoktu.m mayaativaa nchaa k.rtaa|</para>
  <para style="p">
    <verse number="16" style="v"/>yu.smaan vadaami, yaavatkaalam ii"svararaajye bhojana.m na kari.sye taavatkaalam ida.m na bhok.sye|</para>
  <para style="p">
    <verse number="17" style="v"/>tadaa sa paanapaatramaadaaya ii"svarasya gu.naan kiirttayitvaa tebhyo datvaavadat, ida.m g.rhliita yuuya.m vibhajya pivata|</para>
  <para style="p">
    <verse number="18" style="v"/>yu.smaan vadaami yaavatkaalam ii"svararaajatvasya sa.msthaapana.m na bhavati taavad draak.saaphalarasa.m na paasyaami|</para>
  <para style="p">
    <verse number="19" style="v"/>tata.h puupa.m g.rhiitvaa ii"svaragu.naan kiirttayitvaa bha"nktaa tebhyo datvaavadat, yu.smadartha.m samarpita.m yanmama vapustadida.m, etat karmma mama smara.naartha.m kurudhva.m|</para>
  <para style="p">
    <verse number="20" style="v"/>atha bhojanaante taad.r"sa.m paatra.m g.rhiitvaavadat, yu.smatk.rte paatita.m yanmama rakta.m tena nir.niitanavaniyamaruupa.m paanapaatramida.m|</para>
  <para style="p">
    <verse number="21" style="v"/>pa"syata yo maa.m parakare.su samarpayi.syati sa mayaa saha bhojanaasana upavi"sati|</para>
  <para style="p">
    <verse number="22" style="v"/>yathaa niruupitamaaste tadanusaare.naa manu.syapuुtrasya gati rbhavi.syati kintu yasta.m parakare.su samarpayi.syati tasya santaapo bhavi.syati|</para>
  <para style="p">
    <verse number="23" style="v"/>tadaa te.saa.m ko jana etat karmma kari.syati tat te paraspara.m pra.s.tumaarebhire|</para>
  <para style="p">
    <verse number="24" style="v"/>apara.m te.saa.m ko jana.h "sre.s.thatvena ga.nayi.syate, atraarthe te.saa.m vivaadobhavat|</para>
  <para style="p">
    <verse number="25" style="v"/>asmaat kaara.naat sovadat, anyade"siiyaanaa.m raajaana.h prajaanaamupari prabhutva.m kurvvanti daaru.na"saasana.m k.rtvaapi te bhuupatitvena vikhyaataa bhavanti ca|</para>
  <para style="p">
    <verse number="26" style="v"/>kintu yu.smaaka.m tathaa na bhavi.syati, yo yu.smaaka.m "sre.s.tho bhavi.syati sa kani.s.thavad bhavatu, ya"sca mukhyo bhavi.syati sa sevakavadbhavatu|</para>
  <para style="p">
    <verse number="27" style="v"/>bhojanopavi.s.taparicaarakayo.h ka.h "sre.s.tha.h? yo bhojanaayopavi"sati sa ki.m "sre.s.tho na bhavati? kintu yu.smaaka.m madhye.aha.m paricaaraka_ivaasmi|</para>
  <para style="p">
    <verse number="28" style="v"/>apara nca yuya.m mama pariik.saakaale prathamamaarabhya mayaa saha sthitaa</para>
  <para style="p">
    <verse number="29" style="v"/>etatkaara.naat pitraa yathaa madartha.m raajyameka.m niruupita.m tathaahamapi yu.smadartha.m raajya.m niruupayaami|</para>
  <para style="p">
    <verse number="30" style="v"/>tasmaan mama raajye bhojanaasane ca bhojanapaane kari.syadhve si.mhaasane.suupavi"sya cesraayeliiyaanaa.m dvaada"sava.m"saanaa.m vicaara.m kari.syadhve|</para>
  <para style="p">
    <verse number="31" style="v"/>apara.m prabhuruvaaca, he "simon pa"sya tita_unaa dhaanyaaniiva yu.smaan "saitaan caalayitum aicchat,</para>
  <para style="p">
    <verse number="32" style="v"/>kintu tava vi"svaasasya lopo yathaa na bhavati etat tvadartha.m praarthita.m mayaa, tvanmanasi parivarttite ca bhraat.r.naa.m manaa.msi sthiriikuru|</para>
  <para style="p">
    <verse number="33" style="v"/>tadaa sovadat, he prabhoha.m tvayaa saarddha.m kaaraa.m m.rti nca yaatu.m majjitosmi|</para>
  <para style="p">
    <verse number="34" style="v"/>tata.h sa uvaaca, he pitara tvaa.m vadaami, adya kukku.taravaat puurvva.m tva.m matparicaya.m vaaratrayam apahvo.syase|</para>
  <para style="p">
    <verse number="35" style="v"/>apara.m sa papraccha, yadaa mudraasampu.ta.m khaadyapaatra.m paadukaa nca vinaa yu.smaan praahi.nava.m tadaa yu.smaaka.m kasyaapi nyuunataasiit? te procu.h kasyaapi na|</para>
  <para style="p">
    <verse number="36" style="v"/>tadaa sovadat kintvidaanii.m mudraasampu.ta.m khaadyapaatra.m vaa yasyaasti tena tadgrahiitavya.m, yasya ca k.rpaa.noे naasti tena svavastra.m vikriiya sa kretavya.h|</para>
  <para style="p">
    <verse number="37" style="v"/>yato yu.smaanaha.m vadaami, aparaadhijanai.h saarddha.m ga.nita.h sa bhavi.syati| ida.m yacchaastriiya.m vacana.m likhitamasti tanmayi phali.syati yato mama sambandhiiya.m sarvva.m setsyati|</para>
  <para style="p">
    <verse number="38" style="v"/>tadaa te procu.h prabho pa"sya imau k.rpaa.nau| tata.h sovadad etau yathe.s.tau|</para>
  <para style="p">
    <verse number="39" style="v"/>atha sa tasmaadvahi rgatvaa svaacaaraanusaare.na jaitunanaamaadri.m jagaama "si.syaa"sca tatpa"scaad yayu.h|</para>
  <para style="p">
    <verse number="40" style="v"/>tatropasthaaya sa taanuvaaca, yathaa pariik.saayaa.m na patatha tadartha.m praarthayadhva.m|</para>
  <para style="p">
    <verse number="41" style="v"/>pa"scaat sa tasmaad eka"sarak.sepaad bahi rgatvaa jaanunii paatayitvaa etat praarthayaa ncakre,</para>
  <para style="p">
    <verse number="42" style="v"/>he pita ryadi bhavaan sammanyate tarhi ka.msamena.m mamaantikaad duuraya kintu madicchaanuruupa.m na tvadicchaanuruupa.m bhavatu|</para>
  <para style="p">
    <verse number="43" style="v"/>tadaa tasmai "sakti.m daatu.m svargiiyaduuto dar"sana.m dadau|</para>
  <para style="p">
    <verse number="44" style="v"/>pa"scaat sotyanta.m yaatanayaa vyaakulo bhuutvaa punard.r.dha.m praarthayaa ncakre, tasmaad b.rhaccho.nitabindava iva tasya svedabindava.h p.rthivyaa.m patitumaarebhire|</para>
  <para style="p">
    <verse number="45" style="v"/>atha praarthanaata utthaaya "si.syaa.naa.m samiipametya taan manodu.hkhino nidritaan d.r.s.tvaavadat</para>
  <para style="p">
    <verse number="46" style="v"/>kuto nidraatha? pariik.saayaam apatanaartha.m prarthayadhva.m|</para>
  <para style="p">
    <verse number="47" style="v"/>etatkathaayaa.h kathanakaale dvaada"sa"si.syaa.naa.m madhye ga.nito yihuudaanaamaa janataasahitaste.saam agre calitvaa yii"so"scumbanaartha.m tadantikam aayayau|</para>
  <para style="p">
    <verse number="48" style="v"/>tadaa yii"suruvaaca, he yihuudaa ki.m cumbanena manu.syaputra.m parakare.su samarpayasi?</para>
  <para style="p">
    <verse number="49" style="v"/>tadaa yadyad gha.ti.syate tadanumaaya sa"ngibhirukta.m, he prabho vaya.m ki kha"ngena ghaatayi.syaama.h?</para>
  <para style="p">
    <verse number="50" style="v"/>tata eka.h karavaalenaahatya pradhaanayaajakasya daasasya dak.si.na.m kar.na.m ciccheda|</para>
  <para style="p">
    <verse number="51" style="v"/>adhuunaa nivarttasva ityuktvaa yii"sustasya "sruti.m sp.r.s.tvaa svasya.m cakaara|</para>
  <para style="p">
    <verse number="52" style="v"/>pa"scaad yii"su.h samiipasthaan pradhaanayaajakaan mandirasya senaapatiin praaciinaa.m"sca jagaada, yuuya.m k.rpaa.naan ya.s.tii.m"sca g.rhiitvaa maa.m ki.m cora.m dharttumaayaataa.h?</para>
  <para style="p">
    <verse number="53" style="v"/>yadaaha.m yu.smaabhi.h saha pratidina.m mandire.ati.s.tha.m tadaa maa.m dhartta.m na prav.rttaa.h, kintvidaanii.m yu.smaaka.m samayondhakaarasya caadhipatyamasti|</para>
  <para style="p">
    <verse number="54" style="v"/>atha te ta.m dh.rtvaa mahaayaajakasya nive"sana.m ninyu.h| tata.h pitaro duure duure pa"scaaditvaa</para>
  <para style="p">
    <verse number="55" style="v"/>b.rhatko.s.thasya madhye yatraagni.m jvaalayitvaa lokaa.h sametyopavi.s.taastatra tai.h saarddham upavive"sa|</para>
  <para style="p">
    <verse number="56" style="v"/>atha vahnisannidhau samupave"sakaale kaaciddaasii mano nivi"sya ta.m niriik.syaavadat pumaanaya.m tasya sa"nge.asthaat|</para>
  <para style="p">
    <verse number="57" style="v"/>kintu sa tad apahnutyaavaadiit he naari tamaha.m na paricinomi|</para>
  <para style="p">
    <verse number="58" style="v"/>k.sa.naantare.anyajanasta.m d.r.s.tvaabraviit tvamapi te.saa.m nikarasyaikajanosi| pitara.h pratyuvaaca he nara naahamasmi|</para>
  <para style="p">
    <verse number="59" style="v"/>tata.h saarddhada.n.dadvayaat para.m punaranyo jano ni"scitya babhaa.se, e.sa tasya sa"ngiiti satya.m yatoya.m gaaliiliiyo loka.h|</para>
  <para style="p">
    <verse number="60" style="v"/>tadaa pitara uvaaca he nara tva.m yad vadami tadaha.m boddhu.m na "saknomi, iti vaakye kathitamaatre kukku.to ruraava|</para>
  <para style="p">
    <verse number="61" style="v"/>tadaa prabhu.naa vyaadhu.tya pitare niriik.site k.rkavaakuravaat puurvva.m maa.m trirapahno.syase iti puurvvokta.m tasya vaakya.m pitara.h sm.rtvaa</para>
  <para style="p">
    <verse number="62" style="v"/>bahirgatvaa mahaakhedena cakranda|</para>
  <para style="p">
    <verse number="63" style="v"/>tadaa yai ryii"surdh.rtaste tamupahasya praharttumaarebhire|</para>
  <para style="p">
    <verse number="64" style="v"/>vastre.na tasya d.r"sau baddhvaa kapole cape.taaghaata.m k.rtvaa papracchu.h, kaste kapole cape.taaghaata.m k.rtavaana? ga.nayitvaa tad vada|</para>
  <para style="p">
    <verse number="65" style="v"/>tadanyat tadviruddha.m bahunindaavaakya.m vaktumaarebhire|</para>
  <para style="p">
    <verse number="66" style="v"/>atha prabhaate sati lokapraa nca.h pradhaanayaajakaa adhyaapakaa"sca sabhaa.m k.rtvaa madhyesabha.m yii"sumaaniiya papracchu.h, tvam abhi.sikatosi na vaasmaan vada|</para>
  <para style="p">
    <verse number="67" style="v"/>sa pratyuvaaca, mayaa tasminnukte.api yuuya.m na vi"svasi.syatha|</para>
  <para style="p">
    <verse number="68" style="v"/>kasmi.m"scidvaakye yu.smaan p.r.s.te.api maa.m na taduttara.m vak.syatha na maa.m tyak.syatha ca|</para>
  <para style="p">
    <verse number="69" style="v"/>kintvita.h para.m manujasuta.h sarvva"saktimata ii"svarasya dak.si.ne paar"sve samupavek.syati|</para>
  <para style="p">
    <verse number="70" style="v"/>tataste papracchu.h, rtiha tvamii"svarasya putra.h? sa kathayaamaasa, yuuya.m yathaartha.m vadatha sa evaaha.m|</para>
  <para style="p">
    <verse number="71" style="v"/>tadaa te sarvve kathayaamaasu.h, rtiha saak.sye.ansasmin asmaaka.m ki.m prayojana.m? asya svamukhaadeva saak.sya.m praaptam|</para>
  <chapter number="23" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>tata.h sabhaasthaa.h sarvvalokaa utthaaya ta.m piilaatasammukha.m niitvaaprodya vaktumaarebhire,</para>
  <para style="p">
    <verse number="2" style="v"/>svamabhi.sikta.m raajaana.m vadanta.m kaimararaajaaya karadaana.m ni.sedhanta.m raajyaviparyyaya.m kurttu.m pravarttamaanam ena praaptaa vaya.m|</para>
  <para style="p">
    <verse number="3" style="v"/>tadaa piilaatasta.m p.r.s.tavaan tva.m ki.m yihuudiiyaanaa.m raajaa? sa pratyuvaaca tva.m satyamuktavaan|</para>
  <para style="p">
    <verse number="4" style="v"/>tadaa piilaata.h pradhaanayaajakaadilokaan jagaad, ahametasya kamapyaparaadha.m naaptavaan|</para>
  <para style="p">
    <verse number="5" style="v"/>tataste puna.h saahamino bhuutvaavadan, e.sa gaaliila etatsthaanaparyyante sarvvasmin yihuudaade"se sarvvaallokaanupadi"sya kuprav.rtti.m graahiitavaan|</para>
  <para style="p">
    <verse number="6" style="v"/>tadaa piilaato gaaliilaprade"sasya naama "srutvaa papraccha, kimaya.m gaaliiliiyo loka.h?</para>
  <para style="p">
    <verse number="7" style="v"/>tata.h sa gaaliilprade"siiyaherodraajasya tadaa sthitestasya samiipe yii"su.m pre.sayaamaasa|</para>
  <para style="p">
    <verse number="8" style="v"/>tadaa herod yii"su.m vilokya santuto.sa, yata.h sa tasya bahuv.rttaanta"srava.naat tasya ki ni्cadaa"scaryyakarmma pa"syati ityaa"saa.m k.rtvaa bahukaalamaarabhya ta.m dra.s.tu.m prayaasa.m k.rtavaan|</para>
  <para style="p">
    <verse number="9" style="v"/>tasmaat ta.m bahukathaa.h papraccha kintu sa tasya kasyaapi vaakyasya pratyuttara.m novaaca|</para>
  <para style="p">
    <verse number="10" style="v"/>atha pradhaanayaajakaa adhyaapakaa"sca protti.s.thanta.h saahasena tamapavaditu.m praarebhire|</para>
  <para style="p">
    <verse number="11" style="v"/>herod tasya senaaga.na"sca tamavaj naaya upahaasatvena raajavastra.m paridhaapya puna.h piilaata.m prati ta.m praahi.not|</para>
  <para style="p">
    <verse number="12" style="v"/>puurvva.m herodpiilaatayo.h paraspara.m vairabhaava aasiit kintu taddine dvayo rmelana.m jaatam|</para>
  <para style="p">
    <verse number="13" style="v"/>pa"scaat piilaata.h pradhaanayaajakaan "saasakaan lokaa.m"sca yugapadaahuuya babhaa.se,</para>
  <para style="p">
    <verse number="14" style="v"/>raajyaviparyyayakaarakoyam ityuktvaa manu.syamena.m mama nika.tamaanai.s.ta kintu pa"syata yu.smaaka.m samak.sam asya vicaara.m k.rtvaapi proktaapavaadaanuruupe.naasya kopyaparaadha.h sapramaa.no na jaata.h,</para>
  <para style="p">
    <verse number="15" style="v"/>yuuya nca heroda.h sannidhau pre.sitaa mayaa tatraasya kopyaparaadhastenaapi na praapta.h|pa"syataanena vadhaheेtuka.m kimapi naaparaaddha.m|</para>
  <para style="p">
    <verse number="16" style="v"/>tasmaadena.m taa.dayitvaa vihaasyaami|</para>
  <para style="p">
    <verse number="17" style="v"/>tatrotsave te.saameko mocayitavya.h|</para>
  <para style="p">
    <verse number="18" style="v"/>iti hetoste proccairekadaa procu.h, ena.m duuriik.rtya barabbaanaamaana.m mocaya|</para>
  <para style="p">
    <verse number="19" style="v"/>sa barabbaa nagara upaplavavadhaaparaadhaabhyaa.m kaaraayaa.m baddha aasiit|</para>
  <para style="p">
    <verse number="20" style="v"/>kintu piilaato yii"su.m mocayitu.m vaa nchan punastaanuvaaca|</para>
  <para style="p">
    <verse number="21" style="v"/>tathaapyena.m kru"se vyadha kru"se vyadheti vadantaste ruruvu.h|</para>
  <para style="p">
    <verse number="22" style="v"/>tata.h sa t.rtiiyavaara.m jagaada kuta.h? sa ki.m karmma k.rtavaan? naahamasya kamapi vadhaaparaadha.m praapta.h kevala.m taa.dayitvaamu.m tyajaami|</para>
  <para style="p">
    <verse number="23" style="v"/>tathaapi te punarena.m kru"se vyadha ityuktvaa proccaird.r.dha.m praarthayaa ncakrire;</para>
  <para style="p">
    <verse number="24" style="v"/>tata.h pradhaanayaajakaadiinaa.m kalarave prabale sati te.saa.m praarthanaaruupa.m karttu.m piilaata aadide"sa|</para>
  <para style="p">
    <verse number="25" style="v"/>raajadrohavadhayoraparaadhena kaaraastha.m ya.m jana.m te yayaacire ta.m mocayitvaa yii"su.m te.saamicchaayaa.m samaarpayat|</para>
  <para style="p">
    <verse number="26" style="v"/>atha te yii"su.m g.rhiitvaa yaanti, etarhi graamaadaagata.m "simonanaamaana.m kurii.niiya.m jana.m dh.rtvaa yii"so.h pa"scaannetu.m tasya skandhe kru"samarpayaamaasu.h|</para>
  <para style="p">
    <verse number="27" style="v"/>tato loाkaara.nyamadhye bahustriyo rudatyo vilapantya"sca yii"so.h pa"scaad yayu.h|</para>
  <para style="p">
    <verse number="28" style="v"/>kintu sa vyaaghu.tya taa uvaaca, he yiruu"saalamo naaryyo yuya.m madartha.m na ruditvaa svaartha.m svaapatyaartha nca ruditi;</para>
  <para style="p">
    <verse number="29" style="v"/>pa"syata ya.h kadaapi garbhavatyo naabhavan stanya nca naapaayayan taad.r"sii rvandhyaa yadaa dhanyaa vak.syanti sa kaala aayaati|</para>
  <para style="p">
    <verse number="30" style="v"/>tadaa he "sailaa asmaakamupari patata, he upa"sailaa asmaanaacchaadayata kathaamiid.r"sii.m lokaa vak.syanti|</para>
  <para style="p">
    <verse number="31" style="v"/>yata.h satejasi "saakhini cedetad gha.tate tarhi "su.ska"saakhini ki.m na gha.ti.syate?</para>
  <para style="p">
    <verse number="32" style="v"/>tadaa te hantu.m dvaavaparaadhinau tena saarddha.m ninyu.h|</para>
  <para style="p">
    <verse number="33" style="v"/>apara.m "sira.hkapaalanaamakasthaana.m praapya ta.m kru"se vividhu.h; taddvayoraparaadhinoreka.m tasya dak.si.no tadanya.m vaame kru"se vividhu.h|</para>
  <para style="p">
    <verse number="34" style="v"/>tadaa yii"surakathayat, he pitaretaan k.samasva yata ete yat karmma kurvvanti tan na vidu.h; pa"scaatte gu.tikaapaata.m k.rtvaa tasya vastraa.ni vibhajya jag.rhu.h|</para>
  <para style="p">
    <verse number="35" style="v"/>tatra lokasa.mghasti.s.than dadar"sa; te te.saa.m "saasakaa"sca tamupahasya jagadu.h, e.sa itaraan rak.sitavaan yadii"svare.naabhirucito .abhi.siktastraataa bhavati tarhi svamadhunaa rak.satu|</para>
  <para style="p">
    <verse number="36" style="v"/>tadanya.h senaaga.naa etya tasmai amlarasa.m datvaa parihasya provaaca,</para>
  <para style="p">
    <verse number="37" style="v"/>cettva.m yihuudiiyaanaa.m raajaasi tarhi sva.m rak.sa|</para>
  <para style="p">
    <verse number="38" style="v"/>yihuudiiyaanaa.m raajeti vaakya.m yuunaaniiyaromiiyebriiyaak.sarai rlikhita.m tacchirasa uurddhve.asthaapyata|</para>
  <para style="p">
    <verse number="39" style="v"/>tadobhayapaar"svayo rviddhau yaavaparaadhinau tayorekasta.m vinindya babhaa.se, cettvam abhi.siktosi tarhi svamaavaa nca rak.sa|</para>
  <para style="p">
    <verse number="40" style="v"/>kintvanyasta.m tarjayitvaavadat, ii"svaraattava ki ncidapi bhaya.m naasti ki.m? tvamapi samaanada.n.dosi,</para>
  <para style="p">
    <verse number="41" style="v"/>yogyapaatre aavaa.m svasvakarmma.naa.m samucitaphala.m praapnuva.h kintvanena kimapi naaparaaddha.m|</para>
  <para style="p">
    <verse number="42" style="v"/>atha sa yii"su.m jagaada he prabhe bhavaan svaraajyaprave"sakaale maa.m smaratu|</para>
  <para style="p">
    <verse number="43" style="v"/>tadaa yii"su.h kathitavaan tvaa.m yathaartha.m vadaami tvamadyaiva mayaa saarddha.m paralokasya sukhasthaana.m praapsyasi|</para>
  <para style="p">
    <verse number="44" style="v"/>apara nca dvitiiyayaamaat t.rtiiyayaamaparyyanta.m ravestejasontarhitatvaat sarvvade"so.andhakaare.naav.rto</para>
  <para style="p">
    <verse number="45" style="v"/>mandirasya yavanikaa ca chidyamaanaa dvidhaa babhuuva|</para>
  <para style="p">
    <verse number="46" style="v"/>tato yii"suruccairuvaaca, he pita rmamaatmaana.m tava kare samarpaye, ityuktvaa sa praa.naan jahau|</para>
  <para style="p">
    <verse number="47" style="v"/>tadaitaa gha.tanaa d.r.s.tvaa "satasenaapatirii"svara.m dhanyamuktvaa kathitavaan aya.m nitaanta.m saadhumanu.sya aasiit|</para>
  <para style="p">
    <verse number="48" style="v"/>atha yaavanto lokaa dra.s.tum aagataaste taa gha.tanaa d.r.s.tvaa vak.sa.hsu karaaghaata.m k.rtvaa vyaacu.tya gataa.h|</para>
  <para style="p">
    <verse number="49" style="v"/>yii"so rj naatayo yaa yaa yo.sita"sca gaaliilastena saarddhamaayaataastaa api duure sthitvaa tat sarvva.m dad.r"su.h|</para>
  <para style="p">
    <verse number="50" style="v"/>tadaa yihuudiiyaanaa.m mantra.naa.m kriyaa ncaasammanyamaana ii"svarasya raajatvam apek.samaa.no</para>
  <para style="p">
    <verse number="51" style="v"/>yihuudide"siiyo .arimathiiyanagariiyo yuu.saphnaamaa mantrii bhadro dhaarmmika"sca pumaan</para>
  <para style="p">
    <verse number="52" style="v"/>piilaataantika.m gatvaa yii"so rdeha.m yayaace|</para>
  <para style="p">
    <verse number="53" style="v"/>pa"scaad vapuravarohya vaasasaa sa.mve.s.tya yatra kopi maanu.so naasthaapyata tasmin "saile svaate "sma"saane tadasthaapayat|</para>
  <para style="p">
    <verse number="54" style="v"/>taddinamaayojaniiya.m dina.m vi"sraamavaara"sca samiipa.h|</para>
  <para style="p">
    <verse number="55" style="v"/>apara.m yii"sunaa saarddha.m gaaliila aagataa yo.sita.h pa"scaaditvaa "sma"saane tatra yathaa vapu.h sthaapita.m tacca d.r.s.tvaa</para>
  <para style="p">
    <verse number="56" style="v"/>vyaaghu.tya sugandhidravyatailaani k.rtvaa vidhivad vi"sraamavaare vi"sraama.m cakru.h|</para>
  <chapter number="24" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>atha saptaahaprathamadine.atipratyuu.se taa yo.sita.h sampaadita.m sugandhidravya.m g.rhiitvaa tadanyaabhi.h kiyatiibhi.h striibhi.h saha "sma"saana.m yayu.h|</para>
  <para style="p">
    <verse number="2" style="v"/>kintu "sma"saanadvaaraat paa.saa.namapasaarita.m d.r.s.tvaa</para>
  <para style="p">
    <verse number="3" style="v"/>taa.h pravi"sya prabho rdehamapraapya</para>
  <para style="p">
    <verse number="4" style="v"/>vyaakulaa bhavanti etarhi tejomayavastraanvitau dvau puru.sau taasaa.m samiipe samupasthitau</para>
  <para style="p">
    <verse number="5" style="v"/>tasmaattaa.h "sa"nkaayuktaa bhuumaavadhomukhyasyasthu.h| tadaa tau taa uucatu rm.rtaanaa.m madhye jiivanta.m kuto m.rgayatha?</para>
  <para style="p">
    <verse number="6" style="v"/>sotra naasti sa udasthaat|</para>
  <para style="p">
    <verse number="7" style="v"/>paapinaa.m kare.su samarpitena kru"se hatena ca manu.syaputre.na t.rtiiyadivase "sma"saanaadutthaatavyam iti kathaa.m sa galiili ti.s.than yu.smabhya.m kathitavaan taa.m smarata|</para>
  <para style="p">
    <verse number="8" style="v"/>tadaa tasya saa kathaa taasaa.m mana.hsu jaataa|</para>
  <para style="p">
    <verse number="9" style="v"/>anantara.m "sma"saanaad gatvaa taa ekaada"sa"si.syaadibhya.h sarvvebhyastaa.m vaarttaa.m kathayaamaasu.h|</para>
  <para style="p">
    <verse number="10" style="v"/>magdaliiniimariyam, yohanaa, yaakuubo maataa mariyam tadanyaa.h sa"nginyo yo.sita"sca preritebhya etaa.h sarvvaa vaarttaa.h kathayaamaasu.h</para>
  <para style="p">
    <verse number="11" style="v"/>kintu taasaa.m kathaam anarthakaakhyaanamaatra.m buddhvaa kopi na pratyait|</para>
  <para style="p">
    <verse number="12" style="v"/>tadaa pitara utthaaya "sma"saanaantika.m dadhaava, tatra ca prahvo bhuutvaa paar"svaikasthaapita.m kevala.m vastra.m dadar"sa; tasmaadaa"scaryya.m manyamaano yadagha.tata tanmanasi vicaarayan pratasthe|</para>
  <para style="p">
    <verse number="13" style="v"/>tasminneva dine dvau "siyyau yiruu"saalama"scatu.skro"saantaritam immaayugraama.m gacchantau</para>
  <para style="p">
    <verse number="14" style="v"/>taasaa.m gha.tanaanaa.m kathaamakathayataa.m</para>
  <para style="p">
    <verse number="15" style="v"/>tayoraalaapavicaarayo.h kaale yii"suraagatya taabhyaa.m saha jagaama</para>
  <para style="p">
    <verse number="16" style="v"/>kintu yathaa tau ta.m na paricinutastadartha.m tayo rd.r.s.ti.h sa.mruddhaa|</para>
  <para style="p">
    <verse number="17" style="v"/>sa tau p.r.s.tavaan yuvaa.m vi.sa.n.nau ki.m vicaarayantau gacchatha.h?</para>
  <para style="p">
    <verse number="18" style="v"/>tatastayo.h kliyapaanaamaa pratyuvaaca yiruu"saalamapure.adhunaa yaanyagha.tanta tva.m kevalavide"sii ki.m tadv.rttaanta.m na jaanaasi?</para>
  <para style="p">
    <verse number="19" style="v"/>sa papraccha kaa gha.tanaa.h? tadaa tau vaktumaarebhaate yii"sunaamaa yo naasaratiiyo bhavi.syadvaadii ii"svarasya maanu.saa.naa nca saak.saat vaakye karmma.ni ca "saktimaanaasiit</para>
  <para style="p">
    <verse number="20" style="v"/>tam asmaaka.m pradhaanayaajakaa vicaarakaa"sca kenaapi prakaare.na kru"se viddhvaa tasya praa.naananaa"sayan tadiiyaa gha.tanaa.h;</para>
  <para style="p">
    <verse number="21" style="v"/>kintu ya israayeliiyalokaan uddhaarayi.syati sa evaayam ityaa"saasmaabhi.h k.rtaa|tadyathaa tathaastu tasyaa gha.tanaayaa adya dinatraya.m gata.m|</para>
  <para style="p">
    <verse number="22" style="v"/>adhikantvasmaaka.m sa"nginiinaa.m kiyatstrii.naa.m mukhebhyo.asambhavavaakyamida.m "sruta.m;</para>
  <para style="p">
    <verse number="23" style="v"/>taa.h pratyuu.se "sma"saana.m gatvaa tatra tasya deham apraapya vyaaghu.tyetvaa proktavatya.h svargiisaduutau d.r.s.taavasmaabhistau caavaadi.s.taa.m sa jiivitavaan|</para>
  <para style="p">
    <verse number="24" style="v"/>tatosmaaka.m kai"scit "sma"saanamagamyata te.api strii.naa.m vaakyaanuruupa.m d.r.s.tavanta.h kintu ta.m naapa"syan|</para>
  <para style="p">
    <verse number="25" style="v"/>tadaa sa taavuvaaca, he abodhau he bhavi.syadvaadibhiruktavaakya.m pratyetu.m vilambamaanau;</para>
  <para style="p">
    <verse number="26" style="v"/>etatsarvvadu.hkha.m bhuktvaa svabhuutipraapti.h ki.m khrii.s.tasya na nyaayyaa?</para>
  <para style="p">
    <verse number="27" style="v"/>tata.h sa muusaagranthamaarabhya sarvvabhavi.syadvaadinaa.m sarvva"saastre svasmin likhitaakhyaanaabhipraaya.m bodhayaamaasa|</para>
  <para style="p">
    <verse number="28" style="v"/>atha gamyagraamaabhyar.na.m praapya tenaagre gamanalak.sa.ne dar"site</para>
  <para style="p">
    <verse number="29" style="v"/>tau saadhayitvaavadataa.m sahaavaabhyaa.m ti.s.tha dine gate sati raatrirabhuut; tata.h sa taabhyaa.m saarddha.m sthaatu.m g.rha.m yayau|</para>
  <para style="p">
    <verse number="30" style="v"/>pa"scaadbhojanopave"sakaale sa puupa.m g.rhiitvaa ii"svaragu.naan jagaada ta nca bha.mktvaa taabhyaa.m dadau|</para>
  <para style="p">
    <verse number="31" style="v"/>tadaa tayo rd.r.s.tau prasannaayaa.m ta.m pratyabhij natu.h kintu sa tayo.h saak.saadantardadhe|</para>
  <para style="p">
    <verse number="32" style="v"/>tatastau mithobhidhaatum aarabdhavantau gamanakaale yadaa kathaamakathayat "saastraartha ncabodhayat tadaavayo rbuddhi.h ki.m na praajvalat?</para>
  <para style="p">
    <verse number="33" style="v"/>tau tatk.sa.naadutthaaya yiruu"saalamapura.m pratyaayayatu.h, tatsthaane "si.syaa.naam ekaada"saanaa.m sa"nginaa nca dar"sana.m jaata.m|</para>
  <para style="p">
    <verse number="34" style="v"/>te procu.h prabhurudati.s.thad iti satya.m "simone dar"sanamadaacca|</para>
  <para style="p">
    <verse number="35" style="v"/>tata.h patha.h sarvvagha.tanaayaa.h puupabha njanena tatparicayasya ca sarvvav.rttaanta.m tau vaktumaarebhaate|</para>
  <para style="p">
    <verse number="36" style="v"/>ittha.m te paraspara.m vadanti tatkaale yii"su.h svaya.m te.saa.m madhya protthaya yu.smaaka.m kalyaa.na.m bhuuyaad ityuvaaca,</para>
  <para style="p">
    <verse number="37" style="v"/>kintu bhuuta.m pa"syaama ityanumaaya te samudvivijire tre.su"sca|</para>
  <para style="p">
    <verse number="38" style="v"/>sa uvaaca, kuto du.hkhitaa bhavatha? yu.smaaka.m mana.hsu sandeha udeti ca kuta.h?</para>
  <para style="p">
    <verse number="39" style="v"/>e.soha.m, mama karau pa"syata vara.m sp.r.s.tvaa pa"syata, mama yaad.r"saani pa"syatha taad.r"saani bhuutasya maa.msaasthiini na santi|</para>
  <para style="p">
    <verse number="40" style="v"/>ityuktvaa sa hastapaadaan dar"sayaamaasa|</para>
  <para style="p">
    <verse number="41" style="v"/>te.asambhava.m j naatvaa saanandaa na pratyayan| tata.h sa taan papraccha, atra yu.smaaka.m samiipe khaadya.m ki ncidasti?</para>
  <para style="p">
    <verse number="42" style="v"/>tataste kiyaddagdhamatsya.m madhu ca dadu.h</para>
  <para style="p">
    <verse number="43" style="v"/>sa tadaadaaya te.saa.m saak.saad bubhuje</para>
  <para style="p">
    <verse number="44" style="v"/>kathayaamaasa ca muusaavyavasthaayaa.m bhavi.syadvaadinaa.m granthe.su giitapustake ca mayi yaani sarvvaa.ni vacanaani likhitaani tadanuruupaa.ni gha.ti.syante yu.smaabhi.h saarddha.m sthitvaaha.m yadetadvaakyam avada.m tadidaanii.m pratyak.samabhuut|</para>
  <para style="p">
    <verse number="45" style="v"/>atha tebhya.h "saastrabodhaadhikaara.m datvaavadat,</para>
  <para style="p">
    <verse number="46" style="v"/>khrii.s.tenettha.m m.rtiyaatanaa bhoktavyaa t.rtiiyadine ca "sma"saanaadutthaatavya nceti lipirasti;</para>
  <para style="p">
    <verse number="47" style="v"/>tannaamnaa yiruu"saalamamaarabhya sarvvade"se mana.hparaavarttanasya paapamocanasya ca susa.mvaada.h pracaarayitavya.h,</para>
  <para style="p">
    <verse number="48" style="v"/>e.su sarvve.su yuuya.m saak.si.na.h|</para>
  <para style="p">
    <verse number="49" style="v"/>apara nca pa"syata pitraa yat pratij naata.m tat pre.sayi.syaami, ataeva yaavatkaala.m yuuya.m svargiiyaa.m "sakti.m na praapsyatha taavatkaala.m yiruu"saalamnagare ti.s.thata|</para>
  <para style="p">
    <verse number="50" style="v"/>atha sa taan baithaniiyaaparyyanta.m niitvaa hastaavuttolya aa"si.sa vaktumaarebhe</para>
  <para style="p">
    <verse number="51" style="v"/>aa"si.sa.m vadanneva ca tebhya.h p.rthag bhuutvaa svargaaya niito.abhavat|</para>
  <para style="p">
    <verse number="52" style="v"/>tadaa te ta.m bhajamaanaa mahaanandena yiruu"saalama.m pratyaajagmu.h|</para>
  <para style="p">
    <verse number="53" style="v"/>tato nirantara.m mandire ti.s.thanta ii"svarasya pra"sa.msaa.m dhanyavaada nca karttam aarebhire| iti||</para>
</usx>
