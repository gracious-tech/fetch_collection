<?xml version="1.0" encoding="UTF-8"?>
<usx version="2.6">
  <book code="JHN" style="id">Sanskrit Bible (NT) in Velthuis Script (satyaveda.h ।)</book>
  <para style="rem">© SanskritBible.in । Licensed under CC BY-SA 4.0</para>
  <para style="h">John</para>
  <para style="toc1">yohanalikhita.h susa.mvaada.h</para>
  <para style="toc2">yohana.h</para>
  <para style="toc3">yohana.h</para>
  <para style="mt1">yohanalikhita.h susa.mvaada.h</para>
  <chapter number="1" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>aadau vaada aasiit sa ca vaada ii"svare.na saardhamaasiit sa vaada.h svayamii"svara eva|</para>
  <para style="p">
    <verse number="2" style="v"/>sa aadaavii"svare.na sahaasiit|</para>
  <para style="p">
    <verse number="3" style="v"/>tena sarvva.m vastu sas.rje sarvve.su s.r.s.tavastu.su kimapi vastu tenaas.r.s.ta.m naasti|</para>
  <para style="p">
    <verse number="4" style="v"/>sa jiivanasyaakaara.h, tacca jiivana.m manu.syaa.naa.m jyoti.h</para>
  <para style="p">
    <verse number="5" style="v"/>tajjyotirandhakaare pracakaa"se kintvandhakaarastanna jagraaha|</para>
  <para style="p">
    <verse number="6" style="v"/>yohan naamaka eko manuja ii"svare.na pre.sayaa ncakre|</para>
  <para style="p">
    <verse number="7" style="v"/>tadvaaraa yathaa sarvve vi"svasanti tadartha.m sa tajjyoti.si pramaa.na.m daatu.m saak.sisvaruupo bhuutvaagamat,</para>
  <para style="p">
    <verse number="8" style="v"/>sa svaya.m tajjyoti rna kintu tajjyoti.si pramaa.na.m daatumaagamat|</para>
  <para style="p">
    <verse number="9" style="v"/>jagatyaagatya ya.h sarvvamanujebhyo diipti.m dadaati tadeva satyajyoti.h|</para>
  <para style="p">
    <verse number="10" style="v"/>sa yajjagadas.rjat tanmadya eva sa aasiit kintu jagato lokaasta.m naajaanan|</para>
  <para style="p">
    <verse number="11" style="v"/>nijaadhikaara.m sa aagacchat kintu prajaasta.m naag.rhlan|</para>
  <para style="p">
    <verse number="12" style="v"/>tathaapi ye ye tamag.rhlan arthaat tasya naamni vya"svasan tebhya ii"svarasya putraa bhavitum adhikaaram adadaat|</para>
  <para style="p">
    <verse number="13" style="v"/>te.saa.m jani.h "so.nitaanna "saariirikaabhilaa.saanna maanavaanaamicchaato na kintvii"svaraadabhavat|</para>
  <para style="p">
    <verse number="14" style="v"/>sa vaado manu.syaruupe.naavatiiryya satyataanugrahaabhyaa.m paripuur.na.h san saardham asmaabhi rnyavasat tata.h pituradvitiiyaputrasya yogyo yo mahimaa ta.m mahimaana.m tasyaapa"syaama|</para>
  <para style="p">
    <verse number="15" style="v"/>tato yohanapi pracaaryya saak.syamida.m dattavaan yo mama pa"scaad aagami.syati sa matto gurutara.h; yato matpuurvva.m sa vidyamaana aasiit; yadartham aha.m saak.syamidam adaa.m sa e.sa.h|</para>
  <para style="p">
    <verse number="16" style="v"/>apara nca tasya puur.nataayaa vaya.m sarvve krama"sa.h krama"sonugraha.m praaptaa.h|</para>
  <para style="p">
    <verse number="17" style="v"/>muusaadvaaraa vyavasthaa dattaa kintvanugraha.h satyatva nca yii"sukhrii.s.tadvaaraa samupaati.s.thataa.m|</para>
  <para style="p">
    <verse number="18" style="v"/>kopi manuja ii"svara.m kadaapi naapa"syat kintu pitu.h kro.dastho.advitiiya.h putrasta.m prakaa"sayat|</para>
  <para style="p">
    <verse number="19" style="v"/>tva.m ka.h? iti vaakya.m pre.s.tu.m yadaa yihuudiiyalokaa yaajakaan levilokaa.m"sca yiruu"saalamo yohana.h samiipe pre.sayaamaasu.h,</para>
  <para style="p">
    <verse number="20" style="v"/>tadaa sa sviik.rtavaan naapahnuutavaan naaham abhi.sikta itya"ngiik.rtavaan|</para>
  <para style="p">
    <verse number="21" style="v"/>tadaa te.ap.rcchan tarhi ko bhavaan? ki.m eliya.h? sovadat na; tataste.ap.rcchan tarhi bhavaan sa bhavi.syadvaadii? sovadat naaha.m sa.h|</para>
  <para style="p">
    <verse number="22" style="v"/>tadaa te.ap.rcchan tarhi bhavaan ka.h? vaya.m gatvaa prerakaan tvayi ki.m vak.syaama.h? svasmin ki.m vadasi?</para>
  <para style="p">
    <verse number="23" style="v"/>tadaa sovadat| parame"sasya panthaana.m pari.skuruta sarvvata.h| itiida.m praantare vaakya.m vadata.h kasyacidrava.h| kathaamimaa.m yasmin yi"sayiyo bhavi.syadvaadii likhitavaan soham|</para>
  <para style="p">
    <verse number="24" style="v"/>ye pre.sitaaste phiruu"silokaa.h|</para>
  <para style="p">
    <verse number="25" style="v"/>tadaa te.ap.rcchan yadi naabhi.siktosi eliyosi na sa bhavi.syadvaadyapi naasi ca, tarhi lokaan majjayasi kuta.h?</para>
  <para style="p">
    <verse number="26" style="v"/>tato yohan pratyavocat, toye.aha.m majjayaamiiti satya.m kintu ya.m yuuya.m na jaaniitha taad.r"sa eko jano yu.smaaka.m madhya upati.s.thati|</para>
  <para style="p">
    <verse number="27" style="v"/>sa matpa"scaad aagatopi matpuurvva.m varttamaana aasiit tasya paadukaabandhana.m mocayitumapi naaha.m yogyosmi|</para>
  <para style="p">
    <verse number="28" style="v"/>yarddananadyaa.h paarasthabaithabaaraayaa.m yasminsthaane yohanamajjayat tasmina sthaane sarvvametad agha.tata|</para>
  <para style="p">
    <verse number="29" style="v"/>pare.ahani yohan svanika.tamaagacchanta.m yi"su.m vilokya praavocat jagata.h paapamocakam ii"svarasya me.sa"saavaka.m pa"syata|</para>
  <para style="p">
    <verse number="30" style="v"/>yo mama pa"scaadaagami.syati sa matto gurutara.h, yato hetormatpuurvva.m so.avarttata yasminnaha.m kathaamimaa.m kathitavaan sa evaaya.m|</para>
  <para style="p">
    <verse number="31" style="v"/>apara.m naahamena.m pratyabhij naatavaan kintu israayellokaa ena.m yathaa paricinvanti tadabhipraaye.naaha.m jale majjayitumaagaccham|</para>
  <para style="p">
    <verse number="32" style="v"/>puna"sca yohanaparameka.m pramaa.na.m datvaa kathitavaan vihaayasa.h kapotavad avatarantamaatmaanam asyoparyyavati.s.thanta.m ca d.r.s.tavaanaham|</para>
  <para style="p">
    <verse number="33" style="v"/>naahamena.m pratyabhij naatavaan iti satya.m kintu yo jale majjayitu.m maa.m prairayat sa evemaa.m kathaamakathayat yasyoparyyaatmaanam avatarantam avati.s.thanta nca drak.sayasi saeva pavitre aatmani majjayi.syati|</para>
  <para style="p">
    <verse number="34" style="v"/>avastanniriik.syaayam ii"svarasya tanaya iti pramaa.na.m dadaami|</para>
  <para style="p">
    <verse number="35" style="v"/>pare.ahani yohan dvaabhyaa.m "si.syaabhyaa.m saarddhe.m ti.s.than</para>
  <para style="p">
    <verse number="36" style="v"/>yi"su.m gacchanta.m vilokya gaditavaan, ii"svarasya me.sa"saavaka.m pa"syata.m|</para>
  <para style="p">
    <verse number="37" style="v"/>imaa.m kathaa.m "srutvaa dvau "si.syau yii"so.h pa"scaad iiyatu.h|</para>
  <para style="p">
    <verse number="38" style="v"/>tato yii"su.h paraav.rtya tau pa"scaad aagacchantau d.r.s.tvaa p.r.s.tavaan yuvaa.m ki.m gave"sayatha.h? taavap.rcchataa.m he rabbi arthaat he guro bhavaan kutra ti.s.thati?</para>
  <para style="p">
    <verse number="39" style="v"/>tata.h sovaadit etya pa"syata.m| tato divasasya t.rtiiyapraharasya gatatvaat tau taddina.m tasya sa"nge.asthaataa.m|</para>
  <para style="p">
    <verse number="40" style="v"/>yau dvau yohano vaakya.m "srutvaa yi"so.h pa"scaad aagamataa.m tayo.h "simonpitarasya bhraataa aandriya.h</para>
  <para style="p">
    <verse number="41" style="v"/>sa itvaa prathama.m nijasodara.m "simona.m saak.saatpraapya kathitavaan vaya.m khrii.s.tam arthaat abhi.siktapuru.sa.m saak.saatk.rtavanta.h|</para>
  <para style="p">
    <verse number="42" style="v"/>pa"scaat sa ta.m yi"so.h samiipam aanayat| tadaa yii"susta.m d.r.s.tvaavadat tva.m yuunasa.h putra.h "simon kintu tvannaamadheya.m kaiphaa.h vaa pitara.h arthaat prastaro bhavi.syati|</para>
  <para style="p">
    <verse number="43" style="v"/>pare.ahani yii"sau gaaliila.m gantu.m ni"scitacetasi sati philipanaamaana.m jana.m saak.saatpraapyaavocat mama pa"scaad aagaccha|</para>
  <para style="p">
    <verse number="44" style="v"/>baitsaidaanaamni yasmin graame pitaraandriyayorvaasa aasiit tasmin graame tasya philipasya vasatiraasiit|</para>
  <para style="p">
    <verse number="45" style="v"/>pa"scaat philipo nithanela.m saak.saatpraapyaavadat muusaa vyavasthaa granthe bhavi.syadvaadinaa.m granthe.su ca yasyaakhyaana.m likhitamaaste ta.m yuu.sapha.h putra.m naasaratiiya.m yii"su.m saak.saad akaar.sma vaya.m|</para>
  <para style="p">
    <verse number="46" style="v"/>tadaa nithanel kathitavaan naasarannagaraata ki.m ka"sciduttama utpantu.m "saknoti? tata.h philipo .avocat etya pa"sya|</para>
  <para style="p">
    <verse number="47" style="v"/>apara nca yii"su.h svasya samiipa.m tam aagacchanta.m d.r.s.tvaa vyaah.rtavaan, pa"syaaya.m ni.skapa.ta.h satya israayelloka.h|</para>
  <para style="p">
    <verse number="48" style="v"/>tata.h sovadad, bhavaan maa.m katha.m pratyabhijaanaati? yii"suravaadiit philipasya aahvaanaat puurvva.m yadaa tvamu.dumbarasya tarormuule.asthaastadaa tvaamadar"sam|</para>
  <para style="p">
    <verse number="49" style="v"/>nithanel acakathat, he guro bhavaan nitaantam ii"svarasya putrosi, bhavaan israayelva.m"sasya raajaa|</para>
  <para style="p">
    <verse number="50" style="v"/>tato yii"su rvyaaharat, tvaamu.dumbarasya paadapasya muule d.r.s.tavaanaaha.m mamaitasmaadvaakyaat ki.m tva.m vya"svasii.h? etasmaadapyaa"scaryyaa.ni kaaryyaa.ni drak.syasi|</para>
  <para style="p">
    <verse number="51" style="v"/>anyaccaavaadiid yu.smaanaha.m yathaartha.m vadaami, ita.h para.m mocite meghadvaare tasmaanmanujasuununaa ii"svarasya duutaga.nam avarohantamaarohanta nca drak.syatha|</para>
  <chapter number="2" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>anantara.m trutiiyadivase gaaliil prade"siye kaannaanaamni nagare vivaaha aasiit tatra ca yii"sormaataa ti.s.that|</para>
  <para style="p">
    <verse number="2" style="v"/>tasmai vivaahaaya yii"sustasya "si.syaa"sca nimantritaa aasan|</para>
  <para style="p">
    <verse number="3" style="v"/>tadanantara.m draak.saarasasya nyuunatvaad yii"sormaataa tamavadat ete.saa.m draak.saaraso naasti|</para>
  <para style="p">
    <verse number="4" style="v"/>tadaa sa taamavocat he naari mayaa saha tava ki.m kaaryya.m? mama samaya idaanii.m nopati.s.thati|</para>
  <para style="p">
    <verse number="5" style="v"/>tatastasya maataa daasaanavocad aya.m yad vadati tadeva kuruta|</para>
  <para style="p">
    <verse number="6" style="v"/>tasmin sthaane yihuudiiyaanaa.m "sucitvakara.navyavahaaraanusaare.naa.dhakaikajaladharaa.ni paa.saa.namayaani .sa.dv.rhatpaatraa.niaasan|</para>
  <para style="p">
    <verse number="7" style="v"/>tadaa yii"sustaan sarvvakala"saan jalai.h puurayitu.m taanaaj naapayat, tataste sarvvaan kumbhaanaakar.na.m jalai.h paryyapuurayan|</para>
  <para style="p">
    <verse number="8" style="v"/>atha tebhya.h ki nciduttaaryya bhojyaadhipaate.hsamiipa.m netu.m sa taanaadi"sat, te tadanayan|</para>
  <para style="p">
    <verse number="9" style="v"/>apara nca tajjala.m katha.m draak.saaraso.abhavat tajjalavaahakaadaasaa j naatu.m "saktaa.h kintu tadbhojyaadhipo j naatu.m naa"saknot tadavalihya vara.m sa.mmbodyaavadata,</para>
  <para style="p">
    <verse number="10" style="v"/>lokaa.h prathama.m uttamadraak.saarasa.m dadati ta.su yathe.s.ta.m pitavatsu tasmaa ki ncidanuttama nca dadati kintu tvamidaanii.m yaavat uttamadraak.saarasa.m sthaapayasi|</para>
  <para style="p">
    <verse number="11" style="v"/>ittha.m yii"surgaaliilaprade"se aa"scaryyakaarmma praarambha nijamahimaana.m praakaa"sayat tata.h "si.syaastasmin vya"svasan|</para>
  <para style="p">
    <verse number="12" style="v"/>tata.h param sa nijamaatrubhraatrus"si.syai.h saarddh.m kapharnaahuumam aagamat kintu tatra bahuudinaani aati.s.that|</para>
  <para style="p">
    <verse number="13" style="v"/>tadanantara.m yihuudiyaanaa.m nistaarotsave nika.tamaagate yii"su ryiruu"saalam nagaram aagacchat|</para>
  <para style="p">
    <verse number="14" style="v"/>tato mandirasya madhye gome.sapaaraavatavikrayi.no vaa.nijak.scopavi.s.taan vilokya</para>
  <para style="p">
    <verse number="15" style="v"/>rajjubhi.h ka"saa.m nirmmaaya sarvvagome.saadibhi.h saarddha.m taan mandiraad duuriik.rtavaan|</para>
  <para style="p">
    <verse number="16" style="v"/>va.nijaa.m mudraadi vikiiryya aasanaani nyuubjiik.rtya paaraavatavikrayibhyo.akathayad asmaat sthaanaat sarvaa.nyetaani nayata, mama pitug.rha.m vaa.nijyag.rha.m maa kaar.s.ta|</para>
  <para style="p">
    <verse number="17" style="v"/>tasmaat tanmandiraartha udyogo yastu sa grasatiiva maam| imaa.m "saastriiyalipi.m "si.syaa.hsamasmaran|</para>
  <para style="p">
    <verse number="18" style="v"/>tata.h param yihuudiiyalokaa yii.simavadan tavamid.r"sakarmmakara.naat ki.m cihnamasmaan dar"sayasi?</para>
  <para style="p">
    <verse number="19" style="v"/>tato yii"sustaanavocad yu.smaabhire tasmin mandire naa"site dinatrayamadhye.aha.m tad utthaapayi.syaami|</para>
  <para style="p">
    <verse number="20" style="v"/>tadaa yihuudiyaa vyaahaar.su.h, etasya mandirasa nirmmaa.nena .sa.tcatvaari.m"sad vatsaraa gataa.h, tva.m ki.m dinatrayamadhye tad utthaapayi.syasi?</para>
  <para style="p">
    <verse number="21" style="v"/>kintu sa nijadeharuupamandire kathaamimaa.m kathitavaan|</para>
  <para style="p">
    <verse number="22" style="v"/>sa yadetaad.r"sa.m gaditavaan tacchi.syaa.h "sma"saanaat tadiiyotthaane sati sm.rtvaa dharmmagranthe yii"sunoktakathaayaa.m ca vya"svasi.su.h|</para>
  <para style="p">
    <verse number="23" style="v"/>anantara.m nistaarotsavasya bhojyasamaye yiruu"saalam nagare tatkrutaa"scaryyakarmmaa.ni vilokya bahubhistasya naamani vi"svasita.m|</para>
  <para style="p">
    <verse number="24" style="v"/>kintu sa te.saa.m kare.su sva.m na samarpayat, yata.h sa sarvvaanavait|</para>
  <para style="p">
    <verse number="25" style="v"/>sa maanave.su kasyacit pramaa.na.m naapek.sata yato manujaanaa.m madhye yadyadasti tattat sojaanaat|</para>
  <chapter number="3" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>nikadimanaamaa yihuudiiyaanaam adhipati.h phiruu"sii k.sa.nadaayaa.m</para>
  <para style="p">
    <verse number="2" style="v"/>yii"saurabhyar.nam aavrajya vyaahaar.siit, he guro bhavaan ii"svaraad aagat eka upade.s.taa, etad asmaabhirj naayate; yato bhavataa yaanyaa"scaryyakarmmaa.ni kriyante parame"svarasya saahaayya.m vinaa kenaapi tattatkarmmaa.ni karttu.m na "sakyante|</para>
  <para style="p">
    <verse number="3" style="v"/>tadaa yii"suruttara.m dattavaan tavaaha.m yathaarthatara.m vyaaharaami punarjanmani na sati kopi maanava ii"svarasya raajya.m dra.s.tu.m na "saknoti|</para>
  <para style="p">
    <verse number="4" style="v"/>tato nikadiima.h pratyavocat manujo v.rddho bhuutvaa katha.m jani.syate? sa ki.m puna rmaat.rrja.thara.m pravi"sya janitu.m "saknoti?</para>
  <para style="p">
    <verse number="5" style="v"/>yii"suravaadiid yathaarthataram aha.m kathayaami manuje toyaatmabhyaa.m puna rna jaate sa ii"svarasya raajya.m prave.s.tu.m na "saknoti|</para>
  <para style="p">
    <verse number="6" style="v"/>maa.msaad yat jaayate tan maa.msameva tathaatmano yo jaayate sa aatmaiva|</para>
  <para style="p">
    <verse number="7" style="v"/>yu.smaabhi.h puna rjanitavya.m mamaitasyaa.m kathaayaam aa"scarya.m maa ma.msthaa.h|</para>
  <para style="p">
    <verse number="8" style="v"/>sadaagatiryaa.m di"samicchati tasyaameva di"si vaati, tva.m tasya svana.m "su.no.si kintu sa kuta aayaati kutra yaati vaa kimapi na jaanaasi tadvaad aatmana.h sakaa"saat sarvve.saa.m manujaanaa.m janma bhavati|</para>
  <para style="p">
    <verse number="9" style="v"/>tadaa nikadiima.h p.r.s.tavaan etat katha.m bhavitu.m "saknoti?</para>
  <para style="p">
    <verse number="10" style="v"/>yii"su.h pratyaktavaan tvamisraayelo gururbhuutvaapi kimetaa.m kathaa.m na vetsi?</para>
  <para style="p">
    <verse number="11" style="v"/>tubhya.m yathaartha.m kathayaami, vaya.m yad vidmastad vacma.h ya.mcca pa"syaamastasyaiva saak.sya.m dadma.h kintu yu.smaabhirasmaaka.m saak.sitva.m na g.rhyate|</para>
  <para style="p">
    <verse number="12" style="v"/>etasya sa.msaarasya kathaayaa.m kathitaayaa.m yadi yuuya.m na vi"svasitha tarhi svargiiyaayaa.m kathaayaa.m katha.m vi"svasi.syatha?</para>
  <para style="p">
    <verse number="13" style="v"/>ya.h svarge.asti ya.m ca svargaad avaarohat ta.m maanavatanaya.m vinaa kopi svarga.m naarohat|</para>
  <para style="p">
    <verse number="14" style="v"/>apara nca muusaa yathaa praantare sarpa.m protthaapitavaan manu.syaputro.api tathaivotthaapitavya.h;</para>
  <para style="p">
    <verse number="15" style="v"/>tasmaad ya.h ka"scit tasmin vi"svasi.syati so.avinaa"sya.h san anantaayu.h praapsyati|</para>
  <para style="p">
    <verse number="16" style="v"/>ii"svara ittha.m jagadadayata yat svamadvitiiya.m tanaya.m praadadaat tato ya.h ka"scit tasmin vi"svasi.syati so.avinaa"sya.h san anantaayu.h praapsyati|</para>
  <para style="p">
    <verse number="17" style="v"/>ii"svaro jagato lokaan da.n.dayitu.m svaputra.m na pre.sya taan paritraatu.m pre.sitavaan|</para>
  <para style="p">
    <verse number="18" style="v"/>ataeva ya.h ka"scit tasmin vi"svasiti sa da.n.daarho na bhavati kintu ya.h ka"scit tasmin na vi"svasiti sa idaaniimeva da.n.daarho bhavati,yata.h sa ii"svarasyaadvitiiyaputrasya naamani pratyaya.m na karoti|</para>
  <para style="p">
    <verse number="19" style="v"/>jagato madhye jyoti.h praakaa"sata kintu manu.syaa.naa.m karmma.naa.m d.r.s.tatvaat te jyoti.sopi timire priiyante etadeva da.n.dasya kaara.naa.m bhavati|</para>
  <para style="p">
    <verse number="20" style="v"/>ya.h kukarmma karoti tasyaacaarasya d.r.s.tatvaat sa jyotir.rrtiiyitvaa tannika.ta.m naayaati;</para>
  <para style="p">
    <verse number="21" style="v"/>kintu ya.h satkarmma karoti tasya sarvvaa.ni karmmaa.nii"svare.na k.rtaaniiti sathaa prakaa"sate tadabhipraaye.na sa jyoti.sa.h sannidhim aayaati|</para>
  <para style="p">
    <verse number="22" style="v"/>tata.h param yii"su.h "si.syai.h saarddha.m yihuudiiyade"sa.m gatvaa tatra sthitvaa majjayitum aarabhata|</para>
  <para style="p">
    <verse number="23" style="v"/>tadaa "saalam nagarasya samiipasthaayini ainan graame bahutaratoyasthitestatra yohan amajjayat tathaa ca lokaa aagatya tena majjitaa abhavan|</para>
  <para style="p">
    <verse number="24" style="v"/>tadaa yohan kaaraayaa.m na baddha.h|</para>
  <para style="p">
    <verse number="25" style="v"/>apara nca "saacakarmma.ni yohaana.h "si.syai.h saha yihuudiiyalokaanaa.m vivaade jaate, te yohana.h sa.mnnidhi.m gatvaakathayan,</para>
  <para style="p">
    <verse number="26" style="v"/>he guro yarddananadyaa.h paare bhavataa saarddha.m ya aasiit yasmi.m"sca bhavaan saak.sya.m pradadaat pa"syatu sopi majjayati sarvve tasya samiipa.m yaanti ca|</para>
  <para style="p">
    <verse number="27" style="v"/>tadaa yohan pratyavocad ii"svare.na na datte kopi manuja.h kimapi praaptu.m na "saknoti|</para>
  <para style="p">
    <verse number="28" style="v"/>aha.m abhi.sikto na bhavaami kintu tadagre pre.sitosmi yaamimaa.m kathaa.m kathitavaanaaha.m tatra yuuya.m sarvve saak.si.na.h stha|</para>
  <para style="p">
    <verse number="29" style="v"/>yo jana.h kanyaa.m labhate sa eva vara.h kintu varasya sannidhau da.n.daayamaana.m tasya yanmitra.m tena varasya "sabde "srute.atiivaahlaadyate mamaapi tadvad aanandasiddhirjaataa|</para>
  <para style="p">
    <verse number="30" style="v"/>tena krama"so varddhitavya.m kintu mayaa hsitavya.m|</para>
  <para style="p">
    <verse number="31" style="v"/>ya uurdhvaadaagacchat sa sarvve.saa.m mukhyo ya"sca sa.msaaraad udapadyata sa saa.msaarika.h sa.msaariiyaa.m kathaa nca kathayati yastu svargaadaagacchat sa sarvve.saa.m mukhya.h|</para>
  <para style="p">
    <verse number="32" style="v"/>sa yadapa"syada"s.r.nocca tasminneva saak.sya.m dadaati tathaapi praaya"sa.h ka"scit tasya saak.sya.m na g.rhlaati;</para>
  <para style="p">
    <verse number="33" style="v"/>kintu yo g.rhlaati sa ii"svarasya satyavaaditva.m mudraa"ngita.m karoti|</para>
  <para style="p">
    <verse number="34" style="v"/>ii"svare.na ya.h prerita.h saeva ii"svariiyakathaa.m kathayati yata ii"svara aatmaana.m tasmai aparimitam adadaat|</para>
  <para style="p">
    <verse number="35" style="v"/>pitaa putre sneha.m k.rtvaa tasya haste sarvvaa.ni samarpitavaan|</para>
  <para style="p">
    <verse number="36" style="v"/>ya.h ka"scit putre vi"svasiti sa evaanantam paramaayu.h praapnoti kintu ya.h ka"scit putre na vi"svasiti sa paramaayu.so dar"sana.m na praapnoti kintvii"svarasya kopabhaajana.m bhuutvaa ti.s.thati|</para>
  <chapter number="4" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>yii"su.h svaya.m naamajjayat kevala.m tasya "si.syaa amajjayat kintu yohano.adhika"si.syaan sa karoti majjayati ca,</para>
  <para style="p">
    <verse number="2" style="v"/>phiruu"sina imaa.m vaarttaama"s.r.nvan iti prabhuravagatya</para>
  <para style="p">
    <verse number="3" style="v"/>yihuudiiyade"sa.m vihaaya puna rgaaliilam aagat|</para>
  <para style="p">
    <verse number="4" style="v"/>tata.h "somiro.naprade"sasya madyena tena gantavye sati</para>
  <para style="p">
    <verse number="5" style="v"/>yaakuub nijaputraaya yuu.saphe yaa.m bhuumim adadaat tatsamiipasthaayi "somiro.naprade"sasya sukhaar naamnaa vikhyaatasya nagarasya sannidhaavupaasthaat|</para>
  <para style="p">
    <verse number="6" style="v"/>tatra yaakuuba.h prahiraasiit; tadaa dvitiiyayaamavelaayaa.m jaataayaa.m sa maarge "sramaapannastasya prahe.h paar"sve upaavi"sat|</para>
  <para style="p">
    <verse number="7" style="v"/>etarhi kaacit "somiro.niiyaa yo.sit toyottolanaartham tatraagamat</para>
  <para style="p">
    <verse number="8" style="v"/>tadaa "si.syaa.h khaadyadravyaa.ni kretu.m nagaram agacchan|</para>
  <para style="p">
    <verse number="9" style="v"/>yii"su.h "somiro.niiyaa.m taa.m yo.sitam vyaahaar.siit mahya.m ki ncit paaniiya.m paatu.m dehi| kintu "somiro.niiyai.h saaka.m yihuudiiyalokaa na vyavaaharan tasmaaddheto.h saakathayat "somiro.niiyaa yo.sitadaha.m tva.m yihuudiiyosi katha.m matta.h paaniiya.m paatum icchasi?</para>
  <para style="p">
    <verse number="10" style="v"/>tato yii"suravadad ii"svarasya yaddaana.m tatkiid.rk paaniiya.m paatu.m mahya.m dehi ya ittha.m tvaa.m yaacate sa vaa ka iti cedaj naasyathaastarhi tamayaaci.syathaa.h sa ca tubhyamam.rta.m toyamadaasyat|</para>
  <para style="p">
    <verse number="11" style="v"/>tadaa saa siimantinii bhaa.sitavati, he maheccha prahirgambhiiro bhavato niirottolanapaatra.m naastii ca tasmaat tadam.rta.m kiilaala.m kuta.h praapsyasi?</para>
  <para style="p">
    <verse number="12" style="v"/>yosmabhyam imamandhuu.m dadau, yasya ca parijanaa gome.saadaya"sca sarvve.asya prahe.h paaniiya.m papuretaad.r"so yosmaaka.m puurvvapuru.so yaakuub tasmaadapi bhavaan mahaan ki.m?</para>
  <para style="p">
    <verse number="13" style="v"/>tato yii"surakathayad ida.m paaniiya.m sa.h pivati sa punast.r.saartto bhavi.syati,</para>
  <para style="p">
    <verse number="14" style="v"/>kintu mayaa datta.m paaniiya.m ya.h pivati sa puna.h kadaapi t.r.saartto na bhavi.syati| mayaa dattam ida.m toya.m tasyaanta.h prasrava.naruupa.m bhuutvaa anantaayuryaavat sro.syati|</para>
  <para style="p">
    <verse number="15" style="v"/>tadaa saa vanitaakathayat he maheccha tarhi mama puna.h piipaasaa yathaa na jaayate toyottolanaaya yathaatraagamana.m na bhavati ca tadartha.m mahya.m tattoya.m dehii|</para>
  <para style="p">
    <verse number="16" style="v"/>tato yii"suuravadadyaahi tava patimaahuuya sthaane.atraagaccha|</para>
  <para style="p">
    <verse number="17" style="v"/>saa vaamaavadat mama patirnaasti| yii"suravadat mama patirnaastiiti vaakya.m bhadramavoca.h|</para>
  <para style="p">
    <verse number="18" style="v"/>yatastava pa nca patayobhavan adhunaa tu tvayaa saarddha.m yasti.s.thati sa tava bharttaa na vaakyamida.m satyamavaadi.h|</para>
  <para style="p">
    <verse number="19" style="v"/>tadaa saa mahilaa gaditavati he maheccha bhavaan eko bhavi.syadvaadiiti buddha.m mayaa|</para>
  <para style="p">
    <verse number="20" style="v"/>asmaaka.m pit.rlokaa etasmin "siloccaye.abhajanta, kintu bhavadbhirucyate yiruu"saalam nagare bhajanayogya.m sthaanamaaste|</para>
  <para style="p">
    <verse number="21" style="v"/>yii"suravocat he yo.sit mama vaakye vi"svasihi yadaa yuuya.m kevala"saile.asmin vaa yiruu"saalam nagare piturbhajana.m na kari.syadhve kaala etaad.r"sa aayaati|</para>
  <para style="p">
    <verse number="22" style="v"/>yuuya.m ya.m bhajadhve ta.m na jaaniitha, kintu vaya.m ya.m bhajaamahe ta.m jaaniimahe, yato yihuudiiyalokaanaa.m madhyaat paritraa.na.m jaayate|</para>
  <para style="p">
    <verse number="23" style="v"/>kintu yadaa satyabhaktaa aatmanaa satyaruupe.na ca piturbhajana.m kari.syante samaya etaad.r"sa aayaati, varam idaaniimapi vidyate ; yata etaad.r"so bhatkaan pitaa ce.s.tate|</para>
  <para style="p">
    <verse number="24" style="v"/>ii"svara aatmaa; tatastasya ye bhaktaastai.h sa aatmanaa satyaruupe.na ca bhajaniiya.h|</para>
  <para style="p">
    <verse number="25" style="v"/>tadaa saa mahilaavaadiit khrii.s.tanaamnaa vikhyaato.abhi.sikta.h puru.sa aagami.syatiiti jaanaami sa ca sarvvaa.h kathaa asmaan j naapayi.syati|</para>
  <para style="p">
    <verse number="26" style="v"/>tato yii"suravadat tvayaa saarddha.m kathana.m karomi yo.aham ahameva sa puru.sa.h|</para>
  <para style="p">
    <verse number="27" style="v"/>etasmin samaye "si.syaa aagatya tathaa striyaa saarddha.m tasya kathopakathane mahaa"scaryyam amanyanta tathaapi bhavaan kimicchati? yadvaa kimartham etayaa saarddha.m kathaa.m kathayati? iti kopi naap.rcchat|</para>
  <para style="p">
    <verse number="28" style="v"/>tata.h para.m saa naarii kala"sa.m sthaapayitvaa nagaramadhya.m gatvaa lokebhyokathaayad</para>
  <para style="p">
    <verse number="29" style="v"/>aha.m yadyat karmmaakarava.m tatsarvva.m mahyamakathayad etaad.r"sa.m maanavamekam aagatya pa"syata ru kim abhi.sikto na bhavati ?</para>
  <para style="p">
    <verse number="30" style="v"/>tataste nagaraad bahiraagatya taatasya samiipam aayan|</para>
  <para style="p">
    <verse number="31" style="v"/>etarhi "si.syaa.h saadhayitvaa ta.m vyaahaar.su.h he guro bhavaan ki ncid bhuuktaa.m|</para>
  <para style="p">
    <verse number="32" style="v"/>tata.h sovadad yu.smaabhiryanna j naayate taad.r"sa.m bhak.sya.m mamaaste|</para>
  <para style="p">
    <verse number="33" style="v"/>tadaa "si.syaa.h paraspara.m pra.s.tum aarambhanta, kimasmai kopi kimapi bhak.syamaaniiya dattavaan?</para>
  <para style="p">
    <verse number="34" style="v"/>yii"suravocat matprerakasyaabhimataanuruupakara.na.m tasyaiva karmmasiddhikaara.na nca mama bhak.sya.m|</para>
  <para style="p">
    <verse number="35" style="v"/>maasacatu.s.taye jaate "sasyakarttanasamayo bhavi.syatiiti vaakya.m yu.smaabhi.h ki.m nodyate? kintvaha.m vadaami, "sira uttolya k.setraa.ni prati niriik.sya pa"syata, idaanii.m karttanayogyaani "suklavar.naanyabhavan|</para>
  <para style="p">
    <verse number="36" style="v"/>ya"schinatti sa vetana.m labhate anantaayu.hsvaruupa.m "sasya.m sa g.rhlaati ca, tenaiva vaptaa chettaa ca yugapad aanandata.h|</para>
  <para style="p">
    <verse number="37" style="v"/>ittha.m sati vapatyeka"schinatyanya iti vacana.m siddhyati|</para>
  <para style="p">
    <verse number="38" style="v"/>yatra yuuya.m na paryya"sraamyata taad.r"sa.m "sasya.m chettu.m yu.smaan prairayam anye janaa.hparyya"sraamyan yuuya.m te.saa.m "sragasya phalam alabhadhvam|</para>
  <para style="p">
    <verse number="39" style="v"/>yasmin kaale yadyat karmmaakaar.sa.m tatsarvva.m sa mahyam akathayat tasyaa vanitaayaa ida.m saak.syavaakya.m "srutvaa tannagaranivaasino bahava.h "somiro.niiyalokaa vya"svasan|</para>
  <para style="p">
    <verse number="40" style="v"/>tathaa ca tasyaantike samupasthaaya sve.saa.m sannidhau katicid dinaani sthaatu.m tasmin vinayam akurvvaana tasmaat sa dinadvaya.m tatsthaane nyava.s.tat</para>
  <para style="p">
    <verse number="41" style="v"/>tatastasyopade"sena bahavo.apare vi"svasya</para>
  <para style="p">
    <verse number="42" style="v"/>taa.m yo.saamavadan kevala.m tava vaakyena pratiima iti na, kintu sa jagato.abhi.siktastraateti tasya kathaa.m "srutvaa vaya.m svayamevaaj naasamahi|</para>
  <para style="p">
    <verse number="43" style="v"/>svade"se bhavi.syadvaktu.h satkaaro naastiiti yadyapi yii"su.h pramaa.na.m datvaakathayat</para>
  <para style="p">
    <verse number="44" style="v"/>tathaapi divasadvayaat para.m sa tasmaat sthaanaad gaaliila.m gatavaan|</para>
  <para style="p">
    <verse number="45" style="v"/>anantara.m ye gaaliilii liyalokaa utsave gataa utsavasamaye yiruu"salam nagare tasya sarvvaa.h kriyaa apa"syan te gaaliilam aagata.m tam aag.rhlan|</para>
  <para style="p">
    <verse number="46" style="v"/>tata.h param yii"su ryasmin kaannaanagare jala.m draak.saarasam aakarot tat sthaana.m punaragaat| tasminneva samaye kasyacid raajasabhaastaarasya putra.h kapharnaahuumapurii rogagrasta aasiit|</para>
  <para style="p">
    <verse number="47" style="v"/>sa yehuudiiyade"saad yii"so rgaaliilaagamanavaarttaa.m ni"samya tasya samiipa.m gatvaa praarthya vyaah.rtavaan mama putrasya praaye.na kaala aasanna.h bhavaan aagatya ta.m svastha.m karotu|</para>
  <para style="p">
    <verse number="48" style="v"/>tadaa yii"surakathayad aa"scaryya.m karmma citra.m cihna.m ca na d.r.s.taa yuuya.m na pratye.syatha|</para>
  <para style="p">
    <verse number="49" style="v"/>tata.h sa sabhaasadavadat he maheccha mama putre na m.rte bhavaanaagacchatu|</para>
  <para style="p">
    <verse number="50" style="v"/>yii"sustamavadad gaccha tava putro.ajiiviit tadaa yii"sunoktavaakye sa vi"svasya gatavaan|</para>
  <para style="p">
    <verse number="51" style="v"/>gamanakaale maargamadhye daasaasta.m saak.saatpraapyaavadan bhavata.h putro.ajiiviit|</para>
  <para style="p">
    <verse number="52" style="v"/>tata.h ka.m kaalamaarabhya rogapratiikaaraarambho jaataa iti p.r.s.te tairukta.m hya.h saarddhada.n.dadvayaadhikadvitiiyayaame tasya jvaratyaago.abhavat|</para>
  <para style="p">
    <verse number="53" style="v"/>tadaa yii"sustasmin k.sa.ne proktavaan tava putro.ajiiviit pitaa tadbuddhvaa saparivaaro vya"svasiit|</para>
  <para style="p">
    <verse number="54" style="v"/>yihuudiiyade"saad aagatya gaaliili yii"suretad dvitiiyam aa"scaryyakarmmaakarot|</para>
  <chapter number="5" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>tata.h para.m yihuudiiyaanaam utsava upasthite yii"su ryiruu"saalama.m gatavaan|</para>
  <para style="p">
    <verse number="2" style="v"/>tasminnagare me.sanaamno dvaarasya samiipe ibriiyabhaa.sayaa baithesdaa naamnaa pi.skari.nii pa ncagha.t.tayuktaasiit|</para>
  <para style="p">
    <verse number="3" style="v"/>tasyaaste.su gha.t.te.su kilaalakampanam apek.sya andhakha nca"su.skaa"ngaadayo bahavo rogi.na.h patantasti.s.thanti sma|</para>
  <para style="p">
    <verse number="4" style="v"/>yato vi"se.sakaale tasya saraso vaari svargiiyaduuta etyaakampayat tatkiilaalakampanaat para.m ya.h ka"scid rogii prathama.m paaniiyamavaarohat sa eva tatk.sa.naad rogamukto.abhavat|</para>
  <para style="p">
    <verse number="5" style="v"/>tadaa.s.taatri.m"sadvar.saa.ni yaavad rogagrasta ekajanastasmin sthaane sthitavaan|</para>
  <para style="p">
    <verse number="6" style="v"/>yii"susta.m "sayita.m d.r.s.tvaa bahukaalikarogiiti j naatvaa vyaah.rtavaan tva.m ki.m svastho bubhuu.sasi?</para>
  <para style="p">
    <verse number="7" style="v"/>tato rogii kathitavaan he maheccha yadaa kiilaala.m kampate tadaa maa.m pu.skari.niim avarohayitu.m mama kopi naasti, tasmaan mama gamanakaale ka"scidanyo.agro gatvaa avarohati|</para>
  <para style="p">
    <verse number="8" style="v"/>tadaa yii"surakathayad utti.s.tha, tava "sayyaamuttolya g.rhiitvaa yaahi|</para>
  <para style="p">
    <verse number="9" style="v"/>sa tatk.sa.naat svastho bhuutvaa "sayyaamuttolyaadaaya gatavaan kintu taddina.m vi"sraamavaara.h|</para>
  <para style="p">
    <verse number="10" style="v"/>tasmaad yihuudiiyaa.h svastha.m nara.m vyaaharan adya vi"sraamavaare "sayaniiyamaadaaya na yaatavyam|</para>
  <para style="p">
    <verse number="11" style="v"/>tata.h sa pratyavocad yo maa.m svastham akaar.siit "sayaniiyam uttolyaadaaya yaatu.m maa.m sa evaadi"sat|</para>
  <para style="p">
    <verse number="12" style="v"/>tadaa te.ap.rcchan "sayaniiyam uttolyaadaaya yaatu.m ya aaj naapayat sa ka.h?</para>
  <para style="p">
    <verse number="13" style="v"/>kintu sa ka iti svasthiibhuuto naajaanaad yatastasmin sthaane janataasattvaad yii"su.h sthaanaantaram aagamat|</para>
  <para style="p">
    <verse number="14" style="v"/>tata.h para.m ye"su rmandire ta.m nara.m saak.saatpraapyaakathayat pa"syedaaniim anaamayo jaatosi yathaadhikaa durda"saa na gha.tate taddheto.h paapa.m karmma punarmaakaar.sii.h|</para>
  <para style="p">
    <verse number="15" style="v"/>tata.h sa gatvaa yihuudiiyaan avadad yii"su rmaam arogi.nam akaar.siit|</para>
  <para style="p">
    <verse number="16" style="v"/>tato yii"su rvi"sraamavaare karmmed.r"sa.m k.rtavaan iti heto ryihuudiiyaasta.m taa.dayitvaa hantum ace.s.tanta|</para>
  <para style="p">
    <verse number="17" style="v"/>yii"sustaanaakhyat mama pitaa yat kaaryya.m karoti tadanuruupam ahamapi karoti|</para>
  <para style="p">
    <verse number="18" style="v"/>tato yihuudiiyaasta.m hantu.m punarayatanta yato vi"sraamavaara.m naamanyata tadeva kevala.m na adhikantu ii"svara.m svapitara.m procya svamapii"svaratulya.m k.rtavaan|</para>
  <para style="p">
    <verse number="19" style="v"/>pa"scaad yii"suravadad yu.smaanaha.m yathaarthatara.m vadaami putra.h pitara.m yadyat karmma kurvvanta.m pa"syati tadatirikta.m svecchaata.h kimapi karmma karttu.m na "saknoti| pitaa yat karoti putropi tadeva karoti|</para>
  <para style="p">
    <verse number="20" style="v"/>pitaa putre sneha.m karoti tasmaat svaya.m yadyat karmma karoti tatsarvva.m putra.m dar"sayati ; yathaa ca yu.smaaka.m aa"scaryyaj naana.m jani.syate tadartham itopi mahaakarmma ta.m dar"sayi.syati|</para>
  <para style="p">
    <verse number="21" style="v"/>vastutastu pitaa yathaa pramitaan utthaapya sajivaan karoti tadvat putropi ya.m ya.m icchati ta.m ta.m sajiiva.m karoti|</para>
  <para style="p">
    <verse number="22" style="v"/>sarvve pitara.m yathaa satkurvvanti tathaa putramapi satkaarayitu.m pitaa svaya.m kasyaapi vicaaramak.rtvaa sarvvavicaaraa.naa.m bhaara.m putre samarpitavaan|</para>
  <para style="p">
    <verse number="23" style="v"/>ya.h putra.m sat karoti sa tasya prerakamapi sat karoti|</para>
  <para style="p">
    <verse number="24" style="v"/>yu.smaanaaha.m yathaarthatara.m vadaami yo jano mama vaakya.m "srutvaa matprerake vi"svasiti sonantaayu.h praapnoti kadaapi da.n.dabaajana.m na bhavati nidhanaadutthaaya paramaayu.h praapnoti|</para>
  <para style="p">
    <verse number="25" style="v"/>aha.m yu.smaanatiyathaartha.m vadaami yadaa m.rtaa ii"svaraputrasya ninaada.m "sro.syanti ye ca "sro.syanti te sajiivaa bhavi.syanti samaya etaad.r"sa aayaati varam idaaniimapyupati.s.thati|</para>
  <para style="p">
    <verse number="26" style="v"/>pitaa yathaa svaya njiivii tathaa putraaya svaya njiivitvaadhikaara.m dattavaan|</para>
  <para style="p">
    <verse number="27" style="v"/>sa manu.syaputra.h etasmaat kaara.naat pitaa da.n.dakara.naadhikaaramapi tasmin samarpitavaan|</para>
  <para style="p">
    <verse number="28" style="v"/>etadarthe yuuyam aa"scaryya.m na manyadhva.m yato yasmin samaye tasya ninaada.m "srutvaa "sma"saanasthaa.h sarvve bahiraagami.syanti samaya etaad.r"sa upasthaasyati|</para>
  <para style="p">
    <verse number="29" style="v"/>tasmaad ye satkarmmaa.ni k.rtavantasta utthaaya aayu.h praapsyanti ye ca kukarmaa.ni k.rtavantasta utthaaya da.n.da.m praapsyanti|</para>
  <para style="p">
    <verse number="30" style="v"/>aha.m svaya.m kimapi karttu.m na "saknomi yathaa "su.nomi tathaa vicaarayaami mama vicaara nca nyaayya.h yatoha.m sviiyaabhii.s.ta.m nehitvaa matprerayitu.h pituri.s.tam iihe|</para>
  <para style="p">
    <verse number="31" style="v"/>yadi svasmin svaya.m saak.sya.m dadaami tarhi tatsaak.syam aagraahya.m bhavati ;</para>
  <para style="p">
    <verse number="32" style="v"/>kintu madarthe.aparo jana.h saak.sya.m dadaati madarthe tasya yat saak.sya.m tat satyam etadapyaha.m jaanaami|</para>
  <para style="p">
    <verse number="33" style="v"/>yu.smaabhi ryohana.m prati loke.su prerite.su sa satyakathaayaa.m saak.syamadadaat|</para>
  <para style="p">
    <verse number="34" style="v"/>maanu.saadaha.m saak.sya.m nopek.se tathaapi yuuya.m yathaa paritrayadhve tadartham ida.m vaakya.m vadaami|</para>
  <para style="p">
    <verse number="35" style="v"/>yohan dediipyamaano diipa iva tejasvii sthitavaan yuuyam alpakaala.m tasya diiptyaananditu.m samamanyadhva.m|</para>
  <para style="p">
    <verse number="36" style="v"/>kintu tatpramaa.naadapi mama gurutara.m pramaa.na.m vidyate pitaa maa.m pre.sya yadyat karmma samaapayitu.m "sakttimadadaat mayaa k.rta.m tattat karmma madarthe pramaa.na.m dadaati|</para>
  <para style="p">
    <verse number="37" style="v"/>ya.h pitaa maa.m preritavaan mopi madarthe pramaa.na.m dadaati| tasya vaakya.m yu.smaabhi.h kadaapi na "sruta.m tasya ruupa nca na d.r.s.ta.m</para>
  <para style="p">
    <verse number="38" style="v"/>tasya vaakya nca yu.smaakam anta.h kadaapi sthaana.m naapnoti yata.h sa ya.m pre.sitavaan yuuya.m tasmin na vi"svasitha|</para>
  <para style="p">
    <verse number="39" style="v"/>dharmmapustakaani yuuyam aalocayadhva.m tai rvaakyairanantaayu.h praapsyaama iti yuuya.m budhyadhve taddharmmapustakaani madarthe pramaa.na.m dadati|</para>
  <para style="p">
    <verse number="40" style="v"/>tathaapi yuuya.m paramaayu.hpraaptaye mama sa.mnidhim na jigami.satha|</para>
  <para style="p">
    <verse number="41" style="v"/>aha.m maanu.sebhya.h satkaara.m na g.rhlaami|</para>
  <para style="p">
    <verse number="42" style="v"/>aha.m yu.smaan jaanaami; yu.smaakamantara ii"svaraprema naasti|</para>
  <para style="p">
    <verse number="43" style="v"/>aha.m nijapitu rnaamnaagatosmi tathaapi maa.m na g.rhliitha kintu ka"scid yadi svanaamnaa samaagami.syati tarhi ta.m grahii.syatha|</para>
  <para style="p">
    <verse number="44" style="v"/>yuuyam ii"svaraat satkaara.m na ci.s.tatvaa kevala.m paraspara.m satkaaram ced aadadhvve tarhi katha.m vi"svasitu.m "saknutha?</para>
  <para style="p">
    <verse number="45" style="v"/>putu.h samiipe.aha.m yu.smaan apavadi.syaamiiti maa cintayata yasmin , yasmin yu.smaaka.m vi"svasa.h saeva muusaa yu.smaan apavadati|</para>
  <para style="p">
    <verse number="46" style="v"/>yadi yuuya.m tasmin vya"svasi.syata tarhi mayyapi vya"svasi.syata, yat sa mayi likhitavaan|</para>
  <para style="p">
    <verse number="47" style="v"/>tato yadi tena likhitavaani na pratitha tarhi mama vaakyaani katha.m pratye.syatha?</para>
  <chapter number="6" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>tata.h para.m yii"su rgaaliil prade"siiyasya tiviriyaanaamna.h sindho.h paara.m gatavaan|</para>
  <para style="p">
    <verse number="2" style="v"/>tato vyaadhimallokasvaasthyakara.naruupaa.ni tasyaa"scaryyaa.ni karmmaa.ni d.r.s.tvaa bahavo janaastatpa"scaad agacchan|</para>
  <para style="p">
    <verse number="3" style="v"/>tato yii"su.h parvvatamaaruhya tatra "si.syai.h saakam|</para>
  <para style="p">
    <verse number="4" style="v"/>tasmin samaya nistaarotsavanaamni yihuudiiyaanaama utsava upasthite</para>
  <para style="p">
    <verse number="5" style="v"/>yii"su rnetre uttolya bahulokaan svasamiipaagataan vilokya philipa.m p.r.s.tavaan ete.saa.m bhojanaaya bhojadravyaa.ni vaya.m kutra kretu.m "sakruma.h?</para>
  <para style="p">
    <verse number="6" style="v"/>vaakyamida.m tasya pariik.saartham avaadiit kintu yat kari.syati tat svayam ajaanaat|</para>
  <para style="p">
    <verse number="7" style="v"/>philipa.h pratyavocat ete.saam ekaiko yadyalpam alpa.m praapnoti tarhi mudraapaadadvi"satena kriitapuupaa api nyuunaa bhavi.syanti|</para>
  <para style="p">
    <verse number="8" style="v"/>"simon pitarasya bhraataa aandriyaakhya.h "si.syaa.naameko vyaah.rtavaan</para>
  <para style="p">
    <verse number="9" style="v"/>atra kasyacid baalakasya samiipe pa nca yaavapuupaa.h k.sudramatsyadvaya nca santi kintu lokaanaa.m etaavaataa.m madhye tai.h ki.m bhavi.syati?</para>
  <para style="p">
    <verse number="10" style="v"/>pa"scaad yii"suravadat lokaanupave"sayata tatra bahuyavasasattvaat pa ncasahastrebhyo nyuunaa adhikaa vaa puru.saa bhuumyaam upaavi"san|</para>
  <para style="p">
    <verse number="11" style="v"/>tato yii"sustaan puupaanaadaaya ii"svarasya gu.naan kiirttayitvaa "si.sye.su samaarpayat tataste tebhya upavi.s.talokebhya.h puupaan yathe.s.tamatsya nca praadu.h|</para>
  <para style="p">
    <verse number="12" style="v"/>te.su t.rpte.su sa taanavocad ete.saa.m ki ncidapi yathaa naapaciiyate tathaa sarvvaa.nyava"si.s.taani sa.mg.rhliita|</para>
  <para style="p">
    <verse number="13" style="v"/>tata.h sarvve.saa.m bhojanaat para.m te te.saa.m pa ncaanaa.m yaavapuupaanaa.m ava"si.s.taanyakhilaani sa.mg.rhya dvaada"sa.dallakaan apuurayan|</para>
  <para style="p">
    <verse number="14" style="v"/>apara.m yii"soretaad.r"siim aa"scaryyakriyaa.m d.r.s.tvaa lokaa mitho vaktumaarebhire jagati yasyaagamana.m bhavi.syati sa evaayam ava"sya.m bhavi.syadvakttaa|</para>
  <para style="p">
    <verse number="15" style="v"/>ataeva lokaa aagatya tamaakramya raajaana.m kari.syanti yii"suste.saam iid.r"sa.m maanasa.m vij naaya puna"sca parvvatam ekaakii gatavaan|</para>
  <para style="p">
    <verse number="16" style="v"/>saaya.mkaala upasthite "si.syaa jaladhita.ta.m vrajitvaa naavamaaruhya nagaradi"si sindhau vaahayitvaagaman|</para>
  <para style="p">
    <verse number="17" style="v"/>tasmin samaye timira upaati.s.that kintu yii.suste.saa.m samiipa.m naagacchat|</para>
  <para style="p">
    <verse number="18" style="v"/>tadaa prabalapavanavahanaat saagare mahaatara"ngo bhavitum aarebhe|</para>
  <para style="p">
    <verse number="19" style="v"/>tataste vaahayitvaa dvitraan kro"saan gataa.h pa"scaad yii"su.m jaladherupari padbhyaa.m vrajanta.m naukaantikam aagacchanta.m vilokya traasayuktaa abhavan</para>
  <para style="p">
    <verse number="20" style="v"/>kintu sa taanukttavaan ayamaha.m maa bhai.s.ta|</para>
  <para style="p">
    <verse number="21" style="v"/>tadaa te ta.m svaira.m naavi g.rhiitavanta.h tadaa tatk.sa.naad uddi.s.tasthaane naurupaasthaat|</para>
  <para style="p">
    <verse number="22" style="v"/>yayaa naavaa "si.syaa agacchan tadanyaa kaapi naukaa tasmin sthaane naasiit tato yii"su.h "si.syai.h saaka.m naagamat kevalaa.h "si.syaa agaman etat paarasthaa lokaa j naatavanta.h|</para>
  <para style="p">
    <verse number="23" style="v"/>kintu tata.h para.m prabhu ryatra ii"svarasya gu.naan anukiirttya lokaan puupaan abhojayat tatsthaanasya samiipasthativiriyaayaa aparaastara.naya aagaman|</para>
  <para style="p">
    <verse number="24" style="v"/>yii"sustatra naasti "si.syaa api tatra naa santi lokaa iti vij naaya yii"su.m gave.sayitu.m tara.nibhi.h kapharnaahuum pura.m gataa.h|</para>
  <para style="p">
    <verse number="25" style="v"/>tataste saritpate.h paare ta.m saak.saat praapya praavocan he guro bhavaan atra sthaane kadaagamat?</para>
  <para style="p">
    <verse number="26" style="v"/>tadaa yii"sustaan pratyavaadiid yu.smaanaha.m yathaarthatara.m vadaami aa"scaryyakarmmadar"sanaaddheto rna kintu puupabhojanaat tena t.rptatvaa nca maa.m gave.sayatha|</para>
  <para style="p">
    <verse number="27" style="v"/>k.saya.niiyabhak.syaartha.m maa "sraami.s.ta kintvantaayurbhak.syaartha.m "sraamyata, tasmaat taad.r"sa.m bhak.sya.m manujaputro yu.smaabhya.m daasyati; tasmin taata ii"svara.h pramaa.na.m praadaat|</para>
  <para style="p">
    <verse number="28" style="v"/>tadaa te.ap.rcchan ii"svaraabhimata.m karmma karttum asmaabhi.h ki.m karttavya.m?</para>
  <para style="p">
    <verse number="29" style="v"/>tato yii"suravadad ii"svaro ya.m prairayat tasmin vi"svasanam ii"svaraabhimata.m karmma|</para>
  <para style="p">
    <verse number="30" style="v"/>tadaa te vyaaharan bhavataa ki.m lak.sa.na.m dar"sita.m yadd.r.s.tvaa bhavati vi"svasi.syaama.h? tvayaa ki.m karmma k.rta.m?</para>
  <para style="p">
    <verse number="31" style="v"/>asmaaka.m puurvvapuru.saa mahaapraantare maannaa.m bhokttu.m praapu.h yathaa lipiraaste| svargiiyaa.ni tu bhak.syaa.ni pradadau parame"svara.h|</para>
  <para style="p">
    <verse number="32" style="v"/>tadaa yii"suravadad aha.m yu.smaanatiyathaartha.m vadaami muusaa yu.smaabhya.m svargiiya.m bhak.sya.m naadaat kintu mama pitaa yu.smaabhya.m svargiiya.m parama.m bhak.sya.m dadaati|</para>
  <para style="p">
    <verse number="33" style="v"/>ya.h svargaadavaruhya jagate jiivana.m dadaati sa ii"svaradattabhak.syaruupa.h|</para>
  <para style="p">
    <verse number="34" style="v"/>tadaa te praavocan he prabho bhak.syamida.m nityamasmabhya.m dadaatu|</para>
  <para style="p">
    <verse number="35" style="v"/>yii"suravadad ahameva jiivanaruupa.m bhak.sya.m yo jano mama sannidhim aagacchati sa jaatu k.sudhaartto na bhavi.syati, tathaa yo jano maa.m pratyeti sa jaatu t.r.saartto na bhavi.syati|</para>
  <para style="p">
    <verse number="36" style="v"/>maa.m d.r.s.tvaapi yuuya.m na vi"svasitha yu.smaanaham ityavoca.m|</para>
  <para style="p">
    <verse number="37" style="v"/>pitaa mahya.m yaavato lokaanadadaat te sarvva eva mamaantikam aagami.syanti ya.h ka"scicca mama sannidhim aayaasyati ta.m kenaapi prakaare.na na duuriikari.syaami|</para>
  <para style="p">
    <verse number="38" style="v"/>nijaabhimata.m saadhayitu.m na hi kintu prerayiturabhimata.m saadhayitu.m svargaad aagatosmi|</para>
  <para style="p">
    <verse number="39" style="v"/>sa yaan yaan lokaan mahyamadadaat te.saamekamapi na haarayitvaa "se.sadine sarvvaanaham utthaapayaami ida.m matprerayitu.h piturabhimata.m|</para>
  <para style="p">
    <verse number="40" style="v"/>ya.h ka"scin maanavasuta.m vilokya vi"svasiti sa "se.sadine mayotthaapita.h san anantaayu.h praapsyati iti matprerakasyaabhimata.m|</para>
  <para style="p">
    <verse number="41" style="v"/>tadaa svargaad yad bhak.syam avaarohat tad bhak.syam ahameva yihuudiiyalokaastasyaitad vaakye vivadamaanaa vakttumaarebhire</para>
  <para style="p">
    <verse number="42" style="v"/>yuu.sapha.h putro yii"su ryasya maataapitarau vaya.m jaaniima e.sa ki.m saeva na? tarhi svargaad avaaroham iti vaakya.m katha.m vaktti?</para>
  <para style="p">
    <verse number="43" style="v"/>tadaa yii"sustaan pratyavadat paraspara.m maa vivadadhva.m</para>
  <para style="p">
    <verse number="44" style="v"/>matprerake.na pitraa naak.r.s.ta.h kopi jano mamaantikam aayaatu.m na "saknoti kintvaagata.m jana.m carame.ahni protthaapayi.syaami|</para>
  <para style="p">
    <verse number="45" style="v"/>te sarvva ii"svare.na "sik.sitaa bhavi.syanti bhavi.syadvaadinaa.m granthe.su lipiritthamaaste ato ya.h ka"scit pitu.h sakaa"saat "srutvaa "sik.sate sa eva mama samiipam aagami.syati|</para>
  <para style="p">
    <verse number="46" style="v"/>ya ii"svaraad ajaayata ta.m vinaa kopi manu.syo janaka.m naadar"sat kevala.h saeva taatam adraak.siit|</para>
  <para style="p">
    <verse number="47" style="v"/>aha.m yu.smaan yathaarthatara.m vadaami yo jano mayi vi"svaasa.m karoti sonantaayu.h praapnoti|</para>
  <para style="p">
    <verse number="48" style="v"/>ahameva tajjiivanabhak.sya.m|</para>
  <para style="p">
    <verse number="49" style="v"/>yu.smaaka.m puurvvapuru.saa mahaapraantare mannaabhak.sya.m bhuukttaapi m.rtaa.h</para>
  <para style="p">
    <verse number="50" style="v"/>kintu yadbhak.sya.m svargaadaagacchat tad yadi ka"scid bhu"nktte tarhi sa na mriyate|</para>
  <para style="p">
    <verse number="51" style="v"/>yajjiivanabhak.sya.m svargaadaagacchat sohameva ida.m bhak.sya.m yo jano bhu"nktte sa nityajiivii bhavi.syati| puna"sca jagato jiivanaarthamaha.m yat svakiiyapi"sita.m daasyaami tadeva mayaa vitarita.m bhak.syam|</para>
  <para style="p">
    <verse number="52" style="v"/>tasmaad yihuudiiyaa.h paraspara.m vivadamaanaa vakttumaarebhire e.sa bhojanaartha.m sviiya.m palala.m katham asmabhya.m daasyati?</para>
  <para style="p">
    <verse number="53" style="v"/>tadaa yii"sustaan aavocad yu.smaanaha.m yathaarthatara.m vadaami manu.syaputrasyaami.se yu.smaabhi rna bhuktte tasya rudhire ca na piite jiivanena saarddha.m yu.smaaka.m sambandho naasti|</para>
  <para style="p">
    <verse number="54" style="v"/>yo mamaami.sa.m svaadati mama sudhira nca pivati sonantaayu.h praapnoti tata.h "se.se.ahni tamaham utthaapayi.syaami|</para>
  <para style="p">
    <verse number="55" style="v"/>yato madiiyamaami.sa.m parama.m bhak.sya.m tathaa madiiya.m "so.nita.m parama.m peya.m|</para>
  <para style="p">
    <verse number="56" style="v"/>yo jano madiiya.m palala.m svaadati madiiya.m rudhira nca pivati sa mayi vasati tasminnaha nca vasaami|</para>
  <para style="p">
    <verse number="57" style="v"/>matprerayitraa jiivataa taatena yathaaha.m jiivaami tadvad ya.h ka"scin maamatti sopi mayaa jiivi.syati|</para>
  <para style="p">
    <verse number="58" style="v"/>yadbhak.sya.m svargaadaagacchat tadida.m yanmaannaa.m svaaditvaa yu.smaaka.m pitaro.amriyanta taad.r"sam ida.m bhak.sya.m na bhavati ida.m bhak.sya.m yo bhak.sati sa nitya.m jiivi.syati|</para>
  <para style="p">
    <verse number="59" style="v"/>yadaa kapharnaahuum puryyaa.m bhajanagehe upaadi"sat tadaa kathaa etaa akathayat|</para>
  <para style="p">
    <verse number="60" style="v"/>tadettha.m "srutvaa tasya "si.syaa.naam aneke parasparam akathayan ida.m gaa.dha.m vaakya.m vaakyamiid.r"sa.m ka.h "srotu.m "sakruyaat?</para>
  <para style="p">
    <verse number="61" style="v"/>kintu yii"su.h "si.syaa.naam ittha.m vivaada.m svacitte vij naaya kathitavaan ida.m vaakya.m ki.m yu.smaaka.m vighna.m janayati?</para>
  <para style="p">
    <verse number="62" style="v"/>yadi manujasuta.m puurvvavaasasthaanam uurdvva.m gacchanta.m pa"syatha tarhi ki.m bhavi.syati?</para>
  <para style="p">
    <verse number="63" style="v"/>aatmaiva jiivanadaayaka.h vapu rni.sphala.m yu.smabhyamaha.m yaani vacaa.msi kathayaami taanyaatmaa jiivana nca|</para>
  <para style="p">
    <verse number="64" style="v"/>kintu yu.smaaka.m madhye kecana avi"svaasina.h santi ke ke na vi"svasanti ko vaa ta.m parakare.su samarpayi.syati taan yii"suraaprathamaad vetti|</para>
  <para style="p">
    <verse number="65" style="v"/>aparamapi kathitavaan asmaat kaara.naad akathaya.m pitu.h sakaa"saat "sakttimapraapya kopi mamaantikam aagantu.m na "saknoti|</para>
  <para style="p">
    <verse number="66" style="v"/>tatkaale.aneke "si.syaa vyaaghu.tya tena saarddha.m puna rnaagacchan|</para>
  <para style="p">
    <verse number="67" style="v"/>tadaa yii"su rdvaada"sa"si.syaan ukttavaan yuuyamapi ki.m yaasyatha?</para>
  <para style="p">
    <verse number="68" style="v"/>tata.h "simon pitara.h pratyavocat he prabho kasyaabhyar.na.m gami.syaama.h?</para>
  <para style="p">
    <verse number="69" style="v"/>anantajiivanadaayinyo yaa.h kathaastaastavaiva| bhavaan amare"svarasyaabhi.sikttaputra iti vi"svasya ni"scita.m jaaniima.h|</para>
  <para style="p">
    <verse number="70" style="v"/>tadaa yii"suravadat kimaha.m yu.smaaka.m dvaada"sajanaan manoniitaan na k.rtavaan? kintu yu.smaaka.m madhyepi ka"scideko vighnakaarii vidyate|</para>
  <para style="p">
    <verse number="71" style="v"/>imaa.m katha.m sa "simona.h putram ii.skariiyotiiya.m yihuudaam uddi"sya kathitavaan yato dvaada"saanaa.m madhye ga.nita.h sa ta.m parakare.su samarpayi.syati|</para>
  <chapter number="7" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>tata.h para.m yihuudiiyalokaasta.m hantu.m samaihanta tasmaad yii"su ryihuudaaprade"se paryya.titu.m necchan gaaliil prade"se paryya.titu.m praarabhata|</para>
  <para style="p">
    <verse number="2" style="v"/>kintu tasmin samaye yihuudiiyaanaa.m duu.syavaasanaamotsava upasthite</para>
  <para style="p">
    <verse number="3" style="v"/>tasya bhraatarastam avadan yaani karmmaa.ni tvayaa kriyante taani yathaa tava "si.syaa.h pa"syanti tadartha.m tvamita.h sthaanaad yihuudiiyade"sa.m vraja|</para>
  <para style="p">
    <verse number="4" style="v"/>ya.h ka"scit svaya.m pracikaa"si.sati sa kadaapi gupta.m karmma na karoti yadiid.r"sa.m karmma karo.si tarhi jagati nija.m paricaayaya|</para>
  <para style="p">
    <verse number="5" style="v"/>yatastasya bhraataropi ta.m na vi"svasanti|</para>
  <para style="p">
    <verse number="6" style="v"/>tadaa yii"sustaan avocat mama samaya idaanii.m nopati.s.thati kintu yu.smaaka.m samaya.h satatam upati.s.thati|</para>
  <para style="p">
    <verse number="7" style="v"/>jagato lokaa yu.smaan .rtiiyitu.m na "sakruvanti kintu maameva .rtiiyante yataste.saa.m karmaa.ni du.s.taani tatra saak.syamidam aha.m dadaami|</para>
  <para style="p">
    <verse number="8" style="v"/>ataeva yuuyam utsave.asmin yaata naaham idaaniim asminnutsave yaami yato mama samaya idaanii.m na sampuur.na.h|</para>
  <para style="p">
    <verse number="9" style="v"/>iti vaakyam ukttvaa sa gaaliili sthitavaan</para>
  <para style="p">
    <verse number="10" style="v"/>kintu tasya bhraat.r.su tatra prasthite.su satsu so.apraka.ta utsavam agacchat|</para>
  <para style="p">
    <verse number="11" style="v"/>anantaram utsavam upasthitaa yihuudiiyaasta.m m.rgayitvaap.rcchan sa kutra?</para>
  <para style="p">
    <verse number="12" style="v"/>tato lokaanaa.m madhye tasmin naanaavidhaa vivaadaa bhavitum aarabdhavanta.h| kecid avocan sa uttama.h puru.sa.h kecid avocan na tathaa vara.m lokaanaa.m bhrama.m janayati|</para>
  <para style="p">
    <verse number="13" style="v"/>kintu yihuudiiyaanaa.m bhayaat kopi tasya pak.se spa.s.ta.m naakathayat|</para>
  <para style="p">
    <verse number="14" style="v"/>tata.h param utsavasya madhyasamaye yii"su rmandira.m gatvaa samupadi"sati sma|</para>
  <para style="p">
    <verse number="15" style="v"/>tato yihuudiiyaa lokaa aa"scaryya.m j naatvaakathayan e.saa maanu.so naadhiityaa katham etaad.r"so vidvaanabhuut?</para>
  <para style="p">
    <verse number="16" style="v"/>tadaa yii"su.h pratyavocad upade"soya.m na mama kintu yo maa.m pre.sitavaan tasya|</para>
  <para style="p">
    <verse number="17" style="v"/>yo jano nide"sa.m tasya grahii.syati mamopade"so matto bhavati kim ii"svaraad bhavati sa ganastajj naatu.m "sak.syati|</para>
  <para style="p">
    <verse number="18" style="v"/>yo jana.h svata.h kathayati sa sviiya.m gauravam iihate kintu ya.h prerayitu rgauravam iihate sa satyavaadii tasmin kopyadharmmo naasti|</para>
  <para style="p">
    <verse number="19" style="v"/>muusaa yu.smabhya.m vyavasthaagrantha.m ki.m naadadaat? kintu yu.smaaka.m kopi taa.m vyavasthaa.m na samaacarati| maa.m hantu.m kuto yatadhve?</para>
  <para style="p">
    <verse number="20" style="v"/>tadaa lokaa avadan tva.m bhuutagrastastvaa.m hantu.m ko yatate?</para>
  <para style="p">
    <verse number="21" style="v"/>tato yii"suravocad eka.m karmma mayaakaari tasmaad yuuya.m sarvva mahaa"scaryya.m manyadhve|</para>
  <para style="p">
    <verse number="22" style="v"/>muusaa yu.smabhya.m tvakchedavidhi.m pradadau sa muusaato na jaata.h kintu pit.rpuru.sebhyo jaata.h tena vi"sraamavaare.api maanu.saa.naa.m tvakcheda.m kurutha|</para>
  <para style="p">
    <verse number="23" style="v"/>ataeva vi"sraamavaare manu.syaa.naa.m tvakchede k.rte yadi muusaavyavasthaama"ngana.m na bhavati tarhi mayaa vi"sraamavaare maanu.sa.h sampuur.naruupe.na svastho.akaari tatkaara.naad yuuya.m ki.m mahya.m kupyatha?</para>
  <para style="p">
    <verse number="24" style="v"/>sapak.sapaata.m vicaaramak.rtvaa nyaayya.m vicaara.m kuruta|</para>
  <para style="p">
    <verse number="25" style="v"/>tadaa yiruu"saalam nivaasina.h katipayajanaa akathayan ime ya.m hantu.m ce.s.tante sa evaaya.m ki.m na?</para>
  <para style="p">
    <verse number="26" style="v"/>kintu pa"syata nirbhaya.h san kathaa.m kathayati tathaapi kimapi a vadantyete ayamevaabhi.siktto bhavatiiti ni"scita.m kimadhipatayo jaananti?</para>
  <para style="p">
    <verse number="27" style="v"/>manujoya.m kasmaadaagamad iti vaya.m jaanoma.h kintvabhi.siktta aagate sa kasmaadaagatavaan iti kopi j naatu.m na "sak.syati|</para>
  <para style="p">
    <verse number="28" style="v"/>tadaa yii"su rmadhyemandiram upadi"san uccai.hkaaram ukttavaan yuuya.m ki.m maa.m jaaniitha? kasmaaccaagatosmi tadapi ki.m jaaniitha? naaha.m svata aagatosmi kintu ya.h satyavaadii saeva maa.m pre.sitavaan yuuya.m ta.m na jaaniitha|</para>
  <para style="p">
    <verse number="29" style="v"/>tamaha.m jaane tenaaha.m prerita agatosmi|</para>
  <para style="p">
    <verse number="30" style="v"/>tasmaad yihuudiiyaasta.m dharttum udyataastathaapi kopi tasya gaatre hasta.m naarpayad yato hetostadaa tasya samayo nopati.s.thati|</para>
  <para style="p">
    <verse number="31" style="v"/>kintu bahavo lokaastasmin vi"svasya kathitavaanto.abhi.sikttapuru.sa aagatya maanu.sasyaasya kriyaabhya.h kim adhikaa aa"scaryyaa.h kriyaa.h kari.syati?</para>
  <para style="p">
    <verse number="32" style="v"/>tata.h para.m lokaastasmin ittha.m vivadante phiruu"sina.h pradhaanayaajakaa nceti "srutavantasta.m dh.rtvaa netu.m padaatiga.na.m pre.sayaamaasu.h|</para>
  <para style="p">
    <verse number="33" style="v"/>tato yii"suravadad aham alpadinaani yu.smaabhi.h saarddha.m sthitvaa matprerayitu.h samiipa.m yaasyaami|</para>
  <para style="p">
    <verse number="34" style="v"/>maa.m m.rgayi.syadhve kintuudde"sa.m na lapsyadhve ratra sthaasyaami tatra yuuya.m gantu.m na "sak.syatha|</para>
  <para style="p">
    <verse number="35" style="v"/>tadaa yihuudiiyaa.h paraspara.m vakttumaarebhire asyodde"sa.m na praapsyaama etaad.r"sa.m ki.m sthaana.m yaasyati? bhinnade"se vikiir.naanaa.m yihuudiiyaanaa.m sannidhim e.sa gatvaa taan upadek.syati ki.m?</para>
  <para style="p">
    <verse number="36" style="v"/>no cet maa.m gave.sayi.syatha kintuudde"sa.m na praapsyatha e.sa kod.r"sa.m vaakyamida.m vadati?</para>
  <para style="p">
    <verse number="37" style="v"/>anantaram utsavasya carame.ahani arthaat pradhaanadine yii"surutti.s.than uccai.hkaaram aahvayan uditavaan yadi ka"scit t.r.saartto bhavati tarhi mamaantikam aagatya pivatu|</para>
  <para style="p">
    <verse number="38" style="v"/>ya.h ka"scinmayi vi"svasiti dharmmagranthasya vacanaanusaare.na tasyaabhyantarato.am.rtatoyasya srotaa.msi nirgami.syanti|</para>
  <para style="p">
    <verse number="39" style="v"/>ye tasmin vi"svasanti ta aatmaana.m praapsyantiityarthe sa ida.m vaakya.m vyaah.rtavaan etatkaala.m yaavad yii"su rvibhava.m na praaptastasmaat pavitra aatmaa naadiiyata|</para>
  <para style="p">
    <verse number="40" style="v"/>etaa.m vaa.nii.m "srutvaa bahavo lokaa avadan ayameva ni"scita.m sa bhavi.syadvaadii|</para>
  <para style="p">
    <verse number="41" style="v"/>kecid akathayan e.saeva sobhi.siktta.h kintu kecid avadan sobhi.siktta.h ki.m gaaliil prade"se jani.syate?</para>
  <para style="p">
    <verse number="42" style="v"/>sobhi.siktto daayuudo va.m"se daayuudo janmasthaane baitlehami pattane jani.syate dharmmagranthe kimittha.m likhita.m naasti?</para>
  <para style="p">
    <verse number="43" style="v"/>ittha.m tasmin lokaanaa.m bhinnavaakyataa jaataa|</para>
  <para style="p">
    <verse number="44" style="v"/>katipayalokaasta.m dharttum aicchan tathaapi tadvapu.si kopi hasta.m naarpayat|</para>
  <para style="p">
    <verse number="45" style="v"/>anantara.m paadaatiga.ne pradhaanayaajakaanaa.m phiruu"sinaa nca samiipamaagatavati te taan ap.rcchan kuto hetosta.m naanayata?</para>
  <para style="p">
    <verse number="46" style="v"/>tadaa padaataya.h pratyavadan sa maanava iva kopi kadaapi nopaadi"sat|</para>
  <para style="p">
    <verse number="47" style="v"/>tata.h phiruu"sina.h praavocan yuuyamapi kimabhraami.s.ta?</para>
  <para style="p">
    <verse number="48" style="v"/>adhipatiinaa.m phiruu"sinaa nca kopi ki.m tasmin vya"svasiit?</para>
  <para style="p">
    <verse number="49" style="v"/>ye "saastra.m na jaananti ta ime.adhamalokaaeva "saapagrastaa.h|</para>
  <para style="p">
    <verse number="50" style="v"/>tadaa nikadiimanaamaa te.saameko ya.h k.sa.nadaayaa.m yii"so.h sannidhim agaat sa ukttavaan</para>
  <para style="p">
    <verse number="51" style="v"/>tasya vaakye na "srute karmma.ni ca na vidite .asmaaka.m vyavasthaa ki.m ka ncana manuja.m do.siikaroti?</para>
  <para style="p">
    <verse number="52" style="v"/>tataste vyaaharan tvamapi ki.m gaaliiliiyaloka.h? vivicya pa"sya galiili kopi bhavi.syadvaadii notpadyate|</para>
  <para style="p">
    <verse number="53" style="v"/>tata.h para.m sarvve sva.m sva.m g.rha.m gataa.h kintu yii"su rjaitunanaamaana.m "siloccaya.m gatavaan|</para>
  <chapter number="8" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>pratyuu.se yii"su.h panarmandiram aagacchat</para>
  <para style="p">
    <verse number="2" style="v"/>tata.h sarvve.su loke.su tasya samiipa aagate.su sa upavi"sya taan upade.s.tum aarabhata|</para>
  <para style="p">
    <verse number="3" style="v"/>tadaa adhyaapakaa.h phiruu"sina nca vyabhicaarakarmma.ni dh.rta.m striyamekaam aaniya sarvve.saa.m madhye sthaapayitvaa vyaaharan</para>
  <para style="p">
    <verse number="4" style="v"/>he guro yo.sitam imaa.m vyabhicaarakarmma kurvvaa.naa.m lokaa dh.rtavanta.h|</para>
  <para style="p">
    <verse number="5" style="v"/>etaad.r"salokaa.h paa.saa.naaghaatena hantavyaa iti vidhirmuusaavyavasthaagranthe likhitosti kintu bhavaan kimaadi"sati?</para>
  <para style="p">
    <verse number="6" style="v"/>te tamapavaditu.m pariik.saabhipraaye.na vaakyamidam ap.rcchan kintu sa prahviibhuuya bhuumaava"ngalyaa lekhitum aarabhata|</para>
  <para style="p">
    <verse number="7" style="v"/>tatastai.h puna.h puna.h p.r.s.ta utthaaya kathitavaan yu.smaaka.m madhye yo jano niraparaadhii saeva prathamam enaa.m paa.saa.nenaahantu|</para>
  <para style="p">
    <verse number="8" style="v"/>pa"scaat sa puna"sca prahviibhuuya bhuumau lekhitum aarabhata|</para>
  <para style="p">
    <verse number="9" style="v"/>taa.m katha.m "srutvaa te svasvamanasi prabodha.m praapya jye.s.thaanukrama.m ekaika"sa.h sarvve bahiragacchan tato yii"surekaakii tayakttobhavat madhyasthaane da.n.daayamaanaa saa yo.saa ca sthitaa|</para>
  <para style="p">
    <verse number="10" style="v"/>tatpa"scaad yii"surutthaaya taa.m vanitaa.m vinaa kamapyapara.m na vilokya p.r.s.tavaan he vaame tavaapavaadakaa.h kutra? kopi tvaa.m ki.m na da.n.dayati?</para>
  <para style="p">
    <verse number="11" style="v"/>saavadat he maheccha kopi na tadaa yii"suravocat naahamapi da.n.dayaami yaahi puna.h paapa.m maakaar.sii.h|</para>
  <para style="p">
    <verse number="12" style="v"/>tato yii"su.h punarapi lokebhya ittha.m kathayitum aarabhata jagatoha.m jyoti.hsvaruupo ya.h ka"scin matpa"scaada gacchati sa timire na bhramitvaa jiivanaruupaa.m diipti.m praapsyati|</para>
  <para style="p">
    <verse number="13" style="v"/>tata.h phiruu"sino.avaadi.sustva.m svaarthe svaya.m saak.sya.m dadaasi tasmaat tava saak.sya.m graahya.m na bhavati|</para>
  <para style="p">
    <verse number="14" style="v"/>tadaa yii"su.h pratyuditavaan yadyapi svaarthe.aha.m svaya.m saak.sya.m dadaami tathaapi mat saak.sya.m graahya.m yasmaad aha.m kuta aagatosmi kva yaami ca tadaha.m jaanaami kintu kuta aagatosmi kutra gacchaami ca tad yuuya.m na jaaniitha|</para>
  <para style="p">
    <verse number="15" style="v"/>yuuya.m laukika.m vicaarayatha naaha.m kimapi vicaarayaami|</para>
  <para style="p">
    <verse number="16" style="v"/>kintu yadi vicaarayaami tarhi mama vicaaro grahiitavyo yatoham ekaakii naasmi prerayitaa pitaa mayaa saha vidyate|</para>
  <para style="p">
    <verse number="17" style="v"/>dvayo rjanayo.h saak.sya.m graha.niiya.m bhavatiiti yu.smaaka.m vyavasthaagranthe likhitamasti|</para>
  <para style="p">
    <verse number="18" style="v"/>aha.m svaarthe svaya.m saak.sitva.m dadaami ya"sca mama taato maa.m preritavaan sopi madarthe saak.sya.m dadaati|</para>
  <para style="p">
    <verse number="19" style="v"/>tadaa te.ap.rcchan tava taata.h kutra? tato yii"su.h pratyavaadiid yuuya.m maa.m na jaaniitha matpitara nca na jaaniitha yadi maam ak.saasyata tarhi mama taatamapyak.saasyata|</para>
  <para style="p">
    <verse number="20" style="v"/>yii"su rmandira upadi"sya bha.n.daagaare kathaa etaa akathayat tathaapi ta.m prati kopi kara.m nodatolayat|</para>
  <para style="p">
    <verse number="21" style="v"/>tata.h para.m yii"su.h punaruditavaan adhunaaha.m gacchaami yuuya.m maa.m gave.sayi.syatha kintu nijai.h paapai rmari.syatha yat sthaanam aha.m yaasyaami tat sthaanam yuuya.m yaatu.m na "sak.syatha|</para>
  <para style="p">
    <verse number="22" style="v"/>tadaa yihuudiiyaa.h praavocan kimayam aatmaghaata.m kari.syati? yato yat sthaanam aha.m yaasyaami tat sthaanam yuuya.m yaatu.m na "sak.syatha iti vaakya.m braviiti|</para>
  <para style="p">
    <verse number="23" style="v"/>tato yii"sustebhya.h kathitavaan yuuyam adha.hsthaaniiyaa lokaa aham uurdvvasthaaniiya.h yuuyam etajjagatsambandhiiyaa aham etajjagatsambandhiiyo na|</para>
  <para style="p">
    <verse number="24" style="v"/>tasmaat kathitavaan yuuya.m nijai.h paapai rmari.syatha yatoha.m sa pumaan iti yadi na vi"svasitha tarhi nijai.h paapai rmari.syatha|</para>
  <para style="p">
    <verse number="25" style="v"/>tadaa te .ap.rcchan kastva.m? tato yii"su.h kathitavaan yu.smaaka.m sannidhau yasya prastaavam aa prathamaat karomi saeva puru.soha.m|</para>
  <para style="p">
    <verse number="26" style="v"/>yu.smaasu mayaa bahuvaakya.m vakttavya.m vicaarayitavya nca kintu matprerayitaa satyavaadii tasya samiipe yadaha.m "srutavaan tadeva jagate kathayaami|</para>
  <para style="p">
    <verse number="27" style="v"/>kintu sa janake vaakyamida.m prokttavaan iti te naabudhyanta|</para>
  <para style="p">
    <verse number="28" style="v"/>tato yii"surakathayad yadaa manu.syaputram uurdvva utthaapayi.syatha tadaaha.m sa pumaan kevala.h svaya.m kimapi karmma na karomi kintu taato yathaa "sik.sayati tadanusaare.na vaakyamida.m vadaamiiti ca yuuya.m j naatu.m "sak.syatha|</para>
  <para style="p">
    <verse number="29" style="v"/>matprerayitaa pitaa maam ekaakina.m na tyajati sa mayaa saarddha.m ti.s.thati yatoha.m tadabhimata.m karmma sadaa karomi|</para>
  <para style="p">
    <verse number="30" style="v"/>tadaa tasyaitaani vaakyaani "srutvaa bahuvastaasmin vya"svasan|</para>
  <para style="p">
    <verse number="31" style="v"/>ye yihuudiiyaa vya"svasan yii"sustebhyo.akathayat</para>
  <para style="p">
    <verse number="32" style="v"/>mama vaakye yadi yuuyam aasthaa.m kurutha tarhi mama "si.syaa bhuutvaa satyatva.m j naasyatha tata.h satyatayaa yu.smaaka.m mok.so bhavi.syati|</para>
  <para style="p">
    <verse number="33" style="v"/>tadaa te pratyavaadi.su.h vayam ibraahiimo va.m"sa.h kadaapi kasyaapi daasaa na jaataastarhi yu.smaaka.m muktti rbhavi.syatiiti vaakya.m katha.m bravii.si?</para>
  <para style="p">
    <verse number="34" style="v"/>tadaa yii"su.h pratyavadad yu.smaanaha.m yathaarthatara.m vadaami ya.h paapa.m karoti sa paapasya daasa.h|</para>
  <para style="p">
    <verse number="35" style="v"/>daasa"sca nirantara.m nive"sane na ti.s.thati kintu putro nirantara.m ti.s.thati|</para>
  <para style="p">
    <verse number="36" style="v"/>ata.h putro yadi yu.smaan mocayati tarhi nitaantameva mukttaa bhavi.syatha|</para>
  <para style="p">
    <verse number="37" style="v"/>yuyam ibraahiimo va.m"sa ityaha.m jaanaami kintu mama kathaa yu.smaakam anta.hkara.ne.su sthaana.m na praapnuvanti tasmaaddheto rmaa.m hantum iihadhve|</para>
  <para style="p">
    <verse number="38" style="v"/>aha.m svapitu.h samiipe yadapa"sya.m tadeva kathayaami tathaa yuuyamapi svapitu.h samiipe yadapa"syata tadeva kurudhve|</para>
  <para style="p">
    <verse number="39" style="v"/>tadaa te pratyavocan ibraahiim asmaaka.m pitaa tato yii"surakathayad yadi yuuyam ibraahiima.h santaanaa abhavi.syata tarhi ibraahiima aacaara.navad aacari.syata|</para>
  <para style="p">
    <verse number="40" style="v"/>ii"svarasya mukhaat satya.m vaakya.m "srutvaa yu.smaan j naapayaami yoha.m ta.m maa.m hantu.m ce.s.tadhve ibraahiim etaad.r"sa.m karmma na cakaara|</para>
  <para style="p">
    <verse number="41" style="v"/>yuuya.m svasvapitu.h karmmaa.ni kurutha tadaa tairuktta.m na vaya.m jaarajaataa asmaakam ekaeva pitaasti sa eve"svara.h</para>
  <para style="p">
    <verse number="42" style="v"/>tato yii"sunaa kathitam ii"svaro yadi yu.smaaka.m taatobhavi.syat tarhi yuuya.m mayi premaakari.syata yatoham ii"svaraannirgatyaagatosmi svato naagatoha.m sa maa.m praahi.not|</para>
  <para style="p">
    <verse number="43" style="v"/>yuuya.m mama vaakyamida.m na budhyadhve kuta.h? yato yuuya.m mamopade"sa.m so.dhu.m na "saknutha|</para>
  <para style="p">
    <verse number="44" style="v"/>yuuya.m "saitaan pitu.h santaanaa etasmaad yu.smaaka.m piturabhilaa.sa.m puurayatha sa aa prathamaat naraghaatii tadanta.h satyatvasya le"sopi naasti kaara.naadata.h sa satyataayaa.m naati.s.that sa yadaa m.r.saa kathayati tadaa nijasvabhaavaanusaare.naiva kathayati yato sa m.r.saabhaa.sii m.r.sotpaadaka"sca|</para>
  <para style="p">
    <verse number="45" style="v"/>aha.m tathyavaakya.m vadaami kaara.naadasmaad yuuya.m maa.m na pratiitha|</para>
  <para style="p">
    <verse number="46" style="v"/>mayi paapamastiiti pramaa.na.m yu.smaaka.m ko daatu.m "saknoti? yadyaha.m tathyavaakya.m vadaami tarhi kuto maa.m na pratitha?</para>
  <para style="p">
    <verse number="47" style="v"/>ya.h ka"scana ii"svariiyo loka.h sa ii"svariiyakathaayaa.m mano nidhatte yuuyam ii"svariiyalokaa na bhavatha tannidaanaat tatra na manaa.msi nidhadve|</para>
  <para style="p">
    <verse number="48" style="v"/>tadaa yihuudiiyaa.h pratyavaadi.su.h tvameka.h "somiro.niiyo bhuutagrasta"sca vaya.m kimida.m bhadra.m naavaadi.sma?</para>
  <para style="p">
    <verse number="49" style="v"/>tato yii"su.h pratyavaadiit naaha.m bhuutagrasta.h kintu nijataata.m sammanye tasmaad yuuya.m maam apamanyadhve|</para>
  <para style="p">
    <verse number="50" style="v"/>aha.m svasukhyaati.m na ce.s.te kintu ce.s.titaa vicaarayitaa caapara eka aaste|</para>
  <para style="p">
    <verse number="51" style="v"/>aha.m yu.smabhyam atiiva yathaartha.m kathayaami yo naro madiiya.m vaaca.m manyate sa kadaacana nidhana.m na drak.syati|</para>
  <para style="p">
    <verse number="52" style="v"/>yihuudiiyaastamavadan tva.m bhuutagrasta itiidaaniim avai.sma| ibraahiim bhavi.syadvaadina nca sarvve m.rtaa.h kintu tva.m bhaa.sase yo naro mama bhaaratii.m g.rhlaati sa jaatu nidhaanaasvaada.m na lapsyate|</para>
  <para style="p">
    <verse number="53" style="v"/>tarhi tva.m kim asmaaka.m puurvvapuru.saad ibraahiimopi mahaan? yasmaat sopi m.rta.h bhavi.syadvaadinopi m.rtaa.h tva.m sva.m ka.m pumaa.msa.m manu.se?</para>
  <para style="p">
    <verse number="54" style="v"/>yii"su.h pratyavocad yadyaha.m sva.m svaya.m sammanye tarhi mama tat sammanana.m kimapi na kintu mama taato ya.m yuuya.m sviiyam ii"svara.m bhaa.sadhve saeva maa.m sammanute|</para>
  <para style="p">
    <verse number="55" style="v"/>yuuya.m ta.m naavagacchatha kintvaha.m tamavagacchaami ta.m naavagacchaamiiti vaakya.m yadi vadaami tarhi yuuyamiva m.r.saabhaa.sii bhavaami kintvaha.m tamavagacchaami tadaak.saamapi g.rhlaami|</para>
  <para style="p">
    <verse number="56" style="v"/>yu.smaaka.m puurvvapuru.sa ibraahiim mama samaya.m dra.s.tum atiivaavaa nchat tanniriik.syaanandacca|</para>
  <para style="p">
    <verse number="57" style="v"/>tadaa yihuudiiyaa ap.rcchan tava vaya.h pa ncaa"sadvatsaraa na tva.m kim ibraahiimam adraak.sii.h?</para>
  <para style="p">
    <verse number="58" style="v"/>yii"su.h pratyavaadiid yu.smaanaha.m yathaarthatara.m vadaami ibraahiimo janmana.h puurvvakaalamaarabhyaaha.m vidye|</para>
  <para style="p">
    <verse number="59" style="v"/>tadaa te paa.saa.naan uttolya tamaahantum udayacchan kintu yii"su rgupto mantiraad bahirgatya te.saa.m madhyena prasthitavaan|</para>
  <chapter number="9" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>tata.h para.m yii"surgacchan maargamadhye janmaandha.m naram apa"syat|</para>
  <para style="p">
    <verse number="2" style="v"/>tata.h "si.syaastam ap.rcchan he guro naroya.m svapaapena vaa svapitraa.h paapenaandho.ajaayata?</para>
  <para style="p">
    <verse number="3" style="v"/>tata.h sa pratyuditavaan etasya vaasya pitro.h paapaad etaad.r"sobhuuda iti nahi kintvanena yathe"svarasya karmma prakaa"syate taddhetoreva|</para>
  <para style="p">
    <verse number="4" style="v"/>dine ti.s.thati matprerayitu.h karmma mayaa karttavya.m yadaa kimapi karmma na kriyate taad.r"sii ni"saagacchati|</para>
  <para style="p">
    <verse number="5" style="v"/>aha.m yaavatkaala.m jagati ti.s.thaami taavatkaala.m jagato jyoti.hsvaruuposmi|</para>
  <para style="p">
    <verse number="6" style="v"/>ityukttaa bhuumau ni.s.thiiva.m nik.sipya tena pa"nka.m k.rtavaan</para>
  <para style="p">
    <verse number="7" style="v"/>pa"scaat tatpa"nkena tasyaandhasya netre pralipya tamityaadi"sat gatvaa "silohe .arthaat preritanaamni sarasi snaahi| tatondho gatvaa tatraasnaat tata.h prannacak.su rbhuutvaa vyaaghu.tyaagaat|</para>
  <para style="p">
    <verse number="8" style="v"/>apara nca samiipavaasino lokaa ye ca ta.m puurvvamandham apa"syan te bakttum aarabhanta yondhaloko vartmanyupavi"syaabhik.sata sa evaaya.m jana.h ki.m na bhavati?</para>
  <para style="p">
    <verse number="9" style="v"/>kecidavadan sa eva kecidavocan taad.r"so bhavati kintu sa svayamabraviit sa evaaha.m bhavaami|</para>
  <para style="p">
    <verse number="10" style="v"/>ataeva te .ap.rcchan tva.m katha.m d.r.s.ti.m paaptavaan?</para>
  <para style="p">
    <verse number="11" style="v"/>tata.h sovadad yii"sanaamaka eko jano mama nayane pa"nkena pralipya ityaaj naapayat "silohakaasaara.m gatvaa tatra snaahi| tatastatra gatvaa mayi snaate d.r.s.timaha.m labdhavaan|</para>
  <para style="p">
    <verse number="12" style="v"/>tadaa te .avadan sa pumaan kutra? tenoktta.m naaha.m jaanaami|</para>
  <para style="p">
    <verse number="13" style="v"/>apara.m tasmin puurvvaandhe jane phiruu"sinaa.m nika.tam aaniite sati phiruu"sinopi tamap.rcchan katha.m d.r.s.ti.m praaptosi?</para>
  <para style="p">
    <verse number="14" style="v"/>tata.h sa kathitavaan sa pa"nkena mama netre .alimpat pa"scaad snaatvaa d.r.s.timalabhe|</para>
  <para style="p">
    <verse number="15" style="v"/>kintu yii"su rvi"sraamavaare karddama.m k.rtvaa tasya nayane prasanne.akarod itikaara.naat katipayaphiruu"sino.avadan</para>
  <para style="p">
    <verse number="16" style="v"/>sa pumaan ii"svaraanna yata.h sa vi"sraamavaara.m na manyate| tatonye kecit pratyavadan paapii pumaan kim etaad.r"sam aa"scaryya.m karmma karttu.m "saknoti?</para>
  <para style="p">
    <verse number="17" style="v"/>ittha.m te.saa.m paraspara.m bhinnavaakyatvam abhavat| pa"scaat te punarapi ta.m puurvvaandha.m maanu.sam apraak.su.h yo janastava cak.su.sii prasanne k.rtavaan tasmin tva.m ki.m vadasi? sa ukttavaan sa bhavi"sadvaadii|</para>
  <para style="p">
    <verse number="18" style="v"/>sa d.r.s.tim aaptavaan iti yihuudiiyaastasya d.r.s.ti.m praaptasya janasya pitro rmukhaad a"srutvaa na pratyayan|</para>
  <para style="p">
    <verse number="19" style="v"/>ataeva te taavap.rcchan yuvayo rya.m putra.m janmaandha.m vadatha.h sa kimaya.m? tarhiidaanii.m katha.m dra.s.tu.m "saknoti?</para>
  <para style="p">
    <verse number="20" style="v"/>tatastasya pitarau pratyavocataam ayam aavayo.h putra aa janerandha"sca tadapyaavaa.m jaaniiva.h</para>
  <para style="p">
    <verse number="21" style="v"/>kintvadhunaa katha.m d.r.s.ti.m praaptavaan tadaavaa.m n jaaniiva.h kosya cak.su.sii prasanne k.rtavaan tadapi na jaaniiva e.sa vaya.hpraapta ena.m p.rcchata svakathaa.m svaya.m vak.syati|</para>
  <para style="p">
    <verse number="22" style="v"/>yihuudiiyaanaa.m bhayaat tasya pitarau vaakyamidam avadataa.m yata.h kopi manu.syo yadi yii"sum abhi.sikta.m vadati tarhi sa bhajanag.rhaad duuriikaari.syate yihuudiiyaa iti mantra.naam akurvvan</para>
  <para style="p">
    <verse number="23" style="v"/>atastasya pitarau vyaaharataam e.sa vaya.hpraapta ena.m p.rcchata|</para>
  <para style="p">
    <verse number="24" style="v"/>tadaa te puna"sca ta.m puurvvaandham aahuuya vyaaharan ii"svarasya gu.naan vada e.sa manu.sya.h paapiiti vaya.m jaaniima.h|</para>
  <para style="p">
    <verse number="25" style="v"/>tadaa sa ukttavaan sa paapii na veti naaha.m jaane puurvaamandha aasamaham adhunaa pa"syaamiiti maatra.m jaanaami|</para>
  <para style="p">
    <verse number="26" style="v"/>te punarap.rcchan sa tvaa.m prati kimakarot? katha.m netre prasanne .akarot?</para>
  <para style="p">
    <verse number="27" style="v"/>tata.h sovaadiid ekak.rtvokathaya.m yuuya.m na "s.r.nutha tarhi kuta.h puna.h "srotum icchatha? yuuyamapi ki.m tasya "si.syaa bhavitum icchatha?</para>
  <para style="p">
    <verse number="28" style="v"/>tadaa te ta.m tirask.rtya vyaaharan tva.m tasya "si.syo vaya.m muusaa.h "si.syaa.h|</para>
  <para style="p">
    <verse number="29" style="v"/>muusaavaktre.ne"svaro jagaada tajjaaniima.h kintve.sa kutratyaloka iti na jaaniima.h|</para>
  <para style="p">
    <verse number="30" style="v"/>sovadad e.sa mama locane prasanne .akarot tathaapi kutratyaloka iti yuuya.m na jaaniitha etad aa"scaryya.m bhavati|</para>
  <para style="p">
    <verse number="31" style="v"/>ii"svara.h paapinaa.m kathaa.m na "s.r.noti kintu yo janastasmin bhakti.m k.rtvaa tadi.s.takriyaa.m karoti tasyaiva kathaa.m "s.r.noti etad vaya.m jaaniima.h|</para>
  <para style="p">
    <verse number="32" style="v"/>kopi manu.syo janmaandhaaya cak.su.sii adadaat jagadaarambhaad etaad.r"sii.m kathaa.m kopi kadaapi naa"s.r.not|</para>
  <para style="p">
    <verse number="33" style="v"/>asmaad e.sa manu.syo yadii"svaraannaajaayata tarhi ki ncidapiid.r"sa.m karmma karttu.m naa"saknot|</para>
  <para style="p">
    <verse number="34" style="v"/>te vyaaharan tva.m paapaad ajaayathaa.h kimasmaan tva.m "sik.sayasi? pa"scaatte ta.m bahirakurvvan|</para>
  <para style="p">
    <verse number="35" style="v"/>tadanantara.m yihuudiiyai.h sa bahirakriyata yii"suriti vaarttaa.m "srutvaa ta.m saak.saat praapya p.r.s.tavaan ii"svarasya putre tva.m vi"svasi.si?</para>
  <para style="p">
    <verse number="36" style="v"/>tadaa sa pratyavocat he prabho sa ko yat tasminnaha.m vi"svasimi?</para>
  <para style="p">
    <verse number="37" style="v"/>tato yii"su.h kathitavaan tva.m ta.m d.r.s.tavaan tvayaa saaka.m ya.h katha.m kathayati saeva sa.h|</para>
  <para style="p">
    <verse number="38" style="v"/>tadaa he prabho vi"svasimiityuktvaa sa ta.m pra.naamat|</para>
  <para style="p">
    <verse number="39" style="v"/>pa"scaad yii"su.h kathitavaan nayanahiinaa nayanaani praapnuvanti nayanavanta"scaandhaa bhavantiityabhipraaye.na jagadaaham aagaccham|</para>
  <para style="p">
    <verse number="40" style="v"/>etat "srutvaa nika.tasthaa.h katipayaa.h phiruu"sino vyaaharan vayamapi kimandhaa.h?</para>
  <para style="p">
    <verse number="41" style="v"/>tadaa yii"suravaadiid yadyandhaa abhavata tarhi paapaani naati.s.than kintu pa"syaamiiti vaakyavadanaad yu.smaaka.m paapaani ti.s.thanti|</para>
  <chapter number="10" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>aha.m yu.smaanatiyathaartha.m vadaami, yo jano dvaare.na na pravi"sya kenaapyanyena me.sag.rha.m pravi"sati sa eva steno dasyu"sca|</para>
  <para style="p">
    <verse number="2" style="v"/>yo dvaare.na pravi"sati sa eva me.sapaalaka.h|</para>
  <para style="p">
    <verse number="3" style="v"/>dauvaarikastasmai dvaara.m mocayati me.saga.na"sca tasya vaakya.m "s.r.noti sa nijaan me.saan svasvanaamnaahuuya bahi.h k.rtvaa nayati|</para>
  <para style="p">
    <verse number="4" style="v"/>tathaa nijaan me.saan bahi.h k.rtvaa svaya.m te.saam agre gacchati, tato me.saastasya "sabda.m budhyante, tasmaat tasya pa"scaad vrajanti|</para>
  <para style="p">
    <verse number="5" style="v"/>kintu parasya "sabda.m na budhyante tasmaat tasya pa"scaad vraji.syanti vara.m tasya samiipaat palaayi.syante|</para>
  <para style="p">
    <verse number="6" style="v"/>yii"sustebhya imaa.m d.r.s.taantakathaam akathayat kintu tena kathitakathaayaastaatparyya.m te naabudhyanta|</para>
  <para style="p">
    <verse number="7" style="v"/>ato yii"su.h punarakathayat, yu.smaanaaha.m yathaarthatara.m vyaaharaami, me.sag.rhasya dvaaram ahameva|</para>
  <para style="p">
    <verse number="8" style="v"/>mayaa na pravi"sya ya aagacchan te stenaa dasyava"sca kintu me.saaste.saa.m kathaa naa"s.r.nvan|</para>
  <para style="p">
    <verse number="9" style="v"/>ahameva dvaarasvaruupa.h, mayaa ya.h ka"scita pravi"sati sa rak.saa.m praapsyati tathaa bahiranta"sca gamanaagamane k.rtvaa cara.nasthaana.m praapsyati|</para>
  <para style="p">
    <verse number="10" style="v"/>yo janastena.h sa kevala.m stainyabadhavinaa"saan karttumeva samaayaati kintvaham aayu rdaatum arthaat baahuulyena tadeva daatum aagaccham|</para>
  <para style="p">
    <verse number="11" style="v"/>ahameva satyame.sapaalako yastu satyo me.sapaalaka.h sa me.saartha.m praa.natyaaga.m karoti;</para>
  <para style="p">
    <verse number="12" style="v"/>kintu yo jano me.sapaalako na, arthaad yasya me.saa nijaa na bhavanti, ya etaad.r"so vaitanika.h sa v.rkam aagacchanta.m d.r.s.tvaa mejavraja.m vihaaya palaayate, tasmaad v.rkasta.m vraja.m dh.rtvaa vikirati|</para>
  <para style="p">
    <verse number="13" style="v"/>vaitanika.h palaayate yata.h sa vetanaarthii me.saartha.m na cintayati|</para>
  <para style="p">
    <verse number="14" style="v"/>ahameva satyo me.sapaalaka.h, pitaa maa.m yathaa jaanaati, aha nca yathaa pitara.m jaanaami,</para>
  <para style="p">
    <verse number="15" style="v"/>tathaa nijaan me.saanapi jaanaami, me.saa"sca maa.m jaanaanti, aha nca me.saartha.m praa.natyaaga.m karomi|</para>
  <para style="p">
    <verse number="16" style="v"/>apara nca etad g.rhiiya me.sebhyo bhinnaa api me.saa mama santi te sakalaa aanayitavyaa.h; te mama "sabda.m "sro.syanti tata eko vraja eko rak.sako bhavi.syati|</para>
  <para style="p">
    <verse number="17" style="v"/>praa.naanaha.m tyaktvaa puna.h praa.naan grahii.syaami, tasmaat pitaa mayi sneha.m karoti|</para>
  <para style="p">
    <verse number="18" style="v"/>ka"scijjano mama praa.naan hantu.m na "saknoti kintu svaya.m taan samarpayaami taan samarpayitu.m punargrahiitu nca mama "saktiraaste bhaaramima.m svapitu.h sakaa"saat praaptoham|</para>
  <para style="p">
    <verse number="19" style="v"/>asmaadupade"saat puna"sca yihuudiiyaanaa.m madhye bhinnavaakyataa jaataa|</para>
  <para style="p">
    <verse number="20" style="v"/>tato bahavo vyaaharan e.sa bhuutagrasta unmatta"sca, kuta etasya kathaa.m "s.r.nutha?</para>
  <para style="p">
    <verse number="21" style="v"/>kecid avadan etasya kathaa bhuutagrastasya kathaavanna bhavanti, bhuuta.h kim andhaaya cak.su.sii daatu.m "saknoti?</para>
  <para style="p">
    <verse number="22" style="v"/>"siitakaale yiruu"saalami mandirotsargaparvva.nyupasthite</para>
  <para style="p">
    <verse number="23" style="v"/>yii"su.h sulemaano ni.hsaare.na gamanaagamane karoti,</para>
  <para style="p">
    <verse number="24" style="v"/>etasmin samaye yihuudiiyaasta.m ve.s.tayitvaa vyaaharan kati kaalaan asmaaka.m vicikitsaa.m sthaapayi.syaami? yadyabhi.sikto bhavati tarhi tat spa.s.ta.m vada|</para>
  <para style="p">
    <verse number="25" style="v"/>tadaa yii"su.h pratyavadad aham acakatha.m kintu yuuya.m na pratiitha, nijapitu rnaamnaa yaa.m yaa.m kriyaa.m karomi saa kriyaiva mama saak.sisvaruupaa|</para>
  <para style="p">
    <verse number="26" style="v"/>kintvaha.m puurvvamakathaya.m yuuya.m mama me.saa na bhavatha, kaara.naadasmaan na vi"svasitha|</para>
  <para style="p">
    <verse number="27" style="v"/>mama me.saa mama "sabda.m "s.r.nvanti taanaha.m jaanaami te ca mama pa"scaad gacchanti|</para>
  <para style="p">
    <verse number="28" style="v"/>aha.m tebhyo.anantaayu rdadaami, te kadaapi na na.mk.syanti kopi mama karaat taan harttu.m na "sak.syati|</para>
  <para style="p">
    <verse number="29" style="v"/>yo mama pitaa taan mahya.m dattavaan sa sarvvasmaat mahaan, kopi mama pitu.h karaat taan harttu.m na "sak.syati|</para>
  <para style="p">
    <verse number="30" style="v"/>aha.m pitaa ca dvayorekatvam|</para>
  <para style="p">
    <verse number="31" style="v"/>tato yihuudiiyaa.h punarapi ta.m hantu.m paa.saa.naan udatolayan|</para>
  <para style="p">
    <verse number="32" style="v"/>yii"su.h kathitavaan pitu.h sakaa"saad bahuunyuttamakarmmaa.ni yu.smaaka.m praakaa"saya.m te.saa.m kasya karmma.na.h kaara.naan maa.m paa.saa.nairaahantum udyataa.h stha?</para>
  <para style="p">
    <verse number="33" style="v"/>yihuudiiyaa.h pratyavadan pra"sastakarmmaheto rna kintu tva.m maanu.sa.h svamii"svaram uktve"svara.m nindasi kaara.naadasmaat tvaa.m paa.saa.nairhanma.h|</para>
  <para style="p">
    <verse number="34" style="v"/>tadaa yii"su.h pratyuktavaan mayaa kathita.m yuuyam ii"svaraa etadvacana.m yu.smaaka.m "saastre likhita.m naasti ki.m?</para>
  <para style="p">
    <verse number="35" style="v"/>tasmaad ye.saam udde"se ii"svarasya kathaa kathitaa te yadii"svaraga.naa ucyante dharmmagranthasyaapyanyathaa bhavitu.m na "sakya.m,</para>
  <para style="p">
    <verse number="36" style="v"/>tarhyaaham ii"svarasya putra iti vaakyasya kathanaat yuuya.m pitraabhi.sikta.m jagati prerita nca pumaa.msa.m katham ii"svaranindaka.m vaadaya?</para>
  <para style="p">
    <verse number="37" style="v"/>yadyaha.m pitu.h karmma na karomi tarhi maa.m na pratiita;</para>
  <para style="p">
    <verse number="38" style="v"/>kintu yadi karomi tarhi mayi yu.smaabhi.h pratyaye na k.rte.api kaaryye pratyaya.h kriyataa.m, tato mayi pitaastiiti pitaryyaham asmiiti ca k.saatvaa vi"svasi.syatha|</para>
  <para style="p">
    <verse number="39" style="v"/>tadaa te punarapi ta.m dharttum ace.s.tanta kintu sa te.saa.m karebhyo nistiiryya</para>
  <para style="p">
    <verse number="40" style="v"/>puna ryarddan adyaasta.te yatra purvva.m yohan amajjayat tatraagatya nyavasat|</para>
  <para style="p">
    <verse number="41" style="v"/>tato bahavo lokaastatsamiipam aagatya vyaaharan yohan kimapyaa"scaryya.m karmma naakarot kintvasmin manu.sye yaa ya.h kathaa akathayat taa.h sarvvaa.h satyaa.h;</para>
  <para style="p">
    <verse number="42" style="v"/>tatra ca bahavo lokaastasmin vya"svasan|</para>
  <chapter number="11" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>anantara.m mariyam tasyaa bhaginii marthaa ca yasmin vaithaniiyaagraame vasatastasmin graame iliyaasar naamaa pii.dita eka aasiit|</para>
  <para style="p">
    <verse number="2" style="v"/>yaa mariyam prabhu.m sugandhitelaina marddayitvaa svake"saistasya cara.nau samamaarjat tasyaa bhraataa sa iliyaasar rogii|</para>
  <para style="p">
    <verse number="3" style="v"/>apara nca he prabho bhavaan yasmin priiyate sa eva pii.ditostiiti kathaa.m kathayitvaa tasya bhaginyau pre.sitavatyau|</para>
  <para style="p">
    <verse number="4" style="v"/>tadaa yii"surimaa.m vaarttaa.m "srutvaakathayata pii.deya.m mara.naartha.m na kintvii"svarasya mahimaartham ii"svaraputrasya mahimaprakaa"saartha nca jaataa|</para>
  <para style="p">
    <verse number="5" style="v"/>yii"su ryadyapimarthaayaa.m tadbhaginyaam iliyaasari caapriiyata,</para>
  <para style="p">
    <verse number="6" style="v"/>tathaapi iliyaasara.h pii.daayaa.h katha.m "srutvaa yatra aasiit tatraiva dinadvayamati.s.that|</para>
  <para style="p">
    <verse number="7" style="v"/>tata.h param sa "si.syaanakathayad vaya.m puna ryihuudiiyaprade"sa.m yaama.h|</para>
  <para style="p">
    <verse number="8" style="v"/>tataste pratyavadan, he guro svalpadinaani gataani yihuudiiyaastvaa.m paa.saa.nai rhantum udyataastathaapi ki.m punastatra yaasyasi?</para>
  <para style="p">
    <verse number="9" style="v"/>yii"su.h pratyavadat, ekasmin dine ki.m dvaada"sagha.tikaa na bhavanti? kopi divaa gacchan na skhalati yata.h sa etajjagato diipti.m praapnoti|</para>
  <para style="p">
    <verse number="10" style="v"/>kintu raatrau gacchan skhalati yato hetostatra diipti rnaasti|</para>
  <para style="p">
    <verse number="11" style="v"/>imaa.m kathaa.m kathayitvaa sa taanavadad, asmaaka.m bandhu.h iliyaasar nidritobhuud idaanii.m ta.m nidraato jaagarayitu.m gacchaami|</para>
  <para style="p">
    <verse number="12" style="v"/>yii"su rm.rtau kathaamimaa.m kathitavaan kintu vi"sraamaartha.m nidraayaa.m kathitavaan iti j naatvaa "si.syaa akathayan,</para>
  <para style="p">
    <verse number="13" style="v"/>he guro sa yadi nidraati tarhi bhadrameva|</para>
  <para style="p">
    <verse number="14" style="v"/>tadaa yii"su.h spa.s.ta.m taan vyaaharat, iliyaasar amriyata;</para>
  <para style="p">
    <verse number="15" style="v"/>kintu yuuya.m yathaa pratiitha tadarthamaha.m tatra na sthitavaan ityasmaad yu.smannimittam aahlaaditoha.m, tathaapi tasya samiipe yaama|</para>
  <para style="p">
    <verse number="16" style="v"/>tadaa thomaa ya.m diduma.m vadanti sa sa"ngina.h "si.syaan avadad vayamapi gatvaa tena saarddha.m mriyaamahai|</para>
  <para style="p">
    <verse number="17" style="v"/>yii"sustatropasthaaya iliyaasara.h "sma"saane sthaapanaat catvaari dinaani gataaniiti vaarttaa.m "srutavaan|</para>
  <para style="p">
    <verse number="18" style="v"/>vaithaniiyaa yiruu"saalama.h samiipasthaa kro"saikamaatraantaritaa;</para>
  <para style="p">
    <verse number="19" style="v"/>tasmaad bahavo yihuudiiyaa marthaa.m mariyama nca bhyaat.r"sokaapannaa.m saantvayitu.m tayo.h samiipam aagacchan|</para>
  <para style="p">
    <verse number="20" style="v"/>marthaa yii"soraagamanavaartaa.m "srutvaiva ta.m saak.saad akarot kintu mariyam geha upavi"sya sthitaa|</para>
  <para style="p">
    <verse number="21" style="v"/>tadaa marthaa yii"sumavaadat, he prabho yadi bhavaan atraasthaasyat tarhi mama bhraataa naamari.syat|</para>
  <para style="p">
    <verse number="22" style="v"/>kintvidaaniimapi yad ii"svare praarthayi.syate ii"svarastad daasyatiiti jaane.aha.m|</para>
  <para style="p">
    <verse number="23" style="v"/>yii"suravaadiit tava bhraataa samutthaasyati|</para>
  <para style="p">
    <verse number="24" style="v"/>marthaa vyaaharat "se.sadivase sa utthaanasamaye protthaasyatiiti jaane.aha.m|</para>
  <para style="p">
    <verse number="25" style="v"/>tadaa yii"su.h kathitavaan ahameva utthaapayitaa jiivayitaa ca ya.h ka"scana mayi vi"svasiti sa m.rtvaapi jiivi.syati;</para>
  <para style="p">
    <verse number="26" style="v"/>ya.h ka"scana ca jiivan mayi vi"svasiti sa kadaapi na mari.syati, asyaa.m kathaayaa.m ki.m vi"svasi.si?</para>
  <para style="p">
    <verse number="27" style="v"/>saavadat prabho yasyaavatara.naapek.saasti bhavaan saevaabhi.siktta ii"svaraputra iti vi"svasimi|</para>
  <para style="p">
    <verse number="28" style="v"/>iti kathaa.m kathayitvaa saa gatvaa svaa.m bhaginii.m mariyama.m guptamaahuuya vyaaharat gururupati.s.thati tvaamaahuuyati ca|</para>
  <para style="p">
    <verse number="29" style="v"/>kathaamimaa.m "srutvaa saa tuur.nam utthaaya tasya samiipam agacchat|</para>
  <para style="p">
    <verse number="30" style="v"/>yii"su rgraamamadhya.m na pravi"sya yatra marthaa ta.m saak.saad akarot tatra sthitavaan|</para>
  <para style="p">
    <verse number="31" style="v"/>ye yihuudiiyaa mariyamaa saaka.m g.rhe ti.s.thantastaam asaantvayana te taa.m k.sipram utthaaya gacchanti.m vilokya vyaaharan, sa "sma"saane roditu.m yaati, ityuktvaa te tasyaa.h pa"scaad agacchan|</para>
  <para style="p">
    <verse number="32" style="v"/>yatra yii"surati.s.that tatra mariyam upasthaaya ta.m d.r.s.tvaa tasya cara.nayo.h patitvaa vyaaharat he prabho yadi bhavaan atraasthaasyat tarhi mama bhraataa naamari.syat|</para>
  <para style="p">
    <verse number="33" style="v"/>yii"sustaa.m tasyaa.h sa"ngino yihuudiiyaa.m"sca rudato vilokya "sokaartta.h san diirgha.m ni"svasya kathitavaan ta.m kutraasthaapayata?</para>
  <para style="p">
    <verse number="34" style="v"/>te vyaaharan, he prabho bhavaan aagatya pa"syatu|</para>
  <para style="p">
    <verse number="35" style="v"/>yii"sunaa krandita.m|</para>
  <para style="p">
    <verse number="36" style="v"/>ataeva yihuudiiyaa avadan, pa"syataaya.m tasmin kid.rg apriyata|</para>
  <para style="p">
    <verse number="37" style="v"/>te.saa.m kecid avadan yondhaaya cak.su.sii dattavaan sa kim asya m.rtyu.m nivaarayitu.m naa"saknot?</para>
  <para style="p">
    <verse number="38" style="v"/>tato yii"su.h punarantardiirgha.m ni"svasya "sma"saanaantikam agacchat| tat "sma"saanam eka.m gahvara.m tanmukhe paa.saa.na eka aasiit|</para>
  <para style="p">
    <verse number="39" style="v"/>tadaa yii"suravadad ena.m paa.saa.nam apasaarayata, tata.h pramiitasya bhaginii marthaavadat prabho, adhunaa tatra durgandho jaata.h, yatodya catvaari dinaani "sma"saane sa ti.s.thati|</para>
  <para style="p">
    <verse number="40" style="v"/>tadaa yii"suravaadiit, yadi vi"svasi.si tarhii"svarasya mahimaprakaa"sa.m drak.syasi kathaamimaa.m ki.m tubhya.m naakathaya.m?</para>
  <para style="p">
    <verse number="41" style="v"/>tadaa m.rtasya "sma"saanaat paa.saa.no.apasaarite yii"suruurdvva.m pa"syan akathayat, he pita rmama nevesanam a"s.r.no.h kaara.naadasmaat tvaa.m dhanya.m vadaami|</para>
  <para style="p">
    <verse number="42" style="v"/>tva.m satata.m "s.r.no.si tadapyaha.m jaanaami, kintu tva.m maa.m yat prairayastad yathaasmin sthaane sthitaa lokaa vi"svasanti tadartham ida.m vaakya.m vadaami|</para>
  <para style="p">
    <verse number="43" style="v"/>imaa.m kathaa.m kathayitvaa sa proccairaahvayat, he iliyaasar bahiraagaccha|</para>
  <para style="p">
    <verse number="44" style="v"/>tata.h sa pramiita.h "sma"saanavastrai rbaddhahastapaado gaatramaarjanavaasasaa baddhamukha"sca bahiraagacchat| yii"suruditavaan bandhanaani mocayitvaa tyajataina.m|</para>
  <para style="p">
    <verse number="45" style="v"/>mariyama.h samiipam aagataa ye yihuudiiyalokaastadaa yii"soretat karmmaapa"syan te.saa.m bahavo vya"svasan,</para>
  <para style="p">
    <verse number="46" style="v"/>kintu kecidanye phiruu"sinaa.m samiipa.m gatvaa yii"soretasya karmma.no vaarttaam avadan|</para>
  <para style="p">
    <verse number="47" style="v"/>tata.h para.m pradhaanayaajakaa.h phiruu"sinaa"sca sabhaa.m k.rtvaa vyaaharan vaya.m ki.m kurmma.h? e.sa maanavo bahuunyaa"scaryyakarmmaa.ni karoti|</para>
  <para style="p">
    <verse number="48" style="v"/>yadiid.r"sa.m karmma karttu.m na vaarayaamastarhi sarvve lokaastasmin vi"svasi.syanti romilokaa"scaagatyaasmaakam anayaa raajadhaanyaa saarddha.m raajyam aachetsyanti|</para>
  <para style="p">
    <verse number="49" style="v"/>tadaa te.saa.m kiyaphaanaamaa yastasmin vatsare mahaayaajakapade nyayujyata sa pratyavadad yuuya.m kimapi na jaaniitha;</para>
  <para style="p">
    <verse number="50" style="v"/>samagrade"sasya vinaa"satopi sarvvalokaartham ekasya janasya mara.nam asmaaka.m ma"ngalahetukam etasya vivecanaamapi na kurutha|</para>
  <para style="p">
    <verse number="51" style="v"/>etaa.m kathaa.m sa nijabuddhyaa vyaaharad iti na,</para>
  <para style="p">
    <verse number="52" style="v"/>kintu yii"suustadde"siiyaanaa.m kaara.naat praa.naan tyak.syati, di"si di"si vikiir.naan ii"svarasya santaanaan sa.mg.rhyaikajaati.m kari.syati ca, tasmin vatsare kiyaphaa mahaayaajakatvapade niyukta.h san ida.m bhavi.syadvaakya.m kathitavaan|</para>
  <para style="p">
    <verse number="53" style="v"/>taddinamaarabhya te katha.m ta.m hantu.m "saknuvantiiti mantra.naa.m karttu.m praarebhire|</para>
  <para style="p">
    <verse number="54" style="v"/>ataeva yihuudiiyaanaa.m madhye yii"su.h saprakaa"sa.m gamanaagamane ak.rtvaa tasmaad gatvaa praantarasya samiipasthaayiprade"sasyephraayim naamni nagare "si.syai.h saaka.m kaala.m yaapayitu.m praarebhe|</para>
  <para style="p">
    <verse number="55" style="v"/>anantara.m yihuudiiyaanaa.m nistaarotsave nika.tavarttini sati tadutsavaat puurvva.m svaan "suciin karttu.m bahavo janaa graamebhyo yiruu"saalam nagaram aagacchan,</para>
  <para style="p">
    <verse number="56" style="v"/>yii"soranve.sa.na.m k.rtvaa mandire da.n.daayamaanaa.h santa.h paraspara.m vyaaharan, yu.smaaka.m kiid.r"so bodho jaayate? sa kim utsave.asmin atraagami.syati?</para>
  <para style="p">
    <verse number="57" style="v"/>sa ca kutraasti yadyetat ka"scid vetti tarhi dar"sayatu pradhaanayaajakaa.h phiruu"sina"sca ta.m dharttu.m puurvvam imaam aaj naa.m praacaarayan|</para>
  <chapter number="12" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>nistaarotsavaat puurvva.m dina.sa.tke sthite yii"su rya.m pramiitam iliyaasara.m "sma"saanaad udasthaaparat tasya nivaasasthaana.m baithaniyaagraamam aagacchat|</para>
  <para style="p">
    <verse number="2" style="v"/>tatra tadartha.m rajanyaa.m bhojye k.rte marthaa paryyave.sayad iliyaasar ca tasya sa"ngibhi.h saarddha.m bhojanaasana upaavi"sat|</para>
  <para style="p">
    <verse number="3" style="v"/>tadaa mariyam arddhase.taka.m bahumuulya.m ja.taamaa.msiiya.m tailam aaniiya yii"so"scara.nayo rmarddayitvaa nijake"sa rmaar.s.tum aarabhata; tadaa tailasya parimalena g.rham aamoditam abhavat|</para>
  <para style="p">
    <verse number="4" style="v"/>ya.h "simona.h putra ri.skariyotiiyo yihuudaanaamaa yii"su.m parakare.su samarpayi.syati sa "si.syastadaa kathitavaan,</para>
  <para style="p">
    <verse number="5" style="v"/>etattaila.m tribhi.h "satai rmudraapadai rvikriita.m sad daridrebhya.h kuto naadiiyata?</para>
  <para style="p">
    <verse number="6" style="v"/>sa daridralokaartham acintayad iti na, kintu sa caura eva.m tannika.te mudraasampu.takasthityaa tanmadhye yadati.s.that tadapaaharat tasmaat kaara.naad imaa.m kathaamakathayat|</para>
  <para style="p">
    <verse number="7" style="v"/>tadaa yii"surakathayad enaa.m maa vaaraya saa mama "sma"saanasthaapanadinaartha.m tadarak.sayat|</para>
  <para style="p">
    <verse number="8" style="v"/>daridraa yu.smaaka.m sannidhau sarvvadaa ti.s.thanti kintvaha.m sarvvadaa yu.smaaka.m sannidhau na ti.s.thaami|</para>
  <para style="p">
    <verse number="9" style="v"/>tata.h para.m yii"sustatraastiiti vaarttaa.m "srutvaa bahavo yihuudiiyaasta.m "sma"saanaadutthaapitam iliyaasara nca dra.s.tu.m tat sthaanam aagacchana|</para>
  <para style="p">
    <verse number="10" style="v"/>tadaa pradhaanayaajakaastam iliyaasaramapi sa.mharttum amantrayan ;</para>
  <para style="p">
    <verse number="11" style="v"/>yatastena bahavo yihuudiiyaa gatvaa yii"sau vya"svasan|</para>
  <para style="p">
    <verse number="12" style="v"/>anantara.m yii"su ryiruu"saalam nagaram aagacchatiiti vaarttaa.m "srutvaa pare.ahani utsavaagataa bahavo lokaa.h</para>
  <para style="p">
    <verse number="13" style="v"/>kharjjuurapatraadyaaniiya ta.m saak.saat karttu.m bahiraagatya jaya jayeti vaaca.m proccai rvaktum aarabhanta, israayelo yo raajaa parame"svarasya naamnaagacchati sa dhanya.h|</para>
  <para style="p">
    <verse number="14" style="v"/>tadaa "he siyona.h kanye maa bhai.sii.h pa"syaaya.m tava raajaa garddabha"saavakam aaruhyaagacchati"</para>
  <para style="p">
    <verse number="15" style="v"/>iti "saastriiyavacanaanusaare.na yii"sureka.m yuvagarddabha.m praapya taduparyyaarohat|</para>
  <para style="p">
    <verse number="16" style="v"/>asyaa.h gha.tanaayaastaatparyya.m "si.syaa.h prathama.m naabudhyanta, kintu yii"sau mahimaana.m praapte sati vaakyamida.m tasmina akathyata lokaa"sca tampratiittham akurvvan iti te sm.rtavanta.h|</para>
  <para style="p">
    <verse number="17" style="v"/>sa iliyaasara.m "sma"saanaad aagantum aahvatavaan "sma"saanaa nca udasthaapayad ye ye lokaastatkarmya saak.saad apa"syan te pramaa.na.m daatum aarabhanta|</para>
  <para style="p">
    <verse number="18" style="v"/>sa etaad.r"sam adbhuta.m karmmakarot tasya jana"srute rlokaasta.m saak.saat karttum aagacchan|</para>
  <para style="p">
    <verse number="19" style="v"/>tata.h phiruu"sina.h paraspara.m vaktum aarabhanta yu.smaaka.m sarvvaa"sce.s.taa v.rthaa jaataa.h, iti ki.m yuuya.m na budhyadhve? pa"syata sarvve lokaastasya pa"scaadvarttinobhavan|</para>
  <para style="p">
    <verse number="20" style="v"/>bhajana.m karttum utsavaagataanaa.m lokaanaa.m katipayaa janaa anyade"siiyaa aasan ,</para>
  <para style="p">
    <verse number="21" style="v"/>te gaaliiliiyabaitsaidaanivaasina.h philipasya samiipam aagatya vyaaharan he maheccha vaya.m yii"su.m dra.s.tum icchaama.h|</para>
  <para style="p">
    <verse number="22" style="v"/>tata.h philipo gatvaa aandriyam avadat pa"scaad aandriyaphilipau yii"save vaarttaam akathayataa.m|</para>
  <para style="p">
    <verse number="23" style="v"/>tadaa yii"su.h pratyuditavaan maanavasutasya mahimapraaptisamaya upasthita.h|</para>
  <para style="p">
    <verse number="24" style="v"/>aha.m yu.smaanatiyathaartha.m vadaami, dhaanyabiija.m m.rttikaayaa.m patitvaa yadi na m.ryate tarhyekaakii ti.s.thati kintu yadi m.ryate tarhi bahugu.na.m phala.m phalati|</para>
  <para style="p">
    <verse number="25" style="v"/>yo janeा nijapraa.naan priyaan jaanaati sa taan haarayi.syati kintu yeा jana ihaloke nijapraa.naan apriyaan jaanaati seाnantaayu.h praaptu.m taan rak.si.syati|</para>
  <para style="p">
    <verse number="26" style="v"/>ka"scid yadi mama sevako bhavitu.m vaa nchati tarhi sa mama pa"scaadgaamii bhavatu, tasmaad aha.m yatra ti.s.thaami mama sevakeाpi tatra sthaasyati; yo jano maa.m sevate mama pitaapi ta.m samma.msyate|</para>
  <para style="p">
    <verse number="27" style="v"/>saamprata.m mama praa.naa vyaakulaa bhavanti, tasmaad he pitara etasmaat samayaan maa.m rak.sa, ityaha.m ki.m praarthayi.sye? kintvaham etatsamayaartham avatiir.navaan|</para>
  <para style="p">
    <verse number="28" style="v"/>he pita: svanaamno mahimaana.m prakaa"saya; tanaiva svanaamno mahimaanam aha.m praakaa"saya.m punarapi prakaa"sayi.syaami, e.saa gaga.niiyaa vaa.nii tasmin samaye.ajaayata|</para>
  <para style="p">
    <verse number="29" style="v"/>tac"srutvaa samiipasthalokaanaa.m kecid avadan megho.agarjiit, kecid avadan svargiiyaduuto.anena saha kathaamacakathat|</para>
  <para style="p">
    <verse number="30" style="v"/>tadaa yii"su.h pratyavaadiit, madartha.m "sabdoya.m naabhuut yu.smadarthamevaabhuut|</para>
  <para style="p">
    <verse number="31" style="v"/>adhunaa jagatosya vicaara: sampatsyate, adhunaasya jagata: patii raajyaat cyo.syati|</para>
  <para style="p">
    <verse number="32" style="v"/>yadyaii p.rthivyaa uurdvve protthaapitosmi tarhi sarvvaan maanavaan svasamiipam aakar.si.syaami|</para>
  <para style="p">
    <verse number="33" style="v"/>katha.m tasya m.rti rbhavi.syati, etad bodhayitu.m sa imaa.m kathaam akathayat|</para>
  <para style="p">
    <verse number="34" style="v"/>tadaa lokaa akathayan sobhi.sikta.h sarvvadaa ti.s.thatiiti vyavasthaagranthe "srutam asmaabhi.h, tarhi manu.syaputra.h protthaapito bhavi.syatiiti vaakya.m katha.m vadasi? manu.syaputroya.m ka.h?</para>
  <para style="p">
    <verse number="35" style="v"/>tadaa yii"surakathaayad yu.smaabhi.h saarddham alpadinaani jyotiraaste, yathaa yu.smaan andhakaaro naacchaadayati tadartha.m yaavatkaala.m yu.smaabhi.h saarddha.m jyotisti.s.thati taavatkaala.m gacchata; yo jano.andhakaare gacchati sa kutra yaatiiti na jaanaati|</para>
  <para style="p">
    <verse number="36" style="v"/>ataeva yaavatkaala.m yu.smaaka.m nika.te jyotiraaste taavatkaala.m jyotiiruupasantaanaa bhavitu.m jyoti.si vi"svasita; imaa.m kathaa.m kathayitvaa yii"su.h prasthaaya tebhya.h sva.m guptavaan|</para>
  <para style="p">
    <verse number="37" style="v"/>yadyapi yii"suste.saa.m samak.sam etaavadaa"scaryyakarmmaa.ni k.rtavaan tathaapi te tasmin na vya"svasan|</para>
  <para style="p">
    <verse number="38" style="v"/>ataeva ka.h pratyeti susa.mvaada.m pare"saasmat pracaarita.m? prakaa"sate pare"sasya hasta.h kasya ca sannidhau? yi"sayiyabhavi.syadvaadinaa yadetad vaakyamukta.m tat saphalam abhavat|</para>
  <para style="p">
    <verse number="39" style="v"/>te pratyetu.m naa"sankuvan tasmin yi"sayiyabhavi.syadvaadi punaravaadiid,</para>
  <para style="p">
    <verse number="40" style="v"/>yadaa, "te nayanai rna pa"syanti buddhibhi"sca na budhyante tai rmana.hsu parivarttite.su ca taanaha.m yathaa svasthaan na karomi tathaa sa te.saa.m locanaanyandhaani k.rtvaa te.saamanta.hkara.naani gaa.dhaani kari.syati|"</para>
  <para style="p">
    <verse number="41" style="v"/>yi"sayiyo yadaa yii"so rmahimaana.m vilokya tasmin kathaamakathayat tadaa bhavi.syadvaakyam iid.r"sa.m prakaa"sayat|</para>
  <para style="p">
    <verse number="42" style="v"/>tathaapyadhipatinaa.m bahavastasmin pratyaayan| kintu phiruu"sinastaan bhajanag.rhaad duuriikurvvantiiti bhayaat te ta.m na sviik.rtavanta.h|</para>
  <para style="p">
    <verse number="43" style="v"/>yata ii"svarasya pra"sa.msaato maanavaanaa.m pra"sa.msaayaa.m te.apriyanta|</para>
  <para style="p">
    <verse number="44" style="v"/>tadaa yii"suruccai.hkaaram akathayad yo jano mayi vi"svasiti sa kevale mayi vi"svasitiiti na, sa matprerake.api vi"svasiti|</para>
  <para style="p">
    <verse number="45" style="v"/>yo jano maa.m pa"syati sa matprerakamapi pa"syati|</para>
  <para style="p">
    <verse number="46" style="v"/>yo jano maa.m pratyeti sa yathaandhakaare na ti.s.thati tadartham aha.m jyoti.hsvaruupo bhuutvaa jagatyasmin avatiir.navaan|</para>
  <para style="p">
    <verse number="47" style="v"/>mama kathaa.m "srutvaa yadi ka"scin na vi"svasiti tarhi tamaha.m do.si.na.m na karomi, yato heto rjagato janaanaa.m do.saan ni"scitaan karttu.m naagatya taan paricaatum aagatosmi|</para>
  <para style="p">
    <verse number="48" style="v"/>ya.h ka"scin maa.m na "sraddhaaya mama katha.m na g.rhlaati, anyasta.m do.si.na.m kari.syati vastutastu yaa.m kathaamaham acakatha.m saa kathaa carame.anhi ta.m do.si.na.m kari.syati|</para>
  <para style="p">
    <verse number="49" style="v"/>yato hetoraha.m svata.h kimapi na kathayaami, ki.m ki.m mayaa kathayitavya.m ki.m samupade.s.tavya nca iti matprerayitaa pitaa maamaaj naapayat|</para>
  <para style="p">
    <verse number="50" style="v"/>tasya saaj naa anantaayurityaha.m jaanaami, ataevaaha.m yat kathayaami tat pitaa yathaaj naapayat tathaiva kathayaamyaham|</para>
  <chapter number="13" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>nistaarotsavasya ki ncitkaalaat puurvva.m p.rthivyaa.h pitu.h samiipagamanasya samaya.h sannikar.sobhuud iti j naatvaa yii"suraaprathamaad ye.su jagatpravaasi.svaatmiiyaloke.sa prema karoti sma te.su "se.sa.m yaavat prema k.rtavaan|</para>
  <para style="p">
    <verse number="2" style="v"/>pitaa tasya haste sarvva.m samarpitavaan svayam ii"svarasya samiipaad aagacchad ii"svarasya samiipa.m yaasyati ca, sarvvaa.nyetaani j naatvaa rajanyaa.m bhojane sampuur.ne sati,</para>
  <para style="p">
    <verse number="3" style="v"/>yadaa "saitaan ta.m parahaste.su samarpayitu.m "simona.h putrasya ii.skaariyotiyasya yihuudaa anta.hkara.ne kuprav.rtti.m samaarpayat,</para>
  <para style="p">
    <verse number="4" style="v"/>tadaa yii"su rbhojanaasanaad utthaaya gaatravastra.m mocayitvaa gaatramaarjanavastra.m g.rhiitvaa tena svaka.tim abadhnaat,</para>
  <para style="p">
    <verse number="5" style="v"/>pa"scaad ekapaatre jalam abhi.sicya "si.syaa.naa.m paadaan prak.saalya tena ka.tibaddhagaatramaarjanavaasasaa maar.s.tu.m praarabhata|</para>
  <para style="p">
    <verse number="6" style="v"/>tata.h "simonpitarasya samiipamaagate sa uktavaan he prabho bhavaan ki.m mama paadau prak.saalayi.syati?</para>
  <para style="p">
    <verse number="7" style="v"/>yii"suruditavaan aha.m yat karomi tat samprati na jaanaasi kintu pa"scaaj j naasyasi|</para>
  <para style="p">
    <verse number="8" style="v"/>tata.h pitara.h kathitavaan bhavaan kadaapi mama paadau na prak.saalayi.syati| yii"surakathayad yadi tvaa.m na prak.saalaye tarhi mayi tava kopya.m"so naasti|</para>
  <para style="p">
    <verse number="9" style="v"/>tadaa "simonpitara.h kathitavaan he prabho tarhi kevalapaadau na, mama hastau "sira"sca prak.saalayatu|</para>
  <para style="p">
    <verse number="10" style="v"/>tato yii"suravadad yo jano dhautastasya sarvvaa"ngapari.sk.rtatvaat paadau vinaanyaa"ngasya prak.saalanaapek.saa naasti| yuuya.m pari.sk.rtaa iti satya.m kintu na sarvve,</para>
  <para style="p">
    <verse number="11" style="v"/>yato yo janasta.m parakare.su samarpayi.syati ta.m sa j naatavaana; ataeva yuuya.m sarvve na pari.sk.rtaa imaa.m kathaa.m kathitavaan|</para>
  <para style="p">
    <verse number="12" style="v"/>ittha.m yii"suste.saa.m paadaan prak.saalya vastra.m paridhaayaasane samupavi"sya kathitavaan aha.m yu.smaan prati ki.m karmmaakaar.sa.m jaaniitha?</para>
  <para style="p">
    <verse number="13" style="v"/>yuuya.m maa.m guru.m prabhu nca vadatha tat satyameva vadatha yatoha.m saeva bhavaami|</para>
  <para style="p">
    <verse number="14" style="v"/>yadyaha.m prabhu rguru"sca san yu.smaaka.m paadaan prak.saalitavaan tarhi yu.smaakamapi paraspara.m paadaprak.saalanam ucitam|</para>
  <para style="p">
    <verse number="15" style="v"/>aha.m yu.smaan prati yathaa vyavaahara.m yu.smaan tathaa vyavaharttum eka.m panthaana.m dar"sitavaan|</para>
  <para style="p">
    <verse number="16" style="v"/>aha.m yu.smaanatiyathaartha.m vadaami, prabho rdaaso na mahaan prerakaacca prerito na mahaan|</para>
  <para style="p">
    <verse number="17" style="v"/>imaa.m kathaa.m viditvaa yadi tadanusaarata.h karmmaa.ni kurutha tarhi yuuya.m dhanyaa bhavi.syatha|</para>
  <para style="p">
    <verse number="18" style="v"/>sarvve.su yu.smaasu kathaamimaa.m kathayaami iti na, ye mama manoniitaastaanaha.m jaanaami, kintu mama bhak.syaa.ni yo bhu"nkte matpraa.napraatikuulyata.h| utthaapayati paadasya muula.m sa e.sa maanava.h|yadetad dharmmapustakasya vacana.m tadanusaare.naava"sya.m gha.ti.syate|</para>
  <para style="p">
    <verse number="19" style="v"/>aha.m sa jana ityatra yathaa yu.smaaka.m vi"svaaso jaayate tadartha.m etaad.r"sagha.tanaat puurvvam ahamidaanii.m yu.smabhyamakathayam|</para>
  <para style="p">
    <verse number="20" style="v"/>aha.m yu.smaanatiiva yathaartha.m vadaami, mayaa prerita.m jana.m yo g.rhlaati sa maameva g.rhlaati ya"sca maa.m g.rhlaati sa matpreraka.m g.rhlaati|</para>
  <para style="p">
    <verse number="21" style="v"/>etaa.m kathaa.m kathayitvaa yii"su rdu.hkhii san pramaa.na.m dattvaa kathitavaan aha.m yu.smaanatiyathaartha.m vadaami yu.smaakam eko jano maa.m parakare.su samarpayi.syati|</para>
  <para style="p">
    <verse number="22" style="v"/>tata.h sa kamuddi"sya kathaametaa.m kathitavaan ityatra sandigdhaa.h "si.syaa.h paraspara.m mukhamaalokayitu.m praarabhanta|</para>
  <para style="p">
    <verse number="23" style="v"/>tasmin samaye yii"su ryasmin apriiyata sa "si.syastasya vak.sa.hsthalam avaalambata|</para>
  <para style="p">
    <verse number="24" style="v"/>"simonpitarasta.m sa"nketenaavadat, aya.m kamuddi"sya kathaametaam kathayatiiti p.rccha|</para>
  <para style="p">
    <verse number="25" style="v"/>tadaa sa yii"so rvak.sa.hsthalam avalambya p.r.s.thavaan, he prabho sa jana.h ka.h?</para>
  <para style="p">
    <verse number="26" style="v"/>tato yii"su.h pratyavadad ekakha.n.da.m puupa.m majjayitvaa yasmai daasyaami saeva sa.h; pa"scaat puupakha.n.dameka.m majjayitvaa "simona.h putraaya ii.skariyotiiyaaya yihuudai dattavaan|</para>
  <para style="p">
    <verse number="27" style="v"/>tasmin datte sati "saitaan tamaa"srayat; tadaa yii"sustam avadat tva.m yat kari.syasi tat k.sipra.m kuru|</para>
  <para style="p">
    <verse number="28" style="v"/>kintu sa yenaa"sayena taa.m kathaamakathaayat tam upavi.s.talokaanaa.m kopi naabudhyata;</para>
  <para style="p">
    <verse number="29" style="v"/>kintu yihuudaa.h samiipe mudraasampu.takasthite.h kecid ittham abudhyanta paarvva.naasaadanaartha.m kimapi dravya.m kretu.m vaa daridrebhya.h ki ncid vitaritu.m kathitavaan|</para>
  <para style="p">
    <verse number="30" style="v"/>tadaa puupakha.n.dagraha.naat para.m sa tuur.na.m bahiragacchat; raatri"sca samupasyitaa|</para>
  <para style="p">
    <verse number="31" style="v"/>yihuude bahirgate yii"surakathayad idaanii.m maanavasutasya mahimaa prakaa"sate tene"svarasyaapi mahimaa prakaa"sate|</para>
  <para style="p">
    <verse number="32" style="v"/>yadi tene"svarasya mahimaa prakaa"sate tarhii"svaropi svena tasya mahimaana.m prakaa"sayi.syati tuur.nameva prakaa"sayi.syati|</para>
  <para style="p">
    <verse number="33" style="v"/>he vatsaa aha.m yu.smaabhi.h saarddha.m ki ncitkaalamaatram aase, tata.h para.m maa.m m.rgayi.syadhve kintvaha.m yatsthaana.m yaami tatsthaana.m yuuya.m gantu.m na "sak.syatha, yaamimaa.m kathaa.m yihuudiiyebhya.h kathitavaan tathaadhunaa yu.smabhyamapi kathayaami|</para>
  <para style="p">
    <verse number="34" style="v"/>yuuya.m paraspara.m priiyadhvam aha.m yu.smaasu yathaa priiye yuuyamapi parasparam tathaiva priiyadhva.m, yu.smaan imaa.m naviinaam aaj naam aadi"saami|</para>
  <para style="p">
    <verse number="35" style="v"/>tenaiva yadi paraspara.m priiyadhve tarhi lak.sa.nenaanena yuuya.m mama "si.syaa iti sarvve j naatu.m "sak.syanti|</para>
  <para style="p">
    <verse number="36" style="v"/>"simonapitara.h p.r.s.thavaan he prabho bhavaan kutra yaasyati? tato yii"su.h pratyavadat, aha.m yatsthaana.m yaami tatsthaana.m saamprata.m mama pa"scaad gantu.m na "sakno.si kintu pa"scaad gami.syasi|</para>
  <para style="p">
    <verse number="37" style="v"/>tadaa pitara.h pratyuditavaan, he prabho saamprata.m kuto hetostava pa"scaad gantu.m na "saknomi? tvadartha.m praa.naan daatu.m "saknomi|</para>
  <para style="p">
    <verse number="38" style="v"/>tato yii"su.h pratyuktavaan mannimitta.m ki.m praa.naan daatu.m "sakno.si? tvaamaha.m yathaartha.m vadaami, kukku.tarava.naat puurvva.m tva.m tri rmaam apahno.syase|</para>
  <chapter number="14" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>manodu.hkhino maa bhuuta; ii"svare vi"svasita mayi ca vi"svasita|</para>
  <para style="p">
    <verse number="2" style="v"/>mama pitu g.rhe bahuuni vaasasthaani santi no cet puurvva.m yu.smaan aj naapayi.sya.m yu.smadartha.m sthaana.m sajjayitu.m gacchaami|</para>
  <para style="p">
    <verse number="3" style="v"/>yadi gatvaaha.m yu.smannimitta.m sthaana.m sajjayaami tarhi panaraagatya yu.smaan svasamiipa.m ne.syaami, tato yatraaha.m ti.s.thaami tatra yuuyamapi sthaasyatha|</para>
  <para style="p">
    <verse number="4" style="v"/>aha.m yatsthaana.m brajaami tatsthaana.m yuuya.m jaaniitha tasya panthaanamapi jaaniitha|</para>
  <para style="p">
    <verse number="5" style="v"/>tadaa thomaa avadat, he prabho bhavaan kutra yaati tadvaya.m na jaaniima.h, tarhi katha.m panthaana.m j naatu.m "saknuma.h?</para>
  <para style="p">
    <verse number="6" style="v"/>yii"surakathayad ahameva satyajiivanaruupapatho mayaa na gantaa kopi pitu.h samiipa.m gantu.m na "saknoti|</para>
  <para style="p">
    <verse number="7" style="v"/>yadi maam aj naasyata tarhi mama pitaramapyaj naasyata kintvadhunaatasta.m jaaniitha pa"syatha ca|</para>
  <para style="p">
    <verse number="8" style="v"/>tadaa philipa.h kathitavaan, he prabho pitara.m dar"saya tasmaadasmaaka.m yathe.s.ta.m bhavi.syati|</para>
  <para style="p">
    <verse number="9" style="v"/>tato yii"su.h pratyaavaadiit, he philipa yu.smaabhi.h saarddham etaavaddinaani sthitamapi maa.m ki.m na pratyabhijaanaasi? yo jano maam apa"syat sa pitaramapyapa"syat tarhi pitaram asmaan dar"sayeti kathaa.m katha.m kathayasi?</para>
  <para style="p">
    <verse number="10" style="v"/>aha.m pitari ti.s.thaami pitaa mayi ti.s.thatiiti ki.m tva.m na pratya.si? aha.m yadvaakya.m vadaami tat svato na vadaami kintu ya.h pitaa mayi viraajate sa eva sarvvakarmmaa.ni karaati|</para>
  <para style="p">
    <verse number="11" style="v"/>ataeva pitaryyaha.m ti.s.thaami pitaa ca mayi ti.s.thati mamaasyaa.m kathaayaa.m pratyaya.m kuruta, no cet karmmaheto.h pratyaya.m kuruta|</para>
  <para style="p">
    <verse number="12" style="v"/>aha.m yu.smaanatiyathaartha.m vadaami, yo jano mayi vi"svasiti sohamiva karmmaa.ni kari.syati vara.m tatopi mahaakarmmaa.ni kari.syati yato hetoraha.m pitu.h samiipa.m gacchaami|</para>
  <para style="p">
    <verse number="13" style="v"/>yathaa putre.na pitu rmahimaa prakaa"sate tadartha.m mama naama procya yat praarthayi.syadhve tat saphala.m kari.syaami|</para>
  <para style="p">
    <verse number="14" style="v"/>yadi mama naamnaa yat ki ncid yaacadhve tarhi tadaha.m saadhayi.syaami|</para>
  <para style="p">
    <verse number="15" style="v"/>yadi mayi priiyadhve tarhi mamaaj naa.h samaacarata|</para>
  <para style="p">
    <verse number="16" style="v"/>tato mayaa pitu.h samiipe praarthite pitaa nirantara.m yu.smaabhi.h saarddha.m sthaatum itarameka.m sahaayam arthaat satyamayam aatmaana.m yu.smaaka.m nika.ta.m pre.sayi.syati|</para>
  <para style="p">
    <verse number="17" style="v"/>etajjagato lokaasta.m grahiitu.m na "saknuvanti yataste ta.m naapa"syan naajana.m"sca kintu yuuya.m jaaniitha yato heto.h sa yu.smaakamanta rnivasati yu.smaaka.m madhye sthaasyati ca|</para>
  <para style="p">
    <verse number="18" style="v"/>aha.m yu.smaan anaathaan k.rtvaa na yaasyaami punarapi yu.smaaka.m samiipam aagami.syaami|</para>
  <para style="p">
    <verse number="19" style="v"/>kiyatkaalarat param asya jagato lokaa maa.m puna rna drak.syanti kintu yuuya.m drak.syatha;aha.m jiivi.syaami tasmaat kaara.naad yuuyamapi jiivi.syatha|</para>
  <para style="p">
    <verse number="20" style="v"/>pitaryyahamasmi mayi ca yuuya.m stha, tathaaha.m yu.smaasvasmi tadapi tadaa j naasyatha|</para>
  <para style="p">
    <verse number="21" style="v"/>yo jano mamaaj naa g.rhiitvaa taa aacarati saeva mayi priiyate; yo jana"sca mayi priiyate saeva mama pitu.h priyapaatra.m bhavi.syati, tathaahamapi tasmin priitvaa tasmai sva.m prakaa"sayi.syaami|</para>
  <para style="p">
    <verse number="22" style="v"/>tadaa ii.skariyotiiyaad anyo yihuudaastamavadat, he prabho bhavaan jagato lokaanaa.m sannidhau prakaa"sito na bhuutvaasmaaka.m sannidhau kuta.h prakaa"sito bhavi.syati?</para>
  <para style="p">
    <verse number="23" style="v"/>tato yii"su.h pratyuditavaan, yo jano mayi priiyate sa mamaaj naa api g.rhlaati, tena mama pitaapi tasmin pre.syate, aavaa nca tannika.tamaagatya tena saha nivatsyaava.h|</para>
  <para style="p">
    <verse number="24" style="v"/>yo jano mayi na priiyate sa mama kathaa api na g.rhlaati puna"sca yaamimaa.m kathaa.m yuuya.m "s.r.nutha saa kathaa kevalasya mama na kintu mama prerako ya.h pitaa tasyaapi kathaa|</para>
  <para style="p">
    <verse number="25" style="v"/>idaanii.m yu.smaaka.m nika.te vidyamaanoham etaa.h sakalaa.h kathaa.h kathayaami|</para>
  <para style="p">
    <verse number="26" style="v"/>kintvita.h para.m pitraa ya.h sahaayo.arthaat pavitra aatmaa mama naamni prerayi.syati sa sarvva.m "sik.sayitvaa mayoktaa.h samastaa.h kathaa yu.smaan smaarayi.syati|</para>
  <para style="p">
    <verse number="27" style="v"/>aha.m yu.smaaka.m nika.te "saanti.m sthaapayitvaa yaami, nijaa.m "saanti.m yu.smabhya.m dadaami, jagato lokaa yathaa dadaati tathaaha.m na dadaami; yu.smaakam anta.hkara.naani du.hkhitaani bhiitaani ca na bhavantu|</para>
  <para style="p">
    <verse number="28" style="v"/>aha.m gatvaa punarapi yu.smaaka.m samiipam aagami.syaami mayokta.m vaakyamida.m yuuyam a"srau.s.ta; yadi mayyapre.syadhva.m tarhyaha.m pitu.h samiipa.m gacchaami mamaasyaa.m kathaayaa.m yuuyam ahlaadi.syadhva.m yato mama pitaa mattopi mahaan|</para>
  <para style="p">
    <verse number="29" style="v"/>tasyaa gha.tanaayaa.h samaye yathaa yu.smaaka.m "sraddhaa jaayate tadartham aha.m tasyaa gha.tanaayaa.h puurvvam idaanii.m yu.smaan etaa.m vaarttaa.m vadaami|</para>
  <para style="p">
    <verse number="30" style="v"/>ita.h para.m yu.smaabhi.h saha mama bahava aalaapaa na bhavi.syanti yata.h kaara.naad etasya jagata.h patiraagacchati kintu mayaa saha tasya kopi sambandho naasti|</para>
  <para style="p">
    <verse number="31" style="v"/>aha.m pitari prema karomi tathaa pitu rvidhivat karmmaa.ni karomiiti yena jagato lokaa jaananti tadartham utti.s.thata vaya.m sthaanaadasmaad gacchaama|</para>
  <chapter number="15" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>aha.m satyadraak.saalataasvaruupo mama pitaa tuudyaanaparicaarakasvaruupa nca|</para>
  <para style="p">
    <verse number="2" style="v"/>mama yaasu "saakhaasu phalaani na bhavanti taa.h sa chinatti tathaa phalavatya.h "saakhaa yathaadhikaphalaani phalanti tadartha.m taa.h pari.skaroti|</para>
  <para style="p">
    <verse number="3" style="v"/>idaanii.m mayoktopade"sena yuuya.m pari.sk.rtaa.h|</para>
  <para style="p">
    <verse number="4" style="v"/>ata.h kaara.naat mayi ti.s.thata tenaahamapi yu.smaasu ti.s.thaami, yato heto rdraak.saalataayaam asa.mlagnaa "saakhaa yathaa phalavatii bhavitu.m na "saknoti tathaa yuuyamapi mayyati.s.thanta.h phalavanto bhavitu.m na "saknutha|</para>
  <para style="p">
    <verse number="5" style="v"/>aha.m draak.saalataasvaruupo yuuya nca "saakhaasvaruupo.h; yo jano mayi ti.s.thati yatra caaha.m ti.s.thaami, sa pracuuraphalai.h phalavaan bhavati, kintu maa.m vinaa yuuya.m kimapi karttu.m na "saknutha|</para>
  <para style="p">
    <verse number="6" style="v"/>ya.h ka"scin mayi na ti.s.thati sa "su.ska"saakheva bahi rnik.sipyate lokaa"sca taa aah.rtya vahnau nik.sipya daahayanti|</para>
  <para style="p">
    <verse number="7" style="v"/>yadi yuuya.m mayi ti.s.thatha mama kathaa ca yu.smaasu ti.s.thati tarhi yad vaa nchitvaa yaaci.syadhve yu.smaaka.m tadeva saphala.m bhavi.syati|</para>
  <para style="p">
    <verse number="8" style="v"/>yadi yuuya.m pracuuraphalavanto bhavatha tarhi tadvaaraa mama pitu rmahimaa prakaa"si.syate tathaa yuuya.m mama "si.syaa iti parik.saayi.syadhve|</para>
  <para style="p">
    <verse number="9" style="v"/>pitaa yathaa mayi priitavaan ahamapi yu.smaasu tathaa priitavaan ato heto ryuuya.m nirantara.m mama premapaatraa.ni bhuutvaa ti.s.thata|</para>
  <para style="p">
    <verse number="10" style="v"/>aha.m yathaa pituraaj naa g.rhiitvaa tasya premabhaajana.m ti.s.thaami tathaiva yuuyamapi yadi mamaaj naa guhliitha tarhi mama premabhaajanaani sthaasyatha|</para>
  <para style="p">
    <verse number="11" style="v"/>yu.smannimitta.m mama ya aahlaada.h sa yathaa cira.m ti.s.thati yu.smaakam aananda"sca yathaa puuryyate tadartha.m yu.smabhyam etaa.h kathaa atrakatham|</para>
  <para style="p">
    <verse number="12" style="v"/>aha.m yu.smaasu yathaa priiye yuuyamapi paraspara.m tathaa priiyadhvam e.saa mamaaj naa|</para>
  <para style="p">
    <verse number="13" style="v"/>mitraa.naa.m kaara.naat svapraa.nadaanaparyyanta.m yat prema tasmaan mahaaprema kasyaapi naasti|</para>
  <para style="p">
    <verse number="14" style="v"/>aha.m yadyad aadi"saami tattadeva yadi yuuyam aacarata tarhi yuuyameva mama mitraa.ni|</para>
  <para style="p">
    <verse number="15" style="v"/>adyaarabhya yu.smaan daasaan na vadi.syaami yat prabhu ryat karoti daasastad na jaanaati; kintu pitu.h samiipe yadyad a"s.r.nava.m tat sarvva.m yuu.smaan aj naapayam tatkaara.naad yu.smaan mitraa.ni proktavaan|</para>
  <para style="p">
    <verse number="16" style="v"/>yuuya.m maa.m rocitavanta iti na, kintvahameva yu.smaan rocitavaan yuuya.m gatvaa yathaa phalaanyutpaadayatha taani phalaani caak.sayaa.ni bhavanti, tadartha.m yu.smaan nyajunaja.m tasmaan mama naama procya pitara.m yat ki ncid yaaci.syadhve tadeva sa yu.smabhya.m daasyati|</para>
  <para style="p">
    <verse number="17" style="v"/>yuuya.m paraspara.m priiyadhvam aham ityaaj naapayaami|</para>
  <para style="p">
    <verse number="18" style="v"/>jagato lokai ryu.smaasu .rtiiyite.su te puurvva.m maamevaarttiiyanta iti yuuya.m jaaniitha|</para>
  <para style="p">
    <verse number="19" style="v"/>yadi yuuya.m jagato lokaa abhavi.syata tarhi jagato lokaa yu.smaan aatmiiyaan buddhvaapre.syanta; kintu yuuya.m jagato lokaa na bhavatha, aha.m yu.smaan asmaajjagato.arocayam etasmaat kaara.naajjagato lokaa yu.smaan .rtiiyante|</para>
  <para style="p">
    <verse number="20" style="v"/>daasa.h prabho rmahaan na bhavati mamaitat puurvviiya.m vaakya.m smarata; te yadi maamevaataa.dayan tarhi yu.smaanapi taa.dayi.syanti, yadi mama vaakya.m g.rhlanti tarhi yu.smaakamapi vaakya.m grahii.syanti|</para>
  <para style="p">
    <verse number="21" style="v"/>kintu te mama naamakaara.naad yu.smaan prati taad.r"sa.m vyavahari.syanti yato yo maa.m preritavaan ta.m te na jaananti|</para>
  <para style="p">
    <verse number="22" style="v"/>te.saa.m sannidhim aagatya yadyaha.m naakathayi.sya.m tarhi te.saa.m paapa.m naabhavi.syat kintvadhunaa te.saa.m paapamaacchaadayitum upaayo naasti|</para>
  <para style="p">
    <verse number="23" style="v"/>yo jano maam .rtiiyate sa mama pitaramapi .rtiiyate|</para>
  <para style="p">
    <verse number="24" style="v"/>yaad.r"saani karmmaa.ni kenaapi kadaapi naakriyanta taad.r"saani karmmaa.ni yadi te.saa.m saak.saad aha.m naakari.sya.m tarhi te.saa.m paapa.m naabhavi.syat kintvadhunaa te d.r.s.tvaapi maa.m mama pitara ncaarttiiyanta|</para>
  <para style="p">
    <verse number="25" style="v"/>tasmaat te.akaara.na.m maam .rtiiyante yadetad vacana.m te.saa.m "saastre likhitamaaste tat saphalam abhavat|</para>
  <para style="p">
    <verse number="26" style="v"/>kintu pitu rnirgata.m ya.m sahaayamarthaat satyamayam aatmaana.m pitu.h samiipaad yu.smaaka.m samiipe pre.sayi.syaami sa aagatya mayi pramaa.na.m daasyati|</para>
  <para style="p">
    <verse number="27" style="v"/>yuuya.m prathamamaarabhya mayaa saarddha.m ti.s.thatha tasmaaddheto ryuuyamapi pramaa.na.m daasyatha|</para>
  <chapter number="16" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>yu.smaaka.m yathaa vaadhaa na jaayate tadartha.m yu.smaan etaani sarvvavaakyaani vyaahara.m|</para>
  <para style="p">
    <verse number="2" style="v"/>lokaa yu.smaan bhajanag.rhebhyo duuriikari.syanti tathaa yasmin samaye yu.smaan hatvaa ii"svarasya tu.s.ti janaka.m karmmaakurmma iti ma.msyante sa samaya aagacchanti|</para>
  <para style="p">
    <verse number="3" style="v"/>te pitara.m maa nca na jaananti, tasmaad yu.smaan pratiid.r"sam aacari.syanti|</para>
  <para style="p">
    <verse number="4" style="v"/>ato hetaa.h samaye samupasthite yathaa mama kathaa yu.smaaka.m mana.hsu.h samupati.s.thati tadartha.m yu.smaabhyam etaa.m kathaa.m kathayaami yu.smaabhi.h saarddham aha.m ti.s.than prathama.m taa.m yu.smabhya.m naakathaya.m|</para>
  <para style="p">
    <verse number="5" style="v"/>saamprata.m svasya prerayitu.h samiipa.m gacchaami tathaapi tva.m kka gacchasi kathaametaa.m yu.smaaka.m kopi maa.m na p.rcchati|</para>
  <para style="p">
    <verse number="6" style="v"/>kintu mayoktaabhiraabhi.h kathaabhi ryuu.smaakam anta.hkara.naani du.hkhena puur.naanyabhavan|</para>
  <para style="p">
    <verse number="7" style="v"/>tathaapyaha.m yathaartha.m kathayaami mama gamana.m yu.smaaka.m hitaarthameva, yato heto rgamane na k.rte sahaayo yu.smaaka.m samiipa.m naagami.syati kintu yadi gacchaami tarhi yu.smaaka.m samiipe ta.m pre.sayi.syaami|</para>
  <para style="p">
    <verse number="8" style="v"/>tata.h sa aagatya paapapu.nyada.n.de.su jagato lokaanaa.m prabodha.m janayi.syati|</para>
  <para style="p">
    <verse number="9" style="v"/>te mayi na vi"svasanti tasmaaddheto.h paapaprabodha.m janayi.syati|</para>
  <para style="p">
    <verse number="10" style="v"/>yu.smaakam ad.r"sya.h sannaha.m pitu.h samiipa.m gacchaami tasmaad pu.nye prabodha.m janayi.syati|</para>
  <para style="p">
    <verse number="11" style="v"/>etajjagato.adhipati rda.n.daaj naa.m praapnoti tasmaad da.n.de prabodha.m janayi.syati|</para>
  <para style="p">
    <verse number="12" style="v"/>yu.smabhya.m kathayitu.m mamaanekaa.h kathaa aasate, taa.h kathaa idaanii.m yuuya.m so.dhu.m na "saknutha;</para>
  <para style="p">
    <verse number="13" style="v"/>kintu satyamaya aatmaa yadaa samaagami.syati tadaa sarvva.m satya.m yu.smaan ne.syati, sa svata.h kimapi na vadi.syati kintu yacchro.syati tadeva kathayitvaa bhaavikaaryya.m yu.smaan j naapayi.syati|</para>
  <para style="p">
    <verse number="14" style="v"/>mama mahimaana.m prakaa"sayi.syati yato madiiyaa.m kathaa.m g.rhiitvaa yu.smaan bodhayi.syati|</para>
  <para style="p">
    <verse number="15" style="v"/>pitu ryadyad aaste tat sarvva.m mama tasmaad kaara.naad avaadi.sa.m sa madiiyaa.m kathaa.m g.rhiitvaa yu.smaan bodhayi.syati|</para>
  <para style="p">
    <verse number="16" style="v"/>kiyatkaalaat para.m yuuya.m maa.m dra.s.tu.m na lapsyadhve kintu kiyatkaalaat para.m puna rdra.s.tu.m lapsyadhve yatoha.m pitu.h samiipa.m gacchaami|</para>
  <para style="p">
    <verse number="17" style="v"/>tata.h "si.syaa.naa.m kiyanto janaa.h paraspara.m vaditum aarabhanta, kiyatkaalaat para.m maa.m dra.s.tu.m na lapsyadhve kintu kiyatkaalaat para.m puna rdra.s.tu.m lapsyadhve yatoha.m pitu.h samiipa.m gacchaami, iti yad vaakyam aya.m vadati tat ki.m?</para>
  <para style="p">
    <verse number="18" style="v"/>tata.h kiyatkaalaat param iti tasya vaakya.m ki.m? tasya vaakyasyaabhipraaya.m vaya.m boddhu.m na "saknumastairiti</para>
  <para style="p">
    <verse number="19" style="v"/>nigadite yii"suste.saa.m pra"snecchaa.m j naatvaa tebhyo.akathayat kiyatkaalaat para.m maa.m dra.s.tu.m na lapsyadhve, kintu kiyatkaalaat para.m puuna rdra.s.tu.m lapsyadhve, yaamimaa.m kathaamakathaya.m tasyaa abhipraaya.m ki.m yuuya.m paraspara.m m.rgayadhve?</para>
  <para style="p">
    <verse number="20" style="v"/>yu.smaanaham atiyathaartha.m vadaami yuuya.m krandi.syatha vilapi.syatha ca, kintu jagato lokaa aanandi.syanti; yuuya.m "sokaakulaa bhavi.syatha kintu "sokaat para.m aanandayuktaa bhavi.syatha|</para>
  <para style="p">
    <verse number="21" style="v"/>prasavakaala upasthite naarii yathaa prasavavedanayaa vyaakulaa bhavati kintu putre bhuumi.s.the sati manu.syaiko janmanaa naraloke pravi.s.ta ityaanandaat tasyaastatsarvva.m du.hkha.m manasi na ti.s.thati,</para>
  <para style="p">
    <verse number="22" style="v"/>tathaa yuuyamapi saamprata.m "sokaakulaa bhavatha kintu punarapi yu.smabhya.m dar"sana.m daasyaami tena yu.smaakam anta.hkara.naani saanandaani bhavi.syanti, yu.smaaka.m tam aananda nca kopi harttu.m na "sak.syati|</para>
  <para style="p">
    <verse number="23" style="v"/>tasmin divase kaamapi kathaa.m maa.m na prak.syatha| yu.smaanaham atiyathaartha.m vadaami, mama naamnaa yat ki ncid pitara.m yaaci.syadhve tadeva sa daasyati|</para>
  <para style="p">
    <verse number="24" style="v"/>puurvve mama naamnaa kimapi naayaacadhva.m, yaacadhva.m tata.h praapsyatha tasmaad yu.smaaka.m sampuur.naanando jani.syate|</para>
  <para style="p">
    <verse number="25" style="v"/>upamaakathaabhi.h sarvvaa.nyetaani yu.smaan j naapitavaan kintu yasmin samaye upamayaa noktvaa pitu.h kathaa.m spa.s.ta.m j naapayi.syaami samaya etaad.r"sa aagacchati|</para>
  <para style="p">
    <verse number="26" style="v"/>tadaa mama naamnaa praarthayi.syadhve .aha.m yu.smannimitta.m pitara.m vine.sye kathaamimaa.m na vadaami;</para>
  <para style="p">
    <verse number="27" style="v"/>yato yuuya.m mayi prema kurutha, tathaaham ii"svarasya samiipaad aagatavaan ityapi pratiitha, tasmaad kaara.naat kaara.naat pitaa svaya.m yu.smaasu priiyate|</para>
  <para style="p">
    <verse number="28" style="v"/>pitu.h samiipaajjajad aagatosmi jagat parityajya ca punarapi pitu.h samiipa.m gacchaami|</para>
  <para style="p">
    <verse number="29" style="v"/>tadaa "si.syaa avadan, he prabho bhavaan upamayaa noktvaadhunaa spa.s.ta.m vadati|</para>
  <para style="p">
    <verse number="30" style="v"/>bhavaan sarvvaj na.h kenacit p.r.s.to bhavitumapi bhavata.h prayojana.m naastiityadhunaasmaaka.m sthiraj naana.m jaata.m tasmaad bhavaan ii"svarasya samiipaad aagatavaan ityatra vaya.m vi"svasima.h|</para>
  <para style="p">
    <verse number="31" style="v"/>tato yii"su.h pratyavaadiid idaanii.m ki.m yuuya.m vi"svasitha?</para>
  <para style="p">
    <verse number="32" style="v"/>pa"syata sarvve yuuya.m vikiir.naa.h santo maam ekaakina.m piiratyajya sva.m sva.m sthaana.m gami.syatha, etaad.r"sa.h samaya aagacchati vara.m praaye.nopasthitavaan; tathaapyaha.m naikaakii bhavaami yata.h pitaa mayaa saarddham aaste|</para>
  <para style="p">
    <verse number="33" style="v"/>yathaa mayaa yu.smaaka.m "saanti rjaayate tadartham etaa.h kathaa yu.smabhyam acakatha.m; asmin jagati yu.smaaka.m kle"so gha.ti.syate kintvak.sobhaa bhavata yato mayaa jagajjita.m|</para>
  <chapter number="17" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>tata.h para.m yii"suretaa.h kathaa.h kathayitvaa svarga.m vilokyaitat praarthayat, he pita.h samaya upasthitavaan; yathaa tava putrastava mahimaana.m prakaa"sayati tadartha.m tva.m nijaputrasya mahimaana.m prakaa"saya|</para>
  <para style="p">
    <verse number="2" style="v"/>tva.m yollokaan tasya haste samarpitavaan sa yathaa tebhyo.anantaayu rdadaati tadartha.m tva.m praa.nimaatraa.naam adhipatitvabhaara.m tasmai dattavaan|</para>
  <para style="p">
    <verse number="3" style="v"/>yastvam advitiiya.h satya ii"svarastvayaa prerita"sca yii"su.h khrii.s.ta etayorubhayo.h paricaye praapte.anantaayu rbhavati|</para>
  <para style="p">
    <verse number="4" style="v"/>tva.m yasya karmma.no bhaara.m mahya.m dattavaan, tat sampanna.m k.rtvaa jagatyasmin tava mahimaana.m praakaa"saya.m|</para>
  <para style="p">
    <verse number="5" style="v"/>ataeva he pita rjagatyavidyamaane tvayaa saha ti.s.thato mama yo mahimaasiit samprati tava samiipe maa.m ta.m mahimaana.m praapaya|</para>
  <para style="p">
    <verse number="6" style="v"/>anyacca tvam etajjagato yaallokaan mahyam adadaa aha.m tebhyastava naamnastattvaj naanam adadaa.m, te tavaivaasan, tva.m taan mahyamadadaa.h, tasmaatte tavopade"sam ag.rhlan|</para>
  <para style="p">
    <verse number="7" style="v"/>tva.m mahya.m yat ki ncid adadaastatsarvva.m tvatto jaayate ityadhunaajaanan|</para>
  <para style="p">
    <verse number="8" style="v"/>mahya.m yamupade"sam adadaa ahamapi tebhyastamupade"sam adadaa.m tepi tamag.rhlan tvattoha.m nirgatya tvayaa preritobhavam atra ca vya"svasan|</para>
  <para style="p">
    <verse number="9" style="v"/>te.saameva nimitta.m praarthaye.aha.m jagato lokanimitta.m na praarthaye kintu yaallokaan mahyam adadaaste.saameva nimitta.m praarthaye.aha.m yataste tavaivaasate|</para>
  <para style="p">
    <verse number="10" style="v"/>ye mama te tava ye ca tava te mama tathaa tai rmama mahimaa prakaa"syate|</para>
  <para style="p">
    <verse number="11" style="v"/>saampratam asmin jagati mamaavasthite.h "se.sam abhavat aha.m tava samiipa.m gacchaami kintu te jagati sthaasyanti; he pavitra pitaraavayo ryathaikatvamaaste tathaa te.saamapyekatva.m bhavati tadartha.m yaallokaan mahyam adadaastaan svanaamnaa rak.sa|</para>
  <para style="p">
    <verse number="12" style="v"/>yaavanti dinaani jagatyasmin tai.h sahaahamaasa.m taavanti dinaani taan tava naamnaaha.m rak.sitavaan; yaallokaan mahyam adadaastaan sarvvaan ahamarak.sa.m, te.saa.m madhye kevala.m vinaa"sapaatra.m haarita.m tena dharmmapustakasya vacana.m pratyak.sa.m bhavati|</para>
  <para style="p">
    <verse number="13" style="v"/>kintvadhunaa tava sannidhi.m gacchaami mayaa yathaa te.saa.m sampuur.naanando bhavati tadarthamaha.m jagati ti.s.than etaa.h kathaa akathayam|</para>
  <para style="p">
    <verse number="14" style="v"/>tavopade"sa.m tebhyo.adadaa.m jagataa saha yathaa mama sambandho naasti tathaa jajataa saha te.saamapi sambandhaabhaavaaj jagato lokaastaan .rtiiyante|</para>
  <para style="p">
    <verse number="15" style="v"/>tva.m jagatastaan g.rhaa.neti na praarthaye kintva"subhaad rak.seti praarthayeham|</para>
  <para style="p">
    <verse number="16" style="v"/>aha.m yathaa jagatsambandhiiyo na bhavaami tathaa tepi jagatsambandhiiyaa na bhavanti|</para>
  <para style="p">
    <verse number="17" style="v"/>tava satyakathayaa taan pavitriikuru tava vaakyameva satya.m|</para>
  <para style="p">
    <verse number="18" style="v"/>tva.m yathaa maa.m jagati prairayastathaahamapi taan jagati prairaya.m|</para>
  <para style="p">
    <verse number="19" style="v"/>te.saa.m hitaartha.m yathaaha.m sva.m pavitriikaromi tathaa satyakathayaa tepi pavitriibhavantu|</para>
  <para style="p">
    <verse number="20" style="v"/>kevala.m ete.saamarthe praarthaye.aham iti na kintvete.saamupade"sena ye janaa mayi vi"svasi.syanti te.saamapyarthe praartheye.aham|</para>
  <para style="p">
    <verse number="21" style="v"/>he pitaste.saa.m sarvve.saam ekatva.m bhavatu tava yathaa mayi mama ca yathaa tvayyekatva.m tathaa te.saamapyaavayorekatva.m bhavatu tena tva.m maa.m preritavaan iti jagato lokaa.h pratiyantu|</para>
  <para style="p">
    <verse number="22" style="v"/>yathaavayorekatva.m tathaa te.saamapyekatva.m bhavatu te.svaha.m mayi ca tvam ittha.m te.saa.m sampuur.namekatva.m bhavatu, tva.m preritavaan tva.m mayi yathaa priiyase ca tathaa te.svapi priitavaan etadyathaa jagato lokaa jaananti</para>
  <para style="p">
    <verse number="23" style="v"/>tadartha.m tva.m ya.m mahimaana.m mahyam adadaasta.m mahimaanam ahamapi tebhyo dattavaan|</para>
  <para style="p">
    <verse number="24" style="v"/>he pita rjagato nirmmaa.naat puurvva.m mayi sneha.m k.rtvaa ya.m mahimaana.m dattavaan mama ta.m mahimaana.m yathaa te pa"syanti tadartha.m yaallokaan mahya.m dattavaan aha.m yatra ti.s.thaami tepi yathaa tatra ti.s.thanti mamai.saa vaa nchaa|</para>
  <para style="p">
    <verse number="25" style="v"/>he yathaarthika pita rjagato lokaistvayyaj naatepi tvaamaha.m jaane tva.m maa.m preritavaan itiime "si.syaa jaananti|</para>
  <para style="p">
    <verse number="26" style="v"/>yathaaha.m te.su ti.s.thaami tathaa mayi yena premnaa premaakarostat te.su ti.s.thati tadartha.m tava naamaaha.m taan j naapitavaan punarapi j naapayi.syaami|</para>
  <chapter number="18" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>taa.h kathaa.h kathayitvaa yii"su.h "si.syaanaadaaya kidronnaamaka.m srota uttiiryya "si.syai.h saha tatratyodyaana.m praavi"sat|</para>
  <para style="p">
    <verse number="2" style="v"/>kintu vi"svaasaghaatiyihuudaastat sthaana.m pariciiyate yato yii"su.h "si.syai.h saarddha.m kadaacit tat sthaanam agacchat|</para>
  <para style="p">
    <verse number="3" style="v"/>tadaa sa yihuudaa.h sainyaga.na.m pradhaanayaajakaanaa.m phiruu"sinaa nca padaatiga.na nca g.rhiitvaa pradiipaan ulkaan astraa.ni caadaaya tasmin sthaana upasthitavaan|</para>
  <para style="p">
    <verse number="4" style="v"/>sva.m prati yad gha.ti.syate taj j naatvaa yii"suragresara.h san taanap.rcchat ka.m gave.sayatha?</para>
  <para style="p">
    <verse number="5" style="v"/>te pratyavadan, naasaratiiya.m yii"su.m; tato yii"suravaadiid ahameva sa.h; tai.h saha vi"svaasaghaatii yihuudaa"scaati.s.that|</para>
  <para style="p">
    <verse number="6" style="v"/>tadaahameva sa tasyaitaa.m kathaa.m "srutvaiva te pa"scaadetya bhuumau patitaa.h|</para>
  <para style="p">
    <verse number="7" style="v"/>tato yii"su.h punarapi p.r.s.thavaan ka.m gave.sayatha? tataste pratyavadan naasaratiiya.m yii"su.m|</para>
  <para style="p">
    <verse number="8" style="v"/>tadaa yii"su.h pratyuditavaan ahameva sa imaa.m kathaamacakatham; yadi maamanvicchatha tarhiimaan gantu.m maa vaarayata|</para>
  <para style="p">
    <verse number="9" style="v"/>ittha.m bhuute mahya.m yaallokaan adadaaste.saam ekamapi naahaarayam imaa.m yaa.m kathaa.m sa svayamakathayat saa kathaa saphalaa jaataa|</para>
  <para style="p">
    <verse number="10" style="v"/>tadaa "simonpitarasya nika.te kha"ngalsthite.h sa ta.m ni.sko.sa.m k.rtvaa mahaayaajakasya maalkhanaamaana.m daasam aahatya tasya dak.si.nakar.na.m chinnavaan|</para>
  <para style="p">
    <verse number="11" style="v"/>tato yii"su.h pitaram avadat, kha"nga.m ko.se sthaapaya mama pitaa mahya.m paatu.m ya.m ka.msam adadaat tenaaha.m ki.m na paasyaami?</para>
  <para style="p">
    <verse number="12" style="v"/>tadaa sainyaga.na.h senaapati ryihuudiiyaanaa.m padaataya"sca yii"su.m gh.rtvaa baddhvaa haanannaamna.h kiyaphaa.h "sva"surasya samiipa.m prathamam anayan|</para>
  <para style="p">
    <verse number="13" style="v"/>sa kiyaphaastasmin vatsare mahaayaajatvapade niyukta.h</para>
  <para style="p">
    <verse number="14" style="v"/>san saadhaara.nalokaanaa.m ma"ngalaartham ekajanasya mara.namucitam iti yihuudiiyai.h saarddham amantrayat|</para>
  <para style="p">
    <verse number="15" style="v"/>tadaa "simonpitaro.anyaika"si.sya"sca yii"so.h pa"scaad agacchataa.m tasyaanya"si.syasya mahaayaajakena paricitatvaat sa yii"sunaa saha mahaayaajakasyaa.t.taalikaa.m praavi"sat|</para>
  <para style="p">
    <verse number="16" style="v"/>kintu pitaro bahirdvaarasya samiipe.ati.s.thad ataeva mahaayaajakena paricita.h sa "si.sya.h punarbahirgatvaa dauvaayikaayai kathayitvaa pitaram abhyantaram aanayat|</para>
  <para style="p">
    <verse number="17" style="v"/>tadaa sa dvaararak.sikaa pitaram avadat tva.m ki.m na tasya maanavasya "si.sya.h? tata.h sovadad aha.m na bhavaami|</para>
  <para style="p">
    <verse number="18" style="v"/>tata.h para.m yatsthaane daasaa.h padaataya"sca "siitahetora"ngaarai rvahni.m prajvaalya taapa.m sevitavantastatsthaane pitarasti.s.than tai.h saha vahnitaapa.m sevitum aarabhata|</para>
  <para style="p">
    <verse number="19" style="v"/>tadaa "si.sye.suupade"se ca mahaayaajakena yii"su.h p.r.s.ta.h</para>
  <para style="p">
    <verse number="20" style="v"/>san pratyuktavaan sarvvalokaanaa.m samak.sa.m kathaamakathaya.m gupta.m kaamapi kathaa.m na kathayitvaa yat sthaana.m yihuudiiyaa.h satata.m gacchanti tatra bhajanagehe mandire caa"sik.saya.m|</para>
  <para style="p">
    <verse number="21" style="v"/>matta.h kuta.h p.rcchasi? ye janaa madupade"sam a"s.r.nvan taaneva p.rccha yadyad avada.m te tat jaaninta|</para>
  <para style="p">
    <verse number="22" style="v"/>tadettha.m pratyuditatvaat nika.tasthapadaati ryii"su.m cape.tenaahatya vyaaharat mahaayaajakam eva.m prativadasi?</para>
  <para style="p">
    <verse number="23" style="v"/>tato yii"su.h pratigaditavaan yadyayathaartham acakatha.m tarhi tasyaayathaarthasya pramaa.na.m dehi, kintu yadi yathaartha.m tarhi kuto heto rmaam ataa.daya.h?</para>
  <para style="p">
    <verse number="24" style="v"/>puurvva.m haanan sabandhana.m ta.m kiyaphaamahaayaajakasya samiipa.m prai.sayat|</para>
  <para style="p">
    <verse number="25" style="v"/>"simonpitarasti.s.than vahnitaapa.m sevate, etasmin samaye kiyantastam ap.rcchan tva.m kim etasya janasya "si.syo na? tata.h sopahnutyaabraviid aha.m na bhavaami|</para>
  <para style="p">
    <verse number="26" style="v"/>tadaa mahaayaajakasya yasya daasasya pitara.h kar.namacchinat tasya ku.tumba.h pratyuditavaan udyaane tena saha ti.s.thanta.m tvaa.m ki.m naapa"sya.m?</para>
  <para style="p">
    <verse number="27" style="v"/>kintu pitara.h punarapahnutya kathitavaan; tadaanii.m kukku.to.araut|</para>
  <para style="p">
    <verse number="28" style="v"/>tadanantara.m pratyuu.se te kiyaphaag.rhaad adhipate rg.rha.m yii"sum anayan kintu yasmin a"sucitve jaate tai rnistaarotsave na bhoktavya.m, tasya bhayaad yihuudiiyaastadg.rha.m naavi"san|</para>
  <para style="p">
    <verse number="29" style="v"/>apara.m piilaato bahiraagatya taan p.r.s.thavaan etasya manu.syasya ka.m do.sa.m vadatha?</para>
  <para style="p">
    <verse number="30" style="v"/>tadaa te petyavadan du.skarmmakaari.ni na sati bhavata.h samiipe naina.m samaarpayi.syaama.h|</para>
  <para style="p">
    <verse number="31" style="v"/>tata.h piilaato.avadad yuuyamena.m g.rhiitvaa sve.saa.m vyavasthayaa vicaarayata| tadaa yihuudiiyaa.h pratyavadan kasyaapi manu.syasya praa.nada.n.da.m karttu.m naasmaakam adhikaaro.asti|</para>
  <para style="p">
    <verse number="32" style="v"/>eva.m sati yii"su.h svasya m.rtyau yaa.m kathaa.m kathitavaan saa saphalaabhavat|</para>
  <para style="p">
    <verse number="33" style="v"/>tadanantara.m piilaata.h punarapi tad raajag.rha.m gatvaa yii"sumaahuuya p.r.s.tavaan tva.m ki.m yihuudiiyaanaa.m raajaa?</para>
  <para style="p">
    <verse number="34" style="v"/>yii"su.h pratyavadat tvam etaa.m kathaa.m svata.h kathayasi kimanya.h ka"scin mayi kathitavaan?</para>
  <para style="p">
    <verse number="35" style="v"/>piilaato.avadad aha.m ki.m yihuudiiya.h? tava svade"siiyaa vi"se.sata.h pradhaanayaajakaa mama nika.te tvaa.m samaarpayana, tva.m ki.m k.rtavaan?</para>
  <para style="p">
    <verse number="36" style="v"/>yii"su.h pratyavadat mama raajyam etajjagatsambandhiiya.m na bhavati yadi mama raajya.m jagatsambandhiiyam abhavi.syat tarhi yihuudiiyaanaa.m haste.su yathaa samarpito naabhava.m tadartha.m mama sevakaa ayotsyan kintu mama raajyam aihika.m na|</para>
  <para style="p">
    <verse number="37" style="v"/>tadaa piilaata.h kathitavaan, tarhi tva.m raajaa bhavasi? yii"su.h pratyuktavaan tva.m satya.m kathayasi, raajaaha.m bhavaami; satyataayaa.m saak.sya.m daatu.m jani.m g.rhiitvaa jagatyasmin avatiir.navaan, tasmaat satyadharmmapak.sapaatino mama kathaa.m "s.r.nvanti|</para>
  <para style="p">
    <verse number="38" style="v"/>tadaa satya.m ki.m? etaa.m kathaa.m pa.s.tvaa piilaata.h punarapi bahirgatvaa yihuudiiyaan abhaa.sata, aha.m tasya kamapyaparaadha.m na praapnomi|</para>
  <para style="p">
    <verse number="39" style="v"/>nistaarotsavasamaye yu.smaabhirabhirucita eko jano mayaa mocayitavya e.saa yu.smaaka.m riitirasti, ataeva yu.smaaka.m nika.te yihuudiiyaanaa.m raajaana.m ki.m mocayaami, yu.smaakam icchaa kaa?</para>
  <para style="p">
    <verse number="40" style="v"/>tadaa te sarvve ruvanto vyaaharan ena.m maanu.sa.m nahi barabbaa.m mocaya| kintu sa barabbaa dasyuraasiit|</para>
  <chapter number="19" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>piilaato yii"sum aaniiya ka"sayaa praahaarayat|</para>
  <para style="p">
    <verse number="2" style="v"/>pa"scaat senaaga.na.h ka.n.takanirmmita.m muku.ta.m tasya mastake samarpya vaarttaakiivar.na.m raajaparicchada.m paridhaapya,</para>
  <para style="p">
    <verse number="3" style="v"/>he yihuudiiyaanaa.m raajan namaskaara ityuktvaa ta.m cape.tenaahantum aarabhata|</para>
  <para style="p">
    <verse number="4" style="v"/>tadaa piilaata.h punarapi bahirgatvaa lokaan avadat, asya kamapyaparaadha.m na labhe.aha.m, pa"syata tad yu.smaan j naapayitu.m yu.smaaka.m sannidhau bahirenam aanayaami|</para>
  <para style="p">
    <verse number="5" style="v"/>tata.h para.m yii"su.h ka.n.takamuku.tavaan vaarttaakiivar.navasanavaa.m"sca bahiraagacchat| tata.h piilaata uktavaan ena.m manu.sya.m pa"syata|</para>
  <para style="p">
    <verse number="6" style="v"/>tadaa pradhaanayaajakaa.h padaataya"sca ta.m d.r.s.tvaa, ena.m kru"se vidha, ena.m kru"se vidha, ityuktvaa ravitu.m aarabhanta| tata.h piilaata.h kathitavaan yuuya.m svayam ena.m niitvaa kru"se vidhata, aham etasya kamapyaparaadha.m na praaptavaan|</para>
  <para style="p">
    <verse number="7" style="v"/>yihuudiiyaa.h pratyavadan asmaaka.m yaa vyavasthaaste tadanusaare.naasya praa.nahananam ucita.m yatoya.m svam ii"svarasya putramavadat|</para>
  <para style="p">
    <verse number="8" style="v"/>piilaata imaa.m kathaa.m "srutvaa mahaatraasayukta.h</para>
  <para style="p">
    <verse number="9" style="v"/>san punarapi raajag.rha aagatya yii"su.m p.r.s.tavaan tva.m kutratyo loka.h? kintu yii"sastasya kimapi pratyuttara.m naavadat|</para>
  <para style="p">
    <verse number="10" style="v"/>1# tata.h piilaat kathitavaana tva.m ki.m mayaa saarddha.m na sa.mlapi.syasi ? tvaa.m kru"se vedhitu.m vaa mocayitu.m "sakti rmamaaste iti ki.m tva.m na jaanaasi ? tadaa yii"su.h pratyavadad ii"svare.naadaŸा.m mamopari tava kimapyadhipatitva.m na vidyate, tathaapi yo jano maa.m tava haste samaarpayat tasya mahaapaataka.m jaatam|</para>
  <para style="p">
    <verse number="11" style="v"/>tadaa yii"su.h pratyavadad ii"svare.naadatta.m mamopari tava kimapyadhipatitva.m na vidyate, tathaapi yo jano maa.m tava haste samaarpayat tasya mahaapaataka.m jaatam|</para>
  <para style="p">
    <verse number="12" style="v"/>tadaarabhya piilaatasta.m mocayitu.m ce.s.titavaan kintu yihuudiiyaa ruvanto vyaaharan yadiima.m maanava.m tyajasi tarhi tva.m kaisarasya mitra.m na bhavasi, yo jana.h sva.m raajaana.m vakti saeva kaimarasya viruddhaa.m kathaa.m kathayati|</para>
  <para style="p">
    <verse number="13" style="v"/>etaa.m kathaa.m "srutvaa piilaato yii"su.m bahiraaniiya nistaarotsavasya aasaadanadinasya dvitiiyapraharaat puurvva.m prastarabandhananaamni sthaane .arthaat ibriiyabhaa.sayaa yad gabbithaa kathyate tasmin sthaane vicaaraasana upaavi"sat|</para>
  <para style="p">
    <verse number="14" style="v"/>anantara.m piilaato yihuudiiyaan avadat, yu.smaaka.m raajaana.m pa"syata|</para>
  <para style="p">
    <verse number="15" style="v"/>kintu ena.m duuriikuru, ena.m duuriikuru, ena.m kru"se vidha, iti kathaa.m kathayitvaa te ravitum aarabhanta; tadaa piilaata.h kathitavaan yu.smaaka.m raajaana.m ki.m kru"se vedhi.syaami? pradhaanayaajakaa uttaram avadan kaisara.m vinaa kopi raajaasmaaka.m naasti|</para>
  <para style="p">
    <verse number="16" style="v"/>tata.h piilaato yii"su.m kru"se vedhitu.m te.saa.m haste.su samaarpayat, tataste ta.m dh.rtvaa niitavanta.h|</para>
  <para style="p">
    <verse number="17" style="v"/>tata.h para.m yii"su.h kru"sa.m vahan "sira.hkapaalam arthaad yad ibriiyabhaa.sayaa gulgaltaa.m vadanti tasmin sthaana upasthita.h|</para>
  <para style="p">
    <verse number="18" style="v"/>tataste madhyasthaane ta.m tasyobhayapaar"sve dvaavaparau kru"se.avidhan|</para>
  <para style="p">
    <verse number="19" style="v"/>aparam e.sa yihuudiiyaanaa.m raajaa naasaratiiyayii"su.h, iti vij naapana.m likhitvaa piilaatastasya kru"sopari samayojayat|</para>
  <para style="p">
    <verse number="20" style="v"/>saa lipi.h ibriiyayuunaaniiyaromiiyabhaa.saabhi rlikhitaa; yii"so.h kru"savedhanasthaana.m nagarasya samiipa.m, tasmaad bahavo yihuudiiyaastaa.m pa.thitum aarabhanta|</para>
  <para style="p">
    <verse number="21" style="v"/>yihuudiiyaanaa.m pradhaanayaajakaa.h piilaatamiti nyavedayan yihuudiiyaanaa.m raajeti vaakya.m na kintu e.sa sva.m yihuudiiyaanaa.m raajaanam avadad ittha.m likhatu|</para>
  <para style="p">
    <verse number="22" style="v"/>tata.h piilaata uttara.m dattavaan yallekhaniiya.m tallikhitavaan|</para>
  <para style="p">
    <verse number="23" style="v"/>ittha.m senaaga.no yii"su.m kru"se vidhitvaa tasya paridheyavastra.m caturo bhaagaan k.rtvaa ekaikasenaa ekaikabhaagam ag.rhlat tasyottariiyavastra ncaag.rhlat| kintuuttariiyavastra.m suucisevana.m vinaa sarvvam uuta.m|</para>
  <para style="p">
    <verse number="24" style="v"/>tasmaatte vyaaharan etat ka.h praapsyati? tanna kha.n.dayitvaa tatra gu.tikaapaata.m karavaama| vibhajante.adhariiya.m me vasana.m te paraspara.m| mamottariiyavastraartha.m gu.tikaa.m paatayanti ca| iti yadvaakya.m dharmmapustake likhitamaaste tat senaaga.nenettha.m vyavahara.naat siddhamabhavat|</para>
  <para style="p">
    <verse number="25" style="v"/>tadaanii.m yii"so rmaataa maatu rbhaginii ca yaa kliyapaa bhaaryyaa mariyam magdaliinii mariyam ca etaastasya kru"sasya sannidhau samati.s.than|</para>
  <para style="p">
    <verse number="26" style="v"/>tato yii"su.h svamaatara.m priyatama"si.sya nca samiipe da.n.daayamaanau vilokya maataram avadat, he yo.sid ena.m tava putra.m pa"sya,</para>
  <para style="p">
    <verse number="27" style="v"/>"si.syantvavadat, enaa.m tava maatara.m pa"sya| tata.h sa "si.syastadgha.tikaayaa.m taa.m nijag.rha.m niitavaan|</para>
  <para style="p">
    <verse number="28" style="v"/>anantara.m sarvva.m karmmaadhunaa sampannamabhuut yii"suriti j naatvaa dharmmapustakasya vacana.m yathaa siddha.m bhavati tadartham akathayat mama pipaasaa jaataa|</para>
  <para style="p">
    <verse number="29" style="v"/>tatastasmin sthaane amlarasena puur.napaatrasthityaa te spa njameka.m tadamlarasenaardriik.rtya esobnale tad yojayitvaa tasya mukhasya sannidhaavasthaapayan|</para>
  <para style="p">
    <verse number="30" style="v"/>tadaa yii"suramlarasa.m g.rhiitvaa sarvva.m siddham iti kathaa.m kathayitvaa mastaka.m namayan praa.naan paryyatyajat|</para>
  <para style="p">
    <verse number="31" style="v"/>tadvinam aasaadanadina.m tasmaat pare.ahani vi"sraamavaare dehaa yathaa kru"sopari na ti.s.thanti, yata.h sa vi"sraamavaaro mahaadinamaasiit, tasmaad yihuudiiyaa.h piilaatanika.ta.m gatvaa te.saa.m paadabha njanasya sthaanaantaranayanasya caanumati.m praarthayanta|</para>
  <para style="p">
    <verse number="32" style="v"/>ata.h senaa aagatya yii"sunaa saha kru"se hatayo.h prathamadvitiiyacorayo.h paadaan abha njan;</para>
  <para style="p">
    <verse number="33" style="v"/>kintu yii"so.h sannidhi.m gatvaa sa m.rta iti d.r.s.tvaa tasya paadau naabha njan|</para>
  <para style="p">
    <verse number="34" style="v"/>pa"scaad eko yoddhaa "suulaaghaatena tasya kuk.sim avidhat tatk.sa.naat tasmaad rakta.m jala nca niragacchat|</para>
  <para style="p">
    <verse number="35" style="v"/>yo jano.asya saak.sya.m dadaati sa svaya.m d.r.s.tavaan tasyeda.m saak.sya.m satya.m tasya kathaa yu.smaaka.m vi"svaasa.m janayitu.m yogyaa tat sa jaanaati|</para>
  <para style="p">
    <verse number="36" style="v"/>tasyaikam asdhyapi na bha.mk.syate,</para>
  <para style="p">
    <verse number="37" style="v"/>tadvad anya"saastrepi likhyate, yathaa, "d.r.s.tipaata.m kari.syanti te.avidhan yantu tamprati|"</para>
  <para style="p">
    <verse number="38" style="v"/>arimathiiyanagarasya yuu.saphnaamaa "si.sya eka aasiit kintu yihuudiiyebhyo bhayaat prakaa"sito na bhavati; sa yii"so rdeha.m netu.m piilaatasyaanumati.m praarthayata, tata.h piilaatenaanumate sati sa gatvaa yii"so rdeham anayat|</para>
  <para style="p">
    <verse number="39" style="v"/>apara.m yo nikadiimo raatrau yii"so.h samiipam agacchat sopi gandharasena mi"srita.m praaye.na pa ncaa"satse.takamaguru.m g.rhiitvaagacchat|</para>
  <para style="p">
    <verse number="40" style="v"/>tataste yihuudiiyaanaa.m "sma"saane sthaapanariityanusaare.na tatsugandhidravye.na sahita.m tasya deha.m vastre.naave.s.tayan|</para>
  <para style="p">
    <verse number="41" style="v"/>apara nca yatra sthaane ta.m kru"se.avidhan tasya nika.tasthodyaane yatra kimapi m.rtadeha.m kadaapi naasthaapyata taad.r"sam eka.m nuutana.m "sma"saanam aasiit|</para>
  <para style="p">
    <verse number="42" style="v"/>yihuudiiyaanaam aasaadanadinaagamanaat te tasmin samiipastha"sma"saane yii"sum a"saayayan|</para>
  <chapter number="20" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>anantara.m saptaahasya prathamadine .atipratyuu.se .andhakaare ti.s.thati magdaliinii mariyam tasya "sma"saanasya nika.ta.m gatvaa "sma"saanasya mukhaat prastaramapasaaritam apa"syat|</para>
  <para style="p">
    <verse number="2" style="v"/>pa"scaad dhaavitvaa "simonpitaraaya yii"so.h priyatama"si.syaaya cedam akathayat, lokaa.h "sma"saanaat prabhu.m niitvaa kutraasthaapayan tad vaktu.m na "saknomi|</para>
  <para style="p">
    <verse number="3" style="v"/>ata.h pitara.h sonya"si.sya"sca barhi rbhutvaa "sma"saanasthaana.m gantum aarabhetaa.m|</para>
  <para style="p">
    <verse number="4" style="v"/>ubhayordhaavato.h sonya"si.sya.h pitara.m pa"scaat tyaktvaa puurvva.m "sma"saanasthaana upasthitavaan|</para>
  <para style="p">
    <verse number="5" style="v"/>tadaa prahviibhuuya sthaapitavastraa.ni d.r.s.tavaan kintu na praavi"sat|</para>
  <para style="p">
    <verse number="6" style="v"/>apara.m "simonpitara aagatya "sma"saanasthaana.m pravi"sya</para>
  <para style="p">
    <verse number="7" style="v"/>sthaapitavastraa.ni mastakasya vastra nca p.rthak sthaanaantare sthaapita.m d.r.s.tavaan|</para>
  <para style="p">
    <verse number="8" style="v"/>tata.h "sma"saanasthaana.m puurvvam aagato yonya"si.sya.h sopi pravi"sya taad.r"sa.m d.r.s.taa vya"svasiit|</para>
  <para style="p">
    <verse number="9" style="v"/>yata.h "sma"saanaat sa utthaapayitavya etasya dharmmapustakavacanasya bhaava.m te tadaa voddhu.m naa"sankuvan|</para>
  <para style="p">
    <verse number="10" style="v"/>anantara.m tau dvau "si.syau sva.m sva.m g.rha.m paraav.rtyaagacchataam|</para>
  <para style="p">
    <verse number="11" style="v"/>tata.h para.m mariyam "sma"saanadvaarasya bahi.h sthitvaa roditum aarabhata tato rudatii prahviibhuuya "sma"saana.m vilokya</para>
  <para style="p">
    <verse number="12" style="v"/>yii"so.h "sayanasthaanasya "sira.hsthaane padatale ca dvayo rdi"so dvau svargiiyaduutaavupavi.s.tau samapa"syat|</para>
  <para style="p">
    <verse number="13" style="v"/>tau p.r.s.tavantau he naari kuto rodi.si? saavadat lokaa mama prabhu.m niitvaa kutraasthaapayan iti na jaanaami|</para>
  <para style="p">
    <verse number="14" style="v"/>ityuktvaa mukha.m paraav.rtya yii"su.m da.n.daayamaanam apa"syat kintu sa yii"suriti saa j naatu.m naa"saknot|</para>
  <para style="p">
    <verse number="15" style="v"/>tadaa yii"sustaam ap.rcchat he naari kuto rodi.si? ka.m vaa m.rgayase? tata.h saa tam udyaanasevaka.m j naatvaa vyaaharat, he maheccha tva.m yadiita.h sthaanaat ta.m niitavaan tarhi kutraasthaapayastad vada tatsthaanaat tam aanayaami|</para>
  <para style="p">
    <verse number="16" style="v"/>tadaa yii"sustaam avadat he mariyam| tata.h saa paraav.rtya pratyavadat he rabbuunii arthaat he guro|</para>
  <para style="p">
    <verse number="17" style="v"/>tadaa yii"suravadat maa.m maa dhara, idaanii.m pitu.h samiipe uurddhvagamana.m na karomi kintu yo mama yu.smaaka nca pitaa mama yu.smaaka nce"svarastasya nika.ta uurddhvagamana.m karttum udyatosmi, imaa.m kathaa.m tva.m gatvaa mama bhraat.rga.na.m j naapaya|</para>
  <para style="p">
    <verse number="18" style="v"/>tato magdaliiniimariyam tatk.sa.naad gatvaa prabhustasyai dar"sana.m dattvaa kathaa etaa akathayad iti vaarttaa.m "si.syebhyo.akathayat|</para>
  <para style="p">
    <verse number="19" style="v"/>tata.h para.m saptaahasya prathamadinasya sandhyaasamaye "si.syaa ekatra militvaa yihuudiiyebhyo bhiyaa dvaararuddham akurvvan, etasmin kaale yii"suste.saa.m madhyasthaane ti.s.than akathayad yu.smaaka.m kalyaa.na.m bhuuyaat|</para>
  <para style="p">
    <verse number="20" style="v"/>ityuktvaa nijahasta.m kuk.si nca dar"sitavaan, tata.h "si.syaa.h prabhu.m d.r.s.tvaa h.r.s.taa abhavan|</para>
  <para style="p">
    <verse number="21" style="v"/>yii"su.h punaravadad yu.smaaka.m kalyaa.na.m bhuuyaat pitaa yathaa maa.m prai.sayat tathaahamapi yu.smaan pre.sayaami|</para>
  <para style="p">
    <verse number="22" style="v"/>ityuktvaa sa te.saamupari diirghapra"svaasa.m dattvaa kathitavaan pavitram aatmaana.m g.rhliita|</para>
  <para style="p">
    <verse number="23" style="v"/>yuuya.m ye.saa.m paapaani mocayi.syatha te mocayi.syante ye.saa nca paapaati na mocayi.syatha te na mocayi.syante|</para>
  <para style="p">
    <verse number="24" style="v"/>dvaada"samadhye ga.nito yamajo thomaanaamaa "si.syo yii"soraagamanakaalai tai.h saarddha.m naasiit|</para>
  <para style="p">
    <verse number="25" style="v"/>ato vaya.m prabhuum apa"syaameti vaakye.anya"si.syairukte sovadat, tasya hastayo rlauhakiilakaanaa.m cihna.m na vilokya taccihnam a"ngulyaa na sp.r.s.tvaa tasya kuk.sau hasta.m naaropya caaha.m na vi"svasi.syaami|</para>
  <para style="p">
    <verse number="26" style="v"/>aparam a.s.tame.ahni gate sati thomaasahita.h "si.syaga.na ekatra militvaa dvaara.m ruddhvaabhyantara aasiit, etarhi yii"suste.saa.m madhyasthaane ti.s.than akathayat, yu.smaaka.m ku"sala.m bhuuyaat|</para>
  <para style="p">
    <verse number="27" style="v"/>pa"scaat thaamai kathitavaan tvam a"nguliim atraarpayitvaa mama karau pa"sya kara.m prasaaryya mama kuk.saavarpaya naavi"svasya|</para>
  <para style="p">
    <verse number="28" style="v"/>tadaa thomaa avadat, he mama prabho he madii"svara|</para>
  <para style="p">
    <verse number="29" style="v"/>yii"surakathayat, he thomaa maa.m niriik.sya vi"svasi.si ye na d.r.s.tvaa vi"svasanti taeva dhanyaa.h|</para>
  <para style="p">
    <verse number="30" style="v"/>etadanyaani pustake.asmin alikhitaani bahuunyaa"scaryyakarmmaa.ni yii"su.h "si.syaa.naa.m purastaad akarot|</para>
  <para style="p">
    <verse number="31" style="v"/>kintu yii"surii"svarasyaabhi.sikta.h suta eveti yathaa yuuya.m vi"svasitha vi"svasya ca tasya naamnaa paramaayu.h praapnutha tadartham etaani sarvvaa.nyalikhyanta|</para>
  <chapter number="21" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>tata.h para.m tibiriyaajaladhesta.te yii"su.h punarapi "si.syebhyo dar"sana.m dattavaan dar"sanasyaakhyaanamidam|</para>
  <para style="p">
    <verse number="2" style="v"/>"simonpitara.h yamajathomaa gaaliiliiyakaannaanagaranivaasii nithanel sivade.h putraavanyau dvau "si.syau caite.svekatra milite.su "simonpitaro.akathayat matsyaan dhartu.m yaami|</para>
  <para style="p">
    <verse number="3" style="v"/>tataste vyaaharan tarhi vayamapi tvayaa saarddha.m yaama.h tadaa te bahirgataa.h santa.h k.sipra.m naavam aarohan kintu tasyaa.m rajanyaam ekamapi na praapnuvan|</para>
  <para style="p">
    <verse number="4" style="v"/>prabhaate sati yii"susta.te sthitavaan kintu sa yii"suriti "si.syaa j naatu.m naa"saknuvan|</para>
  <para style="p">
    <verse number="5" style="v"/>tadaa yii"surap.rcchat, he vatsaa sannidhau ki ncit khaadyadravyam aaste? te.avadan kimapi naasti|</para>
  <para style="p">
    <verse number="6" style="v"/>tadaa so.avadat naukaayaa dak.si.napaar"sve jaala.m nik.sipata tato lapsyadhve, tasmaat tai rnik.sipte jaale matsyaa etaavanto.apatan yena te jaalamaak.r.sya nottolayitu.m "saktaa.h|</para>
  <para style="p">
    <verse number="7" style="v"/>tasmaad yii"so.h priyatama"si.sya.h pitaraayaakathayat e.sa prabhu rbhavet, e.sa prabhuriti vaaca.m "srutvaiva "simon nagnataaheto rmatsyadhaari.na uttariiyavastra.m paridhaaya hrada.m pratyudalamphayat|</para>
  <para style="p">
    <verse number="8" style="v"/>apare "si.syaa matsyai.h saarddha.m jaalam aakar.santa.h k.sudranaukaa.m vaahayitvaa kuulamaanayan te kuulaad atiduure naasan dvi"satahastebhyo duura aasan ityanumiiyate|</para>
  <para style="p">
    <verse number="9" style="v"/>tiira.m praaptaistaistatra prajvalitaagnistadupari matsyaa.h puupaa"sca d.r.s.taa.h|</para>
  <para style="p">
    <verse number="10" style="v"/>tato yii"surakathayad yaan matsyaan adharata te.saa.m katipayaan aanayata|</para>
  <para style="p">
    <verse number="11" style="v"/>ata.h "simonpitara.h paraav.rtya gatvaa b.rhadbhistripa ncaa"sadadhika"satamatsyai.h paripuur.na.m tajjaalam aak.r.syodatolayat kintvetaavadbhi rmatsyairapi jaala.m naachidyata|</para>
  <para style="p">
    <verse number="12" style="v"/>anantara.m yii"sustaan avaadiit yuuyamaagatya bhu.mgdhva.m; tadaa saeva prabhuriti j naatatvaat tva.m ka.h? iti pra.s.tu.m "si.syaa.naa.m kasyaapi pragalbhataa naabhavat|</para>
  <para style="p">
    <verse number="13" style="v"/>tato yii"suraagatya puupaan matsyaa.m"sca g.rhiitvaa tebhya.h paryyave.sayat|</para>
  <para style="p">
    <verse number="14" style="v"/>ittha.m "sma"saanaadutthaanaat para.m yii"su.h "si.syebhyast.rtiiyavaara.m dar"sana.m dattavaan|</para>
  <para style="p">
    <verse number="15" style="v"/>bhojane samaapte sati yii"su.h "simonpitara.m p.r.s.tavaan, he yuunasa.h putra "simon tva.m kim etebhyodhika.m mayi priiyase? tata.h sa uditavaan satya.m prabho tvayi priiye.aha.m tad bhavaan jaanaati; tadaa yii"surakathayat tarhi mama me.sa"saavakaga.na.m paalaya|</para>
  <para style="p">
    <verse number="16" style="v"/>tata.h sa dvitiiyavaara.m p.r.s.tavaan he yuunasa.h putra "simon tva.m ki.m mayi priiyase? tata.h sa uktavaan satya.m prabho tvayi priiye.aha.m tad bhavaan jaanaati; tadaa yii"surakathayata tarhi mama me.saga.na.m paalaya|</para>
  <para style="p">
    <verse number="17" style="v"/>pa"scaat sa t.rtiiyavaara.m p.r.s.tavaan, he yuunasa.h putra "simon tva.m ki.m mayi priiyase? etadvaakya.m t.rtiiyavaara.m p.r.s.tavaan tasmaat pitaro du.hkhito bhuutvaa.akathayat he prabho bhavata.h kimapyagocara.m naasti tvayyaha.m priiye tad bhavaan jaanaati; tato yii"suravadat tarhi mama me.saga.na.m paalaya|</para>
  <para style="p">
    <verse number="18" style="v"/>aha.m tubhya.m yathaartha.m kathayaami yauvanakaale svaya.m baddhaka.ti ryatrecchaa tatra yaatavaan kintvita.h para.m v.rddhe vayasi hasta.m vistaarayi.syasi, anyajanastvaa.m baddhvaa yatra gantu.m tavecchaa na bhavati tvaa.m dh.rtvaa tatra ne.syati|</para>
  <para style="p">
    <verse number="19" style="v"/>phalata.h kiid.r"sena mara.nena sa ii"svarasya mahimaana.m prakaa"sayi.syati tad bodhayitu.m sa iti vaakya.m proktavaan| ityukte sati sa tamavocat mama pa"scaad aagaccha|</para>
  <para style="p">
    <verse number="20" style="v"/>yo jano raatrikaale yii"so rvak.so.avalambya, he prabho ko bhavanta.m parakare.su samarpayi.syatiiti vaakya.m p.r.s.tavaan, ta.m yii"so.h priyatama"si.sya.m pa"scaad aagacchanta.m</para>
  <para style="p">
    <verse number="21" style="v"/>pitaro mukha.m paraavarttya vilokya yii"su.m p.r.s.tavaan, he prabho etasya maanavasya kiid.r"sii gati rbhavi.syati?</para>
  <para style="p">
    <verse number="22" style="v"/>sa pratyavadat, mama punaraagamanaparyyanta.m yadi ta.m sthaapayitum icchaami tatra tava ki.m? tva.m mama pa"scaad aagaccha|</para>
  <para style="p">
    <verse number="23" style="v"/>tasmaat sa "si.syo na mari.syatiiti bhraat.rga.namadhye ki.mvadantii jaataa kintu sa na mari.syatiiti vaakya.m yii"su rnaavadat kevala.m mama punaraagamanaparyyanta.m yadi ta.m sthaapayitum icchaami tatra tava ki.m? iti vaakyam uktavaan|</para>
  <para style="p">
    <verse number="24" style="v"/>yo jana etaani sarvvaa.ni likhitavaan atra saak.sya nca dattavaan saeva sa "si.sya.h, tasya saak.sya.m pramaa.namiti vaya.m jaaniima.h|</para>
  <para style="p">
    <verse number="25" style="v"/>yii"suretebhyo.aparaa.nyapi bahuuni karmmaa.ni k.rtavaan taani sarvvaa.ni yadyekaika.m k.rtvaa likhyante tarhi granthaa etaavanto bhavanti te.saa.m dhaara.ne p.rthivyaa.m sthaana.m na bhavati| iti||</para>
</usx>
