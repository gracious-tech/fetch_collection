<?xml version="1.0" encoding="UTF-8"?>
<usx version="2.6">
  <book code="MRK" style="id">Sanskrit Bible (NT) in Velthuis Script (satyaveda.h ।)</book>
  <para style="rem">© SanskritBible.in । Licensed under CC BY-SA 4.0</para>
  <para style="h">Mark</para>
  <para style="toc1">maarkalikhita.h susa.mvaada.h</para>
  <para style="toc2">maarka.h</para>
  <para style="toc3">maarka.h</para>
  <para style="mt1">maarkalikhita.h susa.mvaada.h</para>
  <chapter number="1" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>ii"svaraputrasya yii"sukhrii.s.tasya susa.mvaadaarambha.h|</para>
  <para style="p">
    <verse number="2" style="v"/>bhavi.syadvaadinaa.m granthe.su lipiritthamaaste, pa"sya svakiiyaduutantu tavaagre pre.sayaamyaham| gatvaa tvadiiyapanthaana.m sa hi pari.skari.syati|</para>
  <para style="p">
    <verse number="3" style="v"/>"parame"sasya panthaana.m pari.skuruta sarvvata.h| tasya raajapatha ncaiva samaana.m kurutaadhunaa|" ityetat praantare vaakya.m vadata.h kasyacidrava.h||</para>
  <para style="p">
    <verse number="4" style="v"/>saeva yohan praantare majjitavaan tathaa paapamaarjananimitta.m manovyaavarttakamajjanasya kathaa nca pracaaritavaan|</para>
  <para style="p">
    <verse number="5" style="v"/>tato yihuudaade"sayiruu"saalamnagaranivaasina.h sarvve lokaa bahi rbhuutvaa tasya samiipamaagatya svaani svaani paapaanya"ngiik.rtya yarddananadyaa.m tena majjitaa babhuuvu.h|</para>
  <para style="p">
    <verse number="6" style="v"/>asya yohana.h paridheyaani kramelakalomajaani, tasya ka.tibandhana.m carmmajaatam, tasya bhak.syaa.ni ca "suukakii.taa vanyamadhuuni caasan|</para>
  <para style="p">
    <verse number="7" style="v"/>sa pracaarayan kathayaa ncakre, aha.m namriibhuuya yasya paadukaabandhana.m mocayitumapi na yogyosmi, taad.r"so matto gurutara eka.h puru.so matpa"scaadaagacchati|</para>
  <para style="p">
    <verse number="8" style="v"/>aha.m yu.smaan jale majjitavaan kintu sa pavitra aatmaani sa.mmajjayi.syati|</para>
  <para style="p">
    <verse number="9" style="v"/>apara nca tasminneva kaale gaaliilprade"sasya naasaradgraamaad yii"suraagatya yohanaa yarddananadyaa.m majjito.abhuut|</para>
  <para style="p">
    <verse number="10" style="v"/>sa jalaadutthitamaatro meghadvaara.m mukta.m kapotavat svasyopari avarohantamaatmaana nca d.r.s.tavaan|</para>
  <para style="p">
    <verse number="11" style="v"/>tva.m mama priya.h putrastvayyeva mamamahaasanto.sa iyamaakaa"siiyaa vaa.nii babhuuva|</para>
  <para style="p">
    <verse number="12" style="v"/>tasmin kaale aatmaa ta.m praantaramadhya.m ninaaya|</para>
  <para style="p">
    <verse number="13" style="v"/>atha sa catvaari.m"saddinaani tasmin sthaane vanyapa"subhi.h saha ti.s.than "saitaanaa pariik.sita.h; pa"scaat svargiiyaduutaasta.m si.sevire|</para>
  <para style="p">
    <verse number="14" style="v"/>anantara.m yohani bandhanaalaye baddhe sati yii"su rgaaliilprade"samaagatya ii"svararaajyasya susa.mvaada.m pracaarayan kathayaamaasa,</para>
  <para style="p">
    <verse number="15" style="v"/>kaala.h sampuur.na ii"svararaajya nca samiipamaagata.m; atoheto ryuuya.m manaa.msi vyaavarttayadhva.m susa.mvaade ca vi"svaasita|</para>
  <para style="p">
    <verse number="16" style="v"/>tadanantara.m sa gaaliiliiyasamudrasya tiire gacchan "simon tasya bhraataa andriyanaamaa ca imau dvau janau matsyadhaari.nau saagaramadhye jaala.m prak.sipantau d.r.s.tvaa taavavadat,</para>
  <para style="p">
    <verse number="17" style="v"/>yuvaa.m mama pa"scaadaagacchata.m, yuvaamaha.m manu.syadhaari.nau kari.syaami|</para>
  <para style="p">
    <verse number="18" style="v"/>tatastau tatk.sa.nameva jaalaani parityajya tasya pa"scaat jagmatu.h|</para>
  <para style="p">
    <verse number="19" style="v"/>tata.h para.m tatsthaanaat ki ncid duura.m gatvaa sa sivadiiputrayaakuub tadbhraat.ryohan ca imau naukaayaa.m jaalaanaa.m jiir.namuddhaarayantau d.r.s.tvaa taavaahuuyat|</para>
  <para style="p">
    <verse number="20" style="v"/>tatastau naukaayaa.m vetanabhugbhi.h sahita.m svapitara.m vihaaya tatpa"scaadiiyatu.h|</para>
  <para style="p">
    <verse number="21" style="v"/>tata.h para.m kapharnaahuumnaamaka.m nagaramupasthaaya sa vi"sraamadivase bhajanagraha.m pravi"sya samupadide"sa|</para>
  <para style="p">
    <verse number="22" style="v"/>tasyopade"saallokaa aa"scaryya.m menire yata.h sodhyaapakaaiva nopadi"san prabhaavavaaniva propadide"sa|</para>
  <para style="p">
    <verse number="23" style="v"/>apara nca tasmin bhajanag.rhe apavitrabhuutena grasta eko maanu.sa aasiit| sa ciit"sabda.m k.rtvaa kathayaa ncake</para>
  <para style="p">
    <verse number="24" style="v"/>bho naasaratiiya yii"so tvamasmaan tyaja, tvayaa sahaasmaaka.m ka.h sambandha.h? tva.m kimasmaan naa"sayitu.m samaagata.h? tvamii"svarasya pavitraloka ityaha.m jaanaami|</para>
  <para style="p">
    <verse number="25" style="v"/>tadaa yii"susta.m tarjayitvaa jagaada tuu.s.nii.m bhava ito bahirbhava ca|</para>
  <para style="p">
    <verse number="26" style="v"/>tata.h so.apavitrabhuutasta.m sampii.dya atyucai"sciitk.rtya nirjagaama|</para>
  <para style="p">
    <verse number="27" style="v"/>tenaiva sarvve camatk.rtya paraspara.m kathayaa ncakrire, aho kimida.m? kiid.r"so.aya.m navya upade"sa.h? anena prabhaavenaapavitrabhuute.svaaj naapite.su te tadaaj naanuvarttino bhavanti|</para>
  <para style="p">
    <verse number="28" style="v"/>tadaa tasya ya"so gaaliila"scaturdiksthasarvvade"saan vyaapnot|</para>
  <para style="p">
    <verse number="29" style="v"/>apara nca te bhajanag.rhaad bahi rbhuutvaa yaakuubyohanbhyaa.m saha "simona aandriyasya ca nive"sana.m pravivi"su.h|</para>
  <para style="p">
    <verse number="30" style="v"/>tadaa pitarasya "sva"sruurjvarapii.ditaa "sayyaayaamaasta iti te ta.m jha.titi vij naapayaa ncakru.h|</para>
  <para style="p">
    <verse number="31" style="v"/>tata.h sa aagatya tasyaa hasta.m dh.rtvaa taamudasthaapayat; tadaiva taa.m jvaro.atyaak.siit tata.h para.m saa taan si.seve|</para>
  <para style="p">
    <verse number="32" style="v"/>athaasta.m gate ravau sandhyaakaale sati lokaastatsamiipa.m sarvvaan rogi.no bhuutadh.rtaa.m"sca samaaninyu.h|</para>
  <para style="p">
    <verse number="33" style="v"/>sarvve naagarikaa lokaa dvaari sa.mmilitaa"sca|</para>
  <para style="p">
    <verse number="34" style="v"/>tata.h sa naanaavidharogi.no bahuun manujaanarogi.na"scakaara tathaa bahuun bhuutaan tyaajayaa ncakaara taan bhuutaan kimapi vaakya.m vaktu.m ni.si.sedha ca yatohetoste tamajaanan|</para>
  <para style="p">
    <verse number="35" style="v"/>apara nca so.atipratyuu.se vastutastu raatri"se.se samutthaaya bahirbhuuya nirjana.m sthaana.m gatvaa tatra praarthayaa ncakre|</para>
  <para style="p">
    <verse number="36" style="v"/>anantara.m "simon tatsa"ngina"sca tasya pa"scaad gatavanta.h|</para>
  <para style="p">
    <verse number="37" style="v"/>tadudde"sa.m praapya tamavadan sarvve lokaastvaa.m m.rgayante|</para>
  <para style="p">
    <verse number="38" style="v"/>tadaa so.akathayat aagacchata vaya.m samiipasthaani nagaraa.ni yaama.h, yato.aha.m tatra kathaa.m pracaarayitu.m bahiraagamam|</para>
  <para style="p">
    <verse number="39" style="v"/>atha sa te.saa.m gaaliilprade"sasya sarvve.su bhajanag.rhe.su kathaa.h pracaarayaa ncakre bhuutaanatyaajaya nca|</para>
  <para style="p">
    <verse number="40" style="v"/>anantarameka.h ku.s.thii samaagatya tatsammukhe jaanupaata.m vinaya nca k.rtvaa kathitavaan yadi bhavaan icchati tarhi maa.m pari.skarttu.m "saknoti|</para>
  <para style="p">
    <verse number="41" style="v"/>tata.h k.rpaalu ryii"su.h karau prasaaryya ta.m spa.s.tvaa kathayaamaasa</para>
  <para style="p">
    <verse number="42" style="v"/>mamecchaa vidyate tva.m pari.sk.rto bhava| etatkathaayaa.h kathanamaatraat sa ku.s.thii rogaanmukta.h pari.sk.rto.abhavat|</para>
  <para style="p">
    <verse number="43" style="v"/>tadaa sa ta.m vis.rjan gaa.dhamaadi"sya jagaada</para>
  <para style="p">
    <verse number="44" style="v"/>saavadhaano bhava kathaamimaa.m kamapi maa vada; svaatmaana.m yaajaka.m dar"saya, lokebhya.h svapari.sk.rte.h pramaa.nadaanaaya muusaanir.niita.m yaddaana.m taduts.rjasva ca|</para>
  <para style="p">
    <verse number="45" style="v"/>kintu sa gatvaa tat karmma ittha.m vistaaryya pracaarayitu.m praarebhe tenaiva yii"su.h puna.h saprakaa"sa.m nagara.m prave.s.tu.m naa"saknot tatohetorbahi.h kaananasthaane tasyau; tathaapi caturddigbhyo lokaastasya samiipamaayayu.h|</para>
  <chapter number="2" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>tadanantara.m yii"sai katipayadinaani vilambya puna.h kapharnaahuumnagara.m pravi.s.te sa g.rha aasta iti ki.mvadantyaa tatk.sa.na.m tatsamiipa.m bahavo lokaa aagatya samupatasthu.h,</para>
  <para style="p">
    <verse number="2" style="v"/>tasmaad g.rhamadhye sarvve.saa.m k.rte sthaana.m naabhavad dvaarasya caturdik.svapi naabhavat, tatkaale sa taan prati kathaa.m pracaarayaa ncakre|</para>
  <para style="p">
    <verse number="3" style="v"/>tata.h para.m lokaa"scaturbhi rmaanavaireka.m pak.saaghaatina.m vaahayitvaa tatsamiipam aaninyu.h|</para>
  <para style="p">
    <verse number="4" style="v"/>kintu janaanaa.m bahutvaat ta.m yii"so.h sammukhamaanetu.m na "saknuvanto yasmin sthaane sa aaste taduparig.rhap.r.s.tha.m khanitvaa chidra.m k.rtvaa tena maarge.na sa"sayya.m pak.saaghaatinam avarohayaamaasu.h|</para>
  <para style="p">
    <verse number="5" style="v"/>tato yii"suste.saa.m vi"svaasa.m d.r.s.tvaa ta.m pak.saaghaatina.m babhaa.se he vatsa tava paapaanaa.m maarjana.m bhavatu|</para>
  <para style="p">
    <verse number="6" style="v"/>tadaa kiyanto.adhyaapakaastatropavi"santo manobhi rvitarkayaa ncakru.h, e.sa manu.sya etaad.r"siimii"svaranindaa.m kathaa.m kuta.h kathayati?</para>
  <para style="p">
    <verse number="7" style="v"/>ii"svara.m vinaa paapaani maar.s.tu.m kasya saamarthyam aaste?</para>
  <para style="p">
    <verse number="8" style="v"/>ittha.m te vitarkayanti yii"sustatk.sa.na.m manasaa tad budvvaa taanavadad yuuyamanta.hkara.nai.h kuta etaani vitarkayatha?</para>
  <para style="p">
    <verse number="9" style="v"/>tadanantara.m yii"sustatsthaanaat puna.h samudrata.ta.m yayau; lokanivahe tatsamiipamaagate sa taan samupadide"sa|</para>
  <para style="p">
    <verse number="10" style="v"/>kintu p.rthivyaa.m paapaani maar.s.tu.m manu.syaputrasya saamarthyamasti, etad yu.smaan j naapayitu.m (sa tasmai pak.saaghaatine kathayaamaasa)</para>
  <para style="p">
    <verse number="11" style="v"/>utti.s.tha tava "sayyaa.m g.rhiitvaa svag.rha.m yaahi, aha.m tvaamidam aaj naapayaami|</para>
  <para style="p">
    <verse number="12" style="v"/>tata.h sa tatk.sa.nam utthaaya "sayyaa.m g.rhiitvaa sarvve.saa.m saak.saat jagaama; sarvve vismitaa etaad.r"sa.m karmma vayam kadaapi naapa"syaama, imaa.m kathaa.m kathayitve"svara.m dhanyamabruvan|</para>
  <para style="p">
    <verse number="13" style="v"/>tadanantara.m yii"sustatsthaanaat puna.h samudrata.ta.m yayau; lokanivahe tatsamiipamaagate sa taan samupadide"sa|</para>
  <para style="p">
    <verse number="14" style="v"/>atha gacchan karasa ncayag.rha upavi.s.tam aalphiiyaputra.m levi.m d.r.s.tvaa tamaahuuya kathitavaan matpa"scaat tvaamaamaccha tata.h sa utthaaya tatpa"scaad yayau|</para>
  <para style="p">
    <verse number="15" style="v"/>anantara.m yii"sau tasya g.rhe bhoktum upavi.s.te bahava.h karama ncaayina.h paapina"sca tena tacchi.syai"sca sahopavivi"su.h, yato bahavastatpa"scaadaajagmu.h|</para>
  <para style="p">
    <verse number="16" style="v"/>tadaa sa karama ncaayibhi.h paapibhi"sca saha khaadati, tad d.r.s.tvaadhyaapakaa.h phiruu"sina"sca tasya "si.syaanuucu.h karama ncaayibhi.h paapibhi"sca sahaaya.m kuto bhu.mkte pivati ca?</para>
  <para style="p">
    <verse number="17" style="v"/>tadvaakya.m "srutvaa yii"su.h pratyuvaaca,arogilokaanaa.m cikitsakena prayojana.m naasti, kintu rogi.naameva; aha.m dhaarmmikaanaahvaatu.m naagata.h kintu mano vyaavarttayitu.m paapina eva|</para>
  <para style="p">
    <verse number="18" style="v"/>tata.h para.m yohana.h phiruu"sinaa ncopavaasaacaari"si.syaa yii"so.h samiipam aagatya kathayaamaasu.h, yohana.h phiruu"sinaa nca "si.syaa upavasanti kintu bhavata.h "si.syaa nopavasanti ki.m kaara.namasya?</para>
  <para style="p">
    <verse number="19" style="v"/>tadaa yii"sustaan babhaa.se yaavat kaala.m sakhibhi.h saha kanyaayaa varasti.s.thati taavatkaala.m te kimupavastu.m "saknuvanti? yaavatkaala.m varastai.h saha ti.s.thati taavatkaala.m ta upavastu.m na "saknuvanti|</para>
  <para style="p">
    <verse number="20" style="v"/>yasmin kaale tebhya.h sakaa"saad varo ne.syate sa kaala aagacchati, tasmin kaale te janaa upavatsyanti|</para>
  <para style="p">
    <verse number="21" style="v"/>kopi jana.h puraatanavastre nuutanavastra.m na siivyati, yato nuutanavastre.na saha sevane k.rte jiir.na.m vastra.m chidyate tasmaat puna rmahat chidra.m jaayate|</para>
  <para style="p">
    <verse number="22" style="v"/>kopi jana.h puraatanakutuu.su nuutana.m draak.saarasa.m na sthaapayati, yato nuutanadraak.saarasasya tejasaa taa.h kutvo vidiiryyante tato draak.saarasa"sca patati kutva"sca na"syanti, ataeva nuutanadraak.saaraso nuutanakutuu.su sthaapaniiya.h|</para>
  <para style="p">
    <verse number="23" style="v"/>tadanantara.m yii"su ryadaa vi"sraamavaare "sasyak.setre.na gacchati tadaa tasya "si.syaa gacchanta.h "sasyama njarii"schettu.m prav.rttaa.h|</para>
  <para style="p">
    <verse number="24" style="v"/>ata.h phiruu"sino yii"save kathayaamaasu.h pa"syatu vi"sraamavaasare yat karmma na karttavya.m tad ime kuta.h kurvvanti?</para>
  <para style="p">
    <verse number="25" style="v"/>tadaa sa tebhyo.akathayat daayuud tatsa.m"ngina"sca bhak.syaabhaavaat k.sudhitaa.h santo yat karmma k.rtavantastat ki.m yu.smaabhi rna pa.thitam?</para>
  <para style="p">
    <verse number="26" style="v"/>abiyaatharnaamake mahaayaajakataa.m kurvvati sa kathamii"svarasyaavaasa.m pravi"sya ye dar"saniiyapuupaa yaajakaan vinaanyasya kasyaapi na bhak.syaastaaneva bubhuje sa"ngilokebhyo.api dadau|</para>
  <para style="p">
    <verse number="27" style="v"/>so.aparamapi jagaada, vi"sraamavaaro manu.syaarthameva niruupito.asti kintu manu.syo vi"sraamavaaraartha.m naiva|</para>
  <para style="p">
    <verse number="28" style="v"/>manu.syaputro vi"sraamavaarasyaapi prabhuraaste|</para>
  <chapter number="3" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>anantara.m yii"su.h puna rbhajanag.rha.m pravi.s.tastasmin sthaane "su.skahasta eko maanava aasiit|</para>
  <para style="p">
    <verse number="2" style="v"/>sa vi"sraamavaare tamarogi.na.m kari.syati navetyatra bahavastam apavaditu.m chidramapek.sitavanta.h|</para>
  <para style="p">
    <verse number="3" style="v"/>tadaa sa ta.m "su.skahasta.m manu.sya.m jagaada madhyasthaane tvamutti.s.tha|</para>
  <para style="p">
    <verse number="4" style="v"/>tata.h para.m sa taan papraccha vi"sraamavaare hitamahita.m tathaa hi praa.narak.saa vaa praa.nanaa"sa e.saa.m madhye ki.m kara.niiya.m ? kintu te ni.h"sabdaastasthu.h|</para>
  <para style="p">
    <verse number="5" style="v"/>tadaa sa te.saamanta.hkara.naanaa.m kaa.thinyaaddheto rdu.hkhita.h krodhaat cartuिda"so d.r.s.tavaan ta.m maanu.sa.m gaditavaan ta.m hasta.m vistaaraya, tatastena haste vist.rte taddhasto.anyahastavad arogo jaata.h|</para>
  <para style="p">
    <verse number="6" style="v"/>atha phiruu"sina.h prasthaaya ta.m naa"sayitu.m herodiiyai.h saha mantrayitumaarebhire|</para>
  <para style="p">
    <verse number="7" style="v"/>ataeva yii"sustatsthaana.m parityajya "si.syai.h saha puna.h saagarasamiipa.m gata.h;</para>
  <para style="p">
    <verse number="8" style="v"/>tato gaaliilyihuudaa-yiruu"saalam-idom-yardannadiipaarasthaanebhyo lokasamuuhastasya pa"scaad gata.h; tadanya.h sorasiidano.h samiipavaasilokasamuuha"sca tasya mahaakarmma.naa.m vaartta.m "srutvaa tasya sannidhimaagata.h|</para>
  <para style="p">
    <verse number="9" style="v"/>tadaa lokasamuuha"scet tasyopari patati ityaa"sa"nkya sa naavamekaa.m nika.te sthaapayitu.m "si.syaanaadi.s.tavaan|</para>
  <para style="p">
    <verse number="10" style="v"/>yato.anekamanu.syaa.naamaarogyakara.naad vyaadhigrastaa.h sarvve ta.m spra.s.tu.m paraspara.m balena yatnavanta.h|</para>
  <para style="p">
    <verse number="11" style="v"/>apara nca apavitrabhuutaasta.m d.r.s.tvaa taccara.nayo.h patitvaa procai.h procu.h, tvamii"svarasya putra.h|</para>
  <para style="p">
    <verse number="12" style="v"/>kintu sa taan d.r.dham aaj naapya sva.m paricaayitu.m ni.siddhavaan|</para>
  <para style="p">
    <verse number="13" style="v"/>anantara.m sa parvvatamaaruhya ya.m ya.m praticchaa ta.m tamaahuutavaan tataste tatsamiipamaagataa.h|</para>
  <para style="p">
    <verse number="14" style="v"/>tadaa sa dvaada"sajanaan svena saha sthaatu.m susa.mvaadapracaaraaya preritaa bhavitu.m</para>
  <para style="p">
    <verse number="15" style="v"/>sarvvaprakaaravyaadhiinaa.m "samanakara.naaya prabhaava.m praaptu.m bhuutaan tyaajayitu nca niyuktavaan|</para>
  <para style="p">
    <verse number="16" style="v"/>te.saa.m naamaaniimaani, "simon sivadiputro</para>
  <para style="p">
    <verse number="17" style="v"/>yaakuub tasya bhraataa yohan ca aandriya.h philipo barthalamaya.h,</para>
  <para style="p">
    <verse number="18" style="v"/>mathii thomaa ca aalphiiyaputro yaakuub thaddiiya.h kinaaniiya.h "simon yasta.m parahaste.svarpayi.syati sa ii.skariyotiiyayihuudaa"sca|</para>
  <para style="p">
    <verse number="19" style="v"/>sa "simone pitara ityupanaama dadau yaakuubyohanbhyaa.m ca binerigi"s arthato meghanaadaputraavityupanaama dadau|</para>
  <para style="p">
    <verse number="20" style="v"/>anantara.m te nive"sana.m gataa.h, kintu tatraapi punarmahaan janasamaagamo .abhavat tasmaatte bhoktumapyavakaa"sa.m na praaptaa.h|</para>
  <para style="p">
    <verse number="21" style="v"/>tatastasya suh.rllokaa imaa.m vaarttaa.m praapya sa hataj naanobhuud iti kathaa.m kathayitvaa ta.m dh.rtvaanetu.m gataa.h|</para>
  <para style="p">
    <verse number="22" style="v"/>apara nca yiruu"saalama aagataa ye ye.adhyaapakaaste jagaduraya.m puru.so bhuutapatyaabi.s.tastena bhuutapatinaa bhuutaan tyaajayati|</para>
  <para style="p">
    <verse number="23" style="v"/>tatastaanaahuuya yii"su rd.r.s.taantai.h kathaa.m kathitavaan "saitaan katha.m "saitaana.m tyaajayitu.m "saknoti?</para>
  <para style="p">
    <verse number="24" style="v"/>ki ncana raajya.m yadi svavirodhena p.rthag bhavati tarhi tad raajya.m sthira.m sthaatu.m na "saknoti|</para>
  <para style="p">
    <verse number="25" style="v"/>tathaa kasyaapi parivaaro yadi paraspara.m virodhii bhavati tarhi sopi parivaara.h sthira.m sthaatu.m na "saknoti|</para>
  <para style="p">
    <verse number="26" style="v"/>tadvat "saitaan yadi svavipak.satayaa utti.s.than bhinno bhavati tarhi sopi sthira.m sthaatu.m na "saknoti kintuucchinno bhavati|</para>
  <para style="p">
    <verse number="27" style="v"/>apara nca prabala.m jana.m prathama.m na baddhaa kopi tasya g.rha.m pravi"sya dravyaa.ni lu.n.thayitu.m na "saknoti, ta.m badvvaiva tasya g.rhasya dravyaa.ni lu.n.thayitu.m "saknoti|</para>
  <para style="p">
    <verse number="28" style="v"/>atoheto ryu.smabhyamaha.m satya.m kathayaami manu.syaa.naa.m santaanaa yaani yaani paapaanii"svaranindaa nca kurvvanti te.saa.m tatsarvve.saamaparaadhaanaa.m k.samaa bhavitu.m "saknoti,</para>
  <para style="p">
    <verse number="29" style="v"/>kintu ya.h ka"scit pavitramaatmaana.m nindati tasyaaparaadhasya k.samaa kadaapi na bhavi.syati sonantada.n.dasyaarho bhavi.syati|</para>
  <para style="p">
    <verse number="30" style="v"/>tasyaapavitrabhuuto.asti te.saametatkathaaheto.h sa ittha.m kathitavaan|</para>
  <para style="p">
    <verse number="31" style="v"/>atha tasya maataa bhraat.rga.na"scaagatya bahisti.s.thanato lokaan pre.sya tamaahuutavanta.h|</para>
  <para style="p">
    <verse number="32" style="v"/>tatastatsannidhau samupavi.s.taa lokaasta.m babhaa.sire pa"sya bahistava maataa bhraatara"sca tvaam anvicchanti|</para>
  <para style="p">
    <verse number="33" style="v"/>tadaa sa taan pratyuvaaca mama maataa kaa bhraataro vaa ke? tata.h para.m sa svamiipopavi.s.taan "si.syaan prati avalokana.m k.rtvaa kathayaamaasa</para>
  <para style="p">
    <verse number="34" style="v"/>pa"syataite mama maataa bhraatara"sca|</para>
  <para style="p">
    <verse number="35" style="v"/>ya.h ka"scid ii"svarasye.s.taa.m kriyaa.m karoti sa eva mama bhraataa bhaginii maataa ca|</para>
  <chapter number="4" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>anantara.m sa samudrata.te punarupade.s.tu.m praarebhe, tatastatra bahujanaanaa.m samaagamaat sa saagaropari naukaamaaruhya samupavi.s.ta.h; sarvve lokaa.h samudrakuule tasthu.h|</para>
  <para style="p">
    <verse number="2" style="v"/>tadaa sa d.r.s.taantakathaabhi rbahuupadi.s.tavaan upadi"sa.m"sca kathitavaan,</para>
  <para style="p">
    <verse number="3" style="v"/>avadhaana.m kuruta, eko biijavaptaa biijaani vaptu.m gata.h;</para>
  <para style="p">
    <verse number="4" style="v"/>vapanakaale kiyanti biijaani maargapaa"sve patitaani, tata aakaa"siiyapak.si.na etya taani cakhaadu.h|</para>
  <para style="p">
    <verse number="5" style="v"/>kiyanti biijaani svalpam.rttikaavatpaa.saa.nabhuumau patitaani taani m.rdolpatvaat "siighrama"nkuritaani;</para>
  <para style="p">
    <verse number="6" style="v"/>kintuudite suuryye dagdhaani tathaa muulaano naadhogatatvaat "su.skaa.ni ca|</para>
  <para style="p">
    <verse number="7" style="v"/>kiyanti biijaani ka.n.takivanamadhye patitaani tata.h ka.n.takaani sa.mv.rdvya taani jagrasustaani na ca phalitaani|</para>
  <para style="p">
    <verse number="8" style="v"/>tathaa kiyanti biijaanyuttamabhuumau patitaani taani sa.mv.rdvya phalaanyutpaaditaani kiyanti biijaani tri.m"sadgu.naani kiyanti .sa.s.tigu.naani kiyanti "satagu.naani phalaani phalitavanti|</para>
  <para style="p">
    <verse number="9" style="v"/>atha sa taanavadat yasya "srotu.m kar.nau sta.h sa "s.r.notu|</para>
  <para style="p">
    <verse number="10" style="v"/>tadanantara.m nirjanasamaye tatsa"ngino dvaada"sa"si.syaa"sca ta.m tadd.r.s.taantavaakyasyaartha.m papracchu.h|</para>
  <para style="p">
    <verse number="11" style="v"/>tadaa sa taanuditavaan ii"svararaajyasya niguu.dhavaakya.m boddhu.m yu.smaakamadhikaaro.asti;</para>
  <para style="p">
    <verse number="12" style="v"/>kintu ye vahirbhuutaa.h "te pa"syanta.h pa"syanti kintu na jaananti, "s.r.nvanta.h "s.r.nvanti kintu na budhyante, cettai rmana.hsu kadaapi parivarttite.su te.saa.m paapaanyamocayi.syanta," atohetostaan prati d.r.s.taantaireva taani mayaa kathitaani|</para>
  <para style="p">
    <verse number="13" style="v"/>atha sa kathitavaan yuuya.m kimetad d.r.s.taantavaakya.m na budhyadhve? tarhi katha.m sarvvaan d.r.s.taantaana bhotsyadhve?</para>
  <para style="p">
    <verse number="14" style="v"/>biijavaptaa vaakyaruupaa.ni biijaani vapati;</para>
  <para style="p">
    <verse number="15" style="v"/>tatra ye ye lokaa vaakya.m "s.r.nvanti, kintu "srutamaatraat "saitaan "siighramaagatya te.saa.m mana.hsuuptaani taani vaakyaruupaa.ni biijaanyapanayati taeva uptabiijamaargapaar"svesvaruupaa.h|</para>
  <para style="p">
    <verse number="16" style="v"/>ye janaa vaakya.m "srutvaa sahasaa paramaanandena g.rhlanti, kintu h.rdi sthairyyaabhaavaat ki ncit kaalamaatra.m ti.s.thanti tatpa"scaat tadvaakyaheto.h</para>
  <para style="p">
    <verse number="17" style="v"/>kutracit kle"se upadrave vaa samupasthite tadaiva vighna.m praapnuvanti taeva uptabiijapaa.saa.nabhuumisvaruupaa.h|</para>
  <para style="p">
    <verse number="18" style="v"/>ye janaa.h kathaa.m "s.r.nvanti kintu saa.msaarikii cintaa dhanabhraanti rvi.sayalobha"sca ete sarvve upasthaaya taa.m kathaa.m grasanti tata.h maa viphalaa bhavati</para>
  <para style="p">
    <verse number="19" style="v"/>taeva uptabiijasaka.n.takabhuumisvaruupaa.h|</para>
  <para style="p">
    <verse number="20" style="v"/>ye janaa vaakya.m "srutvaa g.rhlanti te.saa.m kasya vaa tri.m"sadgu.naani kasya vaa .sa.s.tigu.naani kasya vaa "satagu.naani phalaani bhavanti taeva uptabiijorvvarabhuumisvaruupaa.h|</para>
  <para style="p">
    <verse number="21" style="v"/>tadaa so.aparamapi kathitavaan kopi jano diipaadhaara.m parityajya dro.nasyaadha.h kha.tvaayaa adhe vaa sthaapayitu.m diipamaanayati ki.m?</para>
  <para style="p">
    <verse number="22" style="v"/>atoheto ryanna prakaa"sayi.syate taad.rg lukkaayita.m kimapi vastu naasti; yad vyakta.m na bhavi.syati taad.r"sa.m gupta.m kimapi vastu naasti|</para>
  <para style="p">
    <verse number="23" style="v"/>yasya "srotu.m kar.nau sta.h sa "s.r.notu|</para>
  <para style="p">
    <verse number="24" style="v"/>aparamapi kathitavaan yuuya.m yad yad vaakya.m "s.r.nutha tatra saavadhaanaa bhavata, yato yuuya.m yena parimaa.nena parimaatha tenaiva parimaa.nena yu.smadarthamapi parimaasyate; "srotaaro yuuya.m yu.smabhyamadhika.m daasyate|</para>
  <para style="p">
    <verse number="25" style="v"/>yasyaa"sraye varddhate tasmai aparamapi daasyate, kintu yasyaa"sraye na varddhate tasya yat ki ncidasti tadapi tasmaan ne.syate|</para>
  <para style="p">
    <verse number="26" style="v"/>anantara.m sa kathitavaan eko loka.h k.setre biijaanyuptvaa</para>
  <para style="p">
    <verse number="27" style="v"/>jaagara.nanidraabhyaa.m divaani"sa.m gamayati, parantu tadviija.m tasyaaj naataruupe.naa"nkurayati varddhate ca;</para>
  <para style="p">
    <verse number="28" style="v"/>yatoheto.h prathamata.h patraa.ni tata.h para.m ka.ni"saani tatpa"scaat ka.ni"sapuur.naani "sasyaani bhuumi.h svayamutpaadayati;</para>
  <para style="p">
    <verse number="29" style="v"/>kintu phale.su pakke.su "sasyacchedanakaala.m j naatvaa sa tatk.sa.na.m "sasyaani chinatti, anena tulyamii"svararaajya.m|</para>
  <para style="p">
    <verse number="30" style="v"/>puna.h so.akathayad ii"svararaajya.m kena sama.m? kena vastunaa saha vaa tadupamaasyaami?</para>
  <para style="p">
    <verse number="31" style="v"/>tat sar.sapaikena tulya.m yato m.rdi vapanakaale sar.sapabiija.m sarvvap.rthiviisthabiijaat k.sudra.m</para>
  <para style="p">
    <verse number="32" style="v"/>kintu vapanaat param a"nkurayitvaa sarvva"saakaad b.rhad bhavati, tasya b.rhatya.h "saakhaa"sca jaayante tatastacchaayaa.m pak.si.na aa"srayante|</para>
  <para style="p">
    <verse number="33" style="v"/>ittha.m te.saa.m bodhaanuruupa.m so.anekad.r.s.taantaistaanupadi.s.tavaan,</para>
  <para style="p">
    <verse number="34" style="v"/>d.r.s.taanta.m vinaa kaamapi kathaa.m tebhyo na kathitavaan pa"scaan nirjane sa "si.syaan sarvvad.r.s.taantaartha.m bodhitavaan|</para>
  <para style="p">
    <verse number="35" style="v"/>taddinasya sandhyaayaa.m sa tebhyo.akathayad aagacchata vaya.m paara.m yaama|</para>
  <para style="p">
    <verse number="36" style="v"/>tadaa te lokaan vis.rjya tamavilamba.m g.rhiitvaa naukayaa pratasthire; aparaa api naavastayaa saha sthitaa.h|</para>
  <para style="p">
    <verse number="37" style="v"/>tata.h para.m mahaajha nbh"sagamaat nau rdolaayamaanaa tara"nge.na jalai.h puur.naabhavacca|</para>
  <para style="p">
    <verse number="38" style="v"/>tadaa sa naukaaca"scaadbhaage upadhaane "siro nidhaaya nidrita aasiit tataste ta.m jaagarayitvaa jagadu.h, he prabho, asmaaka.m praa.naa yaanti kimatra bhavata"scintaa naasti?</para>
  <para style="p">
    <verse number="39" style="v"/>tadaa sa utthaaya vaayu.m tarjitavaan samudra ncoktavaan "saanta.h susthira"sca bhava; tato vaayau niv.rtte.abdhirnistara"ngobhuut|</para>
  <para style="p">
    <verse number="40" style="v"/>tadaa sa taanuvaaca yuuya.m kuta etaad.rk"sa"nkaakulaa bhavata? ki.m vo vi"svaaso naasti?</para>
  <para style="p">
    <verse number="41" style="v"/>tasmaatte.atiivabhiitaa.h paraspara.m vaktumaarebhire, aho vaayu.h sindhu"scaasya nide"sagraahi.nau kiid.rgaya.m manuja.h|</para>
  <chapter number="5" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>atha tuu sindhupaara.m gatvaa gideriiyaprade"sa upatasthu.h|</para>
  <para style="p">
    <verse number="2" style="v"/>naukaato nirgatamaatraad apavitrabhuutagrasta eka.h "sma"saanaadetya ta.m saak.saac cakaara|</para>
  <para style="p">
    <verse number="3" style="v"/>sa "sma"saane.avaatsiit kopi ta.m "s.r"nkhalena badvvaa sthaapayitu.m naa"saknot|</para>
  <para style="p">
    <verse number="4" style="v"/>janairvaara.m niga.dai.h "s.r"nkhalai"sca sa baddhopi "s.r"nkhalaanyaak.r.sya mocitavaan niga.daani ca bha.mktvaa kha.n.da.m kha.n.da.m k.rtavaan kopi ta.m va"siikarttu.m na "sa"saka|</para>
  <para style="p">
    <verse number="5" style="v"/>divaani"sa.m sadaa parvvata.m "sma"saana nca bhramitvaa ciit"sabda.m k.rtavaan graavabhi"sca svaya.m sva.m k.rtavaan|</para>
  <para style="p">
    <verse number="6" style="v"/>sa yii"su.m duuraat pa"syanneva dhaavan ta.m pra.nanaama ucairuva.m"scovaaca,</para>
  <para style="p">
    <verse number="7" style="v"/>he sarvvoparisthe"svaraputra yii"so bhavataa saha me ka.h sambandha.h? aha.m tvaamii"svare.na "saapaye maa.m maa yaataya|</para>
  <para style="p">
    <verse number="8" style="v"/>yato yii"susta.m kathitavaan re apavitrabhuuta, asmaannaraad bahirnirgaccha|</para>
  <para style="p">
    <verse number="9" style="v"/>atha sa ta.m p.r.s.tavaan kinte naama? tena pratyukta.m vayamaneke .asmastato.asmannaama baahinii|</para>
  <para style="p">
    <verse number="10" style="v"/>tatosmaan de"saanna pre.sayeti te ta.m praarthayanta|</para>
  <para style="p">
    <verse number="11" style="v"/>tadaanii.m parvvata.m nika.saa b.rhan varaahavraja"scarannaasiit|</para>
  <para style="p">
    <verse number="12" style="v"/>tasmaad bhuutaa vinayena jagadu.h, amu.m varaahavrajam aa"srayitum asmaan prahi.nu|</para>
  <para style="p">
    <verse number="13" style="v"/>yii"sunaanuj naataaste.apavitrabhuutaa bahirniryaaya varaahavraja.m praavi"san tata.h sarvve varaahaa vastutastu praayodvisahasrasa.m"nkhyakaa.h ka.takena mahaajavaad dhaavanta.h sindhau praa.naan jahu.h|</para>
  <para style="p">
    <verse number="14" style="v"/>tasmaad varaahapaalakaa.h palaayamaanaa.h pure graame ca tadvaartta.m kathayaa ncakru.h| tadaa lokaa gha.tita.m tatkaaryya.m dra.s.tu.m bahirjagmu.h</para>
  <para style="p">
    <verse number="15" style="v"/>yii"so.h sannidhi.m gatvaa ta.m bhuutagrastam arthaad baahiniibhuutagrasta.m nara.m savastra.m sacetana.m samupavi.s.ta nca d.rृ.s.tvaa bibhyu.h|</para>
  <para style="p">
    <verse number="16" style="v"/>tato d.r.s.tatatkaaryyalokaastasya bhuutagrastanarasya varaahavrajasyaapi taa.m dha.tanaa.m var.nayaamaasu.h|</para>
  <para style="p">
    <verse number="17" style="v"/>tataste svasiimaato bahirgantu.m yii"su.m vinetumaarebhire|</para>
  <para style="p">
    <verse number="18" style="v"/>atha tasya naukaaroha.nakaale sa bhuutamukto naa yii"sunaa saha sthaatu.m praarthayate;</para>
  <para style="p">
    <verse number="19" style="v"/>kintu sa tamananumatya kathitavaan tva.m nijaatmiiyaanaa.m samiipa.m g.rha nca gaccha prabhustvayi k.rpaa.m k.rtvaa yaani karmmaa.ni k.rtavaan taani taan j naapaya|</para>
  <para style="p">
    <verse number="20" style="v"/>ata.h sa prasthaaya yii"sunaa k.rta.m tatsarvvaa"scaryya.m karmma dikaapalide"se pracaarayitu.m praarabdhavaan tata.h sarvve lokaa aa"scaryya.m menire|</para>
  <para style="p">
    <verse number="21" style="v"/>anantara.m yii"sau naavaa punaranyapaara uttiir.ne sindhuta.te ca ti.s.thati sati tatsamiipe bahulokaanaa.m samaagamo.abhuut|</para>
  <para style="p">
    <verse number="22" style="v"/>apara.m yaayiir naamnaa ka"scid bhajanag.rhasyaadhipa aagatya ta.m d.r.s.tvaiva cara.nayo.h patitvaa bahu nivedya kathitavaan;</para>
  <para style="p">
    <verse number="23" style="v"/>mama kanyaa m.rtapraayaabhuud ato bhavaanetya tadaarogyaaya tasyaa gaatre hastam arpayatu tenaiva saa jiivi.syati|</para>
  <para style="p">
    <verse number="24" style="v"/>tadaa yii"sustena saha calita.h kintu tatpa"scaad bahulokaa"scalitvaa taadgaatre patitaa.h|</para>
  <para style="p">
    <verse number="25" style="v"/>atha dvaada"savar.saa.ni pradararoge.na</para>
  <para style="p">
    <verse number="26" style="v"/>"siir.naa cikitsakaanaa.m naanaacikitsaabhi"sca du.hkha.m bhuktavatii ca sarvvasva.m vyayitvaapi naarogya.m praaptaa ca punarapi pii.ditaasiicca</para>
  <para style="p">
    <verse number="27" style="v"/>yaa strii saa yii"so rvaarttaa.m praapya manasaakathayat yadyaha.m tasya vastramaatra spra.s.tu.m labheya.m tadaa rogahiinaa bhavi.syaami|</para>
  <para style="p">
    <verse number="28" style="v"/>atoheto.h saa lokaara.nyamadhye tatpa"scaadaagatya tasya vastra.m paspar"sa|</para>
  <para style="p">
    <verse number="29" style="v"/>tenaiva tatk.sa.na.m tasyaa raktasrota.h "su.ska.m svaya.m tasmaad rogaanmuktaa ityapi dehe.anubhuutaa|</para>
  <para style="p">
    <verse number="30" style="v"/>atha svasmaat "sakti rnirgataa yii"suretanmanasaa j naatvaa lokanivaha.m prati mukha.m vyaav.rtya p.r.s.tavaan kena madvastra.m sp.r.s.ta.m?</para>
  <para style="p">
    <verse number="31" style="v"/>tatastasya "si.syaa uucu.h bhavato vapu.si lokaa.h sa.mghar.santi tad d.r.s.tvaa kena madvastra.m sp.r.s.tamiti kuta.h kathayati?</para>
  <para style="p">
    <verse number="32" style="v"/>kintu kena tat karmma k.rta.m tad dra.s.tu.m yii"su"scaturdi"so d.r.s.tavaan|</para>
  <para style="p">
    <verse number="33" style="v"/>tata.h saa strii bhiitaa kampitaa ca satii svasyaa rukpratikriyaa jaateti j naatvaagatya tatsammukhe patitvaa sarvvav.rttaanta.m satya.m tasmai kathayaamaasa|</para>
  <para style="p">
    <verse number="34" style="v"/>tadaanii.m yii"sustaa.m gaditavaan, he kanye tava pratiitistvaam arogaamakarot tva.m k.seme.na vraja svarogaanmuktaa ca ti.s.tha|</para>
  <para style="p">
    <verse number="35" style="v"/>itivaakyavadanakaale bhajanag.rhaadhipasya nive"sanaal lokaa etyaadhipa.m babhaa.sire tava kanyaa m.rtaa tasmaad guru.m puna.h kuta.h kli"snaasi?</para>
  <para style="p">
    <verse number="36" style="v"/>kintu yii"sustad vaakya.m "srutvaiva bhajanag.rhaadhipa.m gaditavaan maa bhai.sii.h kevala.m vi"svaasihi|</para>
  <para style="p">
    <verse number="37" style="v"/>atha pitaro yaakuub tadbhraataa yohan ca etaan vinaa kamapi svapa"scaad yaatu.m naanvamanyata|</para>
  <para style="p">
    <verse number="38" style="v"/>tasya bhajanag.rhaadhipasya nive"sanasamiipam aagatya kalaha.m bahurodana.m vilaapa nca kurvvato lokaan dadar"sa|</para>
  <para style="p">
    <verse number="39" style="v"/>tasmaan nive"sana.m pravi"sya proktavaan yuuya.m kuta ittha.m kalaha.m rodana nca kurutha? kanyaa na m.rtaa nidraati|</para>
  <para style="p">
    <verse number="40" style="v"/>tasmaatte tamupajahasu.h kintu yii"su.h sarvvaana bahi.sk.rtya kanyaayaa.h pitarau svasa"ngina"sca g.rhiitvaa yatra kanyaasiit tat sthaana.m pravi.s.tavaan|</para>
  <para style="p">
    <verse number="41" style="v"/>atha sa tasyaa.h kanyaayaa hastau dh.rtvaa taa.m babhaa.se .taaliithaa kuumii, arthato he kanye tvamutti.s.tha ityaaj naapayaami|</para>
  <para style="p">
    <verse number="42" style="v"/>tunaiva tatk.sa.na.m saa dvaada"savar.savayaskaa kanyaa potthaaya calitumaarebhe, ita.h sarvve mahaavismaya.m gataa.h|</para>
  <para style="p">
    <verse number="43" style="v"/>tata etasyai ki ncit khaadya.m datteti kathayitvaa etatkarmma kamapi na j naapayateti d.r.dhamaadi.s.tavaan|</para>
  <chapter number="6" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>anantara.m sa tatsthaanaat prasthaaya svaprade"samaagata.h "si.syaa"sca tatpa"scaad gataa.h|</para>
  <para style="p">
    <verse number="2" style="v"/>atha vi"sraamavaare sati sa bhajanag.rhe upade.s.tumaarabdhavaan tato.aneke lokaastatkathaa.m "srutvaa vismitya jagadu.h, asya manujasya iid.r"sii aa"scaryyakriyaa kasmaaj jaataa? tathaa svakaraabhyaam itthamadbhuta.m karmma karttaaुm etasmai katha.m j naana.m dattam?</para>
  <para style="p">
    <verse number="3" style="v"/>kimaya.m mariyama.h putrastaj naa no? kimaya.m yaakuub-yosi-yihudaa-"simonaa.m bhraataa no? asya bhaginya.h kimihaasmaabhi.h saha no? ittha.m te tadarthe pratyuuha.m gataa.h|</para>
  <para style="p">
    <verse number="4" style="v"/>tadaa yii"sustebhyo.akathayat svade"sa.m svaku.tumbaan svaparijanaa.m"sca vinaa kutraapi bhavi.syadvaadii asatk.rto na bhavati|</para>
  <para style="p">
    <verse number="5" style="v"/>apara nca te.saamapratyayaat sa vismita.h kiyataa.m rogi.naa.m vapu.h.su hastam arpayitvaa kevala.m te.saamaarogyakara.naad anyat kimapi citrakaaryya.m karttaa.m na "sakta.h|</para>
  <para style="p">
    <verse number="6" style="v"/>atha sa caturdikstha graamaan bhramitvaa upadi.s.tavaan</para>
  <para style="p">
    <verse number="7" style="v"/>dvaada"sa"si.syaan aahuuya amedhyabhuutaan va"siikarttaa.m "sakti.m dattvaa te.saa.m dvau dvau jano pre.sitavaan|</para>
  <para style="p">
    <verse number="8" style="v"/>punarityaadi"sad yuuyam ekaikaa.m ya.s.ti.m vinaa vastrasa.mpu.ta.h puupa.h ka.tibandhe taamrakha.n.da nca e.saa.m kimapi maa grahliita,</para>
  <para style="p">
    <verse number="9" style="v"/>maargayaatraayai paade.suupaanahau dattvaa dve uttariiye maa paridhadvva.m|</para>
  <para style="p">
    <verse number="10" style="v"/>aparamapyukta.m tena yuuya.m yasyaa.m puryyaa.m yasya nive"sana.m pravek.syatha taa.m purii.m yaavanna tyak.syatha taavat tannive"sane sthaasyatha|</para>
  <para style="p">
    <verse number="11" style="v"/>tatra yadi kepi yu.smaakamaatithya.m na vidadhati yu.smaaka.m kathaa"sca na "s.r.nvanti tarhi tatsthaanaat prasthaanasamaye te.saa.m viruddha.m saak.sya.m daatu.m svapaadaanaasphaalya raja.h sampaatayata; aha.m yu.smaan yathaartha.m vacmi vicaaradine tannagarasyaavasthaata.h sidomaamorayo rnagarayoravasthaa sahyataraa bhavi.syati|</para>
  <para style="p">
    <verse number="12" style="v"/>atha te gatvaa lokaanaa.m mana.hparaavarttanii.h kathaa pracaaritavanta.h|</para>
  <para style="p">
    <verse number="13" style="v"/>evamanekaan bhuutaa.m"sca tyaajitavantastathaa tailena marddayitvaa bahuun janaanarogaanakaar.su.h|</para>
  <para style="p">
    <verse number="14" style="v"/>ittha.m tasya sukhyaati"scaturdi"so vyaaptaa tadaa herod raajaa tanni"samya kathitavaan, yohan majjaka.h "sma"saanaad utthita atohetostena sarvvaa etaa adbhutakriyaa.h prakaa"sante|</para>
  <para style="p">
    <verse number="15" style="v"/>anye.akathayan ayam eliya.h, kepi kathitavanta e.sa bhavi.syadvaadii yadvaa bhavi.syadvaadinaa.m sad.r"sa ekoyam|</para>
  <para style="p">
    <verse number="16" style="v"/>kintu herod ityaakar.nya bhaa.sitavaan yasyaaha.m "sira"schinnavaan sa eva yohanaya.m sa "sma"saanaadudati.s.that|</para>
  <para style="p">
    <verse number="17" style="v"/>puurvva.m svabhraatu.h philipasya patnyaa udvaaha.m k.rtavanta.m heroda.m yohanavaadiit svabhaat.rvadhuu rna vivaahyaa|</para>
  <para style="p">
    <verse number="18" style="v"/>ata.h kaara.naat herod loka.m prahitya yohana.m dh.rtvaa bandhanaalaye baddhavaan|</para>
  <para style="p">
    <verse number="19" style="v"/>herodiyaa tasmai yohane prakupya ta.m hantum aicchat kintu na "saktaa,</para>
  <para style="p">
    <verse number="20" style="v"/>yasmaad herod ta.m dhaarmmika.m satpuru.sa nca j naatvaa sammanya rak.sitavaan; tatkathaa.m "srutvaa tadanusaare.na bahuuni karmmaa.ni k.rtavaan h.r.s.tamanaastadupade"sa.m "srutavaa.m"sca|</para>
  <para style="p">
    <verse number="21" style="v"/>kintu herod yadaa svajanmadine pradhaanalokebhya.h senaaniibhya"sca gaaliilprade"siiya"sre.s.thalokebhya"sca raatrau bhojyameka.m k.rtavaan</para>
  <para style="p">
    <verse number="22" style="v"/>tasmin "subhadine herodiyaayaa.h kanyaa sametya te.saa.m samak.sa.m sa.mn.rtya herodastena sahopavi.s.taanaa nca to.samajiijanat tataa n.rpa.h kanyaamaaha sma matto yad yaacase tadeva tubhya.m daasye|</para>
  <para style="p">
    <verse number="23" style="v"/>"sapatha.m k.rtvaakathayat ced raajyaarddhamapi yaacase tadapi tubhya.m daasye|</para>
  <para style="p">
    <verse number="24" style="v"/>tata.h saa bahi rgatvaa svamaatara.m papraccha kimaha.m yaaci.sye? tadaa saakathayat yohano majjakasya "sira.h|</para>
  <para style="p">
    <verse number="25" style="v"/>atha tuur.na.m bhuupasamiipam etya yaacamaanaavadat k.sa.nesmin yohano majjakasya "sira.h paatre nidhaaya dehi, etad yaace.aha.m|</para>
  <para style="p">
    <verse number="26" style="v"/>tasmaat bhuupo.atidu.hkhita.h, tathaapi sva"sapathasya sahabhojinaa ncaanurodhaat tadana"ngiikarttu.m na "sakta.h|</para>
  <para style="p">
    <verse number="27" style="v"/>tatk.sa.na.m raajaa ghaataka.m pre.sya tasya "sira aanetumaadi.s.tavaan|</para>
  <para style="p">
    <verse number="28" style="v"/>tata.h sa kaaraagaara.m gatvaa tacchira"schitvaa paatre nidhaayaaniiya tasyai kanyaayai dattavaan kanyaa ca svamaatre dadau|</para>
  <para style="p">
    <verse number="29" style="v"/>ananatara.m yohana.h "si.syaastadvaarttaa.m praapyaagatya tasya ku.napa.m "sma"saane.asthaapayan|</para>
  <para style="p">
    <verse number="30" style="v"/>atha pre.sitaa yii"so.h sannidhau militaa yad yac cakru.h "sik.sayaamaasu"sca tatsarvvavaarttaastasmai kathitavanta.h|</para>
  <para style="p">
    <verse number="31" style="v"/>sa taanuvaaca yuuya.m vijanasthaana.m gatvaa vi"sraamyata yatastatsannidhau bahulokaanaa.m samaagamaat te bhoktu.m naavakaa"sa.m praaptaa.h|</para>
  <para style="p">
    <verse number="32" style="v"/>tataste naavaa vijanasthaana.m gupta.m gagmu.h|</para>
  <para style="p">
    <verse number="33" style="v"/>tato lokanivahaste.saa.m sthaanaantarayaana.m dadar"sa, aneke ta.m paricitya naanaapurebhya.h padairvrajitvaa javena tai.saamagre yii"so.h samiipa upatasthu.h|</para>
  <para style="p">
    <verse number="34" style="v"/>tadaa yii"su rnaavo bahirgatya lokaara.nyaanii.m d.r.s.tvaa te.su karu.naa.m k.rtavaan yataste.arak.sakame.saa ivaasan tadaa sa taana naanaaprasa"ngaan upadi.s.tavaan|</para>
  <para style="p">
    <verse number="35" style="v"/>atha divaante sati "si.syaa etya yii"sumuucire, ida.m vijanasthaana.m dina ncaavasanna.m|</para>
  <para style="p">
    <verse number="36" style="v"/>lokaanaa.m kimapi khaadya.m naasti, ata"scaturdik.su graamaan gantu.m bhojyadravyaa.ni kretu nca bhavaan taan vis.rjatu|</para>
  <para style="p">
    <verse number="37" style="v"/>tadaa sa taanuvaaca yuuyameva taan bhojayata; tataste jagadu rvaya.m gatvaa dvi"satasa.mkhyakai rmudraapaadai.h puupaan kriitvaa ki.m taan bhojayi.syaama.h?</para>
  <para style="p">
    <verse number="38" style="v"/>tadaa sa taan p.r.s.thavaan yu.smaaka.m sannidhau kati puupaa aasate? gatvaa pa"syata; tataste d.r.s.tvaa tamavadan pa nca puupaa dvau matsyau ca santi|</para>
  <para style="p">
    <verse number="39" style="v"/>tadaa sa lokaan "saspopari pa.mktibhirupave"sayitum aadi.s.tavaan,</para>
  <para style="p">
    <verse number="40" style="v"/>tataste "sata.m "sata.m janaa.h pa ncaa"sat pa ncaa"sajjanaa"sca pa.mktibhi rbhuvi samupavivi"su.h|</para>
  <para style="p">
    <verse number="41" style="v"/>atha sa taan pa ncapuupaan matsyadvaya nca dh.rtvaa svarga.m pa"syan ii"svaragu.naan anvakiirttayat taan puupaan bha.mktvaa lokebhya.h parive.sayitu.m "si.syebhyo dattavaan dvaa matsyau ca vibhajya sarvvebhyo dattavaan|</para>
  <para style="p">
    <verse number="42" style="v"/>tata.h sarvve bhuktvaat.rpyan|</para>
  <para style="p">
    <verse number="43" style="v"/>anantara.m "si.syaa ava"si.s.tai.h puupai rmatsyai"sca puur.naan dvada"sa .dallakaan jag.rhu.h|</para>
  <para style="p">
    <verse number="44" style="v"/>te bhoktaara.h praaya.h pa nca sahasraa.ni puru.saa aasan|</para>
  <para style="p">
    <verse number="45" style="v"/>atha sa lokaan vis.rjanneva naavamaaro.dhu.m svasmaadagre paare baitsaidaapura.m yaatu nca "s.syiाn vaa.dhamaadi.s.tavaan|</para>
  <para style="p">
    <verse number="46" style="v"/>tadaa sa sarvvaan vis.rjya praarthayitu.m parvvata.m gata.h|</para>
  <para style="p">
    <verse number="47" style="v"/>tata.h sandhyaayaa.m satyaa.m nau.h sindhumadhya upasthitaa kintu sa ekaakii sthale sthita.h|</para>
  <para style="p">
    <verse number="48" style="v"/>atha sammukhavaatavahanaat "si.syaa naava.m vaahayitvaa pari"sraantaa iti j naatvaa sa ni"saacaturthayaame sindhuupari padbhyaa.m vrajan te.saa.m samiipametya te.saamagre yaatum udyata.h|</para>
  <para style="p">
    <verse number="49" style="v"/>kintu "si.syaa.h sindhuupari ta.m vrajanta.m d.r.s.tvaa bhuutamanumaaya ruruvu.h,</para>
  <para style="p">
    <verse number="50" style="v"/>yata.h sarvve ta.m d.r.s.tvaa vyaakulitaa.h| ataeva yii"sustatk.sa.na.m tai.h sahaalapya kathitavaan, susthiraa bhuuta, ayamaha.m maa bhai.s.ta|</para>
  <para style="p">
    <verse number="51" style="v"/>atha naukaamaaruhya tasmin te.saa.m sannidhi.m gate vaato niv.rtta.h; tasmaatte mana.hsu vismitaa aa"scaryya.m menire|</para>
  <para style="p">
    <verse number="52" style="v"/>yataste manasaa.m kaa.thinyaat tat puupiiyam aa"scaryya.m karmma na viviktavanta.h|</para>
  <para style="p">
    <verse number="53" style="v"/>atha te paara.m gatvaa gine.saratprade"sametya ta.ta upasthitaa.h|</para>
  <para style="p">
    <verse number="54" style="v"/>te.su naukaato bahirgate.su tatprade"siiyaa lokaasta.m paricitya</para>
  <para style="p">
    <verse number="55" style="v"/>caturdik.su dhaavanto yatra yatra rogi.no naraa aasan taan sarvvaana kha.tvopari nidhaaya yatra kutracit tadvaarttaa.m praapu.h tat sthaanam aanetum aarebhire|</para>
  <para style="p">
    <verse number="56" style="v"/>tathaa yatra yatra graame yatra yatra pure yatra yatra pallyaa nca tena prave"sa.h k.rtastadvartmamadhye lokaa.h pii.ditaan sthaapayitvaa tasya celagranthimaatra.m spra.s.tum te.saamarthe tadanuj naa.m praarthayanta.h yaavanto lokaa.h pasp.r"sustaavanta eva gadaanmuktaa.h|</para>
  <chapter number="7" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>anantara.m yiruu"saalama aagataa.h phiruu"sino.adhyaapakaa"sca yii"so.h samiipam aagataa.h|</para>
  <para style="p">
    <verse number="2" style="v"/>te tasya kiyata.h "si.syaan a"sucikarairarthaada aprak.saalitahastai rbhu njato d.r.s.tvaa taanaduu.sayan|</para>
  <para style="p">
    <verse number="3" style="v"/>yata.h phiruu"sina.h sarvvayihuudiiyaa"sca praacaa.m paramparaagatavaakya.m sammanya pratalena hastaan aprak.saalya na bhu njate|</para>
  <para style="p">
    <verse number="4" style="v"/>aapanaadaagatya majjana.m vinaa na khaadanti; tathaa paanapaatraa.naa.m jalapaatraa.naa.m pittalapaatraa.naam aasanaanaa nca jale majjanam ityaadayonyepi bahavaste.saamaacaaraa.h santi|</para>
  <para style="p">
    <verse number="5" style="v"/>te phiruu"sino.adhyaapakaa"sca yii"su.m papracchu.h, tava "si.syaa.h praacaa.m paramparaagatavaakyaanusaare.na naacaranto.aprak.saalitakarai.h kuto bhuja.mte?</para>
  <para style="p">
    <verse number="6" style="v"/>tata.h sa pratyuvaaca kapa.tino yu.smaan uddi"sya yi"sayiyabhavi.syadvaadii yuktamavaadiit| yathaa svakiiyairadharairete sammanyanate sadaiva maa.m| kintu matto viprakar.se santi te.saa.m manaa.msi ca|</para>
  <para style="p">
    <verse number="7" style="v"/>"sik.sayanto bidhiin nnaaj naa bhajante maa.m mudhaiva te|</para>
  <para style="p">
    <verse number="8" style="v"/>yuuya.m jalapaatrapaanapaatraadiini majjayanto manujaparamparaagatavaakya.m rak.satha kintu ii"svaraaj naa.m la.mghadhve; aparaa iid.r"syonekaa.h kriyaa api kurudhve|</para>
  <para style="p">
    <verse number="9" style="v"/>anya ncaakathayat yuuya.m svaparamparaagatavaakyasya rak.saartha.m spa.s.taruupe.na ii"svaraaj naa.m lopayatha|</para>
  <para style="p">
    <verse number="10" style="v"/>yato muusaadvaaraa proktamasti svapitarau sammanyadhva.m yastu maatara.m pitara.m vaa durvvaakya.m vakti sa nitaanta.m hanyataa.m|</para>
  <para style="p">
    <verse number="11" style="v"/>kintu madiiyena yena dravye.na tavopakaarobhavat tat karbbaa.namarthaad ii"svaraaya niveditam ida.m vaakya.m yadi kopi pitara.m maatara.m vaa vakti</para>
  <para style="p">
    <verse number="12" style="v"/>tarhi yuuya.m maatu.h pitu rvopakaara.m karttaa.m ta.m vaarayatha|</para>
  <para style="p">
    <verse number="13" style="v"/>ittha.m svapracaaritaparamparaagatavaakyena yuuyam ii"svaraaj naa.m mudhaa vidhadvve, iid.r"saanyanyaanyanekaani karmmaa.ni kurudhve|</para>
  <para style="p">
    <verse number="14" style="v"/>atha sa lokaanaahuuya babhaa.se yuuya.m sarvve madvaakya.m "s.r.nuta budhyadhva nca|</para>
  <para style="p">
    <verse number="15" style="v"/>baahyaadantara.m pravi"sya naramamedhya.m karttaa.m "saknoti iid.r"sa.m kimapi vastu naasti, varam antaraad bahirgata.m yadvastu tanmanujam amedhya.m karoti|</para>
  <para style="p">
    <verse number="16" style="v"/>yasya "srotu.m "srotre sta.h sa "s.r.notu|</para>
  <para style="p">
    <verse number="17" style="v"/>tata.h sa lokaan hitvaa g.rhamadhya.m pravi.s.tastadaa "si.syaastad.r.s.taantavaakyaartha.m papracchu.h|</para>
  <para style="p">
    <verse number="18" style="v"/>tasmaat sa taan jagaada yuuyamapi kimetaad.rgabodhaa.h? kimapi dravya.m baahyaadantara.m pravi"sya naramamedhya.m karttaa.m na "saknoti kathaamimaa.m ki.m na budhyadhve?</para>
  <para style="p">
    <verse number="19" style="v"/>tat tadantarna pravi"sati kintu kuk.simadhya.m pravi"sati "se.se sarvvabhuktavastugraahi.ni bahirde"se niryaati|</para>
  <para style="p">
    <verse number="20" style="v"/>aparamapyavaadiid yannaraannireti tadeva naramamedhya.m karoti|</para>
  <para style="p">
    <verse number="21" style="v"/>yato.antaraad arthaan maanavaanaa.m manobhya.h kucintaa parastriive"syaagamana.m</para>
  <para style="p">
    <verse number="22" style="v"/>naravadha"scauryya.m lobho du.s.tataa prava ncanaa kaamukataa kud.r.s.tirii"svaranindaa garvvastama ityaadiini nirgacchanti|</para>
  <para style="p">
    <verse number="23" style="v"/>etaani sarvvaa.ni duritaanyantaraadetya naramamedhya.m kurvvanti|</para>
  <para style="p">
    <verse number="24" style="v"/>atha sa utthaaya tatsthaanaat sorasiidonpuraprade"sa.m jagaama tatra kimapi nive"sana.m pravi"sya sarvvairaj naata.h sthaatu.m mati ncakre kintu gupta.h sthaatu.m na "sa"saaka|</para>
  <para style="p">
    <verse number="25" style="v"/>yata.h suraphainikiide"siiyayuunaaniiva.m"sodbhavastriyaa.h kanyaa bhuutagrastaasiit| saa strii tadvaarttaa.m praapya tatsamiipamaagatya taccara.nayo.h patitvaa</para>
  <para style="p">
    <verse number="26" style="v"/>svakanyaato bhuuta.m niraakarttaa.m tasmin vinaya.m k.rtavatii|</para>
  <para style="p">
    <verse number="27" style="v"/>kintu yii"sustaamavadat prathama.m baalakaast.rpyantu yato baalakaanaa.m khaadya.m g.rhiitvaa kukkurebhyo nik.sepo.anucita.h|</para>
  <para style="p">
    <verse number="28" style="v"/>tadaa saa strii tamavaadiit bho.h prabho tat satya.m tathaapi ma ncaadha.hsthaa.h kukkuraa baalaanaa.m karapatitaani khaadyakha.n.daani khaadanti|</para>
  <para style="p">
    <verse number="29" style="v"/>tata.h so.akathayad etatkathaaheto.h saku"salaa yaahi tava kanyaa.m tyaktvaa bhuuto gata.h|</para>
  <para style="p">
    <verse number="30" style="v"/>atha saa strii g.rha.m gatvaa kanyaa.m bhuutatyaktaa.m "sayyaasthitaa.m dadar"sa|</para>
  <para style="p">
    <verse number="31" style="v"/>puna"sca sa sorasiidonpuraprade"saat prasthaaya dikaapalide"sasya praantarabhaagena gaaliiljaladhe.h samiipa.m gatavaan|</para>
  <para style="p">
    <verse number="32" style="v"/>tadaa lokaireka.m badhira.m kadvada nca nara.m tannika.tamaaniiya tasya gaatre hastamarpayitu.m vinaya.h k.rta.h|</para>
  <para style="p">
    <verse number="33" style="v"/>tato yii"su rlokaara.nyaat ta.m nirjanamaaniiya tasya kar.nayo"ngulii rdadau ni.s.thiiva.m dattvaa ca tajjihvaa.m paspar"sa|</para>
  <para style="p">
    <verse number="34" style="v"/>anantara.m svarga.m niriik.sya diirgha.m ni"svasya tamavadat itaphata.h arthaan mukto bhuuyaat|</para>
  <para style="p">
    <verse number="35" style="v"/>tatastatk.sa.na.m tasya kar.nau muktau jihvaayaa"sca jaa.dyaapagamaat sa suspa.s.tavaakyamakathayat|</para>
  <para style="p">
    <verse number="36" style="v"/>atha sa taan vaa.dhamityaadide"sa yuuyamimaa.m kathaa.m kasmaicidapi maa kathayata, kintu sa yati nya.sedhat te tati baahulyena praacaarayan;</para>
  <para style="p">
    <verse number="37" style="v"/>te.aticamatk.rtya paraspara.m kathayaamaasu.h sa badhiraaya "srava.na"sakti.m muukaaya ca kathana"sakti.m dattvaa sarvva.m karmmottamaruupe.na cakaara|</para>
  <chapter number="8" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>tadaa tatsamiipa.m bahavo lokaa aayaataa ataste.saa.m bhojyadravyaabhaavaad yii"su.h "si.syaanaahuuya jagaada,|</para>
  <para style="p">
    <verse number="2" style="v"/>lokanivahe mama k.rpaa jaayate te dinatraya.m mayaa saarddha.m santi te.saa.m bhojya.m kimapi naasti|</para>
  <para style="p">
    <verse number="3" style="v"/>te.saa.m madhye.aneke duuraad aagataa.h, abhukte.su te.su mayaa svag.rhamabhiprahite.su te pathi klami.syanti|</para>
  <para style="p">
    <verse number="4" style="v"/>"si.syaa avaadi.su.h, etaavato lokaan tarpayitum atra prantare puupaan praaptu.m kena "sakyate?</para>
  <para style="p">
    <verse number="5" style="v"/>tata.h sa taan papraccha yu.smaaka.m kati puupaa.h santi? te.akathayan sapta|</para>
  <para style="p">
    <verse number="6" style="v"/>tata.h sa taallokaan bhuvi samupave.s.tum aadi"sya taan sapta puupaan dh.rtvaa ii"svaragu.naan anukiirttayaamaasa, bha.mktvaa parive.sayitu.m "si.syaan prati dadau, tataste lokebhya.h parive.sayaamaasu.h|</para>
  <para style="p">
    <verse number="7" style="v"/>tathaa te.saa.m samiipe ye k.sudramatsyaa aasan taanapyaadaaya ii"svaragu.naan sa.mkiirtya parive.sayitum aadi.s.tavaan|</para>
  <para style="p">
    <verse number="8" style="v"/>tato lokaa bhuktvaa t.rpti.m gataa ava"si.s.takhaadyai.h puur.naa.h sapta.dallakaa g.rhiitaa"sca|</para>
  <para style="p">
    <verse number="9" style="v"/>ete bhoktaara.h praaya"scatu.h sahasrapuru.saa aasan tata.h sa taan visasarja|</para>
  <para style="p">
    <verse number="10" style="v"/>atha sa "si.sya.h saha naavamaaruhya dalmaanuuthaasiimaamaagata.h|</para>
  <para style="p">
    <verse number="11" style="v"/>tata.h para.m phiruu"sina aagatya tena saha vivadamaanaastasya pariik.saartham aakaa"siiyacihna.m dra.s.tu.m yaacitavanta.h|</para>
  <para style="p">
    <verse number="12" style="v"/>tadaa so.antardiirgha.m ni"svasyaakathayat, ete vidyamaananaraa.h kuta"scinha.m m.rgayante? yu.smaanaha.m yathaartha.m braviimi lokaanetaan kimapi cihna.m na dar"sayi.syate|</para>
  <para style="p">
    <verse number="13" style="v"/>atha taan hitvaa puna rnaavam aaruhya paaramagaat|</para>
  <para style="p">
    <verse number="14" style="v"/>etarhi "si.syai.h puupe.su vism.rte.su naavi te.saa.m sannidhau puupa ekaeva sthita.h|</para>
  <para style="p">
    <verse number="15" style="v"/>tadaanii.m yii"sustaan aadi.s.tavaan phiruu"sinaa.m heroda"sca ki.nva.m prati satarkaa.h saavadhaanaa"sca bhavata|</para>
  <para style="p">
    <verse number="16" style="v"/>tataste.anyonya.m vivecana.m kartum aarebhire, asmaaka.m sannidhau puupo naastiiti hetorida.m kathayati|</para>
  <para style="p">
    <verse number="17" style="v"/>tad budvvaa yii"sustebhyo.akathayat yu.smaaka.m sthaane puupaabhaavaat kuta ittha.m vitarkayatha? yuuya.m kimadyaapi kimapi na jaaniitha? boddhu nca na "saknutha? yaavadadya ki.m yu.smaaka.m manaa.msi ka.thinaani santi?</para>
  <para style="p">
    <verse number="18" style="v"/>satsu netre.su ki.m na pa"syatha? satsu kar.ne.su ki.m na "s.r.nutha? na smaratha ca?</para>
  <para style="p">
    <verse number="19" style="v"/>yadaaha.m pa ncapuupaan pa ncasahasraa.naa.m puru.saa.naa.m madhye bha.mktvaa dattavaan tadaanii.m yuuyam ava"si.s.tapuupai.h puur.naan kati .dallakaan g.rhiitavanta.h? te.akathayan dvaada"sa.dallakaan|</para>
  <para style="p">
    <verse number="20" style="v"/>apara nca yadaa catu.hsahasraa.naa.m puru.saa.naa.m madhye puupaan bha.mktvaadadaa.m tadaa yuuyam atiriktapuupaanaa.m kati .dallakaan g.rhiitavanta.h? te kathayaamaasu.h sapta.dallakaan|</para>
  <para style="p">
    <verse number="21" style="v"/>tadaa sa kathitavaan tarhi yuuyam adhunaapi kuto bodvvu.m na "saknutha?</para>
  <para style="p">
    <verse number="22" style="v"/>anantara.m tasmin baitsaidaanagare praapte lokaa andhameka.m nara.m tatsamiipamaaniiya ta.m spra.s.tu.m ta.m praarthayaa ncakrire|</para>
  <para style="p">
    <verse number="23" style="v"/>tadaa tasyaandhasya karau g.rhiitvaa nagaraad bahirde"sa.m ta.m niitavaan; tannetre ni.s.thiiva.m dattvaa tadgaatre hastaavarpayitvaa ta.m papraccha, kimapi pa"syasi?</para>
  <para style="p">
    <verse number="24" style="v"/>sa netre unmiilya jagaada, v.rk.savat manujaan gacchato niriik.se|</para>
  <para style="p">
    <verse number="25" style="v"/>tato yii"su.h punastasya nayanayo rhastaavarpayitvaa tasya netre unmiilayaamaasa; tasmaat sa svastho bhuutvaa spa.s.taruupa.m sarvvalokaan dadar"sa|</para>
  <para style="p">
    <verse number="26" style="v"/>tata.h para.m tva.m graama.m maa gaccha graamastha.m kamapi ca kimapyanuktvaa nijag.rha.m yaahiityaadi"sya yii"susta.m nijag.rha.m prahitavaan|</para>
  <para style="p">
    <verse number="27" style="v"/>anantara.m "si.syai.h sahito yii"su.h kaisariiyaaphilipipura.m jagaama, pathi gacchan taanap.rcchat ko.aham atra lokaa.h ki.m vadanti?</para>
  <para style="p">
    <verse number="28" style="v"/>te pratyuucu.h tvaa.m yohana.m majjaka.m vadanti kintu kepi kepi eliya.m vadanti; apare kepi kepi bhavi.syadvaadinaam eko jana iti vadanti|</para>
  <para style="p">
    <verse number="29" style="v"/>atha sa taanap.rcchat kintu koham? ityatra yuuya.m ki.m vadatha? tadaa pitara.h pratyavadat bhavaan abhi.siktastraataa|</para>
  <para style="p">
    <verse number="30" style="v"/>tata.h sa taan gaa.dhamaadi"sad yuuya.m mama kathaa kasmaicidapi maa kathayata|</para>
  <para style="p">
    <verse number="31" style="v"/>manu.syaputre.naava"sya.m bahavo yaatanaa bhoktavyaa.h praaciinalokai.h pradhaanayaajakairadhyaapakai"sca sa nindita.h san ghaatayi.syate t.rtiiyadine utthaasyati ca, yii"su.h "si.syaanupade.s.tumaarabhya kathaamimaa.m spa.s.tamaaca.s.ta|</para>
  <para style="p">
    <verse number="32" style="v"/>tasmaat pitarastasya hastau dh.rtvaa ta.m tarjjitavaan|</para>
  <para style="p">
    <verse number="33" style="v"/>kintu sa mukha.m paraavartya "si.syaga.na.m niriik.sya pitara.m tarjayitvaavaadiid duuriibhava vighnakaarin ii"svariiyakaaryyaadapi manu.syakaaryya.m tubhya.m rocatataraa.m|</para>
  <para style="p">
    <verse number="34" style="v"/>atha sa lokaan "si.syaa.m"scaahuuya jagaada ya.h ka"scin maamanugantum icchati sa aatmaana.m daamyatu, svakru"sa.m g.rhiitvaa matpa"scaad aayaatu|</para>
  <para style="p">
    <verse number="35" style="v"/>yato ya.h ka"scit svapraa.na.m rak.situmicchati sa ta.m haarayi.syati, kintu ya.h ka"scin madartha.m susa.mvaadaartha nca praa.na.m haarayati sa ta.m rak.si.syati|</para>
  <para style="p">
    <verse number="36" style="v"/>apara nca manuja.h sarvva.m jagat praapya yadi svapraa.na.m haarayati tarhi tasya ko laabha.h?</para>
  <para style="p">
    <verse number="37" style="v"/>nara.h svapraa.navinimayena ki.m daatu.m "saknoti?</para>
  <para style="p">
    <verse number="38" style="v"/>ete.saa.m vyabhicaari.naa.m paapinaa nca lokaanaa.m saak.saad yadi kopi maa.m matkathaa nca lajjaaspada.m jaanaati tarhi manujaputro yadaa dharmmaduutai.h saha pitu.h prabhaave.naagami.syati tadaa sopi ta.m lajjaaspada.m j naasyati|</para>
  <chapter number="9" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>atha sa taanavaadiit yu.smabhyamaha.m yathaartha.m kathayaami, ii"svararaajya.m paraakrame.nopasthita.m na d.r.s.tvaa m.rtyu.m naasvaadi.syante, atra da.n.daayamaanaanaa.m madhyepi taad.r"saa lokaa.h santi|</para>
  <para style="p">
    <verse number="2" style="v"/>atha .sa.ddinebhya.h para.m yii"su.h pitara.m yaakuuba.m yohana nca g.rhiitvaa gireruccasya nirjanasthaana.m gatvaa te.saa.m pratyak.se muurtyantara.m dadhaara|</para>
  <para style="p">
    <verse number="3" style="v"/>tatastasya paridheyam iid.r"sam ujjvalahimapaa.na.dara.m jaata.m yad jagati kopi rajako na taad.rk paa.na.dara.m karttaa.m "saknoti|</para>
  <para style="p">
    <verse number="4" style="v"/>apara nca eliyo muusaa"sca tebhyo dar"sana.m dattvaa yii"sunaa saha kathana.m karttumaarebhaate|</para>
  <para style="p">
    <verse number="5" style="v"/>tadaa pitaro yii"sumavaadiit he guro.asmaakamatra sthitiruttamaa, tataeva vaya.m tvatk.rte ekaa.m muusaak.rte ekaam eliyak.rte caikaa.m, etaastisra.h ku.tii rnirmmaama|</para>
  <para style="p">
    <verse number="6" style="v"/>kintu sa yaduktavaan tat svaya.m na bubudhe tata.h sarvve bibhayaa ncakru.h|</para>
  <para style="p">
    <verse number="7" style="v"/>etarhi payodastaan chaadayaamaasa, mamayaa.m priya.h putra.h kathaasu tasya manaa.msi nive"sayateti nabhovaa.nii tanmedyaanniryayau|</para>
  <para style="p">
    <verse number="8" style="v"/>atha ha.thaatte caturdi"so d.r.s.tvaa yii"su.m vinaa svai.h sahita.m kamapi na dad.r"su.h|</para>
  <para style="p">
    <verse number="9" style="v"/>tata.h para.m gireravaroha.nakaale sa taan gaa.dham duutyaadide"sa yaavannarasuuno.h "sma"saanaadutthaana.m na bhavati, taavat dar"sanasyaasya vaarttaa yu.smaabhi.h kasmaicidapi na vaktavyaa|</para>
  <para style="p">
    <verse number="10" style="v"/>tadaa "sma"saanaadutthaanasya kobhipraaya iti vicaaryya te tadvaakya.m sve.su gopaayaa ncakrire|</para>
  <para style="p">
    <verse number="11" style="v"/>atha te yii"su.m papracchu.h prathamata eliyenaagantavyam iti vaakya.m kuta upaadhyaayaa aahu.h?</para>
  <para style="p">
    <verse number="12" style="v"/>tadaa sa pratyuvaaca , eliya.h prathamametya sarvvakaaryyaa.ni saadhayi.syati; naraputre ca lipi ryathaaste tathaiva sopi bahudu.hkha.m praapyaavaj naasyate|</para>
  <para style="p">
    <verse number="13" style="v"/>kintvaha.m yu.smaan vadaami , eliyaarthe lipi ryathaaste tathaiva sa etya yayau, lokaa: svecchaanuruupa.m tamabhivyavaharanti sma|</para>
  <para style="p">
    <verse number="14" style="v"/>anantara.m sa "si.syasamiipametya te.saa.m catu.hpaar"sve tai.h saha bahujanaan vivadamaanaan adhyaapakaa.m"sca d.r.s.tavaan;</para>
  <para style="p">
    <verse number="15" style="v"/>kintu sarvvalokaasta.m d.r.s.tvaiva camatk.rtya tadaasanna.m dhaavantasta.m pra.nemu.h|</para>
  <para style="p">
    <verse number="16" style="v"/>tadaa yii"suradhyaapakaanapraak.siid etai.h saha yuuya.m ki.m vivadadhve?</para>
  <para style="p">
    <verse number="17" style="v"/>tato lokaanaa.m ka"scideka.h pratyavaadiit he guro mama suunu.m muuka.m bhuutadh.rta nca bhavadaasannam aanaya.m|</para>
  <para style="p">
    <verse number="18" style="v"/>yadaasau bhuutastamaakramate tadaiva paatasati tathaa sa phe.naayate, dantairdantaan ghar.sati k.sii.no bhavati ca; tato hetosta.m bhuuta.m tyaajayitu.m bhavacchi.syaan niveditavaan kintu te na "seku.h|</para>
  <para style="p">
    <verse number="19" style="v"/>tadaa sa tamavaadiit, re avi"svaasina.h santaanaa yu.smaabhi.h saha kati kaalaanaha.m sthaasyaami? aparaan kati kaalaan vaa va aacaaraan sahi.sye? ta.m madaasannamaanayata|</para>
  <para style="p">
    <verse number="20" style="v"/>tatastatsannidhi.m sa aaniiyata kintu ta.m d.r.s.tvaiva bhuuto baalaka.m dh.rtavaan; sa ca bhuumau patitvaa phe.naayamaano lulo.tha|</para>
  <para style="p">
    <verse number="21" style="v"/>tadaa sa tatpitara.m papraccha, asyed.r"sii da"saa kati dinaani bhuutaa? tata.h sovaadiit baalyakaalaat|</para>
  <para style="p">
    <verse number="22" style="v"/>bhuutoya.m ta.m naa"sayitu.m bahuvaaraan vahnau jale ca nyak.sipat kintu yadi bhavaana kimapi karttaa.m "saknoti tarhi dayaa.m k.rtvaasmaan upakarotu|</para>
  <para style="p">
    <verse number="23" style="v"/>tadaa yii"sustamavadat yadi pratyetu.m "sakno.si tarhi pratyayine janaaya sarvva.m saadhyam|</para>
  <para style="p">
    <verse number="24" style="v"/>tatastatk.sa.na.m tadbaalakasya pitaa proccai ruuvan saa"srunetra.h provaaca, prabho pratyemi mamaapratyaya.m pratikuru|</para>
  <para style="p">
    <verse number="25" style="v"/>atha yii"su rlokasa"ngha.m dhaavitvaayaanta.m d.r.s.tvaa tamapuutabhuuta.m tarjayitvaa jagaada, re badhira muuka bhuuta tvametasmaad bahirbhava puna.h kadaapi maa"srayaina.m tvaamaham ityaadi"saami|</para>
  <para style="p">
    <verse number="26" style="v"/>tadaa sa bhuuta"sciit"sabda.m k.rtvaa tamaapii.dya bahirjajaama, tato baalako m.rtakalpo babhuuva tasmaadaya.m m.rta_ityaneke kathayaamaasu.h|</para>
  <para style="p">
    <verse number="27" style="v"/>kintu kara.m dh.rtvaa yii"sunotthaapita.h sa uttasthau|</para>
  <para style="p">
    <verse number="28" style="v"/>atha yii"sau g.rha.m pravi.s.te "si.syaa gupta.m ta.m papracchu.h, vayamena.m bhuuta.m tyaajayitu.m kuto na "saktaa.h?</para>
  <para style="p">
    <verse number="29" style="v"/>sa uvaaca, praarthanopavaasau vinaa kenaapyanyena karmma.naa bhuutamiid.r"sa.m tyaajayitu.m na "sakya.m|</para>
  <para style="p">
    <verse number="30" style="v"/>anantara.m sa tatsthaanaaditvaa gaaliilmadhyena yayau, kintu tat kopi jaaniiyaaditi sa naicchat|</para>
  <para style="p">
    <verse number="31" style="v"/>apara nca sa "si.syaanupadi"san babhaa.se, naraputro narahaste.su samarpayi.syate te ca ta.m hani.syanti taistasmin hate t.rtiiyadine sa utthaasyatiiti|</para>
  <para style="p">
    <verse number="32" style="v"/>kintu tatkathaa.m te naabudhyanta pra.s.tu nca bibhya.h|</para>
  <para style="p">
    <verse number="33" style="v"/>atha yii"su.h kapharnaahuumpuramaagatya madhyeg.rha ncetya taanap.rcchad vartmamadhye yuuyamanyonya.m ki.m vivadadhve sma?</para>
  <para style="p">
    <verse number="34" style="v"/>kintu te niruttaraastasthu ryasmaatte.saa.m ko mukhya iti vartmaani te.anyonya.m vyavadanta|</para>
  <para style="p">
    <verse number="35" style="v"/>tata.h sa upavi"sya dvaada"sa"si.syaan aahuuya babhaa.se ya.h ka"scit mukhyo bhavitumicchati sa sarvvebhyo gau.na.h sarvve.saa.m sevaka"sca bhavatu|</para>
  <para style="p">
    <verse number="36" style="v"/>tadaa sa baalakameka.m g.rhiitvaa madhye samupaave"sayat tatasta.m kro.de k.rtvaa taanavaadaat</para>
  <para style="p">
    <verse number="37" style="v"/>ya.h ka"scidiid.r"sasya kasyaapi baalasyaatithya.m karoti sa mamaatithya.m karoti; ya.h ka"scinmamaatithya.m karoti sa kevalam mamaatithya.m karoti tanna matprerakasyaapyaatithya.m karoti|</para>
  <para style="p">
    <verse number="38" style="v"/>atha yohan tamabraviit he guro, asmaakamananugaaminam eka.m tvaannaamnaa bhuutaan tyaajayanta.m vaya.m d.r.s.tavanta.h, asmaakamapa"scaadgaamitvaacca ta.m nya.sedhaama|</para>
  <para style="p">
    <verse number="39" style="v"/>kintu yii"suravadat ta.m maa ni.sedhat, yato ya.h ka"scin mannaamnaa citra.m karmma karoti sa sahasaa maa.m ninditu.m na "saknoti|</para>
  <para style="p">
    <verse number="40" style="v"/>tathaa ya.h ka"scid yu.smaaka.m vipak.sataa.m na karoti sa yu.smaakameva sapak.sa.h|</para>
  <para style="p">
    <verse number="41" style="v"/>ya.h ka"scid yu.smaan khrii.s.ta"si.syaan j naatvaa mannaamnaa ka.msaikena paaniiya.m paatu.m dadaati, yu.smaanaha.m yathaartha.m vacmi, sa phalena va ncito na bhavi.syati|</para>
  <para style="p">
    <verse number="42" style="v"/>kintu yadi ka"scin mayi vi"svaasinaame.saa.m k.sudrapraa.ninaam ekasyaapi vighna.m janayati, tarhi tasyaitatkarmma kara.naat ka.n.thabaddhape.sa.niikasya tasya saagaraagaadhajala majjana.m bhadra.m|</para>
  <para style="p">
    <verse number="43" style="v"/>ata.h svakaro yadi tvaa.m baadhate tarhi ta.m chindhi;</para>
  <para style="p">
    <verse number="44" style="v"/>yasmaat yatra kii.taa na mriyante vahni"sca na nirvvaati, tasmin anirvvaa.naanalanarake karadvayavastava gamanaat karahiinasya svargaprave"sastava k.sema.m|</para>
  <para style="p">
    <verse number="45" style="v"/>yadi tava paado vighna.m janayati tarhi ta.m chindhi,</para>
  <para style="p">
    <verse number="46" style="v"/>yato yatra kii.taa na mriyante vahni"sca na nirvvaati, tasmin .anirvvaa.navahnau narake dvipaadavatastava nik.sepaat paadahiinasya svargaprave"sastava k.sema.m|</para>
  <para style="p">
    <verse number="47" style="v"/>svanetra.m yadi tvaa.m baadhate tarhi tadapyutpaa.taya, yato yatra kii.taa na mriyante vahni"sca na nirvvaati,</para>
  <para style="p">
    <verse number="48" style="v"/>tasmina .anirvvaa.navahnau narake dvinetrasya tava nik.sepaad ekanetravata ii"svararaajye prave"sastava k.sema.m|</para>
  <para style="p">
    <verse number="49" style="v"/>yathaa sarvvo bali rlava.naakta.h kriyate tathaa sarvvo jano vahniruupe.na lava.naakta.h kaari.syate|</para>
  <para style="p">
    <verse number="50" style="v"/>lava.na.m bhadra.m kintu yadi lava.ne svaadutaa na ti.s.thati, tarhi katham aasvaadyukta.m kari.syatha? yuuya.m lava.nayuktaa bhavata paraspara.m prema kuruta|</para>
  <chapter number="10" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>anantara.m sa tatsthaanaat prasthaaya yarddananadyaa.h paare yihuudaaprade"sa upasthitavaan, tatra tadantike lokaanaa.m samaagame jaate sa nijariityanusaare.na punastaan upadide"sa|</para>
  <para style="p">
    <verse number="2" style="v"/>tadaa phiruu"sinastatsamiipam etya ta.m pariik.situ.m papraccha.h svajaayaa manujaanaa.m tyajyaa na veti?</para>
  <para style="p">
    <verse number="3" style="v"/>tata.h sa pratyavaadiit, atra kaaryye muusaa yu.smaan prati kimaaj naapayat?</para>
  <para style="p">
    <verse number="4" style="v"/>ta uucu.h tyaagapatra.m lekhitu.m svapatnii.m tyaktu nca muusaa.anumanyate|</para>
  <para style="p">
    <verse number="5" style="v"/>tadaa yii"su.h pratyuvaaca, yu.smaaka.m manasaa.m kaa.thinyaaddheto rmuusaa nide"samimam alikhat|</para>
  <para style="p">
    <verse number="6" style="v"/>kintu s.r.s.teraadau ii"svaro naraan pu.mruupe.na striiruupe.na ca sasarja|</para>
  <para style="p">
    <verse number="7" style="v"/>"tata.h kaara.naat pumaan pitara.m maatara nca tyaktvaa svajaayaayaam aasakto bhavi.syati,</para>
  <para style="p">
    <verse number="8" style="v"/>tau dvaav ekaa"ngau bhavi.syata.h|" tasmaat tatkaalamaarabhya tau na dvaav ekaa"ngau|</para>
  <para style="p">
    <verse number="9" style="v"/>ata.h kaara.naad ii"svaro yadayojayat kopi narastanna viyejayet|</para>
  <para style="p">
    <verse number="10" style="v"/>atha yii"su rg.rha.m pravi.s.tastadaa "si.syaa.h punastatkathaa.m ta.m papracchu.h|</para>
  <para style="p">
    <verse number="11" style="v"/>tata.h sovadat ka"scid yadi svabhaaryyaa.m tyaktavaanyaam udvahati tarhi sa svabhaaryyaayaa.h praatikuulyena vyabhicaarii bhavati|</para>
  <para style="p">
    <verse number="12" style="v"/>kaacinnaarii yadi svapati.m hitvaanyapu.msaa vivaahitaa bhavati tarhi saapi vyabhicaari.nii bhavati|</para>
  <para style="p">
    <verse number="13" style="v"/>atha sa yathaa "si"suun sp.r"set, tadartha.m lokaistadantika.m "si"sava aaniiyanta, kintu "si.syaastaanaaniitavatastarjayaamaasu.h|</para>
  <para style="p">
    <verse number="14" style="v"/>yii"sustad d.r.s.tvaa krudhyan jagaada, mannika.tam aagantu.m "si"suun maa vaarayata, yata etaad.r"saa ii"svararaajyaadhikaari.na.h|</para>
  <para style="p">
    <verse number="15" style="v"/>yu.smaanaha.m yathaartha.m vacmi, ya.h ka"scit "si"suvad bhuutvaa raajyamii"svarasya na g.rhliiyaat sa kadaapi tadraajya.m prave.s.tu.m na "saknoti|</para>
  <para style="p">
    <verse number="16" style="v"/>ananatara.m sa "si"suuna"nke nidhaaya te.saa.m gaatre.su hastau dattvaa"si.sa.m babhaa.se|</para>
  <para style="p">
    <verse number="17" style="v"/>atha sa vartmanaa yaati, etarhi jana eko dhaavan aagatya tatsammukhe jaanunii paatayitvaa p.r.s.tavaan, bho.h paramaguro, anantaayu.h praaptaye mayaa ki.m karttavya.m?</para>
  <para style="p">
    <verse number="18" style="v"/>tadaa yii"suruvaaca, maa.m parama.m kuto vadasi? vine"svara.m kopi paramo na bhavati|</para>
  <para style="p">
    <verse number="19" style="v"/>parastrii.m naabhigaccha; nara.m maa ghaataya; steya.m maa kuru; m.r.saasaak.sya.m maa dehi; hi.msaa nca maa kuru; pitarau sammanyasva; nide"saa ete tvayaa j naataa.h|</para>
  <para style="p">
    <verse number="20" style="v"/>tatastana pratyukta.m, he guro baalyakaalaadaha.m sarvvaanetaan aacaraami|</para>
  <para style="p">
    <verse number="21" style="v"/>tadaa yii"susta.m vilokya snehena babhaa.se, tavaikasyaabhaava aaste; tva.m gatvaa sarvvasva.m vikriiya daridrebhyo vi"sraa.naya, tata.h svarge dhana.m praapsyasi; tata.h param etya kru"sa.m vahan madanuvarttii bhava|</para>
  <para style="p">
    <verse number="22" style="v"/>kintu tasya bahusampadvidyamaanatvaat sa imaa.m kathaamaakar.nya vi.sa.no du.hkhita"sca san jagaama|</para>
  <para style="p">
    <verse number="23" style="v"/>atha yii"su"scaturdi"so niriik.sya "si.syaan avaadiit, dhanilokaanaam ii"svararaajyaprave"sa.h kiid.rg du.skara.h|</para>
  <para style="p">
    <verse number="24" style="v"/>tasya kathaata.h "si.syaa"scamaccakru.h, kintu sa punaravadat, he baalakaa ye dhane vi"svasanti te.saam ii"svararaajyaprave"sa.h kiid.rg du.skara.h|</para>
  <para style="p">
    <verse number="25" style="v"/>ii"svararaajye dhaninaa.m prave"saat suucirandhre.na mahaa"ngasya gamanaagamana.m sukara.m|</para>
  <para style="p">
    <verse number="26" style="v"/>tadaa "si.syaa atiiva vismitaa.h paraspara.m procu.h, tarhi ka.h paritraa.na.m praaptu.m "saknoti?</para>
  <para style="p">
    <verse number="27" style="v"/>tato yii"sustaan vilokya babhaa.se, tan narasyaasaadhya.m kintu ne"svarasya, yato hetorii"svarasya sarvva.m saadhyam|</para>
  <para style="p">
    <verse number="28" style="v"/>tadaa pitara uvaaca, pa"sya vaya.m sarvva.m parityajya bhavatonugaamino jaataa.h|</para>
  <para style="p">
    <verse number="29" style="v"/>tato yii"su.h pratyavadat, yu.smaanaha.m yathaartha.m vadaami, madartha.m susa.mvaadaartha.m vaa yo jana.h sadana.m bhraatara.m bhaginii.m pitara.m maatara.m jaayaa.m santaanaan bhuumi vaa tyaktvaa</para>
  <para style="p">
    <verse number="30" style="v"/>g.rhabhraat.rbhaginiipit.rmaat.rpatniisantaanabhuumiinaamiha "satagu.naan pretyaanantaayu"sca na praapnoti taad.r"sa.h kopi naasti|</para>
  <para style="p">
    <verse number="31" style="v"/>kintvagriiyaa aneke lokaa.h "se.saa.h, "se.siiyaa aneke lokaa"scaagraa bhavi.syanti|</para>
  <para style="p">
    <verse number="32" style="v"/>atha yiruu"saalamyaanakaale yii"suste.saam agragaamii babhuuva, tasmaatte citra.m j naatvaa pa"scaadgaamino bhuutvaa bibhyu.h| tadaa sa puna rdvaada"sa"si.syaan g.rhiitvaa sviiya.m yadyad gha.ti.syate tattat tebhya.h kathayitu.m praarebhe;</para>
  <para style="p">
    <verse number="33" style="v"/>pa"syata vaya.m yiruu"saalampura.m yaama.h, tatra manu.syaputra.h pradhaanayaajakaanaam upaadhyaayaanaa nca kare.su samarpayi.syate; te ca vadhada.n.daaj naa.m daapayitvaa parade"siiyaanaa.m kare.su ta.m samarpayi.syanti|</para>
  <para style="p">
    <verse number="34" style="v"/>te tamupahasya ka"sayaa prah.rtya tadvapu.si ni.s.thiiva.m nik.sipya ta.m hani.syanti, tata.h sa t.rtiiyadine protthaasyati|</para>
  <para style="p">
    <verse number="35" style="v"/>tata.h sivade.h putrau yaakuubyohanau tadantikam etya procatu.h, he guro yad aavaabhyaa.m yaaci.syate tadasmadartha.m bhavaan karotu nivedanamidamaavayo.h|</para>
  <para style="p">
    <verse number="36" style="v"/>tata.h sa kathitavaan, yuvaa.m kimicchatha.h? ki.m mayaa yu.smadartha.m kara.niiya.m?</para>
  <para style="p">
    <verse number="37" style="v"/>tadaa tau procatu.h, aavayoreka.m dak.si.napaar"sve vaamapaar"sve caika.m tavai"svaryyapade samupave.s.tum aaj naapaya|</para>
  <para style="p">
    <verse number="38" style="v"/>kintu yii"su.h pratyuvaaca yuvaamaj naatveda.m praarthayethe, yena ka.msenaaha.m paasyaami tena yuvaabhyaa.m ki.m paatu.m "sak.syate? yasmin majjanenaaha.m majji.sye tanmajjane majjayitu.m ki.m yuvaabhyaa.m "sak.syate? tau pratyuucatu.h "sak.syate|</para>
  <para style="p">
    <verse number="39" style="v"/>tadaa yii"suravadat yena ka.msenaaha.m paasyaami tenaava"sya.m yuvaamapi paasyatha.h, yena majjanena caaha.m majjiyye tatra yuvaamapi majji.syethe|</para>
  <para style="p">
    <verse number="40" style="v"/>kintu ye.saamartham ida.m niruupita.m, taan vihaayaanya.m kamapi mama dak.si.napaar"sve vaamapaar"sve vaa samupave"sayitu.m mamaadhikaaro naasti|</para>
  <para style="p">
    <verse number="41" style="v"/>athaanyada"sa"si.syaa imaa.m kathaa.m "srutvaa yaakuubyohanbhyaa.m cukupu.h|</para>
  <para style="p">
    <verse number="42" style="v"/>kintu yii"sustaan samaahuuya babhaa.se, anyade"siiyaanaa.m raajatva.m ye kurvvanti te te.saameva prabhutva.m kurvvanti, tathaa ye mahaalokaaste te.saam adhipatitva.m kurvvantiiti yuuya.m jaaniitha|</para>
  <para style="p">
    <verse number="43" style="v"/>kintu yu.smaaka.m madhye na tathaa bhavi.syati, yu.smaaka.m madhye ya.h praadhaanya.m vaa nchati sa yu.smaaka.m sevako bhavi.syati,</para>
  <para style="p">
    <verse number="44" style="v"/>yu.smaaka.m yo mahaan bhavitumicchati sa sarvve.saa.m ki"nkaro bhavi.syati|</para>
  <para style="p">
    <verse number="45" style="v"/>yato manu.syaputra.h sevyo bhavitu.m naagata.h sevaa.m karttaa.m tathaaneke.saa.m paritraa.nasya muulyaruupasvapraa.na.m daatu ncaagata.h|</para>
  <para style="p">
    <verse number="46" style="v"/>atha te yiriihonagara.m praaptaastasmaat "si.syai rlokai"sca saha yii"so rgamanakaale .tiimayasya putro bar.tiimayanaamaa andhastanmaargapaar"sve bhik.saartham upavi.s.ta.h|</para>
  <para style="p">
    <verse number="47" style="v"/>sa naasaratiiyasya yii"soraagamanavaarttaa.m praapya procai rvaktumaarebhe, he yii"so daayuuda.h santaana maa.m dayasva|</para>
  <para style="p">
    <verse number="48" style="v"/>tatoneke lokaa mauniibhaveti ta.m tarjayaamaasu.h, kintu sa punaradhikamuccai rjagaada, he yii"so daayuuda.h santaana maa.m dayasva|</para>
  <para style="p">
    <verse number="49" style="v"/>tadaa yii"su.h sthitvaa tamaahvaatu.m samaadide"sa, tato lokaastamandhamaahuuya babhaa.sire, he nara, sthiro bhava, utti.s.tha, sa tvaamaahvayati|</para>
  <para style="p">
    <verse number="50" style="v"/>tadaa sa uttariiyavastra.m nik.sipya protthaaya yii"so.h samiipa.m gata.h|</para>
  <para style="p">
    <verse number="51" style="v"/>tato yii"sustamavadat tvayaa ki.m praarthyate? tubhyamaha.m ki.m kari.syaamii? tadaa sondhastamuvaaca, he guro madiiyaa d.r.s.tirbhavet|</para>
  <para style="p">
    <verse number="52" style="v"/>tato yii"sustamuvaaca yaahi tava vi"svaasastvaa.m svasthamakaar.siit, tasmaat tatk.sa.na.m sa d.r.s.ti.m praapya pathaa yii"so.h pa"scaad yayau|</para>
  <chapter number="11" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>anantara.m te.su yiruu"saalama.h samiipasthayo rbaitphagiibaithaniiyapurayorantikastha.m jaitunanaamaadrimaagate.su yii"su.h pre.sa.nakaale dvau "si.syaavida.m vaakya.m jagaada,</para>
  <para style="p">
    <verse number="2" style="v"/>yuvaamamu.m sammukhastha.m graama.m yaata.m, tatra pravi"sya yo nara.m naavahat ta.m garddabha"saavaka.m drak.syathasta.m mocayitvaanayata.m|</para>
  <para style="p">
    <verse number="3" style="v"/>kintu yuvaa.m karmmeda.m kuta.h kurutha.h? kathaamimaa.m yadi kopi p.rcchati tarhi prabhoratra prayojanamastiiti kathite sa "siighra.m tamatra pre.sayi.syati|</para>
  <para style="p">
    <verse number="4" style="v"/>tatastau gatvaa dvimaargamelane kasyacid dvaarasya paar"sve ta.m garddabha"saavaka.m praapya mocayata.h,</para>
  <para style="p">
    <verse number="5" style="v"/>etarhi tatropasthitalokaanaa.m ka"scid ap.rcchat, garddabha"si"su.m kuto mocayatha.h?</para>
  <para style="p">
    <verse number="6" style="v"/>tadaa yii"soraaj naanusaare.na tebhya.h pratyudite tatk.sa.na.m tamaadaatu.m te.anujaj nu.h|</para>
  <para style="p">
    <verse number="7" style="v"/>atha tau yii"so.h sannidhi.m garddabha"si"sum aaniiya tadupari svavastraa.ni paatayaamaasatu.h; tata.h sa tadupari samupavi.s.ta.h|</para>
  <para style="p">
    <verse number="8" style="v"/>tadaaneke pathi svavaasaa.msi paatayaamaasu.h, parai"sca taru"saakhaa"schitavaa maarge vikiir.naa.h|</para>
  <para style="p">
    <verse number="9" style="v"/>apara nca pa"scaadgaamino.agragaamina"sca sarvve janaa ucai.hsvare.na vaktumaarebhire, jaya jaya ya.h parame"svarasya naamnaagacchati sa dhanya iti|</para>
  <para style="p">
    <verse number="10" style="v"/>tathaasmaakama.m puurvvapuru.sasya daayuudo yadraajya.m parame"svaranaamnaayaati tadapi dhanya.m, sarvvasmaaducchraaye svarge ii"svarasya jayo bhavet|</para>
  <para style="p">
    <verse number="11" style="v"/>ittha.m yii"su ryiruu"saalami mandira.m pravi"sya caturdiksthaani sarvvaa.ni vastuuni d.r.s.tavaan; atha saaya.mkaala upasthite dvaada"sa"si.syasahito baithaniya.m jagaama|</para>
  <para style="p">
    <verse number="12" style="v"/>aparehani baithaniyaad aagamanasamaye k.sudhaartto babhuuva|</para>
  <para style="p">
    <verse number="13" style="v"/>tato duure sapatramu.dumbarapaadapa.m vilokya tatra ki ncit phala.m praaptu.m tasya sannik.r.s.ta.m yayau, tadaanii.m phalapaatanasya samayo naagacchati| tatastatropasthita.h patraa.ni vinaa kimapyapara.m na praapya sa kathitavaan,</para>
  <para style="p">
    <verse number="14" style="v"/>adyaarabhya kopi maanavastvatta.h phala.m na bhu njiita; imaa.m kathaa.m tasya "si.syaa.h "su"sruvu.h|</para>
  <para style="p">
    <verse number="15" style="v"/>tadanantara.m te.su yiruu"saalamamaayaate.su yii"su rmandira.m gatvaa tatrasthaanaa.m ba.nijaa.m mudraasanaani paaraavatavikret.r.naam aasanaani ca nyubjayaa ncakaara sarvvaan kret.rn vikret.r.m"sca bahi"scakaara|</para>
  <para style="p">
    <verse number="16" style="v"/>apara.m mandiramadhyena kimapi paatra.m vo.dhu.m sarvvajana.m nivaarayaamaasa|</para>
  <para style="p">
    <verse number="17" style="v"/>lokaanupadi"san jagaada, mama g.rha.m sarvvajaatiiyaanaa.m praarthanaag.rham iti naamnaa prathita.m bhavi.syati etat ki.m "saastre likhita.m naasti? kintu yuuya.m tadeva coraa.naa.m gahvara.m kurutha|</para>
  <para style="p">
    <verse number="18" style="v"/>imaa.m vaa.nii.m "srutvaadhyaapakaa.h pradhaanayaajakaa"sca ta.m yathaa naa"sayitu.m "saknuvanti tathoेpaaya.m m.rgayaamaasu.h, kintu tasyopade"saat sarvve lokaa vismaya.m gataa ataste tasmaad bibhyu.h|</para>
  <para style="p">
    <verse number="19" style="v"/>atha saaya.msamaya upasthite yii"surnagaraad bahirvavraaja|</para>
  <para style="p">
    <verse number="20" style="v"/>anantara.m praata.hkaale te tena maarge.na gacchantastamu.dumbaramahiiruha.m samuula.m "su.ska.m dad.r"su.h|</para>
  <para style="p">
    <verse number="21" style="v"/>tata.h pitara.h puurvvavaakya.m smaran yii"su.m babhaa.sa.m, he guro pa"syatu ya u.dumbaravi.tapii bhavataa "sapta.h sa "su.sko babhuuva|</para>
  <para style="p">
    <verse number="22" style="v"/>tato yii"su.h pratyavaadiit, yuuyamii"svare vi"svasita|</para>
  <para style="p">
    <verse number="23" style="v"/>yu.smaanaha.m yathaartha.m vadaami kopi yadyetadgiri.m vadati, tvamutthaaya gatvaa jaladhau pata, proktamida.m vaakyamava"sya.m gha.ti.syate, manasaa kimapi na sandihya cedida.m vi"svaset tarhi tasya vaakyaanusaare.na tad gha.ti.syate|</para>
  <para style="p">
    <verse number="24" style="v"/>ato hetoraha.m yu.smaan vacmi, praarthanaakaale yadyadaakaa.mk.si.syadhve tattadava"sya.m praapsyatha, ittha.m vi"svasita, tata.h praapsyatha|</para>
  <para style="p">
    <verse number="25" style="v"/>apara nca yu.smaasu praarthayitu.m samutthite.su yadi kopi yu.smaakam aparaadhii ti.s.thati, tarhi ta.m k.samadhva.m, tathaa k.rte yu.smaaka.m svargastha.h pitaapi yu.smaakamaagaa.mmi k.sami.syate|</para>
  <para style="p">
    <verse number="26" style="v"/>kintu yadi na k.samadhve tarhi va.h svargastha.h pitaapi yu.smaakamaagaa.msi na k.sami.syate|</para>
  <para style="p">
    <verse number="27" style="v"/>anantara.m te puna ryiruu"saalama.m pravivi"su.h, yii"su ryadaa madhyemandiram itastato gacchati, tadaanii.m pradhaanayaajakaa upaadhyaayaa.h praa nca"sca tadantikametya kathaamimaa.m papracchu.h,</para>
  <para style="p">
    <verse number="28" style="v"/>tva.m kenaade"sena karmmaa.nyetaani karo.si? tathaitaani karmmaa.ni karttaa.m kenaadi.s.tosi?</para>
  <para style="p">
    <verse number="29" style="v"/>tato yii"su.h pratigaditavaan ahamapi yu.smaan ekakathaa.m p.rcchaami, yadi yuuya.m tasyaa uttara.m kurutha, tarhi kayaaj nayaaha.m karmmaa.nyetaani karomi tad yu.smabhya.m kathayi.syaami|</para>
  <para style="p">
    <verse number="30" style="v"/>yohano majjanam ii"svaraat jaata.m ki.m maanavaat? tanmahya.m kathayata|</para>
  <para style="p">
    <verse number="31" style="v"/>te paraspara.m vivektu.m praarebhire, tad ii"svaraad babhuuveti ced vadaamastarhi kutasta.m na pratyaita? kathametaa.m kathayi.syati|</para>
  <para style="p">
    <verse number="32" style="v"/>maanavaad abhavaditi ced vadaamastarhi lokebhyo bhayamasti yato heto.h sarvve yohana.m satya.m bhavi.syadvaadina.m manyante|</para>
  <para style="p">
    <verse number="33" style="v"/>ataeva te yii"su.m pratyavaadi.su rvaya.m tad vaktu.m na "saknuma.h| yii"suruvaaca, tarhi yenaade"sena karmmaa.nyetaani karomi, ahamapi yu.smabhya.m tanna kathayi.syaami|</para>
  <chapter number="12" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>anantara.m yii"su rd.r.s.taantena tebhya.h kathayitumaarebhe, ka"scideko draak.saak.setra.m vidhaaya taccaturdik.su vaara.nii.m k.rtvaa tanmadhye draak.saape.sa.naku.n.dam akhanat, tathaa tasya ga.damapi nirmmitavaan tatastatk.setra.m k.r.siivale.su samarpya duurade"sa.m jagaama|</para>
  <para style="p">
    <verse number="2" style="v"/>tadanantara.m phalakaale k.r.siivalebhyo draak.saak.setraphalaani praaptu.m te.saa.m savidhe bh.rtyam eka.m praahi.not|</para>
  <para style="p">
    <verse number="3" style="v"/>kintu k.r.siivalaasta.m dh.rtvaa prah.rtya riktahasta.m visas.rju.h|</para>
  <para style="p">
    <verse number="4" style="v"/>tata.h sa punaranyameka.m bh.rtya.m pra.sayaamaasa, kintu te k.r.siivalaa.h paa.saa.naaghaataistasya "siro bha"nktvaa saapamaana.m ta.m vyasarjan|</para>
  <para style="p">
    <verse number="5" style="v"/>tata.h para.m sopara.m daasa.m praahi.not tadaa te ta.m jaghnu.h, evam aneke.saa.m kasyacit prahaara.h kasyacid vadha"sca tai.h k.rta.h|</para>
  <para style="p">
    <verse number="6" style="v"/>tata.h para.m mayaa svaputre prahite te tamava"sya.m samma.msyante, ityuktvaava"se.se te.saa.m sannidhau nijapriyam advitiiya.m putra.m pre.sayaamaasa|</para>
  <para style="p">
    <verse number="7" style="v"/>kintu k.r.siivalaa.h paraspara.m jagadu.h, e.sa uttaraadhikaarii, aagacchata vayamena.m hanmastathaa k.rte .adhikaaroyam asmaaka.m bhavi.syati|</para>
  <para style="p">
    <verse number="8" style="v"/>tatasta.m dh.rtvaa hatvaa draak.saak.setraad bahi.h praak.sipan|</para>
  <para style="p">
    <verse number="9" style="v"/>anenaasau draak.saak.setrapati.h ki.m kari.syati? sa etya taan k.r.siivalaan sa.mhatya tatk.setram anye.su k.r.siivale.su samarpayi.syati|</para>
  <para style="p">
    <verse number="10" style="v"/>apara nca, "sthapataya.h kari.syanti graavaa.na.m yantu tucchaka.m| praadhaanaprastara.h ko.ne sa eva sa.mbhavi.syati|</para>
  <para style="p">
    <verse number="11" style="v"/>etat karmma pare"sasyaa.mdbhuta.m no d.r.s.tito bhavet||" imaa.m "saastriiyaa.m lipi.m yuuya.m ki.m naapaa.thi.s.ta?</para>
  <para style="p">
    <verse number="12" style="v"/>tadaanii.m sa taanuddi"sya taa.m d.r.s.taantakathaa.m kathitavaan, ta ittha.m budvvaa ta.m dharttaamudyataa.h, kintu lokebhyo bibhyu.h, tadanantara.m te ta.m vihaaya vavraju.h|</para>
  <para style="p">
    <verse number="13" style="v"/>apara nca te tasya vaakyado.sa.m dharttaa.m katipayaan phiruu"sino herodiiyaa.m"sca lokaan tadantika.m pre.sayaamaasu.h|</para>
  <para style="p">
    <verse number="14" style="v"/>ta aagatya tamavadan, he guro bhavaan tathyabhaa.sii kasyaapyanurodha.m na manyate, pak.sapaata nca na karoti, yathaarthata ii"svariiya.m maarga.m dar"sayati vayametat prajaaniima.h, kaisaraaya karo deyo na vaa.m? vaya.m daasyaamo na vaa?</para>
  <para style="p">
    <verse number="15" style="v"/>kintu sa te.saa.m kapa.ta.m j naatvaa jagaada, kuto maa.m pariik.sadhve? eka.m mudraapaada.m samaaniiya maa.m dar"sayata|</para>
  <para style="p">
    <verse number="16" style="v"/>tadaa tairekasmin mudraapaade samaaniite sa taan papraccha, atra likhita.m naama muurtti rvaa kasya? te pratyuucu.h, kaisarasya|</para>
  <para style="p">
    <verse number="17" style="v"/>tadaa yii"suravadat tarhi kaisarasya dravyaa.ni kaisaraaya datta, ii"svarasya dravyaa.ni tu ii"svaraaya datta; tataste vismaya.m menire|</para>
  <para style="p">
    <verse number="18" style="v"/>atha m.rtaanaamutthaana.m ye na manyante te siduukino yii"so.h samiipamaagatya ta.m papracchu.h;</para>
  <para style="p">
    <verse number="19" style="v"/>he guro ka"scijjano yadi ni.hsantati.h san bhaaryyaayaa.m satyaa.m mriyate tarhi tasya bhraataa tasya bhaaryyaa.m g.rhiitvaa bhraatu rva.m"sotpatti.m kari.syati, vyavasthaamimaa.m muusaa asmaan prati vyalikhat|</para>
  <para style="p">
    <verse number="20" style="v"/>kintu kecit sapta bhraatara aasan, tataste.saa.m jye.s.thabhraataa vivahya ni.hsantati.h san amriyata|</para>
  <para style="p">
    <verse number="21" style="v"/>tato dvitiiyo bhraataa taa.m striyamag.rha.nat kintu sopi ni.hsantati.h san amriyata; atha t.rtiiyopi bhraataa taad.r"sobhavat|</para>
  <para style="p">
    <verse number="22" style="v"/>ittha.m saptaiva bhraatarastaa.m striya.m g.rhiitvaa ni.hsantaanaa.h santo.amriyanta, sarvva"se.se saapi strii mriyate sma|</para>
  <para style="p">
    <verse number="23" style="v"/>atha m.rtaanaamutthaanakaale yadaa ta utthaasyanti tadaa te.saa.m kasya bhaaryyaa saa bhavi.syati? yataste saptaiva taa.m vyavahan|</para>
  <para style="p">
    <verse number="24" style="v"/>tato yii"su.h pratyuvaaca "saastram ii"svara"sakti nca yuuyamaj naatvaa kimabhraamyata na?</para>
  <para style="p">
    <verse number="25" style="v"/>m.rtalokaanaamutthaana.m sati te na vivahanti vaagdattaa api na bhavanti, kintu svargiiyaduutaanaa.m sad.r"saa bhavanti|</para>
  <para style="p">
    <verse number="26" style="v"/>puna"sca "aham ibraahiima ii"svara ishaaka ii"svaro yaakuuba"sce"svara.h" yaamimaa.m kathaa.m stambamadhye ti.s.than ii"svaro muusaamavaadiit m.rtaanaamutthaanaarthe saa kathaa muusaalikhite pustake ki.m yu.smaabhi rnaapaa.thi?</para>
  <para style="p">
    <verse number="27" style="v"/>ii"svaro jiivataa.m prabhu.h kintu m.rtaanaa.m prabhu rna bhavati, tasmaaddheto ryuuya.m mahaabhrame.na ti.s.thatha|</para>
  <para style="p">
    <verse number="28" style="v"/>etarhi ekodhyaapaka etya te.saamittha.m vicaara.m "su"sraava; yii"suste.saa.m vaakyasya saduttara.m dattavaan iti budvvaa ta.m p.r.s.tavaan sarvvaasaam aaj naanaa.m kaa "sre.s.thaa? tato yii"su.h pratyuvaaca,</para>
  <para style="p">
    <verse number="29" style="v"/>"he israayellokaa avadhatta, asmaaka.m prabhu.h parame"svara eka eva,</para>
  <para style="p">
    <verse number="30" style="v"/>yuuya.m sarvvanta.hkara.nai.h sarvvapraa.nai.h sarvvacittai.h sarvva"saktibhi"sca tasmin prabhau parame"svare priiyadhva.m," ityaaj naa "sre.s.thaa|</para>
  <para style="p">
    <verse number="31" style="v"/>tathaa "svaprativaasini svavat prema kurudhva.m," e.saa yaa dvitiiyaaj naa saa taad.r"sii; etaabhyaa.m dvaabhyaam aaj naabhyaam anyaa kaapyaaj naa "sre.s.thaa naasti|</para>
  <para style="p">
    <verse number="32" style="v"/>tadaa sodhyaapakastamavadat, he guro satya.m bhavaan yathaartha.m proktavaan yata ekasmaad ii"svaraad anyo dvitiiya ii"svaro naasti;</para>
  <para style="p">
    <verse number="33" style="v"/>apara.m sarvvaanta.hkara.nai.h sarvvapraa.nai.h sarvvacittai.h sarvva"saktibhi"sca ii"svare premakara.na.m tathaa svamiipavaasini svavat premakara.na nca sarvvebhyo homabalidaanaadibhya.h "sra.s.tha.m bhavati|</para>
  <para style="p">
    <verse number="34" style="v"/>tato yii"su.h subuddheriva tasyedam uttara.m "srutvaa ta.m bhaa.sitavaan tvamii"svarasya raajyaanna duurosi|ita.h para.m tena saha kasyaapi vaakyasya vicaara.m karttaa.m kasyaapi pragalbhataa na jaataa|</para>
  <para style="p">
    <verse number="35" style="v"/>anantara.m madhyemandiram upadi"san yii"surima.m pra"sna.m cakaara, adhyaapakaa abhi.sikta.m (taaraka.m) kuto daayuuda.h santaana.m vadanti?</para>
  <para style="p">
    <verse number="36" style="v"/>svaya.m daayuud pavitrasyaatmana aave"seneda.m kathayaamaasa| yathaa| "mama prabhumida.m vaakyavadat parame"svara.h| tava "satruunaha.m yaavat paadapii.tha.m karomi na| taavat kaala.m madiiye tva.m dak.sapaar"sv upaavi"sa|"</para>
  <para style="p">
    <verse number="37" style="v"/>yadi daayuud ta.m prabhuu.m vadati tarhi katha.m sa tasya santaano bhavitumarhati? itare lokaastatkathaa.m "srutvaananandu.h|</para>
  <para style="p">
    <verse number="38" style="v"/>tadaanii.m sa taanupadi"sya kathitavaan ye naraa diirghaparidheyaani ha.t.te vipanau ca</para>
  <para style="p">
    <verse number="39" style="v"/>lokak.rtanamaskaaraan bhajanag.rhe pradhaanaasanaani bhojanakaale pradhaanasthaanaani ca kaa"nk.sante;</para>
  <para style="p">
    <verse number="40" style="v"/>vidhavaanaa.m sarvvasva.m grasitvaa chalaad diirghakaala.m praarthayante tebhya upaadhyaayebhya.h saavadhaanaa bhavata; te.adhikataraan da.n.daan praapsyanti|</para>
  <para style="p">
    <verse number="41" style="v"/>tadanantara.m lokaa bhaa.n.daagaare mudraa yathaa nik.sipanti bhaa.n.daagaarasya sammukhe samupavi"sya yii"sustadavaluloka; tadaanii.m bahavo dhaninastasya madhye bahuuni dhanaani nirak.sipan|</para>
  <para style="p">
    <verse number="42" style="v"/>pa"scaad ekaa daridraa vidhavaa samaagatya dvipa.namuulyaa.m mudraikaa.m tatra nirak.sipat|</para>
  <para style="p">
    <verse number="43" style="v"/>tadaa yii"su.h "si.syaan aahuuya kathitavaan yu.smaanaha.m yathaartha.m vadaami ye ye bhaa.n.daagaare.asmina dhanaani ni.hk.sipanti sma tebhya.h sarvvebhya iya.m vidhavaa daridraadhikam ni.hk.sipati sma|</para>
  <para style="p">
    <verse number="44" style="v"/>yataste prabhuutadhanasya ki ncit nirak.sipan kintu diineya.m svadinayaapanayogya.m ki ncidapi na sthaapayitvaa sarvvasva.m nirak.sipat|</para>
  <chapter number="13" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>anantara.m mandiraad bahirgamanakaale tasya "si.syaa.naamekasta.m vyaah.rtavaan he guro pa"syatu kiid.r"saa.h paa.saa.naa.h kiid.rk ca nicayana.m|</para>
  <para style="p">
    <verse number="2" style="v"/>tadaa yii"sustam avadat tva.m kimetad b.rhannicayana.m pa"syasi? asyaikapaa.saa.nopi dvitiiyapaa.saa.nopari na sthaasyati sarvve .adha.hk.sepsyante|</para>
  <para style="p">
    <verse number="3" style="v"/>atha yasmin kaale jaitungirau mandirasya sammukhe sa samupavi.s.tastasmin kaale pitaro yaakuub yohan aandriya"scaite ta.m rahasi papracchu.h,</para>
  <para style="p">
    <verse number="4" style="v"/>etaa gha.tanaa.h kadaa bhavi.syanti? tathaitatsarvvaasaa.m siddhyupakramasya vaa ki.m cihna.m? tadasmabhya.m kathayatu bhavaan|</para>
  <para style="p">
    <verse number="5" style="v"/>tato yaa"sustaan vaktumaarebhe, kopi yathaa yu.smaan na bhraamayati tathaatra yuuya.m saavadhaanaa bhavata|</para>
  <para style="p">
    <verse number="6" style="v"/>yata.h khrii.s.tohamiti kathayitvaa mama naamnaaneke samaagatya lokaanaa.m bhrama.m janayi.syanti;</para>
  <para style="p">
    <verse number="7" style="v"/>kintu yuuya.m ra.nasya vaarttaa.m ra.naa.dambara nca "srutvaa maa vyaakulaa bhavata, gha.tanaa etaa ava"syammaavinya.h; kintvaapaatato na yugaanto bhavi.syati|</para>
  <para style="p">
    <verse number="8" style="v"/>de"sasya vipak.satayaa de"so raajyasya vipak.satayaa ca raajyamutthaasyati, tathaa sthaane sthaane bhuumikampo durbhik.sa.m mahaakle"saa"sca samupasthaasyanti, sarvva ete du.hkhasyaarambhaa.h|</para>
  <para style="p">
    <verse number="9" style="v"/>kintu yuuyam aatmaarthe saavadhaanaasti.s.thata, yato lokaa raajasabhaayaa.m yu.smaan samarpayi.syanti, tathaa bhajanag.rhe prahari.syanti; yuuya.m madarthe de"saadhipaan bhuupaa.m"sca prati saak.syadaanaaya te.saa.m sammukhe upasthaapayi.syadhve|</para>
  <para style="p">
    <verse number="10" style="v"/>"se.siibhavanaat puurvva.m sarvvaan de"siiyaan prati susa.mvaada.h pracaarayi.syate|</para>
  <para style="p">
    <verse number="11" style="v"/>kintu yadaa te yu.smaan dh.rtvaa samarpayi.syanti tadaa yuuya.m yadyad uttara.m daasyatha, tadagra tasya vivecana.m maa kuruta tadartha.m ki ncidapi maa cintayata ca, tadaanii.m yu.smaaka.m mana.hsu yadyad vaakyam upasthaapayi.syate tadeva vadi.syatha, yato yuuya.m na tadvaktaara.h kintu pavitra aatmaa tasya vaktaa|</para>
  <para style="p">
    <verse number="12" style="v"/>tadaa bhraataa bhraatara.m pitaa putra.m ghaatanaartha.m parahaste.su samarpayi.syate, tathaa patyaani maataapitro rvipak.satayaa tau ghaatayi.syanti|</para>
  <para style="p">
    <verse number="13" style="v"/>mama naamaheto.h sarvve.saa.m savidhe yuuya.m jugupsitaa bhavi.syatha, kintu ya.h ka"scit "se.saparyyanta.m dhairyyam aalambi.syate saeva paritraasyate|</para>
  <para style="p">
    <verse number="14" style="v"/>daaniyelbhavi.syadvaadinaa prokta.m sarvvanaa"si jugupsita nca vastu yadaa tvayogyasthaane vidyamaana.m drak.satha (yo jana.h pa.thati sa budhyataa.m) tadaa ye yihuudiiyade"se ti.s.thanti te mahiidhra.m prati palaayantaa.m;</para>
  <para style="p">
    <verse number="15" style="v"/>tathaa yo naro g.rhopari ti.s.thati sa g.rhamadhya.m naavarohatu, tathaa kimapi vastu grahiitu.m madhyeg.rha.m na pravi"satu;</para>
  <para style="p">
    <verse number="16" style="v"/>tathaa ca yo nara.h k.setre ti.s.thati sopi svavastra.m grahiitu.m paraav.rtya na vrajatu|</para>
  <para style="p">
    <verse number="17" style="v"/>tadaanii.m garbbhavatiinaa.m stanyadaatrii.naa nca yo.sitaa.m durgati rbhavi.syati|</para>
  <para style="p">
    <verse number="18" style="v"/>yu.smaaka.m palaayana.m "siitakaale yathaa na bhavati tadartha.m praarthayadhva.m|</para>
  <para style="p">
    <verse number="19" style="v"/>yatastadaa yaad.r"sii durgha.tanaa gha.ti.syate taad.r"sii durgha.tanaa ii"svaras.r.s.te.h prathamamaarabhyaadya yaavat kadaapi na jaataa na jani.syate ca|</para>
  <para style="p">
    <verse number="20" style="v"/>apara nca parame"svaro yadi tasya samayasya sa.mk.sepa.m na karoti tarhi kasyaapi praa.nabh.rto rak.saa bhavitu.m na "sak.syati, kintu yaan janaan manoniitaan akarot te.saa.m svamanoniitaanaa.m heto.h sa tadanehasa.m sa.mk.sepsyati|</para>
  <para style="p">
    <verse number="21" style="v"/>anyacca pa"syata khrii.s.totra sthaane vaa tatra sthaane vidyate, tasminkaale yadi ka"scid yu.smaan etaad.r"sa.m vaakya.m vyaaharati, tarhi tasmin vaakye bhaiva vi"svasita|</para>
  <para style="p">
    <verse number="22" style="v"/>yatoneke mithyaakhrii.s.taa mithyaabhavi.syadvaadina"sca samupasthaaya bahuuni cihnaanyadbhutaani karmmaa.ni ca dar"sayi.syanti; tathaa yadi sambhavati tarhi manoniitalokaanaamapi mithyaamati.m janayi.syanti|</para>
  <para style="p">
    <verse number="23" style="v"/>pa"syata gha.tanaata.h puurvva.m sarvvakaaryyasya vaarttaa.m yu.smabhyamadaam, yuuya.m saavadhaanaasti.s.thata|</para>
  <para style="p">
    <verse number="24" style="v"/>apara nca tasya kle"sakaalasyaavyavahite parakaale bhaaskara.h saandhakaaro bhavi.syati tathaiva candra"scandrikaa.m na daasyati|</para>
  <para style="p">
    <verse number="25" style="v"/>nabha.hsthaani nak.satraa.ni pati.syanti, vyomama.n.dalasthaa grahaa"sca vicali.syanti|</para>
  <para style="p">
    <verse number="26" style="v"/>tadaanii.m mahaaparaakrame.na mahai"svaryye.na ca meghamaaruhya samaayaanta.m maanavasuta.m maanavaa.h samiik.si.syante|</para>
  <para style="p">
    <verse number="27" style="v"/>anyacca sa nijaduutaan prahitya nabhobhuumyo.h siimaa.m yaavad jagata"scaturdigbhya.h svamanoniitalokaan sa.mgrahii.syati|</para>
  <para style="p">
    <verse number="28" style="v"/>u.dumbarataro rd.r.s.taanta.m "sik.sadhva.m yado.dumbarasya taro rnaviinaa.h "saakhaa jaayante pallavaadiini ca rnigacchanti, tadaa nidaaghakaala.h savidho bhavatiiti yuuya.m j naatu.m "saknutha|</para>
  <para style="p">
    <verse number="29" style="v"/>tadvad etaa gha.tanaa d.r.s.tvaa sa kaalo dvaaryyupasthita iti jaaniita|</para>
  <para style="p">
    <verse number="30" style="v"/>yu.smaanaha.m yathaartha.m vadaami, aadhunikalokaanaa.m gamanaat puurvva.m taani sarvvaa.ni gha.ti.syante|</para>
  <para style="p">
    <verse number="31" style="v"/>dyaavaap.rthivyo rvicalitayo.h satyo rmadiiyaa vaa.nii na vicali.syati|</para>
  <para style="p">
    <verse number="32" style="v"/>apara nca svargasthaduutaga.no vaa putro vaa taataadanya.h kopi ta.m divasa.m ta.m da.n.da.m vaa na j naapayati|</para>
  <para style="p">
    <verse number="33" style="v"/>ata.h sa samaya.h kadaa bhavi.syati, etajj naanaabhaavaad yuuya.m saavadhaanaasti.s.thata, satarkaa"sca bhuutvaa praarthayadhva.m;</para>
  <para style="p">
    <verse number="34" style="v"/>yadvat ka"scit pumaan svanive"sanaad duurade"sa.m prati yaatraakara.nakaale daase.su svakaaryyasya bhaaramarpayitvaa sarvvaan sve sve karmma.ni niyojayati; apara.m dauvaarika.m jaagaritu.m samaadi"sya yaati, tadvan naraputra.h|</para>
  <para style="p">
    <verse number="35" style="v"/>g.rhapati.h saaya.mkaale ni"siithe vaa t.rtiiyayaame vaa praata.hkaale vaa kadaagami.syati tad yuuya.m na jaaniitha;</para>
  <para style="p">
    <verse number="36" style="v"/>sa ha.thaadaagatya yathaa yu.smaan nidritaan na pa"syati, tadartha.m jaagaritaasti.s.thata|</para>
  <para style="p">
    <verse number="37" style="v"/>yu.smaanaha.m yad vadaami tadeva sarvvaan vadaami, jaagaritaasti.s.thateti|</para>
  <chapter number="14" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>tadaa nistaarotsavaki.nvahiinapuupotsavayoraarambhasya dinadvaye .ava"si.s.te pradhaanayaajakaa adhyaapakaa"sca kenaapi chalena yii"su.m dharttaa.m hantu nca m.rgayaa ncakrire;</para>
  <para style="p">
    <verse number="2" style="v"/>kintu lokaanaa.m kalahabhayaaduucire, nacotsavakaala ucitametaditi|</para>
  <para style="p">
    <verse number="3" style="v"/>anantara.m baithaniyaapuुre "simonaku.s.thino g.rhe yo"sau bhotkumupavi.s.te sati kaacid yo.sit paa.n.darapaa.saa.nasya sampu.takena mahaarghyottamatailam aaniiya sampu.taka.m bha.mktvaa tasyottamaa"nge tailadhaaraa.m paatayaa ncakre|</para>
  <para style="p">
    <verse number="4" style="v"/>tasmaat kecit svaante kupyanta.h kathitava.mnta.h kutoya.m tailaapavyaya.h?</para>
  <para style="p">
    <verse number="5" style="v"/>yadyetat taila vyakre.syata tarhi mudraapaada"satatrayaadapyadhika.m tasya praaptamuulya.m daridralokebhyo daatuma"sak.syata, kathaametaa.m kathayitvaa tayaa yo.sitaa saaka.m vaacaayuhyan|</para>
  <para style="p">
    <verse number="6" style="v"/>kintu yii"suruvaaca, kuta etasyai k.rcchra.m dadaasi? mahyamiya.m karmmottama.m k.rtavatii|</para>
  <para style="p">
    <verse number="7" style="v"/>daridraa.h sarvvadaa yu.smaabhi.h saha ti.s.thanti, tasmaad yuuya.m yadecchatha tadaiva taanupakarttaa.m "saknutha, kintvaha.m yubhaabhi.h saha nirantara.m na ti.s.thaami|</para>
  <para style="p">
    <verse number="8" style="v"/>asyaa yathaasaadhya.m tathaivaakarodiya.m, "sma"saanayaapanaat puurvva.m sametya madvapu.si tailam amarddayat|</para>
  <para style="p">
    <verse number="9" style="v"/>aha.m yu.smabhya.m yathaartha.m kathayaami, jagataa.m madhye yatra yatra susa.mvaadoya.m pracaarayi.syate tatra tatra yo.sita etasyaa.h smara.naartha.m tatk.rtakarmmaitat pracaarayi.syate|</para>
  <para style="p">
    <verse number="10" style="v"/>tata.h para.m dvaada"saanaa.m "si.syaa.naameka ii.skariyotiiyayihuudaakhyo yii"su.m parakare.su samarpayitu.m pradhaanayaajakaanaa.m samiipamiyaaya|</para>
  <para style="p">
    <verse number="11" style="v"/>te tasya vaakya.m samaakar.nya santu.s.taa.h santastasmai mudraa daatu.m pratyajaanata; tasmaat sa ta.m te.saa.m kare.su samarpa.naayopaaya.m m.rgayaamaasa|</para>
  <para style="p">
    <verse number="12" style="v"/>anantara.m ki.nva"suunyapuupotsavasya prathame.ahani nistaarotmavaartha.m me.samaara.naasamaye "si.syaasta.m papraccha.h kutra gatvaa vaya.m nistaarotsavasya bhojyamaasaadayi.syaama.h? kimicchati bhavaan?</para>
  <para style="p">
    <verse number="13" style="v"/>tadaanii.m sa te.saa.m dvaya.m prerayan babhaa.se yuvayo.h puramadhya.m gatayo.h sato ryo jana.h sajalakumbha.m vahan yuvaa.m saak.saat kari.syati tasyaiva pa"scaad yaata.m;</para>
  <para style="p">
    <verse number="14" style="v"/>sa yat sadana.m pravek.syati tadbhavanapati.m vadata.m, gururaaha yatra sa"si.syoha.m nistaarotsaviiya.m bhojana.m kari.syaami, saa bhojana"saalaa kutraasti?</para>
  <para style="p">
    <verse number="15" style="v"/>tata.h sa pari.sk.rtaa.m susajjitaa.m b.rhatiica nca yaa.m "saalaa.m dar"sayi.syati tasyaamasmadartha.m bhojyadravyaa.nyaasaadayata.m|</para>
  <para style="p">
    <verse number="16" style="v"/>tata.h "si.syau prasthaaya pura.m pravi"sya sa yathoktavaan tathaiva praapya nistaarotsavasya bhojyadravyaa.ni samaasaadayetaam|</para>
  <para style="p">
    <verse number="17" style="v"/>anantara.m yii"su.h saaya.mkaale dvaada"sabhi.h "si.syai.h saarddha.m jagaama;</para>
  <para style="p">
    <verse number="18" style="v"/>sarvve.su bhojanaaya propavi.s.te.su sa taanuditavaan yu.smaanaha.m yathaartha.m vyaaharaami, atra yu.smaakameko jano yo mayaa saha bhu.mkte maa.m parakere.su samarpayi.syate|</para>
  <para style="p">
    <verse number="19" style="v"/>tadaanii.m te du.hkhitaa.h santa ekaika"sasta.m pra.s.tumaarabdhavanta.h sa kimaha.m? pa"scaad anya ekobhidadhe sa kimaha.m?</para>
  <para style="p">
    <verse number="20" style="v"/>tata.h sa pratyavadad ete.saa.m dvaada"saanaa.m yo jano mayaa sama.m bhojanaapaatre paa.ni.m majjayi.syati sa eva|</para>
  <para style="p">
    <verse number="21" style="v"/>manujatanayamadhi yaad.r"sa.m likhitamaaste tadanuruupaa gatistasya bhavi.syati, kintu yo jano maanavasuta.m samarpayi.syate hanta tasya janmaabhaave sati bhadramabhavi.syat|</para>
  <para style="p">
    <verse number="22" style="v"/>apara nca te.saa.m bhojanasamaye yii"su.h puupa.m g.rhiitve"svaragu.naan anukiirtya bha"nktvaa tebhyo dattvaa babhaa.se, etad g.rhiitvaa bhu njiidhvam etanmama vigraharuupa.m|</para>
  <para style="p">
    <verse number="23" style="v"/>anantara.m sa ka.msa.m g.rhiitve"svarasya gu.naan kiirttayitvaa tebhyo dadau, tataste sarvve papu.h|</para>
  <para style="p">
    <verse number="24" style="v"/>apara.m sa taanavaadiid bahuunaa.m nimitta.m paatita.m mama naviinaniyamaruupa.m "so.nitametat|</para>
  <para style="p">
    <verse number="25" style="v"/>yu.smaanaha.m yathaartha.m vadaami, ii"svarasya raajye yaavat sadyojaata.m draak.saarasa.m na paasyaami,taavadaha.m draak.saaphalarasa.m puna rna paasyaami|</para>
  <para style="p">
    <verse number="26" style="v"/>tadanantara.m te giitameka.m sa.mgiiya bahi rjaituna.m "sikhari.na.m yayu.h</para>
  <para style="p">
    <verse number="27" style="v"/>atha yii"sustaanuvaaca ni"saayaamasyaa.m mayi yu.smaaka.m sarvve.saa.m pratyuuho bhavi.syati yato likhitamaaste yathaa, me.saa.naa.m rak.saka ncaaha.m prahari.syaami vai tata.h| me.saa.naa.m nivaho nuuna.m pravikiir.no bhavi.syati|</para>
  <para style="p">
    <verse number="28" style="v"/>kantu madutthaane jaate yu.smaakamagre.aha.m gaaliila.m vraji.syaami|</para>
  <para style="p">
    <verse number="29" style="v"/>tadaa pitara.h pratibabhaa.se, yadyapi sarvve.saa.m pratyuuho bhavati tathaapi mama naiva bhavi.syati|</para>
  <para style="p">
    <verse number="30" style="v"/>tato yii"suruktaavaan aha.m tubhya.m tathya.m kathayaami, k.sa.naadaayaamadya kukku.tasya dvitiiyavaararava.naat puurvva.m tva.m vaaratraya.m maamapahno.syase|</para>
  <para style="p">
    <verse number="31" style="v"/>kintu sa gaa.dha.m vyaaharad yadyapi tvayaa saarddha.m mama praa.no yaati tathaapi kathamapi tvaa.m naapahno.sye; sarvve.apiitare tathaiva babhaa.sire|</para>
  <para style="p">
    <verse number="32" style="v"/>apara nca te.su get"simaaniinaamaka.m sthaana gate.su sa "si.syaan jagaada, yaavadaha.m praarthaye taavadatra sthaane yuuya.m samupavi"sata|</para>
  <para style="p">
    <verse number="33" style="v"/>atha sa pitara.m yaakuuba.m yohana nca g.rhiitvaa vavraaja; atyanta.m traasito vyaakulita"sca tebhya.h kathayaamaasa,</para>
  <para style="p">
    <verse number="34" style="v"/>nidhanakaalavat praa.no me.atiiva da.hkhameti, yuuya.m jaagratotra sthaane ti.s.thata|</para>
  <para style="p">
    <verse number="35" style="v"/>tata.h sa ki ncidduura.m gatvaa bhuumaavadhomukha.h patitvaa praarthitavaanetat, yadi bhavitu.m "sakya.m tarhi du.hkhasamayoya.m matto duuriibhavatu|</para>
  <para style="p">
    <verse number="36" style="v"/>aparamuditavaan he pita rhe pita.h sarvve.m tvayaa saadhya.m, tato hetorima.m ka.msa.m matto duuriikuru, kintu tan mamecchaato na tavecchaato bhavatu|</para>
  <para style="p">
    <verse number="37" style="v"/>tata.h para.m sa etya taan nidritaan niriik.sya pitara.m provaaca, "simon tva.m ki.m nidraasi? gha.tikaamekaam api jaagaritu.m na "sakno.si?</para>
  <para style="p">
    <verse number="38" style="v"/>pariik.saayaa.m yathaa na patatha tadartha.m sacetanaa.h santa.h praarthayadhva.m; mana udyuktamiti satya.m kintu vapura"saktika.m|</para>
  <para style="p">
    <verse number="39" style="v"/>atha sa punarvrajitvaa puurvvavat praarthayaa ncakre|</para>
  <para style="p">
    <verse number="40" style="v"/>paraav.rtyaagatya punarapi taan nidritaan dadar"sa tadaa te.saa.m locanaani nidrayaa puur.naani, tasmaattasmai kaa kathaa kathayitavyaa ta etad boddhu.m na "seku.h|</para>
  <para style="p">
    <verse number="41" style="v"/>tata.hpara.m t.rtiiyavaara.m aagatya tebhyo .akathayad idaaniimapi "sayitvaa vi"sraamyatha? yathe.s.ta.m jaata.m, samaya"scopasthita.h pa"syata maanavatanaya.h paapilokaanaa.m paa.ni.su samarpyate|</para>
  <para style="p">
    <verse number="42" style="v"/>utti.s.thata, vaya.m vrajaamo yo jano maa.m parapaa.ni.su samarpayi.syate pa"syata sa samiipamaayaata.h|</para>
  <para style="p">
    <verse number="43" style="v"/>imaa.m kathaa.m kathayati sa, etarhidvaada"saanaameko yihuudaa naamaa "si.sya.h pradhaanayaajakaanaam upaadhyaayaanaa.m praaciinalokaanaa nca sannidhe.h kha"ngalagu.dadhaari.no bahulokaan g.rhiitvaa tasya samiipa upasthitavaan|</para>
  <para style="p">
    <verse number="44" style="v"/>apara ncaasau parapaa.ni.su samarpayitaa puurvvamiti sa"nketa.m k.rtavaan yamaha.m cumbi.syaami sa evaasau tameva dh.rtvaa saavadhaana.m nayata|</para>
  <para style="p">
    <verse number="45" style="v"/>ato heto.h sa aagatyaiva yo"so.h savidha.m gatvaa he guro he guro, ityuktvaa ta.m cucumba|</para>
  <para style="p">
    <verse number="46" style="v"/>tadaa te tadupari paa.niinarpayitvaa ta.m dadhnu.h|</para>
  <para style="p">
    <verse number="47" style="v"/>tatastasya paar"svasthaanaa.m lokaanaameka.h kha"nga.m ni.sko.sayan mahaayaajakasya daasameka.m prah.rtya tasya kar.na.m ciccheda|</para>
  <para style="p">
    <verse number="48" style="v"/>pa"scaad yii"sustaan vyaajahaara kha"ngaan lagu.daa.m"sca g.rhiitvaa maa.m ki.m caura.m dharttaa.m samaayaataa.h?</para>
  <para style="p">
    <verse number="49" style="v"/>madhyemandira.m samupadi"san pratyaha.m yu.smaabhi.h saha sthitavaanataha.m, tasmin kaale yuuya.m maa.m naadiidharata, kintvanena "saastriiya.m vacana.m sedhaniiya.m|</para>
  <para style="p">
    <verse number="50" style="v"/>tadaa sarvve "si.syaasta.m parityajya palaayaa ncakrire|</para>
  <para style="p">
    <verse number="51" style="v"/>athaiko yuvaa maanavo nagnakaaye vastrameka.m nidhaaya tasya pa"scaad vrajan yuvalokai rdh.rto</para>
  <para style="p">
    <verse number="52" style="v"/>vastra.m vihaaya nagna.h palaayaa ncakre|</para>
  <para style="p">
    <verse number="53" style="v"/>apara nca yasmin sthaane pradhaanayaajakaa upaadhyaayaa.h praaciinalokaa"sca mahaayaajakena saha sadasi sthitaastasmin sthaane mahaayaajakasya samiipa.m yii"su.m ninyu.h|</para>
  <para style="p">
    <verse number="54" style="v"/>pitaro duure tatpa"scaad itvaa mahaayaajakasyaa.t.taalikaa.m pravi"sya ki"nkarai.h sahopavi"sya vahnitaapa.m jagraaha|</para>
  <para style="p">
    <verse number="55" style="v"/>tadaanii.m pradhaanayaajakaa mantri.na"sca yii"su.m ghaatayitu.m tatpraatikuulyena saak.si.no m.rgayaa ncakrire, kintu na praaptaa.h|</para>
  <para style="p">
    <verse number="56" style="v"/>anekaistadviruddha.m m.r.saasaak.sye dattepi te.saa.m vaakyaani na samagacchanta|</para>
  <para style="p">
    <verse number="57" style="v"/>sarvva"se.se kiyanta utthaaya tasya praatikuulyena m.r.saasaak.sya.m dattvaa kathayaamaasu.h,</para>
  <para style="p">
    <verse number="58" style="v"/>ida.m karak.rtamandira.m vinaa"sya dinatrayamadhye punaraparam akarak.rta.m mandira.m nirmmaasyaami, iti vaakyam asya mukhaat "srutamasmaabhiriti|</para>
  <para style="p">
    <verse number="59" style="v"/>kintu tatraapi te.saa.m saak.syakathaa na sa"ngaataa.h|</para>
  <para style="p">
    <verse number="60" style="v"/>atha mahaayaajako madhyesabham utthaaya yii"su.m vyaajahaara, ete janaastvayi yat saak.syamadu.h tvametasya kimapyuttara.m ki.m na daasyasi?</para>
  <para style="p">
    <verse number="61" style="v"/>kintu sa kimapyuttara.m na datvaa mauniibhuuya tasyau; tato mahaayaajaka.h punarapi ta.m p.r.s.taavaan tva.m saccidaanandasya tanayo .abhi.siktastrataa?</para>
  <para style="p">
    <verse number="62" style="v"/>tadaa yii"susta.m provaaca bhavaamyaham yuuya nca sarvva"saktimato dak.sii.napaar"sve samupavi"santa.m megha maaruhya samaayaanta nca manu.syaputra.m sandrak.syatha|</para>
  <para style="p">
    <verse number="63" style="v"/>tadaa mahaayaajaka.h sva.m vamana.m chitvaa vyaavaharat</para>
  <para style="p">
    <verse number="64" style="v"/>kimasmaaka.m saak.sibhi.h prayojanam? ii"svaranindaavaakya.m yu.smaabhira"sraavi ki.m vicaarayatha? tadaanii.m sarvve jagaduraya.m nidhanada.n.damarhati|</para>
  <para style="p">
    <verse number="65" style="v"/>tata.h ka"scit ka"scit tadvapu.si ni.s.thiiva.m nicik.sepa tathaa tanmukhamaacchaadya cape.tena hatvaa gaditavaan ga.nayitvaa vada, anucaraa"sca cape.taistamaajaghnu.h</para>
  <para style="p">
    <verse number="66" style="v"/>tata.h para.m pitare.a.t.taalikaadha.hko.s.the ti.s.thati mahaayaajakasyaikaa daasii sametya</para>
  <para style="p">
    <verse number="67" style="v"/>ta.m vihnitaapa.m g.rhlanta.m vilokya ta.m suniriik.sya babhaa.se tvamapi naasaratiiyayii"so.h sa"nginaam eko jana aasii.h|</para>
  <para style="p">
    <verse number="68" style="v"/>kintu sopahnutya jagaada tamaha.m na vadmi tva.m yat kathayami tadapyaha.m na buddhye| tadaanii.m pitare catvara.m gatavati kuेkku.to ruraava|</para>
  <para style="p">
    <verse number="69" style="v"/>athaanyaa daasii pitara.m d.r.s.tvaa samiipasthaan janaan jagaada aya.m te.saameko jana.h|</para>
  <para style="p">
    <verse number="70" style="v"/>tata.h sa dvitiiyavaaram apahnutavaan pa"scaat tatrasthaa lokaa.h pitara.m procustvamava"sya.m te.saameko jana.h yatastva.m gaaliiliiyo nara iti tavoccaara.na.m prakaa"sayati|</para>
  <para style="p">
    <verse number="71" style="v"/>tadaa sa "sapathaabhi"saapau k.rtvaa provaaca yuuya.m kathaa.m kathayatha ta.m nara.m na jaane.aha.m|</para>
  <para style="p">
    <verse number="72" style="v"/>tadaanii.m dvitiiyavaara.m kukku.to .araaviit| kukku.tasya dvitiiyaravaat puurvva.m tva.m maa.m vaaratrayam apahno.syasi, iti yadvaakya.m yii"sunaa samudita.m tat tadaa sa.msm.rtya pitaro roditum aarabhata|</para>
  <chapter number="15" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>atha prabhaate sati pradhaanayaajakaa.h praa nca upaadhyaayaa.h sarvve mantri.na"sca sabhaa.m k.rtvaa yii"suृ.m bandhayitva piilaataakhyasya de"saadhipate.h savidha.m niitvaa samarpayaamaasu.h|</para>
  <para style="p">
    <verse number="2" style="v"/>tadaa piilaatasta.m p.r.s.tavaan tva.m ki.m yihuudiiyalokaanaa.m raajaa? tata.h sa pratyuktavaan satya.m vadasi|</para>
  <para style="p">
    <verse number="3" style="v"/>apara.m pradhaanayaajakaastasya bahu.su vaakye.su do.samaaropayaa ncakru.h kintu sa kimapi na pratyuvaaca|</para>
  <para style="p">
    <verse number="4" style="v"/>tadaanii.m piilaatasta.m puna.h papraccha tva.m ki.m nottarayasi? pa"syaite tvadviruddha.m kati.su saadhye.su saak.sa.m dadati|</para>
  <para style="p">
    <verse number="5" style="v"/>kantu yii"sustadaapi nottara.m dadau tata.h piilaata aa"scaryya.m jagaama|</para>
  <para style="p">
    <verse number="6" style="v"/>apara nca kaaraabaddhe kasti.m"scit jane tanmahotsavakaale lokai ryaacite de"saadhipatista.m mocayati|</para>
  <para style="p">
    <verse number="7" style="v"/>ye ca puurvvamupaplavamakaar.surupaplave vadhamapi k.rtavantaste.saa.m madhye tadaano.m barabbaanaamaka eko baddha aasiit|</para>
  <para style="p">
    <verse number="8" style="v"/>ato heto.h puurvvaapariiyaa.m riitikathaa.m kathayitvaa lokaa uccairuvanta.h piilaatasya samak.sa.m nivedayaamaasu.h|</para>
  <para style="p">
    <verse number="9" style="v"/>tadaa piilaatastaanaacakhyau tarhi ki.m yihuudiiyaanaa.m raajaana.m mocayi.syaami? yu.smaabhi.h kimi.syate?</para>
  <para style="p">
    <verse number="10" style="v"/>yata.h pradhaanayaajakaa iir.syaata eva yii"su.m samaarpayanniti sa viveda|</para>
  <para style="p">
    <verse number="11" style="v"/>kintu yathaa barabbaa.m mocayati tathaa praarthayitu.m pradhaanayaajakaa lokaan pravarttayaamaasu.h|</para>
  <para style="p">
    <verse number="12" style="v"/>atha piilaata.h puna.h p.r.s.tavaan tarhi ya.m yihuudiiyaanaa.m raajeti vadatha tasya ki.m kari.syaami yu.smaabhi.h kimi.syate?</para>
  <para style="p">
    <verse number="13" style="v"/>tadaa te punarapi proccai.h procusta.m kru"se vedhaya|</para>
  <para style="p">
    <verse number="14" style="v"/>tasmaat piilaata.h kathitavaan kuta.h? sa ki.m kukarmma k.rtavaan? kintu te puna"sca ruvanto vyaajahrusta.m kru"se vedhaya|</para>
  <para style="p">
    <verse number="15" style="v"/>tadaa piilaata.h sarvvaallokaan to.sayitumicchan barabbaa.m mocayitvaa yii"su.m ka"saabhi.h prah.rtya kru"se veddhu.m ta.m samarpayaambabhuuva|</para>
  <para style="p">
    <verse number="16" style="v"/>anantara.m sainyaga.no.a.t.taalikaam arthaad adhipate rg.rha.m yii"su.m niitvaa senaanivaha.m samaahuyat|</para>
  <para style="p">
    <verse number="17" style="v"/>pa"scaat te ta.m dhuumalavar.navastra.m paridhaapya ka.n.takamuku.ta.m racayitvaa "sirasi samaaropya</para>
  <para style="p">
    <verse number="18" style="v"/>he yihuudiiyaanaa.m raajan namaskaara ityuktvaa ta.m namaskarttaamaarebhire|</para>
  <para style="p">
    <verse number="19" style="v"/>tasyottamaa"nge vetraaghaata.m cakrustadgaatre ni.s.thiiva nca nicik.sipu.h, tathaa tasya sammukhe jaanupaata.m pra.nomu.h</para>
  <para style="p">
    <verse number="20" style="v"/>itthamupahasya dhuumravar.navastram uttaaryya tasya vastra.m ta.m paryyadhaapayan kru"se veddhu.m bahirninyu"sca|</para>
  <para style="p">
    <verse number="21" style="v"/>tata.h para.m sekandarasya ruphasya ca pitaa "simonnaamaa kurii.niiyaloka eka.h kuta"scid graamaadetya pathi yaati ta.m te yii"so.h kru"sa.m vo.dhu.m balaad dadhnu.h|</para>
  <para style="p">
    <verse number="22" style="v"/>atha gulgaltaa arthaat "sira.hkapaalanaamaka.m sthaana.m yii"sumaaniiya</para>
  <para style="p">
    <verse number="23" style="v"/>te gandharasami"srita.m draak.saarasa.m paatu.m tasmai dadu.h kintu sa na jagraaha|</para>
  <para style="p">
    <verse number="24" style="v"/>tasmin kru"se viddhe sati te.saamekaika"sa.h ki.m praapsyatiiti nir.nayaaya</para>
  <para style="p">
    <verse number="25" style="v"/>tasya paridheyaanaa.m vibhaagaartha.m gu.tikaapaata.m cakru.h|</para>
  <para style="p">
    <verse number="26" style="v"/>aparam e.sa yihuudiiyaanaa.m raajeti likhita.m do.sapatra.m tasya "sirauurdvvam aaropayaa ncakru.h|</para>
  <para style="p">
    <verse number="27" style="v"/>tasya vaamadak.si.nayo rdvau caurau kru"sayo rvividhaate|</para>
  <para style="p">
    <verse number="28" style="v"/>tenaiva "aparaadhijanai.h saarddha.m sa ga.nito bhavi.syati," iti "saastrokta.m vacana.m siddhamabhuuta|</para>
  <para style="p">
    <verse number="29" style="v"/>anantara.m maarge ye ye lokaa gamanaagamane cakruste sarvva eva "siraa.msyaandolya nindanto jagadu.h, re mandiranaa"saka re dinatrayamadhye tannirmmaayaka,</para>
  <para style="p">
    <verse number="30" style="v"/>adhunaatmaanam avitvaa kru"saadavaroha|</para>
  <para style="p">
    <verse number="31" style="v"/>ki nca pradhaanayaajakaa adhyaapakaa"sca tadvat tirask.rtya paraspara.m cacak.sire e.sa paraanaavat kintu svamavitu.m na "saknoti|</para>
  <para style="p">
    <verse number="32" style="v"/>yadiisraayelo raajaabhi.siktastraataa bhavati tarhyadhunaina kru"saadavarohatu vaya.m tad d.r.s.tvaa vi"svasi.syaama.h; ki nca yau lokau tena saarddha.m kru"se .avidhyetaa.m taavapi ta.m nirbhartsayaamaasatu.h|</para>
  <para style="p">
    <verse number="33" style="v"/>atha dvitiiyayaamaat t.rtiiyayaama.m yaavat sarvvo de"sa.h saandhakaarobhuut|</para>
  <para style="p">
    <verse number="34" style="v"/>tatast.rtiiyaprahare yii"suruccairavadat elii elii laamaa "sivaktanii arthaad "he madii"sa madii"sa tva.m paryyatyaak.sii.h kuto hi maa.m?"</para>
  <para style="p">
    <verse number="35" style="v"/>tadaa samiipasthalokaanaa.m kecit tadvaakya.m ni"samyaacakhyu.h pa"syai.sa eliyam aahuuyati|</para>
  <para style="p">
    <verse number="36" style="v"/>tata eko jano dhaavitvaagatya spa nje .amlarasa.m puurayitvaa ta.m na.daagre nidhaaya paatu.m tasmai dattvaavadat ti.s.tha eliya enamavarohayitum eti na veti pa"syaami|</para>
  <para style="p">
    <verse number="37" style="v"/>atha yii"suruccai.h samaahuuya praa.naan jahau|</para>
  <para style="p">
    <verse number="38" style="v"/>tadaa mandirasya javanikordvvaadadha.hryyantaa vidiir.naa dvikha.n.daabhuut|</para>
  <para style="p">
    <verse number="39" style="v"/>ki nca itthamuccairaahuuya praa.naan tyajanta.m ta.m d.r.sdvaa tadrak.sa.naaya niyukto ya.h senaapatiraasiit sovadat naroyam ii"svaraputra iti satyam|</para>
  <para style="p">
    <verse number="40" style="v"/>tadaanii.m magdaliinii marisam kani.s.thayaakuubo yose"sca maataanyamariyam "saalomii ca yaa.h striyo</para>
  <para style="p">
    <verse number="41" style="v"/>gaaliilprade"se yii"su.m sevitvaa tadanugaaminyo jaataa imaastadanyaa"sca yaa anekaa naaryo yii"sunaa saarddha.m yiruu"saalamamaayaataastaa"sca duuraat taani dad.r"su.h|</para>
  <para style="p">
    <verse number="42" style="v"/>athaasaadanadinasyaarthaad vi"sraamavaaraat puurvvadinasya saaya.mkaala aagata</para>
  <para style="p">
    <verse number="43" style="v"/>ii"svararaajyaapek.syarimathiiyayuu.saphanaamaa maanyamantrii sametya piilaatasavidha.m nirbhayo gatvaa yii"sordeha.m yayaace|</para>
  <para style="p">
    <verse number="44" style="v"/>kintu sa idaanii.m m.rta.h piilaata ityasambhava.m matvaa "satasenaapatimaahuuya sa kadaa m.rta iti papraccha|</para>
  <para style="p">
    <verse number="45" style="v"/>"satasemanaapatimukhaat tajj naatvaa yuu.saphe yii"sordeha.m dadau|</para>
  <para style="p">
    <verse number="46" style="v"/>pa"scaat sa suuk.sma.m vaasa.h kriitvaa yii"so.h kaayamavarohya tena vaasasaa ve.s.taayitvaa girau khaata"sma"saane sthaapitavaan paa.saa.na.m lo.thayitvaa dvaari nidadhe|</para>
  <para style="p">
    <verse number="47" style="v"/>kintu yatra sosthaapyata tata magdaliinii mariyam yosimaat.rmariyam ca dad.r"sat.r.h|</para>
  <chapter number="16" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>atha vi"sraamavaare gate magdaliinii mariyam yaakuubamaataa mariyam "saalomii cemaasta.m marddayitu.m sugandhidravyaa.ni kriitvaa</para>
  <para style="p">
    <verse number="2" style="v"/>saptaahaprathamadine.atipratyuu.se suuryyodayakaale "sma"saanamupagataa.h|</para>
  <para style="p">
    <verse number="3" style="v"/>kintu "sma"saanadvaarapaa.saa.no.atib.rhan ta.m ko.apasaarayi.syatiiti taa.h paraspara.m gadanti!</para>
  <para style="p">
    <verse number="4" style="v"/>etarhi niriik.sya paa.saa.no dvaaro .apasaarita iti dad.r"su.h|</para>
  <para style="p">
    <verse number="5" style="v"/>pa"scaattaa.h "sma"saana.m pravi"sya "suklavar.nadiirghaparicchadaav.rtameka.m yuvaana.m "sma"saanadak.si.napaar"sva upavi.s.ta.m d.r.s.tvaa camaccakru.h|</para>
  <para style="p">
    <verse number="6" style="v"/>so.avadat, maabhai.s.ta yuuya.m kru"se hata.m naasaratiiyayii"su.m gave.sayatha sotra naasti "sma"saanaadudasthaat; tai ryatra sa sthaapita.h sthaana.m tadida.m pa"syata|</para>
  <para style="p">
    <verse number="7" style="v"/>kintu tena yathokta.m tathaa yu.smaakamagre gaaliila.m yaasyate tatra sa yu.smaan saak.saat kari.syate yuuya.m gatvaa tasya "si.syebhya.h pitaraaya ca vaarttaamimaa.m kathayata|</para>
  <para style="p">
    <verse number="8" style="v"/>taa.h kampitaa vistitaa"sca tuur.na.m "sma"saanaad bahirgatvaa palaayanta bhayaat kamapi kimapi naavada.m"sca|</para>
  <para style="p">
    <verse number="9" style="v"/>apara.m yii"su.h saptaahaprathamadine pratyuu.se "sma"saanaadutthaaya yasyaa.h saptabhuutaastyaajitaastasyai magdaliiniimariyame prathama.m dar"sana.m dadau|</para>
  <para style="p">
    <verse number="10" style="v"/>tata.h saa gatvaa "sokarodanak.rdbhyo.anugatalokebhyastaa.m vaarttaa.m kathayaamaasa|</para>
  <para style="p">
    <verse number="11" style="v"/>kintu yii"su.h punarjiivan tasyai dar"sana.m dattavaaniti "srutvaa te na pratyayan|</para>
  <para style="p">
    <verse number="12" style="v"/>pa"scaat te.saa.m dvaayo rgraamayaanakaale yii"suranyave"sa.m dh.rtvaa taabhyaa.m dar"sana dadau!</para>
  <para style="p">
    <verse number="13" style="v"/>taavapi gatvaanya"si.syebhyastaa.m kathaa.m kathayaa ncakratu.h kintu tayo.h kathaamapi te na pratyayan|</para>
  <para style="p">
    <verse number="14" style="v"/>"se.sata ekaada"sa"si.sye.su bhojanopavi.s.te.su yii"sustebhyo dar"sana.m dadau tathotthaanaat para.m taddar"sanapraaptalokaanaa.m kathaayaamavi"svaasakara.naat te.saamavi"svaasamana.hkaa.thinyaabhyaa.m hetubhyaa.m sa taa.mstarjitavaan|</para>
  <para style="p">
    <verse number="15" style="v"/>atha taanaacakhyau yuuya.m sarvvajagad gatvaa sarvvajanaan prati susa.mvaada.m pracaarayata|</para>
  <para style="p">
    <verse number="16" style="v"/>tatra ya.h ka"scid vi"svasya majjito bhavet sa paritraasyate kintu yo na vi"svasi.syati sa da.n.dayi.syate|</para>
  <para style="p">
    <verse number="17" style="v"/>ki nca ye pratye.syanti tairiid.rg aa"scaryya.m karmma prakaa"sayi.syate te mannaamnaa bhuutaan tyaajayi.syanti bhaa.saa anyaa"sca vadi.syanti|</para>
  <para style="p">
    <verse number="18" style="v"/>apara.m tai.h sarpe.su dh.rte.su praa.nanaa"sakavastuni piite ca te.saa.m kaapi k.sati rna bhavi.syati; rogi.naa.m gaatre.su karaarpite te.arogaa bhavi.syanti ca|</para>
  <para style="p">
    <verse number="19" style="v"/>atha prabhustaanityaadi"sya svarga.m niita.h san parame"svarasya dak.si.na upavive"sa|</para>
  <para style="p">
    <verse number="20" style="v"/>tataste prasthaaya sarvvatra susa.mvaadiiyakathaa.m pracaarayitumaarebhire prabhustu te.saa.m sahaaya.h san prakaa"sitaa"scaryyakriyaabhistaa.m kathaa.m pramaa.navatii.m cakaara| iti|</para>
</usx>
