<?xml version="1.0" encoding="UTF-8"?>
<usx version="2.6">
  <book code="EPH" style="id">Sanskrit Bible (NT) in Velthuis Script (satyaveda.h ।)</book>
  <para style="rem">© SanskritBible.in । Licensed under CC BY-SA 4.0</para>
  <para style="h">Ephesians</para>
  <para style="toc1">iphi.si.na.h patra.m</para>
  <para style="toc2">iphi.si.na.h</para>
  <para style="toc3">iphi.si.na.h</para>
  <para style="mt1">iphi.si.na.h patra.m</para>
  <chapter number="1" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>ii"svarasyecchayaa yii"sukhrii.s.tasya prerita.h paula iphi.sanagarasthaan pavitraan khrii.s.tayii"sau vi"svaasino lokaan prati patra.m likhati|</para>
  <para style="p">
    <verse number="2" style="v"/>asmaaka.m taatasye"svarasya prabho ryii"sukhrii.s.tasya caanugraha.h "saanti"sca yu.smaasu varttataa.m|</para>
  <para style="p">
    <verse number="3" style="v"/>asmaaka.m prabho ryii"so.h khrii.s.tasya taata ii"svaro dhanyo bhavatu; yata.h sa khrii.s.tenaasmabhya.m sarvvam aadhyaatmika.m svargiiyavara.m dattavaan|</para>
  <para style="p">
    <verse number="4" style="v"/>vaya.m yat tasya samak.sa.m premnaa pavitraa ni.skala"nkaa"sca bhavaamastadartha.m sa jagata.h s.r.s.te puurvva.m tenaasmaan abhirocitavaan, nijaabhila.sitaanurodhaacca</para>
  <para style="p">
    <verse number="5" style="v"/>yii"sunaa khrii.s.tena svasya nimitta.m putratvapade.asmaan svakiiyaanugrahasya mahattvasya pra"sa.msaartha.m puurvva.m niyuktavaan|</para>
  <para style="p">
    <verse number="6" style="v"/>tasmaad anugrahaat sa yena priyatamena putre.naasmaan anug.rhiitavaan,</para>
  <para style="p">
    <verse number="7" style="v"/>vaya.m tasya "so.nitena muktim arthata.h paapak.samaa.m labdhavanta.h|</para>
  <para style="p">
    <verse number="8" style="v"/>tasya ya iid.r"so.anugrahanidhistasmaat so.asmabhya.m sarvvavidha.m j naana.m buddhi nca baahulyaruupe.na vitaritavaan|</para>
  <para style="p">
    <verse number="9" style="v"/>svargap.rthivyo ryadyad vidyate tatsarvva.m sa khrii.s.te sa.mgrahii.syatiiti hitai.si.naa</para>
  <para style="p">
    <verse number="10" style="v"/>tena k.rto yo manoratha.h sampuur.nataa.m gatavatsu samaye.su saadhayitavyastamadhi sa svakiiyaabhilaa.sasya niguu.dha.m bhaavam asmaan j naapitavaan|</para>
  <para style="p">
    <verse number="11" style="v"/>puurvva.m khrii.s.te vi"svaasino ye vayam asmatto yat tasya mahimna.h pra"sa.msaa jaayate,</para>
  <para style="p">
    <verse number="12" style="v"/>tadartha.m ya.h svakiiyecchaayaa.h mantra.naata.h sarvvaa.ni saadhayati tasya manorathaad vaya.m khrii.s.tena puurvva.m niruupitaa.h santo.adhikaari.no jaataa.h|</para>
  <para style="p">
    <verse number="13" style="v"/>yuuyamapi satya.m vaakyam arthato yu.smatparitraa.nasya susa.mvaada.m ni"samya tasminneva khrii.s.te vi"svasitavanta.h pratij naatena pavitre.naatmanaa mudrayevaa"nkitaa"sca|</para>
  <para style="p">
    <verse number="14" style="v"/>yatastasya mahimna.h prakaa"saaya tena kriitaanaa.m lokaanaa.m mukti ryaavanna bhavi.syati taavat sa aatmaasmaakam adhikaaritvasya satya"nkaarasya pa.nasvaruupo bhavati|</para>
  <para style="p">
    <verse number="15" style="v"/>prabhau yii"sau yu.smaaka.m vi"svaasa.h sarvve.su pavitraloke.su prema caasta iti vaarttaa.m "srutvaahamapi</para>
  <para style="p">
    <verse number="16" style="v"/>yu.smaanadhi nirantaram ii"svara.m dhanya.m vadan praarthanaasamaye ca yu.smaan smaran varamima.m yaacaami|</para>
  <para style="p">
    <verse number="17" style="v"/>asmaaka.m prabho ryii"sukhrii.s.tasya taato ya.h prabhaavaakara ii"svara.h sa svakiiyatattvaj naanaaya yu.smabhya.m j naanajanakam prakaa"sitavaakyabodhaka ncaatmaana.m deyaat|</para>
  <para style="p">
    <verse number="18" style="v"/>yu.smaaka.m j naanacak.suu.m.si ca diiptiyuktaani k.rtvaa tasyaahvaana.m kiid.r"syaa pratyaa"sayaa sambalita.m pavitralokaanaa.m madhye tena datto.adhikaara.h kiid.r"sa.h prabhaavanidhi rvi"svaasi.su caasmaasu prakaa"samaanasya</para>
  <para style="p">
    <verse number="19" style="v"/>tadiiyamahaaparaakramasya mahatva.m kiid.rg anupama.m tat sarvva.m yu.smaan j naapayatu|</para>
  <para style="p">
    <verse number="20" style="v"/>yata.h sa yasyaa.h "sakte.h prabalataa.m khrii.s.te prakaa"sayan m.rtaga.namadhyaat tam utthaapitavaan,</para>
  <para style="p">
    <verse number="21" style="v"/>adhipatitvapada.m "saasanapada.m paraakramo raajatva ncetinaamaani yaavanti padaaniiha loke paraloke ca vidyante te.saa.m sarvve.saam uurddhve svarge nijadak.si.napaar"sve tam upave"sitavaan,</para>
  <para style="p">
    <verse number="22" style="v"/>sarvvaa.ni tasya cara.nayoradho nihitavaan yaa samitistasya "sariira.m sarvvatra sarvve.saa.m puurayitu.h puuraka nca bhavati ta.m tasyaa muurddhaana.m k.rtvaa</para>
  <para style="p">
    <verse number="23" style="v"/>sarvve.saam uparyyupari niyuktavaa.m"sca saiva "saktirasmaasvapi tena prakaa"syate|</para>
  <chapter number="2" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>puraa yuuyam aparaadhai.h paapai"sca m.rtaa.h santastaanyaacaranta ihalokasya sa.msaaraanusaare.naakaa"saraajyasyaadhipatim</para>
  <para style="p">
    <verse number="2" style="v"/>arthata.h saampratam aaj naala"nghiva.m"se.su karmmakaari.nam aatmaanam anvavrajata|</para>
  <para style="p">
    <verse number="3" style="v"/>te.saa.m madhye sarvve vayamapi puurvva.m "sariirasya manaskaamanaayaa ncehaa.m saadhayanta.h sva"sariirasyaabhilaa.saan aacaraama sarvve.anya iva ca svabhaavata.h krodhabhajanaanyabhavaama|</para>
  <para style="p">
    <verse number="4" style="v"/>kintu karu.naanidhirii"svaro yena mahaapremnaasmaan dayitavaan</para>
  <para style="p">
    <verse number="5" style="v"/>tasya svapremno baahulyaad aparaadhai rm.rtaanapyasmaan khrii.s.tena saha jiivitavaan yato.anugrahaad yuuya.m paritraa.na.m praaptaa.h|</para>
  <para style="p">
    <verse number="6" style="v"/>sa ca khrii.s.tena yii"sunaasmaan tena saarddham utthaapitavaan svarga upave"sitavaa.m"sca|</para>
  <para style="p">
    <verse number="7" style="v"/>ittha.m sa khrii.s.tena yii"sunaasmaan prati svahitai.sitayaa bhaaviyuge.su svakiiyaanugrahasyaanupama.m nidhi.m prakaa"sayitum icchati|</para>
  <para style="p">
    <verse number="8" style="v"/>yuuyam anugrahaad vi"svaasena paritraa.na.m praaptaa.h, tacca yu.smanmuulaka.m nahi kintvii"svarasyaiva daana.m,</para>
  <para style="p">
    <verse number="9" style="v"/>tat karmma.naa.m phalam api nahi, ata.h kenaapi na "slaaghitavya.m|</para>
  <para style="p">
    <verse number="10" style="v"/>yato vaya.m tasya kaaryya.m praag ii"svare.na niruupitaabhi.h satkriyaabhi.h kaalayaapanaaya khrii.s.te yii"sau tena m.r.s.taa"sca|</para>
  <para style="p">
    <verse number="11" style="v"/>puraa janmanaa bhinnajaatiiyaa hastak.rta.m tvakcheda.m praaptai rlokai"scaacchinnatvaca itinaamnaa khyaataa ye yuuya.m tai ryu.smaabhirida.m smarttavya.m</para>
  <para style="p">
    <verse number="12" style="v"/>yat tasmin samaye yuuya.m khrii.s.taad bhinnaa israayelalokaanaa.m sahavaasaad duurasthaa.h pratij naasambalitaniyamaanaa.m bahi.h sthitaa.h santo niraa"saa nirii"svaraa"sca jagatyaadhvam iti|</para>
  <para style="p">
    <verse number="13" style="v"/>kintvadhunaa khrii.s.te yii"saavaa"sraya.m praapya puraa duuravarttino yuuya.m khrii.s.tasya "so.nitena nika.tavarttino.abhavata|</para>
  <para style="p">
    <verse number="14" style="v"/>yata.h sa evaasmaaka.m sandhi.h sa dvayam ekiik.rtavaan "satrutaaruupi.nii.m madhyavarttinii.m prabhedakabhitti.m bhagnavaan da.n.daaj naayukta.m vidhi"saastra.m sva"sariire.na luptavaa.m"sca|</para>
  <para style="p">
    <verse number="15" style="v"/>yata.h sa sandhi.m vidhaaya tau dvau svasmin eka.m nutana.m maanava.m karttu.m</para>
  <para style="p">
    <verse number="16" style="v"/>svakiiyakru"se "satrutaa.m nihatya tenaivaikasmin "sariire tayo rdvayorii"svare.na sandhi.m kaarayitu.m ni"scatavaan|</para>
  <para style="p">
    <verse number="17" style="v"/>sa caagatya duuravarttino yu.smaan nika.tavarttino .asmaa.m"sca sandhe rma"ngalavaarttaa.m j naapitavaan|</para>
  <para style="p">
    <verse number="18" style="v"/>yatastasmaad ubhayapak.siiyaa vayam ekenaatmanaa pitu.h samiipa.m gamanaaya saamarthya.m praaptavanta.h|</para>
  <para style="p">
    <verse number="19" style="v"/>ata idaanii.m yuuyam asamparkiiyaa vide"sina"sca na ti.s.thanata.h pavitralokai.h sahavaasina ii"svarasya ve"smavaasina"scaadhve|</para>
  <para style="p">
    <verse number="20" style="v"/>apara.m preritaa bhavi.syadvaadina"sca yatra bhittimuulasvaruupaastatra yuuya.m tasmin muule niciiyadhve tatra ca svaya.m yii"su.h khrii.s.ta.h pradhaana.h ko.nasthaprastara.h|</para>
  <para style="p">
    <verse number="21" style="v"/>tena k.rtsnaa nirmmiti.h sa.mgrathyamaanaa prabho.h pavitra.m mandira.m bhavitu.m varddhate|</para>
  <para style="p">
    <verse number="22" style="v"/>yuuyamapi tatra sa.mgrathyamaanaa aatmane"svarasya vaasasthaana.m bhavatha|</para>
  <chapter number="3" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>ato heto rbhinnajaatiiyaanaa.m yu.smaaka.m nimitta.m yii"sukhrii.s.tasya bandii ya.h so.aha.m paulo braviimi|</para>
  <para style="p">
    <verse number="2" style="v"/>yu.smadartham ii"svare.na mahya.m dattasya varasya niyama.h kiid.r"sastad yu.smaabhira"sraaviiti manye|</para>
  <para style="p">
    <verse number="3" style="v"/>arthata.h puurvva.m mayaa sa.mk.sepe.na yathaa likhita.m tathaaha.m prakaa"sitavaakyene"svarasya niguu.dha.m bhaava.m j naapito.abhava.m|</para>
  <para style="p">
    <verse number="4" style="v"/>ato yu.smaabhistat pa.thitvaa khrii.s.tamadhi tasminniguu.dhe bhaave mama j naana.m kiid.r"sa.m tad bhotsyate|</para>
  <para style="p">
    <verse number="5" style="v"/>puurvvayuge.su maanavasantaanaasta.m j naapitaa naasan kintvadhunaa sa bhaavastasya pavitraan preritaan bhavi.syadvaadina"sca pratyaatmanaa prakaa"sito.abhavat;</para>
  <para style="p">
    <verse number="6" style="v"/>arthata ii"svarasya "sakte.h prakaa"saat tasyaanugrahe.na yo varo mahyam adaayi tenaaha.m yasya susa.mvaadasya paricaarako.abhava.m,</para>
  <para style="p">
    <verse number="7" style="v"/>tadvaaraa khrii.s.tena bhinnajaatiiyaa anyai.h saarddham ekaadhikaaraa eka"sariiraa ekasyaa.h pratij naayaa a.m"sina"sca bhavi.syantiiti|</para>
  <para style="p">
    <verse number="8" style="v"/>sarvve.saa.m pavitralokaanaa.m k.sudratamaaya mahya.m varo.ayam adaayi yad bhinnajaatiiyaanaa.m madhye bodhaagayasya gu.nanidhe.h khrii.s.tasya ma"ngalavaarttaa.m pracaarayaami,</para>
  <para style="p">
    <verse number="9" style="v"/>kaalaavasthaata.h puurvvasmaacca yo niguu.dhabhaava ii"svare gupta aasiit tadiiyaniyama.m sarvvaan j naapayaami|</para>
  <para style="p">
    <verse number="10" style="v"/>yata ii"svarasya naanaaruupa.m j naana.m yat saamprata.m samityaa svarge praadhaanyaparaakramayuktaanaa.m duutaanaa.m nika.te prakaa"syate tadartha.m sa yii"sunaa khrii.s.tena sarvvaa.ni s.r.s.tavaan|</para>
  <para style="p">
    <verse number="11" style="v"/>yato vaya.m yasmin vi"svasya d.r.dhabhaktyaa nirbhayataam ii"svarasya samaagame saamarthya nca</para>
  <para style="p">
    <verse number="12" style="v"/>praaptavantastamasmaaka.m prabhu.m yii"su.m khrii.s.tamadhi sa kaalaavasthaayaa.h puurvva.m ta.m manoratha.m k.rtavaan|</para>
  <para style="p">
    <verse number="13" style="v"/>ato.aha.m yu.smannimitta.m du.hkhabhogena klaanti.m yanna gacchaamiiti praarthaye yatastadeva yu.smaaka.m gaurava.m|</para>
  <para style="p">
    <verse number="14" style="v"/>ato heto.h svargap.rthivyo.h sthita.h k.rtsno va.m"so yasya naamnaa vikhyaatastam</para>
  <para style="p">
    <verse number="15" style="v"/>asmatprabho ryii"sukhrii.s.tasya pitaramuddi"syaaha.m jaanunii paatayitvaa tasya prabhaavanidhito varamima.m praarthaye|</para>
  <para style="p">
    <verse number="16" style="v"/>tasyaatmanaa yu.smaakam aantarikapuru.sasya "sakte rv.rddhi.h kriyataa.m|</para>
  <para style="p">
    <verse number="17" style="v"/>khrii.s.tastu vi"svaasena yu.smaaka.m h.rdaye.su nivasatu| prema.ni yu.smaaka.m baddhamuulatva.m susthiratva nca bhavatu|</para>
  <para style="p">
    <verse number="18" style="v"/>ittha.m prasthataayaa diirghataayaa gabhiirataayaa uccataayaa"sca bodhaaya sarvvai.h pavitralokai.h praapya.m saamarthya.m yu.smaabhi rlabhyataa.m,</para>
  <para style="p">
    <verse number="19" style="v"/>j naanaatirikta.m khrii.s.tasya prema j naayataam ii"svarasya sampuur.nav.rddhiparyyanta.m yu.smaaka.m v.rddhi rbhavatu ca|</para>
  <para style="p">
    <verse number="20" style="v"/>asmaakam antare yaa "sakti.h prakaa"sate tayaa sarvvaatirikta.m karmma kurvvan asmaaka.m praarthanaa.m kalpanaa ncaatikramitu.m ya.h "saknoti</para>
  <para style="p">
    <verse number="21" style="v"/>khrii.s.tayii"sunaa samite rmadhye sarvve.su yuge.su tasya dhanyavaado bhavatu| iti|</para>
  <chapter number="4" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>ato bandiraha.m prabho rnaamnaa yu.smaan vinaye yuuya.m yenaahvaanenaahuutaastadupayuktaruupe.na</para>
  <para style="p">
    <verse number="2" style="v"/>sarvvathaa namrataa.m m.rdutaa.m titik.saa.m paraspara.m pramnaa sahi.s.nutaa ncaacarata|</para>
  <para style="p">
    <verse number="3" style="v"/>pra.nayabandhanena caatmana eैkya.m rak.situ.m yatadhva.m|</para>
  <para style="p">
    <verse number="4" style="v"/>yuuyam eka"sariiraa ekaatmaana"sca tadvad aahvaanena yuuyam ekapratyaa"saapraaptaye samaahuutaa.h|</para>
  <para style="p">
    <verse number="5" style="v"/>yu.smaakam eka.h prabhureko vi"svaasa eka.m majjana.m, sarvve.saa.m taata.h</para>
  <para style="p">
    <verse number="6" style="v"/>sarvvoparistha.h sarvvavyaapii sarvve.saa.m yu.smaaka.m madhyavarttii caika ii"svara aaste|</para>
  <para style="p">
    <verse number="7" style="v"/>kintu khrii.s.tasya daanaparimaa.naanusaaraad asmaakam ekaikasmai vi"se.so varo.adaayi|</para>
  <para style="p">
    <verse number="8" style="v"/>yathaa likhitam aaste, "uurddhvam aaruhya jet.rn sa vijitya bandino.akarot| tata.h sa manujebhyo.api sviiyaan vya"sraa.nayad varaan||"</para>
  <para style="p">
    <verse number="9" style="v"/>uurddhvam aaruhyetivaakyasyaayamartha.h sa puurvva.m p.rthiviiruupa.m sarvvaadha.hsthita.m sthaanam avatiir.navaan;</para>
  <para style="p">
    <verse number="10" style="v"/>ya"scaavatiir.navaan sa eva svargaa.naam uparyyuparyyaaruu.dhavaan yata.h sarvvaa.ni tena puurayitavyaani|</para>
  <para style="p">
    <verse number="11" style="v"/>sa eva ca kaa.m"scana preritaan aparaan bhavi.syadvaadino.aparaan susa.mvaadapracaarakaan aparaan paalakaan upade"sakaa.m"sca niyuktavaan|</para>
  <para style="p">
    <verse number="12" style="v"/>yaavad vaya.m sarvve vi"svaasasye"svaraputravi.sayakasya tattvaj naanasya caikya.m sampuur.na.m puru.sartha ncaarthata.h khrii.s.tasya sampuur.naparimaa.nasya sama.m parimaa.na.m na praapnumastaavat</para>
  <para style="p">
    <verse number="13" style="v"/>sa paricaryyaakarmmasaadhanaaya khrii.s.tasya "sariirasya ni.s.thaayai ca pavitralokaanaa.m siddhataayaastaad.r"sam upaaya.m ni"scitavaan|</para>
  <para style="p">
    <verse number="14" style="v"/>ataeva maanu.saa.naa.m caaturiito bhramakadhuurttataayaa"schalaacca jaatena sarvve.na "sik.saavaayunaa vaya.m yad baalakaa iva dolaayamaanaa na bhraamyaama ityasmaabhi ryatitavya.m,</para>
  <para style="p">
    <verse number="15" style="v"/>premnaa satyataam aacaradbhi.h sarvvavi.saye khrii.s.tam uddi"sya varddhitavya nca, yata.h sa muurddhaa,</para>
  <para style="p">
    <verse number="16" style="v"/>tasmaaccaikaikasyaa"ngasya svasvaparimaa.naanusaare.na saahaayyakara.naad upakaarakai.h sarvvai.h sandhibhi.h k.rtsnasya "sariirasya sa.myoge sammilane ca jaate premnaa ni.s.thaa.m labhamaana.m k.rtsna.m "sariira.m v.rddhi.m praapnoti|</para>
  <para style="p">
    <verse number="17" style="v"/>yu.smaan aha.m prabhuneda.m braviimyaadi"saami ca, anye bhinnajaatiiyaa iva yuuya.m puuna rmaacarata|</para>
  <para style="p">
    <verse number="18" style="v"/>yataste svamanomaayaam aacarantyaantarikaaj naanaat maanasikakaa.thinyaacca timiraav.rtabuddhaya ii"svariiyajiivanasya bagiirbhuutaa"sca bhavanti,</para>
  <para style="p">
    <verse number="19" style="v"/>svaan caitanya"suunyaan k.rtvaa ca lobhena sarvvavidhaa"saucaacara.naaya lampa.tataayaa.m svaan samarpitavanta.h|</para>
  <para style="p">
    <verse number="20" style="v"/>kintu yuuya.m khrii.s.ta.m na taad.r"sa.m paricitavanta.h,</para>
  <para style="p">
    <verse number="21" style="v"/>yato yuuya.m ta.m "srutavanto yaa satyaa "sik.saa yii"suto labhyaa tadanusaaraat tadiiyopade"sa.m praaptavanta"sceti manye|</para>
  <para style="p">
    <verse number="22" style="v"/>tasmaat puurvvakaalikaacaarakaarii ya.h puraatanapuru.so maayaabhilaa.sai rna"syati ta.m tyaktvaa yu.smaabhi rmaanasikabhaavo nuutaniikarttavya.h,</para>
  <para style="p">
    <verse number="23" style="v"/>yo navapuru.sa ii"svaraanuruupe.na pu.nyena satyataasahitena</para>
  <para style="p">
    <verse number="24" style="v"/>dhaarmmikatvena ca s.r.s.ta.h sa eva paridhaatavya"sca|</para>
  <para style="p">
    <verse number="25" style="v"/>ato yuuya.m sarvve mithyaakathana.m parityajya samiipavaasibhi.h saha satyaalaapa.m kuruta yato vaya.m parasparam a"ngapratya"ngaa bhavaama.h|</para>
  <para style="p">
    <verse number="26" style="v"/>apara.m krodhe jaate paapa.m maa kurudhvam, a"saante yu.smaaka.m ro.sesuuryyo.asta.m na gacchatu|</para>
  <para style="p">
    <verse number="27" style="v"/>apara.m "sayataane sthaana.m maa datta|</para>
  <para style="p">
    <verse number="28" style="v"/>cora.h puna"scairyya.m na karotu kintu diinaaya daane saamarthya.m yajjaayate tadartha.m svakaraabhyaa.m sadv.rttyaa pari"srama.m karotu|</para>
  <para style="p">
    <verse number="29" style="v"/>apara.m yu.smaaka.m vadanebhya.h ko.api kadaalaapo na nirgacchatu, kintu yena "sroturupakaaro jaayate taad.r"sa.h prayojaniiyani.s.thaayai phaladaayaka aalaapo yu.smaaka.m bhavatu|</para>
  <para style="p">
    <verse number="30" style="v"/>apara nca yuuya.m muktidinaparyyantam ii"svarasya yena pavitre.naatmanaa mudrayaa"nkitaa abhavata ta.m "sokaanvita.m maa kuruta|</para>
  <para style="p">
    <verse number="31" style="v"/>apara.m ka.tuvaakya.m ro.sa.h ko.sa.h kalaho nindaa sarvvavidhadve.sa"scaitaani yu.smaaka.m madhyaad duuriibhavantu|</para>
  <para style="p">
    <verse number="32" style="v"/>yuuya.m paraspara.m hitai.si.na.h komalaanta.hkara.naa"sca bhavata| aparam ii"svara.h khrii.s.tena yadvad yu.smaaka.m do.saan k.samitavaan tadvad yuuyamapi paraspara.m k.samadhva.m|</para>
  <chapter number="5" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>ato yuuya.m priyabaalakaa ive"svarasyaanukaari.no bhavata,</para>
  <para style="p">
    <verse number="2" style="v"/>khrii.s.ta iva premaacaara.m kuruta ca, yata.h so.asmaasu prema k.rtavaan asmaaka.m vinimayena caatmanivedana.m k.rtvaa graahyasugandhaarthakam upahaara.m bali nce"svaraaca dattavaan|</para>
  <para style="p">
    <verse number="3" style="v"/>kintu ve"syaagamana.m sarvvavidhaa"saucakriyaa lobha"scaite.saam uccaara.namapi yu.smaaka.m madhye na bhavatu, etadeva pavitralokaanaam ucita.m|</para>
  <para style="p">
    <verse number="4" style="v"/>apara.m kutsitaalaapa.h pralaapa.h "sle.sokti"sca na bhavatu yata etaanyanucitaani kintvii"svarasya dhanyavaado bhavatu|</para>
  <para style="p">
    <verse number="5" style="v"/>ve"syaagaamya"saucaacaarii devapuujaka iva ga.nyo lobhii caite.saa.m ko.si khrii.s.tasya raajye.arthata ii"svarasya raajye kamapyadhikaara.m na praapsyatiiti yu.smaabhi.h samyak j naayataa.m|</para>
  <para style="p">
    <verse number="6" style="v"/>anarthakavaakyena ko.api yu.smaan na va ncayatu yatastaad.rgaacaarahetoranaaj naagraahi.su loke.svii"svarasya kopo varttate|</para>
  <para style="p">
    <verse number="7" style="v"/>tasmaad yuuya.m tai.h sahabhaagino na bhavata|</para>
  <para style="p">
    <verse number="8" style="v"/>puurvva.m yuuyam andhakaarasvaruupaa aadhva.m kintvidaanii.m prabhunaa diiptisvaruupaa bhavatha tasmaad diipte.h santaanaa iva samaacarata|</para>
  <para style="p">
    <verse number="9" style="v"/>diipte ryat phala.m tat sarvvavidhahitai.sitaayaa.m dharmme satyaalaape ca prakaa"sate|</para>
  <para style="p">
    <verse number="10" style="v"/>prabhave yad rocate tat pariik.sadhva.m|</para>
  <para style="p">
    <verse number="11" style="v"/>yuuya.m timirasya viphalakarmma.naam a.m"sino na bhuutvaa te.saa.m do.sitva.m prakaa"sayata|</para>
  <para style="p">
    <verse number="12" style="v"/>yataste lokaa rahami yad yad aacaranti taduccaara.nam api lajjaajanaka.m|</para>
  <para style="p">
    <verse number="13" style="v"/>yato diiptyaa yad yat prakaa"syate tat tayaa cakaasyate yacca cakaasti tad diiptisvaruupa.m bhavati|</para>
  <para style="p">
    <verse number="14" style="v"/>etatkaara.naad uktam aaste, "he nidrita prabudhyasva m.rtebhya"scotthiti.m kuru| tatk.rte suuryyavat khrii.s.ta.h svaya.m tvaa.m dyotayi.syati|"</para>
  <para style="p">
    <verse number="15" style="v"/>ata.h saavadhaanaa bhavata, aj naanaa iva maacarata kintu j naanina iva satarkam aacarata|</para>
  <para style="p">
    <verse number="16" style="v"/>samaya.m bahumuulya.m ga.nayadhva.m yata.h kaalaa abhadraa.h|</para>
  <para style="p">
    <verse number="17" style="v"/>tasmaad yuuyam aj naanaa na bhavata kintu prabhorabhimata.m ki.m tadavagataa bhavata|</para>
  <para style="p">
    <verse number="18" style="v"/>sarvvanaa"sajanakena suraapaanena mattaa maa bhavata kintvaatmanaa puuryyadhva.m|</para>
  <para style="p">
    <verse number="19" style="v"/>apara.m giitai rgaanai.h paaramaarthikakiirttanai"sca parasparam aalapanto manasaa saarddha.m prabhum uddi"sya gaayata vaadayata ca|</para>
  <para style="p">
    <verse number="20" style="v"/>sarvvadaa sarvvavi.saye.asmatprabho yii"so.h khrii.s.tasya naamnaa taatam ii"svara.m dhanya.m vadata|</para>
  <para style="p">
    <verse number="21" style="v"/>yuuyam ii"svaraad bhiitaa.h santa anye.apare.saa.m va"siibhuutaa bhavata|</para>
  <para style="p">
    <verse number="22" style="v"/>he yo.sita.h, yuuya.m yathaa prabhostathaa svasvasvaamino va"sa"ngataa bhavata|</para>
  <para style="p">
    <verse number="23" style="v"/>yata.h khrii.s.to yadvat samite rmuurddhaa "sariirasya traataa ca bhavati tadvat svaamii yo.sito muurddhaa|</para>
  <para style="p">
    <verse number="24" style="v"/>ata.h samiti ryadvat khrii.s.tasya va"siibhuutaa tadvad yo.sidbhirapi svasvasvaamino va"sataa sviikarttavyaa|</para>
  <para style="p">
    <verse number="25" style="v"/>apara nca he puru.saa.h, yuuya.m khrii.s.ta iva svasvayo.sitsu priiyadhva.m|</para>
  <para style="p">
    <verse number="26" style="v"/>sa khrii.s.to.api samitau priitavaan tasyaa.h k.rte ca svapraa.naan tyaktavaan yata.h sa vaakye jalamajjanena taa.m pari.sk.rtya paavayitum</para>
  <para style="p">
    <verse number="27" style="v"/>apara.m tilakavalyaadivihiinaa.m pavitraa.m ni.skala"nkaa nca taa.m samiti.m tejasvinii.m k.rtvaa svahaste samarpayitu ncaabhila.sitavaan|</para>
  <para style="p">
    <verse number="28" style="v"/>tasmaat svatanuvat svayo.siti premakara.na.m puru.sasyocita.m, yena svayo.siti prema kriyate tenaatmaprema kriyate|</para>
  <para style="p">
    <verse number="29" style="v"/>ko.api kadaapi na svakiiyaa.m tanum .rtiiyitavaan kintu sarvve taa.m vibhrati pu.s.nanti ca| khrii.s.to.api samiti.m prati tadeva karoti,</para>
  <para style="p">
    <verse number="30" style="v"/>yato vaya.m tasya "sariirasyaa"ngaani maa.msaasthiini ca bhavaama.h|</para>
  <para style="p">
    <verse number="31" style="v"/>etadartha.m maanava.h svamaataapitaroै parityajya svabhaaryyaayaam aasa.mk.syati tau dvau janaavekaa"ngau bhavi.syata.h|</para>
  <para style="p">
    <verse number="32" style="v"/>etanniguu.dhavaakya.m gurutara.m mayaa ca khrii.s.tasamitii adhi tad ucyate|</para>
  <para style="p">
    <verse number="33" style="v"/>ataeva yu.smaakam ekaiko jana aatmavat svayo.siti priiyataa.m bhaaryyaapi svaamina.m samaadarttu.m yatataa.m|</para>
  <chapter number="6" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>he baalakaa.h, yuuya.m prabhum uddi"sya pitroraaj naagraahi.no bhavata yatastat nyaayya.m|</para>
  <para style="p">
    <verse number="2" style="v"/>tva.m nijapitara.m maatara nca sammanyasveti yo vidhi.h sa pratij naayukta.h prathamo vidhi.h</para>
  <para style="p">
    <verse number="3" style="v"/>phalatastasmaat tava kalyaa.na.m de"se ca diirghakaalam aayu rbhavi.syatiiti|</para>
  <para style="p">
    <verse number="4" style="v"/>apara.m he pitara.h, yuuya.m svabaalakaan maa ro.sayata kintu prabho rviniityaade"saabhyaa.m taan vinayata|</para>
  <para style="p">
    <verse number="5" style="v"/>he daasaa.h, yuuya.m khrii.s.tam uddi"sya sabhayaa.h kampaanvitaa"sca bhuutvaa saralaanta.hkara.nairaihikaprabhuunaam aaj naagraahi.no bhavata|</para>
  <para style="p">
    <verse number="6" style="v"/>d.r.s.tigocariiyaparicaryyayaa maanu.sebhyo rocitu.m maa yatadhva.m kintu khrii.s.tasya daasaa iva nivi.s.tamanobhirii"scarasyecchaa.m saadhayata|</para>
  <para style="p">
    <verse number="7" style="v"/>maanavaan anuddi"sya prabhumevoddi"sya sadbhaavena daasyakarmma kurudhva.m|</para>
  <para style="p">
    <verse number="8" style="v"/>daasamuktayo ryena yat satkarmma kriyate tena tasya phala.m prabhuto lapsyata iti jaaniita ca|</para>
  <para style="p">
    <verse number="9" style="v"/>apara.m he prabhava.h, yu.smaabhi rbhartsana.m vihaaya taan prati nyaayyaacara.na.m kriyataa.m ya"sca kasyaapi pak.sapaata.m na karoti yu.smaakamapi taad.r"sa eka.h prabhu.h svarge vidyata iti j naayataa.m|</para>
  <para style="p">
    <verse number="10" style="v"/>adhikantu he bhraatara.h, yuuya.m prabhunaa tasya vikramayukta"saktyaa ca balavanto bhavata|</para>
  <para style="p">
    <verse number="11" style="v"/>yuuya.m yat "sayataana"schalaani nivaarayitu.m "saknutha tadartham ii"svariiyasusajjaa.m paridhaddhva.m|</para>
  <para style="p">
    <verse number="12" style="v"/>yata.h kevala.m raktamaa.msaabhyaam iti nahi kintu kart.rtvaparaakramayuktaistimiraraajyasyehalokasyaadhipatibhi.h svargodbhavai rdu.s.taatmabhireva saarddham asmaabhi ryuddha.m kriyate|</para>
  <para style="p">
    <verse number="13" style="v"/>ato heto ryuuya.m yayaa sa.mkuेle dine.avasthaatu.m sarvvaa.ni paraajitya d.r.dhaa.h sthaatu nca "sak.syatha taam ii"svariiyasusajjaa.m g.rhliita|</para>
  <para style="p">
    <verse number="14" style="v"/>vastutastu satyatvena "s.r"nkhalena ka.ti.m baddhvaa pu.nyena varmma.naa vak.sa aacchaadya</para>
  <para style="p">
    <verse number="15" style="v"/>"saante.h suvaarttayaa jaatam utsaaha.m paadukaayugala.m pade samarpya ti.s.thata|</para>
  <para style="p">
    <verse number="16" style="v"/>yena ca du.s.taatmano.agnibaa.naan sarvvaan nirvvaapayitu.m "sak.syatha taad.r"sa.m sarvvaacchaadaka.m phalaka.m vi"svaasa.m dhaarayata|</para>
  <para style="p">
    <verse number="17" style="v"/>"sirastra.m paritraa.nam aatmana.h kha"nga nce"svarasya vaakya.m dhaarayata|</para>
  <para style="p">
    <verse number="18" style="v"/>sarvvasamaye sarvvayaacanena sarvvapraarthanena caatmanaa praarthanaa.m kurudhva.m tadartha.m d.r.dhaakaa"nk.sayaa jaagrata.h sarvve.saa.m pavitralokaanaa.m k.rte sadaa praarthanaa.m kurudhva.m|</para>
  <para style="p">
    <verse number="19" style="v"/>aha nca yasya susa.mvaadasya "s.r"nkhalabaddha.h pracaarakaduuto.asmi tam upayuktenotsaahena pracaarayitu.m yathaa "saknuyaa.m</para>
  <para style="p">
    <verse number="20" style="v"/>tathaa nirbhayena svare.notsaahena ca susa.mvaadasya niguu.dhavaakyapracaaraaya vakt.rाtaa yat mahya.m diiyate tadartha.m mamaapi k.rte praarthanaa.m kurudhva.m|</para>
  <para style="p">
    <verse number="21" style="v"/>apara.m mama yaavasthaasti yacca mayaa kriyate tat sarvva.m yad yu.smaabhi rj naayate tadartha.m prabhunaa priyabhraataa vi"svaasya.h paricaaraka"sca tukhiko yu.smaan tat j naapayi.syati|</para>
  <para style="p">
    <verse number="22" style="v"/>yuuya.m yad asmaakam avasthaa.m jaaniitha yu.smaaka.m manaa.msi ca yat saantvanaa.m labhante tadarthamevaaha.m yu.smaaka.m sannidhi.m ta.m pre.sitavaana|</para>
  <para style="p">
    <verse number="23" style="v"/>aparam ii"svara.h prabhu ryii"sukhrii.s.ta"sca sarvvebhyo bhraat.rbhya.h "saanti.m vi"svaasasahita.m prema ca deyaat|</para>
  <para style="p">
    <verse number="24" style="v"/>ye kecit prabhau yii"sukhrii.s.te.ak.saya.m prema kurvvanti taan prati prasaado bhuuyaat| tathaastu|</para>
</usx>
