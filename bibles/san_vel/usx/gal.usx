<?xml version="1.0" encoding="UTF-8"?>
<usx version="2.6">
  <book code="GAL" style="id">Sanskrit Bible (NT) in Velthuis Script (satyaveda.h ।)</book>
  <para style="rem">© SanskritBible.in । Licensed under CC BY-SA 4.0</para>
  <para style="h">Galatians</para>
  <para style="toc1">gaalaatina.h patra.m</para>
  <para style="toc2">gaalaatina.h</para>
  <para style="toc3">gaalaatina.h</para>
  <para style="mt1">gaalaatina.h patra.m</para>
  <chapter number="1" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>manu.syebhyo nahi manu.syairapi nahi kintu yii"sukhrii.s.tena m.rtaga.namadhyaat tasyotthaapayitraa pitre"svare.na ca prerito yo.aha.m paula.h so.aha.m</para>
  <para style="p">
    <verse number="2" style="v"/>matsahavarttino bhraatara"sca vaya.m gaalaatiiyade"sasthaa.h samitii.h prati patra.m likhaama.h|</para>
  <para style="p">
    <verse number="3" style="v"/>pitre"svare.naasmaa.mka prabhunaa yii"sunaa khrii.s.tena ca yu.smabhyam anugraha.h "saanti"sca diiyataa.m|</para>
  <para style="p">
    <verse number="4" style="v"/>asmaaka.m taate"svaresyecchaanusaare.na varttamaanaat kutsitasa.msaaraad asmaan nistaarayitu.m yo</para>
  <para style="p">
    <verse number="5" style="v"/>yii"surasmaaka.m paapahetoraatmotsarga.m k.rtavaan sa sarvvadaa dhanyo bhuuyaat| tathaastu|</para>
  <para style="p">
    <verse number="6" style="v"/>khrii.s.tasyaanugrahe.na yo yu.smaan aahuutavaan tasmaanniv.rtya yuuyam atituur.nam anya.m susa.mvaadam anvavarttata tatraaha.m vismaya.m manye|</para>
  <para style="p">
    <verse number="7" style="v"/>so.anyasusa.mvaada.h susa.mvaado nahi kintu kecit maanavaa yu.smaan ca ncaliikurvvanti khrii.s.tiiyasusa.mvaadasya viparyyaya.m karttu.m ce.s.tante ca|</para>
  <para style="p">
    <verse number="8" style="v"/>yu.smaaka.m sannidhau ya.h susa.mvaado.asmaabhi rgho.sitastasmaad anya.h susa.mvaado.asmaaka.m svargiiyaduutaanaa.m vaa madhye kenacid yadi gho.syate tarhi sa "sapto bhavatu|</para>
  <para style="p">
    <verse number="9" style="v"/>puurvva.m yadvad akathayaama, idaaniimaha.m punastadvat kathayaami yuuya.m ya.m susa.mvaada.m g.rhiitavantastasmaad anyo yena kenacid yu.smatsannidhau gho.syate sa "sapto bhavatu|</para>
  <para style="p">
    <verse number="10" style="v"/>saamprata.m kamaham anunayaami? ii"svara.m ki.mvaa maanavaan? aha.m ki.m maanu.sebhyo rocitu.m yate? yadyaham idaaniimapi maanu.sebhyo ruruci.seya tarhi khrii.s.tasya paricaarako na bhavaami|</para>
  <para style="p">
    <verse number="11" style="v"/>he bhraatara.h, mayaa ya.h susa.mvaado gho.sita.h sa maanu.saanna labdhastadaha.m yu.smaan j naapayaami|</para>
  <para style="p">
    <verse number="12" style="v"/>aha.m kasmaaccit manu.syaat ta.m na g.rhiitavaan na vaa "sik.sitavaan kevala.m yii"so.h khrii.s.tasya prakaa"sanaadeva|</para>
  <para style="p">
    <verse number="13" style="v"/>puraa yihuudimataacaarii yadaaham aasa.m tadaa yaad.r"sam aacara.nam akaravam ii"svarasya samiti.m pratyatiivopadrava.m kurvvan yaad.rk taa.m vyanaa"saya.m tadava"sya.m "sruta.m yu.smaabhi.h|</para>
  <para style="p">
    <verse number="14" style="v"/>apara nca puurvvapuru.saparamparaagate.su vaakye.svanyaapek.saatiivaasakta.h san aha.m yihuudidharmmate mama samavayaskaan bahuun svajaatiiyaan atya"sayi|</para>
  <para style="p">
    <verse number="15" style="v"/>ki nca ya ii"svaro maat.rgarbhastha.m maa.m p.rthak k.rtvaa sviiyaanugrahe.naahuutavaan</para>
  <para style="p">
    <verse number="16" style="v"/>sa yadaa mayi svaputra.m prakaa"situ.m bhinnade"siiyaanaa.m samiipe bhayaa ta.m gho.sayitu ncaabhyala.sat tadaaha.m kravya"so.nitaabhyaa.m saha na mantrayitvaa</para>
  <para style="p">
    <verse number="17" style="v"/>puurvvaniyuktaanaa.m preritaanaa.m samiipa.m yiruu"saalama.m na gatvaaravade"sa.m gatavaan pa"scaat tatsthaanaad damme.sakanagara.m paraav.rtyaagatavaan|</para>
  <para style="p">
    <verse number="18" style="v"/>tata.h para.m var.satraye vyatiite.aha.m pitara.m sambhaa.situ.m yiruu"saalama.m gatvaa pa ncada"sadinaani tena saarddham ati.s.tha.m|</para>
  <para style="p">
    <verse number="19" style="v"/>kintu ta.m prabho rbhraatara.m yaakuuba nca vinaa preritaanaa.m naanya.m kamapyapa"sya.m|</para>
  <para style="p">
    <verse number="20" style="v"/>yaanyetaani vaakyaani mayaa likhyante taanyan.rtaani na santi tad ii"svaro jaanaati|</para>
  <para style="p">
    <verse number="21" style="v"/>tata.h param aha.m suriyaa.m kilikiyaa nca de"sau gatavaan|</para>
  <para style="p">
    <verse number="22" style="v"/>tadaanii.m yihuudaade"sasthaanaa.m khrii.s.tasya samitiinaa.m lokaa.h saak.saat mama paricayamapraapya kevala.m jana"srutimimaa.m labdhavanta.h,</para>
  <para style="p">
    <verse number="23" style="v"/>yo jana.h puurvvam asmaan pratyupadravamakarot sa tadaa ya.m dharmmamanaa"sayat tamevedaanii.m pracaarayatiiti|</para>
  <para style="p">
    <verse number="24" style="v"/>tasmaat te maamadhii"svara.m dhanyamavadan|</para>
  <chapter number="2" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>anantara.m caturda"sasu vatsare.su gate.svaha.m bar.nabbaa saha yiruu"saalamanagara.m punaragaccha.m, tadaano.m tiitamapi svasa"nginam akarava.m|</para>
  <para style="p">
    <verse number="2" style="v"/>tatkaale.aham ii"svaradar"sanaad yaatraam akarava.m mayaa ya.h pari"sramo.akaari kaari.syate vaa sa yanni.sphalo na bhavet tadartha.m bhinnajaatiiyaanaa.m madhye mayaa gho.syamaa.na.h susa.mvaadastatratyebhyo lokebhyo vi"se.sato maanyebhyo narebhyo mayaa nyavedyata|</para>
  <para style="p">
    <verse number="3" style="v"/>tato mama sahacarastiito yadyapi yuunaaniiya aasiit tathaapi tasya tvakchedo.apyaava"syako na babhuuva|</para>
  <para style="p">
    <verse number="4" style="v"/>yata"schalenaagataa asmaan daasaan karttum icchava.h katipayaa bhaaktabhraatara.h khrii.s.tena yii"sunaasmabhya.m datta.m svaatantryam anusandhaatu.m caaraa iva samaaja.m praavi"san|</para>
  <para style="p">
    <verse number="5" style="v"/>ata.h prak.rte susa.mvaade yu.smaakam adhikaaro yat ti.s.thet tadartha.m vaya.m da.n.daikamapi yaavad aaj naagraha.nena te.saa.m va"syaa naabhavaama|</para>
  <para style="p">
    <verse number="6" style="v"/>parantu ye lokaa maanyaaste ye kecid bhaveyustaanaha.m na ga.nayaami yata ii"svara.h kasyaapi maanavasya pak.sapaata.m na karoti, ye ca maanyaaste maa.m kimapi naviina.m naaj naapayan|</para>
  <para style="p">
    <verse number="7" style="v"/>kintu chinnatvacaa.m madhye susa.mvaadapracaara.nasya bhaara.h pitari yathaa samarpitastathaivaacchinnatvacaa.m madhye susa.mvaadapracaara.nasya bhaaro mayi samarpita iti tai rbubudhe|</para>
  <para style="p">
    <verse number="8" style="v"/>yata"schinnatvacaa.m madhye preritatvakarmma.ne yasya yaa "sakti.h pitaramaa"sritavatii tasyaiva saa "sakti rbhinnajaatiiyaanaa.m madhye tasmai karmma.ne maamapyaa"sritavatii|</para>
  <para style="p">
    <verse number="9" style="v"/>ato mahya.m dattam anugraha.m pratij naaya stambhaa iva ga.nitaa ye yaakuub kaiphaa yohan caite sahaayataasuucaka.m dak.si.nahastagraha.m.na vidhaaya maa.m bar.nabbaa nca jagadu.h, yuvaa.m bhinnajaatiiyaanaa.m sannidhi.m gacchata.m vaya.m chinnatvacaa sannidhi.m gacchaama.h,</para>
  <para style="p">
    <verse number="10" style="v"/>kevala.m daridraa yuvaabhyaa.m smara.niiyaa iti| atastadeva karttum aha.m yate sma|</para>
  <para style="p">
    <verse number="11" style="v"/>aparam aantiyakhiyaanagara.m pitara aagate.aha.m tasya do.sitvaat samak.sa.m tam abhartsaya.m|</para>
  <para style="p">
    <verse number="12" style="v"/>yata.h sa puurvvam anyajaatiiyai.h saarddham aahaaramakarot tata.h para.m yaakuuba.h samiipaat katipayajane.svaagate.su sa chinnatva"nmanu.syebhyo bhayena niv.rtya p.rthag abhavat|</para>
  <para style="p">
    <verse number="13" style="v"/>tato.apare sarvve yihuudino.api tena saarddha.m kapa.taacaaram akurvvan bar.nabbaa api te.saa.m kaapa.tyena vipathagaamyabhavat|</para>
  <para style="p">
    <verse number="14" style="v"/>tataste prak.rtasusa.mvaadaruupe saralapathe na carantiiti d.r.s.tvaaha.m sarvve.saa.m saak.saat pitaram uktavaan tva.m yihuudii san yadi yihuudimata.m vihaaya bhinnajaatiiya ivaacarasi tarhi yihuudimataacara.naaya bhinnajaatiiyaan kuta.h pravarttayasi?</para>
  <para style="p">
    <verse number="15" style="v"/>aavaa.m janmanaa yihuudinau bhavaavo bhinnajaatiiyau paapinau na bhavaava.h</para>
  <para style="p">
    <verse number="16" style="v"/>kintu vyavasthaapaalanena manu.sya.h sapu.nyo na bhavati kevala.m yii"sau khrii.s.te yo vi"svaasastenaiva sapu.nyo bhavatiiti buddhvaavaamapi vyavasthaapaalana.m vinaa kevala.m khrii.s.te vi"svaasena pu.nyapraaptaye khrii.s.te yii"sau vya"svasiva yato vyavasthaapaalanena ko.api maanava.h pu.nya.m praaptu.m na "saknoti|</para>
  <para style="p">
    <verse number="17" style="v"/>parantu yii"sunaa pu.nyapraaptaye yatamaanaavapyaavaa.m yadi paapinau bhavaavastarhi ki.m vaktavya.m? khrii.s.ta.h paapasya paricaaraka iti? tanna bhavatu|</para>
  <para style="p">
    <verse number="18" style="v"/>mayaa yad bhagna.m tad yadi mayaa punarnirmmiiyate tarhi mayaivaatmado.sa.h prakaa"syate|</para>
  <para style="p">
    <verse number="19" style="v"/>aha.m yad ii"svaraaya jiivaami tadartha.m vyavasthayaa vyavasthaayai amriye|</para>
  <para style="p">
    <verse number="20" style="v"/>khrii.s.tena saarddha.m kru"se hato.asmi tathaapi jiivaami kintvaha.m jiivaamiiti nahi khrii.s.ta eva madanta rjiivati| saamprata.m sa"sariire.na mayaa yajjiivita.m dhaaryyate tat mama dayaakaari.ni madartha.m sviiyapraa.natyaagini ce"svaraputre vi"svasataa mayaa dhaaryyate|</para>
  <para style="p">
    <verse number="21" style="v"/>ahamii"svarasyaanugraha.m naavajaanaami yasmaad vyavasthayaa yadi pu.nya.m bhavati tarhi khrii.s.to nirarthakamamriyata|</para>
  <chapter number="3" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>he nirbbodhaa gaalaatilokaa.h, yu.smaaka.m madhye kru"se hata iva yii"su.h khrii.s.to yu.smaaka.m samak.sa.m prakaa"sita aasiit ato yuuya.m yathaa satya.m vaakya.m na g.rhliitha tathaa kenaamuhyata?</para>
  <para style="p">
    <verse number="2" style="v"/>aha.m yu.smatta.h kathaamekaa.m jij naase yuuyam aatmaana.m kenaalabhadhva.m? vyavasthaapaalanena ki.m vaa vi"svaasavaakyasya "srava.nena?</para>
  <para style="p">
    <verse number="3" style="v"/>yuuya.m kim iid.rg abodhaa yad aatmanaa karmmaarabhya "sariire.na tat saadhayitu.m yatadhve?</para>
  <para style="p">
    <verse number="4" style="v"/>tarhi yu.smaaka.m gurutaro du.hkhabhoga.h ki.m ni.sphalo bhavi.syati? kuphalayukto vaa ki.m bhavi.syati?</para>
  <para style="p">
    <verse number="5" style="v"/>yo yu.smabhyam aatmaana.m dattavaan yu.smanmadhya aa"scaryyaa.ni karmmaa.ni ca saadhitavaan sa ki.m vyavasthaapaalanena vi"svaasavaakyasya "srava.nena vaa tat k.rtavaan?</para>
  <para style="p">
    <verse number="6" style="v"/>likhitamaaste, ibraahiima ii"svare vya"svasiit sa ca vi"svaasastasmai pu.nyaartha.m ga.nito babhuuva,</para>
  <para style="p">
    <verse number="7" style="v"/>ato ye vi"svaasaa"sritaasta evebraahiima.h santaanaa iti yu.smaabhi rj naayataa.m|</para>
  <para style="p">
    <verse number="8" style="v"/>ii"svaro bhinnajaatiiyaan vi"svaasena sapu.nyiikari.syatiiti puurvva.m j naatvaa "saastradaataa puurvvam ibraahiima.m susa.mvaada.m "sraavayana jagaada, tvatto bhinnajaatiiyaa.h sarvva aa"si.sa.m praapsyantiiti|</para>
  <para style="p">
    <verse number="9" style="v"/>ato ye vi"svaasaa"sritaaste vi"svaasinebraahiimaa saarddham aa"si.sa.m labhante|</para>
  <para style="p">
    <verse number="10" style="v"/>yaavanto lokaa vyavasthaayaa.h karmma.nyaa"srayanti te sarvve "saapaadhiinaa bhavanti yato likhitamaaste, yathaa, "ya.h ka"scid etasya vyavasthaagranthasya sarvvavaakyaani ni"scidra.m na paalayati sa "sapta iti|"</para>
  <para style="p">
    <verse number="11" style="v"/>ii"svarasya saak.saat ko.api vyavasthayaa sapu.nyo na bhavati tada vyakta.m yata.h "pu.nyavaan maanavo vi"svaasena jiivi.syatiiti" "saastriiya.m vaca.h|</para>
  <para style="p">
    <verse number="12" style="v"/>vyavasthaa tu vi"svaasasambandhinii na bhavati kintvetaani ya.h paalayi.syati sa eva tai rjiivi.syatiitiniyamasambandhinii|</para>
  <para style="p">
    <verse number="13" style="v"/>khrii.s.to.asmaan parikriiya vyavasthaayaa.h "saapaat mocitavaan yato.asmaaka.m vinimayena sa svaya.m "saapaaspadamabhavat tadadhi likhitamaaste, yathaa, "ya.h ka"scit taraavullambyate so.abhi"sapta iti|"</para>
  <para style="p">
    <verse number="14" style="v"/>tasmaad khrii.s.tena yii"sunevraahiima aa"sii rbhinnajaatiiyaloke.su varttate tena vaya.m pratij naatam aatmaana.m vi"svaasena labdhu.m "saknuma.h|</para>
  <para style="p">
    <verse number="15" style="v"/>he bhraat.rga.na maanu.saa.naa.m riityanusaare.naaha.m kathayaami kenacit maanavena yo niyamo niracaayi tasya vik.rti rv.rddhi rvaa kenaapi na kriyate|</para>
  <para style="p">
    <verse number="16" style="v"/>parantvibraahiime tasya santaanaaya ca pratij naa.h prati "su"sruvire tatra santaana"sabda.m bahuvacanaantam abhuutvaa tava santaanaayetyekavacanaanta.m babhuuva sa ca santaana.h khrii.s.ta eva|</para>
  <para style="p">
    <verse number="17" style="v"/>ataevaaha.m vadaami, ii"svare.na yo niyama.h puraa khrii.s.tamadhi niracaayi tata.h para.m tri.m"sadadhikacatu.h"satavatsare.su gate.su sthaapitaa vyavasthaa ta.m niyama.m nirarthakiik.rtya tadiiyapratij naa loptu.m na "saknoti|</para>
  <para style="p">
    <verse number="18" style="v"/>yasmaat sampadadhikaaro yadi vyavasthayaa bhavati tarhi pratij nayaa na bhavati kintvii"svara.h pratij nayaa tadadhikaaritvam ibraahiime .adadaat|</para>
  <para style="p">
    <verse number="19" style="v"/>tarhi vyavasthaa kimbhuutaa? pratij naa yasmai prati"srutaa tasya santaanasyaagamana.m yaavad vyabhicaaranivaara.naartha.m vyavasthaapi dattaa, saa ca duutairaaj naapitaa madhyasthasya kare samarpitaa ca|</para>
  <para style="p">
    <verse number="20" style="v"/>naikasya madhyastho vidyate kintvii"svara eka eva|</para>
  <para style="p">
    <verse number="21" style="v"/>tarhi vyavasthaa kim ii"svarasya pratij naanaa.m viruddhaa? tanna bhavatu| yasmaad yadi saa vyavasthaa jiivanadaanesamarthaabhavi.syat tarhi vyavasthayaiva pu.nyalaabho.abhavi.syat|</para>
  <para style="p">
    <verse number="22" style="v"/>kintu yii"sukhrii.s.te yo vi"svaasastatsambandhiyaa.h pratij naayaa.h phala.m yad vi"svaasilokebhyo diiyate tadartha.m "saastradaataa sarvvaan paapaadhiinaan ga.nayati|</para>
  <para style="p">
    <verse number="23" style="v"/>ataeva vi"svaasasyaanaagatasamaye vaya.m vyavasthaadhiinaa.h santo vi"svaasasyodaya.m yaavad ruddhaa ivaarak.syaamahe|</para>
  <para style="p">
    <verse number="24" style="v"/>ittha.m vaya.m yad vi"svaasena sapu.nyiibhavaamastadartha.m khrii.s.tasya samiipam asmaan netu.m vyavasthaagratho.asmaaka.m vinetaa babhuuva|</para>
  <para style="p">
    <verse number="25" style="v"/>kintvadhunaagate vi"svaase vaya.m tasya vineturanadhiinaa abhavaama|</para>
  <para style="p">
    <verse number="26" style="v"/>khrii.s.te yii"sau vi"svasanaat sarvve yuuyam ii"svarasya santaanaa jaataa.h|</para>
  <para style="p">
    <verse number="27" style="v"/>yuuya.m yaavanto lokaa.h khrii.s.te majjitaa abhavata sarvve khrii.s.ta.m parihitavanta.h|</para>
  <para style="p">
    <verse number="28" style="v"/>ato yu.smanmadhye yihuudiyuunaanino rdaasasvatantrayo ryo.saapuru.sayo"sca ko.api vi"se.so naasti; sarvve yuuya.m khrii.s.te yii"saaveka eva|</para>
  <para style="p">
    <verse number="29" style="v"/>ki nca yuuya.m yadi khrii.s.tasya bhavatha tarhi sutaraam ibraahiima.h santaanaa.h pratij nayaa sampadadhikaari.na"scaadhve|</para>
  <chapter number="4" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>aha.m vadaami sampadadhikaarii yaavad baalasti.s.thati taavat sarvvasvasyaadhipati.h sannapi sa daasaat kenaapi vi.saye.na na vi"si.syate</para>
  <para style="p">
    <verse number="2" style="v"/>kintu pitraa niruupita.m samaya.m yaavat paalakaanaa.m dhanaadhyak.saa.naa nca nighnasti.s.thati|</para>
  <para style="p">
    <verse number="3" style="v"/>tadvad vayamapi baalyakaale daasaa iva sa.msaarasyaak.saramaalaayaa adhiinaa aasmahe|</para>
  <para style="p">
    <verse number="4" style="v"/>anantara.m samaye sampuur.nataa.m gatavati vyavasthaadhiinaanaa.m mocanaartham</para>
  <para style="p">
    <verse number="5" style="v"/>asmaaka.m putratvapraaptyartha nce"svara.h striyaa jaata.m vyavasthaayaa adhiniibhuuta nca svaputra.m pre.sitavaan|</para>
  <para style="p">
    <verse number="6" style="v"/>yuuya.m santaanaa abhavata tatkaara.naad ii"svara.h svaputrasyaatmaanaa.m yu.smaakam anta.hkara.naani prahitavaan sa caatmaa pita.h pitarityaahvaana.m kaarayati|</para>
  <para style="p">
    <verse number="7" style="v"/>ata idaanii.m yuuya.m na daasaa.h kintu.h santaanaa eva tasmaat santaanatvaacca khrii.s.tene"svariiyasampadadhikaari.no.apyaadhve|</para>
  <para style="p">
    <verse number="8" style="v"/>apara nca puurvva.m yuuyam ii"svara.m na j naatvaa ye svabhaavato.anii"svaraaste.saa.m daasatve.ati.s.thata|</para>
  <para style="p">
    <verse number="9" style="v"/>idaaniim ii"svara.m j naatvaa yadi ve"svare.na j naataa yuuya.m katha.m punastaani viphalaani tucchaani caak.saraa.ni prati paraavarttitu.m "saknutha? yuuya.m ki.m punaste.saa.m daasaa bhavitumicchatha?</para>
  <para style="p">
    <verse number="10" style="v"/>yuuya.m divasaan maasaan tithiin sa.mvatsaraa.m"sca sammanyadhve|</para>
  <para style="p">
    <verse number="11" style="v"/>yu.smadartha.m mayaa ya.h pari"sramo.akaari sa viphalo jaata iti yu.smaanadhyaha.m bibhemi|</para>
  <para style="p">
    <verse number="12" style="v"/>he bhraatara.h, aha.m yaad.r"so.asmi yuuyamapi taad.r"saa bhavateti praarthaye yato.ahamapi yu.smattulyo.abhava.m yu.smaabhi rmama kimapi naaparaaddha.m|</para>
  <para style="p">
    <verse number="13" style="v"/>puurvvamaha.m kalevarasya daurbbalyena yu.smaan susa.mvaadam aj naapayamiti yuuya.m jaaniitha|</para>
  <para style="p">
    <verse number="14" style="v"/>tadaanii.m mama pariik.saka.m "saariirakle"sa.m d.r.s.tvaa yuuya.m maam avaj naaya .rtiiyitavantastannahi kintvii"svarasya duutamiva saak.saat khrii.s.ta yii"sumiva vaa maa.m g.rhiitavanta.h|</para>
  <para style="p">
    <verse number="15" style="v"/>atastadaanii.m yu.smaaka.m yaa dhanyataabhavat saa kka gataa? tadaanii.m yuuya.m yadi sve.saa.m nayanaanyutpaa.tya mahya.m daatum a"sak.syata tarhi tadapyakari.syateti pramaa.nam aha.m dadaami|</para>
  <para style="p">
    <verse number="16" style="v"/>saampratamaha.m satyavaaditvaat ki.m yu.smaaka.m ripu rjaato.asmi?</para>
  <para style="p">
    <verse number="17" style="v"/>te yu.smatk.rte sparddhante kintu saa sparddhaa kutsitaa yato yuuya.m taanadhi yat sparddhadhva.m tadartha.m te yu.smaan p.rthak karttum icchanti|</para>
  <para style="p">
    <verse number="18" style="v"/>kevala.m yu.smatsamiipe mamopasthitisamaye tannahi, kintu sarvvadaiva bhadramadhi sparddhana.m bhadra.m|</para>
  <para style="p">
    <verse number="19" style="v"/>he mama baalakaa.h, yu.smadanta ryaavat khrii.s.to muurtimaan na bhavati taavad yu.smatkaara.naat puna.h prasavavedaneva mama vedanaa jaayate|</para>
  <para style="p">
    <verse number="20" style="v"/>ahamidaanii.m yu.smaaka.m sannidhi.m gatvaa svaraantare.na yu.smaan sambhaa.situ.m kaamaye yato yu.smaanadhi vyaakulo.asmi|</para>
  <para style="p">
    <verse number="21" style="v"/>he vyavasthaadhiinataakaa"nk.si.na.h yuuya.m ki.m vyavasthaayaa vacana.m na g.rhliitha?</para>
  <para style="p">
    <verse number="22" style="v"/>tanmaa.m vadata| likhitamaaste, ibraahiimo dvau putraavaasaate tayoreko daasyaa.m dvitiiya"sca patnyaa.m jaata.h|</para>
  <para style="p">
    <verse number="23" style="v"/>tayo ryo daasyaa.m jaata.h sa "saariirikaniyamena jaj ne ya"sca patnyaa.m jaata.h sa pratij nayaa jaj ne|</para>
  <para style="p">
    <verse number="24" style="v"/>idamaakhyaana.m d.r.s.tantasvaruupa.m| te dve yo.sitaavii"svariiyasandhii tayorekaa siinayaparvvataad utpannaa daasajanayitrii ca saa tu haajiraa|</para>
  <para style="p">
    <verse number="25" style="v"/>yasmaad haajiraa"sabdenaaravade"sasthasiinayaparvvato bodhyate, saa ca varttamaanaayaa yiruu"saalampuryyaa.h sad.r"sii| yata.h svabaalai.h sahitaa saa daasatva aaste|</para>
  <para style="p">
    <verse number="26" style="v"/>kintu svargiiyaa yiruu"saalampurii patnii sarvve.saam asmaaka.m maataa caaste|</para>
  <para style="p">
    <verse number="27" style="v"/>yaad.r"sa.m likhitam aaste, "vandhye santaanahiine tva.m svara.m jayajaya.m kuru| aprasuute tvayollaaso jayaa"sabda"sca giiyataa.m| yata eva sanaathaayaa yo.sita.h santate rga.naat| anaathaa yaa bhavennaarii tadapatyaani bhuuri"sa.h||"</para>
  <para style="p">
    <verse number="28" style="v"/>he bhraat.rga.na, imhaak iva vaya.m pratij nayaa jaataa.h santaanaa.h|</para>
  <para style="p">
    <verse number="29" style="v"/>kintu tadaanii.m "saariirikaniyamena jaata.h putro yadvad aatmikaniyamena jaata.m putram upaadravat tathaadhunaapi|</para>
  <para style="p">
    <verse number="30" style="v"/>kintu "saastre ki.m likhita.m? "tvam imaa.m daasii.m tasyaa.h putra ncaapasaaraya yata e.sa daasiiputra.h patniiputre.na sama.m nottaraadhikaarii bhaviyyatiiti|"</para>
  <para style="p">
    <verse number="31" style="v"/>ataeva he bhraatara.h, vaya.m daasyaa.h santaanaa na bhuutvaa paatnyaa.h santaanaa bhavaama.h|</para>
  <chapter number="5" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>khrii.s.to.asmabhya.m yat svaatantrya.m dattavaan yuuya.m tatra sthiraasti.s.thata daasatvayugena puna rna nibadhyadhva.m|</para>
  <para style="p">
    <verse number="2" style="v"/>pa"syataaha.m paulo yu.smaan vadaami yadi chinnatvaco bhavatha tarhi khrii.s.tena kimapi nopakaari.syadhve|</para>
  <para style="p">
    <verse number="3" style="v"/>apara.m ya.h ka"scit chinnatvag bhavati sa k.rtsnavyavasthaayaa.h paalanam ii"svaraaya dhaarayatiiti pramaa.na.m dadaami|</para>
  <para style="p">
    <verse number="4" style="v"/>yu.smaaka.m yaavanto lokaa vyavasthayaa sapu.nyiibhavitu.m ce.s.tante te sarvve khrii.s.taad bhra.s.taa anugrahaat patitaa"sca|</para>
  <para style="p">
    <verse number="5" style="v"/>yato vayam aatmanaa vi"svaasaat pu.nyalaabhaa"saasiddha.m pratiik.saamahe|</para>
  <para style="p">
    <verse number="6" style="v"/>khrii.s.te yii"sau tvakchedaatvakchedayo.h kimapi gu.na.m naasti kintu premnaa saphalo vi"svaasa eva gu.nayukta.h|</para>
  <para style="p">
    <verse number="7" style="v"/>puurvva.m yuuya.m sundaram adhaavata kintvidaanii.m kena baadhaa.m praapya satyataa.m na g.rhliitha?</para>
  <para style="p">
    <verse number="8" style="v"/>yu.smaaka.m saa mati ryu.smadaahvaanakaari.na ii"svaraanna jaataa|</para>
  <para style="p">
    <verse number="9" style="v"/>vikaara.h k.rtsna"saktuunaa.m svalpaki.nvena jasayate|</para>
  <para style="p">
    <verse number="10" style="v"/>yu.smaaka.m mati rvikaara.m na gami.syatiityaha.m yu.smaanadhi prabhunaa"sa.mse; kintu yo yu.smaan vicaaralayati sa ya.h ka"scid bhavet samucita.m da.n.da.m praapsyati|</para>
  <para style="p">
    <verse number="11" style="v"/>parantu he bhraatara.h, yadyaham idaaniim api tvakcheda.m pracaarayeya.m tarhi kuta upadrava.m bhu njiya? tatk.rte kru"sa.m nirbbaadham abhavi.syat|</para>
  <para style="p">
    <verse number="12" style="v"/>ye janaa yu.smaaka.m caa ncalya.m janayanti te.saa.m chedanameva mayaabhila.syate|</para>
  <para style="p">
    <verse number="13" style="v"/>he bhraatara.h, yuuya.m svaatantryaartham aahuutaa aadhve kintu tatsvaatantryadvaare.na "saariirikabhaavo yu.smaan na pravi"satu| yuuya.m premnaa paraspara.m paricaryyaa.m kurudhva.m|</para>
  <para style="p">
    <verse number="14" style="v"/>yasmaat tva.m samiipavaasini svavat prema kuryyaa ityekaaj naa k.rtsnaayaa vyavasthaayaa.h saarasa.mgraha.h|</para>
  <para style="p">
    <verse number="15" style="v"/>kintu yuuya.m yadi paraspara.m da.mda"syadhve .a"saa"syadhve ca tarhi yu.smaakam eko.anyena yanna grasyate tatra yu.smaabhi.h saavadhaanai rbhavitavya.m|</para>
  <para style="p">
    <verse number="16" style="v"/>aha.m braviimi yuuyam aatmikaacaara.m kuruta "saariirikaabhilaa.sa.m maa puurayata|</para>
  <para style="p">
    <verse number="17" style="v"/>yata.h "saariirikaabhilaa.sa aatmano vipariita.h, aatmikaabhilaa.sa"sca "sariirasya vipariita.h, anayorubhayo.h paraspara.m virodho vidyate tena yu.smaabhi ryad abhila.syate tanna karttavya.m|</para>
  <para style="p">
    <verse number="18" style="v"/>yuuya.m yadyaatmanaa viniiyadhve tarhi vyavasthaayaa adhiinaa na bhavatha|</para>
  <para style="p">
    <verse number="19" style="v"/>apara.m paradaaragamana.m ve"syaagamanam a"sucitaa kaamukataa pratimaapuujanam</para>
  <para style="p">
    <verse number="20" style="v"/>indrajaala.m "satrutva.m vivaado.antarjvalana.m krodha.h kalaho.anaikya.m</para>
  <para style="p">
    <verse number="21" style="v"/>paarthakyam iir.syaa vadho mattatva.m lampa.tatvamityaadiini spa.s.tatvena "saariirikabhaavasya karmmaa.ni santi| puurvva.m yadvat mayaa kathita.m tadvat punarapi kathyate ye janaa etaad.r"saani karmmaa.nyaacaranti tairii"svarasya raajye.adhikaara.h kadaaca na lapsyate|</para>
  <para style="p">
    <verse number="22" style="v"/>ki nca premaananda.h "saanti"scirasahi.s.nutaa hitai.sitaa bhadratva.m vi"svaasyataa titik.saa</para>
  <para style="p">
    <verse number="23" style="v"/>parimitabhojitvamityaadiinyaatmana.h phalaani santi te.saa.m viruddhaa kaapi vyavasthaa nahi|</para>
  <para style="p">
    <verse number="24" style="v"/>ye tu khrii.s.tasya lokaaste ripubhirabhilaa.sai"sca sahita.m "saariirikabhaava.m kru"se nihatavanta.h|</para>
  <para style="p">
    <verse number="25" style="v"/>yadi vayam aatmanaa jiivaamastarhyaatmikaacaaro.asmaabhi.h karttavya.h,</para>
  <para style="p">
    <verse number="26" style="v"/>darpa.h paraspara.m nirbhartsana.m dve.sa"scaasmaabhi rna karttavyaani|</para>
  <chapter number="6" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>he bhraatara.h, yu.smaaka.m ka"scid yadi kasmi.m"scit paape patati tarhyaatmikabhaavayuktai ryu.smaabhistitik.saabhaava.m vidhaaya sa punarutthaapyataa.m yuuyamapi yathaa taad.rkpariik.saayaa.m na patatha tathaa saavadhaanaa bhavata|</para>
  <para style="p">
    <verse number="2" style="v"/>yu.smaakam ekaiko jana.h parasya bhaara.m vahatvanena prakaare.na khrii.s.tasya vidhi.m paalayata|</para>
  <para style="p">
    <verse number="3" style="v"/>yadi ka"scana k.sudra.h san sva.m mahaanta.m manyate tarhi tasyaatmava ncanaa jaayate|</para>
  <para style="p">
    <verse number="4" style="v"/>ata ekaikena janena svakiiyakarmma.na.h pariik.saa kriyataa.m tena para.m naalokya kevalam aatmaalokanaat tasya "slaghaa sambhavi.syati|</para>
  <para style="p">
    <verse number="5" style="v"/>yata ekaikoे jana.h svakiiya.m bhaara.m vak.syati|</para>
  <para style="p">
    <verse number="6" style="v"/>yo jano dharmmopade"sa.m labhate sa upade.s.taara.m sviiyasarvvasampatte rbhaagina.m karotu|</para>
  <para style="p">
    <verse number="7" style="v"/>yu.smaaka.m bhraanti rna bhavatu, ii"svaro nopahasitavya.h, yena yad biijam upyate tena tajjaata.m "sasya.m kartti.syate|</para>
  <para style="p">
    <verse number="8" style="v"/>sva"sariiraartha.m yena biijam upyate tena "sariiraad vinaa"saruupa.m "sasya.m lapsyate kintvaatmana.h k.rte yena biijam upyate tenaatmato.anantajiivitaruupa.m "sasya.m lapsyate|</para>
  <para style="p">
    <verse number="9" style="v"/>satkarmmakara.ne.asmaabhira"sraantai rbhavitavya.m yato.aklaantausti.s.thadbhirasmaabhirupayuktasamaye tat phalaani lapsyante|</para>
  <para style="p">
    <verse number="10" style="v"/>ato yaavat samayasti.s.thati taavat sarvvaan prati vi"se.sato vi"svaasave"smavaasina.h pratyasmaabhi rhitaacaara.h karttavya.h|</para>
  <para style="p">
    <verse number="11" style="v"/>he bhraatara.h, aha.m svahastena yu.smaan prati kiyadv.rhat patra.m likhitavaan tad yu.smaabhi rd.r"syataa.m|</para>
  <para style="p">
    <verse number="12" style="v"/>ye "saariirikavi.saye sud.r"syaa bhavitumicchanti te yat khrii.s.tasya kru"sasya kaara.naadupadravasya bhaagino na bhavanti kevala.m tadartha.m tvakchede yu.smaan pravarttayanti|</para>
  <para style="p">
    <verse number="13" style="v"/>te tvakchedagraahi.no.api vyavasthaa.m na paalayanti kintu yu.smacchariiraat "slaaghaalaabhaartha.m yu.smaaka.m tvakchedam icchanti|</para>
  <para style="p">
    <verse number="14" style="v"/>kintu yenaaha.m sa.msaaraaya hata.h sa.msaaro.api mahya.m hatastadasmatprabho ryii"sukhrii.s.tasya kru"sa.m vinaanyatra kutraapi mama "slaaghana.m kadaapi na bhavatu|</para>
  <para style="p">
    <verse number="15" style="v"/>khrii.s.te yii"sau tvakchedaatvakchedayo.h kimapi gu.na.m naasti kintu naviinaa s.r.s.tireva gu.nayuktaa|</para>
  <para style="p">
    <verse number="16" style="v"/>apara.m yaavanto lokaa etasmin maarge caranti te.saam ii"svariiyasya k.rtsnasyesraayela"sca "saanti rdayaalaabha"sca bhuuyaat|</para>
  <para style="p">
    <verse number="17" style="v"/>ita.h para.m ko.api maa.m na kli"snaatu yasmaad aha.m svagaatre prabho ryii"sukhrii.s.tasya cihnaani dhaaraye|</para>
  <para style="p">
    <verse number="18" style="v"/>he bhraatara.h asmaaka.m prabho ryii"sukhrii.s.tasya prasaado yu.smaakam aatmani stheyaat| tathaastu|</para>
</usx>
