  <para style="h">3 John</para>
  <para style="toc1">3 yohana.h patra.m</para>
  <para style="toc2">3 yohana.h</para>
  <para style="toc3">3 yohana.h</para>
  <para style="mt1">3 yohana.h patra.m</para>
  <chapter number="1" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>praaciino .aha.m satyamataad yasmin priiye ta.m priyatama.m gaaya.m prati patra.m likhaami|</para>
  <para style="p">
    <verse number="2" style="v"/>he priya, tavaatmaa yaad.rk "subhaanvitastaad.rk sarvvavi.saye tava "subha.m svaasthya nca bhuuyaat|</para>
  <para style="p">
    <verse number="3" style="v"/>bhraat.rbhiraagatya tava satyamatasyaarthatastva.m kiid.rk satyamatamaacarasyetasya saak.sye datte mama mahaanando jaata.h|</para>
  <para style="p">
    <verse number="4" style="v"/>mama santaanaa.h satyamatamaacarantiitivaarttaato mama ya aanando jaayate tato mahattaro naasti|</para>
  <para style="p">
    <verse number="5" style="v"/>he priya, bhraat.rn prati vi"se.satastaan vide"sino bh.rाt.rn prati tvayaa yadyat k.rta.m tat sarvva.m vi"svaasino yogya.m|</para>
  <para style="p">
    <verse number="6" style="v"/>te ca samite.h saak.saat tava pramna.h pramaa.na.m dattavanta.h, aparam ii"svarayogyaruupe.na taan prasthaapayataa tvayaa satkarmma kaari.syate|</para>
  <para style="p">
    <verse number="7" style="v"/>yataste tasya naamnaa yaatraa.m vidhaaya bhinnajaatiiyebhya.h kimapi na g.rhiitavanta.h|</para>
  <para style="p">
    <verse number="8" style="v"/>tasmaad vaya.m yat satyamatasya sahaayaa bhavema tadarthametaad.r"saa lokaa asmaabhiranugrahiitavyaa.h|</para>
  <para style="p">
    <verse number="9" style="v"/>samiti.m pratyaha.m patra.m likhitavaan kintu te.saa.m madhye yo diyatriphi.h pradhaanaayate so .asmaan na g.rhlaati|</para>
  <para style="p">
    <verse number="10" style="v"/>ato .aha.m yadopasthaasyaami tadaa tena yadyat kriyate tat sarvva.m ta.m smaarayi.syaami, yata.h sa durvvaakyairasmaan apavadati, tenaapi t.rpti.m na gatvaa svayamapi bhraat.rn naanug.rhlaati ye caanugrahiitumicchanti taan samitito .api bahi.skaroti|</para>
  <para style="p">
    <verse number="11" style="v"/>he priya, tvayaa du.skarmma naanukriyataa.m kintu satkarmmaiva| ya.h satkarmmaacaarii sa ii"svaraat jaata.h, yo du.skarmmaacaarii sa ii"svara.m na d.r.s.tavaan|</para>
  <para style="p">
    <verse number="12" style="v"/>diimiitriyasya pak.se sarvvai.h saak.syam adaayi vi"se.sata.h satyamatenaapi, vayamapi tatpak.se saak.sya.m dadma.h, asmaaka nca saak.sya.m satyameveti yuuya.m jaaniitha|</para>
  <para style="p">
    <verse number="13" style="v"/>tvaa.m prati mayaa bahuuni lekhitavyaani kintu masiilekhaniibhyaa.m lekhitu.m necchaami|</para>
  <para style="p">
    <verse number="14" style="v"/>acire.na tvaa.m drak.syaamiiti mama pratyaa"saaste tadaavaa.m sammukhiibhuuya paraspara.m sambhaa.si.syaavahe|</para>
  <para style="p">
    <verse number="15" style="v"/>tava "saanti rbhuuyaat| asmaaka.m mitraa.ni tvaa.m namaskaara.m j naapayanti tvamapyekaikasya naama procya mitrebhyo namaskuru| iti|</para>
</usx>
