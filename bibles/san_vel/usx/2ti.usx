<?xml version="1.0" encoding="UTF-8"?>
<usx version="2.6">
  <book code="2TI" style="id">Sanskrit Bible (NT) in Velthuis Script (satyaveda.h ।)</book>
  <para style="rem">© SanskritBible.in । Licensed under CC BY-SA 4.0</para>
  <para style="h">2 Timothy</para>
  <para style="toc1">2 tiimathiya.m patra.m</para>
  <para style="toc2">2 tiimathiya.h</para>
  <para style="toc3">2 tiimathiya.h</para>
  <para style="mt1">2 tiimathiya.m patra.m</para>
  <chapter number="1" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>khrii.s.tena yii"sunaa yaa jiivanasya pratij naa taamadhii"svarasyecchayaa yii"so.h khrii.s.tasyaika.h prerita.h paulo.aha.m svakiiya.m priya.m dharmmaputra.m tiimathiya.m prati patra.m likhaami|</para>
  <para style="p">
    <verse number="2" style="v"/>taata ii"svaro.asmaaka.m prabhu ryii"sukhrii.s.ta"sca tvayi prasaada.m dayaa.m "saanti nca kriyaastaa.m|</para>
  <para style="p">
    <verse number="3" style="v"/>aham aa puurvvapuru.saat yam ii"svara.m pavitramanasaa seve ta.m dhanya.m vadana.m kathayaami, aham ahoraatra.m praarthanaasamaye tvaa.m nirantara.m smaraami|</para>
  <para style="p">
    <verse number="4" style="v"/>ya"sca vi"svaasa.h prathame loyiinaamikaayaa.m tava maataamahyaam uniikiinaamikaayaa.m maatari caati.s.that tavaantare.api ti.s.thatiiti manye</para>
  <para style="p">
    <verse number="5" style="v"/>tava ta.m ni.skapa.ta.m vi"svaasa.m manasi kurvvan tavaa"srupaata.m smaran yathaanandena praphallo bhaveya.m tadartha.m tava dar"sanam aakaa"nk.se|</para>
  <para style="p">
    <verse number="6" style="v"/>ato heto rmama hastaarpa.nena labdho ya ii"svarasya varastvayi vidyate tam ujjvaalayitu.m tvaa.m smaarayaami|</para>
  <para style="p">
    <verse number="7" style="v"/>yata ii"svaro.asmabhya.m bhayajanakam aatmaanam adattvaa "saktipremasatarkataanaam aakaram aatmaana.m dattavaan|</para>
  <para style="p">
    <verse number="8" style="v"/>ataevaasmaaka.m prabhumadhi tasya vandidaasa.m maamadhi ca pramaa.na.m daatu.m na trapasva kintvii"svariiya"saktyaa susa.mvaadasya k.rte du.hkhasya sahabhaagii bhava|</para>
  <para style="p">
    <verse number="9" style="v"/>so.asmaan paritraa.napaatraa.ni k.rtavaan pavitre.naahvaanenaahuutavaa.m"sca; asmatkarmmahetuneti nahi sviiyaniruupaa.nasya prasaadasya ca k.rte tat k.rtavaan| sa prasaada.h s.r.s.te.h puurvvakaale khrii.s.tena yii"sunaasmabhyam adaayi,</para>
  <para style="p">
    <verse number="10" style="v"/>kintvadhunaasmaaka.m paritraatu ryii"so.h khrii.s.tasyaagamanena praakaa"sata| khrii.s.to m.rtyu.m paraajitavaan susa.mvaadena ca jiivanam amarataa nca prakaa"sitavaan|</para>
  <para style="p">
    <verse number="11" style="v"/>tasya gho.sayitaa duuta"scaanyajaatiiyaanaa.m "sik.saka"scaaha.m niyukto.asmi|</para>
  <para style="p">
    <verse number="12" style="v"/>tasmaat kaara.naat mamaaya.m kle"so bhavati tena mama lajjaa na jaayate yato.aha.m yasmin vi"svasitavaan tamavagato.asmi mahaadina.m yaavat mamopanidhe rgopanasya "saktistasya vidyata iti ni"scita.m jaanaami|</para>
  <para style="p">
    <verse number="13" style="v"/>hitadaayakaanaa.m vaakyaanaam aadar"saruupe.na matta.h "srutaa.h khrii.s.te yii"sau vi"svaasapremno.h kathaa dhaaraya|</para>
  <para style="p">
    <verse number="14" style="v"/>aparam asmadantarvaasinaa pavitre.naatmanaa taamuttamaam upanidhi.m gopaya|</para>
  <para style="p">
    <verse number="15" style="v"/>aa"siyaade"siiyaa.h sarvve maa.m tyaktavanta iti tva.m jaanaasi te.saa.m madhye phuugillo harmmagini"sca vidyete|</para>
  <para style="p">
    <verse number="16" style="v"/>prabhuranii.sipharasya parivaaraan prati k.rpaa.m vidadhaatu yata.h sa puna.h puna rmaam aapyaayitavaan</para>
  <para style="p">
    <verse number="17" style="v"/>mama "s.r"nkhalena na trapitvaa romaanagare upasthitisamaye yatnena maa.m m.rgayitvaa mamodde"sa.m praaptavaan|</para>
  <para style="p">
    <verse number="18" style="v"/>ato vicaaradine sa yathaa prabho.h k.rpaabhaajana.m bhavet taad.r"sa.m vara.m prabhustasmai deyaat| iphi.sanagare.api sa kati prakaarai rmaam upak.rtavaan tat tva.m samyag vetsi|</para>
  <chapter number="2" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>he mama putra, khrii.s.tayii"suto yo.anugrahastasya balena tva.m balavaan bhava|</para>
  <para style="p">
    <verse number="2" style="v"/>apara.m bahubhi.h saak.sibhi.h pramaa.niik.rtaa.m yaa.m "sik.saa.m "srutavaanasi taa.m vi"svaasye.su parasmai "sik.saadaane nipu.ne.su ca loke.su samarpaya|</para>
  <para style="p">
    <verse number="3" style="v"/>tva.m yii"sukhrii.s.tasyottamo yoddheva kle"sa.m sahasva|</para>
  <para style="p">
    <verse number="4" style="v"/>yo yuddha.m karoti sa saa.msaarike vyaapaare magno na bhavati kintu svaniyojayitre rocitu.m ce.s.tate|</para>
  <para style="p">
    <verse number="5" style="v"/>apara.m yo mallai ryudhyati sa yadi niyamaanusaare.na na yuddhyati tarhi kirii.ta.m na lapsyate|</para>
  <para style="p">
    <verse number="6" style="v"/>apara.m ya.h k.r.siivala.h karmma karoti tena prathamena phalabhaaginaa bhavitavya.m|</para>
  <para style="p">
    <verse number="7" style="v"/>mayaa yaducyate tat tvayaa budhyataa.m yata.h prabhustubhya.m sarvvatra buddhi.m daasyati|</para>
  <para style="p">
    <verse number="8" style="v"/>mama susa.mvaadasya vacanaanusaaraad daayuudva.m"siiya.m m.rtaga.namadhyaad utthaapita nca yii"su.m khrii.s.ta.m smara|</para>
  <para style="p">
    <verse number="9" style="v"/>tatsusa.mvaadakaara.naad aha.m du.skarmmeva bandhanada"saaparyyanta.m kle"sa.m bhu nje kintvii"svarasya vaakyam abaddha.m ti.s.thati|</para>
  <para style="p">
    <verse number="10" style="v"/>khrii.s.tena yii"sunaa yad anantagauravasahita.m paritraa.na.m jaayate tadabhirucitai rlokairapi yat labhyeta tadarthamaha.m te.saa.m nimitta.m sarvvaa.nyetaani sahe|</para>
  <para style="p">
    <verse number="11" style="v"/>aparam e.saa bhaaratii satyaa yadi vaya.m tena saarddha.m mriyaamahe tarhi tena saarddha.m jiivivyaama.h, yadi ca kle"sa.m sahaamahe tarhi tena saarddha.m raajatvamapi kari.syaamahe|</para>
  <para style="p">
    <verse number="12" style="v"/>yadi vaya.m tam ana"ngiikurmmastarhi so .asmaanapyana"ngiikari.syati|</para>
  <para style="p">
    <verse number="13" style="v"/>yadi vaya.m na vi"svaasaamastarhi sa vi"svaasyasti.s.thati yata.h svam apahnotu.m na "saknoti|</para>
  <para style="p">
    <verse number="14" style="v"/>tvametaani smaarayan te yathaa ni.sphala.m "srot.r.naa.m bhra.m"sajanaka.m vaagyuddha.m na kuryyastathaa prabho.h samak.sa.m d.r.dha.m viniiyaadi"sa|</para>
  <para style="p">
    <verse number="15" style="v"/>apara.m tvam ii"svarasya saak.saat sva.m pariik.sitam anindaniiyakarmmakaari.na nca satyamatasya vaakyaanaa.m sadvibhajane nipu.na nca dar"sayitu.m yatasva|</para>
  <para style="p">
    <verse number="16" style="v"/>kintvapavitraa anarthakakathaa duuriikuru yatastadaalambina uttarottaram adharmme varddhi.syante,</para>
  <para style="p">
    <verse number="17" style="v"/>te.saa nca vaakya.m galitak.satavat k.sayavarddhako bhavi.syati te.saa.m madhye huminaaya.h philiita"scetinaamaanau dvau janau satyamataad bhra.s.tau jaatau,</para>
  <para style="p">
    <verse number="18" style="v"/>m.rtaanaa.m punarutthiti rvyatiiteti vadantau ke.saa ncid vi"svaasam utpaa.tayata"sca|</para>
  <para style="p">
    <verse number="19" style="v"/>tathaapii"svarasya bhittimuulam acala.m ti.s.thati tasmi.m"sceya.m lipi rmudraa"nkitaa vidyate| yathaa, jaanaati parame"sastu svakiiyaan sarvvamaanavaan| apagacched adharmmaacca ya.h ka"scit khrii.s.tanaamak.rt||</para>
  <para style="p">
    <verse number="20" style="v"/>kintu b.rhanniketane kevala suvar.namayaani raupyamayaa.ni ca bhaajanaani vidyanta iti tarhi kaa.s.thamayaani m.r.nmayaanyapi vidyante te.saa nca kiyanti sammaanaaya kiyantapamaanaaya ca bhavanti|</para>
  <para style="p">
    <verse number="21" style="v"/>ato yadi ka"scid etaad.r"sebhya.h sva.m pari.skaroti tarhi sa paavita.m prabho.h kaaryyayogya.m sarvvasatkaaryyaayopayukta.m sammaanaarthaka nca bhaajana.m bhavi.syati|</para>
  <para style="p">
    <verse number="22" style="v"/>yauvanaavasthaayaa abhilaa.saastvayaa parityajyantaa.m dharmmo vi"svaasa.h prema ye ca "sucimanobhi.h prabhum uddi"sya praarthanaa.m kurvvate tai.h saarddham aikyabhaava"scaite.su tvayaa yatno vidhiiyataa.m|</para>
  <para style="p">
    <verse number="23" style="v"/>apara.m tvam anarthakaan aj naanaa.m"sca pra"snaan vaagyuddhotpaadakaan j naatvaa duuriikuru|</para>
  <para style="p">
    <verse number="24" style="v"/>yata.h prabho rdaasena yuddham akarttavya.m kintu sarvvaan prati "saantena "sik.saadaanecchukena sahi.s.nunaa ca bhavitavya.m, vipak.saa"sca tena namratvena cetitavyaa.h|</para>
  <para style="p">
    <verse number="25" style="v"/>tathaa k.rte yadii"svara.h satyamatasya j naanaartha.m tebhyo mana.hparivarttanaruupa.m vara.m dadyaat,</para>
  <para style="p">
    <verse number="26" style="v"/>tarhi te yena "sayataanena nijaabhilaa.sasaadhanaaya dh.rtaastasya jaalaat cetanaa.m praapyoddhaara.m labdhu.m "sak.syanti|</para>
  <chapter number="3" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>caramadine.su kle"sajanakaa.h samayaa upasthaasyantiiti jaaniihi|</para>
  <para style="p">
    <verse number="2" style="v"/>yatastaatkaalikaa lokaa aatmapremi.no .arthapremi.na aatma"slaaghino .abhimaanino nindakaa.h pitroranaaj naagraahi.na.h k.rtaghnaa apavitraa.h</para>
  <para style="p">
    <verse number="3" style="v"/>priitivarjitaa asandheyaa m.r.saapavaadino .ajitendriyaa.h praca.n.daa bhadradve.si.no</para>
  <para style="p">
    <verse number="4" style="v"/>vi"svaasaghaatakaa du.hsaahasino darpadhmaataa ii"svaraapremi.na.h kintu sukhapremi.no</para>
  <para style="p">
    <verse number="5" style="v"/>bhaktave"saa.h kintvasviik.rtabhaktigu.naa bhavi.syanti; etaad.r"saanaa.m lokaanaa.m sa.mmarga.m parityaja|</para>
  <para style="p">
    <verse number="6" style="v"/>yato ye janaa.h pracchanna.m gehaan pravi"santi paapai rbhaaragrastaa naanaavidhaabhilaa.sai"scaalitaa yaa.h kaaminyo</para>
  <para style="p">
    <verse number="7" style="v"/>nitya.m "sik.sante kintu satyamatasya tattvaj naana.m praaptu.m kadaacit na "saknuvanti taa daasiivad va"siikurvvate ca te taad.r"saa lokaa.h|</para>
  <para style="p">
    <verse number="8" style="v"/>yaanni ryaambri"sca yathaa muusama.m prati vipak.satvam akurutaa.m tathaiva bhra.s.tamanaso vi"svaasavi.saye .agraahyaa"scaite lokaa api satyamata.m prati vipak.sataa.m kurvvanti|</para>
  <para style="p">
    <verse number="9" style="v"/>kintu te bahuduuram agrasaraa na bhavi.syanti yatastayo rmuu.dhataa yadvat tadvad ete.saamapi muu.dhataa sarvvad.r"syaa bhavi.syati|</para>
  <para style="p">
    <verse number="10" style="v"/>mamopade"sa.h "si.s.tataabhipraayo vi"svaaso rdharyya.m prema sahi.s.nutopadrava.h kle"saa</para>
  <para style="p">
    <verse number="11" style="v"/>aantiyakhiyaayaam ikaniye luustraayaa nca maa.m prati yadyad agha.tata yaa.m"scopadravaan aham asahe sarvvametat tvam avagato.asi kintu tatsarvvata.h prabhu rmaam uddh.rtavaan|</para>
  <para style="p">
    <verse number="12" style="v"/>parantu yaavanto lokaa.h khrii.s.tena yii"sune"svarabhaktim aacaritum icchanti te.saa.m sarvve.saam upadravo bhavi.syati|</para>
  <para style="p">
    <verse number="13" style="v"/>apara.m paapi.s.thaa.h khalaa"sca lokaa bhraamyanto bhramayanta"scottarottara.m du.s.tatvena varddhi.syante|</para>
  <para style="p">
    <verse number="14" style="v"/>kintu tva.m yad yad a"sik.sathaa.h, yacca tvayi samarpitam abhuut tasmin avati.s.tha, yata.h kasmaat "sik.saa.m praapto.asi tad vetsi;</para>
  <para style="p">
    <verse number="15" style="v"/>yaani ca dharmma"saastraa.ni khrii.s.te yii"sau vi"svaasena paritraa.napraaptaye tvaa.m j naanina.m karttu.m "saknuvanti taani tva.m "sai"savakaalaad avagato.asi|</para>
  <para style="p">
    <verse number="16" style="v"/>tat sarvva.m "saastram ii"svarasyaatmanaa datta.m "sik.saayai do.sabodhaaya "sodhanaaya dharmmavinayaaya ca phalayuukta.m bhavati</para>
  <para style="p">
    <verse number="17" style="v"/>tena ce"svarasya loko nipu.na.h sarvvasmai satkarmma.ne susajja"sca bhavati|</para>
  <chapter number="4" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>ii"svarasya gocare ya"sca yii"su.h khrii.s.ta.h sviiyaagamanakaale svaraajatvena jiivataa.m m.rtaanaa nca lokaanaa.m vicaara.m kari.syati tasya gocare .aha.m tvaam ida.m d.r.dham aaj naapayaami|</para>
  <para style="p">
    <verse number="2" style="v"/>tva.m vaakya.m gho.saya kaale.akaale cotsuko bhava puur.nayaa sahi.s.nutayaa "sik.sayaa ca lokaan prabodhaya bhartsaya vinayasva ca|</para>
  <para style="p">
    <verse number="3" style="v"/>yata etaad.r"sa.h samaya aayaati yasmin lokaa yathaartham upade"sam asahyamaanaa.h kar.naka.n.duuyanavi"si.s.taa bhuutvaa nijaabhilaa.saat "sik.sakaan sa.mgrahii.syanti</para>
  <para style="p">
    <verse number="4" style="v"/>satyamataacca "srotraa.ni nivarttya vipathagaamino bhuutvopaakhyaane.su pravartti.syante;</para>
  <para style="p">
    <verse number="5" style="v"/>kintu tva.m sarvvavi.saye prabuddho bhava du.hkhabhoga.m sviikuru susa.mvaadapracaarakasya karmma saadhaya nijaparicaryyaa.m puur.natvena kuru ca|</para>
  <para style="p">
    <verse number="6" style="v"/>mama praa.naanaam utsargo bhavati mama prasthaanakaala"scopaati.s.that|</para>
  <para style="p">
    <verse number="7" style="v"/>aham uttamayuddha.m k.rtavaan gantavyamaargasyaanta.m yaavad dhaavitavaan vi"svaasa nca rak.sitavaan|</para>
  <para style="p">
    <verse number="8" style="v"/>"se.sa.m pu.nyamuku.ta.m madartha.m rak.sita.m vidyate tacca tasmin mahaadine yathaarthavicaarake.na prabhunaa mahya.m daayi.syate kevala.m mahyam iti nahi kintu yaavanto lokaastasyaagamanam aakaa"nk.sante tebhya.h sarvvebhyo .api daayi.syate|</para>
  <para style="p">
    <verse number="9" style="v"/>tva.m tvarayaa matsamiipam aagantu.m yatasva,</para>
  <para style="p">
    <verse number="10" style="v"/>yato diimaa aihikasa.msaaram iihamaano maa.m parityajya thi.salaniikii.m gatavaan tathaa krii.ski rgaalaatiyaa.m gatavaan tiita"sca daalmaatiyaa.m gatavaan|</para>
  <para style="p">
    <verse number="11" style="v"/>kevalo luuko mayaa saarddha.m vidyate| tva.m maarka.m sa"ngina.m k.rtvaagaccha yata.h sa paricaryyayaa mamopakaarii bhavi.syati,</para>
  <para style="p">
    <verse number="12" style="v"/>tukhika ncaaham iphi.sanagara.m pre.sitavaan|</para>
  <para style="p">
    <verse number="13" style="v"/>yad aacchaadanavastra.m troyaanagare kaarpasya sannidhau mayaa nik.sipta.m tvamaagamanasamaye tat pustakaani ca vi"se.sata"scarmmagranthaan aanaya|</para>
  <para style="p">
    <verse number="14" style="v"/>kaa.msyakaara.h sikandaro mama bahvani.s.ta.m k.rtavaan prabhustasya karmma.naa.m samucitaphala.m dadaatu|</para>
  <para style="p">
    <verse number="15" style="v"/>tvamapi tasmaat saavadhaanaasti.s.tha yata.h so.asmaaka.m vaakyaanaam atiiva vipak.so jaata.h|</para>
  <para style="p">
    <verse number="16" style="v"/>mama prathamapratyuttarasamaye ko.api mama sahaayo naabhavat sarvve maa.m paryyatyajan taan prati tasya do.sasya ga.nanaa na bhuuyaat;</para>
  <para style="p">
    <verse number="17" style="v"/>kintu prabhu rmama sahaayo .abhavat yathaa ca mayaa gho.sa.naa saadhyeta bhinnajaatiiyaa"sca sarvve susa.mvaada.m "s.r.nuyustathaa mahya.m "saktim adadaat tato .aha.m si.mhasya mukhaad uddh.rta.h|</para>
  <para style="p">
    <verse number="18" style="v"/>apara.m sarvvasmaad du.skarmmata.h prabhu rmaam uddhari.syati nijasvargiiyaraajya.m netu.m maa.m taarayi.syati ca| tasya dhanyavaada.h sadaakaala.m bhuuyaat| aamen|</para>
  <para style="p">
    <verse number="19" style="v"/>tva.m pri.skaam aakkilam anii.sipharasya parijanaa.m"sca namaskuru|</para>
  <para style="p">
    <verse number="20" style="v"/>iraasta.h karinthanagare .ati.s.that traphima"sca pii.ditatvaat miliitanagare mayaa vyahiiyata|</para>
  <para style="p">
    <verse number="21" style="v"/>tva.m hemantakaalaat puurvvam aagantu.m yatasva| ubuula.h puudi rliina.h klaudiyaa sarvve bhraatara"sca tvaa.m namaskurvvate|</para>
  <para style="p">
    <verse number="22" style="v"/>prabhu ryii"su.h khrii.s.tastavaatmanaa saha bhuuyaat| yu.smaasvanugraho bhuuyaat| aamen|</para>
</usx>
