  <para style="h">Jude</para>
  <para style="toc1">yihuudaa.h patra.m</para>
  <para style="toc2">yihuudaa.h</para>
  <para style="toc3">yihuudaa.h</para>
  <para style="mt1">yihuudaa.h patra.m</para>
  <chapter number="1" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>yii"sukhrii.s.tasya daaso yaakuubo bhraataa yihuudaastaatene"svare.na pavitriik.rtaan yii"sukhrii.s.tena rak.sitaa.m"scaahuutaan lokaan prati patra.m likhati|</para>
  <para style="p">
    <verse number="2" style="v"/>k.rpaa "saanti.h prema ca baahulyaruupe.na yu.smaasvadhiti.s.thatu|</para>
  <para style="p">
    <verse number="3" style="v"/>he priyaa.h, saadhaara.naparitraa.namadhi yu.smaan prati lekhitu.m mama bahuyatne jaate puurvvakaale pavitraloke.su samarpito yo dharmmastadartha.m yuuya.m praa.navyayenaapi sace.s.taa bhavateti vinayaartha.m yu.smaan prati patralekhanamaava"syakam amanye|</para>
  <para style="p">
    <verse number="4" style="v"/>yasmaad etadruupada.n.dapraaptaye puurvva.m likhitaa.h kecijjanaa asmaan upas.rptavanta.h, te .adhaarmmikalokaa asmaakam ii"svarasyaanugraha.m dhvajiik.rtya lampa.tataam aacaranti, advitiiyo .adhipati ryo .asmaaka.m prabhu ryii"sukhrii.s.tasta.m naa"ngiikurvvanti|</para>
  <para style="p">
    <verse number="5" style="v"/>tasmaad yuuya.m puraa yad avagataastat puna ryu.smaan smaarayitum icchaami, phalata.h prabhurekak.rtva.h svaprajaa misarade"saad udadhaara yat tata.h param avi"svaasino vyanaa"sayat|</para>
  <para style="p">
    <verse number="6" style="v"/>ye ca svargaduutaa.h sviiyakart.rtvapade na sthitvaa svavaasasthaana.m parityaktavantastaan sa mahaadinasya vicaaraartham andhakaaramaye .adha.hsthaane sadaasthaayibhi rbandhanairabadhnaat|</para>
  <para style="p">
    <verse number="7" style="v"/>apara.m sidomam amoraa tannika.tasthanagaraa.ni caite.saa.m nivaasinastatsamaruupa.m vyabhicaara.m k.rtavanto vi.samamaithunasya ce.s.tayaa vipatha.m gatavanta"sca tasmaat taanyapi d.r.s.taantasvaruupaa.ni bhuutvaa sadaatanavahninaa da.n.da.m bhu njate|</para>
  <para style="p">
    <verse number="8" style="v"/>tathaiveme svapnaacaari.no.api sva"sariiraa.ni kala"nkayanti raajaadhiinataa.m na sviikurvvantyuccapadasthaan nindanti ca|</para>
  <para style="p">
    <verse number="9" style="v"/>kintu pradhaanadivyaduuto miikhaayelo yadaa muusaso dehe "sayataanena vivadamaana.h samabhaa.sata tadaa tisman nindaaruupa.m da.n.da.m samarpayitu.m saahasa.m na k.rtvaakathayat prabhustvaa.m bhartsayataa.m|</para>
  <para style="p">
    <verse number="10" style="v"/>kintvime yanna budhyante tannindanti yacca nirbbodhapa"sava ivendriyairavagacchanti tena na"syanti|</para>
  <para style="p">
    <verse number="11" style="v"/>taan dhik, te kaabilo maarge caranti paarito.sikasyaa"saato biliyamo bhraantimanudhaavanti korahasya durmmukhatvena vina"syanti ca|</para>
  <para style="p">
    <verse number="12" style="v"/>yu.smaaka.m premabhojye.su te vighnajanakaa bhavanti, aatmambharaya"sca bhuutvaa nirlajjayaa yu.smaabhi.h saarddha.m bhu njate| te vaayubhi"scaalitaa nistoyameghaa hemantakaalikaa ni.sphalaa dvi rm.rtaa unmuulitaa v.rk.saa.h,</para>
  <para style="p">
    <verse number="13" style="v"/>svakiiyalajjaaphe.nodvamakaa.h praca.n.daa.h saamudratara"ngaa.h sadaakaala.m yaavat ghoratimirabhaagiini bhrama.nakaarii.ni nak.satraa.ni ca bhavanti|</para>
  <para style="p">
    <verse number="14" style="v"/>aadamata.h saptama.h puru.so yo hanoka.h sa taanuddi"sya bhavi.syadvaakyamida.m kathitavaan, yathaa, pa"sya svakiiyapu.nyaanaam ayutai rve.s.tita.h prabhu.h|</para>
  <para style="p">
    <verse number="15" style="v"/>sarvvaan prati vicaaraaj naasaadhanaayaagami.syati| tadaa caadhaarmmikaa.h sarvve jaataa yairaparaadhina.h| vidharmmakarmma.naa.m te.saa.m sarvve.saameva kaara.naat| tathaa tadvaipariityenaapyadharmmaacaaripaapinaa.m| uktaka.thoravaakyaanaa.m sarvve.saamapi kaara.naat| parame"sena do.sitva.m te.saa.m prakaa"sayi.syate||</para>
  <para style="p">
    <verse number="16" style="v"/>te vaakkalahakaari.na.h svabhaagyanindakaa.h svecchaacaari.no darpavaadimukhavi"si.s.taa laabhaartha.m manu.syastaavakaa"sca santi|</para>
  <para style="p">
    <verse number="17" style="v"/>kintu he priyatamaa.h, asmaaka.m prabho ryii"sukhrii.s.tasya preritai ryad vaakya.m puurvva.m yu.smabhya.m kathita.m tat smarata,</para>
  <para style="p">
    <verse number="18" style="v"/>phalata.h "se.sasamaye svecchaato .adharmmaacaari.no nindakaa upasthaasyantiiti|</para>
  <para style="p">
    <verse number="19" style="v"/>ete lokaa.h svaan p.rthak kurvvanta.h saa.msaarikaa aatmahiinaa"sca santi|</para>
  <para style="p">
    <verse number="20" style="v"/>kintu he priyatamaa.h, yuuya.m sve.saam atipavitravi"svaase niciiyamaanaa.h pavitre.naatmanaa praarthanaa.m kurvvanta</para>
  <para style="p">
    <verse number="21" style="v"/>ii"svarasya premnaa svaan rak.sata, anantajiivanaaya caasmaaka.m prabho ryii"sukhrii.s.tasya k.rpaa.m pratiik.sadhva.m|</para>
  <para style="p">
    <verse number="22" style="v"/>apara.m yuuya.m vivicya kaa.m"scid anukampadhva.m</para>
  <para style="p">
    <verse number="23" style="v"/>kaa.m"scid agnita uddh.rtya bhaya.m pradar"sya rak.sata, "saariirikabhaavena kala"nkita.m vastramapi .rtiiyadhva.m|</para>
  <para style="p">
    <verse number="24" style="v"/>apara nca yu.smaan skhalanaad rak.situm ullaasena sviiyatejasa.h saak.saat nirddo.saan sthaapayitu nca samartho</para>
  <para style="p">
    <verse number="25" style="v"/>yo .asmaakam advitiiyastraa.nakarttaa sarvvaj na ii"svarastasya gaurava.m mahimaa paraakrama.h kart.rtva ncedaaniim anantakaala.m yaavad bhuuyaat| aamen|</para>
</usx>
