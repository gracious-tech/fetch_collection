<?xml version="1.0" encoding="UTF-8"?>
<usx version="2.6">
  <book code="1TI" style="id">Sanskrit Bible (NT) in Velthuis Script (satyaveda.h ।)</book>
  <para style="rem">© SanskritBible.in । Licensed under CC BY-SA 4.0</para>
  <para style="h">1 Timothy</para>
  <para style="toc1">1 tiimathiya.m patra.m</para>
  <para style="toc2">1 tiimathiya.h</para>
  <para style="toc3">1 tiimathiya.h</para>
  <para style="mt1">1 tiimathiya.m patra.m</para>
  <chapter number="1" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>asmaaka.m traa.nakartturii"svarasyaasmaaka.m pratyaa"saabhuume.h prabho ryii"sukhrii.s.tasya caaj naanusaarato yii"sukhrii.s.tasya prerita.h paula.h svakiiya.m satya.m dharmmaputra.m tiimathiya.m prati patra.m likhati|</para>
  <para style="p">
    <verse number="2" style="v"/>asmaaka.m taata ii"svaro.asmaaka.m prabhu ryii"sukhrii.s.ta"sca tvayi anugraha.m dayaa.m "saanti nca kuryyaastaa.m|</para>
  <para style="p">
    <verse number="3" style="v"/>maakidaniyaade"se mama gamanakaale tvam iphi.sanagare ti.s.than itara"sik.saa na grahiitavyaa, anante.suupaakhyaane.su va.m"saavali.su ca yu.smaabhi rmano na nive"sitavyam</para>
  <para style="p">
    <verse number="4" style="v"/>iti kaa.m"scit lokaan yad upadi"seretat mayaadi.s.to.abhava.h, yata.h sarvvairetai rvi"svaasayukte"svariiyani.s.thaa na jaayate kintu vivaado jaayate|</para>
  <para style="p">
    <verse number="5" style="v"/>upade"sasya tvabhipreta.m phala.m nirmmalaanta.hkara.nena satsa.mvedena ni.skapa.tavi"svaasena ca yukta.m prema|</para>
  <para style="p">
    <verse number="6" style="v"/>kecit janaa"sca sarvvaa.nyetaani vihaaya nirarthakakathaanaam anugamanena vipathagaamino.abhavan,</para>
  <para style="p">
    <verse number="7" style="v"/>yad bhaa.sante yacca ni"scinvanti tanna budhyamaanaa vyavasthopade.s.taaro bhavitum icchanti|</para>
  <para style="p">
    <verse number="8" style="v"/>saa vyavasthaa yadi yogyaruupe.na g.rhyate tarhyuttamaa bhavatiiti vaya.m jaaniima.h|</para>
  <para style="p">
    <verse number="9" style="v"/>apara.m saa vyavasthaa dhaarmmikasya viruddhaa na bhavati kintvadhaarmmiko .avaadhyo du.s.ta.h paapi.s.tho .apavitro .a"suci.h pit.rhantaa maat.rhantaa narahantaa</para>
  <para style="p">
    <verse number="10" style="v"/>ve"syaagaamii pu.mmaithunii manu.syavikretaa mithyaavaadii mithyaa"sapathakaarii ca sarvve.saamete.saa.m viruddhaa,</para>
  <para style="p">
    <verse number="11" style="v"/>tathaa saccidaanande"svarasya yo vibhavayukta.h susa.mvaado mayi samarpitastadanuyaayihitopade"sasya vipariita.m yat ki ncid bhavati tadviruddhaa saa vyavastheti tadgraahi.naa j naatavya.m|</para>
  <para style="p">
    <verse number="12" style="v"/>mahya.m "saktidaataa yo.asmaaka.m prabhu.h khrii.s.tayii"sustamaha.m dhanya.m vadaami|</para>
  <para style="p">
    <verse number="13" style="v"/>yata.h puraa nindaka upadraavii hi.msaka"sca bhuutvaapyaha.m tena vi"svaasyo .amanye paricaarakatve nyayujye ca| tad avi"svaasaacara.nam aj naanena mayaa k.rtamiti hetoraha.m tenaanukampito.abhava.m|</para>
  <para style="p">
    <verse number="14" style="v"/>apara.m khrii.s.te yii"sau vi"svaasapremabhyaa.m sahito.asmatprabhoranugraho .atiiva pracuro.abhat|</para>
  <para style="p">
    <verse number="15" style="v"/>paapina.h paritraatu.m khrii.s.to yii"su rjagati samavatiir.no.abhavat, e.saa kathaa vi"svaasaniiyaa sarvvai graha.niiyaa ca|</para>
  <para style="p">
    <verse number="16" style="v"/>te.saa.m paapinaa.m madhye.aha.m prathama aasa.m kintu ye maanavaa anantajiivanapraaptyartha.m tasmin vi"svasi.syanti te.saa.m d.r.s.taante mayi prathame yii"sunaa khrii.s.tena svakiiyaa k.rtsnaa cirasahi.s.nutaa yat prakaa"syate tadarthamevaaham anukampaa.m praaptavaan|</para>
  <para style="p">
    <verse number="17" style="v"/>anaadirak.sayo.ad.r"syo raajaa yo.advitiiya.h sarvvaj na ii"svarastasya gaurava.m mahimaa caanantakaala.m yaavad bhuuyaat| aamen|</para>
  <para style="p">
    <verse number="18" style="v"/>he putra tiimathiya tvayi yaani bhavi.syadvaakyaani puraa kathitaani tadanusaaraad aham enamaade"sa.m tvayi samarpayaami, tasyaabhipraayo.aya.m yattva.m tai rvaakyairuttamayuddha.m karo.si</para>
  <para style="p">
    <verse number="19" style="v"/>vi"svaasa.m satsa.mveda nca dhaarayasi ca| anayo.h parityaagaat ke.saa ncid vi"svaasatarii bhagnaabhavat|</para>
  <para style="p">
    <verse number="20" style="v"/>huminaayasikandarau te.saa.m yau dvau janau, tau yad dharmmanindaa.m puna rna karttu.m "sik.sete tadartha.m mayaa "sayataanasya kare samarpitau|</para>
  <chapter number="2" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>mama prathama aade"so.aya.m, praarthanaavinayanivedanadhanyavaadaa.h karttavyaa.h,</para>
  <para style="p">
    <verse number="2" style="v"/>sarvve.saa.m maanavaanaa.m k.rte vi"se.sato vaya.m yat "saantatvena nirvvirodhatvena ce"scarabhakti.m viniitatva ncaacaranta.h kaala.m yaapayaamastadartha.m n.rpatiinaam uccapadasthaanaa nca k.rte te karttavyaa.h|</para>
  <para style="p">
    <verse number="3" style="v"/>yato.asmaaka.m taarakasye"svarasya saak.saat tadevottama.m graahya nca bhavati,</para>
  <para style="p">
    <verse number="4" style="v"/>sa sarvve.saa.m maanavaanaa.m paritraa.na.m satyaj naanapraapti ncecchati|</para>
  <para style="p">
    <verse number="5" style="v"/>yata eko.advitiiya ii"svaro vidyate ki nce"svare maanave.su caiko .advitiiyo madhyastha.h</para>
  <para style="p">
    <verse number="6" style="v"/>sa naraavataara.h khrii.s.to yii"su rvidyate ya.h sarvve.saa.m mukte rmuulyam aatmadaana.m k.rtavaan| etena yena pramaa.nenopayukte samaye prakaa"sitavya.m,</para>
  <para style="p">
    <verse number="7" style="v"/>tadgho.sayitaa duuto vi"svaase satyadharmme ca bhinnajaatiiyaanaam upade"saka"scaaha.m nyayuujye, etadaha.m khrii.s.tasya naamnaa yathaatathya.m vadaami naan.rta.m kathayaami|</para>
  <para style="p">
    <verse number="8" style="v"/>ato mamaabhimatamida.m puru.sai.h krodhasandehau vinaa pavitrakaraan uttolya sarvvasmin sthaane praarthanaa kriyataa.m|</para>
  <para style="p">
    <verse number="9" style="v"/>tadvat naaryyo.api salajjaa.h sa.myatamanasa"sca satyo yogyamaacchaadana.m paridadhatu ki nca ke"sasa.mskaarai.h ka.nakamuktaabhi rmahaarghyaparicchadai"scaatmabhuu.sa.na.m na kurvvatya.h</para>
  <para style="p">
    <verse number="10" style="v"/>sviik.rte"svarabhaktiinaa.m yo.sitaa.m yogyai.h satyarmmabhi.h svabhuu.sa.na.m kurvvataa.m|</para>
  <para style="p">
    <verse number="11" style="v"/>naarii sampuur.naviniitatvena nirvirodha.m "sik.sataa.m|</para>
  <para style="p">
    <verse number="12" style="v"/>naaryyaa.h "sik.saadaana.m puru.saayaaj naadaana.m vaaha.m naanujaanaami tayaa nirvviroेdhatvam aacaritavya.m|</para>
  <para style="p">
    <verse number="13" style="v"/>yata.h prathamam aadamastata.h para.m havaayaa.h s.r.s.ti rbabhuuva|</para>
  <para style="p">
    <verse number="14" style="v"/>ki ncaadam bhraantiyukto naabhavat yo.sideva bhraantiyuktaa bhuutvaatyaacaari.nii babhuuva|</para>
  <para style="p">
    <verse number="15" style="v"/>tathaapi naariiga.no yadi vi"svaase premni pavitrataayaa.m sa.myatamanasi ca ti.s.thati tarhyapatyaprasavavartmanaa paritraa.na.m praapsyati|</para>
  <chapter number="3" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>yadi ka"scid adhyak.sapadam aakaa"nk.sate tarhi sa uttama.m karmma lipsata iti satya.m|</para>
  <para style="p">
    <verse number="2" style="v"/>ato.adhyak.se.naaninditenaikasyaa yo.sito bhartraa parimitabhogena sa.myatamanasaa sabhyenaatithisevakena "sik.sa.ne nipu.nena</para>
  <para style="p">
    <verse number="3" style="v"/>na madyapena na prahaarake.na kintu m.rdubhaavena nirvvivaadena nirlobhena</para>
  <para style="p">
    <verse number="4" style="v"/>svaparivaaraa.naam uttama"saasakena puur.naviniitatvaad va"syaanaa.m santaanaanaa.m niyantraa ca bhavitavya.m|</para>
  <para style="p">
    <verse number="5" style="v"/>yata aatmaparivaaraan "saasitu.m yo na "saknoti tene"svarasya samitestattvaavadhaara.na.m katha.m kaari.syate?</para>
  <para style="p">
    <verse number="6" style="v"/>apara.m sa garvvito bhuutvaa yat "sayataana iva da.n.dayogyo na bhavet tadartha.m tena nava"si.sye.na na bhavitavya.m|</para>
  <para style="p">
    <verse number="7" style="v"/>yacca nindaayaa.m "sayataanasya jaale ca na patet tadartha.m tena bahi.hsthalokaanaamapi madhye sukhyaatiyuktena bhavitavya.m|</para>
  <para style="p">
    <verse number="8" style="v"/>tadvat paricaarakairapi viniitai rdvividhavaakyarahitai rbahumadyapaane .anaasaktai rnirlobhai"sca bhavitavya.m,</para>
  <para style="p">
    <verse number="9" style="v"/>nirmmalasa.mvedena ca vi"svaasasya niguu.dhavaakya.m dhaativya nca|</para>
  <para style="p">
    <verse number="10" style="v"/>agre te.saa.m pariik.saa kriyataa.m tata.h param aninditaa bhuutvaa te paricaryyaa.m kurvvantu|</para>
  <para style="p">
    <verse number="11" style="v"/>apara.m yo.sidbhirapi viniitaabhiranapavaadikaabhi.h satarkaabhi.h sarvvatra vi"svaasyaabhi"sca bhavitavya.m|</para>
  <para style="p">
    <verse number="12" style="v"/>paricaarakaa ekaikayo.sito bharttaaro bhaveyu.h, nijasantaanaanaa.m parijanaanaa nca su"saasana.m kuryyu"sca|</para>
  <para style="p">
    <verse number="13" style="v"/>yata.h saa paricaryyaa yai rbhadraruupe.na saadhyate te "sre.s.thapada.m praapnuvanti khrii.s.te yii"sau vi"svaasena mahotsukaa bhavanti ca|</para>
  <para style="p">
    <verse number="14" style="v"/>tvaa.m pratyetatpatralekhanasamaye "siighra.m tvatsamiipagamanasya pratyaa"saa mama vidyate|</para>
  <para style="p">
    <verse number="15" style="v"/>yadi vaa vilambeya tarhii"svarasya g.rhe .arthata.h satyadharmmasya stambhabhittimuulasvaruupaayaam amare"svarasya samitau tvayaa kiid.r"sa aacaara.h karttavyastat j naatu.m "sak.syate|</para>
  <para style="p">
    <verse number="16" style="v"/>apara.m yasya mahattva.m sarvvasviik.rtam ii"svarabhaktestat niguu.dhavaakyamidam ii"svaro maanavadehe prakaa"sita aatmanaa sapu.nyiik.rto duutai.h sand.r.s.ta.h sarvvajaatiiyaanaa.m nika.te gho.sito jagato vi"svaasapaatriibhuutasteja.hpraaptaye svarga.m niita"sceti|</para>
  <chapter number="4" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>pavitra aatmaa spa.s.tam ida.m vaakya.m vadati caramakaale katipayalokaa vahninaa"nkitatvaat</para>
  <para style="p">
    <verse number="2" style="v"/>ka.thoramanasaa.m kaapa.tyaad an.rtavaadinaa.m vivaahani.sedhakaanaa.m bhak.syavi"se.sani.sedhakaanaa nca</para>
  <para style="p">
    <verse number="3" style="v"/>bhuutasvaruupaa.naa.m "sik.saayaa.m bhramakaatmanaa.m vaakye.su ca manaa.msi nive"sya dharmmaad bhra.m"si.syante| taani tu bhak.syaa.ni vi"svaasinaa.m sviik.rtasatyadharmmaa.naa nca dhanyavaadasahitaaya bhogaaye"svare.na sas.rjire|</para>
  <para style="p">
    <verse number="4" style="v"/>yata ii"svare.na yadyat s.r.s.ta.m tat sarvvam uttama.m yadi ca dhanyavaadena bhujyate tarhi tasya kimapi naagraahya.m bhavati,</para>
  <para style="p">
    <verse number="5" style="v"/>yata ii"svarasya vaakyena praarthanayaa ca tat pavitriibhavati|</para>
  <para style="p">
    <verse number="6" style="v"/>etaani vaakyaani yadi tva.m bhraat.rn j naapayestarhi yii"sukhrii.s.tasyottam.h paricaarako bhavi.syasi yo vi"svaaso hitopade"sa"sca tvayaa g.rhiitastadiiyavaakyairaapyaayi.syase ca|</para>
  <para style="p">
    <verse number="7" style="v"/>yaanyupaakhyaanaani durbhaavaani v.rddhayo.sitaameva yogyaani ca taani tvayaa vis.rjyantaam ii"svarabhaktaye yatna.h kriyataa nca|</para>
  <para style="p">
    <verse number="8" style="v"/>yata.h "saariiriko yatna.h svalpaphalado bhavati kintvii"svarabhaktiraihikapaaratrikajiivanayo.h pratij naayuktaa satii sarvvatra phaladaa bhavati|</para>
  <para style="p">
    <verse number="9" style="v"/>vaakyametad vi"svasaniiya.m sarvvai rgraha.niiya nca vaya nca tadarthameva "sraamyaamo nindaa.m bhu.mjmahe ca|</para>
  <para style="p">
    <verse number="10" style="v"/>yato heto.h sarvvamaanavaanaa.m vi"se.sato vi"svaasinaa.m traataa yo.amara ii"svarastasmin vaya.m vi"svasaama.h|</para>
  <para style="p">
    <verse number="11" style="v"/>tvam etaani vaakyaani pracaaraya samupadi"sa ca|</para>
  <para style="p">
    <verse number="12" style="v"/>alpavaya.skatvaat kenaapyavaj neyo na bhava kintvaalaapenaacara.nena premnaa sadaatmatvena vi"svaasena "sucitvena ca vi"svaasinaam aadar"so bhava|</para>
  <para style="p">
    <verse number="13" style="v"/>yaavannaaham aagami.syaami taavat tva paa.the cetayane upade"se ca mano nidhatsva|</para>
  <para style="p">
    <verse number="14" style="v"/>praaciinaga.nahastaarpa.nasahitena bhavi.syadvaakyena yaddaana.m tubhya.m vi"sraa.nita.m tavaanta.hsthe tasmin daane "sithilamanaa maa bhava|</para>
  <para style="p">
    <verse number="15" style="v"/>ete.su mano nive"saya, ete.su varttasva, ittha nca sarvvavi.saye tava gu.nav.rddhi.h prakaa"sataa.m|</para>
  <para style="p">
    <verse number="16" style="v"/>svasmin upade"se ca saavadhaano bhuutvaavati.s.thasva tat k.rtvaa tvayaatmaparitraa.na.m "srot.r.naa nca paritraa.na.m saadhayi.syate|</para>
  <chapter number="5" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>tva.m praaciina.m na bhartsaya kintu ta.m pitaramiva yuuna"sca bhraat.rniva</para>
  <para style="p">
    <verse number="2" style="v"/>v.rddhaa.h striya"sca maat.rniva yuvatii"sca puur.na"sucitvena bhaginiiriva vinayasva|</para>
  <para style="p">
    <verse number="3" style="v"/>apara.m satyavidhavaa.h sammanyasva|</para>
  <para style="p">
    <verse number="4" style="v"/>kasyaa"scid vidhavaayaa yadi putraa.h pautraa vaa vidyante tarhi te prathamata.h sviiyaparijanaan sevitu.m pitro.h pratyupakarttu nca "sik.santaa.m yatastadeve"svarasya saak.saad uttama.m graahya nca karmma|</para>
  <para style="p">
    <verse number="5" style="v"/>apara.m yaa naarii satyavidhavaa naathahiinaa caasti saa ii"svarasyaa"sraye ti.s.thantii divaani"sa.m nivedanapraarthanaabhyaa.m kaala.m yaapayati|</para>
  <para style="p">
    <verse number="6" style="v"/>kintu yaa vidhavaa sukhabhogaasaktaa saa jiivatyapi m.rtaa bhavati|</para>
  <para style="p">
    <verse number="7" style="v"/>ataeva taa yad aninditaa bhaveyuustadartham etaani tvayaa nidi"syantaa.m|</para>
  <para style="p">
    <verse number="8" style="v"/>yadi ka"scit svajaatiiyaan lokaan vi"se.sata.h sviiyaparijanaan na paalayati tarhi sa vi"svaasaad bhra.s.to .apyadhama"sca bhavati|</para>
  <para style="p">
    <verse number="9" style="v"/>vidhavaavarge yasyaa ga.nanaa bhavati tayaa .sa.s.tivatsarebhyo nyuunavayaskayaa na bhavitavya.m; apara.m puurvvam ekasvaamikaa bhuutvaa</para>
  <para style="p">
    <verse number="10" style="v"/>saa yat "si"supo.sa.nenaatithisevanena pavitralokaanaa.m cara.naprak.saalanena kli.s.taanaam upakaare.na sarvvavidhasatkarmmaacara.nena ca satkarmmakara.naat sukhyaatipraaptaa bhavet tadapyaava"syaka.m|</para>
  <para style="p">
    <verse number="11" style="v"/>kintu yuvatii rvidhavaa na g.rhaa.na yata.h khrii.s.tasya vaipariityena taasaa.m darpe jaate taa vivaaham icchanti|</para>
  <para style="p">
    <verse number="12" style="v"/>tasmaacca puurvvadharmma.m parityajya da.n.daniiyaa bhavanti|</para>
  <para style="p">
    <verse number="13" style="v"/>anantara.m taa g.rhaad g.rha.m paryya.tantya aalasya.m "sik.sante kevalamaalasya.m nahi kintvanarthakaalaapa.m paraadhikaaracarccaa ncaapi "sik.samaa.naa anucitaani vaakyaani bhaa.sante|</para>
  <para style="p">
    <verse number="14" style="v"/>ato mameccheya.m yuvatyo vidhavaa vivaaha.m kurvvataam apatyavatyo bhavantu g.rhakarmma kurvvataa ncettha.m vipak.saaya kimapi nindaadvaara.m na dadatu|</para>
  <para style="p">
    <verse number="15" style="v"/>yata ita.h puurvvam api kaa"scit "sayataanasya pa"scaadgaaminyo jaataa.h|</para>
  <para style="p">
    <verse number="16" style="v"/>apara.m vi"svaasinyaa vi"svaasino vaa kasyaapi parivaaraa.naa.m madhye yadi vidhavaa vidyante tarhi sa taa.h pratipaalayatu tasmaat samitau bhaare .anaaropite satyavidhavaanaa.m pratipaalana.m karttu.m tayaa "sakyate|</para>
  <para style="p">
    <verse number="17" style="v"/>ye praa nca.h samiti.m samyag adhiti.s.thanti vi"se.sata ii"svaravaakyenopade"sena ca ye yatna.m vidadhate te dvigu.nasyaadarasya yogyaa maanyantaa.m|</para>
  <para style="p">
    <verse number="18" style="v"/>yasmaat "saastre likhitamidamaaste, tva.m "sasyamarddakav.r.sasyaasya.m maa badhaaneti, aparamapi kaaryyak.rd vetanasya yogyo bhavatiiti|</para>
  <para style="p">
    <verse number="19" style="v"/>dvau triin vaa saak.si.no vinaa kasyaacit praaciinasya viruddham abhiyogastvayaa na g.rhyataa.m|</para>
  <para style="p">
    <verse number="20" style="v"/>apara.m ye paapamaacaranti taan sarvve.saa.m samak.sa.m bhartsayasva tenaapare.saamapi bhiiti rjani.syate|</para>
  <para style="p">
    <verse number="21" style="v"/>aham ii"svarasya prabho ryii"sukhrii.s.tasya manoniitadivyaduutaanaa nca gocare tvaam idam aaj naapayaami tva.m kasyaapyanurodhena kimapi na kurvvana vinaapak.sapaatam etaana vidhiin paalaya|</para>
  <para style="p">
    <verse number="22" style="v"/>kasyaapi muurddhi hastaapar.na.m tvarayaa maakaar.sii.h| parapaapaanaa ncaa.m"sii maa bhava| sva.m "suci.m rak.sa|</para>
  <para style="p">
    <verse number="23" style="v"/>apara.m tavodarapii.daayaa.h puna.h puna durbbalataayaa"sca nimitta.m kevala.m toya.m na pivan ki ncin madya.m piva|</para>
  <para style="p">
    <verse number="24" style="v"/>ke.saa ncit maanavaanaa.m paapaani vicaaraat puurvva.m ke.saa ncit pa"scaat prakaa"sante|</para>
  <para style="p">
    <verse number="25" style="v"/>tathaiva satkarmmaa.nyapi prakaa"sante tadanyathaa sati pracchannaani sthaatu.m na "saknuvanti|</para>
  <chapter number="6" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>yaavanto lokaa yugadhaari.no daasaa.h santi te svasvasvaamina.m puur.nasamaadarayogya.m manyantaa.m no ced ii"svarasya naamna upade"sasya ca nindaa sambhavi.syati|</para>
  <para style="p">
    <verse number="2" style="v"/>ye.saa nca svaamino vi"svaasina.h bhavanti taiste bhraat.rtvaat naavaj neyaa.h kintu te karmmaphalabhogino vi"svaasina.h priyaa"sca bhavantiiti heto.h sevaniiyaa eva, tvam etaani "sik.saya samupadi"sa ca|</para>
  <para style="p">
    <verse number="3" style="v"/>ya.h ka"scid itara"sik.saa.m karoti, asmaaka.m prabho ryii"sukhrii.s.tasya hitavaakyaanii"svarabhakte ryogyaa.m "sik.saa nca na sviikaroti</para>
  <para style="p">
    <verse number="4" style="v"/>sa darpadhmaata.h sarvvathaa j naanahiina"sca vivaadai rvaagyuddhai"sca rogayukta"sca bhavati|</para>
  <para style="p">
    <verse number="5" style="v"/>taad.r"saad bhaavaad iir.syaavirodhaapavaadadu.s.taasuuyaa bhra.s.tamanasaa.m satyaj naanahiinaanaam ii"svarabhakti.m laabhopaayam iva manyamaanaanaa.m lokaanaa.m vivaadaa"sca jaayante taad.r"sebhyo lokebhyastva.m p.rthak ti.s.tha|</para>
  <para style="p">
    <verse number="6" style="v"/>sa.myatecchayaa yuktaa ye"svarabhakti.h saa mahaalaabhopaayo bhavatiiti satya.m|</para>
  <para style="p">
    <verse number="7" style="v"/>etajjagatprave"sanakaale.asmaabhi.h kimapi naanaayi tattayajanakaale.api kimapi netu.m na "sak.syata iti ni"scita.m|</para>
  <para style="p">
    <verse number="8" style="v"/>ataeva khaadyaanyaacchaadanaani ca praapyaasmaabhi.h santu.s.tai rbhavitavya.m|</para>
  <para style="p">
    <verse number="9" style="v"/>ye tu dhanino bhavitu.m ce.s.tante te pariik.saayaam unmaathe patanti ye caabhilaa.saa maanavaan vinaa"se narake ca majjayanti taad.r"se.svaj naanaahitaabhilaa.se.svapi patanti|</para>
  <para style="p">
    <verse number="10" style="v"/>yato.arthasp.rhaa sarvve.saa.m duritaanaa.m muula.m bhavati taamavalambya kecid vi"svaasaad abhra.m"santa naanaakle"sai"sca svaan avidhyan|</para>
  <para style="p">
    <verse number="11" style="v"/>he ii"svarasya loka tvam etebhya.h palaayya dharmma ii"svarabhakti rvi"svaasa.h prema sahi.s.nutaa k.saanti"scaitaanyaacara|</para>
  <para style="p">
    <verse number="12" style="v"/>vi"svaasaruupam uttamayuddha.m kuru, anantajiivanam aalambasva yatastadartha.m tvam aahuuto .abhava.h, bahusaak.si.naa.m samak.sa ncottamaa.m pratij naa.m sviik.rtavaan|</para>
  <para style="p">
    <verse number="13" style="v"/>apara.m sarvve.saa.m jiivayiturii"svarasya saak.saad ya"sca khrii.s.to yii"su.h pantiiyapiilaatasya samak.sam uttamaa.m pratij naa.m sviik.rtavaan tasya saak.saad aha.m tvaam idam aaj naapayaami|</para>
  <para style="p">
    <verse number="14" style="v"/>ii"svare.na svasamaye prakaa"sitavyam asmaaka.m prabho ryii"sukhrii.s.tasyaagamana.m yaavat tvayaa ni.skala"nkatvena nirddo.satvena ca vidhii rak.syataa.m|</para>
  <para style="p">
    <verse number="15" style="v"/>sa ii"svara.h saccidaananda.h, advitiiyasamraa.t, raaj naa.m raajaa, prabhuunaa.m prabhu.h,</para>
  <para style="p">
    <verse number="16" style="v"/>amarataayaa advitiiya aakara.h, agamyatejonivaasii, marttyaanaa.m kenaapi na d.r.s.ta.h kenaapi na d.r"sya"sca| tasya gauravaparaakramau sadaatanau bhuuyaastaa.m| aamen|</para>
  <para style="p">
    <verse number="17" style="v"/>ihaloke ye dhaninaste cittasamunnati.m capale dhane vi"svaasa nca na kurvvataa.m kintu bhogaartham asmabhya.m pracuratvena sarvvadaataa</para>
  <para style="p">
    <verse number="18" style="v"/>yo.amara ii"svarastasmin vi"svasantu sadaacaara.m kurvvantu satkarmmadhanena dhanino sukalaa daataara"sca bhavantu,</para>
  <para style="p">
    <verse number="19" style="v"/>yathaa ca satya.m jiivana.m paapnuyustathaa paaratrikaam uttamasampada.m sa ncinvantveti tvayaadi"syantaa.m|</para>
  <para style="p">
    <verse number="20" style="v"/>he tiimathiya, tvam upanidhi.m gopaya kaalpanikavidyaayaa apavitra.m pralaapa.m virodhokti nca tyaja ca,</para>
  <para style="p">
    <verse number="21" style="v"/>yata.h katipayaa lokaastaa.m vidyaamavalambya vi"svaasaad bhra.s.taa abhavana| prasaadastava sahaayo bhuuyaat| aamen|</para>
</usx>
