  <para style="h">Philippians</para>
  <para style="toc1">philipina.h patra.m</para>
  <para style="toc2">philipina.h</para>
  <para style="toc3">philipina.h</para>
  <para style="mt1">philipina.h patra.m</para>
  <chapter number="1" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>paulatiimathinaamaanau yii"sukhrii.s.tasya daasau philipinagarasthaan khrii.s.tayii"so.h sarvvaan pavitralokaan samiteradhyak.saan paricaarakaa.m"sca prati patra.m likhata.h|</para>
  <para style="p">
    <verse number="2" style="v"/>asmaaka.m taata ii"svara.h prabhu ryii"sukhrii.s.ta"sca yu.smabhya.m prasaadasya "saante"sca bhoga.m deyaastaa.m|</para>
  <para style="p">
    <verse number="3" style="v"/>aha.m nirantara.m nijasarvvapraarthanaasu yu.smaaka.m sarvve.saa.m k.rte saananda.m praarthanaa.m kurvvan</para>
  <para style="p">
    <verse number="4" style="v"/>yati vaaraan yu.smaaka.m smaraami tati vaaraan aa prathamaad adya yaavad</para>
  <para style="p">
    <verse number="5" style="v"/>yu.smaaka.m susa.mvaadabhaagitvakaara.naad ii"svara.m dhanya.m vadaami|</para>
  <para style="p">
    <verse number="6" style="v"/>yu.smanmadhye yenottama.m karmma karttum aarambhi tenaiva yii"sukhrii.s.tasya dina.m yaavat tat saadhayi.syata ityasmin d.r.dhavi"svaaso mamaaste|</para>
  <para style="p">
    <verse number="7" style="v"/>yu.smaan sarvvaan adhi mama taad.r"so bhaavo yathaartho yato.aha.m kaaraavasthaayaa.m pratyuttarakara.ne susa.mvaadasya praamaa.nyakara.ne ca yu.smaan sarvvaan mayaa saarddham ekaanugrahasya bhaagino matvaa svah.rdaye dhaarayaami|</para>
  <para style="p">
    <verse number="8" style="v"/>aparam aha.m khrii.s.tayii"so.h snehavat snehena yu.smaan kiid.r"sa.m kaa"nk.saami tadadhii"svaro mama saak.sii vidyate|</para>
  <para style="p">
    <verse number="9" style="v"/>mayaa yat praarthyate tad ida.m yu.smaaka.m prema nitya.m v.rddhi.m gatvaa</para>
  <para style="p">
    <verse number="10" style="v"/>j naanasya vi"si.s.taanaa.m pariik.sikaayaa"sca sarvvavidhabuddhe rbaahulya.m phalatu,</para>
  <para style="p">
    <verse number="11" style="v"/>khrii.s.tasya dina.m yaavad yu.smaaka.m saaralya.m nirvighnatva nca bhavatu, ii"svarasya gauravaaya pra"sa.msaayai ca yii"sunaa khrii.s.tena pu.nyaphalaanaa.m puur.nataa yu.smabhya.m diiyataam iti|</para>
  <para style="p">
    <verse number="12" style="v"/>he bhraatara.h, maa.m prati yad yad gha.tita.m tena susa.mvaadapracaarasya baadhaa nahi kintu v.rddhireva jaataa tad yu.smaan j naapayitu.m kaamaye.aha.m|</para>
  <para style="p">
    <verse number="13" style="v"/>aparam aha.m khrii.s.tasya k.rte baddho.asmiiti raajapuryyaam anyasthaane.su ca sarvve.saa.m nika.te suspa.s.tam abhavat,</para>
  <para style="p">
    <verse number="14" style="v"/>prabhusambandhiiyaa aneke bhraatara"sca mama bandhanaad aa"svaasa.m praapya varddhamaanenotsaahena ni.hk.sobha.m kathaa.m pracaarayanti|</para>
  <para style="p">
    <verse number="15" style="v"/>kecid dve.saad virodhaaccaapare kecicca sadbhaavaat khrii.s.ta.m gho.sayanti;</para>
  <para style="p">
    <verse number="16" style="v"/>ye virodhaat khrii.s.ta.m gho.sayanti te pavitrabhaavaat tanna kurvvanto mama bandhanaani bahutaraklo"sadaayiini karttum icchanti|</para>
  <para style="p">
    <verse number="17" style="v"/>ye ca premnaa gho.sayanti te susa.mvaadasya praamaa.nyakara.ne.aha.m niyukto.asmiiti j naatvaa tat kurvvanti|</para>
  <para style="p">
    <verse number="18" style="v"/>ki.m bahunaa? kaapa.tyaat saralabhaavaad vaa bhavet, yena kenacit prakaare.na khrii.s.tasya gho.sa.naa bhavatiityasmin aham aanandaamyaanandi.syaami ca|</para>
  <para style="p">
    <verse number="19" style="v"/>yu.smaaka.m praarthanayaa yii"sukhrii.s.tasyaatmana"scopakaare.na tat mannistaarajanaka.m bhavi.syatiiti jaanaami|</para>
  <para style="p">
    <verse number="20" style="v"/>tatra ca mamaakaa"nk.saa pratyaa"saa ca siddhi.m gami.syati phalato.aha.m kenaapi prakaare.na na lajji.sye kintu gate sarvvasmin kaale yadvat tadvad idaaniimapi sampuur.notsaahadvaaraa mama "sariire.na khrii.s.tasya mahimaa jiivane mara.ne vaa prakaa"si.syate|</para>
  <para style="p">
    <verse number="21" style="v"/>yato mama jiivana.m khrii.s.taaya mara.na nca laabhaaya|</para>
  <para style="p">
    <verse number="22" style="v"/>kintu yadi "sariire mayaa jiivitavya.m tarhi tat karmmaphala.m phali.syati tasmaat ki.m varitavya.m tanmayaa na j naayate|</para>
  <para style="p">
    <verse number="23" style="v"/>dvaabhyaam aha.m sampii.dye, dehavaasatyajanaaya khrii.s.tena sahavaasaaya ca mamaabhilaa.so bhavati yatastat sarvvottama.m|</para>
  <para style="p">
    <verse number="24" style="v"/>kintu dehe mamaavasthityaa yu.smaakam adhikaprayojana.m|</para>
  <para style="p">
    <verse number="25" style="v"/>aham avasthaasye yu.smaabhi.h sarvvai.h saarddham avasthiti.m kari.sye ca tayaa ca vi"svaase yu.smaaka.m v.rddhyaanandau jani.syete tadaha.m ni"scita.m jaanaami|</para>
  <para style="p">
    <verse number="26" style="v"/>tena ca matto.arthato yu.smatsamiipe mama punarupasthitatvaat yuuya.m khrii.s.tena yii"sunaa bahutaram aahlaada.m lapsyadhve|</para>
  <para style="p">
    <verse number="27" style="v"/>yuuya.m saavadhaanaa bhuutvaa khrii.s.tasya susa.mvaadasyopayuktam aacaara.m kurudhva.m yato.aha.m yu.smaan upaagatya saak.saat kurvvan ki.m vaa duure ti.s.than yu.smaaka.m yaa.m vaarttaa.m "srotum icchaami seya.m yuuyam ekaatmaanasti.s.thatha, ekamanasaa susa.mvaadasambandhiiyavi"svaasasya pak.se yatadhve, vipak.sai"sca kenaapi prakaare.na na vyaakuliikriyadhva iti|</para>
  <para style="p">
    <verse number="28" style="v"/>tat te.saa.m vinaa"sasya lak.sa.na.m yu.smaaka nce"svaradatta.m paritraa.nasya lak.sa.na.m bhavi.syati|</para>
  <para style="p">
    <verse number="29" style="v"/>yato yena yu.smaabhi.h khrii.s.te kevalavi"svaasa.h kriyate tannahi kintu tasya k.rte kle"so.api sahyate taad.r"so vara.h khrii.s.tasyaanurodhaad yu.smaabhi.h praapi,</para>
  <para style="p">
    <verse number="30" style="v"/>tasmaat mama yaad.r"sa.m yuddha.m yu.smaabhiradar"si saamprata.m "sruuyate ca taad.r"sa.m yuddha.m yu.smaakam api bhavati|</para>
  <chapter number="2" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>khrii.s.taad yadi kimapi saantvana.m ka"scit premajaato har.sa.h ki ncid aatmana.h samabhaagitva.m kaacid anukampaa k.rpaa vaa jaayate tarhi yuuya.m mamaahlaada.m puurayanta</para>
  <para style="p">
    <verse number="2" style="v"/>ekabhaavaa ekapremaa.na ekamanasa ekace.s.taa"sca bhavata|</para>
  <para style="p">
    <verse number="3" style="v"/>virodhaad darpaad vaa kimapi maa kuruta kintu namratayaa svebhyo.aparaan vi"si.s.taan manyadhva.m|</para>
  <para style="p">
    <verse number="4" style="v"/>kevalam aatmahitaaya na ce.s.tamaanaa.h parahitaayaapi ce.s.tadhva.m|</para>
  <para style="p">
    <verse number="5" style="v"/>khrii.s.tasya yii"so ryaad.r"sa.h svabhaavo yu.smaakam api taad.r"so bhavatu|</para>
  <para style="p">
    <verse number="6" style="v"/>sa ii"svararuupii san svakiiyaam ii"svaratulyataa.m "slaaghaaspada.m naamanyata,</para>
  <para style="p">
    <verse number="7" style="v"/>kintu sva.m "suunya.m k.rtvaa daasaruupii babhuuva naraak.rti.m lebhe ca|</para>
  <para style="p">
    <verse number="8" style="v"/>ittha.m naramuurttim aa"sritya namrataa.m sviik.rtya m.rtyorarthata.h kru"siiyam.rtyoreva bhogaayaaj naagraahii babhuuva|</para>
  <para style="p">
    <verse number="9" style="v"/>tatkaara.naad ii"svaro.api ta.m sarvvonnata.m cakaara yacca naama sarvve.saa.m naamnaa.m "sre.s.tha.m tadeva tasmai dadau,</para>
  <para style="p">
    <verse number="10" style="v"/>tatastasmai yii"sunaamne svargamartyapaataalasthitai.h sarvvai rjaanupaata.h karttavya.h,</para>
  <para style="p">
    <verse number="11" style="v"/>taatasthe"svarasya mahimne ca yii"sukhrii.s.ta.h prabhuriti jihvaabhi.h sviikarttavya.m|</para>
  <para style="p">
    <verse number="12" style="v"/>ato he priyatamaa.h, yu.smaabhi ryadvat sarvvadaa kriyate tadvat kevale mamopasthitikaale tannahi kintvidaaniim anupasthite.api mayi bahutarayatnenaaj naa.m g.rhiitvaa bhayakampaabhyaa.m svasvaparitraa.na.m saadhyataa.m|</para>
  <para style="p">
    <verse number="13" style="v"/>yata ii"svara eva svakiiyaanurodhaad yu.smanmadhye manaskaamanaa.m karmmasiddhi nca vidadhaati|</para>
  <para style="p">
    <verse number="14" style="v"/>yuuya.m kalahavivaadarvijatam aacaara.m kurvvanto.anindaniiyaa aku.tilaa</para>
  <para style="p">
    <verse number="15" style="v"/>ii"svarasya ni.skala"nkaa"sca santaanaaiva vakrabhaavaanaa.m ku.tilaacaari.naa nca lokaanaa.m madhye ti.s.thata,</para>
  <para style="p">
    <verse number="16" style="v"/>yataste.saa.m madhye yuuya.m jiivanavaakya.m dhaarayanto jagato diipakaa iva diipyadhve| yu.smaabhistathaa k.rte mama yatna.h pari"sramo vaa na ni.sphalo jaata ityaha.m khrii.s.tasya dine "slaaghaa.m karttu.m "sak.syaami|</para>
  <para style="p">
    <verse number="17" style="v"/>yu.smaaka.m vi"svaasaarthakaaya balidaanaaya sevanaaya ca yadyapyaha.m niveditavyo bhaveya.m tathaapi tenaanandaami sarvve.saa.m yu.smaakam aanandasyaa.m"sii bhavaami ca|</para>
  <para style="p">
    <verse number="18" style="v"/>tadvad yuuyamapyaanandata madiiyaanandasyaa.m"sino bhavata ca|</para>
  <para style="p">
    <verse number="19" style="v"/>yu.smaakam avasthaam avagatyaahamapi yat saantvanaa.m praapnuyaa.m tadartha.m tiimathiya.m tvarayaa yu.smatsamiipa.m pre.sayi.syaamiiti prabhau pratyaa"saa.m kurvve|</para>
  <para style="p">
    <verse number="20" style="v"/>ya.h satyaruupe.na yu.smaaka.m hita.m cintayati taad.r"sa ekabhaavastasmaadanya.h ko.api mama sannidhau naasti|</para>
  <para style="p">
    <verse number="21" style="v"/>yato.apare sarvve yii"so.h khrii.s.tasya vi.sayaan na cintayanta aatmavi.sayaan cintayanti|</para>
  <para style="p">
    <verse number="22" style="v"/>kintu tasya pariik.sitatva.m yu.smaabhi rj naayate yata.h putro yaad.rk pitu.h sahakaarii bhavati tathaiva susa.mvaadasya paricaryyaayaa.m sa mama sahakaarii jaata.h|</para>
  <para style="p">
    <verse number="23" style="v"/>ataeva mama bhaavida"saa.m j naatvaa tatk.sa.naat tameva pre.sayitu.m pratyaa"saa.m kurvve</para>
  <para style="p">
    <verse number="24" style="v"/>svayam ahamapi tuur.na.m yu.smatsamiipa.m gami.syaamiityaa"saa.m prabhunaa kurvve|</para>
  <para style="p">
    <verse number="25" style="v"/>apara.m ya ipaaphradiito mama bhraataa karmmayuddhaabhyaa.m mama sahaaya"sca yu.smaaka.m duuto madiiyopakaaraaya pratinidhi"scaasti yu.smatsamiipe tasya pre.sa.nam aava"syakam amanye|</para>
  <para style="p">
    <verse number="26" style="v"/>yata.h sa yu.smaan sarvvaan akaa"nk.sata yu.smaabhistasya rogasya vaarttaa"sraaviiti buddhvaa paryya"socacca|</para>
  <para style="p">
    <verse number="27" style="v"/>sa pii.dayaa m.rtakalpo.abhavaditi satya.m kintvii"svarasta.m dayitavaan mama ca du.hkhaat para.m punardu.hkha.m yanna bhavet tadartha.m kevala.m ta.m na dayitvaa maamapi dayitavaan|</para>
  <para style="p">
    <verse number="28" style="v"/>ataeva yuuya.m ta.m vilokya yat punaraanandeta mamaapi du.hkhasya hraaso yad bhavet tadartham aha.m tvarayaa tam apre.saya.m|</para>
  <para style="p">
    <verse number="29" style="v"/>ato yuuya.m prabho.h k.rte sampuur.nenaanandena ta.m g.rhliita taad.r"saan lokaa.m"scaadara.niiyaan manyadhva.m|</para>
  <para style="p">
    <verse number="30" style="v"/>yato mama sevane yu.smaaka.m tru.ti.m puurayitu.m sa praa.naan pa.niik.rtya khrii.s.tasya kaaryyaartha.m m.rtapraaye.abhavat|</para>
  <chapter number="3" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>he bhraatara.h, "se.se vadaami yuuya.m prabhaavaanandata| puna.h punarekasya vaco lekhana.m mama kle"sada.m nahi yu.smadartha nca bhramanaa"saka.m bhavati|</para>
  <para style="p">
    <verse number="2" style="v"/>yuuya.m kukkurebhya.h saavadhaanaa bhavata du.skarmmakaaribhya.h saavadhaanaa bhavata chinnamuulebhyo lokebhya"sca saavadhaanaa bhavata|</para>
  <para style="p">
    <verse number="3" style="v"/>vayameva chinnatvaco lokaa yato vayam aatmane"svara.m sevaamahe khrii.s.tena yii"sunaa "slaaghaamahe "sariire.na ca pragalbhataa.m na kurvvaamahe|</para>
  <para style="p">
    <verse number="4" style="v"/>kintu "sariire mama pragalbhataayaa.h kaara.na.m vidyate, ka"scid yadi "sariire.na pragalbhataa.m cikiir.sati tarhi tasmaad api mama pragalbhataayaa gurutara.m kaara.na.m vidyate|</para>
  <para style="p">
    <verse number="5" style="v"/>yato.aham a.s.tamadivase tvakchedapraapta israayelva.m"siiyo binyaamiinago.s.thiiya ibrikulajaata ibriyo vyavasthaacara.ne phiruu"sii</para>
  <para style="p">
    <verse number="6" style="v"/>dharmmotsaahakaara.naat samiterupadravakaarii vyavasthaato labhye pu.nye caanindaniiya.h|</para>
  <para style="p">
    <verse number="7" style="v"/>kintu mama yadyat labhyam aasiit tat sarvvam aha.m khrii.s.tasyaanurodhaat k.satim amanye|</para>
  <para style="p">
    <verse number="8" style="v"/>ki ncaadhunaapyaha.m matprabho.h khrii.s.tasya yii"so rj naanasyotk.r.s.tataa.m buddhvaa tat sarvva.m k.sati.m manye|</para>
  <para style="p">
    <verse number="9" style="v"/>yato hetoraha.m yat khrii.s.ta.m labheya vyavasthaato jaata.m svakiiyapu.nya nca na dhaarayan kintu khrii.s.te vi"svasanaat labhya.m yat pu.nyam ii"svare.na vi"svaasa.m d.r.s.tvaa diiyate tadeva dhaarayan yat khrii.s.te vidyeya tadartha.m tasyaanurodhaat sarvve.saa.m k.sati.m sviik.rtya taani sarvvaa.nyavakaraaniva manye|</para>
  <para style="p">
    <verse number="10" style="v"/>yato hetoraha.m khrii.s.ta.m tasya punarutthite rgu.na.m tasya du.hkhaanaa.m bhaagitva nca j naatvaa tasya m.rtyoraak.rti nca g.rhiitvaa</para>
  <para style="p">
    <verse number="11" style="v"/>yena kenacit prakaare.na m.rtaanaa.m punarutthiti.m praaptu.m yate|</para>
  <para style="p">
    <verse number="12" style="v"/>mayaa tat sarvvam adhunaa praapi siddhataa vaalambhi tannahi kintu yadartham aha.m khrii.s.tena dhaaritastad dhaarayitu.m dhaavaami|</para>
  <para style="p">
    <verse number="13" style="v"/>he bhraatara.h, mayaa tad dhaaritam iti na manyate kintvetadaikamaatra.m vadaami yaani pa"scaat sthitaani taani vism.rtyaaham agrasthitaanyuddi"sya</para>
  <para style="p">
    <verse number="14" style="v"/>puur.nayatnena lak.sya.m prati dhaavan khrii.s.tayii"sunorddhvaat maam aahvayata ii"svaraat jet.rpa.na.m praaptu.m ce.s.te|</para>
  <para style="p">
    <verse number="15" style="v"/>asmaaka.m madhye ye siddhaastai.h sarvvaistadeva bhaavyataa.m, yadi ca ka ncana vi.sayam adhi yu.smaakam aparo bhaavo bhavati tarhii"svarastamapi yu.smaaka.m prati prakaa"sayi.syati|</para>
  <para style="p">
    <verse number="16" style="v"/>kintu vaya.m yadyad avagataa aasmastatraasmaabhireko vidhiraacaritavya ekabhaavai rbhavitavya nca|</para>
  <para style="p">
    <verse number="17" style="v"/>he bhraatara.h, yuuya.m mamaanugaamino bhavata vaya nca yaad.rgaacara.nasya nidar"sanasvaruupaa bhavaamastaad.rgaacaari.no lokaan aalokayadhva.m|</para>
  <para style="p">
    <verse number="18" style="v"/>yato.aneke vipathe caranti te ca khrii.s.tasya kru"sasya "satrava iti puraa mayaa puna.h puna.h kathitam adhunaapi rudataa mayaa kathyate|</para>
  <para style="p">
    <verse number="19" style="v"/>te.saa.m "se.sada"saa sarvvanaa"sa udara"sce"svaro lajjaa ca "slaaghaa p.rthivyaa nca lagna.m mana.h|</para>
  <para style="p">
    <verse number="20" style="v"/>kintvasmaaka.m janapada.h svarge vidyate tasmaaccaagami.syanta.m traataara.m prabhu.m yii"sukhrii.s.ta.m vaya.m pratiik.saamahe|</para>
  <para style="p">
    <verse number="21" style="v"/>sa ca yayaa "saktyaa sarvvaa.nyeva svasya va"siikarttu.m paarayati tayaasmaakam adhama.m "sariira.m ruupaantariik.rtya svakiiyatejomaya"sariirasya samaakaara.m kari.syati|</para>
  <chapter number="4" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>he madiiyaanandamuku.tasvaruupaa.h priyatamaa abhii.s.tatamaa bhraatara.h, he mama snehapaatraa.h, yuuyam ittha.m pabhau sthiraasti.s.thata|</para>
  <para style="p">
    <verse number="2" style="v"/>he ivadiye he suntukhi yuvaa.m prabhau ekabhaave bhavatam etad aha.m praarthaye|</para>
  <para style="p">
    <verse number="3" style="v"/>he mama satya sahakaarin tvaamapi viniiya vadaami etayorupakaarastvayaa kriyataa.m yataste kliiminaadibhi.h sahakaaribhi.h saarddha.m susa.mvaadapracaara.naaya mama saahaayyaartha.m pari"sramam akurvvataa.m te.saa.m sarvve.saa.m naamaani ca jiivanapustake likhitaani vidyante|</para>
  <para style="p">
    <verse number="4" style="v"/>yuuya.m prabhau sarvvadaanandata| puna rvadaami yuuyam aanandata|</para>
  <para style="p">
    <verse number="5" style="v"/>yu.smaaka.m viniitatva.m sarvvamaanavai rj naayataa.m, prabhu.h sannidhau vidyate|</para>
  <para style="p">
    <verse number="6" style="v"/>yuuya.m kimapi na cintayata kintu dhanyavaadayuktaabhyaa.m praarthanaayaa ncaabhyaa.m sarvvavi.saye svapraarthaniiyam ii"svaraaya nivedayata|</para>
  <para style="p">
    <verse number="7" style="v"/>tathaa k.rta ii"svariiyaa yaa "saanti.h sarvvaa.m buddhim ati"sete saa yu.smaaka.m cittaani manaa.msi ca khrii.s.te yii"sau rak.si.syati|</para>
  <para style="p">
    <verse number="8" style="v"/>he bhraatara.h, "se.se vadaami yadyat satyam aadara.niiya.m nyaayya.m saadhu priya.m sukhyaatam anye.na yena kenacit prakaare.na vaa gu.nayukta.m pra"sa.msaniiya.m vaa bhavati tatraiva manaa.msi nidhadhva.m|</para>
  <para style="p">
    <verse number="9" style="v"/>yuuya.m maa.m d.r.s.tvaa "srutvaa ca yadyat "sik.sitavanto g.rhiitavanta"sca tadevaacarata tasmaat "saantidaayaka ii"svaro yu.smaabhi.h saarddha.m sthaasyati|</para>
  <para style="p">
    <verse number="10" style="v"/>mamopakaaraaya yu.smaaka.m yaa cintaa puurvvam aasiit kintu karmmadvaara.m na praapnot idaanii.m saa punaraphalat ityasmin prabhau mama paramaahlaado.ajaayata|</para>
  <para style="p">
    <verse number="11" style="v"/>aha.m yad dainyakaara.naad ida.m vadaami tannahi yato mama yaa kaacid avasthaa bhavet tasyaa.m santo.s.tum a"sik.saya.m|</para>
  <para style="p">
    <verse number="12" style="v"/>daridrataa.m bhoktu.m "saknomi dhanaa.dhyataam api bhoktu.m "saknomi sarvvathaa sarvvavi.saye.su viniito.aha.m pracurataa.m k.sudhaa nca dhana.m dainya ncaavagato.asmi|</para>
  <para style="p">
    <verse number="13" style="v"/>mama "saktidaayakena khrii.s.tena sarvvameva mayaa "sakya.m bhavati|</para>
  <para style="p">
    <verse number="14" style="v"/>kintu yu.smaabhi rdainyanivaara.naaya maam upak.rtya satkarmmaakaari|</para>
  <para style="p">
    <verse number="15" style="v"/>he philipiiyalokaa.h, susa.mvaadasyodayakaale yadaaha.m maakidaniyaade"saat prati.s.the tadaa kevalaan yu.smaan vinaaparayaa kayaapi samityaa saha daanaadaanayo rmama ko.api sambandho naasiid iti yuuyamapi jaaniitha|</para>
  <para style="p">
    <verse number="16" style="v"/>yato yu.smaabhi rmama prayojanaaya thi.salaniikiinagaramapi maa.m prati puna.h punardaana.m pre.sita.m|</para>
  <para style="p">
    <verse number="17" style="v"/>aha.m yad daana.m m.rgaye tannahi kintu yu.smaaka.m laabhavarddhaka.m phala.m m.rgaye|</para>
  <para style="p">
    <verse number="18" style="v"/>kintu mama kasyaapyabhaavo naasti sarvva.m pracuram aaste yata ii"svarasya graahya.m tu.s.tijanaka.m sugandhinaivedyasvaruupa.m yu.smaaka.m daana.m ipaaphraditaad g.rhiitvaaha.m parit.rpto.asmi|</para>
  <para style="p">
    <verse number="19" style="v"/>mame"svaro.api khrii.s.tena yii"sunaa svakiiyavibhavanidhita.h prayojaniiya.m sarvvavi.saya.m puur.naruupa.m yu.smabhya.m deyaat|</para>
  <para style="p">
    <verse number="20" style="v"/>asmaaka.m piturii"svarasya dhanyavaado.anantakaala.m yaavad bhavatu| aamen|</para>
  <para style="p">
    <verse number="21" style="v"/>yuuya.m yii"sukhrii.s.tasyaikaika.m pavitrajana.m namaskuruta| mama sa"ngibhraataro yuu.smaan namaskurvvate|</para>
  <para style="p">
    <verse number="22" style="v"/>sarvve pavitralokaa vi"se.sata.h kaisarasya parijanaa yu.smaan namaskurvvate|</para>
  <para style="p">
    <verse number="23" style="v"/>asmaaka.m prabho ryii"sukhrii.s.tasya prasaada.h sarvvaan yu.smaan prati bhuuyaat| aamen|</para>
</usx>
