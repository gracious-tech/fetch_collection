<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="1TH" style="id">- Sumau Garia Bible - Unicode</book>
  <para style="h">1 Ts</para>
  <para style="toc3">1 Ts</para>
  <para style="toc2">1 Ts</para>
  <para style="toc1">1 Tesalonaika</para>
  <para style="ide"/>
  <para style="rem"/>
  <para style="rem"/>
  <para style="h"/>
  <para style="mt2">Xoka kireni nakau</para>
  <para style="mt">Polue Tesalonaika xosaniki xayawotai</para>
  <para style="imt">Akereki kuna</para>
  <para style="ip">Erewese Tesalonaika paiya propinsi Mesetoniapu kokaipa erewese purina. Polue Pilipai weti Tesalonaika xouna pa erewese xosa Yesusure xonikisuwoteneai xuiapu sainikereyai. (Yesusupo Tianuwopi Teu 17.1-9) Pana xokupa xuiapue Polupo kuna iyeserineri xonikisuneri Yesusu taiwori, Yuta apimie xekeri Polure xonikikemu xoxi xati xesawori Tesalonaika wetetai. Xurise, Polue xouna erewese Korin purotai yause xosa, nupo saina emeu Timotie kouna Tesalonaikapue Yesusure xonikisuwoteneai xosa kapia yaraxeteneaire Polu kawotai.</para>
  <para style="ip">Polue Timotipo asi iyeserina Polu nuko xeika Sailasino Timotino xeikae ninipo xonikisu sokisokiwopure mua nakau xayawoteneai. Kireu sipa apimie nanuneri mua nakau paiya Polupo xokupa nakau kokaipa nakau yoira xosa puroteneaipo akereki nakau xeteneai. Mua nakau xosa Yesusure xonikisuwoteneaie Tesalonaika puroteneai nikau xonikisu xeika asinaku kapia xeikaure Polue nimaririwotai.</para>
  <para style="ip">Pa xuiapue Yesusure xonikisuwoteneai paiya Kristusu nu amakina xiyeri kopina nini sipa xuwe. Ninie sipawopure kunauneri Kristusu xiyeri kopu xuweuni apimi xumuweteneai paiya, nini rania sipesi puropineri ekinikioma tepinerire? Kristusu nu amu yause yauseni kutu kopinana? Polue ninipo koto xapa ipaki kanikina, tini asinaku kapia tainari Kokaipa kopina yauseure ireiwa niketai.</para>
  <chapter number="1" style="c" sid="1TH 1"/>
  <para style="ms">Polue nupo saina emeumanapu Tesalonaika kinire xiri eiyoxeteneai</para>
  <para style="mr">
    <ref loc="1TH 1-3">1—3</ref></para>
  <para style="d"/>
  <para style="p">
    <verse number="1" style="v" sid="1TH 1:1"/>Sini<note caller="-" style="x"><char style="xo" closed="false">1.1 </char><char style="xt" closed="false"><ref loc="ACT 17:1-13">YT 17.1-13</ref>;<ref loc="2TH 1:1">2 Ts 1.1</ref></char></note> Polu xuno Sailasi xuno Timoti xunoe, mua nakau tini Tesalonaika erewesepu xuiapu xosa xayaritikinuku. Paiya tinie Emisiki xeika Kokaipa Yesusu Kristusu xeikaure xotikisinuku etokipurikiriai xosa.</para>
  <para style="p" vid="1TH 1:1">Xoiteue tinire xousuaxina xouwetikatia, tinipo xotikikemu yoroni purakuai.<verse eid="1TH 1:1"/></para>
  <para style="s">Tesalonaika nikau xonikisure Polue nimaririwotai</para>
  <para style="p">
    <verse number="2" style="v" sid="1TH 1:2"/>Xokupa<note caller="-" style="x"><char style="xo" closed="false">1.2 </char><char style="xt" closed="false"><ref loc="EPH 1:16">Ep 1.16</ref>;<ref loc="PHP 1:3-4">Pl 1.3-4</ref>;<ref loc="COL 1:3">Kl 1.3</ref>;<ref loc="2TH 1:11">2 Ts 1.11</ref></char></note> yause sinie tinire nanunanunuku Xoiteu eiyaseurounuku. Sinipo xokupa kunikuni xosa tinipo wenitiki tirounuku. <verse eid="1TH 1:2"/><verse number="3" style="v" sid="1TH 1:3"/>Tinipo xotikisue<note caller="-" style="x"><char style="xo" closed="false">1.3 </char><char style="xt" closed="false"><ref loc="1CO 13:13">1 Ko 13.13</ref>;<ref loc="GAL 5:6">Ka 5.6</ref>;<ref loc="COL 1:4-6">Kl 1.4-6</ref>;<ref loc="HEB 6:10">Ip 6.10</ref></char></note> saitikerati asinaku kapia kakakuaire, kireu xotikikemu tinikinuku asinaku saina tinuku, xotikikemu sokisoki xinuku sikou Kokaipa Yesusu Kristusu yakukiriaire, sinie sikou Xoiteu Emisiki xosa eiyaseurounuku. <verse eid="1TH 1:3"/><verse number="4" style="v" sid="1TH 1:4"/>Tini<note caller="-" style="x"><char style="xo" closed="false">1.4 </char><char style="xt" closed="false"><ref loc="COL 3:12">Kl 3.12</ref>;<ref loc="2TH 2:13">2 Ts 2.13</ref></char></note> xatasikimana, Xoiteue tini xiri xouwetikina, tini nukouni kutu tumutikeretai xati, sini paire sipauweikiriai.<verse eid="1TH 1:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="1TH 1:5"/>Mua<note caller="-" style="x"><char style="xo" closed="false">1.5 </char><char style="xt" closed="false"><ref loc="1CO 2:4-5">1 Ko 2.4-5</ref>; <ref loc="1CO 4:20">4.20</ref>;<ref loc="COL 2:2">Kl 2.2</ref>;<ref loc="HEB 2:3">Ip 2.3</ref></char></note> asinaku kuna sinie tini xosa tikoukiniai paiya, aipu kuna sie tini xosa putawoyaixe. Xuwe. Nue sokisoki xeika Xoiteupo Supo Youya xeika putawati tinie atinuku sinipo sokisoki xosikisu xekeukiniai. Sinie tini xopu purinuku tini tianitikepure, asinaku kapia kakikiriai paiya tini takieni sipa.<verse eid="1TH 1:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="1TH 1:6"/>Tinie<note caller="-" style="x"><char style="xo" closed="false">1.6 </char><char style="xt" closed="false"><ref loc="ACT 17:1-9">YT 17.1-9</ref>;<ref loc="1CO 4:16">1 Ko 4.16</ref>; <ref loc="1CO 11:1">11.1</ref>;<ref loc="PHP 3:17">Pl 3.17</ref>;<ref loc="2TH 3:9">2 Ts 3.9</ref></char></note> Xoiteupo kuna tari, xokupa xu tini xosa putawotai sorena, tinie sinipo kapia xeika Kokaipapu kapia xeika taiwari, Xoiteupo Supo Youyae tini saitikerati tinie nimaririnuku. <verse eid="1TH 1:6"/><verse number="7" style="v" sid="1TH 1:7"/>Pa xati<note caller="-" style="x"><char style="xo" closed="false">1.7 </char><char style="xt" closed="false"><ref loc="1PE 5:3">1 Pi 5.3</ref></char></note> Mesetonia propinsi xeika Akaia propinsi xeika xosa xokupa xuiapue Kristusure xonikisuwori tinie asinaku kapia nini atarinikikiniai. <verse eid="1TH 1:7"/><verse number="8" style="v" sid="1TH 1:8"/>Tinie<note caller="-" style="x"><char style="xo" closed="false">1.8 </char><char style="xt" closed="false"><ref loc="ROM 1:8">Ro 1.8</ref></char></note> Kokaipapu kuna uteikiniai paie kiroma miria sie xouna xounawotai. Paiya Mesetonia xeika Akaia xeika masaira kireni xosa xowotaixe. Xuwe. Tinie Xoiteure xotikisuwari xokupa wesewesei tinire kuna iyesieteneai xati, sini pani nini kanikepinuku saina xuwe. <verse eid="1TH 1:8"/><verse number="9" style="v" sid="1TH 1:9"/>Sinie<note caller="-" style="x"><char style="xo" closed="false">1.9 </char><char style="xt" closed="false"><ref loc="ACT 14:15">YT 14.15</ref>;<ref loc="1CO 12:2">1 Ko 12.2</ref>;<ref loc="GAL 4:8">Ka 4.8</ref>;<ref loc="1TH 2:1">1 Ts 2.1</ref></char></note> tini xosa putaukiniai yause xosa kapia akipaxeyaire nikoini asiwarouneri. Tinie xoreixorei xoiteu teu wetinuku, nu sipesi purotai Xoiteuni kutu xosa xotikipirixikiriaire asiworoteneai. Tinie Xoiteupo aipu saina apu sainuku, <verse eid="1TH 1:9"/><verse number="10" style="v" sid="1TH 1:10"/>nupo<note caller="-" style="x"><char style="xo" closed="false">1.10 </char><char style="xt" closed="false"><ref loc="ACT 17:31">YT 17.31</ref>;<ref loc="1TH 4:16">1 Ts 4.16</ref>; <ref loc="1TH 5:9">5.9</ref>;<ref loc="TIT 2:13">Ta 2.13</ref>;<ref loc="2PE 3:12">2 Pi 3.12</ref></char></note> Nono xumati Xoiteue xiyeri saretaie mena xouro wetina koati tinie yakuari ninie asiworoteneai. Nu Yesusu, nue sini xiyeri sosikatia Xoiteupo kisamaira kopina yause xosa sini atinuku puropu.<verse eid="1TH 1:10"/></para>
  <chapter eid="1TH 1"/>
  <chapter number="2" style="c" sid="1TH 2"/>
  <para style="s">Polu nukoe Tesalonaika saina teyaire kunawotai</para>
  <para style="p">
    <verse number="1" style="v" sid="1TH 2:1"/>Yewapu xura<note caller="-" style="x"><char style="xo" closed="false">2.1 </char><char style="xt" closed="false"><ref loc="1TH 1:5">1 Ts 1.5</ref>; <ref loc="1TH 1:9">1.9</ref></char></note>, takieni sipa, sinie tini xopu purinuku saina tikiniai paiya, aini xuwexepu xuwe. <verse eid="1TH 2:1"/><verse number="2" style="v" sid="1TH 2:2"/>Tini<note caller="-" style="x"><char style="xo" closed="false">2.2 </char><char style="xt" closed="false"><ref loc="ACT 16:19-24">YT 16.19-24</ref>; <ref loc="ACT 17:1-9">17.1-9</ref>;<ref loc="PHP 1:30">Pl 1.30</ref>;<ref loc="COL 2:1">Kl 2.1</ref></char></note> sipa, sini tini xosa kopu xuweu yauseni, sini Pilipai erewese purikiri sinipo mupusiki xoxixoxiwori, tatau tikiniai. Pana sinie tini xosa koukiria, sikou Xoiteue sinipo xosikikemu sokisokiwati pa xiwayasikimanaure ximikinikikirixe. Xuwe. Sini sokisoki tumunuku tini xosa Xoiteupo asinaku kuna uteinuku. <verse eid="1TH 2:2"/><verse number="3" style="v" sid="1TH 2:3"/>Tinie Yesusure xotikisuwakuaire, tini yaitikinukua, sini kuna xoreiyerinuku, sini xunu kapiare e xorei kapia kakekixe. Xuwe. <verse eid="1TH 2:3"/><verse number="4" style="v" sid="1TH 2:4"/>Pana Xoiteue<note caller="-" style="x"><char style="xo" closed="false">2.4 </char><char style="xt" closed="false"><ref loc="JER 11:20">Yer 11.20</ref>;<ref loc="GAL 1:10">Ka 1.10</ref>;<ref loc="1TI 1:11">1 Ti 1.11</ref></char></note> sini uteisikieina nukou xouweni sini asinaku kuna uteiwopi saina siketai. Pa xati xuiapue sinipo sainaure xonikiewopineri xinuku nanuwori kuna uteikirixe. Xuwe. Xoiteueni sinipo xosikikemu uteirouna xati, nukoini sinipo saina xouwewopina xinuku. <verse eid="1TH 2:4"/><verse number="5" style="v" sid="1TH 2:5"/>Tini<note caller="-" style="x"><char style="xo" closed="false">2.5 </char><char style="xt" closed="false"><ref loc="ACT 20:33">YT 20.33</ref>;<ref loc="ROM 1:9">Ro 1.9</ref>;<ref loc="1TH 2:10">1 Ts 2.10</ref>;<ref loc="2PE 2:3">2 Pi 2.3</ref></char></note> sipauweikiriai xati Xoiteue rania panumu kunani kunawopina, sinie tini niraniratikepi sie kuna kunawopu xuwe, pa xeika sinie tinipo sapire ekisikie ninuku asinaku kuna katikepu xuwe. <verse eid="1TH 2:5"/><verse number="6" style="v" sid="1TH 2:6"/>Sinie<note caller="-" style="x"><char style="xo" closed="false">2.6 </char><char style="xt" closed="false"><ref loc="JHN 5:41">Yo 5.41</ref>; <ref loc="JHN 5:44">5.44</ref>;<ref loc="1CO 9:1-6">1 Ko 9.1-6</ref>;<ref loc="2CO 11:9">2 Ko 11.9</ref>;<ref loc="2TH 3:8-9">2 Ts 3.8-9</ref></char></note> tini xosare kireu xuimiapimi xosa kokaipa wenisiki tepure saina tepu xuwe. <verse eid="1TH 2:6"/><verse number="7" style="v" sid="1TH 2:7"/>Suau<note caller="-" style="x"><char style="xo" closed="false">2.7 </char><char style="xt" closed="false"><ref loc="1CO 2:3">1 Ko 2.3</ref>;<ref loc="2CO 13:4">2 Ko 13.4</ref>;<ref loc="2TI 2:24">2 Ti 2.24</ref></char></note>, sini Kristusupo tianuwopi purikiriai. Pa xati sini sapi xosikieukiriai xakua sini tianisikakuaire tini katikiku. Pana sini tini xeika purikiniai yausepa, sini nono misiarara sie peuni purikiniai. Sini xuie nupo nonomi apuri tiniki purotai siei purikiriai. <verse eid="1TH 2:7"/><verse number="8" style="v" sid="1TH 2:8"/>Sini tinire xiri xosikieunuku, pa xati sini Xoiteupo asinaku kuna tini tikepure xinuku. Pa xeika sinipo ekisikioma tini tikepure rania sini ireinuku, pa amure, tinie sinipo marouni kutu saikiriai.<verse eid="1TH 2:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="1TH 2:9"/>Yewapu xura<note caller="-" style="x"><char style="xo" closed="false">2.9 </char><char style="xt" closed="false"><ref loc="ACT 20:34">YT 20.34</ref>;<ref loc="1CO 4:12">1 Ko 4.12</ref>;<ref loc="2CO 11:9">2 Ko 11.9</ref>; <ref loc="2CO 12:15">12.15</ref></char></note>, sinie tini xeika purinuku Xoiteupo asinaku kuna uteinuku irereikiniaia tini sipauweikiriai. Tinie sini xoyeara sikakuai paiya tini xu tikepi xirarinuku, sini asau xeika ukumu xeika xosa sokisoki sainani kutu tikiriai.<verse eid="1TH 2:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="1TH 2:10"/>Tini sipa xati, Xoiteu rania sinie tini Kristusure xotikisukiriai xuiapu xosa kakikiriai kapia nu sipa. Sinie Xoiteu ekero asinaku asinaku kapia kakikiniaina sini xoxi kapia kakepu xuwe. <verse eid="1TH 2:10"/><verse number="11" style="v" sid="1TH 2:11"/>Tini<note caller="-" style="x"><char style="xo" closed="false">2.11 </char><char style="xt" closed="false"><ref loc="ACT 20:31">YT 20.31</ref></char></note> sipa, eminikie nupo nonomi xosa kakirouna kapia sieni, sinie tini xosa panumu kapia kakinuku, <verse eid="1TH 2:11"/><verse number="12" style="v" sid="1TH 2:12"/>tinipo nanunanu<note caller="-" style="x"><char style="xo" closed="false">2.12 </char><char style="xt" closed="false"><ref loc="PHP 1:27">Pl 1.27</ref>;<ref loc="COL 1:10">Kl 1.10</ref>;<ref loc="2TI 1:9">2 Ti 1.9</ref>;<ref loc="1PE 5:10">1 Pi 5.10</ref></char></note> sarinuku xotikikemu sokisokiwopure sinie kunaukiriai. Tini Xoiteupo kapiarei itouni texakuaire kakinuku kunaukiriai, tinie Xoiteue xuiapu yakunikirouna yause minika manari mena xouro asinaku misepini kutu takuaire nu Xoiteue tini yaitikeyai.<verse eid="1TH 2:12"/></para>
  <para style="s">Yesusure xonikisurouneri apimie xiri xonikisuneri sokisoki tumuneri xu xemeneri</para>
  <para style="p">
    <verse number="13" style="v" sid="1TH 2:13"/>Pa sapire rania sipesi<note caller="-" style="x"><char style="xo" closed="false">2.13 </char><char style="xt" closed="false"><ref loc="GAL 1:11-12">Ka 1.11-12</ref>; <ref loc="GAL 4:14">4.14</ref>;<ref loc="1TH 1:2-3">1 Ts 1.2-3</ref>;<ref loc="2TH 2:13">2 Ts 2.13</ref>;<ref loc="2PE 3:2">2 Pi 3.2</ref></char></note> sinie Xoiteu eiyaseurounuku. Tinie Xoiteupo kuna sinipo supusikiropu tikiriaia, tini apupo kuna sie tekixe. Xuwe. Tini Xoiteupo kunani kutu sie tikiniai. Kakari pa kuna paie tini Kristusu xosa xotikisukiriai xuiapu xotikiro sokisoki saina tina. <verse eid="1TH 2:13"/><verse number="14" style="v" sid="1TH 2:14"/>Yewapu xura<note caller="-" style="x"><char style="xo" closed="false">2.14 </char><char style="xt" closed="false"><ref loc="ACT 17:5">YT 17.5</ref>;<ref loc="HEB 10:33-34">Ip 10.33-34</ref></char></note>, tinie Xoiteupo Yesusure xonikisuwoteneai xuiapu, Yutia puroteneai sie saikiriai, nini Yesusu Kristusu xeika etoketeneai xuiapu. Tinie emetikimana nikau xupunikiro kokaipa xuni kutu tikiriai sieni, Yutiapu Xoiteupo xuiapue Yuta xupunikiropu xu teteneai. <verse eid="1TH 2:14"/><verse number="15" style="v" sid="1TH 2:15"/>Yuta apimie<note caller="-" style="x"><char style="xo" closed="false">2.15 </char><char style="xt" closed="false"><ref loc="ACT 2:23">YT 2.23</ref>; <ref loc="ACT 3:15">3.15</ref>; <ref loc="ACT 7:52">7.52</ref>; <ref loc="ACT 9:23">9.23</ref>; <ref loc="ACT 9:29">9.29</ref>; <ref loc="ACT 13:45">13.45</ref>; <ref loc="ACT 13:50">13.50</ref>; <ref loc="ACT 14:2">14.2</ref>; <ref loc="ACT 14:5">14.5</ref>; <ref loc="ACT 14:9">14.9</ref>; <ref loc="ACT 17:5">17.5</ref>; <ref loc="ACT 17:13">17.13</ref>; <ref loc="ACT 18:12">18.12</ref></char></note> Kokaipa Yesusu ouweineri kunatureture rania ounikieineri, sini xesasiketeneai. Xoiteue xouwewotai kapia nikiniki tuneri, xokupa apimi xiwaixiwainikineri. <verse eid="1TH 2:15"/><verse number="16" style="v" sid="1TH 2:16"/>Sinie<note caller="-" style="x"><char style="xo" closed="false">2.16 </char><char style="xt" closed="false"><ref loc="MAT 23:32-33">Mt 23.32-33</ref>; <ref loc="MAT 24:6">24.6</ref>;<ref loc="LUK 11:52">Lu 11.52</ref>;<ref loc="ACT 13:50">YT 13.50</ref></char></note> xetau xeteneai xuimiapimi xosa kuna uteiwopinuku paiya, ninie sinipo saina ime parauneri, pa amure, Xoiteue pa xuiapu xiyeri tinikepi nini xiraxineri. Pa xati ninie sipesi kakirouwori ninipo xunue pani kokaipa xati, Xoiteupo kisamairae nini xosa kotai purina.<verse eid="1TH 2:16"/></para>
  <para style="s">Polue Tesalonaika apimi xiyeri xekenikepure xiri xouweuna</para>
  <para style="p">
    <verse number="17" style="v" sid="1TH 2:17"/>Yewapu xura<note caller="-" style="x"><char style="xo" closed="false">2.17 </char><char style="xt" closed="false"><ref loc="1TH 3:10">1 Ts 3.10</ref></char></note>, Yuta apimie kakeri tini xayaka xayaka weitikiteri nanukiria, eminikie nupo nonomi weinikiteri xetauro purieuna. Sini tinipo moatikikemu xekeukiri xana xuwena pana, sinipo xosikikemu paiya tini xeikani purina. Pa xati tini xiyeri kounuku xeketikepure ime xirekepi saina pani sokisoki tinuku. <verse eid="1TH 2:17"/><verse number="18" style="v" sid="1TH 2:18"/>Sinie tini kounuku xeketikepure xikiriai, ye Polu, ye kopure xokupa yause eruruyai. Pana Satanie taiyerisiketai. <verse eid="1TH 2:18"/><verse number="19" style="v" sid="1TH 2:19"/>Sikou Kokaipa Yesusue xiyeri koati yause<note caller="-" style="x"><char style="xo" closed="false">2.19 </char><char style="xt" closed="false"><ref loc="PHP 2:15-16">Pl 2.15-16</ref>; <ref loc="PHP 4:1">4.1</ref>;<ref loc="2TH 1:4">2 Ts 1.4</ref></char></note> paiya, amu sapie sini sokisokisikati nu ekero tumunuku nimaririwopinukuna? Sini amu tikou atarunuku sinie sinipo saina ati tikiniai xepinukuna? Paiya tini kireni. <verse eid="1TH 2:19"/><verse number="20" style="v" sid="1TH 2:20"/>Iyo<note caller="-" style="x"><char style="xo" closed="false">2.20 </char><char style="xt" closed="false"><ref loc="2CO 1:14">2 Ko 1.14</ref>;<ref loc="1TH 3:13">1 Ts 3.13</ref>;<ref loc="REV 1:7">XKY 1.7</ref></char></note>, sini tinire nimaririroukiri, takieni kakari sini xosikikemu asinaku purinuku.<verse eid="1TH 2:20"/></para>
  <chapter eid="1TH 2"/>
  <chapter number="3" style="c" sid="1TH 3"/>
  <para style="s">Timotie xouna Tesalonaika sokisokinikepinaure Polue xesawotai</para>
  <para style="p">
    <verse number="1" style="v" sid="1TH 3:1"/>Sinie<note caller="-" style="x"><char style="xo" closed="false">3.1 </char><char style="xt" closed="false"><ref loc="ACT 17:15">YT 17.15</ref></char></note> tinire xiri eiyorinuku, xurise sini ere xenenewopuxexi nanukiriai. Pa xati kuna ouwori kunaunuku sio Atensi puraxauna, <verse eid="1TH 3:1"/><verse number="2" style="v" sid="1TH 3:2"/>Timoti <note caller="-" style="x"><char style="xo" closed="false">3.2 </char><char style="xt" closed="false"><ref loc="ACT 16:1-3">YT 16.1-3</ref></char></note>xesauyati tini xosa utopinaxi kuna oukiriai. Timoti nu sikou xatasikina nu Kristusupo asinaku kuna uteiwopina Xoiteupo saina apu. Nue tinipo xotikisu tianitikina sokisokiwopinaure xesauyati utotai, <verse eid="1TH 3:2"/><verse number="3" style="v" sid="1TH 3:3"/>pa<note caller="-" style="x"><char style="xo" closed="false">3.3 </char><char style="xt" closed="false"><ref loc="EPH 3:13">Ep 3.13</ref>;<ref loc="2TI 3:12">2 Ti 3.12</ref></char></note> xu xeika tatau xeika tini xemekiriaie kakatia tini kireue xokupa nanunanu taku. Takieni sipa, sinie muanumu xu xemeropure Xoiteue tumusikereyai. <verse eid="1TH 3:3"/><verse number="4" style="v" sid="1TH 3:4"/>Sini<note caller="-" style="x"><char style="xo" closed="false">3.4 </char><char style="xt" closed="false"><ref loc="ACT 14:22">YT 14.22</ref>; <ref loc="ACT 20:24">20.24</ref></char></note> tini xeika purikiriai yauseni ipaki katikinuku, xu xana xu siko xosa kopina xikiriai. Pa xati itou takieni sipaunuku, pa xu xoxi itou motai. <verse eid="1TH 3:4"/><verse number="5" style="v" sid="1TH 3:5"/>Pa xotapaure<note caller="-" style="x"><char style="xo" closed="false">3.5 </char><char style="xt" closed="false"><ref loc="PHP 2:16">Pl 2.16</ref></char></note> sore ye pani xenenewopu xuwe. Ye tinipo xotikisu sipawopure, pani Timoti xesauti tini xosa utotai. Tinipo xotikisu eruruwopina apue xakuxakutikiati, sinipo saina aini xuwexinaxi ye nanune.<verse eid="1TH 3:5"/></para>
  <para style="s">Timotie asinaku kuna tikoati, Polue nimaririwotai</para>
  <para style="p">
    <verse number="6" style="v" sid="1TH 3:6"/>Paina<note caller="-" style="x"><char style="xo" closed="false">3.6 </char><char style="xt" closed="false"><ref loc="ACT 18:5">YT 18.5</ref></char></note> Timotie tini weitikiterina mukatie sini xosa kouna putauna. Nue asinaku kunani kutu sini kasikina. Tinie sokisoki xotikisunuku kireu xiri xonikieurounukure kunawotai. Sipesi tinie sinire nanunanuku asinaku xotiki tuku xirounukure, nu kunauna. Kakinuku tinie sini xekesikepure eiyoxari sinie rania tini xeketikepure eiyoxinuku. <verse eid="1TH 3:6"/><verse number="7" style="v" sid="1TH 3:7"/>Yewapu xura<note caller="-" style="x"><char style="xo" closed="false">3.7 </char><char style="xt" closed="false"><ref loc="2TH 1:4">2 Ts 1.4</ref></char></note>, tinie xotikisuwopi sokisoki purari sinie iyeserinuku, paie xokupa xu xemekiriaia sinipo xosikikemu sokisokina. <verse eid="1TH 3:7"/><verse number="8" style="v" sid="1TH 3:8"/>Tinie<note caller="-" style="x"><char style="xo" closed="false">3.8 </char><char style="xt" closed="false"><ref loc="PHP 4:1">Pl 4.1</ref></char></note> Kokaipa xosa sokisoki purari sini sipaukiriai xati, ximine sinipo ekisikiomae xiri asinakuni kutu saina. <verse eid="1TH 3:8"/><verse number="9" style="v" sid="1TH 3:9"/>Sinie tinire nanunanuworinuku sikou Xoiteu ekero xiri nimaririnuku xekeukiria, sinie Xoiteu eiyasewopi kapia paiya nue sini sikeyai nimariri xiri itouwati xana xuwe. <verse eid="1TH 3:9"/><verse number="10" style="v" sid="1TH 3:10"/>Xoiteue<note caller="-" style="x"><char style="xo" closed="false">3.10 </char><char style="xt" closed="false"><ref loc="ACT 26:7">YT 26.7</ref>;<ref loc="ROM 1:10">Ro 1.10</ref>;<ref loc="COL 4:12">Kl 4.12</ref>;<ref loc="2TI 1:3">2 Ti 1.3</ref></char></note> sini weisikitati utunuku tini xeketikepinukure asau xeika ukumu xeika xosa sini kunikuniwoki kunikuniwokinuku. Pa xati tinipo xotikisu xayaxayaka xatia, sinie xemu sokisokiworitikepinuku.<verse eid="1TH 3:10"/></para>
  <para style="s">Xoiteue Polu nini xosa sou xowopinaure Xoiteu xosa kunikuniwotai</para>
  <para style="p">
    <verse number="11" style="v" sid="1TH 3:11"/>Sikou<note caller="-" style="x"><char style="xo" closed="false">3.11 </char><char style="xt" closed="false"><ref loc="2TH 2:16">2 Ts 2.16</ref></char></note> Emisiki Xoiteu xeika, Yesusu, sikou Kokaipa xeikae tini xosa sosikiutopinerire xosikieunuku. <verse eid="1TH 3:11"/><verse number="12" style="v" sid="1TH 3:12"/>Kokaipae<note caller="-" style="x"><char style="xo" closed="false">3.12 </char><char style="xt" closed="false"><ref loc="1TH 4:9-10">1 Ts 4.9-10</ref>; <ref loc="1TH 5:15">5.15</ref>;<ref loc="2PE 1:7">2 Pi 1.7</ref></char></note> tini xosa kireu xonikiewopi kapia xiri korepinaure sini xosikieunuku, kakatia tini kirenikirenie Xoiteupo xuiapu xosa xeika xokupa xuiapu xosa xeika xiri xotikikemu tinika, paiya sinie tini xosa xosikikemu tikirounuku sie kaka. <verse eid="1TH 3:12"/><verse number="13" style="v" sid="1TH 3:13"/>Pa<note caller="-" style="x"><char style="xo" closed="false">3.13 </char><char style="xt" closed="false"><ref loc="ZEC 14:5">Sek 14.5</ref>;<ref loc="1CO 1:8">1 Ko 1.8</ref>;<ref loc="PHP 1:10">Pl 1.10</ref>;<ref loc="2TH 1:7">2 Ts 1.7</ref>; <ref loc="2TH 1:10">1.10</ref>; <ref loc="2TH 2:17">2.17</ref></char></note> kakaria Kokaipa Yesusue nukou xokupa xuiapu xeika xiyeri kopina yause xosa paiya, tini muputiki xokumo purari xeketikepina. Tinie asinakuni kutu xu xuweu sikou Emisiki Xoiteu ekero purakuai. Pa suau.<verse eid="1TH 3:13"/></para>
  <chapter eid="1TH 3"/>
  <chapter number="4" style="c" sid="1TH 4"/>
  <para style="ms">Nini Tesalonaika ninipo asinaku kapia sokiteria ninipo ekinikoma sokisokixepina</para>
  <para style="mr">
    <ref loc="1TH 4-5">4—5</ref></para>
  <para style="d"/>
  <para style="s">Sini ayaka kapia kakepuxe</para>
  <para style="p">
    <verse number="1" style="v" sid="1TH 4:1"/>Yewapu xura<note caller="-" style="x"><char style="xo" closed="false">4.1 </char><char style="xt" closed="false"><ref loc="PHP 1:27">Pl 1.27</ref>;<ref loc="COL 1:10">Kl 1.10</ref>; <ref loc="COL 2:6">2.6</ref>;<ref loc="1TH 2:12">1 Ts 2.12</ref>;<ref loc="2TH 3:6">2 Ts 3.6</ref></char></note>, tinie Xoiteupo nanunanu tainari texakuaire sinie tini xokupa kapia ataritikikiri, tinie pa kapia tairounuku. Pana muaia tinipo xotikikemu xiri sokisokinuku Kokaipa Yesusu wenumurei mua kapia pani kakakuaire tini katikepure xinuku.<verse eid="1TH 4:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="1TH 4:2"/>Xokupa kuna Kokaipa Yesusupo wenumurei sinie tini tikikiriai tini sipa. <verse eid="1TH 4:2"/><verse number="3" style="v" sid="1TH 4:3"/>Xoiteupo xoukemu<note caller="-" style="x"><char style="xo" closed="false">4.3 </char><char style="xt" closed="false"><ref loc="1CO 6:15">1 Ko 6.15</ref>; <ref loc="1CO 6:18">6.18</ref>;<ref loc="EPH 5:3">Ep 5.3</ref>; <ref loc="EPH 5:17">5.17</ref>; <ref loc="EPH 5:27">5.27</ref>;<ref loc="COL 3:5">Kl 3.5</ref>;<ref loc="1TH 5:23">1 Ts 5.23</ref>;<ref loc="HEB 10:10">Ip 10.10</ref>;<ref loc="1PE 1:16">1 Pi 1.16</ref></char></note> paiya muanumu. Tinipo ekitikiomani kutu xiri tuworinari muputiki xokumo saya. Kakinari xokupa ayaka kapia emeseruwa. <verse eid="1TH 4:3"/><verse number="4" style="v" sid="1TH 4:4"/>Tini<note caller="-" style="x"><char style="xo" closed="false">4.4 </char><char style="xt" closed="false"><ref loc="ROM 6:19">Ro 6.19</ref>;<ref loc="1CO 6:13-15">1 Ko 6.13-15</ref>; <ref loc="1CO 6:18">6.18</ref></char></note> kirenikirenie xotikiropu xoxixoxi kapiapu nanunanu kourouna atinari yakuwakuai, kakinari Xoiteue xouwewotai kapia xeika asinaku kapia xeika taiwakuai. <verse eid="1TH 4:4"/><verse number="5" style="v" sid="1TH 4:5"/>Pa<note caller="-" style="x"><char style="xo" closed="false">4.5 </char><char style="xt" closed="false"><ref loc="PSA 79:6">Siri 79.6</ref>;<ref loc="GAL 4:8">Ka 4.8</ref>;<ref loc="EPH 2:12">Ep 2.12</ref>; <ref loc="EPH 4:17-18">4.17-18</ref>;<ref loc="2TH 1:8">2 Ts 1.8</ref></char></note> xotikiropu xoxixoxi kapiapu nanunanue purutikati, xukumie Xoiteu sipawopu xuweue xoxixoxi ayaka kapia kakirouneri sie kakaku. <verse eid="1TH 4:5"/><verse number="6" style="v" sid="1TH 4:6"/>Tini<note caller="-" style="x"><char style="xo" closed="false">4.6 </char><char style="xt" closed="false"><ref loc="LEV 19:11-13">XS 19.11-13</ref>;<ref loc="PSA 94:1">Siri 94.1</ref>;<ref loc="1CO 6:8">1 Ko 6.8</ref>;<ref loc="2TH 1:8">2 Ts 1.8</ref></char></note> kakixanari Yesusure xonikisurouneri xatatikimana xosa xu kakerinari, pa xoxi kapia kakinari ekinikiworaku. Muanumu kuna ekime sinie tini sokisoki katikinuku, muanumu kapia xokupa apimie kaketeneai paiya, Kokaipae nini xaro tinikepuwatixe, xikiriai. <verse eid="1TH 4:6"/><verse number="7" style="v" sid="1TH 4:7"/>Sini<note caller="-" style="x"><char style="xo" closed="false">4.7 </char><char style="xt" closed="false"><ref loc="1CO 1:2">1 Ko 1.2</ref>;<ref loc="2TH 2:13-14">2 Ts 2.13-14</ref>;<ref loc="HEB 12:14">Ip 12.14</ref>;<ref loc="1PE 1:14-16">1 Pi 1.14-16</ref></char></note> xoxi kapia kakepure Xoiteue yaisikepu xuwe. Xuweni kutu. Xoiteue sini xokumo kapia taiwopure yaisikina. <verse eid="1TH 4:7"/><verse number="8" style="v" sid="1TH 4:8"/>Pa xati<note caller="-" style="x"><char style="xo" closed="false">4.8 </char><char style="xt" closed="false"><ref loc="EZK 36:27">Ese 36.27</ref>; <ref loc="EZK 37:14">37.14</ref>;<ref loc="LUK 10:16">Lu 10.16</ref>;<ref loc="1CO 2:10">1 Ko 2.10</ref>;<ref loc="2CO 1:22">2 Ko 1.22</ref>;<ref loc="1JN 3:24">1 Yo 3.24</ref></char></note> apue mua kuna supo wana paiya nu apupo kuna kireni supo woratixe. Xuwe. Nu Xoiteupo kuna supo wana, nu nukou Supo Youya tini tikirouna Xoiteu.<verse eid="1TH 4:8"/></para>
  <para style="s">Sini asinaku kapia kakikiri sokisoki xepina</para>
  <para style="p">
    <verse number="9" style="v" sid="1TH 4:9"/>Tinipo xotikikemu Xoiteupo xuiapu tinikepi kapiaure yei tini xosa kireu kuna xayawopixe, pa amure, pa kapiaure Xoiteue tini taitaitikietai. <verse eid="1TH 4:9"/><verse number="10" style="v" sid="1TH 4:10"/>Kakati<note caller="-" style="x"><char style="xo" closed="false">4.10 </char><char style="xt" closed="false"><ref loc="2TH 3:4">2 Ts 3.4</ref></char></note> Yesusure xonikisuwoteneai xuiapue Mesetonia propinsipo xokupa sanawayau puroteneai tinipo xotikikemu tinikirounuku. Pana yewapu xura, tinie pa kapia pani pani kakakuaire, tinipo xotikikemu sokisokiwopure xinuku. <verse eid="1TH 4:10"/><verse number="11" style="v" sid="1TH 4:11"/>Tini<note caller="-" style="x"><char style="xo" closed="false">4.11 </char><char style="xt" closed="false"><ref loc="EPH 4:28">Ep 4.28</ref>;<ref loc="2TH 3:8">2 Ts 3.8</ref>; <ref loc="2TH 3:12">3.12</ref>;<ref loc="1PE 4:15">1 Pi 4.15</ref></char></note> peuni misepi kapia sokisoki xinari takipo sainani ta. Sinie ekime tini katikikiniai sie tini takipo xuputikieni sokisoki saina tinari paiya, tini takieni sokisoki tumuwakuai. <verse eid="1TH 4:11"/><verse number="12" style="v" sid="1TH 4:12"/>Kakinaria<note caller="-" style="x"><char style="xo" closed="false">4.12 </char><char style="xt" closed="false"><ref loc="ROM 13:13">Ro 13.13</ref>;<ref loc="2CO 8:21">2 Ko 8.21</ref>;<ref loc="COL 4:5">Kl 4.5</ref></char></note> tini kire sapi xuweitautikepuwatixe, kakaria Yesusure xonikisuwopu xuweuwoteneai xuiapue, tinipo kapiaure nimaririwopineri.<verse eid="1TH 4:12"/></para>
  <para style="s">Kokaipae xiyeri kouna kununusikepina</para>
  <para style="p">
    <verse number="13" style="v" sid="1TH 4:13"/>Yewapu xura<note caller="-" style="x"><char style="xo" closed="false">4.13 </char><char style="xt" closed="false"><ref loc="EPH 2:12">Ep 2.12</ref></char></note>, xumuweteneai xuimiapimi xosa amuwaurau putawopina paiya, tini atinari sipawakuaire xinuku. Yesusure xonikisuwopu xuweuwoteneai xuiapu kinie xumoteneai xuiapue xiri eiyoxirouneri. Kakineri Xoiteue kopa upuropu sainikerepina yause yakuworixe. Pa xati, sini ninie eiyoxenteneai sie kakepuxe. Sini Xoiteue kopa upuropu saisikeperina yause yakuwopu. <verse eid="1TH 4:13"/><verse number="14" style="v" sid="1TH 4:14"/>Yesusue<note caller="-" style="x"><char style="xo" closed="false">4.14 </char><char style="xt" closed="false"><ref loc="ROM 14:9">Ro 14.9</ref>;<ref loc="1CO 15:3-4">1 Ko 15.3-4</ref>; <ref loc="1CO 15:12-13">15.12-13</ref>; <ref loc="1CO 15:18">15.18</ref>; <ref loc="1CO 15:23">15.23</ref></char></note> xumuna xiyeri sarotaire sini xosikisunuku. Pa xati sini sipa,Yesusupo sokisokie Xoiteue Yesusure xonikisuwoteneai xuimiapimi xumuweteneai xiyeri sainikeratia ninie Yesusu xeika xiyeri kopineri.<verse eid="1TH 4:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="1TH 4:15"/>Sinie<note caller="-" style="x"><char style="xo" closed="false">4.15-17 </char><char style="xt" closed="false"><ref loc="1CO 15:51-52">1 Ko 15.51-52</ref></char></note> Kokaipapu kuna tini xosa ipaki uteinuku. Kokaipae xiyeri kopina yause paiya, sini ekisikioma tuku xuiapue pani purikiria, xumuweteneai xuiapue purori sinixite akeri xowopuxe. Xuwe. <verse eid="1TH 4:15"/><verse number="16" style="v" sid="1TH 4:16"/>Xoiteue<note caller="-" style="x"><char style="xo" closed="false">4.16 </char><char style="xt" closed="false"><ref loc="MAT 24:30-31">Mt 24.30-31</ref>;<ref loc="ACT 1:11">YT 1.11</ref>;<ref loc="1CO 15:23">1 Ko 15.23</ref>; <ref loc="1CO 15:52">15.52</ref>;<ref loc="1TH 1:10">1 Ts 1.10</ref>;<ref loc="2TH 1:7">2 Ts 1.7</ref></char></note> sokisoki kunawati, akereki xenikorokoroe uru yaxatia, Xoiteupo narie miriaxepina. Kakatia Kokaipae Xoiteupo xaixai wese wetina oro kopina. Kakatia Yesusure xonikisuneri xumuweteneai apimie akerineri saropineri. <verse eid="1TH 4:16"/><verse number="17" style="v" sid="1TH 4:17"/>Pa yause xosa<note caller="-" style="x"><char style="xo" closed="false">4.17 </char><char style="xt" closed="false"><ref loc="JHN 12:26">Yo 12.26</ref>;<ref loc="ACT 1:9">YT 1.9</ref>;<ref loc="REV 11:12">XKY 11.12</ref></char></note> sini pani ekisikioma purikiriai xuiapue mena xouro pa xuimi apimi xeika xounukua, siko xokupae Kokaipa tutumawopu. Kakinuku paiya sini Kokaipa xeika sipesi sipesi puropu. <verse eid="1TH 4:17"/><verse number="18" style="v" sid="1TH 4:18"/>Pa xati Xoiteupo kireu xuiapu nikau xonikikemu sokisokiwopure tinie mua kuna takitaki xotikikemu sokisokiwata xakuai.<verse eid="1TH 4:18"/></para>
  <chapter eid="1TH 4"/>
  <chapter number="5" style="c" sid="1TH 5"/>
  <para style="s">Sini kokaipa kopina yauseure ireiwopu</para>
  <para style="p">
    <verse number="1" style="v" sid="1TH 5:1"/>Yewapu xura<note caller="-" style="x"><char style="xo" closed="false">5.1 </char><char style="xt" closed="false"><ref loc="MAT 24:36">Mt 24.36</ref></char></note>, sinie katikinuku panumu asau xosa panumu yause xosa pa sapi akipa xepinaxinuku kuna xayaunuku katikepukirixe. <verse eid="1TH 5:1"/><verse number="2" style="v" sid="1TH 5:2"/>Takieni<note caller="-" style="x"><char style="xo" closed="false">5.2 </char><char style="xt" closed="false"><ref loc="MAT 24:42-44">Mt 24.42-44</ref>;<ref loc="LUK 12:39">Lu 12.39</ref>;<ref loc="2PE 3:10">2 Pi 3.10</ref>;<ref loc="REV 3:3">XKY 3.3</ref></char></note> sipauweikiriai, Kokaipa kopina asau paiya petuae ukumani marouna sie sapauni kopina. <verse eid="1TH 5:2"/><verse number="3" style="v" sid="1TH 5:3"/>Xuiapue<note caller="-" style="x"><char style="xo" closed="false">5.3 </char><char style="xt" closed="false"><ref loc="EZK 13:10">Ese 13.10</ref>;<ref loc="HOS 13:13">Os 13.13</ref>;<ref loc="MAT 24:39">Mt 24.39</ref>;<ref loc="LUK 21:34-35">Lu 21.34-35</ref>;<ref loc="JHN 16:21-22">Yo 16.21-22</ref></char></note> ipaki kunauneri, “Ximine asinaku yauseni kutu. Xosikikemu yoroni puropu,” xeria, xuie nono iyarepure xeri tatau marouna sie nini xoxi nikepina sapie sapauni nini xosa mopina. Ninie pa sapi emeseriwopuworixana xuwe. <verse eid="1TH 5:3"/><verse number="4" style="v" sid="1TH 5:4"/>Pana<note caller="-" style="x"><char style="xo" closed="false">5.4 </char><char style="xt" closed="false"><ref loc="ROM 13:12-13">Ro 13.12-13</ref>;<ref loc="1JN 2:8">1 Yo 2.8</ref></char></note> tini yewapu xura tini ukumu xosa purinuku xati, petuae moati apue xekeri urewotai sie tinie pa asau moati xekeri xoxi ure urewakuaixe. Xuwe. <verse eid="1TH 5:4"/><verse number="5" style="v" sid="1TH 5:5"/>Tini<note caller="-" style="x"><char style="xo" closed="false">5.5 </char><char style="xt" closed="false"><ref loc="ROM 13:12">Ro 13.12</ref>;<ref loc="EPH 5:8-9">Ep 5.8-9</ref></char></note> xokupa paiya tini memeremu xeika asau xeika xosaupo apimi. Sini ukumu xeika xori xeikapu kini xuwe. <verse eid="1TH 5:5"/><verse number="6" style="v" sid="1TH 5:6"/>Pa xati<note caller="-" style="x"><char style="xo" closed="false">5.6 </char><char style="xt" closed="false"><ref loc="MAT 24:42">Mt 24.42</ref>; <ref loc="MAT 25:5">25.5</ref>; <ref loc="MAT 25:13">25.13</ref>;<ref loc="1PE 5:8">1 Pi 5.8</ref></char></note> kireu apimi sie sini xinexekini. Xeuxana ekisikie pereu purati, nanusikie teteiwopina. <verse eid="1TH 5:6"/><verse number="7" style="v" sid="1TH 5:7"/>Sini<note caller="-" style="x"><char style="xo" closed="false">5.7 </char><char style="xt" closed="false"><ref loc="LUK 21:34-36">Lu 21.34-36</ref>;<ref loc="ROM 13:13">Ro 13.13</ref>;<ref loc="EPH 5:14">Ep 5.14</ref></char></note> sipa, xinepineri apimi paiya, nini ukumani xinirouneri. Xisa xukoriwopineri apimi paiya, nini ukumani xisa xukorineri puturouneri. <verse eid="1TH 5:7"/><verse number="8" style="v" sid="1TH 5:8"/>Pana<note caller="-" style="x"><char style="xo" closed="false">5.8 </char><char style="xt" closed="false"><ref loc="ISA 59:17">Ais 59.17</ref>;<ref loc="EPH 6:13-17">Ep 6.13-17</ref></char></note> sini asaupo kinia, sini atinuku nanunanu tepu. Sini Xoiteure xosikisunuku, kireu xiri xonikiewopi kapia tinuku, pa kapiae xomatua nikau nekei sie erepu. Kakinuku Xoiteu yakukiri xiyeri sosikepina kapia paiya, xomatua nikau koike sie kurorinuku, sini sokisoki tumunuku ati yakuwopu. <verse eid="1TH 5:8"/><verse number="9" style="v" sid="1TH 5:9"/>Sini<note caller="-" style="x"><char style="xo" closed="false">5.9 </char><char style="xt" closed="false"><ref loc="ROM 9:22">Ro 9.22</ref>;<ref loc="1TH 1:10">1 Ts 1.10</ref>;<ref loc="2TH 2:13-14">2 Ts 2.13-14</ref>;<ref loc="1PE 2:8">1 Pi 2.8</ref></char></note> Xoiteu nukou kisamaira tepure sini tumusikerepu xuwe. Sikou Kokaipa Yesusu Kristusue xiyeri sosikepinaure nue sini tumusikeretai. <verse eid="1TH 5:9"/><verse number="10" style="v" sid="1TH 5:10"/>Yesusue<note caller="-" style="x"><char style="xo" closed="false">5.10 </char><char style="xt" closed="false"><ref loc="ROM 14:8-9">Ro 14.8-9</ref>;<ref loc="2CO 5:15">2 Ko 5.15</ref>;<ref loc="1TH 4:14">1 Ts 4.14</ref></char></note> sini tianisikepure xumotai, pa xati sini ekisikioma purinukure e sini xumunukua, sini nu xeika ekisikioma puropu. <verse eid="1TH 5:10"/><verse number="11" style="v" sid="1TH 5:11"/>Pa xati<note caller="-" style="x"><char style="xo" closed="false">5.11 </char><char style="xt" closed="false"><ref loc="JUD 1:20">Yu 20</ref></char></note> tini mua kakirounuku sie, tini kirenikirenie takitaki xotikikemu sokisokiwata akuai.<verse eid="1TH 5:11"/></para>
  <para style="s">Tini Yesusure xotikisurounuku xuiapue takitaki tianuwata aukuai</para>
  <para style="p">
    <verse number="12" style="v" sid="1TH 5:12"/>Yewapu xura<note caller="-" style="x"><char style="xo" closed="false">5.12 </char><char style="xt" closed="false"><ref loc="1CO 16:18">1 Ko 16.18</ref>;<ref loc="PHP 2:29">Pl 2.29</ref>;<ref loc="1TI 5:17">1 Ti 5.17</ref>;<ref loc="HEB 13:7">Ip 13.7</ref>; <ref loc="HEB 13:17">13.17</ref></char></note>, sinie tini ipaki katikepure xinuku, apimie tini tianitikepi saina teteneai irue pura. Kokaipae nini tinipo tumu iyainikerati purineri, tinipo kapia kutuwopure ninie tini kuna tikirouneri. <verse eid="1TH 5:12"/><verse number="13" style="v" sid="1TH 5:13"/>Ninie pa saina tirounerire, tinie nanunanunari xotikikemu xiri asinaku xinari xiri xotikienika. Kakinari tini xokupae kireni xotikie pura.<verse eid="1TH 5:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="1TH 5:14"/>Yewapu xura<note caller="-" style="x"><char style="xo" closed="false">5.14 </char><char style="xt" closed="false"><ref loc="GAL 5:22">Ka 5.22</ref>; <ref loc="GAL 6:1-2">6.1-2</ref>;<ref loc="COL 3:12">Kl 3.12</ref>;<ref loc="2TH 3:6">2 Ts 3.6</ref>; <ref loc="2TH 3:11">3.11</ref>; <ref loc="2TH 3:15">3.15</ref>;<ref loc="HEB 12:12">Ip 12.12</ref></char></note>, ouyeouye xirouneri apimi nikau kapia kutunari ximikirouneri apimi nikau xonikikemu sokisokinari sokisokixepu xuweu woteneai apimi tianikinariwakuaire tini saitikerepure xinuku. Kakinari tinie xokupa apimi peuni peuni nika.<verse eid="1TH 5:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="1TH 5:15"/>Ninie<note caller="-" style="x"><char style="xo" closed="false">5.15 </char><char style="xt" closed="false"><ref loc="PRO 20:22">Asin 20.22</ref>;<ref loc="MAT 5:39">Mt 5.39</ref>;<ref loc="ROM 12:17">Ro 12.17</ref>;<ref loc="1CO 6:7">1 Ko 6.7</ref>;<ref loc="1PE 3:9">1 Pi 3.9</ref></char></note> tini xosa xoxixoxi kapia kakeria, tinie kaki xanari xapa taku. Xokupa yause tinie Xoiteupo xokupa xuiapu xeika kireu xuiapu xeika xosa asinaku kapiani kakepure sokisokixa.<verse eid="1TH 5:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="1TH 5:16"/>Xokupa yause<note caller="-" style="x"><char style="xo" closed="false">5.16 </char><char style="xt" closed="false"><ref loc="2CO 6:10">2 Ko 6.10</ref>;<ref loc="PHP 4:4">Pl 4.4</ref></char></note> tinie xiri nimaririnari, <verse eid="1TH 5:16"/><verse number="17" style="v" sid="1TH 5:17"/>sipesi<note caller="-" style="x"><char style="xo" closed="false">5.17 </char><char style="xt" closed="false"><ref loc="LUK 18:1">Lu 18.1</ref>;<ref loc="EPH 6:18">Ep 6.18</ref>;<ref loc="COL 4:2">Kl 4.2</ref>;<ref loc="1PE 4:7">1 Pi 4.7</ref></char></note> kunikuniwakuai. <verse eid="1TH 5:17"/><verse number="18" style="v" sid="1TH 5:18"/>Tini<note caller="-" style="x"><char style="xo" closed="false">5.18 </char><char style="xt" closed="false"><ref loc="EPH 5:20">Ep 5.20</ref>;<ref loc="COL 3:17">Kl 3.17</ref></char></note> xuiapu Kristusu Yesusu xeika etokikiriaie panumu kapia tini xosa yaraxatia tini Xoiteu eiyasewakuai. Xoiteu nu panumu kapia xouweuna.<verse eid="1TH 5:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="1TH 5:19"/>Tinie kire sapi kakakuaire Xoiteupo Supo Youyae saitikerepure xatia<note caller="-" style="x"><char style="xo" closed="false">5.19 </char><char style="xt" closed="false"><ref loc="EPH 4:30">Ep 4.30</ref>;<ref loc="1TI 4:14">1 Ti 4.14</ref>;<ref loc="2TI 1:6">2 Ti 1.6</ref></char></note>, tini kakixinari nu paraunari, <verse eid="1TH 5:19"/><verse number="20" style="v" sid="1TH 5:20"/>apimie tini<note caller="-" style="x"><char style="xo" closed="false">5.20 </char><char style="xt" closed="false"><ref loc="1CO 14:1">1 Ko 14.1</ref>; <ref loc="1CO 14:39">14.39</ref></char></note> xosa kunatureture kuna uteiwopure xeria kakixanari pa kunaure xotikikemu xoxixoxixaku. <verse eid="1TH 5:20"/><verse number="21" style="v" sid="1TH 5:21"/>Pana<note caller="-" style="x"><char style="xo" closed="false">5.21 </char><char style="xt" closed="false"><ref loc="1CO 2:11">1 Ko 2.11</ref>; <ref loc="1CO 2:15">2.15</ref>;<ref loc="PHP 4:8">Pl 4.8</ref>;<ref loc="1JN 4:1">1 Yo 4.1</ref></char></note> xokupa kuna xeika kapia xeika ati erurunari uteiwakuai. Kakinari asinaku kapia kireni sokisoki tinari, <verse eid="1TH 5:21"/><verse number="22" style="v" sid="1TH 5:22"/>xokupa<note caller="-" style="x"><char style="xo" closed="false">5.22 </char><char style="xt" closed="false"><ref loc="JOB 1:1">Yop 1.1</ref>; <ref loc="JOB 1:8">1.8</ref>; <ref loc="JOB 2:3">2.3</ref></char></note> xoxi kapia emeseriwa.<verse eid="1TH 5:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="1TH 5:23"/>Xoiteu<note caller="-" style="x"><char style="xo" closed="false">5.23 </char><char style="xt" closed="false"><ref loc="ROM 15:33">Ro 15.33</ref>;<ref loc="1CO 1:8">1 Ko 1.8</ref>;<ref loc="PHP 4:9">Pl 4.9</ref>;<ref loc="1TH 3:13">1 Ts 3.13</ref>;<ref loc="2TH 3:16">2 Ts 3.16</ref></char></note> nu xoukemu yorowopi xotapa, nue kakati tinie tinipo ekitikioma xiri tuwaria tini xiri xokumo saitikerepina. Kakina tinipo xenitiki xeika muputiki xeika nanunanu xeika ati yakuwati, tini xiri asinaku purinaria sikou Kokaipa Yesusu Kristusue xiyeri kopina yause xosa tinipo xu xuwexepina. <verse eid="1TH 5:23"/><verse number="24" style="v" sid="1TH 5:24"/>Xoiteue<note caller="-" style="x"><char style="xo" closed="false">5.24 </char><char style="xt" closed="false"><ref loc="1CO 1:9">1 Ko 1.9</ref>; <ref loc="1CO 10:13">10.13</ref>;<ref loc="2TH 3:3">2 Ts 3.3</ref></char></note> tini yaitikeyaina, nue pa xokupa sapi tini xosa kakepina, pa amure, nukoe xokupa kuna kunawoyaini kutu tairouna.<verse eid="1TH 5:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="1TH 5:25"/>Yewapu xura<note caller="-" style="x"><char style="xo" closed="false">5.25 </char><char style="xt" closed="false"><ref loc="COL 4:3">Kl 4.3</ref>;<ref loc="2TH 3:1">2 Ts 3.1</ref></char></note>, tinie Xoiteu kunikuniwarini kutu sini tianisikepina.<verse eid="1TH 5:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="1TH 5:26"/>Siko Xoiteupo xuiapu sikau kapia paiya<note caller="-" style="x"><char style="xo" closed="false">5.26 </char><char style="xt" closed="false"><ref loc="ROM 16:16">Ro 16.16</ref></char></note>, tini kirenikirenie kireu uritoko nikakuai.<verse eid="1TH 5:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="1TH 5:27"/>Kokaipapu wenumurei ye tini xosa sokisoki kunaune, mua nakau tinie Xoiteupo xokupa xuiapu xosanikini kutu xosa ninaxakuai.<verse eid="1TH 5:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="1TH 5:28"/>Sikou Kokaipa Yesusu Kristusue xousuaxina xouwesiketai kapia tini xosa purina.<verse eid="1TH 5:28"/></para>
  <chapter eid="1TH 5"/>
</usx>
