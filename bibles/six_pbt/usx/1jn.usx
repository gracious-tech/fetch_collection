<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="1JN" style="id">- BLANK based on TPB 99</book>
  <para style="ide"/>
  <para style="rem"/>
  <para style="rem"/>
  <para style="h"/>
  <para style="toc3">1 Yo</para>
  <para style="toc2">1 Yo</para>
  <para style="toc1">1 Yoni</para>
  <para style="mt2">Xoka Kireni Nakau</para>
  <para style="mt">Yonie Xayawotai</para>
  <para style="imt">Akereki kuna</para>
  <para style="ip">Mua nakau paiya aimore nanunanu xotapa tuku. Yesusu taiwoteneai xuiapu xeika Emisiki Xoiteu xeika nukou nirau Yesusu Kristusu xeikae, tianikati kirenini xonikikemu tumaxi puropinerire xetai. Ukumu xosaupo apimi weinikiteri ninie xoreinikineri nini purunikeri Xoiteu wetepi nu xiraxina.</para>
  <para style="ip">Nini pa “ukumu xosaupo kinie” ipaki kunaurouneri, mua ouro puroteneai sapi paiya, asinakuni kutu xana xuwe xirouneri. Yesusu nu Xoiteupo Nono, pa xati nu siko xuiapue kakirounuku sie nu apuni kutu saina ouropu sapi xeika etokepuwatixe. Ninie kunauneri, apue Xoiteu xeika ati puropurexina paiya, nu ouropu sapi teure nanunanuwopuwatixe. Asinaku kutu kapia xeika kireu xosikienikepi kapia xeika, pa rania nini ouropu sapi. Pa xati tinie panumu kapia taiwopure eiyoxaku.</para>
  <para style="ip">Yesusu taiwoteneai apimie panumu kuna xosa xakuniki iyarepia nu xiraxina. Nue kunauna, Yesusue apuni kutu sayeyai xati, Yesusure xonikisuwoteneai xuiapu paiya nini Xoiteu xiri xonikieuneri kireu xuiapu xiri xonikiewopineri.</para>
  <chapter number="1" style="c" sid="1JN 1"/>
  <para style="ms">Sini memeremu xosa texepuna ukumu xosaupo apimi kini weinikitikiri xoreisikexeni</para>
  <para style="mr">
    <ref loc="1JN 1:1-3:10">1.1—3.10</ref></para>
  <para style="s">Ekeoma tuku kunae yarani putawoyai</para>
  <para style="p">
    <verse number="1" style="v" sid="1JN 1:1"/>Sinie<note caller="-" style="x"><char style="xo" closed="false">1.1 </char><char style="xt" closed="false"><ref loc="JHN 1:1-4">Yo 1.1-4</ref>; <ref loc="JHN 1:14">1.14</ref>; <ref loc="JHN 20:27">20.27</ref>;<ref loc="2PE 1:16">2 Pi 1.16</ref>;<ref loc="1JN 2:13-14">1 Yo 2.13-14</ref></char></note> kuna ekeoma tukupo kuna uteirounuku. Mua kuna paiya ekimeni kutu puroyai xati, sinie iyeserinuku, ekisikie xekeukiriai. Sinie nu xekerinuku nu xosa xupusiki iyarikiriai. <verse eid="1JN 1:1"/><verse number="2" style="v" sid="1JN 1:2"/>Mua<note caller="-" style="x"><char style="xo" closed="false">1.2 </char><char style="xt" closed="false"><ref loc="JHN 1:14">Yo 1.14</ref>; <ref loc="JHN 21:24">21.24</ref>;<ref loc="ACT 2:32">YT 2.32</ref>;<ref loc="ROM 16:26">Ro 16.26</ref></char></note> ekisikiomae yarani putauwoyai xati, sinie xekerinuku, paire kuna uteirounuku. Pa ekisikomae atina sipesi sipesi purotaire sinie tini xosa kunaunuku. Ekime nue nupo Omo xeika puroyaie yarani putawati ekeukiriai. <verse eid="1JN 1:2"/><verse number="3" style="v" sid="1JN 1:3"/>Sinie<note caller="-" style="x"><char style="xo" closed="false">1.3 </char><char style="xt" closed="false"><ref loc="JHN 17:21">Yo 17.21</ref>;<ref loc="ACT 4:20">YT 4.20</ref>;<ref loc="1CO 1:9">1 Ko 1.9</ref>;<ref loc="1JN 2:24">1 Yo 2.24</ref></char></note> xekeri iyesikiriai xati, tinie sini xeika xosikikemu tumaxi puropure tini xosa rania, kuna uteirounuku. Pa xati nupo Omo xeika, Nukou Nirau Yesusu Kristusu xeika kirenini xosikikemu tumaxi purinuku. <verse eid="1JN 1:3"/><verse number="4" style="v" sid="1JN 1:4"/>Sikou<note caller="-" style="x"><char style="xo" closed="false">1.4 </char><char style="xt" closed="false"><ref loc="JHN 15:11">Yo 15.11</ref>; <ref loc="JHN 16:24">16.24</ref>;<ref loc="2JN 1:12">2 Yo 12</ref></char></note> nimariri xiri xokopexepinaure sinie mua nakau xayaukiriai.<verse eid="1JN 1:4"/></para>
  <para style="s">Sini memeremu xosauni kutu texepu</para>
  <para style="p">
    <verse number="5" style="v" sid="1JN 1:5"/>Yesusu Kristusue kuna uteiwati iyeserinuku<note caller="-" style="x"><char style="xo" closed="false">1.5 </char><char style="xt" closed="false"><ref loc="JHN 1:9">Yo 1.9</ref>; <ref loc="JHN 9:5">9.5</ref>; <ref loc="JHN 12:35-36">12.35-36</ref>;<ref loc="1TI 6:16">1 Ti 6.16</ref>;<ref loc="JAS 1:17">Ye 1.17</ref>;<ref loc="1JN 3:11">1 Yo 3.11</ref></char></note>, sinie tini xosa uteinuku. Pa kuna muanumu, Xoiteu nu memeremu xati, xayakaxayaka kire ukumu nu xosa puratixe. <verse eid="1JN 1:5"/><verse number="6" style="v" sid="1JN 1:6"/>Sini<note caller="-" style="x"><char style="xo" closed="false">1.6 </char><char style="xt" closed="false"><ref loc="2CO 6:14">2 Ko 6.14</ref>;<ref loc="1JN 2:4">1 Yo 2.4</ref></char></note> kunaunuku, “Ye nu xeika kirenini xoikemu tumaxine,” xepinena pana sini ukumu xosa texinukua, sinipo mua kuna paiya xorei kuna xati, sini suau kapiarei texikirixe. <verse eid="1JN 1:6"/><verse number="7" style="v" sid="1JN 1:7"/>Pana<note caller="-" style="x"><char style="xo" closed="false">1.7 </char><char style="xt" closed="false"><ref loc="ISA 2:5">Ais 2.5</ref>;<ref loc="JHN 3:21">Yo 3.21</ref>;<ref loc="EPH 1:7">Ep 1.7</ref>;<ref loc="HEB 9:14">Ip 9.14</ref>;<ref loc="1PE 1:19">1 Pi 1.19</ref>;<ref loc="REV 1:5">XKY 1.5</ref>; <ref loc="REV 7:14">7.14</ref></char></note> nuko memeremu xosa purotai sieni, sini memeremu xosa texinukua, sini Xoiteupo kireu xuiapu xeika xosikikemu kirenini tumaxi purinuku. Pa xati Xoiteupo Nono, nu Yesusu, nupo yawie sikou xokupa xunu xesauwati xosei sairounuku.<verse eid="1JN 1:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="1JN 1:8"/>Sini<note caller="-" style="x"><char style="xo" closed="false">1.8 </char><char style="xt" closed="false"><ref loc="JOB 9:2">Yop 9.2</ref>;<ref loc="PSA 32:5">Siri 32.5</ref>;<ref loc="PRO 28:13">Asin 28.13</ref>;<ref loc="JAS 3:2">Ye 3.2</ref>;<ref loc="1JN 2:4">1 Yo 2.4</ref></char></note> kunaunuku, “Ye xunu xuwe,” xirounukuna pana sini sikou xosikikemu xoreunuku xati, suau kuna xosikiro puratixe. <verse eid="1JN 1:8"/><verse number="9" style="v" sid="1JN 1:9"/>Pana<note caller="-" style="x"><char style="xo" closed="false">1.9 </char><char style="xt" closed="false"><ref loc="PSA 51:2">Siri 51.2</ref>;<ref loc="PRO 28:13">Asin 28.13</ref>;<ref loc="1JN 1:7">1 Yo 1.7</ref></char></note> sini sikou xunure kunauweikiria Xoiteu nukoe kunawoyai sie panumu kakepina. Nue asinaku kutu kapia kakinapa sikou xunu wetepina. Kakina xokupa kapia xoxi siko xosa purotai xesauwatia xosei puropu. <verse eid="1JN 1:9"/><verse number="10" style="v" sid="1JN 1:10"/>Sini<note caller="-" style="x"><char style="xo" closed="false">1.10 </char><char style="xt" closed="false"><ref loc="1JN 1:8">1 Yo 1.8</ref></char></note> kunaunuku, “ye xunu eriyaixe,” xepuna pana pa kuna paie kunaunuku Xoiteu nu xoreitua xinuku<note caller="-" style="x"><char style="xo" closed="false">1.10 </char><char style="xt" closed="false"><ref loc="PSA 14:3">Siri 14.3</ref>;<ref loc="ISA 53:6">Ais 53.6</ref>; <ref loc="ISA 64:6">64.6</ref></char></note>. Pa xati Xoiteupo kuna xosikiro puratixana xuwe.<verse eid="1JN 1:10"/></para>
  <chapter eid="1JN 1"/>
  <chapter number="2" style="c" sid="1JN 2"/>
  <para style="s">Kristusu nu sikou tianisikepi</para>
  <para style="p">
    <verse number="1" style="v" sid="1JN 2:1"/>Tini<note caller="-" style="x"><char style="xo" closed="false">2.1 </char><char style="xt" closed="false"><ref loc="ROM 8:34">Ro 8.34</ref>;<ref loc="1TI 2:5">1 Ti 2.5</ref>;<ref loc="HEB 7:25">Ip 7.25</ref>; <ref loc="HEB 9:24">9.24</ref></char></note> yeu nono misiarara xura, tini xunu erepu xuweuwakuaire, mua kuna tini xosa xayaune. Kire apue xunu eratia, sini sikou tianisikepi tuku, nu nupo Omo xeika purina. Nu siko xopuropu apu nu Yesusu Kristusu, pa apue asinaku kutu kapiani kutu kakepina. <verse eid="1JN 2:1"/><verse number="2" style="v" sid="1JN 2:2"/>Nue<note caller="-" style="x"><char style="xo" closed="false">2.2 </char><char style="xt" closed="false"><ref loc="JHN 1:29">Yo 1.29</ref>; <ref loc="JHN 11:52">11.52</ref>;<ref loc="ROM 3:25">Ro 3.25</ref>;<ref loc="2CO 5:18">2 Ko 5.18</ref>;<ref loc="COL 1:20">Kl 1.20</ref>;<ref loc="1JN 4:10">1 Yo 4.10</ref>; <ref loc="1JN 4:14">4.14</ref></char></note> nukoini sikou xunu xesawopure saina teyai. Nue sini kireni tianisikepure mua saina teyaixe. Xuwe. Xokupa xuiapu ouro puroteneai tianikepure kakeyai.<verse eid="1JN 2:2"/></para>
  <para style="s">Apu Xoiteu sipani kutue, Xoiteupo kapia tairouna</para>
  <para style="p">
    <verse number="3" style="v" sid="1JN 2:3"/>Sini Xoiteupo kunani kutu tainukua nu sipaukiriaire xiri atinuku sipawopu.<verse eid="1JN 2:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="1JN 2:4"/>Kire<note caller="-" style="x"><char style="xo" closed="false">2.4 </char><char style="xt" closed="false"><ref loc="1JN 1:6-8">1 Yo 1.6-8</ref>; <ref loc="1JN 4:20">4.20</ref></char></note> apue kunauna, “Ye Xoiteu sipani kutu,” xepina. Pana nu Xoiteupo kunani kutu taiwopu xuweuna paiya, pa apu nu xoreitua xati, nupo xoukemuro kunani kutu puratixe. <verse eid="1JN 2:4"/><verse number="5" style="v" sid="1JN 2:5"/>Kire<note caller="-" style="x"><char style="xo" closed="false">2.5-6 </char><char style="xt" closed="false"><ref loc="JHN 13:15">Yo 13.15</ref>; <ref loc="JHN 14:21-23">14.21-23</ref>; <ref loc="JHN 15:4-5">15.4-5</ref>;<ref loc="1PE 2:21">1 Pi 2.21</ref>;<ref loc="1JN 4:12-13">1 Yo 4.12-13</ref>; <ref loc="1JN 4:17">4.17</ref>; <ref loc="1JN 5:3">5.3</ref></char></note> apue Xoiteupo kuna taina paiya, nu nupo xoukemu Xoiteu tuwopi xiri sipa xati, sini panumu kapiarei, Xoiteu xeika etokinuku.<verse eid="1JN 2:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="1JN 2:6"/>Kire apue kunauna, “Ye Xoiteu xeika etokine xinapa,” paina pa apua nu Kristusue texeyai sieni texepina. <verse eid="1JN 2:6"/><verse number="7" style="v" sid="1JN 2:7"/>Yeu waukia xura<note caller="-" style="x"><char style="xo" closed="false">2.7 </char><char style="xt" closed="false"><ref loc="1JN 2:24">1 Yo 2.24</ref>; <ref loc="1JN 3:11">3.11</ref>;<ref loc="2JN 1:5-6">2 Yo 5-6</ref></char></note>, mua Xoiteupo kuna tini xosa xayautiai paiya oma kunaxe. Xuwe. Paiya ekime takieni kutu tikiniai kuna. Pa xipiki kuna paiya takieni iyesikiniai. <verse eid="1JN 2:7"/><verse number="8" style="v" sid="1JN 2:8"/>Pana<note caller="-" style="x"><char style="xo" closed="false">2.8 </char><char style="xt" closed="false"><ref loc="JHN 1:9">Yo 1.9</ref>; <ref loc="JHN 8:12">8.12</ref>; <ref loc="JHN 13:34">13.34</ref>;<ref loc="ROM 13:12">Ro 13.12</ref>;<ref loc="EPH 5:8">Ep 5.8</ref>;<ref loc="1TH 5:5">1 Ts 5.5</ref>; <ref loc="1TH 5:8">5.8</ref></char></note> mua kuna tini xosa xayautiai, pa rania oma kuna xati, Kristusupo ekeoma xeika tinipo ekitikioma xeika xosa rania pa suau, pa amure, ukumu xuwexepure xati memeremuni kutu putawotai purina.<verse eid="1JN 2:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="1JN 2:9"/>Kire<note caller="-" style="x"><char style="xo" closed="false">2.9 </char><char style="xt" closed="false"><ref loc="1CO 13:2">1 Ko 13.2</ref>;<ref loc="2PE 1:9">2 Pi 1.9</ref>;<ref loc="1JN 3:10">1 Yo 3.10</ref>; <ref loc="1JN 3:14-15">3.14-15</ref>; <ref loc="1JN 4:20">4.20</ref></char></note> apue kunauna, “Ye memeremu xosa purine,” xepina, pana kire xatau xosa xoukemu xoxixina paiya, pa apu nu ukumu xosauni purina. <verse eid="1JN 2:9"/><verse number="10" style="v" sid="1JN 2:10"/>Apue<note caller="-" style="x"><char style="xo" closed="false">2.10 </char><char style="xt" closed="false"><ref loc="JHN 11:9">Yo 11.9</ref>;<ref loc="ROM 14:13">Ro 14.13</ref>;<ref loc="2PE 1:10">2 Pi 1.10</ref>;<ref loc="1JN 3:14">1 Yo 3.14</ref></char></note> xatau xoukemu turouna paiya, nu memeremu xosa purirouna. Memeremu xosa paiya kire sapie kakati nu uraki xowopina puratixe. <verse eid="1JN 2:10"/><verse number="11" style="v" sid="1JN 2:11"/>Pana<note caller="-" style="x"><char style="xo" closed="false">2.11 </char><char style="xt" closed="false"><ref loc="JHN 11:10">Yo 11.10</ref>; <ref loc="JHN 12:35">12.35</ref></char></note> apue kire xatau, nu xosa xoukemu xoxirouna paiya, nu ukumu xosa purina. Nu ukumu xosa texina amu ime tainarau nu sipa xuwe. Nu ukumue eke paraeki.<verse eid="1JN 2:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="1JN 2:12"/>Tini<note caller="-" style="x"><char style="xo" closed="false">2.12 </char><char style="xt" closed="false"><ref loc="LUK 24:47">Lu 24.47</ref>;<ref loc="ACT 4:12">YT 4.12</ref>; <ref loc="ACT 13:38">13.38</ref>;<ref loc="1CO 6:11">1 Ko 6.11</ref>;<ref loc="1JN 1:7">1 Yo 1.7</ref></char></note> yeu nono misiarara, Xoiteue Kristusupo wenumurei tinipo xunu weteritiketai. Pa xati ye tini xosa mua kuna xayaune.<verse eid="1JN 2:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="1JN 2:13"/>Tini<note caller="-" style="x"><char style="xo" closed="false">2.13 </char><char style="xt" closed="false"><ref loc="1JN 1:1">1 Yo 1.1</ref></char></note> xauwa xura, tini sipani kutu pa apu nu ekimeni kutu puroyai mua pani purina. Pa xati tini xosa mua kuna xayaune.</para>
  <para style="p" vid="1JN 2:13">Tini apimi tenemai xura, tini Satani emeserukiriai. Pa xati tini xosa mua kuna xayaune.<verse eid="1JN 2:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="1JN 2:14"/>Nono xura<note caller="-" style="x"><char style="xo" closed="false">2.14 </char><char style="xt" closed="false"><ref loc="EPH 6:10">Ep 6.10</ref></char></note>, tini Emisiki sipani kutu. Pa xati tini xosa mua kuna xayaune.</para>
  <para style="p" vid="1JN 2:14">Tini xauwa xura, tini sipani kutu pa apu nu ekimeni kutu puroyai xati mua pani purina. Pa xati tini xosa ye mua kuna xayaune.</para>
  <para style="p" vid="1JN 2:14">Tini apu tenemai, tini sokisoki tuku xati, Xoiteupo kuna tini xosa sokisoki purati, Satani emeserukiriai. Pa xati ye mua kuna tini xosa xayaune.<verse eid="1JN 2:14"/></para>
  <para style="s">Sini ouropu kapia kapia xosikiewopuxe</para>
  <para style="p">
    <verse number="15" style="v" sid="1JN 2:15"/>Tini<note caller="-" style="x"><char style="xo" closed="false">2.15 </char><char style="xt" closed="false"><ref loc="MAT 6:24">Mt 6.24</ref>;<ref loc="ROM 8:7">Ro 8.7</ref>; <ref loc="ROM 12:2">12.2</ref>;<ref loc="GAL 1:10">Ka 1.10</ref></char></note> ouropu kapia kapia xotikiewoto xokupa ouropu sapi xotikiewotowaku. Kire apue ouropu kapia xouweunapa nu Xauwa xiri xouweurouwatixe. <verse eid="1JN 2:15"/><verse number="16" style="v" sid="1JN 2:16"/>Siko<note caller="-" style="x"><char style="xo" closed="false">2.16 </char><char style="xt" closed="false"><ref loc="ROM 13:14">Ro 13.14</ref>;<ref loc="JAS 4:16">Ye 4.16</ref>;<ref loc="1PE 2:11">1 Pi 2.11</ref></char></note> sipa, ouropu apimi nikau xokupa kapia paiya, xonikikemu sarepi kapia xeika ekiniki nepi kapia xeika niko xokupa sapire totoniki ouwopi xeikauneri. Pana xokupa kapia paiya Emisikirei koatixe. Xuwe. Paiya nini ouropu kapia kireni. <verse eid="1JN 2:16"/><verse number="17" style="v" sid="1JN 2:17"/>Mua<note caller="-" style="x"><char style="xo" closed="false">2.17 </char><char style="xt" closed="false"><ref loc="MAT 7:21">Mt 7.21</ref>;<ref loc="1CO 7:31">1 Ko 7.31</ref>;<ref loc="JAS 1:10">Ye 1.10</ref>;<ref loc="1PE 1:24">1 Pi 1.24</ref></char></note> ou xuwe xatia, mua ouropu xokupa kapia, paiya xosikikemu saropi kapia xeika ekisikienepi xeika rania xirini xuwexepineri. Pana kire apue Xoiteue xouweuwotai kapia taina paiya nu sipesi puropina.<verse eid="1JN 2:17"/></para>
  <para style="s">Kristusupo xiwaie putawotai</para>
  <para style="p">
    <verse number="18" style="v" sid="1JN 2:18"/>Yeu nonomi<note caller="-" style="x"><char style="xo" closed="false">2.18 </char><char style="xt" closed="false"><ref loc="MAT 24:5">Mt 24.5</ref>; <ref loc="MAT 24:24">24.24</ref>;<ref loc="2TH 2:3">2 Ts 2.3</ref>;<ref loc="1TI 4:1">1 Ti 4.1</ref>;<ref loc="HEB 1:2">Ip 1.2</ref>;<ref loc="1PE 4:7">1 Pi 4.7</ref>;<ref loc="2PE 2:1">2 Pi 2.1</ref>;<ref loc="2JN 1:7">2 Yo 7</ref></char></note>, sini xurisepu asau xosa putaurounuku. Kristusupo xiwayau kopinaxi kuna ekime iyesikiniai. Ximine Kristusupo xokupa xiwaiyaumana kouweteneai. Pa xati siko sipa, sini xurisepu asaupo yause xosa putaukiriai. <verse eid="1JN 2:18"/><verse number="19" style="v" sid="1JN 2:19"/>Ximuximu<note caller="-" style="x"><char style="xo" closed="false">2.19 </char><char style="xt" closed="false"><ref loc="MAT 24:24">Mt 24.24</ref>;<ref loc="JHN 6:37">Yo 6.37</ref>;<ref loc="ACT 20:30">YT 20.30</ref>;<ref loc="1CO 11:19">1 Ko 11.19</ref></char></note> pa apimie siko xeika puroneaie, wesiki xowoneai. Pana ninie sikou kini kutu xosauni puropu xuwe. Nini sikouni kutu xakua, nini siko xeikani puraku. Pana muaia siko weisikiteneai, pa xati ati sipaunuku, pa apimi paiya nini sikouni kutu xuwe.<verse eid="1JN 2:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="1JN 2:20"/>Tinie<note caller="-" style="x"><char style="xo" closed="false">2.20 </char><char style="xt" closed="false"><ref loc="JHN 10:4">Yo 10.4</ref>;<ref loc="ACT 3:14">YT 3.14</ref>;<ref loc="1CO 2:15">1 Ko 2.15</ref>;<ref loc="2CO 1:21">2 Ko 1.21</ref>;<ref loc="HEB 1:9">Ip 1.9</ref>;<ref loc="1JN 2:27">1 Yo 2.27</ref></char></note> Xoiteupo Supo Youya tieikiriai xati, tini xokupa sipa tuku. <verse eid="1JN 2:20"/><verse number="21" style="v" sid="1JN 2:21"/>Pa xati tini kunani kutu sipa xuwexi nanuworine mua kuna tini xosa xayauixe. Xuwe. Ye xayautiaia, pa amure, tinie suau kuna sipauweikiriai xati, suau kunae xorei kuna yararepu xuweuwopina paiya tini sipa. <verse eid="1JN 2:21"/><verse number="22" style="v" sid="1JN 2:22"/>Xoreixepina apu<note caller="-" style="x"><char style="xo" closed="false">2.22 </char><char style="xt" closed="false"><ref loc="1JN 4:3">1 Yo 4.3</ref>;<ref loc="2JN 1:7">2 Yo 7</ref></char></note> nu yuna? Paiya pa apu nu kunauna, “Xoiteue nukou xuiapu xiyeri tinikepure tumuworetai apu paiya Yesusu xana xuwexi,” kunaurouna. Apue pa kuna kunawotaia, nue Emisiki xeika Nirau xeika nike tinikirouna, pa xati nu Kristusupo xiwai. <verse eid="1JN 2:22"/><verse number="23" style="v" sid="1JN 2:23"/>Apue<note caller="-" style="x"><char style="xo" closed="false">2.23 </char><char style="xt" closed="false"><ref loc="JHN 5:23">Yo 5.23</ref>; <ref loc="JHN 14:7-10">14.7-10</ref>; <ref loc="JHN 15:23">15.23</ref>;<ref loc="1JN 4:15">1 Yo 4.15</ref>; <ref loc="1JN 5:1">5.1</ref>;<ref loc="2JN 1:9">2 Yo 9</ref></char></note> Nono nike tuna paiya Omo rania nike tuna. Apue Nonoure xousuna paiya, nu Omoure rania xousuna.<verse eid="1JN 2:23"/></para>
  <para style="s">Xoiteupo Supo Youyae suau kunaure taitaisikirouna</para>
  <para style="p">
    <verse number="24" style="v" sid="1JN 2:24"/>Ekime<note caller="-" style="x"><char style="xo" closed="false">2.24 </char><char style="xt" closed="false"><ref loc="JHN 14:23">Yo 14.23</ref>;<ref loc="1JN 1:3">1 Yo 1.3</ref>;<ref loc="2JN 1:6">2 Yo 6</ref></char></note> tinie pa kuna iyesikiniai paiya, tini sokisoki ta. Tini ekime tikiniai kuna sokisoki tinari paiya, Nono xeika Omo xeikae tini xeika sipesi puropineri. <verse eid="1JN 2:24"/><verse number="25" style="v" sid="1JN 2:25"/>Kristusue<note caller="-" style="x"><char style="xo" closed="false">2.25 </char><char style="xt" closed="false"><ref loc="JHN 3:15">Yo 3.15</ref>; <ref loc="JHN 6:40">6.40</ref>; <ref loc="JHN 17:3">17.3</ref>;<ref loc="1JN 1:2">1 Yo 1.2</ref>; <ref loc="1JN 5:11">5.11</ref></char></note> siko sokisoki kuna ipaki kasikina, tini sipesi atinari purakuai ekitikioma tikepine xeyai.<verse eid="1JN 2:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="1JN 2:26"/>Tini xoreitikepure xeteneai apimi nikau kapiaure tini katikepure mua kuna tini xosa xayaune. <verse eid="1JN 2:26"/><verse number="27" style="v" sid="1JN 2:27"/>Pana<note caller="-" style="x"><char style="xo" closed="false">2.27 </char><char style="xt" closed="false"><ref loc="JHN 14:26">Yo 14.26</ref>; <ref loc="JHN 16:13">16.13</ref>;<ref loc="HEB 8:10-11">Ip 8.10-11</ref>;<ref loc="1JN 2:20">1 Yo 2.20</ref></char></note> tinie Kristusu xosaupo Xoiteupo Supo Youya tieikiriai xati, nue tini xeikani purina. Pa xati tini sipa xuweitautikati xati, ye tini taitaitikepixe. Xuwe. Xoiteupo Supo Youyaini tini taitaitikirouna xati, pa Youyapu kuna paiya xiri suau. Nu xoreixatixe. Pa xati tini Youyae taitaitiketai sie Kristusu xeika etoka.<verse eid="1JN 2:27"/></para>
  <para style="s">Ximine sini Xoiteupo nono purinuku</para>
  <para style="p">
    <verse number="28" style="v" sid="1JN 2:28"/>Iyo<note caller="-" style="x"><char style="xo" closed="false">2.28 </char><char style="xt" closed="false"><ref loc="1JN 3:2">1 Yo 3.2</ref>; <ref loc="1JN 4:17">4.17</ref></char></note>, yeu nono xura, tini Kristusu xeikani kutu etoka. Kakari nue sosikepure xiyeri koatia sini sokisoki tumunukua, nu ekero mayarei tumuwopuxe. <verse eid="1JN 2:28"/><verse number="29" style="v" sid="1JN 2:29"/>Kristusupo kapia xiri asinakuni kutuxi panumu sipaunaria<note caller="-" style="x"><char style="xo" closed="false">2.29 </char><char style="xt" closed="false"><ref loc="ACT 22:14">YT 22.14</ref>;<ref loc="1JN 3:7">1 Yo 3.7</ref>; <ref loc="1JN 3:10">3.10</ref></char></note>, xokupa apimie asinaku kutu kapia kaketeneaie, Xoiteupo nono sayeteneai xinari rania panumu sipawakuai.<verse eid="1JN 2:29"/></para>
  <chapter eid="1JN 2"/>
  <chapter number="3" style="c" sid="1JN 3"/>
  <para style="p">
    <verse number="1" style="v" sid="1JN 3:1"/>Xawa xura<note caller="-" style="x"><char style="xo" closed="false">3.1 </char><char style="xt" closed="false"><ref loc="JHN 1:12">Yo 1.12</ref>; <ref loc="JHN 3:16">3.16</ref>; <ref loc="JHN 16:3">16.3</ref>;<ref loc="ROM 8:16">Ro 8.16</ref>;<ref loc="1JN 4:10">1 Yo 4.10</ref></char></note>, Xauwae sini xouwesikerina nupo xoukemu sikeki sikekina! Sini Xoiteupo nonomixi nue wenisikeyai. Paiya suauni kutu, sini Xoiteupo nonomi purinuku. Ouropu apimie Xoiteu sipawoneai xana xuwe, pa xati siko rania sipasikerixe. <verse eid="1JN 3:1"/><verse number="2" style="v" sid="1JN 3:2"/>Waukia xura<note caller="-" style="x"><char style="xo" closed="false">3.2 </char><char style="xt" closed="false"><ref loc="ROM 8:18">Ro 8.18</ref>; <ref loc="ROM 8:29">8.29</ref>;<ref loc="1CO 15:49">1 Ko 15.49</ref>;<ref loc="2CO 3:18">2 Ko 3.18</ref>;<ref loc="PHP 3:21">Pl 3.21</ref>;<ref loc="COL 3:4">Kl 3.4</ref>;<ref loc="2PE 1:4">2 Pi 1.4</ref></char></note>, ximine sini Xoiteupo nonomi purinuku. Sewai sini amaki puropua pa sini xemu sipaukirixe. Pana siko sipa, Kristusue yara putawopina yause xosa, sikoe suauni kutu xekeunukua, sini nuko sieni xepu. <verse eid="1JN 3:2"/><verse number="3" style="v" sid="1JN 3:3"/>Pa xati, yue Kristusu nukou siexepurexineria, nini kapia kutu asinaku tairouneri. Pa xati Kristusue xosei purotai sie nini rania xosei purineri.<verse eid="1JN 3:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="1JN 3:4"/>Apue<note caller="-" style="x"><char style="xo" closed="false">3.4 </char><char style="xt" closed="false"><ref loc="ROM 4:15">Ro 4.15</ref>;<ref loc="1JN 5:17">1 Yo 5.17</ref></char></note> xunu eretaia nu Xoiteupo tu sokau porouna. Xunu paiya tu sokau porowopi kapia. <verse eid="1JN 3:4"/><verse number="5" style="v" sid="1JN 3:5"/>Tini<note caller="-" style="x"><char style="xo" closed="false">3.5 </char><char style="xt" closed="false"><ref loc="ISA 53:5-6">Ais 53.5-6</ref>; <ref loc="ISA 53:11">53.11</ref>;<ref loc="JHN 1:29">Yo 1.29</ref>;<ref loc="2CO 5:21">2 Ko 5.21</ref>;<ref loc="1TI 1:15">1 Ti 1.15</ref>;<ref loc="HEB 4:15">Ip 4.15</ref>;<ref loc="1PE 2:22-24">1 Pi 2.22-24</ref>;<ref loc="1JN 2:2">1 Yo 2.2</ref></char></note> sipa, Kristusue xunu xesauwepure putawoyai xati, nu xosa xunu puratixe. <verse eid="1JN 3:5"/><verse number="6" style="v" sid="1JN 3:6"/>Apue<note caller="-" style="x"><char style="xo" closed="false">3.6 </char><char style="xt" closed="false"><ref loc="ROM 6:1-2">Ro 6.1-2</ref>; <ref loc="ROM 6:14">6.14</ref>;<ref loc="1JN 2:4">1 Yo 2.4</ref>; <ref loc="1JN 3:9">3.9</ref>; <ref loc="1JN 4:8">4.8</ref>;<ref loc="3JN 1:11">3 Yo 11</ref></char></note> Kristusu xeika etokina paiya, nu xunupo kapia tairouwatixe. Kire apue xunupo kapia taina paiya, nu Kristusu xekoyai xana xuwexi sipawopu, pa xeika nu Kristusu sipa xuwe xepu.<verse eid="1JN 3:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="1JN 3:7"/>Tini<note caller="-" style="x"><char style="xo" closed="false">3.7 </char><char style="xt" closed="false"><ref loc="ROM 2:13">Ro 2.13</ref>;<ref loc="1JN 2:26">1 Yo 2.26</ref>; <ref loc="1JN 2:29">2.29</ref></char></note> yeu nono misiarara xura, tini sosopa epixakuai, panumu kire apue xoreitikexete. Apue asinaku kutu kapia kakatia, nu apu asinaku kutu, nu Apu Kristusu asinaku kutu sie. <verse eid="1JN 3:7"/><verse number="8" style="v" sid="1JN 3:8"/>Ximuximu<note caller="-" style="x"><char style="xo" closed="false">3.8 </char><char style="xt" closed="false"><ref loc="GEN 3:15">Stt 3.15</ref>;<ref loc="LUK 10:18">Lu 10.18</ref>;<ref loc="JHN 8:44">Yo 8.44</ref>; <ref loc="JHN 16:11">16.11</ref>;<ref loc="HEB 2:14">Ip 2.14</ref></char></note> ekimeni kutu xosa, Satanie sipesi xunu erirouna, pa xati apue xunu erirouna paiya nu Satanipo apu. Pa xati Xoiteupo Nonoe Satanipo saina purieina xesauwepure yarani putawoyai. <verse eid="1JN 3:8"/><verse number="9" style="v" sid="1JN 3:9"/>Kire<note caller="-" style="x"><char style="xo" closed="false">3.9 </char><char style="xt" closed="false"><ref loc="1PE 1:23">1 Pi 1.23</ref>;<ref loc="1JN 5:18">1 Yo 5.18</ref></char></note> apue Xoiteupo nono saina paiya, nu xunupo kapia tairouwatixana xuwe. Xoiteupo ekeomani pa apu xosa purina, pa xati nue xunupo kapia taiwopuwatixe. Xuwe. Nu Xoiteupo nono purina. <verse eid="1JN 3:9"/><verse number="10" style="v" sid="1JN 3:10"/>Yue <note caller="-" style="x"><char style="xo" closed="false">3.10 </char><char style="xt" closed="false"><ref loc="1JN 2:29">1 Yo 2.29</ref>; <ref loc="1JN 4:8">4.8</ref></char></note>Xoiteupo nono xati yue Satanipo nono xinuku sipawopurepa, apue asinaku kutu kapia kakepu xuweuwatia, nu Xoiteupo nono xuwexi sipawopu. Pa xeika apue Xoiteupo kireu nonomi xiri xouwenikepi xuweurouna rania nu Xoiteupo xuwe xepu.<verse eid="1JN 3:10"/></para>
  <para style="ms">Sini kirenikirenie kireu xiri xosikienikepu</para>
  <para style="mr">
    <ref loc="1JN 3:11-5:21">3.11—5.21</ref></para>
  <para style="s">Kireu xiri xosikienikepi kapia Yesusue atarisiketai</para>
  <para style="p">
    <verse number="11" style="v" sid="1JN 3:11"/>Sini<note caller="-" style="x"><char style="xo" closed="false">3.11 </char><char style="xt" closed="false"><ref loc="JHN 13:34">Yo 13.34</ref>; <ref loc="JHN 15:12">15.12</ref>;<ref loc="1JN 1:5">1 Yo 1.5</ref>; <ref loc="1JN 4:7">4.7</ref>; <ref loc="1JN 4:21">4.21</ref></char></note> kirenikirenie kireu xiri xosikienikepu xetai kuna paiya ximuximuni kutu tinie pa kuna iyesikiniai. <verse eid="1JN 3:11"/><verse number="12" style="v" sid="1JN 3:12"/>Sini<note caller="-" style="x"><char style="xo" closed="false">3.12 </char><char style="xt" closed="false"><ref loc="GEN 4:8">Stt 4.8</ref>;<ref loc="HEB 11:4">Ip 11.4</ref>;<ref loc="JUD 1:11">Yu 11</ref></char></note> Keini sie puropuxe. Nu Satanipo apu xati xameyau ouweyai. Ama nupo xameyau ouweyaina? Xameyau ouweyaia, amure, nukou kapia xoxi xati, xameyaupo kapia asinaku kutu xati ouweyai.<verse eid="1JN 3:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="1JN 3:13"/>Xatai xura<note caller="-" style="x"><char style="xo" closed="false">3.13 </char><char style="xt" closed="false"><ref loc="MAT 5:11-12">Mt 5.11-12</ref>;<ref loc="JHN 15:18-19">Yo 15.18-19</ref>; <ref loc="JHN 17:14">17.14</ref>;<ref loc="2TI 3:12">2 Ti 3.12</ref></char></note>, ouropu apimie xiwaixiwaitikeria, tini paire kakixanari xoxi ure urewaku. <verse eid="1JN 3:13"/><verse number="14" style="v" sid="1JN 3:14"/>Sini<note caller="-" style="x"><char style="xo" closed="false">3.14 </char><char style="xt" closed="false"><ref loc="JHN 5:24">Yo 5.24</ref>;<ref loc="1JN 2:9-11">1 Yo 2.9-11</ref></char></note> Xoiteupo kireu xuiapu xosa xosikikemu tinikirounuku, pa xati siko sipa, sini xumopipo kapia wetikiriai xati, ekisikiomapu kapia xosa purinuku. Apue xataumana xoukemu tinikepu xuweurouna paiya, nu xumopipo kapia xosauni purina. <verse eid="1JN 3:14"/><verse number="15" style="v" sid="1JN 3:15"/>Apu<note caller="-" style="x"><char style="xo" closed="false">3.15 </char><char style="xt" closed="false"><ref loc="MAT 5:21-22">Mt 5.21-22</ref>;<ref loc="GAL 5:21">Ka 5.21</ref>;<ref loc="REV 21:8">XKY 21.8</ref></char></note> xatau xiri xouwewopu xuweuna xoukemu xoxixoxixina paiya, nu apu ouwetai siexina. Pa xati tini sipa, apue kire apu ouweina paiya, nu sipesi sipesi ati puropina ekeoma tatixe. <verse eid="1JN 3:15"/><verse number="16" style="v" sid="1JN 3:16"/>Yesusue<note caller="-" style="x"><char style="xo" closed="false">3.16 </char><char style="xt" closed="false"><ref loc="JHN 3:16">Yo 3.16</ref>; <ref loc="JHN 13:1">13.1</ref>; <ref loc="JHN 15:13">15.13</ref>;<ref loc="ROM 5:8">Ro 5.8</ref>;<ref loc="GAL 1:4">Ka 1.4</ref>;<ref loc="EPH 5:2">Ep 5.2</ref>; <ref loc="EPH 5:25">5.25</ref>;<ref loc="1TH 2:8">1 Ts 2.8</ref></char></note> siko tianisikepure nukou ekeomani wetina xumotai xati, nupo pa kapia paie kireu xiri xosikienikepi kapia atarisiketai. Pa xati sinie rania xatasikimanae Yesusu taiwoteneai tianikepure ekisikioma wetepu. <verse eid="1JN 3:16"/><verse number="17" style="v" sid="1JN 3:17"/>Pana<note caller="-" style="x"><char style="xo" closed="false">3.17 </char><char style="xt" closed="false"><ref loc="DEU 15:7">Tu 15.7</ref>;<ref loc="LUK 3:11">Lu 3.11</ref>;<ref loc="1JN 4:20">1 Yo 4.20</ref></char></note> kire apu nu mua ouropu sapi tukue, kire xatau xekoati xuruara xuweitauwati, nu pa xataure xousuawopu xuweunapa siko sipa, Xoiteue kireu xouwenikirouna kapia pa apu xosa puratixe. <verse eid="1JN 3:17"/><verse number="18" style="v" sid="1JN 3:18"/>Tini<note caller="-" style="x"><char style="xo" closed="false">3.18 </char><char style="xt" closed="false"><ref loc="ROM 12:9">Ro 12.9</ref>;<ref loc="JAS 2:15-16">Ye 2.15-16</ref>;<ref loc="1PE 1:22">1 Pi 1.22</ref></char></note> yeu nono misiarara, sini xatasikimana kuna kireniere e supusikie kireni xosikienikepuxe. Xuwe. Sini sikou xosikikemuni kutu tinikinuku asinaku kapia nini xosa kakepu.<verse eid="1JN 3:18"/></para>
  <para style="s">Yesusu taiwoteneaie Xoiteu ekero sokisoki tumuwopineri</para>
  <para style="p">
    <verse number="19-20" style="v" sid="1JN 3:19-20"/>Sini<note caller="-" style="x"><char style="xo" closed="false">3.19-20 </char><char style="xt" closed="false"><ref loc="JHN 18:37">Yo 18.37</ref>;<ref loc="1JN 1:8">1 Yo 1.8</ref></char></note> kireu xiri xosikienikinukua, sini suau kuna tainuku xinukua sipawopu. Sikou xosikie kire sapire kuna xosa iyaisikerepina sorena, Xoiteu ekero sini yoroara puropu. Pa amure, Xoiteu nu xokupa sapi sipa xati, nupo sipae sikou xosikiro purotai sipa xiri orouna. <verse eid="1JN 3:19-20"/><verse number="21" style="v" sid="1JN 3:21"/>Waukia xura<note caller="-" style="x"><char style="xo" closed="false">3.21 </char><char style="xt" closed="false"><ref loc="HEB 4:16">Ip 4.16</ref>; <ref loc="HEB 10:22">10.22</ref>;<ref loc="1JN 2:28">1 Yo 2.28</ref>; <ref loc="1JN 4:17">4.17</ref></char></note>, sikou xosikie kuna xosa iyaisikerepu xuweuwatia, sini Xoiteu ekero sokisoki tumurounuku. <verse eid="1JN 3:21"/><verse number="22" style="v" sid="1JN 3:22"/>Kire<note caller="-" style="x"><char style="xo" closed="false">3.22 </char><char style="xt" closed="false"><ref loc="PSA 34:15">Siri 34.15</ref>;<ref loc="JER 29:12">Yer 29.12</ref>;<ref loc="MAT 7:8">Mt 7.8</ref>; <ref loc="MAT 21:22">21.22</ref>;<ref loc="JHN 9:31">Yo 9.31</ref>; <ref loc="JHN 14:13">14.13</ref></char></note> sapire kunikuninuku nu kotoukiria, nue sikirouna, pa amure, sikoe nupo kuna tainuku, nue xouwewotai kapia kakirounuku. <verse eid="1JN 3:22"/><verse number="23" style="v" sid="1JN 3:23"/>Pa xati<note caller="-" style="x"><char style="xo" closed="false">3.23 </char><char style="xt" closed="false"><ref loc="JHN 6:29">Yo 6.29</ref>; <ref loc="JHN 13:34">13.34</ref>; <ref loc="JHN 15:12">15.12</ref>; <ref loc="JHN 15:17">15.17</ref>; <ref loc="JHN 17:3">17.3</ref>;<ref loc="1TH 4:9">1 Ts 4.9</ref>;<ref loc="1PE 4:8">1 Pi 4.8</ref>;<ref loc="1JN 2:8-10">1 Yo 2.8-10</ref></char></note> nupo tu paiya muanumu. Sini nupo Nono Yesusu Kristusu wenumurei xosikisunuku, nukoe siko kasikeyai sie siko kireni kirenie kireu xiri xosikienikepu. <verse eid="1JN 3:23"/><verse number="24" style="v" sid="1JN 3:24"/>Kire<note caller="-" style="x"><char style="xo" closed="false">3.24 </char><char style="xt" closed="false"><ref loc="JHN 14:23">Yo 14.23</ref>; <ref loc="JHN 15:10">15.10</ref>; <ref loc="JHN 17:21">17.21</ref>;<ref loc="ROM 8:9">Ro 8.9</ref>;<ref loc="1JN 4:12-13">1 Yo 4.12-13</ref></char></note> apue Xoiteupo kuna taina paiya, nue Xoiteu xeika etokati, Xoiteue nu xeika etokina. Xoiteue Xoiteupo Supo Youya siko sikati, Xoiteue siko xeika purinaxi, pa Youyae siko atarisikina.<verse eid="1JN 3:24"/></para>
  <chapter eid="1JN 3"/>
  <chapter number="4" style="c" sid="1JN 4"/>
  <para style="s">Tini youya erurunikakuai, nini Xoiteurei kounerire e xuwe</para>
  <para style="p">
    <verse number="1" style="v" sid="1JN 4:1"/>Waukia xura<note caller="-" style="x"><char style="xo" closed="false">4.1 </char><char style="xt" closed="false"><ref loc="MAT 7:15">Mt 7.15</ref>; <ref loc="MAT 24:4-5">24.4-5</ref>; <ref loc="MAT 24:24">24.24</ref>;<ref loc="1TH 5:21">1 Ts 5.21</ref>;<ref loc="2PE 2:1">2 Pi 2.1</ref>;<ref loc="1JN 2:18">1 Yo 2.18</ref>;<ref loc="2JN 1:7">2 Yo 7</ref>;<ref loc="REV 2:2">XKY 2.2</ref></char></note>, xokupa xoreixoreitua kunatureturei ouro tei xanauneri. Pa xati xokupa apimie tini xosa maneri kunauneri, “Xoiteupo Supo Youyae ye kuna sietai,” xatia kakixanari tini xotikisuwaku. Xuwe. Tini xokupa youya erurunari sipauweinarieye, nini Xoiteurei koteneaire e xuwerau paiya sipawakuai. <verse eid="1JN 4:1"/><verse number="2" style="v" sid="1JN 4:2"/>Takipo kapiae<note caller="-" style="x"><char style="xo" closed="false">4.2 </char><char style="xt" closed="false"><ref loc="1CO 12:3">1 Ko 12.3</ref>;<ref loc="1JN 5:1">1 Yo 5.1</ref></char></note> sipaunapa, Xoiteupo Youya paia muanumu xepina. Apue kunauna, “Yesusu Kristusue apuni kutu sayetai,” xirouna paiya Xoiteupo Youyae pa apu xosa purina. <verse eid="1JN 4:2"/><verse number="3" style="v" sid="1JN 4:3"/>Apue <note caller="-" style="x"><char style="xo" closed="false">4.3 </char><char style="xt" closed="false"><ref loc="2TH 2:7">2 Ts 2.7</ref>;<ref loc="1JN 2:18">1 Yo 2.18</ref>; <ref loc="1JN 2:22">2.22</ref>;<ref loc="2JN 1:7">2 Yo 7</ref></char></note>Yesusure muanumu kuna kunawopu xuweuna paiya, pa apu nu xetau youya tuku, nu Xoiteurei koatixe. Paiya Kristusupo xiwaipo youya, ekime takie kopina kuna iyesikiniai. Ximine nu kourotai ouro purina.<verse eid="1JN 4:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="1JN 4:4"/>Yeu<note caller="-" style="x"><char style="xo" closed="false">4.4 </char><char style="xt" closed="false"><ref loc="MAT 12:29">Mt 12.29</ref>;<ref loc="JHN 16:33">Yo 16.33</ref>;<ref loc="1CO 2:12">1 Ko 2.12</ref>;<ref loc="EPH 2:2">Ep 2.2</ref>; <ref loc="EPH 6:12">6.12</ref>;<ref loc="1JN 5:4-5">1 Yo 5.4-5</ref></char></note> nono misiarara xura, tini Xoiteupo xati, tinie pa xoreixorei kunatureture xoronikieikiniai, pa amure, pa Youya tini xotikiro purotai paie ouropu apimi nikau xonikiro purotai youya orouna. <verse eid="1JN 4:4"/><verse number="5" style="v" sid="1JN 4:5"/>Pa<note caller="-" style="x"><char style="xo" closed="false">4.5 </char><char style="xt" closed="false"><ref loc="JHN 3:31">Yo 3.31</ref>; <ref loc="JHN 15:19">15.19</ref>; <ref loc="JHN 17:14">17.14</ref></char></note> apimie nini ouropu apimi. Pa xati ninipo kuna paiya ouropu kireni xati, ouropu apimie ninipo kuna iyesirouneri. <verse eid="1JN 4:5"/><verse number="6" style="v" sid="1JN 4:6"/>Pana<note caller="-" style="x"><char style="xo" closed="false">4.6 </char><char style="xt" closed="false"><ref loc="JHN 8:47">Yo 8.47</ref>; <ref loc="JHN 10:27">10.27</ref>; <ref loc="JHN 14:17">14.17</ref>;<ref loc="1CO 14:37">1 Ko 14.37</ref>;<ref loc="2CO 10:7">2 Ko 10.7</ref></char></note> sini paiya Xoiteupo xati, Xoiteu sipa apimie sinipo kuna iyesinouneri. Pana apu Xoiteupo xuwe paiya, nue sikou kuna iyesirouwatixe. Pa kapiarei sini suau kunapu Youya xeika xoreixoreipo youya xeika sipawopu.<verse eid="1JN 4:6"/></para>
  <para style="s">Apue Xoiteu xiri xouweuna paiya nu xataumana rania xouwenikepina</para>
  <para style="p">
    <verse number="7" style="v" sid="1JN 4:7"/>Waukia xura<note caller="-" style="x"><char style="xo" closed="false">4.7 </char><char style="xt" closed="false"><ref loc="1JN 2:29">1 Yo 2.29</ref>; <ref loc="1JN 3:10-11">3.10-11</ref>; <ref loc="1JN 3:23">3.23</ref></char></note>, sini kirenikirenie xatasikimana xiri xosikienikepu, pa amure, kireu xosikienikepi kapia paiya Xoiteupo kapia. Pa xati apue kireu xiri xouweniketai paiya, nu Xoiteupo nono xati, nu Xoiteu sipani kutu. <verse eid="1JN 4:7"/><verse number="8" style="v" sid="1JN 4:8"/>Xoiteu<note caller="-" style="x"><char style="xo" closed="false">4.8 </char><char style="xt" closed="false"><ref loc="1JN 2:4">1 Yo 2.4</ref>; <ref loc="1JN 3:6">3.6</ref>; <ref loc="1JN 4:16">4.16</ref></char></note> nukoini kireu xonikikiewopi kapia xotapa, pa xati apue kireu xouwenikepi xuweurouna paiya, nu Xoiteu sipa xuwe. <verse eid="1JN 4:8"/><verse number="9" style="v" sid="1JN 4:9"/>Xoiteu<note caller="-" style="x"><char style="xo" closed="false">4.9 </char><char style="xt" closed="false"><ref loc="JHN 3:16">Yo 3.16</ref>;<ref loc="ROM 5:8">Ro 5.8</ref>; <ref loc="ROM 8:32">8.32</ref>;<ref loc="1JN 5:11">1 Yo 5.11</ref></char></note> nu Nono kireni tuku xati, siko nu xosa ekisikioma tepure, pa Nono xesawati ouro koyai. Pa kapiarei Xoiteu nukoe sini xiri xouwesiketaie atarisikina. <verse eid="1JN 4:9"/><verse number="10" style="v" sid="1JN 4:10"/>Kireu xonikiewopi kapia<note caller="-" style="x"><char style="xo" closed="false">4.10 </char><char style="xt" closed="false"><ref loc="JHN 15:16">Yo 15.16</ref>;<ref loc="ROM 5:8-10">Ro 5.8-10</ref>;<ref loc="TIT 3:4">Ta 3.4</ref>;<ref loc="1JN 2:2">1 Yo 2.2</ref></char></note> paiya, Xoiteupo kapia. Sini nanunuku ximuximuni sinie Xoiteu xosikieukiniai xepuxe. Xuwe. Xoiteue akerina sini xouwesikeyai. Pa xati sikou xunu wetepure, nue nupo Sawai Nono xesawati ouro koyai.<verse eid="1JN 4:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="1JN 4:11"/>Waukia xura<note caller="-" style="x"><char style="xo" closed="false">4.11 </char><char style="xt" closed="false"><ref loc="MAT 18:33">Mt 18.33</ref>;<ref loc="JHN 15:12-13">Yo 15.12-13</ref>;<ref loc="1JN 3:16">1 Yo 3.16</ref></char></note>, nupo kapia paie Xoiteue siko xiri xouwesiketaire atarisiketai. Pa xati sini kirenikirenie kireu xiri xosikienikepu. <verse eid="1JN 4:11"/><verse number="12" style="v" sid="1JN 4:12"/>Kire apue<note caller="-" style="x"><char style="xo" closed="false">4.12 </char><char style="xt" closed="false"><ref loc="JHN 1:18">Yo 1.18</ref>;<ref loc="1TI 6:16">1 Ti 6.16</ref>;<ref loc="1JN 2:5-6">1 Yo 2.5-6</ref>; <ref loc="1JN 4:18-20">4.18-20</ref></char></note> Xoiteu xekoyaixe. Pana sini kireu xiri xosikienikinukua, Xoiteue siko xeika purati, nupo kireu xonikiewopi kapiae, sikou ekisikioma xosa sokisokietai.<verse eid="1JN 4:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="1JN 4:13"/>Xoiteue<note caller="-" style="x"><char style="xo" closed="false">4.13 </char><char style="xt" closed="false"><ref loc="JHN 14:20">Yo 14.20</ref>;<ref loc="2CO 1:22">2 Ko 1.22</ref>;<ref loc="1JN 3:24">1 Yo 3.24</ref></char></note> sini xeika etokati sinie nu xeika etokepua, sini amakinuku sipawopuna? Sini paire sipa, pa amure, sini nue nukou Youyani sikeyai. <verse eid="1JN 4:13"/><verse number="14" style="v" sid="1JN 4:14"/>Emisikie<note caller="-" style="x"><char style="xo" closed="false">4.14 </char><char style="xt" closed="false"><ref loc="JHN 1:14">Yo 1.14</ref>; <ref loc="JHN 3:17">3.17</ref>;<ref loc="1JN 1:1-2">1 Yo 1.1-2</ref></char></note> kakeyai kapia sikoe xekeukiniai. Nue ouropu xokupa xuiapu xiyeri tinikepure nukou Nono xesawati koyai xati, pa kapiaure sini kuna uteirounuku. <verse eid="1JN 4:14"/><verse number="15" style="v" sid="1JN 4:15"/>Kire<note caller="-" style="x"><char style="xo" closed="false">4.15 </char><char style="xt" closed="false"><ref loc="ROM 10:9">Ro 10.9</ref>;<ref loc="1JN 5:1">1 Yo 5.1</ref>; <ref loc="1JN 5:5">5.5</ref></char></note> apue kunauna, “Yesusu nu Xoiteupo Nono xinapa,” Xoiteue pa apu xeika etokati, nue Xoiteu xeika etokina. <verse eid="1JN 4:15"/><verse number="16" style="v" sid="1JN 4:16"/>Paire<note caller="-" style="x"><char style="xo" closed="false">4.16 </char><char style="xt" closed="false"><ref loc="1JN 3:24">1 Yo 3.24</ref>; <ref loc="1JN 4:8">4.8</ref>; <ref loc="1JN 4:12">4.12</ref></char></note> siko sipa xati ipaki sokisoki xosikisunuku, Xoiteue siko xiri xouwesikati, nupo pa kapiae sikou ekisikioma xosa purina.</para>
  <para style="p" vid="1JN 4:16">Xoiteu nukoini kireu xiri xosikienikepi kapia xotapa. Pa xati apue kireu xiri xouwenikirounae Xoiteu xeika etokati, Xoiteue nu xeika etokina. <verse eid="1JN 4:16"/><verse number="17" style="v" sid="1JN 4:17"/>Sini<note caller="-" style="x"><char style="xo" closed="false">4.17 </char><char style="xt" closed="false"><ref loc="JAS 2:13">Ye 2.13</ref>;<ref loc="1JN 2:28">1 Yo 2.28</ref>; <ref loc="1JN 3:3">3.3</ref>; <ref loc="1JN 3:19-21">3.19-21</ref></char></note> panumu purinukua, kireu xosikienikepi kapiae sikou ekisikioma xosa sokisokietai. Pa xati Xoiteupo kokaipa kunapu asaure ximikepuxe. Suau, sini mua ouro purinukuna pana, sini Kristusu nuko sieni purinuku xati, sini ximikepuxe. <verse eid="1JN 4:17"/><verse number="18" style="v" sid="1JN 4:18"/>Kireu xonikieurouneri xuiapue Xoiteure ximikiroworixe. Ximiketeneai xuiapu kini nini sipa, nini pa kapia xapa xoxi tepineri xati, pa nanunanue kakati Xoiteure ximikineri nini kireu xonikiewopi kapia sokisoki xineri paiya, nini Xoiteure ximikepuworixe. Kire apue Xoiteure ximikirouna paiya, kireu xouwenikepi kapiae pa nupo ekeoma xosa sokisoki xatixe.<verse eid="1JN 4:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="1JN 4:19"/>Sini Xoiteu xosikieunuku kireu xosikienikinuku paiya amure, Xoiteue ximuximuni siko xouwesikeyai xati kakirounuku. <verse eid="1JN 4:19"/><verse number="20" style="v" sid="1JN 4:20"/>Kire apue<note caller="-" style="x"><char style="xo" closed="false">4.20 </char><char style="xt" closed="false"><ref loc="1JN 2:4">1 Yo 2.4</ref>; <ref loc="1JN 3:17">3.17</ref>; <ref loc="1JN 4:12">4.12</ref></char></note> kunauna, “Ye Xoiteu xiri xoieune xepina,” pana Xoiteupo xuiapu xosaupo kire apu xouwewopu xuweuna paiya, pa apu nu xoreixoreitua. Kire apue Xoiteu xekoyaixe. Pa xati apue xekenikieyai xuiapu xouwenikepu xuweuna paiya, nu xekopu xuweuwoyai Xoiteue xekopuwati xana xuwe. <verse eid="1JN 4:20"/><verse number="21" style="v" sid="1JN 4:21"/>Mua<note caller="-" style="x"><char style="xo" closed="false">4.21 </char><char style="xt" closed="false"><ref loc="MAT 5:44-45">Mt 5.44-45</ref>;<ref loc="MRK 12:29-31">Mk 12.29-31</ref>;<ref loc="JHN 13:34">Yo 13.34</ref>; <ref loc="JHN 15:12">15.12</ref>;<ref loc="1JN 3:23">1 Yo 3.23</ref></char></note> kuna Kristusu xosaupo tikiniai, paiya muanumu. Apue Xoiteu xiri xouweurouna paiya, nu Xoiteupo kireu xuiapu xiri xouwenikepina.<verse eid="1JN 4:21"/></para>
  <chapter eid="1JN 4"/>
  <chapter number="5" style="c" sid="1JN 5"/>
  <para style="s">Yesusu taiwoteneaie mua oupo sokisoki oroweteneai</para>
  <para style="p">
    <verse number="1" style="v" sid="1JN 5:1"/>Xoiteue nukou xuiapu xiyeri tinikepure tumuworetai apu nu Yesusu xati xokupa xuiapue nure xonikisuneria, nini Xoiteupo nonomi puropineri. Xokupa<note caller="-" style="x"><char style="xo" closed="false">5.1 </char><char style="xt" closed="false"><ref loc="JHN 1:12-13">Yo 1.12-13</ref>; <ref loc="JHN 15:23">15.23</ref>;<ref loc="1JN 2:22-23">1 Yo 2.22-23</ref>; <ref loc="1JN 4:15">4.15</ref></char></note> apimie Eminiki xonikieuneria, nupo niraumana rania xonikieurouneri. <verse eid="1JN 5:1"/><verse number="2" style="v" sid="1JN 5:2"/>Sini Xoiteu xiri xosikieunuku nupo xokupa kuna tainuku, pa kapiarei sipaunukua sini Xoiteupo nonomi xiri xosikienikinuku xepu. <verse eid="1JN 5:2"/><verse number="3" style="v" sid="1JN 5:3"/>Sini<note caller="-" style="x"><char style="xo" closed="false">5.3 </char><char style="xt" closed="false"><ref loc="MIC 6:8">Mai 6.8</ref>;<ref loc="MAT 11:30">Mt 11.30</ref>;<ref loc="JHN 14:15">Yo 14.15</ref>; <ref loc="JHN 14:21-24">14.21-24</ref>;<ref loc="2JN 1:6">2 Yo 6</ref></char></note> Xoiteu xiri xosikieunukua, sini nupo xokupa kuna tairounuku. Pa xati nupo xokupa kunae sini xu sikerixe. <verse eid="1JN 5:3"/><verse number="4" style="v" sid="1JN 5:4"/>Xokupa<note caller="-" style="x"><char style="xo" closed="false">5.4 </char><char style="xt" closed="false"><ref loc="JHN 16:33">Yo 16.33</ref>;<ref loc="1JN 3:9">1 Yo 3.9</ref>; <ref loc="1JN 4:4">4.4</ref></char></note> apimie Xoiteupo nono puroteneaia, ninie mua ouropu sokisoki orouneri. Sini Xoiteure xosikisunuku xati, pa kapiarei xomaxinuku mua ouropu sokisoki orourounuku.<verse eid="1JN 5:4"/></para>
  <para style="s">Xoiteue nukou Nonoure kuna pitewotai</para>
  <para style="p">
    <verse number="5" style="v" sid="1JN 5:5"/>Yue<note caller="-" style="x"><char style="xo" closed="false">5.5 </char><char style="xt" closed="false"><ref loc="ROM 8:37">Ro 8.37</ref>;<ref loc="1CO 15:57">1 Ko 15.57</ref>;<ref loc="1JN 4:4">1 Yo 4.4</ref>; <ref loc="1JN 4:15">4.15</ref></char></note> mua ouropo sokisoki orourounana? Apue Xoiteupo Nono nu Yesusure xousuna paiya, pa apue orourouna. <verse eid="1JN 5:5"/><verse number="6" style="v" sid="1JN 5:6"/>Yesusu Kristusue<note caller="-" style="x"><char style="xo" closed="false">5.6 </char><char style="xt" closed="false"><ref loc="JHN 1:29">Yo 1.29</ref>; <ref loc="JHN 1:34">1.34</ref>; <ref loc="JHN 14:17">14.17</ref>; <ref loc="JHN 16:13">16.13</ref>; <ref loc="JHN 19:34">19.34</ref>;<ref loc="1TI 3:16">1 Ti 3.16</ref>;<ref loc="1JN 1:7">1 Yo 1.7</ref></char></note> enero ene isepi kapiaure koto, nupo yawi na nikitoto xosa kusawopina kapiaure kotowoyai. Nue enepu kapia kirenire koyaixe. Xuwe. Nu ene xeika yawi xeikapu kapiaure koyai. Xoiteupo Supo Youya nu suau kunapu xotapa xati, Xoiteupo Supo Youyae Yesusu Kristusupo kapiaure kuna uteirouna. <verse eid="1JN 5:6"/><verse number="7" style="v" sid="1JN 5:7"/>Xeimorei<note caller="-" style="x"><char style="xo" closed="false">5.7 </char><char style="xt" closed="false"><ref loc="JHN 1:1">Yo 1.1</ref>; <ref loc="JHN 10:30">10.30</ref>;<ref loc="REV 19:13">XKY 19.13</ref></char></note> purineri nupo kapiaure kunauwoteneai, <verse eid="1JN 5:7"/><verse number="8" style="v" sid="1JN 5:8"/>paiya<note caller="-" style="x"><char style="xo" closed="false">5.8 </char><char style="xt" closed="false"><ref loc="JHN 15:26">Yo 15.26</ref></char></note> nini Xoiteupo Supo Youya xeika ene xeika yawi xeikae kaketeneai. Nini xeimorei kirenie kuna kireni kunawoteneai.<verse eid="1JN 5:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="1JN 5:9"/>Apue uteirouneri kuna sikoe<note caller="-" style="x"><char style="xo" closed="false">5.9 </char><char style="xt" closed="false"><ref loc="MAT 3:16-17">Mt 3.16-17</ref>; <ref loc="MAT 17:5">17.5</ref>;<ref loc="JHN 5:32-37">Yo 5.32-37</ref>; <ref loc="JHN 8:17-18">8.17-18</ref></char></note> xosikisurounuku. Pana Xoiteue uteiwotai kuna paie, apu nikau kuna xiri oronikina. Pa kuna Xoiteue uteiyetai paiya, nukou Nonoure kunawoyai. <verse eid="1JN 5:9"/><verse number="10" style="v" sid="1JN 5:10"/>Apue<note caller="-" style="x"><char style="xo" closed="false">5.10 </char><char style="xt" closed="false"><ref loc="JHN 3:33">Yo 3.33</ref>; <ref loc="JHN 5:38">5.38</ref>;<ref loc="ROM 8:16">Ro 8.16</ref>;<ref loc="GAL 4:6">Ka 4.6</ref></char></note> Xoiteupo Nonoure xousurounae Xoiteue pa kuna uteiwoyai tietai xati, pa kuna nupo xouro purina. Pana apue Xoiteupo kuna xousuwopu xuweunapa, nue Xoiteu nu xoreixoreituaiyeuna, pa amure, Xoiteue nukou Nonopu kapiaure kuna uteiwoyaire xousuwatixe. <verse eid="1JN 5:10"/><verse number="11" style="v" sid="1JN 5:11"/>Pa kapiarei Xoiteue nukou kuna suauxi atarisikina. Xoiteue sipesi sipesi puropu ekisikioma sikeyai xati, pa ekisikiomapu xotapa paiya nukou Nono xosa purina. <verse eid="1JN 5:11"/><verse number="12" style="v" sid="1JN 5:12"/>Apue<note caller="-" style="x"><char style="xo" closed="false">5.12 </char><char style="xt" closed="false"><ref loc="JHN 3:36">Yo 3.36</ref>; <ref loc="JHN 5:24">5.24</ref></char></note> Xoiteupo Nono xeika etokina paiya, nu pa ekeoma tuku. Apue Xoiteupo Nono xeika etokepu xuweuna paiya, nu pa ekeoma xuwe.<verse eid="1JN 5:12"/></para>
  <para style="s">Sini sipesi puropu ekisikioma tukuxi sipawopu</para>
  <para style="p">
    <verse number="13" style="v" sid="1JN 5:13"/>Tini<note caller="-" style="x"><char style="xo" closed="false">5.13 </char><char style="xt" closed="false"><ref loc="JHN 20:31">Yo 20.31</ref>;<ref loc="1JN 1:1-2">1 Yo 1.1-2</ref></char></note> xuiapue Xoiteupo Nonopu wenumurei xotikisurounuku xosa mua kuna xayaune. Tini sipesi sipesi purakuaire ekitikioma tieikiriaire sipawakuai. <verse eid="1JN 5:13"/><verse number="14" style="v" sid="1JN 5:14"/>Sini<note caller="-" style="x"><char style="xo" closed="false">5.14 </char><char style="xt" closed="false"><ref loc="JHN 14:13">Yo 14.13</ref>; <ref loc="JHN 16:23">16.23</ref>;<ref loc="1JN 3:21-22">1 Yo 3.21-22</ref></char></note> Xoiteu nukoe xouwewotai nanunanu tainuku kire sapire kunikuninuku kotounukua, nue sikou kunikuni iyesirouna. Pa xati sini Xoiteure ximikiroukirixe. Xuwe. Sini nuko nutiemu xonarounuku. <verse eid="1JN 5:14"/><verse number="15" style="v" sid="1JN 5:15"/>Siko sipa, nue sikou xokupa kunikuni iyesirouna. Pa xati nue kire sapi sikepinaure kotounukua, siko sipa pa sapini kutu tepu.<verse eid="1JN 5:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="1JN 5:16"/>Kire<note caller="-" style="x"><char style="xo" closed="false">5.16 </char><char style="xt" closed="false"><ref loc="MAT 12:31-32">Mt 12.31-32</ref>;<ref loc="LUK 12:10">Lu 12.10</ref>;<ref loc="HEB 6:4-6">Ip 6.4-6</ref>;<ref loc="JAS 5:14-15">Ye 5.14-15</ref></char></note> apue xekoati kire xatau Yesusu taiwotaie xunu erati, pa xunue kakati pa apu xumopu xuweuwopina xatia, pa apu nukoini Xoiteu xosa kunikuniwati, Xoiteue pa xatasiki ekeoma tuwopina. Apue xumopi xuweuwopineri xunu erineri xumopu xuweuwopinerire ye kunaune. Apue xunu erineri xumopineri xunu purinana, tini paire kunikuniwakuai xine ye kunautixe. <verse eid="1JN 5:16"/><verse number="17" style="v" sid="1JN 5:17"/>Xokupa kapia asinaku kutu xuweu paiya xunu. Pana apu xumopu xuweurouneri xunu paiya purina.<verse eid="1JN 5:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="1JN 5:18"/>Siko<note caller="-" style="x"><char style="xo" closed="false">5.18 </char><char style="xt" closed="false"><ref loc="JHN 17:15">Yo 17.15</ref>;<ref loc="JAS 1:27">Ye 1.27</ref>;<ref loc="1PE 1:23">1 Pi 1.23</ref>;<ref loc="1JN 3:9">1 Yo 3.9</ref></char></note> sipa, xokupa apimie Xoiteupo nonomi purineria, ninie xunupo kapia tairouworixe. Xuwe. Apue Xoiteupo nono purotaia Xoiteue ati yakurouna xati, Satanie nu xosa xupo iyarepuwatixe. <verse eid="1JN 5:18"/><verse number="19" style="v" sid="1JN 5:19"/>Siko<note caller="-" style="x"><char style="xo" closed="false">5.19 </char><char style="xt" closed="false"><ref loc="ROM 8:10">Ro 8.10</ref>; <ref loc="ROM 8:23">8.23</ref>;<ref loc="GAL 1:4">Ka 1.4</ref>;<ref loc="1JN 4:6">1 Yo 4.6</ref></char></note> sipa, siko Xoiteupo nonomi purinuku sorena, mua ou xokupa paiya Satanipo sokisoki irue purina.<verse eid="1JN 5:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="1JN 5:20"/>Siko<note caller="-" style="x"><char style="xo" closed="false">5.20 </char><char style="xt" closed="false"><ref loc="ISA 9:6">Ais 9.6</ref>;<ref loc="MAT 25:46">Mt 25.46</ref>;<ref loc="JHN 17:3">Yo 17.3</ref>;<ref loc="1TI 3:16">1 Ti 3.16</ref>;<ref loc="HEB 1:8">Ip 1.8</ref></char></note> sipa, Xoiteupo Nono kourotai xati, sikoe Xoiteuni kutu sipawopure, nue nanunanu sikina. Sini Xoiteuni kutu xeika Nirau Yesusu Kristusu xeika etokinuku. Yesusu Kristusu paiya nu Xoiteuni kutu xati, nue ekisikioma atinuku sipesi sipesi puropu xotapa.<verse eid="1JN 5:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="1JN 5:21"/>Yeu<note caller="-" style="x"><char style="xo" closed="false">5.21 </char><char style="xt" closed="false"><ref loc="1CO 10:14">1 Ko 10.14</ref></char></note> nono misiarara xura, tini xokupa xoreixorei xoiteu weinikiterinari xetauroni pura.<verse eid="1JN 5:21"/></para>
  <chapter eid="1JN 5"/>
</usx>
