<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="2JN" style="id">- BLANK based on TPB 99</book>
  <para style="ide"/>
  <para style="rem"/>
  <para style="rem"/>
  <para style="h"/>
  <para style="toc3">2 Yo</para>
  <para style="toc2">2 Yo</para>
  <para style="toc1">2 Yoni</para>
  <para style="mt2">Xoka Axixiri Nakau</para>
  <para style="mt">Yonie Xayawotai</para>
  <para style="imt">Akereki Kuna</para>
  <para style="ip">Kire Yesusure xonikisuwoteneai xuiapu nikau tumue mua kuna xayawoyai. Kireu xuiapue nanuneri kire xuiapu teue Yesusure tairouneri xosa nakau xayawotai xeneai. Ninie kireu xiri xonikienikineri, pani Xoiteupo kuna porouneri xoreixoreixirouneri apimi xosa ati sosopa epixepinerire xiri xouweniketai.</para>
  <chapter number="1" style="c" sid="2JN 1"/>
  <para style="ms">Sini Xoiteupo kunani kutu sokisoki tinuku apimie xetau xonuxonu kuna uteiwoteneaire sosopa epixepu</para>
  <para style="p">
    <verse number="1" style="v" sid="2JN 1:1"/>Ye<note caller="-" style="x"><char style="xo" closed="false">1.1 </char><char style="xt" closed="false"><ref loc="JHN 8:32">Yo 8.32</ref>;<ref loc="1PE 5:1">1 Pi 5.1</ref>;<ref loc="1JN 3:18">1 Yo 3.18</ref>;<ref loc="3JN 1:1">3 Yo 1</ref></char></note> Yesusure xonikisuwoteneai xuiapu nikau tumu, ne xui naki xeika neu nono teu xeika xosa mua nakau xayaune<note caller="*" style="f"><char style="fr" closed="false">1.1 </char><char style="ft" closed="false">Kireu apimie nanuneri pa nakau paiya kire xuini kutu xosa xowotai xeteneai. Kakeri kireu nanuneri pa xui paiya nu kire Yesusure xonikisurouneri xuiapu xati, nupo nonomi paiya pa Yesusure xonikisuwoteneai xosaupo xuiapu xeteneai. Nu Yesusure xousurouna kire xui xatia, paina paiya nupo uko, kuna momu 13 xosa kunauna nu rania kire Yesusure xonikisurounneri xetai.</char></note>. Xoiteue ne nukouni tumuneretai xati, ye suauni kutu kunaune, yei tini xiri xoietikine. Paiye kirenixe. Xuwe. Suau kuna sipani kutu xuiapue tini xiri xonikietikineri. <verse eid="2JN 1:1"/><verse number="2" style="v" sid="2JN 1:2"/>Suau kuna siko xosa purinana, nue sipesi siko xosa puropina, pa xati sinie tini xiri xosikietikinuku. <verse eid="2JN 1:2"/><verse number="3" style="v" sid="2JN 1:3"/>Suau kunapu kapia xeika kireu xosikienikepi kapia xeika paiya, Xoiteu xeika Yesusu xeika xosaniki purina. Pa xati Xauwa Xoiteu xeika Xoiteupo Nono Kristusu Yesusu xeikae ninire xonikisuwoxati xonikienikineri, siko xosa xonikemu yororoneri.<verse eid="2JN 1:3"/></para>
  <para style="s">Sini kireu xiri xosikienikepi kapiani kutu taiwopu</para>
  <para style="p">
    <verse number="4" style="v" sid="2JN 1:4"/>Emisikie kunauna taiwa xeyai sie neu kireu nonomie suau kuna tairounerire ye<note caller="-" style="x"><char style="xo" closed="false">1.4 </char><char style="xt" closed="false"><ref loc="3JN 1:3">3 Yo 3</ref></char></note> kuna iyeserine xiri nimaririne. <verse eid="2JN 1:4"/><verse number="5" style="v" sid="2JN 1:5"/>Pana<note caller="-" style="x"><char style="xo" closed="false">1.5 </char><char style="xt" closed="false"><ref loc="JHN 13:34">Yo 13.34</ref>; <ref loc="JHN 15:12">15.12</ref>; <ref loc="JHN 15:17">15.17</ref>;<ref loc="1TI 4:8">1 Ti 4.8</ref>;<ref loc="1JN 2:7-8">1 Yo 2.7-8</ref>; <ref loc="1JN 3:11">3.11</ref>; <ref loc="1JN 3:23">3.23</ref></char></note> xui, yeu kire kuna ne xiri taiwowairexine. Paiya muanumu, sini kirenikirenie kireu xiri xosikienikepu. Paiya yei ne oma kuna tinixe. Xuwe. Ekimeni kutu sikoe mua kuna tieikiniai. <verse eid="2JN 1:5"/><verse number="6" style="v" sid="2JN 1:6"/>Xoiteu xouwewopi kapia<note caller="-" style="x"><char style="xo" closed="false">1.6 </char><char style="xt" closed="false"><ref loc="JHN 14:15">Yo 14.15</ref>; <ref loc="JHN 14:21">14.21</ref>;<ref loc="1JN 2:5">1 Yo 2.5</ref>; <ref loc="1JN 2:24">2.24</ref>; <ref loc="1JN 5:3">5.3</ref></char></note> paiya muanumu, sini Xoiteupo kunani kutu taiwopu. Pa xati pa kuna eikimeni kutu iyesikiniai paiya, muanumu, tini kireu xotikienikepi kapiani kutu taiwa.<verse eid="2JN 1:6"/></para>
  <para style="s">Sini Kristusupo kuna sokisoki tepu</para>
  <para style="p">
    <verse number="7" style="v" sid="2JN 1:7"/>Iyesa<note caller="-" style="x"><char style="xo" closed="false">1.7 </char><char style="xt" closed="false"><ref loc="1JN 2:22">1 Yo 2.22</ref>; <ref loc="1JN 4:1-3">4.1-3</ref></char></note>. Xoreisikepurexeteneai apimie ouyau texineri. Nini Yesusu Kristusue apu sayeyai xineri xonikisuworixe. Panumu apua, nu xoreixoreitua xati, Kristusu xiwaiuna. <verse eid="2JN 1:7"/><verse number="8" style="v" sid="2JN 1:8"/>Pa xati<note caller="-" style="x"><char style="xo" closed="false">1.8 </char><char style="xt" closed="false"><ref loc="MRK 10:29-30">Mk 10.29-30</ref>;<ref loc="GAL 3:4">Ka 3.4</ref>;<ref loc="HEB 10:32">Ip 10.32</ref>; <ref loc="HEB 10:35">10.35</ref></char></note> tini atinari sosopani kutu epixa, panumu sini irerei imerei tikiniai sapi wetexekini. Tini sokisoki tumunaria tinipo xokupa asinaku sapi takuai. <verse eid="2JN 1:8"/><verse number="9" style="v" sid="2JN 1:9"/>Kire apue<note caller="-" style="x"><char style="xo" closed="false">1.9 </char><char style="xt" closed="false"><ref loc="1JN 2:23">1 Yo 2.23</ref></char></note> Kristusupo kuna sokisoki tepu xuweuna, kire kuna xosa potixinapa, Xoiteue nu xeika puratixe. Pana kire apue Kristusupo kuna sokisoki tinapa, Omono Niraunoe nu xeika purinexeri. <verse eid="2JN 1:9"/><verse number="10" style="v" sid="2JN 1:10"/>Kire apue<note caller="-" style="x"><char style="xo" closed="false">1.10 </char><char style="xt" closed="false"><ref loc="EPH 5:11">Ep 5.11</ref>;<ref loc="2TH 3:6">2 Ts 3.6</ref></char></note> tinipo atoro kouna, panumu kuna tikopu xuweuwatia, tinie kusounari tinipo atoro sou xowaku. <verse eid="2JN 1:10"/><verse number="11" style="v" sid="2JN 1:11"/>Apue panumu apu kusouna paiya, nue nupo xoxi kapiapu sainaure tianuna.<verse eid="2JN 1:11"/></para>
  <para style="s">Yonie xekenikepurexina</para>
  <para style="p">
    <verse number="12" style="v" sid="2JN 1:12"/>Xokupa<note caller="-" style="x"><char style="xo" closed="false">1.12 </char><char style="xt" closed="false"><ref loc="JHN 17:13">Yo 17.13</ref>;<ref loc="1JN 1:4">1 Yo 1.4</ref>;<ref loc="3JN 1:13-14">3 Yo 13-14</ref></char></note> kuna tini xosa xayawopine itouna pana, kire nakau xosa mua kuna iyarepi xiraxine. Ye koune xeketikinei, xirini kunakunaunuku nimaririwopuxi nanune.<verse eid="2JN 1:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="2JN 1:13"/>Neu ukunipo nonomi, pa ukuni paiya Xoiteu nukoini tumuworetaipo nonomie ne kusonineri<note caller="-" style="x"><char style="xo" closed="false">1.13 </char><char style="xt" closed="false"><ref loc="2JN 1:1">2 Yo 1</ref></char></note>.<verse eid="2JN 1:13"/></para>
  <chapter eid="2JN 1"/>
</usx>
