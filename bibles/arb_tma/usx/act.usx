<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="ACT" style="id">- True Meaning Arabic</book>
  <para style="ide">UTF-8</para>
  <para style="h">سيرة الحواريّين</para>
  <para style="toc2">سيرة الحواريّين</para>
  <para style="toc1">سيرة الحواريّين</para>
  <para style="mt1">سيرة الحواريّين</para>
  <para style="imt">مدخل</para>
  <para style="ip">اختار الله لوقا الطبيب لتسجيل هذا الوحي، وهو تكملة لسجلّه الأوّل الذي دوّن فيه سيرة سيدنا المسيح المنتهية بصعوده إلى السماء. وهذا السجلّ الثاني يبدأ من لحظة الصعود تلك، ويتواصل مبيّنا كيف أنّ الحواريين (خصوصا بطرس وبولس)، وأتباع آخرين لسيدنا عيسى نشروا رسالته بفضل قوّة روح الله. ولأنّ لوقا كان رفيقا ملازما للحواري بولس، كما ذكرنا في المدخل إلى سجلّ لوقا الأوّل، فإنّ معظم ما دوّنه لوقا في هذا السجلّ هو عبارة عن شهادة عيان.</para>
  <para style="im">تبدأ السيرة بالتذكير بالوعد الذي أعطاه السيد المسيح (سلامُهُ علينا) إلى أتباعه بأن يظلّ معهم بواسطة روح الله التي سوف يرسلها إليهم لتقوّيهم حتّى ينشروا بشائر المملكة الرّبّانيّة في كلّ أرجاء المعمورة (1: 8). ثمّ تسترسل السيرة في ذكر تفاصيل تحقيق ذلك الوعد بإعلان الأتباع بشائر الرسالة، وتلَقّيهم هِبَة صنع المعجزات برهانا على صدق دعوتهم.</para>
  <para style="im">وقد واجه الحواريون، والرّعيل الأوّل من الأتباع سؤالا هامّا هو "من يحقُّ له الانتماء إلى شعب الله"؟ ولأنّ سيدنا عيسى وأتباعه الأوائل كانوا من بني يعقوب، فقد كان طبيعيا بالنسبة للبعض الاعتقاد بأنّ رسالة السيد المسيح موجَّهة لليهود وحدهم، وحتّى مَن آمن بالرسالة من غير اليهود كان عليه أن يصبح يهوديا كي يقبله الله! وقد نوقشت هذه المسألة بين الحواريين، إلاّ أنّ الله أكّد قبوله لجميع الناس، بغضِّ النظر عن خلفياتهم الدينية والعرقية، وذلك عبر الرؤى التي أراها لبولس (سيرة الحواريين 26: 12‏-18) وبطرس (10: 9‏-16) وأيضا عبر المعجزات العظيمة التي حدثت لحظة إيمان غير اليهود بسيدنا عيسى (أنظر على سبيل المثال سيرة الحواريين 10: 44‏-48؛ 13: 6‏-12).</para>
  <para style="im">وكما سبق أن أخبر السيد المسيح، فقد تعرّض أتباعه لاضطهاد شديد، ولكنّهم حَظُوا بتأييدٍ من روح الله بالصبر لمواصلة نشر الرسالة، فكثرت أعداد المؤمنين، وعمّت الرسالة أرجاء الإمبراطورية الرومانية، تماما كما كان قد تنبّأ سيدنا عيسى (متّى 13: 31‏-33)، ذلك أنه لا شيء يمكن أن يحدَّ من انتشار كلمة الله في كلّ مكان.</para>
  <chapter number="1" style="c" sid="ACT 1" />
  <para style="ms3">بسم الله تبارك وتعالى</para>
  <para style="cl">الفصل الأوّل</para>
  <para style="s">الوعد بروح الله</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 1:1" />أيُّها المُبَجَّلُ حَبيبُ اللهِ، كُنتُ قد أخبَرتُكَ في كِتابي الأوّلِ<note caller="+" style="f"><char style="fr" closed="false">1‏.1 </char><char style="ft" closed="false">وهذه العبارة تشير إلى الوحي المتعلّق بسيرة المسيح الذي سجّله لوقا الطبيب.</char></note> بكُلِّ ما قامَ بِهِ سَيِّدُنا عيسى (سلامُهُ علينا) مِن أعمالٍ وما بَشَّرَ بِهِ مِن تَعاليمَ مُنذُ بدايةِ رِسالتِهِ <verse eid="ACT 1:1" /><verse number="2" style="v" sid="ACT 1:2" />إلى اليَوم الّذي رُفِعَ فيهِ إلى السَّماءِ، وكانَ قد ألقى قَبلَ ذلِكَ وبمُؤازرةِ رُوحِ اللهِ وَصاياهُ على حَواريّيهِ الّذينَ اصطَفاهُم لمُهمّةِ تَبليغِ رِسالتِهِ. <verse eid="ACT 1:2" /><verse number="3" style="v" sid="ACT 1:3" />وبَعدَ أن صُلِبَ (سلامُهُ علينا) وبُعِثَ حيًّا، أخَذَ يَظهَرُ لهُم مِن حينٍ لآخَر في فَترةٍ امتَدَّت أربعينَ يومًا ليُؤكِّدَ لهُم أنّهُ قد بُعِثَ حَيًّا، مُبَدِّدًا بذلكَ شُكوكَهُم. وأثناءَ هذِهِ الظُّهُورات، كانَ يُحَدِّثُهُم مُجَدَّدًا عنِ المَملكةِ الأبَديّةِ الّتي وَعَدَ اللهُ بها عِبادَهُ. <verse eid="ACT 1:3" /><verse number="4" style="v" sid="ACT 1:4" />وذاتَ مَرّةٍ وفيما هُم يَتناوَلونَ الطَّعامَ أوصاهُم قائلاً: "لا تُغادِروا مَدينةَ القُدس، بلِ انتَظِروا فيها حتّى حُلولِ رُوحِ اللهِ فيكُم، حَسَبَ وَعدِ اللهِ الأبِ الرَّحمنِ، الوَعدِ الّذي سَبَقَ أن أخبَرتُكُم بِهِ. <verse eid="ACT 1:4" /><verse number="5" style="v" sid="ACT 1:5" />وإذا كانَ تَطهيرُ النّاسِ بالماءِ مُهمّةَ النّبيِّ يَحيى، فإنّكُم ستُطَهَّرونَ بفَيضِ رُوحِ الله بَعدَ أيّامٍ قَليلةٍ".<verse eid="ACT 1:5" /></para>
  <para style="s">رفع عيسى (سلامُهُ علينا) إلى السّماء</para>
  <para style="p">
    <verse number="6" style="v" sid="ACT 1:6" />وذاتَ مَرّةٍ بَينَما كانَ مُجتَمِعًا بِحَواريِّيهِ (سلامُهُ علينا) في جَبَلِ الزَّيتونِ سَألوهُ: "يا مَولانا، هل أنتَ عازمٌ على تَحريرِنا وإحياءِ مَملكةِ بَني يَعقوبَ في زَمَنِنا هذا؟" <verse eid="ACT 1:6" /><verse number="7" style="v" sid="ACT 1:7" />فأجابَهُم (سلامُهُ علينا) قائلاً: "لَيسَ لكُم أن تُحاطوا عِلمًا بأُمورٍ كهذِهِ، فاللهُ الأبُ الرَّحمنُ وَحدَهُ يُقدِّرُ المَواقِيتَ والأزمان. <verse eid="ACT 1:7" /><verse number="8" style="v" sid="ACT 1:8" />بل عِندَ تَجَلّي رُوحِ اللهِ القُدّوسِ عليكُم، تَحظَونَ بِالقُوّةِ والسُّلطانِ، فتَكونونَ لي شُهودًا في القُدس، وفي مَناطقِ يَهوذا والسّامرةِ، وسائرِ أصقاعِ الأرضِ". <verse eid="ACT 1:8" /><verse number="9" style="v" sid="ACT 1:9" />وبَعدَ حَديثِهِ هذا لحَواريِّيهِ، ارتَفَعَ إلى السّماءِ وهُم يَنظُرونَ إليهِ، حتّى حَجَبَتهُ سَحابةٌ.<verse eid="ACT 1:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="ACT 1:10" />وبَينَما هُم شاخِصونَ بأبصارِهِم إلى السَّماءِ، ظَهَرَ لهُم فَجأةً مَلاكانِ على هَيئةِ بَشَرٍ في ثيابٍ بَيضاءَ <verse eid="ACT 1:10" /><verse number="11" style="v" sid="ACT 1:11" />وقالا لهُم: "أيُّها الجَليليّونَ، لِمَ تَقِفونَ هكذا وأبصارُكُم شاخِصةٌ إلى السَّماء؟ إنّ عيسى (سلامُهُ علينا) الّذي تَمّ رَفعُهُ مِن بَينِكُم سيَعودُ بالطَّريقةِ نَفسِها الّتي شاهَدتُموهُ فيها يَرتَفِعُ إلى السّماء".<verse eid="ACT 1:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="ACT 1:12" />فغادَرَ الحَواريّونَ الجَبَلَ المَعروفَ بجَبَلِ الزَّيتونِ والواقِعِ على مَسافةِ أقلَّ مِن مِيلٍ مِنَ القُدس، <verse eid="ACT 1:12" /><verse number="13" style="v" sid="ACT 1:13" />وعِندَ وصولِهِم إلى المَدينةِ، صَعِدوا إلى الطَّبَقةِ العُليا حَيثُ مَكانُ إقامتِهِم، وكانَ هُناكَ الحَواريّونَ بُطرُسُ ويوحَنّا ويَعقوبُ وأَنْدَراوسُ وفيليبُ وتُوما وابنُ تَلْماي ومَتّى ويَعقوبُ بن حَلفي وسَمعان الوَطَنيُّ المُتَحمِّسُ ويَهوذا بن يَعقوبَ. <verse eid="ACT 1:13" /><verse number="14" style="v" sid="ACT 1:14" />وكانوا جَميعُهُم على قَلبٍ واحدٍ في صَلاةٍ ودُعاءٍ مُتَواصِلَيْن وقدِ انضَمَّ إليهِم بَعضُ النِّسوة، ومَريمُ أُمُّ عيسى (سلامُهُ علينا) وإخوتُهُ.<verse eid="ACT 1:14" /></para>
  <para style="s">اختيار خلف ليهوذا</para>
  <para style="p">
    <verse number="15" style="v" sid="ACT 1:15" />وتَجَمَّعَ ذاتَ يَومٍ ما يُقاربُ المِئةَ والعِشرينَ مِنَ المُؤمنينَ. فوَقَفَ بُطرُسُ الصَّخرُ بَينَهُم قائِلاً: <verse eid="ACT 1:15" /><verse number="16" style="v" sid="ACT 1:16" />"يا إخواني، كانَ لا بُدّ أن يَتَحَقّقَ ما جاءَ في الزَّبورِ على لِسانِ النّبيِّ داود بِوَحي رُوحِ اللهِ تَعالى، عَن يَهوذا الّذي دَلَّ العِصابةَ للقَبضِ على سَيِّدِنا عيسى (سلامُهُ علينا)، <verse eid="ACT 1:16" /><verse number="17" style="v" sid="ACT 1:17" />مَعَ أنّهُ كانَ واحِدًا مِنّا، وكانَ في ذاتِ الوَقتِ يَعمَلُ مَعَنا على نَشرِ الرِّسالةِ!" <verse eid="ACT 1:17" /><verse number="18" style="v" sid="ACT 1:18" />ولقد اشتَرى الأحبارُ باسمِ يَهوذا قِطعةَ أرضٍ بَعدَ مَوتِهِ، بالمالِ الّذي كَسَبَ مِن شُرورِهِ. وكانَت الأرضُ نَفسُها الّتي فيها شَنَقَ نَفسَهُ، وسَقَطَ على رأسِهِ، فانشَقَّ بَطنُهُ واندَلَقَت أمعاؤهُ.<note caller="+" style="f"><char style="fr" closed="false">1‏.18 </char><char style="ft" closed="false">وقد ورد في الوحي الذي سجّله متّى بأنّ يهوذا قبض من الأحبار مبلغًا قدره ثلاثون قطعة من الفضة مقابل خيانته للسيد المسيح. إلاّ أنّه حاول التخلّص منها لإحساسه بالذنب وأعادها إليهم، لكن الأحبار رفضوا وضعها في صندوق الصدقات لأنها مال حرام، ثم أنفقوها على قطعة أرض جعلوا منها مدفنًا للأغراب. ويبدو أنّهم اعتبروا المال ما يزال مال يهوذا لأنهم لم يضعوه في الصندوق، فلوقا بدوره يقول أن يهوذا هو من اشترى هذه القطعة من الأرض، كما أن يهوذا شنق نفسه حسب ما ورد في الوحي الذي سجّله متّى (متّى 27: 5)، ومن الممكن أن يكون بطنه قد انفجر بعد انتحاره شنقا نتيجة وقوعه أرضا. وهذه القطعة من الأرض حيث شنق نفسه، هي عينها التي اشتراها الأحبار باسمه لاحقًا.</char></note> <verse eid="ACT 1:18" /><verse number="19" style="v" sid="ACT 1:19" />ثُمّ انتَشَرَ خَبرُ هذِهِ الحادِثةِ بَينَ أهلِ القُدس، فأطلَقوا علَى ذاكَ الحَقلِ بلُغتِهِم الآراميّة لَقَبَ "حَقلُ الدَّم".<verse eid="ACT 1:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="ACT 1:20" />وتابَعَ بُطرُسُ قائلاً: "وقد جاءَ في الزَّبورِ عن يَهوذا الخائنِ: "لَيتَ دارَهُ تَصيرُ خَرابًا، فلا يُقيمُ فيها أحَدٌ". ووَرَدَ فيهِ أيضًا: "فليأخُذْ آخَرُ دَورَهُ". <verse eid="ACT 1:20" /><verse number="21‏-22" style="v" sid="ACT 1:21-22" />لذا علينا أن نَختارَ شَخصًا ليَكونَ شاهِدًا مَعَنا على بَعثِ سَيِّدِنا عيسى مِن المَوتِ، ولا بُدَّ أن يَكونَ هذا الشّخصُ مِن هؤلاءِ الّذينَ كانوا في صُحبتِنا دائمًا أثناءَ المُدّة الّتي قَضاها سَيِّدُنا عيسى بَينَنا، بَدءًا مِنَ الوَقتِ الّذي كانَ فيهِ النّبيُّ يَحيى (عليه السّلام) يَدعو النّاسَ إلى التَّطَهُّرِ بمياهِ نَهرِ الأُردُنّ، حتّى اليَومِ الّذي رُفِعَ فيهِ سَيِّدُنا عيسى إلى السّماءِ.<verse eid="ACT 1:21-22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="ACT 1:23" />واقتَرَحَ الحَواريّونَ شَخصَينِ ليَكونَ أحَدُهُما البَديلَ عن يَهوذا، وهُما يوسفُ المَدعوُّ بابنِ سابا المَعروفِ أيضًا بالصِّدِّيق، ومَتِّياس،<note caller="+" style="f"><char style="fr" closed="false">1‏.23 </char><char style="ft" closed="false">إنّ الرقم (12) كان رقمًا مقدّسًا، وذلك يعود إلى عدد عشائر بني يعقوب الاثني عشر المنحدرة من أبناء النبي يعقوب الاثني عشر. ومن هنا فإنّ تعيين سيدنا عيسى اثني عشر حواريًا دلالة على أنّه يريد بعث أمّة بني يعقوب بعثًا روحيًا جديدًا. لذا، شعر الأحد عشر حواريا بضرورة تعيين شخص مكان يهوذا، لإتمام العدد.</char></note> <verse eid="ACT 1:23" /><verse number="24" style="v" sid="ACT 1:24" />وبَدأ جَميعُهُم في الدُّعاء خاشِعينَ: "رَبَّنا أنتَ تَعرِفُ سَريرةَ كُلِّ النّاسِ، فألهِمْنا مَن مِن هذينِ الأخَوينِ مُختارُكَ <verse eid="ACT 1:24" /><verse number="25" style="v" sid="ACT 1:25" />ليَقومَ مَعَنا بنَشرِ الرِّسالةِ بَدَلَ يَهوذا الّذي تَخَلَّى عَنها ونالَ المَصيرَ الّذي يَستَحِقُّهُ". <verse eid="ACT 1:25" /><verse number="26" style="v" sid="ACT 1:26" />ثُمّ رَموا القُرعَةَ بَينَهُما فوَقَعَت على مَتِّياس،<note caller="+" style="f"><char style="fr" closed="false">1‏.26 </char><char style="ft" closed="false">اللّجوء إلى القرعة تقليد قديم يعود إلى مئات السنين قبل مجيء عيسى (سلامُهُ علينا)، وذلك لاختيار أشخاص يقومون بمهمّات خاصّة. وقد كان بنو يعقوب يستخدمون تلك الوسيلة لإيمانهم بسلطة الله العليا (مع أن ممارسة العرافة كانت محرّمة عندهم)، مؤكّدين من خلال تلك الوسيلة أن الاختيار النهائي لم يكن اختيارهم، إنّما هو اختيار الله تعالى.</char></note> فضَمُّوهُ إليهِم ليَكونَ الحَواريّ الثَّانيَ عَشَرَ.<verse eid="ACT 1:26" /></para>
  <chapter eid="ACT 1" />
  <chapter number="2" style="c" sid="ACT 2" />
  <para style="cl">الفصل الثّاني</para>
  <para style="s">تجلّيات روح الله</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 2:1" />وبَعدَ ذلِكَ، في يومِ عِيدِ الخَمسينَ<note caller="+" style="f"><char style="fr" closed="false">2‏.1 </char><char style="ft" closed="false">بُعث السيد المسيح حيًّا في اليوم الأوّل من أيّام الحصاد، وبعد هذا اليوم بخمسين يومًا، أي سبعة أسابيع يحلّ عيد الخمسين. </char></note> وبَينَما كانَ أتباعُ سَيِّدِنا عيسى (سلامُهُ علينا) مُجتَمِعينَ في بَيتٍ في القُدسِ، <verse eid="ACT 2:1" /><verse number="2" style="v" sid="ACT 2:2" />إذا بصَوتٍ هادِرٍ يأتي مِن السَّماءِ كأنّهُ الرِّيحُ العاصِفُ يَملأُ أرجاءَ المَكانِ الّذي كانوا مُجتَمِعينَ فيهِ، <verse eid="ACT 2:2" /><verse number="3" style="v" sid="ACT 2:3" />ورافَقَ الصَّوتَ ما يُشبِهُ ألسِنَةً مِنَ النّارِ تَفَرّقَت واستقَرَّت على رأسِ كُلِّ المُجتَمِعينَ <verse eid="ACT 2:3" /><verse number="4" style="v" sid="ACT 2:4" />الّذينَ حَظوا جَميعًا بَعدَئذٍ بفَيضٍ مِن رُوحِ اللهِ، فانطَلَقَت ألسِنتُهُم بِلُغاتٍ مُختَلِفةٍ عن لُغتِهِم، وذلِكَ حَسَبَ إمداداتِ رُوحِ الله وقيادَتِهِ لهُم.<verse eid="ACT 2:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="ACT 2:5" />وصادَفَ ذلِكَ وجودُ كَثيرٍ مِنَ اليَهودِ الأتقياءِ في القُدسِ كانوا قد جاؤوا مِن جَميعِ أنحاءِ العالَمِ،<note caller="+" style="f"><char style="fr" closed="false">2‏.5 </char><char style="ft" closed="false">كانت القدس هي المركز الديني لليهود وذلك لوجود بيت الله المقدّس فيها، وكان الكثير من اليهود المقيمين خارجها في جميع الأنحاء يحجّون إليها للاحتفال بالأعياد الرئيسية هناك، بما فيها عيد الخمسين.</char></note> <verse eid="ACT 2:5" /><verse number="6" style="v" sid="ACT 2:6" />وعِندَما سَمِعوا هذا الصَّوتَ المُدَوِّي، أقبَلوا على أتباعِ المَسيحِ (سلامُهُ علينا) مُسرِعينَ وقدِ اعتَراهُم وُجومٌ وهُم يَسمَعونَهُم يَتَحَدَّثونَ إليهِم كُلٌّ حَسَبَ لُغتِهِ. <verse eid="ACT 2:6" /><verse number="7" style="v" sid="ACT 2:7" />واندَهَشوا مُلتَفِتينَ بَعضُهُم إلى بَعضٍ قائلينَ: "كَيفَ تَتَحَدَّثُ هذِهِ الجَماعةُ بلُغاتٍ مُختَلِفةٍ، وهُم جَميعًا مِنَ الجَليلِ؟ <verse eid="ACT 2:7" /><verse number="8" style="v" sid="ACT 2:8" />كَيفَ نَسمَعُهُم يَتَحَدَّثونَ إلينا كُلٌّ بلُغَتِهِ الأُمّ؟! <verse eid="ACT 2:8" /><verse number="9" style="v" sid="ACT 2:9" />إنّنا مِن أماكن شَتّى، فبَعضُنا مِن فَرتِيَّة ومادي وعِيلام، والآخَرونَ مِن سُكّان ما بَينَ النّهرينِ ومِن بِلادِ الشّام، ومِن كَبدوكيَة وبُنط، ومُقاطعةِ آسيا، <verse eid="ACT 2:9" /><verse number="10" style="v" sid="ACT 2:10" />وفَرِيجيّة وبَمْفيليَّة،<note caller="+" style="f"><char style="fr" closed="false">2‏.10 </char><char style="ft" closed="false">فرتيّة ومادي وعيلام هي مناطق تقع الآن في إيران، وأمّا كبدوكية وبنط ومقاطعة آسيا وفريجيّة وبمفيلية فهي مناطق تقع اليوم في تركيا.</char></note> ومِن مِصر، ومِنّا مَن هو مِن مِنطقةِ لِيبيا القَريبة مِن مَدينةِ قُورينا، بالإضافةِ إلى كُلِّ مَن جاءَ زائِرًا مِن مَدينةِ روما، <verse eid="ACT 2:10" /><verse number="11" style="v" sid="ACT 2:11" />والقادِمينَ مِن جَزيرةِ كِرِيت ومَن هُم مِن بلادِ العَرَب! ومِن هؤلاءِ مَن هو يَهوديٌّ أصلاً، ومِنهُم مَنِ اعتَنَقَ اليَهوديّةَ مُنذُ وَقتٍ قَريبٍ. ورَغمَ ذلِكَ فإنّنا نَسمَعُ هؤلاءِ الجَليليّينَ يَتَحَدَّثونَ عن عَظائِمِ اللهِ في خَلقِهِ بلُغاتِنا جَميعًا!" <verse eid="ACT 2:11" /><verse number="12" style="v" sid="ACT 2:12" />هكذا، كانَ الحاضِرونَ في ذُهولٍ وحَيرةٍ مِن أمرِهِم، يَتسَاءَلونَ فيما بَينَهُم: "ما تَفسيرُ ذلِكَ كُلِّهِ؟" <verse eid="ACT 2:12" /><verse number="13" style="v" sid="ACT 2:13" />ثُمّ أخَذَ آخَرونَ، في الآن نَفسِهِ، يَنظُرونَ إلى هذا الأمرِ باستِهزاءٍ قائلينَ: "لا بُدَّ أنّ هؤلاءِ الجَليليّينَ سُكارى!"<verse eid="ACT 2:13" /></para>
  <para style="s">خطبة بطرس</para>
  <para style="p">
    <verse number="14" style="v" sid="ACT 2:14" />ووَقَفَ بُطرُسُ الصَّخرُ مَعَ إخوانِهِ الأحَدَ عَشَرَ حَواريًّا مُخاطِبًا المُجتَمِعينَ بصَوتٍ جَهوَريٍّ قائلاً: "يا إخواني مِن بَني يَعقوبَ، وأنتُم أيُّها الحاضِرونَ مِن سُكّانِ مَدينةِ القُدس، أصِيخوا السَّمعَ وكونوا إليّ مُتَنَبِّهينَ! <verse eid="ACT 2:14" /><verse number="15" style="v" sid="ACT 2:15" />ما هؤلاءِ بِسُكارى كَما تَزعُمونَ، لا أحَدَ يَسكَرُ والنّهارُ في أوّلِهِ والسّاعةُ التّاسِعة! <verse eid="ACT 2:15" /><verse number="16" style="v" sid="ACT 2:16" />وإنّما ما تَشهَدونَهُ هو ما جاءَ على لِسانِ النّبيّ يُوئِيلَ قَبلَ مِئاتِ السِّنين: <verse eid="ACT 2:16" /><verse number="17‏-18" style="v" sid="ACT 2:17-18" />"قالَ اللهُ تَعالى: في آخِرِ أيّامِ هذِهِ الدُّنيا، أفيضُ مِن رُوحي على كُلِّ البَشَرِ، حتّى إنّ بَنيكُم وبَناتِكُم قد تَظهَرُ عليهِم كَرامةُ النُّبوّءة،<note caller="+" style="f"><char style="fr" closed="false">2‏.17‏-18 </char><char style="ft" closed="false">كان اليهود يعتقدون بأنّ روح الله مخصّصة للأنبياء (عليهم السلام) والملوك الصالحين والمختارين من الناس فقط. ولكن مع قيامة السيد المسيح من الموت، قطع الله ميثاقًا جديدًا مع المؤمنين فأعطى روحه لعامّة الناس من كلّ الأجناس.</char></note> وتَتَجَلّى الرُّؤى على شَبابِكُم وشُيوخِكُم يَقِظينَ أو نيامًا، وحتّى على العَبيدِ، رِجالاً ونِساءً، ستَكونُ فيهِم كَرامةُ النُّبوءةِ، <verse eid="ACT 2:17-18" /><verse number="19" style="v" sid="ACT 2:19" />وستَظهَرُ عَجائبي وآياتي في السَّماءِ وعلى الأرضِ، فيَكونُ هُناكَ دَمٌ ونارٌ ودُخانٌ كَثيفٌ، <verse eid="ACT 2:19" /><verse number="20" style="v" sid="ACT 2:20" />وسَيَختَفي نُورُ الشَّمسِ، ويُصبحُ القَمَرُ بِلَونِ الدَّمِ، كُلُّ هذا قَبلَ حُلولِ مَوعِدِ ذلِكَ اليَومِ العَظيمِ المَهيبِ، يومِ اللهِ، <verse eid="ACT 2:20" /><verse number="21" style="v" sid="ACT 2:21" />وحِينَئذٍ كُلُّ مَن يَستَغيثُ بمَولانا يُصبِحُ مِنَ النّاجينَ".<verse eid="ACT 2:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="ACT 2:22" />"يا بَني إسرائيلَ، اُصغوا إلى ما أقولُهُ جيّدًا: إنّ اللهَ تَعالى أعطاكُم بُرهانًا على أنّ عيسى النّاصِريّ هو مَن أرسَلَهُ إليكُم مِن خِلالِ مُعجِزاتٍ وعَجائبَ وآياتٍ أجراها على يَديهِ، وإنّكُم لتَشهَدونَ على ذلِكَ. <verse eid="ACT 2:22" /><verse number="23" style="v" sid="ACT 2:23" />وقد كانَ مُقَدَّرًا في عِلمِ اللهِ الأزَليِّ تَسليمُهُ لكُم، فصَلَبتُموهُ وقَتَلتُموهُ وأعانَكُم الكَفَرةُ على ذلِكَ، <verse eid="ACT 2:23" /><verse number="24" style="v" sid="ACT 2:24" />ولكنّ اللهَ فَكَّهُ مِن حِبالِ المَنايا وبَعَثَهُ حَيًّا، فلم يَقوَ المَوتُ على أسرِهِ، <verse eid="ACT 2:24" /><verse number="25" style="v" sid="ACT 2:25" />وهذا كَما جاءَ عَنهُ على لِسانِ النّبِيِّ داود (عليه السّلام):<note caller="+" style="f"><char style="fr" closed="false">2‏.25 </char><char style="ft" closed="false">يعتبر النبي داود الملك الأعظم في بني يعقوب. وقد أخبر الأنبياء أنّ المسيح المنتظر سيكون من سلالته وهو الذي سيقيم مملكته من جديد.</char></note> "إنّي على يَقينٍ بأنّي في حِمايةِ اللهِ دائمًا، فلا أضطَرِبُ وهو عَوني، <verse eid="ACT 2:25" /><verse number="26" style="v" sid="ACT 2:26" />فلا عَجَبَ أن يَفرَحَ قَلبي ويُهَلِّلَ لِساني! إنّ جَسَدي يَرقُدُ على رَجاءٍ، <verse eid="ACT 2:26" /><verse number="27" style="v" sid="ACT 2:27" />لأنّكَ يا إلهي لن تَترُكَني في عالمِ الأمواتِ، ولن تَسمَحَ لجَسَدِ عَبدِكَ المُقَدَّسِ أن يَتَعَفَّنَ في القَبرِ. <verse eid="ACT 2:27" /><verse number="28" style="v" sid="ACT 2:28" />يا رَبِّ، قد هَديتَني إلى سَبيلِ الحَياةِ وستَملَؤني فَرَحًا في حُضورِكَ".<verse eid="ACT 2:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="ACT 2:29" />وتابَعَ بُطرُسُ خِطابَهُ قائلاً: "يا إخوتي، أُريدُ أن أوَضِّحَ لكُم أمرًا عَمّا وَرَدَ في الزَّبورِ، إنّ النّبيَّ داود لم يَكُن يَعني نَفسَهُ بهذا الكَلامِ، لأنّهُ قد تُوُفِّي وتَمّ دَفنُهُ، وهذا هو قَبرُهُ ما زالَ هُنا في القُدس. <verse eid="ACT 2:29" /><verse number="30" style="v" sid="ACT 2:30" />وقد كانَ داودُ (عليه السّلام) نَبيًّا، وأقسَمَ اللهُ لهُ بأيمانٍ مُغَلَّظةٍ بأن يَكونَ مِن نَسلِهِ المَسيحُ المُنتَظَرُ الّذي سيَرِثُ عَرشَهُ. <verse eid="ACT 2:30" /><verse number="31" style="v" sid="ACT 2:31" />وقد كَشَفَ اللهُ تَعالى لداودَ عن مُستَقبلِ الأحداثِ، فكانَ أن تَنَبَّأ داودُ (عليه السّلام) ببَعثِ المَسيحِ مِنَ المَوتِ عِندَما ذَكَرَ في الزَّبورِ أنّ اللهَ لن يَترُكَ المَسيحَ بَينَ الأمواتِ إلى يومِ القِيامةِ، ولن يُبلي جَسَدَهُ في القَبرِ. <verse eid="ACT 2:31" /><verse number="32" style="v" sid="ACT 2:32" />فأنا أقولُ لكُم إنّ عيسى (سلامُهُ علينا) هو المَسيحُ المُنتَظَرُ الّذي تَنَبَّأ بِهِ النّبيُّ داود، وبَعَثَهُ اللهُ حَيًّا، وأنا ورِفاقي شُهودٌ على ذلِكَ. <verse eid="ACT 2:32" /><verse number="33" style="v" sid="ACT 2:33" />وبَعدَ أن تَمّ رَفعُهُ إلى السَّماءِ، إلى المَقامِ الرَّفيعِ على يَمينِ اللهِ تَعالى، وَهَبَهُ اللهُ الأبُ الرَّحمنُ رُوحَهُ تَقَدَّسَ وتَعالى حَسَبَ وَعدِهِ، وأفاضَها سَيِّدُنا عيسى بدَورِهِ علينا، ولِهذا السَّبَبِ فإنّ كُلَّ ما تَرَونَهُ بأعيُنِكُم وتَسمَعونَهُ بآذانِكُم الآنَ هو بقوّةِ رُوحِ اللهِ الّتي حَلَّت فينا. <verse eid="ACT 2:33" /><verse number="34" style="v" sid="ACT 2:34" />والنَّبيُّ داود (عليه السّلام) لم يُرفَع إلى السَّماءِ، لكنّهُ حَدَّثَ في الزَّبورِ عنِ المَسيحِ قائلاً: "قالَ اللهُ تَعالى لمَولاي: اجلِس عن يَميني، <verse eid="ACT 2:34" /><verse number="35" style="v" sid="ACT 2:35" />حتّى أقهَرَ أَعدَاءَكَ وأجعَلَهُم تَحتَ قَدمَيكَ صاغِرينَ". <verse eid="ACT 2:35" /><verse number="36" style="v" sid="ACT 2:36" />لهذا السَّبَبِ فليَعلَمْ كُلُّ بَني إسرائيلَ عِلمَ اليَقينِ بأنّ عيسى الّذي صَلَبتُموهُ، هو مَن جَعَلَهُ اللهُ المَسيحَ المَلِكَ وسَيِّدَ البَشَر!"<verse eid="ACT 2:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="ACT 2:37" />وبَعدَ سَماعِ الحاضِرينَ لهذا كُلِّهِ، لانَت قُلوبُهُم، فأخَذوا يَسألونَ بُطرُسَ ومَن مَعَهُ مِنَ الحَوارِيِّينَ قائِلينَ: "أيُّها الإخوانُ، ماذا يَجِبُ علينا أن نَعمَلَ الآنَ؟" <verse eid="ACT 2:37" /><verse number="38" style="v" sid="ACT 2:38" />فأجابَهُم بُطرُسُ الصَّخرُ بقولِهِ: "تُوبوا إلى اللهِ، وليُؤمِنْ كُلٌّ مِنكُم بِسَيِّدِنا عيسى المَسيحِ المُنتَظَرِ، وتَطَهَّروا بالماءِ صِبغةً للهِ حتّى تَستَطيعوا الانضِمامَ إلى جَماعتِهِ، فيَغفِرَ اللهُ ذُنُوبَكُم وتَحصُلوا على هِبَةِ رُوحِهِ تَقَدَّسَ وتَعالى، <verse eid="ACT 2:38" /><verse number="39" style="v" sid="ACT 2:39" />فلقد وَعَدَ اللهُ أن يَهَبَكُم رُوحَهُ، وهو وَعدٌ لأبنائِكُم أيضًا، وللأغرابِ البَعيدينَ كذلِكَ، نَعَم هو ذاكَ، لكُلِّ الّذينَ يَختارُهُم اللهُ ليَكونوا مِن أُمَّتِهِ".<note caller="+" style="f"><char style="fr" closed="false">2‏.39 </char><char style="ft" closed="false">يمثّل نزول روح الله هنا بدْءَ أُمّة الله الجديدة التي تنتمي إلى ميثاقه الجديد. من ذلك الزمن فصاعدًا، أصبح بإمكان كلّ من يؤمن بسيدنا عيسى خليفة الله الوحيد، ويتطهّر بالماء دلالة على انضمامه إلى جماعة المؤمنين، أن يحصل على هبة روح الله، مهما كان أصله. ويشرح الحواريان بولس وبطرس في رسائلهما أنّه من روح الله تنبثق كرامات مختلفة لأعضاء الأُمّة حتّى يستطيع كلّ فرد أن يخدم الأمّة بشكل فريد ويبنيها.</char></note><verse eid="ACT 2:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="ACT 2:40" />وتابَعَ بُطرُسُ دَعوتَهُ إلى رِسالةِ سَيِّدِنا عيسى (سلامُهُ علينا) مِن خِلالِ دَلائلَ وإشاراتٍ أُخرى كَثيرةٍ، ثُمّ أنذَرَهُم بقولِهِ: "أنقِذوا أنفُسَكُم مِنَ العِقابِ الّذي سيَحُلُّ على هذا الشَّعبِ الضّالِّ!" <verse eid="ACT 2:40" /><verse number="41" style="v" sid="ACT 2:41" />وهكذا، استَجابَ لدَعوةِ بُطرُسَ في ذلِكَ اليومِ حَوالي ثَلاثةِ آلافِ شَخصٍ، ونَعِموا بالتَّطَهُّرِ بالماءِ وبالانضِمامِ إلى جَماعةِ المُؤمنينَ، <verse eid="ACT 2:41" /><verse number="42" style="v" sid="ACT 2:42" />وقد واظَبَ هؤلاءِ جَميعًا على تَلَقّي تَعاليمِ الحَواريِّينَ، كَما كانوا دائمًا في تَواصُلٍ أخَوِيٍّ، يَتناوَلونَ مَعًا الخُبزَ، ويُؤدُّونَ مَعًا الصَّلَواتِ. <verse eid="ACT 2:42" /><verse number="43" style="v" sid="ACT 2:43" />وهكذا تَمَّتْ على أيدي هؤلاءِ الحَواريِّينَ صَحابةِ سَيِّدِنا عيسى الكَثيرُ مِنَ المُعجِزاتِ والآياتِ، مِمّا جَعَلَ القُلوبَ تَمتلئ خَوفًا ورَهبةً. <verse eid="ACT 2:43" /><verse number="44" style="v" sid="ACT 2:44" />وكانَ جَميعُ المُؤمنينَ على قَلبٍ واحدٍ، يَتَشارَكونَ في كُلِّ ما يَملِكُونَ، <verse eid="ACT 2:44" /><verse number="45" style="v" sid="ACT 2:45" />يَبيعونَ أراضِيَهُم ومُمتَلكاتِهم لِيُوَزَّعَ ثَمَنُها على ذَوي الحاجَةِ مِنهُم. <verse eid="ACT 2:45" /><verse number="46" style="v" sid="ACT 2:46" />وكانَ للمُؤمنينَ لقاءَاتُهُم واجتِماعاتُهُم في حَرَمِ بيتِ اللهِ يَوميًّا، إلاّ أنّهُم كانوا يَجتَمِعونَ في بُيوتِهِم لتَناوُلِ الخُبزِ والطَّعامِ،<note caller="+" style="f"><char style="fr" closed="false">2‏.46 </char><char style="ft" closed="false">هذه إشارة إلى أنّهم كانوا يتناولون عشاءً خاصًا يستعيدون فيه صورة عشاء السيد المسيح الأخير، الذي يذكّرهم دائمًا بتضحيته من أجل أمّته.</char></note> ويَتَشاركونَ بِكَرمٍ في طَعامِهِم فَرِحينَ. <verse eid="ACT 2:46" /><verse number="47" style="v" sid="ACT 2:47" />وكانوا دائمًا يُسَبِّحونَ اللهَ مُتَعَبِّدينَ، مِمّا جَعَلَهُم مَحلَّ رِضا النَّاسِ أجمَعينَ، وكان اللهُ تَعالى يَهدي في كُلِّ يومٍ المَزيدَ مِنَ النّاسِ إلى الإيمانِ بالسَّيِّدِ المَسيحِ، أولئكَ الّذينَ مَنَّ عليهِم بالفَوزِ والنَّجاةِ.<verse eid="ACT 2:47" /></para>
  <chapter eid="ACT 2" />
  <chapter number="3" style="c" sid="ACT 3" />
  <para style="cl">الفصل الثّالث</para>
  <para style="s">شفاء رجل كسيح</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 3:1" />وذَهَبَ بُطرُسُ ويوحنّا، ذاتَ يومٍ، إلى الحَرَمِ الشَّريفِ لأداءِ صَلاةِ العَصرِ،<note caller="+" style="f"><char style="fr" closed="false">3‏.1 </char><char style="ft" closed="false">كان اليهود يؤدّون صلواتهم في أوقات معيّنة يوميًّا في منازلهم. فالنبي دانيال، على سبيل المثال، كان يقيم ثلاث صلوات يوميًا في داره (دانيال 6: 10). اثنتان منها متزامنتان مع وقت تقديم الأضاحي في حرم بيت الله في القدس، صباحًا وحوالي الثالثة عصرًا، وأمّا الصلاة الثالثة فكان يقيمها ظهرًا في داره. وقد كان لليهود صلاة خاصة ببعض المناسبات يقيمونها في حرم بيت الله.</char></note> <verse eid="ACT 3:1" /><verse number="2" style="v" sid="ACT 3:2" />وإذا بِبَعضِ النّاسِ يَحمِلونَ رَجُلاً كَسيحًا مُنذُ وِلادتِهِ، كانوا يَضَعونَهُ كُلَّ يومٍ عِندَ بابِ الحَرَمِ - البابِ الجَميل- لاستِجداءِ الدّاخِلينَ.<note caller="+" style="f"><char style="fr" closed="false">3‏.2 </char><char style="ft" closed="false">كان لا يحقُّ لليهود المعاقين دخول ساحة بني يعقوب من حرم بيت الله، بل كان مسموحا لهم أن يدخلوا ساحة غير اليهود في الحرم.</char></note> <verse eid="ACT 3:2" /><verse number="3" style="v" sid="ACT 3:3" />وعِندَما وَقَعَ نَظَرُهُ على بُطرُسَ ويوحنّا طَلَبَ مِنهُما صَدَقةً، <verse eid="ACT 3:3" /><verse number="4" style="v" sid="ACT 3:4" />ولكنّهُما تَفَرَّسا في وَجهِ الرَّجُلِ، ثُمَّ قالَ لهُ بُطرُسُ: "اُنظُرْ إلينا!" <verse eid="ACT 3:4" /><verse number="5" style="v" sid="ACT 3:5" />ونَظَرَ إليهِما الرَّجُلُ ظانًّا أنّهُ سيَحظى بعَطِيةٍ، <verse eid="ACT 3:5" /><verse number="6" style="v" sid="ACT 3:6" />ولكنَّ بُطرُسَ خاطَبَهُ قائلاً: "لَيسَ لديّ مِن فِضَّةٍ ولا ذَهَبٍ، ولكن سأُعطيكَ ما عِندي: باسمِ عيسى المَسيحِ النَّاصِريّ انهَضْ ماشيًا على قَدَمَيكَ!" <verse eid="ACT 3:6" /><verse number="7" style="v" sid="ACT 3:7" />وأمسَكَ بيَدِهِ اليُمنى فأجلسَهُ، وحالاًّ سَرَتِ العافيةُ في قَدَمَيِ الرَّجُلِ وكَعبَيهِ، <verse eid="ACT 3:7" /><verse number="8" style="v" sid="ACT 3:8" />فقَفَزَ واقفًا وأخَذَ يَخطو، ودَخَلَ مَعَهُما حَرَمَ بَيتِ اللهِ ماشيًا تارةً وقافِزًا تارةً أُخرى فَرَحًا، مُسَبِّحًا للهِ، <verse eid="ACT 3:8" /><verse number="9" style="v" sid="ACT 3:9" />فرآهُ جَميعُ مَن كانَ في الحَرَمِ ماشيًا مُسبِّحًا شاكِرًا اللهَ، <verse eid="ACT 3:9" /><verse number="10" style="v" sid="ACT 3:10" />وقد عَرَفوا أنّهُ ذلِكَ المُتَسَوِّلُ الّذي كانَ يَجلِسُ باستِمرارٍ عِندَ البابِ الجَميلِ، فأصَابَتهُم الدَّهشةُ والذُّهولُ.<verse eid="ACT 3:10" /></para>
  <para style="s">بطرس يوضّح ما حصل</para>
  <para style="p">
    <verse number="11" style="v" sid="ACT 3:11" />وبَينَما كانَ ذلِكَ الرَّجُلُ يُلازِمُ بُطرُسَ ويوحنّا في قاعةِ سُليمانَ في الحَرَمِ الشَّريفِ، أخَذَ النّاسُ يَتَوافَدونَ عليهِم وعلى وُجوهِهِم عَلاماتُ التَّعَجُّبِ والذُّهولِ، <verse eid="ACT 3:11" /><verse number="12" style="v" sid="ACT 3:12" />ولمّا لاحَظَ بُطرُسُ ذلِكَ، تَوَجَّهَ إليهِم قائِلاً: "يا بَني يَعقوبَ، لِمَ أخَذَ مِنكُم العَجَبُ هذا المأخذَ؟ ولِمَ تُحَدِّقونَ بنا كَما لو أنّنا بِقُدرتِنا أو بِتَقوانا جَعَلنا هذا الكَسيحَ يَمشي؟ <verse eid="ACT 3:12" /><verse number="13‏-16" style="v" sid="ACT 3:13-16" />هذا الرَّجُلُ الّذي تَعرِفونَهُ لم يَتَعافَ أمامَكُم إلاّ بِشَفاعةِ سَيِّدِنا عيسى، الّذي آمَنّا بِهِ وطَلَبنا مِنهُ الشِّفاءَ تَمجيدًا لهُ. عيسى الّذي قَبَضتُم عليهِ وسَلَّمتُموهُ إلى الحاكمِ الرُّومانيّ بيلاطُسَ لإعدامِهِ. ومَعَ أنّ بيلاطُسَ قَرَّرَ إطلاقَ سَراحِهِ، فأنتُم رَفَضتُم المَسيحَ المُصطَفى الصّالِحَ، وآثَرتُم طَلَبَ العَفوِ عن سَفّاكِ دِماءٍ! نَعَم، أنتُم مَن قُمتُم بقَتلِ مَن يَقودُ النّاسَ إلى دارِ الخُلدِ، إلاّ أنّ اللهَ تَعالى بَعَثَهُ حيًّا، ونحنُ على ذلِكَ شُهودٌ. أقولُ لكُم إنّ اللهَ رَبَّ آبائِنا الأوّلينَ، إبراهيمَ وإسحقَ ويَعقوبَ، رَفَعَ مِن شأنِ عَبدِهِ عيسى.<verse eid="ACT 3:13-16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="ACT 3:17" />أيُّها الإخوانُ، أنا على عِلمٍ بأنّ كُلَّ ما اقترَفتُموهُ مِن أعمالٍ، أنتُم وقادتُكُم، إنّما كانَ عَن جَهلٍ. <verse eid="ACT 3:17" /><verse number="18" style="v" sid="ACT 3:18" />ولكنّ اللهَ نَفّذَ وَعدَهُ لِقاءَ أعمالِكُم الّتي تَنَبَّأ بِها جَميعُ الأنبياءِ وهي أنّهُ لا بُدَّ للمَسيحِ المُختارِ أن يُقاسي كُلَّ تِلكَ الآلامِ، <verse eid="ACT 3:18" /><verse number="19" style="v" sid="ACT 3:19" />فأقلِعوا عنِ الأعمالِ السَّيِّئةِ، وأنيبوا إلى اللهِ يَغفِرْ لكُم ذُنوبَكُم، <verse eid="ACT 3:19" /><verse number="20" style="v" sid="ACT 3:20" />ويَأتيكُم الفَرَجُ مِن عِندِهِ، فيُرسِلَ إليكُم المَسيحَ المَلِكَ الّذي اختارَهُ لكُم، وهو عيسى، <verse eid="ACT 3:20" /><verse number="21" style="v" sid="ACT 3:21" />الّذي يَجِبُ أن يَبقى في السّماءِ إلى أن يَحينَ زَمَنُ تَجديدِ كُلِّ شَيءٍ. إنّ هذا ما أوحَى اللهُ بِهِ قَديمًا إلى أنبيائِهِ الصّالحِينَ، <verse eid="ACT 3:21" /><verse number="22" style="v" sid="ACT 3:22" />فقد تَنَبَّأ النَّبيُّ موسى (عليه السّلام) قائلاً: "سيَبعَثُ اللهُ مِن بَينِ شَعبِكُم نَبيًّا مِثلي، وعليكُم طاعتَهُ فيما يَقولُهُ، <verse eid="ACT 3:22" /><verse number="23" style="v" sid="ACT 3:23" />وكُلُّ عاصٍ لهُ، يَجِبُ أن يُطرَدَ ويَموتَ بَعيدًا عن أُمّةِ اللهِ". <verse eid="ACT 3:23" /><verse number="24" style="v" sid="ACT 3:24" />وبَعدَ عَهدِ النَّبيِّ موسى، تَنَبَّأ جَميعُ الأنبياءِ، بَدءًا مِنَ النَّبيّ صَموئِيلَ ومَن جاؤوا بَعدَهُ تِباعًا، بالأحداثِ الّتي تَجرِي في هذِهِ الأيّام. <verse eid="ACT 3:24" /><verse number="25" style="v" sid="ACT 3:25" />فأنتُم وَرَثَةُ الأنبياءِ، ووَرَثةُ المِيثاقِ الّذي أعطاهُ اللهُ لآبائِكُم الأوّلينَ. وهذا ما أخبَرَ اللهُ بِهِ النَّبيَّ إبراهيمَ (عليه السّلام): "بفَضلِ واحدٍ مِن نَسلِكَ سيَعُمُّ جُودي على كُلِّ شُعوبِ الأرضِ". <verse eid="ACT 3:25" /><verse number="26" style="v" sid="ACT 3:26" />فيا بَني يَعقوبَ، إنّ اللهَ اختارَ عَبدَهُ عيسى فأرسَلَهُ إليكُم أنتُم أوّلاً، قَبلَ بَقيَّةِ البَشَرِ، حتّى تَعُمَّ بَرَكاتُهُ عليكُم فيَتوبَ كُلُّ واحدٍ مِنكُم عن آثامِهِ".<verse eid="ACT 3:26" /></para>
  <chapter eid="ACT 3" />
  <chapter number="4" style="c" sid="ACT 4" />
  <para style="cl">الفصل الرّابع</para>
  <para style="s">بطرس ويوحنّا يحاكمان</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 4:1" />وهكذا، بَينَما كانَ بُطرُسُ الصَّخرُ ويوحَنّا يُحدّثانِ الجُموعَ، أقبَلَ عليهِما بَعضُ الأحبارِ برِفقةِ قائدِ حَرَسِ بَيتِ اللهِ وبَعضِ الرِّجالِ مِن جَماعةِ الصَّدّوقيّينَ.<note caller="+" style="f"><char style="fr" closed="false">4‏.1 </char><char style="ft" closed="false">كانت مهمّة الأحبار تنحصر في تأدية العبادات في حرم بيت الله مثل تقديم الأضحيات. وقد كان مسموحًا لليهود، في زمن الاحتلال الروماني، تعيين من يحرس حرم بيت الله، إضافةً إلى إقامة النظام فيه والتأكّد من محافظة الزوّار على القوانين المتبّعة في الحرم المقدّس. وكان رئيس الحرس ينحدر من عائلات رجال الدين، حيث كان له شأن عظيم يقارب شأن كبير الأحبار. أمّا بالنسبة إلى حزب الصدّوقيين فقد كانوا فئة ثريّة من اليهود متحالفة مع كبير الأحبار والسلطة الحاكمة. وكانوا يعلّمون الناس أنّ تقديم الأضحيات وتأدية العبادات في الحرم الشريف من أهمّ أمور الحياة. وهذا يخالف تعاليم جماعة المتشدّدين (الفريسيين) الذين كانوا يؤمنون بأنّ تطبيق تعاليم التوراة بأسلوب فعّال هو أهمّ من تفاصيل العبادات في الحرم.</char></note> <verse eid="ACT 4:1" /><verse number="2" style="v" sid="ACT 4:2" />وقد أصابَهُم ضِيقٌ شَديدٌ مِن جَرّاءِ الدَّعوةِ الّتي يَنشُرُها تِلمِيذا سَيِّدِنا عيسى بَينَ الجُموعِ ومَفادُها أنّ قيامَ عيسى (سلامُهُ علينا) بَعدَ الموتِ دَليلٌ على أنّ جَميعَ المَوتى سيَقومونَ في الآخِرة،<note caller="+" style="f"><char style="fr" closed="false">4‏.2 </char><char style="ft" closed="false">كانت جماعة الصدّوقيين تنكر البعث والنشور. وكان قول الحواريين بالبعث والنشور تحدّيًا لهم ولرؤساء الأحبار الذين كانوا يدعمونهم. وجاءت عودة سيدنا عيسى للحياة بمثابة تصديق لدعوة الحواريين تلك وبرهانًا على خطإ تعاليم الصدّوقيين، وهو ما يقلّل من عدد أتباع هؤلاء.</char></note> <verse eid="ACT 4:2" /><verse number="3" style="v" sid="ACT 4:3" />فقَبَضَ الأحبارُ ومُرافِقوهُم على بُطرُسَ ويوحنّا ووَضَعوهُما في السِّجنِ إلى مَساءِ اليَومِ التّالي. <verse eid="ACT 4:3" /><verse number="4" style="v" sid="ACT 4:4" />ولكنّ كَثيرًا مِمَّن سَمِعوا بالرِّسالةِ آمَنوا بها، فبَلَغَ عَدَدُ المُؤمنينَ بالمَسيحِ نَحوَ خَمسَةِ آلافٍ، دونَ النِّساءِ والأطفالِ.<verse eid="ACT 4:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="ACT 4:5" />ومَعَ طُلوعِ فَجرِ اليومِ التّالي، انعَقَدَ مَجلِسُ قادةِ اليَهودِ والمَشايخِ والفُقهاءِ في القُدسِ <verse eid="ACT 4:5" /><verse number="6" style="v" sid="ACT 4:6" />بحُضورِ حَنّا كَبيرِ الأحبارِ وقَيافا ويوحَنّا وإسكَندر وغَيرِهِم مِنَ المُنتَمينَ إلى عائلةِ كَبيرِ الأحبارِ. <verse eid="ACT 4:6" /><verse number="7" style="v" sid="ACT 4:7" />وَأُحضِرَ بُطرُسُ ويوحنّا ليَقفا أمامَهُم وليَستجوِبوهُما قائلينَ: "بأيِّ حَقٍّ أو بأيِّ اسمٍ عَمِلتُما هذا؟" <verse eid="ACT 4:7" /><verse number="8" style="v" sid="ACT 4:8" />فأجابَهُم بُطرُسُ الصّخرُ وهو مُفعَمٌ برُوحِ اللهِ قائلاً: "يا قادةَ الشَّعبِ ومَشايِخَهِ، <verse eid="ACT 4:8" /><verse number="9" style="v" sid="ACT 4:9" />هل تَستجوِبونَنا اليومَ عَن مَعروفٍ كانَ مِنّا لمَريضٍ؟ هل تُريدونَ الوُقوفَ على السِّرِّ وَراءَ شِفائِهِ؟ <verse eid="ACT 4:9" /><verse number="10" style="v" sid="ACT 4:10" />إذن، اعلَموا جَميعًا وليَعلَمْ كُلُّ أبناءِ بَني يَعقوبَ أنّ هذا الرَّجُلَ إنّما يَقِفُ الآنَ أمامَكُم مُعافىً بقوَّةِ اسمِ عيسى النّاصريّ، المَسيحِ المُخَلِّصِ المُختارِ الّذي قُمتُم أنتُم بصَلبِهِ، ولكنّ اللهَ بَعَثَهُ حَيًّا! <verse eid="ACT 4:10" /><verse number="11" style="v" sid="ACT 4:11" />وإنّ عيسى هو مَن جاءَ ذِكرُهُ في الزَّبورِ عِندَ الحَديثِ عنِ الحَجَرِ الّذي رَفَضتُموهُ أيُّها البُناة، وهو الّذي صارَ حَجَرَ الأساسِ في بَيتِ اللهِ! <verse eid="ACT 4:11" /><verse number="12" style="v" sid="ACT 4:12" />فاعلَموا أنّهُ لا نَجاةَ إلاّ بِسَيِّدِنا عيسى، فلَيسَ مِن أحَدٍ في كُلِّ العالَمِ سِواهُ خَصَّهُ اللهُ بإنقاذِ النّاسِ".<verse eid="ACT 4:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="ACT 4:13" />وعِندَما أحَسَّ أعضَاءُ المَجلِسِ بجُرأةِ بُطرُسَ ويوحنّا وشَجاعتِهِما، وكانوا يَعلَمونَ أنّهُما مِن عامّةِ الشَّعبِ وأنّهُما على غَيرِ دِرايةٍ بالعُلومِ الشَّرعيّةِ، أخَذَهُم العَجَبُ وأدرَكوا أنّهُما مِن صَحابةِ عيسى (سلامُهُ علينا) حقًّا. <verse eid="ACT 4:13" /><verse number="14" style="v" sid="ACT 4:14" />وحُبِسَت ألسنِتُهُم عنِ الإجابةِ، إذ بِماذا يُجيبونَ والرَّجُلُ الكَسيحُ المُعافى واقِفٌ أمامَهُم؟! <verse eid="ACT 4:14" /><verse number="15" style="v" sid="ACT 4:15" />فصَرَفوهُم مِن مَجلِسِهِم ليَتَشاوروا فيما بَينَهُم، <verse eid="ACT 4:15" /><verse number="16" style="v" sid="ACT 4:16" />وقالوا: "ما نَحنُ فاعِلونَ بهَذينِ الرَّجُلينِ؟ وكُلُّ سُكّانِ القُدسِ يَعلَمونَ الآنَ بما فَعَلاهُ للرَّجُلِ الكَسيحِ. إنّ ما فَعَلاهُ لَمُعجِزةٌ عَظيمةٌ لا سَبيلَ لإنكارِها. <verse eid="ACT 4:16" /><verse number="17" style="v" sid="ACT 4:17" />ولكنّنا سنُهَدِّدُهُما ونُرَوِّعُهُما حتّى لا يَذكُرَا اسمَ عيسى مُطلقًا في حَديثِهِما لكي لا تَنتَشِرَ الدَّعوةُ بَينَ النّاسِ ويَنفَرِطَ الأمرُ مِن بَينِ أيدينا!"<verse eid="ACT 4:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="ACT 4:18" />وأحضَرُوهُما وأمَرُوهُما بعَدمِ الحَديثِ عن عيسى (سلامُهُ علينا) أمامَ النّاسِ، ولا عَمّا كانَ يُعَلِّمُهُ. <verse eid="ACT 4:18" /><verse number="19" style="v" sid="ACT 4:19" />ولكنّ بُطرُسَ ويوحنّا أجابا قائلَينِ: "اُحكُموا أنتُم! ألكُم تَجوزُ الطّاعة، أم للهِ؟ <verse eid="ACT 4:19" /><verse number="20" style="v" sid="ACT 4:20" />أمّا نحنُ، فلا نَستَطيعُ الصَّمتَ، وسنُعلنُ ما رأينا وسَمِعنا". <verse eid="ACT 4:20" /><verse number="21" style="v" sid="ACT 4:21" />فهَدَّدَهُما رِجالُ المَجلِسِ مَرّةً أُخرى، ولكنّهُم حاروا كَيفَ يُعاقبُونَهُما، فأخلَوا سَبيلَهُما، لأنّهُم خافوا مِن إثارةِ الجُموعِ الّتي كانَت تُسَبِّحُ للهِ مِن عُمقِ القَلبِ بسَبَبِ هذِهِ المُعجِزةِ، <verse eid="ACT 4:21" /><verse number="22" style="v" sid="ACT 4:22" />ذلِكَ لأنّ الرَّجُلَ الّذي شُفي كانَ مُقعَدًا لأكثرَ مِن أربعينَ سَنةً.<verse eid="ACT 4:22" /></para>
  <para style="s">صلاة المؤمنين</para>
  <para style="p">
    <verse number="23" style="v" sid="ACT 4:23" />ورَجَعَ بُطرُسُ ويوحنّا إلى أصحابِهِما المُؤمِنينَ بَعدَ إطلاقِ سَراحِهِما، وأسَرّا لهُم بكُلِّ ما جَرى على لِسانِ كِبارِ الأحبارِ والمَشايخِ مِن أقوالٍ، <verse eid="ACT 4:23" /><verse number="24" style="v" sid="ACT 4:24" />وعِندَ سمَاعِهِم ذلِكَ، اتّجَهوا بتَضَرُّعاتِهِم إلى اللهِ جاهِرينَ بالدُّعاءِ قائلينَ: "يا رَبُّ يا خالِقَ السَّماواتِ والأرضِ وما بَينَهُما، <verse eid="ACT 4:24" /><verse number="25" style="v" sid="ACT 4:25" />يا مَن أوحَيتَ إلى عَبدِكَ النّبيِّ داود بواسِطةِ رُوحِكَ القُدّوسِ بالكَلامِ التّالي: "لِماذا ثارَتِ الأُمَمُ على اللهِ؟ لِمَ تآمَروا بالباطلِ على حُكمِهِ؟ <verse eid="ACT 4:25" /><verse number="26" style="v" sid="ACT 4:26" />واستَنفَرَت مُلوكُ الأرضِ، واجتَمَعَ حُكّامُها جَبهةً واحِدةً ضِدَّ اللهِ ومَسيحِهِ المُختارِ!" <verse eid="ACT 4:26" /><verse number="27" style="v" sid="ACT 4:27" />ولقد تَحَقّقَت نُبوءةُ النّبيِّ داود تِلكَ هُنا في مَدينةِ القُدس، حَيثُ اجتَمَعَ الأميرُ أنتيباسُ بِن هيرودُس والحاكمُ بيلاطُس البُنطيّ مَعَ الأجانبِ ومَعَهُم بَنو إسرائيلَ جَبهةً واحِدةً ضِدَّ عَبدِكَ المُقَدَّسِ عيسى الّذي اصطَفيتَهُ ليَكونَ مَلِكًا، <verse eid="ACT 4:27" /><verse number="28" style="v" sid="ACT 4:28" />ونَفَّذوا كُلَّ ما نَفَّذوهُ مِن أعمالٍ بقَدرِكَ وبقُدرَتِكَ القاهِرةِ! <verse eid="ACT 4:28" /><verse number="29" style="v" sid="ACT 4:29" />يا رَبُّ إنّهُم في تَهديدِنا الآنَ ماضونَ، فأمِدَّنا نَحنُ عِبادَكَ بالقوّةِ لإعلانِ رِسالتِكَ دونَ وَجَلٍ، <verse eid="ACT 4:29" /><verse number="30" style="v" sid="ACT 4:30" />وامنَحنا القُدرةَ على شِفاءِ المَرضَى وإجراءِ مُعجِزاتٍ وعَجائبَ بشَفاعةِ عَبدِكَ المُقَدَّسِ عيسى".<verse eid="ACT 4:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="ACT 4:31" />وبَعدَ فَراغِهِم مِنِ ابتِهالاتِهِم، سَرَت، حَيثُ كانوا مُجتَمِعينَ، هَزّةٌ، وغَمَرَهُم بَعدَها فَيضٌ مِن رُوحِ اللهِ، وانطَلَقوا إثرَ ذلِكَ يُعلنونَ بِجُرأةٍ رِسالةَ اللهِ في الأرجاءِ.<verse eid="ACT 4:31" /></para>
  <para style="s">المؤمنون يتشاركون في ممتلكاتهم</para>
  <para style="p">
    <verse number="32" style="v" sid="ACT 4:32" />وهكذا كانَ جَميعُ المُؤمنينَ بِهِ (سلامُهُ علينا) على قَلبٍ واحدٍ وفِكرٍ واحدٍ، ولم يَكُن أحَدٌ مِنهُم يَستأثرُ بما يَملِكُ، إذ أضحَت مُمتلكاتُهُم مُشاعةً بَينَهُم جَميعًا. <verse eid="ACT 4:32" /><verse number="33" style="v" sid="ACT 4:33" />واستَمَرَّ الحَواريّونَ في تَقديمِ شَهاداتِهِم حَولَ قيامةِ سَيِّدِنا عيسى (سلامُهُ علينا) مِنَ الموتِ، وقد كانَ لها تأثيرُها الكَبيرُ. وأفاضَ اللهُ عليهِم مِن فَضلِهِ وبَرَكتِهِ، <verse eid="ACT 4:33" /><verse number="34" style="v" sid="ACT 4:34" />فلم يَبقَ فيهِم مُحتاجٌ أو مُعوِزٌ، لأنّ الّذينَ يَملِكونَ الأراضيَ أوِ البُيوتَ كانوا يَبيعُونَها، ويأتونَ بثَمَنِها <verse eid="ACT 4:34" /><verse number="35" style="v" sid="ACT 4:35" />ويَضَعونَهُ في تَصَرُّفِ الحَواريِّينَ الاثنَي عَشَرَ فيُوَزِّعُونَهُ بدورِهِم على المُؤمنينَ كُلٌّ حَسَبَ حاجتِهِ. <verse eid="ACT 4:35" /><verse number="36‏-37" style="v" sid="ACT 4:36-37" />حتّى إنّ يوسِفَ القُبرُصيَّ وهو مِن قَبيلةِ لاوي، كانَ لَدَيهِ حَقلٌ، فباعَهُ وجاءَ بثَمَنِهِ إلى الحَواريِّينَ. وكانَ الحَواريّونَ يُطلِقونَ عليهِ لَقَبَ "بَرنابا"، يَعني الرَّجُلَ المُشجِّعَ الّذي يَشُدُّ عَزيمةَ النّاسِ.<verse eid="ACT 4:36-37" /></para>
  <chapter eid="ACT 4" />
  <chapter number="5" style="c" sid="ACT 5" />
  <para style="cl">الفصل الخامس</para>
  <para style="s">حنانيّا وسفيرة</para>
  <para style="p">
    <verse number="1‏-2" style="v" sid="ACT 5:1-2" />وكانَ مِن بَينِ المُؤمنينَ زَوجانِ، حَنانيّا وسَفيرة، فباعَ الزَّوجُ حَنانيّا قِطعةَ أرضٍ كانا يَمتلِكانِها، واحتَفَظَ بجُزءٍ مِن ثَمَنِها، بمُوافقةِ زَوجتِهِ، ودَفَعَ بالجُزءِ الآخَرِ إلى الحَواريِّينَ زاعِمًا أنّهُ كُلُّ ثَمَنِ الأرضِ. <verse eid="ACT 5:1-2" /><verse number="3" style="v" sid="ACT 5:3" />فقالَ لهُ بُطرُسُ الصَّخرُ: "يا حَنانيّا، لِمَ مَلأ الشَّيطانُ قَلبَكَ فجَعَلكَ تَكذِبُ على رُوحِ اللهِ، فتَحتَفِظَ لنَفسِكَ بجُزءٍ مِن ثَمَنِ الأرضِ؟ <verse eid="ACT 5:3" /><verse number="4" style="v" sid="ACT 5:4" />لقد كانَ لكَ ما تَملِكُ قَبلَ بَيعِهِ، وبَعدَ أن بِعتَهُ كانَ ثَمَنُهُ تَحتَ تَصَرُّفِكَ أيضًا، فلِماذا أضمَرتَ خِلافَ ما أظهَرتَ للنّاسِ؟ إنّكَ لا تَكذِبُ على النّاسِ فَقَط بل على اللهِ أيضًا!" <verse eid="ACT 5:4" /><verse number="5" style="v" sid="ACT 5:5" />وعِندَما سَمِعَ حَنانيّا عِتابَ بُطرُسَ وَقَعَ على الفورِ مَيتًا، وأصابَ كُلَّ مَن سَمِعَ بهذا الخَبَرِ وُجومٌ وخَوفٌ شَديدانِ. <verse eid="ACT 5:5" /><verse number="6" style="v" sid="ACT 5:6" />وحَضَرَ، إثرَ ذلِكَ، بَعضُ الشُّبّانِ ليُكَفّنوا حَنانيّا ويَدفِنوهُ، <verse eid="ACT 5:6" /><verse number="7" style="v" sid="ACT 5:7" />وبَعدَ نَحوِ ثَلاثِ ساعاتٍ، جاءَت سَفيرةُ زَوجةُ حَنانيّا وهي لم تَكُن على عِلمٍ بما جَرى لزَوجِها، <verse eid="ACT 5:7" /><verse number="8" style="v" sid="ACT 5:8" />فسألَها بُطرُسُ قائلاً: "أخبِريني! أبهذا الثَّمَنِ بِعتُما قِطعةَ الأرضِ؟" فأجابَتهُ قائلةً: "نَعَم، هو ذاكَ المَبلَغُ كُلُّهُ". <verse eid="ACT 5:8" /><verse number="9" style="v" sid="ACT 5:9" />فقالَ لها بُطرُسُ: "كَيفَ لكُما أنتِ وزَوجِكَ أن تُراوِغا رُوحَ اللهِ؟ اُنظُري أمامَكِ واعلَمي أنّ الّذينَ دَفَنوا جُثّةَ زَوجِكِ هم في البابِ الآنَ، وسَيَحملونَكِ أنتِ أيضًا للدَّفنِ!" <verse eid="ACT 5:9" /><verse number="10" style="v" sid="ACT 5:10" />فوَقَعَت سَفيرةُ على الفورِ عِندَ قَدَمي بُطرُسَ مَيتةً. ودَخَلَ الشُّبّانُ فوَجَدوها قد فارَقَتِ الحَياةَ، فحَمَلوها بَعدَ تَكفينِها ودَفَنوها بقُربِ زَوجِها. <verse eid="ACT 5:10" /><verse number="11" style="v" sid="ACT 5:11" />فأصابَت جَميعَ المؤمنينَ رَهبةٌ وخُشوعٌ بَعدَ سَماعِهِم ما جَرى.<verse eid="ACT 5:11" /></para>
  <para style="s">الحواريّون والمعجزات الّتي جرت على أيديهم</para>
  <para style="p">
    <verse number="12" style="v" sid="ACT 5:12" />وهكذا جَرَت على أيدي الحَواريِّينَ آياتٌ ومُعجِزاتٌ كَثيرةٌ على مَرأى ومَسمَعٍ مِن الكَثيرينَ. وكانَت قاعةُ سُليمانَ في الحَرَمِ الشَّريفِ مَكانَ اجتِماعِهِم، <verse eid="ACT 5:12" /><verse number="13" style="v" sid="ACT 5:13" />أمّا بَقيّةُ المؤمنينَ فلم يَجرؤ أن يَنضَمَّ إليهِم هُناكَ، مَعَ أنّهُم كانوا مَحلَّ احتِرامِ النّاسِ. <verse eid="ACT 5:13" /><verse number="14" style="v" sid="ACT 5:14" />ورَغمَ ذلِكَ أخَذَ عَدَدُ المُؤمِنينَ بِهِ (سلامُهُ علينا) رِجالاً ونِساءً يَتَزايدُ. <verse eid="ACT 5:14" /><verse number="15" style="v" sid="ACT 5:15" />وبسَبَبِ مُعجِزاتِ الحَواريِّينَ، كانَ النّاسُ يَحمِلونَ مَرضاهُم ويَضَعونَهُم على نَواصي الشَّوارعِ مُوَسِّدينَ إيّاهُم فِراشًا أو حَصيرًا، لَعَلَّ بُطرُسَ عِندَ مُرورِهِ يُلقي ولو بِظِلِّهِ على المَريضِ فيُشفى. <verse eid="ACT 5:15" /><verse number="16" style="v" sid="ACT 5:16" />وهكذا كانَ النّاسُ في القُرى والمَناطِقِ المُجاوِرةِ للقُدسِ يأتونَ أفواجًا بمَرضاهُم وبمَن أصابَهُم مَسٌّ مِنَ الشَّياطينِ والجِنِّ فيُبرَؤونَ جَميعًا.<verse eid="ACT 5:16" /></para>
  <para style="s">الحواريّون واضطهاد اليهود لهم</para>
  <para style="p">
    <verse number="17" style="v" sid="ACT 5:17" />وبسَبَبِ كُلِّ ذلِكَ امتَلأ قَلبُ كَبيرِ الأحبارِ ومَن كانوا مِن حِزبِ الصَّدّوقيّينَ حَسَدًا وغَيظًا، <verse eid="ACT 5:17" /><verse number="18" style="v" sid="ACT 5:18" />فقَبَضوا على الحَواريِّينَ وزَجُّوا بِهِم في السِّجنِ العُموميّ. <verse eid="ACT 5:18" /><verse number="19" style="v" sid="ACT 5:19" />ولكنّ مَلاكًا أتاهُم ليلاً وفَتَحَ أبوابَ السِّجنِ، وأمَرَهُم قائلاً: <verse eid="ACT 5:19" /><verse number="20" style="v" sid="ACT 5:20" />"انطَلِقوا إلى الحَرَمِ الشَّريفِ واصدَعوا برِسالةِ اللهِ الّتي فيها نَجاةُ النّاسِ وحَياتُهُم". <verse eid="ACT 5:20" /><verse number="21" style="v" sid="ACT 5:21" />فنَفَّذوا ما أمَرَهُم المَلاكُ بِهِ، وتَوَجَّهوا فَجرًا إلى الحَرَمِ الشَّريفِ، يَدعونَ النّاسَ إلى رِسالةِ اللهِ.<verse eid="ACT 5:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="ACT 5:22" />واستَدعى كَبيرُ الأحبارِ وجَماعتُهُ مَجلِسَهُم الأعلى، وهو مَجلِسُ شُيوخِ بَني يَعقوبَ،<note caller="+" style="f"><char style="fr" closed="false">5‏.22 </char><char style="ft" closed="false">لقد سمح الرومان لليهود بتشكيل مجلس مؤلّف من كبير أحبارهم وغيره من الأحبار، ومن الأعيان للنظر في قرارات تهمّ عامتهم في شؤونهم الحياتيّة.</char></note> آمِرينَ الحَرَسَ بإحضارِ الحَواريِّينَ مِنَ السِّجنِ. <verse eid="ACT 5:22" /><verse number="23" style="v" sid="ACT 5:23" />وعِندَما وَصَلوا إلى السِّجنِ لم يَجِدوهُم. فرَجَعوا قائلينَ: "لقد وَجَدنا أبوابَ السِّجنِ مُقفَلةً بإحكامٍ والحَرَسَ المُناوَبينَ هُناكَ واقفينَ، ولكن عِندَ فَتحِ الأبوابِ لم نَجِد لهُم أثرًا!" <verse eid="ACT 5:23" /><verse number="24" style="v" sid="ACT 5:24" />وأصابَت قائدَ حَرَسِ بَيتِ اللهِ ورُؤساءِ الأحبارِ حَيرةٌ بسَبَبِ هذا الخَبَرِ فقالوا: "وكَيفَ يَكونُ ذلِكَ؟! تُرى ماذا جَرى هُناكَ؟" <verse eid="ACT 5:24" /><verse number="25" style="v" sid="ACT 5:25" />عِندئذٍ حَضَرَ مَن أخبَرَهُم قائلاً: "إنّ الرِّجالَ الّذينَ أودَعتُموهمُ السِّجنَ البارحةَ هُم في الحَرَمِ الشَّريفِ الآنَ، يَنشُرونَ دَعوتَهُم!" <verse eid="ACT 5:25" /><verse number="26" style="v" sid="ACT 5:26" />فذَهَبَ قائدُ الحَرَسِ ورِجالُهُ إلى هُناكَ، واقتادوا الحَواريِّينَ بلُطفٍ إلى المَجلِسِ المُنعَقِدِ خَوفًا مِن غَضَبِ الجَماهيرِ. <verse eid="ACT 5:26" /><verse number="27" style="v" sid="ACT 5:27" />ودَخَلَ الحَواريّونَ ووَقَفوا أمامَ المَجلِسِ فقالَ كَبيرُ الأحبارِ يَستَجوِبُهُم: <verse eid="ACT 5:27" /><verse number="28" style="v" sid="ACT 5:28" />"أمَرناكُم بألاّ تُعَلِّموا النّاسَ عن عيسى هذا، إلاّ أنّكُم خالفتُم الأوامِرَ، ونَشَرتُم دَعوتَكُم في جَميعِ أرجاءِ القُدسِ، وأنتُم تُلقونَ مَسؤوليّةَ قَتلِ هذا الرَّجُلِ علينا!" <verse eid="ACT 5:28" /><verse number="29" style="v" sid="ACT 5:29" />فأجابَ بُطرُسُ الصَّخرُ نِيابةً عن الحَواريّينَ: "إنّما علينا طاعةَ اللهِ لا طاعةَ النّاسِ! <verse eid="ACT 5:29" /><verse number="30" style="v" sid="ACT 5:30" />نعم، أنتُم مَن قَتَلتُم سَيِّدَنا عيسى إذ صَلَبتُموهُ، إلاّ أنّ اللهَ، إلهَنا وإلهَ آبائِنا الأوَّلينَ بَعَثَهُ حيًّا، <verse eid="ACT 5:30" /><verse number="31" style="v" sid="ACT 5:31" />ورَفَعَهُ إلى يَمينِهِ ليَكونَ المَلِكَ المُنقِذَ، وليَفتَحَ لبَني يَعقوبَ بابَ التَّوبَةِ والغُفرانِ. <verse eid="ACT 5:31" /><verse number="32" style="v" sid="ACT 5:32" />ونحنُ على ذلِكَ شُهودٌ، واللهُ يُثَبِّتُ شَهادتَنا مُؤيّدًا إيّانا برُوحِهِ القُدّوس! وهي هِبةُ اللهِ لمَن يُطيعونَهُ".<verse eid="ACT 5:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="ACT 5:33" />وعِندَما سَمِعَ أعضاءُ المَجلِسِ هذا الكَلامَ اعتَرَاهُم غَضَبٌ شَديدٌ، وقَرَّروا قَتلَ الحَواريِّينَ. <verse eid="ACT 5:33" /><verse number="34" style="v" sid="ACT 5:34" />إلاّ أنّ واحِدًا مِنهُم مِن طائفةِ المُتَشَدِّدينَ واسمُهُ غَمْلائِيلَ، مُعَلِّمٌ للتَّوراةِ وكانَ مَحَلَّ احتِرامِ الجَميعِ، وَقَفَ في المَجلِسِ وأمَرَ بإخراجِ الحَواريِّينَ لحِينٍ، <verse eid="ACT 5:34" /><verse number="35" style="v" sid="ACT 5:35" />ثُمَّ التَفَتَ إلى باقي الأعضاءِ قائلاً: "يا إخوتي مِن بَني يَعقوبَ، إيّاكُم أن تُنَفِّذوا ما عَزَمتُم عليهِ في شأنِ هؤلاءِ الرِّجالِ، <verse eid="ACT 5:35" /><verse number="36" style="v" sid="ACT 5:36" />فلقد ظَهَرَ تُوداسُ، لو تَذكُرُونَ، مُنذُ مُدَّةٍ وادّعى بأنّهُ رَجُلٌ عَظيمٌ، واجتَمَعَ حَولَهُ أربعُ مِئةِ رَجُلٍ واتَّبعُوهُ، ولكنّ مآلَهُ كانَ القَتلَ، فتَفَرّقَ إثرَ ذلِكَ كُلُّ أتباعِهِ وانتَهَى أمرُهُم. <verse eid="ACT 5:36" /><verse number="37" style="v" sid="ACT 5:37" />وبَعدَ ذلِكَ، ظَهَرَ يَهوذا الجَليليُّ<note caller="+" style="f"><char style="fr" closed="false">5‏.37 </char><char style="ft" closed="false">كان يهوذا، في الحقيقة، من سكان الجولان، وقد قاد ثورة دينية وطنية ضد الرومان في السنة السادسة للميلاد. وكان يقول بأنّ الله هو الملك المطلق معتبرًا أن دفع الجزية لحاكم وثني هو بمثابة خروج عن طاعة الله. وقد أخمد الرومان ثورته، ممّا أدّى إلى قيام حركة وطنية تعرف بحركة المتحمّسين أو الغيورين.</char></note> أثناءِ إجراءِ الإحصاءِ الرُّومانيّ،<note caller="+" style="f"><char style="fr" closed="false">5‏.37 </char><char style="ft" closed="false">هذا الإحصاء يختلف عن إحصاء الوالي قيرينيوس المذكور في لوقا 2: 2. </char></note> وجَذَبَ حَولَهُ جَماعةً مِنَ المُتَمَرِّدينَ على الرُّومانِ، وقد قُتِلَ أيضًا، وتَفَرَّقَ كُلُّ أتباعِهِ. <verse eid="ACT 5:37" /><verse number="38" style="v" sid="ACT 5:38" />وتَبعًا لذلِكَ، ففي ما يَخُصُّ الحَواريِّينَ، أنصَحُ أن تَبتعِدوا عَنهُم وتَترُكوهُم وشأنَهُم، فإن كانَ ما يَدَّعونَ مِن أقوالٍ وآراءٍ وما يَفعَلونَهُ مِن أعمالٍ مِن صُنعِ بَشَرٍ فستَذهَبُ كُلُّها هَباءً مَنثورةً، <verse eid="ACT 5:38" /><verse number="39" style="v" sid="ACT 5:39" />أمّا إن كانَت مِن عِندِ اللهِ فِعلاً، فلن يَكونَ بوُسعِكُم التّغَلّبُ عليهِم، بل ستُحارِبونَ اللهَ بذلِكَ!"<verse eid="ACT 5:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="ACT 5:40" />وعَمِلَ رِجالُ المَجلِسِ بنَصيحةِ غَمْلائِيلَ، ولكنّهُم استَدَعوا الحَواريِّينَ وأمَروا الحُرّاسَ بجَلدِهِم، ثُمَّ أطلَقوا سَراحَهُم آمِرينَ إيّاهُم بألاّ يَتَكَلّموا باسمِ عيسى بَعدَ ذلِكَ، <verse eid="ACT 5:40" /><verse number="41" style="v" sid="ACT 5:41" />فخَرَجَ الحَواريُّونَ مِنَ المَجلِسِ فَرِحينَ لأنّ اللهَ خَصَّهُم بشَرَفِ أن يُهانوا في سَبيلِ سَيِّدِنا عيسى. <verse eid="ACT 5:41" /><verse number="42" style="v" sid="ACT 5:42" />واستَمَرّوا في نَشرِ رِسالةِ اللهِ كُلَّ يَومٍ دونَ تَوَقُّفٍ، سَواءً في الحَرَمِ الشّريفِ أو في البُيوتِ، مُعلِنينَ على المَلإ أنّ عيسى إنّما هو المَسيحُ المُنقِذُ المُنتَظَرُ.<verse eid="ACT 5:42" /></para>
  <chapter eid="ACT 5" />
  <chapter number="6" style="c" sid="ACT 6" />
  <para style="cl">الفصل السّادس</para>
  <para style="s">اختيار مساعدين للحواريين</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 6:1" />وازدادَ عَدَدُ المُؤمنينَ بالسّيِّدِ المَسيحِ، وحَدَثَ أن تَذَمَّرَ المؤمنونَ ذَوو الأصلِ اليَهوديّ القادِمونَ مِن خارجِ البِلادِ، مِن يَهودِ أهلِ البِلادِ، وذلِكَ لِما تَتَعَرّضَ لهُ أراملُهُم مِن إهمالٍ عِندَ تَوزِيعِ المَعونة اليَوميّة. <verse eid="ACT 6:1" /><verse number="2" style="v" sid="ACT 6:2" />فاستَدعى الحَواريّونَ الاثنا عَشَرَ المُؤمنينَ مِن كِلا الطَّرفَينِ وقالوا لهُم: "لَيسَ لنا أن نَنشَغِلَ عن نَشرِ تَعاليمِ رِسالةِ اللهِ بتَوزِيعِ الطَّعامِ، <verse eid="ACT 6:2" /><verse number="3" style="v" sid="ACT 6:3" />فيا إخوانُ، لكُم أن تَختاروا سَبعةَ رِجالٍ مِن بَينِكُم مِمّن يَتَمَتّعونَ بسُمعةٍ حَسَنةٍ، مُمتلئينَ بالحِكمةِ وبنَفحةٍ مِن رُوحِ اللهِ، حتّى نُكَلِّفَهُم بهذِهِ المُهِمّةِ. <verse eid="ACT 6:3" /><verse number="4" style="v" sid="ACT 6:4" />أمّا نَحنُ، فعلينا المُواظبةُ على الصَّلاةِ وتَعليمِ رِسالةِ اللهِ". <verse eid="ACT 6:4" /><verse number="5" style="v" sid="ACT 6:5" />فاستَحسَنَ الجَميعُ رأي الحَواريِّينَ، ووَقَعَ الاختِيارُ على رَجُلٍ اسمُهُ اِسْطَفان قويِّ الإيمانِ مُفعَمٍ برُوحِ اللهِ، إلى جانبِ فيليبَ وبَركورَ ونيسانَ وتِيمُونَ وبَرْمانَ ونِقُولا الأنطاكيّ الّذي سَبَقَ أنِ اعتَنَقَ اليَهوديّة، ثُمَّ آمَنَ بالسَّيِّدِ المَسيحِ.<note caller="+" style="f"><char style="fr" closed="false">6‏.5 </char><char style="ft" closed="false">جميع أسماء هؤلاء الرجال يونانية، وربّما اختارهم الحواريون باعتبارهم يهودا من البلاد اليونانية، لأنّ الأرامل المحتاجات كنّ يتكلّمن اليونانية.</char></note> <verse eid="ACT 6:5" /><verse number="6" style="v" sid="ACT 6:6" />وحَضَرَ هؤلاءِ الرِّجالُ السَّبعةُ أمامَ الحَواريِّينَ، الّذينَ صَلّوا ثُمّ وَضَعوا أيديهِم عليهِم، طالِبينَ مِنَ اللهِ أن يُبارِكَهُم. <verse eid="ACT 6:6" /><verse number="7" style="v" sid="ACT 6:7" />وهكذا أخَذَت رِسالةُ اللهِ في الانتِشارِ، وعَدَدُ المُؤمنينَ بالمَسيحِ في ازديادٍ سَريعٍ في القُدس، حتّى إنّ عَدَدًا كَبيرًا مِنَ الأحبارِ آمَنوا بالسَّيّدِ المَسيحِ وصَدَّقوا.<verse eid="ACT 6:7" /></para>
  <para style="s">القبض على اسطفان</para>
  <para style="p">
    <verse number="8" style="v" sid="ACT 6:8" />وكانَ اسْطَفان المُمتلِئُ بفَضلِ اللهِ وقوّتِهِ، يَعمَلُ العَجائبَ بَينَ النّاسِ مُظهِرًا آياتٍ خارِقةً، <verse eid="ACT 6:8" /><verse number="9" style="v" sid="ACT 6:9" />وكانَ بَعضُ المُنتَمينَ إلى بَيتِ العِبادةِ المَعروفِ باسمِ "بَيتِ المُحَرَّرينَ"،<note caller="+" style="f"><char style="fr" closed="false">6‏.9 </char><char style="ft" closed="false">هؤلاء اليهود كانوا في ما مضى عبيدًا، ثم أصبحوا بعد ذلك أحرارًا.</char></note> وهم مِن يَهودِ مَدينةِ قُورينا في ليبيا والإسكندريّة وكِليكيّة ومُقاطعة آسيا، يُعارضونَهُ ويُجادِلونَهُ، <verse eid="ACT 6:9" /><verse number="10" style="v" sid="ACT 6:10" />دونَ أن يَقدِروا على غلَبَتِهِ وذلِكَ للحِكمةِ الّتي بَثَّها اللهُ فيهِ بنَفحةٍ مِنَ رُوحِهِ تَقَدَّسَ وتَعالى. <verse eid="ACT 6:10" /><verse number="11" style="v" sid="ACT 6:11" />فحَرَّضوا بَعضَ النّاسِ ليَقولوا: "سَمِعنا هذا الرَّجُلَ يَنطِقُ كُفرًا بحقِّ سَيِّدِنا موسى وبحَقِّ اللهِ!" <verse eid="ACT 6:11" /><verse number="12" style="v" sid="ACT 6:12" />وذلِكَ بهَدَفِ إثارةِ الجَماهيرِ والشُّيوخِ والفُقهاءِ ضِدَّهُ، ولِيَقبِضوا عليهِ ويُحضِروهُ ليَمثُلَ أمامَ المَجلِسِ الأعلى. <verse eid="ACT 6:12" /><verse number="13" style="v" sid="ACT 6:13" />وكانَ لهُم في ذلِكَ النَّجاحُ القَريبُ فمَثُلَ أمامَ المَجلِسِ الأعلى وأحضَروا شُهودَ زُورٍ يَقولونَ: "إنّ هذا الرَّجُلَ لا يَفتُرُ يُهاجِمُ بَيتَ اللهِ المُقَدَّس وتَوراةَ سَيِّدِنا موسى، <verse eid="ACT 6:13" /><verse number="14" style="v" sid="ACT 6:14" />فقد سَمِعناهُ يَقولُ إنّ عيسى النّاصريَّ سيَهدِمُ بَيتَ اللهِ، ويُغَيِّرُ السُّنَنَ الّتي جاءَتنا مِنَ النَّبيِّ موسى". <verse eid="ACT 6:14" /><verse number="15" style="v" sid="ACT 6:15" />وأتاهُم رَدُّ العَليِّ فشَعَّ وَجهُ اِسطَفان بنورٍ كالمَلاكِ، وأخَذَ كُلُّ مَن بالمَجلِسِ يُحَدِّقونَ إلى وَجهِهِ بصَمتٍ.<verse eid="ACT 6:15" /></para>
  <chapter eid="ACT 6" />
  <chapter number="7" style="c" sid="ACT 7" />
  <para style="cl">الفصل السّابع</para>
  <para style="s">خطبة اسطفان</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 7:1" />ثُمَّ تَوَجَّهَ كَبيرُ الأحبارِ إلى اِسْطَفان يَسألُهُ: "هل صَحيحٌ ما تُتَّهَمُ بِهِ؟" <verse eid="ACT 7:1" /><verse number="2" style="v" sid="ACT 7:2" />فأجابَ قائِلاً: "أيُّها الشُّيوخُ، ويا إخواني مِن بَني يَعقوبَ، اسمَعوا ما سأقولُ لكُم! أنتُم على عِلمٍ يَقينٍ بالمَكانِ الّذي تَجَلّى فيهِ اللهُ جَلَّ جَلالُهُ لسَيِّدِنا إبراهيمَ (عليه السّلام)، نعم، حَدَثَ ذلِكَ بَينَما كانَ في بِلادِ ما بَينَ النَّهرينِ قَبلَ أن يُقيمَ في حارانَ، <verse eid="ACT 7:2" /><verse number="3" style="v" sid="ACT 7:3" />فقد أمَرَهُ الوَحيُ قائلاً: "اُترُك بَلَدَكَ وأهلَكَ، وارحَلْ إلى البَلَدِ الّذي سأُرشِدُكَ إليهِ". <verse eid="ACT 7:3" /><verse number="4" style="v" sid="ACT 7:4" />فما كانَ مِنهُ (عليه السّلام) إلاّ أن تَرَكَ بِلادَ الكلْدانيِّينَ ليُقيمَ في حارانَ، وبَعدَ أن وافَت أباهُ المَنيّةُ، أمَرَهُ اللهُ بهَجرِ تِلكَ البِلادِ والتَّوَجُّهِ إلى بِلادِنا هذِهِ، <verse eid="ACT 7:4" /><verse number="5" style="v" sid="ACT 7:5" />دُونَ أن يُعطِيَهُ فيها نَصيبًا مِنَ المِلكِ ولا حتّى شِبرًا مِنَ الأرضِ، إلاّ أنّهُ تَعالى وَعَدَهُ أن تُصبِحَ هذِهِ البِلادُ مِلكًا لهُ ولِنَسلِهِ مِن بَعدِهِ، وهو الّذي لم يَكُن لهُ وَلَدٌ في تِلكَ الفَترةِ. <verse eid="ACT 7:5" /><verse number="6" style="v" sid="ACT 7:6" />وقالَ لهُ اللهُ تَعالى: "سيَكونُ أولادُكَ وأحفادُك غُرَباءَ في بِلادٍ أجنَبيَّةٍ يُستَعبَدونَ ويُذَلّونَ على مَدى أربعِ مِئةِ سَنةٍ. <verse eid="ACT 7:6" /><verse number="7" style="v" sid="ACT 7:7" />ولكنّي أنا اللهَ سأُعاقِبُ مَنِ استَعبدوهُم، وسأُخرِجُ ذُريّتَكَ مِن دارِ المَهانَة، إلى هذِهِ البِلادِ الّتي فيها إيّايَ يَعبُدونَ". <verse eid="ACT 7:7" /><verse number="8" style="v" sid="ACT 7:8" />ثُمَّ أعطى اللهُ تَعالى إبراهيمَ (عليه السّلام) ميثاقَ الخِتانِ. فاستَجابَ لرَبِّهِ وخَتَنَ وَلَدَهُ إسحقَ عِندَ ولادتِهِ في اليومِ الثَّامن. وسَرَى عَهدُ اللهِ وميثاقُهُ في ذُرّيّتِهِ فخَتَنَ إسحقُ وَلَدَهُ يَعقوبَ، وخَتَنَ يَعقوبُ أولادَهُ الذُّكورَ الاثنَي عَشَرَ، وهُم آباؤنا الاثنا عَشَرَ الأوّلونَ مُؤسِّسُو هذِهِ الأُمَّة.<verse eid="ACT 7:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="ACT 7:9" />إلاّ أنّ أولادَ النّبيِّ يَعقوبَ حَسَدوا أخاهُم يُوسفَ (عليه السّلام)، فباعوهُ في مِصرَ عَبدًا. ولم يَكُنِ اللهُ ليَترُكَ يُوسفَ (عليه السّلام) <verse eid="ACT 7:9" /><verse number="10" style="v" sid="ACT 7:10" />حتَّى في بِلادِ مِصر البَعيدةِ عن كَنعانَ، فأنقَذَهُ مِن كُلِّ ما حَلَّ بِهِ مِن مَصائبَ ووَيلاتٍ، وأعطاهُ الحِكمةَ، وجَعَلَهُ رَضيًّا فقَبِلَهُ فِرعونُ مَلِكُ مِصرَ قبُولاً حَسَنًا، وأقامَهُ واليًا على مِصرَ وأمينًا على كُلِّ قَصرِهِ. <verse eid="ACT 7:10" /><verse number="11" style="v" sid="ACT 7:11" />وكانَ أن حَصَلَت مَجاعةٌ في جَميعِ أنحاءِ مِصرَ وجَميعِ مَناطقِ بِلادِ كَنعان، فقاسى النّاسُ مِنها الأمرَّينِ، واحتاجَت عائلةُ النّبيِّ يَعقوبَ (عليه السّلام) إلى طَعامٍ كجَميعِ النّاسِ في بِلادِ كَنعان. <verse eid="ACT 7:11" /><verse number="12" style="v" sid="ACT 7:12" />وسَمِعَ النَّبيُّ يَعقوبُ أنّ في مِصرَ قَمحًا، فأرسَلَ أبناءَهُ للمَرّةِ الأُولى إلى مِصرَ حَيثُ يُوسفُ (عليه السّلام)، <verse eid="ACT 7:12" /><verse number="13" style="v" sid="ACT 7:13" />وهُناكَ دَخَلوا عليهِ فعَرَفَهُم ولم يَعرِفوهُ، إلاّ أنّهُ عَرَّفَهُم بنَفسِهِ في زيارتِهِم الثّانية. وسَمِعَ فِرعونُ بوُصولِ عائلةِ يُوسفَ (عليه السّلام). <verse eid="ACT 7:13" /><verse number="14" style="v" sid="ACT 7:14" />ثُمَّ استَدعى النّبيُّ يُوسفُ أباهُ يَعقوبَ وجَميعَ أهلِهِ ليَسكُنوا في مِصرَ، وكانوا خَمسةً وسَبعينَ شَخصًا. <verse eid="ACT 7:14" /><verse number="15" style="v" sid="ACT 7:15" />وهكذا نَزَلَ يَعقوبُ (عليه السّلام) وأبناؤهُ إلى مِصرَ وعاشوا هُناكَ إلى أن ماتوا جَميعًا، <verse eid="ACT 7:15" /><verse number="16" style="v" sid="ACT 7:16" />فنَقَلَ شَعبُنا جَثامينَهُم إلى شَكيم في بِلادِ كَنعانَ ودَفَنوهُم في القَبرِ الّذي كانَ إبراهيمُ (عليه السّلام) قدِ اشتَراهُ مِن أولادِ حَمور.<verse eid="ACT 7:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="ACT 7:17" />ومَعَ دنُوِّ وَقتِ تَحقيقِ وَعدِ اللهِ للنّبيِّ إبراهيمَ، كانَ شَعبُنا في مِصرَ يَكبُرُ ويَزدادُ عَدَدًا. <verse eid="ACT 7:17" /><verse number="18" style="v" sid="ACT 7:18" />واعتَلى عَرشَ مِصرَ مَلِكٌ لم يَكُن لَديهِ عِلمٌ بالنّبيِّ يوسف ولا بما قامَ بِهِ لأجلِ المِصريِّينَ، <verse eid="ACT 7:18" /><verse number="19" style="v" sid="ACT 7:19" />فغَدَرَ بشَعبِنا، وأذَلَّ الآباءَ وأجبَرَهُم على التَّخَلِّي عن أطفالِهِم الذُّكورِ وإهمالِهِم حتّى المَوتِ. <verse eid="ACT 7:19" /><verse number="20" style="v" sid="ACT 7:20" />وفي ذلِكَ الزَّمَنِ العَصيبِ وُلِدَ سَيِّدُنا موسى، وكانَ وافِرَ الجَمالِ، وقد تَمَكّنَ والِداهُ مِنِ احتِضانِهِ وتَربيَتِهِ في بَيتِهِما إلى أن بَلَغَ شَهرَهُ الثّالثَ، <verse eid="ACT 7:20" /><verse number="21" style="v" sid="ACT 7:21" />ثُمَّ تَخَلَّيا عَنهُ بِناءً على إرادةِ المَلِكِ، فدَفَعَهُ اللهُ إلى يَدِ بنتِ فِرعونَ الّتي حَمَلَتهُ واتّخَذَتهُ وَلَدًا. <verse eid="ACT 7:21" /><verse number="22" style="v" sid="ACT 7:22" />فانفَتَحَ لموسى (عليه السّلام) بابُ كُلِّ عُلومِ المِصريِّينَ، فتَعَلّمَها وأتقَنَها قولاً وعَمَلاً. <verse eid="ACT 7:22" /><verse number="23" style="v" sid="ACT 7:23" />وعِندَ بُلوغِهِ الأربعينَ، خَطَرَ لهُ أن يَزورَ إخوتَهُ مِن بَني يَعقوبَ، فسَعى إليهِم. <verse eid="ACT 7:23" /><verse number="24" style="v" sid="ACT 7:24" />وعِندَما كانَ بَينَهُم رأى مِصريًّا يَعتَدي على أحَدِهِم، فانبَرى يُدافعُ عنِ المَظلومِ وقَتَلَ المِصريَّ انتِقامًا مِنهُ، <verse eid="ACT 7:24" /><verse number="25" style="v" sid="ACT 7:25" />وظَنَّ أنّ إخوَتَهُ سيُدرِكونَ أنّ اللهَ أرسَلَهُ للدِّفاعِ عَنهُم وإنقاذِهِم مِنَ العُبوديّةِ، إلاّ أنّهُم لم يُدرِكوا ذلِكَ. <verse eid="ACT 7:25" /><verse number="26" style="v" sid="ACT 7:26" />وفي اليَومِ التّالي، لَمَحَ (عليه السّلام) اثنينِ مِنهُم يَتَشاجرانِ، وحاوَلَ الإصلاحَ بَينَهُما قائلاً: "لِمَ يَعتَدي أحَدُكُما على الآخَرِ وأنتُما أخَوانِ؟! <verse eid="ACT 7:26" /><verse number="27" style="v" sid="ACT 7:27" />إلاّ أنّ المُعتَدي دَفَعَ سَيِّدَنا موسى قائلاً: "وأنتَ، مَنِ الّذي أقامَكَ علينا رَئيسًا وقاضِيًا؟ <verse eid="ACT 7:27" /><verse number="28" style="v" sid="ACT 7:28" />أتَنوي قَتلي كَما قَتَلتَ المِصريَّ بالأمسِ؟" <verse eid="ACT 7:28" /><verse number="29" style="v" sid="ACT 7:29" />وإذ سَمِعَ موسى (عليه السّلام) هذا الكَلامَ فَرَّ هارِبًا إلى بِلادِ مِدْيَن وأقامَ فيها غَريبًا وتَزَوّجَ ورُزِقَ فيها وَلَدَينِ.<verse eid="ACT 7:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="ACT 7:30" />وعِندَما اكتَمَلَت أربعونَ سَنةً، وبَينَما هو في صَحراءِ جَبَلِ سيناءَ، ظَهَرَ لهُ مَلاكٌ على هَيئةِ جَذوةٍ مِن نارٍ في شُجَيرةٍ مِنَ الأشجارِ. <verse eid="ACT 7:30" /><verse number="31" style="v" sid="ACT 7:31" />فاعتَرَتهُ الدَّهشةُ واقتَرَبَ ليَنظُرَ عن كَثَبٍ، فسَمِعَ صَوتَ اللهِ يُخاطِبُهُ قائِلاً: <verse eid="ACT 7:31" /><verse number="32" style="v" sid="ACT 7:32" />"يا مُوسى إنّي أنا رَبُّكَ ورَبُّ آبائِكَ الأوّلينَ، رَبُّ إبراهيمَ وإسحَقَ ويَعقوبَ". فارتَعَدَت فَرائِصُهُ (عليه السّلام) وتَحاشى النَّظَرَ إلى مَصدَرِ الصَّوتِ. <verse eid="ACT 7:32" /><verse number="33" style="v" sid="ACT 7:33" />فقالَ لهُ اللهُ: "يا موسَى اخلَعْ نَعليكَ، إنّكَ بِالوادي المُقَدَّسِ. <verse eid="ACT 7:33" /><verse number="34" style="v" sid="ACT 7:34" />وإنّي رأيتُ في مِصرَ ذُلَّ الشَّعبِ الّذي أعطَيتُهُ ميثاقي، وسَمِعتُ استِغاثتَهُم، وأُريدُ إنقاذَهُم، وإنّي لمُرسِلكَ الآنَ إلى مِصرَ".<verse eid="ACT 7:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="ACT 7:35" />وأضافَ اِسطَفانُ قائلاً: "أنتُم تَزعُمونَ أنّني أرفُضُ النَّبيَّ موسى، ولكن هذا هو النَّبيُّ موسى الّذي رَفَضَهُ آباؤكُم وقالوا لهُ: "مَن عَيَّنَكَ رَئيسًا وقاضيًا علينا؟" ورَغمَ ذلكَ، أرسَلَهُ اللهُ إليهِم مِن خِلالِ المَلاكِ الّذي تَجَلَّى لهُ في تِلكَ الشَّجَرةِ ليَكونَ رَئيسًا على بَني يَعقوبَ ومُنقِذًا لهُم، <verse eid="ACT 7:35" /><verse number="36" style="v" sid="ACT 7:36" />فأخرَجَهُم مِن أرضِ مِصرَ وأظهَرَ لهُم المُعجِزاتِ والآياتِ عِندَما كانوا هُناكَ، واستَمَرَّ يُجري على يدَيهِ المُعجِزاتِ عِندَ خُروجِهِم مِن مِصر، وعِندَ البَحرِ الأحمَرِ، وعلى مَدى أربَعينَ سَنةً في الصَّحراءِ. <verse eid="ACT 7:36" /><verse number="37" style="v" sid="ACT 7:37" />هذا هو النَّبيُّ موسى الّذي خاطَبَ بَني يَعقوبَ قائلاً: "سيَبَعثُ اللهُ فيكُم نَبيًّا مِثلي". <verse eid="ACT 7:37" /><verse number="38" style="v" sid="ACT 7:38" />وإنّي لأُعيدُ عليكُم القَولَ إنّ النّبيَّ موسى هو مَن كانَ يَقودُ جَماعةَ بَني يَعقوبَ في الصَّحراءِ البَعيدةِ عن هذِهِ البِلادِ، ومَعَ ذلِكَ كَلَّمَهُ المَلاكُ في طُورِ سيناءَ وسَلّمَهُ الرِّسالةَ الأبَديّة ليُبَلِّغَها لآبائِنا، وهُم بدورِهِم سَلَّمونا إيّاها. <verse eid="ACT 7:38" /><verse number="39" style="v" sid="ACT 7:39" />إلاّ أنّ آباءَنا رَفَضوا طاعةَ النّبيِّ موسى، ولم يَعتَرِفوا بقيادتِهِ، ورَنَوا بأفئدتِهِم إلى مِصرَ مُتَشَوِّقينَ للعَودةِ إليها، <verse eid="ACT 7:39" /><verse number="40" style="v" sid="ACT 7:40" />فقالوا لسَيِّدِنا هارون: "اجعَلْ لنا آلهةً تَدُلُّنا على الطَّريقِ، فإنّنا لا نَدري ماذا حَلَّ بموسى الّذي أخرَجَنا مِن مِصرَ ثُمَّ تَرَكَنا ها هُنا وغابَ عنّا". <verse eid="ACT 7:40" /><verse number="41" style="v" sid="ACT 7:41" />فصَنَعَ لهُم، مُكرَهًا، عِجلاً صَنَمًا، قَدَّموا لهُ الأُضحياتِ، فَرِحينَ بما صَنَعَت أيديهِم مُقبِلينَ على عِجلِهِم مُدبِرينَ عنِ اللهِ. <verse eid="ACT 7:41" /><verse number="42" style="v" sid="ACT 7:42" />وأقولُ، أنتُم تَزعُمونَ أنّي كافِرٌ باللهِ، إلاّ أنّ آباءَكُم همُ الكافرونَ، سَلَّمَهُم اللهُ لآثامِهِم، فعَبَدوا ما في السَّماءِ مِن شَمسٍ وكَواكِبَ ونُجومٍ، ولقد جاءَ في كِتابِ النّبيِّ عاموسَ: "يا بَني إسرائيلَ، لَمْ تُقَدِّموا لي الأُضحياتِ والقَرابينَ على مَدى أربَعينَ سَنةً في صَحراءِ سِيناء، <verse eid="ACT 7:42" /><verse number="43" style="v" sid="ACT 7:43" />بل للأصنامِ قَدَّمتُموها! وكُنتُم تَحمِلونَ مَعَكُم مَعبدَ الإلهِ مولَخ،<note caller="+" style="f"><char style="fr" closed="false">7‏.43 </char><char style="ft" closed="false">مولخ: أحد آلهة بلاد كنعان، وكان الناس يحرقون له أطفالهم كأضحيات.</char></note> وتَسجُدونَ للكَوكبِ زُحَل،<note caller="+" style="f"><char style="fr" closed="false">7‏.43 </char><char style="ft" closed="false">كان المصريون القدامى يسمّون الكوكب زَحَلْ بـ(رفان) ويعبدونه. وقد تعلّم بعض الناس من بني إسرائيل عادات الشعوب الوثنية ومارسوها وهذا كفر بالله تعالى. هذا القول من النبي عاموس قد يشير إلى أنّ عبادة الأصنام التي ظهرت في أواخر تاريخ بني إسرائيل كانت بدايتها الحقيقية من الزمن الذي تاه فيه هؤلاء في سيناء، بغضّ النظر عن أنّهم كانوا تحت حماية الله.</char></note> وللتَّماثيلِ الّتي صَنَعَتها أيدِيكُم وتَعبُدونَها، مِن أجلِ ذلِكَ أنفيكُم إلى بِلادٍ هي أبعَدُ مِن بلادِ بابِل". وهكذا، عاقَبَ اللهُ آباءَكُم لعِبادتِهِم الأصنامَ!"<verse eid="ACT 7:43" /></para>
  <para style="p">
    <verse number="44" style="v" sid="ACT 7:44" />وتابَعَ اِسطَفانُ قائلاً: "أنتُم تَتَّهمُونَني بإنكارِ بَيتِ اللهِ المُقَدَّسِ،<note caller="+" style="f"><char style="fr" closed="false">7‏.44 </char><char style="ft" closed="false">يبدو من الاتّهامات التي وجّهها اليهود ضدّ اسطفان (انظر 6: 13‏-14) أنّه كان ينادي أن السيد المسيح قد أخذ دور بيت الله المقدّس باعتباره مركز الشفاعة للمؤمنين، أمّا الآن فقد أصبح الطريق إلى الله بواسطة سيدنا عيسى وليس بواسطة الأضاحي في بيت الله. ومن هذا الموقع في النص، يبدأ اسطفان ختام خطابه مع بعض الكلمات عن انتهاء دور بيت الله.</char></note> وإنّ اللهَ تَعالى لم يأمُرِ النّبيَّ موسى ببِناءِ بَيتٍ مِنَ الخَشَبِ، بل أمَرَهُ أن يَنصِبَ خَيمةً للعِبادةِ، حَسَبَ المِثالِ الّذي رَآهُ على جَبَلِ سِيناء. <verse eid="ACT 7:44" /><verse number="45" style="v" sid="ACT 7:45" />فلم يَكُن لآبائِنا في عَصرِ النَّبيِّ موسى سِوى هذِهِ الخَيمةِ يَتَعَبَّدونَ فيها على مَدى إقامتِهِم في الصَّحراءِ. وسَلَّمَ آباؤنا خَيمةَ العِبادةِ تِلكَ لذُرِّيّتِهِم، فحَمَلوها مَعَهُم بقيادةِ يَشوع بِن نون، واحتَلّوا هذِهِ البِلادَ، بَعدَ فَراغِها مِن شُعوبِها الوَثنيّةِ. وبَقِيَت تِلكَ الخَيمةُ هُنا إلى زَمَنِ النَّبيِّ داود. <verse eid="ACT 7:45" /><verse number="46" style="v" sid="ACT 7:46" />وقد كانَ النَّبيُّ داود مَرضيًّا عِندَ اللهِ، فطَلَبَ مِنَ اللهِ تَعالى أن يَبني بَيتًا مِن خَشَبٍ يُرفَعُ فيهِ اسمُهُ تَعالى، <verse eid="ACT 7:46" /><verse number="47" style="v" sid="ACT 7:47" />ولم يَحظَ داودُ بهذا الشَّرَفِ، بل حَظِيَ بِهِ ابنُهُ سُليمانُ. <verse eid="ACT 7:47" /><verse number="48" style="v" sid="ACT 7:48" />وهذا البَيتُ هو بَيتُ اللهِ. لكن أيُعقَلُ أن تَكونَ سُكناهُ تَعالى في بَيتٍ مِن صُنعِ بَشَر؟! لقد جاءَ في نَبُوّة أَشعيا قَولُ اللهِ: <verse eid="ACT 7:48" /><verse number="49" style="v" sid="ACT 7:49" />"وَسِعَ عَرشي السَّماواتِ والأرضَ، فأيّ بَيتٍ تَبنونَ لي؟ وأيَّ مَسكنٍ تَصنَعونَهُ يُمكِنُ أن يَحتويَنا؟ <verse eid="ACT 7:49" /><verse number="50" style="v" sid="ACT 7:50" />ألَستُ أنا فاطِرَ هذا الكَونِ؟"<verse eid="ACT 7:50" /></para>
  <para style="p">
    <verse number="51" style="v" sid="ACT 7:51" />ثُمَّ تابَعَ اِسطَفانُ قَولَهُ: "أيُّها الشَّعبُ العَنيدُ، يا مَن امتَلأت قُلوبُكُم بالوَثَنيّةِ، وصُمَّت آذانُكُم! أنتُم كآبائِكُم الأوَّلينَ تُقاوِمونَ هِدايةَ رُوحِ اللهِ، <verse eid="ACT 7:51" /><verse number="52" style="v" sid="ACT 7:52" />أرُوني نَبيًّا واحِدًا لم يَضطَهِدْهُ آباؤكُم! قد قَتَلَ آباؤكُم الرُّسُلَ الّذينَ تَنَبَّؤوا بمَجِيءِ المَسيحِ الصّالحِ المُنتَظَرِ، وأنتُم غَدَرتُم بِهِ وقَتَلتُموهُ، <verse eid="ACT 7:52" /><verse number="53" style="v" sid="ACT 7:53" />يا مَن سَلَّمَتكُم الملائكةُ التَّوراةَ مِن عِندَ اللهِ، فأدَرتُم ظُهورَكُم لها!"<verse eid="ACT 7:53" /></para>
  <para style="s">قتل اسطفان</para>
  <para style="p">
    <verse number="54" style="v" sid="ACT 7:54" />واعتَرَى أعضاءَ المَجلِسِ غَضَبٌ شَديدٌ مِن كَلامِ اِسطَفانَ، فصَرُّوا بأسنانِهِم غَيظًا، <verse eid="ACT 7:54" /><verse number="55" style="v" sid="ACT 7:55" />إلاّ أنّ اِسطَفانَ رَنا بنَظَرِهِ إلى السَّماءِ مُمتَلِئًا بحُضورِ رُوحِ اللهِ، حَيثُ رَأى جَلالَ نورِ اللهِ، وسَيِّدَنا عيسى (سلامُهُ علينا) واقِفًا على يَمينِهِ، <verse eid="ACT 7:55" /><verse number="56" style="v" sid="ACT 7:56" />فالتَفَتَ قائلاً: "اُنظُروا! إنِّي أرى السَّماءَ قدِ انشَقَّت وبَدا سَيِّدُ البَشَرِ واقِفًا عن يَمينِ اللهِ تَعالى". <verse eid="ACT 7:56" /><verse number="57" style="v" sid="ACT 7:57" />فرَفَعَ أعضاءُ المَجلِسِ أصابِعَهُم إلى آذانِهِم لكَي لا يَسمَعوهُ، وتَعالَت أصواتُهُم، وهَجَموا على اِسطَفانَ هَجمةً واحدةً <verse eid="ACT 7:57" /><verse number="58" style="v" sid="ACT 7:58" />وقادوهُ إلى خارجِ مَدينةِ القُدسِ، ورَجَمَهُ الشُّهودُ، بَعدَ أن خَلَعوا ثيابَهُم ووَضَعوها عِندَ قدَمَي شابٍّ اسمُهُ شاولُ لحِراستِها. <verse eid="ACT 7:58" /><verse number="59" style="v" sid="ACT 7:59" />وبَينَما كانَ اِسطَفانُ يُرجَمُ، أخَذَ يَهتِفُ قائلاً: "يا سَيِّدي عيسى، تَقَبّلْ رُوحي!" <verse eid="ACT 7:59" /><verse number="60" style="v" sid="ACT 7:60" />وجَثا على رُكبتَيهِ صارِخًا: "يا سَيِّدي، تَشَفّعْ لهُم في ذَنبِهِم هذا". وفارَقَ الحَياةَ.<verse eid="ACT 7:60" /></para>
  <chapter eid="ACT 7" />
  <chapter number="8" style="c" sid="ACT 8" />
  <para style="cl">الفصل الثّامن</para>
  <para style="s">اضطهاد شاول للمؤمنين</para>
  <para style="p">
    <verse number="1‏-2" style="v" sid="ACT 8:1-2" />وقد قُتِلَ اِسطَفانُ بمُوافقةِ شاولَ، وقامَ بَعضُ الأتقياءِ بدَفنِهِ، وبَكَوهُ بُكاءً مُرًّا. وفي ذلِكَ اليَومِ، سَرَت موجَةُ اضطِهادٍ كَبيرةٍ ضِدَّ المُؤمنينَ بالمَسيحِ في القُدسِ، فتَفَرَّقَ هؤلاءِ في أنحاءِ البِلادِ في مَناطِقِ يَهوذا والسّامِرة،<note caller="+" style="f"><char style="fr" closed="false">8‏.1‏-2 </char><char style="ft" closed="false">حدثت هذه الجريمة بعد قيامة سيدنا عيسى (سلامُهُ علينا) وصعوده إلى السماء بعدّة سنوات. ويبدو أن أكثر المؤمنين بالسيد المسيح لم يلتزموا تماما بطاعة أمره أن ينتشروا في كلّ الأرجاء للدعوة إلى رسالته. ولكن هذا الاضطهاد الشديد اضطرّهم إلى الانتشار في الأرض اضطرارا.</char></note> أمّا الحَواريّونَ فقد ظَلُّوا ماكِثينَ في القُدس، <verse eid="ACT 8:1-2" /><verse number="3" style="v" sid="ACT 8:3" />في حينِ أخَذَ شاولُ يَسعى إلى إبادةِ جَماعةِ المؤمنينَ، مُنتَقِلاً مِن دارٍ إلى دارٍ، يَجُرُّ الرِّجالَ والنِّساءَ إلى السِّجنِ.<verse eid="ACT 8:3" /></para>
  <para style="s">الدّعوة في السّامرة</para>
  <para style="p">
    <verse number="4" style="v" sid="ACT 8:4" />وأخَذَ المؤمنونَ الفارّونَ مِنَ القُدسِ يَتَنَقّلونَ مِن مَكانٍ إلى آخَرَ مُعلِنينَ البِشارةَ بسَيِّدِنا عيسى. <verse eid="ACT 8:4" /><verse number="5" style="v" sid="ACT 8:5" />وكانَت وِجهَةُ فيليبَ<note caller="+" style="f"><char style="fr" closed="false">8‏.5 </char><char style="ft" closed="false">فيليب هو واحد من السبعة المختارين لتوزيع المعونات على الأرامل في القدس، وهو ليس الحواري فيليب.</char></note> أكبَرَ مُدُنِ مِنطقةِ السّامِرةِ، فأخَذَ يُبَشِّرُ فيها بالمَسيحِ (سلامُهُ علينا). <verse eid="ACT 8:5" /><verse number="6" style="v" sid="ACT 8:6" />وبَعدَ إصغاءِ الجُموعِ إلى كَلامِهِ، ورُؤيتِهِم للمُعجِزاتِ الّتي كانَ يُظهِرُها، تَمَسَّكوا بِهِ تَمَسُّكًا، <verse eid="ACT 8:6" /><verse number="7" style="v" sid="ACT 8:7" />وكانَ قد حَرَّرَ الكَثيرينَ مِن سَطوةِ الجِنِّ والشّياطينِ الّتي أخَذَت تَنسَلُّ مِنهُم صارِخةً مُرتَعِدةً، وأبرَأ عَدَدًا كَبيرًا مِمَّن كانوا مُصابينَ بالشَّللِ والعَرَجِ، <verse eid="ACT 8:7" /><verse number="8" style="v" sid="ACT 8:8" />مِمّا مَلأ المَدينةَ بَهجةً وفَرَحًا.<verse eid="ACT 8:8" /></para>
  <para style="s">سيمون السّاحر</para>
  <para style="p">
    <verse number="9‏-11" style="v" sid="ACT 8:9-11" />وكانَ في تِلكَ المَدينةِ رَجُلٌ ساحِرٌ اسمُهُ سِيمونُ، قد أصبَحَ مَوضَعَ دَهشةِ أهلِ السّامِرةِ، إذ كانَ يُمارِسُ السِّحرَ مُنذُ سِنين، مُدَّعيًا أنّهُ رَجُلٌ خارِقٌ، مِمّا جَعَلَ الجَميعَ، الوَضيعَ مِنهُم والعَظيمَ، يُصَدِّقونَهُ ويَظُنّونَ أنّهُ المُمتَلِكُ لقُدرةِ اللهِ العَظيمةِ. <verse eid="ACT 8:9-11" /><verse number="12" style="v" sid="ACT 8:12" />وعِندَما أعلنَ فيليبُ بُشرى قيامِ مَملكةِ اللهِ المَوعُودةِ، وظُهورِ شَخصِ عيسى المَسيح (سلامُهُ علينا)، آمَنَ الكَثيرُ مِنهُم وتَطَهَّروا بالماءِ، رِجالاً ونِساءً، <verse eid="ACT 8:12" /><verse number="13" style="v" sid="ACT 8:13" />ومِن بَينِهم سِيمونَ الّذي أظهَرَ الإيمانَ بَعدَ أن تَطَهَّرَ أيضًا بالماءِ ليُصبِحَ مِن جَماعةِ سَيّدِنا عيسى المَسيحِ (سلامُهُ علينا). وهكذا أخَذَ سِيمونُ يُلازِمُ فيليبَ أينَما حَلَّ وارتَحَلَ مُتَعَجِّبًا مِنَ الآياتِ والمُعجِزاتِ العَظيمةِ الَّتي كانَ يُظهِرُها.<verse eid="ACT 8:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="ACT 8:14" />وسَمِعَ الحَواريّونَ في القُدسِ بخَبَرِ إقبالِ السّامريِّينَ على رِسالةِ اللهِ، فأرسَلوا بُطرُسَ الصَّخرَ ويوحنّا إليهم. <verse eid="ACT 8:14" /><verse number="15" style="v" sid="ACT 8:15" />فمَضى الرَّجُلانِ إلى هُناكَ، وأخَذا يَبتَهِلانِ إلى اللهِ ليَحظى المُؤمِنونَ في السّامِرةِ أيضًا بِرُوحِ اللهِ، <verse eid="ACT 8:15" /><verse number="16" style="v" sid="ACT 8:16" />لأنّها لم تَكُن قد حَلَّت على أحَدٍ مِنهُم حتّى ذلِكَ الحِينِ، وإنّما كانوا يَتَطَهَّرونَ صِبغةً للهِ بغايَةِ الانضِمامِ إلى جَماعةِ سَيِّدِنا عيسى لا غَيرَ.<note caller="+" style="f"><char style="fr" closed="false">8‏.16 </char><char style="ft" closed="false">يبدو أنّ أكثر أتباع المسيح كانوا إلى حدّ ذلك الوقت ينشرون رسالته بين إخوانهم من بني يعقوب فقط، ولم يدركوا بعدُ أنّ حقّ الانضمام إلى أمّة الله مفتوح لكلّ الناس من كلّ الأمم. ولقد بيّن الله لهم من خلال هذا الحدث هنا أنّ السامريين المنبوذين أيضا لهم نصيب في أمّة الله.</char></note> <verse eid="ACT 8:16" /><verse number="17" style="v" sid="ACT 8:17" />ووَضَعَ بُطرُسُ ويوحنّا أيدِيهِما على كُلِّ واحدٍ مِنهُم فحَظوا برُوحِ اللهِ.<note caller="+" style="f"><char style="fr" closed="false">8‏.17 </char><char style="ft" closed="false">كانت عادة وضع الأيدي على الناس تستخدم عند طلب الشفاء، أو طلب بركة الله على شخصٍ ما، أو لاختيار إنسان لمهمّة خاصّة أو لطلب كرامات روح الله من أجل مؤمن جديد.</char></note> <verse eid="ACT 8:17" /><verse number="18" style="v" sid="ACT 8:18" />وعِندَما رَأى سِيمونُ ذلِكَ، قامَ بِعَرضِ المالِ على كُلٍّ مِن بُطرُسَ الصَّخر ويوحنّا قَائلاً: <verse eid="ACT 8:18" /><verse number="19" style="v" sid="ACT 8:19" />"امنَحاني هذِهِ القُدرةَ، فتَحُلُّ رُوحُ اللهِ على كُلِّ شَخصٍ أضَعُ يَديَّ عليهِ!" <verse eid="ACT 8:19" /><verse number="20" style="v" sid="ACT 8:20" />فأجابَهُ بُطرُسُ الصَّخرُ: "إلى الجَحيمِ أنتَ ونُقودُكَ، لأنّكَ أرَدتَ شِراءَ هِبةِ اللهِ بالمالِ! <verse eid="ACT 8:20" /><verse number="21" style="v" sid="ACT 8:21" />إنّ قَلبَكَ غَيرُ مُخلِصٍ للهِ، فلا نَصيبَ ولا حُظوةَ لكَ بهِبةِ رُوحِ اللهِ! <verse eid="ACT 8:21" /><verse number="22" style="v" sid="ACT 8:22" />دَعْ أعمالَكَ الآثمةَ وعُدْ إلى اللهِ مُخلِصًا، واُدعُ مَولانا عيسَى لَعَلَّهُ يَشفَعُ لكَ فيَعفو اللهُ عَنكَ لنيَّتِكَ السَّيِّئةِ هذِهِ، <verse eid="ACT 8:22" /><verse number="23" style="v" sid="ACT 8:23" />إنّني أراكَ ما زِلتَ غارِقًا في مَرارةٍ وحَسَدٍ، مُقَيَّدًا بالشُّرورِ". <verse eid="ACT 8:23" /><verse number="24" style="v" sid="ACT 8:24" />فقالَ لهُ سِيمونُ: "يا صَخرُ، يا يوحنّا إنّي أسألُكما الشَّفاعةَ مِن عيسى كي لا يُصيبَني ما ذَكَرتُماهُ لي". <verse eid="ACT 8:24" /><verse number="25" style="v" sid="ACT 8:25" />وهكذا خَبَّرَ بُطرُسُ ويوحنّا السّامريّينَ بِرسالةِ سَيِّدِنا عيسى (سلامُهُ علينا)، وقَفَلا عائدَينِ إلى القُدس، وخِلالَ مَسيرِهِما نادَيا بالبُشرى في قُرى كَثيرةٍ مِن قُرى مِنطقةِ السّامِرةِ.<verse eid="ACT 8:25" /></para>
  <para style="s">وزير من المملكة النّوبية يؤمن بعيسى (سلامُهُ علينا)</para>
  <para style="p">
    <verse number="26" style="v" sid="ACT 8:26" />أمّا فيليبُ فقد بَعَثَ اللهُ لهُ مَلاكًا قائلاً: "انطَلِقْ نَحوَ الجَنوبِ في الطَّريقِ الصَّحراويِّ بَينَ القُدسِ وغَزّة". <verse eid="ACT 8:26" /><verse number="27" style="v" sid="ACT 8:27" />فمَضى وفي طَريقِهِ قابَلَ رَجُلاً مِن مَملكةِ النّوبَة<note caller="+" style="f"><char style="fr" closed="false">8‏.27 </char><char style="ft" closed="false">كان قسم من مملكة النوبة يقع في جنوب مصر والقسم الآخر في السودان. وكانت بداية تلك المملكة سنة 750 ق.م. أمّا أهمّ مدنها فهي (مروي) و(نافاتا). وليس المقصود بنوبة أثيوبيا، تلك المملكة التي أصبحت مملكة مسيحية في القرن الرابع للميلاد.</char></note> عائدًا إلى بِلادِهِ بَعدَ أدائِهِ الحَجِّ في القُدسِ. وكانَ هذا الرَّجُلُ مِن عِليَةِ القومِ يَشغَلُ وَزيرَ المالِ عِندَ المَلِكَة الّتي تُسمَّى في لُغتِهِم "الكَنداكَة". <verse eid="ACT 8:27" /><verse number="28" style="v" sid="ACT 8:28" />وبَينَما كانَ هذا الأخيرُ جالِسًا في مَركبتِهِ يَقرأُ كِتابَ النّبيِّ أَشعيا، <verse eid="ACT 8:28" /><verse number="29" style="v" sid="ACT 8:29" />جاءَ وَحيٌ مِن رُوحِ اللهِ إلى فيليبَ أن يَتَقَدَّمَ إلى المَركبةِ ويُرافِقَها. <verse eid="ACT 8:29" /><verse number="30" style="v" sid="ACT 8:30" />فذَهَبَ فيليبُ مُسرِعًا إلى المَركَبةِ، وسَمِعَ الوَزيرَ يَقرَأُ كَلامَ النّبيِّ أَشعيا، فقالَ لهُ: "أتَفهَمُ ما تَقرَأ؟!" <verse eid="ACT 8:30" /><verse number="31" style="v" sid="ACT 8:31" />فأجابَهُ الوَزيرُ: "كَيفَ لي بذلِكَ، ولا يُوجدُ مَن يُفَسِّرُ لي ما في هذا الكِتابِ؟" فدَعا الوَزيرُ فيليبَ إلى الصُّعودِ والجُلوسِ إلى جانِبِهِ، <verse eid="ACT 8:31" /><verse number="32" style="v" sid="ACT 8:32" />وكانَتِ الفِقرَةُ الّتي يَقرَأُها مِنَ الكِتابِ هي: "كانَ كَشاةٍ تُساقُ إلى الذَّبحِ، وكَحَمَلٍ صامِتٍ بَينَ يَدَي مَن يَجُزُّهُ، لم يَفتَح فَمَهُ. <verse eid="ACT 8:32" /><verse number="33" style="v" sid="ACT 8:33" />ظَلَموهُ بحُكمِهِم وأَذَلّوهُ، ومَن يَستَطيعُ أن يُعَبِّرَ عن ذلِكَ الإثمِ الّذي ارتَكَبَهُ شَعبُهُ!؟ فقد قَضَوا على حَياتِهِ في هذِهِ الدُّنيا". <verse eid="ACT 8:33" /><verse number="34" style="v" sid="ACT 8:34" />فقالَ لهُ الوَزيرُ: "أخبِرني، لا عَدِمتُكَ، مَنِ المَقصودُ بهذِهِ النُّبوءةِ، أيَعني نَفسَهُ أم شَخصًا آخَرَ؟" <verse eid="ACT 8:34" /><verse number="35" style="v" sid="ACT 8:35" />فأخَذَ فيليبُ يُوضِحُ لهُ أنّ المَقصودَ مِن هذا الكَلامِ هو سَيِّدُنا عيسى (سلامُهُ علينا)، ثُمَّ شَرَحَ لهُ بَعدَ ذلِكَ رِسالةَ المَسيحِ عيسى. <verse eid="ACT 8:35" /><verse number="36" style="v" sid="ACT 8:36" />وبَينَما هُما يَسيرانِ، وَصَلا إلى مَكانٍ فيهِ ماءٌ، فالتَفَتَ الوَزيرُ إلى فيليبَ قائلاً: "اُنظُرْ! هذا ماءٌ، ماذا يَمنَعُني مِنَ التَّطَهُّر بِهِ؟" <verse eid="ACT 8:36" /><verse number="37" style="v" sid="ACT 8:37" />فأجابَهُ فيليبُ: "إن كانَ قَلبُكَ مُخلِصًا في إيمانِهِ، فليَكُن ذلِكَ". فقالَ الرَّجُلُ: "إنّي أؤمنُ بأنّ عيسى هو المَسيحُ الابنُ الرُّوحيُّ للهِ". <verse eid="ACT 8:37" /><verse number="38" style="v" sid="ACT 8:38" />وأمَرَ بتَوقيفِ المَركَبةِ، ونَزَلَ هو وفيليبُ إلى الماءِ مَعًا، وقامَ فيليبُ بِتَطهِيرِهِ صِبغةً للهِ. <verse eid="ACT 8:38" /><verse number="39" style="v" sid="ACT 8:39" />وعِندَ خُروجِهِما مِنَ الماءِ، خَطِفَت رُوحُ اللهِ فيليبَ، فلم يَعُدِ الوَزيرُ يَراهُ، إلاّ أنّهُ تابَعَ سَفَرَهُ مُفعَمًا بالسُّرورِ. <verse eid="ACT 8:39" /><verse number="40" style="v" sid="ACT 8:40" />أمّا فيليبُ، فقد ظَهَرَ في مَدينةِ أَشْدود، حَيثُ أخَذَ يُنادي بالبُشرى، وهو يَطوفُ مِن بَلدةٍ إلى أُخرى، ناشِرًا الرِّسالةَ في المِنطقةِ كُلِّها إلى أن وَصَلَ إلى مَدينةِ قَيصَريّة.<verse eid="ACT 8:40" /></para>
  <chapter eid="ACT 8" />
  <chapter number="9" style="c" sid="ACT 9" />
  <para style="cl">الفصل التّاسع</para>
  <para style="s">شاول يهتدي إلى الإيمان</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 9:1" />واستَمَرَّ شاولُ في تَهديدِهِ لأتباعِ سَيِّدِنا عيسى (سلامُهُ علينا) بالقَتلِ، فتَوَجَّهَ إلى كَبيرِ الأحبارِ <verse eid="ACT 9:1" /><verse number="2" style="v" sid="ACT 9:2" />طالِبًا مِنهُ أن يَكتُبَ رَسائلَ للقائِمينَ على بُيوتِ العِبادةِ في دِمَشقَ، ليَسمَحوا لهُ بالقَبضِ على مَن يَجِدُ مِن أتباعِ عيسى (سلامُهُ علينا) مِن رِجالٍ ونِساءٍ ليَسوقَهُم مُقَيَّدينَ إلى القُدسِ.<verse eid="ACT 9:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="ACT 9:3" />وفي طَريقِهِ إلى دِمَشقَ، وعِندَ اقتِرابِهِ مِنها، أشَعَّ حَولَهُ فَجأةً نورٌ مِنَ السَّماءِ، <verse eid="ACT 9:3" /><verse number="4" style="v" sid="ACT 9:4" />فخَرَّ واقعًا على الأرضِ، وسَمِعَ صَوتًا قائِلاً: "شاولُ، يا شاولُ، لِماذا تَضطَهِدُني؟" <verse eid="ACT 9:4" /><verse number="5" style="v" sid="ACT 9:5" />فأجابَ شاولُ: "مَن أنتَ يا سَيِّدي؟" فأخبَرَهُ الصَّوتُ قائلاً: "أنا عيسى، أنا مَن تَضطَهِدُهُ باضطِهادِكَ لأتباعي. <verse eid="ACT 9:5" /><verse number="6" style="v" sid="ACT 9:6" />قُم واُدخُلِ المَدينةَ، حَيثُ تَجِدُ مَن يُخبِرُكَ بما عليكَ فِعلُهُ". <verse eid="ACT 9:6" /><verse number="7" style="v" sid="ACT 9:7" />أمّا الرِّجالُ الّذينَ كانوا برِفقَتِهِ، فظَلّوا واقِفينَ في ذُهولٍ لأنّهُم سَمِعوا صوتًا ولم يَرَوا أحَدًا. <verse eid="ACT 9:7" /><verse number="8" style="v" sid="ACT 9:8" />ونَهَضَ شاولُ مِنَ الأرضِ، وفَتَحَ عَينَيهِ فوَجَدَ نَفسَهُ فاقِدَ البَصَرِ، فقادَهُ مَن مَعَهُ بيدِهِ إلى دِمَشقَ. <verse eid="ACT 9:8" /><verse number="9" style="v" sid="ACT 9:9" />وبَقيَ هُناكَ ثلاثةَ أيّامٍ مُظلِمَ العَينينِ دونَ أكلٍ وشُربٍ.<verse eid="ACT 9:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="ACT 9:10" />وكانَ في مَدينةِ دِمَشقَ أحَدُ أتباعِ سَيِّدِنا عيسى (سلامُهُ علينا) واسمُهُ حَنانيّا، فجاءَهُ عيسى (سلامُهُ علينا) في الرُّؤيا قائِلاً: "يا حَنانيّا!" فأجابَهُ: "لَبَّيكَ سَيِّدي!" <verse eid="ACT 9:10" /><verse number="11" style="v" sid="ACT 9:11" />فقالَ لهُ السّيِّدُ المَسيحُ (سلامُهُ علينا): "اِذهَبْ إلى الشَّارعِ المُستَقيمِ، واسألْ في دارِ يَهوذا عن رَجُلٍ مِن مَدينةِ طَرْسوسَ اسمُهُ شاولُ، وهو يُصَلّي الآن، <verse eid="ACT 9:11" /><verse number="12" style="v" sid="ACT 9:12" />وقد جاءَهُ في الرُّؤيا أنّهُ سيَلتَقي رَجُلاً اسمُهُ حَنانيّا يَضَعُ يديهِ عليهِ ليَعودَ إليه بَصَرُهُ". <verse eid="ACT 9:12" /><verse number="13" style="v" sid="ACT 9:13" />فأجابَ حَنانيّا: "يا سَيِّدي، قد سَمِعتُ مِنَ الكَثيرينَ عن شاولَ هذا وعَنِ الأذى الّذي ألحَقَهُ بأفرادِ أُمَّتِكَ في القُدسِ، <verse eid="ACT 9:13" /><verse number="14" style="v" sid="ACT 9:14" />كَما سَمِعتُ بأنّهُ إنّما جاءَ إلى دِمَشقَ بإذنٍ مِن رُؤساءِ الأحبارِ للقَبضِ على كُلِّ أتباعِكَ هُنا". <verse eid="ACT 9:14" /><verse number="15" style="v" sid="ACT 9:15" />فأجابَهُ سَيِّدُنا عيسى (سلامُهُ علينا): "اِذهَبْ إليهِ، فهو الّذي اختَرتُهُ ليَكونَ رَسولي ليَزُفَّ رِسالتي إلى شُعوبِ الأرضِ ومُلوكِهِم، ولِبَني يَعقوبَ، <verse eid="ACT 9:15" /><verse number="16" style="v" sid="ACT 9:16" />وسأُعَلِّمُهُ مَدى الآلامِ الّتي يَجِبُ أن يَتَحَمَّلَها مِن أجلي".<verse eid="ACT 9:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="ACT 9:17" />فتَوَجَّهَ حَنانيّا إلى تِلكَ الدّارِ، ووَضَعَ يَديهِ على شاولَ قائلاً: "يا أخي شاولُ، أرسَلَني إليكَ سَيِّدُنا عيسى نَفسُهُ الّذي جاءَكَ في الرُّؤيا وأنتَ في طَرِيقِكَ إلى هُنا، حتّى يَعودَ إليكَ البَصَرُ وتَمتَلئَ ذاتُكَ برُوحِ اللهِ". <verse eid="ACT 9:17" /><verse number="18" style="v" sid="ACT 9:18" />وما إن أتَمَّ حَنانيّا كَلامَهُ حتّى تَناثَرَ شَيءٌ يُشبِهُ القُشورَ مِن عَينَي شاول، وعادَ إليهِ بَصَرُهُ. فقامَ في الحالِ وتَطَهَّرَ بالماءِ، <verse eid="ACT 9:18" /><verse number="19" style="v" sid="ACT 9:19" />ثُمَّ تَناوَلَ بَعضَ القُوتِ لاستِعادةِ عافيَتِهِ. وقَضَّى بِضعَةَ أيّامٍ صُحبَةَ أتباعِ سَيّدِنا عِيسى (سلامُهُ علينا) في دِمَشقَ.<verse eid="ACT 9:19" /></para>
  <para style="s">شاول في دمشق</para>
  <para style="p">
    <verse number="20" style="v" sid="ACT 9:20" />ثُمَّ خَرَجَ شاولُ بَعدَ ذلِكَ إلى بُيوتِ العِبادةِ، مُناديًا أنّ عيسى (سلامُهُ علينا) هو الابنُ الرُّوحيُّ للهِ، <verse eid="ACT 9:20" /><verse number="21" style="v" sid="ACT 9:21" />فاندَهَشَ كُلُّ مَن سَمِعَهُ وصاروا يَقولونَ: "ألَيسَ هذا الشّخصُ هو الّذي كانَ يَفتِكُ بأتباعِ عيسى النَّاصِريّ في القُدس، ألَيسَ هو الّذي جاءَ إلى هُنا بغَايةِ القَبضِ عليهِم ليسُوقَهُم إلى القُدسِ للمُثولِ أمامَ مَحكمَةِ رؤساءِ الأحبارِ؟" <verse eid="ACT 9:21" /><verse number="22" style="v" sid="ACT 9:22" />أمّا شاولُ فقد كانَ يَزدادُ قوّةً في دَعوتِهِ، مُفحِمًا اليَهودَ المُقيمينَ في دِمَشقَ بالأدلّةِ الّتي كانَ يأتي بها مِنَ الكُتُبِ السّماويّةِ ليُبَرهِنَ على أنّ عيسى هو المَسيحُ المُنتَظَرُ. <verse eid="ACT 9:22" /><verse number="23‏-24" style="v" sid="ACT 9:23-24" />ومَعَ الوَقتِ،<note caller="+" style="f"><char style="fr" closed="false">9‏.23‏-24 </char><char style="ft" closed="false">نعلم من رسائل بولس أنّه غاب عن دمشق لمدّة 3 سنوات، وخلالها مكث في البلاد العربيّة، أي المملكة النبطية، التي تقع في منطقة الأردن الحديث وجنوب سوريا، قبل أن يعود في النهاية إلى دمشق.</char></note> بدَأ اليَهودُ يَتآمرُونَ عليهِ، فكانوا يُراقِبونَ بَوّاباتِ المَدينةِ لَيلاً نَهارًا ليَقتُلوهُ عِندَ مُغادَرتِها. وسَمِعَ شاولُ بهذِهِ المُؤامَرةِ، <verse eid="ACT 9:23-24" /><verse number="25" style="v" sid="ACT 9:25" />فتهَيّأت جَماعةٌ مِمَّن آمَنوا بالمَسيحِ بواسطةِ دَعوتِهِ لِتَهريبِهِ ليلاً بإنزالِهِ مِن على السُّورِ في سَلّةٍ كَبيرةٍ.<note caller="+" style="f"><char style="fr" closed="false">9‏.25 </char><char style="ft" closed="false">كان هذا الفعل ممكنًا، إذ لجأ الناس في ذلك الوقت بسبب كثرة سكان المدينة، إلى بناء المزيد من المنازل فوق سور المدينة، وبالإمكان رؤية ذلك الآن عند الباب الشرقي في مدينة دمشق.</char></note> ونَجَحوا في ذلِكَ.<verse eid="ACT 9:25" /></para>
  <para style="s">شاول في القدس</para>
  <para style="p">
    <verse number="26" style="v" sid="ACT 9:26" />وعِندَ وُصولِ شاولَ إلى القُدسِ، حاوَلَ الانضِمامَ إلى جَماعةِ المُؤمنينَ، ولكنّهُم كانوا على حَذَرٍ مِنهُ، إذ لم يَكونوا قد أيقَنُوا بَعدُ بِحَقِيقةِ إيمانِهِ. <verse eid="ACT 9:26" /><verse number="27" style="v" sid="ACT 9:27" />ولكنّ بَرنابا اصطَحَبَهُ إلى الحَواريِّينَ ليُبَيِّنَ لهُم كَيفَ رَأى سَيِّدَنا عيسى (سلامُهُ علينا) في طَريقِهِ إلى دِمَشقَ، وكَيفَ تَحَدَّثَ عيسى مَعَهُ، وكَيفَ بَدَأ بنَفسِهِ يُعلِنُ بجُرأةٍ رِسالةَ سَيِّدِنا عيسى (سلامُهُ علينا). <verse eid="ACT 9:27" /><verse number="28" style="v" sid="ACT 9:28" />وَاطمَأنَّ إليهِ الحَواريّونَ فأقامَ عِندَهُم، مُتَنَقِّلاً مَعَهُم في القُدسِ مُناديًا بعيسى (سلامُهُ علينا) بشَجاعةٍ.<note caller="+" style="f"><char style="fr" closed="false">9‏.28 </char><char style="ft" closed="false">حسب كتابات الحواري بولس، لم يبق في القدس أكثر من أسبوعين خلال هذه الزيارة.</char></note> <verse eid="ACT 9:28" /><verse number="29" style="v" sid="ACT 9:29" />وكانَ شاولُ كَثيرَ الجَدَلِ مَعَ اليَهودِ القادِمينَ مِنَ البُلدانِ الأجنَبيّةِ الوَاقعةِ غَربَ فِلَسطين، مِمَّن صَمَّموا على قَتلِهِ.<note caller="+" style="f"><char style="fr" closed="false">9‏.29 </char><char style="ft" closed="false">أتى هؤلاء اليهود من بلاد حوض البحر الأبيض المتوسّط التي تسود فيها اللغة اليونانية. وسيدنا المسيح حسب سيرة الحواريين 22: 17‏-21، أنذر بولس عن هذه المؤامرة من خلال رؤيا.</char></note> <verse eid="ACT 9:29" /><verse number="30" style="v" sid="ACT 9:30" />فعَلِمَ إخوانُهُ المُؤمِنونَ بذلِكَ، وأخَذوهُ إلى مِيناءِ قَيصريّة، ومِن ثَمَّ أرسَلَوهُ إلى مَدينةِ طَرْسوس.<verse eid="ACT 9:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="ACT 9:31" />وهكذا بَدأت جَماعاتُ المُؤمنينَ في بِلادِ يَهوذا والجَليلِ والسّامِرةِ تَنعَمُ بالطُّمأنينةِ والسَّلامِ، وكانَت هَيبةُ سَيِّدِنا عيسى (سلامُهُ علينا) تَتزَايدُ لَدَيهِم، كَما كانَ عَدَدُهُم يَتَضاعَفُ بمُؤازَرةِ رُوحِ اللهِ.<verse eid="ACT 9:31" /></para>
  <para style="s">شفاء أنيس</para>
  <para style="p">
    <verse number="32" style="v" sid="ACT 9:32" />وكانَ بُطرُسُ يُسافِرُ في أنحاءِ فِلَسطينَ مُتَجَوِّلاً مِن مَكانٍ إلى مَكانٍ يَزورُ أتباعَ السّيِّدِ المَسيحِ (سلامُهُ علينا)، وذاتَ مَرَّةٍ وبَينَما كانَ في زيارةٍ لِمُؤمِني بَلدةِ اللُّدّ،<note caller="+" style="f"><char style="fr" closed="false">9‏.32 </char><char style="ft" closed="false">كانت اللُّدّ بلدة تقع بين القدس ويافا.</char></note> <verse eid="ACT 9:32" /><verse number="33" style="v" sid="ACT 9:33" />صادَفَ رَجُلاً مَشلولاً اسمُهُ أنيس، وكانَ طَريحَ الفِراشِ مُنذُ ثَماني سَنَواتٍ، <verse eid="ACT 9:33" /><verse number="34" style="v" sid="ACT 9:34" />فالتَفَتَ إليهِ بُطرُسُ الصَّخرُ مُخاطِبًا: "يا أنيسُ، لقد شَفاكَ سَيِّدُنا عيسى المَسيحُ، فانهَضْ ورَتِّبْ فِراشَكَ بنَفسِكَ". فقامَ أنيسُ مُعافىً، <verse eid="ACT 9:34" /><verse number="35" style="v" sid="ACT 9:35" />وعِندَما رأى سُكّانُ اللُّدِّ ومِنطقةِ ساحِلِ فِلَسطينَ ذلِكَ، آمَنوا جَميعًا بسَيِّدِنا عيسى (سلامُهُ علينا).<verse eid="ACT 9:35" /></para>
  <para style="s">إحياء غزالة بعد موتها</para>
  <para style="p">
    <verse number="36" style="v" sid="ACT 9:36" />وكانَ، في ذلِكَ الوَقتِ، في مَدينةِ يافا<note caller="+" style="f"><char style="fr" closed="false">9‏.36 </char><char style="ft" closed="false">تقع يافا على شاطئ البحر وهي حاليًا إحدى ضواحي تل أبيب الحديثة.</char></note> امرأةٌ مِن أتباعِ عيسى (سلامُهُ علينا) اسمُها طابيتَهْ ويَعني غَزالة، وكانَت تُحسِنُ إلى الجَميعِ وتُساعِدُ المُحتاجينَ على الدَّوامِ، <verse eid="ACT 9:36" /><verse number="37" style="v" sid="ACT 9:37" />فأصابَها المَرَضُ وماتَت. فغَسَّلوا جُثمانَها ووَضَعوهُ في غُرفةٍ في طابقٍ عُلويٍّ، <verse eid="ACT 9:37" /><verse number="38" style="v" sid="ACT 9:38" />وقد سَمِعَ المُؤمِنونَ بوُجُودِ بُطرُسَ الصَّخر في اللُّدِّ الّتي كانَت قَريبةً مِن يافا، فأرسَلوا إليهِ رَجُلينِ يَحمِلانِ رسالةً تَقولُ: "نَرجو مِنكَ أن تأتيَ إلينا على جَناحِ السُّرعةِ". <verse eid="ACT 9:38" /><verse number="39" style="v" sid="ACT 9:39" />فاستَجابَ بُطرُسُ لطَلَبِهِم، وعِندَ وُصولِهِ مَدينةَ يافا، اقتادُوهُ إلى حَيثُ كانَت غزالةُ مُسجّاةً، فتَجَمَّعَت حَولَهُ الأرامِلُ باكِياتٍ حُزنًا عليها، وأرَينَهُ القُمصانَ والثّيابَ الّتي حاكَتها غَزالة عِندَما كانَت على قيدِ الحَياةِ. <verse eid="ACT 9:39" /><verse number="40" style="v" sid="ACT 9:40" />حِينَئذٍ أخرَجَ بُطرسُ الصَّخرُ جَميعَ مَن كانوا في الغُرفةِ، ورَكَعَ لِلَّهِ مُصَلِّيًا، ثُمَّ التَفَتَ إلى الجُثمانِ قائِلاً: "يا غَزالةُ قومي!" ففَتَحَتِ المَرأةُ عَينَيها، ثُمَّ جَلَسَت بَعدَ أن رَأتْ بُطرُسَ، <verse eid="ACT 9:40" /><verse number="41" style="v" sid="ACT 9:41" />فمَدَّ لها يدَهُ وأنهَضَها، ودَعا المُؤمِنينَ والأرامِلَ ليُبَيِّنَ لهُم أنّ غَزالةَ قد عادَت إلى الحَياةِ مِن جَديدٍ. <verse eid="ACT 9:41" /><verse number="42" style="v" sid="ACT 9:42" />وانتَشَرَ خَبَرُ تِلكَ المَرأةِ في جَميعِ أنحاءِ يافا، مِمّا جَعَلَ الكَثيرينَ يُؤمِنونَ بالسّيِّدِ المَسيحِ (سلامُهُ علينا). <verse eid="ACT 9:42" /><verse number="43" style="v" sid="ACT 9:43" />ومَكَثَ بُطرسُ بَعضَ الوقتِ في يافا عِندَ شَخصٍ يَعمَلُ بالدِّباغةِ اسمُهُ سَمعانُ.<note caller="+" style="f"><char style="fr" closed="false">9‏.43 </char><char style="ft" closed="false">تجنّب المتشددون أناسًا أمثال سمعان الدبّاغ لأنّ عمله كان قذراً وتنتج عنه روائح كريهة، واستخدامه للجلود الحيوانية يعني أنّه كان في احتكاكٍ دائمٍ مع الجثث غير الطاهرة. أمّا بطرس، فهو لم يتردّد قط في المكوث عنده.</char></note><verse eid="ACT 9:43" /></para>
  <chapter eid="ACT 9" />
  <chapter number="10" style="c" sid="ACT 10" />
  <para style="cl">الفصل العاشر</para>
  <para style="s">كُورنيليوس</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 10:1" />وفي مَدينةِ قَيصريّة كانَ رَجُلٌ رُومانيٌّ اسمُهُ كورْنيليوسُ، وهو ضابِطٌ على الكَتيبةِ الإيطاليّة،<note caller="+" style="f"><char style="fr" closed="false">10‏.1 </char><char style="ft" closed="false">كانت مدينة القيصرية مركز قيادة جيش الاحتلال الروماني.</char></note> <verse eid="ACT 10:1" /><verse number="2" style="v" sid="ACT 10:2" />وكانَ هو وأهلُ بيتِهِ وَرِعينَ يَخافونَ اللهَ، وهو كَثيرُ التَّصَدُّقِ على ذَوِي الحاجةِ مِن بَني يَعقوبَ وكَثيرُ الصَّلاةِ والعِبادَةِ للهِ.<note caller="+" style="f"><char style="fr" closed="false">10‏.2 </char><char style="ft" closed="false">لم يكن كورنيليوس يهوديًا، ولذلك لم يكن مختونًا، وكان الختان أحد الشروط لكي يصبح الرجل يهوديًا. أمّا كورنيليوس فكان تقيًا وآمن بما جاء في التوراة وغيرها من كتب الأنبياء. وكان هناك العديد من الرجال والنساء الذين آمنوا مثله بتعاليم اليهودية، ولكنّهم لم يستطيعوا قبول جميع التقاليد التي كانت تُطلب منهم ليصبحوا يهودًا.</char></note> <verse eid="ACT 10:2" /><verse number="3" style="v" sid="ACT 10:3" />وذاتَ يومٍ خِلالَ وَقتِ العَصرِ، تَجَلَّى لهُ مَلاكٌ في رُؤيا <note caller="+" style="f"><char style="fr" closed="false">10‏.3 </char><char style="ft" closed="false">إنّ الرؤيا تشبه الحلم، ومصدرها اللّه، وهي تحصل عندما يكون الشخص يقظًا أو نائمًا على حدٍّ سواء.</char></note> وقالَ لهُ: "كُورنيليوسُ". <verse eid="ACT 10:3" /><verse number="4" style="v" sid="ACT 10:4" />فحَدَّقَ إليهِ هذا الأخيرُ خائفًا وأجابَهُ: "ما الأمرُ يا سَيِّدي؟" فقالَ لهُ المَلاكُ: "قد تَقَبَّلَ اللهُ مِنكَ صَلواتِكَ وصَدَقاتِكَ، وهو رَاضٍ عَنكَ. <verse eid="ACT 10:4" /><verse number="5" style="v" sid="ACT 10:5" />فَقُمْ وأرسِلْ بَعضَ الرِّجالِ إلى مَدينةِ يافا، واستَدعِ سَمعانَ، المُلَقَّبَ ببُطرُسَ الصَّخر، <verse eid="ACT 10:5" /><verse number="6" style="v" sid="ACT 10:6" />فقد نَزَلَ ضَيفًا عِندَ سَمعانَ الدَّبّاغ في دارِهِ على شاطِئ البَحرِ". <verse eid="ACT 10:6" /><verse number="7" style="v" sid="ACT 10:7" />وعِندَما انصَرَفَ المَلاكُ، دَعا كُورنيليوسُ اثنينِ مِن خَدَمِهِ وجُنديًّا مِن مُساعِدِيهِ كانَ على جَانبٍ كَبيرٍ مِنَ التَّقوى، <verse eid="ACT 10:7" /><verse number="8" style="v" sid="ACT 10:8" />وحَدَّثَهُم بِكُلِّ ما رَأى، ثُمَّ أرسَلَهُم إلى يافا.<note caller="+" style="f"><char style="fr" closed="false">10‏.8 </char><char style="ft" closed="false">تبعد مدينة يافا عن مدينة قيصرية بحوالي 48 كيلومتر باتّجاه الجنوب.</char></note><verse eid="ACT 10:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="ACT 10:9" />وفي اليَومِ التّالي وبَينَما كانوا على مَقرُبةٍ مِنَ المَدينةِ، صَعِدَ بُطرسُ إلى السَّطحِ ليُصَلِّي خِلالَ وَقتِ الظُّهرِ،<note caller="+" style="f"><char style="fr" closed="false">10‏.9 </char><char style="ft" closed="false">في ذلك الوقت، كانت صلوات اليهود تقام في الصباح وفي العصر، وكانت هناك صلاة إضافية تقام في الظهر أو في المغرب.</char></note> <verse eid="ACT 10:9" /><verse number="10" style="v" sid="ACT 10:10" />فأخَذَ مِنهُ الجُوعُ كُلَّ مَأخذٍ، وبَينَما كانوا يُجَهِّزونَ الطَّعامَ، رُفِعَ عَنهُ الحِجابُ.<note caller="+" style="f"><char style="fr" closed="false">10‏.10 </char><char style="ft" closed="false">رفع الحجاب هو انكشاف عالم الغيب للناظر ولا يكون ذلك إلا للرسل والأنبياء والأولياء.</char></note> <verse eid="ACT 10:10" /><verse number="11" style="v" sid="ACT 10:11" />فرَأى السَّماءَ وقدِ انشَقَّت، ومُلاءَةً كَبيرةً مَعقودَةً مِن أطرافِها الأربَعةِ مُدَلاّةً إلى الأرضِ، <verse eid="ACT 10:11" /><verse number="12" style="v" sid="ACT 10:12" />مَملوءَةً بجَميعِ أنواعِ الحَيواناتِ مِن دَوابّ وزَواحِف وطُيور، <verse eid="ACT 10:12" /><verse number="13" style="v" sid="ACT 10:13" />وسَمِعَ هاتِفًا يَقولُ: "قُم يا بُطرُسُ اِذبَحْ وكُلْ". <verse eid="ACT 10:13" /><verse number="14" style="v" sid="ACT 10:14" />فأجابَ بُطرسُ: "لا يا سَيِّدي! إنّ مِن بَينَ تِلكَ الحَيواناتِ ما هو مُحَرَّمٌ أكلُهُ! وأنا لم آكُل في حَياتي حَرامًا بل كانَ طَعامي دائِمًا حَلالاً". <verse eid="ACT 10:14" /><verse number="15" style="v" sid="ACT 10:15" />فأعادَ الهاتِفُ عليهِ القَولَ ثانيَةً: "ما طَهَّرَهُ اللهُ، لاَ تُنَجِّسْهُ أنتَ". <verse eid="ACT 10:15" /><verse number="16" style="v" sid="ACT 10:16" />وتَكَرَّرَ ذلِكَ ثَلاثَ مَرّاتٍ، ثُمَّ ارتَفَعَتِ المُلاءةُ إلى السَّماءِ، وأفاقَ بُطرسُ.<verse eid="ACT 10:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="ACT 10:17" />وبَينَما كانَ غارِقًا في حَيرتِهِ يَتَساءَلُ عَن مَعنى ما رَأى، كانَ الرِّجالُ الّذينَ جَاؤوا مِن عِندَ كورْنيليوسَ عِندَ البابِ يَسألونَ عن دارِ سَمعانَ الدّبَّاغ. <verse eid="ACT 10:17" /><verse number="18" style="v" sid="ACT 10:18" />وعِندَما وَصَلوا أخَذوا يُنادونَ سائِلينَ: "هل حَلَّ بَينَكُم ضَيفٌ اسمُهُ بُطرُسُ؟" <verse eid="ACT 10:18" /><verse number="19" style="v" sid="ACT 10:19" />وبَينَما كانَ بُطرسُ غارِقًا في أفكارِهِ يُحاوِلُ تَفسيرَ مَعنى ما جَاءَتهُ بِهِ الرُّؤيا، جاءَهُ وَحيٌ مِن رُوحِ اللهِ يُخبِرُهُ: "جاءَ ثَلاثةُ رِجَالٍ في طَلَبِكَ، <verse eid="ACT 10:19" /><verse number="20" style="v" sid="ACT 10:20" />فقُمْ وقابِلْهُم واِذهبْ مَعَهُم بِلا تَرَدُّدٍ فأنا أرسَلتُهُم إليكَ". <verse eid="ACT 10:20" /><verse number="21" style="v" sid="ACT 10:21" />فاستَجابَ بُطرُسُ ونَزَلَ إلى الرِّجالِ وقالَ لهُم: "أنا مَن جِئتُم تَطلُبونَ، فما سَبَبُ مَجيئِكُم؟" <verse eid="ACT 10:21" /><verse number="22" style="v" sid="ACT 10:22" />فأجَابَهُ الرِّجالُ: "قَدِمنا بِطَلَبٍ مِن كُورنيليوسَ الضّابطِ الرُّومانيّ. وهو الرَّجُلُ الصّالحُ التَّقيُّ، الّذي يَحتَرِمُهُ بَنو يَعقوبَ، وقد جاءَهُ مَلاكٌ طَلَبَ مِنهُ استِدعاءَكَ لسَماعِ ما عِندَكَ مِن كَلامٍ".<note caller="+" style="f"><char style="fr" closed="false">10‏.22 </char><char style="ft" closed="false">لم يستطع بطرس قبول دعوة كورنيليوس للمكوث عنده بسهولة لأنّ اليهود كانوا يعتبرون أنّ دخول بيت إنسانٍ غير يهودي ينجّسهم. وقد عرف بطرس أنّ الذين آمنوا بالسيد المسيح من اليهود كانوا لا يزالون متشدّدين فيما يخصّ التقاليد اليهودية، وأنّهم كانوا سينتقدونه لدخوله بيت أجنبي.</char></note> <verse eid="ACT 10:22" /><verse number="23" style="v" sid="ACT 10:23" />فاستَجابَ بُطرسُ الصَّخرُ لِطَلَبِهِم واستَضافَهُم في تِلكَ اللَّيلةِ.<verse eid="ACT 10:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="ACT 10:24" />وفي اليَومِ التّالي رَحَلَ مَعَهُم، ومَعَهُ بَعضُ المُؤمِنينَ مِن يافا. <verse eid="ACT 10:24" /><verse number="25" style="v" sid="ACT 10:25" />وعِندَ وصُولِهِم إلى مَدينةِ قَيصرِيّةٍ بَعدَ يومٍ مِن السَّفَرِ، كانَ كُورنيليُوسُ في انتِظارِهِم وقد دَعا بَعضًا مِن أقاربِهِ وأصدقائِهِ المُقَرَّبينَ لكي يَستَمِعوا إلى بُطرُسَ. ولمّا وَصَلَ بُطرسُ ومَن مَعَهُ إلى الدّارِ، خَرَجَ كُورنيليوسُ لاستِقبالِهِ، ورَمى بِنَفسِهِ عِندَ قدَمَيهِ، ساجِدًا أمامَهُ، <verse eid="ACT 10:25" /><verse number="26" style="v" sid="ACT 10:26" />فأنهَضَهُ بسُرعةٍ قائِلاً: "قُم حالاً! إنّما أنا مُجَرَّدُ إنسانٍ مِثلُكَ!" <verse eid="ACT 10:26" /><verse number="27" style="v" sid="ACT 10:27" />ودَخَلَ وإيّاهُ وتَبادَلا الحَديثَ، فوَجَدَ بُطرسُ حَشدًا مِنَ النّاسِ،<note caller="+" style="f"><char style="fr" closed="false">10‏.27 </char><char style="ft" closed="false">لم يمنع التقليد اليهودي دخول بيوت غير اليهود فحسب، بل منع أيضًا تناول الطعام والشراب معهم. يعني هذا أنّ اليهود المتشدّدين كانوا يمنعون اليهود من تناول الطعام الذي جهّزه غير اليهود، ولذلك كان الناس من بقيّة الأمم يشعرون أنّ اليهود غير اجتماعيين. ولكنّ الله أوحى إلى بطرس بضرورة تغيير هذه العادات بين أتباع السيد المسيح.</char></note> <verse eid="ACT 10:27" /><verse number="28" style="v" sid="ACT 10:28" />فخَاطَبَهُم قائِلاً: "أنتُم تَعلَمونَ جَميعًا تَقاليدَنا الّتي تَمنَعُ اليَهوديَّ مِنَ التَّعامُلِ مَعَ غَيرِ اليَهوديِّ ومِن زِيارتِهِ، إلاّ أنّ اللهَ تَعالى بَيَّنَ لي أنّ الإنسانَ مِن أيِّ شَعبٍ كانَ لَيسَ نَجِسًا ولا مَرفوضًا، <verse eid="ACT 10:28" /><verse number="29" style="v" sid="ACT 10:29" />لِذلِكَ جِئتُكُم دونَ اعتِراضٍ عِندَما أرسَلتُم في طَلَبي. والآنَ أسألُكم لِمَ أرسَلتُم في طَلَبي؟" <verse eid="ACT 10:29" /><verse number="30" style="v" sid="ACT 10:30" />فأجابَهُ كُورنيليوسُ بقَولِهِ: "بَينَما كُنتُ، مُنذُ أربَعةِ أيّامٍ، أُصَلّي عَصرًا في داري، ظَهَرَ أمامي فَجأةً رَجُلٌ عليهِ ثيابٌ بَرّاقَةٌ وأخبَرَني: <verse eid="ACT 10:30" /><verse number="31" style="v" sid="ACT 10:31" />"أيا كُورنيليُوسُ، قد تَقَبَّلَ اللهُ صَلاتَكَ وصَدَقاتِكَ ورَضِيَ عَنكَ، <verse eid="ACT 10:31" /><verse number="32" style="v" sid="ACT 10:32" />فأرسِلْ برِجالٍ إلى مَدينةِ يافا لاستِدعاءِ رَجُلٍ اسمُهُ بُطرسُ، إنّهُ يَنزِلُ ضَيفًا في دارِ سَمعانَ الدَّبّاغ على شاطئ البَحرِ". <verse eid="ACT 10:32" /><verse number="33" style="v" sid="ACT 10:33" />وهكذا فَعَلتُ، فأرسَلتُ أستَدعِيكَ فَورًا، ولقَد فَعَلتَ حَسَنًا بأنِ استَجَبتَ، وها نَحنُ الآنَ مُجتَمِعونَ في حَضرةِ اللهِ لِنَستمِعَ إلى كُلِّ ما أمَرَكَ اللهُ بِهِ".<verse eid="ACT 10:33" /></para>
  <para style="s">كلمة بـطرس</para>
  <para style="p">
    <verse number="34" style="v" sid="ACT 10:34" />وجَلَسَ بُطرُسُ الصَّخرُ ليُحَدِّثَهُم فقالَ: "لقد تَيَّقَنتُ الآن أنّ النّاسَ جَميعًا سَواسيَةٌ عِندَ اللهِ، <verse eid="ACT 10:34" /><verse number="35" style="v" sid="ACT 10:35" />وأقرَبُهُم إليهِ أتقاهُم وأصلَحُهُم للنَّاسِ، مَهما كانَ جِنسُهُ. <verse eid="ACT 10:35" /><verse number="36" style="v" sid="ACT 10:36" />لقد سَمِعتُم بِلا شَكٍّ عنِ البِشارَةِ الّتي بَعَثَها اللهُ إلى بَني يَعقوبَ، الّتي تُعلِنُ بأنّ التَّقَرُّبَ إلى اللهِ تَعالى لا يَكونُ إلاّ مِن خِلالِ عيسى المَسيحِ سَيِّدِ جَميعِ البَشَرِ. <verse eid="ACT 10:36" /><verse number="37" style="v" sid="ACT 10:37" />وقد سَمِعتُم أيضًا ما حَدَثَ في أطرافِ فِلَسطين، حَيثُ كانَتِ بِدايةُ رِسالةِ عيسى في مِنطَقةِ الجَليلِ بَعدَ التَّطَهُّرِ بالماءِ حَسَبَ دَعوةِ النّبيِّ يَحيى. <verse eid="ACT 10:37" /><verse number="38" style="v" sid="ACT 10:38" />وعَلِمتُم أنّ اللهَ تَعالى اختارَ، في الوَقتِ عَينِهِ، عيسى النّاصِريَّ فوَهَبَهُ قوّتَهُ ورُوحَهُ القُدّوسَ، وكانَ مَعَهُ أينَما حَلَّ، لقد كانَ (سلامُهُ علينا) يَجوبُ كُلَّ الأماكنِ لِيَعمَلَ الخَيرَ ولِيُبرئَ كُلَّ مَن كانَ تَحتَ سَطوةِ الشَّيطانِ. <verse eid="ACT 10:38" /><verse number="39" style="v" sid="ACT 10:39" />ولقد شاهَدنا، نَحنُ الحَواريُّونَ، كُلَّ الأعمالِ الّتي قامَ بها سَيِّدُنا عيسى في البِلادِ الّتي يَسكُنُ فيها اليَهودُ، إضافةً إلى القُدسِ، كَما شاهَدنا كَيفَ قَتَلوهُ صَلبًا. <verse eid="ACT 10:39" /><verse number="40" style="v" sid="ACT 10:40" />ولكنَّ اللهَ بَعَثَهُ حيًّا بَعدَ ثَلاثَةِ أيّامٍ وأظهَرَهُ <verse eid="ACT 10:40" /><verse number="41" style="v" sid="ACT 10:41" />للَّذينَ اختارَهُم اللهُ مِن قَبلُ ليَكونوا شُهودًا، ولَيسَ لِكُلِّ الشَّعبِ. ونحنُ الشُّهودُ الَّذينَ أكَلنا وشَرِبنا مَعَهُ بَعدَ أن بَعَثَهُ اللهُ حيًّا. <verse eid="ACT 10:41" /><verse number="42" style="v" sid="ACT 10:42" />ثُمَّ جاءَ الأمرُ الرَّبّانيُّ بأن نَقومَ بتَبليغِ النّاسِ الرِّسالةَ مُعلِنينَ أنّ عيسى (سلامُهُ علينا) هو الّذي عَيَّنَهُ اللهُ تَعالى دَيّانًا للأحياءِ والأمواتِ. <verse eid="ACT 10:42" /><verse number="43" style="v" sid="ACT 10:43" />ولهُ يَشهَدُ جَميعُ الأنبياءِ أنّ كُلَّ مَن يُؤمِنُ بِهِ تُغفَرُ ذُنوبُهُ بشَفاعَتِهِ".<verse eid="ACT 10:43" /></para>
  <para style="s">حلول روح الله في المؤمنين</para>
  <para style="p">
    <verse number="44" style="v" sid="ACT 10:44" />وبَينَما كانَ بُطرُسُ الصَّخرُ يُتابِعُ حَديثَهُ، حَظِي الحُضورُ المُنصِتونَ للرِّسالةِ بحُلولِ رُوحِ اللهِ، <verse eid="ACT 10:44" /><verse number="45" style="v" sid="ACT 10:45" />فأخَذَتِ الدَّهشةُ المُؤمِنينَ مِن بَني يَعقوبَ الّذينَ كانوا برِفقةِ بُطرُسَ، لأنّ اللهَ أفاضَ على غَيرِ اليَهودِ هِبَةَ رُوحِهِ القُدُّوسِ،<note caller="+" style="f"><char style="fr" closed="false">10‏.45 </char><char style="ft" closed="false">إلى ذلك الحين، لم تحلّ روح الله إلاّ على اليهود والسامريين ومن انضمّ إلى الديانة اليهودية دون سواهم. لذلك عندما أعطى اللّه روحه تقدّس وتعالى لغير اليهود، أي غير المختونين، فقد أعلن بذلك قبول الأمم كأعضاء من قوم ميثاقه أيضًا.</char></note> <verse eid="ACT 10:45" /><verse number="46" style="v" sid="ACT 10:46" />مِمّا جَعَلَهُم يَتَكَلّمونَ بلُغاتٍ مُختلفَةٍ مُسَبِّحينَ اللهَ. <verse eid="ACT 10:46" /><verse number="47" style="v" sid="ACT 10:47" />فقالَ بُطرُسُ: "هؤلاءِ تَمَتّعوا بِهِبةِ رُوحِ اللهِ مِثلَنا، فمَنِ الّذي يَمنَعُهُم مِنَ التَّطَهُّرِ بالماءِ صِبغةً للهِ، لِلانضِمامِ إلى جَماعةِ سَيِّدِنا عِيسى؟" <verse eid="ACT 10:47" /><verse number="48" style="v" sid="ACT 10:48" />ثُمَّ أمَرَ بتَطَهُّرِهِم بالماءِ باسمِ عِيسى المَسيحِ. وطَلَبَ كُورنيليوسُ ومَن مَعَهُ مِن بُطرُسَ الإقامةَ بَينَهُم بِضعَةِ أيّامٍ.<verse eid="ACT 10:48" /></para>
  <chapter eid="ACT 10" />
  <chapter number="11" style="c" sid="ACT 11" />
  <para style="cl">الفصل الحادي عشر</para>
  <para style="s">بطرس يوضّح ما حدث</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 11:1" />وعَلِمَ الحَواريّونَ والمُؤمنونَ مِن بَني يَعقوبَ في بِلادِ يَهوذا بِتَقَبُّلِ غَيرِ اليَهودِ لرِسالةِ اللهِ وبِإيمانِهِم بسَيِّدِنا عيسى المَسيحِ (سلامُهُ علينا). <verse eid="ACT 11:1" /><verse number="2" style="v" sid="ACT 11:2" />وعِندَ عَودةِ بُطرُسَ الصَّخر إلى القُدسِ أخَذَ المُؤمنونَ مِنَ اليَهودِ يَنتَقِدونَهُ قائِلينَ: <verse eid="ACT 11:2" /><verse number="3" style="v" sid="ACT 11:3" />"كَيفَ دَخَلتَ بَيتَ أُناسٍ أغرابٍ غَيرِ مَختونينَ وأكَلتَ مَعَهُم!؟"<note caller="+" style="f"><char style="fr" closed="false">11‏.3 </char><char style="ft" closed="false">اعترض هؤلاء اليهود الذين آمنوا بالسيد المسيح على علاقة بطرس بأناسٍ غير مختونين، لأنّ الختان علامة اعتناق اليهوديّة، فكان في نظرهم على علاقة بأناسٍ غير طاهرين.</char></note> <verse eid="ACT 11:3" /><verse number="4" style="v" sid="ACT 11:4" />فأخَذَ بُطرُسُ يُوَضِّحُ ما جَرى بِالتّفصيلِ قائلاً: <verse eid="ACT 11:4" /><verse number="5" style="v" sid="ACT 11:5" />"عِندَما كُنتُ في مَدينةِ يافا وبَينَما كُنتُ أُصَلّي رُفِعَ عني الحِجابُ، فرأيتُ شيئًا مِثلَ مُلاءَةٍ كَبيرةٍ تَتدَلّى مِنَ السَّماءِ بأطرافِها الأربَعةِ حتَّى بَلَغَتني، <verse eid="ACT 11:5" /><verse number="6" style="v" sid="ACT 11:6" />فأمعَنتُ النَّظَرَ فيها مُتأمِّلاً، فإذا بها مُمتَلِئةٌ أنواعًا مِنَ الحَيواناتِ والطُّيورِ، ما حَلَّ أكلُهُ وما حَرُمَ، <verse eid="ACT 11:6" /><verse number="7" style="v" sid="ACT 11:7" />ثُمَّ سَمِعتُ هاتِفًا يَقولُ: "قُم يا بُطرُسُ اِذبَح مِنها وكُلْ. <verse eid="ACT 11:7" /><verse number="8" style="v" sid="ACT 11:8" />فقُلتُ: "كَيفَ ذلِكَ يا سَيِّدي، ولم يَدخُلْ جَوفي شَيءٌ مِنَ المُحَرَّماتِ قَطعًا!" <verse eid="ACT 11:8" /><verse number="9" style="v" sid="ACT 11:9" />فهَتَفَ الصَّوتُ قائِلاً: "ما طَهَّرَهُ اللهُ، لا تُنَجِّسْهُ أنتَ". <verse eid="ACT 11:9" /><verse number="10" style="v" sid="ACT 11:10" />مُعيدًا ذلِكَ القَولَ ثَلاثًا. بَعدَ ذلِكَ رُفعَتِ المُلاءَةُ مِن حَيثُ أُنزِلَت. <verse eid="ACT 11:10" /><verse number="11" style="v" sid="ACT 11:11" />وفي ذلِكَ الوَقتِ، وَصَلَ ثَلاثةُ رِجالٍ إلى الدّارِ الّتي كُنتُ مُقيمًا فيها، كانوا قد أُرسِلوا مِن مَدينةِ قَيصريّة لدَعوتي. <verse eid="ACT 11:11" /><verse number="12" style="v" sid="ACT 11:12" />وجاءَني وَحيٌ مِن رُوحِ اللهِ أن أذهَبَ مَعَهُم دونَ تَرَدُّدِ مَعَ كونِهم مِن غَيرِ اليَهودِ، وهذا ما حَدَثَ، إذ رافَقَني مَعَ أولئكَ الرِّجالِ الثّلاثةِ هؤلاءِ المُؤمنونَ السِّتّةُ مِن يافا إلى أن وَصَلنا إلى دارِ رَجُلٍ فدَخَلناها. <verse eid="ACT 11:12" /><verse number="13" style="v" sid="ACT 11:13" />فأخَبرَنا الرَّجُلُ برُؤيتِهِ لمَلاكٍ ظَهَرَ لهُ في دارِهِ قائِلاً لهُ: "أرسِلْ برِجالٍ إلى يافا لاستِدعاءِ سَمعان المُلَقَّبِ ببُطرُسَ الصَّخر، <verse eid="ACT 11:13" /><verse number="14" style="v" sid="ACT 11:14" />وسَيُبَلِّغُكُم رِسالةَ النَّجاةِ لكَ ولِجَميعِ أهلِ بَيتِكَ". <verse eid="ACT 11:14" /><verse number="15" style="v" sid="ACT 11:15" />وما إن شَرعَتُ في تَبليغِها حتّى حَلَّت رُوحُ اللهِ عليهِم، كَما حَدَثَ مَعَنا نَحنُ في أوَّلِ الأمرِ. <verse eid="ACT 11:15" /><verse number="16" style="v" sid="ACT 11:16" />فتَذَكَّرتُ ما كانَ قد أعلَنَهُ سَيِّدُنا عِيسى حِينَ قالَ: "طَهَّرَ النَّبيُّ يَحيى النّاسَ بالماءِ، أمّا أنتُم فسَتُطَهَّرونَ بفَيضٍ مِن رُوحِ اللهِ". <verse eid="ACT 11:16" /><verse number="17" style="v" sid="ACT 11:17" />وأقولُ لكُم: إذا كانَ اللهُ تَعالى قد مَنّ عليهِم بمِثلِ ما مَنَّ بِهِ علينا عِندَما آمَنّا بسَيِّدِنا عِيسى المَسيحِ، فمَن أنا كي أمنَعَ ما قَدَّرَهُ اللهُ؟!"<verse eid="ACT 11:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="ACT 11:18" />وكَفَّ المُؤمِنونَ مِنَ اليهودِ، بَعدَ سَماعِ كَلامِ بُطرُسَ الصَّخر، عَن تَوجيهِ انتِقاداتِهِم لهُ واقتَنَعوا بِكلامِهِ، وسَبَّحوا اللهَ قائلينَ: "لقد أنعَمَ اللهُ بفَضلِهِ حتّى على غَيرِ اليَهودِ، ليَتوبوا عنِ ارتِكابِ الآثامِ فتَكونَ لهُم الحَياةُ في دارِ الخُلدِ!"<note caller="+" style="f"><char style="fr" closed="false">11‏.18 </char><char style="ft" closed="false">كان معظم اليهود يؤمنون بأنّ غيرهم من الناس لا يحصلون على النجاة إلا باعتناق الديانة اليهودية. وقد آمن بعضهم الآخر بأنّهم بحاجة فقط إلى الإيمان بالوصايا التي أعطاها اللّه للنبي نوح (عليه السّلام). ولقد بدا واضحًا الآن أنّ اللّه يعامل غير اليهود معاملته اليهود أنفسهم، وأنّه يقبل كل من أصبح من أتباع سيدنا عيسى المسيح.</char></note><verse eid="ACT 11:18" /></para>
  <para style="s">المؤمنون في مدينة أنطاكية</para>
  <para style="p">
    <verse number="19" style="v" sid="ACT 11:19" />وتَشَتّتَ كَثيرٌ مِنَ المُؤمِنينَ في مُختلِفِ بِقاعِ الأرضِ بسَبَبِ الاضطِهادِ الّذي حَلَّ بِهِم بَعدَ مَقتلِ اسطَفان، فتَفَرَّقوا في بِلادِ فينيقيّةَ وقُبرُصَ وأنطاكيةَ، حَيثُ كانوا يُبَشِّرونَ بالرِّسالةِ بَينَ اليَهودِ فَقط. <verse eid="ACT 11:19" /><verse number="20" style="v" sid="ACT 11:20" />إلاّ أنّ البَعضَ مِنهُم وهُم مِن أصلٍ قُبرُصيٍّ وليبيّ، أخَذوا، عِندَ قُدومِهِم إلى أنطَاكية،<note caller="+" style="f"><char style="fr" closed="false">11‏.20 </char><char style="ft" closed="false">كانت مدينة أنطاكية عاصمة مقاطعة سوريا في الإمراطورية الرومانية، ومن أعظم مدنها.</char></note> يَتَحَدّثونَ مَعَ غيرِ اليَهودِ مُبَشِّرينَ بعيسى (سلامُهُ علينا)، <verse eid="ACT 11:20" /><verse number="21" style="v" sid="ACT 11:21" />وكانَ اللهُ يُعينُهُم في ذلِكَ الأمرِ، وهو ما جَعَلَ الكَثيرينَ مِن غَيرِ اليَهودِ يؤمِنونَ ويُصبِحونَ مِن أتباعِ السّيِّدِ المَسيحِ (سلامُهُ علينا).<verse eid="ACT 11:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="ACT 11:22" />وبَلَغَ هذا الخَبَرُ جَماعةً مِنَ المُؤمِنينَ في القُدسِ فأرسَلوا بَرنابا إلى مَدينةِ أنطاكِية. <verse eid="ACT 11:22" /><verse number="23‏-24" style="v" sid="ACT 11:23-24" />وكانَ بَرنابا رَجُلاً صالِحًا مُفعَمًا برُوحِ اللهِ وبالإيمانِ، وعِندَ وصُولِهِ ورُؤيتِهِ كَيفَ مَنَّ اللهُ بفَضلِهِ على هؤلاءِ الأغرابِ، عَلاهُ فَرَحٌ، وأخَذَ يُشَجِّعُ تِلكَ الجَماعاتِ على التَّمَسُّكِ بسَيِّدِنا عيسى (سلامُهُ علينا) بكُلِّ جَوارحِهِم. وانضَمَّ عَدَدٌ كَبيرٌ مِنَ النّاسِ إلى جَماعةِ عيسى (سلامُهُ علينا).<verse eid="ACT 11:23-24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="ACT 11:25" />وغادَرَ بَرنابا أنطاكيّة إلى مَدينةِ طَرْسوسَ يَبحَثُ عن شاولَ، <verse eid="ACT 11:25" /><verse number="26" style="v" sid="ACT 11:26" />وعِندَ عُثورِهِ عليهِ رَجَعَ وإيّاهُ إلى أنطاكية، ومَكَثا هُناكَ سَنةً يَجتَمِعانِ بالمُؤمنينَ ويُعَلِّمانِ عَدَدًا كَبيرًا جِدًّا مِنَ النّاسِ. وفي أنطاكية لُقِّبَ المُؤمِنونَ بعيسى (سلامُهُ علينا) بالمَسِيحيِّينَ لأوّلِ مَرَّةٍ.<note caller="+" style="f"><char style="fr" closed="false">11‏.26 </char><char style="ft" closed="false">أطلق الناس لقب "مسيحيّ" أو "نصير المسيح" على من يؤمن بالسيد المسيح، والسبب يعود إلى كثرة المؤمنين به (سلامُهُ علينا) في أنطاكية من غير اليهود، وبذلك كانوا يتميّزون عن اليهود. إلى ذلك الحين، كان المؤمنون بالمسيح يعتبرون من أتباع أحد مذاهب اليهودية. </char></note><verse eid="ACT 11:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="ACT 11:27" />وتَوَجَّهَ آنذاكَ بَعضُ المُؤمِنينَ الّذينَ لهُم كَراماتُ النُّبوءَةِ مِنَ القُدسِ إلى أنطاكية، <verse eid="ACT 11:27" /><verse number="28" style="v" sid="ACT 11:28" />وهُناكَ أخَذَ واحِدٌ مِنهُم اسمُهُ أغابوسُ يَتَنبَّأُ، بوَحيٍ مِن رُوحِ اللهِ، بِمَجاعةٍ ستَعُمُّ بِلادَ فِلَسطين كُلَّها. ولقد تَحَقَّقَ ذلِكَ فِعلاً في عَهدِ القَيصرِ الرُّومانيّ كُلوديُوسَ. <verse eid="ACT 11:28" /><verse number="29" style="v" sid="ACT 11:29" />وبسَبَبِ نُبوءةِ أغابوسَ تِلكَ، قَرَّرَ أتباعُ المَسيحِ (سلامُهُ علينا) في أنطاكية إرسالَ إعاناتٍ، كُلٌّ حَسَبَ مَقدِرتِهِ لمُساعدَةِ إخوانِهِم مِنَ المُؤمِنينَ في مِنطقةِ يَهوذا. <verse eid="ACT 11:29" /><verse number="30" style="v" sid="ACT 11:30" />وقد أرسَلوها مَعَ شاولَ وبَرنابا اللَذَيْنِ سَلَّمَاها بدورِهِما إلى كِبارِ جَماعةِ المُؤمنينَ هُناكَ.<verse eid="ACT 11:30" /></para>
  <chapter eid="ACT 11" />
  <chapter number="12" style="c" sid="ACT 12" />
  <para style="cl">الفصل الثّاني عشر</para>
  <para style="s">معجزة إنقاذ بطرس</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 12:1" />في تِلكَ الفَترةِ، قامَ المَلِكُ هيرودُسُ أَغْريباسُ<note caller="+" style="f"><char style="fr" closed="false">12‏.1 </char><char style="ft" closed="false">كان أغريباس حفيد الملك هيرودوس الكبير. وعندما كان في الرابعة من عمره، أرسلته أمّه لكي يترعرع في روما. وهناك، صادق أعضاء عائلة الإمبراطور، ومن بينهم غايس كاليغولا. وفي السنة 37 للميلاد، احتلّ غايس عرش الإمبراطورية بعد وفاة طيباريوس، ووهب لصديقه أغريباس عرش البلاد التي كان يحكمها فيليب وليسانيوس في سوريا الجنوبية (انظر لوقا 3: 1)، كما أعطاه لقب "الملك".</char></note> باضطِهادِ عَدَدٍ مِن جَماعاتِ المُؤمنينَ، عازمًا على الإيقاعِ بِهِم وإيذائِهِم. <verse eid="ACT 12:1" /><verse number="2" style="v" sid="ACT 12:2" />فأمَرَ جُنودَهُ بقَتلِ يَعقوبَ الحَواريِّ شَقيقِ يُوحَنّا بحَدِّ السَّيفِ.<note caller="+" style="f"><char style="fr" closed="false">12‏.2 </char><char style="ft" closed="false">كان يحقّ لأغريباس، لأنّه ملك، أن يعدم السجناء (وهو الحقّ الذي لم يكن لمجلس شيوخ اليهود أن يتّخذه لا قبل عهد أغريباس ولا بعده)، وكان الإعدام بالسيف يعتبر أرحم من الصلب، وينفّذ على المواطنين الرومان الذين لم يكونوا مستحقّين (في نظرهم) عار الصليب.</char></note> <verse eid="ACT 12:2" /><verse number="3" style="v" sid="ACT 12:3" />ولمّا رَأى أنّ هذا يُرضي كِبارَ اليَهودِ، قَرَّرَ القَبضَ أيضًا على حَواريٍّ آخَرَ هو بُطرُس، <verse eid="ACT 12:3" /><verse number="4" style="v" sid="ACT 12:4" />وكانَ ذلِكَ في فَترةِ الاحتِفالاتِ بعِيدِ الفِصحِ. فزَجَّ بِهِ في السِّجنِ ووَضَعَهُ تَحتَ حِراسةِ أربَعِ فِرَقٍ مِنَ الجُنودِ، في كُلِّ فِرقةٍ أربَعةٌ مِنَ الجُنودِ، حتّى يُقَدَّمَ للمُحاكمةِ على المَلإ بَعدَ انقِضاءِ أيّامِ العِيدِ. <verse eid="ACT 12:4" /><verse number="5" style="v" sid="ACT 12:5" />وكانَت جَماعاتُ المُؤمنينَ تَجأرُ بدَعواتِها إلى اللهِ دونَ انقِطاعٍ مِن أجلِ بُطرُسَ الصَّخر.<verse eid="ACT 12:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="ACT 12:6" />وكانَ بُطرُسُ وهو في سِجنِهِ في اللَّيلةِ الّتي سَبَقَت مُحاكَمتَهُ نائمًا تَحتَ حِراسةِ اثنَينِ مِنَ الجُنودِ، مُكَبّلاً بسِلسِلَتينِ، وكانَ يَقِفُ على بابِ زِنزانتِهِ عَدَدٌ مِنَ الجُنودِ. <verse eid="ACT 12:6" /><verse number="7" style="v" sid="ACT 12:7" />وفَجأةً أضاءَ نورٌ في أرجاءِ السِّجنِ، وظَهَرَ مَلاكٌ جَسَّ جَنبَ بُطرُسَ وأيقَظَهُ قائِلاً: "قُم يا بُطرُسُ في الحالِ!" فسَقَطَت مِن يَدَيهِ السَّلاسِلُ. <verse eid="ACT 12:7" /><verse number="8" style="v" sid="ACT 12:8" />وتابَعَ المَلاكُ كَلامَهُ إليهِ: "شُدَّ حِزامَكَ، وانتَعِلْ حِذاءَكَ". فاستَجابَ بُطرُسُ، وأضافَ المَلاكُ قائلاً: "ضَعْ عليكَ عَباءَتَكَ واتبَعْني". <verse eid="ACT 12:8" /><verse number="9" style="v" sid="ACT 12:9" />وخَرَجَ بُطرُسُ الصَّخرُ على إثرِ المَلاكِ، ظانًّا أنّهُ في حُلمٍ، غَير مُدرِكٍ أنّ ما يَقَعُ لهُ إنّما يَقَعُ يَقَظةً لا مَنامًا. <verse eid="ACT 12:9" /><verse number="10" style="v" sid="ACT 12:10" />واجتازَ المَلاكُ نُقطَتَيْ الحِراسةِ الأولى والثّانية، وبَلَغَ البابَ الحَديديَّ المُؤدِّيَ إلى المَدينةِ،<note caller="+" style="f"><char style="fr" closed="false">12‏.10 </char><char style="ft" closed="false">من الأرجح أنّ بطرس سُجن في قلعة أنطونيا التي تطلّ أبوابها على الحرم الشريف وعلى المدينة أيضًا.</char></note> فانفَتَحَ البابُ، ونَفَذا مِنهُ إلى الخارجِ، واجتازا شارِعًا واحِدًا ثُمَّ فارَقَ المَلاكُ بُطرُسَ فَجأةً وتَرَكَهُ وَحدَهُ.<verse eid="ACT 12:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="ACT 12:11" />واستَجمَعَ بُطرُسُ الصَّخرُ حِينئِذٍ وَعيَهُ وقالَ في نَفسِهِ: "تأكَّدتُ الآنَ أنّي لَستُ في حُلمٍ، بل إنّ اللهَ أرسَلَ مَلاكًا لإنقاذي مِن قَبضَةِ هيرودُسَ أغريباسَ، ودَفَعَ عنّي الأذى الّذي كانَ سيُلحِقُهُ بي قادةُ اليَهودِ". <verse eid="ACT 12:11" /><verse number="12" style="v" sid="ACT 12:12" />ثُمَّ تَوَجَّهَ بُطرُسُ عِندئذٍ إلى دارِ مَريمَ أُمِّ يُوحَنّا المَعروفِ باسمِ مَرقُس، وكانَ فيها عَدَدٌ كَبيرٌ مِنَ المُؤمنينَ للصَّلاةِ. <verse eid="ACT 12:12" /><verse number="13" style="v" sid="ACT 12:13" />وطَرَقَ بُطرُسُ البابَ الخارجيَّ، فدَلَفَت الخادِمةُ رَوضةُ لتَعرِفَ مَنِ الطّارِقُ، <verse eid="ACT 12:13" /><verse number="14" style="v" sid="ACT 12:14" />ومَيَّزَت صَوتَ بُطرُسَ، لكن لِشِدَّةِ فَرَحِها لم تَفتَحِ البابَ، بل جَرَت لإخبارِ مَن في الدّاخلِ قائلةً: "بُطرُسُ عِندَ البَابِ!" <verse eid="ACT 12:14" /><verse number="15" style="v" sid="ACT 12:15" />فأجابوها مُكَذِّبينَ: "قد جُنِنتِ!" وبَعدَ تأكِيدِها الخَبَرَ، قالوا: "رُبَّما هذا مَلاكُهُ الحارِسُ".<note caller="+" style="f"><char style="fr" closed="false">12‏.15 </char><char style="ft" closed="false">كان الشعب اليهودي يؤمن آنذاك أنّ اللّه وهب لكلّ مؤمنٍ ملاكًا حارسًا يشبه الشخص الذي يحميه.</char></note> <verse eid="ACT 12:15" /><verse number="16" style="v" sid="ACT 12:16" />أمّا بُطرُسُ فقدِ استَمَرَّ بِطَرقِ البابِ. ففَتَحوا لهُ أخيرًا وأصابَتهُم دَهشةٌ عِندَما رأوهُ، <verse eid="ACT 12:16" /><verse number="17" style="v" sid="ACT 12:17" />فأشارَ لَهُم بُطرُسُ بيَدِهِ أنِ اصمُتوا، ثُمَّ أخبَرَهُم كَيفَ أعانَهُ اللهُ على الخُروجِ مِنَ السِّجنِ. وقالَ لهُم: "أخبِروا يَعقوبَ وبَقيّةَ الإخوانِ بكُلِّ هذا".<note caller="+" style="f"><char style="fr" closed="false">12‏.17 </char><char style="ft" closed="false">يعقوب هذا هو أخو سيدنا عيسى الأصغر الذي صار لاحقًا قائد المؤمنين بالسيد المسيح في القدس. وقد احترمه اليهود غير المؤمنين بالمسيح من أجل تقواه.</char></note> ثُمَّ خَرَجَ بَعدَئذٍ قاصِدًا مَكانًا آخَرَ.<verse eid="ACT 12:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="ACT 12:18" />وفي الصَّباحِ، وعِندَ طُلوعِ النَّهارِ، سَرَت بَينَ أفرادِ الحَرَسِ بَلبَلةٌ شَديدةٌ بسَبَبِ اختفاءِ بُطرُسَ. <verse eid="ACT 12:18" /><verse number="19" style="v" sid="ACT 12:19" />وعِندَما عَلِمَ أغريباسُ بِاختفائِهِ، استَجوَبَ الحَرَسَ، ثُمَّ أصدَرَ أمرًا بإعدامِهِم. وتَوَجَّهَ هيرودُسُ أغريباسُ بَعدَ ذلِكَ مِن مِنطقةِ يَهوذا إلى مَدينةِ قَيصريّة حَيثُ أقامَ زَمَنًا قَصيرًا.<verse eid="ACT 12:19" /></para>
  <para style="s">موت هيرودس أغريباس</para>
  <para style="p">
    <verse number="20" style="v" sid="ACT 12:20" />وكانَ هيرودُسُ أغْريباسُ آنذاكَ غاضِبًا على أهالي مَدينَتَيْ صُور وصَيدا، فقَدِمَ إليهِ مِنهُم وَفدٌ يَطلُبونَ الصَّفحَ، فقد كانَت مُؤَنُ مَناطِقِهِم مِنَ الطَّعامِ وغَيرِهِ تأتي مِن مَملكتِهِ فعَمِلوا على استِمالةِ قَلبِ بَلاستُسَ حاجِبِ المَلِكِ، حتّى نَجَحوا أخيرًا فمَنَّ المَلِكُ عليهِم بمُقابلتِهِ.<verse eid="ACT 12:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="ACT 12:21" />وفي اليَومِ المُحدَّدِ، ارتَدى هيرودُسُ أغريباسُ الزَّيَّ المَلَكيَّ وجَلَسَ على العَرشِ خَطيبًا فيهِم، <verse eid="ACT 12:21" /><verse number="22" style="v" sid="ACT 12:22" />فكانَ النّاسُ يَهتِفونَ: "ما هذا الصَّوتُ إلاّ صَوتُ إلَهٍ، لا صَوتُ إنسانٍ!" <verse eid="ACT 12:22" /><verse number="23" style="v" sid="ACT 12:23" />فأرسَلَ اللهُ مَلاكًا ضَرَبَهُ في الحالِ بعِلَّةٍ جَعَلَتِ الدُّودَ يأكُلُ جَسَدَهُ حتّى ماتَ. لأنّهُ لم يَتَواضَع لذاتِ اللهِ، بلِ ادَّعى مُشاركتَهُ في صِفاتِهِ.<note caller="+" style="f"><char style="fr" closed="false">12‏.23 </char><char style="ft" closed="false">لقد كتب المؤرخ اليهودي يوسيفوس، الذي عاش في القرن الأوّل للميلاد، عن كفر أغريباس وضرب الله له وطرحه ميتًا بسبب كفره. وبعد موته، أصبحت مناطق نفوذه ولاية رومانية تحت قيادة والٍ روماني.</char></note><verse eid="ACT 12:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="ACT 12:24" />وفي تِلكَ الفَترةِ كانَت رِسالةُ اللهِ تَنتَشِرُ بِسُرعةٍ وعَدَدُ المُؤمِنينَ بها يَزدادُ، <verse eid="ACT 12:24" /><verse number="25" style="v" sid="ACT 12:25" />وأتَمَّ بَرنابا وشاولُ مُهِمّتَهُما في القُدسِ، وقَفَلا عائدَينِ إلى أنطاكِية، يَصحَبُهُما مَرقُسُ.<verse eid="ACT 12:25" /></para>
  <chapter eid="ACT 12" />
  <chapter number="13" style="c" sid="ACT 13" />
  <para style="cl">الفصل الثّالث عشر</para>
  <para style="s">إرسال برنابا وشاول للدّعوة</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 13:1" />وكانَ مِن بَينِ المُؤمِنينَ في مَدينةِ أنطاكية، رِجالٌ وَهَبَهُم اللهُ كَراماتِ النُّبوءةِ والقُدرةِ على تَعليمِ النّاسِ، وهؤلاءِ هُم: بَرنابا وسَمعانُ الّذي يُدعى الأسود، ولوسيُوسُ مِن مَدينةِ قُورينا في ليبيا، ومَنايِنُ الّذي كانَ قد نَشَأ مَعَ الحاكِمِ أنْتيباسَ بنِ هيرودُسَ مُنذُ طُفولتِهِما، وشاولُ. <verse eid="ACT 13:1" /><verse number="2" style="v" sid="ACT 13:2" />وذاتَ يومٍ، بَينَما كانَ هؤلاءِ مَأخوذينَ في عِباداتِهِم وَهُم صائِمُونَ، جاءَهُم وَحيٌ مِن رُوحِ اللهِ أن يُكَلِّفوا بَرنابا وشاولَ بإتمامِ الدَّعوةِ الّتي أُخِتيرا لها. <verse eid="ACT 13:2" /><verse number="3" style="v" sid="ACT 13:3" />وبَعدَ مَزيدٍ مِن الصَّلاةِ والصّيامِ، بارَكَتهُما الجَماعةُ بوَضعِ أيدِيها عليهِما، وصَرَفَتهُما.<verse eid="ACT 13:3" /></para>
  <para style="s">في قبرص</para>
  <para style="p">
    <verse number="4" style="v" sid="ACT 13:4" />فانصَرَفا، مُتَوَجِّهيْنِ بِوحيٍ مِن رُوحِ اللهِ إلى ميناءِ سُلوكية، ومِنها أبحَرَا إلى جَزيرةِ قُبرُصَ. <verse eid="ACT 13:4" /><verse number="5" style="v" sid="ACT 13:5" />ولمّا وَصَلا الجَزيرةَ نَزَلا في مَدينةِ سلاميسَ، وأخَذا يُعلِنانِ على المَلإ في بُيوتِ العِبادةِ اليَهوديّةِ رِسالةَ اللهِ. وكانَ مَرقُسُ برِفقتِهِما يُساعدُهُما. <verse eid="ACT 13:5" /><verse number="6‏-8" style="v" sid="ACT 13:6-8" />وجالا أنحاءَ الجَزيرةِ بأكملِها مُعلِنينَ رِسالةَ المَسيحِ حتّى وَصَلا مَدينةَ بافوسَ. وهُناكَ صادَفا ساحِرًا يَهوديًّا يَدَّعي النُّبوّةَ اسمُهُ باريشوعُ ويُعرَفُ أيضًا باسمِ عَليم. وكانَ يَنتمي إلى رِجالِ حاشِيةِ الحاكمِ الرُّومانيّ سَرْجيوسَ بولُسَ. وكانَ هذا الحاكِمُ رَجُلاً ذَكيًّا، فأرسَلَ وَراءَ بَرنابا وشاول ليَستَمِعَ إلى مَضمونِ رِسالةِ اللهِ، إلاّ أنّ عَليمَ السّاحرَ أخَذَ يُعارِضُهُما مُحاوِلاً مَنعَ الحاكمِ مِنَ الإيمانِ بسَيّدِنا عيسى (سلامُهُ علينا)، <verse eid="ACT 13:6-8" /><verse number="9" style="v" sid="ACT 13:9" />فحَدَّقَ شاولُ، أي بولُس،<note caller="+" style="f"><char style="fr" closed="false">13‏.9 </char><char style="ft" closed="false">لم يغيّر شاول اسمه، بل كان له اسم يهودي واسم روماني. وعندما كان يسافر في مناطق يتكلّم سكانها اليونانية، كان يستخدم اسمه الروماني، لأنّه كان يُعرف أكثر تحت هذا الاسم.</char></note> في السّاحرِ مُتَفَرِّسًا <verse eid="ACT 13:9" /><verse number="10" style="v" sid="ACT 13:10" />ثُمَّ قالَ لهُ مُقتَديًا بِرُوحِ اللهِ: "ما أنتَ إلاّ عَونٌ مِن أعوانِ إبليسَ! أنتَ عَدوُّ الصَّلاحِ والاستِقامةِ، وإنّكَ لمَجبُولٌ بالشّرِّ والخِداعِ! ألا كَفَفتَ عن تَشويهِ سَبيلِ اللهِ المُستَقيمِ؟ <verse eid="ACT 13:10" /><verse number="11" style="v" sid="ACT 13:11" />ستأتيكَ الآنَ مِن عِندِ اللهِ ضَربةٌ تُعمي بَصَرَكَ إلى حِينٍ، فتَعجِزُ حتَّى عن رُؤيةِ نورِ الشَّمسِ". وأظلَمَت في الحالِ عَيناهُ، وأخَذَ يَتَلَمَّسُ طَريقَهُ ليَعثُرَ على مَن يأخُذُ بيَدِهِ ويَقودُهُ. <verse eid="ACT 13:11" /><verse number="12" style="v" sid="ACT 13:12" />وأخَذَتِ الدَّهشةُ مِنَ الحاكمِ كُلَّ مأخَذٍ، وانبَهَرَ بقُوّةِ رِسالةِ سَيِّدِنا عيسى (سلامُهُ علينا)، فآمَنَ بِهِ.<verse eid="ACT 13:12" /></para>
  <para style="s">في أنطاكية الواقعة في منطقة بيسيدية</para>
  <para style="p">
    <verse number="13" style="v" sid="ACT 13:13" />وَانتَقَلَ بُولسُ ورَفيقاهُ مِن بافوسَ مُبحِرينَ إلى ميناءِ بَرجَة في مِنطقةِ بَمْفيليّة. وفارقَهُما مَرقُسُ عائِدًا إلى القُدس، <verse eid="ACT 13:13" /><verse number="14" style="v" sid="ACT 13:14" />ثُمّ تَرَكا بَرجةَ ورَحَلا بَرًّا إلى مَدينةِ أنطاكية في مِنطقةِ بيسيديّة،<note caller="+" style="f"><char style="fr" closed="false">13‏.14 </char><char style="ft" closed="false">كانت بمفيليّة وبيسيديّة منطقتان تقعان فيما يُعرف اليوم بجنوب تركيا.</char></note> وإثرَ وصُولِهِما، ذَهَبا يومَ السَّبتِ إلى بَيتِ العِبادةِ وجَلَسا هُناكَ. <verse eid="ACT 13:14" /><verse number="15" style="v" sid="ACT 13:15" />وبَعدَ أن تَلا الحاضِرونَ بَعضَ ما جاءَ في التَّوراةِ وغَيرِها مِن كُتُبِ الأنبياءِ حَسَبَ عادتِهِم، أرسَلَ المَسؤولونَ إليهِما قائِلينَ: "أيُّها الأخَوانِ، إن كانَ لَدَيكُما كَلامٌ يُشَجِّعُ الحاضِرينَ على الإيمانِ فتَكَلّما". <verse eid="ACT 13:15" /><verse number="16" style="v" sid="ACT 13:16" />فوَقَفَ بولسُ وأشارَ بِيدهِ لِيَسكُتوا ثُمَّ قالَ: "اُصْغوا إليَّ يا بَني يَعقوبَ، أنتُم وغَيرُكُم مِمَّن تَتَّقونَ اللهَ. <verse eid="ACT 13:16" /><verse number="17" style="v" sid="ACT 13:17" />لقدِ اختارَ اللهُ آباءَنا الأوَّلينَ لِيَجعَلَ مِنهُم أُمَّةً لهُ، وقد تَكَوّنَتِ هذِهِ الأُمّةُ. وفي يَومٍ مِنَ الأيّام تَغَرَّبَت في أرضِ مِصرَ، لكنّ اللهَ جَعَلَها تَتَكاثَرُ وتَتَقَوّى فأخرَجَها، بِقُدرتِهِ العَظيمةِ، مِنَ العُبوديّةِ الّتي كانَت تُعاني مِنها إلى نورِ الحُرّيّةِ. <verse eid="ACT 13:17" /><verse number="18" style="v" sid="ACT 13:18" />ثُمّ صَبَرَ على فَسادِها على مَدى أربَعينَ سَنةً عِندَما كانَت تائهةً في الصَّحراء. <verse eid="ACT 13:18" /><verse number="19" style="v" sid="ACT 13:19" />وأهلَكَ سَبعَ أُمَمٍ وَثنيَّةٍ في بِلادِ كَنعانَ، واستأمَنَهُم أرضَها. <verse eid="ACT 13:19" /><verse number="20" style="v" sid="ACT 13:20" />وقد جَرى ذلِكَ على مَدى أربَعِ مِئةٍ وخَمسينَ سَنةً. ثُمّ جَعَلَ فيهِم قادةً أبطالاً يُدافِعونَ عَنهُم حتّى جاءَ عَهدُ النّبيِّ صَموئيلَ. <verse eid="ACT 13:20" /><verse number="21" style="v" sid="ACT 13:21" />عِندئذٍ طَلَبوا مِنَ اللهِ أن يُنَصِّبَ عليهِم مَلِكًا، فمَنَحَهُم طالوتَ بِن قَيسٍ مِن قَبيلةِ بِنيَمينَ مَلِكًا عليهِم مُدّةَ أربَعينَ عامًا، <verse eid="ACT 13:21" /><verse number="22" style="v" sid="ACT 13:22" />ثُمَّ أزاحَهُ ليَجعَلَ النّبيَّ داوُدَ مَلِكًا عليهِم بَدَلاً مِنهُ، وشَهِدَ لهُ اللهُ قائِلاً: "إنّي أرى في داودَ بنِ يَسّى الرَّجُلَ الّذي يَعمَلُ على مَرضاتي، ويَقومُ بكُلِّ ما آمَرَهُ بِهِ". <verse eid="ACT 13:22" /><verse number="23" style="v" sid="ACT 13:23" />لِذا، كانَ وَعدُ اللهِ لبَني يَعقوبَ أن يَجعَلَ أحَدَ أحفادِهِ مُنقِذًا لهُم، وكانَ ذلِكَ المُنقِذُ هو عيسى النّاصريّ. <verse eid="ACT 13:23" /><verse number="24" style="v" sid="ACT 13:24" />لكن، قَبلَ قُدومِهِ (سلامُهُ علينا)، جاءَ النَّبيُّ يَحيى يَدعو جَميعَ بَني يَعقوبَ إلى التّوبةِ والتَّطَهُّرِ بِالماءِ، <verse eid="ACT 13:24" /><verse number="25" style="v" sid="ACT 13:25" />وفي خِتامِ دَعوتِهِ خاطَبَهُم قائِلاً: "هل تَظُنّونَ أنّني المَسيحُ المُنتَظَرُ؟ أنا لَستُ هو، إنّهُ آتٍ بَعدي، وأنا لا أرتَقي إلى شَرَفِ حَلِّ رِباطِ حِذائِهِ".<verse eid="ACT 13:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="ACT 13:26" />وتابَعَ بُولسُ قائِلاً: "إخواني، يا ذُرّيّةَ إبراهيمَ، ويا أيُّها المُتّقونَ مِن غَيرِ اليَهودِ،<note caller="+" style="f"><char style="fr" closed="false">13‏.26 </char><char style="ft" closed="false">"ذرية إبراهيم": هم اليهود الذين كانوا يستمعون إليه. و"المتّقون" هم الأغراب الذين كانوا يؤمنون باللّه ولكنهّم لم يدخلوا الديانة اليهودية من خلال الختان. </char></note> إنّ هذِهِ الرِّسالةَ رِسالةُ نَجاتِنا الّتي أرسَلَها اللهُ إلينا، <verse eid="ACT 13:26" /><verse number="27" style="v" sid="ACT 13:27" />إلاّ أنّ أهلَ القُدسِ وقادتَهُم لم يُدرِكوا أنّ سَيِّدَنا عيسى هو المُنقِذُ المَوعودُ، لأنّهُم لم يَفهموا ما كانوا يَسمَعونَ كُلَّ سَبتٍ عن تِلكَ النُّبوءات مِن آياتٍ وَرَدَت في كُتُبِ الأنبياءِ، فحَكَموا عليهِ بالمَوتِ. <verse eid="ACT 13:27" /><verse number="28" style="v" sid="ACT 13:28" />وهكَذا تَحَقّقَتِ النُّبُوءاتُ! وعلى الرَّغمِ مِن أنّهُم لم يُثبِتوا عليهِ أيَّ جُرمٍ يَستَحِقُّ المَوتَ، فقد طَلَبوا مِن بيلاطُسَ إعدامَهُ. <verse eid="ACT 13:28" /><verse number="29" style="v" sid="ACT 13:29" />وبَعدَ أن تَحَقَّقَ ما جاءَ في الكُتُبِ السَّماويّةِ عنهُ، أنزَلوهُ عنِ الصَّليبِ، وسَجَّوهُ القَبرَ. <verse eid="ACT 13:29" /><verse number="30" style="v" sid="ACT 13:30" />ولكنَّ اللهَ بَعَثَهُ حيًّا، <verse eid="ACT 13:30" /><verse number="31" style="v" sid="ACT 13:31" />فظَهَرَ على مَدى عِدّةِ أيّامٍ لرِفاقِهِ مِنَ الجَليلِ إلى القُدسِ، وهؤلاءِ هم شُهودُهُ بَينَ أفرادِ شَعبِنا.<verse eid="ACT 13:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="ACT 13:32" />ونَحنُ الآنَ أتَينا لنَشهَدَ لكُم بالبِشارةِ: إنّ اللهَ وَعَدَ آباءَنا الأوّلينَ أن يُرسِلَ مُنقِذًا، <verse eid="ACT 13:32" /><verse number="33" style="v" sid="ACT 13:33" />وها هو يُتِمُّ وَعدَهُ لنا نَحنُ الأبناءَ، بإرسالِ سَيِّدِنا عيسى، كَما جاءَ في المَزمور الثّاني مِنَ الزَّبورِ: "أنت أقرَب إليّ مِن الابنِ مِن أبيهِ، واليومَ على العَرشِ أجلَسناكَ."<note caller="+" style="f"><char style="fr" closed="false">13‏.33 </char><char style="ft" closed="false">يقتبس الحواري بولس هنا من الزبور، مزمور 2: 7. وقد استخدمت بعض الترجمات العربية العبارة التالية: "أنت ابني أنا اليوم ولدتُك"، أمّا التعبير الأصلي في اللغة اليونانية الموحى بها فلا يشير إلى ولادة تناسلية لسيدنا عيسى ولا إلى أصله الإلهي، ولكنّه يشير إلى تتويجه ملكا. وقد استعمل الحواريون هذه الكناية في حديثهم عن تتويج المسيح الملك، كما وردت في المزمور 2، وأشعيا 9: 6، والمزمور 110: 3 (في الترجمة اليونانية) وضمنيا في كتاب صموئيل الثاني 7: 12‏-14. لقد بدأت ولادة سيدنا عيسى، بالمفهوم المجازي المشار إليه، من لحظة بعثه من الموت، ثم اكتملت بصعوده إلى عرشه في السماء. طبعا لم يأت سيدنا المسيح إلى الوجود في ساعة ولادته بذلك المعنى، كما لم يكتسب الألوهية في تلك الساعة، بل هو كلمة الله منذ الأزل. فالولادة إذن تشير إلى تتويجه مسيحا ملكا. ورغم أنه سُمّي ملكا قبل ذلك، إلاّ أنّ ذلك لم يكن قد أعلن بعدُ على رؤوس الملأ، كما أنّ تتويجه في السماء لم يتمّ إلى حين صعوده.</char></note> <verse eid="ACT 13:33" /><verse number="34" style="v" sid="ACT 13:34" />وأقامَ اللهُ سَيِّدَنا عيسى مِنَ المَوتِ، ولم يَتَعرَّض جَسَدُهُ للفَناءِ قَطعًا. ولقد وَرَدَ هذا في قَولِ اللهِ عَزّ وجَلّ: "أُعطيكَ البَرَكاتِ المُقَدَّسةَ الّتي وَعَدتُ بها داودَ". <verse eid="ACT 13:34" /><verse number="35" style="v" sid="ACT 13:35" />وجاءَ في مَزمورٍ آخَرَ أيضًا: "لن تَسمَحَ أن يَتَعَفَّنَ جَسَدُ عَبدِكَ المُقَدَّسِ في القَبرِ". <verse eid="ACT 13:35" /><verse number="36" style="v" sid="ACT 13:36" />واضِحٌ، يا إخواني، أنّ النّبيَّ داوُدَ لا يُشيرُ هُنا إلى نَفسِهِ، فقد عاشَ طولَ حَياتِهِ يُرضي اللهَ، ثُمَّ تُوُفِّيَ ودُفِنَ مَعَ آبائِهِ، وتآكَلَ جَسَدُهُ تَحتَ التُّرابِ. <verse eid="ACT 13:36" /><verse number="37" style="v" sid="ACT 13:37" />بل كانَ النَّبيُّ داود يُشيرُ إلى سَيِّدِنا عيسى الّذي أحياهُ اللهُ، فلم يَتَعَرَّض جَسَدُهُ للفَناءِ. <verse eid="ACT 13:37" /><verse number="38" style="v" sid="ACT 13:38" />فاعلَموا يا إخوتي إنّما بِشَفاعةِ عيسى يَغفِرُ اللهُ لكُم ذُنوبَكُم، <verse eid="ACT 13:38" /><verse number="39" style="v" sid="ACT 13:39" />وكُلُّ مَن يؤمِنُ بِهِ يَتَحَرَّرُ مِنَ الخَطايا الَّتي لم تَكُن لتُحَرِّرَكُم مِنها تَوراةُ النّبيِّ موسى. <verse eid="ACT 13:39" /><verse number="40" style="v" sid="ACT 13:40" />واحذَروا أن تَقَعوا في ما حَذَّرَ مِنهُ النّبيُّ حَبَقوق: <verse eid="ACT 13:40" /><verse number="41" style="v" sid="ACT 13:41" />"أيُّها المُستَهزِئونَ بِوُعودي، ستُصيبُكُم الدَّهشةُ وتَموتونَ لأنِّي سأُنزِلُ في زَمانِكُم خَرابًا على دِيارِكُم، خَرابًا لو أخبَرَكُم بِهِ أحَدٌ ما صَدَّقتُموهُ".<verse eid="ACT 13:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="ACT 13:42" />وبَينَما كانَ بُولسُ وبَرنابا يُغادِرانِ بَيتَ العِبادةِ، طَلَبَ النّاسُ مِنهُما مُواصَلةَ الحَديثَ عن نَفسِ المَوضوعِ في السَّبتِ التّالي. <verse eid="ACT 13:42" /><verse number="43" style="v" sid="ACT 13:43" />وعِندَ انتِهاءِ اللِّقاءِ، انضَمَّ إلى بُولسَ وبَرنابا كَثيرٌ مِنَ اليَهودِ وغَيرُهُم مِمَّن سَبَقَ أن تَهَوَّدوا فشَجّعَاهُم أن يَكونوا مُخلِصينَ على الدَّوامِ بفَضلٍ مِنهُ تَعالى.<verse eid="ACT 13:43" /></para>
  <para style="p">
    <verse number="44" style="v" sid="ACT 13:44" />وهكذا عِندَما حَلَّ السَّبتُ المُنتَظَرُ، تَجَمَّعَ حَشدٌ كَبيرٌ مِن أهلِ المَدينةِ للإصغاءِ إلى الحَديثِ الدّائرِ حَولَ سَيّدِنا عِيسى (سلامُهُ علينا). <verse eid="ACT 13:44" /><verse number="45" style="v" sid="ACT 13:45" />ولكنّ بَعضَ اليَهودِ، عِندَما رأوا تِلكَ الحُشودَ الغَفيرَةَ، امتَلأتْ قُلوبُهُم غَيرَةً فبَدَؤوا يُعارِضونَ كَلامَ بولُسَ ويُهينونَهُ، <verse eid="ACT 13:45" /><verse number="46" style="v" sid="ACT 13:46" />فتَوَجَّهَ بولسُ وبَرنابا إليهِم بجُرأةٍ قائِليْنِ: "يا رِجالَ بَني يَعقوبَ، كانَ علينا تَبليغُكُم أنتُم أوّلاً رسالةَ اللهِ، لكنّكُم بَعدَ رَفضِكُم إيّاها، أَثبَتُّم أنّكُم لا تَستحِقّونَ دارَ الخُلودِ! لِهذا السَّبَبِ، سنَتَوَجَّهُ بتَبليغِ تِلكَ الرِّسالةِ إلى الشُّعوبِ الأُخرى! <verse eid="ACT 13:46" /><verse number="47" style="v" sid="ACT 13:47" />وهذا تَنفيذًا لأمرِ اللهِ كَما جاءَ في كِتابِ النّبيِّ أَشعيا: "جَعَلناكَ نورًا للأُمَمِ، لتَحمِلَ النَّجاةَ إلى آخِرِ الأرضِ". <verse eid="ACT 13:47" /><verse number="48" style="v" sid="ACT 13:48" />ففَرِحَ النّاسُ مِن غَيرِ اليَهودِ وسَبَّحوا اللهَ شاكِرينَ لإنعامِهِ عليهِم برِسالةِ السّيِّدِ المَسيحِ (سلامُهُ علينا)، ودَخَلَ في الإيمانِ كُلُّ مَن قَدَّرَ اللهُ لهُمُ التَّنَعُّمَ في دارِ الخُلدِ.<verse eid="ACT 13:48" /></para>
  <para style="p">
    <verse number="49" style="v" sid="ACT 13:49" />وهكذا، انتَشَرَت رِسالةُ سَيِّدِنا عيسى (سلامُهُ علينا) في جَميعِ أنحاءِ تِلكَ المِنطقةِ. <verse eid="ACT 13:49" /><verse number="50" style="v" sid="ACT 13:50" />وحَرَّضَ قادةُ اليَهودِ النِّسوةَ المُتَدَيِّناتِ ذَواتِ الشَّأنِ ووُجَهاءَ المَدينةِ على بُولسَ وبَرنابا، مِمّا تَسَبَّبَ في اضطِهادِهِما وطَردِهِما مِن تِلكَ المِنطقة.<note caller="+" style="f"><char style="fr" closed="false">13‏.50 </char><char style="ft" closed="false">يسجّل الكتّاب القدامى أنّ عددا من النساء الوثنيات النبيلات كنّ مهتمّات جدًا بالديانة اليهودية. ولم يكن عليهن الختان مثل الرجال إذا قرّرن اعتناق اليهودية. طبعًا كانت هذه الجماعة من النساء قادرات على التأثير في أزواجهنّ ذوي النفوذ.</char></note> <verse eid="ACT 13:50" /><verse number="51" style="v" sid="ACT 13:51" />فنَفَضَ حينَئذٍ بولسُ وبَرنابا الغُبارَ عن أرجُلِهِما ورَحَلا إلى مَدينةِ إيقونية.<note caller="+" style="f"><char style="fr" closed="false">13‏.51 </char><char style="ft" closed="false">كان نفض الغبار الوسيلة التي كان اليهود يستخدمونها في زمن السيد المسيح ليظهروا رفضهم لمَن كانوا يعتبرونهم وثنيين. وبما أنّ بولس وبرنابا قاما بهذا الفعل، فقد اعتبرا أنّ قادة اليهود أصبحوا كالوثنيين.</char></note> <verse eid="ACT 13:51" /><verse number="52" style="v" sid="ACT 13:52" />أمّا بالنِّسبةِ إلى المُؤمنينَ في مَدينةِ أنطاكية في بِيسيديّة، فكانوا مُمتَلئِينَ فَرَحًا وقد غَمَرَهُم اللهُ برُوحِهِ القدُّوس.<verse eid="ACT 13:52" /></para>
  <chapter eid="ACT 13" />
  <chapter number="14" style="c" sid="ACT 14" />
  <para style="cl">الفصل الرّابع عشر</para>
  <para style="s">في مدينة إيقونية</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 14:1" />كانَت وِجهَةُ بولُسَ وبَرنابا مَدينةَ إيقونية، حَيثُ قَصَدا بَيتَ العِبادةِ اليَهوديَّ، وأخَذا يَتَحَدّثانِ عن رِسالةِ عيسى (سلامُهُ علينا)، مِمّا جَعَلَ الكَثيرينَ مِنَ اليَهودِ وغَيرِهِم يُؤمِنونَ بِسَيِّدِنا عيسى (سلامُهُ علينا). <verse eid="ACT 14:1" /><verse number="2‏-3" style="v" sid="ACT 14:2-3" />ولذلِكَ مَكَثَ بُولسُ وبَرنابا في إيقونية مُدّةً طَويلةً واستَمَرّا في نَشرِ الرِّسالةِ فيها مُتَحَدِّثَيْنِ بطَلاقةٍ عن سَيِّدِنا عيسى (سلامُهُ علينا) وعن فَضلِهِ، مُظهِرَيْنِ آياتٍ وَعَجائبَ بِتأييدٍ مِنَ اللهِ. وبَقِيَ هُناكَ عَدَدٌ مِنَ اليَهودِ الَّذينَ قاوَموا رِسالةَ اللهِ، وأخَذوا يُثيرونَ النّاسَ ضِدَّ بولُسَ وبَرنابا وسَمَّموا أفكارَهُم وجَعَلوهُم يَرفُضونَ تِلكَ الرِّسالةَ. <verse eid="ACT 14:2-3" /><verse number="4" style="v" sid="ACT 14:4" />فَانقَسَمَ أهلُ المَدينةِ إلى فِئتينِ، فِئةٍ انحازَت إلى الحَواريَّينِ بولُسَ وبَرنابا، وأُخرى إلى اليَهودِ الرّافِضينَ للرِّسالةِ. <verse eid="ACT 14:4" /><verse number="5" style="v" sid="ACT 14:5" />وحِيكَتْ بَينَ هَؤلاءِ بالتَّعاوُنِ مَعَ قادتِهِم وآخَرينَ مِن غَيرِ اليَهودِ مُؤامَرةٌ لشَنِّ هُجومٍ على بُولسَ وبَرنابا ورَجْمِهِما. <verse eid="ACT 14:5" /><verse number="6‏-7" style="v" sid="ACT 14:6-7" />فلمّا أحَسَّ الحَوارِيّانِ بهذِهِ المُؤامرَةِ فَرّا هاربَيْنِ باتِّجاهِ مِنطقةِ ليقونِية، حَيثُ شَرَعا في نَشرِ الرِّسالةَ بمَدينةِ لِستَرَة، ثُمَّ دَربَة، بالإضافةِ إلى المَناطِقِ المُجاوِرة.<verse eid="ACT 14:6-7" /></para>
  <para style="s">في لسترة ودربة</para>
  <para style="p">
    <verse number="8" style="v" sid="ACT 14:8" />وفي مَدينةِ لِستَرَة، وَجَدَ بولُسُ وبَرنابا رَجُلاً كَسيحًا مُنذُ وِلادتِهِ، لم يَخطُ خُطوةً واحِدةً. <verse eid="ACT 14:8" /><verse number="9" style="v" sid="ACT 14:9" />وكانَ يُصيخُ السَّمعَ إلى بُولسَ عِندَ خِطابِهِ. فتَفَرَّسَ بولُسُ في وَجهِهِ مَلِيًّا، وأحَسَّ أنّهُ يَملِكُ إيمانًا راسِخًا يُؤهّلُهُ ليَكونَ مَوضِعَ الشِّفاءِ بِقُوَّةِ سَيِّدِنا عيسى (سلامُهُ علينا)، <verse eid="ACT 14:9" /><verse number="10" style="v" sid="ACT 14:10" />فما كانَ مِن بولُسَ إلاّ أن كَلّمَهُ بصَوتٍ مُرتَفِعٍ قائلاً: "قُم وقِفْ على قَدَمَيكَ!" وهكذا، وَقَفَ الرَّجُلُ على قدَميهِ وأخَذَ يَمشي. <verse eid="ACT 14:10" /><verse number="11" style="v" sid="ACT 14:11" />وعِندَما رَأى النّاسُ عَمَلَ بولُسَ ذاكَ، أخَذوا يَصرُخونَ بِلُغتِهِم اللّيقونيّة قائِلينَ: "تَجَسَّدَتِ الآلهةُ في شَكلِ بَشَرٍ وحَلَّت بَينَنا!" <verse eid="ACT 14:11" /><verse number="12" style="v" sid="ACT 14:12" />مُعتَبِرينَ بَرنابا الإلهَ زِيُوسَ، رَئيسَ الآلِهَة، وبُولسَ الإلَهَ هِرْمِسَ، مِرسالَ الآلِهة لأنّهُ كانَ المُتَحَدِّثَ الرَّئيسيَّ فيهِما. <verse eid="ACT 14:12" /><verse number="13" style="v" sid="ACT 14:13" />إلاّ أنّ بُولسَ وبَرنابا لم يُدرِكا ما يَقصِدُهُ هؤلاءِ النّاسُ. وكانَ بِالقُربِ مِنَ المَدينةِ مَعبَدٌ للإلهِ زيُوسَ، فجَعَلَ الكاهِنُ يأتي بعُجُولٍ مُزَيَّنةٍ بأكاليلِ الزَّهرِ إلى بَوّابةِ المَدينةِ حَيثُ كانَ بُولسُ وبَرنابا واقفَيْنِ، ليُريقَ مَعَ بَقيّةِ النّاسِ دَمَها قَرابينَ عِندَ أقدامِهِما باعتِبارِهِما إلهَينِ، <verse eid="ACT 14:13" /><verse number="14" style="v" sid="ACT 14:14" />وعِندَما أدرَكَ بُولسُ وبَرنابا ذلِكَ، أخَذا بِتَمزيقِ ثِيابِهِما احتِجاجًا، وأسرَعا إلى المُجتَمِعينَ هُناكَ صائحَيْنِ بحَماسةٍ: <verse eid="ACT 14:14" /><verse number="15" style="v" sid="ACT 14:15" />"أيُّها النّاسُ، لِمَ تَقومونَ بِمِثلِ تِلكَ الأعمالِ؟! إنّما نحنُ بَشَرٌ مِثلُكم! ولقد حَمَلنا إليكُم رِسالةَ اللهِ نُبَلِّغُكُم إيّاها وهي تَدعوكُم إلى التَّخَلّي عنِ القِيامِ بهذِهِ الأُمورِ الباطلةِ، وإلى الإيمانِ بِاللهِ الحَيِّ القَيّومِ الّذي خَلَقَ هذا الكَونَ بسَمائِهِ وأرضِهِ وبِحارِهِ وبِكُلِّ ما فيهِ! <verse eid="ACT 14:15" /><verse number="16" style="v" sid="ACT 14:16" />فلقد كانَت جَميعُ الأُمَمِ في الماضي تَسيرُ وِفقَ أهوَائِها، <verse eid="ACT 14:16" /><verse number="17" style="v" sid="ACT 14:17" />على الرَّغمِ مِن أنّ اللهَ يُذَكِّرُهُم دائمًا بوُجُودِهِ مِن خِلالِ آياتِهِ مِن أمطارٍ وثِمارٍ تُشبِعُهُم خَيراتُها فتَمتَلِئُ قُلوبُهُم سَعادةً".<verse eid="ACT 14:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="ACT 14:18" />ولم يَستَطِعْ بَرنابا وبُولسُ، رَغمَ كلامِهِما، أن يَرُدّا النّاسَ عن تَقديمِ الأضاحي لهُما إلاّ بِصُعوبةٍ كَبيرةٍ.<verse eid="ACT 14:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="ACT 14:19" />فجاءَ بَعضُ اليَهودِ مِن مَدينتَي إيقونيَة وأنطاكيَة، واستَطاعوا تَحريضَ الحُشودِ ضِدَّ بُولسَ وبَرنابا، فرَجَموا بُولسَ وألقَوا بِهِ خارِجَ المَدينةِ، وتَرَكوهُ هُناكَ ظانِّينَ أنَّهُ قد ماتَ.<note caller="+" style="f"><char style="fr" closed="false">14‏.19 </char><char style="ft" closed="false">عندما أنكر بولس وبرنابا كونهما آلهة، فمن الممكن أن الجموع ظنت أنّهما قاما بشفاء الكسيح عن طريق السحر، ومن شدّة الخوف انضمّ الناس إلى قادة اليهود وبدؤوا يرجمون معهم بولس وبرنابا. </char></note> <verse eid="ACT 14:19" /><verse number="20" style="v" sid="ACT 14:20" />والتَفَّ حَولَهُ عَدَدٌ مِنَ المُؤمِنينَ، فوَجَدوهُ على قَيدِ الحَياةِ، ثُمَّ استَعادَ قُوّتَهُ ونَهَضَ ودَخَلَ المَدينةَ، وسافَرَ في اليومِ التّالي صُحبةَ بَرنابا إلى مَدينةِ دَربَة.<verse eid="ACT 14:20" /></para>
  <para style="s">العودة إلى مدينة أنطاكية</para>
  <para style="p">
    <verse number="21" style="v" sid="ACT 14:21" />وفي مَدينةِ دَربَة، أخَذَ الحَواريّانِ بولُسُ وبَرنابا يُبَشِّرانِ برِسالةِ المَسيحِ (سلامُهُ علينا)، واستَطاعا كَسبَ عَدَدٍ كَبيرٍ مِنَ المُؤمِنينَ. ثُمَّ قَفَلا عائِدَيْنِ إلى لِسْترة وإيقونية وأنطاكية في مِنطقَةِ بيسيديّة، <verse eid="ACT 14:21" /><verse number="22" style="v" sid="ACT 14:22" />داعمَيْنِ المُؤمنينَ شادَّيْنِ مِن عَزائمِهِم وأزرِهِم ليُثَبِّتوا إيمانَهُم بسَيِّدِنا عيسى قائلَيْنِ: "علينا أن نُقاسي الكَثيرَ مِنَ الشَّدائدِ لدُخولِ مَملكةِ اللهِ الأبَديّةِ". <verse eid="ACT 14:22" /><verse number="23" style="v" sid="ACT 14:23" />ثُمَّ عَيَّنا شُيوخًا في كُلِّ جَماعةٍ مِن جَماعاتِ المُؤمِنينَ، وبَعدَ أدائِهِما الصَّلاةَ والصِّيامَ استَودَعاهُم في حِمايةِ عيسَى (سلامُهُ علينا) مَولاهُم الَّذي آمَنوا بِهِ.<note caller="+" style="f"><char style="fr" closed="false">14‏.23 </char><char style="ft" closed="false">كان على رأس معظم بيوت العبادة اليهودية شيوخٌ يقودون الجماعة، وقد اتّبع المؤمنون بالسيد المسيح الطريقة عينها في اجتماعاتهم.</char></note> <verse eid="ACT 14:23" /><verse number="24" style="v" sid="ACT 14:24" />ثُمَّ تَوَجَّها لاحِقًا إلى بِيسيديّة ثُمَّ بَمْفيليّة <verse eid="ACT 14:24" /><verse number="25" style="v" sid="ACT 14:25" />حتّى وَصَلا مَدينةَ بَرجَة الّتي نادَيا فيها بالرِّسالةِ، ونَزَلا بَعدَئذٍ إلى السّاحِلِ، حَيثُ مَدينةُ أَتّالية <verse eid="ACT 14:25" /><verse number="26" style="v" sid="ACT 14:26" />مُبحِرَيْنِ مِن هُناكَ باتِّجاهِ أنطاكية في سُوريا، المَدينةِ الّتي مِنها خَرَجا سابِقًا بمُوافَقةِ إخوتِهِما في الإيمانِ، في رِعايةِ اللهِ، إلى أماكنَ أُخرى لتَبليغِ الرِّسالةِ.<verse eid="ACT 14:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="ACT 14:27" />وعِندَ وُصُولِهِما مَدينةَ أنطاكية، جَمَعَ بولُسُ وبَرنابا المُؤمِنينَ لِيُخبِراهُم بما فَتَحَ اللهُ عليهِما مِن أعمالٍ قاما بها، وهو ما فَتَحَ الأبوابَ أمامَ مُختَلِفِ الشُّعوبِ للإيمانِ، <verse eid="ACT 14:27" /><verse number="28" style="v" sid="ACT 14:28" />ومَكَثا هُناكَ وَقتًا طَويلاً مَعَ المُؤمِنينَ.<verse eid="ACT 14:28" /></para>
  <chapter eid="ACT 14" />
  <chapter number="15" style="c" sid="ACT 15" />
  <para style="cl">الفصل الخامس عشر</para>
  <para style="s">فتوى مجمع المؤمنين في القدس</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 15:1" />وذاتَ مَرّةٍ، وَصَلَ أنطاكيةَ بَعضُ أتباعِ المَسيحِ (سلامُهُ علينا) مِنَ اليَهودِ قادِمينَ مِن مِنطقةِ يَهوذا، وأخَذوا يَحُثّونَ المؤمنينَ غَيرَ اليَهودِ على الخِتانِ الّتي تَنُصُّ عليهِ التَّوراةُ، زاعِمينَ أنّهُم لن يَكونوا مِنَ النّاجينَ إن لم يُطبِّقُوهُ.<note caller="+" style="f"><char style="fr" closed="false">15‏.1 </char><char style="ft" closed="false">كان معظم اليهود يعتبرون أنّ الشخص لا يمكنه أن ينتمي إلى الشعب اليهودي، الذي يُعتبر شعب اللّه المختار، إلاّ من خلال الختان بالنسبة إلى الرجال والتطهّر بالماء بالنسبة إلى الرجال والنساء. وكان اليهود يعتبرون غيرهم من الأمم غير طاهرين إلى أن يقوموا بهاتين الفريضتين.</char></note> <verse eid="ACT 15:1" /><verse number="2‏-3" style="v" sid="ACT 15:2-3" />فقامَ خِلافٌ شَديدٌ بَينَ بُولسَ وبَرنابا مِن جِهةٍ، وبَينَ هؤلاءِ مِن جِهةٍ أُخرى. فقَرَّرَ المُؤمِنونَ في أنطاكيَة إرسالَ بولُسَ وبَرنابا مَعَ بَعضٍ مِنهُم إلى القُدسِ، للبَحثِ في تِلكَ المَسألةِ مَعَ الحَواريِّينَ والمَسؤولينَ في جَماعاتِ المُؤمِنينَ هُناكَ، وللحُصولِ على فَتوًى في ذلِكَ الأمرِ.<note caller="+" style="f"><char style="fr" closed="false">15‏.2‏-3 </char><char style="ft" closed="false">كان المؤمنون بالمسيح خارج فلسطين يحكمهم الشيوخ المحليّون، لا السلطة المركزية في القدس، ولكن المؤمنين خارج فلسطين كانوا بحاجة إلى سماع رأي المؤمنين المتقدّمين في القدس من أجل حلّ المشاكل التي كانوا يواجهونها مع مَن ادّعوا أنّهم موفدون من قبل المؤمنين بالمسيح من خلفية يهودية. ولو لم تتوصّل تلك المجموعات من المؤمنين إلى حلّ، لحصل الانشقاق الكامل بين مؤمني القدس ومنطقة يهوذا من جهة، ومؤمني أنطاكية والمناطق غير اليهودية من جهة أخرى. </char></note> فخَرَجوا إلى القُدسِ، وفي طَريقِهِم مَرُّوا ببِلادِ فينيقيّة والسّامِرةِ، حَيثُ كانوا يُعلِنونَ لأتباعِ السّيِّدِ المَسيحِ عنِ اهتِداءِ غَيرِ اليَهودِ إلى الإيمانِ بِهِ (سلامُهُ علينا)، مِمّا أشاعَ بَينَ المُؤمنِينَ الفَرَحَ الشَّديدَ. <verse eid="ACT 15:2-3" /><verse number="4" style="v" sid="ACT 15:4" />وعِندَ وصُولِهِم مَدينةَ القُدسِ استَقبَلَهُمُ المُؤمِنونَ والحَوارِيّونَ ومَسؤولو جَماعاتِ المُؤمِنينَ. ثُمَّ أخَذوا يُحَدِّثونَهُم عنِ الأعمالِ الّتي قاموا بها بِعَونِ اللهِ. <verse eid="ACT 15:4" /><verse number="5" style="v" sid="ACT 15:5" />وعِندَئذٍ، قامَ بَعضُ أتباعِ المَسيحِ (سلامُهُ علينا) مِن طائفةِ المُتَشَدِّدِينَ وطَلَبوا فَرضَ الخِتانِ على المُؤمنينَ طِبقًا لِما جاءَ في شَريعَةِ موسى (عليه السّلام) في التَّوراةِ.<note caller="+" style="f"><char style="fr" closed="false">15‏.5 </char><char style="ft" closed="false">كانت طائفة المتشدّدين من أهمّ فروع اليهودية. وبالنسبة إلى المؤمنين الأوائل بالمسيح، لم يوجد فرق بين إيمانهم اليهودي وبين إيمانهم بالسيد المسيح، والكثير من المؤمنين حافظوا على علاقات متينة مع حزبهم الديني اليهودي. </char></note><verse eid="ACT 15:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="ACT 15:6" />وعُقدَ اجتِماعٌ ضَمَّ الحَواريِّينَ ومَسؤولي جَماعاتِ المُؤمِنينَ للنَّظَرِ في تِلكَ المَسألةِ. <verse eid="ACT 15:6" /><verse number="7" style="v" sid="ACT 15:7" />وبَعدَ جَدَلٍ طَويلٍ، قامَ بُطرُسُ بَينَهُم خَطيبًا وقالَ: "يا إخوتي، أنتُم على عِلمٍ بأنّ اللهَ قدِ اختارَني مِن بَينِكُم مُنذُ وَقتٍ لمُهِمَّةِ تَبليغِ رِسالةِ سَيِّدِنا عيسى لغَيرِ اليَهودِ، حتّى يَكونَ بِوُسعِهِم الإنصاتُ إلى الرِّسالةِ فيؤمِنوا بالمَسيحِ المُنقِذِ. <verse eid="ACT 15:7" /><verse number="8" style="v" sid="ACT 15:8" />وبما أنّ اللهَ هو الأعلَمُ بما في القُلوبِ، بَيَّنَ للجَميعِ أنّهُ قَبِلَهُم وجَعَلَهُم مِن عِبادِهِ الفائزِينَ، لأنّهُ أمَدَّهُم برُوحِهِ تَقدَّسَ وتَعالى كَما فَعَلَ مَعَنا تَمامًا، <verse eid="ACT 15:8" /><verse number="9" style="v" sid="ACT 15:9" />وبِهذا، فإنّ اللهَ لم يُفَضِّلنا عليهِم، فقد طَهَّرَ قُلوبَهُم لإيمانِهِم بسَيِّدِنا عيسى، دونَ أن يُوجِبَ عليهِم الخِتانَ. <verse eid="ACT 15:9" /><verse number="10" style="v" sid="ACT 15:10" />فلِماذا تُخالِفونَ إرادَةَ اللهِ وتَتَدَخَّلونَ في شُؤونِهِ؟ نعم، أنتُم تُخالِفونَ إرادةَ الله فتأمرونَ هؤلاءِ المُؤمنينَ بِتَقاليدَ يَهوديّةٍ أثقَلَت ظُهورَنا وظُهورَ آبائِنا، <verse eid="ACT 15:10" /><verse number="11" style="v" sid="ACT 15:11" />ونَحنُ على يَقينٍ بأن لا فَرقَ بَينَنا وبَينَهُم، لأنّنا أصبَحنا، كُلُّنا على حَدٍّ سَواءِ، مِنَ النّاجينَ بفَضلِ سَيِّدِنا عيسى (سلامُهُ علينا)".<verse eid="ACT 15:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="ACT 15:12" />وبَعدَ حَديثِ بُطرُسَ الصَّخرَ رانَ صَمتٌ على الجَميعِ، وبَدَؤوا يُصغونَ إلى حَديثِ بَرنابا وبُولُسَ عنِ المُعجِزاتِ والآياتِ الَّتي جَرَت على أيدِيهِما والَّتي مَنَّ اللهُ عليهِما بإجرائِها بَينَ غَيرِ اليَهودِ. <verse eid="ACT 15:12" /><verse number="13" style="v" sid="ACT 15:13" />وعِندَ انتِهائِهِما مِن حَديثِهما، انبَرى يَعقوبُ قائِلاً: <verse eid="ACT 15:13" /><verse number="14" style="v" sid="ACT 15:14" />"أيا إخوتي، هلا تُصغونَ إليَّ، لقد ذَكَّرَكُم بُطرُسُ الصَّخرُ كَيفَ أنعَمَ اللهُ تَعالى بفَضلِهِ وللمَرَّةِ الأولى على أُناسٍ مِن غَيرِ اليَهودِ ليَجعَلَهُم مِن أُمَّتِهِ، <verse eid="ACT 15:14" /><verse number="15" style="v" sid="ACT 15:15" />وهذا يُوافِقُ ما جاءَ على لِسانِ النّبيِّ عاموس: <verse eid="ACT 15:15" /><verse number="16" style="v" sid="ACT 15:16" />"قالَ تَعالى:"سيأتي زَمَنٌ فيهِ أعودُ وأرحَمُ بَني يَعقوبَ فأُشَيِّدُ مَملكةَ النّبيِّ داود المُتَهَدِّمة،<note caller="+" style="f"><char style="fr" closed="false">15‏.16 </char><char style="ft" closed="false">قصد يعقوب بكلماته: "أُشيّد مملكة النبي داود المتهدّمة" أنّ اللّه سيرسل المسيح ملكًا من بعد أن يُقطع نسلُ النبي داود من الملك زمَنَ أسرهم في بابل. </char></note> وأُعيدُ الحُكمَ لنَسلِهِ <verse eid="ACT 15:16" /><verse number="17" style="v" sid="ACT 15:17" />لكَي تَهتَدي إليّ سائرُ شُعوبِ الدُّنيا الّذينَ اختَرتُهُم ليَكونوا مِن عِبادي". <verse eid="ACT 15:17" /><verse number="18" style="v" sid="ACT 15:18" />هذا ما يَقولُهُ اللهُ الّذي أوحى بهذِهِ الأُمورِ مُنذُ القِدَم. <verse eid="ACT 15:18" /><verse number="19" style="v" sid="ACT 15:19" />أمّا بشأنِ المُهتَدينَ مِن غَيرِ اليَهودِ، فعَلينا ألاّ نُثقِلَ عليهِم بالتَّقاليدِ اليَهوديّةِ، <verse eid="ACT 15:19" /><verse number="20" style="v" sid="ACT 15:20" />ولكن لا بُدَّ أن نَكتُبَ لهُم عن تَحريمِ لُحومِ القَرابينِ المُقَدَّمةِ للأوثانِ، وتَحريمِ الزَّواجِ مِنَ المَحارِمِ، وتَحريمِ الدَّمِ والمُنخَنِقةِ.<note caller="+" style="f"><char style="fr" closed="false">15‏.20 </char><char style="ft" closed="false">لقد وافق الحواريون والشيوخ في القدس على قبول المؤمنين بالمسيح من خلفية غير يهودية كإخوة في الإيمان وكأعضاء لشعب اللّه، ولم يكن ضروريا أن يتّبعوا التقاليد اليهوديّة. ولكن بقيت قضيّة تعامل هؤلاء المؤمنين من خلفية غير يهودية مع اليهود الذين آمنوا بالسيّد المسيح. أمّا القواعد الأربعة التي استندوا عليها فهي مأخوذة من التوراة، في سفر اللاويين، الفصلين 17 و18. وكانت هذه الأمور ممنوعة على بني يعقوب إضافةً إلى كلّ الغرباء المقيمين بينهم، فالهدف كان تيسير تعامل المؤمنين اليهود مع المؤمنين غير اليهود، وذلك من خلال تجنّب الأمور التي تستفزّ المشاعر اليهوديّة والسماح لليهود بأن يأكلوا مع المؤمنين غير اليهود الذين يحافظون على تلك الوصايا. والحواري بولس شرح هذه القضية بالتفصيل في رسالته الأولى إلى المؤمنين في مدينة كورنتوس، الفصول 8 إلى 11.</char></note> <verse eid="ACT 15:20" /><verse number="21" style="v" sid="ACT 15:21" />وهم بَلا شَكٍّ يَعلَمونَ هذِهِ الأُمورَ، لأنّ اليَهودَ يَقرَؤونَ في كُلِّ مَدينةٍ، مُنذُ القِدَمِ، هذِهِ الوَصايا على النّاسِ في بُيوتِ العِبادةِ كُلَّ سَبتٍ كَما جاءَت في تَوراةِ سَيِّدِنا موسى".<verse eid="ACT 15:21" /></para>
  <para style="s">رسالة الحواريّين والمؤمنين</para>
  <para style="p">
    <verse number="22" style="v" sid="ACT 15:22" />وَمِن ثَمَّ قَرَّرَ الحَواريّونَ ومَسؤولو جَماعاتِ المُؤمِنينَ وبَقيّةُ المُؤمِنينَ اختِيارَ رَجُلَينِ مِن بَينِهِم ليُرافِقا بُولُسَ وبَرنابا إلى مَدينةِ أنطاكية، واختاروا سِلواني ويَهوذا المَعروف باسمِ بارسابا، وكانا مِن قادةِ المُؤمِنينَ. <verse eid="ACT 15:22" /><verse number="23" style="v" sid="ACT 15:23" />وأرسَلوا هذِهِ الرِّسالةَ مَعَهُم وفيها: "مِن إخوانِكُم الحَواريِّينَ والمَسؤولِينَ بَينَ المُؤمِنينَ، إليكُم أيُّها المُؤمنونَ مِن غَيرِ اليَهودِ في مَدينة أنطاكية وغَيرِها مِن بِلادِ سُوريا وكِليكيَّة. بَعدَ التَّحيَة: <verse eid="ACT 15:23" /><verse number="24" style="v" sid="ACT 15:24" />وَصَلَ إلى سَمعِنا أنّهُ وَفَدَ عليكُم، وبِغَيرِ تَفويضٍ مِنّا، بَعضُ الأشخاصِ الّذينَ أثاروا مَعَكُم أحاديثَ فارِضينَ عليكُم بَعضَ المَسائلِ، مِمّا أثارَ قَلقَكُم وانزِعاجَكُم. <verse eid="ACT 15:24" /><verse number="25" style="v" sid="ACT 15:25" />لذا، كانَ إجماعُنا على رَجُلَينِ هُما يَهوذا وسِلواني ليَكونا برِفقةِ حَبيبَينا بَرنابا وبُولُسَ <verse eid="ACT 15:25" /><verse number="26" style="v" sid="ACT 15:26" />اللَّذيْنِ خاطرا بحياتِهِما مِن أجلِ سَيِّدِنا عيسى. <verse eid="ACT 15:26" /><verse number="27‏-28" style="v" sid="ACT 15:27-28" />وسيُبَلِّغُكُم يَهوذا وسِلواني أنّنا قَرَّرنا بِوَحيٍ مِن رُوحِ اللهِ عَدمَ الإثقالِ عليكُم إلاّ بِما لا بُدَّ مِنهُ مِنَ الأُمورِ. <verse eid="ACT 15:27-28" /><verse number="29" style="v" sid="ACT 15:29" />لذا، نُبَلِّغُكم أيُّها المُؤمنونَ أنّ لُحومَ القَرابينِ المُقدَّمةِ للأوثانِ، والدَّمَ ولَحمَ المَخنوقِ مِن الحَيواناتِ، والزَّواجَ مِنَ المَحارِمِ كُلُّ ذلِكَ حَرامٌ عليكُم، فإنِ امتنَعتُم عن تِلكَ المُحَرَّماتِ، فقد أتيتُم ما أوجَبَهُ اللهُ عليكُم، وعُوفيتُم".<verse eid="ACT 15:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="ACT 15:30" />وهكذا انطَلَقَ هؤلاءِ الرِّجالُ الأربَعةُ إلى أنطاكية، وجَمَعوا المُؤمِنينَ وسَلَّموهُم الرِّسالةَ. <verse eid="ACT 15:30" /><verse number="31" style="v" sid="ACT 15:31" />وعِندَ قِراءَةِ المُؤمِنينَ لها فَرِحوا بما فيها مِن كَلِماتٍ قَوَّت عَزِيمتَهُم. <verse eid="ACT 15:31" /><verse number="32" style="v" sid="ACT 15:32" />وكانَ لِيَهوذا وسِلواني كَراماتُ النُّبوءَةِ. فقَدِ استَمَرّا مُدَّةً طَويلةً في تَقديمِ الوَعظِ والنُّصْحِ، وشَدِّ أزرِ المُؤمِنينَ. <verse eid="ACT 15:32" /><verse number="33" style="v" sid="ACT 15:33" />ثُمَّ وَدَّعَهُما المُؤمِنونَ بأمانِ اللهِ ليَعودا مِن حَيثُ أتَيا. <verse eid="ACT 15:33" /><verse number="34‏-35" style="v" sid="ACT 15:34-35" />أمّا بولُسُ وبَرنابا، فبَقِيا مَعَ آخَرينَ هُناكَ في أنطاكية يُعَلِّمانِ ويَنشُرانِ تَعاليمَ رِسالةِ سَيّدِنا عيسى (سلامُهُ علينا).<verse eid="ACT 15:34-35" /></para>
  <para style="s">الخلاف الّذي وقع بين بولس وبرنابا</para>
  <para style="p">
    <verse number="36" style="v" sid="ACT 15:36" />وبَعدَ مُضيِّ فَترةٍ مِنَ الزَّمَنِ، حَدَّثَ بولُسُ بَرنابا قائِلاً: "لنَعُدْ لزيارةِ المُؤمنينَ في جَميعِ أنحاءِ البِلادِ الّتي كُنّا قد نَشَرنا فيها رِسالةَ المَسيحِ للاطمِئنانِ على أحوالِهِم". <verse eid="ACT 15:36" /><verse number="37" style="v" sid="ACT 15:37" />فاقتَرَحَ بَرنابا أن يَصطَحِبا يُوحنّا المَعرُوف بِمَرقُسَ، <verse eid="ACT 15:37" /><verse number="38" style="v" sid="ACT 15:38" />ولكنّ بُولسَ رَأى أنّ يوحَنّا لا يَصلُحُ للمُهِمّةِ الّتي يَقومانِ بِها، لأنّهُ تَرَكَهُما في مُقاطعةِ بَمْفيليّة، ولم يُتِمَّ مُهِمّةَ نَشرِ الدَّعوةِ مَعَهُما. <verse eid="ACT 15:38" /><verse number="39" style="v" sid="ACT 15:39" />وأثارَ هذا الأمرُ خِلافًا شَديدًا بَينَ بُولسَ وبَرنابا وأدّى إلى انفِصالِهِما، فاصطَحَبَ بَرنابا مَرقُسَ مُبحِرًا بِاتِّجاهِ قُبرُص. <verse eid="ACT 15:39" /><verse number="40‏-41" style="v" sid="ACT 15:40-41" />واختارَ بولسُ سِلواني، وغَادَرا إلى سُوريا ثُمَّ كِليكيّة بَعدَ أن وَدّعَهُما المُؤمِنونَ بأمانِ اللهِ، فأخَذا يَطوفانِ ويُقَوِّيانِ عَزائِمَ كُلِّ جَماعاتِ المُؤمِنينَ ويُؤازِرانِهِم.<verse eid="ACT 15:40-41" /></para>
  <chapter eid="ACT 15" />
  <chapter number="16" style="c" sid="ACT 16" />
  <para style="cl">الفصل السّادس عشر</para>
  <para style="s">تيموتاوي</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 16:1" />ومِن هُناكَ تَوَجَّهَ بولُسُ إلى مَدينةِ دَربَة ثُمَّ لِستَرَة وكانَ فيها أحَدُ أتباعِ عيسى (سلامُهُ علينا) واسمُهُ تيموتاوي وكانَت أُمُّهُ مِمَّن آمَنوا بالسّيِّدِ المَسيحِ وهي مِن أصلٍ يَهوديٍّ، أمّا أبُوهُ فكانَ يُونانيًّا. <verse eid="ACT 16:1" /><verse number="2" style="v" sid="ACT 16:2" />وكانَ تيموتاوي مَوضَعَ إعجابِ المُؤمِنينَ ومَدحِهِم في لِستَرَة وإيقونية. <verse eid="ACT 16:2" /><verse number="3" style="v" sid="ACT 16:3" />وعِندَما أرادَ بُولسُ اصطِحابَهُ في تَرحالِهِ، جَعَلَهُ يَختَتِنُ إذ إنّهُ كانَ مَعروفًا لدَى يَهودِ المِنطقةِ بأنّ أباهُ يُونانيٌّ.<note caller="+" style="f"><char style="fr" closed="false">16‏.3 </char><char style="ft" closed="false">كان اليهود في فلسطين يعتبرون الزواج بين اليهود والوثنيين إثما كبيرا، ولكن هذا الموقف كان أقلّ تشدّدًا في منطقة لسترة مثلاً، حيث كان عدد الجالية اليهوديّة قليلا. ولم يكن تيموتاوي مقبولا عند اليهود لأنّه لم يكن يهوديًا بالتمام إذ لم يكن مختونًا. ولذلك شجّعه بولس على الختان لكي يصبح يهوديًا من أجل شهادته أمام الجماعة اليهودية، خاصّةً وأنّ بولس كان غالبا ما يبدأ وعظه من بيت العبادة في كلّ مدينةٍ يدخلها ليكلّم اليهود وغيرهم، لأنّهم يعلمون بالكتب السماوية وباستطاعتهم التجاوب مع دعوته بسهولة. </char></note> <verse eid="ACT 16:3" /><verse number="4" style="v" sid="ACT 16:4" />وهكذا، أخَذا يَتَنَقَّلانِ بَينَ المُدُنِ مُبَلِّغَيْنِ المُؤمِنينَ الفَتوى الّتي أجمَعَ عليها الحَواريّونَ والمَسؤولونَ عَن جَماعاتِ المُؤمِنينَ للعَمَلِ بها. <verse eid="ACT 16:4" /><verse number="5" style="v" sid="ACT 16:5" />فكانَت جَماعاتُ المُؤمِنينَ بسَيِّدِنا عيسى (سلامُهُ علينا) تَتَقَوَّى في إيمانِها، ويَزدادُ عَدَدُها يَومًا بَعدَ يومٍ.<verse eid="ACT 16:5" /></para>
  <para style="s">الدّعوة في مقدونيا</para>
  <para style="p">
    <verse number="6" style="v" sid="ACT 16:6" />ثُمَّ جاءَ وَحيٌ مِن رُوحِ اللهِ إلى بُولسَ ورِفاقِهِ بعَدَمِ نَشرِ الرِّسالةِ في مُقاطعةِ آسيا فتَوَجَّهوا إلى مُقاطَعتَي فِريجيّة وغَلاطيَة، <verse eid="ACT 16:6" /><verse number="7" style="v" sid="ACT 16:7" />وعِندَ حُدودِ مُقاطعةِ ميسيّا، حاوَلوا التَّوَجُّهَ إلى مُقاطعةِ بِيتينيّة ولكنّ رُوحَ سَيِّدِنا عيسى مَنَعَتهُم مِن ذلِكَ أيضًا، <verse eid="ACT 16:7" /><verse number="8" style="v" sid="ACT 16:8" />فاجتازوا مِنطقةَ مِيسيّا مُتَوَجِّهينَ إلى ميناءِ تَرْواسَ. <verse eid="ACT 16:8" /><verse number="9" style="v" sid="ACT 16:9" />وفي اللَّيلِ، رَأى بولُسُ في رؤيا رَجُلاً مَقدُونيًّا مِن شِمالِ اليونانِ واقِفًا يَتَوَسّلُ قائِلاً: "اُعبُرْ إلينا في مَقدونيا وساعِدْنا".<note caller="+" style="f"><char style="fr" closed="false">16‏.9 </char><char style="ft" closed="false">كانت مقدونيا مقاطعة رومانية.</char></note> <verse eid="ACT 16:9" /><verse number="10" style="v" sid="ACT 16:10" />وبَعدَ تِلكَ الرُّؤيا، تأكَّدَ بولُسُ ورِفاقُهُ<note caller="+" style="f"><char style="fr" closed="false">16‏.10 </char><char style="ft" closed="false">انطلاقا من هذه النقطة، انتقل لوقا من الحديث بصيغة الضمير الغائب إلى الحديث بضمير المتكلّم، وهذا يعني أنّه أصبح هنا أحد مرافقي بولس وسِلواني وشاهدًا بأم عينه على الأحداث التي جرت فيما بعد. وفي صياغة هذا النص سنواصل استعمال ضمير الغائب لسلاسة وضوح الفكرة وتسلسلها. </char></note> أنّ اللهَ دَعاهُم للتَّوَجُّهِ إلى تِلكَ المِنطقةِ لنَشرِ رِسالةِ المَسيحِ (سلامُهُ علينا)، وفي الحالِ أخَذوا يَستَعِدّونَ للتَّوَجُّهِ إلى مَقدونيا.<verse eid="ACT 16:10" /></para>
  <para style="s">في مدينة فيليبّي</para>
  <para style="p">
    <verse number="11" style="v" sid="ACT 16:11" />وأبحَروا بَعدَ ذلِكَ مِن ميناءِ تَرْواسَ مُتَوَجِّهينَ مُباشَرةً إلى جَزيرةِ سَموتْراكي. وفي اليَومِ التّالي، سافَروا إلى نيابْلُسَ الميناءِ الرَّئيسيِّ في مُقاطعةِ مَقدونيا، <verse eid="ACT 16:11" /><verse number="12" style="v" sid="ACT 16:12" />وبَعدَهُ، سافَروا إلى مَدينةِ فيليبّي بَرًّا وأقاموا فيها عِدّةَ أيّامٍ، وكانَت فيليبّي مُستَعمَرةً رُومانيّةً مِن أهمِّ مُدُنِ مُقاطعةِ مَقدونيا. <verse eid="ACT 16:12" /><verse number="13" style="v" sid="ACT 16:13" />وفي يومِ السَّبتِ، خَرَجوا مِن بوّابةِ المَدينةِ إلى ضِفَّةِ النَّهرِ، مُتَوَقّعينَ وُجُودَ مَكانٍ للعِبادةِ.<note caller="+" style="f"><char style="fr" closed="false">16‏.13 </char><char style="ft" closed="false">يبدو هنا أنّ الاجتماع قد عقد في الهواء الطلق بعيدا عن المباني. ففي الأماكن التي تخلو من بيوت العبادة، كان اليهود يفضّلون عقد اجتماعهم في مكانٍ طاهر قرب مصدر ماء. ويبدو أن غسل الأيدي قبل الصلاة قد تحوّل إلى عادة تمارس طبيعيًا عند اليهود خارج فلسطين، وتكشف عمليات التنقيب عن أهميّة وجود الماء في خدمة بيوت العبادة. </char></note> وعِندَ وصُولِهِم، وَجَدوا جَماعةً مِنَ النِّسوةِ المُؤمِناتِ اللَّواتي تَجَمَّعْنَ للعِبادَةِ، فجَلَسوا يُحَدِّثونَهُنّ عن رِسالةِ السّيِّدِ المَسيحِ، <verse eid="ACT 16:13" /><verse number="14" style="v" sid="ACT 16:14" />وكانَ بَينَ أولئكَ النِّسوةِ المُصغِياتِ امرأةٌ مِن غَيرِ اليَهودِ، اسمُها ليديا مِن مَدينةِ ثياتيرا، وهي امرأةٌ تَخافُ اللهَ وتَعمَلُ في تِجارةِ القُماشِ باهظِ الثَّمنِ ذي اللَّونِ الأُرجوانيّ،<note caller="+" style="f"><char style="fr" closed="false">16‏.14 </char><char style="ft" closed="false">كانت ليديا امرأةً من ثياتيرا وهي مدينة تقع في مقاطعة آسيا الرومانية، وكانت ثياتيرا تشتهر بالصبغة الأرجوانية التي كانت تستخرج من الصدف البحري. ومن المرجّح أنّ ليديا لم تكن يهودية، ولكنّها كانت تعبد اللّه مع اليهود. كما أنّها كانت على الأرجح غنيّة إذ كانت تبيع هذه الصبغة الغالية. </char></note> ففَتَحَ اللهُ عليها وجَعَلَها تُقبِلُ على كَلامِ بُولسَ <verse eid="ACT 16:14" /><verse number="15" style="v" sid="ACT 16:15" />وتَتَطَهَّرُ بالماءِ وأهلَ بيتِها الُّذينَ أصبَحوا بذلِكَ مِن أتباعِ عيسى (سلامُهُ علينا). وأخَذَت ليديا تُلِحُّ عليهِم بالقولِ: "إن كُنتُم تَعتبِرونَني مؤمِنةً مُخلِصةً لرِسالةِ سَيِّدِنا عيسى، فهيّا للإقامةِ في داري". ونُزولاً عِندَ طَلَبِها هذا، أقامَ بولُسُ ورِفاقُهُ عِندَها.<verse eid="ACT 16:15" /></para>
  <para style="s">بولس وسلواني في السّجن</para>
  <para style="p">
    <verse number="16" style="v" sid="ACT 16:16" />وبَينَما كانوا في طَريقِهِم ذاتَ مَرّةٍ إلى مَكانِ العِبادةِ على ضِفَّةِ النَّهرِ في مَدينةِ فيليبّي، التَقَوا جارِيةً سَكَنَها جِنِّيٌّ فجَعَلَها تَتَنَبَّأُ بالغَيبِ، وأصبَحَ ذلِكَ حِرفةً لها ومَصدَرًا لمالٍ وَفيرٍ لأسيادِها. <verse eid="ACT 16:16" /><verse number="17" style="v" sid="ACT 16:17" />وأخَذَت هذِهِ الفَتاةُ تَسيرُ إثرَ بولُسَ ورِفاقِهِ صارِخةً: "هؤلاءِ الرِّجالُ هم عِبادُ اللهِ العليِّ، وهم يَدِلّونَكُم على طَريقِ النَّجاةِ!" <verse eid="ACT 16:17" /><verse number="18" style="v" sid="ACT 16:18" />وظَلَّت على هذِهِ الحالِ عِدّةَ أيّامٍ، فانزَعَجَ مِنها بولُسُ، وتَوَجَّهَ بِحَديثِهِ إلى الجِّنيِّ الّذي يَسكُنُها قائِلاً: "آمُرُكَ بِاسمِ سَيّدِنا عيسى المَسيحِ أن تُغادِرَ جَسَدَها!" فخَرَجَ الجِّنيُّ في الحالِ.<verse eid="ACT 16:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="ACT 16:19" />وعِندَما عَلِمَ أسيادُها بذلِكَ أدرَكوا أنّ بولُسَ قد أضاعَ عليهِم مَورِدًا سَهلاً مِنَ المالِ، فقَبَضوا عليهِ وعلى سِلواني وجَرُّوهُما إلى السّاحةِ العامّةِ أمامَ السُّلُطاتِ، <verse eid="ACT 16:19" /><verse number="20" style="v" sid="ACT 16:20" />وتَقَدّموا بِهِما إلى رِجالِ السُّلطةِ وقالوا: "إنّ هذينِ الرَّجُلينِ اليَهوديَّينِ يُثيرانِ الفَوضى في مدِينتِنا، <verse eid="ACT 16:20" /><verse number="21" style="v" sid="ACT 16:21" />فهُما يَدعوانِ إلى أُمورٍ لا تَتّفِقُ مَعَ مُعتَقداتِنا وعاداتِنا نحنُ الرُّومانَ!"<note caller="+" style="f"><char style="fr" closed="false">16‏.21 </char><char style="ft" closed="false">يُحاكم بولس بتهمة التبشير بديانة غير رومانية. ذلك أنّ الروماني الذي يعتنق اليهودية يدان بحسب القانون الروماني، ولم يعرف الولاة حينئذٍ الفرق بين رسالة بولس والديانة اليهودية.</char></note> <verse eid="ACT 16:21" /><verse number="22" style="v" sid="ACT 16:22" />وأثارَ ذلِكَ حَفيظةَ مَن حَضَرَ مِنَ النّاسِ ضِدَّهُما، فأمَرَ رِجالُ السُّلطةِ بِنَزعِ ثيابِهِما وضَربِهِما بالعِصيِّ، <verse eid="ACT 16:22" /><verse number="23" style="v" sid="ACT 16:23" />ففَعَلوا ذلِكَ. ثُمَّ رَمى بِهِما الحُرّاسُ في غَياهِبِ السِّجنِ وأمَروا السَّجّانَ بتَشديدِ الحِراسَةِ عليهِما، <verse eid="ACT 16:23" /><verse number="24" style="v" sid="ACT 16:24" />وتَنفيذًا للأوامِرِ وُضِعَت أقدامُهُما في خَشَبةِ التَّعذيبِ.<verse eid="ACT 16:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="ACT 16:25" />وعِندَ مُنتَصَفِ اللَّيلِ، تَقريبًا، وبَينَما كانَ بولُسُ وسِلواني يَدعوانِ ويَبتَهِلانِ اللهَ بآياتٍ مِنَ الزَّبورِ، وبَقيّةُ السُّجناءِ يُصغونَ إليهِما، <verse eid="ACT 16:25" /><verse number="26" style="v" sid="ACT 16:26" />حَدَثَ زِلزالٌ عَنيفٌ هَزَّ أركانَ السِّجنِ، فتَفَتّحَت أبوابُهُ كُلُّها، وانفَكَّت قُيودُ جَميعِ المَساجينِ. <verse eid="ACT 16:26" /><verse number="27" style="v" sid="ACT 16:27" />وعِندَما انتَفَضَ السَّجّانُ مِن نَومِهِ، ورَأى أبوابَ السِّجنِ مَفتوحَةً على مِصراعَيْها، ظَنَّ أنّ المَساجينَ قد هَرَبوا فجَرَّدَ سَيفَهُ مِن غِمدِهِ يُريدُ قَتلَ نَفسِهِ،<note caller="+" style="f"><char style="fr" closed="false">16‏.27 </char><char style="ft" closed="false">بالنسبة إلى الرومان، إذا سمح سجّان بفرار سجين من سجنائه، كان يعاقب نفس العقاب الذي كان السجين يواجهه. ولا بدّ أنّ من بين السجناء من كان محكوما عليه بالموت. لذلك أراد هذا السجّان قتل نفسه ليتجنّب مواجهة الذل والتعذيب.</char></note> <verse eid="ACT 16:27" /><verse number="28" style="v" sid="ACT 16:28" />فصَرَخَ بِهِ بولسُ قائِلاً: "لا تَقتُلْ نَفسَكَ، فنَحنُ المَساجينَ ما زِلنا في أماكِنِنا!"<verse eid="ACT 16:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="ACT 16:29" />فطَلَبَ السَّجّانُ مِصباحًا لإضاءةِ السِّجنِ، ثُمَّ اندَفَعَ وقدِ اعتَرَتْهُ رَجفةٌ ورَمى بنَفسِهِ أمامَ بولُسَ وسِلواني، <verse eid="ACT 16:29" /><verse number="30" style="v" sid="ACT 16:30" />وأخرَجَهُما قائلاً: "أخبِراني يا سَيّدَيَّ ما يَجِبُ عليَّ فِعلُهُ لأفوزَ بالنَّجاةِ؟"<note caller="+" style="f"><char style="fr" closed="false">16‏.30 </char><char style="ft" closed="false">من الممكن أن يكون السجّان قد سمع الجارية التي سكنها جني تتكلّم عن هؤلاء الرجال الذين كانوا يبشّرون بطريق النجاة. ومن المرجّح أنّه فسّر الزلزال كظاهرة خارقة تبرهن على صدق هؤلاء الرجال ورسالتهم.</char></note> <verse eid="ACT 16:30" /><verse number="31" style="v" sid="ACT 16:31" />فأجاباهُ بالقَولِ: "ما عليكَ سِوى الإيمانِ بعِيسى المَسيحِ، لتَكونَ أنتَ وأهلُ بَيتِكَ مِنَ النّاجينَ".<note caller="+" style="f"><char style="fr" closed="false">16‏.31 </char><char style="ft" closed="false">توقّع الرومان أنّ جميع أفراد العائلات يتّبعون ديانة ربّ البيت لأنّ هذا الأب كان يتمتّع بنفوذ كبير يخضع أفراد عائلته لخياره. </char></note> <verse eid="ACT 16:31" /><verse number="32" style="v" sid="ACT 16:32" />وتَحَدَّثا مَعَهُ ومَعَ أهلِ بيتِهِ حَولَ رِسالةِ سَيّدِنا عيسى (سلامُهُ علينا). <verse eid="ACT 16:32" /><verse number="33" style="v" sid="ACT 16:33" />ثُمّ بادَرَ السَّجّانُ في تِلكَ السّاعةِ مِن اللّيلِ بِغَسلِ جِراحِهِما. وبَعدَ ذلِكَ تَطَهَّرَ وأهلَ بيتِهِ بالماءِ صِبغةً للهِ، <verse eid="ACT 16:33" /><verse number="34" style="v" sid="ACT 16:34" />ثُمّ اصطَحَبَ بولُسَ وسِلواني إلى دارِهِ. وقامَ على خِدمتِهِما بتَقدِيمِ الطَّعامِ لهُما، لِيَعُمَّ الفَرَحُ في أرجاءِ ذلِكَ البيتِ بَعدَ أنِ اهتَدَى أهلُهُ إلى اللهِ.<verse eid="ACT 16:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="ACT 16:35" />وعِندَ الفَجرِ، أرسَلَ رِجالُ السُّلطةِ بَعضَ الحَرَسِ إلى السَّجّانِ قائِلينَ: "أطلِقْ سَراحَ الرَّجُلَينِ". <verse eid="ACT 16:35" /><verse number="36" style="v" sid="ACT 16:36" />فأخبَرَ السَّجّانُ بولُسَ بذلِكَ قائِلاً: "جاءَ الأمرُ بإطلاقِ سَراحِكُما، فَارحَلا بأمانِ اللهِ ورِعايتِهِ". <verse eid="ACT 16:36" /><verse number="37" style="v" sid="ACT 16:37" />فانبَرى بولُسُ قائِلاً: "لقد خالَفوا القانونَ عِندَما انهالوا علينا ضَربًا دونَ مُحاكَمةٍ مَعَ أنّنا مِن مُواطِني الإمبراطوريّةِ الرُّومانيّة، ورَمَونا في السِّجنِ، وهل يُريدونَ الآنَ التَّخَلُّصَ مِنّا سِرًّا؟! هذا مُستَحيلٌ، عليهِم القُدومُ إلينا شَخصيًّا لإطلاقِ سَراحِنا".<note caller="+" style="f"><char style="fr" closed="false">16‏.37 </char><char style="ft" closed="false">لم تتمتّع إلاّ فئةٌ قليلة من سكّان الإمبراطورية الرومانية بالمواطنة الرومانية بما فيها من حقوقٍ وامتيازات خاصّة. وكان يُمنع عقاب مواطن روماني بالضرب أمام الملأ، حتّى بعد المحاكمة. </char></note><verse eid="ACT 16:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="ACT 16:38" />فنَقَلَ الحُرّاسُ ذلِكَ الأمرَ إلى رِجالِ السُّلطةِ، وعِندَما عَلِمَ هؤلاءِ بأنّ بولُسَ وسِلواني مُواطِنانِ رُومانيّانِ خافوا،<note caller="+" style="f"><char style="fr" closed="false">16‏.38 </char><char style="ft" closed="false">لقد جعل بولس وسِلواني رجال السلطة أنفسهم في مأزقٍ قانوني لأنّهما انتظرا أن يُضربا أوّلاً قبل أن يُعلما السلطات بأنّهما مواطنان رومانيان. وبذلك أصبح الولاة، لا بولس وسِلواني، مضطرّين للمفاوضة لأنّ التقارير التي قد تصدر في شأنهم قد تضع شرعيتهم في خطر وقد تحرم مدينة فيليبي من مركزها المميّز كمستعمرة رومانية. وخطة بولس وسلواني هذه، ستساعدهما لاحقًا على ضمان أمن مجموعة المؤمنين الناشئة. </char></note> <verse eid="ACT 16:38" /><verse number="39" style="v" sid="ACT 16:39" />وذَهَبوا إليهِما إرضاءً لهُما، وأخرَجوهُما مِنَ السِّجنِ، طالبِينَ مِنهُما الرَّحيلَ عنِ المَدينةِ. <verse eid="ACT 16:39" /><verse number="40" style="v" sid="ACT 16:40" />وتَوَجَّهَ بولُسُ وسِلواني بَعدَ إطلاقِ سَراحِهِما إلى دارِ ليديا، حَيثُ اجتَمَعا مَعَ المُؤمِنينَ، ليَشُدّا مِن عَزائِمِ إيمانِهِم بعيسى (سلامُهُ علينا) ثُمَّ غادَرا المَدينةَ.<verse eid="ACT 16:40" /></para>
  <chapter eid="ACT 16" />
  <chapter number="17" style="c" sid="ACT 17" />
  <para style="cl">الفصل السّابع عشر</para>
  <para style="s">في مدينة تسالونكي</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 17:1" />وبَعدَ أن مَرَّ بولُسُ وسِلواني ببَلدتَي أمْفيبُوليسَ وأبلونِيّة، وَصَلا مَدينةَ تَسالونْكي،<note caller="+" style="f"><char style="fr" closed="false">17‏.1 </char><char style="ft" closed="false">كانت مدينة تسالونكي عاصمة ولاية مقدونيا الرومانية.</char></note> وكانَ فيها بَيتُ عِبادةٍ لليَهودِ، <verse eid="ACT 17:1" /><verse number="2‏-3" style="v" sid="ACT 17:2-3" />فتَوَجَّهَ بولسُ إلى هُناكَ على عادتِهِ، وظَلَّ هُناكَ ثَلاثَةَ أسابيع، وفي كُلِّ يوم سَبت يُناقشُ الحُضورَ بأنّ قَدَرَ عيسى (سلامُهُ علينا) أن يُقاسي الآلامَ والمَوتَ، ويُبعَثَ بَعدَ ذلِكَ حيًّا، مُستَنِدًا في ذلِكَ إلى حُجَجٍ مِنَ التَّوراةِ والزَّبورِ وغَيرِهِما مِن كُتُبِ الأنبياءِ. وكانَ يَقولُ: "إنّ عيسى الّذي أُنادي بِهِ هو المَسيحُ المُنتَظَرُ!" <verse eid="ACT 17:2-3" /><verse number="4" style="v" sid="ACT 17:4" />فاقتَنَعَ بذلِكَ بَعضٌ مِنَ اليَهودِ الّذينَ انضَمّوا إلى بولُسَ وسِلواني وأصبَحوا مِنَ المُؤمِنينَ، بالإضافةِ إلى عَدَدٍ كَبيرٍ مِنَ اليُونانيّينَ الأتقياءِ، واليُونانيّاتِ ذَوَاتِ الشَّأنِ، <verse eid="ACT 17:4" /><verse number="5" style="v" sid="ACT 17:5" />مِمّا مَلأ نُفوسَ قادةِ اليَهودِ حَسَدًا، فجَمَعوا بَعضَ الرُّعاعِ مِنَ الشَّوارِعِ وكَوَّنوا عِصابَةً تَزرَعُ في أرجاءِ المَدينةِ الفَوضى والقَلاقِلَ. واقتَحَمَت هذِهِ العِصابةُ دارَ ياسونَ بَحثًا عن بولُسَ وسِلواني، لإحضارِهِما أمامَ عامّةِ النّاسِ، <verse eid="ACT 17:5" /><verse number="6" style="v" sid="ACT 17:6" />لكنّهُم لم يَعثَروا عليهِما، فاقتادوا ياسونَ وبَعضَ المُؤمِنينَ إلى رِجالِ السُّلطةِ في المَدينةِ، وكانوا يَهتِفونَ قائِلينَ: "بولُسُ وسِلواني هُما مَن أشعَلا نارَ الفِتنةِ في كُلِّ مَكانٍ، وها قد قَدِما إلى هُنا أيضًا! <verse eid="ACT 17:6" /><verse number="7" style="v" sid="ACT 17:7" />فقَدِ استضافَهُما ياسُونُ عِندَهُ،<note caller="+" style="f"><char style="fr" closed="false">17‏.7 </char><char style="ft" closed="false">ياسون اسم يوناني شائع ولكنّه كان شائعا أيضًا بين جالية اليهود في المهجر، كما تشهد على ذلك بعض الكتابات المنقوشة والوثائق التجارية. ومن المرجّح أنّه مضيف يهودي وربّما يكون بولس وسِلواني قد مكثا عنده خلال عملهما في المدينة. </char></note> وهم جَميعًا مُتمرِّدونَ ضِدَّ القَيصَرِ لأنّهُم يُبايعونَ مَلِكًا غَيرَهُ اسمُهُ عيسى!"<note caller="+" style="f"><char style="fr" closed="false">17‏.7 </char><char style="ft" closed="false">كان الرومان يعتبرون أيّ إعلان عن ملكٍ نظير للقيصر، أي السيد المسيح، (آية 3) خيانة بحقّ جلالة الإمبراطور، وبذلك كانوا يفهمون إعلان العلامات التي تشير إلى قدوم هذا القائد الجديد (انظر رسالتي تسالونيكي الأولى والثانية) كتوقّعات لوفاة الإمبراطور الحالي وزواله، لذا كانت تلك التوقّعات انتهاكًا للمراسيم التي كان يصدرها الإمبراطور. وكان المواطنون الذين يقسمون على الولاء للقيصر يلتزمون في قسمهم أيضًا بالتبليغ عن أيّة محاولة للخيانة. </char></note> <verse eid="ACT 17:7" /><verse number="8" style="v" sid="ACT 17:8" />وأثارَ هذا القَولُ حَفيظةَ الحاضِرينَ ورِجالِ السُّلطةِ، <verse eid="ACT 17:8" /><verse number="9" style="v" sid="ACT 17:9" />فأخَذَ هؤلاء كَفالةً مِن ياسُونَ ومَن كانَ مَعَهُ، ثُمَّ أطلَقوا سَراحَهُم.<note caller="+" style="f"><char style="fr" closed="false">17‏.9 </char><char style="ft" closed="false">أخذ الكفالة من ياسون والباقين تجعلهم مسؤولين قانونيًا عن بولس وسِلواني، حتّى يغادرا المدينة ولا يرجعا.</char></note><verse eid="ACT 17:9" /></para>
  <para style="s">في مدينة بيريّة</para>
  <para style="p">
    <verse number="10" style="v" sid="ACT 17:10" />وعِندَ هُبوطِ اللّيلِ، أسرَعَ المُؤمِنونَ في تَسالونْكي وأخرَجوا بولُسَ وسِلواني مِنها وأرسَلوهُما إلى بَلدةِ بيرِيّةِ. وبَعدَ أن وَصَلا إليها، تَوَجَّها إلى بيتِ العِبادةِ اليَهوديّ. <verse eid="ACT 17:10" /><verse number="11" style="v" sid="ACT 17:11" />واستَمِعَ يَهودُ تِلكَ البَلدةِ إلى رِسالةِ سَيّدِنا عيسى (سلامُهُ علينا) بِاهتمامٍ إذ كانوا أوسَعَ صَدرًا مِن أهلِ تَسالونكي وأرحَبَ أُفُقًا. وكانوا يَقومونَ بِتَدارُسِ الكُتُبِ السَّماويّة يَوميًّا للتَّأكُّدِ مِن صِحَّةِ كلامِ بولسَ وسِلواني. <verse eid="ACT 17:11" /><verse number="12" style="v" sid="ACT 17:12" />وهُناكَ آمَنَ بِسَيِّدِنا عيسى كَثيرٌ مِنَ اليَهودِ وعَدَدٌ مِنَ اليُونانيّاتِ ذَوَاتِ الشَّأنِ، وكَثيرٌ مِنَ رِجالِ اليونانِ. <verse eid="ACT 17:12" /><verse number="13" style="v" sid="ACT 17:13" />وعِندَما عَرَفَ اليَهودُ في تَسالونكي بأنّ بولسَ وسِلواني يُناديانِ برِسالةِ اللهِ في بَلدةِ بيرِيّة أيضًا، تَوَجَّهوا إلى هُناكَ لإثارةِ النّاسِ وتَحريضِهِم على القَلاقِلِ. <verse eid="ACT 17:13" /><verse number="14‏-15" style="v" sid="ACT 17:14-15" />فأسرَعَ المُؤمِنونَ في بيرِيّة بإخراجِ بولُسَ مِنَ المَدينةِ، خَوفًا عليهِ، وإيصالِهِ إلى الشَّاطئِ ومِنها إلى أثِينا. ثُمَّ وَدَّعَ بولسُ الرِّجالَ الّذينَ رافَقوهُ وأوصاهُم بضَرورةِ إلحاقِ سِلواني وتيموتاوي بِهِ على عَجَلٍ إذ كانا ما يَزالانِ في بيرِيّةِ.<note caller="+" style="f"><char style="fr" closed="false">17‏.14‏-15 </char><char style="ft" closed="false">من المرجّح أنّ سِلواني وتيموتاوي بقيا في بيريّة لشدّ أزر مجموعة المؤمنين الجدد في تلك المنطقة. </char></note><verse eid="ACT 17:14-15" /></para>
  <para style="s">في مدينة أثينا</para>
  <para style="p">
    <verse number="16" style="v" sid="ACT 17:16" />وبَينَما كانَ بُولسُ في انتِظارِ سِلواني وتيموتاوي في مَدينةِ أثينا، استَبَدَّ بِهِ ضِيقٌ شَديدٌ عِندَ رُؤيتِهِ لتِلكَ المَدينةِ وقدِ امتَلأتْ بالأوثانِ، <verse eid="ACT 17:16" /><verse number="17" style="v" sid="ACT 17:17" />فأخَذَ يُنادي في بَيتِ عِبادةِ اليَهودِ بالإيمانِ بِالسَّيّدِ المَسيحِ أمامَ اليَهودِ وغَيرِهِم مِنَ المُتَعَبِّدينَ اليُونانيّينَ. وكانَ بولُسُ يَتَحَدَّثُ يَوميًّا عنِ الرِّسالةِ أمامَ أيِّ شَخصٍ يُقابِلُهُ في ساحةِ تِلكَ المَدينةِ، داعِيًا إيّاهُ إلى الإيمانِ. <verse eid="ACT 17:17" /><verse number="18" style="v" sid="ACT 17:18" />ونَشَبَ جِدالٌ بَينَ بولسَ وجَماعةٍ مِنَ الفَلاسِفةِ الأبيقوريّينَ والرِّواقيّينَ،<note caller="+" style="f"><char style="fr" closed="false">17‏.18 </char><char style="ft" closed="false">كان الأبيقوريّون يتّبعون تعاليم الفيلسوف أبيقور. وقد اعتبر الأبيقوريّون اللذّة هدفًا أساسيًا في الحياة، وهي لذّة حياة الهدوء، الخالية من الألم والمشاعر المزعجة والمخاوف الخرافية وبشكلٍ خاص الخوف من الموت. ولم ينكر الأبيقوريّون وجود الآلهة التي كانت بحسب رأيهم لا تهتمّ بحياة الناس. هدف الرُّواقيّين العيش بانسجامٍ مع الطبيعة، ظنّا منهم أنّ حياتهم تمتلئ هكذا بالصلاح والسلام. وقد آمن الرُّواقيّون بأنّ الوسيلة الوحيدة التي تضمن للناس السيطرة على حياتهم هي التحكّم في ردّات فعلهم لما يحصل في العالم. وكان الرُّواقيّون وحْدِوجوديين (وهو ما يعني أنّ العالم وُجد من واحد)، واللّه هو بنظرهم روح العالم. إيمانهم كان بالكوزموبوليس أيّ المدينة العالمية التي تنعم فيها النفوس الحرّة فعلاً بحقوق مدنية متساوية، وهو ما ساعد في زوال الفروقات القومية والاجتماعية.</char></note> فقالَ بَعضُهُم: "ماذا يَقصِدُ هذا الثَّرثارُ بكلامِهِ؟" وعَلَّقَ آخَرونَ بِالقَولِ: "يَبدو أنّ هذا الرَّجُلَ يُنادي بآلهةٍ غَريبةٍ" مُعتبِرينَ أنّ ما كانَ يَتَحَدَّثُ عنهُ بولسُ بشَأنِ عيسى (سلامُهُ علينا) والقِيامةِ، اسمان لإلهَينِ لم يَسمَعوا عنهُما مِن قَبلُ، <verse eid="ACT 17:18" /><verse number="19" style="v" sid="ACT 17:19" />فطَلَبوا مِنهُ أن يُرافِقَهُم إلى مَجلِسِ المُثَقَّفينَ في تَلِّ مَريخ قائلينَ: "نُريدُ مَعرِفةَ تِلكَ العَقيدةِ الجَديدةِ الَّتي تُنادي بِها، <verse eid="ACT 17:19" /><verse number="20" style="v" sid="ACT 17:20" />فأنتَ تُلقي على مَسامِعِنا أفكارًا مُثيرةً للتَّعَجُّبِ، ونَرغَبُ في مَعرِفةِ مَعناها". <verse eid="ACT 17:20" /><verse number="21" style="v" sid="ACT 17:21" />وكانَ شَغَفُ أهلِ أثينا والمُقيمينَ فيها مِنَ الأجانِبِ في ذلِكَ الحِينِ، مُتّجِهًا إلى الحَديثِ عَنِ الفَلسَفاتِ الجَديدةِ والإصغاءِ إلى كُلِّ ما يَتَعَلّقُ بها. <verse eid="ACT 17:21" /><verse number="22" style="v" sid="ACT 17:22" />وَوَقَفَ بولُسُ في مَجلِسِ المُثَقَّفينَ خَطيبًا وقالَ: "يا أهلَ أثينا، أراكُم مُهتَمِّينَ بأُمورِ الأديانِ، <verse eid="ACT 17:22" /><verse number="23" style="v" sid="ACT 17:23" />ولاحَظتُ ذلِكَ وأنا أسيرُ في مَدينتِكُم حَيثُ المَعابِدُ والمَقاماتُ الكَثيرةُ. وقد وَجَدتُ على مَذبَحٍ مِن مَذابِحِ القَرابينِ عِندَكُم عِبارةً تَقولُ: "إلى الإلَهِ المَجهولِ". فها أنا ذا قَدِمتُ الآنَ لأُحَدِّثَكُم عَن هذا الإلَهِ المَجهولِ الّذي تَعبُدونَهُ.<note caller="+" style="f"><char style="fr" closed="false">17‏.23 </char><char style="ft" closed="false">قبل زمن الحواري بولس بكثير، حلّت كارثة على مدينة أثينا، ولم يستطع أيّ مذبح استعطاف الآلهة لردّها آنذاك. ولذلك قرّر أهل هذه المدينة أن يقدّموا ذبائح لإلهٍ مجهولٍ، فتوقّف الوباء حالاً. وكان هذا المذبح ما زال قائما عند مرور بولس فاستخدمه قاعدةً لخطابه.</char></note> <verse eid="ACT 17:23" /><verse number="24" style="v" sid="ACT 17:24" />إنّهُ اللهُ العليُّ، خالقُ الكَونِ وما فيهِ، هو رَبُّ السَّماواتِ والأرضِ، ولَيسَت تِلكَ المَعابِدُ الّتي شَيَّدَها البَشَرُ لهُ بِسَكَنٍ، <verse eid="ACT 17:24" /><verse number="25" style="v" sid="ACT 17:25" />فهو لَيسَ بحاجةٍ إلى خِدمةِ البَشَرِ، إنّهُ غَنيٌّ عنها وعَن كُلِّ شَيءٍ، فهو المُعطي، وهو واهِبُ الحياةِ للبَشَرِ ولكُلِّ كائنٍ حيٍّ وهو رازِقُهُم. <verse eid="ACT 17:25" /><verse number="26" style="v" sid="ACT 17:26" />خَلَقَ البَشَرَ مِن رَجُلٍ واحِدٍ، لإعمارِ الأرضِ، ووَزَّعَهُم في أرجائِها وحَدَّدَ لكُلِّ واحِدٍ مِنهم زَمانَهُ ومَكانَهُ، <verse eid="ACT 17:26" /><verse number="27" style="v" sid="ACT 17:27" />وجَعَلَ لهُم كُلَّ ذلِكَ لَعَلَّهُم يَبحَثُونَ عنهُ لكي يَعرِفوهُ ويَعبُدوهُ بَعدَ اهتِدائِهِم إليهِ، مَعَ أنّهُ أقرَبُ إلينا مِن حَبلِ الوَريدِ. <verse eid="ACT 17:27" /><verse number="28" style="v" sid="ACT 17:28" />وكَما قالَ أحَدُ شُعَرائِكُم: "هو واهبُنا الحَياةَ ومانِحُنا القُدرَةَ والوُجودَ". وقالَ آخَرُ: "إنّما نَحنُ عِيالُ اللهِ".<note caller="+" style="f"><char style="fr" closed="false">17‏.28 </char><char style="ft" closed="false">في هذا المقطع، اقتبس بولس من شاعرين يونانيين، أبيميندس الكريتي الذي عاش في القرن السادس قبل الميلاد، والرُّواقي آراتس الذي عاش في القرن الثالث قبل الميلاد.</char></note><verse eid="ACT 17:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="ACT 17:29" />"نعم نَحنُ عِيالُ اللهِ، ولذا كانَ علينا ألاّ نَظَنُّ بأنّ اللهَ يَتَمَثّلُ في هذِهِ الأوثانِ الّتي هي مِن صُنعِ الإنسانِ ونِتاجِ فَنِّهِ ومَهاراتِهِ سَواءٌ أكانَت ذَهَبًا أم فِضَّةً أم حَجَرًا. <verse eid="ACT 17:29" /><verse number="30" style="v" sid="ACT 17:30" />لم يُعاقِبِ اللهُ في الماضي هؤلاءِ الجاهلينَ، أمّا الآنَ فقد صَدَرَ الأمرُ على الجَميعِ بالتَّوبةِ والأوبَةِ إليهِ لعِبادَتِهِ إلهًا واحِدًا، <verse eid="ACT 17:30" /><verse number="31" style="v" sid="ACT 17:31" />وذلِكَ لأنّهُ أرجأهُم ليَومٍ فيهِ يُحاسِبُ جَميعَ النّاسِ بالعَدلِ، بواسِطةِ الرَّجُلِ الّذي اختارَهُ، والّذي دَلَّهُم عليهِ مِن خِلالِ رُجوعِهِ حيًّا مِن بينِ الأمواتِ". <verse eid="ACT 17:31" /><verse number="32" style="v" sid="ACT 17:32" />وعِندَما سَمِعَ الحاضِرونَ بِخَبَرِ بَعثِ المَيتِ حيًّا، سَخِرَ بَعضٌ مِنهُم،<note caller="+" style="f"><char style="fr" closed="false">17‏.32 </char><char style="ft" closed="false">آمن معظم اليونانيين بوجود حياة بعد الموت ولكنّها حياة غير واضحة المعالم في العالم السفلي، كما آمنوا في بعض الأحيان، بالتقمّص. وقد كان صعبا على اليونانيّين الإيمان بقيامة الجسد. كما آمنوا أيضًا أنّ الزمن لا نهاية له، لذلك بَدَت فكرة يوم الدين غريبة كنهاية للزمن. </char></note> وقالَ آخَرونَ: "نُوَدُّ أن تُحَدِّثَنا بهذا المَوضوعِ في مُناسبةٍ أُخرى". <verse eid="ACT 17:32" /><verse number="33" style="v" sid="ACT 17:33" />عِندئذٍ غادَرَ بولُسُ المَجلِسَ <verse eid="ACT 17:33" /><verse number="34" style="v" sid="ACT 17:34" />وبِرِفقتِهِ بَعضُ الّذينَ انضَمّوا إليهِ مُؤمِنينَ بعيسى (سلامُهُ علينا)، ومِن هؤلاء دِيُونيسُ الّذي كانَ عَضوًا في مَجلِسِ المُثَقَّفينَ وامرأة تُدعى تَمارَة، وآخَرونَ غَيرُهُما.<verse eid="ACT 17:34" /></para>
  <chapter eid="ACT 17" />
  <chapter number="18" style="c" sid="ACT 18" />
  <para style="cl">الفصل الثّامن عشر</para>
  <para style="s">في مدينة كورنتوس</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 18:1" />ومِن أثينا سافَرَ بولُسُ إلى مَدينةِ كورِنْتوسَ، <verse eid="ACT 18:1" /><verse number="2" style="v" sid="ACT 18:2" />والتَقَى هُناكَ رَجُلاً يَهوديًّا اسمُهُ عَقيلُ مِن بلادِ البُنطِ. وكانَ قد قَدِمَ مُنذُ فَترةٍ قَصيرةٍ هو وزَوجتُهُ بَرَكةُ مِن إيطاليا بَعدَ أن أصدَرَ القَيصرُ كُلوديُوسُ أمرًا يَقضي بمُغادَرةِ جَميعِ اليَهودِ مَدينةَ روما. فتَوَجَّهَ بولُسُ لزِيارتِهِما، <verse eid="ACT 18:2" /><verse number="3" style="v" sid="ACT 18:3" />وأقامَ عِندَهُما لأنّهُما كانا يَشتَغِلانِ مِثلَهُ في صِناعةِ الخِيامِ، وعَمِلَ مَعَهُما. <verse eid="ACT 18:3" /><verse number="4" style="v" sid="ACT 18:4" />وكانَ يَجلِسُ في كُلِّ سَبتٍ في بَيتِ العِبادةِ مُناقِشًا هُناكَ اليَهودَ واليُونانيّينَ مُحاوِلاً إقناعَهُم برِسالةِ سَيِّدِنا عيسى (سلامُهُ علينا).<verse eid="ACT 18:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="ACT 18:5" />وبَعدَ وُصولِ سِلواني وتيموتاوي مِن مَقدونيا، استطاعَ بولُسُ التَّفَرُّغَ للقِيامِ بالدَّعوةِ لرِسالةِ عيسى (سلامُهُ علينا) ونَشرِها،<note caller="+" style="f"><char style="fr" closed="false">18‏.5 </char><char style="ft" closed="false">جلب سِلواني وتيموتاوي لبولس تقدمةً مالية من المؤمنين في مدينة فيليبّي حتّى يستطيع بولس التركيز على الدعوة، ولا يحتاج أن يعمل في صناعة الخيام لسدّ احتياجاته.</char></note> فكانَ يُشهِدُ اليَهودَ على أنّ عيسى (سلامُهُ علينا) هو المَسيحُ المُنتَظَرُ، <verse eid="ACT 18:5" /><verse number="6" style="v" sid="ACT 18:6" />إلاّ أنّ اليَهودَ عارَضوهُ وأهانوهُ، فما كانَ مِنهُ إلاّ أن نَفَضَ ثَوبَهُ<note caller="+" style="f"><char style="fr" closed="false">18‏.6 </char><char style="ft" closed="false">كان نفض الثوب عادة من العادات اليهودية لكي يعلن الشخص عن براءته وعدم موافقته بشدّة على رأي مخاصميه.</char></note> قائِلاً: "إن كانَ الهَلاكُ مآلَكُم أيُّها اليَهودُ فما ذاكَ إلاّ بما كَسَبَت أيدِيكُم، وما أنا عَنكُم بِمسؤُولٍ، ولَأتَوَجَّهَنَّ الآنَ إلى غَيرِكُم أدعوهُم إلى سَيِّدِنا عيسى". <verse eid="ACT 18:6" /><verse number="7" style="v" sid="ACT 18:7" />ومُنذُ ذلِكَ الوَقتِ نَقَلَ بولُسُ مَكانَ اجتِماعاتِهِ إلى دارٍ تَقَعُ قُربَ بَيتِ العِبادةِ لِشَخصٍ مِن غَيرِ اليَهودِ اسمُهُ تِيتُوسُ الصّدِّيق وكانَ رَجُلاً تَقيًّا. <verse eid="ACT 18:7" /><verse number="8" style="v" sid="ACT 18:8" />وهُناكَ اهتدَى على يَدِ بولُسَ كِرِيسْبُوسُ المَسؤولُ عَن بيتِ العِبادةِ وأهلِ بيتِهِ وكَثيرونَ مِن أهلِ كُورنتوسَ، وهكذا نَما فيهِم حَديثُ بولُسَ فآمَنوا بسَيِّدِنا عيسى (سلامُهُ علينا)، وتَطَهَّرُوا بالماءِ.<verse eid="ACT 18:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="ACT 18:9" />وفي إحدى اللّيالي أتى سَيِّدُنا عيسى (سلامُهُ علينا) إلى بولُسَ في الرُّؤيا وقالَ لهُ: "لا تَهابَنَّ أعداءَكَ وامضِ في الدَّعوةِ ولا تَصمُتْ، <verse eid="ACT 18:9" /><verse number="10" style="v" sid="ACT 18:10" />فأنا لكَ ظَهيرٌ ولن يَقدِرَ أحَدٌ على إيذائِكَ، فقَد اختَرتُ الكَثيرَ مِن أهلِ هذِهِ المَدينةِ ليَكونوا مِن أتباعي". <verse eid="ACT 18:10" /><verse number="11" style="v" sid="ACT 18:11" />وهكَذا أقامَ بولُسُ في كُورنتوسَ مُدَّةَ سَنةٍ ونِصفِ السَّنةِ ماضِيًا في نَشرِ رِسالةِ اللهِ مُفصِحًا عَمّا جاءَ فيها.<verse eid="ACT 18:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="ACT 18:12" />وعُيِّنَ في تِلكَ الفَترةِ غالِيُونُ حاكِمًا على أَخائِيةِ في جَنوبِ اليونان حَيثُ يُقيمُ بولسُ،<note caller="+" style="f"><char style="fr" closed="false">18‏.12 </char><char style="ft" closed="false">كان غاليون أخا للفيلسوف الروماني الشهير سينيكا. وقد اُكتشفت كتابة قديمة منقوشة في مدينة دلفي تظهر أنّ غاليون كان حاكم تلك المنطقة بين عامي 51 و52 للميلاد.</char></note> فَانتهَزَ اليَهودُ هُناكَ الفُرصةَ وتَجَمَّعوا يُريدونَ أخذَ بولُسَ ليَمثُلَ أمامَ الحاكمِ لمُقاضاتِهِ، فقالوا زاعِمينَ: <verse eid="ACT 18:12" /><verse number="13" style="v" sid="ACT 18:13" />"إنّ هذا الرَّجُلَ يُقنِعُ النّاسَ بعِبادةِ اللهِ بتَعليمٍ يُخالفُ ما جاءَ في الشَّريعةِ". <verse eid="ACT 18:13" /><verse number="14" style="v" sid="ACT 18:14" />وعِندَما هَمَّ بولُسُ بالرَّدِّ، التَفَتَ غالِيُونُ إلى اليَهودِ قائلاً: "يا مَعشرَ اليَهودِ، لو كانَت تُهمَتُكُم لهُ اقتِرافَ جُرمٍ أوِ ارتِكابَ مُخالفةٍ للقانونِ الرُّومانيّ، لاستَجَبتُ لكُم، <verse eid="ACT 18:14" /><verse number="15" style="v" sid="ACT 18:15" />ولكنّ التُّهمةَ المُوجَّهةَ إليهِ تَتَعَلّقُ بألقابٍ وأسماءٍ في شَرِيعتِكُم اليَهوديّة وبِأحكامِها، فما عليكُم إذَن سِوَى تَسويَةِ الخِلافِ بَينَكُم، ولذلِكَ فإنّني أرفُضُ مُقاضاتَهُ في تِلكَ الأُمورِ". <verse eid="ACT 18:15" /><verse number="16" style="v" sid="ACT 18:16" />ثُمَّ طَرَدَهُم مِنَ المَحكمةِ. <verse eid="ACT 18:16" /><verse number="17" style="v" sid="ACT 18:17" />وهَجَمَ الرَّعاعُ مِن غَيرِ اليَهودِ بَعدَ ذلِكَ على سُوستيني المَسؤولِ الجَديدِ عَن بيتِ العِبادةِ، وانهالوا عليهِ ضَربًا أمامَ المَحكَمةِ، ولم يُعِرْ غالِيُونُ ذلكَ أيَّ اهتمامٍ.<verse eid="ACT 18:17" /></para>
  <para style="s">بركة وعقيل وشمسيّ</para>
  <para style="p">
    <verse number="18" style="v" sid="ACT 18:18" />وبَقِيَ بولُسُ مُقيمًا بَعضَ الوَقتِ مَعَ المُؤمنينَ في مَدينةِ كورنتوسَ، ثُمَّ اتَّجَهَ بَعدَ أن وَدَّعَ إخوَتَهُ في الإيمانِ، بَحرًا إلى سُوريا وبِرفقتِهِ بَركة وعَقيلَ، ولكنّ بولُسَ قَبلَ مُغادَرتِهِ ميناءَ كَنْكِرِيّة حَلَقَ رأسَهُ وَفاءً لنَذرٍ كانَ عليهِ حَسَبَ العادةِ اليَهوديّة.<note caller="+" style="f"><char style="fr" closed="false">18‏.18 </char><char style="ft" closed="false">كان بولس يتّبع تقاليد النذر اليهودي المذكور في التوراة (انظر سفر العدد الفصل السادس). وكان ممنوعًا على اليهودي خلال النذر أن يحلق رأسه وأن يشرب أو يأكل أيّاً من نتاج الكرمة، كالخمر مثلاً. وفي نهاية النذر، كان يتمّ حلق الرأس ويقدّم الشعر للّه مصحوبا بذبيحة.</char></note> <verse eid="ACT 18:18" /><verse number="19" style="v" sid="ACT 18:19" />ووَصَلَ بولسُ ورَفيقاهُ ميناءَ مَدينةِ أَفاسوسَ، واتَّجَهَ هو إلى بَيتِ العِبادةِ حَيثُ كانَ يَدخُلُ في مُناقَشاتٍ مَعَ اليَهودِ <verse eid="ACT 18:19" /><verse number="20" style="v" sid="ACT 18:20" />الّذينَ طَلَبوا مِنهُ أن يُطيلَ إقامَتَهُ بَينَهُم، إلاّ أنّهُ اعتَذَرَ عَن ذلِكَ، <verse eid="ACT 18:20" /><verse number="21" style="v" sid="ACT 18:21" />وأعطاهُم وَعدًا عِندَ وَداعِهِم قائِلاً: "إنّني عائِدٌ إليكُم بإذنِ اللهِ". <verse eid="ACT 18:21" /><verse number="22" style="v" sid="ACT 18:22" />وتَرَكَ بَرَكةَ وعَقيلَ هُناكَ، وأبحَرَ مِن أَفاسوسَ إلى مَدينةِ قَيصَريّة، ومِنها إلى القُدسِ لزِيارَةِ جَماعةِ المُؤمِنينَ وتَفَقُّدِ أحوالِهِم، ورَحَلَ بَعدَها إلى مَدينةِ أَنطاكية شِمالِ سُوريا. <verse eid="ACT 18:22" /><verse number="23" style="v" sid="ACT 18:23" />وبَعدَ أن قَضَّى بَعضَ الوقتِ هُناكَ، غادَرَ لزِيارَةِ أماكِنَ أُخرى في مِنطقتَيْ غَلاطِيَةَ وفِرِيجيّةَ، مُشَجِّعًا ومُؤازِرًا أتباعَ المَسيحِ أينَما حَلَّ.<verse eid="ACT 18:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="ACT 18:24" />وكانَ قد قَدِمَ إلى مَدينةِ أَفاسوسَ مُنذُ وَقتٍ قَريبٍ رَجُلٌ يَهوديٌّ مِنَ الإسكندريّة اسمُهُ شَمسيّ، وهو مُتَكَلّمٌ فَصيحٌ عالِمٌ بالتَّوراةِ والزَّبورِ وغَيرِها مِن كُتُبِ الأنبياءِ، <verse eid="ACT 18:24" /><verse number="25" style="v" sid="ACT 18:25" />وقدِ اهتَدى إلى رِسالةِ سَيّدِنا عيسى (سلامُهُ علينا)، فكانَ يَتَحَدَّثُ عنها بكَثيرٍ مِنَ الحَماسةِ والدّقّةِ، ولم يَكُن على عِلمٍ إلاّ بتَعاليمِ النّبيِّ يَحيى الّتي كانَ يُنادي بِها أثناء تَطَهُّرِ النّاسِ بالماءِ، <verse eid="ACT 18:25" /><verse number="26" style="v" sid="ACT 18:26" />وكانَ شَديدَ الجُرأةِ في حَديثِهِ عَن ذلِكَ في بَيتِ العِبادةِ، وسَمِعَهُ هُناكَ عَقيلُ وبَرَكة، فرَافقاهُ إلى دارِهِما ليُبَيِّنا لهُ ما لم يَكُن يَعلَمُ مِن تَفاصيلَ في رِسالةِ عيسى (سلامُهُ علينا). <verse eid="ACT 18:26" /><verse number="27" style="v" sid="ACT 18:27" />ثُمَّ عَزَمَ شَمسيُّ على الذّهابِ إلى جَنوبِ اليُونان داعِيًا مُبَشِّرًا، فشَجَّعَهُ إخوانُهُ في الإيمانِ، في مَدينةِ أَفاسوسَ، على ذلك. <verse eid="ACT 18:27" /><verse number="28" style="v" sid="ACT 18:28" />وكَتَبوا رِسالةً إلى المُؤمِنينَ في اليونان، أوصَوهُم فيها بالتَّرحيبِ بِهِ. وعِندَ وصولِهِ إلى هُناكَ، أخَذَ بفَضلٍ مِنَ اللهِ يُقَوِّي عَزائمَ المُؤمنينَ بعيسى (سلامُهُ علينا)، إذ كانَ أثناءَ مُحاجَّتِهِ لجَماعاتِ اليَهودِ، يَتَفَوّقُ عليهِم أمامَ الجَميعِ، مُستَشهِدًا بما جاءَ في التَّوراةِ والزَّبورِ وفي غَيرِهِما مِن كُتُبِ الأنبياءِ الّتي ذَكَرَت أنّ عيسى (سلامُهُ علينا) هو المُنقِذُ المَوعودُ.<verse eid="ACT 18:28" /></para>
  <chapter eid="ACT 18" />
  <chapter number="19" style="c" sid="ACT 19" />
  <para style="cl">الفصل التّاسع عشر</para>
  <para style="s">بولس في أفاسوس</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 19:1" />وعِندَما كانَ شَمسيُّ في مَدينةِ كورنتوسَ، سافَرَ بولسُ عَبرَ الطُّرُقِ الدّاخِليّةِ إلى مَناطقِ غَلاطيَة وفِريجيّة إلى أن وَصَلَ مَدينةَ أَفاسوسَ، حَيثُ التَقَى بَعضَ أتباعِ السَّيِّدِ المَسيحِ (سلامُهُ علينا) <verse eid="ACT 19:1" /><verse number="2" style="v" sid="ACT 19:2" />فاستَفسَرَهم قائِلاً: "هل حَظيتُم بحُلولِ رُوحِ اللهِ فيكُم عِندَ إيمانِكُم بسَيّدِنا عِيسى؟" فأجابوا: "كَلاَّ، بل إنّنا لم نَسمَع بوجودِ رُوحِ اللهِ مِن قَبلُ!" <verse eid="ACT 19:2" /><verse number="3" style="v" sid="ACT 19:3" />فتابَعَ بولُسُ استِفساراتِه: "إذن، ما هي التَّعاليمِ الّتي اتّبعتُموها عِندَ تَطَهُّرُكُم بالماءِ؟" فقالوا: "قُمنا بذلِكَ حَسَبَ ما جاءَ بِهِ النّبيُّ يَحيى". <verse eid="ACT 19:3" /><verse number="4" style="v" sid="ACT 19:4" />فأجابَهُم بولُسُ قائِلاً: "كانَ النَّبيُّ يَحيى يَدعو النّاسَ للتَّطَهُّرِ بالماءِ دَليلاً على التَّوبةِ، وكانَ يَدعوهُم أيضًا للإيمانِ بالمُنقِذِ الّذي سيأتي مِن بَعدِهِ، أي بسَيِّدِنا عِيسى المَسيحِ!" <verse eid="ACT 19:4" /><verse number="5" style="v" sid="ACT 19:5" />ولمّا سَمِعوا بذلِكَ تَطَهّروا تَبَعًا لإيمانِهِم بعيسى (سلامُهُ علينا). <verse eid="ACT 19:5" /><verse number="6" style="v" sid="ACT 19:6" />ووَضَعَ بولسُ يَديهِ عليهِم، فحَلَّت عِندئذٍ روحُ اللهِ فيهِم وأخَذوا يَنطِقونَ بلُغاتٍ شَتَّى، وأصبَحوا يَتَنبَّؤونَ بأُمورٍ بوحيٍ مِنَ اللهِ، <verse eid="ACT 19:6" /><verse number="7" style="v" sid="ACT 19:7" />وكانَ عَدَدُ هؤلاءِ حِينَذاكَ حَوالي الاثنَيْ عَشَرَ رَجُلاً.<verse eid="ACT 19:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="ACT 19:8" />وظَلَّ بُولسُ على مَدى ثلاثةِ أشهُرٍ يَتَرَدَّدُ على بيتِ العِبادةِ، يُتابِعُ بِجُرأةٍ حَدِيثَهُ عَنِ المَملكةِ الأبَديّةِ الّتي وَعَدَ اللهُ بها، ويُناقِشُ مَن حَولَهُ فيُقنِعُهُم، <verse eid="ACT 19:8" /><verse number="9‏-10" style="v" sid="ACT 19:9-10" />غَيرَ أنّ هذا لم يَمنَع مِن وُجودِ فِئةٍ عارَضَتهُ رافِضةً الإيمانَ مُعلِنةً على المَلإ استهزاءَها برِسالةِ عيسى (سلامُهُ علينا)، فغادَرَ بولُسُ بيتَ العِبادةِ، واصطَحَبَ مَعَهُ المُؤمنينَ برِسالةِ المَسيحِ (سلامُهُ علينا)، وأخَذَ يُجالِسُهُم كُلَّ يومٍ، على مَدى سَنَتين، في قاعةٍ كَبيرةٍ يَملِكُها رَجُلٌ غَيرُ يَهوديٍّ اسمُهُ تيرانّوسُ. وكانَ بولُسُ يَشرَحُ التَّعاليمَ الّتي جاءَت في رِسالةِ سَيِّدِنا عِيسى (سلامُهُ علينا)، إلى أن سَمِعَ جَميعُ سُكّانِ مُقاطعةِ آسيا مِنَ اليَهودِ وغَيرِهِم حَديثَهُ حَولَ ما جاءَ مِن تَعاليمَ في رِسالةِ المَسيحِ (سلامُهُ علينا).<note caller="+" style="f"><char style="fr" closed="false">19‏.9‏-10 </char><char style="ft" closed="false">كانت أفاسوس مدينةً تجارية كبيرة، وعاصمة مقاطعة آسيا ومنها تُبَثّ الأخبار بسرعة فائقة، وكان بولس يقوم بتدريب الناس للدعوة وإرسالهم إلى كلّ أنحاء المنطقة. </char></note><verse eid="ACT 19:9-10" /></para>
  <para style="s">أبناء سكاوا</para>
  <para style="p">
    <verse number="11" style="v" sid="ACT 19:11" />وكانَ اللهُ يُجري على يَدَي بولُسَ مُعجِزاتٍ خارقةً <verse eid="ACT 19:11" /><verse number="12" style="v" sid="ACT 19:12" />حتّى إنّ النّاسَ حَمَلوا المَناشِفَ الّتي جَفَّفَ بولسُ بها عَرَقَهُ، أو مَلابِسَ العَمَلِ الّتي ارتَداها ليَضَعوها على مَرضاهُم لِتَزولَ الأمراضُ عنهُم، أو تَفِرَّ الجانُ والشَّياطينُ مِن أجسادِ مَن تَلَبَّسَتهُم في الحالِ. <verse eid="ACT 19:12" /><verse number="13" style="v" sid="ACT 19:13" />وحَدَثَ أنّ جَماعةً مِنَ اليَهودِ الرَّحّالينَ كانَت حِرفتُهُم طَردَ الجانِ والشّياطينِ مِنَ المَمسوسينَ، فحاوَلَ بَعضُهُم استِغلالَ اسمِ عيسى (سلامُهُ علينا) في أعمالِ السِّحرِ الّتي يَقومونَ بها. فكانوا يَقولونَ: "آمرُكَ لتَخرُجَنَّ باسمِ عيسى الّذي يُنادي بِهِ بولُسُ". <verse eid="ACT 19:13" /><verse number="14" style="v" sid="ACT 19:14" />وكانَ مِن بَينِ هؤلاءِ أولادٌ سَبعةٌ لرَجُلِ دينٍ يَهوديِّ اسمُهُ سَكاوا.<note caller="+" style="f"><char style="fr" closed="false">19‏.14 </char><char style="ft" closed="false">كان الاعتقاد سائدًا أنّ الأحبار اليهود يملكون قوّة عظيمة في عالم السحر، لكونهم يعلمون أسماء الكائنات الغيبية، وخاصةً أسماء الإله الأعظم.</char></note> <verse eid="ACT 19:14" /><verse number="15" style="v" sid="ACT 19:15" />وذاتَ يومٍ أرادوا طَردَ الشّياطينِ والجانِّ، وعِندَما أمَروهُم الخُروجَ باسمِ سَيِّدِنا عيسى (سلامُهُ علينا)، قالَ لهُم جِنّيٌ: "إنّني أعرِفُ عيسى كَما أعرِفُ بولُسَ أيضًا فمَن أنتُم؟!" <verse eid="ACT 19:15" /><verse number="16" style="v" sid="ACT 19:16" />ثُمَّ هَجَمَ عليهِم الجِنِّيُّ مِن خِلالِ الرَّجُلِ الّذي تَلَبَّسَهُ وأشبَعَهُم ضَربًا، فما كانَ مِنهُم إلاّ أن فَرُّوا بأنفُسِهِم عُراةً والجِراحُ تَملأ أجسادَهُم. <verse eid="ACT 19:16" /><verse number="17" style="v" sid="ACT 19:17" />ووَصَلَ ذلِكَ الخَبَرُ إلى سَمعِ جَميعِ أهالي أَفاسوسَ يَهودًا وغَيرَ يَهودٍ، فجَعَلَهُم يَهابونَ ويُعلونَ مِن شأنِ سَيّدِنا عيسى (سلامُهُ علينا). <verse eid="ACT 19:17" /><verse number="18‏-19" style="v" sid="ACT 19:18-19" />وإضافةً إلى كُلِّ هذا اعتَرَفَ كَثيرٌ مِنَ المُؤمنينَ بآثامِهِم، فجَمَعَ عَدَدٌ مِنهُم، مِنَ الّذينَ كانوا يُمارِسونَ السِّحرَ كُتُبَهُم وتَعاويذَهُم وأحرَقوها أمامَ المَلإ. وقد بَلَغَ ثَمَنُ هذِهِ الكُتُبِ ما يُقاربُ الخَمسينَ ألفًا مِنَ العُملةِ النَّقديّةِ الفِضيّةِ.<note caller="+" style="f"><char style="fr" closed="false">19‏.18‏-19 </char><char style="ft" closed="false">كانت الكتابات السحرية توضع في اسطوانات دائرية صغيرة أو مدلاّت وتتّخذ تعويذات. وتعادل قيمة هذه الكتب التي أحرقت أجْرَ خمسين ألف يوم عملٍ لعاملٍ عادي. </char></note> <verse eid="ACT 19:18-19" /><verse number="20" style="v" sid="ACT 19:20" />وهكذا، أخَذَت رِسالةُ عيسى (سلامُهُ علينا) بالانتِشارِ على نِطاقٍ واسعٍ وأخَذَت تَزدادُ قوّةً.<verse eid="ACT 19:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="ACT 19:21" />ثُمَّ قَرَّرَ بولُسُ، بَعدَ ذلِكَ، أن يَتَوَجَّهَ إلى القُدسِ، مارًّا بمَقدونيا في شِمالِ اليُونانِ ثُمَّ بأَخائيَةِ في جَنوبِها،<note caller="+" style="f"><char style="fr" closed="false">19‏.21 </char><char style="ft" closed="false">عاد بولس لزيارة مجموعات المؤمنين في هذه المناطق حيث نشر رسالة السيد المسيح خلال رحلته الأولى. وأحد أسباب هذه الزيارة كان جمع التبرّعات من المؤمنين في اليونان لمساعدة المؤمنين الفقراء في منطقة يهوذا.</char></note> وكانَ يَقولُ: "بَعدَ ذَهابي إلى القُدسِ، عليَّ زيارةُ روما أيضًا". <verse eid="ACT 19:21" /><verse number="22" style="v" sid="ACT 19:22" />وأرسَلَ اثنينِ مِن مُساعِدِيهِ هُما تيموتاوي وأرَسْتُسُ إلى مَقدونيا. أمّا هو فمَكَثَ فَترةً في جِوارِ مَدينةِ أفاسوسَ.<verse eid="ACT 19:22" /></para>
  <para style="s">الأحداث في أفاسوس</para>
  <para style="p">
    <verse number="23" style="v" sid="ACT 19:23" />في ذلِكَ الوَقتِ أثارَ الوَثَنيّونَ بهذِهِ المَدينةِ فِتنةً كَبيرةً ضِدَّ جَماعةِ عيسى (سلامُهُ علينا)، <verse eid="ACT 19:23" /><verse number="24" style="v" sid="ACT 19:24" />وقد جَرى الأمرُ على هذا النَّحوِ: كانَ هُناكَ صائغٌ اسمُهُ دِيمِتْري، يَقومُ بِتَشكيلِ نَماذِجَ فِضيّةٍ لِمَعبدِ الإلهة أرطامِيسَ في المَدينةِ، وهو عَمَلٌ يَدُرُّ عليهِ وعلى العُمّالِ رِبحًا وَفيرًا، <verse eid="ACT 19:24" /><verse number="25" style="v" sid="ACT 19:25" />فاستَدعى يومًا هؤلاءِ العُمّالَ وآخَرينَ مِن مُساعِديهِم وقالَ لهُم: "أيُّها السّادةُ، أنتُم تَعرِفونَ أنَّنا نَعتَمِدُ على هذهِ الصِّناعةِ كمَوردِ رِزقٍ وَفيرٍ لنا، <verse eid="ACT 19:25" /><verse number="26" style="v" sid="ACT 19:26" />وقد رأيتُم وسَمِعتُم كَيفَ اقتَنَعَ عَدَدٌ كَبيرٌ مِن أهلِ أفاسُوسَ ومَن حَولَها بكَلامِ بولُسَ هذا، وكَيفَ ضَلَّلهُم بقَولِهِ إنّ ما يَصنَعُهُ النّاسُ مِن أصنامٍ لَيسَت بآلهَةٍ على الإطلاقِ! <verse eid="ACT 19:26" /><verse number="27" style="v" sid="ACT 19:27" />فنَحنُ أصحابَ هذِهِ المِهنةِ في خَطَرٍ لأنّها ستَكونُ مَحَلَّ ازدراءِ النّاسِ، والأسوَأُ أنّ مَعبدَ الإلهة العَظيمةِ أرطاميسَ سيَفقِدُ احتِرامَ النّاسِ، وأرطاميسُ هي مَعبودةُ أهالي هذِهِ المِنطقةِ كُلِّها ولها عُبّادُها في جَميعِ أنحاءِ العالَمِ!"<note caller="+" style="f"><char style="fr" closed="false">19‏.27 </char><char style="ft" closed="false">كان تمثال أرطاميس في أفاسوس يُعبَد في ما لا يقلّ عن 33 منطقة من حوض البحر الأبيض المتوسط. وكانت أرطاميس إلهةً مشهورة في القديم.</char></note> <verse eid="ACT 19:27" /><verse number="28" style="v" sid="ACT 19:28" />وعِندَما سَمِعَ العُمّالُ هذا الحَديثَ، انتابَهُم غَضَبٌ شَديدٌ، وأخَذوا يَصرُخونَ قائلينَ: "عاشَت أرطاميسُ إلهةُ أهالي أفاسوسَ!" <verse eid="ACT 19:28" /><verse number="29" style="v" sid="ACT 19:29" />وما أن سَرى الاضطِرابُ في جَميعِ أرجاءِ تِلكَ المَدينةِ، حتّى قَبَضَ بَعضُهُم على رَفيقَيْ بُولسَ في هذِهِ الرِّحلةِ، وهُما غايُسُ وأَرِسْتَرْكي المَقدونيّانِ، مُندَفِعينَ اندِفاعَةَ رَجُلٍ واحِدٍ إلى مُدَرَّجِ المَدينةِ. <verse eid="ACT 19:29" /><verse number="30" style="v" sid="ACT 19:30" />وأرادَ بولُسُ مُواجَهةَ الجَماهيرِ المُحتَشِدَةِ، إلاّ أنّ المُؤمِنينَ مَنَعوهُ، <verse eid="ACT 19:30" /><verse number="31" style="v" sid="ACT 19:31" />وأرسَلَ إليهِ بَعضُ أصدقائِهِ مِن مَسؤولِي تِلكَ الوِلايةِ، يَرجونَهُ عَدَمَ تَعريضِ نَفسِهِ للخَطَرِ بتَوَجُّهِهِ إلى المُدَرَّجِ. <verse eid="ACT 19:31" /><verse number="32" style="v" sid="ACT 19:32" />وسادَتِ الفَوضى الحُشودَ، وأخَذَ الصُّراخُ يَتَعالى، كُلُّ فِئةٍ تَهتِفُ بعِباراتٍ تَختَلِفُ عَنِ الأُخرى، لأنّ أكثَرَهُم كانوا يَجهَلونَ سَبَبَ احتِشادِهِم. <verse eid="ACT 19:32" /><verse number="33" style="v" sid="ACT 19:33" />وكانَ أن دَفَعَ اليَهودُ أحَدَهُم واسمُهُ اسكندَرُ ليَقِفَ في المُقَدِّمةِ ويُوَضِّحَ ما يَحصُلُ للحُشودِ. فأشارَ إسكَندَرُ بيَدِهِ للحُضورِ ليَهدَؤوا، لأنّهُ كانَ يُريدُ أن يُوَضِّحَ لهُم أنّهُ لا صِلةَ لليَهودِ بما يَقولهُ بُولسُ. <verse eid="ACT 19:33" /><verse number="34" style="v" sid="ACT 19:34" />وعِندَما أدرَكَ الحاضِرونَ أنّ إسكَندَرَ يَهوديٌّ، أخَذَ الجَميعُ يَهتِفونَ: "عاشَت أرطاميسُ إلهةُ أفاسوس!"<note caller="+" style="f"><char style="fr" closed="false">19‏.34 </char><char style="ft" closed="false">كان الوثنيّون يعلمون أنّ اليهود لا يؤمنون بآلهتهم، لذلك ربّما شعروا أنّ إسكندر واليهود الآخرين كانوا بطريقةٍ ما متورّطين في الحوادث التي سبّبت الاضطراب في المدينة.</char></note> <verse eid="ACT 19:34" /><verse number="35" style="v" sid="ACT 19:35" />وظَلّوا يُرَدِّدونَ ذلِكَ لِساعَتينِ، إلى أن تَوَصَّلَ رَئيسُ مَجلِسِ المَدينةِ إلى تَهدِئَةِ الحُضورِ قائِلاً: "يا أهلَ أفاسُوسَ! إنّ الجَميعَ على عِلمٍ بأنّ مَدينتَكُم هذِهِ هي الحارِسةُ لمَعبدِ أرطاميسَ الإلهةِ العَظيمةِ وحارِسةُ تِمثالِها الهابِطِ مِنَ السَّماءِ! <verse eid="ACT 19:35" /><verse number="36" style="v" sid="ACT 19:36" />وهذا لا خِلافَ حَولَهُ، فاهدَؤوا وتَعَقَّلُوا ولا تَتهَوَّروا. <verse eid="ACT 19:36" /><verse number="37" style="v" sid="ACT 19:37" />لقد أحضَرتُم هذينِ الرَّجُلَينِ رَغمَ أنّهُما لم يَنتَهِكا حُرمةَ مَعبدِ أرطاميسَ ولم يَكفُرا بها. <verse eid="ACT 19:37" /><verse number="38" style="v" sid="ACT 19:38" />فإن كانَت تُوجَدُ شَكوى مِن قِبَلِ دِيمِتري وأهلِ مِهنتِهِ ضِدَّ أحَدٍ، فهُناكَ المَحاكِمُ والقُضاةُ لهذِهِ المَسألةِ، وما عليهِم سِوى الالتِجاءِ إليهِم، <verse eid="ACT 19:38" /><verse number="39" style="v" sid="ACT 19:39" />وإن كانَ مِن شَكوًى أُخرى، فعَلينا النَّظَرُ فيها مِن خِلالِ اجتِماعِ المَجلِسِ حَسَبَ القانونِ. <verse eid="ACT 19:39" /><verse number="40" style="v" sid="ACT 19:40" />إنّكُم بطَريقَتِكُم هذِهِ الّتي تَلجَؤونَ إليها، تُعَرِّضونَ مَدينتَنا لخَطَرِ اتّهامِ الرُّومانِ لنا بإثارةِ الفِتَنِ، فلَيسَ لنا حُجَّةٌ في تَبريرِ اجتِماعِ هذِهِ الحُشودِ".<note caller="+" style="f"><char style="fr" closed="false">19‏.40 </char><char style="ft" closed="false">أعطت الإمبراطورية الرومانية امتيازاتٍ خاصة لمدينة أفاسوس فأصبحت مدينةً حرّة تملك مجلس شيوخ خاصٍ فيها، ولكنّ الرومان احتفظوا بحقّ إلغاء هذه الامتيازات في حال نشوب أي شغب، كما حصل في مدنٍ أخرى.</char></note> <verse eid="ACT 19:40" /><verse number="41" style="v" sid="ACT 19:41" />وعِندَ انتهائِهِ مِن كَلامِهِ هذا، أخَذَتِ الحُشودُ تَنفَضُّ مِن تَجَمهُرِها شيئًا فشَيئًا.<verse eid="ACT 19:41" /></para>
  <chapter eid="ACT 19" />
  <chapter number="20" style="c" sid="ACT 20" />
  <para style="cl">الفصل العشرون</para>
  <para style="s">في مقدونيا واليونان</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 20:1" />وبَعدَ انتِهاءِ الاضطِراباتِ، أرسَلَ بولُسُ إلى المؤمِنينَ يَشُدُّ أزرَهُم، ويُوَدِّعُهُم مُغادِرًا إلى مِنطقةِ مَقدونيا. <verse eid="ACT 20:1" /><verse number="2" style="v" sid="ACT 20:2" />وأخَذَ يَتَنَقّلُ في جَميعِ أرجائِها مُشَجِّعًا المُؤمِنينَ. حتَّى وَصَلَ أخيرًا إلى اليونان، <verse eid="ACT 20:2" /><verse number="3" style="v" sid="ACT 20:3" />وأقامَ فيها مُدَّةَ ثلاثة أشهُرٍ. وأثناءَ استِعدادِهِ للإبحارِ إلى سُوريا، كانَ اليَهودُ يَتآمرونَ على قَتلِهِ. ووَصَلَ ذلِكَ إلى سَمعِهِ، فعَزَمَ حِينَئذٍ على العَودةِ إلى مَقدونيا، <verse eid="ACT 20:3" /><verse number="4‏-6" style="v" sid="ACT 20:4-6" />آمِرًا بَعضَ مَن كانوا في صُحبَتِهِ بالإبحارِ إلى ميناءِ تَرْواسَ وهُم: سوباتَرُ بنُ بِرُّسَ مِن بيريّة، وأَرِسْتَرْكي وسَكونْدُسُ مِن تَسالونكي، وغايُسُ مِن دَربةِ، وتيموتاوي. وكانَ مَعَهُ مِن مُقاطعةِ آسيا طيخي وطَريفي،<note caller="+" style="f"><char style="fr" closed="false">20‏.4‏-6 </char><char style="ft" closed="false">رافق رجالٌ بولس لحماية المال الذي جمعه المؤمنون غير اليهود من مدن فيليبّي وتسالونكي وكورنتوس لإرساله إلى المؤمنين المعوزين في القدس. وقد أرادوا بهذه الرفقة أيضًا أن يتيقّنوا من وصول المال إلى أصحابه. وكان الهدف من إرسال هذه الهِبة المالية هو إعطاء البرهان على وحدة أتباع سيدنا عيسى اليهود وغير اليهود. </char></note> ولقد ظَلَّ إلى جانبِهِ بَعضُ المُؤمِنينَ الّذينَ رافَقوهُ إلى مَقدونيا بَرًّا، وُصولاً إلى مَدينةِ فيليبّي. وبَعدَ عِيدِ الفَطير،<note caller="+" style="f"><char style="fr" closed="false">20‏.4‏-6 </char><char style="ft" closed="false">تدوم مدّة عيد الفطير أسبوعا من الاحتفالات، التي تُقام في الربيع، بعد عيد الفصح مباشرةً. </char></note> رَكَبوا على مَتنِ سَفينةٍ ولَحِقوا ببَقيَّةِ المُؤمنينَ الّذينَ كانوا قد وَصَلوا قَبلَهُم إلى ميناءِ تَرْواس، حَيثُ مَكَثوا سَبعةَ أيّامٍ.<verse eid="ACT 20:4-6" /></para>
  <para style="s">افتيخي يعود من الموت</para>
  <para style="p">
    <verse number="7" style="v" sid="ACT 20:7" />وفي يومِ الأحَدِ، اجتَمَعَ بولُسُ ومَن مَعَهُ لتَناوُلِ العَشاءِ التِّذكاريّ مُستَحضِرينَ ذِكرى عيسى (سلامُهُ علينا) في ذلِكَ اليومِ. وأخَذَ بولُسُ يُحاوِرُ المُجتَمِعينَ حتّى مُنتَصَفِ اللَّيلِ وما كانَ يَستَطيعُ قَطعَ ذلكَ الحِوار لأنّهُ كانَ يَنوي السَّفَرَ في اليومِ التّالي. <verse eid="ACT 20:7" /><verse number="8" style="v" sid="ACT 20:8" />وكانَ في الطّابقِ العُلويِّ حَيثُ يَجتَمِعُ المُؤمِنونَ قَناديلُ زَيتيّةٌ كَثيرةٌ <verse eid="ACT 20:8" /><verse number="9" style="v" sid="ACT 20:9" />جَعَلَت جَوَّ الغُرفةِ مَليئًا بالدُّخانِ، وكانَ هُناكَ شابٌّ اسمُهُ أَفْتِيخي يَجلِسُ عِندَ النّافِذةِ، وقد غَلَبَهُ النُّعاسُ بَينَما واصَلَ بولسُ حَديثَهُ إلى وَقتٍ مُتَأخِّرٍ. فنامَ أفتيخي نَومًا عَميقًا تَسَبَّبَ في سُقوطِهِ أرضًا مِنَ الطّابقِ الثّالثِ، فماتَ. <verse eid="ACT 20:9" /><verse number="10" style="v" sid="ACT 20:10" />فنَزَلَ بولُسُ في الحينِ إليهِ وانحَنى عليهِ يَحتَضِنُهُ قائلاً لِمَن حَولَهُ: "لا تَقلَقوا، إنّ الشّابَّ حيٌّ!" <verse eid="ACT 20:10" /><verse number="11" style="v" sid="ACT 20:11" />ثُمَّ صَعِدوا إلى الغُرفةِ وتَناوَلوا العَشاءَ التّذكاريّ استِحضَارًا لذِكرى سَيِّدِنا عيسى (سلامُهُ علينا). وعادَ بولُسُ، بَعدَ ذلكَ، يُتابِعُ كَلامَهُ مَعَ المُؤمِنينَ إلى طُلوعِ الفَجرِ ثُمَّ غادَرَهم. <verse eid="ACT 20:11" /><verse number="12" style="v" sid="ACT 20:12" />أمّا بالنِّسبةِ إلى أَفتيخي، فقَد صَحَبوهُ إلى بَيتِهِ حيًّا، بَعدَ أن هَدأت نُفوسُهُم واطمأنَت بأنّ الشّابَّ قد عادَت إليهِ الحَياةُ.<verse eid="ACT 20:12" /></para>
  <para style="s">وداع بولس لقادة المؤمنين في أفاسوس</para>
  <para style="p">
    <verse number="13" style="v" sid="ACT 20:13" />وقَرَّرَ بولُسُ الوصولَ إلى ميناءِ أسّوسَ سَيرًا على الأقدامِ،<note caller="+" style="f"><char style="fr" closed="false">20‏.13 </char><char style="ft" closed="false">كانت المسافات الصغيرة تُقطع برًّا وليس بحرًا إذ لم تكن تتطلّب وقتا طويلا مشيا على الأقدام، خاصةً أنّ السفن كانت تنتظر العابرين في المرافئ. كما كانت السفرات بحرًا مُكْلِفة أكثر من المَشْي على الأقدام.</char></note> وطَلَبَ مِن رِفاقِهِ الإبحارَ إلى هُناكَ لمُلاقاتِهِ، لِيُتابِعوا الرِّحلةَ مَعًا صَوبَ القُدسِ. فصَعِدوا على مَتنِ السَّفينةِ وفَعَلوا كَما طَلَبَ مِنهُم. <verse eid="ACT 20:13" /><verse number="14" style="v" sid="ACT 20:14" />وعِندَ وصولِ بُولسَ إلى أسّوسَ انضَمَّ إلى رِفاقِهِ ليُبحِروا مَعًا إلى ميناءِ مِتْلِينَ. <verse eid="ACT 20:14" /><verse number="15" style="v" sid="ACT 20:15" />ثُمَّ انطَلَقوا في اليومِ المَوالي مُتَجاوِزينَ جَزيرةَ خِيُوسَ، ووَصَلوا في اليومِ الثّالثِ جَزيرةَ ساموسَ، ثُمّ أخيرًا في اليومِ الرّابعِ وَضَعوا مَراسيَهُم في ميناءِ مِيليتُسَ. <verse eid="ACT 20:15" /><verse number="16" style="v" sid="ACT 20:16" />وكانَ بولُسُ قد قَرَّرَ تَجاوُزَ مَدينةِ أفاسوسَ لأنّهُ لم تَكُن لَدَيهِ الرَّغبةُ في قَضاءِ المَزيدِ مِنَ الوَقتِ في تِلكَ المِنطقةِ، إذ كانَ يُريدُ أن يَصِلَ إلى القُدسِ قَبلَ حُلولِ عِيدِ الخَمسينَ إن تَمَكَّنَ مِن ذلك.<note caller="+" style="f"><char style="fr" closed="false">20‏.16 </char><char style="ft" closed="false">كان بولس مستعجلا للوصول إلى القدس قبل حلول العيد، إذ يتجمّع هناك عدد كبير من الحجاج، وتقدَّم الهبات الكبيرة للفقراء من اليهود وهو ما يحدث فيهم تأثيرا فائقا، مبرهنا على وحدة المؤمنين بالسيد المسيح، يهودا وغير يهود. </char></note><verse eid="ACT 20:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="ACT 20:17" />وبَعدَ النُّزولِ في مِيليتُسَ، استَدعى بولُسُ شُيوخَ المُؤمِنينَ في أفاسوسَ، <verse eid="ACT 20:17" /><verse number="18" style="v" sid="ACT 20:18" />وخَاطبَهُم قائِلاً: "يا إخواني، أنتُم تَعلَمونَ، مُنذُ قُدومي، طَريقةَ تَعامُلي مَعَكُم طَوالَ الفَترةِ الّتي أمضَيتُها بَينَكُم في هذِهِ المِنطقةِ، <verse eid="ACT 20:18" /><verse number="19" style="v" sid="ACT 20:19" />فقد كُنتُ أخدِمُ سَيِّدَنا عيسى (سلامُهُ علينا) بكُلِّ تَواضُعٍ وبِدُموعٍ كَثيرةٍ، رَغمَ كُلِّ ما أصابَني مِن مِحَنٍ مَصدَرُها مَكائِدُ اليَهودِ. <verse eid="ACT 20:19" /><verse number="20" style="v" sid="ACT 20:20" />وتَعلَمونَ أنّي لم أمنَع عنكُم ما فيهِ نَفعُكُم، إذ أنّني كُنتُ أجلِسُ مَعَكُم ناصِحًا مُعَلِّمًا، مُنتَقِلاً في ذلك مِن دارٍ إلى دارٍ، <verse eid="ACT 20:20" /><verse number="21" style="v" sid="ACT 20:21" />أُناشِدُ الجَميعَ، اليَهودَ وغَيرَ اليَهودِ، أن يَعودوا إلى اللهِ تائِبينَ وإلى الإيمانِ بسَيِّدِنا عيسى (سلامُهُ علينا) مُنيبينَ. <verse eid="ACT 20:21" /><verse number="22" style="v" sid="ACT 20:22" />وأمّا الآنَ فإنّني أتَوَجَّهُ إلى القُدسِ بوَحيٍ مِن رُوحِ اللهِ، ولا أعلمُ ما سألاقيهِ هُناكَ، <verse eid="ACT 20:22" /><verse number="23" style="v" sid="ACT 20:23" />إلاّ أنّ تَحذيرًا مِن رُوحِ اللهِ يأتيني في كُلِّ مَدينةٍ مَرَرتُ بها في طَرِيقي بأنّ المَصاعِبَ والسِّجنَ في انتِظاري. <verse eid="ACT 20:23" /><verse number="24" style="v" sid="ACT 20:24" />وأُعلِنُ أنّ حَياتي لا تُساوي شَيئًا أمام إتمامِ العَمَلِ المُلقى على عاتقي والدَّعوةِ الّتي كَلّفَني بها مَولاي عيسى (سلامُهُ علينا)، وهي أن أزُفَّ لهُمُ البُشرى بفَضلِ اللهِ عليهِم ولُطفِهِ.<verse eid="ACT 20:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="ACT 20:25" />لقد أعلَمتُكُم جَميعًا بقيامِ مَملكةِ اللهِ المَوعودةِ، وأنا على يَقينٍ أنَّكُم لن تَرَوني بَعدَ اليَومِ، <verse eid="ACT 20:25" /><verse number="26" style="v" sid="ACT 20:26" />لِهذا أُخبِرُكم أيُّها الإخوةُ أنّهُ إن ضَلَّ أحَدُكُم فما أنا بِمَسؤولٍ عن ذلك، <verse eid="ACT 20:26" /><verse number="27" style="v" sid="ACT 20:27" />لأنَّني لم أُقَصِّرْ في إبلاغِكُم كُلَّ ما يَجِبُ عليكُم فِعلُهُ لمَرضاةِ اللهِ. <verse eid="ACT 20:27" /><verse number="28" style="v" sid="ACT 20:28" />فحافِظوا على أنفُسِكُم وعلى الرَّعية الّتي استأمَنَكُم اللهُ عليها بِروحِهِ تَقَدَّسَ وتَعالى، وقوموا برِعايةِ جَماعاتِ المُؤمِنينَ باللهِ الّتي جَعَلَ اللهُ فِداءَها دَمَ حَبيبِهِ عيسَى (سلامُهُ علينا)، <verse eid="ACT 20:28" /><verse number="29" style="v" sid="ACT 20:29" />واعلَموا أنّهُ سيَهجُمُ عليكُم بَعدَ رَحيلي دَجّالونَ كَالذِّئابِ المُفتَرِسةِ لاَ يُشفِقونَ على الرَّعية، <verse eid="ACT 20:29" /><verse number="30" style="v" sid="ACT 20:30" />وسيَلجَأُ بَعضُكُم إلى الكَذِبِ والغِشِّ وتَشويهِ الحقِّ ليَجعَلَ المُؤمِنينَ يَمضونَ في إثرِهِ. <verse eid="ACT 20:30" /><verse number="31" style="v" sid="ACT 20:31" />فحَذارِ مِن ذلِكَ، وتَذَكّروا أنّي لم أتَوَقّف على مَدى ثَلاثِ سنَواتٍ عَن رِعايَتِكم جَميعًا، بالنَّصيحةِ والدُّموعِ لَيلاً نَهارًا".<verse eid="ACT 20:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="ACT 20:32" />"والآن ها أنا أُفارِقُكم وأترُكُكم برِعايةِ اللهِ وبِحِمايةِ الرِّسالةِ بفَضلِهِ تَعالى، فإن عَمِلتُم بهذِهِ الرِّسالةِ فسَتَثبُتونَ على إيمانِكُم وتَحصُلونَ على نَصيبِكُم باعتِبارِكُم مِن عِبادِ اللهِ الصّالحينَ. <verse eid="ACT 20:32" /><verse number="33" style="v" sid="ACT 20:33" />واعلَموا أنّهُ لم يَكُن لَدَيَّ أدنى رَغبةٍ في فِضَّتِكم أو ذَهَبِكُم أو ثيابِ أحَدِكُم، <verse eid="ACT 20:33" /><verse number="34" style="v" sid="ACT 20:34" />فقدِ اعتَمَدتُ على كَدِّ يَدَيَّ لأُحَصِّلَ مَعاشي ومَعاشَ مَن مَعي مِن رِفاقي، <verse eid="ACT 20:34" /><verse number="35" style="v" sid="ACT 20:35" />ولقد بَيّنَتُ لكُم كَيفَ نُوَجِّهُ جُهودَنا لمُساعدةِ المُحتاجينَ. وتَذَكّرُوا يا أحبابي كَلِماتِ سَيِّدِنا عيسى، إذ قالَ: "السَّعادةُ في العَطاءِ أعظَمُ مِنها في الأخْذِ".<note caller="+" style="f"><char style="fr" closed="false">20‏.35 </char><char style="ft" closed="false">كان مجتمع الطبقة الراقية، والفلاسفة يحتقرون العمل اليدوي، وكان معظم الفلاسفة يحاولون الحصول على المال من الأغنياء أو يمارسون التعليم أو يسْتجْدون. وقد كان بولس ومساعدوه يمنحون المال للفقراء ليبيّنوا أنّ دعوتهم صادقة. </char></note><verse eid="ACT 20:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="ACT 20:36" />وعِندَما أنهى بولُسُ كَلامَهُ، رَكَعَ الجَميعُ للهِ وتَضَرَّعوا مِن أجلِ بولُسَ، <verse eid="ACT 20:36" /><verse number="37" style="v" sid="ACT 20:37" />ثُمّ أجهَشَ الجَميعُ بالبُكاءِ وبَدَؤوا يُعانِقونَهُ ويُقَبِّلونَهُ، <verse eid="ACT 20:37" /><verse number="38" style="v" sid="ACT 20:38" />وقد تَمَلّكَهُم شُعورٌ بالحُزنِ، لأنّهُم لن يَرَوا مُحيّاهُ ثانيةً، ثُمَّ أوصَلوهُ إلى السَّفينةِ ووَدَّعوهُ.<verse eid="ACT 20:38" /></para>
  <chapter eid="ACT 20" />
  <chapter number="21" style="c" sid="ACT 21" />
  <para style="cl">الفصل الحادي والعشرون</para>
  <para style="s">إلى القدس</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 21:1" />بَعدَ أن تَرَكَ بولُسُ ورِفاقُهُ قادةَ المُؤمنينَ في مَدينةِ أفاسوسَ، يَمَّموا بِسَفينتِهِم شَطرَ جَزيرةِ قُوشَ حَيثُ قاموا في اليَومِ التّالي مِن وُصولِهِم بالتَّوَجُّهِ إلى جَزيرةِ رُودُسَ ومِنها إلى ميناءِ باتَرا، <verse eid="ACT 21:1" /><verse number="2" style="v" sid="ACT 21:2" />وهُناكَ وَجَدوا سَفينةً مُتَوَجِّهةً إلى بِلادِ فينيقِية فصَعِدوا إليها. <verse eid="ACT 21:2" /><verse number="3" style="v" sid="ACT 21:3" />وخِلالَ إبحارِهِم بَدَت لهُم جَزيرةُ قُبرُصَ عَن شِمالِهِم، ثُمَّ تابَعوا سَفَرَهُم مُتَّجِهينَ إلى سُوريا حَيثُ رَسَتِ السَّفينةُ في مِيناءِ صُورَ وأفرَغَت حُمولتَها هُناكَ، <verse eid="ACT 21:3" /><verse number="4" style="v" sid="ACT 21:4" />فنَزَلَ بولُسُ وأصحابُهُ فوَجَدوا في هذِهِ المَدينةِ جَماعةً مِن أتباعِ عيسى (سلامُهُ علينا). فأقاموا عِندَهُم سَبعةَ أيّامٍ كانوا أثناءَها يَطلُبونَ مِن بولُسَ ألاّ يَتَوَجَّهَ إلى القُدسِ لأنّهُم عَلِموا بوَحيٍ مِن روحِ اللهِ أنّهُ سيُلاقي الأذى هُناكَ. <verse eid="ACT 21:4" /><verse number="5" style="v" sid="ACT 21:5" />وبَعدَ انتِهاءِ الزِّيارةِ، غادَروا المكَانَ وتابَعوا إبحارَهُم وقد كانَ في وَداعِهم أتباعُ المَسيحِ (سلامُهُ علينا) جَميعًا معَ عائلاتِهِم. وعندَ وُصولِهِم إلى الشّاطئ رَكَعوا جَميعًا للصَّلاةِ، <verse eid="ACT 21:5" /><verse number="6" style="v" sid="ACT 21:6" />ثُمَّ وَدَّعَ بَعضُهُم بَعضًا وتَوَجَّهَ كُلُّ واحِدٍ إلى وِجهتِهِ. وصَعِدَ بولُسُ ورِفاقُهُ على مَتنِ السَّفينةِ <verse eid="ACT 21:6" /><verse number="7" style="v" sid="ACT 21:7" />وتابَعوا طَريقَ سَفَرِهِم صَوبَ عَكّا،<note caller="+" style="f"><char style="fr" closed="false">21‏.7 </char><char style="ft" closed="false">كانت مدينة عكّا معروفة أيضًا باسم بتولمايس.</char></note> وعِندَ وُصولِهِم نَزَلوا فيها لمُلاقاةِ جَماعةِ المُؤمنينَ هُناكَ وإلقاءِ السَّلامِ عليهِم والإقامةِ عِندَهُم مُدّةَ يومٍ. <verse eid="ACT 21:7" /><verse number="8" style="v" sid="ACT 21:8" />وفي اليَومِ التّالي واصَلوا مُهِمّتَهُم وُصولاً إلى مَدينةِ قَيصريّة الّتي نَزَلوا فيها وأقاموا عِندَ الدّاعِيةِ فيليبَ، أحَدِ الرِّجالِ السَّبعةِ الّذينَ اختارَهُم الحَواريّونَ لتَوزِيعِ المُؤَنِ على الأرامِلِ. <verse eid="ACT 21:8" /><verse number="9" style="v" sid="ACT 21:9" />وكانَ لِفيليبَ أربَعةُ بَناتٍ عازِباتٍ يَتَمَتّعنَ بكَراماتِ النُّبوءة. <verse eid="ACT 21:9" /><verse number="10" style="v" sid="ACT 21:10" />وبَعدَ مُضِيِّ عِدَّةِ أيّامٍ في ضِيافةِ فيليبَ، قَدِمَ مِن مِنطقةِ يَهوذا رَجُلٌ لهُ كَرامةُ النُّبوءَةِ اسمُهُ أَغابوسُ، <verse eid="ACT 21:10" /><verse number="11" style="v" sid="ACT 21:11" />تَوَجَّهَ إلى بولُسَ ورِفاقِهِ، وأخَذَ حِزامَ بولُسَ، ثُمَّ قَيّدَ يَديهِ وقَدَمَيهِ بنَفسِهِ وقالَ: "نَزَلَ وَحيٌ مِن رُوحِ اللهِ أنّ اليَهودَ سيَقومونَ بتَقييدِ صاحِبِ هذا الحِزامِ في القُدسِ كَما فَعَلتُ، ثُمَّ يُسَلِّمونَهُ إلى الأجانِبِ". <verse eid="ACT 21:11" /><verse number="12" style="v" sid="ACT 21:12" />وعِندَما سَمِعَ أصحابُ بولُسَ ومَنِ استَضافوهُم مِنَ المُؤمِنينَ هذا الكَلامَ، تَوَجَّهوا إليهِ مُتَوَّسلينَ ألاّ يَذهَبَ إلى القُدسِ. <verse eid="ACT 21:12" /><verse number="13" style="v" sid="ACT 21:13" />فأجابَهُم قائلاً: "لِمَ تُثيرونَ أشجاني ببُكائِكُم؟ إنّي على استِعدادٍ لا للقَيدِ فقط، بل للمَوتِ أيضًا في القُدسِ في سَبيلِ مَولاي عيسى (سلامُهُ علينا)". <verse eid="ACT 21:13" /><verse number="14" style="v" sid="ACT 21:14" />وعِندَ إحساسِهِم بالعَجزِ عن إقناعِهِ، قالوا: "إن كانَ هذا ما يُريدُهُ سَيِّدُنا عيسى، فلتُنَفَّذْ إرادَتُهُ!" <verse eid="ACT 21:14" /><verse number="15" style="v" sid="ACT 21:15" />وحَزَمَ بولُسُ وأصحابُهُ أمرَهُم استِعدادًا لمُتابَعةِ رِحلتِهِم إلى القُدسِ، <verse eid="ACT 21:15" /><verse number="16" style="v" sid="ACT 21:16" />وانضَمَّ إليهِم جَماعةٌ مِنَ المُؤمنينَ مِن قَيصريّة وتَوَجّهوا جَميعًا إلى دارِ مَناسونَ، وهو رَجُلٌ يَهوديٌّ قُبرُصِيُّ المَولِدِ، وأحَدُ المُؤمِنينَ الأوائِلِ بالسّيِّدِ المَسيحِ، ليُقيموا عِندَهُ.<verse eid="ACT 21:16" /></para>
  <para style="s">في القدس</para>
  <para style="p">
    <verse number="17" style="v" sid="ACT 21:17" />وفي اليومِ التّالي، عِندَ وُصولِ بولُسَ ورِفاقِهِ إلى القُدسِ، كانَ في استِقبالِهم هُناكَ إخوانُهُم في الإيمانِ الّذينَ رَحَّبوا بِهِم بِحَرارةٍ. <verse eid="ACT 21:17" /><verse number="18" style="v" sid="ACT 21:18" />وفي الغَدِ، تَوَجَّهوا لزِيارةِ يَعقوبَ،<note caller="+" style="f"><char style="fr" closed="false">21‏.18 </char><char style="ft" closed="false">كان يعقوب أخا سيدنا عيسى أحد قادة المؤمنين في القدس. ويبدو أن بطرس وغيره من الحواريين الاثني عشر الباقين كانوا قد تركوا القدس في هذه الفترة، حين قدّم بولس ورفاقه هبات المؤمنين غير اليهود للمؤمنين اليهود الفقراء في القدس، حسب ما جاء في سيرة الحواريين 24: 17.</char></note> وكانَ قادةُ المُؤمنينَ مُجتَمِعينَ عِندَهُ. <verse eid="ACT 21:18" /><verse number="19" style="v" sid="ACT 21:19" />فسَلَّمَ بولسُ عليهِم وأخبَرَهُم بتَفاصيلِ ما قامَ بِهِ مِن أعمالٍ بفَضلِ اللهِ أثناءَ نَشرِ دَعوَتِهِ بَينَ سائرِ الشُّعوبِ. <verse eid="ACT 21:19" /><verse number="20" style="v" sid="ACT 21:20" />وعِندَما سَمِعوا بذلِكَ، كَبَّروا اللهَ مُسَبّحِينَ، ثُمَّ قالوا لهُ: "أيُّها الأخُ، أنتَ تَعلَمُ أنّ مِنَ بَينَ اليَهودِ مَن آمَنَ بسَيِّدِنا عيسى (سلامُهُ علينا). وقد بَلَغَ عَدَدُهُم الآلافَ، ولكنّهُم مُتَعَصِّبونَ للتَّوراةِ، <verse eid="ACT 21:20" /><verse number="21" style="v" sid="ACT 21:21" />وقد وَصَلَ إلى أسماعِهِم أنّكَ طَلَبتَ مِنَ اليَهودِ الماكِثينَ بينَ الوَثنيِّينَ خارجَ فِلَسطين مُخالفةَ تَعاليمِ تَوراةِ سَيِّدِنا موسى، وخُصوصًا عَدَمَ خِتانِ أولادِهِم واتّباعِ عاداتِ شَعبِنا. <verse eid="ACT 21:21" /><verse number="22" style="v" sid="ACT 21:22" />ولا شَكَّ بأنّهُم سيَسمَعونَ بخَبَرِ قُدومِكَ إلى هُنا، فماذا نَحنُ فاعِلونَ!<note caller="+" style="f"><char style="fr" closed="false">21‏.22 </char><char style="ft" closed="false">قَبِل المؤمنون اليهود وقادتهم عمل بولس بين غير اليهود، ولكنّهم واجهوا مشكلةً. ففي ذلك الوقت، كان الشعور القومي اليهودي ينمو وكانت مقاومة المتشددين اليهود الشديدة للاختلاط بالأجانب تزداد. ولذلك احتاج بولس أن يبرهن على التزامه بميراثه اليهودي وبالتقاليد.</char></note> <verse eid="ACT 21:22" /><verse number="23" style="v" sid="ACT 21:23" />إنّنا نَنصَحُكَ بما يلي: بَينَنا أربَعةُ رِجالٍ عليهِم نُذُرٌ يؤدُّونَها، <verse eid="ACT 21:23" /><verse number="24" style="v" sid="ACT 21:24" />فاذهَبْ إليهِم وتَطَهَّرْ واستَعِدَّ لتُشارِكَهُم في الشَّعائرِ الّتي تَنتَهي بحَلقِ رُؤوسِهِم وتَقديمِ ذَبائحِهِم فتَتِمَّ بذلكَ نُذُرُهُم، ثُمّ قَدِّم إليهِم تَكاليفَ الذَّبائحِ، وسيَعلَمُ الجَميعُ عِندئِذٍ أنّ ما وَصَلَ إلى سَمعِهِم مِن أخبارٍ غَيرُ صَحيحٍ، لأنّكَ تَعمَلُ بما جاءَ في التَّوراةِ. <verse eid="ACT 21:24" /><verse number="25" style="v" sid="ACT 21:25" />أمّا عن غَيرِ اليَهودِ مِنَ المُؤمِنينَ، فقد أرسَلنا إليهِم بفَتوى تُحَرِّمُ عليهِم أكلَ لُحُومِ القَرابينِ المُقَدَّمةِ للأوثانِ، والدِّماءَ، ولُحُومَ الحَيواناتِ المُنخَنِقةِ، وزَواجَ المَحارِم". <verse eid="ACT 21:25" /><verse number="26" style="v" sid="ACT 21:26" />فاستجَابَ بولُسُ لنَصيحةِ إخوانِهِ، وتَطَهَّرَ كَما فَعَلَ الرِّجالُ الأربَعةُ، ثُمَّ تَوَجَّهَ إلى الحَرَمِ الشَّريفِ، مُعلِنًا رَسمِيًا في سِجِلاَّتِ الحَرَمِ تاريخَ انتِهاءِ أداءِ الرِّجالِ للشّعائرِ الخاصّةِ بنُذورِهم، وزَمَنَ تَقديمِ القَرابينِ عن كُلٍّ مِنهُم.<note caller="+" style="f"><char style="fr" closed="false">21‏.26 </char><char style="ft" closed="false">اقترح شيوخ جماعة المؤمنين في القدس أن يشترك بولس في النذور مع هؤلاء الرجال لأجل حمايته من تُهَمِ التخلّي عن اليهود وتقاليدهم. وعند انتهاء نذورهم، كان باستطاعته دفع ثمن الذبائح المفروضة في التوراة. وللانضمام إلى أصحاب النذور، كان على بولس أن يتطهّر أيضًا لأنه عاد من أراضٍ غريبة وهكذا اعتبروه غير طاهر وغير مؤهَّل للاشتراك في هذه المناسبة. واعتبر كل شخص يدفع ثمن الذبائح المطلوبة نيابةً عن شخص آخر عند انتهاء النذور عملاً صالحًا. </char></note><verse eid="ACT 21:26" /></para>
  <para style="s">القبض على بولس</para>
  <para style="p">
    <verse number="27" style="v" sid="ACT 21:27" />وعِندَما أوشَكَت شَعائرُ تَطهيرِ بولُسَ على الانقِضاءِ، شاهَدَ بَعضُ اليَهودِ مِن مُقاطعةِ آسيا بولُسَ وهو في حَرَمِ بيتِ اللهِ، فقاموا بإثارةِ النّاسِ هُناكَ ضِدَّهُ، فأمسَكوا بِهِ <verse eid="ACT 21:27" /><verse number="28" style="v" sid="ACT 21:28" />صارِخينَ: "إلينا يا بَني يَعقوبَ! هوذا الرَّجُلُ الّذي يَقومُ بتَعليمِ النّاسِ في كُلِّ مَكانٍ أُمورًا ضِدَّ شَعبِنا وضِدَّ تَوراتِنا وضِدَّ هذا المَكانِ المُقَدَّس! والأسوأ أنّهُ سَمَحَ للأغرابِ بدُخولِ حَرَمِ بَيتِ الله، مُنَجِّسًا قُدسيّةَ هذا المَكانِ!" <verse eid="ACT 21:28" /><verse number="29" style="v" sid="ACT 21:29" />ولقد ذَكَروا ذلِكَ لأنّهُم شاهَدوهُ في أنحاءِ المَدينةِ رِفقةَ رَجُلٍ غَيرِ يَهوديّ مِن أفاسوسَ يُدعى طَريفي، فظَنّوا أنّ بولُسَ سَمَحَ لهُ بالدُّخولِ إلى الأماكنِ المُحَرَّمةِ على الأجانبِ في الحَرَمِ الشَّريفِ.<note caller="+" style="f"><char style="fr" closed="false">21‏.29 </char><char style="ft" closed="false">كان يهود مقاطعة آسيا ومدينة أفاسوس تحديدًا يعرفون بولس ونشاطاته. وتهمتهم له كانت باطلة، لكنّها استندت على علاقة بولس بالمؤمنين غير اليهود. </char></note> <verse eid="ACT 21:29" /><verse number="30" style="v" sid="ACT 21:30" />وهاجَتِ المَدينةُ، وأخَذَ النّاسُ يَندَفِعونَ مِن كُلِّ الأنحاءِ إلى مَكانِ وُجودِ بولُسَ، وعِندَما أمسَكوا بِهِ، أخَذوا يَجُرّونَهُ إلى خارجِ الحَرَمِ الشَّريفِ، وأُغلِقَتِ الأبوابُ في الحالِ. <verse eid="ACT 21:30" /><verse number="31" style="v" sid="ACT 21:31" />وبَينَما كانوا يُحاولونَ قَتلَهُ، عَلِمَ قائدُ الكَتيبةِ الرُّومانيّة بحالةِ الهيَجانِ الّتي تَجتاحُ القُدسِ، <verse eid="ACT 21:31" /><verse number="32" style="v" sid="ACT 21:32" />فأسَرَعَ مَعَ عَدَدٍ مِنَ الضُّبّاطِ والجُنودِ إلى حَيثُ الحُشودُ.<note caller="+" style="f"><char style="fr" closed="false">21‏.32 </char><char style="ft" closed="false">كانت قلعة أنطونيا تطلّ من الجهة الشمالية الغربية على باحات الحرم الشريف وتحوي كتيبة رومانية مؤلّفة من 600 رجل. وبسبب ارتفاع قلعتهم، كان الجنود قادرين على الإشراف على ساحات الحرم في حال اندلاع شغب، وكانوا سريعي التدخّل من خلال مدارج تربط القلعة بباحة الحرم.</char></note> وعِندَما رأتِ هذِهِ الحُشودُ قُدومَ القائدِ مَعَ جُنودِهِ، تَوَقّفوا عن ضَربِ بولُسَ. <verse eid="ACT 21:32" /><verse number="33" style="v" sid="ACT 21:33" />فأقبَلَ القائدُ وقَبَضَ عليهِ وأمَرَ بتَقييدِهِ بسِلسِلَتين. وبادَرَ بالسُّؤالِ: "مَن هذا الرَّجُلُ وما الأفعالُ الشّائنةُ الّتي ارتَكَبَها؟" <verse eid="ACT 21:33" /><verse number="34" style="v" sid="ACT 21:34" />فأخَذَت جَماعاتٌ مِنَ الحُضُورِ تَصرُخُ هائجةً، كُلٌّ يَصرُخُ بعِباراتٍ تَختَلِفُ عن الأُخرى، مِمّا مَنَعَ القائدَ مِن مَعرفةِ حَقيقةِ الأمرِ. فأصدَرَ أمرَهُ بأخذِ بولُسَ إلى القَلعةِ. <verse eid="ACT 21:34" /><verse number="35" style="v" sid="ACT 21:35" />وعِندَ وُصولِهِ السُلّمَ الواصِلَ بَينَ الحَرَمِ والقَلعةِ، اضطَرَّ الجُنودُ لحَملِهِ حتّى لا يَفتِكَ بِهِ الجُمهورُ <verse eid="ACT 21:35" /><verse number="36" style="v" sid="ACT 21:36" />الّذي تَبِعَهُ صارِخًا: "هيّا لنَقتُلْهُ! اُقتلوهُ، اُقتلوهُ!" <verse eid="ACT 21:36" /><verse number="37" style="v" sid="ACT 21:37" />وأثناءَ إدخالِ الجُنودِ بولُسَ إلى القَلعةِ التَفَتَ إلى القائِدِ قائلاً: "هل تَسمَحُ بأن أطلُبَ مِنكَ شَيئًا؟" فأجابَهُ القائِدُ: "أتَتَكَلّمُ اليُونانيّة؟<note caller="+" style="f"><char style="fr" closed="false">21‏.37 </char><char style="ft" closed="false">كان الرومان يستخدمون اللغة اليونانية للأعمال الإدارية والتجارية. وكان معظم سكان منطقة القدس لا يعرفون إلاّ القليل من اللغة اليونانية، ولكنّ بولس كان يجيدها.</char></note> <verse eid="ACT 21:37" /><verse number="38" style="v" sid="ACT 21:38" />ألَستَ أنتَ ذاكَ المِصريَّ الّذي تَسَبّبَ في إثارةِ الفِتنةِ وقامَ باقتِيادِ أربَعةِ آلافٍ مِنَ القَتَلَة المُتَطَرِّفينَ إلى الصَّحراءِ مُنذُ فَترةٍ؟"<note caller="+" style="f"><char style="fr" closed="false">21‏.38 </char><char style="ft" closed="false">كتب المؤرخ الروماني يوسيفوس عن مدّعي النبوّة هذا والذي أتى من مصر وجمع حوله أتباعا للإطاحة بالحكم الروماني. وقد هزمه الحاكم فيلكس على رأس الجيش الروماني، ولكنّه فرّ هاربًا. وفي ذلك الوقت، ظهر الكثير من الأصوليّين اليهود الذين استخدموا عمليات القتل لترهيب عملاء الرومان من الشعب اليهودي.</char></note> <verse eid="ACT 21:38" /><verse number="39" style="v" sid="ACT 21:39" />فقالَ بولُسُ: "إنّما أنا يَهوديٌّ مِن مَدينةِ طَرسُوسَ، المَدينةِ المَشهورةِ في كِيليكيّة. اسمَحْ لي مِن فَضلِكَ بمُخاطَبةِ الحُشودِ". <verse eid="ACT 21:39" /><verse number="40" style="v" sid="ACT 21:40" />فأذِنَ لهُ القائدُ بذلِكَ. فوَقَفَ بولُسُ على السُّلّمِ مُشيرًا إلى النّاسِ بالإنصاتِ. وعِندَما سادَ الصَّمتُ، أخَذَ يُخاطِبُهُم باللُّغة العِبريّةِ.<note caller="+" style="f"><char style="fr" closed="false">21‏.40 </char><char style="ft" closed="false">من الممكن أنّ القائد الروماني سمح لبولس بمخاطبة الجمع، ظنًّا منه أنّ الناس اعتبروه عن خطإ قائدَ مجموعة اليهود الأصوليّين التي ذكرها، وأنّ بولس سيوضّح لهم الأمر. </char></note><verse eid="ACT 21:40" /></para>
  <chapter eid="ACT 21" />
  <chapter number="22" style="c" sid="ACT 22" />
  <para style="cl">الفصل الثّاني والعشرون</para>
  <para style="s">خطاب بولس للجمهور</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 22:1" />قالَ بولُسُ: "يا إخواني مِن بَني يَعقوبَ، اصغوا إليّ". <verse eid="ACT 22:1" /><verse number="2" style="v" sid="ACT 22:2" />وعِندَما تَنَبَّهوا إلى أنّهُ يُخاطِبُهُم بالعِبريّةِ سادَ الجَمعَ مَزيدٌ مِنَ الهُدوءِ.<note caller="+" style="f"><char style="fr" closed="false">22‏.2 </char><char style="ft" closed="false">ظنّ بعض من هذه الجموع أنّ بولس يهودي من خارج فلسطين يعطف على غير اليهود، وكانوا يخافون من هؤلاء ويحتقرونهم. ولكن عندما سمعوه يتكلّم لغتهم العبرية بطلاقة، توقّفوا عن الكلام وانتبهوا إليه.</char></note> <verse eid="ACT 22:2" /><verse number="3" style="v" sid="ACT 22:3" />فتابَعَ بولُسُ قائلاً: "إنّني يَهوديٌّ، وطَرسُوسُ الّتي في مُقاطعةِ كِيليكيّة هي مَسقطُ رأسي، إلاّ أنّ نَشأتي كانَت في رُبوعِ هذِهِ المَدينةِ، وكانَ مُعَلِّمي هو الشَّيخُ غَمْلائِيل، ودَرجَتُ على عاداتِ آبائِنا الأكثرِ تَشَدُّدًا وعلى مُعتَقداتِهِم، وكُنتُ شَديدَ الحَماسةِ للهِ كَما أنتُم اليَومَ، <verse eid="ACT 22:3" /><verse number="4" style="v" sid="ACT 22:4" />مِمّا جَعَلَني أضطَهِدُ أتباعَ عيسى النّاصِريّ إلى دَرجةِ المَوتِ، فكُنتُ أقبِضُ عليهِم رِجالاً ونِساءً وأُلقي بِهِم في السُّجونِ، <verse eid="ACT 22:4" /><verse number="5" style="v" sid="ACT 22:5" />والشّاهِدُ على صِحّةِ أقوالي هذِهِ رَئيسُ الأحبارِ وجَميعُ أعضاءِ المَجلِسِ، فقد حَرَّضتُهُم على أن يَكتُبوا رَسائلَ مُوَجَّهةً إلى قادةِ اليَهودِ في دِمَشقَ يأذنونَ لي فيها، عِندَ ذَهابي إلى هُناكَ، بالقَبضِ على هؤلاءِ النّاسِ وإحضارِهِم إلى القُدسِ ليَلقَوا عِقابَهُم.<verse eid="ACT 22:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="ACT 22:6" />وفي ظَهيرةِ ذلِكَ اليومِ، عِندَما كُنتُ في طَريقي إلى دِمَشقَ وقد اقتَرَبتُ مِنها، سَطَعَ حَولي فَجأةً نورٌ باهِرٌ مِنَ السَّماءِ، <verse eid="ACT 22:6" /><verse number="7" style="v" sid="ACT 22:7" />جَعَلَني أسقُطُ أرضًا، وسَمِعتُ صَوتًا يُخاطِبُني قائلاً: شاولُ! يا شاولُ! لِمَ تَضطَهِدُني؟" <verse eid="ACT 22:7" /><verse number="8" style="v" sid="ACT 22:8" />فأجَبتُ: "مَن أنتَ يا سَيِّدي؟" فقالَ الصَّوتُ:" أنا عيسى النّاصريّ، أنا مَن تَضطَهِدُهُ باضطِهادِكَ لأتباعي!" <verse eid="ACT 22:8" /><verse number="9‏-10" style="v" sid="ACT 22:9-10" />فقُلتُ: "وماذا أعمَلُ يا سَيِّدي؟" فقالَ: "قُم واُدخُلْ دِمَشقَ، هُناكَ سيُعَلِّمُكَ أحَدُهُم الأعمالَ الّتي اختَرتُكَ للقيامِ بها". وقد أبصَرَ مَن مَعي ذلِكَ النُّورَ، إلاّ أنّهُم لم يُمَيِّزوا صَوتَ المُخاطِبِ.<verse eid="ACT 22:9-10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="ACT 22:11" />ولم يَكُن باستِطاعتي مُتابعةُ السَّيرِ، فقد أصابَني النُّورُ بالعَمى، فقادَني مَن كانوا برِفقتي مِن يَدي حتّى وَصَلنا إلى دِمَشقَ. <verse eid="ACT 22:11" /><verse number="12" style="v" sid="ACT 22:12" />وهُناكَ قابلَني رَجُلٌ تَقيٌّ اسمُهُ حَنانيّا، مُلتَزِمٌ تَعاليمَ التَّوراةِ، وكانَ مَحَلَّ احتِرامِ جَميعِ اليَهودِ، <verse eid="ACT 22:12" /><verse number="13" style="v" sid="ACT 22:13" />فاقتَرَبَ مِنّي ووَقَفَ بِجانِبي قائلاً: "يا أخي شاولُ أبصِرْ!" وحالَما انجَلى العَمى عَن عَينَيَّ رأيتُهُ. <verse eid="ACT 22:13" /><verse number="14" style="v" sid="ACT 22:14" />ثُمَّ قالَ لي: "لقدِ اختارَكَ رَبُّ آبائِنا الأوّلينَ لتَكونَ عالِمًا بما يُرضيهِ ولتَكونَ أنتَ مَن مَنَّ عليهِ برُؤيةِ المُرتَضى عيسى (سلامُهُ علينا)، ولِتَسمَعَ كَلامَهُ مُباشرةً، <verse eid="ACT 22:14" /><verse number="15" style="v" sid="ACT 22:15" />فيَجِبُ أن تُعلِنَ رِسالتَهُ بَينَ كُلِّ النّاسِ، وتُخبِرَهُم بما رأيتَ وما سَمِعَتَ مِنهُ! <verse eid="ACT 22:15" /><verse number="16" style="v" sid="ACT 22:16" />فما بالُكَ تُبطِئ في ذلِكَ؟ قُم واُطلُبْ شَفاعةَ سَيّدِنا عيسى (سلامُهُ علينا) واغتَسِلْ وتَطَهَّرْ مِن ذُنوبِكَ!"<verse eid="ACT 22:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="ACT 22:17" />فرَجعَتُ مِن فَوري إلى القُدسِ. وذاتَ يومٍ، بَينَما كُنتُ أُصَلّي في حَرَمِ بيتِ اللهِ، رُفِعَ عني الحِجابُ، <verse eid="ACT 22:17" /><verse number="18" style="v" sid="ACT 22:18" />ورأيتُ عيسى (سلامُهُ علينا) يَقولُ لي: "أسرِعْ بالخُروجِ مِن القُدسِ، فإنّهُم لن يَتَقَبّلوا مِنكَ دَعوتَكَ للإيمانِ بي". <verse eid="ACT 22:18" /><verse number="19" style="v" sid="ACT 22:19" />فأجَبتُ: "يا سَيِّدي، كَيفَ لا، وهؤلاءِ على عِلمٍ يَقينٍ بأنّني إنّما كُنتُ أتَوَجَّهُ إلى بُيوتِ العِبادةِ للقَبضِ على المُؤمنينَ بِكَ وسَجنِهِم وضَربِهِم. <verse eid="ACT 22:19" /><verse number="20" style="v" sid="ACT 22:20" />وعِندَما قُتِلَ شَهيدُكَ اِسطَفانَ كُنتُ هُناكَ وقد رَضيتُ عن ذلكَ، وكُنتُ حارِسًا لثيابِ قتَلَتِهِ". <verse eid="ACT 22:20" /><verse number="21" style="v" sid="ACT 22:21" />وأصَرّ عيسى (سلامُهُ علينا) على الأمرِ قائلاً: "اِرحَلْ عن القُدسِ! سأُرسِلُكَ إلى غَيرِ اليَهودِ للدَّعوةِ في البِلادِ البَعيدةِ!"<verse eid="ACT 22:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="ACT 22:22" />وعِندَما نَطَقَ بولُسُ بهذِهِ الكَلِماتِ عن دَعوةِ غَيرِ اليَهودِ، قَطَعَ الحاضِرونَ صَمتَهُم وبَدَؤوا يَصرُخونَ: "هيّا نَقتُلْهُ! لنَمحُ هذا الرَّجُلَ مِنَ الوُجودِ! فحَرامٌ أن يَبقى على قَيدِ الحَياة!" <verse eid="ACT 22:22" /><verse number="23" style="v" sid="ACT 22:23" />ثُمَّ عَلا صُراخُهُم مُلَوِّحينَ بثيابِهِم غَضَبًا مُلقينَ نَحوَهُ بحَفناتٍ مِن تُرابٍ مَلأتِ المَكانَ. <verse eid="ACT 22:23" /><verse number="24" style="v" sid="ACT 22:24" />فأمَرَ القائدُ عِندئذٍ جُنودَهُ باقتيادِ بولُسَ إلى القَلعةِ، وجَلدِهِ أثناءَ استِجوابِهِ لمَعرِفةِ سَبَبِ احتِجاجِ الحُشودِ عليهِ بمِثلِ هذِهِ الطَّريقةِ. <verse eid="ACT 22:24" /><verse number="25" style="v" sid="ACT 22:25" />وعِندَما مَدَّدوهُ ورَبَطوهُ استِعدادًا لجَلدِهِ، التَفَتَ بولُسُ إلى الضّابطِ الواقفِ بجانبِهِ وقالَ: "هل يُعطيكُم القانونُ الحَقَّ بجَلدِ مواطنٍ رُومانيٍّ بِلا مُحاكَمةٍ؟" <verse eid="ACT 22:25" /><verse number="26" style="v" sid="ACT 22:26" />ولمّا سَمِعَ الضّابطُ ذلِكَ أسرَعَ إلى القائدِ وأخبَرَهُ قائلاً: "أَتَعلَمُ أَيَّ مُخالفةٍ كُنّا سَنَرتَكِبُ لو جَلَدنا هذا الرَّجُلَ؟ إنّهُ مواطنٌ رومانيٌّ!"<note caller="+" style="f"><char style="fr" closed="false">22‏.26 </char><char style="ft" closed="false">فعل بولس ما فعله أيضًا في فيليبي. لأنّ الجنود خرقوا القانون بتقييد مواطن روماني، فاستخدم بولس حقوقه القانونية ضدّهم.</char></note> <verse eid="ACT 22:26" /><verse number="27" style="v" sid="ACT 22:27" />فتَوَجَّهَ القائدُ على الفَورِ إلى بولُسَ سائلاً: "أخبِرْني: هل أنتَ رُومانيُّ الجِنسيّةِ؟" فأجابَهُ: "نعم". <verse eid="ACT 22:27" /><verse number="28" style="v" sid="ACT 22:28" />فقالَ القائِدُ: "لقد دَفعتُ مَبلَغًا باهِظًا لأحصُلَ على هذِهِ الجِنسيّةِ". فرَدَّ عليهِ بولُسُ بالقَولِ: "أمّا أنا، فإنّني رومانيُّ المَولِدِ". <verse eid="ACT 22:28" /><verse number="29" style="v" sid="ACT 22:29" />وفي الحالِ ابتَعَدَ المُكَلّفونَ باستِجوابِ بولُسَ تَحتَ جَلدِ السِّياطِ، ومَلأ الخَوفُ أيضًا قَلبَ القائدِ لأنّهُ خالَفَ القانونَ الرُّومانيَّ بتَقييدِهِ بولُسَ المواطنَ الرُّومانيّ بالسَّلاسِلِ. <verse eid="ACT 22:29" /><verse number="30" style="v" sid="ACT 22:30" />وفي الغَدِ أرادَ أن يَعرِفَ تَفاصيلَ التُّهمةِ المُوجّهةِ إليهِ مِن اليَهودِ، وهكذا أخرَجَ القائدُ بولُسَ مِنَ السِّجنِ، وأمَرَ باجتِماعِ رُؤساءِ الأحبارِ، وجَميعِ أعضاءِ المَجلِسِ اليَهوديّ الأعلى، وبإحضارِ بولُسَ أمامَهُم.<note caller="+" style="f"><char style="fr" closed="false">22‏.30 </char><char style="ft" closed="false">عرف القائد أنّ بولس لم يكن قد خرق القانون الروماني، ولكنّه علم أيضًا أنّه فعل شيئًا ما يخصّ الديانة اليهودية، لذلك دعا مجلس اليهود الأعلى لتقصّي الأمر.</char></note><verse eid="ACT 22:30" /></para>
  <chapter eid="ACT 22" />
  <chapter number="23" style="c" sid="ACT 23" />
  <para style="cl">الفصل الثّالث والعشرون</para>
  <para style="s">خطاب بولس أمام أعضاء المجلس الأعلى</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 23:1" />وعِندَما مَثُلَ بولُسُ أمامَ أعضاءِ المَجلِسِ أخَذَ يُخاطِبُهُم مُحَدِّقًا إليهِم قائلاً: "يا إخوتي مِن بَني يَعقوبَ، لقَد وَهَبتُ نَفسي للهِ بِنيّةٍ صافيةٍ ولم أندَمْ على ذلكَ حتّى هذا اليومِ". <verse eid="ACT 23:1" /><verse number="2" style="v" sid="ACT 23:2" />فأمَرَ حَنانيّا رَئيسُ الأحبارِ الخُدّامَ بصَفْعِهِ على فيهِ. <verse eid="ACT 23:2" /><verse number="3" style="v" sid="ACT 23:3" />فوَبَّخَ بولسُ حَنانيّا قائلاً: "ليَضرِبْكَ اللهُ، أيُّها المُنافِقُ!<note caller="+" style="f"><char style="fr" closed="false">23‏.3 </char><char style="ft" closed="false">دعا بولس رئيس الأحبار "حائطًا مبيّضًا"، وقصد بذلك أنّه شخصٌ يخفي بشاعته وضعفه دون أن يتخلّص منهما، وبالطريقة نفسها التي يقدر اللون الأبيض أن يغطّي حائطًا بشعًا. </char></note> كَيفَ تأمُرُ بضَربي مُخالِفًا بذلِكَ أحكامَ التَّوراة، وأنتَ على أساسِها تَجلِسُ لمُحاكَمتي؟!" <verse eid="ACT 23:3" /><verse number="4" style="v" sid="ACT 23:4" />فالتَفَتَ إليهِ مَن كانوا واقفينَ بجِوارِهِ قائلينَ: "كَيفَ تَجرُؤُ أن تَشتُمَ مَن عَيَّنَهُ اللهُ رَئيسًا للأحبارِ؟" <verse eid="ACT 23:4" /><verse number="5" style="v" sid="ACT 23:5" />فأجابَهُم بولُسُ قائلاً: "لم أكُن أعلَمُ يا إخواني بأنّهُ رَئيسُ الأحبارِ، ولو كُنتُ أدري لما فَعَلتُ، فقد جاءَ في التَّوراةِ: "لا تَلعَنْ رَئيسَ شَعبِكَ". <verse eid="ACT 23:5" /><verse number="6" style="v" sid="ACT 23:6" />وكانَ بولُسُ يَعلَمُ أنّ أعضاءَ المَجلِسِ مُنقَسِمونَ إلى طائفتينِ، طائفةِ الصَّدّوقيّينَ، وطائفةِ المُتَشَدِّدينَ. لذلِكَ انبَرى قائلاً: "أيُّها الإخوةُ، إنّني أنتَمي إلى طائفةِ المُتَشَدِّدينَ أبًا عن جَدٍّ! وأنا الآنَ ماثِلٌ أمامَكُم لأحاكَمَ بسَبَبِ إيماني بأنّ اللهَ يُحيي المَوتى!"<verse eid="ACT 23:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="ACT 23:7" />فانقَسَمَ المَجلِسُ إلى قِسمَينِ: ووَقَفَ الصَّدّوقيونَ ضِدَّ المُتَشَدِّدينَ. <verse eid="ACT 23:7" /><verse number="8" style="v" sid="ACT 23:8" />فالصَّدّوقيّونَ لا يؤمنونَ بالبَعثِ ولا بالمَلائكةِ أو غَيرِها مِن الكائناتِ الأثيريّة، بَينَما يُقِرُّ المُتَشَدِّدونَ بتِلكَ الأُمورِ كُلِّها.<note caller="+" style="f"><char style="fr" closed="false">23‏.8 </char><char style="ft" closed="false">لم يكن الصدّوقيّون يؤمنون بالقيامة من بين الأموات، لأنّها لم تُذكر حرفيًا في التوراة. وكانوا يؤمنون بحسب المؤرّخ يوسيفوس أنّ روح الإنسان تختفي بموته.</char></note> <verse eid="ACT 23:8" /><verse number="9" style="v" sid="ACT 23:9" />وهاجَ الحُضورُ في المَجلِسِ، ووَقَفَت فِئةٌ مِن فُقهاءِ طائفةِ المُتَشَدِّدينَ للاحتِجاجِ بشِدّةٍ قائلينَ: "إنّنا لا نَرى لهذا الرَّجُلِ ذَنبًا! فرُبَّما كَلَّمَهُ شَيطانٌ أو مَلاكٌ". <verse eid="ACT 23:9" /><verse number="10" style="v" sid="ACT 23:10" />وما لَبِثَ الخِلافُ أن اشتَدَّ إلى دَرجةِ أنّ القائدَ خَشِيَ على بولُسَ أن يُقَطَّعَ إرَبًا إرَبًا، فأمَرَ بإنزالِهِ وإبعادِهِ عَنهُم، فساقوهُ إلى المُعَسكَرِ. <verse eid="ACT 23:10" /><verse number="11" style="v" sid="ACT 23:11" />وفي اللَّيلِ، ظَهَرَ سَيِّدُنا عيسى (سلامُهُ علينا) لبولُسَ يُقَوِّي عَزيمَتَهُ ويُطمئِنُهُ قائلاً: "لا عليكَ! لا بُدَّ أن تَمضيَ لتَتَحَدَّثَ عنّي في روما كَما فَعلتَ في القُدسِ".<verse eid="ACT 23:11" /></para>
  <para style="s">التّآمر على قتل بولس</para>
  <para style="p">
    <verse number="12‏-13" style="v" sid="ACT 23:12-13" />وفي صَباحِ اليومِ التّالي اجتَمَعَ أكثَرُ مِن أربعينَ رَجُلاً يَهوديًّا وقد عَزَموا على قَتلِ بولُسَ وعاهَدوا أنفُسَهُم ألاّ يَذوقوا طَعامًا ولا شَرابًا حتّى يَقتُلوهُ.<note caller="+" style="f"><char style="fr" closed="false">23‏.12‏-13 </char><char style="ft" closed="false">اعتبر بعض اليهود المتطرّفين الذين كانوا يريدون الإطاحة بالاحتلال الروماني أنّ جرائم الاغتيال أعمالٌ حسنة.</char></note> <verse eid="ACT 23:12-13" /><verse number="14" style="v" sid="ACT 23:14" />لذلِكَ تَوَجَّهوا إلى رُؤساءِ الأحبارِ وكِبارِ رِجالِ الدِّينِ قائلينَ: "لقد أقسَمنا ألاّ نَتَذَوّقُ طَعامًا حتّى نَقضيَ على بولُسَ. <verse eid="ACT 23:14" /><verse number="15" style="v" sid="ACT 23:15" />فعليكُم الآن مَعَ باقي أعضاءِ المَجلِسِ، التَّوَجُّهُ إلى القائدِ الرّومانيِّ طالبينَ إحضارَ بولُسَ للوقوفِ أمامَكُم بذَريعةِ إجراءِ تَحقيقٍ أدَقَّ مَعَهُ. وسنَكونُ نَحنُ على استِعدادٍ لقَتلِهِ قَبلَ وصُولِهِ إلى المَجلِسِ".<verse eid="ACT 23:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="ACT 23:16" />وعَلِمَ ابنُ أُختِ بولُسَ بهذا الكَمِينِ فتَوَجَّهَ إلى المُعَسكَرِ ليُخبِرَ بولُسَ بذلكَ. <verse eid="ACT 23:16" /><verse number="17" style="v" sid="ACT 23:17" />فاستَدعى بولُسُ أحَدَ الضُّبّاط وقالَ لهُ: "خُذ هذا الشّابَّ ليُقابِلَ القائدَ فإنّ لَدَيهِ شَيئًا يُريدُ إخبارَهُ بِهِ". <verse eid="ACT 23:17" /><verse number="18" style="v" sid="ACT 23:18" />فمَضى الضّابطُ مَعَ الشّابِّ إلى القائدِ وأخبَرَهُ بأنّ بولُسَ طَلَبَ إليهِ ذلِكَ، <verse eid="ACT 23:18" /><verse number="19" style="v" sid="ACT 23:19" />فأخَذَ القائدُ الشّابَّ مِن يَدِهِ وانفَرَدَ بِهِ سائلاً: "أخبِرْني بما عِندَكَ". <verse eid="ACT 23:19" /><verse number="20" style="v" sid="ACT 23:20" />فأسَرَّ إليهِ قائلاً: "سيَطلُبُ مِنكَ أعضاءُ المَجلِسِ غَدًا إحضارَ بولُسَ بحُجّةِ أنّهُم يُريدونَ إجراءَ تَحقيقٍ مَعَهُ، <verse eid="ACT 23:20" /><verse number="21" style="v" sid="ACT 23:21" />فلا تُصَدِّقْهُم! لأنّ هذا مُجَرَّدُ كَمينٍ دَبَّرَهُ حَوالي أربعينَ رَجُلاً مِنَ اليَهودِ عاهَدوا أنفُسَهُم ألاّ يَتَناوَلوا الطَّعامَ حتّى يَقتُلوا بولُسَ، وهم الآنَ يَتَهَيَّؤونَ لتَحقيقِ مأربِهِم". <verse eid="ACT 23:21" /><verse number="22" style="v" sid="ACT 23:22" />فصَرَفَ القائدُ الشّابَّ ونَبَّهَهُ بعَدَمِ البَوحِ بذلِكَ الأمرِ لأيٍّ كانَ.<verse eid="ACT 23:22" /></para>
  <para style="s">نقل بولس إلى قيصريّة</para>
  <para style="p">
    <verse number="23" style="v" sid="ACT 23:23" />ثُمّ استَدعى القائدُ اثنَينِ مِن ضُبّاطِهِ وأمَرَهُما قائلاً: "عليكُم أن تَعِدّوا قوّةً تَتألّفُ مِن مِئتي جُنديٍّ وسَبعينَ فارِسًا، ومِئتينِ مِنَ الرُّماةِ للذَّهابِ حالاً إلى مَدينةِ قَيصريّة<note caller="+" style="f"><char style="fr" closed="false">23‏.23 </char><char style="ft" closed="false">كانت مدينة قيصرية عاصمة ولاية يهوذا في فلسطين.</char></note> هذِهِ اللّيلةَ على السّاعةِ التّاسِعةِ. <verse eid="ACT 23:23" /><verse number="24" style="v" sid="ACT 23:24" />وجَهِّزوا فَرَسًا لبولُسَ يَحمِلُهُ سالِمًا إلى الحاكمِ فيلِكْسَ". <verse eid="ACT 23:24" /><verse number="25" style="v" sid="ACT 23:25" />ثُمَّ خَطَّ رِسالةً يَقولُ فيها: <verse eid="ACT 23:25" /><verse number="26" style="v" sid="ACT 23:26" />"مِنَ القائدِ كُلُودِيُوسَ ليسِياسَ إلى صاحبِ الفَخامةِ فيلِكْسَ الحاكمِ. بَعدَ التَّحيّةِ، <verse eid="ACT 23:26" /><verse number="27" style="v" sid="ACT 23:27" />أودُّ أن أُخبِرَكَ بأنّ اليَهودَ قَبَضوا على هذا الرَّجُل، وأوشَكوا على قَتلِهِ، إلاّ أنّني تَوَجَّهتُ مَعَ جُنودي إليهِ فأنقَذناهُ مِن بَينِ أيدِيهِم، لأنّني عَلِمتُ أنّهُ مواطنٌ رومانيٌّ. <verse eid="ACT 23:27" /><verse number="28" style="v" sid="ACT 23:28" />وأرَدتُ مَعرِفةَ سَبَبِ شَكواهُم عليهِ، فأحضَرتُهُ أمامَ مَجلسِهِم، <verse eid="ACT 23:28" /><verse number="29" style="v" sid="ACT 23:29" />فوَجَدتُ أنّ التُّهمةَ المُوَجَّهةَ إليهِ تَتَعَلَّقُ بأُمورِ دينِهِم، ولم تَكُن هُناكَ شَكوى عليهِ يَستَحِقُّ مِن أجلِها المَوتَ أو السَّجنَ. <verse eid="ACT 23:29" /><verse number="30" style="v" sid="ACT 23:30" />ثُمَّ عَلِمتُ أنّ مؤامَرةً تُحاكُ لهُ، فأرسَلتُهُ إليكَ على وَجهِ السُّرعةِ، وسألتُ الّذينَ اتّهَموهُ أن يُقدِّموا شَكواهُم عليهِ بَينَ يَديكَ".<verse eid="ACT 23:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="ACT 23:31" />فنَفَّذَ الجُنودُ أوامِرَ القائدِ واصطَحَبوا بولُسَ لَيلاً إلى بَلدةِ أنْتيباتْريسَ، <verse eid="ACT 23:31" /><verse number="32" style="v" sid="ACT 23:32" />وفي اليومِ التّالي، تَرَكَ الجُنودُ بولُسَ بعُهدةِ الفُرسانِ ليَعودوا إلى مُعَسكَرِهِم في القُدس. <verse eid="ACT 23:32" /><verse number="33" style="v" sid="ACT 23:33" />وعِندَما وَصَلَ الفُرسانُ مَدينةَ قَيصريّة، سَلَّموا الرِّسالةَ وبولُسَ إلى الحاكِم. <verse eid="ACT 23:33" /><verse number="34" style="v" sid="ACT 23:34" />فقَرَأ الحاكمُ الرِّسالةَ ثُمّ استَفسَرَ بولُسَ عنِ الوِلاية الرُّومانيّة الّتي يَنتمي إليها فأخبَرَهُ بأنّها كِليكيّة، فقالَ لهُ: <verse eid="ACT 23:34" /><verse number="35" style="v" sid="ACT 23:35" />"سأستَمِعُ إلى قَضيَّتِكَ عِندَ حُضورِ مَنِ اتّهَموكَ". ثُمَّ أمَرَ بحِراسةِ بولُسَ في قَصرِ هيرودُسَ.<note caller="+" style="f"><char style="fr" closed="false">23‏.35 </char><char style="ft" closed="false">صار القصر الذي بناه هيرودس الكبير في قيصرية مكان إقامة الحكّام الرومان في ولاية يهوذا. وكان يُستخدم أيضًا لانعقاد المحكمة حيث يحكم الولاة في القضايا القانونية.</char></note><verse eid="ACT 23:35" /></para>
  <chapter eid="ACT 23" />
  <chapter number="24" style="c" sid="ACT 24" />
  <para style="cl">الفصل الرّابع والعشرون</para>
  <para style="s">بولس يمثل أمام الحاكم فيلكس</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 24:1" />وبَعدَ مُضيِّ خَمسةِ أيّامٍ، قَدِمَ حَنانيّا رَئيسُ الأحبارِ إلى مَدينةِ قَيصريّة وبصُحبَتِهِ بَعضُ رِجالِ الدِّينِ ومُحامٍ اسمُهُ تَرْتُلُّسُ، ليُقَدِّموا شَكوى ضِدَّ بولسَ أمامَ الحاكمِ. <verse eid="ACT 24:1" /><verse number="2" style="v" sid="ACT 24:2" />وعِندَ استدعاءِ بولُسَ، قامَ المُحامي بذِكرِ الشَّكوى أمامَ فيلِكْسَ مُستَهِلّاً بقولِهِ: "يا صاحِبَ الفَخامةِ فيلِكْسُ، إنّنا بِفَضلِكُم نَنعَمُ بالأمانِ والسَّلامِ مُنذُ زَمَنٍ طَويلٍ، وبفَضلِ حُسنِ قيادتِكُم تَحَسَّنَتْ أوضاعُ البلادِ، <verse eid="ACT 24:2" /><verse number="3" style="v" sid="ACT 24:3" />لِذا نَحنُ نُعلِنُ دائمًا امتِنانَنا لكُم في كُلِّ مَكانٍ. <verse eid="ACT 24:3" /><verse number="4" style="v" sid="ACT 24:4" />ولن أُطيلَ عليكُم بكَثرَةِ الكَلامِ، إنّ ما نَرجوهُ مِنكُم تَقَبُّلُ خُلاصةِ شَكوانا بما نَعلَمُهُ مِنكُم مِن رَحابةِ الصَّدر. <verse eid="ACT 24:4" /><verse number="5‏-6" style="v" sid="ACT 24:5-6" />إنّنا وَجَدنا هذا الرَّجُلَ بَلاءً، فهو الّذي يَقِفُ وَراءَ الفِتَنِ والاضطِراباتِ الّتي تَعُمُّ اليَهودَ في جَميعِ الأنحاءِ. وإنّنا نُعلِمُكُم أنّهُ زَعيمُ طائفةِ النَّصارى، وهو مَن حاوَلَ تَدنيسَ حَرَمِ بيتِ الله. لذلِكَ قُمنا بالقَبضِ عليهِ وتَقديمِهِ إلى المُحاكَمةِ تَبعًا لمُقتضيات دينِنا. <verse eid="ACT 24:5-6" /><verse number="7" style="v" sid="ACT 24:7" />إلاّ أنّ القائدَ لِيسياسَ لم يُساعِدْنا في ذلِكَ، بلِ استَخدَمَ ضِدَّنا العُنفَ وأخَذَهُ مِن بَينِ أيدينا، <verse eid="ACT 24:7" /><verse number="8" style="v" sid="ACT 24:8" />بَعدَ أن أمَرَنا برَفعِ شَكوانا إليكُم. وسَوفَ تَعرِفونَ صِدقَنا في ما نَقولُ، عِندَما تَستَجوبونَهُ بنَفسِكم". <verse eid="ACT 24:8" /><verse number="9" style="v" sid="ACT 24:9" />وصادَقَ رِجالُ الدّينِ اليَهودُ جَميعًا على صِحَّةِ تِلكَ الأقوالِ.<verse eid="ACT 24:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="ACT 24:10" />فأشارَ الحاكِمُ إلى بولُسَ بالكَلامِ فقالَ: "إنّني على عِلمٍ بأنّكُم القائمُ على أمرِ هذِهِ البلادِ مُنذُ سَنَواتٍ، لذا فإنّي مُطمَئنٌّ كُلَّ الاطمِئنانِ في الدِّفاعِ عن نَفسي أمامَكُم. <verse eid="ACT 24:10" /><verse number="11" style="v" sid="ACT 24:11" />ويُمكِنُكُم ببَساطةٍ، أن تَتَبَيَّنوا أنّي ذَهَبتُ إلى القُدسِ للعِبادةِ مُنذُ فَترةٍ لا تَزيدُ عنِ الاثنَي عَشَرَ يومًا، <verse eid="ACT 24:11" /><verse number="12" style="v" sid="ACT 24:12" />ولم يَجِدْني خُصومي يَومًا مِن تِلكَ الأيّامِ أُجادِلُ أحَدًا في الحَرَمِ الشَّريفِ، أو أفتَعِلُ إثارةَ النّاسِ في بُيوتِ العِبادةِ، ولا في أيِّ مَكانٍ آخَرَ في المَدينةِ. <verse eid="ACT 24:12" /><verse number="13" style="v" sid="ACT 24:13" />وإنّهُم الآنَ عاجِزونَ عن إثباتِ ادِّعاءَاتِهِم عليَّ. <verse eid="ACT 24:13" /><verse number="14" style="v" sid="ACT 24:14" />لذا، أُقِرُّ أنّني، كَباقي أبناءِ شَعبي، أعبُدُ اللهَ الّذي عَبَدَهُ آبائي الأوّلونَ، وذلِكَ حَسَبَ طَريقِ مَولاي عيسى (سلامُهُ علينا) الّذي يَدَّعونَ أنّهُ لم يَكُن سِوى بِدعةٍ. كَما أُقِرُّ أنّني مُؤمِنٌ بكُلِّ ما جاءَ في التَّوراةِ والزَّبورِ وغَيرِهِما مِن كُتُبِ الأنبياءِ، <verse eid="ACT 24:14" /><verse number="15" style="v" sid="ACT 24:15" />ولَدَيَّ يَقينٌ كهذِهِ الجَماعةِ بأنّ اللهَ تَعالى سيُحيي المَوتى جَميعًا الأبرارَ مِنهُم والأشرارَ. <verse eid="ACT 24:15" /><verse number="16" style="v" sid="ACT 24:16" />وبسَبَبِ يَقيني هذا، أبذُلُ جَهدي على الدَّوام لأكونَ نَقيَّ السَّريرةِ تُجاه اللهِ والبَشَرِ. <verse eid="ACT 24:16" /><verse number="17" style="v" sid="ACT 24:17" />وقدِ غِبتُ عنِ القُدس عِدّةَ سَنَواتٍ، وعِندَما عُدتُ إليها حَمَلتُ مَعي لأهلِها مِنَ الفُقراءِ بَعضَ الصَّدَقاتِ، وقَدَّمتُ بَعضَ الذَّبائحِ لوَجهِ اللهِ. <verse eid="ACT 24:17" /><verse number="18" style="v" sid="ACT 24:18" />وكُنتُ أقومُ بذلكَ في الحَرَمِ الشَّريفِ بَعدَ أن تَطَهَّرتُ. ولم أُحَرِّضْ النّاسَ حِينذاكَ ليَتَجمَّعوا حَولي، ولم أكُن مُثيرًا لأيِّ فِتنة. ولقد رآني بَعضُ اليَهودِ مِن مُقاطعةِ آسيا في الحَرَمِ، <verse eid="ACT 24:18" /><verse number="19" style="v" sid="ACT 24:19" />فكانَ على هؤلاءِ أن يأتوا إليكَ ليُقَدِّموا بأنفُسِهِم شَكواهُم عليَّ إن كانَت لَدَيهِم شَكوى. <verse eid="ACT 24:19" /><verse number="20" style="v" sid="ACT 24:20" />أمَا هؤلاءِ الحاضِرونَ المُحتَجّونَ، فلْيَذكُروا أنّهُم عِندَما حاكموني أمامَ المَجلِسِ اليَهوديِّ لم يَجِدوا أساسًا لاتّهاماتِهِم لي، <verse eid="ACT 24:20" /><verse number="21" style="v" sid="ACT 24:21" />سِوى ما قُلتُهُ أمامَ المَجلسِ مِن أنّني أؤمنُ بأنّ المَوتى سيُبعَثونَ أحياءً".<verse eid="ACT 24:21" /></para>
  <para style="s">بولس في سجن قيصريّة</para>
  <para style="p">
    <verse number="22" style="v" sid="ACT 24:22" />وبما أنّ فيلِكْسَ كانَ على مَعرِفةٍ صَحيحةٍ بطَريقِ عيسى (سلامُهُ علينا)، أمَرَ بفَضِّ الاجتِماعِ قائلاً: "سأصدِرُ حُكمي في هذِهِ القَضِيّة عِندَ قُدومِ القائِدِ ليسِياسَ". <verse eid="ACT 24:22" /><verse number="23" style="v" sid="ACT 24:23" />وأمَرَ الضّابِطُ بحِراسةِ بولُسَ، مَعَ مَنحِهِ قليلاً مِنَ الحُرّيّةِ، والسَّماحِ لأصدقائِهِ بالتَّرَدُّدِ عليهِ وخِدمتِهِ.<verse eid="ACT 24:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="ACT 24:24" />وبَعدَ مُضيِّ أيّامٍ على ذلِكَ، قَدِمَ فيلِكْسُ رِفقةَ زَوجتِهِ اليَهوديّة دُروسِيلا. واستَدعى بولُسَ للاستِماعِ إليهِ. فأخَذَ بولُسُ يُحَدِّثُهُ عنِ الإيمانِ بِعيسى المَسيحِ (سلامُهُ علينا)، <verse eid="ACT 24:24" /><verse number="25" style="v" sid="ACT 24:25" />وعنِ الصَّلاحِ والعِفَّة ويَومِ الدِّينِ، وهُنا استَبَدّ الخَوفُ بفيلِكْسَ فقالَ: "حَسبُكَ الآنَ! وامضِ حتّى أستَدعِيكَ ثانِيةً عِندَما أجِدُ الوقتَ مُناسِبًا". <verse eid="ACT 24:25" /><verse number="26" style="v" sid="ACT 24:26" />وقد كانَ فيلِكْسُ يُكثِرُ مِن استدعاءِ بولسَ ويُحادِثُهُ لَعَلَّهُ يَعرِضُ رَشوةً عليهِ ليُطلقَ سَراحَهُ، ولكن دونَ طائلٍ. <verse eid="ACT 24:26" /><verse number="27" style="v" sid="ACT 24:27" />ومَرَّ على ذلِكَ سَنتان. وقَبلَ أن يُغادِرَ فيلِكْسُ الحُكمَ إثرَ تَعيينِ بُورْكِيُوسَ فَسْتُوسَ خَلَفًا لهُ، أبقى بولُسَ في السِّجنِ إرضاءً لليَهودِ.<verse eid="ACT 24:27" /></para>
  <chapter eid="ACT 24" />
  <chapter number="25" style="c" sid="ACT 25" />
  <para style="cl">الفصل الخامس والعشرون</para>
  <para style="s">أمام الحاكم فستوس</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 25:1" />وبَعدَ ثلاثةِ أيّامٍ مِن وُصُولِ الحاكمِ فَسْتُوسَ إلى الولايةِ، تَوَجَّهَ مِن قَيصريّة إلى القُدسِ، <verse eid="ACT 25:1" /><verse number="2‏-3" style="v" sid="ACT 25:2-3" />وهُناكَ تَقَدّمَ رؤساءُ الأحبارِ وقادةُ اليَهودِ إليهِ بشَكوى على بولُسَ مُلِحِّينَ عليهِ أن يُرسِلَهُ إلى القُدس. وكانوا قد وَضَعوا خِطَّةً لِقَتلِهِ وهو في طَريقِهِ إلى هُناكَ. <verse eid="ACT 25:2-3" /><verse number="4‏-5" style="v" sid="ACT 25:4-5" />فأجابَهُم فَستوسُ: "إنّ بولُسَ مَحجوزٌ في قَيصريّة وإنّي عائدٌ إليها الآنَ، فليأتِ مَعي بَعضُ أعيانِكُم ويُقَدِّمونَ الشَّكوى ضِدَّهُ إن كانَ مُذنبًا".<verse eid="ACT 25:4-5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="ACT 25:6" />وانقَضَت ثَمانيةُ أو عَشَرةُ أيّامٍ على وُجودِ فَستُوسَ في القُدسِ عادَ بَعدَها إلى قَيصريّة حَيثُ عَقَدَ في اليومِ التّالي جَلسةً لمُحاكَمةِ بولُسَ. <verse eid="ACT 25:6" /><verse number="7" style="v" sid="ACT 25:7" />وعِندَ وُصولِ بولُسَ إلى مَكانِ المُحاكَمةِ، تَجَمهَرَ حَولَهُ بَعضُ قادةِ اليَهودِ الّذينَ جاؤوا مِنَ القُدسِ، وتَقَدَّموا ضِدَّهُ بشَكاوٍ خَطيرةٍ كثيرةٍ لم يَكُن لهُم على إثباتِها دَليلٌ. <verse eid="ACT 25:7" /><verse number="8" style="v" sid="ACT 25:8" />فوَقَفَ بولُسُ إذ ذاكَ يُدافِعُ عن نَفسِهِ قائلاً: "لم يَكُن مِن ذَنبٍ ارتَكَبتُهُ ضِدَّ الدِّينِ اليَهوديّ أو ضِدَّ بَيتِ اللهِ أو ضِدَّ القَوانينِ الرُّومانيّة". <verse eid="ACT 25:8" /><verse number="9" style="v" sid="ACT 25:9" />وكانَ في نِيّةِ فَستُوسَ إرضاءُ اليَهودِ، فسألَهُ: "هل أنتَ على استِعدادٍ للذَّهاب إلى القُدسِ، فتَمثُلُ هُناكَ للمُحاكَمةِ أمامي؟" <verse eid="ACT 25:9" /><verse number="10" style="v" sid="ACT 25:10" />فأجابَهُ بولُسُ: "كَلاّ! فأنا الآنَ واقِفٌ أمامَ مَحكَمةِ القَيصرِ حَيثُ يَجِبُ أن أُحاكَمَ.<note caller="+" style="f"><char style="fr" closed="false">25‏.10 </char><char style="ft" closed="false">في هذا المقطع، يستعين بولس بحقّه كمواطنٍ روماني أن يرفض محاكمته أمام سلطات يعتبرها غير ملائمة، وكذلك حقّه في رفض تدخّل مجلس اليهود الأعلى الذي كان يريد قتله، وكان بولس على علم بذلك. </char></note> وإنّكم لتَعلَمونَ بلا ريبٍ أنّي ما ارتَكَبتُ ذَنبًا ضِدَّ اليهودِ قَطعًا، <verse eid="ACT 25:10" /><verse number="11" style="v" sid="ACT 25:11" />وأنا لَستُ مِمّن يَفِرُّ مِنَ العُقوبةِ العادِلةِ وإن قَضَتْ بمَوتي، ولكنّني بَريءٌ مِمّا يَكيلونَهُ ضِدّي مِن تُهَمٍ مُفتراةٍ، ولَيسَ لأحَدٍ الحقُّ أن يُسَلِّمَني إليهِم، ولذلِكَ فإنّي إلى قَيصرِ روما أرفَعُ قَضيّتي!"<note caller="+" style="f"><char style="fr" closed="false">25‏.11 </char><char style="ft" closed="false">بالرغم من أنّ الوالي لم يكن قد بتَّ في قضية بولس، إلاّ أنّ هذا الأخير كان من حقّه أن يعارض اقتراح الوالي بتغيير مكان محاكمته. </char></note> <verse eid="ACT 25:11" /><verse number="12" style="v" sid="ACT 25:12" />وبَعدَ أن تَشاوَرَ فَستوسُ مَعَ مُستَشاريهِ، رَدَّ عليهِ قائلاً: "بما أنّكَ تَطلُبُ رَفعَ قَضيّتَكَ إلى القَيصرِ، فستَذهَبُ إليهِ".<verse eid="ACT 25:12" /></para>
  <para style="s">أغريباس وبرنيس</para>
  <para style="p">
    <verse number="13" style="v" sid="ACT 25:13" />وبَعدَ بِضعةِ أيّامٍ، أقبَلَ المَلِكُ أَغْريباسُ الثّاني تُرافِقُهُ شَقيقتُهُ بِرنيسُ إلى مَدينةِ قَيصريّة وذلِكَ للتَّرحيبِ بِفَستوسَ رَسميًّا.<note caller="+" style="f"><char style="fr" closed="false">25‏.13 </char><char style="ft" closed="false">كان أغريباس الثاني ابن أغريباس الأول (المذكور في سيرة الحواريين الفصل 12)، وقد عيّنه الإمبراطور كلوديوس ملكًا على أجزاء صغيرة من بلاد الشام سنة 53 للميلاد. وقد كان اليهود يكرهونه، خاصةً كبار الأحبار منهم. وفي ذلك الوقت، كانت أخته برنيس قد ترمّلت وعاشت معه. </char></note> <verse eid="ACT 25:13" /><verse number="14" style="v" sid="ACT 25:14" />وأقاما فيها عِدّة أيّامٍ عَرَضَ خِلالَها فَستوسُ على المَلِكِ قَضيّةَ بولُسَ قائلاً: "يُوجَدُ في السِّجنِ رَجُلٌ تَرَكَهُ لي فيلِكسُ، <verse eid="ACT 25:14" /><verse number="15" style="v" sid="ACT 25:15" />وقد أمَدَّني رُؤساءُ الأحبارِ وغَيرُهُم مِن كِبارِ اليَهودِ بشَكاوٍ ضِدَّهُ عِندَما كُنتُ في زيارةٍ إلى القُدسِ، طالبينَ مِنِّي مُعاقبتَهُ، <verse eid="ACT 25:15" /><verse number="16" style="v" sid="ACT 25:16" />إلاّ أنّني أجَبتُهُم بأنّهُ لا يَحِقُّ الحُكمُ على أحَدٍ دونَ مُحاكَمةٍ طِبقًا للقانونِ الرُّومانيّ، وللمُتَّهِمِ الحقُّ في الدِّفاعِ عَن نَفسِهِ أمامَ خُصومِهِ. <verse eid="ACT 25:16" /><verse number="17" style="v" sid="ACT 25:17" />وهكذا، أقبَلَ قادةُ اليَهودِ إلى قَيصريّةِ. وفي اليومِ التّالي ودونَ تأخيرٍ جَلَستُ على الفَورِ على مَنَصّةِ القَضاءِ وأمَرتُ بإحضارِ الرَّجُلِ. <verse eid="ACT 25:17" /><verse number="18" style="v" sid="ACT 25:18" />وعِندَما وَقَفَ خُصومُهُ ليُواجِهوهُ باتِّهاماتِهِم، لم يَتّهِموهُ بارتِكابِ جَرائمَ ضِدَّ القانونِ الرُّومانيّ كَما تَوَقّعتُ، <verse eid="ACT 25:18" /><verse number="19" style="v" sid="ACT 25:19" />بل جَرى بَينَهُم جَدَلٌ حَولَ أُمورِ عَقيدتِهِم، وتَحديدًا حَولَ شَخصٍ تُوّفِيَ واسمُهُ عيسى، وكانَ بولُسُ يؤكِّدُ لهُم أنّهُ حَيّ يُرزَق. <verse eid="ACT 25:19" /><verse number="20" style="v" sid="ACT 25:20" />وهُنا تَمَلَّكَتني الحَيرةُ في كَيفيّةِ الحُكمِ في هذا الأمرِ، فسألتُ بولُسَ هل هو مُستَعِدٌ أن يَذهَبَ إلى القُدسِ لتُعادَ مُحاكَمتُهُ هُناكَ على ضَوءِ التُّهَمِ المُوجَّهَةِ ضِدَّهُ،<note caller="+" style="f"><char style="fr" closed="false">25‏.20 </char><char style="ft" closed="false">ادّعى فستوس أنّ الطبيعة الدينية لتلك المشاجرة تعني أنّه من الأفضل إجراء المحاكمة في القدس، باستشارة القادة اليهود. ولكن فستوس كان في نيّته إرضاء اليهود. </char></note> <verse eid="ACT 25:20" /><verse number="21" style="v" sid="ACT 25:21" />ولكنَّهُ رَفَضَ وطَلَبَ أن تُرفَعَ قَضيَّتُهُ إلى جَلالةِ القَيصرِ للنَّظَرِ فيها، فأمَرتُ بإبقائِهِ تَحتَ الحِراسةِ إلى حينِ تَمَكُّني مِن إرسالِهِ إلى القَيصرِ". <verse eid="ACT 25:21" /><verse number="22" style="v" sid="ACT 25:22" />فانبَرى أَغريباسُ مُوَجِّهًا كَلامَهُ لِفَسْتوسَ قائلاً: "وأنا أيضًا أرغَبُ في الاستِماعِ إلى هذا الرَّجُلِ". فأجابَهُ: "غدًا تَستَمِعُ إليهِ".<verse eid="ACT 25:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="ACT 25:23" />وفي اليَومِ التّالي، حَضَرَ أَغريباسُ الثّاني وأختُهُ بِرنيسُ في مَوكِبٍ فَخمٍ، ودَخَلا قاعةَ المَراسِمِ، مُحاطَيْنِ بالقادةِ العَسكَريِّينَ، وكِبارِ أعيانِ المَدينة. فأمَرَ فَستوسُ عِندئذٍ بإحضارِ بولُسَ، <verse eid="ACT 25:23" /><verse number="24" style="v" sid="ACT 25:24" />ولمّا حَضَرَ بَدأ فَستوسُ الجَلسةَ مُوَجِّهًا حَديثَهُ إلى المَلِكِ قائلاً: "أيُّها المَلِكُ أَغريباسُ، أيُّها السّادةُ الحاضِرونَ، إنّ هذا الرَّجُلَ الّذي تَرَونَ هو المَطلوبُ إعدامُهُ بإلحاحٍ مِنَ اليَهودِ كُلِّهِم في القُدسِ وفي مَدينةِ قَيصريّة، <verse eid="ACT 25:24" /><verse number="25" style="v" sid="ACT 25:25" />أمّا أنا فما وَجَدتُ لهُ جُرمًا يَستَحِقُّ عليهِ المَوتَ. ولقد رَفَعَ الرَّجُلُ قَضيَّتَهُ إلى جَلالةِ القَيصرِ، فقَرَّرتُ إرسالَهُ إلى روما <verse eid="ACT 25:25" /><verse number="26" style="v" sid="ACT 25:26" />وما مِن قَضيةٍ أو تُهمةٍ واضِحةٍ أكتُبُ عنها لمَولانا القَيصر. لذا أحضَرتُهُ أمامَكُم جَميعًا، وأمامَكَ أنتَ أيُّها المَلِكُ أَغريباسُ على وَجهِ الخُصُوص، حتّى إذا نَظَرنا في قَضيّتِهِ اتّفَقنا على ما أكتُبُ عنها لجَلالةِ القَيصر، <verse eid="ACT 25:26" /><verse number="27" style="v" sid="ACT 25:27" />إذ لا يُعقَلُ كَما أعتَقِدُ، أن يُرسَلَ سَجينٌ دونَ وَثيقةِ الاتّهامِ".<verse eid="ACT 25:27" /></para>
  <chapter eid="ACT 25" />
  <chapter number="26" style="c" sid="ACT 26" />
  <para style="cl">الفصل السّادس والعشرون</para>
  <para style="s">دفاع بولس أمام أغريباس</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 26:1" />فتَوَجَّهَ أَغْريباسُ بكَلامِهِ إلى بولُسَ قائلاً: "نأذنُ لكَ الآنَ بالدِّفاعِ عن نَفسِكَ". فأشارَ بولسُ بيدِهِ مُستَهِلاًّ دِفاعَهُ عن نَفسِهِ بقولِهِ: <verse eid="ACT 26:1" /><verse number="2" style="v" sid="ACT 26:2" />"أيُّها المَلِكُ أغْريباسُ، إنّي أحسِبُ نَفسي سَعيدًا أن أقومَ بالدِّفاعِ عن نَفسي أمامَكُم اليَومَ، لأدحَضَ ادّعاءَاتِ قادةِ اليَهودِ، <verse eid="ACT 26:2" /><verse number="3" style="v" sid="ACT 26:3" />خُصوصًا وأنّكُم تَعلَمونَ بعاداتِهِم وتَقاليدِهِم واختِلافِ آرائِهِم بشأنِها. ولذا، أرجو أن تُصغوا إلى كَلامي بتَمَعُّنٍ وصَبرٍ". <verse eid="ACT 26:3" /><verse number="4" style="v" sid="ACT 26:4" />وبَدأ بولُسُ دِفاعَهُ هذا بقَولِهِ: "إنّ اليَهودَ جَميعًا يَعرِفونَ سِيرةَ حياتي مُذ كُنتُ شابًّا، كَما يَعلَمونَ نَشأتي في بَلَدي وانتِقالي للعِيشِ في القُدسِ، <verse eid="ACT 26:4" /><verse number="5" style="v" sid="ACT 26:5" />إنّهُم يَعرِفونَني مُنذُ أمَدٍ طَويلٍ، وبإمكانِهِم -إن أرادوا- أن يُدِلوا بشَهادتِهِم على أنّي كُنتُ ألتَزِمُ بأشدِّ المَذاهِبِ اليَهوديّةِ، لأنّي كُنتُ أنتمي إلى طائفةِ المُتَشَدِّدِينَ. <verse eid="ACT 26:5" /><verse number="6" style="v" sid="ACT 26:6" />واليَومَ فإنِّي أُحاكَمُ بسَبَبِ ثِقتي في أنّ اللهَ قادرٌ على تَحقيقِ ما وَعَدَهُ لآبائنا الأوّلينَ <verse eid="ACT 26:6" /><verse number="7" style="v" sid="ACT 26:7" />بخُصوصِ نَجاتِهِم بَعدَ بَعثِ المَوتى مِنَ القُبورِ، والوَعدُ هو الرَّجاءُ الّذي يَنتَظِرُ أسباطُنا الاثنا عَشَرَ تَحَقُّقَهُ وهُم يَعبُدونَ اللهَ تَعالى لَيلاً نَهارًا. إنّ ثِقتي باللهِ وبتَحقيقِ وَعدِهِ هذا هي سَبَبُ ما أواجِهُهُ مِن تُهَمِ اليَهودِ". <verse eid="ACT 26:7" /><verse number="8" style="v" sid="ACT 26:8" />ثُمّ تَوَجَّهَ بولُسُ إلى خُصومِهِ وقالَ: "لِماذا تَشُكّونَ في قُدرَةِ اللهِ في بَعثِ المَوتى مِن جَديدٍ؟"<verse eid="ACT 26:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="ACT 26:9" />"لقد كانَت لديّ في البَدءِ قَناعةٌ مَفادُها أنّهُ عليّ مُعارَضةُ عيسى النّاصريِّ بكُلِّ ما أوتيتُ مِن قُوّةٍ وجَهدٍ، <verse eid="ACT 26:9" /><verse number="10" style="v" sid="ACT 26:10" />وفَعَلتُ ذلِكَ في مَدينةِ القُدسِ، بتَفويضٍ مِن رُؤساءِ الأحبارِ، ورَمَيتُ بالبَعضِ مِن أتباعِهِ في السِّجنِ، ووافَقتُ المَجلِسَ عِندَما حَكَمَ على آخَرينَ مِنهُم بالإعدامِ، <verse eid="ACT 26:10" /><verse number="11" style="v" sid="ACT 26:11" />بل إنّي كُنتُ أتَرَدَّدُ على بُيوتِ العِبادةِ حَيثُ يَتَعَبّدونَ بهَدَفِ اضطِهادِهِم وإكراهِهِم على إهانةِ عيسى والإساءةِ إليهِ، وقد بَلَغَ بي التّعَصُّبُ ضِدَّهُم إلى دَرجةِ مُلاحَقةِ بَعضِهِم إلى مُدُنِ خارجِ البِلادِ للعُثورِ عليهِم واضطِهادِهِم".<verse eid="ACT 26:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="ACT 26:12" />ثُمّ أردَفَ قائلاً: "يا جَلالةَ المَلِكِ، لقد صادَفَ في تِلكَ الفَترةِ أثناءَ أحَدِ رِحلاتي أن تَوَجّهتُ إلى دِمَشق بتَفويضٍ مِن رُؤساءِ الأحبارِ. <verse eid="ACT 26:12" /><verse number="13" style="v" sid="ACT 26:13" />وعِندَ الظَّهيرةِ، شاعَ نورٌ مِن السَّماءِ أشَدُّ سُطوعًا مِن نورِ الشَّمسِ حَولي وحَولَ رِفاقي، <verse eid="ACT 26:13" /><verse number="14" style="v" sid="ACT 26:14" />أوقَعنا جَميعًا أرضًا، وعَلا بَعدَهُ صَوتٌ يَتَحَدَّثُ بالعِبريّة قائلاً: "شاولُ! يا شاولُ، لِما تَضطَهِدُني؟! إنّكَ بذلِكَ تُقاوِمُ إرادةَ اللهِ دونَ جَدوى كدابّةٍ تَرفُسُ المِنخاسَ!"<note caller="+" style="f"><char style="fr" closed="false">26‏.14 </char><char style="ft" closed="false">اقتبس السيد المسيح هنا المثل اليوناني القائل: "صعب أن ترفس مناخس"، وهي عبارة كانت تستعمل للدلالة على مَن كان يصارع القدر. وكان هذا المثل معروفا بين اليهود.</char></note> <verse eid="ACT 26:14" /><verse number="15" style="v" sid="ACT 26:15" />فسألتُهُ: "مَن أنتَ يا سَيِّدي؟" فأجابَني الصَّوتُ قائلاً: "أنا عيسى الّذي تَضطَهِدُهُ باضطِهادِكَ لأتباعي. <verse eid="ACT 26:15" /><verse number="16" style="v" sid="ACT 26:16" />قُم وقِفْ على قَدَمَيكَ، فما ظَهَرتُ لكَ إلاّ لأنّني اختَرتُكَ لتَخدِمَني، وتُخبِرَ النّاسَ بظُهوري الآنَ أمامَكَ وبما سأُبَيِّنُهُ لكَ فيما بَعدُ. <verse eid="ACT 26:16" /><verse number="17" style="v" sid="ACT 26:17" />وأقولُ لكَ إنّي سأحميكَ مِن شَعبِكَ اليَهودِ ومِن غَيرِهِم مِن الشُّعوبِ الّتي أُرسِلُكَ إليهِم، <verse eid="ACT 26:17" /><verse number="18" style="v" sid="ACT 26:18" />لتُنيرَ قُلوبَهُم قَبلَ عُيونِهِم، فتُخرِجَهُم بذلِكَ مِن الظُّلُماتِ إلى النُّور، ومِن سَطوةِ الشَّيطانِ إلى طاعةِ اللهِ، وعِندَما تُحَدِّثُهُم عنّي فسيُؤمنونَ بي، فيَغفِرَ اللهُ ذُنوبَهُم ويَمنَحَهُم نَصيبًا مَعَ عِبادِهِ الصّالحِينَ".<verse eid="ACT 26:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="ACT 26:19" />أيُّها المَلِكُ أَغريباسُ، لقدِ اختَرتُ الانصياعَ لهذِهِ الرِّسالةِ السّماويّة، <verse eid="ACT 26:19" /><verse number="20" style="v" sid="ACT 26:20" />فقُمتُ بنَشرِ الدَّعوةِ في دِمَشق، ومِنها إلى القُدسِ، ثُمّ طُفتُ مِنطقةَ يَهوذا بأكملِها، وخَرَجتُ بَعدَ ذلِكَ إلى الأجانبِ، مُبَلِّغًا الجَميعَ بأنّ عليهِم التّوبةَ والإنابةَ إلى اللهِ وتَرجَمةَ ذلِكَ في أعمالٍ تُبَرهِنُ على تَوبتِهِم النَّصوحِ. <verse eid="ACT 26:20" /><verse number="21" style="v" sid="ACT 26:21" />لهذا السَبَبِ، عَمَدَ اليَهودُ إلى القَبضِ عليّ عِندَما كُنتُ في الحَرَمِ الشَّريف، بهَدَفِ القَضاءِ عليَّ، <verse eid="ACT 26:21" /><verse number="22" style="v" sid="ACT 26:22" />إلاّ أنّ قُدرةَ اللهِ حَمَتني مِنهُم. وها أنا واقفٌ أمامَكُم الآنَ بتَمامِ العافيةِ. وإنّي لأدعو إلى هذِهِ الرِّسالةِ العَظيمةِ كُلَّ إنسانٍ مَهما كانَت عظَمَتُهُ أو بَساطتُهُ. وإنّي لم أخرُج عَمّا جاءَ بِهِ النّبيُّ موسى أو غيرُهُ منَ الأنبياءِ،<note caller="+" style="f"><char style="fr" closed="false">26‏.22 </char><char style="ft" closed="false">في هذا المقطع، يقدّم بولس البرهان الذي يُظهر أنّ الإيمان بسيدنا عيسى على أنه المسيح المنتظر جزء من الديانة اليهودية التي يسمح بها الرومان، وليس ديانة جديدة. فقد كان يُمنع منعا باتا التصريح بديانة جديدة دون إذن من السلطات الرومانية.</char></note> <verse eid="ACT 26:22" /><verse number="23" style="v" sid="ACT 26:23" />ومَفادُها أنّ قَدَرَ المَسيحِ (سلامُهُ علينا) أن يُقاسيَ الآلامَ، ثُمّ يَكونَ أوّلَ مَن يَبعَثُهُ اللهُ مِنَ المَوتِ حيًّا إلى الأبدِ، ليُبَشّرَ أُمَّتَهُ وباقي الأُمَمِ بالنُّور".<verse eid="ACT 26:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="ACT 26:24" />وما إن تَحَدَّثَ بولسُ عن قيامةِ سَيِّدِنا عيسى حتّى قاطَعَهُ فَستوسُ قائلاً: "لا بُدَّ أنّكَ تَهذي يا بولُسُ! فتَبَحُّرُكَ العَميقُ في العِلمِ أفقَدَكَ صَوابَكَ".<note caller="+" style="f"><char style="fr" closed="false">26‏.24 </char><char style="ft" closed="false">ربما كان يبدو منطق القيامة غريبًا وبربريًا بالنسبة إلى فستوس كروماني مثقّف، وبناءً على هذا اعتبر أنّ بولس كان يهذي.</char></note> <verse eid="ACT 26:24" /><verse number="25" style="v" sid="ACT 26:25" />فرَدَّ عليهِ بولُسُ قائلاً: "لَستُ أهذي يا صاحِبَ الفَخامةِ فَستوسُ، وما أقولُهُ هو عَينُ العَقلِ والصَّوابِ! <verse eid="ACT 26:25" /><verse number="26" style="v" sid="ACT 26:26" />فأنا على يَقينٍ بأنّ المَلِكَ قد اطلَّعَ على هذِهِ الأُمورِ، لأنّ ما حَدَثَ لم يَحدُث في الخَفاء! لذا أستَطيعُ التَّحَدُّثَ إليهِ بكُلِّ بَساطة". <verse eid="ACT 26:26" /><verse number="27" style="v" sid="ACT 26:27" />والتَفَتَ إلى المَلِكِ أَغريباسَ وقالَ: "أيُّها المَلِكُ أَغريباسُ، هل تؤمِنُ بما جاءَ بِهِ الأنبياءُ؟ إنّي مُتَيَقِّنٌ بذلِكَ". <verse eid="ACT 26:27" /><verse number="28" style="v" sid="ACT 26:28" />فأجابَهُ أغريباسُ الثّاني ساخِرًا: "لكأنّكَ تُحاوِلُ إقناعي أن أُصبِحَ مِن أنصارِ عيسى المَسيح بِيُسرٍ!" <verse eid="ACT 26:28" /><verse number="29" style="v" sid="ACT 26:29" />فأجابَهُ بولُسُ: "لَيسَ المُهِمُّ عُسرُ الجَهدِ أو يُسرُهُ لتُصبِحَ كذلك، فأنا أدعو اللهَ أن يُصبِحَ جَميعُ الحاضِرينَ مِثلي، ولكن طَبعًا دونَ أن تَكونَ أيديهِم مُكَبَّلةً بمِثلِ هذِهِ القُيودِ".<verse eid="ACT 26:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="ACT 26:30" />ثُمّ قامَ المَلِكُ والحاكِمُ وبِرنيسُ ومَن كانَ مَعَهُم، <verse eid="ACT 26:30" /><verse number="31" style="v" sid="ACT 26:31" />وتَرَكوا القاعةَ وهم يَتَحَدَّثونَ فيما بَينَهُم قائلينَ: "لم يَرتَكِبْ هذا الرَّجُلُ ذَنبًا يَستَحِقُّ عليهِ المَوتَ أو السَّجنَ". <verse eid="ACT 26:31" /><verse number="32" style="v" sid="ACT 26:32" />ثُمَّ التَفَتَ أغريباسُ الثّاني إلى فَستوسَ وقالَ: "كانَ مِن المُمكِنِ إطلاقُ سَراحِ هذا الرَّجُلِ، لو لم يَرفَعْ قَضيّتَهُ إلى القَيصرِ!"<verse eid="ACT 26:32" /></para>
  <chapter eid="ACT 26" />
  <chapter number="27" style="c" sid="ACT 27" />
  <para style="cl">الفصل السابع والعشرون</para>
  <para style="s">في الطريق إلى روما</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 27:1" />وبَعدَ التَّشاورِ، قَرَّرَ الحاكِمُ فَستوسُ إرسالَ بولُسَ مَعَ بَعضِ المَساجينِ إلى إيطاليا تَحتَ حِراسةِ الجُندِ بقيادةِ ضابِطٍ يَعمَلُ في كَتيبةِ القَيصرِ اسمُهُ يُوليوسُ. <verse eid="ACT 27:1" /><verse number="2" style="v" sid="ACT 27:2" />وصَعِدَ هؤلاءِ ومَعَهُم رِفاقُ بولُسَ، ومِن بَينِهِم أَرَسْتَرْكي المَقدونيّ مِن مَدينة تَسالونْكي على مَتنِ سَفينةٍ أتَت مِن ميناءِ أدْراميت كانَت على وَشَكِ الإبحارِ إلى بَعضِ المَوانِئ على شاطئِ مُقاطعةِ آسيا. <verse eid="ACT 27:2" /><verse number="3" style="v" sid="ACT 27:3" />وفي اليَومِ التّالي، وبَعدَ وُصُولِهِم إلى صَيدا، سَمَحَ يُوليوسُ الّذي كانَ يُعامِلُ بولُسَ مُعامَلةً حَسَنةً بأن يَزورَ أصدقاءَهُ ويَحصُلَ مِنهُم على ما يَحتاجُ إليهِ. <verse eid="ACT 27:3" /><verse number="4" style="v" sid="ACT 27:4" />ثُمَّ تابَعوا إبحارَهُم ثانيةً، وبسَبَبِ هُبوبِ ريحٍ مُعاكِسة، ظَلّوا مُبحِرينَ بمُحاذاةِ الشّواطئ الشّماليّة لجَزيرةِ قُبرُصَ، <verse eid="ACT 27:4" /><verse number="5" style="v" sid="ACT 27:5" />واتَّجَهوا قُربَ شَواطئ مُقاطعتَيْ كِليكيّة وبَمْفيليّة حتّى وَصَلوا إلى ميناءِ مِيرا في مُقاطَعةِ لِيكيّة، <verse eid="ACT 27:5" /><verse number="6" style="v" sid="ACT 27:6" />وعَلِمَ الضّابِطُ بوجودِ سَفينةٍ أُخرى مُقبِلةٍ مِنَ الإسكندريّة كانَت في طَريقِها إلى إيطاليا فصَعِدوا على مَتنِها وتابَعوا رِحلتَهُم. <verse eid="ACT 27:6" /><verse number="7" style="v" sid="ACT 27:7" />وقدِ استَغرَقَت رِحلتُهُم تِلكَ أيامًا لبُطءِ السَّفينةِ بسَبَبِ الرِّيحِ الّتي مَنَعَت مِنَ إرسائِها في ميناء كِنيدُسَ. ثُمَّ تابَعوا طَريقَهم بمُحاذاةِ شَواطئ جَزيرةِ كِرِيتَ وجاوَزوا مِنطقةَ سَلْمونة، <verse eid="ACT 27:7" /><verse number="8" style="v" sid="ACT 27:8" />ووَصَلوا بصُعوبةٍ إلى مَكانٍ اسمُهُ المَوانئ الحَسَنة بالقُربِ مِن مَدينةِ لَسائِيَة.<verse eid="ACT 27:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="ACT 27:9" />وتأخَّرَ المَوكبُ كَثيرًا في رِحلتِهِ لأنّ الإبحارَ خَطيرٌ، بسَبَبِ قُربِ حُلولِ مَوسِمِ العَواصِفِ الخَريفيّ الّذي يَلي انقِضاءَ عِيدِ الكَفّارةِ اليَهوديِّ. <verse eid="ACT 27:9" /><verse number="10" style="v" sid="ACT 27:10" />وأدرَكَ بولُسُ ذلِكَ فخاطَبَهُم مُنذِرًا: "أيُّها الرِّجالُ، إنّني لألمَحُ في سَفَرِنا هذا خَطَرًا وخَسارةً عَظيمةً، لا على السَّفينةِ وحُمولتِها فحَسبُ، بل على أرواحِنا أيضًا". <verse eid="ACT 27:10" /><verse number="11" style="v" sid="ACT 27:11" />إلاّ أنّ الضّابِطَ كانَ مُقتَنِعًا بكَلامِ قائِدِ السَّفينةِ وصاحِبِها، فلم يُعِر اهتمامًا لنُصْحِ بولُسَ. <verse eid="ACT 27:11" /><verse number="12" style="v" sid="ACT 27:12" />ولمّا لم يَكُن بالإمكانِ قَضاءُ فَصلِ الشِّتاءِ في ذلِكَ الميناءِ لأنّهُ مَكشوفٌ لرياحِ الشِّتاء، اتَّجَهَ قَرارُ الأغلَبيّةِ إلى مُتابعةِ السَّفَر، على أمَلِ الوُصُولِ إلى مَرفإ فينِكْسَ في كِرِيتَ لقَضاءِ الشِّتاءِ فيهِ لأنّ هذا المَرفأ يُطِلُّ على الجُنوبِ الغَربيِّ والشَّمالِ الغَربيِّ فقط.<verse eid="ACT 27:12" /></para>
  <para style="s">العاصفة</para>
  <para style="p">
    <verse number="13" style="v" sid="ACT 27:13" />وهَبَّت في المَوانئ الحَسَنة، رِياحٌ لَطيفةٌ مِنَ الجُنوبِ، فظَنَّ البَحّارةُ أنّ الأمرَ سيَقِفُ عِندَ ذلكَ الحَدِّ، فتابَعوا إبحارَهُم باتِّجاهِ الغَربِ بالقُربِ مِن ساحِلِ كِرِيتَ. <verse eid="ACT 27:13" /><verse number="14" style="v" sid="ACT 27:14" />وفَجأةً، هَبَّت عاصِفةٌ تُعرَفُ بالعاصِفةِ "الشّماليّة الشَّرقيّة" آتيةً مِن اتّجاهِ كِرِيتَ، <verse eid="ACT 27:14" /><verse number="15" style="v" sid="ACT 27:15" />ودَفَعَت بالسَّفينةِ إلى البَحرِ دونَ مُقاوَمةٍ، فاستَسلَمَ مَن كانَ على ظَهرِها دونَ أن يَعرِفوا وِجهتَهُم، <verse eid="ACT 27:15" /><verse number="16" style="v" sid="ACT 27:16" />ثُمَّ مَرّوا لاحِقًا بالقُربِ مِن جَزيرةٍ صَغيرةٍ اسمُها كُودا، حَيثُ تَمَكّنوا بصُعوبةٍ مِن تأمينِ قاربِ النَّجاةِ، <verse eid="ACT 27:16" /><verse number="17" style="v" sid="ACT 27:17" />فرَفَعوهُ إلى سَطحِ السَّفينةِ، ورَبَطوا الحِبالَ حَولهَا حِمايةً لها. وخافَ البَحّارةُ أن تَصطَدِمَ السَّفينةُ بتِلالِ سِرْتِسَ الرَّمليّةِ في قاعِ البَحرِ قُربَ السّاحلِ اللِّيبي، لذلِكَ عَمَدوا إلى إنزالِ شَراعِها وتَركِها تَنساقُ دونَ مُقاوَمةٍ. <verse eid="ACT 27:17" /><verse number="18" style="v" sid="ACT 27:18" />وفي اليَومِ التّالي أخَذَتِ العاصِفةُ تَشتَدُّ بشَكلٍ جَعَلَ البَحّارةَ يُخَفِّفونَ مِن حُمُولةِ السَّفينةِ برَميِ بَعضِ مُحتَوياتِها في البَحرِ. <verse eid="ACT 27:18" /><verse number="19" style="v" sid="ACT 27:19" />وفي اليومِ الثّالثِ، وَصَلَ الأمرُ بالبَحّارة إلى رَميِ بَعضِ مُعَدّاتِ السَّفينةِ. <verse eid="ACT 27:19" /><verse number="20" style="v" sid="ACT 27:20" />ومَضَت عِدَّةُ أيّامٍ بَعدَها لم يَكُن بمَقدورِ أحَدٍ رُؤيةُ الشَّمسِ ولا النُّجومِ، واستَمَرَّتِ العاصِفةُ عَنيفةً حتّى فَقَدَ الجَميعُ الأملَ بالنَّجاةِ.<verse eid="ACT 27:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="ACT 27:21" />وكانَ كُلُّ رُكّابِ السَّفينةِ قدِ امتَنَعوا عَن تَناوُلِ طَعامِهِم لفَترةٍ طَويلةٍ، فقامَ بولُسُ فيهِم خَطيبًا وقالَ: "أيُّها الرِّجالُ، كانَ عليكُم العَمَلُ بنَصيحتي عِندَما أشَرتُ عليكُم ألاّ تُغادِرُوا جَزيرةَ كِرِيتَ. ولو فَعَلتُم، لسَلِمتُم مِن هذِهِ الخَسارةِ وتَجاوَزتُم هذا الخَطَرَ. <verse eid="ACT 27:21" /><verse number="22" style="v" sid="ACT 27:22" />ولكنّي الآنَ أقولُ لكُم: تَشَجَّعوا فلن يَهلِك أحَدٌ مِنكُم، ولكنّ السَّفينةَ ستَتَحَطَّمُ. <verse eid="ACT 27:22" /><verse number="23" style="v" sid="ACT 27:23" />ففي اللّيلةِ الماضِية ظَهَرَ لي مَلاكٌ مِن اللهِ الّذي أنتَمي إليهِ وأعبُدُهُ، وقالَ لي مُطَمئنًا: <verse eid="ACT 27:23" /><verse number="24" style="v" sid="ACT 27:24" />"لا تَخَفْ يا بولُسُ، إنّهُ لا بُدَّ لكَ مِن الوُقوفِ أمامَ القَيصرِ، وقد حَفِظَ اللهُ حَياتَكَ وحَياةَ جَميعِ المُسافِرينَ مَعَكَ!" <verse eid="ACT 27:24" /><verse number="25" style="v" sid="ACT 27:25" />فاطمَئِنّوا جَميعًا أيُّها الرِّجالُ، لأنّي واثِقٌ أنّ اللهَ سيُحَقِّقُ وَعدَهُ، <verse eid="ACT 27:25" /><verse number="26" style="v" sid="ACT 27:26" />ولا بُدَّ أنّ سَفينتَنا ستَرتَطِمُ بإحدى الجُزُرِ".<verse eid="ACT 27:26" /></para>
  <para style="s">تحطّم السّفينة</para>
  <para style="p">
    <verse number="27" style="v" sid="ACT 27:27" />وفي اللَّيلةِ الرّابِعةَ عَشَرةَ، وبَينَما كانَت السَّفينةُ تُبحِرُ برُكّابِها في البَحرِ الأبيضِ المُتَوَسِّطِ والرِّيحُ تَضرِبُها في لُجَجِهِ، ظَنَّ البَحّارةُ عِندَ مُنتَصَفِ اللّيلِ أنّهُم أصبَحوا على مَقرُبةٍ مِنَ اليابِسةِ، <verse eid="ACT 27:27" /><verse number="28" style="v" sid="ACT 27:28" />فقاسوا عُمقَ الماءِ فوَجَدوا أنّ سَفينتَهُم على عُلوِّ أربَعينَ مِترًا مِنَ القاعِ، ثُمَّ كَرَّروا ذلِكَ بَعدَ قليلٍ فوَجَدوا أنّهُم أصبَحوا على عُلوِّ ثَلاثينَ مِترًا مِنَ القاعِ، <verse eid="ACT 27:28" /><verse number="29" style="v" sid="ACT 27:29" />فخافوا عِندئِذٍ منِ اصطِدامِ أسفَلِ السَّفينةِ بصُخورِ القاعِ، فعَمَدوا إلى إلقاءِ أربَعِ مَراسٍ عِندَ مؤخِّرةِ السَّفينةِ، راجينَ طُلوعَ الفَجرِ. <verse eid="ACT 27:29" /><verse number="30" style="v" sid="ACT 27:30" />وعِندئذٍ عَزَمَ البَحّارةُ على النَّجاةِ بأنفُسِهِم، فأنزَلوا قاربَ النَّجاةِ إلى سَطحِ البَحرِ زاعِمينَ أنّهُم يُريدونَ إلقاء المَراسي مِن جِهةِ مُقَدِّمةِ السَّفينةِ. <verse eid="ACT 27:30" /><verse number="31" style="v" sid="ACT 27:31" />إلاّ أنّ بولُسَ التَفَتَ إلى الضّابِطِ والجُنودِ قائلاً: "إن فَرَّ هؤلاءِ فلن يَكونَ لكُم أمَلٌ في النّجاةِ". <verse eid="ACT 27:31" /><verse number="32" style="v" sid="ACT 27:32" />فقامَ الجُنودُ بقَطعِ حِبالِ القاربِ وتَرَكوهُ يَهوي في الماءِ.<verse eid="ACT 27:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="ACT 27:33" />وقُبيلَ الفَجرِ، طَلَبَ بولُسُ مِن كُلِّ الرُّكّابِ تَناوُلَ الطَّعامِ قائلاً: "مَضى أُسبوعانِ ولم تَذوقوا طَعامًا لشِدّةِ خوفِكُم، <verse eid="ACT 27:33" /><verse number="34" style="v" sid="ACT 27:34" />وأنتُم بحاجةٍ إليهِ ليُقَوِّيَكُم وتُحافِظوا بِهِ على أنفُسِكُم. صَدِّقوني إن قُلتُ لكُم لن يَخسَرَ أحَدُكُم شَعرَةً مِن رأسِهِ". <verse eid="ACT 27:34" /><verse number="35" style="v" sid="ACT 27:35" />وبَعدَ قولِهِ هذا، قامَ بولُسُ بتَناوُلِ الخُبزِ شاكِرًا اللهَ أمامَ الجَميعِ، وقَسَّمَهُ وأكَلَ. <verse eid="ACT 27:35" /><verse number="36" style="v" sid="ACT 27:36" />فبَعَثَ ذلِكَ الطَّمأنينةَ في نُفوسِ الجَميعِ، وأخَذوا يَتَناولونَ الطَّعامَ. <verse eid="ACT 27:36" /><verse number="37‏-38" style="v" sid="ACT 27:37-38" />وبَعدَ أن شَبِعوا، رَمَوا بالقَمحِ في البَحرِ للتَّخفيفِ مِن وَزنِ السَّفينة، وكانَ عَدَدُ الرُّكّابِ مِئتينِ وسِتّةً وسَبعينَ شَخصًا.<verse eid="ACT 27:37-38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="ACT 27:39" />وعِندَ طُلوعِ الفَجرِ، لم يَستَطعِ البَحّارةُ تَمييزَ الشّاطئ الّذي لَمَحوهُ، إذ إنّهُم رأوا خَليجًا ذا ساحلٍ رَمليٍّ، فقَرَّروا دَفعَ السَّفينةِ إليهِ <verse eid="ACT 27:39" /><verse number="40" style="v" sid="ACT 27:40" />فقَطَعوا المَراسي وتَرَكوها تَسقُطُ في البَحرِ، وحَلّوا الحِبالَ الّتي تُمسِكُ بالدّفّةِ، ورَفَعوا الشِّراعَ الأماميَّ لتُوَجِّهَهُ الرِّيحُ نَحوَ الشَّاطئ. <verse eid="ACT 27:40" /><verse number="41" style="v" sid="ACT 27:41" />ولكنَّ السَّفينةَ اندَفَعَت مُصطدِمةً بتلٍّ رَمليٍّ، فانغَرَزَت مُقَدِّمتُها وبَقِيَت مُؤخِّرتُها في مَهَبِّ الأمواجِ العاتيةِ الّتي حَطَّمَتْها في النِّهاية.<verse eid="ACT 27:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="ACT 27:42" />وخَوفًا مِن هُروبِ المَساجينِ في تِلكَ الحالةِ، قَرَّرَ الجُنودُ قَتلَهُم، <verse eid="ACT 27:42" /><verse number="43" style="v" sid="ACT 27:43" />ولكنَّ الضّابِطَ يُوليوسَ أرادَ إنقاذَ بولُسَ، فحالَ دونَ تَنفيذِ إرادةِ الجُنودِ، وأمَرَ القادرينَ على السِّباحةِ بالقَفزِ للوُصولِ إلى البَرِّ، <verse eid="ACT 27:43" /><verse number="44" style="v" sid="ACT 27:44" />وغَيرَ القادِرينَ باستِخدامِ ألواحِ السَّفينةِ للنَّجاةِ. وهكذا، وَصَلَ الجَميعُ إلى الشَّاطئ بسَلامةٍ.<verse eid="ACT 27:44" /></para>
  <chapter eid="ACT 27" />
  <chapter number="28" style="c" sid="ACT 28" />
  <para style="cl">الفصل الثّامن والعشرون</para>
  <para style="s">في جزيرة مالطة</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 28:1" />وعِندَما بَلَغَ الجَميعُ اليابِسةَ عَرَفوا أنّهُم على شاطئ جَزيرةِ مالطَة. <verse eid="ACT 28:1" /><verse number="2" style="v" sid="ACT 28:2" />وكانَ أهلُها ذَوي مُرُوءةٍ إذِ استَقبَلوهُم أحسَنَ استِقبالٍ مُرَحِّبينَ بِهِم فأوقدوا لهُم نارًا ليَتَدَفّؤوا لأنّ الطَّقسَ كانَ مُمطِرًا وبارِدًا. <verse eid="ACT 28:2" /><verse number="3" style="v" sid="ACT 28:3" />وقامَ بولُسُ بجَمعِ بَعضِ الحَطَبِ لإشعالِ النّارِ، وإذا بحَيّةٍ انسَلَّت بفِعلِ الحَرارةِ وعَلِقَت بيَدِهِ. <verse eid="ACT 28:3" /><verse number="4" style="v" sid="ACT 28:4" />وعِندَما رأى الحاضِرونَ مِن سُكّانِ الجَزيرةِ ذلِكَ المَشهَدَ، أخَذوا يَتَحَدَّثونَ فيما بَينَهُم قائلينَ: "لا بُدَّ أن يَكونَ هذا الرَّجُلُ قد ارتَكَبَ جَريمةَ قَتلٍ، فهو وإن نَجا مِن عاصِفةِ البَحرِ، فلن يَنجو مِن يَدِ إلهِ العَدالةِ الّذي سيُنزِلُ بِهِ العُقوبةَ الآنَ!" <verse eid="ACT 28:4" /><verse number="5" style="v" sid="ACT 28:5" />إلاّ أنّ بولُسَ نَفَضَ يدَهُ فوَقَعَت الحيّةُ في النّارِ دونَ أن تَمَسَّهُ بأذىً. <verse eid="ACT 28:5" /><verse number="6" style="v" sid="ACT 28:6" />وقد كانَ الحاضِرونَ يَتَرَقّبونَ أن تَبدوَ على بولُسَ آثارُ أذى الحيّةِ، كتَوَرُّمِ جِسمِهِ أو سُقوطِهِ فَجأةً مَيتًا، لكن بَعدَ انتِظارٍ طَويلٍ تَبَدَّدَت شُكوكُهُم تِلكَ فلم يَبدُ على بولُسَ شَيءٌ مِمّا تَوَقَّعوهُ، فاعتَبروهُ إلهًا.<verse eid="ACT 28:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="ACT 28:7" />وكانَ بالقُربِ مِن هذا المَكانِ أراضٍ لبُوبْليوسَ حاكِمِ الجَزيرةِ الّذي استَضافَ رُكّابَ السَّفينةِ في دارِهِ، وأكرَمَهُم على مَدى ثَلاثةِ أيّامٍ. <verse eid="ACT 28:7" /><verse number="8" style="v" sid="ACT 28:8" />وصادَفَ أن كانَ والِدُ بُوبْليوسَ طَريحَ الفِراشِ بسَبَبِ حُمّى أصابَتْهُ وإسهالٍ، فزارَهُ بولُسُ وهُناكَ تَضَرَّعَ للهِ طالِبًا شِفاءَهُ واضعًا يَديهِ عليهِ فشُفي. <verse eid="ACT 28:8" /><verse number="9" style="v" sid="ACT 28:9" />وعِندَما حَدَثَ ذلِكَ، أخَذَ كُلُّ المَرضى في الجَزيرةِ يَتَوافدونَ عليهِ لنَيلِ الشِّفاءِ فنالوهُ، <verse eid="ACT 28:9" /><verse number="10" style="v" sid="ACT 28:10" />مِمّا جَعَلَ أهلَ الجَزيرةِ يُكَرِّمونَ بولُسَ ومَن كانَ بِرِفقتِهِ حتّى غادَروا الجَزيرةَ فزَوَّدوهُم بكُلِّ ما يَحتاجونَ إليهِ خِلالَ سَفَرِهِم.<verse eid="ACT 28:10" /></para>
  <para style="s">من مالطة إلى روما</para>
  <para style="p">
    <verse number="11" style="v" sid="ACT 28:11" />وبَعدَ مُضيّ ثَلاثةِ أشهُرٍ شَرَعوا في الإبحارِ على سَفينةٍ قادمةٍ مِن الإسكندريّةِ تَحمِلُ رَسمَ الجَوزاءِ، أي التَّوأمينِ، وكانَت راسيةً على شاطئ مالطة طَوالَ فَصلِ الشِّتاءِ. <verse eid="ACT 28:11" /><verse number="12" style="v" sid="ACT 28:12" />وأبحَروا فيها إلى مَدينةِ سِيراكِيُوسَ حَيثُ أمضَوا ثلاثةَ أيّامٍ. <verse eid="ACT 28:12" /><verse number="13" style="v" sid="ACT 28:13" />ثُمّ تابَعوا إبحارَهُم مِنها حتّى مَدينةِ رِيغيونَ. وفي اليومِ التّالي هَبَّت عليهِم رياحٌ جَنوبيّةٌ، فتابَعوا إبحارَهُم إلى أن بَلَغوا ميناءَ بُوطيولي في إيطاليا في اليَومِ الثّالثِ، <verse eid="ACT 28:13" /><verse number="14" style="v" sid="ACT 28:14" />فنَزَلوا مِن السّفينةِ، واجتَمَعوا هُناكَ ببَعضِ الإخوةِ مِن أتباعِ السّيِّدِ المَسيحِ الّذينَ طَلَبوا مِنهُم قَضاءَ أُسبوعٍ بَينَهُم. ثُمّ تَوَجَّهوا إلى روما سَيرًا على الأقدامِ، <verse eid="ACT 28:14" /><verse number="15" style="v" sid="ACT 28:15" />وفي مَسيرتِهِم تِلكَ وَجَدوا بَعضَ المؤمنينَ الّذينَ قد عَلِموا بوصولِهِم، فخَرَجوا مِن روما لاستِقبالِهِم في سُوقِ أَبيُوسَ وفي بَلدةِ الخاناتِ الثّلاثة. وعِندَما رآهُم بولُسُ قَوِيَت عَزيمَتُهُ وشَكَرَ اللهَ على كُلِّ شَيءٍ. <verse eid="ACT 28:15" /><verse number="16" style="v" sid="ACT 28:16" />وعِندَ وُصولِهِم إلى روما، سَمَحَ الضّابِطُ لبولُسَ أن يَستأجِرَ بَيتًا ليُقيمَ فيهِ مَعَ جُنديٍّ واحدٍ يَحرُسُهُ.<verse eid="ACT 28:16" /></para>
  <para style="s">في روما</para>
  <para style="p">
    <verse number="17" style="v" sid="ACT 28:17" />وبَعدَ مُضيّ ثلاثةِ أيّامٍ على إقامةِ بولُسَ والجُنديَّ في ذلِكَ البَيتِ، استَدعى بولُسُ مَشايخَ يَهودِ روما،<note caller="+" style="f"><char style="fr" closed="false">28‏.17 </char><char style="ft" closed="false">أُلغيَ في هذا الوقت تحديدًا أمر القيصر كلوديوس المذكور سابقا في سيرة الحواريين 18: 2، ورجع بعض اليهود إلى روما. </char></note> وخاطَبَهُم قائلاً: "يا إخوتي مِن بَني يَعقوبَ، إنّني لم أرتَكِب جُرمًا ضِدَّ شَعبِنا أو ضِدَّ مُعتقداتِ آبائِنا، ورَغمَ ذلِكَ قامَ بَعضُ النّاسِ بالقَبضِ عليَّ في القُدسِ وسَلَّموني إلى الرُّومانيّينَ، <verse eid="ACT 28:17" /><verse number="18" style="v" sid="ACT 28:18" />فأجرَوا مَعي تَحقيقًا ووَجَدوني بَريئًا مِن أيّ تُهمةٍ أستَحِقُّ عليها المَوتَ. <verse eid="ACT 28:18" /><verse number="19" style="v" sid="ACT 28:19" />فقَرَّروا إطلاقَ سَراحي، ولمّا عارَضَ اليَهودُ ذلِكَ، قَرَّرتُ رَفعَ قَضيّتي إلى القَيصرِ. ولم يَكُن هَدَفي اتّهامَ بَني قَومي. <verse eid="ACT 28:19" /><verse number="20" style="v" sid="ACT 28:20" />ولهذا السَّبَبِ أرسَلتُ في طَلَبِكُم لأُبَيِّنَ لكُم الأمرَ جَليًّا، فإنّي إنّما قُيِّدتُ بسَلاسِلَ لأنّي مؤمنٌ بالمَسيحِ المُنتَظَرِ الّذي يَرتَجي بَنو يَعقوبَ ظُهورَهُ". <verse eid="ACT 28:20" /><verse number="21" style="v" sid="ACT 28:21" />فأجابوهُ قائلينَ: "لم تَصِلنا بخُصوصِكَ أيُّ رِسالةٍ مِن مِنطقةِ يَهوذا، ومَن جاؤوا مِن إخوانِنا اليَهودِ مِن هُناكَ لم يُخبِرونا بسُوءٍ عَنكَ، <verse eid="ACT 28:21" /><verse number="22" style="v" sid="ACT 28:22" />ولكنّنا نَرغَبُ في سَماعِ مُعتَقداتِكَ، فالنّاسُ في كُلِّ مَكانٍ يَنتقِدونَ مَذهبَكَ وجَماعتَكَ".<verse eid="ACT 28:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="ACT 28:23" />واتّفَقوا على اللِقاءِ في يومٍ مُعَيّنٍ. وكانَ مَكانُ اللِقاءِ مَنزلَ بولُسَ حَيثُ وَفَدوا بِرِفقةِ مَجموعةٍ أُخرى. واستَمَرَّت جَلسَتُهُم مِن الصَّباحِ إلى المَساءِ، كانَ بولُسُ أثناءَها يُحَدِّثُهُم ويُبَيِّنُ لهُم الحَقائقَ المُرتَبِطةَ بمَملكةِ اللهِ المَوعودة. وحاوَلَ أثناءَها إقناعَهُم أن عيسى (سلامُهُ علينا) هو المُنقِذُ المَوعودُ، مُستَشهِدًا في كُلِّ ذلِكَ بما جاءَ في تَوراةِ موسى وغَيرِها مِن كُتُبِ الأنبياء. <verse eid="ACT 28:23" /><verse number="24" style="v" sid="ACT 28:24" />واقتَنَعَ بَعضُهُم بكَلامِهِ بَينَما رَفَضَهُ الآخَرونَ. <verse eid="ACT 28:24" /><verse number="25" style="v" sid="ACT 28:25" />وحَدَثَ خِلافٌ بَينَهُم حَولَ هذا المَوضوعِ، وعِندَما بَدَؤوا يَنصَرِفونَ قالَ لهُم بولُسُ: "صَدَقَ وَحيُ رُوحِ اللهِ في ما قالَ عنكُم وعن آبائِكُم سَواءٌ بسَواء، والّذي جاءَ على لِسانِ النّبيِّ أشعيا: <verse eid="ACT 28:25" /><verse number="26" style="v" sid="ACT 28:26" />"اِذهَب إلى شَعبِ بَني يَعقوبَ وقُل لهُم: لقد سَمِعتُم رِسالةَ اللهِ ولكنّكُم لا تَفهَمونَ، وشاهَدتُم أعمالَهُ ولكنّكُم لا تَفقَهونَ، <verse eid="ACT 28:26" /><verse number="27" style="v" sid="ACT 28:27" />فإنّ عُقولَ أبناءِ هذا الشّعبِ مُتَكَلِّسة وقد صَمّوا آذانَهُم وأعمَوا بَصائرَهُم، حتّى لا يَسمَعوا رِسالتي ويَفهَموها فيَرجِعوا إليّ، فأَشفيَهُم". <verse eid="ACT 28:27" /><verse number="28" style="v" sid="ACT 28:28" />واعلَموا أنّهُ بسَبَبِ رَفضِكُم لرِسالةِ النّجاةِ هذِهِ، أمَرَنا اللهُ تَعالى بدَعوةِ غَيرِكُم مِن الأُممِ إليها، وهم لها مُستَجيبونَ طائعونَ". <verse eid="ACT 28:28" /><verse number="29" style="v" sid="ACT 28:29" />وبَعدَ انتهائِهِ مِن الكَلامِ انصَرَفَ اليَهودُ مِن عِندِهِ وقد ثارَت فيما بَينَهُم مُناقَشاتٌ حادّةٌ حَولَ كُلِّ ما ذَكَرَهُ. <verse eid="ACT 28:29" /><verse number="30" style="v" sid="ACT 28:30" />وهكذا ظَلَّ بولُسُ مُقيمًا في روما سَنتَينِ كاملتَينِ في المَنزِلِ الّذي استأجَرَهُ.<note caller="+" style="f"><char style="fr" closed="false">28‏.30 </char><char style="ft" closed="false">في حال لم يأتِ المشتكون أو لم تُسجّل التُّهَم خلال سنتين، يُطلِق الإجراء الروماني سراح المتّهم. وبعد أن أُطلق سراح بولس، يبدو أنّه سافر إلى أماكن شتّى بما فيها كريت وتركيا واليونان وربما إسبانيا أيضًا. ويبدو أنّ بولس كتب بعض رسائله في تلك الفترة من حياته. وبحسب التقليد أعيد سجن بولس، ومن ثمّ قُطِع رأسه. ولكن لوقا أراد أن يبيّن لنا في نهاية سِفْره أنّ رسالة بولس كانت مقبولة ولم تتعارض مع القوانين الرومانية. </char></note> وقد فَتَحَهُ في وَجهِ كُلِّ مَن يَرغَبُ في زيارتِهِ. <verse eid="ACT 28:30" /><verse number="31" style="v" sid="ACT 28:31" />وكانَ خِلالَ تِلكَ الفَترةِ يُعلِنُ قيامَ مَملكةِ اللهِ المَوعودةِ بِجُرأةٍ، دونَ مُعارَضةٍ مِن أحَدٍ، مُتابِعًا تَعليمَهُ للنّاسِ عن سَيِّدِنا عيسى المَسيحِ (سلامُهُ علينا).<verse eid="ACT 28:31" /></para>
  <chapter eid="ACT 28" />
</usx>