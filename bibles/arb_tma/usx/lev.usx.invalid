<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="LEV" style="id">- True Meaning Arabic</book>
  <para style="toc3">قصّة النبيّ موسى – من اللاويين</para>
  <para style="toc2">قصّة النبيّ موسى – من اللاويين</para>
  <para style="toc1">قصّة النبيّ موسى – من اللاويين</para>
  <para style="mt1">قصّة النبيّ موسى – من اللاويين</para>
  <chapter number="1" style="c" sid="LEV 1" />
  <chapter eid="LEV 1" />
  <chapter number="2" style="c" sid="LEV 2" />
  <chapter eid="LEV 2" />
  <chapter number="3" style="c" sid="LEV 3" />
  <chapter eid="LEV 3" />
  <chapter number="4" style="c" sid="LEV 4" />
  <para style="ms3">بسم الله تبارك وتعالى</para>
  <para style="s">ذبيحة الخطيئة سهوا</para>
  <para style="p">
    <verse number="1" style="v" sid="LEV 4:1" />وأوحى الله إلى النبي موسى (عليه السّلام): <verse eid="LEV 4:1" /><verse number="2" style="v" sid="LEV 4:2" />"يا موسى قُل لبني يعقوب إن اقترفوا ذنبا سهوا فإنّهم يستحقّون العقاب، وعليهم أن يكفّروا عمّا اقترفوه. <verse eid="LEV 4:2" /><verse number="3" style="v" sid="LEV 4:3" />فإن أخطأ كبير الأحبار، فذنبه على كلّ بني يعقوب، ليذبح عجلا لا عيب فيه قربانا له تعالى وبه يستغفر. <verse eid="LEV 4:3" /><verse number="4" style="v" sid="LEV 4:4" />وليذهب إلى باب خيمة بيت الله ومعه العجل. وفي حرم بيت الله أمام المحراب حيث تجلّيات الله يضع يده على رأس العجل ثمّ يذبحه. <verse eid="LEV 4:4" /><verse number="5" style="v" sid="LEV 4:5" />وليأخذ من دمه المسفوح وليدخل به خيمة بيت الله، <verse eid="LEV 4:5" /><verse number="6" style="v" sid="LEV 4:6" />وهناك يغمس فيه إصبعه ويرشّ منه سبع مرّات عند الستار أمام المحراب حيث تجلّيات الله. <verse eid="LEV 4:6" /><verse number="7" style="v" sid="LEV 4:7" />ثمّ يضع من دم القربان على أركان موقد البخور في المحراب حيث تجلّيات الله. وبعد ذلك يسكب كلّ دم العجل عند قاعدة المذبح الموجود عند باب خيمة بيت الله. <verse eid="LEV 4:7" /><verse number="8" style="v" sid="LEV 4:8" />ولينزع من هذا القربان شحمه: ذاك الّذي يغطّي الأمعاء، <verse eid="LEV 4:8" /><verse number="9" style="v" sid="LEV 4:9" />وما يحمي الكليتَين والخاصرتَين، والكبد بعد نزع زيادته، <verse eid="LEV 4:9" /><verse number="10" style="v" sid="LEV 4:10" />وطريقة نزع الشحم عن هذه الذبيحة يجب أن تكون كطريقة نزعه عن ذبيحة التقارب والمصالحة فيما بينكم. ثمّ على كبير الأحبار أن يحرق ما نزع من شحم على المذبح قربانًا لله. <verse eid="LEV 4:10" /><verse number="11‏-12" style="v" sid="LEV 4:11-12" />ثمّ ليحمل إلى خارج المخيّم لحم العجل وجلده ورأسه وأكارعه وأمعاءه بما فيها، إلى موضع طاهر وتحرق كلّها على حطب حيث يُطرح رماد قربان الشحم.<verse eid="LEV 4:11-12" /></para>
  <para style="s">ذبيحة التكفير عن الجماعة</para>
  <para style="p">
    <verse number="13" style="v" sid="LEV 4:13" />"وإن خالفت جماعة بني يعقوب أحد أوامر الله سهوًا، فإنّ أفرادها جميعا يستحقّون العقاب، <verse eid="LEV 4:13" /><verse number="14" style="v" sid="LEV 4:14" />وحين يكتشفون خطيئتهم، عليهم أن يكفّروا عنها ويقدّموا عجلاً أضحية لله، أمام خيمة بيت الله قربانا له تعالى وبه يستغفرون. <verse eid="LEV 4:14" /><verse number="15" style="v" sid="LEV 4:15" />فيضع شيوخ القوم أيديهم على رأس العجل وإيّاه في الحرم المقدّس يذبحون. <verse eid="LEV 4:15" /><verse number="16" style="v" sid="LEV 4:16" />وليأخذ كبير الأحبار من دمه ويدخل به إلى خيمة بيت الله، <verse eid="LEV 4:16" /><verse number="17" style="v" sid="LEV 4:17" />فيغمس فيه إصبعه ويرشّ منه سبع مرّات عند الستار أمام المحراب المقدّس حيث تجلّيات الله. <verse eid="LEV 4:17" /><verse number="18" style="v" sid="LEV 4:18" />ويضع منه على أركان موقد البخور في المحراب حيث تجلّيات الله، ويسكب بقيّة الدم عند قاعدة المذبح قُرب باب الخيمة <verse eid="LEV 4:18" /><verse number="19" style="v" sid="LEV 4:19" />ولينزع كلّ شحم الأضحية وليحرقه على المذبح، <verse eid="LEV 4:19" /><verse number="20" style="v" sid="LEV 4:20" />وليفعل بعجل خطيئتهم ما فعله بعجل التكفير عن خطيئته. كذلك يغفر الله ذنبهم حين يقوم كبير الأحبار بكلّ هذه الشعائر ويكفّر عن خطيئة قومه، فيغفر الله لهم. <verse eid="LEV 4:20" /><verse number="21" style="v" sid="LEV 4:21" />وليحمل ما تبقّى من العجل خارج المخيّم وليحرقه كما أحرق ما تبقّى من العجل الّذي ذبحه تكفيرًا عن خطيئته. كذلك تكون هذه الذبيحة تكفيرًا عن خطيئة جميع القوم.<verse eid="LEV 4:21" /></para>
  <para style="s">ذبيحة التكفير عن القادة</para>
  <para style="p">
    <verse number="22" style="v" sid="LEV 4:22" />وإن خالف أحد قادة بني يعقوب أحد أوامر الله سهوًا، فإنّه يستحق العقاب. <verse eid="LEV 4:22" /><verse number="23" style="v" sid="LEV 4:23" />وحين يعلم بالخطيئة الّتي اقترفها، فليأت بتيس لا عيب فيه وليقدّمه أضحية لله. <verse eid="LEV 4:23" /><verse number="24" style="v" sid="LEV 4:24" />وليضع يده على رأس التيس وليذبحه في المكان الّذي تُذبح فيه الأضاحي وتُحرق لله، كذلك يكفّر عن خطيئته. <verse eid="LEV 4:24" /><verse number="25" style="v" sid="LEV 4:25" />وليغمس الحَبر إصبعه في دم الذبيحة وليضعه على أركان مذبح الأضاحي، وليسكب بقيّة الدم عند قاعدة المذبح. <verse eid="LEV 4:25" /><verse number="26" style="v" sid="LEV 4:26" />وليحرق كل شحم الأضحية على المذبح، كما يفعل بشحم ما يقدّم لله من الذبائح للتقارب والمصالحة فيما بينكم. كذلك يكفّر الحَبر عن القائد فيغفر الله ذنبه.<verse eid="LEV 4:26" /></para>
  <para style="s">ذبيحة التكفير عن فرد من عامّة الناس</para>
  <para style="p">
    <verse number="27" style="v" sid="LEV 4:27" />أوحى الله إلى النبي موسى (عليه السلام): "إن خالف أحد من عامّة الناس أحد أوامر الله سهوًا، فإنّه يستحق العقاب، <verse eid="LEV 4:27" /><verse number="28" style="v" sid="LEV 4:28" />وحين يكتشف الخطيئة الّتي اقترفها، فليذبح عنزة لا عيب فيها وليقدّمها أضحية لله. <verse eid="LEV 4:28" /><verse number="29" style="v" sid="LEV 4:29" />وليضع يده على رأسها وليذبحها في المكان الّذي تُذبح فيه الأضاحي لله وتُحرق. <verse eid="LEV 4:29" /><verse number="30" style="v" sid="LEV 4:30" />وليغمس الحَبر إصبعه في دمها وليضع منه على أركان المذبح، ويسكب بقيّة الدم عند قاعدته. <verse eid="LEV 4:30" /><verse number="31" style="v" sid="LEV 4:31" />وليحرق شحم الأضحية على المذبح أضحيةً يرضى بها الله، كما يفعل بشحم ما يقدّم لله من الذبائح للتقارب والمصالحة فيما بينكم. كذلك يكفّر الحَبر عن الفرد من عامّة الشعب فيغفر الله ذنبه. <verse eid="LEV 4:31" /><verse number="32" style="v" sid="LEV 4:32" />وإن أراد أحد أن يقدّم من الضأن للتكفير عن خطيئته، فلتكن أنثى لا عيب فيها. <verse eid="LEV 4:32" /><verse number="33" style="v" sid="LEV 4:33" />وليضع يده على رأسها وليذبحها في المكان الذي تُذبح فيه الأضاحي لله وتُحرق، <verse eid="LEV 4:33" /><verse number="34" style="v" sid="LEV 4:34" />وليغمس الحَبر إصبعه في دم الذبيحة وليضع منه على أركان المذبح، ويسكب ما تبقّى منه عند قاعدته. <verse eid="LEV 4:34" /><verse number="35" style="v" sid="LEV 4:35" />وعليه أن يحرق كلّ شحمها على المذبح مع بقيّة ذبائح ذلك اليوم، ويُفعل بهذه الذبيحة كما يُفعل بالذبائح الّتي تُقدَّم لله للتقارب والمصالحة فيما بينكم. كذلك يكفّر الحَبر عن الفرد من عامّة الشعب فيغفر الله ذنبه.<verse eid="LEV 4:35" /></para>
  <chapter eid="LEV 4" />
  <chapter number="5" style="c" sid="LEV 5" />
  <para style="s">ذبيحة التكفير عن المذنبين</para>
  <para style="p">
    <verse number="14" style="v" sid="LEV 5:14" />وأوحى الله إلى موسى (عليه السلام): <verse eid="LEV 5:14" /><verse number="17" style="v" sid="LEV 5:17" />إن أخطأ أحد منكم فاعلا ما حرّمه الله، حتّى وإن ارتكبه سهوا، فهو مذنب ويجب أن يُعاقب حتما. <verse eid="LEV 5:17" /><verse number="18" style="v" sid="LEV 5:18" />فعليه أن يأتي إلى الحبر بكبشٍ بلا عيب أو بمقدار قيمته، ويكفّر الحَبر عن الشخص الذي اركتب الخطيئة سهوا بذبح هذا الكبش، فيغفر الله ذنبه. <verse eid="LEV 5:18" /><verse number="19" style="v" sid="LEV 5:19" />إنّ هذه الذبيحة هي تكفيرا عن ذنب المذنبين بحق الله.<note caller="+" style="f"><char style="fr" closed="false">5‏.19 </char><char style="ft" closed="false">انظر سورة السجدة: 24.</char></note><verse eid="LEV 5:19" /></para>
  <chapter eid="LEV 5" />
  <chapter number="6" style="c" sid="LEV 6" />
  <chapter eid="LEV 6" />
  <chapter number="7" style="c" sid="LEV 7" />
  <chapter eid="LEV 7" />
  <chapter number="8" style="c" sid="LEV 8" />
  <chapter eid="LEV 8" />
  <chapter number="9" style="c" sid="LEV 9" />
  <chapter eid="LEV 9" />
  <chapter number="10" style="c" sid="LEV 10" />
  <chapter eid="LEV 10" />
  <chapter number="11" style="c" sid="LEV 11" />
  <chapter eid="LEV 11" />
  <chapter number="12" style="c" sid="LEV 12" />
  <chapter eid="LEV 12" />
  <chapter number="13" style="c" sid="LEV 13" />
  <chapter eid="LEV 13" />
  <chapter number="14" style="c" sid="LEV 14" />
  <chapter eid="LEV 14" />
  <chapter number="15" style="c" sid="LEV 15" />
  <chapter eid="LEV 15" />
  <chapter number="16" style="c" sid="LEV 16" />
  <para style="s">يوم الكفارة</para>
  <para style="p">
    <verse number="1" style="v" sid="LEV 16:1" />وبعد هلاك ابنَي هارون، حينما خالفا مراحل ما يقدّم لله من قرابين، أوحى الله إلى النبي موسى: <verse eid="LEV 16:1" /><verse number="2" style="v" sid="LEV 16:2" />"يا موسى، حذّر أخاك هارون من أن يتجاوز الستار ويدخل المحراب المقدّس ساعة يشاء، إنّ في ذلك موته الأكيد، لأنّي سأتجلّى هناك في السّحاب فوق غطاء صندوق الميثاق. <verse eid="LEV 16:2" /><verse number="3" style="v" sid="LEV 16:3" />وحين يدخل هارون المحراب ليكفّر عن خطيئته، فليتّبع هذه التعاليم: ليذبَحْ عجلاً يكفّر به عن ذنبه وليذبح كبشًا ويحرقه كاملا إكرامًا لي. <verse eid="LEV 16:3" /><verse number="4" style="v" sid="LEV 16:4" />وليغتسل قبل أن يرتدي ثيابا مقدّسة من كتان: قميصا، وسروالا يتوسطه حزام، وليضع على رأسه عمامة. <verse eid="LEV 16:4" /><verse number="5" style="v" sid="LEV 16:5" />ثمّ يحمل من جماعة بني يعقوب تيسين، فليذبح أحدهما تكفيرًا عن الخطيئة وليحرق كَبشًا كاملا إكرامًا لي. <verse eid="LEV 16:5" /><verse number="6" style="v" sid="LEV 16:6" />وعليه أن يذبح عجلاً ويقدّمه لي تكفيرًا عن نفسه وعن أهل بيته <verse eid="LEV 16:6" /><verse number="7" style="v" sid="LEV 16:7" />وليأخُذ التّيسَين إلى باب خيمة بيت الله <verse eid="LEV 16:7" /><verse number="8" style="v" sid="LEV 16:8" />وليلق عليهما قرعةً ليرى أيّ منهما يكون قربانًا لله وأيّا منهما يحمل خطايا القوم إلى صحراء عَزازيل. <verse eid="LEV 16:8" /><verse number="9" style="v" sid="LEV 16:9" />فليقدّمْ هارون التيس الّذي اُختير ليكون ذبيحة لله، <verse eid="LEV 16:9" /><verse number="10" style="v" sid="LEV 16:10" />أمّا التيس الّذي اُختير ليحمل خطايا بني يعقوب، فيقدَّم لله حيّا، وليُطلق بعيدا في الصحراء فداء للجميع.<verse eid="LEV 16:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="LEV 16:11" />وعلى هارون أن يذبح عجل التكفير عن نفسه وعن أهل بيته، <verse eid="LEV 16:11" /><verse number="12" style="v" sid="LEV 16:12" />وأن يملأ المِبخرة بجمر من موقد البخور في المحراب المقدّس، كما يملأُ راحتَيه بخورا عطرا ناعما وليدخل به إلى المحراب الأقدس وراء الستار. <verse eid="LEV 16:12" /><verse number="13" style="v" sid="LEV 16:13" />وليضع البخور في المبخرة حتّى يُغطّي دخانه غطاء صندوق الميثاق حيث تجلّيات الله. فإن اتّبع أخوك كلّ هذه التعاليم فلن يموت. <verse eid="LEV 16:13" /><verse number="14" style="v" sid="LEV 16:14" />وعليه أن يأخذ من دم العجل، ويرشّ بإصبعه سبع مرّات فيقع من الدم قطرات على غطاء صندوق الميثاق وأمامه.<verse eid="LEV 16:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="LEV 16:15" />"وليذبح هارون بعد ذلك التيس الأوّل تكفيرًا عن خطايا قومه، ويحمل دمه إلى المحراب الأقدس وراء الستار ويرشّ منه على الغطاء وأمامه، كما فعل بدم العجل. <verse eid="LEV 16:15" /><verse number="16" style="v" sid="LEV 16:16" />كذلك يُطَهَّر المحراب الأقدس وبقيّة خيمة بيت الله من نجاسة بني يعقوب ومعاصيهم. <verse eid="LEV 16:16" /><verse number="17" style="v" sid="LEV 16:17" />وإذا دخل هارون المحراب الأقدس، فلا يُسمح لأحد بدخول خيمة بيت الله، حتّى يخرج منها. أجل، لا يدخل أحد إلى حين خروجه منها. <verse eid="LEV 16:17" /><verse number="18" style="v" sid="LEV 16:18" />وليتّجه هارون إلى مذبح الأضاحي خارج الخيمة وليأخذ من دم العجل ودم التيس ويضع منه على أركان المذبح من كلّ جهة ليطهّره. <verse eid="LEV 16:18" /><verse number="19" style="v" sid="LEV 16:19" />وليرشّه بإصبعه بالدم سبع مرّات، ويخلّصه من نجاسة بني يعقوب فيصبح طاهرا مقدّسا. <verse eid="LEV 16:19" /><verse number="20‏-21" style="v" sid="LEV 16:20-21" />وحينما يفرغ هارون من تطهير المحراب الأقدس، والمذبح وبقيّة خيمة بيت الله، عليه أن يضع يديه على رأس التيس الّذي تركه حيًّا وليعترف بجميع آثام بني يعقوب ومعاصيهم، كذلك تنقل الآثام والمعاصي إلى رأس التيس ثمّ يُكَلّف رجلا ليطلقه في الصحراء. <verse eid="LEV 16:20-21" /><verse number="22" style="v" sid="LEV 16:22" />فيحمل التيس معه كلّ ذنوب بني يعقوب إلى مكان بعيد.<verse eid="LEV 16:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="LEV 16:23" />"وحين يعود هارون إلى خيمة بيت الله، عليه أن ينزع ثياب الكتان الّتي لبسها عند دخوله المحراب الأقدس، ويتركها هناك. <verse eid="LEV 16:23" /><verse number="24" style="v" sid="LEV 16:24" />وليغتسل في مكان مقدّس وليلبس ثيابه العادية ويخرج، ويقدم ذبيحة لله ويحرقها كاملة من أجل نفسه، وليذبح أخرى ويحرقها كاملة من أجل قومه، فيكفّر الخطايا عن نفسه وقومه. <verse eid="LEV 16:24" /><verse number="25" style="v" sid="LEV 16:25" />وليحرق شحم ذبيحة الكفّارة على المذبح. <verse eid="LEV 16:25" /><verse number="26" style="v" sid="LEV 16:26" />أمّا الرجل الّذي أطلق التيس في صحراء عَزازيل فعليه أن يغسل ثيابه ويغتسل عند عودته، حتّى يدخل المخيّم. <verse eid="LEV 16:26" /><verse number="27" style="v" sid="LEV 16:27" />وأمّا العجل والتيس اللّذان ذبحهما هارون تكفيرًا عن الخطايا ودخل بدمهما إلى المحراب الأقدس ليقوم بشعيرة التطهير، فليؤخذ ما تبقّى من لحمهما إلى خارج المخيّم فيُحرق مع جلودهما ورَوثهما. <verse eid="LEV 16:27" /><verse number="28" style="v" sid="LEV 16:28" />وعلى القائم بهذه العملية أن يغسل ثيابه ويغتسل بالماء حتّى يدخل إلى المخيّم من جديد.<verse eid="LEV 16:28" /></para>
  <para style="s">فريضة يوم الكفارة</para>
  <para style="p">
    <verse number="29" style="v" sid="LEV 16:29" />"ولقد كتبنا عليكم في اليوم العاشر من الشهر السابع التزهد والصيام والانقطاع عن العمل، وسواء في هذا الأمر: الأصيل منكم والغريب والدخيل. إنّ هذا عليكم فريضة أبديّة <verse eid="LEV 16:29" /><verse number="30" style="v" sid="LEV 16:30" />وفي هذا اليوم يكفّر عن ذنوبكم فيطهّركم الله مِن المعاصي. <verse eid="LEV 16:30" /><verse number="31" style="v" sid="LEV 16:31" />إنّ هذا العيد كيوم السبت تنعمون فيه بالراحة التامّة، فيه تتزهدون وتصومون فريضة عليكم أبديّة. <verse eid="LEV 16:31" /><verse number="32" style="v" sid="LEV 16:32" />وليؤدّينّ هذه الشعيرة في مستقبل الأيّام كبير الأحبار الذي يكون خليفة هارون، فليلبس ثياب الكَتّان المقدّسة حتّى يكفّر عنكم <verse eid="LEV 16:32" /><verse number="33" style="v" sid="LEV 16:33" />وحتّى يطهّر المحراب الأقدس وخيمة بيت الله والمذبح والأحبار وسائر القوم. <verse eid="LEV 16:33" /><verse number="34" style="v" sid="LEV 16:34" />إنّ هذا فريضة عليكم أبديّة تؤدونها مرّةً في السنة". واتّبع النبي موسى كلّ هذه الوصايا كما أمره الله.<verse eid="LEV 16:34" /></para>
  <chapter eid="LEV 16" />
  <chapter number="17" style="c" sid="LEV 17" />
  <chapter eid="LEV 17" />
  <chapter number="18" style="c" sid="LEV 18" />
  <chapter eid="LEV 18" />
  <chapter number="19" style="c" sid="LEV 19" />
  <chapter eid="LEV 19" />
  <chapter number="20" style="c" sid="LEV 20" />
  <chapter eid="LEV 20" />
  <chapter number="21" style="c" sid="LEV 21" />
  <chapter eid="LEV 21" />
  <chapter number="22" style="c" sid="LEV 22" />
  <chapter eid="LEV 22" />
  <chapter number="23" style="c" sid="LEV 23" />
  <para style="s">المواسم والأعياد</para>
  <para style="p">
    <verse number="1" style="v" sid="LEV 23:1" />وأوحى الله إلى النبي موسى: <verse eid="LEV 23:1" /><verse number="2" style="v" sid="LEV 23:2" />"يا موسى أخبر بني يعقوب بكل التعاليم التي تتعلق بالأعياد، إنّها أيام مقدّسة فيها تجتمعون وبها تحتفلون. <verse eid="LEV 23:2" /><verse number="3" style="v" sid="LEV 23:3" />ستّة أيّام في الأسبوع فيها تعملون، واليوم السّابع لي، فيه تقومون بالاجتماعات الدينية، فلا يجوز لكم فيه أن تعملوا في جميع أنحاء بلادكم.<verse eid="LEV 23:3" /></para>
  <para style="s">عيدي الفصح والفطير</para>
  <para style="p">
    <verse number="4" style="v" sid="LEV 23:4" />واحتفلوا مع السبت بالأعياد التالية في مواعيدها: <verse eid="LEV 23:4" /><verse number="5" style="v" sid="LEV 23:5" />احتفلوا بعيد الفصح مساء اليوم الرّابع عشر من الشهر الأوّل إكرامًا لي. <verse eid="LEV 23:5" /><verse number="6" style="v" sid="LEV 23:6" />واحتفلوا بعيد الفطير في اليوم الموالي سبعة أيّام فيها تأكلون خبزًا بلا خمير. <verse eid="LEV 23:6" /><verse number="7‏-8" style="v" sid="LEV 23:7-8" />ولتجتمعوا في اليوم الأوّل والسابع للعبادة وامتنعوا عن أي عمل. وخلال أيامه السبعة قدّموا ذبائح لي".<verse eid="LEV 23:7-8" /></para>
  <para style="s">عيد باكورة الحصاد</para>
  <para style="p">
    <verse number="9" style="v" sid="LEV 23:9" />وأوحى الله إلى النبي موسى مرّة ثانية: <verse eid="LEV 23:9" /><verse number="10" style="v" sid="LEV 23:10" />"يا موسى أخبر بني يعقوب بهذه التعاليم: عندما تدخلون الأرض الّتي وعدتكم بها وتحصدون باكورة زرعها، أحضروا حُزمةً منه إلى الحبر. <verse eid="LEV 23:10" /><verse number="11" style="v" sid="LEV 23:11" />وليقَدِّمها نيابةً عنكم في المحراب بعد يوم السبت مباشرة هديّة لي حتّى أقبلها. <verse eid="LEV 23:11" /><verse number="12" style="v" sid="LEV 23:12" />قَدِّموا لي في اليوم ذاته خروفا حوليّا لا عيب فيه يُحرق كاملا. <verse eid="LEV 23:12" /><verse number="13" style="v" sid="LEV 23:13" />وقدّموا لي في الحرم قربانا من دقيق مخلوط بزيت واسكبوا عليه قليلا من الخمر حيث يُحرق طلبا لمرضاتي. <verse eid="LEV 23:13" /><verse number="14" style="v" sid="LEV 23:14" />واحذروا لا تأكلوا من باكورة حصادكم، خبزا كان أو فريكا أو سنابل طَريّة، حتّى تقَدِّموا هذا القربان. إنّ هذه الفريضة أبديّة على مدى أجيالكم حيثما حلّلتم.<verse eid="LEV 23:14" /></para>
  <para style="s">عيد الحصاد</para>
  <para style="p">
    <verse number="15‏-16" style="v" sid="LEV 23:15-16" />ولتقدّم كل عائلة منكم بعد مرور سبعة أسابيع أي بعد خمسين يومًا من تقديم هذا القربان، قربانًا آخر من دقيق الحصاد. <verse eid="LEV 23:15-16" /><verse number="17" style="v" sid="LEV 23:17" />فلتقدّم كلّ عائلة حيثما حلّلتم رغيفين مخبوزين مع خمير من الدقيق الرفيع من باكورة حصادكم. <verse eid="LEV 23:17" /><verse number="18" style="v" sid="LEV 23:18" />ولتقدّموا جميعًا سبعة خراف حوليّة لا عيب فيها وعجلاً وكبشين، واذبحوها واحرقوها كاملة مع الدقيق والخمر، إنّ الله يرضى بما تقدّمون. <verse eid="LEV 23:18" /><verse number="19" style="v" sid="LEV 23:19" />ولتذبحوا تيسا تكفيرا عن الخطايا، وخروفين حوليّين للتقارب والمصالحة فيما بينكم. <verse eid="LEV 23:19" /><verse number="20" style="v" sid="LEV 23:20" />فيقدِّم الحبر الخروفين مع خبز باكورة الحصاد هدية لي ويرفعها في المحراب المقدّس. إنّه قربان مقدّس، وللأحبار أن يأكلوا من لحمه إذا شاؤوا. <verse eid="LEV 23:20" /><verse number="21" style="v" sid="LEV 23:21" />ولتمتنعوا عن أعمالكم في ذلك اليوم واحتفلوا احتفالا خاصّا للعبادة. وليكن ذلك فريضة عليكم أبديّة على مدى أجيالكم حيثما حلّلتم.<verse eid="LEV 23:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="LEV 23:22" />وحين تجمعون محصول أراضيكم، اتركوا ما في أطراف حقولكم، ولا تلتقطوا ما يقَع منها أثناء الجني إنّها للمسكين وعابر السبيل. إنّي أنا الله ربّكم".<verse eid="LEV 23:22" /></para>
  <para style="s">عيد الأبواق</para>
  <para style="p">
    <verse number="23" style="v" sid="LEV 23:23" />وأوحى الله إلى النبي موسى: <verse eid="LEV 23:23" /><verse number="24‏-25" style="v" sid="LEV 23:24-25" />"يا موسى أخبر بني يعقوب بهذه التعاليم: احتفلوا بعيد الأبواق في اليوم الأوّل من الشهر السابع، إنّه يوم راحة وتذكَار واجتمعوا للعبادة عند سماعكم صوت البوق، وقدّموا لي القرابين".<verse eid="LEV 23:24-25" /></para>
  <para style="s">يوم الكفّارة</para>
  <para style="p">
    <verse number="26" style="v" sid="LEV 23:26" />وأوحى الله إلى النبي موسى: <verse eid="LEV 23:26" /><verse number="27" style="v" sid="LEV 23:27" />"يا موسى احرصوا على الاحتفال بيوم الكفّارة في اليوم العاشر من الشهر نفسه، أي بعد تسعة أيام من عيد الأبواق، واجتمعوا فيه للعبادة، وتزهّدوا وصوموا وقدّموا لي القرابين. <verse eid="LEV 23:27" /><verse number="28" style="v" sid="LEV 23:28" />ولتمتنعوا عن العمل في هذا اليوم إنّه يوم الكَفّارة، فيه يكَفِّر عنكم الحبر أمام الله عن ذنوبكم. <verse eid="LEV 23:28" /><verse number="29" style="v" sid="LEV 23:29" />إنّ مَن لم يتزهّد ولم يصم في هذا اليوم يصبح بين جماعته منبوذا. <verse eid="LEV 23:29" /><verse number="30" style="v" sid="LEV 23:30" />وسأهلك كلّ مَن يعمل في هذا اليوم. <verse eid="LEV 23:30" /><verse number="31" style="v" sid="LEV 23:31" />فإيّاكم والقيام بأيّ عمل فيه. إنّ هذه فريضة أبدية عليكم على مدى أجيالكم حيثما حلّلتم. <verse eid="LEV 23:31" /><verse number="32" style="v" sid="LEV 23:32" />وإنّ هذا اليوم بمثابة يوم السبت، يخصّص للراحة التامّة، فيه تتزهّدون بداية من مساء اليوم التاسع إلى مساء اليوم الموالي".<verse eid="LEV 23:32" /></para>
  <para style="s">عيد الخيام</para>
  <para style="p">
    <verse number="33" style="v" sid="LEV 23:33" />وأوحى الله إلى النبي موسى قائلاً: <verse eid="LEV 23:33" /><verse number="34" style="v" sid="LEV 23:34" />"يا موسى أخبر بني يعقوب بهذه التعاليم: احتفلوا بعيد الخيام مدّة سبعة أيّام بداية من اليوم الخامس عشر من الشهر السابع، أي بعد مرور خمسة أيام على يوم الكفّارة. <verse eid="LEV 23:34" /><verse number="35" style="v" sid="LEV 23:35" />ولتجتمعوا للعبادة في اليوم الأوّل منها ولتمتنعوا عن أي عمل. <verse eid="LEV 23:35" /><verse number="36" style="v" sid="LEV 23:36" />وخلال أيامه السبعة قدّموا لي القرابين، واجتمعوا في اليوم الثامن للعبادة، وقدّموا لي قرابينكم وامتنعوا عن أي عمل. <verse eid="LEV 23:36" /><verse number="37" style="v" sid="LEV 23:37" />هذه هي الأعياد الخاصّة الّتي حدّدتُها لكم، فاحتفلوا بها، وقدّموا فيها لي الأضاحي والقرابين مِن دقيق وشراب، وكلّ قربان يقدّم في يومه المعلوم. <verse eid="LEV 23:37" /><verse number="38" style="v" sid="LEV 23:38" />احتفلوا بهذه الأعياد بالإضافة إلى يوم السّبت. وكلّ الأضاحي والقرابين فريضة عليكم زيادة على عطاياكم و نُذوركم وتبرُّعاتكم.<verse eid="LEV 23:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="LEV 23:39" />"أمّا عيد الخيام فلتحتفلوا به في منتصف الشهر السابع على مدى سبعة أيّام إثر انتهائكم من جمع محصول أراضيكم، ويخصّص منها اليوم الأوّل واليوم الأخير للراحة التامّة. <verse eid="LEV 23:39" /><verse number="40" style="v" sid="LEV 23:40" />تجمعون في اليوم الأوّل ثمار الأشجار وتقطفونها من أغصانها: من شجر كثيف، وصفصاف نهريّ وسعف نخيل، وتصنعون منها خيامًا، فتفرحون كامل الأسبوع بهذا العيد. <verse eid="LEV 23:40" /><verse number="41" style="v" sid="LEV 23:41" />ولتحتفلوا به مدّة سبعة أيّام من كلّ سنة. إنّ هذه فريضة عليكم أبديّة على مدى أجيالكم. <verse eid="LEV 23:41" /><verse number="42" style="v" sid="LEV 23:42" />وعلى جميع بني يعقوب أن يقيموا في الخيام سبعة أيّام، <verse eid="LEV 23:42" /><verse number="43" style="v" sid="LEV 23:43" />جيلاً بعد جيل، تذكارًا لنسلكم، حينما جعلنا آباءكم الأوّلين في الخيام يسكنون لمّا حرّرناهم من مصر. إنّي أنا الله ربّكم".<verse eid="LEV 23:43" /></para>
  <para style="p">
    <verse number="44" style="v" sid="LEV 23:44" />فأخبر النبي موسى بني يعقوب بجميع التعاليم الخاصّة بالأعياد السنويّة إكرامًا لله.<verse eid="LEV 23:44" /></para>
  <chapter eid="LEV 23" />
  <chapter number="24" style="c" sid="LEV 24" />
  <chapter eid="LEV 24" />
  <chapter number="25" style="c" sid="LEV 25" />
  <chapter eid="LEV 25" />
  <chapter number="26" style="c" sid="LEV 26" />
  <chapter eid="LEV 26" />
  <chapter number="27" style="c" sid="LEV 27" />
  <chapter eid="LEV 27" />
</usx>