<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="2TI" style="id">- True Meaning Arabic</book>
  <para style="ide">UTF-8</para>
  <para style="h">تيموتاوي الثانية</para>
  <para style="toc2">تيموتاوي الثانية</para>
  <para style="toc1">رسالة تيموتاوي الثانية</para>
  <para style="mt1">رسالة الحَواريّ بولُس الثّانية إلى تيموتاوي</para>
  <para style="imt">مدخل</para>
  <para style="ip">تُعتَبر الرّسائلُ الثلاثُ، تيموتاوي الأولى وتيموتاوي الثّانية وتيتوس، متميّزةً في الشّكل والمحتوى من بين رسائل الحواري بولس كلِّها. ويبدو أنّ بولس قد كتبها في زمنٍ متأخّر من حياته. ولمزيد من المعلومات حول التأليف وتاريخ كتابة هذه الرّسالة، يُمكن العودةُ إلى مدخل رسالة تيموتاوي الأولى.</para>
  <para style="im">لقد تَمَّ إطلاقُ سراح بولس في المرّة الأولى سنة 62 للميلاد، أيْ بعدَ مرور فترة من الزّمن على الحوادث المدوَّنةِ في نهاية كتاب سيرة الحواريّين (أي أعمال الرّسل). ومنذ ذلك الوقت تابَعَ بولس عملَه في نشر الرّسالة، ورّبما يكون قد توجّه في البدء إلى إسبانيا، ليَعُود بعدها إلى اليونان ثمّ إلى جزيرة كريت. ومن المحتمَل أيضا أنّ هذه الرّسالة قد كُتبت بعد رحلته تلك، أي عند عودته إلى روما، حيث سُجن مرّة أخرى، حوالي سنة 67 للميلاد.</para>
  <para style="im">وكُتبت هذه الرّسالةُ خلال فترة سجن بولس في روما للمرّة الثانية عندما كان ينتظر إعدامَه، فأرسل هذه الرّسالة إلى تيموتاوي، وفيها آخرُ التّحذيرات والتّوجيهات إليه. وكتَبَ هذه الرّسالة لسببين: أوّلهما دوافعُ شخصيّة، وثانيهما ضرورةُ معالجة المشاكل المنتشرة بين جماعات المؤمنين. وقد شعر أنّه وحيد لا مُعينَ له، وكان يرجو تيموتاوي أن يلتحق به سريعا، وفي الأثناء كان خصوم بولس يعملون على نشر رسالتهم المُزيَّفة في مقاطعة آسيا، وازداد الوضع سوءا مقارنةً بالفترة التي كتب فيها رسالته الأولى لتيموتاوي، إذ كان قلِقا بسبب انتشار التّعاليم المزيّفة وظهور شقاق داخلي بين المؤمنين. فحثّ بولس تيموتاوي على التركيز على تعليم الكتب المقدّسة والحقائق الموجودة فيها. وكانت الرّسالة في أغلب أبعادها بمثابة آخر وصايا الحكمة من بولس قبل موته الوشيك.</para>
  <chapter number="1" style="c" sid="2TI 1" />
  <para style="ms3">بسم الله تبارك وتعالى</para>
  <para style="cl">الفصل الأوّل</para>
  <para style="s">تحيّة</para>
  <para style="p">
    <verse number="1" style="v" sid="2TI 1:1" />مِن بولُسَ حَواريِّ سَيِّدِنا عيسى المَسيحِ، أرسَلَني اللهُ بأمرٍ مِنهُ لأُبَلِّغَ العالَمينَ وَعدَهُ بدارِ الخُلدِ لكُلِّ المؤمنينَ بِهِ (سلامُهُ علينا). <verse eid="2TI 1:1" /><verse number="2" style="v" sid="2TI 1:2" />إلى ابني الحَبيبِ تيموتاوي. لكَ الفَضلُ والرَّحمةُ والسّلامُ مِن اللهِ أبينا الأحَدِ الصَّمَدِ، ومِن سَيِّدِنا عيسـى المَسيحِ.<verse eid="2TI 1:2" /></para>
  <para style="s">شدّ عزيمة تيموتاوي</para>
  <para style="p">
    <verse number="3" style="v" sid="2TI 1:3" />أحمَدُ اللهَ الّذي أتَقَرَّبُ إليهِ بِضَميرٍ خالِصٍ، كَما أَخلَصَ إليهِ آبائي الأوّلونَ، وأَذكُرُكَ في تَضَرُّعاتي لَيلاً نَهارًا وفي كُلِّ حين. <verse eid="2TI 1:3" /><verse number="4" style="v" sid="2TI 1:4" />وأَذكُرُ الدُّموعَ الّتي كُنتَ تَذرِفُها لَحظةَ افتَراقِنا، فيَزدادُ شَوقي لرُؤيتِكَ ليَمتَلئ فؤادي فَرَحًا. <verse eid="2TI 1:4" /><verse number="5" style="v" sid="2TI 1:5" />وأتَذَكَّرُ إيمانَكَ الصّادِقَ أيضًا، ذلِكَ الإيمانَ الّذي أشرَقَ في قَلبِ جَدَّتِكَ لويزةَ سابِقًا، ثُمّ أشرَقَ في قَلبِ أُمِّكَ فائزةَ، وأنا على يَقينٍ أنّ هذا الإيمانَ في قَلبِكَ الآنَ.<verse eid="2TI 1:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="2TI 1:6" />ولهذا أُنَبِّهُكَ لتَتَذَكَّرَ اللَّحظةَ الّتي وَضَعتُ فيها يَدي عليكَ لِتَعيينِكَ لخِدمةِ اللهِ،<note caller="+" style="f"><char style="fr" closed="false">1‏.6 </char><char style="ft" closed="false">كان قادة المؤمنين بالسّيّد المسيح يَضَعون أيديهم على النّاس كعلامة لتعيينهم للوعظ أو لتعليم أناس آخرين من أتباع السّيّد المسيح، اقتداءً بالعادات اليهوديّة.</char></note> وأن تُلهِبَ مِن جَديد الكَرامةَ الّتي حَصَلتَ عليها في تِلكَ اللَّحظةِ. <verse eid="2TI 1:6" /><verse number="7" style="v" sid="2TI 1:7" />لا تَخشَ أحَدًا، فقد أعطانا اللهُ رُوحَهُ، لا رُوحَ الخَوفِ، بل رُوحَ القوّةِ والمَحَبّةِ والبَصيرةِ. <verse eid="2TI 1:7" /><verse number="8" style="v" sid="2TI 1:8" />فلا تَتَرَدَّد حينَ تَدعو النّاسَ إلى الإيمانِ بِسَيِّدِنا عيسى، ولا تَخجَل مِنّي أنا السَّجينُ في سَبيلِهِ، ولكنّي أطلُبُ مِنكَ أن تُشاركَني المَصاعِبَ والمَشَقّاتِ في سَبيلِ البُشرَى بِهِ (سلامُهُ علينا)، مُتَوَكِّلاً على قُدرةِ اللهِ.<verse eid="2TI 1:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="2TI 1:9" />إنّ اللهَ جَعَلَنا مِن النّاجينَ، ودَعانا إلى العَيشِ مَنذورينَ لهُ، لا على أساسِ أعمالِنا، بل بِمُوجِبِ مَقاصِدِهِ وفَضلِهِ الكَريمِ. وقد أرادَ مُنذُ الأزَلِ أن يَمنَحَنا فَضلَهُ مِن خِلالِ سَيِّدِنا عيسـى المَسيحِ. <verse eid="2TI 1:9" /><verse number="10" style="v" sid="2TI 1:10" />ولكِنّهُ لم يَكشِف عن فَضلِهِ هذا إلاّ بِتَجَلّي مُنَجّينا (سلامُهُ علينا) فهو الّذي سَحَقَ المَوتَ وأنارَ طَريقَ الحَياةِ والخُلودِ ببُشراهُ. <verse eid="2TI 1:10" /><verse number="11" style="v" sid="2TI 1:11" />ولقد اختارَني اللهُ لهذِهِ الرِّسالةِ فكُنتُ رَسولاً مُرشِدًا وداعيةً إليها، <verse eid="2TI 1:11" /><verse number="12" style="v" sid="2TI 1:12" />فأنا أُقاسي في سَبيلِها الضِّيقَ هُنا في السِّجنِ، لكِنّي لا أتَرَدَّدُ لأنّي أعرِفُ اللهَ الّذي وَثِقتُ بِهِ، وإنّي على يَقينٍ أنّهُ تَعالى قادِرٌ على حِفظِ ما أودَعتُهُ عِندَهُ إلى اليَومِ العَظيمِ.<verse eid="2TI 1:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="2TI 1:13" />فتَمَسَّكْ بالمَبادئ الّتي سَمَعتَها مِنّي، واجعَلْها مِثالاً يُحتَذى، إضافةً إلى مَحَبّتِكَ لِسَيِّدِنا عيسى المَسيحِ وإخلاصِكَ لِلمؤمنينَ. <verse eid="2TI 1:13" /><verse number="14" style="v" sid="2TI 1:14" />واحفَظِ الوَديعةَ الصّالِحةَ، فهي رِسالةُ اللهِ الّتي جَعَلتُكَ عليها وَكيلاً، وحافِظْ عليها بِعَونِ رُوحِ اللهِ الّتي حَلَّت فينا.<verse eid="2TI 1:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="2TI 1:15" />وإنّكَ تَعلَمُ أنّ كُلَّ المؤمنينَ في مُقاطَعةِ آسيا قد تَخَلَّوا عنّي، لا سِيّما فيغالي وهارمُوجْني. <verse eid="2TI 1:15" /><verse number="16" style="v" sid="2TI 1:16" />وتَرَكَني أنيسُ أيضًا، فلْيَرحَمْهُ سَيِّدُنا عيسى ولْيَشفَع لأهلِ بَيتِهِ أجمَعينَ. لقد كانَ سابِقًا يَزورُني مَرّاتٍ عَديدةً ويُدخِلُ الفرَحَ على قَلبي، ولم يَخجَل مِنّي يَومًا بسَبَبِ سَجني وقُيودي، <verse eid="2TI 1:16" /><verse number="17" style="v" sid="2TI 1:17" />حَتّى إنّهُ بَذَلَ جَهدًا في بَحثِهِ عنّي عِندَما كانَ في روما إلى أن وَجَدَني في السِّجن. <verse eid="2TI 1:17" /><verse number="18" style="v" sid="2TI 1:18" />وإنّكَ تَعرِفُ كَم خَدَمَني هذا الأخُ الكَريمُ وأنا في مَدينةِ أفاسوس. أجل، فليَرحَمْهُ سَيِّدُنا عيسى وليَشفَع لهُ يَومَ الدِّين!<verse eid="2TI 1:18" /></para>
  <chapter eid="2TI 1" />
  <chapter number="2" style="c" sid="2TI 2" />
  <para style="cl">الفصل الثّاني</para>
  <para style="s">الاجتهاد لنيل مرضاة سيّدنا عيسى</para>
  <para style="p">
    <verse number="1" style="v" sid="2TI 2:1" />وأنتَ يا بُنيّ، كُن مِن الأقوياءِ بما أنعَمَ اللهُ عَليكَ مِن فَضلٍ، لأنّكَ تابِعٌ لِسَيِّدِنا عيسـى المَسيحِ. <verse eid="2TI 2:1" /><verse number="2" style="v" sid="2TI 2:2" />وما سَمِعتَهُ مِنّي مِن أُمورٍ أمامَ الكَثيرِ مِن الشُّهودِ، فأودِعْهُ أمانةً لِلّذينَ تَجدُرُ بِهِم الثِّقةُ، ليَكونوا أيضًا قادِرينَ على تَعليمِ الآخَرينَ. <verse eid="2TI 2:2" /><verse number="3" style="v" sid="2TI 2:3" />وكَما يَحتَمِلُ الجُنديُّ الأمينُ المُعاناةَ والضِّيقَ، عليكَ أن تَحتَمِلَ مِثلي المُعاناةَ في سَبيلِ مَولانا عيسـى المَسيحِ. <verse eid="2TI 2:3" /><verse number="4" style="v" sid="2TI 2:4" />إنّ كُلَّ جُنديّ يُريدُ إرضاءَ قائدِهِ لا يَشغَلُ نَفسَهُ بالشُّؤونِ الّتي لا تَمُتُّ بِصِلةٍ بِمُهِمّتِهِ العَسكَريّةِ. <verse eid="2TI 2:4" /><verse number="5" style="v" sid="2TI 2:5" />ولا يَفوزُ المُصارِعُ بإِكليلِ النَّصرِ إلاّ إذا اتَّبَعَ قَوانينَ المُباراةِ، <verse eid="2TI 2:5" /><verse number="6" style="v" sid="2TI 2:6" />ولا بُدَّ للمُزارعينَ الّذينَ يَتعَبونَ في الحَقلِ أن يَكونوا أوّلَ مَن يَحصُلُ على نَصيبٍ مِن ثِمارِ زِراعتِهِم. <verse eid="2TI 2:6" /><verse number="7" style="v" sid="2TI 2:7" />يا تيموتاوي، تأمَّلْ في ما قُلتُ لكَ، وسيُساعِدُك سَيِّدُنا عيسى لتَكونَ مِن المُبصِرينَ.<verse eid="2TI 2:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="2TI 2:8" />تَذَكَّرْ يا بُنيّ أنّ سَيِّدَنا عيسـى المَسيحَ، سَليلَ النَّبيِّ داودَ ووَريثَهُ، قد بُعِثَ حيًّا مِن بَينِ الأمواتِ. وهذِهِ هي البُشرى الّتي أُنادي بها، <verse eid="2TI 2:8" /><verse number="9" style="v" sid="2TI 2:9" />وفي سَبيلِها أُعاني الآلامَ، إذ كُبِّلتُ بالأغلالِ كالمُجرِمينَ، ولكِن رِسالةُ اللهِ لا تُكَبِّلها قُيودٌ! <verse eid="2TI 2:9" /><verse number="10" style="v" sid="2TI 2:10" />ولذلِكَ فأنا أصبرُ على كُلِّ مَكروهٍ في سَبيلِ نَشرِ البَلاغِ البَشيرِ، حَتّى يَحصُلَ كُلُّ الّذينَ اختارَهُم اللهُ على النَّجاةِ والمَجدِ الخالِدِ مِن سَيِّدِنا عيسى المَسيحِ. <verse eid="2TI 2:10" /><verse number="11" style="v" sid="2TI 2:11" />إنّ هذا القَولَ الّذي ستَسمَعونَهُ صادِقٌ أمينٌ:</para>
  <para style="b" vid="2TI 2:11" />
  <para style="q2" vid="2TI 2:11">إن مُتنا في سَبيلِهِ، فسنَحيا مَعَهُ خالِدِينَ.<verse eid="2TI 2:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="2TI 2:12" />وإن تَحَمَّلنا الآلامَ مِن أجلِهِ، فسنَكونُ مَعَهُ في الآخِرةِ مِن الحاكِمينَ.</para>
  <para style="q2" vid="2TI 2:12">وإنّهُ سيُنكِرُنا إن كُنّا لهُ مُنكِرينَ.<verse eid="2TI 2:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="2TI 2:13" />وإن أصبَحنا غَيرَ أُمَناءَ فإنّهُ يَبقى الأمينَ،</para>
  <para style="q2" vid="2TI 2:13">لأنّهُ غَيرَ قادِرٍ على أن يُنكِرَ جَوهَرَهُ الكَريمَ.<verse eid="2TI 2:13" /></para>
  <para style="s">إرضاء العبد لربّه</para>
  <para style="p">
    <verse number="14" style="v" sid="2TI 2:14" />ذَكِّرْ بهذِهِ الأُمورِ الإخوةَ في اللهِ، وحَذِّرْهُم أمامَ اللهِ مِن الجِدالِ العَقيمِ، إذ لا يَنفَعُ الجِدالُ في شَيءٍ بل يؤدِّي إلى خَرابِ إيمانِ كُلِّ مَن يَسمَعُهُ. <verse eid="2TI 2:14" /><verse number="15" style="v" sid="2TI 2:15" />واجتَهِدْ لِكَي تَكونَ رَجُلاً يُرضي اللهَ، مُتَفَوِّقًا ولا يَتَرَدَّدُ في عَمَلِهِ، مُستَقيمًا في تَفسيرِ رِسالةِ الحقِّ. <verse eid="2TI 2:15" /><verse number="16" style="v" sid="2TI 2:16" />وتَجَنّبِ الجَدَلَ السَّخيفَ الفاسِدَ، فهو يَزيدُ أصحابَهُ فَسادًا، <verse eid="2TI 2:16" /><verse number="17" style="v" sid="2TI 2:17" />وجَدَلُهُم هذا سيَنشُرُ تَعاليمَهُم كالسَّرطانِ الخَبيثِ في الجِسمِ السَّليمِ. ومِن هؤلاءِ المُجادلينَ هيمْناوي وفيلاتي، <verse eid="2TI 2:17" /><verse number="18" style="v" sid="2TI 2:18" />اللّذيْنِ انحَرَفا عن سَبيلِ الحقِّ بِزَعمِهِما أنّ أمرَ بَعثِ الأمواتِ قد حَلَّ ومَضى،<note caller="+" style="f"><char style="fr" closed="false">2‏.18 </char><char style="ft" closed="false">رأى الإغريق الوثنيّون أنّ بعث الأجساد في المستقبل أمرٌ غريب وغير مقبول طالما اعتقدوا أنّ العالم المادي فاسد وأقلّ شأنا من العالم الرّوحي. وربّما قام بعض الدّعاة المضلِّلين مثل هيمناوي وفيلاتي بتعليم النّاس أنّ بعث الأموات ليس أمرا مادّيا ولكنّه أمر روحيّ فقط في سبيل إيصال رسالة السيّد المسيح لتكون أكثر قبولا عند الإغريق. </char></note> وبِقَولِهِما هذا يَجعَلانِ بَعضَ المؤمنينَ يَرتَدّونَ عن إيمانِهِم. <verse eid="2TI 2:18" /><verse number="19" style="v" sid="2TI 2:19" />إلاّ أنّ الأساسَ المَتينَ الّذي وَضَعَهُ اللهُ يَبقى ثابِتًا، وهو مَختومٌ بِما جاءَ في التَّوراةِ: "إنّ اللهَ بِخاصّتِهِ عَليمٌ". وجاءَ أيضًا: "إنّ على الذّينَ يَستَنجِدونَ باسمِ مَولانا أن يَكونوا عـنِ الشَّـرِّ مُبعَدينَ".<note caller="+" style="f"><char style="fr" closed="false">2‏.19 </char><char style="ft" closed="false">اقتبس الحواري بولس من التّوراة، سفر العدد الفصل 16، حيث جاءت قصّة تحدّي قارون ورجال آخرين لسلطة النّبي موسى (عليه السّلام). ولكنّ الأرض تصدّعت وانشقّت وابتلعتهم جميعا. وربّما ذكر بولس هذه القصّة ليبيّن مدى أهميّة البعث وخطورة تضليل هيمناوي وفيلاتي.</char></note><verse eid="2TI 2:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="2TI 2:20" />وإنّكَ لتَرى، في الدّارِ فَسيحةِ الأرجاءِ، كُلَّ أنواعِ الأواني، مِن ذَهَـبٍ وفِضّـةٍ، وخَشَـبٍ وفَخّـارٍ، فبَعضُهـا يُستَعمَلُ لمُناسِبات خاصّةٍ، ويَبقى البَعضُ الآخَرُ لاسـتِعمالٍ يَوميّ عاديّ. <verse eid="2TI 2:20" /><verse number="21" style="v" sid="2TI 2:21" />فإذا حَفِظَ الإنسانُ نَفسَهُ طاهِرًا مِن كُلِّ الشُّـرورِ الّتي ذَكَرناها، يَكونُ كَالإناءِ الثَّمينِ المُخَصَّصِ للهِ، فيَنفَعُ بذلِكَ خِدمةَ رَبِّ البَيتِ، ويَكونُ مُستَعِدًّا لفِعلِ صالِحِ الأعمالِ.<verse eid="2TI 2:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="2TI 2:22" />يا تيموتاوي، تَجَنّبْ أهواءَ الشَّـبابِ، واسْعَ إلى مَرضاةِ اللهِ والإخلاصِ والمَحَبّةِ والسَّلامِ مَعَ الذّينَ يَستَغيثونَ بسَيِّدِنا عيسى بِقَلبٍ طاهِرٍ. <verse eid="2TI 2:22" /><verse number="23" style="v" sid="2TI 2:23" />وتَجَنّبْ المُجادَلات الغَبيّةِ الحَمقاءِ، فأنتَ تَعلَمُ أنّها تَفتَحُ بابَ الخِصامِ. <verse eid="2TI 2:23" /><verse number="24" style="v" sid="2TI 2:24" />فلا يَجوزُ لعِبادِ اللهِ الصّالِحينَ أن يُخاصِموا النّاسَ، بَل عليهِم أن يُشفِقوا على جَميعِ النّاسِ، ويَكونوا قادِرينَ على التَّعليمِ، صابِرينَ على إساءةِ النّاسِ، <verse eid="2TI 2:24" /><verse number="25" style="v" sid="2TI 2:25" />وعَليكَ أن تُوَجِّهَ مُقاوِمي الإيمانِ بِلُطفٍ، لَعَلَّ اللهَ يَهديهِم إلى التَّوبةِ فيُدرِكوا الحَقَّ، <verse eid="2TI 2:25" /><verse number="26" style="v" sid="2TI 2:26" />ويَعودوا إلى رُشدِهِم، فيَتَخَلَّصوا مِن قَيدِ الشَّيطانِ الّذي أطبَقَ عليهِم ليَعمَلوا بإرادتِهِ.<verse eid="2TI 2:26" /></para>
  <chapter eid="2TI 2" />
  <chapter number="3" style="c" sid="2TI 3" />
  <para style="cl">الفصل الثّالث</para>
  <para style="s">الأيّام الأخيرة لهذه الدّنيا</para>
  <para style="p">
    <verse number="1" style="v" sid="2TI 3:1" />واذكُر، أيُّها الحَبيبُ، أنّهُ ستَمُرُّ على النّاسِ أوقاتٌ عَسيرةٌ في آخَرِ أيّامِ هذِهِ الدُّنيا، <verse eid="2TI 3:1" /><verse number="2" style="v" sid="2TI 3:2" />فيُصبِحُ النّاسُ أنانيّينَ، مُتَهافِتينَ على المالِ، مُتَكَبِّرينَ، شَتّامينَ، لا يُطيعونَ والِديهِم، ناكِرينَ للجَميلِ، فاسِقينَ، <verse eid="2TI 3:2" /><verse number="3" style="v" sid="2TI 3:3" />وتَنعَدِمُ الشَّفَقةُ والرَّحمةُ مِن قُلوبِهِم، فيَفتَرونَ على غَيرِهِم وتَجمَحُ بِهِم الأهواءُ، فيُعادونَ الخَيرَ بكُلِّ شَراسةٍ، <verse eid="2TI 3:3" /><verse number="4" style="v" sid="2TI 3:4" />خائنينَ، طائِشينَ، تَنتَفِخُ صُدورُهُم تَكَبُّرًا، ويُفَضِّلونَ المَلَذّات على اللهِ، <verse eid="2TI 3:4" /><verse number="5" style="v" sid="2TI 3:5" />ويَتَمَسَّكونَ بقُشورِ التَّقوى، ويُرفُضونَ جَوهرَها، فانأى عن هَؤلاءِ النّاسِ جَميعًا. <verse eid="2TI 3:5" /><verse number="6" style="v" sid="2TI 3:6" />فبَعضُهُم يَتَسَلَّلُ إلى البُيوتِ ويُوقِعُ النِّساءَ الضَّعيفاتِ المُثقَلاتِ بالخَطايا في حَبائلِهِ، فتَنقَدنَ إلى الشَّهَواتِ بِكُلِّ أنواعِها <verse eid="2TI 3:6" /><verse number="7" style="v" sid="2TI 3:7" />بالاستِماعِ المُتَواصِلِ إلى تَعاليمَ دِينيّةٍ جَديدةٍ في حينَ أنّهُنَّ عاجِزات عن تَمييزِ الحَقِّ مِن الباطِلِ. <verse eid="2TI 3:7" /><verse number="8" style="v" sid="2TI 3:8" />وكَما عارَضَ السّاحِرانِ يَنّيسُ ويَمْبِريسُ النَّبيَّ موسى في القَديمِ، يُعارِضُ هَؤلاءِ الدُّعاةُ الدَّجّالونَ الحَقَّ بعُقولِهِم الفاسِدةِ، وهكذا يَكونُ إيمانُهُم مُزَيَّفًا.<note caller="+" style="f"><char style="fr" closed="false">3‏.8 </char><char style="ft" closed="false">يقارن بولس خصومه بـ "ينيس" و"يمبريس"، السّاحرين المصريّين اللّذين واجها النّبي موسى، كما ورد في بعض القصص اليهوديّة.</char></note> <verse eid="2TI 3:8" /><verse number="9" style="v" sid="2TI 3:9" />ولكِنّهُم لن يَصِلوا إلى مُرادِهِم، فحَماقتُهُم ستَنكَشِفُ كَما انكَشَفَت حَماقةُ يَنّيسَ ويَمْبِريسَ للنّاسِ جَميعًا.<verse eid="2TI 3:9" /></para>
  <para style="s">الابتلاء والثّبات في الإيمان</para>
  <para style="p">
    <verse number="10" style="v" sid="2TI 3:10" />أمّا أنتَ فإنّكَ على عِلمٍ بتَعليمي وسِيرَتي ومَقاصِدي وإيماني وصَبري ومَحَبّتي وثَباتي. <verse eid="2TI 3:10" /><verse number="11" style="v" sid="2TI 3:11" />فأنتَ تَعرِفُ كَيفَ اضطَهَدني غَيرُ المؤمنينَ في مُقاطَعةِ غَلاطية، حَيثُ حَلَّ بي البَلاءُ المُبينُ في بَلداتِ أنْطاكيةَ وإيقونيةَ ولِسْتِرةَ، ولكِنّ مَولاي أنقَذَني مِن كُلِّ ذلِكَ فنَجَوتُ.<note caller="+" style="f"><char style="fr" closed="false">3‏.11 </char><char style="ft" closed="false">ذُكرت هنا بلدة أنطاكيا التي تقع في إقليم بيسيديّة (انظر سيرة الحواريين 13: 14‏-52) حيث وُفق بولس وبرنابا في دعوة النّاس إلى الإيمان برسالة سيّدنا عيسى (سلامُهُ علينا). وجاء ذكر عمل بولس في كلّ من إقونية ولسترة في سيرة الحواريّين (أي أعمال الرسل) 14: 1 – 20. ويمكن أن يكون تيموتاوي قد سمع عن معاناة بولس في لسترة لأنّه كان من تلك المنطقة.</char></note> <verse eid="2TI 3:11" /><verse number="12" style="v" sid="2TI 3:12" />فكُلُّ مَن يَسعى إلى العَيشِ بتَقوى كَمُؤمِنٍ بِسَيِّدِنا عيسـى المَسيحِ يَلقى الاضطِهادَ أيضًا. <verse eid="2TI 3:12" /><verse number="13" style="v" sid="2TI 3:13" />أمّا أهلُ الشَّرِّ والدَّجّالونَ، فيَزدادُ شَرُّهُم وهُم الخادِعونَ المُنخَدِعونَ. <verse eid="2TI 3:13" /><verse number="14" style="v" sid="2TI 3:14" />وأمّا أنتَ فاثبُتْ على التَّعاليمِ الّتي تَلَقَّيتَها مِنّا وتَيَقَّنتَ مِنها، لأنّكَ تَثِقُ بِالذّينَ أرشدوكَ، <verse eid="2TI 3:14" /><verse number="15" style="v" sid="2TI 3:15" />فمُنذُ صِغَرِكَ اطَّلَعتَ على الكُتُبِ السَّماويّةِ المُقَدَّسةِ، فهي تَجعَلُ المُؤمِنَ حَكيمًا ليَنالَ النَّجاةَ بِإيمانِهِ بِسَيِّدِنا عيسـى المَسيحِ. <verse eid="2TI 3:15" /><verse number="16" style="v" sid="2TI 3:16" />فهذِهِ الكُتُبُ كُلُّها وَحيٌ مِن اللهِ، تُفيدُ في التَّعليمِ وفي رَدِّ الضَّلالِ وفي تَصحيحِ الخَطإ وفي الإرشادِ إلى ما يُرضي اللهَ، <verse eid="2TI 3:16" /><verse number="17" style="v" sid="2TI 3:17" />وبالإيمانِ بهذِهِ الكُتُبِ يَكونُ المؤمنُ التَّقيُّ الصّالِحُ مُؤهَّلاً لِلقِيامِ بِكُلِّ الأعمالِ الصّالِحةِ.<verse eid="2TI 3:17" /></para>
  <chapter eid="2TI 3" />
  <chapter number="4" style="c" sid="2TI 4" />
  <para style="cl">الفصل الرّابع</para>
  <para style="s">بولس يشير إلى وفاته</para>
  <para style="p">
    <verse number="1" style="v" sid="2TI 4:1" />أُناشِدُكَ أمامَ اللهِ وأمامَ سَيِّدِنا عيسى المَسيحِ الّذي سيَتَجَلّى لإقامةِ المَملَكةِ الرَّبّانيّةِ بَينَ النّاسِ، وعِندئذٍ سيُحاسِبُ الأحياءَ والأمواتَ، <verse eid="2TI 4:1" /><verse number="2" style="v" sid="2TI 4:2" />أُناشِدُكَ أن تَدعو إلى رِسالةِ اللهِ، سَواءً كانَ النّاسُ على استِعدادٍ لسَماعِها أم لم يَكونوا. ووَبِّخ المؤمنينَ وحَذِّرهُم وشُدَّ عَزيمتَهُم بكُلِّ صَبرٍ خِلالَ تَعليمِهِم. <verse eid="2TI 4:2" /><verse number="3" style="v" sid="2TI 4:3" />فإنّهُ سيأتي زَمَنٌ لا يُطيقُ فيهِ النّاسُ إرشادًا سَليمًا لا مَحالةَ، بل سيَتَّبِعونَ أهواءَهُم، وسيَميلونَ لِما يُطرِبُ آذانَهُم مِن كَلامِ الدُّعاةِ. <verse eid="2TI 4:3" /><verse number="4" style="v" sid="2TI 4:4" />إنّهُم يُعرِضونَ عن سَماعِ الحَقّ، ويَميلونَ إلى الخُرافاتِ. <verse eid="2TI 4:4" /><verse number="5" style="v" sid="2TI 4:5" />أمّا أنتَ، فكُن يَقِظًا في كُلِّ الأحوالِ، وتَحَمَّلْ المَشَقّات، وكُن داعيًا بَشيرًا ومُخلِصًا في خِدمَتِكَ للهِ.<verse eid="2TI 4:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="2TI 4:6" />أمّا أنا فقد آنَ الأوانُ لأُضَحّي بحَياتي،<note caller="+" style="f"><char style="fr" closed="false">4‏.6 </char><char style="ft" closed="false">في النّص الأصلي اليوناني، يقارن بولس حياتَه بالسّوائل أو العطور التي تسكب كقربان لله إكراما للسيّد المسيح. وتقديم هذه السّوائل كقربان كان عادةً من العادات اليهوديّة والوثنيّة. وأثناء تقديم هذا القربان، يُسكَب الشّرابُ مثل النبيذ أو الماء أو الزّيت، إكراما لله.</char></note> وحانَت ساعةُ رَحيلي عَن هذا العالَمِ. <verse eid="2TI 4:6" /><verse number="7" style="v" sid="2TI 4:7" />فلقد جاهَدتُ في سَبيلِ الخَيرِ، وبَلَغتُ نِهايةَ السِّباقِ، وحافَظتُ على الإيمانِ الحَقِّ. <verse eid="2TI 4:7" /><verse number="8" style="v" sid="2TI 4:8" />وها أنّي أنتَظِرُ مِن اللهِ أن يُجازيني برِضاهُ كَما يَنتَظِرُ الفائزُ في السِّباقِ أن يُتَوَّجَ بإكليلِ الانتِصارِ، إنّه الإكليلُ الّذي سيُقَدِّمُهُ لي سَيِّدُنا عيسى الحَكَمُ العَدلُ يَومَ الدِّينِ، ولَستُ وَحدي مَن يَنتَظِرُ الجَزاءَ بَل يَنتَظِرُهُ كُلُّ مَن يَشتاقُ إلى تَجَلّيهِ العَظيمِ.<verse eid="2TI 4:8" /></para>
  <para style="s">تعليمات أخيرة</para>
  <para style="p">
    <verse number="9" style="v" sid="2TI 4:9" />أسرِعْ إليّ، أيُّها الحَبيبُ، <verse eid="2TI 4:9" /><verse number="10" style="v" sid="2TI 4:10" />فقد أصبَحَ ديماسُ يَميلُ إلى مَتاعِ الدُّنيا، فتَرَكَني وسَلَكَ طَريقَهُ إلى مَدينةِ تَسالونْكي. أمّا الأخُ كِريسكي فقد اتَّجَهَ نَحوَ مُقاطَعةِ غَلاطية، وتيتوسُ قَصَدَ مُقاطَعةَ دَلْماطِيَّة. <verse eid="2TI 4:10" /><verse number="11‏-12" style="v" sid="2TI 4:11-12" />وأرسَلتُ الأخَ طيخي إليكَ في مَدينةِ أفاسوس، ولم يَبقَ مَعي مُعينٌ سِوى لوقا. فمُرَّ على مَرقُسَ وأحْضِرهُ مَعَكَ، لأنّهُ يُفيدُني كَثيرًا في الدَّعوةِ. <verse eid="2TI 4:11-12" /><verse number="13" style="v" sid="2TI 4:13" />وعِندَما تأتي، أحضِرْ مَعَكَ العَباءةَ الّتي تَرَكتُها مَعَ قَربُسَ في تَرْواسَ، وأحضِرْ أيضًا الكُتُبَ وخاصّةً مَصاحِفَ الجِلدِ.<verse eid="2TI 4:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="2TI 4:14" />إنّ اِسكَنْدَرَ النَّحّاسَ<note caller="+" style="f"><char style="fr" closed="false">4‏.14 </char><char style="ft" closed="false">ربّما يكون الشّخص المشار إليه هنا هو الإسكندر المذكور في الرّسالة الأولى إلى تيموتاوي 1: 20. </char></note> أساءَ إليّ وآذاني كَثيرًا، فإنّ مَولانا سيُجازيهِ على قَدرِ عَمَلِهِ الأثيمِ. <verse eid="2TI 4:14" /><verse number="15" style="v" sid="2TI 4:15" />فاِحتَرِسْ مِنهُ، فإنّهُ كانَ مِن أشَدِّ المُعارِضينَ لرِسالتِنا.<verse eid="2TI 4:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="2TI 4:16" />ولقد دافَعتُ عن نَفسي في المُحاكَمةِ الأولى ضِدَّ الّذينَ ظَلَموني، ولم يَحضُرْ أحَدٌ مِن المؤمنينَ لِلدِّفاعِ عنّي، بل تَرَكوني جَميعًا. فيا رَبُّ اغفِر لهُم لأنّهُم تَرَكوني. <verse eid="2TI 4:16" /><verse number="17" style="v" sid="2TI 4:17" />ولكِنّ مَولاي عيسى مَنَحَني القوّةَ ووَقَفَ إلى جانِبي، فتَمَكَّنتُ مِن إعلانِ الدَّعوةِ بأكمَلِها، وسَمِعَ بها جَميعُ الأغرابِ، فنَجَوتُ مِن خَطَرٍ يُضاهي خَطَرَ أنيابِ الأسَدِ. <verse eid="2TI 4:17" /><verse number="18" style="v" sid="2TI 4:18" />وسيُنقِذُني مَولاي مِن كُلِّ هُجومٍ شِريرٍ وسيَحفَظُني حَتّى أدخُلَ في مَملَكتِهِ السَّماويّةِ. فليَكُن للهِ الجَلالُ إلى أبَدِ الآبِدينَ! آمينَ.<verse eid="2TI 4:18" /></para>
  <para style="s">تحيّات ودعاء</para>
  <para style="p">
    <verse number="19" style="v" sid="2TI 4:19" />بَلِّغْ سَلامي إلى الأُختِ بَرَكةَ والأخِ عَقيلٍ وعائِلةِ أنيسٍ. <verse eid="2TI 4:19" /><verse number="20" style="v" sid="2TI 4:20" />أُعلِمُك أنّ الأخَ أرِسْتي بَقيَ في كورِنْتوس. ولقد تَرَكتُ الأخَ طَريفي مَريضًا في مَدينةِ مِيليتُسَ. <verse eid="2TI 4:20" /><verse number="21" style="v" sid="2TI 4:21" />فأسرِعْ إليّ قَبلَ حُلولِ الشِّتاءِ. يُسَلِّمُ عَليكَ الإخوةُ يُوبولي وبُودي ولينو وكَلودِيا وكُلُّ بَقيةِ الإخوةِ. <verse eid="2TI 4:21" /><verse number="22" style="v" sid="2TI 4:22" />ليَكُنْ سَيِّدُنا مَعَ رُوحِكَ. وفَضلُ اللهِ مَعَكُم أجمَعينَ.<verse eid="2TI 4:22" /></para>
  <chapter eid="2TI 4" />
</usx>