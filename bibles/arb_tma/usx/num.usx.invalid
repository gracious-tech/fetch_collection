  <book code="NUM" style="id">- True Meaning Arabic</book>
  <para style="toc3">قصّة النّبيّ موسى - من العدد</para>
  <para style="toc2">قصّة النّبيّ موسى - من العدد</para>
  <para style="toc1">قصّة النّبيّ موسى – من العدد</para>
  <para style="mt1">قصّة النّبيّ موسى – من العدد</para>
