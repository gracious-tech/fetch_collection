  <book code="LAM" style="id">- True Meaning Arabic</book>
  <para style="toc3">من مراثي إرميا</para>
  <para style="toc2">من مراثي النّبيّ إرميا</para>
  <para style="toc1">من مراثي النّبيّ إرميا</para>
  <para style="mt1">من مراثي النّبيّ إرميا</para>
  <chapter number="1" style="c" sid="LAM 1" />
  <chapter eid="LAM 1" />
  <chapter number="2" style="c" sid="LAM 2" />
  <chapter eid="LAM 2" />
  <chapter number="3" style="c" sid="LAM 3" />
  <para style="ms3">بسم الله تبارك وتعالى</para>
  <para style="p">
    <verse number="22" style="v" sid="LAM 3:22" />وفاء الله لا ينقطع<verse eid="LAM 3:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="LAM 3:23" />أجل، إحسانه باق إلى الأبد</para>
  <para style="q1" vid="LAM 3:23">اللهمّ ما أعظم إخلاصك<verse eid="LAM 3:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="LAM 3:24" />فهو يتجدّد مع كلّ صباحٍ</para>
  <para style="q1" vid="LAM 3:24">فأناجي نفسي</para>
  <para style="q1" vid="LAM 3:24">لأنّك يا الله ثروتي ونصيبي، وعليك أتوكّل.<verse eid="LAM 3:24" /></para>
  <chapter eid="LAM 3" />
  <chapter number="4" style="c" sid="LAM 4" />
  <chapter eid="LAM 4" />
  <chapter number="5" style="c" sid="LAM 5" />
