  <book code="HOS" style="id">- True Meaning Arabic</book>
  <para style="toc3">من الوحي إلى هوشع</para>
  <para style="toc2">من الوحي إلى هوشع</para>
  <para style="toc1">من الوحي إلى النّبيّ هوشع</para>
  <para style="mt1">من الوحي إلى النّبيّ هوشع</para>
  <chapter number="1" style="c" sid="HOS 1" />
  <chapter eid="HOS 1" />
  <chapter number="2" style="c" sid="HOS 2" />
  <chapter eid="HOS 2" />
