<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="AMO" style="id">- True Meaning Arabic</book>
  <para style="toc3">من الوحي إلى عاموس</para>
  <para style="toc2">من الوحي إلى عاموس</para>
  <para style="toc1">من الوحي إلى النّبيّ عاموس</para>
  <para style="mt1">من الوحي إلى النّبيّ عاموس</para>
  <chapter number="1" style="c" sid="AMO 1" />
  <chapter eid="AMO 1" />
  <chapter number="2" style="c" sid="AMO 2" />
  <chapter eid="AMO 2" />
  <chapter number="3" style="c" sid="AMO 3" />
  <chapter eid="AMO 3" />
  <chapter number="4" style="c" sid="AMO 4" />
  <chapter eid="AMO 4" />
  <chapter number="5" style="c" sid="AMO 5" />
  <para style="ms3">بسم الله تبارك وتعالى</para>
  <para style="p">
    <verse number="21" style="v" sid="AMO 5:21" />قال الله تعالى: "أبغض أعيادَكم وأرفضها، ولا أرضى بشعائركم الدينيّة. <verse eid="AMO 5:21" /><verse number="22" style="v" sid="AMO 5:22" />وكلّ ما تقدّمونه لي من أضاحٍ وقرابين لا أقبله، ولا أرضى بالذبائح الّتي تمنحونها باسم التقارب والمصالحة فيما بينكم. <verse eid="AMO 5:22" /><verse number="23" style="v" sid="AMO 5:23" />ابعدوا عنّي صخب أناشيدكم، فما أنا بسميع لها. <verse eid="AMO 5:23" /><verse number="24" style="v" sid="AMO 5:24" />ولكنّي أدعوكم أن تقيموا العدل وتجعلوه بينكم كفيض من المياه، وأن تتّبعوا الاستقامة دائما، فتنساب فيكم كنهرٍ لا ينقطع سيله."<verse eid="AMO 5:24" /></para>
  <chapter eid="AMO 5" />
  <chapter number="6" style="c" sid="AMO 6" />
  <chapter eid="AMO 6" />
  <chapter number="7" style="c" sid="AMO 7" />
  <chapter eid="AMO 7" />
  <chapter number="8" style="c" sid="AMO 8" />
  <chapter eid="AMO 8" />
  <chapter number="9" style="c" sid="AMO 9" />
  <para style="p">
    <verse number="7" style="v" sid="AMO 9:7" />قال الله تعالى: "يا بني يعقوب، هل أنتم أرفع مقاما عندي من أهل كوش؟ أجل، أنا الذي أُخرجتكم من أرض مصر، ولكنّي أخرجت من قبلكم أهل فلسطيا من بلاد كفتور والآراميّين مِن بلاد قير."<verse eid="AMO 9:7" /></para>
  <chapter eid="AMO 9" />
</usx>