<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="GEN" style="id">– Romani Čergaš Biblija (RČB)</book>
  <para style="h">1. Mojsije</para>
  <para style="toc1">Prvo knjiga e Mojsiješći</para>
  <para style="toc2">1. Mojsije</para>
  <para style="toc3">1. Mojs</para>
  <para style="mt1">Prvo knjiga e Mojsiješći</para>
  <chapter number="1" style="c" sid="GEN 1" />
  <para style="s">O Del stvoril o nebo thaj e phuv</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 1:1" />Ando početko stvorisarda o Del o nebo thaj e phuv. <verse eid="GEN 1:1" /><verse number="2" style="v" sid="GEN 1:2" />E phuv nas oblikujime thaj sas čuči. E tama sas opral po bezdan thaj e Devlesko Duho lebdilas opral pe paja.<verse eid="GEN 1:2" /></para>
  <para style="s">Prvo đes stvorime si o svetlo</para>
  <para style="p">
    <verse number="3" style="v" sid="GEN 1:3" />Askal o Del phendas: “Neka avel o svetlo.”</para>
  <para style="p" vid="GEN 1:3">Thaj sas svetlo. <verse eid="GEN 1:3" /><verse number="4" style="v" sid="GEN 1:4" />O Del dikhla kaj svetlo si lačho thaj razdvojisarda o svetlost katar e tama. <verse eid="GEN 1:4" /><verse number="5" style="v" sid="GEN 1:5" />O Del akharda o svetlo “đes”, a e tama akharda “rjat”.</para>
  <para style="p" vid="GEN 1:5">Thaj sas rjat, thaj sas e detharin – đes prvo.<verse eid="GEN 1:5" /></para>
  <para style="s">Dujto đes stvorime si o nebo</para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 1:6" />Askal o Del phendas: “Neka avel svodo maškar e paja, te razdvojil e paja save si opral o svodo katar e paja save si tele.”<verse eid="GEN 1:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="GEN 1:7" />Thaj o Del ćerda svodo thaj razdvojisarda e paja talo svodo katar e paja opral o svodo. Thaj sas gajda. <verse eid="GEN 1:7" /><verse number="8" style="v" sid="GEN 1:8" />O Del akhardas o svodo “nebo”.</para>
  <para style="p" vid="GEN 1:8">Thaj sas rjat, thaj sas detharin – dujto đes.<verse eid="GEN 1:8" /></para>
  <para style="s">Trito đes stvorime si o kopno thaj biljke</para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 1:9" />Askal o Del phendas: “Neka e paja talo nebo ćiden pes pe jek than thaj neka sikadol o kopno.”</para>
  <para style="p" vid="GEN 1:9">Thaj sas gajda. <verse eid="GEN 1:9" /><verse number="10" style="v" sid="GEN 1:10" />O Del akharda o kopno “phuv”, a e ćidine paja “more”. Thaj o Del dikhla kaj si godova lačhe.<verse eid="GEN 1:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="GEN 1:11" />Askal o Del phendas: “Neka e phuv bijanel bilje: svako vrsta biljke save den seme thaj plodonosne kašta save bijanen plodo e semenosa.”</para>
  <para style="p" vid="GEN 1:11">Thaj sas gajda. <verse eid="GEN 1:11" /><verse number="12" style="v" sid="GEN 1:12" />E phuv bijandas svako vrsta biljke save den seme thaj svako vrsta kašta save bijanen plodo e semenosa. Thaj o Del dikhla kaj si godova lačhe.<verse eid="GEN 1:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="GEN 1:13" />Thaj sas rjat, thaj sas detharin – trito đes.<verse eid="GEN 1:13" /></para>
  <para style="s">Štarto đes stvorime si o kham, o čhonut thaj e čereja</para>
  <para style="p">
    <verse number="14" style="v" sid="GEN 1:14" />Askal o Del phendas: “Neka aven svetla po nebesko svodo, te razdvojin o đes katar e rjat thaj te označin e odredime vrjama, e đesa thaj e brša. <verse eid="GEN 1:14" /><verse number="15" style="v" sid="GEN 1:15" />Thaj neka e svetla po nebesko svodo osvetlin e phuv.”</para>
  <para style="p" vid="GEN 1:15">Thaj sas gajda. <verse eid="GEN 1:15" /><verse number="16" style="v" sid="GEN 1:16" />O Del stvorisarda duj bare svetla: o kham te vladil e đesesa thaj o čhonut te vladil e raćava. Thaj stvorisarda e čereja. <verse eid="GEN 1:16" /><verse number="17" style="v" sid="GEN 1:17" />O Del čhuta len po nebesko svodo te osvetlin e phuv, <verse eid="GEN 1:17" /><verse number="18" style="v" sid="GEN 1:18" />te vladin e đesesa thaj e raćava thaj te razdvojin o svetlost katar e tama. Thaj o Del dikhla kaj si godova lačhe.<verse eid="GEN 1:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="GEN 1:19" />Thaj sas rjat, thaj sas detharin – đes štarto.<verse eid="GEN 1:19" /></para>
  <para style="s">Pandžto đes stvorime si e mačhe thaj e čiriklja</para>
  <para style="p">
    <verse number="20" style="v" sid="GEN 1:20" />Askal o Del phendas: “Neka e paja vrvin katar e džude bićurja thaj nek e čiriklja furjan opral pe phuv po nebesko svodo.”<verse eid="GEN 1:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="GEN 1:21" />O Del stvorisarda e bare morske životinjen, thaj sa e džude bićen save plivin ando paj thaj katar save o paj vrvil, prema lenđe vrste, thaj sa pakhale čirikljen prema lenđe vrste. Thaj o Del dikhla kaj si godova lačhe.<verse eid="GEN 1:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="GEN 1:22" />O Del blagoslovisarda len thaj phendas: “Aven plodne thaj množin tumen thaj pheren e morske paja. Thaj neka e čiriklja množin pes pe phuv.”<verse eid="GEN 1:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="GEN 1:23" />Thaj sas rjat, thaj sas detharin – đes pandžto.<verse eid="GEN 1:23" /></para>
  <para style="s">Šovto đes stvorime si e životinje po kopno thaj o manuš</para>
  <para style="p">
    <verse number="24" style="v" sid="GEN 1:24" />Askal o Del phendas: “Neka e phuv mućel andar peste džude bićen prema lenđe vrste: e stoka, e bićen save crden pes pe phuv thaj e divlje životinjen prema lenđe vrste.”</para>
  <para style="p" vid="GEN 1:24">Thaj sas gajda. <verse eid="GEN 1:24" /><verse number="25" style="v" sid="GEN 1:25" />O Del ćerda divlje životinjen prema lenđe vrste, e stoka prema laći vrsta thaj e bićen save crden pes pe phuv prema lenđe vrste. Thaj o Del dikhla kaj si godova lačhe.<verse eid="GEN 1:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="GEN 1:26" />Askal o Del phendas: “Hajde te ćeras manušes pe amari slika, te avel sago kaj sam amen. Neka avel e manušen vlast pe mačhe ando more thaj pe čiriklja po nebo, pe stoka, pe sasti phuv thaj pe sa bićurja save crden pes pe phuv.”<verse eid="GEN 1:26" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="27" style="v" sid="GEN 1:27" />Thaj o Del stvorisarda e manušes</para>
  <para style="q2" vid="GEN 1:27">pe piri slika.</para>
  <para style="q1" vid="GEN 1:27">Pe Devlešći slika</para>
  <para style="q2" vid="GEN 1:27">stvorisarda les,</para>
  <para style="q1" vid="GEN 1:27">muško thaj žensko</para>
  <para style="q2" vid="GEN 1:27">stvorisarda len.<verse eid="GEN 1:27" /></para>
  <para style="b" />
  <para style="p">
    <verse number="28" style="v" sid="GEN 1:28" />O Del blagoslovisarda len thaj phendas lenđe: “Aven plodne thaj množin tumen, pheren e phuv thaj podložin e phuv tumenđe! Vladin pe mačhe ando more thaj pe čiriklja po nebo thaj pe sa bićurja save crden pes pe phuv.”<verse eid="GEN 1:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="GEN 1:29" />Askal o Del phendas: “Ake, pe sasti phuv dav tumen svako biljka savi del seme thaj svako kaš savo bijanel plodo saves si seme ande leste – neka aven tumenđe palo hamasko. <verse eid="GEN 1:29" /><verse number="30" style="v" sid="GEN 1:30" />A sa e divlje životinjenđe, sa e čirikljenđe thaj sa e bićenđe save crden pes pe phuv – sa so ande peste si les daho e trajosko – dav sa o zeleno bilje palo hamasko.”</para>
  <para style="p" vid="GEN 1:30">Thaj sas gajda.<verse eid="GEN 1:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="GEN 1:31" />Askal o Del dikhla sa so stvorisarda thaj dikhla kaj si godova but lačhe.</para>
  <para style="p" vid="GEN 1:31">Thaj sas rjat thaj sas detharin – đes šovto.<verse eid="GEN 1:31" /></para>
  <chapter eid="GEN 1" />
  <chapter number="2" style="c" sid="GEN 2" />
  <para style="p">
    <verse number="1" style="v" sid="GEN 2:1" />Gajda sas završime o nebo thaj e phuv thaj sa pe lende.<verse eid="GEN 2:1" /></para>
  <para style="s">Eftato đes – odmor</para>
  <para style="p">
    <verse number="2" style="v" sid="GEN 2:2" />Dži ke eftato đes o Del završisarda piro delo savo ćerda, a eftato đes odmorisajlo katar sa pire dela. <verse eid="GEN 2:2" /><verse number="3" style="v" sid="GEN 2:3" />Askal o Del blagoslovisardas o eftato đes, thaj posvetisarda les, kaj o eftato đes odmorisajlo katar sa pire dela save stvorisarda.<verse eid="GEN 2:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="GEN 2:4" />Gajda sas stvorime o nebo thaj e phuv.</para>
  <para style="s" vid="GEN 2:4">Edensko vrto</para>
  <para style="p" vid="GEN 2:4">Kana o Del stvorisarda e phuv thaj o nebo, <verse eid="GEN 2:4" /><verse number="5" style="v" sid="GEN 2:5" />pe phuv još či niknisardine ni e divlje, a ni e poljske biljke. O GOSPOD, o Del, još či mukla o bršnd pe phuv thaj nas manuš te ćerel bući pe late, <verse eid="GEN 2:5" /><verse number="6" style="v" sid="GEN 2:6" />ali ipak o paj inkljelas andar e phuv thaj natopilas e površina e phuvjaći.<verse eid="GEN 2:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="GEN 2:7" />Askal o GOSPOD, o Del, oblikuisarda e manuše katar e phuvjako praho, thaj ande lesko nak phurdas o daho e trajosko, thaj o manuš postanisada džudo biće. <verse eid="GEN 2:7" /><verse number="8" style="v" sid="GEN 2:8" />Pale godova o GOSPOD, o Del, zasadisardas vrto po istoko, ando Eden, thaj ande leste čhuta e manuše saves oblikuisarda. <verse eid="GEN 2:8" /><verse number="9" style="v" sid="GEN 2:9" />O GOSPOD, o Del, ćerda te andar e phuv niknol svako vrsne kaš, save sas primamljive pire izgledosa thaj lačhe palo habe, a maškare ando vrto sas o kaš savo del trajo, thaj o kaš savo del džanglipe so si lačhe thaj bilačhe.<verse eid="GEN 2:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 2:10" />Andar o Eden izvirilas e reka savi natopilas o vrto, a okotar razdelilas pes pe štar reke. <verse eid="GEN 2:10" /><verse number="11" style="v" sid="GEN 2:11" />E prvo reka akhardolas Pišon thaj thavdel oko e sasti phuv Havile, ande savi si sunakaj. <verse eid="GEN 2:11" /><verse number="12" style="v" sid="GEN 2:12" />O sunakaj andar godoja phuv si zurale čisto, a ande late si vi mirisne smole thaj e drage bara oniks. <verse eid="GEN 2:12" /><verse number="13" style="v" sid="GEN 2:13" />E dujto reka akhardol Gihon, thaj thavdel oko e sasti phuv Kuš. <verse eid="GEN 2:13" /><verse number="14" style="v" sid="GEN 2:14" />E trito reka akhardol Tigar, thaj thavdel istočno katar e Asirija. A e štarto reka si Eufrat.<verse eid="GEN 2:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="GEN 2:15" />O GOSPOD, o Del, lijas e manuše thaj čhuta les ando edensko vrto, te ćerel bući ande leste thaj te održavil les. <verse eid="GEN 2:15" /><verse number="16" style="v" sid="GEN 2:16" />O GOSPOD, o Del, zapovedisardas e manušešće: “Katar svako kaš savo si ando vrto slobodno ha, <verse eid="GEN 2:16" /><verse number="17" style="v" sid="GEN 2:17" />ali katar o kaš savo del džanglipe so si lačhe thaj bilačhe te na has! Kaj godova đes kana okusija katar godova kaš, sigurno mereja.”<verse eid="GEN 2:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 2:18" />Askal o GOSPOD, o Del, phendas: “Naj lačhe palo manuš te avel korkoro. Ćerava lešće lačhi pomoćnica.”<verse eid="GEN 2:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="GEN 2:19" />Askal o GOSPOD, o Del, katar e phuv oblikuisarda sa e divlje životinjen thaj sa e čirikljen po nebo, thaj anda len anglo manuš, te dićhel sar dela len alav. Thaj sar o manuš dijas alav e džude bićen, gajda sas lengo alav. <verse eid="GEN 2:19" /><verse number="20" style="v" sid="GEN 2:20" />Gajda o manuš dija alava sa e stokaće, e čirikljenđe thaj e divlje životinjenđe.</para>
  <para style="p" vid="GEN 2:20">Ali ipak palo Adam či arakhadili lačhi pomoćnica. <verse eid="GEN 2:20" /><verse number="21" style="v" sid="GEN 2:21" />Zato o Del ćerda te o manuš perel ando zuralo sovipe thaj dok o manuš sovelas, inkalda lesko jek pašvaro, a godova than pherdas e maseja. <verse eid="GEN 2:21" /><verse number="22" style="v" sid="GEN 2:22" />Katar o pašvaro savo lijas andar o manuš o GOSPOD, o Del, ćerda manušnja thaj anda lat anglo manuš.<verse eid="GEN 2:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="GEN 2:23" />A o manuš pe godova phendas:</para>
  <para style="b" vid="GEN 2:23" />
  <para style="q1" vid="GEN 2:23">“Ake, akava si kokala katar mungre kokala,</para>
  <para style="q2" vid="GEN 2:23">thaj telo katar mungro telo!</para>
  <para style="q1" vid="GEN 2:23">Neka zato akhardol manušnji,</para>
  <para style="q2" vid="GEN 2:23">kaj si lini katar o manuš!”<verse eid="GEN 2:23" /></para>
  <para style="b" />
  <para style="p">
    <verse number="24" style="v" sid="GEN 2:24" />Zato o manuš mućela pire dade thaj pire deja thaj avela jek piri romnjasa thaj von duj džene avena jek telo.<verse eid="GEN 2:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="GEN 2:25" />A liduj sas nanđe, vi o manuš thaj vi lešći romnji, thaj či ladžanas.<verse eid="GEN 2:25" /></para>
  <chapter eid="GEN 2" />
  <chapter number="3" style="c" sid="GEN 3" />
  <para style="s">E manušesko peripe ando bezah</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 3:1" />O sap sas majlukavo katar sa e divlje životinje save o GOSPOD, o Del, ćerda.</para>
  <para style="p" vid="GEN 3:1">O sap phučla e manušnja: “Zar o Del vi čače phendas: ‘Či troman te hana ni katar jek kaš andar o vrto’?”<verse eid="GEN 3:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="GEN 3:2" />A e manušnji phendas lešće: “Tromas te has e plodurja katar e kaš ando vrto, <verse eid="GEN 3:2" /><verse number="3" style="v" sid="GEN 3:3" />ali palo plodo e kaštesko savo si maškare ando vrto o Del phendas: ‘Na han lestar thaj na dirin les, te na meren!’ ”<verse eid="GEN 3:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="GEN 3:4" />Askal o sap phendas e manušnjaće: “Na, tumen či merena. <verse eid="GEN 3:4" /><verse number="5" style="v" sid="GEN 3:5" />Nego, džanel o Del, kaj ande godova đes kana hana lestar putrena pes tumare jakha thaj avena sago o Del – džanena so si lačhipe thaj so si bilačhipe.”<verse eid="GEN 3:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 3:6" />E manušnji dikhla kaj o plodo e kaštesko si lačho palo habe, primamljivo e jakhenđe thaj poželjno pale mudrost savi šaj del. Askal kušlas o plodo e kaštestar thaj hala. A dija vi pire rome, savo sas lasa, pa vi vo halas. <verse eid="GEN 3:6" /><verse number="7" style="v" sid="GEN 3:7" />Askal lidujenđe putajle e jakha thaj džangline kaj si nanđe. Zato ćerdine pešće katar e smokvaće patrja pregače te učharen pe.<verse eid="GEN 3:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 3:8" />Pe godova o manuš thaj e manušnji ašundine e korakurja kaj o GOSPOD, o Del, phirelas po vrto pale vrjama kana phurdelas e raćaći balvajori, pa garadile lestar maškar e kašta ando vrto.<verse eid="GEN 3:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 3:9" />Ali o GOSPOD, o Del, akharda e manuše thaj phučla les: “Kaj san?”<verse eid="GEN 3:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 3:10" />O manuš phendas: “Ašundem tut kaj phires ando vrto thaj darajlem, kaj sem nango, pa garadilem.”<verse eid="GEN 3:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="GEN 3:11" />O Del phučla les: “Ko phendas tuće kaj san nango? Dali halan e kaštestar pale savo zapovedisardem tuće te na has lestar?”<verse eid="GEN 3:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="GEN 3:12" />A o manuš phendas e Devlešće: “E manušnja savja tu čhutan te avel manca, dija man o plodo e kaštesko thaj halem.”<verse eid="GEN 3:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="GEN 3:13" />Askal o GOSPOD, o Del, phučla e manušnja: “So godova ćerdan?”</para>
  <para style="p" vid="GEN 3:13">E manušnji phendas: “O sap hohada man, thaj zato halem.”<verse eid="GEN 3:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="GEN 3:14" />Askal o GOSPOD, o Del, phendas e sapešće:</para>
  <para style="b" vid="GEN 3:14" />
  <para style="q1" vid="GEN 3:14">“Sostar godova ćerdan,</para>
  <para style="q2" vid="GEN 3:14">prokleto te aves maškar sa e stoka</para>
  <para style="q2" vid="GEN 3:14">thaj maškar sa e divlje životinje!</para>
  <para style="q1" vid="GEN 3:14">Pe ćiro đi crdeja tut</para>
  <para style="q2" vid="GEN 3:14">thaj haja praho e phuvjako</para>
  <para style="q2" vid="GEN 3:14">ande sa e đesa ćire trajosko.<verse eid="GEN 3:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="GEN 3:15" />A me čhava neprijateljstvo</para>
  <para style="q2" vid="GEN 3:15">maškar tute thaj maškar e manušnji,</para>
  <para style="q1" vid="GEN 3:15">maškar ćiro potomstvo</para>
  <para style="q2" vid="GEN 3:15">thaj maškar lako potomstvo.</para>
  <para style="q1" vid="GEN 3:15">Lako potomstvo uštavela ćiro šoro,</para>
  <para style="q2" vid="GEN 3:15">a tu haja les pale khuv.”<verse eid="GEN 3:15" /></para>
  <para style="b" />
  <para style="p">
    <verse number="16" style="v" sid="GEN 3:16" />A e manušnjaće phendas:</para>
  <para style="b" vid="GEN 3:16" />
  <para style="q1" vid="GEN 3:16">“Ando khamnipe ćire muke umnoživa;</para>
  <para style="q2" vid="GEN 3:16">ande muke čhavren bijaneja.</para>
  <para style="q1" vid="GEN 3:16">A još uvek manđeja te aves ćire romesa,</para>
  <para style="q2" vid="GEN 3:16">ali vo vladila pe tute.”<verse eid="GEN 3:16" /></para>
  <para style="b" />
  <para style="p">
    <verse number="17" style="v" sid="GEN 3:17" />Askal phendas e manušešće:</para>
  <para style="b" vid="GEN 3:17" />
  <para style="q1" vid="GEN 3:17">“Zato kaj čhutan kan ke ćiri romnji</para>
  <para style="q2" vid="GEN 3:17">thaj halan e kaštestar</para>
  <para style="q1" vid="GEN 3:17">pale savo zapovedisardem tuće,</para>
  <para style="q2" vid="GEN 3:17">te na has:</para>
  <para style="q1" vid="GEN 3:17">E phuv neka avel prokleto zbog tute;</para>
  <para style="q2" vid="GEN 3:17">ande phare muke latar pravareja tut,</para>
  <para style="q2" vid="GEN 3:17">sa e đesa ćire trajosko.<verse eid="GEN 3:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="GEN 3:18" />Bijanela tuće kangre thaj korovo,</para>
  <para style="q2" vid="GEN 3:18">a tu pravareja tut e poljske biljkenca.<verse eid="GEN 3:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="GEN 3:19" />Ando znojo ćire mujesko haja mangro,</para>
  <para style="q2" vid="GEN 3:19">dok ande phuv či boldes tut,</para>
  <para style="q1" vid="GEN 3:19">kaj katar e phuv san ćerdo</para>
  <para style="q2" vid="GEN 3:19">– praho san thaj ando praho boldeja tut.”<verse eid="GEN 3:19" /></para>
  <para style="b" />
  <para style="p">
    <verse number="20" style="v" sid="GEN 3:20" />O manuš dija pire romnja alav Eva, kaj voj si dej sa e manušenđe.<verse eid="GEN 3:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="GEN 3:21" />O GOSPOD, o Del, ćerda e manušešće thaj lešće romnjaće drze katar e morćhi thaj dija pe lende.<verse eid="GEN 3:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="GEN 3:22" />Askal o GOSPOD, o Del, phendas: “Ake, o manuš postanisardas sago jek amendar – džanel so si lačhipe thaj bilačhipe. Akana či tromas te mukas te inzarel piro vas thaj te kušel katar o kaš e trajosko, te na hal thaj te trajil uvek!”<verse eid="GEN 3:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="GEN 3:23" />Zato o GOSPOD, o Del, trada les andar o edensko vrto, te ćerel bući pe phuv, katar savi sas ćerdo. <verse eid="GEN 3:23" /><verse number="24" style="v" sid="GEN 3:24" />Kana trada e manušes andar o edensko vrto, čhuta istočno katar o edensko vrto e heruvimen thaj jagalo mačo, savo phirelas pe sa e riga, te len sama po drom karingal o kaš e trajosko.<verse eid="GEN 3:24" /></para>
  <chapter eid="GEN 3" />
  <chapter number="4" style="c" sid="GEN 4" />
  <para style="s">O Kain thaj o Avelj</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 4:1" />O Adam pašljilo pire romnjava e Evava, pa voj ačhili khamni thaj bijanda e Kaine.</para>
  <para style="p" vid="GEN 4:1">E Eva askal phendas: “O GOSPOD pomognisarda manđe thaj dobisardem muško čhave!”<verse eid="GEN 4:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="GEN 4:2" />Pale godova voj bijandas vi e Kainešće phrale e Avelje. O Avelj postanisarda pastiri, a o Kain zemljoradniko. <verse eid="GEN 4:2" /><verse number="3" style="v" sid="GEN 4:3" />Kana nakhli varesavi vrjama o Kain anda žrtva e GOSPODEŠĆE katar e plodurja e phuvjaće. <verse eid="GEN 4:3" /><verse number="4" style="v" sid="GEN 4:4" />A o Avelj anda majlačhe makhle kotora mas katar e životinje save prve bijandile ande lesko stado. O GOSPOD prihvatisarda e Avelje thaj lešći žrtva, <verse eid="GEN 4:4" /><verse number="5" style="v" sid="GEN 4:5" />ali e Kaine thaj lešći žrtva či prihvatisarda. Zato o Kain zurale holjajlo thaj lesko muj namrgodisajlo.<verse eid="GEN 4:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 4:6" />O GOSPOD phučla e Kaine: “Sostar holjavos thaj sostar ćiro muj namrgodisajlo? <verse eid="GEN 4:6" /><verse number="7" style="v" sid="GEN 4:7" />Ako ćeres okova so si lačhe, zar či prihvativa tut? A ako či ćeres okova so si lačhe, o bezeh vrebol pe ćiro vudar, vo kamel te svladil tut, ali tu moraš te nadvladis les.”<verse eid="GEN 4:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 4:8" />O Kain phendas pire phralešće e Avelješće: “Hajde džas avri ando polje.” Ali kana inkljistine avri ando polje, o Kain huklo pe piro phral po Avelj thaj mudarda les.<verse eid="GEN 4:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 4:9" />Pale godova o GOSPOD phučlas e Kaine: “Kaj si ćiro phral o Avelj?”</para>
  <para style="p" vid="GEN 4:9">O Kain phendas: “Či džanav. Zar sem me čuvari mungre phralesko?”<verse eid="GEN 4:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 4:10" />Askal o GOSPOD phendas: “So godova ćerdan? Ake, o rat ćire phralesko andar e phuv čhol muj mande. <verse eid="GEN 4:10" /><verse number="11" style="v" sid="GEN 4:11" />Zato av prokleto thaj tradino katar e phuv, savi putardas piro muj te nakhavel o rat ćire phralesko katar ćire vas. <verse eid="GEN 4:11" /><verse number="12" style="v" sid="GEN 4:12" />Kana ćereja bući pe late, voj majbut či dela tut piro rodo. Aveja lutalica thaj begunco pe phuv.”<verse eid="GEN 4:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="GEN 4:13" />O Kain phendas e GOSPODEŠĆE: “Mungri kazna si majbari nego so šaj inćarav. <verse eid="GEN 4:13" /><verse number="14" style="v" sid="GEN 4:14" />Ake ađes trades man katar akaja phuv thaj moraš te garadova katar ćiro muj. Avava lutalica thaj begunco pe phuv, thaj kogod araćhel man, mudarela man.”<verse eid="GEN 4:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="GEN 4:15" />Ali o GOSPOD phendas: “Či avela gajda! Ako vareko mudarel e Kaine, aresela les efta drom majbari osveta!”</para>
  <para style="p" vid="GEN 4:15">Thaj o GOSPOD čhuta po Kain znako, te či vareko mudarel les kana malavela les.<verse eid="GEN 4:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="GEN 4:16" />Askal o Kain đelotar katar o GOSPOD thaj naselisajlo pe phuv Nod, istočno katar o Eden.<verse eid="GEN 4:16" /></para>
  <para style="s">E Kainošće potomkurja</para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 4:17" />O Kain pašljilo pire romnjasa thaj voj ačhili khamni thaj bijandas e Enohe. O Kain sagradisardas gav thaj dija les alav Enoh sago kaj bučhol lesko čhavo. <verse eid="GEN 4:17" /><verse number="18" style="v" sid="GEN 4:18" />E Enohešće bijandilo o Irad, e Iradešće bijandilo o Mehujael, e Mehujaelešće bijandilo o Metušael, a e Metušaelešće bijandilo o Lameh.<verse eid="GEN 4:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="GEN 4:19" />E Lamehe sas duj romnja: jek akhardolas Ada, a aver Cila. <verse eid="GEN 4:19" /><verse number="20" style="v" sid="GEN 4:20" />E Ada bijandas e Javale, savo sas pradad okolengo save trajin tale šatorja thaj inćaren e stoka. <verse eid="GEN 4:20" /><verse number="21" style="v" sid="GEN 4:21" />Lesko phral akhardolas Juval a vo sas pradad okolengo save đilaben ande harfa thaj flauta. <verse eid="GEN 4:21" /><verse number="22" style="v" sid="GEN 4:22" />E Cila bijanda e Tubal-Kaine savo sas kovači thaj ćerelas alato katar o bakar thaj o sastri. E Tubal-Kainešći phen akhardolas Naama.<verse eid="GEN 4:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="GEN 4:23" />O Lameh phendas pire romnjenđe:</para>
  <para style="b" vid="GEN 4:23" />
  <para style="q1" vid="GEN 4:23">“Ada thaj Cila, čhon kan mande,</para>
  <para style="q2" vid="GEN 4:23">romnjalen e Lamehešće, ašunen mungre alava.</para>
  <para style="q1" vid="GEN 4:23">Mudardem e manuše zato kaj ranisarda man,</para>
  <para style="q2" vid="GEN 4:23">e terne čhaves zato kaj dija man dab.<verse eid="GEN 4:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="GEN 4:24" />Ako o Kain avela efta drom osvetime,</para>
  <para style="q2" vid="GEN 4:24">o Lameh avela eftavardeš thaj efta drom.”<verse eid="GEN 4:24" /></para>
  <para style="s">O Sit thaj o Enoh</para>
  <para style="p">
    <verse number="25" style="v" sid="GEN 4:25" />O Adam palem pašljilo pire romnjava thaj voj bijandas čhaves. Dija les alav Sit thaj phendas: “O Del dija man aver čhaves umesto o Avelj, saves o Kain mudardas.”<verse eid="GEN 4:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="GEN 4:26" />Thaj e Sitošće bijandilo čhavo thaj vo dija les alav Enos.</para>
  <para style="p" vid="GEN 4:26">Ande godoja vrjama e manuša počnisardine te slavin e GOSPODESKO alav.<verse eid="GEN 4:26" /></para>
  <chapter eid="GEN 4" />
  <chapter number="5" style="c" sid="GEN 5" />
  <para style="s">E Adamešće potomkurja</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 5:1" />Akava si ramome pale Adamesko poreklo:</para>
  <para style="p" vid="GEN 5:1">Kana o Del stvorisarda e manuše, ćerda les te avel slično lešće. <verse eid="GEN 5:1" /><verse number="2" style="v" sid="GEN 5:2" />Stvorisarda muško thaj žensko thaj blagoslovisarda len. A kana stvorisarda len, akharda len “manuš”.<verse eid="GEN 5:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="GEN 5:3" />Kana e Adame sas šel thaj trijanda brš, bijandilo lešće čhavo savo sas slično lešće thaj sas sago kaj si vo, thaj dija les alav Sit. <verse eid="GEN 5:3" /><verse number="4" style="v" sid="GEN 5:4" />Posle e Sitesko bijandipe, o Adam trajisarda još ohto šela brš thaj sas les još čhave thaj čheja. <verse eid="GEN 5:4" /><verse number="5" style="v" sid="GEN 5:5" />Gajda o Adam trajisarda inja šela thaj trijanda brš thaj mulo.<verse eid="GEN 5:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 5:6" />Kana e Sites sas šel thaj pandž brš, bijandilo lešće o Enos. <verse eid="GEN 5:6" /><verse number="7" style="v" sid="GEN 5:7" />Posle Enosesko bijandipe, o Sit trajisarda još ohto šela thaj efta brš thaj sas les još čhave thaj čheja. <verse eid="GEN 5:7" /><verse number="8" style="v" sid="GEN 5:8" />Gajda o Sit trajisarda inja šela thaj dešuduj brš thaj mulo.<verse eid="GEN 5:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 5:9" />Kana e Enose sas injavrdeš brš, bijandilo lešće o Kainam. <verse eid="GEN 5:9" /><verse number="10" style="v" sid="GEN 5:10" />Posle Kainamesko bijandipe, o Enos trajisarda još ohto šela thaj dešupandž brš thaj sas les još čhave thaj čheja. <verse eid="GEN 5:10" /><verse number="11" style="v" sid="GEN 5:11" />Gajda o Enos trajisarda inja šela thaj pandž brš thaj mulo.<verse eid="GEN 5:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="GEN 5:12" />Kana e Kaine sas eftavardeš brš, bijandilo lešće o Malaleilo. <verse eid="GEN 5:12" /><verse number="13" style="v" sid="GEN 5:13" />Posle Malaleilesko bijandipe, o Kainam trajisarda još ohto šela thaj štarvardeš brš thaj sas les još čhave thaj čheja. <verse eid="GEN 5:13" /><verse number="14" style="v" sid="GEN 5:14" />Gajda o Kainam trajisarda inja šela thaj deš brš thaj mulo.<verse eid="GEN 5:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="GEN 5:15" />Kana e Malaleile sas šovardeš thaj pandž brš, bijandilo lešće o Jaret. <verse eid="GEN 5:15" /><verse number="16" style="v" sid="GEN 5:16" />Posle Jaretesko bijandipe, o Malaleilo trajisarda još ohto šela thaj trijanda brš thaj sas les još čhave thaj čheja. <verse eid="GEN 5:16" /><verse number="17" style="v" sid="GEN 5:17" />Gajda o Malaleilo trajisarda ohto šela injavrdeš thaj pandž brš thaj mulo.<verse eid="GEN 5:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 5:18" />Kana e Jarete sas šel thaj šovardeš thaj duj brš, bijandilo lešće o Enoh. <verse eid="GEN 5:18" /><verse number="19" style="v" sid="GEN 5:19" />Posle Enohesko bijandipe, o Jaret trajisarda još ohto šela brš thaj sas les još čhave thaj čheja. <verse eid="GEN 5:19" /><verse number="20" style="v" sid="GEN 5:20" />Gajda o Jaret trajisarda inja šela šovardeš thaj duj brš thaj mulo.<verse eid="GEN 5:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="GEN 5:21" />Kana e Enohe sas šovardeš thaj pandž brš, bijandilo lešće o Matusala. <verse eid="GEN 5:21" /><verse number="22" style="v" sid="GEN 5:22" />Posle Matusalesko bijandipe, o Enoh trajisarda trin šela brš ando blisko odnos e Devlesa thaj sas les još čhave thaj čheja. <verse eid="GEN 5:22" /><verse number="23" style="v" sid="GEN 5:23" />Gajda o Enoh trajisarda trin šela šovardeš thaj pandž brš. <verse eid="GEN 5:23" /><verse number="24" style="v" sid="GEN 5:24" />O Enoh trajisarda ando blisko odnos e Devleja, askal nestanisarda katar e phuv, kaj o Del lija les.<verse eid="GEN 5:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="GEN 5:25" />Kana e Matusale sas šel thaj ohtovardeš thaj efta brš, bijandilo lešće o Lameh. <verse eid="GEN 5:25" /><verse number="26" style="v" sid="GEN 5:26" />Posle Lamehesko bijandipe, o Matusala trajisarda još efta šela ohtovardeš thaj duj brš thaj sas les još čhave thaj čheja. <verse eid="GEN 5:26" /><verse number="27" style="v" sid="GEN 5:27" />Gajda o Matusala trajisarda inja šela šovardeš thaj inja brš thaj mulo.<verse eid="GEN 5:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="GEN 5:28" />Kana e Lamehe sas šel thaj ohtovardeš thaj duj brš, bijandilo lešće čhavo. <verse eid="GEN 5:28" /><verse number="29" style="v" sid="GEN 5:29" />Vo dija les alav Noja thaj phendas: “Akava utešila men ande mukotrpno bući savi moraš te ćeras zato kaj o GOSPOD dija romaja e phuv.” <verse eid="GEN 5:29" /><verse number="30" style="v" sid="GEN 5:30" />Posle Nojesko bijandipe, o Lameh trajisarda još pandž šela injavardeš thaj pandž brš thaj sas les još čhave thaj čheja. <verse eid="GEN 5:30" /><verse number="31" style="v" sid="GEN 5:31" />Gajda o Lameh trajisarda efta šela eftavardeš thaj efta brš thaj mulo.<verse eid="GEN 5:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="GEN 5:32" />Kana e Noje sas pandž šela brš, bijandile lešće o Sim, o Ham thaj o Jafet.<verse eid="GEN 5:32" /></para>
  <chapter eid="GEN 5" />
  <chapter number="6" style="c" sid="GEN 6" />
  <para style="s">E manušesko bilačhipe</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 6:1" />Kana e manuša počnisardine te množin pes pe phuv thaj bijandile lenđe čheja, <verse eid="GEN 6:1" /><verse number="2" style="v" sid="GEN 6:2" />e Devlešće čhave<note caller="+" style="f"><char style="fr" closed="false">6,2 </char><char style="ft" closed="false">E Devlešće čhave šaj tumačil pe sago nebeske bićurja, anđelurja ili čhave e caronenđe. </char></note> dikhline kaj si e manušenđe čheja šukar, pa lenas len penđe pale romnja savja god kamline.<verse eid="GEN 6:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="GEN 6:3" />Askal o GOSPOD phendas: “Mungro duho pale uvek či ačhela ando manuš, kaj si o manuš samo telo. Zato neka lesko veko avel šel thaj biš brš.”<verse eid="GEN 6:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="GEN 6:4" />Ande godoja vrjama pe phuv, a vi majposle, godola Devlešće čhave sutine e manušenđe čhejenca thaj von bijanenas lenđe čhaven save akhardonas Nefilimi. Godola si okola ratnikurja, manuša po glaso katar e purani vrjama.<verse eid="GEN 6:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="GEN 6:5" />O GOSPOD dikhla kozom si but baro e manušengo rumope pe phuv thaj kaj sa so gindil o manuš ande piro ilo si stalno samo bilačhipe. <verse eid="GEN 6:5" /><verse number="6" style="v" sid="GEN 6:6" />O GOSPOD požalisardas kaj ćerda e manuše po them thaj ražalostisajlo ande piro ilo.<verse eid="GEN 6:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="GEN 6:7" />Pa zato o GOSPOD phendas: “Khosava katar e phuv e manušen saven stvorisardem, zajedno e životinjenca, e nebeske čirikljenca thaj e bićenca save crden pes pe phuv, kaj požalisardem kaj ćerdem len.”<verse eid="GEN 6:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 6:8" />Ali o Noje arakhlas milost ande GOSPODEŠĆE jakha.<verse eid="GEN 6:8" /></para>
  <para style="s">O Noje thaj e priprema palo potop</para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 6:9" />Akava si ramome palo Noje:</para>
  <para style="p" vid="GEN 6:9">O Noje sas pravedno manuš savo trajilas besprekorno maškar e manuša ande lešći vrjama thaj sas ando blisko odnoso e Devlesa. <verse eid="GEN 6:9" /><verse number="10" style="v" sid="GEN 6:10" />Sas les trin čhave save akhardonas: Sim, Ham thaj Jafet.<verse eid="GEN 6:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="GEN 6:11" />Ali e phuv rumosajli anglo Del thaj sas pherdi nasilje.<verse eid="GEN 6:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="GEN 6:12" />O Del dikhla pe phuv, kaj sasti phuv rumosajli thaj svako manuš pe phuv sas rumome. <verse eid="GEN 6:12" /><verse number="13" style="v" sid="GEN 6:13" />Pa o Del phendas e Nojašće: “Odlučisardem te uništiv sa e manušen, kaj zbog lende e phuv pherdili nasilje. Ake, uništiva len zajedno e phuvjasa. <verse eid="GEN 6:13" /><verse number="14" style="v" sid="GEN 6:14" />Zato ćer tuće brodo katar o goferosko kaš, ando brodo ćer pregrade, a andral thaj avrjal mak o brodo e smolava. <verse eid="GEN 6:14" /><verse number="15" style="v" sid="GEN 6:15" />A gajda ćer o brodo: neka avel šel thaj trijanda thaj pandž meterja lungo, biš thaj duj tepaš meterja bulo thaj dešutrin tepaš meterja vučo. <verse eid="GEN 6:15" /><verse number="16" style="v" sid="GEN 6:16" />Po brodo ćer krovo gajda te mućes opaš meteri than talo vrho. Pe jek rig ćer vudar, a andral ando brodo ćer te avel teluno, srednjo thaj gornjo sprato.<verse eid="GEN 6:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 6:17" />Kaj me ake mukava o poplavno paj pe phuv te uništil sa ande soste si daho e trajosko. Sa pe phuv merela. <verse eid="GEN 6:17" /><verse number="18" style="v" sid="GEN 6:18" />Ali tusa sklopiva savez. Deja ando brodo, tu, ćiri romnji, ćire čhave thaj lenđe romnja. <verse eid="GEN 6:18" /><verse number="19" style="v" sid="GEN 6:19" />A katar sa e džude bićurja le tusa ando brodo po duj, muško thaj žensko, te ačhen džude zajedno tusa. <verse eid="GEN 6:19" /><verse number="20" style="v" sid="GEN 6:20" />Katar sa e vrste čiriklja, katar sa e vrste životinje thaj katar sa e vrste bićurja save crden pes pe phuv, neka po duj den tusa ando brodo, te ačhen džude. <verse eid="GEN 6:20" /><verse number="21" style="v" sid="GEN 6:21" />Le tusa sa so šaj hal pe, thaj arakh te avel palo habe tuće thaj vi lenđe.”<verse eid="GEN 6:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="GEN 6:22" />O Noja ćerda gajda sa sago kaj o Del zapovedisardas lešće.<verse eid="GEN 6:22" /></para>
  <chapter eid="GEN 6" />
  <chapter number="7" style="c" sid="GEN 7" />
  <para style="s">O Poplavne paja</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 7:1" />O GOSPOD phendas e Nojašće: “De andre ando brodo, tu thaj sasti ćiri familija, kaj dikhlem kaj san tu jedino pravedno angle mande maškar e manuša save trajin ande akaja vrjama. <verse eid="GEN 7:1" /><verse number="2" style="v" sid="GEN 7:2" />Le tusa efta parurja katar svako čisto životinja, muško thaj žensko, ali katar svako marime životinja samo jek paro, muško thaj žensko. <verse eid="GEN 7:2" /><verse number="3" style="v" sid="GEN 7:3" />Thaj efta parurja katar svako čiriklji, muško thaj žensko, te lengo potomstvo avel arakhado pe phuv. <verse eid="GEN 7:3" /><verse number="4" style="v" sid="GEN 7:4" />Kaj pale efta đesa mukava pe phuv o bršnd te perel štarvardeš đes thaj štarvardeš raća thaj khosava katar o muj e phuvjako svako džudo biće saves stvorisardem.”<verse eid="GEN 7:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="GEN 7:5" />Thaj o Noja ćerda sa so o GOSPOD zapovedisardas lešće.<verse eid="GEN 7:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 7:6" />E Noja sas šov šela brš kana e poplavne paja aviline pe phuv. <verse eid="GEN 7:6" /><verse number="7" style="v" sid="GEN 7:7" />Thaj o Noja dijas ando brodo pire romnjava, pire čhavenca thaj lenđe romnjenca, te našen katar e poplavne paja. <verse eid="GEN 7:7" /><verse number="8" style="v" sid="GEN 7:8" />Katar e čiste thaj katar e marime životinje, katar e čiriklja thaj katar sa e bićurja save crden pes pe phuv, <verse eid="GEN 7:8" /><verse number="9" style="v" sid="GEN 7:9" />dine andre ko Noja ando brodo duj po duj, muško thaj žensko, sago kaj o Del zapovedisardas e Nojašće. <verse eid="GEN 7:9" /><verse number="10" style="v" sid="GEN 7:10" />Efta đesa posle godova, e poplavne paja avile pe phuv.<verse eid="GEN 7:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="GEN 7:11" />Kana sas e Nojašće šov šela brš, dešueftato đes ando dujto čhon, putajle sa e izvorja e bare bezdanošće thaj e brane po nebo. <verse eid="GEN 7:11" /><verse number="12" style="v" sid="GEN 7:12" />O bršnd delas pe phuv štarvardeš đesa thaj štarvardeš raća.<verse eid="GEN 7:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="GEN 7:13" />Godova isto đes o Noja, lešći romnji, lešće čhave o Sim, o Ham thaj o Jafet, thaj lenđe romnja, dine ando brodo, <verse eid="GEN 7:13" /><verse number="14" style="v" sid="GEN 7:14" />a lesa vi sa e vrste katar e divlje životinje, sa e vrste katar e stoka, sa e vrste katar e džude bićurja save crden pes pe phuv thaj sa vrste katar e čiriklja. <verse eid="GEN 7:14" /><verse number="15" style="v" sid="GEN 7:15" />Po duj katar sa bićurja ande save si o daho e trajosko dine ko Noja ando brodo. <verse eid="GEN 7:15" /><verse number="16" style="v" sid="GEN 7:16" />Dine andre sago paro, muško thaj žensko katar sa džude bićurja, sago kaj o Del zapovedisardas e Nojašće.</para>
  <para style="p" vid="GEN 7:16">Askal o GOSPOD phandadas o vudar pale leste.<verse eid="GEN 7:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 7:17" />E poplavne paja štarvardeš đesa poplavinas e phuv, a sar o paj barjolas, gajda inđarda o brodo thaj vazda les vuče katar e phuv. <verse eid="GEN 7:17" /><verse number="18" style="v" sid="GEN 7:18" />O paj vazdelas pe thaj barjolas vuče opral pe phuv, a o brodo plovilas po paj. <verse eid="GEN 7:18" /><verse number="19" style="v" sid="GEN 7:19" />Gadići silno o paj vazda pes pe phuv kaj učharda sa e majvuče planine talo nebo. <verse eid="GEN 7:19" /><verse number="20" style="v" sid="GEN 7:20" />O paj vazda pe efta meterja katar e majvuče poplavime planine. <verse eid="GEN 7:20" /><verse number="21" style="v" sid="GEN 7:21" />Gajda muline sa e džude bićurja pe phuv: e čiriklja, e stoka, e divlje životinje, sa e bićurja save crden pes pe phuv thaj sa e manuša. <verse eid="GEN 7:21" /><verse number="22" style="v" sid="GEN 7:22" />Po kopno mudardilo sa so ando nak sas les daho e trajosko. <verse eid="GEN 7:22" /><verse number="23" style="v" sid="GEN 7:23" />Gajda o Del uništisardas svako džudo stvorenje: e manušen, e životinjen, e bićuren save crden pes pe phuv, thaj e čirikljen. Ačhilo samo o Noje thaj okola save sas lesa ando brodo.<verse eid="GEN 7:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="GEN 7:24" />O paj učharelas e phuv šel thaj pandžvardeš đesa.<verse eid="GEN 7:24" /></para>
  <chapter eid="GEN 7" />
  <chapter number="8" style="c" sid="GEN 8" />
  <para style="s">Ačhile e Poplavne paja</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 8:1" />O Del dija pe gođi ko Noja thaj ke sa divlje životinje thaj ke stoka save sas lesa ando brodo. Gajda o Del ćerda te phurdel e balval pe phuv thaj o paja počnisardine te crden pe. <verse eid="GEN 8:1" /><verse number="2" style="v" sid="GEN 8:2" />Phandadile e izvorja andar o bezdan thaj e brane po nebo thaj o bršnd ačhilo te perel andar o nebo. <verse eid="GEN 8:2" /><verse number="3" style="v" sid="GEN 8:3" />O paj počnisarda poloće te crdel pe katar e phuv. Pale šel thaj pandžvardeš đes o paj gadići mukla pe tele <verse eid="GEN 8:3" /><verse number="4" style="v" sid="GEN 8:4" />kaj o eftato čhon dešueftato đes o brodo ačhilo pe gora Ararat. <verse eid="GEN 8:4" /><verse number="5" style="v" sid="GEN 8:5" />O paj crdelas pe thaj mućelas pe dži ko dešto čhon, a prvo đes ando dešto čhon sikadile e vrhurja e gorenđe.<verse eid="GEN 8:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 8:6" />A pale štarvardeš đesa, o Noje putardas e pendžera savi ćerda po brodo <verse eid="GEN 8:6" /><verse number="7" style="v" sid="GEN 8:7" />thaj mukla avri e gavrane. O gavran furjolas avri thaj boldelas pe palpale, dok o paj pe phuv či šućilo. <verse eid="GEN 8:7" /><verse number="8" style="v" sid="GEN 8:8" />Askal o Noje mukla e golubica, te dićhel dali o paj crda pe katar e phuv. <verse eid="GEN 8:8" /><verse number="9" style="v" sid="GEN 8:9" />Ali e golubica či arakhlas than kaj muklasas pe, kaj o paj još učharelas sasti phuv, pa bolda pe ando brodo ko Noje. Vo inzardas piro vas, astardas e golubica thaj anda lat andre ando brodo. <verse eid="GEN 8:9" /><verse number="10" style="v" sid="GEN 8:10" />O Noje ažućardas još efta đes, pa palem mukla e golubica andar o brodo. <verse eid="GEN 8:10" /><verse number="11" style="v" sid="GEN 8:11" />Tale rjat e golubica bolda pe, thaj ando kljuno andas terni patrin katar e maslina. Gajda o Noje džanglas kaj crda pe o paj katar e phuv. <verse eid="GEN 8:11" /><verse number="12" style="v" sid="GEN 8:12" />Pale godova ažućardas još efta đes, pa palem mukla e golubica, ali voj majbut či bolda pe leste.<verse eid="GEN 8:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="GEN 8:13" />Kana e Nojašće sas šov šela thaj jek brš, prvo đes prvo čhon, o paj šućilo katar e phuv. O Noje fuljardas o krovo katar o brodo, thaj dikhla kaj sas e phuv šući. <verse eid="GEN 8:13" /><verse number="14" style="v" sid="GEN 8:14" />Dži ke biš thaj eftato đes dujto čhon e phuv sas skroz šući.<verse eid="GEN 8:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="GEN 8:15" />Askal o Del phendas e Nojašće: <verse eid="GEN 8:15" /><verse number="16" style="v" sid="GEN 8:16" />“Inklji andar o brodo, tu, ćiri romnji, ćire čhave thaj lenđe romnja. <verse eid="GEN 8:16" /><verse number="17" style="v" sid="GEN 8:17" />Inkal tusa vi sa e vrste katar e džude stvorenja: e čirikljen, e životinjen thaj sa e bićen save crden pes pe phuv. Neka plodin pe thaj množin pe thaj neka pheren e phuv!”<verse eid="GEN 8:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 8:18" />Thaj o Noje inkljisto zajedno pire romnjasa, pire čhavenca thaj lenđe romnjenca. <verse eid="GEN 8:18" /><verse number="19" style="v" sid="GEN 8:19" />Sa e životinje, sa e bićurja save crden pes pe phuv, sa e čiriklja – sa so phirel pe phuv – inkljisto andar o brodo, vrsta pale vrsta.<verse eid="GEN 8:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="GEN 8:20" />Askal o Noje vazdas e GOSPODEŠĆE žrtveniko, pa lijas katar sa čiste životinje thaj katar sa čiste čiriklja, thaj po žrtveniko dija len jag sago žrtva paljenica.<verse eid="GEN 8:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="GEN 8:21" />O GOSPOD omirišisardas godova ugodno miris thaj phendas ande piro ilo: “Nikada više či dava romaja e phuv zbog o manuš, vi ako si katar lesko ternipe lešće gindimata bilačhe, niti majbut uništiva sa e džude bićurja sago kaj ćerdem.<verse eid="GEN 8:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="GEN 8:22" />Sa dok si e phuv,</para>
  <para style="q2" vid="GEN 8:22">nikada či ačhela</para>
  <para style="q1" vid="GEN 8:22">e setva thaj e žetva,</para>
  <para style="q2" vid="GEN 8:22">šil thaj tatipe,</para>
  <para style="q1" vid="GEN 8:22">milaj thaj ivend,</para>
  <para style="q2" vid="GEN 8:22">o đes thaj e rjat.”<verse eid="GEN 8:22" /></para>
  <chapter eid="GEN 8" />
  <chapter number="9" style="c" sid="GEN 9" />
  <para style="s">O Del ćerel savez e Nojasa</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 9:1" />Askal o Del blagoslovisardas e Noja thaj lešće čhaven e alavenca: “Plodin tumen, množin tumen thaj pheren e phuv! <verse eid="GEN 9:1" /><verse number="2" style="v" sid="GEN 9:2" />Neka daran tumendar sa e životinje pe phuv, sa e čiriklja po nebo, sa e bićurja save crden pes pe phuv thaj sa e mačhe ando more. Ande tumare vas si predaime. <verse eid="GEN 9:2" /><verse number="3" style="v" sid="GEN 9:3" />Sa so phirel thaj trajil, neka avel tumenđe palo habe. Sago kaj dijem tumen zelene biljke, gajda akana dav tumen sa.<verse eid="GEN 9:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="GEN 9:4" />Ali na han mas ande savo si još o rat, kaj godova značil kaj o trajo si ande leste. <verse eid="GEN 9:4" /><verse number="5" style="v" sid="GEN 9:5" />Pale tumaro rat, tumare trajurja, mangava te del pe o računo. Mangava o računo katar svako životinja savi mudarel e manušes thaj katar svako manuš savo mudarel avre manušes. Ako vareko lel o trajo avre manušesko mangava lesko trajo.<verse eid="GEN 9:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="GEN 9:6" />Ko čhorel e manušesko rat,</para>
  <para style="q2" vid="GEN 9:6">lesko rat o manuš čhorela,</para>
  <para style="q1" vid="GEN 9:6">kaj pe Devlešći slika</para>
  <para style="q2" vid="GEN 9:6">o Del stvorisarda e manuše.<verse eid="GEN 9:6" /></para>
  <para style="b" />
  <para style="p">
    <verse number="7" style="v" sid="GEN 9:7" />Ali tumen plodin tumen thaj množin tumen. Buljon pe phuv thaj množin tumen pe late.”<verse eid="GEN 9:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 9:8" />Još o Del phendas e Nojašće thaj lešće čhavenđe: <verse eid="GEN 9:8" /><verse number="9" style="v" sid="GEN 9:9" />“Ake, ćerav mungro savezo tumenca thaj tumare potomkonenca posle tumende, <verse eid="GEN 9:9" /><verse number="10" style="v" sid="GEN 9:10" />thaj svakone džude bićesa savo si tumenca – e čirikljenca, e stokava thaj e sa divlje životinjenca, sa okolesa so inkljisto andar o brodo tumenca – e svako džude bićesa pe phuv. <verse eid="GEN 9:10" /><verse number="11" style="v" sid="GEN 9:11" />Ćerav mungro savez tumenca: Majbut nikad či avena istrebime sa e džude bićurja e poplavne pajenca. Majbut nikad e poplavne paja či opustošina e phuv.”<verse eid="GEN 9:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="GEN 9:12" />O Del phendas: “Akava neka avel znako e savezosko, savo ćerav tumenca thaj svakone džude bićesa savo si tumenca, pale sa e pokoljenja save avena: <verse eid="GEN 9:12" /><verse number="13" style="v" sid="GEN 9:13" />Čhav mungri duga ande oblakurja, voj avela znako e savezosko maškar mande thaj e phuv. <verse eid="GEN 9:13" /><verse number="14" style="v" sid="GEN 9:14" />Kana god crdava o oblako pe phuv thaj ande oblakurja sikavela pe e duga, <verse eid="GEN 9:14" /><verse number="15" style="v" sid="GEN 9:15" />dava man gođi ke mungro savezo tumenca thaj sa e džude bićenca. Thaj majbut nikad e poplavne paja či postanina te uništin sa e džude bićen. <verse eid="GEN 9:15" /><verse number="16" style="v" sid="GEN 9:16" />Kana god ando oblako sikavela pe e duga, dikhava lat thaj dava man gođi ko večno savezo maškar mande thaj maškar svako džudo biće pe phuv.”<verse eid="GEN 9:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 9:17" />O Del phendas e Nojašće: “Godova si znako e savezosko savo ćerdem maškar mande thaj maškar sa e džude bića pe phuv.”<verse eid="GEN 9:17" /></para>
  <para style="s">E Nojašće čhave</para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 9:18" />E Nojašće čhave save inkljistine andar o brodo sas o Sim, o Ham thaj o Jafet. (O Ham sas dad e Hanaanesko.) <verse eid="GEN 9:18" /><verse number="19" style="v" sid="GEN 9:19" />Godola trin džene sas e Nojašće čhave, a lendar bijandile sa e manuša save buljile pe sasti phuv.<verse eid="GEN 9:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="GEN 9:20" />A o Noja postanisardas zemljoradniko thaj zasadisardas vinogrado. <verse eid="GEN 9:20" /><verse number="21" style="v" sid="GEN 9:21" />Jekhar pila mol, matilo thaj đelo te pašljol nango ande piro šator. <verse eid="GEN 9:21" /><verse number="22" style="v" sid="GEN 9:22" />O Ham, o dad e Hanaanesko, dikhla pire nanđe dade thaj phendas godova pire phralenđe save sas avri. <verse eid="GEN 9:22" /><verse number="23" style="v" sid="GEN 9:23" />Askal o Sim thaj o Jafet line o ogrtači, čhudine les pešće prekal e dume thaj sar phirenas e dumenca palal gajda učhardine pire nanđe dade. Boldine o šoro pe aver rig thaj gajda či dikhline pire nanđe dade.<verse eid="GEN 9:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="GEN 9:24" />Kana o Noja traznosajlo katar e mol thaj ašunda so ćerda lešće lesko majterno čhavo, <verse eid="GEN 9:24" /><verse number="25" style="v" sid="GEN 9:25" />phendas:</para>
  <para style="b" vid="GEN 9:25" />
  <para style="q1" vid="GEN 9:25">“Prokleto te avel o Hanaan!</para>
  <para style="q2" vid="GEN 9:25">Majcikno robo avela pire phralenđe.”<verse eid="GEN 9:25" /></para>
  <para style="b" />
  <para style="p">
    <verse number="26" style="v" sid="GEN 9:26" />Thaj još phendas:</para>
  <para style="b" vid="GEN 9:26" />
  <para style="q1" vid="GEN 9:26">“Blagoslovime neka avel o GOSPOD, o Del e Simosko!</para>
  <para style="q2" vid="GEN 9:26">O Hanaan neka avel e Simosko robo!<verse eid="GEN 9:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="GEN 9:27" />Neka o Del umnožil e Jafetešći phuv</para>
  <para style="q2" vid="GEN 9:27">thaj lesko potomstvo;</para>
  <para style="q1" vid="GEN 9:27">neka trajil ande šatorja e Simošće</para>
  <para style="q2" vid="GEN 9:27">a o Hanaan neka avel lesko robo.”<verse eid="GEN 9:27" /></para>
  <para style="b" />
  <para style="p">
    <verse number="28" style="v" sid="GEN 9:28" />Posle e poplavne paja o Noja trajisarda još trin šela thaj pandžvardeš brš. <verse eid="GEN 9:28" /><verse number="29" style="v" sid="GEN 9:29" />Gajda o Noja trajisarda inja šela thaj pandžvardeš brš thaj mulo.<verse eid="GEN 9:29" /></para>
  <chapter eid="GEN 9" />
  <chapter number="10" style="c" sid="GEN 10" />
  <para style="s">E plemenurja katar e Nojašće čhave</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 10:1" />Akava si e plemenurja e Nojašće čhavenđe: e Simešće, Hamešće, thaj e Jafetešće, savenđe bijandile čhave posle e poplavne paja.<verse eid="GEN 10:1" /></para>
  <para style="s">E Jafetešće potomkurja</para>
  <para style="li">
    <verse number="2" style="v" sid="GEN 10:2" />E Jafetošće čhave sas: o Gomer, o Magog, o Madaj, o Javan, o Tuval, o Mešeh thaj o Tiras.<verse eid="GEN 10:2" /></para>
  <para style="li">
    <verse number="3" style="v" sid="GEN 10:3" />E Gomerošće čhave sas: o Aškenaz, o Rifat thaj o Togarma.<verse eid="GEN 10:3" /></para>
  <para style="li">
    <verse number="4" style="v" sid="GEN 10:4" />E Javanošće čhave sas: o Eliša, o Taršiš, o Kitim thaj o Rodanim.<verse eid="GEN 10:4" /></para>
  <para style="m">
    <verse number="5" style="v" sid="GEN 10:5" />Lendar razdelisajle sa e thema save trajin pe morske krajurja, prema pire čhibja, pire familije thaj pire thema.<verse eid="GEN 10:5" /></para>
  <para style="s">E Hamošće potomkurja</para>
  <para style="li">
    <verse number="6" style="v" sid="GEN 10:6" />E Hamošće čhave sas: o Kuš, o Micrajim, o Put thaj o Hanaan.<verse eid="GEN 10:6" /></para>
  <para style="li">
    <verse number="7" style="v" sid="GEN 10:7" />E Kušošće čhave sas: o Seva, o Havila, o Savta, o Raama thaj o Savteha.</para>
  <para style="li" vid="GEN 10:7">E Raamešće čhave sas: o Ševa thaj o Dedan.<verse eid="GEN 10:7" /></para>
  <para style="b" />
  <para style="p">
    <verse number="8" style="v" sid="GEN 10:8" />E Kušesće bijandilo vi o Nimrod. Vo sas prvo baro ratniko pe phuv. <verse eid="GEN 10:8" /><verse number="9" style="v" sid="GEN 10:9" />Vo sas vešto lovco anglo GOSPOD, zato phenel pe: “Vešto lovco anglo GOSPOD sago o Nimrod.” <verse eid="GEN 10:9" /><verse number="10" style="v" sid="GEN 10:10" />Prvo početko lešće carstvosko sas o Vavilon, o Ereh, o Akad thaj o Kalne ande phuv Šinar. <verse eid="GEN 10:10" /><verse number="11" style="v" sid="GEN 10:11" />Andar godoja phuv đelo ande Asirija thaj sagradisardas e Niniva, o Rehovot Ir, o Kalah <verse eid="GEN 10:11" /><verse number="12" style="v" sid="GEN 10:12" />thaj o Resen, savo si maškar e Niniva thaj o baro gav o Kalah.<verse eid="GEN 10:12" /></para>
  <para style="b" />
  <para style="li">
    <verse number="13" style="v" sid="GEN 10:13" />Katar o Micrajim poteknisardine e Ludijcurja, e Anamcurja, e Lehavcurja, e Naftuhejcurja, <verse eid="GEN 10:13" /><verse number="14" style="v" sid="GEN 10:14" />e Patruscurja, e Kasluhejcurja (katar save poteknisardine e Filistejcurja) thaj e Kaftorcurja.<verse eid="GEN 10:14" /></para>
  <para style="li">
    <verse number="15" style="v" sid="GEN 10:15" />Katar o Hanaan poteknisardine lesko prvobijando čhavo o Sidon thaj e Sidoncurja, thaj o Het thaj e Hetiturja, <verse eid="GEN 10:15" /><verse number="16" style="v" sid="GEN 10:16" />askal e Jevusejcurja, e Amorejcurja, e Girgašancurja, <verse eid="GEN 10:16" /><verse number="17" style="v" sid="GEN 10:17" />e Hivijcurja, e Arkijcurja, e Sinijcurja, <verse eid="GEN 10:17" /><verse number="18" style="v" sid="GEN 10:18" />e Arvanđancurja, e Cemarcurja thaj e Hamađancurja.</para>
  <para style="m" vid="GEN 10:18">Maj posle e Hanaanske plemenurja rasijosajle. <verse eid="GEN 10:18" /><verse number="19" style="v" sid="GEN 10:19" />E granice e Hanaanenđi inzardolas katar o Sidon karingal o Gerar sa dži ke Gaza, pa karingal e Sodoma, Gomora, Admi thaj Cevoim sa dži ko Laše.<verse eid="GEN 10:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="GEN 10:20" />Godova si e Hamošće čhave prema pire plemenurja, čhibja, phuvja thaj thema.<verse eid="GEN 10:20" /></para>
  <para style="s">E Simošće plemenurja</para>
  <para style="p">
    <verse number="21" style="v" sid="GEN 10:21" />A čhave bijandile vi e Simošće, e Jafetešće majpurane phralešće; o Sim sas pradad sa e Everešće potomkonenđe.<verse eid="GEN 10:21" /></para>
  <para style="b" />
  <para style="li">
    <verse number="22" style="v" sid="GEN 10:22" />E Simošće čhave sas: o Elam, o Ašur, o Arfaksad, o Lud thaj o Aram.<verse eid="GEN 10:22" /></para>
  <para style="li">
    <verse number="23" style="v" sid="GEN 10:23" />E Aramošće čhave sas: o Uc, o Hul, o Geter thaj o Maš.<verse eid="GEN 10:23" /></para>
  <para style="li">
    <verse number="24" style="v" sid="GEN 10:24" />E Arfaksadešće bijandilo o Sala, a e Salešće bijandilo o Ever.<verse eid="GEN 10:24" /></para>
  <para style="li">
    <verse number="25" style="v" sid="GEN 10:25" />E Everešće bijandile duj čhave: Jek akhardolas Falek, kaj ande lešći vrjama e manuša pe phuv podelisajle, a lesko phral akhardolas Joktan.<verse eid="GEN 10:25" /></para>
  <para style="li">
    <verse number="26" style="v" sid="GEN 10:26" />E Joktanešće bijandile o Almodad, o Šelef, o Hacarmavet, o Jerah, <verse eid="GEN 10:26" /><verse number="27" style="v" sid="GEN 10:27" />o Hadoram, o Uzal, o Dikla, <verse eid="GEN 10:27" /><verse number="28" style="v" sid="GEN 10:28" />o Oval, o Avimael, o Ševa, <verse eid="GEN 10:28" /><verse number="29" style="v" sid="GEN 10:29" />o Ofir, o Havila thaj o Jovav.</para>
  <para style="m" vid="GEN 10:29">Sa akala sas e Joktanešće čhave. <verse eid="GEN 10:29" /><verse number="30" style="v" sid="GEN 10:30" />Von trajinas po područje katar e Meše dži ke Sefaru, ando gorsko krajo po istok.<verse eid="GEN 10:30" /></para>
  <para style="b" />
  <para style="p">
    <verse number="31" style="v" sid="GEN 10:31" />Godova si e Simošće čhave, prema pire plemenurja, čhibja, phuvja thaj thema.<verse eid="GEN 10:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="GEN 10:32" />Godova si e potomkurja e Nojašće čhavenđe prema lenđe plemenurja, andar lengo them. Lendar posle e poplavne paja buljile sa e thema pe phuv.<verse eid="GEN 10:32" /></para>
  <chapter eid="GEN 10" />
  <chapter number="11" style="c" sid="GEN 11" />
  <para style="s">E Vavilonsko kula</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 11:1" />Ande godoja vrjama po sasto them e manuša ćerenas svato samo jek čhib thaj koristinas iste alava. <verse eid="GEN 11:1" /><verse number="2" style="v" sid="GEN 11:2" />Sar e manuša phirenas po istoko, arakhline jek dolina ande phuv Šinar thaj okote ačhile te trajin.<verse eid="GEN 11:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="GEN 11:3" />Phendine jek avrešće: “Hajde te ćeras cigle thaj lačhe te pekas len te zuravon!”</para>
  <para style="p" vid="GEN 11:3">Gajda koristinas e cigla umesto o bar, a e smola sas lenđe sago malter. <verse eid="GEN 11:3" /><verse number="4" style="v" sid="GEN 11:4" />Askal phendine: “Hajde te vazdas amenđe gav thaj kula e vrhosa dži ko nebo, te steknisaras amenđe alav thaj te na avas rspime po sasto them.”<verse eid="GEN 11:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="GEN 11:5" />A o GOSPOD fuljisto te dićhel o gav thaj e kula, savi e manuša zidosardine. <verse eid="GEN 11:5" /><verse number="6" style="v" sid="GEN 11:6" />Askal o GOSPOD phendas: “Vi čače si jek them thaj savora ćeren svato jek čhib. Akava si tek početko katar okova so ćerena. Akana či avela lenđe nemoguće te ćeren sa so zamislin. <verse eid="GEN 11:6" /><verse number="7" style="v" sid="GEN 11:7" />Hajde te fuljas thaj te hamisaras lenđi čhib, te na haćaren jek avres.”<verse eid="GEN 11:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 11:8" />Gajda o GOSPOD okotar rspisarda len po sasto them thaj von či zidonas majdur o gav. <verse eid="GEN 11:8" /><verse number="9" style="v" sid="GEN 11:9" />Zato o gav akhardol Vavilon andar godova kaj o GOSPOD okote hamisarda e čhib e saste themešće. Okotar o GOSPOD rspisarda len po sasto them.<verse eid="GEN 11:9" /></para>
  <para style="s">E Simešće potomkurja</para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 11:10" />Akava si zapis katar e Simesko poreklo:</para>
  <para style="p" vid="GEN 11:10">Duj brš posle e poplavne paja, kana sas e Simešće šel brš, bijandilo lešće o Arfaksad. <verse eid="GEN 11:10" /><verse number="11" style="v" sid="GEN 11:11" />Posle Arfaksadesko bijandipe, o Sim trajisarda još pandž šela brš thaj sas les još čhave thaj čheja.<verse eid="GEN 11:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="GEN 11:12" />Kana e Arfaksade sas trijanda thaj pandž brš, bijandilo lešće o Sala. <verse eid="GEN 11:12" /><verse number="13" style="v" sid="GEN 11:13" />Posle Salasko bijandipe, o Arfaksad trajisarda još štar šela thaj trin brš thaj sas les još čhave thaj čheja.<verse eid="GEN 11:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="GEN 11:14" />Kana e Sala sas trijanda brš, bijandilo lešće o Ever. <verse eid="GEN 11:14" /><verse number="15" style="v" sid="GEN 11:15" />Posle Everesko bijandipe, o Sala trajisarda još štar šela thaj trin brš thaj sas les još čhave thaj čheja.<verse eid="GEN 11:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="GEN 11:16" />Kana e Evere sas trijanda thaj štar brš, bijandilo lešće o Falek. <verse eid="GEN 11:16" /><verse number="17" style="v" sid="GEN 11:17" />Posle Falekesko bijandipe, o Ever trajisarda još štar šela thaj trijanda brš thaj sas les još čhave thaj čheja.<verse eid="GEN 11:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 11:18" />Kana e Faleke sas trijanda brš, bijandilo lešće o Ragav. <verse eid="GEN 11:18" /><verse number="19" style="v" sid="GEN 11:19" />Posle Ragavesko bijandipe, o Falek trajisarda još duj šela thaj inja brš thaj sas les još čhave thaj čheja.<verse eid="GEN 11:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="GEN 11:20" />Kana e Ragave sas trijanda thaj duj brš, bijandilo lešće o Seruh. <verse eid="GEN 11:20" /><verse number="21" style="v" sid="GEN 11:21" />Posle Seruhesko bijandipe, o Ragav trajisarda još duj šela thaj efta brš thaj sas les još čhave thaj čheja.<verse eid="GEN 11:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="GEN 11:22" />Kana e Seruhes sas trijanda brš, bijandilo lešće o Nahor. <verse eid="GEN 11:22" /><verse number="23" style="v" sid="GEN 11:23" />Posle Nahoresko bijandipe, o Seruh trajisarda još duj šela brš thaj sas les još čhave thaj čheja.<verse eid="GEN 11:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="GEN 11:24" />Kana e Nahore sas biš thaj inja brš, bijandilo lešće o Tara. <verse eid="GEN 11:24" /><verse number="25" style="v" sid="GEN 11:25" />Posle Taresko bijandipe, o Nahor trajisarda još šel thaj dešuinja brš thaj sas les još čhave thaj čheja.<verse eid="GEN 11:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="GEN 11:26" />Kana o Tara pherdas eftavardeš brš, bijandile lešće o Avram, o Nahor thaj o Haran.<verse eid="GEN 11:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="GEN 11:27" />Akava si potomstvo e Taresko:</para>
  <para style="p" vid="GEN 11:27">E Tarešće bijandilo o Avram, o Nahor thaj o Haran.</para>
  <para style="p" vid="GEN 11:27">E Haranošće bijandilo o Lot. <verse eid="GEN 11:27" /><verse number="28" style="v" sid="GEN 11:28" />O Haran mulo majsigo nego lesko dad o Tara, ando Uro Haldejsko, ande phuv kaj bijandilo.<verse eid="GEN 11:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="GEN 11:29" />O Avram thaj o Nahor oženisajle. E Avramešći romnji bučholas Saraja, a e Nahorešći Milka, voj sas čhej e Haranošći, saves sas još vi čhej savi bučholas Jiska. <verse eid="GEN 11:29" /><verse number="30" style="v" sid="GEN 11:30" />E Saraja nas čhavra kaj našti ačhelas khamni.<verse eid="GEN 11:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="GEN 11:31" />O Tara lijas pire čhaves e Avrame, pire unuko e Loto, e čhave e Haranošće, thaj pire borja e Saraja, e Avramešće romnja, thaj lenca andar o Uro Haldejsko teljarda ande phuv Hanaan. Ali kana aresline dži ko Haran, ačhile te trajin okote.<verse eid="GEN 11:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="GEN 11:32" />O Tara trajisarda duj šela thaj pandž brš thaj mulo ando Haran.<verse eid="GEN 11:32" /></para>
  <chapter eid="GEN 11" />
  <chapter number="12" style="c" sid="GEN 12" />
  <para style="s">O GOSPOD akharel e Avrame</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 12:1" />O GOSPOD phendas e Avramešće: “Dža andar ćiri phuv, katar ćiri familija thaj andar o ćher ćire dadesko, thaj dža ande phuv savi sikavava tuće.<verse eid="GEN 12:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="GEN 12:2" />Tutar ćerava baro them</para>
  <para style="q2" vid="GEN 12:2">thaj blagosloviva tut.</para>
  <para style="q1" vid="GEN 12:2">Ćiro alav ćerava baro</para>
  <para style="q2" vid="GEN 12:2">thaj tu aveja blagoslov averenđe!<verse eid="GEN 12:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="GEN 12:3" />Blagosloviva okolen save tut blagoslovin,</para>
  <para style="q2" vid="GEN 12:3">a dava romaja okolen save tut den romaja.</para>
  <para style="q1" vid="GEN 12:3">Preko tute avena blagoslovime</para>
  <para style="q2" vid="GEN 12:3">sa e thema pe phuv.”<verse eid="GEN 12:3" /></para>
  <para style="b" />
  <para style="p">
    <verse number="4" style="v" sid="GEN 12:4" />Askal o Avram teljarda gajda sago kaj o GOSPOD phendas lešće, a lesa teljardas vi o Lot. E Avrame sas eftavardeš thaj pandž brš kana đelotar andar o Haran. <verse eid="GEN 12:4" /><verse number="5" style="v" sid="GEN 12:5" />O Avram lijas pesa pire romnja e Saraja, pire phralešće čhave e Loto, sa o barvalipe thaj sa e robonen save steknisardine ando Haran, pa zaputisajle ande phuv Hanaan thaj aresline ande late.<verse eid="GEN 12:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 12:6" />O Avram nakhlo kroz e phuv sa dži ko than Sihem, dži ko baro kaš savo akhardol Morea. Ande godoja vrjama trajinas e Hanaancurja ande godoja phuv.<verse eid="GEN 12:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="GEN 12:7" />O GOSPOD sikadilo e Avramešće, pa phendas lešće: “Akaja phuv dava ćire potomstvošće.”</para>
  <para style="p" vid="GEN 12:7">Askal o Avram vazda žrtveniko e GOSPODEŠĆE, savo sikadilo lešće. <verse eid="GEN 12:7" /><verse number="8" style="v" sid="GEN 12:8" />A okotar đelotar istočno katar o Betel, kaj razapnisarda piro šator. O Betel sas lešće po zapad, a o Aj po Istok. Okote o Avram vazda žrtveniko e GOSPODEŠĆE thaj slavisarda e GOSPODESKO alav.<verse eid="GEN 12:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 12:9" />Pale godova, o Avram nastavisarda te putujil katar o than dži ko than, karingal o Negev.<verse eid="GEN 12:9" /></para>
  <para style="s">O Avram ando Egipat</para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 12:10" />Ali kana ande phuv zavladisardas e bok, o Avram fuljisto ando Egipat te trajil okote varesavi vrjama, kaj e bok sas zurale bari.<verse eid="GEN 12:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="GEN 12:11" />Ali kana već sas paše te del andre ando Egipat, vo phendas pire romnjaće e Sarajaće: “Ašun, džanav kaj san zurale šukar manušnji. <verse eid="GEN 12:11" /><verse number="12" style="v" sid="GEN 12:12" />Kana dićhena tut e Egipćanurja, phenena: ‘Akaja si lešći romnji.’ Gajda man mudarena, a tut mućena po trajo. <verse eid="GEN 12:12" /><verse number="13" style="v" sid="GEN 12:13" />Zato moliv tut, phen kaj san mungri phen, te zbog tute lačhe ponašin pe prema mande thaj poštedin mungro trajo.”<verse eid="GEN 12:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="GEN 12:14" />Kana o Avram areslo ando Egipat, e Egipćaja dikhline kaj si e Saraja zurale šukar manušnji. <verse eid="GEN 12:14" /><verse number="15" style="v" sid="GEN 12:15" />Dikhline lat vi e faraonešće službenikurja, pa pohvalisardine lat anglo faraon. Gajda e Saraja andine pe faraonesko dvoro te avel jek katar lešće romnja. <verse eid="GEN 12:15" /><verse number="16" style="v" sid="GEN 12:16" />O faraon šukar postupisardas prema o Avram zbog late, pa o Avram steknisardas bakhre, guruva, magarcurja, robonen, ropkinjen, magarice thaj kamile.<verse eid="GEN 12:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 12:17" />Ali o GOSPOD bičhaldas bare nasvalimate po faraon thaj po sasto lesko ćher zbog e Avramešći romnji e Saraja.<verse eid="GEN 12:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 12:18" />Zato o faraon akhardas e Avrame thaj phučla les: “So godova ćerdan manđe? Sostar či phendan manđe kaj si voj ćiri romnji? <verse eid="GEN 12:18" /><verse number="19" style="v" sid="GEN 12:19" />Sostar phendan: ‘Voj si mungri phen’, pa me lijem lat romnjaće? Ake, akana boldav tuće ćire romnja, le lat thaj džatar!”<verse eid="GEN 12:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="GEN 12:20" />Askal o faraon zapovedisardas pire manušenđe, a von ispratisardine e Avrame zajedno lešće romnjava thaj sa okoleja so sas les.<verse eid="GEN 12:20" /></para>
  <chapter eid="GEN 12" />
  <chapter number="13" style="c" sid="GEN 13" />
  <para style="s">O Avram thaj o Lot džantar jek avrestar</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 13:1" />O Avram andar o Egipto đelo opre ando Negev pire romnjava thaj sa okolesa so sas les. A lesa sas vi o Lot. <verse eid="GEN 13:1" /><verse number="2" style="v" sid="GEN 13:2" />E Avrame sas baro barvalipe ande stoka, ando rup thaj ando sunakaj. <verse eid="GEN 13:2" /><verse number="3" style="v" sid="GEN 13:3" />Andar o Negev o Avram putuilas e thanestar dži thaneste thaj gajda sa dži ko Betel, dži ke okova than maškar o Betel thaj maškar o Aj kaj majsigo trajilas <verse eid="GEN 13:3" /><verse number="4" style="v" sid="GEN 13:4" />thaj okote kaj vazdas o žrtveniko. Okote o Avram slavisarda e GOSPODESKO alav.<verse eid="GEN 13:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="GEN 13:5" />A vi o Lot putuilas e Avramesa, thaj sas les bakhre thaj guruva, familija thaj but roburja. <verse eid="GEN 13:5" /><verse number="6" style="v" sid="GEN 13:6" />Gajda kaj godoja phuv našti inćarelas liduje dženen, pošto sas len gadići but stoka thaj našti trajinas zajedno. <verse eid="GEN 13:6" /><verse number="7" style="v" sid="GEN 13:7" />A avelas vi dži ke čingara maškar e Avramešće pastirja thaj maškar e Lotošće pastirja. Ande godoja vrjama ande godoja phuv trajinas e Hanaancurja thaj e Perižanurja.<verse eid="GEN 13:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 13:8" />Zato o Avram phendas e Lotošće: “Neka na avel čingara maškar mande thaj maškar tute, maškar mungre thaj ćire pastirja – kaj, amare sam. <verse eid="GEN 13:8" /><verse number="9" style="v" sid="GEN 13:9" />E sasti phuv si angle tute. Odvojisar tut mandar. Ako tu džas pe levo rig, me džava pe desno rig. Ako tu džas pe desno rig, me džava pe levo rig.”<verse eid="GEN 13:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 13:10" />O Lot vazdas pe jakha thaj dikhla kaj e sasti Jordansko dolina prema o Coar si lačhe navodime e pajesa, sago o vrto e GOSPODESKO ili sar e Egipatsko phuv. Akava sas majsigo nego so o GOSPOD uništisardas e Sodoma thaj e Gomora. <verse eid="GEN 13:10" /><verse number="11" style="v" sid="GEN 13:11" />Gajda o Lot lijas pešće e sasti dolina e Jordanošći thaj teljarda po istok. Gajda đele jek avrestar. <verse eid="GEN 13:11" /><verse number="12" style="v" sid="GEN 13:12" />O Avram trajilas ando Hanaan, dok o Lot trajilas maškar e gava ande dolina thaj vazdelas šatorja sa dži ke Sodoma. <verse eid="GEN 13:12" /><verse number="13" style="v" sid="GEN 13:13" />A e manuša andar e Sodoma sas bilačhe thaj bare bezehale anglo GOSPOD.<verse eid="GEN 13:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="GEN 13:14" />Nakon so o Lot đelotar lestar, o GOSPOD phendas e Avramešće: “Dikh lačhe katar akava than po sever thaj po jug, po istok thaj po zapad. <verse eid="GEN 13:14" /><verse number="15" style="v" sid="GEN 13:15" />Sa e phuv savi dićhes, dava tuće thaj ćire potomkonenđe pale uvek. <verse eid="GEN 13:15" /><verse number="16" style="v" sid="GEN 13:16" />Ćerava te avel ćiro potomstvo but sago praho pe phuv. Ako šaj đinavel pe o praho e phuvjako, askal vi ćiro potomstvo šaj đinavela pe. <verse eid="GEN 13:16" /><verse number="17" style="v" sid="GEN 13:17" />Dža thaj nak e phuv kozom si lundži thaj kozom si buli, kaj tuće dava lat.”<verse eid="GEN 13:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 13:18" />Askal o Avram ćida pire šatorja thaj đelo te trajil ke Mamrešće bare kaš ando Hevron thaj okote vazdas žrtveniko e GOSPODEŠĆE.<verse eid="GEN 13:18" /></para>
  <chapter eid="GEN 13" />
  <chapter number="14" style="c" sid="GEN 14" />
  <para style="s">O Avram spasil e Lote</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 14:1" />Ande godoja vrjama o Amrafel, o caro katar e phuv Šinar, o Arioh o caro katar e phuv Elasar, o Kedarlaomer o caro katar e phuv Elam thaj o Tidal o caro katar e phuv Gojim, <verse eid="GEN 14:1" /><verse number="2" style="v" sid="GEN 14:2" />teljardine ando rato protiv o Bera caro katar e Sodoma, protiv o Birša, caro katar e Gomora, protiv o Šinava, caro katar e Adma, protiv e Šemevera caro katar e Cevoim, thaj protiv o caro katar e Bele, savo si Coara. <verse eid="GEN 14:2" /><verse number="3" style="v" sid="GEN 14:3" />Sa akala pandž carurja ćidine pe zajedno ande dolina Sidim, kaj si akana o Mulo more. <verse eid="GEN 14:3" /><verse number="4" style="v" sid="GEN 14:4" />Dešuduj brš služisardine e Kedarlaomeršće, ali ande dešutrinto brš pobunisajle.<verse eid="GEN 14:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="GEN 14:5" />Dešuštarto brš, o Kedarlaomer thaj e carurja save sas lesa ando savez pobedisardine e Refajcen ando Aštarot-Karnajim, e Zuzejcen ando Ham, e Emijcen ando Šabe-Kirjatajim <verse eid="GEN 14:5" /><verse number="6" style="v" sid="GEN 14:6" />thaj e Horijcen ando gorsko krajo Seir, sa dži ko El-Paran paše pustinja. <verse eid="GEN 14:6" /><verse number="7" style="v" sid="GEN 14:7" />Askal boldine pe palpale thaj aviline ando En-Mišpat, savo si akhardo Kadeš, pa pokorisardine sasto područje e Amalečanengo thaj porazisardine vi e Amorejcen save trajinas ando Hacecon-Tamar.<verse eid="GEN 14:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 14:8" />Askal o caro katar e Sodoma, o caro katar e Gomora, o caro katar e Adma, o caro katar o Cevoim thaj o caro katar e Bela, savi si akhardi Coara, inkljistine ande dolina Sidim thaj teljardine ande rato <verse eid="GEN 14:8" /><verse number="9" style="v" sid="GEN 14:9" />e Kedarlaomeresa, e carova katar e phuv Elam, e Tidalesa, e carova katar e phuv Gojim, e Amrafelesa, e carova katar e phuv Šinar, thaj e Ariohesa, e carova katar e phuv Elasar. Štar carurja protiv pandž. <verse eid="GEN 14:9" /><verse number="10" style="v" sid="GEN 14:10" />E dolina Sidim sas pherdi hvja e smolava, pa kana e carurja e Sodomaće thaj e Gomoraće našenas, peline ande lende, ali aver našline ande gore. <verse eid="GEN 14:10" /><verse number="11" style="v" sid="GEN 14:11" />E štar carurja save pobedisardine, line sa o barvalipe andar e Sodoma thaj e Gomora thaj sa o hamasko, pa đeletar. <verse eid="GEN 14:11" /><verse number="12" style="v" sid="GEN 14:12" />O Lot, e Avramesko phralesko čhavo, trajilas ande Sodoma, a zarobisardine vi les zajedno lešće barvalipeja.<verse eid="GEN 14:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="GEN 14:13" />Jek manuš lendar savo našlo, avilo thaj sa javisardas e Avramešće Jevreješće savo trajilas ke bare kaš e Mamrešće. O Mamre sas Amorejco, e Eškolosko thaj e Aneresko phral, save sas e Avramesa ando savez. <verse eid="GEN 14:13" /><verse number="14" style="v" sid="GEN 14:14" />Kana o Avram ašunda kaj si lešće phralesko čhavo zarobime, ćida pire trin šela thaj dešuohto uvežbime manušen, save bijandile ande lesko ćher, thaj teljardas ande potera sa dži ko Dan. <verse eid="GEN 14:14" /><verse number="15" style="v" sid="GEN 14:15" />Prekal e rjat o Avram rasporedisardas pire manušen palo napad thaj pobedisardas pire dušmajen. Trada len sa dži ko Hove savo si severno katar o Damask. <verse eid="GEN 14:15" /><verse number="16" style="v" sid="GEN 14:16" />Gajda o Avram boldas sa o barvalipe, a boldas vi pire phralešće čhave e Lote thaj lesko barvalipe, zajedno e manušnjenca thaj e aver themesa.<verse eid="GEN 14:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 14:17" />Kana o Avram boldelas pe posle e pobeda po Kedarlaomer thaj pe carurja save sas lesa ando savez, o caro katar e Sodoma inkljisto angle leste ande dolina Šave, godova si ande Carošći dolina. <verse eid="GEN 14:17" /><verse number="18" style="v" sid="GEN 14:18" />Askal o Melhisedek, caro katar e Salim andas o mangro thaj e mol. Vo sas rašaj e Majbare Devlesko. <verse eid="GEN 14:18" /><verse number="19" style="v" sid="GEN 14:19" />Vo blagoslovisarda e Avrame e alavenca:</para>
  <para style="b" vid="GEN 14:19" />
  <para style="q1" vid="GEN 14:19">“Neka blagoslovil e Avrame o Majbaro Del,</para>
  <para style="q2" vid="GEN 14:19">savo stvorisarda o nebo thaj e phuv.<verse eid="GEN 14:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="GEN 14:20" />Blagoslovime o Majbaro Del,</para>
  <para style="q2" vid="GEN 14:20">savo dijas tut e dušmajen ande vas.”</para>
  <para style="b" vid="GEN 14:20" />
  <para style="m" vid="GEN 14:20">Askal o Avram dijas e Melhisedekošće deš posto katar sa.<verse eid="GEN 14:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="GEN 14:21" />O caro katar e Sodoma phendas e Avramešće: “Manđe de mungre manušen, ali tuće muk o barvalipe.”<verse eid="GEN 14:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="GEN 14:22" />Ali o Avram phendas lešće: “Hav solah e GOSPODEŠĆE, e Majbare Devlešće, savo stvorisarda o nebo thaj e phuv, <verse eid="GEN 14:22" /><verse number="23" style="v" sid="GEN 14:23" />kaj či lava ni o thav, ni e haravlji katar e sandale, niti bilo so aver so si ćiro, te nikad či phenes: ‘Me ćerdem e Avrame te avel barvalo.’ <verse eid="GEN 14:23" /><verse number="24" style="v" sid="GEN 14:24" />Pale mande či lava khanči osim okova so haline mungre manuša thaj okova so pripadil e manušenđe save đeline manca – e Anerešće, e Eškolešće thaj e Mamrešće. Von neka len piro talo.”<verse eid="GEN 14:24" /></para>
  <chapter eid="GEN 14" />
  <chapter number="15" style="c" sid="GEN 15" />
  <para style="s">O Del sklopil savez e Avramesa</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 15:1" />Posle akala događajurja, o alav e GOSPODESKO avilo e Avramešće ande vizija:</para>
  <para style="b" vid="GEN 15:1" />
  <para style="q1" vid="GEN 15:1">“Na dara, Avrame,</para>
  <para style="q2" vid="GEN 15:1">me sem ćiro štito,</para>
  <para style="q2" vid="GEN 15:1">ćiri bari nagrada.”<verse eid="GEN 15:1" /></para>
  <para style="b" />
  <para style="p">
    <verse number="2" style="v" sid="GEN 15:2" />Ali o Avram phendas: “GOSPODE, Devla, savi nagrada deja man? Naj man čhavra thaj mungro nasledniko avela o Eliezer katar o Damask.” <verse eid="GEN 15:2" /><verse number="3" style="v" sid="GEN 15:3" />Thaj još phendas o Avram: “Ake či dijan man potomstvo, gajda kaj mungro nasledniko avela o robo savo bijandilo ande mungro ćher.”<verse eid="GEN 15:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="GEN 15:4" />Askal o GOSPOD phendas lešće: “Či avela godova ćiro nasledniko, nego ćiro rođeno čhavo avela ćiro nasledniko.”<verse eid="GEN 15:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="GEN 15:5" />Askal inkalda e Avrame avri thaj phendas: “Dik ando nebo thaj đinav e čereja, ako šaj te đinaves len. Gaći baro avela ćiro potomstvo.”<verse eid="GEN 15:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 15:6" />O Avram paćaja e GOSPODEŠĆE thaj godova đinada pe lešće ande pravednost.<verse eid="GEN 15:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="GEN 15:7" />O GOSPOD phendas lešće: “Me sem o GOSPOD savo andem tut andar o Uro Haldejsko te dav tuće akaja phuv te avel ćiri.”<verse eid="GEN 15:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 15:8" />Ali o Avram phučlas: “GOSPODE, Devla, sar džanava kaj akaja phuv avela mungri?”<verse eid="GEN 15:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 15:9" />O GOSPOD phendas lešće: “An manđe gurumnji katar trin brš, buznji katar trin brš, bakhres katar trin brš, jek grlica thaj jećhe terne golubo.”<verse eid="GEN 15:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 15:10" />O Avram sa godova andas lešće, čhinda po opaš thaj sa e opašina ređosarda pe jek thaj pe aver rig jek paše avreste. Samo e čirikljen či čhinda. <verse eid="GEN 15:10" /><verse number="11" style="v" sid="GEN 15:11" />Askal e čiriklja grabljivice ćidenas pes pe godola mule životinje, a o Avram tradelas len.<verse eid="GEN 15:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="GEN 15:12" />Kana o kham mućelas pe tele, e Avrame astarda o zuralo sovipe thaj e bari jezivo tama avili pe leste.<verse eid="GEN 15:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="GEN 15:13" />O GOSPOD phendas e Avramešće: “Te džanes kaj ćire potomkurja avena strancurja ande averenđi phuv. Postanina roburja thaj avena zlostavime štar šela brš. <verse eid="GEN 15:13" /><verse number="14" style="v" sid="GEN 15:14" />Ali me kazniva e themes savenđe von robujina, thaj von posle godova inkljena e bare barvalipeja. <verse eid="GEN 15:14" /><verse number="15" style="v" sid="GEN 15:15" />Ali tu mereja ando miro thaj ando baro phuripe aveja prahome. <verse eid="GEN 15:15" /><verse number="16" style="v" sid="GEN 15:16" />Tek o štarto naraštaj ćire potomkonengo boldela pe akaring, kaj o bezeh katar e Amorejcurja još či barilo gaći te avel kaznime.”<verse eid="GEN 15:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 15:17" />Kana o kham mukla pe thaj pelo o tunjariko, pojavisajlo o bov savo thuvljarelas thaj e baklja savi phabolas thaj nakhline maškar e životinjenđe opašina.<verse eid="GEN 15:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 15:18" />Godova đes o GOSPOD ćerda savez e Avramesa thaj phendas: “Ćire potomkonenđe dava akaja phuv, katar e Egipatsko reka dži ke bari reka Eufrat, <verse eid="GEN 15:18" /><verse number="19" style="v" sid="GEN 15:19" />thaj e phuvja kaj trajin e Kenejcurja, Kenižurja, Kadmoncurja, <verse eid="GEN 15:19" /><verse number="20" style="v" sid="GEN 15:20" />Hetiturja, Perižancurja, Refajcurja, <verse eid="GEN 15:20" /><verse number="21" style="v" sid="GEN 15:21" />Amorejcurja, Hanaancurja, Girgašajcurja thaj e Jevusejcurja.”<verse eid="GEN 15:21" /></para>
  <chapter eid="GEN 15" />
  <chapter number="16" style="c" sid="GEN 16" />
  <para style="s">E Agara thaj o Išmael</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 16:1" />E Avramešći romnji e Saraja našti bijandas lešće čhavren. Ali sas lat jek ropkinja savi sas andar o Egipat thaj akhardolas Agara, <verse eid="GEN 16:1" /><verse number="2" style="v" sid="GEN 16:2" />pa e Saraja phendas e Avramešće: “Ake, o GOSPOD či dija man te avel man čhavra. Dža thaj sov mungre ropkinjava. Šaj kaj prekal late avela man čhavra.”</para>
  <para style="p" vid="GEN 16:2">Thaj o Avram čhuta kan ke Saraja. <verse eid="GEN 16:2" /><verse number="3" style="v" sid="GEN 16:3" />Nakhlo deš brš sar o Avram trajilas ando Hanaan, kana lešći romnji e Saraja dija pire ropkinja, Egipćanka e Agara, pire romešće e Avramešće pale romnji. <verse eid="GEN 16:3" /><verse number="4" style="v" sid="GEN 16:4" />Vo suta e Agarava thaj voj ačhili khamni, a kana e Agara dikhla kaj ačhili khamni, počnisarda te preziril pire gospodarica.<verse eid="GEN 16:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="GEN 16:5" />E Saraja phendas e Avramešće: “Tu san došalo pale nepravda savi si manđe ćerdi. Me andem mungre ropkinja ande ćire angalja, a voj, kana dikhla kaj si khamni, počnisarda te preziril man. Neka o GOSPOD presudil ko si amendar dujendar ando pravo.”<verse eid="GEN 16:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 16:6" />Pe godova o Avram phendas e Sarajaće: “Ake, ćiri ropkinja si ande ćiri vlast. Ćer lasa sar gndis kaj si majlačhe.”</para>
  <para style="p" vid="GEN 16:6">E Saraja askal počnisarda te mučil e Agara, pa voj našli latar.<verse eid="GEN 16:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="GEN 16:7" />Ali e GOSPODESKO anđeo maladas e Agara ande pustinja ko izvor savo si po drom karingal o Šur, <verse eid="GEN 16:7" /><verse number="8" style="v" sid="GEN 16:8" />pa phučla lat: “Agaro, ropkinjo e Sarajaći, katar avilan thaj kaj džas?”</para>
  <para style="p" vid="GEN 16:8">Voj phendas: “Našav katar mungri gospodarica e Saraja.”<verse eid="GEN 16:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 16:9" />Askal o anđeo e GOSPODESKO phendas laće: “Bolde tut ke ćiri gospodarica thaj pokori tu laće!” <verse eid="GEN 16:9" /><verse number="10" style="v" sid="GEN 16:10" />O anđelo e GOSPODESKO uz godova još phendas laće: “Dava tut gadići but potomkurja kaj našti đinavena pe.” <verse eid="GEN 16:10" /><verse number="11" style="v" sid="GEN 16:11" />Thaj o anđelo e GOSPODESKO još phendas laće:</para>
  <para style="b" vid="GEN 16:11" />
  <para style="q1" vid="GEN 16:11">“Ake, khamni san</para>
  <para style="q2" vid="GEN 16:11">thaj bijaneja čhaves.</para>
  <para style="q1" vid="GEN 16:11">Deja les alav Jišmael,</para>
  <para style="q2" vid="GEN 16:11">kaj o GOSPOD ašundas pale ćiri bari nevolja.<verse eid="GEN 16:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="GEN 16:12" />Vo avela sago divljo magarco,</para>
  <para style="q2" vid="GEN 16:12">pe svakoneste vazdela piro vas</para>
  <para style="q1" vid="GEN 16:12">thaj svako vazdela piro vas pe leste,</para>
  <para style="q2" vid="GEN 16:12">pire phralenca trajila sago dušmano.”<verse eid="GEN 16:12" /></para>
  <para style="b" />
  <para style="p">
    <verse number="13" style="v" sid="GEN 16:13" />Askal voj e GOSPODE, savo ćerda lasa svato, akhardas El Roi, kaj phendas: “Akate dikhlem okoles savo dićhel man.” <verse eid="GEN 16:13" /><verse number="14" style="v" sid="GEN 16:14" />Zbog godova godoja haing akhardol Beer Lahaj Roi<note caller="+" style="f"><char style="fr" closed="false">16,14 </char><char style="ft" closed="false">Beer Lahaj Roi značil: “Haing e džudešći savo dićhel man.” </char></note>, thaj si maškar o Kadeš thaj o Bered.<verse eid="GEN 16:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="GEN 16:15" />Thaj e Agara bijandas e Avramešće čhaves, a o Avram dija les alav Jišmael. <verse eid="GEN 16:15" /><verse number="16" style="v" sid="GEN 16:16" />E Avrame sas ohtovardeš thaj šov brš kana e Agara bijandas lešće e Jišmaeles.<verse eid="GEN 16:16" /></para>
  <chapter eid="GEN 16" />
  <chapter number="17" style="c" sid="GEN 17" />
  <para style="s">Obrezanje sago savez e Avramesa</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 17:1" />Kana e Avrame sas injavardeš thaj inja brš, o GOSPOD sikadilo lešće thaj phendas lešće: “Me sem o Del Svemogućo. Trajisar pe mungri volja thaj av besprekorno. <verse eid="GEN 17:1" /><verse number="2" style="v" sid="GEN 17:2" />Ćerava mungro savez maškar mande thaj maškar tute thaj zurale umnoživa tut.”<verse eid="GEN 17:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="GEN 17:3" />O Avram pelo pe koča e mujesa dži ke phuv, a o Del phendas lešće: <verse eid="GEN 17:3" /><verse number="4" style="v" sid="GEN 17:4" />“Akava si mungro savezo tusa: Aveja dad e bute themengo. <verse eid="GEN 17:4" /><verse number="5" style="v" sid="GEN 17:5" />Majbut či akhareja tut Avram, nego ćiro alav avela Avraam, kaj ćerdem tutar te aves dad e bute themengo. <verse eid="GEN 17:5" /><verse number="6" style="v" sid="GEN 17:6" />Dava tut but potomkurja thaj tutar postanila baro thema thaj e carurja. <verse eid="GEN 17:6" /><verse number="7" style="v" sid="GEN 17:7" />Ćerava mungro savez tusa thaj ćire potomkonenca katar o naraštaj dži ko naraštaj. Avela godova večno savezo thaj avava ćiro Del thaj Del ćire potomkonenđe. <verse eid="GEN 17:7" /><verse number="8" style="v" sid="GEN 17:8" />Tuće thaj ćire potomkonenđe dava pale uvek e sasti phuv Hanaan, ande savi akana trajis sago stranco, a me avava lengo Del.”<verse eid="GEN 17:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 17:9" />Askal o Del phendas e Avraamešće: “A tu inćar mungro savez, tu thaj vi ćire potomkurja katar o naraštaj dži ko naraštaj. <verse eid="GEN 17:9" /><verse number="10" style="v" sid="GEN 17:10" />Akava si mungro savezo tusa thaj ćire potomkonenca, savez savo moraš te inćaren: neka obrežil pe svako muško maškar tumende. <verse eid="GEN 17:10" /><verse number="11" style="v" sid="GEN 17:11" />Obrezin tumen, godova avela znako e savezosko maškar mande thaj tumende. <verse eid="GEN 17:11" /><verse number="12" style="v" sid="GEN 17:12" />Kroz tumaro naraštaj, svako muško maškar tumende kana bijandola neka avel obrezime ohtoto đes; thaj vi o robo savo si bijando ande tumaro ćher, thaj vi okova savo si ćindo katar e strancurja, savo naj katar tumaro rat. <verse eid="GEN 17:12" /><verse number="13" style="v" sid="GEN 17:13" />Ej, vi o robo savo si bijando ande tumaro ćher, ili okova savo si ćindo katar e strancurja, moraš te obrezil pe. Gajda mungro večno savezo ačhela pe tumaro telo. <verse eid="GEN 17:13" /><verse number="14" style="v" sid="GEN 17:14" />Svako muško savo či obrezil pe neka avel tradino andar piro rodo pale uvek: kasavo prekršisardas mungro savezo.”<verse eid="GEN 17:14" /></para>
  <para style="s">O obećime čhavo o Isaak</para>
  <para style="p">
    <verse number="15" style="v" sid="GEN 17:15" />O Del još phendas e Avraamešće: “Ćire romnja majbut na akhar Saraja, kaj lako alav avela Sara. <verse eid="GEN 17:15" /><verse number="16" style="v" sid="GEN 17:16" />Blagosloviva lat thaj latar dava tut čhavo. Blagosloviva lat, thaj voj avela dej e themenđe; thaj latar bijandona carurja e manušenđe.”<verse eid="GEN 17:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 17:17" />O Avraam pelo pe pire koča e mujesa dži ke phuv, lijas te asal thaj phendas ande peste: “Okolešće savešće si šel brš, zar šaj te bijandol lešće čhavro? Zar e Sara ande injavardešto brš bijanela?”<verse eid="GEN 17:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 17:18" />O Avraam phendas e Devlešće: “Sostar o Jišmael te či avel mungro nasledniko!”<verse eid="GEN 17:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="GEN 17:19" />Ali o Del phendas: “Ipak ćiri romnji e Sara bijanela tuće čhaves, a deja les alav Isaak. Mungro savez lesa sklopiva, večno savezo lesa thaj lešće potomkonenca posle leste. <verse eid="GEN 17:19" /><verse number="20" style="v" sid="GEN 17:20" />Thaj vi palo Jišmael čhutem kan tute. Ake, blagosloviva les, thaj dava les bari porodica, umnoživa les, thaj lestar bijandona dešuduj poglavarja, thaj ćerava lestar baro them. <verse eid="GEN 17:20" /><verse number="21" style="v" sid="GEN 17:21" />Ali mungro savezo sklopiva e Isaakosa saves bijanela tuće e Sara, dži ko brš ande akaja vrjama.”<verse eid="GEN 17:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="GEN 17:22" />Kana o Del završisarda e Avraamesa o svato, vazda pe lestar.<verse eid="GEN 17:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="GEN 17:23" />Pale godova o Avraam lijas pire čhaves e Jišmaeles, sa e robonen save sas bijande ande lesko ćher thaj sa okolen save sas ćinde pale love – sa e muškonen save sas ande lesko ćher thaj isto godova đes obrežisarda len, sar o Del phendas lešće. <verse eid="GEN 17:23" /><verse number="24" style="v" sid="GEN 17:24" />E Avraamešće sas injavardeš thaj inja brš kana sas obrezime, <verse eid="GEN 17:24" /><verse number="25" style="v" sid="GEN 17:25" />a lešće čhavešće e Jišmaelošće sas dešutrin brš. <verse eid="GEN 17:25" /><verse number="26" style="v" sid="GEN 17:26" />Gajda godova isto đes sas obrezime o Avraam tha lesko čhavo o Jišmael, <verse eid="GEN 17:26" /><verse number="27" style="v" sid="GEN 17:27" />a lesa vi sa e muškurcurja ande Avraamesko ćher: e roburja bijande ande lesko ćher thaj okola kaj sas ćinde pale love katar e strancurja.<verse eid="GEN 17:27" /></para>
  <chapter eid="GEN 17" />
  <chapter number="18" style="c" sid="GEN 18" />
  <para style="s">Trin anđelurja posetisardine e Avraame</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 18:1" />O GOSPOD sikadilo e Avraamešće ke bare kaš e Mamrešće, pale vrjama kana sas e majbari žega dok bešelas po ulaz ande piro šatori.<verse eid="GEN 18:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="GEN 18:2" />O Avraam vazda pire jakha thaj dikhla trin manušen sar ačhen cara majdur lestar.</para>
  <para style="p" vid="GEN 18:2">Čim dikhla len, katar o ulaz e šatoresko prastajas angle lende, thaj pelo pe pire koča e mujesa dži ke phuv angle lende. <verse eid="GEN 18:2" /><verse number="3" style="v" sid="GEN 18:3" />Phendas: “Gospodarina, te arakhlem milost ande ćire jakha, na te samo naćhes paše mande, pašo ćiro slugo, a te či nasvratis. <verse eid="GEN 18:3" /><verse number="4" style="v" sid="GEN 18:4" />Neka anel pe cara paj, te thoven tumare pungre, pa te odmorin tumen tale akava kaš. <verse eid="GEN 18:4" /><verse number="5" style="v" sid="GEN 18:5" />Anava vi mangro te han thaj te zuravon, a askal teljarena majdur. Pale godova, kaj aviline ke tumaro sluga.”</para>
  <para style="p" vid="GEN 18:5">Von phendine: “Lačhe, ćer sar phendan.”<verse eid="GEN 18:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 18:6" />O Avraam siđarda andre ke Sara ando šator thaj phendas laće: “Sigo! Le biš kile parno aro, šukljar o humer thaj pek pogača!”<verse eid="GEN 18:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="GEN 18:7" />Askal o Avraam prastajas dži ke guruva, astarda jećhe terne thaj ugojime guruve, dija les ke jek sluga te sigo pripremil les palo habe. <verse eid="GEN 18:7" /><verse number="8" style="v" sid="GEN 18:8" />Posle godova o Avraam lijas ćiral, thud thaj e guruve savo sas pripremime, thaj čhuta angle lende. Dok von hanas, O Avraam ačhelas paše lende talo kaš.<verse eid="GEN 18:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 18:9" />Askal phučline les: “Kaj si ćiri romnji e Sara?”</para>
  <para style="p" vid="GEN 18:9">Vo phendas: “Eke, andre ando šator.”<verse eid="GEN 18:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 18:10" />Askal jek lendar phendas: “Boldava man tute dži ke aver brš ande akaja vrjama, thaj ćire romnja e Sara avela čhavo.”</para>
  <para style="p" vid="GEN 18:10">E Sara godova ašunda kaj sas pašo ulaz e šatoresko savo sas pale lešće dume. <verse eid="GEN 18:10" /><verse number="11" style="v" sid="GEN 18:11" />O Avraam thaj e Sara sas već purane thaj dine ande pire brš kana e Sara majbut našti bijanelas čhavren.<verse eid="GEN 18:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="GEN 18:12" />Zato e Sara asajas ande peste thaj gndisarda: “Zar akana kana sem purani, te avel man godova zadovoljstvo? A vi mungro rom si purano.”<verse eid="GEN 18:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="GEN 18:13" />Askal o GOSPOD phučlas e Avraame: “Sostar e Sara asajas thaj gndisarda: ‘Dali čače me šaj bijanava čhavre akana kana sem purani?’ <verse eid="GEN 18:13" /><verse number="14" style="v" sid="GEN 18:14" />Dali si e GOSPODEŠĆE vareso nemoguće? Dži ke aver brš ande akaja vrjama boldava man tute, thaj e Sara avela čhavo.”<verse eid="GEN 18:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="GEN 18:15" />Ali e Sara darajli, pa hohada e alavenca: “Či asajem.”</para>
  <para style="p" vid="GEN 18:15">A o GOSPOD phendas: “Naj gajda, asajan.”<verse eid="GEN 18:15" /></para>
  <para style="s">O Avraam posredujil pale Sodoma</para>
  <para style="p">
    <verse number="16" style="v" sid="GEN 18:16" />Kana godola trin manuša uštile te džantar, dikhline karingal e Sodoma, a o Avraam teljarda lenca te ispratil len. <verse eid="GEN 18:16" /><verse number="17" style="v" sid="GEN 18:17" />Askal o GOSPOD phendas ande peste: “Zar te garavav katar o Avraam so kamav te ćerav? <verse eid="GEN 18:17" /><verse number="18" style="v" sid="GEN 18:18" />E Avraamestar avela baro thaj moćno them, prekal leste avena blagoslovime sa e thema pe phuv. <verse eid="GEN 18:18" /><verse number="19" style="v" sid="GEN 18:19" />Kaj, me izabirisardem les te sikavel pire čhaven thaj pire potomkonen te inćaren pe ko drom e GOSPODESKO thaj te ćeren okova so si ispravno thaj pravedno. Gajda o GOSPOD, šaj izvršila okova so obećisarda e Avraamešće.”<verse eid="GEN 18:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="GEN 18:20" />Thaj o GOSPOD phendas lešće: “Bare optužbe si protiv e Sodoma thaj e Gomora thaj zurale pharo si lengo bezah. <verse eid="GEN 18:20" /><verse number="21" style="v" sid="GEN 18:21" />Fuljava okote tele te dikhav dali si sa okova so ašundem ande optužbe čače ili naj.”<verse eid="GEN 18:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="GEN 18:22" />Askal e duj manuša okotar uputisajle prema e Sodoma, dok o Avraam još ačhelas anglo GOSPOD.<verse eid="GEN 18:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="GEN 18:23" />Askal o Avraam avilo leste majpaše thaj phučla les: “Dali čače uništija vi e nedužne manuše zajedno okolesa savo si došalo? <verse eid="GEN 18:23" /><verse number="24" style="v" sid="GEN 18:24" />A so ako si ando gav pandžvardeš džene save si nedužne? Dali vi len uništija thaj či jartoja godole thanešće zbog okola pandžvardeš nedužne save si ande leste? <verse eid="GEN 18:24" /><verse number="25" style="v" sid="GEN 18:25" />Dur tutar te avel te ćeres gajda vareso! Dali te mudares e nedužne manušen zajedno e došalenca, pa te e nedužnikošće avel isto sago vi e došalešće? Dur tutar te avel! Dali o Sudija e saste themesko te či ćerel so si pravedno?”<verse eid="GEN 18:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="GEN 18:26" />O GOSPOD phendas: “Ako ando gav Sodoma arakhav pandžvardeš nedužne manušen, zbog lende jartova e saste gavešće.”<verse eid="GEN 18:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="GEN 18:27" />O Avraam nastavisarda: “Vi ako sem samo praho thaj pepeo, ake, usudiv man palem te phučav e Gospode. <verse eid="GEN 18:27" /><verse number="28" style="v" sid="GEN 18:28" />A so ako ando gav si okola save si nedužne pandž majcara katar pandžvardeš džene? Dali uništija o sasto gav zbog godola štarvardeš thaj pandž džene?”</para>
  <para style="p" vid="GEN 18:28">O GOSPOD phendas: “Ako okote arakhav štarvardeš thaj pandž nedužne manušen, či uništiva les.”<verse eid="GEN 18:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="GEN 18:29" />O Avraam palem phučlas: “So ako okote araćhen pe samo štarvardeš?”</para>
  <para style="p" vid="GEN 18:29">O GOSPOD phendas: “Či uništiva les zbog godola štarvardeš.”<verse eid="GEN 18:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="GEN 18:30" />Askal o Avraam phendas: “Neka o Gospod či holjavol kaj palem vareso phučav. So ako okote araćhen pe samo trijanda?”</para>
  <para style="p" vid="GEN 18:30">Vo phendas: “Či uništiva les zbog godola trijanda.”<verse eid="GEN 18:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="GEN 18:31" />Askal o Avraam palem phendas: “Ake usudiv man palem vareso te phučav mungre Gospode. So ako okote araćhen pe samo biš?”</para>
  <para style="p" vid="GEN 18:31">Vo phendas: “Či uništiva les zbog godola biš.”<verse eid="GEN 18:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="GEN 18:32" />Askal o Avraam palem phendas: “Neka mungro Gospod či holjavol, ako samo još jekhar vareso phučav. So ako okote araćhen pe samo deš?”</para>
  <para style="p" vid="GEN 18:32">Vo phendas: “Či uništiva les zbog godola deš.”<verse eid="GEN 18:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="GEN 18:33" />Kana o GOSPOD završisarda o svato e Avraamesa, đelotar, a o Avraam bolda pe ćhere.<verse eid="GEN 18:33" /></para>
  <chapter eid="GEN 18" />
  <chapter number="19" style="c" sid="GEN 19" />
  <para style="s">O Del uništil e Sodoma thaj e Gomora</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 19:1" />Okola duj anđelurja aresline tale rjat ande Sodoma. O Lot bešelas ke gavešći kapija, pa kana dikhla len, uštilo, đelo angle lende thaj poklonisajlo angle lende e mujesa dži ke phuv.<verse eid="GEN 19:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="GEN 19:2" />Phendas: “Moliv tumen, rajalen, aven ando ćher tumare slugasko te raćaren thaj te thoven tumare pungre, a thejara ande detharin palem šaj džan tumare dromesa.”</para>
  <para style="p" vid="GEN 19:2">Von phendine lešće: “Na, raćarasa po trgo.”<verse eid="GEN 19:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="GEN 19:3" />Ali o Lot uporno nagovorilas len thaj von đeline leste. Dine andre ande lesko ćher, a vo ćerda lenđe baro habe thaj peklas bikvascošće mangre, pa haline.<verse eid="GEN 19:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="GEN 19:4" />Majsigo so pašljile te soven, sa e manuša andar e Sodoma, sa o them andar o sasto gav, vi e purane thaj vi e terne, opkolisardine e Lotosko ćher. <verse eid="GEN 19:4" /><verse number="5" style="v" sid="GEN 19:5" />Akhardine e Loto thaj pučline les: “Kaj si e manuša save arjat aviline tute? Inkal len avri amenđe, te sovas lenca!”<verse eid="GEN 19:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 19:6" />O Lot askal inkljisto angle lende, phandadas o vudar pala peste <verse eid="GEN 19:6" /><verse number="7" style="v" sid="GEN 19:7" />thaj phendas: “Moliv tumen, drugarja, na ćeren akava bilačhipe! <verse eid="GEN 19:7" /><verse number="8" style="v" sid="GEN 19:8" />Ake, si man duj čheja save još či sutine e romenca. Len inkalava tumenđe thaj lenca ćeren so kamen. Ali akale manušenđe na ćeren khanči kaj si ande mungro ćher thaj tale mungri zaštita.”<verse eid="GEN 19:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 19:9" />Ali e manuša phendine: “Le tut majdur katar amaro drom! Avilan akate sago stranco, a već čhos tut amenđe palo sudija. Akana ćerasa tusa majgore nego lenca.”</para>
  <para style="p" vid="GEN 19:9">Thaj zurale spidine e Loto thaj teljardine te phađen o vudar. <verse eid="GEN 19:9" /><verse number="10" style="v" sid="GEN 19:10" />Ali okola duj džene inzardine e vas avri thaj crdine e Loto peste andre ando ćher thaj phandadine o vudar. <verse eid="GEN 19:10" /><verse number="11" style="v" sid="GEN 19:11" />A okole manušen save ačhenas anglo vudar, e ternen thaj e puranen, korardine, gajda kaj našti arakhline o vudar.<verse eid="GEN 19:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="GEN 19:12" />Askal okola duj manuša phučline e Loto: “Si tut akate još vareko? Džamutren, čhaven, čhejen, ili bilo kas ćires? Inkal len andar akava gav avri! <verse eid="GEN 19:12" /><verse number="13" style="v" sid="GEN 19:13" />Kaj amen uništisarasa les. E tužba pe akala manuša si gajda bari anglo GOSPOD kaj bičhalda men te uništisaras o gav.”<verse eid="GEN 19:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="GEN 19:14" />Gajda o Lot inkljisto te mothol godova pire buduće džamutrenđe. Phendas lenđe: “Sigo! Inkljen andar akava than, kaj o GOSPOD uništila les!” Ali lešće džamutre gndinas kaj ćerel lenca komendija.<verse eid="GEN 19:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="GEN 19:15" />Kana đesajlo, e anđelurja siđarenas e Loto, mothonas lešće: “Sigo! Inkal avrjal o gav ćire romnja thaj ćire duje čhejen save si akate, te na aven vi tumen uništime kana mukas e kazna po gav.”<verse eid="GEN 19:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="GEN 19:16" />Ali o Lot nečkilas pe. Zato okola manuša line palo vas les, lešće romnja thaj lešće duje čhejen thaj inkaldine len avri andar o gav, zato kaj o GOSPOD smiluisajlo lenđe. <verse eid="GEN 19:16" /><verse number="17" style="v" sid="GEN 19:17" />Kana inkaldine len avri andar o gav, jek lendar phendas: “Našen te spasin tumen! Na bolden tumen te dićhen palpale thaj na ačhadon nikaj ande dolina! Našen ande planine, te na aven uništime!”<verse eid="GEN 19:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 19:18" />Askal o Lot phendas: “Na, gospodarina, moliv tut! <verse eid="GEN 19:18" /><verse number="19" style="v" sid="GEN 19:19" />Me, ćiro sluga, arakhlem milost ande ćire jakha thaj tu sikadan bari ljubav prema mande kana spasisardan mungro trajo. Ali, me či aresava te našav ande planine, a te na astarel man akava bilačhipe thaj avav mudardo. <verse eid="GEN 19:19" /><verse number="20" style="v" sid="GEN 19:20" />Nego, eke okote jek gav savo si dosta paše te šaj našav ande leste, o gav si vi čače cikno. De man te našav ande leste te spasiv mungro trajo!”<verse eid="GEN 19:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="GEN 19:21" />Vo phendas lešće: “Laćhe, čhava kan ke akaja ćiri molba thaj či uništiva o gav pale savo phenes. <verse eid="GEN 19:21" /><verse number="22" style="v" sid="GEN 19:22" />Samo naš inća sigo, kaj našti ćerav khanči dok tu či areses inća.” Zato godova gav dobisardas alav Coar.<verse eid="GEN 19:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="GEN 19:23" />O kham već inkljisto, kana o Lot dijas ando gav Coar. <verse eid="GEN 19:23" /><verse number="24" style="v" sid="GEN 19:24" />Askal o GOSPOD mukla te perel pe Sodoma thaj pe Gomora o sumpor thaj e jag andar o nebo. <verse eid="GEN 19:24" /><verse number="25" style="v" sid="GEN 19:25" />Gajda uništisardas godola gava thaj e sasti dolina, sa e manušen save trajinas okote, thaj sa so barjolas andar e phuv.<verse eid="GEN 19:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="GEN 19:26" />Ali e Lotošći romnji bolda pe te dićhel pala peste thaj pretvorisajli ando stupo katar o lon.<verse eid="GEN 19:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="GEN 19:27" />O Avraam uštilo rano detharinako thaj đelo po than kaj majsigo ačhelas anglo GOSPOD. <verse eid="GEN 19:27" /><verse number="28" style="v" sid="GEN 19:28" />Dikhla prema e Sodoma, prema e Gomora thaj prema e sasti dolina, a okotar vazdelas pe o thuv po nebo sago o thuv andar o baro bov!<verse eid="GEN 19:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="GEN 19:29" />Gajda o Del dija pe gođi ko Avraam kana uništisardas e gava ande dolina ande savi trajilas o Lot, thaj inkalda e Loto avri majsigo nego so o uništenje avilo.<verse eid="GEN 19:29" /></para>
  <para style="s">Poreklo katar e Moavcurja thaj katar e Amoncurja</para>
  <para style="p">
    <verse number="30" style="v" sid="GEN 19:30" />O Lot thaj lešće duj čheja mukline o Coar thaj đele te trajin ande planine, kaj daralas te ačhel ando Coar. Vo thaj lešće duj čheja trajinas ande pećina.<verse eid="GEN 19:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="GEN 19:31" />Askal jekhar lešći majpurani čhej phendas e majternjaće: “Amaro dad si purano, a naj muškarcurja te ženin pe amenca thaj te avel men čhavra sago kaj si godova običaj ando sasto them. <verse eid="GEN 19:31" /><verse number="32" style="v" sid="GEN 19:32" />Hajde te mataras amare dade e molasa, thaj te sovas lesa, te nastavil pe amaro potomstvo.” <verse eid="GEN 19:32" /><verse number="33" style="v" sid="GEN 19:33" />Godoja rjat matardine pire dade e molasa, thaj e majpurani čhej đeli thaj sutas pire dadesa. Ali vo či džangla kana pašljili ni kana uštili.<verse eid="GEN 19:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="GEN 19:34" />Thejara đes e majpurani čhej phendas e majternjaće: “Araći me sutem amare dadeja. Hajde te vi arjat mataras les askal dža vi tu thaj sov lesa, te nastavil pe amaro potomstvo.”<verse eid="GEN 19:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="GEN 19:35" />Gajda von vi godoja rjat matardine pire dade e molasa thaj e terni čhej đeli thaj sutas lesa. Ali vo či džangla ni kana pašljili ni kana uštili.<verse eid="GEN 19:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="GEN 19:36" />Gajda e liduj Lotošće čheja ačhiline khamne pire dadesa. <verse eid="GEN 19:36" /><verse number="37" style="v" sid="GEN 19:37" />E majpurani čhej bijandas čhaves thaj dija les alav Moav. Vo si o pradad katar e ađešće Moavcurja. <verse eid="GEN 19:37" /><verse number="38" style="v" sid="GEN 19:38" />Thaj vi e majterni čhej bijandas čhaves thaj dija les alav Ben-Ami. Vo si pradad katar e ađesće Amoncurja.<verse eid="GEN 19:38" /></para>
  <chapter eid="GEN 19" />
  <chapter number="20" style="c" sid="GEN 20" />
  <para style="s">O Avraam thaj o Avimeleh</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 20:1" />Okotar o Avraam đelo ande pustinja Negev thaj nastanisajlo maškar o Kadeš thaj o Šur. Varesavi vrjama trajilas ando Gerar, <verse eid="GEN 20:1" /><verse number="2" style="v" sid="GEN 20:2" />thaj kolenđe save trajinas okote o Avraam phendas pale piri romnji e Sara kaj si lešći phen. Askal o gerarsko caro o Avimeleh bičhaldas pale Sara thaj lija lat pešće pale romnji. <verse eid="GEN 20:2" /><verse number="3" style="v" sid="GEN 20:3" />Ali o Del avilo e Avimelehošće e raćava ando suno thaj phendas lešće: “Mereja zbog akaja manušnji savja lijan, kaj voj si udajime romnji.” <verse eid="GEN 20:3" /><verse number="4" style="v" sid="GEN 20:4" />O Avimeleh još či suta e Sarava, pa phendas: “Gospode, zar mudareja e nedužne theme? <verse eid="GEN 20:4" /><verse number="5" style="v" sid="GEN 20:5" />Zar godova manuš či phendas manđe: ‘Voj si mungri phen’? A či li vi voj phendas: ‘Vo mungro phral’? Ćerdem godova ande čisto savest thaj či meljardem mungre vas.”<verse eid="GEN 20:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 20:6" />Askal o Del ando suno phendas lešće: “Džanav kaj tu ćerdan godova ande čisto savest. Zato zadržisardem tut te na grešis protiv mande, thaj zato či dijem tut te dotaknis lat. <verse eid="GEN 20:6" /><verse number="7" style="v" sid="GEN 20:7" />Akana bolde godole manušešće lešće romnja. Vo si proroko thaj molila pe pale tute, te ačhes džudo. Ali ako či boldes lat, te džanes kaj mereja, tu thaj vi savora ćire manuša.”<verse eid="GEN 20:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 20:8" />O Avimeleh uštilo detharinako rano, pa akhardas sa pire službenikonen. Kana phendas lenđe sa so sas, von zurale darajle.<verse eid="GEN 20:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 20:9" />Askal o Avimeleh akhardas e Avraame, pa phučla les: “So godova ćerdan amenđe? So ćerdem tuće te kasavo bezah crdes pe mande thaj pe mungro carstvo? Ćerdan manđe okova so či trubul te ćerel pe!”<verse eid="GEN 20:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 20:10" />O Avimeleh još phučla e Avraame: “Pa so trada tut te ćeres gajda vareso?”<verse eid="GEN 20:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="GEN 20:11" />O Avraam phendas: “Čače gndisardem kaj ande kava gav naj khonik ko daral katar o Del thaj kaj mudarena man zbog mungri romnji. <verse eid="GEN 20:11" /><verse number="12" style="v" sid="GEN 20:12" />A osim godova, voj si čače vi mungri phen, čhej mungre dadešći, ali naj vi čhej mungre dejaći, thaj lijem lat manđe pale romnji. <verse eid="GEN 20:12" /><verse number="13" style="v" sid="GEN 20:13" />Kana o Del phendas manđe te džav andar mungre dadesko ćher, phendem laće: ‘Sikav manđe ćiri ljubav: ande savo god than te das, phen pale mande kaj sem ćiro phral.’”<verse eid="GEN 20:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="GEN 20:14" />Askal o Avimeleh lijas bakhren, guruven, roburja thaj ropkinje thaj dija e Avraamešće. Boldas lešće vi lešće romnja e Sara. <verse eid="GEN 20:14" /><verse number="15" style="v" sid="GEN 20:15" />Thaj phendas: “Ake, mungri phuv si angle tute. Trajisar kaj kames ande late.” <verse eid="GEN 20:15" /><verse number="16" style="v" sid="GEN 20:16" />A e Saraće phendas: “Ake, dijam ćire phrale milja rupune kovanice. Godoleja kamav savorenđe save si tusa te sikavav kaj san nedužno. Slobodno san katar bilo savi doš.”<verse eid="GEN 20:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 20:17" />Askal o Avraam pomolisajlo e Devlešće thaj o Del sastardas e Avimeleho, lešće romnja thaj lešće sluškinjen thaj palem šaj bijanenas čhavren. <verse eid="GEN 20:17" /><verse number="18" style="v" sid="GEN 20:18" />Kaj o GOSPOD zbog e Sara e Avraamešći romnji ćerda te svako manušnji andar e Avimelehesko ćher avel neplodno.<verse eid="GEN 20:18" /></para>
  <chapter eid="GEN 20" />
  <chapter number="21" style="c" sid="GEN 21" />
  <para style="s">E Isaakosko bijandipe</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 21:1" />O GOSPOD blagoslovisarda e Sara, thaj ćerda sago kaj obećisarda laće: <verse eid="GEN 21:1" /><verse number="2" style="v" sid="GEN 21:2" />E Sara ačhili khamni thaj bijandas e Avraamešće čhave ande lešće purane brš, baš ande okoja vrjama pale savi o Del phendas. <verse eid="GEN 21:2" /><verse number="3" style="v" sid="GEN 21:3" />O Avraam dija alav pire čhavešće saves bijandas lešće e Sara Isaak. <verse eid="GEN 21:3" /><verse number="4" style="v" sid="GEN 21:4" />Kana e Isaako sas ohto đes, o Avraam obrezisarda les sago kaj zapovedisardas lešće o Del.<verse eid="GEN 21:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="GEN 21:5" />E Avraam sas šel brš kana bijandilo lešće lesko čhavo o Isaak.<verse eid="GEN 21:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 21:6" />E Sara phendas: “O Del ćerda te asav thaj savora save pale akava ašunena, asana manca.” <verse eid="GEN 21:6" /><verse number="7" style="v" sid="GEN 21:7" />Još phendas: “Ko šaj phendasas e Avraamešće kaj e Sara dela čuči e čhavren? A ipak bijandem lešće čhave ande lešće purane đesa.” <verse eid="GEN 21:7" /><verse number="8" style="v" sid="GEN 21:8" />O čhavro barilo thaj sas odbime katar e čuči. A okova đes kana sas o Isaak odbime katar e čuči, o Avraam ćerda bari gozba.<verse eid="GEN 21:8" /></para>
  <para style="s">O Avraam tradel e Agara thaj e Jišmaele</para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 21:9" />E Sara dikhla kaj o Išmael saves bijandas e Avraamešće e Agara e Egipćanka, marel muj katar lako čhavo o Isaak, <verse eid="GEN 21:9" /><verse number="10" style="v" sid="GEN 21:10" />pa phendas e Avraamešće: “Trade ćire ropkinja thaj laće čhaves, kaj o čhavo akale ropkinjako či avela nasledniko mungre čhaveja e Isaakosa.”<verse eid="GEN 21:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="GEN 21:11" />E Avraamešće sas akava but pharo, kaj o Jišmael sas lesko čhavo. <verse eid="GEN 21:11" /><verse number="12" style="v" sid="GEN 21:12" />Ali o Del phendas lešće: “Na te avel tuće pharo zbog o čhavro thaj pale ćiri ropkinja. Ćer sa so e Sara phenel tuće, kaj ćiro potomstvo đinavela pe prekal o Isaak. <verse eid="GEN 21:12" /><verse number="13" style="v" sid="GEN 21:13" />A vi katar o čhavo e ropkinjako ćerava baro them, kaj vi vo si ćiro potomko.”<verse eid="GEN 21:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="GEN 21:14" />O Avraam uštilo rano detharinako, lijas mangro thaj paj ande morćhani trjasta thaj dijas ke Agara. Askal čhuta godova laće pe dume thaj trada lat zajedno e čhavoresa. Voj đelitar thaj lutilas ande pustinja Beer Ševa. <verse eid="GEN 21:14" /><verse number="15" style="v" sid="GEN 21:15" />Kana nas lat majbut paj ande morćhani trjasta, voj čhuta e čhavres tale jek žbuno, <verse eid="GEN 21:15" /><verse number="16" style="v" sid="GEN 21:16" />pa đeli thaj bešli majdur lestar kozom o luko katar e strela šaj dobacil, kaj gindilas: “Našti te dikhav sar o čhavro merel.” Thaj dok gajda bešelas, dija ando baro roipe.<verse eid="GEN 21:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 21:17" />Ali o Del ašundas e čhavresko roipe, pa o anđelo e Devlesko čhuta muj e Agara andar o nebo thaj phendas laće: “So si, Agara? Na te daras. O Del ašundas sar o čhavro okote rovel. <verse eid="GEN 21:17" /><verse number="18" style="v" sid="GEN 21:18" />Ušti, vazde e čhavres thaj utešisar les, kaj lestar ćerava baro them.” <verse eid="GEN 21:18" /><verse number="19" style="v" sid="GEN 21:19" />Askal o Del putardas laće jakha thaj voj dikhla e haing. Đeli thaj pherdas e morćhani trjasta pajesa thaj dijas e čhavores te pel.<verse eid="GEN 21:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="GEN 21:20" />O Del sas e čhavoresa dok barjolas. Trajilas ande pustinja Paran thaj postanisardas lačho strelco. <verse eid="GEN 21:20" /><verse number="21" style="v" sid="GEN 21:21" />Dok trajilas ande pustinja, lešći dej andas lešće andar o Egipto romnji.<verse eid="GEN 21:21" /></para>
  <para style="s">O Avraam ćerel savez e Avimelehosa</para>
  <para style="p">
    <verse number="22" style="v" sid="GEN 21:22" />Ande godoja vrjama o caro o Avimeleh, thaj o Pihol o zapovedniko pe lešći vojska, phendine e Avraamešće: “O Del si tusa ande sa so ćeres. <verse eid="GEN 21:22" /><verse number="23" style="v" sid="GEN 21:23" />Zato akana ha manđe solah anglo Del kaj či hohaveja ni man, ni mungre čhavren, ni mungre potomkonen, nego kaj aveja lačho manđe thaj akale phuvjaće ande savi trajis sago stranco, sago kaj vi me semas lačho tuće.” <verse eid="GEN 21:23" /><verse number="24" style="v" sid="GEN 21:24" />O Avraam phendas: “Hav man solah.”<verse eid="GEN 21:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="GEN 21:25" />Askal o Avraam požalisajlo e Avimelehošće zbog e haing savi e Avimelehošće sluge line pe sila.<verse eid="GEN 21:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="GEN 21:26" />O Avimeleh phendas: “Či džanav ko ćerda godova, a ni tu či phendan manđe. Tek ađes ašunav pale gadova.”<verse eid="GEN 21:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="GEN 21:27" />Askal o Avraam lijas hurdi thaj bari stoka thaj dija e Avimelehošće, pa von duj džene ćerdine maškar pende savez. <verse eid="GEN 21:27" /><verse number="28" style="v" sid="GEN 21:28" />Pale godova o Avraam losardas pe rig efta terne ženske bakhrja andar o stado <verse eid="GEN 21:28" /><verse number="29" style="v" sid="GEN 21:29" />thaj o Avimeleh phučla les: “So značil akala efta ženske bakhrja save losardan pe rig?”<verse eid="GEN 21:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="GEN 21:30" />O Avraam phendas lešće: “Primisar mandar akala efta bakhrja sago svedočanstvo kaj me hanadem akaja haing.”<verse eid="GEN 21:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="GEN 21:31" />Gajda okova than dobisarda alav Beer Ševa, kaj okote von duj džene haline solah. <verse eid="GEN 21:31" /><verse number="32" style="v" sid="GEN 21:32" />Kana o Avimeleh thaj o Avraam ćerdine savez ke Beer Ševa, o Avimeleh thaj lesko zapovedniko o Pihol boldine pe ande phuv e Filistejenđi. <verse eid="GEN 21:32" /><verse number="33" style="v" sid="GEN 21:33" />A o Avraam posadisarda ande Beer Ševa kaš tamarisko thaj okote slavisarda o alav e GOSPODESKO Večne Devlesko. <verse eid="GEN 21:33" /><verse number="34" style="v" sid="GEN 21:34" />O Avraam još lungo vrjama trajilas ande phuv e Filistejenđi.<verse eid="GEN 21:34" /></para>
  <chapter eid="GEN 21" />
  <chapter number="22" style="c" sid="GEN 22" />
  <para style="s">O Del iskušil e Avraame</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 22:1" />Posle godova o Del iskušisarda e Avraame.</para>
  <para style="p" vid="GEN 22:1">Akharda les: “Avraame!”</para>
  <para style="p" vid="GEN 22:1">A o Avraam phendas: “Ake taman!”<verse eid="GEN 22:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="GEN 22:2" />Askal o Del phendas: “Le ćire jedine čhave e Isaako, saves but volis, thaj dža ande phuv Morija. Okote žrtvui les sago žrtva paljenica pe jek katar e planina savi sikavava tuće.”<verse eid="GEN 22:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="GEN 22:3" />O Avraam uštilo detharinako rano, upregnisarda e magarco thaj lijas pesa duj slugen thaj pire čhave e Isaako. Kana čhinda kaš pale žrtva paljenica, teljarda karingal o than pale savo o Del phendas lešće.<verse eid="GEN 22:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="GEN 22:4" />O trito đes o Avraam vazdas pire jakha thaj dikhla godova than dadural. <verse eid="GEN 22:4" /><verse number="5" style="v" sid="GEN 22:5" />Phendas pire slugenđe: “Ačhen akate pašo magarco, a me thaj o čhavro džas okote te pokloni men e Devlešće, pa boldasa men tumende.”<verse eid="GEN 22:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 22:6" />O Avraam lijas e kaš pale žrtva paljenica thaj natovarisarda len pe piro čhavo o Isaak, a vo lija e jag thaj e čhuri, pa von duj džene teljardine majdur.<verse eid="GEN 22:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="GEN 22:7" />Askal o Isaak phendas pire dadešće e Avraamešće: “Dade!”</para>
  <para style="p" vid="GEN 22:7">Vo phendas “So kames čhaveja?”</para>
  <para style="p" vid="GEN 22:7">O Isaak phendas: “Ake, e kaš thaj e jag si akate, ali kaj si o bakhro pale žrtva paljenica?”<verse eid="GEN 22:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 22:8" />A o Avraam phendas: “Čhaveja mungreja, o Del korkoro pobrinila pe palo bakhro pale žrtva paljenica.”</para>
  <para style="p" vid="GEN 22:8">Gajda von duj džene nastavisardine o drom majdur.<verse eid="GEN 22:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 22:9" />Kana aresline po than pale savo o Del phendas lešće, o Avraam vazdas žrtveniko thaj pe leste čhuta e kaš. Phanglas pire čhave e Isaako thaj čhuta les po žrtveniko opral pe kaš. <verse eid="GEN 22:9" /><verse number="10" style="v" sid="GEN 22:10" />Askal o Avraam lijas e čhuri thaj vazdas piro vas te mudarel pire čhaves. <verse eid="GEN 22:10" /><verse number="11" style="v" sid="GEN 22:11" />Ali o anđelo e GOSPODESKO akharda les andar o nebo: “Avraame! Avraame!”</para>
  <para style="p" vid="GEN 22:11">O Avraam phendas: “Ake taman!”<verse eid="GEN 22:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="GEN 22:12" />O anđelo phendas: “Na vazde ćiro vas po čhavro, thaj na khanči te ćeres lešće! Akana džanav kaj daras e Devlestar, kaj či uskratisardan mandar ni ćire jedine čhave.”<verse eid="GEN 22:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="GEN 22:13" />Askal o Avraam vazdas pire jakha thaj dikhla e bakhre savo e šngenca zapletisajlo ande kangre. O Avraam đelo, lija les thaj žrtvuisarda les sago žrtva paljenica umesto pire čhaves. <verse eid="GEN 22:13" /><verse number="14" style="v" sid="GEN 22:14" />O Avraam akhardas godova than “o GOSPOD pobrinila pe.” Zato još vi ađes phenel pe: “Pe planina e GOSPODEŠĆI vo pobrinila pe.”<verse eid="GEN 22:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="GEN 22:15" />O anđelo e GOSPODESKO po dujto drom palem akhardas e Avraame andar o nebo <verse eid="GEN 22:15" /><verse number="16" style="v" sid="GEN 22:16" />thaj phendas lešće: “Hav solah korkoro manca, phenel o GOSPOD, zato kaj ćerdan akava thaj či uskratisardan manđe ćire jedine čhave, <verse eid="GEN 22:16" /><verse number="17" style="v" sid="GEN 22:17" />but blagosloviva tut thaj dava tut but potomkurja pa avena gaći but sago e čereja po nebo thaj o pesko pe obala e morešći. Ćire potomkurja osvojina e gava pire dušmajenđe <verse eid="GEN 22:17" /><verse number="18" style="v" sid="GEN 22:18" />thaj prekal ćire potomkurja avena blagoslovime sa e thema pe phuv, zato kaj čhutan kan mande.”<verse eid="GEN 22:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="GEN 22:19" />Askal o Avraam bolda pe ke pire sluge, pa savora zajedno teljardine ande Beer Ševa, kaj o Avraam ačhilo te trajil.<verse eid="GEN 22:19" /></para>
  <para style="s">E Nahorešće potomkurja</para>
  <para style="p">
    <verse number="20" style="v" sid="GEN 22:20" />Pale varesavi vrjama phendine e Avraamešće, kaj vi lešće phralešće e Nahorešće e Milka bijandas čhaven: <verse eid="GEN 22:20" /><verse number="21" style="v" sid="GEN 22:21" />e prvobijande e Uca, lešće phrale e Buza thaj e Kemuele (e Aramešće dade), <verse eid="GEN 22:21" /><verse number="22" style="v" sid="GEN 22:22" />e Keseda, e Hazo, e Pildaše, e Jidlafe thaj e Betuela. <verse eid="GEN 22:22" /><verse number="23" style="v" sid="GEN 22:23" />O Betuel sas e Revekako dad. Akala ohto čhave e Milka bijandas e Avraamešće phralešće e Nahorešće. <verse eid="GEN 22:23" /><verse number="24" style="v" sid="GEN 22:24" />E Nahore sas vi romnji ropkinja savi akhardolas Reuma, a bijandas lešće čhaven: e Tevahe, e Gahame, e Tahaše thaj e Maahe.<verse eid="GEN 22:24" /></para>
  <chapter eid="GEN 22" />
  <chapter number="23" style="c" sid="GEN 23" />
  <para style="s">E Sarako smrto</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 23:1" />E Sara trajisarda šel thaj biš thaj efta brš. <verse eid="GEN 23:1" /><verse number="2" style="v" sid="GEN 23:2" />Muli ando Kirjat-Arba, godova si o Hevron ande phuv Hanaan. O Avraam žalilas pale Sara thaj rovelas pale late.<verse eid="GEN 23:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="GEN 23:3" />Kana uštilo o Avraam katar piri muli romnji, phendas e Hetitonenđe: <verse eid="GEN 23:3" /><verse number="4" style="v" sid="GEN 23:4" />“Me sem maškar tumende samo stranco thaj doseljeniko. Bićinen manđe than palo limori te šaj prahov mungre mule romnja.”<verse eid="GEN 23:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="GEN 23:5" />E Hetiturja phendine e Avraamešće: <verse eid="GEN 23:5" /><verse number="6" style="v" sid="GEN 23:6" />“Ašun amen, gospodarina. Tu san e Devlesko poglavari maškar amende. Prahosar ćire romnja ande amaro majlačho limori. Ni jek amendar či uskratila tuće piro limori te ande leste prahosares ćire romnja.”<verse eid="GEN 23:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="GEN 23:7" />Pe godova o Avraam uštilo thaj poklonisajlo e Hetitsko themešće savo trajilas ande godoja phuv, <verse eid="GEN 23:7" /><verse number="8" style="v" sid="GEN 23:8" />pa phendas lenđe: “Ako kamen te den man te akate prahosarav mungre mule romnja, askal ašunen so phenava thaj inćaren mungri rig anglo Efron, e Coharesko čhavo, <verse eid="GEN 23:8" /><verse number="9" style="v" sid="GEN 23:9" />te bićinel manđe e pećina Mahpela, savi si ande lesko vlasništvo, a ačhel okote po krajo ande lešći njiva. Neka bićinel lat manđe pale pherdi cena te avel manđe than palo prahope maškar tumende.”<verse eid="GEN 23:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 23:10" />O Efron bešelas aver Hetitonenca save ćidine pe ke gavesko vudar, pa angle savorende phendas e Avraamešće: <verse eid="GEN 23:10" /><verse number="11" style="v" sid="GEN 23:11" />“Na, gospodarina. Ašun mande: Dav tut e njiva thaj e pećina savi si pe late – dav tut godova angle mungre manuša. Prahosar okote ćire mule romnja.”<verse eid="GEN 23:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="GEN 23:12" />O Avraam pale poklonisajlo e manušenđe andar godoja phuv, <verse eid="GEN 23:12" /><verse number="13" style="v" sid="GEN 23:13" />pa phendas e Efronešće angle sa e manuša: “Moliv tut te ašunes man. Poćinava tuće kozom e njiva mol. Le kozom dav tut te šaj okote prahov mungre mule romnja.”<verse eid="GEN 23:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="GEN 23:14" />O Efron phendas e Avraamešće: <verse eid="GEN 23:14" /><verse number="15" style="v" sid="GEN 23:15" />“Ašun man gospodarina. Godoja phuv mol štar šela rupune kovanice, a godova naj khanči ni pale mande ni pale tute. Prahosar ćire romnja.”<verse eid="GEN 23:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="GEN 23:16" />O Avraam složisajlo e Efronesa thaj izmerisardas lešće rup kozom akava manglas angle aver Hetiturja: štar šela rupune kovanice gajda sar merin e trgovcurja.<verse eid="GEN 23:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 23:17" />Gajda e Efronešći njiva ande Mahpela paše ke Mamre – e njiva, e pećina thaj sa e kašta pe njiva, <verse eid="GEN 23:17" /><verse number="18" style="v" sid="GEN 23:18" />nakhle ando Avraamesko vlasništvo angle sa e Hetiturja save aviline pe gavešći kapija. <verse eid="GEN 23:18" /><verse number="19" style="v" sid="GEN 23:19" />Posle godova o Avraam prahosarda pire romnja e Sara ande pećina pe njiva Mahpela paše ke Mamre, godova si ando Hevron ande phuv Hanaan.<verse eid="GEN 23:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="GEN 23:20" />Gajda godoja njiva thaj e pećina pe late nakhline katar e Hetiturja ande Avraamesko vlasništvo palo prahope lešće familijaće.<verse eid="GEN 23:20" /></para>
  <chapter eid="GEN 23" />
  <chapter number="24" style="c" sid="GEN 24" />
  <para style="s">O Isaak thaj e Reveka</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 24:1" />O Avraam sas već dosta purano thaj o GOSPOD ande sa blagoslovisarda les.<verse eid="GEN 24:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="GEN 24:2" />Pa o Avraam phendas e majpurane slugašće andar piro ćher savo vodilas e briga pale lesko sasto barvalipe: “Čho ćiro vas pe mungre butine <verse eid="GEN 24:2" /><verse number="3" style="v" sid="GEN 24:3" />thaj ha manđe solah e GOSPODEJA, savo si Del e nebesko thaj e phuvjako, kaj mungre čhavešće či aneja pale romnji varesave Hanaanconenđe čheja, maškar save trajiv. <verse eid="GEN 24:3" /><verse number="4" style="v" sid="GEN 24:4" />Nego kaj džaja ande mungri phuv, ke mungri familija, thaj okotar aneja romnja pale mungro čhavo o Isaak.”<verse eid="GEN 24:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="GEN 24:5" />O sluga phučla e Avraame: “A so ako e manušnji či kamel te teljarel manca ande akaja phuv? Dali askal te inđarav ćire čhave ande phuv andar savi inkljistan?”<verse eid="GEN 24:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 24:6" />O Avraam phendas lešće: “Nisar te na inđares mungre čhave okote! <verse eid="GEN 24:6" /><verse number="7" style="v" sid="GEN 24:7" />O GOSPOD, savo si Del e nebesko, inkalda man andar o ćher mungre dadesko thaj andar e phuv ande savi bijandilem. Ćerda manca svato thaj hala manđe solah: ‘Ćire potomkonenđe dava akaja phuv.’ Vo angle tute bičhalela pire anđele, pa okotar aneja romnja pale mungro čhavo. <verse eid="GEN 24:7" /><verse number="8" style="v" sid="GEN 24:8" />A ako godoja manušnji či kamel te teljarel tusa, tu aveja oslobodime katar akaja solah savi dijan manđe. Ali mungre čhave nisar na inđar okote!”<verse eid="GEN 24:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 24:9" />Askal čhuta piro vas pe butine e Avraamešće thaj halas lešće solah.<verse eid="GEN 24:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 24:10" />Pale godova o sluga lijas e Avraamešće deš kamile thaj đelo. Inđardas pesa vi majlačhe darurja katar piro gospodari. Pa zaputisajlo ando Aram Naharajim, ande Nahorosko gav. <verse eid="GEN 24:10" /><verse number="11" style="v" sid="GEN 24:11" />Kana areslo anglo gav, ačhada e kamilen thaj mukla len te pašljon paše jek haing. Već sas talerjat, thaj sas e vrjama kana e manušnja inkljenas pe haing te astaren paj.<verse eid="GEN 24:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="GEN 24:12" />Askal phendas: “GOSPODE, Devla mungre gospodaresko e Avraamesko, pomožisar manđe ađes te avav uspešno thaj sikav ćiri bari ljubav mungre gospodarešće e Avraamešće. <verse eid="GEN 24:12" /><verse number="13" style="v" sid="GEN 24:13" />Ake, ačhav paše akaja haing, a e čheja andar akava gav aven te astaren o paj. <verse eid="GEN 24:13" /><verse number="14" style="v" sid="GEN 24:14" />E čhejaće savjaće phenava: ‘Moliv tut, muk ćiro ćupo tele te pijav paj,’ thaj voj phenel: ‘Le thaj pi, a napojiva vi ćire kamilen,’ neka avel godoja savja odredisardan pale ćiro sluga o Isaak. Pe godova džanav kaj sikadan bari ljubav mungre gospodarešće.”<verse eid="GEN 24:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="GEN 24:15" />Majsigo nego so završisarda e molitva, avili e Reveka pire ćuposa po dumo. Voj sas čhej e Betuelešći, savo sas čhavo e Milkako thaj e Avraamešće phralesko e Nahoresko. <verse eid="GEN 24:15" /><verse number="16" style="v" sid="GEN 24:16" />E Reveka sas zurale šukar thaj još sas čhej savi nas e muškarcosa. Voj fuljisti dži ke haing, pherda o ćupo e pajesa thaj bolda pe opre.<verse eid="GEN 24:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 24:17" />O sluga prastaja angle late thaj phendas: “Moliv tut, de man te pijav cara paj andar ćiro ćupo.”<verse eid="GEN 24:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 24:18" />A voj phendas lešće: “Pi, gospodarina”, pa sigo mukla o ćupo po vas thaj dija les te pijel. <verse eid="GEN 24:18" /><verse number="19" style="v" sid="GEN 24:19" />Thaj nakon so dija les paj te pijel, phendas: “Vi ćire kamilenđe anava paj sa dok či napojin pe.”<verse eid="GEN 24:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="GEN 24:20" />Thaj voj brzo ispraznisarda o ćupo ande balaja, pa prastaja palpale dži ke haing te astarel još paj. Gajda andas paj vi pale sa lešće kamile. <verse eid="GEN 24:20" /><verse number="21" style="v" sid="GEN 24:21" />O sluga či phendas khanči samo pažljivo lelas sama, te dićhel dali o GOSPOD ćerda te lesko drom avel uspešno.<verse eid="GEN 24:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="GEN 24:22" />Kana e kamile piline paj, o sluga inkaldas thaj dija lat kuč sunakuni čen savi džal po nak thaj duj bare sunakune narukvice, <verse eid="GEN 24:22" /><verse number="23" style="v" sid="GEN 24:23" />pa phučla lat: “Kašći san čhej? Moliv tut, phen manđe da li si ande ćire dadesko ćher than te raćaras?”<verse eid="GEN 24:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="GEN 24:24" />Voj phendas lešće: “Me sem čhej e Betuelešći saves e Milka bijandas e Nahorešće”, <verse eid="GEN 24:24" /><verse number="25" style="v" sid="GEN 24:25" />pa još phendas lešće: “Amende si but suluma thaj habe pale kamile, a vi than pale tumende te raćaren.”<verse eid="GEN 24:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="GEN 24:26" />Askal o sluga pelo pe koča anglo GOSPOD, thaj slavisarda les. <verse eid="GEN 24:26" /><verse number="27" style="v" sid="GEN 24:27" />Thaj phendas: “Neka avel blagoslovime o GOSPOD, Del mungre gospodaresko e Avraamesko, kaj či uskratisarda piri milost thaj vernost mungre gospodarešće. O GOSPOD anda man vorta ando ćher ke mungre gospodarešći familija.”<verse eid="GEN 24:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="GEN 24:28" />Askal e čhej prastajas thaj sa akava phendas ando ćher pire dejako. <verse eid="GEN 24:28" /><verse number="29" style="v" sid="GEN 24:29" />A e Reveka sas phral savo akhardolas Lavan. Vo prastajas dži ke Avraamesko sluga ke haing, <verse eid="GEN 24:29" /><verse number="30" style="v" sid="GEN 24:30" />kaj dikhla e čen po nak thaj e narukvice pe vas pire phejaće e Revekaće thaj ašundas so godova manuš phendas laće. Kana areslo dži ko Avraamesko sluga, arakhla les sar ačhel ke kamile paše ke haing. <verse eid="GEN 24:30" /><verse number="31" style="v" sid="GEN 24:31" />O Lavan phendas lešće: “Hajde andre, tu saves o GOSPOD blagoslovisarda. Sostar ačhes avri? Spremisardem tuće soba thaj than pale kamile.”<verse eid="GEN 24:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="GEN 24:32" />Pa e Avraamesko sluga dija andre ando ćher. E Lavanešće sluge fuljardine katar e kamile o tereto thaj dine len sulum thaj habe, a e slugašće thaj lešće manušenđe andine paj te thoven pire pungre.<verse eid="GEN 24:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="GEN 24:33" />Askal čhutine angle lende te han, a vo phendas: “Či hava dok či phenav okova pale soste avilem.”</para>
  <para style="p" vid="GEN 24:33">A o Lavan phendas lešće: “Phen!”<verse eid="GEN 24:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="GEN 24:34" />Vo phendas: “Me sem e Avraamesko sluga. <verse eid="GEN 24:34" /><verse number="35" style="v" sid="GEN 24:35" />O GOSPOD but blagoslovisarda mungre gospodares, thaj vo barvajlo. Dija les bakhre thaj guruven, sunakaj thaj rup, roburja thaj ropkinje, kamile thaj magarcurja. <verse eid="GEN 24:35" /><verse number="36" style="v" sid="GEN 24:36" />A e Sara, mungre gospodarešći romnji, bijandas lešće čhaves ande pire purane brš, thaj mungro gospodari dija les sa so si les. <verse eid="GEN 24:36" /><verse number="37" style="v" sid="GEN 24:37" />Mungro gospodari manglas te hav lešće solah thaj phendas manđe: ‘Te na anes mungre čhavešće pale romnji varesavja katar e Hanaanske čheja, ande savenđi phuv trajiv. <verse eid="GEN 24:37" /><verse number="38" style="v" sid="GEN 24:38" />Nego dža ando ćher mungre dadesko ke mungri familija, thaj an romnja pale mungro čhavo.’ <verse eid="GEN 24:38" /><verse number="39" style="v" sid="GEN 24:39" />Me askal phučlem mungre gospodare: ‘A so ako godoja manušnji či kamel te teljarel manca?’ <verse eid="GEN 24:39" /><verse number="40" style="v" sid="GEN 24:40" />A vo phendas manđe: ‘O GOSPOD, pe kašći volja trajiv, bičhalela tusa pire anđele thaj ćerela ćiro drom te avel uspešno, thaj tu pale mungro čhavo aneja romnja andar mungri familija, andar o ćher mungre dadesko. <verse eid="GEN 24:40" /><verse number="41" style="v" sid="GEN 24:41" />A kana aveja ke mungri familija, a čak vi ako von či den tut e romnja pale mungro čhavo, aveja slobodno katar e solah.’<verse eid="GEN 24:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="GEN 24:42" />Ađes kana areslem dži ke haing, phendam: ‘GOSPODE, Devla mungre gospodaresko e Avraamesko, ako kames, moliv tut de te o drom pe savo teljardem avel uspešno. <verse eid="GEN 24:42" /><verse number="43" style="v" sid="GEN 24:43" />Ake, ačhav paše akaja haing. Ako varesavi čhej avel te astarel paj, me phenav laće: “Moliv tut, de man te pijav cara paj andar ćiro ćupo.” <verse eid="GEN 24:43" /><verse number="44" style="v" sid="GEN 24:44" />A ako voj phenel manđe: “Pi, a me astarava paj vi pale ćire kamile,” neka voj avel godoja savja o GOSPOD odredisardas palo čhavo mungre gospodaresko.’ <verse eid="GEN 24:44" /><verse number="45" style="v" sid="GEN 24:45" />Thaj još majsigo nego so završisardem akaja molitva, inkljisti e Reveka e ćuposa po dumo. Fuljisti dži ke haing thaj astardas paj, a me phendem laće: ‘Moliv tu, de man te pijav paj.’ <verse eid="GEN 24:45" /><verse number="46" style="v" sid="GEN 24:46" />Voj brzo mukla tele piro ćupo thaj phendas: ‘Pi, a me dava vi ćire kamilen te pijen.’ Gajda me pilem a voj napojisardas vi mungre kamilen. <verse eid="GEN 24:46" /><verse number="47" style="v" sid="GEN 24:47" />Askal phučlem lat: ‘Kašći san čhej?’ A voj phendas: ‘Me sem e Betuelešći čhej, savo si e Nahoresko thaj e Milkako čhavo.’ Askal čhutem laće e čen po nak thaj e narukvice pe vas, <verse eid="GEN 24:47" /><verse number="48" style="v" sid="GEN 24:48" />askal pelem pe koča anglo GOSPOD, slavisardem thaj blagoslovisardem e GOSPODE, Devle mungre gospodarešće e Avraamešće, savo inđarda man e pravo dromesa te anav mungre gospodarešće phralešće unuka pale lesko čhavo. <verse eid="GEN 24:48" /><verse number="49" style="v" sid="GEN 24:49" />A akana phenen manđe, ako kamen te sikaven bari ljubav mungre gospodarešće, a ako či kamen, phenen manđe, te džanav so te ćerav majdur.”<verse eid="GEN 24:49" /></para>
  <para style="p">
    <verse number="50" style="v" sid="GEN 24:50" />Askal o Lavan thaj o Betuel phendine: “Pošto akava avel katar o GOSPOD, amen akate našti phenas khanči. <verse eid="GEN 24:50" /><verse number="51" style="v" sid="GEN 24:51" />Ake, e Reveka si angle tut. Le lat thaj dža. Neka avel romnji ćire gospodarešće čhavešći, sago kaj phendas o GOSPOD.”<verse eid="GEN 24:51" /></para>
  <para style="p">
    <verse number="52" style="v" sid="GEN 24:52" />Kana e Avraamesko sluga ašunda so phendine, poklonisajlo e GOSPODEŠĆE dži ke phuv. <verse eid="GEN 24:52" /><verse number="53" style="v" sid="GEN 24:53" />Askal o sluga inkaldas sunakuno thaj rupuno nakit, thaj haljine pa dija len e Revekaće, a vi laće phralešće thaj laće dejaće dija kuč darurja. <verse eid="GEN 24:53" /><verse number="54" style="v" sid="GEN 24:54" />Pale godova vo thaj e manuša save sas lesa haline thaj piline pa raćardine okote.</para>
  <para style="p" vid="GEN 24:54">Kana detharinako uštiline, e Avraamesko sluga phendas: “Mućen man te boldav man ke mungro gospodari.”<verse eid="GEN 24:54" /></para>
  <para style="p">
    <verse number="55" style="v" sid="GEN 24:55" />Ali e Revekako phral thaj laći dej phendine: “Neka e čhej ačhel amenca barem još deš đes, pa pale godova neka džal.”<verse eid="GEN 24:55" /></para>
  <para style="p">
    <verse number="56" style="v" sid="GEN 24:56" />Ali o sluga phendas lenđe: “Na zadržin man akana kana o GOSPOD ćerda mungro drom uspešno. Mućen man te bolda man ke mungro gospodari.”<verse eid="GEN 24:56" /></para>
  <para style="p">
    <verse number="57" style="v" sid="GEN 24:57" />Askal von phendine: “Akharasa e čheja thaj phučasa lat so voj gindil.”<verse eid="GEN 24:57" /></para>
  <para style="p">
    <verse number="58" style="v" sid="GEN 24:58" />Gajda akhardine e Reveka thaj phučline lat: “Da li kames odma te teljares akale manušesa?”</para>
  <para style="p" vid="GEN 24:58">Voj phendas: “Kamav.”<verse eid="GEN 24:58" /></para>
  <para style="p">
    <verse number="59" style="v" sid="GEN 24:59" />Pale godova von mukline e Reveka laće dadiljava, e Avraamešće slugasa thaj lešće manušenca.<verse eid="GEN 24:59" /></para>
  <para style="p">
    <verse number="60" style="v" sid="GEN 24:60" />Blagoslovisardine e Reveka thaj phendine laće:</para>
  <para style="b" vid="GEN 24:60" />
  <para style="q1" vid="GEN 24:60">“Pheja amarije,</para>
  <para style="q2" vid="GEN 24:60">av dej milje miljenđe čhavrenđi,</para>
  <para style="q1" vid="GEN 24:60">thaj neka ćire potomkurja zauzmin</para>
  <para style="q2" vid="GEN 24:60">e gava pire dušmajenđe.”<verse eid="GEN 24:60" /></para>
  <para style="b" />
  <para style="p">
    <verse number="61" style="v" sid="GEN 24:61" />Askal e Reveka thaj laće sluškinje spremisajle, bešline pe kamile thaj teljardine e Avraamešće slugava. Gajda o sluga lija e Reveka thaj đelotar.<verse eid="GEN 24:61" /></para>
  <para style="p">
    <verse number="62" style="v" sid="GEN 24:62" />O Isaak boldas pe andar o Beer-Lahaj-Roi, kaj trajilas ande pustinja Negev. <verse eid="GEN 24:62" /><verse number="63" style="v" sid="GEN 24:63" />Kana jek rjat inkljisto ando polje te phiravel pe, vazda pire jakha thaj dikhla e kamilen sar aven.<verse eid="GEN 24:63" /></para>
  <para style="p">
    <verse number="64" style="v" sid="GEN 24:64" />Vi e Reveka vazdas pire jakha thaj dikhla e Isaako. Pa fuljisti katar e kamila <verse eid="GEN 24:64" /><verse number="65" style="v" sid="GEN 24:65" />thaj phučlas e Avraamešće slugo: “Ko si okova manuš ando polje savo avel angle amende?”</para>
  <para style="p" vid="GEN 24:65">O sluga phendas: “Godova si mungro gospodari.”</para>
  <para style="p" vid="GEN 24:65">Pe godova voj lijas o dikhlo thaj učharda piro muj.<verse eid="GEN 24:65" /></para>
  <para style="p">
    <verse number="66" style="v" sid="GEN 24:66" />Askal o sluga phendas e Isaakošće sa so ćerda. <verse eid="GEN 24:66" /><verse number="67" style="v" sid="GEN 24:67" />Pale godova o Isaak lijas e Reveka inđarda lat ando šator pire dejako e Sarako, thaj voj postanisarda lešći romnji. Ande ljubav prema late o Isaak arakhlas uteha nakon o smrto pe dejako.<verse eid="GEN 24:67" /></para>
  <chapter eid="GEN 24" />
  <chapter number="25" style="c" sid="GEN 25" />
  <para style="s">E aver Avraamešće potomkurja</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 25:1" />O Avraam lijas pešće još jek romnja savi akhardolas Ketura.<verse eid="GEN 25:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="GEN 25:2" />Voj bijandas lešće e Zimrane, e Jokšane, e Medene, e Midjane, e Jišbake thaj e Šuahe.<verse eid="GEN 25:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="GEN 25:3" />E Jokšanešće bijandile o Ševa thaj o Dedan.</para>
  <para style="p" vid="GEN 25:3">E Dedanošće potomkurja si e Ašurcurja, Letušincurja thaj e Leumcurja.<verse eid="GEN 25:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="GEN 25:4" />E Midjanošće čhave sas o Efa, o Efer, o Enoh, o Avida thaj o Eldaa. Sa akala sas e Keturaće potomkurja.<verse eid="GEN 25:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="GEN 25:5" />Sa so sas les, o Avraam mukla e Isaakošće, <verse eid="GEN 25:5" /><verse number="6" style="v" sid="GEN 25:6" />a e čhavenđe save sas les lešće romnjenca e ropkinjenca dok sas još džudo dijas darurja thaj bičhalda len ande phuv po istok – dur katar lesko čhavo o Isaak.<verse eid="GEN 25:6" /></para>
  <para style="s">E Avraamesko meripe</para>
  <para style="p">
    <verse number="7" style="v" sid="GEN 25:7" />O Avraam trajisarda šel thaj eftavardeš thaj pandž brš. <verse eid="GEN 25:7" /><verse number="8" style="v" sid="GEN 25:8" />Mulo ando baro phuripe, pošto trajisarda but brš thaj sas prahome. <verse eid="GEN 25:8" /><verse number="9" style="v" sid="GEN 25:9" />Lešće čhave o Isaak thaj o Jišmael prahosardine les ande pećina Mahpela paše ke Mamre, pe njiva e Efronešći, savo sas čhavo katar o Hetito Cohar, <verse eid="GEN 25:9" /><verse number="10" style="v" sid="GEN 25:10" />pe njiva savi o Avraam ćindas katar e Hetiturja. Okote o Avraam si prahome paše piri romnji Sara.<verse eid="GEN 25:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="GEN 25:11" />Posle Avraamesko smrto, o Del blagoslovisarda lešće čhaves e Isaako, savo askal trajilas ke Beer-Lahaj-Roija.<verse eid="GEN 25:11" /></para>
  <para style="s">E Jišmaelošće potomkurja</para>
  <para style="p">
    <verse number="12" style="v" sid="GEN 25:12" />Akava si ramome palo poreklo e Avramešće čhavesko e Jišmaelosko, saves bijandas lešće e Egipćanka e Agara, e Saraći sluškinja.<verse eid="GEN 25:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="GEN 25:13" />Akava si e alava katar e Jišmaelošće čhave po redo gajda sar bijandile:</para>
  <para style="p" vid="GEN 25:13">E Jišmaelosko prvo čhavo sas o Nevajot, askal o Kedar, o Adbeel, o Mivsam,<verse eid="GEN 25:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="GEN 25:14" />o Mišma, o Duma, o Masa,<verse eid="GEN 25:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="GEN 25:15" />o Hadad, o Tema, o Jetur, o Nafiš thaj o Kedma.<verse eid="GEN 25:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="GEN 25:16" />Akala si e Jišmaelošće čhave, e dešuduj plemenske poglavarja, pe savenđe alava si akharde lenđe gava thaj lenđe taborja. <verse eid="GEN 25:16" /><verse number="17" style="v" sid="GEN 25:17" />O Jišmael trajisarda šel thaj trijanda thaj efta brš. Askal mukla pesko dži thaj mulo thaj sas pridružime pradadenđe. <verse eid="GEN 25:17" /><verse number="18" style="v" sid="GEN 25:18" />Lešće potomkurja avile te trajin ando than maškar e Havile thaj maškar o Šur, drom savo inđarel katar o Egipat prema e Asirija, a trajinas ando dušmanipe e aver Avraamešće potomkonenca.<verse eid="GEN 25:18" /></para>
  <para style="s">E Isaavesko thaj e Jakovesko bijandipe</para>
  <para style="p">
    <verse number="19" style="v" sid="GEN 25:19" />Akava si ramome palo poreklo e Avraamešće čhavesko e Isakosko:</para>
  <para style="p" vid="GEN 25:19">E Avraamešće bijandilo o Isaak. <verse eid="GEN 25:19" /><verse number="20" style="v" sid="GEN 25:20" />E Isaako sas štarvardeš brš kana lija romnjaće e Reveka, e čhora katar o Aramejco Betuel andar o Padan-Aram thaj e pheja katar o Aramejco Lavan.<verse eid="GEN 25:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="GEN 25:21" />O Isaak molisajlo e GOSPODEŠĆE pale piri romnji, kaj našti bijanelas. O GOSPOD ašundas lešći molitva thaj lešći romnji e Reveka ačhili khamni.<verse eid="GEN 25:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="GEN 25:22" />E čhavra ande lako đi ispidenas pe gajda kaj voj phendas: “Sostar si akava manca?”</para>
  <para style="p" vid="GEN 25:22">Zato đeli te pale godava phučel e GOSPODE.<verse eid="GEN 25:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="GEN 25:23" />A o GOSPOD phendas laće:</para>
  <para style="b" vid="GEN 25:23" />
  <para style="q1" vid="GEN 25:23">“Duj thema si ande ćiro đi;</para>
  <para style="q2" vid="GEN 25:23">duj thema podelina pe andar ćiro ođi.</para>
  <para style="q1" vid="GEN 25:23">Jek avela majzuralo katar aver</para>
  <para style="q2" vid="GEN 25:23">thaj o majpurano čhavo služila e majterne čhavešće.”<verse eid="GEN 25:23" /></para>
  <para style="b" />
  <para style="p">
    <verse number="24" style="v" sid="GEN 25:24" />Kana avili e vrjama te bijanel, ande lako đi sas duj blizancurja! <verse eid="GEN 25:24" /><verse number="25" style="v" sid="GEN 25:25" />O prvo savo inkljisto sas sa lolo thaj sa maljavo sago o ogrtači. Zato dine les alav Isav. <verse eid="GEN 25:25" /><verse number="26" style="v" sid="GEN 25:26" />A pale godova inkljisto lesko phral, gajda kaj e vastesa čvrsto inćarelas e Isave pale khuv. Zato dine les alav Jakov. E Isaako sas šovardeš brš, kana e Reveka bijanda.<verse eid="GEN 25:26" /></para>
  <para style="s">O Isav bićinel piro pravo sago prvobijando</para>
  <para style="p">
    <verse number="27" style="v" sid="GEN 25:27" />Kana e čhavra barile, o Isav postanisarda vešto lovco savo volilas te trajil avri pe pustinjske thana. O Jakov sas mirno manuš savo volilas te ačhel ćhere ande šatorurja. <verse eid="GEN 25:27" /><verse number="28" style="v" sid="GEN 25:28" />O Isaak majbut volilas e Isave kaj volilas te hal mas katar e divljač, ali e Reveka majbut volilas e Jakove.<verse eid="GEN 25:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="GEN 25:29" />Jekhar kana o Jakov ćiravelas habe, o Isav avilo andar e pustinja mulo bokhalo, <verse eid="GEN 25:29" /><verse number="30" style="v" sid="GEN 25:30" />thaj phendas e Jakovešće: “De man godova lolo habe! Merav e bokhatar!” Zbog godova akhardine les Edom.<verse eid="GEN 25:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="GEN 25:31" />Ali o Jakov phendas lešće: “Majsigo bićin manđe ćiro pravo savo si tut sago prvobijando.”<verse eid="GEN 25:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="GEN 25:32" />A o Isav phendas: “Ake, samo so či mulem, so trubul man pravo savo si man sago prvobijando?”<verse eid="GEN 25:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="GEN 25:33" />O Jakov phendas: “Ha manđe majsigo solah.”</para>
  <para style="p" vid="GEN 25:33">Thaj o Isav hala lešće solah thaj gajda bićinda lešće piro pravo savo sas les sago prvobijando.<verse eid="GEN 25:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="GEN 25:34" />Askal o Jakov dija e Isave mangro thaj zumi katar e leća. Vo halas thaj pilas, askal uštilo thaj đelotar.</para>
  <para style="p" vid="GEN 25:34">Gajda o Isav či marisarda pale piro pravo sago prvobijando.<verse eid="GEN 25:34" /></para>
  <chapter eid="GEN 25" />
  <chapter number="26" style="c" sid="GEN 26" />
  <para style="s">O Isaak ando Gerar</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 26:1" />Ande phuv avilo o bokhalipe ali nas sago ande Avraamešći vrjama, gajda o Isaak đelo te trajil ando Gerarsko phuv ko filistejsko caro Avimeleh.<verse eid="GEN 26:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="GEN 26:2" />O GOSPOD sikadilo e Isaakošće thaj phendas lešće: “Na dža ando Egipat, nego dža traji ande phuv pale savi phenava tuće. <verse eid="GEN 26:2" /><verse number="3" style="v" sid="GEN 26:3" />Traji varesavi vrjama ande akaja phuv, a me avava tusa thaj blagosloviva tut. Tuće thaj ćire potomkonenđe dava akaja phuv te pherav e solah savi halem ćire dadešće e Avraamešće. <verse eid="GEN 26:3" /><verse number="4" style="v" sid="GEN 26:4" />Ćerava te avel baro ćiro potomstvo kozom si vi čereja po nebo thaj dava len sa akala phuvja. Sa e thema pe phuv avena blagoslovime prekal ćiro potomstvo, <verse eid="GEN 26:4" /><verse number="5" style="v" sid="GEN 26:5" />zato kaj o Avraam čholas kan mande thaj inćarelas mungre nalogurja, zapovesti, uredbe thaj zakonurja.”<verse eid="GEN 26:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 26:6" />Gajda o Isaak ačhilo te trajil ando Gerar.<verse eid="GEN 26:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="GEN 26:7" />Kana e manuša andar godova than pučline les pale lešći romnji, vo phendas lenđe: “Voj si mungri phen,” kaj daralas te phenel: “Voj si mungri romnji.” Gindilas: “E manuša andar akava than šaj mudaren man zbog e Reveka, zato kaj si šukar.”<verse eid="GEN 26:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 26:8" />Kana o Isaak već lungo vrjama sas ando Gerar, o Avimeleh, o filistejsko caro, dikhla kroz e pendžera, kaj o Isaak milujil pire romnja e Reveka!<verse eid="GEN 26:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 26:9" />Pe godova o Avimeleh akhardas e Isaako thaj phendas lešće: “Gajda, voj si ćiri romnji! Sostar phendan kaj si ćiri phen?”</para>
  <para style="p" vid="GEN 26:9">O Isaako phendas lešće: “Me gndisardem kaj zbog late šaj hasardemas mungro trajo.”<verse eid="GEN 26:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 26:10" />Pe godova o Avimeleh phendas: “Sostar ćerdan amenđe godova? Vareko šaj pašljilosas ćire romnjasa thaj gajda tu crdanas e bari doš pe amende.”<verse eid="GEN 26:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="GEN 26:11" />Askal o Avimeleh dija naredba pire themešće: “Ko god ćerel vareso bilaćhe akale manušešće ili lešće romnjaće, hasarela po trajo.”<verse eid="GEN 26:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="GEN 26:12" />O Isaako ande godoja phuv posadisardas njiva, a isto brš godoja njiva šel drom majbut bijanda lešće, kaj o GOSPOD blagoslovisarda les. <verse eid="GEN 26:12" /><verse number="13" style="v" sid="GEN 26:13" />Gajda vo barvajlo thaj nastavisarda te barvavol dok či postanisardas zurale barvalo. <verse eid="GEN 26:13" /><verse number="14" style="v" sid="GEN 26:14" />Steknisardas gaći but bakhre thaj guruva, thaj gaći slugen kaj e Filistejcurja postanisardine ljubomorne pe leste. <verse eid="GEN 26:14" /><verse number="15" style="v" sid="GEN 26:15" />Zato e Filistejcurja zatrposardine sa e hainga e phuvjasa save hanadine e sluge lešće dadešće e Avraamešće dok sas o Avraam džudo.<verse eid="GEN 26:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="GEN 26:16" />Askal o Avimeleh phendas e Isaakošće: “Džatar amendar, kaj postanisardan but majmoćno amendar.”<verse eid="GEN 26:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 26:17" />Gajda o Isaak đelotar okotar, thaj razapnisardas pire šatorja ande gerarsko dolina, kaj ačhilo te trajil. <verse eid="GEN 26:17" /><verse number="18" style="v" sid="GEN 26:18" />O Isaak palem hanadas e hainga save sas hanade ande vrjama lešće dadešći e Avramešći, a save e Filistejcurja posle e Avraamesko smrto zatrposardine, thaj dija len iste alava save dija len majsigo lesko dad.<verse eid="GEN 26:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="GEN 26:19" />Kana e Isaakošće sluge hanavenas ande gerarsko dolina, arakhline e haing lačhe pajesa. <verse eid="GEN 26:19" /><verse number="20" style="v" sid="GEN 26:20" />Ali e gerarske pastirja haline pe e Isaakošće pastirenca thaj phendine: “Godova si amaro paj!”</para>
  <para style="p" vid="GEN 26:20">Zato o Isaak akhardas godoja haing Esek<note caller="+" style="f"><char style="fr" closed="false">26,20 </char><char style="ft" closed="false">Esek so značil “čingara”.</char></note>, kaj haline pe lesa. <verse eid="GEN 26:20" /><verse number="21" style="v" sid="GEN 26:21" />Askal hanadine aver haing, ali vi zbog late inkljiste čingara. Zato o Isaak akharda lat Sitna<note caller="+" style="f"><char style="fr" closed="false">26,21 </char><char style="ft" closed="false">Sitna so značil “dušmanipe”.</char></note>. <verse eid="GEN 26:21" /><verse number="22" style="v" sid="GEN 26:22" />O Isaak preselisajlo okotar, pa hanadas još jek haing, thaj khonik zbog late či hala pe. O Isaak akharda lat Rehovot<note caller="+" style="f"><char style="fr" closed="false">26,22 </char><char style="ft" closed="false">Rehovot so značil “baro than”. </char></note>, phendas: “O GOSPOD akana dija men than te brojčano barjos pe phuv.”<verse eid="GEN 26:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="GEN 26:23" />Okotar o Isaak đelotar te trajil ande Beer-Šeba.<verse eid="GEN 26:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="GEN 26:24" />Godoja rjat o GOSPOD sikadilo lešće thaj phendas: “Me sem o Del ćire dadesko e Avraamesko. Na dara, kaj me sem tusa. Blagosloviva tut thaj umnoživa ćire potomkonen, zbog mungro sluga Avraam.”<verse eid="GEN 26:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="GEN 26:25" />O Isaak okote vazda žrtveniko thaj slavisarda e GOSPODESKO alav. Okote razapnisardas piro šator, a lešće sluge hanadine haing.<verse eid="GEN 26:25" /></para>
  <para style="s">O Isaak sklopil savez e Avimelehosa</para>
  <para style="p">
    <verse number="26" style="v" sid="GEN 26:26" />E Isaakošće andar o Gerar avilo o Avimeleh pire savetnikosa Ahuzatova thaj e Piholeja, e vojskaće zapovednikosa.<verse eid="GEN 26:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="GEN 26:27" />O Isaak phučla len: “Sostar aviline mande kana mrzan man thaj kana tradine man tumendar?”<verse eid="GEN 26:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="GEN 26:28" />Von phendine: “Dikhlam kaj si o GOSPOD tusa, zato phendam hajde te has solah jek averenđe. Hajde te ćeras savez maškar amende <verse eid="GEN 26:28" /><verse number="29" style="v" sid="GEN 26:29" />te tu amenđe či ćeres bilačhipe, sago kaj ni amen či ćerdam tuće, nego uvek lačhe postupisardam tusa thaj muklam tut ando miro te džastar. A akana o GOSPOD blagoslovisarda tut.”<verse eid="GEN 26:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="GEN 26:30" />Askal o Isaak spremisardas gozba, pa haline thaj piline. <verse eid="GEN 26:30" /><verse number="31" style="v" sid="GEN 26:31" />Kana detharinako uštiline, haline solah jek avrešće. Pale godova o Isaak ispratisardas len thaj von đeletar lestar ando miro.<verse eid="GEN 26:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="GEN 26:32" />Godova isto đes aviline e Isaakošće sluge thaj javisardine lešće pale haing savi hanadine. Phendine lešće: “Arakhlam o paj!” <verse eid="GEN 26:32" /><verse number="33" style="v" sid="GEN 26:33" />O Isaak dija akhardas e haing Šiva. Zato vi ađes godova gav akhardol Beer Ševa.<verse eid="GEN 26:33" /></para>
  <para style="s">E Isavešće romnja</para>
  <para style="p">
    <verse number="34" style="v" sid="GEN 26:34" />Kana e Isave sas štarvardeš brš, oženisajlo duje Hetitenđe čhejenca: e Juditava, e Beerijašće čhejasa, thaj e Bosmatava, e Elonešće čhejasa. <verse eid="GEN 26:34" /><verse number="35" style="v" sid="GEN 26:35" />Akala duj Isavešće romnja ogorčinas e Isaakosko thaj e Revekako trajo.<verse eid="GEN 26:35" /></para>
  <chapter eid="GEN 26" />
  <chapter number="27" style="c" sid="GEN 27" />
  <para style="s">O Jakov po hohaipe čordas e Isavesko blagoslov</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 27:1" />Kana o Isaak phurilo thaj hasardas o vido gajda kaj majbut našti dićhelas pe jakha, akhardas pire majpurane čhave e Isave thaj phendas: “Čhaveja!” A o Isav phendas: “Ake, akate sem!”<verse eid="GEN 27:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="GEN 27:2" />O Isaak phendas: “Ake, phurilem thaj či džanav o đes kana merava. <verse eid="GEN 27:2" /><verse number="3" style="v" sid="GEN 27:3" />Zato tu akana le ćiro luko thaj ćiri tobolco e strelenca thaj dža ande pustinja te astares varesavi divljač. <verse eid="GEN 27:3" /><verse number="4" style="v" sid="GEN 27:4" />Askal ćer manđe ukusno habe, sosko me voliv, pa an manđe te hav, te šaj blagosloviv tut majsigo nego so merav.”<verse eid="GEN 27:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="GEN 27:5" />E Reveka čholas kan so o Isaak phenelas pire čhavešće e Isavešće, pa kana o Isav đelotar ande pustinja te astarel divljač pire dadešće, <verse eid="GEN 27:5" /><verse number="6" style="v" sid="GEN 27:6" />e Reveka phendas pire čhavešće e Jakovešće: “Ake, akana ašundem sar ćiro dad phenel ćire phralešće e Isavešće: <verse eid="GEN 27:6" /><verse number="7" style="v" sid="GEN 27:7" />‘An manđe varesavi divljač thaj ćer manđe ukusno habe te hav, te šaj blagosloviv tut anglo GOSPOD majsigo nego so merav.’ <verse eid="GEN 27:7" /><verse number="8" style="v" sid="GEN 27:8" />Zato akana, čhaveja mungreja, čho kan mande thaj ćer sar phenav tuće. <verse eid="GEN 27:8" /><verse number="9" style="v" sid="GEN 27:9" />Dža ando stado thaj an manđe duj šukar terne jarconen te lendar pale ćiro dad ćerav ukusno habe, sosko vo volil. <verse eid="GEN 27:9" /><verse number="10" style="v" sid="GEN 27:10" />Askal tu inđareja će dadešće te hal, te šaj blagoslovil tut majsigo nego so merel.”<verse eid="GEN 27:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="GEN 27:11" />Pe godova o Jakov phendas pire dejaće e Revekaće: “Ali mungro phral o Isav si maljavo manuš, a me naj sem. <verse eid="GEN 27:11" /><verse number="12" style="v" sid="GEN 27:12" />So ako o dad čhol piro vas pe mande? Askal haćarela kaj kamlem te hohavav les thaj gajda crdava pe mande romaja, a na blagoslov.”<verse eid="GEN 27:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="GEN 27:13" />Lešći dej pe godova phendas lešće: “Čhaveja mungreja, neka godola romaja peren pe mande. Čho tu samo kan mande. Dža thaj an manđe e terne jarconen.”<verse eid="GEN 27:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="GEN 27:14" />O Jakov đelo, astardas e terne jarconen thaj anda len ke piri dej, a voj ćerda ukusno habe sago kaj lesko dad volilas. <verse eid="GEN 27:14" /><verse number="15" style="v" sid="GEN 27:15" />Askal e Reveka lijas e majšukar drze save sas lat ando ćher katar piro majpurano čhavo katar o Isav thaj dijas pe piro majterno čhavo po Jakov. <verse eid="GEN 27:15" /><verse number="16" style="v" sid="GEN 27:16" />Askal lija e jarconenđi morćhi thaj učharda lešće vas thaj lešći kor. <verse eid="GEN 27:16" /><verse number="17" style="v" sid="GEN 27:17" />Pale godova dijas pire čhavešće Jakovešće okova ukusno habe thaj o mangro savo ćerda.<verse eid="GEN 27:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 27:18" />O Jakov đelo ke pesko dad thaj phendas: “Dade mungreja!”</para>
  <para style="p" vid="GEN 27:18">O Isaak phendas: “Akate sem. Savo san tu, čhaveja mungreja?”<verse eid="GEN 27:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="GEN 27:19" />O Jakov phendas pire dadešće: “Me sem o Isav, ćiro prvobijando čhavo. Ćerdem sar phendan manđe. Akana moliv tut, ušti, beš thaj ha katar akaja mungri divljač, te šaj blagoslovis man.”<verse eid="GEN 27:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="GEN 27:20" />O Isaak phučlas pire čhaves: “Sar areslan gajda sigo te astares, čhaveja mungreja?”</para>
  <para style="p" vid="GEN 27:20">O Jakov phendas lešće: “O GOSPOD, ćiro Del, pomognisarda manđe ande godova.”<verse eid="GEN 27:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="GEN 27:21" />Askal o Isaak phendas e Jakovešće: “Av majpaše, čhaveja, te čhav o vas pe tute te dikhav dali san tu vi čače mungro čhavo o Isav ili naj san.”<verse eid="GEN 27:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="GEN 27:22" />O Jakov avilo majpaše ke piro dad o Isaak thaj akava čhuta o vas pe leste thaj phendas: “O glaso si e Jakovesko, ali e vas si e Isavešće.” <verse eid="GEN 27:22" /><verse number="23" style="v" sid="GEN 27:23" />Či pindžarda les kaj lešće vas sas maljave sago lešće phralešće e Isavešće. Kana lijas te blagoslovil les, <verse eid="GEN 27:23" /><verse number="24" style="v" sid="GEN 27:24" />phučla les još jekhar: “San tu vi čače mungro čhavo o Isav?”</para>
  <para style="p" vid="GEN 27:24">O Jakov phendas lešće: “Me sem.”<verse eid="GEN 27:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="GEN 27:25" />Askal o Isaak phendas: “Čhaveja, an manđe te hav cara katar ćiri divljač, te šaj blagosloviv tut.”</para>
  <para style="p" vid="GEN 27:25">Thaj o Jakov andas lešće thaj o Isaak halas. A andas vi mol, thaj o Isaak vi pilas. <verse eid="GEN 27:25" /><verse number="26" style="v" sid="GEN 27:26" />Askal lesko dad o Isaak phendas lešće: “Av akana majpaše thaj čumide man, čhaveja.”<verse eid="GEN 27:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="GEN 27:27" />O Jakov avilo majpaše thaj čumida les. O Isaak haćardas o miris lešće drzengo thaj blagoslovisarda les alavenca:</para>
  <para style="b" vid="GEN 27:27" />
  <para style="q1" vid="GEN 27:27">“O miriso mungre čhavesko slično si sago o miris ando polje</para>
  <para style="q2" vid="GEN 27:27">savo o GOSPOD blagoslovisarda.<verse eid="GEN 27:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="GEN 27:28" />Neka o Del del tut rosa andar o nebo</para>
  <para style="q2" vid="GEN 27:28">thaj plodno phuv,</para>
  <para style="q2" vid="GEN 27:28">but điv thaj terni mol.<verse eid="GEN 27:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="GEN 27:29" />Neka e thema služin tuće</para>
  <para style="q2" vid="GEN 27:29">thaj neka e plemenurja den koča angle tute.</para>
  <para style="q1" vid="GEN 27:29">Vladisar pe ćire phral</para>
  <para style="q2" vid="GEN 27:29">thaj neka den koča angle tute</para>
  <para style="q2" vid="GEN 27:29">e potomkurja ćire dejaće.</para>
  <para style="q1" vid="GEN 27:29">Prokleto te avel ko tut proklinjil</para>
  <para style="q2" vid="GEN 27:29">thaj blagoslovime ko tut blagoslovil!”<verse eid="GEN 27:29" /></para>
  <para style="b" />
  <para style="p">
    <verse number="30" style="v" sid="GEN 27:30" />Samo so o Jakov đelotar katar piro dad nakon so akava blagoslovisarda les, lesko phral o Isav avilo andar o lovo. <verse eid="GEN 27:30" /><verse number="31" style="v" sid="GEN 27:31" />Thaj vi vo ćerda ukusno habe, anda les pire dadešće thaj phendas lešće: “Dade, ušti thaj ha cara katar mungri divljač, te šaj blagoslovis man.”<verse eid="GEN 27:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="GEN 27:32" />Lesko dad o Isaak phučla les: “Ko san tu?”</para>
  <para style="p" vid="GEN 27:32">Vo phendas: “Me sem ćiro prvobijando čhavo o Isav.”<verse eid="GEN 27:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="GEN 27:33" />Pe godava o Isaak silno uznemirisajlo thaj phendas: “A ko sas askal okova savo astardas divljač thaj andas manđe? Halem divljač majsigo nego so tu avilan. Blagoslovisardem les thaj vo avela blagoslovime.”<verse eid="GEN 27:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="GEN 27:34" />Kana o Isav ašundas so lesko dad phendas, ando baro muj thaj ogorčime rknjisardas thaj phendas pire dadešće: “Vi man blagoslovisar, dade!”<verse eid="GEN 27:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="GEN 27:35" />Ali o Isaak phendas lešće: “Ćiro phral avilo thaj po hohaipe lijas ćiro blagoslov.”<verse eid="GEN 27:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="GEN 27:36" />Askal o Isav phendas: “Či uzalud akhardol Jakov<note caller="+" style="f"><char style="fr" closed="false">27,36 </char><char style="ft" closed="false">Alav “Jakov” pe hebrejsko čhib značil “varalica”</char></note>? Već duj data hohada man. Lijas mungro pravo sago prvobijando, a akana lijas vi mungro blagoslov.”</para>
  <para style="p" vid="GEN 27:36">Askal phučlas: “Zar pale mande či muklan nijek blagoslov?”<verse eid="GEN 27:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="GEN 27:37" />O Isaak phendas e Isavešće: “Les čhutem pale ćiro gospodari thaj dijem les sa lešće phralen te aven lešće sluge, obezbedisardem les e đivesa thaj e terne molasa. Naj khanči so akana šaj ćerdemas pale tute, čhaveja!”<verse eid="GEN 27:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="GEN 27:38" />Pe godova o Isav phendas pire dadešće: “Zar si tu samo jek blagoslov, dade? Blagoslovisar vi man, dade mungreja!” Thaj ačhilo glasno te rovel.<verse eid="GEN 27:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="GEN 27:39" />Lesko dad o Isaak phendas lešće:</para>
  <para style="b" vid="GEN 27:39" />
  <para style="q1" vid="GEN 27:39">“Dur katar e plodno phuv avela ćiro ćher,</para>
  <para style="q2" vid="GEN 27:39">dur katar e rosa andar o nebo.<verse eid="GEN 27:39" /></para>
  <para style="q1">
    <verse number="40" style="v" sid="GEN 27:40" />Trajija katar ćiro mačo</para>
  <para style="q2" vid="GEN 27:40">thaj ćire phralešće služija.</para>
  <para style="q1" vid="GEN 27:40">Ali kana pobunija tut,</para>
  <para style="q2" vid="GEN 27:40">čhudeja lesko tereto katar ćiri kor.”<verse eid="GEN 27:40" /></para>
  <para style="b" />
  <para style="p">
    <verse number="41" style="v" sid="GEN 27:41" />O Isav zamrzisardas e Jakove zbog o blagoslov savo akales dija o dad, pa ande peste gindilas: “Mungro dad uskoro merela. Askal me mudarava mungre phrale e Jakove.”<verse eid="GEN 27:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="GEN 27:42" />Kana phendine e Revekaće so lako majpurano čhavo o Isav gindil te ćerel, voj bičhaldas te akharen laće majterne čhave e Jakov, pa phendas lešće: “Ćiro phral o Isav gindil te mudarel tut. <verse eid="GEN 27:42" /><verse number="43" style="v" sid="GEN 27:43" />Zato akana čho kan mande, čhaveja: odma akana naš ke mungro phral ko Lavan ando Haran. <verse eid="GEN 27:43" /><verse number="44" style="v" sid="GEN 27:44" />Ačh leste varesavi vrjama, dok ćire phrales mućel e holji. <verse eid="GEN 27:44" /><verse number="45" style="v" sid="GEN 27:45" />Kana majbut či avela holjariko pe tute thaj kana bistarela so ćerdan lešće, bičhalava pale tute te boldes tut. Sostar te hasarav tumen liduje dženen ande jek đes?”<verse eid="GEN 27:45" /></para>
  <para style="s">O Isaak bičhalel e Jakove ko Lavan</para>
  <para style="p">
    <verse number="46" style="v" sid="GEN 27:46" />E Reveka phendas e Isaakošće: “Smučisajlo manđe o trajo zbog e Isavešće hetitske romnja. Ako vi o Jakov lel pale romnji varesave Hetitkinja, romnja andar akaja phuv, so trubul man kasavo trajo!”<verse eid="GEN 27:46" /></para>
  <chapter eid="GEN 27" />
  <chapter number="28" style="c" sid="GEN 28" />
  <para style="p">
    <verse number="1" style="v" sid="GEN 28:1" />Askal o Isaak akhardas e Jakoves, thaj blagoslovisarda les, pa zapovedisardas lešće: “Na te les pale romnji ni jećha katar e hanaanske čheja! <verse eid="GEN 28:1" /><verse number="2" style="v" sid="GEN 28:2" />Odma dža ando Padan-Aram, ando ćher e Betuelesko, ćire dejaće dadesko ćher, thaj okote arakh tuće romnja, jećha katar e čheja ćire kakošće e Lavanešće. <verse eid="GEN 28:2" /><verse number="3" style="v" sid="GEN 28:3" />Neka o Svemogućo Del blagoslovil tut, thaj del tut but čhavra thaj tutar postanin but thema. <verse eid="GEN 28:3" /><verse number="4" style="v" sid="GEN 28:4" />Neka del tut thaj ćire potomkonen e Avraamesko blagoslov, pa zauzmin e phuv ande savi akana trajis sago stranco, e phuv savi o Del dija e Avraamešće.”<verse eid="GEN 28:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="GEN 28:5" />Gajda o Isaak bičhalda e Jakove thaj vo đelotar ando Padan-Aram, ko Laban, o čhavo e Aramejcosko e Betuelesko savo si phral e Revekako, e Jakovešće thaj e Isaakošće dejako.<verse eid="GEN 28:5" /></para>
  <para style="s">O Isav palem lel romnja</para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 28:6" />O Isav ašunda sar o Isaak blagoslovisarda e Jakove, bičhalda les ando Padan-Aram te okotar lel pešće romnja thaj kaj zapovedisardas lešće: “Na te les pale romnji nijek čheja andar o Hanaan,” <verse eid="GEN 28:6" /><verse number="7" style="v" sid="GEN 28:7" />thaj kaj o Jakov čhuta kan ke piro dad thaj ke piri dej thaj đelotar ando Padan-Aram. <verse eid="GEN 28:7" /><verse number="8" style="v" sid="GEN 28:8" />Gajda o Isav svatisardas kozom si e Hanaanke čheja mrske lešće dadešće e Isaakošće, <verse eid="GEN 28:8" /><verse number="9" style="v" sid="GEN 28:9" />pa đelo ko Jišmael thaj paše romnja save već sas les, lijas pešće pale romnji e Mahalata, e Avraamešće čhavešće e Jišmaelošće čheja, e Nevajotošće pheja.<verse eid="GEN 28:9" /></para>
  <para style="s">E Jakovesko suno ando Betel</para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 28:10" />O Jakov đelotar andar e Beer Ševa thaj zaputisajlo ando Haran. <verse eid="GEN 28:10" /><verse number="11" style="v" sid="GEN 28:11" />Areslo dži ke jek than thaj okote raćardas, kaj o kham već pelo. Lijas jek katar e bara save sas pe godova than thaj čhuta les pešće talo šoro thaj pašljilo te sovel. <verse eid="GEN 28:11" /><verse number="12" style="v" sid="GEN 28:12" />Thaj dikhla ando suno merdevina sar ačhel pe phuv, a lako vrho sas dži ko nebo. E Devlešće anđelurja pe late lenas pe opre thaj fuljenas tele, <verse eid="GEN 28:12" /><verse number="13" style="v" sid="GEN 28:13" />a po vrho ačhelas o GOSPOD thaj phenel lešće: “Me sem o GOSPOD, o Del e Avraamesko thaj o Del e Isaakosko. E phuv pe savi pašljos dava tuće thaj ćire potomkonenđe. <verse eid="GEN 28:13" /><verse number="14" style="v" sid="GEN 28:14" />Ćire potomkonen avela sago o praho pe phuv thaj buljona po zapad thaj po istok, po sever thaj po jugo. Prekal tute thaj ćire potomkurja avena blagoslovime sa e thema pe phuv. <verse eid="GEN 28:14" /><verse number="15" style="v" sid="GEN 28:15" />Me sem tusa, lava sama pe tute kaj got te džas thaj boldava tut palpale ande akaja phuv. Či mukava tut dok či pherav okova so obećisardem tuće.”<verse eid="GEN 28:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="GEN 28:16" />Kana o Jakov džungadilo andar o suno, phendas: “Čače si o GOSPOD pe akava than, a me godova či džanglem!” <verse eid="GEN 28:16" /><verse number="17" style="v" sid="GEN 28:17" />Thaj pherdo dar phendas: “Sar si strašno akava than! Akava naj khanči aver nego e Devlesko ćher! Akava si e nebesko kapija!”<verse eid="GEN 28:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 28:18" />Detharinako rano o Jakov uštilo, lijas okova bar savo čhuta pešće talo šoro, pa uspravisarda les sar stupo thaj pe leste čhorda ulje. <verse eid="GEN 28:18" /><verse number="19" style="v" sid="GEN 28:19" />Godova than akhardas Betel<note caller="+" style="f"><char style="fr" closed="false">28,19 </char><char style="ft" closed="false">Betel znači “Devlesko ćher”.</char></note>. (Godova than akhardolas Luz.)<verse eid="GEN 28:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="GEN 28:20" />Askal o Jakov halas solah e alavenca: “Ako o Del avela manca thaj ako lela sama pe mande pe akava drom pe savo teljardem, ako dela man mangro te hav thaj drze te lav pe mande, <verse eid="GEN 28:20" /><verse number="21" style="v" sid="GEN 28:21" />thaj džudo thaj sasto bolda man ando ćher mungre dadesko, askal tu GOSPODE aveja mungro Del. <verse eid="GEN 28:21" /><verse number="22" style="v" sid="GEN 28:22" />Akava bar savo uspravisardem sago stupo avela ćiro ćher, Devla. A katar sa so deja man, Devla, tuće dava deš posto.”<verse eid="GEN 28:22" /></para>
  <chapter eid="GEN 28" />
  <chapter number="29" style="c" sid="GEN 29" />
  <para style="s">O Jakov aresel ando Haran</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 29:1" />Askal o Jakov nastavisarda o drom thaj avilo ande phuv ke istočne thema. <verse eid="GEN 29:1" /><verse number="2" style="v" sid="GEN 29:2" />Katar jekhar dikhla ando polje e haing thaj trin stada bakhren sar pašljon oko late, kaj e bakhren denas paj andar godoja haing. E haing sas učhardi e bare bareja. <verse eid="GEN 29:2" /><verse number="3" style="v" sid="GEN 29:3" />Tek kana sa e stada bakhre ćidinesas pes pe godova than, e pastirja linesas o bar tele katar e haing thaj dinesas e bakhren te pijen paj. Posle godova palem e baresa učhardinesas e haing.<verse eid="GEN 29:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="GEN 29:4" />O Jakov phučla e pastiren: “Katar sen, phralalen?”</para>
  <para style="p" vid="GEN 29:4">Von phendine: “Andar o Haran.”<verse eid="GEN 29:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="GEN 29:5" />Askal vo phučla len: “Pindžaren tumen e Lavane, e Nahorešće unukos?”</para>
  <para style="p" vid="GEN 29:5">Von phendine lešće: “Pindžaras.”<verse eid="GEN 29:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 29:6" />O Jakov majdur phučla len: “Sar si vo?”</para>
  <para style="p" vid="GEN 29:6">Von phendine: “Lačhe si. Ake, lešći čhej e Rahilja baš avel lešće bakhrenca.” <verse eid="GEN 29:6" /><verse number="7" style="v" sid="GEN 29:7" />O Jakov phendas: “Dićhen, o đes si još baro. Naj još e vrjama te e stoka ćidel pe palo sovipe. Den e bakhren paj thaj mućen len pe čar.”<verse eid="GEN 29:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 29:8" />Von phendine: “Našti, dok sa e stada či ćiden pe thaj dok o bar či lel pe tele katar e haing. Tek askal šaj das paj e bakhren.”<verse eid="GEN 29:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 29:9" />Dok vo još ćerelas svato lenca, aresli e Rahilja pire dadešće bakhrenca, kaj voj lelas sama pe lende. <verse eid="GEN 29:9" /><verse number="10" style="v" sid="GEN 29:10" />Kana o Jakov dikhla e Rahilja, pire kakošće e Lavanešće čheja, thaj lešće bakhren, avilo ke haing, lijas tele o bar katar e haing thaj dijas paj pire kakošće bakhren. <verse eid="GEN 29:10" /><verse number="11" style="v" sid="GEN 29:11" />Askal o Jakov čumida e Rahilja thaj ačhilo glasno te rovel. <verse eid="GEN 29:11" /><verse number="12" style="v" sid="GEN 29:12" />Vo phendas e Rahiljaće kaj vo si laće dadešće phejako čhavo, e Revekako. Gajda voj prastaja thaj godova phendas pire dadešće.<verse eid="GEN 29:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="GEN 29:13" />Kana o Lavan ašundas kaj avilo o Jakov, lešće phejako čhavo, prastajas angle leste, dija les mrtiko thaj čumida les. Askal inđarda les ande piro ćher. A o Jakov pe godova ćerda svato e Lavanešće sa so sas lesa. <verse eid="GEN 29:13" /><verse number="14" style="v" sid="GEN 29:14" />O Lavan phendas: “Vi čače san tu mungro telo thaj rat!”</para>
  <para style="s" vid="GEN 29:14">O Jakov lel pale romnji e Lija thaj e Rahilja</para>
  <para style="p" vid="GEN 29:14">Kana o Jakov sas čhon đes ko Lavan, <verse eid="GEN 29:14" /><verse number="15" style="v" sid="GEN 29:15" />o Lavan phendas lešće: “Zar te ćeres manđe bući ivja zato kaj san mungre phejako čhavo? Phen manđe kozom te poćinav tuće.”<verse eid="GEN 29:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="GEN 29:16" />A e Lavane sas duj čheja. E majpurani akhardolas Lija, a e majterni Rahilja. <verse eid="GEN 29:16" /><verse number="17" style="v" sid="GEN 29:17" />E Lija sas šukar jakha, ali e Rahilja sas zgodno thaj šukar. <verse eid="GEN 29:17" /><verse number="18" style="v" sid="GEN 29:18" />O Jakov zavolisarda e Rahilja, pa zato phendas: “Ćerava bući pale tute efta brš pale ćiri majterni čhej e Rahilja.”<verse eid="GEN 29:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="GEN 29:19" />O Laban phendas: “Majlačhe te dav lat tuće nego varesave averešće. Ačh mande.”<verse eid="GEN 29:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="GEN 29:20" />Gajda o Jakov ćerelas bući pale Rahilja efta brš, save zbog e ljubav prema late sas lešće sago varekazom đesa.<verse eid="GEN 29:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="GEN 29:21" />Askal o Jakov phendas e Lavanešće: “De man mungre romnja, te lav lat romnjaće, kaj e vrjama savi ćeravas bući pale tute nakhli.”<verse eid="GEN 29:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="GEN 29:22" />Askal o Lavan ćida sa e manušen andar godova than thaj ćerda bari gozba. <verse eid="GEN 29:22" /><verse number="23" style="v" sid="GEN 29:23" />Ali kana peli e rjat, vo lijas pire čheja e Lija thaj dija lat e Jakovešće pale romnji thaj o Jakov pašljilo lava. <verse eid="GEN 29:23" /><verse number="24" style="v" sid="GEN 29:24" />A o Lavan dija pire ropkinja e Zilpa pire čhejaće e Lijaće pale sluškinja. <verse eid="GEN 29:24" /><verse number="25" style="v" sid="GEN 29:25" />Kana đesajli e detharin, o Jakov dikhla kaj e Lija si paše leste. Askal phendas e Lavanešće: “So ćerdan manđe godova? Zar či ćerdem bući pale Rahilja? Sostar hohadan man?”<verse eid="GEN 29:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="GEN 29:26" />O Lavan phendas lešće: “Akate amende naj običaj te e terni čhej lel rome majsigo katar e purani čhej. <verse eid="GEN 29:26" /><verse number="27" style="v" sid="GEN 29:27" />Završisar o svadbeno kurko e Lijava, pa askal dava tut vi e majterna pale savi ćereja bući aver efta brš.”<verse eid="GEN 29:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="GEN 29:28" />O Jakov gajda vi ćerda thaj završisarda o svadbeno kurko e Lijava. Askal o Lavan dija les pire aver čheja e Rahilja pale romnji, <verse eid="GEN 29:28" /><verse number="29" style="v" sid="GEN 29:29" />a pire ropkinja e Bilha dija e Rahiljaće pale sluškinja. <verse eid="GEN 29:29" /><verse number="30" style="v" sid="GEN 29:30" />Gajda o Jakov pašljilo vi e Rahiljasa. A e Rahilja volilas majbut katar e Lija. Pale godova ćerelas bući palo Lavan još efta brš.<verse eid="GEN 29:30" /></para>
  <para style="s">E Jakovešće čhavra</para>
  <para style="p">
    <verse number="31" style="v" sid="GEN 29:31" />O GOSPOD dikhla kaj e Lija naj volime, pa dija lat te ačhel khamni, a e Rahilja naštik ačhelas khamni.<verse eid="GEN 29:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="GEN 29:32" />E Lija ačhili khamni thaj bijandas čhaves saves dija alav Ruvim, kaj phendas: “O GOSPOD dikhla mungri nevolja, akana mungro rom volila man.”<verse eid="GEN 29:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="GEN 29:33" />E Lija palem ačhili khamni thaj bijandas čhaves, pa phendas: “Zato kaj o GOSPOD ašunda kaj naj sem volime, dija man vi akale čhaves.” Zato dija les alav Simeon.<verse eid="GEN 29:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="GEN 29:34" />Askal palem ačhili khamni thaj bijandas čhaves, pa phendas: “Akana mungro rom sikavela manđe piri ljubav, kaj bijandem lešće trin čhaven.” Zato dija les alav Levije.<verse eid="GEN 29:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="GEN 29:35" />Voj još jekhar ačhili khamni thaj bijandas čhaves, pa phendas: “Akava drom dava slava e GOSPODEŠĆE.” Zato dija les alav Juda.</para>
  <para style="p" vid="GEN 29:35">Askal majbut više ačhili te bijanel.<verse eid="GEN 29:35" /></para>
  <chapter eid="GEN 29" />
  <chapter number="30" style="c" sid="GEN 30" />
  <para style="p">
    <verse number="1" style="v" sid="GEN 30:1" />Kana e Rahilja dikhla kaj či ačhel khamni, postanisardas ljubomorno pe piri phen thaj phendas e Jakovešće: “De man čhavren, ili merava!”<verse eid="GEN 30:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="GEN 30:2" />O Jakov holjajlo pe Rahilja thaj phendas laće: “Pa naj sem me o Del savo či dija tut čhavren.”<verse eid="GEN 30:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="GEN 30:3" />Voj phendas: “Ake, mungri sluškinja e Bilha. Sov lasa, te voj bijanel pale mande, te me gajda prekal late dobiv čhavren.”<verse eid="GEN 30:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="GEN 30:4" />Gajda dija les pire sluškinja e Bilha pale romnji, pa o Jakov sutas lasa, <verse eid="GEN 30:4" /><verse number="5" style="v" sid="GEN 30:5" />thaj voj ačhili khamni thaj bijandas e Jakovešće čhaves.<verse eid="GEN 30:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 30:6" />Askal e Rahilja phendas: “O Del presudisarda ande mungri korist. Ašundas mungri molitva thaj dija man čhaves.” Zato dija les alav Dan.<verse eid="GEN 30:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="GEN 30:7" />E Rahiljaći sluškinja e Bilha palem ačhili khamni thaj bijandas e Jakovešće e dujto čhaves.<verse eid="GEN 30:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 30:8" />Askal e Rahilja phendas: “Bari sas mungri borba mungre phejava, ali pobedisardem.” Zato dija les alav Neftalim.<verse eid="GEN 30:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 30:9" />Kana e Lija dikhla kaj majbut či bijanel, lijas pire sluškinja e Zilpa thaj dija lat e Jakovešće pale romnji. <verse eid="GEN 30:9" /><verse number="10" style="v" sid="GEN 30:10" />Gajda vi e Lijaći sluškinja e Zilpa bijandas e Jakovešće čhaves.<verse eid="GEN 30:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="GEN 30:11" />Askal e Lija phendas: “Savi bah si man!” Zato dija les alav Gad.<verse eid="GEN 30:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="GEN 30:12" />Pale godova e Lijaći sluškinja e Zilpa bijandas e Jakovešće vi aver čhaves.<verse eid="GEN 30:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="GEN 30:13" />Askal e Lija phendas: “Baš sem bahtali! E manušnja akharena man bahtali!” Zato dija les alav Asir.<verse eid="GEN 30:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="GEN 30:14" />Jekhar, ande vrjama kana sas e đivešći žetva, o Ruvim đelo ando polje thaj arakhlas mandragore<note caller="+" style="f"><char style="fr" closed="false">30,14 </char><char style="ft" closed="false">E manuša ande godoja vrjama paćanas kaj e mandragore e manušnjenđe pomožinas te ačhen khamne.</char></note>. Anda len pire dejaće e Lijaće. Pa e Rahilja phendas e Lijaće: “De man, moliv tut, cara katar e mandragore ćire čhavešće!”<verse eid="GEN 30:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="GEN 30:15" />Ali e Lija phendas laće: “Zar naj tuće dosta kaj lijan mungre romes, nego kames te les mandar vi e mandragore mungre čhavešće?”</para>
  <para style="p" vid="GEN 30:15">E Rahilja phendas: “Lačhe. Nek o Jakov arjat pašljol tusa ande zamena pale mandragore ćire čhavešće.”<verse eid="GEN 30:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="GEN 30:16" />Kana o Jakov talerjat bolda pe andar o polje, e Lija inkljisti angle leste thaj phendas: “Arjat soves manca, kaj unajmisardem tut pale mandragore mungre čhavešće.” Gajda godoja rjat o Jakov sutas lasa.<verse eid="GEN 30:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 30:17" />O Del ašundas e Lijaći molitva thaj voj ačhili khamni thaj bijandas e Jakovešće pandžte čhaves.<verse eid="GEN 30:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 30:18" />Askal e Lija phendas: “O Del nagradisarda man kaj dijem mungre sluškinja mungre romešće.” Zato dija les alav Isahar.<verse eid="GEN 30:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="GEN 30:19" />E Lija palem ačhili khamni thaj bijandas e Jakovešće šovte čhaves, <verse eid="GEN 30:19" /><verse number="20" style="v" sid="GEN 30:20" />pa phendas: “O Del dija man dragoceno daro. Akana mungro rom poštuila man, kaj bijandem lešće šov čhaven.” Zato dija les alav Zavulon.<verse eid="GEN 30:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="GEN 30:21" />Posle e Lija bijandas vi čheja thaj dija lat alav Dina.<verse eid="GEN 30:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="GEN 30:22" />Askal o Del dija pe gođi ke Rahilja, ašundas laći molitva thaj ćerda te šaj ačhel khamni. <verse eid="GEN 30:22" /><verse number="23" style="v" sid="GEN 30:23" />Voj ačhili khamni thaj bijandas čhave, pa phendas: “O Del lijas mandar mungro ladžavo.” <verse eid="GEN 30:23" /><verse number="24" style="v" sid="GEN 30:24" />Dija les alav Josif thaj phendas: “Neka o GOSPOD del man još jećhe čhaves.”<verse eid="GEN 30:24" /></para>
  <para style="s">O Jakov thaj o Lavan</para>
  <para style="p">
    <verse number="25" style="v" sid="GEN 30:25" />Kana e Rahilja bijandas e Josife, o Jakov phendas e Lavanešće: “Muk man te bolda man ande mungri phuv kaj bijandilem. <verse eid="GEN 30:25" /><verse number="26" style="v" sid="GEN 30:26" />De man mungre romnjen thaj mungre čhavren, pale save služisardem tuće, pa te džavtar. Kaj tu lačhe džanes kozom ćerdem bući pale tute.”<verse eid="GEN 30:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="GEN 30:27" />Pe godova o Laban phendas lešće: “Ako arakhlem milost angle tute, moliv tut, na dža. Prekal o drabaripe saznaisardem kaj o GOSPOD blagoslovisarda man zbog tute.” <verse eid="GEN 30:27" /><verse number="28" style="v" sid="GEN 30:28" />Thaj još phendas: “Odredi poćin savi kames mandar, thaj dava tut.”<verse eid="GEN 30:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="GEN 30:29" />O Jakov phendas lešće: “Džanes sar služisardem tuće thaj kozom ćiri stoka napreduisarda tale mungri briga. <verse eid="GEN 30:29" /><verse number="30" style="v" sid="GEN 30:30" />Okova cara so sas tut dok me či avilem, akana but umnožisajlo thaj o GOSPOD blagoslovilas tut kroz sa so me ćerdem. Pa zar naj akana e vrjama te ćerav bući pale mungro ćher?”<verse eid="GEN 30:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="GEN 30:31" />O Laban phučlas: “So kames te odrediv tuće sago poćin?”</para>
  <para style="p" vid="GEN 30:31">“Na te des man khanči,” phendas o Jakov. “Ali, ako ćeres manđe akava, palem lava sama pe ćire bakhre: <verse eid="GEN 30:31" /><verse number="32" style="v" sid="GEN 30:32" />Muk te ađes nakhav kroz sa ćire stadurja thaj te odvojiv svako pegavo thaj šareno bakhro, svako kalo bakhroro, svako pegavo thaj šareno buznji. Neka godova avel mungri poćin. <verse eid="GEN 30:32" /><verse number="33" style="v" sid="GEN 30:33" />Kana ubuduće proveris e stoka, savi lijem sago poćin, neka mungro paćivalipe svedočil pale mande. Svako buznji savi ande mungro stado či avela šareno ili pegavo thaj svako bakhroro savo či avela kalo, neka smatrin pe sago kaj si čordine.”<verse eid="GEN 30:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="GEN 30:34" />O Laban phendas: “Lačhe, neka avel sar phendan.” <verse eid="GEN 30:34" /><verse number="35" style="v" sid="GEN 30:35" />Ali godova isto đes o Laban odvojisardas sa e jarcen saven sas pruge ili šare thaj sa e šarene thaj pegave buznjen, sa saven sas pe lende beleg thaj sa e kale bakhroren, pa dija len pire čhavenđe te len sama pe lende. <verse eid="GEN 30:35" /><verse number="36" style="v" sid="GEN 30:36" />Askal đelo dur katar o Jakov trin đes phiripe, a o Jakov ačhilo te lel sama pe aver Labanesko stado.<verse eid="GEN 30:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="GEN 30:37" />O Jakov lijas e zelene krandže katar e topola, katar o badem thaj katar o kesten. Ćerda pe lende parne pruge gajda kaj užarda e kora te dićhol o parno kaš. <verse eid="GEN 30:37" /><verse number="38" style="v" sid="GEN 30:38" />Askal e užarde krandže čhuta ande balaje te avel anglo stado kana avena te pijen paj. Kaj e stoka parilas pe, kana avelas te pijel paj. <verse eid="GEN 30:38" /><verse number="39" style="v" sid="GEN 30:39" />Parinas pe angle krandže pa bijanenas prugaste, pegave thaj šarene terne.<verse eid="GEN 30:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="GEN 30:40" />O Jakov e terni stoka odvojisarda, a avren boldas te dićhen ande prugasto thaj kali stoka savi sas e Lavanešći. Gajda o Jakov dobisardas pešće odvojime stado thaj či hamilas len e Lavanešće životinjenca. <verse eid="GEN 30:40" /><verse number="41" style="v" sid="GEN 30:41" />Kana e majzurale životinje andar o stado parinas pe, o Jakov čholas e krandže ande balaje, te parin pe angle lende. <verse eid="GEN 30:41" /><verse number="42" style="v" sid="GEN 30:42" />Ali angle slabe životinje o Jakov či čholas e krandže. Gajda e slabe životinje pripadnisardine e Lavanešće, a e majzurale e Jakovešće. <verse eid="GEN 30:42" /><verse number="43" style="v" sid="GEN 30:43" />Gajda o Jakov zurale barvajlo, steknisardas but stoka, sluge thaj sluškinje, kamile thaj magarcurja.<verse eid="GEN 30:43" /></para>
  <chapter eid="GEN 30" />
  <chapter number="31" style="c" sid="GEN 31" />
  <para style="s">O Jakov našel katar o Lavan</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 31:1" />O Jakov ašunda sar e Lavanešće čhave phenen: “O Jakov lijas sa so sas amare dades. Sa akava barvalipe steknisardas pe okova so sas amare dadesko.”<verse eid="GEN 31:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="GEN 31:2" />A o Jakov dikhla kaj ni o Lavan naj majbut sago kaj sas lesa majsigo.<verse eid="GEN 31:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="GEN 31:3" />Askal o GOSPOD phendas e Jakovešće: “Bolde tut ande phuv ćire pradadenđi, ke ćiri familija. Me avava tusa.”<verse eid="GEN 31:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="GEN 31:4" />O Jakov bičhaldas pale Rahilja thaj pale Lija, te aven ando polje okote kaj sas lešće stadurja, <verse eid="GEN 31:4" /><verse number="5" style="v" sid="GEN 31:5" />thaj phendas lenđe: “Dikhav kaj tumaro dad naj manca sago kaj sas majsigo. Ali o Del mungre dadesko sas manca. <verse eid="GEN 31:5" /><verse number="6" style="v" sid="GEN 31:6" />Tumen džanen kaj ćeravas bući pale tumaro dad mungre saste snagasa, <verse eid="GEN 31:6" /><verse number="7" style="v" sid="GEN 31:7" />a ipak vo hohavelas man, deš drom menjilas mungri poćin. Ali o Del či dija les te naudil manđe. <verse eid="GEN 31:7" /><verse number="8" style="v" sid="GEN 31:8" />Kana god o Lavan phendas: ‘E pegave životinje avena ćiri poćin’, ande sa e stadurja bijandonas pegave životinje. A kana phendas: ‘E prugaste avena ćiri poćin’, ande sa e stadurja bijandonas prugaste životinje. <verse eid="GEN 31:8" /><verse number="9" style="v" sid="GEN 31:9" />Gajda o Del lijas tumare dadestar e stoka thaj dija lat manđe.<verse eid="GEN 31:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 31:10" />Jekhar, kana o stado parilas pe, dikhlem ando suno kaj e jarcurja save parinas pe e buznjenca sas prugaste, pegave ili šarene. <verse eid="GEN 31:10" /><verse number="11" style="v" sid="GEN 31:11" />E Devlesko anđelo phendas manđe ando suno: ‘Jakove!’ Me phendem: ‘Akate sem!’ <verse eid="GEN 31:11" /><verse number="12" style="v" sid="GEN 31:12" />A o anđelo phendas: ‘Vazde ćire jakha thaj dićheja kaj sa e jarcurja save parin pe e buznjenca si prugaste, pegave ili šarene. Kaj, dikhlem so ćerel tuće o Lavan. <verse eid="GEN 31:12" /><verse number="13" style="v" sid="GEN 31:13" />Me sem o Del savo sikadilo tuće ando Betel, okote kaj e uljesa makhlan o stupo katar o bar thaj halan manđe solah. Akana džatar andar akaja phuv thaj bolde tut ande ćiri phuv kaj bijandilan.’” <verse eid="GEN 31:13" /><verse number="14" style="v" sid="GEN 31:14" />E Rahilja thaj e Lija phendine lešće pe godova: “Amen naj majbut nasledstvo ando ćher amare dadesko. <verse eid="GEN 31:14" /><verse number="15" style="v" sid="GEN 31:15" />Vo postupil amenca sago kaj sam tuđina! Na samo kaj bićinda men, već sa e love save lijas pe amende haljardas! <verse eid="GEN 31:15" /><verse number="16" style="v" sid="GEN 31:16" />Sa o barvalipe savo o Del lijas katar amaro dad, vi gajda pripadil amenđe thaj amare čhavrenđe. Zato ćer sa so o Del phendas tuće.”<verse eid="GEN 31:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 31:17" />Askal o Jakov čhuta pire čhavren thaj pire romnjen pe kamile, <verse eid="GEN 31:17" /><verse number="18" style="v" sid="GEN 31:18" />thaj tradelas angla peste sa piri stoka thaj sasti piri imovina savi steknisardas ando Padan-Aram, pa teljarda te džal ando Hanaan ke piro dad o Isaak.<verse eid="GEN 31:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="GEN 31:19" />Kana o Lavan đelo te randel e bakhren, e Rahilja čordas lešće idolen andar lesko ćher. <verse eid="GEN 31:19" /><verse number="20" style="v" sid="GEN 31:20" />O Jakov čordane našlo katar o Lavan Aramejco thaj či phendas lešće kaj kamel te džaltar. <verse eid="GEN 31:20" /><verse number="21" style="v" sid="GEN 31:21" />Gajda našlo sa okolesa so sas les. Kana nakhla e reka Eufrat, teljardas ando gorsko krajo ando Gilad.<verse eid="GEN 31:21" /></para>
  <para style="s">O Lavan džal ande potera palo Jakove</para>
  <para style="p">
    <verse number="22" style="v" sid="GEN 31:22" />Trito đes phendine e Lavanešće kaj o Jakov našlo. <verse eid="GEN 31:22" /><verse number="23" style="v" sid="GEN 31:23" />O Lavan askal lijas pesa pire rođakonen thaj efta đes dija pe ande potera palo Jakove majsigo nego so aresla les ando gorsko krajo ando Gilad. <verse eid="GEN 31:23" /><verse number="24" style="v" sid="GEN 31:24" />Ali o Del avilo e Lavanešće Aramejcošće raćava ando suno thaj phendas lešće: “Le tut sama te na phenes e Jakovešće vareso laćhe ni vareso bilaćhe.”<verse eid="GEN 31:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="GEN 31:25" />Kana o Lavan aresla e Jakove, o Jakov već vazdas piro šator ando gorsko krajo ando Gilad, pa o Lavan thaj lešće manuša isto vazdine okote piro šator. <verse eid="GEN 31:25" /><verse number="26" style="v" sid="GEN 31:26" />Askal o Lavan phendas e Jakovešće: “So ćerdan godova? Hohadan man thaj inđardan mungre čhejen sago robonen andar o rato. <verse eid="GEN 31:26" /><verse number="27" style="v" sid="GEN 31:27" />Sostar našlan čordane, hohadan man thaj khanči či phendan manđe? Ispratisardemas tut ando veselje e điljenca, uz e muzika katar e daire thaj katar e harfa. <verse eid="GEN 31:27" /><verse number="28" style="v" sid="GEN 31:28" />Či dijan man ni te čumidav mungre unukonen thaj mungre čhejen. Dilivane postupisardan! <verse eid="GEN 31:28" /><verse number="29" style="v" sid="GEN 31:29" />Šaj naudisardemas tuće, ali o Del ćire dadesko araći pe rjat phendas manđe: ‘Le tut sama te na phenes e Jakovešće vareso lačhe ni vareso bilače.’ <verse eid="GEN 31:29" /><verse number="30" style="v" sid="GEN 31:30" />Džanav kaj đelantar zato kaj zurale manđejas te boldes tut ando ćher ćire dadesko. Ali sostar čordan mungre idolen?”<verse eid="GEN 31:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="GEN 31:31" />O Jakov phendas e Lavanešće: “Daravas kaj e silava leja mandar ćire čhejen. <verse eid="GEN 31:31" /><verse number="32" style="v" sid="GEN 31:32" />Ali kaste araćhes ćire idolen, godova neka avel mudardo. Rode akate angle amare rođakurja da li si vareso ćiro mande, pa ako si, le godova.” Kaj o Jakov či džanelas kaj e Rahilja čhordas e idolen.<verse eid="GEN 31:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="GEN 31:33" />Askal o Lavan dija ande Jakovesko šator, ande Lijako šator thaj ando šator e duje sluškinjego, ali e idolen či arakhlas. Kana inkljisto andar e Lijako šator, dijas ande Rahiljako šator. <verse eid="GEN 31:33" /><verse number="34" style="v" sid="GEN 31:34" />A kana e Rahilja čordas e idolen, garada len ande kamilako sico thaj baš bešelas pe leste. O Lavan rodas sasto šator, ali khanči či arakhlas.<verse eid="GEN 31:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="GEN 31:35" />E Rahilja phendas pire dadešće: “Na holjavo pe mande, gospodarina, zato kaj našti uštav angle tute, kaj sem ande đesa kana si pe mande.”</para>
  <para style="p" vid="GEN 31:35">Gajda o Lavan rodelas, ali našti arakhlas pire idolen. <verse eid="GEN 31:35" /><verse number="36" style="v" sid="GEN 31:36" />Askal o Jakov holjajlo, pa ačhilo te čhol muj po Lavan. “Savo godova bilačhipe ćerdem?” phučlas les. “Savo bezeh ćerdem te progonis man? <verse eid="GEN 31:36" /><verse number="37" style="v" sid="GEN 31:37" />Akana kana rodan ande sa mungre stvarja, arakhlan vareso, so pripadil ćire ćherešće? Čhov godova angle ćire thaj mungre rođakurja, pa neka von sudin maškar amende duje dženende. <verse eid="GEN 31:37" /><verse number="38" style="v" sid="GEN 31:38" />Pale akala biš brš kozom semas tute, ćire bakhre thaj ćire buznja bijanenas terne, a niti halem andar ćiro stado. <verse eid="GEN 31:38" /><verse number="39" style="v" sid="GEN 31:39" />Či anavas tuće životinja save mudardine e divlje zveri, nego mandar podmirivas tuće e šteta. Tu rodan mandar te poćinav tuće sa so sas čordo đeseja ili raćava. <verse eid="GEN 31:39" /><verse number="40" style="v" sid="GEN 31:40" />Ake, sar sas manđe: đeseja mudarelas man o tatipe, thaj raćava o šudripe, pa našti sovavas. <verse eid="GEN 31:40" /><verse number="41" style="v" sid="GEN 31:41" />Biš brš semas tute. Dešuštar brš ćeravas bući tute pale ćire duj čheja thaj šov palo mungro stado, ali mungri poćin menjisardan deš drom. <verse eid="GEN 31:41" /><verse number="42" style="v" sid="GEN 31:42" />Te manca či avilo sas o Del mungre dadesko, o Del e Avraamesko, okova kastar o Isaak daralas, tu muklanas man te džavtar tutar čuče vastenca. Ali o Del dikhla mungri muka thaj mungro trudo savo dijem, thaj araći pe arjat ukorisarda tut.”<verse eid="GEN 31:42" /></para>
  <para style="s">O Jakov thaj o Lavan ćeren savez</para>
  <para style="p">
    <verse number="43" style="v" sid="GEN 31:43" />Pe godova o Lavan phendas e Jakovešće: “Akala manušnja si mungre čheja, akala čhavra si mungre čhavra, thaj akala stadurja si mungre stadurja. Sa so dićhes, mungro si. A ipak, so me ađes šaj ćerdemas mungre čhejenđe ili e čhavrenđe save bijandine? <verse eid="GEN 31:43" /><verse number="44" style="v" sid="GEN 31:44" />Zato hajde te akana ćeras savez, tu thaj me, te godova savez avel svedoko maškar mande thaj tute.”<verse eid="GEN 31:44" /></para>
  <para style="p">
    <verse number="45" style="v" sid="GEN 31:45" />Askal o Jakov lijas jek bar thaj vazda les sago stubo, <verse eid="GEN 31:45" /><verse number="46" style="v" sid="GEN 31:46" />thaj phendas pire rođakonenđe: “Ćiden bara.” Thaj von line bara thaj ćerdine gomila, askal zajedno haline paše late. <verse eid="GEN 31:46" /><verse number="47" style="v" sid="GEN 31:47" />O Lavan e gomila e barenca akhardas Jegar Sahaduta, a o Jakov akharda lat Galed.<verse eid="GEN 31:47" /></para>
  <para style="p">
    <verse number="48" style="v" sid="GEN 31:48" />Askal o Lavan phendas e Jakovešće: “Neka akaja gomila ađes avel svedoko maškar mande thaj tute.”</para>
  <para style="p" vid="GEN 31:48">Zato dine lat alav Galed.<verse eid="GEN 31:48" /></para>
  <para style="p">
    <verse number="49" style="v" sid="GEN 31:49" />A akhardine lat vi Micpa, kaj o Lavan phendas: “Neka o GOSPOD lel sama pe mande thaj pe tute kana avasa dur jek avrestar. <verse eid="GEN 31:49" /><verse number="50" style="v" sid="GEN 31:50" />Ako bilačhe aves mungre čhejenca ili ako paše lende les vi aver romnjen, makar me pale godava vi te na džanav, neka avel tuće po gindo kaj o Del si svedoko maškar mande thaj tute!”<verse eid="GEN 31:50" /></para>
  <para style="p">
    <verse number="51" style="v" sid="GEN 31:51" />O Lavan još phendas e Jakovešće: “Ake akaja gomila thaj akava barengo stubo saves čhutem maškar mande thaj tute. <verse eid="GEN 31:51" /><verse number="52" style="v" sid="GEN 31:52" />Akaja gomila thaj akava stubo svedokurja si kaj me či nakhava prekal akaja gomila pe ćiri rig te naudiv tuće thaj tu či naćeja prekal akaja gomila thaj akava stubo pe mungri rig te naudis manđe. <verse eid="GEN 31:52" /><verse number="53" style="v" sid="GEN 31:53" />Neka o Del e Avraamesko thaj o Del e Nahoresko, o Del lenđe dadesko, presudil maškar amende.”</para>
  <para style="p" vid="GEN 31:53">Askal o Jakov hala solah e Devleja kastar o Isaak lesko dad daralas. <verse eid="GEN 31:53" /><verse number="54" style="v" sid="GEN 31:54" />Pa o Jakov okote ando gorsko krajo andas žrtva thaj akhardas pire familija te hal. Kana haline, raćardine okote. <verse eid="GEN 31:54" /><verse number="55" style="v" sid="GEN 31:55" />O Lavan thejara đes rano uštilo, čumidas pire unukonen thaj pire čhejen, thaj blagoslovisarda len. Askal teljarda thaj bolda pe ćhere.<verse eid="GEN 31:55" /></para>
  <chapter eid="GEN 31" />
  <chapter number="32" style="c" sid="GEN 32" />
  <para style="s">O Jakov spremol pe te maladol e Isaveja</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 32:1" />O Jakov đelotar pire dromesa, a dok sas po drom, avile angle leste e Devlešće anđelurja.<verse eid="GEN 32:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="GEN 32:2" />Kana o Jakov dikhla len, phendas: “Akava si e Devlesko tabor.” Zato godova than akhardas Mahanajim.<verse eid="GEN 32:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="GEN 32:3" />O Jakov angle peste bičhaldas e glasnikonen ke piro phral ko Isav savo sas ande seirsko krajo ando Edom, <verse eid="GEN 32:3" /><verse number="4" style="v" sid="GEN 32:4" />thaj zapovedisarda lenđe: “Gajda phenen mungre gospodarešće e Isavešće: ‘Ćiro sluga o Jakov phenel: Trajisardem ko Lavan thaj sa dži akana semas okote. <verse eid="GEN 32:4" /><verse number="5" style="v" sid="GEN 32:5" />Steknisardem guruva, magarcurja, bakhre, sluge thaj sluškinje. Bičhalav tuće e glasnikonen te obavestin tut, gospodarina, ande nada kaj stekniva ćiri naklonost.’”<verse eid="GEN 32:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 32:6" />Kana e glasnikurja boldine pe ko Jakov, phendine: “Samas ke ćiro phral o Isav. Vo akana avel angle tute thaj lesa aven štar šela muškarcurja.”<verse eid="GEN 32:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="GEN 32:7" />O Jakov zurale darajlo thaj uznemirisajlo, pa e manušen save sas lesa, e bakhre, e guruven thaj e kamilen podelisardas ande duj taborja. <verse eid="GEN 32:7" /><verse number="8" style="v" sid="GEN 32:8" />Gndisardas: “Ako avel o Isav ke jek tabor thaj napadnil les, akava dujto šaj našlosas.”<verse eid="GEN 32:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 32:9" />Askal o Jakov pomolisajlo: “Devla mungre pradadesko e Avraamesko, Devla mungre dadesko e Isaakosko, GOSPODE, savo phendan manđe: ‘Bolde tut ande ćiri phuv thaj ke ćiri familija, thaj me ćerava te avel tuće lačhe.’ <verse eid="GEN 32:9" /><verse number="10" style="v" sid="GEN 32:10" />Naj sem dostojno pale sa e ljubav thaj e vernost savi sikadan manđe, ćire slugašće. Samo rovlji sas man kana nakhlem prekal e reka e Jordanošći, a akana mandar nastanisardine duj taborja. <verse eid="GEN 32:10" /><verse number="11" style="v" sid="GEN 32:11" />Moliv tut, spasi man katar mungro phral o Isav, kaj darav kaj avela thaj sa mudarela men, čak vi e dejen thaj e čhavren. <verse eid="GEN 32:11" /><verse number="12" style="v" sid="GEN 32:12" />Ali tu phendan: ‘Ćerava te avel tuće lačhe thaj ćire potomkurja te aven but sago o pesko po more, savo našti đinavel pe.’ ”<verse eid="GEN 32:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="GEN 32:13" />O Jakov okote raćardas thaj katar okova so sas les spremisardas daro pale pesko phral o Isav: <verse eid="GEN 32:13" /><verse number="14" style="v" sid="GEN 32:14" />duj šela buznja thaj biš jarcurja, duj šela bakhrja thaj biš bakhre, <verse eid="GEN 32:14" /><verse number="15" style="v" sid="GEN 32:15" />trijanda kamile zajedno lenđe ternenca, štarvardeš gurumnja thaj deš bikurja, biš magarcurja thaj deš magarice.<verse eid="GEN 32:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="GEN 32:16" />Askal poverisarda len pire slugenđe, svako stado odvojime, pa phendas e slugenđe: “Džan angle mande thaj ćeren razmak maškar e stadurja.”<verse eid="GEN 32:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 32:17" />E slugašće savo džalas prvo zapovedisardas: “Kana mungro phrala o Isav malavel tut thaj phučel tut: ‘Kasko san thaj kaj džas? Kašće si akala životinje angle tute?’, <verse eid="GEN 32:17" /><verse number="18" style="v" sid="GEN 32:18" />tu phen: ‘Ćire slugasko e Jakovesko. Akava si daro savo bičhalel pire gospodarešće e Isavešće. A vo avel pale amende.’ ”<verse eid="GEN 32:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="GEN 32:19" />Askal gajda zapovedisardas vi e dujto thaj e trito slugašće thaj savorenđe save pratinas e stada: “Vi tumen isto godova phenen e Isavešće kana malavena les. <verse eid="GEN 32:19" /><verse number="20" style="v" sid="GEN 32:20" />Thaj len sama te phenen: ‘Ake ćiro sluga o Jakov avel pale amende.’ ”</para>
  <para style="p" vid="GEN 32:20">Kaj o Jakov gndisarda: “Kovljarava les akale darosa savo bičhalav angle mande, pa kana posle malavasa men, šaj kaj šukar primila man.”<verse eid="GEN 32:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="GEN 32:21" />Gajda e Jakovesko daro đelo angle leste, ali vo godoja rjat ačhilo ando tabor.<verse eid="GEN 32:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="GEN 32:22" />Godoja isto rjat o Jakov uštilo thaj lijas pire liduj romnjen, liduj pire sluškinjen thaj pire dešujek čhavren te naćhen prekal o potoko Jabok. <verse eid="GEN 32:22" /><verse number="23" style="v" sid="GEN 32:23" />A nakon so bičhalda len prekal o potok, bičhaldas pe okoja rig vi sasto piro barvalipe.<verse eid="GEN 32:23" /></para>
  <para style="s">O Jakov hrvil pe e Devleja</para>
  <para style="p">
    <verse number="24" style="v" sid="GEN 32:24" />Gajda o Jakov ačhilo korkoro, ali askal pojavisajlo varesavo manuš thaj hrvisajlo lesa sa dži ke detharin. <verse eid="GEN 32:24" /><verse number="25" style="v" sid="GEN 32:25" />Kana o manuš dikhla kaj našti te pobedil e Jakove, dija les dab ando zglobo e kukosko, gajda uganisarda e Jakovesko kuko.<verse eid="GEN 32:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="GEN 32:26" />Askal o manuš phendas e Jakovešće: “Muk man, kaj svanol o đes.”</para>
  <para style="p" vid="GEN 32:26">O Jakov phendas: “Či mukava tut dok či blagoslovis man.”<verse eid="GEN 32:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="GEN 32:27" />O manuš phučla les: “Sar bučhos?”</para>
  <para style="p" vid="GEN 32:27">Vo phendas: “Jakov.”<verse eid="GEN 32:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="GEN 32:28" />Askal o manuš phendas: “Majbut či akhardoja Jakov, nego Israel, kaj borisajlan e Devlesa thaj vi e manušenca thaj pobedisardan.”<verse eid="GEN 32:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="GEN 32:29" />Askal o Jakov phendas: “Moliv tut, phen manđe ćiro alav!”</para>
  <para style="p" vid="GEN 32:29">Ali vo phendas: “Sostar phučes man pale mungro alav?”</para>
  <para style="p" vid="GEN 32:29">Thaj okote blagoslovisarda e Jakove.<verse eid="GEN 32:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="GEN 32:30" />O Jakov godova than akhardas Peniel, kaj phendas: “Dikhlem e Devles jakhenca ande jakha, a ačhilem džudo.” <verse eid="GEN 32:30" /><verse number="31" style="v" sid="GEN 32:31" />Kana o Jakov nakhlo prekal o Penuel, inkljisto o kham. A vo phirelas banđe zbog piro kuko. <verse eid="GEN 32:31" /><verse number="32" style="v" sid="GEN 32:32" />Zato e Izraelcurja sa dži ađes či han e tetiva savi povezil o zglobo e kukosko, kaj e Jakovesko kuko sas uganime.<verse eid="GEN 32:32" /></para>
  <chapter eid="GEN 32" />
  <chapter number="33" style="c" sid="GEN 33" />
  <para style="s">O Jakov thaj o Isav maladon</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 33:1" />O Jakov vazdas pire jakha thaj dikhla e Isave sar avel štar šela muškarconenca. Thaj razdelisardas e čhavren ke Lija, ke Rahilja thaj ke duje sluškinje. <verse eid="GEN 33:1" /><verse number="2" style="v" sid="GEN 33:2" />E sluškinjen thaj lenđe čhavren čhuta anglal, e Lija thaj laće čhavren čhuta pala lende, a e Rahilja thaj e Josife čhuta skroz palal. <verse eid="GEN 33:2" /><verse number="3" style="v" sid="GEN 33:3" />O Jakov korkoro teljardas anglal leste thaj efta drom poklonisajlo dži ke phuv, dok či avilo majpaše dži ke piro phral.<verse eid="GEN 33:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="GEN 33:4" />O Isav prastajas angle leste, dija les mrtiko thaj ungladilo lešće pale kor, čumida les thaj liduj džene line te roven.<verse eid="GEN 33:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="GEN 33:5" />Askal o Isav vazda e jakha thaj dikhla e romnjen thaj e čhavren thaj phučlas: “Ko si akala tusa?”</para>
  <para style="p" vid="GEN 33:5">O Jakov phendas lešće: “Čhavra saven o Del milostivo dijas manđe, ćire slugašće.”<verse eid="GEN 33:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 33:6" />Askal e sluškinje thaj lenđe čhavra avile anglal thaj poklonisajle lešće. <verse eid="GEN 33:6" /><verse number="7" style="v" sid="GEN 33:7" />Pale lende avili e Lija laće čhavrenca thaj poklonisajle lešće, a po krajo avili vi e Rahilja thaj o Josif thaj poklonisajle lešće. <verse eid="GEN 33:7" /><verse number="8" style="v" sid="GEN 33:8" />O Isav phučlas: “So kanis okole stadonenca saven maladem?”</para>
  <para style="p" vid="GEN 33:8">O Jakov phendas: “Te arakhav milost ande ćire jakha, gospodarina.”<verse eid="GEN 33:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 33:9" />Ali o Isav phendas: “Man si but, phrala. Inćar tu ćiro pale tute.”<verse eid="GEN 33:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 33:10" />“Na, moliv tut,” phendas o Jakov, “ako arakhlem milost ande ćire jakha, le akava daro mandar. Kaj, kana dikhlem ćiro muj, godova si sago kaj dikhlem o muj e Devlesko, gajda milostivo primisardan man. <verse eid="GEN 33:10" /><verse number="11" style="v" sid="GEN 33:11" />Le o daro savo andem tuće, kaj o Del sas milostivo prema mande thaj si man sa.” Sar o Jakov gaći nagovorilas les, o Isav lijas o daro.<verse eid="GEN 33:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="GEN 33:12" />Askal o Isav phendas: “Hajde akana te teljaras po drom. Vi me džav tusa.”<verse eid="GEN 33:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="GEN 33:13" />Ali o Jakov phendas lešće: “Tu džanes, gospodarina, kaj e čhavra si slabe, a trubul te las sama vi pe bakhre thaj vi pe gurumnja saven si cikne pe čuči. Ako e životinjen samo jek đes tradav te phiren majbrzo, sa merena. <verse eid="GEN 33:13" /><verse number="14" style="v" sid="GEN 33:14" />Zato tu, gospodarina, dža angle mande, angle ćiro sluga, a me džava poloće, palo korako e stokako thaj e čhavrengo, dok či aresav tute, gospodarina, ando Seir.”<verse eid="GEN 33:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="GEN 33:15" />O Isav phendas: “De man te mukav tusa varekazom katar mungre manuša.”</para>
  <para style="p" vid="GEN 33:15">O Jakov phendas lešće: “Či trubul, gospodarina, me samo kamav te arakhav milost angle ćire jakha.”<verse eid="GEN 33:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="GEN 33:16" />Gajda o Isav godova isto đes teljardas palpale ando Seir. <verse eid="GEN 33:16" /><verse number="17" style="v" sid="GEN 33:17" />Ali o Jakov đelo ando Sukot thaj okote ćerda pešće ćher thaj štala pale stoka. Zato godova than vi akhardol Sukot.<verse eid="GEN 33:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 33:18" />Kana avilo andar o Padan-Aram, o Jakov areslo džudo thaj sasto dži ko gav Sihem ando Hanaan thaj vazdas pire šatorja pašo gav. <verse eid="GEN 33:18" /><verse number="19" style="v" sid="GEN 33:19" />E phuv pe savi vazdas piro šator ćindas pale šel rupune lovora katar e čhave e Hamorešće. O Hamor sas dad e Sihemesko. <verse eid="GEN 33:19" /><verse number="20" style="v" sid="GEN 33:20" />Okote o Jakov vazdas o žrtveniko thaj akharda les: o Del si o Del e Izraelosko.<verse eid="GEN 33:20" /></para>
  <chapter eid="GEN 33" />
  <chapter number="34" style="c" sid="GEN 34" />
  <para style="s">E Dina thaj o Sihem</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 34:1" />E Dina, čhej savja e Lija bijandas e Jakovešće, inkljisti te džal ke varesave manušnja andar godova krajo. <verse eid="GEN 34:1" /><verse number="2" style="v" sid="GEN 34:2" />Kana dikhla lat o Sihem, savo sas čhavo e Hamorosko e Hivijcosko savo sas vladari godole krajosko, siluisarda lat thaj gajda dija lat po ladžavo. <verse eid="GEN 34:2" /><verse number="3" style="v" sid="GEN 34:3" />No, o Sihem zavolisardas e Dina, e Jakovešće čheja, thaj zaljubisajlo ande late, pa trudisajlo te zadobil laći ljubav.<verse eid="GEN 34:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="GEN 34:4" />O Sihem phendas pire dadešće e Hamorešće: “Mang manđe akala čheja pale romnji.”<verse eid="GEN 34:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="GEN 34:5" />Kana o Jakov ašundas kaj o Sihem obesčastisardas lešće čheja e Dina, či ćerda khanči, dok lešće čhave či bolden pe kaj sas ando polje e stokasa.<verse eid="GEN 34:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 34:6" />Askal e Sihemesko dad o Hamor avilo te ćerel svato e Jakovesa. <verse eid="GEN 34:6" /><verse number="7" style="v" sid="GEN 34:7" />Ande godova boldine pe e Jakovešće čhave andar o polje. Kana ašundine so sas, zurale ogorčisajle thaj holjajle, kaj o Sihem ladžarda e Izraele gajda kaj pašljilo e Jakovešće čhejasa. Gajda vareso či tromal te ćerel pe.<verse eid="GEN 34:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 34:8" />O Hamor phendas lenđe: “Mungro čhavo o Sihem saste ileja zaljubisajlo ande tumari čhej. Moliv tumen te den lat lešće pale romnji. <verse eid="GEN 34:8" /><verse number="9" style="v" sid="GEN 34:9" />Hajde te postanis familija, den amen tumare čhejen pale romnja, a tumen len amare čhejen. <verse eid="GEN 34:9" /><verse number="10" style="v" sid="GEN 34:10" />Trajin maškar amende – e phuv si tumenđe putardi: šaj trajin ande late, trguin thaj šaj steknin barvalipe ande late.”<verse eid="GEN 34:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="GEN 34:11" />Askal o Sihem phendas e Dinaće dadešće thaj laće phralenđe: “Moliv tumen, sikaven manđe milost! Dava tumen sa so god kamen. <verse eid="GEN 34:11" /><verse number="12" style="v" sid="GEN 34:12" />Odredin savi god cena kamen pale bori thaj savo god daro kamen, thaj me dava tumen kozom god te roden – samo den man e čheja pale romnji.”<verse eid="GEN 34:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="GEN 34:13" />Pošto lenđi phen e Dina sas obesčastime, e Jakovešće čhave e hohaimasa phendine e Sihemešće thaj lešće dadešće e Hamorešće: <verse eid="GEN 34:13" /><verse number="14" style="v" sid="GEN 34:14" />“Našti te ćeras godova, te das amare pheja e manušešće savo naj obrezime, kaj pale amende godova avilosas ladžavo. <verse eid="GEN 34:14" /><verse number="15" style="v" sid="GEN 34:15" />Pristanisarasa pe godova, jedino samo ako postanin sago amen gajda kaj obrezina sa e mušken maškar tumende. <verse eid="GEN 34:15" /><verse number="16" style="v" sid="GEN 34:16" />Askal šaj das tumen amare čhejen thaj te las tumare čhejen amenđe, te trajis maškar tumende thaj postanis jek them. <verse eid="GEN 34:16" /><verse number="17" style="v" sid="GEN 34:17" />Ali ako či čhon kan amende thaj či obrezin tumen, askal lasa amare pheja thaj džasatar.”<verse eid="GEN 34:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 34:18" />Lengo predlog sviđosajlo e Hamorešće thaj lešće čhavešće e Sihemešće. <verse eid="GEN 34:18" /><verse number="19" style="v" sid="GEN 34:19" />O terno Sihem savo sas majugledno katar sa ando ćher lešće dadesko, ni cara či oklevisardas te ćerel okova so rodine, kaj but volilas e Jakovešće čheja. <verse eid="GEN 34:19" /><verse number="20" style="v" sid="GEN 34:20" />Askal o Hamor thaj o Sihem đele angle kapija pire gavešći te ćeren svato e muškarcenca andar lengo gav:<verse eid="GEN 34:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="GEN 34:21" />“Akala manuša naj amare dušmaja, von kamen miro amenca. Zato trubul te mukas len te trajin thaj trguin ande amari phuv, kaj si dosta than ande akaja phuv. Amen šaj te ženi men lenđe čhejenca, a von šaj ženin pe amare čhejenca. <verse eid="GEN 34:21" /><verse number="22" style="v" sid="GEN 34:22" />Ali akala manuša pristaina te trajina amenca sago jek them, samo ako svako muškarco maškar amende obrežil pe sago kaj von si obrezime. <verse eid="GEN 34:22" /><verse number="23" style="v" sid="GEN 34:23" />Či li gajda lenđi stoka, lengo barvalipe thaj sa lenđe aver životinje postanina amare? Zato hajde te složi men lenca thaj von trajina maškar amende.”<verse eid="GEN 34:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="GEN 34:24" />Savora save aviline ke gavešći kapija složisajle e Hamoresa thaj lešće čhavesa e Sihemesa, pa svako muško ando gav obrezisajlo.<verse eid="GEN 34:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="GEN 34:25" />O trito đes, dok sas von još ande dukha, o Simeon thaj o Levije, e Jakovešće duj čhave thaj e Dinaće phrala, line pire mačurja thaj čordane dine ando gav thaj mudardine sa e muškonen. <verse eid="GEN 34:25" /><verse number="26" style="v" sid="GEN 34:26" />E mačesa mudardine e Hamore thaj lešće čhaves e Siheme, line e Dina andar e Sihemesko ćher thaj đeletar. <verse eid="GEN 34:26" /><verse number="27" style="v" sid="GEN 34:27" />Aver e Jakovešće čhave aviline po than kaj sas akala mudarde thaj čordine sa andar o gav, zato kaj sas lenđi phen obesčastime. <verse eid="GEN 34:27" /><verse number="28" style="v" sid="GEN 34:28" />Line lenđi hurdi thaj bari stoka, e magarconen thaj sa so sas len ando gav thaj ando polje. <verse eid="GEN 34:28" /><verse number="29" style="v" sid="GEN 34:29" />Inđardine sa lengo barvalipe, lenđe romnjen thaj lenđe čhavren thaj čordine sa so sas ande ćhera.<verse eid="GEN 34:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="GEN 34:30" />Askal o Jakov phendas e Simeonešće thaj e Leviješće: “Čhutine man ande nevolje, kaj omrzisardine man e manušenca andar akaja phuv, e Hanaancenca thaj e Perižanenca. Amen sam cara, pa ako udružin pe protiv amende thaj napadnin man, uniština man thaj vi savoren andar mungro ćher.”<verse eid="GEN 34:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="GEN 34:31" />Ali von phendine: “Zar trubujamas te mukas te prema amari phen postupin sago e bludnicava?”<verse eid="GEN 34:31" /></para>
  <chapter eid="GEN 34" />
  <chapter number="35" style="c" sid="GEN 35" />
  <para style="s">O Jakov palem ando Betel</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 35:1" />O Del phendas e Jakovešće: “Ušti, dža opre ando Betel thaj okote trajisar. Okote vazde žrtveniko e Devlešće savo sikadilo tuće, kana našejas ćire phralestar e Isavestar.”<verse eid="GEN 35:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="GEN 35:2" />O Jakov phendas pire familijaće thaj savorenđe save sas lesa: “Čhuden e tuđe devlen save si tumen, šlaven tumen thaj len aver drze pe tumende. <verse eid="GEN 35:2" /><verse number="3" style="v" sid="GEN 35:3" />Askal ušten thaj ajde džastar ando Betel. Okote vazdava žrtveniko e Devlešće savo pomognisardas manđe kana semas ande nevolja thaj savo sas manca po drom kaj god te džavas.”<verse eid="GEN 35:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="GEN 35:4" />Gajda von dine e Jakoveste sa e tuđe devlen save sas len thaj e čeja save inđarenas ande kan, a o Jakov sa godova hanadas tale jek hrasto paše ko gav Sihem. <verse eid="GEN 35:4" /><verse number="5" style="v" sid="GEN 35:5" />Pale godova teljardine po drom, a o Del ćerda te e manušen andar e okolne gava astarel gaći bari dar katar e Jakovešće čhave, pa khonik či đelo ande potera pale lende.<verse eid="GEN 35:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 35:6" />O Jakov thaj sa e manuša save sas lesa, aresline ando Luz, godova si ando Betel, ando Hanaan. <verse eid="GEN 35:6" /><verse number="7" style="v" sid="GEN 35:7" />Okote o Jakov ćerda žrtveniko thaj godova than akhardas El Betel, kaj inća sikadilo lešće o Del, kana našelas pire phralestar.<verse eid="GEN 35:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 35:8" />Askal muli e Devora, e sluškinja savi barjarda e Reveka, thaj sas prahome avrjal andar o Betel talo hrasto saves o Jakov akharda “Rojimasko hrasto.”<verse eid="GEN 35:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 35:9" />Nakon so o Jakov bolda pe andar o Padan-Aram, o Del palem sikada pe lešće thaj blagoslovisarda les.<verse eid="GEN 35:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 35:10" />O Del phendas lešće: “Ćiro alav si Jakov, ali katar akana majbut či akhardoja Jakov, nego Izrael.”</para>
  <para style="p" vid="GEN 35:10">Gajda o Del dija les alav Izrael.<verse eid="GEN 35:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="GEN 35:11" />O Del još phendas lešće: “Me sem o Del Svemogućo. Av plodno thaj množi tut. Tutar bijandola o them thaj mnoštvo thema, thaj varesave postanina carurja maškar ćire potomkurja. <verse eid="GEN 35:11" /><verse number="12" style="v" sid="GEN 35:12" />E phuv savi dijem e Avraamešće thaj e Isavešće, tuće dav, a dava lat vi ćire potomstvošće.”<verse eid="GEN 35:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="GEN 35:13" />Askal o Del đelotar lestar katar o than kaj ćerenas svato.<verse eid="GEN 35:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="GEN 35:14" />O Jakov vazdas jek bar sago stupo po godova than kaj o Del ćerda lesa svato, thaj pe leste čhordas mol thaj ulje sago žrtva e Devlešće. <verse eid="GEN 35:14" /><verse number="15" style="v" sid="GEN 35:15" />O than kaj o Del ćerda lesa svato, o Jakov akhardas Betel.<verse eid="GEN 35:15" /></para>
  <para style="s">E Rahilja merel</para>
  <para style="p">
    <verse number="16" style="v" sid="GEN 35:16" />Askal o Jakov thaj lešće manuša teljardine andar o Betel. Kana sas još cara dži ko gav Efrata, e Rahilja astardas te bijanel, bijanelas phare.<verse eid="GEN 35:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 35:17" />Sar o porod sas pharo, e babica phendas laće: “Na dara, Rahilja, kaj vi akava avela čhavo.” <verse eid="GEN 35:17" /><verse number="18" style="v" sid="GEN 35:18" />Dok o trajo mućelas lat, kaj merelas, dijas pire čhavešće alav Ben-Oni, ali lesko dad dija les alav Venijamin.<verse eid="GEN 35:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="GEN 35:19" />Kana e Rahilja muli, prahosardine lat po drom ko Efrata, godova si Vitlejem. <verse eid="GEN 35:19" /><verse number="20" style="v" sid="GEN 35:20" />O Jakov pe Rahiljako limori čhuta baresko stupo thaj godova stupo dži ađesko đes ačhel sago spomeniko pe lako limori. <verse eid="GEN 35:20" /><verse number="21" style="v" sid="GEN 35:21" />O Izrael teljardas majdur thaj vazdas piro šator katar aver rig e kula Eder.<verse eid="GEN 35:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="GEN 35:22" />Dok o Izrael trajilas ande godova krajo, o Ruvim đelo thaj pašljilo e Bilhasa, savi sas lešće dadešći romnji ropkinja, a o Izrael saznajisardas pale godova.</para>
  <para style="s" vid="GEN 35:22">E Jakovešće čhave</para>
  <para style="p" vid="GEN 35:22">E Jakove sas dešuduj čhave.<verse eid="GEN 35:22" /></para>
  <para style="b" />
  <para style="li">
    <verse number="23" style="v" sid="GEN 35:23" />E Lijaće čhave si: o Ruvim, e Jakovesko prvobijando, o Simeon, o Levije, o Juda, o Isahar thaj o Zavulon.<verse eid="GEN 35:23" /></para>
  <para style="li">
    <verse number="24" style="v" sid="GEN 35:24" />E Rahiljaće čhave si: o Josif thaj o Venijamin.<verse eid="GEN 35:24" /></para>
  <para style="li">
    <verse number="25" style="v" sid="GEN 35:25" />E čhave katar e Rahiljaći sluškinja Bilha si: o Dan thaj o Neftalim.<verse eid="GEN 35:25" /></para>
  <para style="li">
    <verse number="26" style="v" sid="GEN 35:26" />E čhave katar e Lijaći sluškinja Zilpa si: o Gad thaj o Asir.</para>
  <para style="b" vid="GEN 35:26" />
  <para style="m" vid="GEN 35:26">Godola si e Jakovešće čhave save bijandile lešće ando Padan-Aram.<verse eid="GEN 35:26" /></para>
  <para style="s">E Isaakosko smrto</para>
  <para style="p">
    <verse number="27" style="v" sid="GEN 35:27" />O Jakov bolda pe ke piro dad o Isaak ande Mamre ko Kirjat-Arba, godova si ko Hevron, kaj trajisardine o Avraam thaj o Isaak. <verse eid="GEN 35:27" /><verse number="28" style="v" sid="GEN 35:28" />O Isaak trajisarda šel thaj ohtovardeš brš. <verse eid="GEN 35:28" /><verse number="29" style="v" sid="GEN 35:29" />Mulo ande baro phuripe, trajisarda but brš thaj lešće čhave o Isav thaj o Jakov prahosardine les.<verse eid="GEN 35:29" /></para>
  <chapter eid="GEN 35" />
  <chapter number="36" style="c" sid="GEN 36" />
  <para style="s">E Isavosko potomstvo</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 36:1" />Akava si e Isavosko potomstvo, savesko alav si vi Edom.<verse eid="GEN 36:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="GEN 36:2" />O Isav lijas pešće pale romnja duj katar e hanaanske čheja: e Ada, e Hetitošće Elonešće čheja, thaj e Oholivamašće e Anašće čheja, e Civonošće e Hivijcošće unuka, <verse eid="GEN 36:2" /><verse number="3" style="v" sid="GEN 36:3" />thaj e Bosmata, e Jišmaelošće čheja, e Nevajotošće pheja.<verse eid="GEN 36:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="GEN 36:4" />E Ada bijandas e Isavošće e Elifaze a e Bosmata bijandas e Reuele. <verse eid="GEN 36:4" /><verse number="5" style="v" sid="GEN 36:5" />E Oholivama bijandas e Jeuše, e Jaalame thaj e Koreje.</para>
  <para style="p" vid="GEN 36:5">Godola si e Isavošće čhave save bijandile lešće ando Hanaan.<verse eid="GEN 36:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 36:6" />Askal o Isav lijas pire romnjen, pire čhaven, čhejen thaj sa e manušen andar piro ćher, piri stoka thaj vi aver životinje thaj e imovina savi steknisardas ando Hanaan, pa đelotar ande aver phuv dur katar piro phral o Jakov. <verse eid="GEN 36:6" /><verse number="7" style="v" sid="GEN 36:7" />Đelotar kaj lengo barvalipe sas gajda baro kaj našti te trajisardinesas zajedno, e phuv ande savi trajinas našti inćardasas len lidujen kaj sas len but stoka. <verse eid="GEN 36:7" /><verse number="8" style="v" sid="GEN 36:8" />Gajda o Isav, saves akharenas vi Edom, naselisajlo ando gorsko krajo Seir.<verse eid="GEN 36:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 36:9" />Akava si o potomstvo e Isavosko, savo si pradad e Edomcengo ando gorsko krajo Seir.<verse eid="GEN 36:9" /></para>
  <para style="b" />
  <para style="li">
    <verse number="10" style="v" sid="GEN 36:10" />Akala si e alava e Isavešće čhavenđe: Elifaz, čhavo e Isavošće romnjako e Adako, thaj o Reuel, čhavo e Isavošće romnjako e Bosmatako.<verse eid="GEN 36:10" /></para>
  <para style="li">
    <verse number="11" style="v" sid="GEN 36:11" />E Elifazešće čhave sas: o Teman, Omar, Cefo, Gaatam thaj o Kenaz.<verse eid="GEN 36:11" /></para>
  <para style="li">
    <verse number="12" style="v" sid="GEN 36:12" />E Elifaze sas romnji ropkinja, savi akhardolas Timna, a voj bijandas lešće e Amaleke.</para>
  <para style="li" vid="GEN 36:12">Godola sas potomkurja e Isavešće romnjaće e Adaće.<verse eid="GEN 36:12" /></para>
  <para style="li">
    <verse number="13" style="v" sid="GEN 36:13" />E Reuelešće čhave si: o Nahat, Zara, Šama, thaj o Miza.</para>
  <para style="li" vid="GEN 36:13">Godola sas potomkurja e Isavošće romnjaće e Bosmataće.<verse eid="GEN 36:13" /></para>
  <para style="li">
    <verse number="14" style="v" sid="GEN 36:14" />Akala sas čhave e Isavošće romnjaće e Oholivamaće, savi sas čhej e Anaći a e Civonešći unuka. Voj bijanda e Isavešće: e Jeuše, Jaalame thaj e Koreje.<verse eid="GEN 36:14" /></para>
  <para style="b" />
  <para style="p">
    <verse number="15" style="v" sid="GEN 36:15" />Akala plemenske starešine poteknisardine katar o Isav:</para>
  <para style="li" vid="GEN 36:15">Čhave e Elifazešće, e Isavošće prvobijande čhavešće: o Teman, Omar, Cefo, o Kenaz, <verse eid="GEN 36:15" /><verse number="16" style="v" sid="GEN 36:16" />o Korej, Gaatam thaj o Amalek.</para>
  <para style="li" vid="GEN 36:16">Akala plemenske starešine si katar o Elifaz ando Edom. Godola si e Adaće potomkurja.<verse eid="GEN 36:16" /></para>
  <para style="li">
    <verse number="17" style="v" sid="GEN 36:17" />Čhave e Reuelešće, e Isavešće čhavešće: o Nahat, Zara, Šama thaj o Miza.</para>
  <para style="li" vid="GEN 36:17">Akala plemenske starešine poteknisardine katar o Reuel ando Edom. Godola si potomkurja e Isavošće romnjaće e Bosmataće.<verse eid="GEN 36:17" /></para>
  <para style="li">
    <verse number="18" style="v" sid="GEN 36:18" />Akala sas čhave e Isavošće romnjaće e Oholivamaće: o Jeuš, Jaalam thaj o Korej.</para>
  <para style="li" vid="GEN 36:18">Akala si plemenske starešine katar e Isavošći romnji e Oholivama, e Anaći čhej.<verse eid="GEN 36:18" /></para>
  <para style="m">
    <verse number="19" style="v" sid="GEN 36:19" />Godola si čhave thaj plemenske starešine e Isavešće saves akharenas vi Edom.<verse eid="GEN 36:19" /></para>
  <para style="s">E Seirošće potomkurja</para>
  <para style="p">
    <verse number="20" style="v" sid="GEN 36:20" />Akala si čhave e Seirošće Horijcošće, save trajinas ando Edom:</para>
  <para style="li" vid="GEN 36:20">O Lotan, o Šoval, o Civon, o Ana, <verse eid="GEN 36:20" /><verse number="21" style="v" sid="GEN 36:21" />o Dišon, o Ecer thaj o Dišan. Godola si plemenske starešine e Horijconenđe, potomkurja e Seirošće ando Edom.<verse eid="GEN 36:21" /></para>
  <para style="li">
    <verse number="22" style="v" sid="GEN 36:22" />E Lotanešće čhave: o Hori thaj o Heman. E Lotanešći phen sas e Timna.<verse eid="GEN 36:22" /></para>
  <para style="li">
    <verse number="23" style="v" sid="GEN 36:23" />E Šovalošće čhave: o Alvan, o Manahat, o Eval, o Šefo thaj o Onam.<verse eid="GEN 36:23" /></para>
  <para style="li">
    <verse number="24" style="v" sid="GEN 36:24" />E Civonešće čhave: o Aja thaj o Ana. O Ana si okova savo ande pustinja arakhla e izvorurja e tate pajesa, dok lelas sama pe magarcurja pire dadešće e Civonešće.<verse eid="GEN 36:24" /></para>
  <para style="li">
    <verse number="25" style="v" sid="GEN 36:25" />E Anašće čhavra: o Dišon thaj e Oholivama.<verse eid="GEN 36:25" /></para>
  <para style="li">
    <verse number="26" style="v" sid="GEN 36:26" />E Dišonošće čhave: o Hemdan, o Ešban, o Jitran thaj o Keran.<verse eid="GEN 36:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="GEN 36:27" />E Ecerošće čhave: o Bilhan, o Zaavan thaj o Akan.<verse eid="GEN 36:27" /></para>
  <para style="li">
    <verse number="28" style="v" sid="GEN 36:28" />A e Dišanošće čhave: o Uc thaj o Aran.<verse eid="GEN 36:28" /></para>
  <para style="p">
    <verse number="29-30" style="v" sid="GEN 36:29-30" />Akala si e plemenske starešine e Horijconenđe ando krajo Seir: o Lotan, o Šoval, o Civon, o Ana, o Dišon, o Ecer thaj o Dišan.<verse eid="GEN 36:29-30" /></para>
  <para style="s">Carurja ando Edom</para>
  <para style="p">
    <verse number="31" style="v" sid="GEN 36:31" />Akala si e carurja save vladinas ando Edom majsigo nego so vladinas e carurja ando Izrael.<verse eid="GEN 36:31" /></para>
  <para style="b" />
  <para style="li">
    <verse number="32" style="v" sid="GEN 36:32" />O Bela, čhavo e Beorosko, postanisardas caro ando Edom. Lesko gav akhardolas Dinhava.<verse eid="GEN 36:32" /></para>
  <para style="li">
    <verse number="33" style="v" sid="GEN 36:33" />Kana mulo o Bela, carujilas o Jovav, o čhavo e Zarosko andar o Bocra.<verse eid="GEN 36:33" /></para>
  <para style="li">
    <verse number="34" style="v" sid="GEN 36:34" />Kana o Jovav mulo, carujilas o Hušam andar e phuv Teman.<verse eid="GEN 36:34" /></para>
  <para style="li">
    <verse number="35" style="v" sid="GEN 36:35" />Kana o Hušam mulo, carujilas o Hadad, o čhavo e Bedadesko, savo pobedisardas e Midjancen ande phuv Moav. Lesko gav akhardolas Avit.<verse eid="GEN 36:35" /></para>
  <para style="li">
    <verse number="36" style="v" sid="GEN 36:36" />Kana mulo o Hadad, carujilas o Samla andar e Masreka.<verse eid="GEN 36:36" /></para>
  <para style="li">
    <verse number="37" style="v" sid="GEN 36:37" />Kana mulo o Samla, carujilas o Saul andar o Rehovot paše reka Eufrat.<verse eid="GEN 36:37" /></para>
  <para style="li">
    <verse number="38" style="v" sid="GEN 36:38" />Kana mulo o Saul, carujilas o Vaal-Hanan, o čhavo e Ahboresko.<verse eid="GEN 36:38" /></para>
  <para style="li">
    <verse number="39" style="v" sid="GEN 36:39" />Kana mulo o Vaal-Hanan, čhavo e Ahboresko, carujilas o Hadad. Lesko gav akhardolas Pau. Lešći romnji akhardolas Mehetavel, čhej e Matredešći thaj e unuka e Me-Zahavešći.<verse eid="GEN 36:39" /></para>
  <para style="b" />
  <para style="m">
    <verse number="40" style="v" sid="GEN 36:40" />Akala si e alava e plemenske starešinenđe save poteknisardine katar o Isav, prema lenđe familije thaj thana:</para>
  <para style="li" vid="GEN 36:40">o Timna, o Alva, o Jetet, <verse eid="GEN 36:40" /><verse number="41" style="v" sid="GEN 36:41" />o Oholivama, o Ela, o Pinon, <verse eid="GEN 36:41" /><verse number="42" style="v" sid="GEN 36:42" />o Kenaz, o Teman, o Mivcar, <verse eid="GEN 36:42" /><verse number="43" style="v" sid="GEN 36:43" />o Magdiel thaj o Iram.</para>
  <para style="p" vid="GEN 36:43">Godola si plemenske starešine e Edomešće, save aviline katar o Isav, savo sas pradad e Edomcengo, prema lenđe thana ande phuv savi zauzmisardine.<verse eid="GEN 36:43" /></para>
  <chapter eid="GEN 36" />
  <chapter number="37" style="c" sid="GEN 37" />
  <para style="s">O Josif thaj lešće phral</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 37:1" />O Jakov trajilas ando Hanaan kaj trajilas lesko dad sago stranco. <verse eid="GEN 37:1" /><verse number="2" style="v" sid="GEN 37:2" />Akava si zapis pale Jakovešći familija.</para>
  <para style="p" vid="GEN 37:2">Kana o Josif sas terno čhavo katar dešuefta brš, čarjarelas e stadurja e phralenca save sas čhave e Bilhaće thaj e Zilpaće, romnjenđe katar lesko dad. O Josif motholas pire dadešće pale bilačhe buća save lešće phral ćerenas.<verse eid="GEN 37:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="GEN 37:3" />O Izrael katar sa pire čhave majbut volilas e Josife, kaj bijandilo lešće ande lešće purane brš. Zato ćerda lešće barvalo ukrasime ogrtači. <verse eid="GEN 37:3" /><verse number="4" style="v" sid="GEN 37:4" />Kana e Josifešće phral dikhline kaj lengo dad volilas les majbut katar sa lendar, gadići mrzan les kaj majbut nijek šukar alav našti mothonas lešće.<verse eid="GEN 37:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="GEN 37:5" />Jekhvar o Josif dikhla suno thaj mothoda o suno pire phralenđe, a von zbog godova još majbut mrzanas les.<verse eid="GEN 37:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 37:6" />O Josif phendas lenđe: “Ašunen sosko suno dikhlem: <verse eid="GEN 37:6" /><verse number="7" style="v" sid="GEN 37:7" />Phandavasas o điv ande snopurja ando polje, kana mungro snopo katar jekhar vazda pe thaj vortosajlo, a tumare snopurja ćidine pe oko leste thaj poklonisajle lešće.”<verse eid="GEN 37:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 37:8" />Lešće phral pe godova phendine lešće: “So tu gndis te vladis pe amende? So kames te aves amaro gospodari?”</para>
  <para style="p" vid="GEN 37:8">Zbog lesko suno savo sas les thaj zbog godova so phendas lenđe, još majbut mrzanas les.<verse eid="GEN 37:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 37:9" />O Josif dikhla vi aver suno thaj phendas pire phralenđe: “Ašunen mande. Palem sas man suno. O kham, o čhonut thaj e dešujek čereja poklonisajle angle mande.”<verse eid="GEN 37:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 37:10" />Kana godova phendas pire dadešće thaj pire phralenđe, lesko dad čhuta muj pe leste thaj phendas: “Čefal suno si gadava savo dikhlan! Zar ćiri dej, me thaj ćire phral avas te pokloni men angle tute dži ke phuv?” <verse eid="GEN 37:10" /><verse number="11" style="v" sid="GEN 37:11" />Thaj dok lešće phral sas zavidne lešće, lesko dad inćarelas o gindo pe godova suno.<verse eid="GEN 37:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="GEN 37:12" />Kana jekhar lešće phral đele te čarjaren pire dadešće stadurja pašo Sihem, <verse eid="GEN 37:12" /><verse number="13" style="v" sid="GEN 37:13" />o Izrael phendas e Josifešće: “Džanes kaj ćire phral čarjaren e stadurja pašo Sihem. Ajde, bičhalava tut lende.”</para>
  <para style="p" vid="GEN 37:13">O Josif phendas: “Lačhe.”<verse eid="GEN 37:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="GEN 37:14" />O Izrael phendas lešće: “Dža thaj dik, dali si sa laćhe ćire phralenca thaj e stadonenca. Askal bolde tut te phenes manđe.” Gajda bičhalda les andar e Hevronsko dolina.</para>
  <para style="p" vid="GEN 37:14">Kana o Josif areslo ando Sihem, <verse eid="GEN 37:14" /><verse number="15" style="v" sid="GEN 37:15" />dikhla les jek manuš sar lutil ando polje thaj phučla les: “So rodes?” <verse eid="GEN 37:15" /><verse number="16" style="v" sid="GEN 37:16" />O Josif phendas: “Rodav mungre phralen. Phen manđe, moliv tut, kaj čarjaren o stado?”<verse eid="GEN 37:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 37:17" />O manuš phendas: “Đeletar akatar. Ašundem len sar phendine: ‘Hajde te džas ando Dotan.’ ”</para>
  <para style="p" vid="GEN 37:17">O Josif đelo pale pire phral thaj arakhla len ando Dotan. <verse eid="GEN 37:17" /><verse number="18" style="v" sid="GEN 37:18" />Von već dadural line les sama. No, majsigo nego so avilo paše lende, ćerdine pe svato te mudaren les. <verse eid="GEN 37:18" /><verse number="19" style="v" sid="GEN 37:19" />Phendine jek avrešće: “Ake, avel okova gospodari e sunengo. <verse eid="GEN 37:19" /><verse number="20" style="v" sid="GEN 37:20" />Hajde te mudaras les thaj te čhudas les ande jek katar akala bare hainga. Phenasa kaj hala les e divljo životinja. Askal dikhasa so avela lešće sunenca!” <verse eid="GEN 37:20" /><verse number="21" style="v" sid="GEN 37:21" />Kana ašundas godova o Ruvim, kamelas te spasil les andar lenđe vas.</para>
  <para style="p" vid="GEN 37:21">Phendas: “Na te mudaras les! <verse eid="GEN 37:21" /><verse number="22" style="v" sid="GEN 37:22" />Na čhoren o rat! Čhuden les ande akaja bari haing akate ande pustinja, ali na vazden o vas pe leste.” O Ruvim godova phendas te spasil e Josife andar lenđe vas thaj te boldel les lešće dadešće.<verse eid="GEN 37:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="GEN 37:23" />Kana o Josif areslo ke pire phral, von fuljardine lestar okova barvalo ukrasime ogrtači, <verse eid="GEN 37:23" /><verse number="24" style="v" sid="GEN 37:24" />pa astardine les thaj čhudine les ande haing. E haing sas čuči thaj nas andre paj.<verse eid="GEN 37:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="GEN 37:25" />Askal bešline te han. Ande godova vazdine e jakha tha dikhline e Jišmajelenđi karavana sar avelas andar o Gilad. Lenđe kamile sas natovarime e začinenca, e balsameja thaj e smirnava save inđarenas ando Egipat. <verse eid="GEN 37:25" /><verse number="26" style="v" sid="GEN 37:26" />Askal o Juda phendas pire phralenđe: “So avela men katar godova te mudaras amare phrale thaj garavas lesko smrto? <verse eid="GEN 37:26" /><verse number="27" style="v" sid="GEN 37:27" />Hajde te bićinas les akale Jišmajelenđe. Na te vazdas o vas pe leste kaj si amaro phral, amaro rat.” Thaj e phral čhutine kan leste. <verse eid="GEN 37:27" /><verse number="28" style="v" sid="GEN 37:28" />Kana e midjanske trgovcurja naćhenas paše lende, e phral inkaldine e Josife andar e haing thaj pale biš rupune love bićindine les e Jišmajelenđe save inđardine les ando Egipat.<verse eid="GEN 37:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="GEN 37:29" />Kana o Ruvim bolda pe ke haing thaj dikhla kaj o Josif naj ande late, pharadas pire drze pe peste, <verse eid="GEN 37:29" /><verse number="30" style="v" sid="GEN 37:30" />askal bolda pe ke pire phral thaj phendas: “Naj o čhavro! So ćerava akana?”<verse eid="GEN 37:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="GEN 37:31" />Askal e phral line e Josifesko ogrtači, dine čhurjasa jećhe jarco thaj o ogrtači makhline ande lesko rat, <verse eid="GEN 37:31" /><verse number="32" style="v" sid="GEN 37:32" />pa o ogrtači inđardine pire dadešće thaj phendine: “Arakhlam akava. Le dik dali si akava o ogrtači katar ćiro čhavo.”<verse eid="GEN 37:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="GEN 37:33" />O Jakov pindžarda o ogrtači thaj phendas: “Ej, gada si o ogrtači mungre čhavesko! Varesavi divljo životinja hala les! O Josif si rastrgnome pe kotora!”<verse eid="GEN 37:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="GEN 37:34" />Askal o Jakov pharadas pire drze thaj lijas pe peste o kostret thaj but đes rovelas pale pesko čhavo. <verse eid="GEN 37:34" /><verse number="35" style="v" sid="GEN 37:35" />Sa lešće čhave thaj lešće čheja avenas te utešin les, ali vo či kamla uteha, nego phendas: “Kućiva pale mungro čhavo dok me či merav.”</para>
  <para style="p" vid="GEN 37:35">Gajda lesko dad rovelas pale leste.<verse eid="GEN 37:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="GEN 37:36" />A okola Midjancurja bićindine e Josife ando Egipat, e Potifarešće, savo sas jek katar e Faraonešće bare službenikurja, thaj zapovedniko pe dvorsko straža.<verse eid="GEN 37:36" /></para>
  <chapter eid="GEN 37" />
  <chapter number="38" style="c" sid="GEN 38" />
  <para style="s">O Juda thaj e Tamara</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 38:1" />Ande godoja vrjama o Juda đelotar katar pire phral thaj naselisajlo ke jek manuš andar o Adulam savo akhardolas Hira. <verse eid="GEN 38:1" /><verse number="2" style="v" sid="GEN 38:2" />Okote o Juda dikhla e čheja jećhe Hanaancošće savo akhardolas Šua, pa lija lat pale romnji thaj pašljilo lasa. <verse eid="GEN 38:2" /><verse number="3" style="v" sid="GEN 38:3" />Voj ačhili khamni thaj bijandas čhaves, a o Juda dija les alav Er. <verse eid="GEN 38:3" /><verse number="4" style="v" sid="GEN 38:4" />Palem ačhili khamni thaj bijandas čhaves, saves dijas alav Onan. <verse eid="GEN 38:4" /><verse number="5" style="v" sid="GEN 38:5" />Askal bijandas još jećhe čhaves thaj dija les alav Sala. Kana bijanda les, o Juda sas ando Keziv.<verse eid="GEN 38:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 38:6" />O Juda oženisarda pire prvobijande čhave e Ere e čhejasa savi akhardolas Tamara. <verse eid="GEN 38:6" /><verse number="7" style="v" sid="GEN 38:7" />Ali e Judasko prvobijando čhavo o Er ćerelas bilačhipe anglo GOSPOD, zato o GOSPOD lijas lesko trajo.<verse eid="GEN 38:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 38:8" />Askal o Juda phendas e Onanešće: “Sov ćire phralešće romnjasa thaj izvršisar prema late e deversko dužnost thaj vazde potomstvo ćire phralešće.”<verse eid="GEN 38:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 38:9" />Ali sar o Onan džanglas kaj o potomstvo či đinavela pe sago lesko, kana god sutasas pire phralešće romnjasa, lelas sama te či ačhel phari, te pire phralešće či del potomstvo. <verse eid="GEN 38:9" /><verse number="10" style="v" sid="GEN 38:10" />Godova so ćerda nas milo e GOSPODEŠĆE, pa o GOSPOD lijas vi lesko trajo.<verse eid="GEN 38:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="GEN 38:11" />Askal o Juda phendas pire borjaće e Tamaraće: “Dža thaj traji ando ćher ćire dadesko sago udovica, dok mungro čhavo o Sala či barjol.”</para>
  <para style="p" vid="GEN 38:11">Kaj, o Juda gndisardas: “Vi vo šaj mulosas sago vi lešće phral.”</para>
  <para style="p" vid="GEN 38:11">Gajda e Tamara đeli te trajil ando ćher pire dadesko.<verse eid="GEN 38:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="GEN 38:12" />Pale lungo vrjama e Judašći romnji, e Šuašći čhej, muli. Kana nakhli e vrjama palo žalipe, o Juda đelotar, zajedno pire drugaresa e Hirosa Adulomcosa ande Timna, ke manuša save randenas lešće bakhren.<verse eid="GEN 38:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="GEN 38:13" />Kana phendine e Tamaraće: “Eke, ćiro sokro džal ande Timna te randel e bakhren,” <verse eid="GEN 38:13" /><verse number="14" style="v" sid="GEN 38:14" />e Tamara fuljardas pestar e udovičke drze, učharda pe e velosa thaj umotisajli, pa bešli po ulazo ando gav Enaim, savo si po drom pale Timna. Kaj, dikhla kaj o Sala barjilo, a či dine lat pale leste.<verse eid="GEN 38:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="GEN 38:15" />Kana o Juda dikhla lat, gndisardas kaj si bludnica, kaj lako muj sas učhardo.<verse eid="GEN 38:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="GEN 38:16" />Katar o drom nakhlo dži late, či džangla kaj si lešći bori, thaj phendas: “Hajde, kamlemas te sovav tusa.”</para>
  <para style="p" vid="GEN 38:16">Voj phučlas: “A so deja man te sutemas tusa?”<verse eid="GEN 38:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 38:17" />O Juda phendas: “Bičhalava tuće jek buznjora andar mungro stado.”</para>
  <para style="p" vid="GEN 38:17">Voj phendas lešće: “Šaj, ako des man vareso ando zalog, dok či bičhales lat.”<verse eid="GEN 38:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 38:18" />Vo phučlas: “Sosko zalog te dav tut?”</para>
  <para style="p" vid="GEN 38:18">Voj phendas: “Ćiri pečato angrušći savi sas phangli e dorjasa thaj e rovlji savi si ande ćiro vas.”</para>
  <para style="p" vid="GEN 38:18">Thaj vo dija lat so manglas lestar, pa sutas lasa thaj voj ačhili khamni lestar. <verse eid="GEN 38:18" /><verse number="19" style="v" sid="GEN 38:19" />Askal e Tamara đelitar ćhere, fuljardas o velo thaj palem lijas pe peste e udovičke drze.<verse eid="GEN 38:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="GEN 38:20" />O Juda bičhaldas pire drugare e Hire e buznjorasa te boldel lešće palpale o zalog katar koja manušnji, ali vo či arakhla lat.<verse eid="GEN 38:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="GEN 38:21" />Pa phučla e manušen andar godova than: “Kaj si e hramsko bludnica savi sas akate pašo drom katar džal pe prema o Enajim?”</para>
  <para style="p" vid="GEN 38:21">Von phendine lešće: “Akate nikada nas hramsko bludnica.”<verse eid="GEN 38:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="GEN 38:22" />Vo bolda pe ko Juda thaj phendas: “Či arakhlem lat. A osim godova, e manuša andar godova than phendine manđe: ‘Akate nas nisošći hramsko bludnica.’”<verse eid="GEN 38:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="GEN 38:23" />Askal o Juda phendas: “Neka zadržil godova so dijem late, te či marel amendar o them muj. Po krajo e krajosko, bičhaldem laće akale buznjora, ali tu či arakhlan lat.”<verse eid="GEN 38:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="GEN 38:24" />Varekaj katar trin čhon majposle phendine e Judašće: “Ćiri bori e Tamara dija pe ando bludo, pa čak vi ačhili khamni.”</para>
  <para style="p" vid="GEN 38:24">O Juda phendas: “Inkalen lat avri thaj den lat jag pe lomača!”<verse eid="GEN 38:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="GEN 38:25" />Ali dok inkalenas lat avri, voj poručisardas pire sokrošće: “Ačhilem khamni okole manušeja kasko si akava. Dik, moliv tut, dali džanes kašći si akaja pečatno angrušći e dorjasa thaj e rovlji?”<verse eid="GEN 38:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="GEN 38:26" />O Juda pindžardas kaj si godova sa lesko thaj phendas: “Voj si majpravedno mandar, kaj me či dijem lat mungre čhavešće e Salašće.”</para>
  <para style="p" vid="GEN 38:26">Thaj majbut či suta lasa.<verse eid="GEN 38:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="GEN 38:27" />Kana avili e vrjama te e Tamara bijanel, sikadilo kaj inđarel blizancurja.<verse eid="GEN 38:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="GEN 38:28" />Dok bijanelas, jek katar e čhavra inkaldas piro vas avri, a e babica pe lesko vas phanglas lolo thav thaj phendas: “Akava inkljisto prvo.”<verse eid="GEN 38:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="GEN 38:29" />Ali baš askal vo crdas piro vas palpale thaj inkljisto lesko phral. E babica phendas: “Sar samo tu probisajlan?” Gajda dine les alav Fares.<verse eid="GEN 38:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="GEN 38:30" />Pale godova inkljisto vi lesko phral saves sas oko o vas lolo thav, pa dine les alav Zara.<verse eid="GEN 38:30" /></para>
  <chapter eid="GEN 38" />
  <chapter number="39" style="c" sid="GEN 39" />
  <para style="s">O Josif ko Potifar</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 39:1" />Kana e Jišmaelcurja inđardine e Josife ando Egipat, okote ćinda les jek Egipćano po alav Potifar, jek katar e faraonešće bare službenikurja, zapovedniko pe dvorsko straža.<verse eid="GEN 39:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="GEN 39:2" />Ali o GOSPOD sas e Josifeja thaj so god te ćerelas džalas lešće e vastestar. Trajilas ando ćher ke piro egipatsko gospodari. <verse eid="GEN 39:2" /><verse number="3" style="v" sid="GEN 39:3" />Kana lesko gospodari dikhla kaj o GOSPOD si leja thaj del les te džal lešće katar o vas sa so ćerel, <verse eid="GEN 39:3" /><verse number="4" style="v" sid="GEN 39:4" />o Josif arakhlas milost ande jakha pire gospodarešće thaj postanisardas lesko osobno sluga thaj lesko gospodari čhuta les te upravil lešće ćhereja thaj poverisardas lešće piri sasti imovina. <verse eid="GEN 39:4" /><verse number="5" style="v" sid="GEN 39:5" />Katar o časo kana o Potifar čhuta e Josife te upravil lešće ćheresa thaj lešće saste imovinava, o GOSPOD zbog o Josif blagoslovisardas o Egipćanesko ćher. E GOSPODESKO blagoslov sas pe sa so sas e Potifare ando ćher thaj ando polje. <verse eid="GEN 39:5" /><verse number="6" style="v" sid="GEN 39:6" />Gajda o Potifar mukla te o Josif vodil briga pale sa so sas les thaj majbut pale khančeste či vodilas briga, osim palo habe savo halas.</para>
  <para style="p" vid="GEN 39:6">O Josif sas šukar thaj zgodno manuš. <verse eid="GEN 39:6" /><verse number="7" style="v" sid="GEN 39:7" />Pale varesavi vrjama e romnji lešće gospodarešći čhudas e jak po Josif thaj phendas lešće: “Ajde pašljov manca!”<verse eid="GEN 39:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 39:8" />Ali vo odbisarda pire gospodarešće romnja thaj phendas laće: “Dik, sar me sem akate, mungro gospodari či vodil briga pale khančeste ando ćher, sa so si les manđe poverisardas. <verse eid="GEN 39:8" /><verse number="9" style="v" sid="GEN 39:9" />Ande akava ćher naj khonikas majbari vlast mandar thaj mungro gospodari khanči či uskratisarda manđe, osim tut, kaj san tu lešći romnji. Pa sar me šaj ćerdemas gajda baro bezeh thaj te sagrešisarav protiv o Del!”<verse eid="GEN 39:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 39:10" />Thaj vi ako svako đes nagovorilas les te sovel lava, vo odbilas lat thaj či kamelas te avel late ni paše.<verse eid="GEN 39:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="GEN 39:11" />Jek đes o Josif dijas ando ćher te ćerel piri bući, a ando ćher nas khonik katar e sluge.<verse eid="GEN 39:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="GEN 39:12" />Voj askal astardas lesko ogrtači thaj phendas lešće: “Pašljov manca!”</para>
  <para style="p" vid="GEN 39:12">Ali vo mukla piro ogrtači ande lako vas thaj našlotar avri.<verse eid="GEN 39:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="GEN 39:13" />Kana voj dikhla kaj vo mukla piro ogrtači ande lako vas thaj našlo avri, <verse eid="GEN 39:13" /><verse number="14" style="v" sid="GEN 39:14" />akhardas pire slugen thaj phendas lenđe: “Dićhen! Akava Jevrejo sas andino amenđe te čhol ladžavo pe amende! Avilo te sovel manca, ali me ačhilem te čhav muj. <verse eid="GEN 39:14" /><verse number="15" style="v" sid="GEN 39:15" />Kana ašundas kaj čhav muj, mukla piro ogrtači mande thaj našlo avri.”<verse eid="GEN 39:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="GEN 39:16" />Inćarelas e Josifesko ogrtači paše peste sa dok lesko gospodari či avilo ćhere. <verse eid="GEN 39:16" /><verse number="17" style="v" sid="GEN 39:17" />Askal vi lešće phendas isto: “Okova jevrejsko robo saves andan amenđe, avilo te čhol ladžavo pe mande. <verse eid="GEN 39:17" /><verse number="18" style="v" sid="GEN 39:18" />Ali, čim ačhilem te čhav muj, mukla piro ogrtači mande thaj našlo avri.”<verse eid="GEN 39:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="GEN 39:19" />Kana lesko gospodari ašundas o svato pire romnjako, savi phendas lešće: “Ake gajda ćiro robo postupisardas manca”, e bari holji dijas ande leste. <verse eid="GEN 39:19" /><verse number="20" style="v" sid="GEN 39:20" />Askal astardas e Josif thaj čhuda les ande tamnica, okote kaj sas ando phanglipe e carošće zatvorenikurja.</para>
  <para style="p" vid="GEN 39:20">Dok o Josif sas ande tamnica, <verse eid="GEN 39:20" /><verse number="21" style="v" sid="GEN 39:21" />o GOSPOD sas lesa, sikadas lešće piri bari ljubav thaj ćerda te o Josif zadobil e naklonost katar o upravniko e tamnicako, <verse eid="GEN 39:21" /><verse number="22" style="v" sid="GEN 39:22" />savo sa e phangle manušen poverisardas e Josifešće thaj gajda sas odgovorno pale sa so okote ćerelas pe. <verse eid="GEN 39:22" /><verse number="23" style="v" sid="GEN 39:23" />O upravniko e tamnicako či vodilas briga pale khančeste so sas poverime e Josifešće, kaj o GOSPOD sas e Josifesa thaj delas les te džal lešće katar o vas sa so ćerelas.<verse eid="GEN 39:23" /></para>
  <chapter eid="GEN 39" />
  <chapter number="40" style="c" sid="GEN 40" />
  <para style="s">O Peharniko thaj o Pekari</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 40:1" />Pale varesavi vrjama, dogodisajlo kaj o egipatsko carosko peharniko thaj o pekari sagrešisardine vareso protiv piro gospodari, o egipatsko caro. <verse eid="GEN 40:1" /><verse number="2" style="v" sid="GEN 40:2" />O faraon holjajlo pe akala pire duj službenikurja, po glavno peharniko thaj po glavno pekari, <verse eid="GEN 40:2" /><verse number="3" style="v" sid="GEN 40:3" />thaj čhuda len ande tamnica ando ćher ko zapovedniko pe dvorsko straža, kaj sas phanglo vi o Josif. <verse eid="GEN 40:3" /><verse number="4" style="v" sid="GEN 40:4" />O zapovedniko odredisardas lenđe e Josife te služil lenđe.</para>
  <para style="p" vid="GEN 40:4">Pošto varesavi vrjama sas ande tamnica. <verse eid="GEN 40:4" /><verse number="5" style="v" sid="GEN 40:5" />Ande isto rjat o Egipatsko caresko peharniko thaj vi o pekari dikhline sune thaj svako suno sas les lesko značenje.<verse eid="GEN 40:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 40:6" />Kana o Josif detharinako avilo lende, dikhla kaj liduj snuždisajle, <verse eid="GEN 40:6" /><verse number="7" style="v" sid="GEN 40:7" />thaj phučla len: “Sostar sen ađes gajda snuždime?”<verse eid="GEN 40:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 40:8" />Von phendine lešće: “Liduj džene dikhlam sune, ali naj khonik te tumačil len amenđe.”</para>
  <para style="p" vid="GEN 40:8">O Josif pe godova phendas lenđe: “Naj li o Del godova savo del te tumačin pes e sune? Hajde mothon manđe tumare sune.”<verse eid="GEN 40:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 40:9" />Gajda o glavno peharniko phendas e Josifešće piro suno: “Ande mungro suno dikhlem angle mande e lozako čokot <verse eid="GEN 40:9" /><verse number="10" style="v" sid="GEN 40:10" />thaj pe leste trin terne loze. Thaj tek so teljardine e pupoljkurja, e loza procvetosarda thaj pe drak paćajine e bobice. <verse eid="GEN 40:10" /><verse number="11" style="v" sid="GEN 40:11" />Ando vas inćaravas e faraonesko pehar, pa lijem godoja drak, iscedisardem lat ande faraonesko pehar thaj čhutem les ande faraonesko vas.”<verse eid="GEN 40:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="GEN 40:12" />O Josif phendas lešće: “Ake so godova suno značil: Trin terne loze si trin đesa. <verse eid="GEN 40:12" /><verse number="13" style="v" sid="GEN 40:13" />Pale trin đesa o faraon vazdela ćiro šoro thaj boldela tut ande ćiri služba, pa palem čhoja o pehar ande faraonešće vas sago vi majsigo, dok sanas lesko peharniko. <verse eid="GEN 40:13" /><verse number="14" style="v" sid="GEN 40:14" />A kana avela tuće lačhe, de tut gođi mande, av ljubazno thaj spomeni man e faraonešće te inkalel man andar akaja tamnica. <verse eid="GEN 40:14" /><verse number="15" style="v" sid="GEN 40:15" />Kaj e silava semas inđardo andar e phuv e Jevrejenđi, a ni akate khančeja či zaslužisardem te čhuden man ande tamnica.”<verse eid="GEN 40:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="GEN 40:16" />Kana o glavno pekari dikhla kaj o Josif lačhe tumačisardas e peharnikosko suno, phendas e Josifešće: “Vi me dikhlem suno: Pe mungro šoro sas trin korpe palo mangro. <verse eid="GEN 40:16" /><verse number="17" style="v" sid="GEN 40:17" />Ande okoja savi sas majopre, sas svako vrsno pecivo palo faraon, ali e čiriklja hanas andar e korpa pe mungro šoro.”<verse eid="GEN 40:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 40:18" />O Josif phendas lešće: “Ake so godova suno značil: Trin korpe si trin đesa. <verse eid="GEN 40:18" /><verse number="19" style="v" sid="GEN 40:19" />Pale trin đes o faraon čhinela ćiro šoro thaj unglavela ćiro telo po kaš thaj e čiriklja hana ćiro mas tutar.”<verse eid="GEN 40:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="GEN 40:20" />Gajda vi sas: o trito đes sas e faraonesko rođendan. O faraon pripremisardas gozba pale sa pire službenikurja thaj angle lende inkalda e glavne peharniko thaj e glavne pekare. <verse eid="GEN 40:20" /><verse number="21" style="v" sid="GEN 40:21" />E glavne peharniko bolda ande lešći služba, pa vo palem čholas o pehar ande faraonešće vas, <verse eid="GEN 40:21" /><verse number="22" style="v" sid="GEN 40:22" />a e glavne pekare ungladas, baš sago kaj o Josif tumačisardas lenđe.<verse eid="GEN 40:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="GEN 40:23" />Ali o glavno peharniko bistardas po Josif thaj či spomenisarda les e faraonešće.<verse eid="GEN 40:23" /></para>
  <chapter eid="GEN 40" />
  <chapter number="41" style="c" sid="GEN 41" />
  <para style="s">E faraonešće sune</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 41:1" />Posle pherde duj brš, vi o faraon dikhla suno: Ačhelas paše reka Nil, <verse eid="GEN 41:1" /><verse number="2" style="v" sid="GEN 41:2" />andar savi inkljistine efta šukar thaj thule gurumnja save ačhile te čarjon maškar e trska. <verse eid="GEN 41:2" /><verse number="3" style="v" sid="GEN 41:3" />Posle lende andar o Nil inkljistine aver efta gurumnja, džungale thaj čišle, thaj ačhile paše ke okola aver gurumnja pe obala. <verse eid="GEN 41:3" /><verse number="4" style="v" sid="GEN 41:4" />Askal okola džungale thaj čišle gurumnja haline okole efta šukar thaj thule gurumnjen. Pe godova o faraon džungadilo.<verse eid="GEN 41:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="GEN 41:5" />Kana palem astarda e faraone e lindri, dikhla aver suno: Efta klasurja điv, pherde thaj šukar, barjonas pe jek stabiljka. <verse eid="GEN 41:5" /><verse number="6" style="v" sid="GEN 41:6" />Pale lende inkljistine efta aver klasurja, kržljave thaj phabarde katar e istočno balval. <verse eid="GEN 41:6" /><verse number="7" style="v" sid="GEN 41:7" />Askal okola kržljave klasurja nakhadine okole efta pherde thaj šukar klasurja. Pe godova o faraon džungadilo thaj haćardas kaj dikhla suno.<verse eid="GEN 41:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 41:8" />Detharinako o faraon sas uznemirime zbog pire sune, thaj zato bičhaldas te akharen sa e egipatske vračaren thaj e mudre manušen. Phendas lenđe pire sune, ali nijek lendar či džanelas te phenel lešće so e sune značin.<verse eid="GEN 41:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 41:9" />Askal o glavno peharnik phendas e faraonešće: “Ađes dijem man gođi ke jek mungro propust. <verse eid="GEN 41:9" /><verse number="10" style="v" sid="GEN 41:10" />Kana tu jek data holajlan pe ćire sluge, čhutan man thaj e glavne pekare ando phanglipe ando ćher ko zapovedniko pe dvorsko straža. <verse eid="GEN 41:10" /><verse number="11" style="v" sid="GEN 41:11" />Jek rjat amen liduj džene dikhlam sune, thaj svako suno sas les lesko značenje. <verse eid="GEN 41:11" /><verse number="12" style="v" sid="GEN 41:12" />Okote amenca sas vi jek terno manuš, Hebreji, sluga katar o zapovedniko pe dvorsko straža. Amen mothodam lešće amare sune, thaj vo svakonešće amendar phendas so lesko suno značil. <verse eid="GEN 41:12" /><verse number="13" style="v" sid="GEN 41:13" />Thaj sa sas baš gajda sago kaj phendas amenđe: man boldine ande služba, a e pekare ungladine.”<verse eid="GEN 41:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="GEN 41:14" />Askal o faraon bičhaldas palo Josif, saves so majsigo andine andar e tamnica. Kana rangla pe thaj lijas pe peste aver drze, inkljisto askal anglo faraon.<verse eid="GEN 41:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="GEN 41:15" />O faraon phendas e Josifešće: “Dikhlem jek suno, a khonik či džanel te phenel manđe so o suno značil. Ali ašundem kaj tu šaj tumačis o suno čim ašunes les.”<verse eid="GEN 41:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="GEN 41:16" />O Josif phendas e faraonešće: “Me našti, ali o Del dela odgovor e faraonešće savo dela les miro.”<verse eid="GEN 41:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 41:17" />Askal o faraon phendas e Josifešće: “Ando suno ačhavas pe obala e Nilešći, <verse eid="GEN 41:17" /><verse number="18" style="v" sid="GEN 41:18" />kana okote andar o Nil inkljiste efta šukar thaj thule gurumnja, thaj čarjonas maškar e trska. <verse eid="GEN 41:18" /><verse number="19" style="v" sid="GEN 41:19" />Pale lende inkljistine aver efta gurumnja, džungale thaj čišle. Nikad ando sasto Egipat či dikhlem gajda džungale gurumnjen. <verse eid="GEN 41:19" /><verse number="20" style="v" sid="GEN 41:20" />Askal e džungale thaj čišle gurumnja haline okole efta thule gurumnjen, save prve inkljistine. <verse eid="GEN 41:20" /><verse number="21" style="v" sid="GEN 41:21" />Ali kana haline len, či dićholas pe lende kaj haline len, vi majdur sas isto gajda džungale sago vi majsigo. Askal džungadilem.<verse eid="GEN 41:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="GEN 41:22" />A dikhlem ando suno vi efta klasurja điv, pherde thaj šukar, sar barjon pe jek stabiljka. <verse eid="GEN 41:22" /><verse number="23" style="v" sid="GEN 41:23" />Pale lende inkljistine aver efta klasurja, kržljave thaj phabarde katar e istočno balval. <verse eid="GEN 41:23" /><verse number="24" style="v" sid="GEN 41:24" />Askal akala kržljave klasurja nakhadine okole efta šukar klasurja. Phendem akava e vračarenđe, ali nijek lendar či džanglas te tumačil manđe godova.”<verse eid="GEN 41:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="GEN 41:25" />Askal o Josif phendas e faraonešće: “E faraonešće sunen si jek thaj isto značenje. O Del sikadas e faraonešće so ćerela. <verse eid="GEN 41:25" /><verse number="26" style="v" sid="GEN 41:26" />E efta šukar gurumnja si efta brš, thaj vi efta šukar klasurja si efta brš. Godova si jek isto suno. <verse eid="GEN 41:26" /><verse number="27" style="v" sid="GEN 41:27" />Efta čišle thaj džungale gurumnja save avile posle lende, sago vi okola efta čuče klasurja phabarde katar e istočno balval, si efta brš bokhalipe.<verse eid="GEN 41:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="GEN 41:28" />Gajda si sago kaj phendem e faraonešće: O Del sikadas e faraonešće so ćerela. <verse eid="GEN 41:28" /><verse number="29" style="v" sid="GEN 41:29" />Aven efta brš kana avela baro izobilje palo sasto Egipat, <verse eid="GEN 41:29" /><verse number="30" style="v" sid="GEN 41:30" />ali posle lende avena efta brš bokhalipe. Askal sa o izobilje ando Egipat avela bistardo thaj e bok opustošila e phuv. <verse eid="GEN 41:30" /><verse number="31" style="v" sid="GEN 41:31" />Khonik či dela pe gođi ke vrjama kana sas o baro izobilje, kaj e bok savi avela, avela strašno. <verse eid="GEN 41:31" /><verse number="32" style="v" sid="GEN 41:32" />A godova so e faraonesko suno ponovisajlo, znači kaj o Del vi čače gajda odlučisardas thaj kaj godova uskoro ćerela. <verse eid="GEN 41:32" /><verse number="33" style="v" sid="GEN 41:33" />Zato neka o faraon rodel manuše, savo avela sposobno thaj mudro thaj neka čhol les te avel upravitelj ando sasto Egipat. <verse eid="GEN 41:33" /><verse number="34" style="v" sid="GEN 41:34" />Neka o faraon još čhol odgovorne manušen po sasto Egipat te len pandž posto katar sa e žetva ando Egipat kroz akala efta brš kana avela baro izobilje. <verse eid="GEN 41:34" /><verse number="35" style="v" sid="GEN 41:35" />Neka von ćiden sa o hamasko ande plodne brša save avena thaj neka o faraon mućel len te skladištin o điv pe gava thaj te araćhen les. <verse eid="GEN 41:35" /><verse number="36" style="v" sid="GEN 41:36" />Neka godova hamasko avel zaliha pale phuv pale okola efta bokhale brša save aven po Egipat, thaj te e manuša či meren e bokhatar.”<verse eid="GEN 41:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="GEN 41:37" />Thaj godova predlog sviđaosajlo e faraonešće thaj sa lešće službenikonenđe.<verse eid="GEN 41:37" /></para>
  <para style="s">O Josif postanil upravetelj ando Egipto</para>
  <para style="p">
    <verse number="38" style="v" sid="GEN 41:38" />Zato o faraon phendas pire službenikonenđe: “Zar šaj te arakhas manuše sago kaj si vo, ande savo si o Duho e Devlesko?”<verse eid="GEN 41:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="GEN 41:39" />Askal o faraon phendas e Josifešće: “Pošto o Del sa akava tuće sikada, naj khonik gadići sposobno thaj mudro sago kaj san tu. <verse eid="GEN 41:39" /><verse number="40" style="v" sid="GEN 41:40" />Aveja upravitelj pe mungro dvoro thaj sa mungro them čhola kan pe sa so phenes. Jedino me, o faraon, avava majbaro tutar.”<verse eid="GEN 41:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="GEN 41:41" />O faraon još phendas e Josifešće: “Ake, čhav tut te aves upravitelj po sasto Egipat.”<verse eid="GEN 41:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="GEN 41:42" />Askal fuljardas e pečatno angrušći katar piro vas thaj čhuta lat e Josifešće po vas. Dijas pe leste drze katar o sano lano, a pe kor čhuta lešće sunakuno lanco. <verse eid="GEN 41:42" /><verse number="43" style="v" sid="GEN 41:43" />Dija les te vozil pe ando dujto carsko vordon odma pala leste thaj čhuta e manušen te čhon muj angle leste: “Peren pe koča!” Gajda čhuta les palo upravitelj ando sasto Egipto.<verse eid="GEN 41:43" /></para>
  <para style="p">
    <verse number="44" style="v" sid="GEN 41:44" />O faraon phendas e Josifešće: “Me sem o faraon, ali khonik ando sasto Egipto či tromal te ćerel vareso, te tu godova či mućes.”<verse eid="GEN 41:44" /></para>
  <para style="p">
    <verse number="45" style="v" sid="GEN 41:45" />O faraon dijas e Josife alav Cofnat Paaneah, a pale romnji dija les e Osnata, e Potifarešće čheja savo sas rašaj ando hramo On. Gajda o Josif preuzmisardas e vlast ando sasto Egipat.<verse eid="GEN 41:45" /></para>
  <para style="p">
    <verse number="46" style="v" sid="GEN 41:46" />E Josife sas trijanda brš kana počnisarda e služba ko faraon, ko egipatsko caro. Askal vo đelotar katar o faraon thaj putuilas po sasto Egipat. <verse eid="GEN 41:46" /><verse number="47" style="v" sid="GEN 41:47" />Pale efta brš kana sas o izobilje e phuv delas but plodurja. <verse eid="GEN 41:47" /><verse number="48" style="v" sid="GEN 41:48" />O Josif ćidelas sa o hamasko savo sas proizvodime ande godola izobiljne efta brš ando Egipat thaj skladištilas pe gava. Ande svako gav skladištilas o hamasko andar e okolna njive. <verse eid="GEN 41:48" /><verse number="49" style="v" sid="GEN 41:49" />Gajda o Josif ćida but điv sago morsko pesko, gajda kaj majbut či merilas o điv, kaj sas odviše but.<verse eid="GEN 41:49" /></para>
  <para style="p">
    <verse number="50" style="v" sid="GEN 41:50" />Majsigo nego so avili e bok pe efta brš, e Potiferešći rašaješći čhej e Osnata bijandas e Josifešće duj čhaven.<verse eid="GEN 41:50" /></para>
  <para style="p">
    <verse number="51" style="v" sid="GEN 41:51" />Pire prvobijande čhavešće o Josif dijas alav Manasija, kaj phendas: “O Del ćerda te bistarav sa mungri muka thaj sa o ćher mungre dadesko.”<verse eid="GEN 41:51" /></para>
  <para style="p">
    <verse number="52" style="v" sid="GEN 41:52" />Pire dujto čhavešće dijas alav Efrem, kaj phendas: “O Del ćerda man te avav plodno ande phuv kaj sas man nevolja.”<verse eid="GEN 41:52" /></para>
  <para style="p">
    <verse number="53" style="v" sid="GEN 41:53" />E efta izobiljne bršenđe ando Egipat avilo o krajo <verse eid="GEN 41:53" /><verse number="54" style="v" sid="GEN 41:54" />thaj počnisardine e efta brš bokhalipe, baš sago kaj phendas o Josif. Ande sa e phuvja sas bok, ali ando sasto Egipto sas hamasko. <verse eid="GEN 41:54" /><verse number="55" style="v" sid="GEN 41:55" />A kana o sasto Egipat počnisardas te haćarel bok, o them zavapisardas e faraonešće, rodenas lestar mangro.</para>
  <para style="p" vid="GEN 41:55">Askal o faraon phendas sa e Egićanenđe: “Džan ko Josif thaj ćeren sar phenel tumenđe.”<verse eid="GEN 41:55" /></para>
  <para style="p">
    <verse number="56" style="v" sid="GEN 41:56" />Kana e bok buljili pe sasti phuv, o Josif putardas e skladišturja e điveja thaj ačhilo te bićinel o điv e Egipćanenđe, kaj ando Egipto sas bari bok. <verse eid="GEN 41:56" /><verse number="57" style="v" sid="GEN 41:57" />Sa andar o sasto them avenas ando Egipat te ćinen điv katar o Josif, kaj e bok ando sasto them sas but bari.<verse eid="GEN 41:57" /></para>
  <chapter eid="GEN 41" />
  <chapter number="42" style="c" sid="GEN 42" />
  <para style="s">E Josifešće phral aven ando Egipat</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 42:1" />Kana o Jakov ašundas kaj ando Egipat si điv, phučlas pire čhaven: “Sostar samo bešen thaj dićhen jek ande avreste? <verse eid="GEN 42:1" /><verse number="2" style="v" sid="GEN 42:2" />Ašundem kaj ando Egipat si điv. Džan okote thaj ćinen amenđe, te šaj ačhas džude thaj te na meras e bokhatar.”<verse eid="GEN 42:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="GEN 42:3" />Gajda e Josifešće deš phral đeletar ando Egipat te ćinen điv. <verse eid="GEN 42:3" /><verse number="4" style="v" sid="GEN 42:4" />Ali e Venjamine, e Josifešće phrale, o Jakov či bičhaldas averenca, kaj darajlo te či aresel les varesosko bilačhipe. <verse eid="GEN 42:4" /><verse number="5" style="v" sid="GEN 42:5" />Gajda e Izraelošće čhave maladile maškar okola save džanas ando Egipat te ćinen điv, kaj vi ando Hanaan vladilas e bok.<verse eid="GEN 42:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 42:6" />O Josif sago upravniko e phuvjako sas okova savo savorenđe bićinelas điv.</para>
  <para style="p" vid="GEN 42:6">Kana lešće phral aviline leste, poklonisajle lešće e mujesa dži ke phuv. <verse eid="GEN 42:6" /><verse number="7" style="v" sid="GEN 42:7" />Kana o Josif dikhla pire phralen odma pindžarda len, ali ćerda pes kaj či pindžarel len thaj oštro phučla len: “Katar aven?”</para>
  <para style="p" vid="GEN 42:7">Von phendine: “Andar o Hanaan avilam te ćinas hamasko.”<verse eid="GEN 42:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 42:8" />Vi ako o Josif pindžardas pire phralen, von les či pindžardine.<verse eid="GEN 42:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 42:9" />Askal o Josif dija pe gođi ke sune save dikhla pale lende pa phendas lenđe: “Tumen sen špijunurja! Aviline te dićhen kaj si e phuv majslabo!”<verse eid="GEN 42:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 42:10" />Von phendine lešće: “Na, gospodarina! Amen, ćire sluge, avilam te ćinas hamasko. <verse eid="GEN 42:10" /><verse number="11" style="v" sid="GEN 42:11" />Savora sam amen čhave jećhe dadešće. Amen, ćire sluge, paćivale sam manuša, a na špijunurja.”<verse eid="GEN 42:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="GEN 42:12" />Ali vo phendas lenđe: “Na, tumen aviline te špijunirin e slabo thana akale phuvjaće.”<verse eid="GEN 42:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="GEN 42:13" />Von phendine: “Amen, ćire sluge, samas dešuduj phral, čhave jećhe dadešće andar o Hanaan. O majterno ačhilo amare dadesa, a jećhe majbut naj.”<verse eid="GEN 42:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="GEN 42:14" />O Josif phendas lenđe: “Gajda si sar već phendem tumenđe: Tumen sen špijunurja! <verse eid="GEN 42:14" /><verse number="15" style="v" sid="GEN 42:15" />Agajda proveriva tumen: Hav solah e faraonešće trajosa, či džanatar akatar ako tumaro majterno phral či avel akaring. <verse eid="GEN 42:15" /><verse number="16" style="v" sid="GEN 42:16" />Bičhalen jećhe tumendar te anel tumare phrale, a tumen aver ačhena ande tamnica. Gajda proveriva tumare alava thaj dikhava dali mothon čačipe. Ako či phendine čačipe, hav solah e faraonešće trajosa, špijunurja sen!”<verse eid="GEN 42:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 42:17" />Pale godova čhuda len ando phanglipe pe trin đes.<verse eid="GEN 42:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 42:18" />O trito đes o Josif phendas lenđe: “Ćeren akava thaj ačhena po trajo, kaj me darav e Devlestar: <verse eid="GEN 42:18" /><verse number="19" style="v" sid="GEN 42:19" />Ako sen paćivale manuša, neka jek tumendar ačhel ando phanglipe, a tumen aver džan thaj inđaren o điv tumare bokhale familijenđe ćhere. <verse eid="GEN 42:19" /><verse number="20" style="v" sid="GEN 42:20" />Askal anen manđe tumare majterne phrales, gajda potvrdila pes kaj si čače okova so phendine thaj či aven mudarde.”</para>
  <para style="p" vid="GEN 42:20">Thaj von pristanisardine.<verse eid="GEN 42:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="GEN 42:21" />Pale godova phendine jek avrešće: “Akava si sigurno kazna pale okova so ćerdam amare phralešće. Dikhlam sar mučil pe dok molilas men pale milost, ali či čhutam kan leste. Zbog godova aresla men akaja nevolja.”<verse eid="GEN 42:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="GEN 42:22" />O Ruvim phendas: “Zar či phendem tumenđe: te na ogrešin tumen protiv o čhavro? A tumen či kamline te čhon kan mande. Akana moraš te položis o računo pale lesko trajo.”<verse eid="GEN 42:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="GEN 42:23" />Či džangline kaj o Josif haćarel len so ćeren svato, kaj ćerenas lesa svato prekal o tumači. <verse eid="GEN 42:23" /><verse number="24" style="v" sid="GEN 42:24" />Vo đelotar lendar cara majdur thaj počnisarda te rovel. Pale godova bolda pe lende thaj nastavisarda te mothol lenđe. Askal lija pe rig e Simeone thaj zapovedisardas te angle lenđe jakha phanden les.<verse eid="GEN 42:24" /></para>
  <para style="s">E Josifešće phral bolden pes ando Hanaan</para>
  <para style="p">
    <verse number="25" style="v" sid="GEN 42:25" />Pale godova o Josif zapovedisardas te pheren lenđe gone e đivesa thaj te svakonešće lendar čhol ando gono e đivesa lešće love thaj te den len sa so trubul len palo drom. Kana ćerdine gajda, <verse eid="GEN 42:25" /><verse number="26" style="v" sid="GEN 42:26" />von natovarisardine o điv pe pire magarice thaj đeletar.<verse eid="GEN 42:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="GEN 42:27" />Kana aresline te raćaren, jek katar e phral putardas piro gono te pravarel e magarco thaj dikhla e love opral ando gono. <verse eid="GEN 42:27" /><verse number="28" style="v" sid="GEN 42:28" />Askal phendas pire phralenđe: “Mungre love si boldine! Ake, akate si ande mungro gono!”</para>
  <para style="p" vid="GEN 42:28">Lengo ilo ačhilo thaj izdranas e daratar pa phendine: “So godova ćerel amenđe o Del?”<verse eid="GEN 42:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="GEN 42:29" />Kana aresline ke piro dad o Jakov ando Hanaan, phendine lešće sa so dogodisajlo lenđe. <verse eid="GEN 42:29" /><verse number="30" style="v" sid="GEN 42:30" />“O manuš savo si gospodari godole phuvjako, strogo ćerda amenca svato thaj nabedisardas pe amende kaj avilam te špijoniris godoja phuv.<verse eid="GEN 42:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="GEN 42:31" />Ali amen phendam lešće: ‘Paćivale sam manuša, naj sam špijunurja. <verse eid="GEN 42:31" /><verse number="32" style="v" sid="GEN 42:32" />Samas dešuduj phral, čhave jećhe dadestar. Jećhe phrale više naj, a o majterno si akana amare dadesa ando Hanaan.’ <verse eid="GEN 42:32" /><verse number="33" style="v" sid="GEN 42:33" />Askal o gospodari godole phuvjako phendas amenđe: ‘Gajda džanava kaj sen paćivale manuša: jećhe phrales mućen akate mande, a len o hamasko pale tumare bokhale familije ćhere, pa džan! <verse eid="GEN 42:33" /><verse number="34" style="v" sid="GEN 42:34" />Askal anen manđe tumare majterne phrales thaj džanava kaj naj sen špijunurja, nego paćivale manuša. Pale godova boldava tumenđe tumare phrales thaj šaj slobodno phiraven tumen e phuvjasa.’”<verse eid="GEN 42:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="GEN 42:35" />Ali sar čučarenas pire gone, svako arakhlas piri kesa e lovenca. Kana von thaj lengo dad dikhline e kese e lovenca, darajle.<verse eid="GEN 42:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="GEN 42:36" />Lengo dad o Jakov phendas lenđe: “Zbog tumende ačhava bi čhavrengo. E Josife više naj, naj ni e Simeone, a akana kamen te len mandar vi e Venijamine. Sa urotisajlo protiv mande!”<verse eid="GEN 42:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="GEN 42:37" />Askal o Ruvim phendas pire dadešće: “Mudar mungre duj čhaven ako či boldav tuće palpale e Venjamine. Poveri les manđe thaj me boldava les palpale.”<verse eid="GEN 42:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="GEN 42:38" />Ali o Jakov phendas: “Mungro čhavo či džala tumenca, kaj lesko phral si mulo thaj samo još vo ačhilo. Ako po drom araćhel les varesavo bilačhipe, tradena man, puranes thaj tužnes ando limori.”<verse eid="GEN 42:38" /></para>
  <chapter eid="GEN 42" />
  <chapter number="43" style="c" sid="GEN 43" />
  <para style="s">E Josifešće phrala džan palpale ando Egipat</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 43:1" />Ande phuv Hanaan sas bari bok.<verse eid="GEN 43:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="GEN 43:2" />Kana haline sa o điv savo andine andar o Egipat, lengo dad phendas lenđe: “Džan palpale ando Egipat thaj ćinen amenđe još cara hamasko.”<verse eid="GEN 43:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="GEN 43:3" />Ali o Juda phendas: “Okova manuš ozbiljno upozorisarda men: ‘Na inkljen manđe pe jakha, te tumaro phral či avilo tumenca.’ <verse eid="GEN 43:3" /><verse number="4" style="v" sid="GEN 43:4" />Ako san spremno te amare phrales bičhales amenca, džasa thaj ćinasa tuće hamasko. <verse eid="GEN 43:4" /><verse number="5" style="v" sid="GEN 43:5" />Ali ako či kames te bičhales les amenca, či džasa, kaj okova manuš phendas: ‘Na inkljen manđe pe jakha, te tumaro phral či avilo tumenca.’ ”<verse eid="GEN 43:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 43:6" />Askal o Izrael phučlas: “Sostar čhutine man ande akaja nevolja gajda kaj phendine godole manušešće kaj si tumen još jek phral?”<verse eid="GEN 43:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="GEN 43:7" />Von phendine: “Godova manuš sa pomno ispituilas amen pale amende thaj pale amari familija. Phučlas: ‘Dali si tumaro dad još džudo? Si tumen još savo phral?’ Thaj amen samo mothodam lešće so phučla men. Katar šaj džanglam kaj phenela: ‘Anen tumare phrales’?”<verse eid="GEN 43:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 43:8" />Askal o Juda phendas pire dadešće e Izraelošće: “Bičhal e Venjamine manca thaj odma teljarasa, te šaj ačhas džude vi amen, vi tu thaj vi amare čhavra, a na te meras. <verse eid="GEN 43:8" /><verse number="9" style="v" sid="GEN 43:9" />Me garantujiv tuće pala leste, man inćar kaj sem odgovorno pala leste. Ako či boldav les tuće, sasto trajo avava došalo angle tute. <verse eid="GEN 43:9" /><verse number="10" style="v" sid="GEN 43:10" />Te či gadići gndijas amen, dži akana šaj već duj data avilamas palpale.”<verse eid="GEN 43:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="GEN 43:11" />Askal lengo dad o Izrael phendas lenđe: “Ako gajda moraš te avel, askal ćeren gajda: Čhon ande gone majlačhe plodurja katar akaja phuv thaj inđaren okole manušešće po daro: cara balsamo, cara medo, začinurja thaj smirna, pistacije thaj badem. <verse eid="GEN 43:11" /><verse number="12" style="v" sid="GEN 43:12" />Thaj len tumenca dvostruko majbut love, kaj trubul te bolden e love save sas tumenđe čhutine palpale ande gone. Šaj te sas godova greška. <verse eid="GEN 43:12" /><verse number="13" style="v" sid="GEN 43:13" />Inđaren vi tumare phrales tumenca thaj odma teljaren ke okova manuš. <verse eid="GEN 43:13" /><verse number="14" style="v" sid="GEN 43:14" />Neka o Del o Svemogućo Del, ćerel te okova manuš smiluil pe tumenđe, pa mućel tumare avre phrales vi e Venijamine te boldel pe tumenca. A me, ako ačhav bičhavrengo, neka ačhav.”<verse eid="GEN 43:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="GEN 43:15" />Gajda e phral line pesa e darurja thaj dvostruko majbut love, thaj inđardine pesa e Venijamine. Odma đeline ando Egipat thaj ačhile anglo Josif.<verse eid="GEN 43:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="GEN 43:16" />Kana o Josif dikhla lenca e Venijamine, phendas e upravitelješće katar piro ćher: “Inđar akale manušen ande mungro ćher, de čhurjasa jećhe životinja thaj ćer habe, kaj von hana manca ando mismeri.”<verse eid="GEN 43:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 43:17" />O upravitelj ćerda gajda sar o Josif phendas thaj inđardas e phralen ande Josifesko ćher. <verse eid="GEN 43:17" /><verse number="18" style="v" sid="GEN 43:18" />Ali kana inđardine len ande Josifesko ćher, von darajle.</para>
  <para style="p" vid="GEN 43:18">Gndinas: “Andine men akate zbog e love save sas amenđe okova prvo data čhutino palpale ande gone. Akana hutena pe amende, svladina men thaj ćerena amendar roburja, thaj lena amare magarconen.”<verse eid="GEN 43:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="GEN 43:19" />Zato avile ko upravitelj e Josifešće ćheresko thaj phendine lešće po ulaz ando ćher: <verse eid="GEN 43:19" /><verse number="20" style="v" sid="GEN 43:20" />“Gospodarina, amen samas već jekhar akate te ćinas hamasko, <verse eid="GEN 43:20" /><verse number="21" style="v" sid="GEN 43:21" />ali kana ačhilam te raćaras thaj kana putardam amare gone, svako jek katar amende arakhla pire love opral ando gono, ando pherdo iznos. Akana godola love andam amenca. <verse eid="GEN 43:21" /><verse number="22" style="v" sid="GEN 43:22" />A andam još aver love te palem ćinas hamasko. Či džanas ko čhuta amenđe godola love palpale ande gone.”<verse eid="GEN 43:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="GEN 43:23" />O upravitelj phendas lenđe: “Na te daran. Tumaro Del, o Del tumare dadesko, čhuta e love ande tumare gone. Tumare love me već primisardem.”</para>
  <para style="p" vid="GEN 43:23">Askal anda lenđe e Simone. <verse eid="GEN 43:23" /><verse number="24" style="v" sid="GEN 43:24" />Pe godova o upravitelj e Josifešće ćheresko dija len paj te thoven pire pungre thaj dija lenđe magarcen te han. <verse eid="GEN 43:24" /><verse number="25" style="v" sid="GEN 43:25" />Von pripremisardine darurja palo Josif kana avela ando mismeri, kaj ašundine kaj okote hana. <verse eid="GEN 43:25" /><verse number="26" style="v" sid="GEN 43:26" />Kana o Josif avilo ando ćher, von dine les darurja save andine lešće thaj naklonisajle angla leste dži ke phuv.<verse eid="GEN 43:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="GEN 43:27" />Vo phučla len sar sen, pa phendas: “Sar si tumaro purano dad, pale savo ćerdine manđe svato? Dali si još džudo?”<verse eid="GEN 43:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="GEN 43:28" />Von phendine: “Ćiro sluga, amaro dad, još si džudo thaj sasto.” Askal naklonisajle lešće dži ke phuv.<verse eid="GEN 43:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="GEN 43:29" />O Josif lačhe dikhla pe lende thaj lijas sama kaj maškar lende si o Venijamin, lešće dejako čhavo, pa phučlas: “Si akava tumaro majterno phral, pale savo ćerdine manđe svato?”</para>
  <para style="p" vid="GEN 43:29">Askal phendas: “Neka o Del avel milostivo prema tute, čhaveja.”<verse eid="GEN 43:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="GEN 43:30" />Sas lešće pharo kaj dićhel pire phrales, gajda prastajas avri andar o ćher, kaj samo so e jasva či dine pe lesko muj. Đelo ande aver ćher thaj okote rujas.<verse eid="GEN 43:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="GEN 43:31" />Kana thoda piro muj, inkljisto, ćićidas piro ilo thaj phendas: “Anen o habe!”<verse eid="GEN 43:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="GEN 43:32" />E Josife služinas pale jek sinija, lešće phralen pale aver sinija thaj e Egipćanen pale aver sinija. E Egipćanurja našti hanas e Jevrejenca pale sinija kaj sas lenđe godova odvratno. <verse eid="GEN 43:32" /><verse number="33" style="v" sid="GEN 43:33" />E phral bešline anglo Josif prema pire brš, katar o prvobijando dži ko majterno. Thaj zbog godova dikhline jek pe avreste ando čudo. <verse eid="GEN 43:33" /><verse number="34" style="v" sid="GEN 43:34" />Kana anenas lenđe o habe katar e Josifešći sinija, o habe savo čhutine anglo Venijamin sas pandž drom majbaro katar averengo. Gajda hanas e Josifeja thaj but piline.<verse eid="GEN 43:34" /></para>
  <chapter eid="GEN 43" />
  <chapter number="44" style="c" sid="GEN 44" />
  <para style="s">O Josif čhol zamka pire phralenđe</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 44:1" />Pale godova o Josif naredisarda e upravitelješće katar piro ćher: “Pher e gone akale manušenđe e habeja, kozom god šaj inđaren, thaj svakonešće love bolde opral ande lesko gono. <verse eid="GEN 44:1" /><verse number="2" style="v" sid="GEN 44:2" />A mungro rupuno pehari čho opral ando gono e majternešće zajedno lešće lovenca savenca poćindas o điv.”</para>
  <para style="p" vid="GEN 44:2">Thaj o upravitelj ćerda sar o Josif phendas lešće.<verse eid="GEN 44:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="GEN 44:3" />Detharinako kana svanosardas, spremisardine e phralen thaj lenđe magarcen po drom.<verse eid="GEN 44:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="GEN 44:4" />Ali tek so inkljistine cara majdur andar o gav, o Josif phendas pire upravitelješće: “Ušti thaj teljar pale okola manuša, pa kana areseja len, phen lenđe: ‘Sostar bolden bilačhipe palo lačhipe? <verse eid="GEN 44:4" /><verse number="5" style="v" sid="GEN 44:5" />Sostar čordine o rupuno pehari mungre gospodaresko. Godova si pehari andar savo pijel mungro gospodari thaj savo služil lešće te drabarel. Ćerdine baro bilačhipe!’ ”<verse eid="GEN 44:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 44:6" />Kana o upravitelj aresla len, ponovisarda lenđe sa akala alava. <verse eid="GEN 44:6" /><verse number="7" style="v" sid="GEN 44:7" />A von pe godova phendine lešće: “Sostar gajda phenes amenđe, gospodarina? Amen, ćire sluge, nikada či ćerdamas gajda vareso! <verse eid="GEN 44:7" /><verse number="8" style="v" sid="GEN 44:8" />Čak andar o Hanaan boldam okola love save arakhlam opral ande amare gone. Sostar askal čordamas o rup ili o sunakaj andar o ćher ćire gospodaresko? <verse eid="GEN 44:8" /><verse number="9" style="v" sid="GEN 44:9" />Ako godova arakhadol ke jek amendar, ćire slugendar, godole mudaren, a amen aver avasa ćire roburja, gospodarina.”<verse eid="GEN 44:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 44:10" />“Lačhe phenen”, vo phendas, “ali neka avel gajda: Kaste arakhadol o pehari, godova avela mungro robo, a tumen aver avena slobodne.”<verse eid="GEN 44:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="GEN 44:11" />Askal svako lendar brzo mukla piro gono pe phuv thaj putardas les. <verse eid="GEN 44:11" /><verse number="12" style="v" sid="GEN 44:12" />O upravitelj rodas ande lenđe gone počnisarda katar o majpurano a završisarda e majternesa. Thaj o pehari arakhadilo ande Venjaminesko gono. <verse eid="GEN 44:12" /><verse number="13" style="v" sid="GEN 44:13" />Pe godova von pharadine pe peste pire drze pa natovarisardine e magarcen thaj boldine pe ando gav.<verse eid="GEN 44:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="GEN 44:14" />Kana o Juda thaj lešće phral aviline ande Josifesko ćher, vo sas još okote.</para>
  <para style="p" vid="GEN 44:14">Von peline pe koča angle leste, <verse eid="GEN 44:14" /><verse number="15" style="v" sid="GEN 44:15" />a o Josif phendas lenđe: “So godova ćerdine? Zar či džanen kaj o manuš savo si sago me džanel te drabarel?”<verse eid="GEN 44:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="GEN 44:16" />Askal o Juda phendas: “So te phenas tuće, gospodarina? So te phenas? Sar te dokažis kaj naj sam došale? O Del sikadas amari doš pale varesoste so ćerdam majsigo. Gospodarina, amen sam akana ćire roburja, amen thaj vi okova kaste arakhadilo ćiro pehari.”<verse eid="GEN 44:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 44:17" />Ali o Josif phendas: “Na! Me či kamav godova te ćerav tumenđe! Samo okova ke savo arakhadilo o pehari avela mungro robo, a tumen aver ando miro bolden tumen ke tumaro dad.”<verse eid="GEN 44:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 44:18" />Askal o Juda avilo dži leste thaj phendas: “Moliv tut, gospodarina, muk man ćire sluga te vareso phenav tuće thaj na te holjavos pe mande, vi ako san tu sago o faraon. <verse eid="GEN 44:18" /><verse number="19" style="v" sid="GEN 44:19" />Tu, gospodarina, phučlan amen: ‘Dali si tumen dad ili još varesavo phral?’ <verse eid="GEN 44:19" /><verse number="20" style="v" sid="GEN 44:20" />Thaj amen phendam: ‘Si amen purano dad thaj majterno phral, savo bijandilo lešće kana sas purano. Lesko rođeno phral si mulo thaj samo vo ačhilo katar e čhave lešće dejaće, thaj o dad zurale volil les.’ <verse eid="GEN 44:20" /><verse number="21" style="v" sid="GEN 44:21" />Ali tu askal phendan amenđe ćire slugenđe: ‘Anen les te dikhav les mungre jakhenca.’ <verse eid="GEN 44:21" /><verse number="22" style="v" sid="GEN 44:22" />A amen, gospodarina, phendam tuće: ‘O čhavro našti džaltar katar o dad kaj amaro dad mulosas kana o čhavro muklasas les.’ <verse eid="GEN 44:22" /><verse number="23" style="v" sid="GEN 44:23" />Ali tu phendan amenđe, ćire slugenđe: ‘Ako tumaro majterno phral či avel tumenca, na inkljen angle mungre jakha!’ <verse eid="GEN 44:23" /><verse number="24" style="v" sid="GEN 44:24" />Kana bolda men ke ćiro sluga, ke amaro dad, phendam lešće sa so tu, gospodarina, phendan. <verse eid="GEN 44:24" /><verse number="25" style="v" sid="GEN 44:25" />Amaro dad phendas: ‘Bolden tumen inća thaj ćinen još habe.’ <verse eid="GEN 44:25" /><verse number="26" style="v" sid="GEN 44:26" />A amen phendam: ‘Našti te džas inća osim ako amaro majterno phral či džal amenca. Či tromas te avas okole manušešće angle jakha bi amare majterne phralesko.’ <verse eid="GEN 44:26" /><verse number="27" style="v" sid="GEN 44:27" />Ćiro sluga, amaro dad, phendas amenđe: ‘Džanen kaj mungri romnji bijandas manđe duj čhaven. <verse eid="GEN 44:27" /><verse number="28" style="v" sid="GEN 44:28" />Jek nestanisardas, sigurno si rastrgnome pe kotora, thaj nikada majbut či dikhlem les. <verse eid="GEN 44:28" /><verse number="29" style="v" sid="GEN 44:29" />Ako vi akales len mandar, pa dogodil pe lešće varesavo bilačhipe, tradena man puranes thaj tužnes ando limori.’ <verse eid="GEN 44:29" /><verse number="30" style="v" sid="GEN 44:30" />Ako akana me bolda man ke ćiro sluga, ke mungro dad, savo zurale phangla pe palo čhavro, <verse eid="GEN 44:30" /><verse number="31" style="v" sid="GEN 44:31" />thaj ako vo dićhel kaj o čhavro naj amenca, merela. Gajda amen, ćire sluge, tradamas amare dades, ćire slugo, puranes thaj tužne ando limori. <verse eid="GEN 44:31" /><verse number="32" style="v" sid="GEN 44:32" />A me, ćiro sluga, garantuisardem mungre dadešće palo čhavro: ‘Ako či boldav les tuće palpale, sasto trajo avava došalo angle tute!’ <verse eid="GEN 44:32" /><verse number="33" style="v" sid="GEN 44:33" />Zato moliv tut, gospodarina, muk te me ačhav akate sago ćiro robo umesto okova čhavro, a okole čhavre muk te boldel pes palpale lešće phralenca. <verse eid="GEN 44:33" /><verse number="34" style="v" sid="GEN 44:34" />Kaj sar šaj te bolda man palpale angle mungro dad, ako o čhavro naj manca? Našti dikhlemas o jado savo arakhlasas mungre dade.”<verse eid="GEN 44:34" /></para>
  <chapter eid="GEN 44" />
  <chapter number="45" style="c" sid="GEN 45" />
  <para style="s">O Josif mothol pire phralenđe ko si vo</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 45:1" />O Josif našti ćićidelas majbut pesko ilo angle pire sluge, zato čhuta muj: “Neka savora inkljen avri!” Gajda nas khonik e Josifesa kana phendas pire phralenđe ko si vo. <verse eid="GEN 45:1" /><verse number="2" style="v" sid="GEN 45:2" />Ali rovelas gadići zurale ando glaso kaj vi e Egipćaja ašunenas les, a vi e faraonesko dvoro saznaisardas pale godova.<verse eid="GEN 45:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="GEN 45:3" />O Josif phendas pire phralenđe: “Me sem o Josif! Dali si mungro dad još džudo?”</para>
  <para style="p" vid="GEN 45:3">Ali von sas gadići but zaprepastime kaj našti phendine lešće so phučla len.<verse eid="GEN 45:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="GEN 45:4" />Askal o Josif phendas: “Aven majpaše.”</para>
  <para style="p" vid="GEN 45:4">Kana avile, phendas: “Me sem tumaro phral o Josif, okova saves bićindine ando Egipat! <verse eid="GEN 45:4" /><verse number="5" style="v" sid="GEN 45:5" />Ali akana na aven uznemirime niti holjarike korkoro pe tumende zato kaj bićindine man akaring, kaj o Del bičhalda man angle tumende te spasin pe e trajurja. <verse eid="GEN 45:5" /><verse number="6" style="v" sid="GEN 45:6" />Već duj brš trajil e bok ande phuv, a još pandž brš či orila pe e phuv, a niti žetva avela. <verse eid="GEN 45:6" /><verse number="7" style="v" sid="GEN 45:7" />O Del bičhalda man angle tumende, te čudesno spasil tumare trajurja thaj te avel tumen potomstvo pe phuv. <verse eid="GEN 45:7" /><verse number="8" style="v" sid="GEN 45:8" />Gajda či bičhaldine man tumen akate, nego o Del. Vo čhuta man palo majbaro faraonesko službeniko, palo gospodari pe sasto ćher e faraonesko thaj palo vladari po sasto Egipat.<verse eid="GEN 45:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 45:9" />Akana siđaren palpale mungre dadešće thaj phenen lešće: ‘Ćiro čhavo o Josif phenel gajda: O Del čhuta man palo gospodari po sasto Egipat. Av mande, na gndi tut. <verse eid="GEN 45:9" /><verse number="10" style="v" sid="GEN 45:10" />Trajija ando krajo Gošen thaj aveja manđe paše – tu, ćire čhavra, ćire unukurja, ćire bakhre, ćire guruva thaj sa so si tut. <verse eid="GEN 45:10" /><verse number="11" style="v" sid="GEN 45:11" />Me okote inćarava briga pale tute, kaj e bok trajila još pandž brš. Gajda či inćareja bok ni tu, ni ćiri familija ni khonik ćiro.’<verse eid="GEN 45:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="GEN 45:12" />Korkoro šaj dićhen, sago vi tumaro phral o Venijamin, kaj me vi čače tumenca ćerav svato. <verse eid="GEN 45:12" /><verse number="13" style="v" sid="GEN 45:13" />Phenen mungre dadešće pale bari čast savi si manđe dini ando Egipat thaj pale sa so dikhline. Thaj sigo anen mungre dades akaring!”<verse eid="GEN 45:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="GEN 45:14" />Askal dijas mrtiko pire phrales e Venijamine thaj liduj džene rovenas dok denas pe mrtiko. <verse eid="GEN 45:14" /><verse number="15" style="v" sid="GEN 45:15" />Pale godova e jasvenca delas mrtiko thaj čumidelas sa pire phralen. Posle godova lešće phral ćerdine svato lesa.<verse eid="GEN 45:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="GEN 45:16" />Kana dži ke faraonesko dvoro avili e nevimata kaj aresline e Josifešće phral, o faraon thaj lešće službenikurja obraduisajle.<verse eid="GEN 45:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 45:17" />O faraon phendas e Josifešće: “Phen ćire phralenđe: ‘Ćeren agajda: Natovarin hamasko pe tumare magarcurja thaj bolden tumen ando Hanaan. <verse eid="GEN 45:17" /><verse number="18" style="v" sid="GEN 45:18" />Askal anen tumare dades thaj tumare familije mande. Me dava tumen majlačhi phuv ando Egipat thaj pravarena tumen katar o obilje akale phuvjako.’<verse eid="GEN 45:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="GEN 45:19" />A naredba del pe tuće te phenes lenđe: ‘Ćeren agajda: Len tumenđe varekozom vordona andar o Egipat pale tumare čhavra thaj pale tumare romnja. Anen vi tumare dade thaj aven akaring. <verse eid="GEN 45:19" /><verse number="20" style="v" sid="GEN 45:20" />Na žalin pale okova so mukline okote, kaj dela pe tumenđe okova majlačho ando sasto Egipat.’ ”<verse eid="GEN 45:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="GEN 45:21" />Askal e Izraelošće čhave ćerdine gajda. O Josif dija len vordona thaj hamasko palo drom, sago kaj o faraon phendas. <verse eid="GEN 45:21" /><verse number="22" style="v" sid="GEN 45:22" />Svakonešće lendar dijas neve haljine, ali e Venijaminešće dijas trin šela rupune kovanice thaj pandž haljine. <verse eid="GEN 45:22" /><verse number="23" style="v" sid="GEN 45:23" />A akava bičhaldas pire dadešće: deš magarcurja natovarime okoleja so si majlačho ando Egipat, deš magarice natovarime e đivesa, mangresa thaj sa avresa so trubula les palo drom.<verse eid="GEN 45:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="GEN 45:24" />Pale godova bičhaldas pire phralen po drom. Dok džanastar, phendas lenđe: “Na han tumen e dromesa maškar tumende!”<verse eid="GEN 45:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="GEN 45:25" />Gajda von teljardine andar o Egipat thaj aresline pire dadešće e Jakovešće ando Hanaan.<verse eid="GEN 45:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="GEN 45:26" />Kana phendine lešće: “O Josif si džudo thaj vladil po sasto Egipat!” o Jakov zaprepastisajlo thaj našti paćalas so ašunel. <verse eid="GEN 45:26" /><verse number="27" style="v" sid="GEN 45:27" />Von phendine lešće sa so o Josif phendas lenđe. Thaj kana o Jakov dikhla e vordona save o Josif bičhaldas pala leste, džudilo ando duho.<verse eid="GEN 45:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="GEN 45:28" />Askal o Izrael phendas: “Uverisajlem! Mungro čhavo o Josif džudo si! Džava te dikhav les majsigo nego so merav.”<verse eid="GEN 45:28" /></para>
  <chapter eid="GEN 45" />
  <chapter number="46" style="c" sid="GEN 46" />
  <para style="s">O Jakov džal ando Egipat</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 46:1" />Gajda o Israel teljardas po drom ando Egipat thaj lijas pesa sa so sas les. Kana areslo dži ke Beer-Šeba, dija žrtve e Devlešće kašće služisardas lesko dad o Isaak.<verse eid="GEN 46:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="GEN 46:2" />O Del e raćava phendas e Jakovešće ando viđenje: “Jakove! Jakove!”</para>
  <para style="p" vid="GEN 46:2">Vo phendas: “Aketa man!”<verse eid="GEN 46:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="GEN 46:3" />“Me sem o Del, o Del ćire dadesko,” phendas. “Na dara te džas ando Egipat, kaj okote tutar ćerava baro them. <verse eid="GEN 46:3" /><verse number="4" style="v" sid="GEN 46:4" />Džava tusa ando Egipat thaj palem okotar boldava tut palpale. A kana mereja o Josif pire vastenca phandavela ćire jakha.”<verse eid="GEN 46:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="GEN 46:5" />Pale godova o Josif teljardas andar e Beer-Šeba. E Izraelošće čhave čhutine pire dade zajedno e romnjenca thaj pire čhavrenca pe vordona save bičhaldas o faraon pale lende te anen les okote. <verse eid="GEN 46:5" /><verse number="6" style="v" sid="GEN 46:6" />Line pesa piri stoka thaj o barvalipe savo steknisardine ando Hanaan. Gajda o Jakov thaj sasto lesko potomstvo đeline ando Egipat. <verse eid="GEN 46:6" /><verse number="7" style="v" sid="GEN 46:7" />O Jakov andas pesa ando Egipat sa pire čhaven thaj e unukonen, pire čhejen thaj pire unukicen – sasto lesko potomstvo.<verse eid="GEN 46:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 46:8" />Akava si e alava e Izraelešće čhavenđe, e Jakovešće thaj lešće potomkonenđe, save đeletar ando Egipat:</para>
  <para style="b" vid="GEN 46:8" />
  <para style="li1" vid="GEN 46:8">O Ruvim, e Jakovesko prvobijando čhavo. <verse eid="GEN 46:8" /><verse number="9" style="v" sid="GEN 46:9" />E Ruvimešće čhave:</para>
  <para style="li2" vid="GEN 46:9">O Hanoh, Palu, Ecrom thaj o Karmi.<verse eid="GEN 46:9" /></para>
  <para style="li1">
    <verse number="10" style="v" sid="GEN 46:10" />E Simeonešće čhave:</para>
  <para style="li2" vid="GEN 46:10">O Jemuel, Jamin, Ohad, Jahin, Cohar thaj o Saul, čhavo jećhe Hanaankako.<verse eid="GEN 46:10" /></para>
  <para style="li1">
    <verse number="11" style="v" sid="GEN 46:11" />E Leviješće čhave:</para>
  <para style="li2" vid="GEN 46:11">O Geršon, Kehat thaj o Merari.<verse eid="GEN 46:11" /></para>
  <para style="li1">
    <verse number="12" style="v" sid="GEN 46:12" />E Judašće čhave:</para>
  <para style="li2" vid="GEN 46:12">O Er, Onan, Sala, Fares thaj o Zara. Ali o Er thaj o Onan muline ando Hanaan. E Faresošće čhave: O Esrom thaj o Hamul.<verse eid="GEN 46:12" /></para>
  <para style="li1">
    <verse number="13" style="v" sid="GEN 46:13" />E Isaharošće čhave:</para>
  <para style="li2" vid="GEN 46:13">O Tola, Pua, Jašuv thaj o Šimron.<verse eid="GEN 46:13" /></para>
  <para style="li1">
    <verse number="14" style="v" sid="GEN 46:14" />E Zavulonešće čhave:</para>
  <para style="li2" vid="GEN 46:14">O Sered, Elon thaj o Jahleel.<verse eid="GEN 46:14" /></para>
  <para style="b" />
  <para style="p">
    <verse number="15" style="v" sid="GEN 46:15" />Godova si e čhave save e Lija bijandas e Jakovešće ando Padan-Aram. Voj bijandas lešće vi čheja e Dina. Akala lešće čhave thaj čheja sas ukupno trijanda thaj trin.<verse eid="GEN 46:15" /></para>
  <para style="b" />
  <para style="li1">
    <verse number="16" style="v" sid="GEN 46:16" />E Gadešće čhave:</para>
  <para style="li2" vid="GEN 46:16">O Cifjon, Hagi, Šuni, Ecbon, Eri, Arodi thaj o Areli.<verse eid="GEN 46:16" /></para>
  <para style="li1">
    <verse number="17" style="v" sid="GEN 46:17" />E Asirešće čhave:</para>
  <para style="li2" vid="GEN 46:17">O Jimna, Jišva, Jišvi thaj o Berija. Lenđi phen sas e Serah. E Beriješće čhave: O Hever thaj o Malkijel.<verse eid="GEN 46:17" /></para>
  <para style="b" />
  <para style="p">
    <verse number="18" style="v" sid="GEN 46:18" />Godova si e čhavra save e Jakovešće bijandas e Zilpa savja o Laban dijas pire čhejaće e Lijaće. Ukupno sas len dešušov džene.<verse eid="GEN 46:18" /></para>
  <para style="b" />
  <para style="li1">
    <verse number="19" style="v" sid="GEN 46:19" />Čhave e Jakovešće romnjaće e Rahiljaće sas:</para>
  <para style="li1" vid="GEN 46:19">O Josif thaj o Venijamin.<verse eid="GEN 46:19" /></para>
  <para style="li2">
    <verse number="20" style="v" sid="GEN 46:20" />E Josifešće ando Egipat e Osnata, čhej e Potiferešći e rašaješći ando On, bijandas e Manasije thaj e Efreme.<verse eid="GEN 46:20" /></para>
  <para style="li2">
    <verse number="21" style="v" sid="GEN 46:21" />E Venijaminešće čhave:</para>
  <para style="li2" vid="GEN 46:21">O Bela, Beher, Ašbel, Gera, Neman, Ehi, Roš, Mupim, Hupim thaj o Ard.<verse eid="GEN 46:21" /></para>
  <para style="b" />
  <para style="p">
    <verse number="22" style="v" sid="GEN 46:22" />Godova si e Rahiljaće čhave save bijandas e Jakovešće. Ukupno sas len dešuštar džene.<verse eid="GEN 46:22" /></para>
  <para style="b" />
  <para style="li1">
    <verse number="23" style="v" sid="GEN 46:23" />E Danesko čhavo:</para>
  <para style="li2" vid="GEN 46:23">O Hušim.<verse eid="GEN 46:23" /></para>
  <para style="li1">
    <verse number="24" style="v" sid="GEN 46:24" />E Neftalimešće čhave:</para>
  <para style="li2" vid="GEN 46:24">O Jahceel, Guni, Jecer thaj o Šilem.<verse eid="GEN 46:24" /></para>
  <para style="b" />
  <para style="p">
    <verse number="25" style="v" sid="GEN 46:25" />Godova si e čhave save e Jakovešće bijandas e Bilha, savja o Lavan dijas pire čhejaće e Rahiljaće. Ukupno sas len efta džene.<verse eid="GEN 46:25" /></para>
  <para style="b" />
  <para style="p">
    <verse number="26" style="v" sid="GEN 46:26" />Sa lešće rođene potomkurja save e Jakovesa đeline ando Egipat sas šovardeš thaj šov. Či đinaven pe lenđe borja. <verse eid="GEN 46:26" /><verse number="27" style="v" sid="GEN 46:27" />E duj Josifešće čhavenca ando Egipat, sas ukupno eftavardeš članurja e Jakovešći familija save đeletar ando Egipat.<verse eid="GEN 46:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="GEN 46:28" />O Jakov bičhaldas e Juda anglal ko Josif te o Josif sikavel lešće o drom ando krajo Gošen. Kana aresline okote, <verse eid="GEN 46:28" /><verse number="29" style="v" sid="GEN 46:29" />o Josif naredisarda te upregnin o vordon, pa đelo ando Gošen te malavel pe pire dadesa e Izraelosa. Čim areslo angle piro dad, čhuda pe ande lešće angalja thaj dugo rovenas.<verse eid="GEN 46:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="GEN 46:30" />O Izrael phendas e Josifešće: “Akana šaj te merav, pošto mungre jakhenca dikhlem kaj san još džudo.”<verse eid="GEN 46:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="GEN 46:31" />Askal o Josif phendas pire phralenđe thaj lešće dadešće familijaće: “Džava te ćerav svato e faraonesa. Phenava lešće: ‘Avile mande mungre phral thaj aver familija mungre dadešći, save trajinas ando Hanaan. <verse eid="GEN 46:31" /><verse number="32" style="v" sid="GEN 46:32" />Von si stočarja, ćeren bući e stokava thaj pesa andine piri hurdi thaj bari stoka thaj sa so sas len.’ <verse eid="GEN 46:32" /><verse number="33" style="v" sid="GEN 46:33" />Kana o faraon akharela tumen thaj phučel: ‘So ćeren bući?’, <verse eid="GEN 46:33" /><verse number="34" style="v" sid="GEN 46:34" />tumen phenen: ‘Amen, ćire sluge, sam stočarja katar amaro ternipe, sago kaj sas vi amare pradada.’ Gajda šaj te naselina tumen ando Gošen, kaj si e Egipćanenđe e stočarja odvratne.”<verse eid="GEN 46:34" /></para>
  <chapter eid="GEN 46" />
  <chapter number="47" style="c" sid="GEN 47" />
  <para style="s">O Jakov avel anglo faraon</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 47:1" />O Josif đelo thaj phendas e faraonešće: “Mungro dad thaj mungre phral, pire hurde thaj bare stokava thaj sa okoleja so si len, aresline andar o Hanaan thaj ake akana si ando krajo Gošen.”<verse eid="GEN 47:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="GEN 47:2" />Askal lijas pesa katar pire phral samo pandž dženen thaj anda len anglo faraon.<verse eid="GEN 47:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="GEN 47:3" />O faraon phučlas lešće phralen: “Savi bući si tumen?”</para>
  <para style="p" vid="GEN 47:3">Von phendine lešće: “Amen ćire sluge, sam pastirja, sago kaj sas amare pradada.” <verse eid="GEN 47:3" /><verse number="4" style="v" sid="GEN 47:4" />A phendine lešće vi akava: “Avilam te varesavi vrjama trajisaras akate sago strancurja, kaj e bok ando Hanaan si bari, a naj čar kaj inkaldamas amare stada te čarjon. Zato, molisaras tut, de amen, ćire slugen, te trajis ando Gošen.”<verse eid="GEN 47:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="GEN 47:5" />O faraon phendas e Josifešće: “Ćiro dad thaj ćire phral avile tute. <verse eid="GEN 47:5" /><verse number="6" style="v" sid="GEN 47:6" />O Egipat si tumenđe putardo: čho ćire dades thaj ćire phralen te trajin ande majlačho krajo e phuvjako. Neka trajin ando Gošen. A ako džanes kaj si maškar lende sposobne manuša, čhov len te aven nadglednikurja pe mungri stoka.”<verse eid="GEN 47:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="GEN 47:7" />Askal o Josif lijas pire dades e Jakove thaj anda les anglo faraon. O Jakov blagoslovisardas e faraone, <verse eid="GEN 47:7" /><verse number="8" style="v" sid="GEN 47:8" />a vo phučla e Jakove: “Kozom brš si tut?”<verse eid="GEN 47:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 47:9" />O Jakov phendas lešće: “Phirav pe phuv šel thaj trijanda brš. Mungre brš si cara thaj sas phare. Još či avilem dži ke brš mungre pradadenđe.”<verse eid="GEN 47:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 47:10" />Askal o Jakov blagoslovisardas e faraone thaj đelotar.<verse eid="GEN 47:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="GEN 47:11" />Gajda o Josif čhuta pire dades thaj pire phralen te trajin ando Egipat thaj dija len imanje ande majlačho deo e phuvjako, ande krajo Ramses, sago kaj o faraon zapovedisardas. <verse eid="GEN 47:11" /><verse number="12" style="v" sid="GEN 47:12" />O Josif vodilas briga te lešće dades, lešće phralen thaj sa lešće dadešće ćherutnen avel hamasko prema o brojo lenđe čhavrengo.<verse eid="GEN 47:12" /></para>
  <para style="s">E bok ando Egipat</para>
  <para style="p">
    <verse number="13" style="v" sid="GEN 47:13" />Nikaj ande sasti phuv nas hamasko, kaj e bok sas odviše phari, pa e manuša andar o Egipat thaj andar o Hanaan sas iscrpime katar e bok. <verse eid="GEN 47:13" /><verse number="14" style="v" sid="GEN 47:14" />O Josif ćidelas sa e love savenca o them andar o Egipto thaj andar o Hanaan ćinenas o điv, thaj anelas e love ande faraonesko dvoro.<verse eid="GEN 47:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="GEN 47:15" />Kana ando Egipat thaj ando Hanaan nas više love, sa e Egipćaja avile ko Josif thaj phendine lešće: “De amen hamasko. Sostar te meras angle ćire jakha? Love naj amen majbut.”<verse eid="GEN 47:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="GEN 47:16" />O Josif phendas: “Pošto love majbut naj tumen, anen tumari stoka thaj dava tumen hamasko sago zamena pale tumari stoka.” <verse eid="GEN 47:16" /><verse number="17" style="v" sid="GEN 47:17" />Gajda von andine piri stoka e Josifešće, a o Josif dija len hamasko sago zamena pale gras, pale hurdi thaj bari stoka, pale guruva thaj magarcurja. Godova brš pravarda len e habeja savo zamenisarda pale sa lenđi stoka.<verse eid="GEN 47:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 47:18" />Godova brš nakhlo, a aver brš von palem aviline leste thaj phendine lešće: “Našti te garavas tutar, gospodarina, kaj naj men love a vi amari stoka si akana ćiri. Majbut khanči či ačhilo men pale tute, gospodarina, osim amen korkoro thaj amare njive. <verse eid="GEN 47:18" /><verse number="19" style="v" sid="GEN 47:19" />Sostar te propadnisaras angle ćire jakha vi amen thaj vi amare njive? Ćin amen thaj vi amare njive sago zamena palo hamasko, thaj amen zajedno amare njivenca avasa e faraonešće roburja. De amen seme, te ačhas po trajo, te či meras thaj te e njive či ačhen puste.”<verse eid="GEN 47:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="GEN 47:20" />Gajda o Josif ćindas palo faraon sa e njive ando Egipat save šaj obradinas pe. Sa e Egipćaja bićindine pire njive, kaj e bok zurale ćićidelas len. Gajda sa e njive postanisardine e faraonešće, <verse eid="GEN 47:20" /><verse number="21" style="v" sid="GEN 47:21" />a sasto egipatsko them, katar jek dži ke aver krajo, postanisardine lešće roburja. <verse eid="GEN 47:21" /><verse number="22" style="v" sid="GEN 47:22" />Či ćindas jedino e njive save pripadinas e rašajenđe, kaj von dobinas redovno love katar o faraon thaj katar godova trajinas, pa zato či bićinenas piri phuv.<verse eid="GEN 47:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="GEN 47:23" />O Josif phendas e themešće: “Pošto ađes ćindem tumen palo faraon thaj isto gajda vi tumare njive. Ake len o seme thaj posadin e njive. <verse eid="GEN 47:23" /><verse number="24" style="v" sid="GEN 47:24" />Ali, kana ćidela pe e žetva jek petina den e faraonešće, a štar petine neka ačhel tumenđe, sago seme pale njive thaj sago hamasko pale tumende thaj pale okola save trajin tumenca thaj pale tumare čhavra.”<verse eid="GEN 47:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="GEN 47:25" />Von phendine: “Spasisardan amaro trajo. Te arakhlam milost ande ćire jakha, gospodarina, avasa e faraonešće roburja.”<verse eid="GEN 47:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="GEN 47:26" />Gajda o Josif andas e upute pale njive ando Egipat, save vi ađes vredin, te o pandžto deo katar e žetva del pe e faraonešće. Jedino e njive e rašajenđi či postanisada e faraonešće.<verse eid="GEN 47:26" /></para>
  <para style="s">E Jakovešći poslednjo želja</para>
  <para style="p">
    <verse number="27" style="v" sid="GEN 47:27" />E Izraelcurja naselisajle ando Egipat, ando Gošen, thaj okote steknisardine barvalipe. Dobisardine but čhavren thaj postanisardine brojne.<verse eid="GEN 47:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="GEN 47:28" />O Jakov trajilas ando Egipat dešuefta brš, pa sa ukupno trajisardas šel thaj štarvardeš thaj efta brš. <verse eid="GEN 47:28" /><verse number="29" style="v" sid="GEN 47:29" />Kana avili e vrjama te o Izrael merel, vo akhardas pire čhave e Josife thaj phendas lešće: “Te arakhlem milost ande ćire jakha, čho ćiro vas pe mungre butine thaj de tut alav kaj sikaveja manđe bari ljubav thaj vernost: Na prahosar man ando Egipat. <verse eid="GEN 47:29" /><verse number="30" style="v" sid="GEN 47:30" />Kana merava, inđar man andar o Egipat thaj prahosar man okote kaj si prahome vi mungre dada.”</para>
  <para style="p" vid="GEN 47:30">O Josif phendas lešće: “Ćerava sar phendan manđe.”<verse eid="GEN 47:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="GEN 47:31" />A o Jakov phendas lešće: “Ha manđe solah.” Thaj o Josif hala lešće solah.</para>
  <para style="p" vid="GEN 47:31">Askal o Izrael poklonisajlo sago znako zahvale po uzglavko ke piro kreveto.<verse eid="GEN 47:31" /></para>
  <chapter eid="GEN 47" />
  <chapter number="48" style="c" sid="GEN 48" />
  <para style="s">O Jakov blagoslovil e Efreme thaj e Manasije</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 48:1" />Pale varesavi vrjama phendine e Josifešće: “Ćiro dad si nasvalo.” Askal o Josif lijas pire duj čhaven, e Manasije thaj e Efreme, thaj đelo leste.<verse eid="GEN 48:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="GEN 48:2" />Kana phendine e Jakovešće: “Avilo ćiro čhavo o Josif”, o Izrael ćida piri snaga thaj bešlo ando than.<verse eid="GEN 48:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="GEN 48:3" />O Jakov phendas e Josifešće: “O Del Svemogućo, sikadilo manđe ando Luz, ando Hanaan thaj okote blagoslovisarda man. <verse eid="GEN 48:3" /><verse number="4" style="v" sid="GEN 48:4" />Phendas manđe: ‘Ćerava tut te aves plodno thaj but brojno. Tutar ćerava but thema, thaj akaja phuv dava ando nasledstvo ćire potomkonenđe zauvek.’ <verse eid="GEN 48:4" /><verse number="5" style="v" sid="GEN 48:5" />Neka akana, ćire duj čhave, save bijandile tuće ando Egipat, majsigo nego so me avilem akaring, aven mungre, baš sago kaj si o Ruvim thaj o Simeon mungre. <verse eid="GEN 48:5" /><verse number="6" style="v" sid="GEN 48:6" />A e čhavra save bijandona tuće pale lende, neka ačhen ćire. Neka lengo nasledstvo vodilpe tale alava lenđe phralengo e Efremesko thaj e Manasijesko. <verse eid="GEN 48:6" /><verse number="7" style="v" sid="GEN 48:7" />Kana boldavas man andar o Padan, pe mungri žalost, e Rahilja muli ando Hanaan dok samas po drom karingal o Efrat, pa prahosardem lat pašo drom karingal o Efrat.” (Godova si akana o Vitlejem.)<verse eid="GEN 48:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 48:8" />Kana o Izrael dikhla e Josifešće čhaven, phučla: “Ko si akala?”<verse eid="GEN 48:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 48:9" />O Josif phendas pire dadešće: “Godova si mungre čhave saven o Del dija man akate.”</para>
  <para style="p" vid="GEN 48:9">Askal o Izrael phendas: “An len mande te blagosloviv len.”<verse eid="GEN 48:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 48:10" />E Izraelošće jakha oslabisardine katar o phuripe, pa jedva dićhelas. O Josif andas lešće pire čhaven skroz paše, a lesko dad dija len mrtiko thaj čumida len.<verse eid="GEN 48:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="GEN 48:11" />O Izrael phendas e Josifešće: “Gndisardem kaj nikad majbut či dikhava ćiro muj, ali ake o Del dija man te dikhav vi ćire čhaven.”<verse eid="GEN 48:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="GEN 48:12" />Askal o Josif fuljarda len katar pire dadešće angalja thaj poklonisajlo e mujesa dži ke phuv. <verse eid="GEN 48:12" /><verse number="13" style="v" sid="GEN 48:13" />Pale godova lija len lidujen, e Efreme pe piri desno rig, karingal e Izraelosko levo vas, a e Manasija pe piri levo rig, karingal e Izraelosko desno vas, pa primaknisarda len majpaše lešće. <verse eid="GEN 48:13" /><verse number="14" style="v" sid="GEN 48:14" />Ali o Izrael inzardas piro desno vas thaj čhuta les pe Efremesko šoro, vi ako sas o Efrem majterno. Askal ukrstisardas e vas thaj čhuta o levo vas pe Manasijesko šoro, vi ako sas o Manasije prvobijando.<verse eid="GEN 48:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="GEN 48:15" />Askal o Izrael blagoslovisarda e Josife thaj phendas:</para>
  <para style="b" vid="GEN 48:15" />
  <para style="q1" vid="GEN 48:15">“O Del, savešće služinas</para>
  <para style="q2" vid="GEN 48:15">mungre dada o Avraam thaj o Isaak,</para>
  <para style="q1" vid="GEN 48:15">o Del, savo si mungro pastiri</para>
  <para style="q2" vid="GEN 48:15">sasto mungro trajo dži ađes ađeste,<verse eid="GEN 48:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="GEN 48:16" />o anđelo savo inkalda man katar svako bilačhipe,</para>
  <para style="q2" vid="GEN 48:16">neka blagoslovil akale čhaven.</para>
  <para style="q1" vid="GEN 48:16">Te prekal lende spominjil pe mungro alav</para>
  <para style="q2" vid="GEN 48:16">thaj po alav mungre dadengo e Avraamesko thaj e Isaakosko,</para>
  <para style="q2" vid="GEN 48:16">thaj te avel len but potomkurja pe phuv!”<verse eid="GEN 48:16" /></para>
  <para style="b" />
  <para style="p">
    <verse number="17" style="v" sid="GEN 48:17" />Kana o Josif dikhla kaj lesko dad čhuta piro desno vas pe Efremesko šoro, godova nas lešće milo, pa lijas pire dadesko vas te premestil les katar e Efremesko šoro pe Manasijesko. <verse eid="GEN 48:17" /><verse number="18" style="v" sid="GEN 48:18" />“Na, dade,” phendas o Josif. “O Manasije si o prvobijando. Pe lesko šoro čho ćiro desno vas.”<verse eid="GEN 48:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="GEN 48:19" />Ali lesko dad odbisardas thaj phendas: “Džanav, čhaveja, džanav. Thaj vi lestar postanila baro them thaj vo postanila baro, ali lesko majterno phral avela majbaro lestar thaj katar lešće potomkurja postanina but thema.”<verse eid="GEN 48:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="GEN 48:20" />Gajda o Isaak blagoslovisarda len godova đes thaj phendas:</para>
  <para style="b" vid="GEN 48:20" />
  <para style="q1" vid="GEN 48:20">“Tumare alavenca e Izraelcurja blagoslovina avren:</para>
  <para style="q2" vid="GEN 48:20">‘Neka o Del ćerel tut sago e Efreme thaj e Manasije.’ ”</para>
  <para style="b" vid="GEN 48:20" />
  <para style="q1" vid="GEN 48:20">Gajda e Efreme čhuta anglo Manasije.<verse eid="GEN 48:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="GEN 48:21" />Askal o Izrael phendas e Josifešće: “Ake, uskoro merava, ali o Del avela tumenca thaj boldela tumen ande phuv tumare pradadenđi. <verse eid="GEN 48:21" /><verse number="22" style="v" sid="GEN 48:22" />A tuće dav jek kotor e phuvjako majbut nego ćire phralenđe: o planinsko krajo Sihem, savo mungre mačesa thaj e lukosa otmisardem katar e Amorejcurja.”<verse eid="GEN 48:22" /></para>
  <chapter eid="GEN 48" />
  <chapter number="49" style="c" sid="GEN 49" />
  <para style="s">O Jakov blagoslovil pire čhaven</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 49:1" />Askal o Jakov akhardas pire čhaven thaj phendas lenđe:</para>
  <para style="b" vid="GEN 49:1" />
  <para style="q1" vid="GEN 49:1">“Ćiden tumen oko mande te phenav tumenđe</para>
  <para style="q2" vid="GEN 49:1">so avela tumenca ande budućo vrjama.<verse eid="GEN 49:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="GEN 49:2" />Ćiden tumen thaj ašunen, čhave e Jakovešće,</para>
  <para style="q2" vid="GEN 49:2">ašunen tumare dade e Izraele.”<verse eid="GEN 49:2" /></para>
  <para style="s2">O Ruvim</para>
  <para style="q1">
    <verse number="3" style="v" sid="GEN 49:3" />“Ruvime, mungro prvobijando.</para>
  <para style="q1" vid="GEN 49:3">Tu san mungri snaga,</para>
  <para style="q2" vid="GEN 49:3">prvo plodo katar mungri muškost.</para>
  <para style="q1" vid="GEN 49:3">Izvrsno san ande čast,</para>
  <para style="q2" vid="GEN 49:3">izvrsno san ande snaga.<verse eid="GEN 49:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="GEN 49:4" />Ali nestabilno san sago paj,</para>
  <para style="q2" vid="GEN 49:4">či aveja časno majbut,</para>
  <para style="q1" vid="GEN 49:4">kaj sutan ćire dadešće romnjasa,</para>
  <para style="q2" vid="GEN 49:4">thaj meljardan mungro kreveto.”<verse eid="GEN 49:4" /></para>
  <para style="s2">O Simeon thaj o Levije</para>
  <para style="q1">
    <verse number="5" style="v" sid="GEN 49:5" />“O Simeon thaj o Levije phral si,</para>
  <para style="q2" vid="GEN 49:5">lenđe mačurja si oružje po nasilje.<verse eid="GEN 49:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="GEN 49:6" />Pe lenđe sastankurja či avava,</para>
  <para style="q2" vid="GEN 49:6">niti ćidava man lenca,</para>
  <para style="q1" vid="GEN 49:6">kaj ande piri bari holji mudarenas e manušen</para>
  <para style="q2" vid="GEN 49:6">thaj ande bahatost sakatinas e bikonen.<verse eid="GEN 49:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="GEN 49:7" />Prokleto nek avel lenđi srdžba, gajda oštro,</para>
  <para style="q2" vid="GEN 49:7">thaj lenđi holji, gajda okrutno.</para>
  <para style="q1" vid="GEN 49:7">Razdeliva len ando Jakov,</para>
  <para style="q2" vid="GEN 49:7">raspršiva len ando Izrael.”<verse eid="GEN 49:7" /></para>
  <para style="s2">O Juda</para>
  <para style="q1">
    <verse number="8" style="v" sid="GEN 49:8" />“Juda, tut hvalina ćire phral.</para>
  <para style="q2" vid="GEN 49:8">E vastesa e dušmajen inćareja pale kor.</para>
  <para style="q2" vid="GEN 49:8">E čhave ćire dadešće angle tute dena koča.<verse eid="GEN 49:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="GEN 49:9" />Juda, tu san sago terno lavo.</para>
  <para style="q2" vid="GEN 49:9">Čhaveja mungreja, katar o pleno uštilan.</para>
  <para style="q1" vid="GEN 49:9">Sago lavo thaj e lavica pašljol thaj inzarel pe,</para>
  <para style="q2" vid="GEN 49:9">ko tromal te holjarel les?<verse eid="GEN 49:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="GEN 49:10" />Katar o Juda či lela pe o carsko žezlo</para>
  <para style="q2" vid="GEN 49:10">lešće čhave vladina pale uvek,</para>
  <para style="q1" vid="GEN 49:10">dok či avel okova kašće pripadil,</para>
  <para style="q2" vid="GEN 49:10">kašće pokorina pe e manuša.<verse eid="GEN 49:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="GEN 49:11" />Vo phandel e magarco palo čokot,</para>
  <para style="q2" vid="GEN 49:11">e terne magare pale majlačhi loza.</para>
  <para style="q1" vid="GEN 49:11">Pire drze thovel ande mol</para>
  <para style="q2" vid="GEN 49:11">pire patave ando rat e drakako.<verse eid="GEN 49:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="GEN 49:12" />E jakha lešće avena tamne katar e mol,</para>
  <para style="q2" vid="GEN 49:12">lešće danda majparne katar o thud.”<verse eid="GEN 49:12" /></para>
  <para style="s2">O Zavulon</para>
  <para style="q1">
    <verse number="13" style="v" sid="GEN 49:13" />“O Zavulon trajila pe morsko obala,</para>
  <para style="q2" vid="GEN 49:13">e lađenđe avela utočište;</para>
  <para style="q2" vid="GEN 49:13">e phuv lešći avela dži ko Sidon.”<verse eid="GEN 49:13" /></para>
  <para style="s2">O Isahar</para>
  <para style="q1">
    <verse number="14" style="v" sid="GEN 49:14" />“O Isahar si zuralo sago magarco savo pašljol maškar o tereto.<verse eid="GEN 49:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="GEN 49:15" />Kana dićhel kaj si lačho o than palo odmor,</para>
  <para style="q2" vid="GEN 49:15">a kaj si e phuv šukar,</para>
  <para style="q1" vid="GEN 49:15">e dume čhola talo tereto</para>
  <para style="q2" vid="GEN 49:15">thaj avela prisilime pe bući sago robo.”<verse eid="GEN 49:15" /></para>
  <para style="s2">O Dan</para>
  <para style="q1">
    <verse number="16" style="v" sid="GEN 49:16" />“O Dan sudila pire themešće</para>
  <para style="q2" vid="GEN 49:16">sago svako aver izraelosko pleme.<verse eid="GEN 49:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="GEN 49:17" />O Dan avela sago sap pašo drom,</para>
  <para style="q2" vid="GEN 49:17">otrovno sap paše staza kana e graste dindalel pale khuv,</para>
  <para style="q2" vid="GEN 49:17">thaj e jahače haravel pe dume.”<verse eid="GEN 49:17" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" sid="GEN 49:18" />“GOSPODE ćiro spasenje ažućarav!”<verse eid="GEN 49:18" /></para>
  <para style="s2">O Gad</para>
  <para style="q1">
    <verse number="19" style="v" sid="GEN 49:19" />“Po Gad hutena e razbojnikurja,</para>
  <para style="q2" vid="GEN 49:19">ali vo avela pale lenđi khuv.”<verse eid="GEN 49:19" /></para>
  <para style="s2">O Asir</para>
  <para style="q1">
    <verse number="20" style="v" sid="GEN 49:20" />“E Asire avela but hamasko,</para>
  <para style="q2" vid="GEN 49:20">šukar habe pale carurja.”<verse eid="GEN 49:20" /></para>
  <para style="s2">O Neftalim</para>
  <para style="q1">
    <verse number="21" style="v" sid="GEN 49:21" />“O Neftalim si sago košuta, mukli pe sloboda,</para>
  <para style="q2" vid="GEN 49:21">savi bijanel šukar terne košuten.”<verse eid="GEN 49:21" /></para>
  <para style="s2">O Josif</para>
  <para style="q1">
    <verse number="22" style="v" sid="GEN 49:22" />“O Josif si plodno čokot,</para>
  <para style="q2" vid="GEN 49:22">plodno čokot pašo izvor;</para>
  <para style="q2" vid="GEN 49:22">lešće loze prekal o zido lija pe.<verse eid="GEN 49:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="GEN 49:23" />E strelcurja holjava hutenas pe leste,</para>
  <para style="q2" vid="GEN 49:23">dušmanski čhudenas e strele pe leste,<verse eid="GEN 49:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="GEN 49:24" />ali lesko luko ačhilo čvrsto</para>
  <para style="q2" vid="GEN 49:24">a lešće vas zurajle</para>
  <para style="q1" vid="GEN 49:24">zbog o Silno Del e Jakovesko,</para>
  <para style="q2" vid="GEN 49:24">zbog o Pastiri, e Stena Izraelošći,<verse eid="GEN 49:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="GEN 49:25" />zbog o Del ćire dadesko, savo pomožil tuće,</para>
  <para style="q2" vid="GEN 49:25">zbog o Del Svemogućo, savo blagoslovil tut</para>
  <para style="q1" vid="GEN 49:25">e bršndesa andar o nebo,</para>
  <para style="q2" vid="GEN 49:25">e pajenca andar e telune handuka,</para>
  <para style="q2" vid="GEN 49:25">e bute čhavrenca, e stokava.<verse eid="GEN 49:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="GEN 49:26" />E blagoslovurja ćire dadešće majbare si</para>
  <para style="q2" vid="GEN 49:26">katar e blagoslovurja save aven katar e večne gore,</para>
  <para style="q2" vid="GEN 49:26">katar o obilje e purane bregonendar:</para>
  <para style="q1" vid="GEN 49:26">neka godola blagoslovurja mućen pe po Josif,</para>
  <para style="q2" vid="GEN 49:26">savo si izabirime maškar sa e phral.”<verse eid="GEN 49:26" /></para>
  <para style="s2">O Venijamin</para>
  <para style="q1">
    <verse number="27" style="v" sid="GEN 49:27" />“O Venijamin si grabežljivo ruv;</para>
  <para style="q2" vid="GEN 49:27">ande detharin hal o pleno,</para>
  <para style="q2" vid="GEN 49:27">a tale rjat delil okova so ačhilo.”<verse eid="GEN 49:27" /></para>
  <para style="b" />
  <para style="p">
    <verse number="28" style="v" sid="GEN 49:28" />Sa akala si e dešuduj Izraelešće plemenurja, a kava phendas lenđe lengo dad o Jakov kana blagoslovilas len, svakones lešće posebno blagosloveja.<verse eid="GEN 49:28" /></para>
  <para style="s">E Jakovesko smrto thaj prahope</para>
  <para style="p">
    <verse number="29" style="v" sid="GEN 49:29" />Askal o Jakov gajda zapovedisardas lenđe: “Uskoro merava. Prahon man mungre dadenca ande pećina pe njiva e Efronešći e Hetitošći, <verse eid="GEN 49:29" /><verse number="30" style="v" sid="GEN 49:30" />ande pećina pe njiva Mahpela, paše ke Mamre ando Hanaan, ande njiva savi o Avraam ćindas katar o Efron Hetito te avel les than palo prahope. <verse eid="GEN 49:30" /><verse number="31" style="v" sid="GEN 49:31" />Okote si prahome o Avraam thaj lešći romnji e Sara, o Isaak thaj lešći romnji e Reveka, a okote vi me prahosardem e Lija. <verse eid="GEN 49:31" /><verse number="32" style="v" sid="GEN 49:32" />E njiva thaj e pećina ćinde si katar e Hetiturja.”<verse eid="GEN 49:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="GEN 49:33" />Kana o Jakov gajda dijas akala upute pire čhavenđe, vazdas pire pungre po kreveto mukla o đi thaj mulo.<verse eid="GEN 49:33" /></para>
  <chapter eid="GEN 49" />
  <chapter number="50" style="c" sid="GEN 50" />
  <para style="s">E Jakovesko prahope</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 50:1" />O Josif dija mrtiko pire dades e Jakove, rujas pe leste thaj čumida les. <verse eid="GEN 50:1" /><verse number="2" style="v" sid="GEN 50:2" />Askal zapovedisardas e doktorenđe ande lešći služba te balzamirin lešće dades e Izraele, thaj von balzamirisardine les. <verse eid="GEN 50:2" /><verse number="3" style="v" sid="GEN 50:3" />Godova ćerenas štarvardeš đes, kaj gaći trubul palo balzamiranje. A e Egipćanurja rovenas pale leste eftavardeš đes.<verse eid="GEN 50:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="GEN 50:4" />Kana nakhli e vrjama katar e žalost, o Josif phendas okolenđe save sas pe faraonesko dvoro: “Te arakhlem milost ande tumare jakha, ćeren svato e faraonesa ande mungro alav thaj phenen lešće: <verse eid="GEN 50:4" /><verse number="5" style="v" sid="GEN 50:5" />‘Mungro dad manglas te hav lešće solah thaj phendas: “Još cara thaj merava. Prahosar man ando limori savo pripremisardem manđe ando Hanaan.” Muk man te džav te prahov mungre dades, a askal boldava man.’ ”<verse eid="GEN 50:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 50:6" />O faraon phendas lešće: “Dža thaj praho ćire dades sago kaj halan lešće solah.”<verse eid="GEN 50:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="GEN 50:7" />Gajda o Josif đelo te prahol pire dades. Pratinas les sa e faraonešće sluge – e majbare službenikurja andar lesko dvoro thaj e majbare službenikurja andar o Egipat – <verse eid="GEN 50:7" /><verse number="8" style="v" sid="GEN 50:8" />sago vi sasti e Josifešći familija, lešće phral thaj sa okola save trajinas lešće dadesa ando ćher. Ando krajo Gošen ačhiline samo lenđe čhavra, hurdi thaj bari stoka. <verse eid="GEN 50:8" /><verse number="9" style="v" sid="GEN 50:9" />A lesa đele vi e manuša pe vordona thaj pe gras. Sas godova bari povorka.<verse eid="GEN 50:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 50:10" />Kana aresline dži ke Atadosko gumno, istočno katar e reka e Jordanošći, počnisardine zurale te roven thaj kukin. O Josif okote inćarda efta đes žalovanje pale piro dad.<verse eid="GEN 50:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="GEN 50:11" />Kana e Hanaancurja save trajinas okote dikhline o žalovanje ke Atadosko gumno, phendine: “Sar e Egipćanurja žalosno kukin!” Zato godova than istočno katar e reka e Jordanošći akhardine Avel Micraim.<verse eid="GEN 50:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="GEN 50:12" />E Jakovešće čhave ćerdine sago kaj zapovedisardas lenđe lengo dad. <verse eid="GEN 50:12" /><verse number="13" style="v" sid="GEN 50:13" />Inđardine les ando Hanaan thaj prahosardine les ande pećina pe njiva Mahpela, paše ke Mamre, godoja njiva savi o Avraam ćindas katar o Efron Hetito palo prahope. <verse eid="GEN 50:13" /><verse number="14" style="v" sid="GEN 50:14" />Nakon so o Josif prahosarda pire dades, bolda pes ando Egipat, zajedno pire phralenca thaj savorenca save teljardine lesa te prahol pire dades.<verse eid="GEN 50:14" /></para>
  <para style="s">O Josif tešil pire phralen</para>
  <para style="p">
    <verse number="15" style="v" sid="GEN 50:15" />Pošto lengo dad mulo, e Josifešće phral phendine: “So ako si o Josif još uvek holjariko pe amende, pa boldel amenđe pale sa o bilačhipe savo amen ćerdam lešće?”<verse eid="GEN 50:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="GEN 50:16" />Zato poručisardine e Josifešće: “Majsigo nego so mulo o dad naredisarda te phenas tuće: <verse eid="GEN 50:16" /><verse number="17" style="v" sid="GEN 50:17" />‘Moliv tut, jartosar ćire phralenđe o bilačhipe thaj o bezeh savo ćerdine tuće.’ Zato, moliv tut, jartosar amenđe amaro zločino. Vi amen sam sluge ćire dadešće Devlešće.”</para>
  <para style="p" vid="GEN 50:17">Kana godova poručisardine lešće o Josif teljardas te rovel.<verse eid="GEN 50:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 50:18" />Askal lešće phral aviline, peline pe koča angle leste thaj phendine: “Ćire sam roburja.”<verse eid="GEN 50:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="GEN 50:19" />Ali o Josif phendas lenđe: “Na daran tumen! Zar sem me pe Devlesko than? <verse eid="GEN 50:19" /><verse number="20" style="v" sid="GEN 50:20" />Tumen godova gndisardine te ćeren manđe bilačhipe, ali o Del godova boldas po lačhipe, te spasil e but trajurja, baš sago kaj akana ćerel. <verse eid="GEN 50:20" /><verse number="21" style="v" sid="GEN 50:21" />Gajda na daran tumen! Me vodiva e briga pale tumende thaj pale tumare čhavra.”</para>
  <para style="p" vid="GEN 50:21">Gajda smirosarda len e ljubazne alavenca.<verse eid="GEN 50:21" /></para>
  <para style="s">E Josifesko meripe</para>
  <para style="p">
    <verse number="22" style="v" sid="GEN 50:22" />O Josif ačhilo te trajil ando Egipat zajedno pire dadešće familijava. Trajisarda šel thaj deš brš <verse eid="GEN 50:22" /><verse number="23" style="v" sid="GEN 50:23" />thaj dikhla e Efremešće čhavren dži ke trito čang, a vi e čhavren katar e Manasijesko čhavo Mahir thaj prihvatisarda len sago piren.<verse eid="GEN 50:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="GEN 50:24" />Askal o Josif phendas pire phralenđe: “Još cara thaj merava, ali o Del sigurno pomožila tumenđe. Inkalela tumen andar akaja phuv thaj inđarela tumen ande phuv pale savi e solahasa obećisarda e Avraamešće, e Isaakošće thaj e Jakovešće.”<verse eid="GEN 50:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="GEN 50:25" />Thaj o Josif manglas katar pire phral, e Izraelošće čhave, te han lešće solah: “Kana o Del pomožila tumenđe thaj inđarela tumen akatar, inđaren mungre kokala tumenca.”<verse eid="GEN 50:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="GEN 50:26" />O Josif mulo kana sas les šel thaj deš brš. Ando Egipat balzamirisardine les thaj čhutine les ando mohto.<verse eid="GEN 50:26" /></para>
  <chapter eid="GEN 50" />
</usx>