<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="PHM" style="id">- Romani Čergaš Biblija (RČB)</book>
  <para style="h">Filemonešće</para>
  <para style="toc1">Lil e Filemonešće</para>
  <para style="toc2">Filemonešće</para>
  <para style="toc3">Flm</para>
  <para style="mt">E Pavlesko lil e Filimonešće</para>
  <chapter number="1" style="c" sid="PHM 1"/>
  <para style="s">E Pavlešće pozdravurja</para>
  <para style="p">
    <verse number="1" style="v" sid="PHM 1:1"/>Akava ramov me o Pavle, savo sem ando phanglipe palo o Isuso Hristo, thaj manca o phral o Timotej, e dragone Filimonešće, amare saradnikošće, <verse eid="PHM 1:1"/><verse number="2" style="v" sid="PHM 1:2"/>e phejaće e Apfijaće, e Arhipešće amare suborcošće ando Hristo, thaj e khanđirjaće ande ćiro ćher:<verse eid="PHM 1:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="PHM 1:3"/>Milost thaj miro tumenđe e Devlestar, amare Dadestar thaj e Gospodestar e Isuse Hristostar.<verse eid="PHM 1:3"/></para>
  <para style="s">E Pavlošći molitveno zahvala</para>
  <para style="p">
    <verse number="4" style="v" sid="PHM 1:4"/>Uvek zahvaliv mungre Devlešće kana moliv man pale tute Filimone, <verse eid="PHM 1:4"/><verse number="5" style="v" sid="PHM 1:5"/>kaj ašunav pale ćiri ljubav pale sa e Devlešće manuša thaj pale ćiro paćipe ando Gospod Isus. <verse eid="PHM 1:5"/><verse number="6" style="v" sid="PHM 1:6"/>Moliv man te amaro zajedništvo savo si amen ando paćipe anel tuće majhanduk haćaripe e svako lačhipestar savo si amen ando Hristo. <verse eid="PHM 1:6"/><verse number="7" style="v" sid="PHM 1:7"/>Kaj ćiri ljubav but bahtarda man thaj utešisarda man, kaj tu, phrale, osvežisardan e ile e Devlešće manušenđe.<verse eid="PHM 1:7"/></para>
  <para style="s">E Pavlošći molitva palo Onisim</para>
  <para style="p">
    <verse number="8" style="v" sid="PHM 1:8"/>Zato, vi ako si man ando Hristo pherdo pravo te zapovediv tuće so te ćeres, <verse eid="PHM 1:8"/><verse number="9" style="v" sid="PHM 1:9"/>zbog e ljubav majradije moliv tut, kasavo sosko sem, me, o phuro Pavle, a akana vi ando phanglipe palo Isuso Hristo. <verse eid="PHM 1:9"/><verse number="10" style="v" sid="PHM 1:10"/>Moliv tut pale mungro čhavo Onisim, kašće postanisardem duhovno dad ando phanglipe. <verse eid="PHM 1:10"/><verse number="11" style="v" sid="PHM 1:11"/>Vo nas tuće majranije korisno, ali akana si korisno<note caller="+" style="f">2 <char style="fr" closed="false">1,11 </char><char style="fq" closed="false">korisno </char><char style="ft" closed="false">O alav “Onisim” značil “korisno”.</char></note> na samo tuće, nego si korisno vi manđe. <verse eid="PHM 1:11"/><verse number="12" style="v" sid="PHM 1:12"/>Bičhalav les tuće palpale, les savo si mungro ilo. <verse eid="PHM 1:12"/><verse number="13" style="v" sid="PHM 1:13"/>Kamlem te ačhavav les mande, te služil manđe umesto tute dok sem ando phanglipe pale Bahtali nevimata. <verse eid="PHM 1:13"/><verse number="14" style="v" sid="PHM 1:14"/>Ali či kamlem khanči te ćerav dok tu či pristanis, sar akava lačho delo či avilosas sago moraš, nego katar ćiri lačhi volja. <verse eid="PHM 1:14"/><verse number="15" style="v" sid="PHM 1:15"/>Šaj te sas baš andar godova pe harni vrjama odvojime tutar sar avilosas ćiro pale sa e vrjama <verse eid="PHM 1:15"/><verse number="16" style="v" sid="PHM 1:16"/>thaj na majbut sago robo, nego majlačhe katar o robo – sago voljeno phral. Vo si manđe but drago, a kozom majbut avela tuće, ali na samo sago manuš, nego vi sago phral ando Gospod.<verse eid="PHM 1:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="PHM 1:17"/>Pa ako, man inćares palo ćiro saradniko primisar askal les sago kaj primisardanas man. <verse eid="PHM 1:17"/><verse number="18" style="v" sid="PHM 1:18"/>A te ćerda tuće vareso pe doš ili ačhilo udžile tuće vareso, me godova lav pe mande. <verse eid="PHM 1:18"/><verse number="19" style="v" sid="PHM 1:19"/>Me, o Pavle, ramov akava mungre vastesa: me poćinava tuće, a te na phenav kaj san manđe udžile vi ćiro trajo.<verse eid="PHM 1:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="PHM 1:20"/>Ej, phrale, volisardemas te avel man tutar varesošći korist ando Gospod. Osvežisar mungro ilo ando Hristo. <verse eid="PHM 1:20"/><verse number="21" style="v" sid="PHM 1:21"/>Ramov tuće kaj sem uverime ande ćiri poslušnost. Džanav kaj ćereja vi majbut nego so mangav tutar.<verse eid="PHM 1:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="PHM 1:22"/>Thaj još vareso: lačhar manđe e gostinsko soba kaj nadiv man kaj o Del uslišila tumare molitve thaj dela te uskoro avav tumenđe.<verse eid="PHM 1:22"/></para>
  <para style="s">Poslednjo pozdrav</para>
  <para style="p">
    <verse number="23" style="v" sid="PHM 1:23"/>Pozdravin tut o Epafras, savo si zajedno manca ando phanglipe palo Hristo Isuso, <verse eid="PHM 1:23"/><verse number="24" style="v" sid="PHM 1:24"/>thaj mungre saradnikurja o Marko, o Aristarh, o Dimas thaj o Luka.<verse eid="PHM 1:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="PHM 1:25"/>Neka e milost amare Gospodešći e Isuse Hristošći avel tumare duhosa.<verse eid="PHM 1:25"/></para>
  <chapter eid="PHM 1"/>
</usx>
