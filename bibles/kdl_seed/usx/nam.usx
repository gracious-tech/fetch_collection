<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="NAM" style="id">- Tsikimba Project</book>
  <para style="h">Nahum</para>
  <para style="toc1">Tagara̱da u Nahum</para>
  <para style="toc2">Nahum</para>
  <para style="toc3">Nah</para>
  <para style="mt2">Tagara̱da u</para>
  <para style="mt1">Nahum</para>
  <para style="is1">Ukukpa̱ u kadyanshi</para>
  <para style="im">A tagara̱da u na vi, Nahum matsumate danai, Magono ma Zuba ma yanka ta̱ Niniba ilyuci i pige i Asiriya afada n mavura. Uyamba u nala vi, atokulalu a aza a Isaraꞌila a ɗa a tsu ꞌyankusu le ta̱ n a yanyi ara̱ɗi. Niniba u rukpa̱ ta̱ kpam a lyai u ɗa a kayen ka amangatawanteli n kupa n re kahu utuwa̱ u Kawauwi (612 B.C). Itagara̱da ushani a asuvu a kazuwamgbani ka cau i yan ta̱ kadyanshi a kaci ka a asuvayali a Magono ma Zuba an a yain kadyanshi ka ukuna u afada ɗa a'a̱ri dere a Magono ma Zuba, shegai a tagara̱da u na vi Magono ma Zuba ma pana ta̱ asuvayali a aza ɗa kpatalai a gonoi a asu u ne u yanka le kpam ukuna u shinga (Kondo 1:7).</para>
  <para style="iot">Ili iꞌya iꞌa̱ri a tagara̱da u na vi</para>
  <para style="io1">Upan u Magono ma Zuba a kaci ka Niniba (1:1-15)</para>
  <para style="io1">Niniba wa rukpa̱ ta̱ (2:1--3:19)</para>
  <chapter number="1" style="c" sid="NAM 1" />
  <para style="p">
    <verse number="1" style="v" sid="NAM 1:1" />Akani a Kashila̱ a kaci ka Niniba.<note caller="+" style="f"><char style="fr" closed="false">1:1--3:19 </char><char style="ft" closed="false">Kondo: </char><char style="xt" closed="false"><ref loc="ISA 10:5-34">Isha 10:5-34</ref>; <ref loc="ISA 14:24-27">Isha 14:24-27</ref>; <ref loc="ZEP 2:13-15">Zaf 2:13-15</ref> </char></note> Tagara̱da u kuwene u Nahum uza u Elikoshiya.<verse eid="NAM 1:1" /></para>
  <para style="s">Upan u Magono ma Zuba a kaci ka Niniba</para>
  <para style="q1">
    <verse number="2" style="v" sid="NAM 1:2" />Magono ma Zuba Kashila̱ uza u malyon ɗa,</para>
  <para style="q2" vid="NAM 1:2">Magono ma Zuba katsupuki ka n upan cika.</para>
  <para style="q1" vid="NAM 1:2">Magono ma Zuba u tsu tsupuka ta̱ kaci ka ne</para>
  <para style="q2" vid="NAM 1:2">a asu u atokulalu a ne</para>
  <para style="q2" vid="NAM 1:2">u tsu gonuko ta̱ upan u ne a asu u atokulalu a ne.<verse eid="NAM 1:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="NAM 1:3" />Magono ma Zuba wa̱ri n maloko ma uyan upan wa,</para>
  <para style="q2" vid="NAM 1:3">shegai wa̱ ta̱ n ucira cika,</para>
  <para style="q2" vid="NAM 1:3">Magono ma Zuba ma kpa̱ɗa̱ uyanka aza a unyushi mavura wa.</para>
  <para style="q1" vid="NAM 1:3">Ure u ne wa̱ ta̱ n uwule u pige u kabatara̱kpa n ulima̱,</para>
  <para style="q2" vid="NAM 1:3">aku alishi a ɗa kabuta̱ ka adeshikpetsu a ne.<verse eid="NAM 1:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="NAM 1:4" />U tsu ɓarana ta̱ mala n aga̱ta̱ a wumkpa,</para>
  <para style="q2" vid="NAM 1:4">u tsu zuwa ta̱ a ɗa kpam a ekpe.</para>
  <para style="q1" vid="NAM 1:4">Mete ma ma̱ri a Bashan n Karumelu ma tsu lumba ta̱</para>
  <para style="q2" vid="NAM 1:4">aku apa̱lu a Lebanon a sa̱ka̱ta̱.<verse eid="NAM 1:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="NAM 1:5" />Nsasa n tsu gba̱ɗa̱ ta̱ a kapala ka ne</para>
  <para style="q2" vid="NAM 1:5">aga̱la̱la̱ kpam a tsu dara̱kpa ta̱.</para>
  <para style="q1" vid="NAM 1:5">Uyamba u gba̱ɗa̱ a kapala ka ne,</para>
  <para style="q2" vid="NAM 1:5">likimba n gba̱ n ili iꞌya iꞌa̱ri pini a asuvu i giruwa̱ ta̱.<verse eid="NAM 1:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="NAM 1:6" />Ya wa fuɗa wa shamgba a kapala ka ne u yan baci upan?</para>
  <para style="q2" vid="NAM 1:6">Ya wa fuɗa u kawunku n upan u shen u ne?</para>
  <para style="q1" vid="NAM 1:6">Upan u ne wa̱ ta̱ shen yavu akina;</para>
  <para style="q2" vid="NAM 1:6">atali a tsu yuruwa ta̱ a kapala ka ne yuku-yuku.<verse eid="NAM 1:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="NAM 1:7" />Magono ma Zuba ma̱ ta̱ ukuna u shinga,</para>
  <para style="q2" vid="NAM 1:7">eyi asu u ukpawan ɗa aꞌayin a upana a ikyamba.</para>
  <para style="q2" vid="NAM 1:7">U tsu kirana ta̱ n aza ɗa a kpawain a asu u ne.<verse eid="NAM 1:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="NAM 1:8" />Shegai yavu uwayi u mini ma kushiva̱</para>
  <para style="q2" vid="NAM 1:8">ɗa wa tuko makorishi ma Niniba gba̱;</para>
  <para style="q2" vid="NAM 1:8">wa loko ta̱ atokulalu a ne a ubana a karimbi.<verse eid="NAM 1:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="NAM 1:9" />Ndya iꞌa̱ri ufoɓuso a kaci ka Magono ma Zuba?</para>
  <para style="q2" vid="NAM 1:9">Ko ndya baci wa, wa tuko ta̱ iꞌya gba̱ a makorishi;</para>
  <para style="q2" vid="NAM 1:9">uza u tsu yan tsilala n eyi hal kure wa.<verse eid="NAM 1:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="NAM 1:10" />Atokulalu a ne aꞌa̱ ta̱ yavu awana a ɗa a ɓolomgbonoi,</para>
  <para style="q2" vid="NAM 1:10">yavu asoi a ɗa a gutukpai a ka wala n a rukpusi,</para>
  <para style="q2" vid="NAM 1:10">a ka runukpa le ta̱ gba̱ yavu mete ma ekpi.<verse eid="NAM 1:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="NAM 1:11" />Asuvu a vunu, Niniba uza roku wa wuta̱ ta̱</para>
  <para style="q2" vid="NAM 1:11">uza ɗa u foɓusukoi Magono ma Zuba tsicingi</para>
  <para style="q2" vid="NAM 1:11">u na̱ka̱ adooki a cingi.<verse eid="NAM 1:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="NAM 1:12" />Ili iꞌya Magono ma Zuba ma danai iꞌya na:</para>
  <para style="q1" vid="NAM 1:12">&lt;&lt;Ko an u wokoi aza a Asiriya aꞌa̱ri ushani kpam n ucira,</para>
  <para style="q2" vid="NAM 1:12">a ka wacinsa le ta̱ kpam a wuna le.</para>
  <para style="q1" vid="NAM 1:12">Ko an u wokoi n yan vu ta̱ mavura, avu Yahuda,</para>
  <para style="q2" vid="NAM 1:12">ma doku kpam ma yan vu mavura wa.<verse eid="NAM 1:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="NAM 1:13" />Gogo-na ma koɗo ta̱ maɗanga ma kulima ma a taɗangi a udyoku u vunu,</para>
  <para style="q2" vid="NAM 1:13">n kiɗa̱sa kpam ikani iꞌya a sira̱sa vu n iꞌya.&gt;&gt;<verse eid="NAM 1:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="NAM 1:14" />Ili iꞌya Magono ma Zuba ma danai a kaci ka vunu Niniba iꞌya na:</para>
  <para style="q2" vid="NAM 1:14">&lt;&lt;Va doku va tsa̱ra̱ mmuku n tsikaya aza ɗa a ka wushuku kala ka vunu wa.</para>
  <para style="q1" vid="NAM 1:14">Ma wacinsa ta̱ gba̱ ameli a vunu, hal n ameli a urim a ɗa vu dara̱kpusai</para>
  <para style="q2" vid="NAM 1:14">a ɗa aꞌa̱ri a kunu ka ameli a vunu.</para>
  <para style="q1" vid="NAM 1:14">Ma foɓusuko vu ta̱ kasaun,</para>
  <para style="q2" vid="NAM 1:14">kpaci va̱ra̱ n kalen wa.&gt;&gt;<verse eid="NAM 1:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="NAM 1:15" />Wundya, uza ɗa wa tuko kadyanshi</para>
  <para style="q2" vid="NAM 1:15">ka shinga ki wa wala a zuba u nsasa,</para>
  <para style="q2" vid="NAM 1:15">uza u ɗa wa yan kalamu ka ndishi n shinga!<note caller="+" style="f"><char style="fr" closed="false">1:15 </char><char style="ft" closed="false">Kondo: </char><char style="xt" closed="false"><ref loc="ISA 52:7">Isha 52:7</ref></char></note></para>
  <para style="q1" vid="NAM 1:15">Kirana n abiki a vunu Yahuda,</para>
  <para style="q2" vid="NAM 1:15">kpam vu shaɗangu utsina u vunu.</para>
  <para style="q1" vid="NAM 1:15">Aza a cingi a ka doku a ka tuko vu kuvon wa;</para>
  <para style="q2" vid="NAM 1:15">a ka wacinsa le ta̱ gba̱.<verse eid="NAM 1:15" /></para>
  <chapter eid="NAM 1" />
  <chapter number="2" style="c" sid="NAM 2" />
  <para style="s">Niniba wa rukpa̱ ta̱</para>
  <para style="q1">
    <verse number="1" style="v" sid="NAM 2:1" />Utokulalu u vunu u ꞌya̱nga̱sa̱ka̱ vu ɗe, avu Niniba,</para>
  <para style="q2" vid="NAM 2:1">zuwa awundi a asaga a pige a ilyuci i vunu, awundi ure,</para>
  <para style="q2" vid="NAM 2:1">foɓuso kaci ka vunu adama a kuvon,</para>
  <para style="q2" vid="NAM 2:1">ɓolomgbono gba̱ avonshi a vunu!<verse eid="NAM 2:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="NAM 2:2" />Kpaci Magono ma Zuba ma gonuko ta̱ karinga̱ ka Yahuda</para>
  <para style="q2" vid="NAM 2:2">yavu ka aza a Isaraꞌila,</para>
  <para style="q1" vid="NAM 2:2">ko an u wokoi atokulalu a nangasai u ɗa u wokoi bawu kalen</para>
  <para style="q2" vid="NAM 2:2">kpam a nangasai atyangi a atyaci a le.<verse eid="NAM 2:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="NAM 2:3" />Nra̱ga̱ ma avonshi a utokulalu yi n shili n ɗa;</para>
  <para style="q2" vid="NAM 2:3">avonshi a ne aminya a mini ma ma iyen ma a ukai.</para>
  <para style="q1" vid="NAM 2:3">Nringongo ma urim ma adoki a le ma laɗa</para>
  <para style="q2" vid="NAM 2:3">kain ka a foɓuso le;</para>
  <para style="q2" vid="NAM 2:3">aꞌa̱ri ura̱ɗugbusa̱ nsari n le.<verse eid="NAM 2:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="NAM 2:4" />Adoki a ɗa aꞌa̱ri na̱ nringongo ma adoki aꞌa̱ri ilyaɗi cika a ure,</para>
  <para style="q2" vid="NAM 2:4">aꞌa̱ri a ubana n agoni ko nte wa a asuvu a akura̱ a ilyuci yi.</para>
  <para style="q1" vid="NAM 2:4">A ka wakana̱sa yavu akina a macikalu;</para>
  <para style="q2" vid="NAM 2:4">a ka wurusa yavu ulaɗa.<verse eid="NAM 2:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="NAM 2:5" />Magono ma Niniba ma isa̱i azapige a asoje a ne,</para>
  <para style="q2" vid="NAM 2:5">gba̱ n nala a ta̱ɗa̱tsa̱i a ure.</para>
  <para style="q1" vid="NAM 2:5">Aꞌa̱ri maloko a ubana a asu u asaga a ilyuci yi;</para>
  <para style="q2" vid="NAM 2:5">a zuwai nra̱ga̱ n ɗa ma ka̱nga̱ le a asu vi.<verse eid="NAM 2:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="NAM 2:6" />A kara̱kpai ure u mini</para>
  <para style="q2" vid="NAM 2:6">aku kuwa ku tsugono ku wa̱sa̱i.<verse eid="NAM 2:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="NAM 2:7" />A foɗoi aminya a uka u magono</para>
  <para style="q2" vid="NAM 2:7">a lazai n eyi.</para>
  <para style="q1" vid="NAM 2:7">Nkere n ɗa ma̱ri agbashi a ka yan ulapa u una̱</para>
  <para style="q2" vid="NAM 2:7">a ka sa̱ yavu aꞌaɗya</para>
  <para style="q2" vid="NAM 2:7">a ka lapusa akamba a le adama a unamgba u asuvu.<verse eid="NAM 2:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="NAM 2:8" />Niniba wa̱ ta̱ yavu kaɗa̱ka̱ ka mini,</para>
  <para style="q2" vid="NAM 2:8">kpam mini ma ne ma tsu wumkpa ta̱.</para>
  <para style="q1" vid="NAM 2:8">A ka dansa, &lt;&lt;Shamgba, shamgba!&gt;&gt;</para>
  <para style="q2" vid="NAM 2:8">shegai ko uza u kpatala kucina̱ wa.<verse eid="NAM 2:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="NAM 2:9" />Pura̱i azurufa n zinariya a asu u kuvon!</para>
  <para style="q2" vid="NAM 2:9">Kuwa ku ucanga u le ka̱ri n utyoku wa,</para>
  <para style="q2" vid="NAM 2:9">aꞌa̱ ta̱ gba̱ n utsa̱ri i icun kau-kau!<verse eid="NAM 2:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="NAM 2:10" />A wacinsai Niniba, a nangasa u ɗa u wokoi akpongo!</para>
  <para style="q2" vid="NAM 2:10">Atakasuvu a ama a dara̱kpai,</para>
  <para style="q1" vid="NAM 2:10">a ka jeke ikyamba, aꞌa̱ kpam n ucira wa</para>
  <para style="q2" vid="NAM 2:10">upetiwaꞌeshi u le u wa̱ra̱ma̱i.<verse eid="NAM 2:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="NAM 2:11" />Nte gogo-na kaɗa̱ka̱ ka igabako ka̱ri,</para>
  <para style="q2" vid="NAM 2:11">a asu u ɗa a ka lina̱ka mmuku n le,</para>
  <para style="q1" vid="NAM 2:11">a asu u ɗa agono n anuku a igabako a tsu bansa,</para>
  <para style="q2" vid="NAM 2:11">na̱ mmuku n le, a ka pana kpam uwonvo wa?<verse eid="NAM 2:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="NAM 2:12" />Gabako u tsu wuna ta̱ ili iꞌya i tsu rawa yi na̱ mmuku n ne</para>
  <para style="q2" vid="NAM 2:12">u piyanla kpam udyoku u manama mi u wuna,</para>
  <para style="q1" vid="NAM 2:12">aku u shaɗangu kaaɓuru ka ne n ili iꞌya u wunusai</para>
  <para style="q2" vid="NAM 2:12">kaɗa̱ka̱ ka ne kpam na̱ nnama n mete n ɗa a wunai.<verse eid="NAM 2:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="NAM 2:13" />Magono ma Zuba ma Ucira Gba̱ u danai,</para>
  <para style="q2" vid="NAM 2:13">&lt;&lt;Ma yan ta̱ tsilala n avu.</para>
  <para style="q1" vid="NAM 2:13">Ma runukpa ta̱ gba̱ nringongo ma adoki a vunu,</para>
  <para style="q2" vid="NAM 2:13">kpam burundu u kuvon wa wuna ta̱ asoje a vunu.</para>
  <para style="q2" vid="NAM 2:13">Ma ɓishinka vu ta̱ vu wuna ama a likimba.</para>
  <para style="q1" vid="NAM 2:13">Ala̱ga̱tsu a asuki a vunu</para>
  <para style="q2" vid="NAM 2:13">a ka doku a ka pana a ɗa wa.&gt;&gt;<verse eid="NAM 2:13" /></para>
  <chapter eid="NAM 2" />
  <chapter number="3" style="c" sid="NAM 3" />
  <para style="s">Ter u Niniba</para>
  <para style="q1">
    <verse number="1" style="v" sid="NAM 3:1" />Ter vunu ilyuci i uwotsongusu mpasa,</para>
  <para style="q2" vid="NAM 3:1">u ɗa u shaɗangi n kaɓan</para>
  <para style="q2" vid="NAM 3:1">n ucanga u ɗa a pura̱i a asu u kuvon!<verse eid="NAM 3:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="NAM 3:2" />Pana! Mawura̱ ma kajaɓu,</para>
  <para style="q2" vid="NAM 3:2">n mawura̱ ma nshingi ma nringongo ma adoki,</para>
  <para style="q1" vid="NAM 3:2">n tyoku ɗa adoki a tsu suma kuzugam-kuzugam</para>
  <para style="q2" vid="NAM 3:2">n ugba̱ɗa̱ u nringongo ma adoki!<verse eid="NAM 3:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="NAM 3:3" />Ayuwi adoki aꞌa̱ri a uyan kuvon,</para>
  <para style="q2" vid="NAM 3:3">iburundu iꞌa̱ri ulaɗa</para>
  <para style="q2" vid="NAM 3:3">nsari dem ma̱ri a ulaɗa!</para>
  <para style="q1" vid="NAM 3:3">Aza ɗa a kuwusa̱ alya pini ushani.</para>
  <para style="q2" vid="NAM 3:3">ikyamba ya akushe,</para>
  <para style="q1" vid="NAM 3:3">i wura ta̱ ukece,</para>
  <para style="q2" vid="NAM 3:3">ama aꞌa̱ri a uta̱ɗa̱tsa̱ a ikyamba i akushe.<verse eid="NAM 3:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="NAM 3:4" />Gba̱ nala gita̱ ta̱ an u wokoi Niniba kashankala,</para>
  <para style="q2" vid="NAM 3:4">kashankala ka shinga ka nala ka ka revei mayinsa̱ka̱, anuku a tsukunu,</para>
  <para style="q1" vid="NAM 3:4">uza u ɗa u yinsa̱i kakuma̱ ka ama n tsishankala tsu ne a woko agbashi,</para>
  <para style="q2" vid="NAM 3:4">ama kpam n tsuboci tsu ne.<verse eid="NAM 3:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="NAM 3:5" />Magono ma Zuba ma Ucira Gba̱ u danai,</para>
  <para style="q2" vid="NAM 3:5">&lt;&lt;Ma yan ta̱ tsilala n avu.</para>
  <para style="q1" vid="NAM 3:5">Ma filikpa̱ ta̱ mafatari ma vunu n pala upetiwaꞌeshi a vunu.</para>
  <para style="q2" vid="NAM 3:5">Kakuma̱ ka ama a ka wene vu ta̱ kataɓa</para>
  <para style="q2" vid="NAM 3:5">kpam tsugono tsa wene ta̱ uwono u vunu.<verse eid="NAM 3:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="NAM 3:6" />Ma tsunku va̱ ta̱ ili i icaɗi,</para>
  <para style="q2" vid="NAM 3:6">n yan ka vu ili iꞌya bawu i gain,</para>
  <para style="q2" vid="NAM 3:6">n gonuko vu ili i magori.<verse eid="NAM 3:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="NAM 3:7" />Gba̱ uza ɗa baci dem u wene vu, wa suma ta̱, aku u dana,</para>
  <para style="q2" vid="NAM 3:7">&lt;Niniba u woko ɗe kakpongo, ya wa sa̱ka̱ yi?&gt;</para>
  <para style="q2" vid="NAM 3:7">An te ma tsa̱ra̱ uza ɗa wa ta̱na̱sa̱ vu katakasuvu?&gt;&gt;<verse eid="NAM 3:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="NAM 3:8" />Avu vu la ilyuci i Tebesu ɗa,</para>
  <para style="q2" vid="NAM 3:8">u ɗa wa̱ri a ikengi i Aga̱ta̱ a Nilu,</para>
  <para style="q2" vid="NAM 3:8">u ɗa mini ma kyawain?</para>
  <para style="q1" vid="NAM 3:8">Aga̱ta̱ a ɗa asu u ka̱ngu u ne,</para>
  <para style="q2" vid="NAM 3:8">mini kpam kasaga ka ne.<verse eid="NAM 3:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="NAM 3:9" />Kushu n Masar ɗa ucira u ne u ɗa bawu wa̱ri n utyoku,</para>
  <para style="q2" vid="NAM 3:9">aku Putu n Libiya alya aɓa̱ngi a ne.<verse eid="NAM 3:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="NAM 3:10" />Gba̱ n nala a banka yi ta̱ tsuwula̱</para>
  <para style="q2" vid="NAM 3:10">a uyamba u tsumoci.</para>
  <para style="q1" vid="NAM 3:10">Hal gba̱m a gbashangusi mmuku n kenu n ne</para>
  <para style="q2" vid="NAM 3:10">a nsandu ma ure gba̱.</para>
  <para style="q1" vid="NAM 3:10">A varanku ta̱ azapige a ne uruta̱,</para>
  <para style="q2" vid="NAM 3:10">aku a sa̱ra̱sai gba̱ azapige a ne n ikani.<verse eid="NAM 3:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="NAM 3:11" />Avu dem Niniba va so ta̱ vu gutukpa;</para>
  <para style="q2" vid="NAM 3:11">va zama ta̱ asu u ɗa va kpawan</para>
  <para style="q2" vid="NAM 3:11">aku vu boli asu u ɗa va kpawan a asu u utokulalu u vunu.<verse eid="NAM 3:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="NAM 3:12" />Gba̱ ilyuci i vunu iꞌya a kanzai n asaga a pige aꞌa̱ ta̱ yavu nɗanga n kapopi</para>
  <para style="q2" vid="NAM 3:12">n ilimaci i kagita̱ i le;</para>
  <para style="q1" vid="NAM 3:12">aꞌayin a ɗa baci a za̱nga̱ta̱i iꞌya,</para>
  <para style="q2" vid="NAM 3:12">ilimaci i le i tsu rukpa̱ ta̱ a una̱ a aza ɗa a ka takuma.<verse eid="NAM 3:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="NAM 3:13" />Weɓele asoje a vunu,</para>
  <para style="q2" vid="NAM 3:13">a woko ɗe yavu aka!</para>
  <para style="q1" vid="NAM 3:13">Itsutsu i iyamba i vunu a giduwa̱ ta̱ iꞌya cika adama atokulalu a vunu;</para>
  <para style="q2" vid="NAM 3:13">akina kpam a ka lya ta̱ nɗanga ma uguramgbana ma itsutsu i vunu.<verse eid="NAM 3:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="NAM 3:14" />Kene mini kpaci a ka kyawan vu ta̱ n kuvon,</para>
  <para style="q2" vid="NAM 3:14">yan ucira u ɗa va ka̱ngu kaci ka vunu!</para>
  <para style="q1" vid="NAM 3:14">Doku ucira u asaga a vunu,</para>
  <para style="q2" vid="NAM 3:14">deshinku cin tsi vu yain aɓuku,</para>
  <para style="q2" vid="NAM 3:14">aku vu fuɓuso a ɗa adama a kuma!<verse eid="NAM 3:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="NAM 3:15" />Gba̱ n nala, akina a ɗa a ka runukpa vu;</para>
  <para style="q2" vid="NAM 3:15">burundu kpam u wuna vu</para>
  <para style="q2" vid="NAM 3:15">tyoku u acu u ɗa wa lya vu.</para>
  <para style="q1" vid="NAM 3:15">Vu doku ta̱ kakuma̱ ka vunu yavu acu,</para>
  <para style="q2" vid="NAM 3:15">vu yain kpam kakuma̱ yavu abaruma!<verse eid="NAM 3:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="NAM 3:16" />Vu doku ta̱ kakuma̱ ka aza a tsilaga tsu vunu</para>
  <para style="q2" vid="NAM 3:16">hal gba̱m a lai atala a zuba,</para>
  <para style="q1" vid="NAM 3:16">shegai aꞌa̱ ta̱ yavu acu a ɗa a tsu takuma ili gba̱</para>
  <para style="q2" vid="NAM 3:16">aku kpam a imkpa a laza.<verse eid="NAM 3:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="NAM 3:17" />Awundi a vunu aꞌa̱ ta̱ yavu acu,</para>
  <para style="q2" vid="NAM 3:17">azapige a vunu aꞌa̱ ta̱ yavu kakuma̱ ka acu</para>
  <para style="q2" vid="NAM 3:17">aza a ɗa a rukpusa̱i a asaga aꞌayin a kuta̱nu,</para>
  <para style="q1" vid="NAM 3:17">shegai kaara ka wuta̱ baci a tsu imkpa ta̱,</para>
  <para style="q2" vid="NAM 3:17">kpam vuma reve asu u ɗa a banai wa.<verse eid="NAM 3:17" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" sid="NAM 3:18" />Avu magono ma Asiriya, aliniki a vunu a ka gbaɗiga ɗe</para>
  <para style="q2" vid="NAM 3:18">azapige a vunu a vakusu ɗe a ka wunvugusa.</para>
  <para style="q1" vid="NAM 3:18">Ama a vunu a wacuwa ɗe a nsasa</para>
  <para style="q2" vid="NAM 3:18">kpam uza wa̱ la wa ɓolomgbono le wa.<verse eid="NAM 3:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="NAM 3:19" />Ili iꞌa̱ la ya zuwa usa̱n u vunu u yain shana wa;</para>
  <para style="q2" vid="NAM 3:19">usa̱n vunu wa ta̱na̱ wa.</para>
  <para style="q1" vid="NAM 3:19">Gba̱ uza ɗa baci dem u panai ukuna u wacinsa u vunu</para>
  <para style="q2" vid="NAM 3:19">wa ɓasa ta̱ akere adama a maza̱nga̱,</para>
  <para style="q1" vid="NAM 3:19">kpaci ya bawu u panai ikyamba</para>
  <para style="q2" vid="NAM 3:19">a tsicingi tsu vunu tsa bawu tsa̱ri n utyoku?<verse eid="NAM 3:19" /></para>
  <chapter eid="NAM 3" />
</usx>