<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="MIC" style="id">- Tsikimba</book>
  <para style="h">Mika</para>
  <para style="toc1">Tagara̱da u Mika</para>
  <para style="toc2">Mika</para>
  <para style="toc3">Mik</para>
  <para style="mt2">Tagara̱da u</para>
  <para style="mt1">Mika</para>
  <chapter number="1" style="c" sid="MIC 1" />
  <para style="p">
    <verse number="1" style="v" sid="MIC 1:1" />Kadyanshi ka Magono ma Zuba ka tuwa̱i ara Mika matsumate vuma u Moreshetu a kaci ka kuwene ka u wenei a kaci ka ilyuci i Samariya n Urishelima, a'ayin a ɗa Jotam n Ahazu n Hazakaya a ka lya tsugono tsu Yahuda.<note caller="+" style="f"><char style="fr" closed="false">1:1 </char><char style="ft" closed="false">Kondo: </char><char style="xt" closed="false"><ref loc="2KI 15:32-38">2 Ngo 15:32-38</ref>; <ref loc="2CH 27:1-9">2 Alb 27:1-9</ref>; <ref loc="2KI 16:1-20">2 Ngo 16:1-20</ref>; <ref loc="2CH 28:1-27">2 Alb 28:1-27</ref>; <ref loc="2KI 18:1-20:21">2 Ngo 18:1--20:21</ref>; <ref loc="2CH 29:1-32:33">2 Alb 29:1--32:33</ref></char></note><verse eid="MIC 1:1" /></para>
  <para style="s">Ushipa u ulapa u una̱ adama a Samariya n Urishelima</para>
  <para style="q1">
    <verse number="2" style="v" sid="MIC 1:2" />Panai na gba̱ ɗe, kakuma̱ ka ama,</para>
  <para style="q2" vid="MIC 1:2">panai na, gba̱ aza ɗa a'a̱ri a likimba!</para>
  <para style="q1" vid="MIC 1:2">A̱sa̱ka̱ Magono ma Zuba Uzapige</para>
  <para style="q2" vid="MIC 1:2">n kaci ne u woko uza ɗa</para>
  <para style="q2" vid="MIC 1:2">wenei ukuna vi a kaci ka ɗe,</para>
  <para style="q1" vid="MIC 1:2">panai kadyanshi ka ne ka ka wuta̱</para>
  <para style="q2" vid="MIC 1:2">a kuwa ka uwulukpi ka ne.<verse eid="MIC 1:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="MIC 1:3" />Weɓelei! Magono ma Zuba ma wuta̱</para>
  <para style="q2" vid="MIC 1:3">a asu u ndishi n ne wa tuwa̱,</para>
  <para style="q1" vid="MIC 1:3">wa tuwa̱ ta̱ iyamba</para>
  <para style="q2" vid="MIC 1:3">u wala a bilibili u nsasa n likimba.<verse eid="MIC 1:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="MIC 1:4" />Nsasa ma dara̱kpa ta̱ a kere ku ne</para>
  <para style="q2" vid="MIC 1:4">ara̱ra̱ kpam a ka ɓatsa ta̱ kure.</para>
  <para style="q1" vid="MIC 1:4">Nsasa kpam ma dara̱kpa ta̱</para>
  <para style="q2" vid="MIC 1:4">yavu akawa a ishigi a asuvu a akina,</para>
  <para style="q1" vid="MIC 1:4">yavu mini ma ma yene</para>
  <para style="q2" vid="MIC 1:4">a kakonguro ubana a asu u ara̱ra̱.<verse eid="MIC 1:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="MIC 1:5" />Gba̱ nala vi wa gita̱ ta̱</para>
  <para style="q2" vid="MIC 1:5">na̱ mmuku n tsikaya n Yakubu,</para>
  <para style="q1" vid="MIC 1:5">wata, aza a Isara'ila an a yain</para>
  <para style="q2" vid="MIC 1:5">unyushi u cingi kpam a 'ya̱nga̱sa̱ka̱i Kashila̱.</para>
  <para style="q1" vid="MIC 1:5">Ya zuwai Yakubu yain unyushi u cingi?</para>
  <para style="q2" vid="MIC 1:5">Aza a Samariya a ɗa, ilyuci i pige i ne!</para>
  <para style="q1" vid="MIC 1:5">Nte ɗa a asu u ulyasa̱ka ameli kayala a Yahuda?</para>
  <para style="q2" vid="MIC 1:5">Urishelima ɗa n kaci ka ne!<verse eid="MIC 1:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="MIC 1:6" />Magono ma Zuba ma danai,</para>
  <para style="q2" vid="MIC 1:6">&lt;&lt;Adama a nala ma wacinsa ta̱ Samariya</para>
  <para style="q2" vid="MIC 1:6">u woko akpongo hal u woko agbaji,</para>
  <para style="q2" vid="MIC 1:6">asu u ɗa a ka shigbusa̱ ashina a cinwi.</para>
  <para style="q1" vid="MIC 1:6">Ma wacinsa ta̱ atali a kuma ki a asuvu a kara̱ra̱,</para>
  <para style="q2" vid="MIC 1:6">n muɗa̱gbusa̱ kpam atali a kami ka kuma ku ne.<verse eid="MIC 1:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="MIC 1:7" />Gba̱ ameli a ne a ka ta̱sa̱sa̱ ta̱ a ɗa yuku-yuku;</para>
  <para style="q2" vid="MIC 1:7">gba̱ kune ka a tukusoi a kuwa ku ameli ku ne</para>
  <para style="q2" vid="MIC 1:7">a ka runukpa ta̱ ka n akina;</para>
  <para style="q2" vid="MIC 1:7">ma wacinsa ta̱ gba̱ a'ulu a ne.</para>
  <para style="q1" vid="MIC 1:7">An u wokoi u ɓolomgbonoi kune ku ne</para>
  <para style="q2" vid="MIC 1:7">a asu u katsupi ka tsu tsishankala,</para>
  <para style="q2" vid="MIC 1:7">a asu u tsishankala ɗa kpam ka kotso.&gt;&gt;<verse eid="MIC 1:7" /></para>
  <para style="s">Kushen ku Mika adama aza a Isara'ila n Yakubu</para>
  <para style="q1">
    <verse number="8" style="v" sid="MIC 1:8" />Adama a nala ma sa̱ ta̱,</para>
  <para style="q2" vid="MIC 1:8">n yain ndishi ma ulapa una̱;</para>
  <para style="q2" vid="MIC 1:8">ma foɗo ta̱ aminya</para>
  <para style="q2" vid="MIC 1:8">n tambi kataɓa kpam bawu akpata.</para>
  <para style="q1" vid="MIC 1:8">Ma wura̱ ta̱ yavu nshe n kakamba</para>
  <para style="q2" vid="MIC 1:8">n sa̱i yavu makuɓi.<verse eid="MIC 1:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="MIC 1:9" />Kpaci usa̱n u Samariya</para>
  <para style="q2" vid="MIC 1:9">usa̱n u ɗa bawu wa ta̱na̱.</para>
  <para style="q1" vid="MIC 1:9">U tambura ɗe hal a Yahuda,</para>
  <para style="q2" vid="MIC 1:9">u rawa ɗe a ilyuci i ama a va̱,</para>
  <para style="q2" vid="MIC 1:9">wata Urishelima dem.<verse eid="MIC 1:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="MIC 1:10" />Kotsu i tonuko atokulalu a tsunu a Gatu wa;</para>
  <para style="q2" vid="MIC 1:10">kotsu kpam i sa̱i wa ko kenu.</para>
  <para style="q1" vid="MIC 1:10">A Bete-leyafara ɗa ya gandala̱sa a iyamba.<note caller="+" style="f"><char style="fr" closed="false">1:10 </char><char style="ft" closed="false">Mika matsumate u yan ta̱ kadyanshi a kaci ka ilyuci ushani i'ya atokulalu a ka lya a ka tuwa̱ baci a Urishelima a lyai u ɗa. A makpa̱nda̱ ma na mi (10-15), Mika yanka ta̱ idyani i'ya i'a̱ri evu n a'ala a ilyuci yi tsa̱ra̱ u wenike ilyuci i'ya atokulalu yi a ka lya n kuvon.</char></note><verse eid="MIC 1:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="MIC 1:11" />Aza a Shafiru, banai tsuwula̱,</para>
  <para style="q2" vid="MIC 1:11">i wala kataɓa n uwono.</para>
  <para style="q1" vid="MIC 1:11">Aza a ɗa i'a̱ri ndishi a Za'ana a ka wuta̱ wa.</para>
  <para style="q2" vid="MIC 1:11">Aza a Bete-ezelu a'a̱ ta̱ a asuvu a ulapa u una̱</para>
  <para style="q2" vid="MIC 1:11">kpaci a tsa̱ra̱ u ɓa̱nga̱ a asu u le wa.<verse eid="MIC 1:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="MIC 1:12" />Aza a ɗa a'a̱ri ndishi a Marotu</para>
  <para style="q2" vid="MIC 1:12">a ka vana tsa̱ra̱ a tsa̱ra̱ ili i shinga,</para>
  <para style="q1" vid="MIC 1:12">shegai Magono ma Zuba</para>
  <para style="q2" vid="MIC 1:12">ma zuwai mada̱ka̱ ma rukpa̱i a utsutsu u Urishelima.<verse eid="MIC 1:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="MIC 1:13" />Eɗa̱ aza a ɗa i'a̱ri ndishi a Lakishi,</para>
  <para style="q2" vid="MIC 1:13">foɓusoi nringongo ma adoki n ɗe, tsa̱ra̱ i suma.</para>
  <para style="q1" vid="MIC 1:13">Kpaci eɗa ilyuci i kagita̱ a Yahuda</para>
  <para style="q2" vid="MIC 1:13">i tonoi aza a Isara'ila a asu u 'ya̱nga̱sa̱ka̱ u le,</para>
  <para style="q2" vid="MIC 1:13">i zuwai kpam aza a Sihiyona a yain unyushi u cingi.<verse eid="MIC 1:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="MIC 1:14" />Adama a nala, aza a Yahuda</para>
  <para style="q2" vid="MIC 1:14">tonukoi aza a Moreshetu-gatu</para>
  <para style="q2" vid="MIC 1:14">u yan tsu ben i na̱ka̱ le kune.</para>
  <para style="q1" vid="MIC 1:14">Ngono ma Isara'ila a ka pityanangu ta̱</para>
  <para style="q2" vid="MIC 1:14">n ilyuci i Akiziba</para>
  <para style="q2" vid="MIC 1:14">shegai a ka tsa̱ra̱ u ɓa̱nga̱ wa.<verse eid="MIC 1:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="MIC 1:15" />Mpa Magono ma Zuba n danai,</para>
  <para style="q2" vid="MIC 1:15">eɗa̱ aza ɗa i'a̱ri ndishi a Maresha</para>
  <para style="q2" vid="MIC 1:15">ma doku ta̱ ma tuko uza ɗa wa lya ɗa̱ n kuvon.</para>
  <para style="q1" vid="MIC 1:15">Azapige a Isara'ila</para>
  <para style="q2" vid="MIC 1:15">a ka suma ta̱ ubana a Adulam.<verse eid="MIC 1:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="MIC 1:16" />Punai a'aci a ɗe asuvu a ulapa u una̱</para>
  <para style="q2" vid="MIC 1:16">adama a mmuku n ɗe aza ɗa ya ciga;</para>
  <para style="q1" vid="MIC 1:16">gonukoi kaci ka ɗe yavu kukpani ka kasakali,</para>
  <para style="q2" vid="MIC 1:16">kpaci mmuku n ɗe a ka laza ta̱ tsuwula̱.<verse eid="MIC 1:16" /></para>
  <chapter eid="MIC 1" />
  <chapter number="2" style="c" sid="MIC 2" />
  <para style="s">Ter ɗe aza u 'yankusu aza a unambi</para>
  <para style="q1">
    <verse number="1" style="v" sid="MIC 2:1" />Ter ɗe aza ɗa a tsu foɓuso tsicingi,</para>
  <para style="q2" vid="MIC 2:1">aza ɗa kpam a tsu foɓuso</para>
  <para style="q2" vid="MIC 2:1">ukuna u cingi a ivamkpatsu i le!</para>
  <para style="q1" vid="MIC 2:1">Kain ka wansa baci a tsu yan ta̱ i'ya a foɓusoi vi,</para>
  <para style="q2" vid="MIC 2:1">kpaci n ucira u le ɗa a tsu fuɗa ta̱ yain i'ya.<verse eid="MIC 2:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="MIC 2:2" />A tsu yan ta̱ maluwa ma gbani</para>
  <para style="q2" vid="MIC 2:2">n ashina n ama, a wusa a ɗa.</para>
  <para style="q1" vid="MIC 2:2">A tsu yan ta̱ kpam maluwa ma gbani</para>
  <para style="q2" vid="MIC 2:2">n a'uwa a ama, a wusa a ɗa.</para>
  <para style="q2" vid="MIC 2:2">A tsu ryafa ta̱ ama tsa̱ra̱ a wusa a'uwa a le n iyamba i le.<verse eid="MIC 2:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MIC 2:3" />Adama a nala ili i'ya Magono ma Zuba ma danai i'ya na:</para>
  <para style="q1" vid="MIC 2:3">&lt;&lt;Ma foɓuso ta̱ uwacinsa a kaci ka ama yi,</para>
  <para style="q2" vid="MIC 2:3">ucun u ɗa bawu ya fuɗa ya wauwa kaci ka ɗe.</para>
  <para style="q1" vid="MIC 2:3">Ya doku ya wala n i yanyi ara̱ɗi wa,</para>
  <para style="q2" vid="MIC 2:3">kpaci wa woko ɗa̱ ta̱ a'ayin a mada̱ka̱.<verse eid="MIC 2:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="MIC 2:4" />A kain ka nala ki, ama a ka yanka ɗa̱ ta̱ majari,</para>
  <para style="q2" vid="MIC 2:4">a ka yanka ɗa̱ ta̱ majari a shipuka ɗa̱</para>
  <para style="q2" vid="MIC 2:4">ushipa u unamgbukatsuma̱, a dana,</para>
  <para style="q1" vid="MIC 2:4">&lt;A nangasa tsu ɗe gba̱!</para>
  <para style="q2" vid="MIC 2:4">Magono ma Zuba ma wusa ɗe uyamba u tsunu!</para>
  <para style="q2" vid="MIC 2:4">U na̱ka̱i ashina a tsunu a asu u aza a ɗa a yinsa̱ tsu.&gt; &gt;&gt;<verse eid="MIC 2:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="MIC 2:5" />Adama a nala, a'ayin a tuwa̱ baci</para>
  <para style="q2" vid="MIC 2:5">a ɗa a ka gonuko uyamba vi</para>
  <para style="q2" vid="MIC 2:5">a asu u ama a Magono ma Zuba,</para>
  <para style="q1" vid="MIC 2:5">ko uza u te asuvu a ɗe</para>
  <para style="q2" vid="MIC 2:5">wa̱ri n kapeci pini wa.<verse eid="MIC 2:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="MIC 2:6" />Ama ushani a danai,</para>
  <para style="q2" vid="MIC 2:6">&lt;&lt;Kotsu i yain kuɓari wa!</para>
  <para style="q1" vid="MIC 2:6">A̱sa̱ka̱ uyan kuɓari a kaci ka ili i nala yi,</para>
  <para style="q2" vid="MIC 2:6">ili i uwono i roku i'a̱ la ya gita̱ n a̱tsu wa.&gt;&gt;<verse eid="MIC 2:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="MIC 2:7" />Dere ɗa a dana nala, mmuku n tsikaya n Yakubu?</para>
  <para style="q2" vid="MIC 2:7">Ahankuri a Kulu ku Magono ma Zuba a gusa̱ ɗa?</para>
  <para style="q2" vid="MIC 2:7">Ko aya u yain ili i nala yi?</para>
  <para style="b" vid="MIC 2:7" />
  <para style="q1" vid="MIC 2:7">Kadyanshi ka Magono ma Zuba ka̱ri n kalen</para>
  <para style="q2" vid="MIC 2:7">a asu u uza ɗa wa tono yi n ukuna u maci wa?<verse eid="MIC 2:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="MIC 2:8" />Magono ma Zuba ma danai,</para>
  <para style="q2" vid="MIC 2:8">&lt;&lt;Shegai i tsu 'ya̱nga̱ ta̱ yavu atokulalu a asu u ama a va̱.</para>
  <para style="q1" vid="MIC 2:8">I tsu foɗo ta̱ ntogo ma aza ɗa a ka wura yaa,</para>
  <para style="q2" vid="MIC 2:8">aza ɗa a ka gono a asu u kuvon.<verse eid="MIC 2:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="MIC 2:9" />I tsu loko ta̱ aka a ama va̱</para>
  <para style="q2" vid="MIC 2:9">a wuta̱ a a'uwa a shinga a le.</para>
  <para style="q1" vid="MIC 2:9">I takpa kpam una̱ u shinga u va̱</para>
  <para style="q2" vid="MIC 2:9">a asu u mmuku n le ubana.<verse eid="MIC 2:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="MIC 2:10" />'Ya̱nga̱i, i laza!</para>
  <para style="q2" vid="MIC 2:10">Asu u na vi asu u uwunvuga u ɗe ɗa wa,</para>
  <para style="q1" vid="MIC 2:10">kpaci a zuwa ɗe asu vi u wokoi na̱ nshinda̱,</para>
  <para style="q2" vid="MIC 2:10">i nangasai u ɗa gba̱ gba̱.<verse eid="MIC 2:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="MIC 2:11" />Uza u kaɓan n uyinsa̱ u tuwa̱ baci u danai,</para>
  <para style="q2" vid="MIC 2:11">&lt;Ma yan ta̱ kuɓari a kaci ka mini ma cinwi</para>
  <para style="q2" vid="MIC 2:11">n ili i'ya ya zuwa ugutukpa ushani,&gt;</para>
  <para style="q2" vid="MIC 2:11">icun i uza u kuɓari u ɗa ama a ka ciga ɗa la vi!&gt;&gt;<verse eid="MIC 2:11" /></para>
  <para style="s">Kazuwamgbani ka uzuwa uma</para>
  <para style="q1">
    <verse number="12" style="v" sid="MIC 2:12" />Magono ma Zuba ma danai,</para>
  <para style="q2" vid="MIC 2:12">&lt;&lt;Mayun ma ɓolomgbono ɗa̱ ta̱ gba̱ ɗe,</para>
  <para style="q2" vid="MIC 2:12">mmuku n tsikaya n Yakubu;</para>
  <para style="q2" vid="MIC 2:12">ma ɓolomgbono ta̱ aza ɗa a buwai a Isara'ila.</para>
  <para style="q1" vid="MIC 2:12">Ma ɓolomgbono le ta̱ asu u te</para>
  <para style="q2" vid="MIC 2:12">yavu ncon a asu u ɗa a kanzai,</para>
  <para style="q2" vid="MIC 2:12">yavu ushiga u ncon a asu u kalina;</para>
  <para style="q2" vid="MIC 2:12">a woko kaɓolo ka pige ka ama.<verse eid="MIC 2:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="MIC 2:13" />Uza ɗa wa ɗapa kafon a kasaga, aya wa tono ta̱ n ele;</para>
  <para style="q2" vid="MIC 2:13">a ka ɓa̱tsa̱ ta̱ a utsutsu a laza.</para>
  <para style="q1" vid="MIC 2:13">Magono ma le ma uwa ta̱ a kapala ka le,</para>
  <para style="q2" vid="MIC 2:13">Magono ma Zuba ma ma tono n ele n kaci ka ne.&gt;&gt;<verse eid="MIC 2:13" /></para>
  <chapter eid="MIC 2" />
  <chapter number="3" style="c" sid="MIC 3" />
  <para style="s">Azapige a cingi n atsumate a kaɓan</para>
  <para style="q1">
    <verse number="1" style="v" sid="MIC 3:1" />Aku n danai,</para>
  <para style="q2" vid="MIC 3:1">&lt;&lt;Eɗa̱ azapige a mmuku n tsikaya n Yakubu, panai na,</para>
  <para style="q2" vid="MIC 3:1">aza ɗa ya lya tsugono tsu Isara'ila.</para>
  <para style="q1" vid="MIC 3:1">U gan ta̱ i reve n afada a a'a̱ri dere,<verse eid="MIC 3:1" /></para>
  <para style="q2">
    <verse number="2-3" style="v" sid="MIC 3:2-3" />eɗa̱ aza ɗa ya kovo ili i shinga aku ya ciga ukuna u cingi.</para>
  <para style="q1" vid="MIC 3:2-3">Ya muna ukpan u ikyamba u ama a va̱</para>
  <para style="q2" vid="MIC 3:2-3">n i kiɗa̱si inyama i ikyamba i le asuvu atele a le.</para>
  <para style="q1" vid="MIC 3:2-3">I koɗomgbonusoi kpam atele a le yuku-yuku,</para>
  <para style="q2" vid="MIC 3:2-3">i kiɗa̱sa i'ya yavu inyama aku i tsungu i'ya a magbodo</para>
  <para style="q2" vid="MIC 3:2-3">i takuma inyama i ama a va̱.<verse eid="MIC 3:2-3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="MIC 3:4" />Pini nala ya sa̱ka̱ ta̱ Magono ma Zuba tsa̱ra̱ u ɓa̱nga̱ ɗa̱,</para>
  <para style="q2" vid="MIC 3:4">shegai wa wushunku ɗa̱ wa.</para>
  <para style="q1" vid="MIC 3:4">A'ayin a nala ɗa wa sokongu upetiwa'eshi a ne a asu ɗe</para>
  <para style="q2" vid="MIC 3:4">adama ukuna u cingi u ɗa i yain.&gt;&gt;<verse eid="MIC 3:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="MIC 3:5" />Ili i'ya Magono ma Zuba ma danai i'ya na:</para>
  <para style="q1" vid="MIC 3:5">&lt;&lt;A kaci ka ntsumate</para>
  <para style="q2" vid="MIC 3:5">n ɗa ma puwusa̱n ama a va̱,</para>
  <para style="q1" vid="MIC 3:5">a tsu 'ya̱nga̱sa̱ ta̱ ala̱ga̱tsu a le a dansa &lt;Ukuna u ndishi n shinga,&gt;</para>
  <para style="q2" vid="MIC 3:5">a'a̱ baci n ilikulya i'ya a ka lya.</para>
  <para style="q1" vid="MIC 3:5">Shegai a tsu foɓuso ta̱ kuvon</para>
  <para style="q2" vid="MIC 3:5">a asu a aza ɗa bawu a na̱ka̱ le ili i roku.<verse eid="MIC 3:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="MIC 3:6" />Adama a nala, kayin ka tuwa̱ ɗa̱ ta̱, bawu kuwene,</para>
  <para style="q2" vid="MIC 3:6">n karimbi ka aza a ukonduso bawu a ka wene ili.</para>
  <para style="q1" vid="MIC 3:6">Eɗa̱ ntsumate, a'ayin a ɗe a ka kotsu ta̱ kpaci kaara ka rukpa̱ ɗa̱ ta̱,</para>
  <para style="q2" vid="MIC 3:6">kaara ka woko ɗa̱ ta̱ karimbi cika.<verse eid="MIC 3:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="MIC 3:7" />Aza a kuwene a ka yan ta̱ uwono</para>
  <para style="q2" vid="MIC 3:7">n aza a ukonduso a ka pana ta̱ uwono.</para>
  <para style="q1" vid="MIC 3:7">A ka kimba̱ ta̱ upetiwa'eshi a le</para>
  <para style="q2" vid="MIC 3:7">kpaci Kashila̱ ka wushunku le wa.&gt;&gt;<verse eid="MIC 3:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="MIC 3:8" />Shegai mpa, n ma̱ ta̱ ushaɗangi n ucira,</para>
  <para style="q2" vid="MIC 3:8">n Kulu ku Magono ma Zuba,</para>
  <para style="q2" vid="MIC 3:8">u yain afada a maci n ucira.</para>
  <para style="q1" vid="MIC 3:8">Ma tonuko ta̱ mmuku n tsikaya n Yakubu unyushi u cingi u le,</para>
  <para style="q2" vid="MIC 3:8">aza a Isara'ila kpam unyushi u le.<verse eid="MIC 3:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="MIC 3:9" />Panai na, eɗa̱ azapige a mmuku n tsikaya n Yakubu,</para>
  <para style="q2" vid="MIC 3:9">eɗa̱ aza ɗa ya lya tsugono tsu Isara'ila,</para>
  <para style="q1" vid="MIC 3:9">aza ɗa i ꞌyuwain afada a maci</para>
  <para style="q2" vid="MIC 3:9">i gonukoi ili i'ya i'a̱ri dere i wokoi i cingi.<verse eid="MIC 3:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="MIC 3:10" />I yain uboku n mawunuka i tsa̱ra̱i ikebe i i'ya i mai Sihiyona,</para>
  <para style="q2" vid="MIC 3:10">i mai kpam Urishelima n ukuna u cingi.<verse eid="MIC 3:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="MIC 3:11" />Eɗa̱ azapige a Urishelima i tsu wusha ta̱ ukimba̱ u una̱ adama a afada.</para>
  <para style="q2" vid="MIC 3:11">Eɗa̱ aɗara̱kpi ya wenishike mele ma Kashila̱ adama u zami ikebe,</para>
  <para style="q1" vid="MIC 3:11">eɗa̱ kpam ntsumate ya konduso ili i'ya ya tuwa̱ ya gita̱ adama ikebe.</para>
  <para style="q2" vid="MIC 3:11">Gba̱ n nala i pityanangi n Magono ma Zuba wa, i danai,</para>
  <para style="q1" vid="MIC 3:11">&lt;&lt;Mada̱ka̱ ma tuwa̱ a asu tsunu wa</para>
  <para style="q2" vid="MIC 3:11">kpaci Magono ma Zuba ma̱ ta̱ kaɓolo n a̱tsu.&gt;&gt;<verse eid="MIC 3:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="MIC 3:12" />Adama a nala</para>
  <para style="q2" vid="MIC 3:12">a ka lima ta̱ Sihiyona u woko kashina adama a ɗe,</para>
  <para style="q1" vid="MIC 3:12">Urishelima wa woko ta̱ akpongo,</para>
  <para style="q2" vid="MIC 3:12">masasa ma Kuwa ku Kashila̱ ka̱ri ma woko ta̱ kutsu.<note caller="+" style="f"><char style="fr" closed="false">3:12 </char><char style="ft" closed="false">Kondo: </char><char style="xt" closed="false"><ref loc="JER 26:18">Iri 26:18</ref></char></note><verse eid="MIC 3:12" /></para>
  <chapter eid="MIC 3" />
  <chapter number="4" style="c" sid="MIC 4" />
  <para style="s">Masasa ma Magono ma Zuba</para>
  <para style="r">(<ref loc="ISA 2:2-4">Isha 2:2-4</ref>)</para>
  <para style="q1">
    <verse number="1" style="v" sid="MIC 4:1" />A a'ayin a ɗa a ka tuwa̱</para>
  <para style="q2" vid="MIC 4:1">masasa ma Kuwa ku Kashila̱ ku Magono ma Zuba</para>
  <para style="q2" vid="MIC 4:1">ma woko ta̱ masasa ma ma lai karinga̱;</para>
  <para style="q1" vid="MIC 4:1">a ka ra̱ɗugba̱ ta̱ ma ma lai aga̱la̱la̱.</para>
  <para style="q2" vid="MIC 4:1">Ama a ushani a ka ta̱sa̱ ta̱ ubana pini tyoku u aga̱ta̱ a ɗa a ka yene.<verse eid="MIC 4:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="MIC 4:2" />Kakuma̱ ka ama ushani a ka tuwa̱ ta̱ a dana,</para>
  <para style="q1" vid="MIC 4:2">&lt;&lt;Tuwa̱i tsu banai a masasa ma Magono ma Zuba,</para>
  <para style="q2" vid="MIC 4:2">ubana a Kuwa ku Kashila̱ ku Yakubu.</para>
  <para style="q1" vid="MIC 4:2">Wa wenishike tsu ta̱ ire i ne,</para>
  <para style="q2" vid="MIC 4:2">tsu wala kpam a ure u ne.&gt;&gt;</para>
  <para style="q1" vid="MIC 4:2">Kpaci mele ma wuta̱ ta̱ a Sihiyona,</para>
  <para style="q2" vid="MIC 4:2">a Urishelima kpam kadyanshi ka</para>
  <para style="q2" vid="MIC 4:2">Magono ma Zuba ka tambura a ubana a asu u ama.<verse eid="MIC 4:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="MIC 4:3" />Wa yanka ta̱ ama ushani afada</para>
  <para style="q2" vid="MIC 4:3">kpam wa tuko ta̱ makorishi ma ibili</para>
  <para style="q2" vid="MIC 4:3">ma uyamba u ucira u ɗa wa̱ri mɓa̱ri.</para>
  <para style="q1" vid="MIC 4:3">A gonuko iburundu i le mberu ma ucimba,</para>
  <para style="q2" vid="MIC 4:3">asovu a le kpam mmuwun ma ugyara nɗanga.</para>
  <para style="q1" vid="MIC 4:3">Uyamba wa doku wa ra̱ɗugba̱ burundu</para>
  <para style="q2" vid="MIC 4:3">u ne a uyamba u roku wa,</para>
  <para style="q2" vid="MIC 4:3">kpam a ka doku a rotsongusu ure u kuvon wa.<note caller="+" style="f"><char style="fr" closed="false">4:3 </char><char style="ft" closed="false">Kondo: </char><char style="xt" closed="false"><ref loc="ISA 2:4">Isha 2:4</ref>; <ref loc="JOL 3:10">Juw 3:10</ref></char></note><verse eid="MIC 4:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="MIC 4:4" />Ya dem wa dusuku ta̱ yaa</para>
  <para style="q2" vid="MIC 4:4">u lyai ilimaci i katyaci ka cinwi</para>
  <para style="q2" vid="MIC 4:4">n maɗanga ma kapopi a kuwa ku ne.</para>
  <para style="q1" vid="MIC 4:4">Uza wa̱ la wa giruwusa̱ yi wa,</para>
  <para style="q2" vid="MIC 4:4">kpaci Magono ma Zuba ma Ucira Gba̱ aya u danai nala.<verse eid="MIC 4:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="MIC 4:5" />Ko an u wokoi gba̱ ama</para>
  <para style="q2" vid="MIC 4:5">ya dem wa tono ta̱ ameli a ne;</para>
  <para style="q2" vid="MIC 4:5">shegai a̱tsu tsa tono ta̱ Magono ma Zuba</para>
  <para style="q2" vid="MIC 4:5">Kashila̱ ka tsunu a ubana.<verse eid="MIC 4:5" /></para>
  <para style="s">Magono ma Zuba ma gonuko ta̱ ama a ne a kuwa</para>
  <para style="q1">
    <verse number="6" style="v" sid="MIC 4:6" />Magono ma Zuba ma danai, &lt;&lt;A kain ka nala ki,</para>
  <para style="q2" vid="MIC 4:6">ma ɓolomgbono ta̱ awunu,</para>
  <para style="q1" vid="MIC 4:6">aza ɗa n bankai tsuwula̱,</para>
  <para style="q2" vid="MIC 4:6">wata, aza ɗa n yain mavura.<verse eid="MIC 4:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="MIC 4:7" />Ma gonuko ta̱ awunu ama va̱ aza ɗa a buwai,</para>
  <para style="q2" vid="MIC 4:7">aza ɗa a lokoi kpam a woko kakuma̱ ka ama ka ucira.</para>
  <para style="q1" vid="MIC 4:7">Magono ma Zuba ma lya ta̱ tsugono</para>
  <para style="q2" vid="MIC 4:7">a kaci ka le a masasa ma Sihiyona</para>
  <para style="q2" vid="MIC 4:7">ili i'ya i bidyai a kain kala ki ubana.<verse eid="MIC 4:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="MIC 4:8" />Avu Urishelima, kunukuzuba ku uza u uwundya ushiga,</para>
  <para style="q2" vid="MIC 4:8">asu u kpawan u aza a Sihiyona,</para>
  <para style="q1" vid="MIC 4:8">asu u ɗe ɗa tsugono tsu cau tsa gono,</para>
  <para style="q2" vid="MIC 4:8">tsugono tsu nala tsi tsu ɗe tsa aza a Urishelima.&gt;&gt;<verse eid="MIC 4:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="MIC 4:9" />Ndya i zuwai gogo-na ya sa̱ cika,</para>
  <para style="q2" vid="MIC 4:9">i'a̱ri n magono wa ɗa?</para>
  <para style="q2" vid="MIC 4:9">Uza u na̱ka̱ adooki u ɗe u kuwa̱ ɗe ɗa?</para>
  <para style="q1" vid="MIC 4:9">Adama a nala ɗa i'a̱ri a asuvu a upana u ikyamba</para>
  <para style="q2" vid="MIC 4:9">yavu uka ɗa wa̱ri asuvu mɓa̱la̱ ma ilimaci.<verse eid="MIC 4:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="MIC 4:10" />Aza a Sihiyona, ikai n ucira,</para>
  <para style="q2" vid="MIC 4:10">yavu uka u ɗa wa̱ri nkuɗi ma ilimaci,</para>
  <para style="q1" vid="MIC 4:10">kpaci gogo-na u ka̱na̱ ta̱ i a̱sa̱ka̱ a ilyuci yi,</para>
  <para style="q2" vid="MIC 4:10">i bana i dusuku a kakura̱.</para>
  <para style="q1" vid="MIC 4:10">Ya bana ta̱ a Babila,</para>
  <para style="q2" vid="MIC 4:10">ɗe ɗa a ka wauwa ɗa̱.</para>
  <para style="q1" vid="MIC 4:10">Ɗe ɗa Magono ma Zuba ma wusa ɗa</para>
  <para style="q2" vid="MIC 4:10">a kukere ku atokulalu a ɗe.<verse eid="MIC 4:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="MIC 4:11" />Shegai gogo-na uyamba ushani</para>
  <para style="q2" vid="MIC 4:11">a ɓolomgbono ɗe a ka yan tsilala n a̱ɗa̱.</para>
  <para style="q1" vid="MIC 4:11">A dana, &lt;&lt;U ka̱na̱ ta̱ Urishelima u woko n nshinda̱!</para>
  <para style="q2" vid="MIC 4:11">A̱sa̱ka̱ tsu wene uwono u ilyuci yi.&gt;&gt;<verse eid="MIC 4:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="MIC 4:12" />Shegai a reve</para>
  <para style="q2" vid="MIC 4:12">uyanwusa u Magono ma Zuba n afoɓi a ne wa,</para>
  <para style="q1" vid="MIC 4:12">kpaci u ɓolomgbono le ta̱ yavu ndolu ma ilya,</para>
  <para style="q2" vid="MIC 4:12">ilya i'ya a bankai asu u ulapa u ilya.<verse eid="MIC 4:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="MIC 4:13" />Magono ma Zuba ma danai,</para>
  <para style="q2" vid="MIC 4:13">&lt;&lt;'Ya̱nga̱i i kpatsa uyamba, aza a Sihiyona!</para>
  <para style="q2" vid="MIC 4:13">Kpaci ma na̱ka̱ ɗa̱ ta̱ avana a urim,</para>
  <para style="q1" vid="MIC 4:13">a'ene a ɗe kpam a urim u shili,</para>
  <para style="q2" vid="MIC 4:13">adama ɗa i kpatsa uyamba ushani yuku-yuku.</para>
  <para style="q1" vid="MIC 4:13">Pini nala utsa̱ri u le u ɗa a bokoi</para>
  <para style="q2" vid="MIC 4:13">ya neke ta̱ u ɗa gba̱ a asu u Magono ma Zuba,</para>
  <para style="q2" vid="MIC 4:13">udukuyan u le kpam asu u Uzapige u likimba gba̱.&gt;&gt;<verse eid="MIC 4:13" /></para>
  <chapter eid="MIC 4" />
  <chapter number="5" style="c" sid="MIC 5" />
  <para style="q1">
    <verse number="1" style="v" sid="MIC 5:1" />Ɓolomgbono asoje a vunu, ilyuci i asoje,</para>
  <para style="q2" vid="MIC 5:1">kpaci a kyawan tsu ɗe n kuvon.</para>
  <para style="q1" vid="MIC 5:1">A ka lapa ta̱ tsugono tsa aza a Isara'ila</para>
  <para style="q2" vid="MIC 5:1">a kagbaguzu ka a ka lapa yi n kalangu.<verse eid="MIC 5:1" /></para>
  <para style="s">Kashila̱ ka yain kazuwamgbani a kaci ka magono ma ma wuta̱ a Batalami</para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="MIC 5:2" />Magono ma Zuba ma danai, &lt;&lt;Batalami Efurata,</para>
  <para style="q2" vid="MIC 5:2">avu ilyuci i kenu i'ya a asuvu a kumaci ku Yahuda.</para>
  <para style="q1" vid="MIC 5:2">Ma ɗanga̱sa ta̱ uza u te</para>
  <para style="q2" vid="MIC 5:2">a asuvu a ama a vunu u lyai tsugono tsu Isara'ila,</para>
  <para style="q2" vid="MIC 5:2">uza ɗa kagali ka ne ka̱ri tun caupa.&gt;&gt;<note caller="+" style="f"><char style="fr" closed="false">5:2 </char><char style="ft" closed="false">Kondo: </char><char style="xt" closed="false"><ref loc="MAT 2:6">Mat 2:6</ref>; <ref loc="JHN 7:42">Yah 7:42</ref></char></note><verse eid="MIC 5:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="MIC 5:3" />Adama a nala, Magono ma Zuba ma neke ta̱</para>
  <para style="q2" vid="MIC 5:3">aza a Isara'ila a asu u atokulalu a le,</para>
  <para style="q1" vid="MIC 5:3">hal she a'ayin a ɗa uka ɗa wa̱ri</para>
  <para style="q2" vid="MIC 5:3">asuvu nkuɗi ma ilimaci u matsai maku ma vali.</para>
  <para style="q1" vid="MIC 5:3">Aku atoku a ne aza ɗa a buwai</para>
  <para style="q2" vid="MIC 5:3">a ka gono a asu u aza a Isara'ila.<verse eid="MIC 5:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="MIC 5:4" />Wa shamgba ta̱ ulina̱ka ushiga u ne,</para>
  <para style="q2" vid="MIC 5:4">n ucira n kala ka tsupige ka</para>
  <para style="q2" vid="MIC 5:4">Magono ma Zuba Kashila̱ ka ne.</para>
  <para style="q1" vid="MIC 5:4">Ama a ne a ka rongo ta̱ mai,</para>
  <para style="q2" vid="MIC 5:4">kpaci ureve u tsupige tsu ne wa rawa ta̱</para>
  <para style="q2" vid="MIC 5:4">hal a makorishi ma likimba.<verse eid="MIC 5:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="MIC 5:5" />Wa zuwa ta̱ tsu tsa̱ra̱ ndishi n shinga,</para>
  <para style="q2" vid="MIC 5:5">a'ayin a ɗa baci aza a Asiriya a uwai asuvu</para>
  <para style="q2" vid="MIC 5:5">a uyamba u tsunu n kuvon,</para>
  <para style="q2" vid="MIC 5:5">a ka wala ta̱ asu u ukpawan u asaga a pige.</para>
  <para style="q1" vid="MIC 5:5">Tsa ɗanga̱sa ta̱ azapige a asoje ama shindere</para>
  <para style="q2" vid="MIC 5:5">hal gba̱m kulla̱ a yain tsilala n ele.<verse eid="MIC 5:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="MIC 5:6" />A ka lya ta̱ tsugono tsu Asiriya n burundu,</para>
  <para style="q2" vid="MIC 5:6">uyamba u Nimurodu kpam n iburundu i le ufoɓusi.</para>
  <para style="q1" vid="MIC 5:6">Wa wauwa tsu ta̱ a asu u aza a Asiriya</para>
  <para style="q2" vid="MIC 5:6">a'ayin a ɗa baci a pasai karen ka tsunu</para>
  <para style="q2" vid="MIC 5:6">a tukoi uyamba u tsunu kuvon<note caller="+" style="f"><char style="fr" closed="false">5:6 </char><char style="ft" closed="false">Kondo: </char><char style="xt" closed="false"><ref loc="GEN 10:8-11">Kag 10:8-11</ref></char></note>.<verse eid="MIC 5:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="MIC 5:7" />Pini nala ama a Yakubu a ɗa buwai</para>
  <para style="q2" vid="MIC 5:7">a ka dusuku ta̱ asuvu a kakuma̱ ka ama</para>
  <para style="q1" vid="MIC 5:7">yavu cinza tsa tsu wuta̱i a asu u Magono ma Zuba</para>
  <para style="q2" vid="MIC 5:7">yavu mini ma zuba ma ma rukpusa̱ a mete,</para>
  <para style="q1" vid="MIC 5:7">ma bawu ma vana uza</para>
  <para style="q2" vid="MIC 5:7">ko kpam u pityanangu n vuma.<verse eid="MIC 5:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="MIC 5:8" />Ama a Yakubu a ɗa buwai a ka dusuku ta̱ a asuvu a kakuma̱ ka ama,</para>
  <para style="q2" vid="MIC 5:8">a mere ma ama ushani</para>
  <para style="q1" vid="MIC 5:8">a ka woko ta̱ n ucira yavu gabako a mere ma nnama a kutsu,</para>
  <para style="q2" vid="MIC 5:8">yavu gabako asuvu a ishiga i nlala,</para>
  <para style="q1" vid="MIC 5:8">a'ayin a ɗa baci u raɗugi u uwai a mere ma le</para>
  <para style="q2" vid="MIC 5:8">uza wa̱ la wa wauwa le wa.<verse eid="MIC 5:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="MIC 5:9" />A ka 'ya̱nga̱sa̱ ta̱ akere a ɗe a kaci ka atokulalu a ɗe.</para>
  <para style="q2" vid="MIC 5:9">kpam atokulalu a ɗe a ka wacinsa le ta̱.<verse eid="MIC 5:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="MIC 5:10" />Magono ma Zuba ma danai, &lt;&lt;A kain ka nala ki,</para>
  <para style="q1" vid="MIC 5:10">ma wacinsa ta̱ adoki a ɗe</para>
  <para style="q2" vid="MIC 5:10">n nangasa kpam nringongo ma adoki a ɗe.<verse eid="MIC 5:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="MIC 5:11" />Ma wacinsa ta̱ ilyuci i uyamba u ɗe,</para>
  <para style="q2" vid="MIC 5:11">n wa̱sa̱sa̱ asaga ɗa a'a̱ri ukyawin n ilyuci i ɗe.<verse eid="MIC 5:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="MIC 5:12" />Ma tuko ta̱ makorishi ma aza a ada̱bu a uyamba u ɗe,</para>
  <para style="q2" vid="MIC 5:12">ya doku ya tsa̱ra̱ aza a ukonduso wa.<verse eid="MIC 5:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="MIC 5:13" />Ma wacinsa ta̱ ameli a ɗe</para>
  <para style="q2" vid="MIC 5:13">n atali a ulyasa̱ka ameli kayala a ɗe.</para>
  <para style="q1" vid="MIC 5:13">Ya doku ya kuɗa̱nku</para>
  <para style="q2" vid="MIC 5:13">ili i'ya i yain n akere a ɗe i lyaka le kayala wa.<verse eid="MIC 5:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="MIC 5:14" />Ma muɗusa̱ ta̱ ashamkpatsu a ameli a Ashera asuvu a ɗe,</para>
  <para style="q2" vid="MIC 5:14">n wacinsa kpam ilyuci i ɗe.<verse eid="MIC 5:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="MIC 5:15" />Ma yan ta̱ katsupi ka va̱ n asuvu a shen n upan</para>
  <para style="q2" vid="MIC 5:15">a asu u kakuma̱ ka ama a ɗa gba̱ a tsu ꞌyuwain ugorimuko mu.&gt;&gt;<verse eid="MIC 5:15" /></para>
  <chapter eid="MIC 5" />
  <chapter number="6" style="c" sid="MIC 6" />
  <para style="s">Magono ma Zuba ma sapulai aza a Isara'ila</para>
  <para style="p">
    <verse number="1" style="v" sid="MIC 6:1" />Aza a Isara'ila, panai ili i'ya Magono ma Zuba ma danai:</para>
  <para style="q1" vid="MIC 6:1">&lt;&lt;'Ya̱nga̱i, i dana usapula ɗe</para>
  <para style="q2" vid="MIC 6:1">a kapala ka nsasa,</para>
  <para style="q2" vid="MIC 6:1">a̱sa̱ka̱ aga̱la̱la̱ a pana ala̱ga̱tsu a ɗe.<verse eid="MIC 6:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="MIC 6:2" />Nsasa, panai usapula u Magono ma Zuba a kaci ka Isara'ila;</para>
  <para style="q2" vid="MIC 6:2">zuwai atsuvu i pana, eɗa̱ kami ka likimba tun caupa.</para>
  <para style="q1" vid="MIC 6:2">Panai! Kpaci Magono ma Zuba ma sapulai ama a ne,</para>
  <para style="q2" vid="MIC 6:2">wa̱ ta̱ n kadyanshi n Isara'ila.<verse eid="MIC 6:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="MIC 6:3" />&lt;&lt;Ama a va̱, ndya n yanka ɗa̱?</para>
  <para style="q2" vid="MIC 6:3">Niɗa n wokoi kala̱nda̱m a asu u ɗe? Tonuko na̱ mu!<verse eid="MIC 6:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="MIC 6:4" />N wutukpa̱ ɗa̱ a uyamba u Masar</para>
  <para style="q2" vid="MIC 6:4">a asuvu a tsugbashi, n wusa ɗa̱ kpam.</para>
  <para style="q1" vid="MIC 6:4">N suki Musa utuwa̱ u toni n a̱ɗa̱,</para>
  <para style="q2" vid="MIC 6:4">hal n Haruna n Mariya.<note caller="+" style="f"><char style="fr" closed="false">6:4 </char><char style="ft" closed="false">Kondo: </char><char style="xt" closed="false"><ref loc="EXO 12:50-51">Uwt 12:50-51</ref>; <ref loc="EXO 4:14-16">Uwt 4:14-16</ref>; <ref loc="EXO 15:20">Uwt 15:20</ref></char></note><verse eid="MIC 6:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="MIC 6:5" />Ama a va̱, ciɓai</para>
  <para style="q2" vid="MIC 6:5">ili i'ya Balaku magono ma Muwabu ma foɓusoi ma yain,</para>
  <para style="q2" vid="MIC 6:5">ciɓai kpam ili i'ya Bala'am kalobo ka Beyo u wushunki yi.</para>
  <para style="q1" vid="MIC 6:5">Ciɓai na̱ nwalu n ɗe a Shitim ubana a Giligal,</para>
  <para style="q2" vid="MIC 6:5">adama i reve manyan ma maci ma Magono ma Zuba.&gt;&gt;<note caller="+" style="f"><char style="fr" closed="false">6:5 </char><char style="ft" closed="false">Kondo: </char><char style="xt" closed="false"><ref loc="NUM 22:2-24:25">Mkc 22:2--24:25</ref>; <ref loc="JOS 3:1-4:19">Jos 3:1--4:19</ref></char></note><verse eid="MIC 6:5" /></para>
  <para style="s">Ili i i'ya Magono ma Zuba ma ciga</para>
  <para style="q1">
    <verse number="6" style="v" sid="MIC 6:6" />Ndya ma tuwa̱ n i'ya a kapala ka Magono ma Zuba</para>
  <para style="q2" vid="MIC 6:6">n kuɗa̱ngu n lyai kayala a kapala ka Kashila̱ ka zuba?</para>
  <para style="q1" vid="MIC 6:6">N tuwa̱ a kapala ka ne n uɗara̱kpa u urunukpa</para>
  <para style="q2" vid="MIC 6:6">na̱ ndyondyom ka kayen ka te ɗa?<verse eid="MIC 6:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="MIC 6:7" />Magono ma Zuba ma pana kayanyan ka a'ondom azu azu,</para>
  <para style="q2" vid="MIC 6:7">n ayenete a manivi ma zayitum azu kupa (10,000)?</para>
  <para style="q1" vid="MIC 6:7">N yain uɗara̱kpa n maku ma kagita̱ ma va̱ adama a unyushi u va̱,</para>
  <para style="q2" vid="MIC 6:7">mmuku n va̱ kpam adama a unyushi u cingi u va̱?<verse eid="MIC 6:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="MIC 6:8" />Nala wa, vuma, Magono ma Zuba</para>
  <para style="q2" vid="MIC 6:8">ma wenike vu ɗe ili i'ya i'a̱ri i shinga,</para>
  <para style="q2" vid="MIC 6:8">Ili i'ya va yan i'ya na:</para>
  <para style="q1" vid="MIC 6:8">Vu yain afada a maci n uciga u wenike asuvayali,</para>
  <para style="q2" vid="MIC 6:8">vu vakunku kpam kaci ka vunu a asu u tono Kashila̱ ka vunu.<verse eid="MIC 6:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="MIC 6:9" />Zuwai atsuvu i pana, Magono ma Zuba</para>
  <para style="q2" vid="MIC 6:9">ma isa̱ ama i ilyuci i Urishelima.</para>
  <para style="q2" vid="MIC 6:9">Kakiri ka, a pana uwonvo u Magono ma Zuba.</para>
  <para style="q1" vid="MIC 6:9">Magono ma Zuba ma danai,</para>
  <para style="q2" vid="MIC 6:9">&lt;&lt;Kakuma̱ ka ama n aza a ɗa a ɓolomgbonoi a ilyuci,</para>
  <para style="q2" vid="MIC 6:9">zuwai atsuvu i pana!<verse eid="MIC 6:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="MIC 6:10" />Ama a cingi, hal ma a̱sa̱nsa̱ n udukuyan u ɗa i tsa̱ra̱i a ure u cingi?</para>
  <para style="q2" vid="MIC 6:10">Ko ma a̱sa̱nsa̱ n kakundatsu ka i doi ka n kovoi?<verse eid="MIC 6:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="MIC 6:11" />Shegai mpa, Magono ma Zuba, ma kpa̱ɗa̱ ɗa̱ uyan mavura wa</para>
  <para style="q2" vid="MIC 6:11">adama kakundatsu ka kaɓan n maryafuka.<verse eid="MIC 6:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="MIC 6:12" />Aza a utsa̱ri a ɗe a tsu 'yankusu ta̱ ama;</para>
  <para style="q2" vid="MIC 6:12">ama a ɗe a ɗa a'a̱ri na̱ ndishi ɗe a tsu yansa kaɓan,</para>
  <para style="q2" vid="MIC 6:12">n una̱ u le ɗa a tsu yinsa̱ ama.<verse eid="MIC 6:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="MIC 6:13" />Adama a nala ma lapa ɗa̱ ta̱ na̱ mɓa̱la̱,</para>
  <para style="q2" vid="MIC 6:13">n wacinsa ɗa̱ adama a unyushi u cingi u ɗe.<verse eid="MIC 6:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="MIC 6:14" />Ya lya ta̱ ilikulya shegai ya ciwa̱ wa,</para>
  <para style="q2" vid="MIC 6:14">katsuma̱ ka ɗe ka rongo ta̱ n kambulu.</para>
  <para style="q1" vid="MIC 6:14">Ya ɓolomgbono ta̱ ucanga u ɗe, shegai ko ili ya zuwa wa,</para>
  <para style="q2" vid="MIC 6:14">i'ya kpam i zuwai kenu ma wacinsa ta̱ i'ya a asu u kuvon.<verse eid="MIC 6:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="MIC 6:15" />Ya ce ta̱, shegai ko ili ya kapa wa.</para>
  <para style="q2" vid="MIC 6:15">Ya pisha ta̱ ilimaci i zayitum shegai ya yan manyan n manivi ma ne wa.</para>
  <para style="q2" vid="MIC 6:15">Ya pisha ta̱ ilimaci i cinwi, shegai ya so mini ma cinwi mi wa.<verse eid="MIC 6:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="MIC 6:16" />Kpaci i tono ta̱ mele ma cingi ma Omiri,</para>
  <para style="q2" vid="MIC 6:16">n gba̱ manyan ma kuwa ku Ahabu;<note caller="+" style="f"><char style="fr" closed="false">6:16 </char><char style="ft" closed="false">Kondo: </char><char style="xt" closed="false"><ref loc="1KI 16:25-28">1 Ngo 16:25-28</ref>; <ref loc="1KI 16:29-34">1 Ngo 16:29-34</ref>; <ref loc="1KI 21:25-26">1 Ngo 21:25-26</ref></char></note></para>
  <para style="q2" vid="MIC 6:16">i tonoi afoɓi a cingi a le.</para>
  <para style="q1" vid="MIC 6:16">Adama a nala ma gonuko ɗa̱ ta̱ akpongo</para>
  <para style="q2" vid="MIC 6:16">aza ɗa a'a̱ri ndishi ɗe a ka woko ta̱ ili i magori.</para>
  <para style="q2" vid="MIC 6:16">Nala ya woko, eɗa̱ ama a va̱, ko n te wa a ka goro ɗa̱ ta̱.&gt;&gt;<verse eid="MIC 6:16" /></para>
  <chapter eid="MIC 6" />
  <chapter number="7" style="c" sid="MIC 7" />
  <para style="s">Vanai Kashila̱ ka iwauwi</para>
  <para style="q1">
    <verse number="1" style="v" sid="MIC 7:1" />Ter va̱! Kpaci n woko ɗe</para>
  <para style="q2" vid="MIC 7:1">yavu uza ɗa wa pana kambulu,</para>
  <para style="q1" vid="MIC 7:1">uza ɗa bawu u tsa̱ra̱i ili an u ɓolomgbonoi ilimaci i kashina.</para>
  <para style="q2" vid="MIC 7:1">An a 'yarai kashina ka cinwi,</para>
  <para style="q1" vid="MIC 7:1">ilimaci i cinwi i'a̱ la i'ya ka kasa a lyai wa,</para>
  <para style="q2" vid="MIC 7:1">kpam bawu ilimaci i kapopi i gewi</para>
  <para style="q2" vid="MIC 7:1">i'ya ma ciga.<verse eid="MIC 7:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="MIC 7:2" />Ama a maci a kotsu ɗe a uyamba vi;</para>
  <para style="q2" vid="MIC 7:2">aza a ukuna u mayun a buwa wa.</para>
  <para style="q1" vid="MIC 7:2">Ya dem wa putsa̱ utoku u ne tsa̱ra̱ u wuna,</para>
  <para style="q2" vid="MIC 7:2">ya dem u wanda̱ga ta̱ utoku u ne utyangi.<verse eid="MIC 7:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="MIC 7:3" />Ya dem wa̱ ta̱ n ureve a asu u uyan ukuna u cingi n akere a ne,</para>
  <para style="q2" vid="MIC 7:3">azapige a ka ciga a na̱ka̱ le kune,</para>
  <para style="q1" vid="MIC 7:3">aza a afada kpam a ka wusha ukimba̱ u una̱,</para>
  <para style="q2" vid="MIC 7:3">uzapige u tsu zuwa ta̱ a yain ili i cingi i'ya katakasuvu ka ne ka ciga,</para>
  <para style="q2" vid="MIC 7:3">nala a tsu kpatala̱sa ukuna u mayun.<verse eid="MIC 7:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="MIC 7:4" />Vuma ɗa lai uyansa ili i shinga a asuvu a ɗe,</para>
  <para style="q2" vid="MIC 7:4">wa̱ ta̱ yavu maɗanga ma kaworo,</para>
  <para style="q1" vid="MIC 7:4">vuma ɗa lai u ukuna u maci asuvu a le</para>
  <para style="q2" vid="MIC 7:4">wa̱ ta̱ yavu maɗanga ma kawana.</para>
  <para style="q1" vid="MIC 7:4">Kain ka mavura ma ɗe ka tuwa̱ ɗe</para>
  <para style="q2" vid="MIC 7:4">kain ka a ka ɓara ɗa̱ a una̱ u ntsumate,</para>
  <para style="q2" vid="MIC 7:4">gogo-na ɗa ya dem wa la̱pa̱na̱.<verse eid="MIC 7:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="MIC 7:5" />Kotsu i pityanangu n aza a karen a ɗe wa,</para>
  <para style="q2" vid="MIC 7:5">kotsu i wushuku n aje a ɗe wa.</para>
  <para style="q1" vid="MIC 7:5">Ko aka a ɗe a ɗa ya ciga,</para>
  <para style="q2" vid="MIC 7:5">i kirana n kadyanshi ka una̱ u ɗe.<verse eid="MIC 7:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="MIC 7:6" />Kpaci maku ma vali u tsu goro ta̱ tata u ne,</para>
  <para style="q2" vid="MIC 7:6">maku ma uka kpam u tsu 'ya̱nga̱sa̱ka̱ ta̱ mma u ne,</para>
  <para style="q1" vid="MIC 7:6">kajene n anuku a ne kpam u tsu yan ta̱ tsilala.</para>
  <para style="q2" vid="MIC 7:6">Atokulalu a vuma, a'a̱ ta̱ a kuwa ku te.<note caller="+" style="f"><char style="fr" closed="false">7:6 </char><char style="ft" closed="false">Kondo: </char><char style="xt" closed="false"><ref loc="MAT 10:35-36">Mat 10:35-36</ref>; <ref loc="LUK 12:53">Luk 12:53</ref></char></note><verse eid="MIC 7:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="MIC 7:7" />Shegai mpa, ma zuwa ta̱ a'eshi</para>
  <para style="q2" vid="MIC 7:7">a asu u Magono ma Zuba u ɓa̱nga̱ mu,</para>
  <para style="q1" vid="MIC 7:7">ma vana ta̱ Kashila̱ ka iwauwi ka va̱;</para>
  <para style="q2" vid="MIC 7:7">Kashila̱ ka va̱ wa pana̱ka mu ta̱.<verse eid="MIC 7:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="MIC 7:8" />Atokulalu a va̱, kotsu i yain maza̱nga̱ a kaci ka va̱ wa!</para>
  <para style="q2" vid="MIC 7:8">Ko n rukpa̱i baci, ma 'ya̱nga̱ ta̱.</para>
  <para style="q1" vid="MIC 7:8">Ko n dusuku baci a karimbi,</para>
  <para style="q2" vid="MIC 7:8">Magono ma Zuba ma woko ta̱ katyashi ka va̱.<verse eid="MIC 7:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="MIC 7:9" />N yan ta̱ unyushi u cingi a asu u Magono ma Zuba</para>
  <para style="q2" vid="MIC 7:9">adama a nala ma kawunku ta̱ adama upan u ne,</para>
  <para style="q1" vid="MIC 7:9">shegai a makorishi wa shamkpa mu ta̱,</para>
  <para style="q2" vid="MIC 7:9">kpaci u pana ta̱ usapula u va̱, u yanka mu afada ɗa a'a̱ri dere.</para>
  <para style="q1" vid="MIC 7:9">Wa tuko mu ta̱ a asu u katyashi,</para>
  <para style="q2" vid="MIC 7:9">n wene ukuna u maci u ne.<verse eid="MIC 7:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="MIC 7:10" />Pini nala ɗa atokulalu a va̱ a ka wene,</para>
  <para style="q2" vid="MIC 7:10">aku uwono u kimba̱ aza ɗa a tonuko mu,</para>
  <para style="q2" vid="MIC 7:10">&lt;&lt;Nte Magono ma Zuba Kashila̱ ka vunu?&gt;&gt;</para>
  <para style="q1" vid="MIC 7:10">A'eshi a va̱ a ka wene ta̱ urukpa̱ u le,</para>
  <para style="q2" vid="MIC 7:10">gogo-na a ka kpatsa le ta̱ yavu cin a ure.<verse eid="MIC 7:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="MIC 7:11" />Kain ka a ka lapula a mai asaga a ɗe ka tuwa̱ ta̱,</para>
  <para style="q2" vid="MIC 7:11">kain ka a ka doku upeti u karen u ɗe.<verse eid="MIC 7:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="MIC 7:12" />A kain ka nala ki, ama ushani a ka tuwa̱ ta̱ a asu u ɗe,</para>
  <para style="q2" vid="MIC 7:12">a wuta̱ a Asiriya n ilyuci i Masar,</para>
  <para style="q1" vid="MIC 7:12">hal gba̱m ili i'ya bidyai a Masar hal Aga̱ta̱ a Yufiriti,</para>
  <para style="q2" vid="MIC 7:12">n mala ubana a mala</para>
  <para style="q2" vid="MIC 7:12">n masasa ubana a masasa.<verse eid="MIC 7:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="MIC 7:13" />Likimba wa woko ta̱ akpongo</para>
  <para style="q2" vid="MIC 7:13">adama tsicingi tsa aza a ɗa dusuki pini a yansai.<verse eid="MIC 7:13" /></para>
  <para style="s">Kavasu ka Mika ubana ara Magono ma Zuba</para>
  <para style="q1">
    <verse number="14" style="v" sid="MIC 7:14" />Magono ma Zuba, kirana n ama a vunu</para>
  <para style="q2" vid="MIC 7:14">tyoku ɗa kaliniki ka tsu yan n kalangu ka ne,</para>
  <para style="q1" vid="MIC 7:14">ushiga u nlala u agadu u vunu,</para>
  <para style="q2" vid="MIC 7:14">u ɗa wa̱ri ndishi utyoku u ne</para>
  <para style="q2" vid="MIC 7:14">a kutsu ka ka̱ri n asu u kalina u tsishinda̱.</para>
  <para style="q1" vid="MIC 7:14">A̱sa̱ka̱ a wuta̱ a lina a kaɓon ka Bashan n kaɓon ka Giliyadu</para>
  <para style="q2" vid="MIC 7:14">yavu a'ayin a cau.<verse eid="MIC 7:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="MIC 7:15" />Magono ma Zuba ma danai,</para>
  <para style="q2" vid="MIC 7:15">&lt;&lt;Ma yanka ɗa̱ ta̱ manyan ma ikunesavu</para>
  <para style="q2" vid="MIC 7:15">tyoku ɗa n yain an n wutukpa̱ ɗa̱ a asu u tsugbashi a Masar.&gt;&gt;<verse eid="MIC 7:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="MIC 7:16" />Kakuma̱ ka ama a ka wene ta̱ kpam a pana uwono</para>
  <para style="q2" vid="MIC 7:16">ko an u wokoi a'a̱ri n ucira.</para>
  <para style="q1" vid="MIC 7:16">A ka kimba̱ ta̱ una̱ u le a paɗa bini</para>
  <para style="q2" vid="MIC 7:16">a woko kpam yavu agulani.<verse eid="MIC 7:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="MIC 7:17" />A ka woko ta̱ yavu ili i'ya ya ka̱bura̱ a iyamba,</para>
  <para style="q2" vid="MIC 7:17">a ka lya ta̱ kabuta̱ yavu a'ali.</para>
  <para style="q1" vid="MIC 7:17">A ka wuta̱ ta̱ n a jeki ikyamba,</para>
  <para style="q2" vid="MIC 7:17">a asu u ukpawunsa u le.</para>
  <para style="q1" vid="MIC 7:17">A ka giruwa̱ ta̱ a kapala ka vunu</para>
  <para style="q2" vid="MIC 7:17">Magono ma Zuba Kashila̱ ka tsunu;</para>
  <para style="q2" vid="MIC 7:17">a ka pana vu ta̱ uwonvo.<verse eid="MIC 7:17" /></para>
  <para style="s">Vuma wa̱ la tyoku u Kashila̱ wa</para>
  <para style="q1">
    <verse number="18" style="v" sid="MIC 7:18" />Kashila̱ ka roku ka̱ la tyoku u vunu wa,</para>
  <para style="q2" vid="MIC 7:18">uza ɗa u tsu cimbusa̱ unyushi u cingi n unyushi u ama a ne</para>
  <para style="q2" vid="MIC 7:18">a ɗa a buwai a aza a agadu a vunu.</para>
  <para style="q1" vid="MIC 7:18">Vu tsu ka̱na̱ upan u vunu hal ubana wa,</para>
  <para style="q2" vid="MIC 7:18">kpaci vu tsu pana ta̱ kayanyan ka uwenike</para>
  <para style="q2" vid="MIC 7:18">uciga u vunu u ɗa bawu wa savaɗa.<verse eid="MIC 7:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="MIC 7:19" />Va doku ta̱ va wenike tsu asuvayali a vunu.</para>
  <para style="q2" vid="MIC 7:19">Va lya ta̱ kaci ka unyushi u tsunu</para>
  <para style="q2" vid="MIC 7:19">vu vuta̱la̱ kpam unyushi u cingi u tsunu a mala ma ma̱ri lyungu-lyungu.<verse eid="MIC 7:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="MIC 7:20" />Va wenike ta̱ ukuna u mayun u vunu</para>
  <para style="q2" vid="MIC 7:20">n uciga u vunu u ɗa bawu wa savaɗa,</para>
  <para style="q2" vid="MIC 7:20">a asu u mmuku n tsikaya ma Ibirahi n Yakubu</para>
  <para style="q1" vid="MIC 7:20">tyoku ɗa vu yain kazuwamgbani n ikaya i tsunu a'ayin a cau.<verse eid="MIC 7:20" /></para>
  <chapter eid="MIC 7" />
</usx>