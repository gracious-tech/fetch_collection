<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="ISA" style="id">- Biblica® Open Kannada Contemporary Version</book>
  <para style="h">ಯೆಶಾಯ</para>
  <para style="toc1">ಯೆಶಾಯ</para>
  <para style="toc2">ಯೆಶಾಯ</para>
  <para style="toc3">ಯೆಶಾಯ</para>
  <para style="mt1">ಯೆಶಾಯ</para>
  <chapter number="1" style="c" sid="ISA 1"/>
  <para style="p">
    <verse number="1" style="v" sid="ISA 1:1"/>ಯೆಹೂದ ದೇಶದ ಅರಸರಾಗಿದ್ದ ಉಜ್ಜೀಯ, ಯೋತಾಮ, ಆಹಾಜ, ಹಿಜ್ಕೀಯ ಇವರ ಕಾಲದಲ್ಲಿ ಯೆಹೂದ ಮತ್ತು ಯೆರೂಸಲೇಮಿನ ವಿಷಯವಾಗಿ ಆಮೋಚನ ಮಗನಾದ ಯೆಶಾಯನಿಗೆ ಆದ ದರ್ಶನವು.<verse eid="ISA 1:1"/></para>
  <para style="b"/>
  <para style="s1">ದಂಗೆಕೋರ ರಾಷ್ಟ್ರ</para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 1:2"/>ಆಕಾಶಗಳೇ, ಕೇಳಿರಿ. ಭೂಮಿಯೇ, ಕಿವಿಗೊಡು.</para>
  <para style="q2" vid="ISA 1:2">ಏಕೆಂದರೆ ಯೆಹೋವ ದೇವರು ಮಾತನಾಡುತ್ತಿದ್ದಾರೆ:</para>
  <para style="q1" vid="ISA 1:2">“ನಾನು ಸಾಕಿ ಸಲಹಿದ ಮಕ್ಕಳೇ</para>
  <para style="q2" vid="ISA 1:2">ನನಗೆ ವಿರೋಧವಾಗಿ ತಿರುಗಿಬಿದ್ದಿದ್ದಾರೆ.<verse eid="ISA 1:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 1:3"/>ಎತ್ತು ತನ್ನ ಯಜಮಾನನನ್ನು,</para>
  <para style="q2" vid="ISA 1:3">ಕತ್ತೆಯು ತನ್ನ ಒಡೆಯನ ಕೊಟ್ಟಿಗೆಯನ್ನು ತಿಳಿದಿರುವುವು.</para>
  <para style="q1" vid="ISA 1:3">ಆದರೆ ಇಸ್ರಾಯೇಲಿಗೆ ತಿಳಿದಿಲ್ಲ.</para>
  <para style="q2" vid="ISA 1:3">ನನ್ನ ಜನರಿಗೂ ತಿಳಿಯುವುದಿಲ್ಲ.”<verse eid="ISA 1:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 1:4"/>ಅಯ್ಯೋ ಪಾಪಿಷ್ಠ ಜನಾಂಗವೇ,</para>
  <para style="q2" vid="ISA 1:4">ದುಷ್ಟತನದ ಭಾರವನ್ನು ಹೊತ್ತಿರುವ ಪ್ರಜೆಯೇ!</para>
  <para style="q1" vid="ISA 1:4">ದುಷ್ಟ ಸಂತತಿಯೇ,</para>
  <para style="q2" vid="ISA 1:4">ಭ್ರಷ್ಟರಾದ ಮಕ್ಕಳೇ!</para>
  <para style="q1" vid="ISA 1:4">ಯೆಹೋವ ದೇವರನ್ನು ಅವರು ತೊರೆದುಬಿಟ್ಟಿದ್ದಾರೆ.</para>
  <para style="q2" vid="ISA 1:4">ಇಸ್ರಾಯೇಲಿನ ಪರಿಶುದ್ಧರನ್ನು ತಿರಸ್ಕರಿಸಿದ್ದಾರೆ</para>
  <para style="q2" vid="ISA 1:4">ಅವರಿಂದ ದೂರವಾಗಿದ್ದಾರೆ.<verse eid="ISA 1:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 1:5"/>ನೀವು ಹೆಚ್ಚೆಚ್ಚಾಗಿ ತಿರುಗಿಬಿದ್ದು</para>
  <para style="q2" vid="ISA 1:5">ಏಕೆ ನೀವು ಇನ್ನು ಹೊಡೆಯಿಸಿಕೊಳ್ಳುತ್ತೀರಿ?</para>
  <para style="q1" vid="ISA 1:5">ತಲೆಯೆಲ್ಲಾ ಗಾಯವಾಗಿದೆ,</para>
  <para style="q2" vid="ISA 1:5">ಹೃದಯವೆಲ್ಲಾ ಬಾಧಿತವಾಗಿದೆ.<verse eid="ISA 1:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 1:6"/>ಅಂಗಾಲಿನಿಂದ ನಡುನೆತ್ತಿಯವರೆಗೂ ಬಾಸುಂಡೆ,</para>
  <para style="q2" vid="ISA 1:6">ಪೆಟ್ಟು, ಮಾಗದ ಗಾಯಗಳೇ ಹೊರತು</para>
  <para style="q1" vid="ISA 1:6">ಏನೂ ಸೌಖ್ಯವಿಲ್ಲ.</para>
  <para style="q2" vid="ISA 1:6">ಅವುಗಳನ್ನು ತೊಳೆಯಲಿಲ್ಲ, ಕಟ್ಟಿಲ್ಲ,</para>
  <para style="q1" vid="ISA 1:6">ಇಲ್ಲವೆ ಎಣ್ಣೆ ಸವರಿ ಮೃದು ಮಾಡಿಲ್ಲ.<verse eid="ISA 1:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 1:7"/>ನಿಮ್ಮ ದೇಶವು ಹಾಳಾಗಿದೆ.</para>
  <para style="q2" vid="ISA 1:7">ನಿಮ್ಮ ಪಟ್ಟಣಗಳು ಬೆಂಕಿಯಿಂದ ಸುಟ್ಟುಹೋಗಿವೆ.</para>
  <para style="q1" vid="ISA 1:7">ನಿಮ್ಮ ಹೊಲಗಳನ್ನು</para>
  <para style="q2" vid="ISA 1:7">ಪರರು ನಿಮ್ಮೆದುರಿಗೆ ನುಂಗಿಬಿಡುತ್ತಿದ್ದಾರೆ.</para>
  <para style="q2" vid="ISA 1:7">ಅದು ಇತರ ಜನರಿಂದ ಕೆಡವಿಬಿದ್ದು ಹಾಳಾಗಿದೆ.<verse eid="ISA 1:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 1:8"/>ಚೀಯೋನ್ ಪುತ್ರಿಯು</para>
  <para style="q2" vid="ISA 1:8">ದ್ರಾಕ್ಷಿ ತೋಟದಲ್ಲಿರುವ ಮನೆಯ ಹಾಗೆಯೂ,</para>
  <para style="q1" vid="ISA 1:8">ಸೌತೆಕಾಯಿಯ ಹೊಲದ ಗುಡಿಸಿಲಿನ ಹಾಗೂ</para>
  <para style="q2" vid="ISA 1:8">ಮುತ್ತಿಗೆ ಹಾಕಿರುವ ಪಟ್ಟಣದ ಹಾಗೆಯೂ ಇದೆ.<verse eid="ISA 1:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 1:9"/>ಸೇನಾಧೀಶ್ವರ ಯೆಹೋವ ದೇವರು</para>
  <para style="q2" vid="ISA 1:9">ನಮಗೆ ಮಿಕ್ಕಿದ್ದರಲ್ಲಿ ಸ್ವಲ್ಪವನ್ನಾದರೂ ಉಳಿಸದೆ ಹೋಗಿದ್ದರೆ,</para>
  <para style="q1" vid="ISA 1:9">ನಾವು ಸೊದೋಮಿನಂತೆ ಆಗುತ್ತಿದ್ದೆವು,</para>
  <para style="q2" vid="ISA 1:9">ಗೊಮೋರಕ್ಕೆ ಸಮಾನವಾಗಿಯೂ ಇರುತ್ತಿದ್ದೆವು.<verse eid="ISA 1:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 1:10"/>ಸೊದೋಮಿನ ಅಧಿಪತಿಗಳೇ,</para>
  <para style="q2" vid="ISA 1:10">ನೀವು ಯೆಹೋವ ದೇವರ ಮಾತನ್ನು ಕೇಳಿರಿ.</para>
  <para style="q1" vid="ISA 1:10">ಗೊಮೋರದ ಪ್ರಜೆಗಳೇ!</para>
  <para style="q2" vid="ISA 1:10">ನಮ್ಮ ದೇವರ ನಿಯಮಕ್ಕೆ ಕಿವಿಗೊಡಿರಿ.<verse eid="ISA 1:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 1:11"/>“ನೀವು ಲೆಕ್ಕವಿಲ್ಲದಷ್ಟು ಯಜ್ಞಗಳನ್ನು</para>
  <para style="q2" vid="ISA 1:11">ನನಗೆ ಅರ್ಪಿಸುವ ಉದ್ದೇಶವೇನು?”</para>
  <para style="q2" vid="ISA 1:11">ಎಂದು ಯೆಹೋವ ದೇವರು ನುಡಿಯುತ್ತಾರೆ.</para>
  <para style="q1" vid="ISA 1:11">“ಟಗರುಗಳ ದಹನಬಲಿಗಳು,</para>
  <para style="q2" vid="ISA 1:11">ಪುಷ್ಟಪಶುಗಳ ಕೊಬ್ಬು ಇದೆಲ್ಲಾ ನನಗೆ ಬೇಸರ.</para>
  <para style="q1" vid="ISA 1:11">ಹೋರಿ, ಕುರಿ, ಹೋತಗಳ ರಕ್ತಕ್ಕೆ,</para>
  <para style="q2" vid="ISA 1:11">ನಾನು ಸಂತೋಷಪಡುವುದಿಲ್ಲ.<verse eid="ISA 1:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 1:12"/>ನೀವು ನನ್ನ ಸನ್ನಿಧಿಯಲ್ಲಿ ಕಾಣಿಸಿಕೊಳ್ಳಬೇಕೆಂದು ಬರುತ್ತೀರಲ್ಲಾ,</para>
  <para style="q2" vid="ISA 1:12">ನನ್ನ ಪ್ರಾಕಾರಗಳನ್ನು ತುಳಿಯಲು</para>
  <para style="q2" vid="ISA 1:12">ಯಾರು ನಿಮ್ಮನ್ನು ಕೇಳಿಕೊಂಡರು.<verse eid="ISA 1:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="ISA 1:13"/>ಇನ್ನು ವ್ಯರ್ಥವಾದ ಕಾಣಿಕೆಗಳನ್ನು ತರಬೇಡಿರಿ!</para>
  <para style="q2" vid="ISA 1:13">ನಿಮ್ಮ ಧೂಪವು ನನಗೆ ಅಸಹ್ಯ.</para>
  <para style="q1" vid="ISA 1:13">ಅಮಾವಾಸ್ಯೆಗಳು, ಸಬ್ಬತ್ ದಿನಗಳು, ಸಭೆಗಳು ಕೂಡುವುದು ಇವು ಬೇಡ.</para>
  <para style="q2" vid="ISA 1:13">ದುಷ್ಟತನದಿಂದ ಕೂಡಿದ ವಿಶೇಷ ಕೂಟವನ್ನು ಸಹ ಸಹಿಸಲಾರೆನು.<verse eid="ISA 1:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="ISA 1:14"/>ನಿಮ್ಮ ಅಮಾವಾಸ್ಯೆಗಳನ್ನೂ, ನೇಮಕವಾದ ಹಬ್ಬಗಳನ್ನೂ</para>
  <para style="q2" vid="ISA 1:14">ನನ್ನ ಆತ್ಮವು ದ್ವೇಷಿಸುತ್ತದೆ.</para>
  <para style="q1" vid="ISA 1:14">ಅವು ನನಗೆ ಭಾರ,</para>
  <para style="q2" vid="ISA 1:14">ಸಹಿಸಲು ಬೇಸರ.<verse eid="ISA 1:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="ISA 1:15"/>ನೀವು ಪ್ರಾರ್ಥಿಸಲು ನಿಮ್ಮ ಕೈಗಳನ್ನು ಚಾಚುವಾಗ,</para>
  <para style="q2" vid="ISA 1:15">ನನ್ನ ಕಣ್ಣುಗಳನ್ನು ನಿಮಗೆ ಮರೆಮಾಡುವೆನು;</para>
  <para style="q1" vid="ISA 1:15">ಹೌದು, ನೀವು ಬಹು ಪ್ರಾರ್ಥನೆಗಳನ್ನು ಮಾಡಿದರೂ</para>
  <para style="q2" vid="ISA 1:15">ನಾನು ಕೇಳೆನು.</para>
  <para style="b" vid="ISA 1:15"/>
  <para style="q1" vid="ISA 1:15">“ನಿಮ್ಮ ಕೈಗಳು ರಕ್ತದಿಂದ ತೊಯ್ದಿವೆ!<verse eid="ISA 1:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="ISA 1:16"/>“ನಿಮ್ಮನ್ನು ತೊಳೆದುಕೊಂಡು ಶುದ್ಧಮಾಡಿಕೊಳ್ಳಿರಿ.</para>
  <para style="q2" vid="ISA 1:16">ನನ್ನ ಕಣ್ಣೆದುರಿನಿಂದ ನಿಮ್ಮ ದುಷ್ಟಕೃತ್ಯಗಳನ್ನು ತೆಗೆದುಹಾಕಿರಿ.</para>
  <para style="q2" vid="ISA 1:16">ಕೆಟ್ಟದ್ದನ್ನು ನಿಲ್ಲಿಸಿಬಿಡಿರಿ.<verse eid="ISA 1:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="ISA 1:17"/>ಒಳ್ಳೆಯದನ್ನು ಮಾಡಲು ಕಲಿತುಕೊಳ್ಳಿರಿ. ನ್ಯಾಯವನ್ನು ಹುಡುಕಿರಿ.</para>
  <para style="q2" vid="ISA 1:17">ಹಿಂಸೆಪಡುವವರನ್ನು ಉಪಚರಿಸಿರಿ.</para>
  <para style="q1" vid="ISA 1:17">ಅನಾಥರಿಗೆ ನ್ಯಾಯತೀರಿಸಿರಿ.</para>
  <para style="q2" vid="ISA 1:17">ವಿಧವೆಯರ ಪರವಾಗಿ ವಾದಿಸಿರಿ.<verse eid="ISA 1:17"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="18" style="v" sid="ISA 1:18"/>“ಈಗ ಬನ್ನಿರಿ, ನಾವು ಒಟ್ಟಾಗಿ ವಾದಿಸೋಣ,”</para>
  <para style="q2" vid="ISA 1:18">ಎಂದು ಯೆಹೋವ ದೇವರು ಹೇಳುತ್ತಾರೆ.</para>
  <para style="q1" vid="ISA 1:18">“ನಿಮ್ಮ ಪಾಪಗಳು ಕಡುಕೆಂಪಾಗಿದ್ದರೂ</para>
  <para style="q2" vid="ISA 1:18">ಹಿಮದಂತೆ ಬೆಳ್ಳಗಾಗುವುವು.</para>
  <para style="q1" vid="ISA 1:18">ರಕ್ತದಂತೆ ಕಡುಕೆಂಪಾಗಿದ್ದರೂ</para>
  <para style="q2" vid="ISA 1:18">ಉಣ್ಣೆಯಂತೆ ಆಗುವುವು.<verse eid="ISA 1:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="ISA 1:19"/>ನೀವು ಒಪ್ಪಿ ವಿಧೇಯರಾದರೆ</para>
  <para style="q2" vid="ISA 1:19">ದೇಶದ ಸತ್ಫಲವನ್ನು ಸವಿಯುವಿರಿ.<verse eid="ISA 1:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="ISA 1:20"/>ಆದರೆ ನೀವು ತಿರಸ್ಕರಿಸಿ ತಿರುಗಿಬಿದ್ದರೆ,</para>
  <para style="q2" vid="ISA 1:20">ಖಡ್ಗದ ಬಾಯಿಗೆ ತುತ್ತಾಗುವಿರಿ,”</para>
  <para style="q2" vid="ISA 1:20">ಏಕೆಂದರೆ ಯೆಹೋವ ದೇವರೇ ಇದನ್ನು ನುಡಿದಿದ್ದಾರೆ.<verse eid="ISA 1:20"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="21" style="v" sid="ISA 1:21"/>ನಂಬಿಗಸ್ತಿಕೆಯ ಪಟ್ಟಣವು</para>
  <para style="q2" vid="ISA 1:21">ವ್ಯಭಿಚಾರದ ಪಟ್ಟಣವಾಗಿದೆಯಲ್ಲಾ!</para>
  <para style="q1" vid="ISA 1:21">ಅದು ನ್ಯಾಯದಿಂದ ತುಂಬಿ</para>
  <para style="q2" vid="ISA 1:21">ನೀತಿಯಲ್ಲಿ ನೆಲೆಯಾಗಿತ್ತು.</para>
  <para style="q2" vid="ISA 1:21">ಆದರೆ ಈಗ ಕೊಲೆಗಾರರಿಂದ ತುಂಬಿದೆ.<verse eid="ISA 1:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="ISA 1:22"/>ನಿನ್ನ ಬೆಳ್ಳಿಯು ಕಂದಾಯಿತು.</para>
  <para style="q2" vid="ISA 1:22">ನಿನ್ನ ದ್ರಾಕ್ಷಾರಸವು ನೀರಿನಿಂದ ಬೆರಕೆಯಾಯಿತು.<verse eid="ISA 1:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="ISA 1:23"/>ನಿನ್ನ ಪ್ರಭುಗಳು ಎದುರುಬೀಳುವವರೂ,</para>
  <para style="q2" vid="ISA 1:23">ಕಳ್ಳರ ಜೊತೆಗಾರರೂ ಆಗಿದ್ದಾರೆ.</para>
  <para style="q1" vid="ISA 1:23">ಪ್ರತಿಯೊಬ್ಬನೂ ಲಂಚ ಪ್ರಿಯನೂ,</para>
  <para style="q2" vid="ISA 1:23">ಬಹುಮಾನಗಳನ್ನು ಅಪೇಕ್ಷಿಸುವವನೂ ಆಗಿದ್ದಾನೆ.</para>
  <para style="q1" vid="ISA 1:23">ಅವರು ಅನಾಥರಿಗೆ ನ್ಯಾಯತೀರಿಸರು,</para>
  <para style="q2" vid="ISA 1:23">ಇಲ್ಲವೆ ವಿಧವೆಯರ ವ್ಯಾಜ್ಯವು ಅವರ ಬಳಿಗೆ ಬರುವುದಿಲ್ಲ.<verse eid="ISA 1:23"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="24" style="v" sid="ISA 1:24"/>ಆದ್ದರಿಂದ ಸರ್ವಶಕ್ತರಾದ ದೇವರೂ,</para>
  <para style="q2" vid="ISA 1:24">ಇಸ್ರಾಯೇಲಿನ ಪರಾಕ್ರಮಿಯೂ ಆದ ಯೆಹೋವ ದೇವರು ಹೇಳುವುದೇನೆಂದರೆ,</para>
  <para style="q1" vid="ISA 1:24">“ಆಹಾ! ನನ್ನ ವೈರಿಗಳ ಮೇಲೆ ನನ್ನ ಕೋಪವನ್ನು ಹೊರಹಾಕುತ್ತೇನೆ</para>
  <para style="q2" vid="ISA 1:24">ಮತ್ತು ನನ್ನ ಶತ್ರುಗಳ ಮೇಲೆ ಸೇಡು ತೀರಿಸಿಕೊಳ್ಳುತ್ತೇನೆ.<verse eid="ISA 1:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="ISA 1:25"/>ನನ್ನ ಕೈಯನ್ನು ನಿನ್ನ ಕಡೆಗೆ ತಿರುಗಿಸಿ,</para>
  <para style="q2" vid="ISA 1:25">ನಿನ್ನ ಮಲಿನವನ್ನು ಸಂಪೂರ್ಣವಾಗಿ ನಿವಾರಿಸಿ,</para>
  <para style="q2" vid="ISA 1:25">ನಿನ್ನ ಎಲ್ಲಾ ಕಲ್ಮಷವನ್ನು ತೆಗೆದುಹಾಕುವೆನು.<verse eid="ISA 1:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="ISA 1:26"/>ನಿನ್ನ ನ್ಯಾಯಾಧಿಪತಿಗಳನ್ನು ಮುಂಚಿನ ಹಾಗೆಯೂ,</para>
  <para style="q2" vid="ISA 1:26">ನಿನ್ನ ಆಲೋಚನಾಪರರನ್ನು ಪ್ರಾರಂಭದಲ್ಲಿದ್ದ</para>
  <para style="q1" vid="ISA 1:26">ಹಾಗೆಯೂ ತಿರುಗಿ ಒದಗಿಸಿ ಕೊಡುವೆನು.</para>
  <para style="q2" vid="ISA 1:26">ತರುವಾಯ ನೀನು ನೀತಿಯುಳ್ಳ ಪಟ್ಟಣವೆಂದೂ,</para>
  <para style="q2" vid="ISA 1:26">ನಂಬಿಗಸ್ತಿಕೆಯ ಪಟ್ಟಣವೆಂದೂ ಎನಿಸಿಕೊಳ್ಳುವೆ.”<verse eid="ISA 1:26"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="27" style="v" sid="ISA 1:27"/>ಚೀಯೋನ್ ಪಟ್ಟಣವು ನ್ಯಾಯತೀರ್ಪಿನಿಂದಲೂ,</para>
  <para style="q2" vid="ISA 1:27">ನೀತಿ ನಂಬಿಕೆಯಿಂದ ಪಶ್ಚಾತ್ತಾಪ ಹೊಂದಿದ ಆಕೆಯ ಜನರೂ ಬಿಡುಗಡೆಯಾಗುವರು.<verse eid="ISA 1:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="ISA 1:28"/>ಆದರೆ ದ್ರೋಹಿಗಳೂ, ಪಾಪಿಗಳೂ ಒಟ್ಟಾಗಿ ನಾಶವಾಗುವರು</para>
  <para style="q2" vid="ISA 1:28">ಮತ್ತು ಯೆಹೋವ ದೇವರನ್ನು ತೊರೆದವರು ನಿರ್ಮೂಲವಾಗುವರು.<verse eid="ISA 1:28"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="29" style="v" sid="ISA 1:29"/>“ನೀವು ಇಷ್ಟಪಟ್ಟ ಪವಿತ್ರ ಏಲಾ ಮರಗಳ ನಿಮಿತ್ತ ನಾಚಿಕೊಳ್ಳುವಿರಿ.</para>
  <para style="q2" vid="ISA 1:29">ಆರಿಸಿಕೊಂಡ ವನಗಳ ವಿಷಯವಾಗಿ ಲಜ್ಜೆಪಡುವಿರಿ.<verse eid="ISA 1:29"/></para>
  <para style="q1">
    <verse number="30" style="v" sid="ISA 1:30"/>ನೀವು ಬಾಡಿದ ಎಲೆಯುಳ್ಳ ಏಲಾ ಮರದಂತೆಯೂ,</para>
  <para style="q2" vid="ISA 1:30">ನೀರಿಲ್ಲದ ತೋಟದಂತೆಯೂ ಇರುವಿರಿ.<verse eid="ISA 1:30"/></para>
  <para style="q1">
    <verse number="31" style="v" sid="ISA 1:31"/>ನಿಮ್ಮಲ್ಲಿನ ಬಲಿಷ್ಠನೇ ಸೆಣಬಿನ ನಾರು,</para>
  <para style="q2" vid="ISA 1:31">ಅವನ ಕೆಲಸ,</para>
  <para style="q1" vid="ISA 1:31">ಅವೆರಡೂ ಸೇರಿ ಯಾರೂ ಆರಿಸಲಾಗದಂತೆ</para>
  <para style="q2" vid="ISA 1:31">ಅವು ಸುಟ್ಟುಹೋಗುವುವು.”<verse eid="ISA 1:31"/></para>
  <chapter eid="ISA 1"/>
  <chapter number="2" style="c" sid="ISA 2"/>
  <para style="s1">ಯೆಹೋವ ದೇವರ ಬೆಟ್ಟವು</para>
  <para style="p">
    <verse number="1" style="v" sid="ISA 2:1"/>ಆಮೋಚನ ಮಗ ಯೆಶಾಯನಿಗೆ ಯೆಹೂದದ ಮತ್ತು ಯೆರೂಸಲೇಮಿನ ವಿಷಯವಾಗಿ ಕಂಡು ಬಂದ ದೈವೋಕ್ತಿ:<verse eid="ISA 2:1"/></para>
  <para style="b"/>
  <para style="p">
    <verse number="2" style="v" sid="ISA 2:2"/>ಆ ಅಂತ್ಯಕಾಲದಲ್ಲಿ,</para>
  <para style="q1" vid="ISA 2:2">ಯೆಹೋವ ದೇವರ ಮಂದಿರದ ಪರ್ವತವು ಎಲ್ಲಾ ಗುಡ್ಡಬೆಟ್ಟಗಳಿಗಿಂತ</para>
  <para style="q2" vid="ISA 2:2">ಉನ್ನತೋನ್ನತವಾಗಿ ಬೆಳೆದು ನೆಲೆಗೊಳ್ಳುವುದು.</para>
  <para style="q1" vid="ISA 2:2">ಆಗ ಎಲ್ಲಾ ಜನಾಂಗಗಳು ಅದರ ಬಳಿಗೆ ಪ್ರವಾಹದಂತೆ ಬರುವವು.<verse eid="ISA 2:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="ISA 2:3"/>ಅನೇಕ ಪ್ರಜೆಗಳು ಬಂದು ಹೀಗೆ ಹೇಳುವರು,</para>
  <para style="q1" vid="ISA 2:3">“ಬನ್ನಿರಿ, ಯೆಹೋವ ದೇವರ ಪರ್ವತಕ್ಕೂ,</para>
  <para style="q2" vid="ISA 2:3">ಯಾಕೋಬನ ದೇವರ ಆಲಯಕ್ಕೂ ಏರಿಹೋಗೋಣ.</para>
  <para style="q1" vid="ISA 2:3">ದೇವರು ತಮ್ಮ ಮಾರ್ಗಗಳನ್ನು ನಮಗೆ ಬೋಧಿಸುವರು,</para>
  <para style="q2" vid="ISA 2:3">ನಾವು ಅವರ ದಾರಿಗಳಲ್ಲಿ ನಡೆಯುವೆವು.”</para>
  <para style="q1" vid="ISA 2:3">ಏಕೆಂದರೆ ಚೀಯೋನಿನಿಂದ ದೇವರ ನಿಯಮವೂ,</para>
  <para style="q2" vid="ISA 2:3">ಯೆರೂಸಲೇಮಿನಿಂದ ಯೆಹೋವ ದೇವರ ವಾಕ್ಯವೂ ಹೊರಡುವುವು.<verse eid="ISA 2:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 2:4"/>ಅವರು ಅನೇಕ ಜನಾಂಗಗಳ ಮಧ್ಯದಲ್ಲಿ ನ್ಯಾಯತೀರಿಸಿ,</para>
  <para style="q2" vid="ISA 2:4">ಅನೇಕ ಪ್ರಜೆಗಳನ್ನು ಗದರಿಸುವರು.</para>
  <para style="q1" vid="ISA 2:4">ಅವರು ತಮ್ಮ ಖಡ್ಗಗಳನ್ನು ನೇಗಿಲಿನ ಗುಳಗಳನ್ನಾಗಿಯೂ</para>
  <para style="q2" vid="ISA 2:4">ಬರ್ಜಿಗಳನ್ನು ಕುಡುಗೋಲುಗಳನ್ನಾಗಿಯೂ ಮಾಡುವರು.</para>
  <para style="q2" vid="ISA 2:4">ಜನಾಂಗಕ್ಕೆ ವಿರೋಧವಾಗಿ ಜನಾಂಗವು ಖಡ್ಗವನ್ನು ಪ್ರಯೋಗಿಸುವುದಿಲ್ಲ,</para>
  <para style="q1" vid="ISA 2:4">ಇನ್ನು ಮೇಲೆ ಯುದ್ಧಾಭ್ಯಾಸದ ಅಗತ್ಯ ಇರುವುದೇ ಇಲ್ಲ.<verse eid="ISA 2:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 2:5"/>ಯಾಕೋಬಿನ ಮನೆತನದವರೇ ಬನ್ನಿರಿ,</para>
  <para style="q2" vid="ISA 2:5">ಯೆಹೋವ ದೇವರ ಬೆಳಕಿನಲ್ಲಿ ನಡೆಯೋಣ.<verse eid="ISA 2:5"/></para>
  <para style="s1">ಯೆಹೋವ ದೇವರ ದಿನ</para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 2:6"/>ಯಾಕೋಬಿನ ಮನೆತನದವರು</para>
  <para style="q2" vid="ISA 2:6">ಪೂರ್ವದೇಶಗಳ ಮಂತ್ರತಂತ್ರಗಳಲ್ಲಿ ಮಗ್ನರಾಗಿ,</para>
  <para style="q1" vid="ISA 2:6">ಫಿಲಿಷ್ಟಿಯರಂತೆ ಕಣಿ ಹೇಳುವವರಾಗಿಯೂ,</para>
  <para style="q2" vid="ISA 2:6">ಬೇರೆ ದೇಶಗಳವರ ಮಧ್ಯದಲ್ಲಿ ಮೆಚ್ಚಿಕೆಯುಳ್ಳವರಾಗಿಯೂ ಇರುವುದರಿಂದ</para>
  <para style="q2" vid="ISA 2:6">ಈ ನಿನ್ನ ಜನರನ್ನು ತಳ್ಳಿಬಿಟ್ಟಿದ್ದೀರಿ.<verse eid="ISA 2:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 2:7"/>ಅವರ ದೇಶವು ಬೆಳ್ಳಿ ಬಂಗಾರಗಳಿಂದ ತುಂಬಿದೆ.</para>
  <para style="q2" vid="ISA 2:7">ಅವರ ಬೊಕ್ಕಸಗಳಿಗೆ ಮಿತಿಯಿಲ್ಲ.</para>
  <para style="q1" vid="ISA 2:7">ಅವರ ದೇಶವು ಕುದುರೆಗಳಿಂದ ತುಂಬಿದೆ,</para>
  <para style="q2" vid="ISA 2:7">ಅವರ ರಥಗಳಿಗೆ ಮಿತಿಯೇ ಇಲ್ಲ.<verse eid="ISA 2:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 2:8"/>ಅವರ ದೇಶವು ವಿಗ್ರಹಗಳಿಂದ ತುಂಬಿದೆ.</para>
  <para style="q2" vid="ISA 2:8">ತಮ್ಮ ಬೆರಳುಗಳಿಂದ ಮಾಡಿದ</para>
  <para style="q2" vid="ISA 2:8">ತಮ್ಮ ಕೈಕೆಲಸವನ್ನು ಆರಾಧಿಸುವರು.<verse eid="ISA 2:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 2:9"/>ಆದ್ದರಿಂದ ಮನುಷ್ಯರು ನಮ್ರರಾಗುತ್ತಾರೆ;</para>
  <para style="q2" vid="ISA 2:9">ಎಲ್ಲರೂ ತಲೆಬಾಗುತ್ತಾರೆ;</para>
  <para style="q2" vid="ISA 2:9">ಅವರನ್ನು ಕ್ಷಮಿಸಬೇಡಿ.<verse eid="ISA 2:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 2:10"/>ಯೆಹೋವ ದೇವರ ಭಯಕ್ಕೂ,</para>
  <para style="q2" vid="ISA 2:10">ಅವರ ಮಹಿಮೆಯ ಘನತೆಗೂ ಬಂಡೆಗಳಲ್ಲಿ ಸೇರಿಕೋ.</para>
  <para style="q2" vid="ISA 2:10">ಧೂಳಿನಲ್ಲಿ ನೀನು ಅಡಗಿಕೋ.<verse eid="ISA 2:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 2:11"/>ಮನುಷ್ಯನ ಅಹಂಭಾವದ ದೃಷ್ಟಿಯು ಕುಗ್ಗುವುದು.</para>
  <para style="q2" vid="ISA 2:11">ಮನುಷ್ಯರ ಗರ್ವವು ತಗ್ಗುವುದು.</para>
  <para style="q1" vid="ISA 2:11">ಆಗ ಯೆಹೋವ ದೇವರೊಬ್ಬರೇ ಆ ದಿನದಲ್ಲಿ ಉನ್ನತವಾಗಿರುವರು.<verse eid="ISA 2:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 2:12"/>ಸೇನಾಧೀಶ್ವರ ಯೆಹೋವ ದೇವರ ದಿನವು</para>
  <para style="q2" vid="ISA 2:12">ಗರ್ವ ಹಾಗೂ ಅಹಂಭಾವದಿಂದ ತುಂಬಿರುವವರ ಮೇಲೆಯೂ,</para>
  <para style="q1" vid="ISA 2:12">ತನ್ನನ್ನು ಹೆಚ್ಚಿಸಿಕೊಂಡಿರುವ ಪ್ರತಿಯೊಬ್ಬನ ಮೇಲೆಯೂ ಬರುವುದು,</para>
  <para style="q2" vid="ISA 2:12">ದೇವರು ಅವರನ್ನು ತಗ್ಗಿಸುವರು.<verse eid="ISA 2:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="ISA 2:13"/>ಎತ್ತರವಾಗಿ ಬೆಳೆದಿರುವ ಲೆಬನೋನಿನ ಎಲ್ಲಾ ದೇವದಾರು ವೃಕ್ಷಗಳೂ</para>
  <para style="q2" vid="ISA 2:13">ಹಾಗೂ ಬಾಷಾನಿನ ಎಲ್ಲಾ ಏಲಾ ಮರಗಳ ಮೇಲೆಯೂ<verse eid="ISA 2:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="ISA 2:14"/>ಎಲ್ಲಾ ಉನ್ನತವಾಗಿರುವ ಪರ್ವತಗಳು,</para>
  <para style="q2" vid="ISA 2:14">ಎತ್ತರವಾದ ಗುಡ್ಡಗಳು,<verse eid="ISA 2:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="ISA 2:15"/>ಎಲ್ಲಾ ಎತ್ತರವಾದ ಗೋಪುರಗಳು,</para>
  <para style="q2" vid="ISA 2:15">ಭದ್ರವಾದ ಎಲ್ಲಾ ಗೋಡೆಗಳ ಮೇಲೆಯೂ,<verse eid="ISA 2:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="ISA 2:16"/>ಎಲ್ಲಾ ತಾರ್ಷೀಷಿನ ಹಡಗುಗಳು</para>
  <para style="q2" vid="ISA 2:16">ನೋಡತಕ್ಕ ಮನೋಹರವಾದ ಪ್ರತಿಯೊಂದು ನೌಕೆಗಳ ಮೇಲೆಯೂ</para>
  <para style="q1" vid="ISA 2:16">ಆ ದಿನವು ತಪ್ಪದೇ ಬರುವುದು.<verse eid="ISA 2:16"/></para>
  <para style="q2">
    <verse number="17" style="v" sid="ISA 2:17"/>ಜನರ ಅಟ್ಟಹಾಸವು ತಗ್ಗಿಹೋಗುವುದು.</para>
  <para style="q1" vid="ISA 2:17">ಆ ದಿನದಲ್ಲಿ ಯೆಹೋವ ದೇವರೊಬ್ಬರೇ ಉನ್ನತವಾಗಿರುವರು.<verse eid="ISA 2:17"/></para>
  <para style="q2">
    <verse number="18" style="v" sid="ISA 2:18"/>ವಿಗ್ರಹಗಳು ಸಂಪೂರ್ಣವಾಗಿ ಹೋಗಿಬಿಡುವುವು.<verse eid="ISA 2:18"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="ISA 2:19"/>ಯೆಹೋವ ದೇವರು ಭೂಮಿಯನ್ನು ನಡುಗಿಸಲು ಎದ್ದಾಗ,</para>
  <para style="q2" vid="ISA 2:19">ಯೆಹೋವ ದೇವರಿಗೂ ಅವರ ಮಹಿಮೆಗೂ,</para>
  <para style="q1" vid="ISA 2:19">ಅವರ ಘನಕ್ಕೂ ಹೆದರಿ,</para>
  <para style="q2" vid="ISA 2:19">ಬಂಡೆಗಳ ಸಂದುಗಳಿಗೂ,</para>
  <para style="q2" vid="ISA 2:19">ಭೂಮಿಯ ಗವಿಗಳಿಗೂ ಜನರು ಸೇರಿಕೊಳ್ಳುವರು.<verse eid="ISA 2:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="ISA 2:20"/>ಆ ದಿನದಲ್ಲಿ ಮನುಷ್ಯರು ಪೂಜಿಸುವುದಕ್ಕೋಸ್ಕರ ಮಾಡಿಕೊಂಡ</para>
  <para style="q2" vid="ISA 2:20">ಬೆಳ್ಳಿಯ ಬೊಂಬೆಗಳನ್ನೂ ಚಿನ್ನದ ವಿಗ್ರಹಗಳನ್ನೂ</para>
  <para style="q2" vid="ISA 2:20">ಇಲಿ ಬಾವಲಿಗಳಿಗಾಗಿ ಬಿಸಾಡಿಬಿಡುವರು.<verse eid="ISA 2:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="ISA 2:21"/>ಯೆಹೋವ ದೇವರು ಭೂಮಿಯನ್ನು</para>
  <para style="q2" vid="ISA 2:21">ನಡುಗಿಸಲು ಎದ್ದಾಗ,</para>
  <para style="q1" vid="ISA 2:21">ಯೆಹೋವ ದೇವರ ಭಯಕ್ಕೂ,</para>
  <para style="q2" vid="ISA 2:21">ಅವರ ಮಹಿಮೆಯ ಘನಕ್ಕೂ ಹೆದರಿ ಬಂಡೆಗಳ ಸಂದುಗಳಿಗೂ,</para>
  <para style="q2" vid="ISA 2:21">ಎತ್ತರವಾಗಿರುವ ಬಂಡೆಗಳ ಕಡಿದಾದ ಸ್ಥಳಗಳಿಗೂ ಜನರು ನುಗ್ಗುವರು.<verse eid="ISA 2:21"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="22" style="v" sid="ISA 2:22"/>ಉಸಿರು ಇರುವವರೆಗೆ ಬದುಕುವ</para>
  <para style="q2" vid="ISA 2:22">ನರಮಾನವನ ಮೇಲಿನ ಭರವಸೆಯನ್ನು ಬಿಟ್ಟುಬಿಡಿರಿ.</para>
  <para style="q2" vid="ISA 2:22">ಏಕೆಂದರೆ ಅವನ ಗಣನೆ ಎಷ್ಟರವರೆಗೆ?<verse eid="ISA 2:22"/></para>
  <chapter eid="ISA 2"/>
  <chapter number="3" style="c" sid="ISA 3"/>
  <para style="s1">ಯೆರೂಸಲೇಮಿನ ಹಾಗೂ ಯೆಹೂದದ ಮೇಲೆ ನ್ಯಾಯತೀರ್ಪು</para>
  <para style="q1">
    <verse number="1" style="v" sid="ISA 3:1"/>ಇಗೋ, ಕರ್ತನೂ ಸರ್ವಶಕ್ತನೂ ಆಗಿರುವ</para>
  <para style="q2" vid="ISA 3:1">ಯೆಹೋವ ದೇವರೆಂಬ ನಾನು</para>
  <para style="q1" vid="ISA 3:1">ಜೀವನಕ್ಕೆ ಆಧಾರವಾದ ಅನ್ನಪಾನಗಳನ್ನೆಲ್ಲಾ</para>
  <para style="q2" vid="ISA 3:1">ಯೆರೂಸಲೇಮಿನಿಂದಲೂ ಯೆಹೂದದಿಂದಲೂ ತೆಗೆದುಬಿಡುವೆನು.<verse eid="ISA 3:1"/></para>
  <para style="q2">
    <verse number="2" style="v" sid="ISA 3:2"/>ಇದಲ್ಲದೆ ಶೂರ, ಯುದ್ಧಭಟ,</para>
  <para style="q1" vid="ISA 3:2">ನ್ಯಾಯಾಧಿಪತಿ, ಪ್ರವಾದಿ,</para>
  <para style="q2" vid="ISA 3:2">ಶಕುನದವನು, ಹಿರಿಯನು,<verse eid="ISA 3:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 3:3"/>ಸೇನಾಪತಿ, ಅಧಿಕಾರಿ, ಆಲೋಚನಾಪರನು, ತಾಂತ್ರಿಕನು</para>
  <para style="q2" vid="ISA 3:3">ಮತ್ತು ವಾಕ್ಚಾತುರ್ಯವುಳ್ಳವನು ಆಗಿರುವ ಇವರನ್ನೆಲ್ಲಾ ತೆಗೆದುಬಿಡುವೆನು.<verse eid="ISA 3:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 3:4"/>“ಬಾಲಕರನ್ನು ಅವರ ಪ್ರಭುಗಳನ್ನಾಗಿ ಮಾಡಿ,</para>
  <para style="q2" vid="ISA 3:4">ಮಕ್ಕಳು ಅವರ ಮೇಲೆ ಆಳುವಂತೆ ಮಾಡುವೆನು.”<verse eid="ISA 3:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 3:5"/>ಮನುಷ್ಯನಿಗೆ ವಿರೋಧವಾಗಿ ಮನುಷ್ಯನು,</para>
  <para style="q2" vid="ISA 3:5">ನೆರೆಯವನಿಗೆ ವಿರೋಧವಾಗಿ ನೆರೆಯವನು ಹಿಂಸಿಸುವನು.</para>
  <para style="q1" vid="ISA 3:5">ಹುಡುಗನು ವೃದ್ಧನ ವಿರೋಧವಾಗಿಯೂ,</para>
  <para style="q2" vid="ISA 3:5">ನೀಚನು ಘನವಂತನ ವಿರೋಧವಾಗಿಯೂ ಸೊಕ್ಕಿನಿಂದ ವರ್ತಿಸುವರು.<verse eid="ISA 3:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 3:6"/>ಒಬ್ಬನು ತನ್ನ ಸಹೋದರನನ್ನು</para>
  <para style="q2" vid="ISA 3:6">ತಂದೆಯ ಮನೆಯಲ್ಲಿ ಹಿಡಿದು ಹೀಗೆ ಹೇಳುವನು,</para>
  <para style="q1" vid="ISA 3:6">“ನಿನಗೆ ವಸ್ತ್ರವಿದೆ, ನಮ್ಮನ್ನು ನೀನು ಆಳುವವನಾಗು</para>
  <para style="q2" vid="ISA 3:6">ಮತ್ತು ಈ ಹಾಳಾದ ಪಟ್ಟಣವು ನಿನ್ನ ಕೈಕೆಳಗಿರಲಿ.”<verse eid="ISA 3:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 3:7"/>ಆ ದಿನದಲ್ಲಿ ಅವನು ಆಣೆಯಿಟ್ಟು,</para>
  <para style="q2" vid="ISA 3:7">“ನಾನು ಉಪಶಮನ ಮಾಡುವವನಾಗುವುದಿಲ್ಲ.</para>
  <para style="q1" vid="ISA 3:7">ಏಕೆಂದರೆ ನನ್ನ ಮನೆಯಲ್ಲಿ ಅನ್ನವಾಗಲಿ, ವಸ್ತ್ರವಾಗಲಿ ಇಲ್ಲ;</para>
  <para style="q2" vid="ISA 3:7">ನನ್ನನ್ನು ಪ್ರಜಾಧಿಪತಿಯನ್ನಾಗಿ ಮಾಡಬೇಡಿರಿ,” ಎಂದು ಉತ್ತರಿಸುವನು.<verse eid="ISA 3:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 3:8"/>ಏಕೆಂದರೆ ಯೆರೂಸಲೇಮು ಹಾಳಾಗಿದೆ,</para>
  <para style="q2" vid="ISA 3:8">ಯೆಹೂದವು ಬಿದ್ದುಹೋಗಿದೆ.</para>
  <para style="q1" vid="ISA 3:8">ಅವರ ನಡೆನುಡಿಗಳು ಯೆಹೋವ ದೇವರಿಗೆ ವಿರುದ್ಧವಾಗಿ</para>
  <para style="q2" vid="ISA 3:8">ದೇವರ ಪ್ರಭಾವದ ದೃಷ್ಟಿಯನ್ನು ಕೆರಳಿಸುತ್ತಾರೆ.<verse eid="ISA 3:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 3:9"/>ಅವರ ಮುಖಭಾವವೇ ಅವರಿಗೆ ವಿರುದ್ಧವಾಗಿ ಸಾಕ್ಷಿಯಾಗಿದೆ.</para>
  <para style="q2" vid="ISA 3:9">ತಮ್ಮ ಪಾಪವನ್ನು ಸೊದೋಮಿನಂತೆ</para>
  <para style="q2" vid="ISA 3:9">ಮರೆಮಾಡದೆ ಪ್ರಕಟ ಮಾಡುತ್ತಾರೆ.</para>
  <para style="q1" vid="ISA 3:9">ಅವರಿಗೆ ಕಷ್ಟ!</para>
  <para style="q2" vid="ISA 3:9">ಏಕೆಂದರೆ ತಮಗೆ ತಾವೇ ಕೇಡನ್ನು ಪ್ರತೀಕಾರವಾಗಿ ಮಾಡಿಕೊಂಡಿದ್ದಾರೆ.<verse eid="ISA 3:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 3:10"/>ನೀತಿವಂತರಿಗೆ ನೀವು, “ಅವರಿಗೆ ಒಳ್ಳೆಯದಾಗಲಿ!” ಎಂದು ಹೇಳಿರಿ.</para>
  <para style="q2" vid="ISA 3:10">ಏಕೆಂದರೆ ಅವರು ತಮ್ಮ ಕ್ರಿಯೆಗಳ ಫಲವನ್ನು ತಿನ್ನುವರು.<verse eid="ISA 3:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 3:11"/>ಕೆಡುಕರಿಗೆ ಕಷ್ಟ!</para>
  <para style="q2" vid="ISA 3:11">ಅವರಿಗೆ ಕೇಡೇ ಇರಲಿ.</para>
  <para style="q1" vid="ISA 3:11">ಏಕೆಂದರೆ ಅವರ ಕೈಗಳ ಪ್ರತಿಫಲವು</para>
  <para style="q2" vid="ISA 3:11">ಅವರಿಗೆ ಕೊಡಲಾಗುವುದು.<verse eid="ISA 3:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 3:12"/>ನನ್ನ ಪ್ರಜೆಗಳನ್ನು ಹುಡುಗರು ಬಾಧಿಸುವರು.</para>
  <para style="q2" vid="ISA 3:12">ಸ್ತ್ರೀಯರು ಅವರನ್ನು ಆಳುವರು.</para>
  <para style="q1" vid="ISA 3:12">ನನ್ನ ಪ್ರಜೆಗಳೇ, ನಿಮ್ಮನ್ನು ನಡೆಸುವವರು ದಾರಿ ತಪ್ಪಿಸುವವರಾಗಿದ್ದಾರೆ.</para>
  <para style="q2" vid="ISA 3:12">ನೀವು ನಡೆಯುವ ದಾರಿಯನ್ನು ಹಾಳು ಮಾಡಿದ್ದಾರೆ.<verse eid="ISA 3:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="ISA 3:13"/>ನ್ಯಾಯಾಧೀಶರನ್ನು ಯೆಹೋವ ದೇವರು ಸ್ವಾಧೀನಪಡಿಸಿಕೊಂಡಿದ್ದಾರೆ;</para>
  <para style="q2" vid="ISA 3:13">ಅವರು ಜನರನ್ನು ನಿರ್ಣಯಿಸಲು ಎದ್ದರು.<verse eid="ISA 3:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="ISA 3:14"/>ಯೆಹೋವ ದೇವರು ತಮ್ಮ ಪ್ರಜೆಗಳ ಹಿರಿಯರ ಸಂಗಡ,</para>
  <para style="q2" vid="ISA 3:14">ಮತ್ತು ಅವರ ಅಧಿಪತಿಗಳ ಸಂಗಡ ನ್ಯಾಯತೀರಿಸಲು ಪ್ರವೇಶಿಸುವರು.</para>
  <para style="q1" vid="ISA 3:14">ಏಕೆಂದರೆ, “ನೀವು ನನ್ನ ದ್ರಾಕ್ಷಿತೋಟವನ್ನು ತಿಂದುಬಿಟ್ಟಿದ್ದೀರಿ.</para>
  <para style="q2" vid="ISA 3:14">ಬಡವರಿಂದ ಕೊಳ್ಳೆ ಹೊಡೆದದ್ದು ನಿಮ್ಮ ಮನೆಗಳಲ್ಲಿ ಇದೆ.<verse eid="ISA 3:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="ISA 3:15"/>ನೀವು ನನ್ನ ಪ್ರಜೆಯನ್ನು ಹೊಡೆದು, ಚೂರುಗಳನ್ನಾಗಿ ಮಾಡಿ,</para>
  <para style="q2" vid="ISA 3:15">ಬಡವರ ಮುಖಗಳನ್ನು ಹಿಂಡುವುದರ ಅರ್ಥವೇನು?”</para>
  <para style="q2" vid="ISA 3:15">ಎಂದು ಸರ್ವಶಕ್ತ ದೇವರಾದ ಯೆಹೋವ ದೇವರು ವಾದಿಸುತ್ತಾರೆ.<verse eid="ISA 3:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="ISA 3:16"/>ಇದಲ್ಲದೆ ಯೆಹೋವ ದೇವರು ಇಂತೆನ್ನುತ್ತಾರೆ:</para>
  <para style="q2" vid="ISA 3:16">“ಚೀಯೋನ್ ಪುತ್ರಿಯರು ಅಹಂಕಾರಿಗಳಾಗಿದ್ದು,</para>
  <para style="q1" vid="ISA 3:16">ಕತ್ತು ತೂಗುತ್ತಾ,</para>
  <para style="q2" vid="ISA 3:16">ಕಣ್ಣುಗಳನ್ನು ತಿರುಗಿಸುತ್ತಾ,</para>
  <para style="q1" vid="ISA 3:16">ನಾಜೂಕಿನಿಂದ ಹೆಜ್ಜೆ ಇಡುತ್ತಾ,</para>
  <para style="q2" vid="ISA 3:16">ಕಾಲುಗೆಜ್ಜೆ ಜಣಜಣಿಸುತ್ತಾ ನಡೆಯುತ್ತಾರೆ;<verse eid="ISA 3:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="ISA 3:17"/>ಆದ್ದರಿಂದ ಯೆಹೋವ ದೇವರು ಚೀಯೋನ್ ಪುತ್ರಿಯರ ನಡುನೆತ್ತಿಗೆ ಹುಣ್ಣನ್ನು ಅನುಮತಿಸಿ,</para>
  <para style="q2" vid="ISA 3:17">ಅವರನ್ನು ಬೋಳುಮಾಡುವರು.”<verse eid="ISA 3:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="ISA 3:18"/>ಆ ದಿನದಲ್ಲಿ ಯೆಹೋವ ದೇವರು ಅವರ ಕಾಲಂದಿಗೆ, ತುರುಬು ಬಲೆ, ಅರ್ಧಚಂದ್ರ, <verse eid="ISA 3:18"/><verse number="19" style="v" sid="ISA 3:19"/>ಜುಮಕಿ, ಬಳೆ, ಕುಲಾವಿ, ಶಿರವಸ್ತ್ರ, <verse eid="ISA 3:19"/><verse number="20" style="v" sid="ISA 3:20"/>ಕಂಠ ವಸ್ತ್ರ, ಕಾಲ ಸರಪಣಿ, ಡಾಬು, ಸುಗಂಧ ಭರಣಿ, ತಾಯಿತಿ, <verse eid="ISA 3:20"/><verse number="21" style="v" sid="ISA 3:21"/>ಮುದ್ರೆ ಉಂಗುರ, ಮೂಗುತಿ, <verse eid="ISA 3:21"/><verse number="22" style="v" sid="ISA 3:22"/>ಹಬ್ಬದ ಉಡಿಗೆ ತೊಡಿಗೆ, ಮೇಲಂಗಿ, ಶಾಲು, ಕೈಚೀಲ, <verse eid="ISA 3:22"/><verse number="23" style="v" sid="ISA 3:23"/>ಕೈಗನ್ನಡಿ, ನಾರುಮಡಿ, ಮುಡಿ ಮುಕುಟ, ಮೇಲ್ವಸ್ತ್ರ ಈ ಸೊಗಸು ಭೂಷಣಗಳನ್ನೆಲ್ಲಾ ತೆಗೆದುಹಾಕುವರು.<verse eid="ISA 3:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="ISA 3:24"/>ಆಗ ಸುವಾಸನೆಯ ಬದಲಾಗಿ ದುರ್ವಾಸನೆ,</para>
  <para style="q2" vid="ISA 3:24">ನಡುಪಟ್ಟಿಗೆ ಬದಲಾಗಿ ಹಗ್ಗ,</para>
  <para style="q1" vid="ISA 3:24">ಜಡೆಯ ಬದಲಾಗಿ ಬೋಳುತಲೆ,</para>
  <para style="q2" vid="ISA 3:24">ರೇಷ್ಮೆಬಟ್ಟೆಗೆ ಬದಲಾಗಿ ಗೋಣಿತಟ್ಟು,</para>
  <para style="q2" vid="ISA 3:24">ಸೌಂದರ್ಯಕ್ಕೆ ಬದಲಾಗಿ ಬರೆ, ಇವೆಲ್ಲ ಅವರಿಗೆ ಬಂದೊದಗುವುದು.<verse eid="ISA 3:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="ISA 3:25"/>ನಿನ್ನ ಗಂಡಸರು ಖಡ್ಗಕ್ಕೆ ತುತ್ತಾಗುವರು.</para>
  <para style="q2" vid="ISA 3:25">ನಿನ್ನ ಶೂರರು ಯುದ್ಧದಲ್ಲಿ ಬೀಳುವರು.<verse eid="ISA 3:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="ISA 3:26"/>ಚೀಯೋನ್ ಬಾಗಿಲುಗಳಲ್ಲಿ ಪ್ರಲಾಪವು, ದುಃಖವು ತುಂಬಿರುವುದು.</para>
  <para style="q2" vid="ISA 3:26">ಅವಳು ನಿರ್ಗತಿಕಳಾಗಿ ನೆಲದ ಮೇಲೆ ಕುಳಿತುಕೊಳ್ಳುವಳು.<verse eid="ISA 3:26"/></para>
  <chapter eid="ISA 3"/>
  <chapter number="4" style="c" sid="ISA 4"/>
  <para style="q1">
    <verse number="1" style="v" sid="ISA 4:1"/>ಆ ದಿವಸದಲ್ಲಿ ಏಳುಮಂದಿ ಹೆಂಗಸರು</para>
  <para style="q2" vid="ISA 4:1">ಒಬ್ಬ ಮನುಷ್ಯನನ್ನು ಹಿಡಿದು,</para>
  <para style="q1" vid="ISA 4:1">“ನಾವು ಸ್ವಂತವಾಗಿ ದುಡಿದು ಉಣ್ಣುವೆವು,</para>
  <para style="q2" vid="ISA 4:1">ನಾವೇ ಸಂಪಾದಿಸಿ ವಸ್ತ್ರಗಳನ್ನು ಉಟ್ಟುಕೊಳ್ಳುವೆವು,</para>
  <para style="q1" vid="ISA 4:1">ನಮ್ಮ ನಿಂದೆಯನ್ನು ನೀಗಿಸುವುದಕ್ಕೆ</para>
  <para style="q2" vid="ISA 4:1">ನಿನ್ನ ಹೆಸರು ನಮಗಿದ್ದರೆ ಸಾಕು,”</para>
  <para style="q2" vid="ISA 4:1">ಎಂದು ಕೇಳಿಕೊಳ್ಳುವರು.<verse eid="ISA 4:1"/></para>
  <para style="s1">ಯೆಹೋವ ದೇವರ ಕೊಂಬೆ</para>
  <para style="p">
    <verse number="2" style="v" sid="ISA 4:2"/>ಆ ದಿನದಲ್ಲಿ ಯೆಹೋವ ದೇವರ ಕೊಂಬೆಯು ಸುಂದರವಾಗಿಯೂ, ಮಹಿಮೆಯುಳ್ಳದ್ದಾಗಿಯೂ ಇರುವುದು. ಭೂಮಿಯ ಫಲವು ಇಸ್ರಾಯೇಲರಲ್ಲಿ ಉಳಿದವರಿಗೆ ಅಭಿಮಾನವೂ, ರಮ್ಯವಾಗಿಯೂ ಇರುವುದು. <verse eid="ISA 4:2"/><verse number="3" style="v" sid="ISA 4:3"/>ಹೀಗಿರುವಲ್ಲಿ ಚೀಯೋನಿನಲ್ಲಿ ಉಳಿದವರು, ಯೆರೂಸಲೇಮಿನಲ್ಲಿ ಉಳಿದವರು ಹಾಗೂ ಯೆರೂಸಲೇಮಿನಲ್ಲಿ ವಾಸಿಸುವವರೆಂದೂ ದಾಖಲೆಗೊಂಡ ಪ್ರತಿಯೊಬ್ಬರೂ ಪವಿತ್ರರು ಎಂದು ಕರೆಯಲಾಗುವರು. <verse eid="ISA 4:3"/><verse number="4" style="v" sid="ISA 4:4"/>ಯೆಹೋವ ದೇವರು ನ್ಯಾಯತೀರ್ಪಿನ ಆತ್ಮದಿಂದಲೂ, ದಹಿಸುವ ಆತ್ಮದಿಂದಲೂ ಚೀಯೋನಿನ ಪುತ್ರಿಯರ ಕಲ್ಮಷವನ್ನು ತೊಳೆದು, ಯೆರೂಸಲೇಮಿನ ಮೇಲಿನ ರಕ್ತದ ಕಲೆಗಳನ್ನು ತೆಗೆದುಹಾಕುವರು. <verse eid="ISA 4:4"/><verse number="5" style="v" sid="ISA 4:5"/>ಆಗ ಯೆಹೋವ ದೇವರು ಚೀಯೋನ್ ಪರ್ವತದ ಪ್ರತಿಯೊಂದು ನಿವಾಸದ ಮೇಲೂ, ಅದರ ಸಭೆಗಳ ಮೇಲೂ, ಹಗಲಿನಲ್ಲಿ ಹೊಗೆಯನ್ನೂ, ಮೇಘವನ್ನೂ, ಇರುಳಿನಲ್ಲಿ ಪ್ರಜ್ವಲಿಸುವ ಅಗ್ನಿಪ್ರಕಾಶವನ್ನು ಉಂಟುಮಾಡುವರು. ಏಕೆಂದರೆ ದೇವರ ಮಹಿಮೆ ಎಲ್ಲದರ ಮೇಲೆ ಚಪ್ಪರದಂತೆಯೂ ಆವರಿಸುವುದು. <verse eid="ISA 4:5"/><verse number="6" style="v" sid="ISA 4:6"/>ಹಗಲಲ್ಲಿ ಬಿಸಿಲಿಗೆ ನೆರಳಾಗುವ ಹಾಗೂ, ಬಿರುಗಾಳಿಗೂ, ಮಳೆಗೂ ಆಶ್ರಯವನ್ನು ಕೊಡುವ ಮಂಟಪವಾಗಿ ಇರುವುದು.<verse eid="ISA 4:6"/></para>
  <chapter eid="ISA 4"/>
  <chapter number="5" style="c" sid="ISA 5"/>
  <para style="s1">ದ್ರಾಕ್ಷಿತೋಟದ ಹಾಡು</para>
  <para style="q1">
    <verse number="1" style="v" sid="ISA 5:1"/>ನನ್ನ ಪ್ರಿಯನ ದ್ರಾಕ್ಷಿತೋಟದ</para>
  <para style="q2" vid="ISA 5:1">ವಿಷಯವಾದ ಹಾಡನ್ನು</para>
  <para style="q1" vid="ISA 5:1">ನನ್ನ ಪ್ರಾಣ ಪ್ರಿಯನಿಗೆ ನಾನು ಹಾಡುವೆನು.</para>
  <para style="q2" vid="ISA 5:1">ಫಲವತ್ತಾದ ಗುಡ್ಡದ ಬಳಿಯಲ್ಲಿ ನನ್ನ ಅತಿ ಪ್ರಿಯನಿಗೆ ದ್ರಾಕ್ಷಿ ತೋಟವಿದೆ.<verse eid="ISA 5:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 5:2"/>ಅವನು ಅದಕ್ಕೆ ಬೇಲಿಹಾಕಿ, ಅದರೊಳಗಿಂದ ಕಲ್ಲುಗಳನ್ನು ಆರಿಸಿ ತೆಗೆದುಹಾಕಿ,</para>
  <para style="q2" vid="ISA 5:2">ಒಳ್ಳೆಯ ದ್ರಾಕ್ಷಿ ಸಸಿಯನ್ನು ನೆಟ್ಟು,</para>
  <para style="q1" vid="ISA 5:2">ಅದರ ಮಧ್ಯದಲ್ಲಿ ಒಂದು ಬುರುಜನ್ನು ಕಟ್ಟಿ,</para>
  <para style="q2" vid="ISA 5:2">ದ್ರಾಕ್ಷಿ ತೊಟ್ಟಿಯನ್ನು ಕೊರೆಯಿಸಿ,</para>
  <para style="q1" vid="ISA 5:2">ತೋಟವು ಒಳ್ಳೆಯ ದ್ರಾಕ್ಷಿಹಣ್ಣನ್ನು ಕೊಡುವುದೆಂದು ಎದುರುನೋಡುತ್ತಿರಲು,</para>
  <para style="q2" vid="ISA 5:2">ಅದು ಹುಳಿ ಹಣ್ಣನ್ನು ಬಿಟ್ಟಿತು.<verse eid="ISA 5:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 5:3"/>“ಯೆರೂಸಲೇಮಿನ ನಿವಾಸಿಗಳೇ, ಯೆಹೂದದ ಮನುಷ್ಯರೇ,</para>
  <para style="q2" vid="ISA 5:3">ನನಗೂ ನನ್ನ ದ್ರಾಕ್ಷಿ ತೋಟಕ್ಕೂ ನ್ಯಾಯತೀರಿಸಿರಿ ಎಂದು ನಿಮ್ಮನ್ನು ಬೇಡಿಕೊಳ್ಳುತ್ತೇನೆ.<verse eid="ISA 5:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 5:4"/>ನನ್ನ ದ್ರಾಕ್ಷಿತೋಟದಲ್ಲಿ ನಾನು ಮಾಡಿದ್ದಕ್ಕಿಂತ ಇನ್ನೂ ಹೆಚ್ಚಾಗಿ</para>
  <para style="q2" vid="ISA 5:4">ಅದಕ್ಕೆ ಏನು ಮಾಡಬೇಕಾಗಿತ್ತು?</para>
  <para style="q1" vid="ISA 5:4">ಅದು ಒಳ್ಳೆಯ ದ್ರಾಕ್ಷಿ ಫಲವನ್ನು ಫಲಿಸುವುದೆಂದು ನಾನು ನಿರೀಕ್ಷಿಸುತ್ತಿರಲು,</para>
  <para style="q2" vid="ISA 5:4">ಅದು ಹುಳಿ ಹಣ್ಣನ್ನು ಕೊಟ್ಟಿದ್ದು ಏಕೆ?<verse eid="ISA 5:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 5:5"/>ನನ್ನ ದ್ರಾಕ್ಷಿ ತೋಟಕ್ಕೆ</para>
  <para style="q2" vid="ISA 5:5">ನಾನು ಮಾಡುವುದು ಏನೆಂದು ನಾನು ನಿಮಗೆ ತಿಳಿಸುತ್ತೇನೆ.</para>
  <para style="q1" vid="ISA 5:5">ನಾನು ಅದರ ಬೇಲಿಯನ್ನು ತೆಗೆದುಹಾಕುವೆನು.</para>
  <para style="q2" vid="ISA 5:5">ಆಗ ದನಕರುಗಳು ಅದನ್ನು ಮೇಯ್ದುಬಿಡುವುದು.</para>
  <para style="q1" vid="ISA 5:5">ಅದರ ಗೋಡೆಯನ್ನು ಕೆಡವಿಬಿಡುವೆನು,</para>
  <para style="q2" vid="ISA 5:5">ಆಗ ಅದು ತುಳಿದಾಟಕ್ಕೆ ಈಡಾಗುವುದು.<verse eid="ISA 5:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 5:6"/>ಅದನ್ನು ನಾನು ಹಾಳಾಗಲು ಬಿಡುವೆನು.</para>
  <para style="q2" vid="ISA 5:6">ಅದರ ಕುಡಿ ಯಾರೂ ಕತ್ತರಿಸುವುದಿಲ್ಲ, ಅಗೆಯುವುದೂ ಇಲ್ಲ,</para>
  <para style="q2" vid="ISA 5:6">ಅದರಲ್ಲಿ ಮುಳ್ಳು ಕಳೆ ಬೆಳೆಯುವುದು.</para>
  <para style="q1" vid="ISA 5:6">ಅದರ ಮೇಲೆ ಮಳೆ ಸುರಿಸಬಾರದೆಂದು</para>
  <para style="q2" vid="ISA 5:6">ಮೋಡಗಳಿಗೆ ಆಜ್ಞಾಪಿಸುವೆನು.”<verse eid="ISA 5:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 5:7"/>ಸೇನಾಧೀಶ್ವರ ಯೆಹೋವ ದೇವರ ದ್ರಾಕ್ಷಿತೋಟವು</para>
  <para style="q2" vid="ISA 5:7">ಇಸ್ರಾಯೇಲಿನ ಮನೆತನವು.</para>
  <para style="q1" vid="ISA 5:7">ಯೆಹೂದದ ಜನವೋ</para>
  <para style="q2" vid="ISA 5:7">ದೇವರ ಇಷ್ಟದ ಗಿಡವು.</para>
  <para style="q1" vid="ISA 5:7">ಅವರು ನ್ಯಾಯವನ್ನು ನಿರೀಕ್ಷಿಸಲು, ಹಿಂಸೆಯೂ,</para>
  <para style="q2" vid="ISA 5:7">ನೀತಿಯನ್ನು ನಿರೀಕ್ಷಿಸಲು ಗೋಳಾಟವು ಸಿಕ್ಕಿತು.<verse eid="ISA 5:7"/></para>
  <para style="s1">ಶಾಪಗಳೂ, ತೀರ್ಪುಗಳೂ</para>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 5:8"/>ಅಯ್ಯೋ, ಭೂಮಿಯ ಮಧ್ಯದಲ್ಲಿ</para>
  <para style="q2" vid="ISA 5:8">ಒಂಟಿಯಾಗಿ ವಾಸಿಸುವಂತೆ</para>
  <para style="q1" vid="ISA 5:8">ಮನೆಗೆ ಮನೆ ಕೂಡಿಸಿ,</para>
  <para style="q2" vid="ISA 5:8">ಹೊಲಕ್ಕೆ ಹೊಲ ಸೇರಿಸುವ ನಿಮಗೆ ಕಷ್ಟ!<verse eid="ISA 5:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="ISA 5:9"/>ಸೇನಾಧೀಶ್ವರ ಯೆಹೋವ ದೇವರು ನನ್ನ ಕಿವಿಗಳಲ್ಲಿ ಹೇಳುವುದೇನೆಂದರೆ:</para>
  <para style="q1" vid="ISA 5:9">“ನಿಜವಾಗಿಯೂ ದೊಡ್ಡ ಮನೆಗಳು ಬರಿದಾಗುವುವು</para>
  <para style="q2" vid="ISA 5:9">ಸುಂದರ ಭವನಗಳು ನಿವಾಸಿಗಳಿಲ್ಲದೆ ಹಾಳಾಗುವುವು.<verse eid="ISA 5:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 5:10"/>ಹತ್ತು ಎಕರೆ ದ್ರಾಕ್ಷಿತೋಟ ಕೇವಲ ಇಪ್ಪತ್ತೆರಡು ಲೀಟರ್<note caller="+" style="f"><char style="fr" closed="false">5:10 </char><char style="ft" closed="false">ಹೀಬ್ರೂ ಭಾಷೆಯಲ್ಲಿ </char><char style="fqa" closed="false">ಒಂದು ಬತ್, </char><char style="ft" closed="false">ಅಂದರೆ ಸುಮಾರು 22 ಲೀಟರ್</char></note> ದ್ರಾಕ್ಷಾರಸವನ್ನು ಕೊಡುವುದು.</para>
  <para style="q2" vid="ISA 5:10">ಸುಮಾರು ನೂರಾ ಅರವತ್ತು ಕಿಲೋಗ್ರಾಂ<note caller="+" style="f"><char style="fr" closed="false">5:10 </char><char style="ft" closed="false">ಹೀಬ್ರೂ ಭಾಷೆಯಲ್ಲಿ </char><char style="fqa" closed="false">ಒಂದು ಹೋಮೆರ್, </char><char style="ft" closed="false">ಅಂದರೆ ಸುಮಾರು 160 ಕಿಲೋಗ್ರಾಂ</char></note> ಬೀಜಬಿತ್ತಿದರೆ, ಕೇವಲ ಹದಿನಾರು ಕಿಲೋಗ್ರಾಂ<note caller="+" style="f"><char style="fr" closed="false">5:10 </char><char style="ft" closed="false">ಹೀಬ್ರೂ ಭಾಷೆಯಲ್ಲಿ </char><char style="fqa" closed="false">ಒಂದು ಎಫಾ, </char><char style="ft" closed="false">ಅಂದರೆ ಸುಮಾರು 16 ಕಿಲೋಗ್ರಾಂ</char></note> ಧಾನ್ಯ ಮಾತ್ರ ಸಿಗುವುದು.”<verse eid="ISA 5:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 5:11"/>ಮದ್ಯಪಾನವನ್ನು ಅತಿಯಾಗಿ ಕುಡಿಯಲು</para>
  <para style="q2" vid="ISA 5:11">ಬೆಳಗಿನ ಜಾವದಲ್ಲಿ ಎದ್ದು</para>
  <para style="q1" vid="ISA 5:11">ರಾತ್ರಿವರೆಗೂ ದ್ರಾಕ್ಷಾರಸದಿಂದ ಅಮಲೇರಿದವರಾಗಿ</para>
  <para style="q2" vid="ISA 5:11">ಕಾಲಕಳೆಯುವವರಿಗೆ ಕಷ್ಟ!<verse eid="ISA 5:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 5:12"/>ಅವರ ಹಬ್ಬಗಳಲ್ಲಿ ಕಿನ್ನರಿ, ವೀಣೆ,</para>
  <para style="q2" vid="ISA 5:12">ದಮ್ಮಡಿ, ಕೊಳಲು ಮತ್ತು ಮದ್ಯಪಾನ ಇರುವುವು.</para>
  <para style="q1" vid="ISA 5:12">ಆದರೆ ಯೆಹೋವ ದೇವರ ಕೆಲಸವನ್ನು ಅವರು ಲಕ್ಷಿಸರು ಇಲ್ಲವೆ</para>
  <para style="q2" vid="ISA 5:12">ಅವರ ಕೈಗೆಲಸವನ್ನು ಲಕ್ಷಿಸುವುದಿಲ್ಲ.<verse eid="ISA 5:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="ISA 5:13"/>ಆದಕಾರಣ ನನ್ನ ಜನರು ಜ್ಞಾನಹೀನರಾಗಿ</para>
  <para style="q2" vid="ISA 5:13">ಸೆರೆಗೆ ಹೋದರು;</para>
  <para style="q1" vid="ISA 5:13">ಅವರ ಘನವಂತರು ಹಸಿವಿನಿಂದ ಸಾಯುವರು,</para>
  <para style="q2" vid="ISA 5:13">ಹಾಗೆ ಜನಸಮೂಹವು ಬಾಯಾರಿಕೆಯಿಂದ ಒಣಗುವುದು.<verse eid="ISA 5:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="ISA 5:14"/>ಹೀಗಿರುವುದರಿಂದ ಪಾತಾಳವು ತನಗೆ ತಾನೇ ದೊಡ್ಡದಾಗಿ ಮಿತಿಯಿಲ್ಲದಷ್ಟು</para>
  <para style="q2" vid="ISA 5:14">ತನ್ನ ಬಾಯಿಯನ್ನು ತೆರೆಯಲು</para>
  <para style="q1" vid="ISA 5:14">ಅವರ ವೈಭವ, ಸಮೂಹ, ಕೋಲಾಹಲ, ಉಲ್ಲಾಸಪಡುವುದು</para>
  <para style="q2" vid="ISA 5:14">ಇವೆಲ್ಲವೂ ಅದರಲ್ಲಿ ಬೀಳುವುವು.<verse eid="ISA 5:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="ISA 5:15"/>ನರಮಾನವರು ತಗ್ಗಿಹೋಗುವರು.</para>
  <para style="q2" vid="ISA 5:15">ಅಹಂಭಾವದ ಕಣ್ಣುಗಳು ಕಂಗೆಡುವುವು.<verse eid="ISA 5:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="ISA 5:16"/>ಆದರೆ ಸೇನಾಧೀಶ್ವರ ಯೆಹೋವ ದೇವರು ನ್ಯಾಯತೀರ್ಪಿನಲ್ಲಿ ಉನ್ನತವಾಗಿರುವರು.</para>
  <para style="q2" vid="ISA 5:16">ಪರಿಶುದ್ಧ ದೇವರು ತಮ್ಮ ನ್ಯಾಯದಲ್ಲಿ ಪರಿಶುದ್ಧರೆಂದು ಕಾಣಿಸಿಕೊಳ್ಳುವರು.<verse eid="ISA 5:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="ISA 5:17"/>ಪಟ್ಟಣ ಪ್ರದೇಶಗಳು ಹಾಳಾಗಿ ಮೇಕೆಮರಿಗಳಿಗೆ ಹುಲ್ಲುಗಾವಲುಗಳಾಗುವುವು.</para>
  <para style="q2" vid="ISA 5:17">ಕುರಿಮರಿಗಳು ಅಲ್ಲಿ ಮೇಯುವುವು.<verse eid="ISA 5:17"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="18" style="v" sid="ISA 5:18"/>ಅಯ್ಯೋ, ವ್ಯರ್ಥವಾದ ಹಗ್ಗಗಳಿಂದ ಅಪರಾಧವನ್ನೂ,</para>
  <para style="q2" vid="ISA 5:18">ಬಂಡಿಹಗ್ಗದಿಂದಲೋ ಎಂಬಂತೆ ಪಾಪವನ್ನೂ ಎಳೆದು,<verse eid="ISA 5:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="ISA 5:19"/>ನಾವು ಅವರ ಕೆಲಸವನ್ನು ನೋಡುವಂತೆ,</para>
  <para style="q2" vid="ISA 5:19">“ದೇವರು ತ್ವರೆಯಾಗಿ</para>
  <para style="q2" vid="ISA 5:19">ಅದನ್ನು ಬೇಗನೆ ಮಾಡಲಿ.</para>
  <para style="q1" vid="ISA 5:19">ನಾವು ಇಸ್ರಾಯೇಲಿನ ಪರಿಶುದ್ಧರ</para>
  <para style="q2" vid="ISA 5:19">ಆಲೋಚನೆಯನ್ನು ತಿಳಿದುಕೊಳ್ಳುವ ಹಾಗೆ</para>
  <para style="q2" vid="ISA 5:19">ಅದು ಸಮೀಪಿಸಿ ಬರಲಿ ಎಂದು ಹೇಳುವವರಿಗೆ ಕಷ್ಟ!”<verse eid="ISA 5:19"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="20" style="v" sid="ISA 5:20"/>ಕೇಡಿಗೆ ಮೇಲೆಂದೂ, ಮೇಲಿಗೆ ಕೇಡೆಂದೂ ಕರೆದು,</para>
  <para style="q2" vid="ISA 5:20">ಕತ್ತಲೆಯನ್ನು ಬೆಳಕೆಂದೂ,</para>
  <para style="q1" vid="ISA 5:20">ಬೆಳಕನ್ನು ಕತ್ತಲೆಯೆಂದೂ;</para>
  <para style="q2" vid="ISA 5:20">ಕಹಿಯನ್ನು ಸಿಹಿ ಎಂದೂ,</para>
  <para style="q2" vid="ISA 5:20">ಸಿಹಿಯನ್ನು ಕಹಿ ಎಂದೂ ಎಣಿಸುವವರಿಗೆ ಕಷ್ಟ!<verse eid="ISA 5:20"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="21" style="v" sid="ISA 5:21"/>ತಮ್ಮ ಸ್ವಂತ ಕಣ್ಣುಗಳಲ್ಲಿ ಜ್ಞಾನಿಗಳು</para>
  <para style="q2" vid="ISA 5:21">ತಮ್ಮ ಸ್ವಂತ ದೃಷ್ಟಿಯಲ್ಲಿ ವಿವೇಕಿಗಳು ಆಗಿರುವವರಿಗೆ ಕಷ್ಟ!<verse eid="ISA 5:21"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="22" style="v" sid="ISA 5:22"/>ಅಯ್ಯೋ, ದ್ರಾಕ್ಷಾರಸ ಕುಡಿಯುವುದರಲ್ಲಿ ಶೂರರೂ,</para>
  <para style="q2" vid="ISA 5:22">ಮದ್ಯ ಸಾಹಸಿಗಳೂ,<verse eid="ISA 5:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="ISA 5:23"/>ಲಂಚಕ್ಕೋಸ್ಕರ ದುಷ್ಟನನ್ನು ನೀತಿವಂತನೆಂದು ನಿರ್ಣಯಿಸಿ,</para>
  <para style="q2" vid="ISA 5:23">ನೀತಿಯನ್ನು ನೀತಿವಂತನಿಂದ ತೆಗೆದು ಹಾಕುವವರಿಗೂ ಕಷ್ಟ!<verse eid="ISA 5:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="ISA 5:24"/>ಏಕೆಂದರೆ ಅವರು ಸೇನಾಧೀಶ್ವರ ಯೆಹೋವ ದೇವರ ನಿಯಮವನ್ನು ನಿರಾಕರಿಸಿದ್ದರಿಂದಲೂ,</para>
  <para style="q2" vid="ISA 5:24">ಇಸ್ರಾಯೇಲಿನ ಪರಿಶುದ್ಧರ ವಾಕ್ಯವನ್ನು ಅಸಡ್ಡೆ ಮಾಡಿದ್ದರಿಂದಲೂ</para>
  <para style="q1" vid="ISA 5:24">ಬೆಂಕಿಯು ಕೊಳ್ಳಿಯನ್ನು ನುಂಗಿ ಬಿಡುವ ಹಾಗೆಯೂ,</para>
  <para style="q2" vid="ISA 5:24">ಜ್ವಾಲೆಯು ಒಣಹುಲ್ಲನ್ನು ಸುಟ್ಟುಬಿಡುವಂತೆಯೂ,</para>
  <para style="q1" vid="ISA 5:24">ಅದರ ಬೇರು ಕೊಳೆಯುವಂತೆಯೂ,</para>
  <para style="q2" vid="ISA 5:24">ಚಿಗುರು ಅದರ ಧೂಳಿನಂತೆಯೂ ಏರಿ ಹೋಗುವುವು.<verse eid="ISA 5:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="ISA 5:25"/>ಆದಕಾರಣ ಯೆಹೋವ ದೇವರು ಕೋಪಗೊಂಡು ಜನರಿಗೆ ವಿರೋಧವಾಗಿ ಉರಿಗೊಂಡು</para>
  <para style="q2" vid="ISA 5:25">ಅವರ ಮೇಲೆ ತಮ್ಮ ಕೈಚಾಚಿ, ಅವರನ್ನು ಹೊಡೆದಿದ್ದಾರೆ,</para>
  <para style="q1" vid="ISA 5:25">ಬೆಟ್ಟಗುಡ್ಡಗಳು ಕಂಪಿಸಿದವು.</para>
  <para style="q2" vid="ISA 5:25">ಅವರ ಹೆಣಗಳು ಹರಿದು ಬೀದಿಗಳ ಮಧ್ಯದಲ್ಲಿ ಬಿದ್ದಿರುವುವು.</para>
  <para style="b" vid="ISA 5:25"/>
  <para style="q1" vid="ISA 5:25">ಇಷ್ಟೆಲ್ಲಾ ಆದರೂ ದೇವರ ಕೋಪವು ತೀರದೆ,</para>
  <para style="q2" vid="ISA 5:25">ಅವರ ಕೈ ಇನ್ನೂ ಚಾಚಿಯೇ ಇರುವುದು.<verse eid="ISA 5:25"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="26" style="v" sid="ISA 5:26"/>ಅವರು ದೂರದ ಜನಾಂಗದವರಿಗೆ</para>
  <para style="q2" vid="ISA 5:26">ಗುರುತಿಗಾಗಿ ಧ್ವಜವನ್ನೆತ್ತಿ,</para>
  <para style="q1" vid="ISA 5:26">ಭೂಮಿಯ ಕಟ್ಟಕಡೆಯಿಂದ ಅವರಿಗೆ ಸೀಟಿ ಹಾಕುವರು.</para>
  <para style="q2" vid="ISA 5:26">ಇಗೋ, ಅವರು ತ್ವರೆಯಾಗಿ ಫಕ್ಕನೆ ಬರುವರು,<verse eid="ISA 5:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="ISA 5:27"/>ಅವರಲ್ಲಿ ಯಾರೂ ದಣಿದು ಮುಗ್ಗರಿಸರು,</para>
  <para style="q2" vid="ISA 5:27">ಅವರು ತೂಕಡಿಸುವುದಿಲ್ಲ, ನಿದ್ರಿಸುವುದಿಲ್ಲ,</para>
  <para style="q1" vid="ISA 5:27">ಅವರ ನಡುಕಟ್ಟು ಬಿಚ್ಚಿಕೊಳ್ಳುವುದಿಲ್ಲ.</para>
  <para style="q2" vid="ISA 5:27">ಕೆರದ ಬಾರು ಹರಿಯುವುದಿಲ್ಲ.<verse eid="ISA 5:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="ISA 5:28"/>ಅವರ ಬಾಣಗಳು ಹದವಾಗಿವೆ.</para>
  <para style="q2" vid="ISA 5:28">ಅವರ ಬಿಲ್ಲುಗಳು ಬಿಗಿದಿವೆ,</para>
  <para style="q1" vid="ISA 5:28">ಅವರ ಕುದುರೆಗಳ ಗೊರಸುಗಳು ಕಲ್ಲಿನಂತೆಯೂ,</para>
  <para style="q2" vid="ISA 5:28">ಅವರ ರಥಗಳ ಚಕ್ರಗಳು ಬಿರುಗಾಳಿಯಂತೆಯೂ ರಭಸವಾಗಿವೆ.<verse eid="ISA 5:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="ISA 5:29"/>ಅವರ ಗರ್ಜನೆಯು ಸಿಂಹ ಆರ್ಭಟಿಸಿದಂತಿದೆ.</para>
  <para style="q2" vid="ISA 5:29">ಪ್ರಾಯದ ಸಿಂಹ ಆರ್ಭಟಿಸಿದಂತಿದೆ.</para>
  <para style="q1" vid="ISA 5:29">ಹೌದು, ಗರ್ಜಿಸುತ್ತಾ ಬೇಟೆಹಿಡಿದು ಭದ್ರವಾಗಿ ಹೊತ್ತುಕೊಂಡು ಹೋಗುತ್ತಾರೆ,</para>
  <para style="q2" vid="ISA 5:29">ಅದನ್ನು ಬಿಡಿಸುವವನು ಒಬ್ಬನೂ ಇಲ್ಲ.<verse eid="ISA 5:29"/></para>
  <para style="q1">
    <verse number="30" style="v" sid="ISA 5:30"/>ಆ ದಿನದಲ್ಲಿ ಅವರು ಸಮುದ್ರವು ಭೋರ್ಗರೆಯುವಂತೆ</para>
  <para style="q2" vid="ISA 5:30">ಅದರ ಮೇಲೆ ಗರ್ಜಿಸುವರು.</para>
  <para style="q1" vid="ISA 5:30">ಭೂಮಿಯನ್ನು ದೃಷ್ಟಿಸಿದರೆ ಅಂಧಕಾರವನ್ನೂ,</para>
  <para style="q2" vid="ISA 5:30">ದುಃಖವನ್ನೂ ನೋಡುವೆ.</para>
  <para style="q2" vid="ISA 5:30">ಸೂರ್ಯ ಕೂಡ ಮೋಡಗಳಿಂದ ಕಪ್ಪಾಗುವುದು.<verse eid="ISA 5:30"/></para>
  <chapter eid="ISA 5"/>
  <chapter number="6" style="c" sid="ISA 6"/>
  <para style="s1">ಯೆಶಾಯನ ಆಯೋಗ</para>
  <para style="p">
    <verse number="1" style="v" sid="ISA 6:1"/>ಅರಸನಾದ ಉಜ್ಜೀಯನು ಮರಣ ಹೊಂದಿದ ವರುಷದಲ್ಲಿ ಯೆಹೋವ ದೇವರು ಉನ್ನತೋನ್ನತವಾಗಿ ಸಿಂಹಾಸನದ ಮೇಲೆ ಕೂತಿರುವುದನ್ನು ಕಂಡೆನು. ಅವರ ವಸ್ತ್ರದ ನೆರಿಗೆಯು ಮಂದಿರದಲ್ಲೆಲ್ಲಾ ಹರಡಿತ್ತು. <verse eid="ISA 6:1"/><verse number="2" style="v" sid="ISA 6:2"/>ಅವರ ಮೇಲೆ ಸೆರಾಫಿಯರು ನಿಂತಿದ್ದರು. ಪ್ರತಿಯೊಬ್ಬನಿಗೂ ಆರು ರೆಕ್ಕೆಗಳಿದ್ದವು. ಎರಡರಿಂದ ತನ್ನ ಮುಖವನ್ನು, ಎರಡರಿಂದ ತನ್ನ ಕಾಲುಗಳನ್ನು ಮುಚ್ಚಿಕೊಂಡು ಇನ್ನೆರಡು ರೆಕ್ಕೆಗಳಿಂದ ಹಾರುತ್ತಿದ್ದರು. <verse eid="ISA 6:2"/><verse number="3" style="v" sid="ISA 6:3"/>ಅವರಲ್ಲಿ ಒಬ್ಬನು ಮತ್ತೊಬ್ಬನಿಗೆ,</para>
  <para style="q1" vid="ISA 6:3">“ಸೇನಾಧೀಶ್ವರ ಯೆಹೋವ ದೇವರು ಪರಿಶುದ್ಧರು, ಪರಿಶುದ್ಧರು, ಪರಿಶುದ್ಧರು.</para>
  <para style="q2" vid="ISA 6:3">ಭೂಮಂಡಲವೆಲ್ಲಾ ಅವರ ಮಹಿಮೆಯಿಂದ ತುಂಬಿದೆ,” ಎಂದು ಕೂಗಿ ಹೇಳಿದನು.<verse eid="ISA 6:3"/></para>
  <para style="m">
    <verse number="4" style="v" sid="ISA 6:4"/>ಕೂಗುವವನ ಸ್ವರಕ್ಕೆ ದ್ವಾರದ ನಿಲುವುಗಳು ಕದಲಿದವು; ಧೂಮವು ಆಲಯವನ್ನೆಲ್ಲ ತುಂಬಿತು.<verse eid="ISA 6:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="ISA 6:5"/>ಆಗ ನಾನು, “ಅಯ್ಯೋ, ನಾನು ನಾಶವಾದೆನಲ್ಲಾ! ಏಕೆಂದರೆ, ನಾನು ಅಶುದ್ಧ ತುಟಿಯವನು. ನಾನು ಅಶುದ್ಧ ತುಟಿಯುಳ್ಳವರ ಮಧ್ಯದಲ್ಲಿ ವಾಸಿಸುವವನು. ನನ್ನ ಕಣ್ಣುಗಳು ರಾಜಾಧಿರಾಜರೂ ಸೇನಾಧೀಶ್ವರ ಯೆಹೋವ ದೇವರನ್ನು ಕಂಡವು!” ಎಂದೆನು.<verse eid="ISA 6:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="ISA 6:6"/>ಆಗ ಸೆರಾಫಿಯರಲ್ಲಿ ಒಬ್ಬನು ಬಲಿಪೀಠದಿಂದ ತಾನು ಉರಿಯುವ ಕೆಂಡವನ್ನು ತನ್ನ ಕೈಯಲ್ಲಿ ಹಿಡಿದುಕೊಂಡು ಹಾರಿ ಬಂದು, <verse eid="ISA 6:6"/><verse number="7" style="v" sid="ISA 6:7"/>ಅದರಿಂದ ನನ್ನ ಬಾಯಿಗೆ ಮುಟ್ಟಿಸಿ, “ಇಗೋ, ಇದು ನಿನ್ನ ತುಟಿಗಳನ್ನು ತಗಲಿದೆ. ನಿನ್ನ ದೋಷವು ತೊಲಗಿದೆ, ನಿನ್ನ ಪಾಪಪರಿಹಾರ ಆಯಿತು,” ಎಂದು ಹೇಳಿದನು.<verse eid="ISA 6:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="ISA 6:8"/>ಆಗ, “ಯಾರನ್ನು ಕಳುಹಿಸಲಿ, ಯಾರು ನಮಗೋಸ್ಕರ ಹೋಗುವರು?” ಎಂಬ ಯೆಹೋವ ದೇವರ ನುಡಿಯನ್ನು ನಾನು ಕೇಳಿ,</para>
  <para style="p" vid="ISA 6:8">“ಇಗೋ, ನಾನು ಸಿದ್ಧ, ನನ್ನನ್ನು ಕಳುಹಿಸಿರಿ,” ಎಂದೆನು.<verse eid="ISA 6:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="ISA 6:9"/>ಅದಕ್ಕೆ ಅವರು, “ನೀನು ಈ ಜನರ ಬಳಿಗೆ ಹೋಗಿ:</para>
  <para style="q1" vid="ISA 6:9">“ ‘ನೀವು ಕೇಳುತ್ತಲೇ ಇರುವಿರಿ, ಎಂದೆಂದೂ ಅರ್ಥಮಾಡಿಕೊಳ್ಳಲಾರಿರಿ;</para>
  <para style="q2" vid="ISA 6:9">ನೀವು ಕಾಣುತ್ತಲೇ ಇರುವಿರಿ, ಎಂದೆಂದೂ ಅರಿತುಕೊಳ್ಳಲಾರಿರಿ,’<verse eid="ISA 6:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 6:10"/>ತಮ್ಮ ಕಣ್ಣುಗಳಿಂದ ನೋಡದಂತೆಯೂ,</para>
  <para style="q2" vid="ISA 6:10">ತಮ್ಮ ಕಿವಿಗಳಿಂದ ಕೇಳದಂತೆಯೂ,</para>
  <para style="q2" vid="ISA 6:10">ತಮ್ಮ ಹೃದಯದಿಂದ ಗ್ರಹಿಸಿ</para>
  <para style="q1" vid="ISA 6:10">ತಿರುಗಿಕೊಂಡು ಸ್ವಸ್ಥವಾಗದಂತೆಯೂ</para>
  <para style="q2" vid="ISA 6:10">ಈ ಜನರ ಹೃದಯವನ್ನು ಕಠಿಣಗೊಳಿಸಿ,</para>
  <para style="q2" vid="ISA 6:10">ಅವರ ಕಿವಿಯನ್ನು ಮಂದಗೊಳಿಸಿ,</para>
  <para style="q1" vid="ISA 6:10">ಅವರ ಕಣ್ಣುಗಳನ್ನು ಮೊಬ್ಬಾಗಿಸು,”</para>
  <para style="q2" vid="ISA 6:10">ಎಂದು ನನಗೆ ಹೇಳಿದರು.<verse eid="ISA 6:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="ISA 6:11"/>ಆಗ ನಾನು, “ಯೆಹೋವ ದೇವರೇ, ಇದು ಎಷ್ಟರವರೆಗೆ?” ಎಂದೆನು.</para>
  <para style="p" vid="ISA 6:11">ಅದಕ್ಕೆ ಅವರು ಹೀಗೆ ಉತ್ತರಕೊಟ್ಟರು,</para>
  <para style="q1" vid="ISA 6:11">“ಪಟ್ಟಣಗಳು ನಿವಾಸಿಗಳಿಲ್ಲದೆ,</para>
  <para style="q2" vid="ISA 6:11">ಮನೆಗಳು ಮನುಷ್ಯನಿಲ್ಲದೆ,</para>
  <para style="q1" vid="ISA 6:11">ಹೊಲಗಳು ಸಂಪೂರ್ಣವಾಗಿ ಹಾಳಾಗುವವರೆಗೂ,<verse eid="ISA 6:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 6:12"/>ಯೆಹೋವ ದೇವರಾದ ನಾನು ಮನುಷ್ಯರನ್ನು ದೂರ ಮಾಡುವವರೆಗೂ,</para>
  <para style="q2" vid="ISA 6:12">ಅವರನ್ನು ದೇಶದ ಮಧ್ಯದಿಂದ ತೊಲಗಿಸಿಬಿಡುವವರೆಗೂ ಅದು ಹೀಗಿರುವುದು.<verse eid="ISA 6:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="ISA 6:13"/>ಆದರೆ ದೇಶದಲ್ಲಿ ಹತ್ತನೆಯ ಪಾಲು ಉಳಿದಿದ್ದರೂ,</para>
  <para style="q2" vid="ISA 6:13">ಅದು ಕೂಡ ನಾಶವಾಗುವುದು.</para>
  <para style="q1" vid="ISA 6:13">ಏಲಾ ಮರವನ್ನಾಗಲೀ,</para>
  <para style="q2" vid="ISA 6:13">ಅಲ್ಲೋನ್ ಮರವನ್ನಾಗಲೀ ಕಡಿದ ಮೇಲೆ</para>
  <para style="q2" vid="ISA 6:13">ಉಳಿಯುವುದು ಬುಡ ಮಾತ್ರ. ಅದೇ ರೀತಿಯಾಗಿ</para>
  <para style="q2" vid="ISA 6:13">ಪವಿತ್ರ ಜನರು ದೇಶದಲ್ಲಿ ಬುಡವಾಗಿ ಉಳಿದಿರುವರು.”<verse eid="ISA 6:13"/></para>
  <chapter eid="ISA 6"/>
  <chapter number="7" style="c" sid="ISA 7"/>
  <para style="s1">ಇಮ್ಮಾನುಯೇಲನ ಸಂಕೇತ</para>
  <para style="p">
    <verse number="1" style="v" sid="ISA 7:1"/>ಯೋತಾಮನ ಮಗನೂ, ಉಜ್ಜೀಯನ ಮೊಮ್ಮಗನೂ, ಯೆಹೂದದ ಅರಸನೂ ಆದ ಆಹಾಜನ ಕಾಲದಲ್ಲಿ, ಅರಾಮ್ಯರ ಅರಸನಾದ ರೆಚೀನ, ರೆಮಲ್ಯನ ಮಗನೂ, ಇಸ್ರಾಯೇಲರ ಅರಸನೂ ಆದ ಪೆಕಹ ಎಂಬುವರು ಯೆರೂಸಲೇಮಿನ ವಿರುದ್ಧವಾಗಿ ಯುದ್ಧಕ್ಕೆ ಹೋದರು. ಆದರೆ ಅದನ್ನು ಜಯಿಸಲು ಸಾಧ್ಯವಾಗಲಿಲ್ಲ.<verse eid="ISA 7:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="ISA 7:2"/>ಸಿರಿಯಾದವರು ಎಫ್ರಾಯೀಮ್ಯರೊಂದಿಗೆ ಜತೆಗೂಡಿದ್ದಾರೆಂದು ದಾವೀದನ ವಂಶದವರಿಗೆ ತಿಳಿದಾಗ, ಆಹಾಜನ ಮತ್ತು ಅವರ ಪ್ರಜೆಯ ಹೃದಯವು ಅರಣ್ಯದ ಮರಗಳು ಗಾಳಿಗೆ ಅಲುಗಾಡುವಂತೆ ನಡುಗಿದವು.<verse eid="ISA 7:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="ISA 7:3"/>ಆಗ ಯೆಹೋವ ದೇವರು ಯೆಶಾಯನಿಗೆ, “ನೀನು ನಿನ್ನ ಮಗ ಶೆಯಾರ್ ಯಾಶೂಬನನ್ನು ಕರೆದುಕೊಂಡು ಹೋಗಿ, ಅಗಸರ ಹೊಲದ ಮೇಲೆ ಹೋಗುವ ದಾರಿಯಲ್ಲಿ ಮೇಲಿನ ಕೆರೆಯ ಕಾಲುವೆಯ ಕೊನೆಯ ಹತ್ತಿರ ಆಹಾಜನನ್ನು ಎದುರುಗೊಳ್ಳು. <verse eid="ISA 7:3"/><verse number="4" style="v" sid="ISA 7:4"/>ಅವನಿಗೆ, ಈ ಪ್ರಕಾರ ಹೇಳಬೇಕು: ‘ಜಾಗರೂಕನಾಗಿ ಸುಮ್ಮನಿರು, ಭಯಪಡಬೇಡ. ರೆಚೀನ, ಅರಾಮ್ಯರು, ಮತ್ತು ರೆಮಲ್ಯನ ಮಗ ಇವರ ಕೋಪವು ಎಷ್ಟು ಹೆಚ್ಚಿದರೂ ಹೊಗೆಯಾಡುವ ಈ ಎರಡು ಮೋಟುಕೊಳ್ಳಿಗಳಿಗೆ ನಿನ್ನ ಹೃದಯವು ಕುಂದದಿರಲಿ. <verse eid="ISA 7:4"/><verse number="5" style="v" sid="ISA 7:5"/>ಏಕೆಂದರೆ, ಸಿರಿಯಾದವರೂ ಎಫ್ರಾಯೀಮಿನವರೂ ರೆಮಲ್ಯನ ಮಗನೂ ನಿನಗೆ ವಿರೋಧವಾಗಿ ಒಳಸಂಚುಮಾಡಿ, <verse eid="ISA 7:5"/><verse number="6" style="v" sid="ISA 7:6"/>“ನಾವು ಯೆಹೂದಕ್ಕೆ ವಿರೋಧವಾಗಿ ಹೋಗಿ, ಅದನ್ನು ವ್ಯಥೆಪಡಿಸಿ, ಅದರಲ್ಲಿ ನಮಗಾಗಿ ಮಾಡಿಕೊಂಡಿರುವ ಒಪ್ಪಂದವನ್ನು ಉಲ್ಲಂಘಿಸಿ, ಅದರ ಮಧ್ಯದಲ್ಲಿ ಒಬ್ಬ ಅರಸನನ್ನು ಅಂದರೆ ಟಾಬೆಯೇಲನ ಮಗನನ್ನು ನೇಮಿಸಿಕೊಳ್ಳೋಣ,” ಎಂದುಕೊಂಡಿದ್ದಾರೆ. <verse eid="ISA 7:6"/><verse number="7" style="v" sid="ISA 7:7"/>ಅದಕ್ಕೆ ಸಾರ್ವಭೌಮ ಯೆಹೋವ ದೇವರು,</para>
  <para style="q1" vid="ISA 7:7">“ ‘ಅದು ನಿಲ್ಲುವುದಿಲ್ಲ,</para>
  <para style="q2" vid="ISA 7:7">ಅದು ಆಗುವುದೇ ಇಲ್ಲ.<verse eid="ISA 7:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 7:8"/>ಏಕೆಂದರೆ, ದಮಸ್ಕವು ಸಿರಿಯಾದ ರಾಜಧಾನಿ</para>
  <para style="q2" vid="ISA 7:8">ಮತ್ತು ದಮಸ್ಕದ ತಲೆಯು ರೆಚೀನ ಮಾತ್ರ,</para>
  <para style="q1" vid="ISA 7:8">ಅರವತ್ತೈದು ವರುಷಗಳೊಳಗೆ</para>
  <para style="q2" vid="ISA 7:8">ಎಫ್ರಾಯೀಮರು ರಾಷ್ಟ್ರವಾಗದೆ ಭಂಗಪಡುವರು.<verse eid="ISA 7:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 7:9"/>ಎಫ್ರಾಯೀಮಿನ ರಾಜಧಾನಿ ಸಮಾರ್ಯ.</para>
  <para style="q2" vid="ISA 7:9">ಸಮಾರ್ಯದ ರಾಜಧಾನಿ ರೆಮಲ್ಯನ ಮಗನು.</para>
  <para style="q1" vid="ISA 7:9">ನೀವು ನಂಬದೆ ಹೋದರೆ</para>
  <para style="q2" vid="ISA 7:9">ನೀವು ನಿಜವಾಗಿಯೂ ನೆಲೆಗೊಳ್ಳುವುದಿಲ್ಲ,’ ಎಂದು ಹೇಳುತ್ತಾರೆ.”<verse eid="ISA 7:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="ISA 7:10"/>ಯೆಹೋವ ದೇವರು ಆಹಾಜನಿಗೆ ಹೇಳಿದ್ದೇನೆಂದರೆ: <verse eid="ISA 7:10"/><verse number="11" style="v" sid="ISA 7:11"/>“ನಿನ್ನ ದೇವರಾದ ಯೆಹೋವ ದೇವರಿಂದ ಒಂದು ಗುರುತನ್ನು ಕೇಳು. ಅದು ಕೆಳಗೆ ಆಳದಲ್ಲಿದ್ದರೂ, ಮೇಲೆ ಎತ್ತರಲ್ಲಿದ್ದರೂ ಅದನ್ನು ಕೇಳಿಕೋ,” ಎಂದು ಹೇಳಿದರು.<verse eid="ISA 7:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="ISA 7:12"/>ಆದರೆ ಆಹಾಜನು, “ನಾನು ಕೇಳಿಕೊಳ್ಳುವುದಿಲ್ಲ; ಯೆಹೋವ ದೇವರನ್ನು ಪರೀಕ್ಷಿಸುವುದೂ ಇಲ್ಲ” ಎಂದನು.<verse eid="ISA 7:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="ISA 7:13"/>ಅದಕ್ಕೆ ಯೆಶಾಯನು, “ದಾವೀದನ ವಂಶದವರೇ! ಈಗ ಕೇಳಿರಿ, ಮನುಷ್ಯರ ತಾಳ್ಮೆಯನ್ನು ಪರೀಕ್ಷಿಸುವುದು ಸಾಕಾಗುವುದಿಲ್ಲವೇ? ನೀವು ನನ್ನ ದೇವರ ತಾಳ್ಮೆಯನ್ನು ಪರೀಕ್ಷಿಸುವಿರಾ? <verse eid="ISA 7:13"/><verse number="14" style="v" sid="ISA 7:14"/>ಆದಕಾರಣ ಯೆಹೋವ ದೇವರು ತಾವೇ ಒಂದು ಗುರುತನ್ನು ನಿನಗೆ ಕೊಡುವರು. ಇಗೋ, ಒಬ್ಬ ಕನ್ನಿಕೆಯು ಗರ್ಭಿಣಿಯಾಗಿ ಮಗನನ್ನು ಹೆರುವಳು. ಆ ಮಗುವಿಗೆ, ‘ಇಮ್ಮಾನುಯೇಲ್’ ಎಂದು ಹೆಸರಿಡುವರು. <verse eid="ISA 7:14"/><verse number="15" style="v" sid="ISA 7:15"/>ಆ ಮಗು ಬೆಳೆದು, ಕೆಟ್ಟದ್ದನ್ನು ನಿರಾಕರಿಸಿ ಒಳ್ಳೆಯದನ್ನು ಆರಿಸಿಕೊಳ್ಳುವಷ್ಟು ತಿಳುವಳಿಕೆಯು ಬರುವ ತನಕ ಮೊಸರನ್ನು ಮತ್ತು ಜೇನನ್ನು ತಿನ್ನುವುದು. <verse eid="ISA 7:15"/><verse number="16" style="v" sid="ISA 7:16"/>ಹೌದು, ಆ ಮಗುವು ಕೆಟ್ಟದ್ದನ್ನು ನಿರಾಕರಿಸಿ ಒಳ್ಳೆಯದನ್ನು ಆರಿಸಿಕೊಳ್ಳುವುದಕ್ಕಿಂತ ಮುಂಚೆಯೇ, ನೀನು ಭಯಪಡುವ ಆ ಅರಸರುಗಳ ದೇಶ ನಿರ್ಜನವಾಗುವುದು. <verse eid="ISA 7:16"/><verse number="17" style="v" sid="ISA 7:17"/>ಯೆಹೋವ ದೇವರು ನಿನ್ನ ಮೇಲೆಯೂ, ನಿನ್ನ ಜನರ ಮೇಲೆಯೂ, ನಿನ್ನ ತಂದೆಯ ಮನೆಯ ಮೇಲೆಯೂ ಯೆಹೂದದಿಂದ ಎಫ್ರಾಯೀಮು ಅಗಲಿದ ದಿನದಿಂದ ಅಂದರೆ ಅಸ್ಸೀರಿಯದ ಅರಸನ ಕಾಲದಿಂದಲೂ ಬಾರದೆ ಇದ್ದ ದಿವಸಗಳನ್ನು ಬರಮಾಡುವರು.”<verse eid="ISA 7:17"/></para>
  <para style="s1">ಯೆಹೋವ ದೇವರ ಉಪಕರಣವಾದ ಅಸ್ಸೀರಿಯ ದೇಶ</para>
  <para style="p">
    <verse number="18" style="v" sid="ISA 7:18"/>ಆ ದಿನದಲ್ಲಿ ಈಜಿಪ್ಟಿನ ನದಿಗಳ ಕಟ್ಟಕಡೆಯಿಂದ ನೊಣಕ್ಕೂ, ಅಸ್ಸೀರಿಯ ದೇಶದ ಜೇನುಹುಳಕ್ಕೂ ಯೆಹೋವ ದೇವರು ಸಿಳ್ಳುಹಾಕುವರು. <verse eid="ISA 7:18"/><verse number="19" style="v" sid="ISA 7:19"/>ಅವು ಬಂದು ಹಾಳಾದ ಕಣಿವೆಗಳಲ್ಲಿಯೂ ಬಂಡೆಗಳ ಬಿರುಕುಗಳಲ್ಲಿಯೂ ಎಲ್ಲಾ ಮುಳ್ಳಿನ ಮೇಲೆಯೂ ಎಲ್ಲಾ ಪೊದೆಗಳಲ್ಲಿಯೂ ಮುತ್ತಿಕೊಳ್ಳುವುವು. <verse eid="ISA 7:19"/><verse number="20" style="v" sid="ISA 7:20"/>ಅದೇ ದಿನದಲ್ಲಿ ಯೆಹೋವ ದೇವರು ಯೂಫ್ರೇಟೀಸ್ ನದಿಯ ಆಚೆಗಿರುವ ಅಸ್ಸೀರಿಯದ ರಾಜನೆಂಬುವನಿಂದ ಬಾಡಿಗೆ ಕ್ಷೌರದ ಕತ್ತಿಯಿಂದ ಯೆಹೂದದ ತಲೆ ಮತ್ತು ಕಾಲಿನ ಕೂದಲನ್ನು ಬೋಳಿಸುವರು ಹಾಗೂ ಗಡ್ಡವನ್ನು ತೆಗೆದುಬಿಡುವರು. <verse eid="ISA 7:20"/><verse number="21" style="v" sid="ISA 7:21"/>ಆ ದಿನದಲ್ಲಿ ಮನುಷ್ಯನು ಒಂದು ಹಸುವಿನ ಕಡಸನ್ನು ಮತ್ತು ಎರಡು ಕುರಿಗಳನ್ನು ಸಾಕುವನು. <verse eid="ISA 7:21"/><verse number="22" style="v" sid="ISA 7:22"/>ಅವು ಸಮೃದ್ಧಿಯಾಗಿ ಹಾಲನ್ನು ಕೊಡುವುದರಿಂದ ಅವನು ಮೊಸರನ್ನು ತಿನ್ನುವನು. ಏಕೆಂದರೆ ಆ ದೇಶದಲ್ಲಿ ಉಳಿದಿರುವವರೆಲ್ಲರೂ ಮೊಸರನ್ನು ಮತ್ತು ಜೇನುತುಪ್ಪವನ್ನು ತಿನ್ನುವರು. <verse eid="ISA 7:22"/><verse number="23" style="v" sid="ISA 7:23"/>ಆ ದಿನದಲ್ಲಿ ಸಾವಿರ ಬೆಳ್ಳಿ ನಾಣ್ಯಗಳ ಬೆಲೆಯ ಸಮಸ್ತ ದ್ರಾಕ್ಷಿಬಳ್ಳಿಗಳು ಬೆಳೆಯುವ ಪ್ರತಿಯೊಂದು ಪ್ರದೇಶವು ಮುಳ್ಳು ಮತ್ತು ದತ್ತೂರಿಗಳಿಂದ ಆಗುವುದು. <verse eid="ISA 7:23"/><verse number="24" style="v" sid="ISA 7:24"/>ದೇಶವೆಲ್ಲಾ ಮುಳ್ಳು ದತ್ತೂರಿಗಳಿಂದ ತುಂಬಿರುವುದರಿಂದ ಮನುಷ್ಯರು ಬಿಲ್ಲು ಮತ್ತು ಬಾಣಗಳೊಂದಿಗೆ ಅಲ್ಲಿಗೆ ಬರುವರು. <verse eid="ISA 7:24"/><verse number="25" style="v" sid="ISA 7:25"/>ಗುದ್ದಲಿಯಿಂದ ಅಗೆಯುವ ಗುಡ್ಡಗಳ ಮೇಲೆ ಮುಳ್ಳು ದತ್ತೂರಿಗಳಿಗೆ ಹೆದರಿ ಅಲ್ಲಿಗೆ ಬರಲಾರದೆ ಇರುವಿ. ಆದರೆ ಅದು ಎತ್ತುಗಳನ್ನು ಬಿಡುವುದಕ್ಕೂ, ಕುರಿಗಳು ತುಳಿದಾಡುವುದಕ್ಕೂ ಗುರಿಯಾಗುವುದು.<verse eid="ISA 7:25"/></para>
  <chapter eid="ISA 7"/>
  <chapter number="8" style="c" sid="ISA 8"/>
  <para style="s1">ಯೆಶಾಯ ಮತ್ತು ಅವನ ಮಕ್ಕಳು ಸಂಕೇತಗಳಂತೆ</para>
  <para style="p">
    <verse number="1" style="v" sid="ISA 8:1"/>ಯೆಹೋವ ದೇವರು, “ಒಂದು ದೊಡ್ಡ ಸುರುಳಿಯನ್ನು ತೆಗೆದುಕೊಂಡು ಸಾಮಾನ್ಯ ಲೇಖನಿಯಿಂದಲೇ ಮಹೇರ್ ಶಾಲಾಲ್ ಹಾಷ್ ಬಜ್, ಎಂದರೆ ಸೂರೆಗೆ ಆತುರ, ಕೊಳ್ಳೆಗೆ ಅವಸರ ಎಂದು ಬರೆ,” ಎಂಬುದಾಗಿ ನನಗೆ ಹೇಳಿದರು. <verse eid="ISA 8:1"/><verse number="2" style="v" sid="ISA 8:2"/>ನಾನು ಯಾಜಕನಾದ ಊರೀಯನನ್ನೂ ಯೆಬೆರೆಕ್ಯನ ಮಗನಾದ ಜೆಕರ್ಯನನ್ನೂ ನಂಬಿಗಸ್ತ ಸಾಕ್ಷಿಗಳನ್ನಾಗಿ ಇರಿಸಿಕೊಂಡೆನು. <verse eid="ISA 8:2"/><verse number="3" style="v" sid="ISA 8:3"/>ಅನಂತರ ನಾನು ಪ್ರವಾದಿನಿಯಾದ ನನ್ನ ಹೆಂಡತಿಯನ್ನು ಕೂಡಲು, ಆಕೆಯು ಗರ್ಭಧರಿಸಿ ಒಬ್ಬ ಗಂಡುಮಗುನ್ನು ಹೆತ್ತಳು. ಆಗ ಯೆಹೋವ ದೇವರು ನನಗೆ, “ಆ ಮಗುವಿಗೆ, ಮಹೇರ್ ಶಾಲಾಲ್ ಹಾಷ್ ಬಜ್ ಎಂದು ಹೆಸರಿಡು, ಎಂದು ಹೇಳಿದರು. <verse eid="ISA 8:3"/><verse number="4" style="v" sid="ISA 8:4"/>ಏಕೆಂದರೆ ಆ ಮಗುವು, ‘ಅಪ್ಪಾ’ ಅಥವಾ ‘ಅಮ್ಮಾ’ ಎಂದು ಕೂಗಬಲ್ಲವನಾಗುವುದಕ್ಕಿಂತ ಮುಂಚೆ ಅಸ್ಸೀರಿಯದ ಅರಸನು ದಮಸ್ಕದ ಆಸ್ತಿಯನ್ನೂ ಸಮಾರ್ಯದ ಸೂರೆಯನ್ನೂ ತೆಗೆದುಕೊಂಡು ಹೋಗುವನು” ಎಂದರು.<verse eid="ISA 8:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="ISA 8:5"/>ಯೆಹೋವ ದೇವರು ಮತ್ತೊಮ್ಮೆ ನನಗೆ,<verse eid="ISA 8:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 8:6"/>“ಈ ಜನರು ಮೆಲ್ಲಗೆ ಹರಿಯುವ ಸಿಲೋವದ ನೀರನ್ನು ತ್ಯಜಿಸಿ,</para>
  <para style="q2" vid="ISA 8:6">ರೆಚೀನನನ್ನೂ ರೆಮಲ್ಯನ ಮಗನನ್ನೂ ನೆಚ್ಚಿಕೊಂಡು ಮೆರೆದಿದ್ದರಿಂದ,<verse eid="ISA 8:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 8:7"/>ಯೆಹೋವ ದೇವರಾದ ನಾನು ಎಲ್ಲಾ ಪ್ರತಾಪದಿಂದ ಕೂಡಿದ</para>
  <para style="q2" vid="ISA 8:7">ಅಸ್ಸೀರಿಯದ ಅರಸನೆಂಬ ಮಹಾನದಿಯ</para>
  <para style="q2" vid="ISA 8:7">ರಭಸವಾದ ದೊಡ್ಡ ಪ್ರವಾಹವನ್ನು ಇವರ ಮೇಲೆ ಬರಮಾಡುವೆನು.</para>
  <para style="q1" vid="ISA 8:7">ಅದು ತನ್ನ ಕಾಲುವೆಗಳನ್ನೆಲ್ಲಾ</para>
  <para style="q2" vid="ISA 8:7">ಒಳಗೊಂಡು ದಡಗಳನ್ನೆಲ್ಲಾ ಮೀರಿ,<verse eid="ISA 8:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 8:8"/>ಯೆಹೂದದಲ್ಲಿಯೂ ನುಗ್ಗಿ, ತುಂಬಿತುಳುಕಿ ಹಬ್ಬಿಕೊಂಡು</para>
  <para style="q2" vid="ISA 8:8">ಕತ್ತಿನವರೆಗೂ ಏರುವುದು.</para>
  <para style="q1" vid="ISA 8:8">ಇಮ್ಮಾನುಯೇಲನೇ,</para>
  <para style="q2" vid="ISA 8:8">ಆ ಅರಸನ ರೆಕ್ಕೆಗಳು ಹರಡಿ ನಿನ್ನ ದೇಶದ ಅಗಲವನ್ನೆಲ್ಲಾ ಆವರಿಸಿಕೊಳ್ಳುವುವು.”<verse eid="ISA 8:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 8:9"/>ಜನಾಂಗಗಳೇ, ನೀವು ಯುದ್ಧವನ್ನು ಘೋಷಿಸಿರಿ, ಆದರೂ ಚದರಿಹೋಗುವಿರಿ!</para>
  <para style="q2" vid="ISA 8:9">ಎಲ್ಲಾ ದೂರ ದೇಶದವರೇ ಕಿವಿಗೊಡಿರಿ.</para>
  <para style="q1" vid="ISA 8:9">ನಡುಕಟ್ಟಿಕೊಳ್ಳಿರಿ, ಆದರೂ ಚದರಿಹೋಗುವಿರಿ!</para>
  <para style="q2" vid="ISA 8:9">ನಡುಕಟ್ಟಿಕೊಳ್ಳಿರಿ, ಆದರೂ ಚದರಿಹೋಗುವಿರಿ!<verse eid="ISA 8:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 8:10"/>ಆಲೋಚನೆ ಮಾಡಿಕೊಳ್ಳಿರಿ, ಅದು ಮುರಿದು ಹೋಗುವುದು,</para>
  <para style="q2" vid="ISA 8:10">ನಿಮ್ಮ ಯೋಜನೆಯನ್ನು ಪ್ರಸ್ತಾಪಿಸಿರಿ, ಆದರೆ ಅದು ನಿಲ್ಲುವುದಿಲ್ಲ,</para>
  <para style="q2" vid="ISA 8:10">ಏಕೆಂದರೆ ದೇವರು ನಮ್ಮ ಸಂಗಡ ಇದ್ದಾರೆ.<verse eid="ISA 8:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="ISA 8:11"/>ನಾನು ಈ ಜನರ ಮಾರ್ಗದಲ್ಲಿ ನಡೆಯಬಾರದೆಂದು ಯೆಹೋವ ದೇವರು ನನ್ನ ಮೇಲೆ ಬಲವಾಗಿ ಕೈಯನ್ನಿಟ್ಟು ನನಗೆ,<verse eid="ISA 8:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 8:12"/>“ಇವರು ಯಾವುದನ್ನು ಒಳಸಂಚು ಎಂದು ಹೇಳುತ್ತಾರೋ,</para>
  <para style="q2" vid="ISA 8:12">ನೀವು ಅದನ್ನು ಒಳಸಂಚು ಎಂದು ಹೇಳಬೇಡಿರಿ.</para>
  <para style="q1" vid="ISA 8:12">ಅವರ ಭಯಕ್ಕೆ ನೀವು ಭಯಪಡಬೇಡಿರಿ,</para>
  <para style="q2" vid="ISA 8:12">ಇಲ್ಲವೆ ಹೆದರಬೇಡಿರಿ.<verse eid="ISA 8:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="ISA 8:13"/>ಸೇನಾಧೀಶ್ವರ ಯೆಹೋವ ದೇವರನ್ನೇ ಪ್ರತಿಷ್ಠೆ ಪಡಿಸಿಕೊಳ್ಳಿರಿ;</para>
  <para style="q2" vid="ISA 8:13">ನೀವು ಭಯಪಡಬೇಕಾದುದು ಅವರಿಗೇ,</para>
  <para style="q2" vid="ISA 8:13">ನೀವು ಹೆದರಬೇಕಾಗಿರುವುದು ಅವರಿಗೇ.<verse eid="ISA 8:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="ISA 8:14"/>ಅವರೇ ನಿಮಗೆ ಪರಿಶುದ್ಧ ಸ್ಥಳವಾಗಿರುವರು.</para>
  <para style="q2" vid="ISA 8:14">ಆದರೆ ಇಸ್ರಾಯೇಲ್ ಮತ್ತು ಯಹೂದ ಎರಡು ಮನೆಗಳಿಗೆ</para>
  <para style="q1" vid="ISA 8:14">ಎಡವುವ ಕಲ್ಲೂ,</para>
  <para style="q2" vid="ISA 8:14">ಮುಗ್ಗರಿಸುವ ಬಂಡೆಯೂ,</para>
  <para style="q1" vid="ISA 8:14">ಯೆರೂಸಲೇಮಿನ ನಿವಾಸಿಗಳಿಗೆ ಬಲೆಯೂ,</para>
  <para style="q2" vid="ISA 8:14">ಬೋನೂ ಆಗಿರುವರು.<verse eid="ISA 8:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="ISA 8:15"/>ಅವರಲ್ಲಿ ಅನೇಕರು ಎಡವಿಬೀಳುವರು,</para>
  <para style="q2" vid="ISA 8:15">ಮುಗ್ಗರಿಸಿ ಮೂಳೆ ಮುರಿದುಕೊಳ್ಳುವರು, ಬಲೆಗೆ ಸಿಕ್ಕಿ ಬೀಳುವರು.”<verse eid="ISA 8:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="ISA 8:16"/>ಸಾಕ್ಷಿಯನ್ನು ಕಟ್ಟಿಡು,</para>
  <para style="q2" vid="ISA 8:16">ನನ್ನ ಶಿಷ್ಯರೊಳಗೆ ದೇವರ ಶಿಕ್ಷಣವನ್ನು ಮುದ್ರಿಸು.<verse eid="ISA 8:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="ISA 8:17"/>ಯಾಕೋಬಿನ ವಂಶದವರಿಗೆ ಮುಖವನ್ನು ಮರೆಮಾಡಿಕೊಂಡಿರುವ</para>
  <para style="q2" vid="ISA 8:17">ಯೆಹೋವ ದೇವರಿಗಾಗಿ ನಾನು ಕಾದುಕೊಂಡು ಎದುರು ನೋಡುತ್ತಿರುವೆನು.</para>
  <para style="q1" vid="ISA 8:17">ನಾನು ದೇವರ ಮೇಲೆ ಭರವಸೆ ಇಡುವೆನು.<verse eid="ISA 8:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="ISA 8:18"/>ಇಗೋ, ನಾನೂ ಯೆಹೋವ ದೇವರು ನನಗೆ ದಯಪಾಲಿಸಿರುವ ಮಕ್ಕಳೂ ಚೀಯೋನ್ ಪರ್ವತದಲ್ಲಿ ವಾಸವಾಗಿರುವ ಸೇನಾಧೀಶ್ವರ ಯೆಹೋವ ದೇವರಿಂದ ಉಂಟಾದ ಗುರುತುಗಳಾಗಿಯೂ, ಅದ್ಭುತಗಳಾಗಿಯೂ ಇಸ್ರಾಯೇಲಿನಲ್ಲಿದ್ದೇವೆ.<verse eid="ISA 8:18"/></para>
  <para style="s1">ಕತ್ತಲೆ ಬೆಳಕಿಗೆ ತಿರುಗುತ್ತದೆ</para>
  <para style="p">
    <verse number="19" style="v" sid="ISA 8:19"/>ಲೊಚಗುಟ್ಟುವ, ಪಿಸುಮಾತಾಡುವ ಮಂತ್ರಗಾರರನ್ನೂ; ಕಣಿಹೇಳುವವರನ್ನೂ ಹುಡುಕಿರಿ ಎಂದು ಅವರು ನಿಮಗೆ ಹೇಳುವಾಗ, ಜನರು ತಮ್ಮ ದೇವರನ್ನೇ ಹುಡುಕುವುದಿಲ್ಲವೋ? ಜೀವಿತರಿಗಾಗಿ ಸತ್ತವರಲ್ಲಿ ಹೋಗುವುದುಂಟೋ? <verse eid="ISA 8:19"/><verse number="20" style="v" sid="ISA 8:20"/>ದೇವರ ಶಿಕ್ಷಣ ಮತ್ತು ಎಚ್ಚರಿಸುವ ಸಾಕ್ಷಿಯ ವಿಷಯದಲ್ಲಿ ಈ ವಾಕ್ಯದ ಪ್ರಕಾರ ಒಂದು ವೇಳೆ ಅವರು ಹೇಳದಿದ್ದರೆ, ಅವರಲ್ಲಿ ಮುಂಜಾವಿನ ಬೆಳಕು ಮೂಡಿಬರುವುದಿಲ್ಲ. <verse eid="ISA 8:20"/><verse number="21" style="v" sid="ISA 8:21"/>ಅವರು ಘೋರಕಷ್ಟಕ್ಕೊಳಗಾಗಿ ಹಸಿದು ದೇಶದಲ್ಲಿ ಅಲೆಯುವರು. ಅವರು ಹಸಿದಾಗ ರೇಗಿಕೊಂಡು ತಮ್ಮ ರಾಜನನ್ನೂ, ದೇವರನ್ನೂ ಶಪಿಸಿ ಮೇಲಕ್ಕೆ ನೋಡುವರು. <verse eid="ISA 8:21"/><verse number="22" style="v" sid="ISA 8:22"/>ಅವರು ಭೂಮಿಯನ್ನು ದೃಷ್ಟಿಸಿದರೂ, ಇಕ್ಕಟ್ಟೆಂಬ ಕತ್ತಲೂ, ಸಂಕಟವೆಂಬ ಅಂಧಕಾರವೂ ಕವಿದುಕೊಂಡಿರುವುದು, ಕಾರ್ಗತ್ತಲೆಗೆ ಅವರನ್ನು ದೂಡಲಾಗುವುದು.<verse eid="ISA 8:22"/></para>
  <chapter eid="ISA 8"/>
  <chapter number="9" style="c" sid="ISA 9"/>
  <para style="p">
    <verse number="1" style="v" sid="ISA 9:1"/>ಆದರೂ ಸಂಕಟಪಟ್ಟ ದೇಶಕ್ಕೆ ಅಂಧಕಾರವಿನ್ನಿಲ್ಲ. ಹಿಂದಿನ ಕಾಲದಲ್ಲಿ ಜೆಬುಲೂನ್ ನಾಡು ಮತ್ತು ನಫ್ತಾಲಿ ನಾಡುಗಳನ್ನು ಅವರು ಅವಮಾನಕ್ಕೆ ಗುರಿಮಾಡಿ, ಅನಂತರ ಯೊರ್ದನಿನ ಆಚೆಯ ಸೀಮೆ, ಸಮುದ್ರದ ಕಡೆಗಿರುವ ಸೀಮೆ, ಇತರ ಜನರಿರುವ ಗಲಿಲಾಯ ನಾಡು, ಈ ಪ್ರಾಂತವನ್ನೆಲ್ಲಾ ಘನಪಡಿಸಿದ್ದಾರೆ.<verse eid="ISA 9:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 9:2"/>ಕತ್ತಲೆಯಲ್ಲಿ ನಡೆಯುವ ಈ ಜನರಿಗೆ</para>
  <para style="q2" vid="ISA 9:2">ಮಹಾ ಬೆಳಕು ಕಾಣಿಸಿತು,</para>
  <para style="q1" vid="ISA 9:2">ಮರಣದ ನೆರಳಿನ ದೇಶದಲ್ಲಿ ವಾಸಿಸುವವರ ಮೇಲೆ</para>
  <para style="q2" vid="ISA 9:2">ಬೆಳಕು ಉದಯಿಸಿತು.<verse eid="ISA 9:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 9:3"/>ನೀವು ಜನಾಂಗವನ್ನು ವೃದ್ಧಿಗೊಳಿಸಿದ್ದೀರಿ</para>
  <para style="q2" vid="ISA 9:3">ಮತ್ತು ಸಂತೋಷವನ್ನು ಹೆಚ್ಚಿಸಿದ್ದೀರಿ.</para>
  <para style="q1" vid="ISA 9:3">ಸುಗ್ಗಿ ಕಾಲದ ಸಂತೋಷದಂತೆಯೂ,</para>
  <para style="q2" vid="ISA 9:3">ಕೊಳ್ಳೆಯನ್ನು ಹಂಚಿಕೊಳ್ಳುವಾಗ</para>
  <para style="q1" vid="ISA 9:3">ಉಲ್ಲಾಸಿಸುವ ಹಾಗೆಯೂ ನಿಮ್ಮ</para>
  <para style="q2" vid="ISA 9:3">ಮುಂದೆ ಸಂತೋಷಿಸುವರು.<verse eid="ISA 9:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 9:4"/>ಏಕೆಂದರೆ ಅವನ ನೊಗವನ್ನೂ,</para>
  <para style="q2" vid="ISA 9:4">ಬೆನ್ನನ್ನು ಹೊಡೆದ ಕೋಲನ್ನೂ,</para>
  <para style="q1" vid="ISA 9:4">ಬಿಟ್ಟೀ ಹಿಡಿದವನ ದೊಣ್ಣೆಯನ್ನೂ,</para>
  <para style="q2" vid="ISA 9:4">ಮಿದ್ಯಾನಿನ ದಿನದಲ್ಲಿ ಮುರಿದಂತೆ ಮುರಿದುಬಿಟ್ಟಿದ್ದೀರಿ.<verse eid="ISA 9:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 9:5"/>ಯುದ್ಧವೀರರ ಪ್ರತಿ ಯುದ್ಧವು ಗಲಿಬಿಲಿಯ ಗದ್ದಲದಿಂದ</para>
  <para style="q2" vid="ISA 9:5">ರಕ್ತದಲ್ಲಿ ಹೊರಳಾಡಿಸಿದ ವಸ್ತ್ರಗಳು ಆಗಿರುತ್ತವೆ.</para>
  <para style="q1" vid="ISA 9:5">ಆದರೆ ಇವು ಬೆಂಕಿಗೆ ಆಹುತಿಯಾಗುತ್ತವೆ.</para>
  <para style="q2" vid="ISA 9:5">ಅದು ಬೆಂಕಿಗೆ ಇಂಧನವಾಗಿರುತ್ತದೆ.<verse eid="ISA 9:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 9:6"/>ಏಕೆಂದರೆ ಒಂದು ಮಗು ನಮಗಾಗಿ ಹುಟ್ಟಿದೆಯಷ್ಟೆ,</para>
  <para style="q2" vid="ISA 9:6">ಆ ಮಗನನ್ನು ನಮಗಾಗಿ ಕೊಡಲಾಗಿದೆ.</para>
  <para style="q2" vid="ISA 9:6">ಆಡಳಿತವು ಅವರ ಬಾಹುವಿನ ಮೇಲಿರುವುದು,</para>
  <para style="q1" vid="ISA 9:6">ಅದ್ಭುತವಾದವರು ಸಮಾಲೋಚಕರು,</para>
  <para style="q2" vid="ISA 9:6">ಪರಾಕ್ರಮಿಯಾದ ದೇವರು, ನಿತ್ಯರಾದ ತಂದೆ,</para>
  <para style="q2" vid="ISA 9:6">ಸಮಾಧಾನದ ಪ್ರಭು, ಎಂಬುದು ಅವರ ಹೆಸರಾಗಿರುವುದು.<verse eid="ISA 9:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 9:7"/>ಅವರ ಆಡಳಿತದ ಶ್ರೇಷ್ಠತೆ ಮತ್ತು ಶಾಂತಿಗೆ ಅಂತ್ಯವಿಲ್ಲ. ಅವರ ಮುಖಾಂತರ ದಾವೀದನ</para>
  <para style="q2" vid="ISA 9:7">ಸಿಂಹಾಸನದ ಆಡಳಿತವು ಅಭಿವೃದ್ಧಿಯಾಗುವುದು,</para>
  <para style="q1" vid="ISA 9:7">ದಾವೀದನ ರಾಜ್ಯವು ಇಂದಿನಿಂದ ಯಾವಾಗಲೂ</para>
  <para style="q2" vid="ISA 9:7">ನೀತಿನ್ಯಾಯಗಳ ಮೂಲಕ ಸ್ಥಾಪಿತವಾಗಿ ಸ್ಥಿರಗೊಳ್ಳುವುದು,</para>
  <para style="q1" vid="ISA 9:7">ಸೇನಾಧೀಶ್ವರ ಯೆಹೋವ ದೇವರ ಅನುಗ್ರಹವು</para>
  <para style="q2" vid="ISA 9:7">ಇದನ್ನು ನೆರವೇರಿಸುವುದು.<verse eid="ISA 9:7"/></para>
  <para style="s1">ಇಸ್ರಾಯೇಲರ ವಿರುದ್ಧ ದೇವರ ರೌದ್ರ</para>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 9:8"/>ಯೆಹೋವ ದೇವರು ಯಾಕೋಬನಿಗೆ ವಿರೋಧವಾಗಿ ಒಂದು ಮಾತನ್ನು ಹೇಳಿ ಕಳುಹಿಸಿದರು,</para>
  <para style="q2" vid="ISA 9:8">ಅದು ಇಸ್ರಾಯೇಲರಿಗೆ ತಗುಲಿತು.<verse eid="ISA 9:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 9:9"/>ಗರ್ವದಿಂದಲೂ, ಹೆಮ್ಮೆಯಿಂದಲೂ</para>
  <para style="q2" vid="ISA 9:9">ಹೇಳಿಕೊಳ್ಳುವ ಎಲ್ಲಾ ಜನರಿಗೂ</para>
  <para style="q1" vid="ISA 9:9">ಎಫ್ರಾಯೀಮ್ಯರಿಗೂ ಸಮಾರ್ಯದ ನಿವಾಸಿಗಳೆಲ್ಲರಿಗೂ</para>
  <para style="q2" vid="ISA 9:9">ಈ ಮಾತು ಗೊತ್ತಾಗುವುದು. ಅದೇನೆಂದರೆ,<verse eid="ISA 9:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 9:10"/>“ಇಟ್ಟಿಗೆಗಳು ಬಿದ್ದು ಹೋದರೂ</para>
  <para style="q2" vid="ISA 9:10">ಕೆತ್ತಿದ ಕಲ್ಲುಗಳಿಂದ ಕಟ್ಟುವೆವು.</para>
  <para style="q1" vid="ISA 9:10">ಅತ್ತಿಮರಗಳನ್ನು ಕಡಿದಿದ್ದರೂ</para>
  <para style="q2" vid="ISA 9:10">ಅಲ್ಲಿಯೇ ನಾವು ದೇವದಾರು ವೃಕ್ಷಗಳನ್ನು ನೆಡುವೆವು,”<verse eid="ISA 9:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 9:11"/>ಹೀಗಿರುವುದರಿಂದ ಯೆಹೋವ ದೇವರು ರೆಚೀನನ ವೈರಿಗಳನ್ನು</para>
  <para style="q2" vid="ISA 9:11">ಅವನಿಗೆ ವಿರೋಧವಾಗಿ ಎಬ್ಬಿಸಿ,<verse eid="ISA 9:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 9:12"/>ಅವನ ಶತ್ರುಗಳಾದ ಪೂರ್ವದಿಂದ ಅರಾಮ್ಯರನ್ನು ಮುಂದೆಯೂ,</para>
  <para style="q2" vid="ISA 9:12">ಪಶ್ಚಿಮದಿಂದ ಫಿಲಿಷ್ಟಿಯರನ್ನು ಹಿಂದೆಯೂ ಒಟ್ಟುಗೂಡಿಸುವರು.</para>
  <para style="b" vid="ISA 9:12"/>
  <para style="q1" vid="ISA 9:12">ಅವರು ಇಸ್ರಾಯೇಲನ್ನು ತೆರೆದ ಬಾಯಿಂದ ನುಂಗಿಬಿಡುವರು.</para>
  <para style="q2" vid="ISA 9:12">ಏಕೆಂದರೆ, ಇಷ್ಟೆಲ್ಲಾ ಆದರೂ ದೇವರ ಕೋಪವು ತೀರದೆ, ಅವರ ಕೈ ಇನ್ನೂ ಚಾಚಿಯೇ ಇದೆ.<verse eid="ISA 9:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="ISA 9:13"/>ಆದರೂ ಜನರು ತಮ್ಮನ್ನು ಶಿಕ್ಷಿಸಿದ ದೇವರ ಕಡೆಗೆ ತಿರುಗದೆಯೂ,</para>
  <para style="q2" vid="ISA 9:13">ಸೇನಾಧೀಶ್ವರ ಯೆಹೋವ ದೇವರನ್ನು ಹುಡುಕದೆಯೂ ಇದ್ದರು.<verse eid="ISA 9:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="ISA 9:14"/>ಆದಕಾರಣ ಯೆಹೋವ ದೇವರು ಇಸ್ರಾಯೇಲಿನಿಂದ ತಲೆ</para>
  <para style="q" vid="ISA 9:14">ಬಾಲಗಳನ್ನೂ ಖರ್ಜೂರದ ಕೊಂಬೆಗಳನ್ನೂ ಒಂದೇ ದಿನದಲ್ಲಿ ಕಡಿದುಹಾಕುವರು.<verse eid="ISA 9:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="ISA 9:15"/>ಹಿರಿಯನು ಮತ್ತು ಘನವುಳ್ಳವನು ತಲೆಯಾಗಿರುವನು,</para>
  <para style="q2" vid="ISA 9:15">ಸುಳ್ಳು ಬೋಧಿಸುವ ಪ್ರವಾದಿಯು ಬಾಲವಾಗಿರುವನು.<verse eid="ISA 9:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="ISA 9:16"/>ಈ ಜನರನ್ನು ನಡೆಸುವವರು ದಾರಿ ತಪ್ಪಿಸುವವರಾಗಿದ್ದಾರೆ,</para>
  <para style="q2" vid="ISA 9:16">ಅವರನ್ನು ಹಿಂಬಾಲಿಸುವವರು ನಾಶವಾಗುವರು.<verse eid="ISA 9:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="ISA 9:17"/>ಹೀಗಿರಲು ಕರ್ತದೇವರು ಅವರ ಯೌವನಸ್ಥರಲ್ಲಿ ಆನಂದಿಸುವುದಿಲ್ಲ.</para>
  <para style="q2" vid="ISA 9:17">ಅವರ ಅನಾಥರನ್ನೂ, ವಿಧವೆಯರನ್ನೂ ಕರುಣಿಸುವುದಿಲ್ಲ.</para>
  <para style="q1" vid="ISA 9:17">ಏಕೆಂದರೆ, ಪ್ರತಿಯೊಬ್ಬನು ಕಪಟಿಯೂ,</para>
  <para style="q2" vid="ISA 9:17">ಕೇಡು ಮಾಡುವವನೂ ಆಗಿದ್ದಾನೆ.</para>
  <para style="b" vid="ISA 9:17"/>
  <para style="q1" vid="ISA 9:17">ಎಲ್ಲರ ಬಾಯಿಯೂ ಮೂರ್ಖತನದ ಮಾತುಗಳನ್ನು ಆಡುತ್ತದೆ.</para>
  <para style="q2" vid="ISA 9:17">ಆದ್ದರಿಂದ ಇಷ್ಟೆಲ್ಲಾ ಆದರೂ ದೇವರ ಕೋಪವು ತೀರದೆ, ಅವರ ಕೈ ಇನ್ನೂ ಚಾಚಿಯೇ ಇದೆ.<verse eid="ISA 9:17"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="18" style="v" sid="ISA 9:18"/>ದುಷ್ಟತ್ವವು ಬೆಂಕಿಯಂತೆ ಉರಿದು ದತ್ತೂರಿ,</para>
  <para style="q2" vid="ISA 9:18">ಮುಳ್ಳುಗಳನ್ನು ನುಂಗಿಬಿಟ್ಟು,</para>
  <para style="q1" vid="ISA 9:18">ಅಡವಿಯ ಪೊದೆಗಳನ್ನು ಹತ್ತಿಕೊಳ್ಳಲು,</para>
  <para style="q2" vid="ISA 9:18">ಅದು ಹೊಗೆ ಹೊಗೆಯಾಗಿ ಸುತ್ತಿಕೊಂಡು ಮೇಲಕ್ಕೆ ಏರುತ್ತದೆ.<verse eid="ISA 9:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="ISA 9:19"/>ಸೇನಾಧೀಶ್ವರ ಯೆಹೋವ ದೇವರ ಕೋಪದಿಂದ</para>
  <para style="q2" vid="ISA 9:19">ದೇಶವು ಒಣಗಿಹೋಗಿದೆ,</para>
  <para style="q1" vid="ISA 9:19">ಜನರು ಉರಿಯುವ ಸೌದೆಯಂತಿದ್ದಾರೆ.</para>
  <para style="q2" vid="ISA 9:19">ಯಾವ ಮನುಷ್ಯನೂ ತನ್ನ ಸಹೋದರನನ್ನು ಉಳಿಸುವುದಿಲ್ಲ.<verse eid="ISA 9:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="ISA 9:20"/>ಅವನು ಬಲಗಡೆಯಲ್ಲಿರುವುದನ್ನು ಕಿತ್ತುಕೊಂಡು</para>
  <para style="q2" vid="ISA 9:20">ತಿಂದರೂ ಹಸಿದೇ ಇರುವನು,</para>
  <para style="q1" vid="ISA 9:20">ಅವನು ಎಡಗಡೆಯಲ್ಲಿರುವುದನ್ನು ತಿಂದರೂ</para>
  <para style="q2" vid="ISA 9:20">ಅವು ಅವನನ್ನು ತೃಪ್ತಿಪಡಿಸಲಾರವು.</para>
  <para style="q1" vid="ISA 9:20">ಒಬ್ಬೊಬ್ಬನೂ ತನ್ನ ನೆರೆಯವನನ್ನು</para>
  <para style="q2" vid="ISA 9:20">ಹಾನಿ ಮಾಡುತ್ತಿದ್ದಾನೆ.<verse eid="ISA 9:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="ISA 9:21"/>ಹೀಗೆ ಮನಸ್ಸೆಯು ಎಫ್ರಾಯೀಮನ್ನು ಮತ್ತು ಎಫ್ರಾಯೀಮು ಮನಸ್ಸೆಯನ್ನು ಹಾನಿ ಮಾಡುತ್ತಿವೆ.</para>
  <para style="q2" vid="ISA 9:21">ಅವರು ಒಟ್ಟಾಗಿ ಸೇರಿ ಯೆಹೂದಕ್ಕೆ ವಿರೋಧವಾಗಿರುವರು.</para>
  <para style="b" vid="ISA 9:21"/>
  <para style="q1" vid="ISA 9:21">ಇಷ್ಟೆಲ್ಲಾ ಆದರೂ ಅವರ ಕೋಪವು ತೀರದೆ,</para>
  <para style="q2" vid="ISA 9:21">ಅವರ ಕೈ ಇನ್ನೂ ಚಾಚಿಯೇ ಇದೆ.<verse eid="ISA 9:21"/></para>
  <para style="b"/>
  <para style="b"/>
  <chapter eid="ISA 9"/>
  <chapter number="10" style="c" sid="ISA 10"/>
  <para style="q1">
    <verse number="1" style="v" sid="ISA 10:1"/>ಅನೀತಿಯ ನೇಮಕಗಳನ್ನು ನೇಮಿಸಿ,</para>
  <para style="q2" vid="ISA 10:1">ಕ್ರೂರವಾದ ಕಾನೂನುಗಳನ್ನು ಬರೆಯುವವರಿಗೆ ಕಷ್ಟ!<verse eid="ISA 10:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 10:2"/>ಇವರು ವಿಧವೆಯರನ್ನು ಸೂರೆಮಾಡಿ,</para>
  <para style="q2" vid="ISA 10:2">ದಿಕ್ಕಿಲ್ಲದವರಿಂದ ಸುಲಿದುಕೊಂಡು</para>
  <para style="q1" vid="ISA 10:2">ದೀನರಿಗೆ ನ್ಯಾಯವನ್ನು ತಪ್ಪಿಸಿ,</para>
  <para style="q2" vid="ISA 10:2">ನನ್ನ ಜನರಲ್ಲಿ ಬಡವರ ನ್ಯಾಯವನ್ನು ತೆಗೆಯಬೇಕೆಂದಿದ್ದಾರೆ.<verse eid="ISA 10:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 10:3"/>ವಿಚಾರಣೆಯ ದಿನದಲ್ಲಿಯೂ,</para>
  <para style="q2" vid="ISA 10:3">ದೂರದಿಂದ ಬರುವ ನಾಶನದಲ್ಲಿಯೂ ನೀವು ಏನು ಮಾಡುವಿರಿ?</para>
  <para style="q1" vid="ISA 10:3">ಸಹಾಯಕ್ಕಾಗಿ ನೀವು ಯಾರ ಬಳಿಗೆ ಓಡುವಿರಿ?</para>
  <para style="q2" vid="ISA 10:3">ನಿಮ್ಮ ಐಶ್ವರ್ಯವನ್ನು ಎಲ್ಲಿ ಬಿಡುವಿರಿ?<verse eid="ISA 10:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 10:4"/>ನಾನಿಲ್ಲದೆ ಕೈದಿಗಳ ಕೆಳಗೆ ಮುದುರಿಕೊಂಡು,</para>
  <para style="q2" vid="ISA 10:4">ಹತರಾಗಿರುವವರ ಕೆಳಗೆ ಬಿದ್ದಿರುವುದೇ ಇವರ ಗತಿ.</para>
  <para style="b" vid="ISA 10:4"/>
  <para style="q1" vid="ISA 10:4">ಏಕೆಂದರೆ, ಇಷ್ಟೆಲ್ಲಾ ಆದರೂ ಅವರ ಕೋಪವು ತೀರದೆ,</para>
  <para style="q2" vid="ISA 10:4">ಅವರ ಕೈ ಇನ್ನೂ ಚಾಚಿಯೇ ಇದೆ.<verse eid="ISA 10:4"/></para>
  <para style="s1">ಅಸ್ಸೀರಿಯದ ಮೇಲೆ ದೇವರ ದಂಡನೆ</para>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 10:5"/>“ಅಯ್ಯೋ, ನನ್ನ ಕೋಪದ ಕೋಲಾದ ಅಸ್ಸೀರಿಯವೇ,</para>
  <para style="q2" vid="ISA 10:5">ನನ್ನ ಕೈಯಲ್ಲಿರುವ ಬೆತ್ತವು ನನ್ನ ಕೋಪವೇ.<verse eid="ISA 10:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 10:6"/>ನಾನು ಅವನನ್ನು ಭಕ್ತಿಹೀನ ಜನರಿಗೆ ವಿರುದ್ಧವಾಗಿ ಕಳುಹಿಸಿ,</para>
  <para style="q2" vid="ISA 10:6">ನನ್ನ ಕೋಪಕ್ಕೆ ಗುರಿಯಾದ ನನ್ನ ಪ್ರಜೆಯನ್ನು ಸೂರೆಮಾಡಿ,</para>
  <para style="q1" vid="ISA 10:6">ಕೊಳ್ಳೆಹೊಡೆದು ಬೀದಿಯ ಕೆಸರನ್ನೋ ಎಂಬಂತೆ</para>
  <para style="q2" vid="ISA 10:6">ತುಳಿದುಹಾಕಬೇಕೆಂದು ಅಪ್ಪಣೆ ಕೊಡುವೆನು.<verse eid="ISA 10:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 10:7"/>ಅದರ ಅಭಿಪ್ರಾಯವೋ ಹಾಗಲ್ಲ.</para>
  <para style="q2" vid="ISA 10:7">ಅದರ ಹೃದಯವು ಈ ಪ್ರಕಾರ ಆಲೋಚಿಸುವುದಿಲ್ಲ.</para>
  <para style="q1" vid="ISA 10:7">ಜನಾಂಗಗಳನ್ನು ಕಡಿದುಬಿಡುವುದು ಕೊಂಚವಾಗಿ ಅಲ್ಲ.</para>
  <para style="q2" vid="ISA 10:7">ಆದರೆ ನಾಶಮಾಡುವುದು ಅದರ ಹೃದಯದ ಉದ್ದೇಶವು.<verse eid="ISA 10:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 10:8"/>ಏಕೆಂದರೆ ಅವನು, ‘ನನ್ನ ಅಧಿಪತಿಗಳೆಲ್ಲಾ ರಾಜರಲ್ಲವೇ?<verse eid="ISA 10:8"/></para>
  <para style="q2">
    <verse number="9" style="v" sid="ISA 10:9"/>ಕಲ್ನೋ, ಕರ್ಕೆಮೀಷಿನ ಹಾಗಲ್ಲವೋ?</para>
  <para style="q1" vid="ISA 10:9">ಹಮಾತ್ ಅರ್ಪಾದಿನ ಹಾಗಲ್ಲವೇ?</para>
  <para style="q2" vid="ISA 10:9">ಸಮಾರ್ಯವು ದಮಸ್ಕದ ಹಾಗಲ್ಲವೋ?<verse eid="ISA 10:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 10:10"/>ಯೆರೂಸಲೇಮಿನಲ್ಲಿಯೂ ಸಮಾರ್ಯದಲ್ಲಿಯೂ ಹೆಚ್ಚಾಗಿದ್ದ ಅವರ ವಿಗ್ರಹಗಳು</para>
  <para style="q2" vid="ISA 10:10">ಹಾಗೂ ಕೆತ್ತಿದ ವಿಗ್ರಹಗಳ ರಾಜ್ಯಗಳು ನನ್ನ ಕೈಗೆ ಸಿಕ್ಕಿದಂತೆ,<verse eid="ISA 10:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 10:11"/>ನಾನು ಸಮಾರ್ಯ ಮತ್ತು ಅದರ ವಿಗ್ರಹಗಳಿಗೆ ಮಾಡಿದಂತೆಯೇ</para>
  <para style="q2" vid="ISA 10:11">ಯೆರೂಸಲೇಮಿಗೆ ಮತ್ತು ಅದರ ವಿಗ್ರಹಗಳಿಗೆ ಮಾಡುತ್ತೇನೆಯೇ?’ ”<verse eid="ISA 10:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="ISA 10:12"/>ಆದರೆ ಕರ್ತದೇವರು ಚೀಯೋನ್ ಪರ್ವತದ ಮೇಲೆಯೂ ಯೆರೂಸಲೇಮಿನ ಮೇಲೆಯೂ ತಮ್ಮ ಕಾರ್ಯಗಳನ್ನು ನೆರವೇರಿಸಿದ ಮೇಲೆ, “ಅಸ್ಸೀರಿಯದ ಅರಸನ ಹೃದಯದ ದೊಡ್ಡಸ್ತಿಕೆಯ ಫಲವನ್ನು, ಅವನ ಉನ್ನತವಾದ ದೃಷ್ಟಿಯ ಘನತೆಯನ್ನು ನಾನು ದಂಡಿಸುವೆನು.” <verse eid="ISA 10:12"/><verse number="13" style="v" sid="ISA 10:13"/>ಏಕೆಂದರೆ ಅಸ್ಸೀರಿಯ ತನ್ನೊಳಗೆ ಹೀಗೆ ಅಂದುಕೊಂಡನು,</para>
  <para style="q1" vid="ISA 10:13">“ ‘ನನ್ನ ಕೈಯ ಬಲದಿಂದಲೂ ನನ್ನ ಜ್ಞಾನದಿಂದಲೂ ಅದನ್ನು ಮಾಡಿದೆ.</para>
  <para style="q2" vid="ISA 10:13">ಏಕೆಂದರೆ, ನಾನು ವಿವೇಕಿ. ಜನಾಂಗಗಳ ಮೇರೆಗಳನ್ನು ಕಿತ್ತು,</para>
  <para style="q1" vid="ISA 10:13">ಅವರ ನಿಧಿಗಳನ್ನು ಕೊಳ್ಳೆಹೊಡೆದು,</para>
  <para style="q2" vid="ISA 10:13">ಅದರ ಅರಸರನ್ನು ಮಹಾವೀರನಂತೆ ಕೆಡವಿಬಿಟ್ಟಿದ್ದೇನೆ.<verse eid="ISA 10:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="ISA 10:14"/>ಜನರ ಐಶ್ವರ್ಯವು ಗೂಡಿನಂತೆ ನನ್ನ ಕೈಗೆ ಸಿಕ್ಕಿದೆ;</para>
  <para style="q2" vid="ISA 10:14">ಹಕ್ಕಿ ಬಿಟ್ಟುಹೋದ ಮೊಟ್ಟೆಗಳನ್ನು ಕೂಡಿಸುವಂತೆ,</para>
  <para style="q1" vid="ISA 10:14">ಸಮಸ್ತ ರಾಷ್ಟ್ರಗಳನ್ನು ಒಟ್ಟುಗೂಡಿಸಿದ್ದೇನೆ.</para>
  <para style="q2" vid="ISA 10:14">ರೆಕ್ಕೆಯಾಡಿಸಿ ಬಾಯಿತೆರೆದು</para>
  <para style="q2" vid="ISA 10:14">ಕೀಚುಗುಟ್ಟಲು ಯಾರೂ ಇರಲಿಲ್ಲ.’ ”<verse eid="ISA 10:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="ISA 10:15"/>ಕೊಡಲಿಯು ಕಡಿಯುವವನಿಗೆ ವಿರುದ್ಧವಾಗಿ ಕೊಚ್ಚಿಕೊಂಡೀತೆ?</para>
  <para style="q2" vid="ISA 10:15">ಇಲ್ಲವೆ ಗರಗಸವು ತನ್ನನ್ನು ಎಳೆಯುವವನ ಮೇಲೆ ಹೆಚ್ಚಿಸಿಕೊಂಡೀತೆ?</para>
  <para style="q1" vid="ISA 10:15">ಕೋಲು ತನ್ನನ್ನು ಎತ್ತಿದವನ ಮೇಲೆಯೇ ಬೀಸುವಂತೆ ಕೋಲು ಹಿಡಿದವನನ್ನೇ ಹೊಡೆದಂತಾಯಿತು!</para>
  <para style="q2" vid="ISA 10:15">ನಿರ್ಜೀವ ಬೆತ್ತ ಸಜೀವ ಮನುಷ್ಯನನ್ನೇ ಬಡಿದಂತಾಯಿತು!<verse eid="ISA 10:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="ISA 10:16"/>ಆದಕಾರಣ ಸೇನಾಧೀಶ್ವರ ಯೆಹೋವ ದೇವರು ಅವನ ಕೊಬ್ಬಿದ ಯೋಧರಿಗೆ ಕ್ಷಯವನ್ನು ಉಂಟುಮಾಡುವರು,</para>
  <para style="q2" vid="ISA 10:16">ದಹಿಸುವ ಅಗ್ನಿಯಂತಿರುವ ಉರಿಯೊಂದು ಅವನ ವೈಭವದ ಕೆಳಗೆ ಹತ್ತಿಕೊಳ್ಳುವುದು.<verse eid="ISA 10:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="ISA 10:17"/>ಇಸ್ರಾಯೇಲಿನ ಬೆಳಕು ಬೆಂಕಿಯಾಗುವುದು,</para>
  <para style="q2" vid="ISA 10:17">ಅದರ ಪರಿಶುದ್ಧರು ಜ್ವಾಲೆಯಂತಿರುವರು,</para>
  <para style="q1" vid="ISA 10:17">ಅದು ಒಂದೇ ದಿನದಲ್ಲಿ ಅವನ ಮುಳ್ಳು,</para>
  <para style="q2" vid="ISA 10:17">ದತ್ತೂರಿಗಳನ್ನು ದಹಿಸಿ ನುಂಗಿಬಿಡುವುದು.<verse eid="ISA 10:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="ISA 10:18"/>ದೇಹಾತ್ಮದಂಥ ಅದರ ಉದ್ಯಾನವನವನ್ನೂ,</para>
  <para style="q2" vid="ISA 10:18">ಫಲಭರಿತ ತೋಟದ ವೈಭವವನ್ನು ನಿರ್ಮೂಲ ಮಾಡುವುದು.</para>
  <para style="q2" vid="ISA 10:18">ದೇಶವೋ ರೋಗಿಯಂತೆ ನಾಶವಾಗುವುದು.<verse eid="ISA 10:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="ISA 10:19"/>ಅವನ ಉಳಿದ ವನವೃಕ್ಷಗಳು ಮಗುವು ಬರೆಯುವಷ್ಟು ಕಡಿಮೆಯಾಗಿರುವುದು.<verse eid="ISA 10:19"/></para>
  <para style="s1">ಇಸ್ರಾಯೇಲರಲ್ಲಿ ಉಳಿದವರು</para>
  <para style="q1">
    <verse number="20" style="v" sid="ISA 10:20"/>ಆ ದಿನದಲ್ಲಿ ಇಸ್ರಾಯೇಲರಲ್ಲಿ ಉಳಿದವರೂ,</para>
  <para style="q2" vid="ISA 10:20">ಯಾಕೋಬಿನ ಮನೆತನದಿಂದ</para>
  <para style="q1" vid="ISA 10:20">ತಪ್ಪಿಸಿಕೊಂಡವರೂ ಇನ್ನು ಮೇಲೆ</para>
  <para style="q2" vid="ISA 10:20">ತಮ್ಮನ್ನು ಹೊಡೆದವನ ಆಧಾರವನ್ನು ಬಿಟ್ಟು,</para>
  <para style="q1" vid="ISA 10:20">ಇಸ್ರಾಯೇಲಿನ ಪರಿಶುದ್ಧರಾದ ಯೆಹೋವ ದೇವರ</para>
  <para style="q2" vid="ISA 10:20">ಸತ್ಯವಾಗಿ ಆಧಾರಮಾಡಿಕೊಳ್ಳುವರು.<verse eid="ISA 10:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="ISA 10:21"/>ಉಳಿದವರು ಅಂದರೆ ಯಾಕೋಬ್ಯರಲ್ಲಿ ಉಳಿದವರೂ ಸಹ</para>
  <para style="q2" vid="ISA 10:21">ಪರಾಕ್ರಮಿಯಾದ ದೇವರ ಕಡೆಗೆ ಹಿಂದಿರುಗುವರು.<verse eid="ISA 10:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="ISA 10:22"/>ತಮ್ಮ ಜನರಾದ ಇಸ್ರಾಯೇಲರು ಸಮುದ್ರದ ಉಸುಬಿನಂತಿದ್ದರೂ,</para>
  <para style="q2" vid="ISA 10:22">ಅವರಲ್ಲಿ ಉಳಿದವರು ಮಾತ್ರ ಹಿಂದಿರುಗುವರು.</para>
  <para style="q1" vid="ISA 10:22">ಅವರ ಅಳಿವು ಶಾಸನಬದ್ಧವಾದುದು;</para>
  <para style="q2" vid="ISA 10:22">ಹಾಗೂ ಸಂಪೂರ್ಣವಾಗಿ ನ್ಯಾಯಸಮ್ಮತವಾದುದು.<verse eid="ISA 10:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="ISA 10:23"/>ಏಕೆಂದರೆ ಸೇನಾಧೀಶ್ವರ ಯೆಹೋವ ದೇವರೆಂಬ ಕರ್ತ ಆಗಿರುವವರು, ಎಲ್ಲಾ ದೇಶದ</para>
  <para style="q2" vid="ISA 10:23">ಮಧ್ಯದಲ್ಲಿ ತಿಳಿಸಿದ ವಿನಾಶವನ್ನು ಉಂಟುಮಾಡುವರು.<verse eid="ISA 10:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="ISA 10:24"/>ಆದ್ದರಿಂದ ಸೇನಾಧೀಶ್ವರ ಯೆಹೋವ ದೇವರು ಹೇಳುವುದೇನೆಂದರೆ:</para>
  <para style="q1" vid="ISA 10:24">ಚೀಯೋನಿನಲ್ಲಿ ವಾಸಿಸುವ ನನ್ನ ಜನರೇ,</para>
  <para style="q2" vid="ISA 10:24">ಈಜಿಪ್ಟಿನವರಂತೆ ನಿಮ್ಮನ್ನು ಕೋಲಿನಿಂದ ಹೊಡೆದು,</para>
  <para style="q1" vid="ISA 10:24">ನಿಮಗೆ ವಿರುದ್ಧವಾಗಿ ದೊಣ್ಣೆಯನ್ನು</para>
  <para style="q2" vid="ISA 10:24">ಎತ್ತುವ ಅಸ್ಸೀರಿಯದವರಿಗೆ ಭಯಪಡಬೇಡಿರಿ.<verse eid="ISA 10:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="ISA 10:25"/>ನನ್ನ ಕೋಪವು ಅವರ ದಂಡನೆಗಾಗುವುದು;</para>
  <para style="q2" vid="ISA 10:25">ಆದ್ದರಿಂದ ಇನ್ನು ಸ್ವಲ್ಪಕಾಲದಲ್ಲಿ ಕೋಪವು ತೀರಿಹೋಗುವುದು.<verse eid="ISA 10:25"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="26" style="v" sid="ISA 10:26"/>ಸೇನಾಧೀಶ್ವರ ಯೆಹೋವ ದೇವರು</para>
  <para style="q2" vid="ISA 10:26">ಓರೇಬ್ ಬಂಡೆಯ ಬಳಿಯಲ್ಲಿ ಮಿದ್ಯಾನ್ಯರನ್ನು ಹತಮಾಡಿದಂತೆ,</para>
  <para style="q1" vid="ISA 10:26">ಅವರು ಕೋಲನ್ನು ಸಮುದ್ರದ ಮೇಲೆ ಚಾಚಿ,</para>
  <para style="q2" vid="ISA 10:26">ಈಜಿಪ್ಟಿನವರ ಮೇಲೆ ಎತ್ತಿದಂತೆ ಎತ್ತುವರು.<verse eid="ISA 10:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="ISA 10:27"/>ಆ ದಿನದಲ್ಲಿ ಅವರು ಹೊರಿಸಿದ ಹೊರೆಯು</para>
  <para style="q2" vid="ISA 10:27">ನಿಮ್ಮ ಬೆನ್ನಿನಿಂದಲೂ, ಹೂಡಿದ ನೊಗವು</para>
  <para style="q1" vid="ISA 10:27">ನಿಮ್ಮ ಕುತ್ತಿಗೆಯಿಂದಲೂ ತೊಲಗುವುದು</para>
  <para style="q2" vid="ISA 10:27">ಮತ್ತು ನೀವು ಕೊಬ್ಬಿದ ಕಾರಣ ನೊಗವು ಮುರಿದು ಹೋಗುವುದು.<verse eid="ISA 10:27"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="28" style="v" sid="ISA 10:28"/>ಅವರು ಅಯ್ಯಾಥಿಗೆ ಬಂದರು.</para>
  <para style="q2" vid="ISA 10:28">ಮಿಗ್ರೋನನ್ನು ಹಾದು ಹೋಗಿ,</para>
  <para style="q2" vid="ISA 10:28">ಮಿಕ್ಮಾಷಿನಲ್ಲಿ ತಮ್ಮ ಸಾಮಗ್ರಿಯನ್ನು ಇಟ್ಟಿದ್ದಾರೆ.<verse eid="ISA 10:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="ISA 10:29"/>ಅವರು ಕಣಿವೆಯನ್ನು ದಾಟಿದ್ದಾರೆ;</para>
  <para style="q2" vid="ISA 10:29">ಗಿಬೆಯದಲ್ಲಿ ಇಳುಕೊಂಡಿದ್ದಾರೆ.</para>
  <para style="q1" vid="ISA 10:29">ರಾಮಾ ಜನತೆ ಹೆದರುತ್ತಿದೆ;</para>
  <para style="q2" vid="ISA 10:29">ಸೌಲನ ಗಿಬೆಯದ ಜನತೆ ಓಡಿಹೋಗಿದೆ.<verse eid="ISA 10:29"/></para>
  <para style="q1">
    <verse number="30" style="v" sid="ISA 10:30"/>ಗಲ್ಲೀಮ್ ಮಗಳೇ, ನಿನ್ನ ಸ್ವರವೆತ್ತಿ ಕೂಗು;</para>
  <para style="q2" vid="ISA 10:30">ಬಡ ಅನಾತೋತೇ,</para>
  <para style="q2" vid="ISA 10:30">ಲಯೆಷಿನವರೆಗೂ ಕೇಳಿಸುವಂತೆ ಕೂಗು.<verse eid="ISA 10:30"/></para>
  <para style="q1">
    <verse number="31" style="v" sid="ISA 10:31"/>ಮದ್ಮೇನ ದಿಕ್ಕುಪಾಲಾಯಿತು.</para>
  <para style="q2" vid="ISA 10:31">ಗೆಬೀಮಿನ ನಿವಾಸಿಗಳು ಓಡಿಹೋಗಲು ಕೂಡಿಕೊಂಡರು.<verse eid="ISA 10:31"/></para>
  <para style="q1">
    <verse number="32" style="v" sid="ISA 10:32"/>ಆ ದಿನದಲ್ಲಿ ಅವರು ನೋಬಿನಲ್ಲಿ ಇಳಿದುಕೊಳ್ಳುವರು.</para>
  <para style="q2" vid="ISA 10:32">ಚೀಯೋನ್ ನಗರಿಯ ಪರ್ವತದ ಕಡೆಗೆ,</para>
  <para style="q1" vid="ISA 10:32">ಯೆರೂಸಲೇಮಿನ ಬೆಟ್ಟದ ಕಡೆಗೆ ಕೈ ಬೀಸುತ್ತಾರೆ.<verse eid="ISA 10:32"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="33" style="v" sid="ISA 10:33"/>ಇಗೋ, ಕರ್ತದೇವರು ಆಗಿರುವ ಸೇನಾಧೀಶ್ವರ ಯೆಹೋವ ದೇವರು</para>
  <para style="q2" vid="ISA 10:33">ಭಯಂಕರವಾಗಿ ಕೊಂಬೆಯನ್ನು ಕತ್ತರಿಸುವರು.</para>
  <para style="q1" vid="ISA 10:33">ಉನ್ನತ ವೃಕ್ಷಗಳು ಕಡಿದು ಕೆಳಗೆ ಬೀಳುವುವು,</para>
  <para style="q2" vid="ISA 10:33">ಎತ್ತರದ ಮರಗಳನ್ನು ನೆಲಕ್ಕೆ ಉರುಳಿಸುವರು.<verse eid="ISA 10:33"/></para>
  <para style="q1">
    <verse number="34" style="v" sid="ISA 10:34"/>ಅವರು ಅಡವಿಯ ಪೊದೆಗಳನ್ನು ಕೊಡಲಿಯಿಂದ ಕಡಿದುಬಿಡುವರು.</para>
  <para style="q2" vid="ISA 10:34">ಲೆಬನೋನು ಪರಾಕ್ರಮಿಯಾಗಿರುವವರ ಮುಂದೆ ಬಿದ್ದುಹೋಗುವುದು.<verse eid="ISA 10:34"/></para>
  <chapter eid="ISA 10"/>
  <chapter number="11" style="c" sid="ISA 11"/>
  <para style="s1">ಇಷಯನ ಕೊಂಬೆ</para>
  <para style="q1">
    <verse number="1" style="v" sid="ISA 11:1"/>ಇಷಯನ ಬುಡದಿಂದ ಒಂದು ಚಿಗುರು ಒಡೆಯುವುದು</para>
  <para style="q2" vid="ISA 11:1">ಮತ್ತು ಅದರ ಬೇರಿನಿಂದ ಕೊಂಬೆಯು ಫಲಕೊಡುವುದು.<verse eid="ISA 11:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 11:2"/>ಅವನ ಮೇಲೆ ಯೆಹೋವ ದೇವರ ಆತ್ಮ,</para>
  <para style="q2" vid="ISA 11:2">ಜ್ಞಾನ ಮತ್ತು ವಿವೇಕದಾಯಕ ಆತ್ಮ,</para>
  <para style="q2" vid="ISA 11:2">ಸಮಾಲೋಚನೆ ಮತ್ತು ಪರಾಕ್ರಮಗಳನ್ನು ಹುಟ್ಟಿಸುವ ಆತ್ಮ,</para>
  <para style="q2" vid="ISA 11:2">ತಿಳುವಳಿಕೆ ಮತ್ತು ಯೆಹೋವ ದೇವರ ಭಯದ ಆತ್ಮ,<verse eid="ISA 11:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 11:3"/>ಅವರು ಯೆಹೋವ ದೇವರ ಭಯದಲ್ಲಿ ಆನಂದಿಸುವರು.</para>
  <para style="b" vid="ISA 11:3"/>
  <para style="q1" vid="ISA 11:3">ಅವರು ಕಣ್ಣಿಗೆ ಕಂಡಂತೆ ತೀರ್ಪು ಮಾಡುವುದಿಲ್ಲ,</para>
  <para style="q2" vid="ISA 11:3">ತಮ್ಮ ಕಿವಿಗಳ ಕೇಳ್ವಿಕೆಯ ಪ್ರಕಾರವೂ ತೀರ್ಪು ಮಾಡುವುದಿಲ್ಲ.<verse eid="ISA 11:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 11:4"/>ಆದರೆ ಭೂಮಿಯ ಬಡವರಿಗೆ ನೀತಿಯಿಂದ ನ್ಯಾಯತೀರಿಸುವರು.</para>
  <para style="q2" vid="ISA 11:4">ಭೂಲೋಕದ ದೀನರಿಗೆ ನ್ಯಾಯವಾಗಿ ತೀರ್ಪುಮಾಡುವರು,</para>
  <para style="q1" vid="ISA 11:4">ಭೂಮಿಯನ್ನು ತಮ್ಮ ಬಾಯಿಯ ಕೋಲಿನಿಂದ ಹೊಡೆಯುವರು.</para>
  <para style="q2" vid="ISA 11:4">ತಮ್ಮ ತುಟಿಗಳ ಉಸಿರಿನಿಂದ ದುಷ್ಟರನ್ನು ಹತಮಾಡುವರು.<verse eid="ISA 11:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 11:5"/>ನೀತಿಯೇ ಅವರಿಗೆ ನಡುಕಟ್ಟು,</para>
  <para style="q2" vid="ISA 11:5">ನಂಬಿಗಸ್ತಿಕೆಯೇ ಅವರ ಸೊಂಟದ ಪಟ್ಟಿ.<verse eid="ISA 11:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 11:6"/>ತೋಳವು ಕುರಿಯ ಸಂಗಡ ವಾಸಿಸುವುದು;</para>
  <para style="q2" vid="ISA 11:6">ಚಿರತೆಯು ಮೇಕೆ ಮರಿಯೊಂದಿಗೆ ಮಲಗುವುದು;</para>
  <para style="q1" vid="ISA 11:6">ಕರುವೂ, ಪ್ರಾಯದ ಸಿಂಹವೂ, ಪುಷ್ಟಪಶುವೂ ಒಟ್ಟಿಗಿರುವುವು;</para>
  <para style="q2" vid="ISA 11:6">ಇವುಗಳನ್ನು ಒಂದು ಪುಟ್ಟ ಮಗುವು ನಡೆಸುವುದು.<verse eid="ISA 11:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 11:7"/>ಹಸುವು ಕರಡಿಯ ಸಂಗಡ ಮೇಯುವುವು;</para>
  <para style="q2" vid="ISA 11:7">ಅವುಗಳ ಮರಿಗಳು ಜೊತೆಯಾಗಿ ಮಲಗುವುವು;</para>
  <para style="q2" vid="ISA 11:7">ಸಿಂಹವು ಎತ್ತಿನಂತೆ ಹುಲ್ಲನ್ನು ಮೇಯುವುದು.<verse eid="ISA 11:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 11:8"/>ಹಸುಳೆಯು ನಾಗರ ಹಾವಿನ ಹುತ್ತದ ಮೇಲೆ ಆಡುವುದು</para>
  <para style="q2" vid="ISA 11:8">ಮತ್ತು ಪುಟ್ಟ ಮಗುವು ಹಾವಿನ ಬಿಲದ ಒಳಗೆ ಕೈ ಹಾಕುವುದು.<verse eid="ISA 11:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 11:9"/>ನನ್ನ ಪರಿಶುದ್ಧ ಪರ್ವತದಲ್ಲಿ ಯಾರೂ ಕೇಡುಮಾಡುವುದಿಲ್ಲ,</para>
  <para style="q2" vid="ISA 11:9">ಯಾರೂ ಹಾಳುಮಾಡುವುದಿಲ್ಲ.</para>
  <para style="q1" vid="ISA 11:9">ಏಕೆಂದರೆ ಸಮುದ್ರವು ನೀರಿನಿಂದ ತುಂಬಿಕೊಂಡಿರುವಂತೆ,</para>
  <para style="q2" vid="ISA 11:9">ಯೆಹೋವ ದೇವರ ತಿಳುವಳಿಕೆಯು ಭೂಮಿಯಲ್ಲಿ ತುಂಬಿಕೊಂಡಿರುವುದು.<verse eid="ISA 11:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="ISA 11:10"/>ಆ ದಿನದಲ್ಲಿ ಇಷಯನ ವಂಶದಿಂದ ಜನರಿಗೆ ಒಂದು ಬೇರು ಗುರುತಿನ ಧ್ವಜವಾಗಿ ನಿಲ್ಲುವುದು. ಅವರ ವಿಶ್ರಾಂತಿ ಸ್ಥಳವು ಮಹಿಮೆಯುಳ್ಳದ್ದಾಗಿರುವುದು. <verse eid="ISA 11:10"/><verse number="11" style="v" sid="ISA 11:11"/>ಆ ದಿನದಲ್ಲಿ ಯೆಹೋವ ದೇವರು ಉಳಿದ ತಮ್ಮ ಜನರನ್ನು ಬಿಡಿಸಿಕೊಳ್ಳುವುದಕ್ಕೆ ಎರಡನೇ ಸಾರಿ ಕೈಹಾಕಿ ಅಸ್ಸೀರಿಯ, ಈಜಿಪ್ಟ್, ಪತ್ರೋಸ್, ಕೂಷ್, ಏಲಾಮ್, ಶಿನಾರ್, ಹಮಾತ್ ಮತ್ತು ಮೆಡಿಟರೇನಿಯನ್ ಸಮುದ್ರದ ದ್ವೀಪಗಳಿಂದಲೂ ಉಳಿದವರನ್ನು ಬರಮಾಡಿಕೊಳ್ಳುವರು.<verse eid="ISA 11:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 11:12"/>ಜನಾಂಗಗಳಿಗೆ ಗುರುತಾಗಿ ಧ್ವಜವನ್ನೆತ್ತಿ</para>
  <para style="q2" vid="ISA 11:12">ಇಸ್ರಾಯೇಲಿನಿಂದ ತಳ್ಳಿಬಿಟ್ಟವರನ್ನು ಕೂಡಿಸುವನು.</para>
  <para style="q1" vid="ISA 11:12">ಯೆಹೂದದಿಂದ ಚದರಿದವರನ್ನು</para>
  <para style="q2" vid="ISA 11:12">ಭೂಮಿಯ ನಾಲ್ಕು ಕಡೆಗಳಿಂದ ಒಟ್ಟುಗೂಡಿಸುವನು.<verse eid="ISA 11:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="ISA 11:13"/>ಎಫ್ರಾಯೀಮಿನ ಹೊಟ್ಟೆಕಿಚ್ಚು ತೊಲಗಿ,</para>
  <para style="q2" vid="ISA 11:13">ಯೆಹೂದದ ವಿರೋಧಿಗಳು ಇಲ್ಲದಂತಾಗುವರು.</para>
  <para style="q1" vid="ISA 11:13">ಹೀಗೆ ಎಫ್ರಾಯೀಮು ಯೆಹೂದದ ಮೇಲೆ ಹೊಟ್ಟೆಕಿಚ್ಚು ಪಡುವುದಿಲ್ಲ;</para>
  <para style="q2" vid="ISA 11:13">ಯೆಹೂದವು ಎಫ್ರಾಯೀಮಿಗೆ ವಿರೋಧವಾಗಿರುವುದಿಲ್ಲ.<verse eid="ISA 11:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="ISA 11:14"/>ಆದರೆ ಅವರು ಪಶ್ಚಿಮ ದಿಕ್ಕಿಗೆ ಫಿಲಿಷ್ಟಿಯರ ಇಳಿಜಾರು ಪ್ರದೇಶದ ಮೇಲೆ ಎರಗುವರು.</para>
  <para style="q2" vid="ISA 11:14">ಅವರು ಜೊತೆಯಾಗಿ ಪೂರ್ವದವರನ್ನು ಸೂರೆ ಮಾಡುವರು,</para>
  <para style="q1" vid="ISA 11:14">ಅವರು ಎದೋಮಿನ ಮತ್ತು ಮೋವಾಬಿನ ಮೇಲೆ ತಮ್ಮ ಕೈಯನ್ನು</para>
  <para style="q2" vid="ISA 11:14">ದಾಳಿಮಾಡುವರು ಮತ್ತು ಅಮ್ಮೋನಿಯರು ಅವರಿಗೆ ಅಧೀನರಾಗುವರು.<verse eid="ISA 11:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="ISA 11:15"/>ಯೆಹೋವ ದೇವರು ಈಜಿಪ್ಟಿನ ಸಮುದ್ರದ ಕೊಲ್ಲಿಯನ್ನು</para>
  <para style="q2" vid="ISA 11:15">ಸಂಪೂರ್ಣವಾಗಿ ತೆಗೆದುಹಾಕುವರು,</para>
  <para style="q1" vid="ISA 11:15">ಅವರು ತಮ್ಮ ಉಷ್ಣಗಾಳಿಯಿಂದ</para>
  <para style="q2" vid="ISA 11:15">ಯೂಫ್ರೇಟೀಸ್ ನದಿಯ ಮೇಲೆ ಕೈಯನ್ನು ಝಾಡಿಸಿ,</para>
  <para style="q1" vid="ISA 11:15">ಅದನ್ನು ಏಳು ಹೊಳೆಗಳಾಗಿ ಒಡೆದು,</para>
  <para style="q2" vid="ISA 11:15">ಮನುಷ್ಯರ ಕೆರಗಳು ನೆನೆಯದಂತೆ ದಾಟಿಸುವರು.<verse eid="ISA 11:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="ISA 11:16"/>ಇದಲ್ಲದೆ ಇಸ್ರಾಯೇಲರು ಈಜಿಪ್ಟ್ ದೇಶದಿಂದ</para>
  <para style="q2" vid="ISA 11:16">ಹೊರಟು ಬಂದ ಕಾಲದಲ್ಲಿ ಅವರಿಗೆ ಹೇಗೆ ಮಾರ್ಗವು ಇತ್ತೋ</para>
  <para style="q1" vid="ISA 11:16">ಹಾಗೆಯೇ ಅಸ್ಸೀರಿಯದಿಂದ ತಪ್ಪಿಸಿಕೊಂಡು ಬರುವ</para>
  <para style="q2" vid="ISA 11:16">ತಮ್ಮ ಉಳಿದ ಜನರಿಗೆ ವಿಶಾಲವಾದ ಮಾರ್ಗವು ಇರುವುದು.<verse eid="ISA 11:16"/></para>
  <chapter eid="ISA 11"/>
  <chapter number="12" style="c" sid="ISA 12"/>
  <para style="s1">ಸ್ತೋತ್ರ ಗೀತೆಗಳು</para>
  <para style="p">
    <verse number="1" style="v" sid="ISA 12:1"/>ಆ ದಿನದಲ್ಲಿ ನೀನು ಹೇಳುವುದೇನೆಂದರೆ:</para>
  <para style="q1" vid="ISA 12:1">“ಯೆಹೋವ ದೇವರೇ, ನಾನು ನಿಮಗೆ ಕೃತಜ್ಞತೆಯನ್ನು ಸಲ್ಲಿಸುವೆನು;</para>
  <para style="q2" vid="ISA 12:1">ನೀವು ನನ್ನ ಮೇಲೆ ಕೋಪಗೊಂಡಿದ್ದರೂ,</para>
  <para style="q1" vid="ISA 12:1">ಆ ನಿಮ್ಮ ಕೋಪವು ಪರಿಹಾರವಾಗಿ</para>
  <para style="q2" vid="ISA 12:1">ನನ್ನನ್ನು ಸಂತೈಸುತ್ತೀರಲ್ಲವೆ?<verse eid="ISA 12:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 12:2"/>ನಿಜವಾಗಿಯೂ ದೇವರೇ ನನಗೆ ರಕ್ಷಣೆಯು,</para>
  <para style="q2" vid="ISA 12:2">ನಾನು ಭರವಸವಿಡುವೆನು ಮತ್ತು ಭಯಪಡೆನು.</para>
  <para style="q1" vid="ISA 12:2">ಕರ್ತರಾದ ಯೆಹೋವ ದೇವರೇ ನನ್ನ ಬಲವೂ ನನ್ನ ಕೀರ್ತನೆಯೂ,</para>
  <para style="q2" vid="ISA 12:2">ಅವರೇ ನನಗೆ ರಕ್ಷಣೆಯೂ ಆಗಿದ್ದಾರೆ.”<verse eid="ISA 12:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 12:3"/>ರಕ್ಷಣೆಯೆಂಬ ಬಾವಿಗಳಿಂದ ಆನಂದದೊಡನೆ</para>
  <para style="q2" vid="ISA 12:3">ನೀವು ನೀರನ್ನು ಸೇದುವಿರಿ.<verse eid="ISA 12:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="ISA 12:4"/>ಆ ದಿನದಲ್ಲಿ ನೀವು ಹೀಗೆ ಹೇಳುವಿರಿ,</para>
  <para style="q1" vid="ISA 12:4">“ಯೆಹೋವ ದೇವರನ್ನು ಕೊಂಡಾಡಿರಿ. ಅವರ ಹೆಸರನ್ನೆತ್ತಿ ಜನರ ಮಧ್ಯದಲ್ಲಿ</para>
  <para style="q2" vid="ISA 12:4">ಅವರ ಕ್ರಿಯೆಗಳನ್ನು ಪ್ರಕಟಿಸಿರಿ.</para>
  <para style="q2" vid="ISA 12:4">ಅವರ ನಾಮವನ್ನು ಉನ್ನತೋನ್ನತವೆಂದು ಎತ್ತಿ ಹೇಳಿರಿ.<verse eid="ISA 12:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 12:5"/>ಯೆಹೋವ ದೇವರಿಗೆ ಹಾಡಿರಿ.</para>
  <para style="q2" vid="ISA 12:5">ಏಕೆಂದರೆ, ಅವರು ಮಹಿಮೆಯ ಕಾರ್ಯಗಳನ್ನು ಮಾಡಿದ್ದಾರೆ.</para>
  <para style="q2" vid="ISA 12:5">ಇದು ಭೂಮಂಡಲದಲ್ಲೆಲ್ಲಾ ತಿಳಿದಿರಲಿ.<verse eid="ISA 12:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 12:6"/>ಚೀಯೋನಿನ ನಿವಾಸಿಗಳೇ, ಆರ್ಭಟಿಸಿ ಹರ್ಷಧ್ವನಿಯನ್ನು ಗೈಯಿರಿ.</para>
  <para style="q2" vid="ISA 12:6">ಏಕೆಂದರೆ, ಇಸ್ರಾಯೇಲಿನ ಪರಿಶುದ್ಧರು ನಿಮ್ಮ ಮಧ್ಯದಲ್ಲಿ ಮಹತ್ವವುಳ್ಳವರಾಗಿದ್ದಾರೆ.”<verse eid="ISA 12:6"/></para>
  <chapter eid="ISA 12"/>
  <chapter number="13" style="c" sid="ISA 13"/>
  <para style="s1">ಬಾಬಿಲೋನಿನ ವಿರುದ್ಧ ಪ್ರವಾದನೆ</para>
  <para style="p">
    <verse number="1" style="v" sid="ISA 13:1"/>ಆಮೋಚನ ಮಗ ಯೆಶಾಯನಿಗೆ ಬಾಬಿಲೋನಿನ ವಿಷಯವಾಗಿ ಬಂದ ಪ್ರವಾದನೆ:<verse eid="ISA 13:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 13:2"/>ಶತ್ರುಗಳು ಬಂದು ಶ್ರೇಷ್ಠರ ದ್ವಾರಗಳೊಳಗೆ ಹೋಗುವಂತೆ ಎತ್ತರವಾದ ಪರ್ವತದ ಮೇಲೆ</para>
  <para style="q2" vid="ISA 13:2">ನೀವು ಧ್ವಜವನ್ನೆತ್ತಿ</para>
  <para style="q1" vid="ISA 13:2">ಅವರಿಗೆ ನಿಮ್ಮ ಶಬ್ದವನ್ನು ಕೇಳಿಸುವಂತೆ</para>
  <para style="q2" vid="ISA 13:2">ಜೋರಾಗಿ ಕೂಗಿ ಕರೆಯಿರಿ.<verse eid="ISA 13:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 13:3"/>ನಾನು ನನ್ನ ಪರಿಶುದ್ಧರಿಗೆ ಆಜ್ಞಾಪಿಸಿ, ನನ್ನ ಜಯದಲ್ಲಿ ಉಲ್ಲಾಸಿಸುವವರನ್ನೂ,</para>
  <para style="q2" vid="ISA 13:3">ನನ್ನ ಶೂರರನ್ನೂ ಸಹ</para>
  <para style="q2" vid="ISA 13:3">ನನ್ನ ಕೋಪವನ್ನು ತೆಗೆದುಕೊಂಡು ಹೋಗಲು ಕರೆದಿದ್ದೇನೆ.<verse eid="ISA 13:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 13:4"/>ಬಹು ಸಮೂಹವು ಇದ್ದಂತೆ</para>
  <para style="q2" vid="ISA 13:4">ಗದ್ದಲವು ಬೆಟ್ಟಗಳಲ್ಲಿ ಕೇಳಿಬರುತ್ತದೆ.</para>
  <para style="q1" vid="ISA 13:4">ಒಟ್ಟಿಗೆ ಕೂಡಿಕೊಂಡ</para>
  <para style="q2" vid="ISA 13:4">ರಾಜ್ಯಗಳ ಜನಾಂಗಗಳ ಆರ್ಭಟ,</para>
  <para style="q1" vid="ISA 13:4">ಸೇನಾಧೀಶ್ವರ ಯೆಹೋವ ದೇವರು</para>
  <para style="q2" vid="ISA 13:4">ಯುದ್ಧಕ್ಕೆ ಸೈನ್ಯವನ್ನು ಸಿದ್ಧಮಾಡುತ್ತಾರೆ.<verse eid="ISA 13:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 13:5"/>ಯೆಹೋವ ದೇವರು ಮತ್ತು ಅವರ ರೋಷಕ್ಕೆ</para>
  <para style="q2" vid="ISA 13:5">ಆಯುಧಗಳಾದವರು ದೂರದೇಶದಿಂದ ಎಂದರೆ,</para>
  <para style="q1" vid="ISA 13:5">ಆಕಾಶಮಂಡಲದ ಕಟ್ಟಕಡೆಯಿಂದ</para>
  <para style="q2" vid="ISA 13:5">ದೇಶವನ್ನೆಲ್ಲಾ ಹಾಳುಮಾಡುವುದಕ್ಕಾಗಿ ಬರುತ್ತಾರೆ.<verse eid="ISA 13:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 13:6"/>ನೀವು ಗೋಳಾಡಿರಿ. ಏಕೆಂದರೆ, ಯೆಹೋವ ದೇವರ ದಿನವು ಸಮೀಪವಾಯಿತು.</para>
  <para style="q2" vid="ISA 13:6">ಅದು ಸರ್ವಶಕ್ತರಿಂದ ನಾಶರೂಪವಾಗಿ ಬರುವುದು.<verse eid="ISA 13:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 13:7"/>ಆದಕಾರಣ ಎಲ್ಲಾ ಕೈಗಳು ಜೋಲು ಬೀಳುವುವು</para>
  <para style="q2" vid="ISA 13:7">ಮತ್ತು ಪ್ರತಿಯೊಬ್ಬನ ಹೃದಯವು ಕರಗುವುದು.<verse eid="ISA 13:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 13:8"/>ಅವರು ಭಯಪಡುವರು.</para>
  <para style="q2" vid="ISA 13:8">ನೋವು ಮತ್ತು ಬೇನೆಗಳು ಅವರನ್ನು ಆವರಿಸಿಕೊಳ್ಳುವುವು.</para>
  <para style="q2" vid="ISA 13:8">ಪ್ರಸವವೇದನೆಯಲ್ಲಿರುವ ಸ್ತ್ರೀಯರಂತೆ ಸಂಕಟಪಡುವರು.</para>
  <para style="q1" vid="ISA 13:8">ಅವರು ಒಬ್ಬರಿಗೊಬ್ಬರು ಭ್ರಮೆ ಪಡುವರು.</para>
  <para style="q2" vid="ISA 13:8">ಅವರ ಮುಖಗಳು ಜ್ವಾಲೆಯಂತಿರುವುವು.<verse eid="ISA 13:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 13:9"/>ಇಗೋ, ಯೆಹೋವ ದೇವರ ದಿನವು ಬರುತ್ತದೆ.</para>
  <para style="q2" vid="ISA 13:9">ಅದು ಭೂಮಿಯನ್ನು ಹಾಳು ಮಾಡುವುದಕ್ಕೂ,</para>
  <para style="q1" vid="ISA 13:9">ಅಲ್ಲಿಂದ ಪಾಪಿಗಳನ್ನು ನಿರ್ಮೂಲ ಮಾಡುವುದಕ್ಕೂ,</para>
  <para style="q2" vid="ISA 13:9">ಕಡುಕೋಪದಿಂದಲೂ, ತೀಕ್ಷ್ಣರೋಷದಿಂದಲೂ ಕ್ರೂರವಾಗಿರುವುದು.<verse eid="ISA 13:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 13:10"/>ಏಕೆಂದರೆ, ಆಕಾಶದ ನಕ್ಷತ್ರಗಳು</para>
  <para style="q2" vid="ISA 13:10">ಮತ್ತು ಅದರ ರಾಶಿಗಳು ತಮ್ಮ ಬೆಳಕನ್ನು ಕೊಡುವುದಿಲ್ಲ.</para>
  <para style="q1" vid="ISA 13:10">ಸೂರ್ಯನು ಮೂಡುತ್ತಲೇ ಕತ್ತಲಾಗುವನು.</para>
  <para style="q2" vid="ISA 13:10">ಚಂದ್ರನು ತನ್ನ ಬೆಳಕನ್ನು ಕೊಡುವುದಿಲ್ಲ.<verse eid="ISA 13:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 13:11"/>ಅವರ ಕೆಟ್ಟ ಕಾರ್ಯಗಳಿಗೋಸ್ಕರವೂ,</para>
  <para style="q2" vid="ISA 13:11">ದುಷ್ಟರ ಅಪರಾಧಗಳಿಗೋಸ್ಕರವೂ ನಾನು ಲೋಕವನ್ನು ಶಿಕ್ಷಿಸುವೆನು,</para>
  <para style="q1" vid="ISA 13:11">ಗರ್ವಿಷ್ಠರ ಅಹಂಕಾರವನ್ನು ನಿಲ್ಲಿಸಿಬಿಡುವೆನು.</para>
  <para style="q2" vid="ISA 13:11">ಭಯಂಕರವಾದವರ ಹೆಮ್ಮೆಯನ್ನು ತಗ್ಗಿಸುವೆನು.<verse eid="ISA 13:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 13:12"/>ಮನುಷ್ಯರನ್ನು ಚೊಕ್ಕ ಬಂಗಾರಕ್ಕಿಂತಲೂ,</para>
  <para style="q2" vid="ISA 13:12">ಓಫೀರ್ ಬಂಗಾರಕ್ಕಿಂತಲೂ ಜನರು ವಿರಳವಾಗಿರುವಂತೆ ಮಾಡುವೆನು.<verse eid="ISA 13:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="ISA 13:13"/>ಆದ್ದರಿಂದ ಸೇನಾಧೀಶ್ವರ ಯೆಹೋವ ದೇವರ ಕೋಪವೂ,</para>
  <para style="q2" vid="ISA 13:13">ಅವರ ತೀಕ್ಷ್ಣರೋಷವೂ ಪ್ರಕಟವಾಗುವ ಆ ದಿನದಂದು,</para>
  <para style="q1" vid="ISA 13:13">ಆಕಾಶಮಂಡಲ ನಡುಗುವುದು.</para>
  <para style="q2" vid="ISA 13:13">ಭೂಮಂಡಲ ಅದರ ಸ್ಥಳದಿಂದ ಕದಲುವುದು.<verse eid="ISA 13:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="ISA 13:14"/>ಅದು ಅಟ್ಟಿದ ಜಿಂಕೆಯಂತೆಯೂ,</para>
  <para style="q2" vid="ISA 13:14">ಕುರುಬರಿಲ್ಲದ ಕುರಿಗಳಂತೆಯೂ ಇರುವುದು.</para>
  <para style="q1" vid="ISA 13:14">ಅವರಲ್ಲಿ ಪ್ರತಿಯೊಬ್ಬನೂ ತನ್ನ ಜನರ ಕಡೆಗೆ ತಿರುಗಿಕೊಳ್ಳುವನು;</para>
  <para style="q2" vid="ISA 13:14">ಪ್ರತಿಯೊಬ್ಬನು ತನ್ನ ಸ್ವದೇಶಕ್ಕೆ ಓಡಿಹೋಗುವನು.<verse eid="ISA 13:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="ISA 13:15"/>ಸಿಕ್ಕಿದ ಪ್ರತಿಯೊಬ್ಬನೂ ಇರಿತಕ್ಕೆ ಗುರಿಯಾಗುವನು.</para>
  <para style="q2" vid="ISA 13:15">ಅಟ್ಟಿಹಿಡಿಯಲಾದ ಪ್ರತಿಯೊಬ್ಬನೂ ಖಡ್ಗಕ್ಕೆ ತುತ್ತಾಗುವನು.<verse eid="ISA 13:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="ISA 13:16"/>ಅವರ ಮಕ್ಕಳೂ ಸಹ ಅವರ ಕಣ್ಣೆದುರಿಗೆ ಹತರಾಗುವರು.</para>
  <para style="q2" vid="ISA 13:16">ಅವರ ಮನೆಗಳು ಸೂರೆಮಾಡಲಾಗುವುದು. ಅವರ ಹೆಂಡತಿಯರು ಅತ್ಯಾಚಾರಕ್ಕೆ ಈಡಾಗುವರು.<verse eid="ISA 13:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="ISA 13:17"/>ಇಗೋ, ಬೆಳ್ಳಿಯನ್ನು ಲಕ್ಷಿಸದೆ,</para>
  <para style="q2" vid="ISA 13:17">ಬಂಗಾರದಲ್ಲಿ ಆನಂದಿಸದೆ ಇರುವ ಮೇದ್ಯರನ್ನು</para>
  <para style="q2" vid="ISA 13:17">ಅವರಿಗೆ ವಿರೋಧವಾಗಿ ನಾನು ಎಬ್ಬಿಸುವೆನು.<verse eid="ISA 13:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="ISA 13:18"/>ಅವರ ಬಿಲ್ಲುಗಳು ಸಹ ಯುವಕರನ್ನು ಸಂಹರಿಸುವುವು.</para>
  <para style="q2" vid="ISA 13:18">ಇವರು ಹಸುಳೆಗಳನ್ನು ಕರುಣಿಸರು.</para>
  <para style="q2" vid="ISA 13:18">ಇವರು ಮಕ್ಕಳನ್ನು ಕನಿಕರಿಸುವುದಿಲ್ಲ.<verse eid="ISA 13:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="ISA 13:19"/>ರಾಜ್ಯಗಳ ಘನತೆಯೂ,</para>
  <para style="q2" vid="ISA 13:19">ಕಸ್ದೀಯರ ಶ್ರೇಷ್ಠವಾದ ಸೌಂದರ್ಯವೂ ಆದ ಬಾಬಿಲೋನನ್ನು</para>
  <para style="q1" vid="ISA 13:19">ದೇವರು ಸೊದೋಮ್ ಗೊಮೋರಗಳನ್ನು</para>
  <para style="q2" vid="ISA 13:19">ಕೆಡವಿಬಿಟ್ಟಂತೆ ಕೆಡವಿಬಿಡುವನು.<verse eid="ISA 13:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="ISA 13:20"/>ಅದು ಎಂದಿಗೂ ನಿವಾಸ ಸ್ಥಳವಾಗದು.</para>
  <para style="q2" vid="ISA 13:20">ತಲತಲಾಂತರಕ್ಕೂ ಅಲ್ಲಿ ಯಾರೂ ವಾಸಿಸರು;</para>
  <para style="q1" vid="ISA 13:20">ಯಾವ ಅರಬಿಯನೂ ಗುಡಾರಹಾಕನು.</para>
  <para style="q2" vid="ISA 13:20">ಕುರುಬರು ಅಲ್ಲಿ ಮಂದೆಗಳನ್ನು ತಂಗಿಸರು.<verse eid="ISA 13:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="ISA 13:21"/>ಆದರೆ ಕಾಡುಮೃಗಗಳು ಅಲ್ಲಿ ಮಲಗುವುವು.</para>
  <para style="q2" vid="ISA 13:21">ಅವರ ಮನೆಗಳು ನರಿಗಳಿಂದ ತುಂಬಿರುವುವು,</para>
  <para style="q1" vid="ISA 13:21">ಅಲ್ಲಿ ಗೂಬೆಗಳು ವಾಸಿಸುವುವು</para>
  <para style="q2" vid="ISA 13:21">ಮತ್ತು ಕಾಡುಮೇಕೆಗಳು ಅಲ್ಲಿ ಕುಣಿದಾಡುವುವು.<verse eid="ISA 13:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="ISA 13:22"/>ಅವರ ಕೋಣೆಗಳಲ್ಲಿ ತೋಳಗಳು ಕೂಗುವುವು,</para>
  <para style="q2" vid="ISA 13:22">ಅವರ ಮೆಚ್ಚಿಕೆಯಾದ ಅರಮನೆಗಳಲ್ಲಿ ನರಿಗಳು ವಾಸಿಸುವುವು.</para>
  <para style="q1" vid="ISA 13:22">ಬಾಬಿಲೋನಿಗೆ ಕಾಲವು ಸಮೀಪಿಸಿತು.</para>
  <para style="q2" vid="ISA 13:22">ಇನ್ನು ಅದರ ದಿನಗಳು ಮುಂದುವರಿಯುವುದಿಲ್ಲ.<verse eid="ISA 13:22"/></para>
  <para style="b"/>
  <para style="b"/>
  <chapter eid="ISA 13"/>
  <chapter number="14" style="c" sid="ISA 14"/>
  <para style="q1">
    <verse number="1" style="v" sid="ISA 14:1"/>ಯೆಹೋವ ದೇವರು ಯಾಕೋಬ್ಯರನ್ನು ಕರುಣಿಸುವರು.</para>
  <para style="q2" vid="ISA 14:1">ಇಸ್ರಾಯೇಲರನ್ನು ಪುನಃ ಆಯ್ದುಕೊಳ್ಳುವರು.</para>
  <para style="q2" vid="ISA 14:1">ಅವರನ್ನು ಅವರ ಸ್ವಂತ ದೇಶದಲ್ಲಿ ಸೇರಿಸುವರು.</para>
  <para style="q1" vid="ISA 14:1">ಪರದೇಶದವರು ಅವರೊಂದಿಗೆ ಕೂಡಿಬಂದು,</para>
  <para style="q2" vid="ISA 14:1">ಯಾಕೋಬನ ಮನೆತನಕ್ಕೆ ಸೇರಿಕೊಳ್ಳುವರು.<verse eid="ISA 14:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 14:2"/>ದೇಶಗಳು ಇನ್ನೊಮ್ಮೆ ಅವರನ್ನು ತೆಗೆದುಕೊಂಡು</para>
  <para style="q2" vid="ISA 14:2">ಅವನ ಸ್ಥಳಕ್ಕೆ ಅವರನ್ನು ಬರಮಾಡುವರು.</para>
  <para style="q1" vid="ISA 14:2">ಆಗ ಇಸ್ರಾಯೇಲಿನ ಮನೆತನದವರು ಯೆಹೋವ ದೇವರ ದೇಶದಲ್ಲಿ,</para>
  <para style="q2" vid="ISA 14:2">ಆ ಜನಾಂಗದವರನ್ನು ಗಂಡು ಹೆಣ್ಣುಗಳನ್ನಾಗಿ ದಾಸದಾಸಿಯರನ್ನಾಗಿ ಇಟ್ಟುಕೊಳ್ಳುವರು.</para>
  <para style="q1" vid="ISA 14:2">ತಮ್ಮನ್ನು ಸೆರೆಹಿಡಿದವರನ್ನು ಸೆರೆಹಿಡಿಯುವರು.</para>
  <para style="q2" vid="ISA 14:2">ತಮ್ಮನ್ನು ದಬ್ಬಾಳಿಕೆಗಾರರ ಮೇಲೆ ಅಧಿಕಾರ ನಡೆಸುವರು.<verse eid="ISA 14:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="ISA 14:3"/>ಯೆಹೋವ ದೇವರು ನಿಮ್ಮ ಸಂಕಟದಿಂದಲೂ, ಕಳವಳದಿಂದಲೂ ಕಠಿಣವಾದ ಬಿಟ್ಟಿಯ ಸೇವೆಯಿಂದಲೂ <verse eid="ISA 14:3"/><verse number="4" style="v" sid="ISA 14:4"/>ನಿಮ್ಮನ್ನು ವಿಶ್ರಾಂತಿಗೊಳಿಸುವ ದಿನದಲ್ಲಿ ಬಾಬಿಲೋನಿನ ರಾಜನಿಗೆ ವಿರುದ್ಧವಾದ ಈ ಪದ್ಯವನ್ನು ನೀವು ಹೀಗೆ ಸ್ವರವೆತ್ತಿ ಹಾಡಬೇಕು:</para>
  <para style="q1" vid="ISA 14:4">ಹೀಗೆ ದಬ್ಬಾಳಿಕೆಗಾರನು ಕೊನೆಗೊಂಡನು.</para>
  <para style="q2" vid="ISA 14:4">ಅವನ ಕೋಪ ಹೀಗೆ ಮುಗಿಯಿತು.<verse eid="ISA 14:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 14:5"/>ಆಳುತ್ತಿದ್ದ ದುಷ್ಟರ ಕೋಲನ್ನೂ,</para>
  <para style="q2" vid="ISA 14:5">ಅಧಿಪತಿಗಳ ದಂಡವನ್ನೂ ಯೆಹೋವ ದೇವರು ಮುರಿದುಬಿಟ್ಟರು.<verse eid="ISA 14:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 14:6"/>ಆ ಅಧಿಪತಿಗಳು ಕಡುಕೋಪದಿಂದ</para>
  <para style="q2" vid="ISA 14:6">ಎಡೆಬಿಡದೆ ಜನರನ್ನು ದಂಡಿಸಿ,</para>
  <para style="q1" vid="ISA 14:6">ನಿಲ್ಲದ ದಬ್ಬಾಳಿಕೆಯಿಂದ</para>
  <para style="q2" vid="ISA 14:6">ರಾಷ್ಟ್ರಗಳನ್ನು ಅಧೀನಪಡಿಸಿಕೊಂಡಿದ್ದರು.<verse eid="ISA 14:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 14:7"/>ಭೂಲೋಕವೆಲ್ಲಾ ಶಾಂತವಾಗಿ ವಿಶ್ರಾಂತಿಗೊಂಡಿದೆ.</para>
  <para style="q2" vid="ISA 14:7">ಅವರು ಉಲ್ಲಾಸದ ಧ್ವನಿಯಿಂದ ಹಾಡುತ್ತಾರೆ.<verse eid="ISA 14:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 14:8"/>ತುರಾಯಿ ಮರಗಳೂ, ಲೆಬನೋನಿನ ದೇವದಾರು ಮರಗಳೂ,</para>
  <para style="q2" vid="ISA 14:8">“ಈಗ ನೀನು ಬಿದ್ದದ್ದರಿಂದ ನಮ್ಮನ್ನು ಕಡಿಯಲು</para>
  <para style="q1" vid="ISA 14:8">ಯಾರೂ ಬರುವುದಿಲ್ಲ,”</para>
  <para style="q2" vid="ISA 14:8">ಎಂದು ನಿನ್ನ ವಿಷಯವಾಗಿ ಉಲ್ಲಾಸಗೊಳ್ಳುತ್ತವೆ.<verse eid="ISA 14:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 14:9"/>ನಿನಗೋಸ್ಕರ ನಿನ್ನ ಬರೋಣವನ್ನು ಎದುರುಗೊಳ್ಳುವುದಕ್ಕೆ</para>
  <para style="q2" vid="ISA 14:9">ಪಾತಾಳವು ಕೆಳಗಿನಿಂದ ತಳಮಳಪಡುತ್ತದೆ.</para>
  <para style="q1" vid="ISA 14:9">ಸತ್ತವರನ್ನು ಎಂದರೆ, ಭೂಲೋಕದಲ್ಲಿ ಮುಖಂಡರಾಗಿದ್ದವರೆಲ್ಲರ</para>
  <para style="q2" vid="ISA 14:9">ಆತ್ಮಗಳನ್ನು ಕಲಕಿ ಎಚ್ಚರಿಸಿ,</para>
  <para style="q1" vid="ISA 14:9">ಜನಾಂಗಗಳ ಎಲ್ಲಾ ರಾಜರನ್ನು</para>
  <para style="q2" vid="ISA 14:9">ಅವರ ಸಿಂಹಾಸನಗಳಿಂದ ಎಬ್ಬಿಸುತ್ತದೆ.<verse eid="ISA 14:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 14:10"/>ಅವರೆಲ್ಲರು, “ನಮ್ಮ ಹಾಗೆ ನೀನು ಸಹ ಬಲಹೀನನಾಗಿದ್ದೀ.</para>
  <para style="q2" vid="ISA 14:10">ನೀನು ನಮ್ಮ ಸಮಾನನಾಗಿದ್ದೀ,”</para>
  <para style="q2" vid="ISA 14:10">ಎಂದು ಮಾತನಾಡಿ ಹೇಳುವರು.<verse eid="ISA 14:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 14:11"/>ನಿನ್ನ ವೈಭವವೂ,</para>
  <para style="q2" vid="ISA 14:11">ನಿನ್ನ ವೀಣೆಗಳ ಸ್ವರವೂ ಸಮಾಧಿಗೆ ಇಳಿದಿವೆ.</para>
  <para style="q1" vid="ISA 14:11">ನಿನಗೆ ಹುಳುಗಳೇ ಹಾಸಿಗೆ,</para>
  <para style="q2" vid="ISA 14:11">ನಿನ್ನ ಹೊದಿಕೆಯು ಕ್ರಿಮಿಗಳೇ.<verse eid="ISA 14:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 14:12"/>ಮುಂಜಾನೆಯ ನಕ್ಷತ್ರವೇ, ಉದಯ ಪುತ್ರನೇ,</para>
  <para style="q2" vid="ISA 14:12">ಆಕಾಶದಿಂದ ನೀನು ಹೇಗೆ ಬಿದ್ದೆ?</para>
  <para style="q1" vid="ISA 14:12">ಜನಾಂಗಗಳನ್ನು ಬಲಹೀನ ಮಾಡಿದ ನೀನು</para>
  <para style="q2" vid="ISA 14:12">ಭೂಮಿಗೆ ಹೇಗೆ ಬಿದ್ದೆ?<verse eid="ISA 14:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="ISA 14:13"/>ನೀನು ನಿನ್ನ ಹೃದಯದಲ್ಲಿ ಹೀಗೆ ಎಂದುಕೊಂಡಿಯಲ್ಲಾ,</para>
  <para style="q2" vid="ISA 14:13">“ನಾನು ಆಕಾಶಕ್ಕೆ ಏರಿ,</para>
  <para style="q1" vid="ISA 14:13">ದೇವರ ನಕ್ಷತ್ರಗಳ ಮೇಲೆ</para>
  <para style="q2" vid="ISA 14:13">ನನ್ನ ಸಿಂಹಾಸನವನ್ನು ಘನತೆಗೇರಿಸುವೆನು.</para>
  <para style="q1" vid="ISA 14:13">ಉತ್ತರ ದಿಕ್ಕಿನ ಕಡೆಗಿರುವ ಜಫೋನ್ ಪರ್ವತದ ಮೇಲೆಯೂ</para>
  <para style="q2" vid="ISA 14:13">ನಾನು ಆಸೀನನಾಗುವೆನು.<verse eid="ISA 14:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="ISA 14:14"/>ಉನ್ನತವಾದ ಮೇಘ ಮಂಡಲದ ಮೇಲೆ ಏರಿ,</para>
  <para style="q2" vid="ISA 14:14">ಮಹೋನ್ನತರಿಗೆ ಸಮಾನನಾಗುವೆನು.”<verse eid="ISA 14:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="ISA 14:15"/>ಆದರೆ ಪಾತಾಳದ ಕುಣಿಯ ಕಡೆಗೂ,</para>
  <para style="q2" vid="ISA 14:15">ಸಮಾಧಿಗೂ ಇಳಿಯುವೆ.<verse eid="ISA 14:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="ISA 14:16"/>ನಿನ್ನನ್ನು ಕಂಡವರು ದಿಟ್ಟಿಸಿ ನೋಡಿ,</para>
  <para style="q2" vid="ISA 14:16">ನಿನ್ನ ಗತಿಯನ್ನು ಯೋಚಿಸುತ್ತಾ,</para>
  <para style="q1" vid="ISA 14:16">“ಭೂಮಿಯನ್ನು ನಡುಗಿಸಿ, ರಾಜ್ಯಗಳನ್ನು ಕದಲಿಸಿ,<verse eid="ISA 14:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="ISA 14:17"/>ಲೋಕವನ್ನು ಕಾಡನ್ನಾಗಿ ಮಾಡಿ,</para>
  <para style="q2" vid="ISA 14:17">ನಗರಗಳನ್ನು ಕೆಡವಿ,</para>
  <para style="q2" vid="ISA 14:17">ಸೆರೆಹಿಡಿದವರನ್ನು ಮನೆಗೆ ಬಿಡದೆ ಇದ್ದವನು</para>
  <para style="q2" vid="ISA 14:17">ಇವನೋ?” ಎಂದುಕೊಳ್ಳುವರು.<verse eid="ISA 14:17"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="18" style="v" sid="ISA 14:18"/>ಜನಾಂಗಗಳ ಅರಸರೆಲ್ಲಾ ವೈಭವದಿಂದ</para>
  <para style="q2" vid="ISA 14:18">ತಮ್ಮ ತಮ್ಮ ಸಮಾಧಿಗಳಲ್ಲಿ ಮಲಗುತ್ತಾರೆ.<verse eid="ISA 14:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="ISA 14:19"/>ಆದರೆ ನೀನು ತಿರಸ್ಕರಿಸಿದ ಕೊಂಬೆಯಂತೆಯೂ,</para>
  <para style="q2" vid="ISA 14:19">ಖಡ್ಗ ತಿವಿದು</para>
  <para style="q1" vid="ISA 14:19">ಕಲ್ಲುಗುಂಡಿಗೆ ಪಾಲಾದ</para>
  <para style="q2" vid="ISA 14:19">ಹೆಣಗಳ ಹೊದಿಕೆಯಂತೆಯೂ,</para>
  <para style="q2" vid="ISA 14:19">ಪರರ ತುಳಿತಕ್ಕೆ ಈಡಾಗಿ,</para>
  <para style="q1" vid="ISA 14:19">ಸಮಾಧಿಯೊಳಗಿಂದ ಹೊರಗೆ ಬಿಸಾಡಿರುವ ಶವದ ಹಾಗಿದ್ದೀ.<verse eid="ISA 14:19"/></para>
  <para style="q2">
    <verse number="20" style="v" sid="ISA 14:20"/>ನೀನು ಆ ರಾಜರಂತೆ ಸಮಾಧಿಗೆ ಸೇರದಿರುವಿ.</para>
  <para style="q1" vid="ISA 14:20">ಏಕೆಂದರೆ ನಿನ್ನ ದೇಶವನ್ನು ನೀನು ನಾಶಮಾಡಿ,</para>
  <para style="q2" vid="ISA 14:20">ನಿನ್ನ ಜನರನ್ನು ಕೊಂದುಹಾಕಿದಿ.</para>
  <para style="b" vid="ISA 14:20"/>
  <para style="b" vid="ISA 14:20"/>
  <para style="q1" vid="ISA 14:20">ದುಷ್ಟರ ಸಂತಾನವು</para>
  <para style="q2" vid="ISA 14:20">ನಿರಂತರವೂ ನಿರ್ನಾಮವಾಗಲಿ.<verse eid="ISA 14:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="ISA 14:21"/>ಅವರು ಏಳದೆ ಇಲ್ಲವೆ ದೇಶವನ್ನು ವಶಪಡಿಸಿಕೊಳ್ಳದೆ</para>
  <para style="q2" vid="ISA 14:21">ಇಲ್ಲವೆ ಲೋಕವನ್ನು ಪಟ್ಟಣಗಳಿಂದ ತುಂಬಿಸದಂತೆ,</para>
  <para style="q1" vid="ISA 14:21">ಅವರ ತಂದೆಗಳ ಅಪರಾಧದ ನಿಮಿತ್ತ,</para>
  <para style="q2" vid="ISA 14:21">ಅವನ ಮಕ್ಕಳ ಕೊಲೆಗೆ ಸಿದ್ಧಮಾಡಿರಿ.<verse eid="ISA 14:21"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="22" style="v" sid="ISA 14:22"/>“ಅವರಿಗೆ ವಿರುದ್ಧವಾಗಿ ಏಳುತ್ತೇನೆ,”</para>
  <para style="q2" vid="ISA 14:22">ಎಂದು ಸೇನಾಧೀಶ್ವರ ಯೆಹೋವ ದೇವರು ಹೇಳುತ್ತಾರೆ.</para>
  <para style="q1" vid="ISA 14:22">“ಬಾಬಿಲೋನಿನಿಂದ ಆಕೆಯ ಹೆಸರನ್ನೂ, ಉಳಿದ ಜನರನ್ನೂ,</para>
  <para style="q2" vid="ISA 14:22">ಆಕೆಯ ಮಕ್ಕಳನ್ನೂ ಅದರ ಸಂತತಿಯವರನ್ನೂ ನಿರ್ಮೂಲ ಮಾಡುವೆನು,”</para>
  <para style="q2" vid="ISA 14:22">ಎಂದು ಯೆಹೋವ ದೇವರು ಹೇಳುತ್ತಾರೆ.<verse eid="ISA 14:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="ISA 14:23"/>“ಅದನ್ನು ಮುಳ್ಳುಹಂದಿಗಳ ನಿವಾಸವಾಗಿಯೂ,</para>
  <para style="q2" vid="ISA 14:23">ಕೊಳಚೆ ಪ್ರದೇಶವನ್ನಾಗಿಯೂ ಪರಿವರ್ತಿಸುವೆನು.</para>
  <para style="q1" vid="ISA 14:23">ನಾಶನದ ಕಸಬರಿಗೆಯಿಂದ ಅದನ್ನು ಗುಡಿಸುವೆನು,”</para>
  <para style="q2" vid="ISA 14:23">ಎಂದು ಸೇನಾಧೀಶ್ವರ ಯೆಹೋವ ದೇವರು ಹೇಳುತ್ತಾರೆ.<verse eid="ISA 14:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="ISA 14:24"/>ಸೇನಾಧೀಶ್ವರ ಯೆಹೋವ ದೇವರು ಆಣೆ ಇಟ್ಟು ಹೇಳುವುದೇನೆಂದರೆ,</para>
  <para style="q1" vid="ISA 14:24">“ನಾನು ಯೋಚಿಸಿದ ರೀತಿಯಲ್ಲಿ ಖಂಡಿತವಾಗಿ ಆಗುವುದು.</para>
  <para style="q2" vid="ISA 14:24">ನಾನು ಉದ್ದೇಶಿಸಿದ ರೀತಿಯಲ್ಲಿಯೇ ನೆರವೇರುವುದು.<verse eid="ISA 14:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="ISA 14:25"/>ಅಸ್ಸೀರಿಯವನ್ನು ನನ್ನ ದೇಶದಲ್ಲಿ ಮುರಿದುಬಿಡುವೆನು.</para>
  <para style="q2" vid="ISA 14:25">ನನ್ನ ಪರ್ವತಗಳ ಮೇಲೆ ಅವರನ್ನು ತುಳಿದುಬಿಡುವೆನು.</para>
  <para style="q1" vid="ISA 14:25">ಅವನ ನೊಗವು ನನ್ನ ಜನರ ಮೇಲಿಂದ ತೊಲಗಿ,</para>
  <para style="q2" vid="ISA 14:25">ಅವರ ಭಾರವು ಅವರ ಭುಜಗಳ ಮೇಲಿನಿಂದ ತೊಲಗುವುದು.”<verse eid="ISA 14:25"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="26" style="v" sid="ISA 14:26"/>ಇದೇ ಸಮಸ್ತ ಭೂಮಿಯ ವಿಷಯ ಆಲೋಚಿಸಿದ ಉದ್ದೇಶ.</para>
  <para style="q2" vid="ISA 14:26">ಇದೇ ಜನಾಂಗಗಳ ಮೇಲೆಲ್ಲಾ ಚಾಚಿದ ನನ್ನ ಕೈ.<verse eid="ISA 14:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="ISA 14:27"/>ಏಕೆಂದರೆ ಸೇನಾಧೀಶ್ವರ ಯೆಹೋವ ದೇವರು ಉದ್ದೇಶಿಸಿದ್ದಾರೆ.</para>
  <para style="q2" vid="ISA 14:27">ಅದನ್ನು ಯಾರು ವ್ಯರ್ಥಪಡಿಸುವರು?</para>
  <para style="q2" vid="ISA 14:27">ಅವರು ಎತ್ತಿದ ಕೈಯನ್ನು, ಹಿಂದಕ್ಕೆ ತಳ್ಳುವವರು ಯಾರು? ಎಂಬುದೇ.<verse eid="ISA 14:27"/></para>
  <para style="s1">ಫಿಲಿಷ್ಟಿಯರಿಗೆ ವಿರೋಧವಾದ ಪ್ರವಾದನೆ</para>
  <para style="p">
    <verse number="28" style="v" sid="ISA 14:28"/>ಅರಸನಾದ ಆಹಾಜನು ಸತ್ತ ವರುಷದಲ್ಲಿ ಈ ದೈವೋಕ್ತಿ ಬಂದಿತು:<verse eid="ISA 14:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="ISA 14:29"/>ಸಮಸ್ತ ಫಿಲಿಷ್ಟಿಯರೇ,</para>
  <para style="q2" vid="ISA 14:29">ನಿಮ್ಮನ್ನು ಹೊಡೆದ ಕೋಲು ಮುರಿದು ಹೋಯಿತೆಂದು ನೀವು ಉಲ್ಲಾಸಿಸಬೇಡಿರಿ.</para>
  <para style="q1" vid="ISA 14:29">ಏಕೆಂದರೆ ಹಾವಿನ ಸಂತಾನದಿಂದ ವಿಷಸರ್ಪವು ಉಂಟಾಗುವುದು.</para>
  <para style="q2" vid="ISA 14:29">ಅದರ ಫಲವು ಹಾರುವ ವಿಷಸರ್ಪವೇ.<verse eid="ISA 14:29"/></para>
  <para style="q1">
    <verse number="30" style="v" sid="ISA 14:30"/>ಬಡವರಲ್ಲಿ ಬಡವರಾದವರು ಆಹಾರ ಕಂಡುಕೊಳ್ಳುವರು.</para>
  <para style="q2" vid="ISA 14:30">ಕೊರತೆಯಲ್ಲಿರುವವರು ಸುರಕ್ಷಿತವಾಗಿ ನಿದ್ರಿಸುವರು.</para>
  <para style="q1" vid="ISA 14:30">ಆದರೆ ನಿನ್ನ ಸಂತಾನದವರೋ ಕ್ಷಾಮದಿಂದ ಹತರಾಗುವರು.</para>
  <para style="q2" vid="ISA 14:30">ನಿನ್ನಲ್ಲಿ ಉಳಿದವರನ್ನು ಅದು ಹತಮಾಡುವುದು.<verse eid="ISA 14:30"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="31" style="v" sid="ISA 14:31"/>ದ್ವಾರವೇ, ಗೋಳಾಡು! ಪಟ್ಟಣವೇ, ಕೂಗು!</para>
  <para style="q2" vid="ISA 14:31">ಫಿಲಿಷ್ಟಿಯರೇ ಕರಗಿ ಹೋಗಿರಿ.</para>
  <para style="q1" vid="ISA 14:31">ಹೊಗೆಯು ಉತ್ತರದಿಂದ ಬರುತ್ತದೆ.</para>
  <para style="q2" vid="ISA 14:31">ಅದರಲ್ಲಿ ಅತ್ತಿತ್ತ ನಡೆಯುವವರು ಯಾರೂ ಇಲ್ಲ.<verse eid="ISA 14:31"/></para>
  <para style="q1">
    <verse number="32" style="v" sid="ISA 14:32"/>ಜನಾಂಗಗಳ ದೂತರಿಗೆ</para>
  <para style="q2" vid="ISA 14:32">ಯಾವ ಉತ್ತರವನ್ನು ಕೊಡಬೇಕು?</para>
  <para style="q1" vid="ISA 14:32">“ಯೆಹೋವ ದೇವರು ಚೀಯೋನನ್ನು ಸ್ಥಾಪಿಸಿದ್ದಾರೆ.</para>
  <para style="q2" vid="ISA 14:32">ಬಾಧೆಪಟ್ಟ ಅವರ ಜನರು</para>
  <para style="q2" vid="ISA 14:32">ಅದನ್ನು ಆಶ್ರಯಿಸಿಕೊಳ್ಳುವರು.”<verse eid="ISA 14:32"/></para>
  <chapter eid="ISA 14"/>
  <chapter number="15" style="c" sid="ISA 15"/>
  <para style="s1">ಮೋವಾಬಿಗೆ ವಿರುದ್ಧವಾದ ಪ್ರವಾದನೆ</para>
  <para style="p">
    <verse number="1" style="v" sid="ISA 15:1"/>ಮೋವಾಬಿನ ವಿಷಯವಾದ ಪ್ರವಾದನೆ:</para>
  <para style="q1" vid="ISA 15:1">ಆ ರಾತ್ರಿಯಲ್ಲಿ ಮೋವಾಬಿನ</para>
  <para style="q2" vid="ISA 15:1">ಆರ್ ಪಟ್ಟಣವು ಹಾಳಾಗಿ ನಿಶ್ಶಬ್ದವಾಯಿತು.</para>
  <para style="q1" vid="ISA 15:1">ಹೌದು, ಆ ರಾತ್ರಿಯಲ್ಲಿ ಮೋವಾಬಿನ ಕೀರ್ ಪಟ್ಟಣವು</para>
  <para style="q2" vid="ISA 15:1">ಹಾಳಾಗಿ ನಿಶ್ಶಬ್ದವಾಯಿತು.<verse eid="ISA 15:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 15:2"/>ದೀಬೋನ್ ಊರಿನವರು ಅಳುವುದಕ್ಕಾಗಿ ಎತ್ತರವಾದ ಪೂಜಾಸ್ಥಳಕ್ಕೆ ಹೋಗಿದ್ದಾರೆ;</para>
  <para style="q2" vid="ISA 15:2">ನೆಬೋ ಹಾಗೂ ಮೇದೆಬ ಪಟ್ಟಣದವರಿಗಾಗಿ ಮೋವಾಬ್ಯರು ಗೋಳಾಡುತ್ತಾರೆ.</para>
  <para style="q1" vid="ISA 15:2">ಪ್ರತಿಯೊಬ್ಬರ ತಲೆಯು ಬೋಳು,</para>
  <para style="q2" vid="ISA 15:2">ಪ್ರತಿಯೊಬ್ಬರ ಗಡ್ಡವೂ ವಿಕಾರವಾಗಿ ಕತ್ತರಿಸಿದೆ.<verse eid="ISA 15:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 15:3"/>ಅವರು ತಮ್ಮ ಬೀದಿಗಳಲ್ಲಿ ಗೋಣಿತಟ್ಟನ್ನು ತಾವೇ ಸುತ್ತಿಕೊಳ್ಳುವರು.</para>
  <para style="q2" vid="ISA 15:3">ಪ್ರತಿಯೊಬ್ಬನು ತನ್ನ ಮನೆಯ ಮೇಲೆಯೂ,</para>
  <para style="q1" vid="ISA 15:3">ಬೀದಿಗಳಲ್ಲಿಯೂ ಅರಚುತ್ತಾ</para>
  <para style="q2" vid="ISA 15:3">ಬಹುಶೋಕದಿಂದ ಗೋಳಾಡುವನು.<verse eid="ISA 15:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 15:4"/>ಹೆಷ್ಬೋನ್ ಮತ್ತು ಎಲೆಯಾಲೆ ಕೂಗುತ್ತವೆ,</para>
  <para style="q2" vid="ISA 15:4">ಅವರ ಸ್ವರವು ಯಹಚ ಊರಿನವರೆಗೂ ಕೇಳಿಸುತ್ತದೆ.</para>
  <para style="q1" vid="ISA 15:4">ಆದಕಾರಣ ಮೋವಾಬಿನ ಯುದ್ಧಭಟರು ಕಿರಿಚಿಕೊಳ್ಳುವರು.</para>
  <para style="q2" vid="ISA 15:4">ಅವರ ಹೃದಯಗಳು ತತ್ತರಿಸುತ್ತವೆ.<verse eid="ISA 15:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 15:5"/>ನನ್ನ ಹೃದಯವು ಮೋವಾಬಿನ ನಿಮಿತ್ತ ಕೂಗುತ್ತದೆ.</para>
  <para style="q2" vid="ISA 15:5">ಅಲ್ಲಿಂದ ಪಲಾಯನವಾದವರು ಚೋಗರ್ ಕಡೆಗೂ</para>
  <para style="q2" vid="ISA 15:5">ಎಗ್ಲತ್ ಶೆಲಿಶೀಯ ಕಡೆಗೂ ಓಡಿಹೋಗುವರು.</para>
  <para style="q1" vid="ISA 15:5">ಲೂಹೀತ್ ದಿಣ್ಣೆಯನ್ನು</para>
  <para style="q2" vid="ISA 15:5">ಅಳುತ್ತಾ ಹತ್ತುವರು.</para>
  <para style="q1" vid="ISA 15:5">ಏಕೆಂದರೆ ಹೊರೊನಯಿಮ್ ಊರಿನ ದಾರಿಯಲ್ಲಿ ನಡೆಯುತ್ತಾ</para>
  <para style="q2" vid="ISA 15:5">ನಾಶವಾದೆವಲ್ಲಾ ಎಂದು ದನಿಗೈಯುವರು.<verse eid="ISA 15:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 15:6"/>ನಿಮ್ರೀಮ್ ಹೊಳೆಯು ಬತ್ತಿಹೋಯಿತು,</para>
  <para style="q2" vid="ISA 15:6">ಹಸಿಹುಲ್ಲು ಬಾಡಿತು,</para>
  <para style="q1" vid="ISA 15:6">ಮೇವು ತೀರಿತು</para>
  <para style="q2" vid="ISA 15:6">ಅಲ್ಲಿ ಹಸಿರಾದದ್ದು ಇಲ್ಲ.<verse eid="ISA 15:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 15:7"/>ಆದಕಾರಣ ತಾವು ಸಂಪಾದಿಸಿದ ಆಸ್ತಿಯನ್ನೂ,</para>
  <para style="q2" vid="ISA 15:7">ಕೂಡಿಸಿಟ್ಟ ಸೊತ್ತನ್ನೂ ನೀರವಂಜಿಯ ಹೊಳೆಯ ಆಚೆಗೆ ಹೊತ್ತುಕೊಂಡು ಹೋಗುತ್ತಾರೆ.<verse eid="ISA 15:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 15:8"/>ಅವರ ಕೂಗಾಟವು ಮೋವಾಬಿನ ಎಲೆಗಳ ತನಕ ಹಬ್ಬಿದೆ.</para>
  <para style="q2" vid="ISA 15:8">ಅದರ ಕಿರಿಚಾಟ ಎಗ್ಲಯಿಮ್ ಹಾಗೂ</para>
  <para style="q2" vid="ISA 15:8">ಬೆಯೆರ್ ಏಲೀಮ್ ಊರುಗಳ ತನಕ ವ್ಯಾಪಿಸಿದೆ.<verse eid="ISA 15:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 15:9"/>ದೀಮೋನ್ ನದಿಯ ನೀರೆಲ್ಲಾ ರಕ್ತವಾಯಿತು.</para>
  <para style="q2" vid="ISA 15:9">ದೀಮೋನಿನ ಮೇಲೆ ಹೆಚ್ಚಾದ ಹಾನಿಯನ್ನು ತರುವೆನು.</para>
  <para style="q1" vid="ISA 15:9">ಮೋವಾಬ್ಯರಲ್ಲಿ ತಪ್ಪಿಸಿಕೊಂಡವರ ಮೇಲೆಯೂ,</para>
  <para style="q2" vid="ISA 15:9">ದೇಶದಲ್ಲಿ ಉಳಿದವರ ಮೇಲೆಯೂ ಸಿಂಹವನ್ನು ಬರಮಾಡುವೆನು.<verse eid="ISA 15:9"/></para>
  <para style="b"/>
  <para style="b"/>
  <chapter eid="ISA 15"/>
  <chapter number="16" style="c" sid="ISA 16"/>
  <para style="q1">
    <verse number="1" style="v" sid="ISA 16:1"/>ದೇಶವನ್ನು ಆಳುವವನಿಗೆ ಕಪ್ಪವಾಗಿ ಕೊಡತಕ್ಕ ಕುರಿಮರಿಯನ್ನು</para>
  <para style="q2" vid="ISA 16:1">ಸೆಲ ಬಂಡೆಯಿಂದ ಮರುಭೂಮಿಯ ಕಡೆಗೆ,</para>
  <para style="q2" vid="ISA 16:1">ಚೀಯೋನ್ ಪುತ್ರಿಯರ ಪರ್ವತಕ್ಕೆ ಕಳುಹಿಸಿರಿ.<verse eid="ISA 16:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 16:2"/>ಗೂಡಿನಿಂದ ಹೊರಗೆ ಬಂದ</para>
  <para style="q2" vid="ISA 16:2">ಹಕ್ಕಿಗಳ ಮರಿಗಳಂತೆ ಅಲೆದಾಡುವ ಹಾಗೆ,</para>
  <para style="q1" vid="ISA 16:2">ಮೋವಾಬಿನ ಪುತ್ರಿಯರು</para>
  <para style="q2" vid="ISA 16:2">ಅರ್ನೋನ್ ನದಿಯ ಹಾಯ್ಗಡಗಳಲ್ಲಿ ಇರುವರು.<verse eid="ISA 16:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 16:3"/>ಆಲೋಚಿಸಿ, ತೀರ್ಮಾನಿಸಿರಿ.</para>
  <para style="q2" vid="ISA 16:3">ಮಟ್ಟ ಮಧ್ಯಾಹ್ನದಲ್ಲಿ</para>
  <para style="q1" vid="ISA 16:3">ನಿಮ್ಮ ನೆರಳನ್ನು ರಾತ್ರಿಯಂತೆ ಮಾಡಿರಿ.</para>
  <para style="q2" vid="ISA 16:3">ವಲಸಿಗರನ್ನು ಅಡಗಿಸಿರಿ.</para>
  <para style="q2" vid="ISA 16:3">ಅಲೆಯುವವರನ್ನು ಬಯಲಿಗೆ ತರಬೇಡ.<verse eid="ISA 16:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 16:4"/>ಮೋವಾಬ್ ದೇಶದಿಂದ ವಲಸೆಹೋದವರು ನಿಮ್ಮಲ್ಲಿ ವಾಸಿಸಲಿ.</para>
  <para style="q2" vid="ISA 16:4">ವಿನಾಶಕರಿಗೆ ವಶವಾಗದಂತೆ ಅವರಿಗೆ ಆಶ್ರಯ ನೀಡಿರಿ.</para>
  <para style="b" vid="ISA 16:4"/>
  <para style="q1" vid="ISA 16:4">ದಬ್ಬಾಳಿಕೆ ಮುಗಿಯುತ್ತಾ ಬಂತು.</para>
  <para style="q2" vid="ISA 16:4">ಸೂರೆಮಾಡುವುದು ನಿಲ್ಲುವುದು,</para>
  <para style="q2" vid="ISA 16:4">ಪೀಡಿಸುವವರು ದೇಶದಿಂದ ಅಳಿದುಹೋಗುವರು.<verse eid="ISA 16:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 16:5"/>ಪ್ರೀತಿಯಲ್ಲಿ ಸಿಂಹಾಸನವು ಸ್ಥಾಪಿತವಾಗುವುದು.</para>
  <para style="q2" vid="ISA 16:5">ನ್ಯಾಯತೀರಿಸುವವನೂ, ನ್ಯಾಯವನ್ನು ಹುಡುಕುವವನೂ,</para>
  <para style="q2" vid="ISA 16:5">ನೀತಿಗೋಸ್ಕರ ತ್ವರೆಪಡುವವನೂ,</para>
  <para style="q1" vid="ISA 16:5">ದಾವೀದನ ಗುಡಾರದಲ್ಲಿ</para>
  <para style="q2" vid="ISA 16:5">ಅದರ ಮೇಲೆ ನಂಬಿಗಸ್ತಿಕೆಯಲ್ಲಿ ಕೂತುಕೊಳ್ಳುವನು.<verse eid="ISA 16:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 16:6"/>ಮೋವಾಬಿನ ಗರ್ವವನ್ನು ನಾವು ಕೇಳಿದ್ದೇವೆ.</para>
  <para style="q2" vid="ISA 16:6">ಆಕೆಗೆ ಬಹಳ ಗರ್ವ. ಆಕೆಯ ಅಹಂಕಾರವು,</para>
  <para style="q1" vid="ISA 16:6">ಆಕೆಯ ಗರ್ವವು ಮತ್ತು ಆಕೆಗೆ ಕೋಪವು ಸಹ ಉಂಟು.</para>
  <para style="q2" vid="ISA 16:6">ಆದರೆ ಆಕೆಯ ಕೊಚ್ಚಿಕೊಳ್ಳುವಿಕೆ ಬರಿದಾದದ್ದು.<verse eid="ISA 16:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 16:7"/>ಆದ್ದರಿಂದ ಮೋವಾಬಿನ ನಿಮಿತ್ತ</para>
  <para style="q2" vid="ISA 16:7">ಮೋವಾಬ್ಯರು ಗೋಳಾಡುವರು, ಒಟ್ಟಾಗಿ ಗೋಳಾಡುವರು.</para>
  <para style="q1" vid="ISA 16:7">ಏಕೆಂದರೆ ಕೀರ್ ಹರೆಷೆಥಿನ ದ್ರಾಕ್ಷಿಯ ಕಡುಬುಗಳಿಗೋಸ್ಕರ ನೀವು ದುಃಖಿಸುವಿರಿ.</para>
  <para style="q2" vid="ISA 16:7">ನಿಜವಾಗಿಯೂ ಅವರು ನೊಂದು ಹೋಗಿದ್ದಾರೆ.<verse eid="ISA 16:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 16:8"/>ಹೆಷ್ಬೋನ್ ಊರಿನ ಹೊಲ ಮತ್ತು</para>
  <para style="q2" vid="ISA 16:8">ಸಿಬ್ಮ ಊರಿನ ದ್ರಾಕ್ಷಿ ಸಹ ನಿಸ್ಸಾರವಾಗಿವೆ.</para>
  <para style="q1" vid="ISA 16:8">ಇತರ ಜನರ ಪ್ರಭುಗಳು</para>
  <para style="q2" vid="ISA 16:8">ವಿಶಾಲವಾದ ದ್ರಾಕ್ಷಿಗಿಡಗಳನ್ನು ತುಳಿದು ಹಾಕಿದ್ದಾರೆ,</para>
  <para style="q1" vid="ISA 16:8">ಆ ದ್ರಾಕ್ಷಿಗಿಡಗಳು ಯಜ್ಜೇರ್ ಊರಿನವರೆಗೂ ವ್ಯಾಪಿಸಿ,</para>
  <para style="q2" vid="ISA 16:8">ಮರುಭೂಮಿಯಲ್ಲಿ ಹರಡಿತ್ತು.</para>
  <para style="q1" vid="ISA 16:8">ಅದರ ಕೊಂಬೆಗಳು ಹಬ್ಬಿ,</para>
  <para style="q2" vid="ISA 16:8">ಸಮುದ್ರದವರೆಗೆ ವಿಶಾಲವಾಗಿತ್ತು.<verse eid="ISA 16:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 16:9"/>ಆದಕಾರಣ ಸಿಬ್ಮದ ದ್ರಾಕ್ಷಾಲತೆಯ</para>
  <para style="q2" vid="ISA 16:9">ನಿಮಿತ್ತ ಯಜ್ಜೇರ್ ಪಟ್ಟಣದೊಂದಿಗೆ ಅಳುವೆನು.</para>
  <para style="q1" vid="ISA 16:9">ಓ ಹೆಷ್ಬೋನ್ ಮತ್ತು ಎಲೆಯಾಲೆ ಪಟ್ಟಣಗಳೇ,</para>
  <para style="q2" vid="ISA 16:9">ನಿಮ್ಮನ್ನು ನನ್ನ ಕಣ್ಣೀರಿನಿಂದ ತೋಯಿಸುವೆನು!</para>
  <para style="q1" vid="ISA 16:9">ಏಕೆಂದರೆ ಶತ್ರುಗಳು ಬಿದ್ದುಹೋದ ನಿಮ್ಮ ಬೇಸಿಗೆಯ ಫಲಗಳಿಗೂ,</para>
  <para style="q2" vid="ISA 16:9">ಬೆಳೆಗಳಿಗೂ ಆರ್ಭಟಿಸುತ್ತಾರೆ.<verse eid="ISA 16:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 16:10"/>ಸಮೃದ್ಧಿಯಾದ ಹೊಲಗಳಿಂದ ಸಂತೋಷವು ಮತ್ತು ಆನಂದವು ತೊಲಗಿವೆ.</para>
  <para style="q2" vid="ISA 16:10">ದ್ರಾಕ್ಷಿತೋಟಗಳಲ್ಲಿ ಕೀರ್ತನೆಗಳಾಗಲೀ, ಆರ್ಭಟವಾಗಲೀ ಇರುವದಿಲ್ಲ.</para>
  <para style="q1" vid="ISA 16:10">ದ್ರಾಕ್ಷಿ ತೊಟ್ಟಿಗಳಲ್ಲಿ ಇನ್ನು ದ್ರಾಕ್ಷಾರಸವನ್ನು ತುಳಿದು ತೆಗೆಯುವುದಿಲ್ಲ.</para>
  <para style="q2" vid="ISA 16:10">ಅವರ ಕೂಗಾಟವನ್ನು ನಿಲ್ಲಿಸಿಬಿಟ್ಟಿದ್ದೇನೆ.<verse eid="ISA 16:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 16:11"/>ಆದ್ದರಿಂದ ಮೋವಾಬಿನ ನಿಮಿತ್ತ ನನ್ನ ಹೃದಯವೂ,</para>
  <para style="q2" vid="ISA 16:11">ಕೀರ್ ಹೆರೆಸೆಥ್ ನಿಮಿತ್ತ ನನ್ನ ಅಂತರಂಗವೂ ಕಿನ್ನರಿಯಂತೆ ಮಿಡಿಯುತ್ತಾ ದುಃಖಿಸುತ್ತಿದೆ.<verse eid="ISA 16:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 16:12"/>ಹೀಗಿರುವಲ್ಲಿ ಮೋವಾಬು ಉನ್ನತ ಸ್ಥಳದಲ್ಲಿ</para>
  <para style="q2" vid="ISA 16:12">ಆಯಾಸಗೊಂಡಂತೆ ಕಾಣಿಸಿಕೊಂಡು,</para>
  <para style="q1" vid="ISA 16:12">ಅವಳ ದೇವಾಲಯಕ್ಕೆ ಪ್ರಾರ್ಥಿಸುವುದಕ್ಕೆ ಬಂದರೂ</para>
  <para style="q2" vid="ISA 16:12">ಅದಕ್ಕೆ ಸಫಲವಾಗದು.<verse eid="ISA 16:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="ISA 16:13"/>ಯೆಹೋವ ದೇವರು ಮೋವಾಬಿನ ವಿಷಯವಾಗಿ ಹಿಂದೆ ನುಡಿದ ಮಾತು ಇದೇ: <verse eid="ISA 16:13"/><verse number="14" style="v" sid="ISA 16:14"/>ಆದರೆ ಈಗ ಯೆಹೋವ ದೇವರು ಮಾತನಾಡಿ, “ಗುಲಾಮಗಿರಿಯ ಕಟ್ಟುನಿಟ್ಟಿನ ಲೆಕ್ಕಾಚಾರದಂತೆ, ಮೂರು ವರುಷದೊಳಗೆ ಮೋವಾಬಿನ ವೈಭವವು ಹೀನಾಯಕ್ಕೆ ಈಡಾಗುವುದು. ಅಲ್ಲಿನವರ ದೊಡ್ಡ ಜನಸಂಖ್ಯೆಯಲ್ಲಿ ಅಳಿದುಉಳಿಯುವವರು ಬಲಹೀನರಾದ ಕೆಲವು ಜನರಾಗಿರುವರು,” ಎಂದು ಹೇಳಿದ್ದಾರೆ.<verse eid="ISA 16:14"/></para>
  <chapter eid="ISA 16"/>
  <chapter number="17" style="c" sid="ISA 17"/>
  <para style="s1">ದಮಸ್ಕಕ್ಕೆ ವಿರೋಧವಾದ ಪ್ರವಾದನೆ</para>
  <para style="p">
    <verse number="1" style="v" sid="ISA 17:1"/>ದಮಸ್ಕದ ವಿಷಯವಾದ ಪ್ರವಾದನೆ:</para>
  <para style="q1" vid="ISA 17:1">ಇಗೋ, ದಮಸ್ಕವು ಇನ್ನು ಪಟ್ಟಣವಾಗಿರದೆ</para>
  <para style="q2" vid="ISA 17:1">ಅದು ಹಾಳು ದಿಬ್ಬವಾಗಿರುವುದು.<verse eid="ISA 17:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 17:2"/>ಅರೋಯೇರ್ ಪ್ರಾಂತದ ಪಟ್ಟಣಗಳು ನಿರ್ಜನವಾಗಿ,</para>
  <para style="q2" vid="ISA 17:2">ಅವು ಯಾರ ಹೆದರಿಕೆಯೂ ಇಲ್ಲದೆ</para>
  <para style="q2" vid="ISA 17:2">ಮಲಗುವ ಮಂದೆಗಳಿಗೆ ಸ್ಥಳವಾಗುವುವು.<verse eid="ISA 17:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 17:3"/>ಎಫ್ರಾಯೀಮಿನಿಂದ ಕೋಟೆಯೂ,</para>
  <para style="q2" vid="ISA 17:3">ದಮಸ್ಕದ ರಾಜ್ಯಾಧಿಕಾರವೂ,</para>
  <para style="q1" vid="ISA 17:3">ಅರಾಮ್ಯರಲ್ಲಿ ಉಳಿದವುಗಳೂ ಸಹ ಇಲ್ಲವಾಗಿ ಹೋಗುವುವು.</para>
  <para style="q2" vid="ISA 17:3">ಅವರು ಇಸ್ರಾಯೇಲಿನ ಮಕ್ಕಳ ವೈಭವದಂತೆ ಇರುವರು</para>
  <para style="q2" vid="ISA 17:3">ಎಂದು ಸೇನಾಧೀಶ್ವರ ಯೆಹೋವ ದೇವರು ಹೇಳುತ್ತಾರೆ.<verse eid="ISA 17:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 17:4"/>ಆ ದಿವಸದಲ್ಲಿ ಯಾಕೋಬ್ಯರ ವೈಭವ ತಗ್ಗುವುದು.</para>
  <para style="q2" vid="ISA 17:4">ಅವರ ಕೊಬ್ಬು ಕರಗುವುದು.<verse eid="ISA 17:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 17:5"/>ಕೊಯ್ಯುವವನು ಪೈರನ್ನು ಕೂಡಿಸಿ</para>
  <para style="q2" vid="ISA 17:5">ತೆನೆಗಳನ್ನು ತನ್ನ ಕೈಯಿಂದ ಕೊಯ್ಯುವಂತೆಯೂ,</para>
  <para style="q1" vid="ISA 17:5">ರೆಫಾಯಿಮಿನ ತಗ್ಗಿನಲ್ಲಿ ತೆನೆಗಳನ್ನು</para>
  <para style="q2" vid="ISA 17:5">ಕೂಡಿಸುವ ಹಾಗೆಯೂ ಇರುವುದು.<verse eid="ISA 17:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 17:6"/>ಆದರೂ ಎಣ್ಣೆಮರವನ್ನು ಅಲ್ಲಾಡಿಸಿದ</para>
  <para style="q2" vid="ISA 17:6">ಬಳಿಕ ಮೇಲಿನ ಕೊಂಬೆಯ ತುಟ್ಟತುದಿಯಲ್ಲಿ ಎರಡು ಮೂರು ಕಾಯಿಗಳಿರುವುವು.</para>
  <para style="q1" vid="ISA 17:6">ಅದರ ಫಲವತ್ತಾದ ಆ ಮರದ ರೆಂಬೆಗಳಲ್ಲಿ</para>
  <para style="q2" vid="ISA 17:6">ನಾಲ್ಕೈದು ಕಾಯಿಗಳು ಉಳಿದಿರುವುವು.</para>
  <para style="q2" vid="ISA 17:6">ಅದೇ ರೀತಿಯಾಗಿ, ಇಸ್ರಾಯೇಲರಲ್ಲಿ ಕೆಲವರು ಮಾತ್ರ ಉಳಿದಿರುವರು,</para>
  <para style="q2" vid="ISA 17:6">ಎಂದು ಇಸ್ರಾಯೇಲಿನ ಯೆಹೋವ ದೇವರು ಹೇಳುತ್ತಾರೆ.<verse eid="ISA 17:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 17:7"/>ಆ ದಿನದಲ್ಲಿ ಜನರು ತಮ್ಮನ್ನು ಉಂಟುಮಾಡಿದವರ ಮೇಲೆ ದೃಷ್ಟಿಯಿಡುವರು</para>
  <para style="q2" vid="ISA 17:7">ಮತ್ತು ಇಸ್ರಾಯೇಲಿನ ಪರಿಶುದ್ಧರ ಕಡೆಗೆ ತಿರುಗಿಕೊಳ್ಳುವರು.<verse eid="ISA 17:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 17:8"/>ಅವರು ತಮ್ಮ ಕೈಕೆಲಸವಾದ</para>
  <para style="q2" vid="ISA 17:8">ಬಲಿಪೀಠಗಳನ್ನು ದೃಷ್ಟಿಸುವರು.</para>
  <para style="q1" vid="ISA 17:8">ಬೆರಳುಗಳು ಮಾಡಿದ ಧೂಪಪೀಠಗಳನ್ನು,</para>
  <para style="q2" vid="ISA 17:8">ಅಶೇರ ಸ್ತಂಭಗಳನ್ನು ಗೌರವಿಸುವುದಿಲ್ಲ.<verse eid="ISA 17:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="ISA 17:9"/>ಆ ದಿನದಲ್ಲಿ ಅವರು ಇಸ್ರಾಯೇಲರ ನಿಮಿತ್ತವಾಗಿ ಬಲವಾದ ಪಟ್ಟಣಗಳು ದಟ್ಟಡವಿಯ ಹಾಗಿದ್ದು ಹಾಳುಬೀಳುವುದು. ಅಂತು ದೇಶವೆಲ್ಲಾ ಹಾಳಾಗಿರುವದು.<verse eid="ISA 17:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 17:10"/>ನೀನು ನಿನ್ನ ರಕ್ಷಣೆಯ ದೇವರನ್ನು ಮರೆತು,</para>
  <para style="q2" vid="ISA 17:10">ನಿನ್ನ ಬಂಡೆಯೂ, ಕೋಟೆಯೂ ಆಗಿರುವವರನ್ನು ಮರೆತು ಬಿಟ್ಟಿದ್ದೀ.</para>
  <para style="q1" vid="ISA 17:10">ನೀನು ರಮ್ಯವಾದ ಗಿಡಗಳನ್ನು</para>
  <para style="q2" vid="ISA 17:10">ಮತ್ತು ದೇಶಾಂತರದ ದ್ರಾಕ್ಷಿಯ ಸಸಿಗಳನ್ನು ಹಾಕಿದ್ದರೂ,<verse eid="ISA 17:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 17:11"/>ಬೆಳೆಸಲು ಸಸಿಯನ್ನು ಹಾಕಿದ ದಿನದಲ್ಲಿ ಬೇಲಿಹಾಕಿ</para>
  <para style="q2" vid="ISA 17:11">ಮತ್ತು ಹೊತ್ತಾರೆ ನೀನು ಬಿತ್ತಿದ್ದನ್ನು ಮೊಳೆಯುವಂತೆ ಮಾಡಿದರೂ,</para>
  <para style="q1" vid="ISA 17:11">ರೋಗದ ಹಾಗೂ ಗುಣಪಡಿಸಲಾರದ ಬೇನೆಯ ದಿನದಲ್ಲಿ</para>
  <para style="q2" vid="ISA 17:11">ನಿನ್ನ ಸುಗ್ಗಿ ಏನೂ ಇರುವುದಿಲ್ಲ.<verse eid="ISA 17:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 17:12"/>ಆಹಾ, ಸಮುದ್ರವು ಭೋರ್ಗರೆಯುವಂತೆ</para>
  <para style="q2" vid="ISA 17:12">ಭೋರ್ಗರೆಯುವ ಬಹು ಜನಾಂಗಗಳ ಗದ್ದಲ!</para>
  <para style="q1" vid="ISA 17:12">ಮಹಾ ಜಲಪ್ರವಾಹಗಳು ಘೋಷಿಸುವಂತೆ</para>
  <para style="q2" vid="ISA 17:12">ಘೋಷಿಸುವ ಜನಗಳ ಘೋಷ!<verse eid="ISA 17:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="ISA 17:13"/>ಪ್ರಚಂಡ ಜಲಪ್ರವಾಹಗಳು ಘೋಷಿಸುವಂತೆ ಜನಾಂಗಗಳು ಘೋಷಿಸುತ್ತವೆ.</para>
  <para style="q2" vid="ISA 17:13">ಆದರೆ ದೇವರು ಅವರನ್ನು ಗದರಿಸುತ್ತಲೇ,</para>
  <para style="q1" vid="ISA 17:13">ಅವರು ದೂರಹೋಗಿ ಬೆಟ್ಟಗಳಲ್ಲಿ ಗಾಳಿಗೆ ಸಿಕ್ಕಿದ ಹೊಟ್ಟಿನಂತೆಯೂ,</para>
  <para style="q2" vid="ISA 17:13">ಸುಂಟರಗಾಳಿಯಿಂದ ಸುತ್ತಿ ಆಡುವ ಧೂಳಿನಂತೆಯೂ ಓಡಿಹೋಗುವರು.<verse eid="ISA 17:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="ISA 17:14"/>ಸಾಯಂಕಾಲದಲ್ಲಿ ಭಯಭ್ರಾಂತಿ,</para>
  <para style="q2" vid="ISA 17:14">ಉದಯಕ್ಕೆ ಮುಂಚೆ ಅವು ಇಲ್ಲದಂತಾಗುವುದು.</para>
  <para style="q1" vid="ISA 17:14">ನಮ್ಮನ್ನು ಸೂರೆ ಮಾಡುವವರಿಗೆ ಇದೇ ಗತಿ.</para>
  <para style="q2" vid="ISA 17:14">ನಮ್ಮನ್ನು ಕೊಳ್ಳೆಹೊಡೆಯುವವರ ಪಾಡು ಇದೇ.<verse eid="ISA 17:14"/></para>
  <chapter eid="ISA 17"/>
  <chapter number="18" style="c" sid="ISA 18"/>
  <para style="s1">ಕೂಷಿಗೆ ವಿರೋಧವಾದ ಪ್ರವಾದನೆಗಳು</para>
  <para style="q1">
    <verse number="1" style="v" sid="ISA 18:1"/>ಕೂಷ್ ನದಿಯ ಆಚೆಯಲ್ಲಿರುವ ಸೀಮೆ,</para>
  <para style="q2" vid="ISA 18:1">ರೆಕ್ಕೆಗಳನ್ನು<note caller="+" style="f"><char style="fr" closed="false">18:1 </char><char style="fq" closed="false">ರೆಕ್ಕೆಗಳನ್ನು </char><char style="ft" closed="false">ಅಥವಾ </char><char style="fqa" closed="false">ಮಿಡತೆಯ ರೆಕ್ಕೆ</char></note> ಪಟಪಟನೆ ಬಡಿಯುವ ನಾಡಿಗೆ ಕಷ್ಟ!<verse eid="ISA 18:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 18:2"/>ಇದು ಆಪಿನ ದೋಣಿಗಳಲ್ಲಿ ಸಮುದ್ರ ಮಾರ್ಗದಿಂದ</para>
  <para style="q2" vid="ISA 18:2">ರಾಯಭಾರಿಗಳನ್ನು ನೀರಿನ ಮೇಲೆ ಕಳುಹಿಸುತ್ತದೆ.</para>
  <para style="b" vid="ISA 18:2"/>
  <para style="q1" vid="ISA 18:2">ಶೀಘ್ರವಾಗಿ ಬರುತ್ತಿರುವ ದೂತರೇ,</para>
  <para style="q1" vid="ISA 18:2">ಎತ್ತರವಾದವರೂ, ನುಣುಪಾದ ಚರ್ಮವುಳ್ಳ ಜನರ ಬಳಿಗೂ,</para>
  <para style="q2" vid="ISA 18:2">ಸರ್ವರಿಗೂ ಭಯಪ್ರಧರಾಗಿರುವ ಜನರ ಬಳಿಗೂ,</para>
  <para style="q1" vid="ISA 18:2">ವಿಚಿತ್ರ ಭಾಷೆಯಿರುವ ಹಾಗೂ ನದಿಗಳಿಂದ ವಿಂಗಡವಾಗಿರುವ</para>
  <para style="q2" vid="ISA 18:2">ಆಕ್ರಮಣಕಾರಿ ರಾಷ್ಟ್ರದವರ ಬಳಿಗೂ ಹೋಗಿರಿ.<verse eid="ISA 18:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 18:3"/>ಜಗದ ಸಕಲ ನಿವಾಸಿಗಳೇ!</para>
  <para style="q2" vid="ISA 18:3">ಭೂಮಿಯಲ್ಲಿ ವಾಸಿಸುವವರೇ!</para>
  <para style="q1" vid="ISA 18:3">ಬೆಟ್ಟಗಳ ಮೇಲೆ ಧ್ವಜವನ್ನು ಎತ್ತುವಾಗ</para>
  <para style="q2" vid="ISA 18:3">ಅದನ್ನು ನೀವು ನೋಡುವಿರಿ,</para>
  <para style="q2" vid="ISA 18:3">ತುತೂರಿಯನ್ನು ಊದುವಾಗ ಕೇಳಿಸಿಕೊಳ್ಳುವಿರಿ.<verse eid="ISA 18:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 18:4"/>ಯೆಹೋವ ದೇವರು ನನಗೆ ಹೀಗೆ ಹೇಳಿದರು,</para>
  <para style="q2" vid="ISA 18:4">“ನಾನು ನನ್ನ ವಿಶ್ರಾಂತಿಯನ್ನು ತೆಗೆದುಕೊಳ್ಳುವೆನು.</para>
  <para style="q2" vid="ISA 18:4">ಬಿಸಿಹಗಲಿನ ಸೂರ್ಯನಂತೆಯೂ</para>
  <para style="q1" vid="ISA 18:4">ಸುಗ್ಗಿಯಲ್ಲಿನ ಮಂಜಿನ ಮೋಡದಂತೆಯೂ</para>
  <para style="q2" vid="ISA 18:4">ನಾನು ನನ್ನ ನಿವಾಸಸ್ಥಾನದಲ್ಲಿ ಸುಮ್ಮನೆ ನೋಡುತ್ತಿರುವೆನು.”<verse eid="ISA 18:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 18:5"/>ಏಕೆಂದರೆ ಸುಗ್ಗಿಗೆ ಮುಂಚೆ ಮೊಗ್ಗು ಬಿಟ್ಟಾದ ಮೇಲೆ</para>
  <para style="q2" vid="ISA 18:5">ಹೂವಿನಲ್ಲಿ ದ್ರಾಕ್ಷಿ ಕಾಯಿಯಾಗುವಾಗ ಅವರು</para>
  <para style="q1" vid="ISA 18:5">ಕುಡುಗೋಲುಗಳಿಂದ ಬಳ್ಳಿಗಳನ್ನು ಕತ್ತರಿಸಿ,</para>
  <para style="q2" vid="ISA 18:5">ಚಿಗುರುಗಳನ್ನು ಕಡಿದುಹಾಕುವರು.<verse eid="ISA 18:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 18:6"/>ಅವುಗಳೆಲ್ಲ ಬೆಟ್ಟದ ಹದ್ದುಗಳಿಗೂ,</para>
  <para style="q2" vid="ISA 18:6">ಭೂಮಿಯ ಮೃಗಗಳಿಗೂ ಆಹಾರವಾಗುವುವು.</para>
  <para style="q1" vid="ISA 18:6">ಅದು ಪಕ್ಷಿಗಳಿಗೆ ಬೇಸಿಗೆ ಕಾಲದಲ್ಲಿಯೂ,</para>
  <para style="q2" vid="ISA 18:6">ಕಾಡುಮೃಗಗಳಿಗೆ ಚಳಿಗಾಲದಲ್ಲಿಯೂ ಆಹಾರವಾಗುವುದು.<verse eid="ISA 18:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="ISA 18:7"/>ಆಗ ಎತ್ತರವಾದ ಹಾಗೂ ನುಣುಪು ಚರ್ಮವುಳ್ಳ ಜನರಿಂದಲೂ,</para>
  <para style="q1" vid="ISA 18:7">ಸರ್ವರಿಗೂ ಭಯಪ್ರಧರಾದ ಜನರಿಂದಲೂ,</para>
  <para style="q2" vid="ISA 18:7">ವಿಚಿತ್ರ ಭಾಷೆಯಿಂದ ಹಾಗೂ ನದಿಗಳಿಂದ</para>
  <para style="q1" vid="ISA 18:7">ವಿಂಗಡವಾಗಿರುವ ಆಕ್ರಮಣಕಾರಿ ಜನರಿಂದಲೂ</para>
  <para style="q2" vid="ISA 18:7">ಸರ್ವಶಕ್ತರಾದ ಯೆಹೋವ ದೇವರಿಗೆ ಕಾಣಿಕೆಗಳು ತರಲಾಗುವುದು.</para>
  <para style="m" vid="ISA 18:7">ಹೌದು, ಸೇನಾಧೀಶ್ವರ ಯೆಹೋವ ದೇವರ ಹೆಸರುಳ್ಳ ಚೀಯೋನ್ ಪರ್ವತಕ್ಕೆ ಕಾಣಿಕೆಗಳು ತರಲಾಗುವುದು.<verse eid="ISA 18:7"/></para>
  <chapter eid="ISA 18"/>
  <chapter number="19" style="c" sid="ISA 19"/>
  <para style="s1">ಈಜಿಪ್ಟಿನ ವಿರೋಧವಾದ ಪ್ರವಾದನೆ</para>
  <para style="p">
    <verse number="1" style="v" sid="ISA 19:1"/>ಈಜಿಪ್ಟಿನವರ ವಿಷಯವಾದ ಪ್ರವಾದನೆ:</para>
  <para style="q1" vid="ISA 19:1">ಇಗೋ, ಯೆಹೋವ ದೇವರು ವೇಗವುಳ್ಳ ಮೇಘವನ್ನು</para>
  <para style="q2" vid="ISA 19:1">ಹತ್ತಿಕೊಂಡು ಈಜಿಪ್ಟಿಗೆ ಬರುತ್ತಾರೆ.</para>
  <para style="q1" vid="ISA 19:1">ಅವರು ಸಮ್ಮುಖರಾದಾಗ ಈಜಿಪ್ಟಿನ ವಿಗ್ರಹಗಳು ನಡುಗುವುವು.</para>
  <para style="q2" vid="ISA 19:1">ಈಜಿಪ್ಟಿನವರ ಹೃದಯಗಳು ಅದರ ಮಧ್ಯೆ ಭಯದಿಂದ ಕರಗುವುವು.<verse eid="ISA 19:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 19:2"/>ಇದಲ್ಲದೆ ನಾನು ಈಜಿಪ್ಟಿನವನಿಗೆ ವಿರೋಧವಾಗಿ ಈಜಿಪ್ಟಿನವನನ್ನು ಎಬ್ಬಿಸುವೆನು.</para>
  <para style="q2" vid="ISA 19:2">ಸಹೋದರನಿಗೆ ವಿರುದ್ಧವಾಗಿ ಸಹೋದರನೂ,</para>
  <para style="q2" vid="ISA 19:2">ನೆರೆಯವನಿಗೆ ವಿರುದ್ಧವಾಗಿ ನೆರೆಯವನೂ,</para>
  <para style="q2" vid="ISA 19:2">ಪಟ್ಟಣಕ್ಕೆ ವಿರೋಧವಾಗಿ ಪಟ್ಟಣವೂ,</para>
  <para style="q2" vid="ISA 19:2">ರಾಜ್ಯಕ್ಕೆ ವಿರೋಧವಾಗಿ ರಾಜ್ಯವೂ ಹೊರಾಡುವವು.<verse eid="ISA 19:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 19:3"/>ಈಜಿಪ್ಟಿನವರ ಮನಸ್ಸು ಭಯಗೊಳ್ಳುವುದು</para>
  <para style="q2" vid="ISA 19:3">ಅವರ ಆಲೋಚನೆಯನ್ನು ಭಂಗಪಡಿಸುವೆನು.</para>
  <para style="q1" vid="ISA 19:3">ಅಲ್ಲಿಯವರು ವಿಗ್ರಹಗಳನ್ನೂ, ಮಾಟಗಾರರನ್ನೂ,</para>
  <para style="q2" vid="ISA 19:3">ಯಕ್ಷಣಿಗಾರರನ್ನೂ, ಮಂತ್ರವಾದಿಗಳನ್ನೂ ಆಶ್ರಯಿಸುವರು.<verse eid="ISA 19:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 19:4"/>ಈಜಿಪ್ಟಿನವರನ್ನು ಕ್ರೂರನಾದ</para>
  <para style="q2" vid="ISA 19:4">ಒಡೆಯನ ಕೈಗೆ ಒಪ್ಪಿಸುವೆನು.</para>
  <para style="q1" vid="ISA 19:4">ಭಯಂಕರನಾದ ರಾಜನು ಅವರನ್ನಾಳುವನು,</para>
  <para style="q2" vid="ISA 19:4">ಎಂದು ಸೇನಾಧೀಶ್ವರ ಯೆಹೋವ ದೇವರು ಹೇಳುತ್ತಾರೆ.<verse eid="ISA 19:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 19:5"/>ನೈಲ್ ನದಿಯ ನೀರು ಬತ್ತಿಹೋಗುವುದು.</para>
  <para style="q2" vid="ISA 19:5">ನದಿ ತೀರವೂ ಇಂಗಿ ಒಣಗಿಹೋಗುವುದು.<verse eid="ISA 19:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 19:6"/>ಕಾಲುವೆಗಳು ನಾರುವುವು.</para>
  <para style="q2" vid="ISA 19:6">ಈಜಿಪ್ಟನ ಉಪನದಿಗಳು ದೂರಕ್ಕೆ ಇಳಿದು ನೀರಿಲ್ಲದೆ ಹೋಗುವುವು.</para>
  <para style="q1" vid="ISA 19:6">ಜಂಬು ಹುಲ್ಲು ಬಾಡುವುದು.<verse eid="ISA 19:6"/></para>
  <para style="q2">
    <verse number="7" style="v" sid="ISA 19:7"/>ನೈಲ್ ನದಿಯ ಹತ್ತಿರದ</para>
  <para style="q2" vid="ISA 19:7">ತೀರವು ಬರುಡಾಗುವುದು.</para>
  <para style="q1" vid="ISA 19:7">ನದಿಯ ಬಳಿಯಲ್ಲಿ ಬಿತ್ತಿದ ಬೀಜಗಳೆಲ್ಲವೂ</para>
  <para style="q2" vid="ISA 19:7">ಒಣಗಿ, ಗಾಳಿಗೆ ತೂರಿಹೋಗುವುವು.<verse eid="ISA 19:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 19:8"/>ಮೀನುಗಾರರು ಕೂಡ ದುಃಖಿಸುವರು</para>
  <para style="q2" vid="ISA 19:8">ಮತ್ತು ನೈಲ್ ನದಿಯಲ್ಲಿ ಗಾಳ ಹಾಕುವವರು ಪ್ರಲಾಪಿಸುವರು.</para>
  <para style="q1" vid="ISA 19:8">ನೀರಿನ ಮೇಲೆ ಬಲೆ ಬೀಸುವವರು</para>
  <para style="q2" vid="ISA 19:8">ಕುಗ್ಗಿ ಹೋಗುವರು.<verse eid="ISA 19:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 19:9"/>ನಯವಾದ ನಾರಿನ ಕೆಲಸದವರು</para>
  <para style="q2" vid="ISA 19:9">ಬಟ್ಟೆ ನೇಯುವವರು ನಿರಾಶರಾಗಿರುವರು.<verse eid="ISA 19:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 19:10"/>ಬಟ್ಟೆಯಲ್ಲಿ ಕೆಲಸ ಮಾಡುವವರು ಖಿನ್ನರಾಗುತ್ತಾರೆ,</para>
  <para style="q2" vid="ISA 19:10">ಮತ್ತು ಎಲ್ಲಾ ವೇತನದಾರರು ಹೃದಯದಲ್ಲಿ ಅನಾರೋಗ್ಯಕ್ಕೆ ಒಳಗಾಗುತ್ತಾರೆ.<verse eid="ISA 19:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 19:11"/>ಚೋವನ್ ಪಟ್ಟಣದ ಅಧಿಪತಿಗಳು ಕೇವಲ ಬುದ್ಧಿಹೀನರು;</para>
  <para style="q2" vid="ISA 19:11">ಫರೋಹನ ಮಂತ್ರಿಗಳಲ್ಲಿ ಜ್ಞಾನವುಳ್ಳ ಸಲಹೆಗಾರರ ಆಲೋಚನೆಯೂ ಜ್ಞಾನರಹಿತವಾಗಿದೆ.</para>
  <para style="q1" vid="ISA 19:11">ನೀವು ಫರೋಹನನಿಗೆ, “ನಾನು ಜ್ಞಾನಿಗಳ ಸಂತಾನದವನು,</para>
  <para style="q2" vid="ISA 19:11">ಪುರಾತನ ರಾಜನ ಶಿಷ್ಯನೆಂದು ಹೇಳುವುದು ಹೇಗೆ”?<verse eid="ISA 19:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 19:12"/>ನಿನ್ನ ಜ್ಞಾನಿಗಳು ಎಲ್ಲಿ?</para>
  <para style="q2" vid="ISA 19:12">ನಿನಗೆ ಅವರು ಹೇಳಲಿ.</para>
  <para style="q1" vid="ISA 19:12">ಸೇನಾಧೀಶ್ವರ ಯೆಹೋವ ದೇವರು ಈಜಿಪ್ಟಿನವರ ವಿರೋಧವಾಗಿ</para>
  <para style="q2" vid="ISA 19:12">ಉದ್ದೇಶಿಸಿದ್ದನ್ನು ಅವರು ತಿಳಿದುಕೊಳ್ಳಲಿ.<verse eid="ISA 19:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="ISA 19:13"/>ಚೋವನಿನ ಶ್ರೇಷ್ಠರು ಮೂರ್ಖರಾಗಿದ್ದಾರೆ.</para>
  <para style="q2" vid="ISA 19:13">ನೋಫಿನ<note caller="+" style="f"><char style="fr" closed="false">19:13 </char><char style="fq" closed="false">ನೋಫ </char><char style="ft" closed="false">ಅಥವಾ </char><char style="fqa" closed="false">ಮೆಂಫೀಸ್</char></note> ಶ್ರೇಷ್ಠರು ಮೋಸ ಹೋಗಿದ್ದಾರೆ.</para>
  <para style="q1" vid="ISA 19:13">ಈಜಿಪ್ಟಿನ ಗೋತ್ರಗಳ ಪ್ರಮುಖರು ಅದನ್ನು ಭ್ರಮೆಗೊಳಿಸಿದ್ದಾರೆ.</para>
  <para style="q2" vid="ISA 19:13">ಅದನ್ನು ತಪ್ಪು ದಾರಿಗೆಳೆದಿದ್ದಾರೆ.<verse eid="ISA 19:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="ISA 19:14"/>ಯೆಹೋವ ದೇವರು ಅವರ ಮಧ್ಯದಲ್ಲಿ</para>
  <para style="q2" vid="ISA 19:14">ತತ್ತರಿಸುವ ಆತ್ಮವನ್ನು ಸುರಿಸಿದ್ದಾರೆ.</para>
  <para style="q1" vid="ISA 19:14">ಅಮಲೇರಿದವನು ಕಕ್ಕುತ್ತಾ ಓಲಾಡುವ ಪ್ರಕಾರ</para>
  <para style="q2" vid="ISA 19:14">ಈಜಿಪ್ಟ್ ತನ್ನ ಒಂದೊಂದು ಕೆಲಸದಲ್ಲಿಯೂ ಓಲಾಡುವಂತೆ ಮಾಡಿದ್ದಾರೆ.<verse eid="ISA 19:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="ISA 19:15"/>ಈಜಿಪ್ಟಿನಲ್ಲಿ ತಲೆಯಾಗಲಿ, ಬಾಲವಾಗಲಿ, ಕೊಂಬೆಯಾಗಲಿ,</para>
  <para style="q2" vid="ISA 19:15">ಒಂದು ಕಡ್ಡಿಯಾಗಲಿ ಸಾಧಿಸಲು ಸಾಧ್ಯವಾಗದ ಯಾವ ಕೆಲಸವೂ ಇರುವುದಿಲ್ಲ.<verse eid="ISA 19:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="ISA 19:16"/>ಆ ದಿನದಲ್ಲಿ ಈಜಿಪ್ಟಿನವರು ಹೆಂಗಸರ ಹಾಗೆ ಇರುವರು. ಸೇನಾಧೀಶ್ವರ ಯೆಹೋವ ದೇವರು ಅದರ ಮೇಲೆ ಎತ್ತಿದ ಕೈಯನ್ನು ಬೀಸುತ್ತಿರುವುದರಿಂದ ಅವರು ಹೆದರಿ ಭಯಪಡುವರು. <verse eid="ISA 19:16"/><verse number="17" style="v" sid="ISA 19:17"/>ಈಜಿಪ್ಟ್ ಬೆಚ್ಚಿ ಬೀಳುವುದಕ್ಕೆ ಯೆಹೂದ ದೇಶವು ಕಾರಣವಾಗುವುದು, ಈ ದೇಶದ ಹೆಸರನ್ನು ಕೇಳುವ ಪ್ರತಿಯೊಬ್ಬನು ಸೇನಾಧೀಶ್ವರ ಯೆಹೋವ ದೇವರು ಈಜಿಪ್ಟಿಗೆ ಪ್ರತಿಕೂಲವಾಗಿ ಮಾಡಿಕೊಂಡಿರುವ ಆಲೋಚನೆಯನ್ನು ತಿಳಿದು ಬೆರಗಾಗುವನು.<verse eid="ISA 19:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="ISA 19:18"/>ಆ ದಿವಸದಲ್ಲಿ ಈಜಿಪ್ಟಿನ ಐದು ಪಟ್ಟಣಗಳು ಸೇನಾಧೀಶ್ವರ ಯೆಹೋವ ದೇವರಿಗೆ ಆಣೆಯಿಟ್ಟುಕೊಳ್ಳುವವು. ಕಾನಾನಿನ ಭಾಷೆಯನ್ನಾಡುವವರಿಂದ ತುಂಬಿದ ಐದು ಪಟ್ಟಣಗಳು ಈಜಿಪ್ಟ್ ದೇಶದಲ್ಲಿರುವುವು. ಅವುಗಳಲ್ಲಿ ಒಂದರ ಹೆಸರು “ನಾಶಪುರ<note caller="+" style="f"><char style="fr" closed="false">19:18 </char><char style="fq" closed="false">ನಾಶಪುರ </char><char style="ft" closed="false">ಕೆಲವು ಹಸ್ತಪ್ರತಿಗಳಲ್ಲಿ </char><char style="fqa" closed="false">ರವಿಪುರ</char></note>.”<verse eid="ISA 19:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="ISA 19:19"/>ಆ ದಿನದಲ್ಲಿ ಈಜಿಪ್ಟ್ ದೇಶದ ಮಧ್ಯದಲ್ಲಿ ಯೆಹೋವ ದೇವರಿಗೆ ಬಲಿಪೀಠವು ದೇಶದ ಎಲ್ಲೆಯಲ್ಲಿ ಯೆಹೋವ ದೇವರಿಗೆ ಒಂದು ಸ್ತಂಭವು ಇರುವುದು. <verse eid="ISA 19:19"/><verse number="20" style="v" sid="ISA 19:20"/>ಅದು ಸೇನಾಧೀಶ್ವರ ಯೆಹೋವ ದೇವರಿಗೆ ಈಜಿಪ್ಟ್ ದೇಶದಲ್ಲಿ ಗುರುತಾಗಿ ಸಾಕ್ಷಿಯಾಗಿರುವುದು. ಏಕೆಂದರೆ ಹಿಂಸಕರ ದೆಸೆಯಿಂದ ಯೆಹೋವ ದೇವರನ್ನು ಕೂಗಿಕೊಳ್ಳಲು, ದೇವರು ಅವರಿಗೆ ಒಬ್ಬ ಶೂರನಾದ ರಕ್ಷಕನನ್ನು ಕಳುಹಿಸಿ, ಅವರನ್ನು ಬಿಡುಗಡೆ ಮಾಡುವರು. <verse eid="ISA 19:20"/><verse number="21" style="v" sid="ISA 19:21"/>ಯೆಹೋವ ದೇವರು ತಮ್ಮನ್ನು ಈಜಿಪ್ಟಿನವರಿಗೆ ತಿಳಿಯಪಡಿಸಲು, ಅವರು ಆ ದಿನದಲ್ಲಿ ಯೆಹೋವ ದೇವರನ್ನು ತಿಳಿದುಕೊಳ್ಳುವರು ಮತ್ತು ಬಲಿಕಾಣಿಕೆಗಳಿಂದ ಸೇವೆಮಾಡುವರು. ಹೌದು, ಅವರು ಯೆಹೋವ ದೇವರಿಗೆ ಪ್ರಮಾಣ ಮಾಡಿಕೊಂಡು ನೆರವೇರಿಸುವರು. <verse eid="ISA 19:21"/><verse number="22" style="v" sid="ISA 19:22"/>ಇದಲ್ಲದೆ ಯೆಹೋವ ದೇವರು ಈಜಿಪ್ಟಿನವರನ್ನು ಹೊಡೆಯುವರು; ಗಾಯಮಾಡಿ ಸ್ವಸ್ಥ ಮಾಡುವರು. ಅವರು ಯೆಹೋವ ದೇವರ ಕಡೆಗೆ ತಿರುಗಿಕೊಳ್ಳುವರು, ದೇವರು ಅವರನ್ನು ಆಲೈಸಿ ಸ್ವಸ್ಥ ಮಾಡುವರು.<verse eid="ISA 19:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="ISA 19:23"/>ಆ ದಿವಸದಲ್ಲಿ ಈಜಿಪ್ಟಿನಿಂದ ಅಸ್ಸೀರಿಯಕ್ಕೆ ಹೋಗುವ ಒಂದು ರಾಜ ಮಾರ್ಗವಿರುವುದು. ಅಸ್ಸೀರಿಯದವರು ಈಜಿಪ್ಟಿಗೂ, ಈಜಿಪ್ಟಿನವರು ಅಸ್ಸೀರಿಯಕ್ಕೂ ಹೋಗಿ ಬರುವರು. ಈಜಿಪ್ಟಿನವರು, ಅಸ್ಸೀರಿಯರೊಂದಿಗೆ ಯೆಹೋವ ದೇವರನ್ನು ಆರಾಧಿಸುವರು. <verse eid="ISA 19:23"/><verse number="24" style="v" sid="ISA 19:24"/>ಆ ದಿನದಲ್ಲಿ ಇಸ್ರಾಯೇಲು ಈಜಿಪ್ಟಿನವರ ಮತ್ತು ಅಸ್ಸೀರಿಯದವರ ಸಂಗಡ ಮೂರನೆಯದಾಗಿ ದೇಶದ ಮಧ್ಯದಲ್ಲಿ ಆಶೀರ್ವಾದವಾಗಿರುವುದು. <verse eid="ISA 19:24"/><verse number="25" style="v" sid="ISA 19:25"/>ನನ್ನ ಪ್ರಜೆಯಾದ ಈಜಿಪ್ಟಿಗೂ, ನನ್ನ ಕೈಕೆಲಸವಾದ ಅಸ್ಸೀರಿಯಕ್ಕೂ ಮತ್ತು ನನ್ನ ಸೊತ್ತಾದ ಇಸ್ರಾಯೇಲಿಗೂ, “ನಿಮಗೆ ಆಶೀರ್ವಾದ,” ಎಂದು ಸೇನಾಧೀಶ್ವರ ಯೆಹೋವ ದೇವರು ಅವುಗಳನ್ನು ಆಶೀರ್ವಾದ ಮಾಡುವರು.<verse eid="ISA 19:25"/></para>
  <chapter eid="ISA 19"/>
  <chapter number="20" style="c" sid="ISA 20"/>
  <para style="s1">ಈಜಿಪ್ಟ್ ಹಾಗೂ ಕೂಷಿನ ವಿರೋಧವಾದ ಪ್ರವಾದನೆ</para>
  <para style="p">
    <verse number="1" style="v" sid="ISA 20:1"/>ಅಸ್ಸೀರಿಯದ ಅರಸನಾದ ಸರ್ಗೋನನು ಕಳುಹಿಸಿದ ವರ್ಷದಲ್ಲಿ ಪ್ರಮುಖ ಸೇನಾಪತಿ, ಅಷ್ಡೋದಿಗೆ ಬಂದು ಅದನ್ನು ಮುತ್ತಿಗೆ ಹಾಕಿ ಆಕ್ರಮಿಸಿಕೊಂಡನು. <verse eid="ISA 20:1"/><verse number="2" style="v" sid="ISA 20:2"/>ಅದೇ ಸಮಯದಲ್ಲಿ ಯೆಹೋವ ದೇವರು ಆಮೋಚನ ಮಗ ಯೆಶಾಯನಿಗೆ, “ನಿನ್ನ ಸೊಂಟಕ್ಕೆ ಕಟ್ಟಿರುವ ಗೋಣಿತಟ್ಟನ್ನು ಬಿಚ್ಚು. ನಿನ್ನ ಪಾದಗಳಲ್ಲಿರುವ ಕೆರಗಳನ್ನು ತೆಗೆದಿಡು,” ಎಂದು ಹೇಳಿದರು. ಅವನು ಹಾಗೆ ಮಾಡಿ, ಬೆತ್ತಲೆಯಾಗಿ ಬರಿಗಾಲಿನಲ್ಲೇ ತಿರುಗಾಡುತ್ತಿದ್ದನು.<verse eid="ISA 20:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="ISA 20:3"/>ಆಗ ಯೆಹೋವ ದೇವರು, “ನನ್ನ ಸೇವಕನಾದ ಯೆಶಾಯನು ಈಜಿಪ್ಟ್ ಮತ್ತು ಕೂಷಿಗು, ಗುರುತಾಗಿಯೂ, ಆಶ್ಚರ್ಯವಾಗಿಯೂ ಹೀಗೆ ಮೂರು ವರ್ಷ ಬೆತ್ತಲೆಯಾಗಿ ಕೆರವಿಲ್ಲದೆ ನಡೆದನು. <verse eid="ISA 20:3"/><verse number="4" style="v" sid="ISA 20:4"/>ಹಾಗೆಯೇ ಅಸ್ಸೀರಿಯದ ಅರಸನು ಈಜಿಪ್ಟಿನವರನ್ನು ಬಂಧಿಸಿ, ಕೂಷಿನ ಕೈದಿಗಳನ್ನು ಅವರು ದೊಡ್ಡವರಾಗಲೀ, ಸಣ್ಣವರಾಗಲೀ ಬಟ್ಟೆ, ಕೆರಗಳಿಲ್ಲದೆ ಈಜಿಪ್ಟಿನ ಮಾನಭಂಗಕ್ಕೋಸ್ಕರ ಸೆರೆಗೆ ನಡೆಯುವಂತೆ ಮಾಡುವನು. <verse eid="ISA 20:4"/><verse number="5" style="v" sid="ISA 20:5"/>ಆಗ ನನ್ನ ಜನರು ಅವನು ನಿರೀಕ್ಷಿಸಿಕೊಂಡಿದ್ದ ಕೂಷಿನ ನಿಮಿತ್ತವಾಗಿಯೂ, ಕೊಚ್ಚಿಕೊಳ್ಳುತ್ತಿದ್ದ ಈಜಿಪ್ಟಿನ ವಿಷಯವಾಗಿಯೂ, ನಿರಾಶರಾಗಿ ನಾಚಿಕೆಪಡುವರು. <verse eid="ISA 20:5"/><verse number="6" style="v" sid="ISA 20:6"/>ಆ ದಿನದಲ್ಲಿ ಕರಾವಳಿಯ ನಿವಾಸಿಗಳು, ‘ಇಗೋ, ಅಸ್ಸೀರಿಯದ ಅರಸರಿಂದ ಬಿಡುಗಡೆಯಾಗಬೇಕೆಂದು ನಾವು ಯಾರನ್ನು ಶರಣಾಗತರಾಗಿ ಆಶ್ರಯಿಸಿ, ನಿರೀಕ್ಷಿಸಿದ್ದೆವೋ ಅವರಿಗೆ ಈ ಗತಿ ಬಂತಲ್ಲಾ ಮತ್ತು ನಾವು ತಪ್ಪಿಸಿಕೊಳ್ಳುವುದು ಹೇಗೆ?’ ಎಂದುಕೊಳ್ಳುವರು.”<verse eid="ISA 20:6"/></para>
  <chapter eid="ISA 20"/>
  <chapter number="21" style="c" sid="ISA 21"/>
  <para style="s1">ಬಾಬಿಲೋನಿನ ವಿರುದ್ಧವಾದ ಪ್ರವಾದನೆ</para>
  <para style="p">
    <verse number="1" style="v" sid="ISA 21:1"/>ಸಮುದ್ರತೀರದ ಮರುಭೂಮಿಯ ವಿಷಯವಾದ ಪ್ರವಾದನೆ:</para>
  <para style="q1" vid="ISA 21:1">ದಕ್ಷಿಣ ಸೀಮೆಯಲ್ಲಿ ಬೀಸುವ ಬಿರುಗಾಳಿ ದಾಟಿ ಹೋಗುವಂತೆ</para>
  <para style="q2" vid="ISA 21:1">ಆಕ್ರಮಣಕಾರರು ಮರುಭೂಮಿ ಕಡೆಯಿಂದ ಭಯಂಕರವಾದ</para>
  <para style="q2" vid="ISA 21:1">ದೇಶದಿಂದ ಬರುತ್ತಾರೆ.<verse eid="ISA 21:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 21:2"/>ಘೋರ ದರ್ಶನವು ನನಗೆ ತಿಳಿಯಬಂದಿದೆ:</para>
  <para style="q2" vid="ISA 21:2">ಬಾಧಕನು ಬಾಧಿಸುತ್ತಿದ್ದಾನೆ. ಸೂರೆಗಾರನು ಸೂರೆಮಾಡುತ್ತಿದ್ದಾನೆ.</para>
  <para style="q1" vid="ISA 21:2">ಏಲಾಮೇ, ಏಳು! ಮೇದ್ಯವೇ ಮುತ್ತಿಗೆ ಹಾಕು,</para>
  <para style="q2" vid="ISA 21:2">ಅದರ ನಿಟ್ಟುಸಿರನ್ನೆಲ್ಲಾ ನಿಲ್ಲಿಸಿಬಿಟ್ಟಿದ್ದೇನೆ.<verse eid="ISA 21:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 21:3"/>ಆದ್ದರಿಂದ ನನ್ನ ಸೊಂಟಗಳು ನೋವಿನಿಂದ ತುಂಬಿವೆ.</para>
  <para style="q2" vid="ISA 21:3">ಹೆರುವವಳ ವೇದನೆಗಳಂತಿರುವ ವೇದನೆಗಳು ನನ್ನನ್ನು ಹಿಡಿದಿವೆ.</para>
  <para style="q1" vid="ISA 21:3">ಕಿವಿ ಕಿವುಡಾಗುವಷ್ಟು ಸಂಕಟಪಡುತ್ತೇನೆ.</para>
  <para style="q2" vid="ISA 21:3">ಕಣ್ಣು ಕುರುಡಾಗುವಷ್ಟು ಭ್ರಾಂತನಾಗಿದ್ದೇನೆ.<verse eid="ISA 21:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 21:4"/>ನನ್ನ ಹೃದಯವು ಬಡಿದುಕೊಳ್ಳುತ್ತಿದೆ, ಗಾಬರಿಗೊಂಡಿದೆ.</para>
  <para style="q2" vid="ISA 21:4">ನಡುಗುವಿಕೆಯು ನನ್ನನ್ನು ಕಳವಳಗೊಳಿಸಿದೆ,</para>
  <para style="q1" vid="ISA 21:4">ನಾ ಬಯಸಿದ ಸಂಜೆಯೇ</para>
  <para style="q2" vid="ISA 21:4">ನನಗೆ ಭಯಭ್ರಾಂತಿಯಾಗಿ ಮಾಡಿದ್ದಾನೆ.<verse eid="ISA 21:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 21:5"/>ಔತಣ ಸಿದ್ಧವಾಗಿದೆ.</para>
  <para style="q2" vid="ISA 21:5">ಬುರುಜಿನ ಮೇಲೆ ಕಾವಲಿರು.</para>
  <para style="q2" vid="ISA 21:5">ಉಣ್ಣು, ಕುಡಿ, ಪ್ರಭುಗಳೇ,</para>
  <para style="q1" vid="ISA 21:5">ಏಳಿರಿ, ಗುರಾಣಿಗೆ ಎಣ್ಣೆಯನ್ನು ಹಚ್ಚಿರಿ.<verse eid="ISA 21:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="ISA 21:6"/>ಕರ್ತರು ನನಗೆ ಹೇಳಿದ್ದೇನೆಂದರೆ,</para>
  <para style="q1" vid="ISA 21:6">“ಹೋಗು, ಕಾವಲುಗಾರರನ್ನು ನೇಮಿಸು.</para>
  <para style="q2" vid="ISA 21:6">ಅವನು ಕಂಡದ್ದನ್ನು ತಿಳಿಸಲಿ.<verse eid="ISA 21:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 21:7"/>ಅವನು ಜೋಡಿ ಜೋಡಿಯಾಗಿ ಬರುವ</para>
  <para style="q2" vid="ISA 21:7">ರಥ ಸವಾರರ ಸಾಲನ್ನು</para>
  <para style="q1" vid="ISA 21:7">ಕತ್ತೆಗಳ, ಒಂಟೆಗಳ,</para>
  <para style="q2" vid="ISA 21:7">ರಥ ಸಾಲುಗಳನ್ನು ನೋಡಿದರೆ,</para>
  <para style="q1" vid="ISA 21:7">ಬಹು ಗಮನದಿಂದ</para>
  <para style="q2" vid="ISA 21:7">ಕಿವಿಗೊಟ್ಟು ಗಮನಿಸಲಿ.”<verse eid="ISA 21:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="ISA 21:8"/>ಬಳಿಕ ಅವನು ಸಿಂಹದಂತೆ ಕೂಗಿ ಹೀಗೆ ಹೇಳಿದನು,</para>
  <para style="q1" vid="ISA 21:8">“ನನ್ನ ಒಡೆಯನೇ, ನಾನು ಹಗಲೆಲ್ಲಾ ಕಾವಲಿನ ಬುರುಜಿನ ಮೇಲೆ ನಿಂತಿದ್ದೇನೆ.</para>
  <para style="q2" vid="ISA 21:8">ರಾತ್ರಿಯೆಲ್ಲಾ ಕಾವಲಿನ ಕೆಲಸ ನನಗೆ ಬಿದ್ದಿದೆ.<verse eid="ISA 21:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 21:9"/>ಇಗೋ, ಎರಡು ಕುದುರೆಗಳನ್ನು ಹೊಂದಿರುವ ರಥದಲ್ಲಿ</para>
  <para style="q2" vid="ISA 21:9">ಒಬ್ಬ ವ್ಯಕ್ತಿ ಸವಾರಿ ಮಾಡಿ ಬರುತ್ತಿದ್ದಾನೆ</para>
  <para style="q2" vid="ISA 21:9">ಬಾಬಿಲೋನ್ ಬಿದ್ದುಹೋಯಿತು, ಬಾಬಿಲೋನ್ ಬಿದ್ದುಹೋಯಿತು!</para>
  <para style="q1" vid="ISA 21:9">ಅದರ ಕೆತ್ತಿದ ದೇವತೆಗಳ ವಿಗ್ರಹಗಳೆಲ್ಲ</para>
  <para style="q2" vid="ISA 21:9">ಮುರಿದು ನೆಲಸಮವಾಗಿವೆ.”<verse eid="ISA 21:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 21:10"/>ಕಣದಲ್ಲಿ ತುಳಿತಕ್ಕೆ ಈಡಾದ ನನ್ನ ಜನರೇ</para>
  <para style="q2" vid="ISA 21:10">ಇಸ್ರಾಯೇಲಿನ ದೇವರಾಗಿರುವ</para>
  <para style="q1" vid="ISA 21:10">ಸೇನಾಧೀಶ್ವರ ಯೆಹೋವ ದೇವರಿಂದ ನಾನು ಕೇಳಿದ್ದನ್ನು</para>
  <para style="q2" vid="ISA 21:10">ನಿಮಗೆ ತಿಳಿಸಿದ್ದೇನೆ.<verse eid="ISA 21:10"/></para>
  <para style="s1">ಎದೋಮಿಗೆ ವಿರೋಧವಾದ ಪ್ರವಾದನೆ</para>
  <para style="p">
    <verse number="11" style="v" sid="ISA 21:11"/>ದೂಮ<note caller="+" style="f"><char style="fr" closed="false">21:11 </char><char style="fq" closed="false">ದೂಮ </char><char style="ft" closed="false">ಅಂದರೆ </char><char style="fqa" closed="false">ಮೌನ</char></note> ವಿಷಯವಾದ ಪ್ರವಾದನೆ:</para>
  <para style="q1" vid="ISA 21:11">ಸೇಯೀರಿನಿಂದ ನನ್ನನ್ನು ಯಾರೋ ಹೀಗೆ ಕರೆಯುತ್ತಿದ್ದಾರೆ,</para>
  <para style="q2" vid="ISA 21:11">“ಕಾವಲುಗಾರನೇ, ಈಗ ರಾತ್ರಿ ಎಷ್ಟು ಕಳೆಯಿತು?</para>
  <para style="q2" vid="ISA 21:11">ಕಾವಲುಗಾರನೇ, ರಾತ್ರಿ ಎಷ್ಟು ಕಳೆಯಿತು?”<verse eid="ISA 21:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 21:12"/>ಕಾವಲುಗಾರನು ಹೀಗೆ ಉತ್ತರಿಸಿದನು,</para>
  <para style="q2" vid="ISA 21:12">“ಉದಯವು ಬರುತ್ತದೆ, ರಾತ್ರಿಯೂ ಬರುತ್ತದೆ.</para>
  <para style="q1" vid="ISA 21:12">ವಿಚಾರಿಸಬೇಕಾದರೆ ವಿಚಾರಿಸಿರಿ,</para>
  <para style="q2" vid="ISA 21:12">ತಿರುಗಿ ಬನ್ನಿರಿ.”<verse eid="ISA 21:12"/></para>
  <para style="s1">ಅರೇಬಿಯದ ವಿರೋಧವಾದ ಪ್ರವಾದನೆ</para>
  <para style="p">
    <verse number="13" style="v" sid="ISA 21:13"/>ಅರೇಬಿಯದ ವಿಷಯವಾದ ಪ್ರವಾದನೆ:</para>
  <para style="q1" vid="ISA 21:13">ಓ ದೇದಾನ್ಯರ ವ್ಯಾಪಾರಿಗಳ ಗುಂಪಿನವರೇ</para>
  <para style="q2" vid="ISA 21:13">ಅರೇಬಿಯದ ಕಾಡಿನಲ್ಲಿ ಇಳಿದುಕೊಳ್ಳಿರಿ.<verse eid="ISA 21:13"/></para>
  <para style="q2">
    <verse number="14" style="v" sid="ISA 21:14"/>ತೇಮಾ ದೇಶದ ನಿವಾಸಿಗಳೇ,</para>
  <para style="q1" vid="ISA 21:14">ಬಾಯಾರಿದವರಿಗೆ ನೀರನ್ನು ತರುತ್ತಾರೆ.</para>
  <para style="q2" vid="ISA 21:14">ಓಡಿ ಹೋಗುವವರನ್ನು ತಮ್ಮ ರೊಟ್ಟಿಯಿಂದ ನಿವಾರಿಸುತ್ತಾರೆ.<verse eid="ISA 21:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="ISA 21:15"/>ಏಕೆಂದರೆ ಹಿರಿದ ಖಡ್ಗ,</para>
  <para style="q2" vid="ISA 21:15">ಬಾಗಿದ ಬಿಲ್ಲು, ಕಠಿಣ ಯುದ್ಧ</para>
  <para style="q1" vid="ISA 21:15">ಇವುಗಳಿಂದ ತಪ್ಪಿಸಿಕೊಂಡು</para>
  <para style="q2" vid="ISA 21:15">ಓಡಿ ಬಂದಿದ್ದಾರಷ್ಟೆ.<verse eid="ISA 21:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="ISA 21:16"/>ಏಕೆಂದರೆ ಕರ್ತರು ನನಗೆ ಹೀಗೆ ಹೇಳುತ್ತಾರೆ: “ಕೂಲಿಯವನ ವರುಷಗಳಂತೆ ಒಂದು ವರುಷದೊಳಗೆ ಕೇದಾರಿನ ವೈಭವವು ತೀರಿಹೋಗುವುದು. <verse eid="ISA 21:16"/><verse number="17" style="v" sid="ISA 21:17"/>ಬಿಲ್ಲುಗಾರರಲ್ಲಿ ಕೆಲವರೂ, ಕೇದಾರಿನ ಬಲಿಷ್ಠರಲ್ಲಿ ಕೆಲವರು ಮಾತ್ರ ಉಳಿಯುವರು,” ಎಂದು ಇಸ್ರಾಯೇಲಿನ ದೇವರಾದ ಯೆಹೋವ ದೇವರು ನುಡಿದಿದ್ದಾರೆ.<verse eid="ISA 21:17"/></para>
  <chapter eid="ISA 21"/>
  <chapter number="22" style="c" sid="ISA 22"/>
  <para style="s1">ಯೆರೂಸಲೇಮನ್ನು ಕುರಿತು ಪ್ರವಾದನೆ</para>
  <para style="p">
    <verse number="1" style="v" sid="ISA 22:1"/>ದಿವ್ಯ ದರ್ಶನದ ತಗ್ಗಿನ ವಿಷಯವಾದ ಪ್ರವಾದನೆ:</para>
  <para style="q1" vid="ISA 22:1">ನಿನ್ನವರೆಲ್ಲರು ಮಾಳಿಗೆಗಳ ಮೇಲೆ ಏರುವ ಹಾಗೆ,</para>
  <para style="q2" vid="ISA 22:1">ಈಗ ನಿನಗೆ ಏನಾಯಿತು?<verse eid="ISA 22:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 22:2"/>ಕೋಲಾಹಲದಿಂದ ತುಂಬಿ ಆರ್ಭಟಿಸುವ ಪಟ್ಟಣವೇ,</para>
  <para style="q2" vid="ISA 22:2">ಸಂಭ್ರಮದ ಪಟ್ಟಣವೇ,</para>
  <para style="q1" vid="ISA 22:2">ನಿನ್ನಲ್ಲಿ ಹತರಾದವರು ಖಡ್ಗದಿಂದ ಹತರಾದವರಲ್ಲ;</para>
  <para style="q2" vid="ISA 22:2">ಯುದ್ಧದಲ್ಲಿ ಸತ್ತವರೂ ಅಲ್ಲ.<verse eid="ISA 22:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 22:3"/>ನಿನ್ನ ಅಧಿಕಾರಸ್ಥರೆಲ್ಲ ಒಟ್ಟಿಗೆ</para>
  <para style="q2" vid="ISA 22:3">ಓಡಿದರೂ ಬಿಲ್ಲುಗಾರರಿಲ್ಲದೆಯೇ ಸೆರೆಯಾಗಿದ್ದಾರೆ.</para>
  <para style="q1" vid="ISA 22:3">ದೂರದಿಂದ ಓಡಿಬಂದರೂ ನಿನ್ನ ಜನರು</para>
  <para style="q2" vid="ISA 22:3">ಶತ್ರುವಿನ ಕೈಗೆ ಸಿಕ್ಕಿಬಿದ್ದಿದ್ದಾರೆ.<verse eid="ISA 22:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 22:4"/>ಹೀಗಿರಲು ನಾನು ಹೀಗೆ ಹೇಳಿದೆನು,</para>
  <para style="q2" vid="ISA 22:4">“ನನ್ನ ಕಡೆಯಿಂದ ದೃಷ್ಟಿ ತಿರುಗಿಸಿರಿ.</para>
  <para style="q2" vid="ISA 22:4">ಬಹು ಸಂಕಟದಿಂದ ನಾನು ಅಳುವೆನು.</para>
  <para style="q1" vid="ISA 22:4">ಏಕೆಂದರೆ ನನ್ನ ಜನವೆಂಬ ಯುವತಿಯು ಹಾಳಾದ ವಿಷಯದಲ್ಲಿ</para>
  <para style="q2" vid="ISA 22:4">ನನ್ನನ್ನು ಸಂತೈಸುವುದಕ್ಕೆ ತವಕಗೊಳ್ಳದಿರಿ.”<verse eid="ISA 22:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 22:5"/>ಕರ್ತ ಆಗಿರುವವರೂ, ಸರ್ವಶಕ್ತರೂ ಆದ ಯೆಹೋವ ದೇವರು,</para>
  <para style="q2" vid="ISA 22:5">ದರ್ಶನದ ತಗ್ಗಿನಲ್ಲಿ ಶ್ರಮೆಯ</para>
  <para style="q2" vid="ISA 22:5">ತುಳಿದಾಟದ ಭಯಭ್ರಾಂತಿಯ ದಿನವನ್ನು ಇಟ್ಟಿದ್ದಾರೆ.</para>
  <para style="q1" vid="ISA 22:5">ಅದು ಗೋಡೆಗಳು ಹೊಡೆದುರುಳಿಸುವ ದಿನವು.</para>
  <para style="q2" vid="ISA 22:5">ಪರ್ವತಗಳಿಗೆ ಜನರು ಕೂಗಾಡುವ ದಿನವದು.<verse eid="ISA 22:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 22:6"/>ಏಲಾಮಿನವರು ಕುದುರೆಗಳ,</para>
  <para style="q2" vid="ISA 22:6">ರಥಗಳ ಸಂಗಡ ಬತ್ತಳಿಕೆಯನ್ನು ಹೊತ್ತುಕೊಂಡು ಬಂದರು.</para>
  <para style="q2" vid="ISA 22:6">ಕೀರಿನವರು ಗುರಾಣಿಯನ್ನು ತೆರೆದರು.<verse eid="ISA 22:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 22:7"/>ನಿಮ್ಮ ಪ್ರಿಯವಾದ ಕಣಿವೆಗಳಲ್ಲಿ ರಥಗಳು ತುಂಬಿರುವುವು.</para>
  <para style="q2" vid="ISA 22:7">ರಾಹುತರು ಪಟ್ಟಣದ ಬಾಗಿಲಿನ ಹತ್ತಿರ ಸಿದ್ಧಮಾಡಿಕೊಳ್ಳುವರು.<verse eid="ISA 22:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 22:8"/>ಕರ್ತರು ಯೆಹೂದದ ಸಂರಕ್ಷಣೆಯ ಮುಸುಕನ್ನು ತೆಗೆದಿದ್ದಾರೆ.</para>
  <para style="q2" vid="ISA 22:8">ಆ ದಿವಸದಲ್ಲಿ ಅಡವಿ ಅರಮನೆಯ</para>
  <para style="q2" vid="ISA 22:8">ಯುದ್ಧ ಸಾಮಗ್ರಿಯ ಕಡೆಗೆ ದೃಷ್ಟಿ ಇಡುತ್ತೀಯೆ.<verse eid="ISA 22:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 22:9"/>ದಾವೀದನ ಪಟ್ಟಣದ ಕೋಟೆಯ</para>
  <para style="q2" vid="ISA 22:9">ಒಡಕುಗಳನ್ನು ಬಹಳವೆಂದು ಸಹ ನೋಡುತ್ತೀರಿ.</para>
  <para style="q1" vid="ISA 22:9">ಕೆಳಗಿನ ಕೊಳಕ್ಕೆ ನೀರನ್ನು ತುಂಬಿಸುತ್ತೀರಿ.<verse eid="ISA 22:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 22:10"/>ಯೆರೂಸಲೇಮಿನ ಮನೆಗಳನ್ನು ಲೆಕ್ಕ ಮಾಡಿ ಪೌಳಿಗೋಡೆಯನ್ನು</para>
  <para style="q2" vid="ISA 22:10">ಭದ್ರಪಡಿಸುವುದಕ್ಕೆ ನೀವು ಮನೆಗಳನ್ನು ಒಡೆದುಹಾಕುತ್ತೀರಿ.<verse eid="ISA 22:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 22:11"/>ಎರಡು ಗೋಡೆಗಳ ನಡುವೆ ಹಳೆಯ ಕೆರೆಯ</para>
  <para style="q2" vid="ISA 22:11">ನೀರಿಗೋಸ್ಕರ ತೊಟ್ಟಿಯನ್ನು ಮಾಡಿದ್ದೀರಿ,</para>
  <para style="q1" vid="ISA 22:11">ಕಾಲುವೆ ಮಾಡುತ್ತೀರಿ. ಆದರೆ ಅದನ್ನು ಮಾಡಿದವನನ್ನು ನೀವು ದೃಷ್ಟಿಸುವುದಿಲ್ಲ.</para>
  <para style="q2" vid="ISA 22:11">ಇಲ್ಲವೆ ಪುರಾತನ ಕಾಲದಲ್ಲಿ ಸಂಕಲ್ಪಿಸಿದವರನ್ನು ನೀನು ಲಕ್ಷಿಸುವುದಿಲ್ಲ.<verse eid="ISA 22:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 22:12"/>ಆ ದಿವಸದಲ್ಲಿ ಅತ್ತು, ದುಃಖಿಸಿ,</para>
  <para style="q2" vid="ISA 22:12">ತಲೆ ಬೋಳಿಸಿಕೊಂಡು,</para>
  <para style="q1" vid="ISA 22:12">ಗೋಣಿತಟ್ಟನ್ನು ಸುತ್ತಿಕೊಳ್ಳಬೇಕೆಂದು</para>
  <para style="q2" vid="ISA 22:12">ಸರ್ವಶಕ್ತ ದೇವರಾದ ಯೆಹೋವ ದೇವರು ನಿಮ್ಮನ್ನು ಕರೆದರು.<verse eid="ISA 22:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="ISA 22:13"/>ಆದರೆ ಉತ್ಸಾಹವು, ಸಂತೋಷವು,</para>
  <para style="q2" vid="ISA 22:13">ದನ ಕೊಳ್ಳುವುದು, ಕುರಿ ಕಡಿಯುವುದು,</para>
  <para style="q2" vid="ISA 22:13">ಮಾಂಸವನ್ನು ತಿನ್ನುವುದು, ದ್ರಾಕ್ಷಾರಸ ಕುಡಿಯುವುದು,</para>
  <para style="q1" vid="ISA 22:13">ನಾಳೆ ಸಾಯುತ್ತೇವೆಂದು ತಿಂದು</para>
  <para style="q2" vid="ISA 22:13">ಕುಡಿಯುವುದೇ ನಿಮ್ಮ ಕಾರ್ಯ.<verse eid="ISA 22:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="ISA 22:14"/>ಆದ್ದರಿಂದ ಸರ್ವಶಕ್ತರಾದ ಯೆಹೋವ ದೇವರು ನನ್ನ ಕಿವಿಗಳಲ್ಲಿ ಪ್ರಕಟ ಮಾಡಿದ್ದು ಏನೆಂದರೆ: “ನಿಶ್ಚಯವಾಗಿ ಈ ದುಷ್ಕೃತ್ಯಗಳನ್ನು ನೀವು ಸಾಯುವ ತನಕ ಮನ್ನಿಸುವುದೇ ಇಲ್ಲ,” ಎಂದು ಸೇನಾಧೀಶ್ವರ ಯೆಹೋವ ದೇವರು ಹೇಳಿದ್ದಾರೆ.<verse eid="ISA 22:14"/></para>
  <para style="b"/>
  <para style="p">
    <verse number="15" style="v" sid="ISA 22:15"/>ಸೇನಾಧೀಶ್ವರ ಯೆಹೋವ ದೇವರು ಪುನಃ ಹೀಗೆ ನುಡಿದಿದ್ದಾರೆ:</para>
  <para style="q1" vid="ISA 22:15">“ಹೋಗು, ಅರಮನೆಯ ಉಗ್ರಾಣದವನಾದ</para>
  <para style="q2" vid="ISA 22:15">ಶೆಬ್ನ ಎಂಬ ಖಜಾಂಚಿಯ ಬಳಿಗೆ ಹೋಗಿ ಹೀಗೆ ಹೇಳು:<verse eid="ISA 22:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="ISA 22:16"/>ನಿನಗೆ ಇಲ್ಲಿ ಏನು ಕೆಲಸ? ಇಲ್ಲಿ ನಿನಗೆ ಯಾರಿದ್ದಾರೆ?</para>
  <para style="q2" vid="ISA 22:16">ನೀನು ಉನ್ನತದಲ್ಲಿ ನಿನಗೆ ಸಮಾಧಿಯನ್ನು ತೋಡಿಸಿದೆ,</para>
  <para style="q1" vid="ISA 22:16">ಬಂಡೆಯಲ್ಲಿ ನಿನಗೆ ನಿವಾಸವನ್ನು ಕೆತ್ತಿಸುವವನ ಹಾಗೆ,</para>
  <para style="q2" vid="ISA 22:16">ನಿನಗೆ ಇಲ್ಲಿ ಸಮಾಧಿಯನ್ನು ತೋಡಿಸಿದಿ ಅಲ್ಲವೇ?<verse eid="ISA 22:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="ISA 22:17"/>“ಯೆಹೋವ ದೇವರು ನಿನ್ನನ್ನು ಬಲವಾದ</para>
  <para style="q2" vid="ISA 22:17">ಬಂಧನದೊಂದಿಗೆ ಹಿಡಿದೇ ಹಿಡಿಯುವರು.<verse eid="ISA 22:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="ISA 22:18"/>ನಿನ್ನನ್ನು ಚೆಂಡಿನಂತೆ ಸುತ್ತಿ ಸುತ್ತಿ ತಿರುಗಿಸಿ,</para>
  <para style="q2" vid="ISA 22:18">ವಿಸ್ತಾರವಾದ ದೇಶಕ್ಕೆ ಬಿಸಾಡುವರು.</para>
  <para style="q1" vid="ISA 22:18">ಅಲ್ಲೇ ನೀನು ಸಾಯುವೆ,</para>
  <para style="q2" vid="ISA 22:18">ನಿನ್ನ ವೈಭವದ ರಥಗಳು ನಿನ್ನ ಧಣಿಯ ಮನೆಗೆ</para>
  <para style="q2" vid="ISA 22:18">ಅವಮಾನವನ್ನುಂಟು ಮಾಡುವುವು.<verse eid="ISA 22:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="ISA 22:19"/>ನಿನ್ನನ್ನು ನಿನ್ನ ಉದ್ಯೋಗದಿಂದ ತಳ್ಳಿಬಿಡುವೆನು.</para>
  <para style="q2" vid="ISA 22:19">ನಿನ್ನ ಪದವಿಯಿಂದ ನಿನ್ನನ್ನು ಕೆಳಗೆ ಎಳೆದುಬಿಡುವೆನು.<verse eid="ISA 22:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="ISA 22:20"/>“ಆ ದಿನದಲ್ಲಿ ನನ್ನ ಸೇವಕನೂ, ಹಿಲ್ಕೀಯನ ಮಗನೂ ಆದ ಎಲ್ಯಾಕೀಮನನ್ನು ಕರೆದು, <verse eid="ISA 22:20"/><verse number="21" style="v" sid="ISA 22:21"/>ನಿನ್ನ ಅಂಗಿಯನ್ನು ಅವನಿಗೆ ತೊಡಿಸಿ, ನಿನ್ನ ನಡುಕಟ್ಟಿನಿಂದ ಅವನನ್ನು ಬಲಪಡಿಸಿ, ನಿನ್ನ ಅಧಿಕಾರವನ್ನು ಅವನಿಗೆ ಒಪ್ಪಿಸುವೆನು. ಅವನು ಯೆರೂಸಲೇಮಿನ ನಿವಾಸಿಗಳಿಗೂ, ಯೆಹೂದದ ಜನರಿಗೂ ತಂದೆಯಾಗಿರುವನು. <verse eid="ISA 22:21"/><verse number="22" style="v" sid="ISA 22:22"/>ದಾವೀದನ ಮನೆಗೆ ಬೀಗದ ಕೈಯನ್ನು ಅವನ ಹೆಗಲ ಮೇಲೆ ನಾನು ಹಾಕುವೆನು. ಅವನು ತೆರೆದರೆ ಯಾರೂ ಮುಚ್ಚರು, ಅವನು ಮುಚ್ಚಿದರೆ ಯಾರೂ ತೆರೆಯರು. <verse eid="ISA 22:22"/><verse number="23" style="v" sid="ISA 22:23"/>ಭದ್ರವಾದ ಸ್ಥಳದಲ್ಲಿ ಮೊಳೆಯನ್ನು ಹೊಡೆದ ಹಾಗೆ ಅವನನ್ನು ಭದ್ರಪಡಿಸುವೆನು. ಅವನು ತನ್ನ ತಂದೆಯ ಮನೆಗೆ ವೈಭವವುಳ್ಳ ಸಿಂಹಾಸನವಾಗಿರುವನು. <verse eid="ISA 22:23"/><verse number="24" style="v" sid="ISA 22:24"/>ಬಟ್ಟಲು ಮೊದಲುಗೊಂಡು ಕೊಡದ ತನಕ, ಸಕಲ ಸಾಧಾರಣ ಪಾತ್ರೆಗಳನ್ನು ಅಂದರೆ ತಂದೆಯ ಸಂತಾನ, ಸಂತತಿಯಾದ ಅವನ ಮನೆಯ ಎಲ್ಲಾ ವೈಭವವನ್ನು ಅವರು ಅವನಿಗೆ ವಹಿಸುವರು.<verse eid="ISA 22:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="ISA 22:25"/>“ಆ ದಿನದಲ್ಲಿ,” ಸೇನಾಧೀಶ್ವರ ಯೆಹೋವ ದೇವರು ಪ್ರಕಟಿಸುವುದು ಏನೆಂದರೆ, “ಭದ್ರವಾದ ಸ್ಥಳದಲ್ಲಿ ಮೊಳೆಯನ್ನು ತೆಗೆದುಹಾಕಿ, ಕುಸಿದುಬೀಳುವುದು. ಮೊಳೆಯ ಮೇಲೆ ಇದ್ದ ಭಾರವೂ ತೆಗೆದುಹಾಕಲಾಗುವುದು,” ಇದು ಯೆಹೋವ ದೇವರ ನುಡಿ.<verse eid="ISA 22:25"/></para>
  <chapter eid="ISA 22"/>
  <chapter number="23" style="c" sid="ISA 23"/>
  <para style="s1">ಟೈರಿನ ವಿಷಯವಾದ ಪ್ರವಾದನೆ</para>
  <para style="p">
    <verse number="1" style="v" sid="ISA 23:1"/>ಟೈರಿನ ವಿಷಯವಾದ ಪ್ರವಾದನೆ:</para>
  <para style="q1" vid="ISA 23:1">ತಾರ್ಷೀಷಿನ ಹಡಗುಗಳೇ, ಗೋಳಾಡಿರಿ,</para>
  <para style="q2" vid="ISA 23:1">ಏಕೆಂದರೆ ಟೈರ್ ಹಾಳಾಗಿರುವುದರಿಂದ</para>
  <para style="q2" vid="ISA 23:1">ನಿಮಗೆ ಮನೆಯಿಲ್ಲ ಮತ್ತು ಬಂದರವೂ ಇಲ್ಲ.</para>
  <para style="q1" vid="ISA 23:1">ಇದು ಕಿತ್ತೀಮ್ ದೇಶದವರಿಂದ ಅವರಿಗೆ ತಿಳಿಯಿತು.<verse eid="ISA 23:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 23:2"/>ದ್ವೀಪಗಳ ನಿವಾಸಿಗಳೇ,</para>
  <para style="q2" vid="ISA 23:2">ಸಮುದ್ರವನ್ನು ದಾಟುವ ಸೀದೋನಿನ ವರ್ತಕರಿಂದ</para>
  <para style="q2" vid="ISA 23:2">ಸಮೃದ್ಧಿಯನ್ನು ಹೊಂದಿದವರೇ ಮೌನವಾಗಿರಿ.<verse eid="ISA 23:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 23:3"/>ಪ್ರವಾಹದಿಂದ ಶೀಹೋರಿನ ಧಾನ್ಯವೂ,</para>
  <para style="q2" vid="ISA 23:3">ನೈಲ್ ನದಿಯ ಸುಗ್ಗಿಯೂ ಅದಕ್ಕೆ ಆದಾಯವಾಗಿತ್ತು.</para>
  <para style="q1" vid="ISA 23:3">ಅನೇಕ ಜನಾಂಗಗಳಿಗೆ ವ್ಯಾಪಾರ ಸ್ಥಳವಾಗಿತ್ತು.<verse eid="ISA 23:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 23:4"/>ಸೀದೋನೇ ಮತ್ತು ಸಮುದ್ರದ ಕೋಟೆಯೇ ನಾಚಿಕೆಪಡಿರಿ.</para>
  <para style="q2" vid="ISA 23:4">ಏಕೆಂದರೆ ಇದೇ ಸಮುದ್ರದ ಘೋಷಣೆಯಾಗಿದೆ:</para>
  <para style="q1" vid="ISA 23:4">“ನಾವು ಪ್ರಸವವೇದನೆ ಪಡುವುದಿಲ್ಲ, ಹೆರುವುದಿಲ್ಲ,</para>
  <para style="q2" vid="ISA 23:4">ಇಲ್ಲವೆ ಪುತ್ರಪುತ್ರಿಯರನ್ನು ಸಾಕಿ ಸಲಹುವುದಿಲ್ಲ,”<verse eid="ISA 23:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 23:5"/>ಈಜಿಪ್ಟಿನಿಂದ ಸುದ್ದಿ ಆದ ಹಾಗೆ</para>
  <para style="q2" vid="ISA 23:5">ಟೈರಿನ ಸುದ್ದಿಗೆ ಬಹಳ ವೇದನೆ ಪಡುವರು.<verse eid="ISA 23:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 23:6"/>ತಾರ್ಷೀಷಿಗೆ ದಾಟಿ ಹೋಗಿರಿ,</para>
  <para style="q2" vid="ISA 23:6">ದ್ವೀಪ ನಿವಾಸಿಗಳೇ ಗೋಳಾಡಿರಿ.<verse eid="ISA 23:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 23:7"/>ನಿಮ್ಮ ಉಲ್ಲಾಸದ ಪಟ್ಟಣವೂ,</para>
  <para style="q2" vid="ISA 23:7">ಪೂರ್ವಕಾಲದ ಹಳೆಯ ಸಂಪ್ರದಾಯದಿಂದ ಬಂದಿದ್ದೂ ಇದೆಯೋ?</para>
  <para style="q1" vid="ISA 23:7">ಅವಳ ಸ್ವಂತ ಕಾಲುಗಳು ಅದನ್ನು ದೂರ ದೇಶದಲ್ಲಿ</para>
  <para style="q2" vid="ISA 23:7">ನಿವಾಸಿಸುವುದಕ್ಕೆ ತೆಗೆದುಕೊಂಡು ಹೋಗುವವು.<verse eid="ISA 23:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 23:8"/>ಅದು ಕಿರೀಟದಾಯಕವಾದ ಪಟ್ಟಣವು.</para>
  <para style="q2" vid="ISA 23:8">ಅದರ ವರ್ತಕರಾದ ಪ್ರಭುಗಳು,</para>
  <para style="q1" vid="ISA 23:8">ಅದರ ವ್ಯಾಪಾರಿಗಳು ಭೂಮಿಯಲ್ಲಿ ಘನವುಳ್ಳವರಾಗಿದ್ದಾರೆ.</para>
  <para style="q2" vid="ISA 23:8">ಇಂಥ ಟೈರಿಗೆ ವಿರುದ್ಧವಾಗಿ ಈ ಆಲೋಚನೆ ಮಾಡಿದವರು ಯಾರು?<verse eid="ISA 23:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 23:9"/>ಗರ್ವದ ಸಕಲ ವೈಭವವನ್ನು ಹೊಲಸು ಮಾಡಬೇಕೆಂತಲೂ,</para>
  <para style="q2" vid="ISA 23:9">ಭೂಮಿಯಲ್ಲಿ ಘನವುಳ್ಳವರೆಲ್ಲರನ್ನು ಅವಮಾನಪಡಿಸಬೇಕೆಂತಲೂ</para>
  <para style="q2" vid="ISA 23:9">ಸೇನಾಧೀಶ್ವರ ಯೆಹೋವ ದೇವರೇ ಹೀಗೆ ಸಂಕಲ್ಪಿಸಿದ್ದಾರೆ.<verse eid="ISA 23:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 23:10"/>ತಾರ್ಷೀಷಿನ ಮಗಳೇ,</para>
  <para style="q2" vid="ISA 23:10">ನೈಲ್ ನದಿಯಂತೆ ನಿನ್ನ ದೇಶದಲ್ಲಿ ಹಾದುಹೋಗು.</para>
  <para style="q2" vid="ISA 23:10">ಅಲ್ಲಿ ಇನ್ನು ನಿನ್ನನ್ನು ತಡೆಯುವವರು ಯಾರೂ ಇಲ್ಲ.<verse eid="ISA 23:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 23:11"/>ಯೆಹೋವ ದೇವರು ಸಮುದ್ರದ ಮೇಲೆ</para>
  <para style="q2" vid="ISA 23:11">ತನ್ನ ಕೈಚಾಚಿ ರಾಜ್ಯಗಳನ್ನು ನಡುಗಿಸಿದ್ದಾನೆ.</para>
  <para style="q1" vid="ISA 23:11">ಅವರು ವ್ಯಾಪಾರದ ಪಟ್ಟಣವನ್ನು</para>
  <para style="q2" vid="ISA 23:11">ಕಾನಾನಿನ ದುರ್ಗಗಳನ್ನು ನಾಶಮಾಡಬೇಕೆಂದು ಆಜ್ಞಾಪಿಸಿದ್ದಾರೆ.<verse eid="ISA 23:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 23:12"/>“ಹಿಂಸೆಗೆ ಈಡಾದ ಕನ್ಯೆಯಂತಿರುವ ಸೀದೋನ್ ನಗರಿಯೇ,</para>
  <para style="q2" vid="ISA 23:12">ಇನ್ನು ಮೇಲೆ ನಿನಗೆ ಸಂತೃಪ್ತಿ ಇಲ್ಲ.</para>
  <para style="b" vid="ISA 23:12"/>
  <para style="q1" vid="ISA 23:12">“ಎದ್ದು, ಕಿತ್ತೀಮಿಗೆ ಸಮುದ್ರದ ಮೇಲೆ ಹಾದುಹೋಗು.</para>
  <para style="q2" vid="ISA 23:12">ಅಲ್ಲಿಯೂ ನಿನಗೆ ವಿಶ್ರಾಂತಿ ಇರದು.”<verse eid="ISA 23:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="ISA 23:13"/>ಕಸ್ದೀಯರ ದೇಶವು! ಅಸ್ಸೀರಿಯದವರು ಅದನ್ನು</para>
  <para style="q2" vid="ISA 23:13">ಕಾಡುಮೃಗಗಳಿಗೆ ಈಡು</para>
  <para style="q1" vid="ISA 23:13">ಮಾಡುವ ತನಕ ಈ ಜನರು ಇರಲಿಲ್ಲ.</para>
  <para style="q2" vid="ISA 23:13">ಗೋಪುರಗಳನ್ನು ಕಟ್ಟಿಸಿಕೊಂಡು</para>
  <para style="q2" vid="ISA 23:13">ಅವರು ಅದರ ಅರಮನೆಗಳನ್ನು ಕಟ್ಟಿಸಿಕೊಂಡು ಅದನ್ನು ನಾಶಮಾಡಿದ್ದಾರೆ.<verse eid="ISA 23:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="ISA 23:14"/>ತಾರ್ಷೀಷಿನ ಹಡಗುಗಳೇ, ಗೋಳಾಡಿರಿ!</para>
  <para style="q2" vid="ISA 23:14">ಏಕೆಂದರೆ ನಿಮ್ಮ ಆಶ್ರಯಸ್ಥಾನವು ಹಾಳಾಯಿತು, ಎಂದು ಆತನು ಹೇಳಿದ್ದಾನೆ.<verse eid="ISA 23:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="ISA 23:15"/>ಆ ದಿವಸದಲ್ಲಿ ಟೈರ್ ಪಟ್ಟಣವು ಒಬ್ಬ ಅರಸನ ದಿವಸಗಳ ಪ್ರಕಾರ ಎಪ್ಪತ್ತು ವರುಷಗಳ ತನಕ ಜ್ಞಾಪಕಕ್ಕೆ ಬಾರದೆ ಇರುವುದು. ಎಪ್ಪತ್ತು ವರ್ಷಗಳ ಕೊನೆಯಲ್ಲಿ ಟೈರ್ ಪಟ್ಟಣವು ವೇಶ್ಯೆಯ ವಿಷಯವಾದ ಈ ಗೀತೆಯ ಹಾಗಾಗುವುದು:<verse eid="ISA 23:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="ISA 23:16"/>“ಮರೆತುಹೋದ ವೇಶ್ಯೆಯೇ,</para>
  <para style="q2" vid="ISA 23:16">ಕಿನ್ನರಿಯನ್ನು ತೆಗೆದುಕೋ.</para>
  <para style="q1" vid="ISA 23:16">ಪಟ್ಟಣಗಳಲ್ಲಿ ಅಲೆಯುತ್ತಾ ನೀನು ನೆನಪಾಗುವ ಹಾಗೆ ಚೆನ್ನಾಗಿ ನುಡಿಸಿ,</para>
  <para style="q2" vid="ISA 23:16">ಬಹಳ ಗೀತೆಗಳನ್ನು ಹಾಡು.”<verse eid="ISA 23:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="ISA 23:17"/>ಎಪ್ಪತ್ತು ವರುಷಗಳಾದ ಮೇಲೆ ಯೆಹೋವ ದೇವರು ಟೈರನ್ನು ಪರಾಮರಿಸುವರು. ಅದು ತನ್ನ ಆದಾಯಕ್ಕಾಗಿ ಹಿಂದಿರುಗಿ ಭೂಲೋಕದವರಲ್ಲಿರುವ ಎಲ್ಲಾ ರಾಜ್ಯಗಳ ಸಂಗಡ ಭೂಮಿಯ ಮೇಲೆ ವ್ಯಾಪಾರ ಮಾಡುವುದು. <verse eid="ISA 23:17"/><verse number="18" style="v" sid="ISA 23:18"/>ಆದರೆ ಅವಳ ವ್ಯಾಪಾರವೂ ಮತ್ತು ಅವಳ ಆದಾಯವೂ ಬೊಕ್ಕಸದಲ್ಲಿ ಹಾಕದೆ ಇಲ್ಲವೆ ಇಟ್ಟುಕೊಳ್ಳದೆ ಯೆಹೋವ ದೇವರಿಗೆ ಪರಿಶುದ್ಧವಾಗುವುದು. ಅವಳ ಆದಾಯವು ಯೆಹೋವ ದೇವರ ಸನ್ನಿಧಾನದಲ್ಲಿ ವಾಸಿಸುವವರೆಗೆ ಬೇಕಾದಷ್ಟು ಅನ್ನವನ್ನೂ, ಶ್ರೇಷ್ಠವಾದ ಉಡುಪನ್ನೂ ಒದಗಿಸಲು ಅನುಕೂಲವಾಗುವುದು.<verse eid="ISA 23:18"/></para>
  <chapter eid="ISA 23"/>
  <chapter number="24" style="c" sid="ISA 24"/>
  <para style="s1">ಯೆಹೋವ ದೇವರು ಭೂಮಿಯನ್ನು ಹಾಳುಮಾಡುವರು</para>
  <para style="q1">
    <verse number="1" style="v" sid="ISA 24:1"/>ಇಗೋ, ಯೆಹೋವ ದೇವರು ಭೂಮಿಯನ್ನು ಬರಿದುಮಾಡಿ,</para>
  <para style="q2" vid="ISA 24:1">ನಿರ್ಜನ ಪ್ರದೇಶವನ್ನಾಗಿ ಮಾಡಿ,</para>
  <para style="q1" vid="ISA 24:1">ತಲೆಕೆಳಗಾಗಿ ತಿರುಗಿಸಿ,</para>
  <para style="q2" vid="ISA 24:1">ಅದರ ನಿವಾಸಿಗಳನ್ನು ಚದರಿಸಿಬಿಡುವವರಾಗಿದ್ದಾರೆ.<verse eid="ISA 24:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 24:2"/>ಜನಗಳಿಗೆ ಹೇಗೋ ಹಾಗೆಯೇ ಯಾಜಕರಿಗೆ;</para>
  <para style="q2" vid="ISA 24:2">ದಾಸನಿಗೆ ಹೇಗೋ ಹಾಗೆಯೇ ಯಜಮಾನನಿಗೆ;</para>
  <para style="q2" vid="ISA 24:2">ದಾಸಿಗೆ ಹೇಗೋ ಹಾಗೆಯೇ ಅವಳ ಯಜಮಾನಿಗೆ;</para>
  <para style="q2" vid="ISA 24:2">ಕೊಳ್ಳುವವನಿಗೆ ಹೇಗೋ ಹಾಗೆಯೇ ಮಾರುವವನಿಗೆ;</para>
  <para style="q2" vid="ISA 24:2">ಸಾಲಕೊಡುವವನಿಗೆ ಹೇಗೋ ಹಾಗೆಯೇ ಸಾಲ ಪಡೆಯುವವನಿಗೆ;</para>
  <para style="q2" vid="ISA 24:2">ಬಡ್ಡಿ ತೆಗೆಯುವವನಿಗೆ ಹೇಗೋ ಹಾಗೆಯೇ ಬಡ್ಡಿ ತರುವವನಿಗೆ ಆಗುವುದು.<verse eid="ISA 24:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 24:3"/>ಭೂಮಿಯು ಬಟ್ಟಬರಿದಾಗುವುದು,</para>
  <para style="q2" vid="ISA 24:3">ಸಂಪೂರ್ಣ ಸುಲಿಗೆಯಾಗುವುದು.</para>
  <para style="q2" vid="ISA 24:3">ಯೆಹೋವ ದೇವರು ತಾವೇ ಈ ಮಾತನ್ನು ಹೇಳಿದ್ದಾರೆ.<verse eid="ISA 24:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 24:4"/>ಭೂಮಿಯು ಪ್ರಲಾಪಿಸುತ್ತಾ ಬಾಡಿಹೋಗುವುದು.</para>
  <para style="q2" vid="ISA 24:4">ಲೋಕವು ಸೊರಗಿ ಬಾಡಿಹೋಗುವುದು.</para>
  <para style="q2" vid="ISA 24:4">ಆಕಾಶವು ಭೂಮಿಯೊಂದಿಗೆ ಕುಗ್ಗಿಹೋಗುವುದು.<verse eid="ISA 24:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 24:5"/>ಭೂನಿವಾಸಿಗಳು ದೈವಾಜ್ಞೆಗಳನ್ನು ಮೀರಿ,</para>
  <para style="q2" vid="ISA 24:5">ದೈವನಿಯಮಗಳನ್ನು ಬದಲಾಯಿಸಿ,</para>
  <para style="q1" vid="ISA 24:5">ನಿತ್ಯವಾದ ಒಡಂಬಡಿಕೆಯನ್ನು ಭಂಗಪಡಿಸಿದ್ದರಿಂದ</para>
  <para style="q2" vid="ISA 24:5">ಭೂಮಿಯು ಸಹ ಅದರ ನಿವಾಸಿಗಳ ಹೆಜ್ಜೆಯಿಂದ ಅಪವಿತ್ರವಾಗುವುದು.<verse eid="ISA 24:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 24:6"/>ಆದಕಾರಣ ಶಾಪವು ಲೋಕವನ್ನು ನುಂಗಿಬಿಟ್ಟಿದೆ.</para>
  <para style="q2" vid="ISA 24:6">ಅದರಲ್ಲಿ ವಾಸವಾಗಿರುವವರು ದಂಡನೆಗೆ ಒಳಗಾಗಿದ್ದಾರೆ.</para>
  <para style="q1" vid="ISA 24:6">ಆದ್ದರಿಂದ ಭೂನಿವಾಸಿಗಳು ಸುಟ್ಟು ಹೋಗಿ,</para>
  <para style="q2" vid="ISA 24:6">ಕೆಲವರು ಮಾತ್ರ ಉಳಿದಿದ್ದಾರೆ.<verse eid="ISA 24:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 24:7"/>ದ್ರಾಕ್ಷಾರಸವು ಬತ್ತಿಹೋಗುವುದು, ದ್ರಾಕ್ಷಿಯು ಬಾಡುವುದು.</para>
  <para style="q2" vid="ISA 24:7">ಹರ್ಷ ಹೃದಯರೆಲ್ಲಾ ನಿಟ್ಟುಸಿರುಬಿಡುತ್ತಾರೆ.<verse eid="ISA 24:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 24:8"/>ದಮ್ಮಡಿಗಳ ಉತ್ಸಾಹವು ಮುಗಿದಿದೆ.</para>
  <para style="q2" vid="ISA 24:8">ಉಲ್ಲಾಸದ ಅವರ ಶಬ್ದವು ಕೊನೆಗೊಂಡಿತು.</para>
  <para style="q2" vid="ISA 24:8">ಕಿನ್ನರಿಯ ಆನಂದ ಸ್ವರವು ತೀರಿತು.<verse eid="ISA 24:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 24:9"/>ಇನ್ನು ಗಾನದೊಡನೆ ದ್ರಾಕ್ಷಾರಸವನ್ನು ಕುಡಿಯರು,</para>
  <para style="q2" vid="ISA 24:9">ಕುಡಿಯುವವರಿಗೆ ಮದ್ಯಪಾನವು ಕಹಿಯಾಗುವುದು.<verse eid="ISA 24:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 24:10"/>ಹಾಳುಪಟ್ಟಣವು ಬಿದ್ದುಹೋಗಿದೆ.</para>
  <para style="q2" vid="ISA 24:10">ಯಾರು ಒಳಗೆ ಬಾರದಂತೆ ಪ್ರತಿಯೊಂದು ಮನೆಯು ಮುಚ್ಚಿದೆ.<verse eid="ISA 24:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 24:11"/>ದ್ರಾಕ್ಷಾರಸದ ಕೊರತೆಯಿಂದ ಬೀದಿಗಳಲ್ಲಿ ಅರಚುತ್ತಾರೆ.</para>
  <para style="q2" vid="ISA 24:11">ಉಲ್ಲಾಸವೆಲ್ಲ ಅಸ್ತಮಿಸಿದೆ.</para>
  <para style="q2" vid="ISA 24:11">ಭೂಮಿಯ ಮೇಲಿನ ಸಂತೋಷವು ತೊಲಗಿಹೋಗಿದೆ.<verse eid="ISA 24:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 24:12"/>ಪಟ್ಟಣದಲ್ಲಿ ಹಾಳೇ ಉಳಿದಿವೆ.</para>
  <para style="q2" vid="ISA 24:12">ನಾಶನವು ಹೆಬ್ಬಾಗಿಲಿಗೆ ಬಡಿದಿದೆ.<verse eid="ISA 24:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="ISA 24:13"/>ಓಲಿವ್ ಮರವನ್ನು ಬಡಿದ ಮೇಲೆಯೂ,</para>
  <para style="q2" vid="ISA 24:13">ದ್ರಾಕ್ಷಿ ಸುಗ್ಗಿಯು ತೀರಿದ ನಂತರವು</para>
  <para style="q1" vid="ISA 24:13">ನಿಲ್ಲುವ ಉಳಿದ ಕಾಯಿಗಳ</para>
  <para style="q2" vid="ISA 24:13">ಹಾಗೆ ದೇಶದಲ್ಲಿರುವುದು.<verse eid="ISA 24:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="ISA 24:14"/>ಅವರು ತಮ್ಮ ಸ್ವರವನ್ನೆತ್ತಿ ಯೆಹೋವ ದೇವರ ಮಹಿಮೆಯನ್ನು ಕುರಿತು ಹಾಡುವರು.</para>
  <para style="q2" vid="ISA 24:14">ಪಶ್ಚಿಮ ದಿಕ್ಕಿನ ಕಡೆಯಿಂದ ಆರ್ಭಟಿಸುವರು.<verse eid="ISA 24:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="ISA 24:15"/>ಆದ್ದರಿಂದ ಪೂರ್ವದಿಕ್ಕಿನವರೇ, ಯೆಹೋವ ದೇವರನ್ನು ಮಹಿಮೆಪಡಿಸಿರಿ;</para>
  <para style="q2" vid="ISA 24:15">ಸಮುದ್ರದ ದ್ವೀಪಗಳಲ್ಲಿ ಇಸ್ರಾಯೇಲರ ದೇವರಾದ</para>
  <para style="q2" vid="ISA 24:15">ಯೆಹೋವ ದೇವರ ಹೆಸರನ್ನು ನೀವು ಘನಪಡಿಸಿರಿ, ಎಂದು ಕೂಗುವರು.<verse eid="ISA 24:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="ISA 24:16"/>ಭೂಮಂಡಲದ ಕಟ್ಟಕಡೆಯಿಂದ “ನೀತಿವಂತರಿಗೆ ಮಹಿಮೆಯಾಗಲಿ”</para>
  <para style="q2" vid="ISA 24:16">ಎಂಬ ಗೀತೆಗಳು ನಮಗೆ ಕೇಳಿಬರುತ್ತಿವೆ.</para>
  <para style="b" vid="ISA 24:16"/>
  <para style="q1" vid="ISA 24:16">ಆದರೆ, “ನಾನಾದರೋ ಕ್ಷಯಿಸೇ ಕ್ಷಯಿಸುತ್ತೇನೆ.</para>
  <para style="q2" vid="ISA 24:16">ನನಗೆ ಕಷ್ಟ!</para>
  <para style="q1" vid="ISA 24:16">ಬಾಧಕರು ಬಾಧಿಸುವುದರಲ್ಲಿಯೇ ನಿರತರಾಗಿದ್ದಾರೆ.</para>
  <para style="q2" vid="ISA 24:16">ಹೌದು, ಬಾಧಕರು ಬಹಳವಾಗಿ ಬಾಧಿಸುವುದರಲ್ಲಿ ನಿರತರಾಗಿದ್ದಾರೆ.”<verse eid="ISA 24:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="ISA 24:17"/>ಭೂಮಿಯ ನಿವಾಸಿಗಳೇ,</para>
  <para style="q2" vid="ISA 24:17">ಭಯವೂ, ಕುಳಿಯೂ, ಬಲೆಯೂ ನಿಮಗೆ ಕಾದಿವೆ.<verse eid="ISA 24:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="ISA 24:18"/>ಆಗ ಭಯದ ಶಬ್ದಕ್ಕೆ ಓಡಿಹೋಗುವವನು</para>
  <para style="q2" vid="ISA 24:18">ಗುಂಡಿಯೊಳಗೆ ಬೀಳುವನು.</para>
  <para style="q1" vid="ISA 24:18">ಗುಂಡಿಯೊಳಗಿಂದ ಏರಿಬರುವವನು</para>
  <para style="q2" vid="ISA 24:18">ಬಲೆಗೆ ಸಿಕ್ಕಿಬೀಳುವನು.</para>
  <para style="b" vid="ISA 24:18"/>
  <para style="q1" vid="ISA 24:18">ಆಕಾಶದ ದ್ವಾರಗಳು ತೆರೆದಿವೆ.</para>
  <para style="q2" vid="ISA 24:18">ಭೂಮಿಯ ಅಸ್ತಿವಾರಗಳು ಕಂಪಿಸುತ್ತಿವೆ.<verse eid="ISA 24:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="ISA 24:19"/>ಭೂಮಿಯು ಬಿರುಕುಬಿಟ್ಟಿದೆ,</para>
  <para style="q2" vid="ISA 24:19">ಬಿರಿದು ಬಿರಿದಿದೆ,</para>
  <para style="q2" vid="ISA 24:19">ಭೂಮಿಯು ಕದಲಿಹೋಗಿದೆ.<verse eid="ISA 24:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="ISA 24:20"/>ಭೂಮಿಯು ಕುಡುಕನ ಹಾಗೆ ಓಲಾಡುತ್ತದೆ,</para>
  <para style="q2" vid="ISA 24:20">ಗಾಳಿಗೆ ಸಿಕ್ಕಿದ ಗುಡಿಸಲಿನ ಹಾಗೆ ತೂಗಾಡುತ್ತದೆ,</para>
  <para style="q1" vid="ISA 24:20">ಅದರ ಅಪರಾಧವು ಅದರ ಮೇಲೆ ಭಾರವಾಗಿರುತ್ತದೆ,</para>
  <para style="q2" vid="ISA 24:20">ಅದು ಬಿದ್ದು ಹೋಗುತ್ತದೆ, ತಿರುಗಿ ಏಳುವುದೇ ಇಲ್ಲ.<verse eid="ISA 24:20"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="21" style="v" sid="ISA 24:21"/>ಆ ದಿವಸದಲ್ಲಿ ಯೆಹೋವ ದೇವರು ಆಕಾಶದಲ್ಲಿರುವ</para>
  <para style="q2" vid="ISA 24:21">ಆಕಾಶದವರ ಸೈನ್ಯವನ್ನೂ,</para>
  <para style="q2" vid="ISA 24:21">ಭೂಮಿಯ ಮೇಲಿರುವ ಭೂರಾಜರನ್ನೂ ದಂಡಿಸುವರು.<verse eid="ISA 24:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="ISA 24:22"/>ನೆಲಮಾಳಿಗೆಯೊಳಗೆ ಒಟ್ಟುಗೂಡಿದ</para>
  <para style="q2" vid="ISA 24:22">ಸೆರೆಯವರ ಹಾಗೆ</para>
  <para style="q1" vid="ISA 24:22">ಅವರು ಒಟ್ಟುಗೂಡಿ ಸೆರೆಮನೆಯಲ್ಲಿ</para>
  <para style="q2" vid="ISA 24:22">ಬಹಳ ದಿನಗಳಿದ್ದ ತರುವಾಯ ದಂಡನೆಗೆ ಗುರಿಯಾಗುವರು.<verse eid="ISA 24:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="ISA 24:23"/>ಆಮೇಲೆ ಸೇನಾಧೀಶ್ವರ ಯೆಹೋವ ದೇವರು ಚೀಯೋನ್ ಪರ್ವತದಲ್ಲಿಯೂ,</para>
  <para style="q2" vid="ISA 24:23">ಯೆರೂಸಲೇಮಿನಲ್ಲಿಯೂ ಹಿರಿಯರ ಮುಂದೆ</para>
  <para style="q1" vid="ISA 24:23">ಮಹಿಮೆಯಿಂದ ಆಳುವಾಗ,</para>
  <para style="q2" vid="ISA 24:23">ಚಂದ್ರನಿಗೆ ಅವಮಾನವಾಗುವುದು,</para>
  <para style="q2" vid="ISA 24:23">ಸೂರ್ಯನು ನಾಚಿಕೆ ಪಡುವನು.<verse eid="ISA 24:23"/></para>
  <chapter eid="ISA 24"/>
  <chapter number="25" style="c" sid="ISA 25"/>
  <para style="s1">ಯೆಹೋವ ದೇವರಿಗೆ ಸ್ತುತಿ</para>
  <para style="q1">
    <verse number="1" style="v" sid="ISA 25:1"/>ಯೆಹೋವ ದೇವರೇ, ನೀವೇ ನನ್ನ ದೇವರು.</para>
  <para style="q2" vid="ISA 25:1">ನೀವು ಸತ್ಯ ಪ್ರಾಮಾಣಿಕತೆಗಳನ್ನು ಆಲೋಚಿಸಿ,</para>
  <para style="q1" vid="ISA 25:1">ಅನುಸರಿಸಿ ಆದಿಸಂಕಲ್ಪಗಳನ್ನು ನೆರವೇರಿಸುತ್ತಾ,</para>
  <para style="q2" vid="ISA 25:1">ಅದ್ಭುತಕಾರ್ಯಗಳನ್ನು ನಡೆಸಿದ ಕಾರಣ ನಿಮ್ಮನ್ನು ಉನ್ನತಪಡಿಸಿ,</para>
  <para style="q2" vid="ISA 25:1">ನಿಮ್ಮ ನಾಮವನ್ನು ಕೊಂಡಾಡುವೆನು.<verse eid="ISA 25:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 25:2"/>ಏಕೆಂದರೆ ನೀವು ದುರ್ಗವನ್ನು ನಾಶಪಡಿಸಿ,</para>
  <para style="q2" vid="ISA 25:2">ಪಟ್ಟಣವನ್ನು ಹಾಳುದಿಬ್ಬವನ್ನಾಗಿಯೂ</para>
  <para style="q1" vid="ISA 25:2">ವಿದೇಶಿಯರ ಕೋಟೆಯನ್ನು ಯಾರೂ ಎಂದಿಗೂ</para>
  <para style="q2" vid="ISA 25:2">ಕಟ್ಟಬಾರದಂತೆ ಮಾಡಿದ್ದೀರಿ.<verse eid="ISA 25:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 25:3"/>ಬಲಿಷ್ಠವಾದ ಜನಾಂಗವು ನಿಮ್ಮನ್ನು ಘನಪಡಿಸುವರು,</para>
  <para style="q2" vid="ISA 25:3">ಭಯಂಕರವಾದ ಜನರ ಪಟ್ಟಣವು ನಿಮಗೆ ಅಂಜುವುದು.<verse eid="ISA 25:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 25:4"/>ನೀವು ದೀನರಿಗೆ ಕೋಟೆಯೂ,</para>
  <para style="q2" vid="ISA 25:4">ಇಕ್ಕಟ್ಟಿನಲ್ಲಿ ದರಿದ್ರರಿಗೆ ರಕ್ಷಣಾ ದುರ್ಗವೂ,</para>
  <para style="q1" vid="ISA 25:4">ಭೀಕರರ ಶ್ವಾಸವು ಬಿಸಿಲಿಗೆ ನೆರಳೂ,</para>
  <para style="q2" vid="ISA 25:4">ಗೋಡೆಗೆ ಬಡಿದು ಬಿಡುವ ಬಿರುಗಾಳಿಯಂತಿರುವಾಗ</para>
  <para style="q1" vid="ISA 25:4">ಬಿರುಗಾಳಿಗೋಸ್ಕರ ಆಶ್ರಯವೂ ಆಗಿದ್ದೀರಿ.<verse eid="ISA 25:4"/></para>
  <para style="q2">
    <verse number="5" style="v" sid="ISA 25:5"/>ಮೇಘವು ಒಣನೆಲದ ಕಾವನ್ನು ಆರಿಸುವ ಹಾಗೆ,</para>
  <para style="q1" vid="ISA 25:5">ನೀವು ವಿದೇಶಿಯರ ಗದ್ದಲವನ್ನು ಅಡಗಿಸುವಿರಿ;</para>
  <para style="q2" vid="ISA 25:5">ಮೋಡದ ನೆರಳಿನಿಂದ ಬಿಸಿಲು ತಡೆಯುವ ಹಾಗೆಯೇ,</para>
  <para style="q2" vid="ISA 25:5">ನೀವು ಕ್ರೂರಿಗಳ ಉತ್ಸಾಹಗಾನವನ್ನು ನಿಲ್ಲಿಸಿಬಿಡುವಿರಿ.<verse eid="ISA 25:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 25:6"/>ಸೇನಾಧೀಶ್ವರ ಯೆಹೋವ ದೇವರು ಈ ಪರ್ವತದಲ್ಲಿ ಎಲ್ಲಾ ಜನಗಳಿಗೆ</para>
  <para style="q2" vid="ISA 25:6">ಸಾರವತ್ತಾದ ಕೊಬ್ಬಿದ ಔತಣವನ್ನೂ,</para>
  <para style="q1" vid="ISA 25:6">ಮಡ್ಡಿಗಟ್ಟಿದ ದ್ರಾಕ್ಷಾರಸದ ಔತಣವನ್ನೂ,</para>
  <para style="q2" vid="ISA 25:6">ಮಡ್ಡಿಗಟ್ಟಿದ ಮೇಲೆ ಶೋಧಿಸಿದ ದ್ರಾಕ್ಷಾರಸವನ್ನೂ ಸಿದ್ಧಮಾಡುವರು.<verse eid="ISA 25:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 25:7"/>ಸಮಸ್ತ ಜನಾಂಗಗಳನ್ನು ಮುಚ್ಚಿರುವ ಪರದೆಯನ್ನೂ,</para>
  <para style="q2" vid="ISA 25:7">ಸಕಲ ದೇಶದವರ ಮೇಲೆ ಹರಡಿರುವ ತೆರೆಯನ್ನೂ</para>
  <para style="q1" vid="ISA 25:7">ಇದೇ ಪರ್ವತದಲ್ಲಿ ತೆಗೆದುಹಾಕುವರು.<verse eid="ISA 25:7"/></para>
  <para style="q2">
    <verse number="8" style="v" sid="ISA 25:8"/>ಅವರು ಮರಣವನ್ನು ಜಯದಲ್ಲಿ ನುಂಗಿಬಿಡುವರು.</para>
  <para style="q1" vid="ISA 25:8">ಸಾರ್ವಭೌಮ ಯೆಹೋವ ದೇವರು ಎಲ್ಲಾ ಮುಖಗಳಲ್ಲಿರುವ ಕಣ್ಣೀರನ್ನೂ ಒರಸಿಬಿಡುವರು.</para>
  <para style="q2" vid="ISA 25:8">ತಮ್ಮ ಜನರ ನಿಂದೆಯನ್ನೂ ಭೂಮಂಡಲದಿಂದಲೇ ತೆಗೆದುಹಾಕುವರು.</para>
  <para style="q2" vid="ISA 25:8">ಯೆಹೋವ ದೇವರೇ ಇದನ್ನು ನುಡಿದಿದ್ದಾರೆ.<verse eid="ISA 25:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="ISA 25:9"/>ಆ ದಿನದಲ್ಲಿ ಜನರು,</para>
  <para style="q1" vid="ISA 25:9">“ಇಗೋ, ಇವರೇ ನಮ್ಮ ದೇವರು,</para>
  <para style="q2" vid="ISA 25:9">ನಾವು ಇವರನ್ನೇ ನಂಬಿದ್ದೇವೆ. ಇವರೇ ನಮ್ಮನ್ನು ರಕ್ಷಿಸುವರು.</para>
  <para style="q1" vid="ISA 25:9">ಇವರೇ ಯೆಹೋವ ದೇವರು, ನಾವು ಇವರನ್ನೇ ನಂಬಿದ್ದೇವೆ,</para>
  <para style="q2" vid="ISA 25:9">ನಾವು ಇವರ ರಕ್ಷಣೆಯಲ್ಲಿ ಹರ್ಷಿಸಿ ಸಂತೋಷಪಡುವೆವು,”</para>
  <para style="q2" vid="ISA 25:9">ಎಂದು ಹೇಳುವರು.<verse eid="ISA 25:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 25:10"/>ಈ ಪರ್ವತದಲ್ಲಿ ಯೆಹೋವ ದೇವರ ಕೈ ವಿಶ್ರಮಿಸಿಕೊಳ್ಳುವುದು.</para>
  <para style="q2" vid="ISA 25:10">ಒಣಹುಲ್ಲನ್ನು ತಿಪ್ಪೆಗುಂಡಿಯಲ್ಲಿ ತುಳಿಯುವಂತೆ</para>
  <para style="q2" vid="ISA 25:10">ಮೋವಾಬು ತುಳಿತಕ್ಕೆ ಈಡಾಗುವುದು.<verse eid="ISA 25:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 25:11"/>ಈಜುವವನು ಈಜುವುದಕ್ಕೆ ಕೈಗಳನ್ನು ಹರಡಿಕೊಂಡ ಹಾಗೆ,</para>
  <para style="q2" vid="ISA 25:11">ಅವರು ತಮ್ಮ ಕೈಗಳನ್ನು ಚಾಚುವರು.</para>
  <para style="q1" vid="ISA 25:11">ಆದರೆ ದೇವರು ಅವರ ಗರ್ವವನ್ನೂ ಅವರ</para>
  <para style="q2" vid="ISA 25:11">ಕೈ ಕೆಲಸವನ್ನೂ ತಗ್ಗಿಸಿಬಿಡುವರು.<verse eid="ISA 25:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 25:12"/>ದುರ್ಗದಂತೆ ಎತ್ತರವಾಗಿರುವ</para>
  <para style="q2" vid="ISA 25:12">ನಿನ್ನ ಕೋಟೆಗಳನ್ನು ಕೆಡವಿ,</para>
  <para style="q1" vid="ISA 25:12">ತಗ್ಗಿಸಿ, ನೆಲಸಮಮಾಡುವರು,</para>
  <para style="q2" vid="ISA 25:12">ಅದು ಧೂಳುಪಾಲಾಗುವುದು.<verse eid="ISA 25:12"/></para>
  <chapter eid="ISA 25"/>
  <chapter number="26" style="c" sid="ISA 26"/>
  <para style="s1">ಸ್ತುತಿಗೀತೆ</para>
  <para style="p">
    <verse number="1" style="v" sid="ISA 26:1"/>ಆ ದಿವಸದಲ್ಲಿ ಯೆಹೂದ ದೇಶದಲ್ಲಿ ಈ ಹಾಡನ್ನು ಹಾಡುವರು:</para>
  <para style="q1" vid="ISA 26:1">ನಮಗೆ ಬಲವಾದ ಪಟ್ಟಣವಿದೆ,</para>
  <para style="q2" vid="ISA 26:1">ರಕ್ಷಣೆಯನ್ನು ಕೋಟೆಯನ್ನಾಗಿಯೂ,</para>
  <para style="q2" vid="ISA 26:1">ಹೊರಪೌಳಿಯನ್ನಾಗಿಯೂ ದೇವರು ಮಾಡುವರು.<verse eid="ISA 26:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 26:2"/>ಬಾಗಿಲುಗಳನ್ನು ತೆರೆಯಿರಿ.</para>
  <para style="q2" vid="ISA 26:2">ಸತ್ಯವನ್ನು ಕೈಗೊಳ್ಳುವ ನೀತಿಯುಳ್ಳ ಜನಾಂಗವು ಒಳಗೆ ಪ್ರವೇಶಿಸಲಿ.<verse eid="ISA 26:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 26:3"/>ದೃಢ ಮನಸ್ಸುಳ್ಳವರನ್ನು ಪೂರ್ಣ ಸಮಾಧಾನದಲ್ಲಿ</para>
  <para style="q2" vid="ISA 26:3">ನೆಲೆಗೊಳಿಸಿ ಕಾಯುವೆ,</para>
  <para style="q2" vid="ISA 26:3">ಏಕೆಂದರೆ ಅವರಿಗೆ ನಿನ್ನಲ್ಲಿ ಭರವಸವಿದೆ.<verse eid="ISA 26:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 26:4"/>ನೀವು ಯೆಹೋವ ದೇವರಲ್ಲಿ ಸದಾ ಭರವಸವಿಡಿರಿ,</para>
  <para style="q2" vid="ISA 26:4">ಏಕೆಂದರೆ ಯೆಹೋವ ದೇವರು, ಹೌದು ಯೆಹೋವ ದೇವರೇ, ನಿತ್ಯವಾದ ಬಂಡೆಯಾಗಿದ್ದಾರೆ.<verse eid="ISA 26:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 26:5"/>ಅವರು ಎತ್ತರದಲ್ಲಿ ವಾಸಿಸುವವರನ್ನು ಇಳಿಸಿದ್ದಾರೆ.</para>
  <para style="q2" vid="ISA 26:5">ಉನ್ನತದಲ್ಲಿರುವ ಪಟ್ಟಣವನ್ನು ತಗ್ಗಿಸಿದ್ದಾರೆ.</para>
  <para style="q1" vid="ISA 26:5">ಅದನ್ನು ಕೆಡವಿ ನೆಲಸಮಮಾಡಿ</para>
  <para style="q2" vid="ISA 26:5">ಧೂಳಿಗೆ ತಂದಿದ್ದಾರೆ.<verse eid="ISA 26:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 26:6"/>ಕಾಲು, ಬಡವರ ಕಾಲುಗಳೂ,</para>
  <para style="q2" vid="ISA 26:6">ದೀನರ ಪಾದಗಳೂ ಅದನ್ನು ತುಳಿಯುವುವು.<verse eid="ISA 26:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 26:7"/>ನೀತಿವಂತನ ಮಾರ್ಗವು ಸಮಾನವಾಗಿದೆ.</para>
  <para style="q2" vid="ISA 26:7">ನೀನು ಅತ್ಯಧಿಕವಾದ ಯಥಾರ್ಥವಂತನು, ನೀತಿವಂತನ ದಾರಿಯನ್ನು ಸರಿಪಡಿಸಿ ಸಮಮಾಡುತ್ತಿ,<verse eid="ISA 26:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 26:8"/>ಹೌದು, ಯೆಹೋವ ದೇವರೇ, ನಿಮ್ಮ ನ್ಯಾಯತೀರ್ಪಿನ ಮಾರ್ಗದಲ್ಲಿ ನಡೆಯುತ್ತಾ</para>
  <para style="q2" vid="ISA 26:8">ನಾವು ನಿಮಗೋಸ್ಕರ ಕಾದುಕೊಂಡಿದ್ದೇವೆ,</para>
  <para style="q1" vid="ISA 26:8">ನಿಮ್ಮ ನಾಮಸ್ಮರಣೆಯೇ</para>
  <para style="q2" vid="ISA 26:8">ನಮ್ಮ ಹೃದಯದ ಬಯಕೆ.<verse eid="ISA 26:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 26:9"/>ರಾತ್ರಿಯಲ್ಲಿ ನಿಮ್ಮನ್ನು ಮನಃಪೂರ್ವಕವಾಗಿ ಬಯಸಿದ್ದೇನೆ.</para>
  <para style="q2" vid="ISA 26:9">ನನ್ನಲ್ಲಿರುವ ನನ್ನ ಆತ್ಮದೊಂದಿಗೆ ನಿಮ್ಮನ್ನು ಮುಂಜಾನೆಯಲ್ಲಿ ಹುಡುಕುತ್ತಿದ್ದೇನೆ.</para>
  <para style="q1" vid="ISA 26:9">ಏಕೆಂದರೆ ಭೂಮಿಗೆ ನಿಮ್ಮ ನ್ಯಾಯತೀರ್ಪುಗಳು ನಡೆಯುವಾಗಲೇ</para>
  <para style="q2" vid="ISA 26:9">ಭೂಲೋಕದ ನಿವಾಸಿಗಳು ನೀತಿಯನ್ನು ಕಲಿಯುತ್ತಾರೆ.<verse eid="ISA 26:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 26:10"/>ದುಷ್ಟನಿಗೆ ಕನಿಕರ ತೋರಿಸಿದಾಗ್ಯೂ</para>
  <para style="q2" vid="ISA 26:10">ನೀತಿಯನ್ನು ಅವನು ಕಲಿಯಲಾರನು.</para>
  <para style="q1" vid="ISA 26:10">ಯಥಾರ್ಥವಂತನ ದೇಶದಲ್ಲಿ ಅವನು ಅನ್ಯಾಯವನ್ನು ಆಚರಿಸುವನು</para>
  <para style="q2" vid="ISA 26:10">ಮತ್ತು ಯೆಹೋವ ದೇವರ ಮಹತ್ವವನ್ನು ಲಕ್ಷಿಸುವುದಿಲ್ಲ.<verse eid="ISA 26:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 26:11"/>ಯೆಹೋವ ದೇವರೇ, ನಿಮ್ಮ ಕೈ ಮೇಲಕ್ಕೆ ಎತ್ತಲಾಗಿದೆ.</para>
  <para style="q2" vid="ISA 26:11">ಆದರೆ ಅವರು ಅದನ್ನು ಕಾಣುವುದಿಲ್ಲ.</para>
  <para style="q1" vid="ISA 26:11">ನಿಮ್ಮ ಜನರಿಗಾಗಿ ನಿಮ್ಮ ಉತ್ಸಾಹವನ್ನು ಅವರು ನೋಡಲಿ ಮತ್ತು ನಾಚಿಕೆಪಡಲಿ;</para>
  <para style="q2" vid="ISA 26:11">ನಿನ್ನ ವಿರೋಧಿಗಳಿಗಾಗಿದ್ದ ಅಗ್ನಿಯು ಅದನ್ನು ದಹಿಸಿಬಿಡಲಿ.<verse eid="ISA 26:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 26:12"/>ಯೆಹೋವ ದೇವರೇ, ನಮಗೆ ಸಮಾಧಾನವನ್ನು ವಿಧಿಸುವಿರಿ.</para>
  <para style="q2" vid="ISA 26:12">ಏಕೆಂದರೆ ನೀವು ನಮ್ಮ ಕ್ರಿಯೆಗಳನ್ನೆಲ್ಲಾ ನಮಗೋಸ್ಕರ ನಡೆಸಿದ್ದೀರಿ.<verse eid="ISA 26:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="ISA 26:13"/>ಯೆಹೋವ ದೇವರೇ, ನಮ್ಮ ದೇವರೇ,</para>
  <para style="q2" vid="ISA 26:13">ನಿಮ್ಮ ಬದಲು ಬೇರೆ ಒಡೆಯರು ನಮ್ಮ ಮೇಲೆ ದೊರೆತನ ಮಾಡುತ್ತಿದ್ದರು.</para>
  <para style="q2" vid="ISA 26:13">ಆದರೆ ನಿಮ್ಮ ನಾಮವನ್ನು ಮಾತ್ರವೇ ನಾವು ಗೌರವಿಸುವೆವು.<verse eid="ISA 26:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="ISA 26:14"/>ಈಗ ಅವರು ಸತ್ತಿದ್ದಾರೆ, ಅವರು ಬದುಕುವುದಿಲ್ಲ.</para>
  <para style="q2" vid="ISA 26:14">ತೀರಿಹೋದ ಆ ಆತ್ಮಗಳು ಎದ್ದು ಬರುವುದಿಲ್ಲ.</para>
  <para style="q1" vid="ISA 26:14">ನೀವು ಅವರನ್ನು ದಂಡಿಸಿ ಅಳಿಸಿಬಿಟ್ಟಿದ್ದೀರಿ.</para>
  <para style="q2" vid="ISA 26:14">ಅವರ ನೆನಪೇ ಉಳಿಯದ ಹಾಗೆ ಮಾಡಿದ್ದೀರಿ.<verse eid="ISA 26:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="ISA 26:15"/>ಜನಾಂಗವನ್ನು ಹೆಚ್ಚಿಸಿದ್ದೀರಿ.</para>
  <para style="q2" vid="ISA 26:15">ಯೆಹೋವ ದೇವರೇ, ಜನಾಂಗವನ್ನು ಹೆಚ್ಚಿಸಿದ್ದೀರಿ.</para>
  <para style="q1" vid="ISA 26:15">ನೀವು ಮಹಿಮೆ ಹೊಂದಿದ್ದೀರಿ.</para>
  <para style="q2" vid="ISA 26:15">ನೀವು ದೇಶದ ಮೇರೆಗಳನ್ನೆಲ್ಲಾ ಭೂಮಿಯ ಕಟ್ಟಕಡೆಯವರೆಗೂ ವಿಸ್ತರಿಸಿದ್ದೀರಿ.<verse eid="ISA 26:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="ISA 26:16"/>ಯೆಹೋವ ದೇವರೇ, ಇಕ್ಕಟ್ಟಿನಲ್ಲಿ ಅವರು ನಿಮ್ಮನ್ನು ಹುಡುಕಿದರು.</para>
  <para style="q2" vid="ISA 26:16">ನಿಮ್ಮ ಶಿಕ್ಷೆ ಅವರ ಮೇಲಿರುವಾಗ,</para>
  <para style="q2" vid="ISA 26:16">ಅವರು ಪ್ರಾರ್ಥನೆಯನ್ನು ಮಾಡಿದರು.<verse eid="ISA 26:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="ISA 26:17"/>ಗರ್ಭಿಣಿ ಸ್ತ್ರೀಯು ಹೆರುವುದಕ್ಕೆ ಸಮೀಪ ಬಂದಾಗ</para>
  <para style="q2" vid="ISA 26:17">ನೋವಿನಲ್ಲಿದ್ದು ತನ್ನ ಬೇನೆಯಲ್ಲಿ ಅರಚುವಂತೆ,</para>
  <para style="q2" vid="ISA 26:17">ಯೆಹೋವ ದೇವರೇ, ನಾವು ನಿಮ್ಮ ಸಮ್ಮುಖದಲ್ಲಿದ್ದೆವು.<verse eid="ISA 26:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="ISA 26:18"/>ನಾವು ಗರ್ಭಧರಿಸಿ, ವೇದನೆಪಟ್ಟು</para>
  <para style="q2" vid="ISA 26:18">ಗಾಳಿಯನ್ನು ಹೆತ್ತಂತಾಯಿತು.</para>
  <para style="q1" vid="ISA 26:18">ಭೂಮಿಗೆ ನಮ್ಮಿಂದ ಯಾವ ಬಿಡುಗಡೆಯೂ ಆಗಲಿಲ್ಲ.</para>
  <para style="q2" vid="ISA 26:18">ಭೂಲೋಕದ ಜನರಿಗೆ ಜನ್ಮ ಕೊಡಲಿಲ್ಲ.<verse eid="ISA 26:18"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="ISA 26:19"/>ಆದರೆ ಮೃತರಾದ ನಿನ್ನ ಜನರು ಬದುಕುವರು.</para>
  <para style="q2" vid="ISA 26:19">ಅವರ ದೇಹಗಳು ಏಳುವುವು.</para>
  <para style="q1" vid="ISA 26:19">ಧೂಳಿನ ನಿವಾಸಿಗಳೇ,</para>
  <para style="q2" vid="ISA 26:19">ಎಚ್ಚೆತ್ತು ಹರ್ಷಧ್ವನಿಗೈಯಿರಿ!</para>
  <para style="q1" vid="ISA 26:19">ಯೆಹೋವ ದೇವರೇ, ನಿಮ್ಮ ಇಬ್ಬನಿ ಮುಂಜಾನೆಯ ಇಬ್ಬನಿಯಂತಿರುವುದು.</para>
  <para style="q2" vid="ISA 26:19">ಭೂಮಿಯು ಸತ್ತವರನ್ನು ಹೊರಪಡಿಸುವುದು.<verse eid="ISA 26:19"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="20" style="v" sid="ISA 26:20"/>ನನ್ನ ಜನರೇ, ಹೋಗಿರಿ. ನಿಮ್ಮ ಕೋಣೆಗಳಲ್ಲಿ ಸೇರಿ,</para>
  <para style="q2" vid="ISA 26:20">ಬಾಗಿಲನ್ನು ಮುಚ್ಚಿಕೊಳ್ಳಿರಿ.</para>
  <para style="q1" vid="ISA 26:20">ಸ್ವಲ್ಪ ಹೊತ್ತು ರೋಷವು</para>
  <para style="q2" vid="ISA 26:20">ಹಾದುಹೋಗುವ ತನಕ ಅಡಗಿಕೊಂಡಿರಿ.<verse eid="ISA 26:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="ISA 26:21"/>ಭೂನಿವಾಸಿಗಳ ದುಷ್ಕೃತ್ಯಕ್ಕೆ ಶಿಕ್ಷಿಸುವುದಕ್ಕೆ</para>
  <para style="q2" vid="ISA 26:21">ಯೆಹೋವ ದೇವರು ತಮ್ಮ ಸ್ಥಳದಿಂದ ಹೊರಟಿದ್ದಾರೆ.</para>
  <para style="q1" vid="ISA 26:21">ಭೂಮಿಯು ಸಹ ತನ್ನಲ್ಲಿ ಕೊಂದುಹಾಕಿದವರನ್ನು ಇನ್ನು ಮುಚ್ಚಿಕೊಳ್ಳದೆ,</para>
  <para style="q2" vid="ISA 26:21">ತನ್ನಲ್ಲಿರುವ ರಕ್ತಾಪರಾಧವನ್ನು ಪ್ರಕಟ ಮಾಡುವುದು.<verse eid="ISA 26:21"/></para>
  <chapter eid="ISA 26"/>
  <chapter number="27" style="c" sid="ISA 27"/>
  <para style="s1">ಇಸ್ರಾಯೇಲರ ಬಿಡುಗಡೆ</para>
  <para style="p">
    <verse number="1" style="v" sid="ISA 27:1"/>ಆ ದಿನದಲ್ಲಿ ಯೆಹೋವ ದೇವರು,</para>
  <para style="q1" vid="ISA 27:1">ತಮ್ಮ ಬಲವಾದ ಭೀಕರ ಖಡ್ಗದಿಂದ</para>
  <para style="q2" vid="ISA 27:1">ವೇಗವಾಗಿ ಓಡುವ ಲೆವಿಯಾತಾನ ಸರ್ಪವನ್ನೂ,</para>
  <para style="q1" vid="ISA 27:1">ಡೊಂಕಾಗಿ ಹರಿಯುವ ಲೆವಿಯಾತಾನ ಸರ್ಪವನ್ನೂ ದಂಡಿಸಿ,</para>
  <para style="q2" vid="ISA 27:1">ಸಮುದ್ರದಲ್ಲಿರುವ ಘಟಸರ್ಪವನ್ನೂ ಕೊಂದುಹಾಕುವರು.<verse eid="ISA 27:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="ISA 27:2"/>ಆ ದಿನದಲ್ಲಿ,</para>
  <para style="q1" vid="ISA 27:2">ಫಲಭರಿತ ದ್ರಾಕ್ಷಿತೋಟದ ವಿಷಯವಾಗಿ ಹಾಡಿರಿ.<verse eid="ISA 27:2"/></para>
  <para style="q2">
    <verse number="3" style="v" sid="ISA 27:3"/>ಯೆಹೋವ ದೇವರಾದ ನಾನೇ ಅದನ್ನು ಕಾಯುತ್ತೇನೆ.</para>
  <para style="q2" vid="ISA 27:3">ಸತತವಾಗಿ ಅದಕ್ಕೆ ನೀರು ಹೊಯ್ಯುತ್ತಿದ್ದೇನೆ.</para>
  <para style="q1" vid="ISA 27:3">ಯಾರೂ ಅದಕ್ಕೆ ಕೇಡು ಮಾಡದ ಹಾಗೆ</para>
  <para style="q2" vid="ISA 27:3">ರಾತ್ರಿ ಹಗಲು ಅದನ್ನು ಕಾಯುತ್ತೇನೆ.<verse eid="ISA 27:3"/></para>
  <para style="q2">
    <verse number="4" style="v" sid="ISA 27:4"/>ರೌದ್ರವು ನನ್ನಲ್ಲಿ ಇಲ್ಲ.</para>
  <para style="q1" vid="ISA 27:4">ಯಾವನಾದರೂ ಮುಳ್ಳು ದತ್ತೂರಿಗಳನ್ನು</para>
  <para style="q2" vid="ISA 27:4">ನನಗೆ ವಿರೋಧವಾಗಿ ಯುದ್ಧಕ್ಕೆ ಇಟ್ಟರೆ,</para>
  <para style="q2" vid="ISA 27:4">ನಾನು ಅವುಗಳನ್ನು ಹಾದು ಹೋಗಿ, ಅವುಗಳನ್ನು ಒಟ್ಟಿಗೆ ಸುಡುವೆನು.<verse eid="ISA 27:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 27:5"/>ಇಲ್ಲದಿದ್ದರೆ ಅವರು ನನ್ನ ಸಂಗಡ ಸಮಾಧಾನಮಾಡಿಕೊಳ್ಳುವ</para>
  <para style="q2" vid="ISA 27:5">ಹಾಗೆ ನನ್ನನ್ನು ಆಶ್ರಯಿಸಲಿ,</para>
  <para style="q2" vid="ISA 27:5">ನನ್ನೊಡನೆ ಸಮಾಧಾನ ಮಾಡಿಕೊಳ್ಳಲಿ.<verse eid="ISA 27:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 27:6"/>ಮುಂದಿನ ಕಾಲದಲ್ಲಿ ಯಾಕೋಬು ಬೇರೂರುವುದು.</para>
  <para style="q2" vid="ISA 27:6">ಇಸ್ರಾಯೇಲು ಹೂ ಅರಳಿ ಚಿಗುರುವುದು.</para>
  <para style="q2" vid="ISA 27:6">ಭೂಲೋಕವನ್ನೆಲ್ಲಾ ಫಲದಿಂದ ತುಂಬಿಸುವನು.<verse eid="ISA 27:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 27:7"/>ಆಕೆಯನ್ನು ಹೊಡೆದವರನ್ನು ಆತನು ಹೊಡೆದಂತೆ</para>
  <para style="q2" vid="ISA 27:7">ಯೆಹೋವ ದೇವರು ಆಕೆಯನ್ನು ಹೊಡೆದರೋ?</para>
  <para style="q1" vid="ISA 27:7">ಆಕೆಯನ್ನು ಕೊಂದವರು ಹತರಾದಂತೆ</para>
  <para style="q2" vid="ISA 27:7">ಆಕೆಯು ಸಂಹಾರವಾದಳೋ?<verse eid="ISA 27:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 27:8"/>ಯುದ್ಧದಿಂದಲೂ ಸೆರೆಯಿಂದಲೂ ಆಕೆಯೊಂದಿಗೆ ತೃಪ್ತರಾಗಿರಿ.</para>
  <para style="q2" vid="ISA 27:8">ಆತನು ತನ್ನ ಕೋಪದ ಪೆಟ್ಟಿನಿಂದ ಪೂರ್ವದ ಬಿರುಗಾಳಿ ಬೀಸುವಾಗ ಆಗುವಂತೆ,</para>
  <para style="q2" vid="ISA 27:8">ಆಕೆಯನ್ನು ಹೊರಗೋಡಿಸುವನು.<verse eid="ISA 27:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 27:9"/>ಹೀಗಿರುವದರಿಂದ ಯಾಕೋಬನು ಬಲಿಪೀಠಗಳ ಕಲ್ಲುಗಳನ್ನೆಲ್ಲಾ ಸುಣ್ಣದಂತೆ ಪುಡಿಪುಡಿಮಾಡಿ,</para>
  <para style="q2" vid="ISA 27:9">ಅಶೇರ ಸ್ತಂಭಗಳನ್ನೂ ಧೂಪವೇದಿಗಳನ್ನೂ ಇನ್ನು ಪ್ರತಿಷ್ಠಾಪಿಸದೆ ಹೋದರೆ</para>
  <para style="q1" vid="ISA 27:9">ಅದೇ ಯಾಕೋಬನ ಅಪರಾಧಕ್ಕೆ ಪ್ರಾಯಶ್ಚಿತ್ತವಾಗುವುದು</para>
  <para style="q2" vid="ISA 27:9">ಮತ್ತು ಅವನ ಪಾಪಪರಿಹಾರವನ್ನು ಸೂಚಿಸುವ ಪೂರ್ಣಫಲವು ಇದೇ ಆಗಿದೆ.<verse eid="ISA 27:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 27:10"/>ಕೋಟೆಯ ಪಟ್ಟಣವು ಹಾಳಾಗಿ ಕಾಡಿನಂತೆ</para>
  <para style="q2" vid="ISA 27:10">ಜನರಿಲ್ಲದೆ ಶೂನ್ಯ ನಿವಾಸ ಸ್ಥಾನವಾಗುವುದು.</para>
  <para style="q1" vid="ISA 27:10">ಅಲ್ಲಿ ದನಕರುಗಳು ಮೇದು ಮಲಗುವ ಗೋಮಾಳವಾಗಿದೆ.</para>
  <para style="q2" vid="ISA 27:10">ಅವು ಅಲ್ಲಿನ ಚಿಗುರುಗಳನ್ನು ತಿಂದುಬಿಡುವುವು.<verse eid="ISA 27:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 27:11"/>ಅಲ್ಲಿನ ರೆಂಬೆಗಳು ಒಣಗಿ ಮುರಿದುಹೋಗಿವೆ.</para>
  <para style="q2" vid="ISA 27:11">ಸ್ತ್ರೀಯರು ಬಂದು ಅವುಗಳಿಂದ ಬೆಂಕಿ ಹಚ್ಚಿ ಉರಿಸುವರು.</para>
  <para style="q1" vid="ISA 27:11">ಏಕೆಂದರೆ ಇದು ವಿವೇಕವಿಲ್ಲದ ಜನ.</para>
  <para style="q2" vid="ISA 27:11">ಆದ್ದರಿಂದ ಅವರನ್ನು ಮಾಡಿದವನು ಅವರಿಗೆ ಕನಿಕರ ತೋರಿಸುವುದಿಲ್ಲ.</para>
  <para style="q2" vid="ISA 27:11">ಅವರ ಸೃಷ್ಟಿಕರ್ತನು ಅವರನ್ನು ಕರುಣಿಸುವುದಿಲ್ಲ.<verse eid="ISA 27:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="ISA 27:12"/>ಇಸ್ರಾಯೇಲರೇ, ಯೆಹೋವ ದೇವರು ಯೂಫ್ರೇಟೀಸ್ ನದಿ ಮೊದಲುಗೊಂಡು ಈಜಿಪ್ಟ್ ದೇಶದ ನದಿಯವರೆಗೆ ಹೊಡೆಯುವರು, ಆಗ ನಿಮ್ಮನ್ನು ಒಬ್ಬೊಬ್ಬರನ್ನಾಗಿ ಕೂಡಿಸುವರು. <verse eid="ISA 27:12"/><verse number="13" style="v" sid="ISA 27:13"/>ಆ ದಿನದಲ್ಲಿ ದೊಡ್ಡ ತುತೂರಿಯು ಊದಲಾಗುವುದು. ಆಗ ಅಸ್ಸೀರಿಯ ದೇಶದಲ್ಲಿ ಚದರಿಹೋದವರೂ, ಈಜಿಪ್ಟ್ ದೇಶದಲ್ಲಿ ಗಡೀಪಾರಾದವರೂ, ಯೆರೂಸಲೇಮಿನ ಪರಿಶುದ್ಧ ಪರ್ವತದ ಬಳಿಗೆ ಬಂದು ಯೆಹೋವ ದೇವರನ್ನು ಆರಾಧಿಸುವರು.<verse eid="ISA 27:13"/></para>
  <chapter eid="ISA 27"/>
  <chapter number="28" style="c" sid="ISA 28"/>
  <para style="s1">ಎಫ್ರಾಯೀಮ್ ಮತ್ತು ಯೆಹೂದದ ನಾಯಕರಿಗೆ ಕಷ್ಟ</para>
  <para style="q1">
    <verse number="1" style="v" sid="ISA 28:1"/>ಕುಡುಕರಿಂದ ಕೂಡಿದ ಎಫ್ರಾಯೀಮಿನ ಕಿರೀಟದಂತಿರುವ ನಗರಕ್ಕೆ ಕಷ್ಟ!</para>
  <para style="q2" vid="ISA 28:1">ಒಮ್ಮೆ ಕುಡಿತಕ್ಕೆ ಸೋತು ಫಲವತ್ತಾದ</para>
  <para style="q1" vid="ISA 28:1">ಕಣಿವೆಗೆ ಶ್ರೇಷ್ಠ ಶಿರೋಭೂಷಣವಾಗಿದ್ದು,</para>
  <para style="q2" vid="ISA 28:1">ಈಗ ಬಾಡಿಹೋಗುತ್ತಿರುವ ಆ ಹೂವಿಗೆ ಕಷ್ಟ!<verse eid="ISA 28:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 28:2"/>ಇಗೋ, ಕರ್ತರಿಗೆ ಒಬ್ಬ ಮಹಾ ಬಲಿಷ್ಠನು ಇದ್ದಾನೆ.</para>
  <para style="q2" vid="ISA 28:2">ಅವನು ರಭಸವಾಗಿ ಸುರಿಯುವ ಕಲ್ಮಳೆಯಂತೆಯೂ,</para>
  <para style="q1" vid="ISA 28:2">ಹೊಡೆದು ಬಿಡುವ ಬಿರುಗಾಳಿಯಂತೆಯೂ, ಪ್ರಳಯ ಮಾಡುವ</para>
  <para style="q2" vid="ISA 28:2">ದೊಡ್ಡ ನೀರನ್ನು ತರುವ ಬಿರುಗಾಳಿಯಂತೆಯೂ ಅದನ್ನು ಕೈಯಿಂದ ಬೀಳಿಸುವನು.<verse eid="ISA 28:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 28:3"/>ಕುಡುಕರಾದ ಎಫ್ರಾಯೀಮ್ಯರ ಗರ್ವದ ಕಿರೀಟವು</para>
  <para style="q2" vid="ISA 28:3">ಕಾಲಿನ ತುಳಿತಕ್ಕೆ ಈಡಾಗುವುದು.<verse eid="ISA 28:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 28:4"/>ಫಲವತ್ತಾದ ಕಣಿವೆಗೆ ತಲೆಯ ಮೇಲಿರುವ</para>
  <para style="q2" vid="ISA 28:4">ಅಲಂಕಾರದ ಶೃಂಗಾರವಾಗಿದ್ದು,</para>
  <para style="q1" vid="ISA 28:4">ಬೇಸಿಗೆ ಮುಂಚೆ ಮಾಗಿದ ಅಂಜೂರದ ಹಣ್ಣಿನ ಹಾಗೆ ಇರುವುದು.</para>
  <para style="q2" vid="ISA 28:4">ಜನರು ಅವರನ್ನು ನೋಡಿ ಕೈಗೆ ತೆಗೆದುಕೊಂಡ ತಕ್ಷಣ</para>
  <para style="q2" vid="ISA 28:4">ಅವರು ನುಂಗುತ್ತಾರೆ.<verse eid="ISA 28:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 28:5"/>ಆ ದಿನದಲ್ಲಿ ಸೇನಾಧೀಶ್ವರ ಯೆಹೋವ ದೇವರು</para>
  <para style="q2" vid="ISA 28:5">ತನ್ನ ಜನರಲ್ಲಿ ಉಳಿದವರಿಗೆ</para>
  <para style="q1" vid="ISA 28:5">ಮಹಿಮೆಯ ಕಿರೀಟವೂ</para>
  <para style="q2" vid="ISA 28:5">ಮತ್ತು ಸುಂದರವಾದ ಮಕುಟವೂ ಆಗಿರುವರು.<verse eid="ISA 28:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 28:6"/>ನ್ಯಾಯಕ್ಕೋಸ್ಕರ ಕೂತುಕೊಂಡವನಿಗೆ</para>
  <para style="q2" vid="ISA 28:6">ನ್ಯಾಯದ ಆತ್ಮವೂ,</para>
  <para style="q1" vid="ISA 28:6">ಬಾಗಿಲಿನ ಕಡೆಗೆ ಯುದ್ಧವನ್ನು ತಿರುಗಿಸುವವನಿಗೆ</para>
  <para style="q2" vid="ISA 28:6">ಪರಾಕ್ರಮವೂ ಆಗಿರುವನು.<verse eid="ISA 28:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 28:7"/>ಇವರು ಸಹ ದ್ರಾಕ್ಷಾರಸದಿಂದ ಮತ್ತರಾಗಿದ್ದಾರೆ.</para>
  <para style="q2" vid="ISA 28:7">ಮದ್ಯದಿಂದಲೂ ಓಲಾಡುತ್ತಿದ್ದಾರೆ.</para>
  <para style="q1" vid="ISA 28:7">ಯಾಜಕನೂ ಪ್ರವಾದಿಯೂ ಮದ್ಯದಿಂದ ಮತ್ತರಾಗಿದ್ದಾರೆ.</para>
  <para style="q2" vid="ISA 28:7">ದ್ರಾಕ್ಷಾರಸದಿಂದ ತೂರಾಡುತ್ತಿದ್ದಾರೆ.</para>
  <para style="q1" vid="ISA 28:7">ಮದ್ಯದಿಂದ ಓಲಾಡುತ್ತಿದ್ದಾರೆ.</para>
  <para style="q2" vid="ISA 28:7">ದರ್ಶನವಾಗುತ್ತಿರುವಾಗಲೂ ಅವರು ತಪ್ಪುತ್ತಾರೆ.</para>
  <para style="q2" vid="ISA 28:7">ನ್ಯಾಯತೀರ್ವಿಕೆಯಲ್ಲಿ ತತ್ತರಿಸುತ್ತಾರೆ.<verse eid="ISA 28:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 28:8"/>ಮೇಜುಗಳೆಲ್ಲಾ ಸ್ಥಳ ಉಳಿಯದ ಹಾಗೆ ಅಸಹ್ಯವಾದ</para>
  <para style="q2" vid="ISA 28:8">ಕಕ್ಕುವಿಕೆಯಿಂದ ತುಂಬಿವೆ.<verse eid="ISA 28:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 28:9"/>ಈತನು ಯಾರಿಗೆ ಜ್ಞಾನವನ್ನು ಬೋಧಿಸುತ್ತಾನೆ?</para>
  <para style="q2" vid="ISA 28:9">ಮತ್ತು ಯಾರಿಗೆ ಬೋಧನೆಯನ್ನು ತಿಳಿದುಕೊಳ್ಳುವ ಹಾಗೆ ಮಾಡುತ್ತಾನೆ?</para>
  <para style="q1" vid="ISA 28:9">ಆಗತಾನೇ ಹಾಲು ಬಿಟ್ಟ</para>
  <para style="q2" vid="ISA 28:9">ಕೂಸುಗಳಿಗೋ, ಎಳೆಯ ಮಕ್ಕಳಿಗೋ?<verse eid="ISA 28:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 28:10"/>ಆಜ್ಞೆಯ ಮೇಲೆ ಆಜ್ಞೆ,</para>
  <para style="q2" vid="ISA 28:10">ಸೂತ್ರದ ಮೇಲೆ ಸೂತ್ರ,</para>
  <para style="q2" vid="ISA 28:10">ಅಲ್ಲಿ ಸ್ವಲ್ಪ, ಇಲ್ಲಿ ಸ್ವಲ್ಪ.<verse eid="ISA 28:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 28:11"/>ತೊದಲು ಮಾತಿನವರು, ಅನ್ಯಭಾಷಿಗಳು ಇವರ ಮೂಲಕವಾಗಿಯೇ</para>
  <para style="q2" vid="ISA 28:11">ಆತನು ಈ ಜನರೊಡನೆ ಮಾತನಾಡುತ್ತಾನೆ.<verse eid="ISA 28:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 28:12"/>ಆತನು ಮೊದಲು,</para>
  <para style="q2" vid="ISA 28:12">“ಇದೇ ನಿಮಗೆ ಅವಶ್ಯಕವಾದ ವಿಶ್ರಾಂತಿ, ಬಳಲಿದವರನ್ನು ವಿಶ್ರಮಗೊಳಿಸಿರಿ.</para>
  <para style="q1" vid="ISA 28:12">ನಿಮಗೆ ಅನುಕೂಲವಾದ ಉಪಶಮನ ಇದೇ,”</para>
  <para style="q2" vid="ISA 28:12">ಎಂದು ಹೇಳಿದಾಗಲೂ ಅವರು ಕೇಳಲಿಲ್ಲ.<verse eid="ISA 28:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="ISA 28:13"/>ಆಗ ಯೆಹೋವ ದೇವರು ಅವರಿಗೆ ಹೀಗೆ ಹೇಳಿದರು:</para>
  <para style="q2" vid="ISA 28:13">ಆಜ್ಞೆಯ ಮೇಲೆ ಆಜ್ಞೆ, ಆಜ್ಞೆಯ ಮೇಲೆ ಆಜ್ಞೆ,</para>
  <para style="q2" vid="ISA 28:13">ಸೂತ್ರದ ಮೇಲೆ ಸೂತ್ರ, ಸೂತ್ರದ ಮೇಲೆ ಸೂತ್ರ,</para>
  <para style="q2" vid="ISA 28:13">ಇಲ್ಲಿ ಸ್ವಲ್ಪ, ಅಲ್ಲಿ ಸ್ವಲ್ಪ</para>
  <para style="q1" vid="ISA 28:13">ಇದರಿಂದ ಅವರು ಎಡವಿಬಿದ್ದು ಗಾಯಗೊಳ್ಳಬಹುದು.</para>
  <para style="q2" vid="ISA 28:13">ಮತ್ತು ಬಲೆಯಲ್ಲಿ ಸಿಕ್ಕಿ ಬೀಳುವರು.<verse eid="ISA 28:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="ISA 28:14"/>ಆದಕಾರಣ ಯೆರೂಸಲೇಮಿನಲ್ಲಿರುವ ಈ ಜನರನ್ನು ಆಳುವ</para>
  <para style="q2" vid="ISA 28:14">ಹಾಸ್ಯದ ಜನರಾದ ನೀವು ಯೆಹೋವ ದೇವರ ಮಾತನ್ನು ಕೇಳಿರಿ.<verse eid="ISA 28:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="ISA 28:15"/>“ಮರಣದ ಸಂಗಡ ಒಡಂಬಡಿಕೆಯನ್ನು ಮಾಡಿದ್ದೇವೆ.</para>
  <para style="q2" vid="ISA 28:15">ಪಾತಾಳದ ಸಂಗಡ ಒಪ್ಪಂದ ಮಾಡಿಕೊಂಡಿದ್ದೇವೆ.</para>
  <para style="q1" vid="ISA 28:15">ವಿಪರೀತವಾದ ಶಿಕ್ಷೆಯು ಹಾದುಹೋಗುವಾಗ,</para>
  <para style="q2" vid="ISA 28:15">ಅದು ನಮ್ಮನ್ನು ಮುಟ್ಟದು;</para>
  <para style="q1" vid="ISA 28:15">ನಮ್ಮ ಅಸತ್ಯವನ್ನು ಆಶ್ರಯವಾಗಿ ಮಾಡಿಕೊಂಡು,</para>
  <para style="q2" vid="ISA 28:15">ಮೋಸದಲ್ಲಿ ಅಡಗಿಕೊಂಡಿದ್ದೇವೆ,” ಎನ್ನುತ್ತೀರಲ್ಲಾ?<verse eid="ISA 28:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="ISA 28:16"/>ಆದ್ದರಿಂದ ಸಾರ್ವಭೌಮ ಯೆಹೋವ ದೇವರು ಹೀಗೆ ಹೇಳುತ್ತಾರೆ:</para>
  <para style="q1" vid="ISA 28:16">“ಇಗೋ, ಪರೀಕ್ಷಿತವಾಗಿಯೂ, ಅಮೂಲ್ಯವಾಗಿಯೂ ಇರುವ</para>
  <para style="q2" vid="ISA 28:16">ಮೂಲೆಗಲ್ಲನ್ನು ಚೀಯೋನಿನಲ್ಲಿ</para>
  <para style="q1" vid="ISA 28:16">ಸ್ಥಿರವಾದ ಅಸ್ತಿವಾರವನ್ನಾಗಿ ಇಡುತ್ತೇನೆ.</para>
  <para style="q2" vid="ISA 28:16">ಭರವಸೆ ಇಡುವವನು ಆತುರಪಡನು.<verse eid="ISA 28:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="ISA 28:17"/>ನಾನು ನ್ಯಾಯವನ್ನು ಅಳತೆಗೋಲನ್ನಾಗಿಯೂ</para>
  <para style="q2" vid="ISA 28:17">ಮತ್ತು ನೀತಿಯನ್ನು ಮಟ್ಟಗೋಲನ್ನಾಗಿಯೂ ಮಾಡುವೆನು.</para>
  <para style="q1" vid="ISA 28:17">ಕಲ್ಮಳೆಯು ಸುಳ್ಳಿನ ಆಶ್ರಯವನ್ನು ಬಡಿದುಕೊಂಡು ಹೋಗುವುದು.</para>
  <para style="q2" vid="ISA 28:17">ಅಡಗುವ ಸ್ಥಾನವನ್ನು ಜಲಪ್ರವಾಹವು ಮುಳುಗಿಸಿ ಬಿಡುವುದು.<verse eid="ISA 28:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="ISA 28:18"/>ಮರಣದೊಂದಿಗೆ ನೀವು ಮಾಡಿಕೊಂಡ ಒಡಂಬಡಿಕೆ ರದ್ದಾಗುವುದು.</para>
  <para style="q2" vid="ISA 28:18">ಪಾತಾಳದ ಸಂಗಡ ನೀವು ಮಾಡಿಕೊಂಡ ಒಪ್ಪಂದವು ನಿಲ್ಲುವುದಿಲ್ಲ.</para>
  <para style="q1" vid="ISA 28:18">ವಿಪರೀತ ಬಾಧೆಯು ಹಾದುಹೋಗುವಾಗ</para>
  <para style="q2" vid="ISA 28:18">ನಿಮ್ಮನ್ನು ತುಳಿದುಹಾಕುವುದು.<verse eid="ISA 28:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="ISA 28:19"/>ಅದು ಹಾದುಹೋಗುವಾಗೆಲ್ಲಾ ನಿಮ್ಮನ್ನು ಹಿಡಿಯುವುದು.</para>
  <para style="q2" vid="ISA 28:19">ಏಕೆಂದರೆ ಅದು ಹೊತ್ತಾರೆಯಿಂದ ಹೊತ್ತಾರೆಗೆ,</para>
  <para style="q2" vid="ISA 28:19">ಹಗಲು ರಾತ್ರಿಯೂ ಹಾದುಹೋಗುವುದು.”</para>
  <para style="b" vid="ISA 28:19"/>
  <para style="q1" vid="ISA 28:19">ಆಗ ದೇವರ ಈ ಸಂದೇಶವನ್ನು ಅರ್ಥಮಾಡಿಕೊಳ್ಳುವವರಿಗೆ</para>
  <para style="q2" vid="ISA 28:19">ಭಯಭ್ರಾಂತಿ ಉಂಟಾಗುವುದು.<verse eid="ISA 28:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="ISA 28:20"/>ಮೈ ಚಾಚುವುದಕ್ಕೆ ಹಾಸಿಗೆ ಚಿಕ್ಕದಾಗಿರುವುದು.</para>
  <para style="q2" vid="ISA 28:20">ಮುದುರಿಕೊಂಡು ಮಲಗುವುದಕ್ಕೆ, ಹೊದಿಕೆಯ ಅಗಲ ಸಾಲದು.<verse eid="ISA 28:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="ISA 28:21"/>ಯೆಹೋವ ದೇವರು ಪೆರಾಚೀಮ್ ಪರ್ವತದಲ್ಲಿ ಎದ್ದಂತೆ ಏಳುವರು.</para>
  <para style="q2" vid="ISA 28:21">ಹಾಗೆ ಎದ್ದು ಗಿಬ್ಯೋನ್ ತಗ್ಗಿನಲ್ಲಿ ಆದ ಹಾಗೆ ಕೋಪಿಸಿ,</para>
  <para style="q1" vid="ISA 28:21">ಅಪರೂಪವಾದ ತಮ್ಮ ಕೆಲಸವನ್ನು ನಡಿಸಿ,</para>
  <para style="q2" vid="ISA 28:21">ಅಪೂರ್ವವಾದ ತಮ್ಮ ಕಾರ್ಯವನ್ನು ನೆರವೇರಿಸುವನು.<verse eid="ISA 28:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="ISA 28:22"/>ಹೀಗಿರುವುದರಿಂದ ನಿಮ್ಮ ಬಂಧನಗಳು ಬಿಗಿಯಾಗದಂತೆ ಹಾಸ್ಯಗಾರರಾಗಬೇಡಿರಿ.</para>
  <para style="q2" vid="ISA 28:22">ಸರ್ವಶಕ್ತ ಆಗಿರುವ ಕರ್ತ ಯೆಹೋವ ದೇವರ ಕಡೆಯಿಂದ</para>
  <para style="q2" vid="ISA 28:22">ಭೂಮಂಡಲದಲ್ಲೆಲ್ಲಾ ಸಂಹಾರ ತರಲು ನಿರ್ಣಯಿಸಿದೆ, ಎಂಬ ತೀರ್ಪನ್ನು ನಾನು ಕೇಳಿದ್ದೇನೆ.<verse eid="ISA 28:22"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="23" style="v" sid="ISA 28:23"/>ನನ್ನ ಧ್ವನಿಗೆ ಕಿವಿಗೊಟ್ಟು ಕೇಳಿರಿ,</para>
  <para style="q2" vid="ISA 28:23">ನನ್ನ ಮಾತಿಗೆ ಗಮನವಿಟ್ಟು ಆಲಿಸಿರಿ.<verse eid="ISA 28:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="ISA 28:24"/>ಬಿತ್ತನೆಗಾಗಿ ಉಳುವವನು ಹಗಲೆಲ್ಲಾ ಉಳುತ್ತಿರುವನೋ?</para>
  <para style="q2" vid="ISA 28:24">ತನ್ನ ಭೂಮಿಯ ಮಣ್ಣುಹೆಂಟೆಯನ್ನು ತೆಗೆದು, ದಿನವೆಲ್ಲಾ ಹೊಡೆಯುವನೋ?<verse eid="ISA 28:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="ISA 28:25"/>ಅದರ ಮೇಲ್ಭಾಗವನ್ನು ಹಸನು ಮಾಡಿದ ಮೇಲೆ</para>
  <para style="q2" vid="ISA 28:25">ಅಗಸೆಯನ್ನು ಚೆಲ್ಲಿ, ಜೀರಿಗೆಯನ್ನು ಚದರಿಸಿ</para>
  <para style="q1" vid="ISA 28:25">ಮತ್ತು ಗೋಧಿಯನ್ನು ಸಾಲುಸಾಲಾಗಿಯೂ,</para>
  <para style="q2" vid="ISA 28:25">ಜವೆಗೋಧಿಯನ್ನು ನೇಮಕವಾದ ಸ್ಥಳದಲ್ಲಿಯೂ,</para>
  <para style="q2" vid="ISA 28:25">ಕಡಲೆಯನ್ನು ಅಂಚಿನಲ್ಲಿಯೂ ಹಾಕುವನಲ್ಲವೇ.<verse eid="ISA 28:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="ISA 28:26"/>ಏಕೆಂದರೆ ಅವನ ದೇವರು ಅವನಿಗೆ ಸೂಚಿಸುತ್ತಾರೆ.</para>
  <para style="q2" vid="ISA 28:26">ಮತ್ತು ಸರಿಯಾದ ಮಾರ್ಗವನ್ನು ಕಲಿಸುತ್ತಾರೆ.<verse eid="ISA 28:26"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="27" style="v" sid="ISA 28:27"/>ಅಗಸೆಯನ್ನು ತುಳಿಯುವ ಯಂತ್ರದಿಂದ ತುಳಿಯುವುದಿಲ್ಲ.</para>
  <para style="q2" vid="ISA 28:27">ಜೀರಿಗೆಯನ್ನು ಒಕ್ಕುವುದು ಬಂಡಿಯ ಚಕ್ರ ತಿರುಗಿಸುವುದರಿಂದ ಅಲ್ಲ.</para>
  <para style="q1" vid="ISA 28:27">ಅಗಸೆಯು ಕೋಲಿನಿಂದಲೂ,</para>
  <para style="q2" vid="ISA 28:27">ಜೀರಿಗೆಯನ್ನು ಒಕ್ಕುವುದು ದೊಣ್ಣೆಯಿಂದ ಆಗಿರುತ್ತದೆ.<verse eid="ISA 28:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="ISA 28:28"/>ರೊಟ್ಟಿಗಾಗಿ ಗೋಧಿಯ ಕಾಳನ್ನು ಪುಡಿಮಾಡಬೇಕು;</para>
  <para style="q2" vid="ISA 28:28">ಯಾವಾಗಲೂ ಅದನ್ನು ಒಕ್ಕುತ್ತಿರುವುದಿಲ್ಲ.</para>
  <para style="q1" vid="ISA 28:28">ಅವನ ಬಂಡಿಯ ಚಕ್ರದಿಂದ ಅದರ ಮೇಲೆ ಒಡೆಯುವುದಿಲ್ಲ</para>
  <para style="q2" vid="ISA 28:28">ಅವನ ಕುದುರೆ ಸವಾರದಿಂದ ಒಕ್ಕುತ್ತಿರುವುದಿಲ್ಲ.<verse eid="ISA 28:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="ISA 28:29"/>ಈ ವಿವೇಕವು ಸಹ ಅತಿಶಯ ಆಲೋಚನಾಪರರೂ,</para>
  <para style="q2" vid="ISA 28:29">ಕಾರ್ಯಸಾಧಕ ಜ್ಞಾನ ಶ್ರೇಷ್ಠರೂ ಆಗಿರುವ</para>
  <para style="q2" vid="ISA 28:29">ಸೇನಾಧೀಶ್ವರ ಯೆಹೋವ ದೇವರಿಂದಲೇ ಹೊರಡುತ್ತದೆ.<verse eid="ISA 28:29"/></para>
  <chapter eid="ISA 28"/>
  <chapter number="29" style="c" sid="ISA 29"/>
  <para style="s1">ದಾವೀದನ ಪಟ್ಟಣಕ್ಕೆ ಕಷ್ಟ</para>
  <para style="q1">
    <verse number="1" style="v" sid="ISA 29:1"/>ಅಯ್ಯೋ, ಅರೀಯೇಲೇ, ಅರೀಯೇಲೇ,</para>
  <para style="q2" vid="ISA 29:1">ದಾವೀದನು ವಾಸಿಸಿದ ಪಟ್ಟಣವೇ!</para>
  <para style="q1" vid="ISA 29:1">ವರುಷಕ್ಕೆ ವರುಷವನ್ನು ಕೂಡಿಸಿರಿ.</para>
  <para style="q2" vid="ISA 29:1">ನಿಮ್ಮ ಹಬ್ಬಗಳ ಚಕ್ರ ಮುಂದುವರಿಯಲಿ.<verse eid="ISA 29:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 29:2"/>ಆದಾಗ್ಯೂ ನಾನು ಅರೀಯೇಲಿಗೆ ಇಕ್ಕಟ್ಟನ್ನು ಉಂಟುಮಾಡುವೆನು.</para>
  <para style="q2" vid="ISA 29:2">ಅಲ್ಲಿ ಕಷ್ಟವೂ, ದುಃಖವೂ ಇರುವುದು.</para>
  <para style="q2" vid="ISA 29:2">ಅವಳು ನನಗೆ ಬಲಿಪೀಠದ ಒಲೆಯಂತೆ ಇರುತ್ತಾಳೆ.<verse eid="ISA 29:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 29:3"/>ಸುತ್ತಲೂ ದಂಡಿಳಿಸಿ ನಿನಗೆ ವಿರುದ್ಧವಾಗಿ ಕೋಟೆಗಳನ್ನು ಎಬ್ಬಿಸಿ,</para>
  <para style="q2" vid="ISA 29:3">ದಿಬ್ಬ ಹಾಕಿ ನಿನ್ನ ಮೇಲೆ ಮುತ್ತಿಗೆ ಹಾಕುವೆನು.<verse eid="ISA 29:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 29:4"/>ಆಗ ನೀನು ಕುಗ್ಗಿ ಭೂಮಿಯೊಳಗಿಂದ ಮಾತನಾಡುವಿ.</para>
  <para style="q2" vid="ISA 29:4">ನಿನ್ನ ನುಡಿಯು ಧೂಳಿನೊಳಗಿಂದ ಸಣ್ಣ ಸ್ವರವಾಗಿ ಹೊರಡುವುದು.</para>
  <para style="q1" vid="ISA 29:4">ನಿನ್ನ ಸ್ವರವು ಭೂತದ ಹಾಗೆ ನೆಲದೊಳಗಿಂದ ಬರುವುದು.</para>
  <para style="q2" vid="ISA 29:4">ನಿನ್ನ ನುಡಿಯು ಧೂಳಿನೊಳಗಿಂದ ಪಿಸುಗುಟ್ಟುವುದು.<verse eid="ISA 29:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 29:5"/>ಅದೂ ಅಲ್ಲದೆ ನಿನ್ನ ವೈರಿಗಳ ಗುಂಪು ಸೂಕ್ಷ್ಮವಾದ ಧೂಳಿನಂತಾಗುವುದು.</para>
  <para style="q2" vid="ISA 29:5">ಭಯಂಕರವಾದ ಸಮೂಹವು ಹಾರಿಹೋಗುವ ಹೊಟ್ಟಿನ ಹಾಗೆ ಇರುವುದು.</para>
  <para style="q1" vid="ISA 29:5">ಹೌದು, ಅದು ಕ್ಷಣಮಾತ್ರದಲ್ಲಿ ಫಕ್ಕನೆ ಆಗುವುದು.<verse eid="ISA 29:5"/></para>
  <para style="q2">
    <verse number="6" style="v" sid="ISA 29:6"/>ಸೇನಾಧೀಶ್ವರ ಯೆಹೋವ ದೇವರು</para>
  <para style="q1" vid="ISA 29:6">ಗುಡುಗಿನಿಂದಲೂ, ಮಹಾಶಬ್ದದಿಂದಲೂ, ಬಿರುಗಾಳಿ ಸುಳಿಗಾಳಿಯಿಂದಲೂ,</para>
  <para style="q2" vid="ISA 29:6">ದಹಿಸುವ ಅಗ್ನಿಜ್ವಾಲೆಯಿಂದಲೂ ಪ್ರತ್ಯಕ್ಷರಾಗುವರು.<verse eid="ISA 29:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 29:7"/>ಅರೀಯೇಲಿನ ಮೇಲೆ ಹೋರಾಡಿ</para>
  <para style="q2" vid="ISA 29:7">ಅದಕ್ಕೂ ಅದರ ಕೋಟೆಗೂ ವಿರುದ್ಧವಾಗಿ ಯುದ್ಧಮಾಡಿ ಬಾಧಿಸುವ ಸಕಲ ಜನಾಂಗಗಳು</para>
  <para style="q1" vid="ISA 29:7">ರಾತ್ರಿಯ ದರ್ಶನದ</para>
  <para style="q2" vid="ISA 29:7">ಕನಸಿನಂತೆ ಮಾಯವಾಗುವುವು.<verse eid="ISA 29:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 29:8"/>ಹಸಿದ ಮನುಷ್ಯನು ಕನಸು ಕಂಡು ಇಗೋ, ಉಣ್ಣುತ್ತೇನೆ ಎಂದುಕೊಂಡಂತಾಗುವುದು.</para>
  <para style="q2" vid="ISA 29:8">ಆದರೆ ಅವನು ಎಚ್ಚೆತ್ತಾಗ ಪ್ರಾಣ ತುಂಬಿದ ಹಾಗೆಯೂ,</para>
  <para style="q1" vid="ISA 29:8">ಬಾಯಾರಿದವನು ಸ್ವಪ್ನದಲ್ಲಿ ಇಗೋ, ಕುಡಿಯುತ್ತೇನೆ ಎಂದುಕೊಂಡಂತಾಗುವುದು.</para>
  <para style="q2" vid="ISA 29:8">ಆದರೆ ಅವನು ಎಚ್ಚರವಾದಾಗ ಬಲಹೀನನಾಗಿದ್ದು,</para>
  <para style="q1" vid="ISA 29:8">ಪ್ರಾಣ ಆಶಿಸುವ ಹಾಗೆಯೇ ಚೀಯೋನ್ ಪರ್ವತಕ್ಕೆ ವಿರೋಧವಾಗಿ</para>
  <para style="q2" vid="ISA 29:8">ಯುದ್ಧಮಾಡುವ ಎಲ್ಲಾ ಜನಾಂಗಗಳ ಸಮೂಹವಿರುವುದು.<verse eid="ISA 29:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 29:9"/>ತಾಮಸ ಮಾಡಿ ಆಶ್ಚರ್ಯಪಡಿರಿ.</para>
  <para style="q2" vid="ISA 29:9">ಕುರುಡು ಮಾಡಿಕೊಂಡು ದೃಷ್ಟಿಯಿಲ್ಲದವರಾಗಿರಿ</para>
  <para style="q1" vid="ISA 29:9">ಇವರು ಅಮಲೇರಿದ್ದಾರೆ. ಆದರೆ ದ್ರಾಕ್ಷಾರಸದಿಂದಲ್ಲ.</para>
  <para style="q2" vid="ISA 29:9">ಅವರು ಕೂಗಾಡುತ್ತಾರೆ, ಆದರೆ ಮದ್ಯದಿಂದಲ್ಲ.<verse eid="ISA 29:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 29:10"/>ಯೆಹೋವ ದೇವರು ನಿಮ್ಮ ಮೇಲೆ ಗಾಢನಿದ್ರೆಯ ಆತ್ಮವನ್ನು ಹೊಯ್ದು,</para>
  <para style="q2" vid="ISA 29:10">ನಿಮ್ಮ ಕಣ್ಣುಗಳನ್ನು ಮುಚ್ಚಿದ್ದಾರೆ.</para>
  <para style="q2" vid="ISA 29:10">ಪ್ರವಾದಿಗಳನ್ನೂ, ನಿಮ್ಮ ಮುಖ್ಯಸ್ಥರಾದ ದರ್ಶಿಗಳನ್ನು ಮುಚ್ಚಿದ್ದಾರೆ.<verse eid="ISA 29:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="ISA 29:11"/>ದರ್ಶನವೆಲ್ಲಾ ನಿಮಗೆ ಮುದ್ರೆ ಹಾಕಿದ ಗ್ರಂಥದ ವಾಕ್ಯಗಳ ಹಾಗಾಯಿತು. ಅದನ್ನು ಅಕ್ಷರ ಬಲ್ಲವನಿಗೆ ಕೊಟ್ಟು, “ಇದನ್ನು ಓದು,” ಎಂದು ವಿನಂತಿಸಿದರೆ ಅವನು, “ಮುದ್ರೆ ಹಾಕಿದೆಯೆಲ್ಲಾ, ಆಗುವುದಿಲ್ಲ,” ಅನ್ನುವನು. <verse eid="ISA 29:11"/><verse number="12" style="v" sid="ISA 29:12"/>ಅಕ್ಷರವಿಲ್ಲದವನಿಗೆ ಆ ಪುಸ್ತಕವನ್ನು ಒಪ್ಪಿಸಿದರೆ ಅವನು ನನಗೆ ಓದಲು ಬರುವುದಿಲ್ಲ ಅನ್ನುವನು.<verse eid="ISA 29:12"/></para>
  <para style="b"/>
  <para style="p">
    <verse number="13" style="v" sid="ISA 29:13"/>ಕರ್ತರು ಹೇಳುವುದೇನೆಂದರೆ:</para>
  <para style="q1" vid="ISA 29:13">“ಈ ಜನರು ಬಾಯಿಂದ ನನ್ನನ್ನು ಸಮೀಪಿಸಿ,</para>
  <para style="q2" vid="ISA 29:13">ತಮ್ಮ ತುಟಿಗಳಿಂದ ನನ್ನನ್ನು ಸನ್ಮಾನಿಸುತ್ತಾರೆ,</para>
  <para style="q2" vid="ISA 29:13">ಆದರೆ ಅವರ ಹೃದಯವು ನನ್ನಿಂದ ದೂರವಾಗಿದೆ.</para>
  <para style="q1" vid="ISA 29:13">ಬಾಯಿಪಾಠವಾಗಿ ಕಲಿತಿರುವ ಮನುಷ್ಯರ ಆಜ್ಞೆಗೆ ಸರಿಯಾದ</para>
  <para style="q2" vid="ISA 29:13">ಭಯವನ್ನು ಮಾತ್ರ ನನ್ನಲ್ಲಿಟ್ಟಿದ್ದಾರೆ.<verse eid="ISA 29:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="ISA 29:14"/>ಹೀಗಿರುವುದರಿಂದ, ನಾನು ಈ ಜನರ ಮಧ್ಯದಲ್ಲಿ ಅಧಿಕ ಆಶ್ಚರ್ಯವೂ</para>
  <para style="q2" vid="ISA 29:14">ಅದ್ಭುತವೂ ಆದ ಕಾರ್ಯವನ್ನು ಇನ್ನೂ ಮಾಡುವೆನು.</para>
  <para style="q1" vid="ISA 29:14">ಅವರ ಜ್ಞಾನಿಗಳ ಜ್ಞಾನವು ಅಳಿಯುವುದು.</para>
  <para style="q2" vid="ISA 29:14">ಅವರ ವಿವೇಕಿಗಳ ವಿವೇಕವು ಅಡಗಿಕೊಳ್ಳುವುದು.”<verse eid="ISA 29:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="ISA 29:15"/>ತಮ್ಮ ಆಲೋಚನೆಗಳನ್ನು ಯೆಹೋವ ದೇವರಿಗೆ ಮರೆಮಾಡುವುದಕ್ಕೆ ಅಗಾಧದಲ್ಲಿ ಹೋಗಿ,</para>
  <para style="q2" vid="ISA 29:15">ನಮ್ಮನ್ನು ಯಾರು ನೋಡಿಯಾರು?</para>
  <para style="q1" vid="ISA 29:15">ನಮ್ಮನ್ನು ಯಾರು ತಿಳಿದಾರು? ಎಂದುಕೊಂಡು,</para>
  <para style="q2" vid="ISA 29:15">ಕತ್ತಲೆಯಲ್ಲೇ ತಮ್ಮ ಕೆಲಸವನ್ನು ನಡಿಸುವವರಿಗೆ ಕಷ್ಟ!<verse eid="ISA 29:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="ISA 29:16"/>ಖಂಡಿತವಾಗಿಯೂ ನೀವು ತಲೆಕೆಳಗೆ ಮಾಡುವ ಸಂಗತಿಗಳು,</para>
  <para style="q2" vid="ISA 29:16">ಕುಂಬಾರನು ಜೇಡಿಮಣ್ಣಿನಂತೆ ಪರಿಗಣಿಸಲಾಗುವುದು!</para>
  <para style="q1" vid="ISA 29:16">ಉಂಟುಮಾಡಿದವನಿಗೆ ಉಂಟುಮಾಡಿದ್ದು,</para>
  <para style="q2" vid="ISA 29:16">“ನೀನು ನನ್ನನ್ನು ಉಂಟುಮಾಡಲಿಲ್ಲ,” ಎಂತಲೂ,</para>
  <para style="q1" vid="ISA 29:16">ಮಡಕೆ ಕುಂಬಾರನಿಗೆ,</para>
  <para style="q2" vid="ISA 29:16">“ನಿನಗೆ ಏನೂ ಗೊತ್ತಿಲ್ಲ,” ಎಂತಲೂ ಹೇಳಬಹುದೇ?<verse eid="ISA 29:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="ISA 29:17"/>ಆದರೂ ಇನ್ನು ಸ್ವಲ್ಪಕಾಲದಲ್ಲಿ ಲೆಬನೋನ್ ಫಲವುಳ್ಳ ಹೊಲವಾಗಿದ್ದು,</para>
  <para style="q2" vid="ISA 29:17">ಆ ಫಲವುಳ್ಳ ಹೊಲವು ಅಡವಿಯಾಗಿ ಎಣಿಸಲ್ಪಡುವುದಿಲ್ಲವೋ?<verse eid="ISA 29:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="ISA 29:18"/>ಆ ದಿನದಲ್ಲಿ ಕಿವುಡರು ಗ್ರಂಥದ ಮಾತುಗಳನ್ನು ಕೇಳುವರು</para>
  <para style="q2" vid="ISA 29:18">ಮತ್ತು ಕುರುಡರ ಕಣ್ಣುಗಳು ಕತ್ತಲೆಯೊಳಗಿಂದಲೂ,</para>
  <para style="q2" vid="ISA 29:18">ಅಂಧಕಾರದೊಳಗಿಂದಲೂ ಕಾಣುವುವು.<verse eid="ISA 29:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="ISA 29:19"/>ದೀನರ ಸಂತೋಷವು ಯೆಹೋವ ದೇವರಲ್ಲಿ ಹೆಚ್ಚಾಗುವುವು.</para>
  <para style="q2" vid="ISA 29:19">ಮನುಷ್ಯರಲ್ಲಿ ಬಡವರು ಇಸ್ರಾಯೇಲಿನ ಪರಿಶುದ್ಧನಲ್ಲಿ ಹರ್ಷಿಸುವರು.<verse eid="ISA 29:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="ISA 29:20"/>ಭಯಂಕರನು ಇಲ್ಲವಾಗುತ್ತಾನೆ.</para>
  <para style="q2" vid="ISA 29:20">ಅಪಹಾಸ್ಯ ಮಾಡುವವರು ಕಣ್ಮರೆಯಾಗುತ್ತಾರೆ.</para>
  <para style="q2" vid="ISA 29:20">ಕೇಡಿಗೆ ಕಾಯುವವರೆಲ್ಲರೂ ನಾಶವಾಗುತ್ತಾರೆ.<verse eid="ISA 29:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="ISA 29:21"/>ಸುಳ್ಳುಸಾಕ್ಷಿ ಹೇಳಿ ತಪ್ಪುಹೊರಿಸುವವರು,</para>
  <para style="q2" vid="ISA 29:21">ನ್ಯಾಯಸ್ಥಾನದಲ್ಲಿ ದೋಷವನ್ನು ಖಂಡಿಸುವವರಿಗೆ ಉರುಲೊಡ್ಡುವವರು,</para>
  <para style="q1" vid="ISA 29:21">ನೀತಿವಂತನಿಗೆ ನ್ಯಾಯ ತಪ್ಪಿಸುವವರು</para>
  <para style="q2" vid="ISA 29:21">ಹೀಗೆ ಅಧರ್ಮದಲ್ಲಿ ನಿರತರಾಗಿರುವ ಇವರೆಲ್ಲರು ನಿರ್ಮೂಲರಾಗುವರು.<verse eid="ISA 29:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="ISA 29:22"/>ಆದ್ದರಿಂದ ಅಬ್ರಹಾಮನನ್ನು ವಿಮೋಚಿಸಿದ ಯೆಹೋವ ದೇವರು ಯಾಕೋಬಿನ ಮನೆತನದ ವಿಷಯವಾಗಿ ಹೇಳುವುದೇನೆಂದರೆ,</para>
  <para style="q1" vid="ISA 29:22">“ಈಗ ಯಾಕೋಬ್ಯರು ನಾಚಿಕೆಪಡುವುದಿಲ್ಲ.</para>
  <para style="q2" vid="ISA 29:22">ಅವನ ಮುಖವು ಕಳೆಗುಂದುವುದಿಲ್ಲ.<verse eid="ISA 29:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="ISA 29:23"/>ಆದರೆ ನನ್ನ ಕೈಕೆಲಸವಾದ ಅವನ ಮಕ್ಕಳನ್ನು</para>
  <para style="q2" vid="ISA 29:23">ತನ್ನ ಮಧ್ಯದಲ್ಲಿ ಕಾಣುವಾಗ</para>
  <para style="q1" vid="ISA 29:23">ನನ್ನ ನಾಮವನ್ನು ಪರಿಶುದ್ಧವೆಂದೆಣಿಸಿ,</para>
  <para style="q2" vid="ISA 29:23">ಯಾಕೋಬಿನ ಪರಿಶುದ್ಧನನ್ನು ಪ್ರತಿಷ್ಠಿಸುವರು,</para>
  <para style="q2" vid="ISA 29:23">ಇಸ್ರಾಯೇಲಿನ ದೇವರಿಗೆ ಭಯಪಡುವರು.<verse eid="ISA 29:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="ISA 29:24"/>ತಪ್ಪಿದ ಆತ್ಮವುಳ್ಳವರು ವಿವೇಕಿಗಳಾಗುವರು.</para>
  <para style="q2" vid="ISA 29:24">ಗೊಣಗುಟ್ಟುವವರು ಬೋಧನೆ ಕಲಿಯುವರು.”<verse eid="ISA 29:24"/></para>
  <chapter eid="ISA 29"/>
  <chapter number="30" style="c" sid="ISA 30"/>
  <para style="s1">ತಿರುಗಿ ಬೀಳುವವರಿಗೆ ಕಷ್ಟ</para>
  <para style="q1">
    <verse number="1" style="v" sid="ISA 30:1"/>“ದ್ರೋಹಿಗಳಾದ ಮಕ್ಕಳಿಗೆ ಕಷ್ಟ!”</para>
  <para style="q2" vid="ISA 30:1">ಎಂದು ಯೆಹೋವ ದೇವರು ಹೇಳುತ್ತಾರೆ.</para>
  <para style="q1" vid="ISA 30:1">ಅವರು ಆಲೋಚನೆಯನ್ನು ಮಾಡುತ್ತಾರೆ ಆದರೆ ನನ್ನಿಂದಲ್ಲ.</para>
  <para style="q2" vid="ISA 30:1">ನನ್ನ ಆತ್ಮ ಪ್ರೇರಿತರಾಗದೆ ಉಪಾಯಗಳನ್ನು ಮಾಡುತ್ತಾರೆ,</para>
  <para style="q2" vid="ISA 30:1">ಪಾಪದ ಮೇಲೆ ಪಾಪವನ್ನು ಸೇರಿಸಿಕೊಂಡಿದ್ದಾರೆ.<verse eid="ISA 30:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 30:2"/>ಫರೋಹನಲ್ಲಿ ತಾವು ಬಲಗೊಳ್ಳುವ ಆಶ್ರಯವನ್ನು</para>
  <para style="q2" vid="ISA 30:2">ಈಜಿಪ್ಟಿನ ನೆರಳಿನಲ್ಲಿ ಭರವಸವಿಡಬೇಕೆಂದು</para>
  <para style="q1" vid="ISA 30:2">ನನ್ನ ಮಾತನ್ನು ಕೇಳದೆ,</para>
  <para style="q2" vid="ISA 30:2">ಈಜಿಪ್ಟಿಗೆ ಪ್ರಯಾಣವಾಗಿ ಹೊರಟಿದ್ದಾರೆ.<verse eid="ISA 30:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 30:3"/>ಆದರೆ ಫರೋಹನ ಆಶ್ರಯದಿಂದ ನಿಮಗೆ ನಾಚಿಕೆಯೂ,</para>
  <para style="q2" vid="ISA 30:3">ಈಜಿಪ್ಟ್ ನೆರಳಿನ ಭರವಸೆಯಿಂದ ನಿಮಗೆ ನಿಂದೆಯೂ ಉಂಟಾಗುವುದು.<verse eid="ISA 30:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 30:4"/>ಏಕೆಂದರೆ ಅವನ ಪ್ರಧಾನರು ಚೋವನಿನಲ್ಲಿ ಇದ್ದರು.</para>
  <para style="q2" vid="ISA 30:4">ಅವನ ರಾಯಭಾರಿಗಳು ಹಾನೇಸಿಗೆ ಬಂದಿದ್ದಾರೆ.<verse eid="ISA 30:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 30:5"/>ತಮಗೆ ಪ್ರಯೋಜನವಾಗದೆ ಸಹಾಯಕ್ಕೂ,</para>
  <para style="q2" vid="ISA 30:5">ಪ್ರಯೋಜನಕ್ಕೂ ಅಲ್ಲ.</para>
  <para style="q1" vid="ISA 30:5">ನಿಂದೆಗೂ, ನಾಚಿಕೆಗೂ ಇರುವ ಜನಕ್ಕೆ</para>
  <para style="q2" vid="ISA 30:5">ಎಲ್ಲರೂ ನಾಚಿಕೆಪಡುತ್ತಾರೆ.<verse eid="ISA 30:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="ISA 30:6"/>ನೆಗೆವಿನ ಮೃಗಗಳ ವಿಷಯವಾದ ಪ್ರವಾದನೆ:</para>
  <para style="q1" vid="ISA 30:6">ಇಕ್ಕಟ್ಟಾದ ಶ್ರಮೆಯುಳ್ಳ ದೇಶಕ್ಕೆ</para>
  <para style="q2" vid="ISA 30:6">ಪ್ರಾಯ ಮತ್ತು ಮುದಿ ಸಿಂಹವೂ,</para>
  <para style="q2" vid="ISA 30:6">ಸರ್ಪವೂ, ಹಾರುವ ಉರಿಮಂಡಲ ಸರ್ಪವೂ ಬರುವಲ್ಲಿಗೆ</para>
  <para style="q1" vid="ISA 30:6">ಅವರು ಕತ್ತೆಮರಿಗಳ ಬೆನ್ನ ಮೇಲೆ ತಮ್ಮ ಬದುಕನ್ನೂ,</para>
  <para style="q2" vid="ISA 30:6">ಒಂಟೆಗಳ ಮೇಲೆ ತಮ್ಮ ದ್ರವ್ಯಗಳನ್ನು</para>
  <para style="q1" vid="ISA 30:6">ತಮಗೆ ಪ್ರಯೋಜನವಿಲ್ಲದ ಜನಕ್ಕೆ ತೆಗೆದುಕೊಂಡು ಹೋಗುತ್ತಾರೆ.<verse eid="ISA 30:6"/></para>
  <para style="q2">
    <verse number="7" style="v" sid="ISA 30:7"/>ಏಕೆಂದರೆ ಈಜಿಪ್ಟಿನವರ ಸಹಾಯವು ವ್ಯರ್ಥವೇ ವ್ಯರ್ಥ.</para>
  <para style="q1" vid="ISA 30:7">ಆದ್ದರಿಂದ ನಾನು ಅವಳಿಗೆ ಇದನ್ನು ಕುರಿತು</para>
  <para style="q2" vid="ISA 30:7">ಅವರ ಬಲವು ನಿಂತು ಹೋಗಿದೆ ಎಂದು ನಾನು ಕೂಗಿದ್ದೇನೆ.<verse eid="ISA 30:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 30:8"/>ಈಗ ಹೋಗಿ ಇದನ್ನು ಅದರ ಮುಂದೆ ಹಲಗೆಯಲ್ಲಿ ಬರೆ.</para>
  <para style="q2" vid="ISA 30:8">ಅದನ್ನು ಸುರುಳಿಯಲ್ಲಿ ಬರೆಯಿರಿ,</para>
  <para style="q1" vid="ISA 30:8">ಮುಂದೆ ಬರುವ ನಿತ್ಯಕಾಲಕ್ಕಾಗಿ</para>
  <para style="q2" vid="ISA 30:8">ಶಾಶ್ವತ ಸಾಕ್ಷಿಯಾಗಿರಲಿ.<verse eid="ISA 30:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 30:9"/>ಏನೆಂದರೆ ಇವರು ತಿರುಗಿಬೀಳುವ ಜನರೇ.</para>
  <para style="q2" vid="ISA 30:9">ಸುಳ್ಳಾಡುವ ಮಕ್ಕಳು.</para>
  <para style="q1" vid="ISA 30:9">ಯೆಹೋವ ದೇವರ ಉಪದೇಶಕ್ಕೆ</para>
  <para style="q2" vid="ISA 30:9">ಕಿವಿಗೊಡದ ಮಕ್ಕಳೇ.<verse eid="ISA 30:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 30:10"/>ಅವರು ನೋಡುವವರಿಗೆ,</para>
  <para style="q2" vid="ISA 30:10">“ನೋಡಬೇಡಿರಿ,” ಎಂದು</para>
  <para style="q1" vid="ISA 30:10">ಪ್ರವಾದಿಗಳಿಗೆ, “ನಿಮಗೆ ದರ್ಶನವಾಗದಿರಲಿ,” ಎನ್ನುತ್ತಾರೆ.</para>
  <para style="q2" vid="ISA 30:10">ಪ್ರವಾದಿಗಳಿಗೆ, ನಮಗೆ ನ್ಯಾಯವಾದವುಗಳನ್ನು ಪ್ರವಾದಿಸಬೇಡಿರಿ.</para>
  <para style="q1" vid="ISA 30:10">ನಯವಾದವುಗಳನ್ನೇ ನುಡಿಯಿರಿ.</para>
  <para style="q2" vid="ISA 30:10">ಮಾಯವಾದವುಗಳನ್ನೇ ಪ್ರವಾದಿಸಿರಿ ಎನ್ನುತ್ತಾರೆ.<verse eid="ISA 30:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 30:11"/>“ನಿಮ್ಮ ದಾರಿಗೆ ಓರೆಯಾಗಿರಿ,</para>
  <para style="q2" vid="ISA 30:11">ಮಾರ್ಗದಿಂದ ತೊಲಗಿರಿ.</para>
  <para style="q1" vid="ISA 30:11">ಇಸ್ರಾಯೇಲರ ಪರಿಶುದ್ಧನನ್ನು ನಮ್ಮ ಮುಂದೆ</para>
  <para style="q2" vid="ISA 30:11">ನಿಲ್ಲದ ಹಾಗೆ ಮಾಡಿರಿ,”</para>
  <para style="q2" vid="ISA 30:11">ಎಂದು ಹೇಳುತ್ತಾರೆ.<verse eid="ISA 30:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="ISA 30:12"/>ಆದಕಾರಣ ಇಸ್ರಾಯೇಲರ ಪರಿಶುದ್ಧನು ಹೇಳುವುದೇನೆಂದರೆ,</para>
  <para style="q1" vid="ISA 30:12">“ನೀವು ಈ ಮಾತನ್ನು ತಿರಸ್ಕಾರ ಮಾಡಿ ಬಲಾತ್ಕಾರ,</para>
  <para style="q2" vid="ISA 30:12">ಕುಯುಕ್ತಿಗಳನ್ನು ನಂಬಿ,</para>
  <para style="q2" vid="ISA 30:12">ಅವುಗಳನ್ನೇ ಆಧಾರ ಮಾಡಿಕೊಂಡದ್ದರಿಂದ<verse eid="ISA 30:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="ISA 30:13"/>ಎತ್ತರವಾದ ಗೋಡೆಯ ಒಂದು ಭಾಗವು</para>
  <para style="q2" vid="ISA 30:13">ಉಬ್ಬಿಕೊಂಡು ತಟ್ಟನೆ ಕ್ಷಣಮಾತ್ರದಲ್ಲಿ ಕಳಚಿ ಬೀಳುವ ಹಾಗೆ</para>
  <para style="q2" vid="ISA 30:13">ನಿಮ್ಮ ಅಪರಾಧವು ನಿಮಗೆ ಅಪಾಯಕರವಾಗಿರುವುದು.<verse eid="ISA 30:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="ISA 30:14"/>ಒಲೆಯಿಂದ ಕೆಂಡವನ್ನು ತೆಗೆಯುವುದಕ್ಕಾಗಲಿ,</para>
  <para style="q2" vid="ISA 30:14">ಬಾವಿಯಿಂದ ನೀರನ್ನು ತೆಗೆಯುವುದಕ್ಕಾಗಲಿ,</para>
  <para style="q1" vid="ISA 30:14">ಬೋಕಿಯ ತುಂಡುಗಳಲ್ಲಿ ಒಂದೂ ಉಳಿಯದಂತೆ ಒಬ್ಬನು</para>
  <para style="q2" vid="ISA 30:14">ಕುಂಬಾರನ ಗಡಿಗೆಯನ್ನು ಚೂರುಚೂರಾಗಿ ಒಡೆದು ಬಿಡುವ ರೀತಿಯಲ್ಲಿ</para>
  <para style="q2" vid="ISA 30:14">ಆತನು ಆ ಗೋಡೆಯನ್ನು ಒಡೆದುಬಿಡುವನು.”<verse eid="ISA 30:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="ISA 30:15"/>ಏಕೆಂದರೆ ಇಸ್ರಾಯೇಲಿನ ಪರಿಶುದ್ಧನಾದ ಸಾರ್ವಭೌಮ ಯೆಹೋವ ದೇವರು ಹೇಳುವುದೇನೆಂದರೆ,</para>
  <para style="q1" vid="ISA 30:15">“ನೀವು ತಿರುಗಿಕೊಂಡು ಸುಮ್ಮನಿದ್ದರೆ ನಿಮಗೆ ರಕ್ಷಣೆಯಾಗುವುದು.</para>
  <para style="q2" vid="ISA 30:15">ಶಾಂತರಾಗಿ ಭರವಸದಿಂದಿರುವುದೇ ನಿಮಗೆ ಬಲ ಎಂದು ಹೇಳಿದ್ದರೂ, ನೀವು ಒಪ್ಪಿಕೊಂಡಿಲ್ಲ.<verse eid="ISA 30:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="ISA 30:16"/>ಆದರೆ ನೀವು, ‘ಬೇಡವೇ ಬೇಡ. ಏಕೆಂದರೆ ನಾವು ಕುದುರೆಗಳ ಮೇಲೆ ಓಡುವೆವು,’</para>
  <para style="q2" vid="ISA 30:16">ಎಂದುಕೊಂಡಿದ್ದರಿಂದ ನೀವು ಓಡಿಹೋಗುವಿರಿ,</para>
  <para style="q1" vid="ISA 30:16">ನಾವು ವೇಗವಾಗಿ ಸವಾರಿ ಮಾಡುವೆವು,</para>
  <para style="q2" vid="ISA 30:16">ಎಂದುಕೊಂಡಿದ್ದರಿಂದ ಆ ವೇಗಿಗಳೇ ನಿಮ್ಮನ್ನು ಅಟ್ಟಿಬಿಡುವರು.<verse eid="ISA 30:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="ISA 30:17"/>ಒಬ್ಬನ ಬೆದರಿಕೆಗೆ</para>
  <para style="q2" vid="ISA 30:17">ಸಾವಿರ ಜನರು ಓಡುವರು,</para>
  <para style="q1" vid="ISA 30:17">ಐವರು ಹೆದರಿಸುವುದರಿಂದ</para>
  <para style="q2" vid="ISA 30:17">ನೀವೆಲ್ಲರೂ ಓಡಿಹೋಗುವಿರಿ,</para>
  <para style="q1" vid="ISA 30:17">ಕಟ್ಟಕಡೆಗೆ ಬೆಟ್ಟದ ಶಿಖರದಲ್ಲಿನ</para>
  <para style="q2" vid="ISA 30:17">ಸ್ತಂಭದ ಹಾಗೂ ಗುಡ್ಡದ ಮೇಲಣ</para>
  <para style="q2" vid="ISA 30:17">ಕಂಬದಂತೆಯೂ ಒಂಟಿಯಾಗಿ ಉಳಿಯುವಿರಿ.”<verse eid="ISA 30:17"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="18" style="v" sid="ISA 30:18"/>ಹೀಗಿರಲು ಯೆಹೋವ ದೇವರು ನಿಮಗೆ ಕೃಪೆಯನ್ನು ತೋರಿಸಬೇಕೆಂದು ಕಾದಿರುವನು.</para>
  <para style="q2" vid="ISA 30:18">ನಿಮ್ಮನ್ನು ಕರುಣಿಸಬೇಕೆಂದು ಉನ್ನತವಾಗಿ ಕಾಣಿಸಿಕೊಳ್ಳುವನು.</para>
  <para style="q1" vid="ISA 30:18">ಏಕೆಂದರೆ ಯೆಹೋವ ದೇವರು ನ್ಯಾಯಾಧಿಪತಿಯಾದ ದೇವರಾಗಿದ್ದಾನೆ.</para>
  <para style="q2" vid="ISA 30:18">ಆತನಿಗಾಗಿ ಕಾದಿರುವವರೆಲ್ಲರೂ ಧನ್ಯರು.<verse eid="ISA 30:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="ISA 30:19"/>ಏಕೆಂದರೆ, ಯೆರೂಸಲೇಮಿನಲ್ಲಿ ವಾಸಿಸುವ ಚೀಯೋನಿನ ಜನರೇ, ನೀವು ಇನ್ನು ಅಳಬೇಕಾಗಿಲ್ಲ. ನೀವು ಕೂಗಿ ದುಃಖಿಸಿದ ಶಬ್ದವನ್ನು ದೇವರು ಕೇಳಿ ನಿಮಗೆ ಕೃಪೆ ತೋರಿಸೇ ತೋರಿಸುವರು. ದೇವರು ನಿಮ್ಮ ಸ್ವರವನ್ನು ಕೇಳಿದ ಕೂಡಲೇ ಸದುತ್ತರವನ್ನು ದಯಪಾಲಿಸುವರು. <verse eid="ISA 30:19"/><verse number="20" style="v" sid="ISA 30:20"/>ಕರ್ತದೇವರು ನಿಮಗೆ ಕಷ್ಟವನ್ನು, ಶ್ರಮೆಯನ್ನು, ಅನ್ನಪಾನಗಳನ್ನಾಗಿ ಕೊಟ್ಟರೂ, ಇನ್ನೂ ನಿಮ್ಮ ಬೋಧಕರು ನಮಗೆ ಮರೆಯಾಗಿ ಇರುವುದಿಲ್ಲ. ಆದರೆ ನಿನ್ನ ಕಣ್ಣುಗಳು ನಿಮ್ಮ ಬೋಧಕರನ್ನು ನೋಡುತ್ತಿರುವುವು. <verse eid="ISA 30:20"/><verse number="21" style="v" sid="ISA 30:21"/>ನೀವು ಬಲಕ್ಕಾಗಲಿ, ಎಡಕ್ಕಾಗಲಿ ತಿರುಗಿಕೊಳ್ಳುವಾಗ, “ಇದೇ ಮಾರ್ಗ ಇದರಲ್ಲೇ ನಡೆಯಿರಿ,” ಎಂದು ನಿಮ್ಮ ಹಿಂದೆ ಆಡುವ ಮಾತು ನಿಮ್ಮ ಕಿವಿಗೆ ಬೀಳುವುದು. <verse eid="ISA 30:21"/><verse number="22" style="v" sid="ISA 30:22"/>ಕೆತ್ತಿದ ನಿಮ್ಮ ವಿಗ್ರಹಗಳ ಬೆಳ್ಳಿಯ ಕವಚಗಳನ್ನೂ, ಎರಕದ ನಿಮ್ಮ ವಿಗ್ರಹಗಳ ಬಂಗಾರದ ಹೊದಿಕೆಯನ್ನೂ ನೀವು ಹೊಲಸ್ಸಾಗಿ ಭಾವಿಸಿ, ಆ ವಿಗ್ರಹಕ್ಕೆ, “ತೊಲಗಿಹೋಗು,” ಎಂದು ಹೇಳಿ, ಅದನ್ನು ಹೊಲೆಯ ಬಟ್ಟೆಯಂತೆ ಬಿಸಾಡಿ ಬಿಡುವಿರಿ.<verse eid="ISA 30:22"/></para>
  <para style="b"/>
  <para style="p">
    <verse number="23" style="v" sid="ISA 30:23"/>ಆಗ ನೀವು ಹೊಲದಲ್ಲಿ ಬೀಜ ಬಿತ್ತುವುದಕ್ಕೆ ಬಿತ್ತನೆಯ ಮಳೆಯನ್ನು ದಯಪಾಲಿಸುವೆನು. ಭೂಮಿಯ ಬೆಳೆಯಿಂದ ಸಾರವಾದ ಆಹಾರವನ್ನು ಸಮೃದ್ಧಿಯಾಗಿ ಒದಗಿಸುವೆನು. ಆ ದಿನದಲ್ಲಿ ನಿನ್ನ ದನಗಳು ವಿಸ್ತಾರವಾದ ಹುಲ್ಲುಗಾವಲುಗಳಲ್ಲಿ ಮೇಯುವುವು. <verse eid="ISA 30:23"/><verse number="24" style="v" sid="ISA 30:24"/>ಹೊಲಗೆಯ್ಯುವ ನಿಮ್ಮ ಎತ್ತು ಕತ್ತೆಗಳು ಮೊರದಿಂದಲೂ, ಕವೆಗೋಲಿನಿಂದಲೂ ತೂರಿದ ರುಚಿಕರವಾದ ಮೇವನ್ನು ತಿನ್ನುವುವು. <verse eid="ISA 30:24"/><verse number="25" style="v" sid="ISA 30:25"/>ಮಹಾ ಸಂಹಾರದ ದಿವಸದಲ್ಲಿ ಗೋಪುರಗಳು ಬೀಳುವಾಗ ಪ್ರತಿಯೊಂದು ಉನ್ನತ ಪರ್ವತದಲ್ಲಿಯೂ, ಪ್ರತಿಯೊಂದು ಎತ್ತರವಾದ ಗುಡ್ಡದಲ್ಲಿಯೂ ತೊರೆಗಳು ನೀರಿನ ಕಾಲುವೆಗಳೂ ಹರಿಯುತ್ತಿರುವುವು. <verse eid="ISA 30:25"/><verse number="26" style="v" sid="ISA 30:26"/>ಇಷ್ಟೇ ಅಲ್ಲದೆ ಯೆಹೋವ ದೇವರು ತನ್ನ ಜನರ ವ್ರಣವನ್ನು ಕಟ್ಟಿ, ಅವರ ಪೆಟ್ಟಿನ ಗಾಯವನ್ನು ವಾಸಿಮಾಡುವ ದಿನದಲ್ಲಿ ಚಂದ್ರನ ಬೆಳಕು ಸೂರ್ಯನ ಬೆಳಕಿನ ಹಾಗೆಯೂ ಮತ್ತು ಸೂರ್ಯನ ಬೆಳಕು ಏಳರಷ್ಟು ಹೆಚ್ಚಾಗಿ, ಏಳು ದಿನಗಳ ಬೆಳಕಿನಂತಾಗುವುದು.<verse eid="ISA 30:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="ISA 30:27"/>ಇಗೋ, ಯೆಹೋವ ದೇವರ ನಾಮವು ದೂರದಿಂದ ಬರುತ್ತದೆ.</para>
  <para style="q2" vid="ISA 30:27">ಆತನ ಕೋಪವು ಉರಿಯುತ್ತದೆ. ಅದರಿಂದೇಳುವ ಹೊಗೆಯು ದಟ್ಟವಾಗಿದೆ.</para>
  <para style="q1" vid="ISA 30:27">ಆತನ ತುಟಿಗಳು ರೋಷದಿಂದ ತುಂಬಿವೆ.</para>
  <para style="q2" vid="ISA 30:27">ಆತನ ನಾಲಿಗೆಯು ದಹಿಸುವ ಅಗ್ನಿಯಂತಿದೆ.<verse eid="ISA 30:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="ISA 30:28"/>ಆತನ ಶ್ವಾಸವು ತುಂಬುತ್ತಾ,</para>
  <para style="q2" vid="ISA 30:28">ಕಂಠದವರೆಗೂ ಏರುವ ತೊರೆಯಂತಿದೆ.</para>
  <para style="q1" vid="ISA 30:28">ಜನಾಂಗಗಳನ್ನು ಏನೂ ಉಳಿಸದ</para>
  <para style="q2" vid="ISA 30:28">ಜರಡಿಯಿಂದ ಜಾಲಿಸುವುದಕ್ಕೆ ಬರುತ್ತಾನೆ.</para>
  <para style="q2" vid="ISA 30:28">ದಾರಿತಪ್ಪಿಸುವ ಕಡಿವಾಣವು ಜನಗಳ ದವಡೆಗಳಲ್ಲಿರುವುದು.<verse eid="ISA 30:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="ISA 30:29"/>ಪರಿಶುದ್ಧ ಹಬ್ಬವನ್ನು ಆಚರಿಸುವ ರಾತ್ರಿಯಲ್ಲಿ ಆದಂತೆ</para>
  <para style="q2" vid="ISA 30:29">ನಿಮಗೆ ಹಾಡು ಇರುವುದು.</para>
  <para style="q1" vid="ISA 30:29">ಯೆಹೋವ ದೇವರ ಪರ್ವತವಾಗಿರುವ</para>
  <para style="q2" vid="ISA 30:29">ಇಸ್ರಾಯೇಲಿನ ಬಂಡೆಯ ಬಳಿಗೆ</para>
  <para style="q1" vid="ISA 30:29">ಕೊಳಲಿನ ಸಂಗಡ ಹೋಗುವ ಪ್ರಕಾರ</para>
  <para style="q2" vid="ISA 30:29">ಹೃದಯದ ಸಂತೋಷವಿರುವುದು.<verse eid="ISA 30:29"/></para>
  <para style="q1">
    <verse number="30" style="v" sid="ISA 30:30"/>ಆಗ ಯೆಹೋವ ದೇವರು ತನ್ನ ಗಂಭೀರವಾದ ಧ್ವನಿಯನ್ನು ಕೇಳ ಮಾಡಿ,</para>
  <para style="q2" vid="ISA 30:30">ತೀವ್ರ ಕೋಪ, ದಹಿಸುವ ಅಗ್ನಿ ಜ್ವಾಲೆ,</para>
  <para style="q1" vid="ISA 30:30">ಪ್ರಳಯ, ಬಿರುಗಾಳಿ, ಕಲ್ಮಳೆ,</para>
  <para style="q2" vid="ISA 30:30">ಇವುಗಳಿಂದ ತನ್ನ ಶಿಕ್ಷಾಹಸ್ತವನ್ನು ತೋರ್ಪಡಿಸುವನು.<verse eid="ISA 30:30"/></para>
  <para style="q1">
    <verse number="31" style="v" sid="ISA 30:31"/>ಯೆಹೋವ ದೇವರು ದಂಡದಿಂದ ದಂಡಿಸುವಾಗ,</para>
  <para style="q2" vid="ISA 30:31">ಅಸ್ಸೀರಿಯವು ಆತನ ಧ್ವನಿಯಿಂದಲೇ ಮುರಿದು ಹೋಗುವುದು.<verse eid="ISA 30:31"/></para>
  <para style="q1">
    <verse number="32" style="v" sid="ISA 30:32"/>ಯೆಹೋವ ದೇವರು ಅದರ ಮೇಲೆ ತರುವಂಥ ನೇಮಿಸಿದ ದಂಡವು</para>
  <para style="q2" vid="ISA 30:32">ಹಾದು ಹೋಗುವಲ್ಲೆಲ್ಲಾ</para>
  <para style="q1" vid="ISA 30:32">ಅದು ದಮ್ಮಡಿ, ಕಿನ್ನರಿಗಳ ಸಂಗಡ ಇರುವುದು.</para>
  <para style="q1" vid="ISA 30:32">ಆತನು ಅವರೊಂದಿಗೆ ಯುದ್ಧಗಳಲ್ಲಿ</para>
  <para style="q2" vid="ISA 30:32">ಹೋರಾಡುತ್ತಾ ಕೈಬೀಸಿ ಯುದ್ಧಮಾಡುವನು.<verse eid="ISA 30:32"/></para>
  <para style="q1">
    <verse number="33" style="v" sid="ISA 30:33"/>ಪೂರ್ವದಿಂದ ತೋಫೆತ್ ಸಿದ್ಧವಾಗಿದೆ.</para>
  <para style="q2" vid="ISA 30:33">ಹೌದು, ಅದು ಆಳವಾಗಿಯೂ,</para>
  <para style="q1" vid="ISA 30:33">ಅಗಲವಾಗಿಯೂ ಅರಸನಿಗೆ ಸಿದ್ಧವಾಗಿದೆ.</para>
  <para style="q2" vid="ISA 30:33">ಅದರ ಚಿತೆಯೊಳಗೆ ಬೆಂಕಿಯೂ,</para>
  <para style="q1" vid="ISA 30:33">ಬಹಳ ಕಟ್ಟಿಗೆಯೂ ತುಂಬಿರುವುದು.</para>
  <para style="q2" vid="ISA 30:33">ಯೆಹೋವ ದೇವರ ಶ್ವಾಸವು ಗಂಧಕದ ಪ್ರವಾಹದಂತೆ</para>
  <para style="q2" vid="ISA 30:33">ಅದನ್ನು ಉರಿಸುವುದು.<verse eid="ISA 30:33"/></para>
  <chapter eid="ISA 30"/>
  <chapter number="31" style="c" sid="ISA 31"/>
  <para style="s1">ಈಜಿಪ್ಟನ್ನು ಆಶ್ರಯಿಸುವವರಿಗೆ ವಿಪತ್ತು</para>
  <para style="q1">
    <verse number="1" style="v" sid="ISA 31:1"/>ಸಹಾಯಕ್ಕಾಗಿ ಈಜಿಪ್ಟನ್ನು ಸೇರಿ, ಅಶ್ವಬಲವನ್ನು,</para>
  <para style="q2" vid="ISA 31:1">ಆಶ್ರಯಿಸುವವರಿಗೆ ಕಷ್ಟ!</para>
  <para style="q1" vid="ISA 31:1">ಏಕೆಂದರೆ ರಥಗಳು ಬಹಳವೆಂದೂ,</para>
  <para style="q2" vid="ISA 31:1">ಅವರ ನಂಬಿಕೆಯು ರಥಗಳ ಮೇಲೆ ಏಕೆಂದರೆ ಅವರು ಅನೇಕರು,</para>
  <para style="q1" vid="ISA 31:1">ಆದರೆ ಇಸ್ರಾಯೇಲಿನ ಪರಿಶುದ್ಧನ ಮೇಲೆ ದೃಷ್ಟಿ ಇಡುವುದಿಲ್ಲ.</para>
  <para style="q2" vid="ISA 31:1">ಇಲ್ಲವೆ ಯೆಹೋವ ದೇವರಿಂದ ಸಹಾಯವನ್ನು ಬಯಸುವುದಿಲ್ಲ.<verse eid="ISA 31:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 31:2"/>ಆದರೂ ಅವರು ಜ್ಞಾನಿ, ಕೇಡನ್ನು ಬರಮಾಡುವರು.</para>
  <para style="q2" vid="ISA 31:2">ಅವರು ತಮ್ಮ ಮಾತನ್ನು ಹಿಂದೆಗೆಯುವುದಿಲ್ಲ.</para>
  <para style="q1" vid="ISA 31:2">ಆದರೆ ಕೆಡುಕರ ಮನೆತನಕ್ಕೂ,</para>
  <para style="q2" vid="ISA 31:2">ಅನ್ಯಾಯಗಾರರ ಸಹಾಯಕರಿಗೂ ವಿರುದ್ಧವಾಗಿ ಏಳುವನು.<verse eid="ISA 31:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 31:3"/>ಈಜಿಪ್ಟಿನವರು ಮನುಷ್ಯ ಮಾತ್ರದವರೇ, ದೇವರಲ್ಲ;</para>
  <para style="q2" vid="ISA 31:3">ಅವರ ಅಶ್ವಗಳು ಆತ್ಮವಲ್ಲ, ಮೂಳೆಮಾಂಸವೇ.</para>
  <para style="q1" vid="ISA 31:3">ಹೀಗಿರುವುದರಿಂದ ಯೆಹೋವ ದೇವರು ತನ್ನ ಕೈಚಾಚುವಾಗ</para>
  <para style="q2" vid="ISA 31:3">ಸಹಾಯ ಮಾಡಿದವನು</para>
  <para style="q2" vid="ISA 31:3">ಮತ್ತು ಸಹಾಯ ಪಡೆದವನೂ ಬಿದ್ದುಹೋಗುವನು.</para>
  <para style="q2" vid="ISA 31:3">ಅಂತೂ ಎಲ್ಲರೂ ಒಟ್ಟಿಗೆ ಲಯವಾಗುವರು.<verse eid="ISA 31:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="ISA 31:4"/>ಯೆಹೋವ ದೇವರು ನನಗೆ ಹೀಗೆ ಹೇಳಿದ್ದಾನೆ:</para>
  <para style="q1" vid="ISA 31:4">ಸಿಂಹವು, ಪ್ರಾಯದ ಸಿಂಹವು</para>
  <para style="q2" vid="ISA 31:4">ಬೇಟೆಯ ಮೇಲೆ ಬಿದ್ದು ಗುರುಗುಟ್ಟುತ್ತಿರುವಾಗ,</para>
  <para style="q1" vid="ISA 31:4">ಕಾವಲುಗಾರನ ಕೂಗನ್ನು ಕೇಳಿ,</para>
  <para style="q2" vid="ISA 31:4">ಕುರುಬರ ಗುಂಪು ಅದಕ್ಕೆ ವಿರುದ್ಧವಾಗಿ ಕೂಡಿ ಬಂದರೂ,</para>
  <para style="q1" vid="ISA 31:4">ಹೇಗೆ ಅವರ ಶಬ್ದಕ್ಕೆ ಭಯಪಡದೆ ಇಲ್ಲವೆ</para>
  <para style="q2" vid="ISA 31:4">ಅವರ ಗದ್ದಲಕ್ಕೆ ಕುಂದಿಹೋಗದೆ ಇರುವುದೋ,</para>
  <para style="q1" vid="ISA 31:4">ಹಾಗೆಯೇ ಸೇನಾಧೀಶ್ವರ ಯೆಹೋವ ದೇವರು ಚೀಯೋನ್ ಪರ್ವತಕ್ಕೋಸ್ಕರವೂ,</para>
  <para style="q2" vid="ISA 31:4">ಅದರ ಗುಡ್ಡಕ್ಕೋಸ್ಕರವೂ ಯುದ್ಧಮಾಡಲು ಇಳಿದು ಬರುವರು.<verse eid="ISA 31:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 31:5"/>ರೆಕ್ಕೆಗಳನ್ನು ಚಾಚಿದ ಪಕ್ಷಿಗಳಂತೆ ಸೇನಾಧೀಶ್ವರ ಯೆಹೋವ ದೇವರು</para>
  <para style="q2" vid="ISA 31:5">ಯೆರೂಸಲೇಮನ್ನು ಕಾಪಾಡುವರು.</para>
  <para style="q1" vid="ISA 31:5">ಅದನ್ನು ರಕ್ಷಿಸಿ ಕಾಯುವರು.</para>
  <para style="q2" vid="ISA 31:5">ಹಾದುಹೋಗುತ್ತಾ ಅಪಾಯದಿಂದ ತಪ್ಪಿಸುವರು.<verse eid="ISA 31:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="ISA 31:6"/>ಇಸ್ರಾಯೇಲರೇ, ನೀವು ಯಾರಿಗೆ ಅಗಾಧ ದ್ರೋಹವನ್ನು ಮಾಡಿದ್ದೀರೋ, ಆತನ ಕಡೆಗೆ ತಿರುಗಿಕೊಳ್ಳಿರಿ. <verse eid="ISA 31:6"/><verse number="7" style="v" sid="ISA 31:7"/>ಏಕೆಂದರೆ ನೀವು ನಿಮ್ಮ ಸ್ವಂತ ಕೈಗಳು ಪಾಪಕ್ಕೋಸ್ಕರ ಮಾಡಿದ ಬೆಳ್ಳಿಯ ಮತ್ತು ಬಂಗಾರದ ವಿಗ್ರಹಗಳನ್ನು ಆ ದಿನದಲ್ಲಿ ಪ್ರತಿಯೊಬ್ಬನು ಬಿಸಾಡಿಬಿಡುವನು.<verse eid="ISA 31:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 31:8"/>ಆಗ ಅಸ್ಸೀರಿಯದವರು ಖಡ್ಗದಿಂದ ಬೀಳುವರು. ಅದು ಮನುಷ್ಯರ ಖಡ್ಗವಲ್ಲ,</para>
  <para style="q2" vid="ISA 31:8">ಖಡ್ಗವು ಅವರನ್ನು ನುಂಗುವುದು. ಅದು ಮಾನವ ಖಡ್ಗವಲ್ಲ.</para>
  <para style="q1" vid="ISA 31:8">ಅವರು ಖಡ್ಗದಿಂದ ತಪ್ಪಿಸಿಕೊಳ್ಳಲು ಓಡುವರು.</para>
  <para style="q2" vid="ISA 31:8">ಅವರ ಯೌವನಸ್ಥರು ಜೀತದಾಳುಗಳಾಗುವರು.<verse eid="ISA 31:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 31:9"/>ಭಯಾನಕತೆಯಿಂದ ಅವರ ಕೋಟೆ ಬೀಳುವುದು,</para>
  <para style="q2" vid="ISA 31:9">ಯುದ್ಧದ ದೃಶ್ಯವನ್ನು ನೋಡಿ ಅವರ ಸೇನಾಪತಿಗಳು ಧ್ವಜಸ್ಥಾನದಿಂದ ದಿಕ್ಕುಪಾಲಾಗುವರು.</para>
  <para style="q1" vid="ISA 31:9">ಚೀಯೋನಿನಲ್ಲಿ ಅಗ್ನಿಯನ್ನೂ,</para>
  <para style="q2" vid="ISA 31:9">ಯೆರೂಸಲೇಮಿನಲ್ಲಿ ಕುಲುಮೆಯನ್ನೂ ಮಾಡಿಕೊಂಡಿರುವ</para>
  <para style="q2" vid="ISA 31:9">ಯೆಹೋವ ದೇವರು ಘೋಷಿಸುತ್ತಾರೆ.<verse eid="ISA 31:9"/></para>
  <chapter eid="ISA 31"/>
  <chapter number="32" style="c" sid="ISA 32"/>
  <para style="s1">ನೀತಿಯ ರಾಜ್ಯ</para>
  <para style="q1">
    <verse number="1" style="v" sid="ISA 32:1"/>ಇಗೋ, ಒಬ್ಬ ರಾಜನು ನೀತಿಗನುಸಾರವಾಗಿ ಆಳುವನು.</para>
  <para style="q2" vid="ISA 32:1">ಅಧಿಪತಿಗಳು ನ್ಯಾಯದಿಂದ ದೊರೆತನ ಮಾಡುವರು.<verse eid="ISA 32:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 32:2"/>ಆಗ ಮನುಷ್ಯನು ಗಾಳಿಗೋಸ್ಕರ ಅಡಗಿಕೊಳ್ಳುವಂತೆಯೂ,</para>
  <para style="q2" vid="ISA 32:2">ಬಿರುಗಾಳಿಗೋಸ್ಕರ ಮರೆಮಾಡಿಕೊಳ್ಳುವಂತೆಯೂ,</para>
  <para style="q1" vid="ISA 32:2">ಅರಣ್ಯದಲ್ಲಿಯ ನೀರಿನ ಕಾಲುವೆಗಳ ಹಾಗೂ,</para>
  <para style="q2" vid="ISA 32:2">ಬಾಯಾರಿದ ನಾಡಿಗೆ ದೊಡ್ಡ ಬಂಡೆಯ ನೆರಳಿನ ಹಾಗೆಯೂ ಇರುವನು.<verse eid="ISA 32:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 32:3"/>ಆಗ ನೋಡುವವರ ಕಣ್ಣುಗಳು ಮೊಬ್ಬಾಗವು,</para>
  <para style="q2" vid="ISA 32:3">ಕೇಳುವವರ ಕಿವಿಗಳು ಮಂದವಾಗವು.<verse eid="ISA 32:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 32:4"/>ಆತುರಗಾರರ ಹೃದಯವು ತಿಳುವಳಿಕೆಯನ್ನು ಗ್ರಹಿಸುವುದು.</para>
  <para style="q2" vid="ISA 32:4">ತೊದಲು ಮಾತನಾಡುವವರ ನಾಲಿಗೆ ಸ್ವಚ್ಛವಾಗಿ ಮಾತನಾಡುವುದಕ್ಕೆ ಸಿದ್ಧವಾಗಿರುವುದು.<verse eid="ISA 32:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 32:5"/>ಇನ್ನು ಮೇಲೆ ಮೂರ್ಖನು ಘನವಂತನೆನಿಸಿಕೊಳ್ಳನು.</para>
  <para style="q2" vid="ISA 32:5">ಮೋಸಗಾರನು ಮಹನೀಯನೆನಿಸಿಕೊಳ್ಳನು.<verse eid="ISA 32:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 32:6"/>ಏಕೆಂದರೆ ಮೂರ್ಖನು ಮೂರ್ಖವಾಗಿ ಮಾತನಾಡುವನು.</para>
  <para style="q2" vid="ISA 32:6">ಅವನ ಹೃದಯವು ಕಪಟತ್ವವನ್ನು ಅಭ್ಯಾಸಿಸುವಂತೆಯೂ,</para>
  <para style="q1" vid="ISA 32:6">ಯೆಹೋವ ದೇವರಿಗೆ ವಿರೋಧವಾಗಿ</para>
  <para style="q2" vid="ISA 32:6">ಸಂಪೂರ್ಣವಾಗಿ ತಪ್ಪಿ ಹೋಗುವವರಂತೆಯೂ,</para>
  <para style="q1" vid="ISA 32:6">ಹಸಿವೆಗೊಂಡವನ ಆಶೆಯನ್ನು ಬರಿದು ಮಾಡುವಂತೆಯೂ ಕೇಡನ್ನು ಮಾಡುವನು.</para>
  <para style="q2" vid="ISA 32:6">ಬಾಯಾರಿದವನ ಪಾನವನ್ನು ಇಲ್ಲದಂತೆ ಮಾಡುವ ಹಾಗೆ ಕಾರಣನಾಗುವನು.<verse eid="ISA 32:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 32:7"/>ಮೋಸಗಾರನ ಆಯುಧಗಳು ಕೆಟ್ಟವುಗಳೇ,</para>
  <para style="q2" vid="ISA 32:7">ದರಿದ್ರನು ನ್ಯಾಯವಾದದ್ದನ್ನು ಮಾತನಾಡಿದರೂ,</para>
  <para style="q1" vid="ISA 32:7">ಅವನು ಬಡವರನ್ನು ಸುಳ್ಳು ಮಾತುಗಳಿಂದ</para>
  <para style="q2" vid="ISA 32:7">ಕೆಡಿಸುವುದಕ್ಕೆ ಕುಯುಕ್ತಿಗಳನ್ನು ಕಲ್ಪಿಸುವನು.<verse eid="ISA 32:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 32:8"/>ಘನವಂತನಾದರೋ, ಘನಕಾರ್ಯಗಳನ್ನು ಕಲ್ಪಿಸುವನು.</para>
  <para style="q2" vid="ISA 32:8">ಅವನು ಘನವಾದವುಗಳಲ್ಲಿಯೇ ನಿರತನಾಗಿರುವನು.<verse eid="ISA 32:8"/></para>
  <para style="s1">ಯೆರೂಸಲೇಮಿನ ಮಹಿಳೆಯರು</para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 32:9"/>ನಿಶ್ಚಿಂತೆಯರಾದ ಮಹಿಳೆಯರೇ, ಏಳಿರಿ.</para>
  <para style="q2" vid="ISA 32:9">ನನ್ನ ಸ್ವರವನ್ನು ಕೇಳಿರಿ.</para>
  <para style="q1" vid="ISA 32:9">ಭಯವಿಲ್ಲದ ಹೆಣ್ಣು ಮಕ್ಕಳೇ,</para>
  <para style="q2" vid="ISA 32:9">ನನ್ನ ಮಾತಿಗೆ ಕಿವಿಗೊಡಿರಿ.<verse eid="ISA 32:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 32:10"/>ಈಗ ಸುಖವಾಗಿ ಕುಳಿತಿದ್ದೀರಿ, ನಿಶ್ಚಿಂತೆಯಿಂದಿದ್ದೀರಿ.</para>
  <para style="q2" vid="ISA 32:10">ಇನ್ನು ಒಂದು ವರ್ಷದ ಮೇಲೆ ಕೆಲವು ದಿನಗಳಲ್ಲಿ ಕಳವಳಗೊಳ್ಳುವಿರಿ.</para>
  <para style="q1" vid="ISA 32:10">ಏಕೆಂದರೆ, ಆಗ ದ್ರಾಕ್ಷಿ ಕೊಯಿಲು ನಿಂತುಹೋಗುವುದು.</para>
  <para style="q2" vid="ISA 32:10">ಯಾವ ಬೆಳೆಯೂ ನಿಮಗೆ ದೊರೆಯುವುದಿಲ್ಲ.<verse eid="ISA 32:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 32:11"/>ನಿಶ್ಚಿಂತೆಯುಳ್ಳ ಸ್ತ್ರೀಯರೇ, ನೀವು ನಡುಗಿರಿ.</para>
  <para style="q2" vid="ISA 32:11">ನಿರ್ಭೀತ ಪುತ್ರಿಯರೇ, ಕಳವಳಗೊಳ್ಳಿರಿ.</para>
  <para style="q1" vid="ISA 32:11">ನಿಮ್ಮ ಬಟ್ಟೆಯನ್ನು ಕಿತ್ತುಹಾಕಿ,</para>
  <para style="q2" vid="ISA 32:11">ಸೊಂಟಕ್ಕೆ ಗೋಣಿತಟ್ಟನ್ನು ಸುತ್ತಿಕೊಳ್ಳಿರಿ.<verse eid="ISA 32:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 32:12"/>ಇಷ್ಟವಾದ ಹೊಲಗಳ ಮತ್ತು ಫಲವತ್ತಾದ ದ್ರಾಕ್ಷಾಲತೆಗಳ ನಿಮಿತ್ತವೂ</para>
  <para style="q2" vid="ISA 32:12">ನಿಮ್ಮ ಎದೆ ಬಡಿದುಕೊಳ್ಳಿರಿ.<verse eid="ISA 32:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="ISA 32:13"/>ನನ್ನ ಜನರ ಹೊಲಗದ್ದೆಗಳಲ್ಲಿ ಮುಳ್ಳುಪೊದೆಗಳು ಹುಟ್ಟಿಕೊಂಡಿವೆ.</para>
  <para style="q2" vid="ISA 32:13">ಉಲ್ಲಾಸದಿಂದ ಕೂಡಿದ್ದ ಮನೆಗಳೂ</para>
  <para style="q2" vid="ISA 32:13">ಲವಲವಿಕೆಯಿಂದ ತುಂಬಿದ್ದ ನಗರಗಳೂ ಶೂನ್ಯವಾಗಿವೆ.<verse eid="ISA 32:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="ISA 32:14"/>ಅರಮನೆ ಹಾಳುಬಿದ್ದಿದೆ. ಗಲಭೆಯಪಟ್ಟಣವು ನಿರ್ಜನವಾಗುವುದು,</para>
  <para style="q2" vid="ISA 32:14">ಪರ್ವತ ಮತ್ತು ಬುರುಜು ಶಾಶ್ವತವಾಗಿ ಗುಹೆಗಳಾಗುವುವು.</para>
  <para style="q1" vid="ISA 32:14">ಕಾಡುಕತ್ತೆಗಳಿಗೆ ಬಯಲಾಗಿಯೂ,</para>
  <para style="q2" vid="ISA 32:14">ದನಕರುಗಳಿಗೆ ಹುಲ್ಲುಗಾವಲುಗಳಾಗಿಯೂ ಇರುವುವು.<verse eid="ISA 32:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="ISA 32:15"/>ಆದರೆ ದೇವರು ಉನ್ನತಲೋಕದಲ್ಲಿ ತಮ್ಮ ಪವಿತ್ರಾತ್ಮ ಧಾರೆಯನ್ನು ನಮ್ಮ ಮೇಲೆ ಸುರಿಯುವರು;</para>
  <para style="q2" vid="ISA 32:15">ಆಗ ಪಾಳುಭೂಮಿ ಫಲಭರಿತ ಭೂಮಿಯಾಗುವುದು,</para>
  <para style="q2" vid="ISA 32:15">ಫಲಭರಿತ ಭೂಮಿ ಸಮೃದ್ಧವಾದ ಅರಣ್ಯವಾಗಿ ಮಾರ್ಪಡುವುದು.<verse eid="ISA 32:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="ISA 32:16"/>ನ್ಯಾಯವು ಮರುಭೂಮಿಯಲ್ಲಿ ನೆಲೆಗೊಳ್ಳುವುದು,</para>
  <para style="q2" vid="ISA 32:16">ಪೈರಿನ ಹೊಲದಲ್ಲಿ ನೀತಿಯು ನೆಲೆಯಾಗಿರುವುದು.<verse eid="ISA 32:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="ISA 32:17"/>ನೀತಿಯ ಕೆಲಸವು ಸಮಾಧಾನವೂ, ನೀತಿಯ ಫಲವು</para>
  <para style="q2" vid="ISA 32:17">ನಿತ್ಯವಾದ ಶಾಂತಿಯೂ, ಭರವಸೆಯೂ ಆಗಿರುವುದು.<verse eid="ISA 32:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="ISA 32:18"/>ಆಗ ನನ್ನ ಜನರು ಸಮಾಧಾನದ ನಿವಾಸಗಳಲ್ಲಿಯೂ,</para>
  <para style="q2" vid="ISA 32:18">ಭದ್ರವಾದ ಸ್ಥಳಗಳಲ್ಲಿಯೂ,</para>
  <para style="q2" vid="ISA 32:18">ನೆಮ್ಮದಿಯ ಆಶ್ರಯಗಳಲ್ಲಿಯೂ ನೆಲೆಗೊಳ್ಳುವರು.<verse eid="ISA 32:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="ISA 32:19"/>ಆದರೆ ಕಲ್ಮಳೆ ಸುರಿಯುವಾಗ ವನವು ಹಾಳಾಗುವುದು.</para>
  <para style="q2" vid="ISA 32:19">ಪಟ್ಟಣವು ಸಂಪೂರ್ಣವಾಗಿ ನೆಲಸಮವಾಗುವುದು.<verse eid="ISA 32:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="ISA 32:20"/>ನೀರಿರುವ ಎಲ್ಲಾ ಕಡೆಗಳಲ್ಲಿ ಬಿತ್ತನೆ ಮಾಡಿ,</para>
  <para style="q2" vid="ISA 32:20">ದನಕತ್ತೆಗಳನ್ನು ಮೇಯಲು ಬಿಡುವ ನೀವು ಧನ್ಯರೇ ಸರಿ.<verse eid="ISA 32:20"/></para>
  <chapter eid="ISA 32"/>
  <chapter number="33" style="c" sid="ISA 33"/>
  <para style="s1">ನಿರಾಶೆ ಹಾಗೂ ಸಹಾಯ</para>
  <para style="q1">
    <verse number="1" style="v" sid="ISA 33:1"/>ಹಾಳು ಮಾಡುತ್ತಿರುವವನೇ, ನಿನಗೆ ಕಷ್ಟ!</para>
  <para style="q2" vid="ISA 33:1">ನಿನ್ನನ್ನು ಯಾರೂ ಸೂರೆಮಾಡದಿದ್ದರೂ ನೀನು ಸೂರೆಮಾಡುತ್ತಿರುವೆ;</para>
  <para style="q1" vid="ISA 33:1">ನಿನ್ನನ್ನು ಯಾರೂ ವಂಚಿಸದಿದ್ದರೂ</para>
  <para style="q2" vid="ISA 33:1">ನೀನು ವಂಚನೆ ಮಾಡುತ್ತಿರುವೆ. ಇದಕ್ಕೆಲ್ಲ ಅಂತ್ಯವಿದೆ.</para>
  <para style="q1" vid="ISA 33:1">ಈಗ ಹಾಳು ಮಾಡುತ್ತಿರುವ ನೀನು,</para>
  <para style="q2" vid="ISA 33:1">ಆಗ ನೀನೇ ಹಾಳಾಗುವೆ.</para>
  <para style="q1" vid="ISA 33:1">ಈಗ ವಂಚನೆ ಮಾಡುತ್ತಿರುವ</para>
  <para style="q2" vid="ISA 33:1">ನೀನೇ ವಂಚಿತನಾಗುವೆ.<verse eid="ISA 33:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 33:2"/>ಯೆಹೋವ ದೇವರೇ, ನಮ್ಮ ಕಡೆಗೆ ಕೃಪೆ ತೋರಿಸಿರಿ.</para>
  <para style="q2" vid="ISA 33:2">ನಿನಗೋಸ್ಕರ ನಾವು ಕಾದಿದ್ದೇವೆ.</para>
  <para style="q1" vid="ISA 33:2">ಪ್ರತಿ ಮುಂಜಾನೆ ನಮಗೆ ಭುಜಬಲವಾಗಿಯೂ,</para>
  <para style="q2" vid="ISA 33:2">ಇಕ್ಕಟ್ಟಿನ ಕಾಲದಲ್ಲಿ ನಮ್ಮ ರಕ್ಷಣೆಯಾಗಿಯೂ ಇರು.<verse eid="ISA 33:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 33:3"/>ನಿಮ್ಮ ಸೈನ್ಯದ ಕೋಲಾಹಲದ ಶಬ್ದಕ್ಕೆ ಜನರು ಓಡಿಹೋಗುತ್ತಾರೆ,</para>
  <para style="q2" vid="ISA 33:3">ನೀವು ಏಳುವಾಗ ರಾಜ್ಯಗಳು ಚದರಿ ಹೋಗುತ್ತವೆ.<verse eid="ISA 33:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 33:4"/>ನಿಮ್ಮ ಕೊಳ್ಳೆಯನ್ನು ಇತರರು ಮಿಡತೆಗಳಂತೆ ಕೊಳ್ಳೆಮಾಡುವರು,</para>
  <para style="q2" vid="ISA 33:4">ಮಿಡತೆಗಳು ಓಡಾಡುವ ಹಾಗೆ ಮನುಷ್ಯರು ಅದರ ಮೇಲೆ ಓಡಾಡುವರು.<verse eid="ISA 33:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 33:5"/>ಯೆಹೋವ ದೇವರು ಉನ್ನತೋನ್ನತನಾಗಿದ್ದಾನೆ.</para>
  <para style="q2" vid="ISA 33:5">ಏಕೆಂದರೆ ಆತನು ಮೇಲಿನ ಲೋಕದಲ್ಲಿ ವಾಸಿಸುತ್ತಾನೆ.</para>
  <para style="q2" vid="ISA 33:5">ಚೀಯೋನನ್ನು ನೀತಿ ಮತ್ತು ನ್ಯಾಯಗಳಿಂದ ತುಂಬಿಸಿದ್ದಾನೆ.<verse eid="ISA 33:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 33:6"/>ಅವರು ನಿಮ್ಮ ಸಮಯಕ್ಕೆ ಖಚಿತವಾದ ಆಧಾರವಾಗುತ್ತಾರೆ.</para>
  <para style="q2" vid="ISA 33:6">ರಕ್ಷಣೆ ಜ್ಞಾನ ತಿಳುವಳಿಕೆಗಳ ನಿಕ್ಷೇಪವಾಗಿಯೂ ಇರುವನು.</para>
  <para style="q2" vid="ISA 33:6">ಯೆಹೋವ ದೇವರ ಭಯವೇ ಅವನ ಬೊಕ್ಕಸವಾಗಿರುವುದು.<verse eid="ISA 33:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 33:7"/>ಅವರ ಪರಾಕ್ರಮಶಾಲಿಗಳು ಹೊರಗೆ ಕೂಗುತ್ತಾರೆ;</para>
  <para style="q2" vid="ISA 33:7">ಸಮಾಧಾನದ ರಾಯಭಾರಿಗಳು ಘೋರವಾಗಿ ಅಳುತ್ತಿದ್ದಾರೆ.<verse eid="ISA 33:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 33:8"/>ರಾಜ ಮಾರ್ಗಗಳು ಹಾಳಾಗಿವೆ.</para>
  <para style="q2" vid="ISA 33:8">ಹಾದಿಯಲ್ಲಿ ಹೋಗುವವರು ನಿಂತು ಹೋದರು.</para>
  <para style="q1" vid="ISA 33:8">ಅವನು ಒಪ್ಪಂದವನ್ನು ಮೀರಿದ್ದಾನೆ.</para>
  <para style="q2" vid="ISA 33:8">ಪಟ್ಟಣಗಳನ್ನು<note caller="+" style="f"><char style="fr" closed="false">33:8 </char><char style="fq" closed="false">ಪಟ್ಟಣಗಳನ್ನು </char><char style="ft" closed="false">ಕೆಲವು ಪ್ರತಿಗಳಲ್ಲಿ </char><char style="fqa" closed="false">ಸಾಕ್ಷಿಗಳು</char></note> ತಿರಸ್ಕಾರ ಮಾಡಿ,</para>
  <para style="q2" vid="ISA 33:8">ಯಾವ ಮನುಷ್ಯನನ್ನು ಗಣನೆಗೆ ತಾರನು.<verse eid="ISA 33:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 33:9"/>ದೇಶವು ಪ್ರಲಾಪಿಸಿ ಕುಗ್ಗುತ್ತದೆ.</para>
  <para style="q2" vid="ISA 33:9">ಲೆಬನೋನು ನಾಚಿಕೆಪಟ್ಟು ಕಡಿದು ಬೀಳುವುದು.</para>
  <para style="q1" vid="ISA 33:9">ಶಾರೋನ್ ಬೆಂಗಾಡಾಗಿದೆ.</para>
  <para style="q2" vid="ISA 33:9">ಬಾಷಾನ್ ಮತ್ತು ಕರ್ಮೆಲ್ ಎಲೆಗಳನ್ನು ಉದುರಿಸಿಬಿಟ್ಟಿವೆ.<verse eid="ISA 33:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 33:10"/>ಯೆಹೋವ ದೇವರು ಹೀಗೆನ್ನುತ್ತಾರೆ, “ನಾನು ಈಗ ಏಳುವೆನು.</para>
  <para style="q2" vid="ISA 33:10">ಈಗಲೇ ನನ್ನನ್ನು ಉನ್ನತಪಡಿಸಿಕೊಳ್ಳುವೆನು.</para>
  <para style="q2" vid="ISA 33:10">ಈಗ ಉನ್ನತೋನ್ನತನಾಗುವೆನು.<verse eid="ISA 33:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 33:11"/>ನೀವು ಒಣಹುಲ್ಲನ್ನು ಗರ್ಭಧರಿಸಿ,</para>
  <para style="q2" vid="ISA 33:11">ಪೈರಿನ ಮೋಟನ್ನು ಹೆರುವಿರಿ.</para>
  <para style="q2" vid="ISA 33:11">ನಿಮ್ಮ ಶ್ವಾಸವು ನಿಮ್ಮನ್ನೇ ನುಂಗುವ ಜ್ವಾಲೆಯಾಗುವುದು.<verse eid="ISA 33:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 33:12"/>ಜನಾಂಗಗಳು ಸುಟ್ಟ ಸುಣ್ಣದ ಹಾಗಿರುವುವು.</para>
  <para style="q2" vid="ISA 33:12">ಕತ್ತರಿಸಿದ ಮುಳ್ಳುಕೊಂಪೆಗೆ ಬೆಂಕಿ ಹಚ್ಚಿದಂತಾಗುವುದು.”<verse eid="ISA 33:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="ISA 33:13"/>ದೂರದಲ್ಲಿರುವವರೇ, ನಾನು ಮಾಡಿದ್ದನ್ನು ಕೇಳಿರಿ.</para>
  <para style="q2" vid="ISA 33:13">ಸಮೀಪದಲ್ಲಿರುವವರೇ, ನನ್ನ ಪರಾಕ್ರಮವನ್ನು ತಿಳಿದುಕೊಳ್ಳಿರಿ.<verse eid="ISA 33:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="ISA 33:14"/>ಚೀಯೋನಿನಲ್ಲಿರುವ ಪಾಪಿಗಳು ಹೆದರುತ್ತಾರೆ.</para>
  <para style="q2" vid="ISA 33:14">ಭಯದಿಂದ ಕಪಟಿಗಳು ಆಶ್ಚರ್ಯಕ್ಕೊಳಗಾಗಿ ಹೀಗೆ ಎಂದುಕೊಳ್ಳುವರು,</para>
  <para style="q1" vid="ISA 33:14">“ನಮ್ಮಲ್ಲಿ ಯಾರು ನುಂಗುವ ಅಗ್ನಿಯ ಸಂಗಡ ವಾಸಿಸಬಲ್ಲರು?</para>
  <para style="q2" vid="ISA 33:14">ನಮ್ಮಲ್ಲಿ ಯಾರು ಸದಾ ಉರಿಯುವ ಜ್ವಾಲೆಗಳೊಡನೆ ವಾಸಿಸಬಲ್ಲರು?”<verse eid="ISA 33:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="ISA 33:15"/>ನೀತಿಯಲ್ಲಿ ನಡೆದು, ಯಥಾರ್ಥವಾಗಿ ನುಡಿದು,</para>
  <para style="q2" vid="ISA 33:15">ದೋಚಿಕೊಂಡ ಲಾಭ ಬೇಡವೆಂದು</para>
  <para style="q1" vid="ISA 33:15">ಲಂಚ ಮುಟ್ಟದಂತೆ ಕೈಚಾಚಿದೆ.</para>
  <para style="q2" vid="ISA 33:15">ಕೊಲೆಯ ಮಾತಿಗೆ ಕಿವಿಗೊಡದೆ,</para>
  <para style="q1" vid="ISA 33:15">ಕೆಟ್ಟದ್ದನ್ನು ಕಾಣದಂತೆ ಕಣ್ಣು ಮುಚ್ಚಿಕೊಳ್ಳುವವರೇ</para>
  <para style="q2" vid="ISA 33:15">ಉನ್ನತ ಸ್ಥಳದಲ್ಲಿ ವಾಸಿಸುವರು.<verse eid="ISA 33:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="ISA 33:16"/>ಬಂಡೆಗಳ ಕೋಟೆಗಳು</para>
  <para style="q2" vid="ISA 33:16">ಅವನಿಗೆ ಆಶ್ರಯವಾಗಿರುವುವು.</para>
  <para style="q1" vid="ISA 33:16">ರೊಟ್ಟಿಯು ಅವನಿಗೆ ಒದಗುವುದು.</para>
  <para style="q1" vid="ISA 33:16">ನೀರು ತಪ್ಪುವುದಿಲ್ಲ.<verse eid="ISA 33:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="ISA 33:17"/>ರಾಜನ ಸೌಂದರ್ಯವನ್ನು ನಿನ್ನ ಕಣ್ಣುಗಳು ನೋಡುವುವು.</para>
  <para style="q2" vid="ISA 33:17">ಅತಿವಿಸ್ತಾರವಾದ ದೇಶವನ್ನು ಕಣ್ಣು ತುಂಬಾ ನೋಡುವಿರಿ.<verse eid="ISA 33:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="ISA 33:18"/>ಆಗ ನೀವು ಹಿಂದಿನ ಭಯಂಕರವಾದ ವಿಷಯಗಳನ್ನು ಮನಸ್ಸಿಗೆ ತಂದುಕೊಳ್ಳುತ್ತಾ,</para>
  <para style="q2" vid="ISA 33:18">“ಕಪ್ಪವನ್ನು ಲೆಕ್ಕಿಸಿದವನು ಎಲ್ಲಿ?</para>
  <para style="q1" vid="ISA 33:18">ತೂಕ ಮಾಡಿದವನು ಎಲ್ಲಿ?</para>
  <para style="q2" vid="ISA 33:18">ಗೋಪುರಗಳನ್ನು ಎಣಿಸಿದವನು ಎಲ್ಲಿ?” ಎಂದುಕೊಳ್ಳುವಿರಿ.<verse eid="ISA 33:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="ISA 33:19"/>ನೀನು ತಿಳಿಯಲಾಗದ ಹಾಗೆ ಕಠಿಣ ಭಾಷೆಯೂ,</para>
  <para style="q2" vid="ISA 33:19">ಗ್ರಹಿಸಲಾಗದ ಹಾಗೆ ಅಪರೂಪವಾದ ಮಾತನ್ನು ಆಡಿದ</para>
  <para style="q2" vid="ISA 33:19">ಜನರನ್ನೂ ಇನ್ನು ಮುಂದೆ ನೀನು ನೋಡುವುದಿಲ್ಲ.<verse eid="ISA 33:19"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="20" style="v" sid="ISA 33:20"/>ನಮ್ಮ ಹಬ್ಬಗಳು ನಡೆಯುವ ಚೀಯೋನ್ ಪಟ್ಟಣವನ್ನು ದೃಷ್ಟಿಸಿರಿ.</para>
  <para style="q2" vid="ISA 33:20">ಯೆರೂಸಲೇಮು ನೆಮ್ಮದಿಯ ನಿವಾಸವಾಗಿಯೂ,</para>
  <para style="q2" vid="ISA 33:20">ಗೂಟಕೀಳದ ಹಗ್ಗಹರಿಯದ ಒಂದೇ ಕಡೆ ಇರುವ</para>
  <para style="q1" vid="ISA 33:20">ಗುಡಾರವಾಗಿಯೂ ಇರುವುದನ್ನು</para>
  <para style="q2" vid="ISA 33:20">ನೀವು ಕಣ್ಣಾರೆ ಕಾಣುವಿರಿ.<verse eid="ISA 33:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="ISA 33:21"/>ಅಲ್ಲಿ ಯೆಹೋವ ದೇವರು ನಮ್ಮ ಬಲಶಾಲಿಯಾಗಿರುತ್ತಾರೆ.</para>
  <para style="q2" vid="ISA 33:21">ನದಿಸರೋವರಗಳಂತೆ ನಮ್ಮನ್ನು ಸುತ್ತುವರಿಯುವರು.</para>
  <para style="q1" vid="ISA 33:21">ಹುಟ್ಟುಗೋಲಿನ ದೋಣಿಯಾಗಲಿ,</para>
  <para style="q2" vid="ISA 33:21">ದೊಡ್ಡದಾದ ಹಡಗಾಗಲಿ ಅದನ್ನು ದಾಟುವುದಿಲ್ಲ.<verse eid="ISA 33:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="ISA 33:22"/>ಏಕೆಂದರೆ ಯೆಹೋವ ದೇವರು ನಮ್ಮ ನ್ಯಾಯಾಧಿಪತಿಯಾಗಿದ್ದಾರೆ.</para>
  <para style="q2" vid="ISA 33:22">ಯೆಹೋವ ದೇವರು ನಮಗೆ ಆಜ್ಞೆಕೊಡುವವರು.</para>
  <para style="q1" vid="ISA 33:22">ಯೆಹೋವ ದೇವರೇ, ನಮ್ಮ ರಾಜ.</para>
  <para style="q2" vid="ISA 33:22">ಯೆಹೋವ ದೇವರೇ ನಮ್ಮನ್ನು ರಕ್ಷಿಸುವವರು.<verse eid="ISA 33:22"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="23" style="v" sid="ISA 33:23"/>ನಿನ್ನ ಹಗ್ಗಗಳು ಸಡಲಿ,</para>
  <para style="q2" vid="ISA 33:23">ಸ್ತಂಭದ ಪಾದವನ್ನು ಸ್ಥಿರಪಡಿಸಿಕೊಳ್ಳಲಾರದೆ ಹೋದವು.</para>
  <para style="q2" vid="ISA 33:23">ಪಠವನ್ನು ಮುದುರದಂತೆ ಹಿಡಿದಿರಲಿಕ್ಕೂ ಆಗಲಿಲ್ಲ.</para>
  <para style="q1" vid="ISA 33:23">ಆಗ ದೊಡ್ಡ ಸೂರೆಯು ಕೊಳ್ಳೆಯಾಗಿ</para>
  <para style="q2" vid="ISA 33:23">ಹಂಚುವುದಕ್ಕೆ ಆಸ್ಪದವಾಯಿತು. ಕುಂಟರೂ ಸುಲಿಗೆ ಮಾಡಿದರು.<verse eid="ISA 33:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="ISA 33:24"/>ಚೀಯೋನಿನ ಯಾವ ನಿವಾಸಿಯೂ, “ನಾನು ಅಸ್ವಸ್ಥನಾಗಿದ್ದೇನೆ,” ಎಂದು ಹೇಳನು.</para>
  <para style="q2" vid="ISA 33:24">ಅದರಲ್ಲಿ ವಾಸವಾಗಿರುವ ಜನರ ಪಾಪವು ಕ್ಷಮಿಸಲಾಗುವುದು.<verse eid="ISA 33:24"/></para>
  <chapter eid="ISA 33"/>
  <chapter number="34" style="c" sid="ISA 34"/>
  <para style="s1">ರಾಷ್ಟ್ರಗಳ ವಿರುದ್ಧ ತೀರ್ಪು</para>
  <para style="q1">
    <verse number="1" style="v" sid="ISA 34:1"/>ರಾಷ್ಟ್ರಗಳೇ, ಕೇಳುವುದಕ್ಕೆ ಹತ್ತಿರ ಬನ್ನಿರಿ, ಕಿವಿಗೊಡಿರಿ.</para>
  <para style="q2" vid="ISA 34:1">ಭೂಮಿಯೂ, ಅದರಲ್ಲಿರುವ ಸಮಸ್ತವೂ;</para>
  <para style="q1" vid="ISA 34:1">ಲೋಕವೂ, ಅದರ ಎಲ್ಲಾ</para>
  <para style="q2" vid="ISA 34:1">ಹುಟ್ಟುವಳಿಯೂ ಕೇಳಲಿ.<verse eid="ISA 34:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 34:2"/>ಯೆಹೋವ ದೇವರ ಕೋಪವು ಸಕಲ ರಾಷ್ಟ್ರಗಳ ಮೇಲೂ,</para>
  <para style="q2" vid="ISA 34:2">ಅವುಗಳ ಎಲ್ಲಾ ಸೈನ್ಯಗಳ ಮೇಲೂ ರೋಷಗೊಂಡು,</para>
  <para style="q1" vid="ISA 34:2">ಅವರನ್ನು ಕೊಲೆಗೆ ಗುರಿಮಾಡಿ,</para>
  <para style="q2" vid="ISA 34:2">ಸಂಪೂರ್ಣವಾಗಿ ನಾಶಮಾಡಿದ್ದಾನೆ.<verse eid="ISA 34:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 34:3"/>ಅವರಲ್ಲಿ ಹತರಾದವರು, ಬೀದಿಪಾಲಾಗುವರು.</para>
  <para style="q2" vid="ISA 34:3">ಅವರ ಹೆಣಗಳ ದುರ್ವಾಸನೆಯು ಮೇಲಕ್ಕೆ ಏರುವುದು.</para>
  <para style="q2" vid="ISA 34:3">ಅವರ ರಕ್ತ ಪ್ರವಾಹದಿಂದ ಪರ್ವತಗಳು ತೋಯಿಸುವುದು.<verse eid="ISA 34:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 34:4"/>ಆಕಾಶದ ಸೈನ್ಯವೆಲ್ಲಾ ಗತಿಸಿ ಹೋಗುವುದು.</para>
  <para style="q2" vid="ISA 34:4">ಆಕಾಶಮಂಡಲವು ಸುರುಳಿಯಂತೆ ಸುತ್ತಿಕೊಳ್ಳುವುದು.</para>
  <para style="q1" vid="ISA 34:4">ದ್ರಾಕ್ಷಿ ಎಲೆ ಒಣಗಿ, ಗಿಡದಿಂದ ಬೀಳುವಂತೆಯೂ,</para>
  <para style="q2" vid="ISA 34:4">ಅಂಜೂರ ಮರದಿಂದ ಸುಕ್ಕುಗಟ್ಟಿದ ಅಂಜೂರ ಹಣ್ಣುಗಳು ಉದುರುವಂತೆ</para>
  <para style="q2" vid="ISA 34:4">ತಾರಾಮಂಡಲವೆಲ್ಲಾ ಬಾಡಿ ಬೀಳುವದು.<verse eid="ISA 34:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 34:5"/>ನನ್ನ ಖಡ್ಗವು ಪರಲೋಕದಲ್ಲಿ ರೋಷಪಾನ ಮಾಡುವುದು.</para>
  <para style="q2" vid="ISA 34:5">ಇಗೋ, ಅದು ಎದೋಮಿನ ಮತ್ತು ನಾನು ಶಪಿಸಿದ ಜನರ ಮೇಲೆಯೂ,</para>
  <para style="q2" vid="ISA 34:5">ನ್ಯಾಯತೀರಿಸುವುದಕ್ಕಾಗಿ ಕೆಳಗೆ ಇಳಿದು ಬರುವುದು.<verse eid="ISA 34:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 34:6"/>ಯೆಹೋವ ದೇವರ ಖಡ್ಗವು ರಕ್ತದಲ್ಲಿ ಸ್ನಾನ ಮಾಡಿದೆ.</para>
  <para style="q2" vid="ISA 34:6">ಅದು ಕುರಿ ಮತ್ತು ಹೋತಗಳ ರಕ್ತದಿಂದಲೂ,</para>
  <para style="q1" vid="ISA 34:6">ಟಗರುಗಳ ಮೂತ್ರಪಿಂಡದ</para>
  <para style="q2" vid="ISA 34:6">ಕೊಬ್ಬಿನಿಂದಲೂ ಮುಚ್ಚಲಾಗಿದೆ.</para>
  <para style="q1" vid="ISA 34:6">ಏಕೆಂದರೆ ಯೆಹೋವ ದೇವರಿಗೆ ಬೊಚ್ರದಲ್ಲಿ ಬಲಿಯು,</para>
  <para style="q2" vid="ISA 34:6">ಎದೋಮಿನ ದೇಶದಲ್ಲಿ ದೊಡ್ಡ ಕೊಲೆಯು ಉಂಟು.<verse eid="ISA 34:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 34:7"/>ಕಾಡುಕೋಣಗಳೂ ಹೋರಿಗೂಳಿಗಳೂ</para>
  <para style="q2" vid="ISA 34:7">ಈ ಯಜ್ಞಪಶುಗಳೊಂದಿಗೆ ಬೀಳುವುವು;</para>
  <para style="q1" vid="ISA 34:7">ನಾಡು ರಕ್ತದಿಂದ ತೊಯ್ದಿರುವುದು;</para>
  <para style="q2" vid="ISA 34:7">ಅಲ್ಲಿನ ಧೂಳು ಕೊಬ್ಬಿನಿಂದ ಜಿಡ್ಡಾಗಿರುವುದು.<verse eid="ISA 34:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 34:8"/>ಏಕೆಂದರೆ ಅದು ಯೆಹೋವ ದೇವರು ಮುಯ್ಯಿ ತೀರಿಸುವ ದಿನವಾಗಿದೆ,</para>
  <para style="q2" vid="ISA 34:8">ಚೀಯೋನಿನ ವ್ಯಾಜ್ಯದಲ್ಲಿ ದಂಡನೆ ವಿಧಿಸತಕ್ಕ ವರುಷವು ಒದಗಿದೆ.<verse eid="ISA 34:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 34:9"/>ಎದೋಮಿನ ಪ್ರವಾಹಗಳು ಇಳಿಜಾರಾಗಿ ಮಾರ್ಪಡುವುವು.</para>
  <para style="q2" vid="ISA 34:9">ಅದರ ಧೂಳು ಗಂಧಕವಾಗುವುದು,</para>
  <para style="q2" vid="ISA 34:9">ದೇಶವು ಉರಿಯುವ ಡಾಂಬರಿನಂತೆ ಇರುವುದು.<verse eid="ISA 34:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 34:10"/>ಅದು ರಾತ್ರಿಯಲ್ಲಾದರೂ ಇಲ್ಲವೆ ಹಗಲಿನಲ್ಲಾದರೂ ಆರುವುದಿಲ್ಲ.</para>
  <para style="q2" vid="ISA 34:10">ಅದರ ಹೊಗೆಯು ನಿರಂತರವಾಗಿ ಏಳುತ್ತಿರುವುದು.</para>
  <para style="q1" vid="ISA 34:10">ಅದು ತಲತಲಾಂತರಕ್ಕೂ ಹಾಳಾಗಿ ಬಿದ್ದಿರುವುದು,</para>
  <para style="q2" vid="ISA 34:10">ಅದನ್ನು ಎಂದೆಂದಿಗೂ ಯಾರೂ ಹಾದು ಹೋಗರು.<verse eid="ISA 34:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 34:11"/>ಆದರೆ ಬಕಪಕ್ಷಿಯು ಮತ್ತು ಮುಳ್ಳುಹಂದಿಯು ಅದನ್ನು ಆವರಿಸಿಕೊಳ್ಳುವುವು.</para>
  <para style="q2" vid="ISA 34:11">ಗೂಬೆ ಮತ್ತು ಕಾಗೆಗಳು ಸಹ ಅಲ್ಲಿ ವಾಸಿಸುವುವು.</para>
  <para style="q1" vid="ISA 34:11">ಗಲಿಬಿಲಿ ಎಂಬ ನೂಲನ್ನು, ಶೂನ್ಯವೆಂಬ ಗಟ್ಟಿ ತೂಕವನ್ನು</para>
  <para style="q2" vid="ISA 34:11">ಆತನು ಅದರ ಮೇಲೆ ಎಳೆಯುವನು.<verse eid="ISA 34:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 34:12"/>ಅವರ ರಾಜ್ಯಕ್ಕೆ ಪ್ರಮುಖರನ್ನು ಕರೆಯುವರು. ಆದರೆ ಅಲ್ಲಿ ಯಾರೂ ಇರುವುದಿಲ್ಲ.</para>
  <para style="q2" vid="ISA 34:12">ಅವಳ ಪ್ರಭುಗಳು ಇಲ್ಲದಂತಾಗುವರು.<verse eid="ISA 34:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="ISA 34:13"/>ಅವಳ ಅರಮನೆಗಳಲ್ಲಿ ಮುಳ್ಳುಗಳು ಬೆಳೆಯುವುವು,</para>
  <para style="q2" vid="ISA 34:13">ಅದರ ಕೋಟೆಗಳಲ್ಲಿ ಮುಳ್ಳುಪೊದೆಗಳು ಇರುವುವು.</para>
  <para style="q1" vid="ISA 34:13">ಅದು ನರಿಗಳ ನಿವಾಸವೂ,</para>
  <para style="q2" vid="ISA 34:13">ಗೂಬೆಗಳಿಗೆ ಸ್ಥಾನವೂ ಆಗುವುದು.<verse eid="ISA 34:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="ISA 34:14"/>ಮರುಭೂಮಿಯ ಕಾಡುಮೃಗಗಳು ತೋಳಗಳೊಂದಿಗೆ ಸಂಧಿಸುವುವು,</para>
  <para style="q2" vid="ISA 34:14">ಕಾಡುಮೇಕೆಗಳು ಪರಸ್ಪರ ಕರೆಯುತ್ತವೆ.</para>
  <para style="q1" vid="ISA 34:14">ರಾತ್ರಿ ಮೃಗಗಳು ಸಹ ಅಲ್ಲಿ ಮಲಗುತ್ತವೆ.</para>
  <para style="q2" vid="ISA 34:14">ತಮಗಾಗಿ ವಿಶ್ರಾಂತಿ ಸ್ಥಳಗಳನ್ನು ಕಂಡುಕೊಳ್ಳುತ್ತವೆ.<verse eid="ISA 34:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="ISA 34:15"/>ಅಲ್ಲಿ ಗೂಬೆಯು ಗೂಡನ್ನು ಮಾಡಿಕೊಂಡು, ಮೊಟ್ಟೆ ಇಟ್ಟು,</para>
  <para style="q2" vid="ISA 34:15">ಮರಿ ಮಾಡಿ, ಅವುಗಳನ್ನು ತನ್ನ ರೆಕ್ಕೆಗಳ ನೆರಳಿನಲ್ಲಿ ಕಾಪಾಡುವುದು.</para>
  <para style="q1" vid="ISA 34:15">ಅಲ್ಲಿಯೂ ಸಹ ಹದ್ದುಗಳು ಪ್ರತಿಯೊಂದೂ</para>
  <para style="q2" vid="ISA 34:15">ಜೊತೆಜೊತೆಯಾಗಿ ಸೇರಿರುತ್ತವೆ.<verse eid="ISA 34:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="ISA 34:16"/>ಯೆಹೋವ ದೇವರ ಗ್ರಂಥದಲ್ಲಿ ನೀವು ಹುಡುಕಿ ಓದಿರಿ,</para>
  <para style="q1" vid="ISA 34:16">ಇವುಗಳಲ್ಲಿ ಒಂದಾದರೂ ತಪ್ಪದು.</para>
  <para style="q2" vid="ISA 34:16">ಜೊತೆಯಿಲ್ಲದೆ ಒಂದೂ ಇರುವುದಿಲ್ಲ.</para>
  <para style="q1" vid="ISA 34:16">ಏಕೆಂದರೆ ನನ್ನ ಬಾಯಿಯೇ ಅದನ್ನು ಆಜ್ಞಾಪಿಸಿತು.</para>
  <para style="q2" vid="ISA 34:16">ಅವರ ಆತ್ಮವೇ ಅವುಗಳನ್ನು ಒಟ್ಟುಗೂಡಿಸಿತು.<verse eid="ISA 34:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="ISA 34:17"/>ಅವರೇ ಅವುಗಳಿಗೋಸ್ಕರ ಚೀಟು ಹಾಕಿದ್ದಾರೆ.</para>
  <para style="q2" vid="ISA 34:17">ಅವರ ಕೈಯೇ ಅದನ್ನು ಗೆರೆ ಎಳೆದು, ಅವರಿಗೆ ಹಂಚಿಕೊಟ್ಟಿದೆ.</para>
  <para style="q1" vid="ISA 34:17">ಅವು ಅದನ್ನು ನಿರಂತರಕ್ಕೂ ವಶಮಾಡಿಕೊಳ್ಳುವುವು.</para>
  <para style="q2" vid="ISA 34:17">ಅವು ತಲತಲಾಂತರಕ್ಕೂ ಅದರಲ್ಲಿ ವಾಸವಾಗಿರುವುವು.<verse eid="ISA 34:17"/></para>
  <chapter eid="ISA 34"/>
  <chapter number="35" style="c" sid="ISA 35"/>
  <para style="s1">ವಿಮೋಚನೆಯ ಸಂತೋಷ</para>
  <para style="q1">
    <verse number="1" style="v" sid="ISA 35:1"/>ಅರಣ್ಯವೂ, ಮರುಭೂಮಿಯೂ ಆನಂದಿಸುವುದು:</para>
  <para style="q2" vid="ISA 35:1">ಒಣ ನೆಲವು ಹರ್ಷಿಸಿ, ತಾವರೆಯಂತೆ ಕಳಕಳಿಸುವುದು.<verse eid="ISA 35:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 35:2"/>ಅದು ಸಮೃದ್ಧಿಯಾಗಿ ಅರಳಿ,</para>
  <para style="q2" vid="ISA 35:2">ಆನಂದ ಧ್ವನಿ ಎತ್ತಿ ಉಲ್ಲಾಸಿಸುವುದು.</para>
  <para style="q1" vid="ISA 35:2">ಲೆಬನೋನಿನ ಘನತೆಯು ಮತ್ತು ಕರ್ಮೆಲ್,</para>
  <para style="q2" vid="ISA 35:2">ಶಾರೋನಿನ ಗೌರವವು ಅದಕ್ಕೆ ಕೊಡಲಾಗುವುದು.</para>
  <para style="q1" vid="ISA 35:2">ಅವರು ಯೆಹೋವ ದೇವರ ಮಹಿಮೆಯನ್ನು</para>
  <para style="q2" vid="ISA 35:2">ಮತ್ತು ನಮ್ಮ ದೇವರ ಘನತೆಯನ್ನು ಕಾಣುವರು.<verse eid="ISA 35:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 35:3"/>ನೀವು ಬಲಹೀನವಾದ ಕೈಗಳನ್ನು ಬಲಪಡಿಸಿರಿ.</para>
  <para style="q2" vid="ISA 35:3">ನಡುಗುವ ಮೊಣಕಾಲುಗಳನ್ನು ದೃಢಪಡಿಸಿರಿ.<verse eid="ISA 35:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 35:4"/>ಭಯಭ್ರಾಂತ ಹೃದಯವುಳ್ಳವರಿಗೆ</para>
  <para style="q2" vid="ISA 35:4">ಬಲಗೊಳ್ಳಿರಿ, ಹೆದರಬೇಡಿರಿ.</para>
  <para style="q1" vid="ISA 35:4">ಇಗೋ, ನಿಮ್ಮ ದೇವರು ಮುಯ್ಯಿ ತೀರಿಸುವುದಕ್ಕೂ,</para>
  <para style="q2" vid="ISA 35:4">ದೇವರು ಪ್ರತಿಫಲವನ್ನು ಕೊಡುವುದಕ್ಕೂ</para>
  <para style="q1" vid="ISA 35:4">ತಾವೇ ಬಂದು ನಿಮ್ಮನ್ನು ರಕ್ಷಿಸುವರು,</para>
  <para style="q2" vid="ISA 35:4">ಎಂದು ಅವರಿಗೆ ಹೇಳಿರಿ.<verse eid="ISA 35:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 35:5"/>ಆಗ, ಕುರುಡರ ಕಣ್ಣು ಕಾಣುವುದು.</para>
  <para style="q2" vid="ISA 35:5">ಕಿವುಡರ ಕಿವಿಗಳು ಕೇಳಿಸುವುವು.<verse eid="ISA 35:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 35:6"/>ಆಗ ಕುಂಟನು ಜಿಂಕೆಯಂತೆ ಹಾರುವನು,</para>
  <para style="q2" vid="ISA 35:6">ಮೂಕನ ನಾಲಿಗೆಯೂ ಹರ್ಷದಿಂದ ಹಾಡುವುದು.</para>
  <para style="q1" vid="ISA 35:6">ಏಕೆಂದರೆ ಮರುಭೂಮಿಯಲ್ಲಿ ನೀರೂ,</para>
  <para style="q2" vid="ISA 35:6">ಮರುಭೂಮಿಯಲ್ಲಿ ಒರತೆಗಳೂ ಒಡೆಯುವುವು.<verse eid="ISA 35:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 35:7"/>ಒಣ ನೆಲವು ಸರೋವರವಾಗುವುದು,</para>
  <para style="q2" vid="ISA 35:7">ಬೆಂಗಾಡು ಪ್ರದೇಶವು ನೀರಿನ ಬುಗ್ಗೆಯಾಗುವುದು.</para>
  <para style="q1" vid="ISA 35:7">ನರಿಗಳು ವಾಸಿಸುವ ಪ್ರತಿಯೊಂದು ಮಲಗುವ ಸ್ಥಳದಲ್ಲಿ ಹುಲ್ಲು,</para>
  <para style="q2" vid="ISA 35:7">ಜೊಂಡು, ಆಪು ಹುಲ್ಲುಗಳಿಂದ ತುಂಬಿರುವುದು.<verse eid="ISA 35:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 35:8"/>ಅಲ್ಲಿ ರಾಜಮಾರ್ಗ ಇರುವುದು.</para>
  <para style="q2" vid="ISA 35:8">ಅದು ಪರಿಶುದ್ಧ ಮಾರ್ಗ ಎನಿಸಿಕೊಳ್ಳುವುದು.</para>
  <para style="q2" vid="ISA 35:8">ಯಾವ ಅಶುದ್ಧನು ಅದರ ಮೇಲೆ ಹಾದು ಹೋಗನು.</para>
  <para style="q1" vid="ISA 35:8">ಆದರೆ ಅದು ದೇವಜನರಿಗಾಗಿ ಇರುವುದು.</para>
  <para style="q2" vid="ISA 35:8">ಅಲ್ಲಿ ಹೋಗುವ ಮೂಢನೂ ದಾರಿ ತಪ್ಪನು.<verse eid="ISA 35:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 35:9"/>ಸಿಂಹವು ಅಲ್ಲಿ ಇರದು,</para>
  <para style="q2" vid="ISA 35:9">ಇಲ್ಲವೆ ಕ್ರೂರವಾದ ಮೃಗಗಳು ಅದರ ಮೇಲೆ ಹೋಗವು.</para>
  <para style="q2" vid="ISA 35:9">ಅದು ಅಲ್ಲಿ ಕಾಣುವುದೇ ಇಲ್ಲ.</para>
  <para style="q1" vid="ISA 35:9">ಆದರೆ ಬಿಡುಗಡೆಯಾದವರೇ ಅಲ್ಲಿ ನಡೆಯುವರು.<verse eid="ISA 35:9"/></para>
  <para style="q2">
    <verse number="10" style="v" sid="ISA 35:10"/>ಯೆಹೋವ ದೇವರು ವಿಮೋಚಿಸಿದವರು ಹಿಂದಿರುಗಿಕೊಂಡು</para>
  <para style="q2" vid="ISA 35:10">ಶಾಶ್ವತ ಸಂತೋಷವೆಂಬ ಕಿರೀಟವನ್ನು ಧರಿಸಿಕೊಂಡು,</para>
  <para style="q2" vid="ISA 35:10">ಉತ್ಸಾಹ ಧ್ವನಿಯೊಡನೆ ಚೀಯೋನಿಗೆ ಸೇರುವರು.</para>
  <para style="q1" vid="ISA 35:10">ಅವರು ಹರ್ಷಾನಂದಗಳನ್ನು ಅನುಭವಿಸುವರು.</para>
  <para style="q2" vid="ISA 35:10">ದುಃಖವೂ, ನಿಟ್ಟುಸಿರೂ ಓಡಿಹೋಗುವುವು.<verse eid="ISA 35:10"/></para>
  <chapter eid="ISA 35"/>
  <chapter number="36" style="c" sid="ISA 36"/>
  <para style="s1">ಸನ್ಹೇರೀಬನು ಯೆರೂಸಲೇಮನ್ನು ಭಯಪಡಿಸಿದ್ದು</para>
  <para style="p">
    <verse number="1" style="v" sid="ISA 36:1"/>ಅರಸನಾದ ಹಿಜ್ಕೀಯನ ಆಳಿಕೆಯ ಹದಿನಾಲ್ಕನೆಯ ವರ್ಷದಲ್ಲಿ ಅಸ್ಸೀರಿಯದ ಅರಸನಾದ ಸನ್ಹೇರೀಬನು ಬಂದು, ಯೆಹೂದದ ಎಲ್ಲಾ ಕೋಟೆಯ ಪಟ್ಟಣಗಳನ್ನು ಸ್ವಾಧೀನಮಾಡಿಕೊಂಡನು. <verse eid="ISA 36:1"/><verse number="2" style="v" sid="ISA 36:2"/>ಆಗ ಅಸ್ಸೀರಿಯದ ಅರಸನು ಲಾಕೀಷಿನಿಂದ ದೊಡ್ಡ ಸೈನ್ಯದೊಂದಿಗೆ ರಬ್ಷಾಕೆ ಎಂಬವನನ್ನು ಯೆರೂಸಲೇಮಿನಲ್ಲಿದ್ದ ಹಿಜ್ಕೀಯನ ಬಳಿಗೆ ಕಳುಹಿಸಿದನು. ಅವನು ಅಗಸರ ಹೊಲದ ಮಾರ್ಗದಲ್ಲಿ ಮೇಲಿನ ಕೆರೆಯ ಕಾಲುವೆಯ ಸಮೀಪದಲ್ಲಿ ನಿಂತುಕೊಂಡನು. <verse eid="ISA 36:2"/><verse number="3" style="v" sid="ISA 36:3"/>ಆಗ ಅರಮನೆಯ ಕಾರ್ಯನಿರ್ವಾಹಕನಾದ ಹಿಲ್ಕೀಯನ ಮಗ ಎಲ್ಯಾಕೀಮ್, ಕಾರ್ಯದರ್ಶಿಯಾದ ಶೆಬ್ನ, ದಾಖಲೆಗಾರನಾದ ಆಸಾಫನ ಮಗ ಯೋವ ಎಂಬುವರು ಅವನ ಬಳಿಗೆ ಬಂದರು.<verse eid="ISA 36:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="ISA 36:4"/>ರಬ್ಷಾಕೆಯು ಅವರಿಗೆ, “ನೀವು ಹಿಜ್ಕೀಯನಿಗೆ ಹೀಗೆ ಹೇಳಬೇಕು:</para>
  <para style="pm" vid="ISA 36:4">“ ‘ಮಹಾರಾಜನಾದ ಅಸ್ಸೀರಿಯದ ಅರಸನು ಹೇಳುವುದೇನೆಂದರೆ, ಈ ನಿನ್ನ ಭರವಸೆಗೆ ಆಧಾರ ಏನು? <verse eid="ISA 36:4"/><verse number="5" style="v" sid="ISA 36:5"/>ಯುದ್ಧಕ್ಕೆ ಬೇಕಾದ ಆಲೋಚನೆಯೂ, ಪರಾಕ್ರಮವೂ ಉಂಟೆಂದು ಹೇಳುವ ನಿನ್ನ ಮಾತು ಬರೀ ವ್ಯರ್ಥವಾದ ಮಾತುಗಳೇ, ನೀನು ಯಾರನ್ನು ನಂಬಿಕೊಂಡು ನನಗೆ ವಿರೋಧವಾಗಿ ತಿರುಗಿ ಬಿದ್ದಿದ್ದೀಯೆ? <verse eid="ISA 36:5"/><verse number="6" style="v" sid="ISA 36:6"/>ಇಗೋ! ನೀನು ಜಜ್ಜಿದ ದಂಟಿಗೆ ಸಮಾನವಾಗಿರುವ ಈಜಿಪ್ಟಿನ ಮೇಲೆ ಭರವಸೆ ಇಟ್ಟಿರುವಿಯಷ್ಟೆ, ಅದರ ಮೇಲೆ ಮನುಷ್ಯನು ಊರಿಕೊಂಡರೆ ಅದು ಅವನ ಕೈಯನ್ನೇ ಚುಚ್ಚಿ ಗಾಯ ಮಾಡುವುದು. ಈಜಿಪ್ಟಿನ ಅರಸನಾದ ಫರೋಹನಲ್ಲಿ ಭರವಸೆ ಇಟ್ಟವರೆಲ್ಲರಿಗೂ ಇದೇ ಗತಿಯಾಗುವದು. <verse eid="ISA 36:6"/><verse number="7" style="v" sid="ISA 36:7"/>ಬಹುಶಃ ನೀವು, “ನಮ್ಮ ದೇವರಾದ ಯೆಹೋವ ದೇವರನ್ನೇ ನಂಬಿಕೊಂಡಿದ್ದೇವೆ,” ಎಂದು ಹೇಳಬಹುದು. “ಯೆರೂಸಲೇಮಿನ ಬಲಿಪೀಠದ ಮುಂದೆಯೇ ಆರಾಧನೆ ಮಾಡಬೇಕು” ಎಂದು ಯೆಹೂದ್ಯರಿಗೆ ಮತ್ತು ಯೆರೂಸಲೇಮಿನವರಿಗೆ ಹಿಜ್ಕೀಯನು ಆಜ್ಞಾಪಿಸಿ, ಆ ಯೆಹೋವ ದೇವರ ಪೂಜಾಸ್ಥಳಗಳನ್ನೂ, ಬೇರೆ ಎಲ್ಲಾ ಬಲಿಪೀಠಗಳನ್ನೂ ಹಾಳುಮಾಡಿದನಲ್ಲವೇ?<verse eid="ISA 36:7"/></para>
  <para style="pm">
    <verse number="8" style="v" sid="ISA 36:8"/>“ ‘ಹಾಗಾದರೆ, ಈಗ ನೀನು ಅಸ್ಸೀರಿಯದ ಅರಸನಾದ ನನ್ನ ಯಜಮಾನನೊಂದಿಗೆ ಒಪ್ಪಂದ ಮಾಡಿಕೋ, ಆಗ ನಿನಗೆ ಎರಡು ಸಾವಿರ ಕುದುರೆಸವಾರರನ್ನು ಬಳಸಲು ಸಾಮರ್ಥ್ಯವಿದ್ದರೆ ನಾನು ಎರಡು ಸಾವಿರ ಕುದುರೆಗಳನ್ನು ಕೊಡುತ್ತೇನೆ. <verse eid="ISA 36:8"/><verse number="9" style="v" sid="ISA 36:9"/>ಇದಾಗದಿದ್ದರೆ ನನ್ನ ಯಜಮಾನನ ಸೇವಕರಲ್ಲಿ ಚಿಕ್ಕವನಾದ ಒಬ್ಬ ಸೈನ್ಯಾಧಿಪತಿಯನ್ನು ಹೇಗೆ ಎದುರಿಸುತ್ತೀ? ನೀನು ರಥಗಳಿಗೋಸ್ಕರವೂ, ರಾಹುತರಿಗೋಸ್ಕರವೂ ಈಜಿಪ್ಟಿನ ಮೇಲೆ ಭರವಸೆ ಇಟ್ಟಿದ್ದೀಯೋ? <verse eid="ISA 36:9"/><verse number="10" style="v" sid="ISA 36:10"/>ಈ ಸ್ಥಳವನ್ನು ನಾಶಮಾಡುವುದಕ್ಕೆ ಯೆಹೋವ ದೇವರ ಅಪ್ಪಣೆ ಇಲ್ಲದೆ ಬಂದಿದ್ದೇನೋ? ಈ ದೇಶದ ಮೇಲೆ ಹೋಗಿ ಅದನ್ನು ನಾಶಮಾಡೆಂದು ಯೆಹೋವ ದೇವರೇ ನನಗೆ ಹೇಳಿದರು,’ ” ಎಂದನು.<verse eid="ISA 36:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="ISA 36:11"/>ಆಗ ಎಲ್ಯಾಕೀಮ್, ಶೆಬ್ನ, ಯೋವ ಎಂಬುವರು ರಬ್ಷಾಕೆಗೆ, “ನೀನು ಮಾತನಾಡುವುದು ಗೋಡೆಯ ಮೇಲಿರುವವರಿಗೆ ಕೇಳಿಸುತ್ತದೆ ಆದ್ದರಿಂದ ದಯವಿಟ್ಟು ನಿನ್ನ ಸೇವಕರಾದ ನಮ್ಮೊಡನೆ ಅರಾಮ್ಯ ಭಾಷೆಯಲ್ಲಿ ಮಾತನಾಡು: ಅದು ನಮಗೆ ತಿಳಿಯುತ್ತದೆ ಆದರೆ ಹಿಬ್ರಿಯ ಭಾಷೆಯಲ್ಲಿ ಮಾತನಾಡಬೇಡ,” ಎಂದು ಹೇಳಿದರು.<verse eid="ISA 36:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="ISA 36:12"/>ಆದರೆ ರಬ್ಷಾಕೆಯು ಅವರಿಗೆ, “ನನ್ನ ಯಜಮಾನನು ನಿಮ್ಮ ಸಂಗಡವಾಗಲಿ, ನಿಮ್ಮ ಯಜಮಾನನ ಸಂಗಡವಾಗಲಿ ಮಾತ್ರ ಈ ಮಾತುಗಳನ್ನು ಹೇಳುವುದಕ್ಕೆ ಕಳುಹಿಸಲಿಲ್ಲ. ಈ ಗೋಡೆಯ ಮೇಲೆ ಕುಳಿತ ಜನರ ಸಂಗಡವೂ ಮಾತನಾಡುವುದಕ್ಕಾಗಿ ಕಳುಹಿಸಿದ್ದಾರೆ. ಈ ಜನರು ನಿಮ್ಮ ಸಂಗಡ ಇದ್ದರೆ ನಿಮ್ಮ ಹಾಗೆ ಇವರೂ ಸಹ ತಮ್ಮ ಸ್ವಂತ ಮಲಮೂತ್ರವನ್ನು ತಿಂದು ಕುಡಿಯಬೇಕಾಗುತ್ತದೆ,” ಎಂದು ಹೇಳಿದನು.<verse eid="ISA 36:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="ISA 36:13"/>ಆಗ ರಬ್ಷಾಕೆ ನಿಂತುಕೊಂಡು ಯೆಹೂದ್ಯರ ಭಾಷೆಯಾದ ಹಿಬ್ರಿಯದಲ್ಲಿ ಗಟ್ಟಿಯಾದ ಶಬ್ದದಿಂದ ಕೂಗಿ ಹೇಳಿದ್ದೇನೆಂದರೆ, “ನೀವು ಅಸ್ಸೀರಿಯದ ಮಹಾರಾಜನ ಮಾತನ್ನು ಕೇಳಿರಿ. <verse eid="ISA 36:13"/><verse number="14" style="v" sid="ISA 36:14"/>ಅರಸನು ಹೇಳುವುದೇನೆಂದರೆ: ಹಿಜ್ಕೀಯನ ಮಾತನ್ನು ಕೇಳಿ ಮೋಸಹೋಗಬೇಡಿರಿ ಏಕೆಂದರೆ ಅವನು ನಿಮ್ಮನ್ನು ಬಿಡಿಸಲು ಶಕ್ತನಲ್ಲ. <verse eid="ISA 36:14"/><verse number="15" style="v" sid="ISA 36:15"/>ಇದಲ್ಲದೆ, ‘ಯೆಹೋವ ದೇವರು ನಮ್ಮನ್ನು ನಿಶ್ಚಯವಾಗಿ ರಕ್ಷಿಸುವರೆಂದೂ, ಈ ಪಟ್ಟಣವು ಅಸ್ಸೀರಿಯದ ಅರಸನ ಕೈಯಲ್ಲಿ ಒಪ್ಪಿಸುವುದಿಲ್ಲವೆಂದೂ ಹಿಜ್ಕೀಯನು ನಿಮಗೆ ಯೆಹೋವ ದೇವರಲ್ಲಿ ಭರವಸೆ ಇಡುವಂತೆ ಮಾಡುವರು.’<verse eid="ISA 36:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="ISA 36:16"/>“ಹಿಜ್ಕೀಯನ ಮಾತುಗಳಿಗೆ ಕಿವಿಗೊಡಬೇಡಿರಿ. ಏಕೆಂದರೆ ಅಸ್ಸೀರಿಯದ ಅರಸನು ಹೇಳುವುದೇನೆಂದರೆ, ನನ್ನ ಸಂಗಡ ಒಡಂಬಡಿಕೆ ಮಾಡಿಕೊಂಡು, ನನ್ನ ಬಳಿಗೆ ಹೊರಟುಬನ್ನಿರಿ, ಆಗ ನಿಮ್ಮಲ್ಲಿ ಪ್ರತಿ ಮನುಷ್ಯನು ತನ್ನ ತನ್ನ ದ್ರಾಕ್ಷಾಫಲವನ್ನೂ, ಅಂಜೂರದ ಫಲವನ್ನೂ ತಿಂದು ತನ್ನ ತನ್ನ ಬಾವಿಯ ನೀರನ್ನು ಕುಡಿಯುವನು. <verse eid="ISA 36:16"/><verse number="17" style="v" sid="ISA 36:17"/>ಸ್ವಲ್ಪ ಕಾಲವಾದ ನಂತರ ನಾನು ಬಂದು ನಿಮ್ಮನ್ನು ಧಾನ್ಯ, ದ್ರಾಕ್ಷಾರಸ, ಆಹಾರ, ದ್ರಾಕ್ಷಿತೋಟ, ಇವು ಸಮೃದ್ಧಿಯಾಗಿರುವ ನಿಮ್ಮ ದೇಶಕ್ಕೆ ಸಮಾನವಾಗಿರುವ ಇನ್ನೊಂದು ದೇಶಕ್ಕೆ ಕರೆದುಕೊಂಡು ಹೋಗುವೆನು.<verse eid="ISA 36:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="ISA 36:18"/>“ ‘ಯೆಹೋವ ದೇವರು ನಮ್ಮನ್ನು ರಕ್ಷಿಸುವರು,’ ಎಂದು ಹೇಳಿ ಹಿಜ್ಕೀಯನು ನಿಮ್ಮನ್ನು ಪ್ರೇರೇಪಿಸದಂತೆ ಎಚ್ಚರಿಕೆಯಾಗಿರಿ. ಯಾವ ಜನಾಂಗದ ದೇವರುಗಳಾದರೂ ತನ್ನ ದೇಶಗಳನ್ನು ಅಸ್ಸೀರಿಯದ ಅರಸನ ಕೈಯಿಂದ ಬಿಡಿಸಿದ್ದು ಉಂಟೋ? <verse eid="ISA 36:18"/><verse number="19" style="v" sid="ISA 36:19"/>ಹಮಾತ್, ಅರ್ಪಾದ್, ಸೆಫರ್ವಯಿಮಿನ ದೇವರುಗಳು ಎಲ್ಲಿ? ಅವರು ಸಮಾರ್ಯವನ್ನು ನನ್ನ ಕೈಯಿಂದ ಬಿಡಿಸಿಕೊಂಡರೋ? <verse eid="ISA 36:19"/><verse number="20" style="v" sid="ISA 36:20"/>ಈ ದೇಶಗಳ ಸಮಸ್ತ ದೇವರುಗಳಲ್ಲಿ ಯಾರೂ ತಮ್ಮ ದೇಶವನ್ನು ನನ್ನ ಕೈಯಿಂದ ಬಿಡಿಸಲಾರದ ಮೇಲೆ, ಯೆಹೋವ ದೇವರು ಯೆರೂಸಲೇಮನ್ನು ನನ್ನ ಕೈಗೆ ಸಿಗದಂತೆ ತಪ್ಪಿಸಿ ಕಾಪಾಡುವನೋ?” ಎಂದು ಹೇಳಿದನು.<verse eid="ISA 36:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="ISA 36:21"/>ಆದರೆ ಜನರು ಅವನಿಗೆ ಪ್ರತ್ಯುತ್ತರ ಕೊಡದೆ ಸುಮ್ಮನಿದ್ದರು. ಏಕೆಂದರೆ ಅವನಿಗೆ ಉತ್ತರ ಕೊಡಬೇಡಿರೆಂದು ಅರಸನ ಆಜ್ಞೆಯಾಗಿತ್ತು.<verse eid="ISA 36:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="ISA 36:22"/>ಆಗ ಅರಮನೆಯ ಮೇಲ್ವಿಚಾರಕನಾದ ಹಿಲ್ಕೀಯನ ಮಗ ಎಲ್ಯಾಕೀಮನೂ ಕಾರ್ಯದರ್ಶಿಯಾದ ಶೆಬ್ನನೂ, ದಾಖಲೆಗಾರನಾದ ಆಸಾಫನ ಮಗ ಯೋವ ಎಂಬವನೂ ತಮ್ಮ ಬಟ್ಟೆಗಳನ್ನು ಹರಿದುಕೊಂಡು ಹಿಜ್ಕೀಯನ ಬಳಿಗೆ ಬಂದು ಸೈನ್ಯಾಧಿಕಾರಿಯಾದ ರಬ್ಷಾಕೆ ಹೇಳಿದ ಮಾತುಗಳನ್ನು ಅವನಿಗೆ ತಿಳಿಸಿದರು.<verse eid="ISA 36:22"/></para>
  <chapter eid="ISA 36"/>
  <chapter number="37" style="c" sid="ISA 37"/>
  <para style="s1">ಯೆರೂಸಲೇಮಿನ ಬಿಡುಗಡೆ ಮುಂತಿಳಿಸಿದ್ದು</para>
  <para style="p">
    <verse number="1" style="v" sid="ISA 37:1"/>ಅರಸನಾದ ಹಿಜ್ಕೀಯನು ಅದನ್ನು ಕೇಳಿದಾಗ, ತನ್ನ ಬಟ್ಟೆಗಳನ್ನು ಹರಿದುಕೊಂಡು, ಗೋಣಿ ತಟ್ಟಿನಿಂದ ತನ್ನನ್ನು ಮುಚ್ಚಿಕೊಂಡು, ಯೆಹೋವ ದೇವರ ಆಲಯಕ್ಕೆ ಹೋದನು. <verse eid="ISA 37:1"/><verse number="2" style="v" sid="ISA 37:2"/>ಇದಲ್ಲದೆ ಅವನು ಅರಮನೆಯ ಮೇಲ್ವಿಚಾರಕನಾಗಿದ್ದ ಎಲ್ಯಾಕೀಮ್, ಕಾರ್ಯದರ್ಶಿಯಾದ ಶೆಬ್ನ, ಹಿರಿಯ ಯಾಜಕರು ಇವರನ್ನು ಕರೆಸಿ, “ನೀವು ಗೋಣಿತಟ್ಟನ್ನು ಕಟ್ಟಿಕೊಂಡು ಆಮೋಚನ ಮಗನಾದ ಪ್ರವಾದಿ ಯೆಶಾಯನ ಬಳಿಗೆ ಹೋಗಿರಿ,” ಎಂದು ಹೇಳಿ ಕಳುಹಿಸಿದನು. <verse eid="ISA 37:2"/><verse number="3" style="v" sid="ISA 37:3"/>ಆಗ ಅವರು ಯೆಶಾಯನಿಗೆ, “ಈ ದಿವಸವು ಕಷ್ಟಕರವಾಗಿಯೂ ಗದರಿಕೆಯಾಗಿಯೂ ಅವಮಾನಕರವಾಗಿಯೂ ಇದೆ. ಏಕೆಂದರೆ ಹೆರಿಗೆಯ ಸಮಯವು ಬಂದಿದೆ ಆದರೆ ಹೆರುವುದಕ್ಕೆ ಶಕ್ತಿಯಿಲ್ಲ. <verse eid="ISA 37:3"/><verse number="4" style="v" sid="ISA 37:4"/>ಜೀವಿಸುವ ದೇವರನ್ನು ನಿಂದಿಸಲು ಅಸ್ಸೀರಿಯದ ಅರಸನಿಂದ ಕಳುಹಿಸಲಾಗಿದ್ದ ಸೈನ್ಯಾಧಿಕಾರಿಯ ನಿಂದೆಯ ಮಾತುಗಳನ್ನು ನಿನ್ನ ದೇವರಾದ ಯೆಹೋವ ದೇವರು ಕೇಳಿದ್ದಾರೆ. ನಿನ್ನ ದೇವರಾದ ಯೆಹೋವ ದೇವರು ಅವನ ಮಾತುಗಳಿಗೋಸ್ಕರ ಅವನನ್ನು ಗದರಿಸುವರು. ಆದ್ದರಿಂದ ನೀನು ಉಳಿದಿರುವ ಜನರಿಗಾಗಿ ಅವರನ್ನು ಪ್ರಾರ್ಥಿಸು, ಎಂಬುದಾಗಿ ಹಿಜ್ಕೀಯನು ಅನ್ನುತ್ತಾನೆ,” ಎಂದು ಹೇಳಿದರು.<verse eid="ISA 37:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="ISA 37:5"/>ಅರಸನಾದ ಹಿಜ್ಕೀಯನ ಸೇವಕರು ಯೆಶಾಯನ ಬಳಿಗೆ ಬಂದು ಹೇಳಿದಾಗ, <verse eid="ISA 37:5"/><verse number="6" style="v" sid="ISA 37:6"/>ಯೆಶಾಯನು ಅವರಿಗೆ, “ನೀವು ನಿಮ್ಮ ಯಜಮಾನನಿಗೆ ಹೇಳಬೇಕಾದದ್ದೇನೆಂದರೆ, ‘ಯೆಹೋವ ದೇವರು ಹೀಗೆ ಹೇಳುತ್ತಾರೆ, ನೀನು ಕೇಳಿದಂಥ ಅಸ್ಸೀರಿಯದ ಅರಸನ ಸೇವಕರು ನನ್ನನ್ನು ದೂಷಿಸಿದಂಥ ಮಾತುಗಳನ್ನು ನೀವು ಕೇಳಿದ್ದಕ್ಕೋಸ್ಕರ ಭಯಪಡಬೇಡಿರಿ. <verse eid="ISA 37:6"/><verse number="7" style="v" sid="ISA 37:7"/>ಇಗೋ, ನಾನು ಅವರ ಮೇಲೆ ಆತ್ಮವನ್ನು ಕಳುಹಿಸುವೆನು. ಅವನು ಒಂದು ಸುದ್ದಿಯನ್ನು ಕೇಳಿ ತನ್ನ ದೇಶಕ್ಕೆ ಹಿಂದಿರುಗುವನು. ಇದಲ್ಲದೆ ಅವನು ತನ್ನ ದೇಶದಲ್ಲಿ ಖಡ್ಗಕ್ಕೆ ತುತ್ತಾಗುವಂತೆ ಮಾಡುವೆನು,’ ” ಎಂದು ಹೇಳಿದನು.<verse eid="ISA 37:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="ISA 37:8"/>ಹೀಗೆ ಸೈನ್ಯಾಧಿಕಾರಿಯು ಅಸ್ಸೀರಿಯದ ಅರಸನು ಲಾಕೀಷನ್ನು ಬಿಟ್ಟು ಹೊರಟಿದ್ದಾನೆಂದು ಕೇಳಿದಾಗ, ಅವನು ಲಿಬ್ನಕ್ಕೆ ಹೋಗಿ, ಅಲ್ಲಿ ಅರಸನು ಲಿಬ್ನದವರೊಂದಿಗೆ ಯುದ್ಧಮಾಡುತ್ತಿರುವುದನ್ನು ಕಂಡನು.<verse eid="ISA 37:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="ISA 37:9"/>ಅಷ್ಟರಲ್ಲಿ ಕೂಷನ ಅರಸನಾದ ತಿರ್ಹಾಕನು ತನಗೆ ವಿರೋಧವಾಗಿ ಯುದ್ಧಮಾಡುವುದಕ್ಕೆ ಹೊರಟಿದ್ದಾನೆಂಬ ಸುದ್ದಿಯನ್ನು ಅಸ್ಸೀರಿಯದ ಅರಸನು ಕೇಳಿ, <verse eid="ISA 37:9"/><verse number="10" style="v" sid="ISA 37:10"/>“ಹಿಜ್ಕೀಯನೇ, ನೀನು ನಂಬುವ ದೇವರು, ‘ಯೆರೂಸಲೇಮನ್ನು ಅಸ್ಸೀರಿಯದ ಅರಸನ ಕೈಯಲ್ಲಿ ಒಪ್ಪಿಸುವುದಿಲ್ಲ,’ ಎಂದು ಹೇಳಿ ನಿನ್ನನ್ನು ಮೋಸಗೊಳಿಸಾನು. <verse eid="ISA 37:10"/><verse number="11" style="v" sid="ISA 37:11"/>ಇಗೋ, ಅಸ್ಸೀರಿಯದ ಅರಸರು ಸಮಸ್ತ ದೇಶಗಳನ್ನು ಸಂಪೂರ್ಣವಾಗಿ ನಾಶಮಾಡಿದರೆಂದು ನೀನು ಕೇಳಿದಿಯಲ್ಲಾ. ಹೀಗಿದ್ದ ಮೇಲೆ ನೀನು ಬಿಡುಗಡೆಯಾಗುವೆಯೋ? <verse eid="ISA 37:11"/><verse number="12" style="v" sid="ISA 37:12"/>ನನ್ನ ಪಿತೃಗಳು ಹಾಳುಮಾಡಿದ ಗೋಜಾನ್, ಹಾರಾನ್, ರೆಜೆಫ್ ಮುಂತಾದ ದೇವರುಗಳು ಅವರನ್ನು ಬಿಡುಗಡೆ ಮಾಡಲಿಲ್ಲ. ತೆಲ್ ಅಸ್ಸಾರ್ ಎಂಬಲ್ಲಿದ್ದ ಏದೆನಿನ ಜನರನ್ನು ಈ ದೇವರುಗಳು ಅವರನ್ನು ರಕ್ಷಿಸಲು ಸಾಧ್ಯವಾಯಿತೇ? <verse eid="ISA 37:12"/><verse number="13" style="v" sid="ISA 37:13"/>ಹಮಾತ್, ಅರ್ಪಾದ್, ಸೆಫರ್ವಯಿಮ್, ಹೇನ, ಇವ್ವಾ, ಎಂಬ ಪಟ್ಟಣಗಳ ಅರಸರು ಏನಾದರು ಎಂಬ ನನ್ನ ಮಾತನ್ನು ಯೆಹೂದದ ಅರಸನಾದ ಹಿಜ್ಕೀಯನಿಗೆ ಹೇಳಿರಿ,” ಎಂದು ಪತ್ರ ಬರೆದು ದೂತರ ಮುಖಾಂತರ ಕಳುಹಿಸಿದನು.<verse eid="ISA 37:13"/></para>
  <para style="s1">ಹಿಜ್ಕೀಯನ ಪ್ರಾರ್ಥನೆ</para>
  <para style="p">
    <verse number="14" style="v" sid="ISA 37:14"/>ಹಿಜ್ಕೀಯನು ಆ ದೂತರ ಕೈಯಿಂದ ಪತ್ರವನ್ನು ತೆಗೆದುಕೊಂಡು ಓದಿದನು, ಅನಂತರ ಯೆಹೋವ ದೇವರ ಆಲಯಕ್ಕೆ ಹೋಗಿ ಅದನ್ನು ಯೆಹೋವ ದೇವರ ಮುಂದೆ ತೆರೆದಿಟ್ಟನು. <verse eid="ISA 37:14"/><verse number="15" style="v" sid="ISA 37:15"/>ಇದಲ್ಲದೆ ಹಿಜ್ಕೀಯನು ಯೆಹೋವ ದೇವರ ಮುಂದೆ ಪ್ರಾರ್ಥನೆಮಾಡಿ ಹೇಳಿದ್ದೇನೆಂದರೆ, <verse eid="ISA 37:15"/><verse number="16" style="v" sid="ISA 37:16"/>“ಸೇನಾಧೀಶ್ವರ ಯೆಹೋವ ದೇವರೇ, ಕೆರೂಬಿಗಳ ಮಧ್ಯದಲ್ಲಿ ವಾಸವಾಗಿರುವ ಇಸ್ರಾಯೇಲಿನ ದೇವರಾದ ಯೆಹೋವ ದೇವರೇ, ನೀವೊಬ್ಬರೇ ಭೂಮಿಯ ಸಮಸ್ತ ರಾಜ್ಯಗಳಿಗೆ ದೇವರಾಗಿದ್ದೀರಿ. ನೀವೇ ಆಕಾಶವನ್ನೂ, ಭೂಮಿಯನ್ನೂ ಉಂಟುಮಾಡಿದ್ದೀರಿ. <verse eid="ISA 37:16"/><verse number="17" style="v" sid="ISA 37:17"/>ಯೆಹೋವ ದೇವರೇ, ನಿಮ್ಮ ಕಿವಿಗೊಟ್ಟು ಕೇಳಿರಿ. ಯೆಹೋವ ದೇವರೇ, ನಿಮ್ಮ ಕಣ್ಣುಗಳನ್ನು ತೆರೆದು ನೋಡಿರಿ. ಸನ್ಹೇರೀಬನು ಜೀವವುಳ್ಳ ದೇವರನ್ನು ನಿಂದಿಸಿ ಕಳುಹಿಸಿದ ಮಾತುಗಳನ್ನು ಕೇಳಿರಿ.<verse eid="ISA 37:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="ISA 37:18"/>“ಯೆಹೋವ ದೇವರೇ, ಅಸ್ಸೀರಿಯದ ಅರಸರು ಸಕಲ ಜನಾಂಗಗಳನ್ನೂ ಅವರ ದೇಶಗಳನ್ನೂ ಹಾಳು ಮಾಡಿ, ಅವರ ದೇವತೆಗಳನ್ನು ಬೆಂಕಿಯಲ್ಲಿ ಹಾಕಿದ್ದು ನಿಜ. <verse eid="ISA 37:18"/><verse number="19" style="v" sid="ISA 37:19"/>ಅವು ದೇವರುಗಳಲ್ಲ, ಕೇವಲ ಮನುಷ್ಯರು ಕೆತ್ತಿದ ಕಲ್ಲುಮರಗಳಷ್ಟೆ, ಆದ್ದರಿಂದಲೇ ಅವರು ಅವುಗಳನ್ನು ನಾಶಮಾಡಿದ್ದಾರೆ. <verse eid="ISA 37:19"/><verse number="20" style="v" sid="ISA 37:20"/>ಹೀಗಿರುವುದರಿಂದ, ಈಗ ನಮ್ಮ ದೇವರಾದ ಯೆಹೋವ ದೇವರೇ, ‘ನೀವೊಬ್ಬರೇ ದೇವರಾದ ಯೆಹೋವ ದೇವರಾಗಿದ್ದೀರಿ,’ ಎಂದು ಭೂಮಿಯ ಸಮಸ್ತ ರಾಜ್ಯಗಳೂ ತಿಳಿಯುವ ಹಾಗೆ ನಮ್ಮನ್ನು ಅವನ ಕೈಯಿಂದ ತಪ್ಪಿಸಿ ರಕ್ಷಿಸಿರಿ,” ಎಂದು ಹಿಜ್ಕೀಯನು ಯೆಹೋವ ದೇವರಿಗೆ ಪ್ರಾರ್ಥಿಸಿದನು.<verse eid="ISA 37:20"/></para>
  <para style="s1">ಸನ್ಹೇರೀಬನ ಪತನ</para>
  <para style="p">
    <verse number="21" style="v" sid="ISA 37:21"/>ಆಗ ಆಮೋಚನ ಮಗನಾದ ಯೆಶಾಯನು ಹಿಜ್ಕೀಯನಿಗೆ ಹೇಳಿ ಕಳುಹಿಸಿದ್ದೇನೆಂದರೆ, “ನೀನು ಅಸ್ಸೀರಿಯದ ಅರಸನಾದ ಸನ್ಹೇರೀಬನನ್ನು ಕುರಿತು, ಇಸ್ರಾಯೇಲಿನ ಯೆಹೋವ ದೇವರಿಗೆ ಪ್ರಾರ್ಥನೆ ಮಾಡಿದ್ದನ್ನು ಕೇಳಿ, <verse eid="ISA 37:21"/><verse number="22" style="v" sid="ISA 37:22"/>ಅವನನ್ನು ಕುರಿತು ಯೆಹೋವ ದೇವರು ಹೇಳುವುದೇನೆಂದರೆ:</para>
  <para style="q1" vid="ISA 37:22">“ಕನ್ನಿಕೆಯಾದ ಚೀಯೋನ್</para>
  <para style="q2" vid="ISA 37:22">ಪುತ್ರಿಯು ನಿನ್ನನ್ನು ತಿರಸ್ಕರಿಸಿ,</para>
  <para style="q1" vid="ISA 37:22">ನಿನಗೆ ಅಪಹಾಸ್ಯ ಮಾಡುತ್ತಾಳೆ.</para>
  <para style="q1" vid="ISA 37:22">ಯೆರೂಸಲೇಮಿನ ಪುತ್ರಿಯು</para>
  <para style="q2" vid="ISA 37:22">ನೀನು ಓಡಿ ಹೋಗುವಾಗ ತನ್ನ ತಲೆಯಾಡಿಸುತ್ತಾಳೆ.<verse eid="ISA 37:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="ISA 37:23"/>ನೀನು ಯಾರನ್ನು ನಿಂದಿಸಿ ಯಾರನ್ನು ದೂಷಿಸಿದೆ?</para>
  <para style="q2" vid="ISA 37:23">ಯಾರಿಗೆ ವಿರೋಧವಾಗಿ ನಿನ್ನ ಧ್ವನಿಯನ್ನು ಎತ್ತಿದ್ದೀ?</para>
  <para style="q1" vid="ISA 37:23">ನಿನ್ನ ಕಣ್ಣುಗಳು ಗರ್ವದಿಂದ ನೋಡಿದ್ದು ಯಾರನ್ನು?</para>
  <para style="q2" vid="ISA 37:23">ಇಸ್ರಾಯೇಲಿನ ಪರಿಶುದ್ಧ ದೇವರಿಗೆ ವಿರೋಧವಾಗಿಯಲ್ಲವೇ?<verse eid="ISA 37:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="ISA 37:24"/>ನೀನು ನಿನ್ನ ದೂತರ ಮುಖಾಂತರ</para>
  <para style="q2" vid="ISA 37:24">ಯೆಹೋವ ದೇವರನ್ನು ನಿಂದಿಸಿರುವೆ.</para>
  <para style="q1" vid="ISA 37:24">ಇದಲ್ಲದೆ ನೀನು,</para>
  <para style="q2" vid="ISA 37:24">‘ನಾನು ನನ್ನ ರಥಸಮೂಹದೊಡನೆ</para>
  <para style="q1" vid="ISA 37:24">ಪರ್ವತಗಳ ಶಿಖರಗಳನ್ನು ಹತ್ತಿದ್ದೇನೆ.</para>
  <para style="q2" vid="ISA 37:24">ಲೆಬನೋನಿನ ಎತ್ತರಗಳಿಗೆ ಹೋಗಿದ್ದೇನೆ.</para>
  <para style="q1" vid="ISA 37:24">ಅದರ ಉನ್ನತವಾದ ದೇವದಾರುಗಳನ್ನೂ</para>
  <para style="q2" vid="ISA 37:24">ಅತ್ಯುತ್ತಮ ತುರಾಯಿ ಮರಗಳನ್ನೂ ಕಡಿದುಹಾಕಿದ್ದೇನೆ.</para>
  <para style="q1" vid="ISA 37:24">ಅದರ ಅಂಚಿನ ಉನ್ನತವಾದ ಸ್ಥಳವನ್ನೂ,</para>
  <para style="q2" vid="ISA 37:24">ಅದರ ಫಲಭರಿತ ಅಡವಿಯಲ್ಲಿಯೂ ಪ್ರವೇಶಿಸಿದ್ದೇನೆ.<verse eid="ISA 37:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="ISA 37:25"/>ಪರದೇಶಗಳಲ್ಲಿ ನಾನು ಬಾವಿಗಳನ್ನು ಅಗೆದು,</para>
  <para style="q2" vid="ISA 37:25">ನೀರು ಕುಡಿದಿದ್ದೇನೆ.</para>
  <para style="q1" vid="ISA 37:25">ನನ್ನ ಅಂಗಾಲುಗಳಿಂದ</para>
  <para style="q2" vid="ISA 37:25">ಈಜಿಪ್ಟಿನವರ ಎಲ್ಲಾ ನದಿಗಳನ್ನು ಬತ್ತಿಹೋಗುವಂತೆ ಮಾಡಿದ್ದೇನೆ,</para>
  <para style="q2" vid="ISA 37:25">ಎಂದು ಕೊಚ್ಚಿಕೊಂಡಿದ್ದೀ.’<verse eid="ISA 37:25"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="26" style="v" sid="ISA 37:26"/>“ಹೀಗಾಗಬೇಕೆಂದು ಬಹಳ ದಿನಗಳ ಹಿಂದೆಯೇ</para>
  <para style="q2" vid="ISA 37:26">ನಿರ್ಣಯಿಸಿದ್ದನ್ನು ನೀನು ಕೇಳಲಿಲ್ಲವೋ?</para>
  <para style="q1" vid="ISA 37:26">ಪುರಾತನ ದಿನಗಳಲ್ಲಿ ನಾನು ಯೋಚಿಸಿದ್ದನ್ನು,</para>
  <para style="q2" vid="ISA 37:26">ಈಗ ನಾನು ಅದನ್ನು ನೆರವೇರಿಸಿದ್ದೇನೆ.</para>
  <para style="q1" vid="ISA 37:26">ಆದ್ದರಿಂದಲೇ ನೀನು ಕೋಟೆಗಳುಳ್ಳ ಪಟ್ಟಣಗಳನ್ನು</para>
  <para style="q2" vid="ISA 37:26">ಹಾಳಾದ ದಿಬ್ಬಗಳಾಗಿ ಮಾಡಿಬಿಟ್ಟಿರುವೆ<verse eid="ISA 37:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="ISA 37:27"/>ಆದ್ದರಿಂದ ಅವುಗಳ ನಿವಾಸಿಗಳು ಬಲಹೀನರಾಗಿ</para>
  <para style="q2" vid="ISA 37:27">ಹೆದರಿ ಆಶಾಭಂಗಹೊಂದಿ ನಾಚಿಕೆಪಟ್ಟರು.</para>
  <para style="q1" vid="ISA 37:27">ಅವರು ಹೊಲದ ಹುಲ್ಲಿನಂತೆಯೂ,</para>
  <para style="q2" vid="ISA 37:27">ಹಸಿರು ಸಸಿಗಳಂತೆಯೂ,</para>
  <para style="q1" vid="ISA 37:27">ಮಾಳಿಗೆಯ ಮೇಲಿನ ಹುಲ್ಲಿನಂತೆಯೂ,</para>
  <para style="q2" vid="ISA 37:27">ಬೆಳೆಯುವುದಕ್ಕಿಂತ ಮುಂಚೆಯೇ ಬಾಡಿಹೋಗುವ ಪೈರಿನಂತೆಯೂ ಅವರಿದ್ದಾರೆ.<verse eid="ISA 37:27"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="28" style="v" sid="ISA 37:28"/>“ಆದರೆ ನೀನು ಎಲ್ಲಿ ವಾಸಿಸುವೆಯೆಂಬುದನ್ನು</para>
  <para style="q2" vid="ISA 37:28">ನೀನು ಯಾವಾಗ ಬರುವೆ ಹೋಗುವೆ ಎಂಬುದನ್ನು</para>
  <para style="q2" vid="ISA 37:28">ನೀನು ನನ್ನ ಮೇಲೆ ಹೇಗೆ ಕೋಪಿಸಿಕೊಳ್ಳುವೆ? ಎಂಬುದನ್ನು ನಾನು ಬಲ್ಲೆನು.<verse eid="ISA 37:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="ISA 37:29"/>ನೀನು ನನಗೆ ವಿರೋಧವಾಗಿ ಮಾಡುವ ನಿನ್ನ ರೌದ್ರವೂ</para>
  <para style="q2" vid="ISA 37:29">ನಿನ್ನ ಅಹಂಕಾರವೂ ನನ್ನ ಕಿವಿಗಳಿಗೆ ತಲುಪಿದೆ.</para>
  <para style="q1" vid="ISA 37:29">ಆದ್ದರಿಂದ ನಾನು ನನ್ನ ಕೊಂಡಿಯನ್ನು ನಿನ್ನ ಮೂಗಿನಲ್ಲಿಯೂ;</para>
  <para style="q2" vid="ISA 37:29">ನನ್ನ ಕಡಿವಾಣವನ್ನು ನಿನ್ನ ಬಾಯಲ್ಲಿಯೂ ಹಾಕಿ,</para>
  <para style="q1" vid="ISA 37:29">ನೀನು ಬಂದ ದಾರಿಯಿಂದಲೇ</para>
  <para style="q2" vid="ISA 37:29">ನಿನ್ನನ್ನು ಹಿಂದಿರುಗಿಸುವೆನು.<verse eid="ISA 37:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="ISA 37:30"/>“ಹಿಜ್ಕೀಯನೇ,</para>
  <para style="q1" vid="ISA 37:30">“ಈ ವರ್ಷದಲ್ಲಿ ತನ್ನಷ್ಟಕ್ಕೆ ತಾನೇ ಬೆಳೆದದ್ದನ್ನೂ</para>
  <para style="q2" vid="ISA 37:30">ಎರಡನೆಯ ವರ್ಷದಲ್ಲಿ ಅದರಿಂದ ಮೊಳೆತದ್ದನ್ನೂ ತಿನ್ನುವಿರಿ.</para>
  <para style="q1" vid="ISA 37:30">ಆದರೆ ಮೂರನೆಯ ವರ್ಷದಲ್ಲಿ ನೀವು ಬೀಜವನ್ನು ಬಿತ್ತಿ ಕೊಯ್ಯುವಿರಿ.</para>
  <para style="q2" vid="ISA 37:30">ದ್ರಾಕ್ಷಿತೋಟಗಳಲ್ಲಿ ವ್ಯವಸಾಯಮಾಡಿ,</para>
  <para style="q2" vid="ISA 37:30">ಅವುಗಳ ಫಲಗಳನ್ನು ತಿನ್ನುವುದೇ ನಿಮಗೆ ಸಂಕೇತವಾಗಿರುವದು.<verse eid="ISA 37:30"/></para>
  <para style="q1">
    <verse number="31" style="v" sid="ISA 37:31"/>ಯೆಹೂದದ ಮನೆತನದಲ್ಲಿ ತಪ್ಪಿಸಿಕೊಂಡು ಉಳಿದವರು ತಿರುಗಿ,</para>
  <para style="q2" vid="ISA 37:31">ದೇಶದಲ್ಲಿ ಬೇರೂರಿ ನೆಲೆಗೊಂಡು ಅಭಿವೃದ್ಧಿಯಾಗುವರು.<verse eid="ISA 37:31"/></para>
  <para style="q1">
    <verse number="32" style="v" sid="ISA 37:32"/>ಏಕೆಂದರೆ ಯೆರೂಸಲೇಮಿನಿಂದ ಉಳಿದವರೂ,</para>
  <para style="q2" vid="ISA 37:32">ಚೀಯೋನ್ ಪರ್ವತದಿಂದ ತಪ್ಪಿಸಿಕೊಂಡವರೂ ಹೊರಡುವರು.</para>
  <para style="q1" vid="ISA 37:32">ಸೇನಾಧೀಶ್ವರ ಯೆಹೋವ ದೇವರ</para>
  <para style="q2" vid="ISA 37:32">ಆಸಕ್ತಿಯು ಇದನ್ನು ನೆರವೇರಿಸುವುದು.<verse eid="ISA 37:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="ISA 37:33"/>“ಆದ್ದರಿಂದ ಯೆಹೋವ ದೇವರು ಅಸ್ಸೀರಿಯದ ಅರಸನನ್ನು ಕುರಿತು ಹೀಗೆ ಹೇಳುತ್ತಾರೆ:</para>
  <para style="q1" vid="ISA 37:33">“ಅವನು ಈ ಪಟ್ಟಣದೊಳಗೆ ಬರುವುದಿಲ್ಲ.</para>
  <para style="q2" vid="ISA 37:33">ಅಲ್ಲಿ ಬಾಣವನ್ನು ಎಸೆಯುವುದಿಲ್ಲ.</para>
  <para style="q1" vid="ISA 37:33">ಗುರಾಣಿಯೊಂದಿಗೆ ಅದರ ಮುಂದೆ ಬರಲಾರನು.</para>
  <para style="q2" vid="ISA 37:33">ಅದಕ್ಕೆ ವಿರೋಧವಾಗಿ ಮುತ್ತಿಗೆ ಹಾಕಲು ದಿಬ್ಬವನ್ನು ನಿರ್ಮಿಸುವುದಿಲ್ಲ.<verse eid="ISA 37:33"/></para>
  <para style="q1">
    <verse number="34" style="v" sid="ISA 37:34"/>ಅವನು ಬಂದ ದಾರಿಯಿಂದಲೇ ಹಿಂದಿರುಗಿ ಹೋಗುವನು,</para>
  <para style="q2" vid="ISA 37:34">ಈ ಪಟ್ಟಣದೊಳಗೆ ಬರುವುದೇ ಇಲ್ಲ,”</para>
  <para style="q2" vid="ISA 37:34">ಎಂದು ಯೆಹೋವ ದೇವರು ಹೇಳುತ್ತಾರೆ.<verse eid="ISA 37:34"/></para>
  <para style="q1">
    <verse number="35" style="v" sid="ISA 37:35"/>“ಈ ಪಟ್ಟಣವನ್ನು ನನಗೋಸ್ಕರವೂ</para>
  <para style="q2" vid="ISA 37:35">ನನ್ನ ಸೇವಕನಾದ ದಾವೀದನಿಗೋಸ್ಕರವೂ ಕಾಪಾಡಿ ಅದನ್ನು ರಕ್ಷಿಸುವೆನು.”<verse eid="ISA 37:35"/></para>
  <para style="p">
    <verse number="36" style="v" sid="ISA 37:36"/>ಆಗ ಯೆಹೋವ ದೇವರ ದೂತನು ಹೊರಟುಬಂದು ಅಸ್ಸೀರಿಯದ ದಂಡಿನಲ್ಲಿದ್ದ 1,85,000 ಜನರನ್ನು ಸಂಹರಿಸಿದನು. ಉದಯದಲ್ಲಿ ಜನರು ಎದ್ದಾಗ, ಇಗೋ, ಅವರೆಲ್ಲರು ಸತ್ತು ಹೆಣಗಳಾಗಿದ್ದರು. <verse eid="ISA 37:36"/><verse number="37" style="v" sid="ISA 37:37"/>ಆಗ ಅಸ್ಸೀರಿಯದ ಅರಸನಾದ ಸನ್ಹೇರೀಬನು ಹಿಂದಿರುಗಿ ನಿನೆವೆ ಪಟ್ಟಣಕ್ಕೆ ಹೋಗಿ ಅಲ್ಲಿ ವಾಸಿಸಿದನು.<verse eid="ISA 37:37"/></para>
  <para style="p">
    <verse number="38" style="v" sid="ISA 37:38"/>ಒಂದು ದಿನ ಅವನು ತನ್ನ ದೇವರಾದ ನಿಸ್ರೋಕನ ಒಂದು ದಿನ ಅವನು ತನ್ನ ದೇವರಾದ ನಿಸ್ರೋಕನ ಆಲಯದಲ್ಲಿ ಆರಾಧನೆ ಮಾಡುತ್ತಿರುವಾಗ, ಅವನ ಮಕ್ಕಳಾದ ಅದ್ರಮ್ಮೆಲೆಕ್, ಸರೆಚೆರ್ ಎಂಬವರು ಅವನನ್ನು ಖಡ್ಗದಿಂದ ಕೊಂದು, ಅರಾರಾಟ್ ದೇಶಕ್ಕೆ ತಪ್ಪಿಸಿಕೊಂಡು ಹೋದರು. ಅವನ ಮಗ ಏಸರ್‌ಹದ್ದೋನನು ಅವನಿಗೆ ಬದಲಾಗಿ ಅರಸನಾದನು.<verse eid="ISA 37:38"/></para>
  <chapter eid="ISA 37"/>
  <chapter number="38" style="c" sid="ISA 38"/>
  <para style="s1">ಹಿಜ್ಕೀಯನ ಅಸ್ವಸ್ಥತೆ</para>
  <para style="p">
    <verse number="1" style="v" sid="ISA 38:1"/>ಆ ದಿವಸಗಳಲ್ಲಿ ಹಿಜ್ಕೀಯನು ರೋಗದಿಂದ ಮರಣಾವಸ್ಥೆಯಲ್ಲಿದ್ದನು. ಆಗ ಆಮೋಚನ ಮಗನಾದ ಪ್ರವಾದಿ ಯೆಶಾಯನು ಅವನ ಬಳಿಗೆ ಬಂದು ಅವನಿಗೆ, “ನೀನು ನಿನ್ನ ಮನೆಯನ್ನು ವ್ಯವಸ್ಥೆ ಮಾಡಿಕೋ, ಏಕೆಂದರೆ ನೀನು ಬದುಕದೆ ಸಾಯುವೆ, ಎಂದು ಯೆಹೋವ ದೇವರು ಹೇಳುತ್ತಾರೆ,” ಎಂದು ಹೇಳಿದನು.<verse eid="ISA 38:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="ISA 38:2"/>ಆಗ ಹಿಜ್ಕೀಯನು ತನ್ನ ಮುಖವನ್ನು ಗೋಡೆಯ ಕಡೆಗೆ ತಿರುಗಿಸಿ ಯೆಹೋವ ದೇವರನ್ನು ಪ್ರಾರ್ಥಿಸಿದನು. <verse eid="ISA 38:2"/><verse number="3" style="v" sid="ISA 38:3"/>“ಯೆಹೋವ ದೇವರೇ, ನಾನು ಸತ್ಯದಿಂದಲೂ, ಪೂರ್ಣಹೃದಯದಿಂದಲೂ ನಿಮ್ಮ ಮುಂದೆ ನಡೆದು, ನಿಮ್ಮ ದೃಷ್ಟಿಯಲ್ಲಿ ಒಳ್ಳೆಯದನ್ನು ಮಾಡಿದ್ದೇನೆಂಬುದನ್ನು ಜ್ಞಾಪಕಕ್ಕೆ ತಂದುಕೊಳ್ಳಿರಿ,” ಎಂದು ಬೇಡಿಕೊಂಡನು. ಹೀಗೆ ಹಿಜ್ಕೀಯನು ವ್ಯಥೆಪಟ್ಟು ಅತ್ತನು.<verse eid="ISA 38:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="ISA 38:4"/>ಆಗ ಯೆಹೋವ ದೇವರ ವಾಕ್ಯವು ಯೆಶಾಯನಿಗೆ ಬಂದಿತು, <verse eid="ISA 38:4"/><verse number="5" style="v" sid="ISA 38:5"/>“ನೀನು ಹೋಗಿ ಹಿಜ್ಕೀಯನಿಗೆ ಹೀಗೆ ಹೇಳು, ‘ನಿನ್ನ ತಂದೆಯಾದ ದಾವೀದನ ದೇವರಾದ ಯೆಹೋವ ದೇವರು ಹೇಳಿದ್ದೇನೆಂದರೆ: ನಾನು ನಿನ್ನ ಪ್ರಾರ್ಥನೆಯನ್ನು ಕೇಳಿದ್ದೇನೆ, ನಿನ್ನ ಕಣ್ಣೀರನ್ನೂ ಕಂಡಿದ್ದೇನೆ. ನಿನ್ನ ಆಯುಷ್ಯಕ್ಕೆ ಹದಿನೈದು ವರ್ಷಗಳನ್ನು ಹೆಚ್ಚಾಗಿ ಕೂಡಿಸುತ್ತೇನೆ. <verse eid="ISA 38:5"/><verse number="6" style="v" sid="ISA 38:6"/>ನಿನ್ನನ್ನೂ ಈ ಪಟ್ಟಣವನ್ನೂ ಅಸ್ಸೀರಿಯದ ಅರಸನ ಕೈಯಿಂದ ಬಿಡಿಸುವೆನು. ಈ ಪಟ್ಟಣವನ್ನು ಕಾಪಾಡುವೆನು.<verse eid="ISA 38:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="ISA 38:7"/>“ ‘ಯೆಹೋವ ದೇವರು ತಾವು ನುಡಿದದ್ದನ್ನು ನೆರವೇರಿಸುವರು ಎಂಬುದಕ್ಕೆ ಈ ಗುರುತನ್ನು ಕಾಣುವೆ. <verse eid="ISA 38:7"/><verse number="8" style="v" sid="ISA 38:8"/>ಇಗೋ, ಸೂರ್ಯನ ಇಳಿತವನ್ನು ಆಹಾಜನ ಸೋಪಾನ ಪಂಕ್ತಿಯಲ್ಲಿ ಮುಂದೆ ಹೋಗಿದ್ದ ನೆರಳು ಹತ್ತು ಮೆಟ್ಟಲು ಹಿಂದಕ್ಕೆ ಬರುವುದು,’ ” ಎಂದನು. ಅದರಂತೆಯೇ ಮುಂದೆ ಹೋಗಿದ್ದ ನೆರಳು ಹತ್ತು ಮೆಟ್ಟಲು ಹಿಂದಕ್ಕೆ ಬಂದಿತು.<verse eid="ISA 38:8"/></para>
  <para style="b"/>
  <para style="p">
    <verse number="9" style="v" sid="ISA 38:9"/>ಯೆಹೂದದ ಅರಸನಾದ ಹಿಜ್ಕೀಯನು ರೋಗದಿಂದ ಗುಣಹೊಂದಿದ ನಂತರ ಬರೆದದ್ದು:<verse eid="ISA 38:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 38:10"/>“ನನ್ನ ಜೀವನದ ಮಧ್ಯಪ್ರಾಯದಲ್ಲೇ</para>
  <para style="q2" vid="ISA 38:10">ನಾನು ಪಾತಾಳದ ದ್ವಾರದೊಳಗೆ ಹೋಗಬೇಕು.</para>
  <para style="q1" vid="ISA 38:10">ನನ್ನ ಆಯುಷ್ಯದಲ್ಲಿ ಕಳೆದು ಉಳಿದ ವರುಷಗಳು ನನಗೆ ತಪ್ಪಿಹೋಯಿತು,”</para>
  <para style="q2" vid="ISA 38:10">ಎಂದು ನಾನು ಅಂದುಕೊಂಡೆನು.<verse eid="ISA 38:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 38:11"/>ನಾನು ಹೀಗೆ ಯೋಚಿಸಿದೆ, “ಯೆಹೋವ ದೇವರನ್ನು ಜೀವಿತರ</para>
  <para style="q2" vid="ISA 38:11">ದೇಶದಲ್ಲಿ ಯೆಹೋವ ದೇವರನ್ನು ಕಾಣೆನೆಂದುಕೊಂಡೆನು;</para>
  <para style="q1" vid="ISA 38:11">ಭೂಲೋಕ ನಿವಾಸಿಗಳಲ್ಲಿ</para>
  <para style="q2" vid="ISA 38:11">ಒಬ್ಬ ಮನುಷ್ಯನನ್ನೂ ಕಾಣೆನೆಂದುಕೊಂಡೆನು.<verse eid="ISA 38:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 38:12"/>ನನ್ನ ಆಶ್ರಯವು ಕುರುಬನ ಗುಡಾರದಂತೆ</para>
  <para style="q2" vid="ISA 38:12">ಕಿತ್ತು ನನ್ನ ಕಡೆಯಿಂದ ಒಯ್ಯಲಾಗಿದೆ.</para>
  <para style="q1" vid="ISA 38:12">ದೇವರು ನನ್ನ ಆಯುಷ್ಯದ ಹಾಸನ್ನು ಕತ್ತರಿಸಿದ್ದರಿಂದ</para>
  <para style="q2" vid="ISA 38:12">ನೆಯಿಗೆಯವನಂತೆ ನನ್ನ ಜೀವಮಾನವನ್ನು ಸುತ್ತಿಬಿಟ್ಟಿದ್ದೇನೆ;</para>
  <para style="q2" vid="ISA 38:12">ಹಗಲುರಾತ್ರಿ ದೇವರೇ, ನೀವು ನನ್ನನ್ನು ಅಂತ್ಯಗೊಳಿಸುತ್ತೀರಿ.<verse eid="ISA 38:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="ISA 38:13"/>ಹೌದು, ದೇವರು ಸಿಂಹದಂತೆ ನನ್ನ ಎಲುಬುಗಳನ್ನೆಲ್ಲಾ ಮುರಿಯುತ್ತಿದ್ದರೂ,</para>
  <para style="q2" vid="ISA 38:13">ಬೆಳಗಿನತನಕ ತಡೆದುಕೊಂಡೇ ಇದ್ದೆನು.</para>
  <para style="q2" vid="ISA 38:13">ನೀವು ನನ್ನನ್ನು ಅಂತ್ಯಗೊಳಿಸುತ್ತೀರಲ್ಲಾ ಎಂದು ಹಗಲುರಾತ್ರಿ ಪ್ರಲಾಪಿಸಿದೆನು.<verse eid="ISA 38:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="ISA 38:14"/>ನಾನು ಬಾನಕ್ಕಿಯಂತೆಯೂ,</para>
  <para style="q2" vid="ISA 38:14">ಬಕದಂತೆಯೂ ಕೀಚುಗುಟ್ಟಿದೆನು. ಪಾರಿವಾಳದಂತೆ ಗುಬ್ಬಳಿಸುತ್ತಿದ್ದೆನು.</para>
  <para style="q1" vid="ISA 38:14">ನನ್ನ ಕಣ್ಣುಗಳು ಮೇಲಕ್ಕೆ ನೋಡುವುದರಿಂದ ಕ್ಷೀಣವಾದವು.</para>
  <para style="q2" vid="ISA 38:14">ಕರ್ತದೇವರೇ, ನಾನು ಬಾಧೆಪಡುತ್ತಿದ್ದೇನೆ, ನೀವು ನನಗೆ ಆಶ್ರಯರಾಗಿರಿ.”<verse eid="ISA 38:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="ISA 38:15"/>ಆದರೆ, ನಾನು ಏನು ಹೇಳಲಿ,</para>
  <para style="q2" vid="ISA 38:15">ಆತನು ನನಗೆ ಮಾತುಕೊಟ್ಟು, ತಾನೇ ಅದನ್ನು ನೆರವೇರಿಸಿದ್ದಾನೆ.</para>
  <para style="q1" vid="ISA 38:15">ನನ್ನ ಆತ್ಮಕ್ಕೆ ಸಂಭವಿಸಿದ ದುಃಖದಲ್ಲಿ</para>
  <para style="q2" vid="ISA 38:15">ನನ್ನ ವರುಷಗಳಲ್ಲೆಲ್ಲಾ ವಿನಯದಿಂದ ನಡೆಯುವೆನು.<verse eid="ISA 38:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="ISA 38:16"/>ಕರ್ತದೇವರೇ, ಇಂಥಾ ಸಂಬಂಧಗಳಿಂದ ಮನುಷ್ಯರು ಬದುಕುತ್ತಾರೆ.</para>
  <para style="q2" vid="ISA 38:16">ಇವೆಲ್ಲವುಗಳಿಂದಲೇ ನನ್ನ ಆತ್ಮದಲ್ಲಿ ಜೀವವುಂಟು.</para>
  <para style="q1" vid="ISA 38:16">ಹೀಗೆ ನನ್ನನ್ನು ನೀವು ಸ್ವಸ್ಥಮಾಡಿ</para>
  <para style="q2" vid="ISA 38:16">ಬದುಕುವಂತೆ ಮಾಡಿದಿರಿ.<verse eid="ISA 38:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="ISA 38:17"/>ಆ ಬಹು ವ್ಯಥೆಯು ನನ್ನ</para>
  <para style="q2" vid="ISA 38:17">ಸಮಾಧಾನಕ್ಕಾಗಿಯೇ ಆಯಿತು.</para>
  <para style="q1" vid="ISA 38:17">ಆದರೆ ನನ್ನ ಆತ್ಮವನ್ನು ನಾಶದಿಂದ</para>
  <para style="q2" vid="ISA 38:17">ಬಿಡುಗಡೆ ಮಾಡಿದ್ದು ನಿಮ್ಮ ಪ್ರೀತಿಯೇ.</para>
  <para style="q1" vid="ISA 38:17">ನನ್ನ ಪಾಪಗಳನ್ನೆಲ್ಲಾ ನಿನ್ನ</para>
  <para style="q2" vid="ISA 38:17">ಬೆನ್ನಿನ ಹಿಂದೆ ಹಾಕಿಬಿಟ್ಟಿದ್ದೀ.<verse eid="ISA 38:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="ISA 38:18"/>ಸಮಾಧಿಯು ನಿನ್ನನ್ನು ಹೊಗಳುವುದಿಲ್ಲ.</para>
  <para style="q2" vid="ISA 38:18">ಮರಣವು ನಿನ್ನನ್ನು ಕೊಂಡಾಡುವುದಿಲ್ಲ.</para>
  <para style="q1" vid="ISA 38:18">ಕುಣಿಯೊಳಕ್ಕೆ ಹೋಗುವವರು</para>
  <para style="q2" vid="ISA 38:18">ನಿಮ್ಮ ಸತ್ಯತೆಯಲ್ಲಿ ಭರವಸವಿಡಲಾರರು.<verse eid="ISA 38:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="ISA 38:19"/>ಜೀವಂತನು; ಜೀವಂತನೇ ನಿನ್ನನ್ನು ಸ್ತುತಿಸುವೆನು.</para>
  <para style="q2" vid="ISA 38:19">ಹೌದು, ಜೀವಂತನಾದ</para>
  <para style="q1" vid="ISA 38:19">ನಾನೇ ಈ ಹೊತ್ತು ನಿಮ್ಮನ್ನು ಹೊಗಳುವೆನು.</para>
  <para style="q2" vid="ISA 38:19">ತಂದೆಯು ಮಕ್ಕಳಿಗೆ ನಿಮ್ಮ ನಿಷ್ಠೆಯನ್ನು ಬೋಧಿಸುವನು.<verse eid="ISA 38:19"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="20" style="v" sid="ISA 38:20"/>ಯೆಹೋವ ದೇವರು ನನ್ನನ್ನು ರಕ್ಷಿಸುವರು.</para>
  <para style="q2" vid="ISA 38:20">ಆದ್ದರಿಂದ ಯೆಹೋವ ದೇವರ ಆಲಯದಲ್ಲಿ</para>
  <para style="q1" vid="ISA 38:20">ನಮ್ಮ ಜೀವಮಾನದ ದಿವಸಗಳಲ್ಲೆಲ್ಲಾ</para>
  <para style="q2" vid="ISA 38:20">ತಂತಿವಾದ್ಯಗಳಿಂದ ನಮ್ಮ ಹಾಡುಗಳನ್ನು ನಾವು ಹಾಡುವೆವು.<verse eid="ISA 38:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="ISA 38:21"/>“ಅಂಜೂರದ ಹಣ್ಣುಗಳ ಉಂಡೆಯನ್ನು ತರಿಸಿ, ಹುಣ್ಣಿನ ಮೇಲೆ ಇಟ್ಟರೆ, ಅವನು ಗುಣಹೊಂದುವನು,” ಎಂದು ಯೆಶಾಯನು ಹೇಳಿದನು.<verse eid="ISA 38:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="ISA 38:22"/>ಇದಲ್ಲದೆ ಹಿಜ್ಕೀಯನು, “ನಾನು ಯೆಹೋವ ದೇವರ ಆಲಯಕ್ಕೆ ಹೋಗುವೆನೆಂಬುದಕ್ಕೆ ನನಗೆ ಗುರುತೇನು?” ಎಂದು ಕೇಳಿದ್ದನು.<verse eid="ISA 38:22"/></para>
  <chapter eid="ISA 38"/>
  <chapter number="39" style="c" sid="ISA 39"/>
  <para style="s1">ಬಾಬಿಲೋನಿನಿಂದ ದೂತರು</para>
  <para style="p">
    <verse number="1" style="v" sid="ISA 39:1"/>ಅದೇ ಕಾಲದಲ್ಲಿ ಬಲದಾನನ ಮಗನೂ, ಬಾಬಿಲೋನಿನ ಅರಸನೂ ಆದ ಮೆರೋದಕ್ ಬಲದಾನ್ ಎಂಬವನು, ಹಿಜ್ಕೀಯನು ಅಸ್ವಸ್ಥನಾಗಿದ್ದು ಗುಣಹೊಂದಿದನು ಎಂದು ಕೇಳಿದ್ದರಿಂದ ಪತ್ರಗಳನ್ನೂ, ಉಡುಗೊರೆಗಳನ್ನೂ ಕಳುಹಿಸಿದನು. <verse eid="ISA 39:1"/><verse number="2" style="v" sid="ISA 39:2"/>ಹಿಜ್ಕೀಯನು ಅದಕ್ಕೆ ಸಂತೋಷಪಟ್ಟು ಅವರಿಗೆ ಬೆಳ್ಳಿ, ಬಂಗಾರ, ಸುಗಂಧದ್ರವ್ಯ, ಪರಿಮಳ ತೈಲ ಮೊದಲಾದ ಅಮೂಲ್ಯ ಪದಾರ್ಥಗಳಿರುವ ಮನೆಯನ್ನೂ, ಆಯುಧ ಶಾಲೆಯನ್ನೂ, ತನ್ನ ಭಂಡಾರದಲ್ಲಿ ಇರುವುದೆಲ್ಲವನ್ನೂ ತೋರಿಸಿದನು. ಹೀಗೆ ಹಿಜ್ಕೀಯನು ತನ್ನ ಅರಮನೆಯಲ್ಲಿಯೂ, ತನ್ನ ಸಮಸ್ತ ರಾಜ್ಯದಲ್ಲಿಯೂ ಅವರಿಗೆ ತೋರಿಸದಿದ್ದ ವಸ್ತುವು ಒಂದೂ ಇರಲಿಲ್ಲ.<verse eid="ISA 39:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="ISA 39:3"/>ಆಗ ಪ್ರವಾದಿಯಾದ ಯೆಶಾಯನು ಅರಸನಾದ ಹಿಜ್ಕೀಯನ ಬಳಿಗೆ ಬಂದು ಅವನಿಗೆ, “ಆ ಮನುಷ್ಯರು ಎಲ್ಲಿಂದ ಬಂದವರು ಮತ್ತು ಅವರು ನಿನಗೆ ಏನು ಹೇಳಿದರು?” ಎಂದು ಕೇಳಿದನು.</para>
  <para style="p" vid="ISA 39:3">ಹಿಜ್ಕೀಯನು, “ಅವರು ಬಹುದೂರ ದೇಶವಾದ ಬಾಬಿಲೋನಿನಿಂದ ನನ್ನ ಬಳಿಗೆ ಬಂದವರು,” ಎಂದು ಹೇಳಿದನು.<verse eid="ISA 39:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="ISA 39:4"/>ಅದಕ್ಕೆ ಯೆಶಾಯನು ಪುನಃ ಅವನನ್ನು, “ಅವರು ನಿನ್ನ ಅರಮನೆಯಲ್ಲಿ ಏನನ್ನು ನೋಡಿದರು?” ಎಂದು ಕೇಳಿದನು.</para>
  <para style="p" vid="ISA 39:4">ಹಿಜ್ಕೀಯನು, “ನನ್ನ ಅರಮನೆಯಲ್ಲಿ ಇರುವುದೆಲ್ಲವನ್ನು ಅವರು ನೋಡಿದರು, ನನ್ನ ಭಂಡಾರದಲ್ಲಿ ನಾನು ಅವರಿಗೆ ತೋರಿಸದೆ ಇದ್ದದ್ದು ಏನೂ ಇಲ್ಲ,” ಎಂದು ಉತ್ತರಕೊಟ್ಟನು.<verse eid="ISA 39:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="ISA 39:5"/>ಆಗ ಯೆಶಾಯನು ಹಿಜ್ಕೀಯನಿಗೆ, “ಸೇನಾಧೀಶ್ವರ ಯೆಹೋವ ದೇವರ ವಾಕ್ಯವನ್ನು ಕೇಳು. <verse eid="ISA 39:5"/><verse number="6" style="v" sid="ISA 39:6"/>ಇಗೋ, ನಿನ್ನ ಪೂರ್ವಿಕರ ಕಾಲದಿಂದ ಇಂದಿನವರೆಗೂ ನಿನ್ನ ಅರಮನೆಯಲ್ಲಿ ಸಂಗ್ರಹವಾದದ್ದೆಲ್ಲವೂ ಬಾಬಿಲೋನಿಗೆ ಕೊಂಡೊಯ್ಯುವ ದಿವಸ ಬರುವುದು. ಇಲ್ಲಿ ಏನೂ ಉಳಿಯುವುದಿಲ್ಲ ಎಂದು ಯೆಹೋವ ದೇವರು ಹೇಳಿದರು. <verse eid="ISA 39:6"/><verse number="7" style="v" sid="ISA 39:7"/>ಬಾಬಿಲೋನಿನವರು ನಿನ್ನಿಂದ ಹುಟ್ಟುವಂಥ, ನಿನ್ನ ಮಕ್ಕಳಲ್ಲಿ ಕೆಲವರನ್ನು ತೆಗೆದುಕೊಂಡು ಹೋಗುವರು, ಅವರು ಬಾಬಿಲೋನಿನ ರಾಜನ ಅರಮನೆಯಲ್ಲಿ ಕಂಚುಕಿಗಳಾಗಿರುವರು,” ಎಂದನು.<verse eid="ISA 39:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="ISA 39:8"/>ಆಗ ಹಿಜ್ಕೀಯನು, “ಹೇಗೂ ನನ್ನ ಜೀವಮಾನದಲ್ಲಿ ಸಮಾಧಾನವು, ಭದ್ರತೆಯೂ ಇರುವುವು,” ಎಂದುಕೊಂಡು ಯೆಶಾಯನಿಗೆ, “ನೀನು ಹೇಳಿದ ಯೆಹೋವ ದೇವರ ವಾಕ್ಯವು ಒಳ್ಳೆಯದೇ!” ಎಂದನು.<verse eid="ISA 39:8"/></para>
  <chapter eid="ISA 39"/>
  <chapter number="40" style="c" sid="ISA 40"/>
  <para style="s1">ದೇವಜನರ ಸಾಂತ್ವನ</para>
  <para style="q1">
    <verse number="1" style="v" sid="ISA 40:1"/>ನೀವು ನನ್ನ ಜನರನ್ನು ಸಂತೈಸಿರಿ,</para>
  <para style="q2" vid="ISA 40:1">ಸಂತೈಸಿರಿ ಎಂದು ನಿಮ್ಮ ದೇವರು ಹೇಳುತ್ತಾರೆ.<verse eid="ISA 40:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 40:2"/>ಯೆರೂಸಲೇಮಿನ ಸಂಗಡ ನೀವು</para>
  <para style="q2" vid="ISA 40:2">ಮೃದುವಾಗಿ ಮಾತನಾಡಿರಿ.</para>
  <para style="q1" vid="ISA 40:2">ಅದರ ಕಠಿಣ ಸೇವೆ ತೀರಿತೆಂದೂ,</para>
  <para style="q2" vid="ISA 40:2">ಅದರ ಪಾಪಕ್ಕೆ ಪ್ರಾಯಶ್ಚಿತ್ತವಾಗಿದೆ, ಎಂದು ಘೋಷಿಸಿರಿ,</para>
  <para style="q1" vid="ISA 40:2">ಏಕೆಂದರೆ ಅದು ಎಲ್ಲಾ ಪಾಪಗಳಿಗೂ</para>
  <para style="q2" vid="ISA 40:2">ಯೆಹೋವ ದೇವರ ಕೈಯಿಂದ ಎರಡರಷ್ಟು ಹೊಂದಿದ್ದಾಯಿತು.<verse eid="ISA 40:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 40:3"/>“ಮರುಭೂಮಿಯಲ್ಲಿ ಯೆಹೋವ ದೇವರ</para>
  <para style="q2" vid="ISA 40:3">ಮಾರ್ಗವನ್ನು ಸಿದ್ಧಮಾಡಿರಿ.</para>
  <para style="q1" vid="ISA 40:3">ಅರಣ್ಯದಲ್ಲಿ ನಮ್ಮ ದೇವರಿಗೆ</para>
  <para style="q2" vid="ISA 40:3">ರಾಜಮಾರ್ಗವನ್ನು ನೆಟ್ಟಗೆಮಾಡಿರಿ.<verse eid="ISA 40:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 40:4"/>ಪ್ರತಿಯೊಂದು ಹಳ್ಳಕೊಳ್ಳಗಳನ್ನು ಮಟ್ಟಮಾಡಬೇಕು.</para>
  <para style="q2" vid="ISA 40:4">ಎಲ್ಲಾ ಬೆಟ್ಟಗುಡ್ಡಗಳು ನೆಲಸಮವಾಗಬೇಕು.</para>
  <para style="q1" vid="ISA 40:4">ಒರಟಾದ ನೆಲವು ಸಮವಾಗಬೇಕು.<verse eid="ISA 40:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 40:5"/>ಆಗ ಯೆಹೋವ ದೇವರ ಮಹಿಮೆಯು ಗೋಚರವಾಗುವುದು.</para>
  <para style="q2" vid="ISA 40:5">ಮಾನವರೆಲ್ಲರೂ ಒಟ್ಟಿಗೆ ಅದನ್ನು ಕಾಣುವರು.</para>
  <para style="q1" vid="ISA 40:5">ಏಕೆಂದರೆ ಯೆಹೋವ ದೇವರೇ ಇದನ್ನು ನುಡಿದಿದ್ದಾರೆ.”<verse eid="ISA 40:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 40:6"/>ವಾಣಿಯು, “ಗಟ್ಟಿಯಾಗಿ ಕೂಗು,” ಎಂದಿತು.</para>
  <para style="q2" vid="ISA 40:6">ಅದಕ್ಕೆ, “ನಾನು ಏನೆಂದು ಕೂಗಲಿ?” ಎಂದು ಕೇಳಲು,</para>
  <para style="b" vid="ISA 40:6"/>
  <para style="q1" vid="ISA 40:6">“ನರಜಾತಿಯೆಲ್ಲಾ ಹುಲ್ಲಿನ ಹಾಗಿದೆ. ಅವರ ಸೊಬಗೆಲ್ಲಾ ಹೊಲದ ಹೂವಿನಂತಿದೆ,<verse eid="ISA 40:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 40:7"/>ಯೆಹೋವ ದೇವರ ಶ್ವಾಸವು ಅದರ ಮೇಲೆ ಬೀಸುವುದರಿಂದ, ಹುಲ್ಲು ಒಣಗಿಹೋಗುವುದು.</para>
  <para style="q2" vid="ISA 40:7">ಹೂವು ಉದುರಿ ಹೋಗುವುದು.</para>
  <para style="q2" vid="ISA 40:7">ಮಾನವರೆಲ್ಲರೂ ಹುಲ್ಲೇ ಆಗಿದ್ದಾರೆ.<verse eid="ISA 40:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 40:8"/>ಹುಲ್ಲು ಒಣಗಿಹೋಗುವುದು, ಹೂವು ಬಾಡಿಹೋಗುವುದು.</para>
  <para style="q2" vid="ISA 40:8">ಆದರೆ ನಮ್ಮ ದೇವರ ವಾಕ್ಯವಾದರೋ ಸದಾಕಾಲ ಇರುವುದು,” ಎಂದು ಉತ್ತರವಾಯಿತು.<verse eid="ISA 40:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 40:9"/>ಶುಭಸಮಾಚಾರವನ್ನು ತಿಳಿಸುವ ಚೀಯೋನೇ,</para>
  <para style="q2" vid="ISA 40:9">ನೀನು ಉನ್ನತ ಪರ್ವತವನ್ನು ಏರು.</para>
  <para style="q1" vid="ISA 40:9">ಶುಭಸಮಾಚಾರವನ್ನು ತಿಳಿಸುವ ಯೆರೂಸಲೇಮೇ,</para>
  <para style="q2" vid="ISA 40:9">ಬಲವಾಗಿ ನಿನ್ನ ಧ್ವನಿ ಎತ್ತು, ಭಯಪಡಬೇಡ.</para>
  <para style="q1" vid="ISA 40:9">ಯೆಹೂದದ ಪಟ್ಟಣಗಳಿಗೆ,</para>
  <para style="q2" vid="ISA 40:9">“ಇಗೋ, ನಿನ್ನ ದೇವರು!” ಎಂದು ಹೇಳು.<verse eid="ISA 40:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 40:10"/>ಇಗೋ, ಸಾರ್ವಭೌಮ ಯೆಹೋವ ದೇವರು ಬಲದೊಂದಿಗೆ ಬರುವರು.</para>
  <para style="q2" vid="ISA 40:10">ಅವರ ತೋಳು ತಮಗೋಸ್ಕರ ಆಳುವುದು.</para>
  <para style="q1" vid="ISA 40:10">ಅವರ ಬಹುಮಾನವು ಅವರ ಸಂಗಡ</para>
  <para style="q2" vid="ISA 40:10">ಅವರ ಪ್ರತಿಫಲವು ಅವರ ಮುಂದೆಯೂ ಇದೆ.<verse eid="ISA 40:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 40:11"/>ಅವರು ತಮ್ಮ ಮಂದೆಯನ್ನು ಕುರುಬನಂತೆ ಮೇಯಿಸುವರು.</para>
  <para style="q2" vid="ISA 40:11">ಕುರಿಮರಿಗಳನ್ನು ಕೂಡಿಸಿ,</para>
  <para style="q1" vid="ISA 40:11">ಅವುಗಳನ್ನು ತಮ್ಮ ಎದೆಗಪ್ಪಿಕೊಳ್ಳುವರು,</para>
  <para style="q2" vid="ISA 40:11">ಎಳೆಯ ಮರಿಗಳನ್ನು ಮೆಲ್ಲಗೆ ನಡಿಸುವರು.<verse eid="ISA 40:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 40:12"/>ಸಮುದ್ರದ ನೀರನ್ನು ಬರಿದಾದ ತನ್ನ ಕೈಯಿಂದ ಅಳತೆ ಮಾಡಿದವನೂ,</para>
  <para style="q2" vid="ISA 40:12">ಆಕಾಶಗಳ ಮೇರೆಯನ್ನು ಗೇಣಿನಿಂದ ಅಳೆದವನೂ,</para>
  <para style="q1" vid="ISA 40:12">ಭೂಮಿಯ ಧೂಳನ್ನು ಅಳತೆಮಾಡಿ ತಿಳಿದುಕೊಂಡವನೂ,</para>
  <para style="q2" vid="ISA 40:12">ಬೆಟ್ಟಗಳ ಮಟ್ಟವನ್ನೂ,</para>
  <para style="q2" vid="ISA 40:12">ಗುಡ್ಡಗಳನ್ನೂ ತಕ್ಕಡಿಯಿಂದ ತೂಗಿದವನೂ ಯಾರು?<verse eid="ISA 40:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="ISA 40:13"/>ಯೆಹೋವ ದೇವರ ಮನಸ್ಸನ್ನು ಅರ್ಥ ಮಾಡಿಕೊಂಡವನು ಯಾರು?</para>
  <para style="q2" vid="ISA 40:13">ಸಲಹೆಗಾರನಾಗಿ ಅವರಿಗೆ ಬೋಧಿಸಿದವನು ಯಾರು?<verse eid="ISA 40:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="ISA 40:14"/>ತನಗೆ ಜ್ಞಾನ ದೊರೆಯಲು ಯೆಹೋವ ದೇವರು ಯಾರ ವಿಚಾರ ತೆಗೆದುಕೊಂಡನು.</para>
  <para style="q2" vid="ISA 40:14">ಆತನಿಗೆ ಸರಿಯಾದ ಮಾರ್ಗವನ್ನು ಕಲಿಸಿದವನು ಯಾರು?</para>
  <para style="q1" vid="ISA 40:14">ಆತನಿಗೆ ಜ್ಞಾನವನ್ನು ಕಲಿಸಿದವನಾರು ಇಲ್ಲವೆ ತಿಳುವಳಿಕೆಯ</para>
  <para style="q2" vid="ISA 40:14">ಮಾರ್ಗವನ್ನು ಆತನಿಗೆ ತೋರಿಸಿದವನಾರು?<verse eid="ISA 40:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="ISA 40:15"/>ಇಗೋ, ಆತನ ಎಣಿಕೆಯಲ್ಲಿ ಜನಾಂಗಗಳು ಕಪಿಲೆಯಿಂದ ಉದುರುವ ತುಂತುರಿನಂತೆಯೂ,</para>
  <para style="q2" vid="ISA 40:15">ತಕ್ಕಡಿಯಲ್ಲಿನ ಧೂಳಿನ ಹಾಗೂ ಇರುತ್ತವೆ.</para>
  <para style="q2" vid="ISA 40:15">ದ್ವೀಪಗಳನ್ನು ಅಣುರೇಣುವಿನಂತೆ ಆತನು ಎತ್ತುತ್ತಾನೆ.<verse eid="ISA 40:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="ISA 40:16"/>ಲೆಬನೋನು ಯಜ್ಞವೇದಿಯ ಬೆಂಕಿಗೆ ಸಾಲದು:</para>
  <para style="q2" vid="ISA 40:16">ಅದರ ಪ್ರಾಣಿಗಳು ದಹನಬಲಿಗಳಿಗೆ ಸಾಧನವು.<verse eid="ISA 40:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="ISA 40:17"/>ಸಕಲ ಜನಾಂಗಗಳು ಆತನ ಮುಂದೆ ಏನೂ ಇಲ್ಲದಂತಿವೆ.</para>
  <para style="q2" vid="ISA 40:17">ಅವು ಆತನ ಎಣಿಕೆಯಲ್ಲಿ ಶೂನ್ಯವಾಗಿಯೂ,</para>
  <para style="q2" vid="ISA 40:17">ವ್ಯರ್ಥವಾಗಿಯೂ ಇವೆ.<verse eid="ISA 40:17"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="18" style="v" sid="ISA 40:18"/>ಹೀಗಿರಲು ದೇವರನ್ನು ಯಾರಿಗೆ ಹೋಲಿಸುವಿರಿ?</para>
  <para style="q2" vid="ISA 40:18">ಅಥವಾ ಯಾವ ರೂಪವನ್ನು ಆತನಿಗೆ ಸಮಾನ ಮಾಡುವಿರಿ?<verse eid="ISA 40:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="ISA 40:19"/>ಕಂಚುಗಾರನು ವಿಗ್ರಹವನ್ನು ಎರಕ ಹೊಯ್ಯುತ್ತಾನೆ.</para>
  <para style="q2" vid="ISA 40:19">ಅಕ್ಕಸಾಲಿಗನು ಅದಕ್ಕೆ ಚಿನ್ನದ ಕವಚವನ್ನು ಹೊದಿಸಿ,</para>
  <para style="q2" vid="ISA 40:19">ಬೆಳ್ಳಿಯ ಸರಪಣಿಗಳನ್ನು ಹಾಕುವನು.<verse eid="ISA 40:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="ISA 40:20"/>ಕಾಣಿಕೆಯನ್ನಾಗಿ ಪ್ರತಿಷ್ಠಿಸಿಕೊಳ್ಳಲಾರದ ಬಡವನು</para>
  <para style="q2" vid="ISA 40:20">ಹುಳಿತುಹೋಗದ ಮರವನ್ನು ಹುಡುಕಿ,</para>
  <para style="q1" vid="ISA 40:20">ಬಾಗಿಬೀಳದ ವಿಗ್ರಹವನ್ನು ತಯಾರಿಸುವುದಕ್ಕೆ</para>
  <para style="q2" vid="ISA 40:20">ಶಿಲ್ಪಿಯನ್ನು ವಿಚಾರಿಸಿಕೊಳ್ಳುವನು.<verse eid="ISA 40:20"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="21" style="v" sid="ISA 40:21"/>ನಿಮಗೆ ತಿಳಿದಿಲ್ಲವೋ?</para>
  <para style="q2" vid="ISA 40:21">ನೀವು ಕೇಳಲಿಲ್ಲವೋ?</para>
  <para style="q1" vid="ISA 40:21">ಆದಿಯಿಂದಲೇ ನಿಮಗೆ ತಿಳಿದಿಲ್ಲವೋ?</para>
  <para style="q2" vid="ISA 40:21">ಭೂಮಿಯು ಸ್ಥಾಪಿತವಾದಂದಿನಿಂದ ನಿಮಗೆ ಅರ್ಥವಾಗಲಿಲ್ಲವೋ?<verse eid="ISA 40:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="ISA 40:22"/>ಆಕಾಶಮಂಡಲವನ್ನು ತೆರೆಯಂತೆ ವಿಸ್ತರಿಸಿ,</para>
  <para style="q2" vid="ISA 40:22">ಅದರೊಳಗೆ ವಾಸಮಾಡುವ ಗುಡಾರದಂತೆ ಹರಡಿ,</para>
  <para style="q1" vid="ISA 40:22">ಭೂನಿವಾಸಿಗಳು ಮಿಡತೆಯಂತೆ ಕಾಣಿಸುವಷ್ಟು</para>
  <para style="q2" vid="ISA 40:22">ಭೂವೃತ್ತದ ಮೇಲೆ ಕೂತಿರುವಾತನು ಆತನೇ.<verse eid="ISA 40:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="ISA 40:23"/>ಅದು ದೇಶಾಧಿಪತಿಗಳನ್ನು ನಿರ್ನಾಮ ಮಾಡುತ್ತದೆ,</para>
  <para style="q2" vid="ISA 40:23">ಭೂಮಿಯ ನ್ಯಾಯಾಧಿಪತಿಗಳನ್ನು ಶೂನ್ಯವಾಗುವಂತೆ ಮಾಡುತ್ತದೆ.<verse eid="ISA 40:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="ISA 40:24"/>ಇವರು ನೆಟ್ಟಕೂಡಲೇ, ಬಿತ್ತಿದಾಕ್ಷಣವೇ,</para>
  <para style="q2" vid="ISA 40:24">ಭೂಮಿಯಲ್ಲಿ ಬೇರೂರಿದಾಗಲೇ,</para>
  <para style="q1" vid="ISA 40:24">ಆತನ ಶ್ವಾಸವನ್ನು ಇವರ ಮೇಲೆ ಊದಿದಾಗಲೇ ಒಣಗಿ ಹೋಗುವರು.</para>
  <para style="q2" vid="ISA 40:24">ಬಿರುಗಾಳಿಯು ಇವರನ್ನು ಹೊಟ್ಟಿನಂತೆ ಬಡಿದುಕೊಂಡು ಹೋಗುವುದು.<verse eid="ISA 40:24"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="25" style="v" sid="ISA 40:25"/>ಹೀಗಿರಲು, “ನನ್ನನ್ನು ಯಾರಿಗೆ ಹೋಲಿಸಿ</para>
  <para style="q2" vid="ISA 40:25">ಸರಿಸಮಾನ ಮಾಡುತ್ತೀರಿ?” ಎಂದು ಪರಿಶುದ್ಧ ದೇವರು ಕೇಳುತ್ತಾರೆ.<verse eid="ISA 40:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="ISA 40:26"/>ನಿಮ್ಮ ಕಣ್ಣುಗಳನ್ನು ಮೇಲಕ್ಕೆತ್ತಿ ನೋಡಿರಿ.</para>
  <para style="q2" vid="ISA 40:26">ಇಗೋ, ಈ ನಕ್ಷತ್ರಗಳನ್ನು ಸೃಷ್ಟಿಸಿದಾತನು ಯಾರು?</para>
  <para style="q1" vid="ISA 40:26">ಆತನೇ ತನ್ನ ಮಹಾಶಕ್ತಿಯಿಂದಲೂ,</para>
  <para style="q2" vid="ISA 40:26">ಅವುಗಳ ಸೈನ್ಯವನ್ನೆಲ್ಲಾ ಲೆಕ್ಕ ಮಾಡಿ ಹೊರಗೆ ತರುವನು.</para>
  <para style="q1" vid="ISA 40:26">ಏಕೆಂದರೆ ಆತನು ಅತಿ ಬಲಾಢ್ಯನೂ ಮಹಾಶಕ್ತನೂ ಆಗಿರುವುದರಿಂದ</para>
  <para style="q2" vid="ISA 40:26">ಅವುಗಳೊಳಗೆ ಒಂದೂ ತಪ್ಪದು.<verse eid="ISA 40:26"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="27" style="v" sid="ISA 40:27"/>ನನ್ನ ಮಾರ್ಗವು ಯೆಹೋವ ದೇವರಿಗೆ ಮರೆಯಾಗಿದೆ.</para>
  <para style="q2" vid="ISA 40:27">ನನ್ನ ನ್ಯಾಯವು ನನ್ನ ದೇವರಿಂದ ದಾಟಿಹೋಯಿತಲ್ಲಾ!</para>
  <para style="q1" vid="ISA 40:27">ಎಂದು ಯಾಕೋಬೇ ಏಕೆ ಹೇಳುತ್ತೀ?</para>
  <para style="q2" vid="ISA 40:27">ಇಸ್ರಾಯೇಲೇ ಏಕೆ ಮಾತನಾಡುತ್ತೀ?<verse eid="ISA 40:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="ISA 40:28"/>ನಿನಗೆ ಗೊತ್ತಿಲ್ಲವೋ?</para>
  <para style="q2" vid="ISA 40:28">ನೀನು ಕೇಳಲಿಲ್ಲವೋ?</para>
  <para style="q1" vid="ISA 40:28">ಯೆಹೋವ ದೇವರು ನಿರಂತರವಾದ ದೇವರೂ,</para>
  <para style="q2" vid="ISA 40:28">ಭೂಮಿಯ ಅಂತ್ಯಗಳನ್ನು ಸೃಷ್ಟಿಸಿದವನೂ ದಣಿಯುವುದಿಲ್ಲ,</para>
  <para style="q1" vid="ISA 40:28">ಬಳಲುವುದಿಲ್ಲ, ಆತನ ತಿಳುವಳಿಕೆಯು</para>
  <para style="q2" vid="ISA 40:28">ಪರಿಶೋಧನೆಗೆ ಅಗಮ್ಯ.<verse eid="ISA 40:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="ISA 40:29"/>ಆತನು ದಣಿದವನಿಗೆ ಶಕ್ತಿಯನ್ನೂ,</para>
  <para style="q2" vid="ISA 40:29">ಬಲಹೀನನಿಗೆ ಬಹುಬಲವನ್ನೂ ಕೊಡುತ್ತಾನೆ.<verse eid="ISA 40:29"/></para>
  <para style="q1">
    <verse number="30" style="v" sid="ISA 40:30"/>ಯೌವನಸ್ಥರೋ ದಣಿದು ಬಳಲುವರು</para>
  <para style="q2" vid="ISA 40:30">ಮತ್ತು ತರುಣರು ಸಂಪೂರ್ಣವಾಗಿ ಬೀಳುವರು.<verse eid="ISA 40:30"/></para>
  <para style="q1">
    <verse number="31" style="v" sid="ISA 40:31"/>ಆದರೆ ಯೆಹೋವ ದೇವರನ್ನು ನಿರೀಕ್ಷಿಸುವವರೋ</para>
  <para style="q2" vid="ISA 40:31">ಹೊಸ ಬಲವನ್ನು ಹೊಂದುವರು.</para>
  <para style="q1" vid="ISA 40:31">ಅವರು ಹದ್ದುಗಳಂತೆ</para>
  <para style="q2" vid="ISA 40:31">ರೆಕ್ಕೆಗಳಿಂದ ಬೆಟ್ಟವನ್ನು ಏರುವರು.</para>
  <para style="q2" vid="ISA 40:31">ಅವರು ಓಡಿ ದಣಿಯರು. ನಡೆದು ಬಳಲರು.<verse eid="ISA 40:31"/></para>
  <chapter eid="ISA 40"/>
  <chapter number="41" style="c" sid="ISA 41"/>
  <para style="s1">ಇಸ್ರಾಯೇಲಿನ ಸಹಾಯಕನು</para>
  <para style="q1">
    <verse number="1" style="v" sid="ISA 41:1"/>ದ್ವೀಪಗಳೇ, ನನ್ನ ಮುಂದೆ ಮೌನದಿಂದಿರಿ.</para>
  <para style="q2" vid="ISA 41:1">ರಾಷ್ಟ್ರಗಳು ತಮ್ಮ ಬಲವನ್ನು ನವೀಕರಿಸಲಿ!</para>
  <para style="q1" vid="ISA 41:1">ಅವರು ನನ್ನ ಸಮೀಪಕ್ಕೆ ಬಂದು ಮಾತನಾಡಲಿ.</para>
  <para style="q2" vid="ISA 41:1">ನ್ಯಾಯಸ್ಥಾನಕ್ಕೆ ಸಮೀಪಕ್ಕೆ ಒಟ್ಟಾಗಿ ಬರೋಣ.<verse eid="ISA 41:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 41:2"/>ಪೂರ್ವದಿಂದ ನೀತಿವಂತನನ್ನು ಎಬ್ಬಿಸಿ,</para>
  <para style="q2" vid="ISA 41:2">ಅವನನ್ನು ತನ್ನ ಪಾದಸನ್ನಿಧಿಗೆ ಕರೆದು,</para>
  <para style="q1" vid="ISA 41:2">ರಾಷ್ಟ್ರಗಳನ್ನು ಅವನ ಮುಂದೆ ಕೊಟ್ಟುಬಿಟ್ಟು,</para>
  <para style="q2" vid="ISA 41:2">ಅವನನ್ನು ರಾಜರ ಮೇಲೆ ಆಳುವುದಕ್ಕೆ ಮಾಡಿದವನು ಯಾರು?</para>
  <para style="q1" vid="ISA 41:2">ಅವನ ಖಡ್ಗವನ್ನು ಧೂಳನ್ನಾಗಿಯೂ,</para>
  <para style="q2" vid="ISA 41:2">ಅವನ ಬಿಲ್ಲನ್ನು ಹಾರಿಹೋಗುವ ಹೊಟ್ಟಿನಂತೆಯೂ ಅವರನ್ನು ಕೊಟ್ಟನು.<verse eid="ISA 41:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 41:3"/>ತಾನು ಎಂದೂ ಹೆಜ್ಜೆ ಇಡದ ಮಾರ್ಗದಲ್ಲಿ ಸುರಕ್ಷಿತವಾಗಿ</para>
  <para style="q2" vid="ISA 41:3">ಆತನು ಅವರನ್ನು ಹಿಂದಟ್ಟುತ್ತಾ ಹೋದನು.<verse eid="ISA 41:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 41:4"/>ಇದನ್ನೆಲ್ಲಾ ನಡೆಯಿಸಿ ನೆರವೇರಿಸಿದವನೂ</para>
  <para style="q2" vid="ISA 41:4">ಆದಿಯಿಂದ ತಲತಲಾಂತರಗಳನ್ನು ಬರಮಾಡಿದವನು ಯಾರು?</para>
  <para style="q1" vid="ISA 41:4">ಯೆಹೋವ ಎಂಬ ನಾನೇ ಮೊದಲನೆಯವನು,</para>
  <para style="q2" vid="ISA 41:4">ಅಂತ್ಯಕಾಲದಲ್ಲಿ ಸಂಗಡಿಗನು ಆಗಿರುವಾತನೇ ನಾನು.<verse eid="ISA 41:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 41:5"/>ದ್ವೀಪಗಳೆಲ್ಲವೂ ಕಂಡು ಬೆರಗಾದವು.</para>
  <para style="q2" vid="ISA 41:5">ಭೂಮಿಯ ಕಟ್ಟಕಡೆಯು ನಡುಗಿತು.</para>
  <para style="q1" vid="ISA 41:5">ಅವರು ಸಮೀಪಕ್ಕೆ ಬಂದರು.<verse eid="ISA 41:5"/></para>
  <para style="q2">
    <verse number="6" style="v" sid="ISA 41:6"/>ಪ್ರತಿಯೊಬ್ಬನು ತನ್ನ ನೆರೆಯವನಿಗೆ ಸಹಾಯ ಮಾಡಲಿ.</para>
  <para style="q2" vid="ISA 41:6">ಪ್ರತಿಯೊಬ್ಬನು ತನ್ನ ಸಹೋದರನಿಗೆ, “ಧೈರ್ಯವಾಗಿರಿ!” ಎಂದು ಹೇಳಲಿ.<verse eid="ISA 41:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 41:7"/>ಹಾಗೆಯೇ ಶಿಲ್ಪಿಯು ಅಕ್ಕಸಾಲಿಗನನ್ನು ಪ್ರೋತ್ಸಾಹಗೊಳಿಸಿದನು.</para>
  <para style="q2" vid="ISA 41:7">ಸುತ್ತಿಗೆಯಿಂದ ಸಮಮಾಡುವವನು ಅಡಿಗಲ್ಲಿನ ಮೇಲೆ</para>
  <para style="q2" vid="ISA 41:7">ತಟ್ಟುವವನನ್ನು ಉತ್ತೇಜಿಸಿದನು.</para>
  <para style="q1" vid="ISA 41:7">ಬೆಸುಗೆ “ಚೆನ್ನಾಗಿದೆ” ಎಂದು ಹೇಳಿ,</para>
  <para style="q2" vid="ISA 41:7">ಅದು ಕದಲದ ಹಾಗೆ ಮೊಳೆಗಳಿಂದ ಜಡಿದರು.<verse eid="ISA 41:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 41:8"/>“ಆದರೆ ನನ್ನ ಸೇವಕನಾದ ಇಸ್ರಾಯೇಲೇ,</para>
  <para style="q2" vid="ISA 41:8">ನಾನು ಆಯ್ದುಕೊಂಡ ಯಾಕೋಬೇ,</para>
  <para style="q2" vid="ISA 41:8">ನನ್ನ ಸ್ನೇಹಿತನಾದ ಅಬ್ರಹಾಮನ ಸಂತತಿಯೇ,<verse eid="ISA 41:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 41:9"/>ನಿನ್ನನ್ನು ಭೂಮಿಯ ಕಟ್ಟಕಡೆಗಳಿಂದ ಆರಿಸಿಕೊಂಡು,</para>
  <para style="q2" vid="ISA 41:9">ಅದರ ದೂರದ ಕೊನೆಯಿಂದ ಕರೆದು,</para>
  <para style="q1" vid="ISA 41:9">‘ನೀನು ನನ್ನ ಸೇವಕನು,’</para>
  <para style="q2" vid="ISA 41:9">ನಿನ್ನನ್ನು ನಾನು ಆಯ್ದುಕೊಂಡಿದ್ದೇನೆ. ನಿನ್ನನ್ನು ತಳ್ಳಿಬಿಡುವುದಿಲ್ಲ.<verse eid="ISA 41:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 41:10"/>ನೀನಂತೂ ಹೆದರಬೇಡ, ಏಕೆಂದರೆ ನಾನೇ ನಿನ್ನ ದೇವರು,</para>
  <para style="q2" vid="ISA 41:10">ನಾನು ನಿನ್ನನ್ನು ಬಲಪಡಿಸುತ್ತೇನೆ.</para>
  <para style="q1" vid="ISA 41:10">ನಾನು ನಿನಗೆ ಸಹಾಯ ಮಾಡುತ್ತೇನೆ.</para>
  <para style="q2" vid="ISA 41:10">ನನ್ನ ನೀತಿಯ ಬಲಗೈಯಿಂದ ನಿನ್ನನ್ನು ಎತ್ತಿಹಿಡಿಯುತ್ತೇನೆ.<verse eid="ISA 41:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 41:11"/>“ನಿನಗೆ ವಿರೋಧವಾಗಿ ಉರಿಗೊಂಡವರೆಲ್ಲರೂ</para>
  <para style="q2" vid="ISA 41:11">ಅವಮಾನ ಹೊಂದಿ, ಆಶಾಭಂಗಪಡುವರು.</para>
  <para style="q1" vid="ISA 41:11">ನಿನ್ನ ಸಂಗಡ ವ್ಯಾಜ್ಯವಾಡಿದವರು</para>
  <para style="q2" vid="ISA 41:11">ನಾಶವಾಗಿ ಇಲ್ಲದೆ ಹೋಗುವರು.<verse eid="ISA 41:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 41:12"/>ನಿನ್ನೊಡನೆ ಹೋರಾಡಿದವರನ್ನು</para>
  <para style="q2" vid="ISA 41:12">ಹುಡುಕಿದವರೂ ಅವರು ನಿನಗೆ ಕಾಣಿಸರು.</para>
  <para style="q1" vid="ISA 41:12">ನಿನ್ನ ಸಂಗಡ ಯುದ್ಧ ಮಾಡಿದವರು</para>
  <para style="q2" vid="ISA 41:12">ಇಲ್ಲದೆ ಹೋಗಿ ನಿರ್ನಾಮವಾಗುವರು.<verse eid="ISA 41:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="ISA 41:13"/>ನೀನಂತೂ ಹೆದರಬೇಡ;</para>
  <para style="q2" vid="ISA 41:13">ಏಕೆಂದರೆ ಯೆಹೋವ ದೇವರಾದ ನಾನೇ ನಿನಗೆ ಸಹಾಯ ಮಾಡುತ್ತೇನೆ,</para>
  <para style="q2" vid="ISA 41:13">ನಿನ್ನ ದೇವರಾಗಿರುವ ನಾನೇ ನಿನ್ನ ಕೈಹಿಡಿಯುತ್ತೇನಲ್ಲಾ!<verse eid="ISA 41:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="ISA 41:14"/>ಹುಳುವಿನಂತಿರುವ ಯಾಕೋಬೇ,</para>
  <para style="q2" vid="ISA 41:14">ಪುಟ್ಟ ಇಸ್ರಾಯೇಲೇ, ಭಯಪಡಬೇಡ.</para>
  <para style="q1" vid="ISA 41:14">ನಾನೇ ನಿನಗೆ ಸಹಾಯ ಮಾಡುತ್ತೇನೆ,” ಎಂದು ಯೆಹೋವ ದೇವರು ಹೇಳುತ್ತಾರೆ.</para>
  <para style="q2" vid="ISA 41:14">ನಿನ್ನ ವಿಮೋಚಕನೂ ಇಸ್ರಾಯೇಲಿನ ಪರಿಶುದ್ಧನೂ ಹೇಳುತ್ತಾರಲ್ಲಾ!<verse eid="ISA 41:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="ISA 41:15"/>ಇಗೋ, ನಿನ್ನನ್ನು ಹದವಾದ,</para>
  <para style="q2" vid="ISA 41:15">ಹೊಸ ಮೊನೆಹಲ್ಲಿನ ಹಂತೀಕುಂಟೆಯನ್ನಾಗಿ ಮಾಡುವೆನು.</para>
  <para style="q1" vid="ISA 41:15">ನೀನು ಬೆಟ್ಟಗಳನ್ನು ಹೊಕ್ಕು, ಪುಡಿಪುಡಿಮಾಡಿ,</para>
  <para style="q2" vid="ISA 41:15">ಗುಡ್ಡಗಳನ್ನು ಹೊಟ್ಟಿನಂತೆ ಮಾಡುವೆ.<verse eid="ISA 41:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="ISA 41:16"/>ನೀನು ಅವುಗಳನ್ನು ತೂರಲು, ಗಾಳಿಯು ಅವುಗಳನ್ನು ಬಡಿದುಕೊಂಡು ಹೋಗುವುದು.</para>
  <para style="q2" vid="ISA 41:16">ಬಿರುಗಾಳಿಯು ಚೆಲ್ಲಾಪಿಲ್ಲಿ ಮಾಡುವುದು.</para>
  <para style="q1" vid="ISA 41:16">ನೀನಂತೂ ಯೆಹೋವ ದೇವರಲ್ಲಿ ಸಂತೋಷಿಸಿ,</para>
  <para style="q2" vid="ISA 41:16">ಇಸ್ರಾಯೇಲಿನ ಪರಿಶುದ್ಧರಲ್ಲಿ ಮಹಿಮೆ ಹೊಂದುವೆ.<verse eid="ISA 41:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="ISA 41:17"/>ಬಡವರೂ ದರಿದ್ರರೂ ನೀರನ್ನು ಹುಡುಕಿ ಕಾಣದೇ,</para>
  <para style="q2" vid="ISA 41:17">ಬಾಯಾರಿಕೆಯಿಂದ ನಾಲಿಗೆ ಒಣಗಿದಾಗ,</para>
  <para style="q2" vid="ISA 41:17">ಯೆಹೋವನಾದ ನಾನೇ</para>
  <para style="q1" vid="ISA 41:17">ಅವರಿಗೆ ಉತ್ತರಕೊಡುವೆನು.</para>
  <para style="q2" vid="ISA 41:17">ಇಸ್ರಾಯೇಲ್ ದೇವರಾಗಿರುವ ನಾನು ಅವರನ್ನು ಕೈಬಿಡೆನು.<verse eid="ISA 41:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="ISA 41:18"/>ಎತ್ತರವಾದ ಸ್ಥಳಗಳಲ್ಲಿ ನದಿಗಳನ್ನು</para>
  <para style="q2" vid="ISA 41:18">ತಗ್ಗುಗಳ ಮಧ್ಯದಲ್ಲಿ ಬುಗ್ಗೆಗಳನ್ನು ಹೊರಡಿಸಿ,</para>
  <para style="q1" vid="ISA 41:18">ಮರುಭೂಮಿಯನ್ನು ನೀರಿನ ಕೆರೆಯನ್ನಾಗಿಯೂ,</para>
  <para style="q2" vid="ISA 41:18">ಒಣನೆಲವನ್ನು ನೀರಿನ ಒರತೆಗಳನ್ನಾಗಿಯೂ ಮಾಡುವೆನು.<verse eid="ISA 41:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="ISA 41:19"/>ಮರುಭೂಮಿಯಲ್ಲಿ ದೇವದಾರು,</para>
  <para style="q2" vid="ISA 41:19">ಜಾಲೀಮರ, ಸುಗಂಧ, ಓಲಿವ್ ಮರಗಳನ್ನು ನಾನು ನೆಡುವೆನು.</para>
  <para style="q1" vid="ISA 41:19">ಮರುಭೂಮಿಯಲ್ಲಿ ತುರಾಯಿ,</para>
  <para style="q2" vid="ISA 41:19">ತಪಸಿ, ತಿಲಕ ವೃಕ್ಷಗಳನ್ನು ಒಟ್ಟಿಗೆ ಬೆಳೆಯಿಸುವೆನು.<verse eid="ISA 41:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="ISA 41:20"/>ಆಗ ಯೆಹೋವ ದೇವರ ಹಸ್ತವು ಇದನ್ನು ಮಾಡಿದೆ ಎಂದೂ,</para>
  <para style="q2" vid="ISA 41:20">ಇಸ್ರಾಯೇಲಿನ ಪರಿಶುದ್ಧನು ಇದನ್ನು ಸೃಷ್ಟಿಸಿದನು ಎಂದೂ</para>
  <para style="q1" vid="ISA 41:20">ಅವರು ಕಂಡು ತಿಳಿದು,</para>
  <para style="q2" vid="ISA 41:20">ಮನಸ್ಸಿಗೆ ಗ್ರಹಿಸಿಕೊಳ್ಳುವರು.<verse eid="ISA 41:20"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="21" style="v" sid="ISA 41:21"/>“ನಿಮ್ಮ ವ್ಯಾಜ್ಯವನ್ನು ತನ್ನಿರಿ” ಎಂದು ಯೆಹೋವ ದೇವರು ಹೇಳುತ್ತಾರೆ.</para>
  <para style="q2" vid="ISA 41:21">“ನಿಮ್ಮ ಬಲವಾದ ನ್ಯಾಯಗಳನ್ನು ತನ್ನಿರಿ,” ಎಂದು ಯಾಕೋಬ್ಯರ ಅರಸನು ಹೇಳುತ್ತಾನೆ.<verse eid="ISA 41:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="ISA 41:22"/>“ವಿಗ್ರಹಗಳೇ, ಮುಂದೆ ಏನಾಗಲಿದೆ</para>
  <para style="q2" vid="ISA 41:22">ಎಂದು ನಮಗೆ ಹೇಳಿ.</para>
  <para style="q1" vid="ISA 41:22">ಹಿಂದಿನವುಗಳನ್ನು ನಾವು ಮನಸ್ಸಿಗೆ ತಂದುಕೊಂಡು,</para>
  <para style="q2" vid="ISA 41:22">ಅವುಗಳ ಪರಿಣಾಮವನ್ನು</para>
  <para style="q2" vid="ISA 41:22">ಇಲ್ಲವೆ ಮುಂದಿನವುಗಳನ್ನು</para>
  <para style="q1" vid="ISA 41:22">ತಿಳಿಸಿದರೆ ಗ್ರಹಿಸುವೆವು.<verse eid="ISA 41:22"/></para>
  <para style="q2">
    <verse number="23" style="v" sid="ISA 41:23"/>ನೀವು ದೇವರುಗಳೆಂದು ತಿಳಿದುಕೊಳ್ಳುವಂತೆ ಮುಂದೆ</para>
  <para style="q2" vid="ISA 41:23">ಬರುವವುಗಳನ್ನು ನಮಗೆ ತಿಳಿಸಿರಿ.</para>
  <para style="q1" vid="ISA 41:23">ಹೌದು, ನಾವು ಗಾಬರಿಯಿಂದ ಭಯಪಡುವ ಹಾಗೆ ಒಳ್ಳೆಯದನ್ನಾಗಲಿ,</para>
  <para style="q2" vid="ISA 41:23">ಕೆಟ್ಟದ್ದನ್ನಾಗಲಿ ಮಾಡಿರಿ.<verse eid="ISA 41:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="ISA 41:24"/>ನೀವು ಶೂನ್ಯವೇ,</para>
  <para style="q2" vid="ISA 41:24">ನಿಮ್ಮ ಕಾರ್ಯವು ವ್ಯರ್ಥವೇ.</para>
  <para style="q2" vid="ISA 41:24">ನಿಮ್ಮನ್ನು ಆರಿಸಿಕೊಂಡವನು ಅಸಹ್ಯನೇ.<verse eid="ISA 41:24"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="25" style="v" sid="ISA 41:25"/>“ಉತ್ತರ ದಿಕ್ಕಿನಿಂದ ಒಬ್ಬನನ್ನು ನಾನು ಎಬ್ಬಿಸಿದ್ದೇ.</para>
  <para style="q2" vid="ISA 41:25">ಸೂರ್ಯೋದಯದ ಕಡೆಯಿಂದ ಅವನು ನನ್ನ ಹೆಸರನ್ನು ಸ್ಮರಿಸುವನು.</para>
  <para style="q1" vid="ISA 41:25">ಅವನು ಜೇಡಿ ಮಣ್ಣಿನಂತೆಯೂ,</para>
  <para style="q2" vid="ISA 41:25">ಕುಂಬಾರನು ಮಣ್ಣನ್ನು ತುಳಿಯುವಂತೆಯೂ ಅಧಿಕಾರಸ್ಥರ ಮೇಲೆ ಅವನು ಬರುವನು.<verse eid="ISA 41:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="ISA 41:26"/>ಆತನು ನೀತಿವಂತನೆಂದು ನಾನು ತಿಳಿಯುವಂತೆ ಮತ್ತು ಹೇಳುವಂತೆ,</para>
  <para style="q2" vid="ISA 41:26">ಆದಿಯಲ್ಲಿ ಯಾರು ಅದನ್ನು ತಿಳಿಸಿದ್ದಾರೆ?</para>
  <para style="q1" vid="ISA 41:26">ಹೌದು, ಯಾರೂ ತೋರಿಸುವವನಿಲ್ಲ,</para>
  <para style="q2" vid="ISA 41:26">ತಿಳಿಸುವವನು ಒಬ್ಬನೂ ಇಲ್ಲ.</para>
  <para style="q2" vid="ISA 41:26">ನಿಮ್ಮ ಮಾತುಗಳು ಯಾರ ಕಿವಿಗೂ ಬೀಳುವುದಿಲ್ಲ.<verse eid="ISA 41:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="ISA 41:27"/>ನಾನು ಮೊದಲನೆಯವನಾಗಿ ಚೀಯೋನಿಗೆ, ‘ಇಗೋ, ಅವರನ್ನು ನೋಡು’ ಎಂದು ಹೇಳಿ,</para>
  <para style="q2" vid="ISA 41:27">ಶುಭಸಮಾಚಾರ ತರತಕ್ಕವನನ್ನು ಯೆರೂಸಲೇಮಿಗೆ ಅನುಗ್ರಹಿಸುವೆನು.<verse eid="ISA 41:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="ISA 41:28"/>ನಾನು ನೋಡಿದಾಗ, ಅಲ್ಲಿ ಯಾರೂ ಇಲ್ಲ.</para>
  <para style="q2" vid="ISA 41:28">ನಾನು ಅವರನ್ನು ಕೇಳುವ ಪ್ರಶ್ನೆಗೆ,</para>
  <para style="q2" vid="ISA 41:28">ಅವರಲ್ಲಿ ಒಂದು ಮಾತನ್ನು ಉತ್ತರಿಸುವ ಸಲಹೆಗಾರನು ಇಲ್ಲವೇ ಇಲ್ಲ.<verse eid="ISA 41:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="ISA 41:29"/>ಇಗೋ, ಅವರೆಲ್ಲಾ ವ್ಯರ್ಥವೇ,</para>
  <para style="q2" vid="ISA 41:29">ಅವರ ಕಾರ್ಯಗಳು ಶೂನ್ಯವೇ.</para>
  <para style="q2" vid="ISA 41:29">ಅವರ ಕೆತ್ತಿದ ವಿಗ್ರಹಗಳು ಗಾಳಿ ಮತ್ತು ಗಲಿಬಿಲಿಯೇ.”<verse eid="ISA 41:29"/></para>
  <chapter eid="ISA 41"/>
  <chapter number="42" style="c" sid="ISA 42"/>
  <para style="s1">ಯೆಹೋವ ದೇವರ ಸೇವಕ</para>
  <para style="q1">
    <verse number="1" style="v" sid="ISA 42:1"/>“ಇಗೋ, ನನ್ನ ಸೇವಕನು. ಇವನಿಗೆ ನಾನೇ ಆಧಾರ,</para>
  <para style="q2" vid="ISA 42:1">ನಾನು ಆಯ್ದುಕೊಂಡವನಲ್ಲಿ ನನ್ನ ಆತ್ಮವು ಆನಂದಿಸುವುದು;</para>
  <para style="q1" vid="ISA 42:1">ನನ್ನ ಆತ್ಮವನ್ನು ಅವನ ಮೇಲೆ ಇರಿಸಿದ್ದೇನೆ,</para>
  <para style="q2" vid="ISA 42:1">ಅವನು ಇತರ ಜನಾಂಗಗಳಿಗೆ ನ್ಯಾಯತೀರ್ಪನ್ನು ತರುವನು.<verse eid="ISA 42:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 42:2"/>ಅವನು ಕೂಗುವುದಿಲ್ಲ, ಶಬ್ದವನ್ನು ಎತ್ತುವುದಿಲ್ಲ,</para>
  <para style="q2" vid="ISA 42:2">ಬೀದಿಗಳಲ್ಲಿ ತನ್ನ ಧ್ವನಿಯನ್ನು ಕೇಳಗೊಡಿಸುವುದಿಲ್ಲ.<verse eid="ISA 42:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 42:3"/>ಜಜ್ಜಿದ ದಂಟನ್ನು ಮುರಿದು ಹಾಕದೆ,</para>
  <para style="q2" vid="ISA 42:3">ಕಳೆಗುಂದಿದ ದೀಪವನ್ನು ನಂದಿಸದೆ,</para>
  <para style="q1" vid="ISA 42:3">ನಂಬಿಕೆಯಿಂದ ನ್ಯಾಯವನ್ನು ಹೊರತರುತ್ತಾನೆ.<verse eid="ISA 42:3"/></para>
  <para style="q2">
    <verse number="4" style="v" sid="ISA 42:4"/>ಲೋಕದಲ್ಲಿ ನ್ಯಾಯವನ್ನು ಸ್ಥಾಪಿಸುವ ತನಕ ಈತನು ಬಿಟ್ಟುಕೊಡುವುದಿಲ್ಲ, ಮನಗುಂದುವುದಿಲ್ಲ,</para>
  <para style="q2" vid="ISA 42:4">ದ್ವೀಪಗಳು ಈತನ ಬೋಧನೆಗೆ ಎದುರುನೋಡುವುವು.”<verse eid="ISA 42:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 42:5"/>ಆಕಾಶವನ್ನು ನಿರ್ಮಿಸಿ ಹಾಸಿದವನು ಭೂಮಿಯನ್ನೂ,</para>
  <para style="q1" vid="ISA 42:5">ಅದರಿಂದ ಉತ್ಪತ್ತಿಯನ್ನೂ ವಿಸ್ತರಿಸಿ,</para>
  <para style="q2" vid="ISA 42:5">ಅದರ ಮೇಲಿರುವ ಜನರಿಗೆ ಶ್ವಾಸವನ್ನೂ,</para>
  <para style="q2" vid="ISA 42:5">ಅದರಲ್ಲಿ ಸಂಚರಿಸುವವರಿಗೆ ಆತ್ಮವನ್ನೂ ಕೊಡುತ್ತೇನೆಂದು</para>
  <para style="q2" vid="ISA 42:5">ದೇವರಾದ ಯೆಹೋವ ದೇವರು ಹೇಳುತ್ತಾರೆ.<verse eid="ISA 42:5"/></para>
  <para style="q1">
    <verse number="6-7" style="v" sid="ISA 42:6-7"/>“ನೀನು ಕುರುಡರಿಗೆ ಕಣ್ಣುಗಳನ್ನು ತೆರೆದು,</para>
  <para style="q2" vid="ISA 42:6-7">ಸೆರೆಯವರನ್ನು ಸೆರೆಯಿಂದಲೂ,</para>
  <para style="q1" vid="ISA 42:6-7">ಕತ್ತಲೆಯಲ್ಲಿ ವಾಸಿಸುವವರನ್ನು</para>
  <para style="q2" vid="ISA 42:6-7">ಕಾರಾಗೃಹದಿಂದಲೂ ಹೊರತರಬೇಕು,”</para>
  <para style="q1" vid="ISA 42:6-7">ಎಂದು ಯೆಹೋವ ದೇವರಾಗಿರುವ ನಾನೇ ನಿನ್ನನ್ನು ನೀತಿಯಿಂದ ಕರೆದು,</para>
  <para style="q2" vid="ISA 42:6-7">ನಿನ್ನ ಕೈಯನ್ನು ಹಿಡಿದು ಕಾಪಾಡಿ,</para>
  <para style="q2" vid="ISA 42:6-7">ನಿನ್ನನ್ನು ಜನಗಳಿಗೆ ಒಡಂಬಡಿಕೆಯ ಆಧಾರವನ್ನಾಗಿಯೂ,</para>
  <para style="q2" vid="ISA 42:6-7">ಇತರ ಜನಗಳಿಗೆ ಬೆಳಕನ್ನಾಗಿಯೂ ನೇಮಿಸಿದ್ದೇನೆ.<verse eid="ISA 42:6-7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 42:8"/>ನಾನೇ ಯೆಹೋವ ದೇವರು, ಅದೇ ನನ್ನ ಹೆಸರು.</para>
  <para style="q2" vid="ISA 42:8">ನನ್ನ ಮಹಿಮೆಯನ್ನು ಮತ್ತೊಬ್ಬನಿಗೆ ಇಲ್ಲವೆ</para>
  <para style="q2" vid="ISA 42:8">ನನ್ನ ಸ್ತುತಿಯನ್ನು ಎರಕದ ವಿಗ್ರಹಗಳಿಗೂ ಕೊಡೆನು.<verse eid="ISA 42:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 42:9"/>ಇಗೋ, ಹಿಂದಿನವುಗಳು ನೆರವೇರಿವೆ.</para>
  <para style="q2" vid="ISA 42:9">ಹೊಸ ಸಂಗತಿಗಳನ್ನು ಪ್ರಕಟಿಸುತ್ತೇನೆ.</para>
  <para style="q1" vid="ISA 42:9">ಅವು ಹುಟ್ಟುವುದಕ್ಕಿಂತ ಮುಂಚೆಯೇ</para>
  <para style="q2" vid="ISA 42:9">ನಾನು ಅವುಗಳನ್ನು ನಿಮಗೆ ತಿಳಿಸುತ್ತೇನೆ.<verse eid="ISA 42:9"/></para>
  <para style="s1">ಯೆಹೋವ ದೇವರಿಗೆ ಸ್ತೋತ್ರಗೀತೆ</para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 42:10"/>ಸಮುದ್ರ ಪ್ರಯಾಣಿಕರೇ, ಸಕಲ ಜಲಚರಗಳೇ,</para>
  <para style="q2" vid="ISA 42:10">ದ್ವೀಪಗಳೇ, ಅದರ ನಿವಾಸಿಗಳೇ,</para>
  <para style="q1" vid="ISA 42:10">ಯೆಹೋವ ದೇವರಿಗೆ ಹೊಸಹಾಡನ್ನು ಹಾಡಿರಿ.</para>
  <para style="q2" vid="ISA 42:10">ಭೂಮಿಯ ಕಟ್ಟಕಡೆಯಿಂದ ಆತನಿಗೆ ಸ್ತೋತ್ರಮಾಡಿರಿ.<verse eid="ISA 42:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 42:11"/>ಮರುಭೂಮಿಯು, ಅದರ ಪಟ್ಟಣಗಳು ಘೋಷಿಸಲಿ.</para>
  <para style="q2" vid="ISA 42:11">ಕೇದಾರ್ ಊರಿನ ನಿವಾಸಿಗಳು ಬಂಡೆಯ</para>
  <para style="q1" vid="ISA 42:11">ಪ್ರದೇಶದ ನಿವಾಸಿಗಳು ಹಾಡಲಿ.</para>
  <para style="q2" vid="ISA 42:11">ಸೆಲ ಪಟ್ಟಣದವರೂ ಹರ್ಷಧ್ವನಿಗೈಯಲಿ;</para>
  <para style="q2" vid="ISA 42:11">ಅವರು ಪರ್ವತದ ತುದಿಯಲ್ಲಿ ಆರ್ಭಟಿಸಲಿ.<verse eid="ISA 42:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 42:12"/>ಅವರು ಯೆಹೋವ ದೇವರಿಗೆ ಮಹಿಮೆಯನ್ನು ಸಲ್ಲಿಸಲಿ!</para>
  <para style="q2" vid="ISA 42:12">ಆತನ ಸ್ತೋತ್ರವನ್ನು ದ್ವೀಪಗಳಲ್ಲಿ ಪ್ರಕಟಿಸಲಿ.<verse eid="ISA 42:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="ISA 42:13"/>ಯೆಹೋವ ದೇವರು ಪರಾಕ್ರಮಶಾಲಿಯಾಗಿ</para>
  <para style="q2" vid="ISA 42:13">ಮುಂದೆ ಹೋಗುವರು;</para>
  <para style="q1" vid="ISA 42:13">ಯುದ್ಧವೀರನ ಹಾಗೆ ತಮ್ಮ ರೌದ್ರವನ್ನು ಎಬ್ಬಿಸುವರು.</para>
  <para style="q2" vid="ISA 42:13">ಆರ್ಭಟಿಸಿ ಗರ್ಜಿಸಿ ತಮ್ಮ ಶತ್ರುಗಳಿಗೆ ವಿರೋಧವಾಗಿ ಜಯಶಾಲಿಯಾಗುವರು.<verse eid="ISA 42:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="ISA 42:14"/>“ಬಹುಕಾಲದಿಂದ ಸುಮ್ಮನೆ</para>
  <para style="q2" vid="ISA 42:14">ಮೌನವಾಗಿ ನನ್ನನ್ನು ಬಿಗಿಹಿಡಿದಿದ್ದೆನು.</para>
  <para style="q1" vid="ISA 42:14">ಈಗ ನಾನು ಹೆರುವವಳಂತೆ ಕೂಗುವೆನು.</para>
  <para style="q2" vid="ISA 42:14">ನಾನು ನಾಶಮಾಡಿ, ಒಂದೇ ಸಾರಿ ನುಂಗಿಬಿಡುವೆನು.<verse eid="ISA 42:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="ISA 42:15"/>ನಾನು ಬೆಟ್ಟಗುಡ್ಡಗಳನ್ನು ನಾಶಮಾಡಿ,</para>
  <para style="q2" vid="ISA 42:15">ಅಲ್ಲಿಯ ಮೇವನ್ನು ಒಣಗಿಸಿ;</para>
  <para style="q1" vid="ISA 42:15">ನದಿಗಳನ್ನು ದ್ವೀಪಗಳನ್ನಾಗಿಯೂ,</para>
  <para style="q2" vid="ISA 42:15">ಕೆರೆಗಳನ್ನು ಬತ್ತಿಹೋಗುವಂತೆಯೂ ಮಾಡುವೆನು.<verse eid="ISA 42:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="ISA 42:16"/>ಕುರುಡರನ್ನು ಅವರು ತಿಳಿಯದ ಮಾರ್ಗದಲ್ಲಿ ಬರಮಾಡುವೆನು.</para>
  <para style="q2" vid="ISA 42:16">ಅವರನ್ನು ತಿಳಿಯದ ಹಾದಿಗಳಲ್ಲಿ ನಡೆಸುವೆನು.</para>
  <para style="q1" vid="ISA 42:16">ಕತ್ತಲೆಯನ್ನು ಅವರ ಮುಂದೆ ಬೆಳಕಾಗಿಯೂ,</para>
  <para style="q2" vid="ISA 42:16">ಸೊಟ್ಟಾದವುಗಳನ್ನು ನೆಟ್ಟಗಾಗಿಯೂ ಮಾಡುವೆನು.</para>
  <para style="q1" vid="ISA 42:16">ಇವುಗಳನ್ನು ನಾನು ಅವರಿಗೋಸ್ಕರ ಮಾಡುವೆನು.</para>
  <para style="q2" vid="ISA 42:16">ನಾನು ಅವರನ್ನು ಕೈಬಿಡುವುದಿಲ್ಲ.<verse eid="ISA 42:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="ISA 42:17"/>ಕೆತ್ತಿದ ವಿಗ್ರಹಗಳಲ್ಲಿ ಭರವಸವಿಟ್ಟು, ‘ನೀವೇ ನಮ್ಮ ದೇವರುಗಳು,’</para>
  <para style="q2" vid="ISA 42:17">ಎಂದು ಹೇಳುವವರು ಹಿಂದೆ ಬಿದ್ದು,</para>
  <para style="q2" vid="ISA 42:17">ನಾಚಿಕೆಗೆ ಈಡಾಗುವರು.<verse eid="ISA 42:17"/></para>
  <para style="s1">ಇಸ್ರಾಯೇಲರು ಕಿವುಡರು ಮತ್ತು ಕುರುಡರು</para>
  <para style="q1">
    <verse number="18" style="v" sid="ISA 42:18"/>“ಕಿವುಡರೇ, ಕೇಳಿರಿ;</para>
  <para style="q2" vid="ISA 42:18">ಕುರುಡರೇ, ನೀವು ದೃಷ್ಟಿಸಿ ನೋಡಿರಿ.<verse eid="ISA 42:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="ISA 42:19"/>ನನ್ನ ಸೇವಕನಲ್ಲದೆ ಕುರುಡನು ಯಾರು?</para>
  <para style="q2" vid="ISA 42:19">ನಾನು ಕಳುಹಿಸಿದ ಸೇವಕನಲ್ಲದೆ ಕಿವುಡನು ಯಾರು?</para>
  <para style="q1" vid="ISA 42:19">ಸಂಪೂರ್ಣನಂತೆ ಕುರುಡನು ಯಾರು?</para>
  <para style="q2" vid="ISA 42:19">ಯೆಹೋವ ದೇವರ ಸೇವಕನಂತೆ ಕುರುಡನು ಯಾರು?<verse eid="ISA 42:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="ISA 42:20"/>ನೀನು ಅನೇಕ ಸಂಗತಿಗಳನ್ನು ಕಂಡಿದ್ದರೂ,</para>
  <para style="q2" vid="ISA 42:20">ನಿನಗೆ ಗಮನವಿಲ್ಲ. ಅವನ ಕಿವಿಗಳು ತೆರೆದಿದ್ದರೂ, ಕೇಳನು.”<verse eid="ISA 42:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="ISA 42:21"/>ಯೆಹೋವ ದೇವರು ಆತನ ನೀತಿಗೋಸ್ಕರ</para>
  <para style="q2" vid="ISA 42:21">ಬಹಳವಾಗಿ ಮೆಚ್ಚುವನು.</para>
  <para style="q2" vid="ISA 42:21">ಆತನು ನಿಯಮವನ್ನು ಹೆಚ್ಚಿಸಿ, ಘನಪಡಿಸುವನು.<verse eid="ISA 42:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="ISA 42:22"/>ಆದರೆ ಈ ಜನರೇ ಕೊಳ್ಳೆಗೆ ಈಡಾಗಿ ಸೂರೆ ಹೋಗಿದ್ದಾರೆ.</para>
  <para style="q2" vid="ISA 42:22">ಅವರೆಲ್ಲರೂ ಹಳ್ಳಕೊಳ್ಳಗಳಲ್ಲಿ ಸಿಕ್ಕಿಬಿದ್ದಿದ್ದಾರೆ.</para>
  <para style="q2" vid="ISA 42:22">ಸೆರೆಮನೆಗಳಲ್ಲಿ ಬಂಧಿಗಳಾಗಿದ್ದಾರೆ.</para>
  <para style="q1" vid="ISA 42:22">ಅವರು ಸೂರೆಯಾದರೂ,</para>
  <para style="q2" vid="ISA 42:22">ತಪ್ಪಿಸುವವನು ಒಬ್ಬನೂ ಇಲ್ಲ.</para>
  <para style="q1" vid="ISA 42:22">ಕೊಳ್ಳೆಯಾದದ್ದನ್ನು, “ತಿರುಗಿ ಹಿಂದಕ್ಕೆ ಕೊಡು,”</para>
  <para style="q2" vid="ISA 42:22">ಎಂದು ಹೇಳುವ ಒಬ್ಬನೂ ಇಲ್ಲ.<verse eid="ISA 42:22"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="23" style="v" sid="ISA 42:23"/>ನಿಮ್ಮಲ್ಲಿ ಯಾರು ಇವುಗಳಿಗೆ ಕಿವಿಗೊಡುವರು?</para>
  <para style="q2" vid="ISA 42:23">ಯಾರು ಇನ್ನು ಮುಂದೆ ಆಲಿಸಿ ಕೇಳುವರು?<verse eid="ISA 42:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="ISA 42:24"/>ಯಾಕೋಬನ್ನು ಸುಲಿಗೆಗೂ,</para>
  <para style="q2" vid="ISA 42:24">ಇಸ್ರಾಯೇಲನ್ನು ಕೊಳ್ಳೆಗೂ ಗುರಿಮಾಡಿದವನು ಯಾರು?</para>
  <para style="q1" vid="ISA 42:24">ನಾವು ಯಾರಿಗೆ ವಿರೋಧವಾಗಿ ಪಾಪಮಾಡಿದೆವು?</para>
  <para style="q2" vid="ISA 42:24">ಅದು ಯೆಹೋವ ದೇವರಿಗೆ ವಿರೋಧವಾಗಿಯಲ್ಲವೇ.</para>
  <para style="q1" vid="ISA 42:24">ಏಕೆಂದರೆ ಅವರು ಆತನ ಮಾರ್ಗದಲ್ಲಿ ನಡೆಯಲಿಲ್ಲ.</para>
  <para style="q2" vid="ISA 42:24">ಆತನ ನಿಯಮಕ್ಕೆ ಅವಿಧೇಯರಾದರು.<verse eid="ISA 42:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="ISA 42:25"/>ಆದ್ದರಿಂದ ಆತನು ತನ್ನ ಯುದ್ಧದ ರೌದ್ರವನ್ನು</para>
  <para style="q2" vid="ISA 42:25">ಮತ್ತು ರೋಷಾಗ್ನಿಯನ್ನು ಅವನ ಮೇಲೆ ಸುರಿಸಿದನು.</para>
  <para style="q1" vid="ISA 42:25">ಅದು ಅವನ ಸುತ್ತಲೂ ಉರಿಯು ಹತ್ತಿದರೂ, ಅವನಿಗೆ ತಿಳಿಯಲಿಲ್ಲ.</para>
  <para style="q2" vid="ISA 42:25">ಅದು ಅವನನ್ನು ಸುಟ್ಟರೂ, ಅವನು ಮನಸ್ಸಿಗೆ ತಂದುಕೊಳ್ಳಲಿಲ್ಲ.<verse eid="ISA 42:25"/></para>
  <chapter eid="ISA 42"/>
  <chapter number="43" style="c" sid="ISA 43"/>
  <para style="s1">ಇಸ್ರಾಯೇಲರ ಒಬ್ಬನೇ ರಕ್ಷಕ</para>
  <para style="q1">
    <verse number="1" style="v" sid="ISA 43:1"/>ಈಗಲಾದರೋ ಯಾಕೋಬನ ವಂಶವೇ,</para>
  <para style="q2" vid="ISA 43:1">ಇಸ್ರಾಯೇಲ್ ಸಂತಾನವೇ, ನಿನ್ನನ್ನು ಸೃಷ್ಟಿಸಿ,</para>
  <para style="q2" vid="ISA 43:1">ರೂಪಿಸಿದ ಯೆಹೋವ ದೇವರು ಹೇಳುವುದೇನೆಂದರೆ:</para>
  <para style="q1" vid="ISA 43:1">“ಹೆದರಬೇಡ, ಏಕೆಂದರೆ ನಾನು ನಿನ್ನನ್ನು ವಿಮೋಚಿಸಿದೆನಲ್ಲಾ,</para>
  <para style="q2" vid="ISA 43:1">ನಿನ್ನ ಹೆಸರು ಹಿಡಿದು ಕರೆದೆನಲ್ಲಾ, ನೀನು ನನ್ನವನೇ.<verse eid="ISA 43:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 43:2"/>ನೀನು ಜಲರಾಶಿಯನ್ನು ದಾಟಿಹೋಗುವಾಗ,</para>
  <para style="q2" vid="ISA 43:2">ನಾನು ನಿನ್ನೊಂದಿಗಿರುವೆನು;</para>
  <para style="q1" vid="ISA 43:2">ನದಿಗಳನ್ನು ನೀನು ದಾಟುವಾಗ,</para>
  <para style="q2" vid="ISA 43:2">ಅವು ನಿನ್ನನ್ನು ಮುಳುಗಿಸುವುದಿಲ್ಲ;</para>
  <para style="q1" vid="ISA 43:2">ಬೆಂಕಿಯಲ್ಲಿ ನಡೆಯುವಾಗ,</para>
  <para style="q2" vid="ISA 43:2">ನೀನು ಸುಟ್ಟುಹೋಗುವುದಿಲ್ಲ;</para>
  <para style="q2" vid="ISA 43:2">ಜ್ವಾಲೆಯು ನಿನ್ನನ್ನು ದಹಿಸದು.<verse eid="ISA 43:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 43:3"/>ಏಕೆಂದರೆ ನಾನೇ ನಿನ್ನ ಯೆಹೋವ ದೇವರೂ</para>
  <para style="q2" vid="ISA 43:3">ನಿನ್ನ ದೇವರಾದ ಇಸ್ರಾಯೇಲಿನ ಪರಿಶುದ್ಧನೂ, ನಿನ್ನ ರಕ್ಷಕನೂ ಆಗಿದ್ದೇನೆ.</para>
  <para style="q1" vid="ISA 43:3">ಈಜಿಪ್ಟನ್ನು ನಿನ್ನ ವಿಮೋಚನೆಗೂ,</para>
  <para style="q2" vid="ISA 43:3">ಇಥಿಯೋಪಿಯ ಮತ್ತು ಸೆಬಾ ಸೀಮೆಗಳನ್ನು ನಿನಗೋಸ್ಕರ ಕೊಟ್ಟಿದ್ದೇನೆ.<verse eid="ISA 43:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 43:4"/>ನೀನು ನನ್ನ ದೃಷ್ಟಿಯಲ್ಲಿ ಅಮೂಲ್ಯನೂ, ಮಾನ್ಯನೂ,</para>
  <para style="q2" vid="ISA 43:4">ಪ್ರಿಯನೂ ಆಗಿರುವುದರಿಂದ</para>
  <para style="q1" vid="ISA 43:4">ನಾನು ನಿನಗೋಸ್ಕರ ಮನುಷ್ಯರನ್ನೂ,</para>
  <para style="q2" vid="ISA 43:4">ನಿನ್ನ ಪ್ರಾಣಕ್ಕೆ ಜನಾಂಗಗಳನ್ನೂ ಕೊಡುವೆನು.<verse eid="ISA 43:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 43:5"/>ಭಯಪಡಬೇಡ, ಏಕೆಂದರೆ ನಾನೇ ನಿನ್ನೊಂದಿಗೆ ಇದ್ದೇನೆ.</para>
  <para style="q2" vid="ISA 43:5">ನಿನ್ನ ಸಂತತಿಯವರನ್ನು ಪೂರ್ವದಿಂದ ತರುವೆನು.</para>
  <para style="q2" vid="ISA 43:5">ಪಶ್ಚಿಮದಿಂದ ನಿನ್ನನ್ನು ಕೂಡಿಸುವೆನು.<verse eid="ISA 43:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 43:6"/>‘ನಾನು ಒಪ್ಪಿಸಿಬಿಡು,’ ಎಂದು ಉತ್ತರದಿಕ್ಕಿಗೂ</para>
  <para style="q2" vid="ISA 43:6">‘ತಡೆಯಬೇಡ,’ ಎಂದು ದಕ್ಷಿಣದಿಕ್ಕಿಗೂ ಹೇಳಿ,</para>
  <para style="q1" vid="ISA 43:6">ದೂರದಲ್ಲಿರುವ ನನ್ನ ಪುತ್ರರನ್ನೂ,</para>
  <para style="q2" vid="ISA 43:6">ದಿಗಂತಗಳಲ್ಲಿರುವ ನನ್ನ ಪುತ್ರಿಯರನ್ನೂ,<verse eid="ISA 43:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 43:7"/>ನನ್ನ ಹೆಸರಿನಿಂದ ಕರೆಯಲಾದ ಪ್ರತಿಯೊಬ್ಬನನ್ನೂ ಬರಮಾಡುವೆನು.</para>
  <para style="q2" vid="ISA 43:7">ಏಕೆಂದರೆ ಅವರನ್ನು ನನ್ನ ಮಹಿಮೆಗಾಗಿ ಸೃಷ್ಟಿಸಿದ್ದೇನೆ.</para>
  <para style="q2" vid="ISA 43:7">ನಾನು ಅವರನ್ನು ನಿರ್ಮಿಸಿದ್ದೇನೆ. ಹೌದು, ನಾನು ಅವರನ್ನು ಉಂಟುಮಾಡಿದ್ದೇನೆ.”<verse eid="ISA 43:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 43:8"/>ಕಣ್ಣಿದ್ದರೂ ಕುರುಡರಾದ,</para>
  <para style="q2" vid="ISA 43:8">ಕಿವಿಯಿದ್ದರೂ ಕಿವುಡರಾದ ಜನರನ್ನು ಕರೆ.<verse eid="ISA 43:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 43:9"/>ಎಲ್ಲಾ ಜನಾಂಗಗಳು ಒಟ್ಟಿಗೆ ಕೂಡಿಕೊಳ್ಳಲಿ.</para>
  <para style="q2" vid="ISA 43:9">ಎಲ್ಲಾ ಜನರೂ ಸೇರಿಕೊಳ್ಳಲಿ.</para>
  <para style="q1" vid="ISA 43:9">ಅವರ ದೇವರುಗಳಲ್ಲಿ ಭವಿಷ್ಯವನ್ನು ನುಡಿಯಬಲ್ಲವರು ಯಾರು?</para>
  <para style="q2" vid="ISA 43:9">ಗತಿಸಿದ ಸಂಗತಿಗಳನ್ನು ಮುಂತಿಳಿಸುವವರು ಯಾರು?</para>
  <para style="q2" vid="ISA 43:9">ನಾವು ನೀತಿವಂತರೆಂದು ಸ್ಥಾಪಿಸುವುದಕ್ಕೆ</para>
  <para style="q1" vid="ISA 43:9">ಸಾಕ್ಷಿಗಳನ್ನು ಕರೆತರಲಿ.</para>
  <para style="q2" vid="ISA 43:9">ಆ ಸಾಕ್ಷಿಗಳು ಇದನ್ನು ಕೇಳಿ, ನಿಜವೆಂದು ಹೇಳಲಿ.<verse eid="ISA 43:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 43:10"/>ಯೆಹೋವ ದೇವರು ಹೇಳುವುದೇನೆಂದರೆ, “ನೀವು ನನಗೆ ಸಾಕ್ಷಿಗಳಾಗಿದ್ದೀರಿ,”</para>
  <para style="q2" vid="ISA 43:10">“ನಾನು ಇರುವಾತನೇ ಆಗಿದ್ದೇನೆಂದು, ನೀವು ತಿಳಿದು,</para>
  <para style="q1" vid="ISA 43:10">ನಂಬಿ, ಗ್ರಹಿಸಿರಿ;</para>
  <para style="q2" vid="ISA 43:10">ನಾನು ನಿನ್ನನ್ನು ಸೇವಕನನ್ನಾಗಿ ಆರಿಸಿಕೊಂಡಿದ್ದೇನೆ.</para>
  <para style="q1" vid="ISA 43:10">ನನಗಿಂತ ಮುಂಚೆಯೂ,</para>
  <para style="q2" vid="ISA 43:10">ನನ್ನ ಅನಂತರದಲ್ಲಿಯೂ ಯಾವ ದೇವರೂ ಇರುವುದಿಲ್ಲ.<verse eid="ISA 43:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 43:11"/>ನಾನೇ, ನಾನೇ, ಯೆಹೋವ ದೇವರು ಆಗಿದ್ದೇನೆ.</para>
  <para style="q2" vid="ISA 43:11">ನನ್ನ ಹೊರತು ಯಾವ ರಕ್ಷಕನೂ ಇಲ್ಲ.<verse eid="ISA 43:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 43:12"/>ನಿಮ್ಮಲ್ಲಿ ಅನ್ಯದೇವರು ಇಲ್ಲದಿರುವಾಗಲೇ,</para>
  <para style="q2" vid="ISA 43:12">ನಾನೇ ರಕ್ಷಣೆಯನ್ನು ಪ್ರಕಟಿಸಿ, ತೋರಿಸಿದ್ದೇನೆ. ಆದ್ದರಿಂದ ನೀವು ನನ್ನ ಸಾಕ್ಷಿಗಳು,”</para>
  <para style="q1" vid="ISA 43:12">“ನಾನೇ ದೇವರು ಎಂದು ಯೆಹೋವ ದೇವರು ನುಡಿಯುತ್ತಾರೆ.<verse eid="ISA 43:12"/></para>
  <para style="q2">
    <verse number="13" style="v" sid="ISA 43:13"/>ಹೌದು, ಅಂದಿನಿಂದಲೇ ನಾನಿದ್ದೇನೆ.</para>
  <para style="q1" vid="ISA 43:13">ನನ್ನ ಕೈಯಿಂದ ಬಿಡಿಸುವವರು ಯಾರೂ ಇಲ್ಲ.</para>
  <para style="q2" vid="ISA 43:13">ನನ್ನ ಕೆಲಸಕ್ಕೆ ಅಡ್ಡಿ ಬರುವವನಾರು?”<verse eid="ISA 43:13"/></para>
  <para style="s1">ದೇವರ ಕರುಣೆ ಹಾಗೂ ಇಸ್ರಾಯೇಲಿನ ಅಪನಂಬಿಕೆ</para>
  <para style="q1">
    <verse number="14" style="v" sid="ISA 43:14"/>ನಿಮ್ಮ ವಿಮೋಚಕನೂ ಇಸ್ರಾಯೇಲಿನ ಪರಿಶುದ್ಧನೂ ಆಗಿರುವ</para>
  <para style="q2" vid="ISA 43:14">ಯೆಹೋವ ದೇವರು ಹೇಳುವುದೇನೆಂದರೆ:</para>
  <para style="q1" vid="ISA 43:14">ನಾನು ನಿಮಗೋಸ್ಕರ ಬಾಬಿಲೋನಿಗೆ ಕಳುಹಿಸಿ,</para>
  <para style="q2" vid="ISA 43:14">ಅವರ ಘನವಂತರನ್ನೆಲ್ಲಾ</para>
  <para style="q2" vid="ISA 43:14">ಮತ್ತು ಹಡಗುಗಳಲ್ಲಿ ಆರ್ಭಟಿಸುವ ಕಸ್ದೀಯರನ್ನು ತಗ್ಗಿಸಿದೆನು.<verse eid="ISA 43:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="ISA 43:15"/>ಯೆಹೋವನಾದ ನಾನು ನಿಮ್ಮ ಪರಿಶುದ್ಧನೂ,</para>
  <para style="q2" vid="ISA 43:15">ಇಸ್ರಾಯೇಲನ್ನು ಸೃಷ್ಟಿಸಿದವನೂ, ನಿಮ್ಮ ಅರಸನೂ ಆಗಿದ್ದೇನೆ.<verse eid="ISA 43:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="ISA 43:16"/>ಯೆಹೋವ ದೇವರು ಇಂತೆನ್ನುತ್ತಾರೆ:</para>
  <para style="q2" vid="ISA 43:16">ಸಮುದ್ರದ ಮುಖಾಂತರವಾಗಿ ಮಾರ್ಗಮಾಡಿದವನೂ;</para>
  <para style="q2" vid="ISA 43:16">ಬಲವಾದ ನೀರಿನಲ್ಲಿ ದಾರಿ ಮಾಡಿದವನೂ;<verse eid="ISA 43:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="ISA 43:17"/>ರಥಗಳನ್ನು, ಕುದುರೆಗಳನ್ನು,</para>
  <para style="q2" vid="ISA 43:17">ದಂಡನ್ನು, ಪರಾಕ್ರಮಶಾಲಿಗಳನ್ನು ಹೊರಡಿಸಿ,</para>
  <para style="q1" vid="ISA 43:17">ಅವು ಒಟ್ಟಿಗೆ ಬಿದ್ದು ಏಳಲಾರದಂತೆಯೂ,</para>
  <para style="q2" vid="ISA 43:17">ದೀಪದ ಬತ್ತಿ ನಂದಿ ಆರಿಹೋಗುವಂತೆಯೂ ಮಾಡಿದಾತನು ಇಂತೆನ್ನುತ್ತಾನೆ:<verse eid="ISA 43:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="ISA 43:18"/>“ಹಿಂದಿನ ಸಂಗತಿಗಳನ್ನು ಜ್ಞಾಪಕಕ್ಕೆ ತಂದುಕೊಳ್ಳಬೇಡಿರಿ.</para>
  <para style="q2" vid="ISA 43:18">ಹಳೆಯ ಸಂಗತಿಗಳನ್ನು ಯೋಚಿಸಬೇಡಿರಿ.<verse eid="ISA 43:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="ISA 43:19"/>ಇಗೋ, ನಾನು ಒಂದು ಹೊಸ ಕಾರ್ಯವನ್ನು ಮಾಡುವೆನು.</para>
  <para style="q2" vid="ISA 43:19">ಅದು ಈಗಲೇ ತಲೆದೋರುತ್ತಲಿದೆ. ಇದು ನಿಮಗೆ ಕಾಣುವುದಿಲ್ಲವೋ?</para>
  <para style="q1" vid="ISA 43:19">ನಾನು ಅರಣ್ಯದಲ್ಲಿ ಮಾರ್ಗವನ್ನು ಏರ್ಪಡಿಸುವೆನು.</para>
  <para style="q2" vid="ISA 43:19">ಮರುಭೂಮಿಯಲ್ಲಿ ನದಿಗಳನ್ನೂ ಉಂಟುಮಾಡುವೆನು.<verse eid="ISA 43:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="ISA 43:20"/>ಕಾಡುಮೃಗಗಳು, ನರಿಗಳು,</para>
  <para style="q2" vid="ISA 43:20">ಗೂಬೆಗಳು ನನ್ನನ್ನು ಸನ್ಮಾನಿಸುತ್ತವೆ.</para>
  <para style="q1" vid="ISA 43:20">ಅಡವಿಯಲ್ಲಿ ನೀರನ್ನು,</para>
  <para style="q2" vid="ISA 43:20">ಮರುಭೂಮಿಯಲ್ಲಿ ನದಿಗಳನ್ನು</para>
  <para style="q1" vid="ISA 43:20">ನಾನು ಆಯ್ದುಕೊಂಡ ನನ್ನ ಪ್ರಜೆಗಳಿಗೆ ಕುಡಿಯುವುದಕ್ಕೆ ಕೊಟ್ಟೆನು.<verse eid="ISA 43:20"/></para>
  <para style="q2">
    <verse number="21" style="v" sid="ISA 43:21"/>ನನ್ನ ಸ್ತೋತ್ರವನ್ನು ಪ್ರಚುರಪಡಿಸಲಿ ಎಂದು ನಾನು</para>
  <para style="q2" vid="ISA 43:21">ಈ ಜನರನ್ನು ನನಗೋಸ್ಕರ ರೂಪಿಸಿದ್ದೇನೆ.<verse eid="ISA 43:21"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="22" style="v" sid="ISA 43:22"/>“ಆದರೂ ಯಾಕೋಬೇ, ನೀನು ನನ್ನನ್ನು ಪ್ರಾರ್ಥಿಸಲಿಲ್ಲ.</para>
  <para style="q2" vid="ISA 43:22">ಇಸ್ರಾಯೇಲೇ, ನನ್ನ ವಿಷಯದಲ್ಲಿ ನೀನು ಬೇಸರಗೊಂಡಿದ್ದೀ!<verse eid="ISA 43:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="ISA 43:23"/>ನಿನ್ನ ದಹನಬಲಿಯ ಎಳೆಯ ಕುರಿಗಳನ್ನು ನನಗೆ ತರಲಿಲ್ಲ.</para>
  <para style="q2" vid="ISA 43:23">ನಿನ್ನ ಯಜ್ಞಗಳಿಂದ ನನ್ನನ್ನು ಸನ್ಮಾನಿಸಲಿಲ್ಲ.</para>
  <para style="q1" vid="ISA 43:23">ನೀನು ಕಾಣಿಕೆಯನ್ನು ಅರ್ಪಿಸದೆ ಇದ್ದದ್ದಕ್ಕೆ ನಿನ್ನನ್ನು ನಾನು ತೊಂದರೆಪಡಿಸಲಿಲ್ಲ,</para>
  <para style="q2" vid="ISA 43:23">ಧೂಪಕ್ಕಾಗಿ ನಿನ್ನನ್ನು ಬೇಸರಗೊಳಿಸಲಿಲ್ಲ.<verse eid="ISA 43:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="ISA 43:24"/>ನೀನು ನನಗೋಸ್ಕರ ಹಣದಿಂದ</para>
  <para style="q2" vid="ISA 43:24">ಪರಿಮಳ ತೈಲವನ್ನು ಕೊಂಡುಕೊಳ್ಳಲಿಲ್ಲ.</para>
  <para style="q1" vid="ISA 43:24">ನಿನ್ನ ಯಜ್ಞಪಶುಗಳ ಕೊಬ್ಬಿನಿಂದ ನನ್ನನ್ನು ತೃಪ್ತಿಪಡಿಸಲಿಲ್ಲ.</para>
  <para style="q2" vid="ISA 43:24">ಆದರೆ ನಿನ್ನ ಪಾಪಗಳಿಂದ ನನ್ನನ್ನು ನೀನು ತೊಂದರೆಗೆ ಗುರಿಮಾಡಿರುವೆ.</para>
  <para style="q2" vid="ISA 43:24">ನಿನ್ನ ಅಕ್ರಮಗಳಿಂದ ನನ್ನನ್ನು ಬೇಸರಗೊಳಿಸಿದ್ದೀ.<verse eid="ISA 43:24"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="25" style="v" sid="ISA 43:25"/>“ನಾನಾಗಿ ನಾನೇ, ನನಗೋಸ್ಕರ</para>
  <para style="q2" vid="ISA 43:25">ನಿನ್ನ ದ್ರೋಹಗಳನ್ನು ಅಳಿಸಿಬಿಡುತ್ತೇನೆ.</para>
  <para style="q2" vid="ISA 43:25">ನಿನ್ನ ಪಾಪಗಳನ್ನು ನನ್ನ ನೆನಪಿನಲ್ಲಿಡೆನು.<verse eid="ISA 43:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="ISA 43:26"/>ನನಗೆ ಜ್ಞಾಪಕಪಡಿಸು,</para>
  <para style="q2" vid="ISA 43:26">ನಾವಿಬ್ಬರೂ ವಾದಿಸುವಾ,</para>
  <para style="q2" vid="ISA 43:26">ನೀನು ನೀತಿವಂತನೆಂದು ತೋರಿಸು.<verse eid="ISA 43:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="ISA 43:27"/>ನಿನ್ನ ಮೂಲಪಿತೃ ಪಾಪಮಾಡಿದ್ದಾನೆ.</para>
  <para style="q2" vid="ISA 43:27">ನಿನ್ನ ಬೋಧಕರು ನನಗೆ ವಿರೋಧವಾಗಿ ದ್ರೋಹ ಮಾಡಿದ್ದಾರೆ.<verse eid="ISA 43:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="ISA 43:28"/>ಆದಕಾರಣ ಪವಿತ್ರಾಲಯದ ಪ್ರಧಾನರನ್ನು ನಾಚಿಕೆಪಡಿಸಿ,</para>
  <para style="q2" vid="ISA 43:28">ಯಾಕೋಬನ್ನು ಶಾಪಕ್ಕೂ,</para>
  <para style="q2" vid="ISA 43:28">ಇಸ್ರಾಯೇಲನ್ನು ದೂಷಣೆಗಳಿಗೂ ಒಪ್ಪಿಸಿಬಿಟ್ಟಿದ್ದೇನೆ.<verse eid="ISA 43:28"/></para>
  <chapter eid="ISA 43"/>
  <chapter number="44" style="c" sid="ISA 44"/>
  <para style="s1">ಆರಿಸಿಕೊಂಡ ಇಸ್ರಾಯೇಲು</para>
  <para style="q1">
    <verse number="1" style="v" sid="ISA 44:1"/>“ಈಗಲಾದರೋ ನನ್ನ ಸೇವಕನಾದ ಯಾಕೋಬೇ</para>
  <para style="q2" vid="ISA 44:1">ಮತ್ತು ನಾನು ಆರಿಸಿಕೊಂಡ ಇಸ್ರಾಯೇಲೇ, ಕೇಳು:<verse eid="ISA 44:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 44:2"/>ನಿನ್ನ ನಿರ್ಮಾಣ ಮಾಡಿ,</para>
  <para style="q2" vid="ISA 44:2">ಗರ್ಭದಿಂದಲೂ ರೂಪಿಸುತ್ತಾ ಬಂದು,</para>
  <para style="q2" vid="ISA 44:2">ನಿನಗೆ ಸಹಾಯ ಮಾಡುವವರಾದ ಯೆಹೋವ ದೇವರು ಹೇಳುವುದೇನೆಂದರೆ:</para>
  <para style="q1" vid="ISA 44:2">ನನ್ನ ಸೇವಕನಾದ ಯಾಕೋಬೇ,</para>
  <para style="q2" vid="ISA 44:2">ನಾನು ಆಯ್ದುಕೊಂಡ ಯೆಶುರೂನೇ, ಭಯಪಡಬೇಡ.<verse eid="ISA 44:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 44:3"/>ಏಕೆಂದರೆ ನಾನು ಬಾಯಾರಿದ</para>
  <para style="q2" vid="ISA 44:3">ಭೂಮಿಯ ಮೇಲೆ ನೀರನ್ನು ಸುರಿಸುವೆನು.</para>
  <para style="q1" vid="ISA 44:3">ಒಣನೆಲದ ಮೇಲೆ ಪ್ರವಾಹಗಳನ್ನು ಬರಮಾಡುವೆನು. ನಿನ್ನ ಸಂತಾನದವರಲ್ಲಿ ನನ್ನ ಆತ್ಮವನ್ನೂ,</para>
  <para style="q2" vid="ISA 44:3">ನಿನ್ನಿಂದ ಹುಟ್ಟುವಂಥದ್ದರ ಮೇಲೆ ನನ್ನ ಆಶೀರ್ವಾದವನ್ನೂ ಸುರಿಸುವೆನು.<verse eid="ISA 44:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 44:4"/>ನೀರಿನ ಕಾಲುವೆಗಳ ಬಳಿಯಲ್ಲಿ,</para>
  <para style="q2" vid="ISA 44:4">ಹಸಿರು ಹುಲ್ಲಿನ ನಡುವೆ ಬೆಳೆಯುವ ನೀರವಂಜಿಗಳಂತೆ ವೃದ್ಧಿಯಾಗುವರು.<verse eid="ISA 44:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 44:5"/>ಒಬ್ಬನು, ‘ನಾನು ಯೆಹೋವನವನು,’</para>
  <para style="q2" vid="ISA 44:5">ಅನ್ನುವನು, ಇನ್ನೊಬ್ಬನು ನಾನು, ‘ಯಾಕೋಬನ ಹೆಸರಿನವನು,’ ಎಂದು ಹೇಳಿಕೊಳ್ಳುವನು.</para>
  <para style="q1" vid="ISA 44:5">ಮತ್ತೊಬ್ಬನು ತನ್ನ ಕೈಯ ಮೇಲೆ, ‘ಯೆಹೋವ ದೇವರಿಗೆ ಸ್ವಂತ,’ ಎಂದು ಬರೆಯಿಸಿಕೊಂಡು,</para>
  <para style="q2" vid="ISA 44:5">ತನ್ನಷ್ಟಕ್ಕೆ ತಾನೇ ಇಸ್ರಾಯೇಲಿನ ಅಡ್ಡಹೆಸರನ್ನು ಇಟ್ಟುಕೊಳ್ಳುವನು.<verse eid="ISA 44:5"/></para>
  <para style="s1">ವಿಗ್ರಹಗಳಲ್ಲ ಆದರೆ ಯೆಹೋವ ದೇವರೇ</para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 44:6"/>“ಇಸ್ರಾಯೇಲಿನ ಅರಸನೂ ವಿಮೋಚಕನೂ,</para>
  <para style="q2" vid="ISA 44:6">ಸೇನಾಧೀಶ್ವರ ಯೆಹೋವ ದೇವರು ಇಂತೆನ್ನುತ್ತಾರೆ:</para>
  <para style="q1" vid="ISA 44:6">ನಾನೇ ಮೊದಲನೆಯವನು, ನಾನೇ ಕಡೆಯವನು.</para>
  <para style="q2" vid="ISA 44:6">ನನ್ನ ಹೊರತು ಬೇರೆ ಯಾವ ದೇವರೂ ಇಲ್ಲ.<verse eid="ISA 44:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 44:7"/>ನಾನು ಪುರಾತನ ಕಾಲದವರನ್ನು</para>
  <para style="q2" vid="ISA 44:7">ಸೃಷ್ಟಿಸಿದಂದಿನಿಂದ ನನ್ನ ಹಾಗೆ ಕರೆದು, ತಿಳಿಸಿ,</para>
  <para style="q1" vid="ISA 44:7">ಅದನ್ನು ಸರಿಯಾಗಿ ನನಗೋಸ್ಕರ ಸಿದ್ಧಮಾಡಿದವನು ಯಾರು?</para>
  <para style="q2" vid="ISA 44:7">ಮುಂದೆ ಬರಬೇಕಾದದ್ದನ್ನು</para>
  <para style="q2" vid="ISA 44:7">ಅವರು ನನಗೆ ತಿಳಿಸಲಿ.<verse eid="ISA 44:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 44:8"/>ಹೆದರಬೇಡ, ಇಲ್ಲವೆ ಭಯಪಡಬೇಡ!</para>
  <para style="q2" vid="ISA 44:8">ನಾನು ಪೂರ್ವದಿಂದಲೂ ನಿಮಗೆ ಹೇಳಲಿಲ್ಲವೋ ಮತ್ತು ಅದನ್ನು ಪ್ರಕಟಿಸಲಿಲ್ಲವೋ?</para>
  <para style="q1" vid="ISA 44:8">ಅಂತೂ ನೀವೇ ನನ್ನ ಸಾಕ್ಷಿಗಳು. ನಾನಲ್ಲದೆ ಇನ್ನೊಬ್ಬ ದೇವರು ಇದ್ದಾನೋ?</para>
  <para style="q2" vid="ISA 44:8">ಇಲ್ಲ, ಇನ್ನು ಯಾವ ದೇವರೂ ಇಲ್ಲ, ಯಾರೂ ನನಗೆ ಗೊತ್ತಿಲ್ಲ.”<verse eid="ISA 44:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 44:9"/>ವಿಗ್ರಹಗಳನ್ನು ಕೆತ್ತುವವರು ನಿರರ್ಥಕರು.</para>
  <para style="q2" vid="ISA 44:9">ಅವರ ಇಷ್ಟ ಬೊಂಬೆಗಳು ಏತಕ್ಕೂ ಬಾರವು.</para>
  <para style="q1" vid="ISA 44:9">ಅವುಗಳಲ್ಲಿ ವಿಶ್ವಾಸವಿಡುವವರು ಕುರುಡರು,</para>
  <para style="q2" vid="ISA 44:9">ತಿಳುವಳಿಕೆ ಇಲ್ಲದವರು. ಅಂಥವರು ನಾಚಿಕೆಗೆ ಗುರಿಯಾಗುವರು.<verse eid="ISA 44:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 44:10"/>ದೇವರನ್ನು ರೂಪಿಸಿದವರೂ ಇಲ್ಲವೆ ಕೆತ್ತಿದ ವ್ಯರ್ಥವಾದ ವಿಗ್ರಹವನ್ನು</para>
  <para style="q2" vid="ISA 44:10">ಎರಕ ಹೊಯ್ಯುವವರು ಎಂಥವರು?<verse eid="ISA 44:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 44:11"/>ಅವನೂ, ಅವನ ಸಂಗಡಿಗರೂ ನಾಚಿಕೆಗೆ ಒಳಗಾಗುವರು</para>
  <para style="q2" vid="ISA 44:11">ಮತ್ತು ಆ ಕೆತ್ತನೆಯ ಕೆಲಸದವರು ಮನುಷ್ಯ ಮಾತ್ರದವರೇ.</para>
  <para style="q1" vid="ISA 44:11">ಅವರೆಲ್ಲರೂ ಒಟ್ಟುಗೂಡಿ ನಿಂತುಕೊಳ್ಳಲಿ.</para>
  <para style="q2" vid="ISA 44:11">ಅವರು ಭಯಪಟ್ಟು, ಒಟ್ಟಿಗೆ ಲಜ್ಜೆಪಡುವರು.<verse eid="ISA 44:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 44:12"/>ಕಮ್ಮಾರನು ಸಲಕರಣೆಯನ್ನು ತೆಗೆದುಕೊಂಡು</para>
  <para style="q2" vid="ISA 44:12">ಕೆಂಡದಲ್ಲಿ ಕೆಲಸ ಮಾಡುತ್ತಾನೆ;</para>
  <para style="q1" vid="ISA 44:12">ಅವನು ಸುತ್ತಿಗೆ ಹಿಡಿದು ತನ್ನ ತೋಳಿನ ಬಲದಿಂದ</para>
  <para style="q2" vid="ISA 44:12">ವಿಗ್ರಹವನ್ನು ರೂಪಿಸುತ್ತಾನೆ;</para>
  <para style="q1" vid="ISA 44:12">ಅವನು ಹಸಿದು ಬಲಹೀನನಾಗಿದ್ದರೂ,</para>
  <para style="q2" vid="ISA 44:12">ನೀರು ಕುಡಿಯದೇ ದಣಿಯುತ್ತಾನೆ.<verse eid="ISA 44:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="ISA 44:13"/>ಬಡಗಿಯು ಮರಕ್ಕೆ ನೂಲನ್ನು ಹಿಡಿದು,</para>
  <para style="q2" vid="ISA 44:13">ಮೊಳೆಯಿಂದ ಗೆರೆ ಎಳೆಯುತ್ತಾನೆ.</para>
  <para style="q1" vid="ISA 44:13">ಉಳಿಬಾಚಿಗಳಿಂದ ಕೆತ್ತುತ್ತಾನೆ.</para>
  <para style="q2" vid="ISA 44:13">ಕೈವಾರದಿಂದ ಗುರುತಿಸಿ,</para>
  <para style="q1" vid="ISA 44:13">ಆಮೇಲೆ ಮನುಷ್ಯನ ಆಕಾರಕ್ಕೆ ತಂದು,</para>
  <para style="q2" vid="ISA 44:13">ಮಂದಿರದಲ್ಲಿ ಇಡಲು</para>
  <para style="q2" vid="ISA 44:13">ಮನುಷ್ಯನ ಅಂದದಂತೆ ರೂಪಿಸುತ್ತಾನೆ.<verse eid="ISA 44:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="ISA 44:14"/>ಅರಣ್ಯದ ಮಧ್ಯದಲ್ಲಿ ಇರುವ ಮರಗಳಲ್ಲಿ ದೇವದಾರುಗಳನ್ನು ಕಡಿದು, ತುರಾಯಿ,</para>
  <para style="q2" vid="ISA 44:14">ಸೈಪ್ರಸ್ ಮತ್ತು ಏಲಾ ಮರಗಳನ್ನು ತನ್ನ ಕೆಲಸಕ್ಕೋಸ್ಕರ ತೆಗೆದುಕೊಳ್ಳುತ್ತಾನೆ.</para>
  <para style="q1" vid="ISA 44:14">ಪೀತದಾರ ಮರವನ್ನು ಅವನು ನೆಡಲು,</para>
  <para style="q2" vid="ISA 44:14">ಮಳೆಯು ಅದನ್ನು ಬೆಳೆಯಿಸುವುದು.<verse eid="ISA 44:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="ISA 44:15"/>ಆಗ ಅದು ಮನುಷ್ಯರು ಉರಿಸುವುದಕ್ಕಾಗುವುದು.</para>
  <para style="q2" vid="ISA 44:15">ಏಕೆಂದರೆ ಅದರಿಂದ ಚಳಿಕಾಯಿಸಿಕೊಳ್ಳುತ್ತಾನೆ.</para>
  <para style="q2" vid="ISA 44:15">ಅದನ್ನು ಬೆಂಕಿ ಹಚ್ಚಿ, ರೊಟ್ಟಿಯನ್ನು ಸುಡುತ್ತಾನೆ.</para>
  <para style="q1" vid="ISA 44:15">ಅವನು ಅದರಿಂದ ಒಂದು ದೇವರನ್ನು ಮಾಡಿ, ಅದಕ್ಕೆ ನಮಸ್ಕರಿಸುತ್ತಾನೆ.</para>
  <para style="q2" vid="ISA 44:15">ಅದರಲ್ಲಿ ಒಂದು ಕೆತ್ತಿದ ವಿಗ್ರಹವನ್ನು ಮಾಡಿ, ಅದಕ್ಕೆ ಅಡ್ಡ ಬೀಳುವನು.<verse eid="ISA 44:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="ISA 44:16"/>ಒಂದು ಭಾಗವನ್ನು ಬೆಂಕಿಯಲ್ಲಿ ಉರಿಸುವನು.</para>
  <para style="q2" vid="ISA 44:16">ಅದರ ಇನ್ನೊಂದು ಭಾಗದಲ್ಲಿ ಮಾಂಸವನ್ನು ಉಣ್ಣುವನು.</para>
  <para style="q2" vid="ISA 44:16">ಮಾಂಸವನ್ನು ಸುಟ್ಟು ತೃಪ್ತಿಹೊಂದುವನು.</para>
  <para style="q1" vid="ISA 44:16">ಅವನು ಚಳಿಕಾಯಿಸಿಕೊಳ್ಳುತ್ತಾ,</para>
  <para style="q2" vid="ISA 44:16">ಬೆಂಕಿಯನ್ನು ಕಂಡೆ, ಬೆಚ್ಚಗಾಯಿತು ಅಂದುಕೊಳ್ಳುವನು.<verse eid="ISA 44:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="ISA 44:17"/>ಅದರಲ್ಲಿ ಉಳಿದ ಭಾಗವನ್ನು ದೇವರನ್ನಾಗಿಯೂ,</para>
  <para style="q2" vid="ISA 44:17">ಕೆತ್ತಿದ ವಿಗ್ರಹವನ್ನಾಗಿಯೂ ಮಾಡಿ,</para>
  <para style="q1" vid="ISA 44:17">ಅದಕ್ಕೆ ಅಡ್ಡಬಿದ್ದು ನಮಸ್ಕರಿಸಿ,</para>
  <para style="q2" vid="ISA 44:17">“ನೀನೇ ನನ್ನ ದೇವರು, ನನ್ನನ್ನು ಕಾಪಾಡು,” ಎಂದು ಬೇಡಿಕೊಳ್ಳುವನು.<verse eid="ISA 44:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="ISA 44:18"/>ಅವರು ಏನೂ ತಿಳಿಯದವರು ಇಲ್ಲವೆ ಏನೂ ಗ್ರಹಿಸಲಾರದವರು.</para>
  <para style="q2" vid="ISA 44:18">ಏಕೆಂದರೆ ಆತನು ಅವರ ಕಣ್ಣು ಕಾಣದಂತೆಯೂ,</para>
  <para style="q2" vid="ISA 44:18">ಹೃದಯಗಳು ಗ್ರಹಿಸದಂತೆಯೂ ಮುಚ್ಚಿಬಿಟ್ಟಿದ್ದಾನೆ.<verse eid="ISA 44:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="ISA 44:19"/>“ನಾನು ಒಂದು ಭಾಗವನ್ನು ಬೆಂಕಿಯಲ್ಲಿ ಉರಿಸಿದೆನು.</para>
  <para style="q2" vid="ISA 44:19">ಹೌದು, ಅದರ ಕೆಂಡದಲ್ಲಿ ರೊಟ್ಟಿಮಾಡಿ,</para>
  <para style="q1" vid="ISA 44:19">ಮಾಂಸವನ್ನು ಸುಟ್ಟು ತಿಂದೆನಲ್ಲಾ.</para>
  <para style="q2" vid="ISA 44:19">ಮಿಕ್ಕಿದ್ದರಲ್ಲಿ ಅಸಹ್ಯವಾದದ್ದನ್ನು ಮಾಡಲೋ?</para>
  <para style="q2" vid="ISA 44:19">ಮರದ ತುಂಡಿಗೆ ಅಡ್ಡಬೀಳಬಹುದೋ?”</para>
  <para style="q1" vid="ISA 44:19">ಎಂದುಕೊಳ್ಳುವಷ್ಟು ಜ್ಞಾನ ವಿವೇಕಗಳು ಯಾರಿಗೂ ಇಲ್ಲ,</para>
  <para style="q2" vid="ISA 44:19">ಯಾರೂ ಇದನ್ನು ಮನಸ್ಸಿನಲ್ಲಿ ಅರ್ಥೈಸಿಕೊಳ್ಳುವುದಿಲ್ಲ.<verse eid="ISA 44:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="ISA 44:20"/>ಅವನು ತಿನ್ನುವುದು ಬೂದಿಯೇ. ಮೋಸಕ್ಕೊಳಗಾದ ಹೃದಯವು ಅವನಿಗೆ ದಾರಿತಪ್ಪಿಸಿದ ಕಾರಣ,</para>
  <para style="q2" vid="ISA 44:20">ನನ್ನ ಬಲಗೈ ಸುಳ್ಳನ್ನು ಹಿಡಿದಿದೆಯಲ್ಲಾ ಎಂದುಕೊಳ್ಳಲೂ ಆಗದು.</para>
  <para style="q2" vid="ISA 44:20">ತನ್ನ ಪ್ರಾಣವನ್ನು ಕಾಪಾಡಿಕೊಳ್ಳಲೂ ಅವನಿಂದಾಗದು.<verse eid="ISA 44:20"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="21" style="v" sid="ISA 44:21"/>“ಯಾಕೋಬೇ, ಇಸ್ರಾಯೇಲೇ! ಈ ವಿಷಯಗಳನ್ನು ಜ್ಞಾಪಕದಲ್ಲಿಟ್ಟುಕೋ,</para>
  <para style="q2" vid="ISA 44:21">ನೀನು ನನ್ನ ಸೇವಕನಾಗಿದ್ದೀ.</para>
  <para style="q1" vid="ISA 44:21">ನಾನು ನಿನ್ನನ್ನು ನಿರ್ಮಿಸಿದೆನು. ನೀನು ನನ್ನ ಸೇವಕನು.</para>
  <para style="q2" vid="ISA 44:21">ಇಸ್ರಾಯೇಲೇ, ನಾನು ನಿನ್ನನ್ನು ಮರೆತುಬಿಡೆನು.<verse eid="ISA 44:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="ISA 44:22"/>ನಾನು ನಿನ್ನ ದ್ರೋಹಗಳನ್ನು ಮೋಡದಂತೆ ಅಳಿಸಿಬಿಟ್ಟಿದ್ದೇನೆ.</para>
  <para style="q2" vid="ISA 44:22">ನಿನ್ನ ಪಾಪಗಳನ್ನು ಮುಂಜಾನೆಯ ಮಂಜಿನಂತೆ ಹಾರಿಸಿದ್ದೇನೆ.</para>
  <para style="q1" vid="ISA 44:22">ನನ್ನ ಕಡೆಗೆ ತಿರುಗಿಕೋ.</para>
  <para style="q2" vid="ISA 44:22">ಏಕೆಂದರೆ ನಾನು ನಿನ್ನನ್ನು ವಿಮೋಚಿಸಿದ್ದೇನೆ.”<verse eid="ISA 44:22"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="23" style="v" sid="ISA 44:23"/>ಆಕಾಶಗಳೇ, ಹರ್ಷಧ್ವನಿಗೈಯಿರಿ.</para>
  <para style="q2" vid="ISA 44:23">ಏಕೆಂದರೆ ಯೆಹೋವ ದೇವರು ತಾನೇ ಅದನ್ನು ಮಾಡಿದ್ದಾನೆ.</para>
  <para style="q1" vid="ISA 44:23">ಭೂಮಿಯ ಕೆಳಭಾಗವೇ ಆರ್ಭಟಿಸು.</para>
  <para style="q2" vid="ISA 44:23">ಪರ್ವತಗಳೇ, ವನವೇ, ಅದರಲ್ಲಿರುವ ಎಲ್ಲಾ ಮರಗಳೇ ಉತ್ಸಾಹಧ್ವನಿ ಮಾಡಿರಿ.</para>
  <para style="q1" vid="ISA 44:23">ಏಕೆಂದರೆ ಯೆಹೋವ ದೇವರು ಯಾಕೋಬನ್ನು ವಿಮೋಚಿಸಿದ್ದಾನೆ.</para>
  <para style="q2" vid="ISA 44:23">ಇಸ್ರಾಯೇಲಿನಲ್ಲಿ ತನ್ನನ್ನು ಮಹಿಮೆಪಡಿಸಿದ್ದಾನೆ.<verse eid="ISA 44:23"/></para>
  <para style="s1">ಯೆರೂಸಲೇಮು ಜನರಿಂದ ತುಂಬಿಕೊಳ್ಳುವುದು</para>
  <para style="q1">
    <verse number="24" style="v" sid="ISA 44:24"/>“ನಿನ್ನನ್ನು ಗರ್ಭದಿಂದ ರೂಪಿಸಿದವರೂ</para>
  <para style="q2" vid="ISA 44:24">ನಿನ್ನ ವಿಮೋಚಕರೂ ಆದ ಯೆಹೋವ ದೇವರು ಇಂತೆನ್ನುತ್ತಾರೆ:</para>
  <para style="b" vid="ISA 44:24"/>
  <para style="q1" vid="ISA 44:24">“ಎಲ್ಲವನ್ನು ಉಂಟುಮಾಡಿದ</para>
  <para style="q2" vid="ISA 44:24">ಯೆಹೋವ ದೇವರು ನಾನೇ.</para>
  <para style="q2" vid="ISA 44:24">ನಾನೊಬ್ಬನೇ ಆಕಾಶವನ್ನು ವಿಸ್ತರಿಸಿ,</para>
  <para style="q2" vid="ISA 44:24">ಭೂಮಿಯನ್ನು ನಾನೇ ವಿಶಾಲವಾಗಿ ಹರಡಿದವನಾಗಿದ್ದೇನೆ.<verse eid="ISA 44:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="ISA 44:25"/>ಸುಳ್ಳುಗಾರರ ಗುರುತುಗಳನ್ನು ನಿರರ್ಥಕ ಮಾಡುವವನೂ</para>
  <para style="q2" vid="ISA 44:25">ಮತ್ತು ಕಣಿ ಹೇಳುವವರನ್ನು ಹುಚ್ಚರನ್ನಾಗಿ ಮಾಡುವವನೂ</para>
  <para style="q1" vid="ISA 44:25">ಜ್ಞಾನಿಗಳನ್ನು ಹಿಂದಕ್ಕೆ ತಳ್ಳಿ,</para>
  <para style="q2" vid="ISA 44:25">ಅವರ ತಿಳುವಳಿಕೆಯನ್ನು ಬುದ್ಧಿಹೀನವಾಗ ಮಾಡುವವನೂ<verse eid="ISA 44:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="ISA 44:26"/>ತನ್ನ ಸೇವಕನ ಮಾತುಗಳನ್ನು ಸ್ಥಾಪಿಸುವವನು,</para>
  <para style="q2" vid="ISA 44:26">ಮತ್ತು ತನ್ನ ದೂತರ ಆಲೋಚನೆಯನ್ನು ಪೂರೈಸುವವನು.</para>
  <para style="b" vid="ISA 44:26"/>
  <para style="q1" vid="ISA 44:26">“ಯೆರೂಸಲೇಮಿಗೆ, ‘ನೀನು ನಿವಾಸವಾಗುವೆ,’</para>
  <para style="q2" vid="ISA 44:26">ಯೆಹೂದ ಪಟ್ಟಣಗಳಿಗೆ, ‘ಅವು ಪುನಃ ಕಟ್ಟಲಾಗುವುದು,’</para>
  <para style="q2" vid="ISA 44:26">ಮತ್ತು ಅದರ ಹಾಳು ಸ್ಥಳಗಳಿಗೆ, ‘ನಾನು ಪುನಃಸ್ಥಾಪಿಸುವೆನು,’ ಎಂದು ಹೇಳುವವನು,<verse eid="ISA 44:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="ISA 44:27"/>ಅಗಾಧಕ್ಕೆ, ‘ಒಣಗಿಸಿಬಿಡುವೆನು,’</para>
  <para style="q2" vid="ISA 44:27">‘ನಿನ್ನಲ್ಲಿ ಸೇರುವ ನದಿಗಳನ್ನು ಒಣಗಿಸುವೆನು,’ ಎಂದು ಅನ್ನುವವನೂ;<verse eid="ISA 44:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="ISA 44:28"/>ಕೋರೆಷನ ವಿಷಯವಾಗಿ ಹೀಗೆ ಹೇಳುವೆನು, ‘ನನ್ನ ಕುರುಬನು,</para>
  <para style="q2" vid="ISA 44:28">ನನ್ನ ಇಷ್ಟವನ್ನೆಲ್ಲಾ ಪೂರೈಸುವವನು,</para>
  <para style="q1" vid="ISA 44:28">ಯೆರೂಸಲೇಮಿಗೆ, “ನೀನು ಪುನಃ ನಿರ್ಮಾಣವಾಗುವೆ,”</para>
  <para style="q2" vid="ISA 44:28">ದೇವಾಲಯಕ್ಕೆ, “ನಿನಗೆ ಅಸ್ತಿವಾರವು ಹಾಕಲಾಗುವುದು,” ಎಂದು ಅನ್ನುವವನೂ ನಾನೇ.’<verse eid="ISA 44:28"/></para>
  <para style="b"/>
  <para style="b"/>
  <chapter eid="ISA 44"/>
  <chapter number="45" style="c" sid="ISA 45"/>
  <para style="q1">
    <verse number="1" style="v" sid="ISA 45:1"/>“ಯೆಹೋವ ದೇವರು ತಾವೇ ಅಭಿಷೇಕಿಸಿದ ಕೋರೆಷನಿಗೆ ಹೇಳುವುದೇನೆಂದರೆ:</para>
  <para style="q2" vid="ISA 45:1">ರಾಷ್ಟ್ರಗಳನ್ನು ನೀನು ತುಳಿದು,</para>
  <para style="q1" vid="ISA 45:1">ರಾಜರ ನಡುಕಟ್ಟನ್ನು ಬಿಚ್ಚಿ,</para>
  <para style="q2" vid="ISA 45:1">ಮುಚ್ಚಲಾಗದ ಹಾಗೆ ಬಾಗಿಲು ಹೆಬ್ಬಾಗಿಲುಗಳನ್ನು ತೆರೆಯಲು</para>
  <para style="q1" vid="ISA 45:1">ನಾನು ನಿನ್ನ ಬಲಗೈಯನ್ನು ಹಿಡಿದು ನಡೆಸುವೆನು.<verse eid="ISA 45:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 45:2"/>ನಾನು ನಿನ್ನ ಮುಂದೆ ಹೋಗಿ</para>
  <para style="q2" vid="ISA 45:2">ಬೆಟ್ಟಗುಡ್ಡಗಳನ್ನು ಸಮಮಾಡಿ,</para>
  <para style="q1" vid="ISA 45:2">ಕಂಚಿನ ಕದಗಳನ್ನು ಒಡೆದು,</para>
  <para style="q2" vid="ISA 45:2">ಕಬ್ಬಿಣದ ಅಗುಳಿಗಳನ್ನು ಮುರಿದುಬಿಡುವೆನು.<verse eid="ISA 45:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 45:3"/>ನಿನ್ನನ್ನು ಹೆಸರು ಹಿಡಿದು ಕರೆಯುವ ಯೆಹೋವ ದೇವರು ನಾನೇ!</para>
  <para style="q2" vid="ISA 45:3">ಇಸ್ರಾಯೇಲಿನ ದೇವರು ಎಂದು ನೀನು ತಿಳಿದುಕೊಳ್ಳುವ</para>
  <para style="q1" vid="ISA 45:3">ಹಾಗೆ ಕತ್ತಲಲ್ಲಿ ಬಚ್ಚಿಟ್ಟಿರುವ ಬಂಡಾರವನ್ನೂ,</para>
  <para style="q2" vid="ISA 45:3">ಗುಪ್ತಸ್ಥಳಗಳಲ್ಲಿ ಮರೆಮಾಡಿದ ನಿಧಿನಿಕ್ಷೇಪಗಳನ್ನೂ ನಿನಗೆ ಕೊಡುವೆನು.<verse eid="ISA 45:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 45:4"/>ಏಕೆಂದರೆ ನನ್ನ ಸೇವಕನಾದ ಯಾಕೋಬನಿಗಾಗಿ,</para>
  <para style="q2" vid="ISA 45:4">ನಾನು ಆಯ್ದುಕೊಂಡ ಇಸ್ರಾಯೇಲಿಗಾಗಿ</para>
  <para style="q1" vid="ISA 45:4">ಹೆಸರು ಹಿಡಿದು ನಿನ್ನನ್ನು ಕರೆದಿದ್ದೇನೆ.</para>
  <para style="q2" vid="ISA 45:4">ನೀನು ನನ್ನನ್ನು ಅರಿಯದವನಾಗಿದ್ದರೂ</para>
  <para style="q2" vid="ISA 45:4">ನಿನಗೆ ಹೆಸರನ್ನು ಇಟ್ಟಿದ್ದೇನೆ.<verse eid="ISA 45:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 45:5"/>ನಾನೇ ಯೆಹೋವ ದೇವರು, ಮತ್ತೊಬ್ಬನಿಲ್ಲ.</para>
  <para style="q2" vid="ISA 45:5">ನನ್ನ ಹೊರತು ಯಾವ ದೇವರೂ ಇಲ್ಲ.</para>
  <para style="q1" vid="ISA 45:5">ನೀನು ನನ್ನನ್ನು ಅರಿಯದವನಾಗಿದ್ದರೂ</para>
  <para style="q2" vid="ISA 45:5">ನಿನ್ನನ್ನು ಬಲಪಡಿಸುವೆನು.<verse eid="ISA 45:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 45:6"/>ಪೂರ್ವದಿಂದ ಪಶ್ಚಿಮದವರೆಗೆ ಇರುವವರೆಲ್ಲರೂ</para>
  <para style="q2" vid="ISA 45:6">ನನ್ನ ಹೊರತು ಮತ್ತೊಬ್ಬನು ಇಲ್ಲ,</para>
  <para style="q1" vid="ISA 45:6">ನಾನೇ ಯೆಹೋವ ದೇವರು ಮತ್ತೊಬ್ಬ ದೇವರು ಇಲ್ಲ</para>
  <para style="q2" vid="ISA 45:6">ಎಂದು ನನ್ನನ್ನು ತಿಳಿದುಕೊಳ್ಳುವರು.<verse eid="ISA 45:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 45:7"/>ಬೆಳಕನ್ನು ರೂಪಿಸುವವನೂ, ಕತ್ತಲನ್ನು ನಿರ್ಮಿಸುವವನೂ,</para>
  <para style="q2" vid="ISA 45:7">ಸಮಾಧಾನವನ್ನು ಉಂಟುಮಾಡುವವನೂ, ವಿಪತ್ತನ್ನು ಬರಮಾಡುವವನೂ ನಾನೇ.</para>
  <para style="q2" vid="ISA 45:7">ಯೆಹೋವನಾದ ನಾನೇ ಇವುಗಳನ್ನೆಲ್ಲಾ ಮಾಡುತ್ತೇನೆ.<verse eid="ISA 45:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 45:8"/>“ಆಕಾಶಗಳೇ, ಮೇಲಿನಿಂದ ಹನಿಯನ್ನು ಬೀಳಿಸಿರಿ.</para>
  <para style="q2" vid="ISA 45:8">ಗಗನವು ನೀತಿಯನ್ನು ಸುರಿಸಲಿ.</para>
  <para style="q1" vid="ISA 45:8">ಭೂಮಿಯು ತೆರೆದು</para>
  <para style="q2" vid="ISA 45:8">ರಕ್ಷಣೆಯನ್ನು ತರಲಿ.</para>
  <para style="q1" vid="ISA 45:8">ನೀತಿಯು ಅದರೊಟ್ಟಿಗೆ ಮೊಳೆಯಲಿ.</para>
  <para style="q2" vid="ISA 45:8">ಇದನ್ನು ಸೃಷ್ಟಿಸಿದ ಯೆಹೋವ ದೇವರು ನಾನೇ!<verse eid="ISA 45:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 45:9"/>“ತನ್ನನ್ನು ರೂಪಿಸಿದವನ ಸಂಗಡ ವಾದಮಾಡುವವನಿಗೆ ಕಷ್ಟ!</para>
  <para style="q2" vid="ISA 45:9">ಅವನು ಸಹ ಮಣ್ಣುಮಡಕೆಗಳಲ್ಲಿ ಒಂದು ಮಡಕೆ ಅಲ್ಲವೇ?</para>
  <para style="q2" vid="ISA 45:9">ಮಣ್ಣು ಕುಂಬಾರನಿಗೆ,</para>
  <para style="q1" vid="ISA 45:9">‘ನೀನು ಏನು ಮಾಡುತ್ತೀ?’ ಎಂದೂ,</para>
  <para style="q2" vid="ISA 45:9">‘ನಾನು ನಿನ್ನ ಕೈ ಕೆಲಸವು ಅಲ್ಲ,’ ಎಂದೂ</para>
  <para style="q2" vid="ISA 45:9">ಆ ಮಡಕೆ ಹೇಳುವುದುಂಟೇ?<verse eid="ISA 45:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 45:10"/>ನೀನು ಹುಟ್ಟಿಸಿದ್ದು ಏಕೆ?</para>
  <para style="q2" vid="ISA 45:10">ಎಂದು ತನ್ನ ತಂದೆಯನ್ನು ಕೇಳುವವನಿಗೂ,</para>
  <para style="q1" vid="ISA 45:10">‘ನೀನು ಹಡೆದದ್ದು ಏಕೆ?’</para>
  <para style="q2" vid="ISA 45:10">ಎಂದು ತಾಯಿಗೆ ಕೇಳುವವನಿಗೂ ಶಾಪ!<verse eid="ISA 45:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 45:11"/>“ಇಸ್ರಾಯೇಲಿನ ಪರಿಶುದ್ಧನೂ, ಅದನ್ನು ರೂಪಿಸಿದವನೂ</para>
  <para style="q2" vid="ISA 45:11">ಆಗಿರುವ ಯೆಹೋವ ದೇವರು,</para>
  <para style="q1" vid="ISA 45:11">ಮುಂದೆ ಸಂಭವಿಸುವ ನನ್ನ ಮಕ್ಕಳ ವಿಷಯವಾಗಿಯೂ,</para>
  <para style="q2" vid="ISA 45:11">ನನ್ನ ಕೈಕೆಲಸದ ವಿಷಯವಾಗಿಯೂ ನೀವು ನನಗೆ ಆಜ್ಞಾಪಿಸುವುದೇನು?<verse eid="ISA 45:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 45:12"/>ನಾನು ಭೂಮಿಯನ್ನು ಉಂಟುಮಾಡಿ,</para>
  <para style="q2" vid="ISA 45:12">ಅದರ ಮೇಲೆ ಮನುಷ್ಯನನ್ನು ಸೃಷ್ಟಿಸಿದೆನು.</para>
  <para style="q1" vid="ISA 45:12">ನಾನೇ, ನನ್ನ ಕೈಗಳೇ ಆಕಾಶಗಳನ್ನು ವಿಸ್ತರಿಸಿದವು.</para>
  <para style="q2" vid="ISA 45:12">ನಾನು ಅದರ ನಕ್ಷತ್ರಸೈನ್ಯಕ್ಕೆಲ್ಲಾ ಅಪ್ಪಣೆಕೊಟ್ಟೆನು.<verse eid="ISA 45:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="ISA 45:13"/>ನಾನೇ, ಅವನನ್ನು ನೀತಿಯಲ್ಲಿ ಎಬ್ಬಿಸಿದ್ದೇನೆ.</para>
  <para style="q2" vid="ISA 45:13">ಅವನ ಮಾರ್ಗಗಳನ್ನು ಸರಾಗ ಮಾಡುತ್ತೇನೆ.</para>
  <para style="q1" vid="ISA 45:13">ಅವನು ನನ್ನ ಪಟ್ಟಣವನ್ನು ಕಟ್ಟಿ,</para>
  <para style="q2" vid="ISA 45:13">ಕ್ರಯವನ್ನಾಗಲೀ, ಬಹುಮಾನವನ್ನಾಗಲೀ ಕೇಳಿಕೊಳ್ಳದೆ,</para>
  <para style="q1" vid="ISA 45:13">ನನ್ನ ಸೆರೆಯವರನ್ನು ಕಳುಹಿಸಿಬಿಡುವನು,”</para>
  <para style="q2" vid="ISA 45:13">ಎಂದು ಸೇನಾಧೀಶ್ವರ ಯೆಹೋವ ದೇವರು ಹೇಳುತ್ತಾನೆ.<verse eid="ISA 45:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="ISA 45:14"/>ಯೆಹೋವ ದೇವರು ಹೇಳುವುದೇನೆಂದರೆ:</para>
  <para style="q1" vid="ISA 45:14">“ಈಜಿಪ್ಟಿನ ಆದಾಯವೂ, ಇಥಿಯೋಪಿಯದ ವ್ಯಾಪಾರವೂ,</para>
  <para style="q2" vid="ISA 45:14">ಎತ್ತರದ ಮನುಷ್ಯರಾದ ಶೆಬದವರೂ</para>
  <para style="q1" vid="ISA 45:14">ನಿಮ್ಮಲ್ಲಿಗೆ ಸೇರಿ,</para>
  <para style="q2" vid="ISA 45:14">ನಿಮ್ಮವರಾಗಿ ನಿಮ್ಮನ್ನು ಅನುಸರಿಸುವರು.</para>
  <para style="q1" vid="ISA 45:14">ಸಂಕೋಲೆಗಳನ್ನು ಕಟ್ಟಿಕೊಂಡು ಬಂದು,</para>
  <para style="q2" vid="ISA 45:14">ನಿಮ್ಮ ಮುಂದೆ ಅಡ್ಡಬಿದ್ದು,</para>
  <para style="q1" vid="ISA 45:14">‘ನಿಶ್ಚಯವಾಗಿ ದೇವರು ನಿಮ್ಮಲ್ಲಿಯೇ ಇದ್ದಾನೆ, ಮತ್ತೊಬ್ಬನಿಲ್ಲ;</para>
  <para style="q2" vid="ISA 45:14">ಬೇರೆ ದೇವರು ಇಲ್ಲವೇ ಇಲ್ಲ.’ ”<verse eid="ISA 45:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="ISA 45:15"/>ಇಸ್ರಾಯೇಲರ ದೇವರೇ, ರಕ್ಷಕನೇ,</para>
  <para style="q2" vid="ISA 45:15">ನಿಶ್ಚಯವಾಗಿಯೂ ನೀನು ಮರೆಮಾಡಿಕೊಳ್ಳುವ ದೇವರಾಗಿದ್ದೀ.<verse eid="ISA 45:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="ISA 45:16"/>ಅವರೆಲ್ಲರೂ ನಾಚಿಕೆಪಟ್ಟು ನಿಂದಿತರಾಗುವರು.</para>
  <para style="q2" vid="ISA 45:16">ವಿಗ್ರಹಗಳನ್ನು ಮಾಡುವವರು ಒಟ್ಟಾಗಿ ಗಲಿಬಿಲಿಗೆ ಒಳಗಾಗುವರು.<verse eid="ISA 45:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="ISA 45:17"/>ಆದರೆ ಇಸ್ರಾಯೇಲರು ಶಾಶ್ವತವಾದ ರಕ್ಷಣೆಯೊಂದಿಗೆ</para>
  <para style="q2" vid="ISA 45:17">ಯೆಹೋವ ದೇವರಲ್ಲಿ ಸಂರಕ್ಷಣೆ ಹೊಂದುವರು.</para>
  <para style="q1" vid="ISA 45:17">ನೀವು ಯುಗಯುಗಾಂತರಕ್ಕೂ ಎಂದಿಗೂ ನಾಚಿಕೆಪಡುವುದಿಲ್ಲ,</para>
  <para style="q2" vid="ISA 45:17">ಅವಮಾನ ಹೊಂದುವುದಿಲ್ಲ.<verse eid="ISA 45:17"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="18" style="v" sid="ISA 45:18"/>ಆಕಾಶಗಳನ್ನು ನಿರ್ಮಿಸಿದ ಯೆಹೋವ ದೇವರು ಇಂತೆನ್ನುತ್ತಾನೆ,</para>
  <para style="q2" vid="ISA 45:18">“ದೇವರು ತಾನೇ ಭೂಮಿಯನ್ನು ನಿರ್ಮಿಸಿ,</para>
  <para style="q2" vid="ISA 45:18">ಅದನ್ನು ಉಂಟುಮಾಡಿದನು.</para>
  <para style="q1" vid="ISA 45:18">ಆತನೇ ಅದನ್ನು ಸ್ಥಾಪಿಸಿದನು.</para>
  <para style="q2" vid="ISA 45:18">ಅದನ್ನು ವ್ಯರ್ಥವಾಗಿ ಸೃಷ್ಟಿಸದೆ,</para>
  <para style="q2" vid="ISA 45:18">ಜನನಿವಾಸಕ್ಕಾಗಿಯೇ ರೂಪಿಸಿದನು.</para>
  <para style="q1" vid="ISA 45:18">ನಾನೇ ಯೆಹೋವ ದೇವರು,</para>
  <para style="q2" vid="ISA 45:18">ನಾನಲ್ಲದೆ ಇನ್ನಾರೂ ಇಲ್ಲ.<verse eid="ISA 45:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="ISA 45:19"/>ಭೂಮಿಯ ಕತ್ತಲಾದ ಸ್ಥಳದಲ್ಲಿ</para>
  <para style="q2" vid="ISA 45:19">ರಹಸ್ಯವಾಗಿ ನಾನು ಮಾತನಾಡಲಿಲ್ಲ.</para>
  <para style="q1" vid="ISA 45:19">‘ವ್ಯರ್ಥವಾಗಿ ನನ್ನನ್ನು ಹುಡುಕಿರಿ’</para>
  <para style="q2" vid="ISA 45:19">ಎಂದು ಯಾಕೋಬನ ವಂಶದವರಿಗೆ ನಾನು ಹೇಳಲಿಲ್ಲ.</para>
  <para style="q1" vid="ISA 45:19">ಯೆಹೋವನಾದ ನಾನೇ ನೀತಿಯನ್ನು ಮಾತನಾಡಿ,</para>
  <para style="q2" vid="ISA 45:19">ಯಥಾರ್ಥವಾದವುಗಳನ್ನೇ ತಿಳಿಸುತ್ತೇನೆ.<verse eid="ISA 45:19"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="20" style="v" sid="ISA 45:20"/>“ಜನಾಂಗಗಳಲ್ಲಿ ತಪ್ಪಿಸಿಕೊಂಡವರಾದ</para>
  <para style="q2" vid="ISA 45:20">ನೀವು ಒಟ್ಟಾಗಿ ಕೂಡಿಕೊಂಡು ಸಮೀಪಕ್ಕೆ ಬನ್ನಿರಿ.</para>
  <para style="q1" vid="ISA 45:20">ಮರದಿಂದ ಕೆತ್ತಿದ ತಮ್ಮ ವಿಗ್ರಹವನ್ನು ಹೊತ್ತುಕೊಂಡು,</para>
  <para style="q2" vid="ISA 45:20">ರಕ್ಷಿಸಲಾರದ ಆ ದೇವರಿಗೆ ಬಿನ್ನವಿಸುವವರು ಏನೂ ತಿಳಿಯದವರಾಗಿದ್ದಾರೆ.<verse eid="ISA 45:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="ISA 45:21"/>ನೀವು ಏನು ಸಾರಬೇಕೋ ಅದನ್ನು ಈಗ ತನ್ನಿರಿ</para>
  <para style="q2" vid="ISA 45:21">ಹೌದು, ಒಟ್ಟಿಗೆ ಅವರು ಆಲೋಚಿಸಲಿ</para>
  <para style="q1" vid="ISA 45:21">ಈ ಸಂಗತಿಗಳನ್ನು ಪುರಾತನ ಕಾಲದಿಂದಲೂ ಪ್ರಕಟಿಸಿದವರು ಯಾರು?</para>
  <para style="q2" vid="ISA 45:21">ಪ್ರಾರಂಭದಿಂದ ಇದನ್ನು ತಿಳಿಸಿದವರು ಯಾರು?</para>
  <para style="q1" vid="ISA 45:21">ಯೆಹೋವನಾದ ನಾನೇ ಅಲ್ಲವೇ?</para>
  <para style="q2" vid="ISA 45:21">ನನ್ನ ಹೊರತು ಬೇರೆ ದೇವರು ಇಲ್ಲ.</para>
  <para style="q1" vid="ISA 45:21">ನನ್ನ ಹೊರತಾಗಿ ನೀತಿಯುಳ್ಳ ದೇವರೂ,</para>
  <para style="q2" vid="ISA 45:21">ರಕ್ಷಕನೂ ಇಲ್ಲವೇ ಇಲ್ಲ.<verse eid="ISA 45:21"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="22" style="v" sid="ISA 45:22"/>“ಎಲ್ಲಾ ದಿಗಂತಗಳವರೇ,</para>
  <para style="q2" vid="ISA 45:22">ನನ್ನ ಕಡೆಗೆ ನೋಡಿರಿ, ರಕ್ಷಣೆಯನ್ನು ಪಡೆಯಿರಿ.</para>
  <para style="q2" vid="ISA 45:22">ಏಕೆಂದರೆ ನಾನೇ ದೇವರು, ನನ್ನ ಹೊರತು ಯಾರೂ ಇಲ್ಲ.<verse eid="ISA 45:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="ISA 45:23"/>ನನ್ನಷ್ಟಕ್ಕೆ ನಾನೇ ಆಣೆಯನ್ನು ಇಟ್ಟಿದ್ದೇನೆ.</para>
  <para style="q2" vid="ISA 45:23">ನೀತಿಯುಳ್ಳ ವಾಕ್ಯವು ನನ್ನ ಬಾಯಿಂದ ಹೊರಟಿದೆ.</para>
  <para style="q2" vid="ISA 45:23">ಅದು ಹಿಂದಿರುಗದು.</para>
  <para style="q1" vid="ISA 45:23">ಪ್ರತಿಯೊಬ್ಬರು ನನ್ನ ಮುಂದೆ ಮೊಣಕಾಲೂರುವರು.</para>
  <para style="q2" vid="ISA 45:23">ಪ್ರತಿಯೊಂದು ನಾಲಿಗೆಯೂ ಪ್ರತಿಜ್ಞೆ ಮಾಡುವುದು.<verse eid="ISA 45:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="ISA 45:24"/>ಯೆಹೋವ ದೇವರಲ್ಲಿ ಮಾತ್ರ ನೀತಿಯೂ</para>
  <para style="q2" vid="ISA 45:24">ಬಲವೂ ಉಂಟೆಂದು ಮನುಷ್ಯರೂ ಸಹ ಅವರ ಬಳಿಗೆ ಬರುವರು.”</para>
  <para style="q1" vid="ISA 45:24">ಆತನ ಮೇಲೆ ಉರಿಗೊಂಡವರೆಲ್ಲರೂ ನಾಚಿಕೆಗೆ ಈಡಾಗುವರು,</para>
  <para style="q2" vid="ISA 45:24">ಎಂದು ಒಬ್ಬನು ನಿಶ್ಚಯವಾಗಿ ಹೇಳುತ್ತಾನೆ.<verse eid="ISA 45:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="ISA 45:25"/>ಇಸ್ರಾಯೇಲಿನ ಸಂತಾನದವರೆಲ್ಲರೂ</para>
  <para style="q2" vid="ISA 45:25">ಯೆಹೋವ ದೇವರಲ್ಲಿ ನೀತಿವಂತರಾಗಿ ಹೆಚ್ಚಳಪಡುವರು.<verse eid="ISA 45:25"/></para>
  <chapter eid="ISA 45"/>
  <chapter number="46" style="c" sid="ISA 46"/>
  <para style="s1">ಬಾಬಿಲೋನಿನ ದೇವರುಗಳು</para>
  <para style="q1">
    <verse number="1" style="v" sid="ISA 46:1"/>ಬೇಲ್ ದೇವತೆಯು ತಗ್ಗಿದೆ, ನೆಬೋ ದೇವತೆಯು ಕುಗ್ಗಿದೆ.</para>
  <para style="q2" vid="ISA 46:1">ಅವರ ವಿಗ್ರಹಗಳು ಮೃಗಗಳ ಮತ್ತು ಪಶುಗಳ ಮೇಲೆ ಇದ್ದವು.</para>
  <para style="q1" vid="ISA 46:1">ನೀವು ಹೊರುತ್ತಿದ್ದವುಗಳು ಭಾರವಾದ ಹೊರೆಯಾಗಿದ್ದವು.</para>
  <para style="q2" vid="ISA 46:1">ಆಯಾಸವುಳ್ಳ ಮೃಗಗಳಿಗೆ ಅವು ಭಾರವಾದವು.<verse eid="ISA 46:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 46:2"/>ಒಟ್ಟಿಗೆ ಕುಗ್ಗಿ ಬಗ್ಗಿವೆ.</para>
  <para style="q2" vid="ISA 46:2">ತಮ್ಮ ಮೇಲೆ ಬಿದ್ದ ಭಾರವನ್ನು ಹೊತ್ತು ನಿರ್ವಹಿಸಲಾರದೆ,</para>
  <para style="q2" vid="ISA 46:2">ತಾವೇ ಸೆರೆಗೆ ಹೋದವು.<verse eid="ISA 46:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 46:3"/>ಯಾಕೋಬನ ಮನೆತನದವರೇ,</para>
  <para style="q2" vid="ISA 46:3">ಇಸ್ರಾಯೇಲ್ ಮನೆತನದಲ್ಲಿ ಉಳಿದಿರುವವರೇ,</para>
  <para style="q1" vid="ISA 46:3">ನಿಮ್ಮನ್ನು ಗರ್ಭದಲ್ಲಿ ಹೊತ್ತು,</para>
  <para style="q2" vid="ISA 46:3">ಹುಟ್ಟಿದಂದಿನಿಂದ ಪಾಲಿಸುತ್ತಿದ್ದಾತನ ಮಾತನ್ನು ಕೇಳಿರಿ.<verse eid="ISA 46:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 46:4"/>ನಿಮ್ಮ ಮುಪ್ಪಿನ ತನಕ ನಾನೇ ಆಧಾರ;</para>
  <para style="q2" vid="ISA 46:4">ನೆರೆ ಬಂದಾಗಲೂ ನಿಮ್ಮನ್ನು ಹೊತ್ತು ಸಹಿಸುವೆನು;</para>
  <para style="q1" vid="ISA 46:4">ನಾನೇ ಉಂಟುಮಾಡಿದೆನು; ನಾನೇ ಹೊರುವೆನು;</para>
  <para style="q2" vid="ISA 46:4">ಹೌದು, ನಿಮ್ಮನ್ನು ಹೊತ್ತು, ಸಹಿಸಿ, ನಿರ್ವಹಿಸುವೆನು.<verse eid="ISA 46:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 46:5"/>ನನ್ನನ್ನು ಯಾರಿಗೆ ಸರಿಕಟ್ಟಿ ಹೋಲಿಸುತ್ತೀರಿ?</para>
  <para style="q2" vid="ISA 46:5">ನನ್ನ ಸಮಾನರೆಂದು ನನ್ನನ್ನು ಯಾರೊಡನೆ ಸಮಮಾಡುವಿರಿ?<verse eid="ISA 46:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 46:6"/>ಚೀಲದಿಂದ ಚಿನ್ನವನ್ನು ಸುರಿದು,</para>
  <para style="q2" vid="ISA 46:6">ತಕ್ಕಡಿಯಲ್ಲಿ ಬೆಳ್ಳಿಯನ್ನು ತೂಗಿ,</para>
  <para style="q1" vid="ISA 46:6">ಅಕ್ಕಸಾಲಿಗನಿಗೆ ಕೂಲಿ ಕೊಟ್ಟಾಗ, ಅವನು ಅದನ್ನು ದೇವರನ್ನಾಗಿ ಮಾಡಲು,</para>
  <para style="q2" vid="ISA 46:6">ಅವರು ಅದಕ್ಕೆ ಎರಗಿ ಪೂಜೆ ಮಾಡುವರು.<verse eid="ISA 46:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 46:7"/>ಅವರು ಅದನ್ನು ತಮ್ಮ ಹೆಗಲಿನ ಮೇಲೆ ಹೊತ್ತುಕೊಂಡು ಮೆರವಣಿಗೆ ಮಾಡಿ,</para>
  <para style="q2" vid="ISA 46:7">ಪೀಠದ ಮೇಲೆ ಇಳಿಸಿ ನಿಲ್ಲಿಸುವರು.</para>
  <para style="q2" vid="ISA 46:7">ಅದು ಅದರ ಸ್ಥಳದಿಂದ ಜರುಗದು.</para>
  <para style="q1" vid="ISA 46:7">ಹೌದು, ಒಬ್ಬನು ಕೂಗಿಕೊಂಡರೂ ಅದು ಅವನಿಗೆ ಉತ್ತರ ಕೊಡಲಾರದು ಇಲ್ಲವೆ</para>
  <para style="q2" vid="ISA 46:7">ಅವನನ್ನು ಕಷ್ಟದಿಂದ ರಕ್ಷಿಸಲಾರದು.<verse eid="ISA 46:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 46:8"/>ದ್ರೋಹಿಗಳೇ, ಇದನ್ನು ಜ್ಞಾಪಕದಲ್ಲಿಟ್ಟುಕೊಂಡು,</para>
  <para style="q2" vid="ISA 46:8">ಅದನ್ನು ತಿರುಗಿ ನಿಮ್ಮ ಮನಸ್ಸಿಗೆ ತಂದುಕೊಳ್ಳಿರಿ.<verse eid="ISA 46:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 46:9"/>ಪುರಾತನ ಸಂಗತಿಗಳನ್ನು ಜ್ಞಾಪಿಸಿಕೊಳ್ಳಿರಿ.</para>
  <para style="q2" vid="ISA 46:9">ಏಕೆಂದರೆ ನಾನೇ ದೇವರು, ಮತ್ತೊಬ್ಬನಿಲ್ಲ.</para>
  <para style="q2" vid="ISA 46:9">ನಾನೇ ದೇವರು, ನನಗೆ ಸರಿಸಮಾನನು ಇಲ್ಲ.<verse eid="ISA 46:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 46:10"/>ಆರಂಭದಲ್ಲಿಯೇ ಅಂತ್ಯವನ್ನೂ,</para>
  <para style="q2" vid="ISA 46:10">ಪೂರ್ವಕಾಲದಿಂದ ಇನ್ನೂ ನಡೆಯದ ಸಂಗತಿಗಳನ್ನೂ ಪ್ರಕಟಿಸಿದ್ದೇನೆ.</para>
  <para style="q1" vid="ISA 46:10">ನನ್ನ ಆಲೋಚನೆಯು ನಿಲ್ಲುವುದೆಂದೂ,</para>
  <para style="q2" vid="ISA 46:10">ನನಗೆ ಮೆಚ್ಚಿದ್ದನ್ನು ಮಾಡುವೆನೆಂದೂ ಅರುಹಿದ್ದೇನೆ.<verse eid="ISA 46:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 46:11"/>ಪೂರ್ವದಿಂದ ಒಂದು ಕ್ರೂರವಾದ ಪಕ್ಷಿಯೂ,</para>
  <para style="q2" vid="ISA 46:11">ದೂರದೇಶದಿಂದ ನನ್ನ ಆಜ್ಞೆಯನ್ನು ನಡೆಸುವ ಮನುಷ್ಯನೂ ಬರಲಿ, ಎಂದು ಕರೆದಿದ್ದೇನೆ.</para>
  <para style="q1" vid="ISA 46:11">ನಾನು ನುಡಿದಿದ್ದೇನೆ, ಅದನ್ನು ನಾನು ಈಡೇರಿಸುವೆನು.</para>
  <para style="q2" vid="ISA 46:11">ಆಲೋಚಿಸಿದ್ದೇನೆ, ನಾನು ಅದನ್ನು ಮಾಡುವೆನು.<verse eid="ISA 46:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 46:12"/>ಕಠಿಣ ಹೃದಯವುಳ್ಳವರೇ,</para>
  <para style="q2" vid="ISA 46:12">ನೀತಿಗೆ ದೂರವಾದವರೇ, ನನಗೆ ಕಿವಿಗೊಡಿರಿ.<verse eid="ISA 46:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="ISA 46:13"/>ನನ್ನ ನೀತಿಯನ್ನು ಹತ್ತಿರಕ್ಕೆ ಬರಮಾಡುವೆನು.</para>
  <para style="q2" vid="ISA 46:13">ಅದು ಇನ್ನು ದೂರವಾಗಿರದು.</para>
  <para style="q2" vid="ISA 46:13">ನನ್ನ ರಕ್ಷಣೆಯು ಇನ್ನು ತಡವಾಗದು,</para>
  <para style="q1" vid="ISA 46:13">ನನ್ನ ಮಹಿಮೆಯಾಗಿರುವ ಇಸ್ರಾಯೇಲಿಗೋಸ್ಕರ</para>
  <para style="q2" vid="ISA 46:13">ಚೀಯೋನಿನಲ್ಲಿ ರಕ್ಷಣೆಯನ್ನು ಉಂಟುಮಾಡುವೆನು.<verse eid="ISA 46:13"/></para>
  <chapter eid="ISA 46"/>
  <chapter number="47" style="c" sid="ISA 47"/>
  <para style="s1">ಬಾಬಿಲೋನಿನ ಪತನ</para>
  <para style="q1">
    <verse number="1" style="v" sid="ISA 47:1"/>ಬಾಬಿಲೋನಿನ ಪುತ್ರಿಯಾದ ಕನ್ನಿಕೆಯೇ,</para>
  <para style="q2" vid="ISA 47:1">ಕೆಳಕ್ಕೆ ಇಳಿದುಬಂದು, ಧೂಳಿನಲ್ಲಿ ಕುಳಿತುಕೋ!</para>
  <para style="q1" vid="ISA 47:1">ಕಸ್ದೀಯರ ಪುತ್ರಿಯೇ,</para>
  <para style="q2" vid="ISA 47:1">ಸಿಂಹಾಸನರಹಿತಳಾಗಿ ನೆಲದ ಮೇಲೆ ಕುಳಿತುಕೋ.</para>
  <para style="q1" vid="ISA 47:1">ಏಕೆಂದರೆ ಇನ್ನು ಮೇಲೆ ನಿನ್ನನ್ನು ಕೋಮಲೆ</para>
  <para style="q2" vid="ISA 47:1">ಮತ್ತು ನಾಜೂಕಾದವಳು ಎಂದು ಕರೆಯುವುದಿಲ್ಲ.<verse eid="ISA 47:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 47:2"/>ಬೀಸುವ ಕಲ್ಲನ್ನು ಹಿಡಿದು, ಹಿಟ್ಟನ್ನು ಬೀಸು.</para>
  <para style="q2" vid="ISA 47:2">ಮುಸುಕನ್ನು ತೆಗೆದುಹಾಕಿ,</para>
  <para style="q1" vid="ISA 47:2">ನಿನ್ನ ಕಾಲನ್ನು ಬರಿದುಮಾಡಿ, ತೊಡೆಯನ್ನು ಮುಚ್ಚದೆ,</para>
  <para style="q2" vid="ISA 47:2">ನದಿಗಳನ್ನು ಹಾದುಹೋಗು.<verse eid="ISA 47:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 47:3"/>ನಿನ್ನ ಬೆತ್ತಲೆತನವು ಮರೆಮಾಡದೇ ಇದ್ದುದರಿಂದ</para>
  <para style="q2" vid="ISA 47:3">ನೀನು ನಾಚಿಕೆಗೆ ಈಡಾಗುವೆ.</para>
  <para style="q2" vid="ISA 47:3">ನಾನು ಯಾರನ್ನೂ ಕರುಣಿಸದೆ ಮುಯ್ಯಿತೀರಿಸುವೆನು.<verse eid="ISA 47:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 47:4"/>ನಮ್ಮ ವಿಮೋಚಕರಿಗೆ ಸೇನಾಧೀಶ್ವರರಾದ ಯೆಹೋವ ದೇವರು ಎಂಬುದೇ ಅವರ ಹೆಸರು.</para>
  <para style="q2" vid="ISA 47:4">ಅವರೇ ಇಸ್ರಾಯೇಲಿನ ಪರಿಶುದ್ಧರು.<verse eid="ISA 47:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 47:5"/>ಕಸ್ದೀಯರ ಪುತ್ರಿಯೇ,</para>
  <para style="q2" vid="ISA 47:5">“ಮೌನವಾಗಿ ಕುಳಿತುಕೋ, ಕತ್ತಲೆಯೊಳಗೆ ಹೋಗು.</para>
  <para style="q1" vid="ISA 47:5">ಏಕೆಂದರೆ ಇನ್ನು ಮೇಲೆ</para>
  <para style="q2" vid="ISA 47:5">ನಿನ್ನನ್ನು ರಾಜ್ಯಗಳ ರಾಣಿ ಎಂದು ಕರೆಯುವುದಿಲ್ಲ.<verse eid="ISA 47:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 47:6"/>ನಾನು ನಿನ್ನ ಜನರ ಮೇಲೆ ರೋಷಗೊಂಡು,</para>
  <para style="q2" vid="ISA 47:6">ನನ್ನ ಸೊತ್ತನ್ನು ಅಪವಿತ್ರ ಮಾಡಿ,</para>
  <para style="q1" vid="ISA 47:6">ನಿನ್ನ ಕೈಯಲ್ಲಿ ಅವರನ್ನು ಒಪ್ಪಿಸಿಬಿಟ್ಟೆನು.</para>
  <para style="q2" vid="ISA 47:6">ನೀನು ಅವರಿಗೆ ಕರುಣೆಯನ್ನು ತೋರಿಸದೆ,</para>
  <para style="q1" vid="ISA 47:6">ವೃದ್ಧರ ಮೇಲೆಯೂ,</para>
  <para style="q2" vid="ISA 47:6">ಬಹು ಭಾರವಾದ ನೊಗವನ್ನು ಹೊರಿಸಿದೆ.<verse eid="ISA 47:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 47:7"/>‘ನಾನು ಶಾಶ್ವತವಾದ ರಾಣಿ’</para>
  <para style="q2" vid="ISA 47:7">ಎಂದು ನೀನು ಅಂದುಕೊಂಡದ್ದರಿಂದ</para>
  <para style="q1" vid="ISA 47:7">ಈ ಸಂಗತಿಗಳನ್ನು ನಿನ್ನ ಹೃದಯದಲ್ಲಿ ಇಟ್ಟುಕೊಳ್ಳಲಿಲ್ಲ.</para>
  <para style="q2" vid="ISA 47:7">ಅವರ ಅಂತ್ಯವನ್ನೂ ನೆನಸಿಕೊಳ್ಳಲಿಲ್ಲ.<verse eid="ISA 47:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 47:8"/>“ನಾನೇ ಇರುವವಳು, ನನ್ನ ಹೊರತು ಇನ್ನು ಯಾರೂ ಇಲ್ಲ.</para>
  <para style="q2" vid="ISA 47:8">‘ನಾನು ವಿಧವೆಯಾಗಿ ಕೂತುಕೊಳ್ಳುವುದಿಲ್ಲ.</para>
  <para style="q1" vid="ISA 47:8">ಪುತ್ರ ಶೋಕವನ್ನು ಅನುಭವಿಸುವುದಿಲ್ಲ,’ ಎನ್ನುವವಳೇ,</para>
  <para style="q2" vid="ISA 47:8">ಭೋಗಾಸಕ್ತಳೇ, ನೆಮ್ಮದಿಯಾಗಿ ನೆಲೆಗೊಂಡಿರುವವಳೇ,</para>
  <para style="q2" vid="ISA 47:8">ಈಗ ಇದನ್ನು ಕೇಳು.<verse eid="ISA 47:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 47:9"/>ಒಂದೇ ದಿನದೊಳಗೆ, ಒಂದು ಕ್ಷಣದಲ್ಲೇ,</para>
  <para style="q2" vid="ISA 47:9">ಪುತ್ರ ಶೋಕ ಮತ್ತು ವಿಧವೆಯ ಸ್ಥಿತಿಯು</para>
  <para style="q2" vid="ISA 47:9">ಇವೆರಡೂ ನಿನಗೆ ಬರುವುದು.</para>
  <para style="q1" vid="ISA 47:9">ನಿನ್ನ ಮಂತ್ರಗಳು ಬಹಳವಾಗಿರುವುದರಿಂದಲೂ,</para>
  <para style="q2" vid="ISA 47:9">ನಿನ್ನ ಮಾಟಗಳು ಹೆಚ್ಚಾಗಿರುವುದರಿಂದಲೂ,</para>
  <para style="q2" vid="ISA 47:9">ಅವು ಸಂಪೂರ್ಣವಾಗಿ ನಿನ್ನ ಮೇಲೆ ಬರುವುವು.<verse eid="ISA 47:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 47:10"/>ಏಕೆಂದರೆ ನೀನು ನಿನ್ನ ಕೆಟ್ಟತನದಲ್ಲಿ ನಂಬಿಕೆ ಇಟ್ಟು,</para>
  <para style="q2" vid="ISA 47:10">‘ನನ್ನನ್ನು ಯಾರೂ ನೋಡುವುದಿಲ್ಲ’ ಎಂದು ಹೇಳಿದೆ.</para>
  <para style="q1" vid="ISA 47:10">ನಿನ್ನ ಜ್ಞಾನ, ನಿನ್ನ ತಿಳುವಳಿಕೆ ನಿನ್ನನ್ನು ದಾರಿ ತಪ್ಪಿಸಿದ್ದರಿಂದ,</para>
  <para style="q2" vid="ISA 47:10">ನಿನ್ನ ಹೃದಯದಲ್ಲಿ: ‘ಈಗ ಇರುವವಳು ನಾನೇ.</para>
  <para style="q2" vid="ISA 47:10">ನನ್ನ ಹೊರತು ಇನ್ನು ಯಾರೂ ಇಲ್ಲ,’ ಎಂದುಕೊಂಡೆ.<verse eid="ISA 47:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 47:11"/>ಆದ್ದರಿಂದ ನಿನ್ನ ಮಂತ್ರಕ್ಕೂ ಮೀರಿದ</para>
  <para style="q2" vid="ISA 47:11">ಕೇಡು ನಿನ್ನ ಮೇಲೆ ಬರುವುದು.</para>
  <para style="q1" vid="ISA 47:11">ನೀನು ಪರಿಹರಿಸಲಾಗದ ವಿಪತ್ತು</para>
  <para style="q2" vid="ISA 47:11">ನಿನ್ನ ಮೇಲೆ ಬೀಳುವುದು.</para>
  <para style="q1" vid="ISA 47:11">ನಿನಗೆ ತಿಳಿಯದ ನಾಶನವು</para>
  <para style="q2" vid="ISA 47:11">ಫಕ್ಕನೆ ನಿನ್ನ ಮೇಲೆ ಬರುವುದು.”<verse eid="ISA 47:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 47:12"/>ನಿನ್ನ ಮಾಟಗಳ ಸಂಗಡ ನಿಂತುಕೋ.</para>
  <para style="q2" vid="ISA 47:12">ನಿನ್ನ ಬಾಲ್ಯಾರಭ್ಯ ಬೇಸತ್ತು, ಅಭ್ಯಾಸಿಸಿರುವ ನಿನ್ನ ಮಂತ್ರ ತಂತ್ರಗಳನ್ನೂ,</para>
  <para style="q2" vid="ISA 47:12">ನಿನ್ನ ಮಾಟಗಳನ್ನೂ ಲೆಕ್ಕವಿಲ್ಲದೆ ಪ್ರಯೋಗಿಸು.</para>
  <para style="q1" vid="ISA 47:12">ಇದರಿಂದ ಒಂದು ವೇಳೆ ನಿನಗೆ ಲಾಭವಾದೀತು.</para>
  <para style="q2" vid="ISA 47:12">ಒಂದು ವೇಳೆ ಭಯ ಉಂಟಾದೀತು.<verse eid="ISA 47:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="ISA 47:13"/>ನೀನು ನಿನ್ನ ಬಹಳವಾದ ಆಲೋಚನೆಗಳಿಂದ ಆಯಾಸಗೊಂಡಿದ್ದೀ.</para>
  <para style="q2" vid="ISA 47:13">ಖಗೋಳಜ್ಞರು, ಜೋಯಿಸರು, ಪಂಚಾಂಗದವರು,</para>
  <para style="q1" vid="ISA 47:13">ಇವರೆಲ್ಲರೂ ನಿಂತುಕೊಂಡು ನಿನಗೆ ಬರುವ</para>
  <para style="q2" vid="ISA 47:13">ವಿಪತ್ತುಗಳಿಂದ ನಿನ್ನನ್ನು ರಕ್ಷಿಸಲಿ.<verse eid="ISA 47:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="ISA 47:14"/>ಇಗೋ, ಅವರೆಲ್ಲಾ ಕೂಳೆಯಂತಿರುವರು,</para>
  <para style="q2" vid="ISA 47:14">ಬೆಂಕಿಯು ಅವರನ್ನು ಸುಟ್ಟುಬಿಡುವುದು.</para>
  <para style="q1" vid="ISA 47:14">ಜ್ವಾಲೆಯ ರಭಸದಿಂದ ತಮ್ಮನ್ನು</para>
  <para style="q2" vid="ISA 47:14">ರಕ್ಷಿಸಿಕೊಳ್ಳಲಾರರು ಇಲ್ಲವೆ</para>
  <para style="q1" vid="ISA 47:14">ಕಾಯಿಸಿಕೊಳ್ಳುವುದಕ್ಕೆ ಕೆಂಡವಿರುವುದಿಲ್ಲ.</para>
  <para style="q2" vid="ISA 47:14">ಹತ್ತಿರ ಕೂತುಕೊಳ್ಳಲು ಬೆಂಕಿಯೂ ಇಲ್ಲ.<verse eid="ISA 47:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="ISA 47:15"/>ನೀನು ಪ್ರಯಾಸಪಟ್ಟವುಗಳೆಲ್ಲಾ ನಿನಗೆ ಹೀಗಾಗುವುವು.</para>
  <para style="q2" vid="ISA 47:15">ನಿನ್ನ ಬಾಲ್ಯ ಪ್ರಾಯದಿಂದ ನಿನ್ನ ವರ್ತಕರು ಚದರಿ,</para>
  <para style="q2" vid="ISA 47:15">ತಮ್ಮ ತಮ್ಮ ಪ್ರಾಂತಕ್ಕೆ ಹೋಗಿ ಬಿಡುವರು.</para>
  <para style="q1" vid="ISA 47:15">ನಿನ್ನನ್ನು ರಕ್ಷಿಸಲು ಒಬ್ಬನೂ ಇರನು.<verse eid="ISA 47:15"/></para>
  <chapter eid="ISA 47"/>
  <chapter number="48" style="c" sid="ISA 48"/>
  <para style="s1">ಹಟಮಾರಿ ಇಸ್ರಾಯೇಲರು</para>
  <para style="q1">
    <verse number="1" style="v" sid="ISA 48:1"/>“ಇಸ್ರಾಯೇಲ್ ಎಂಬ ಹೆಸರಿನವರೂ,</para>
  <para style="q2" vid="ISA 48:1">ಯೆಹೂದವೆಂಬ ಒರತೆಯಿಂದ ಬಂದವರೂ</para>
  <para style="q2" vid="ISA 48:1">ಆದ ಯಾಕೋಬನ ಮನೆತನದವರೇ, ಇದನ್ನು ಕೇಳಿರಿ:</para>
  <para style="q1" vid="ISA 48:1">ಯೆಹೋವ ದೇವರ ಹೆಸರಿನ ಮೇಲೆ ಆಣೆ ಇಟ್ಟು,</para>
  <para style="q2" vid="ISA 48:1">ಇಸ್ರಾಯೇಲಿನ ದೇವರನ್ನು ಸ್ಮರಿಸುತ್ತೀರಿ.</para>
  <para style="q2" vid="ISA 48:1">ಆದರೆ ಸತ್ಯದಿಂದಲೂ ಅಥವಾ ನೀತಿಯಿಂದಲೂ ಅಲ್ಲ.<verse eid="ISA 48:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 48:2"/>ಏಕೆಂದರೆ ಅವರು ತಾವು ಪರಿಶುದ್ಧ ಪಟ್ಟಣದವರು ಎಂದು</para>
  <para style="q2" vid="ISA 48:2">ಇಸ್ರಾಯೇಲಿನ ದೇವರ ಮೇಲೆ ಆತುಕೊಳ್ಳುತ್ತಾರೆ.</para>
  <para style="q2" vid="ISA 48:2">ಸೇನಾಧೀಶ್ವರ ಯೆಹೋವ ದೇವರು ಎಂಬುದು ಆತನ ಹೆಸರು.<verse eid="ISA 48:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 48:3"/>ಪೂರ್ವಕಾಲದಲ್ಲೇ ಹಳೆಯ ಸಂಗತಿಗಳನ್ನು ನಾನು ಪ್ರಕಟಿಸಿದ್ದೇನೆ.</para>
  <para style="q2" vid="ISA 48:3">ಅವು ನನ್ನ ಬಾಯಿಂದ ಹೊರಟವು ಮತ್ತು ನಾನು ಅವುಗಳನ್ನು ತಿಳಿಸಿದ್ದೇನೆ.</para>
  <para style="q2" vid="ISA 48:3">ನಾನು ತಟ್ಟನೆ ನಡೆಸಲು, ಅವು ನೆರವೇರಿದವು.<verse eid="ISA 48:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 48:4"/>ಏಕೆಂದರೆ ನೀನು ಹಟಗಾರ.</para>
  <para style="q2" vid="ISA 48:4">ನಿನ್ನ ಕತ್ತಿನ ನರಗಳು ಕಬ್ಬಿಣ,</para>
  <para style="q2" vid="ISA 48:4">ನಿನ್ನ ಹಣೆ ಕಂಚಿನದು ಎಂದು ನಾನು ತಿಳಿದುಕೊಂಡಿದ್ದೇನೆ.<verse eid="ISA 48:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 48:5"/>‘ಈ ಕಾರ್ಯಗಳನ್ನು ನನ್ನ ವಿಗ್ರಹಗಳು ನಡಿಸಿದೆ.</para>
  <para style="q2" vid="ISA 48:5">ನನ್ನ ಕೆತ್ತಿದ ವಿಗ್ರಹ ಮತ್ತು ಎರಕದ</para>
  <para style="q2" vid="ISA 48:5">ವಿಗ್ರಹ ಇವುಗಳನ್ನು ವಿಧಿಸಿದೆ,’ ಎಂದು ನೀನು ಹೇಳಿಕೊಳ್ಳದಂತೆ</para>
  <para style="q1" vid="ISA 48:5">ನಾನು ಪುರಾತನ ಕಾಲದಲ್ಲಿಯೇ</para>
  <para style="q2" vid="ISA 48:5">ಇವು ಸಂಭವಿಸುವುದಕ್ಕಿಂತ ಮೊದಲೇ ತಿಳಿಸಿದೆನು.<verse eid="ISA 48:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 48:6"/>ನೀನು ಕೇಳಿದ್ದೀ, ಇವೆಲ್ಲವುಗಳನ್ನು ದೃಷ್ಟಿಸು.</para>
  <para style="q2" vid="ISA 48:6">ನೀವು ಅದನ್ನು ಒಪ್ಪಿಕೊಳ್ಳದೆ ಇದ್ದೀರೋ?</para>
  <para style="b" vid="ISA 48:6"/>
  <para style="q1" vid="ISA 48:6">“ಇಂದಿನಿಂದ ಹೊಸ ಸಂಗತಿಗಳನ್ನೂ,</para>
  <para style="q2" vid="ISA 48:6">ನೀನು ತಿಳಿಯದಿದ್ದ ಗುಪ್ತವಾದ ವಿಷಯಗಳನ್ನೂ ನಿನಗೆ ಹೇಳುತ್ತೇನೆ.<verse eid="ISA 48:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 48:7"/>ಈಗಲೇ ಉಂಟಾಗುತ್ತಿವೆ, ಪುರಾತನ ಕಾಲದಲ್ಲಿ ಆಗಿಲ್ಲ;</para>
  <para style="q2" vid="ISA 48:7">‘ಇದೆಲ್ಲ ನನಗೆ ಮೊದಲೇ ತಿಳಿದಿತ್ತು,’</para>
  <para style="q1" vid="ISA 48:7">ಎಂದು ನೀನು ಕೊಚ್ಚಿಕೊಳ್ಳದಂತೆ,</para>
  <para style="q2" vid="ISA 48:7">ನಾನು ಇವುಗಳನ್ನು ನಿನಗೆ ಮುಂತಿಳಿಸಲಿಲ್ಲ.<verse eid="ISA 48:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 48:8"/>ನೀನು ಕೇಳಿಲ್ಲ, ತಿಳಿದೂ ಇಲ್ಲ.</para>
  <para style="q2" vid="ISA 48:8">ಪುರಾತನ ಕಾಲದಿಂದ ನಿನ್ನ ಕಿವಿಯು ತೆರೆದೇ ಇಲ್ಲ.</para>
  <para style="q1" vid="ISA 48:8">ಏಕೆಂದರೆ ನೀನು ದೊಡ್ಡ ವಂಚಕನೆಂದೂ,</para>
  <para style="q2" vid="ISA 48:8">ಗರ್ಭದಿಂದಲೇ ನೀನು ದ್ರೋಹಿ ಎಂದೂ ನಾನು ತಿಳಿದುಕೊಂಡಿದ್ದೇನೆ.<verse eid="ISA 48:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 48:9"/>ನಾನು ನನ್ನ ಹೆಸರಿನ ನಿಮಿತ್ತ ನನ್ನ ಕೋಪವನ್ನು ತಡೆ ಮಾಡಿದೆನು.</para>
  <para style="q2" vid="ISA 48:9">ನಾನು ನನ್ನ ಹೆಸರಿಗೆ ಕಳಂಕ ಬಾರದಂತೆ,</para>
  <para style="q2" vid="ISA 48:9">ನಿನ್ನನ್ನು ನಿರ್ಮೂಲಮಾಡದೆ ತಾಳಿಕೊಳ್ಳುವೆನು.<verse eid="ISA 48:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 48:10"/>ನಾನು ನಿನ್ನನ್ನು ಪರಿಶೋಧಿಸಿದ್ದೇನೆ.</para>
  <para style="q2" vid="ISA 48:10">ಆದರೆ ಬೆಳ್ಳಿಯಂತೆ ಅಲ್ಲ,</para>
  <para style="q2" vid="ISA 48:10">ಸಂಕಟದ ಕುಲುಮೆಯಿಂದ ನಿನ್ನನ್ನು ಆಯ್ದುಕೊಂಡಿದ್ದೇನೆ.<verse eid="ISA 48:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 48:11"/>ನನಗಾಗಿಯೇ, ನನಗೋಸ್ಕರವೇ ಇದನ್ನು ಮಾಡುವೆನು.</para>
  <para style="q2" vid="ISA 48:11">ಏಕೆಂದರೆ ನನ್ನ ಹೆಸರು ಹೇಗೆ ಅಪವಿತ್ರವಾಗುವುದು?</para>
  <para style="q2" vid="ISA 48:11">ನನ್ನ ಮಹಿಮೆಯನ್ನು ನಾನು ಮತ್ತೊಬ್ಬನಿಗೆ ಸಲ್ಲಗೊಡಿಸೆನು.<verse eid="ISA 48:11"/></para>
  <para style="s1">ಇಸ್ರಾಯೇಲಿನ ಬಿಡುಗಡೆ</para>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 48:12"/>“ಯಾಕೋಬೇ, ನಾನು ಕರೆದ ಇಸ್ರಾಯೇಲೇ,</para>
  <para style="q2" vid="ISA 48:12">ನನ್ನ ಕಡೆಗೆ ಕಿವಿಗೊಡು.</para>
  <para style="q1" vid="ISA 48:12">ಆತನು ನಾನೇ,</para>
  <para style="q2" vid="ISA 48:12">ನಾನೇ ಮೊದಲನೆಯವನು, ನಾನೇ ಕಡೆಯವನು.<verse eid="ISA 48:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="ISA 48:13"/>ನನ್ನ ಕೈ ಭೂಮಿಗೆ ಅಸ್ತಿವಾರವನ್ನು ಹಾಕಿತು,</para>
  <para style="q2" vid="ISA 48:13">ನನ್ನ ಬಲಗೈ ಆಕಾಶವನ್ನು ಹರಡಿತು,</para>
  <para style="q1" vid="ISA 48:13">ನಾನು ಅವುಗಳನ್ನು ಕರೆಯಲು,</para>
  <para style="q2" vid="ISA 48:13">ಅವು ಒಟ್ಟಾಗಿ ನಿಂತುಕೊಂಡವು.<verse eid="ISA 48:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="ISA 48:14"/>“ನೀವೆಲ್ಲರೂ ಕೂಡಿಕೊಂಡು ಕೇಳಿರಿ.</para>
  <para style="q2" vid="ISA 48:14">ಅವುಗಳ ಮಧ್ಯದಲ್ಲಿ ಈ ಸಂಗತಿಗಳನ್ನು ಪ್ರಕಟಿಸಿದವರು ಯಾರು?</para>
  <para style="q1" vid="ISA 48:14">ಯೆಹೋವ ದೇವರು ಆಯ್ಕೆ ಮಾಡಿದ ಮಿತ್ರನು</para>
  <para style="q2" vid="ISA 48:14">ಬಾಬಿಲೋನಿನ ವಿರುದ್ಧ ತನ್ನ ಉದ್ದೇಶವನ್ನು ಪೂರೈಸುತ್ತಾನೆ.</para>
  <para style="q2" vid="ISA 48:14">ತನ್ನ ತೋಳು ಕಸ್ದೀಯರ ಮೇಲೆ ಇರುವುದು.<verse eid="ISA 48:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="ISA 48:15"/>ನಾನೇ, ನಾನಾಗಿಯೇ ಮಾತನಾಡಿದ್ದೇನೆ.</para>
  <para style="q2" vid="ISA 48:15">ನಾನೇ ಅವನನ್ನು ಕರೆದದ್ದು;</para>
  <para style="q1" vid="ISA 48:15">ಅವನನ್ನು ನಾನೇ ಬರಮಾಡಿದ್ದೇನೆ.</para>
  <para style="q2" vid="ISA 48:15">ಅವನ ಮಾರ್ಗವು ಯಶಸ್ವಿಯಾಗುವುದು.<verse eid="ISA 48:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="ISA 48:16"/>“ನನ್ನ ಸಮೀಪಕ್ಕೆ ಬಂದು ಇದನ್ನು ಕೇಳಿರಿ.</para>
  <para style="q1" vid="ISA 48:16">“ಆದಿಯಿಂದಲೂ ನಾನು ಗುಟ್ಟಾಗಿ ಮಾತಾಡಲಿಲ್ಲ,</para>
  <para style="q2" vid="ISA 48:16">ಭೂಮಿಯು ಉಂಟಾದಂದಿನಿಂದ ಅಲ್ಲಿ ನಾನು ಇದ್ದೇನೆ.”</para>
  <para style="b" vid="ISA 48:16"/>
  <para style="q1" vid="ISA 48:16">ಈಗ ಸಾರ್ವಭೌಮ ಯೆಹೋವ ದೇವರು</para>
  <para style="q2" vid="ISA 48:16">ತಮ್ಮ ಪವಿತ್ರಾತ್ಮರ ಸಮೇತ ನನ್ನನ್ನು ಕಳುಹಿಸಿದ್ದಾರೆ.<verse eid="ISA 48:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="ISA 48:17"/>ನಿನ್ನ ವಿಮೋಚಕನೂ, ಇಸ್ರಾಯೇಲಿನ ಪರಿಶುದ್ಧನೂ</para>
  <para style="q2" vid="ISA 48:17">ಆಗಿರುವ ಯೆಹೋವ ದೇವರ ಮಾತಿದು,</para>
  <para style="q1" vid="ISA 48:17">“ನಿನ್ನ ಉಪಯೋಗಕ್ಕಾಗಿ ನಿನಗೆ ಬೋಧಿಸುವವನೂ,</para>
  <para style="q2" vid="ISA 48:17">ನೀನು ನಡೆಯಬೇಕಾದ ದಾರಿಯಲ್ಲಿ ನಿನ್ನನ್ನು ನಡೆಸುವವನೂ ಆದ</para>
  <para style="q2" vid="ISA 48:17">ನಾನೇ ನಿನ್ನ ಯೆಹೋವ ದೇವರು ಆಗಿದ್ದೇನೆ.<verse eid="ISA 48:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="ISA 48:18"/>ನೀನು ನನ್ನ ಆಜ್ಞೆಗಳಿಗೆ ಕಿವಿಗೊಟ್ಟಿದ್ದರೆ ಚೆನ್ನಾಗಿತ್ತು!</para>
  <para style="q2" vid="ISA 48:18">ಆಗ ನಿನ್ನ ಸಮಾಧಾನವು ನದಿಯಂತೆಯೂ,</para>
  <para style="q2" vid="ISA 48:18">ನಿನ್ನ ನೀತಿಯು ಸಮುದ್ರದ ಅಲೆಗಳಂತೆಯೂ ಇರುತ್ತಿದ್ದವು,<verse eid="ISA 48:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="ISA 48:19"/>ನಿನ್ನ ಸಂತಾನವು ಸಹ ಮರಳಿನಂತೆಯೂ,</para>
  <para style="q2" vid="ISA 48:19">ನಿನ್ನ ಮಕ್ಕಳು ಅಸಂಖ್ಯಾತ ಧಾನ್ಯಗಳಂತೆಯೂ ಇರುವರು.</para>
  <para style="q1" vid="ISA 48:19">ಅವರ ಹೆಸರುಗಳು ನನ್ನ ಸಮ್ಮುಖದಿಂದ,</para>
  <para style="q2" vid="ISA 48:19">ಅಳಿದುಹೋಗದೆ ಇರುವುದು.”<verse eid="ISA 48:19"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="20" style="v" sid="ISA 48:20"/>ಬಾಬಿಲೋನಿನಿಂದ ಹೊರಡಿರಿ.</para>
  <para style="q2" vid="ISA 48:20">ಕಸ್ದೀಯರ ಕಡೆಯಿಂದ ಓಡಿಹೋಗಿರಿ.</para>
  <para style="q1" vid="ISA 48:20">ಹರ್ಷಧ್ವನಿಯಿಂದ ಇದನ್ನು ಹೇಳಿ ಪ್ರಕಟಿಸಿರಿ.</para>
  <para style="q2" vid="ISA 48:20">ಭೂಮಿಯ ಕಟ್ಟಕಡೆಯವರೆಗೂ ಪ್ರಚಾರಪಡಿಸಿರಿ.</para>
  <para style="q1" vid="ISA 48:20">“ಯೆಹೋವ ದೇವರು ತಮ್ಮ ಸೇವಕನಾದ ಯಾಕೋಬನ್ನು</para>
  <para style="q2" vid="ISA 48:20">ವಿಮೋಚಿಸಿದ್ದಾರೆ,” ಎಂದು ನೀವು ಹೇಳಿರಿ.<verse eid="ISA 48:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="ISA 48:21"/>ದೇವರು ಅವರನ್ನು ಮರುಭೂಮಿಯಲ್ಲಿ ನಡಿಸಿದಾಗ, ಅವರಿಗೆ ದಾಹವಾಗಲಿಲ್ಲ.</para>
  <para style="q2" vid="ISA 48:21">ದೇವರು ಅವರಿಗಾಗಿ ನೀರನ್ನು ಬಂಡೆಯೊಳಗಿಂದ ಹರಿಸಿದರು.</para>
  <para style="q1" vid="ISA 48:21">ದೇವರು ಬಂಡೆಯನ್ನು ಸೀಳಲು,</para>
  <para style="q2" vid="ISA 48:21">ನೀರು ರಭಸದಿಂದ ಹೊರಗೆ ಬಂತು.<verse eid="ISA 48:21"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="22" style="v" sid="ISA 48:22"/>“ದುಷ್ಟರಿಗೆ ಸಮಾಧಾನವೇ ಇಲ್ಲ,”</para>
  <para style="q2" vid="ISA 48:22">ಎಂದು ಯೆಹೋವ ದೇವರು ನುಡಿಯುತ್ತಾರೆ.<verse eid="ISA 48:22"/></para>
  <chapter eid="ISA 48"/>
  <chapter number="49" style="c" sid="ISA 49"/>
  <para style="s1">ಯೆಹೋವ ದೇವರ ಸೇವಕ</para>
  <para style="q1">
    <verse number="1" style="v" sid="ISA 49:1"/>ದ್ವೀಪಗಳೇ, ನನ್ನ ಮಾತನ್ನು ಕೇಳಿರಿ.</para>
  <para style="q2" vid="ISA 49:1">ದೂರದ ರಾಷ್ಟ್ರಗಳೇ, ಕಿವಿಗೊಡಿರಿ!</para>
  <para style="q1" vid="ISA 49:1">ನನ್ನ ಜನನದ ಮುಂಚೆಯೇ ಯೆಹೋವ ದೇವರು ನನ್ನನ್ನು ಕರೆದರು.</para>
  <para style="q2" vid="ISA 49:1">ತಾಯಿಯ ಉದರದಲ್ಲಿದ್ದಾಗಲೇ ನನಗೆ ಹೆಸರಿಟ್ಟರು.<verse eid="ISA 49:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 49:2"/>ಆತನು ನನ್ನ ಬಾಯನ್ನು ಹರಿತವಾದ ಖಡ್ಗವನ್ನಾಗಿ ಮಾಡಿ,</para>
  <para style="q2" vid="ISA 49:2">ತನ್ನ ಕೈ ನೆರಳಿನಲ್ಲಿ ನನ್ನನ್ನು ಮರೆಯಾಗಿಟ್ಟಿದ್ದಾನೆ.</para>
  <para style="q1" vid="ISA 49:2">ನನ್ನನ್ನು ಆತನು ನುಣುಪಾದ ಬಾಣವನ್ನಾಗಿ ರೂಪಿಸಿ,</para>
  <para style="q2" vid="ISA 49:2">ತನ್ನ ಬತ್ತಳಿಕೆಯಲ್ಲಿ ಮುಚ್ಚಿಟ್ಟಿದ್ದಾನೆ.<verse eid="ISA 49:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 49:3"/>ಆತನು ನನಗೆ, “ನೀನು ನನ್ನ ಸೇವಕನು.</para>
  <para style="q2" vid="ISA 49:3">ನಾನು ಮಹಿಮೆ ಹೊಂದಬೇಕಾದ ಇಸ್ರಾಯೇಲೂ ಆಗಿದ್ದೀ!” ಎಂದು ಹೇಳಿದನು.<verse eid="ISA 49:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 49:4"/>ಅದಕ್ಕೆ ನಾನು, “ನಾನು ಪಡುವ ಪ್ರಯಾಸವು ವ್ಯರ್ಥ.</para>
  <para style="q2" vid="ISA 49:4">ನನ್ನ ಶಕ್ತಿಯೆಲ್ಲ ಶೂನ್ಯವಾಯಿತು, ನನ್ನ ಸಾಮರ್ಥ್ಯವೆಲ್ಲ ವ್ಯರ್ಥವಾಯಿತು,”</para>
  <para style="q2" vid="ISA 49:4">ಎಂದು ಹೇಳಿದೆನು.</para>
  <para style="q1" vid="ISA 49:4">ಆದರೂ ನಿಶ್ಚಯವಾಗಿ ನನ್ನ ನ್ಯಾಯವು ಯೆಹೋವ ದೇವರ ಬಳಿಯಲ್ಲಿಯೂ,</para>
  <para style="q2" vid="ISA 49:4">ನನ್ನ ಪ್ರತಿಫಲವು ನನ್ನ ದೇವರಲ್ಲಿಯೂ ಉಂಟು.<verse eid="ISA 49:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 49:5"/>ಈಗ ಯೆಹೋವ ದೇವರು ಹೀಗೆ ಹೇಳುತ್ತಾರೆ, ಯಾಕೋಬ್ಯರನ್ನು ತನ್ನ ಬಳಿಗೆ ಕರೆತರುವಂತೆಯೂ,</para>
  <para style="q2" vid="ISA 49:5">ಇಸ್ರಾಯೇಲರನ್ನು ತನ್ನೊಂದಿಗೆ ಸೇರಿಸಿಕೊಳ್ಳುವಂತೆಯೂ</para>
  <para style="q1" vid="ISA 49:5">ದೇವರು ಗರ್ಭದಲ್ಲಿಯೇ ನನ್ನನ್ನು</para>
  <para style="q2" vid="ISA 49:5">ತನ್ನ ಸೇವಕನನ್ನಾಗಿ ರೂಪಿಸಿದನು.</para>
  <para style="q1" vid="ISA 49:5">ಆದರೂ ನಾನು ಯೆಹೋವ ದೇವರ ದೃಷ್ಟಿಯಲ್ಲಿ ಮಾನ್ಯನಾಗಿರುವೆನು.</para>
  <para style="q2" vid="ISA 49:5">ನನ್ನ ದೇವರೇ ನನಗೆ ಬಲವು.<verse eid="ISA 49:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 49:6"/>ಆತನೇ ಈಗ ಹೀಗೆನ್ನುತ್ತಾನೆ,</para>
  <para style="q1" vid="ISA 49:6">“ನೀನು ನನ್ನ ಸೇವಕನಾಗಿ ಮಾಡಬೇಕಾದವುಗಳಲ್ಲಿ</para>
  <para style="q2" vid="ISA 49:6">ಯಾಕೋಬಿನ ಕುಲಗಳನ್ನು ಉನ್ನತಪಡಿಸುವುದೂ,</para>
  <para style="q2" vid="ISA 49:6">ಇಸ್ರಾಯೇಲಿನಲ್ಲಿ ರಕ್ಷಿತರಾದವರನ್ನು ತಿರುಗಿ ಬರಮಾಡುವುದೂ ಅಲ್ಪ ಕಾರ್ಯವಲ್ಲವೇ,</para>
  <para style="q1" vid="ISA 49:6">ನನ್ನ ರಕ್ಷಣೆಯು ಭೂಲೋಕದ ಕಟ್ಟಕಡೆಯವರೆಗೆ ವ್ಯಾಪಿಸುವಂತೆ</para>
  <para style="q2" vid="ISA 49:6">ನಿನ್ನನ್ನು ಸರ್ವಜನಾಂಗಗಳಿಗೂ ಬೆಳಕನ್ನಾಗಿ ಮಾಡುವೆನು.”<verse eid="ISA 49:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 49:7"/>ಮನಃಪೂರ್ವಕವಾಗಿ ತಿರಸ್ಕೃತನಾದವನೂ</para>
  <para style="q2" vid="ISA 49:7">ಜನಾಂಗಕ್ಕೆ ಅಸಹ್ಯನೂ, ಅಧಿಕಾರಿಗಳ ಸೇವಕನಿಗೆ</para>
  <para style="q1" vid="ISA 49:7">ಇಸ್ರಾಯೇಲಿನ ವಿಮೋಚಕನೂ</para>
  <para style="q2" vid="ISA 49:7">ಮತ್ತು ಅವನ ಪರಿಶುದ್ಧನಾದ ಯೆಹೋವ ದೇವರು ಹೀಗೆ ಹೇಳುತ್ತಾರೆ:</para>
  <para style="q1" vid="ISA 49:7">“ಯೆಹೋವ ದೇವರ ನಂಬಿಗಸ್ತಿಕೆಯನ್ನೂ,</para>
  <para style="q2" vid="ISA 49:7">ನೀನು ಆಯ್ದುಕೊಂಡ ಇಸ್ರಾಯೇಲಿನ</para>
  <para style="q1" vid="ISA 49:7">ಪರಿಶುದ್ಧನನ್ನೂ ಕಂಡು ಅರಸರು ಎದ್ದು ನಿಲ್ಲುತ್ತಾರೆ,</para>
  <para style="q2" vid="ISA 49:7">ಅಧಿಪತಿಗಳು ಸಹ ಆರಾಧಿಸುವರು.”<verse eid="ISA 49:7"/></para>
  <para style="s1">ಇಸ್ರಾಯೇಲಿನ ಪುನಃಸ್ಥಾಪನೆ</para>
  <para style="p">
    <verse number="8" style="v" sid="ISA 49:8"/>ಯೆಹೋವ ದೇವರು ಹೇಳುವುದೇನೆಂದರೆ:</para>
  <para style="q1" vid="ISA 49:8">“ಪ್ರಸನ್ನತೆಯ ಕಾಲದಲ್ಲಿ ನಿನಗೆ ಸದುತ್ತರವನ್ನು ದಯಪಾಲಿಸಿದ್ದೇನೆ.</para>
  <para style="q2" vid="ISA 49:8">ರಕ್ಷಣೆಯ ದಿನದಲ್ಲಿ ನಾನು ನಿನಗೆ ಸಹಾಯ ಮಾಡಿದ್ದೇನೆ.</para>
  <para style="q1" vid="ISA 49:8">ನಾನು ನಿನ್ನನ್ನು ಕಾಪಾಡಿ, ಭೂಮಿಯನ್ನು ಸ್ಥಾಪಿಸುವುದಕ್ಕೂ,</para>
  <para style="q2" vid="ISA 49:8">ಹಾಳಾಗಿರುವ ಸ್ಥಳಗಳನ್ನು</para>
  <para style="q1" vid="ISA 49:8">ಸೊತ್ತಾಗಿ ಹೊಂದುವುದಕ್ಕೂ,</para>
  <para style="q2" vid="ISA 49:8">ಜನರ ಒಡಂಬಡಿಕೆಯನ್ನಾಗಿಯೂ ನೇಮಿಸಿದ್ದೇನೆ.<verse eid="ISA 49:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 49:9"/>ನೀನು ಬಂಧಿತರಿಗೆ, ‘ಹೊರಗೆ ಬನ್ನಿರಿ,’</para>
  <para style="q2" vid="ISA 49:9">ಕತ್ತಲೆಯಲ್ಲಿರುವವರಿಗೆ, ‘ಬೆಳಕಿಗೆ ಬನ್ನಿರಿ,’ ಎಂದು ಹೇಳಬಹುದು.</para>
  <para style="b" vid="ISA 49:9"/>
  <para style="q1" vid="ISA 49:9">“ಅವರು ದಾರಿಗಳಲ್ಲಿ ಮೇಯಿಸುವರು.</para>
  <para style="q2" vid="ISA 49:9">ಅವರ ಎಲ್ಲಾ ಎತ್ತರವಾದ ಪ್ರದೇಶಗಳೂ ಕೂಡ ಅವರಿಗೆ ಹುಲ್ಲುಗಾವಲಾಗಿರುವುವು.<verse eid="ISA 49:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 49:10"/>ಅವರಿಗೆ ಹಸಿವೆಯಾಗಲಿ, ಬಾಯಾರಿಕೆಯಾಗಲಿ ಇರದು.</para>
  <para style="q2" vid="ISA 49:10">ಝಳವೂ, ಬಿಸಿಲೂ ಬಡಿಯದು.</para>
  <para style="q1" vid="ISA 49:10">ಏಕೆಂದರೆ ಅವರನ್ನು ಕರುಣಿಸುವ ದೇವರು ಅವರನ್ನು ನಡೆಸುತ್ತಾ,</para>
  <para style="q2" vid="ISA 49:10">ನೀರುಕ್ಕುವ ಒರತೆಗಳ ಬಳಿಗೆ ತರುವರು.<verse eid="ISA 49:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 49:11"/>ನನ್ನ ಬೆಟ್ಟಗಳನ್ನೆಲ್ಲಾ ಸಮ ದಾರಿಯನ್ನಾಗಿ ಮಾಡಿ,</para>
  <para style="q2" vid="ISA 49:11">ನನ್ನ ರಾಜಮಾರ್ಗಗಳನ್ನು ಎತ್ತರಿಸುವೆನು.<verse eid="ISA 49:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 49:12"/>ಇವರು ದೂರದಿಂದ ಬರುತ್ತಾರೆ.</para>
  <para style="q2" vid="ISA 49:12">ಇವರು ಉತ್ತರದಿಂದ ಮತ್ತು ಪಶ್ಚಿಮದಿಂದ</para>
  <para style="q2" vid="ISA 49:12">ಇವರು ಸೀನಿಮ್ ದೇಶದಿಂದ ಬರುತ್ತಿದ್ದಾರೆ.”<verse eid="ISA 49:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="ISA 49:13"/>ಆಕಾಶವೇ, ಹರ್ಷಧ್ವನಿ ಮಾಡು;</para>
  <para style="q2" vid="ISA 49:13">ಭೂಮಿಯೇ, ಉಲ್ಲಾಸಪಡು!</para>
  <para style="q2" vid="ISA 49:13">ಪರ್ವತಗಳೇ, ಹರ್ಷಧ್ವನಿಗೈಯಿರಿ!</para>
  <para style="q1" vid="ISA 49:13">ಏಕೆಂದರೆ ಯೆಹೋವ ದೇವರು ತನ್ನ ಜನರನ್ನು ಆಧರಿಸಿ,</para>
  <para style="q2" vid="ISA 49:13">ಶ್ರಮೆಪಟ್ಟ ತನ್ನವರನ್ನು ಕರುಣಿಸುವನು.<verse eid="ISA 49:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="ISA 49:14"/>ಆದರೆ ಚೀಯೋನ್ ಎಂಬಾಕೆಯು, “ಯೆಹೋವ ದೇವರು ನನ್ನನ್ನು ತಳ್ಳಿಬಿಟ್ಟಿದ್ದಾನೆ.</para>
  <para style="q2" vid="ISA 49:14">ನನ್ನ ಯೆಹೋವ ದೇವರು ನನ್ನನ್ನು ಮರೆತುಬಿಟ್ಟಿದ್ದಾನಲ್ಲಾ!” ಎಂದುಕೊಂಡಳು.<verse eid="ISA 49:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="ISA 49:15"/>“ತನ್ನ ಗರ್ಭದ ಮಗನ ಮೇಲೆ ಕರುಣಿಸದೆ ಒಬ್ಬ ಸ್ತ್ರೀ</para>
  <para style="q2" vid="ISA 49:15">ತನ್ನ ಎದೆಹಾಲನ್ನು ಕುಡಿಯುವ ಕೂಸನ್ನು ಮರೆತಾಳೇ?</para>
  <para style="q1" vid="ISA 49:15">ಹೌದು, ಅವಳು ಮರೆಯಬಹುದು,</para>
  <para style="q2" vid="ISA 49:15">ಆದರೂ ನಾನು ನಿನ್ನನ್ನು ಮರೆಯುವುದಿಲ್ಲ.<verse eid="ISA 49:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="ISA 49:16"/>ಇಗೋ, ನಾನು ನನ್ನ ಅಂಗೈಗಳಲ್ಲಿ ನಿನ್ನನ್ನು ಚಿತ್ರಿಸಿಕೊಂಡಿದ್ದೇನೆ.</para>
  <para style="q2" vid="ISA 49:16">ನಿನ್ನ ಗೋಡೆಗಳು ಸದಾ ನನ್ನ ಕಣ್ಣೆದುರಿನಲ್ಲಿವೆ.<verse eid="ISA 49:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="ISA 49:17"/>ನಿನ್ನ ಮಕ್ಕಳು ತ್ವರೆಪಟ್ಟು ಬರುತ್ತಿದ್ದಾರೆ.</para>
  <para style="q2" vid="ISA 49:17">ನಿನ್ನನ್ನು ಕೆಡವಿ ಹಾಳುಮಾಡಿದವರು ನಿನ್ನೊಳಗಿಂದ ಹೊರಟು ಹೋಗುವರು.<verse eid="ISA 49:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="ISA 49:18"/>ನಿನ್ನ ಕಣ್ಣುಗಳನ್ನು ಎತ್ತಿ ಸುತ್ತಲೂ ನೋಡು.</para>
  <para style="q2" vid="ISA 49:18">ಇವರೆಲ್ಲರೂ ಕೂಡಿಕೊಂಡು ನಿನ್ನ ಬಳಿಗೆ ಬರುತ್ತಿದ್ದಾರೆ.</para>
  <para style="q1" vid="ISA 49:18">ಯೆಹೋವ ದೇವರು ಹೇಳುವುದೇನೆಂದರೆ,” ನನ್ನ ಜೀವದಾಣೆ,</para>
  <para style="q2" vid="ISA 49:18">ನಿಶ್ಚಯವಾಗಿ ನೀನು ಅವರನ್ನೆಲ್ಲಾ ಆಭರಣಗಳಂತೆ ಧರಿಸಿಕೊಳ್ಳುವೆ</para>
  <para style="q2" vid="ISA 49:18">ಮತ್ತು ನೀನು ಅವರನ್ನು ಮದಲಗಿತ್ತಿಯಂತೆ ಕಟ್ಟಿಕೊಳ್ಳುವೆ.<verse eid="ISA 49:18"/></para>
  <para style="b"/>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="ISA 49:19"/>“ಏಕೆಂದರೆ ನಿನ್ನ ಹಾಳಾದ ಸ್ಥಳಗಳೂ ನಿನ್ನ ಏಕಾಂತ ಸ್ಥಳಗಳೂ</para>
  <para style="q2" vid="ISA 49:19">ಕೆಡವಿಬಿದ್ದ ನಿನ್ನ ದೇಶವೂ</para>
  <para style="q1" vid="ISA 49:19">ಈಗ ನಿವಾಸಿಗಳಿಗೆ ಇಕ್ಕಟ್ಟಾಗುವುವು.</para>
  <para style="q2" vid="ISA 49:19">ನಿನ್ನನ್ನು ನುಂಗಿದವರು ದೂರವಾಗುವರು.<verse eid="ISA 49:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="ISA 49:20"/>ನಿಮ್ಮ ದುಃಖದ ಸಮಯದಲ್ಲಿ ಜನಿಸಿದ ಮಕ್ಕಳು</para>
  <para style="q2" vid="ISA 49:20">‘ಸ್ಥಳವು ನನಗೆ ಇಕ್ಕಟ್ಟಾಯಿತು.</para>
  <para style="q1" vid="ISA 49:20">ನಾನು ವಾಸಿಸುವುದಕ್ಕೆ ಸ್ಥಳಕೊಡು,’</para>
  <para style="q2" vid="ISA 49:20">ಎಂದು ಇನ್ನೂ ನಿಮ್ಮ ವಿಚಾರಣೆಯಲ್ಲಿ ಹೇಳುತ್ತಾರೆ.<verse eid="ISA 49:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="ISA 49:21"/>‘ನನಗೋಸ್ಕರ ಇವರನ್ನು</para>
  <para style="q2" vid="ISA 49:21">ಯಾರು ನನ್ನಲ್ಲಿ ಪಡೆದರು?</para>
  <para style="q1" vid="ISA 49:21">ನಾನು ದುಃಖಿತ ಮತ್ತು ಬಂಜೆಯಾಗಿದ್ದೆ;</para>
  <para style="q2" vid="ISA 49:21">ನನ್ನನ್ನು ಗಡಿಪಾರು ಮಾಡಿ ತಿರಸ್ಕರಿಸಲಾಯಿತು.</para>
  <para style="q2" vid="ISA 49:21">ಇವುಗಳನ್ನು ತಂದವರು ಯಾರು?</para>
  <para style="q1" vid="ISA 49:21">ನಾನು ಒಬ್ಬಂಟಿಯಾಗಿ ಉಳಿದಿದ್ದೇನೆ,</para>
  <para style="q2" vid="ISA 49:21">ಇವರನ್ನು ಸಾಕಿದವರು ಯಾರು? ಅವರೆಲ್ಲಿದ್ದರು?’ ”</para>
  <para style="q2" vid="ISA 49:21">ಎಂದುಕೊಳ್ಳುವೆ.<verse eid="ISA 49:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="ISA 49:22"/>ಸಾರ್ವಭೌಮ ಯೆಹೋವ ದೇವರು, ಇಂತೆನ್ನುತ್ತಾರೆ,</para>
  <para style="q1" vid="ISA 49:22">“ಇಗೋ, ನಾನು ರಾಷ್ಟ್ರಗಳ ಕಡೆಗೆ ಕೈಯೆತ್ತಿ</para>
  <para style="q2" vid="ISA 49:22">ಜನರಿಗೆ ನನ್ನ ಧ್ವಜವನ್ನು ಎತ್ತುವೆನು.</para>
  <para style="q1" vid="ISA 49:22">ಅವರು ನಿನ್ನ ಪುತ್ರರನ್ನು ಕೈಹಿಡಿದು ತರುವರು.</para>
  <para style="q2" vid="ISA 49:22">ನಿನ್ನ ಪುತ್ರಿಯರನ್ನು ಹೆಗಲ ಮೇಲೆ ತರುವರು.<verse eid="ISA 49:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="ISA 49:23"/>ಅರಸರು ನಿನಗೆ ಸಾಕು ತಂದೆಗಳು.</para>
  <para style="q2" vid="ISA 49:23">ಅವರ ರಾಣಿಯರು ನಿನಗೆ ದಾದಿಗಳಾಗುವರು.</para>
  <para style="q1" vid="ISA 49:23">ಅವರು ಭೂಮಿಯ ಕಡೆಗೆ ತಮ್ಮ ಮುಖವನ್ನು ಬಾಗಿಸಿ,</para>
  <para style="q2" vid="ISA 49:23">ಅಡ್ಡಬಿದ್ದು, ನಿನ್ನ ಪಾದದ ಧೂಳನ್ನು ನೆಕ್ಕುವರು.</para>
  <para style="q1" vid="ISA 49:23">ಆಗ ನಾನೇ ಯೆಹೋವ ಎಂದು ನೀನು ತಿಳಿದುಕೊಳ್ಳುವೆ.</para>
  <para style="q2" vid="ISA 49:23">ಏಕೆಂದರೆ ನನ್ನನ್ನು ನಿರೀಕ್ಷಿಸಿಕೊಂಡಿರುವವರು ನಾಚಿಕೆಗೆ ಈಡಾಗರು.”<verse eid="ISA 49:23"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="24" style="v" sid="ISA 49:24"/>ಶೂರನ ಕೈಯೊಳಗಿಂದ ಕೊಳ್ಳೆಯನ್ನು ತೆಗೆದುಕೊಳ್ಳಬಹುದೋ?</para>
  <para style="q2" vid="ISA 49:24">ಭಯಂಕರನಿಂದ ಸೆರೆಯವರನ್ನು ಬಿಡಿಸಬಹುದೋ?<verse eid="ISA 49:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="ISA 49:25"/>ಆದರೆ ಯೆಹೋವ ದೇವರು ಹೀಗೆನ್ನುತ್ತಾರೆ:</para>
  <para style="q1" vid="ISA 49:25">“ಶೂರನ ಸೆರೆಯವರು ಅಪಹರಿಸಲಾಗುವರು.</para>
  <para style="q2" vid="ISA 49:25">ಭೀಕರನ ಕೊಳ್ಳೆ ಕಸಿದುಕೊಳ್ಳಲಾಗುವುದು.</para>
  <para style="q1" vid="ISA 49:25">ಏಕೆಂದರೆ ನಿನ್ನೊಡನೆ ಹೋರಾಡುವವನ ಸಂಗಡ ನಾನೇ ಹೋರಾಡಿ,</para>
  <para style="q2" vid="ISA 49:25">ನಿನ್ನ ಮಕ್ಕಳನ್ನು ನಾನು ರಕ್ಷಿಸುವೆನು.<verse eid="ISA 49:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="ISA 49:26"/>ನಿನ್ನ ಹಿಂಸಕರು ಸ್ವಮಾಂಸವನ್ನೇ ಭುಜಿಸುವಂತೆ ಅನುಮತಿಸುವೆನು.</para>
  <para style="q2" vid="ISA 49:26">ದ್ರಾಕ್ಷಾರಸವನ್ನು ಕುಡಿಯುವಂತೆ ಅವರು ಸ್ವರಕ್ತವನ್ನೇ ಕುಡಿದು ಅಮಲೇರುವರು.</para>
  <para style="q1" vid="ISA 49:26">ಆಗ ಯೆಹೋವನಾದ ನಾನೇ ನಿನ್ನ ರಕ್ಷಕನೂ,</para>
  <para style="q2" vid="ISA 49:26">ನಿನ್ನ ವಿಮೋಚಕನೂ, ಯಾಕೋಬ್ಯರ ಶೂರನೂ ಎಂದು</para>
  <para style="q2" vid="ISA 49:26">ನರಮಾನವರೆಲ್ಲರಿಗೂ ಗೊತ್ತಾಗುವುದು.”<verse eid="ISA 49:26"/></para>
  <chapter eid="ISA 49"/>
  <chapter number="50" style="c" sid="ISA 50"/>
  <para style="s1">ಇಸ್ರಾಯೇಲಿನ ಪಾಪ ಮತ್ತು ಸೇವಕನ ವಿಧೇಯತೆ</para>
  <para style="p">
    <verse number="1" style="v" sid="ISA 50:1"/>ಯೆಹೋವ ದೇವರು ಹೇಳುವುದೇನೆಂದರೆ,</para>
  <para style="q1" vid="ISA 50:1">“ನಾನು ಬಿಟ್ಟುಬಿಟ್ಟದ್ದಕ್ಕೆ ನಿನ್ನ ತಾಯಿಯ ತ್ಯಾಗಪತ್ರವು ಎಲ್ಲಿ?</para>
  <para style="q2" vid="ISA 50:1">ನಾನು ನನ್ನ ಸಾಲಗಾರರಲ್ಲಿ ಯಾರಿಗೆ ನಿಮ್ಮನ್ನು ಮಾರಿಬಿಟ್ಟೆನು?</para>
  <para style="q1" vid="ISA 50:1">ನಿಮ್ಮ ಪಾಪಗಳ ನಿಮಿತ್ತ ನಿಮ್ಮನ್ನು ನೀವೇ ಮಾರಿಕೊಂಡಿದ್ದೀರಿ.</para>
  <para style="q2" vid="ISA 50:1">ನಿಮ್ಮ ದ್ರೋಹಗಳ ನಿಮಿತ್ತವೇ ನಿಮ್ಮ ತಾಯಿಯನ್ನು ಬಿಟ್ಟಿದ್ದೇನೆ.<verse eid="ISA 50:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 50:2"/>ನಾನು ಬಂದಾಗ ಏಕೆ ಅಲ್ಲಿ ಒಬ್ಬನೂ ಇರಲಿಲ್ಲ?</para>
  <para style="q2" vid="ISA 50:2">ನಾನು ಕರೆದಾಗ ಏಕೆ ಯಾರೂ ಉತ್ತರ ಕೊಡಲಿಲ್ಲ?</para>
  <para style="q1" vid="ISA 50:2">ನನ್ನ ಕೈ ವಿಮೋಚಿಸದಂಥಾ ಮೋಟುಗೈಯೋ?</para>
  <para style="q2" vid="ISA 50:2">ಇಲ್ಲವೆ ನನಗೆ ಬಿಡಿಸುವುದಕ್ಕೆ ಶಕ್ತಿಯಿಲ್ಲವೋ?</para>
  <para style="q1" vid="ISA 50:2">ಇಗೋ, ನನ್ನ ಗದರಿಕೆಯಿಂದ ನಾನು ಸಮುದ್ರವನ್ನು ಒಣಗಿಸುತ್ತೇನೆ.</para>
  <para style="q2" vid="ISA 50:2">ನಾನು ನದಿಗಳನ್ನು ಮರುಭೂಮಿಯನ್ನಾಗಿ ಮಾಡುತ್ತೇನೆ.</para>
  <para style="q1" vid="ISA 50:2">ನೀರಿಲ್ಲದ ಕಾರಣ ಅಲ್ಲಿಯ ಮೀನುಗಳು ಬಾಯಾರಿ,</para>
  <para style="q2" vid="ISA 50:2">ಸತ್ತು ನಾರುವುವು.<verse eid="ISA 50:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 50:3"/>ನಾನು ಆಕಾಶಗಳಿಗೆ ಅಂಧಕಾರವನ್ನು ಹೊದಿಸಿ,</para>
  <para style="q2" vid="ISA 50:3">ಗೋಣಿತಟ್ಟನ್ನು ಅದರ ಹೊದಿಕೆಯನ್ನಾಗಿ ಮಾಡುವೆನು.”<verse eid="ISA 50:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 50:4"/>ಬಳಲಿ ಹೋದವನನ್ನು ಹೇಗೆ ಮಾತಿನಿಂದ ಆದರಿಸುವೆ ಎಂಬುದನ್ನು</para>
  <para style="q2" vid="ISA 50:4">ನಾನು ತಿಳಿಯುವ ಹಾಗೆ ಸಾರ್ವಭೌಮ ಯೆಹೋವ ದೇವರು ಶಿಕ್ಷಿತರ ನಾಲಿಗೆಯನ್ನು ನನಗೆ ಕೊಟ್ಟಿದ್ದಾರೆ.</para>
  <para style="q1" vid="ISA 50:4">ಆತನು ಮುಂಜಾನೆಯಿಂದ ಮುಂಜಾನೆಗೆ ನನ್ನನ್ನು ಎಚ್ಚರಿಸಿ,</para>
  <para style="q2" vid="ISA 50:4">ಸುರಕ್ಷಿತರಂತೆ ನಾನು ಕೇಳುವ ಹಾಗೆ ನನ್ನ ಕಿವಿಯನ್ನು ಆತನು ಎಚ್ಚರಗೊಳಿಸುತ್ತಾರೆ.<verse eid="ISA 50:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 50:5"/>ಸಾರ್ವಭೌಮ ಯೆಹೋವ ದೇವರು ನನ್ನ ಕಿವಿಯನ್ನು ತೆರೆದಿದ್ದಾರೆ,</para>
  <para style="q2" vid="ISA 50:5">ನಾನು ಎದುರು ಬೀಳಲಿಲ್ಲ,</para>
  <para style="q2" vid="ISA 50:5">ವಿಮುಖನಾಗಲೂ ಇಲ್ಲ.<verse eid="ISA 50:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 50:6"/>ನಾನು ಹೊಡೆಯುವವರಿಗೆ ಬೆನ್ನನ್ನೂ,</para>
  <para style="q2" vid="ISA 50:6">ಕೂದಲು ಕೀಳುವವರಿಗೆ ನನ್ನ ಗಡ್ಡವನ್ನೂ ಒಡ್ಡಿದೆನು.</para>
  <para style="q1" vid="ISA 50:6">ನನ್ನ ಮುಖವನ್ನು ನಿಂದೆಗೂ,</para>
  <para style="q2" vid="ISA 50:6">ಉಗುಳುವಿಕೆಗೂ ಮರೆಮಾಡಲಿಲ್ಲ.<verse eid="ISA 50:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 50:7"/>ಸಾರ್ವಭೌಮ ಯೆಹೋವ ದೇವರು, ನನಗೆ ಸಹಾಯ ಮಾಡುವನು.</para>
  <para style="q2" vid="ISA 50:7">ಆದಕಾರಣ ನಾನು ಅವಮಾನ ಪಡುವುದಿಲ್ಲ.</para>
  <para style="q1" vid="ISA 50:7">ಆದ್ದರಿಂದ ನನ್ನ ಮುಖವನ್ನು ಕಗ್ಗಲ್ಲಿನಂತೆ ಮಾಡಿಕೊಂಡಿದ್ದೇನೆ.</para>
  <para style="q2" vid="ISA 50:7">ನಾನು ನಾಚಿಕೆಪಡಲಾರೆನೆಂದು ನನಗೆ ಗೊತ್ತು.<verse eid="ISA 50:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 50:8"/>ನನಗೆ ನೀತಿ ನಿರ್ಣಯಿಸುವಾತನು ಸಮೀಪದಲ್ಲಿಯೇ ಇದ್ದಾನೆ,</para>
  <para style="q2" vid="ISA 50:8">ನನ್ನೊಂದಿಗೆ ವ್ಯಾಜ್ಯವಾಡುವವರು ಯಾರು?</para>
  <para style="q2" vid="ISA 50:8">ನಾವು ಪರಸ್ಪರ ಎದುರಿಸೋಣ!</para>
  <para style="q1" vid="ISA 50:8">ನನ್ನ ಎದುರಾಳಿ ಯಾರು?</para>
  <para style="q2" vid="ISA 50:8">ಅವನು ನನ್ನ ಸಮೀಪಕ್ಕೆ ಬರಲಿ.<verse eid="ISA 50:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 50:9"/>ಇಗೋ, ಸಾರ್ವಭೌಮ ಯೆಹೋವ ದೇವರು ನನಗೆ ಸಹಾಯ ಮಾಡುವರು.</para>
  <para style="q2" vid="ISA 50:9">ನನ್ನನ್ನು ಅಪರಾಧಿ ಎಂದು ನಿರ್ಣಯಿಸುವವನು ಯಾರು?</para>
  <para style="q1" vid="ISA 50:9">ಇಗೋ, ಅವರೆಲ್ಲರೂ ಹಳೆಯ ಬಟ್ಟೆಯಂತಾಗುವರು.</para>
  <para style="q2" vid="ISA 50:9">ಬಟ್ಟೆ ತಿನ್ನುವ ನುಸಿಯು ಅವರನ್ನು ತಿಂದುಬಿಡುವುದು.<verse eid="ISA 50:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 50:10"/>ನಿಮ್ಮೊಳಗೆ ಯೆಹೋವ ದೇವರಿಗೆ ಭಯಪಟ್ಟು,</para>
  <para style="q2" vid="ISA 50:10">ಅವರ ಸೇವಕನ ಮಾತನ್ನು ಕೇಳಿ,</para>
  <para style="q1" vid="ISA 50:10">ಬೆಳಕಿಲ್ಲದೇ ಕತ್ತಲೆಯಲ್ಲಿ</para>
  <para style="q2" vid="ISA 50:10">ನಡೆಯುವವನು ಯಾರು?</para>
  <para style="q1" vid="ISA 50:10">ಅವನು ಯೆಹೋವ ದೇವರ ಹೆಸರಿನಲ್ಲಿ ನಂಬಿಕೆ ಇಟ್ಟು,</para>
  <para style="q2" vid="ISA 50:10">ತನ್ನ ದೇವರ ಮೇಲೆ ಆತುಕೊಳ್ಳಲಿ.<verse eid="ISA 50:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 50:11"/>ಕಿಡಿಗಳಿಂದ ಆವರಿಸಿಕೊಳ್ಳುವವರೇ,</para>
  <para style="q2" vid="ISA 50:11">ನಿಮ್ಮ ಬೆಂಕಿಯ ಬೆಳಕಿನಲ್ಲಿಯೂ,</para>
  <para style="q1" vid="ISA 50:11">ನೀವು ಹತ್ತಿಸಿದ ಕಿಡಿಗಳಲ್ಲಿಯೂ ನಡೆಯಿರಿ.</para>
  <para style="q2" vid="ISA 50:11">ನನ್ನ ಕೈಯಿಂದ ನಿಮಗಾಗುವುದು ಇದೇ.</para>
  <para style="q1" vid="ISA 50:11">ನೀವು ಯಾತನೆಯಲ್ಲಿ ಬಿದ್ದುಕೊಂಡಿರುವಿರಿ.<verse eid="ISA 50:11"/></para>
  <chapter eid="ISA 50"/>
  <chapter number="51" style="c" sid="ISA 51"/>
  <para style="s1">ಚೀಯೋನಿನ ಶಾಶ್ವತ ರಕ್ಷಣೆ</para>
  <para style="q1">
    <verse number="1" style="v" sid="ISA 51:1"/>ನೀತಿಯನ್ನು ಹಿಂಬಾಲಿಸುವವರೇ,</para>
  <para style="q2" vid="ISA 51:1">ಯೆಹೋವ ದೇವರನ್ನು ಹುಡುಕುವವರೇ, ನನ್ನ ಕಡೆಗೆ ಕಿವಿಗೊಡಿರಿ.</para>
  <para style="q1" vid="ISA 51:1">ನಿಮ್ಮನ್ನು ಯಾವ ಬಂಡೆಯೊಳಗಿಂದ ಒಡೆದು ಕಡಿದಿರುತ್ತಾರೋ</para>
  <para style="q2" vid="ISA 51:1">ಮತ್ತು ಯಾವ ಗುಂಡಿಯೊಳಗಿಂದ ಅಗೆದಿರುತ್ತಾರೋ ಆ ಬಂಡೆಯಾದಾತನನ್ನು ನೋಡಿರಿ.<verse eid="ISA 51:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 51:2"/>ನಿಮ್ಮ ತಂದೆಯಾದ ಅಬ್ರಹಾಮನನ್ನು</para>
  <para style="q2" vid="ISA 51:2">ಮತ್ತು ನಿಮ್ಮನ್ನು ಹೆತ್ತ ಸಾರಳನ್ನೂ ದೃಷ್ಟಿಸಿರಿ.</para>
  <para style="q1" vid="ISA 51:2">ನಾನು ಅವನನ್ನು ಕರೆದಾಗ ಅವನು ಒಬ್ಬನೇ ಮನುಷ್ಯ,</para>
  <para style="q2" vid="ISA 51:2">ನಾನು ಅವನನ್ನು ಆಶೀರ್ವದಿಸಿ, ವೃದ್ಧಿಗೊಳಿಸಿದೆನು.<verse eid="ISA 51:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 51:3"/>ಯೆಹೋವ ದೇವರು ಚೀಯೋನನ್ನು ಸಂತೈಸೇ ಸಂತೈಸುವರು.</para>
  <para style="q2" vid="ISA 51:3">ಅವರು ಅದರ ಹಾಳಾದ ಸ್ಥಳಗಳನ್ನು ಕರುಣೆಯಿಂದ ನೋಡುವರು.</para>
  <para style="q1" vid="ISA 51:3">ಅದರ ಮರುಭೂಮಿಯನ್ನು ಏದೆನ್ ಹಾಗೆಯೂ,</para>
  <para style="q2" vid="ISA 51:3">ಹಾಳು ಪ್ರದೇಶವನ್ನು ಯೆಹೋವ ದೇವರ ತೋಟದ ಹಾಗೆಯೂ ಮಾಡುವನು.</para>
  <para style="q1" vid="ISA 51:3">ಅಲ್ಲಿ ಆನಂದವೂ, ಉಲ್ಲಾಸವೂ, ಉಪಕಾರ ಸ್ತುತಿಯೂ,</para>
  <para style="q2" vid="ISA 51:3">ಇಂಪಾದ ಸ್ವರವೂ ಕಂಡು ಬರುವುವು.<verse eid="ISA 51:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 51:4"/>ನನ್ನ ಜನರೇ, ಕೇಳಿರಿ.</para>
  <para style="q2" vid="ISA 51:4">ನನ್ನ ಜನಾಂಗವೇ, ನನ್ನ ಕಡೆಗೆ ಕಿವಿಗೊಡಿರಿ.</para>
  <para style="q1" vid="ISA 51:4">ಏಕೆಂದರೆ ನಿಯಮವು ನನ್ನಿಂದ ಹೊರಡುವುದು</para>
  <para style="q2" vid="ISA 51:4">ಮತ್ತು ನನ್ನ ನ್ಯಾಯವನ್ನು ಜನಾಂಗಕ್ಕೆ ಬೆಳಕನ್ನಾಗಿ ಮಾಡುವೆನು.<verse eid="ISA 51:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 51:5"/>ನನ್ನ ನೀತಿಯು ತ್ವರೆಯಾಗಿ ಸಮೀಪಿಸಿತು.</para>
  <para style="q2" vid="ISA 51:5">ನನ್ನ ರಕ್ಷಣೆಯು ಹೊರಟಿತು</para>
  <para style="q2" vid="ISA 51:5">ಮತ್ತು ನನ್ನ ಕೈ ಜನಾಂಗಕ್ಕೆ ನ್ಯಾಯವನ್ನು ತೀರಿಸುವುದು.</para>
  <para style="q1" vid="ISA 51:5">ನನ್ನ ಭುಜದ ಮೇಲೆ ಭರವಸೆ ಇಟ್ಟು,</para>
  <para style="q2" vid="ISA 51:5">ದ್ವೀಪಗಳು ನನಗೋಸ್ಕರ ಕಾದುಕೊಂಡಿರುತ್ತವೆ.<verse eid="ISA 51:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 51:6"/>ಆಕಾಶಗಳ ಕಡೆಗೆ ನಿಮ್ಮ ಕಣ್ಣುಗಳನ್ನು ಎತ್ತಿರಿ</para>
  <para style="q2" vid="ISA 51:6">ಮತ್ತು ಕೆಳಗಿರುವ ಭೂಮಿಯನ್ನು ನೋಡಿರಿ.</para>
  <para style="q1" vid="ISA 51:6">ಏಕೆಂದರೆ ಆಕಾಶಗಳು ಹೊಗೆಯಂತೆ ಅಗೋಚರವಾಗುವುವು.</para>
  <para style="q2" vid="ISA 51:6">ಭೂಮಿಯು ಹಳೆಯ ಬಟ್ಟೆಯಂತಾಗುವುದು</para>
  <para style="q2" vid="ISA 51:6">ಮತ್ತು ಅದರಲ್ಲಿ ವಾಸಿಸುವವರು ಸೊಳ್ಳೆಗಳೋಪಾದಿಯಲ್ಲಿ ಸಾಯುವರು.</para>
  <para style="q1" vid="ISA 51:6">ಆದರೆ ನನ್ನ ರಕ್ಷಣೆಯು ಶಾಶ್ವತವಾಗಿರುವುದು,</para>
  <para style="q2" vid="ISA 51:6">ನನ್ನ ನೀತಿಯು ಎಂದಿಗೂ ರದ್ದಾಗದು.<verse eid="ISA 51:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 51:7"/>ನೀತಿಯನ್ನು ಅರಿತು, ನನ್ನ ನಿಯಮವನ್ನು</para>
  <para style="q2" vid="ISA 51:7">ಹೃದಯದಲ್ಲಿಟ್ಟುಕೊಂಡಿರುವ ಜನರೇ, ನನಗೆ ಕಿವಿಗೊಡಿರಿ.</para>
  <para style="q1" vid="ISA 51:7">ಮನುಷ್ಯರ ನಿಂದೆಗೆ ಭಯಪಡಬೇಡಿರಿ,</para>
  <para style="q2" vid="ISA 51:7">ಅವರ ದೂಷಣೆಗೆ ಹೆದರಬೇಡಿರಿ.<verse eid="ISA 51:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 51:8"/>ಏಕೆಂದರೆ ನುಸಿಯು ಬಟ್ಟೆಯನ್ನು ತಿನ್ನುವಂತೆ,</para>
  <para style="q2" vid="ISA 51:8">ಅವರನ್ನು ತಿಂದುಬಿಡುವುದು</para>
  <para style="q2" vid="ISA 51:8">ಮತ್ತು ಹುಳವು ಅವರನ್ನು ಉಣ್ಣೆಯಂತೆ ತಿನ್ನುವುದು.</para>
  <para style="q1" vid="ISA 51:8">ಆದರೆ ನನ್ನ ನೀತಿಯು ಶಾಶ್ವತವಾಗಿರುವುದು</para>
  <para style="q2" vid="ISA 51:8">ಮತ್ತು ನನ್ನ ರಕ್ಷಣೆಯು ತಲತಲಾಂತರಗಳಿಗೂ ಇರುವುದು.<verse eid="ISA 51:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 51:9"/>ಯೆಹೋವ ದೇವರ ಭುಜವೇ, ಎಚ್ಚರಗೊಳ್ಳು, ಎಚ್ಚರಗೊಳ್ಳು</para>
  <para style="q2" vid="ISA 51:9">ಬಲವನ್ನು ಧರಿಸಿಕೋ.</para>
  <para style="q1" vid="ISA 51:9">ಹಿಂದಿನ ಜನಾಂಗಗಳಲ್ಲಿ ಪೂರ್ವಕಾಲದ ದಿವಸಗಳಲ್ಲಿ</para>
  <para style="q2" vid="ISA 51:9">ಎಚ್ಚರವಿದ್ದಂತೆಯೇ ಎಚ್ಚರವಾಗು.</para>
  <para style="q1" vid="ISA 51:9">ರಹಬನ್ನು ಕಡಿದುಬಿಟ್ಟದ್ದೂ,</para>
  <para style="q2" vid="ISA 51:9">ಘಟಸರ್ಪವನ್ನು ಗಾಯಪಡಿಸಿದ್ದೂ ನೀನಲ್ಲವೋ?<verse eid="ISA 51:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 51:10"/>ಸಮುದ್ರವನ್ನೂ, ದೊಡ್ಡ ಅಗಾಧದ ನೀರನ್ನೂ ಬತ್ತಿಸಿ,</para>
  <para style="q2" vid="ISA 51:10">ವಿಮುಕ್ತರಾದವರು, ಹಾದು ಹೋಗುವುದಕ್ಕೆ</para>
  <para style="q1" vid="ISA 51:10">ಸಮುದ್ರದ ತಳವನ್ನು ಮಾರ್ಗವನ್ನಾಗಿ</para>
  <para style="q2" vid="ISA 51:10">ಮಾಡಿದಂಥವನು ನೀನಲ್ಲವೋ?<verse eid="ISA 51:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 51:11"/>ಆದಕಾರಣ ಯೆಹೋವ ದೇವರು ವಿಮೋಚಿಸಿದವರು,</para>
  <para style="q2" vid="ISA 51:11">ಹಿಂದಿರುಗಿಕೊಂಡು ಶಾಶ್ವತ ಸಂತೋಷವೆಂಬ ಕಿರೀಟವನ್ನು ಧರಿಸಿಕೊಂಡು,</para>
  <para style="q2" vid="ISA 51:11">ಉತ್ಸಾಹ ಧ್ವನಿಯೊಡನೆ ಚೀಯೋನಿಗೆ ಸೇರುವರು.</para>
  <para style="q1" vid="ISA 51:11">ಅವರು ಹರ್ಷಾನಂದಗಳನ್ನು ಅನುಭವಿಸುವರು.</para>
  <para style="q2" vid="ISA 51:11">ದುಃಖವೂ, ನಿಟ್ಟುಸಿರೂ ಓಡಿಹೋಗುವುವು.<verse eid="ISA 51:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 51:12"/>“ನಾನೇ, ನಾನೇ ನಿಮ್ಮನ್ನು ಸಂತೈಸುವವನಾಗಿದ್ದೇನೆ.</para>
  <para style="q2" vid="ISA 51:12">ಹಾಗಾದರೆ ಸಾಯುವ ಮನುಷ್ಯನಿಗೂ,</para>
  <para style="q2" vid="ISA 51:12">ಹುಲ್ಲಿನಂತ್ತಿರುವ ಮಾನವನಿಗೂ ಭಯಪಡುವ ನೀನು ಯಾರು?<verse eid="ISA 51:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="ISA 51:13"/>ಆಕಾಶವನ್ನು ಹಾಸಿ,</para>
  <para style="q2" vid="ISA 51:13">ಭೂಮಿಯ ಅಸ್ತಿವಾರವನ್ನು ಹಾಕಿ,</para>
  <para style="q2" vid="ISA 51:13">ನಿನ್ನನ್ನು ಉಂಟುಮಾಡಿದ ಯೆಹೋವ ದೇವರನ್ನು ನೀನು ಮರೆತುಬಿಟ್ಟು,</para>
  <para style="q1" vid="ISA 51:13">ಹಿಂಸಕನ ಉಗ್ರಕ್ಕೆ ಎಡೆಬಿಡದೆ</para>
  <para style="q2" vid="ISA 51:13">ಪ್ರತಿದಿನವೂ ಅವನು ನಾಶಪಡಿಸುವನೋ ಎಂಬಂತೆ ಅಂಜಿಕೊಂಡಿದ್ದೀಯಲ್ಲಾ,</para>
  <para style="q1" vid="ISA 51:13">ಆ ಹಿಂಸಕನ ಕೋಪವು ಎಲ್ಲಿ?<verse eid="ISA 51:13"/></para>
  <para style="q2">
    <verse number="14" style="v" sid="ISA 51:14"/>ಸೆರೆಯಲ್ಲಿ ಕುಗ್ಗಿರುವವನು ತಾನು ಸಾಯದಂತೆಯೂ,</para>
  <para style="q1" vid="ISA 51:14">ತನಗೆ ಆಹಾರದ ಕೊರತೆ ಇರದಂತೆಯೂ,</para>
  <para style="q2" vid="ISA 51:14">ತಾನು ಬಿಡುಗಡೆ ಹೊಂದುವಂತೆಯೂ ಆತುರಪಡುತ್ತಾನೆ.<verse eid="ISA 51:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="ISA 51:15"/>ಆದರೆ ತೆರೆಗಳು ಬೋರ್ಗರೆಯುವಾಗ,</para>
  <para style="q2" vid="ISA 51:15">ಸಮುದ್ರವನ್ನು ವಿಭಾಗಿಸಿದ ನಿನ್ನ ದೇವರಾಗಿರುವ ಯೆಹೋವ ದೇವರು ನಾನೇ,</para>
  <para style="q2" vid="ISA 51:15">ಸೇನಾಧೀಶ್ವರ ಯೆಹೋವ ದೇವರು ಎಂಬುದು ಆತನ ಹೆಸರು.<verse eid="ISA 51:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="ISA 51:16"/>ಆಕಾಶಗಳನ್ನು ನೆಡುವುದಕ್ಕೂ,</para>
  <para style="q2" vid="ISA 51:16">ಭೂಮಿಯ ಅಸ್ತಿವಾರವನ್ನು ಹಾಕುವುದಕ್ಕೂ,</para>
  <para style="q1" vid="ISA 51:16">ಚೀಯೋನಿಗೆ ನೀನು ನನ್ನ ಜನರೆಂದು ಹೇಳುವುದಕ್ಕೂ,</para>
  <para style="q2" vid="ISA 51:16">ನನ್ನ ವಾಕ್ಯಗಳನ್ನು ನಿನ್ನ ಬಾಯಲ್ಲಿಟ್ಟು,</para>
  <para style="q2" vid="ISA 51:16">ನನ್ನ ಕೈ ನೆರಳಿನಿಂದ ನಿನ್ನನ್ನು ಮುಚ್ಚಿದ್ದೇನೆ.”<verse eid="ISA 51:16"/></para>
  <para style="s1">ಯೆಹೋವ ದೇವರ ರೋಷದ ಪಾತ್ರೆ</para>
  <para style="q1">
    <verse number="17" style="v" sid="ISA 51:17"/>ಯೆಹೋವ ದೇವರ ಕೈಯಿಂದ ಆತನ</para>
  <para style="q2" vid="ISA 51:17">ಕೋಪದ ಪಾತ್ರೆಯನ್ನು ಕುಡಿದ</para>
  <para style="q1" vid="ISA 51:17">ಯೆರೂಸಲೇಮೇ, ಎಚ್ಚರಗೊಳ್ಳು,</para>
  <para style="q2" vid="ISA 51:17">ಎಚ್ಚರಗೊಳ್ಳು, ಎದ್ದೇಳು!</para>
  <para style="q1" vid="ISA 51:17">ನೀನು ತತ್ತರಗೊಳಿಸುವಂಥ ಪಾತ್ರೆಯಲ್ಲಿದ್ದ</para>
  <para style="q2" vid="ISA 51:17">ಮಡ್ಡಿಯನ್ನು ಕುಡಿದು ಹೀರಿಬಿಟ್ಟಿದ್ದೀ.<verse eid="ISA 51:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="ISA 51:18"/>ಅವಳು ಹೆತ್ತ ಎಲ್ಲಾ ಪುತ್ರರಲ್ಲಿ</para>
  <para style="q2" vid="ISA 51:18">ಅವಳನ್ನು ನಡೆಸುವುದಕ್ಕೆ ಒಬ್ಬನೂ ಇಲ್ಲ.</para>
  <para style="q1" vid="ISA 51:18">ಅವಳು ಬೆಳೆಯಿಸಿದ ಎಲ್ಲಾ ಪುತ್ರರಲ್ಲಿ,</para>
  <para style="q2" vid="ISA 51:18">ಅವಳ ಕೈಯನ್ನು ಹಿಡಿಯುವವನು ಒಬ್ಬನೂ ಇಲ್ಲ.<verse eid="ISA 51:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="ISA 51:19"/>ಈ ಎರಡು ಸಂಗತಿಗಳು ನಿನಗೆ ಸಂಭವಿಸಿವೆ,</para>
  <para style="q2" vid="ISA 51:19">ನಿನಗೋಸ್ಕರ ಚಿಂತಿಸುವವರು ಯಾರಿದ್ದಾರೆ?</para>
  <para style="q1" vid="ISA 51:19">ನಾಶನವೋ ಸಂಹಾರವೋ ಕ್ಷಾಮವೋ ಖಡ್ಗವೋ,</para>
  <para style="q2" vid="ISA 51:19">ಯಾರು ನಿನ್ನನ್ನು ಸಂತೈಸುವರು?<verse eid="ISA 51:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="ISA 51:20"/>ನಿನ್ನ ಪುತ್ರರು ಮೂರ್ಛೆ ಹೋಗಿ,</para>
  <para style="q2" vid="ISA 51:20">ಬಲೆಗೆ ಸಿಕ್ಕಿದ ಕಾಡು ಗೂಳಿಗಳಂತೆ,</para>
  <para style="q2" vid="ISA 51:20">ಎಲ್ಲಾ ಬೀದಿಗಳು ಕೂಡುವ ಚೌಕಗಳಲ್ಲಿ ಅವರು ಬಿದ್ದಿದ್ದಾರೆ.</para>
  <para style="q1" vid="ISA 51:20">ಅವರು ಯೆಹೋವ ದೇವರ ರೋಷದಿಂದಲೂ,</para>
  <para style="q2" vid="ISA 51:20">ನಿನ್ನ ದೇವರ ಗದರಿಕೆಯಿಂದಲೂ ತುಂಬಿದ್ದಾರೆ.<verse eid="ISA 51:20"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="21" style="v" sid="ISA 51:21"/>ನೀನು ಹಿಂಸೆಗೊಳಗಾಗಿದ್ದೀ. ಕುಡಿದು ಅಮಲೇರಿದ್ದೀ.</para>
  <para style="q2" vid="ISA 51:21">ಆದರೆ ದ್ರಾಕ್ಷಾರಸದಿಂದಲ್ಲ. ಆದ್ದರಿಂದ ಈಗ ಇದನ್ನು ಕೇಳು.<verse eid="ISA 51:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="ISA 51:22"/>ತನ್ನ ಜನರಿಗೋಸ್ಕರ ವಾದಿಸುವ ನಿನ್ನ ದೇವರೂ,</para>
  <para style="q2" vid="ISA 51:22">ನಿನ್ನ ಸಾರ್ವಭೌಮ ಯೆಹೋವ ದೇವರು ಹೇಳುವುದೇನೆಂದರೆ,</para>
  <para style="q1" vid="ISA 51:22">“ನಾನು ನಿನ್ನ ಕೈಯೊಳಗಿಂದ</para>
  <para style="q2" vid="ISA 51:22">ತತ್ತರಿಸುವಂಥ ಪಾತ್ರೆಯನ್ನೂ,</para>
  <para style="q1" vid="ISA 51:22">ನನ್ನ ಉಗ್ರವಾದ ಪಾತ್ರೆಯ ಮಡ್ಡಿಯನ್ನೂ ತೆಗೆದುಹಾಕಿದ್ದೇನೆ.</para>
  <para style="q2" vid="ISA 51:22">ಇನ್ನು ಮೇಲೆ ನೀನು ಅದನ್ನು ತಿರುಗಿ ಕುಡಿಯುವುದೇ ಇಲ್ಲ.<verse eid="ISA 51:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="ISA 51:23"/>ಆದರೆ ನಾವು ಹಾದುಹೋಗುವಂತೆ, ನೀನು ನೆಲಕ್ಕೆ ಬೀಳು</para>
  <para style="q2" vid="ISA 51:23">ಎಂದು ನಿನ್ನ ಪ್ರಾಣಕ್ಕೆ ಹೇಳಿ,</para>
  <para style="q2" vid="ISA 51:23">ನಿನ್ನನ್ನು ಹಿಂಸಿಸಿದವನ ಕೈಯಲ್ಲಿ ಅದನ್ನು ನಾನು ಇಡುತ್ತೇನೆ</para>
  <para style="q1" vid="ISA 51:23">ಮತ್ತು ನೀನು ಹಾದುಹೋದವರಿಗೆ ನಿನ್ನ ಶರೀರವನ್ನು ನೆಲದಂತೆಯೂ,</para>
  <para style="q2" vid="ISA 51:23">ಬೀದಿಯಂತೆಯೂ ಮಾಡಿಕೊಂಡಿಯಲ್ಲಾ.”<verse eid="ISA 51:23"/></para>
  <para style="b"/>
  <para style="b"/>
  <chapter eid="ISA 51"/>
  <chapter number="52" style="c" sid="ISA 52"/>
  <para style="q1">
    <verse number="1" style="v" sid="ISA 52:1"/>ಚೀಯೋನೇ, ಎಚ್ಚರವಾಗು, ಎಚ್ಚರವಾಗು,</para>
  <para style="q2" vid="ISA 52:1">ನಿನ್ನ ಬಲವನ್ನು ಧರಿಸಿಕೋ!</para>
  <para style="q1" vid="ISA 52:1">ಯೆರೂಸಲೇಮೇ, ಪರಿಶುದ್ಧ ಪಟ್ಟಣವೇ,</para>
  <para style="q2" vid="ISA 52:1">ನಿನ್ನ ವೈಭವದ ಉಡುಪುಗಳನ್ನು ಹಾಕಿಕೋ</para>
  <para style="q1" vid="ISA 52:1">ಏಕೆಂದರೆ ಇಂದಿನಿಂದ ಸುನ್ನತಿ ಇಲ್ಲದವರೂ,</para>
  <para style="q2" vid="ISA 52:1">ಅಶುದ್ಧರೂ ನಿನ್ನೊಳಗೆ ಬರುವುದಿಲ್ಲ.<verse eid="ISA 52:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 52:2"/>ಯೆರೂಸಲೇಮೇ ಧೂಳನ್ನು ಝಾಡಿಸಿಕೋ,</para>
  <para style="q2" vid="ISA 52:2">ಎದ್ದು ಆಸನದ ಮೇಲೆ ಕುಳಿತುಕೋ.</para>
  <para style="q1" vid="ISA 52:2">ಸೆರೆಯಾದ ಚೀಯೋನ್ ಪುತ್ರಿಯೇ,</para>
  <para style="q2" vid="ISA 52:2">ನಿನ್ನ ಕುತ್ತಿಗೆಯ ಬಂಧನಗಳನ್ನು ಬಿಚ್ಚಿಕೋ.<verse eid="ISA 52:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="ISA 52:3"/>ಏಕೆಂದರೆ ಯೆಹೋವ ದೇವರು ಹೇಳುವುದೇನೆಂದರೆ:</para>
  <para style="q1" vid="ISA 52:3">“ನಿಮ್ಮನ್ನು ನೀವೇ ನಿಷ್ಪಲವಾಗಿ ಮಾಡಿಕೊಂಡಿರಿ.</para>
  <para style="q2" vid="ISA 52:3">ಹಣವಿಲ್ಲದೆ ನೀವು ವಿಮೋಚನೆ ಹೊಂದುವಿರಿ.”<verse eid="ISA 52:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="ISA 52:4"/>ಏಕೆಂದರೆ ಸಾರ್ವಭೌಮ ಯೆಹೋವ ದೇವರು ಹೇಳುವುದೇನೆಂದರೆ:</para>
  <para style="q1" vid="ISA 52:4">“ನನ್ನ ಜನರು ಪೂರ್ವದಲ್ಲಿ ಇಳುಕೊಳ್ಳುವುದಕ್ಕೆ ಈಜಿಪ್ಟಿಗೆ ಹೋದರು.</para>
  <para style="q2" vid="ISA 52:4">ಅಸ್ಸೀರಿಯದವರು ಕಾರಣವಿಲ್ಲದೆ ಅವರಿಗೆ ಬಾಧೆಪಡಿಸಿದರು.<verse eid="ISA 52:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="ISA 52:5"/>“ಈಗ ನನಗೆ ಇಲ್ಲಿ ಏನಿದೆ?” ಎಂದು ಯೆಹೋವ ದೇವರು ಹೇಳುತ್ತಾರೆ.</para>
  <para style="q1" vid="ISA 52:5">“ನನ್ನ ಜನರನ್ನು ವ್ಯರ್ಥವಾಗಿ ಒಯ್ದಿದ್ದಾರೆ.</para>
  <para style="q2" vid="ISA 52:5">ಆಳುವವರು ಅವರನ್ನು ಗೋಳಾಡಿಸುತ್ತಿದ್ದಾರೆ.</para>
  <para style="q2" vid="ISA 52:5">ನನ್ನ ನಾಮವು ಪ್ರತಿದಿನವೂ ಎಡೆಬಿಡದೆ</para>
  <para style="q1" vid="ISA 52:5">ದೂಷಣೆಗೆ ಗುರಿಯಾಗಿದೆ!</para>
  <para style="q2" vid="ISA 52:5">ಎಂದು ಯೆಹೋವ ದೇವರು ಹೇಳುತ್ತಾರೆ.<verse eid="ISA 52:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 52:6"/>ಆದ್ದರಿಂದ ನನ್ನ ಜನರು ನನ್ನ ಹೆಸರನ್ನು ತಿಳಿದುಕೊಳ್ಳುವರು.</para>
  <para style="q2" vid="ISA 52:6">ಹೀಗೆ ಆ ದಿನದಲ್ಲಿ ಮಾತನಾಡಿದಾತನು ನಾನೇ,</para>
  <para style="q1" vid="ISA 52:6">ಅದು ನಾನೇ ಎಂದು</para>
  <para style="q2" vid="ISA 52:6">ಅವರು ಗ್ರಹಿಸುವರು.”<verse eid="ISA 52:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 52:7"/>ಒಳ್ಳೆಯ ಶುಭಸಮಾಚಾರವನ್ನು ತರುವವನ,</para>
  <para style="q2" vid="ISA 52:7">ರಕ್ಷಣೆಯನ್ನು ಪ್ರಕಟಿಸುವವನ</para>
  <para style="q1" vid="ISA 52:7">ಚೀಯೋನಿಗೆ ನಿನ್ನ ದೇವರು</para>
  <para style="q2" vid="ISA 52:7">ದೊರೆತನ ಮಾಡುತ್ತಾನೆ ಎಂದು ಹೇಳಿ,</para>
  <para style="q2" vid="ISA 52:7">ಒಳ್ಳೆಯ ಶುಭಸಮಾಚಾರವನ್ನು ತಂದು,</para>
  <para style="q1" vid="ISA 52:7">ಸಮಾಧಾನವನ್ನು ಪ್ರಕಟಿಸಿ ಹೇಳುವವನ ಪಾದಗಳು</para>
  <para style="q2" vid="ISA 52:7">ಪರ್ವತಗಳ ಮೇಲೆ ಎಷ್ಟೊಂದು ಅಂದವಾಗಿವೆ!<verse eid="ISA 52:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 52:8"/>ನಿನ್ನ ಕಾವಲುಗಾರರು ಧ್ವನಿಯನ್ನೆತ್ತುವರು.</para>
  <para style="q2" vid="ISA 52:8">ಆ ಸ್ವರದೊಂದಿಗೆ ಒಟ್ಟಾಗಿ ಅವರು ಹಾಡುವರು.</para>
  <para style="q1" vid="ISA 52:8">ಏಕೆಂದರೆ ಯೆಹೋವ ದೇವರು ಚೀಯೋನನ್ನು ತಿರುಗಿ ತರುವಾಗ,</para>
  <para style="q2" vid="ISA 52:8">ಅವರು ಅದನ್ನು ತಮ್ಮ ಕಣ್ಣಿನಿಂದಲೇ ಕಾಣುವರು.<verse eid="ISA 52:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 52:9"/>ಯೆರೂಸಲೇಮಿನ ಹಾಳಾದ ಸ್ಥಳಗಳೇ,</para>
  <para style="q2" vid="ISA 52:9">ಆನಂದ ಧ್ವನಿಗೈಯಿರಿ, ಒಟ್ಟಾಗಿ ಹಾಡಿರಿ.</para>
  <para style="q1" vid="ISA 52:9">ಏಕೆಂದರೆ ಯೆಹೋವ ದೇವರು ತನ್ನ ಪ್ರಜೆಗಳನ್ನು ಸಂತೈಸಿದ್ದಾರೆ.</para>
  <para style="q2" vid="ISA 52:9">ಆತನು ಯೆರೂಸಲೇಮನ್ನು ವಿಮೋಚಿಸಿದ್ದಾರೆ.<verse eid="ISA 52:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 52:10"/>ಯೆಹೋವ ದೇವರು ತಮ್ಮ ಪವಿತ್ರ ಬಾಹುವನ್ನು</para>
  <para style="q2" vid="ISA 52:10">ಸಕಲ ಜನಾಂಗಗಳ ಕಣ್ಣೆದುರಿನಲ್ಲಿ ತೋರಿಸಿಕೊಂಡಿದ್ದಾನೆ</para>
  <para style="q1" vid="ISA 52:10">ಮತ್ತು ಭೂಮಿಯ ಅಂತ್ಯದವರೆಗೂ</para>
  <para style="q2" vid="ISA 52:10">ನಮ್ಮ ದೇವರ ರಕ್ಷಣೆಯನ್ನು ಕಾಣುವರು.<verse eid="ISA 52:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 52:11"/>ಹೊರಡಿರಿ, ಹೊರಡಿರಿ, ಅಲ್ಲಿಂದ ಹೊರಗೆ ಹೋಗಿರಿ,</para>
  <para style="q2" vid="ISA 52:11">ಅಶುದ್ಧವಾದ ಯಾವುದನ್ನೂ ಮುಟ್ಟದಿರಿ.</para>
  <para style="q1" vid="ISA 52:11">ಅವಳ ಮಧ್ಯದಿಂದ ಹೊರಗೆ ಹೋಗಿರಿ.</para>
  <para style="q2" vid="ISA 52:11">ಯೆಹೋವ ದೇವರ ದೇವಾಲಯದ ಪಾತ್ರೆಗಳನ್ನು ಹೊರುವವರೇ, ನೀವು ಶುದ್ಧರಾಗಿರಿ.<verse eid="ISA 52:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 52:12"/>ನೀವು ತ್ವರೆಯಾಗಿ ಹೋಗುವುದಿಲ್ಲ,</para>
  <para style="q2" vid="ISA 52:12">ಓಡಿ ಹೋಗುವುದಿಲ್ಲ.</para>
  <para style="q1" vid="ISA 52:12">ಏಕೆಂದರೆ ಯೆಹೋವ ದೇವರೇ ನಿಮ್ಮ ಮುಂದೆ ಹೋಗುವರು,</para>
  <para style="q2" vid="ISA 52:12">ಇಸ್ರಾಯೇಲಿನ ದೇವರು ನಿಮ್ಮ ಹಿಂದೆ ಕಾವಲು ಕಾಯುವರು.<verse eid="ISA 52:12"/></para>
  <para style="s1">ಯೆಹೋವ ದೇವರ ಸೇವಕನ ಶ್ರಮೆ ಮತ್ತು ಮಹಿಮೆ</para>
  <para style="q1">
    <verse number="13" style="v" sid="ISA 52:13"/>ನನ್ನ ಸೇವಕನು ವಿವೇಕಿಯಾಗಿ ಕಾರ್ಯವನ್ನು ಸಾಧಿಸಿ,</para>
  <para style="q2" vid="ISA 52:13">ಅವನು ಉನ್ನತನಾಗಿ ಮೇಲೆಕ್ಕೇರಿ ಮಹೋನ್ನತನಾಗಿರುವನು.<verse eid="ISA 52:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="ISA 52:14"/>ಅವನ ಮುಖವು ಮನುಷ್ಯರಿಗಿಂತಲೂ,</para>
  <para style="q2" vid="ISA 52:14">ಅವನ ಆಕಾರವು ನರಪುತ್ರರಿಗಿಂತಲೂ</para>
  <para style="q2" vid="ISA 52:14">ಕುರೂಪವಾಗಿರುವುದನ್ನು ನೋಡಿ ಹೇಗೆ ಆಶ್ಚರ್ಯಪಟ್ಟರೋ,<verse eid="ISA 52:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="ISA 52:15"/>ಹಾಗೆಯೇ ಅನೇಕ ಜನಾಂಗಗಳನ್ನು ಆತನು ವಿಸ್ಮಯಗೊಳಿಸುವನು.</para>
  <para style="q2" vid="ISA 52:15">ಅರಸರು ಆತನ ನಿಮಿತ್ತ ತಮ್ಮ ಬಾಯಿಗಳನ್ನು ಮುಚ್ಚಿಕೊಳ್ಳುವರು.</para>
  <para style="q1" vid="ISA 52:15">ಏಕೆಂದರೆ ಅವರಿಗೆ ತಿಳಿಸದಿರುವ ಸಂಗತಿಯನ್ನು ಅವರು ನೋಡುವರು,</para>
  <para style="q2" vid="ISA 52:15">ಕೇಳದೇ ಇರುವುದನ್ನು ಗ್ರಹಿಸಿಕೊಳ್ಳುವರು.<verse eid="ISA 52:15"/></para>
  <para style="b"/>
  <chapter eid="ISA 52"/>
  <chapter number="53" style="c" sid="ISA 53"/>
  <para style="q1">
    <verse number="1" style="v" sid="ISA 53:1"/>ನಮ್ಮ ಸುದ್ದಿಯನ್ನು ಯಾರು ನಂಬಿದ್ದಾರೆ?</para>
  <para style="q2" vid="ISA 53:1">ಯೆಹೋವ ದೇವರ ಬಾಹುವು ಯಾರಿಗೆ ಪ್ರಕಟವಾಯಿತು?<verse eid="ISA 53:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 53:2"/>ಅವನು ಚಿಗುರಿನಂತೆಯೂ, ಒಣ ನೆಲದಿಂದ ಹುಟ್ಟಿಬರುವ</para>
  <para style="q2" vid="ISA 53:2">ಬೇರಿನಂತೆಯೂ ಯೆಹೋವ ದೇವರ ಮುಂದೆ ಬೆಳೆಯುವನು.</para>
  <para style="q1" vid="ISA 53:2">ಅವನಿಗೆ ಯಾವ ಸೌಂದರ್ಯವಾಗಲಿ ಇಲ್ಲವೆ ಘನತೆಯಾಗಲಿ ಇರಲಿಲ್ಲ.</para>
  <para style="q2" vid="ISA 53:2">ನಾವು ಅವನನ್ನು ನೋಡಿದಾಗ, ಅವನಲ್ಲಿ ಆಕರ್ಷಿಸತಕ್ಕ ಯಾವ ಚಂದವು ಇರಲಿಲ್ಲ.<verse eid="ISA 53:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 53:3"/>ಆತನು ತಿರಸ್ಕೃತನೂ ಮಾನವಕುಲದಿಂದ ನಿರಾಕರಿಸಲಾದವನೂ,</para>
  <para style="q2" vid="ISA 53:3">ದುಃಖಿತ ಮನುಷ್ಯನೂ, ನೋವನ್ನು ಅನುಭವಿಸಿದವನೂ ಆಗಿದ್ದನು.</para>
  <para style="q1" vid="ISA 53:3">ನಾವು ನಮ್ಮ ಮುಖಗಳನ್ನು ಆತನಿಂದ ಮರೆಮಾಡಿಕೊಂಡೆವು.</para>
  <para style="q2" vid="ISA 53:3">ಆತನು ಧಿಕ್ಕಾರಕ್ಕೆ ಒಳಗಾದವನೂ ಆಗಿದ್ದನು. ನಾವು ಆತನನ್ನು ಅತ್ಯಲ್ಪವಾಗಿ ಎಣಿಸಿದೆವು.<verse eid="ISA 53:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 53:4"/>ನಿಶ್ಚಯವಾಗಿಯೂ ಆತನು ನಮ್ಮ ನೋವನ್ನು ತೆಗೆದುಕೊಂಡನು;</para>
  <para style="q2" vid="ISA 53:4">ಹೌದು, ನಮ್ಮ ದುಃಖಗಳನ್ನು ಸಹ ಹೊತ್ತುಕೊಂಡನು.</para>
  <para style="q1" vid="ISA 53:4">ಆದರೂ ನಾವು ಆತನನ್ನು ಪೆಟ್ಟು ತಿಂದವನು,</para>
  <para style="q2" vid="ISA 53:4">ದೇವರಿಂದ ಶಿಕ್ಷೆಹೊಂದಿದವನು, ಬಾಧೆಪಟ್ಟವನು ಎಂದು ಭಾವಿಸಿಕೊಂಡೆವು.<verse eid="ISA 53:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 53:5"/>ನಮ್ಮ ಉಲ್ಲಂಘನೆಗಳಿಗಾಗಿ ಆತನು ತಿವಿತಕ್ಕೆ ಒಳಗಾದನು.</para>
  <para style="q2" vid="ISA 53:5">ನಮ್ಮ ದುಷ್ಕೃತ್ಯಗಳ ನಿಮಿತ್ತ ಆತನು ಜಜ್ಜಿಹೋದನು.</para>
  <para style="q1" vid="ISA 53:5">ನಮಗೆ ಸಮಾಧಾನವನ್ನು ತಂದ ದಂಡನೆಯು ಆತನ ಮೇಲಿತ್ತು.</para>
  <para style="q2" vid="ISA 53:5">ಆತನ ಗಾಯಗಳಿಂದ ನಮಗೆ ಗುಣವಾಯಿತು.<verse eid="ISA 53:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 53:6"/>ನಾವೆಲ್ಲರೂ ದಾರಿತಪ್ಪಿದ ಕುರಿಗಳಂತೆ ಇದ್ದೆವು.</para>
  <para style="q2" vid="ISA 53:6">ನಮ್ಮಲ್ಲಿ ಪ್ರತಿಯೊಬ್ಬನು ತನ್ನ ತನ್ನ ಸ್ವಂತ ಮಾರ್ಗಕ್ಕೆ ತಿರುಗಿಕೊಂಡಿದ್ದನು.</para>
  <para style="q1" vid="ISA 53:6">ಯೆಹೋವ ದೇವರು ನಮ್ಮ ಎಲ್ಲಾ ದುಷ್ಕೃತ್ಯಗಳನ್ನು</para>
  <para style="q2" vid="ISA 53:6">ಆತನ ಮೇಲೆ ಹಾಕಿದರು.<verse eid="ISA 53:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 53:7"/>ಆತನು ದಬ್ಬಾಳಿಕೆಗೆ ಗುರಿಯಾಗಿ ಬಾಧೆಪಟ್ಟನು.</para>
  <para style="q2" vid="ISA 53:7">ಆದರೂ ಆತನು ತನ್ನ ಬಾಯನ್ನು ತೆರೆಯಲೇ ಇಲ್ಲ.</para>
  <para style="q1" vid="ISA 53:7">ಬಲಿಗೆ ಎಳೆದುಕೊಂಡು ಹೋಗುವ ಕುರಿಯಂತೆಯೂ,</para>
  <para style="q2" vid="ISA 53:7">ಉಣ್ಣೆ ಕತ್ತರಿಸುವವರ ಮುಂದೆ ಇದ್ದ ಕುರಿಯ ಹಾಗೆಯೂ</para>
  <para style="q2" vid="ISA 53:7">ಆತನು ಮೌನವಾಗಿದ್ದನು. ಹೀಗೆ ಆತನು ತನ್ನ ಬಾಯನ್ನು ತೆರೆಯಲೇ ಇಲ್ಲ.<verse eid="ISA 53:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 53:8"/>ಆತನನ್ನು ದಬ್ಬಾಳಿಕೆಯಿಂದಲೂ, ನ್ಯಾಯತೀರ್ಪಿನಿಂದಲೂ ಎಳೆದುಕೊಂಡು ಹೋದರು.</para>
  <para style="q2" vid="ISA 53:8">ಆತನ ಕಾಲದವರಲ್ಲಿ ಯಾರು ಮರುಗಿದರು?</para>
  <para style="q1" vid="ISA 53:8">ಏಕೆಂದರೆ ಆತನನ್ನು ಜೀವಿತರ ಲೋಕದಿಂದ ತೆಗೆದುಹಾಕಿದರು.</para>
  <para style="q2" vid="ISA 53:8">ನನ್ನ ಪ್ರಜೆಯ ದ್ರೋಹಕ್ಕಾಗಿ ಆತನು ಶಿಕ್ಷೆಯನ್ನು ಹೊಂದಿದನು.<verse eid="ISA 53:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 53:9"/>ಅವನು ಯಾವ ಅನ್ಯಾಯವನ್ನು ಮಾಡದಿದ್ದರೂ,</para>
  <para style="q2" vid="ISA 53:9">ಅವನ ಬಾಯಲ್ಲಿ ಯಾವ ವಂಚನೆಯು ಇಲ್ಲದಿದ್ದರೂ,</para>
  <para style="q1" vid="ISA 53:9">ಅವನು ಸತ್ತಾಗ ದುಷ್ಟರ ಮಧ್ಯೆ</para>
  <para style="q2" vid="ISA 53:9">ಪುಷ್ಟರ ನಡುವೆ ಅವನನ್ನು ಹೂಣಿಟ್ಟರು.<verse eid="ISA 53:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 53:10"/>ಆದರೂ ಆತನನ್ನು ಜಜ್ಜುವುದು ಯೆಹೋವ ದೇವರ ಚಿತ್ತವಾಗಿತ್ತು.</para>
  <para style="q2" vid="ISA 53:10">ಯೆಹೋವ ದೇವರು ಆತನನ್ನು ಸಂಕಟಕ್ಕೆ ಒಳಪಡಿಸಿದನು.</para>
  <para style="q2" vid="ISA 53:10">ಯೆಹೋವ ದೇವರು ಆತನ ಪ್ರಾಣವನ್ನು ದೋಷಪರಿಹಾರದ ಬಲಿಯನ್ನಾಗಿ ಮಾಡುವಾಗ,</para>
  <para style="q1" vid="ISA 53:10">ಆತನು ತನ್ನ ಸಂತಾನವನ್ನು ಕಾಣುವನು.</para>
  <para style="q2" vid="ISA 53:10">ಆತನು ತನ್ನ ದಿವಸಗಳನ್ನು ಉದ್ದ ಮಾಡಿದ ಮೇಲೆ</para>
  <para style="q2" vid="ISA 53:10">ಮತ್ತು ಯೆಹೋವ ದೇವರ ಚಿತ್ತವು ಆತನ ಕೈಯಲ್ಲಿ ಸಫಲವಾಗುವುದು.<verse eid="ISA 53:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 53:11"/>ಆತನು ತನ್ನ ಪ್ರಾಣದ ವೇದನೆಯನ್ನು ಸಹಿಸಿದ ತರುವಾಯ,</para>
  <para style="q2" vid="ISA 53:11">ಜೀವದ ಬೆಳಕನ್ನು ಕಂಡು ತೃಪ್ತನಾಗುವನು.</para>
  <para style="q1" vid="ISA 53:11">ತನ್ನ ತಿಳುವಳಿಕೆಯಿಂದ ನೀತಿವಂತನಾದ ನನ್ನ ಸೇವಕನು ಅನೇಕರಿಗೆ ನೀತಿವಂತನಾಗಿ ನಿರ್ಣಯಿಸುವನು.</para>
  <para style="q2" vid="ISA 53:11">ಏಕೆಂದರೆ ಆತನೇ ಅವರ ಅಪರಾಧಗಳನ್ನು ಹೊತ್ತುಕೊಳ್ಳುವನು.<verse eid="ISA 53:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 53:12"/>ಆದ್ದರಿಂದ ನಾನು ಆತನಿಗೋಸ್ಕರ ದೊಡ್ಡವರೊಂದಿಗೆ ಪಾಲನ್ನು ಕೊಡುವೆನು</para>
  <para style="q2" vid="ISA 53:12">ಮತ್ತು ಆತನು ಬಲಿಷ್ಠರ ಸಂಗಡ ಕೊಳ್ಳೆಯಲ್ಲಿ ಪಾಲು ಹಂಚಿಕೊಳ್ಳುವನು.</para>
  <para style="q1" vid="ISA 53:12">ಏಕೆಂದರೆ ಆತನು ತನ್ನ ಪ್ರಾಣವನ್ನು ಮರಣದವರೆಗೂ ಹೊಯ್ದುಬಿಟ್ಟು,</para>
  <para style="q2" vid="ISA 53:12">ದ್ರೋಹಿಗಳೊಂದಿಗೆ ತನ್ನನ್ನೂ ಎಣಿಸಿಕೊಂಡನು.</para>
  <para style="q1" vid="ISA 53:12">ಅನೇಕರ ಪಾಪವನ್ನು ಹೊತ್ತುಕೊಂಡು</para>
  <para style="q2" vid="ISA 53:12">ದ್ರೋಹಿಗಳಿಗೋಸ್ಕರ ವಿಜ್ಞಾಪನೆ ಮಾಡಿದನು.<verse eid="ISA 53:12"/></para>
  <chapter eid="ISA 53"/>
  <chapter number="54" style="c" sid="ISA 54"/>
  <para style="s1">ಚೀಯೋನಿನ ಮುಂದಿನ ವೈಭವ</para>
  <para style="q1">
    <verse number="1" style="v" sid="ISA 54:1"/>“ಬಂಜೆಯೇ ಹೆರದವಳೇ, ನೀನು ಹರ್ಷಧ್ವನಿಗೈ!</para>
  <para style="q2" vid="ISA 54:1">ಪ್ರಸವವೇದನೆ ಪಡದವಳೇ,</para>
  <para style="q1" vid="ISA 54:1">ಸ್ವರವೆತ್ತಿ ಹರ್ಷದಿಂದ ಕೂಗು!</para>
  <para style="q2" vid="ISA 54:1">ಏಕೆಂದರೆ ಗಂಡನುಳ್ಳವಳಿಗಿಂತ</para>
  <para style="q1" vid="ISA 54:1">ಗಂಡ ಬಿಟ್ಟವಳಿಗೆ</para>
  <para style="q2" vid="ISA 54:1">ಮಕ್ಕಳು ಹೆಚ್ಚು,”</para>
  <para style="q2" vid="ISA 54:1">ಎಂದು ಯೆಹೋವ ದೇವರು ಹೇಳುತ್ತಾರೆ.<verse eid="ISA 54:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 54:2"/>“ನಿನ್ನ ಗುಡಾರದ ಸ್ಥಳವನ್ನು ವಿಸ್ತರಿಸು</para>
  <para style="q2" vid="ISA 54:2">ಮತ್ತು ನಿವಾಸದ ಪರದೆಗಳು ಹರಡಲಿ.</para>
  <para style="q1" vid="ISA 54:2">ಹಿಂದೆಗೆಯಬೇಡ; ನಿನ್ನ ಗುಡಾರದ ಹಗ್ಗಗಳನ್ನು ಉದ್ದಮಾಡಿ,</para>
  <para style="q2" vid="ISA 54:2">ಅದರ ಗೂಟಗಳನ್ನು ಬಲಪಡಿಸು.<verse eid="ISA 54:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 54:3"/>ನೀನು ಬಲಗಡೆಗೂ, ಎಡಗಡೆಗೂ ಹಬ್ಬಿಕೊಳ್ಳುವೆ.</para>
  <para style="q2" vid="ISA 54:3">ನಿನ್ನ ಸಂತಾನವು ಜನಾಂಗಗಳನ್ನು ವಶಪಡಿಸಿಕೊಂಡು,</para>
  <para style="q2" vid="ISA 54:3">ಹಾಳಾದ ಪಟ್ಟಣಗಳನ್ನು ನಿವಾಸವಾಗ ಮಾಡುವುದು.<verse eid="ISA 54:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 54:4"/>“ಹೆದರಬೇಡ, ಏಕೆಂದರೆ ನಿನಗೆ ನಾಚಿಕೆಯಾಗುವುದಿಲ್ಲ.</para>
  <para style="q2" vid="ISA 54:4">ಗಾಬರಿಪಡಬೇಡ, ನಿನ್ನ ಯೌವನದ ಲಜ್ಜೆಯನ್ನು ಮರೆತುಬಿಡುವೆ.</para>
  <para style="q1" vid="ISA 54:4">ನಿನ್ನ ವೈಧವ್ಯದಲ್ಲಿ ನಿನಗಾದ ನಿಂದೆಯನ್ನು</para>
  <para style="q2" vid="ISA 54:4">ಎಂದಿಗೂ ನಿನ್ನ ಜ್ಞಾಪಕಕ್ಕೆ ತರುವುದಿಲ್ಲ.<verse eid="ISA 54:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 54:5"/>ನಿನ್ನನ್ನು ಉಂಟುಮಾಡಿದವನೇ ನಿನ್ನ ಪತಿ.</para>
  <para style="q2" vid="ISA 54:5">ಸೇನಾಧೀಶ್ವರ ಯೆಹೋವ ದೇವರು ಎಂಬುದು ಆತನ ಹೆಸರು.</para>
  <para style="q1" vid="ISA 54:5">ನಿನ್ನ ವಿಮೋಚಕನು ಇಸ್ರಾಯೇಲಿನ ಪರಿಶುದ್ಧನೇ.</para>
  <para style="q2" vid="ISA 54:5">ಸಮಸ್ತ ಭೂಮಿಯ ದೇವರು ಎಂದು ಆತನನ್ನು ಕರೆಯಲಾಗುತ್ತದೆ.<verse eid="ISA 54:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 54:6"/>ನೀನು ತ್ಯಜಿಸಿದ ಮನನೊಂದಿರುವ</para>
  <para style="q2" vid="ISA 54:6">ಯೌವನದ ಪತ್ನಿಯ ಹಾಗೆ ತಿರಸ್ಕಾರಹೊಂದಿರುವೆ.</para>
  <para style="q1" vid="ISA 54:6">ಯೆಹೋವ ದೇವರು ನಿನ್ನನ್ನು ಕರೆದಿದ್ದಾನೆ,</para>
  <para style="q2" vid="ISA 54:6">ಎಂದು ನಿನ್ನ ದೇವರು ಹೇಳುತ್ತಾರೆ.<verse eid="ISA 54:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 54:7"/>ಕ್ಷಣಮಾತ್ರಕ್ಕೆ ನಿನ್ನನ್ನು ನಾನು ಬಿಟ್ಟಿದ್ದೇನೆ.</para>
  <para style="q2" vid="ISA 54:7">ಆದರೆ ಮಹಾ ಕೃಪೆಗಳೊಂದಿಗೆ ನಿನ್ನನ್ನು ನಾನು ಕೂಡಿಸುವೆನು.<verse eid="ISA 54:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 54:8"/>ನನಗೆ ಬೇಸರವಾದಾಗ ನನ್ನ ಮುಖವನ್ನು</para>
  <para style="q2" vid="ISA 54:8">ನಿನಗೆ ಕ್ಷಣಮಾತ್ರವೇ ಮರೆಮಾಡಿಕೊಂಡೆನು.</para>
  <para style="q1" vid="ISA 54:8">ಆದರೆ ಶಾಶ್ವತವಾದ ದಯೆಯಿಂದ</para>
  <para style="q2" vid="ISA 54:8">ನಿನ್ನ ಮೇಲೆ ಕರುಣೆಯನ್ನು ಇಟ್ಟಿದ್ದೇನೆ,</para>
  <para style="q2" vid="ISA 54:8">ಎಂದು ನಿನ್ನ ವಿಮೋಚಕನಾದ ಯೆಹೋವ ದೇವರು ಹೇಳುತ್ತಾರೆ.<verse eid="ISA 54:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 54:9"/>“ಇದು ನನಗೆ ನೋಹನ ಕಾಲದ ಪ್ರಳಯದಂತಿದೆ.</para>
  <para style="q2" vid="ISA 54:9">ನೋಹನ ಕಾಲದ ಪ್ರಳಯವು ಪುನಃ ಭೂಮಿಯನ್ನು ಆವರಿಸುವುದಿಲ್ಲ</para>
  <para style="q2" vid="ISA 54:9">ಎಂದು ನಾನು ಪ್ರಮಾಣ ಮಾಡಿದ ಹಾಗೆಯೇ,</para>
  <para style="q1" vid="ISA 54:9">ಇನ್ನು ನಿನ್ನ ಮೇಲೆ ಕೋಪಗೊಳ್ಳುವುದಿಲ್ಲ,</para>
  <para style="q2" vid="ISA 54:9">ನಿನ್ನನ್ನು ಗದರಿಸುವುದಿಲ್ಲ, ಎಂದು ಪ್ರಮಾಣ ಮಾಡಿದ್ದೇನೆ.<verse eid="ISA 54:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 54:10"/>ಪರ್ವತಗಳು ಸ್ಥಳವನ್ನು ಬಿಟ್ಟು ಹೋದರೂ,</para>
  <para style="q2" vid="ISA 54:10">ಬೆಟ್ಟಗಳು ಕದಲಿ ಹೋದರೂ,</para>
  <para style="q1" vid="ISA 54:10">ನನ್ನ ಕುಂದದ ಪ್ರೀತಿಯು ನಿನ್ನನ್ನು ಬಿಟ್ಟು ಹೋಗದು,</para>
  <para style="q2" vid="ISA 54:10">ನನ್ನ ಸಮಾಧಾನದ ಒಡಂಬಡಿಕೆಯು ನಿನ್ನನ್ನು ಬಿಟ್ಟು ಕದಲದು,”</para>
  <para style="q2" vid="ISA 54:10">ಎಂದು ನಿನ್ನನ್ನು ಕರುಣಿಸುವ ಯೆಹೋವ ದೇವರು ಹೇಳುತ್ತಾರೆ.<verse eid="ISA 54:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 54:11"/>ಸಂಕಟಕ್ಕೊಳಗಾದವಳೇ! ಬಿರುಗಾಳಿಯಿಂದ ಬಡಿಯಲಾಗಿ ಆದರಣೆ ಹೊಂದದವಳೇ,</para>
  <para style="q2" vid="ISA 54:11">ನಾನು ನಿನ್ನ ಕಲ್ಲುಗಳನ್ನು ಸುಂದರವಾದ ಬಣ್ಣಗಳೊಂದಿಗೆ ಇಟ್ಟು,</para>
  <para style="q2" vid="ISA 54:11">ನಿನ್ನ ಅಸ್ತಿವಾರವನ್ನು ನೀಲಮಣಿಗಳಿಂದ ಹಾಕಿ ಗಾರೆಯಿಂದ ಕಟ್ಟುವೆನು.<verse eid="ISA 54:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 54:12"/>ನಿನ್ನ ಕಿಟಕಿಗಳನ್ನು ಮಾಣಿಕ್ಯಗಳಿಂದ,</para>
  <para style="q2" vid="ISA 54:12">ನಿನ್ನ ಬಾಗಿಲುಗಳನ್ನು ಪದ್ಮರಾಗಗಳಿಂದ</para>
  <para style="q2" vid="ISA 54:12">ಮತ್ತು ನಿನ್ನ ಮೇರೆಗಳನ್ನು ಮನೋಹರವಾದ ರತ್ನಗಳಿಂದ ನಾನು ಮಾಡುವೆನು.<verse eid="ISA 54:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="ISA 54:13"/>ನಿನ್ನ ಮಕ್ಕಳೆಲ್ಲಾ ಯೆಹೋವ ದೇವರಿಂದಲೇ ಬೋಧನೆ ಪಡೆಯುವರು.</para>
  <para style="q2" vid="ISA 54:13">ನಿನ್ನ ಮಕ್ಕಳ ಸಮಾಧಾನವು ಅಧಿಕವಾಗಿರುವುದು.<verse eid="ISA 54:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="ISA 54:14"/>ನೀನು ನೀತಿಯಲ್ಲಿ ನೆಲೆಗೊಂಡಿರುವೆ.</para>
  <para style="q1" vid="ISA 54:14">ಬಾಧೆಯಿಂದ ದೂರವಾಗಿರುವೆ.</para>
  <para style="q2" vid="ISA 54:14">ನೀನು ಭೀತಿಯಿಂದ ಭಯಪಡುವುದಿಲ್ಲ,</para>
  <para style="q1" vid="ISA 54:14">ಏಕೆಂದರೆ ಅದು ನಿನ್ನ ಸಮೀಪಕ್ಕೆ ಬಾರದು.<verse eid="ISA 54:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="ISA 54:15"/>ನೋಡು, ಯಾರಾದರೂ ನಿನ್ನ ಸಂಗಡ ವ್ಯಾಜ್ಯವಾಡಿದರೆ, ಅದು ನನ್ನ ಅಪ್ಪಣೆಯಿಂದ ಅಲ್ಲ;</para>
  <para style="q2" vid="ISA 54:15">ಯಾರು ನಿನ್ನ ಮೇಲೆ ದಾಳಿಮಾಡುತ್ತಾರೋ, ಅವರು ನಿನಗೆ ಅಧೀನವಾಗುವರು.<verse eid="ISA 54:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="ISA 54:16"/>“ಬೆಂಕಿಯಲ್ಲಿ ಕೆಂಡವನ್ನು ಊದುತ್ತಾ,</para>
  <para style="q2" vid="ISA 54:16">ತನ್ನ ಕೆಲಸಕ್ಕೆ ಆಯುಧಗಳನ್ನು ತರುವ</para>
  <para style="q2" vid="ISA 54:16">ಕಮ್ಮಾರನನ್ನು ಸೃಷ್ಟಿಸಿದವನು ನಾನೇ.</para>
  <para style="q1" vid="ISA 54:16">ನಾಶಮಾಡುವ ಕೆಡುಕನನ್ನು ಸೃಷ್ಟಿಸಿದವನೂ ನಾನೇ.<verse eid="ISA 54:16"/></para>
  <para style="q2">
    <verse number="17" style="v" sid="ISA 54:17"/>ನಿನಗೆ ವಿರೋಧವಾಗಿ ನಿರ್ಮಿಸಿದ ಆಯುಧಗಳು ಸಫಲವಾಗುವುದಿಲ್ಲ.</para>
  <para style="q1" vid="ISA 54:17">ನಿನಗೆ ವಿರೋಧವಾಗಿ ನಿಂತುಕೊಳ್ಳುವ ಪ್ರತಿಯೊಂದು</para>
  <para style="q2" vid="ISA 54:17">ನಾಲಿಗೆಯನ್ನು ನ್ಯಾಯತೀರ್ಪಿನಲ್ಲಿ ನೀನು ಖಂಡಿಸುವೆ.</para>
  <para style="q1" vid="ISA 54:17">ಇದೇ ಯೆಹೋವ ದೇವರ ಸೇವಕರ ಬಾಧ್ಯತೆಯು,</para>
  <para style="q2" vid="ISA 54:17">ಇದು ನನ್ನಿಂದ ಅವರಿಗೆ ದೊರೆಯುವ ಸಮರ್ಥನೆ,”</para>
  <para style="q2" vid="ISA 54:17">ಎಂದು ಯೆಹೋವ ದೇವರು ಹೇಳುತ್ತಾರೆ.<verse eid="ISA 54:17"/></para>
  <chapter eid="ISA 54"/>
  <chapter number="55" style="c" sid="ISA 55"/>
  <para style="s1">ಬಾಯಾರಿದವರಿಗೆ ಆಹ್ವಾನ</para>
  <para style="q1">
    <verse number="1" style="v" sid="ISA 55:1"/>ಬಾಯಾರಿದ ಸಕಲ ಜನರೇ,</para>
  <para style="q2" vid="ISA 55:1">ನೀರಿನ ಬಳಿಗೆ ಬನ್ನಿರಿ,</para>
  <para style="q1" vid="ISA 55:1">ಹಣವಿಲ್ಲದವನೂ ಬರಲಿ.</para>
  <para style="q2" vid="ISA 55:1">ಬನ್ನಿರಿ, ಕೊಂಡುಕೊಳ್ಳಿರಿ, ಉಣ್ಣಿರಿ.</para>
  <para style="q1" vid="ISA 55:1">ಬನ್ನಿರಿ, ಹಣವಿಲ್ಲದೆ ಮತ್ತು ಕ್ರಯವಿಲ್ಲದೆ</para>
  <para style="q2" vid="ISA 55:1">ದ್ರಾಕ್ಷಾರಸವನ್ನೂ ಹಾಲನ್ನೂ ಕೊಂಡುಕೊಳ್ಳಿರಿ.<verse eid="ISA 55:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 55:2"/>ಆಹಾರವಲ್ಲದಕ್ಕೆ ಹಣವನ್ನು ವ್ಯರ್ಥ ಮಾಡುವುದು ಏಕೆ?</para>
  <para style="q2" vid="ISA 55:2">ತೃಪ್ತಿಪಡಿಸದವುಗಳಿಗೆ ನಿಮ್ಮ ದುಡಿತವನ್ನು ವೆಚ್ಚಮಾಡುವುದು ಏಕೆ?</para>
  <para style="q1" vid="ISA 55:2">ಶ್ರದ್ಧೆಯಿಂದ ನನ್ನ ಕಡೆಗೆ ಕಿವಿಗೊಡಿರಿ ಮತ್ತು ಒಳ್ಳೆಯದನ್ನು ನೀವು ಉಣ್ಣಿರಿ.</para>
  <para style="q2" vid="ISA 55:2">ನೀವು ಮೃಷ್ಟಾನ್ನದಲ್ಲಿ ಆನಂದಿಸಿ!<verse eid="ISA 55:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 55:3"/>ಕಿವಿಯನ್ನು ಇತ್ತ ತಿರುಗಿಸಿರಿ, ನನ್ನ ಬಳಿಗೆ ಬನ್ನಿರಿ,</para>
  <para style="q2" vid="ISA 55:3">ಆಲಿಸಿದರೆ ಬದುಕಿ ಬಾಳುವಿರಿ.</para>
  <para style="q1" vid="ISA 55:3">ದಾವೀದನಿಗೆ ಖಂಡಿತವಾಗಿ ವಾಗ್ದಾನ ಮಾಡಿದ ಕೃಪಾವರಗಳನ್ನು</para>
  <para style="q2" vid="ISA 55:3">ನಿಮಗೆ ಕೊಡುತ್ತೇನೆಂಬ ಶಾಶ್ವತವಾದ ಒಡಂಬಡಿಕೆಯನ್ನು ನಿಮ್ಮೊಂದಿಗೆ ಮಾಡಿಕೊಳ್ಳುವೆನು.<verse eid="ISA 55:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 55:4"/>ನಾನು ಅವನನ್ನು ಜನರಿಗೆ ಸಾಕ್ಷಿಯನ್ನಾಗಿಯೂ,</para>
  <para style="q2" vid="ISA 55:4">ಜನರಿಗೆ ನಾಯಕನನ್ನಾಗಿಯೂ, ಅಧಿಪತಿಯನ್ನಾಗಿಯೂ ಕೊಟ್ಟೆನು.<verse eid="ISA 55:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 55:5"/>ನಿನ್ನ ದೇವರಾದ ಯೆಹೋವ ದೇವರ ನಿಮಿತ್ತವೂ,</para>
  <para style="q2" vid="ISA 55:5">ಇಸ್ರಾಯೇಲಿನ ಪರಿಶುದ್ಧನ ನಿಮಿತ್ತವೂ</para>
  <para style="q1" vid="ISA 55:5">ನೀನು ತಿಳಿಯದ ಜನಾಂಗಗಳನ್ನು ಕರೆಯುವೆ,</para>
  <para style="q2" vid="ISA 55:5">ಏಕೆಂದರೆ ಆತನು ನಿನಗೆ ಕೊಟ್ಟ ವೈಭವದಿಂದ ನಿನ್ನನ್ನು</para>
  <para style="q2" vid="ISA 55:5">ತಿಳಿಯದ ಜನಾಂಗಗಳು ನಿನ್ನ ಬಳಿಗೆ ಓಡಿ ಬರುವುವು.<verse eid="ISA 55:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 55:6"/>ಯೆಹೋವ ದೇವರು ಸಿಕ್ಕುವ ಕಾಲದಲ್ಲಿ ಆತನನ್ನು ಹುಡುಕಿರಿ,</para>
  <para style="q2" vid="ISA 55:6">ಆತನು ಸಮೀಪದಲ್ಲಿರುವಾಗ, ಆತನಿಗೆ ಬಿನ್ನಹ ಮಾಡಿರಿ.<verse eid="ISA 55:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 55:7"/>ದುಷ್ಟನು ತನ್ನ ದುರ್ಮಾರ್ಗವನ್ನೂ,</para>
  <para style="q2" vid="ISA 55:7">ಅನೀತಿವಂತನು ತನ್ನ ಆಲೋಚನೆಗಳನ್ನೂ ತೊರೆದುಬಿಟ್ಟು,</para>
  <para style="q1" vid="ISA 55:7">ಯೆಹೋವ ದೇವರ ಕಡೆಗೆ ಹಿಂದಿರುಗಲಿ. ಅವರು ಅವರ ಮೇಲೆ ಕರುಣೆ ಇಡುವರು.</para>
  <para style="q2" vid="ISA 55:7">ನಮ್ಮ ದೇವರ ಬಳಿಗೂ ಹಿಂದಿರುಗಲಿ. ಏಕೆಂದರೆ ಅವರು ಹೇರಳವಾಗಿ ಕ್ಷಮಿಸುವರು.<verse eid="ISA 55:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 55:8"/>ನನ್ನ ಆಲೋಚನೆಗಳು ನಿಮ್ಮ ಆಲೋಚನೆಗಳಲ್ಲ.</para>
  <para style="q2" vid="ISA 55:8">ನಿಮ್ಮ ಮಾರ್ಗಗಳು ನನ್ನ ಮಾರ್ಗಗಳಲ್ಲ,</para>
  <para style="q2" vid="ISA 55:8">ಎಂದು ಯೆಹೋವ ದೇವರು ಹೇಳುತ್ತಾರೆ.<verse eid="ISA 55:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 55:9"/>ಆಕಾಶವು ಭೂಮಿಯ ಮೇಲೆ ಎಷ್ಟು ಉನ್ನತವೋ,</para>
  <para style="q2" vid="ISA 55:9">ನನ್ನ ಮಾರ್ಗಗಳು ನಿಮ್ಮ ಮಾರ್ಗಗಳಿಗಿಂತಲೂ,</para>
  <para style="q2" vid="ISA 55:9">ನನ್ನ ಆಲೋಚನೆಗಳು ನಿಮ್ಮ ಆಲೋಚನೆಗಳಿಗಿಂತಲೂ ಅಷ್ಟು ಉನ್ನತವಾಗಿವೆ.<verse eid="ISA 55:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 55:10"/>ಮಳೆಯೂ, ಹಿಮವೂ ಆಕಾಶದಿಂದ ಬಿದ್ದು,</para>
  <para style="q2" vid="ISA 55:10">ಭೂಮಿಯನ್ನು ತೋಯಿಸಿ, ಹಸಿರುಗೊಳಿಸಿ,</para>
  <para style="q1" vid="ISA 55:10">ಫಲಿಸುವಂತೆ ಮಾಡಿ, ಬಿತ್ತುವವನಿಗೆ ಬೀಜವನ್ನು,</para>
  <para style="q2" vid="ISA 55:10">ಉಣ್ಣುವವನಿಗೆ ಆಹಾರವನ್ನು</para>
  <para style="q1" vid="ISA 55:10">ಒದಗಿಸದ ಹೊರತು ಹೇಗೆ ಆಕಾಶಕ್ಕೆ ಸುಮ್ಮನೆ</para>
  <para style="q2" vid="ISA 55:10">ಹಿಂದಿರುಗುವುದಿಲ್ಲವೋ, ಹಾಗೆಯೇ<verse eid="ISA 55:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 55:11"/>ನನ್ನ ಬಾಯಿಂದ ಹೊರಟ ಮಾತು</para>
  <para style="q2" vid="ISA 55:11">ನನ್ನ ಇಷ್ಟಾರ್ಥವನ್ನು ನೆರವೇರಿಸಿ,</para>
  <para style="q1" vid="ISA 55:11">ನಾನು ಉದ್ದೇಶಿಸಿದ್ದನ್ನು ಕೈಗೂಡಿಸದ ಹೊರತು</para>
  <para style="q2" vid="ISA 55:11">ನನ್ನ ಕಡೆಗೆ ವ್ಯರ್ಥವಾಗಿ ಹಿಂದಿರುಗುವುದಿಲ್ಲ.<verse eid="ISA 55:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 55:12"/>ಏಕೆಂದರೆ ನೀವು ಆನಂದದೊಡನೆ ಹೋಗುವಿರಿ,</para>
  <para style="q2" vid="ISA 55:12">ಸಮಾಧಾನದಿಂದ ಬರುವಿರಿ.</para>
  <para style="q1" vid="ISA 55:12">ಪರ್ವತಗಳು ಮತ್ತು ಗುಡ್ಡಗಳು</para>
  <para style="q2" vid="ISA 55:12">ನಿಮ್ಮ ಮುಂದೆ ಹರ್ಷಧ್ವನಿಗೈಯುವವು.</para>
  <para style="q1" vid="ISA 55:12">ಹೊಲದ ಮರಗಳೆಲ್ಲಾ</para>
  <para style="q2" vid="ISA 55:12">ಚಪ್ಪಾಳೆ ಹೊಡೆಯುವುವು.<verse eid="ISA 55:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="ISA 55:13"/>ಮುಳ್ಳಿಗೆ ಬದಲಾಗಿ ತುರಾಯಿ ಮರವು</para>
  <para style="q2" vid="ISA 55:13">ಮತ್ತು ದತ್ತೂರಿಗೆ ಬದಲಾಗಿ ಸುವಾಸನೆ ಬೀರುವ ಮರವು ಹುಟ್ಟುವುವು.</para>
  <para style="q1" vid="ISA 55:13">ಇದು ಯೆಹೋವ ದೇವರ ಹೆಸರಿಗಾಗಿ</para>
  <para style="q2" vid="ISA 55:13">ಮತ್ತು ಶಾಶ್ವತವಾದ ಗುರುತಾಗಿ</para>
  <para style="q2" vid="ISA 55:13">ಎಂದಿಗೂ ಅಳಿಯದಿರುವುದು.<verse eid="ISA 55:13"/></para>
  <chapter eid="ISA 55"/>
  <chapter number="56" style="c" sid="ISA 56"/>
  <para style="s1">ಇತರರಿಗೂ ಜನರಿಗೆ ರಕ್ಷಣೆ</para>
  <para style="p">
    <verse number="1" style="v" sid="ISA 56:1"/>ಯೆಹೋವ ದೇವರು ಹೇಳುವುದೇನೆಂದರೆ:</para>
  <para style="q1" vid="ISA 56:1">“ನ್ಯಾಯವನ್ನು ಕೈಗೊಳ್ಳಿರಿ,</para>
  <para style="q2" vid="ISA 56:1">ನೀತಿಯಲ್ಲಿ ನಡೆಯಿರಿ.</para>
  <para style="q1" vid="ISA 56:1">ಏಕೆಂದರೆ ನನ್ನ ರಕ್ಷಣೆಯು ಬರುವುದಕ್ಕೂ,</para>
  <para style="q2" vid="ISA 56:1">ನನ್ನ ನೀತಿಯು ಪ್ರಕಟವಾಗುವುದಕ್ಕೂ ಸಮೀಪವಾಗಿದೆ.<verse eid="ISA 56:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 56:2"/>ಇದನ್ನು ಮಾಡುವ ಮನುಷ್ಯನೂ,</para>
  <para style="q2" vid="ISA 56:2">ಇದನ್ನು ಹಿಡಿದುಕೊಳ್ಳುವವರ ಪುತ್ರನೂ ಎಂದರೆ</para>
  <para style="q1" vid="ISA 56:2">ಸಬ್ಬತ್ ದಿನವನ್ನು ಅಪವಿತ್ರ ಮಾಡದೆ ಕೈಗೊಳ್ಳುವವನೂ</para>
  <para style="q2" vid="ISA 56:2">ಮತ್ತು ಯಾವ ಕೇಡನ್ನು ಮಾಡದ ಹಾಗೆ ತನ್ನ ಕೈಯನ್ನು ಕಾಯುವನೋ ಅವನು ಧನ್ಯನು.”<verse eid="ISA 56:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 56:3"/>ಯೆಹೋವ ದೇವರನ್ನು ಸೇರಿಕೊಂಡ ವಿದೇಶೀಯನು,</para>
  <para style="q2" vid="ISA 56:3">“ಯೆಹೋವ ದೇವರು ತಮ್ಮ ಜನರಿಂದ ನನ್ನನ್ನು ಖಂಡಿತವಾಗಿ ಬಹಿಷ್ಕರಿಸುವರು,”</para>
  <para style="q2" vid="ISA 56:3">ಎಂದು ಹೇಳದಿರಲಿ.</para>
  <para style="q1" vid="ISA 56:3">ಮತ್ತು ನಪುಂಸಕನು,</para>
  <para style="q2" vid="ISA 56:3">“ನಾನು ಕೇವಲ ಒಣಗಿದ ಮರ,” ಎಂದು ಹೇಳದಿರಲಿ.<verse eid="ISA 56:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="ISA 56:4"/>ಯೆಹೋವ ದೇವರು ಹೇಳುವುದೇನೆಂದರೆ,</para>
  <para style="q1" vid="ISA 56:4">“ನನ್ನ ಸಬ್ಬತ್ ದಿನವನ್ನು ಕೈಗೊಂಡು,</para>
  <para style="q2" vid="ISA 56:4">ನನಗೆ ಮೆಚ್ಚಿಗೆಯಾದದ್ದನ್ನು ಆಯ್ದುಕೊಂಡು,</para>
  <para style="q2" vid="ISA 56:4">ನನ್ನ ಒಡಂಬಡಿಕೆಯನ್ನು ಹಿಡಿದುಕೊಂಡಿರುವ ನಪುಂಸಕರಿಗೆ,<verse eid="ISA 56:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 56:5"/>ನನ್ನ ಆಲಯದಲ್ಲಿಯೂ ಗೋಡೆಗಳ ಬಳಿಗೂ</para>
  <para style="q2" vid="ISA 56:5">ಪುತ್ರ ಪುತ್ರಿಯರಿಗಿಂತ ಉತ್ತಮವಾದ ಸ್ಥಳವನ್ನೂ,</para>
  <para style="q2" vid="ISA 56:5">ಹೆಸರನ್ನೂ ನಾನು ಕೊಡುತ್ತೇನೆ.</para>
  <para style="q1" vid="ISA 56:5">ನಾನು ಅವರಿಗೆ ಎಂದಿಗೂ ಅಳಿಯದ</para>
  <para style="q2" vid="ISA 56:5">ಶಾಶ್ವತವಾದ ಹೆಸರನ್ನು ಕೊಡುವೆನು.<verse eid="ISA 56:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 56:6"/>ಯೆಹೋವ ದೇವರಾದ ನನ್ನನ್ನು ಸೇವಿಸುವುದಕ್ಕೂ,</para>
  <para style="q2" vid="ISA 56:6">ನನ್ನ ಹೆಸರನ್ನು ಪ್ರೀತಿಸಿ,</para>
  <para style="q1" vid="ISA 56:6">ನನಗೆ ಸೇವಕರಾಗಿರಲು ತಾವಾಗಿ ಯೆಹೋವ ದೇವರೊಂದಿಗೆ ಸೇರಿಕೊಂಡಿರುವ</para>
  <para style="q2" vid="ISA 56:6">ವಿದೇಶಿಯರು ಸಬ್ಬತ್ ದಿನವನ್ನು ಅಪವಿತ್ರ ಮಾಡದೆ,</para>
  <para style="q1" vid="ISA 56:6">ಅದನ್ನು ಕೈಗೊಂಡು,</para>
  <para style="q2" vid="ISA 56:6">ನನ್ನ ಒಡಂಬಡಿಕೆಯನ್ನು ಭದ್ರವಾಗಿ ಪಾಲಿಸುವವರನ್ನು<verse eid="ISA 56:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 56:7"/>ನನ್ನ ಪರಿಶುದ್ಧ ಪರ್ವತಕ್ಕೆ ತರುವೆನು;</para>
  <para style="q2" vid="ISA 56:7">ನನ್ನ ಪ್ರಾರ್ಥನೆಯ ಆಲಯದಲ್ಲಿ ಅವರಿಗೆ ಆನಂದವನ್ನು ಉಂಟುಮಾಡುವೆನು.</para>
  <para style="q1" vid="ISA 56:7">ನನ್ನ ಬಲಿಪೀಠದ ಮೇಲೆ ಅವರು ಅರ್ಪಿಸುವ ದಹನಬಲಿಗಳು,</para>
  <para style="q2" vid="ISA 56:7">ಯಜ್ಞಗಳು ನನಗೆ ಒಪ್ಪಿಗೆಯಾಗುವುವು,</para>
  <para style="q1" vid="ISA 56:7">ಏಕೆಂದರೆ ನನ್ನ ಆಲಯವು ಎಲ್ಲಾ ಜನಾಂಗಗಳಿಗೂ</para>
  <para style="q2" vid="ISA 56:7">ಪ್ರಾರ್ಥನಾಲಯವು ಎಂದು ಎನಿಸಿಕೊಳ್ಳುವುದು.”<verse eid="ISA 56:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 56:8"/>ಇಸ್ರಾಯೇಲಿನ ಸೆರೆಹೋದ ಜನರನ್ನು ಕೂಡಿಸುವಂಥ</para>
  <para style="q2" vid="ISA 56:8">ಸಾರ್ವಭೌಮ ಯೆಹೋವ ದೇವರು ಹೇಳುವುದೇನೆಂದರೆ:</para>
  <para style="q1" vid="ISA 56:8">“ನಾನು ಕೂಡಿಸಿದ ಇಸ್ರಾಯೇಲರೊಂದಿಗೆ</para>
  <para style="q2" vid="ISA 56:8">ಇನ್ನು ಹಲವರನ್ನು ಕೂಡಿಸುವೆನು.”<verse eid="ISA 56:8"/></para>
  <para style="s1">ಅಧಿಪತಿಗಳ ಅತ್ಯಾಸೆ, ಜನರ ದ್ರೋಹ</para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 56:9"/>ಅರಣ್ಯದ ಸಕಲ ಮೃಗಗಳೇ,</para>
  <para style="q2" vid="ISA 56:9">ಕಾಡಿನ ಎಲ್ಲಾ ಮೃಗಗಳೇ, ನುಂಗಿಬಿಡುವುದಕ್ಕೆ ಬನ್ನಿರಿ.<verse eid="ISA 56:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 56:10"/>ಇಸ್ರಾಯೇಲಿನ ಕಾವಲುಗಾರರು ಕುರುಡರು.</para>
  <para style="q2" vid="ISA 56:10">ಅವರೆಲ್ಲರೂ ಅರಿವಿಲ್ಲದವರು.</para>
  <para style="q1" vid="ISA 56:10">ಅವರೆಲ್ಲರೂ ಮೂಕ ನಾಯಿಗಳು,</para>
  <para style="q2" vid="ISA 56:10">ಅವು ಬೊಗಳಲಾರವು,</para>
  <para style="q1" vid="ISA 56:10">ಕನಸು ಕಾಣುತ್ತವೆ, ಬಿದ್ದುಕೊಂಡಿರುತ್ತವೆ.</para>
  <para style="q2" vid="ISA 56:10">ನಿದ್ರೆಯನ್ನು ಪ್ರೀತಿಸುತ್ತವೆ.<verse eid="ISA 56:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 56:11"/>ಹೌದು, ಎಂದಿಗೂ ಸಾಕೆನ್ನದ</para>
  <para style="q2" vid="ISA 56:11">ಹೊಟ್ಟೆಬಾಕ ನಾಯಿಗಳು</para>
  <para style="q1" vid="ISA 56:11">ಮತ್ತು ಅವರು ಗ್ರಹಿಕೆ ಇಲ್ಲದ ಕುರುಬರು,</para>
  <para style="q2" vid="ISA 56:11">ಅವರೆಲ್ಲರೂ ತಮ್ಮ ತಮ್ಮ ಸ್ವಂತ ಮಾರ್ಗಕ್ಕೂ,</para>
  <para style="q2" vid="ISA 56:11">ಪ್ರತಿಯೊಬ್ಬನೂ ತನ್ನ ಲಾಭ ಸಿಕ್ಕುವ ಕಡೆಗೂ ತಿರುಗಿಕೊಳ್ಳುವನು.<verse eid="ISA 56:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 56:12"/>“ಬನ್ನಿರಿ, ನಾನು ದ್ರಾಕ್ಷಾರಸವನ್ನು ತರುವೆನು.</para>
  <para style="q2" vid="ISA 56:12">ನಮ್ಮನ್ನು ನಾವೇ ಬೇಕಾದಷ್ಟು ಮದ್ಯದಿಂದ ತುಂಬಿಕೊಳ್ಳುವ!</para>
  <para style="q1" vid="ISA 56:12">ನಾಳೆಯು ಈ ದಿವಸದಂತೆಯೇ ಇರುವುದು.</para>
  <para style="q2" vid="ISA 56:12">ಅಥವಾ ಇದಕ್ಕಿಂತಲೂ ಚೆನ್ನಾಗಿರುವುದು,” ಎಂದು ಪ್ರತಿಯೊಬ್ಬನೂ ಹೇಳುತ್ತಾನೆ.<verse eid="ISA 56:12"/></para>
  <para style="b"/>
  <para style="b"/>
  <chapter eid="ISA 56"/>
  <chapter number="57" style="c" sid="ISA 57"/>
  <para style="q1">
    <verse number="1" style="v" sid="ISA 57:1"/>ನೀತಿವಂತನು ನಾಶವಾಗುವನು</para>
  <para style="q2" vid="ISA 57:1">ಆದರೆ ಯಾರೂ ಮನಸ್ಸಿಗೆ ಹಚ್ಚಿಕೊಳ್ಳುವುದಿಲ್ಲ.</para>
  <para style="q1" vid="ISA 57:1">ಭಕ್ತಿಯುಳ್ಳ ಮನುಷ್ಯರು ಕಣ್ಮರೆಯಾಗುವರು.</para>
  <para style="q2" vid="ISA 57:1">ನೀತಿವಂತನು ಮುಂದೆ ಬರುವ</para>
  <para style="q1" vid="ISA 57:1">ಕೇಡಿನಿಂದ ಪಾರಾದರು ಎಂಬುದನ್ನು</para>
  <para style="q2" vid="ISA 57:1">ಯಾರೂ ಯೋಚಿಸರು.<verse eid="ISA 57:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 57:2"/>ಅವರು ಸಮಾಧಾನಕ್ಕೆ ಪ್ರವೇಶಿಸುತ್ತಾರೆ.</para>
  <para style="q2" vid="ISA 57:2">ಅವರಲ್ಲಿ ನೆಟ್ಟಗೆ ನಡೆಯುವ ಪ್ರತಿಯೊಬ್ಬರೂ ತಮ್ಮ</para>
  <para style="q2" vid="ISA 57:2">ಮರಣದ ಹಾಸಿಗೆಗಳಲ್ಲಿ ವಿಶ್ರಮಿಸಿಕೊಳ್ಳುತ್ತಾರೆ.<verse eid="ISA 57:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 57:3"/>“ಆದರೆ ನೀವು ಮಾಟಗಾತಿಯ ಮಕ್ಕಳೇ,</para>
  <para style="q2" vid="ISA 57:3">ವೇಶ್ಯೆ ಮತ್ತು ವ್ಯಭಿಚಾರಿಗಳ ಸಂತಾನದವರೇ, ಇಲ್ಲಿಗೆ ಬನ್ನಿರಿ.<verse eid="ISA 57:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 57:4"/>ಯಾರನ್ನು ಹಾಸ್ಯಮಾಡುತ್ತೀರಿ?</para>
  <para style="q2" vid="ISA 57:4">ಯಾರ ವಿಷಯವಾಗಿ ನೀವು ಬಾಯಿ ಅಗಲಿಸಿ,</para>
  <para style="q2" vid="ISA 57:4">ನಾಲಿಗೆಯನ್ನು ಚಾಚುತ್ತೀರಿ?<verse eid="ISA 57:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 57:5"/>ಹಸಿರಾದ ಏಲಾ ಮರಗಳ ಕೆಳಗೆ</para>
  <para style="q2" vid="ISA 57:5">ವಿಗ್ರಹಗಳಿಂದ ಮದವೇರಿಸಿಕೊಂಡು,</para>
  <para style="q1" vid="ISA 57:5">ಹಳ್ಳಗಳಲ್ಲಿ ಬಂಡೆಗಳ ಬಿರುಕುಗಳಲ್ಲಿ ಮಕ್ಕಳನ್ನು ಕೊಂದುಹಾಕುವ ನೀವು</para>
  <para style="q2" vid="ISA 57:5">ದ್ರೋಹದ ಮಕ್ಕಳೂ, ಸುಳ್ಳಿನ ಸಂತತಿಯೂ ಅಲ್ಲವೋ?<verse eid="ISA 57:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 57:6"/>ಹಳ್ಳದ ನುಣುಪಾದ ಕಲ್ಲುಗಳು ನಿಮ್ಮ ಪಾಲು.</para>
  <para style="q2" vid="ISA 57:6">ಅವುಗಳೇ ಹೌದು, ಅವೇ ನಿನ್ನ ಪಾಲು.</para>
  <para style="q1" vid="ISA 57:6">ಅವುಗಳಿಗೆ ನೀನು ಪಾನದ್ರವ್ಯವನ್ನು</para>
  <para style="q2" vid="ISA 57:6">ಮತ್ತು ಧಾನ್ಯ ಸಮರ್ಪಣೆಯನ್ನು ಅರ್ಪಿಸಿದ್ದೀಯೆ.</para>
  <para style="q2" vid="ISA 57:6">ನಾನು ಇದನ್ನೆಲ್ಲಾ ಕಂಡು ನನ್ನ ಕೋಪವನ್ನು ಅಡಗಿಸಿಕೊಳ್ಳಲು ಆಗುವುದೇ?<verse eid="ISA 57:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 57:7"/>ಮಹೋನ್ನತ ಪರ್ವತದಲ್ಲಿ ನೀನು ಹಾಸಿಗೆಯನ್ನು ಹಾಕಿಕೊಂಡಿದ್ದೀಯೆ,</para>
  <para style="q2" vid="ISA 57:7">ಬಲಿಯನ್ನರ್ಪಿಸಲು ಆ ಬೆಟ್ಟವನ್ನೇರಿದ್ದೀ.<verse eid="ISA 57:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 57:8"/>ಕದಗಳ ಮತ್ತು ನಿಲುವಿನ ಹಿಂಭಾಗದಲ್ಲಿ</para>
  <para style="q2" vid="ISA 57:8">ನಿನ್ನ ಜ್ಞಾಪಕದ ಚಿಹ್ನೆಯನ್ನು ಇಟ್ಟಿದ್ದೀಯೆ.</para>
  <para style="q1" vid="ISA 57:8">ಏಕೆಂದರೆ ನನ್ನನ್ನು ಬಿಟ್ಟು ಬೇರೊಬ್ಬನಿಗೆ</para>
  <para style="q2" vid="ISA 57:8">ನಿನ್ನನ್ನು ತೋರ್ಪಡಿಸಿಕೊಂಡಿದ್ದೀ.</para>
  <para style="q1" vid="ISA 57:8">ಏರಿಹೋಗಿ ನಿನ್ನ ಮಂಚವನ್ನು ಅಗಲಮಾಡಿಕೊಂಡು ಅವರೊಂದಿಗೆ ಒಪ್ಪಂದ ಮಾಡಿಕೊಂಡಿದ್ದೀ.</para>
  <para style="q2" vid="ISA 57:8">ಅವರ ಮಂಚವನ್ನು ಕಂಡಲ್ಲಿ ಅದನ್ನು ಪ್ರೀತಿ ಮಾಡಿದ್ದೀಯೆ.<verse eid="ISA 57:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 57:9"/>ಬಹು ಸುಗಂಧದ್ರವ್ಯಗಳನ್ನು ಕೂಡಿಸಿ,</para>
  <para style="q2" vid="ISA 57:9">ತೈಲದೊಂದಿಗೆ ರಾಜನ ಬಳಿಗೆ ಹೋಗಿದ್ದೀ.</para>
  <para style="q1" vid="ISA 57:9">ದೂರಕ್ಕೆ ನಿನ್ನ ರಾಯಭಾರಿಗಳನ್ನು ಕಳುಹಿಸಿದ್ದೀ.</para>
  <para style="q2" vid="ISA 57:9">ಪಾತಾಳದಷ್ಟು ನೀಚಸ್ಥಿತಿಗೆ ಇಳಿದಿದ್ದೀಯೆ.<verse eid="ISA 57:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 57:10"/>ನಿನ್ನ ಮಾರ್ಗದಲ್ಲಿ ಬಹಳವಾಗಿ ದಣಿದಿದ್ದರೂ,</para>
  <para style="q2" vid="ISA 57:10">‘ಏನೂ ಪ್ರಯೋಜನವಿಲ್ಲ,’ ಎಂದುಕೊಳ್ಳಲಿಲ್ಲ.</para>
  <para style="q1" vid="ISA 57:10">ನೀನು ಹೊಸ ಬಲವನ್ನು ತಂದುಕೊಂಡು,</para>
  <para style="q2" vid="ISA 57:10">ಬೇಸರಗೊಳ್ಳದೆ ಮುಂದುವರೆದಿರುವೆ.<verse eid="ISA 57:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 57:11"/>“ನೀನು ಯಾರಿಗೆ ಹೆದರಿ, ಬೆದರಿ,</para>
  <para style="q2" vid="ISA 57:11">ನನ್ನನ್ನು ಮರೆತು, ನನಗೆ ಸುಳ್ಳಾಡಿ</para>
  <para style="q1" vid="ISA 57:11">ಮೋಸ ಮಾಡಿರುವೆ.</para>
  <para style="q2" vid="ISA 57:11">ಇಂಥ ದ್ರೋಹಕ್ಕೂ ನೀನು ಹಿಂಜರಿಯಲಿಲ್ಲವಲ್ಲಾ!</para>
  <para style="q1" vid="ISA 57:11">ಬಹುಕಾಲದಿಂದ ನಾನು ಸುಮ್ಮನೆ ಇದ್ದುದರಿಂದಲೇ,</para>
  <para style="q2" vid="ISA 57:11">ನೀನು ನನ್ನನ್ನು ಗೌರವಿಸದೆ ಇರುವುದಕ್ಕೆ ಕಾರಣವಲ್ಲವೆ?<verse eid="ISA 57:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 57:12"/>ನಾನೇ ನಿನ್ನ ನೀತಿಯನ್ನೂ, ನಿನ್ನ ಕ್ರಿಯೆಗಳನ್ನೂ ತಿಳಿಯ ಮಾಡುವೆನು.</para>
  <para style="q2" vid="ISA 57:12">ಏಕೆಂದರೆ ಅವು ನಿನಗೆ ಪ್ರಯೋಜನವಾಗುವುದಿಲ್ಲ.<verse eid="ISA 57:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="ISA 57:13"/>ನೀನು ಸಹಾಯಕ್ಕಾಗಿ ಕೂಗುವಾಗ</para>
  <para style="q2" vid="ISA 57:13">ನಿನ್ನ ವಿಗ್ರಹಗಳು ನಿನ್ನನ್ನು ರಕ್ಷಿಸಲಿ.</para>
  <para style="q1" vid="ISA 57:13">ಇವುಗಳನ್ನೆಲ್ಲಾ ಗಾಳಿಯು ಬಡಿದುಕೊಂಡು ಹೋಗುವುದು.</para>
  <para style="q2" vid="ISA 57:13">ವ್ಯರ್ಥವಾದದ್ದು ಅವುಗಳನ್ನು ತೆಗೆದುಕೊಂಡು ಹೋಗುವುದು.</para>
  <para style="q1" vid="ISA 57:13">ಆದರೆ ನನ್ನಲ್ಲಿ ಆಶ್ರಯಿಸುವವನು,</para>
  <para style="q2" vid="ISA 57:13">ದೇಶವನ್ನು ವಶಮಾಡಿಕೊಂಡು,</para>
  <para style="q2" vid="ISA 57:13">ನನ್ನ ಪರಿಶುದ್ಧ ಪರ್ವತವನ್ನು ಬಾಧ್ಯವಾಗಿ ಹೊಂದುವನು.”<verse eid="ISA 57:13"/></para>
  <para style="s1">ಮಾನಸಾಂತರಪಟ್ಟವರಿಗೆ ಆದರಣೆ</para>
  <para style="p">
    <verse number="14" style="v" sid="ISA 57:14"/>ನಂತರ ಹೀಗೆ ಹೇಳಲಾಗುವುದು:</para>
  <para style="q1" vid="ISA 57:14">ಮಣ್ಣು ಹಾಕಿರಿ, ಹಾಕಿರಿ, ಮಾರ್ಗವನ್ನು ಸರಿಮಾಡಿರಿ,</para>
  <para style="q2" vid="ISA 57:14">ನನ್ನ ಜನರ ದಾರಿಯೊಳಗಿಂದ ಆತಂಕವನ್ನು ಎತ್ತಿ ಹಾಕಿರಿ,<verse eid="ISA 57:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="ISA 57:15"/>ಏಕೆಂದರೆ ಉನ್ನತನೂ, ಮಹೋನ್ನತನೂ,</para>
  <para style="q2" vid="ISA 57:15">ನಿತ್ಯವಾಗಿ ವಾಸಿಸುವವನೂ, ಪರಿಶುದ್ಧನು ಎಂಬ ಹೆಸರುಳ್ಳಾತನೂ ಹೇಳುವುದೇನೆಂದರೆ:</para>
  <para style="q1" vid="ISA 57:15">“ಉನ್ನತವಾದ ಪರಿಶುದ್ಧ ಸ್ಥಳದಲ್ಲಿ ವಾಸಿಸುವ ನಾನಾದರೂ,</para>
  <para style="q2" vid="ISA 57:15">ಪಶ್ಚಾತ್ತಾಪ ಪಡುವ ದೀನಮನದೊಂದಿಗೆ ನಾನಿದ್ದೇನೆ.</para>
  <para style="q1" vid="ISA 57:15">ದೀನನ ಆತ್ಮವನ್ನು ಹಾಗು ಪಶ್ಚಾತ್ತಾಪ ಪಡುವ</para>
  <para style="q2" vid="ISA 57:15">ಮನಸ್ಸನ್ನು ಉಜ್ಜೀವಗೊಳಿಸುವವನಾಗಿದ್ದೇನೆ.<verse eid="ISA 57:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="ISA 57:16"/>ನಾನು ಎಂದೆಂದಿಗೂ ವ್ಯಾಜ್ಯವಾಡುವುದಿಲ್ಲ.</para>
  <para style="q2" vid="ISA 57:16">ಯಾವಾಗಲೂ ಕೋಪಿಸಿಕೊಳ್ಳೆನು.</para>
  <para style="q1" vid="ISA 57:16">ಏಕೆಂದರೆ ಆತ್ಮವೂ, ನಾನು ಉಂಟುಮಾಡಿದ ಜೀವವೂ</para>
  <para style="q2" vid="ISA 57:16">ನನ್ನಿಂದ ಕುಂದಿ ಹೋದಾವು.<verse eid="ISA 57:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="ISA 57:17"/>ಅವನ ದುರಾಶೆಯ ಅನ್ಯಾಯಕ್ಕೆ ನಾನು ಕೋಪಗೊಂಡು,</para>
  <para style="q2" vid="ISA 57:17">ಅವನನ್ನು ಹೊಡೆದೆನು. ನನ್ನ ಮುಖವನ್ನು ಮುಚ್ಚಿಕೊಂಡು ರೋಷಭರಿತನಾದೆನು.</para>
  <para style="q2" vid="ISA 57:17">ಅವನು ಮೊಂಡುತನದಿಂದ ತನ್ನ ಮನಸ್ಸಿಗೆ ಬಂದ ಹಾಗೆಯೇ ನಡೆಯುತ್ತಾ ಬಂದಿದ್ದಾನೆ.<verse eid="ISA 57:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="ISA 57:18"/>ನಾನು ಅವನ ಮಾರ್ಗವನ್ನು ನೋಡಿದ್ದೇನೆ. ಅವನನ್ನು ಸ್ವಸ್ಥಮಾಡಿ,</para>
  <para style="q2" vid="ISA 57:18">ಅವನನ್ನು ನಡೆಸುತ್ತೇನೆ. ಅವನಿಗೂ, ಅವನ ದುಃಖಿತರಿಗೂ ಆದರಣೆಗಳನ್ನು ಪುನಃಸ್ಥಾಪಿಸುವೆನು.<verse eid="ISA 57:18"/></para>
  <para style="q2">
    <verse number="19" style="v" sid="ISA 57:19"/>ನಾನು ತುಟಿಗಳಿಗೆ ಸ್ತೋತ್ರವನ್ನು ಉಂಟುಮಾಡುವೆನು;</para>
  <para style="q1" vid="ISA 57:19">ದೂರವಾದವನಿಗೂ ಸಮೀಪವಾದವನಿಗೂ ಸಮಾಧಾನವಿರಲಿ, ಸಮಾಧಾನವಿರಲಿ.</para>
  <para style="q2" vid="ISA 57:19">ನಾನು ಅವರನ್ನು ಸ್ವಸ್ಥ ಮಾಡುವೆನು,”</para>
  <para style="q2" vid="ISA 57:19">ಎಂದು ಯೆಹೋವ ದೇವರು ಹೇಳುತ್ತಾರೆ.<verse eid="ISA 57:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="ISA 57:20"/>ಆದರೆ ದುಷ್ಟರು ಸುಮ್ಮನಿರಲಾರದಂಥ,</para>
  <para style="q2" vid="ISA 57:20">ಅದರ ನೀರುಗಳು ಕೆಸರನ್ನೂ,</para>
  <para style="q2" vid="ISA 57:20">ಮೈಲಿಗೆಯನ್ನೂ ಕಾರುವಂಥ ಅಲ್ಲಕಲ್ಲೋಲವಾಗಿರುವ ಸಮುದ್ರದ ಹಾಗಿದ್ದಾರೆ.<verse eid="ISA 57:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="ISA 57:21"/>“ದುಷ್ಟರಿಗೆ ಸಮಾಧಾನವೇ ಇಲ್ಲ,”</para>
  <para style="q2" vid="ISA 57:21">ಎಂದು ನನ್ನ ದೇವರು ಹೇಳುತ್ತಾರೆ.<verse eid="ISA 57:21"/></para>
  <chapter eid="ISA 57"/>
  <chapter number="58" style="c" sid="ISA 58"/>
  <para style="s1">ನಿಜವಾದ ಉಪವಾಸ</para>
  <para style="q1">
    <verse number="1" style="v" sid="ISA 58:1"/>“ಗಟ್ಟಿಯಾಗಿ ಕೂಗು, ಹಿಂತೆಗೆಯಬೇಡ.</para>
  <para style="q2" vid="ISA 58:1">ತುತೂರಿಯಂತೆ ನಿನ್ನ ಸ್ವರವನ್ನೆತ್ತು.</para>
  <para style="q1" vid="ISA 58:1">ನನ್ನ ಜನರಿಗೆ ಅವರ ದ್ರೋಹವನ್ನೂ</para>
  <para style="q2" vid="ISA 58:1">ಯಾಕೋಬನ ಮನೆಯವರಿಗೆ ಅವರ ಪಾಪವನ್ನು ಘೋಷಿಸು.<verse eid="ISA 58:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 58:2"/>ಆದರೂ ಅವರು ನನ್ನನ್ನು ಪ್ರತಿನಿತ್ಯವೂ ಹುಡುಕುತ್ತಾರೆ.</para>
  <para style="q2" vid="ISA 58:2">ನನ್ನ ಮಾರ್ಗಗಳನ್ನು ತಿಳಿದುಕೊಳ್ಳುವುದರಲ್ಲಿ ಸಂತೋಷಪಡುತ್ತಾರೆ.</para>
  <para style="q1" vid="ISA 58:2">ತನ್ನ ದೇವರ ಆಜ್ಞೆಗಳನ್ನು ಬಿಡದೆ,</para>
  <para style="q2" vid="ISA 58:2">ನೀತಿಯನ್ನಾಚರಿಸುವ ಜನಾಂಗದ ಹಾಗೆಯೇ,</para>
  <para style="q1" vid="ISA 58:2">ನೀತಿಯುಳ್ಳ ನ್ಯಾಯಗಳನ್ನು ನನ್ನಿಂದ ಕೇಳುತ್ತಾರೆ.</para>
  <para style="q2" vid="ISA 58:2">ದೇವರನ್ನು ಸಮೀಪಿಸುವುದರಲ್ಲಿ ಸಂತೋಷಿಸುತ್ತಾರೆ.<verse eid="ISA 58:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 58:3"/>‘ನಾವು ಉಪವಾಸ ಮಾಡಿದ್ದೇವೆ,</para>
  <para style="q2" vid="ISA 58:3">ನೀನು ಏಕೆ ಕಟಾಕ್ಷಿಸಲಿಲ್ಲ?’</para>
  <para style="q1" vid="ISA 58:3">‘ನಮ್ಮ ಪ್ರಾಣವನ್ನು ಕುಂದಿಸಿಕೊಂಡಿದ್ದೇವೆ, ನೀನು ಗಮನಿಸದಿರುವುದೇಕೆ?’</para>
  <para style="q2" vid="ISA 58:3">ಎಂದು ಅವರು ಅಂದುಕೊಳ್ಳುತ್ತಾರೆ.</para>
  <para style="b" vid="ISA 58:3"/>
  <para style="q1" vid="ISA 58:3">“ನಿಮ್ಮ ಉಪವಾಸದ ದಿನದಲ್ಲಿಯೂ ನಿಮ್ಮ ಇಷ್ಟದ ಕೆಲಸವನ್ನು ನಡೆಸಿ</para>
  <para style="q2" vid="ISA 58:3">ಮತ್ತು ನಿಮ್ಮ ಕೆಲಸದವರನ್ನು ದುಡಿತಕ್ಕೆ ಎಳೆಯುತ್ತೀರಿ.<verse eid="ISA 58:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 58:4"/>ನಿಮ್ಮ ಉಪವಾಸದ ಪರಿಣಾಮಗಳು ಇಷ್ಟೆ:</para>
  <para style="q2" vid="ISA 58:4">ವ್ಯಾಜ್ಯ, ಕಲಹ, ಹೊಡೆದಾಟ.</para>
  <para style="q1" vid="ISA 58:4">ಇಲ್ಲಿಯವರೆಗೆ ನೀವು ಮಾಡಿದಂತೆ ಉಪವಾಸ ಮಾಡಿದರೆ,</para>
  <para style="q2" vid="ISA 58:4">ನಿಮ್ಮ ಪ್ರಾರ್ಥನೆ ಪರಲೋಕವನ್ನು ಮುಟ್ಟುವುದಿಲ್ಲ.<verse eid="ISA 58:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 58:5"/>ನಾನು ಆಯ್ದುಕೊಂಡದ್ದು ಇಂಥಾ ಉಪವಾಸವೋ?</para>
  <para style="q2" vid="ISA 58:5">ಒಬ್ಬನು ಜೊಂಡಿನಂತೆ ತಲೆಯನ್ನು ಬಗ್ಗಿಸಿಕೊಳ್ಳುವುದು,</para>
  <para style="q1" vid="ISA 58:5">ಗೋಣಿತಟ್ಟನ್ನು ಉಟ್ಟುಕೊಳ್ಳುವುದು,</para>
  <para style="q2" vid="ISA 58:5">ಬೂದಿಯ ಗುಂಡಿಯಲ್ಲಿ ಕುಳಿತುಕೊಳ್ಳುವುದು,</para>
  <para style="q1" vid="ISA 58:5">ಇವು ಯೆಹೋವ ದೇವರಿಗೆ ಮೆಚ್ಚಿಗೆಯಾಗುವ</para>
  <para style="q2" vid="ISA 58:5">ಉಪವಾಸ ಎನ್ನುತ್ತೀರೋ?<verse eid="ISA 58:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 58:6"/>“ನಾನು ಆಯ್ದುಕೊಳ್ಳುವ ಉಪವಾಸವು</para>
  <para style="q1" vid="ISA 58:6">ಅನ್ಯಾಯದ ಸರಪಣಿಯನ್ನು ಬಿಚ್ಚುವುದೂ,</para>
  <para style="q2" vid="ISA 58:6">ಭಾರವಾದ ಹೊರೆಯನ್ನು ಬಿಚ್ಚುವುದೂ,</para>
  <para style="q1" vid="ISA 58:6">ದಬ್ಬಾಳಿಕೆಯಾದವರನ್ನು ಬಿಡಿಸುವುದೂ,</para>
  <para style="q2" vid="ISA 58:6">ನೊಗಗಳನ್ನೆಲ್ಲಾ ಮುರಿದುಹಾಕುವುದೂ, ಇವೇ ಅಲ್ಲವೋ?<verse eid="ISA 58:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 58:7"/>ಹಸಿದವರಿಗೆ ಅನ್ನ ಕೊಡುವುದು,</para>
  <para style="q2" vid="ISA 58:7">ನೆಲೆಯಿಲ್ಲದೆ ಅಲೆಯುತ್ತಿರುವ ಬಡವರನ್ನು ಮನೆಗೆ ಬರಮಾಡಿಕೊಳ್ಳುವುದು,</para>
  <para style="q1" vid="ISA 58:7">ಬಟ್ಟೆಯಿಲ್ಲದವರನ್ನು ಕಂಡಾಗ ಅವರಿಗೆ ಬಟ್ಟೆ ಹೊದಿಸುವುದು,</para>
  <para style="q2" vid="ISA 58:7">ನಿನ್ನ ರಕ್ತಸಂಬಂಧಿಕರಿಂದ ಮುಖ ಮರೆಮಾಡಿಕೊಳ್ಳದಿರುವುದು,</para>
  <para style="q1" vid="ISA 58:7">ಇದೇ ಅಲ್ಲವೇ ನನಗೆ ಇಷ್ಟಕರವಾದ ಉಪವಾಸ ವ್ರತ?<verse eid="ISA 58:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 58:8"/>ಆಗ ನಿನ್ನ ಬೆಳಕು ಉದಯದಂತೆ ಪ್ರತ್ಯಕ್ಷವಾಗುವುದು.</para>
  <para style="q2" vid="ISA 58:8">ನಿನ್ನ ಆರೋಗ್ಯ ತ್ವರಿತವಾಗಿ ಕಾಣಿಸಿಕೊಳ್ಳುತ್ತದೆ.</para>
  <para style="q1" vid="ISA 58:8">ನಿನ್ನ ನೀತಿ ನಿನಗೆ ಮುಂಬಲವಾಗಿರುವುದು.</para>
  <para style="q2" vid="ISA 58:8">ಯೆಹೋವ ದೇವರ ಮಹಿಮೆಯು ನಿನಗೆ ಹಿಂಬಲವಾಗಿರುವುದು.<verse eid="ISA 58:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 58:9"/>ಆಗ ನೀನು ಕರೆದರೆ ಯೆಹೋವ ದೇವರು ಉತ್ತರಕೊಡುವರು.</para>
  <para style="q2" vid="ISA 58:9">ನೀನು ಕೂಗುವೆ, ಆಗ ಅವರು, ‘ನಾನು ಇಲ್ಲಿ ಇದ್ದೇನೆ,’ ಅನ್ನುವರು.</para>
  <para style="b" vid="ISA 58:9"/>
  <para style="q1" vid="ISA 58:9">“ನೀನು ನಿನ್ನ ಮಧ್ಯದೊಳಗಿಂದ ದಬ್ಬಾಳಿಕೆಯ ನೊಗವನ್ನೂ,</para>
  <para style="q2" vid="ISA 58:9">ಬೆರಳ ಸನ್ನೆಯನ್ನೂ, ವ್ಯರ್ಥವಾದ ಸಂಭಾಷಣೆಯನ್ನೂ ತೆಗೆದುಹಾಕಿ,<verse eid="ISA 58:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 58:10"/>ಹಸಿದವನ ಕಡೆಗೆ ನಿನ್ನ ಮನಸ್ಸು ಹೋಗುವಂತೆ ಮಾಡಿ,</para>
  <para style="q2" vid="ISA 58:10">ದಬ್ಬಾಳಿಕೆಗೆ ಒಳಗಾದವನ ಪ್ರಾಣವನ್ನು ತೃಪ್ತಿಪಡಿಸಿದರೆ,</para>
  <para style="q1" vid="ISA 58:10">ಆಗ ನಿನ್ನ ಬೆಳಕು ಕತ್ತಲೆಯಲ್ಲಿ ಉದಯಿಸುವುದು.</para>
  <para style="q2" vid="ISA 58:10">ನಿನ್ನ ಅಂಧಕಾರವು ಪರಿಹಾರವಾಗಿ ಮಧ್ಯಾಹ್ನವಾಗುವುದು.<verse eid="ISA 58:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 58:11"/>ಯೆಹೋವ ದೇವರು ನಿನ್ನನ್ನು ನಿತ್ಯವೂ ನಡೆಸುತ್ತಾ,</para>
  <para style="q2" vid="ISA 58:11">ಮಳೆಯಿಲ್ಲದ ಕಾಲದಲ್ಲಿ ನಿನ್ನ ಪ್ರಾಣವನ್ನು ತೃಪ್ತಿಗೊಳಿಸಿ,</para>
  <para style="q1" vid="ISA 58:11">ನಿನ್ನ ಎಲುಬುಗಳನ್ನು ಬಲಪಡಿಸುವರು</para>
  <para style="q2" vid="ISA 58:11">ಮತ್ತು ನೀನು ನೀರು ಹಾಕಿದ ತೋಟದ ಹಾಗೆಯೂ ಇರುವೆ.</para>
  <para style="q2" vid="ISA 58:11">ಬತ್ತಿಹೋಗದ ಬುಗ್ಗೆಯಂತೆಯೂ ನೀವು ಇರುವಿರಿ<verse eid="ISA 58:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 58:12"/>ಆಗ ನಿನ್ನವರು ಪುರಾತನ ಕಾಲದ ಹಾಳಾದ ಸ್ಥಳಗಳನ್ನು ಕಟ್ಟುವರು.</para>
  <para style="q2" vid="ISA 58:12">ತಲತಲಾಂತರಗಳಿಂದ ಹಾಳುಬಿದ್ದಿರುವ ಅಸ್ತಿವಾರಗಳನ್ನು ನೀನು ಎಬ್ಬಿಸುವೆ.</para>
  <para style="q1" vid="ISA 58:12">ಬಿದ್ದ ಗೋಡೆಯನ್ನು ಎಬ್ಬಿಸುವ ದೇಶ ಎಂದೂ,</para>
  <para style="q2" vid="ISA 58:12">ನಿವಾಸಿಗಳಿಗಾಗಿ ನಡೆದಾಡಲು ಹಾದಿಗಳನ್ನು ಉಂಟುಮಾಡುವ ದೇಶ</para>
  <para style="q2" vid="ISA 58:12">ಎಂದೂ ನಿನಗೆ ಬಿರುದು ಬರುವುದು.<verse eid="ISA 58:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="ISA 58:13"/>“ನೀನು ಸಬ್ಬತ್<note caller="+" style="f"><char style="fr" closed="false">58:13 </char><char style="fq" closed="false">ಸಬ್ಬತ್ </char><char style="ft" closed="false">ಅಂದರೆ </char><char style="fqa" closed="false">ವಿಶ್ರಾಂತಿ ದಿನ</char></note> ದಿನದಲ್ಲಿ ನಿನ್ನ ಕಾಲನ್ನು ಹಿಂದೆಗೆದು,</para>
  <para style="q2" vid="ISA 58:13">ನನ್ನ ಪರಿಶುದ್ಧ ದಿವಸದಲ್ಲಿ ನಿನ್ನ ಇಷ್ಟವನ್ನು ಮಾಡದೆ ಹೋದರೆ,</para>
  <para style="q1" vid="ISA 58:13">ಸಬ್ಬತ್ ದಿನವನ್ನು ಆನಂದಕರವಾದದ್ದೆಂದೂ,</para>
  <para style="q2" vid="ISA 58:13">ಯೆಹೋವ ದೇವರ ಪರಿಶುದ್ಧ ದಿವಸವನ್ನು ಘನವುಳ್ಳದ್ದೆಂದೂ ಕರೆದರೆ,</para>
  <para style="q1" vid="ISA 58:13">ಸ್ವಂತ ಕೆಲಸಗಳನ್ನು ಮಾಡದೆ, ಸ್ವಂತ ಇಷ್ಟಗಳನ್ನು ಕಂಡುಕೊಳ್ಳದೆ,</para>
  <para style="q2" vid="ISA 58:13">ಸ್ವಂತ ಮಾತುಗಳನ್ನು ಆಡದೆ, ಅದನ್ನು ಘನಪಡಿಸಿದರೆ,<verse eid="ISA 58:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="ISA 58:14"/>ಆಗ ಯೆಹೋವ ದೇವರಲ್ಲಿ ಆನಂದಗೊಳ್ಳುವಿ.</para>
  <para style="q2" vid="ISA 58:14">ಭೂಮಿಯ ಎತ್ತರವಾದ ಸ್ಥಳಗಳ ಮೇಲೆ ನಿನ್ನನ್ನು ಹತ್ತಿಸಿ,</para>
  <para style="q2" vid="ISA 58:14">ನಿನ್ನ ತಂದೆಯಾದ ಯಾಕೋಬನ ಬಾಧ್ಯತೆಯನ್ನು ಅನುಭವಿಸುವಂತೆ ನಿನಗೆ ಮಾಡುವೆನು.”</para>
  <para style="q1" vid="ISA 58:14">ಏಕೆಂದರೆ ಯೆಹೋವ ದೇವರ ಬಾಯಿ ಇದನ್ನು ನುಡಿದಿದೆ.<verse eid="ISA 58:14"/></para>
  <chapter eid="ISA 58"/>
  <chapter number="59" style="c" sid="ISA 59"/>
  <para style="s1">ಪಾಪ, ಮಾನಸಾಂತರ ಮತ್ತು ಬಿಡುಗಡೆ</para>
  <para style="q1">
    <verse number="1" style="v" sid="ISA 59:1"/>ಯೆಹೋವ ದೇವರ ಕೈ ರಕ್ಷಿಸಲಾರದ ಹಾಗೆ ಮೋಟುಗೈಯಲ್ಲ.</para>
  <para style="q2" vid="ISA 59:1">ಆತನ ಕಿವಿ ಕೇಳಲಾರದ ಹಾಗೆ ಮಂದವಾಗಿಲ್ಲ.<verse eid="ISA 59:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 59:2"/>ನಿಮ್ಮ ಅಕ್ರಮಗಳೇ, ನಿಮ್ಮನ್ನು</para>
  <para style="q2" vid="ISA 59:2">ನಿಮ್ಮ ದೇವರಿಂದ ಅಗಲಿಸಿವೆ.</para>
  <para style="q1" vid="ISA 59:2">ನಿಮ್ಮ ಪಾಪಗಳೇ, ಆತನು ಹೇಳಿದ ಹಾಗೆ</para>
  <para style="q2" vid="ISA 59:2">ಆತನ ಮುಖವನ್ನು ನಿಮಗೆ ಮರೆಮಾಡಿಸಿವೆ.<verse eid="ISA 59:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 59:3"/>ಏಕೆಂದರೆ ನಿಮ್ಮ ಕೈಗಳು ರಕ್ತದಿಂದಲೂ,</para>
  <para style="q2" vid="ISA 59:3">ನಿಮ್ಮ ಬೆರಳುಗಳು ಅಕ್ರಮದಿಂದಲೂ ಮೈಲಿಗೆಯಾಗಿವೆ.</para>
  <para style="q1" vid="ISA 59:3">ನಿಮ್ಮ ತುಟಿಗಳು ಸುಳ್ಳನ್ನು ಆಡುತ್ತವೆ.</para>
  <para style="q2" vid="ISA 59:3">ನಿಮ್ಮ ನಾಲಿಗೆ ಅನ್ಯಾಯವನ್ನು ನುಡಿಯುತ್ತದೆ.<verse eid="ISA 59:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 59:4"/>ನೀತಿಗೋಸ್ಕರ ಕರೆಯುವವನು ಯಾವನೂ ಇಲ್ಲ,</para>
  <para style="q2" vid="ISA 59:4">ಸತ್ಯಕ್ಕೋಸ್ಕರ ನ್ಯಾಯ ವಿಚಾರಿಸುವವನು ಒಬ್ಬನೂ ಇಲ್ಲ.</para>
  <para style="q1" vid="ISA 59:4">ವ್ಯರ್ಥತ್ವದಲ್ಲಿ ವಿಶ್ವಾಸ ಇಡುತ್ತಾರೆ. ಸುಳ್ಳನ್ನು ಮಾತನಾಡುತ್ತಾರೆ.</para>
  <para style="q2" vid="ISA 59:4">ಕೇಡನ್ನು ಗರ್ಭಧರಿಸಿ, ಅಕ್ರಮವನ್ನು ಹೆರುತ್ತಾರೆ.<verse eid="ISA 59:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 59:5"/>ಹಾವಿನಂತೆ ಮೊಟ್ಟೆಗಳನ್ನು ಮರಿಮಾಡುತ್ತಾರೆ.</para>
  <para style="q2" vid="ISA 59:5">ಜೇಡರ ಹುಳದಂತೆ ಬಲೆಯನ್ನು ನೇಯುತ್ತಾರೆ.</para>
  <para style="q1" vid="ISA 59:5">ಅದರ ಮೊಟ್ಟೆಗಳನ್ನು ತಿನ್ನುವವನು ಸಾಯುವನು.</para>
  <para style="q2" vid="ISA 59:5">ಒಡೆದುಬಿಡುವವನಿಗೆ ವಿಷದ ಮರಿ ಹೊರಡುವುದು.<verse eid="ISA 59:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 59:6"/>ಅವರ ನೂಲು ವಸ್ತ್ರಕ್ಕಾಗದು.</para>
  <para style="q2" vid="ISA 59:6">ತಮ್ಮ ಕೆಲಸಗಳಿಂದ ತಮ್ಮನ್ನು ಹೊದ್ದುಕೊಳ್ಳರು.</para>
  <para style="q1" vid="ISA 59:6">ಅವರ ಕೆಲಸಗಳು ಅಕ್ರಮದ ಕೆಲಸಗಳೇ.</para>
  <para style="q2" vid="ISA 59:6">ಅವರ ಕೈಗಳಲ್ಲಿ ಹಿಂಸೆಯ ಕ್ರಿಯೆಗಳು ಇವೆ.<verse eid="ISA 59:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 59:7"/>ಅವರ ಕಾಲುಗಳು ಪಾಪಕ್ಕೆ ಓಡುತ್ತವೆ.</para>
  <para style="q2" vid="ISA 59:7">ಅಪರಾಧವಿಲ್ಲದ ರಕ್ತವನ್ನು ಚೆಲ್ಲುವುದಕ್ಕೆ ತ್ವರೆ ಪಡುತ್ತವೆ.</para>
  <para style="q1" vid="ISA 59:7">ಅವರ ಆಲೋಚನೆಗಳು ಅಧರ್ಮದ ಆಲೋಚನೆಗಳೇ.</para>
  <para style="q2" vid="ISA 59:7">ನಷ್ಟವೂ ನಾಶವೂ ಅವರ ಮಾರ್ಗಗಳಲ್ಲಿವೆ.<verse eid="ISA 59:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 59:8"/>ಸಮಾಧಾನದ ಮಾರ್ಗವನ್ನೇ ಅವರು ಅರಿಯರು.</para>
  <para style="q2" vid="ISA 59:8">ಅವರ ದಾರಿಗಳಲ್ಲಿ ನ್ಯಾಯವಿಲ್ಲ.</para>
  <para style="q1" vid="ISA 59:8">ತಮ್ಮ ಹಾದಿಗಳನ್ನು ವಕ್ರಮಾಡಿಕೊಂಡಿದ್ದಾರೆ.</para>
  <para style="q2" vid="ISA 59:8">ಅವುಗಳಲ್ಲಿ ನಡೆಯುವವರೆಲ್ಲರೂ ಸಮಾಧಾನವನ್ನರಿಯರು.<verse eid="ISA 59:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 59:9"/>ಆದಕಾರಣ ನ್ಯಾಯ ನಿರ್ಣಯವು</para>
  <para style="q2" vid="ISA 59:9">ನಮಗೆ ದೂರವಾಗಿದೆ.</para>
  <para style="q1" vid="ISA 59:9">ನೀತಿಯು ನಮ್ಮನ್ನು ತಲುಪುವುದಿಲ್ಲ,</para>
  <para style="q2" vid="ISA 59:9">ಬೆಳಕನ್ನು ಎದುರು ನೋಡುತ್ತಿರುವ ನಮ್ಮನ್ನು ಕತ್ತಲೆಯೇ ಆವರಿಸಿದೆ;</para>
  <para style="q1" vid="ISA 59:9">ಜ್ಯೋತಿಯನ್ನು ನಿರೀಕ್ಷಿಸುತ್ತಿರುವ ನಾವು</para>
  <para style="q2" vid="ISA 59:9">ಅಂಧಕಾರದಲ್ಲಿಯೇ ನಡೆಯುತ್ತೇವೆ.<verse eid="ISA 59:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 59:10"/>ಕುರುಡರ ಹಾಗೆ ಗೋಡೆಯನ್ನು ತಡವರಿಸುತ್ತೇವೆ.</para>
  <para style="q2" vid="ISA 59:10">ಕಣ್ಣಿಲ್ಲದವರ ಹಾಗೆ ಮುಟ್ಟಿ ನೋಡುತ್ತೇವೆ.</para>
  <para style="q1" vid="ISA 59:10">ಮಧ್ಯಾಹ್ನದಲ್ಲಿ ರಾತ್ರಿಯಂತೆ ಎಡವುತ್ತೇವೆ.</para>
  <para style="q2" vid="ISA 59:10">ಸತ್ತವರ ಹಾಗೆ ಹಾಳಾದ ಸ್ಥಳಗಳಲ್ಲಿ ಇದ್ದೇವೆ.<verse eid="ISA 59:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 59:11"/>ನಾವೆಲ್ಲರೂ ಕರಡಿಗಳ ಹಾಗೆ ಗುರುಗುಟ್ಟುತ್ತೇವೆ.</para>
  <para style="q2" vid="ISA 59:11">ನಾವು ಪಾರಿವಾಳಗಳಂತೆ ದುಃಖದಿಂದ ಕೊರಗುತ್ತೇವೆ.</para>
  <para style="q1" vid="ISA 59:11">ನ್ಯಾಯಕ್ಕಾಗಿ ಕಾದುಕೊಳ್ಳುತ್ತೇವೆ. ಆದರೆ ಅದು ಸಿಕ್ಕದು,</para>
  <para style="q2" vid="ISA 59:11">ರಕ್ಷಣೆಯಾದರೋ ಅದು ನಮಗೆ ದೂರವಾಗಿದೆ.<verse eid="ISA 59:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 59:12"/>ಏಕೆಂದರೆ, ನಮ್ಮ ದ್ರೋಹಗಳು</para>
  <para style="q2" vid="ISA 59:12">ನಿನ್ನ ಮುಂದೆ ಬಹಳವಾಗಿವೆ.</para>
  <para style="q1" vid="ISA 59:12">ನಮ್ಮ ಪಾಪಗಳು ನಮಗೆ</para>
  <para style="q2" vid="ISA 59:12">ವಿರೋಧವಾಗಿ ಸಾಕ್ಷಿ ಕೊಡುತ್ತವೆ.</para>
  <para style="q1" vid="ISA 59:12">ನಮ್ಮ ದ್ರೋಹಗಳು ನಮ್ಮ ಸಂಗಡ ಇವೆ.</para>
  <para style="q2" vid="ISA 59:12">ನಮ್ಮ ಅಕ್ರಮಗಳನ್ನು ನಾವೇ ಬಲ್ಲೆವು.<verse eid="ISA 59:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="ISA 59:13"/>ದ್ರೋಹಮಾಡಿದ್ದೇವೆ, ಯೆಹೋವ ದೇವರಿಗೆ ಸುಳ್ಳಾಡಿದ್ದೇವೆ.</para>
  <para style="q2" vid="ISA 59:13">ನಮ್ಮ ದೇವರ ಕಡೆಯಿಂದ ಹಿಂದಿರುಗಿದ್ದೇವೆ.</para>
  <para style="q1" vid="ISA 59:13">ಬಲಾತ್ಕಾರದ ತಿರುಗಿ ಬೀಳುವಿಕೆಯ ಕಾರ್ಯಗಳನ್ನು ಮಾತನಾಡಿದ್ದೇವೆ.</para>
  <para style="q2" vid="ISA 59:13">ಸುಳ್ಳು ಮಾತುಗಳಿಂದ ಬಸುರಾಗಿ ಅವುಗಳನ್ನು ಹೃದಯದಿಂದ ನುಡಿದಿದ್ದೇವೆ.<verse eid="ISA 59:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="ISA 59:14"/>ನಾವು ನ್ಯಾಯವನ್ನು ಸಹ ಹಿಂದಕ್ಕೆ ತಳ್ಳಿಬಿಟ್ಟಿದ್ದೇವೆ.</para>
  <para style="q2" vid="ISA 59:14">ನೀತಿಯನ್ನು ದೂರದಲ್ಲಿ ನಿಲ್ಲಿಸಿಬಿಟ್ಟಿದ್ದೇವೆ.</para>
  <para style="q1" vid="ISA 59:14">ಸತ್ಯವು ಬೀದಿಯಲ್ಲಿ ಎಡವುತ್ತದೆ.</para>
  <para style="q2" vid="ISA 59:14">ಯಥಾರ್ಥತೆಗೆ ಪ್ರವೇಶಿಸ ಇಲ್ಲಾ.</para>
  <para style="q1" vid="ISA 59:14">ಸತ್ಯವು ಬೀದಿಯಲ್ಲಿ ಎಡವುತ್ತದೆ.</para>
  <para style="q2" vid="ISA 59:14">ಯಥಾರ್ಥತೆಯು ಪ್ರವೇಶಿಸಕೂಡದು.<verse eid="ISA 59:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="ISA 59:15"/>ಸತ್ಯವು ಇಲ್ಲವೇ ಇಲ್ಲ,</para>
  <para style="q2" vid="ISA 59:15">ಕೇಡನ್ನು ಬಿಟ್ಟವನು ಬೇಟೆಯಾಗುತ್ತಾನೆ.</para>
  <para style="b" vid="ISA 59:15"/>
  <para style="q1" vid="ISA 59:15">ಯೆಹೋವ ದೇವರು ಇದನ್ನು ನೋಡಿ</para>
  <para style="q2" vid="ISA 59:15">ನ್ಯಾಯವಿಲ್ಲವಲ್ಲಾ ಎಂದು ವ್ಯಸನಗೊಂಡನು.<verse eid="ISA 59:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="ISA 59:16"/>ಮಧ್ಯಸ್ಥಿಕನು ಒಬ್ಬನೂ ಇಲ್ಲವೆಂದು</para>
  <para style="q2" vid="ISA 59:16">ಕಂಡು ಸ್ಥಬ್ಧನಾದನು.</para>
  <para style="q1" vid="ISA 59:16">ಆದ್ದರಿಂದ ಆತನ ಸ್ವಹಸ್ತವೇ ಆತನಿಗೆ ರಕ್ಷಣೆಯ ಸಾಧನವಾಯಿತು.</para>
  <para style="q2" vid="ISA 59:16">ಆತನ ನೀತಿಯೇ ಆತನಿಗೆ ಆಧಾರವಾಯಿತು.<verse eid="ISA 59:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="ISA 59:17"/>ಅವನು ನೀತಿಯನ್ನು ಕವಚದ ಹಾಗೆ ಧರಿಸಿಕೊಂಡು,</para>
  <para style="q2" vid="ISA 59:17">ರಕ್ಷಣೆಯ ಶಿರಸ್ತ್ರಾಣವನ್ನು ತನ್ನ ತಲೆಯ ಮೇಲೆ ಇಟ್ಟುಕೊಂಡನು.</para>
  <para style="q1" vid="ISA 59:17">ಪ್ರತೀಕಾರದ ವಸ್ತ್ರಗಳನ್ನು ಹೊದಿಕೆಯಾಗಿ ಹೊದ್ದುಕೊಂಡು,</para>
  <para style="q2" vid="ISA 59:17">ಆಸಕ್ತಿಯನ್ನು ಮೇಲಂಗಿಯಾಗಿ ತೊಟ್ಟುಕೊಂಡನು.<verse eid="ISA 59:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="ISA 59:18"/>ಅವರ ಕ್ರಿಯೆಗಳ ಪ್ರಕಾರವೇ</para>
  <para style="q2" vid="ISA 59:18">ಸರಿಯಾಗಿ ಸಲ್ಲಿಸುವನು.</para>
  <para style="q1" vid="ISA 59:18">ತನ್ನ ವೈರಿಗಳಿಗೆ ಉರಿಯನ್ನೂ,</para>
  <para style="q2" vid="ISA 59:18">ತನ್ನ ಶತ್ರುಗಳಿಗೆ ಪ್ರತಿಫಲವನ್ನೂ,</para>
  <para style="q2" vid="ISA 59:18">ದ್ವೀಪಗಳಿಗೆ ಪ್ರತಿಫಲವನ್ನೂ ಸಲ್ಲಿಸುವನು.<verse eid="ISA 59:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="ISA 59:19"/>ಆಗ ಪಶ್ಚಿಮದ ಕಡೆಯವರು ಯೆಹೋವ ದೇವರ ಹೆಸರಿಗೂ,</para>
  <para style="q2" vid="ISA 59:19">ಸೂರ್ಯೋದಯದ ಕಡೆಯವರು ದೇವರ ಘನಕ್ಕೂ ಭಯಪಡುವರು.</para>
  <para style="q1" vid="ISA 59:19">ವೈರಿಯು ಪ್ರಳಯದಂತೆ ಬರುವಾಗ,</para>
  <para style="q2" vid="ISA 59:19">ಯೆಹೋವ ದೇವರ ಆತ್ಮವು ಅವನಿಗೆ ವಿರೋಧವಾಗಿ ಧ್ವಜವನ್ನೆತ್ತುವರು.<verse eid="ISA 59:19"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="20" style="v" sid="ISA 59:20"/>“ವಿಮೋಚಕನು ಚೀಯೋನಿಗೂ</para>
  <para style="q2" vid="ISA 59:20">ಯಾಕೋಬಿನಲ್ಲಿ ತಮ್ಮ ಪಾಪಗಳಿಗಾಗಿ ಪಶ್ಚಾತ್ತಾಪಪಡುವವರಿಗಾಗಿಯೂ ಬರುವನು,”</para>
  <para style="q2" vid="ISA 59:20">ಎಂದು ಯೆಹೋವ ದೇವರು ಹೇಳುತ್ತಾರೆ.<verse eid="ISA 59:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="ISA 59:21"/>ಮಾತ್ರವಲ್ಲದೆ, “ನಾನಾದರೋ ಅವರ ಸಂಗಡ ಮಾಡುವ ಒಡಂಬಡಿಕೆ ಇದೇ. ಎಂದು ಯೆಹೋವ ದೇವರು ಹೇಳುತ್ತಾರೆ. ನಿನ್ನ ಮೇಲಿರುವ ನನ್ನ ಆತ್ಮನೂ, ನಾನು ನಿನ್ನ ಬಾಯಲ್ಲಿ ಇಟ್ಟಿರುವ ನನ್ನ ವಾಕ್ಯಗಳೂ, ಇಂದಿನಿಂದ ಸದಾಕಾಲಕ್ಕೆ ನಿನ್ನ ಬಾಯಿಂದಲೂ, ನಿನ್ನ ಸಂತಾನದ ಬಾಯಿಂದಲೂ ತೊಲಗುವುದಿಲ್ಲ,” ಎಂದು ಯೆಹೋವ ದೇವರು ಹೇಳುತ್ತಾರೆ.<verse eid="ISA 59:21"/></para>
  <chapter eid="ISA 59"/>
  <chapter number="60" style="c" sid="ISA 60"/>
  <para style="s1">ಚೀಯೋನಿನ ಮಹಿಮೆ</para>
  <para style="q1">
    <verse number="1" style="v" sid="ISA 60:1"/>ಏಳು, ಪ್ರಕಾಶಿಸು. ಏಕೆಂದರೆ ನಿನ್ನ ಮೇಲೆ ಬೆಳಕು ಬಂತು,</para>
  <para style="q2" vid="ISA 60:1">ಯೆಹೋವ ದೇವರ ಮಹಿಮೆಯು ನಿನ್ನ ಮೇಲೆ ಉದಯವಾಯಿತು.<verse eid="ISA 60:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 60:2"/>ಇಗೋ, ಕತ್ತಲೆ ಭೂಮಿಯನ್ನೂ,</para>
  <para style="q2" vid="ISA 60:2">ಗಾಢಾಂಧಕಾರವು ಜನರನ್ನೂ ಮುಚ್ಚುವುದು.</para>
  <para style="q1" vid="ISA 60:2">ಆದರೆ ನಿನ್ನ ಮೇಲೆ ಯೆಹೋವ ದೇವರು ಉದಯಿಸುವರು.</para>
  <para style="q2" vid="ISA 60:2">ಆತನ ಮಹಿಮೆಯು ನಿನ್ನ ಮೇಲೆ ಕಾಣಬರುವುದು.<verse eid="ISA 60:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 60:3"/>ಇತರ ಜನಾಂಗಗಳು ನಿನ್ನ ಪ್ರಕಾಶಕ್ಕೂ,</para>
  <para style="q2" vid="ISA 60:3">ಅರಸರು ನಿನ್ನ ಉದಯದ ಕಾಂತಿಗೂ ಬರುವರು.<verse eid="ISA 60:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 60:4"/>ಸುತ್ತಲೂ ನಿನ್ನ ಕಣ್ಣುಗಳನ್ನೆತ್ತಿ ನೋಡು.</para>
  <para style="q2" vid="ISA 60:4">ಅವರೆಲ್ಲರು ಕೂಡಿಕೊಂಡು ನಿನ್ನ ಬಳಿಗೆ ಬರುತ್ತಾರೆ.</para>
  <para style="q1" vid="ISA 60:4">ನಿನ್ನ ಪುತ್ರರು ದೂರದಿಂದ ಬರುವರು,</para>
  <para style="q2" vid="ISA 60:4">ನಿನ್ನ ಪುತ್ರಿಯರು ಕಂಕುಳಿನಲ್ಲಿ ಕುಳಿತು ಬರುವರು.<verse eid="ISA 60:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 60:5"/>ನೀನು ನೋಡಿ ಕಳೆಗೊಳ್ಳುವಿ,</para>
  <para style="q2" vid="ISA 60:5">ನಿನ್ನ ಹೃದಯವು ಅದರುತ್ತಾ ಉಬ್ಬುವುದು,</para>
  <para style="q1" vid="ISA 60:5">ಏಕೆಂದರೆ ಸಮುದ್ರದ ಸಮೃದ್ಧಿಯು ನಿನ್ನ ಕಡೆಗೆ ತಿರುಗಿಕೊಳ್ಳುವುದು.</para>
  <para style="q2" vid="ISA 60:5">ಇತರ ಜನಾಂಗಗಳ ಆಸ್ತಿಯು ನಿನ್ನ ಬಳಿಗೆ ಬರುವುದು.<verse eid="ISA 60:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 60:6"/>ಒಂಟೆಗಳ ಸಮೂಹವು ನಿನ್ನ ದೇಶದಲ್ಲಿ ತುಂಬಿಕೊಳ್ಳುವುದು.</para>
  <para style="q2" vid="ISA 60:6">ಮಿದ್ಯಾನಿನ ಏಫಾದ ವೇಗವುಳ್ಳ ಒಂಟೆಗಳು</para>
  <para style="q1" vid="ISA 60:6">ಅವೆಲ್ಲಾ ಶೆಬದಿಂದಲೂ ಬರುವುವು.</para>
  <para style="q2" vid="ISA 60:6">ಬಂಗಾರವನ್ನೂ, ಧೂಪವನ್ನೂ ತರುವುವು.</para>
  <para style="q2" vid="ISA 60:6">ಯೆಹೋವ ದೇವರ ಸ್ತೋತ್ರಗಳನ್ನು ಸಾರುವುವು.<verse eid="ISA 60:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 60:7"/>ಕೇದಾರಿನ ಮಂದೆಗಳೆಲ್ಲಾ ನಿನ್ನಲ್ಲಿ ಸೇರಿಬರುವುವು.</para>
  <para style="q2" vid="ISA 60:7">ನೆಬಾಯೋತಿನ ಟಗರುಗಳು ನಿನ್ನನ್ನು ಸೇವಿಸುವುವು.</para>
  <para style="q1" vid="ISA 60:7">ನನ್ನ ಬಲಿಪೀಠದ ಮೇಲೆ ಮೆಚ್ಚಿಕೆಯಿಂದ ಏರುವುವು.</para>
  <para style="q2" vid="ISA 60:7">ನನ್ನ ಮಹಿಮೆಯ ಆಲಯವನ್ನು ಘನಪಡಿಸುವೆನು.<verse eid="ISA 60:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 60:8"/>ಮೇಘದಂತೆಯೂ, ತಮ್ಮ ಗೂಡುಗಳಿಗೆ ಹೋಗುವ</para>
  <para style="q2" vid="ISA 60:8">ಪಾರಿವಾಳಗಳಂತೆಯೂ ಹಾರುವ ಇವರು ಯಾರು?<verse eid="ISA 60:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 60:9"/>ನಿಶ್ಚಯವಾಗಿ ದ್ವೀಪಗಳು,</para>
  <para style="q2" vid="ISA 60:9">ತಾರ್ಷೀಷಿನ ಹಡಗುಗಳು ಮೊದಲಾಗಿ ನನಗೋಸ್ಕರ</para>
  <para style="q1" vid="ISA 60:9">ದೂರದಿಂದ ನಿನ್ನ ಪುತ್ರರನ್ನು ತಮ್ಮ</para>
  <para style="q2" vid="ISA 60:9">ಬೆಳ್ಳಿಬಂಗಾರದ ಸಹಿತವಾಗಿ</para>
  <para style="q2" vid="ISA 60:9">ನಿನ್ನ ದೇವರಾದ ಯೆಹೋವ ದೇವರ ಬಳಿಗೂ,</para>
  <para style="q1" vid="ISA 60:9">ನಿನ್ನನ್ನು ವೈಭವದಿಂದ ಶೃಂಗರಿಸಿರುವ</para>
  <para style="q2" vid="ISA 60:9">ಇಸ್ರಾಯೇಲಿನ ಪರಿಶುದ್ಧನ</para>
  <para style="q2" vid="ISA 60:9">ಬಳಿಗೂ ತರುವುದರಲ್ಲಿ ಮುಂದಾಗುತ್ತಿವೆ.<verse eid="ISA 60:9"/></para>
  <para style="b"/>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 60:10"/>ಇದಲ್ಲದೆ ವಿದೇಶಿಯರು ನಿನ್ನ ಗೋಡೆಗಳನ್ನು ಕಟ್ಟುವರು.</para>
  <para style="q2" vid="ISA 60:10">ಅವರ ಅರಸರು ಸಹ ನಿನಗೆ ಸೇವೆಮಾಡುವರು.</para>
  <para style="q1" vid="ISA 60:10">ಏಕೆಂದರೆ ನನ್ನ ಬೇಸರದಲ್ಲಿ ನಿನ್ನನ್ನು ಹೊಡೆದೆನು.</para>
  <para style="q2" vid="ISA 60:10">ಆದರೆ ನನ್ನ ಕಟಾಕ್ಷದಲ್ಲಿ ನಿನ್ನನ್ನು ಕರುಣಿಸುವೆನು.<verse eid="ISA 60:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 60:11"/>ಆದ್ದರಿಂದ ನಿನ್ನ ಬಾಗಿಲುಗಳು ಯಾವಾಗಲೂ ತೆರೆದಿರುವುವು.</para>
  <para style="q2" vid="ISA 60:11">ಇತರ ಜನಾಂಗಗಳ ಆಸ್ತಿ ನಿನ್ನ ಬಳಿಗೆ ತರುತ್ತಿರುವರು.</para>
  <para style="q1" vid="ISA 60:11">ಅವರ ಅರಸರು ಸಹ ಬಂಧುಗಳಾಗಿ ನಿನ್ನ ಮೆರವಣಿಗೆಯಲ್ಲಿ ಮುನ್ನಡೆಸಿದರು</para>
  <para style="q2" vid="ISA 60:11">ಹಗಲುರಾತ್ರಿ ಅವು ಮುಚ್ಚಿರುವುದಿಲ್ಲ.<verse eid="ISA 60:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 60:12"/>ನಿನ್ನನ್ನು ಸೇವಿಸದ ಜನಾಂಗವೂ, ರಾಜ್ಯವೂ ನಾಶವಾಗುವುದು.</para>
  <para style="q2" vid="ISA 60:12">ಆ ಜನಾಂಗಗಳು ಸಂಪೂರ್ಣವಾಗಿ ಹಾಳಾಗುವುವು.<verse eid="ISA 60:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="ISA 60:13"/>ಲೆಬನೋನಿನ ವೈಭವವು ತುರಾಯಿ, ಅಗಸೆ,</para>
  <para style="q2" vid="ISA 60:13">ಹೊನ್ನೆ ಮರಗಳು ಕೂಡ ನನ್ನ ಪರಿಶುದ್ಧ ಸ್ಥಳವನ್ನು</para>
  <para style="q1" vid="ISA 60:13">ಶೃಂಗರಿಸುವುದಕ್ಕೆ ನಿನ್ನ ಬಳಿಗೆ ಬರುವುವು.</para>
  <para style="q2" vid="ISA 60:13">ನನ್ನ ಪಾದಗಳ ಸ್ಥಳವನ್ನು ನಾನು ಗೌರವವುಳ್ಳದ್ದಾಗಿ ಮಾಡುವೆನು.<verse eid="ISA 60:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="ISA 60:14"/>ಆಗ ನಿನ್ನನ್ನು ಕುಗ್ಗಿಸಿದವರು, ಬಗ್ಗಿಕೊಂಡು ನಿನ್ನ ಬಳಿಗೆ ಬರುವರು.</para>
  <para style="q2" vid="ISA 60:14">ನಿನ್ನನ್ನು ಅಸಹ್ಯಿಸಿದವರೆಲ್ಲರೂ ನಿನ್ನ ಪಾದಗಳಿಗೆ ಅಡ್ಡಬಿದ್ದು,</para>
  <para style="q1" vid="ISA 60:14">ನಿನ್ನನ್ನು ಯೆಹೋವ ದೇವರ ಪಟ್ಟಣವೆಂದೂ,</para>
  <para style="q2" vid="ISA 60:14">ಇಸ್ರಾಯೇಲಿನ ಪರಿಶುದ್ಧನ ಚೀಯೋನೆಂದೂ ಕರೆಯುವರು.<verse eid="ISA 60:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="ISA 60:15"/>ನಿನ್ನೊಳಗೆ ನಿವಾಸಿಗಳು ಬಿಟ್ಟುಬಿಟ್ಟ,</para>
  <para style="q2" vid="ISA 60:15">ದ್ವೇಷಕ್ಕೀಡಾದ, ಯಾರೂ ಹಾದುಹೋಗದ ನಿನಗೆ</para>
  <para style="q1" vid="ISA 60:15">ನಾನು ನಿತ್ಯ ಘನತೆಯನ್ನು ದಯಪಾಲಿಸಿ</para>
  <para style="q2" vid="ISA 60:15">ನಿನ್ನನ್ನು ಎಲ್ಲಾ ಸಂತತಿಗಳಲ್ಲಿಯೂ ಉಲ್ಲಾಸವಾಗಿರುವಂತೆ ಮಾಡುವೆನು.<verse eid="ISA 60:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="ISA 60:16"/>ಇತರ ಜನಾಂಗಗಳವರಿಂದ ಹಾಲನ್ನು ಕುಡಿಯುವೆ.</para>
  <para style="q2" vid="ISA 60:16">ಅರಸರು ನಿನಗೆ ಹಾಲು ಕುಡಿಸುವರು.</para>
  <para style="q1" vid="ISA 60:16">ಯೆಹೋವನಾದ ನಾನೇ ನಿನ್ನ ರಕ್ಷಕನೂ,</para>
  <para style="q2" vid="ISA 60:16">ನಿನ್ನ ವಿಮೋಚಕನೂ, ಯಾಕೋಬಿನ ಪರಾಕ್ರಮಿಯೂ ಎಂದು ತಿಳಿದುಕೊಳ್ಳುವೆ.<verse eid="ISA 60:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="ISA 60:17"/>ಕಂಚಿನ ಬದಲಾಗಿ ನಿನಗೆ ಬಂಗಾರವನ್ನು ತರುವೆನು.</para>
  <para style="q2" vid="ISA 60:17">ಕಬ್ಬಿಣಕ್ಕೆ ಬದಲಾಗಿ ಬೆಳ್ಳಿಯನ್ನೂ,</para>
  <para style="q1" vid="ISA 60:17">ಮರಕ್ಕೆ ಬದಲಾಗಿ ಕಂಚನ್ನೂ,</para>
  <para style="q2" vid="ISA 60:17">ಕಲ್ಲುಗಳಿಗೆ ಬದಲಾಗಿ ಕಬ್ಬಿಣವನ್ನೂ ತರುವೆನು.</para>
  <para style="q1" vid="ISA 60:17">ಸಮಾಧಾನವನ್ನು ನಿನಗೆ ಅಧಿಪತಿಯನ್ನಾಗಿ,</para>
  <para style="q2" vid="ISA 60:17">ನೀತಿಯನ್ನು ನಿನಗೆ ಅಧಿಕಾರಿಯನ್ನಾಗಿ ಮಾಡುವೆನು.<verse eid="ISA 60:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="ISA 60:18"/>ಬಲಾತ್ಕಾರವೂ, ನಿನ್ನ ದೇಶದೊಳಗೆ ಹಾಳಾದದ್ದೂ,</para>
  <para style="q2" vid="ISA 60:18">ನಾಶವೂ, ನಿನ್ನ ಮೇರೆಗಳಲ್ಲಿ ಕೇಳಿಬರುವುದಿಲ್ಲ.</para>
  <para style="q1" vid="ISA 60:18">ನಿನ್ನ ಗೋಡೆಗಳಿಗೆ ರಕ್ಷಣೆ ಎಂದೂ,</para>
  <para style="q2" vid="ISA 60:18">ನಿನ್ನ ಬಾಗಿಲುಗಳಿಗೆ ಸ್ತೋತ್ರವೆಂದೂ ಹೆಸರಿಡುವೆ.<verse eid="ISA 60:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="ISA 60:19"/>ಇನ್ನು ಮೇಲೆ ಸೂರ್ಯನು ನಿನಗೆ ಹಗಲಿನಲ್ಲಿ ಬೆಳಕಾಗಿರುವುದಿಲ್ಲ.</para>
  <para style="q2" vid="ISA 60:19">ಚಂದ್ರನು ಪ್ರಕಾಶಕ್ಕಾಗಿ ನಿನಗೆ ಬೆಳಕು ಕೊಡುವುದಿಲ್ಲ.</para>
  <para style="q1" vid="ISA 60:19">ಆದರೆ ಯೆಹೋವ ದೇವರು ನಿನಗೆ ನಿತ್ಯವಾದ ಬೆಳಕಾಗಿರುವರು.</para>
  <para style="q2" vid="ISA 60:19">ನಿನ್ನ ದೇವರು ನಿನ್ನ ಬೆಳಗುವ ತೇಜಸ್ಸಾಗಿರುವರು.<verse eid="ISA 60:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="ISA 60:20"/>ನಿನ್ನ ಸೂರ್ಯನು ಅಸ್ತಮಿಸುವುದಿಲ್ಲ.</para>
  <para style="q2" vid="ISA 60:20">ನಿನ್ನ ಚಂದ್ರನು ಕಾಣದೆ ಹೋಗುವುದಿಲ್ಲ.</para>
  <para style="q1" vid="ISA 60:20">ಏಕೆಂದರೆ ಯೆಹೋವ ದೇವರು ನಿನಗೆ</para>
  <para style="q2" vid="ISA 60:20">ನಿತ್ಯವಾದ ಬೆಳಕಾಗಿರುವರು. ನೀನು ದುಃಖಿಸುವ ದಿನಗಳು ಸಮಾಪ್ತಿಯಾಗುವುದು.<verse eid="ISA 60:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="ISA 60:21"/>ನಿನ್ನ ಜನರೆಲ್ಲರೂ ನೀತಿವಂತರಾಗಿರುವರು.</para>
  <para style="q2" vid="ISA 60:21">ದೇಶವನ್ನು ಸದಾಕಾಲಕ್ಕೆ ಸ್ವಾಧೀನಮಾಡಿಕೊಳ್ಳುವರು.</para>
  <para style="q1" vid="ISA 60:21">ನಾನು ಮಹಿಮೆ ಹೊಂದುವುದಕ್ಕೋಸ್ಕರ</para>
  <para style="q2" vid="ISA 60:21">ನಾನು ನೆಟ್ಟ ಕೊಂಬೆಯೂ,</para>
  <para style="q2" vid="ISA 60:21">ನನ್ನ ಕೈ ಸೃಷ್ಟಿಯೂ ಆಗಿರುವರು.<verse eid="ISA 60:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="ISA 60:22"/>ಕನಿಷ್ಠನು ಸಾವಿರವಾಗುವನು,</para>
  <para style="q2" vid="ISA 60:22">ಅಲ್ಪನಿಂದ ಬಲವಾದ ಜನಾಂಗವಾಗುವುದು.</para>
  <para style="q1" vid="ISA 60:22">ಯೆಹೋವನೆಂಬ ನಾನು</para>
  <para style="q2" vid="ISA 60:22">ಕ್ಲುಪ್ತ ಕಾಲದಲ್ಲಿ ಇದನ್ನು ಬಹು ಬೇಗನೆ ಉಂಟುಮಾಡುವೆನು.<verse eid="ISA 60:22"/></para>
  <chapter eid="ISA 60"/>
  <chapter number="61" style="c" sid="ISA 61"/>
  <para style="s1">ಯೆಹೋವ ದೇವರ ದಯೆಯ ವರ್ಷ</para>
  <para style="q1">
    <verse number="1" style="v" sid="ISA 61:1"/>ಸಾರ್ವಭೌಮ ಯೆಹೋವ ದೇವರ ಆತ್ಮರು ನನ್ನ ಮೇಲೆ ಇದ್ದಾರೆ.</para>
  <para style="q2" vid="ISA 61:1">ಏಕೆಂದರೆ ಯೆಹೋವ ದೇವರು</para>
  <para style="q2" vid="ISA 61:1">ನನ್ನನ್ನು ಬಡವರಿಗೆ ಶುಭಸಂದೇಶವನ್ನು ಸಾರುವುದಕ್ಕೆ ಅಭಿಷೇಕಿಸಿದ್ದಾರೆ.</para>
  <para style="q1" vid="ISA 61:1">ಮುರಿದ ಹೃದಯಗಳನ್ನು ಕಟ್ಟುವುದಕ್ಕೂ,</para>
  <para style="q2" vid="ISA 61:1">ಬಂಧಿತರಿಗೆ ಸ್ವಾತಂತ್ರ್ಯವನ್ನು ಘೋಷಿಸಲು</para>
  <para style="q2" vid="ISA 61:1">ಮತ್ತು ಕೈದಿಗಳಿಗೆ ಕತ್ತಲೆಯಿಂದ ಬಿಡುಗಡೆ ಮಾಡಲು<verse eid="ISA 61:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 61:2"/>ಯೆಹೋವ ದೇವರ ಮೆಚ್ಚುಗೆಯ ವರ್ಷವನ್ನು ಸಾರಿ ಹೇಳುವುದಕ್ಕೂ,</para>
  <para style="q2" vid="ISA 61:2">ನಮ್ಮ ದೇವರು ಮುಯ್ಯಿಗೆ ಮುಯ್ಯಿ ಕೊಡುವ ದಿವಸವನ್ನು ಪ್ರಸಿದ್ಧ ಮಾಡುವುದಕ್ಕೂ,</para>
  <para style="q1" vid="ISA 61:2">ದುಃಖವುಳ್ಳವರೆಲ್ಲರನ್ನು ಆದರಿಸುವುದಕ್ಕೂ,<verse eid="ISA 61:2"/></para>
  <para style="q2">
    <verse number="3" style="v" sid="ISA 61:3"/>ಚೀಯೋನಿನಲ್ಲಿ ದುಃಖಿಸುವವರಿಗೆ</para>
  <para style="q1" vid="ISA 61:3">ಬೂದಿಗೆ ಬದಲಾಗಿ ಸೌಂದರ್ಯದ ಕಿರೀಟವನ್ನೂ,</para>
  <para style="q2" vid="ISA 61:3">ದುಃಖಕ್ಕೆ ಬದಲಾಗಿ ಆನಂದ ತೈಲವನ್ನೂ,</para>
  <para style="q1" vid="ISA 61:3">ಕುಂದಿದ ಆತ್ಮಕ್ಕೆ ಬದಲಾಗಿ ಸ್ತೋತ್ರ ಎಂಬ ಮೇಲಂಗಿಯನ್ನು</para>
  <para style="q2" vid="ISA 61:3">ಕೊಡುವುದಕ್ಕೂ ನನ್ನನ್ನು ನೇಮಿಸಿದ್ದಾರೆ.</para>
  <para style="q1" vid="ISA 61:3">ಆಗ ಅವರಿಗೆ ನೀತಿವೃಕ್ಷಗಳೆಂದೂ,</para>
  <para style="q2" vid="ISA 61:3">ಯೆಹೋವ ದೇವರು ತಾನು ಮಹಿಮೆ ಹೊಂದುವುದಕ್ಕೋಸ್ಕರ</para>
  <para style="q2" vid="ISA 61:3">ನೆಟ್ಟ ಗಿಡಗಳೆಂದೂ ಹೆಸರಾಗುವುದು.<verse eid="ISA 61:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 61:4"/>ಆಗ ಅವರು ಪೂರ್ವಕಾಲದ ಹಾಳು ಸ್ಥಳಗಳನ್ನು ಕಟ್ಟಿ,</para>
  <para style="q2" vid="ISA 61:4">ಮುಂಚೆ ಹಾಳುಬಿದ್ದವುಗಳನ್ನು ಎಬ್ಬಿಸುವರು.</para>
  <para style="q1" vid="ISA 61:4">ಅನೇಕ ತಲಾಂತರಗಳಿಂದ ಹಾಳಾದ ಪಟ್ಟಣಗಳನ್ನೂ,</para>
  <para style="q2" vid="ISA 61:4">ನೂತನ ಪಡಿಸುವರು.<verse eid="ISA 61:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 61:5"/>ಪರನಾಡಿನವರು ನಿಂತು ನಿಮ್ಮ ಮಂದೆಗಳನ್ನು ಮೇಯಿಸುವರು.</para>
  <para style="q2" vid="ISA 61:5">ಇತರರು ನಿಮಗೆ ನೇಗಿಲು ಹೂಡುವವರೂ, ದ್ರಾಕ್ಷಿತೋಟ ಕಾಯುವವರೂ ಆಗಿರುವರು.<verse eid="ISA 61:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 61:6"/>ಆದರೆ ನೀವು ಯೆಹೋವ ದೇವರ ಯಾಜಕರೆಂಬ ಬಿರುದನ್ನು ಹೊಂದುವಿರಿ.</para>
  <para style="q2" vid="ISA 61:6">ನಮ್ಮ ದೇವರ ಸೇವಕರೆಂದು ನಿಮಗೆ ಹೆಸರಾಗುವುದು,</para>
  <para style="q1" vid="ISA 61:6">ಜನಾಂಗಗಳ ಆಸ್ತಿಯನ್ನು ಅನುಭವಿಸುವಿರಿ.</para>
  <para style="q2" vid="ISA 61:6">ಅವರ ವೈಭವವನ್ನು ಪಡೆದು ಹೊಗಳಿಕೊಳ್ಳುವಿರಿ.<verse eid="ISA 61:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 61:7"/>ನಿಮ್ಮ ನಾಚಿಕೆಗೆ ಬದಲಾಗಿ ಮಾನವು ಎರಡರಷ್ಟಾಗುವುದು.</para>
  <para style="q2" vid="ISA 61:7">ಅವಮಾನಕ್ಕೆ ಬದಲಾಗಿ ತಮ್ಮ ಪಾಲಿನಲ್ಲಿ ಹರ್ಷಿಸುವರು.</para>
  <para style="q1" vid="ISA 61:7">ಆದ್ದರಿಂದ ತಮ್ಮ ದೇಶದಲ್ಲಿ ಎರಡರಷ್ಟು ಸ್ವಾಧೀನಮಾಡಿಕೊಳ್ಳುವರು.</para>
  <para style="q2" vid="ISA 61:7">ನಿತ್ಯವಾದ ಸಂತೋಷವು ನಿಮಗೆ ಆಗುವುದು.<verse eid="ISA 61:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 61:8"/>ಏಕೆಂದರೆ ಯೆಹೋವನಾದ ನಾನು ನ್ಯಾಯವನ್ನು ಪ್ರೀತಿಮಾಡುತ್ತೇನೆ.</para>
  <para style="q2" vid="ISA 61:8">ಸುಲಿಗೆಯನ್ನೂ ಅನ್ಯಾಯವನ್ನೂ ಹಗೆಮಾಡುತ್ತೇನೆ.</para>
  <para style="q1" vid="ISA 61:8">ನನ್ನ ನಿಷ್ಠೆಯಲ್ಲಿ ನಾನು ನನ್ನ ಜನರಿಗೆ ಪ್ರತಿಫಲ ನೀಡುತ್ತೇನೆ</para>
  <para style="q2" vid="ISA 61:8">ಮತ್ತು ಅವರೊಂದಿಗೆ ಶಾಶ್ವತವಾದ ಒಡಂಬಡಿಕೆಯನ್ನು ಮಾಡಿಕೊಳ್ಳುತ್ತೇನೆ.<verse eid="ISA 61:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 61:9"/>ಆಗ ಅವರ ಸಂತಾನವು ಇತರ ಜನಾಂಗಗಳಲ್ಲಿ ಪ್ರಸಿದ್ಧವಾಗುವುದು.</para>
  <para style="q2" vid="ISA 61:9">ಅವರಿಂದಾದ ಉತ್ಪತ್ತಿ ಜನರ ಮಧ್ಯದಲ್ಲಿ ತಿಳಿಸಲಾಗುವುದು.</para>
  <para style="q1" vid="ISA 61:9">ಅವರನ್ನು ನೋಡುವವರೆಲ್ಲರೂ,</para>
  <para style="q2" vid="ISA 61:9">ಅವರೇ ಯೆಹೋವ ದೇವರು ಆಶೀರ್ವದಿಸಿದ ಸಂತಾನ ಎಂದು ಒಪ್ಪಿಕೊಳ್ಳುವರು.<verse eid="ISA 61:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 61:10"/>ನಾನು ಯೆಹೋವ ದೇವರಲ್ಲಿ ಬಹಳವಾಗಿ ಸಂತೋಷಿಸುವೆನು.</para>
  <para style="q2" vid="ISA 61:10">ನನ್ನ ಪ್ರಾಣವು ನನ್ನ ದೇವರಲ್ಲಿ ಉಲ್ಲಾಸಪಡುವುದು.</para>
  <para style="q1" vid="ISA 61:10">ವರನು ಸೌಂದರ್ಯವಾಗಿ ತನ್ನನ್ನು ಶೃಂಗರಿಸುವ ಹಾಗೆಯೂ,</para>
  <para style="q2" vid="ISA 61:10">ವಧುವು ಆಭರಣಗಳಿಂದ ತನ್ನನ್ನು ಅಲಂಕರಿಸುವ ಹಾಗೆಯೂ,</para>
  <para style="q1" vid="ISA 61:10">ಅವನು ರಕ್ಷಣೆಯ ವಸ್ತ್ರಗಳನ್ನು ನನಗೆ ತೊಡಿಸಿದ್ದಾನೆ.</para>
  <para style="q2" vid="ISA 61:10">ನೀತಿಯ ನಿಲುವಂಗಿಯನ್ನು ನನಗೆ ಧರಿಸುವಂತೆ ಮಾಡಿದ್ದಾನೆ.<verse eid="ISA 61:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 61:11"/>ಏಕೆಂದರೆ ಭೂಮಿಯು ತನ್ನ ಮೊಳಕೆಯನ್ನು ಹೇಗೆ ಹೊರಡಿಸುವುದೋ,</para>
  <para style="q2" vid="ISA 61:11">ತೋಟವು ತನ್ನಲ್ಲಿ ಬಿತ್ತಿದ್ದನ್ನು ಹೇಗೆ ಮೊಳೆಯಿಸುವುದೋ,</para>
  <para style="q1" vid="ISA 61:11">ಹಾಗೆಯೇ ಸಾರ್ವಭೌಮ ಯೆಹೋವ ದೇವರು ನೀತಿಯನ್ನೂ,</para>
  <para style="q2" vid="ISA 61:11">ಸ್ತೋತ್ರವನ್ನೂ ಎಲ್ಲಾ ಜನಾಂಗಗಳ ಮುಂದೆ ಮೊಳೆಯಿಸುವರು.<verse eid="ISA 61:11"/></para>
  <chapter eid="ISA 61"/>
  <chapter number="62" style="c" sid="ISA 62"/>
  <para style="s1">ಚೀಯೋನಿಗೆ ಹೊಸ ಹೆಸರು</para>
  <para style="q1">
    <verse number="1" style="v" sid="ISA 62:1"/>ಚೀಯೋನಿಗೋಸ್ಕರ ನಾನು ಮೌನವಾಗಿರುವುದಿಲ್ಲ!</para>
  <para style="q2" vid="ISA 62:1">ಯೆರೂಸಲೇಮಿಗೋಸ್ಕರ ಅದರ ವಿಮೋಚನೆಯು ಪ್ರಕಾಶದಂತೆಯೂ,</para>
  <para style="q1" vid="ISA 62:1">ಅದರ ರಕ್ಷಣೆಯು ಉರಿಯುವ ದೀವಿಟಿಗೆಯಂತೆಯೂ</para>
  <para style="q2" vid="ISA 62:1">ಹೊರಡುವವರೆಗೆ ನಾನು ವಿಶ್ರಾಂತಿಯಿಂದ ಇರುವುದಿಲ್ಲ.<verse eid="ISA 62:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 62:2"/>ಆಗ ಇತರ ಜನಾಂಗಗಳು ನಿನ್ನ ವಿಮೋಚನೆಯನ್ನೂ,</para>
  <para style="q2" vid="ISA 62:2">ಅರಸರೆಲ್ಲರು ನಿನ್ನ ಮಹಿಮೆಯನ್ನೂ ನೋಡುವರು.</para>
  <para style="q1" vid="ISA 62:2">ಯೆಹೋವ ದೇವರ ಬಾಯಿ ನೇಮಿಸುವ</para>
  <para style="q2" vid="ISA 62:2">ಹೊಸ ಹೆಸರು ನಿನಗೆ ದೊರೆಯುವುದು.<verse eid="ISA 62:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 62:3"/>ಯೆಹೋವ ದೇವರ ಕೈಯಲ್ಲಿ ಮಹಿಮೆಯ ಕಿರೀಟವಾಗಿಯೂ,</para>
  <para style="q2" vid="ISA 62:3">ನಿನ್ನ ದೇವರ ಅಂಗೈಯಲ್ಲಿ ರಾಜ ಮುಕುಟವಾಗಿಯೂ ಇರುವೆ.<verse eid="ISA 62:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 62:4"/>ಇನ್ನು ಮೇಲೆ ನೀನು ಗಂಡಬಿಟ್ಟವಳೆಂದು ಎನಿಸಿಕೊಳ್ಳುವುದಿಲ್ಲ</para>
  <para style="q2" vid="ISA 62:4">ನಿನ್ನ ದೇಶಕ್ಕೆ ಹಾಳಾದದ್ದು ಎಂಬ ಹೆಸರೂ ಇರುವುದಿಲ್ಲ.</para>
  <para style="q1" vid="ISA 62:4">ಆದರೆ ನೀನು ಹೆಪ್ಸಿಬಾ<note caller="+" style="f"><char style="fr" closed="false">62:4 </char><char style="fq" closed="false">ಹೆಪ್ಸಿಬಾ </char><char style="ft" closed="false">ಅಂದರೆ </char><char style="fqa" closed="false">ಮೆಚ್ಚಿದವಳು</char></note> ಎಂದೂ</para>
  <para style="q2" vid="ISA 62:4">ನಿನ್ನ ದೇಶಕ್ಕೆ ಬ್ಯೂಲಾ<note caller="+" style="f"><char style="fr" closed="false">62:4 </char><char style="fq" closed="false">ಬ್ಯೂಲಾ </char><char style="ft" closed="false">ಅಂದರೆ </char><char style="fqa" closed="false">ವಿವಾಹಿತೆ</char></note> ಎಂದೂ ಹೆಸರಾಗುವುದು.</para>
  <para style="q1" vid="ISA 62:4">ಏಕೆಂದರೆ ಯೆಹೋವ ದೇವರು ನಿನ್ನನ್ನು ಮೆಚ್ಚುವರು,</para>
  <para style="q2" vid="ISA 62:4">ನಿನ್ನ ದೇಶಕ್ಕೆ ವಿವಾಹವಾಗುವುದು.<verse eid="ISA 62:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 62:5"/>ಯುವಕನು ಕನ್ಯೆ ಯುವತಿಯನ್ನು ವರಿಸುವಂತೆ,</para>
  <para style="q2" vid="ISA 62:5">ನಿನ್ನ ಜನರು ದೇಶವನ್ನು ಸ್ವಾಧೀನಪಡಿಸಿಕೊಳ್ಳುವರು.</para>
  <para style="q1" vid="ISA 62:5">ವರನು ವಧುವಿನ ಮೇಲೆ ಆನಂದ ಪಡುವ ಪ್ರಕಾರ,</para>
  <para style="q2" vid="ISA 62:5">ನಿನ್ನ ದೇವರು ನಿನ್ನ ಮೇಲೆ ಆನಂದಿಸುವರು.<verse eid="ISA 62:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 62:6"/>ಯೆರೂಸಲೇಮೇ, ನಿನ್ನ ಗೋಡೆಗಳ ಮೇಲೆ ಕಾವಲುಗಾರರನ್ನು ನೇಮಿಸಿದ್ದೇನೆ.</para>
  <para style="q2" vid="ISA 62:6">ಅವರು ಹಗಲಿರುಳು ಮೌನವಾಗಿರುವುದೇ ಇಲ್ಲ.</para>
  <para style="q1" vid="ISA 62:6">ಯೆಹೋವ ದೇವರಿಗೆ ಜ್ಞಾಪಕಪಡಿಸುವವರೇ,</para>
  <para style="q2" vid="ISA 62:6">ನೀವೂ ಸುಮ್ಮನಿರಬೇಡಿರಿ.<verse eid="ISA 62:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 62:7"/>ಯೆರೂಸಲೇಮನ್ನು ಸ್ಥಾಪಿಸಿ,</para>
  <para style="q2" vid="ISA 62:7">ಲೋಕಪ್ರಸಿದ್ಧಿಗೆ ತರುವ ತನಕ ಆತನಿಗೂ ವಿಶ್ರಾಂತಿ ಕೊಡಬೇಡಿರಿ.<verse eid="ISA 62:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 62:8"/>ಯೆಹೋವ ದೇವರು ತನ್ನ ಬಲಗೈಯಿಂದಲೂ,</para>
  <para style="q2" vid="ISA 62:8">ತನ್ನ ಬಲವುಳ್ಳ ತೋಳಿನಿಂದಲೂ ಆಣೆಯಿಟ್ಟು ಹೇಳಿದ್ದೇನೆಂದರೆ:</para>
  <para style="q1" vid="ISA 62:8">“ನಿಶ್ಚಯವಾಗಿ ನಾನು ಇನ್ನು ಮೇಲೆ ನಿನ್ನ ಧಾನ್ಯಗಳನ್ನು</para>
  <para style="q2" vid="ISA 62:8">ನಿನ್ನ ಶತ್ರುಗಳಿಗೆ ಆಹಾರವಾಗಿ ಕೊಡುವುದಿಲ್ಲ.</para>
  <para style="q1" vid="ISA 62:8">ನೀನು ಕಷ್ಟಪಟ್ಟು ಮಾಡಿದ ನಿನ್ನ ದ್ರಾಕ್ಷಾರಸವನ್ನು</para>
  <para style="q2" vid="ISA 62:8">ವಿದೇಶಿಯರು ಕುಡಿಯುವುದಿಲ್ಲ.<verse eid="ISA 62:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 62:9"/>ನಿನ್ನ ಬೆಳೆಯನ್ನು ಕೊಯ್ದು ಕುಪ್ಪೆ ಹಾಕಿದವರೇ,</para>
  <para style="q2" vid="ISA 62:9">ಅದನ್ನು ಉಂಡು ಯೆಹೋವ ದೇವರನ್ನು ಸ್ತುತಿಸುವರು.</para>
  <para style="q1" vid="ISA 62:9">ನಿನ್ನ ದ್ರಾಕ್ಷಿಯನ್ನು ಕಿತ್ತು ತಂದವರೇ ಅದರ ರಸವನ್ನು ನನ್ನ</para>
  <para style="q2" vid="ISA 62:9">ಪವಿತ್ರಾಲಯದ ಪ್ರಾಕಾರಗಳಲ್ಲಿ ಕುಡಿಯುವರು.”<verse eid="ISA 62:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 62:10"/>ಹಾದುಹೋಗಿರಿ, ಬಾಗಿಲುಗಳಲ್ಲಿ ಹಾದುಹೋಗಿರಿ,</para>
  <para style="q2" vid="ISA 62:10">ಜನರಿಗೆ ದಾರಿಯನ್ನು ಸಿದ್ಧಮಾಡಿರಿ, ಎತ್ತರಿಸಿರಿ,</para>
  <para style="q1" vid="ISA 62:10">ರಾಜಮಾರ್ಗವನ್ನು ಎತ್ತರಿಸಿ, ಕಲ್ಲುಗಳನ್ನು ಆಯ್ದು ಕೂಡಿಸಿರಿ.</para>
  <para style="q2" vid="ISA 62:10">ಜನಾಂಗಗಳಿಗೋಸ್ಕರ ಧ್ವಜವನ್ನು ಎತ್ತಿರಿ.<verse eid="ISA 62:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 62:11"/>ಇಗೋ, ಯೆಹೋವ ದೇವರು ಭೂಮಿಯ</para>
  <para style="q2" vid="ISA 62:11">ಅಂತ್ಯದವರೆಗೆ ಹೀಗೆ ಘೋಷಣೆ ಮಾಡಿದ್ದಾರೆ:</para>
  <para style="q1" vid="ISA 62:11">“ಚೀಯೋನಿನ ಪುತ್ರಿ ಇಗೋ,</para>
  <para style="q2" vid="ISA 62:11">‘ನಿನ್ನ ರಕ್ಷಣೆಯು ಬರುತ್ತದೆ.</para>
  <para style="q1" vid="ISA 62:11">ಆತನ ಬಹುಮಾನವು ಆತನ ಸಂಗಡ,</para>
  <para style="q2" vid="ISA 62:11">ಆತನ ಪ್ರತಿಫಲವು ಆತನ ಮುಂದೆಯೂ ಇದೆ ಎಂದು ಹೇಳಿರಿ.’ ”<verse eid="ISA 62:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 62:12"/>ಆಗ ಅವರು, ಪರಿಶುದ್ಧ ಜನರೂ,</para>
  <para style="q2" vid="ISA 62:12">ಯೆಹೋವ ದೇವರು ವಿಮೋಚಿಸಿದವರೂ ಎಂದು ಎನಿಸಿಕೊಳ್ಳುವರು</para>
  <para style="q1" vid="ISA 62:12">ನಿನಗೆ ಹುಡುಕಿದ ಹಾಗೂ</para>
  <para style="q2" vid="ISA 62:12">ಕೈ ಬಿಡದ ಪಟ್ಟಣ, ಎಂದು ಹೆಸರು ಬರುವುದು.<verse eid="ISA 62:12"/></para>
  <chapter eid="ISA 62"/>
  <chapter number="63" style="c" sid="ISA 63"/>
  <para style="s1">ದೇವರ ಕೋಪದ ಹಾಗು ವಿಮೋಚನೆಯ ದಿನ</para>
  <para style="q1">
    <verse number="1" style="v" sid="ISA 63:1"/>ಎದೋಮಿನಿಂದಲೂ ರಕ್ತಾಂಬರ ಧರಿಸಿಕೊಂಡು</para>
  <para style="q2" vid="ISA 63:1">ಬೊಚ್ರದಿಂದಲೂ ಬರುವ ಇವನ್ಯಾರು?</para>
  <para style="q1" vid="ISA 63:1">ಪ್ರಭೆಯುಳ್ಳ ವಸ್ತ್ರವನ್ನು ತೊಟ್ಟುಕೊಂಡವನಾಗಿ,</para>
  <para style="q2" vid="ISA 63:1">ತನ್ನ ಮಹಾ ಪರಾಕ್ರಮದಲ್ಲಿ ಸಂಚಾರ ಮಾಡುವ ಇವನ್ಯಾರು?</para>
  <para style="b" vid="ISA 63:1"/>
  <para style="q1" vid="ISA 63:1">“ನೀತಿಯನ್ನು ಘೋಷಿಸುವವನೂ,</para>
  <para style="q2" vid="ISA 63:1">ರಕ್ಷಿಸಲು ಬಲಿಷ್ಠನೂ ನಾನೇ.”<verse eid="ISA 63:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 63:2"/>ನಿನ್ನ ವಸ್ತ್ರಗಳು ಏಕೆ ಕೆಂಪಾದವು?</para>
  <para style="q2" vid="ISA 63:2">ನಿನ್ನ ಬಟ್ಟೆಗಳು ಏಕೆ ದ್ರಾಕ್ಷಿಯನ್ನು ತುಳಿಯುವವನ ಹಾಗಿವೆ?<verse eid="ISA 63:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 63:3"/>“ದ್ರಾಕ್ಷಿಯನ್ನು ತೊಟ್ಟಿಯಲ್ಲಿ ನಾನೊಬ್ಬನೇ ತುಳಿದಿದ್ದೇನೆ.</para>
  <para style="q2" vid="ISA 63:3">ಜನಾಂಗಗಳಲ್ಲಿ ಒಬ್ಬನಾದರೂ ನನ್ನ ಸಂಗಡ ಇರಲಿಲ್ಲ.</para>
  <para style="q1" vid="ISA 63:3">ನನ್ನ ಕೋಪದಲ್ಲಿ ಅವರನ್ನು ತುಳಿದಿದ್ದೇನೆ,</para>
  <para style="q2" vid="ISA 63:3">ನನ್ನ ಉರಿಯಲ್ಲಿ ಅವರನ್ನು ಜಜ್ಜಿದ್ದೇನೆ.</para>
  <para style="q1" vid="ISA 63:3">ಆದ್ದರಿಂದ ಅವರ ರಕ್ತವು ನನ್ನ ಬಟ್ಟೆಗಳ ಮೇಲೆ ಸಿಡಿದು,</para>
  <para style="q2" vid="ISA 63:3">ನನ್ನ ವಸ್ತ್ರಕ್ಕೆ ಮೆತ್ತಿಕೊಂಡಿದೆ;<verse eid="ISA 63:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 63:4"/>ಏಕೆಂದರೆ ಮುಯ್ಯಿಗೆ ಮುಯ್ಯಿ ತೀರಿಸುವ ದಿವಸವು ನನ್ನ ಹೃದಯದಲ್ಲಿದೆ.</para>
  <para style="q2" vid="ISA 63:4">ನಾನು ವಿಮೋಚಿಸಿದವರ ವರುಷವು ಬಂತು.<verse eid="ISA 63:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 63:5"/>ನಾನು ನೋಡಲು ಸಹಾಯಕರು ಯಾರೂ ಇರಲಿಲ್ಲ,</para>
  <para style="q2" vid="ISA 63:5">ಉದ್ಧಾರ ಮಾಡುವವನು ಇಲ್ಲದ್ದರಿಂದ ಆಶ್ಚರ್ಯಪಟ್ಟೆನು.</para>
  <para style="q1" vid="ISA 63:5">ಆಗ ನನ್ನ ಸ್ವಂತ ಬಾಹುವು ನನಗೆ ರಕ್ಷಣೆಯನ್ನು ಉಂಟುಮಾಡಿತು.</para>
  <para style="q2" vid="ISA 63:5">ನನ್ನ ಕೋಪವೇ ನನಗೆ ಆಧಾರವಾಯಿತು.<verse eid="ISA 63:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 63:6"/>ನನ್ನ ಕೋಪದಲ್ಲಿ ಜನಾಂಗಗಳನ್ನು ತುಳಿದುಬಿಟ್ಟೆನು.</para>
  <para style="q2" vid="ISA 63:6">ನನ್ನ ಉರಿಯಲ್ಲಿ ಅವರನ್ನು ಕುಡಿಯುವಂತೆ ಮಾಡಿದೆನು.</para>
  <para style="q2" vid="ISA 63:6">ಅವರ ರಕ್ತವನ್ನು ಭೂಮಿಗೆ ಸುರಿಸಿದೆನು.”<verse eid="ISA 63:6"/></para>
  <para style="s1">ಸ್ತುತಿ ಮತ್ತು ಪ್ರಾರ್ಥನೆ</para>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 63:7"/>ಯೆಹೋವ ದೇವರು ನಮಗೆ ಮಾಡಿದ್ದೆಲ್ಲದರ ಪ್ರಕಾರ,</para>
  <para style="q2" vid="ISA 63:7">ಯೆಹೋವ ದೇವರ ಪ್ರೀತಿ ಕೃಪೆಗಳನ್ನೂ,</para>
  <para style="q2" vid="ISA 63:7">ಯೆಹೋವ ದೇವರ ಕಾರ್ಯಗಳನ್ನು ಸ್ತೋತ್ರಗಳನ್ನೂ ಜ್ಞಾಪಕಪಡಿಸುವೆನು.</para>
  <para style="q1" vid="ISA 63:7">ಆತನು ತನ್ನ ಅಂತಃಕರುಣೆಯ ಪ್ರಕಾರವೂ,</para>
  <para style="q2" vid="ISA 63:7">ತನ್ನ ಕೃಪೆಯ ಮಹಾ ಒಳ್ಳೆಯತನದ ಪ್ರಕಾರವೂ,</para>
  <para style="q2" vid="ISA 63:7">ಇಸ್ರಾಯೇಲಿನ ಮನೆಯವರಿಗೆ ದೊಡ್ಡ ಉಪಕಾರ ಮಾಡಿದನಲ್ಲಾ.<verse eid="ISA 63:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 63:8"/>ಆತನು ನಿಶ್ಚಯವಾಗಿ, “ಅವರು ನನ್ನ ಜನರೇ,</para>
  <para style="q2" vid="ISA 63:8">ಸುಳ್ಳಾಡದ ಮಕ್ಕಳೇ!” ಎಂದು ಹೇಳಿದನು.</para>
  <para style="q2" vid="ISA 63:8">ಆದ್ದರಿಂದ ಅವರಿಗೆ ರಕ್ಷಕನಾಗಿದ್ದನು.<verse eid="ISA 63:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 63:9"/>ಅವರಿಗೆ ಬಂದ ಎಲ್ಲಾ ಇಕ್ಕಟ್ಟಿನಲ್ಲಿ ಆತನಿಗೆ ಇಕ್ಕಟ್ಟಾಯಿತು.</para>
  <para style="q2" vid="ISA 63:9">ಆತನ ಸಮ್ಮುಖದ ದೂತನು ಅವರನ್ನು ರಕ್ಷಿಸಿದನು.</para>
  <para style="q1" vid="ISA 63:9">ತನ್ನ ಪ್ರೀತಿಯಲ್ಲಿಯೂ, ತನ್ನ ಕನಿಕರದಲ್ಲಿಯೂ</para>
  <para style="q2" vid="ISA 63:9">ಆತನೇ ಅವರನ್ನು ವಿಮೋಚಿಸಿದನು.</para>
  <para style="q2" vid="ISA 63:9">ಪೂರ್ವಕಾಲದ ದಿವಸಗಳಲ್ಲೆಲ್ಲಾ ಅವರನ್ನು ಎತ್ತಿಕೊಂಡು ಹೊತ್ತುಕೊಂಡನು.<verse eid="ISA 63:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 63:10"/>ಆದರೆ ಅವರು ತಿರುಗಿಬಿದ್ದು,</para>
  <para style="q2" vid="ISA 63:10">ಆತನ ಪರಿಶುದ್ಧಾತ್ಮನನ್ನು ದುಃಖಪಡಿಸಿದರು.</para>
  <para style="q1" vid="ISA 63:10">ಆದ್ದರಿಂದ ಆತನು ಬೇರೆಯಾಗಿ ಅವರಿಗೆ ಶತ್ರುವಾದನು.</para>
  <para style="q2" vid="ISA 63:10">ಆತನೇ ಅವರಿಗೆ ವಿರೋಧವಾಗಿ ಯುದ್ಧಮಾಡಿದನು.<verse eid="ISA 63:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 63:11"/>ಆಗ ಆತನು ಪೂರ್ವಕಾಲದ ದಿವಸಗಳನ್ನೂ,</para>
  <para style="q2" vid="ISA 63:11">ಮೋಶೆಯನ್ನೂ, ಅವನ ಜನರನ್ನೂ ಜ್ಞಾಪಕಮಾಡಿಕೊಂಡು</para>
  <para style="q1" vid="ISA 63:11">“ಅವರನ್ನು ತನ್ನ ಮಂದೆಯ ಕುರುಬನ ಸಂಗಡ</para>
  <para style="q2" vid="ISA 63:11">ಸಮುದ್ರದೊಳಗಿಂದ ಸುರಕ್ಷಿತವಾಗಿ ಮೇಲಕ್ಕೆ ಬರಮಾಡಿದವನು ಎಲ್ಲಿ?</para>
  <para style="q1" vid="ISA 63:11">ಅವರ ಮಧ್ಯದಲ್ಲಿ ತನ್ನ</para>
  <para style="q2" vid="ISA 63:11">ಪರಿಶುದ್ಧಾತ್ಮನನ್ನು ಇಟ್ಟವನು ಎಲ್ಲಿ?<verse eid="ISA 63:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 63:12"/>ಮೋಶೆಯ ಬಲಗೈಯ ಮುಖಾಂತರ ತನ್ನ</para>
  <para style="q2" vid="ISA 63:12">ಬಲವಾದ ಮಹಿಮೆಯುಳ್ಳ ತೋಳಿನಿಂದ ಅವರನ್ನು ನಡೆಸಿದವನೂ,</para>
  <para style="q1" vid="ISA 63:12">ತನಗೆ ನಿತ್ಯವಾದ ಹೆಸರನ್ನು ಉಂಟುಮಾಡುವ ಹಾಗೆ</para>
  <para style="q2" vid="ISA 63:12">ಅವರ ಮುಂದೆ ಜನರಾಶಿಯನ್ನೂ ಇಬ್ಬಾಗಿಸಿದವನು ಎಲ್ಲಿ?<verse eid="ISA 63:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="ISA 63:13"/>ಅಡವಿಯಲ್ಲಿ ಕುದುರೆಯಂತೆ ಅಗಾಧಗಳಲ್ಲಿ</para>
  <para style="q2" vid="ISA 63:13">ಅವರನ್ನು ಎಡವದ ಹಾಗೆ ನಡೆಸಿದವನು ಎಲ್ಲಿ?”<verse eid="ISA 63:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="ISA 63:14"/>ಪಶುವು ತಗ್ಗಿಗೆ ಇಳಿಯುವ ಪ್ರಕಾರ,</para>
  <para style="q2" vid="ISA 63:14">ಯೆಹೋವ ದೇವರ ಆತ್ಮರು ಅವರಿಗೆ ವಿಶ್ರಾಂತಿಯನ್ನು ಕೊಟ್ಟರು.</para>
  <para style="q1" vid="ISA 63:14">ಈ ಪ್ರಕಾರ ನೀವು ನಿಮಗೆ ಮಹಿಮೆಯುಳ್ಳ ಹೆಸರನ್ನು</para>
  <para style="q2" vid="ISA 63:14">ಉಂಟುಮಾಡುವುದಕ್ಕಾಗಿ, ನಿಮ್ಮ ಜನರನ್ನು ನಡಿಸಿದಿರಿ.<verse eid="ISA 63:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="ISA 63:15"/>ಆಕಾಶದಿಂದ ಕೆಳಗೆ ನೋಡಿರಿ,</para>
  <para style="q2" vid="ISA 63:15">ನಿಮ್ಮ ಪವಿತ್ರವೂ ಮಹಿಮೆಯೂ ಆದ ನಿಮ್ಮ ಸಿಂಹಾಸನದಿಂದ ದೃಷ್ಟಿಸಿ ನೋಡಿರಿ.</para>
  <para style="q1" vid="ISA 63:15">ನಿಮ್ಮ ಆಸಕ್ತಿಯೂ, ನಿಮ್ಮ ಪರಾಕ್ರಮವೂ, ನಿಮ್ಮ ಹೃದಯದ ಘೋಷವೂ,</para>
  <para style="q2" vid="ISA 63:15">ನಮ್ಮ ವಿಷಯವಾದ ನಿಮ್ಮ ಕರುಣೆ ಕನಿಕರಗಳೂ ಎಲ್ಲಿ? ಬಿಗಿಹಿಡಿದುಕೊಂಡಿದ್ದೀರೋ?<verse eid="ISA 63:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="ISA 63:16"/>ಅಬ್ರಹಾಮನು ನಮ್ಮನ್ನು ತಿಳಿಯದಿದ್ದರೂ,</para>
  <para style="q2" vid="ISA 63:16">ಇಸ್ರಾಯೇಲನು ನಮ್ಮನ್ನು ಗುರುತಿಸದಿದ್ದರೂ</para>
  <para style="q1" vid="ISA 63:16">ಯೆಹೋವ ದೇವರಾದ ನೀವೇ ನಮ್ಮ ತಂದೆಯೂ,</para>
  <para style="q2" vid="ISA 63:16">ನಮ್ಮ ವಿಮೋಚಕರೂ ಆಗಿದ್ದೀರಿ. ನಿಮ್ಮ ಹೆಸರು ಸದಾಕಾಲವೂ ಇದೆ<verse eid="ISA 63:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="ISA 63:17"/>ಯೆಹೋವ ದೇವರೇ, ಏಕೆ ನಮ್ಮನ್ನು</para>
  <para style="q2" vid="ISA 63:17">ನಿಮ್ಮ ಮಾರ್ಗಗಳಿಂದ ತಪ್ಪಿಹೋಗುವಂತೆ ಅನುಮತಿಸಿದ್ದೀರಿ?</para>
  <para style="q1" vid="ISA 63:17">ಏಕೆ ನಮ್ಮ ಹೃದಯವನ್ನು ನಿಮಗೆ ಭಯಪಡದ ಹಾಗೆ ಕಠಿಣ ಮಾಡಿದ್ದೀರಿ?</para>
  <para style="q2" vid="ISA 63:17">ನಿಮ್ಮ ಸೇವಕರಿಗೋಸ್ಕರವೂ,</para>
  <para style="q2" vid="ISA 63:17">ನಿಮ್ಮ ಬಾಧ್ಯರಾಗಿರುವ ಗೋತ್ರಗಳ ನಿಮಿತ್ತ ನೀವು ಹಿಂದಿರುಗಿರಿ.<verse eid="ISA 63:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="ISA 63:18"/>ಸ್ವಲ್ಪಕಾಲ ಮಾತ್ರ ನಿಮ್ಮ ಪರಿಶುದ್ಧ ಜನರು ಅದನ್ನು ಸ್ವಾಧೀನಮಾಡಿಕೊಂಡರು.</para>
  <para style="q2" vid="ISA 63:18">ನಮ್ಮ ಶತ್ರುಗಳು ನಿಮ್ಮ ಪವಿತ್ರಾಲಯವನ್ನು ತುಳಿದುಬಿಟ್ಟಿದ್ದಾರೆ.<verse eid="ISA 63:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="ISA 63:19"/>ನಾವು ಆದಿಯಿಂದಲೂ ನಿಮ್ಮವರಾಗಿದ್ದೇವೆ.</para>
  <para style="q2" vid="ISA 63:19">ಅವರ ಮೇಲೆ ನೀವು ದೊರೆತನ ಮಾಡಲಿಲ್ಲ.</para>
  <para style="q2" vid="ISA 63:19">ಅವರು ನಿಮ್ಮ ಹೆಸರನ್ನು ಧರಿಸಲೂ ಇಲ್ಲ.<verse eid="ISA 63:19"/></para>
  <para style="b"/>
  <para style="b"/>
  <chapter eid="ISA 63"/>
  <chapter number="64" style="c" sid="ISA 64"/>
  <para style="q1">
    <verse number="1" style="v" sid="ISA 64:1"/>ಆಹಾ, ಆಕಾಶಗಳನ್ನು ಹರಿದುಬಿಟ್ಟು ಇಳಿದು ಬಾ!</para>
  <para style="q2" vid="ISA 64:1">ನಿಮ್ಮ ದರ್ಶನವನ್ನು ಕಂಡು ಪರ್ವತಗಳು ಗಡಗಡನೆ ನಡುಗುವಂತೆಯೂ,<verse eid="ISA 64:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 64:2"/>ಬೆಂಕಿ ಕಟ್ಟಿಗೆಯನ್ನು ಹೊತ್ತಿಸುವಂತೆಯೂ,</para>
  <para style="q2" vid="ISA 64:2">ಬೆಂಕಿ ನೀರನ್ನು ಉಕ್ಕಿಸುವಂತೆಯೂ,</para>
  <para style="q1" vid="ISA 64:2">ನೀನು ಇಳಿದುಬಂದು ನಿನ್ನ ಹೆಸರನ್ನು ನಿನ್ನ ವೈರಿಗಳಿಗೆ</para>
  <para style="q2" vid="ISA 64:2">ತಿಳಿಯುವಂತೆ ಮಾಡು!<verse eid="ISA 64:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 64:3"/>ನಾವು ಎದುರು ನೋಡದೆ ಇದ್ದ ಭಯಂಕರವಾದವುಗಳನ್ನು ನೀನು ಮಾಡಿದಾಗ ಇಳಿದು ಬಂದೆ,</para>
  <para style="q2" vid="ISA 64:3">ಬೆಟ್ಟಗಳು ನಿನ್ನ ಸಮ್ಮುಖಕ್ಕೆ ಕರಗಿ ಹೋದವು.<verse eid="ISA 64:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 64:4"/>ದೇವರೇ, ನಿನಗೋಸ್ಕರ ಕಾದುಕೊಳ್ಳುವವರಿಗೆ ನೀನು ಮಾಡುವುದನ್ನು</para>
  <para style="q2" vid="ISA 64:4">ಲೋಕದ ಉತ್ಪತ್ತಿಗೆ ಮುಂಚೆ ದೇವರೇ ನಿನ್ನ ಹೊರತಾಗಿ ಯಾರೂ ಕೇಳಲಿಲ್ಲ.</para>
  <para style="q1" vid="ISA 64:4">ಯಾರ ಕಿವಿಯೂ ಕೇಳಲಿಲ್ಲ.</para>
  <para style="q2" vid="ISA 64:4">ಯಾರ ಕಣ್ಣೂ ಕಾಣಲಿಲ್ಲ.<verse eid="ISA 64:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 64:5"/>ಸಂತೋಷಪಟ್ಟು ನೀತಿಯನ್ನು ಕೈಗೊಳ್ಳುವವರನ್ನೂ,</para>
  <para style="q2" vid="ISA 64:5">ನಿಮ್ಮ ಮಾರ್ಗಗಳನ್ನು</para>
  <para style="q1" vid="ISA 64:5">ಜ್ಞಾಪಕ ಮಾಡುವವನನ್ನೂ ನೀವು ಸಹಾಯಮಾಡಲು ಬರುತ್ತೀರಿ.</para>
  <para style="q2" vid="ISA 64:5">ಆದರೂ ನಾವು ಪಾಪದಲ್ಲೇ ಮುನ್ನಡೆದೆವು.</para>
  <para style="q1" vid="ISA 64:5">ಆದ್ದರಿಂದ ನೀವು ಬೇಸರಗೊಂಡಿರುವಿರಿ.</para>
  <para style="q2" vid="ISA 64:5">ಹಾಗಾದರೆ, ನಮ್ಮಂಥವರಿಗೆ ರಕ್ಷಣೆ ಇದೆಯೇ?<verse eid="ISA 64:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 64:6"/>ನಾವೆಲ್ಲರೂ ಅಶುದ್ಧನ ಹಾಗೆ ಇದ್ದೇವೆ.</para>
  <para style="q2" vid="ISA 64:6">ನಮ್ಮ ನೀತಿ ಕಾರ್ಯಗಳೆಲ್ಲಾ ಮೈಲಿಗೆ ವಸ್ತ್ರದ ಹಾಗೆ ಇವೆ.</para>
  <para style="q1" vid="ISA 64:6">ನಾವೆಲ್ಲರೂ ಎಲೆಯ ಹಾಗೆ ಒಣಗಿಹೋಗಿದ್ದೇವೆ.</para>
  <para style="q2" vid="ISA 64:6">ನಮ್ಮ ಪಾಪಗಳು ಗಾಳಿಯಂತೆ ನಮ್ಮನ್ನು ಬಡಿದುಕೊಂಡು ಹೋಗಿವೆ.<verse eid="ISA 64:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 64:7"/>ನಿನ್ನ ಹೆಸರನ್ನು ಕರೆಯುವವನೂ,</para>
  <para style="q2" vid="ISA 64:7">ನಿನ್ನನ್ನು ಹಿಡಿದುಕೊಳ್ಳುವುದಕ್ಕೆ ಎಚ್ಚರಗೊಳ್ಳುವವನು ಒಬ್ಬನೂ ಇಲ್ಲ.</para>
  <para style="q1" vid="ISA 64:7">ಏಕೆಂದರೆ ನಿನ್ನ ಮುಖವನ್ನು ನಮಗೆ ಮರೆಮಾಡಿದ್ದೀ.</para>
  <para style="q2" vid="ISA 64:7">ನಮ್ಮ ಪಾಪಗಳಿಗಾಗಿ ನಮ್ಮನ್ನು ಬಿಟ್ಟುಬಿಟ್ಟಿದ್ದೀರಿ.<verse eid="ISA 64:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 64:8"/>ಆದರೆ ಈಗ ಯೆಹೋವ ದೇವರೇ, ನಮ್ಮ ತಂದೆಯು ನೀನೇ,</para>
  <para style="q2" vid="ISA 64:8">ನಾವು ಮಣ್ಣು. ನೀನು ನಮ್ಮ ಕುಂಬಾರನು.</para>
  <para style="q2" vid="ISA 64:8">ನಾವೆಲ್ಲರೂ ನಿನ್ನ ಕೈಕೆಲಸಗಳು.<verse eid="ISA 64:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 64:9"/>ಯೆಹೋವ ದೇವರೇ, ಅತ್ಯಧಿಕವಾಗಿ ಬೇಸರಗೊಳ್ಳಬೇಡ.</para>
  <para style="q2" vid="ISA 64:9">ಎಂದೆಂದಿಗೂ ಪಾಪವನ್ನು ಜ್ಞಾಪಕ ಮಾಡಬೇಡ.</para>
  <para style="q1" vid="ISA 64:9">ನೋಡಿರಿ, ನಾವು ಬೇಡುತ್ತೇವೆ, ದೃಷ್ಟಿ ಇಡಿರಿ.</para>
  <para style="q2" vid="ISA 64:9">ನಾವೆಲ್ಲರೂ ನಿನ್ನ ಜನರೇ.<verse eid="ISA 64:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 64:10"/>ನಿನ್ನ ಪರಿಶುದ್ಧ ಪಟ್ಟಣಗಳು ಅಡವಿಯಾದವು.</para>
  <para style="q2" vid="ISA 64:10">ಚೀಯೋನು ಅಡವಿಯಾಯಿತು. ಯೆರೂಸಲೇಮು ಹಾಳಾಯಿತು.<verse eid="ISA 64:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 64:11"/>ನಮ್ಮ ತಂದೆಗಳು ನಿನ್ನನ್ನು ಕೊಂಡಾಡಿದ ನಮ್ಮ ಪರಿಶುದ್ಧ ಶೃಂಗಾರವಾದ ದೇವಾಲಯ</para>
  <para style="q2" vid="ISA 64:11">ಬೆಂಕಿಯಿಂದ ಸುಟ್ಟುಹೋಯಿತು.</para>
  <para style="q2" vid="ISA 64:11">ನಮ್ಮ ಅಮೂಲ್ಯ ವಸ್ತುಗಳೆಲ್ಲ ನಾಶವಾದವು.<verse eid="ISA 64:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 64:12"/>ಇವು ಹೀಗಿರಲಾಗಿ ಯೆಹೋವ ದೇವರೇ, ನೀವು ಹಿಂಜರಿಯುತ್ತೀರೋ?</para>
  <para style="q2" vid="ISA 64:12">ಮೌನವಾಗಿದ್ದು ನಮ್ಮನ್ನು ಅತ್ಯಧಿಕವಾಗಿ ಕುಗ್ಗಿಸುವಿರೋ?<verse eid="ISA 64:12"/></para>
  <chapter eid="ISA 64"/>
  <chapter number="65" style="c" sid="ISA 65"/>
  <para style="s1">ನ್ಯಾಯತೀರ್ಪು ಮತ್ತು ರಕ್ಷಣೆ</para>
  <para style="q1">
    <verse number="1" style="v" sid="ISA 65:1"/>“ಕೇಳದವರಿಗೂ ನಾನು ನನ್ನನ್ನು ಪ್ರಕಟಿಸಿಕೊಂಡಿದ್ದೇನೆ.</para>
  <para style="q2" vid="ISA 65:1">ನನ್ನನ್ನು ಹುಡುಕದವರಿಗೆ ನಾನು ಸಿಕ್ಕಿದೆನು.</para>
  <para style="q1" vid="ISA 65:1">ನನ್ನ ಹೆಸರನ್ನು ಕರೆಯದ ಜನಾಂಗಕ್ಕೆ,</para>
  <para style="q2" vid="ISA 65:1">‘ಇಗೋ, ಇದ್ದೇನೆ; ಇಗೋ, ಇದ್ದೇನೆ,’ ಎಂದು ಹೇಳಿದೆನು.<verse eid="ISA 65:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 65:2"/>ಒಳ್ಳೆಯದಲ್ಲದ ಮಾರ್ಗದಲ್ಲಿ</para>
  <para style="q2" vid="ISA 65:2">ತಮ್ಮ ಆಲೋಚನೆಗಳ ಪ್ರಕಾರ ನಡೆದುಕೊಂಡು</para>
  <para style="q1" vid="ISA 65:2">ತಿರುಗಿಬೀಳುವ ಜನರಿಗೆ ದಿನವೆಲ್ಲಾ</para>
  <para style="q2" vid="ISA 65:2">ನಾನು ಕೈಚಾಚಿ ಕರೆದೆನು.<verse eid="ISA 65:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 65:3"/>ಇವರು ಯಾವಾಗಲೂ ನನ್ನ ಮುಖದ ಮುಂದೆ</para>
  <para style="q2" vid="ISA 65:3">ನನಗೆ ಕೋಪೋದ್ರೇಕವನ್ನು ಎಬ್ಬಿಸುವ ಜನರು.</para>
  <para style="q1" vid="ISA 65:3">ತೋಟಗಳಲ್ಲಿ ಬಲಿ ಅರ್ಪಿಸಿ,</para>
  <para style="q2" vid="ISA 65:3">ಇಟ್ಟಿಗೆಯ ಬಲಿಪೀಠದ ಮೇಲೆ ಧೂಪ ಸುಡುವರು.<verse eid="ISA 65:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 65:4"/>ಸಮಾಧಿಗಳಲ್ಲಿ ಉಳಿದು,</para>
  <para style="q2" vid="ISA 65:4">ಗವಿಗಳಲ್ಲಿ ತಂಗುವರು.</para>
  <para style="q1" vid="ISA 65:4">ಹಂದಿಯ ಮಾಂಸವನ್ನು ತಿನ್ನುವರು</para>
  <para style="q2" vid="ISA 65:4">ತಮ್ಮ ಪಾತ್ರೆಗಳಲ್ಲಿ ಅಶುದ್ಧ ಪದಾರ್ಥಗಳ ಸಾರನ್ನು ಇಟ್ಟುಕೊಂಡು,<verse eid="ISA 65:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 65:5"/>‘ನಿನ್ನಷ್ಟಕ್ಕೆ ನೀನೇ ನಿಂತುಕೋ, ನನ್ನ ಬಳಿಗೆ ಬರಬೇಡ.</para>
  <para style="q2" vid="ISA 65:5">ಏಕೆಂದರೆ ನಿನಗಿಂತ ಪರಿಶುದ್ಧನಾಗಿದ್ದೇನೆ,’ ಎಂದು ಹೇಳುವರು.</para>
  <para style="q1" vid="ISA 65:5">ಇವರು ನನ್ನ ಮೂಗಿನಲ್ಲಿ ಹೊಗೆಯಾಗಿಯೂ,</para>
  <para style="q2" vid="ISA 65:5">ದಿನವೆಲ್ಲಾ ಉರಿಯುವ ಬೆಂಕಿಯಾಗಿಯೂ ಇದ್ದಾರೆ.<verse eid="ISA 65:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 65:6"/>“ನನ್ನ ಮುಂದೆ ಅದು ಬರೆಯಲಾಗಿದೆ.</para>
  <para style="q2" vid="ISA 65:6">ನಾನು ಸುಮ್ಮನಿರದೆ ಪ್ರತಿಫಲ ಕೊಡುತ್ತೇನೆ.</para>
  <para style="q2" vid="ISA 65:6">ಅವರ ಮಡಿಲಲ್ಲಿ ಪ್ರತಿಫಲ ಕೊಡುತ್ತೇನೆ.<verse eid="ISA 65:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 65:7"/>ನಿಮ್ಮ ಪಾಪಗಳಿಗೂ, ನಿಮ್ಮ ತಂದೆಗಳ ಪಾಪಗಳಿಗೂ ಕೂಡ ಪ್ರತಿಫಲ ಕೊಡುತ್ತೇನೆ”</para>
  <para style="q2" vid="ISA 65:7">ಎಂದು ಯೆಹೋವ ದೇವರು ಹೇಳುತ್ತಾರೆ.</para>
  <para style="q1" vid="ISA 65:7">“ಅವರು ಬೆಟ್ಟಗಳ ಮೇಲೆ ಧೂಪ ಸುಟ್ಟು,</para>
  <para style="q2" vid="ISA 65:7">ಗುಡ್ಡಗಳ ಮೇಲೆ ನನ್ನನ್ನು ಪರಿಹಾಸ್ಯ ಮಾಡಿದರಲ್ಲಾ.</para>
  <para style="q1" vid="ISA 65:7">ಹೀಗಿರುವುದರಿಂದ ಅವರ ಹಿಂದಿನ ಕೆಲಸಗಳನ್ನು</para>
  <para style="q2" vid="ISA 65:7">ಅವರ ಮಡಿಲಲ್ಲಿ ಅಳೆದು ಸುರಿಸುವೆನು.”<verse eid="ISA 65:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="ISA 65:8"/>ಯೆಹೋವ ದೇವರು ಹೀಗೆನ್ನುತ್ತಾರೆ:</para>
  <para style="q1" vid="ISA 65:8">“ರಸ ದೊರೆಯಬಹುದಾದ ದ್ರಾಕ್ಷಿ ಗೊಂಚಲನ್ನು</para>
  <para style="q2" vid="ISA 65:8">ಒಬ್ಬನು ನೋಡಿ, ‘ಹಾಳು ಮಾಡಬೇಡ,</para>
  <para style="q2" vid="ISA 65:8">ಅದರಲ್ಲಿ ಪ್ರಯೋಜನವಿದೆ,’</para>
  <para style="q1" vid="ISA 65:8">ಎನ್ನುವಂತೆ ನಾನು ನನ್ನ ಸೇವಕರನ್ನು ಲಕ್ಷ್ಯಕ್ಕೆ ತಂದು</para>
  <para style="q2" vid="ISA 65:8">ಇವರನ್ನೆಲ್ಲಾ ಹಾಳುಮಾಡಬಾರದು ಎಂದುಕೊಳ್ಳುವೆನು.<verse eid="ISA 65:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 65:9"/>ಯಾಕೋಬಿನೊಳಗಿಂದ ಒಂದು ಸಂತಾನವನ್ನೂ,</para>
  <para style="q2" vid="ISA 65:9">ಯೆಹೂದದೊಳಗಿಂದ ನನ್ನ ಪರ್ವತಗಳಿಗೆ ಬಾಧ್ಯಸ್ಥನಾಗಿರುವವನನ್ನು ಹೊರಗೆ ಬರಮಾಡುವೆನು.</para>
  <para style="q1" vid="ISA 65:9">ನಾನು ಆಯ್ದುಕೊಂಡವರು ಅದನ್ನು ಸ್ವಾಧೀನಮಾಡಿಕೊಳ್ಳುವರು.</para>
  <para style="q2" vid="ISA 65:9">ನನ್ನ ಸೇವಕರು ಅದರಲ್ಲಿ ವಾಸವಾಗುವರು.<verse eid="ISA 65:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 65:10"/>ನನ್ನನ್ನು ಹುಡುಕುವ ನನ್ನ ಜನರಿಗೋಸ್ಕರ ಶಾರೋನು ಮಂದೆಗಳ ಹಟ್ಟಿಯಾಗಿಯೂ,</para>
  <para style="q2" vid="ISA 65:10">ಆಕೋರಿನ ತಗ್ಗು, ದನಗಳು ಮಲಗುವ ಸ್ಥಳವಾಗಿಯೂ ಇರುವುದು,</para>
  <para style="q2" vid="ISA 65:10">ಎಂದು ಯೆಹೋವ ದೇವರು ಹೇಳುತ್ತಾರೆ.<verse eid="ISA 65:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 65:11"/>“ಆದರೆ ಯೆಹೋವನಾದ ನನ್ನನ್ನು ತೊರೆದು,</para>
  <para style="q2" vid="ISA 65:11">ನನ್ನ ಪವಿತ್ರ ಪರ್ವತವನ್ನು ಮರೆತು,</para>
  <para style="q1" vid="ISA 65:11">ಶುಭದಾಯಕ ದೇವತೆಗೆ ಔತಣವನ್ನು ಅಣಿಮಾಡಿ,</para>
  <para style="q2" vid="ISA 65:11">ಗಾದ್ ಎಂಬ ಅದೃಷ್ಟ ದೇವತೆಗೆ ಮದ್ಯವನ್ನು ತುಂಬಾ ಬೆರೆಸಿದ ನಿಮಗೆ<verse eid="ISA 65:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 65:12"/>ಖಡ್ಗವನ್ನೇ ಗತಿಯಾಗ ಮಾಡುವೆನು.</para>
  <para style="q2" vid="ISA 65:12">ಆದ್ದರಿಂದ ನಿಮ್ಮನ್ನು ಖಡ್ಗಕ್ಕೆ ನೇಮಿಸುವೆನು.</para>
  <para style="q2" vid="ISA 65:12">ನೀವೆಲ್ಲರು ಕೊಲೆಗೆ ಬೊಗ್ಗಿಕೊಳ್ಳುವಿರಿ.</para>
  <para style="q1" vid="ISA 65:12">ಏಕೆಂದರೆ, ನಾನು ಕರೆಯಲು, ನೀವು ಉತ್ತರ ಕೊಡಲಿಲ್ಲ. ನಾನು ಹೇಳಿದಾಗ ನೀವು ಕೇಳಲಿಲ್ಲ.</para>
  <para style="q2" vid="ISA 65:12">ನನ್ನ ದೃಷ್ಟಿಯಲ್ಲಿ ಕೆಟ್ಟದ್ದನ್ನು ಮಾಡಿದಿರಿ.</para>
  <para style="q2" vid="ISA 65:12">ನಾನು ಮೆಚ್ಚದ್ದನ್ನು ಆರಿಸಿಕೊಂಡಿರಿ.”<verse eid="ISA 65:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="ISA 65:13"/>ಹೀಗಿರುವುದರಿಂದ ಸಾರ್ವಭೌಮ ಯೆಹೋವ ದೇವರು ಹೇಳುವುದೇನೆಂದರೆ:</para>
  <para style="q1" vid="ISA 65:13">“ನನ್ನ ಸೇವಕರು ತಿನ್ನುವರು.</para>
  <para style="q2" vid="ISA 65:13">ಆದರೆ ನೀವು ಹಸಿದಿರುವಿರಿ.</para>
  <para style="q1" vid="ISA 65:13">ನನ್ನ ಸೇವಕರು ಕುಡಿಯುವರು,</para>
  <para style="q2" vid="ISA 65:13">ಆದರೆ ನೀವು ಬಾಯಾರಿ ಇರುವಿರಿ.</para>
  <para style="q1" vid="ISA 65:13">ಇಗೋ, ನನ್ನ ಸೇವಕರು ಸಂತೋಷಪಡುವರು,</para>
  <para style="q2" vid="ISA 65:13">ಆದರೆ ನೀವು ನಾಚಿಕೆ ಪಡುವಿರಿ.<verse eid="ISA 65:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="ISA 65:14"/>ಇಗೋ, ನನ್ನ ಸೇವಕರು</para>
  <para style="q2" vid="ISA 65:14">ಹೃದಯದ ಆನಂದದಿಂದ ಹಾಡುವರು,</para>
  <para style="q1" vid="ISA 65:14">ಆದರೆ ನೀವು ಹೃದಯದ ವ್ಯಸನದಿಂದ ಅಳುವಿರಿ</para>
  <para style="q2" vid="ISA 65:14">ಮತ್ತು ಮುರಿದ ಆತ್ಮದಿಂದ ಗೋಳಾಡುವಿರಿ.<verse eid="ISA 65:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="ISA 65:15"/>ನಿಮ್ಮ ಹೆಸರನ್ನು ನಾನು ಆಯ್ದುಕೊಂಡವರಿಗೆ</para>
  <para style="q2" vid="ISA 65:15">ಶಾಪವಾಗಿ ಉಳಿಸುವಿರಿ.</para>
  <para style="q1" vid="ISA 65:15">ಹೇಗೆಂದರೆ, ಸಾರ್ವಭೌಮ ಯೆಹೋವ ದೇವರು ಅಪನಂಬಿಗಸ್ತರಾದ ನಿಮ್ಮನ್ನು ಕೊಂದುಹಾಕಿ,</para>
  <para style="q2" vid="ISA 65:15">ತಮ್ಮ ಸೇವಕರಿಗಾದರೋ ಬೇರೆ ಹೆಸರನ್ನು ನೀಡುವರು.<verse eid="ISA 65:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="ISA 65:16"/>ಆಗ ದೇಶದಲ್ಲಿ ತನ್ನನ್ನು ಆಶೀರ್ವದಿಸುವವನು,</para>
  <para style="q2" vid="ISA 65:16">ಸತ್ಯ ದೇವರಲ್ಲಿ ತನ್ನನ್ನು ಆಶೀರ್ವದಿಸಿಕೊಳ್ಳುವನು;</para>
  <para style="q1" vid="ISA 65:16">ದೇಶದಲ್ಲಿ ಆಣೆ ಇಟ್ಟುಕೊಳ್ಳುವವನು, ಸತ್ಯ ದೇವರಲ್ಲಿ ಆಣೆ ಇಟ್ಟುಕೊಳ್ಳುವನು.</para>
  <para style="q2" vid="ISA 65:16">ಏಕೆಂದರೆ ಮುಂಚಿನ ಕಷ್ಟಗಳು ಮರೆತು ಹೋಗಿವೆ,</para>
  <para style="q2" vid="ISA 65:16">ಮತ್ತು ಅವು ನನ್ನ ಕಣ್ಣಿಗೆ ಮರೆಯಾಗಿವೆ.<verse eid="ISA 65:16"/></para>
  <para style="s1">ಹೊಸ ಆಕಾಶವೂ, ಹೊಸ ಭೂಮಿಯೂ</para>
  <para style="q1">
    <verse number="17" style="v" sid="ISA 65:17"/>“ನಾನು ಹೊಸ ಆಕಾಶವನ್ನೂ,</para>
  <para style="q2" vid="ISA 65:17">ಹೊಸ ಭೂಮಿಯನ್ನೂ ಸೃಷ್ಟಿಸುತ್ತೇನೆ.</para>
  <para style="q1" vid="ISA 65:17">ಮುಂಚಿನವುಗಳು ಜ್ಞಾಪಕದಲ್ಲಿರುವುದಿಲ್ಲ</para>
  <para style="q2" vid="ISA 65:17">ಇಲ್ಲವೆ ಅವು ಸ್ಮರಣೆಗೆ ಬರುವುದಿಲ್ಲ.<verse eid="ISA 65:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="ISA 65:18"/>ಆದರೆ ನಾನು ಸೃಷ್ಟಿಸುವುದರ ವಿಷಯದಲ್ಲಿ ಸಂತೋಷಿಸಿ,</para>
  <para style="q2" vid="ISA 65:18">ಎಂದೆಂದಿಗೂ ಉಲ್ಲಾಸಪಡಿರಿ.</para>
  <para style="q1" vid="ISA 65:18">ಏಕೆಂದರೆ ಇಗೋ, ನಾನು ಯೆರೂಸಲೇಮಿನಲ್ಲಿ ಉಲ್ಲಾಸವನ್ನೂ,</para>
  <para style="q2" vid="ISA 65:18">ನನ್ನ ಜನರಲ್ಲಿ ಸಂತೋಷವನ್ನೂ ಸೃಷ್ಟಿಸುತ್ತೇನೆ.<verse eid="ISA 65:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="ISA 65:19"/>ಯೆರೂಸಲೇಮಿನಲ್ಲಿ ಉಲ್ಲಾಸಿಸಿ,</para>
  <para style="q2" vid="ISA 65:19">ನನ್ನ ಜನರಲ್ಲಿ ಸಂತೋಷ ಪಡುವೆನು.</para>
  <para style="q1" vid="ISA 65:19">ಅದರಲ್ಲಿ ಅಳುವ ಧ್ವನಿಯೂ,</para>
  <para style="q2" vid="ISA 65:19">ಪ್ರಲಾಪದ ಧ್ವನಿಯೂ ಇನ್ನು ಕೇಳಿಬರುವುದಿಲ್ಲ.<verse eid="ISA 65:19"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="20" style="v" sid="ISA 65:20"/>“ಅಲ್ಲಿ ಕೆಲವು ದಿನಗಳು ಮಾತ್ರ ಬದುಕತಕ್ಕ ಕೂಸೂ,</para>
  <para style="q2" vid="ISA 65:20">ವೃದ್ಧನೂ ಇರುವುದಿಲ್ಲ.</para>
  <para style="q1" vid="ISA 65:20">ಮಗುವು ನೂರು ವರುಷದವನಾಗಿ ಸಾಯುವುದು.</para>
  <para style="q2" vid="ISA 65:20">ಆದರೆ ನೂರು ವರುಷವನ್ನು ತಲುಪಲು ವಿಫಲನಾದವನನ್ನು ಶಾಪಗ್ರಸ್ತ ಎಂದು ಪರಿಗಣಿಸಲಾಗುತ್ತದೆ.<verse eid="ISA 65:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="ISA 65:21"/>ಇದಲ್ಲದೆ ಅವರು ಮನೆಗಳನ್ನು ಕಟ್ಟಿ, ವಾಸಮಾಡುವರು;</para>
  <para style="q2" vid="ISA 65:21">ದ್ರಾಕ್ಷಿತೋಟಗಳನ್ನು ನೆಟ್ಟು, ಅವುಗಳ ಫಲವನ್ನು ಉಣ್ಣುವರು.<verse eid="ISA 65:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="ISA 65:22"/>ಅವರು ಕಟ್ಟಿದ ಮನೆಗಳಲ್ಲಿ ಬೇರೆಯವರು ವಾಸಮಾಡುವುದಿಲ್ಲ.</para>
  <para style="q2" vid="ISA 65:22">ಅವರು ನೆಟ್ಟ ತೋಟದ ಫಲವನ್ನು ಇನ್ನೊಬ್ಬರು ತಿನ್ನುವುದಿಲ್ಲ.</para>
  <para style="q1" vid="ISA 65:22">ಏಕೆಂದರೆ, ಮರಗಳ ಹಾಗೆ ನನ್ನ ಜನರು ಬಹುಕಾಲ ಬಾಳುವರು.</para>
  <para style="q2" vid="ISA 65:22">ನಾನು ಆಯ್ದುಕೊಂಡವರು ತಮ್ಮ ಕೈಕೆಲಸಗಳನ್ನು ಅನುಭವಿಸುವರು.<verse eid="ISA 65:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="ISA 65:23"/>ಅವರು ವ್ಯರ್ಥವಾಗಿ ದುಡಿಯರು.</para>
  <para style="q2" vid="ISA 65:23">ಕಷ್ಟವನ್ನು ಎದುರುಗೊಳ್ಳುವುದಿಲ್ಲ.</para>
  <para style="q1" vid="ISA 65:23">ಏಕೆಂದರೆ ಅವರು ಯೆಹೋವ ದೇವರ ಆಶೀರ್ವಾದ ಹೊಂದಿದವರ ಸಂತಾನವಾಗಿದ್ದಾರೆ.</para>
  <para style="q2" vid="ISA 65:23">ಅವರ ಸಂಗಡ ಅವರ ಸಂತತಿಯು ಸಹ ಆಶೀರ್ವಾದ ಹೊಂದುವುದು.<verse eid="ISA 65:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="ISA 65:24"/>ಅವರು ಕರೆಯುವುದಕ್ಕಿಂತ ಮುಂಚೆ ನಾನು ಉತ್ತರಕೊಡುವೆನು.</para>
  <para style="q2" vid="ISA 65:24">ಅವರು ಇನ್ನೂ ಮಾತನಾಡುತ್ತಿರುವಾಗಲೇ ನಾನು ಕೇಳುವೆನು.<verse eid="ISA 65:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="ISA 65:25"/>ತೋಳವೂ ಕುರಿಮರಿಯೂ ಒಂದಾಗಿ ಮೇಯುವುವು;</para>
  <para style="q2" vid="ISA 65:25">ಸಿಂಹವು ಎತ್ತಿನ ಹಾಗೆ ಹುಲ್ಲು ತಿನ್ನುವುದು;</para>
  <para style="q2" vid="ISA 65:25">ಹಾವಿಗೆ ಮಣ್ಣೇ ಆಹಾರವಾಗುವುದು;</para>
  <para style="q1" vid="ISA 65:25">ಅವು ನನ್ನ ಪರಿಶುದ್ಧ ಪರ್ವತದಲ್ಲೆಲ್ಲಾ</para>
  <para style="q2" vid="ISA 65:25">ಯಾವ ಕೇಡೂ ಮಾಡುವುದಿಲ್ಲ, ನಾಶವೂ ಮಾಡುವುದಿಲ್ಲ,”</para>
  <para style="q2" vid="ISA 65:25">ಎಂದು ಯೆಹೋವ ದೇವರು ಹೇಳುತ್ತಾರೆ.<verse eid="ISA 65:25"/></para>
  <chapter eid="ISA 65"/>
  <chapter number="66" style="c" sid="ISA 66"/>
  <para style="s1">ನ್ಯಾಯತೀರ್ಪು ಮತ್ತು ನಿರೀಕ್ಷಣೆ</para>
  <para style="p">
    <verse number="1" style="v" sid="ISA 66:1"/>ಯೆಹೋವ ದೇವರು ಹೇಳುವುದೇನೆಂದರೆ:</para>
  <para style="q1" vid="ISA 66:1">“ಆಕಾಶವೇ ನನ್ನ ಸಿಂಹಾಸನ,</para>
  <para style="q2" vid="ISA 66:1">ಭೂಮಿಯೇ ನನ್ನ ಪಾದ ಪೀಠ,</para>
  <para style="q1" vid="ISA 66:1">ನೀವು ನನಗೋಸ್ಕರ ಕಟ್ಟುವ ಮನೆ ಎಲ್ಲಿ?</para>
  <para style="q2" vid="ISA 66:1">ನನ್ನ ವಿಶ್ರಾಂತಿಯ ಸ್ಥಳವು ಎಲ್ಲಿ?<verse eid="ISA 66:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 66:2"/>ಇವುಗಳನ್ನೆಲ್ಲಾ ನಿರ್ಮಿಸಿದ್ದು ನನ್ನ ಕೈಯೇ.</para>
  <para style="q2" vid="ISA 66:2">ಹೌದು, ನನ್ನ ಕೈಯಿಂದಲೇ ಇವುಗಳೆಲ್ಲಾ ಉಂಟಾದವು,”</para>
  <para style="q2" vid="ISA 66:2">ಎಂದು ಯೆಹೋವ ದೇವರು ಹೇಳುತ್ತಾರೆ.</para>
  <para style="b" vid="ISA 66:2"/>
  <para style="q1" vid="ISA 66:2">“ನಾನು ಕಟಾಕ್ಷಿಸುವವನು ಎಂಥವನೆಂದರೆ:</para>
  <para style="q2" vid="ISA 66:2">ದೀನನೂ, ಮನಮುರಿದವನೂ,</para>
  <para style="q2" vid="ISA 66:2">ನನ್ನ ಮಾತಿಗೆ ಭಯಪಡುವವನೂ ಆಗಿರುವವನೇ.<verse eid="ISA 66:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 66:3"/>ಎತ್ತನ್ನು ಕೊಂದುಹಾಕುವವನು</para>
  <para style="q2" vid="ISA 66:3">ಮನುಷ್ಯನನ್ನು ಹತ್ಯೆ ಮಾಡುವವನ ಹಾಗಿದ್ದಾನೆ.</para>
  <para style="q1" vid="ISA 66:3">ಕುರಿಮರಿಯನ್ನು ಬಲಿ ಕೊಡುವವನು,</para>
  <para style="q2" vid="ISA 66:3">ನಾಯಿಯ ಕುತ್ತಿಗೆಯನ್ನು ಕಡಿಯುವವನ ಹಾಗಿದ್ದಾನೆ.</para>
  <para style="q1" vid="ISA 66:3">ಕಾಣಿಕೆಯನ್ನು ಅರ್ಪಿಸುವವನು,</para>
  <para style="q2" vid="ISA 66:3">ಹಂದಿಯ ರಕ್ತವನ್ನು ಅರ್ಪಿಸುವವನ ಹಾಗಿದ್ದಾನೆ.</para>
  <para style="q1" vid="ISA 66:3">ಧೂಪವನ್ನು ಹಾಕುವವನು,</para>
  <para style="q2" vid="ISA 66:3">ವಿಗ್ರಹವನ್ನು ಪೂಜಿಸುವವನ ಹಾಗಿದ್ದಾನೆ.</para>
  <para style="q1" vid="ISA 66:3">ಹೀಗೆ, ಅವರು ಸ್ವಂತ ಮಾರ್ಗಗಳನ್ನು ಆಯ್ದುಕೊಂಡಿದ್ದಾರೆ.</para>
  <para style="q2" vid="ISA 66:3">ಅವರ ಪ್ರಾಣವು ಅವರ ಅಸಹ್ಯಗಳಲ್ಲಿ ಹರ್ಷಿಸುತ್ತವೆ.<verse eid="ISA 66:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 66:4"/>ಅದಕ್ಕೆ ತಕ್ಕಂತೆ ನಾನು ಇವರಿಗೋಸ್ಕರ ಕುತಂತ್ರಗಳನ್ನು ಆರಿಸಿಕೊಂಡು,</para>
  <para style="q2" vid="ISA 66:4">ಇವರು ಅಂಜುತ್ತಿದ್ದ ವಿಪತ್ತುಗಳನ್ನು ಬರಮಾಡುವೆನು.</para>
  <para style="q1" vid="ISA 66:4">ಏಕೆಂದರೆ ನಾನು ಕೂಗಿದಾಗ, ಯಾರು ಉತ್ತರ ಕೊಡಲಿಲ್ಲ.</para>
  <para style="q2" vid="ISA 66:4">ನಾನು ಹೇಳಿದಾಗ, ಇವರು ಕೇಳಲಿಲ್ಲ.</para>
  <para style="q1" vid="ISA 66:4">ನನ್ನ ಚಿತ್ತಕ್ಕೆ ವಿರುದ್ಧವಾದದ್ದನ್ನು ನಡೆಸಿ,</para>
  <para style="q2" vid="ISA 66:4">ನನಗೆ ಇಷ್ಟವಲ್ಲದ್ದನ್ನು ಆರಿಸಿಕೊಂಡರು.”<verse eid="ISA 66:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 66:5"/>ಯೆಹೋವ ದೇವರ ಮಾತಿಗೆ ಭಯಪಡುವವರೇ,</para>
  <para style="q2" vid="ISA 66:5">ಆತನ ಮಾತನ್ನು ಕೇಳಿರಿ!</para>
  <para style="q1" vid="ISA 66:5">“ನನ್ನ ಹೆಸರಿನ ನಿಮಿತ್ತ ನಿಮ್ಮನ್ನು ದ್ವೇಷಿಸಿ</para>
  <para style="q2" vid="ISA 66:5">ಬಹಿಷ್ಕರಿಸಿದ ನಿಮ್ಮ ಸಂಬಂಧಿಗಳು,</para>
  <para style="q1" vid="ISA 66:5">‘ಯೆಹೋವ ದೇವರು ಮಹಿಮೆಪಡಲಿ,</para>
  <para style="q2" vid="ISA 66:5">ನಿಮಗಾಗುವ ಉತ್ಸಾಹವನ್ನು ನೋಡೋಣ’</para>
  <para style="q2" vid="ISA 66:5">ಎಂದು ಹೇಳಿದ್ದಾರಲ್ಲಾ.</para>
  <para style="q2" vid="ISA 66:5">ಅವರಿಗಂತೂ ಅವಮಾನವಾಗುವುದು.<verse eid="ISA 66:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 66:6"/>ಪಟ್ಟಣದೊಳಗಿನ ಗದ್ದಲದ</para>
  <para style="q2" vid="ISA 66:6">ಶಬ್ದವು ದೇವಾಲಯದೊಳಗಿಂದ ಸ್ವರವು</para>
  <para style="q1" vid="ISA 66:6">ತನ್ನ ಶತ್ರುಗಳಿಗೆ ಮುಯ್ಯಿಗೆ ಮುಯ್ಯಿ ತೀರಿಸುವ</para>
  <para style="q2" vid="ISA 66:6">ಯೆಹೋವ ದೇವರ ಸ್ವರವಾಗಿದೆ.<verse eid="ISA 66:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 66:7"/>“ಅವಳಿಗೆ ನೋವು ಆಗುವುದಕ್ಕಿಂತ ಮುಂಚೆಯೇ ಹೆತ್ತಳು.</para>
  <para style="q2" vid="ISA 66:7">ವೇದನೆ ಬರುವುದಕ್ಕಿಂತ ಮುಂಚೆಯೇ ಗಂಡು ಕೂಸು ಪಡೆದಳು.<verse eid="ISA 66:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 66:8"/>ಇಂಥ ಸುದ್ದಿಯನ್ನು ಯಾರು ಕೇಳಿದ್ದಾರೆ?</para>
  <para style="q2" vid="ISA 66:8">ಇಂಥ ಸಂಗತಿಯನ್ನು ಕಂಡವರಾರು?</para>
  <para style="q1" vid="ISA 66:8">ಒಂದೇ ದಿನದಲ್ಲಿ ದೇಶ ಒಂದು ಹುಟ್ಟೀತೇ?</para>
  <para style="q2" vid="ISA 66:8">ಕ್ಷಣಮಾತ್ರದಲ್ಲಿ ರಾಷ್ಟ್ರವನ್ನು ಹೆರಲಿಕ್ಕಾದೀತೇ?</para>
  <para style="q1" vid="ISA 66:8">ಆದರೂ ಪ್ರಸವವೇದನೆ ತೊಡಗಿದೊಡನೆ</para>
  <para style="q2" vid="ISA 66:8">ಚೀಯೋನೆಂಬಾಕೆ ಮಕ್ಕಳನ್ನು ಹೆತ್ತಿದ್ದಾಳೆ.<verse eid="ISA 66:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 66:9"/>ನಾನು ಪ್ರಸವಕ್ಕೆ ತಂದಮೇಲೆ</para>
  <para style="q2" vid="ISA 66:9">ಹೆರಿಗೆಯಾಗದಂತೆ ತಡೆಯುವೆನೋ?”</para>
  <para style="q2" vid="ISA 66:9">ಎಂದು ಯೆಹೋವ ದೇವರು ಹೇಳುತ್ತಾನೆ.</para>
  <para style="q1" vid="ISA 66:9">“ನಾನು ಪ್ರಸವಕ್ಕೆ ತಂದಮೇಲೆ, ಪ್ರಸವವಾಗದೆ ಇರಲು ಗರ್ಭ ಮುಚ್ಚಿಬಿಡುವೆನೇ?”</para>
  <para style="q2" vid="ISA 66:9">ಎಂದು ನಿನ್ನ ದೇವರು ಕೇಳುತ್ತಾನೆ.<verse eid="ISA 66:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 66:10"/>“ಯೆರೂಸಲೇಮಿನ ಸಂಗಡ ನೀವು ಸಂತೋಷಿಸಿರಿ.</para>
  <para style="q2" vid="ISA 66:10">ಅವಳನ್ನು ಪ್ರೀತಿ ಮಾಡುವವರೆಲ್ಲಾ</para>
  <para style="q1" vid="ISA 66:10">ಆಕೆಯೊಂದಿಗೆ ಉಲ್ಲಾಸಪಡಿರಿ.</para>
  <para style="q1" vid="ISA 66:10">ಅವಳಿಗೋಸ್ಕರ ದುಃಖಿಸಿದವರೆಲ್ಲರೂ,</para>
  <para style="q2" vid="ISA 66:10">ಆಕೆಯ ಸಂತೋಷಕ್ಕಾಗಿ ಆನಂದಪಡಿರಿ.<verse eid="ISA 66:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 66:11"/>ಆಕೆಯ ಸಾಂತ್ವನ ಸ್ತನವನ್ನು</para>
  <para style="q2" vid="ISA 66:11">ಕುಡಿದು ನೀವು ತೃಪ್ತಿಯಾಗಿರುವಿರಿ.</para>
  <para style="q1" vid="ISA 66:11">ನೀವು ಕುಡಿಯುವಿರಿ ಮತ್ತು ಅದರ ಸಮೃದ್ಧಿಯು</para>
  <para style="q2" vid="ISA 66:11">ನಿಮ್ಮ ಸಂತೋಷಕ್ಕೆ ಕಾರಣವಾಗಿದೆ.”<verse eid="ISA 66:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="ISA 66:12"/>ಏಕೆಂದರೆ ಯೆಹೋವ ದೇವರು ಹೀಗೆ ಹೇಳುತ್ತಾರೆ:</para>
  <para style="q1" vid="ISA 66:12">“ಇಗೋ, ನಾನು ನದಿಯಂತೆ ಸಮಾಧಾನವನ್ನೂ,</para>
  <para style="q2" vid="ISA 66:12">ಹರಿಯುವ ಹಳ್ಳದಂತೆ ಜನಾಂಗಗಳ ವೈಭವವನ್ನೂ ಆಕೆಯ ಕಡೆಗೆ ಬರಮಾಡುವೆನು.</para>
  <para style="q1" vid="ISA 66:12">ಆಗ ನೀವು ಪಾನ ಮಾಡುವಿರಿ; ನಿಮ್ಮನ್ನು ಆಕೆಯ ಪಕ್ಕೆಯಲ್ಲಿ ಎತ್ತಿಕೊಂಡುಹೋಗುವರು.</para>
  <para style="q2" vid="ISA 66:12">ನೀವು ಆಕೆಯ ಮಡಿಲಲ್ಲಿ ನಲಿದಾಡುವಿರಿ.<verse eid="ISA 66:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="ISA 66:13"/>ತಾಯಿ ತನ್ನ ಮಗುವನ್ನು ಆದರಿಸುವ ಪ್ರಕಾರವೇ,</para>
  <para style="q2" vid="ISA 66:13">ನಾನು ನಿಮ್ಮನ್ನು ಆದರಿಸುವೆನು.</para>
  <para style="q2" vid="ISA 66:13">ಯೆರೂಸಲೇಮಿನ ನಿಮಿತ್ತವೇ, ಆದರಣೆ ಪಡುವಿರಿ.”<verse eid="ISA 66:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="ISA 66:14"/>ನೀವು ಅದನ್ನು ಕಾಣುವಾಗ, ನಿಮ್ಮ ಹೃದಯವು ಸಂತೋಷಿಸುವುದು.</para>
  <para style="q2" vid="ISA 66:14">ನಿಮ್ಮ ಎಲುಬುಗಳು ಹಸಿರು ಹುಲ್ಲಿನ ಹಾಗೆ ಚಿಗುರುವುವು.</para>
  <para style="q1" vid="ISA 66:14">ಯೆಹೋವ ದೇವರ ಕೈ ತಮ್ಮ ಸೇವಕರ ಮೇಲೆಯೂ,</para>
  <para style="q2" vid="ISA 66:14">ಅವರ ರೌದ್ರವು ತಮ್ಮ ಶತ್ರುಗಳ ಮೇಲೆ ಕಾಣಬರುವುದು.<verse eid="ISA 66:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="ISA 66:15"/>ಯೆಹೋವ ದೇವರು ಬೆಂಕಿಯೊಡನೆ ಬರುವರು.</para>
  <para style="q2" vid="ISA 66:15">ಅವರ ರಥಗಳು ಬಿರುಗಾಳಿಯ ಹಾಗೆ ಇರುವುವು.</para>
  <para style="q1" vid="ISA 66:15">ಕಠಿಣವಾದ ತಮ್ಮ ಕೋಪವನ್ನೂ</para>
  <para style="q2" vid="ISA 66:15">ಅಗ್ನಿಜ್ವಾಲೆಗಳಿಂದ ತಮ್ಮ ಗದರಿಕೆಯನ್ನೂ ಸಲ್ಲಿಸುವುದಕ್ಕಾಗಿಯೇ ಬರುವರು.<verse eid="ISA 66:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="ISA 66:16"/>ಏಕೆಂದರೆ ಬೆಂಕಿಯಿಂದಲೂ ತಮ್ಮ ಖಡ್ಗದಿಂದಲೂ</para>
  <para style="q2" vid="ISA 66:16">ಯೆಹೋವ ದೇವರು ಮನುಷ್ಯರಿಗೆಲ್ಲಾ ನ್ಯಾಯತೀರಿಸುವರು.</para>
  <para style="q2" vid="ISA 66:16">ಯೆಹೋವ ದೇವರಿಂದ ಹತರಾಗುವವರು ಅನೇಕರಾಗಿರುವರು.<verse eid="ISA 66:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="ISA 66:17"/>“ತೋಟಗಳಲ್ಲಿ ಒಬ್ಬರ ಹಿಂದೊಬ್ಬರು ಮಧ್ಯದಲ್ಲಿ ತಮ್ಮನ್ನು ಪರಿಶುದ್ಧ ಮಾಡಿಕೊಂಡು, ಪವಿತ್ರ ಮಾಡಿಕೊಳ್ಳುವವರೂ; ಹಂದಿ ಮಾಂಸವನ್ನೂ, ಅಸಹ್ಯವಾದದ್ದನ್ನೂ, ಇಲಿಯನ್ನೂ ತಿನ್ನುವವರು ಒಟ್ಟಾಗಿ ದಹಿಸಿ ಹೋಗುವರು,” ಎಂದು ಯೆಹೋವ ದೇವರು ಹೇಳುತ್ತಾರೆ.<verse eid="ISA 66:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="ISA 66:18"/>“ನಾನು ಅವರ ಕ್ರಿಯೆಗಳನ್ನೂ ಅವರ ಆಲೋಚನೆಗಳನ್ನೂ ಬಲ್ಲೆನು. ಎಲ್ಲಾ ಜನಾಂಗಗಳನ್ನೂ ಭಾಷೆಯವರನ್ನೂ ಇನ್ನು ಮುಂದೆ ಒಟ್ಟಿಗೆ ಬರಮಾಡುವೆನು. ಆಗ ಅವರು ಬಂದು ನನ್ನ ಮಹಿಮೆಯನ್ನು ನೋಡುವರು.<verse eid="ISA 66:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="ISA 66:19"/>“ಅವರ ಮಧ್ಯದಲ್ಲಿ ಗುರುತನ್ನಿಟ್ಟು, ಅವರಲ್ಲಿ ತಪ್ಪಿಸಿಕೊಂಡವರನ್ನು ಜನಾಂಗಗಳಿಗೂ, ತಾರ್ಷೀಷ್, ಪೂಲ್<note caller="+" style="f"><char style="fr" closed="false">66:19 </char><char style="fq" closed="false">ಪೂಲ್ </char><char style="ft" closed="false">ಅಥವಾ </char><char style="fqa" closed="false">ಲಿಬಿಯಾ</char></note>, ಬಿಲ್ಲು ಪ್ರಯೋಗಿಸುವುದರಲ್ಲಿ ಪ್ರವೀಣರಾದ ಲೂದ್<note caller="+" style="f"><char style="fr" closed="false">66:19 </char><char style="fq" closed="false">ಲೂದ್ </char><char style="ft" closed="false">ಅಥವಾ </char><char style="fqa" closed="false">ಲಿದಿಯಾ</char></note>, ತೂಬಲ್, ಗ್ರೀಸ್ ಎಂಬ ನಾಡುಗಳಿಗೂ ನನ್ನ ಸಮಾಚಾರವನ್ನು ಕೇಳದ ನನ್ನ ಮಹಿಮೆಯನ್ನು ಕಾಣದೆ ಇರುವ ದೂರ ದ್ವೀಪನಿವಾಸಿಗಳಿಗೂ ಕಳುಹಿಸುವೆನು. ಅವರು ಜನಾಂಗಗಳಲ್ಲಿ ನನ್ನ ಮಹಿಮೆಯನ್ನು ಪ್ರಕಟಿಸುವರು. <verse eid="ISA 66:19"/><verse number="20" style="v" sid="ISA 66:20"/>ಅವರು ನಿಮ್ಮ ಸಹೋದರರನ್ನು ಕುದುರೆಗಳ ಮೇಲೆಯೂ ರಥಗಳಲ್ಲಿಯೂ ಪಲ್ಲಕ್ಕಿಗಳಲ್ಲಿಯೂ ಹೇಸರಗತ್ತೆಗಳ ಮೇಲೆಯೂ ಒಂಟೆಗಳ ಮೇಲೆಯೂ ಸಮಸ್ತ ಜನಾಂಗಗಳೊಳಗಿಂದ ಯೆಹೋವ ದೇವರಿಗೆ ಕಾಣಿಕೆಯಾಗಿ ಇಸ್ರಾಯೇಲರು ಕಾಣಿಕೆಯನ್ನು ಶುದ್ಧಪಾತ್ರೆಯಲ್ಲಿ ಯೆಹೋವ ದೇವರು ಮನೆಗೆ ತರುವ ಪ್ರಕಾರ ನನ್ನ ಪರಿಶುದ್ಧ ಪರ್ವತವಾದ ಯೆರೂಸಲೇಮಿಗೆ ತರುವರೆಂದು ಯೆಹೋವ ದೇವರು ಹೇಳುತ್ತಾರೆ. <verse eid="ISA 66:20"/><verse number="21" style="v" sid="ISA 66:21"/>ಅವರಲ್ಲಿ ಯಾಜಕರಿಗಾಗಿಯೂ ಲೇವಿಯರಿಗಾಗಿಯೂ ಅವರಿಂದ ತೆಗೆದುಕೊಳ್ಳುವೆನು” ಎಂದು ಯೆಹೋವ ದೇವರು ಹೇಳುತ್ತಾರೆ.<verse eid="ISA 66:21"/></para>
  <para style="b"/>
  <para style="p">
    <verse number="22" style="v" sid="ISA 66:22"/>“ನಾನು ಉಂಟುಮಾಡುವ ಹೊಸ ಆಕಾಶವೂ ಹೊಸ ಭೂಮಿಯೂ ನನ್ನ ಮುಂದೆ ನೆಲೆಯಾಗಿರುವ ಪ್ರಕಾರವೇ, ನಿಮ್ಮ ಸಂತಾನವೂ ನಿಮ್ಮ ಹೆಸರೂ ನೆಲೆಯಾಗುವುದು,” ಎಂದು ಯೆಹೋವ ದೇವರು ಘೋಷಿಸುತ್ತಾರೆ. <verse eid="ISA 66:22"/><verse number="23" style="v" sid="ISA 66:23"/>ಇದಾದ ಮೇಲೆ, “ಪ್ರತಿಯೊಂದು ಅಮಾವಾಸ್ಯೆಯಲ್ಲಿಯೂ ಒಂದೊಂದು ಸಬ್ಬತ್ ದಿನದಲ್ಲಿಯೂ ಮನುಷ್ಯರೆಲ್ಲಾ ನನ್ನ ಮುಂದೆ ಆರಾಧಿಸುವುದಕ್ಕೆ ಬರುವರು” ಎಂದು ಯೆಹೋವ ದೇವರು ಹೇಳುತ್ತಾರೆ. <verse eid="ISA 66:23"/><verse number="24" style="v" sid="ISA 66:24"/>“ಅವರು ಮುಂದೆ ಹೋಗಿ ನನಗೆ ವಿರೋಧವಾಗಿ ದ್ರೋಹಮಾಡಿದ ಮನುಷ್ಯರ ಹೆಣಗಳನ್ನು ನೋಡುವರು. ಅವುಗಳನ್ನು ಕಡಿಯುವ ಹುಳ ಸಾಯುವುದಿಲ್ಲ, ಸುಡುವ ಬೆಂಕಿಯು ಆರುವುದಿಲ್ಲ, ಅವರು ಎಲ್ಲಾ ಮನುಷ್ಯರಿಗೆ ಹೇಸಿಗೆಯಾಗುವರು.”<verse eid="ISA 66:24"/></para>
  <chapter eid="ISA 66"/>
</usx>
