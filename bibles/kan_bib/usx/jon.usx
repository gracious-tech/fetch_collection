<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="JON" style="id">- Biblica® Open Kannada Contemporary Version</book>
  <para style="h">ಯೋನನು</para>
  <para style="toc1">ಯೋನನು</para>
  <para style="toc2">ಯೋನನು</para>
  <para style="toc3">ಯೋನ</para>
  <para style="mt1">ಯೋನನು</para>
  <chapter number="1" style="c" sid="JON 1"/>
  <para style="s1">ಯೋನನು ಯೆಹೋವ ದೇವರಿಂದ ಓಡಿಹೋದದ್ದು</para>
  <para style="p">
    <verse number="1" style="v" sid="JON 1:1"/>ಯೆಹೋವ ದೇವರ ವಾಕ್ಯವು ಅಮಿತ್ತೈಯನ ಮಗ ಯೋನನಿಗೆ ಬಂದಿತು: <verse eid="JON 1:1"/><verse number="2" style="v" sid="JON 1:2"/>“ನೀನು ಎದ್ದು ಆ ದೊಡ್ಡ ಪಟ್ಟಣವಾದ ನಿನೆವೆಗೆ ಹೋಗಿ ಅದಕ್ಕೆ ವಿರೋಧವಾಗಿ ಪ್ರಸಂಗಿಸು, ಏಕೆಂದರೆ ಅವರ ಕೆಟ್ಟತನವು ನನ್ನ ಮುಂದೆ ಏರಿ ಬಂದಿದೆ,” ಎಂಬುದು.<verse eid="JON 1:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="JON 1:3"/>ಆದರೆ ಯೋನನು ಯೆಹೋವ ದೇವರ ಸಮ್ಮುಖದಿಂದ ತಾರ್ಷೀಷಿಗೆ ಓಡಿಹೋಗುವುದಕ್ಕೆ ಎದ್ದು, ಯೊಪ್ಪಕ್ಕೆ ಇಳಿದು ತಾರ್ಷೀಷಿಗೆ ಹೋಗುವ ಹಡಗನ್ನು ಕಂಡು, ಪ್ರಯಾಣದ ದರವನ್ನು ಕೊಟ್ಟು, ಯೆಹೋವ ದೇವರ ಸಮ್ಮುಖದಿಂದ ತಪ್ಪಿಸಿಕೊಂಡು ಹೋಗಲು, ಪ್ರಯಾಣಮಾಡುತ್ತಿದ್ದ ಹಡಗಿನವರೊಡನೆ ತಾರ್ಷೀಷಿಗೆ ಹೋಗುವುದಕ್ಕೆ ಅದನ್ನು ಹತ್ತಿದನು.<verse eid="JON 1:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="JON 1:4"/>ಆದರೆ ಯೆಹೋವ ದೇವರು ದೊಡ್ಡ ಗಾಳಿಯನ್ನು ಸಮುದ್ರದ ಮೇಲೆ ಕಳುಹಿಸಿದರು. ಸಮುದ್ರದಲ್ಲಿ ಮಹಾ ಬಿರುಗಾಳಿ ಉಂಟಾಗಿ, ಹಡಗು ಒಡೆಯುವುದರಲ್ಲಿತ್ತು. <verse eid="JON 1:4"/><verse number="5" style="v" sid="JON 1:5"/>ಆಗ ಹಡಗಿನವರು ಭಯಪಟ್ಟು ಒಬ್ಬೊಬ್ಬನು ತನ್ನ ತನ್ನ ದೇವರಿಗೆ ಕೂಗಿ, ಹಡಗನ್ನು ಹಗುರ ಮಾಡುವ ಹಾಗೆ ಅದರಲ್ಲಿದ್ದ ಸರಕುಗಳನ್ನು ಸಮುದ್ರದಲ್ಲಿ ಹಾಕಿಬಿಟ್ಟರು.</para>
  <para style="p" vid="JON 1:5">ಆದರೆ ಯೋನನು ಹಡಗಿನ ಕೆಳಭಾಗಕ್ಕೆ ಇಳಿದು ಹೋಗಿ, ಮಲಗಿಕೊಂಡು ಗಾಢ ನಿದ್ರೆಯಲ್ಲಿದ್ದನು. <verse eid="JON 1:5"/><verse number="6" style="v" sid="JON 1:6"/>ಆಗ ಹಡಗಿನ ಯಜಮಾನನು ಅವನ ಬಳಿಗೆ ಬಂದು, “ನೀನು ನಿದ್ರೆ ಮಾಡುವುದೇಕೆ? ಎದ್ದು ನಿನ್ನ ದೇವರನ್ನು ಪ್ರಾರ್ಥಿಸು. ಒಂದು ವೇಳೆ ನಿನ್ನ ದೇವರು ನಮ್ಮ ಮೇಲೆ ಲಕ್ಷ್ಯವಿಟ್ಟು, ನಾವು ನಾಶವಾಗದಂತೆ ಕಾಪಾಡಿಯಾರು!” ಎಂದನು.<verse eid="JON 1:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="JON 1:7"/>ಆಗ ನಾವಿಕರು ಒಬ್ಬರಿಗೊಬ್ಬರು, “ಬನ್ನಿ, ಚೀಟುಗಳನ್ನು ಹಾಕೋಣ. ಯಾವನ ನಿಮಿತ್ತ ಈ ಕೇಡು ನಮಗೆ ಬಂತೋ ತಿಳಿಯೋಣ,” ಎಂದು ಹೇಳಿಕೊಂಡರು. ಹಾಗೆಯೇ ಅವರು ಚೀಟುಗಳನ್ನು ಹಾಕಿದಾಗ, ಯೋನನ ಮೇಲೆ ಚೀಟು ಬಿತ್ತು. <verse eid="JON 1:7"/><verse number="8" style="v" sid="JON 1:8"/>ಆಗ ಅವರು ಅವನಿಗೆ, “ನಮಗಾಗಿ ಈ ಕಷ್ಟವನ್ನೆಲ್ಲಾ ಉಂಟುಮಾಡಿದ್ದಕ್ಕೆ ಯಾರು ಜವಾಬ್ದಾರರೆಂದು ನಮಗೆ ತೋರಿಸು. ನಿನ್ನ ಕೆಲಸವೇನು? ಎಲ್ಲಿಂದ ಬಂದೆ? ನಿನ್ನ ದೇಶ ಯಾವುದು? ನೀನು ಯಾವ ಜನಾಂಗದವನು?” ಎಂದು ಪ್ರಶ್ನಿಸಿದರು.<verse eid="JON 1:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="JON 1:9"/>ಅವನು ಅವರಿಗೆ, “ನಾನು ಹಿಬ್ರಿಯನು. ಸಮುದ್ರವನ್ನೂ, ಒಣಗಿದ ಭೂಮಿಯನ್ನೂ ಉಂಟುಮಾಡಿದ ಪರಲೋಕದ ದೇವರಾದ ಯೆಹೋವ ದೇವರಿಗೆ ನಾನು ಆರಾಧಿಸುವವನಾಗಿದ್ದೇನೆ,” ಎಂದು ಹೇಳಿದನು.<verse eid="JON 1:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="JON 1:10"/>ಆಗ ಆ ಮನುಷ್ಯರು ಬಹಳ ಭಯಪಟ್ಟು, “ನೀನು ಏನು ಮಾಡಿದ್ದೀ?” ಎಂದು ಅವನನ್ನು ಕೇಳಿದರು. ಏಕೆಂದರೆ ಯೆಹೋವ ದೇವರ ಸಮ್ಮುಖದಿಂದ ಅವನು ಓಡಿ ಹೋಗುತ್ತಿದ್ದಾನೆಂದು ಆ ಮನುಷ್ಯರಿಗೆ ತಿಳಿದಿತ್ತು. ಏಕೆಂದರೆ ಅವನೇ ಇದನ್ನು ಅವರಿಗೆ ಹೇಳಿದ್ದನು.<verse eid="JON 1:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="JON 1:11"/>ಆಗ ಬಿರುಗಾಳಿ ಮತ್ತಷ್ಟು ತೀವ್ರಗೊಳ್ಳುತ್ತಿತ್ತು. ನಾವಿಕರು ಯೋನನಿಗೆ, “ಸಮುದ್ರ ಶಾಂತವಾಗಬೇಕಾದರೆ, ನಿನ್ನನ್ನು ಏನು ಮಾಡಬೇಕು? ಹೇಳು,” ಎಂದು ಕೇಳಿದರು.<verse eid="JON 1:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="JON 1:12"/>ಅವನು ಅವರಿಗೆ, “ನನ್ನನ್ನು ಎತ್ತಿ ಸಮುದ್ರದಲ್ಲಿ ಹಾಕಿರಿ, ಆಗ ಸಮುದ್ರವು ಶಾಂತವಾಗುವುದು. ಏಕೆಂದರೆ ನನ್ನ ನಿಮಿತ್ತ ಈ ದೊಡ್ಡ ಬಿರುಗಾಳಿ, ನಿಮ್ಮ ಮೇಲೆ ಬಂತೆಂದು ಬಲ್ಲೆನು,” ಎಂದನು.<verse eid="JON 1:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="JON 1:13"/>ಆದರೂ ಆ ಮನುಷ್ಯರು ದಡಕ್ಕೆ ತಿರುಗಿಕೊಳ್ಳುವ ಹಾಗೆ ಬಲವಾಗಿ ಹುಟ್ಟುಹಾಕಿದರು. ಆದರೆ ಅವರಿಂದಾಗದೆ ಹೋಯಿತು. ಏಕೆಂದರೆ ಸಮುದ್ರವು ಅವರಿಗೆ ಎದುರಾಗಿ, ಹೆಚ್ಚೆಚ್ಚಾಗಿ ತೆರೆಗಳಿಂದ ರೋಷಗೊಂಡಿತು. <verse eid="JON 1:13"/><verse number="14" style="v" sid="JON 1:14"/>ಆಗ ಅವರು ಯೆಹೋವ ದೇವರಿಗೆ ಕೂಗಿ, “ಯೆಹೋವ ದೇವರೇ, ನಾವು ಈ ಮನುಷ್ಯನ ಜೀವದ ನಿಮಿತ್ತ ನಾಶವಾಗದಿರಲಿ. ಅಪರಾಧವಿಲ್ಲದ ರಕ್ತವನ್ನು ನಮ್ಮ ಮೇಲೆ ಹೊರಿಸಬೇಡಿರಿ. ಯೆಹೋವ ದೇವರೇ, ಇದೆಲ್ಲವೂ ಸಂಭವಿಸಿರುವುದು ನಿಮ್ಮ ಚಿತ್ತವಲ್ಲವೇ?” ಎಂದು ಹೇಳಿದರು. <verse eid="JON 1:14"/><verse number="15" style="v" sid="JON 1:15"/>ಆಗ ಅವರು ಯೋನನನ್ನು ಎತ್ತಿ ಸಮುದ್ರದಲ್ಲಿ ಹಾಕಿದರು. ಆಗ ಸಮುದ್ರವು ತನ್ನ ಉಗ್ರವನ್ನು ನಿಲ್ಲಿಸಿಬಿಟ್ಟಿತು. <verse eid="JON 1:15"/><verse number="16" style="v" sid="JON 1:16"/>ಆಗ ಆ ಜನರು, ಯೆಹೋವ ದೇವರಿಗೆ ಬಹಳವಾಗಿ ಭಯಪಟ್ಟು, ಅವರಿಗೆ ಬಲಿ ಅರ್ಪಿಸಿ, ಹರಕೆಗಳನ್ನು ಸಲ್ಲಿಸಿದರು.<verse eid="JON 1:16"/></para>
  <para style="s1">ಯೋನನ ಪ್ರಾರ್ಥನೆ</para>
  <para style="p">
    <verse number="17" style="v" sid="JON 1:17"/>ಆದರೆ ಯೆಹೋವ ದೇವರು ಯೋನನನ್ನು ನುಂಗುವಂತೆ ದೊಡ್ಡ ಮೀನನ್ನು ಸಿದ್ಧಮಾಡಿದ್ದರು. ಯೋನನು ಆ ಮೀನಿನ ಹೊಟ್ಟೆಯಲ್ಲಿ ಮೂರು ಹಗಲು ಮತ್ತು ಮೂರು ರಾತ್ರಿ ಇದ್ದನು.<verse eid="JON 1:17"/></para>
  <chapter eid="JON 1"/>
  <chapter number="2" style="c" sid="JON 2"/>
  <para style="nb">
    <verse number="1" style="v" sid="JON 2:1"/>ಆಗ ಯೋನನು ಮೀನಿನ ಹೊಟ್ಟೆಯೊಳಗಿಂದ ತನ್ನ ದೇವರಾದ ಯೆಹೋವ ದೇವರಿಗೆ ಪ್ರಾರ್ಥನೆಮಾಡಿದನು. <verse eid="JON 2:1"/><verse number="2" style="v" sid="JON 2:2"/>ಅವನು ಹೀಗೆ ಹೇಳಿದನು:</para>
  <para style="q1" vid="JON 2:2">“ನಾನು ನನ್ನ ವ್ಯಥೆಯಲ್ಲಿ ಯೆಹೋವ ದೇವರಿಗೆ ಮೊರೆಯಿಟ್ಟೆನು.</para>
  <para style="q2" vid="JON 2:2">ಅವರು ನನ್ನ ಕೂಗನ್ನು ಕೇಳಿದರು.</para>
  <para style="q1" vid="JON 2:2">ಪಾತಾಳದ ಗರ್ಭದೊಳಗಿಂದ ಸಹಾಯಕ್ಕಾಗಿ ನಾನು ಕೂಗಿದೆನು,</para>
  <para style="q2" vid="JON 2:2">ಆಗ ನನ್ನ ಕರೆಯನ್ನು ನೀವು ಕೇಳಿದಿರಿ.<verse eid="JON 2:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="JON 2:3"/>ನನ್ನನ್ನು ನೀವು ಅಗಾಧದಲ್ಲಿಯೂ,</para>
  <para style="q2" vid="JON 2:3">ಸಮುದ್ರಗಳ ಮಧ್ಯದಲ್ಲಿಯೂ ಹಾಕಿದಿರಿ.</para>
  <para style="q2" vid="JON 2:3">ಪ್ರವಾಹಗಳು ನನ್ನನ್ನು ಸುತ್ತಿಕೊಂಡವು.</para>
  <para style="q1" vid="JON 2:3">ನಿಮ್ಮ ಎಲ್ಲಾ ಅಲೆಗಳೂ ನಿಮ್ಮ ತೆರೆಗಳೂ</para>
  <para style="q2" vid="JON 2:3">ನನ್ನ ಮೇಲೆ ದಾಟಿಹೋದವು.<verse eid="JON 2:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="JON 2:4"/>ಆಗ ನಾನು ಹೇಳಿದ್ದು,</para>
  <para style="q2" vid="JON 2:4">‘ನಿಮ್ಮ ಕಣ್ಣುಗಳ ಎದುರಿನಿಂದ ಬಹಿಷ್ಕೃತನಾಗಿದ್ದೇನೆ.</para>
  <para style="q1" vid="JON 2:4">ಆದರೂ ನಾನು ನಿಮ್ಮ ಪರಿಶುದ್ಧ</para>
  <para style="q2" vid="JON 2:4">ಮಂದಿರದ ಕಡೆಗೆ ಪುನಃ ನೋಡುವೆನು.’<verse eid="JON 2:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="JON 2:5"/>ನನ್ನನ್ನು ಸುತ್ತುತ್ತಿದ್ದ ನೀರು, ನನ್ನನ್ನು ಭಯಪಡಿಸಿತು.</para>
  <para style="q2" vid="JON 2:5">ಅಗಾಧವು ನನ್ನನ್ನು ಸುತ್ತಲೂ ಮುಚ್ಚಿಕೊಂಡಿತು.</para>
  <para style="q2" vid="JON 2:5">ಜಂಬು ಹುಲ್ಲು ನನ್ನ ತಲೆಗೆ ಸುತ್ತಲಾಗಿತ್ತು.<verse eid="JON 2:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="JON 2:6"/>ಬೆಟ್ಟಗಳ ಅಡಿಗಳ ಪರ್ಯಂತರ ಇಳಿದು ಹೋದೆನು.</para>
  <para style="q2" vid="JON 2:6">ಕೆಳಗಿನ ಭೂಮಿಯು ನನ್ನನ್ನು ಶಾಶ್ವತವಾಗಿ ನಿರ್ಬಂಧಿಸಿತು.</para>
  <para style="q1" vid="JON 2:6">ಆದರೂ ದೇವರಾದ ನನ್ನ ಯೆಹೋವ ದೇವರೇ,</para>
  <para style="q2" vid="JON 2:6">ನೀವು ನನ್ನ ಪ್ರಾಣವನ್ನು ತಗ್ಗಿನಿಂದ ಮೇಲಕ್ಕೆ ಎಬ್ಬಿಸಿದ್ದೀರಿ.<verse eid="JON 2:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="JON 2:7"/>“ನನ್ನ ಪ್ರಾಣವು ನನ್ನಲ್ಲಿ ಕುಂದಿ ಹೋದಾಗ,</para>
  <para style="q2" vid="JON 2:7">ಯೆಹೋವ ದೇವರೇ ನಿಮ್ಮನ್ನು ಜ್ಞಾಪಕಮಾಡಿಕೊಂಡೆನು.</para>
  <para style="q1" vid="JON 2:7">ನನ್ನ ಪ್ರಾರ್ಥನೆಯು ನಿಮ್ಮ ಬಳಿಗೆ</para>
  <para style="q2" vid="JON 2:7">ನಿಮ್ಮ ಪರಿಶುದ್ಧ ಮಂದಿರದೊಳಗೆ ಬಂದಿತು.<verse eid="JON 2:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="JON 2:8"/>“ನಿರುಪಯೋಗ ಮೂರ್ತಿಗಳಿಗೆ ಅಂಟಿಕೊಳ್ಳುವವರು,</para>
  <para style="q2" vid="JON 2:8">ಅವರದಾಗುವ ದೇವರ ಪ್ರೀತಿಯನ್ನು ಕಳೆದುಕೊಳ್ಳುವರು.<verse eid="JON 2:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="JON 2:9"/>ಆದರೆ ನಾನು ಸ್ತೋತ್ರದ ಗೀತೆಯಿಂದ ನಿಮಗೆ ಬಲಿ ಅರ್ಪಿಸುವೆನು.</para>
  <para style="q2" vid="JON 2:9">ನಾನು ಮಾಡಿದ ಹರಕೆಯನ್ನು ತೀರಿಸುವೆನು.</para>
  <para style="q1" vid="JON 2:9">ಆಗ ನಾನು, ‘ರಕ್ಷಣೆಯು ಯೆಹೋವ ದೇವರಿಂದಲೇ ಬರುವುದು,’ ಎಂದು ಹೇಳಿದನು.”<verse eid="JON 2:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="JON 2:10"/>ಆಗ ಯೆಹೋವ ದೇವರು ಮೀನಿಗೆ ಹೇಳಿದ್ದರಿಂದ, ಅದು ಯೋನನನ್ನು ಒಣಭೂಮಿಯ ಮೇಲೆ ಕಾರಿಬಿಟ್ಟಿತು.<verse eid="JON 2:10"/></para>
  <chapter eid="JON 2"/>
  <chapter number="3" style="c" sid="JON 3"/>
  <para style="s1">ಯೋನನು ನಿನೆವೆಗೆ ಹೋದದ್ದು</para>
  <para style="p">
    <verse number="1" style="v" sid="JON 3:1"/>ಯೆಹೋವ ದೇವರ ವಾಕ್ಯವು ಎರಡನೆಯ ಸಾರಿ ಯೋನನಿಗೆ ಬಂದಿತು. <verse eid="JON 3:1"/><verse number="2" style="v" sid="JON 3:2"/>“ಎದ್ದು ಆ ದೊಡ್ಡ ಪಟ್ಟಣವಾದ ನಿನೆವೆಗೆ ಹೋಗಿ, ನಾನು ನಿನಗೆ ಹೇಳಿದ ಸಂದೇಶವನ್ನು ಅದರ ನಿವಾಸಿಗಳಿಗೆ ಸಾರು,” ಎಂದು ಹೇಳಿದರು.<verse eid="JON 3:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="JON 3:3"/>ಹೀಗೆ ಯೋನನು ಯೆಹೋವ ದೇವರ ಮಾತಿಗೆ ವಿಧೇಯನಾಗಿ ನಿನೆವೆಗೆ ಹೋದನು. ನಿನೆವೆಯು ಮೂರು ದಿವಸದ ಪ್ರಯಾಣದ ಮಹಾ ದೊಡ್ಡ ಪಟ್ಟಣವಾಗಿತ್ತು. <verse eid="JON 3:3"/><verse number="4" style="v" sid="JON 3:4"/>ಆಗ ಯೋನನು ಒಂದು ದಿವಸದ ಪ್ರಯಾಣಮಾಡಿ, ಪಟ್ಟಣದಲ್ಲಿ ಪ್ರವೇಶಿಸಿ, “ಇನ್ನು ನಾಲ್ವತ್ತು ದಿವಸಗಳಾದ ಮೇಲೆ ನಿನೆವೆ ನಾಶವಾಗುವುದು,” ಎಂದು ಕೂಗಿ ಹೇಳಿದನು. <verse eid="JON 3:4"/><verse number="5" style="v" sid="JON 3:5"/>ನಿನೆವೆಯ ಮನುಷ್ಯರು, ದೇವರನ್ನು ನಂಬಿ, ಉಪವಾಸವನ್ನು ಸಾರಿ, ಅವರಲ್ಲಿ ದೊಡ್ಡವನು ಮೊದಲುಗೊಂಡು ಚಿಕ್ಕವನವರೆಗೂ ಗೋಣಿತಟ್ಟನ್ನು ಉಟ್ಟುಕೊಂಡರು.<verse eid="JON 3:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="JON 3:6"/>ಆ ಮಾತು ನಿನೆವೆಯ ಅರಸನಿಗೆ ಮುಟ್ಟಿದಾಗ, ಅವನು ತನ್ನ ಸಿಂಹಾಸನದಿಂದ ಎದ್ದು, ತನ್ನ ನಿಲುವಂಗಿಯನ್ನು ತೆಗೆದಿಟ್ಟು, ಗೋಣಿತಟ್ಟನ್ನು ಉಟ್ಟುಕೊಂಡು, ಬೂದಿಯಲ್ಲಿ ಕುಳಿತುಕೊಂಡನು. <verse eid="JON 3:6"/><verse number="7" style="v" sid="JON 3:7"/>ಅವನು ನಿನೆವೆಯಲ್ಲಿ ಈ ಘೋಷಣೆಯನ್ನು ಮಾಡಿದನು:</para>
  <para style="pmo" vid="JON 3:7">“ಅರಸನ ಮತ್ತು ಶ್ರೇಷ್ಠರ ತೀರ್ಪಿನ ಪ್ರಕಾರ:</para>
  <para style="pm" vid="JON 3:7">“ಮನುಷ್ಯರಾಗಲಿ, ಮೃಗಗಳಾಗಲಿ, ದನಗಳಾಗಲಿ, ಕುರಿಗಳಾಗಲಿ, ಏನನ್ನೂ ರುಚಿ ನೋಡದಿರಲಿ, ಮೇಯದಿರಲಿ, ನೀರನ್ನು ಕುಡಿಯದಿರಲಿ. <verse eid="JON 3:7"/><verse number="8" style="v" sid="JON 3:8"/>ಆದರೆ ಮನುಷ್ಯರೂ ಮೃಗಗಳೂ ಗೋಣಿತಟ್ಟು ಹಾಕಿಕೊಂಡು, ಜೋರಾದ ಧ್ವನಿಯಿಂದ ದೇವರಿಗೆ ಮೊರೆಯಿಡಲಿ. ಎಲ್ಲರೂ ತಮ್ಮ ತಮ್ಮ ದುರ್ಮಾರ್ಗಗಳನ್ನೂ, ತಮ್ಮ ತಮ್ಮ ಕೈಗಳಲ್ಲಿರುವ ಹಿಂಸಾಚಾರವನ್ನೂ ಬಿಟ್ಟು ತಿರುಗಲಿ. <verse eid="JON 3:8"/><verse number="9" style="v" sid="JON 3:9"/>ಹೀಗೆ ಮಾಡಿದರೆ, ದೇವರು ಒಂದು ವೇಳೆ ತಮ್ಮ ಮನಸ್ಸನ್ನು ಬದಲಾಯಿಸಿ, ಅನುಕಂಪದಿಂದ ತಮ್ಮ ಉಗ್ರಕೋಪವನ್ನು ತಡೆದು, ನಾವು ನಾಶವಾಗದೆ ಉಳಿಸುವರೇನೋ, ಯಾರು ಬಲ್ಲರು?”<verse eid="JON 3:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="JON 3:10"/>ಆಗ ದೇವರು, ನಿನೆವೆಯವರು ತಮ್ಮ ದುರ್ಮಾರ್ಗವನ್ನು ಬಿಟ್ಟು ತಿರುಗಿಕೊಂಡರೆಂದು ಕಂಡು, ತಾವು ವಿಧಿಸುವುದಾಗಿ ನುಡಿದ ವಿನಾಶವನ್ನು ಅವರ ಮೇಲೆ ಬರಮಾಡದೆ, ಅವರನ್ನು ಕನಿಕರಿಸಿದರು.<verse eid="JON 3:10"/></para>
  <chapter eid="JON 3"/>
  <chapter number="4" style="c" sid="JON 4"/>
  <para style="s1">ದೇವರ ಕರುಣೆಯ ಮೇಲೆ ಯೋನನ ಕೋಪ</para>
  <para style="p">
    <verse number="1" style="v" sid="JON 4:1"/>ಆದರೆ ಯೋನನು ತುಂಬಾ ಬೇಸರಗೊಂಡನು. ಅವನಿಗೆ ಬಹು ಕೋಪ ಬಂತು. <verse eid="JON 4:1"/><verse number="2" style="v" sid="JON 4:2"/>ಅವನು ಯೆಹೋವ ದೇವರಿಗೆ ಪ್ರಾರ್ಥನೆಮಾಡಿ: “ಯೆಹೋವ ದೇವರೇ, ನಾನು ನನ್ನ ದೇಶದಲ್ಲಿದ್ದಾಗಲೇ ಇದನ್ನು ನಾನು ಹೇಳಲಿಲ್ಲವೋ? ಆದಕಾರಣ ನಾನು ಮೊದಲು ತಾರ್ಷೀಷಿಗೆ ಓಡಿ ಹೋದೆನು. ನೀವು ಕೃಪೆಯೂ ಅನುಕಂಪವೂ ಪ್ರೀತಿಯಲ್ಲಿ ಐಶ್ವರ್ಯವುಳ್ಳ ದೇವರೆಂದೂ ಕೇಡಿನ ವಿಷಯವಾಗಿ ಮನಮರುಗುವವರೆಂದೂ ನನಗೆ ತಿಳಿದಿತ್ತು. <verse eid="JON 4:2"/><verse number="3" style="v" sid="JON 4:3"/>ಆದ್ದರಿಂದ ಯೆಹೋವ ದೇವರೇ, ಈಗಲೇ ನನ್ನ ಪ್ರಾಣವನ್ನು ನನ್ನಿಂದ ತೆಗೆಯಿರಿ, ಏಕೆಂದರೆ ನಾನು ಬದುಕುವುದಕ್ಕಿಂತ ಸಾಯುವುದು ಒಳ್ಳೆಯದು,” ಎಂದನು.<verse eid="JON 4:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="JON 4:4"/>ಆದರೆ ಯೆಹೋವ ದೇವರು, “ನೀನು ಹೀಗೆ ಕೋಪ ಮಾಡಿಕೊಳ್ಳುವುದು ಸರಿಯೋ?” ಎಂದು ಯೋನನಿಗೆ ಹೇಳಿದರು.<verse eid="JON 4:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="JON 4:5"/>ಆಗ ಯೋನನು ಪಟ್ಟಣವನ್ನು ಬಿಟ್ಟು, ಪಟ್ಟಣದ ಪೂರ್ವದಿಕ್ಕಿನ ಕಡೆಯಲ್ಲಿ ಕುಳಿತುಕೊಂಡು, ಗುಡಿಸಲನ್ನು ಕಟ್ಟಿಕೊಂಡು, ಪಟ್ಟಣದಲ್ಲಿ ಏನಾಗುವುದೆಂದು ನೋಡುವವರೆಗೆ ಗುಡಿಸಲಿನ ನೆರಳಿನಲ್ಲಿ ಕುಳಿತುಕೊಂಡನು. <verse eid="JON 4:5"/><verse number="6" style="v" sid="JON 4:6"/>ದೇವರಾದ ಯೆಹೋವ ದೇವರು ಒಂದು ಸೋರೆ ಬಳ್ಳಿಯನ್ನು ಹಬ್ಬಿಸಿ, ಅದು ಯೋನನ ಮೇಲೆ ಹಬ್ಬಿ ಬಂದು, ಅವನ ತಲೆಗೆ ನೆರಳು ಕೊಟ್ಟು, ಅವನ ದುಃಖದಿಂದ ಅವನನ್ನು ಬಿಡಿಸುವಂತೆ ಮಾಡಿದರು. ಯೋನನು ಆ ಸೋರೆ ಬಳ್ಳಿಯ ವಿಷಯವಾಗಿ ಬಹಳ ಸಂತೋಷಪಟ್ಟನು. <verse eid="JON 4:6"/><verse number="7" style="v" sid="JON 4:7"/>ಮಾರನೆಯ ದಿವಸ ಉದಯವಾದಾಗ, ದೇವರು ಒಂದು ಹುಳುವನ್ನು ಸಿದ್ಧಮಾಡಿದರು. ಅದು ಸೋರೆ ಬಳ್ಳಿಯನ್ನು ಒಣಗುವ ಹಾಗೆ ಹೊಡೆಯಿತು. <verse eid="JON 4:7"/><verse number="8" style="v" sid="JON 4:8"/>ಸೂರ್ಯೋದಯವಾದಾಗ ದೇವರು ಉಗ್ರವಾದ ಪೂರ್ವ ಗಾಳಿಯನ್ನು ಸಿದ್ಧಮಾಡಿದರು. ಆಗ ಬಿಸಿಲು ಯೋನನ ತಲೆಯ ಮೇಲೆ ಬಡಿದದ್ದರಿಂದ, ಅವನು ಮೂರ್ಛೆ ಹೋಗಿ, ಮರಣವನ್ನು ಕೇಳಿಕೊಂಡು, “ನಾನು ಬದುಕುವುದಕ್ಕಿಂತ ಸಾಯುವುದು ಒಳ್ಳೆಯದು,” ಎಂದನು.<verse eid="JON 4:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="JON 4:9"/>ಆದರೆ ದೇವರು ಯೋನನಿಗೆ, “ನೀನು ಸೋರೆ ಬಳ್ಳಿಯನ್ನು ಕುರಿತು ಕೋಪ ಮಾಡುವುದು ಸರಿಯೋ?” ಎಂದರು.</para>
  <para style="p" vid="JON 4:9">ಅವನು, “ನಾನು ಸಾಯುವಷ್ಟು ಕೋಪ ಮಾಡುವುದು ಒಳ್ಳೆಯದೇ,” ಎಂದನು.<verse eid="JON 4:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="JON 4:10"/>ಆದರೆ ಯೆಹೋವ ದೇವರು, “ನೀನು ಕಷ್ಟಪಡದಂಥ, ಬೆಳೆಸದಂಥ, ಒಂದು ರಾತ್ರಿಯಲ್ಲಿ ಹುಟ್ಟಿ, ಒಂದೇ ರಾತ್ರಿಯಲ್ಲಿ ನಾಶವಾದಂಥ ಸೋರೆ ಬಳ್ಳಿಗಾಗಿ ಚಿಂತಿಸಿದೆಯಲ್ಲಾ, <verse eid="JON 4:10"/><verse number="11" style="v" sid="JON 4:11"/>ಹಾಗಾದರೆ ಎಡಬಲ ಕೈಗಳನ್ನು ತಿಳಿಯದವರಾದ ಲಕ್ಷದ ಇಪ್ಪತ್ತು ಸಾವಿರಕ್ಕಿಂತ ಹೆಚ್ಚಾದ ಜನರು ಬಹಳ ಪಶುಪ್ರಾಣಿಗಳೂ ಸಹ ಇರುವ ಆ ದೊಡ್ಡ ಪಟ್ಟಣವಾದ ನಿನೆವೆಯನ್ನು ನಾನು ಚಿಂತಿಸಬಾರದೋ?” ಎಂದರು.<verse eid="JON 4:11"/></para>
  <chapter eid="JON 4"/>
</usx>
