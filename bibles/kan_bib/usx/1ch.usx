<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="1CH" style="id">- Biblica® Open Kannada Contemporary Version</book>
  <para style="h">1 ಪೂರ್ವಕಾಲ ವೃತ್ತಾಂತ</para>
  <para style="toc1">ಪೂರ್ವಕಾಲ ವೃತ್ತಾಂತ ಪ್ರಥಮ ಭಾಗ</para>
  <para style="toc2">1 ಪೂರ್ವಕಾಲ ವೃತ್ತಾಂತ</para>
  <para style="toc3">1 ಪೂರ್ವ</para>
  <para style="mt1">ಪೂರ್ವಕಾಲ ವೃತ್ತಾಂತ</para>
  <para style="mt2">ಪ್ರಥಮ ಭಾಗ</para>
  <chapter number="1" style="c" sid="1CH 1"/>
  <para style="s1">ಆದಾಮನಿಂದ ಅಬ್ರಹಾಮನವರೆಗೆ ಉತ್ಪತ್ತಿಯಾದ ಜನಾಂಗಗಳ ಪಟ್ಟಿ</para>
  <para style="s2">ನೋಹನ ಮಕ್ಕಳಿಗೆ</para>
  <para style="li1">
    <verse number="1" style="v" sid="1CH 1:1"/>ಆದಾಮ, ಸೇತ್, ಎನೋಷ್,<verse eid="1CH 1:1"/></para>
  <para style="li1">
    <verse number="2" style="v" sid="1CH 1:2"/>ಕೇನಾನ್, ಮಹಲಲೇಲ್ ಯೆರೆದ್,<verse eid="1CH 1:2"/></para>
  <para style="li1">
    <verse number="3" style="v" sid="1CH 1:3"/>ಹನೋಕ್, ಮೆತೂಷೆಲಹ, ಲೆಮೆಕ್,</para>
  <para style="li1" vid="1CH 1:3">ನೋಹ.<verse eid="1CH 1:3"/></para>
  <para style="b"/>
  <para style="li4">
    <verse number="4" style="v" sid="1CH 1:4"/>ನೋಹನ ಮಕ್ಕಳು: ಶೇಮ್, ಹಾಮ್, ಯೆಫೆತ್.<verse eid="1CH 1:4"/></para>
  <para style="s2">ಯೆಫೆತ್ಯರು</para>
  <para style="li1">
    <verse number="5" style="v" sid="1CH 1:5"/>ಯೆಫೆತನ ಪುತ್ರರು:</para>
  <para style="li2" vid="1CH 1:5">ಗೋಮೆರ್, ಮಾಗೋಗ್, ಮಾದಯ್, ಯಾವಾನ್, ತೂಬಲ್, ಮೆಷೆಕ್ ಮತ್ತು ತೀರಾಸ್.<verse eid="1CH 1:5"/></para>
  <para style="li1">
    <verse number="6" style="v" sid="1CH 1:6"/>ಗೋಮೆರನ ಪುತ್ರರು:</para>
  <para style="li2" vid="1CH 1:6">ಅಷ್ಕೆನಜ್, ರೀಫತ್, ತೋಗರ್ಮ.<verse eid="1CH 1:6"/></para>
  <para style="li1">
    <verse number="7" style="v" sid="1CH 1:7"/>ಯಾವಾನನ ಮಕ್ಕಳು:</para>
  <para style="li2" vid="1CH 1:7">ಎಲೀಷಾ, ತಾರ್ಷೀಷ್, ಕಿತ್ತೀಮ್, ದೋದಾನೀಮ್.<verse eid="1CH 1:7"/></para>
  <para style="s2">ಹಾಮನ್ಯರು</para>
  <para style="li1">
    <verse number="8" style="v" sid="1CH 1:8"/>ಹಾಮನ ಪುತ್ರರು:</para>
  <para style="li2" vid="1CH 1:8">ಕೂಷ್, ಈಜಿಪ್ಟ್, ಪೂಟ್, ಕಾನಾನ್.<verse eid="1CH 1:8"/></para>
  <para style="li1">
    <verse number="9" style="v" sid="1CH 1:9"/>ಕೂಷನ ಪುತ್ರರು:</para>
  <para style="li2" vid="1CH 1:9">ಸೆಬ, ಹವೀಲ, ಸಬ್ತಾ, ರಾಮ, ಸಬ್ತೆಕ.</para>
  <para style="li1" vid="1CH 1:9">ರಾಮನ ಪುತ್ರರು:</para>
  <para style="li2" vid="1CH 1:9">ಶೆಬಾ ಮತ್ತು ದೆದಾನ್.<verse eid="1CH 1:9"/></para>
  <para style="li1">
    <verse number="10" style="v" sid="1CH 1:10"/>ಕೂಷನು ನಿಮ್ರೋದನ ತಂದೆಯಾಗಿದ್ದನು,</para>
  <para style="li2" vid="1CH 1:10">ಇವನು ಭೂಮಿಯ ಮೇಲೆ ಬಲಿಷ್ಠ ಯುದ್ಧವೀರನಾದನು.<verse eid="1CH 1:10"/></para>
  <para style="li1">
    <verse number="11" style="v" sid="1CH 1:11"/>ಈಜಿಪ್ಟನವರಿಂದ,</para>
  <para style="li2" vid="1CH 1:11">ಲೂದ್ಯರು, ಅನಾಮ್ಯರು, ಲೆಹಾಬ್ಯರು, ನಫ್ತುಹ್ಯರು, <verse eid="1CH 1:11"/><verse number="12" style="v" sid="1CH 1:12"/>ಪತ್ರುಸ್ಯರು, ಕಸ್ಲುಹ್ಯರು, ಕಫ್ತೋರ್ಯರು ಹುಟ್ಟಿದರು. ಕಸ್ಲುಹ್ಯರಿಂದ ಫಿಲಿಷ್ಟಿಯರು ಬಂದವರು.<verse eid="1CH 1:12"/></para>
  <para style="li1">
    <verse number="13" style="v" sid="1CH 1:13"/>ಕಾನಾನ್ ವಂಶದಲ್ಲಿ ಮೊದಲು ಹುಟ್ಟಿದವನು ಸೀದೋನ್,</para>
  <para style="li2" vid="1CH 1:13">ಆಮೇಲೆ ಹೇತನು ಹುಟ್ಟಿದನು. <verse eid="1CH 1:13"/><verse number="14" style="v" sid="1CH 1:14"/>ಯೆಬೂಸಿಯರು, ಅಮೋರಿಯರು, ಗಿರ್ಗಾಷಿಯರು, <verse eid="1CH 1:14"/><verse number="15" style="v" sid="1CH 1:15"/>ಹಿವ್ವಿಯರು, ಅರ್ಕಿಯರು, ಸೀನಿಯರು, <verse eid="1CH 1:15"/><verse number="16" style="v" sid="1CH 1:16"/>ಅರ್ವಾದಿಯರು, ಚೆಮಾರಿಯರು, ಹಮಾತಿಯರು, ಕಾನಾನನಿಂದ ಹುಟ್ಟಿದರು.<verse eid="1CH 1:16"/></para>
  <para style="s2">ಶೇಮ್ಯರು</para>
  <para style="li1">
    <verse number="17" style="v" sid="1CH 1:17"/>ಶೇಮನ ಪುತ್ರರು:</para>
  <para style="li2" vid="1CH 1:17">ಏಲಾಮ್, ಅಶ್ಯೂರ್, ಅರ್ಪಕ್ಷದ್, ಲೂದ್, ಅರಾಮ್,</para>
  <para style="li1" vid="1CH 1:17">ಅರಾಮನ ಪುತ್ರರು:</para>
  <para style="li2" vid="1CH 1:17">ಊಚ್, ಹೂಲ್, ಗೆತೆರ್ ಮತ್ತು ಮೆಷೆಕ್.<verse eid="1CH 1:17"/></para>
  <para style="li1">
    <verse number="18" style="v" sid="1CH 1:18"/>ಅರ್ಪಕ್ಷದ್ ಶೆಲಹನ ತಂದೆ;</para>
  <para style="li2" vid="1CH 1:18">ಶೆಲಹ ಏಬೆರನ ತಂದೆ.<verse eid="1CH 1:18"/></para>
  <para style="li1">
    <verse number="19" style="v" sid="1CH 1:19"/>ಏಬೆರನಿಗೆ ಇಬ್ಬರು ಪುತ್ರರು ಹುಟ್ಟಿದರು.</para>
  <para style="li2" vid="1CH 1:19">ಒಬ್ಬನಿಗೆ ಪೆಲೆಗ್<note caller="+" style="f"><char style="fr" closed="false">1:19 </char><char style="fq" closed="false">ಪೆಲೆಗ್ </char><char style="ft" closed="false">ಎಂದರೆ </char><char style="fqa" closed="false">ವಿಭಾಗ</char></note> ಎಂದು ಹೆಸರಿಡಲಾಯಿತು, ಅವನ ಕಾಲದಲ್ಲಿ ಲೋಕದಲ್ಲಿಯ ಜನರು ವಿಭಾಗವಾದದ್ದರಿಂದ ಈ ಹೆಸರು ಅವನಿಗೆ ಬಂದಿತು. ಅವನ ತಮ್ಮನ ಹೆಸರು ಯೊಕ್ತಾನ್.<verse eid="1CH 1:19"/></para>
  <para style="li1">
    <verse number="20" style="v" sid="1CH 1:20"/>ಯೊಕ್ತಾನನ ಸಂತಾನದವರು:</para>
  <para style="li2" vid="1CH 1:20">ಅಲ್ಮೋದಾದ್, ಶೆಲೆಪ್, ಹಜರ್ಮಾವೆತ್, ಯೆರಹ, <verse eid="1CH 1:20"/><verse number="21" style="v" sid="1CH 1:21"/>ಹದೋರಾಮ್, ಊಜಾಲ್, ದಿಕ್ಲಾ, <verse eid="1CH 1:21"/><verse number="22" style="v" sid="1CH 1:22"/>ಏಬಾಲ್<note caller="+" style="f"><char style="fr" closed="false">1:22 </char><char style="ft" closed="false">ಅಥವಾ </char><char style="fqa" closed="false">ಓಬಾಲ್</char></note>, ಅಬೀಮಯೇಲ್, ಶೆಬಾ, <verse eid="1CH 1:22"/><verse number="23" style="v" sid="1CH 1:23"/>ಓಫೀರ್, ಹವೀಲಾ ಹಾಗೂ ಯೋಬಾಬ್ ಹುಟ್ಟಿದರು. ಇವರೆಲ್ಲರೂ ಯೊಕ್ತಾನನ ಪುತ್ರರು.<verse eid="1CH 1:23"/></para>
  <para style="b"/>
  <para style="li1">
    <verse number="24" style="v" sid="1CH 1:24"/>ಶೇಮನಿಂದ ಅಬ್ರಾಮನವರೆಗಿನ ಸಂತತಿಯವರು ಇವರು. ಅರ್ಪಕ್ಷದ್, ಶೆಲಹ,<verse eid="1CH 1:24"/></para>
  <para style="li1">
    <verse number="25" style="v" sid="1CH 1:25"/>ಏಬೆರ್, ಪೆಲೆಗ್, ರೆಗೂ,<verse eid="1CH 1:25"/></para>
  <para style="li1">
    <verse number="26" style="v" sid="1CH 1:26"/>ಸೆರೂಗ್, ನಾಹೋರ್, ತೆರಹ,<verse eid="1CH 1:26"/></para>
  <para style="li1">
    <verse number="27" style="v" sid="1CH 1:27"/>ಅಬ್ರಾಮ್ ಇವನು ಅಬ್ರಹಾಮ ಎಂಬ ಹೆಸರು ಹೊಂದಿದವನು.<verse eid="1CH 1:27"/></para>
  <para style="s1">ಅಬ್ರಹಾಮನ ಕುಟುಂಬ</para>
  <para style="li4">
    <verse number="28" style="v" sid="1CH 1:28"/>ಅಬ್ರಹಾಮನಿಗೆ ಇಬ್ಬರು ಮಕ್ಕಳು: ಇಸಾಕ ಮತ್ತು ಇಷ್ಮಾಯೇಲ್.<verse eid="1CH 1:28"/></para>
  <para style="s2">ಹಾಗರಳ ವಂಶಾವಳಿ</para>
  <para style="li1">
    <verse number="29" style="v" sid="1CH 1:29"/>ಇಷ್ಮಾಯೇಲನ ಮಕ್ಕಳು ಹನ್ನೆರಡು ಗೋತ್ರಗಳ ಮುಖ್ಯಸ್ಥರಾದರು.</para>
  <para style="li2" vid="1CH 1:29">ಅವರು ನೆಬಾಯೋತ್, ಇಷ್ಮಾಯೇಲನ ಹಿರೀಮಗನಿಂದ ಈ ಹೆಸರಿನ ಉತ್ಪತ್ತಿ, ಕೇದಾರ್, ಅದ್ಬೆಯೇಲ್, ಮಿಬ್ಸಾಮ್, <verse eid="1CH 1:29"/><verse number="30" style="v" sid="1CH 1:30"/>ಮಿಷ್ಮಾ, ದೂಮಾ, ಮಸ್ಸಾ, ಹದದ್, ತೇಮ, <verse eid="1CH 1:30"/><verse number="31" style="v" sid="1CH 1:31"/>ಯೆಟೂರ್, ನಾಫೀಷ್, ಕೇದೆಮ.</para>
  <para style="li4" vid="1CH 1:31">ಇಷ್ಮಾಯೇಲನ ಸಂತಾನದವರು ಇವರೇ.<verse eid="1CH 1:31"/></para>
  <para style="s2">ಕೆಟೂರಳ ವಂಶಾವಳಿ</para>
  <para style="li1">
    <verse number="32" style="v" sid="1CH 1:32"/>ಅಬ್ರಹಾಮನಿಗೆ ಕೆಟೂರಳೆಂಬ ಉಪಪತ್ನಿ ಇದ್ದಳು.</para>
  <para style="li2" vid="1CH 1:32">ಅವಳಿಂದ ಜಿಮ್ರಾನ್, ಯೊಕ್ಷಾನ್, ಮೆದಾನ್, ಮಿದ್ಯಾನ್, ಇಷ್ಬಾಕ್, ಶೂಹ ಎಂಬ ಆರು ಜನ ಮಕ್ಕಳು ಜನಿಸಿದರು.</para>
  <para style="li1" vid="1CH 1:32">ಯೊಕ್ಷಾನನಿಗೆ</para>
  <para style="li2" vid="1CH 1:32">ಶೆಬಾ ಮತ್ತು ದೆದಾನ್ ಹುಟ್ಟಿದರು.<verse eid="1CH 1:32"/></para>
  <para style="li1">
    <verse number="33" style="v" sid="1CH 1:33"/>ಮಿದ್ಯಾನನ ಪುತ್ರರು:</para>
  <para style="li2" vid="1CH 1:33">ಏಫಾ, ಏಫೆರ್, ಹನೋಕ್, ಅಬೀದ, ಎಲ್ದಾಯ.</para>
  <para style="li4" vid="1CH 1:33">ಇವರೆಲ್ಲರೂ ಕೆಟೂರಳ ಸಂತತಿಯವರು.<verse eid="1CH 1:33"/></para>
  <para style="s2">ಸಾರಳ ವಂಶಾವಳಿ</para>
  <para style="li4">
    <verse number="34" style="v" sid="1CH 1:34"/>ಅಬ್ರಹಾಮನು ಸಾರಳಿಂದ ಇಸಾಕನನ್ನು ಪಡೆದನು.</para>
  <para style="li1" vid="1CH 1:34">ಇಸಾಕನಿಗೆ ಇಬ್ಬರು ಮಕ್ಕಳು</para>
  <para style="li2" vid="1CH 1:34">ಏಸಾವ ಮತ್ತು ಯಾಕೋಬ.<verse eid="1CH 1:34"/></para>
  <para style="s1">ಏಸಾವನ ಪುತ್ರರು</para>
  <para style="li1">
    <verse number="35" style="v" sid="1CH 1:35"/>ಏಸಾವನ ಪುತ್ರರು</para>
  <para style="li2" vid="1CH 1:35">ಎಲೀಫಜ್, ರೆಯೂವೇಲ, ಯೆಯೂಷ್, ಯಳಾಮ್ ಹಾಗೂ ಕೋರಹ ಎಂಬವರು.<verse eid="1CH 1:35"/></para>
  <para style="li1">
    <verse number="36" style="v" sid="1CH 1:36"/>ಎಲೀಫಜನ ಮಕ್ಕಳು</para>
  <para style="li2" vid="1CH 1:36">ತೇಮಾನ್, ಓಮಾರ್, ಚೆಫೀ<note caller="+" style="f"><char style="fr" closed="false">1:36 </char><char style="ft" closed="false">ಅಥವಾ </char><char style="fqa" closed="false">ಚೆಫೋ</char></note>, ಗತಾಮ್, ಕೆನಜ್;</para>
  <para style="li2" vid="1CH 1:36">ತಿಮ್ನಾ ಅವಳಿಂದ ಜನಿಸಿದ ಅಮಾಲೇಕ್ ಎಂಬವರು.<verse eid="1CH 1:36"/></para>
  <para style="li1">
    <verse number="37" style="v" sid="1CH 1:37"/>ರೆಯೂವೇಲನ ಮಕ್ಕಳು</para>
  <para style="li2" vid="1CH 1:37">ನಹತ್, ಜೆರಹ, ಶಮ್ಮಾ ಮತ್ತು ಮಿಜ್ಜಾ ಎಂಬವರು.<verse eid="1CH 1:37"/></para>
  <para style="s2">ಎದೋಮಿನಲ್ಲಿಯ ಸೇಯೀರನ ಜನರು</para>
  <para style="li1">
    <verse number="38" style="v" sid="1CH 1:38"/>ಈ ಕೆಳಗೆ ನಮೂದಿಸಿದ ಎದೋಮಿನ ಮೂಲ ನಿವಾಸಿಗಳು ಸೇಯೀರನಿಂದ ಹುಟ್ಟಿದವರು</para>
  <para style="li2" vid="1CH 1:38">ಲೋಟಾನ್, ಶೋಬಾಲ್, ಸಿಬೆಯೋನ್, ಅನಾಹ, ದೀಶೋನ್, ಏಚೆರ್, ದೀಶಾನ್.<verse eid="1CH 1:38"/></para>
  <para style="li1">
    <verse number="39" style="v" sid="1CH 1:39"/>ಲೋಟಾನನ ಪುತ್ರರು ಯಾರೆಂದರೆ: ಹೋರಿ ಮತ್ತು ಹೋಮಾಮ್.</para>
  <para style="li2" vid="1CH 1:39">ಲೋಟಾನನಿಗೆ ತಿಮ್ನಾ ಎಂಬ ಸಹೋದರಿ ಇದ್ದಳು.<verse eid="1CH 1:39"/></para>
  <para style="li1">
    <verse number="40" style="v" sid="1CH 1:40"/>ಶೋಬಾಲನ ಮಕ್ಕಳು ಯಾರೆಂದರೆ:</para>
  <para style="li2" vid="1CH 1:40">ಅಲ್ವಾನ್, ಮಾನಹತ್, ಏಬಾಲ್, ಶೆಫೋ ಮತ್ತು ಓನಾಮ್.</para>
  <para style="li1" vid="1CH 1:40">ಸಿಬೆಯೋನನ ಮಕ್ಕಳು</para>
  <para style="li2" vid="1CH 1:40">ಅಯ್ಯಾಹ ಮತ್ತು ಅನಾಹ ಎಂಬುವರು.<verse eid="1CH 1:40"/></para>
  <para style="li1">
    <verse number="41" style="v" sid="1CH 1:41"/>ಅನಾಹನ ಮಗನು</para>
  <para style="li2" vid="1CH 1:41">ದೀಶೋನ್.</para>
  <para style="li1" vid="1CH 1:41">ದೀಶೋನನ ಮಕ್ಕಳು ಯಾರೆಂದರೆ:</para>
  <para style="li2" vid="1CH 1:41">ಹಮ್ರಾನ್, ಎಷ್ಬಾನ್, ಇತ್ರಾನ್ ಮತ್ತು ಕೆರಾನ್.<verse eid="1CH 1:41"/></para>
  <para style="li1">
    <verse number="42" style="v" sid="1CH 1:42"/>ಏಚೆರನ ಮಕ್ಕಳು ಯಾರೆಂದರೆ:</para>
  <para style="li2" vid="1CH 1:42">ಬಿಲ್ಹಾನ್, ಜಾವಾನ್ ಮತ್ತು ಆಕಾನ್.</para>
  <para style="li1" vid="1CH 1:42">ದೀಶಾನನ<note caller="+" style="f"><char style="fr" closed="false">1:42 </char><char style="fq" closed="false">ದೀಶಾನ </char><char style="ft" closed="false">ಹೀಬ್ರೂ ಭಾಷೆಯಲ್ಲಿ </char><char style="fqa" closed="false">ದೀಶೋನ್</char></note> ಮಕ್ಕಳು ಯಾರೆಂದರೆ:</para>
  <para style="li2" vid="1CH 1:42">ಊಚ್ ಮತ್ತು ಅರಾನ್.<verse eid="1CH 1:42"/></para>
  <para style="s2">ಎದೋಮ್ ಅರಸರು</para>
  <para style="li4">
    <verse number="43" style="v" sid="1CH 1:43"/>ಇಸ್ರಾಯೇಲರನ್ನು ಯಾವ ಅರಸನೂ ಆಳುವುದಕ್ಕಿಂತ ಮುಂಚೆ ಎದೋಮ್ ದೇಶದಲ್ಲಿ ಆಳಿದ ಅರಸರು ಇವರೇ:</para>
  <para style="li1" vid="1CH 1:43">ಬೆಯೋರನ ಮಗನಾದ ಬೆಲಗನು; ಅವನ ಪಟ್ಟಣದ ಹೆಸರು ದಿನ್ಹಾಬಾ.<verse eid="1CH 1:43"/></para>
  <para style="li1">
    <verse number="44" style="v" sid="1CH 1:44"/>ಬೆಲಗನ ಮರಣದ ನಂತರ ಅವನ ಬದಲಾಗಿ ಬೊಚ್ರದವನಾದ ಜೆರಹನ ಮಗ ಯೋಬಾಬನು ಉತ್ತರಾಧಿಕಾರಿಯಾದನು.<verse eid="1CH 1:44"/></para>
  <para style="li1">
    <verse number="45" style="v" sid="1CH 1:45"/>ಯೋಬಾಬನ ಮರಣದ ನಂತರ ಅವನ ಬದಲಾಗಿ ತೇಮಾನೀಯರ ದೇಶದ ಹುಷಾಮನು ಅರಸನಾದನು.<verse eid="1CH 1:45"/></para>
  <para style="li1">
    <verse number="46" style="v" sid="1CH 1:46"/>ಹುಷಾಮನ ಮರಣದ ನಂತರ ಅವೀತದ ಬೆದದನ ಮಗ ಹದದ ಅರಸನಾದನು. ಇವನು ಮೋವಾಬ್ ದೇಶದಲ್ಲಿ ನಡೆದ ಯುದ್ಧದಲ್ಲಿ ಮಿದ್ಯಾನರನ್ನು ಸೋಲಿಸಿದ; ಅವನ ರಾಜಧಾನಿಯ ಹೆಸರು ಅವೀತ್.<verse eid="1CH 1:46"/></para>
  <para style="li1">
    <verse number="47" style="v" sid="1CH 1:47"/>ಹದದ ಮೃತನಾದ ಮೇಲೆ ಅವನ ಬದಲಾಗಿ ಮಸ್ರೇಕದವನಾದ ಸಮ್ಲಾಹನು ಅರಸನಾದನು.<verse eid="1CH 1:47"/></para>
  <para style="li1">
    <verse number="48" style="v" sid="1CH 1:48"/>ಸಮ್ಲಾಹನ ಮರಣದ ನಂತರ ಅವನ ಬದಲಾಗಿ ಯೂಫ್ರೇಟೀಸ್ ನದಿತೀರದಲ್ಲಿರುವ ರೆಹೋಬೋತ್ ಊರಿನ ಸೌಲನು ಅರಸನಾದನು.<verse eid="1CH 1:48"/></para>
  <para style="li1">
    <verse number="49" style="v" sid="1CH 1:49"/>ಸೌಲನು ಮೃತನಾದ ಮೇಲೆ ಅಕ್ಬೋರನ ಮಗ ಬಾಳ್ ಹಾನಾನ್ ಅರಸನಾದನು.<verse eid="1CH 1:49"/></para>
  <para style="li1">
    <verse number="50" style="v" sid="1CH 1:50"/>ಬಾಳ್ ಹಾನಾನನು ಮೃತನಾದ ಮೇಲೆ ಅವನ ಬದಲಾಗಿ ಹದದನು ಆಳಿದನು. ಅವನ ಪಟ್ಟಣದ ಹೆಸರು ಪಾವು. ಅವನ ಹೆಂಡತಿಯ ಹೆಸರು ಮೆಹೇಟಬೇಲ್. ಈಕೆಯು ಮೇಜಾಹಾಬನ ಮಗಳಾದ ಮಟ್ರೇದಳ ಮಗಳು. <verse eid="1CH 1:50"/><verse number="51" style="v" sid="1CH 1:51"/>ಹದದನು ಮೃತನಾದನು.</para>
  <para style="b" vid="1CH 1:51"/>
  <para style="li4" vid="1CH 1:51">ಎದೋಮ್ಯರ ಮುಖಂಡರ ಹೆಸರುಗಳು ಯಾವುವೆಂದರೆ:</para>
  <para style="li1" vid="1CH 1:51">ತಿಮ್ನಾ, ಅಲ್ವಾ, ಯೆತೇತ, <verse eid="1CH 1:51"/><verse number="52" style="v" sid="1CH 1:52"/>ಒಹೊಲೀಬಾಮ, ಏಲಾ, ಪೀನೋನ್ <verse eid="1CH 1:52"/><verse number="53" style="v" sid="1CH 1:53"/>ಕೆನಜ್, ತೇಮಾನ್, ಮಿಬ್ಜಾರ, <verse eid="1CH 1:53"/><verse number="54" style="v" sid="1CH 1:54"/>ಮಗ್ದೀಯೇಲ್ ಮತ್ತು ಗೀರಾಮ್</para>
  <para style="li4" vid="1CH 1:54">ಎಂಬ ಎದೋಮ್ಯರ ಮುಖಂಡರು.<verse eid="1CH 1:54"/></para>
  <chapter eid="1CH 1"/>
  <chapter number="2" style="c" sid="1CH 2"/>
  <para style="s1">ಇಸ್ರಾಯೇಲನ ಪುತ್ರರು</para>
  <para style="li4">
    <verse number="1" style="v" sid="1CH 2:1"/>ಇಸ್ರಾಯೇಲನ ಪುತ್ರರು: ರೂಬೇನ್, ಸಿಮೆಯೋನ್, ಲೇವಿ, ಯೆಹೂದ, ಇಸ್ಸಾಕಾರ್, ಜೆಬುಲೂನ್, <verse eid="1CH 2:1"/><verse number="2" style="v" sid="1CH 2:2"/>ದಾನ್, ಯೋಸೇಫ್, ಬೆನ್ಯಾಮೀನ್, ನಫ್ತಾಲಿ, ಗಾದ್ ಮತ್ತು ಆಶೇರ್.<verse eid="1CH 2:2"/></para>
  <para style="s1">ಯೆಹೂದ</para>
  <para style="s2">ಹೆಚ್ರೋನನ ಪುತ್ರರಿಗೆ</para>
  <para style="li1">
    <verse number="3" style="v" sid="1CH 2:3"/>ಯೆಹೂದನ ಪುತ್ರರು:</para>
  <para style="li2" vid="1CH 2:3">ಏರ್, ಓನಾನ್, ಶೇಲಹ. ಈ ಮೂವರು ಅವನಿಗೆ ಶೂನನ ಮಗಳಾದ ಕಾನಾನ್ ದೇಶದವಳಿಂದ ಹುಟ್ಟಿದರು.</para>
  <para style="li2" vid="1CH 2:3">ಯೆಹೂದನ ಚೊಚ್ಚಲಮಗನಾದ ಏರನು ಯೆಹೋವ ದೇವರ ಸಮ್ಮುಖದಲ್ಲಿ ಕೆಟ್ಟವನಾದ್ದರಿಂದ, ದೇವರು ಅವನನ್ನು ಮರಣಕ್ಕೆ ಒಪ್ಪಿಸಿದರು.<verse eid="1CH 2:3"/></para>
  <para style="li2">
    <verse number="4" style="v" sid="1CH 2:4"/>ಯೆಹೂದನ ಸೊಸೆ ತಾಮಾರಳು ಅವನಿಗೆ ಪೆರೆಚನನ್ನೂ, ಜೆರಹನನ್ನೂ ಹೆತ್ತಳು.</para>
  <para style="li4" vid="1CH 2:4">ಯೆಹೂದನ ಪುತ್ರರೆಲ್ಲರೂ ಐದು ಮಂದಿ.<verse eid="1CH 2:4"/></para>
  <para style="b"/>
  <para style="li1">
    <verse number="5" style="v" sid="1CH 2:5"/>ಪೆರೆಚನ ಪುತ್ರರು:</para>
  <para style="li2" vid="1CH 2:5">ಹೆಚ್ರೋನ್, ಹಾಮೂಲ್.<verse eid="1CH 2:5"/></para>
  <para style="li1">
    <verse number="6" style="v" sid="1CH 2:6"/>ಜೆರಹನ ಪುತ್ರರು:</para>
  <para style="li2" vid="1CH 2:6">ಜಿಮ್ರಿ, ಏತಾನ್, ಹೇಮಾನ್, ಕಲ್ಕೋಲ್ ಮತ್ತು ದಾರಾ<note caller="+" style="f"><char style="fr" closed="false">2:6 </char><char style="fq" closed="false">ದಾರಾ </char><char style="ft" closed="false">ಕೆಲವು ಪ್ರತಿಗಳಲ್ಲಿ </char><char style="fqa" closed="false">ದಾರ್ದಾ</char></note>, ಒಟ್ಟು ಐದು ಮಂದಿ.<verse eid="1CH 2:6"/></para>
  <para style="li1">
    <verse number="7" style="v" sid="1CH 2:7"/>ಕರ್ಮೀಯ ಪುತ್ರರು:</para>
  <para style="li2" vid="1CH 2:7">ಮೀಸಲಾಗಿಟ್ಟಿದ್ದ ವಸ್ತುಗಳನ್ನು ಕದ್ದುಕೊಂಡು ಇಸ್ರಾಯೇಲರನ್ನು ಆಪತ್ತಿಗೆ ಗುರಿಪಡಿಸಿದ ಆಕಾನನು<note caller="+" style="f"><char style="fr" closed="false">2:7 </char><char style="fq" closed="false">ಆಕಾನನು </char><char style="ft" closed="false">ಅಥವಾ </char><char style="fqa" closed="false">ಆಕಾರ</char></note>.<verse eid="1CH 2:7"/></para>
  <para style="li1">
    <verse number="8" style="v" sid="1CH 2:8"/>ಏತಾನನ ಮಗನು</para>
  <para style="li2" vid="1CH 2:8">ಅಜರ್ಯನು.<verse eid="1CH 2:8"/></para>
  <para style="li1">
    <verse number="9" style="v" sid="1CH 2:9"/>ಹೆಚ್ರೋನನಿಗೆ ಹುಟ್ಟಿದ ಪುತ್ರರು:</para>
  <para style="li2" vid="1CH 2:9">ಯೆರಹ್ಮೇಲ್, ರಾಮ್, ಕೆಲೂಬಾಯ್<note caller="+" style="f"><char style="fr" closed="false">2:9 </char><char style="fq" closed="false">ಕೆಲೂಬಾಯ್ </char><char style="ft" closed="false">ಹೀಬ್ರೂ ಭಾಷೆಯಲ್ಲಿ </char><char style="fqa" closed="false">ಕಾಲೇಬ್</char></note>.<verse eid="1CH 2:9"/></para>
  <para style="s2">ಹೆಚ್ರೋನನ ಮಗ ರಾಮನಿಂದ</para>
  <para style="li1">
    <verse number="10" style="v" sid="1CH 2:10"/>ರಾಮನು ಅಮ್ಮೀನಾದಾಬನ ತಂದೆಯಾಗಿದ್ದನು.</para>
  <para style="li1" vid="1CH 2:10">ಅಮ್ಮೀನಾದಾಬನು ಯೆಹೂದನ ಮಕ್ಕಳಿಗೆ ನಾಯಕನಾದ ನಹಶೋನನ ತಂದೆ.<verse eid="1CH 2:10"/></para>
  <para style="li1">
    <verse number="11" style="v" sid="1CH 2:11"/>ನಹಶೋನನು ಸಲ್ಮನನ ತಂದೆಯಾಗಿದ್ದನು,</para>
  <para style="li1" vid="1CH 2:11">ಸಲ್ಮನ ಬೋವಜನ ತಂದೆ,<verse eid="1CH 2:11"/></para>
  <para style="li1">
    <verse number="12" style="v" sid="1CH 2:12"/>ಬೋವಜನು ಓಬೇದನ ತಂದೆ,</para>
  <para style="li1" vid="1CH 2:12">ಓಬೇದನು ಇಷಯನ ತಂದೆ.<verse eid="1CH 2:12"/></para>
  <para style="b"/>
  <para style="li1">
    <verse number="13" style="v" sid="1CH 2:13"/>ಇಷಯನು ತನ್ನ</para>
  <para style="li2" vid="1CH 2:13">ಚೊಚ್ಚಲ ಮಗ ಎಲೀಯಾಬನನ್ನೂ, ಎರಡನೆಯವನಾದ ಅಬೀನಾದಾಬನನ್ನೂ,</para>
  <para style="li2" vid="1CH 2:13">ಮೂರನೆಯವನಾದ ಶಿಮ್ಮನನ್ನೂ, <verse eid="1CH 2:13"/><verse number="14" style="v" sid="1CH 2:14"/>ನಾಲ್ಕನೆಯವನಾದ ನೆತನೆಯೇಲನನ್ನೂ,</para>
  <para style="li2" vid="1CH 2:14">ಐದನೆಯವನಾದ ರದ್ದೈನನ್ನೂ, <verse eid="1CH 2:14"/><verse number="15" style="v" sid="1CH 2:15"/>ಆರನೆಯವನಾದ ಓಚೆಮನನ್ನೂ,</para>
  <para style="li2" vid="1CH 2:15">ಏಳನೆಯವನಾದ ದಾವೀದನಿಗೆ ತಂದೆಯಾಗಿದ್ದನು.<verse eid="1CH 2:15"/></para>
  <para style="li2">
    <verse number="16" style="v" sid="1CH 2:16"/>ಅವರ ಇಬ್ಬರು ಸಹೋದರಿಯರು ಚೆರೂಯಳು, ಅಬೀಗೈಲಳು.</para>
  <para style="li3" vid="1CH 2:16">ಚೆರೂಯಳ ಮೂವರು ಮಕ್ಕಳು ಅಬೀಷೈ, ಯೋವಾಬ್, ಅಸಾಯೇಲ್.<verse eid="1CH 2:16"/></para>
  <para style="li3">
    <verse number="17" style="v" sid="1CH 2:17"/>ಅಬೀಗೈಲಳು ಅಮಾಸನ ತಾಯಿ, ಅಮಾಸನ ತಂದೆಯು ಇಷ್ಮಾಯೇಲನ ವಂಶದ ಯೆತೆರನು.<verse eid="1CH 2:17"/></para>
  <para style="s2">ಹೆಚ್ರೋನನ ಮಗ ಕಾಲೇಬನು</para>
  <para style="li1">
    <verse number="18" style="v" sid="1CH 2:18"/>ಹೆಚ್ರೋನನ ಮಗನಾದ ಕಾಲೇಬನು ಅಜೂಬಳಿಂದಲೂ ಯೆರ್ಯೋತಳಿಂದಲೂ ಮಕ್ಕಳನ್ನು ಪಡೆದನು. ಇವಳ ಪುತ್ರರು:</para>
  <para style="li2" vid="1CH 2:18">ಯೇಷೆರನು, ಶೋಬಾಬನು, ಅರ್ದೋನನು.<verse eid="1CH 2:18"/></para>
  <para style="li1">
    <verse number="19" style="v" sid="1CH 2:19"/>ಅಜೂಬಳ ಮರಣದ ನಂತರ, ಕಾಲೇಬನು ಎಫ್ರಾತಳನ್ನು ಮದುವೆಯಾದನು. ಅವಳು ಅವನಿಗೆ ಹೂರನನ್ನು ಹೆತ್ತಳು.<verse eid="1CH 2:19"/></para>
  <para style="li2">
    <verse number="20" style="v" sid="1CH 2:20"/>ಹೂರನು ಊರಿಯನ ತಂದೆ; ಊರಿಯನು ಬೆಚಲಯೇಲನ ತಂದೆ.<verse eid="1CH 2:20"/></para>
  <para style="b"/>
  <para style="li1">
    <verse number="21" style="v" sid="1CH 2:21"/>ತರುವಾಯ ಹೆಚ್ರೋನನು ಅರವತ್ತು ವರ್ಷದವನಾಗಿರುವಾಗ ಗಿಲ್ಯಾದನ ತಂದೆಯಾದ ಮಾಕೀರನ ಮಗಳನ್ನು ಮದುವೆಯಾದನು. ಅವಳು ಅವನಿಗೆ ಸೆಗೂಬ ಎಂಬ ಮಗನನ್ನು ಹೆತ್ತಳು.<verse eid="1CH 2:21"/></para>
  <para style="li2">
    <verse number="22" style="v" sid="1CH 2:22"/>ಸೆಗೂಬನು ಯಾಯೀರನ ತಂದೆ, ಇವನಿಗೆ ಗಿಲ್ಯಾದಿನ ದೇಶದಲ್ಲಿ ಇಪ್ಪತ್ತು ಮೂರು ಪಟ್ಟಣಗಳು ಇದ್ದವು.<verse eid="1CH 2:22"/></para>
  <para style="li2">
    <verse number="23" style="v" sid="1CH 2:23"/>ಇವನಿಗೆ ಗಿಲ್ಯಾದಿನ ದೇಶದಲ್ಲಿ ಅರುವತ್ತು ಪಟ್ಟಣಗಳು ಇದ್ದವು. ಇದಲ್ಲದೆ ಅವನು ಗೆಷೂರ್ಯರನ್ನೂ, ಅರಾಮ್ಯರನ್ನೂ, ಯಾಯೀರನ ಪಟ್ಟಣಗಳನ್ನೂ, ಕೆನಾತ್ ಮತ್ತು ಅದರ ಪಟ್ಟಣಗಳನ್ನೂ, ಒಟ್ಟು ಅರವತ್ತು ಪಟ್ಟಣಗಳನ್ನು ಗೆದ್ದುಕೊಂಡನು.</para>
  <para style="li4" vid="1CH 2:23">ಇವುಗಳೆಲ್ಲಾ ಗಿಲ್ಯಾದನ ತಂದೆಯಾದ ಮಾಕೀರನ ವಂಶದವರಿಗೆ ಇದ್ದವು.<verse eid="1CH 2:23"/></para>
  <para style="li1">
    <verse number="24" style="v" sid="1CH 2:24"/>ಹೆಚ್ರೋನನು ಕಾಲೇಬ್ ಎಫ್ರಾತದಲ್ಲಿ ಸತ್ತ ತರುವಾಯ ಹೆಚ್ರೋನನ ಹೆಂಡತಿಯಾದ ಅಬೀಯಳು ಅವನಿಗೆ ಅಷ್ಹೂರನನ್ನು ಹೆತ್ತಳು. ಇವನು ತೆಕೋವನ ತಂದೆಯು.<verse eid="1CH 2:24"/></para>
  <para style="s2">ಹೆಚ್ರೋನನ ಮಗನಾದ ಯೆರಹ್ಮೇಲನು</para>
  <para style="li1">
    <verse number="25" style="v" sid="1CH 2:25"/>ಹೆಚ್ರೋನನ ಚೊಚ್ಚಲ ಮಗ ಯೆರಹ್ಮೇಲನ ಪುತ್ರರು:</para>
  <para style="li2" vid="1CH 2:25">ಚೊಚ್ಚಲ ಮಗ ರಾಮ ಮತ್ತು ಬೂನ, ಓರೆನ, ಓಚೆಮ, ಅಹೀಯ. <verse eid="1CH 2:25"/><verse number="26" style="v" sid="1CH 2:26"/>ಈ ಯೆರಹ್ಮೇಲನಿಗೆ ಮತ್ತೊಬ್ಬ ಹೆಂಡತಿ ಇದ್ದಳು. ಅವಳ ಹೆಸರು ಅಟಾರಳು; ಅವಳು ಓನಾಮನ ತಾಯಿ.<verse eid="1CH 2:26"/></para>
  <para style="li1">
    <verse number="27" style="v" sid="1CH 2:27"/>ಯೆರಹ್ಮೇಲನ ಚೊಚ್ಚಲಮಗನಾದ ರಾಮನ ಪುತ್ರರು:</para>
  <para style="li2" vid="1CH 2:27">ಮಾಚ್, ಯಾಮೀನ್, ಏಕೆರ್.<verse eid="1CH 2:27"/></para>
  <para style="li1">
    <verse number="28" style="v" sid="1CH 2:28"/>ಓನಾಮನ ಪುತ್ರರು:</para>
  <para style="li2" vid="1CH 2:28">ಶಮ್ಮಾಯ, ಯಾದ;</para>
  <para style="li1" vid="1CH 2:28">ಶಮ್ಮಾಯನ ಪುತ್ರರು:</para>
  <para style="li2" vid="1CH 2:28">ನಾದಾಬನು, ಅಬಿಷೂರನು. <verse eid="1CH 2:28"/><verse number="29" style="v" sid="1CH 2:29"/>ಅಬಿಷೂರನ ಹೆಂಡತಿಯ ಹೆಸರು ಅಬೀಹೈಲ; ಅವಳು ಅವನಿಗೆ ಅಹ್ಬಾನನನ್ನೂ, ಮೋಲೀದನನ್ನೂ ಹೆತ್ತಳು.<verse eid="1CH 2:29"/></para>
  <para style="li1">
    <verse number="30" style="v" sid="1CH 2:30"/>ನಾದಾಬನ ಪುತ್ರರು</para>
  <para style="li2" vid="1CH 2:30">ಸೆಲೆದ್, ಅಪ್ಪಯಿಮ್; ಸೆಲೆದನು ಮಕ್ಕಳಿಲ್ಲದೆ ಸತ್ತನು.<verse eid="1CH 2:30"/></para>
  <para style="li1">
    <verse number="31" style="v" sid="1CH 2:31"/>ಅಪ್ಪಯಿಮ್ ಇವನ ಪುತ್ರರು:</para>
  <para style="li2" vid="1CH 2:31">ಇಷ್ಷೀಯು; ಇಷ್ಷೀಯನ ಮಗನು ಶೇಷಾನನು; ಶೇಷಾನನ ಮಗನು; ಅಹ್ಲಾಯಿಯನು;<verse eid="1CH 2:31"/></para>
  <para style="li1">
    <verse number="32" style="v" sid="1CH 2:32"/>ಶಮ್ಮಾಯನ ಸಹೋದರನಾದ ಯಾದನ ಪುತ್ರರು:</para>
  <para style="li2" vid="1CH 2:32">ಯೆತೆರನ ಮತ್ತು ಯೋನಾತಾನ್. ಯೆತೆರನು ಮಕ್ಕಳಿಲ್ಲದೆ ಸತ್ತನು;<verse eid="1CH 2:32"/></para>
  <para style="li1">
    <verse number="33" style="v" sid="1CH 2:33"/>ಯೋನಾತಾನನ ಪುತ್ರರು:</para>
  <para style="li2" vid="1CH 2:33">ಪೆಲೆತನು, ಜಾಜನು.</para>
  <para style="li4" vid="1CH 2:33">ಇವರೇ ಯೆರಹ್ಮೇಲನ ವಂಶಜರು.<verse eid="1CH 2:33"/></para>
  <para style="b"/>
  <para style="li1">
    <verse number="34" style="v" sid="1CH 2:34"/>ಶೇಷಾನನಿಗೆ ಪುತ್ರರಿರಲಿಲ್ಲ. ಪುತ್ರಿಯರಿದ್ದರು.</para>
  <para style="li2" vid="1CH 2:34">ಶೇಷಾನನಿಗೆ ಯರ್ಹನೆಂಬ ಹೆಸರುಳ್ಳ ಈಜಿಪ್ಟಿನವನಾದ ಸೇವಕನಿದ್ದನು. <verse eid="1CH 2:34"/><verse number="35" style="v" sid="1CH 2:35"/>ಶೇಷಾನನು ತನ್ನ ಪುತ್ರಿಯನ್ನು ತನ್ನ ಸೇವಕ ಯರ್ಹನಿಗೆ ಮದುವೆಮಾಡಿಕೊಟ್ಟನು. ಅವಳು ಅವನಿಗೆ ಅತ್ತೈಯನ್ನು ಹೆತ್ತಳು.<verse eid="1CH 2:35"/></para>
  <para style="li1">
    <verse number="36" style="v" sid="1CH 2:36"/>ಅತ್ತೈ ನಾತಾನನ ತಂದೆ;</para>
  <para style="li1" vid="1CH 2:36">ನಾತಾನನು ಜಾಬಾದನ ತಂದೆ.<verse eid="1CH 2:36"/></para>
  <para style="li1">
    <verse number="37" style="v" sid="1CH 2:37"/>ಜಾಬಾದನು ಎಫ್ಲಾಲನನ್ನು ಪಡೆದನು;</para>
  <para style="li1" vid="1CH 2:37">ಎಫ್ಲಾನನು ಓಬೇದನನ್ನು ಪಡೆದನು.<verse eid="1CH 2:37"/></para>
  <para style="li1">
    <verse number="38" style="v" sid="1CH 2:38"/>ಓಬೇದನು ಯೇಹುವನ್ನು ಪಡೆದನು;</para>
  <para style="li1" vid="1CH 2:38">ಯೇಹುವು ಅಜರ್ಯನನ್ನು ಪಡೆದನು.<verse eid="1CH 2:38"/></para>
  <para style="li1">
    <verse number="39" style="v" sid="1CH 2:39"/>ಅಜರ್ಯನು ಹೆಲೆಚನನ್ನು ಪಡೆದನು;</para>
  <para style="li1" vid="1CH 2:39">ಹೆಲೆಚನು ಎಲ್ಲಾಸನನ್ನು ಪಡೆದನು.<verse eid="1CH 2:39"/></para>
  <para style="li1">
    <verse number="40" style="v" sid="1CH 2:40"/>ಎಲ್ಲಾಸನು ಸಿಸ್ಮೈಯನ್ನು ಪಡೆದನು;</para>
  <para style="li1" vid="1CH 2:40">ಸಿಸ್ಮೈಯು ಶಲ್ಲೂಮನನ್ನು ಪಡೆದನು.<verse eid="1CH 2:40"/></para>
  <para style="li1">
    <verse number="41" style="v" sid="1CH 2:41"/>ಶಲ್ಲೂಮನು ಯೆಕಮ್ಯಾಹನ ತಂದೆ;</para>
  <para style="li1" vid="1CH 2:41">ಯೆಕಮ್ಯಾಹನು ಎಲೀಷಾಮನ ತಂದೆ.<verse eid="1CH 2:41"/></para>
  <para style="s2">ಕಾಲೇಬನ ಗೋತ್ರಗಳು</para>
  <para style="li1">
    <verse number="42" style="v" sid="1CH 2:42"/>ಯೆರಹ್ಮೇಲನ ಸಹೋದರನಾದ ಕಾಲೇಬನ ಪುತ್ರರು:</para>
  <para style="li2" vid="1CH 2:42">ಅವನ ಚೊಚ್ಚಲ ಮಗನು ಮೇಷನು; ಇವನು ಜೀಫ್ಯನಿಗೆ ತಂದೆಯಾಗಿದ್ದನು.</para>
  <para style="li2" vid="1CH 2:42">ಹೆಬ್ರೋನನ ತಂದೆಯಾದ ಮಾರೇಷನಿಗೆ ಮಕ್ಕಳು ಜನಿಸಿದರು.<verse eid="1CH 2:42"/></para>
  <para style="li1">
    <verse number="43" style="v" sid="1CH 2:43"/>ಹೆಬ್ರೋನನ ಪುತ್ರರು:</para>
  <para style="li2" vid="1CH 2:43">ಕೋರಹನು, ತಪ್ಪೂಹನು, ರೆಕೆಮನು, ಶೆಮನು.<verse eid="1CH 2:43"/></para>
  <para style="li1">
    <verse number="44" style="v" sid="1CH 2:44"/>ಶೆಮನು ರಹಮ್ಯನ ತಂದೆ</para>
  <para style="li2" vid="1CH 2:44">ರಹಮ್ಯನು ಯೊರ್ಕೆಯಾಮನ ತಂದೆ.</para>
  <para style="li1" vid="1CH 2:44">ರೆಕೆಮನು ಶಮ್ಮಾಯನನ್ನು ಪಡೆದನು.<verse eid="1CH 2:44"/></para>
  <para style="li1">
    <verse number="45" style="v" sid="1CH 2:45"/>ಶಮ್ಮಾಯಿಯ ಮಗನು ಮಾವೋನ್ಯನು;</para>
  <para style="li2" vid="1CH 2:45">ಈ ಮಾವೋನ್ಯನು ಬೇತ್ ಚೂರನಿಗೆ ತಂದೆಯಾಗಿದ್ದನು.<verse eid="1CH 2:45"/></para>
  <para style="li1">
    <verse number="46" style="v" sid="1CH 2:46"/>ಕಾಲೇಬನ ಉಪಪತ್ನಿಯಾದ ಏಫಾಳು</para>
  <para style="li2" vid="1CH 2:46">ಹಾರಾನ್, ಮೋಚ, ಗಾಜೇಜ ಎಂಬುವರನ್ನು ಹೆತ್ತಳು.</para>
  <para style="li2" vid="1CH 2:46">ಹಾರಾನನು ಗಾಜೇಜನ ತಂದೆ.<verse eid="1CH 2:46"/></para>
  <para style="li1">
    <verse number="47" style="v" sid="1CH 2:47"/>ಯಾದೈಯ ಪುತ್ರರು:</para>
  <para style="li2" vid="1CH 2:47">ರೆಗೆಮ್, ಯೋತಾಮ್, ಗೇಷಾನ್, ಪೆಲಟ್, ಏಫ್, ಶಾಫ್.<verse eid="1CH 2:47"/></para>
  <para style="li1">
    <verse number="48" style="v" sid="1CH 2:48"/>ಕಾಲೇಬನ ಇನ್ನೊಬ್ಬ ಉಪಪತ್ನಿಯಾದ ಮಾಕಳು</para>
  <para style="li2" vid="1CH 2:48">ಶೇಬರ್, ತಿರ್ಹನ ಎಂಬುವರನ್ನು ಹೆತ್ತಳು.<verse eid="1CH 2:48"/></para>
  <para style="li2">
    <verse number="49" style="v" sid="1CH 2:49"/>ಇವಳಲ್ಲಿ ಮದ್ಮನ್ನದವರ ಮೂಲಪುರುಷನಾದ ಶಾಫ್,</para>
  <para style="li2" vid="1CH 2:49">ಮಕ್‌ಬೇನ ಮತ್ತು ಗಿಬೆಯ ಊರುಗಳವರ ಮೂಲಪುರುಷನಾದ ಶೆವ ಇವರು ಹುಟ್ಟಿದರು.</para>
  <para style="li1" vid="1CH 2:49">ಕಾಲೇಬನ ಮಗಳು ಅಕ್ಸಾ.<verse eid="1CH 2:49"/></para>
  <para style="li4">
    <verse number="50" style="v" sid="1CH 2:50"/>ಇನ್ನುಳಿದ ಕಾಲೇಬನ ವಂಶಜರು:</para>
  <para style="b" vid="1CH 2:50"/>
  <para style="li1" vid="1CH 2:50">ಕಾಲೇಬನಿಗೆ ಅವನ ಹೆಂಡತಿ ಎಫ್ರಾತಳಿಂದ ಜನಿಸಿದ ಚೊಚ್ಚಲ ಮಗನ ಹೆಸರು ಹೂರ್.</para>
  <para style="li2" vid="1CH 2:50">ಹೂರನ ಮಗ ಶೋಬಾಲ್ ಕಿರ್ಯತ್ ಯಾರೀಮ್ ಪಟ್ಟಣವನ್ನೂ, <verse eid="1CH 2:50"/><verse number="51" style="v" sid="1CH 2:51"/>ಅವನ ಇನ್ನೊಬ್ಬ ಮಗ ಸಲ್ಮ ಬೇತ್ಲೆಹೇಮನ್ನೂ, ಅವನ ಮೂರನೆಯ ಮಗ ಹಾರೇಫ್, ಬೇತ್ಗಾದೇರ್ ಪಟ್ಟಣವನ್ನೂ ಕಟ್ಟಿಸಿದರು.<verse eid="1CH 2:51"/></para>
  <para style="li1">
    <verse number="52" style="v" sid="1CH 2:52"/>ಕಿರ್ಯತ್ ಯಾರೀಮ್ ಪಟ್ಟಣದ ಸ್ಥಾಪಕ ಶೋಬಾಲನು</para>
  <para style="li2" vid="1CH 2:52">ಹಾರೋಯೆ ಜನರ, ಮಾನಹತಿಯರ ಅರ್ಧದಷ್ಟು ಜನರ, <verse eid="1CH 2:52"/><verse number="53" style="v" sid="1CH 2:53"/>ಹಾಗೂ ಕಿರ್ಯತ್ ಯಾರೀಮನವರ ಗೋತ್ರಗಳು: ಯೆತೆರಿಯರು, ಪೂತ್ಯರು, ಶುಮಾತ್ಯರು, ಮಿಷ್ರಾಗ್ಯರು, ಇವರಿಂದ ಚೊರ್‍ರಾತ್ಯರೂ, ಎಷ್ಟಾವೋಲ್ಯರೂ ಹುಟ್ಟಿದರು.<verse eid="1CH 2:53"/></para>
  <para style="li1">
    <verse number="54" style="v" sid="1CH 2:54"/>ಸಲ್ಮನ ವಂಶಜರು:</para>
  <para style="li2" vid="1CH 2:54">ಬೇತ್ಲೆಹೇಮ್, ನೆಟೋಫಾ, ಅಟರೋತ್ ಬೇತ್ಯೋವಾಬ್ ಊರುಗಳವರೂ, ಚೊರ್ಗದಲ್ಲಿ ವಾಸಿಸುವ ಮಾನಹತಿಯರಲ್ಲಿ ಅರ್ಧ ಜನರೂ ಉತ್ಪತ್ತಿಯಾದರು. <verse eid="1CH 2:54"/><verse number="55" style="v" sid="1CH 2:55"/>ಯಾಬೇಚಿನಲ್ಲಿ ವಾಸಿಸುವ ಬರಹಗಾರರ ಕುಟುಂಬದವರಾದ ತಿರ್ರಾತ್ಯರು, ಶಿಮೆಯಾತ್ಯರು, ಸೂಕಾತ್ಯರು ಇವರು ರೇಕಾಬನ ಮನೆಯವರ ಮೂಲ ಪುರುಷನಾಗಿರುವ ಹಮ್ಮತನಿಂದ ಉತ್ಪನ್ನರಾದ ಕೇನ್ಯರು.<verse eid="1CH 2:55"/></para>
  <chapter eid="1CH 2"/>
  <chapter number="3" style="c" sid="1CH 3"/>
  <para style="s2">ದಾವೀದನ ಪುತ್ರರು</para>
  <para style="li4">
    <verse number="1" style="v" sid="1CH 3:1"/>ಹೆಬ್ರೋನಿನಲ್ಲಿ ದಾವೀದನಿಗೆ ಹುಟ್ಟಿದ ಪುತ್ರರು ಯಾರೆಂದರೆ:</para>
  <para style="b" vid="1CH 3:1"/>
  <para style="li1" vid="1CH 3:1">ಇಜ್ರೆಯೇಲ್ ಪಟ್ಟಣದ ಅಹೀನೋವಮಳ ಚೊಚ್ಚಲ ಮಗ ಅಮ್ನೋನನು;</para>
  <para style="li1" vid="1CH 3:1">ಕರ್ಮೇಲ್ಯಳಾದ ಅಬೀಗೈಲಳಿಂದ ಹುಟ್ಟಿದ ಎರಡನೆಯವನಾದ ದಾನಿಯೇಲನು,<verse eid="1CH 3:1"/></para>
  <para style="li1">
    <verse number="2" style="v" sid="1CH 3:2"/>ಗೆಷೂರಿನ ಅರಸನಾಗಿರುವ ತಲ್ಮಾಯನ ಮಗಳಾದ ಮಾಕಳಿಂದ ಹುಟ್ಟಿದ ಅವನ ಮೂರನೆಯ ಮಗ ಅಬ್ಷಾಲೋಮನು,</para>
  <para style="li1" vid="1CH 3:2">ಹಗ್ಗೀತಳಿಂದ ಹುಟ್ಟಿದ ನಾಲ್ಕನೆಯ ಮಗ ಅದೋನೀಯನು.<verse eid="1CH 3:2"/></para>
  <para style="li1">
    <verse number="3" style="v" sid="1CH 3:3"/>ಅಬೀಟಾಲಳಿಂದ ಹುಟ್ಟಿದ ಐದನೆಯ ಮಗ ಶೆಫಟ್ಯನು,</para>
  <para style="li1" vid="1CH 3:3">ದಾವೀದನ ಹೆಂಡತಿ ಎಗ್ಲಳಿಂದ ಹುಟ್ಟಿದ ಆರನೆಯ ಮಗ ಇತ್ರಾಮನು.<verse eid="1CH 3:3"/></para>
  <para style="b"/>
  <para style="li4">
    <verse number="4" style="v" sid="1CH 3:4"/>ಈ ಆರು ಮಂದಿ ಹೆಬ್ರೋನಿನಲ್ಲಿ ದಾವೀದನಿಗೆ ಹುಟ್ಟಿದವರು. ಅಲ್ಲಿ ಅವನು ಏಳುವರೆ ವರ್ಷ ಆಳಿದನು.</para>
  <para style="b" vid="1CH 3:4"/>
  <para style="b" vid="1CH 3:4"/>
  <para style="li4" vid="1CH 3:4">ಯೆರೂಸಲೇಮಿನಲ್ಲಿ ಮೂವತ್ತಮೂರು ವರ್ಷ ಆಳಿದನು. <verse eid="1CH 3:4"/><verse number="5" style="v" sid="1CH 3:5"/>ಯೆರೂಸಲೇಮಿನಲ್ಲಿ ಅವನಿಗೆ ಹುಟ್ಟಿದ ಮಕ್ಕಳ ಹೆಸರುಗಳು:</para>
  <para style="b" vid="1CH 3:5"/>
  <para style="li1" vid="1CH 3:5">ದಾವೀದನ ಹೆಂಡತಿ ಬತ್ಷೆಬೆಳು<note caller="+" style="f"><char style="fr" closed="false">3:5 </char><char style="fq" closed="false">ಬತ್ಷೆಬೆಳು </char><char style="ft" closed="false">ಹೀಬ್ರೂ ಭಾಷೆಯಲ್ಲಿ </char><char style="fqa" closed="false">ಬತ್ಷೂವ</char></note> ಅಮ್ಮಿಯೇಲನ ಮಗಳು. ಆಕೆಗೆ ಶಮ್ಮೂವ ಎಂಬ ಶಿಮ್ಮ, ಶೋಬಾಬ್, ನಾತಾನ್, ಸೊಲೊಮೋನ್ ಎಂಬ ನಾಲ್ಕು ಜನ ಗಂಡು ಮಕ್ಕಳು ಜನಿಸಿದರು.<verse eid="1CH 3:5"/></para>
  <para style="li1">
    <verse number="6" style="v" sid="1CH 3:6"/>ಇದಲ್ಲದೆ ಇಬ್ಹಾರ್, ಎಲೀಷಾಮ<note caller="+" style="f"><char style="fr" closed="false">3:6 </char><char style="fq" closed="false">ಎಲೀಷಾಮ </char><char style="ft" closed="false">ಅಥವಾ </char><char style="fqa" closed="false">ಎಲೀಷೂವ</char></note>, ಎಲೀಫೆಲೆಟ್, <verse eid="1CH 3:6"/><verse number="7" style="v" sid="1CH 3:7"/>ನೋಗಹ, ನೆಫೆಗ್, ಯಾಫೀಯ, <verse eid="1CH 3:7"/><verse number="8" style="v" sid="1CH 3:8"/>ಎಲೀಷಾಮ, ಎಲ್ಯಾದ, ಎಲೀಫೆಲೆಟ್, ಈ ಒಂಬತ್ತು ಮಂದಿ ಮಕ್ಕಳಿದ್ದರು.<verse eid="1CH 3:8"/></para>
  <para style="b"/>
  <para style="li4">
    <verse number="9" style="v" sid="1CH 3:9"/>ಉಪಪತ್ನಿಗಳ ಮಕ್ಕಳು ಹೊರತಾಗಿ ಇವರೆಲ್ಲರು ದಾವೀದನ ಮಕ್ಕಳಾಗಿದ್ದರು; ತಾಮಾರಳು ಇವರ ಸಹೋದರಿಯಾಗಿದ್ದಳು.<verse eid="1CH 3:9"/></para>
  <para style="s2">ಯೆಹೂದ್ಯರ ಅರಸರು</para>
  <para style="li1">
    <verse number="10" style="v" sid="1CH 3:10"/>ಸೊಲೊಮೋನನ ಮಗನು ರೆಹಬ್ಬಾಮನು;</para>
  <para style="li1" vid="1CH 3:10">ಇವನ ಮಗನು ಅಬೀಯನು;</para>
  <para style="li1" vid="1CH 3:10">ಇವನ ಮಗನು ಆಸನು;</para>
  <para style="li1" vid="1CH 3:10">ಇವನ ಮಗನು ಯೆಹೋಷಾಫಾಟನು;<verse eid="1CH 3:10"/></para>
  <para style="li1">
    <verse number="11" style="v" sid="1CH 3:11"/>ಇವನ ಮಗನು ಯೆಹೋರಾಮನು;</para>
  <para style="li1" vid="1CH 3:11">ಇವನ ಮಗನು ಅಹಜ್ಯನು;</para>
  <para style="li1" vid="1CH 3:11">ಇವನ ಮಗನು ಯೋವಾಷನು.<verse eid="1CH 3:11"/></para>
  <para style="li1">
    <verse number="12" style="v" sid="1CH 3:12"/>ಇವನ ಮಗನು ಅಮಚ್ಯನು;</para>
  <para style="li1" vid="1CH 3:12">ಇವನ ಮಗನು ಅಜರ್ಯನು;</para>
  <para style="li1" vid="1CH 3:12">ಇವನ ಮಗನು ಯೋತಾಮನು.<verse eid="1CH 3:12"/></para>
  <para style="li1">
    <verse number="13" style="v" sid="1CH 3:13"/>ಇವನ ಮಗನು ಆಹಾಜನು;</para>
  <para style="li1" vid="1CH 3:13">ಇವನ ಮಗನು ಹಿಜ್ಕೀಯನು;</para>
  <para style="li1" vid="1CH 3:13">ಇವನ ಮಗನು ಮನಸ್ಸೆಯು.<verse eid="1CH 3:13"/></para>
  <para style="li1">
    <verse number="14" style="v" sid="1CH 3:14"/>ಇವನ ಮಗನು ಆಮೋನನು;</para>
  <para style="li1" vid="1CH 3:14">ಇವನ ಮಗನು ಯೋಷೀಯನು.<verse eid="1CH 3:14"/></para>
  <para style="li1">
    <verse number="15" style="v" sid="1CH 3:15"/>ಯೋಷೀಯನ ಮಕ್ಕಳು:</para>
  <para style="li2" vid="1CH 3:15">ಚೊಚ್ಚಲಮಗನಾದ ಯೋಹಾನಾನ್,</para>
  <para style="li2" vid="1CH 3:15">ಎರಡನೆಯವನಾದ ಯೆಹೋಯಾಕೀಮ್,</para>
  <para style="li2" vid="1CH 3:15">ಮೂರನೆಯವನಾದ ಚಿದ್ಕೀಯ,</para>
  <para style="li2" vid="1CH 3:15">ನಾಲ್ಕನೆಯವನಾದ ಶಲ್ಲೂಮ್.<verse eid="1CH 3:15"/></para>
  <para style="li1">
    <verse number="16" style="v" sid="1CH 3:16"/>ಯೆಹೋಯಾಕೀಮನ ಮಕ್ಕಳು:</para>
  <para style="li2" vid="1CH 3:16">ಇವನ ಮಗನಾದ ಯೆಕೊನ್ಯ;</para>
  <para style="li2" vid="1CH 3:16">ಇವನ ಮಗನು ಚಿದ್ಕೀಯ.<verse eid="1CH 3:16"/></para>
  <para style="s2">ಸೆರೆಯ ನಂತರದ ರಾಜವಂಶಸ್ಥರು</para>
  <para style="li1">
    <verse number="17" style="v" sid="1CH 3:17"/>ಯೆಹೋಯಾಕೀನನು ಸೆರೆಯಲ್ಲಿದ್ದಾಗ ಅವನ ವಂಶಜರು:</para>
  <para style="li2" vid="1CH 3:17">ಇವನ ಮಗ ಶೆಯಲ್ತಿಯೇಲ್, <verse eid="1CH 3:17"/><verse number="18" style="v" sid="1CH 3:18"/>ಮಲ್ಕೀರಾಮ, ಪೆದಾಯ್, ಶೆನಚ್ಚರ, ಯೆಕಮ್ಯ, ಹೋಷಾಮ ಮತ್ತು ನೆದಬ್ಯ.<verse eid="1CH 3:18"/></para>
  <para style="li1">
    <verse number="19" style="v" sid="1CH 3:19"/>ಪೆದಾಯನ ಮಕ್ಕಳು:</para>
  <para style="li2" vid="1CH 3:19">ಜೆರುಬ್ಬಾಬೆಲನು, ಶಿಮ್ಮೀ.</para>
  <para style="li1" vid="1CH 3:19">ಜೆರುಬ್ಬಾಬೆಲನ ಮಕ್ಕಳು:</para>
  <para style="li2" vid="1CH 3:19">ಮೆಷುಲ್ಲಾಮನು, ಹನನ್ಯನು. ಇವರ ಸಹೋದರಿಯಾದ ಶೆಲೋಮೀತಳು. <verse eid="1CH 3:19"/><verse number="20" style="v" sid="1CH 3:20"/>ಇವರಲ್ಲದೆ ಐವರು ಗಂಡು ಮಕ್ಕಳು ಅವನಿಗಿದ್ದರು: ಹಷುಬನು, ಓಹೆಲನು, ಬೆರೆಕ್ಯನು, ಹಸದ್ಯ, ಯೂಷಬ್ಹೆಸೆದ್<verse eid="1CH 3:20"/></para>
  <para style="li1">
    <verse number="21" style="v" sid="1CH 3:21"/>ಹನನ್ಯನ ವಂಶಜರು:</para>
  <para style="li2" vid="1CH 3:21">ಪೆಲಟ್ಯನು, ಯೆಶಾಯನು; ರೆಫಾಯನ ಮಕ್ಕಳು, ಅರ್ನಾನನ ಮಕ್ಕಳು, ಓಬದ್ಯನ ಮಕ್ಕಳು, ಶೆಕನ್ಯನ ಮಕ್ಕಳು.<verse eid="1CH 3:21"/></para>
  <para style="li1">
    <verse number="22" style="v" sid="1CH 3:22"/>ಶೆಕನ್ಯನ ವಂಶಜರು:</para>
  <para style="li2" vid="1CH 3:22">ಶೆಮಾಯನ ಮತ್ತು ಅವನ ಮಕ್ಕಳು ಹಟ್ಟೂಷ್, ಇಗಾಲ್, ಬಾರೀಹ, ನೆಯರ್ಯ, ಶಾಫಾಟ್, ಈ ಆರು ಮಂದಿಯು.<verse eid="1CH 3:22"/></para>
  <para style="li1">
    <verse number="23" style="v" sid="1CH 3:23"/>ನೆಯರ್ಯನ ಮಕ್ಕಳು:</para>
  <para style="li2" vid="1CH 3:23">ಎಲ್ಯೋವೇನೈನು, ಹಿಜ್ಕೀಯನು, ಅಜ್ರೀಕಾಮನು, ಈ ಮೂರು ಮಂದಿಯು.<verse eid="1CH 3:23"/></para>
  <para style="li1">
    <verse number="24" style="v" sid="1CH 3:24"/>ಎಲ್ಯೋವೇನೈನ ಮಕ್ಕಳು:</para>
  <para style="li2" vid="1CH 3:24">ಹೋದವ್ಯ, ಎಲ್ಯಾಷೀಬ್, ಪೆಲಾಯ, ಅಕ್ಕೂಬ್, ಯೋಹಾನಾನ್, ದೆಲಾಯ, ಅನಾನೀ ಎಂಬ ಏಳುಮಂದಿ.<verse eid="1CH 3:24"/></para>
  <chapter eid="1CH 3"/>
  <chapter number="4" style="c" sid="1CH 4"/>
  <para style="s2">ಯೆಹೂದನ ಇತರ ಗೋತ್ರಗಳು</para>
  <para style="li1">
    <verse number="1" style="v" sid="1CH 4:1"/>ಯೆಹೂದನ ವಂಶಜರು:</para>
  <para style="li2" vid="1CH 4:1">ಪೆರೆಚನು, ಹೆಚ್ರೋನನು, ಕರ್ಮೀ, ಹೂರನು, ಶೋಬಾಲನು.<verse eid="1CH 4:1"/></para>
  <para style="li1">
    <verse number="2" style="v" sid="1CH 4:2"/>ಶೋಬಾಲನ ಮಗನಾದ ರೆವಾಯನು ಯಹತನ ತಂದೆ. ಯಹತನು ಅಹೂಮೈ ಮತ್ತು ಲಹದ್ ಎಂಬವರ ತಂದೆ. ಇವರೇ ಚೊರ್‍ರದ ಕುಟುಂಬದವರು.<verse eid="1CH 4:2"/></para>
  <para style="li1">
    <verse number="3" style="v" sid="1CH 4:3"/>ಏಟಾಮನ ಪುತ್ರರು:</para>
  <para style="li2" vid="1CH 4:3">ಇಜ್ರೆಯೇಲ್, ಇಷ್ಮ ಮತ್ತು ಇಬ್ಬಾಷ್ ಮತ್ತು ಇವರ ತಂಗಿ ಹಚೆಲೆಲ್‌ಪೋನೀ ಎಂಬವರು. <verse eid="1CH 4:3"/><verse number="4" style="v" sid="1CH 4:4"/>ಪೆನೂಯೇಲ್, ಗೆದೋರ್ ವಂಶದವರಿಗೆ ಮೂಲಪುರುಷನಾಗಿದ್ದನು. ಏಜೆರ್ ಹೂಷಾಹರ ಮೂಲಪುರುಷನಾಗಿದ್ದನು.</para>
  <para style="li1" vid="1CH 4:4">ಇವರು ಎಫ್ರಾತಾಹ ಎಂಬಾಕೆಯ ಚೊಚ್ಚಲಮಗನಾದ ಹೂರನ ಮಕ್ಕಳು; ಈ ಹೂರನೇ ಬೇತ್ಲೆಹೇಮ್ ವಂಶದವರಿಗೆ ಮೂಲಪುರುಷನು.<verse eid="1CH 4:4"/></para>
  <para style="li1">
    <verse number="5" style="v" sid="1CH 4:5"/>ತೆಕೋವದ ತಂದೆ ಅಷ್ಹೂರನಿಗೆ ಹೆಲಾಹ, ನಾರ ಎಂಬ ಇಬ್ಬರು ಪತ್ನಿಯರಿದ್ದರು.<verse eid="1CH 4:5"/></para>
  <para style="li1">
    <verse number="6" style="v" sid="1CH 4:6"/>ನಾರಳು ಅವನಿಗೆ ಅಹುಜ್ಜಾಮ್, ಹೇಫೆರ್, ತೇಮಾನಿ, ಅಹಷ್ಟಾರ್ಯನನ್ನು ಹೆತ್ತಳು. ಇವರೇ ನಾರಳ ಮಕ್ಕಳು.<verse eid="1CH 4:6"/></para>
  <para style="li1">
    <verse number="7" style="v" sid="1CH 4:7"/>ಹೆಲಾಹಳ ಪುತ್ರರು:</para>
  <para style="li2" vid="1CH 4:7">ಚೆರೆತ್, ಇಚ್ಹಾರ್<note caller="+" style="f"><char style="fr" closed="false">4:7 </char><char style="fq" closed="false">ಇಚ್ಹಾರ್ </char><char style="ft" closed="false">ಹೀಬ್ರೂ ಭಾಷೆಯಲ್ಲಿ </char><char style="fqa" closed="false">ಚೋಹರ್</char></note>, ಎತ್ನಾನ್. <verse eid="1CH 4:7"/><verse number="8" style="v" sid="1CH 4:8"/>ಕೋಚನು ಅನೂಬ್‌ನನ್ನೂ, ಚೊಬೇಬನನ್ನೂ, ಹಾರುಮನ ಮಗನಾದ ಅಹರ‍್ಹೇಲನ ಸಂತತಿಗಳನ್ನೂ ಪಡೆದನು.<verse eid="1CH 4:8"/></para>
  <para style="b"/>
  <para style="p">
    <verse number="9" style="v" sid="1CH 4:9"/>ಯಾಬೇಚನು ತನ್ನ ಸಹೋದರರಿಗಿಂತ ಘನವುಳ್ಳವನಾಗಿದ್ದನು. ಅವನ ತಾಯಿ, “ನಾನು ಇವನನ್ನು ವ್ಯಥೆಯಿಂದ ಹೆತ್ತೆನು,” ಎಂದು ಅವನಿಗೆ ಯಾಬೇಚನೆಂಬ ಹೆಸರಿಟ್ಟಳು. <verse eid="1CH 4:9"/><verse number="10" style="v" sid="1CH 4:10"/>ಆದರೆ ಯಾಬೇಚನು ಇಸ್ರಾಯೇಲಿನ ದೇವರಿಗೆ, “ನೀವು ನನ್ನನ್ನು ನಿಜವಾಗಿ ಆಶೀರ್ವದಿಸಬೇಕು; ನನ್ನ ಮೇರೆಯನ್ನು ವಿಸ್ತರಿಸಬೇಕು; ನಿಮ್ಮ ಹಸ್ತವು ನನ್ನ ಸಂಗಡ ಇರಲಿ; ನನ್ನನ್ನು ವ್ಯಥೆಪಡಿಸದ ಹಾಗೆ ನನ್ನನ್ನು ಕೇಡಿನಿಂದ ತಪ್ಪಿಸಿರಿ,” ಎಂದು ಮೊರೆಯಿಟ್ಟನು. ದೇವರು ಅವನು ಬೇಡಿಕೊಂಡದ್ದನ್ನು ಅನುಗ್ರಹಿಸಿದರು.<verse eid="1CH 4:10"/></para>
  <para style="b"/>
  <para style="li1">
    <verse number="11" style="v" sid="1CH 4:11"/>ಶೂಹನ ಸಹೋದರ ಕೆಲೂಬನು ಎಷ್ಟೋನನ ತಂದೆ ಮೆಹೀರನನ್ನು ಪಡೆದನು. <verse eid="1CH 4:11"/><verse number="12" style="v" sid="1CH 4:12"/>ಎಷ್ಟೋನನಿಂದ ಬೇತ್ ರಾಫಾ, ಪಾಸೇಹ, ತೆಹಿನ್ನ ಎಂಬ ಮೂವರು ಮಕ್ಕಳು ಇದ್ದರು. ತೆಹಿನ್ನ ನಾಹಷ್ ಪಟ್ಟಣದ ಸ್ಥಾಪಕ. ಈ ಜನರ ವಂಶಜರು ರೇಕಾ ಎಂಬಲ್ಲಿ ವಾಸಿಸಿದ್ದರು.<verse eid="1CH 4:12"/></para>
  <para style="b"/>
  <para style="li1">
    <verse number="13" style="v" sid="1CH 4:13"/>ಕೆನಾಜನ ಪುತ್ರರು:</para>
  <para style="li2" vid="1CH 4:13">ಒತ್ನಿಯೇಲನು ಸೆರಾಯನು.</para>
  <para style="li1" vid="1CH 4:13">ಒತ್ನಿಯೇಲನ ಪುತ್ರರು:</para>
  <para style="li2" vid="1CH 4:13">ಹತತ್ ಹಾಗು ಮೆಯೋನೋತೈ. <verse eid="1CH 4:13"/><verse number="14" style="v" sid="1CH 4:14"/>ಮೆಯೋನೋತೈ ಒಫ್ರಾಹನನ್ನು ಪಡೆದನು.</para>
  <para style="li1" vid="1CH 4:14">ಸೆರಾಯನು ಶಿಲ್ಪಿಗರಾಗಿರುವ ಗೇಹರಾಷೀಮರ<note caller="+" style="f"><char style="fr" closed="false">4:14 </char><char style="fq" closed="false">ಗೇಹರಾಷೀಮ </char><char style="ft" closed="false">ಅಂದರೆ </char><char style="fqa" closed="false">ನುರಿತ ಕಾರ್ಮಿಕರ ಕಣಿವೆ</char></note> ಸ್ಥಾಪಕನಾದ ಯೋವಾಬನ ತಂದೆ.</para>
  <para style="li2" vid="1CH 4:14">ಈ ಜನರು ಕೈಕೆಲಸದವರಾದ್ದರಿಂದ ಗೇಹರಾಷೀಮರು ಎಂಬ ಹೆಸರು ಬಂತು.<verse eid="1CH 4:14"/></para>
  <para style="li1">
    <verse number="15" style="v" sid="1CH 4:15"/>ಯೆಫುನ್ನೆಯ ಮಗನಾದ ಕಾಲೇಬನ ಪುತ್ರರು:</para>
  <para style="li2" vid="1CH 4:15">ಈರು, ಏಲ, ನಾಮ್ ಎಂಬವರು;</para>
  <para style="li1" vid="1CH 4:15">ಏಲನ ಮಗನು</para>
  <para style="li2" vid="1CH 4:15">ಕೆನಜ್.<verse eid="1CH 4:15"/></para>
  <para style="li1">
    <verse number="16" style="v" sid="1CH 4:16"/>ಯೆಹಲ್ಲೆಲೇಲನ ಪುತ್ರರು:</para>
  <para style="li2" vid="1CH 4:16">ಜೀಫನು, ಜಿಫಾಹನು, ತೀರ್ಯನು, ಅಸರೇಲನು.<verse eid="1CH 4:16"/></para>
  <para style="li1">
    <verse number="17" style="v" sid="1CH 4:17"/>ಎಜ್ರನ ಪುತ್ರರು:</para>
  <para style="li2" vid="1CH 4:17">ಯೆತೆರ್, ಮೆರೆದ್, ಏಫೆರ್, ಯಾಲೋನ್ ಎಂಬವರು.</para>
  <para style="li1" vid="1CH 4:17">ಮೇರದನ ಹೆಂಡತಿಯು ಅವನಿಗೆ ಮಿರ್ಯಾಮ್, ಶಮ್ಮಾಯ, ಎಷ್ಟೆಮೋವನ ತಂದೆ ಇಷ್ಬಾಹನನ್ನೂ ಹೆತ್ತಳು. <verse eid="1CH 4:17"/><verse number="18" style="v" sid="1CH 4:18"/>ಇವರು ಮೆರೆದನು ಮದುವೆಯಾದ ಫರೋಹನ ಮಗಳು ಬಿತ್ಯಳ ಮಕ್ಕಳು.</para>
  <para style="li1" vid="1CH 4:18">ಇದಲ್ಲದೆ ಯೆಹೂದ್ಯಳಾದ ಅವನ ಇನ್ನೊಬ್ಬ ಹೆಂಡತಿ, ಗೆದೋರ್ಯನ ತಂದೆ ಯೆರೆದನನ್ನೂ, ಸೋಕೋವಿನ ತಂದೆ ಹೆಬೆರನನ್ನೂ, ಜಾನೋಹನ ತಂದೆ ಯೆಕೂತೀಯೇಲನನ್ನೂ ಹೆತ್ತಳು.<verse eid="1CH 4:18"/></para>
  <para style="li1">
    <verse number="19" style="v" sid="1CH 4:19"/>ಹೋದೀಯನು ನಹಮನ ಸಹೋದರಿಯನ್ನು ಮದುವೆಯಾದನು.</para>
  <para style="li2" vid="1CH 4:19">ಇವರ ಸಂತತಿಯವರು ಕೆಯೀಲದಲ್ಲಿ ವಾಸಿಸಿದ ಗರ್ಮ್ಯ ಗೋತ್ರದ ಮತ್ತು ಎಷ್ಟೆಮೋವಾಬದಲ್ಲಿ ವಾಸಿಸಿದ ಮಾಕಾತ್ ಗೋತ್ರದ ಪೂರ್ವಜರು.<verse eid="1CH 4:19"/></para>
  <para style="li1">
    <verse number="20" style="v" sid="1CH 4:20"/>ಶೀಮೋನನ ಪುತ್ರರು:</para>
  <para style="li2" vid="1CH 4:20">ಅಮ್ನೋನನು, ರಿನ್ನನು, ಬೆನ್ಹನಾನನು, ತಿಲೋನನು.</para>
  <para style="li1" vid="1CH 4:20">ಇಷ್ಷೀಯನ ಸಂತತಿ:</para>
  <para style="li2" vid="1CH 4:20">ಜೋಹೆತನು, ಬೆನ್ ಜೋಹೆತನು.<verse eid="1CH 4:20"/></para>
  <para style="li1">
    <verse number="21" style="v" sid="1CH 4:21"/>ಯೆಹೂದನ ಮಗ ಶೇಲಹನ ಪುತ್ರರು:</para>
  <para style="li2" vid="1CH 4:21">ಲೇಕಾಹ್ಯನ ತಂದೆ ಏರನು, ಮಾರೇಷನ ತಂದೆ ಲದ್ದ; ಬೇತ್ ಅಷ್ಬೇಯ ಪಟ್ಟಣದಲ್ಲಿ ವಾಸಿಸಿದ ನೇಕಾರರ ಕುಟುಂಬಗಳವರು,<verse eid="1CH 4:21"/></para>
  <para style="li2">
    <verse number="22" style="v" sid="1CH 4:22"/>ಕೋಜೇಬದವರಾದ ಯೊಕೀಮ್ಯರೂ, ಯೋವಾಷನು, ಸಾರಾಫ ಮೋವಾಬ್ ಮತ್ತು ಯೆಷೂಬಿ ಲೆಹೇಮಿನಲ್ಲಿ ಅಧಿಕಾರವುಳ್ಳವರಾಗಿದ್ದರು. ಈ ದಾಖಲೆಗಳು ಪ್ರಾಚೀನ ಕಾಲದಿಂದ ಬಂದವು. <verse eid="1CH 4:22"/><verse number="23" style="v" sid="1CH 4:23"/>ಇವರೇ ನೆಟಾಯಿಮ್, ಗೆದೇರ ಎಂಬ ಸ್ಥಳಗಳಲ್ಲಿ ವಾಸವಾಗಿದ್ದ ಕುಂಬಾರರು. ಅವರು ಅಲ್ಲಿಯೇ ಇದ್ದು ಅರಸನಿಗೋಸ್ಕರ ಕೆಲಸ ಮಾಡುತ್ತಿದ್ದರು.<verse eid="1CH 4:23"/></para>
  <para style="s1">ಸಿಮೆಯೋನನು</para>
  <para style="li1">
    <verse number="24" style="v" sid="1CH 4:24"/>ಸಿಮೆಯೋನನ ವಂಶಜರು:</para>
  <para style="li2" vid="1CH 4:24">ನೆಮೂಯೇಲನು, ಯಾಮೀನನು, ಯಾರೀಬನು, ಜೆರಹನು ಮತ್ತು ಸೌಲನು.<verse eid="1CH 4:24"/></para>
  <para style="li2">
    <verse number="25" style="v" sid="1CH 4:25"/>ಅವನ ಮಗನಾದ ಶಲ್ಲೂಮನು, ಅವನ ಮಗನಾದ ಮಿಬ್ಸಾಮನು, ಅವನ ಮಗನಾದ ಮಿಷ್ಮಾವನು.<verse eid="1CH 4:25"/></para>
  <para style="li1">
    <verse number="26" style="v" sid="1CH 4:26"/>ಮಿಷ್ಮಾವನ ವಂಶಜರು:</para>
  <para style="li2" vid="1CH 4:26">ಅವನ ಮಗ ಹಮ್ಮೂಯೇಲನು, ಅವನ ಮಗ ಜಕ್ಕೂರನು, ಅವನ ಮಗನಾದ ಶಿಮ್ಮಿಯಿ.<verse eid="1CH 4:26"/></para>
  <para style="b"/>
  <para style="p">
    <verse number="27" style="v" sid="1CH 4:27"/>ಶಿಮ್ಮಿಯಿಗೆ ಹದಿನಾರು ಮಂದಿ ಪುತ್ರರೂ, ಆರು ಮಂದಿ ಪುತ್ರಿಯರೂ ಇದ್ದರು. ಆದರೆ ಅವನ ಸಹೋದರರಿಗೆ ಬಹಳ ಮಕ್ಕಳಿರಲಿಲ್ಲ. ಅವರ ಸಮಸ್ತ ಸಂತತಿಯು ಯೆಹೂದದ ಮಕ್ಕಳ ಹಾಗೆ ಹೆಚ್ಚಾಗಿರಲಿಲ್ಲ. <verse eid="1CH 4:27"/><verse number="28" style="v" sid="1CH 4:28"/>ಇವರು ಬೇರ್ಷೆಬದಲ್ಲಿಯೂ; ಮೋಲಾದದಲ್ಲಿಯೂ; ಹಚರ್ ಷೂವಾಲ್ ಎಂಬಲ್ಲಿಯೂ; <verse eid="1CH 4:28"/><verse number="29" style="v" sid="1CH 4:29"/>ಬಿಲ್ಹದಲ್ಲಿಯೂ ಎಚೆಮಿನಲ್ಲಿಯೂ, ತೋಲಾದ್, <verse eid="1CH 4:29"/><verse number="30" style="v" sid="1CH 4:30"/>ಬೆತೂಯೇಲ್, ಹೊರ್ಮದಲ್ಲಿಯೂ; ಚಿಕ್ಲಗಿನಲ್ಲಿಯೂ; <verse eid="1CH 4:30"/><verse number="31" style="v" sid="1CH 4:31"/>ಬೇತ್ ಮರ್ಕಾಬೋತ್, ಹಚರ್ ಸೂಸೀಮ್, ಬೇತ್ ಬಿರೀ ಮತ್ತು ಶಾರಯಿಮ್‌ನಲ್ಲಿಯೂ ವಾಸವಾಗಿದ್ದರು. ದಾವೀದನ ಆಳ್ವಿಕೆಯವರೆಗೂ ಇವು ಅವರ ಪಟ್ಟಣಗಳಾಗಿದ್ದವು. <verse eid="1CH 4:31"/><verse number="32" style="v" sid="1CH 4:32"/>ಅವರ ಸುತ್ತಲಿನ ಗ್ರಾಮಗಳು ಯಾವುವೆಂದರೆ: ಏಟಾಮ್, ಆಯಿನ್, ರಿಮ್ಮೋನ್, ತೋಕೆನ್, ಆಷಾನ್ ಎಂಬ ಐದು ಪಟ್ಟಣಗಳು. <verse eid="1CH 4:32"/><verse number="33" style="v" sid="1CH 4:33"/>ಇದಲ್ಲದೆ ಆ ಪಟ್ಟಣಗಳ ಸುತ್ತಲಿದ್ದ ಊರುಗಳು ಬಾಳ್ ಪಟ್ಟಣದವರೆಗೆ ವಾಸವಾಗಿದ್ದರು.</para>
  <para style="b" vid="1CH 4:33"/>
  <para style="li4" vid="1CH 4:33">ಇವೇ ಅವರು ವಾಸವಾಗಿರುವ ಸ್ಥಳಗಳೂ, ಅವರ ವಂಶಾವಳಿಗಳೂ:<verse eid="1CH 4:33"/></para>
  <para style="b"/>
  <para style="li1">
    <verse number="34" style="v" sid="1CH 4:34"/>ಮೆಷೋಬಾಬನು, ಯಮ್ಲೇಕನು,</para>
  <para style="li1" vid="1CH 4:34">ಅಮಚ್ಯನ ಮಗನಾದ ಯೋಷನು, <verse eid="1CH 4:34"/><verse number="35" style="v" sid="1CH 4:35"/>ಯೋಯೇಲನು,</para>
  <para style="li1" vid="1CH 4:35">ಅಸಿಯೇಲನ ಮಗನಾದ ಸೆರಾಯನ ಮಗ ಯೊಷಿಬ್ಯನ ಮಗ ಯೇಹೂವು.<verse eid="1CH 4:35"/></para>
  <para style="li1">
    <verse number="36" style="v" sid="1CH 4:36"/>ಎಲ್ಯೋವೇನೈ, ಯಾಕೋಬ, ಯೆಷೋಹಾಯ,</para>
  <para style="li1" vid="1CH 4:36">ಅಸಾಯ, ಅದೀಯೇಲ್, ಯೆಸೀಮಿಯೇಲ್, ಬೆನಾಯಾ.<verse eid="1CH 4:36"/></para>
  <para style="li1">
    <verse number="37" style="v" sid="1CH 4:37"/>ಶೆಮಾಯನ ಮಗ ಶಿಮ್ರಿಯ ಮಗ ಯೆದಾಯನ ಮಗ ಅಲ್ಲೋನನ ಮಗ ಶಿಪ್ಫಿಯ ಮಗ ಜೀಜನು.<verse eid="1CH 4:37"/></para>
  <para style="b"/>
  <para style="li4">
    <verse number="38" style="v" sid="1CH 4:38"/>ಹೆಸರು ಹೆಸರಾಗಿ ಬರೆಯಲಾದ ಇವರು ತಮ್ಮ ಕುಟುಂಬಗಳಲ್ಲಿ ನಾಯಕರಾಗಿದ್ದರು.</para>
  <para style="b" vid="1CH 4:38"/>
  <para style="p" vid="1CH 4:38">ಅವರ ಪಿತೃಗಳ ಮನೆ ಬಹಳ ಅಭಿವೃದ್ಧಿಯಾಯಿತು. <verse eid="1CH 4:38"/><verse number="39" style="v" sid="1CH 4:39"/>ತಮ್ಮ ಮಂದೆಗಳಿಗೆ ಮೇವನ್ನು ಹುಡುಕಲು ತಗ್ಗಿನ ಪೂರ್ವದಿಕ್ಕಿನಲ್ಲಿರುವ ಗೆದೋರು ಎಂಬ ಸ್ಥಳದ ಪ್ರವೇಶದವರೆಗೂ ಹೋದರು. <verse eid="1CH 4:39"/><verse number="40" style="v" sid="1CH 4:40"/>ಅವರು ರಸವತ್ತಾದ ಒಳ್ಳೆಯ ಮೇವನ್ನು ಕಂಡುಕೊಂಡರು. ಆ ದೇಶವು ವಿಸ್ತಾರವಾಗಿಯೂ, ಶಾಂತವಾಗಿಯೂ, ಸಮಾಧಾನವಾಗಿಯೂ ಇತ್ತು. ಪೂರ್ವದಲ್ಲಿ ಹಾಮನ ವಂಶದವರು ಅಲ್ಲಿ ವಾಸವಾಗಿದ್ದರು.<verse eid="1CH 4:40"/></para>
  <para style="p">
    <verse number="41" style="v" sid="1CH 4:41"/>ಹೆಸರು ಹೆಸರಾಗಿ ಬರೆದಿರುವವರಾದ ಇವರು ಯೆಹೂದದ ಅರಸನಾದ ಹಿಜ್ಕೀಯನ ದಿವಸಗಳಲ್ಲಿ ಅಲ್ಲಿಗೆ ಹೋಗಿ ಹಾಮ್ಯರ ಡೇರೆಗಳನ್ನೂ ಅಲ್ಲಿ ಸಿಕ್ಕಿದ ಮೆಗೂನ್ಯರನ್ನೂ ಸಂಪೂರ್ಣವಾಗಿ ನಾಶಮಾಡಿದರು. ಅಲ್ಲಿ ತಮ್ಮ ಮಂದೆಗಳಿಗೆ ಮೇವು ಇರುವುದರಿಂದ ಇಂದಿನವರೆಗೂ ಅವರ ಸ್ಥಳದಲ್ಲಿ ವಾಸಿಸಿದರು. <verse eid="1CH 4:41"/><verse number="42" style="v" sid="1CH 4:42"/>ಇದಲ್ಲದೆ ಅವರಲ್ಲಿ ಸಿಮೆಯೋನನ ಪುತ್ರರಲ್ಲಿ ಐನೂರು ಮಂದಿ ಇಷ್ಷೀಯ ಪುತ್ರರಾದ ಪೆಲಟ್ಯ, ನೆಯರ್ಯ, ರೆಫಾಯ, ಉಜ್ಜೀಯೇಲ್ ಎಂಬವರನ್ನು ತಮ್ಮ ಅಧಿಪತಿಗಳಾಗಿ ಮಾಡಿಕೊಂಡು. ಸೇಯೀರ್ ಎಂಬ ಪರ್ವತ ದೇಶಕ್ಕೆ ಹೋದರು. <verse eid="1CH 4:42"/><verse number="43" style="v" sid="1CH 4:43"/>ಅವರು ತಪ್ಪಿಸಿಕೊಂಡ ಉಳಿದ ಅಮಾಲೇಕ್ಯರನ್ನು ಕೊಂದು, ಅಲ್ಲಿ ಇಂದಿನವರೆಗೂ ವಾಸವಾಗಿದ್ದಾರೆ.<verse eid="1CH 4:43"/></para>
  <chapter eid="1CH 4"/>
  <chapter number="5" style="c" sid="1CH 5"/>
  <para style="s1">ರೂಬೇನ್</para>
  <para style="li4">
    <verse number="1" style="v" sid="1CH 5:1"/>ಇಸ್ರಾಯೇಲಿನ ಚೊಚ್ಚಲಮಗನಾದ ರೂಬೇನನ ಪುತ್ರರು ಇವರು: ಅವನು ಚೊಚ್ಚಲ ಮಗನಾಗಿದ್ದನು. ಆದರೆ ಅವನು ತನ್ನ ತಂದೆಯ ಹಾಸಿಗೆಯನ್ನು ಅಪವಿತ್ರ ಮಾಡಿದ್ದರಿಂದ ಅವನ ಚೊಚ್ಚಲುತನದ ಹಕ್ಕು ಇಸ್ರಾಯೇಲಿನ ಮಗ ಯೋಸೇಫನ ಪುತ್ರರಿಗೆ ಕೊಡಲಾಗಿತ್ತು. ಆದ್ದರಿಂದ ಈ ವಂಶಾವಳಿಯು ಚೊಚ್ಚಲುತನದ ಪ್ರಕಾರ ಬರೆದಿರುವುದಿಲ್ಲ. <verse eid="1CH 5:1"/><verse number="2" style="v" sid="1CH 5:2"/>ಯೆಹೂದನು ತನ್ನ ಸಹೋದರರಿಗಿಂತ ಪ್ರಬಲವುಳ್ಳವನಾದನು. ಅವನಿಂದ ಮುಖ್ಯ ಅಧಿಕಾರಿಯು ಹುಟ್ಟಿದನು. ಆದರೆ ಚೊಚ್ಚಲುತನವು ಯೋಸೇಫನದಾಗಿತ್ತು. <verse eid="1CH 5:2"/><verse number="3" style="v" sid="1CH 5:3"/>ಇಸ್ರಾಯೇಲಿನ ಚೊಚ್ಚಲ ಮಗ ರೂಬೇನನ ಪುತ್ರರು:</para>
  <para style="b" vid="1CH 5:3"/>
  <para style="li2" vid="1CH 5:3">ಹನೋಕ್, ಪಲ್ಲೂ, ಹೆಚ್ರೋನನು, ಕರ್ಮೀ.<verse eid="1CH 5:3"/></para>
  <para style="li1">
    <verse number="4" style="v" sid="1CH 5:4"/>ಯೋಯೇಲನ ವಂಶಜರು:</para>
  <para style="li2" vid="1CH 5:4">ಅವನ ಮಗ ಶೆಮಾಯನು; ಅವನ ಮಗ ಗೋಗನು;</para>
  <para style="li2" vid="1CH 5:4">ಅವನ ಮಗ ಶಿಮ್ಮೀಯಿ. <verse eid="1CH 5:4"/><verse number="5" style="v" sid="1CH 5:5"/>ಅವನ ಮಗ ಮೀಕಾಯನು;</para>
  <para style="li2" vid="1CH 5:5">ಅವನ ಮಗ ರೆವಾಯನು, ಅವನ ಮಗ ಬಾಳನು.<verse eid="1CH 5:5"/></para>
  <para style="li2">
    <verse number="6" style="v" sid="1CH 5:6"/>ಅಸ್ಸೀರಿಯದ ಅರಸನಾದ ತಿಗ್ಲತ್ಪಿಲೆಸರಿನಿಂದ ಸೆರೆಯಾಗಿ ಒಯ್ದ ಅವನ ಮಗ ಬೇರನು; ಅವನೇ ರೂಬೇನ್ಯರಲ್ಲಿ ನಾಯಕನಾಗಿದ್ದನು.<verse eid="1CH 5:6"/></para>
  <para style="li1">
    <verse number="7" style="v" sid="1CH 5:7"/>ಇವನ ಸಹೋದರರು ತಮ್ಮ ಸಂತತಿಗಳಲ್ಲಿ ವಂಶಗಳ ವಂಶಾವಳಿಯನ್ನು ಲೆಕ್ಕಿಸಿದ ಅವನ ಮುಖ್ಯಸ್ಥರು ಯಾರೆಂದರೆ,</para>
  <para style="li2" vid="1CH 5:7">ಯೆಹಿಯೇಲ್, ಜೆಕರ್ಯ, <verse eid="1CH 5:7"/><verse number="8" style="v" sid="1CH 5:8"/>ಅಜಾಜನ ಮಗನೂ ಶೆಮಯನ ಮಗನೂ ಯೋಯೇಲನ ಮಗನೂ ಆದ ಬೆಳ.</para>
  <para style="b" vid="1CH 5:8"/>
  <para style="p" vid="1CH 5:8">ಇವರು ಅರೋಯೇರು ಮೊದಲ್ಗೊಂಡು ನೆಬೋ, ಬಾಳ್ ಮೆಯೋನ್ ಎಂಬ ಸ್ಥಳಗಳವರೆಗೂ ವಾಸವಾಗಿದ್ದರು. <verse eid="1CH 5:8"/><verse number="9" style="v" sid="1CH 5:9"/>ಗಿಲ್ಯಾದಿನ ದೇಶದಲ್ಲಿ ಅವನ ಪಶುಗಳು ಹೆಚ್ಚಾದುದರಿಂದ, ಅವನು ಪೂರ್ವದಿಕ್ಕಿನಲ್ಲಿ ಯೂಫ್ರೇಟೀಸ್ ನದಿ ಮೊದಲ್ಗೊಂಡು ಮರುಭೂಮಿಯ ಪ್ರದೇಶದವರೆಗೂ ವಾಸವಾಗಿದ್ದನು.<verse eid="1CH 5:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="1CH 5:10"/>ಸೌಲನ ದಿವಸಗಳಲ್ಲಿ ರೂಬೇನ್ ವಂಶದವರು ಹಗ್ರೀಯರ ಸಂಗಡ ಯುದ್ಧಮಾಡಿ, ಅವರ ಕೈಯಲ್ಲಿ ಸೋತುಹೋದರು. ರೂಬೇನ್ ವಂಶದವರು ಗಿಲ್ಯಾದಿನ ಸಮಸ್ತ ಪೂರ್ವ ದಿಕ್ಕಿನಾದ್ಯಂತ ಹಗ್ರೀಯರ ವಾಸಸ್ಥಾನಗಳನ್ನು ಆಕ್ರಮಿಸಿಕೊಂಡರು.<verse eid="1CH 5:10"/></para>
  <para style="s1">ಗಾದ್</para>
  <para style="li4">
    <verse number="11" style="v" sid="1CH 5:11"/>ಗಾದನ ಮಕ್ಕಳು ಅವರಿಗೆದುರಾಗಿ ಬಾಷಾನ್ ದೇಶದಲ್ಲಿ ಸಲ್ಕದವರೆಗೂ ವಾಸವಾಗಿದ್ದರು.<verse eid="1CH 5:11"/></para>
  <para style="b"/>
  <para style="li1">
    <verse number="12" style="v" sid="1CH 5:12"/>ಬಾಷಾನಿನಲ್ಲಿ ಮುಖ್ಯನಾದವನು ಯೋಯೇಲನು, ಎರಡನೆಯವನು ಶಾಫಾಮನು, ಅನಂತರ ಯನ್ನೈ, ಶಾಫಾಟನು.<verse eid="1CH 5:12"/></para>
  <para style="li1">
    <verse number="13" style="v" sid="1CH 5:13"/>ಕುಟುಂಬಗಳಾಗಿ ಅವರ ಬಂಧುಗಳು:</para>
  <para style="li2" vid="1CH 5:13">ಮೀಕಾಯೇಲನು, ಮೆಷುಲ್ಲಾಮನು, ಶೆಬನು, ಯೋರೈನು, ಯಕ್ಕಾನನು, ಜೀಯನು, ಏಬೆರನು; ಒಟ್ಟು ಏಳುಮಂದಿ.<verse eid="1CH 5:13"/></para>
  <para style="li2">
    <verse number="14" style="v" sid="1CH 5:14"/>ಇವರು ಹೂರಿಯ ಮಗ ಅಬೀಹೈಲನ ಪುತ್ರರು: ಈ ಹೂರೀಯು ಯಾರೋಹನ ಮಗನು, ಅವನು ಗಿಲ್ಯಾದನ ಮಗನು, ಅವನು ಮೀಕಾಯೇಲನ ಮಗನು, ಅವನು ಯೆಷೀಷೈಯನ ಮಗನು, ಅವನು ಯಹ್ದೋವಿನ ಮಗನು, ಅವನು ಬೂಜನ ಮಗನು.<verse eid="1CH 5:14"/></para>
  <para style="li2">
    <verse number="15" style="v" sid="1CH 5:15"/>ಅಬ್ದಿಯೇಲನ ಮಗನೂ ಗೂನೀಯ ಮೊಮ್ಮಗನೂ ಆದ ಅಹೀಯು ಈ ಗೋತ್ರದ ಮುಖ್ಯಸ್ಥನು.<verse eid="1CH 5:15"/></para>
  <para style="b"/>
  <para style="p">
    <verse number="16" style="v" sid="1CH 5:16"/>ಅವರು ಗಿಲ್ಯಾದಿನಲ್ಲಿರುವ ಬಾಷಾನಿನಲ್ಲಿಯೂ, ಅವರ ಊರುಗಳಲ್ಲಿಯೂ, ಅದರ ಮೇರೆಯಲ್ಲಿರುವ ಶಾರೋನಿನ ಸಮಸ್ತ ಉಪನಗರಗಳಲ್ಲಿಯೂ ವಾಸವಾಗಿದ್ದರು.<verse eid="1CH 5:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="1CH 5:17"/>ಇವರೆಲ್ಲರು ಯೆಹೂದದ ಅರಸನಾದ ಯೋತಾಮನ ದಿವಸಗಳಲ್ಲಿಯೂ, ಇಸ್ರಾಯೇಲಿನ ಅರಸನಾದ ಯಾರೊಬ್ಬಾಮನ ದಿವಸಗಳಲ್ಲಿಯೂ ವಂಶಾವಳಿಯ ಪಟ್ಟಿಯಲ್ಲಿ ಲಿಖಿತರಾದರು.<verse eid="1CH 5:17"/></para>
  <para style="b"/>
  <para style="p">
    <verse number="18" style="v" sid="1CH 5:18"/>ರೂಬೇನ್ಯರಲ್ಲಿಯೂ, ಗಾದ್ಯರಲ್ಲಿಯೂ, ಮನಸ್ಸೆಯ ಅರ್ಧ ಗೋತ್ರದಲ್ಲಿಯೂ, ಗುರಾಣಿಯನ್ನೂ, ಖಡ್ಗವನ್ನೂ ಹಿಡಿಯುವುದಕ್ಕೆ ಬಿಲ್ಲೆಸೆಯುವುದಕ್ಕೆ ಯುದ್ಧದಲ್ಲಿ ಪ್ರವೀಣರಾದ ಪರಾಕ್ರಮಶಾಲಿಗಳಾದ ಯುದ್ಧಕ್ಕೆ ಹೊರಡುವವರು 44,760 ಮಂದಿಯಾಗಿದ್ದರು. <verse eid="1CH 5:18"/><verse number="19" style="v" sid="1CH 5:19"/>ಇವರು ಹಗ್ರೀಯರಾದ ಯೆಟೂರನು, ನಾಫೀಷನು, ನೊದಾಬನು ಎಂಬವರ ವಿರುದ್ಧ ಯುದ್ಧಮಾಡಿದರು. <verse eid="1CH 5:19"/><verse number="20" style="v" sid="1CH 5:20"/>ಇವರು ಅವರಿಗೆ ವಿರೋಧವಾಗಿ ಸಹಾಯ ಹೊಂದಿದ್ದರಿಂದ, ಹಗ್ರೀಯರೂ, ಅವರ ಸಂಗಡ ಕೂಡಿದ್ದವರೆಲ್ಲರೂ ಇವರ ಕೈವಶವಾದರು. ಅವರು ಯುದ್ಧದಲ್ಲಿ ದೇವರಿಗೆ ಮೊರೆಯಿಟ್ಟು, ಅವರಲ್ಲಿ ಭರವಸೆ ಇಟ್ಟಿದ್ದರಿಂದ, ದೇವರು ಅವರ ಮನವಿಯನ್ನು ಕೇಳಿದರು. <verse eid="1CH 5:20"/><verse number="21" style="v" sid="1CH 5:21"/>ಅವರು ವೈರಿಗಳಿಂದ ಎಲ್ಲಾ ಪಶುಗಳನ್ನು ಅವರು ತಮ್ಮ ವಶಕ್ಕೆ ತೆಗೆದುಕೊಂಡರು. ಐವತ್ತು ಸಾವಿರ ಒಂಟೆಗಳನ್ನು, ಎರಡು ಲಕ್ಷದ ಐವತ್ತು ಸಾವಿರ ಕುರಿಗಳನ್ನು, ಎರಡು ಸಾವಿರ ಕತ್ತೆಗಳನ್ನು ಅಲ್ಲದೆ, ಒಂದು ಲಕ್ಷ ಜನರನ್ನು ಯುದ್ಧ ಕೈದಿಗಳನ್ನಾಗಿ ಸೆರೆಹಿಡಿದರು. <verse eid="1CH 5:21"/><verse number="22" style="v" sid="1CH 5:22"/>ಏಕೆಂದರೆ ಯುದ್ಧವು ದೇವರಿಂದ ಉಂಟಾದ ಕಾರಣ, ಅನೇಕ ಜನರು ಹತರಾದರು. ಇವರು ಸೆರೆಯಾಗಿ ಹೋಗುವ ಕಾಲದವರೆಗೂ ಅವರ ಸ್ಥಳದಲ್ಲಿ ವಾಸವಾಗಿದ್ದರು.<verse eid="1CH 5:22"/></para>
  <para style="s1">ಮನಸ್ಸೆಯ ಅರ್ಧ ಗೋತ್ರದ ಜನರು</para>
  <para style="p">
    <verse number="23" style="v" sid="1CH 5:23"/>ಮನಸ್ಸೆಯ ಅರ್ಧ ಗೋತ್ರದ ಜನರು ದೇಶದಲ್ಲಿ ವಾಸಮಾಡಿ, ಬಾಷಾನ್ ಮೊದಲುಗೊಂಡು ಬಾಳ್ ಹೆರ್ಮೋನ್, ಸೆನೀರ್, ಹೆರ್ಮೋನ್ ಬೆಟ್ಟದವರೆಗೂ ಹಬ್ಬಿಕೊಂಡರು.<verse eid="1CH 5:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="1CH 5:24"/>ಅವರ ಪಿತೃಗಳ ಮನೆಯಲ್ಲಿರುವ ಯಜಮಾನರು ಯಾರೆಂದರೆ: ಏಫೆರ್, ಇಷ್ಷೀ, ಎಲೀಯೇಲ್, ಅಜ್ರಿಯೇಲ್, ಯೆರೆಮೀಯ, ಹೋದವ್ಯ, ಯೆಹ್ತೀಯೇಲ್. ಇವರು ಪರಾಕ್ರಮಶಾಲಿಗಳಾಗಿಯೂ, ಹೆಸರುಗೊಂಡವರಾಗಿಯೂ, ತಮ್ಮ ಪಿತೃಗಳ ಮನೆಯಲ್ಲಿ ಯಜಮಾನರಾಗಿಯೂ ಇದ್ದರು. <verse eid="1CH 5:24"/><verse number="25" style="v" sid="1CH 5:25"/>ಆದರೆ ಅವರು ತಮ್ಮ ಪಿತೃಗಳ ದೇವರಿಗೆ ದ್ರೋಹಿಗಳಾಗಿದ್ದರು. ದೇವರು ತಮ್ಮ ಮುಂದೆ ನಾಶಮಾಡಿದ ಆ ದೇಶದ ಜನರ ದೇವರುಗಳ ಹಿಂದೆ ಜಾರರಾಗಿ ಹೋದರು. <verse eid="1CH 5:25"/><verse number="26" style="v" sid="1CH 5:26"/>ಆದಕಾರಣ ಇಸ್ರಾಯೇಲಿನ ದೇವರು ಅಸ್ಸೀರಿಯದ ಅರಸನಾದ ಪೂಲನ ಆತ್ಮವನ್ನೂ ಅಸ್ಸೀರಿಯದ ಅರಸನಾದ ತಿಗ್ಲತ್ಪಿಲೆಸರನ ಆತ್ಮವನ್ನೂ ಪ್ರೇರಿಸಿದ್ದರಿಂದ, ಅವರು ಅವರನ್ನು ಸೆರೆಯಾಗಿ ಒಯ್ದರು. ಆ ರೂಬೇನ್ಯರನ್ನೂ, ಗಾದ್ಯರನ್ನೂ, ಮನಸ್ಸೆಯ ಅರ್ಧ ಗೋತ್ರದವರನ್ನೂ ಹಲಹ, ಹಾಬೋರ್, ಹಾರ, ಎಂಬ ಪ್ರಾಂತಗಳಿಗೂ ಗೋಜಾನ್ ನದಿಯ ಪ್ರದೇಶಗಳಿಗೂ ತೆಗೆದುಕೊಂಡು ಹೋದರು. ಅವರು ಇಂದಿನವರೆಗೂ ಅಲ್ಲಿಯೇ ಇದ್ದಾರೆ.<verse eid="1CH 5:26"/></para>
  <chapter eid="1CH 5"/>
  <chapter number="6" style="c" sid="1CH 6"/>
  <para style="s1">ಲೇವಿ</para>
  <para style="li1">
    <verse number="1" style="v" sid="1CH 6:1"/>ಲೇವಿಯ ಪುತ್ರರು:</para>
  <para style="li2" vid="1CH 6:1">ಗೇರ್ಷೋನ್, ಕೊಹಾತ್, ಮೆರಾರೀ.<verse eid="1CH 6:1"/></para>
  <para style="li1">
    <verse number="2" style="v" sid="1CH 6:2"/>ಕೊಹಾತನ ಪುತ್ರರು:</para>
  <para style="li2" vid="1CH 6:2">ಅಮ್ರಾಮ್, ಇಚ್ಹಾರ್, ಹೆಬ್ರೋನ್, ಉಜ್ಜೀಯೇಲನು.<verse eid="1CH 6:2"/></para>
  <para style="li1">
    <verse number="3" style="v" sid="1CH 6:3"/>ಅಮ್ರಾಮನ ಪುತ್ರರು:</para>
  <para style="li2" vid="1CH 6:3">ಆರೋನನು, ಮೋಶೆಯು, ಮಿರ್ಯಾಮಳು.</para>
  <para style="li1" vid="1CH 6:3">ಆರೋನನ ಪುತ್ರರು:</para>
  <para style="li2" vid="1CH 6:3">ನಾದಾಬ್, ಅಬೀಹೂ, ಎಲಿಯಾಜರ್, ಈತಾಮಾರ್.<verse eid="1CH 6:3"/></para>
  <para style="li2">
    <verse number="4" style="v" sid="1CH 6:4"/>ಎಲಿಯಾಜರನು ಫೀನೆಹಾಸನನ್ನು ಪಡೆದನು,</para>
  <para style="li2" vid="1CH 6:4">ಫೀನೆಹಾಸನು ಅಬೀಷೂವನನ್ನು ಪಡೆದನು,<verse eid="1CH 6:4"/></para>
  <para style="li2">
    <verse number="5" style="v" sid="1CH 6:5"/>ಅಬೀಷೂವನು ಬುಕ್ಕೀಯನನ್ನು ಪಡೆದನು,</para>
  <para style="li2" vid="1CH 6:5">ಬುಕ್ಕೀಯನು ಉಜ್ಜೀಯನನ್ನು ಪಡೆದನು,<verse eid="1CH 6:5"/></para>
  <para style="li2">
    <verse number="6" style="v" sid="1CH 6:6"/>ಉಜ್ಜೀಯನು ಜೆರಹ್ಯನನ್ನು ಪಡೆದನು,</para>
  <para style="li2" vid="1CH 6:6">ಜೆರಹ್ಯನು ಮೆರಾಯೋತನನ್ನು ಪಡೆದನು,<verse eid="1CH 6:6"/></para>
  <para style="li2">
    <verse number="7" style="v" sid="1CH 6:7"/>ಮೆರಾಯೋತನು ಅಮರ್ಯನನ್ನು ಪಡೆದನು,</para>
  <para style="li2" vid="1CH 6:7">ಅಮರ್ಯನು ಅಹೀಟೂಬನನ್ನು ಪಡೆದನು,<verse eid="1CH 6:7"/></para>
  <para style="li2">
    <verse number="8" style="v" sid="1CH 6:8"/>ಅಹೀಟೂಬನು ಚಾದೋಕನನ್ನು ಪಡೆದನು,</para>
  <para style="li2" vid="1CH 6:8">ಚಾದೋಕನು ಅಹೀಮಾಚನನ್ನು ಪಡೆದನು,<verse eid="1CH 6:8"/></para>
  <para style="li2">
    <verse number="9" style="v" sid="1CH 6:9"/>ಅಹೀಮಾಚನು ಅಜರ್ಯನನ್ನು ಪಡೆದನು,</para>
  <para style="li2" vid="1CH 6:9">ಅಜರ್ಯನು ಯೋಹಾನಾನನನ್ನು ಪಡೆದನು;<verse eid="1CH 6:9"/></para>
  <para style="li2">
    <verse number="10" style="v" sid="1CH 6:10"/>ಯೋಹಾನಾನನು ಅಜರ್ಯನನ್ನು ಪಡೆದನು.</para>
  <para style="li2" vid="1CH 6:10">ಅಜರ್ಯನು ಯೆರೂಸಲೇಮಿನಲ್ಲಿ ಸೊಲೊಮೋನನು ಕಟ್ಟಿಸಿದ ದೇವಾಲಯದೊಳಗೆ ಯಾಜಕ ಸೇವೆ ಮಾಡುತ್ತಿದ್ದವನು.<verse eid="1CH 6:10"/></para>
  <para style="li2">
    <verse number="11" style="v" sid="1CH 6:11"/>ಅಜರ್ಯನು ಅಮರ್ಯನನ್ನು ಪಡೆದನು,</para>
  <para style="li2" vid="1CH 6:11">ಅಮರ್ಯನು ಅಹೀಟೂಬನನ್ನು ಪಡೆದನು,<verse eid="1CH 6:11"/></para>
  <para style="li2">
    <verse number="12" style="v" sid="1CH 6:12"/>ಅಹೀಟೂಬನು ಚಾದೋಕನನ್ನು ಪಡೆದನು,</para>
  <para style="li2" vid="1CH 6:12">ಚಾದೋಕನು ಶಲ್ಲೂಮನನ್ನು ಪಡೆದನು,<verse eid="1CH 6:12"/></para>
  <para style="li2">
    <verse number="13" style="v" sid="1CH 6:13"/>ಶಲ್ಲೂಮನು ಹಿಲ್ಕೀಯನನ್ನು ಪಡೆದನು,</para>
  <para style="li2" vid="1CH 6:13">ಹಿಲ್ಕೀಯನು ಅಜರ್ಯನನ್ನು ಪಡೆದನು,<verse eid="1CH 6:13"/></para>
  <para style="li2">
    <verse number="14" style="v" sid="1CH 6:14"/>ಅಜರ್ಯನು ಸೆರಾಯನನ್ನು ಪಡೆದನು,</para>
  <para style="li2" vid="1CH 6:14">ಸೆರಾಯನು ಯೆಹೋಚಾದಾಕನನ್ನು<note caller="+" style="f"><char style="fr" closed="false">6:14 </char><char style="fq" closed="false">ಯೆಹೋಚಾದಾಕ </char><char style="ft" closed="false">ಅಥವಾ </char><char style="fqa" closed="false">ಯೋಚಾದಾಕ</char></note> ಪಡೆದನು,<verse eid="1CH 6:14"/></para>
  <para style="li2">
    <verse number="15" style="v" sid="1CH 6:15"/>ಯೆಹೋವ ದೇವರು ನೆಬೂಕದ್ನೆಚ್ಚರನ ಕೈಯಿಂದ ಯೆಹೂದ, ಯೆರೂಸಲೇಮಿನವರನ್ನು ಸೆರೆಯಾಗಿ ಒಯ್ದಾಗ ಯೆಹೋಚಾದಾಕನು ಸೆರೆಯಾಗಿ ಹೋದನು.<verse eid="1CH 6:15"/></para>
  <para style="b"/>
  <para style="li1">
    <verse number="16" style="v" sid="1CH 6:16"/>ಲೇವಿಯ ಪುತ್ರರು:</para>
  <para style="li2" vid="1CH 6:16">ಗೇರ್ಷೋಮ್, ಕೊಹಾತ್, ಮೆರಾರೀ ಎಂಬುವರು.<verse eid="1CH 6:16"/></para>
  <para style="li1">
    <verse number="17" style="v" sid="1CH 6:17"/>ಗೇರ್ಷೋಮನ ಪುತ್ರರ ಹೆಸರುಗಳು:</para>
  <para style="li2" vid="1CH 6:17">ಲಿಬ್ನೀ, ಶಿಮ್ಮೀ.<verse eid="1CH 6:17"/></para>
  <para style="li1">
    <verse number="18" style="v" sid="1CH 6:18"/>ಕೊಹಾತನ ಪುತ್ರರು:</para>
  <para style="li2" vid="1CH 6:18">ಅಮ್ರಾಮ್, ಇಚ್ಹಾರ್, ಹೆಬ್ರೋನ್, ಉಜ್ಜೀಯೇಲ್.<verse eid="1CH 6:18"/></para>
  <para style="li1">
    <verse number="19" style="v" sid="1CH 6:19"/>ಮೆರಾರೀಯ ಪುತ್ರರು:</para>
  <para style="li2" vid="1CH 6:19">ಮಹ್ಲೀ, ಮೂಷೀ.</para>
  <para style="b" vid="1CH 6:19"/>
  <para style="li4" vid="1CH 6:19">ಲೇವಿಯರ ಸಂತತಿಗಳು ತಮ್ಮ ಪಿತೃಗಳ ಪ್ರಕಾರವಾಗಿ:<verse eid="1CH 6:19"/></para>
  <para style="li1">
    <verse number="20" style="v" sid="1CH 6:20"/>ಗೇರ್ಷೋಮಿನವರು:</para>
  <para style="li2" vid="1CH 6:20">ಅವನ ಮಗ ಲಿಬ್ನೀ, ಅವನ ಮಗ ಯಹತ್,</para>
  <para style="li2" vid="1CH 6:20">ಅವನ ಮಗ ಜಿಮ್ಮ,<verse eid="1CH 6:20"/></para>
  <para style="li2">
    <verse number="21" style="v" sid="1CH 6:21"/>ಅವನ ಮಗ ಯೋವಾಹ, ಅವನ ಮಗ ಇದ್ದೋ, ಅವನ ಮಗನಾದ ಜೆರಹ,</para>
  <para style="li2" vid="1CH 6:21">ಅವನ ಮಗ ಯೆವತ್ರೈ.<verse eid="1CH 6:21"/></para>
  <para style="li1">
    <verse number="22" style="v" sid="1CH 6:22"/>ಕೊಹಾತನ ಪುತ್ರರು:</para>
  <para style="li2" vid="1CH 6:22">ಅವನ ಮಗ ಅಮ್ಮೀನಾದಾಬ್, ಅವನ ಮಗ ಕೋರಹ,</para>
  <para style="li2" vid="1CH 6:22">ಅವನ ಮಗ ಅಸ್ಸೀರ್, <verse eid="1CH 6:22"/><verse number="23" style="v" sid="1CH 6:23"/>ಅವನ ಮಗ ಎಲ್ಕಾನಾ,</para>
  <para style="li2" vid="1CH 6:23">ಅವನ ಮಗ ಎಬ್ಯಾಸಾಫ್, ಅವನ ಮಗ ಅಸ್ಸೀರ್,<verse eid="1CH 6:23"/></para>
  <para style="li2">
    <verse number="24" style="v" sid="1CH 6:24"/>ಅವನ ಮಗ ತಹತ್, ಅವನ ಮಗ ಉರೀಯೇಲ್,</para>
  <para style="li2" vid="1CH 6:24">ಅವನ ಮಗ ಉಜ್ಜೀಯ, ಅವನ ಮಗ ಸೌಲ್.<verse eid="1CH 6:24"/></para>
  <para style="li1">
    <verse number="25" style="v" sid="1CH 6:25"/>ಎಲ್ಕಾನನ ವಂಶಜರು:</para>
  <para style="li2" vid="1CH 6:25">ಅಮಾಸೈ, ಅಹಿಮೋತ್,<verse eid="1CH 6:25"/></para>
  <para style="li2">
    <verse number="26" style="v" sid="1CH 6:26"/>ಅವನ ಮಗ ಎಲ್ಕಾನ, ಅವನ ಮಗ ಚೋಫೈ,</para>
  <para style="li2" vid="1CH 6:26">ಅವನ ಮಗ ನಹತ್, <verse eid="1CH 6:26"/><verse number="27" style="v" sid="1CH 6:27"/>ಅವನ ಮಗ ಎಲೀಯಾಬ್,</para>
  <para style="li2" vid="1CH 6:27">ಅವನ ಮಗ ಯೆರೋಹಾಮ್, ಅವನ ಮಗ ಎಲ್ಕಾನ,</para>
  <para style="li2" vid="1CH 6:27">ಅವನ ಮಗ ಸಮುಯೇಲ್.<verse eid="1CH 6:27"/></para>
  <para style="li1">
    <verse number="28" style="v" sid="1CH 6:28"/>ಸಮುಯೇಲನ ಪುತ್ರರು:</para>
  <para style="li2" vid="1CH 6:28">ಚೊಚ್ಚಲ ಮಗ ವಷ್ಣಿ ಎಂಬ ಯೋಯೇಲ್ ಮತ್ತು</para>
  <para style="li2" vid="1CH 6:28">ಎರಡನೆಯ ಮಗ ಅಬೀಯ.<verse eid="1CH 6:28"/></para>
  <para style="li1">
    <verse number="29" style="v" sid="1CH 6:29"/>ಮೆರಾರೀಯ ವಂಶಜರು:</para>
  <para style="li2" vid="1CH 6:29">ಮಹ್ಲೀ, ಅವನ ಮಗ ಲಿಬ್ನೀ,</para>
  <para style="li2" vid="1CH 6:29">ಅವನ ಮಗ ಶಿಮ್ಮಿ; ಅವನ ಮಗ ಉಜ್ಜ,<verse eid="1CH 6:29"/></para>
  <para style="li2">
    <verse number="30" style="v" sid="1CH 6:30"/>ಅವನ ಮಗ ಶಿಮ್ಮಾ, ಅವನ ಮಗ ಹಗ್ಗೀಯ,</para>
  <para style="li2" vid="1CH 6:30">ಅವನ ಮಗ ಅಸಾಯ.<verse eid="1CH 6:30"/></para>
  <para style="s2">ದೇವಾಲಯದ ವಾದ್ಯಗಾರರು</para>
  <para style="p">
    <verse number="31" style="v" sid="1CH 6:31"/>ಮಂಜೂಷವನ್ನು ನೆಲೆಗೊಳಿಸಿದ ತರುವಾಯ ದಾವೀದನು ಯೆಹೋವ ದೇವರ ಮನೆಯಲ್ಲಿ ವಾದ್ಯಗಾರರನ್ನು ನೇಮಿಸಿದನು. <verse eid="1CH 6:31"/><verse number="32" style="v" sid="1CH 6:32"/>ಸೊಲೊಮೋನನು ಯೆರೂಸಲೇಮಿನಲ್ಲಿ ಯೆಹೋವ ದೇವರ ಆಲಯವನ್ನು ಕಟ್ಟುವವರೆಗೆ, ಈ ವಾದ್ಯಗಾರರು ಸಭೆಯ ಗುಡಾರದ ನಿವಾಸದ ಮುಂದೆ ಸೇವಿಸುತ್ತಾ ಇದ್ದರು. ಆಗ ಅವರು ತಮ್ಮ ಸೇವೆಯಲ್ಲಿ ಕ್ರಮದ ಪ್ರಕಾರ ಕಾಯುತ್ತಿದ್ದರು.<verse eid="1CH 6:32"/></para>
  <para style="b"/>
  <para style="li4">
    <verse number="33" style="v" sid="1CH 6:33"/>ಸೇವೆಗೆ ಆಯ್ಕೆಯಾದ ವ್ಯಕ್ತಿಗಳು ಮತ್ತು ಅವರ ಪುತ್ರರ ಹೆಸರುಗಳು ಹೀಗಿವೆ:</para>
  <para style="b" vid="1CH 6:33"/>
  <para style="li1" vid="1CH 6:33">ಕೊಹಾತ್ಯರ ಮಕ್ಕಳಲ್ಲಿ</para>
  <para style="li2" vid="1CH 6:33">ಸಂಗೀತಗಾರನಾದ ಹೇಮಾನನು.</para>
  <para style="li2" vid="1CH 6:33">ಅವನು ಯೋಯೇಲನ ಮಗನು, ಅವನು ಸಮುಯೇಲನ ಮಗನು,<verse eid="1CH 6:33"/></para>
  <para style="li2">
    <verse number="34" style="v" sid="1CH 6:34"/>ಅವನು ಎಲ್ಕಾನನ ಮಗನು, ಅವನು ಯೆರೋಹಾಮನ ಮಗನು,</para>
  <para style="li2" vid="1CH 6:34">ಅವನು ಎಲೀಯೇಲನ ಮಗನು, ಅವನು ತೋಹನ ಮಗನು,<verse eid="1CH 6:34"/></para>
  <para style="li2">
    <verse number="35" style="v" sid="1CH 6:35"/>ಅವನು ಚೂಫನ ಮಗನು, ಅವನು ಎಲ್ಕಾನನ ಮಗನು,</para>
  <para style="li2" vid="1CH 6:35">ಅವನು ಮಹತನ ಮಗನು, ಅವನು ಅಮಾಸೈಯ ಮಗನು,<verse eid="1CH 6:35"/></para>
  <para style="li2">
    <verse number="36" style="v" sid="1CH 6:36"/>ಅವನು ಎಲ್ಕಾನನ ಮಗನು, ಅವನು ಯೋಯೇಲನ ಮಗನು,</para>
  <para style="li2" vid="1CH 6:36">ಅವನು ಅಜರ್ಯನ ಮಗನು, ಅವನು ಚೆಫನ್ಯನ ಮಗನು,<verse eid="1CH 6:36"/></para>
  <para style="li2">
    <verse number="37" style="v" sid="1CH 6:37"/>ಅವನು ತಹತನ ಮಗನು, ಅವನು ಅಸ್ಸೀರನ ಮಗನು,</para>
  <para style="li2" vid="1CH 6:37">ಅವನು ಎಬ್ಯಾಸಾಫನ ಮಗನು, ಅವನು ಕೋರಹನ ಮಗನು,<verse eid="1CH 6:37"/></para>
  <para style="li2">
    <verse number="38" style="v" sid="1CH 6:38"/>ಅವನು ಇಚ್ಹಾರನ ಮಗನು, ಅವನು ಕೊಹಾತನ ಮಗನು,</para>
  <para style="li2" vid="1CH 6:38">ಅವನು ಲೇವಿಯನ ಮಗನು, ಅವನು ಇಸ್ರಾಯೇಲನ ಮಗನು.<verse eid="1CH 6:38"/></para>
  <para style="li1">
    <verse number="39" style="v" sid="1CH 6:39"/>ಹೇಮಾನನ ಬಲಗಡೆಯಲ್ಲಿ ನಿಲ್ಲುತ್ತಿದ್ದ ಅವನ ಸಹೋದರನಾದ ಆಸಾಫನು ಜೊತೆಸೇವಕನಾಗಿದ್ದನು.</para>
  <para style="li2" vid="1CH 6:39">ಈ ಆಸಾಫನು ಬೆರೆಕ್ಯನ ಮಗನು, ಅವನು ಶಿಮ್ಮನ ಮಗನು.<verse eid="1CH 6:39"/></para>
  <para style="li2">
    <verse number="40" style="v" sid="1CH 6:40"/>ಅವನು ಮೀಕಾಯೇಲನ ಮಗನು, ಅವನು ಬಾಸೇಯನ ಮಗನು,</para>
  <para style="li2" vid="1CH 6:40">ಅವನು ಮಲ್ಕೀಯನ ಮಗನು, <verse eid="1CH 6:40"/><verse number="41" style="v" sid="1CH 6:41"/>ಅವನು ಎತ್ನಿಯ ಮಗನು,</para>
  <para style="li2" vid="1CH 6:41">ಅವನು ಜೆರಹನ ಮಗನು, ಅವನು ಅದಾಯನ ಮಗನು,<verse eid="1CH 6:41"/></para>
  <para style="li2">
    <verse number="42" style="v" sid="1CH 6:42"/>ಅವನು ಏತಾನನ ಮಗನು, ಅವನು ಜಿಮ್ಮನ ಮಗನು,</para>
  <para style="li2" vid="1CH 6:42">ಅವನು ಶಿಮ್ಮಿಯ ಮಗನು, <verse eid="1CH 6:42"/><verse number="43" style="v" sid="1CH 6:43"/>ಅವನು ಯಹತನ ಮಗನು,</para>
  <para style="li2" vid="1CH 6:43">ಅವನು ಗೇರ್ಷೋಮನ ಮಗನು, ಅವನು ಲೇವಿಯ ಮಗನು.<verse eid="1CH 6:43"/></para>
  <para style="li1">
    <verse number="44" style="v" sid="1CH 6:44"/>ಅವರ ಸಹೋದ್ಯೋಗಿ ಮೆರಾರೀಯ ಪುತ್ರರು ಎಡಗಡೆಯಲ್ಲಿ ನಿಂತಿದ್ದರು.</para>
  <para style="li2" vid="1CH 6:44">ಏತಾನನು ಕೀಷೀಯ ಮಗನು, ಅವನು ಅಬ್ದೀಯ ಮಗನು,</para>
  <para style="li2" vid="1CH 6:44">ಅವನು ಮಲ್ಲೂಕನ ಮಗನು, <verse eid="1CH 6:44"/><verse number="45" style="v" sid="1CH 6:45"/>ಅವನು ಹಷಬ್ಯನ ಮಗನು,</para>
  <para style="li2" vid="1CH 6:45">ಅವನು ಅಮಚ್ಯನ ಮಗನು, ಅವನು ಹಿಲ್ಕೀಯನ ಮಗನು,<verse eid="1CH 6:45"/></para>
  <para style="li2">
    <verse number="46" style="v" sid="1CH 6:46"/>ಅವನು ಅಮ್ಚೀಯ ಮಗನು, ಅವನು ಬಾನೀಯ ಮಗನು,</para>
  <para style="li2" vid="1CH 6:46">ಅವನು ಶೆಮೆರನ ಮಗನು, <verse eid="1CH 6:46"/><verse number="47" style="v" sid="1CH 6:47"/>ಅವನು ಮಹ್ಲೀಯ ಮಗನು,</para>
  <para style="li2" vid="1CH 6:47">ಅವನು ಮೂಷೀಯ ಮಗನು, ಅವನು ಮೆರಾರೀಯ ಮಗನು,</para>
  <para style="li2" vid="1CH 6:47">ಅವನು ಲೇವಿಯ ಮಗನು.<verse eid="1CH 6:47"/></para>
  <para style="b"/>
  <para style="p">
    <verse number="48" style="v" sid="1CH 6:48"/>ಅವರ ಸಹೋದರರಾದ ಇತರ ಲೇವಿಯರು ದೇವರ ಮನೆಯ ಗುಡಾರದ ಸಮಸ್ತ ಸೇವೆಗೆ ನೇಮಕವಾಗಿದ್ದರು. <verse eid="1CH 6:48"/><verse number="49" style="v" sid="1CH 6:49"/>ಆದರೆ ಆರೋನನೂ, ಅವನ ಪುತ್ರರೂ ದಹನಬಲಿಯ ಪೀಠದ ಮೇಲೆಯೂ, ಧೂಪವನ್ನು ಪೀಠದ ಮೇಲೆಯೂ ಅರ್ಪಿಸುತ್ತಿದ್ದರು. ದೇವರ ಸೇವಕನಾದ ಮೋಶೆ ಆಜ್ಞಾಪಿಸಿದ ಎಲ್ಲಾದರ ಪ್ರಕಾರ ಅವರು ಮಹಾಪರಿಶುದ್ಧ ಸ್ಥಳದ ಸಮಸ್ತ ಕಾರ್ಯಕ್ಕೂ, ಇಸ್ರಾಯೇಲಿಗೋಸ್ಕರ ಪ್ರಾಯಶ್ಚಿತ್ತ ಮಾಡುವುದಕ್ಕೂ ನೇಮಕವಾಗಿದ್ದರು.<verse eid="1CH 6:49"/></para>
  <para style="b"/>
  <para style="li1">
    <verse number="50" style="v" sid="1CH 6:50"/>ಆರೋನನ ವಂಶಜರು:</para>
  <para style="li2" vid="1CH 6:50">ಅವನ ಮಗನು ಎಲಿಯಾಜರನು, ಅವನ ಮಗನು ಫೀನೆಹಾಸನು,</para>
  <para style="li2" vid="1CH 6:50">ಅವನ ಮಗನು ಅಬೀಷೂವನು, <verse eid="1CH 6:50"/><verse number="51" style="v" sid="1CH 6:51"/>ಅವನ ಮಗನು ಬುಕ್ಕೀಯು,</para>
  <para style="li2" vid="1CH 6:51">ಅವನ ಮಗನು ಉಜ್ಜೀ, ಅವನ ಮಗನು ಜೆರಹ್ಯಾಹನು,<verse eid="1CH 6:51"/></para>
  <para style="li2">
    <verse number="52" style="v" sid="1CH 6:52"/>ಅವನ ಮಗನು ಮೆರಾಯೋತನು, ಅವನ ಮಗನು ಅಮರ್ಯನು,</para>
  <para style="li2" vid="1CH 6:52">ಅವನ ಮಗನು ಅಹೀಟೂಬನು, <verse eid="1CH 6:52"/><verse number="53" style="v" sid="1CH 6:53"/>ಅವನ ಮಗನು ಚಾದೋಕನು,</para>
  <para style="li2" vid="1CH 6:53">ಅವನ ಮಗನು ಅಹೀಮಾಚನು.<verse eid="1CH 6:53"/></para>
  <para style="b"/>
  <para style="li4">
    <verse number="54" style="v" sid="1CH 6:54"/>ಕೊಹಾತನ ಗೋತ್ರದ ಆರೋನನ ವಂಶಜರಿಗೆ ನೇಮಕವಾದ ಪ್ರಾಂತ್ಯ ಇದು: ಅವರಿಗೆಂದು ಪ್ರತ್ಯೇಕಿಸಿದ ಪ್ರದೇಶದ ಪ್ರಥಮ ಚೀಟಿನ ಪಾಲನ್ನು ಅವರು ಪಡೆದುಕೊಂಡರು.<verse eid="1CH 6:54"/></para>
  <para style="li1">
    <verse number="55" style="v" sid="1CH 6:55"/>ಅವು ಯಾವುವೆಂದರೆ: ಕೊಹಾತ್ಯರ ಕುಟುಂಬಗಳಿಗೆ ಚೀಟು ಬಿದ್ದ ಪ್ರಕಾರ, ಯೆಹೂದ ದೇಶದಲ್ಲಿ ಹೆಬ್ರೋನ್ ಪಟ್ಟಣವೂ, ಅದರ ಸುತ್ತಲಿರುವ ಗೋಮಾಳಗಳೂ ಅವರಿಗೆ ದೊರೆತವು. <verse eid="1CH 6:55"/><verse number="56" style="v" sid="1CH 6:56"/>ಆದರೆ ಆ ಪಟ್ಟಣದ ಹೊಲಗಳನ್ನೂ, ಅದರ ಗ್ರಾಮಗಳನ್ನೂ, ಯೆಫುನ್ನೆಯ ಮಗ ಕಾಲೇಬನಿಗೆ ಕೊಟ್ಟರು. <verse eid="1CH 6:56"/><verse number="57" style="v" sid="1CH 6:57"/>ಯೆಹೂದದ ಕುಲಗಳಲ್ಲಿ ಆರೋನನ ಪುತ್ರರಿಗೆ ಕೊಟ್ಟ ಪಟ್ಟಣಗಳು ಯಾವುವೆಂದರೆ: ಆಶ್ರಯ ನಗರವಾದ ಹೆಬ್ರೋನ್, ಲಿಬ್ನವೂ, ಯತ್ತೀರೂ, ಎಷ್ಟೆಮೋವವೂ, ಅವುಗಳ ಉಪನಗರಗಳೂ; <verse eid="1CH 6:57"/><verse number="58" style="v" sid="1CH 6:58"/>ಹೀಲೇನ್, ದೆಬೀರ್, <verse eid="1CH 6:58"/><verse number="59" style="v" sid="1CH 6:59"/>ಆಷಾನ್, ಯುತಾಹ ಮತ್ತು ಬೇತ್ ಷೆಮೆಷ್ ಎಂಬ ಗೋಮಾಳ ಸಹಿತವಾದ ಪಟ್ಟಣಗಳು.<verse eid="1CH 6:59"/></para>
  <para style="li1">
    <verse number="60" style="v" sid="1CH 6:60"/>ಬೆನ್ಯಾಮೀನನ ಗೋತ್ರದಿಂದ ಕೊಟ್ಟವುಗಳು, ಗಿಬ್ಯೋನ್, ಗೆಬಾ, ಆಲೆಮೆತೂ, ಅನಾತೋತೂ, ಅದರ ಗೋಮಾಳುಗಳು.</para>
  <para style="li4" vid="1CH 6:60">ಇವರ ಕುಟುಂಬಗಳಿಗೆ ದೊರಕಿದ ಎಲ್ಲಾ ಪಟ್ಟಣಗಳು ಹದಿಮೂರು.<verse eid="1CH 6:60"/></para>
  <para style="b"/>
  <para style="li1">
    <verse number="61" style="v" sid="1CH 6:61"/>ಆ ಗೋತ್ರದ ಕುಟುಂಬಗಳಲ್ಲಿ ಉಳಿದ ಕೊಹಾತನ ಪುತ್ರರಿಗೂ ಚೀಟುಹಾಕಿ ಮನಸ್ಸೆಯ ಅರ್ಧ ಗೋತ್ರದಿಂದ ಹತ್ತು ಪಟ್ಟಣಗಳು ದೊರೆತವು.<verse eid="1CH 6:61"/></para>
  <para style="li1">
    <verse number="62" style="v" sid="1CH 6:62"/>ಗೇರ್ಷೋಮನ ಪುತ್ರರಿಗೆ ತಮ್ಮ ಕುಟುಂಬಗಳ ಪ್ರಕಾರವೇ ಇಸ್ಸಾಕಾರನ ಗೋತ್ರದಿಂದಲೂ, ಆಶೇರನ ಗೋತ್ರದಿಂದಲೂ, ನಫ್ತಾಲಿಯ ಗೋತ್ರದಿಂದಲೂ, ಬಾಷಾನಿನಲ್ಲಿರುವ ಮನಸ್ಸೆಯ ಗೋತ್ರದಿಂದಲೂ ಹದಿಮೂರು ಪಟ್ಟಣಗಳು ದೊರಕಿದ್ದವು.<verse eid="1CH 6:62"/></para>
  <para style="li1">
    <verse number="63" style="v" sid="1CH 6:63"/>ಮೆರಾರೀಯ ಪುತ್ರರಿಗೂ ಅವರ ಕುಟುಂಬಗಳ ಪ್ರಕಾರ ಚೀಟುಹಾಕಿ, ರೂಬೇನನ ಗೋತ್ರದಿಂದಲೂ, ಗಾದನ ಗೋತ್ರದಿಂದಲೂ, ಜೆಬುಲೂನನ ಗೋತ್ರದಿಂದಲೂ ಹನ್ನೆರಡು ಪಟ್ಟಣಗಳು ದೊರಕಿದ್ದವು.<verse eid="1CH 6:63"/></para>
  <para style="b"/>
  <para style="li4">
    <verse number="64" style="v" sid="1CH 6:64"/>ಇಸ್ರಾಯೇಲರು ಲೇವಿಯರಿಗೆ ಈ ಪಟ್ಟಣಗಳನ್ನೂ, ಅವುಗಳ ಉಪನಗರಗಳನ್ನೂ ಕೂಡಾ ಕೊಟ್ಟರು.<verse eid="1CH 6:64"/></para>
  <para style="b"/>
  <para style="li1">
    <verse number="65" style="v" sid="1CH 6:65"/>ಅವರು ಚೀಟುಹಾಕಿ ಯೆಹೂದ ಸಿಮೆಯೋನ್ ಬೆನ್ಯಾಮೀನ್ ಕುಲಗಳಿಂದ ಮೇಲೆ ಹೆಸರು ಹೇಳಿದ ಪಟ್ಟಣಗಳನ್ನು ಕೊಟ್ಟರು.<verse eid="1CH 6:65"/></para>
  <para style="b"/>
  <para style="li4">
    <verse number="66" style="v" sid="1CH 6:66"/>ಕೊಹಾತನ ಪುತ್ರರ ಮಿಕ್ಕಾದ ಕುಟುಂಬಗಳಿಗೂ, ಅವರ ಮೇರೆಗಳಲ್ಲಿ ಎಫ್ರಾಯೀಮನ ಗೋತ್ರದೊಳಗೆ ಪಟ್ಟಣಗಳು ದೊರೆತಿದ್ದವು.<verse eid="1CH 6:66"/></para>
  <para style="li1">
    <verse number="67" style="v" sid="1CH 6:67"/>ಇದಲ್ಲದೆ ಎಫ್ರಾಯೀಮ್ ಬೆಟ್ಟದಲ್ಲಿರುವ ಶೆಕೆಮ್ ಎಂಬ ಆಶ್ರಯ ನಗರ, ಗೆಜೆರ್ ಮತ್ತು ಅದರ ಉಪನಗರಗಳನ್ನೂ, <verse eid="1CH 6:67"/><verse number="68" style="v" sid="1CH 6:68"/>ಯೊಕ್ಮೆಯಾಮನ್ನೂ, ಬೇತ್ ಹೋರೋನ್, <verse eid="1CH 6:68"/><verse number="69" style="v" sid="1CH 6:69"/>ಅಯ್ಯಾಲೋನ್, ಗತ್ ರಿಮ್ಮೋನನ್ನೂ, ಅದರ ಉಪನಗರಗಳನ್ನೂ ಕೊಟ್ಟರು.<verse eid="1CH 6:69"/></para>
  <para style="li1">
    <verse number="70" style="v" sid="1CH 6:70"/>ಇದಲ್ಲದೆ ಕೊಹಾತನ ಪುತ್ರರ ಮಿಕ್ಕಾದ ಕುಟುಂಬಕ್ಕೋಸ್ಕರ ಮನಸ್ಸೆಯ ಅರ್ಧ ಗೋತ್ರದಿಂದ ಆನೇರನ್ನೂ, ಅದರ ಉಪನಗರಗಳನ್ನೂ; ಬಿಳ್ಳಾಮ್ ಉಪನಗರಗಳನ್ನೂ ಕೊಟ್ಟರು.<verse eid="1CH 6:70"/></para>
  <para style="b"/>
  <para style="li4">
    <verse number="71" style="v" sid="1CH 6:71"/>ಮನಸ್ಸೆಯ ಅರ್ಧ ಗೋತ್ರದಿಂದ ಗೇರ್ಷೋಮನ</para>
  <para style="li1" vid="1CH 6:71">ಪುತ್ರರಿಗೆ ಬಾಷಾನಿನಲ್ಲಿರುವ ಗೋಲಾನೂ, ಅದರ ಉಪನಗರಗಳನ್ನೂ; ಅಷ್ಟಾರೋತ್ ಅದರ ಉಪನಗರಗಳನ್ನೂ;<verse eid="1CH 6:71"/></para>
  <para style="li1">
    <verse number="72" style="v" sid="1CH 6:72"/>ಇಸ್ಸಾಕಾರನ ಗೋತ್ರದಿಂದ ಕೆದೆಷ್, ಅದರ ಉಪನಗರಗಳನ್ನೂ; ದಾಬೆರತ್ ಅದರ ಉಪನಗರಗಳನ್ನೂ; <verse eid="1CH 6:72"/><verse number="73" style="v" sid="1CH 6:73"/>ರಾಮೋತ್ ಅದರ ಉಪನಗರಗಳನ್ನೂ; ಅನೇಮ್, ಅದರ ಉಪನಗರಗಳನ್ನೂ;<verse eid="1CH 6:73"/></para>
  <para style="li1">
    <verse number="74" style="v" sid="1CH 6:74"/>ಆಶೇರನ ಗೋತ್ರದಿಂದ ಮಷಾಲ್, ಅಬ್ದೋನ್ <verse eid="1CH 6:74"/><verse number="75" style="v" sid="1CH 6:75"/>ಹೂಕೋಕ್, ಅದರ ಉಪನಗರಗಳನ್ನೂ; ರೆಹೋಬ್, ಅದರ ಉಪನಗರಗಳನ್ನೂ;<verse eid="1CH 6:75"/></para>
  <para style="li1">
    <verse number="76" style="v" sid="1CH 6:76"/>ನಫ್ತಾಲಿ ಗೋತ್ರದಿಂದ ಗಲಿಲಾಯದಲ್ಲಿರುವ ಕೆದೆಷ್, ಅದರ ಉಪನಗರಗಳನ್ನೂ; ಹಮ್ಮೋನ್, ಅದರ ಉಪನಗರಗಳನ್ನೂ; ಕಿರ್ಯಾತಯಿಮ್, ಅದರ ಉಪನಗರಗಳೂ ದೊರಕಿದ್ದವು.<verse eid="1CH 6:76"/></para>
  <para style="b"/>
  <para style="li4">
    <verse number="77" style="v" sid="1CH 6:77"/>ಮೆರಾರೀಯ ಉಳಿದ ಮಕ್ಕಳಿಗೂ,</para>
  <para style="li1" vid="1CH 6:77">ಜೆಬುಲೂನನ ಗೋತ್ರದಿಂದ ರಿಮ್ಮೋನೋ, ಅದರ ಉಪನಗರಗಳೂ, ತಾಬೋರ್, ಅದರ ಉಪನಗರಗಳೂ;<verse eid="1CH 6:77"/></para>
  <para style="li1">
    <verse number="78" style="v" sid="1CH 6:78"/>ರೂಬೇನನ ಗೋತ್ರದಿಂದ ಯೆರಿಕೋವಿನ ಬಳಿಯಲ್ಲಿ ಯೊರ್ದನ್ ನದಿಯ ಪೂರ್ವದಿಕ್ಕಿನ ಮರುಭೂಮಿಯಲ್ಲಿರುವ ಬೆಚೆರ್, ಅದರ ಉಪನಗರಗಳೂ; ಯಹಚ, ಅದರ ಉಪನಗರಗಳೂ; <verse eid="1CH 6:78"/><verse number="79" style="v" sid="1CH 6:79"/>ಕೆದೇಮೋತ್, ಮೇಫಾತ್ ಅದರ ಉಪನಗರಗಳೂ;<verse eid="1CH 6:79"/></para>
  <para style="li1">
    <verse number="80" style="v" sid="1CH 6:80"/>ಗಾದನ ಗೋತ್ರದಿಂದ ಗಿಲ್ಯಾದಿನ ರಾಮೋತ್, ಅದರ ಉಪನಗರಗಳೂ; ಮಹನಯಿಮ್ ಅದರ ಉಪನಗರಗಳೂ; <verse eid="1CH 6:80"/><verse number="81" style="v" sid="1CH 6:81"/>ಹೆಷ್ಬೋನ್, ಯಜ್ಜೇರ್ ಮತ್ತು ಅದರ ಉಪನಗರಗಳೂ ದೊರೆತವು.<verse eid="1CH 6:81"/></para>
  <chapter eid="1CH 6"/>
  <chapter number="7" style="c" sid="1CH 7"/>
  <para style="s1">ಇಸ್ಸಾಕಾರನು</para>
  <para style="li1">
    <verse number="1" style="v" sid="1CH 7:1"/>ಇಸ್ಸಾಕಾರನ ಪುತ್ರರು:</para>
  <para style="li2" vid="1CH 7:1">ತೋಲ, ಪೂವ, ಯಾಶೂಬ್, ಶಿಮ್ರೋನ್ ಎಂಬ ನಾಲ್ಕು ಮಂದಿ.<verse eid="1CH 7:1"/></para>
  <para style="li1">
    <verse number="2" style="v" sid="1CH 7:2"/>ತೋಲನ ಪುತ್ರರು:</para>
  <para style="li2" vid="1CH 7:2">ಉಜ್ಜೀ, ರೆಫಾಯ, ಯೆರೀಯೇಲ್, ಯಹ್ಮೈ, ಇಬ್ಸಾಮ್ ಮತ್ತು ಸಮುಯೇಲ್. ಇವರು ತಮ್ಮ ಕುಟುಂಬಗಳಿಗೆ ಯಜಮಾನರಾಗಿದ್ದರು. ಇವರು ತಮ್ಮ ವಂಶಗಳಲ್ಲಿ ಯುದ್ಧದಲ್ಲಿ ಪರಾಕ್ರಮಶಾಲಿಗಳಾಗಿದ್ದರು. ದಾವೀದನ ದಿವಸಗಳಲ್ಲಿ ಅವರ ಲೆಕ್ಕ 22,600 ಮಂದಿ ಆಗಿತ್ತು.<verse eid="1CH 7:2"/></para>
  <para style="li1">
    <verse number="3" style="v" sid="1CH 7:3"/>ಉಜ್ಜೀಯನ ಪುತ್ರನು</para>
  <para style="li2" vid="1CH 7:3">ಇಜರಾಹಿಯಾ.</para>
  <para style="li1" vid="1CH 7:3">ಇಜರಾಹಿಯಾನ ಪುತ್ರರು:</para>
  <para style="li2" vid="1CH 7:3">ಮೀಕಾಯೇಲ್, ಓಬದ್ಯ, ಯೋಯೇಲ್ ಮತ್ತು ಇಷೀಯ ಈ ಐದು ಮಂದಿಯೂ ಮುಖ್ಯಸ್ಥರಾಗಿದ್ದರು. <verse eid="1CH 7:3"/><verse number="4" style="v" sid="1CH 7:4"/>ಇವರ ಸಂಗಡ ಅವರ ವಂಶಗಳ ಪ್ರಕಾರವೂ, ಅವರ ಪಿತೃಗಳ ಮನೆಯ ಪ್ರಕಾರವೂ ಯುದ್ಧಕ್ಕೋಸ್ಕರ 36,000 ಮಂದಿ ಯುದ್ಧವೀರರ ಗುಂಪುಗಳಿದ್ದವು. ಏಕೆಂದರೆ ಅವರ ಹೆಂಡತಿಯರು, ಮಕ್ಕಳು ಬಹಳ ಮಂದಿ ಇದ್ದರು.<verse eid="1CH 7:4"/></para>
  <para style="li4">
    <verse number="5" style="v" sid="1CH 7:5"/>ಇಸ್ಸಾಕಾರನ ಕುಟುಂಬಗಳಾಗಿರುವ ಸಹೋದರರೊಳಗೆ ಅವರ ವಂಶಾವಳಿಗಳಲ್ಲಿ ಲೆಕ್ಕಿಸಿದಾಗ ಯುದ್ಧವೀರರೆಲ್ಲರೂ 87,000 ಮಂದಿಯಾಗಿದ್ದರು.<verse eid="1CH 7:5"/></para>
  <para style="s1">ಬೆನ್ಯಾಮೀನನು</para>
  <para style="li1">
    <verse number="6" style="v" sid="1CH 7:6"/>ಬೆನ್ಯಾಮೀನನ ಪುತ್ರರು:</para>
  <para style="li2" vid="1CH 7:6">ಬೆಳ, ಬೆಕೆರ್, ಯೆದೀಯಯೇಲ್ ಈ ಮೂರು ಮಂದಿ.<verse eid="1CH 7:6"/></para>
  <para style="li1">
    <verse number="7" style="v" sid="1CH 7:7"/>ಬೆಳನ ಪುತ್ರರು:</para>
  <para style="li2" vid="1CH 7:7">ಎಚ್ಬೋನ್, ಉಜ್ಜೀ, ಉಜ್ಜೀಯೇಲ್, ಯೆರೀಮೋತ್ ಮತ್ತು ಈರೀ; ಈ ಐದು ಮಂದಿ ತಮ್ಮ ಪಿತೃಗಳ ಕುಟುಂಬಗಳಲ್ಲಿ ಯಜಮಾನರಾಗಿಯೂ, ಯುದ್ಧದಲ್ಲಿ ಪರಾಕ್ರಮಶಾಲಿಗಳಾಗಿಯೂ ಇದ್ದು, ತಮ್ಮ ವಂಶಾವಳಿಗಳ ಪ್ರಕಾರ 22,034 ಮಂದಿ ದಾಖಲಿಸಿದ್ದರು.<verse eid="1CH 7:7"/></para>
  <para style="li1">
    <verse number="8" style="v" sid="1CH 7:8"/>ಬೆಕೆರನ ಪುತ್ರರು:</para>
  <para style="li2" vid="1CH 7:8">ಜೆಮೀರ, ಯೋವಾಷ್, ಎಲೀಯೆಜೆರ್, ಎಲ್ಯೋವೇನೈ, ಒಮ್ರಿ, ಯೆರೀಮೋತ್, ಅಬೀಯ, ಅನಾತೋತ್, ಆಲೆಮೆತ್ ಇವರೆಲ್ಲರು ಬೆಕೆರನ ಪುತ್ರರು. <verse eid="1CH 7:8"/><verse number="9" style="v" sid="1CH 7:9"/>ಪ್ರತಿಯೊಬ್ಬರೂ ಪೂರ್ವಜರ ಕುಲದ ನಾಯಕರಾಗಿದ್ದರು. ಅವರ ವಂಶಾವಳಿಯ ದಾಖಲೆಗಳಲ್ಲಿ ಪಟ್ಟಿ ಮಾಡಲಾಗಿರುವಂತೆ ಈ ಕುಲಗಳ ಪ್ರಬಲ ಯೋಧರು ಮತ್ತು ನಾಯಕರ ಒಟ್ಟು ಸಂಖ್ಯೆ 20,200 ಆಗಿತ್ತು.<verse eid="1CH 7:9"/></para>
  <para style="li1">
    <verse number="10" style="v" sid="1CH 7:10"/>ಯೆದೀಯಯೇಲನ ಪುತ್ರನು</para>
  <para style="li2" vid="1CH 7:10">ಬಿಲ್ಹಾನ್.</para>
  <para style="li1" vid="1CH 7:10">ಬಿಲ್ಹಾನನ ಪುತ್ರರು:</para>
  <para style="li2" vid="1CH 7:10">ಯೆಯೂಷ್, ಬೆನ್ಯಾಮೀನ್, ಏಹೂದ್, ಕೆನಾನ, ಜೇತಾನ್, ತಾರ್ಷೀಷ್ ಮತ್ತು ಅಹೀಷೆಹರ; <verse eid="1CH 7:10"/><verse number="11" style="v" sid="1CH 7:11"/>ಇವರೆಲ್ಲರು ಯೆದೀಯಯೇಲನ ಪುತ್ರರು. ಪ್ರತಿಯೊಬ್ಬರೂ ಪೂರ್ವಜರ ಕುಲದ ನಾಯಕರಾಗಿದ್ದರು. ಯುದ್ಧದ ಪರಾಕ್ರಮಶಾಲಿಗಳಾಗಿಯೂ ಯುದ್ಧಕ್ಕೆ ಹೊರಡತಕ್ಕವರು 17,200 ಮಂದಿಯಾಗಿದ್ದರು.<verse eid="1CH 7:11"/></para>
  <para style="li1">
    <verse number="12" style="v" sid="1CH 7:12"/>ಅಹೇರನ ಪುತ್ರರಾದ ಈರನೂ, ಹುಶೀಮನೂ ಎಂಬವರ ಮಕ್ಕಳು ಶುಪ್ಪೀಮನೂ, ಹುಪ್ಪೀಮನೂ ಇದ್ದರು.<verse eid="1CH 7:12"/></para>
  <para style="s1">ನಫ್ತಾಲಿಯನು</para>
  <para style="li1">
    <verse number="13" style="v" sid="1CH 7:13"/>ನಫ್ತಾಲಿಯ ಪುತ್ರರು:</para>
  <para style="li2" vid="1CH 7:13">ಯಹಚಿಯೇಲ್, ಗೂನೀ, ಯೇಚೆರ್, ಶಲ್ಲೂಮ್ ಇವರು ಬಿಲ್ಹಳ ಪುತ್ರರು.<verse eid="1CH 7:13"/></para>
  <para style="s1">ಮನಸ್ಸೆಯನು</para>
  <para style="li1">
    <verse number="14" style="v" sid="1CH 7:14"/>ಮನಸ್ಸೆಯ ವಂಶಜರು:</para>
  <para style="li2" vid="1CH 7:14">ಅರಾಮ್ಯಳಾದ ಮನಸ್ಸೆಯ ಉಪಪತ್ನಿಯಿಂದ ಅಸ್ರೀಯೇಲ್ ಮತ್ತು ಮಾಕೀರನನ್ನು ಮನಸ್ಸೆ ಪಡೆದನು. ಮಾಕೀರನು ಗಿಲ್ಯಾದನ ತಂದೆ. <verse eid="1CH 7:14"/><verse number="15" style="v" sid="1CH 7:15"/>ಆದರೆ ಈ ಮಾಕೀರನು ಹುಪ್ಪೀಮ್ ಮತ್ತು ಶುಪ್ಪೀಮರ ಸಹೋದರಿಯಾದ ಮಾಕಳನ್ನು ಹೆಂಡತಿಯಾಗಿ ತೆಗೆದುಕೊಂಡನು. ಅವನ ಮೊಮ್ಮಗನ ಹೆಸರು ಚೆಲೊಫಾದನು; ಈ ಚೆಲೋಫಾದನಿಗೆ ಪುತ್ರಿಯರು ಮಾತ್ರ ಇದ್ದರು. <verse eid="1CH 7:15"/><verse number="16" style="v" sid="1CH 7:16"/>ಮಾಕೀರನ ಹೆಂಡತಿಯಾದ ಮಾಕಳು ಮಗನನ್ನು ಹೆತ್ತು, ಪೆರೆಷ್ ಎಂದು ಹೆಸರಿಟ್ಟಳು. ಅವನ ಸಹೋದರನ ಹೆಸರು ಶೆರೆಷ್. ಇವನಿಗೆ ಊಲಾಮ್, ರೆಕೆಮ್ ಎಂಬ ಇಬ್ಬರು ಪುತ್ರರಿದ್ದರು.<verse eid="1CH 7:16"/></para>
  <para style="li1">
    <verse number="17" style="v" sid="1CH 7:17"/>ಊಲಾಮ್ ಮಗನು</para>
  <para style="li2" vid="1CH 7:17">ಬೆದಾನ್.</para>
  <para style="li1" vid="1CH 7:17">ಇವರೇ ಮನಸ್ಸೆಯ ಮಗನಾಗಿರುವ ಮಾಕೀರನ ಮಗ ಗಿಲ್ಯಾದನ ಪುತ್ರರು.<verse eid="1CH 7:17"/></para>
  <para style="li1">
    <verse number="18" style="v" sid="1CH 7:18"/>ಅವನ ಸಹೋದರಿ ಹಮ್ಮೋಲೆಕೆತಳು ಈಷ್ಹೋದನನ್ನೂ, ಅಬೀಯೆಜೆರನನ್ನೂ, ಮಹ್ಲನನ್ನೂ ಹೆತ್ತಳು.<verse eid="1CH 7:18"/></para>
  <para style="li1">
    <verse number="19" style="v" sid="1CH 7:19"/>ಶೆಮೀದನನ ಪುತ್ರರು:</para>
  <para style="li2" vid="1CH 7:19">ಅಹ್ಯಾನ್, ಶೆಕೆಮ್, ಲಿಕ್ಹೀ, ಅನೀಯಾಮ್.<verse eid="1CH 7:19"/></para>
  <para style="s1">ಎಫ್ರಾಯೀಮನು</para>
  <para style="li1">
    <verse number="20" style="v" sid="1CH 7:20"/>ಎಫ್ರಾಯೀಮನ ವಂಶಜರು:</para>
  <para style="li2" vid="1CH 7:20">ಶೂತೆಲಹ, ಅವನ ಮಗನು ಬೆರೆದ್;</para>
  <para style="li2" vid="1CH 7:20">ಅವನ ಮಗನು ತಹಾತ್; ಅವನ ಮಗನು ಎಲ್ಲಾದ,</para>
  <para style="li2" vid="1CH 7:20">ಅವನ ಮಗನು ತಹತ್; <verse eid="1CH 7:20"/><verse number="21" style="v" sid="1CH 7:21"/>ಅವನ ಮಗನು ಜಾಬಾದ್;</para>
  <para style="li2" vid="1CH 7:21">ಅವನ ಮಗನು ಶೂತೆಲಹ, ಏಜೆರ್, ಎಲಿಯಾದ್.</para>
  <para style="li2" vid="1CH 7:21">ಆ ದೇಶದಲ್ಲಿ ಹುಟ್ಟಿದ ಗತ್‌ನವರು ಇವರ ಪಶುಗಳನ್ನು ಹಿಡಿದುಕೊಳ್ಳಲು ಇಳಿದು ಬಂದಾಗ, ಇವರನ್ನು ಕೊಂದುಹಾಕಿದರು. <verse eid="1CH 7:21"/><verse number="22" style="v" sid="1CH 7:22"/>ಅವರ ತಂದೆಯಾದ ಎಫ್ರಾಯೀಮನು ಅನೇಕ ದಿವಸಗಳು ದುಃಖಪಟ್ಟದ್ದರಿಂದ, ಅವನ ಸಹೋದರರು ಅವನನ್ನು ಆದರಿಸಲು ಬಂದರು. <verse eid="1CH 7:22"/><verse number="23" style="v" sid="1CH 7:23"/>ಅವನು ತನ್ನ ಹೆಂಡತಿಯ ಬಳಿಗೆ ಸೇರಿದಾಗ, ಅವಳು ಗರ್ಭಧರಿಸಿ ಮಗನನ್ನು ಹೆತ್ತಳು. ಆಗ ತನ್ನ ಮನೆಯಲ್ಲಿ ಕೇಡು ಉಂಟಾದದ್ದರಿಂದ ಅವನಿಗೆ ಬೆರೀಯ ಎಂದು ಹೆಸರಿಟ್ಟನು. <verse eid="1CH 7:23"/><verse number="24" style="v" sid="1CH 7:24"/>ಇವನ ಪುತ್ರಿಯ ಹೆಸರು ಶೇರಳು. ಇವಳು ಕೆಳಗಿನ ಬೇತ್ ಹೋರೋನ್, ಮೇಲಿನ ಬೇತ್ ಹೋರೋನ್ ಮತ್ತು ಉಜ್ಜೇನ್ ಶೇರವನ್ನೂ ಕಟ್ಟಿಸಿದಳು.<verse eid="1CH 7:24"/></para>
  <para style="li2">
    <verse number="25" style="v" sid="1CH 7:25"/>ಇವರ ಪುತ್ರರು: ರೆಫಹನ ಮಗನು ರೆಷೆಫನು, ರೆಷೆಫನ ಮಗನು</para>
  <para style="li2" vid="1CH 7:25">ತೆಲಹನು, ಅವನ ಮಗನು ತಹನನು,<verse eid="1CH 7:25"/></para>
  <para style="li2">
    <verse number="26" style="v" sid="1CH 7:26"/>ಅವನ ಮಗನು ಲದ್ದಾನ್, ಅವನ ಮಗನು ಅಮ್ಮೀಹೂದ,</para>
  <para style="li2" vid="1CH 7:26">ಅವನ ಮಗನು ಎಲೀಷಾಮಾ, <verse eid="1CH 7:26"/><verse number="27" style="v" sid="1CH 7:27"/>ಅವನ ಮಗನು ನೂನನು,</para>
  <para style="li2" vid="1CH 7:27">ಅವನ ಮಗನು ಯೆಹೋಶುವ.<verse eid="1CH 7:27"/></para>
  <para style="li4">
    <verse number="28" style="v" sid="1CH 7:28"/>ಅವರ ವಶಪಡಿಸಿಕೊಂಡು ನಿವಾಸಮಾಡಿದ ಬೇತೇಲೂ, ಅದರ ಗ್ರಾಮಗಳೂ ಪೂರ್ವದಿಕ್ಕಿನಲ್ಲಿ ನಾರಾನನೂ, ಪಶ್ಚಿಮ ದಿಕ್ಕಿನಲ್ಲಿ ಗೆಜೆರ್, ಅದರ ಗ್ರಾಮಗಳೂ ಒಳಗೊಂಡಿತ್ತು; ಶೆಕೆಮ್, ಅಯ್ಯಾ ಪಟ್ಟಣಗಳೂ ಅದರ ಗ್ರಾಮಗಳೂ ಇವೇ. <verse eid="1CH 7:28"/><verse number="29" style="v" sid="1CH 7:29"/>ಗಾಜವೂ, ಮನಸ್ಸೆಯ ಸಂತಾನದವರ ಮೇರೆಯಲ್ಲಿರುವ ಬೇತ್ ಷೆಯಾನೂ, ತಾನಕವೂ, ಮೆಗಿದ್ದೋ, ದೋರ್ ಮತ್ತು ಇವುಗಳ ಗ್ರಾಮಗಳು ಇವುಗಳಲ್ಲಿ ಇಸ್ರಾಯೇಲನ ಮಗನಾದ ಯೋಸೇಫನ ಸಂತಾನದವರು ವಾಸವಾಗಿದ್ದರು.<verse eid="1CH 7:29"/></para>
  <para style="s1">ಆಶೇರನು</para>
  <para style="li1">
    <verse number="30" style="v" sid="1CH 7:30"/>ಆಶೇರನ ಪುತ್ರರು:</para>
  <para style="li2" vid="1CH 7:30">ಇಮ್ನ, ಇಷ್ವ, ಇಷ್ವೀ, ಬೆರೀಯ, ಅವರ ಸಹೋದರಿಯಾದ ಸೆರಹಳು.<verse eid="1CH 7:30"/></para>
  <para style="li1">
    <verse number="31" style="v" sid="1CH 7:31"/>ಬೆರೀಯನ ಪುತ್ರರು:</para>
  <para style="li2" vid="1CH 7:31">ಹೆಬೆರನು, ಮಲ್ಕೀಯೇಲ್ ಇವನು ಬಿರ್ಜಾಯಿತನ ತಂದೆಯು.<verse eid="1CH 7:31"/></para>
  <para style="li1">
    <verse number="32" style="v" sid="1CH 7:32"/>ಹೆಬೆರನು ಯಫ್ಲೇಟನನ್ನೂ, ಶೋಮೇರನನ್ನೂ, ಹೋತಾಮನನ್ನೂ, ಅವರ ಸಹೋದರಿಯಾದ ಶೂವಳನ್ನೂ ಪಡೆದನು.<verse eid="1CH 7:32"/></para>
  <para style="li1">
    <verse number="33" style="v" sid="1CH 7:33"/>ಯಫ್ಲೇಟನ ಪುತ್ರರು:</para>
  <para style="li2" vid="1CH 7:33">ಪಾಸಕನು, ಬಿಮ್ಹಾಲನು, ಅಶ್ವಾತನು</para>
  <para style="li4" vid="1CH 7:33">ಇವರೇ ಯಫ್ಲೇಟನ ಮಕ್ಕಳು.<verse eid="1CH 7:33"/></para>
  <para style="li1">
    <verse number="34" style="v" sid="1CH 7:34"/>ಶೆಮೆರನ ಪುತ್ರರು:</para>
  <para style="li2" vid="1CH 7:34">ಅಹೀಯು, ರೊಹ್ಗನು, ಹುಬ್ಬನು, ಅರಾಮ್.<verse eid="1CH 7:34"/></para>
  <para style="li1">
    <verse number="35" style="v" sid="1CH 7:35"/>ಅವನ ಸಹೋದರನಾದ ಹೆಲೆಮನ ಪುತ್ರರು:</para>
  <para style="li2" vid="1CH 7:35">ಚೋಫಹನು, ಇಮ್ನನು, ಶೇಲೆಷ್‌ನು, ಆಮಾಲನು.<verse eid="1CH 7:35"/></para>
  <para style="li1">
    <verse number="36" style="v" sid="1CH 7:36"/>ಚೋಫಹನ ಪುತ್ರರು:</para>
  <para style="li2" vid="1CH 7:36">ಸೂಹ, ಹರ್ನೆಫೆರ್, ಶೂಗಾಲ್, ಬೇರೀ, ಇಮ್ರ, <verse eid="1CH 7:36"/><verse number="37" style="v" sid="1CH 7:37"/>ಬೆಚೆರ್, ಹೋದ್, ಶಮ್ಮ, ಶಿಲ್ಷ, ಇತ್ರಾನ್, ಬೇರನು.<verse eid="1CH 7:37"/></para>
  <para style="li1">
    <verse number="38" style="v" sid="1CH 7:38"/>ಯೆತೆರನ ಪುತ್ರರು:</para>
  <para style="li2" vid="1CH 7:38">ಯೆಫುನ್ನೆ, ಪಿಸ್ಪ, ಅರಾ.<verse eid="1CH 7:38"/></para>
  <para style="li1">
    <verse number="39" style="v" sid="1CH 7:39"/>ಉಲ್ಲನ ಪುತ್ರರು:</para>
  <para style="li2" vid="1CH 7:39">ಆರಹ, ಹನ್ನೀಯೇಲ್, ರಿಚ್ಯ.<verse eid="1CH 7:39"/></para>
  <para style="li4">
    <verse number="40" style="v" sid="1CH 7:40"/>ಇವರೆಲ್ಲರು ಆಶೇರನ ಮಕ್ಕಳಾಗಿದ್ದು, ತಮ್ಮ ತಂದೆಯ ಕುಟುಂಬದಲ್ಲಿ ಯಜಮಾನರಾಗಿಯೂ, ಯುದ್ಧ ಪರಾಕ್ರಮಶಾಲಿಗಳಲ್ಲಿ ಮುಖ್ಯಸ್ಥರಾಗಿಯೂ, ಪ್ರಭುಗಳಲ್ಲಿ ಶ್ರೇಷ್ಠರಾಗಿಯೂ ಇದ್ದರು. ಅವರ ವಂಶಾವಳಿಯಲ್ಲಿ ದಾಖಲಿಸಿದ ಲೆಕ್ಕದ ಪ್ರಕಾರ ಯುದ್ಧಕ್ಕೆ ಸಿದ್ಧವಿರುವ 26,000 ಮಂದಿ ಇದ್ದರು.<verse eid="1CH 7:40"/></para>
  <chapter eid="1CH 7"/>
  <chapter number="8" style="c" sid="1CH 8"/>
  <para style="s1">ಬೆನ್ಯಾಮೀನ್ಯನಾದ ಸೌಲನ ವಂಶಾವಳಿ</para>
  <para style="li1">
    <verse number="1" style="v" sid="1CH 8:1"/>ಬೆನ್ಯಾಮೀನನ ಮಕ್ಕಳು:</para>
  <para style="li2" vid="1CH 8:1">ಚೊಚ್ಚಲಮಗನಾದ ಬೆಳನನ್ನೂ,</para>
  <para style="li2" vid="1CH 8:1">ಎರಡನೆಯವನಾದ ಅಷ್ಬೇಲನನ್ನೂ, ಮೂರನೆಯವನಾದ ಅಹ್ರಹನನ್ನೂ,<verse eid="1CH 8:1"/></para>
  <para style="li2">
    <verse number="2" style="v" sid="1CH 8:2"/>ನಾಲ್ಕನೆಯವನಾದ ನೋಹನನ್ನೂ, ಐದನೆಯವನಾದ ರಾಫನನ್ನೂ ಪಡೆದನು.<verse eid="1CH 8:2"/></para>
  <para style="li1">
    <verse number="3" style="v" sid="1CH 8:3"/>ಬೆಳನ ಪುತ್ರರು:</para>
  <para style="li2" vid="1CH 8:3">ಅದ್ದಾರ್, ಗೇರ, ಅಬೀಹೂದ್, <verse eid="1CH 8:3"/><verse number="4" style="v" sid="1CH 8:4"/>ಅಬೀಷೂವನು, ನಾಮಾನನು, ಅಹೋಹನು, <verse eid="1CH 8:4"/><verse number="5" style="v" sid="1CH 8:5"/>ಗೇರನು, ಶೆಫುಫಾನನು, ಹೂರಾಮನು.<verse eid="1CH 8:5"/></para>
  <para style="li1">
    <verse number="6" style="v" sid="1CH 8:6"/>ಏಹೂದನ ಪುತ್ರರು: ನಾಮಾನನು, ಅಹೀಯನು, ಗೇರನು. ಇವರೇ ಗಿಬೆಯ ನಿವಾಸಿಗಳ ಕುಟುಂಬಗಳಲ್ಲಿ ಯಜಮಾನರಾಗಿದ್ದರು. ಆದರೆ ಅವರನ್ನು ಮಾನಹತಿಗೆ ತೆಗೆದುಕೊಂಡು ಹೋದರು.<verse eid="1CH 8:6"/></para>
  <para style="li2">
    <verse number="7" style="v" sid="1CH 8:7"/>ನಾಮಾನ್, ಅಹೀಯ, ಗೇರನನ್ನು ತೆಗೆದುಕೊಂಡು ಹೋದ ತರುವಾಯ, ಉಜ್ಜನನ್ನೂ, ಅಹೀಹೂದನನ್ನೂ ಪಡೆದನು.<verse eid="1CH 8:7"/></para>
  <para style="li1">
    <verse number="8" style="v" sid="1CH 8:8"/>ಇದಲ್ಲದೆ ಅವನು ಅವರನ್ನು ಕಳುಹಿಸಿದ ತರುವಾಯ, ಶಹರಯಿಮನು ಮೋವಾಬಿನ ದೇಶದಲ್ಲಿ ಮಕ್ಕಳನ್ನು ಪಡೆದನು. ಹುಷೀಮಳೂ, ಬಾರಳೂ ಅವನಿಗೆ ಪತ್ನಿಯರಾಗಿದ್ದರು. <verse eid="1CH 8:8"/><verse number="9" style="v" sid="1CH 8:9"/>ಇದಲ್ಲದೆ ಅವನು ತನ್ನ ಹೆಂಡತಿಯಾದ ಹೋದೆಷಳಿಂದ ಯೋವಾಬನನ್ನೂ, ಚಿಬ್ಯನನ್ನೂ, ಮೇಷನನ್ನೂ, ಮಲ್ಕಾಮನನ್ನೂ, <verse eid="1CH 8:9"/><verse number="10" style="v" sid="1CH 8:10"/>ಯೆಯೂಚನನ್ನೂ, ಸಾಕ್ಯನನ್ನೂ, ಮಿರ್ಮನನ್ನೂ ಪಡೆದನು. ಅವನ ಮಕ್ಕಳಾದ ಇವರು ಕುಟುಂಬಗಳಲ್ಲಿ ಯಜಮಾನರಾಗಿದ್ದರು. <verse eid="1CH 8:10"/><verse number="11" style="v" sid="1CH 8:11"/>ಹುಷೀಮಳಿಂದ ಅವನು ಅಬಿಟೂಬನನ್ನೂ, ಎಲ್ಪಾಲನನ್ನೂ ಪಡೆದನು.<verse eid="1CH 8:11"/></para>
  <para style="li1">
    <verse number="12" style="v" sid="1CH 8:12"/>ಎಲ್ಪಾಲನ ಪುತ್ರರು:</para>
  <para style="li2" vid="1CH 8:12">ಏಬೆರ್, ಮಿಷಾಮ್, ಶೆಮೆದ್. ಶೆಮೆದನು ಓನೋ, ಲೋದ್ ಎಂಬ ಪಟ್ಟಣಗಳನ್ನೂ, ಅವುಗಳಿಗೆ ಸೇರಿದ ಗ್ರಾಮಗಳನ್ನೂ ಕಟ್ಟಿಸಿದರು. <verse eid="1CH 8:12"/><verse number="13" style="v" sid="1CH 8:13"/>ಇದಲ್ಲದೆ ಅವನು ಗತ್‌ನವರನ್ನು ಓಡಿಸಿಬಿಟ್ಟ ಅಯ್ಯಾಲೋನಿನ ನಿವಾಸಿಗಳ ಕುಟುಂಬಗಳಲ್ಲಿ ಬೆರೀಯ, ಶಮ ಯಜಮಾನರಾಗಿದ್ದರು.<verse eid="1CH 8:13"/></para>
  <para style="li1">
    <verse number="14" style="v" sid="1CH 8:14"/>ಅಹಿಯೋ, ಶಾಷಕ್, ಯೆರೀಮೋತ್, <verse eid="1CH 8:14"/><verse number="15" style="v" sid="1CH 8:15"/>ಜೆಬದ್ಯ, ಅರಾದ್, ಏದೆರ್, <verse eid="1CH 8:15"/><verse number="16" style="v" sid="1CH 8:16"/>ಮೀಕಾಯೇಲ್, ಇಷ್ಪ, ಯೋಹ ಇವರು ಬೆರೀಯನ ಪುತ್ರರು.<verse eid="1CH 8:16"/></para>
  <para style="li1">
    <verse number="17" style="v" sid="1CH 8:17"/>ಜೆಬದ್ಯ, ಮೆಷುಲ್ಲಾಮ್, ಹಿಜ್ಕೀ, ಹೆಬೆರ್, <verse eid="1CH 8:17"/><verse number="18" style="v" sid="1CH 8:18"/>ಇಷ್ಮೆರೈ, ಇಜ್ಲೀಯ, ಯೋಬಾಬ್ ಇವರು ಎಲ್ಪಾಲನ ಪುತ್ರರು.<verse eid="1CH 8:18"/></para>
  <para style="li1">
    <verse number="19" style="v" sid="1CH 8:19"/>ಶಿಮ್ಮಿಯ ಕುಮಾರರು: ಯಾಕೀಮ್, ಜಿಕ್ರಿ, ಜಬ್ದೀ, <verse eid="1CH 8:19"/><verse number="20" style="v" sid="1CH 8:20"/>ಎಲೀಯೆನೈ, ಚಿಲ್ಲೆತೈ, ಎಲೀಯೇಲ್, <verse eid="1CH 8:20"/><verse number="21" style="v" sid="1CH 8:21"/>ಅದಾಯಾ, ಬೆರಾಯ, ಶಿಮ್ರಾತ್.<verse eid="1CH 8:21"/></para>
  <para style="li1">
    <verse number="22" style="v" sid="1CH 8:22"/>ಶಾಷಕನ ಪುತ್ರರು: ಇಷ್ಪಾನ್, ಏಬೆರ್, ಎಲೀಯೇಲ್, <verse eid="1CH 8:22"/><verse number="23" style="v" sid="1CH 8:23"/>ಅಬ್ದೋನ್, ಜಿಕ್ರಿಯು, ಹಾನಾನ್, <verse eid="1CH 8:23"/><verse number="24" style="v" sid="1CH 8:24"/>ಹನನ್ಯ, ಏಲಾಮ್, ಅನೆತೋತೀಯ, <verse eid="1CH 8:24"/><verse number="25" style="v" sid="1CH 8:25"/>ಇಫ್ದೆಯಾಹ, ಪೆನೂಯೇಲ್.<verse eid="1CH 8:25"/></para>
  <para style="li1">
    <verse number="26" style="v" sid="1CH 8:26"/>ಶಂಷೆರೈ, ಶೆಹರ್ಯ, ಅತಲ್ಯ, <verse eid="1CH 8:26"/><verse number="27" style="v" sid="1CH 8:27"/>ಯಾರೆಷ್ಯ, ಎಲೀಯ, ಜಿಕ್ರಿ ಇವರು ಯೆರೋಹಾಮನ ಪುತ್ರರು.<verse eid="1CH 8:27"/></para>
  <para style="li4">
    <verse number="28" style="v" sid="1CH 8:28"/>ಇವರೇ ಕುಟುಂಬಗಳಲ್ಲಿ ಯಜಮಾನರಾಗಿದ್ದು, ತಮ್ಮ ವಂಶಗಳ ಮುಖ್ಯಸ್ಥರಾಗಿ ಯೆರೂಸಲೇಮಿನಲ್ಲಿ ವಾಸವಾಗಿದ್ದರು.<verse eid="1CH 8:28"/></para>
  <para style="b"/>
  <para style="li1">
    <verse number="29" style="v" sid="1CH 8:29"/>ಗಿಬ್ಯೋನನ ಮೂಲಪುರುಷನಾದ ಯೆಹಿಯೇಲನು ಗಿಬ್ಯೋನಿನಲ್ಲಿ ವಾಸವಾಗಿದ್ದನು.</para>
  <para style="li2" vid="1CH 8:29">ಅವನ ಹೆಂಡತಿಯ ಹೆಸರು ಮಾಕಳು. <verse eid="1CH 8:29"/><verse number="30" style="v" sid="1CH 8:30"/>ಅವನ ಚೊಚ್ಚಲ ಮಗನು ಅಬ್ದೋನನು ನಂತರ ಚೂರನು, ಕೀಷನು, ಬಾಳನು, ನೇರನು, ನಾದಾಬನು, <verse eid="1CH 8:30"/><verse number="31" style="v" sid="1CH 8:31"/>ಗೆದೋರನು, ಅಹಿಯೋನು, ಜೆಕೆರನು. <verse eid="1CH 8:31"/><verse number="32" style="v" sid="1CH 8:32"/>ಮಿಕ್ಲೋತನು ಶಿಮಾಹನನ್ನು ಪಡೆದನು. ಇವರೂ ಸಹ ಯೆರೂಸಲೇಮಿನಲ್ಲಿ ತಮ್ಮ ಸಹೋದರರ ಸಂಗಡ ವಾಸವಾಗಿದ್ದರು.<verse eid="1CH 8:32"/></para>
  <para style="li1">
    <verse number="33" style="v" sid="1CH 8:33"/>ನೇರನು ಕೀಷನನ್ನು ಪಡೆದನು; ಕೀಷನು ಸೌಲನನ್ನು ಪಡೆದನು; ಸೌಲನ ಮಕ್ಕಳು ಯೋನಾತಾನ್, ಮಲ್ಕೀಷೂವ, ಅಬೀನಾದಾಬ್, ಎಷ್ಬಾಳ<note caller="+" style="f"><char style="fr" closed="false">8:33 </char><char style="fq" closed="false">ಎಷ್ಬಾಳ </char><char style="ft" closed="false">ಇನ್ನೊಂದು ಹೆಸರು </char><char style="fqa" closed="false">ಬೊಶೆತ್</char></note> ಎಂಬವರು.<verse eid="1CH 8:33"/></para>
  <para style="li1">
    <verse number="34" style="v" sid="1CH 8:34"/>ಯೋನಾತಾನನ ಮಗನು ಮೆರೀಬ್ಬಾಳನು<note caller="+" style="f"><char style="fr" closed="false">8:34 </char><char style="fq" closed="false">ಮೆರೀಬ್ಬಾಳ </char><char style="ft" closed="false">ಇನ್ನೊಂದು ಹೆಸರು </char><char style="fqa" closed="false">ಮೆಫಿಲಬೊಶೆತ್</char></note>;</para>
  <para style="li2" vid="1CH 8:34">ಮೆರೀಬ್ಬಾಳನು ಮೀಕನನ್ನು ಪಡೆದನು.<verse eid="1CH 8:34"/></para>
  <para style="li1">
    <verse number="35" style="v" sid="1CH 8:35"/>ಮೀಕನ ಪುತ್ರರು:</para>
  <para style="li2" vid="1CH 8:35">ಪಿತೋನನು, ಮೇಲಕನು, ತರೇಯನು ಮತ್ತು ಆಹಾಜನು.<verse eid="1CH 8:35"/></para>
  <para style="li2">
    <verse number="36" style="v" sid="1CH 8:36"/>ಆಹಾಜನು ಯೆಹೋವದ್ದಾಹನ ತಂದೆ. ಯೆಹೋವದ್ದಾಹನು ಆಲೆಮೆತನನ್ನೂ, ಅಜ್ಮಾವೆತನನ್ನೂ, ಜಿಮ್ರಿಯನ್ನೂ ಪಡೆದನು, ಜಿಮ್ರಿಯು ಮೋಚನನ್ನು ಪಡೆದನು. <verse eid="1CH 8:36"/><verse number="37" style="v" sid="1CH 8:37"/>ಮೋಚನು ಬಿನ್ನನನ್ನು ಪಡೆದನು. ಅವನ ಮಗನು ರಾಫನು. ಅವನ ಮಗನು ಎಲ್ಲಾಸನು. ಅವನ ಮಗನು ಆಚೇಲನು.<verse eid="1CH 8:37"/></para>
  <para style="li1">
    <verse number="38" style="v" sid="1CH 8:38"/>ಈ ಆಚೇಲನಿಗೆ ಆರು ಮಂದಿ ಪುತ್ರರಿದ್ದರು. ಅವರ ಹೆಸರುಗಳು</para>
  <para style="li2" vid="1CH 8:38">ಅಜ್ರೀಕಾಮನು, ಬೋಕೆರೂ, ಇಷ್ಮಾಯೇಲನು, ಶೆಯರ್ಯನು, ಓಬದ್ಯನು, ಹಾನಾನನು, ಇವರೆಲ್ಲರು ಆಚೇಲನ ಪುತ್ರರು.<verse eid="1CH 8:38"/></para>
  <para style="li1">
    <verse number="39" style="v" sid="1CH 8:39"/>ಅವನ ಸಹೋದರನಾದ ಏಷೆಕನ ಪುತ್ರರು:</para>
  <para style="li2" vid="1CH 8:39">ಅವನ ಚೊಚ್ಚಲಮಗನಾದ ಉಲಾಮನು, ಎರಡನೆಯವನಾದ ಯೆಯೂಷನು, ಮೂರನೆಯವನಾದ ಎಲೀಫೆಲೆಟನು. <verse eid="1CH 8:39"/><verse number="40" style="v" sid="1CH 8:40"/>ಈ ಉಲಾಮನ ಪುತ್ರರು ಬಿಲ್ಲುಗಾರರಾಗಿ ಯುದ್ಧದಲ್ಲಿ ಪರಾಕ್ರಮಶಾಲಿಗಳಾಗಿದ್ದರು. ಅವರಿಗೆ ಮಕ್ಕಳೂ, ಮೊಮ್ಮಕ್ಕಳೂ 150 ಮಂದಿ ಇದ್ದರು.</para>
  <para style="li1" vid="1CH 8:40">ಇವರೆಲ್ಲರೂ ಬೆನ್ಯಾಮೀನನ ವಂಶಜರು.<verse eid="1CH 8:40"/></para>
  <para style="b"/>
  <chapter eid="1CH 8"/>
  <chapter number="9" style="c" sid="1CH 9"/>
  <para style="p">
    <verse number="1" style="v" sid="1CH 9:1"/>ಇಸ್ರಾಯೇಲಿನ ಎಲ್ಲಾ ಜನರನ್ನು ಅವರ ಕುಟುಂಬಗಳಿಗೆ ಅನುಗುಣವಾಗಿ ಪಟ್ಟಿಮಾಡಲಾಗಿದೆ. ಈ ಮಾಹಿತಿ ಇಸ್ರಾಯೇಲಿನ ಅರಸರ ಪುಸ್ತಕದಲ್ಲಿ ದಾಖಲಾಗಿದೆ. ಯೆಹೂದ್ಯರು ದ್ರೋಹಿಗಳಾದದರಿಂದ ಬಾಬೆಲಿಗೆ ಸೆರೆಯವರಾಗಿ ಹೋಗಬೇಕಾಯಿತು.<verse eid="1CH 9:1"/></para>
  <para style="s1">ಯೆರೂಸಲೇಮಿನವರ ಪಟ್ಟಿ</para>
  <para style="li4">
    <verse number="2" style="v" sid="1CH 9:2"/>ತಮ್ಮ ಸ್ವಾಸ್ತ್ಯಗಳಲ್ಲಿ, ತಮ್ಮ ಪಟ್ಟಣಗಳಲ್ಲಿ ಮೊದಲು ವಾಸವಾಗಿದ್ದವರಲ್ಲಿ ಕೆಲವರು ಇಸ್ರಾಯೇಲರೂ, ಯಾಜಕರೂ, ಲೇವಿಯರೂ ಮತ್ತು ದೇವಾಲಯದ ಸೇವಕರೂ ಆಗಿದ್ದರು.<verse eid="1CH 9:2"/></para>
  <para style="b"/>
  <para style="li4">
    <verse number="3" style="v" sid="1CH 9:3"/>ಯೆರೂಸಲೇಮಿನಲ್ಲಿ ವಾಸವಾಗಿದ್ದ ಯೆಹೂದನ ಮಕ್ಕಳೂ, ಬೆನ್ಯಾಮೀನನ ಮಕ್ಕಳೂ, ಎಫ್ರಾಯೀಮ್, ಮನಸ್ಸೆ ಎಂಬವರ ಮಕ್ಕಳು ಯಾರೆಂದರೆ:<verse eid="1CH 9:3"/></para>
  <para style="li1">
    <verse number="4" style="v" sid="1CH 9:4"/>ಯೆಹೂದನ ಮಗನಾದ ಪೆರೆಚನ ಮಕ್ಕಳಲ್ಲಿ ಒಬ್ಬನಾದ ಬಾನೀಯ ಮಗನಾದ ಇಮ್ರಿಯು, ಇವನ ಮಗನಾದ ಒಮ್ರಿ, ಇವನ ಮಗನು ಅಮ್ಮೀಹೂದನು, ಇವನ ಮಗನು ಉತೈ.<verse eid="1CH 9:4"/></para>
  <para style="li1">
    <verse number="5" style="v" sid="1CH 9:5"/>ಶೇಲಾಹನರಲ್ಲಿ</para>
  <para style="li2" vid="1CH 9:5">ಚೊಚ್ಚಲಮಗನಾದ ಅಸಾಯನು, ಅವನ ಪುತ್ರರು.<verse eid="1CH 9:5"/></para>
  <para style="li1">
    <verse number="6" style="v" sid="1CH 9:6"/>ಜೆರಹನ ಪುತ್ರರಲ್ಲಿ</para>
  <para style="li2" vid="1CH 9:6">ಯೆಯೂವೇಲನೂ,</para>
  <para style="li4" vid="1CH 9:6">ಅವನ ಸಹೋದರರೂ 690 ಮಂದಿ.<verse eid="1CH 9:6"/></para>
  <para style="b"/>
  <para style="li4">
    <verse number="7" style="v" sid="1CH 9:7"/>ಬೆನ್ಯಾಮೀನ್ಯರಲ್ಲಿ</para>
  <para style="li1" vid="1CH 9:7">ಹಸ್ಸೆನುವಾಹನ ಮಗನು ಹೋದವ್ಯನ ಮಗನು ಮೆಷುಲ್ಲಾಮನ ಮಗ ಸಲ್ಲು,<verse eid="1CH 9:7"/></para>
  <para style="li1">
    <verse number="8" style="v" sid="1CH 9:8"/>ಯೆರೋಹಾಮನ ಮಗ ಇಬ್ನೇಯಾಹನೂ;</para>
  <para style="li1" vid="1CH 9:8">ಮಿಕ್ರಿಯ ಮಗ ಉಜ್ಜೀಯ ಮಗ ಏಲಾನೂ;</para>
  <para style="li1" vid="1CH 9:8">ಇಬ್ನಿಯನ ಮಗ ರೆಯೂವೇಲನ ಮಗ, ಶೆಫಟ್ಯನ ಮಗ ಮೆಷುಲ್ಲಾಮನೂ,<verse eid="1CH 9:8"/></para>
  <para style="li4">
    <verse number="9" style="v" sid="1CH 9:9"/>ಅವರ ಸಹೋದರರೂ ತಮ್ಮ ವಂಶಗಳ ಪ್ರಕಾರ 956 ಮಂದಿ. ಇವರೆಲ್ಲರು ತಮ್ಮ ಕುಟುಂಬಗಳ ಮುಖ್ಯಸ್ಥರಾಗಿದ್ದರು.<verse eid="1CH 9:9"/></para>
  <para style="b"/>
  <para style="li4">
    <verse number="10" style="v" sid="1CH 9:10"/>ಯಾಜಕರಲ್ಲಿ ಯಾರೆಂದರೆ</para>
  <para style="li1" vid="1CH 9:10">ಯೆದಾಯನೂ, ಯೆಹೋಯಾರೀಬನೂ, ಯಾಕೀನನೂ;<verse eid="1CH 9:10"/></para>
  <para style="li1">
    <verse number="11" style="v" sid="1CH 9:11"/>ದೇವರ ಮನೆಯ ಅಧಿಕಾರಿಯಾದ ಅಹೀಟೂಬನ ಮಗ ಮೆರಾಯೋತನ ಮಗ ಚಾದೋಕನ ಮಗ ಮೆಷುಲ್ಲಾಮನ ಮಗನಾದ ಹಿಲ್ಕೀಯನ ಮಗನು ಅಜರ್ಯನೂ;<verse eid="1CH 9:11"/></para>
  <para style="li1">
    <verse number="12" style="v" sid="1CH 9:12"/>ಮಲ್ಕೀಯನ ಮಗ ಪಷ್ಹೂರನ ಮಗ ಯೆರೋಹಾಮನ ಮಗ ಅದಾಯನು.</para>
  <para style="li1" vid="1CH 9:12">ಇಮ್ಮೇರನ ಮಗ ಮೆಷಿಲ್ಲೇಮೋತನ ಮಗ ಮೆಷುಲ್ಲಾಮನ ಮಗ ಯಹ್ಜೇರನ ಮಗ ಅದೀಯೇಲನ ಮಗ ಮಾಸೈಯನೂ;<verse eid="1CH 9:12"/></para>
  <para style="li4">
    <verse number="13" style="v" sid="1CH 9:13"/>ಅವರ ಸಹೋದರರೂ ತಮ್ಮ ಕುಟುಂಬಗಳಲ್ಲಿ ಯಜಮಾನರು 1,760 ಮಂದಿಯಾಗಿದ್ದರು. ಇವರು ದೇವರ ಮನೆಯ ಸೇವೆಯ ಕೆಲಸದಲ್ಲಿ ಪರಾಕ್ರಮಶಾಲಿಗಳಾಗಿದ್ದರು.<verse eid="1CH 9:13"/></para>
  <para style="b"/>
  <para style="li4">
    <verse number="14" style="v" sid="1CH 9:14"/>ಲೇವಿಯರಲ್ಲಿ ಯಾರೆಂದರೆ:</para>
  <para style="li1" vid="1CH 9:14">ಮೆರಾರೀಯ ಪುತ್ರರಲ್ಲಿ ಒಬ್ಬನಾದ ಹಷ್ಷೂಬನ ಮಗ ಅಜ್ರೀಕಾಮನ ಮಗ ಹಷಬ್ಯನ ಮಗ ಶೆಮಾಯನೂ;<verse eid="1CH 9:14"/></para>
  <para style="li1">
    <verse number="15" style="v" sid="1CH 9:15"/>ಬಕ್ಬಕ್ಕರನೂ, ಹೆರೆಷನೂ, ಗಲಾಲನೂ, ಆಸಾಫನ ಮಗ, ಜಿಕ್ರಿಯ ಮಗ, ಮೀಕನ ಮಗ ಮತ್ತನ್ಯನೂ;<verse eid="1CH 9:15"/></para>
  <para style="li1">
    <verse number="16" style="v" sid="1CH 9:16"/>ಯೆದುತೂನನ ಮಗ, ಗಲಾಲನ ಮಗ, ಶೆಮಾಯನ ಮಗ, ಓಬದ್ಯನೂ;</para>
  <para style="li1" vid="1CH 9:16">ಎಲ್ಕಾನನ ಮಗ ಆಸನ ಮಗ ಬೆರೆಕ್ಯನೂ ಇವರು ನೆಟೋಫದವರ ಊರುಗಳಲ್ಲಿ ವಾಸವಾಗಿದ್ದರು.<verse eid="1CH 9:16"/></para>
  <para style="b"/>
  <para style="li4">
    <verse number="17" style="v" sid="1CH 9:17"/>ದ್ವಾರಪಾಲಕರು ಯಾರೆಂದರೆ:</para>
  <para style="li1" vid="1CH 9:17">ಶಲ್ಲೂಮನೂ, ಅಕ್ಕೂಬನೂ, ಟಲ್ಮೋನನೂ, ಅಹೀಮನ್‌ನೂ, ಅವರ ಸಹೋದರರೂ. ಅವರಲ್ಲಿ ಶಲ್ಲೂಮನು ಮುಖ್ಯಸ್ಥನಾಗಿದ್ದನು. <verse eid="1CH 9:17"/><verse number="18" style="v" sid="1CH 9:18"/>ಇವರು ಈವರೆಗೂ ಪೂರ್ವದಿಕ್ಕಿನಲ್ಲಿರುವ ಅರಸನ ಬಾಗಿಲಲ್ಲಿ ಕಾದುಕೊಂಡಿದ್ದರು. ಇವರು ಲೇವಿಯ ಮಕ್ಕಳ ದಂಡುಗಳಲ್ಲಿ ದ್ವಾರಪಾಲಕರಾಗಿದ್ದರು.<verse eid="1CH 9:18"/></para>
  <para style="li1">
    <verse number="19" style="v" sid="1CH 9:19"/>ಇದಲ್ಲದೆ ಕೋರಹನ ಮಗನಾದ ಎಬ್ಯಾಸಾಫನ ಮೊಮ್ಮಗನೂ ಕೋರೇಯನ ಮರಿಮಗನಾದ ಶಲ್ಲೂಮನೂ, ಅವನ ತಂದೆಯ ಮನೆಯವರಾಗಿರುವ ತನ್ನ ಸಹೋದರರಾದ ಕೋರಹಿಯರೂ ಸೇವೆಯ ಕೆಲಸದ ಮೇಲಿದ್ದು, ದೇವದರ್ಶನ ಗುಡಾರದ ಬಾಗಿಲಿನ ಕಾವಲುಗಾರರಾಗಿದ್ದರು. ಅವರ ಪಿತೃಗಳು ಯೆಹೋವ ದೇವರ ಗುಡಾರದ ದ್ವಾರಗಳ ಕಾವಲಿನವರಾಗಿದ್ದರು.<verse eid="1CH 9:19"/></para>
  <para style="li1">
    <verse number="20" style="v" sid="1CH 9:20"/>ಎಲಿಯಾಜರನ ಮಗನಾದ ಫೀನೆಹಾಸನು ಮುಂಚೆ ಅವರ ಮೇಲೆ ಅಧಿಕಾರಿಯಾಗಿದ್ದನು. ಯೆಹೋವ ದೇವರು ಅವರ ಸಂಗಡ ಇದ್ದರು.<verse eid="1CH 9:20"/></para>
  <para style="li1">
    <verse number="21" style="v" sid="1CH 9:21"/>ಮೆಷೆಲೆಮ್ಯನ ಮಗನಾದ ಜೆಕರ್ಯನು ದೇವದರ್ಶನ ಗುಡಾರದ ದ್ವಾರಪಾಲಕನಾಗಿದ್ದನು.<verse eid="1CH 9:21"/></para>
  <para style="li4">
    <verse number="22" style="v" sid="1CH 9:22"/>ಬಾಗಿಲುಗಳಲ್ಲಿ ದ್ವಾರಪಾಲಕರಾಗಿರಲು ಆಯ್ಕೆಯಾದ ಇವರೆಲ್ಲರು 212 ಮಂದಿಯಾಗಿದ್ದರು. ಇವರು ಹೆಸರುಗಳು ಅವರವರ ಗ್ರಾಮಗಳಲ್ಲಿ ಅವರ ವಂಶಾವಳಿಯ ಪ್ರಕಾರ ಲಿಖಿತವಾಗಿದ್ದವು.</para>
  <para style="b" vid="1CH 9:22"/>
  <para style="p" vid="1CH 9:22">ಇವರು ನಂಬಿಗಸ್ತರಾದ್ದರಿಂದ ದಾವೀದನೂ, ದರ್ಶಿಯಾದ ಸಮುಯೇಲನೂ ಇವರನ್ನು ಜವಾಬ್ದಾರಿಯ ಸ್ಥಾನಗಳಿಗೆ ನೇಮಿಸಿದರು. <verse eid="1CH 9:22"/><verse number="23" style="v" sid="1CH 9:23"/>ಹೀಗೆಯೇ ಅವರಿಗೂ, ಅವರ ಮಕ್ಕಳಿಗೂ ಯೆಹೋವ ದೇವರ ಮನೆಯ ಬಾಗಿಲು ಕಾವಲಿತ್ತು. ಅದು ದೇವದರ್ಶನ ಗುಡಾರವೆಂಬ ಮನೆಯ ಪ್ರಕಾರ ಕಾವಲುಗಾರರಿಂದ ಕಾಯಬೇಕಾಗಿತ್ತು. <verse eid="1CH 9:23"/><verse number="24" style="v" sid="1CH 9:24"/>ಪೂರ್ವ, ಪಶ್ಚಿಮ, ಉತ್ತರ, ದಕ್ಷಿಣ ನಾಲ್ಕು ದಿಕ್ಕುಗಳಲ್ಲಿ ದ್ವಾರಪಾಲಕರಿದ್ದರು. <verse eid="1CH 9:24"/><verse number="25" style="v" sid="1CH 9:25"/>ಗ್ರಾಮಗಳಲ್ಲಿ ಇದ್ದ ಅವರ ಸಹೋದರರು ತಮ್ಮ ಕ್ರಮದ ಪ್ರಕಾರವಾಗಿ ಏಳೇಳು ದಿವಸಗಳಲ್ಲಿ ಬರುವ ನೇಮಕವಿತ್ತು. <verse eid="1CH 9:25"/><verse number="26" style="v" sid="1CH 9:26"/>ಏಕೆಂದರೆ ದ್ವಾರಪಾಲಕರಲ್ಲಿರುವ ನಾಲ್ಕು ಮಂದಿ ಮುಖ್ಯಸ್ಥರಾದ ಈ ಲೇವಿಯರು ತಮ್ಮ ನೇಮಕವಾದ ಉದ್ಯೋಗದಲ್ಲಿ ಇದ್ದು ದೇವರ ಆಲಯದ ಉಗ್ರಾಣಗಳ ಮೇಲೆಯೂ ಬೊಕ್ಕಸಗಳ ಜವಾಬ್ದಾರಿಯನ್ನು ವಹಿಸಲಾಗಿತ್ತು. <verse eid="1CH 9:26"/><verse number="27" style="v" sid="1CH 9:27"/>ಅವರು ದೇವರ ಆಲಯದ ಸುತ್ತಲೂ ರಾತ್ರಿಯನ್ನು ಕಳೆಯುತ್ತಿದ್ದರು, ಏಕೆಂದರೆ ಅವರು ಅದನ್ನು ಕಾವಲು ಕಾಯಬೇಕಾಗಿತ್ತು. ಮತ್ತು ಪ್ರತಿದಿನ ಬೆಳಿಗ್ಗೆ ಬಾಗಿಲುಗಳನ್ನು ತೆರೆಯುತ್ತಿದ್ದರು.<verse eid="1CH 9:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="1CH 9:28"/>ಸೇವೆಯ ಸಲಕರಣೆಗಳನ್ನು ಒಳಗೆ ಲೆಕ್ಕದ ಪ್ರಕಾರ ತರುವುದಕ್ಕೂ, ಹೊರಗೆ ಲೆಕ್ಕದ ಪ್ರಕಾರ ತರುವುದಕ್ಕೂ ಅವರಲ್ಲಿ ಕೆಲವರು ಅವುಗಳ ಮೇಲೆ ನೇಮಕವಾಗಿದ್ದರು. <verse eid="1CH 9:28"/><verse number="29" style="v" sid="1CH 9:29"/>ಅವರಲ್ಲಿ ಕೆಲವರು ಸಲಕರಣೆಗಳನ್ನೂ, ಪರಿಶುದ್ಧ ಸ್ಥಾನದಲ್ಲಿರುವ ಎಲ್ಲಾ ಸಾಮಗ್ರಿಗಳನ್ನೂ, ನಯವಾದ ಹಿಟ್ಟನ್ನೂ, ದ್ರಾಕ್ಷಾರಸವನ್ನೂ, ಎಣ್ಣೆಯನ್ನೂ, ಸಾಂಬ್ರಾಣಿಯನ್ನೂ, ಸುಗಂಧಗಳನ್ನೂ ಕಾಯಲು ನೇಮಕರಾಗಿದ್ದರು. <verse eid="1CH 9:29"/><verse number="30" style="v" sid="1CH 9:30"/>ಯಾಜಕರ ಪುತ್ರರಲ್ಲಿ ಕೆಲವರು ಸುಗಂಧಗಳಿಂದ ತೈಲವನ್ನು ಮಾಡಿದರು. <verse eid="1CH 9:30"/><verse number="31" style="v" sid="1CH 9:31"/>ಕೋರಹಿಯನಾದ ಶಲ್ಲೂಮನ ಚೊಚ್ಚಲಮಗನಾದ ಮತ್ತಿತ್ಯನು ಲೇವಿಯರಲ್ಲಿ ಒಬ್ಬನಾಗಿದ್ದು, ತಟ್ಟೆಗಳ ಮೇಲೆ ಮಾಡುವ ಭಕ್ಷ್ಯಗಳ ಕೆಲಸದ ಮೇಲ್ವಿಚಾರಕನಾಗಿದ್ದನು. <verse eid="1CH 9:31"/><verse number="32" style="v" sid="1CH 9:32"/>ಕೊಹಾತ್ಯರ ಪುತ್ರರಾದ ಅವರ ಸಹೋದರರಲ್ಲಿ ಇನ್ನೂ ಕೆಲವರು ಸಮ್ಮುಖದ ರೊಟ್ಟಿಯನ್ನು ಪ್ರತಿ ಸಬ್ಬತ್<note caller="+" style="f"><char style="fr" closed="false">9:32 </char><char style="fq" closed="false">ಸಬ್ಬತ್ </char><char style="ft" closed="false">ಅಂದರೆ </char><char style="fqa" closed="false">ವಿಶ್ರಾಂತಿ ದಿನ</char></note> ದಿನದಲ್ಲಿ ಸಿದ್ಧಮಾಡುವ ಜವಾಬ್ದಾರಿಯನ್ನು ಹೊಂದಿದ್ದರು.<verse eid="1CH 9:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="1CH 9:33"/>ಇದಲ್ಲದೆ ಲೇವಿಯರ ಕುಟುಂಬಗಳಲ್ಲಿ ಮುಖ್ಯಸ್ಥರಾದ ಇವರು ಹಾಡುಗಾರರಾಗಿದ್ದು, ಸ್ವತಂತ್ರವಾದ ಕೊಠಡಿಗಳಲ್ಲಿ ವಾಸವಾಗಿದ್ದರು. ಏಕೆಂದರೆ ಅವರು ರಾತ್ರಿ ಹಗಲು ಅದೇ ಕಾರ್ಯದಲ್ಲಿದ್ದರು.<verse eid="1CH 9:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="1CH 9:34"/>ಲೇವಿಯರ ಕುಟುಂಬಗಳಲ್ಲಿ ಮುಖ್ಯಸ್ಥರಾದ ಇವರು ತಮ್ಮ ವಂಶಗಳಲ್ಲಿ ಮುಖ್ಯಸ್ಥರಾಗಿದ್ದು ಯೆರೂಸಲೇಮಿನಲ್ಲಿ ವಾಸವಾಗಿದ್ದರು.<verse eid="1CH 9:34"/></para>
  <para style="s1">ಸೌಲನ ವಂಶಾವಳಿ</para>
  <para style="li1">
    <verse number="35" style="v" sid="1CH 9:35"/>ಇದಲ್ಲದೆ ಗಿಬ್ಯೋನನ ಮೂಲಪುರುಷನಾದ ಯೆಹಿಯೇಲನು ಗಿಬ್ಯೋನಿನಲ್ಲಿ ವಾಸವಾಗಿದ್ದನು.</para>
  <para style="li2" vid="1CH 9:35">ಅವನ ಹೆಂಡತಿಯ ಹೆಸರು ಮಾಕಳು. <verse eid="1CH 9:35"/><verse number="36" style="v" sid="1CH 9:36"/>ಅವನ ಚೊಚ್ಚಲ ಮಗನು ಅಬ್ದೋನನು ನಂತರ ಚೂರನು, ಕೀಷನು, ಬಾಳನು, ನೇರನು, ನಾದಾಬನು. <verse eid="1CH 9:36"/><verse number="37" style="v" sid="1CH 9:37"/>ಗೆದೋರನು, ಅಹಿಯೋನು, ಜೆಕರೀಯನು, ಮಿಕ್ಲೋತನು. <verse eid="1CH 9:37"/><verse number="38" style="v" sid="1CH 9:38"/>ಮಿಕ್ಲೋತನು ಶಿಮಾಮನನ್ನು ಪಡೆದನು. ಇವರೂ ಸಹ ಯೆರೂಸಲೇಮಿನಲ್ಲಿ ತಮ್ಮ ಸಹೋದರರ ಸಂಗಡ ವಾಸವಾಗಿದ್ದರು.<verse eid="1CH 9:38"/></para>
  <para style="li1">
    <verse number="39" style="v" sid="1CH 9:39"/>ನೇರನು ಕೀಷನನ್ನು ಪಡೆದನು; ಕೀಷನು ಸೌಲನನ್ನು ಪಡೆದನು; ಸೌಲನ ಮಕ್ಕಳು: ಯೋನಾತಾನ್, ಮಲ್ಕೀಷೂವ, ಅಬೀನಾದಾಬ್, ಎಷ್ಬಾಳ ಎಂಬವರು.<verse eid="1CH 9:39"/></para>
  <para style="li1">
    <verse number="40" style="v" sid="1CH 9:40"/>ಯೋನಾತಾನನ ಮಗನು ಮೆರೀಬ್ಬಾಳನು;</para>
  <para style="li2" vid="1CH 9:40">ಮೆರೀಬ್ಬಾಳನು ಮೀಕನನ್ನು ಪಡೆದನು.<verse eid="1CH 9:40"/></para>
  <para style="li1">
    <verse number="41" style="v" sid="1CH 9:41"/>ಮೀಕನ ಪುತ್ರರು:</para>
  <para style="li2" vid="1CH 9:41">ಪಿತೋನನು, ಮೇಲಕನು, ತಹ್ರೀಯನು ಮತ್ತು ಆಹಾಜನು.<verse eid="1CH 9:41"/></para>
  <para style="li2">
    <verse number="42" style="v" sid="1CH 9:42"/>ಆಹಾಜನು ಯಗ್ರಾಹನನ್ನು ಪಡೆದನು; ಯಗ್ರಾಹನು ಆಲೆಮೆತನನ್ನೂ, ಅಜ್ಮಾವೆತನನ್ನೂ, ಜಿಮ್ರಿಯನ್ನೂ ಪಡೆದನು; ಜಿಮ್ರಿಯು ಮೋಚನನ್ನು ಪಡೆದನು; <verse eid="1CH 9:42"/><verse number="43" style="v" sid="1CH 9:43"/>ಮೋಚನು ಬಿನ್ನನನ್ನು ಪಡೆದನು; ಅವನ ಮಗನು ರೆಫಾಯನು; ಅವನ ಮಗನು ಎಲ್ಲಾಸನು; ಅವನ ಮಗನು ಆಚೇಲನು.<verse eid="1CH 9:43"/></para>
  <para style="li1">
    <verse number="44" style="v" sid="1CH 9:44"/>ಈ ಆಚೇಲನಿಗೆ ಆರು ಮಂದಿ ಪುತ್ರರಿದ್ದರು: ಅವರ ಹೆಸರುಗಳು</para>
  <para style="li2" vid="1CH 9:44">ಅಜ್ರೀಕಾಮನು, ಬೋಕೆರೂ, ಇಷ್ಮಾಯೇಲನು, ಶೆಯರ್ಯನು, ಓಬದ್ಯನು, ಹಾನಾನನು; ಇವರೆಲ್ಲರು ಆಚೇಲನ ಪುತ್ರರು.<verse eid="1CH 9:44"/></para>
  <chapter eid="1CH 9"/>
  <chapter number="10" style="c" sid="1CH 10"/>
  <para style="s1">ಸೌಲನ ಅಂತ್ಯವು</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 10:1"/>ಫಿಲಿಷ್ಟಿಯರು ಇಸ್ರಾಯೇಲರ ವಿರುದ್ಧ ಯುದ್ಧಮಾಡಿದರು. ಆಗ ಇಸ್ರಾಯೇಲರು ಫಿಲಿಷ್ಟಿಯರಿಂದ ಸೋತು ಓಡಿಹೋಗಿ, ಗಿಲ್ಬೋವ ಬೆಟ್ಟದಲ್ಲಿ ಹತರಾದರು. <verse eid="1CH 10:1"/><verse number="2" style="v" sid="1CH 10:2"/>ಫಿಲಿಷ್ಟಿಯರು ಸೌಲನನ್ನೂ, ಅವನ ಪುತ್ರರನ್ನೂ ಬಿಡದೆ ಬೆನ್ನಟ್ಟಿ, ಸೌಲನ ಪುತ್ರರಾದ ಯೋನಾತಾನನನ್ನೂ ಅಬೀನಾದಾಬನನ್ನೂ, ಮಲ್ಕೀಷೂವನನ್ನೂ ಕೊಂದುಬಿಟ್ಟರು. <verse eid="1CH 10:2"/><verse number="3" style="v" sid="1CH 10:3"/>ಯುದ್ಧವು ಸೌಲನಿದ್ದ ಕಡೆಯಲ್ಲಿ ಬಹುಘೋರವಾಗಿತ್ತು; ಬಿಲ್ಲುಗಾರರು ಅವನನ್ನು ಬಾಣಗಳಿಂದ ಹೊಡೆದಾಗ ಅವನು ತೀವ್ರವಾಗಿ ಗಾಯಗೊಂಡನು.<verse eid="1CH 10:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="1CH 10:4"/>ಆಗ ಸೌಲನು ತನ್ನ ಆಯುಧಗಳನ್ನು ಹೊರುವವನಿಗೆ, “ಈ ಸುನ್ನತಿ ಇಲ್ಲದವರು ಬಂದು ನನ್ನನ್ನು ಅವಮಾನ ಮಾಡದ ಹಾಗೆ, ನೀನು ನಿನ್ನ ಖಡ್ಗವನ್ನು ಹಿರಿದು ನನ್ನನ್ನು ತಿವಿ,” ಎಂದನು.</para>
  <para style="p" vid="1CH 10:4">ಆದರೆ ಅವನ ಆಯುಧ ಹೊರುವವನು ಬಹು ಭಯಪಟ್ಟದ್ದರಿಂದ ಹಾಗೆ ಮಾಡದೆ ಹೋದನು. ಆಗ ಸೌಲನು ತನ್ನ ಖಡ್ಗವನ್ನು ತೆಗೆದುಕೊಂಡು ಅದರ ಮೇಲೆ ಬಿದ್ದನು. <verse eid="1CH 10:4"/><verse number="5" style="v" sid="1CH 10:5"/>ಸೌಲನು ಸತ್ತು ಹೋದದ್ದನ್ನು ಅವನ ಆಯುಧ ಹೊರುವವನು ಕಂಡಾಗ, ಅವನೂ ತನ್ನ ಖಡ್ಗದ ಮೇಲೆ ಬಿದ್ದು, ಅವನ ಸಂಗಡ ಸತ್ತನು. <verse eid="1CH 10:5"/><verse number="6" style="v" sid="1CH 10:6"/>ಸೌಲನೂ, ಅವನ ಮೂರು ಮಂದಿ ಪುತ್ರರೂ, ಅವನ ಮನೆಯವರೆಲ್ಲರೂ ಒಟ್ಟಾಗಿ ಅದೇ ದಿನ ಸತ್ತರು.<verse eid="1CH 10:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="1CH 10:7"/>ಇಸ್ರಾಯೇಲರ ಸೈನಿಕರು ಸೋತು ಹೋದರೆಂದೂ, ಸೌಲನೂ, ಅವನ ಪುತ್ರರೂ ಸತ್ತರೆಂದೂ ತಗ್ಗಿನಲ್ಲಿ ವಾಸವಾಗಿದ್ದ ಇಸ್ರಾಯೇಲರೆಲ್ಲರು ಕಂಡಾಗ, ಅವರು ತಮ್ಮ ಪಟ್ಟಣಗಳನ್ನು ಬಿಟ್ಟು ಓಡಿಹೋದರು. ಆಗ ಫಿಲಿಷ್ಟಿಯರು ಬಂದು ಅವುಗಳಲ್ಲಿ ವಾಸಿಸಿದರು.<verse eid="1CH 10:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="1CH 10:8"/>ಮಾರನೆಯ ದಿವಸದಲ್ಲಿ ಫಿಲಿಷ್ಟಿಯರು ಸತ್ತವರ ಒಡವೆಗಳನ್ನು ಸುಲಿದುಕೊಳ್ಳಲು ಬಂದಾಗ, ಗಿಲ್ಬೋವ ಬೆಟ್ಟದಲ್ಲಿ ಸತ್ತುಬಿದ್ದಿರುವ ಸೌಲನನ್ನೂ, ಅವನ ಪುತ್ರರನ್ನೂ ಕಂಡರು. <verse eid="1CH 10:8"/><verse number="9" style="v" sid="1CH 10:9"/>ಅವರು ಅವನನ್ನು ಸುಲಿದುಕೊಂಡು ಅವನ ತಲೆಯನ್ನೂ, ಅವನ ಆಯುಧಗಳನ್ನೂ ತೆಗೆದುಕೊಂಡು, ತಮ್ಮ ವಿಗ್ರಹಗಳ ಮಂದಿರಗಳಿಗೂ, ಜನರಿಗೂ ಜಯವಾರ್ತೆಯನ್ನು ಸಾರುವ ಹಾಗೆ ಫಿಲಿಷ್ಟಿಯರ ದೇಶದ ಸುತ್ತಲೂ ಕಳುಹಿಸಿದರು. <verse eid="1CH 10:9"/><verse number="10" style="v" sid="1CH 10:10"/>ಸೌಲನ ಆಯುಧಗಳನ್ನು ತಮ್ಮ ದೇವರುಗಳ ಮಂದಿರದಲ್ಲಿ ಇಟ್ಟು, ಅವನ ತಲೆಯನ್ನು ದಾಗೋನನ ಆಲಯದಲ್ಲಿ ನೇತುಹಾಕಿದರು.<verse eid="1CH 10:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="1CH 10:11"/>ಫಿಲಿಷ್ಟಿಯರು ಸೌಲನಿಗೆ ಮಾಡಿದ್ದನ್ನೆಲ್ಲಾ ಯಾಬೇಷ್ ಗಿಲ್ಯಾದಿನವರೆಲ್ಲರು ಕೇಳಿದಾಗ, <verse eid="1CH 10:11"/><verse number="12" style="v" sid="1CH 10:12"/>ಅವರಲ್ಲಿರುವ ಸಮಸ್ತ ಪರಾಕ್ರಮಶಾಲಿಗಳು ಎದ್ದು ಸೌಲನ ಶವವನ್ನೂ, ಅವನ ಪುತ್ರರ ಶವಗಳನ್ನೂ ತೆಗೆದುಕೊಂಡು ಯಾಬೇಷಿಗೆ ಬಂದು, ಅವರ ಎಲುಬುಗಳನ್ನು ತೆಗೆದುಕೊಂಡು, ಅವುಗಳನ್ನು ಯಾಬೇಷಿನಲ್ಲಿರುವ ಒಂದು ಏಲಾ ಮರದ ಕೆಳಗೆ ಸಮಾಧಿಮಾಡಿ, ಏಳು ದಿವಸ ಉಪವಾಸ ಮಾಡಿದರು.<verse eid="1CH 10:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="1CH 10:13"/>ಹೀಗೆಯೇ ಸೌಲನು ಯೆಹೋವ ದೇವರಿಗೆ ವಿರೋಧವಾಗಿ ಮಾಡಿದ ತನ್ನ ಅಪರಾಧದ ನಿಮಿತ್ತ ಸತ್ತುಹೋದನು. ಅವನು ಯೆಹೋವ ದೇವರ ವಾಕ್ಯವನ್ನು ಕೈಗೊಳ್ಳದೆ, ಅದಕ್ಕೆ ವಿರೋಧವಾಗಿ ನಡೆದು, ಯೆಹೋವ ದೇವರನ್ನು ವಿಚಾರಿಸದೆ, ಯಕ್ಷಿಣಿಗಾರರನ್ನು ವಿಚಾರಿಸಿದ್ದರಿಂದ, <verse eid="1CH 10:13"/><verse number="14" style="v" sid="1CH 10:14"/>ಯೆಹೋವ ದೇವರು ಅವನನ್ನು ಕೊಂದುಹಾಕಿ, ರಾಜ್ಯವನ್ನು ಇಷಯನ ಮಗನಾದ ದಾವೀದನ ಕಡೆಗೆ ತಿರುಗಿಸಿದರು.<verse eid="1CH 10:14"/></para>
  <chapter eid="1CH 10"/>
  <chapter number="11" style="c" sid="1CH 11"/>
  <para style="s1">ದಾವೀದನು ಇಸ್ರಾಯೇಲರ ಮೇಲೆ ಅರಸನಾದದ್ದು</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 11:1"/>ಇಸ್ರಾಯೇಲರೆಲ್ಲರು ಹೆಬ್ರೋನಿನಲ್ಲಿರುವ ದಾವೀದನ ಬಳಿಗೆ ಬಂದು, “ಇಗೋ, ನಾವು ನಿನ್ನ ಎಲುಬೂ, ನಿನ್ನ ಮಾಂಸವೂ ಆಗಿದ್ದೇವೆ. <verse eid="1CH 11:1"/><verse number="2" style="v" sid="1CH 11:2"/>ಇದಲ್ಲದೆ ಪೂರ್ವದಲ್ಲಿ ಸೌಲನು ನಮ್ಮ ಮೇಲೆ ಅರಸನಾಗಿದ್ದಾಗ, ನೀನು ದಳಪತಿಯಾಗಿ ಇಸ್ರಾಯೇಲನ್ನು ಹೊರಗೆ ನಡೆಸುವವನಾಗಿಯೂ, ಒಳಗೆ ತರುವವನಾಗಿಯೂ ಇದ್ದವನು. ಆದ್ದರಿಂದ ನಿನ್ನ ದೇವರಾದ ಯೆಹೋವ ದೇವರು ನಿನಗೆ, ‘ನೀನು ನನ್ನ ಜನರಾದ ಇಸ್ರಾಯೇಲರ ನಾಯಕನೂ, ಪಾಲಕನೂ ಆಗಿರುವೆ,’ ಎಂದು ವಾಗ್ದಾನ ಮಾಡಿದ್ದು ನಿಮ್ಮನ್ನು ಕುರಿತೇ,” ಎಂದು ಹೇಳಿ ವಂದಿಸಿದರು.<verse eid="1CH 11:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="1CH 11:3"/>ಇಸ್ರಾಯೇಲಿನ ಹಿರಿಯರೆಲ್ಲರು ಹೆಬ್ರೋನಿನಲ್ಲಿದ್ದ ಅರಸನ ಬಳಿಗೆ ಬಂದಾಗ, ಅರಸನಾದ ದಾವೀದನು ಹೆಬ್ರೋನಿನಲ್ಲಿ ಯೆಹೋವ ದೇವರ ಮುಂದೆ ಅವರ ಸಂಗಡ ಒಡಂಬಡಿಕೆ ಮಾಡಿದನು. ಯೆಹೋವ ದೇವರು ಸಮುಯೇಲನ ಮುಖಾಂತರ ಹೇಳಿದ ವಾಕ್ಯದ ಪ್ರಕಾರ ಅವರು ದಾವೀದನನ್ನು ಇಸ್ರಾಯೇಲಿನ ಮೇಲೆ ಅರಸನಾಗಿರಲು ಅಭಿಷೇಕ ಮಾಡಿದರು.<verse eid="1CH 11:3"/></para>
  <para style="s1">ದಾವೀದನು ಯೆರೂಸಲೇಮನ್ನು ಜಯಿಸಿದ್ದು</para>
  <para style="p">
    <verse number="4" style="v" sid="1CH 11:4"/>ದಾವೀದನೂ, ಸಮಸ್ತ ಇಸ್ರಾಯೇಲರೂ ಯೆಬೂಸಿಯರ ವಿರುದ್ಧವಾಗಿ ಯೆರೂಸಲೇಮಿಗೆ ಹೋದರು. <verse eid="1CH 11:4"/><verse number="5" style="v" sid="1CH 11:5"/>ಆ ದೇಶದ ಮೂಲನಿವಾಸಿಗಳಾದ ಯೆಬೂಸಿಯರು ದಾವೀದನಿಗೆ, “ನೀನು ಇದರೊಳಗೆ ಬರಲು ಸಾಧ್ಯವಿಲ್ಲ,” ಎಂದರು. ಆದರೂ ದಾವೀದನು, ಚೀಯೋನಿನ ಕೋಟೆಯನ್ನು ವಶಪಡಿಸಿಕೊಂಡನು. ಅದೇ ದಾವೀದನ ಪಟ್ಟಣವು.<verse eid="1CH 11:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="1CH 11:6"/>“ಯೆಬೂಸಿಯರಲ್ಲಿ ಒಬ್ಬನನ್ನು ಯಾರು ಮೊದಲು ಕೊಲ್ಲುವನೋ, ಅವನು ನನ್ನ ದಳಪತಿಯಾಗುವನು,” ಎಂದು ದಾವೀದ ಪ್ರಕಟಿಸಿದ್ದನು. ಹಾಗೆಯೇ ಚೆರೂಯಳ ಮಗ ಯೋವಾಬನು ಮೊದಲು ಹೋಗಿ ದಳಪತಿಯಾದನು.<verse eid="1CH 11:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="1CH 11:7"/>ದಾವೀದನು ಕೋಟೆಯಲ್ಲಿ ವಾಸಮಾಡಿದನು. ಆದಕಾರಣ ಅದಕ್ಕೆ ದಾವೀದನ ಪಟ್ಟಣವೆಂದು ಹೆಸರಿಟ್ಟರು. <verse eid="1CH 11:7"/><verse number="8" style="v" sid="1CH 11:8"/>ಅವನು ಅದರ ಸುತ್ತಲೂ ಮಿಲ್ಲೋವಿನಿಂದ ಪ್ರಾರಂಭಿಸಿ, ಪಟ್ಟಣವನ್ನು ಪುನಃ ಕಟ್ಟಿದನು. ಆದರೆ ಪಟ್ಟಣದ ಉಳಿದ ಭಾಗವನ್ನು ಯೋವಾಬನು ಭದ್ರಮಾಡಿಸಿದನು. <verse eid="1CH 11:8"/><verse number="9" style="v" sid="1CH 11:9"/>ಹೀಗೆಯೇ ಸೇನಾಧೀಶ್ವರ ಯೆಹೋವ ದೇವರು ದಾವೀದನ ಸಂಗಡ ಇದ್ದುದರಿಂದ ಅವನು ದಿನದಿನಕ್ಕೆ ಬಲಗೊಳ್ಳುತ್ತಾ ಇದ್ದನು.<verse eid="1CH 11:9"/></para>
  <para style="s1">ದಾವೀದನ ಬಲಶಾಲಿಗಳು</para>
  <para style="p">
    <verse number="10" style="v" sid="1CH 11:10"/>ದಾವೀದನ ಬಳಿಯಲ್ಲಿದ್ದ ಮುಖ್ಯಸ್ಥರಾದ ಪರಾಕ್ರಮಶಾಲಿಗಳು ಇವರೇ. ಇಸ್ರಾಯೇಲನ್ನು ಕುರಿತು ಯೆಹೋವ ದೇವರು ಹೇಳಿದ ವಾಕ್ಯದ ಪ್ರಕಾರ, ಅವನನ್ನು ಅರಸನನ್ನಾಗಿ ಮಾಡುವುದಕ್ಕೆ ಅವರು ಸಮಸ್ತ ಇಸ್ರಾಯೇಲಿನ ಸಂಗಡ ಅವನ ರಾಜ್ಯದಲ್ಲಿ ತಮ್ಮ ಸಂಪೂರ್ಣ ಸಹಾಯ ನೀಡಿದರು. <verse eid="1CH 11:10"/><verse number="11" style="v" sid="1CH 11:11"/>ದಾವೀದನ ಪರಾಕ್ರಮಶಾಲಿಗಳ ಪಟ್ಟಿ:</para>
  <para style="p" vid="1CH 11:11">ಹಕ್ಮೋನಿಯನಾದ ಯಾಷೊಬ್ಬಾಮನು ಅಧಿಪತಿಗಳಲ್ಲಿ ಮುಖ್ಯಸ್ಥನಾಗಿದ್ದನು. ಇವನು ತನ್ನ ಈಟಿಯಿಂದ ಮುನ್ನೂರು ಮಂದಿಗೆ ವಿರೋಧವಾಗಿ ಹೋರಾಡಿ ಅವರನ್ನು ಒಂದೇ ಕಾಳಗದಲ್ಲಿ ಕೊಂದುಹಾಕಿದನು.<verse eid="1CH 11:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="1CH 11:12"/>ಇವನ ತರುವಾಯ ಅಹೋಹ್ಯನಾಗಿರುವ ದೋದೋ ಎಂಬವನ ಮಗನಾಗಿರುವ ಎಲಿಯಾಜರನು, ಮೂವರು ಪರಾಕ್ರಮಶಾಲಿಗಳಲ್ಲಿ ಒಬ್ಬನಾಗಿದ್ದನು. <verse eid="1CH 11:12"/><verse number="13" style="v" sid="1CH 11:13"/>ಪಸ್ ದಮ್ಮೀಮ್ ಎಂಬಲ್ಲಿ ಫಿಲಿಷ್ಟಿಯರು ಜವೆಗೋಧಿ ತುಂಬಿರುವ ಹೊಲದಲ್ಲಿ ಯುದ್ಧಕ್ಕಾಗಿ ಸೇರಿದಾಗ ಇವನು ದಾವೀದನ ಸಂಗಡ ಇದ್ದನು. ಅಲ್ಲಿ ಇಸ್ರಾಯೇಲ್ ಸೈನ್ಯದವರು ಫಿಲಿಷ್ಟಿಯರ ಎದುರಿನಿಂದ ಓಡಿಹೋದರು. <verse eid="1CH 11:13"/><verse number="14" style="v" sid="1CH 11:14"/>ಆಗ ಇವನು ಆ ಹೊಲದ ಮಧ್ಯದಲ್ಲಿ ನಿಂತುಕೊಂಡು, ಫಿಲಿಷ್ಟಿಯರನ್ನು ಕೊಂದುಹಾಕಿ ಹೊಲವನ್ನು ಕಾಪಾಡಿದನು. ಹೀಗೆ ಯೆಹೋವ ದೇವರು ಮಹಾಜಯವನ್ನು ಉಂಟುಮಾಡಿದರು.<verse eid="1CH 11:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="1CH 11:15"/>ಮೂವತ್ತು ಮಂದಿ ಪರಾಕ್ರಮಶಾಲಿಗಳ ಮುಖ್ಯಸ್ಥರಲ್ಲಿ ಮೂರು ಮಂದಿ ಅದುಲ್ಲಾಮ್ ಗವಿಯಲ್ಲಿರುವ ದಾವೀದನ ಬಳಿಗೆ ಗುಡ್ಡಕ್ಕೆ ಬಂದರು. ಅದೇ ವೇಳೆಯಲ್ಲಿ ಫಿಲಿಷ್ಟಿಯರ ಸೈನ್ಯವು ರೆಫಾಯಿಮ್ ತಗ್ಗಿನಲ್ಲಿ ಪಾಳೆಯ ಮಾಡಿಕೊಂಡಿತ್ತು. <verse eid="1CH 11:15"/><verse number="16" style="v" sid="1CH 11:16"/>ದಾವೀದನು ಕೋಟೆ ಸ್ಥಳದಲ್ಲಿ ಇದ್ದನು, ಫಿಲಿಷ್ಟಿಯರ ದಂಡು ಬೇತ್ಲೆಹೇಮಿನಲ್ಲಿತ್ತು. <verse eid="1CH 11:16"/><verse number="17" style="v" sid="1CH 11:17"/>ಆಗ ದಾವೀದನು, “ಬೇತ್ಲೆಹೇಮಿನ ಬಾಗಿಲ ಬಳಿಯಲ್ಲಿರುವ ಬಾವಿಯ ನೀರನ್ನು ನನಗೆ ಕುಡಿಯಲು ಕೊಡುವವನ್ಯಾರು,” ಎಂದು ಬಹು ಆಶೆಯಿಂದ ಹೇಳಿದನು. <verse eid="1CH 11:17"/><verse number="18" style="v" sid="1CH 11:18"/>ಆಗ ಆ ಮೂವರು ಫಿಲಿಷ್ಟಿಯರ ದಂಡಿನಲ್ಲಿ ನುಗ್ಗಿಹೋಗಿ, ಬೇತ್ಲೆಹೇಮಿನ ಬಾಗಿಲ ಬಳಿಯಲ್ಲಿರುವ ಬಾವಿಯ ನೀರನ್ನು ಸೇದಿ, ದಾವೀದನಿಗೆ ತೆಗೆದುಕೊಂಡು ಬಂದರು. ಆದರೆ ಅದನ್ನು ಅವನು ಕುಡಿಯದೇ ಯೆಹೋವ ದೇವರಿಗೆ ಸಮರ್ಪಿಸುವಂತೆ ನೆಲದ ಮೇಲೆ ಸುರಿದು, <verse eid="1CH 11:18"/><verse number="19" style="v" sid="1CH 11:19"/>“ದೇವರು ಇಂಥಾ ಕಾರ್ಯವನ್ನು ನನಗೆ ದೂರವಾಗಿ ಮಾಡಲಿ. ನಾನು ಈ ಮನುಷ್ಯರ ಪ್ರಾಣದ ರಕ್ತವನ್ನು ಕುಡಿಯಬಹುದೇ? ತಮ್ಮ ಪ್ರಾಣದಾಶೆ ತೊರೆದು ಈ ನೀರನ್ನು ತಂದರಲ್ಲಾ?” ಎಂದು ಹೇಳಿ ಕುಡಿಯಲೊಲ್ಲದೆ ಇದ್ದನು.</para>
  <para style="p" vid="1CH 11:19">ಇಂಥಾ ಮಹಾಕಾರ್ಯಗಳನ್ನು ಈ ಮೂರು ಮಂದಿ ಪರಾಕ್ರಮಶಾಲಿಗಳು ಮಾಡಿದರು.<verse eid="1CH 11:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="1CH 11:20"/>ಇದಲ್ಲದೆ ಯೋವಾಬನ ಸಹೋದರನಾದ ಅಬೀಷೈಯನು ಮೂರು ಮಂದಿಯಲ್ಲಿ ಮುಖ್ಯಸ್ಥನು. ಅವನು ಮುನ್ನೂರು ಮಂದಿಗೆ ವಿರೋಧವಾಗಿ ತನ್ನ ಈಟಿಯನ್ನು ಎತ್ತಿ ಅವರನ್ನು ಕೊಂದುಹಾಕಿದ್ದರಿಂದ, ಮೂವರಂತೆ ಹೆಸರುಗೊಂಡನು. <verse eid="1CH 11:20"/><verse number="21" style="v" sid="1CH 11:21"/>ಈ ಮೂವರಲ್ಲಿ ಅವನು ಇಬ್ಬರಿಗಿಂತ ಹೆಚ್ಚು ಘನವುಳ್ಳವನಾಗಿದ್ದನು, ಆದ್ದರಿಂದ ಅವನು ಅವರಲ್ಲಿ ಪ್ರಧಾನನಾದನು; ಆದರೂ ಆ ಮೊದಲಿನ ಮೂರು ಜನರಿಗೆ ಅವನು ಸಮಾನನಾಗಿರಲಿಲ್ಲ.<verse eid="1CH 11:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="1CH 11:22"/>ಕಬ್ಜಯೇಲನ ಪರಾಕ್ರಮಶಾಲಿಯ ಮೊಮ್ಮಗನೂ ಯೆಹೋಯಾದಾವನ ಮಗನೂ ಆದ ಬೆನಾಯನು ಅನೇಕ ಶೂರ ಕೃತ್ಯಗಳನ್ನು ಮಾಡಿದನು; ಅವನು ಬಲಶಾಲಿಯಾದ ಮೋವಾಬಿನ ಇಬ್ಬರು ಮನುಷ್ಯರನ್ನು ಕೊಂದನು. ಇದಲ್ಲದೆ ಹಿಮಕಾಲದಲ್ಲಿ ಕುಣಿಯೊಳಗೆ ಇಳಿದು ಒಂದು ಸಿಂಹವನ್ನು ಕೊಂದುಬಿಟ್ಟನು. <verse eid="1CH 11:22"/><verse number="23" style="v" sid="1CH 11:23"/>ಅವನು ಏಳುವರೆ ಅಡಿ ಎತ್ತರವಾಗಿದ್ದ ಒಬ್ಬ ಈಜಿಪ್ಟಿನವನನ್ನು ಹೊಡೆದುಬಿಟ್ಟನು; ಆ ಈಜಿಪ್ಟಿನವನ ಕೈಯಲ್ಲಿ ನೇಯ್ಗೆಗಾರರ ಕುಂಟೆಯಷ್ಟು ದಪ್ಪವಾದ ಒಂದು ಈಟಿ ಇದ್ದರೂ, ತಾನು ಒಂದು ಕೋಲು ಹಿಡಿದುಕೊಂಡು ಅವನ ಬಳಿಗೆ ಹೋಗಿ, ಈಜಿಪ್ಟಿನವನ ಕೈಯಲ್ಲಿದ್ದ ಈಟಿಯನ್ನು ಕಿತ್ತುಕೊಂಡು, ಅವನ ಈಟಿಯಿಂದಲೇ ಅವನನ್ನು ಕೊಂದುಹಾಕಿದನು. <verse eid="1CH 11:23"/><verse number="24" style="v" sid="1CH 11:24"/>ಇವುಗಳನ್ನು ಯೆಹೋಯಾದಾವನ ಮಗ ಬೆನಾಯನು ಮಾಡಿದ್ದರಿಂದ, ಮೂರು ಮಂದಿ ಪರಾಕ್ರಮಶಾಲಿಗಳಂತೆಯೇ ಹೆಸರುಗೊಂಡನು. <verse eid="1CH 11:24"/><verse number="25" style="v" sid="1CH 11:25"/>ಅವನು ಮೂವತ್ತು ಜನರಿಗಿಂತ ಹೆಚ್ಚು ಘನವುಳ್ಳವನಾಗಿದ್ದನು; ಆದರೆ ಆ ಮೊದಲಿನ ಮೂರು ಮಂದಿಯಲ್ಲಿ ಅವನನ್ನು ಸೇರಿಸಲಾಗಲಿಲ್ಲ; ದಾವೀದನು ಅವನನ್ನು ತನ್ನ ಮೈಗಾವಲಿನವರ ಮೇಲೆ ಯಜಮಾನನನ್ನಾಗಿ ಇಟ್ಟನು.<verse eid="1CH 11:25"/></para>
  <para style="b"/>
  <para style="li4">
    <verse number="26" style="v" sid="1CH 11:26"/>ಇದಲ್ಲದೆ ದಂಡುಗಳಲ್ಲಿರುವ ಪರಾಕ್ರಮಶಾಲಿಗಳು ಯಾರೆಂದರೆ:</para>
  <para style="b" vid="1CH 11:26"/>
  <para style="li1" vid="1CH 11:26">ಯೋವಾಬನ ಸಹೋದರನಾದ ಅಸಾಯೇಲನು;</para>
  <para style="li1" vid="1CH 11:26">ಬೇತ್ಲೆಹೇಮ್ ಊರಿನ ದೋದೋವಿನ ಮಗ ಎಲ್ಹನಾನನು;<verse eid="1CH 11:26"/></para>
  <para style="li1">
    <verse number="27" style="v" sid="1CH 11:27"/>ಹರೋರಿಯನಾದ ಶಮ್ಮೋತನು;</para>
  <para style="li1" vid="1CH 11:27">ಪೆಲೋನ್ಯನಾದ ಹೆಲೆಚನು;<verse eid="1CH 11:27"/></para>
  <para style="li1">
    <verse number="28" style="v" sid="1CH 11:28"/>ತೆಕೋವದ ಇಕ್ಕೇಷನ ಮಗನಾದ ಈರನು;</para>
  <para style="li1" vid="1CH 11:28">ಅನಾತೋತಿನವನಾದ ಅಬೀಯೆಜೆರನು;<verse eid="1CH 11:28"/></para>
  <para style="li1">
    <verse number="29" style="v" sid="1CH 11:29"/>ಹುಷಾ ಊರಿನವನಾದ ಸಿಬ್ಬೆಕೈ;</para>
  <para style="li1" vid="1CH 11:29">ಅಹೋಹ್ಯನಾದ ಈಲೈ;<verse eid="1CH 11:29"/></para>
  <para style="li1">
    <verse number="30" style="v" sid="1CH 11:30"/>ನೆಟೋಫದವನಾದ ಮಹರೈ;</para>
  <para style="li1" vid="1CH 11:30">ನೆಟೋಫದವನಾದ ಬಾಣನ ಮಗ ಹೆಲೇದ್;<verse eid="1CH 11:30"/></para>
  <para style="li1">
    <verse number="31" style="v" sid="1CH 11:31"/>ಬೆನ್ಯಾಮೀನ್ಯರಿಗೆ ಸೇರಿದ ಗಿಬೆಯ ಊರಿನ ರೀಬೈ ಎಂಬುವನ ಮಗನಾದ ಇತ್ತೈ,</para>
  <para style="li1" vid="1CH 11:31">ಪಿರಾತೋನ್ಯನಾದ ಬೆನಾಯನು;<verse eid="1CH 11:31"/></para>
  <para style="li1">
    <verse number="32" style="v" sid="1CH 11:32"/>ಹೊಳೆಗಳುಳ್ಳ ಗಾಷ್ ಊರಿನವನಾದ ಹೂರೈ;</para>
  <para style="li1" vid="1CH 11:32">ಅರಾಬಾ ತಗ್ಗಿನವನಾದ ಅಬೀಯೇಲನು;<verse eid="1CH 11:32"/></para>
  <para style="li1">
    <verse number="33" style="v" sid="1CH 11:33"/>ಬಹರೂಮ್ಯನಾದ ಅಜ್ಮಾವೆತನು;</para>
  <para style="li1" vid="1CH 11:33">ಶಾಲ್ಬೋನ್ಯನಾದ ಎಲೆಯಖ್ಬಾನು;<verse eid="1CH 11:33"/></para>
  <para style="li1">
    <verse number="34" style="v" sid="1CH 11:34"/>ಗೀಜೋನ್ಯನಾದ ಹಾಷೇಮನ ಪುತ್ರರು;</para>
  <para style="li1" vid="1CH 11:34">ಹರಾರ್ಯನಾದ ಶಾಗೇಯ ಮಗ ಯೋನಾತಾನನು;<verse eid="1CH 11:34"/></para>
  <para style="li1">
    <verse number="35" style="v" sid="1CH 11:35"/>ಹರಾರ್ಯನಾದ ಶಾಕಾರನ ಮಗನಾದ ಅಹೀಯಾಮನು;</para>
  <para style="li1" vid="1CH 11:35">ಊರನ ಮಗನಾದ ಎಲಿಫಾಲನು;<verse eid="1CH 11:35"/></para>
  <para style="li1">
    <verse number="36" style="v" sid="1CH 11:36"/>ಮೆಕೆರಾತಿಯನಾದ ಹೇಫೆರನು;</para>
  <para style="li1" vid="1CH 11:36">ಪೆಲೋನ್ಯನಾದ ಅಹೀಯನು;<verse eid="1CH 11:36"/></para>
  <para style="li1">
    <verse number="37" style="v" sid="1CH 11:37"/>ಕರ್ಮೇಲ್ಯನಾದ ಹೆಚ್ರೋ;</para>
  <para style="li1" vid="1CH 11:37">ಎಜ್ಬೈನ ಮಗನಾದ ನಾರಾಯಿ;<verse eid="1CH 11:37"/></para>
  <para style="li1">
    <verse number="38" style="v" sid="1CH 11:38"/>ನಾತಾನನ ಸಹೋದರನಾದ ಯೋಯೇಲನು;</para>
  <para style="li1" vid="1CH 11:38">ಹಗ್ರೀಯನ ಮಗನಾದ ಮಿಬ್ಹಾರನು;<verse eid="1CH 11:38"/></para>
  <para style="li1">
    <verse number="39" style="v" sid="1CH 11:39"/>ಅಮ್ಮೋನಿಯನಾದ ಚೆಲೆಕನು;</para>
  <para style="li1" vid="1CH 11:39">ಚೆರೂಯಳ ಮಗನಾದ ಯೋವಾಬನ ಆಯುಧವಾಹಕನು ಆಗಿದ್ದ ಬೇರೋತ್ಯನಾದ ನಹರೈ;<verse eid="1CH 11:39"/></para>
  <para style="li1">
    <verse number="40" style="v" sid="1CH 11:40"/>ಯೆತೆರಿಯನಾದ ಈರನು;</para>
  <para style="li1" vid="1CH 11:40">ಯೆತೆರಿಯನಾದ ಗಾರೇಬನು;<verse eid="1CH 11:40"/></para>
  <para style="li1">
    <verse number="41" style="v" sid="1CH 11:41"/>ಹಿತ್ತಿಯನಾದ ಊರೀಯನು;</para>
  <para style="li1" vid="1CH 11:41">ಅಹ್ಲಾಯಿಯ ಮಗನಾದ ಜಾಬಾದನು;<verse eid="1CH 11:41"/></para>
  <para style="li1">
    <verse number="42" style="v" sid="1CH 11:42"/>ರೂಬೇನ್ಯನಾದ ಶೀಜನ ಮಗನಾದ ಅದೀನನು; ಇವನು ರೂಬೇನ್ಯರಲ್ಲಿ ಅಧಿಪತಿಯಾಗಿದ್ದನು; ಮೂವತ್ತು ಮಂದಿ ಅವನ ಸಂಗಡ ಇದ್ದರು.<verse eid="1CH 11:42"/></para>
  <para style="li1">
    <verse number="43" style="v" sid="1CH 11:43"/>ಮಾಕನ ಮಗನಾದ ಹಾನಾನನು;</para>
  <para style="li1" vid="1CH 11:43">ಮೆತೆನದವನಾದ ಯೋಷಾಫಾಟ್;<verse eid="1CH 11:43"/></para>
  <para style="li1">
    <verse number="44" style="v" sid="1CH 11:44"/>ಅಷ್ಟೆರಾತ್ಯನಾದ ಉಜ್ಜೀಯ;</para>
  <para style="li1" vid="1CH 11:44">ಅರೋಯೇರಿನಾದ ಹೋತಾಮನ ಮಕ್ಕಳಾಗಿರುವ ಶಾಮಾ, ಯೆಹೀಯೇಲ್;<verse eid="1CH 11:44"/></para>
  <para style="li1">
    <verse number="45" style="v" sid="1CH 11:45"/>ಶಿಮ್ರಿಯ ಮಗನಾದ ಎದೀಗಯೇಲ್;</para>
  <para style="li1" vid="1CH 11:45">ಅವನ ಸಹೋದರನಾದ, ತೀಚೀಯನಾದ ಯೋಹ;<verse eid="1CH 11:45"/></para>
  <para style="li1">
    <verse number="46" style="v" sid="1CH 11:46"/>ಮಹಾವಿಯನಾದ ಎಲೀಯೇಲ್;</para>
  <para style="li1" vid="1CH 11:46">ಎಲ್ನಾಮನ ಮಕ್ಕಳಾದ ಯೆರೀಬೈ ಮತ್ತು</para>
  <para style="li1" vid="1CH 11:46">ಯೋಷವ್ಯ; ಮೋವಾಬ್ಯನಾದ ಇತ್ಮ;<verse eid="1CH 11:46"/></para>
  <para style="li1">
    <verse number="47" style="v" sid="1CH 11:47"/>ಎಲೀಯೇಲ್; ಓಬೇದ್; ಮೆಚೊಬಾಯದವನಾದ ಯಾಸೀಯೇಲ್.<verse eid="1CH 11:47"/></para>
  <chapter eid="1CH 11"/>
  <chapter number="12" style="c" sid="1CH 12"/>
  <para style="s1">ದಾವೀದನನ್ನು ಕೂಡಿಕೊಂಡ ಯುದ್ಧವೀರರು</para>
  <para style="li4">
    <verse number="1" style="v" sid="1CH 12:1"/>ಕೀಷನ ಮಗ ಸೌಲನ ನಿಮಿತ್ತ ದಾವೀದನು ಇನ್ನೂ ಬಚ್ಚಿಟ್ಟುಕೊಂಡಿರುವಾಗ, ಚಿಕ್ಲಗಿನಲ್ಲಿರುವ ದಾವೀದನ ಬಳಿಗೆ ಬಂದವರು ಇವರೇ. ಅವರು ಪರಾಕ್ರಮಶಾಲಿಗಳಲ್ಲಿ ಸೇರಿದವರೂ, ಯುದ್ಧಕ್ಕೆ ಸಹಾಯಕರೂ. <verse eid="1CH 12:1"/><verse number="2" style="v" sid="1CH 12:2"/>ಎಡಬಲ ಕೈಗಳಿಂದ ಕಲ್ಲುಗಳನ್ನು ಎಸೆಯಲೂ, ಬಿಲ್ಲುಗಳಿಂದ ಬಾಣಗಳನ್ನು ಎಸೆಯಲೂ, ಇವರು ಬೆನ್ಯಾಮೀನನ ಗೋತ್ರದ ಸೌಲನ ಸಂಬಂಧಿಕರೂ ಆಗಿದ್ದರು.<verse eid="1CH 12:2"/></para>
  <para style="b"/>
  <para style="li1">
    <verse number="3" style="v" sid="1CH 12:3"/>ಅವರ ಮುಖ್ಯಸ್ಥ ಅಹೀಗೆಜೆರ್, ಇವನ ನಂತರ ಯೋವಾಷ್. ಇವರಿಬ್ಬರೂ ಗಿಬೆಯ ಊರಿನ ಶೇಮಾನ ಪುತ್ರರು.</para>
  <para style="li1" vid="1CH 12:3">ಅಜ್ಮಾವೆತನ ಪುತ್ರರಾದ ಯೆಜಿಯೇಲ್ ಮತ್ತು ಪೆಲೆಟ್,</para>
  <para style="li1" vid="1CH 12:3">ಅನಾತೋತ್ ಊರಿನವರಾದ ಬೆರಾಕಾ, ಯೇಹು. <verse eid="1CH 12:3"/><verse number="4" style="v" sid="1CH 12:4"/>ಗಿಬ್ಯೋನ್ಯನಾದ ಇಷ್ಮಾಯನು ಮೂವತ್ತು ಮಂದಿಯಲ್ಲಿ ಪರಾಕ್ರಮಶಾಲಿಯಾಗಿದ್ದ ಮತ್ತು ಮೂವತ್ತು ಮಂದಿಯ ಮುಖ್ಯಸ್ಥನಾಗಿದ್ದ;</para>
  <para style="li1" vid="1CH 12:4">ಯೆರೆಮೀಯ, ಯಹಜಿಯೇಲ್, ಯೋಹಾನಾನ್, ಗೆದೇರದವನಾದ ಯೋಜಾಬಾದ್, <verse eid="1CH 12:4"/><verse number="5" style="v" sid="1CH 12:5"/>ಎಲ್ಲೂಜೈ, ಯೆರೀಮೋತ್, ಬೆಯಲ್ಯ, ಶೆಮರ್ಯ, ಹರುಫ್ಯನಾದ ಶೆಫಟ್ಯ,<verse eid="1CH 12:5"/></para>
  <para style="li1">
    <verse number="6" style="v" sid="1CH 12:6"/>ಕೋರಹಿಯರಾದ ಎಲ್ಕಾನ, ಇಷ್ಷೀಯ, ಅಜರಯೇಲ್, ಯೋವೆಜೆರ್, ಯಾಷೊಬ್ಬಾಮ,<verse eid="1CH 12:6"/></para>
  <para style="li1">
    <verse number="7" style="v" sid="1CH 12:7"/>ಗೆದೋರಿನಲ್ಲಿರುವ ಯೆರೋಹಾಮನ ಪುತ್ರರಾದ ಯೋಯೇಲಹ, ಜೆಬದ್ಯ.<verse eid="1CH 12:7"/></para>
  <para style="b"/>
  <para style="p">
    <verse number="8" style="v" sid="1CH 12:8"/>ಇದಲ್ಲದೆ ಮರುಭೂಮಿಯಲ್ಲಿ ಬಲವಾದ ಸ್ಥಳದಲ್ಲಿರುವ ದಾವೀದನ ಬಳಿಯಲ್ಲಿ ತಮ್ಮನ್ನು ಪ್ರತ್ಯೇಕಿಸಿಕೊಂಡಿದ್ದ ಗಾದ್ಯರು ಇದ್ದರು. ಇವರು ಖೇಡ್ಯವನ್ನೂ, ಭಲ್ಲೆಯನ್ನೂ ಹಿಡಿದು ಪರಾಕ್ರಮಶಾಲಿಗಳಾಗಿಯೂ, ಯುದ್ಧಕ್ಕೆ ತಕ್ಕ ಸೈನಿಕರಾಗಿಯೂ ಇದ್ದರು. ಅವರ ಮುಖಗಳು ಸಿಂಹಗಳಂತೆ ಭೀಕರವಾಗಿದ್ದವು. ಪರ್ವತಗಳ ಮೇಲೆ ಇವರು ಜಿಂಕೆಗಳ ಹಾಗೆ ವೇಗವುಳ್ಳವರಾಗಿದ್ದರು.<verse eid="1CH 12:8"/></para>
  <para style="b"/>
  <para style="li1">
    <verse number="9" style="v" sid="1CH 12:9"/>ಅಧಿಕಾರದಲ್ಲಿ ಏಜೆರ್ ಮುಖ್ಯಸ್ಥನು;</para>
  <para style="li1" vid="1CH 12:9">ಎರಡನೆಯವನು ಓಬದ್ಯ; ಮೂರನೆಯವನು ಎಲೀಯಾಬ್;<verse eid="1CH 12:9"/></para>
  <para style="li1">
    <verse number="10" style="v" sid="1CH 12:10"/>ನಾಲ್ಕನೆಯವನು ಮಿಷ್ಮನ್ನ, ಐದನೆಯವನು ಯೆರೆಮೀಯ;<verse eid="1CH 12:10"/></para>
  <para style="li1">
    <verse number="11" style="v" sid="1CH 12:11"/>ಆರನೆಯವನು ಅತ್ತೈ; ಏಳನೆಯವನು ಎಲೀಯೇಲ್;<verse eid="1CH 12:11"/></para>
  <para style="li1">
    <verse number="12" style="v" sid="1CH 12:12"/>ಎಂಟನೆಯವನು ಯೋಹಾನಾನ್, ಒಂಬತ್ತನೆಯವನು ಎಲ್ಜಾಬಾದ್;<verse eid="1CH 12:12"/></para>
  <para style="li1">
    <verse number="13" style="v" sid="1CH 12:13"/>ಹತ್ತನೆಯವನು ಯೆರೆಮೀಯ; ಹನ್ನೊಂದನೆಯವನು ಮಕ್ಬನ್ನೈ.<verse eid="1CH 12:13"/></para>
  <para style="b"/>
  <para style="p">
    <verse number="14" style="v" sid="1CH 12:14"/>ಗಾದನ ಪುತ್ರರಾದ ಇವರು ಸೈನ್ಯದಲ್ಲಿ ಅಧಿಪತಿಗಳಾಗಿದ್ದರು. ಕಿರಿಯನು ನೂರು ಮಂದಿಯ ಮೇಲೆಯೂ ಹಿರಿಯನು ಸಾವಿರ ಮಂದಿಯ ಮೇಲೆಯೂ ಇದ್ದರು. <verse eid="1CH 12:14"/><verse number="15" style="v" sid="1CH 12:15"/>ಇವರು ಮೊದಲನೆಯ ತಿಂಗಳಲ್ಲಿ ಯೊರ್ದನ್ ಹೊಳೆ ದಡಮೀರಿ ಹರಿಯುತ್ತಿದ್ದಾಗ, ಅದನ್ನು ದಾಟಿ ಪೂರ್ವ ಕಡೆಯಲ್ಲಿಯೂ, ಪಶ್ಚಿಮ ಕಡೆಯಲ್ಲಿಯೂ ತಗ್ಗುಗಳಲ್ಲಿ ಇರುವವರೆಲ್ಲರನ್ನು ಓಡಿಸಿಬಿಟ್ಟರು.<verse eid="1CH 12:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="1CH 12:16"/>ಬೆನ್ಯಾಮೀನನ ಮತ್ತು ಯೆಹೂದ್ಯರಲ್ಲಿ ಕೆಲವರು ಕೋಟೆಯ ಸ್ಥಳದಲ್ಲಿದ್ದ ದಾವೀದನ ಬಳಿಗೆ ಬಂದರು. <verse eid="1CH 12:16"/><verse number="17" style="v" sid="1CH 12:17"/>ಆಗ ದಾವೀದನು ಅವರನ್ನು ಎದುರುಗೊಳ್ಳಲು ಹೊರಟುಹೋಗಿ ಅವರಿಗೆ ಉತ್ತರವಾಗಿ, “ನನಗೆ ಸಹಾಯವಾಗಿ ನನ್ನ ಬಳಿಗೆ ನೀವು ಸಮಾಧಾನವಾಗಿ ಬಂದರೆ, ನನ್ನ ಹೃದಯವು ನಿಮ್ಮ ಸಂಗಡ ಒಂದಾಗಿರುವುದು. ಆದರೆ ದೋಷವು ನನ್ನ ಕೈಯಲ್ಲಿ ಇಲ್ಲದಿರುವಾಗ, ನೀವು ನನ್ನ ವೈರಿಗಳಿಗೆ ನನ್ನನ್ನು ಮೋಸದಿಂದ ಒಪ್ಪಿಸಿಕೊಡಲು ಬಂದರೆ, ನಮ್ಮ ಪಿತೃಗಳ ದೇವರು ನೋಡಿ ನ್ಯಾಯತೀರಿಸಲಿ,” ಎಂದನು.<verse eid="1CH 12:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="1CH 12:18"/>ಆಗ ಆತ್ಮವು ಮೂವತ್ತು ಮಂದಿ ಅಧಿಪತಿಗಳ ಮುಖ್ಯಸ್ಥನಾದ ಅಮಾಸೈಯ ಮೇಲೆ ಬಂತು. ಅವನು ಹೀಗೆ ಹೇಳಿದನು,</para>
  <para style="q1" vid="1CH 12:18">“ದಾವೀದನೇ, ನಾವು ನಿನ್ನವರು.</para>
  <para style="q2" vid="1CH 12:18">ಇಷಯನ ಮಗನೇ, ನಾವು ನಿನ್ನ ಜೊತೆಯಿದ್ದೇವೆ;</para>
  <para style="q1" vid="1CH 12:18">ಜಯವು ನಿನ್ನದೇ,</para>
  <para style="q2" vid="1CH 12:18">ನಿನಗೆ ಸಹಾಯ ಮಾಡುವವರಿಗೆ ಜಯವು;</para>
  <para style="q3" vid="1CH 12:18">ಏಕೆಂದರೆ ನಿನ್ನ ದೇವರು ನಿನಗೆ ಸಹಾಯ ಮಾಡುತ್ತಾರೆ.”</para>
  <para style="p" vid="1CH 12:18">ಆಗ ದಾವೀದನು ಅವರನ್ನು ಅಂಗೀಕರಿಸಿ, ಅವರನ್ನು ದಂಡಿನ ಅಧಿಪತಿಗಳಾಗಿ ಮಾಡಿದನು.<verse eid="1CH 12:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="1CH 12:19"/>ದಾವೀದನು ಸೌಲನ ಮೇಲೆ ಯುದ್ಧಮಾಡಲು ಫಿಲಿಷ್ಟಿಯರ ಸಂಗಡ ಬರುತ್ತಿರುವಾಗ, ಮನಸ್ಸೆಯವರಲ್ಲಿ ಕೆಲವರು ದಾವೀದನ ಕಡೆಗೆ ಸೇರಿದರು. ಆದರೆ ಇವರು ಅವರಿಗೆ ಸಹಾಯ ಕೊಡದೆ ಇದ್ದರು. ಏಕೆಂದರೆ ಫಿಲಿಷ್ಟಿಯರ ಅಧಿಪತಿಗಳು ಯೋಚನೆ ಮಾಡಿದ ತರುವಾಯ, “ಅವನು ನಮಗೆ ಮೋಸಮಾಡಿ, ತನ್ನ ಯಜಮಾನನಾದ ಸೌಲನ ಕಡೆಗೆ ಸೇರಿದರೆ, ನಮ್ಮ ತಲೆಗಳು ಬಿದ್ದು ಹೋಗುವುವು,” ಎಂದು ಹೇಳಿ ಅವನನ್ನು ಕಳುಹಿಸಿಬಿಟ್ಟರು. <verse eid="1CH 12:19"/><verse number="20" style="v" sid="1CH 12:20"/>ದಾವೀದನು ಹಿಂದಿರುಗಿ ಚಿಕ್ಲಗಿಗೆ ಹಿಂದಿರುಗುತ್ತಿದ್ದಾಗ ಅವನೊಂದಿಗೆ ಮನಸ್ಸೆ ಗೋತ್ರದ ಸಹಸ್ರಾಧಿಪತಿಗಳಾದ ಅದ್ನ, ಯೋಜಾಬಾದ್, ಎದೀಗಯೇಲ್, ಮೀಕಾಯೇಲ್, ಯೋಜಾಬಾದ್, ಎಲೀಹು, ಚಿಲ್ಲೆತೈ ಎಂಬವರು ಬಂದು ಸೇರಿಕೊಂಡರು. <verse eid="1CH 12:20"/><verse number="21" style="v" sid="1CH 12:21"/>ಇವರು ಗುಂಪಿಗೆ ವಿರೋಧವಾಗಿ ದಾವೀದನಿಗೆ ಸಹಾಯಕರಾಗಿದ್ದರು; ಅವರೆಲ್ಲರೂ ಬಲವುಳ್ಳ ಪರಾಕ್ರಮಶಾಲಿಗಳಾಗಿಯೂ ದಂಡಿನ ಪ್ರಧಾನರಾಗಿಯೂ ಇದ್ದರು. <verse eid="1CH 12:21"/><verse number="22" style="v" sid="1CH 12:22"/>ಅದೇ ಕಾಲದಲ್ಲಿ ದಿನೇ ದಿನೇ ದೊಡ್ಡ ಸೈನ್ಯವು ದೇವರ ಸೈನ್ಯದ ಹಾಗೆ ಆಗುವವರೆಗೆ, ದಾವೀದನಿಗೆ ಸಹಾಯ ಕೊಡುವುದಕ್ಕೆ ಅವನ ಕಡೆಗೆ ಬರುತ್ತಿದ್ದರು.<verse eid="1CH 12:22"/></para>
  <para style="s1">ಇತರರು ದಾವೀದನನ್ನು ಹೆಬ್ರೋನಿನಲ್ಲಿ ಸೇರಿಕೊಂಡದ್ದು</para>
  <para style="li4">
    <verse number="23" style="v" sid="1CH 12:23"/>ಯೆಹೋವ ದೇವರ ವಾಕ್ಯದ ಪ್ರಕಾರ ಸೌಲನ ರಾಜ್ಯವನ್ನು ದಾವೀದನ ಕಡೆಗೆ ತಿರುಗಿಸುವುದಕ್ಕೆ, ಹೆಬ್ರೋನಿನಲ್ಲಿರುವ ದಾವೀದನ ಬಳಿಗೆ ಯುದ್ಧಕ್ಕೆ ಆಯುಧಗಳನ್ನು ಧರಿಸಿಕೊಂಡು ಬಂದ ದಂಡುಗಳ ಸಂಖ್ಯೆ ಇದು:<verse eid="1CH 12:23"/></para>
  <para style="b"/>
  <para style="li1">
    <verse number="24" style="v" sid="1CH 12:24"/>ಖೇಡ್ಯವನ್ನೂ, ಭಲ್ಲೆಯನ್ನೂ ಹಿಡಿದುಕೊಂಡು, ಯುದ್ಧಕ್ಕೆ ಸಿದ್ಧರಾದ ಯೆಹೂದನ ಮಕ್ಕಳು 6,800 ಮಂದಿ.<verse eid="1CH 12:24"/></para>
  <para style="li1">
    <verse number="25" style="v" sid="1CH 12:25"/>ಯುದ್ಧಕ್ಕೆ ಪರಾಕ್ರಮಶಾಲಿಗಳಾದ ಸಿಮೆಯೋನನ ಮಕ್ಕಳಲ್ಲಿ 7,100 ಮಂದಿ.<verse eid="1CH 12:25"/></para>
  <para style="li1">
    <verse number="26" style="v" sid="1CH 12:26"/>ಲೇವಿಯ ಮಕ್ಕಳಲ್ಲಿ 4,600 ಮಂದಿ. <verse eid="1CH 12:26"/><verse number="27" style="v" sid="1CH 12:27"/>ಆರೋನಿಯರಲ್ಲಿ ಯೆಹೋಯಾದಾವನು ನಾಯಕನಾಗಿದ್ದನು. ಅವನ ಸಂಗಡ 3,700 ಮಂದಿ. <verse eid="1CH 12:27"/><verse number="28" style="v" sid="1CH 12:28"/>ಇದಲ್ಲದೆ ಬಲವುಳ್ಳ ಪರಾಕ್ರಮಶಾಲಿಯಾದ ಪ್ರಾಯಸ್ತನಾಗಿದ್ದ ಚಾದೋಕನೂ, ಅವನ ತಂದೆಯ ಮನೆಯಿಂದ 22 ಮಂದಿ ಪ್ರಧಾನರೂ.<verse eid="1CH 12:28"/></para>
  <para style="li1">
    <verse number="29" style="v" sid="1CH 12:29"/>ಸೌಲನ ಸಹೋದರರಾಗಿರುವ ಬೆನ್ಯಾಮೀನನ ಮಕ್ಕಳಲ್ಲಿ 3,000 ಮಂದಿ. ಇಂದಿನವರೆಗೂ ಅವರಲ್ಲಿ ಅನೇಕರು ಸೌಲನ ಮನೆಯ ವಿಚಾರಣೆಯನ್ನು ಮಾಡುತ್ತಿದ್ದರು.<verse eid="1CH 12:29"/></para>
  <para style="li1">
    <verse number="30" style="v" sid="1CH 12:30"/>ಎಫ್ರಾಯೀಮನ ಮಕ್ಕಳಲ್ಲಿ 20,800 ಮಂದಿ, ಬಲವುಳ್ಳ ಪರಾಕ್ರಮಶಾಲಿಗಳೂ, ತಮ್ಮ ಪಿತೃಗಳ ಮನೆಯಲ್ಲಿ ಹೆಸರುಗೊಂಡವರೂ ಆಗಿದ್ದರು.<verse eid="1CH 12:30"/></para>
  <para style="li1">
    <verse number="31" style="v" sid="1CH 12:31"/>ಮನಸ್ಸೆಯ ಅರ್ಧಗೋತ್ರದಲ್ಲಿ 18,000 ಮಂದಿ. ಅವರು ದಾವೀದನನ್ನು ಅರಸನಾಗಿ ಮಾಡಲು ಬಂದವರ ಹೆಸರು ಹೆಸರಾಗಿ ಹೇಳಲು ಆಯ್ಕೆಯಾದವರು.<verse eid="1CH 12:31"/></para>
  <para style="li1">
    <verse number="32" style="v" sid="1CH 12:32"/>ಇಸ್ಸಾಕಾರನ ಮಕ್ಕಳಲ್ಲಿ ಇಸ್ರಾಯೇಲರು ಮಾಡತಕ್ಕದ್ದು ಯಾವುದೆಂದು ತಿಳಿಯತಕ್ಕಂಥ ಕಾಲಗಳನ್ನು ಪರೀಕ್ಷಿಸಿ ತಿಳಿದವರು ಬಂದರು. ಅವರ ಯಜಮಾನರು 200 ಮಂದಿಯಾಗಿದ್ದರು. ಅವರ ಸಹೋದರರೆಲ್ಲರು ಇವರ ಆಜ್ಞಾಧೀನರಾಗಿದ್ದರು.<verse eid="1CH 12:32"/></para>
  <para style="li1">
    <verse number="33" style="v" sid="1CH 12:33"/>ಜೆಬುಲೂನನವರಲ್ಲಿ ದೃಢಹೃದಯದಿಂದ ಸಾಲಾಗಿ ನಡೆಯುವ ಸಕಲ ಆಯುಧಗಳನ್ನು ಧರಿಸಿಕೊಂಡ ಯುದ್ಧ ನಿಪುಣರಾದ ಸೈನ್ಯವಾಗಿ ಹೊರಡುವವರು 50,000 ಮಂದಿ.<verse eid="1CH 12:33"/></para>
  <para style="li1">
    <verse number="34" style="v" sid="1CH 12:34"/>ನಫ್ತಾಲಿಯವರಲ್ಲಿ 1,000 ಜನ ನಾಯಕರೂ ಗುರಾಣಿಬರ್ಜಿಗಳನ್ನು ಹಿಡಿದಿರುವ 37,000 ಸೈನಿಕರೂ<verse eid="1CH 12:34"/></para>
  <para style="li1">
    <verse number="35" style="v" sid="1CH 12:35"/>ದಾನನವರಲ್ಲಿ 28,600 ಮಂದಿ ಯುದ್ಧ ನಿಪುಣರು.<verse eid="1CH 12:35"/></para>
  <para style="li1">
    <verse number="36" style="v" sid="1CH 12:36"/>ಆಶೇರನವರಲ್ಲಿ ಯುದ್ಧಕ್ಕೆ ಹೋಗತಕ್ಕ ಹಾಗೆ ಯುದ್ಧ ನಿಪುಣರು ಸೈನ್ಯವಾಗಿ ಹೋಗುವವರು 40,000 ಮಂದಿ.<verse eid="1CH 12:36"/></para>
  <para style="li1">
    <verse number="37" style="v" sid="1CH 12:37"/>ಯೊರ್ದನ್ ನದಿ ಆಚೆಯಲ್ಲಿರುವ ರೂಬೇನ್ಯರಲ್ಲಿಯೂ, ಗಾದ್ಯರಲ್ಲಿಯೂ, ಮನಸ್ಸೆಯ ಅರ್ಧ ಗೋತ್ರದಲ್ಲಿಯೂ ಯುದ್ಧಕ್ಕೆ ತಕ್ಕಂಥ ಸಕಲ ಆಯುಧಗಳನ್ನು ಧರಿಸಿಕೊಂಡವರು 1,20,000 ಮಂದಿ.<verse eid="1CH 12:37"/></para>
  <para style="b"/>
  <para style="li4">
    <verse number="38" style="v" sid="1CH 12:38"/>ಯುದ್ಧಕ್ಕೆ ಸಿದ್ಧರಾದ ಈ ಸಮಸ್ತ ಸೈನಿಕರು ದಾವೀದನನ್ನು ಸಮಸ್ತ ಇಸ್ರಾಯೇಲರ ಮೇಲೆ ಅರಸನಾಗಿ ಮಾಡಲು ಹೆಬ್ರೋನಿಗೆ ಪೂರ್ಣಮನಸ್ಸಿನಿಂದ ಬಂದರು.</para>
  <para style="b" vid="1CH 12:38"/>
  <para style="p" vid="1CH 12:38">ಇದಲ್ಲದೆ ಇಸ್ರಾಯೇಲಿನಲ್ಲಿದ್ದ ಮಿಕ್ಕಾದವರೆಲ್ಲರು ದಾವೀದನನ್ನು ಅರಸನಾಗಿ ಮಾಡಲು ಒಂದೇ ಮನಸ್ಸುಳ್ಳವರಾಗಿದ್ದರು. <verse eid="1CH 12:38"/><verse number="39" style="v" sid="1CH 12:39"/>ಅವರು ಅಲ್ಲಿ ದಾವೀದನ ಸಂಗಡ ಮೂರು ದಿವಸ ಅವರ ಕುಟುಂಬದವರು ಅವರಿಗೋಸ್ಕರ ಸಿದ್ಧಮಾಡಿದ ಆಹಾರವನ್ನು ತಿನ್ನುತ್ತಾ, ಕುಡಿಯುತ್ತಾ ಇದ್ದರು. <verse eid="1CH 12:39"/><verse number="40" style="v" sid="1CH 12:40"/>ಇದಲ್ಲದೆ ಅವರ ನೆರೆಯವನಾದ ಇಸ್ಸಾಕಾರ್, ಜೆಬುಲೂನ್, ನಫ್ತಾಲಿಯರು ಮೊದಲುಗೊಂಡು ಎಲ್ಲರೂ ತಮ್ಮ ಎತ್ತು, ಕತ್ತೆ, ಹೇಸರಗತ್ತೆ ಮತ್ತು ಒಂಟೆಗಳ ಮೇಲೆಯೂ ರೊಟ್ಟಿಗಳನ್ನೂ ಆಹಾರವನ್ನೂ, ಹಿಟ್ಟನ್ನೂ ಅಂಜೂರದ ಉಂಡೆಗಳನ್ನೂ ಒಣಗಿದ ದ್ರಾಕ್ಷಿ ಗೊಂಚಲುಗಳನ್ನೂ ದ್ರಾಕ್ಷಾರಸವನ್ನೂ ಎಣ್ಣೆಯನ್ನೂ ದನಕುರಿಗಳನ್ನೂ ಬಹಳವಾಗಿ ತಂದರು. ಇಸ್ರಾಯೇಲಿನಲ್ಲಿ ಸಂತೋಷವಿತ್ತು.<verse eid="1CH 12:40"/></para>
  <chapter eid="1CH 12"/>
  <chapter number="13" style="c" sid="1CH 13"/>
  <para style="s1">ಮಂಜೂಷವನ್ನು ತಿರುಗಿ ತಂದದ್ದು</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 13:1"/>ದಾವೀದನು ಸಾವಿರ ಮಂದಿಗೂ, ನೂರು ಮಂದಿಗೂ ಪ್ರಧಾನರಾದವರ ಸಂಗಡ, ಎಲ್ಲಾ ನಾಯಕರ ಸಂಗಡ ಆಲೋಚನೆ ಮಾಡಿದನು. <verse eid="1CH 13:1"/><verse number="2" style="v" sid="1CH 13:2"/>ದಾವೀದನು ಇಸ್ರಾಯೇಲಿನ ಸಮಸ್ತ ಜನರಿಗೆ, “ನಿಮಗೆ ಒಳ್ಳೆಯದಾಗಿ ಕಂಡರೆ, ನಮ್ಮ ದೇವರಾದ ಯೆಹೋವ ದೇವರ ಚಿತ್ತವಾದರೆ, ನಮ್ಮ ಬಳಿಯಲ್ಲಿ ಕೂಡಿಬರುವ ಹಾಗೆ ಇಸ್ರಾಯೇಲಿನ ದೇಶವೆಲ್ಲದರಲ್ಲಿ ಉಳಿದಿರುವ ನಮ್ಮ ಸಹೋದರರನ್ನೂ, ತಮ್ಮ ಪಟ್ಟಣಗಳಲ್ಲಿ ಮತ್ತು ಉಪನಗರಗಳಲ್ಲಿ ಇರುವ ಯಾಜಕರನ್ನೂ, ಲೇವಿಯರನ್ನೂ ಎಲ್ಲಾ ಕಡೆಯಿಂದ ಕರೆಯಕಳುಹಿಸಿ, <verse eid="1CH 13:2"/><verse number="3" style="v" sid="1CH 13:3"/>ನಮ್ಮ ದೇವರ ಮಂಜೂಷವನ್ನು ನಮ್ಮ ಬಳಿಗೆ ತಿರುಗಿ ತರಿಸೋಣ. ಸೌಲನ ದಿವಸಗಳಲ್ಲಿ ಅದನ್ನು ವಿಚಾರಿಸಲಿಲ್ಲ,” ಎಂದನು. <verse eid="1CH 13:3"/><verse number="4" style="v" sid="1CH 13:4"/>ಹಾಗೆಯೇ ಮಾಡೋಣ ಎಂದು ಕೂಟದವರೆಲ್ಲರೂ ಹೇಳಿದರು. ಏಕೆಂದರೆ ಆ ಕಾರ್ಯವು ಸಮಸ್ತ ಜನರ ದೃಷ್ಟಿಗೆ ಯುಕ್ತವಾಗಿತ್ತು.<verse eid="1CH 13:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="1CH 13:5"/>ಹೀಗೆ ದೇವರ ಮಂಜೂಷವನ್ನು ಕಿರ್ಯತ್ ಯಾರೀಮಿನಿಂದ ತರುವುದಕ್ಕೆ ದಾವೀದನು ಈಜಿಪ್ಟಿನ ಶೀಹೋರ್ ನದಿ ಮೊದಲ್ಗೊಂಡು ಲಿಬೋ ಹಮಾತಿನ ಪ್ರದೇಶದವರೆಗೆ ಇರುವ ಸಮಸ್ತ ಇಸ್ರಾಯೇಲರನ್ನು ಕೂಡಿಸಿದನು. <verse eid="1CH 13:5"/><verse number="6" style="v" sid="1CH 13:6"/>ಆಗ ಕೆರೂಬಿಗಳ ನಡುವೆ ವಾಸವಾಗಿರುವ ಯೆಹೋವ ದೇವರ ಹೆಸರಿನಿಂದ ಕರೆಯಲಾದ ದೇವರ ಮಂಜೂಷವನ್ನು ತೆಗೆದುಕೊಂಡು ಬರಲು, ದಾವೀದನೂ, ಸಮಸ್ತ ಇಸ್ರಾಯೇಲರೂ ಯೆಹೂದಕ್ಕೆ ಸೇರಿದ ಕಿರ್ಯತ್ ಯಾರೀಮಿನ ಬಾಲಾ ಎಂಬಲ್ಲಿಗೆ ಹೋದರು.<verse eid="1CH 13:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="1CH 13:7"/>ಅವರು ಅಬೀನಾದಾಬನ ಮನೆಯೊಳಗಿಂದ ದೇವರ ಮಂಜೂಷವನ್ನು ತೆಗೆದುಕೊಂಡು, ಅದನ್ನು ಹೊಸ ಬಂಡಿಯ ಮೇಲೆ ಏರಿಸಿದರು. ಉಜ್ಜನು ಹಾಗೂ ಅಹಿಯೋವನು ಆ ಹೊಸ ಬಂಡಿಯನ್ನು ನಡೆಸಿದರು. <verse eid="1CH 13:7"/><verse number="8" style="v" sid="1CH 13:8"/>ಆಗ ದಾವೀದನೂ, ಸಮಸ್ತ ಇಸ್ರಾಯೇಲರೂ ಸಕಲ ವಾದ್ಯಗಳಾದ ಕಿನ್ನರಿ, ವೀಣೆ, ದಮ್ಮಡಿ, ತಾಳ, ತುತೂರಿ ಇವುಗಳನ್ನು ತಮ್ಮ ಸಮಸ್ತ ಬಲದಿಂದ ಬಾರಿಸುತ್ತಾ, ಹಾಡುತ್ತಾ ದೇವರ ಮುಂದೆ ಹೋದರು.<verse eid="1CH 13:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="1CH 13:9"/>ಆದರೆ ಅವರು ಕಿದೋನನ ಕಣದ ಬಳಿಗೆ ಬಂದಾಗ, ಎತ್ತುಗಳು ಎಡವಿದ್ದರಿಂದ ಉಜ್ಜನು ತನ್ನ ಕೈಚಾಚಿ ದೇವರ ಮಂಜೂಷವನ್ನು ಹಿಡಿದನು. <verse eid="1CH 13:9"/><verse number="10" style="v" sid="1CH 13:10"/>ಉಜ್ಜನು ಮಂಜೂಷದ ಮೇಲೆ ಕೈ ಹಾಕಿದ್ದರಿಂದ ಯೆಹೋವ ದೇವರು ಉಜ್ಜನ ಮೇಲೆ ಕೋಪಗೊಂಡು ಅವನನ್ನು ಶಿಕ್ಷಿಸಿದರು. ಅವನು ಅಲ್ಲಿಯೇ ದೇವರ ಮುಂದೆ ಮರಣಹೊಂದಿದನು.<verse eid="1CH 13:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="1CH 13:11"/>ಯೆಹೋವ ದೇವರು ಉಜ್ಜನನ್ನು ಶಿಕ್ಷಿಸಿದ್ದರಿಂದ ದಾವೀದನು ಕೋಪಗೊಂಡು ಆ ಸ್ಥಳಕ್ಕೆ ಪೆರೆಚ್ ಉಜ್ಜ ಎಂದು ಹೆಸರಿಟ್ಟನು, ಇಂದಿನವರೆಗೂ ಆ ಸ್ಥಳಕ್ಕೆ ಪೆರೆಚ್ ಉಜ್ಜ<note caller="+" style="f"><char style="fr" closed="false">13:11 </char><char style="fq" closed="false">ಪೆರೆಚ್ ಉಜ್ಜ </char><char style="ft" closed="false">ಅರ್ಥ </char><char style="fqa" closed="false">ಉಜ್ಜನ ವಿರುದ್ಧ ಸಿಡಿದೇಳುವುದು</char></note> ಎಂದು ಕರೆಯಲಾಗುತ್ತದೆ.<verse eid="1CH 13:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="1CH 13:12"/>ದಾವೀದನು ಆ ದಿನ ಯೆಹೋವ ದೇವರಿಗೆ ಭಯಪಟ್ಟು, “ದೇವರ ಮಂಜೂಷವನ್ನು ನಾನಿರುವಲ್ಲಿಗೆ ಹೇಗೆ ತೆಗೆದುಕೊಂಡು ಹೋಗುವದು?” ಎಂದನು. <verse eid="1CH 13:12"/><verse number="13" style="v" sid="1CH 13:13"/>ಹಾಗೆಯೇ ದಾವೀದನು ಮಂಜೂಷವನ್ನು ದಾವೀದನ ಪಟ್ಟಣಕ್ಕೆ ತನ್ನ ಬಳಿಗೆ ಸೇರಿಸಿಕೊಳ್ಳದೆ, ಗಿತ್ತೀಯನಾದ ಓಬೇದ್ ಏದೋಮನ ಮನೆಗೆ ತೆಗೆದುಕೊಂಡು ಹೋದನು. <verse eid="1CH 13:13"/><verse number="14" style="v" sid="1CH 13:14"/>ದೇವರ ಮಂಜೂಷವು ಓಬೇದ್ ಏದೋಮನ ಮನೆಯಲ್ಲಿ ಮೂರು ತಿಂಗಳು ಇದ್ದುದರಿಂದ, ಯೆಹೋವ ದೇವರು ಓಬೇದ್ ಎದೋಮನನ್ನೂ, ಅವನ ಮನೆಯವರೆಲ್ಲರನ್ನೂ, ಅವನಿಗಿದ್ದದ್ದೆಲ್ಲವನ್ನೂ ಆಶೀರ್ವದಿಸಿದರು.<verse eid="1CH 13:14"/></para>
  <chapter eid="1CH 13"/>
  <chapter number="14" style="c" sid="1CH 14"/>
  <para style="s1">ದಾವೀದನ ಅರಮನೆ ಹಾಗೂ ಕುಟುಂಬ</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 14:1"/>ಟೈರಿನ ಅರಸನಾದ ಹೀರಾಮನು ದಾವೀದನಿಗೆ ಅರಮನೆಯನ್ನು ಕಟ್ಟುವುದಕ್ಕೋಸ್ಕರ ದೂತರನ್ನು, ದೇವದಾರು ಮರಗಳನ್ನು, ಬಡಗಿಯವರನ್ನು ಮತ್ತು ಕಲ್ಲುಕುಟಿಗರನ್ನು ಕಳುಹಿಸಿದನು. <verse eid="1CH 14:1"/><verse number="2" style="v" sid="1CH 14:2"/>ಆಗ ದಾವೀದನು, ತನ್ನನ್ನು ಯೆಹೋವ ದೇವರು ಇಸ್ರಾಯೇಲಿನ ಮೇಲೆ ಅರಸನನ್ನಾಗಿ ಸ್ಥಿರಪಡಿಸಿದರೆಂದೂ, ತಮ್ಮ ಜನರಾದ ಇಸ್ರಾಯೇಲರ ನಿಮಿತ್ತ ತನ್ನ ರಾಜ್ಯವನ್ನು ಉನ್ನತಕ್ಕೇರಿಸಿದರೆಂದೂ ತಿಳಿದುಕೊಂಡನು.<verse eid="1CH 14:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="1CH 14:3"/>ದಾವೀದನು ಯೆರೂಸಲೇಮಿನಲ್ಲಿ ಸಹ ಕೆಲವು ಸ್ತ್ರೀಯರನ್ನು ಮದುವೆಮಾಡಿಕೊಂಡನು. ಇನ್ನೂ ಹೆಚ್ಚು ಪುತ್ರ, ಪುತ್ರಿಯರನ್ನೂ ಪಡೆದನು. <verse eid="1CH 14:3"/><verse number="4" style="v" sid="1CH 14:4"/>ಯೆರೂಸಲೇಮಿನಲ್ಲಿ ಅವನಿಗೆ ಹುಟ್ಟಿದ ಮಕ್ಕಳ ಹೆಸರುಗಳು: ಶಮ್ಮೂವ, ಶೋಬಾಬ್, ನಾತಾನ್, ಸೊಲೊಮೋನ್, <verse eid="1CH 14:4"/><verse number="5" style="v" sid="1CH 14:5"/>ಇಬ್ಹಾರ್, ಎಲೀಷೂವ, ಎಲ್ಪೆಲೆಟ, <verse eid="1CH 14:5"/><verse number="6" style="v" sid="1CH 14:6"/>ನೋಗಹ, ನೆಫೆಗ್, ಯಾಫೀಯ, <verse eid="1CH 14:6"/><verse number="7" style="v" sid="1CH 14:7"/>ಎಲೀಷಾಮ, ಎಲ್ಯಾದ<note caller="+" style="f"><char style="fr" closed="false">14:7 </char><char style="fq" closed="false">ಎಲ್ಯಾದ </char><char style="ft" closed="false">ಅಥವಾ </char><char style="fqa" closed="false">ಬೇಲ್ಯಾದ</char></note>, ಎಲೀಫೆಲೆಟ್.<verse eid="1CH 14:7"/></para>
  <para style="s1">ದಾವೀದನು ಫಿಲಿಷ್ಟಿಯರನ್ನು ಜಯಿಸಿದ್ದು</para>
  <para style="p">
    <verse number="8" style="v" sid="1CH 14:8"/>ದಾವೀದನು ಸಮಸ್ತ ಇಸ್ರಾಯೇಲಿನ ಮೇಲೆ ಅರಸನಾಗಿ ಅಭಿಷೇಕ ಹೊಂದಿದ್ದಾನೆಂದು ಫಿಲಿಷ್ಟಿಯರು ಕೇಳಿದಾಗ, ಫಿಲಿಷ್ಟಿಯರೆಲ್ಲರೂ ದಾವೀದನನ್ನು ಸೆರೆಹಿಡಿಯಲು ಹೋದರು. ದಾವೀದನು ಅದನ್ನು ಕೇಳಿ ಅವರಿಗೆದುರಾಗಿ ಹೊರಟನು. <verse eid="1CH 14:8"/><verse number="9" style="v" sid="1CH 14:9"/>ಆಗ ಫಿಲಿಷ್ಟಿಯರು ಬಂದು ರೆಫಾಯಿಮ್ ತಗ್ಗಿನಲ್ಲಿ ಇಳಿದುಕೊಂಡರು. <verse eid="1CH 14:9"/><verse number="10" style="v" sid="1CH 14:10"/>ಅದಕ್ಕೆ ದಾವೀದನು, “ನಾನು ಫಿಲಿಷ್ಟಿಯರ ಮೇಲೆ ಯುದ್ಧಕ್ಕೆ ಹೋಗಬಹುದೋ? ಅವರನ್ನು ನನ್ನ ಕೈಯಲ್ಲಿ ಒಪ್ಪಿಸಿಕೊಡುವಿರೋ?” ಎಂದು ದೇವರನ್ನು ವಿಚಾರಿಸಿದನು.</para>
  <para style="p" vid="1CH 14:10">ಆಗ ಯೆಹೋವ ದೇವರು ಅವನಿಗೆ, “ಹೋಗು, ನಾನು ಅವರನ್ನು ನಿನ್ನ ಕೈಯಲ್ಲಿ ಒಪ್ಪಿಸಿಕೊಡುವೆನು,” ಎಂದು ಹೇಳಿದರು.<verse eid="1CH 14:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="1CH 14:11"/>ಹಾಗೆಯೇ ದಾವೀದನು ಮತ್ತು ಅವನ ಸಂಗಡಿಗರೂ ಬಾಳ್ ಪೆರಾಜಿಮ್ ಎಂಬಲ್ಲಿಗೆ ಹೋಗಿ ಫಿಲಿಷ್ಟಿಯರ ಮೇಲೆ ದಾಳಿಮಾಡಿ ಅವರನ್ನು ಸೋಲಿಸಿದನು. ಆಗ ದಾವೀದನು, “ಪ್ರವಾಹವು ಕೊಚ್ಚಿಕೊಂಡು ಹೋಗುವಹಾಗೆ, ದೇವರು ನನ್ನ ಕೈಯಿಂದ ನನ್ನ ಶತ್ರುಗಳನ್ನು ನಾಶಮಾಡಿದ್ದಾರೆ,” ಎಂದನು. ಆದಕಾರಣ ಆ ಸ್ಥಳಕ್ಕೆ ಬಾಳ್ ಪೆರಾಜಿಮ್<note caller="+" style="f"><char style="fr" closed="false">14:11 </char><char style="fq" closed="false">ಬಾಳ್ ಪೆರಾಜಿಮ್ </char><char style="ft" closed="false">ಅರ್ಥ </char><char style="fqa" closed="false">ಮುರಿದು ಬಿಡುವ ದೇವರು</char></note> ಎಂದು ಹೆಸರಿಟ್ಟನು. <verse eid="1CH 14:11"/><verse number="12" style="v" sid="1CH 14:12"/>ಅಲ್ಲಿ ಫಿಲಿಷ್ಟಿಯರು ತಮ್ಮ ದೇವರುಗಳನ್ನು ಬಿಟ್ಟು ಹೋದುದರಿಂದ, ದಾವೀದನು ಅವುಗಳನ್ನು ಸುಟ್ಟುಹಾಕಬೇಕೆಂದು ಅಪ್ಪಣೆಮಾಡಿದನು.<verse eid="1CH 14:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="1CH 14:13"/>ಫಿಲಿಷ್ಟಿಯರು ಮತ್ತೆ ತಿರುಗಿಬಂದು ತಗ್ಗಿನಲ್ಲಿ ಸುಲಿಗೆಮಾಡಲು ಪ್ರಾರಂಭಿಸಿದರು. <verse eid="1CH 14:13"/><verse number="14" style="v" sid="1CH 14:14"/>ಆದ್ದರಿಂದ ದಾವೀದನು ತಿರುಗಿ ದೇವರನ್ನು ವಿಚಾರಿಸಿದನು. ಆಗ ದೇವರು ಅವನಿಗೆ, “ನೀನು ಅವರ ಹಿಂದೆ ಹೋಗದೆ, ಅವರನ್ನು ಬಿಟ್ಟು ತಿರುಗಿಕೊಂಡು ಹೋಗಿ, ಬಾಕಾಮರಗಳಿಗೆ ಎದುರಾಗಿ ಅವರ ಮೇಲೆ ದಾಳಿಮಾಡು. <verse eid="1CH 14:14"/><verse number="15" style="v" sid="1CH 14:15"/>ಬಾಕಾಮರಗಳ ತುದಿಗಳಲ್ಲಿ ನಡೆದುಬರುವ ಶಬ್ದವನ್ನು ನೀನು ಕೇಳಿದಾಗಲೇ, ದೇವರು ಫಿಲಿಷ್ಟಿಯರ ದಂಡನ್ನು ಹೊಡೆಯಲು ನಿನ್ನ ಮುಂದಾಗಿ ಹೊರಟರೆಂದು ತಿಳಿದುಕೊಂಡು ಯುದ್ಧಕ್ಕೆ ಹೊರಡು,” ಎಂದರು. <verse eid="1CH 14:15"/><verse number="16" style="v" sid="1CH 14:16"/>ಆಗ ದಾವೀದನು, ದೇವರು ತನಗೆ ಆಜ್ಞಾಪಿಸಿದ ಪ್ರಕಾರಮಾಡಿ, ಅವನು ಗಿಬ್ಯೋನಿನಿಂದ ಗೆಜೆರಿನವರೆಗೆ ಫಿಲಿಷ್ಟಿಯರ ದಂಡನ್ನು ಸಂಹರಿಸಿದರು.<verse eid="1CH 14:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="1CH 14:17"/>ದಾವೀದನ ಕೀರ್ತಿಯು ಸಮಸ್ತ ದೇಶಗಳಿಗೆ ಹರಡಿತು. ಯೆಹೋವ ದೇವರು ಅವನ ಭಯವನ್ನು ಸಮಸ್ತ ಜನಾಂಗಗಳ ಮೇಲೆ ಬರಮಾಡಿದರು.<verse eid="1CH 14:17"/></para>
  <chapter eid="1CH 14"/>
  <chapter number="15" style="c" sid="1CH 15"/>
  <para style="s1">ಮಂಜೂಷವನ್ನು ಯೆರೂಸಲೇಮಿಗೆ ತಂದದ್ದು</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 15:1"/>ದಾವೀದನ ಪಟ್ಟಣಗಳಲ್ಲಿ ದಾವೀದನು ತನಗೆ ಮನೆಗಳನ್ನು ಕಟ್ಟಿಸಿಕೊಂಡು, ದೇವರ ಮಂಜೂಷಕ್ಕೋಸ್ಕರ ಸ್ಥಳಗಳನ್ನು ಸಿದ್ಧಮಾಡಿ, ಅದರ ನಿಮಿತ್ತ ಗುಡಾರ ಹಾಕಿದನು. <verse eid="1CH 15:1"/><verse number="2" style="v" sid="1CH 15:2"/>ಆಗ ದಾವೀದನು, “ಲೇವಿಯರ ಹೊರತಾಗಿ ಮತ್ತ್ಯಾರೂ ದೇವರ ಮಂಜೂಷವನ್ನು ಹೊರಬಾರದು. ಯೆಹೋವ ದೇವರು ದೇವರ ಮಂಜೂಷವನ್ನು ಹೊರಲೂ, ಯುಗಯುಗಕ್ಕೆ ಅವರಿಗೆ ಸೇವೆಮಾಡಲೂ ಅವರನ್ನು ಆಯ್ದುಕೊಂಡಿದ್ದಾರೆ,” ಎಂದನು.<verse eid="1CH 15:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="1CH 15:3"/>ದಾವೀದನು ಯೆಹೋವ ದೇವರ ಮಂಜೂಷವನ್ನು ತಾನು ಅದಕ್ಕೋಸ್ಕರ ಸಿದ್ಧಮಾಡಿದ ಅದರ ಸ್ಥಳಕ್ಕೆ ತೆಗೆದುಕೊಂಡು ಬರುವ ನಿಮಿತ್ತ, ಯೆರೂಸಲೇಮಿಗೆ ಸಮಸ್ತ ಇಸ್ರಾಯೇಲರನ್ನು ಕೂಡಿಸಿ ಬರಮಾಡಿದನು.<verse eid="1CH 15:3"/></para>
  <para style="b"/>
  <para style="li4">
    <verse number="4" style="v" sid="1CH 15:4"/>ದಾವೀದನು ಆರೋನನ ಮಕ್ಕಳನ್ನೂ, ಲೇವಿಯರನ್ನೂ ಬರಮಾಡಿದನು.<verse eid="1CH 15:4"/></para>
  <para style="b"/>
  <para style="li1">
    <verse number="5" style="v" sid="1CH 15:5"/>ಕೊಹಾತನ ಪುತ್ರರಲ್ಲಿ ಮುಖ್ಯಸ್ಥನಾದ ಉರೀಯೇಲನೂ,</para>
  <para style="li2" vid="1CH 15:5">ಅವನ ಸಹೋದರರಾದ 120 ಮಂದಿಯೂ;<verse eid="1CH 15:5"/></para>
  <para style="li1">
    <verse number="6" style="v" sid="1CH 15:6"/>ಮೆರಾರೀಯ ಪುತ್ರರಲ್ಲಿ ಮುಖ್ಯಸ್ಥನಾದ ಅಸಾಯನೂ,</para>
  <para style="li2" vid="1CH 15:6">ಅವನ ಸಹೋದರರಾದ 220 ಮಂದಿಯೂ;<verse eid="1CH 15:6"/></para>
  <para style="li1">
    <verse number="7" style="v" sid="1CH 15:7"/>ಗೇರ್ಷೋಮನ ಪುತ್ರರಲ್ಲಿ ಮುಖ್ಯಸ್ಥನಾದ ಯೋಯೇಲನೂ</para>
  <para style="li2" vid="1CH 15:7">ಅವನ ಸಹೋದರರಾದ 130 ಮಂದಿಯೂ;<verse eid="1CH 15:7"/></para>
  <para style="li1">
    <verse number="8" style="v" sid="1CH 15:8"/>ಎಲೀಚಾಫಾನನ ಪುತ್ರರಲ್ಲಿ ಮುಖ್ಯಸ್ಥನಾದ ಶೆಮಾಯನೂ,</para>
  <para style="li2" vid="1CH 15:8">ಅವನ ಸಹೋದರರಾದ 200 ಮಂದಿಯೂ;<verse eid="1CH 15:8"/></para>
  <para style="li1">
    <verse number="9" style="v" sid="1CH 15:9"/>ಹೆಬ್ರೋನನ ಪುತ್ರರಲ್ಲಿ ಮುಖ್ಯಸ್ಥನಾದ ಎಲೀಯೇಲನೂ,</para>
  <para style="li2" vid="1CH 15:9">ಅವನ ಸಹೋದರರಾದ 80 ಮಂದಿಯೂ;<verse eid="1CH 15:9"/></para>
  <para style="li1">
    <verse number="10" style="v" sid="1CH 15:10"/>ಉಜ್ಜೀಯೇಲನ ಪುತ್ರರಲ್ಲಿ ಮುಖ್ಯಸ್ಥನಾದ ಅಮ್ಮೀನಾದಾಬನೂ,</para>
  <para style="li2" vid="1CH 15:10">ಅವನ ಸಹೋದರರಾದ 112 ಮಂದಿಯು.<verse eid="1CH 15:10"/></para>
  <para style="b"/>
  <para style="p">
    <verse number="11" style="v" sid="1CH 15:11"/>ಆಗ ದಾವೀದನು ಚಾದೋಕನು, ಅಬಿಯಾತರನು ಎಂಬ ಯಾಜಕರನ್ನೂ; ಉರೀಯೇಲನು, ಅಸಾಯನು, ಯೋಯೇಲನು, ಶೆಮಾಯನು, ಎಲೀಯೇಲನು, ಅಮ್ಮೀನಾದಾಬನು ಎಂಬ ಲೇವಿಯರನ್ನೂ ಕರೆಕಳುಹಿಸಿ ಅವರಿಗೆ, <verse eid="1CH 15:11"/><verse number="12" style="v" sid="1CH 15:12"/>“ನೀವು ಲೇವಿಯರ ಕುಟುಂಬಗಳಲ್ಲಿ ಮುಖ್ಯಸ್ಥರಾದ್ದರಿಂದ, ಇಸ್ರಾಯೇಲಿನ ದೇವರಾದ ಯೆಹೋವ ದೇವರ ಮಂಜೂಷವನ್ನು ನಾನು ಅದಕ್ಕೋಸ್ಕರ ಸಿದ್ಧಮಾಡಿದ ಸ್ಥಳಕ್ಕೆ ನೀವು ತರುವ ಹಾಗೆ ನಿಮ್ಮನ್ನೂ, ನಿಮ್ಮ ಸಹೋದರರನ್ನೂ ಪರಿಶುದ್ಧ ಮಾಡಿಕೊಳ್ಳಿರಿ. <verse eid="1CH 15:12"/><verse number="13" style="v" sid="1CH 15:13"/>ಏಕೆಂದರೆ ನೀವು ಮೊದಲು ಹಾಗೆ ಮಾಡದೆ ಇದ್ದುದರಿಂದ, ಕೋಪದಿಂದ ಯೆಹೋವ ದೇವರಾದ ನಮ್ಮ ದೇವರು ನಮ್ಮಲ್ಲಿ ಒಂದು ಒಡಕು ಬರುವಂತೆ ಮಾಡಿದರು. ಏಕೆಂದರೆ ನ್ಯಾಯದ ಪ್ರಕಾರ ನಾವು ಅವರನ್ನು ಹುಡುಕಲಿಲ್ಲ,” ಎಂದು ಹೇಳಿದನು. <verse eid="1CH 15:13"/><verse number="14" style="v" sid="1CH 15:14"/>ಇಸ್ರಾಯೇಲಿನ ದೇವರಾದ ಯೆಹೋವ ದೇವರ ಮಂಜೂಷವನ್ನು ತರುವುದಕ್ಕೆ ಯಾಜಕರೂ, ಲೇವಿಯರೂ ತಮ್ಮನ್ನು ಪರಿಶುದ್ಧ ಮಾಡಿಕೊಂಡರು. <verse eid="1CH 15:14"/><verse number="15" style="v" sid="1CH 15:15"/>ಮೋಶೆಯು ಆಜ್ಞಾಪಿಸಿದ ಯೆಹೋವ ದೇವರ ವಾಕ್ಯದ ಪ್ರಕಾರ ಲೇವಿಯರು ಕೋಲುಗಳನ್ನು ಹಾಕಿ, ದೇವರ ಮಂಜೂಷವನ್ನು ತಮ್ಮ ಹೆಗಲುಗಳ ಮೇಲೆ ಹೊತ್ತುಕೊಂಡು ಹೋದರು.<verse eid="1CH 15:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="1CH 15:16"/>ಇದಲ್ಲದೆ ದಾವೀದನು ವಾದ್ಯಗಳನ್ನೂ ವಿಶೇಷವಾದ ವೀಣೆಗಳನ್ನೂ, ಕಿನ್ನರಿಗಳನ್ನೂ, ತಾಳಗಳನ್ನೂ ಬಾರಿಸಿ ಸಂತೋಷದಿಂದ ಸ್ವರವನ್ನೂ ಎತ್ತುವ ಹಾಗೆ, ತಮ್ಮ ಸಹೋದರರಲ್ಲಿ ಹಾಡುಗಾರರನ್ನು ನೇಮಿಸುವುದಕ್ಕೆ ಲೇವಿಯರ ಪ್ರಧಾನರಿಗೆ ಆಜ್ಞಾಪಿಸಿದನು.<verse eid="1CH 15:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="1CH 15:17"/>ಹಾಗೆಯೇ ಲೇವಿಯರು ಯೋಯೇಲನ ಮಗನಾದ ಹೇಮಾನನನ್ನೂ, ಅವನ ಸಹೋದರರಲ್ಲಿ ಬೆರೆಕ್ಯನ ಮಗನಾದ ಆಸಾಫನನ್ನೂ, ಮೆರಾರೀಯ ಪುತ್ರರ ಸಂಬಂಧಿಕರಲ್ಲಿ ಕೂಷಾಯನ ಮಗ ಏತಾನನನ್ನೂ ನೇಮಿಸಿದರು. <verse eid="1CH 15:17"/><verse number="18" style="v" sid="1CH 15:18"/>ಅವರ ಸಂಗಡ ಎರಡನೆಯ ದರ್ಜೆಯವರಾದ ತಮ್ಮ ಸಹೋದರರಾಗಿರುವ ಜೆಕರ್ಯನನ್ನೂ ಬೇನನನ್ನೂ ಯಾಜೀಯೇಲನನ್ನೂ, ಶೆಮೀರಾಮೋತನನ್ನೂ ಯೆಹೀಯೇಲನನ್ನೂ, ಉನ್ನೀಯನ್ನೂ, ಎಲೀಯಾಬನನ್ನೂ, ಬೆನಾಯನನ್ನೂ, ಮಾಸೇಯನನ್ನೂ, ಮತ್ತಿತ್ಯನನ್ನೂ, ಎಲೀಫೆಲೇಹುನನ್ನೂ ಮಿಕ್ನೇಯನನ್ನೂ ದ್ವಾರಪಾಲಕರಾದ ಓಬೇದ್ ಏದೋಮನನ್ನೂ ಯೆಹೀಯೇಲನನ್ನೂ ನೇಮಿಸಿದರು.<verse eid="1CH 15:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="1CH 15:19"/>ಸಂಗೀತಗಾರರಾದ ಹೇಮಾನನೂ, ಆಸಾಫನೂ, ಏತಾನನೂ ಕಂಚಿನ ತಾಳಗಳನ್ನು ಬಾರಿಸುವವರು. <verse eid="1CH 15:19"/><verse number="20" style="v" sid="1CH 15:20"/>ಜೆಕರ್ಯ, ಅಜಿಯೇಲ್, ಶೆಮೀರಾಮೋತ್, ಯೆಹೀಯೇಲ್, ಉನ್ನೀ, ಎಲೀಯಾಬ್, ಮಾಸೇಯ, ಬೆನಾಯ ಎಂಬವರನ್ನು <char style="tl">ಅಲಮೋತ್</char> ಎಂಬ ತಾರಸ್ಥಾಯಿಯ ವೀಣೆಗಳನ್ನು ಬಾರಿಸುವುದಕ್ಕೆ ಆರಿಸಿಕೊಂಡರು. <verse eid="1CH 15:20"/><verse number="21" style="v" sid="1CH 15:21"/>ಮತ್ತಿತ್ಯ, ಎಲೀಫೆಲೇಹು, ಮಿಕ್ನೇಯ, ಓಬೇದ್ ಏದೋಮ್, ಯೆಹೀಯೇಲ್, ಅಜಜ್ಯ ಎಂಬವರನ್ನು <char style="tl">ಶೆಮಿನಿಥ್</char> ಎಂಬ ಮಂದ್ರಸ್ಥಾಯಿಯ ಕಿನ್ನರಿಗಳನ್ನು ಬಾರಿಸುವುದಕ್ಕೂ ನೇಮಿಸಿಕೊಂಡರು. <verse eid="1CH 15:21"/><verse number="22" style="v" sid="1CH 15:22"/>ಆದರೆ ಲೇವಿಯರ ಪ್ರಧಾನನಾದ ಕೆನನ್ಯನು ಹಾಡುವುದಕ್ಕೆ ನೇಮಕವಾದನು. ಅವನು ಸಂಗೀತದಲ್ಲಿ ನಿಪುಣನಾದ್ದರಿಂದ ಅವನು ಮುಖ್ಯಸ್ಥನಾಗಿದ್ದನು.<verse eid="1CH 15:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="1CH 15:23"/>ಬೆರೆಕ್ಯ, ಎಲ್ಕಾನಾ ಮಂಜೂಷಕ್ಕೆ ದ್ವಾರಪಾಲಕರಾಗಿದ್ದರು. <verse eid="1CH 15:23"/><verse number="24" style="v" sid="1CH 15:24"/>ಯಾಜಕರಾದ ಶೆಬನ್ಯ, ಯೋಷಾಫಾಟ್, ನೆತನೆಯೇಲ್, ಅಮಾಸೈಯೂ, ಜೆಕರ್ಯನೂ, ಬೆನಾಯನೂ, ಎಲೀಯೆಜೆರನೂ ದೇವರ ಮಂಜೂಷದ ಮುಂದೆ ತುತೂರಿಗಳನ್ನು ಊದುತ್ತಾ ಇದ್ದರು. ಓಬೇದ್ ಏದೋಮನೂ, ಯೆಹೀಯನೂ ಮಂಜೂಷಕ್ಕೆ ದ್ವಾರಪಾಲಕರಾಗಿದ್ದರು.<verse eid="1CH 15:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="1CH 15:25"/>ಹೀಗೆಯೇ ದಾವೀದನೂ, ಇಸ್ರಾಯೇಲಿನ ಹಿರಿಯರೂ, ಸಹಸ್ರಾಧಿಪತಿಗಳೂ ಸಂತೋಷವಾಗಿ ಓಬೇದ್ ಏದೋಮನ ಮನೆಯೊಳಗಿಂದ ಯೆಹೋವ ದೇವರ ಒಡಂಬಡಿಕೆಯ ಮಂಜೂಷವನ್ನು ತರಲು ಹೋದರು. <verse eid="1CH 15:25"/><verse number="26" style="v" sid="1CH 15:26"/>ಯೆಹೋವ ದೇವರ ಒಡಂಬಡಿಕೆಯ ಮಂಜೂಷವನ್ನು ಹೊತ್ತುಕೊಂಡು ಬರುತ್ತಿದ್ದ ಲೇವಿಯರಿಗೆ ದೇವರು ಸಹಾಯ ಮಾಡಿದ್ದರಿಂದ, ಅವರು ಏಳು ಹೋರಿಗಳನ್ನೂ, ಏಳು ಟಗರುಗಳನ್ನೂ ಬಲಿಯಾಗಿ ಅರ್ಪಿಸಿದರು. <verse eid="1CH 15:26"/><verse number="27" style="v" sid="1CH 15:27"/>ದಾವೀದನೂ, ಮಂಜೂಷವನ್ನು ಹೊರುವ ಲೇವಿಯರೂ, ಹಾಡುಗಾರರೂ, ಸಂಗೀತಗಾರರ ನಾಯಕನಾದ ಕೆನನ್ಯನೂ ನಯವಾದ ನಾರಿನ ಮೇಲಂಗಿಯನ್ನು ಧರಿಸಿಕೊಂಡಿದ್ದರು. ಇದಲ್ಲದೆ ದಾವೀದನು ನಾರಿನ ಏಫೋದನ್ನು ಧರಿಸಿಕೊಂಡಿದ್ದನು. <verse eid="1CH 15:27"/><verse number="28" style="v" sid="1CH 15:28"/>ಹೀಗೆ ಇಸ್ರಾಯೇಲರೆಲ್ಲರೂ ಯೆಹೋವ ದೇವರ ಒಡಂಬಡಿಕೆಯ ಮಂಜೂಷವನ್ನು ಆರ್ಭಟದಿಂದಲೂ, ಕೊಂಬಿನ ಶಬ್ದದಿಂದಲೂ, ತುತೂರಿಗಳಿಂದಲೂ, ತಾಳಗಳಿಂದಲೂ ವೀಣೆಗಳನ್ನೂ, ಕಿನ್ನರಿಗಳನ್ನೂ ಬಾರಿಸುತ್ತಾ ತೆಗೆದುಕೊಂಡು ಬಂದರು.<verse eid="1CH 15:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="1CH 15:29"/>ಯೆಹೋವ ದೇವರ ಒಡಂಬಡಿಕೆಯ ಮಂಜೂಷವು ದಾವೀದನ ಪಟ್ಟಣದಲ್ಲಿ ಪ್ರವೇಶಿಸುವಾಗ, ಸೌಲನ ಮಗಳಾದ ಮೀಕಲಳು ಕಿಟಕಿಯಿಂದ ನೋಡಿ, ಕುಣಿಯುತ್ತಾ, ಹಾಡುತ್ತಾ ಇರುವ ಅರಸನಾದ ದಾವೀದನನ್ನು ಕಂಡು, ತನ್ನ ಹೃದಯದಲ್ಲಿ ಅವನನ್ನು ತಿರಸ್ಕರಿಸಿದಳು.<verse eid="1CH 15:29"/></para>
  <chapter eid="1CH 15"/>
  <chapter number="16" style="c" sid="1CH 16"/>
  <para style="s1">ಯೆಹೋವ ದೇವರ ಮಂಜೂಷದ ಮುಂದೆ ಸೇವೆಮಾಡುವುದು</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 16:1"/>ಅವರು ದೇವರ ಮಂಜೂಷವನ್ನು ಒಳಗೆ ತಂದು, ದಾವೀದನು ಅದಕ್ಕೋಸ್ಕರ ಹಾಕಿದ ಗುಡಾರದೊಳಗೆ ಅದರ ನಿಯಮಿತ ಸ್ಥಳದಲ್ಲಿ ಅದನ್ನು ಇಟ್ಟ ತರುವಾಯ, ಅವರು ದೇವರ ಸನ್ನಿಧಿಯಲ್ಲಿ ದಹನಬಲಿಗಳನ್ನೂ, ಸಮಾಧಾನದ ಬಲಿಗಳನ್ನೂ ಅರ್ಪಿಸಿದರು. <verse eid="1CH 16:1"/><verse number="2" style="v" sid="1CH 16:2"/>ದಾವೀದನು ದಹನಬಲಿಗಳನ್ನೂ, ಸಮಾಧಾನದ ಬಲಿಗಳನ್ನೂ ಅರ್ಪಿಸಿದ ತರುವಾಯ, ಅವನು ಯೆಹೋವ ದೇವರ ಹೆಸರಿನಲ್ಲಿ ಜನರನ್ನು ಆಶೀರ್ವದಿಸಿ, <verse eid="1CH 16:2"/><verse number="3" style="v" sid="1CH 16:3"/>ಇಸ್ರಾಯೇಲಿನ ಪ್ರತಿಯೊಬ್ಬ ಪುರುಷನಿಗೂ ಸ್ತ್ರೀಗೂ, ಒಂದು ರೊಟ್ಟಿಯನ್ನೂ, ಖರ್ಜೂರದ ಉಂಡೆಯನ್ನೂ, ದ್ರಾಕ್ಷಿ ಹಣ್ಣಿನ ಉಂಡೆಯನ್ನೂ ಹಂಚಿದನು.<verse eid="1CH 16:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="1CH 16:4"/>ಇದಲ್ಲದೆ ಯೆಹೋವ ದೇವರ ಮಂಜೂಷದ ಮುಂದೆ ಸೇವೆಮಾಡಲೂ, ಇಸ್ರಾಯೇಲಿನ ದೇವರಾದ ಯೆಹೋವ ದೇವರನ್ನು ಸ್ಮರಿಸುವುದಕ್ಕೂ, ಕೊಂಡಾಡುವುದಕ್ಕೂ, ಹೊಗಳುವುದಕ್ಕೂ ಲೇವಿಯರಲ್ಲಿ ಕೆಲವರನ್ನು ನೇಮಿಸಿದನು. <verse eid="1CH 16:4"/><verse number="5" style="v" sid="1CH 16:5"/>ಅವರು ಯಾರೆಂದರೆ: ಮುಖ್ಯಸ್ಥನಾದ ಆಸಾಫನೂ, ಅವನ ತರುವಾಯ ಜೆಕರ್ಯನೂ, ಯೆಜೀಯೇಲನೂ, ಶೆಮೀರಾಮೋತನೂ, ಯೆಹೀಯೇಲನೂ, ಮತ್ತಿತ್ಯನೂ, ಎಲೀಯಾಬನೂ, ಬೆನಾಯನೂ, ಓಬೇದ್ ಏದೋಮನೂ, ಯೆಹಿಯೇಲನೂ ಇವರು ವೀಣೆಗಳನ್ನೂ, ಕಿನ್ನರಿಗಳನ್ನೂ ಬಾರಿಸುತ್ತಿದ್ದರು. ಆದರೆ ಆಸಾಫನು ತಾಳಗಳನ್ನು ಬಾರಿಸುತ್ತಿದ್ದನು. <verse eid="1CH 16:5"/><verse number="6" style="v" sid="1CH 16:6"/>ಇದಲ್ಲದೆ ಯಾಜಕರಾದ ಬೆನಾಯನೂ, ಯಹಜಿಯೇಲನೂ ದೇವರ ಒಡಂಬಡಿಕೆಯ ಮಂಜೂಷದ ಮುಂದೆ ಯಾವಾಗಲೂ ತುತೂರಿಗಳನ್ನು ಊದುವವರಾಗಿದ್ದರು.<verse eid="1CH 16:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="1CH 16:7"/>ಆಸಾಫನಿಗೂ, ಅವನ ಜೊತೆ ಲೇವಿಯರಿಗೂ ಯೆಹೋವ ದೇವರ ಸ್ತೋತ್ರಗೀತೆ ಹಾಡಲು ದಾವೀದನು ಪ್ರಥಮವಾಗಿ ಆ ದಿನದಲ್ಲೇ ನೇಮಿಸಿದನು. ಅವರು ಹೀಗೆಂದು ಹಾಡಿದರು:<verse eid="1CH 16:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="1CH 16:8"/>ಯೆಹೋವ ದೇವರಿಗೆ ಉಪಕಾರಸ್ತುತಿ ಮಾಡಿರಿ, ಅವರ ಹೆಸರನ್ನು ಸಾರಿ ಹೇಳಿರಿ,</para>
  <para style="q2" vid="1CH 16:8">ಜನರಲ್ಲಿ ದೇವರ ಕ್ರಿಯೆಗಳನ್ನು ತಿಳಿಯಪಡಿಸಿರಿ.<verse eid="1CH 16:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="1CH 16:9"/>ದೇವರಿಗೆ ಹಾಡಿರಿ, ದೇವರಿಗೆ ಕೀರ್ತನೆ ಹಾಡಿರಿ,</para>
  <para style="q2" vid="1CH 16:9">ದೇವರ ಅದ್ಭುತ ಕ್ರಿಯೆಗಳ ವಿಷಯವಾಗಿ ಮಾತನಾಡಿರಿ.<verse eid="1CH 16:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="1CH 16:10"/>ದೇವರ ಪರಿಶುದ್ಧ ನಾಮವನ್ನು ಹೊಗಳಿರಿ,</para>
  <para style="q2" vid="1CH 16:10">ಯೆಹೋವ ದೇವರನ್ನು ಹುಡುಕುವವರ ಹೃದಯವು ಸಂತೋಷಿಸಲಿ.<verse eid="1CH 16:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="1CH 16:11"/>ಯೆಹೋವ ದೇವರನ್ನೂ, ಅವರ ಬಲವನ್ನೂ ಆಶ್ರಯಿಸಿರಿ,</para>
  <para style="q2" vid="1CH 16:11">ಅವರ ಮುಖವನ್ನು ಯಾವಾಗಲೂ ಹುಡುಕಿರಿ.<verse eid="1CH 16:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="1CH 16:12"/>ದೇವರು ಮಾಡಿದ ಆಶ್ಚರ್ಯಕಾರ್ಯಗಳನ್ನೂ, ಅವರ ಅದ್ಭುತಗಳನ್ನೂ,</para>
  <para style="q2" vid="1CH 16:12">ಅವರ ಬಾಯಿಂದ ಹೊರಟ ನ್ಯಾಯ ನಿರ್ಣಯಗಳನ್ನೂ ಜ್ಞಾಪಕಮಾಡಿಕೊಳ್ಳಿರಿ.<verse eid="1CH 16:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="1CH 16:13"/>ಅವರ ಸೇವಕನಾದ ಇಸ್ರಾಯೇಲಿನ ಸಂತತಿಯೇ,</para>
  <para style="q2" vid="1CH 16:13">ಅವರು ಆಯ್ದುಕೊಂಡ ಯಾಕೋಬನ ಮಕ್ಕಳೇ,<verse eid="1CH 16:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="1CH 16:14"/>ಅವರೇ ನಮ್ಮ ದೇವರಾದ ಯೆಹೋವ ಆಗಿದ್ದಾರೆ.</para>
  <para style="q2" vid="1CH 16:14">ಅವರ ನ್ಯಾಯಗಳು ಸಮಸ್ತ ಭೂಮಿಯಲ್ಲಿ ಇವೆ.<verse eid="1CH 16:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="1CH 16:15"/>ದೇವರು ತಮ್ಮ ಒಡಂಬಡಿಕೆಯನ್ನೂ,</para>
  <para style="q2" vid="1CH 16:15">ಸಾವಿರ ತಲಾಂತರಗಳಿಗೆ ಆಜ್ಞಾಪಿಸಿದ ತಮ್ಮ ಮಾತನ್ನೂ,<verse eid="1CH 16:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="1CH 16:16"/>ಅಬ್ರಹಾಮನ ಸಂಗಡ ಮಾಡಿದ ಒಡಂಬಡಿಕೆಯನ್ನೂ,</para>
  <para style="q2" vid="1CH 16:16">ಇಸಾಕನಿಗೆ ಇಟ್ಟ ಆಣೆಯನ್ನೂ ಯುಗಯುಗಕ್ಕೂ ಜ್ಞಾಪಕಮಾಡಿಕೊಳ್ಳಿರಿ.<verse eid="1CH 16:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="1CH 16:17"/>ದೇವರು ಅದನ್ನು ಯಾಕೋಬನಿಗೆ ತೀರ್ಪನ್ನಾಗಿ ದೃಢಪಡಿಸಿದರು,</para>
  <para style="q2" vid="1CH 16:17">ಅವರು ಇಸ್ರಾಯೇಲರಿಗೆ ನಿತ್ಯ ಒಡಂಬಡಿಕೆಯಾಗಿ ಸ್ಥಾಪಿಸಿ ಹೇಳಿದ್ದೇನೆಂದರೆ:<verse eid="1CH 16:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="1CH 16:18"/>“ನಾನು ನಿಮಗೆ ಕಾನಾನ್ ದೇಶವನ್ನು</para>
  <para style="q2" vid="1CH 16:18">ನಿಮ್ಮ ಬಾಧ್ಯತೆಯ ಪಾಲಾಗಿ ಕೊಡುವೆನು.”<verse eid="1CH 16:18"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="1CH 16:19"/>ಆಗ ಅವರು ಅಲ್ಪಸಂಖ್ಯಾತರೂ, ಬಹು ಸ್ವಲ್ಪ ಮಂದಿಯಾಗಿಯೂ,</para>
  <para style="q2" vid="1CH 16:19">ಪರದೇಶಸ್ಥರಾಗಿಯೂ ನಾಡಿನಲ್ಲಿ ಇದ್ದರು.<verse eid="1CH 16:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="1CH 16:20"/>ಅವರು ಜನಾಂಗದಿಂದ ಜನಾಂಗಕ್ಕೂ,</para>
  <para style="q2" vid="1CH 16:20">ಒಂದು ರಾಜ್ಯದಿಂದ ಬೇರೊಂದು ರಾಜ್ಯಕ್ಕೂ ಹೋಗುತ್ತಿದ್ದರು.<verse eid="1CH 16:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="1CH 16:21"/>ಜನರು ಅವರಿಗೆ ಕೇಡು ಮಾಡದಂತೆ ದೇವರು ತಡೆದರು.</para>
  <para style="q2" vid="1CH 16:21">ಹೌದು, ಅವರಿಗೋಸ್ಕರ ದೇವರು ಅರಸರನ್ನು ಗದರಿಸಿ:<verse eid="1CH 16:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="1CH 16:22"/>ನನ್ನ ಅಭಿಷಿಕ್ತರನ್ನು ಮುಟ್ಟಬೇಡಿರಿ.</para>
  <para style="q2" vid="1CH 16:22">ನನ್ನ ಪ್ರವಾದಿಗಳಿಗೆ ಕೇಡು ಮಾಡಬೇಡಿರಿ.<verse eid="1CH 16:22"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="23" style="v" sid="1CH 16:23"/>ಸಮಸ್ತ ಭೂನಿವಾಸಿಗಳೇ, ಯೆಹೋವ ದೇವರಿಗೆ ಹಾಡಿರಿ.</para>
  <para style="q2" vid="1CH 16:23">ಅವರ ರಕ್ಷಣೆಯನ್ನು ದಿನಂಪ್ರತಿ ಸಾರಿ ಹೇಳಿರಿ.<verse eid="1CH 16:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="1CH 16:24"/>ಜನಾಂಗಗಳಲ್ಲಿ ಅವರ ಘನತೆಯನ್ನೂ,</para>
  <para style="q2" vid="1CH 16:24">ಎಲ್ಲಾ ಜನಾಂಗಗಳಲ್ಲಿ ಅವರ ಅದ್ಭುತಗಳನ್ನೂ ವಿವರಿಸಿರಿ.<verse eid="1CH 16:24"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="25" style="v" sid="1CH 16:25"/>ಯೆಹೋವ ದೇವರು ಮಹೋನ್ನತರಾಗಿದ್ದಾರೆ, ಬಹು ಸ್ತುತಿಗೆ ಪಾತ್ರರೂ ಆಗಿದ್ದಾರೆ;</para>
  <para style="q2" vid="1CH 16:25">ಅವರು ಎಲ್ಲಾ ದೇವರುಗಳಿಗಿಂತ ಬಹುಭಯಭಕ್ತಿಗೆ ಪಾತ್ರರಾಗಿದ್ದಾರೆ.<verse eid="1CH 16:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="1CH 16:26"/>ಏಕೆಂದರೆ ಜನಾಂಗಗಳ ದೇವರುಗಳೆಲ್ಲಾ ವಿಗ್ರಹಗಳಾಗಿವೆ;</para>
  <para style="q2" vid="1CH 16:26">ಆದರೆ ಯೆಹೋವ ದೇವರು ಆಕಾಶಮಂಡಲವನ್ನು ನಿರ್ಮಿಸಿದವರು.<verse eid="1CH 16:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="1CH 16:27"/>ಅವರ ಸನ್ನಿಧಿಯಲ್ಲಿ ಘನತೆಯೂ ಪ್ರಭೆಯೂ;</para>
  <para style="q2" vid="1CH 16:27">ಅವರ ಪರಿಶುದ್ಧ ಸ್ಥಳದಲ್ಲಿ ಬಲವೂ ಸಂತೋಷವೂ ಇವೆ.<verse eid="1CH 16:27"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="28" style="v" sid="1CH 16:28"/>ಜನಾಂಗದ ಕುಟುಂಬಗಳೇ, ಯೆಹೋವ ದೇವರ ಮುಂದೆ,</para>
  <para style="q2" vid="1CH 16:28">ನೀವು ಮಹಿಮೆಯನ್ನೂ ಬಲವನ್ನೂ ಅರ್ಪಿಸಿರಿ.<verse eid="1CH 16:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="1CH 16:29"/>ಯೆಹೋವ ದೇವರ ಹೆಸರಿಗೆ ಸಲ್ಲತಕ್ಕ ಗೌರವವನ್ನು ಸಲ್ಲಿಸಿರಿ;</para>
  <para style="q2" vid="1CH 16:29">ಕಾಣಿಕೆಯನ್ನು ತೆಗೆದುಕೊಂಡು ದೇವರ ಸನ್ನಿಧಿಗೆ ಬನ್ನಿರಿ.</para>
  <para style="q1" vid="1CH 16:29">ಪರಿಶುದ್ಧತೆ ಎಂಬ ಭೂಷಣದೊಡನೆ ಯೆಹೋವ ದೇವರನ್ನು ಆರಾಧಿಸಿರಿ.<verse eid="1CH 16:29"/></para>
  <para style="q2">
    <verse number="30" style="v" sid="1CH 16:30"/>ಸಮಸ್ತ ಭೂನಿವಾಸಿಗಳೇ, ಅವರ ಮುಂದೆ ಭಯಪಡಿರಿ.</para>
  <para style="q2" vid="1CH 16:30">ಲೋಕವು ಸ್ಥಿರವಾಗಿರುವುದು, ಕದಲುವುದಿಲ್ಲ.<verse eid="1CH 16:30"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="31" style="v" sid="1CH 16:31"/>ಆಕಾಶವು ಸಂತೋಷಿಸಲಿ, ಭೂಮಿಯು ಉಲ್ಲಾಸಪಡಲಿ.</para>
  <para style="q2" vid="1CH 16:31">ಯೆಹೋವ ದೇವರು ಆಳುತ್ತಾರೆಂದು ಜನಾಂಗಗಳಲ್ಲಿ ಹೇಳಲಿ.<verse eid="1CH 16:31"/></para>
  <para style="q1">
    <verse number="32" style="v" sid="1CH 16:32"/>ಸಮುದ್ರವೂ ಅದರಲ್ಲಿರುವುದೆಲ್ಲವೂ ಘೋಷಿಸಲಿ.</para>
  <para style="q2" vid="1CH 16:32">ಹೊಲಗಳೂ ಅವುಗಳಲ್ಲಿರುವ ಸಮಸ್ತವೂ ಉತ್ಸಾಹಪಡಲಿ.<verse eid="1CH 16:32"/></para>
  <para style="q1">
    <verse number="33" style="v" sid="1CH 16:33"/>ಆಗ ಅಡವಿಯ ಮರಗಳೆಲ್ಲಾ ಯೆಹೋವ ದೇವರ ಮುಂದೆಯೇ</para>
  <para style="q2" vid="1CH 16:33">ಉತ್ಸಾಹಧ್ವನಿ ಮಾಡಲಿ.</para>
  <para style="q2" vid="1CH 16:33">ದೇವರು ಭೂಮಿಗೆ ನ್ಯಾಯತೀರಿಸಲು ಬರುತ್ತಾರೆ.<verse eid="1CH 16:33"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="34" style="v" sid="1CH 16:34"/>ಯೆಹೋವ ದೇವರಿಗೆ ಕೃತಜ್ಞತಾ ಸ್ತುತಿಮಾಡಿರಿ.</para>
  <para style="q2" vid="1CH 16:34">ಅವರು ಒಳ್ಳೆಯವರು; ಅವರ ಪ್ರೀತಿ ಶಾಶ್ವತವಾಗಿರುವುದು.<verse eid="1CH 16:34"/></para>
  <para style="q1">
    <verse number="35" style="v" sid="1CH 16:35"/>ನಮ್ಮ ರಕ್ಷಣೆಯ ದೇವರೇ,</para>
  <para style="q2" vid="1CH 16:35">“ನಾವು ನಿಮ್ಮ ಪರಿಶುದ್ಧ ಹೆಸರಿಗೆ ಉಪಕಾರಸ್ತುತಿ ಮಾಡಿ,</para>
  <para style="q1" vid="1CH 16:35">ನಿಮ್ಮ ಸ್ತೋತ್ರದಲ್ಲಿ ಜಯಘೋಷ ಮಾಡುವ ಹಾಗೆ ನಮ್ಮನ್ನು ರಕ್ಷಿಸಿರಿ,</para>
  <para style="q2" vid="1CH 16:35">ಜನಾಂಗಗಳೊಳಗಿಂದ ನಮ್ಮನ್ನು ಬಿಡುಗಡೆ ಮಾಡಿ ಒಂದುಗೂಡಿಸಿರಿ.”<verse eid="1CH 16:35"/></para>
  <para style="q1">
    <verse number="36" style="v" sid="1CH 16:36"/>ಇಸ್ರಾಯೇಲ್ ದೇವರಾದ ಯೆಹೋವ ದೇವರಿಗೆ</para>
  <para style="q2" vid="1CH 16:36">ಯುಗಯುಗಕ್ಕೂ ಸ್ತುತಿಯುಂಟಾಗಲಿ,</para>
  <para style="m" vid="1CH 16:36">ಜನರೆಲ್ಲರೂ, “ಆಮೆನ್,” ಎಂದು ಹೇಳಲಿ. ನೀವು, “ಯೆಹೋವ ದೇವರನ್ನು ಸ್ತುತಿಸಿರಿ,” ಎಂದು ಹೇಳಿದರು.<verse eid="1CH 16:36"/></para>
  <para style="b"/>
  <para style="p">
    <verse number="37" style="v" sid="1CH 16:37"/>ಪ್ರತಿದಿನದ ಅವಶ್ಯಕತೆಗಳಿಗೆ ಅನುಗುಣವಾಗಿ ನಿಯಮಿತವಾಗಿ ಯೆಹೋವ ದೇವರ ಒಡಂಬಡಿಕೆಯ ಮಂಜೂಷದ ಮುಂದೆ ಸೇವೆ ಸಲ್ಲಿಸಲು ದಾವೀದನು ಆಸಾಫ್ ಮತ್ತು ಅವನ ಸಹಚರರನ್ನು ನೇಮಿಸಿದನು. <verse eid="1CH 16:37"/><verse number="38" style="v" sid="1CH 16:38"/>ಓಬೇದ್ ಏದೋಮ್ ಮತ್ತು ಅವನ ಸಹಚರರಾದ ಅರವತ್ತೆಂಟು ಮಂದಿಯೂ, ದ್ವಾರಪಾಲಕರಾದ ಯೆದುತೂನನ ಮಗ ಓಬೇದ್ ಎದೋಮ್ ಮತ್ತು ಹೋಸ ನೇಮಕವಾಗಿದ್ದರು.<verse eid="1CH 16:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="1CH 16:39"/>ಗಿಬ್ಯೋನಿನಲ್ಲಿರುವ ಉನ್ನತ ಸ್ಥಳದಲ್ಲಿ ಯೆಹೋವ ದೇವರ ಗುಡಾರದ ಮುಂದೆ ಸೇವೆಮಾಡುವದಕ್ಕೆ ದಾವೀದನು ಯಾಜಕನಾದ ಚಾದೋಕನನ್ನೂ ಮತ್ತು ಅವನ ಸಹೋದರರನ್ನು ನೇಮಿಸಿದನು. <verse eid="1CH 16:39"/><verse number="40" style="v" sid="1CH 16:40"/>ಯೆಹೋವ ದೇವರು ಇಸ್ರಾಯೇಲಿಗೆ ಆಜ್ಞಾಪಿಸಿದ ಮೋಶೆಯ ನಿಯಮದಲ್ಲಿ ಬರೆದಿದ್ದ ಎಲ್ಲಾದರ ಪ್ರಕಾರ ಮಾಡಲೂ ಅವರು ಪ್ರತಿದಿನವೂ ಉದಯಕಾಲದಲ್ಲಿ ಮತ್ತು ಸಾಯಂಕಾಲದಲ್ಲಿ ದಹನಬಲಿಪೀಠದ ಮೇಲೆ ಯೆಹೋವ ದೇವರಿಗೆ ದಹನಬಲಿಗಳನ್ನು ಅರ್ಪಿಸುತ್ತಿದ್ದರು. <verse eid="1CH 16:40"/><verse number="41" style="v" sid="1CH 16:41"/>“ದೇವರ ಪ್ರೀತಿ ನಿತ್ಯವಾಗಿ ನೆಲೆಗೊಂಡಿರುವುದು,” ಎಂದು ಯೆಹೋವ ದೇವರನ್ನು ಕೊಂಡಾಡುವುದಕ್ಕೆ ಹೇಮಾನನೂ, ಯೆದುತೂನನೂ ಹೆಸರು ಹೆಸರಾಗಿ ಆಯ್ಕೆಗೊಂಡು, ನೇಮಕರಾಗಿದ್ದರು. <verse eid="1CH 16:41"/><verse number="42" style="v" sid="1CH 16:42"/>ಅದರ ಸಂಗಡ ತುತೂರಿ ಊದಲು, ತಾಳ ಬಾರಿಸಲು, ದೇವರ ಗೀತವಾದ್ಯಗಳೂ ಸಹಿತವಾಗಿ ಹೇಮಾನನೂ, ಯೆದುತೂನನೂ ಮೇಲ್ವಿಚಾರಕರಾಗಿದ್ದರು. ಯೆದುತೂನನ ಪುತ್ರರು ದ್ವಾರಪಾಲಕರಾಗಿದ್ದರು.<verse eid="1CH 16:42"/></para>
  <para style="p">
    <verse number="43" style="v" sid="1CH 16:43"/>ತರುವಾಯ ಜನರೆಲ್ಲರು ತಮ್ಮ ತಮ್ಮ ಮನೆಗೆ ಹೋದರು. ದಾವೀದನು ತನ್ನ ಕುಟುಂಬವನ್ನು ಆಶೀರ್ವದಿಸುವುದಕ್ಕೆ ಹೋದನು.<verse eid="1CH 16:43"/></para>
  <chapter eid="1CH 16"/>
  <chapter number="17" style="c" sid="1CH 17"/>
  <para style="s1">ದಾವೀದನಿಗೆ ದೇವರ ವಾಗ್ದಾನ</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 17:1"/>ದಾವೀದನು ತನ್ನ ಅರಮನೆಯಲ್ಲಿ ವಾಸಿಸುತ್ತಿದ್ದಾಗ, ಒಂದು ದಿನ ದಾವೀದನು ಪ್ರವಾದಿಯಾದ ನಾತಾನನಿಗೆ, “ನೋಡು, ನಾನು ದೇವದಾರು ಮರದ ಅರಮನೆಯಲ್ಲಿ ವಾಸವಾಗಿದ್ದೇನೆ. ಆದರೆ ಯೆಹೋವ ದೇವರ ಒಡಂಬಡಿಕೆಯ ಮಂಜೂಷವು ಗುಡಾರದಲ್ಲಿರುತ್ತದೆ,” ಎಂದನು.<verse eid="1CH 17:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="1CH 17:2"/>ಆಗ ನಾತಾನನು ದಾವೀದನಿಗೆ, “ನಿನ್ನ ಹೃದಯದಲ್ಲಿ ಏನು ಇದೆಯೋ ಅದನ್ನು ಮಾಡು; ಏಕೆಂದರೆ ದೇವರು ನಿನ್ನ ಸಂಗಡ ಇದ್ದಾರೆ,” ಎಂದನು.<verse eid="1CH 17:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="1CH 17:3"/>ಅದೇ ರಾತ್ರಿಯಲ್ಲಿ ಯೆಹೋವ ದೇವರ ವಾಕ್ಯವು ನಾತಾನನಿಗೆ ಉಂಟಾಗಿ ಹೇಳಿದ್ದೇನೆಂದರೆ:<verse eid="1CH 17:3"/></para>
  <para style="pm">
    <verse number="4" style="v" sid="1CH 17:4"/>“ನೀನು ಹೋಗಿ ನನ್ನ ಸೇವಕನಾದ ದಾವೀದನಿಗೆ, ‘ಯೆಹೋವ ದೇವರು ಹೇಳುವುದೇನೆಂದರೆ: ನಾನು ವಾಸವಾಗಿರುವುದಕ್ಕೆ ನೀನು ನನಗೆ ಆಲಯವನ್ನು ಕಟ್ಟಿಸಬೇಡ. <verse eid="1CH 17:4"/><verse number="5" style="v" sid="1CH 17:5"/>ಏಕೆಂದರೆ ನಾನು ಈಜಿಪ್ಟಿನಿಂದ ಇಸ್ರಾಯೇಲರನ್ನು ಬರಮಾಡಿದ ದಿವಸ ಮೊದಲುಗೊಂಡು, ಇಂದಿನವರೆಗೂ ಆಲಯದಲ್ಲಿ ವಾಸಮಾಡದೆ ಒಂದು ಗುಡಾರದ ಸ್ಥಳದಿಂದ ಇನ್ನೊಂದು ಗುಡಾರದ ಸ್ಥಳಕ್ಕೂ, ಒಂದು ತಂಗುವ ಸ್ಥಳದಿಂದ ಇನ್ನೊಂದು ತಂಗುವ ಸ್ಥಳಕ್ಕೂ ಹೋಗುತ್ತಿದ್ದೆನು. <verse eid="1CH 17:5"/><verse number="6" style="v" sid="1CH 17:6"/>ನಾನು ನನ್ನ ಜನರಾದ ಇಸ್ರಾಯೇಲರನ್ನು ಪರಿಪಾಲಿಸಲು ಆಜ್ಞಾಪಿಸಿದ ಇಸ್ರಾಯೇಲಿನ ಅಧಿಪತಿಗಳಲ್ಲಿ ಒಬ್ಬನ ಜೊತೆಯಾದರೂ, “ನೀವು ನನಗೆ ದೇವದಾರು ಮನೆಯನ್ನು ಏಕೆ ಕಟ್ಟಲಿಲ್ಲ,” ಎಂದು ನಾನು ಸಮಸ್ತ ಇಸ್ರಾಯೇಲಿನ ಸಂಗಡ ಸಂಚರಿಸಿದ ಯಾವ ಸ್ಥಳದಲ್ಲಾದರೂ, ಯಾವಾಗಲಾದರೂ ಕೇಳಿದೆನೋ?’<verse eid="1CH 17:6"/></para>
  <para style="pm">
    <verse number="7" style="v" sid="1CH 17:7"/>“ಈಗ ನೀನು ನನ್ನ ಸೇವಕನಾದ ದಾವೀದನಿಗೆ ಹೇಳಬೇಕಾದದ್ದೇನೆಂದರೆ, ‘ಸೇನಾಧೀಶ್ವರ ಯೆಹೋವ ದೇವರು ನಿನಗೆ ತಿಳಿಸುವುದೇನೆಂದರೆ: ಕುರಿಗಳ ಹಿಂದೆ ಹೋಗುತ್ತಿದ್ದ ನಿನ್ನನ್ನು ನಾನು ಕುರಿಯ ಹಟ್ಟಿಯಿಂದ ತೆಗೆದುಕೊಂಡು, ನನ್ನ ಜನರಾದ ಇಸ್ರಾಯೇಲರ ಮೇಲೆ ನಾಯಕನಾಗಿರುವಂತೆ ನೇಮಿಸಿದೆನು. <verse eid="1CH 17:7"/><verse number="8" style="v" sid="1CH 17:8"/>ನೀನು ಎಲ್ಲಿ ಹೋದರೂ ಅಲ್ಲಿ ನಿನ್ನ ಸಂಗಡ ಇದ್ದು, ನಿನ್ನ ಶತ್ರುಗಳನ್ನೆಲ್ಲಾ ನಿನ್ನ ಮುಂದೆಯೇ ಸಂಹರಿಸಿದೆನು. ಭೂಮಿಯಲ್ಲಿರುವ ಮಹಾಪುರುಷರ ಹೆಸರಿನ ಹಾಗೆ ನಿನ್ನ ಹೆಸರನ್ನೂ ಪ್ರಸಿದ್ಧಪಡಿಸುವೆನು. <verse eid="1CH 17:8"/><verse number="9" style="v" sid="1CH 17:9"/>ಇದಲ್ಲದೆ ನಾನು ನನ್ನ ಜನರಾದ ಇಸ್ರಾಯೇಲರಿಗೆ ಒಂದು ಸ್ಥಳವನ್ನು ಏರ್ಪಡಿಸಿ, ಅವರು ಇನ್ನು ಮೇಲೆ ಯಾವ ಭಯವೂ ಇಲ್ಲದೆ ಸ್ವಸ್ಥಳದಲ್ಲಿ ವಾಸವಾಗಿರುವ ಹಾಗೆ ಅವರನ್ನು ನೆಲೆಗೊಳಿಸುವೆನು. <verse eid="1CH 17:9"/><verse number="10" style="v" sid="1CH 17:10"/>ಪೂರ್ವಕಾಲದಲ್ಲಿ ನಾನು ನನ್ನ ಜನರಾದ ಇಸ್ರಾಯೇಲರ ಮೇಲೆ ನ್ಯಾಯಾಧಿಪತಿಗಳನ್ನು ನೇಮಿಸಿದೆ. ಆ ದಿವಸದಿಂದ ಈಚೆಗೆ, ದುಷ್ಟರು ಇನ್ನು ಮೇಲೆ ಇಸ್ರಾಯೇಲರನ್ನು ಕುಗ್ಗಿಸದೆ ಇರುವರು. ನಾನು ನಿನ್ನ ಸಮಸ್ತ ಶತ್ರುಗಳನ್ನು ತಗ್ಗಿಸಿದ್ದೇನೆ.</para>
  <para style="pm" vid="1CH 17:10">“ ‘ಯೆಹೋವ ದೇವರಾದ ನಾನು ನಿನಗೆ ಮನೆಯನ್ನು ಕಟ್ಟುವೆನು, ಎಂದು ನಿನಗೆ ತಿಳಿಸುತ್ತೇನೆ. <verse eid="1CH 17:10"/><verse number="11" style="v" sid="1CH 17:11"/>ನಿನ್ನ ಆಯುಷ್ಕಾಲವು ಮುಗಿದ ಮೇಲೆ, ನೀನು ನಿನ್ನ ಪಿತೃಗಳ ಬಳಿಗೆ ಹೋಗಿ ವಿಶ್ರಮಿಸುವಾಗ, ನಾನು ನಿನ್ನ ಸಂತತಿಯಲ್ಲಿ ಒಬ್ಬನನ್ನು ನಿನ್ನ ಉತ್ತರಾಧಿಕಾರಿಯನ್ನಾಗಿ ನೇಮಿಸಿ, ಅವನ ರಾಜ್ಯವನ್ನು ಸ್ಥಿರಮಾಡುವೆನು. <verse eid="1CH 17:11"/><verse number="12" style="v" sid="1CH 17:12"/>ಅವನೇ ನನಗೆ ದೇವಾಲಯವನ್ನು ಕಟ್ಟುವನು. ನಾನು ಅವನ ರಾಜಸಿಂಹಾಸನವನ್ನು ಸದಾಕಾಲಕ್ಕೂ ಸ್ಥಿರಮಾಡುವೆನು. <verse eid="1CH 17:12"/><verse number="13" style="v" sid="1CH 17:13"/>ನಾನು ಅವನ ತಂದೆಯಾಗಿರುವೆನು. ಅವನು ನನಗೆ ಮಗನಾಗಿರುವನು. ನಿನಗಿಂತ ಮುಂಚೆ ಇದ್ದವನ ಮೇಲಿಂದ ನನ್ನ ಪ್ರೀತಿಯನ್ನು ಹಿಂತೆಗೆದುಕೊಂಡ ಹಾಗೆ ಎಂದಿಗೂ ಅವನಿಂದ ಹಿಂತೆಗೆಯುವುದಿಲ್ಲ. <verse eid="1CH 17:13"/><verse number="14" style="v" sid="1CH 17:14"/>ಅವನನ್ನು ನನ್ನ ಮನೆಯಲ್ಲಿಯೂ, ನನ್ನ ರಾಜ್ಯದಲ್ಲಿಯೂ ಸದಾಕಾಲಕ್ಕೂ ಸ್ಥಿರಗೊಳಿಸುವೆನು. ಅವನ ಸಿಂಹಾಸನವು ಯುಗಯುಗಾಂತರಕ್ಕೂ ಶಾಶ್ವತವಾಗಿರುವುದು,’ ” ಎಂದು ಹೇಳಿದರು.<verse eid="1CH 17:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="1CH 17:15"/>ನಾತಾನನು ಈ ಸಮಸ್ತ ಪ್ರಕಟಣೆಯ ಮಾತುಗಳನ್ನು ದಾವೀದನಿಗೆ ತಿಳಿಸಿದನು.<verse eid="1CH 17:15"/></para>
  <para style="s1">ದಾವೀದನ ಪ್ರಾರ್ಥನೆ</para>
  <para style="p">
    <verse number="16" style="v" sid="1CH 17:16"/>ಅನಂತರ ಅರಸನಾದ ದಾವೀದನು ಒಳಗೆ ಪ್ರವೇಶಿಸಿ, ಯೆಹೋವ ದೇವರ ಸನ್ನಿಧಿಯಲ್ಲಿ ಕುಳಿತುಕೊಂಡು,</para>
  <para style="pm" vid="1CH 17:16">“ದೇವರೇ, ಯೆಹೋವ ದೇವರೇ, ನನ್ನಂಥವನಿಗೆ ನೀವು ಈ ಪದವಿಯನ್ನು ಅನುಗ್ರಹಿಸಿ, ಇಷ್ಟು ಮುಂದಕ್ಕೆ ತರಲು ನಾನೆಷ್ಟರವನು? ನನ್ನ ಕುಟುಂಬ ಎಷ್ಟರದು? <verse eid="1CH 17:16"/><verse number="17" style="v" sid="1CH 17:17"/>ಯೆಹೋವ ದೇವರೇ, ಇದು ನಿಮ್ಮ ದೃಷ್ಟಿಯಲ್ಲಿ ಅಲ್ಪವೆಂದು ಕಾಣಿಸಿದರೂ ನೀವು ನಿಮ್ಮ ಸೇವಕನ ಸಂತಾನದ ಭವಿಷ್ಯದ ಕುರಿತೂ ವಾಗ್ದಾನಮಾಡಿರುವಿರಿ. ಯೆಹೋವ ದೇವರೇ, ನೀವು ನನ್ನನ್ನು ಮನುಷ್ಯರಲ್ಲಿ ಅತ್ಯುನ್ನತ ವ್ಯಕ್ತಿಯಂತೆ ನೋಡಿರುವಿರಿ.<verse eid="1CH 17:17"/></para>
  <para style="pm">
    <verse number="18" style="v" sid="1CH 17:18"/>“ನಿಮ್ಮ ಸೇವಕನ ಘನತೆಯ ನಿಮಿತ್ತ, ದಾವೀದನು ಇನ್ನೂ ಹೆಚ್ಚಾಗಿ ಹೇಳಿಕೊಳ್ಳುವುದೇನಿದೆ? ಏಕೆಂದರೆ ನೀವು ನಿಮ್ಮ ಸೇವಕನನ್ನು ಚೆನ್ನಾಗಿ ಬಲ್ಲಿರಿ. <verse eid="1CH 17:18"/><verse number="19" style="v" sid="1CH 17:19"/>ಯೆಹೋವ ದೇವರೇ, ನಿಮ್ಮ ಸೇವಕನ ನಿಮಿತ್ತವಾಗಿಯೂ, ನಿಮ್ಮ ಚಿತ್ತಾನುಸಾರವಾಗಿಯೂ ಈ ಮಹಾಕಾರ್ಯಗಳನ್ನೆಲ್ಲಾ ನಡೆಸಿ, ಎಲ್ಲ ವಾಗ್ದಾನಗಳನ್ನು ತಿಳಿಯಪಡಿಸಿರುವಿರಿ.<verse eid="1CH 17:19"/></para>
  <para style="pm">
    <verse number="20" style="v" sid="1CH 17:20"/>“ಯೆಹೋವ ದೇವರೇ, ನಮ್ಮ ಕಿವಿಗಳಿಂದ ನಾವು ಕೇಳಿದವುಗಳನ್ನೆಲ್ಲಾ ಆಲೋಚಿಸಿ ನೋಡಿದರೆ ನಿಮ್ಮ ಹಾಗೆ ಯಾರೂ ಇಲ್ಲ; ನಿಮ್ಮ ಹೊರತು ದೇವರು ಯಾರೂ ಇಲ್ಲ. <verse eid="1CH 17:20"/><verse number="21" style="v" sid="1CH 17:21"/>ಭೂಲೋಕದಲ್ಲಿ ನಿಮ್ಮ ಜನರಾದ ಇಸ್ರಾಯೇಲರಿಗೆ ಸಮಾನವಾದ ಜನಾಂಗ ಯಾವುದು? ದೇವರಾದ ನೀವೇ ಹೋಗಿ ಅವರನ್ನು ಸ್ವಜನರಾಗಿ ವಿಮೋಚಿಸಿ ನಿಮ್ಮ ಹೆಸರನ್ನು ಪ್ರಸಿದ್ಧಿಪಡಿಸಿದ್ದೀರಿ. ಈಜಿಪ್ಟಿನಿಂದ ವಿಮೋಚಿಸಿ ತಂದ ನಿಮ್ಮ ಪ್ರಜೆಗಳ ಎದುರಿನಿಂದ ಜನಾಂಗಗಳನ್ನು ಓಡಿಸುವ ಮೂಲಕ ವಿಸ್ಮಯಕರವಾದ ಮಹಾ ಅದ್ಭುತಗಳನ್ನು ಮಾಡಿದ್ದೀರಲ್ಲವೇ? <verse eid="1CH 17:21"/><verse number="22" style="v" sid="1CH 17:22"/>ನೀವು ಇಸ್ರಾಯೇಲ್ ಜನರನ್ನು ಶಾಶ್ವತವಾಗಿ ನಿಮ್ಮ ಸ್ವಂತ ಜನರಾಗಿ ಮಾಡಿದಿರಿ; ಯೆಹೋವ ದೇವರೇ, ನೀವೇ ಅವರಿಗೆ ದೇವರಾದಿರಿ.<verse eid="1CH 17:22"/></para>
  <para style="pm">
    <verse number="23" style="v" sid="1CH 17:23"/>“ಈಗ ಯೆಹೋವ ದೇವರೇ, ನೀವು ನಿಮ್ಮ ಸೇವಕನನ್ನು ಕುರಿತೂ, ಅವನ ಕುಟುಂಬವನ್ನು ಕುರಿತೂ ಮಾಡಿದ ವಾಗ್ದಾನವನ್ನು ನೆರವೇರಿಸಿ ಅದನ್ನು ಶಾಶ್ವತವಾಗಿ ಸ್ಥಿರಪಡಿಸಿರಿ. <verse eid="1CH 17:23"/><verse number="24" style="v" sid="1CH 17:24"/>‘ಇಸ್ರಾಯೇಲಿನ ದೇವರಾದ ಸೇನಾಧೀಶ್ವರ ಯೆಹೋವ ದೇವರು ಇಸ್ರಾಯೇಲ್ ದೇವರಾಗಿದ್ದಾರೆಂದು ನಿಮ್ಮ ನಾಮವು ಶಾಶ್ವತವಾಗಿ ಘನಪಡಲಿ,’ ಎಂದು ಜನರು ಹೇಳಲಿ. ನಿಮ್ಮ ಸೇವಕನಾದ ದಾವೀದನ ಮನೆಯು ನಿಮ್ಮ ಮುಂದೆ ಸ್ಥಿರವಾಗಿರಲಿ.<verse eid="1CH 17:24"/></para>
  <para style="pm">
    <verse number="25" style="v" sid="1CH 17:25"/>“ಏಕೆಂದರೆ ನನ್ನ ದೇವರೇ, ನೀವು ನಿಮ್ಮ ಸೇವಕನಿಗೆ ಮನೆಯನ್ನು ಕಟ್ಟುವೆನೆಂದು ಪ್ರಕಟ ಮಾಡಿದ್ದರಿಂದ ನಿಮ್ಮನ್ನು ಪ್ರಾರ್ಥಿಸುವುದಕ್ಕೆ ನಿಮ್ಮ ಸೇವಕನ ಹೃದಯದಲ್ಲಿ ಧೈರ್ಯ ಉಂಟಾಯಿತು. <verse eid="1CH 17:25"/><verse number="26" style="v" sid="1CH 17:26"/>ಯೆಹೋವ ದೇವರೇ, ನಿಮ್ಮ ಸೇವಕನಿಗೆ ಈ ಒಳ್ಳೆಯ ಸಂಗತಿಗಳನ್ನು ವಾಗ್ದಾನಮಾಡಿದ ನೀವು ದೇವರಾಗಿದ್ದೀರಿ. <verse eid="1CH 17:26"/><verse number="27" style="v" sid="1CH 17:27"/>ಈಗ ನಿಮ್ಮ ಸೇವಕನ ಮನೆಯು ನಿಮ್ಮ ಮುಂದೆ ಶಾಶ್ವತವಾಗಿ ಇರುವ ಹಾಗೆ, ಅದನ್ನು ಆಶೀರ್ವದಿಸಲು ಸಂತೋಷಪಡಿರಿ; ಯೆಹೋವ ದೇವರೇ, ನೀವು ಆಶೀರ್ವದಿಸಿದ್ದೀರಿ, ಅದು ನಿತ್ಯ ಆಶೀರ್ವಾದ ಹೊಂದಿರುವುದು.”<verse eid="1CH 17:27"/></para>
  <chapter eid="1CH 17"/>
  <chapter number="18" style="c" sid="1CH 18"/>
  <para style="s1">ದಾವೀದನ ವಿಜಯಗಳು</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 18:1"/>ಇದರ ತರುವಾಯ ದಾವೀದನು ಫಿಲಿಷ್ಟಿಯರ ಮೇಲೆ ದಾಳಿಮಾಡಿ ಅವರನ್ನು ಸೋಲಿಸಿ, ಅವರಿಂದ ಗತ್ ಪಟ್ಟಣವನ್ನೂ ಅದರ ಸುತ್ತಲಿನ ಗ್ರಾಮಗಳನ್ನೂ ತೆಗೆದುಕೊಂಡು, ಆಡಳಿತವನ್ನು ತನ್ನ ಸ್ವಾಧೀನದಲ್ಲಿಟ್ಟುಕೊಂಡನು.<verse eid="1CH 18:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="1CH 18:2"/>ಹಾಗೆಯೇ ಅವನು ಮೋವಾಬ್ಯರನ್ನು ಸಹ ಸೋಲಿಸಿದನು, ಮೋವಾಬ್ಯರು ದಾವೀದನಿಗೆ ಅಧೀನರಾಗಿ ಕಪ್ಪಕೊಡುವವರಾದರು.<verse eid="1CH 18:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="1CH 18:3"/>ಇದಲ್ಲದೆ ದಾವೀದನು ಯೂಫ್ರೇಟೀಸ್ ನದಿಯ ಬಳಿಯಲ್ಲಿ ತನ್ನ ಅಧಿಕಾರವನ್ನು ಸ್ಥಾಪಿಸುವದಕ್ಕೆ ಹೋಗುತ್ತಿರುವಾಗ, ಹಮಾತಿನ ಬಳಿಯಲ್ಲಿ ಚೋಬದ ಅರಸನಾದ ಹದದೆಜೆರನನ್ನು ಸೋಲಿಸಿದನು. <verse eid="1CH 18:3"/><verse number="4" style="v" sid="1CH 18:4"/>ದಾವೀದನು ಅವನಿಂದ ಸಾವಿರ ರಥಗಳನ್ನೂ, ಏಳು ಸಾವಿರ ರಾಹುತರನ್ನೂ, ಇಪ್ಪತ್ತು ಸಾವಿರ ಕಾಲಾಳುಗಳನ್ನೂ ವಶಪಡಿಸಿಕೊಂಡನು. ನೂರು ರಥಗಳಿಗೆ ಕುದುರೆಗಳನ್ನು ಉಳಿಸಿ, ಇತರ ಕುದುರೆಗಳ ಕಾಲಿನ ನರಗಳನ್ನು ಕೊಯ್ಯಿಸಿಬಿಟ್ಟನು.<verse eid="1CH 18:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="1CH 18:5"/>ದಮಸ್ಕದ ಅರಾಮ್ಯರು ಚೋಬದ ಅರಸ ಹದದೆಜೆರನಿಗೆ ಸಹಾಯಮಾಡಲು ಬಂದಾಗ, ದಾವೀದನು ಅರಾಮ್ಯರಲ್ಲಿ ಇಪ್ಪತ್ತೆರಡು ಸಾವಿರ ಜನರನ್ನು ಸಂಹರಿಸಿಬಿಟ್ಟನು. <verse eid="1CH 18:5"/><verse number="6" style="v" sid="1CH 18:6"/>ತರುವಾಯ ದಾವೀದನು ದಮಸ್ಕದ ಅರಾಮಿನಲ್ಲಿ ಕಾವಲುದಂಡುಗಳನ್ನು ಇಟ್ಟನು. ಹೀಗೆ ಅರಾಮ್ಯರು ದಾವೀದನಿಗೆ ಅಧೀನರಾಗಿ, ಕಪ್ಪವನ್ನು ಕೊಡುವವರಾದರು. ದಾವೀದನು ಹೋದ ಸ್ಥಳಗಳಲ್ಲೆಲ್ಲಾ ಯೆಹೋವ ದೇವರು ಅವನಿಗೆ ಜಯಕೊಟ್ಟರು.<verse eid="1CH 18:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="1CH 18:7"/>ಆಗ ದಾವೀದನು ಹದದೆಜೆರನ ಸೇವಕರಿಗಿದ್ದ ಬಂಗಾರದ ಗುರಾಣಿಗಳನ್ನು ತೆಗೆದುಕೊಂಡು, ಅವುಗಳನ್ನು ಯೆರೂಸಲೇಮಿಗೆ ತಂದನು. <verse eid="1CH 18:7"/><verse number="8" style="v" sid="1CH 18:8"/>ಇದಲ್ಲದೆ ಹದದೆಜೆರನ ಪಟ್ಟಣಗಳಾದ ಟಿಭತಿನಿಂದಲೂ, ಕೂನ್‌ದಿಂದಲೂ ದಾವೀದನು ಅತ್ಯಧಿಕವಾಗಿ ಕಂಚನ್ನು ತೆಗೆದುಕೊಂಡು ಬಂದನು. ಅದರಿಂದ ಸೊಲೊಮೋನನು ಕಂಚಿನ ಕೊಳವನ್ನೂ, ಸ್ತಂಭಗಳನ್ನೂ, ವಿವಿಧ ಪಾತ್ರೆಗಳನ್ನೂ ಮಾಡಿಸಿದನು.<verse eid="1CH 18:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="1CH 18:9"/>ದಾವೀದನು ಚೋಬದ ಅರಸನಾದ ಹದದೆಜೆರನ ಸಮಸ್ತ ಸೈನ್ಯವನ್ನು ಸೋಲಿಸಿದನೆಂಬ ವರ್ತಮಾನವನ್ನು ಹಮಾತಿನ ಅರಸನಾದ ತೋವು ಕೇಳಿದಾಗ, <verse eid="1CH 18:9"/><verse number="10" style="v" sid="1CH 18:10"/>ಅರಸನಾದ ದಾವೀದನ ಕ್ಷೇಮಸಮಾಚಾರವನ್ನು ವಿಚಾರಿಸಲೂ, ಹದದೆಜೆರನ ವಿರುದ್ಧ ಯುದ್ಧಮಾಡಿ ಅವನನ್ನು ಸೋಲಿಸಿದ್ದಕ್ಕಾಗಿ ಅವನನ್ನು ಅಭಿನಂದಿಸಿ, ಹರಸುವಂತೆ, ತೋವು ತನ್ನ ಪುತ್ರನಾದ ಹದೋರಾಮನನ್ನು ಎಲ್ಲಾ ತರವಾದ ಬೆಳ್ಳಿ, ಬಂಗಾರ, ಕಂಚಿನ ಪಾತ್ರೆಗಳ ಸಹಿತವಾಗಿ ದಾವೀದನ ಬಳಿಗೆ ಕಳುಹಿಸಿದನು; ಏಕೆಂದರೆ ಹದದೆಜೆರನಿಗೆ ತೋವಿಯ ಸಂಗಡ ಯುದ್ಧಗಳಿದ್ದವು.<verse eid="1CH 18:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="1CH 18:11"/>ಇವುಗಳನ್ನು ಅರಸನಾದ ದಾವೀದನು ಎದೋಮ್ಯರು, ಮೋವಾಬ್ಯರು, ಅಮ್ಮೋನ್ಯರು, ಫಿಲಿಷ್ಟಿಯರು, ಅಮಾಲೇಕ್ಯರು ಎಂಬ ಸಕಲ ಜನಾಂಗಗಳ ಬಳಿಯಿಂದ ತೆಗೆದುಕೊಂಡು ಬಂದ ಬೆಳ್ಳಿಬಂಗಾರವನ್ನು ಯೆಹೋವ ದೇವರಿಗೆ ಪ್ರತಿಷ್ಠೆ ಮಾಡಿದನು.<verse eid="1CH 18:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="1CH 18:12"/>ಇದಲ್ಲದೆ ಚೆರೂಯಳ ಮಗ ಅಬೀಷೈಯನು ಉಪ್ಪಿನ ತಗ್ಗಿನಲ್ಲಿ ಹದಿನೆಂಟು ಸಾವಿರ ಎದೋಮ್ಯರ ಸೈನಿಕರನ್ನು ಕೊಂದನು. <verse eid="1CH 18:12"/><verse number="13" style="v" sid="1CH 18:13"/>ಎದೋಮಿನಲ್ಲಿ ಕಾವಲುದಂಡುಗಳನ್ನು ಇಟ್ಟನು. ಇದರಿಂದ, ಎದೋಮ್ಯರೆಲ್ಲರು ದಾವೀದನಿಗೆ ಅಧೀನರಾದರು. ದಾವೀದನು ಹೋದಲ್ಲೆಲ್ಲಾ ಯೆಹೋವ ದೇವರು ಅವನಿಗೆ ಜಯಕೊಟ್ಟರು.<verse eid="1CH 18:13"/></para>
  <para style="s1">ದಾವೀದನ ಸರದಾರರು</para>
  <para style="p">
    <verse number="14" style="v" sid="1CH 18:14"/>ಹೀಗೆಯೇ ದಾವೀದನು ಸಮಸ್ತ ಇಸ್ರಾಯೇಲಿನ ಮೇಲೆ ಆಳುತ್ತಾ ತನ್ನ ಸಮಸ್ತ ಜನರಿಗೂ ನೀತಿ ನ್ಯಾಯಗಳಿಂದ ನಡೆಸುತ್ತಿದ್ದನು.<verse eid="1CH 18:14"/></para>
  <para style="b"/>
  <para style="li1">
    <verse number="15" style="v" sid="1CH 18:15"/>ಚೆರೂಯಳ ಮಗ ಯೋವಾಬನು ಸೈನ್ಯದ ಅಧಿಪತಿಯಾಗಿದ್ದನು. ಅಹೀಲೂದನ ಮಗ ಯೆಹೋಷಾಫಾಟನು ಆಸ್ಥಾನದ</para>
  <para style="li1" vid="1CH 18:15">ಆಗುಹೋಗುಗಳನ್ನು ದಾಖಲಿಸುವವನಾಗಿದ್ದನು.<verse eid="1CH 18:15"/></para>
  <para style="li1">
    <verse number="16" style="v" sid="1CH 18:16"/>ಅಹೀಟೂಬನ ಮಗ ಚಾದೋಕನೂ, ಅಬಿಯಾತರನ ಮಗ ಅಹೀಮೆಲೆಕನೂ ಯಾಜಕರಾಗಿದ್ದರು.</para>
  <para style="li1" vid="1CH 18:16">ಶವ್ಷನು ಕಾರ್ಯದರ್ಶಿಯಾಗಿದ್ದನು.<verse eid="1CH 18:16"/></para>
  <para style="li1">
    <verse number="17" style="v" sid="1CH 18:17"/>ಯೆಹೋಯಾದಾವನ ಮಗ ಬೆನಾಯನು ಕೆರೇತ್ಯರ ಮೇಲೆಯೂ, ಪೆಲೇತ್ಯರ ಮೇಲೆಯೂ ಮುಖ್ಯಸ್ಥನಾಗಿದ್ದನು.</para>
  <para style="li1" vid="1CH 18:17">ದಾವೀದನ ಪುತ್ರರು ಅರಸನ ಬಳಿಯಲ್ಲಿ ಪ್ರಧಾನರಾಗಿದ್ದರು.<verse eid="1CH 18:17"/></para>
  <chapter eid="1CH 18"/>
  <chapter number="19" style="c" sid="1CH 19"/>
  <para style="s1">ಅಮ್ಮೋನ್ಯರ ವಿರುದ್ಧ ಯುದ್ಧ</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 19:1"/>ಇದರ ತರುವಾಯ, ಅಮ್ಮೋನಿಯರ ಅರಸನಾದ ನಾಹಾಷನು ಮರಣಹೊಂದಿದನು; ಅವನಿಗೆ ಬದಲಾಗಿ ಅವನ ಮಗನು ಅರಸನಾದನು. <verse eid="1CH 19:1"/><verse number="2" style="v" sid="1CH 19:2"/>ಆಗ ದಾವೀದನು, “ಹಾನೂನನ ತಂದೆಯಾದ ನಾಹಾಷನು ನನಗೆ ದಯೆ ತೋರಿಸಿದ್ದರಿಂದ, ನಾನೂ ಅವನ ಮಗ ಹಾನೂನನಿಗೆ ದಯೆ ತೋರಿಸುವೆನು,” ಎಂದನು. ದಾವೀದನು ಅವನ ತಂದೆಯನ್ನು ಕುರಿತು ಹಾನೂನನಿಗೆ ಸಂತಾಪ ಸೂಚಿಸಲು ತನ್ನ ಸೇವಕರನ್ನು ಕಳುಹಿಸಿದನು.</para>
  <para style="p" vid="1CH 19:2">ಹೀಗೆಯೇ ದಾವೀದನ ದೂತರು ಹಾನೂನನಿಗೆ ಸಂತಾಪ ಸೂಚಿಸಲು, ಅಮ್ಮೋನಿಯರ ದೇಶಕ್ಕೆ ಬಂದರು. <verse eid="1CH 19:2"/><verse number="3" style="v" sid="1CH 19:3"/>ಆಗ ಅಮ್ಮೋನಿಯರ ಪ್ರಧಾನರು ಹಾನೂನನಿಗೆ, “ದಾವೀದನು ನಿನ್ನ ಬಳಿಗೆ ಸಂತಾಪ ಸೂಚಿಸುವವರನ್ನು ಕಳುಹಿಸಿದ್ದರಿಂದ, ನಿನ್ನ ತಂದೆಯನ್ನು ಘನಪಡಿಸುತ್ತಾನೆಂದು ಯೋಚಿಸುತ್ತೀಯೋ? ಅವನ ದೂತರು ಈ ದೇಶವನ್ನು ಸಂಚರಿಸಿ ನೋಡುವುದಕ್ಕೂ ಶೋಧಿಸುವುದಕ್ಕೂ ಅದನ್ನು ಕೆಡವಿ ಹಾಕುವುದಕ್ಕೂ ನಿನ್ನ ಬಳಿಗೆ ಬರಲಿಲ್ಲವೋ?” ಎಂದರು. <verse eid="1CH 19:3"/><verse number="4" style="v" sid="1CH 19:4"/>ಆದ್ದರಿಂದ ಹಾನೂನನು ದಾವೀದನ ದೂತರನ್ನು ಹಿಡಿದು ಅವರ ಗಡ್ಡ, ತಲೆ ಬೋಳಿಸಿ, ಅವರ ವಸ್ತ್ರಗಳನ್ನು ಬೆನ್ನ ಹಿಂದೆ ಮಧ್ಯದಿಂದ ಸೊಂಟದ ಕೆಳಗಿನವರೆಗೂ ಕತ್ತರಿಸಿ, ಅವರನ್ನು ಕಳುಹಿಸಿಬಿಟ್ಟನು.<verse eid="1CH 19:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="1CH 19:5"/>ಆಗ ಕೆಲವರು ಹೋಗಿ, ಈ ಮನುಷ್ಯರನ್ನು ಕುರಿತು ದಾವೀದನಿಗೆ ತಿಳಿಸಿದಾಗ, ಬಹಳ ಅಪಮಾನ ಹೊಂದಿದ ಅವರಿಗೆ ದಾವೀದನು ತನ್ನ ಆಳುಗಳನ್ನು ಅವರಿಗೆದುರಾಗಿ ಕಳುಹಿಸಿ, “ನಿಮ್ಮ ಗಡ್ಡಗಳು ಬೆಳೆಯುವವರೆಗೂ ಯೆರಿಕೋವಿನಲ್ಲಿ ಇರಿ. ಆಮೇಲೆ ತಿರುಗಿ ಬನ್ನಿರಿ,” ಎಂದು ಹೇಳಿಸಿದನು.<verse eid="1CH 19:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="1CH 19:6"/>ತಾವು ದಾವೀದನಿಗೆ ಅಸಹ್ಯರಾದೆವೆಂದು ಹಾನೂನನಿಗೆ ಮತ್ತು ಅಮ್ಮೋನಿಯರಿಗೆ ತಿಳಿಯಿತು. ಆದ್ದರಿಂದ ಅರಾಮಿನಲ್ಲಿಯೂ<note caller="+" style="f"><char style="fr" closed="false">19:6 </char><char style="ft" closed="false">ಅಂದರೆ, ಅದು ಮೆಸೊಪೊತಾಮ್ಯ</char></note>, ಅರಾಮ್ ಮಾಕದಲ್ಲಿಯೂ, ಚೋಬದಲ್ಲಿಯೂ ರಥಗಳನ್ನೂ, ರಾಹುತರನ್ನೂ ಕೂಲಿಗೆ ತೆಗೆದುಕೊಳ್ಳಲು ಮೂವತ್ತು ನಾಲ್ಕು ಸಾವಿರ ಕಿಲೋಗ್ರಾಂ ಬೆಳ್ಳಿಯನ್ನು ಕಳುಹಿಸಿದರು. <verse eid="1CH 19:6"/><verse number="7" style="v" sid="1CH 19:7"/>ಹೀಗೆಯೇ ಅವರು ಮೂವತ್ತೆರಡು ಸಾವಿರ ರಥಗಳನ್ನೂ, ಮಾಕದ ಅರಸನನ್ನೂ, ಅವನ ಜನರನ್ನೂ ಕೂಲಿಗೆ ತೆಗೆದುಕೊಂಡರು. ಇವರು ಬಂದು ಮೇದೆಬ ಊರಿನ ಬಳಿಯಲ್ಲಿ ದಂಡಿಳಿದರು. ಇದಲ್ಲದೆ ಅಮ್ಮೋನಿಯರು ತಮ್ಮ ಪಟ್ಟಣಗಳಿಂದ ಯುದ್ಧಕ್ಕೆ ಕೂಡಿಬಂದರು.<verse eid="1CH 19:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="1CH 19:8"/>ದಾವೀದನು ಇದನ್ನು ಕೇಳಿದಾಗ, ಅವನು ಯೋವಾಬನನ್ನೂ, ಪರಾಕ್ರಮಶಾಲಿಗಳಾದ ಸಮಸ್ತ ಸೈನಿಕರನ್ನೂ ಕಳುಹಿಸಿದನು. <verse eid="1CH 19:8"/><verse number="9" style="v" sid="1CH 19:9"/>ಆಗ ಅಮ್ಮೋನಿಯರು ಹೊರಟು, ಪಟ್ಟಣದ ದ್ವಾರದ ಹತ್ತಿರ ವ್ಯೂಹ ಕಟ್ಟಿದರು. ಆದರೆ ಅವರ ಸಹಾಯಕ್ಕಾಗಿ ಬಂದ ಅರಸರು ಪ್ರತ್ಯೇಕವಾಗಿ ಬೈಲಿನಲ್ಲಿ ಇಳಿದುಕೊಂಡಿದ್ದರು.<verse eid="1CH 19:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="1CH 19:10"/>ಯೋವಾಬನು, ಯುದ್ಧವು ತನ್ನ ವಿರೋಧವಾಗಿ ಹಿಂದೆಯೂ, ಮುಂದೆಯೂ ಇರುವುದನ್ನು ಕಂಡಾಗ, ಅವನು ಇಸ್ರಾಯೇಲಿನ ಎಲ್ಲಾ ಶ್ರೇಷ್ಠ ಸೈನಿಕರನ್ನು ಆಯ್ದುಕೊಂಡು, ಅರಾಮ್ಯರಿಗೆ ಎದುರಾಗಿ ನಿಲ್ಲಿಸಿದನು. <verse eid="1CH 19:10"/><verse number="11" style="v" sid="1CH 19:11"/>ಆದರೆ ಉಳಿದ ಜನರನ್ನು ಅಮ್ಮೋನಿಯರಿಗೆದುರಾಗಿ ವ್ಯೂಹ ಕಟ್ಟುವ ಹಾಗೆ, ಅವರನ್ನು ತನ್ನ ತಮ್ಮನಾದ ಅಬೀಷೈಯನ ಕೈಯಲ್ಲಿ ಒಪ್ಪಿಸಿಕೊಟ್ಟು, <verse eid="1CH 19:11"/><verse number="12" style="v" sid="1CH 19:12"/>ಅವನಿಗೆ ಯೋವಾಬನು, “ಅರಾಮ್ಯರು ನನಗಿಂತ ಬಲವುಳ್ಳವರಾದರೆ, ನೀನು ನನಗೆ ಸಹಾಯಮಾಡಬೇಕು; ಅಮ್ಮೋನಿಯರು ನಿನಗಿಂತ ಬಲವುಳ್ಳವರಾದರೆ, ನಾನು ಬಂದು ನಿನಗೆ ಸಹಾಯ ಮಾಡುವೆನು. <verse eid="1CH 19:12"/><verse number="13" style="v" sid="1CH 19:13"/>ದೃಢವಾಗಿರು; ನಾವು ನಮ್ಮ ಜನರಿಗೋಸ್ಕರವೂ, ನಮ್ಮ ದೇವರ ಪಟ್ಟಣಗಳಿಗೋಸ್ಕರವೂ ಧೈರ್ಯವಾಗಿ ಹೋರಾಡೋಣ. ಯೆಹೋವ ದೇವರು ತಮ್ಮ ದೃಷ್ಟಿಗೆ ಉತ್ತಮವಾದದ್ದನ್ನು ಮಾಡಲಿ,” ಎಂದನು.<verse eid="1CH 19:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="1CH 19:14"/>ಆಗ ಯೋವಾಬನೂ, ಅವನ ಸಂಗಡ ಇದ್ದ ಜನರೂ ಅರಾಮ್ಯರ ಮೇಲೆ ದಾಳಿಮಾಡಲು ಹತ್ತಿರವಾದಾಗ, ಅರಾಮ್ಯರು ಓಡಿಹೋದರು. <verse eid="1CH 19:14"/><verse number="15" style="v" sid="1CH 19:15"/>ಅರಾಮ್ಯರು ಓಡಿ ಹೋದದ್ದನ್ನು ಅಮ್ಮೋನಿಯರು ಕಂಡಾಗ, ಅವರೂ ಸಹ ಯೋವಾಬನ ತಮ್ಮನಾದ ಅಬೀಷೈಯನ ಎದುರಿನಿಂದ ಓಡಿಹೋಗಿ, ಪಟ್ಟಣದೊಳಗೆ ಅಡಗಿಕೊಂಡರು. ಆಗ ಯೋವಾಬನು ಯೆರೂಸಲೇಮಿಗೆ ತಿರುಗಿಹೋದನು.<verse eid="1CH 19:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="1CH 19:16"/>ಅರಾಮ್ಯರಿಗೆ ತಾವು ಇಸ್ರಾಯೇಲರಿಂದ ಸೋತುಹೋದೆವೆಂದು ತಿಳಿದಾಗ, ಅವರು ದೂತರನ್ನು ಕಳುಹಿಸಿ, ಯೂಫ್ರೇಟೀಸ್ ನದಿಯ ಆಚೆಯಲ್ಲಿರುವ ಇತರ ಅರಾಮ್ಯರನ್ನು ಕರೆಯಿಸಿಕೊಂಡರು. ಹದದೆಜೆರನ ಸೇನಾಧಿಪತಿಯಾದ ಶೋಫಕನು ಅವರ ನಾಯಕನಾದನು.<verse eid="1CH 19:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="1CH 19:17"/>ಅದನ್ನು ದಾವೀದನಿಗೆ ತಿಳಿಸಿದಾಗ, ಅವನು ಸಮಸ್ತ ಇಸ್ರಾಯೇಲರನ್ನು ಕೂಡಿಸಿಕೊಂಡು, ಯೊರ್ದನನ್ನು ದಾಟಿ, ಅವರಿಗೆದುರಾಗಿ ವ್ಯೂಹ ಕಟ್ಟಿದನು. ದಾವೀದನು ಅರಾಮ್ಯರಿಗೆದುರಾಗಿ ಸೈನ್ಯವನ್ನು ವ್ಯೂಹ ಕಟ್ಟಿದ ಮೇಲೆ, ಅವರು ಅವನ ವಿರುದ್ಧ ಯುದ್ಧಮಾಡಿದರು. <verse eid="1CH 19:17"/><verse number="18" style="v" sid="1CH 19:18"/>ಆದರೆ ಅರಾಮ್ಯರು ಇಸ್ರಾಯೇಲರ ಎದುರಿನಿಂದ ಓಡಿದರು. ದಾವೀದನು ಅರಾಮ್ಯರಲ್ಲಿ ಏಳು ಸಾವಿರ ರಥಗಳನ್ನೂ ಹಾಳು ಮಾಡಿ, ನಲವತ್ತು ಸಾವಿರ ಕಾಲಾಳುಗಳನ್ನೂ, ಅವರ ಸೇನಾಧಿಪತಿಯಾದ ಶೋಫಕನನ್ನೂ ಕೊಂದುಹಾಕಿದನು.<verse eid="1CH 19:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="1CH 19:19"/>ಹದದೆಜೆರನ ಅಧೀನ ರಾಜರು ತಾವು ಇಸ್ರಾಯೇಲರ ಮುಂದೆ ಸೋತುಹೋದದ್ದನ್ನು ಕಂಡಾಗ, ಅವರು ದಾವೀದನ ಸಂಗಡ ಸಂಧಾನ ಮಾಡಿಕೊಂಡು, ಅವನಿಗೆ ಅಧೀನರಾದರು.</para>
  <para style="p" vid="1CH 19:19">ತರುವಾಯ ಅರಾಮ್ಯರು ಅಮ್ಮೋನಿಯರಿಗೆ ಮತ್ತೆ ಸಹಾಯ ಮಾಡುವುದಕ್ಕೆ ಮನಸ್ಸಿಲ್ಲದವರಾದರು.<verse eid="1CH 19:19"/></para>
  <chapter eid="1CH 19"/>
  <chapter number="20" style="c" sid="1CH 20"/>
  <para style="s1">ರಬ್ಬ ನಗರವನ್ನು ಸೆರೆಹಿಡಿದದ್ದು</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 20:1"/>ಮರು ವರ್ಷ ವಸಂತ ಕಾಲದಲ್ಲಿ ಅರಸರು ಯುದ್ಧಕ್ಕೆ ಹೊರಡುವ ಸಮಯದಲ್ಲಿ, ಯೋವಾಬನು ಬಲವಾದ ಸೈನ್ಯವನ್ನು ಕರೆದುಕೊಂಡು ಹೋಗಿ, ಅಮ್ಮೋನಿಯರ ಪ್ರಾಂತಗಳನ್ನು ಹಾಳು ಮಾಡಿ, ರಬ್ಬ ನಗರಕ್ಕೆ ಮುತ್ತಿಗೆಹಾಕಿದನು. ಆದರೆ ದಾವೀದನು ಯೆರೂಸಲೇಮಿನಲ್ಲಿಯೇ ಇದ್ದನು. ಯೋವಾಬನು ರಬ್ಬ ಪಟ್ಟಣದ ಮೇಲೆ ದಾಳಿಮಾಡಿ, ಅದನ್ನು ನಾಶಮಾಡಿದನು. <verse eid="1CH 20:1"/><verse number="2" style="v" sid="1CH 20:2"/>ಇದಲ್ಲದೆ ದಾವೀದನು ರಬ್ಬಾ ನಗರಕ್ಕೆ ಬಂದಾಗ, ಮಲ್ಕಾಮ್ ಮೂರ್ತಿಯ ತಲೆಯ ಮೇಲೆ ಇದ್ದ ಕಿರೀಟವನ್ನು ಸಹ ತೆಗೆದುಕೊಂಡನು. ಅದು ಮೂವತ್ತೈದು ಕಿಲೋಗ್ರಾಂ ತೂಕದ್ದಾಗಿತ್ತು. ಅದನ್ನು ಬಂಗಾರದಿಂದಲೂ, ಅಮೂಲ್ಯವಾದ ರತ್ನಗಳಿಂದಲೂ ಅಲಂಕರಿಸಲಾಗಿತ್ತು, ಆ ಕಿರೀಟವನ್ನು ದಾವೀದನ ಶಿರಸ್ಸಿನಲ್ಲಿ ಧರಿಸಲಾಯಿತು. ಆ ಪಟ್ಟಣದೊಳಗಿಂದ ಅತ್ಯಧಿಕವಾದ ಕೊಳ್ಳೆಯನ್ನೂ ತೆಗೆದುಕೊಂಡು ಬಂದನು. <verse eid="1CH 20:2"/><verse number="3" style="v" sid="1CH 20:3"/>ಇದಲ್ಲದೆ ಅವನು ಅದರಲ್ಲಿದ್ದ ಜನರನ್ನು ಹೊರಗೆ ತಂದು, ಅವರನ್ನು ಗರಗಸ ಗುದ್ದಲಿ ಕೊಡಲಿಗಳಿಂದ ಕೆಲಸ ಮಾಡುವದಕ್ಕೂ ಇಟ್ಟನು. ಅದೇ ಪ್ರಕಾರ ದಾವೀದನು ಅಮ್ಮೋನಿಯರ ಸಮಸ್ತ ಪಟ್ಟಣಗಳಿಗೂ ಮಾಡಿದನು. ಅನಂತರ ದಾವೀದನು ಎಲ್ಲಾ ಸೈನಿಕರೊಡನೆ ಯೆರೂಸಲೇಮಿಗೆ ತಿರುಗಿಬಂದನು.<verse eid="1CH 20:3"/></para>
  <para style="s1">ಫಿಲಿಷ್ಟಿಯರ ಸಂಗಡ ಯುದ್ಧ</para>
  <para style="p">
    <verse number="4" style="v" sid="1CH 20:4"/>ಇದರ ತರುವಾಯ, ಫಿಲಿಷ್ಟಿಯರ ಸಂಗಡ ಗೆಜೆರಿನಲ್ಲಿ ಯುದ್ಧನಡೆಯಿತು. ಆಗ ಹುಷಾ ಊರಿನವನಾದ ಸಿಬ್ಬೆಕೈ ಎಂಬವನು ರೆಫಾಯನಾದ ಸಿಪ್ಪೈ ಎಂಬವನನ್ನು ಕೊಂದದ್ದರಿಂದ ಫಿಲಿಷ್ಟಿಯರು ಸೋತುಹೋದರು.<verse eid="1CH 20:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="1CH 20:5"/>ಅನಂತರ ಫಿಲಿಷ್ಟಿಯರ ಸಂಗಡ ಯುದ್ಧ ಉಂಟಾದಾಗ, ಯಾಯೀರನ ಮಗನಾದ ಎಲ್ಹನಾನನು ಗಿತ್ತೀಯನಾದ ಗೊಲ್ಯಾತನ ಸಹೋದರನಾದ ಲಹ್ಮೀಯನ್ನು ಕೊಂದನು. ಈ ಗೊಲ್ಯಾತನ ಈಟಿಯ ಹಿಡಿಕೆಯು ನೇಯುವವರ ಕುಂಟೆ ಕಟ್ಟಿಗೆಗೆ ಸಮನಾಗಿತ್ತು.<verse eid="1CH 20:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="1CH 20:6"/>ಇನ್ನೊಂದು ಸಾರಿ ಗತ್ ಊರಿನಲ್ಲಿ ಯುದ್ಧ ಉಂಟಾದಾಗ, ಅಲ್ಲಿ ಎತ್ತರವಾದ ಒಬ್ಬ ಮನುಷ್ಯನಿದ್ದನು. ಅವನ ಕೈಕಾಲುಗಳ ಬೆರಳುಗಳು ಆರಾರರಂತೆ, ಒಟ್ಟಿಗೆ ಇಪ್ಪತ್ತನಾಲ್ಕು ಬೆರಳುಗಳಿದ್ದವು. ಅವನು ಸಹ ರೆಫಾಯನಿಗೆ ಹುಟ್ಟಿದವನಾಗಿದ್ದನು. <verse eid="1CH 20:6"/><verse number="7" style="v" sid="1CH 20:7"/>ಅವನು ಇಸ್ರಾಯೇಲನ್ನು ನಿಂದಿಸಿದ್ದರಿಂದ ದಾವೀದನ ಸಹೋದರನಾದ ಶಿಮ್ಮನ ಮಗನಾದ ಯೋನಾತಾನನು ಅವನನ್ನು ಕೊಂದುಬಿಟ್ಟನು.<verse eid="1CH 20:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="1CH 20:8"/>ಇವರು ಗತ್ ಊರಿನಲ್ಲಿದ್ದ ರೆಫಾಯರ ವಂಶಜರು. ಇವರು ದಾವೀದನಿಂದಲೂ ಅವನ ಜನರಿಂದಲೂ ಸಂಹಾರವಾಗಿ ಹೋದರು.<verse eid="1CH 20:8"/></para>
  <chapter eid="1CH 20"/>
  <chapter number="21" style="c" sid="1CH 21"/>
  <para style="s1">ದಾವೀದನು ಸೈನ್ಯವನ್ನು ಲೆಕ್ಕಿಸಿದ್ದು</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 21:1"/>ಸೈತಾನನು ಇಸ್ರಾಯೇಲಿಗೆ ವಿರೋಧವಾಗಿ ಎದ್ದು, ಇಸ್ರಾಯೇಲರ ಜನಗಣತಿ ಮಾಡುವುದಕ್ಕೆ ದಾವೀದನನ್ನು ಪ್ರೇರೇಪಿಸಿದನು. <verse eid="1CH 21:1"/><verse number="2" style="v" sid="1CH 21:2"/>ಆದ್ದರಿಂದ ದಾವೀದನು ಯೋವಾಬನನ್ನೂ ಜನರ ಪ್ರಧಾನರನ್ನೂ ಕರೆದು ಅವರಿಗೆ, “ನಾನು ಜನರ ಲೆಕ್ಕವನ್ನು ತಿಳಿಯುವ ಹಾಗೆ, ನೀವು ಹೋಗಿ ಬೇರ್ಷೆಬವು ಮೊದಲುಗೊಂಡು, ದಾನ್ ಊರಿನವರೆಗೆ ಇಸ್ರಾಯೇಲರನ್ನು ಲೆಕ್ಕಿಸಿ, ಅವರ ಲೆಕ್ಕವನ್ನು ನನಗೆ ತೆಗೆದುಕೊಂಡು ಬನ್ನಿರಿ,” ಎಂದನು.<verse eid="1CH 21:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="1CH 21:3"/>ಆಗ ಯೋವಾಬನು, “ಯೆಹೋವ ದೇವರು ತಮ್ಮ ಜನರನ್ನು ಈಗ ಇರುವುದಕ್ಕಿಂತ ನೂರರಷ್ಟಾಗಿ ಹೆಚ್ಚಿಸಲಿ. ಆದರೆ ನನ್ನ ಒಡೆಯನಾದ ಅರಸನೇ, ಅವರೆಲ್ಲರೂ ನನ್ನ ಒಡೆಯನ ಸೇವಕರಲ್ಲವೋ, ನನ್ನ ಒಡೆಯನು ಈ ಕಾರ್ಯವನ್ನು ಅಪೇಕ್ಷಿಸುವುದು ಏಕೆ? ಇದು ಇಸ್ರಾಯೇಲಿನಲ್ಲಿ ಅಪರಾಧಕ್ಕೆ ಕಾರಣವಾಗುವುದು,” ಎಂದನು.<verse eid="1CH 21:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="1CH 21:4"/>ಆದರೆ ಅರಸನ ಮಾತೇ ಯೋವಾಬನಿಗೆ ವಿರೋಧವಾಗಿ ಗೆದ್ದಿತು. ಆಗ ಅವನು ಹೊರಟು, ಇಸ್ರಾಯೇಲಿನ ಸಮಸ್ತ ಪ್ರಾಂತಗಳಿಗೆ ಹೋಗಿ, ಯೆರೂಸಲೇಮಿಗೆ ತಿರುಗಿಬಂದನು. <verse eid="1CH 21:4"/><verse number="5" style="v" sid="1CH 21:5"/>ಯೋವಾಬನು ದಾವೀದನಿಗೆ ಕೊಟ್ಟ ಜನರ ಒಟ್ಟು ಲೆಕ್ಕವೇನೆಂದರೆ: ಸಮಸ್ತ ಇಸ್ರಾಯೇಲರಲ್ಲಿ ಖಡ್ಗ ಹಿಡಿಯತಕ್ಕ ಪರಾಕ್ರಮವುಳ್ಳ ಹನ್ನೊಂದು ಲಕ್ಷಮಂದಿ ಇದ್ದರು. ಯೆಹೂದದ ಜನರು ನಾಲ್ಕು ಲಕ್ಷದ ಎಪ್ಪತ್ತು ಸಾವಿರ ಮಂದಿ ಇದ್ದರು.<verse eid="1CH 21:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="1CH 21:6"/>ಆದರೆ ಲೇವಿಯರನ್ನೂ, ಬೆನ್ಯಾಮೀನರನ್ನೂ ಅವರಲ್ಲಿ ಎಣಿಸಲಿಲ್ಲ. ಏಕೆಂದರೆ ಅರಸನ ಮಾತು ಯೋವಾಬನಿಗೆ ಅಸಹ್ಯಕರವಾಗಿತ್ತು. <verse eid="1CH 21:6"/><verse number="7" style="v" sid="1CH 21:7"/>ಇದಲ್ಲದೆ ಈ ಕಾರ್ಯವು ದೇವರ ಸಮ್ಮುಖದಲ್ಲಿ ಕೆಟ್ಟದ್ದಾದದ್ದರಿಂದ, ದೇವರು ಇಸ್ರಾಯೇಲನ್ನು ಶಿಕ್ಷಿಸಿದರು.<verse eid="1CH 21:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="1CH 21:8"/>ದಾವೀದನು ದೇವರಿಗೆ, “ನಾನು ಈ ಕಾರ್ಯವನ್ನು ಮಾಡಿದ್ದರಿಂದ, ಮಹಾಪಾಪ ಮಾಡಿದೆನು. ನೀವು ದಯಮಾಡಿ ನಿಮ್ಮ ಸೇವಕನ ಅಕ್ರಮವನ್ನು ಪರಿಹರಿಸಿರಿ. ಏಕೆಂದರೆ ನಾನು ಇದರಲ್ಲಿ ಬಹಳ ಬುದ್ಧಿಹೀನನಾಗಿ ನಡೆದೆನು,” ಎಂದನು.<verse eid="1CH 21:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="1CH 21:9"/>ಆಗ ಯೆಹೋವ ದೇವರು ದಾವೀದನ ದರ್ಶಿಯಾದ ಗಾದನಿಗೆ, <verse eid="1CH 21:9"/><verse number="10" style="v" sid="1CH 21:10"/>“ನೀನು ದಾವೀದನ ಬಳಿಗೆ ಹೋಗಿ, ಅವನ ಸಂಗಡ ಮಾತಾಡಿ, ‘ಯೆಹೋವ ದೇವರು ಹೀಗೆ ಹೇಳುತ್ತಾರೆ: ನಾನು ಮೂರು ವಿಧವಾದ ಶಿಕ್ಷೆಗಳನ್ನು ನಿನ್ನ ಮುಂದೆ ಇಡುತ್ತೇನೆ. ಅವುಗಳಲ್ಲಿ ಯಾವುದನ್ನು ನಿನಗೆ ವಿರೋಧವಾಗಿ ಬರಮಾಡಬೇಕೋ ಅದನ್ನು ಆಯ್ದುಕೋ,’ ಎಂದು ಹೇಳು,” ಎಂದರು.<verse eid="1CH 21:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="1CH 21:11"/>ಹಾಗೆಯೇ ಗಾದನು ದಾವೀದನ ಬಳಿಗೆ ಬಂದು ಅವನಿಗೆ, “ಯೆಹೋವ ದೇವರು ಹೀಗೆ ಹೇಳುತ್ತಾರೆ: ನೀನೇ ಆಯ್ದುಕೋ, <verse eid="1CH 21:11"/><verse number="12" style="v" sid="1CH 21:12"/>ನಿನ್ನ ದೇಶದಲ್ಲಿ ಮೂರು ವರುಷ ಕ್ಷಾಮ ಉಂಟಾಗಬೇಕೋ? ಇಲ್ಲವೆ ಮೂರು ತಿಂಗಳವರೆಗೆ ನಿನ್ನ ಶತ್ರುಗಳ ಹಿಂಸೆಗೆ ಬಲಿಯಾಗುವುದು ಬೇಕೋ? ಇಲ್ಲವೆ ಯೆಹೋವ ದೇವರ ದೂತನು ಇಸ್ರಾಯೇಲಿನ ಸಮಸ್ತ ಪ್ರಾಂತಗಳಲ್ಲಿ ಯೆಹೋವ ದೇವರ ಖಡ್ಗದಿಂದ ಮೂರು ದಿವಸಗಳವರೆಗೆ ಘೋರವ್ಯಾಧಿ ಉಂಟಾಗಬೇಕೋ? ನೀನು ಆರಿಸಿಕೋ. ಈಗ ನನ್ನನ್ನು ಕಳುಹಿಸಿದವರಿಗೆ ನಾನು ಏನು ಉತ್ತರ ತೆಗೆದುಕೊಂಡು ಹೋಗಬೇಕು? ಯೋಚಿಸಿನೋಡು,” ಎಂದನು.<verse eid="1CH 21:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="1CH 21:13"/>ಆಗ ದಾವೀದನು ಗಾದನಿಗೆ, “ನಾನು ಬಹು ಇಕ್ಕಟ್ಟಿನಲ್ಲಿ ಇದ್ದೇನೆ. ಯೆಹೋವ ದೇವರ ಕೈಯಲ್ಲಿಯೇ ಬೀಳುತ್ತೇನೆ. ಏಕೆಂದರೆ ಅವರ ಕರುಣೆಯು ದೊಡ್ಡದು, ಆದರೆ ಮನುಷ್ಯರ ಕೈಯಲ್ಲಿ ಬೀಳಲಾರೆನು,” ಎಂದನು.<verse eid="1CH 21:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="1CH 21:14"/>ಆದಕಾರಣ ಯೆಹೋವ ದೇವರು ಇಸ್ರಾಯೇಲರ ಮೇಲೆ ವ್ಯಾಧಿಯನ್ನು ಕಳುಹಿಸಿದರು. ಆಗ ಇಸ್ರಾಯೇಲರಲ್ಲಿ ಎಪ್ಪತ್ತು ಸಾವಿರ ಜನರು ಸತ್ತರು. <verse eid="1CH 21:14"/><verse number="15" style="v" sid="1CH 21:15"/>ಇದಲ್ಲದೆ ಯೆರೂಸಲೇಮನ್ನು ನಾಶಮಾಡುವುದಕ್ಕೆ ದೇವರು ದೂತನನ್ನು ಕಳುಹಿಸಿದರು. ಅವನು ನಾಶಮಾಡುವುದನ್ನು ಯೆಹೋವ ದೇವರು ನೋಡಿ, ಆ ದಂಡನೆಗೋಸ್ಕರ ದುಃಖಪಟ್ಟು, ಜನರನ್ನು ನಾಶಮಾಡುವ ದೂತನಿಗೆ, “ಸಾಕು, ನಿನ್ನ ಕೈಯನ್ನು ಹಿಂದೆಗೆ,” ಎಂದರು. ಆಗ ಯೆಹೋವ ದೇವರ ದೂತನು ಯೆಬೂಸಿಯನಾದ ಒರ್ನಾನನ ಕಣದ ಬಳಿಯಲ್ಲಿ ನಿಂತಿದ್ದನು.<verse eid="1CH 21:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="1CH 21:16"/>ಆಗ ದಾವೀದನು ತನ್ನ ಕಣ್ಣೆತ್ತಿ ಭೂಮಿಗೂ, ಆಕಾಶಕ್ಕೂ ಮಧ್ಯದಲ್ಲಿ ನಿಂತಿರುವ ಯೆಹೋವ ದೇವರ ದೂತನನ್ನು ಕಂಡನು. ಅವನ ಕೈಯಲ್ಲಿ ಯೆರೂಸಲೇಮಿನ ಮೇಲೆ ಚಾಚಿದ್ದ ಹಿರಿದ ಖಡ್ಗ ಇತ್ತು. ಆಗ ದಾವೀದನೂ, ಇಸ್ರಾಯೇಲಿನ ಹಿರಿಯರೂ ಗೋಣಿತಟ್ಟುಗಳನ್ನು ಹೊದ್ದುಕೊಂಡು ಬೋರಲಾಗಿ ಬಿದ್ದರು.<verse eid="1CH 21:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="1CH 21:17"/>ದಾವೀದನು ದೇವರಿಗೆ, “ಜನರಲ್ಲಿ ಯುದ್ಧ ವೀರರನ್ನು ಲೆಕ್ಕಮಾಡಲು ಆಜ್ಞಾಪಿಸಿದವನು ನಾನಲ್ಲವೋ? ನಾನೇ ಪಾಪಮಾಡಿದೆನು. ಕುರುಬನಂತಿರುವ ನಾನೇ ಈ ಕೆಟ್ಟದ್ದನ್ನು ಮಾಡಿದೆನು, ಆದರೆ ಕುರಿಗಳಂತಿರುವ ಇವರು ಮಾಡಿದ್ದೇನು? ನನ್ನ ಯೆಹೋವ ದೇವರೇ, ನಿಮ್ಮ ಹಸ್ತವು ನಿಮ್ಮ ಜನರನ್ನು ಬಾಧಿಸದೆ, ನನಗೆ ವಿರೋಧವಾಗಿಯೂ ನನ್ನ ಕುಟುಂಬದ ವಿರೋಧವಾಗಿಯೂ ಇರಲಿ ಎಂದು ನಾನು ಬೇಡುತ್ತೇನೆ,” ಎಂದನು.<verse eid="1CH 21:17"/></para>
  <para style="s1">ದಾವೀದನು ಬಲಿಪೀಠವನ್ನು ಕಟ್ಟಿಸಿದ್ದು</para>
  <para style="p">
    <verse number="18" style="v" sid="1CH 21:18"/>ಆಗ ಯೆಹೋವ ದೇವರ ದೂತನು ಗಾದನಿಗೆ, “ದಾವೀದನು ಹೋಗಿ ಯೆಬೂಸಿಯನಾದ ಒರ್ನಾನನ ಕಣದಲ್ಲಿ ಯೆಹೋವ ದೇವರಿಗೆ ಬಲಿಪೀಠವನ್ನು ಕಟ್ಟುವ ಹಾಗೆ ದಾವೀದನಿಗೆ ಹೇಳು,” ಎಂದನು. <verse eid="1CH 21:18"/><verse number="19" style="v" sid="1CH 21:19"/>ಗಾದನು ಯೆಹೋವ ದೇವರ ಹೆಸರಿನಲ್ಲಿ ಹೇಳಿದ ಮಾತಿನ ಪ್ರಕಾರ ದಾವೀದನು ಹೋದನು.<verse eid="1CH 21:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="1CH 21:20"/>ಒರ್ನಾನನು ಗೋಧಿಯನ್ನು ತುಳಿಸುತ್ತಿರುವಾಗ, ಹಿಂದಕ್ಕೆ ತಿರುಗಿ ದೂತನನ್ನು ಕಂಡದ್ದರಿಂದ ಅವನೂ, ಅವನ ಸಂಗಡ ಇದ್ದ ಅವನ ನಾಲ್ಕು ಮಂದಿ ಪುತ್ರರೂ ಅಡಗಿಕೊಂಡಿದ್ದರು. <verse eid="1CH 21:20"/><verse number="21" style="v" sid="1CH 21:21"/>ಆದರೆ ದಾವೀದನು ತನ್ನ ಬಳಿಗೆ ಬರುವುದನ್ನು ಒರ್ನಾನನು ಕಂಡನು, ಆಗ ಅವನು ಕಣದಿಂದ ಹೊರಟು, ದಾವೀದನ ಮುಂದೆ ಮುಖ ಕೆಳಗೆಮಾಡಿ ಅಡ್ಡಬಿದ್ದನು.<verse eid="1CH 21:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="1CH 21:22"/>ಆಗ ದಾವೀದನು ಒರ್ನಾನನಿಗೆ, “ಈ ವ್ಯಾಧಿಯು, ಜನರನ್ನು ಬಿಟ್ಟುಹೋಗುವಂತೆ ನಾನು ಯೆಹೋವ ದೇವರಿಗೆ ಒಂದು ಬಲಿಪೀಠವನ್ನು ಕಟ್ಟಿಸುವುದಕ್ಕೆ, ಈ ಕಣದ ಸ್ಥಳವನ್ನು ನನಗೆ ಕೊಡು. ಅದನ್ನು ಪೂರ್ಣ ಕ್ರಯಕ್ಕೆ ನನಗೆ ಕೊಡು,” ಎಂದನು.<verse eid="1CH 21:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="1CH 21:23"/>ಒರ್ನಾನನು ದಾವೀದನಿಗೆ, “ನಿನಗಾಗಿ ತೆಗೆದುಕೋ, ಅರಸನಾದ ನನ್ನ ಒಡೆಯನು ತನ್ನ ದೃಷ್ಟಿಗೆ ಉತ್ತಮವಾದದ್ದನ್ನು ಮಾಡಲಿ. ದಹನಬಲಿಗೋಸ್ಕರ ಎತ್ತುಗಳೂ, ಸೌದೆಗೆ ಹಂತೀಕುಂಟೆ, ಧಾನ್ಯ ಸಮರ್ಪಣೆಗೋಸ್ಕರ ಗೋಧಿ ಕೊಡುವುದಲ್ಲದೆ, ಸಮಸ್ತವನ್ನೂ ಕೊಡುವೆನು,” ಎಂದನು.<verse eid="1CH 21:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="1CH 21:24"/>ಅರಸ ದಾವೀದನು ಒರ್ನಾನನಿಗೆ, “ಹಾಗಲ್ಲ, ನಾನು ನಿನ್ನಿಂದ ಪೂರ್ಣ ಕ್ರಯಕ್ಕೆ ತೆಗೆದುಕೊಳ್ಳುತ್ತೇನೆ. ನಿನ್ನದನ್ನು ಕ್ರಯವಿಲ್ಲದೆ ತೆಗೆದುಕೊಂಡು, ಯೆಹೋವ ದೇವರಿಗೆ ದಹನಬಲಿಯಾಗಿ ಅರ್ಪಿಸಲು ನನಗೆ ಇಷ್ಟವಿಲ್ಲ,” ಎಂದು ಹೇಳಿದನು.<verse eid="1CH 21:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="1CH 21:25"/>ಅಂತೆಯೇ ಆ ಭೂಮಿಗಾಗಿ ಒರ್ನಾನನಿಗೆ ಏಳು ಕಿಲೋಗ್ರಾಂ ಬಂಗಾರವನ್ನು ಕೊಟ್ಟು, <verse eid="1CH 21:25"/><verse number="26" style="v" sid="1CH 21:26"/>ದಾವೀದನು ಯೆಹೋವ ದೇವರಿಗೆ ಅಲ್ಲಿ ಬಲಿಪೀಠವನ್ನು ಕಟ್ಟಿಸಿ, ಅದರ ಮೇಲೆ ದಹನಬಲಿಗಳನ್ನೂ, ಸಮಾಧಾನದ ಬಲಿಗಳನ್ನೂ ಅರ್ಪಿಸಿ ಯೆಹೋವ ದೇವರನ್ನು ಪ್ರಾರ್ಥಿಸಿದನು. ಆಗ ಅವರು ಆಕಾಶದಿಂದ ದಹನಬಲಿಪೀಠದ ಮೇಲೆ ಅಗ್ನಿಯಿಂದ ಅವನಿಗೆ ಉತ್ತರಕೊಟ್ಟರು.<verse eid="1CH 21:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="1CH 21:27"/>ಯೆಹೋವ ದೇವರು ದೂತನಿಗೆ ಹೇಳಿದ್ದರಿಂದ, ಅವನು ತನ್ನ ಖಡ್ಗವನ್ನು ಒರೆಗೆ ತಿರುಗಿ ಸೇರಿಸಿದನು. <verse eid="1CH 21:27"/><verse number="28" style="v" sid="1CH 21:28"/>ಯೆಹೋವ ದೇವರು ಯೆಬೂಸಿಯನಾದ ಒರ್ನಾನನ ಕಣದಲ್ಲಿ ತನಗೆ ಉತ್ತರ ಕೊಟ್ಟರೆಂದು ದಾವೀದನು ಕಂಡಾಗ, ಅವನು ಅಲ್ಲಿ ಬಲಿಗಳನ್ನು ಅರ್ಪಿಸಿದನು. <verse eid="1CH 21:28"/><verse number="29" style="v" sid="1CH 21:29"/>ಮರುಭೂಮಿಯಲ್ಲಿ ಮೋಶೆಯು ಮಾಡಿದ ಯೆಹೋವ ದೇವರ ಗುಡಾರವೂ, ದಹನಬಲಿಪೀಠವೂ ಆ ಕಾಲದಲ್ಲಿ ಗಿಬ್ಯೋನಿನ ಉನ್ನತ ಸ್ಥಳದಲ್ಲಿ ಇದ್ದವು. <verse eid="1CH 21:29"/><verse number="30" style="v" sid="1CH 21:30"/>ದಾವೀದನು ದೇವರ ಹತ್ತಿರ ವಿಚಾರಿಸಲು, ಅದರ ಬಳಿಗೆ ಹೋಗಲಾರದೆ ಇದ್ದನು. ಏಕೆಂದರೆ ಅವನು ಯೆಹೋವ ದೇವರ ದೂತನ ಖಡ್ಗದ ನಿಮಿತ್ತ ಹೆದರಿದ್ದನು.<verse eid="1CH 21:30"/></para>
  <chapter eid="1CH 21"/>
  <chapter number="22" style="c" sid="1CH 22"/>
  <para style="p">
    <verse number="1" style="v" sid="1CH 22:1"/>ಆಗ ದಾವೀದನು, “ಇದೇ ದೇವರಾದ ಯೆಹೋವ ದೇವರ ಆಲಯ, ಮತ್ತು ಇದೇ ಇಸ್ರಾಯೇಲರ ದಹನಬಲಿಪೀಠ,” ಎಂದನು.<verse eid="1CH 22:1"/></para>
  <para style="s1">ದೇವಾಲಯದ ಕಟ್ಟಡಕ್ಕಾಗಿ ಸಿದ್ಧತೆಗಳು</para>
  <para style="p">
    <verse number="2" style="v" sid="1CH 22:2"/>ದಾವೀದನು ಇಸ್ರಾಯೇಲ್ ದೇಶದಲ್ಲಿರುವ ಪರದೇಶಸ್ಥರನ್ನು ಕೂಡಿಸಲು ಹೇಳಿ, ದೇವರ ಆಲಯವನ್ನು ಕಟ್ಟಿಸುವುದಕ್ಕೆ ಕೆತ್ತಿದ ಕಲ್ಲುಗಳನ್ನು ಕಡಿಯುವ ಹಾಗೆ ಕಲ್ಲುಕುಟಿಗರನ್ನು ನೇಮಿಸಿದನು. <verse eid="1CH 22:2"/><verse number="3" style="v" sid="1CH 22:3"/>ದಾವೀದನು ಬಾಗಿಲುಗಳ ಕದಗಳನ್ನು ಜೋಡಿಸುವುದಕ್ಕೆ ಬೇಕಾದ ಮೊಳೆಗಳಿಗೋಸ್ಕರ ಬಹಳ ಕಬ್ಬಿಣವನ್ನೂ, ಲೆಕ್ಕವಿಲ್ಲದಷ್ಟು ಕಂಚನ್ನೂ ಸಿದ್ಧಮಾಡಿಸಿದನು. <verse eid="1CH 22:3"/><verse number="4" style="v" sid="1CH 22:4"/>ಲೆಕ್ಕವಿಲ್ಲದಷ್ಟು ದೇವದಾರು ಮರಗಳನ್ನು ಸಿದ್ಧಮಾಡಿಸಿದನು. ಏಕೆಂದರೆ ಸೀದೋನ್ಯರೂ, ಟೈರಿನವರೂ ದಾವೀದನಿಗೆ ಹೆಚ್ಚಾಗಿ ದೇವದಾರು ಮರಗಳನ್ನು ತಂದರು.<verse eid="1CH 22:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="1CH 22:5"/>ದಾವೀದನು, “ನನ್ನ ಮಗ ಸೊಲೊಮೋನನು ಎಳೆಯ ಪ್ರಾಯದವನಾಗಿದ್ದಾನೆ. ಯೆಹೋವ ದೇವರಿಗೆ ಕಟ್ಟಬೇಕಾದ ಆಲಯವು ಸಮಸ್ತ ದೇಶಗಳಲ್ಲಿ ಕೀರ್ತಿಯಲ್ಲಿಯೂ, ಸೌಂದರ್ಯದಲ್ಲಿಯೂ ಅಧಿಕ ಘನವುಳ್ಳದ್ದಾಗಿರಬೇಕು. ನಾನು ಅದಕ್ಕೋಸ್ಕರ ಈಗ ಸಿದ್ಧಮಾಡುವೆನು,” ಎಂದು ಹೇಳಿದನು. ಆದ್ದರಿಂದ ದಾವೀದನು ಸಾಯುವುದಕ್ಕಿಂತ ಮುಂಚೆ ಬಹಳವಾಗಿ ಸಿದ್ಧಮಾಡಿದನು.<verse eid="1CH 22:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="1CH 22:6"/>ತನ್ನ ಮಗ ಸೊಲೊಮೋನನನ್ನು ಕಳುಹಿಸಿ, ಇಸ್ರಾಯೇಲಿನ ದೇವರಾದ ಯೆಹೋವ ದೇವರಿಗೆ ಆಲಯವನ್ನು ಕಟ್ಟಿಸಲು ಅವನಿಗೆ ಆಜ್ಞಾಪಿಸಿದನು. <verse eid="1CH 22:6"/><verse number="7" style="v" sid="1CH 22:7"/>ದಾವೀದನು ಸೊಲೊಮೋನನಿಗೆ, “ನನ್ನ ಮಗನೇ, ನಾನು ನನ್ನ ದೇವರಾದ ಯೆಹೋವ ದೇವರ ಹೆಸರಿಗೋಸ್ಕರ ಆಲಯವನ್ನು ಕಟ್ಟಿಸಬೇಕೆಂಬುದು ನನ್ನ ಹೃದಯದಲ್ಲಿ ಇತ್ತು. <verse eid="1CH 22:7"/><verse number="8" style="v" sid="1CH 22:8"/>ಆದರೆ ಯೆಹೋವ ದೇವರಿಂದ ನನಗೆ ಉಂಟಾದ ವಾಕ್ಯವೇನೆಂದರೆ: ‘ನೀನು ಬಹು ರಕ್ತವನ್ನು ಚೆಲ್ಲಿದ್ದೀಯೆ; ಮಹಾ ಯುದ್ಧಗಳನ್ನು ಮಾಡಿದ್ದೀಯೆ; ನೀನು ನನ್ನ ಹೆಸರಿಗೆ ಮನೆಯನ್ನು ಕಟ್ಟಿಸಬೇಡ. ಏಕೆಂದರೆ ನೀನು ನನ್ನ ಸಮ್ಮುಖದಲ್ಲಿ ಭೂಮಿಯ ಮೇಲೆ ಬಹಳ ರಕ್ತವನ್ನು ಚೆಲ್ಲಿದಿ. <verse eid="1CH 22:8"/><verse number="9" style="v" sid="1CH 22:9"/>ಶಾಂತಿ ಸಮಾಧಾನದ ಮನುಷ್ಯನಾಗಿರುವ ಒಬ್ಬ ಮಗನು ನಿನಗೆ ಹುಟ್ಟುವನು. ಸುತ್ತಲಿರುವ ಅವನ ಸಮಸ್ತ ಶತ್ರುಗಳಿಂದ ನಾನು ಅವನಿಗೆ ವಿಶ್ರಾಂತಿಯನ್ನು ಕೊಡುವೆನು. ಅವನಿಗೆ ಸೊಲೊಮೋನನೆಂಬ<note caller="+" style="f"><char style="fr" closed="false">22:9 </char><char style="fq" closed="false">ಸೊಲೊಮೋನ </char><char style="ft" closed="false">ಹೀಬ್ರೂ ಭಾಷೆಯಲ್ಲಿ </char><char style="fqa" closed="false">ಶಾಂತಿ</char></note> ಹೆಸರಿರುವುದು. ಅವನ ದಿವಸಗಳಲ್ಲಿ ನಾನು ಇಸ್ರಾಯೇಲಿಗೆ ಶಾಂತಿ ಸಮಾಧಾನವನ್ನೂ ಕೊಡುವೆನು. <verse eid="1CH 22:9"/><verse number="10" style="v" sid="1CH 22:10"/>ಅವನು ನನ್ನ ನಾಮಕ್ಕೆ ಆಲಯವನ್ನು ಕಟ್ಟಿಸುವನು. ಅವನು ನನ್ನ ಮಗನಾಗಿರುವನು. ನಾನು ಅವನಿಗೆ ತಂದೆಯಾಗಿರುವೆನು. ಇಸ್ರಾಯೇಲಿನ ಮೇಲೆ ಅವನ ರಾಜ್ಯದ ಸಿಂಹಾಸನವನ್ನು ಯುಗಯುಗಾಂತರಕ್ಕೂ ಸ್ಥಿರಪಡಿಸುವೆನು,’ ಎಂದು ಹೇಳಿದ್ದಾರೆ.<verse eid="1CH 22:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="1CH 22:11"/>“ನನ್ನ ಮಗನೇ, ಯೆಹೋವ ದೇವರು ನಿನ್ನನ್ನು ಕುರಿತು ಹೇಳಿದ ಪ್ರಕಾರ, ನೀನು ಕೃತಾರ್ಥನಾಗಿ, ನೀನು ನಿನ್ನ ದೇವರಾದ ಯೆಹೋವ ದೇವರ ಆಲಯವನ್ನು ಕಟ್ಟಿಸುವಂತೆ ಅವರು ನಿನ್ನ ಸಂಗಡ ಇರಲಿ. <verse eid="1CH 22:11"/><verse number="12" style="v" sid="1CH 22:12"/>ನೀನು ನಿನ್ನ ದೇವರಾದ ಯೆಹೋವ ದೇವರ ನಿಯಮವನ್ನು ಕೈಗೊಳ್ಳುವಂತೆ ದೇವರು ನಿನಗೆ ಬುದ್ಧಿಯನ್ನೂ, ಗ್ರಹಿಕೆಯನ್ನೂ ಕೊಟ್ಟು ಇಸ್ರಾಯೇಲನ್ನು ಕುರಿತು ನಿನಗೆ ಆಜ್ಞಾಪಿಸಲಿ. <verse eid="1CH 22:12"/><verse number="13" style="v" sid="1CH 22:13"/>ಯೆಹೋವ ದೇವರು ಇಸ್ರಾಯೇಲನ್ನು ಕುರಿತು ಮೋಶೆಗೆ ಆಜ್ಞಾಪಿಸಿದ ನ್ಯಾಯವಿಧಿಗಳನ್ನು ಕೈಗೊಳ್ಳಲು ನೀನು ಜಾಗ್ರತೆಯಾಗಿರು. ಆಗ ಸಫಲನಾಗುವಿ. ಬಲವಾಗಿರು, ದೃಢವಾಗಿರು. ಭಯಪಡಬೇಡ, ಹೆದರಬೇಡ.<verse eid="1CH 22:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="1CH 22:14"/>“ಇಗೋ, ಕಷ್ಟಪಟ್ಟು ನಾನು ಯೆಹೋವ ದೇವರ ಆಲಯಕ್ಕೋಸ್ಕರ ಮೂರು ಸಾವಿರದ ನಾನೂರ ಎಪ್ಪತ್ತು ಮೆಟ್ರಿಕ್ ಟನ್ ಬಂಗಾರವನ್ನೂ, ಮೂವತ್ತ ನಾಲ್ಕು ಸಾವಿರದ ಐನೂರು ಮೆಟ್ರಿಕ್ ಟನ್ ಬೆಳ್ಳಿಯನ್ನೂ, ಲೆಕ್ಕವಿಲ್ಲದಷ್ಟು ಕಂಚನ್ನೂ, ಕಬ್ಬಿಣವನ್ನೂ ಮರಗಳನ್ನೂ, ಕಲ್ಲುಗಳನ್ನೂ ಸಿದ್ಧಮಾಡಿದ್ದೇನೆ. ನೀನು ಅವುಗಳಿಗೆ ಸೇರಿಸಬಹುದು. <verse eid="1CH 22:14"/><verse number="15" style="v" sid="1CH 22:15"/>ಇದಲ್ಲದೆ ನಿನ್ನ ಬಳಿಯಲ್ಲಿ ಕೆಲಸದವರೂ, ಕಲ್ಲು ಕೆಲಸದವರೂ, ಕಲ್ಲುಕುಟಿಗರೂ, ಬಡಗಿಯವರೂ, ಸಮಸ್ತ ವಿವಿಧ ಕೆಲಸದ ಪ್ರವೀಣರೂ ಅನೇಕ ಮಂದಿ ಇದ್ದಾರೆ. <verse eid="1CH 22:15"/><verse number="16" style="v" sid="1CH 22:16"/>ಚಿನ್ನ, ಬೆಳ್ಳಿ, ಕಂಚು, ಕಬ್ಬಿಣ, ಮುಂತಾದವುಗಳಲ್ಲಿ ನಿಪುಣರು ಲೆಕ್ಕವಿಲ್ಲದಷ್ಟು ಇದ್ದಾರೆ. ಎದ್ದು ಕೆಲಸ ಮಾಡು, ಯೆಹೋವ ದೇವರು ನಿನ್ನ ಸಂಗಡ ಇರಲಿ,” ಎಂದನು.<verse eid="1CH 22:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="1CH 22:17"/>ಇದಲ್ಲದೆ, ದಾವೀದನು ತನ್ನ ಮಗ ಸೊಲೊಮೋನನಿಗೆ ಸಹಾಯಮಾಡಲು ಇಸ್ರಾಯೇಲಿನ ಪ್ರಧಾನರಿಗೆ ಆಜ್ಞಾಪಿಸಿ ಹೇಳಿದ್ದೇನೆಂದರೆ, <verse eid="1CH 22:17"/><verse number="18" style="v" sid="1CH 22:18"/>“ನಮ್ಮ ದೇವರಾದ ಯೆಹೋವ ದೇವರು ನಿಮ್ಮ ಸಂಗಡ ಇದ್ದಾರೆ, ಅಲ್ಲವೇ? ಎಲ್ಲಾ ಕಡೆಗಳಲ್ಲಿ ನಿಮಗೆ ವಿಶ್ರಾಂತಿ ಕೊಟ್ಟಿದ್ದಾರೆ, ಅಲ್ಲವೇ? ನಿಶ್ಚಯವಾಗಿ ಅವರು ದೇಶ ನಿವಾಸಿಗಳನ್ನು ನನ್ನ ಕೈಯಲ್ಲಿ ಒಪ್ಪಿಸಿದ್ದರಿಂದ, ದೇಶವು ಯೆಹೋವ ದೇವರ ಮುಂದೆಯೂ, ಅವರ ಜನರ ಮುಂದೆಯೂ ಸ್ವಾಧೀನವಾಯಿತು. <verse eid="1CH 22:18"/><verse number="19" style="v" sid="1CH 22:19"/>ನಿಮ್ಮ ದೇವರಾದ ಯೆಹೋವ ದೇವರನ್ನು ಹುಡುಕಲು ನಿಮ್ಮ ಹೃದಯವನ್ನೂ, ನಿಮ್ಮ ಪ್ರಾಣವನ್ನೂ ಒಪ್ಪಿಸಿ, ಯೆಹೋವ ದೇವರ ಒಡಂಬಡಿಕೆಯ ಮಂಜೂಷದ ದೇವರ ಪರಿಶುದ್ಧ ಪಾತ್ರೆಗಳನ್ನು ಯೆಹೋವ ದೇವರ ನಾಮಕ್ಕಾಗಿ ಕಟ್ಟಲಾಗುವ ಆಲಯದೊಳಗೆ ತರುವ ಹಾಗೆ, ಎದ್ದು ಯೆಹೋವ ದೇವರಾದ ದೇವರಿಗೆ ಪರಿಶುದ್ಧ ಸ್ಥಳವನ್ನು ಕಟ್ಟಿಸಿರಿ,” ಎಂದನು.<verse eid="1CH 22:19"/></para>
  <chapter eid="1CH 22"/>
  <chapter number="23" style="c" sid="1CH 23"/>
  <para style="s1">ಲೇವಿಯರು</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 23:1"/>ದಾವೀದನು ಮುದುಕನಾದ ಮೇಲೆ ತನ್ನ ಮಗ ಸೊಲೊಮೋನನನ್ನು ಇಸ್ರಾಯೇಲಿನ ಮೇಲೆ ಅರಸನಾಗಿ ಮಾಡಿದನು.<verse eid="1CH 23:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="1CH 23:2"/>ಇದಲ್ಲದೆ ತಾನು ಇಸ್ರಾಯೇಲಿನ ಸಮಸ್ತ ಪ್ರಧಾನರನ್ನೂ ಯಾಜಕರನ್ನೂ ಲೇವಿಯರನ್ನೂ ಒಟ್ಟುಗೂಡಿಸಿ ಬರಮಾಡಿದನು. <verse eid="1CH 23:2"/><verse number="3" style="v" sid="1CH 23:3"/>ಲೇವಿಯರು ಮೂವತ್ತು ವರ್ಷ ಪ್ರಾಯದವರು ಮೊದಲುಗೊಂಡು ಎಣಿಕೆಯಾಗಿದ್ದರು. ಅವರ ಪುರುಷರ ಲೆಕ್ಕವು ಮೂವತ್ತೆಂಟು ಸಾವಿರವಾಗಿತ್ತು. <verse eid="1CH 23:3"/><verse number="4" style="v" sid="1CH 23:4"/>ದಾವೀದನು ಹೇಳಿದ್ದೇನೆಂದರೆ, “ಇವರಲ್ಲಿ ಇಪ್ಪತ್ತನಾಲ್ಕು ಸಾವಿರ ಮಂದಿ ಯೆಹೋವ ದೇವರ ಮನೆಯ ಕೆಲಸವನ್ನು ನಡಿಸುವವರಾಗಿದ್ದರು. ಮತ್ತು ಆರು ಸಾವಿರ ಮಂದಿ ಪಾರುಪತ್ಯಗಾರರೂ ನ್ಯಾಯಾಧಿಪತಿಗಳೂ ಆಗಿದ್ದರು. <verse eid="1CH 23:4"/><verse number="5" style="v" sid="1CH 23:5"/>ಇದಲ್ಲದೆ ನಾಲ್ಕು ಸಾವಿರ ಮಂದಿ ದ್ವಾರಪಾಲಕರಾಗಿದ್ದರು. ನಾಲ್ಕು ಸಾವಿರ ಮಂದಿ ಸ್ತುತಿಸುವುದಕ್ಕೆ ತಾನು ಸಿದ್ಧಮಾಡಿದ ವಾದ್ಯಗಳಿಂದ ಯೆಹೋವ ದೇವರನ್ನು ಸ್ತುತಿಸಿದರು.”<verse eid="1CH 23:5"/></para>
  <para style="b"/>
  <para style="li4">
    <verse number="6" style="v" sid="1CH 23:6"/>ಇದಲ್ಲದೆ ದಾವೀದನು ಗೇರ್ಷೋನ್ಯರು, ಕೊಹಾತ್ಯರು, ಮೆರಾರೀಯರು ಎಂಬ ಲೇವಿಯರನ್ನು ಮೂರು ವರ್ಗಗಳಾಗಿ ವಿಭಾಗಿಸಿದನು.<verse eid="1CH 23:6"/></para>
  <para style="s1">ಗೇರ್ಷೋನ್ಯರು</para>
  <para style="li1">
    <verse number="7" style="v" sid="1CH 23:7"/>ಗೇರ್ಷೋನ್ಯರಲ್ಲಿ,</para>
  <para style="li2" vid="1CH 23:7">ಲದ್ದಾನ್ ಮತ್ತು ಶಿಮ್ಮೀ.<verse eid="1CH 23:7"/></para>
  <para style="li1">
    <verse number="8" style="v" sid="1CH 23:8"/>ಲದ್ದಾನನ ಪುತ್ರರು:</para>
  <para style="li2" vid="1CH 23:8">ಮೊದಲನೆಯವನು ಯೆಹೀಯೇಲ್, ಜೇತಾಮ್, ಯೋಯೇಲ್ ಎಂಬ ಮೂರು ಮಕ್ಕಳಿದ್ದರು.<verse eid="1CH 23:8"/></para>
  <para style="li1">
    <verse number="9" style="v" sid="1CH 23:9"/>ಶಿಮ್ಮೀಯ ಪುತ್ರರು:</para>
  <para style="li2" vid="1CH 23:9">ಶೆಲೋಮೋತ್, ಹಜೀಯೇಲ್, ಹಾರಾನ್ ಎಂಬ ಮೂರು ಮಂದಿಯು.</para>
  <para style="li2" vid="1CH 23:9">ಇವರು ಲದ್ದಾನನ ಕುಟುಂಬಗಳಲ್ಲಿ ಮುಖ್ಯಸ್ಥರಾಗಿದ್ದರು.<verse eid="1CH 23:9"/></para>
  <para style="li1">
    <verse number="10" style="v" sid="1CH 23:10"/>ಶಿಮ್ಮೀಯ ಪುತ್ರರು:</para>
  <para style="li2" vid="1CH 23:10">ಯಹತ್, ಜೀನ, ಯೆಯೂಷ್, ಬೆರೀಯ</para>
  <para style="li2" vid="1CH 23:10">ಶಿಮ್ಮನ ಈ ನಾಲ್ಕು ಮಂದಿ ಪುತ್ರರಲ್ಲಿ<verse eid="1CH 23:10"/></para>
  <para style="li2">
    <verse number="11" style="v" sid="1CH 23:11"/>ಯಹತನು ಮೊದಲನೆಯವನು, ಜೀಜನು ಎರಡನೆಯವನಾಗಿದ್ದನು. ಯೆಯೂಷನಿಗೂ ಬೆರೀಯನಿಗೂ ಹೆಚ್ಚು ಮಕ್ಕಳು ಇಲ್ಲದ್ದರಿಂದ ಇವರು ತಮ್ಮ ತಂದೆಯ ಮನೆಯಲ್ಲಿ ಒಂದೇ ಲೆಕ್ಕವಾಗಿ ಎಣಿಕೆಯಾಗಿದ್ದರು.<verse eid="1CH 23:11"/></para>
  <para style="s1">ಕೊಹಾತ್ಯರು</para>
  <para style="li1">
    <verse number="12" style="v" sid="1CH 23:12"/>ಕೊಹಾತನ ಪುತ್ರರು:</para>
  <para style="li2" vid="1CH 23:12">ಅಮ್ರಾಮ್, ಇಚ್ಹಾರ್, ಹೆಬ್ರೋನ್, ಉಜ್ಜೀಯೇಲ್ ಎಂಬ ನಾಲ್ಕು ಮಂದಿ ಮಕ್ಕಳಿದ್ದರು.<verse eid="1CH 23:12"/></para>
  <para style="li1">
    <verse number="13" style="v" sid="1CH 23:13"/>ಅಮ್ರಾಮನ ಪುತ್ರರು:</para>
  <para style="li2" vid="1CH 23:13">ಆರೋನ್ ಮತ್ತು ಮೋಶೆ;</para>
  <para style="li2" vid="1CH 23:13">ಆರೋನನನ್ನು ಮತ್ತು ಅವನ ಪುತ್ರರನ್ನು ಮಹಾಪರಿಶುದ್ಧವಾದ ವಸ್ತುಗಳನ್ನು ಪ್ರತಿಷ್ಠಿಸುವುದಕ್ಕೆ ಶಾಶ್ವತವಾಗಿ ಪ್ರತ್ಯೇಕಿಸಲಾಯಿತು. ಇವರು ಯೆಹೋವ ದೇವರ ಸನ್ನಿಧಿಯಲ್ಲಿ ಸದಾಕಾಲ ಧೂಪಹಾಕುವವರೂ, ಅವರ ಸೇವೆ ಮಾಡುವವರೂ, ಅವರ ಹೆಸರಿನಿಂದ ಜನರನ್ನು ಆಶೀರ್ವದಿಸುವವರೂ ಆಗಿದ್ದರು. <verse eid="1CH 23:13"/><verse number="14" style="v" sid="1CH 23:14"/>ದೇವರ ಮನುಷ್ಯನಾದ ಮೋಶೆಯಾದರೋ, ಅವನ ಪುತ್ರರು ಲೇವಿಯ ಗೋತ್ರದಲ್ಲಿ ಲೆಕ್ಕಿತರಾಗಿದ್ದರು.<verse eid="1CH 23:14"/></para>
  <para style="li1">
    <verse number="15" style="v" sid="1CH 23:15"/>ಮೋಶೆಯ ಪುತ್ರರು:</para>
  <para style="li2" vid="1CH 23:15">ಗೇರ್ಷೋಮ್ ಮತ್ತು ಎಲೀಯೆಜೆರ್.<verse eid="1CH 23:15"/></para>
  <para style="li1">
    <verse number="16" style="v" sid="1CH 23:16"/>ಗೇರ್ಷೋಮನ ಪುತ್ರರಲ್ಲಿ</para>
  <para style="li2" vid="1CH 23:16">ಶೆಬೂಯೇಲನು ಮೊದಲನೆಯವನಾಗಿದ್ದನು.<verse eid="1CH 23:16"/></para>
  <para style="li1">
    <verse number="17" style="v" sid="1CH 23:17"/>ಎಲೀಯೆಜೆರನ ಪುತ್ರರು:</para>
  <para style="li2" vid="1CH 23:17">ಮೊದಲನೆಯವನಾದ ರೆಹಬ್ಯನು.</para>
  <para style="li2" vid="1CH 23:17">ಇವನ ಹೊರತಾಗಿ ಎಲೀಯೆಜೆರನಿಗೆ ಬೇರೆ ಪುತ್ರರಿಲ್ಲ; ಆದರೆ ರೆಹಬ್ಯನ ಪುತ್ರರು ಬಹಳ ಮಂದಿ ಇದ್ದರು.<verse eid="1CH 23:17"/></para>
  <para style="li1">
    <verse number="18" style="v" sid="1CH 23:18"/>ಇಚ್ಹಾರನ ಪುತ್ರರಲ್ಲಿ</para>
  <para style="li2" vid="1CH 23:18">ಶೆಲೋಮೋತನು ಮೊದಲನೆಯವನಾಗಿದ್ದನು.<verse eid="1CH 23:18"/></para>
  <para style="li1">
    <verse number="19" style="v" sid="1CH 23:19"/>ಹೆಬ್ರೋನನ ಪುತ್ರರಲ್ಲಿ</para>
  <para style="li2" vid="1CH 23:19">ಯೆರೀಯ ಮೊದಲನೆಯವನೂ ಅಮರ್ಯ ಎರಡನೆಯವನು,</para>
  <para style="li2" vid="1CH 23:19">ಯಹಜಿಯೇಲ್ ಮೂರನೆಯವನು, ಯೆಕಮ್ಮಾಮ್ ನಾಲ್ಕನೆಯವನು.<verse eid="1CH 23:19"/></para>
  <para style="li1">
    <verse number="20" style="v" sid="1CH 23:20"/>ಉಜ್ಜೀಯೇಲನ ಪುತ್ರರಲ್ಲಿ</para>
  <para style="li2" vid="1CH 23:20">ಮೀಕನು ಮೊದಲನೆಯವನು, ಇಷೀಯನು ಎರಡನೆಯವನು.<verse eid="1CH 23:20"/></para>
  <para style="s1">ಮೆರಾರೀಯರು</para>
  <para style="li1">
    <verse number="21" style="v" sid="1CH 23:21"/>ಮೆರಾರೀಯ ಪುತ್ರರು:</para>
  <para style="li2" vid="1CH 23:21">ಮಹ್ಲೀ ಮತ್ತು ಮೂಷೀ.</para>
  <para style="li1" vid="1CH 23:21">ಮಹ್ಲೀಯ ಪುತ್ರರು:</para>
  <para style="li2" vid="1CH 23:21">ಎಲಿಯಾಜರ್ ಮತ್ತು ಕೀಷ್.<verse eid="1CH 23:21"/></para>
  <para style="li2">
    <verse number="22" style="v" sid="1CH 23:22"/>ಎಲಿಯಾಜರನು ಗಂಡುಮಕ್ಕಳಿಲ್ಲದೆ ಸತ್ತನು. ಅವನಿಗೆ ಪುತ್ರಿಯರು ಮಾತ್ರ ಇದ್ದರು; ಇವರು ತಮ್ಮ ಬಂಧುಗಳಾದ ಕೀಷನ ಪುತ್ರರೊಂದಿಗೆ ಮದುವೆಯಾದರು.<verse eid="1CH 23:22"/></para>
  <para style="li1">
    <verse number="23" style="v" sid="1CH 23:23"/>ಮೂಷೀಯ ಪುತ್ರರು:</para>
  <para style="li2" vid="1CH 23:23">ಮಹ್ಲೀ, ಏದೆರ್, ಯೆರೇಮೋತ್ ಎಂಬ ಈ ಮೂರು ಮಂದಿ.<verse eid="1CH 23:23"/></para>
  <para style="b"/>
  <para style="li4">
    <verse number="24" style="v" sid="1CH 23:24"/>ಇವರು ತಮ್ಮ ಪಿತೃಗಳ ವಂಶದ ಪ್ರಕಾರವಾಗಿ ಲೇವಿಯ ಪುತ್ರರಾಗಿದ್ದರು. ತಮ್ಮ ಹೆಸರುಗಳಿಂದ, ಎಣಿಕೆಯಾಗಿದ್ದ ಇವರು ತಮ್ಮ ಕುಟುಂಬಗಳಲ್ಲಿ ಮುಖ್ಯಸ್ಥರಾಗಿದ್ದರು. ಇವರು ಇಪ್ಪತ್ತು ವರ್ಷ ಪ್ರಾಯದವರು ಮೊದಲುಗೊಂಡು, ಯೆಹೋವ ದೇವರ ಮನೆಯ ಸೇವೆಗೋಸ್ಕರ ಕೆಲಸಮಾಡಿದರು. <verse eid="1CH 23:24"/><verse number="25" style="v" sid="1CH 23:25"/>ದಾವೀದನು, “ಇಸ್ರಾಯೇಲಿನ ದೇವರಾದ ಯೆಹೋವ ದೇವರು, ಅವರು ಯುಗಯುಗಾಂತರಕ್ಕೂ ಯೆರೂಸಲೇಮಿನಲ್ಲಿ ವಾಸಿಸುವ ಹಾಗೆ ತಮ್ಮ ಜನರಿಗೆ ವಿಶ್ರಾಂತಿಯನ್ನು ಕೊಟ್ಟಿದ್ದಾರೆ,” ಎಂದು ಹೇಳಿ, <verse eid="1CH 23:25"/><verse number="26" style="v" sid="1CH 23:26"/>ಲೇವಿಯರನ್ನು ಕುರಿತು ಅವರು ಗುಡಾರವನ್ನೂ, ಅವರ ಸೇವೆಗೋಸ್ಕರ ಅದರ ಪಾತ್ರೆಗಳನ್ನೂ ಇನ್ನು ಮೇಲೆ ಹೊರುವ ಕೆಲಸವಿಲ್ಲವೆಂದು ಹೇಳಿದ್ದನು. <verse eid="1CH 23:26"/><verse number="27" style="v" sid="1CH 23:27"/>ಏಕೆಂದರೆ ದಾವೀದನ ಕಡೇ ಮಾತುಗಳ ಪ್ರಕಾರ, ಲೇವಿಯರು ಇಪ್ಪತ್ತು ವರ್ಷವೂ ಅದಕ್ಕೆ ಮೇಲ್ಪಟ್ಟ ಪ್ರಾಯದವರು ಮೊದಲುಗೊಂಡು ಎಣಿಕೆಯಾಗಿದ್ದರು.<verse eid="1CH 23:27"/></para>
  <para style="b"/>
  <para style="p">
    <verse number="28" style="v" sid="1CH 23:28"/>ಅವರು ಆರೋನನ ವಂಶಸ್ಥರ ಕೈಕೆಳಗಿದ್ದುಕೊಂಡು ಯೆಹೋವ ದೇವರ ಆಲಯದ ಸೇವೆಗೋಸ್ಕರ ಅಂಗಳಗಳಲ್ಲಿಯೂ ಕೊಠಡಿಗಳಲ್ಲಿಯೂ ಸಮಸ್ತ ಪರಿಶುದ್ಧ ಸಾಮಗ್ರಿಗಳನ್ನು ಶುದ್ಧ ಮಾಡುವುದರಲ್ಲಿಯೂ, <verse eid="1CH 23:28"/><verse number="29" style="v" sid="1CH 23:29"/>ಯೆಹೋವ ದೇವರ ಮಂದಿರದ ಸೇವೆಯ ಕಾರ್ಯದಲ್ಲಿರುವ ಸಮ್ಮುಖದ ರೊಟ್ಟಿಗೋಸ್ಕರವೂ, ಅರ್ಪಣೆ ಬಲಿಯ ನಯವಾದ ಹಿಟ್ಟಿಗೋಸ್ಕರವೂ, ಹುಳಿಯಿಲ್ಲದ ರೊಟ್ಟಿಗಳಿಗೋಸ್ಕರವೂ, ಬಾಂಡ್ಲಿಯಲ್ಲಿ ಮಾಡಿದ್ದಕ್ಕೋಸ್ಕರವೂ, ಕರಿದಿದ್ದಕ್ಕೋಸ್ಕರವೂ, ಸಮಸ್ತ ವಿವಿಧ ಅಳತೆಗೋಸ್ಕರವೂ ಆರೋನನ ಮಕ್ಕಳ ಬಳಿಯಲ್ಲಿ ಅವರಿಗೆ ನೇಮಕವಾಗಿತ್ತು. <verse eid="1CH 23:29"/><verse number="30" style="v" sid="1CH 23:30"/>ಇದಲ್ಲದೆ ಉದಯಕಾಲದಲ್ಲಿಯೂ, ಸಾಯಂಕಾಲದಲ್ಲಿಯೂ ನಿಂತು, ಯೆಹೋವ ದೇವರನ್ನು ಕೊಂಡಾಡುವುದಕ್ಕೂ, ಯೆಹೋವ ದೇವರನ್ನು ಸ್ತುತಿಸುವುದಕ್ಕೂ, <verse eid="1CH 23:30"/><verse number="31" style="v" sid="1CH 23:31"/>ಯೆಹೋವ ದೇವರ ಮುಂದೆ ನಿರಂತರವಾಗಿ ಅವರಿಗೆ ಆಜ್ಞಾಪಿಸಿದ ಕಟ್ಟಳೆಯ ಪ್ರಕಾರವಾಗಿ ಸಬ್ಬತ್ ದಿನಗಳಲ್ಲಿಯೂ ಅಮಾವಾಸ್ಯೆಗಳಲ್ಲಿಯೂ ನೇಮಕವಾದ ಹಬ್ಬಗಳಲ್ಲಿಯೂ ಲೆಕ್ಕದ ಪ್ರಕಾರ ಎಲ್ಲಾ ದಹನಬಲಿಗಳನ್ನು ಅರ್ಪಿಸುವುದು.<verse eid="1CH 23:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="1CH 23:32"/>ಯೆಹೋವ ದೇವರ ಮನೆಯ ಸೇವೆಯಲ್ಲಿ ದೇವದರ್ಶನ ಗುಡಾರದ ಕಾವಲನ್ನೂ, ಪರಿಶುದ್ಧ ಸ್ಥಾನದ ಕಾವಲನ್ನೂ, ತಮ್ಮ ಸಹೋದರರಾದ ಆರೋನನ ಪುತ್ರರ ಆಜ್ಞೆಯನ್ನೂ ಕೈಗೊಳ್ಳುವುದು ಅವರಿಗೆ ನೇಮಕವಾಗಿತ್ತು.<verse eid="1CH 23:32"/></para>
  <chapter eid="1CH 23"/>
  <chapter number="24" style="c" sid="1CH 24"/>
  <para style="s1">ಯಾಜಕ ವರ್ಗಗಳು</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 24:1"/>ಆರೋನನ ಪುತ್ರರಲ್ಲಿ ವರ್ಗಗಳಾಗಿ ವಿಭಾಗ ಆದವರು ಇವರೇ.</para>
  <para style="p" vid="1CH 24:1">ಆರೋನನ ಪುತ್ರರು: ನಾದಾಬ್, ಅಬೀಹೂ, ಎಲಿಯಾಜರ್ ಮತ್ತು ಈತಾಮಾರ್. <verse eid="1CH 24:1"/><verse number="2" style="v" sid="1CH 24:2"/>ಆದರೆ ನಾದಾಬ್ ಮತ್ತು ಅಬೀಹೂ ತಮ್ಮ ತಂದೆಗಿಂತ ಮುಂಚೆ ಸತ್ತು ಮಕ್ಕಳಿಲ್ಲದೆ ಇದ್ದುದರಿಂದ ಎಲಿಯಾಜರನೂ, ಈತಾಮಾರನೂ ಯಾಜಕ ಸೇವೆ ಮಾಡಿದರು. <verse eid="1CH 24:2"/><verse number="3" style="v" sid="1CH 24:3"/>ಆದ್ದರಿಂದ ದಾವೀದನು ಎಲಿಯಾಜರನ ಮಕ್ಕಳಲ್ಲಿ ಚಾದೋಕನಿಗೂ, ಈತಾಮಾರನ ಮಕ್ಕಳಲ್ಲಿ ಅಹೀಮೆಲೆಕನಿಗೂ ಅವರ ಸೇವೆಯಲ್ಲಿರುವ ಪದ್ದತಿಗಳ ಪ್ರಕಾರ ವರ್ಗಗಳನ್ನು ವಿಭಾಗಿಸಿದನು. <verse eid="1CH 24:3"/><verse number="4" style="v" sid="1CH 24:4"/>ಈತಾಮಾರನ ಪುತ್ರರಿಗಿಂತ ಎಲಿಯಾಜರನ ಪುತ್ರರಲ್ಲಿ ಮುಖ್ಯಸ್ಥರು ಹೆಚ್ಚಾಗಿದ್ದುದರಿಂದ, ಅವರು ಸಹ ಹೀಗೆಯೇ ವಿಭಾಗಿಸಿದ್ದರು. ಎಲಿಯಾಜರನ ಪುತ್ರರಲ್ಲಿ ತಮ್ಮ ಪಿತೃಗಳ ಮನೆಯ ಪ್ರಕಾರ ಹದಿನಾರು ಮಂದಿ ಮುಖ್ಯಸ್ಥರು. ಈತಾಮಾರನ ಪುತ್ರರಲ್ಲಿ ತಮ್ಮ ಪಿತೃಗಳ ಮನೆಯ ಪ್ರಕಾರ ಎಂಟು ಮಂದಿ ಮುಖ್ಯಸ್ಥರು. <verse eid="1CH 24:4"/><verse number="5" style="v" sid="1CH 24:5"/>ಇವರು ಸಹ ಚೀಟುಹಾಕುವ ಮೂಲಕ ನಿಷ್ಪಕ್ಷಪಾತವಾಗಿ ವಿಭಾಗವಾಗಿದ್ದರು. ಏಕೆಂದರೆ ಪರಿಶುದ್ಧ ಸ್ಥಾನದ ಪ್ರಧಾನರೂ, ದೇವರ ಪ್ರಧಾನರೂ ಎಲಿಯಾಜರನ ಪುತ್ರರೂ, ಈತಾಮಾರನ ಪುತ್ರರೂ ಇದ್ದರು.<verse eid="1CH 24:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="1CH 24:6"/>ಇದಲ್ಲದೆ ಲೇವಿಯರಲ್ಲಿ ಒಬ್ಬನಾದಂಥ ನೆತನೆಯೇಲ್ ಇವನ ಮಗ ಲೇಖಕನಾದ ಶೆಮಾಯನು ಅರಸನ ಮುಂದೆಯೂ; ಪ್ರಧಾನರು, ಯಾಜಕನಾದ ಚಾದೋಕನು, ಅಬಿಯಾತರನ ಮಗ ಅಹೀಮೆಲೆಕನು, ಯಾಜಕರ ಲೇವಿಯರ ಪಿತೃಗಳ ಮುಖ್ಯಸ್ಥರ ಮುಂದೆಯೂ ಅವರ ಹೆಸರುಗಳನ್ನು ಬರೆದನು. ಎಲಿಯಾಜರನಿಗೋಸ್ಕರ ಒಂದು ಶ್ರೇಷ್ಠ ಮನೆ ತೆಗೆದುಕೊಳ್ಳಲಾಯಿತು. ಅದರಂತೆಯೇ, ಈತಾಮಾರನಿಗೋಸ್ಕರವೂ ಒಂದು ತೆಗೆದುಕೊಳ್ಳಲಾಯಿತು.<verse eid="1CH 24:6"/></para>
  <para style="b"/>
  <para style="li1">
    <verse number="7" style="v" sid="1CH 24:7"/>ಮೊದಲನೆಯ ಚೀಟು ಯೆಹೋಯಾರೀಬನಿಗೆ ಬಿದ್ದಿತು;</para>
  <para style="li1" vid="1CH 24:7">ಎರಡನೆಯದು ಯೆದಾಯನಿಗೆ,<verse eid="1CH 24:7"/></para>
  <para style="li1">
    <verse number="8" style="v" sid="1CH 24:8"/>ಮೂರನೆಯದು ಹಾರಿಮನಿಗೆ;</para>
  <para style="li1" vid="1CH 24:8">ನಾಲ್ಕನೆಯದು ಸೆಯೋರೀಮನಿಗೆ;<verse eid="1CH 24:8"/></para>
  <para style="li1">
    <verse number="9" style="v" sid="1CH 24:9"/>ಐದನೆಯದು ಮಲ್ಕೀಯನಿಗೆ;</para>
  <para style="li1" vid="1CH 24:9">ಆರನೆಯದು ಮಿಯಾಮಿನನಿಗೆ;<verse eid="1CH 24:9"/></para>
  <para style="li1">
    <verse number="10" style="v" sid="1CH 24:10"/>ಏಳನೆಯದು ಹಕ್ಕೋಚನಿಗೆ;</para>
  <para style="li1" vid="1CH 24:10">ಎಂಟನೆಯದು ಅಬೀಯನಿಗೆ;<verse eid="1CH 24:10"/></para>
  <para style="li1">
    <verse number="11" style="v" sid="1CH 24:11"/>ಒಂಬತ್ತನೆಯದು ಯೆಷೂವನಿಗೆ;</para>
  <para style="li1" vid="1CH 24:11">ಹತ್ತನೆಯದು ಶೇಕನ್ಯನಿಗೆ;<verse eid="1CH 24:11"/></para>
  <para style="li1">
    <verse number="12" style="v" sid="1CH 24:12"/>ಹನ್ನೊಂದನೆಯದು ಎಲ್ಯಾಷೀಬನಿಗೆ;</para>
  <para style="li1" vid="1CH 24:12">ಹನ್ನೆರಡನೆಯದು ಯಾಕೀಮನಿಗೆ,<verse eid="1CH 24:12"/></para>
  <para style="li1">
    <verse number="13" style="v" sid="1CH 24:13"/>ಹದಿಮೂರನೆಯದು ಹುಪ್ಪನಿಗೆ;</para>
  <para style="li1" vid="1CH 24:13">ಹದಿನಾಲ್ಕನೆಯದು ಯೆಷೆಬಾಬನಿಗೆ;<verse eid="1CH 24:13"/></para>
  <para style="li1">
    <verse number="14" style="v" sid="1CH 24:14"/>ಹದಿನೈದನೆಯದು ಬಿಲ್ಗನಿಗೆ;</para>
  <para style="li1" vid="1CH 24:14">ಹದಿನಾರನೆಯದು ಇಮ್ಮೇರನಿಗೆ;<verse eid="1CH 24:14"/></para>
  <para style="li1">
    <verse number="15" style="v" sid="1CH 24:15"/>ಹದಿನೇಳನೆಯದು ಹೇಜೀರನಿಗೆ;</para>
  <para style="li1" vid="1CH 24:15">ಹದಿನೆಂಟನೆಯದು ಹಪಿಚ್ಚೇಚನಿಗೆ;<verse eid="1CH 24:15"/></para>
  <para style="li1">
    <verse number="16" style="v" sid="1CH 24:16"/>ಹತ್ತೊಂಬತ್ತನೆಯದು ಪೆತಹ್ಯನಿಗೆ;</para>
  <para style="li1" vid="1CH 24:16">ಇಪ್ಪತ್ತನೆಯದು ಯೆಹೆಜ್ಕೇಲನಿಗೆ;<verse eid="1CH 24:16"/></para>
  <para style="li1">
    <verse number="17" style="v" sid="1CH 24:17"/>ಇಪ್ಪತ್ತೊಂದನೆಯದು ಯಾಕೀನನಿಗೆ;</para>
  <para style="li1" vid="1CH 24:17">ಇಪ್ಪತ್ತೆರಡನೆಯದು ಗಾಮೂಲನಿಗೆ;<verse eid="1CH 24:17"/></para>
  <para style="li1">
    <verse number="18" style="v" sid="1CH 24:18"/>ಇಪ್ಪತ್ಮೂರನೆಯದು ದೆಲಾಯನಿಗೆ;</para>
  <para style="li1" vid="1CH 24:18">ಇಪ್ಪತ್ನಾಲ್ಕನೆಯದು ಮಾಜ್ಯನಿಗೆ.<verse eid="1CH 24:18"/></para>
  <para style="b"/>
  <para style="p">
    <verse number="19" style="v" sid="1CH 24:19"/>ಇವೇ ಇಸ್ರಾಯೇಲಿನ ದೇವರಾದ ಯೆಹೋವ ದೇವರು ತಮ್ಮ ತಂದೆ ಆರೋನನಿಗೆ ಆಜ್ಞಾಪಿಸಿದ ಹಾಗೆ, ಅವನ ಕೈಕೆಳಗೆ ತಮ್ಮ ತಮ್ಮ ಕಟ್ಟಳೆಗಳ ಪ್ರಕಾರ, ಯೆಹೋವ ದೇವರ ಮನೆಯಲ್ಲಿ ಸೇವೆ ಮಾಡುವುದಕ್ಕೆ ಬರಬೇಕಾದ ಅವರ ನಿಯಮಗಳು.<verse eid="1CH 24:19"/></para>
  <para style="s1">ಉಳಿದ ಲೇವಿಯರು</para>
  <para style="li4">
    <verse number="20" style="v" sid="1CH 24:20"/>ಲೇವಿಯ ವಂಶಜರಲ್ಲಿ ಉಳಿದವರು ಯಾರೆಂದರೆ:</para>
  <para style="b" vid="1CH 24:20"/>
  <para style="li1" vid="1CH 24:20">ಅಮ್ರಾಮನ ಕುಮಾರರಲ್ಲಿ ಶೂಬಾಯೇಲನು;</para>
  <para style="li2" vid="1CH 24:20">ಶೂಬಾಯೇಲನ ಪುತ್ರರಲ್ಲಿ ಯೆಹ್ದೆಯಾಹನು.<verse eid="1CH 24:20"/></para>
  <para style="li1">
    <verse number="21" style="v" sid="1CH 24:21"/>ರೆಹಬ್ಯನನ್ನು ಕುರಿತು: ರೆಹಬ್ಯನ ಪುತ್ರರಲ್ಲಿ ಇಷೀಯನು ಮೊದಲನೆಯವನು.<verse eid="1CH 24:21"/></para>
  <para style="li1">
    <verse number="22" style="v" sid="1CH 24:22"/>ಇಚ್ಹಾರರಲ್ಲಿ ಶೆಲೋಮೋತನು ಮೊದಲನೆಯವನು.</para>
  <para style="li2" vid="1CH 24:22">ಶೆಲೋಮೋತನ ಪುತ್ರರಲ್ಲಿ ಯಹತನು.<verse eid="1CH 24:22"/></para>
  <para style="li1">
    <verse number="23" style="v" sid="1CH 24:23"/>ಹೆಬ್ರೋನನ ಪುತ್ರರಲ್ಲಿ</para>
  <para style="li2" vid="1CH 24:23">ಯೆರೀಯನು ಮೊದಲನೆಯವನು; ಎರಡನೆಯವನು ಅಮರ್ಯ; ಮೂರನೆಯವನು ಯಹಜಿಯೇಲ್; ನಾಲ್ಕನೆಯವನು ಯೆಕಮ್ಮಾಮ್.<verse eid="1CH 24:23"/></para>
  <para style="li1">
    <verse number="24" style="v" sid="1CH 24:24"/>ಉಜ್ಜೀಯೇಲನ ಕುಮಾರರಲ್ಲಿ ಮೀಕನು;</para>
  <para style="li2" vid="1CH 24:24">ಮೀಕನ ಪುತ್ರರಲ್ಲಿ ಶಾಮೀರನು.<verse eid="1CH 24:24"/></para>
  <para style="li1">
    <verse number="25" style="v" sid="1CH 24:25"/>ಮೀಕನ ಸಹೋದರನು ಇಷೀಯನು;</para>
  <para style="li2" vid="1CH 24:25">ಇಷೀಯನ ಪುತ್ರರಲ್ಲಿ ಜೆಕರ್ಯ.<verse eid="1CH 24:25"/></para>
  <para style="li1">
    <verse number="26" style="v" sid="1CH 24:26"/>ಮೆರಾರೀಯ ಪುತ್ರರಲ್ಲಿ ಮಹ್ಲೀ, ಮೂಷೀ;</para>
  <para style="li2" vid="1CH 24:26">ಯಾಜ್ಯನ ಮಗನು ಬೆನೋನು.<verse eid="1CH 24:26"/></para>
  <para style="li1">
    <verse number="27" style="v" sid="1CH 24:27"/>ಮೆರಾರೀಯ ಪುತ್ರರಲ್ಲಿ</para>
  <para style="li2" vid="1CH 24:27">ಯಾಜ್ಯನಿಗೆ ಬೆನೋ, ಶೋಹಮ್, ಜಕ್ಕೂರ್, ಇಬ್ರೀ ಎಂಬ ಪುತ್ರರಿದ್ದರು.<verse eid="1CH 24:27"/></para>
  <para style="li1">
    <verse number="28" style="v" sid="1CH 24:28"/>ಮಹ್ಲೀಯನಿಗೆ ಎಲಿಯಾಜರನು ಹುಟ್ಟಿದನು; ಎಲಿಯಾಜರನಿಗೆ ಪುತ್ರರಿರಲಿಲ್ಲ.<verse eid="1CH 24:28"/></para>
  <para style="li1">
    <verse number="29" style="v" sid="1CH 24:29"/>ಕೀಷನಿಂದ ಯೆರಹ್ಮೇಲನು.<verse eid="1CH 24:29"/></para>
  <para style="li1">
    <verse number="30" style="v" sid="1CH 24:30"/>ಮೂಷೀಯ ಪುತ್ರರು: ಮಹ್ಲೀ, ಏದೆರ್, ಯೆರೀಮೋತ್.</para>
  <para style="b" vid="1CH 24:30"/>
  <para style="li4" vid="1CH 24:30">ಇವರು ತಮ್ಮ ಕುಟುಂಬಗಳ ಪ್ರಕಾರ ಲೇವಿಯರ ಪುತ್ರರಾಗಿದ್ದರು.<verse eid="1CH 24:30"/></para>
  <para style="b"/>
  <para style="p">
    <verse number="31" style="v" sid="1CH 24:31"/>ಇವರು ಹಾಗೆಯೇ ಅರಸನಾದ ದಾವೀದನ ಸಮ್ಮುಖದಲ್ಲಿಯೂ, ಚಾದೋಕನು, ಅಹೀಮೆಲೆಕನು, ಯಾಜಕರ ಮತ್ತು ಲೇವಿಯರ ಪಿತೃಗಳ ಮುಖ್ಯಸ್ಥರು, ಇವರ ಸಮ್ಮುಖದಲ್ಲಿಯೂ, ಆರೋನನ ಪುತ್ರರಾದ ತಮ್ಮ ಸಹೋದರರಿಗೆ ಎದುರಾಗಿ ಮುಖ್ಯಸ್ಥರಾದ ಪಿತೃಗಳು ತಮ್ಮ ಕಿರಿಯ ಸಹೋದರರಿಗೆದುರಾಗಿ ಚೀಟುಗಳನ್ನು ಹಾಕಿದರು.<verse eid="1CH 24:31"/></para>
  <chapter eid="1CH 24"/>
  <chapter number="25" style="c" sid="1CH 25"/>
  <para style="s1">ಸಂಗೀತಗಾರರು</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 25:1"/>ಇದಲ್ಲದೆ ದಾವೀದನೂ, ಸೈನ್ಯಾಧಿಪತಿಗಳೂ ಆಸಾಫ್, ಹೇಮಾನ್, ಯೆದುತೂನ್; ಇವರ ಪುತ್ರರಲ್ಲಿ ಕಿನ್ನರಿಗಳಿಂದಲೂ, ವೀಣೆಗಳಿಂದಲೂ, ತಾಳಗಳಿಂದಲೂ ಪ್ರವಾದಿಸಲು ತಕ್ಕವರನ್ನು ಸೇವೆಗೆ ಪ್ರತ್ಯೇಕಿಸಿದರು. ಕೆಲಸದವರ ಲೆಕ್ಕವು ಅವರ ಸೇವೆಯ ಪ್ರಕಾರವಾಗಿತ್ತು.<verse eid="1CH 25:1"/></para>
  <para style="b"/>
  <para style="li1">
    <verse number="2" style="v" sid="1CH 25:2"/>ಅವರು ಯಾರೆಂದರೆ: ಆಸಾಫನ ಪುತ್ರರಲ್ಲಿ</para>
  <para style="li2" vid="1CH 25:2">ಜಕ್ಕೂರ್, ಯೋಸೇಫ, ನೆತನ್ಯ, ಅಶರೇಲ; ಇವರು ಆಸಾಫನ ಕೈಕೆಳಗೆ ಪ್ರವಾದಿಸಿದರು. ಇವರು ಅರಸನ ಮೇಲ್ವಿಚಾರಣೆಯಲ್ಲಿದ್ದರು.<verse eid="1CH 25:2"/></para>
  <para style="li1">
    <verse number="3" style="v" sid="1CH 25:3"/>ಯೆದುತೂನನ ಪುತ್ರರಲ್ಲಿ</para>
  <para style="li2" vid="1CH 25:3">ಗೆದಲ್ಯ, ಚೆರೀ, ಯೆಶಾಯ, ಶಿಮ್ಮೀ, ಹಷಬ್ಯ, ಮತ್ತಿತ್ಯ. ಈ ಆರು ಮಂದಿಯು ಯೆದುತೂನನ ಪುತ್ರರು. ತಮ್ಮ ತಂದೆ ಯೆದುತೂನನ ಕೈಕೆಳಗೆ ಕಿನ್ನರಿಗಳನ್ನು ಬಾರಿಸಿ, ಯೆಹೋವ ದೇವರನ್ನು ಕೊಂಡಾಡಿ, ಸ್ತುತಿಸಿ ಪ್ರವಾದಿಸುತ್ತಿದ್ದರು.<verse eid="1CH 25:3"/></para>
  <para style="li1">
    <verse number="4" style="v" sid="1CH 25:4"/>ಹೇಮಾನನ ಪುತ್ರರಲ್ಲಿ</para>
  <para style="li2" vid="1CH 25:4">ಬುಕ್ಕೀಯ, ಮತ್ತನ್ಯ, ಉಜ್ಜೀಯೇಲ್, ಶೆಬೂಯೇಲ್, ಯೆರೀಮೋತ್, ಹನನ್ಯ, ಹನಾನೀ, ಎಲೀಯಾತ್, ಗಿದ್ದಲ್ತಿ, ರೋಮಮ್ತಿಯೆಜೆರ್, ಯೊಷ್ಬೆಕಾಷ, ಮಲ್ಲೋತಿ, ಹೋತೀರ್, ಮಹಜೀಯೋತ್. <verse eid="1CH 25:4"/><verse number="5" style="v" sid="1CH 25:5"/>ಇವರೆಲ್ಲರು ದೇವರ ಕಾರ್ಯಗಳಲ್ಲಿ ಕೊಂಬು ಊದುವ ಅರಸನ ದರ್ಶಿಯಾದ ಹೇಮಾನನ ಪುತ್ರರು. ದೇವರು ಹೇಮಾನನಿಗೆ ಹದಿನಾಲ್ಕು ಮಂದಿ ಪುತ್ರರನ್ನೂ, ಮೂರು ಮಂದಿ ಪುತ್ರಿಯರನ್ನೂ ಕೊಟ್ಟಿದ್ದರು.<verse eid="1CH 25:5"/></para>
  <para style="b"/>
  <para style="p">
    <verse number="6" style="v" sid="1CH 25:6"/>ಯೆಹೋವ ದೇವರ ಆಲಯದಲ್ಲಿ ಆರಾಧನೆ ನಡೆಯುತ್ತಿರುವಾಗ, ಇವರೆಲ್ಲರೂ ತಮ್ಮ ತಂದೆಯ ನೇತೃತ್ವದಲ್ಲಿ ತಾಳ, ಸ್ವರಮಂಡಲ, ಕಿನ್ನರಿ ಇವುಗಳಿಂದ ಗಾಯನ ಮಾಡುತ್ತಿದ್ದರು.</para>
  <para style="p" vid="1CH 25:6">ಹೀಗೆ ಆಸಾಫ್, ಯೆದುತೂನ್, ಹೇಮಾನರು ಅರಸನ ಸೇವೆಯಲ್ಲಿದ್ದರು. <verse eid="1CH 25:6"/><verse number="7" style="v" sid="1CH 25:7"/>ಹೀಗೆಯೇ ಅವರ ಲೆಕ್ಕವೂ, ಯೆಹೋವ ದೇವರ ಹಾಡುಗಳಲ್ಲಿ ತರಬೇತುಪಡೆದ ಸಮಸ್ತ ಪ್ರವೀಣರ ಲೆಕ್ಕ, ತಮ್ಮ ಸಹೋದರರ ಸಹಿತವಾಗಿ ಇನ್ನೂರ ಎಂಬತ್ತೆಂಟು ಮಂದಿಯಾಗಿದ್ದರು. <verse eid="1CH 25:7"/><verse number="8" style="v" sid="1CH 25:8"/>ಇದಲ್ಲದೆ ಹಿರಿಯರು ಕಿರಿಯರ ಹಾಗೆಯೂ, ಶಿಷ್ಯನು ಬೋಧಕನ ಹಾಗೆಯೂ ವರ್ಗಕ್ಕೆ ಎದುರಾಗಿ ವರ್ಗದವರು ಚೀಟುಗಳನ್ನು ಹಾಕಿದರು.<verse eid="1CH 25:8"/></para>
  <para style="b"/>
  <para style="li1">
    <verse number="9" style="v" sid="1CH 25:9"/>ಆಸಾಫನಿಗೋಸ್ಕರ ಮೊದಲನೆಯ ಚೀಟು ಯೋಸೇಫನಿಗೆ ಬಂತು.</para>
  <para style="li1" vid="1CH 25:9">ಎರಡನೆಯದು ಗೆದಲ್ಯನಿಗೆ;</para>
  <para style="li1" vid="1CH 25:9">ಅವನೂ, ಅವನ ಸಹೋದರರೂ, ಅವನ ಪುತ್ರರೂ ಹನ್ನೆರಡು ಮಂದಿ.<verse eid="1CH 25:9"/></para>
  <para style="li1">
    <verse number="10" style="v" sid="1CH 25:10"/>ಮೂರನೆಯದು ಜಕ್ಕೂರನಿಗೆ;</para>
  <para style="li1" vid="1CH 25:10">ಅವನೂ, ಅವನ ಪುತ್ರರೂ, ಅವನ ಸಹೋದರರೂ ಹನ್ನೆರಡು ಮಂದಿ;<verse eid="1CH 25:10"/></para>
  <para style="li1">
    <verse number="11" style="v" sid="1CH 25:11"/>ನಾಲ್ಕನೆಯದು ಇಚ್ರೀಗೆ;</para>
  <para style="li1" vid="1CH 25:11">ಅವನ ಪುತ್ರರೂ, ಅವನ ಸಹೋದರರೂ ಹನ್ನೆರಡು ಮಂದಿ.<verse eid="1CH 25:11"/></para>
  <para style="li1">
    <verse number="12" style="v" sid="1CH 25:12"/>ಐದನೆಯದು ನೆತನ್ಯನಿಗೆ;</para>
  <para style="li1" vid="1CH 25:12">ಅವನೂ, ಅವನ ಪುತ್ರರೂ, ಅವನ ಸಹೋದರರೂ ಹನ್ನೆರಡು ಮಂದಿ.<verse eid="1CH 25:12"/></para>
  <para style="li1">
    <verse number="13" style="v" sid="1CH 25:13"/>ಆರನೆಯದು ಬುಕ್ಕೀಯನಿಗೆ;</para>
  <para style="li1" vid="1CH 25:13">ಅವನೂ, ಅವನ ಪುತ್ರರೂ, ಅವನ ಸಹೋದರರೂ ಹನ್ನೆರಡು ಮಂದಿ.<verse eid="1CH 25:13"/></para>
  <para style="li1">
    <verse number="14" style="v" sid="1CH 25:14"/>ಏಳನೆಯದು ಯೆಸರೇಲನಿಗೆ;</para>
  <para style="li1" vid="1CH 25:14">ಅವನೂ, ಅವನ ಪುತ್ರರೂ, ಅವನ ಸಹೋದರರೂ ಹನ್ನೆರಡು ಮಂದಿ.<verse eid="1CH 25:14"/></para>
  <para style="li1">
    <verse number="15" style="v" sid="1CH 25:15"/>ಎಂಟನೆಯದು ಯೆಶಾಯನಿಗೆ;</para>
  <para style="li1" vid="1CH 25:15">ಅವನೂ, ಅವನ ಪುತ್ರರೂ, ಅವನ ಸಹೋದರರೂ ಹನ್ನೆರಡು ಮಂದಿ.<verse eid="1CH 25:15"/></para>
  <para style="li1">
    <verse number="16" style="v" sid="1CH 25:16"/>ಒಂಬತ್ತನೆಯವನು ಮತ್ತನ್ಯ;</para>
  <para style="li1" vid="1CH 25:16">ಅವನೂ, ಅವನ ಪುತ್ರರೂ, ಅವನ ಸಹೋದರರೂ ಹನ್ನೆರಡು ಮಂದಿ.<verse eid="1CH 25:16"/></para>
  <para style="li1">
    <verse number="17" style="v" sid="1CH 25:17"/>ಹತ್ತನೆಯದು ಶಿಮ್ಮಿಗೆ;</para>
  <para style="li1" vid="1CH 25:17">ಅವನೂ, ಅವನ ಪುತ್ರರೂ, ಅವನ ಸಹೋದರರೂ ಹನ್ನೆರಡು ಮಂದಿ.<verse eid="1CH 25:17"/></para>
  <para style="li1">
    <verse number="18" style="v" sid="1CH 25:18"/>ಹನ್ನೊಂದನೆಯದು ಅಜರಯೇಲನಿಗೆ;</para>
  <para style="li1" vid="1CH 25:18">ಅವನೂ, ಅವನ ಪುತ್ರರೂ, ಅವನ ಸಹೋದರರೂ ಹನ್ನೆರಡು ಮಂದಿ.<verse eid="1CH 25:18"/></para>
  <para style="li1">
    <verse number="19" style="v" sid="1CH 25:19"/>ಹನ್ನೆರಡನೆಯದು ಹಷಬ್ಯನಿಗೆ;</para>
  <para style="li1" vid="1CH 25:19">ಅವನೂ, ಅವನ ಪುತ್ರರೂ, ಅವನ ಸಹೋದರರೂ ಹನ್ನೆರಡು ಮಂದಿ.<verse eid="1CH 25:19"/></para>
  <para style="li1">
    <verse number="20" style="v" sid="1CH 25:20"/>ಹದಿಮೂರನೆಯದು ಶುಬಯೇಲನಿಗೆ;</para>
  <para style="li1" vid="1CH 25:20">ಅವನೂ, ಅವನ ಪುತ್ರರೂ, ಅವನ ಸಹೋದರರೂ ಹನ್ನೆರಡು ಪುತ್ರರೂ, ಅವನ ಸಹೋದರರೂ ಹನ್ನೆರಡು ಮಂದಿ.<verse eid="1CH 25:20"/></para>
  <para style="li1">
    <verse number="21" style="v" sid="1CH 25:21"/>ಹದಿನಾಲ್ಕನೆಯವನು ಮತ್ತಿತ್ಯ;</para>
  <para style="li1" vid="1CH 25:21">ಇವನೂ, ಇವನ ಸಹೋದರರೂ, ಮಕ್ಕಳೂ ಕೂಡಿ ಹನ್ನೆರಡು ಮಂದಿ.<verse eid="1CH 25:21"/></para>
  <para style="li1">
    <verse number="22" style="v" sid="1CH 25:22"/>ಹದಿನೈದನೆಯದು ಯೆರೆಮೋತನಿಗೆ;</para>
  <para style="li1" vid="1CH 25:22">ಅವನ ಪುತ್ರರೂ, ಅವನ ಸಹೋದರರೂ ಹನ್ನೆರಡು ಮಂದಿ.<verse eid="1CH 25:22"/></para>
  <para style="li1">
    <verse number="23" style="v" sid="1CH 25:23"/>ಹದಿನಾರನೆಯದು ಹನನ್ಯನಿಗೆ;</para>
  <para style="li1" vid="1CH 25:23">ಅವನೂ, ಅವನ ಪುತ್ರರೂ, ಅವನ ಸಹೋದರರೂ ಹನ್ನೆರಡು ಮಂದಿ.<verse eid="1CH 25:23"/></para>
  <para style="li1">
    <verse number="24" style="v" sid="1CH 25:24"/>ಹದಿನೇಳನೆಯದು ಯೊಷ್ಬೆಕಾಷನಿಗೆ;</para>
  <para style="li1" vid="1CH 25:24">ಅವನೂ, ಅವನ ಪುತ್ರರೂ, ಅವನ ಸಹೋದರರೂ ಹನ್ನೆರಡು ಮಂದಿ.<verse eid="1CH 25:24"/></para>
  <para style="li1">
    <verse number="25" style="v" sid="1CH 25:25"/>ಹದಿನೆಂಟನೆಯದು ಹನಾನೀಗೆ;</para>
  <para style="li1" vid="1CH 25:25">ಅವನೂ, ಅವನ ಪುತ್ರರೂ, ಅವನ ಸಹೋದರರೂ ಹನ್ನೆರಡು ಮಂದಿ.<verse eid="1CH 25:25"/></para>
  <para style="li1">
    <verse number="26" style="v" sid="1CH 25:26"/>ಹತ್ತೊಂಬತ್ತನೆಯದು ಮಲ್ಲೋತಿಗೆ;</para>
  <para style="li1" vid="1CH 25:26">ಅವನೂ, ಅವನ ಪುತ್ರರೂ, ಅವನ ಸಹೋದರರೂ ಹನ್ನೆರಡು ಮಂದಿ.<verse eid="1CH 25:26"/></para>
  <para style="li1">
    <verse number="27" style="v" sid="1CH 25:27"/>ಇಪ್ಪತ್ತನೆಯದು ಎಲಿಯಾತನಿಗೆ;</para>
  <para style="li1" vid="1CH 25:27">ಅವನೂ, ಅವನ ಪುತ್ರರೂ, ಅವನ ಸಹೋದರರೂ ಹನ್ನೆರಡು ಮಂದಿ.<verse eid="1CH 25:27"/></para>
  <para style="li1">
    <verse number="28" style="v" sid="1CH 25:28"/>ಇಪ್ಪತ್ತೊಂದನೆಯದು ಹೋತೀರನಿಗೆ;</para>
  <para style="li1" vid="1CH 25:28">ಅವನೂ, ಅವನ ಪುತ್ರರೂ, ಅವನ ಸಹೋದರರೂ ಹನ್ನೆರಡು ಮಂದಿ.<verse eid="1CH 25:28"/></para>
  <para style="li1">
    <verse number="29" style="v" sid="1CH 25:29"/>ಇಪ್ಪತ್ತೆರಡನೆಯದು ಗಿದ್ದಲ್ತಿಗೆ;</para>
  <para style="li1" vid="1CH 25:29">ಅವನೂ, ಅವನ ಪುತ್ರರೂ, ಅವನ ಸಹೋದರರೂ ಹನ್ನೆರಡು ಮಂದಿ.<verse eid="1CH 25:29"/></para>
  <para style="li1">
    <verse number="30" style="v" sid="1CH 25:30"/>ಇಪ್ಪತ್ತಮೂರನೆಯದು ಮಹಜೀಯೋತನಿಗೆ;</para>
  <para style="li1" vid="1CH 25:30">ಅವನೂ, ಅವನ ಪುತ್ರರೂ, ಅವನ ಸಹೋದರರೂ ಹನ್ನೆರಡು ಮಂದಿ.<verse eid="1CH 25:30"/></para>
  <para style="li1">
    <verse number="31" style="v" sid="1CH 25:31"/>ಇಪ್ಪತ್ತನಾಲ್ಕನೆಯದು ರೋಮಮ್ತಿಯೆಜೆರನಿಗೆ;</para>
  <para style="li1" vid="1CH 25:31">ಅವನೂ, ಅವನ ಪುತ್ರರೂ, ಅವನ ಸಹೋದರರೂ ಹನ್ನೆರಡು ಮಂದಿ.<verse eid="1CH 25:31"/></para>
  <chapter eid="1CH 25"/>
  <chapter number="26" style="c" sid="1CH 26"/>
  <para style="s1">ದ್ವಾರಪಾಲಕರು</para>
  <para style="li4">
    <verse number="1" style="v" sid="1CH 26:1"/>ದ್ವಾರಪಾಲಕರ ವರ್ಗಗಳು:</para>
  <para style="b" vid="1CH 26:1"/>
  <para style="li4" vid="1CH 26:1">ಕೋರಹಿಯರೊಳಗೆ:</para>
  <para style="li1" vid="1CH 26:1">ಆಸಾಫನ ಪುತ್ರರಲ್ಲಿ ಒಬ್ಬನಾಗಿರುವ ಕೋರೆಯ ಮಗನಾದ ಮೆಷೆಲೆಮ್ಯನು. <verse eid="1CH 26:1"/><verse number="2" style="v" sid="1CH 26:2"/>ಮೆಷೆಲೆಮ್ಯನ ಪುತ್ರರು:</para>
  <para style="li2" vid="1CH 26:2">ಚೊಚ್ಚಲ ಮಗನು ಜೆಕರ್ಯನು; ಎರಡನೆಯವನು ಯೆದೀಯಯೇಲನು;</para>
  <para style="li2" vid="1CH 26:2">ಮೂರನೆಯವನು ಜೆಬದ್ಯನು; ನಾಲ್ಕನೆಯವನು ಯತ್ನಿಯೇಲನು;<verse eid="1CH 26:2"/></para>
  <para style="li2">
    <verse number="3" style="v" sid="1CH 26:3"/>ಐದನೆಯವನು ಏಲಾಮನು; ಆರನೆಯವನು ಯೆಹೋಹಾನಾನನು;</para>
  <para style="li2" vid="1CH 26:3">ಏಳನೆಯವನು ಎಲಿಹೋಯೇನೈನು.<verse eid="1CH 26:3"/></para>
  <para style="li1">
    <verse number="4" style="v" sid="1CH 26:4"/>ಓಬೇದ್ ಏದೋಮನ ಪುತ್ರರು:</para>
  <para style="li2" vid="1CH 26:4">ಚೊಚ್ಚಲ ಮಗನು ಶೆಮಾಯ; ಎರಡನೆಯವನು ಯೆಹೋಜಾಬಾದ್;</para>
  <para style="li2" vid="1CH 26:4">ಮೂರನೆಯವನು ಯೋವಾಹ; ನಾಲ್ಕನೆಯವನು ಸಾಕಾರ;</para>
  <para style="li2" vid="1CH 26:4">ಐದನೆಯವನು ನೆತನೆಯೇಲ್; <verse eid="1CH 26:4"/><verse number="5" style="v" sid="1CH 26:5"/>ಆರನೆಯವನು ಅಮ್ಮಿಯೇಲ್;</para>
  <para style="li2" vid="1CH 26:5">ಏಳನೆಯವನು ಇಸ್ಸಾಕಾರ್ ಮತ್ತು ಎಂಟನೆಯವನು ಪೆಯುಲ್ಲೆತೈ.</para>
  <para style="li2" vid="1CH 26:5">ಓಬೇದ್ ಎದೋಮನು ದೇವರ ಆಶೀರ್ವಾದಕ್ಕೆ ಪಾತ್ರನಾಗಿದ್ದನು.<verse eid="1CH 26:5"/></para>
  <para style="li1">
    <verse number="6" style="v" sid="1CH 26:6"/>ಇದಲ್ಲದೆ ತನ್ನ ಮಗನಾದ ಶೆಮಾಯನಿಗೆ ತಮ್ಮ ತಂದೆಯ ಮನೆಯಲ್ಲಿ ಆಳುವ ಪುತ್ರರು ಹುಟ್ಟಿದರು, ಅವರು ಪರಾಕ್ರಮಶಾಲಿಗಳಾಗಿದ್ದರು. <verse eid="1CH 26:6"/><verse number="7" style="v" sid="1CH 26:7"/>ಶೆಮಾಯನ ಪುತ್ರರು ಯಾರೆಂದರೆ:</para>
  <para style="li2" vid="1CH 26:7">ಒತ್ನಿಯು, ರೆಫಾಯೇಲನು, ಓಬೇದನು, ಎಲ್ಜಾಬಾದನು;</para>
  <para style="li2" vid="1CH 26:7">ಇವರ ಸಹೋದರರಾದ ಪರಾಕ್ರಮವುಳ್ಳ ಎಲೀಹುವು, ಸೆಮಕ್ಯನು.<verse eid="1CH 26:7"/></para>
  <para style="li4">
    <verse number="8" style="v" sid="1CH 26:8"/>ಇವರೆಲ್ಲರು ಓಬೇದ್ ಏದೋಮನ ಪುತ್ರರು; ಇವರೂ, ತಮ್ಮ ಪುತ್ರರೂ, ತಮ್ಮ ಸಹೋದರರೂ ಸೇವೆಗೆ ಶಕ್ತಿಯುಳ್ಳ ಸ್ಥಿತಿವಂತರು; ಒಬೆದೆದೋಮನವರು ಅರವತ್ತೆರಡು ಮಂದಿಯಾಗಿದ್ದರು.<verse eid="1CH 26:8"/></para>
  <para style="li4">
    <verse number="9" style="v" sid="1CH 26:9"/>ಮೆಷೆಲೆಮ್ಯನಿಗೆ ಬಲವುಳ್ಳ ಪುತ್ರರೂ, ಸಹೋದರರೂ ಹದಿನೆಂಟು ಮಂದಿಯಾಗಿದ್ದರು.<verse eid="1CH 26:9"/></para>
  <para style="b"/>
  <para style="li1">
    <verse number="10" style="v" sid="1CH 26:10"/>ಇದಲ್ಲದೆ ಮೆರಾರೀಯ ಮಕ್ಕಳಲ್ಲಿರುವ ಹೋಸ ಎಂಬವನಿಗೆ ಮಕ್ಕಳಿದ್ದರು.</para>
  <para style="li2" vid="1CH 26:10">ಮೊದಲನೆಯವನು ಶಿಮ್ರಿಯು; ಅವನು ಚೊಚ್ಚಲ ಮಗನಲ್ಲ; ಆದರೆ ಅವನ ತಂದೆ ಅವನನ್ನು ಮುಖ್ಯಸ್ಥನನ್ನಾಗಿ ಮಾಡಿದನು;<verse eid="1CH 26:10"/></para>
  <para style="li2">
    <verse number="11" style="v" sid="1CH 26:11"/>ಎರಡನೆಯವನು ಹಿಲ್ಕೀಯನು; ಮೂರನೆಯವನು ಟೆಬಲ್ಯನು;</para>
  <para style="li2" vid="1CH 26:11">ನಾಲ್ಕನೆಯವನು ಜಕರೀಯನು.</para>
  <para style="li4" vid="1CH 26:11">ಹೋಸನ ಸಮಸ್ತ ಪುತ್ರರು ಮತ್ತು ಸಹೋದರರೂ ಹದಿಮೂರು ಮಂದಿಯಾಗಿದ್ದರು.<verse eid="1CH 26:11"/></para>
  <para style="b"/>
  <para style="li4">
    <verse number="12" style="v" sid="1CH 26:12"/>ಇದರಲ್ಲಿ ದ್ವಾರಪಾಲಕರ ವರ್ಗಗಳು ಯೆಹೋವ ದೇವರ ಆಲಯದಲ್ಲಿ ಸೇವೆ ಮಾಡುವುದಕ್ಕೆ ವರ್ಗಕ್ಕೆದುರಾಗಿ ಮುಖ್ಯಸ್ಥರಲ್ಲಿ ವಿಭಾಗಿಸಲಾಗಿದ್ದವು. <verse eid="1CH 26:12"/><verse number="13" style="v" sid="1CH 26:13"/>ಅವರು ಕಿರಿಯರು ಹಿರಿಯರ ಹಾಗೆ ತಮ್ಮ ಪಿತೃಗಳ ಮನೆಯ ಪ್ರಕಾರ ಬಾಗಿಲಿಂದ ಬಾಗಿಲಿಗೂ ಚೀಟುಗಳನ್ನು ಹಾಕಿದರು.<verse eid="1CH 26:13"/></para>
  <para style="li1">
    <verse number="14" style="v" sid="1CH 26:14"/>ಪೂರ್ವದಿಕ್ಕಿನ ಭಾಗದ ಚೀಟು ಶೆಲೆಮ್ಯನಿಗೆ ಬಿತ್ತು.</para>
  <para style="li1" vid="1CH 26:14">ಅವನ ಮಗ ಬುದ್ಧಿಯುಳ್ಳ ಆಲೋಚನೆಯವನಾಗಿರುವ ಜೆಕರ್ಯನಿಗೋಸ್ಕರ ಹಾಕಿದ ಚೀಟು ಉತ್ತರ ಭಾಗಕ್ಕೆ ಇತ್ತು.<verse eid="1CH 26:14"/></para>
  <para style="li1">
    <verse number="15" style="v" sid="1CH 26:15"/>ಓಬೇದ್ ಏದೋಮನಿಗೆ ದಕ್ಷಿಣ ಭಾಗ ಬಂತು. ಅವನ ಪುತ್ರರಿಗೆ ಉಗ್ರಾಣ ಮನೆ ಬಂತು.<verse eid="1CH 26:15"/></para>
  <para style="li1">
    <verse number="16" style="v" sid="1CH 26:16"/>ಶುಪ್ಪೀಮ್, ಹೋಸ ಎಂಬವರಿಗೆ ಪಶ್ಚಿಮದಲ್ಲಿರುವ ಶೆಲ್ಲೆಕೆತ್ ಎಂಬ ಬಾಗಿಲು ಬಂತು.</para>
  <para style="b" vid="1CH 26:16"/>
  <para style="li4" vid="1CH 26:16">ಅವು ಮೇಲಕ್ಕೆ ಹೋಗುವ ರಾಜಮಾರ್ಗದ ಬಳಿಯಲ್ಲಿ ಒಂದಕ್ಕೊಂದು ಎದುರಾಗಿ ವರ್ಗಗಳಿದ್ದವು.<verse eid="1CH 26:16"/></para>
  <para style="li1">
    <verse number="17" style="v" sid="1CH 26:17"/>ಪೂರ್ವ ಕಡೆಯಾಗಿ ಆರು ಮಂದಿ ಲೇವಿಯರಿದ್ದರು.</para>
  <para style="li1" vid="1CH 26:17">ಉತ್ತರ ಭಾಗವಾಗಿ ದಿನಕ್ಕೆ ನಾಲ್ಕು ಮಂದಿಯೂ,</para>
  <para style="li1" vid="1CH 26:17">ದಕ್ಷಿಣ ಭಾಗವಾಗಿ ದಿನಕ್ಕೆ ನಾಲ್ಕು ಮಂದಿಯೂ</para>
  <para style="li1" vid="1CH 26:17">ಉಗ್ರಾಣ ಮಂದಿರದ ಬಳಿಯಲ್ಲಿ ಇಬ್ಬರಿಬ್ಬರಾಗಿಯೂ,<verse eid="1CH 26:17"/></para>
  <para style="li1">
    <verse number="18" style="v" sid="1CH 26:18"/>ಪಶ್ಚಿಮ ಭಾಗವಾದ ದೇವಾಲಯದ ಅಂಗಳಕ್ಕೆ ಹೋಗುವ ರಾಜಮಾರ್ಗದಲ್ಲಿ ನಾಲ್ಕು ಮಂದಿಯೂ, ದೇವಾಲಯದ ಅಂಗಳ ಬಳಿಯಲ್ಲಿ ಇಬ್ಬರೂ ಇದ್ದರು.<verse eid="1CH 26:18"/></para>
  <para style="b"/>
  <para style="li4">
    <verse number="19" style="v" sid="1CH 26:19"/>ಕೋರಹೀಯರ ಪುತ್ರರಲ್ಲಿಯೂ, ಮೆರಾರೀಯ ಪುತ್ರರಲ್ಲಿಯೂ ವಿಭಾಗಿಸಿದ ದ್ವಾರಪಾಲಕರ ವರ್ಗಗಳು ಇವೆ.<verse eid="1CH 26:19"/></para>
  <para style="s1">ಖಜಾಂಚಿಗಳೂ, ಇತರ ಅಧಿಕಾರಿಗಳು</para>
  <para style="p">
    <verse number="20" style="v" sid="1CH 26:20"/>ಇದಲ್ಲದೆ ಲೇವಿಯರಲ್ಲಿ ಅಹೀಯನು ದೇವರ ಆಲಯದ ಬೊಕ್ಕಸದ ಮೇಲೆಯೂ, ಪ್ರತಿಷ್ಠಿತವಾದವುಗಳ ಬೊಕ್ಕಸಗಳ ಮೇಲೆಯೂ ಅಧಿಕಾರಿಯಾಗಿದ್ದನು.<verse eid="1CH 26:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="1CH 26:21"/>ಲದ್ದಾನನ ವಂಶಜರು: ಗೇರ್ಷೋನ್ಯನಾದ ಲದ್ದಾನನ ಪುತ್ರರು ಕುಟುಂಬಗಳ ಮುಖ್ಯಸ್ಥರಾಗಿದ್ದರು. ಈ ಗೇರ್ಷೋನ್ಯನಾದ ಲಡಾನನ ಮಗನು ಯೆಹೀಯೇಲನು. <verse eid="1CH 26:21"/><verse number="22" style="v" sid="1CH 26:22"/>ಯೆಹೀಯೇಲನ ಪುತ್ರರು ಜೇತಾಮನು, ಅವನ ಸಹೋದರನಾದ ಯೋಯೇಲನು; ಇವರು ಯೆಹೋವ ದೇವರ ಆಲಯದ ಬೊಕ್ಕಸಗಳ ಮೇಲೆ ಇದ್ದರು.<verse eid="1CH 26:22"/></para>
  <para style="b"/>
  <para style="li4">
    <verse number="23" style="v" sid="1CH 26:23"/>ಅಮ್ರಾಮಿಯರಲ್ಲಿಯೂ ಇಚ್ಹಾರರಲ್ಲಿಯೂ ಹೆಬ್ರೋನಿಯರಲ್ಲಿಯೂ ಉಜ್ಜೀಯೇಲರಲ್ಲಿಯೂ ಇವರ ಸಂತಾನದವರಲ್ಲಿ:<verse eid="1CH 26:23"/></para>
  <para style="b"/>
  <para style="li2">
    <verse number="24" style="v" sid="1CH 26:24"/>ಮೋಶೆಯ ಮೊಮ್ಮಗನೂ, ಗೇರ್ಷೋಮನ ಮಗನೂ ಆಗಿರುವ ಶೆಬೂಯೇಲನು ಬೊಕ್ಕಸಗಳ ಮೇಲೆ ಅಧಿಕಾರಿಯಾಗಿದ್ದನು. <verse eid="1CH 26:24"/><verse number="25" style="v" sid="1CH 26:25"/>ಇವನ ಸಹೋದರರು, ಎಲೀಯೆಜೆರನ ಮಗನು ರೆಹಬ್ಯನು, ಇವನ ಮಗನು ಯೆಶಾಯನು, ಇವನ ಮಗನು ಯೋರಾಮ, ಇವನ ಮಗನು ಜಿಕ್ರಿಯು, ಇವನ ಮಗನು ಶೆಲೋಮೋತನು.<verse eid="1CH 26:25"/></para>
  <para style="li2">
    <verse number="26" style="v" sid="1CH 26:26"/>ಈ ಶೆಲೋಮೋತನೂ ಅವನ ಸಹೋದರರೂ ಅರಸನಾದ ದಾವೀದನೂ ಮುಖ್ಯಸ್ಥರಾದ ಪಿತೃಗಳೂ ಸೈನ್ಯಾಧಿಪತಿಗಳಾದ ಸಹಸ್ರಗಳ ಮೇಲೆಯೂ ಶತ್ರುಗಳ ಮೇಲೆಯೂ ಅಧಿಪತಿಗಳಾದವರೂ ಪ್ರತಿಷ್ಠೆ ಮಾಡಿದ ಪ್ರತಿಷ್ಠಿತವಾದವುಗಳ ಬೊಕ್ಕಸಗಳನ್ನು ಕಾಯುತ್ತಿದ್ದರು. <verse eid="1CH 26:26"/><verse number="27" style="v" sid="1CH 26:27"/>ಅವರು ಯೆಹೋವ ದೇವರ ಆಲಯವನ್ನು ದುರಸ್ತಿಪಡಿಸುವುದಕ್ಕೆ ಯುದ್ಧಗಳಿಂದಲೂ, ಕೊಳ್ಳೆಯಿಂದಲೂ ಸಂಪಾದಿಸಿದವುಗಳನ್ನು ಪ್ರತಿಷ್ಠೆ ಮಾಡಿದರು. <verse eid="1CH 26:27"/><verse number="28" style="v" sid="1CH 26:28"/>ಇದಲ್ಲದೆ ದರ್ಶಿಯಾದ ಸಮುಯೇಲನೂ, ಕೀಷನ ಮಗ ಸೌಲನೂ, ನೇರನ ಮಗ ಅಬ್ನೇರನೂ, ಚೆರೂಯಳ ಮಗ ಯೋವಾಬನೂ ಪ್ರತಿಷ್ಠೆ ಮಾಡಿದ್ದೆಲ್ಲವೂ ಮತ್ತು ಯಾರು ಪ್ರತಿಷ್ಠೆ ಮಾಡಿದ್ದರೋ, ಅದೆಲ್ಲವೂ ಶೆಲೋಮೋತನ ಕೈಕೆಳಗೂ, ಅವನ ಸಹೋದರರ ಕೈಕೆಳಗೂ ಇತ್ತು.<verse eid="1CH 26:28"/></para>
  <para style="li2">
    <verse number="29" style="v" sid="1CH 26:29"/>ಇಚ್ಹಾರರಲ್ಲಿ</para>
  <para style="li2" vid="1CH 26:29">ಕೆನನ್ಯನನ್ನು, ಅವನ ಪುತ್ರರನ್ನು ಪಾರುಪತ್ಯಗಾರರಿಗೋಸ್ಕರವೂ, ನ್ಯಾಯಾಧಿಪತಿಗಳಿಗೋಸ್ಕರವೂ ಇಸ್ರಾಯೇಲಿನ ಮೇಲೆ ಹೊರಗಿನ ಕಾರ್ಯಗಳನ್ನು ನೋಡಲು ನೇಮಿಸಲಾಗಿತ್ತು.<verse eid="1CH 26:29"/></para>
  <para style="li2">
    <verse number="30" style="v" sid="1CH 26:30"/>ಹೆಬ್ರೋನಿಯರಲ್ಲಿ</para>
  <para style="li2" vid="1CH 26:30">ಬಲವುಳ್ಳವರಾದ ಹಷಬ್ಯನೂ, ಅವನ ಸಹೋದರರೂ ಯೆಹೋವ ದೇವರ ಸಮಸ್ತ ಕಾರ್ಯಗಳಲ್ಲಿಯೂ, ಅರಸನ ಸೇವೆಯಲ್ಲಿಯೂ ಸಾವಿರದ ಏಳು ನೂರು ಮಂದಿ ಪಶ್ಚಿಮವಾಗಿ ಯೊರ್ದನ್ ನದಿ ಈಚೆಯಲ್ಲಿ ಇಸ್ರಾಯೇಲರೊಳಗೆ ಅಧಿಪತಿಗಳಾಗಿದ್ದರು. <verse eid="1CH 26:30"/><verse number="31" style="v" sid="1CH 26:31"/>ಹೆಬ್ರೋನಿಯರಲ್ಲಿ ಯೆರೀಯನು ತನ್ನ ಪಿತೃಗಳ ಸಂತತಿಗಳ ಪ್ರಕಾರ ಹೆಬ್ರೋನ್ಯರಲ್ಲಿ ಮುಖ್ಯಸ್ಥನಾಗಿದ್ದನು.</para>
  <para style="li2" vid="1CH 26:31">ಇವರು ದಾವೀದನ ಆಳಿಕೆಯ ನಲ್ವತ್ತನೆಯ ವರ್ಷದಲ್ಲಿ ಆಯ್ಕೆಯಾಗಿದ್ದರು. ಆಗ ಗಿಲ್ಯಾದಿನ ಯಜ್ಜೇರಿನಲ್ಲಿ ಅವರೊಳಗೆ ಬಲವುಳ್ಳ ಪರಾಕ್ರಮಶಾಲಿಗಳು ಸಿಕ್ಕಿದರು. <verse eid="1CH 26:31"/><verse number="32" style="v" sid="1CH 26:32"/>ಇದಲ್ಲದೆ ಬಲವುಳ್ಳವರಾದ ಯೆರೀಯನ ಸಹೋದರರು ಎರಡು ಸಾವಿರದ ಏಳು ನೂರು ಮಂದಿ ಕುಟುಂಬಗಳ ಮುಖ್ಯಸ್ಥರಾಗಿದ್ದರು. ಅರಸನಾದ ದಾವೀದನು ಇವರನ್ನು ದೇವರ ಸಮಸ್ತ ಕಾರ್ಯಗಳ ನಿಮಿತ್ತವಾಗಿಯೂ ರೂಬೇನ್ಯರ ಮೇಲೆಯೂ, ಗಾದ್ಯರ ಮೇಲೆಯೂ, ಮನಸ್ಸೆಯ ಅರ್ಧ ಗೋತ್ರದ ಮೇಲೆಯೂ ಅಧಿಪತಿಗಳಾಗಿ ಮಾಡಿದನು.<verse eid="1CH 26:32"/></para>
  <chapter eid="1CH 26"/>
  <chapter number="27" style="c" sid="1CH 27"/>
  <para style="s1">ಸೈನಿಕರ ವಿಭಜನೆ</para>
  <para style="li4">
    <verse number="1" style="v" sid="1CH 27:1"/>ಇಸ್ರಾಯೇಲರು ತಮ್ಮ ಲೆಕ್ಕದ ಪ್ರಕಾರವಾಗಿ ಹೀಗೆಯೇ ಇದ್ದರು. ಹೇಗೆಂದರೆ, ಕುಟುಂಬಗಳ ಮುಖ್ಯಸ್ಥರೂ ಸಹಸ್ರಾಧಿಪತಿಗಳೂ, ಶತಾಧಿಪತಿಗಳೂ, ಅಧಿಪತಿಗಳೂ ವರ್ಷದ ಎಲ್ಲಾ ತಿಂಗಳುಗಳಲ್ಲಿ ಪ್ರತಿ ತಿಂಗಳು ಸರತಿಯಂತೆ ಬರುತ್ತಿದ್ದ ವರ್ಗಗಳ ಕಾರ್ಯಗಳಲ್ಲಿ ಅರಸನನ್ನು ಸೇವಿಸಿದ ಅವರ ಪಾರುಪತ್ಯಗಾರರೂ ಪ್ರತಿವರ್ಗದಲ್ಲಿ 24,000 ಮಂದಿಯಿದ್ದರು.<verse eid="1CH 27:1"/></para>
  <para style="b"/>
  <para style="li1">
    <verse number="2" style="v" sid="1CH 27:2"/>ಮೊದಲನೆಯ ತಿಂಗಳಿಗೋಸ್ಕರ ಮೊದಲನೆಯ ವರ್ಗದ ಮೇಲೆ ಜಬ್ದಿಯೇಲನ ಮಗ ಯಾಷೊಬ್ಬಾಮನು. ಅವನ ವರ್ಗದಲ್ಲಿ ಇಪ್ಪತ್ತನಾಲ್ಕು ಸಾವಿರ ಜನರು. <verse eid="1CH 27:2"/><verse number="3" style="v" sid="1CH 27:3"/>ಮೊದಲನೆಯ ತಿಂಗಳಿನ ಸೈನ್ಯದ ಸಮಸ್ತ ಅಧಿಪತಿಗಳಲ್ಲಿದ್ದ ಪ್ರಧಾನನಾದವನು ಪೆರೆಚನ ಮಕ್ಕಳಲ್ಲಿ ಒಬ್ಬನಾಗಿದ್ದನು.<verse eid="1CH 27:3"/></para>
  <para style="li1">
    <verse number="4" style="v" sid="1CH 27:4"/>ಎರಡನೆಯ ತಿಂಗಳಿನ ವರ್ಗದ ಮೇಲೆ ಅಹೋಹ್ಯನಾದ ದೊದಾಯಿಯು. ಅವನ ವರ್ಗದಲ್ಲಿ ಮಿಕ್ಲೋತನು ನಾಯಕನಾಗಿದ್ದನು. ಅವನ ವರ್ಗದಲ್ಲಿ 24,000 ಜನರಿದ್ದರು.<verse eid="1CH 27:4"/></para>
  <para style="li1">
    <verse number="5" style="v" sid="1CH 27:5"/>ಮೂರನೆಯ ತಿಂಗಳಿನ ಸೈನ್ಯದ ಮೂರನೆಯ ಅಧಿಪತಿಯು, ಯಾಜಕನಾಗಿರುವ ಯೆಹೋಯಾದಾವನ ಮಗ ಬೆನಾಯನು. ಅವನ ವರ್ಗದಲ್ಲಿ ಇಪ್ಪತ್ತನಾಲ್ಕು ಸಾವಿರ ಜನರು. <verse eid="1CH 27:5"/><verse number="6" style="v" sid="1CH 27:6"/>ಈ ಬೆನಾಯನು ಮೂವತ್ತು ಮಂದಿಯಲ್ಲಿ ಪರಾಕ್ರಮಶಾಲಿಯಾದವನಾಗಿ ಮೂವತ್ತು ಮಂದಿಯ ಮೇಲೆ ಮುಖ್ಯಸ್ಥನಾಗಿದ್ದನು. ಅವನ ವರ್ಗದಲ್ಲಿ ಅವನ ಮಗ ಅಮ್ಮೀಜಾಬಾದನು ಇದ್ದನು.<verse eid="1CH 27:6"/></para>
  <para style="li1">
    <verse number="7" style="v" sid="1CH 27:7"/>ನಾಲ್ಕನೆಯ ತಿಂಗಳಿನ ನಾಲ್ಕನೆಯವನು ಯೋವಾಬನ ಸಹೋದರನಾದ ಅಸಾಯೇಲನು; ಅವನ ತರುವಾಯ ಅವನ ಮಗ ಜೆಬದ್ಯನು; ಅವನ ವರ್ಗದಲ್ಲಿ 24,000 ಜನರು.<verse eid="1CH 27:7"/></para>
  <para style="li1">
    <verse number="8" style="v" sid="1CH 27:8"/>ಐದನೆಯ ತಿಂಗಳಿನ ಐದನೆಯ ಅಧಿಪತಿಯು ಇಜ್ರಾಹನಾದ ಶಮ್ಹೂತನು; ಅವನ ವರ್ಗದಲ್ಲಿ 24,000 ಜನರು.<verse eid="1CH 27:8"/></para>
  <para style="li1">
    <verse number="9" style="v" sid="1CH 27:9"/>ಆರನೆಯ ತಿಂಗಳಿನ ಆರನೆಯವನು ತೆಕೋವಿಯನಾಗಿರುವ ಇಕ್ಕೇಷನ ಮಗ ಈರನು; ಅವನ ವರ್ಗದಲ್ಲಿ 24,000 ಜನರು.<verse eid="1CH 27:9"/></para>
  <para style="li1">
    <verse number="10" style="v" sid="1CH 27:10"/>ಏಳನೆಯ ತಿಂಗಳಿನ ಏಳನೆಯವನು ಎಫ್ರಾಯೀಮನ ಮಕ್ಕಳಲ್ಲಿ ಒಬ್ಬನಾಗಿರುವ ಪೆಲೋನ್ಯನಾದ ಹೆಲೆಚನು; ಅವನ ವರ್ಗದಲ್ಲಿ 24,000 ಜನರು.<verse eid="1CH 27:10"/></para>
  <para style="li1">
    <verse number="11" style="v" sid="1CH 27:11"/>ಎಂಟನೆಯ ತಿಂಗಳಿನ ಎಂಟನೆಯವನು ಜೆರಹಿಯರಲ್ಲಿ ಒಬ್ಬನಾಗಿರುವ ಹುಷಾತ್ಯನಾದ ಸಿಬ್ಬೆಕೈ; ಅವನ ವರ್ಗದಲ್ಲಿ 24,000 ಜನರು.<verse eid="1CH 27:11"/></para>
  <para style="li1">
    <verse number="12" style="v" sid="1CH 27:12"/>ಒಂಬತ್ತನೆಯ ತಿಂಗಳಿನ ಒಂಬತ್ತನೆಯವನು ಬೆನ್ಯಾಮೀನ್ಯರಲ್ಲಿ ಒಬ್ಬನಾಗಿರುವ ಅನಾತೋತ್ಯನಾದ ಅಬೀಯೆಜೆರನು; ಅವನ ವರ್ಗದಲ್ಲಿ 24,000 ಜನರು.<verse eid="1CH 27:12"/></para>
  <para style="li1">
    <verse number="13" style="v" sid="1CH 27:13"/>ಹತ್ತನೆಯ ತಿಂಗಳಿನ ಹತ್ತನೆಯವನು ಜೆರಹಿಯರಲ್ಲಿ ಒಬ್ಬನಾಗಿರುವ ನೆಟೋಫದವನಾದ ಮಹರೈಯು ಅವನ ವರ್ಗದಲ್ಲಿ 24,000 ಜನರು.<verse eid="1CH 27:13"/></para>
  <para style="li1">
    <verse number="14" style="v" sid="1CH 27:14"/>ಹನ್ನೊಂದನೆಯ ತಿಂಗಳಿನ ಹನ್ನೊಂದನೆಯವನು ಎಫ್ರಾಯೀಮನ ಮಕ್ಕಳಲ್ಲಿ ಒಬ್ಬನಾಗಿರುವ ಪಿರಾತೋನ್ಯನಾದ ಬೆನಾಯನು; ಅವನ ವರ್ಗದಲ್ಲಿ 24,000 ಜನರು.<verse eid="1CH 27:14"/></para>
  <para style="li1">
    <verse number="15" style="v" sid="1CH 27:15"/>ಹನ್ನೆರಡನೆಯ ತಿಂಗಳಿನ ಹನ್ನೆರಡನೆಯವನು ಒತ್ನಿಯೇಲನ ಮಕ್ಕಳಲ್ಲಿ ಒಬ್ಬನಾಗಿರುವ ನೆಟೋಫದವನಾದ ಹೆಲ್ದಾಯಿಯು; ಅವನ ವರ್ಗದಲ್ಲಿ 24,000 ಜನರು.<verse eid="1CH 27:15"/></para>
  <para style="s1">ಇಸ್ರಾಯೇಲಿನ ಗೋತ್ರಗಳ ಮೇಲೆ ಅಧಿಕಾರಿಗಳು</para>
  <para style="li4">
    <verse number="16" style="v" sid="1CH 27:16"/>ಇಸ್ರಾಯೇಲಿನ ಗೋತ್ರಗಳ ಮೇಲೆ ಇರುವ ಅಧಿಕಾರಿಗಳು ಯಾರೆಂದರೆ:</para>
  <para style="b" vid="1CH 27:16"/>
  <para style="li1" vid="1CH 27:16">ರೂಬೇನ್ಯರ ಮೇಲೆ ನಾಯಕನು, ಜಿಕ್ರಿಯ ಮಗ ಎಲೀಯೆಜೆರನು.</para>
  <para style="li1" vid="1CH 27:16">ಸಿಮೆಯೋನ್ಯರ ಮೇಲೆ ನಾಯಕನು, ಮಾಕನ ಮಗ ಶೆಫಟ್ಯನು.<verse eid="1CH 27:16"/></para>
  <para style="li1">
    <verse number="17" style="v" sid="1CH 27:17"/>ಲೇವಿಯರ ಮೇಲೆ ಕೆಮುವೇಲನ ಮಗ ಹಷಬ್ಯನು.</para>
  <para style="li1" vid="1CH 27:17">ಆರೋನ್ಯರ ಮೇಲೆ ಚಾದೋಕನು.<verse eid="1CH 27:17"/></para>
  <para style="li1">
    <verse number="18" style="v" sid="1CH 27:18"/>ಯೆಹೂದನಿಗೆ ದಾವೀದನ ಸಹೋದರರಲ್ಲಿ ಒಬ್ಬನಾಗಿರುವ ಎಲೀಹುವು;</para>
  <para style="li1" vid="1CH 27:18">ಇಸ್ಸಾಕಾರನಿಗೆ ಮೀಕಾಯೇಲನ ಮಗ ಒಮ್ರಿಯು.<verse eid="1CH 27:18"/></para>
  <para style="li1">
    <verse number="19" style="v" sid="1CH 27:19"/>ಜೆಬುಲೂನನಿಗೆ ಓಬದ್ಯನ ಮಗ ಇಷ್ಮಾಯನು</para>
  <para style="li1" vid="1CH 27:19">ನಫ್ತಾಲಿಯ ಗೋತ್ರಕ್ಕೆ ಅಜ್ರಿಯೇಲನ ಮಗ ಯೆರೀಮೋತನು.<verse eid="1CH 27:19"/></para>
  <para style="li1">
    <verse number="20" style="v" sid="1CH 27:20"/>ಎಫ್ರಾಯೀಮನ ಮಕ್ಕಳಲ್ಲಿ ಅಜಜ್ಯನ ಮಗ ಹೋಶೇಯನು;</para>
  <para style="li1" vid="1CH 27:20">ಮನಸ್ಸೆಯ ಅರ್ಧ ಗೋತ್ರಕ್ಕೆ ಪೆದಾಯನ ಮಗ ಯೋಯೇಲನು.<verse eid="1CH 27:20"/></para>
  <para style="li1">
    <verse number="21" style="v" sid="1CH 27:21"/>ಗಿಲ್ಯಾದಿನಲ್ಲಿರುವ ಮನಸ್ಸೆಯ ಅರ್ಧ ಗೋತ್ರಕ್ಕೆ ಜೆಕರ್ಯನ ಮಗ ಇದ್ದೋನು;</para>
  <para style="li1" vid="1CH 27:21">ಬೆನ್ಯಾಮೀನನ ಗೋತ್ರಕ್ಕೆ ಅಬ್ನೇರನ ಮಗ ಯಾಸೀಯೇಲನು;<verse eid="1CH 27:21"/></para>
  <para style="li1">
    <verse number="22" style="v" sid="1CH 27:22"/>ದಾನನ ಗೋತ್ರಕ್ಕೆ ಯೆರೋಹಾಮನ ಮಗ ಅಜರಯೇಲ್.</para>
  <para style="b" vid="1CH 27:22"/>
  <para style="li4" vid="1CH 27:22">ಇವರೇ ಇಸ್ರಾಯೇಲಿನ ಗೋತ್ರಗಳ ಪ್ರಧಾನರು.<verse eid="1CH 27:22"/></para>
  <para style="b"/>
  <para style="p">
    <verse number="23" style="v" sid="1CH 27:23"/>ದಾವೀದನು ಇಪ್ಪತ್ತು ವರ್ಷಗಳೊಳಗೆ ಇದ್ದವರ ಲೆಕ್ಕ ತೆಗೆದುಕೊಳ್ಳಲಿಲ್ಲ. ಏಕೆಂದರೆ, “ಇಸ್ರಾಯೇಲನನ್ನು ಆಕಾಶದ ನಕ್ಷತ್ರಗಳ ಹಾಗೆ ಹೆಚ್ಚಾಗಿ ಮಾಡುವೆನು,” ಎಂದು ಯೆಹೋವ ದೇವರು ಹೇಳಿದ್ದರು. <verse eid="1CH 27:23"/><verse number="24" style="v" sid="1CH 27:24"/>ಚೆರೂಯಳ ಮಗ ಯೋವಾಬನು ಎಣಿಸಲು ಆರಂಭಿಸಿದನು. ಆದರೆ ಇಸ್ರಾಯೇಲಿಗೆ ವಿರೋಧವಾಗಿ ದೇವರ ಕೋಪಾಗ್ನಿಯು ಬಂದದ್ದರಿಂದ, ಅವನು ಪೂರ್ತಿಗೊಳಿಸಲಿಲ್ಲ. ಆ ಲೆಕ್ಕವು ಅರಸನಾದ ದಾವೀದನ ಇತಿಹಾಸಗಳ ಪುಸ್ತಕದಲ್ಲಿ ಲಿಖಿತವಾಗಲಿಲ್ಲ.<verse eid="1CH 27:24"/></para>
  <para style="s1">ಅರಸನ ಬೊಕ್ಕಸಗಳ ಮೇಲೆ ಅಧಿಕಾರಿಗಳು</para>
  <para style="li1">
    <verse number="25" style="v" sid="1CH 27:25"/>ಅರಸನ ಬೊಕ್ಕಸಗಳ ಮೇಲೆ ಅದೀಯೇಲನ ಮಗ ಅಜ್ಮಾವೆತನು ಇದ್ದನು.</para>
  <para style="li1" vid="1CH 27:25">ಹೊಲಗಳಲ್ಲಿಯೂ, ಪಟ್ಟಣಗಳಲ್ಲಿಯೂ, ಗ್ರಾಮಗಳಲ್ಲಿಯೂ, ಬುರುಜುಗಳ ಮೇಲೆಯೂ ಇದ್ದ ಉಗ್ರಾಣಗಳ ಮೇಲೆ ಉಜ್ಜೀಯನ ಮಗ ಯೋನಾತಾನನು ಇದ್ದನು.<verse eid="1CH 27:25"/></para>
  <para style="li1">
    <verse number="26" style="v" sid="1CH 27:26"/>ಹೊಲವನ್ನು ವ್ಯವಸಾಯ ಮಾಡುವ ಕೆಲಸದವರ ಮೇಲೆ ಕೆಲೂಬನ ಮಗ ಎಜ್ರಿಯು ಇದ್ದನು.<verse eid="1CH 27:26"/></para>
  <para style="li1">
    <verse number="27" style="v" sid="1CH 27:27"/>ರಾಮಾ ಊರಿನ ಶಿಮ್ಮೀ ದ್ರಾಕ್ಷಿತೋಟಗಳನ್ನು ನೋಡಿಕೊಳ್ಳುತ್ತಿದ್ದನು.</para>
  <para style="li1" vid="1CH 27:27">ದ್ರಾಕ್ಷಿ ತೋಟಗಳಲ್ಲಿರುವ ದ್ರಾಕ್ಷಾರಸದ ಉಗ್ರಾಣಗಳ ಮೇಲೆ ಶಿಪ್ಮೀಯನಾದ ಜಬ್ದೀ ಜವಾಬ್ದಾರಿಯಾಗಿದ್ದನು.<verse eid="1CH 27:27"/></para>
  <para style="li1">
    <verse number="28" style="v" sid="1CH 27:28"/>ತಗ್ಗಿನಲ್ಲಿರುವ ಓಲಿವ್ ಮರಗಳ ಮೇಲೆಯೂ, ಅತ್ತಿಮರಗಳ ಮೇಲೆಯೂ ಗೆದೇರ್ಯನಾದ ಬಾಳ್ ಹಾನಾನನು ಇದ್ದನು.</para>
  <para style="li1" vid="1CH 27:28">ಎಣ್ಣೆಯ ಉಗ್ರಾಣಗಳ ಮೇಲೆ ಯೋವಾಷನು ಜವಾಬ್ದಾರಿಯಾಗಿದ್ದನು.<verse eid="1CH 27:28"/></para>
  <para style="li1">
    <verse number="29" style="v" sid="1CH 27:29"/>ಶಾರೋನಿನಲ್ಲಿ ಮೇಯಿಸುವ ದನಗಳ ಮೇಲೆ ಶಾರೋನಿನವನಾದ ಶಿಟ್ರೈ ಜವಾಬ್ದಾರಿಯಾಗಿದ್ದನು.</para>
  <para style="li1" vid="1CH 27:29">ತಗ್ಗುಗಳಲ್ಲಿರುವ ದನಗಳ ಮೇಲೆ ಅಡ್ಲಾಯಿಯ ಮಗನಾದ ಶಾಫಾಟನು ಜವಾಬ್ದಾರಿಯಾಗಿದ್ದನು.<verse eid="1CH 27:29"/></para>
  <para style="li1">
    <verse number="30" style="v" sid="1CH 27:30"/>ಒಂಟೆಗಳ ಮೇಲೆ ಜವಾಬ್ದಾರಿಯಾಗಿದ್ದವನು ಇಷ್ಮಾಯೇಲನಾದ ಓಬೀಲ್.</para>
  <para style="li1" vid="1CH 27:30">ಕತ್ತೆಗಳ ಮೇಲೆ ಜವಾಬ್ದಾರಿಯಾಗಿದ್ದವನು ಮೇರೊನೋತ್ಯನಾದ ಯೆಹ್ದೆಯ.<verse eid="1CH 27:30"/></para>
  <para style="li1">
    <verse number="31" style="v" sid="1CH 27:31"/>ಕುರಿ ಮಂದೆಗಳ ಮೇಲೆ ಜವಾಬ್ದಾರಿಯಾಗಿದ್ದವನು ಹಗ್ರೀಯನಾದ ಯಾಜೀಜ್.</para>
  <para style="li4" vid="1CH 27:31">ಇವರೆಲ್ಲರು ಅರಸನಾದ ದಾವೀದನ ಸ್ವತ್ತಿನ ಮೇಲೆ ಪ್ರಧಾನರಾಗಿದ್ದರು.<verse eid="1CH 27:31"/></para>
  <para style="b"/>
  <para style="li1">
    <verse number="32" style="v" sid="1CH 27:32"/>ಇದಲ್ಲದೆ ದಾವೀದನ ಚಿಕ್ಕಪ್ಪನಾದ ಯೋನಾತಾನನು ಗ್ರಹಿಕೆಯು, ವಿವೇಕಿಯೂ ಆದ ಲೇಖಕನಾಗಿದ್ದನು.</para>
  <para style="li1" vid="1CH 27:32">ಹಕ್ಮೋನಿಯ ಮಗನಾದ ಯೆಹೀಯೇಲ್ ಅರಸನ ಪುತ್ರರನ್ನು ನೋಡಿಕೊಳ್ಳುತ್ತಿದ್ದನು.<verse eid="1CH 27:32"/></para>
  <para style="li1">
    <verse number="33" style="v" sid="1CH 27:33"/>ಅರಸನ ಆಲೋಚನೆಗಾರನು ಅಹೀತೋಫೆಲ್;</para>
  <para style="li1" vid="1CH 27:33">ಅರಸನ ಆಪ್ತ ಸ್ನೇಹಿತನು ಅರ್ಕಿಯನಾದ ಹೂಷೈ.<verse eid="1CH 27:33"/></para>
  <para style="li4">
    <verse number="34" style="v" sid="1CH 27:34"/>ಅಹೀತೋಫೆಲನ ತರುವಾಯ ಬೆನಾಯನ ಮಗನಾದ ಯೆಹೋಯಾದಾವನೂ, ಅಬಿಯಾತರನೂ ಅರಸನ ಆಲೋಚನೆಗಾರರಾಗಿದ್ದರು.</para>
  <para style="li1" vid="1CH 27:34">ಯೋವಾಬನು ಅರಸನ ಸೈನ್ಯಾಧಿಪತಿಯಾಗಿದ್ದನು.<verse eid="1CH 27:34"/></para>
  <chapter eid="1CH 27"/>
  <chapter number="28" style="c" sid="1CH 28"/>
  <para style="s1">ದೇವಾಲಯವನ್ನು ಕುರಿತು ದಾವೀದನ ಆಲೋಚನೆ</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 28:1"/>ದಾವೀದನು ಇಸ್ರಾಯೇಲಿನ ಸಮಸ್ತ ಪ್ರಧಾನ ಗೋತ್ರಗಳ ಪ್ರಧಾನರನ್ನೂ, ವರ್ಗ ವರ್ಗವಾಗಿ ಅರಸನನ್ನು ಸೇವೆಮಾಡಿದ ಸಭೆಗಳ ಪ್ರಧಾನರನ್ನೂ, ಸಹಸ್ರಾಧಿಪತಿಗಳನ್ನೂ, ಶತಾಧಿಪತಿಗಳನ್ನೂ ಅರಸನ ಸ್ವತ್ತಿನ ಮೇಲೆಯೂ, ಅವನ ಪುತ್ರರ ಸ್ವತ್ತಿನ ಮೇಲೆಯೂ ಪಶುಗಳ ಮೇಲೆಯೂ ಇರುವ ಪ್ರಧಾನರನ್ನೂ, ಅಧಿಕಾರಿಗಳನ್ನೂ, ಪರಾಕ್ರಮಶಾಲಿಗಳನ್ನೂ, ಶೂರರನ್ನೂ ಯೆರೂಸಲೇಮಿನಲ್ಲಿ ಕೂಡಿ ಬರಲು ಕರೆಸಿದನು.<verse eid="1CH 28:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="1CH 28:2"/>ಆಗ ಅರಸನಾದ ದಾವೀದನು ಎದ್ದು ನಿಂತು, “ನನ್ನ ಸಹೋದರರೇ, ನನ್ನ ಜನರೇ, ನನ್ನ ಮಾತು ಕೇಳಿರಿ. ಯೆಹೋವ ದೇವರ ಒಡಂಬಡಿಕೆಯ ಮಂಜೂಷದ ನಿಮಿತ್ತವಾಗಿಯೂ, ನಮ್ಮ ದೇವರ ಪಾದಪೀಠದ ನಿಮಿತ್ತವಾಗಿಯೂ ವಿಶ್ರಾಂತಿಗೆ ಆಲಯವನ್ನು ನಾನು ಕಟ್ಟಿಸಲು ಮನಸ್ಸು ಮಾಡಿ, ಅದಕ್ಕಾಗಿ ಎಲ್ಲವನ್ನೂ ಸಿದ್ಧಪಡಿಸಿದೆನು. <verse eid="1CH 28:2"/><verse number="3" style="v" sid="1CH 28:3"/>ಆಗ ದೇವರು ನನಗೆ, ‘ನೀನು ಮಹಾ ಯುದ್ಧಗಳನ್ನು ನಡೆಸಿ, ಬಹಳ ರಕ್ತವನ್ನು ಸುರಿಸಿದವನು; ನನ್ನ ಹೆಸರಿಗೆ ನೀನು ಆಲಯವನ್ನು ಕಟ್ಟಿಸಬಾರದು,’ ಎಂದು ಹೇಳಿದರು.<verse eid="1CH 28:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="1CH 28:4"/>“ಆದರೆ ಇಸ್ರಾಯೇಲಿನ ದೇವರಾದ ಯೆಹೋವ ದೇವರು ಎಂದೆಂದಿಗೂ ಇಸ್ರಾಯೇಲಿನ ಮೇಲೆ ಅರಸನಾಗಿರಲು ನನ್ನ ತಂದೆಯ ಮನೆಯ ಸಮಸ್ತರೊಳಗಿಂದ ನನ್ನನ್ನು ಆರಿಸಿಕೊಂಡರು. ಏಕೆಂದರೆ ಅವನು ನಾಯಕನಾಗಿರಲು ಯೆಹೂದ ಗೋತ್ರವನ್ನೂ, ಯೆಹೂದ ಗೋತ್ರದಿಂದ ನನ್ನ ಕುಟುಂಬವನ್ನೂ ಆದುಕೊಂಡು, ನನ್ನ ತಂದೆಯ ಪುತ್ರರಲ್ಲಿ ನನ್ನನ್ನು ಇಸ್ರಾಯೇಲಿನ ಮೇಲೆ ಅರಸನಾಗಿ ಮಾಡಲು ಚಿತ್ತವುಳ್ಳವರಾಗಿದ್ದರು. <verse eid="1CH 28:4"/><verse number="5" style="v" sid="1CH 28:5"/>ಯೆಹೋವ ದೇವರು ನನಗೆ ಅನೇಕ ಪುತ್ರರನ್ನು ಕೊಟ್ಟಿರುವಾಗ, ನನ್ನ ಸಮಸ್ತ ಪುತ್ರರಲ್ಲಿ ಇಸ್ರಾಯೇಲಿನ ಮೇಲಿಗಾಗಿ, ಯೆಹೋವ ದೇವರ ರಾಜ್ಯದ ಸಿಂಹಾಸನದ ಮೇಲೆ ಕುಳಿತುಕೊಳ್ಳುವುದಕ್ಕೆ ನನ್ನ ಮಗ ಸೊಲೊಮೋನನನ್ನು ಆದುಕೊಂಡರು. <verse eid="1CH 28:5"/><verse number="6" style="v" sid="1CH 28:6"/>ಇದಲ್ಲದೆ ದೇವರು ನನಗೆ, ‘ನಿನ್ನ ಮಗ ಸೊಲೊಮೋನನು ತಾನೇ ನನ್ನ ಆಲಯವನ್ನೂ, ನನ್ನ ಅಂಗಳಗಳನ್ನೂ ಕಟ್ಟಿಸುವನು. ಏಕೆಂದರೆ ಅವನನ್ನು ನನಗೆ ಮಗನಾಗಿರಲು ಆಯ್ದುಕೊಂಡೆನು. ನಾನು ಅವನಿಗೆ ತಂದೆಯಾಗಿರುವೆನು. <verse eid="1CH 28:6"/><verse number="7" style="v" sid="1CH 28:7"/>ಈ ಹೊತ್ತಿನ ಹಾಗೆ ನನ್ನ ಆಜ್ಞೆಗಳನ್ನೂ, ನನ್ನ ನ್ಯಾಯಗಳನ್ನೂ ಅವನು ನಡೆಸಲು ದೃಢನಾಗಿದ್ದರೆ, ಅವನ ರಾಜ್ಯವನ್ನು ಯುಗಯುಗಾಂತರಕ್ಕೂ ಸ್ಥಿರಪಡಿಸುವೆನು,’ ಎಂದರು.<verse eid="1CH 28:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="1CH 28:8"/>“ಆದ್ದರಿಂದ ನೀವು ಈ ಉತ್ತಮ ದೇಶವನ್ನು ಸ್ವಾಧೀನಮಾಡಿಕೊಂಡು, ಅದನ್ನು ನಿರಂತರದಲ್ಲಿ ನಿಮ್ಮ ತರುವಾಯ ಇರುವ ನಿಮ್ಮ ಮಕ್ಕಳಿಗೆ ಬಾಧ್ಯತೆಯಾಗಿ ಕೊಡುವ ಹಾಗೆ, ಯೆಹೋವ ದೇವರ ಸಭೆಯಾದ ಸಮಸ್ತ ಇಸ್ರಾಯೇಲಿನ ಸಮ್ಮುಖದಲ್ಲಿಯೂ, ನಮ್ಮ ದೇವರು ಕೇಳಿಸುವಂತೆ ನಿಮ್ಮ ದೇವರಾದ ಯೆಹೋವ ದೇವರ ಆಜ್ಞೆಗಳನ್ನೆಲ್ಲಾ ಹುಡುಕಿ ಕೈಗೊಳ್ಳಿರಿ ಎಂದು ಎಚ್ಚರಿಸುತ್ತೇನೆ.<verse eid="1CH 28:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="1CH 28:9"/>“ಇದಲ್ಲದೆ ನನ್ನ ಮಗ ಸೊಲೊಮೋನನೇ, ನೀನು ನಿನ್ನ ತಂದೆಯ ದೇವರನ್ನು ಅರಿತುಕೊಂಡು, ಪೂರ್ಣಹೃದಯದಿಂದಲೂ, ಪೂರ್ಣಮನಸ್ಸಿನಿಂದಲೂ ದೇವರನ್ನು ಸೇವಿಸು. ಏಕೆಂದರೆ, ಯೆಹೋವ ದೇವರು ಸಕಲ ಹೃದಯಗಳನ್ನು ಪರಿಶೋಧಿಸಿ, ಯೋಚನೆಗಳ ಕಲ್ಪನೆಯನ್ನೆಲ್ಲಾ ತಿಳಿದಿದ್ದಾರೆ. ನೀನು ದೇವರನ್ನು ಹುಡುಕಿದರೆ, ದೇವರು ನಿನಗೆ ಸಿಕ್ಕುವರು. ನೀನು ದೇವರನ್ನು ಬಿಟ್ಟುಬಿಟ್ಟರೆ, ದೇವರು ಸಹ ನಿನ್ನನ್ನು ಎಂದೆಂದಿಗೂ ತೊರೆದುಬಿಡುವರು. <verse eid="1CH 28:9"/><verse number="10" style="v" sid="1CH 28:10"/>ಆದ್ದರಿಂದ ಜಾಗ್ರತೆಯಾಗಿರು. ಏಕೆಂದರೆ, ಯೆಹೋವ ದೇವರು ಪರಿಶುದ್ಧ ಆಲಯವನ್ನು ಕಟ್ಟಬೇಕೆಂದು ನಿನ್ನನ್ನು ಆರಿಸಿಕೊಂಡಿದ್ದಾರೆ. ನೀನು ಧೈರ್ಯದಿಂದ ಕೆಲಸಕ್ಕೆ ಕೈ ಹಚ್ಚು,” ಎಂದನು.<verse eid="1CH 28:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="1CH 28:11"/>ಆಗ ದಾವೀದನು ತನ್ನ ಮಗ ಸೊಲೊಮೋನನಿಗೆ, “ದ್ವಾರಾಂಗಳದ ಮಾದರಿಯನ್ನೂ, ಅದರ ಮನೆಗಳು, ಅದರ ಉಗ್ರಾಣಗಳು, ಅದರ ಮೇಲಿನ ಕೊಠಡಿಗಳು, ಅದರ ಅಂತರಂಗದ ಕೊಠಡಿಗಳು, ಕರುಣಾಸನದ ಸ್ಥಾನವು, <verse eid="1CH 28:11"/><verse number="12" style="v" sid="1CH 28:12"/>ಯೆಹೋವ ದೇವರ ಮನೆಯ ಅಂಗಳಗಳು, ಸುತ್ತಲಿರುವ ಕೊಠಡಿಗಳಾದ ಯೆಹೋವ ದೇವರ ಮನೆಯ ಉಗ್ರಾಣಗಳು, ಪ್ರತಿಷ್ಠೆ ಮಾಡಿದವುಗಳ ಉಗ್ರಾಣಗಳು, ಆತ್ಮದಿಂದ ತನಗುಂಟಾದ ಇವುಗಳ ಸಮಸ್ತ ಮಾದರಿಯನ್ನೂ ಕೊಟ್ಟನು. <verse eid="1CH 28:12"/><verse number="13" style="v" sid="1CH 28:13"/>ಇದಲ್ಲದೆ ಯಾಜಕರ, ಲೇವಿಯರ ವರ್ಗಗಳಿಗೋಸ್ಕರವೂ, ಯೆಹೋವ ದೇವರ ಮನೆಯ ಸೇವೆಯ ಸಮಸ್ತ ಕೆಲಸಕ್ಕೋಸ್ಕರವೂ ಯೆಹೋವ ದೇವರ ಮನೆಯಲ್ಲಿರುವ ಸೇವೆ ಮಾಡುವ ಸಮಸ್ತ ಪಾತ್ರೆಗಳಿಗೋಸ್ಕರವೂ ಸೂಚನೆಗಳನ್ನು ಕೊಟ್ಟನು. <verse eid="1CH 28:13"/><verse number="14" style="v" sid="1CH 28:14"/>ಸಕಲ ವಿಧವಾದ ಸೇವೆಗೆ ಸಮಸ್ತ ಬಂಗಾರದ ಸಲಕರಣೆಗಳಿಗೋಸ್ಕರ ಬಂಗಾರವನ್ನೂ, ಸಕಲ ವಿಧವಾದ ಸೇವೆಗೆ ಸಮಸ್ತ ಬೆಳ್ಳಿಯ ಸಾಮಾನುಗಳಿಗೋಸ್ಕರ ಬೆಳ್ಳಿಯನ್ನೂ ತೂಗಿಕೊಟ್ಟನು. <verse eid="1CH 28:14"/><verse number="15" style="v" sid="1CH 28:15"/>ಹೇಗೆಂದರೆ, ಬಂಗಾರದ ದೀಪಸ್ತಂಭಗಳಿಗೋಸ್ಕರವೂ, ಅದರ ಬಂಗಾರದ ದೀಪಗಳಿಗೋಸ್ಕರವೂ ಒಂದೊಂದು ಸ್ತಂಭಕ್ಕೋಸ್ಕರ ತೂಕವಾಗಿ ತೂಗಿಕೊಟ್ಟನು. ಬೆಳ್ಳಿಯ ದೀಪಸ್ತಂಭಗಳಿಗೋಸ್ಕರ ದೀಪಸ್ತಂಭಕ್ಕೂ, ಅದರ ದೀಪಗಳಿಗೂ ಒಂದೊಂದು ದೀಪಸ್ತಂಭದ ಕೆಲಸದ ಪ್ರಕಾರ ಅಳತೆಮಾಡಿ ತೂಗಿಕೊಟ್ಟನು. <verse eid="1CH 28:15"/><verse number="16" style="v" sid="1CH 28:16"/>ಆ ಪ್ರಕಾರವೇ ಸಮ್ಮುಖದ ರೊಟ್ಟಿಗಳ ಮೇಜುಗಳಿಗೋಸ್ಕರ ಒಂದೊಂದು ಮೇಜಿಗೆ ತೂಗಿಕೊಟ್ಟನು. ಬೆಳ್ಳಿಯ ಮೇಜುಗಳಿಗೋಸ್ಕರ ಬೆಳ್ಳಿಯನ್ನು ತೂಗಿಕೊಟ್ಟನು. <verse eid="1CH 28:16"/><verse number="17" style="v" sid="1CH 28:17"/>ಅದೇ ಪ್ರಕಾರ ಮುಳ್ಳುಗಳೂ, ಪಾತ್ರೆಗಳೂ, ಹೂಜೆಗಳೂ ಇವುಗಳಿಗೋಸ್ಕರ ಚೊಕ್ಕ ಬಂಗಾರವನ್ನು ಕೊಟ್ಟನು. ಬಂಗಾರದ ಬಟ್ಟಲುಗಳಿಗೋಸ್ಕರ, ಒಂದೊಂದು ಬಟ್ಟಲಿಗೋಸ್ಕರ ಅದರ ತೂಕವಾಗಿಯೂ; ಬೆಳ್ಳಿಯ ಒಂದೊಂದು ಬಟ್ಟಲಿಗೋಸ್ಕರ ಅದರ ತೂಕವಾಗಿಯೂ ಕೊಟ್ಟನು. <verse eid="1CH 28:17"/><verse number="18" style="v" sid="1CH 28:18"/>ಇದಲ್ಲದೆ ಧೂಪಪೀಠಕ್ಕೋಸ್ಕರ ಬಂಗಾರವನ್ನೂ, ರೆಕ್ಕೆಗಳನ್ನೂ ಚಾಚಿಕೊಂಡು ಯೆಹೋವ ದೇವರ ಒಡಂಬಡಿಕೆಯ ಮಂಜೂಷವನ್ನು ಮುಚ್ಚುವ ಕೆರೂಬಿಗಳ ರಥದ ಮಾದರಿಗೋಸ್ಕರ ಬಂಗಾರವನ್ನೂ ತೂಗಿಕೊಟ್ಟನು.<verse eid="1CH 28:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="1CH 28:19"/>“ಯೆಹೋವ ದೇವರು ತಮ್ಮ ಕೈಯನ್ನು ನನ್ನ ಮೇಲೆ ಇರಿಸಿ, ಈ ಯೋಜನೆಯ ಕೆಲಸಗಳನ್ನೆಲ್ಲಾ ನನಗೆ ತಿಳಿಯುವಂತೆ ಮಾಡಿದರು,” ಎಂದರು.<verse eid="1CH 28:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="1CH 28:20"/>ದಾವೀದನು ತನ್ನ ಮಗ ಸೊಲೊಮೋನನಿಗೆ, “ನೀನು ಬಲಗೊಂಡು, ಧೈರ್ಯದಿಂದ ಮಾಡು; ಭಯಪಡಬೇಡ, ನಿರಾಶನಾಗಬೇಡ. ಏಕೆಂದರೆ ನನ್ನ ದೇವರಾಗಿರುವ ಯೆಹೋವ ದೇವರು ನಿನ್ನ ಸಂಗಡ ಇರುತ್ತಾರೆ. ಯೆಹೋವ ದೇವರ ಆಲಯದ ಸೇವೆಯ ಕಾರ್ಯವನ್ನೆಲ್ಲಾ ನೀನು ತೀರಿಸುವವರೆಗೂ, ಅವರು ನಿನ್ನನ್ನು ತೊರೆಯುವುದಿಲ್ಲ, ಕೈಬಿಡುವುದಿಲ್ಲ. <verse eid="1CH 28:20"/><verse number="21" style="v" sid="1CH 28:21"/>ಇಗೋ, ಯೆಹೋವ ದೇವರ ಆಲಯದ ಸಮಸ್ತ ಸೇವೆಗೋಸ್ಕರ ಯಾಜಕರ ಲೇವಿಯರ ವರ್ಗಗಳುಂಟು. ಎಲ್ಲಾ ಕೆಲಸಕ್ಕೂ, ಎಲ್ಲಾ ವಿಧವಾದ ಸೇವೆಗೂ, ಸಿದ್ಧ ಮನಸ್ಸುಳ್ಳಂಥ ಜಾಣತನದಿಂದ ಕೆಲಸ ಮಾಡುವವರು ನಿನ್ನ ಸಂಗಡ ಇದ್ದಾರೆ. ಇದಲ್ಲದೆ ಪ್ರಧಾನರೂ, ಸಕಲ ಜನರೂ ನಿನ್ನ ಮಾತುಗಳಿಗೆಲ್ಲಾ ವಿಧೇಯರಾಗಿರುವರು.”<verse eid="1CH 28:21"/></para>
  <chapter eid="1CH 28"/>
  <chapter number="29" style="c" sid="1CH 29"/>
  <para style="s1">ದೇವಾಲಯದ ಕಟ್ಟಡಕ್ಕಾಗಿ ಕೊಟ್ಟ ಕಾಣಿಕೆ</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 29:1"/>ಇದಲ್ಲದೆ ಅರಸನಾದ ದಾವೀದನು ಸಮಸ್ತ ಸಭೆಗೆ ಹೇಳಿದ್ದೇನೆಂದರೆ, “ದೇವರು ಒಬ್ಬನನ್ನೇ ಆಯ್ದುಕೊಂಡ ನನ್ನ ಮಗ ಸೊಲೊಮೋನನು ಚಿಕ್ಕವನೂ ಎಳೆಯ ಪ್ರಾಯದವನೂ ಆಗಿದ್ದಾನೆ. ಆದರೆ ಕೆಲಸವು ದೊಡ್ಡದು. ಈ ಮಹಾ ಕಟ್ಟಡವು ಮನುಷ್ಯರಿಗೋಸ್ಕರವಲ್ಲ, ದೇವರಾದ ಯೆಹೋವ ದೇವರಿಗೋಸ್ಕರವೇ, <verse eid="1CH 29:1"/><verse number="2" style="v" sid="1CH 29:2"/>ಆದರೆ ನಾನು ನನ್ನ ಸಮಸ್ತ ಶಕ್ತಿಯಿಂದ ನನ್ನ ದೇವರ ಮನೆಯ ನಿಮಿತ್ತ, ಬಂಗಾರದ ಕೆಲಸಕ್ಕೋಸ್ಕರ ಬಂಗಾರವನ್ನೂ, ಬೆಳ್ಳಿಯ ಕೆಲಸಕ್ಕೋಸ್ಕರ ಬೆಳ್ಳಿಯನ್ನೂ, ಕಂಚಿನ ಕೆಲಸಕ್ಕೋಸ್ಕರ ಕಂಚನ್ನೂ, ಕಬ್ಬಿಣದ ಕೆಲಸಕ್ಕೋಸ್ಕರ ಕಬ್ಬಿಣವನ್ನೂ, ಮರದ ಕೆಲಸಕ್ಕೋಸ್ಕರ ಮರವನ್ನೂ, ಗೋಮೇಧಿಕ ರತ್ನಗಳನ್ನೂ; ಕೆತ್ತುವುದಕ್ಕೆ ರತ್ನ ವಿಚಿತ್ರವಾದಂಥ ಕಲ್ಲುಗಳನ್ನೂ; ಸಕಲ ಅಮೂಲ್ಯವಾದ ಕಲ್ಲುಗಳನ್ನೂ. ಅಮೃತ ಶಿಲೆಗಳನ್ನೂ ಬಹಳಷ್ಟು ಸಿದ್ಧಮಾಡಿದ್ದೇನೆ. <verse eid="1CH 29:2"/><verse number="3" style="v" sid="1CH 29:3"/>ಇದಲ್ಲದೆ ನಾನು ನನ್ನ ದೇವರ ಮನೆಯ ಮೇಲೆ ನನಗೆ ಭಕ್ತಿ ಇರುವುದರಿಂದ, ನಾನು ಪರಿಶುದ್ಧ ಮನೆಗೋಸ್ಕರ ಸಿದ್ಧಮಾಡಿದ ಎಲ್ಲಾದರ ಹೊರತು, ನನ್ನ ಸ್ವಂತ ಸ್ವತ್ತಿನಿಂದ ಬಂಗಾರವನ್ನೂ, ಬೆಳ್ಳಿಯನ್ನೂ ನನ್ನ ಪವಿತ್ರ ದೇವರ ಮನೆಗೆ ಕೊಟ್ಟಿದ್ದೇನೆ. <verse eid="1CH 29:3"/><verse number="4" style="v" sid="1CH 29:4"/>ಮನೆಗಳ ಗೋಡೆಗಳನ್ನು ಹೊದಿಸುವುದಕ್ಕೆ ಓಫೀರ್ ಬಂಗಾರದಲ್ಲಿ 100 ಮೆಟ್ರಿಕ್ ಟನ್ ಬಂಗಾರವನ್ನೂ, 240 ಮೆಟ್ರಿಕ್ ಟನ್ ಚೊಕ್ಕ ಬೆಳ್ಳಿಯನ್ನೂ ಕೊಟ್ಟಿದ್ದೇನೆ. <verse eid="1CH 29:4"/><verse number="5" style="v" sid="1CH 29:5"/>ಅಕ್ಕಸಾಲಿಗರು ಮಾಡಬಹುದಾದ ಎಲ್ಲಾ ತರದ ಬೆಳ್ಳಿಬಂಗಾರದ ಸಾಮಾನುಗಳನ್ನು ಮಾಡಿಸಬೇಕು. ಈ ದಿನ ತನ್ನನ್ನೇ ಯೆಹೋವ ದೇವರಿಗೆ ಇಷ್ಟಪೂರ್ವಕವಾಗಿ ಸಮರ್ಪಿಸಿಕೊಳ್ಳುವವರು ಯಾರು?” ಎಂದನು.<verse eid="1CH 29:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="1CH 29:6"/>ಆಗ ಪಿತೃಗಳ ಪ್ರಧಾನರೂ, ಇಸ್ರಾಯೇಲ್ ಗೋತ್ರಗಳ ಪ್ರಧಾನರೂ, ಸಹಸ್ರಾಧಿಪತಿಗಳೂ ಶತಾಧಿಪತಿಗಳೂ, ಅರಸನ ಕೆಲಸದ ಯಜಮಾನರೂ ಇಷ್ಟಪೂರ್ವಕವಾಗಿ ಕಾಣಿಕೆಗಳನ್ನು ತಂದು, <verse eid="1CH 29:6"/><verse number="7" style="v" sid="1CH 29:7"/>ಯೆಹೋವ ದೇವರ ಮನೆಯ ಸೇವೆಗೋಸ್ಕರ ಬಂಗಾರವನ್ನೂ 17 0 ಮೆಟ್ರಿಕ್ ಟನ್, ಮತ್ತು 10,000 ಬಂಗಾರದ ನಾಣ್ಯಗಳನ್ನೂ 34 5 ಮೆಟ್ರಿಕ್ ಟನ್ ಬೆಳ್ಳಿಯನ್ನೂ, 61 0 ಮೆಟ್ರಿಕ್ ಟನ್ ಕಂಚನ್ನೂ, 34 50 ಮೆಟ್ರಿಕ್ ಟನ್ ಕಬ್ಬಿಣವನ್ನೂ ಕೊಟ್ಟರು. <verse eid="1CH 29:7"/><verse number="8" style="v" sid="1CH 29:8"/>ಇದಲ್ಲದೆ ಯಾರ ಬಳಿಯಲ್ಲಿ ಅಮೂಲ್ಯ ರತ್ನಗಳು ಇದ್ದವೋ, ಅವರು ಗೇರ್ಷೋನ್ಯನಾದ ಯೆಹೀಯೇಲನ ಕೈಯಿಂದ ಅವುಗಳನ್ನು ಯೆಹೋವ ದೇವರ ಆಲಯದ ಬೊಕ್ಕಸಕ್ಕೆ ಕೊಟ್ಟರು. <verse eid="1CH 29:8"/><verse number="9" style="v" sid="1CH 29:9"/>ಆಗ ಜನರು ಸಂತೋಷವಾಗಿ ಕಾಣಿಕೆಗಳನ್ನು ಅರ್ಪಿಸಿದ್ದರಿಂದ, ಜನರು ಸಂತೋಷಪಟ್ಟರು. ಏಕೆಂದರೆ ಅವರು ಪೂರ್ಣಮನಸ್ಸಿನಿಂದ ಮನಃಪೂರ್ವಕವಾಗಿ ಯೆಹೋವ ದೇವರಿಗೆ ಅರ್ಪಿಸಿದರು. ಅರಸನಾದ ದಾವೀದನು ಮಹಾ ಸಂತೋಷಪಟ್ಟನು.<verse eid="1CH 29:9"/></para>
  <para style="s1">ದಾವೀದನ ಪ್ರಾರ್ಥನೆ</para>
  <para style="p">
    <verse number="10" style="v" sid="1CH 29:10"/>ದಾವೀದನು ಸಮಸ್ತ ಕೂಟದ ಮುಂದೆ ಯೆಹೋವ ದೇವರನ್ನು ಕೊಂಡಾಡಿ ಹೇಳಿದ್ದೇನೆಂದರೆ,</para>
  <para style="q1" vid="1CH 29:10">“ನಮ್ಮ ತಂದೆಯಾದ ಇಸ್ರಾಯೇಲಿನ</para>
  <para style="q2" vid="1CH 29:10">ದೇವರಾದ ಯೆಹೋವ ದೇವರೇ,</para>
  <para style="q2" vid="1CH 29:10">ನೀವು ಯುಗಯುಗಾಂತರಗಳಿಂದ ಯುಗಯುಗಾಂತರಗಳಿಗೂ ಸ್ತುತಿಗೆ ಪಾತ್ರರಾಗಿದ್ದೀರಿ.<verse eid="1CH 29:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="1CH 29:11"/>ಯೆಹೋವ ದೇವರೇ, ಮಹತ್ವವೂ, ಪರಾಕ್ರಮವೂ,</para>
  <para style="q2" vid="1CH 29:11">ಮಹಿಮೆಯೂ, ಜಯವೂ, ವೈಭವವೂ ನಿಮ್ಮವೇ.</para>
  <para style="q2" vid="1CH 29:11">ಆಕಾಶಗಳಲ್ಲಿಯೂ, ಭೂಮಿಯಲ್ಲಿಯೂ ಇರುವುದೆಲ್ಲಾ ನಿಮ್ಮದೇ.</para>
  <para style="q1" vid="1CH 29:11">ಯೆಹೋವ ದೇವರೇ, ರಾಜ್ಯವು ನಿಮ್ಮದು.</para>
  <para style="q2" vid="1CH 29:11">ನೀವು ಸಮಸ್ತಕ್ಕೂ ತಲೆಯಾಗಿ ಉನ್ನತರು.<verse eid="1CH 29:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="1CH 29:12"/>ಐಶ್ವರ್ಯವೂ, ಘನವೂ ನಿಮ್ಮ ಬಳಿಯಿಂದ ಬರುತ್ತವೆ.</para>
  <para style="q2" vid="1CH 29:12">ನೀವು ಸಮಸ್ತವನ್ನು ಆಳಿಕೆಮಾಡುವವರು.</para>
  <para style="q1" vid="1CH 29:12">ಶಕ್ತಿಯೂ, ಪರಾಕ್ರಮವೂ ನಿಮ್ಮ ಕೈಯಲ್ಲಿ ಇವೆ.</para>
  <para style="q2" vid="1CH 29:12">ಎಲ್ಲರಿಗೂ ಉನ್ನತಿಯನ್ನೂ, ಬಲವನ್ನೂ ಕೊಡುವುದು ನಿಮ್ಮ ಕೈಯಲ್ಲಿ ಇದೆ.<verse eid="1CH 29:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="1CH 29:13"/>ಆದ್ದರಿಂದ ನಮ್ಮ ದೇವರೇ, ನಾವು ನಿಮ್ಮನ್ನು ಸ್ತುತಿಸಿ,</para>
  <para style="q2" vid="1CH 29:13">ನಿಮ್ಮ ಮಹಿಮೆಯುಳ್ಳ ನಾಮವನ್ನು ಕೊಂಡಾಡುತ್ತೇವೆ.<verse eid="1CH 29:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="1CH 29:14"/>“ಆದರೆ ನಾವು ಈ ಪ್ರಕಾರ ಇಷ್ಟಪೂರ್ತಿಯಾಗಿ ಅರ್ಪಿಸುವುದಕ್ಕೆ ಶಕ್ತಿಯನ್ನು ಹೊಂದಲು ನಾನೆಷ್ಟರವನು? ನನ್ನ ಜನರು ಎಷ್ಟರವರು? ಏಕೆಂದರೆ ಸಮಸ್ತವೂ ನಿಮ್ಮಿಂದಲೇ. <verse eid="1CH 29:14"/><verse number="15" style="v" sid="1CH 29:15"/>ನಿಮ್ಮ ಕೈಯಿಂದಲೇ ನಿಮಗೆ ಅರ್ಪಿಸಿದೆವು. ಏಕೆಂದರೆ ನಾವು ನಿಮ್ಮ ಸಮ್ಮುಖದಲ್ಲಿ ನಮ್ಮ ಸಮಸ್ತ ಪಿತೃಗಳ ಹಾಗೆ ಪರದೇಶಸ್ಥರೂ, ಪ್ರವಾಸಿಗಳೂ ಆಗಿದ್ದೇವೆ. ಭೂಮಿಯ ಮೇಲೆ ನಮ್ಮ ದಿವಸಗಳು ನೆರಳಿನ ಹಾಗೆ ಇವೆ; ನಿರೀಕ್ಷೆಯು ಇಲ್ಲ. <verse eid="1CH 29:15"/><verse number="16" style="v" sid="1CH 29:16"/>ನಮ್ಮ ದೇವರಾದ ಯೆಹೋವ ದೇವರೇ, ನಿಮ್ಮ ಪರಿಶುದ್ಧ ನಾಮಕ್ಕೋಸ್ಕರ ನಿಮಗೆ ಆಲಯವನ್ನು ಕಟ್ಟಿಸಲು ನಾವು ಸಿದ್ಧಮಾಡಿದ ಈ ರಾಶಿಯೆಲ್ಲಾ ನಿಮ್ಮಿಂದ ಬಂದದ್ದು. ಸಮಸ್ತವೂ ನಿಮ್ಮದು. <verse eid="1CH 29:16"/><verse number="17" style="v" sid="1CH 29:17"/>ನನ್ನ ದೇವರೇ, ನೀವು ಹೃದಯವನ್ನು ಪರಿಶೋಧಿಸಿ ಯಥಾರ್ಥತೆಯಲ್ಲಿ ಸಂತೋಷವಾಗಿದ್ದೀರಿ, ಎಂದು ನಾನು ಬಲ್ಲೆನು. ನಾನು ಯಥಾರ್ಥವಾದ ಹೃದಯದಿಂದ ಇವುಗಳನ್ನೆಲ್ಲಾ ಇಷ್ಟಪೂರ್ವಕವಾಗಿ ಅರ್ಪಿಸಿದ್ದೇನೆ. ಇದಲ್ಲದೆ ಇಲ್ಲಿರುವ ನಿಮ್ಮ ಜನರು ನಿಮಗೆ ಇಷ್ಟಪೂರ್ವಕವಾಗಿ ಅರ್ಪಿಸುವುದನ್ನು ಈಗ ಕಂಡು ಸಂತೋಷಿಸಿದೆನು. <verse eid="1CH 29:17"/><verse number="18" style="v" sid="1CH 29:18"/>ನಮ್ಮ ಪಿತೃಗಳಾದ ಅಬ್ರಹಾಮನ, ಇಸಾಕನ, ಇಸ್ರಾಯೇಲನ ದೇವರಾದ ಯೆಹೋವ ದೇವರೇ, ನಿಮ್ಮ ಜನರ ಹೃದಯದ ಮನೋಭಾವನೆಯಲ್ಲಿ ಭಕ್ತಿಯನ್ನು ನಿರಂತರವಾಗಿ ಕಾಪಾಡಿ, ಅವರ ಹೃದಯವನ್ನು ನಿಮಗೆ ಸಿದ್ಧಮಾಡಿ. <verse eid="1CH 29:18"/><verse number="19" style="v" sid="1CH 29:19"/>ಇದಲ್ಲದೆ ನಿಮ್ಮ ಆಜ್ಞೆಗಳನ್ನೂ, ನಿಮ್ಮ ಸಾಕ್ಷಿಗಳನ್ನೂ, ನಿಮ್ಮ ಕಟ್ಟಳೆಗಳನ್ನೂ ಕೈಗೊಳ್ಳಲೂ, ಸಮಸ್ತವನ್ನು ಮಾಡಲೂ ನಾನು ಯಾವುದಕ್ಕೋಸ್ಕರ ಸಿದ್ಧ ಮಾಡಿದೆನೋ, ಆ ಮಹಾ ಕಟ್ಟಡವನ್ನು ಕಟ್ಟಿಸಲೂ, ನನ್ನ ಮಗನಾದ ಸೊಲೊಮೋನನಿಗೆ ಪೂರ್ಣ ಹೃದಯವನ್ನು ಕೊಡಿರಿ,” ಎಂದನು.<verse eid="1CH 29:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="1CH 29:20"/>ತರುವಾಯ ದಾವೀದನು ಸಮಸ್ತ ಸಭೆಗೆ, “ಈಗ ನಿಮ್ಮ ದೇವರಾದ ಯೆಹೋವ ದೇವರನ್ನು ಸ್ತುತಿಸಿರಿ,” ಎಂದನು. ಆಗ ಜನರೆಲ್ಲರು ತಮ್ಮ ಪಿತೃಗಳ ದೇವರಾದ ಯೆಹೋವ ದೇವರನ್ನು ಸ್ತುತಿಸುತ್ತಾ, ತಮ್ಮ ತಲೆಗಳನ್ನು ಬಾಗಿಸಿ ಯೆಹೋವ ದೇವರನ್ನೂ, ಅರಸನನ್ನೂ ವಂದಿಸಿದರು.<verse eid="1CH 29:20"/></para>
  <para style="s1">ಸೊಲೊಮೋನನನ್ನು ಅರಸನನ್ನಾಗಿ ಸ್ವೀಕರಿಸಿದ್ದು</para>
  <para style="p">
    <verse number="21" style="v" sid="1CH 29:21"/>ಮಾರನೆಯ ದಿವಸದಲ್ಲಿ ಅವರು ಯೆಹೋವ ದೇವರಿಗೆ ಬಲಿಗಳನ್ನು ವಧಿಸಿ, ಯೆಹೋವ ದೇವರಿಗೆ ದಹನಬಲಿಗಳನ್ನು ಅರ್ಪಿಸಿದರು. ಸಾವಿರ ಹೋರಿಗಳನ್ನೂ, ಸಾವಿರ ಟಗರುಗಳನ್ನೂ, ಸಾವಿರ ಕುರಿಮರಿಗಳನ್ನೂ, ಅವುಗಳ ಪಾನದ ಅರ್ಪಣೆಗಳನ್ನೂ, ಸಮಸ್ತ ಇಸ್ರಾಯೇಲರಿಗೋಸ್ಕರ ಬಹಳವಾಗಿ ಬಲಿಗಳನ್ನು ಅರ್ಪಿಸಿದರು. <verse eid="1CH 29:21"/><verse number="22" style="v" sid="1CH 29:22"/>ಆ ದಿವಸದಲ್ಲಿ ಮಹಾ ಸಂತೋಷದಿಂದ ಯೆಹೋವ ದೇವರ ಮುಂದೆ ತಿಂದು ಕುಡಿದರು. ಎರಡನೆಯ ಸಾರಿ ದಾವೀದನ ಮಗ ಸೊಲೊಮೋನನನ್ನು ಅರಸನನ್ನಾಗಿ ಸ್ವೀಕರಿಸಿದರು.</para>
  <para style="p" vid="1CH 29:22">ಯೆಹೋವ ದೇವರ ಮುಂದೆ ಅವನನ್ನು ನಾಯಕನಾಗಿಯೂ ಚಾದೋಕನನ್ನು ಯಾಜಕನಾಗಿಯೂ ಅಭಿಷೇಕಿಸಿದರು. <verse eid="1CH 29:22"/><verse number="23" style="v" sid="1CH 29:23"/>ಆಗ ಸೊಲೊಮೋನನು ತನ್ನ ತಂದೆಯಾದ ದಾವೀದನಿಗೆ ಬದಲಾಗಿ ಅರಸನಾಗಿ, ಯೆಹೋವ ದೇವರ ಸಿಂಹಾಸನದ ಮೇಲೆ ಕುಳಿತುಕೊಂಡು, ಸಮೃದ್ಧಿ ಹೊಂದಿದನು. ಸಮಸ್ತ ಇಸ್ರಾಯೇಲರು ಅವನಿಗೆ ವಿಧೇಯರಾದರು. <verse eid="1CH 29:23"/><verse number="24" style="v" sid="1CH 29:24"/>ಎಲ್ಲಾ ಪ್ರಧಾನರೂ, ಪರಾಕ್ರಮಶಾಲಿಗಳೂ, ಅರಸನಾದ ದಾವೀದನ ಸಮಸ್ತ ಪುತ್ರರೂ ಅರಸನಾದ ಸೊಲೊಮೋನನಿಗೆ ಅಧೀನರಾದರು.<verse eid="1CH 29:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="1CH 29:25"/>ಇದಲ್ಲದೆ ಯೆಹೋವ ದೇವರು ಸಮಸ್ತ ಇಸ್ರಾಯೇಲಿನ ಸಮ್ಮುಖದಲ್ಲಿ ಸೊಲೊಮೋನನನ್ನು ಅಧಿಕವಾಗಿ ಹೆಚ್ಚಿಸಿ, ಇಸ್ರಾಯೇಲಿನಲ್ಲಿ ಅವನಿಗಿಂತ ಮುಂಚೆ ಇದ್ದ ಯಾವ ಅರಸನಿಗಾದರೂ ಇಲ್ಲದಂಥ ರಾಜ್ಯದ ವೈಭವವನ್ನು ಅವನಿಗೆ ಕೊಟ್ಟರು.<verse eid="1CH 29:25"/></para>
  <para style="s1">ದಾವೀದನ ಮರಣವು</para>
  <para style="p">
    <verse number="26" style="v" sid="1CH 29:26"/>ಇಷಯನ ಮಗ ದಾವೀದನು ಸಮಸ್ತ ಇಸ್ರಾಯೇಲಿನ ಮೇಲೆ ಆಳಿದನು. <verse eid="1CH 29:26"/><verse number="27" style="v" sid="1CH 29:27"/>ಅವನು ಇಸ್ರಾಯೇಲಿನ ಮೇಲೆ ಆಳಿದ ದಿವಸಗಳು ನಾಲ್ವತ್ತು ವರ್ಷಗಳು. ಏಳು ವರ್ಷ ಹೆಬ್ರೋನಿನಲ್ಲಿ ಆಳಿದನು. ಮೂವತ್ತಮೂರು ವರ್ಷ ಯೆರೂಸಲೇಮಿನಲ್ಲಿ ಆಳಿದನು. <verse eid="1CH 29:27"/><verse number="28" style="v" sid="1CH 29:28"/>ಅವನು ದೀರ್ಘಾಯುಷ್ಯದಿಂದಲೂ, ಐಶ್ವರ್ಯದಿಂದಲೂ, ಘನದಿಂದಲೂ ಕೂಡಿದವನಾಗಿ, ಒಳ್ಳೆಯ ಪ್ರಾಯದಲ್ಲಿ ಮರಣಹೊಂದಿದನು. ಅವನ ಮಗ ಸೊಲೊಮೋನನು ಅವನಿಗೆ ಬದಲಾಗಿ ಅರಸನಾದನು.<verse eid="1CH 29:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="1CH 29:29"/>ಅರಸನಾದ ದಾವೀದನ ಕ್ರಿಯೆಗಳು ಮೊದಲಿನಿಂದ ಕೊನೆಯವರೆಗೆ ಅವನ ಸಮಸ್ತ ಆಳಿಕೆಯೂ, ಅವನ ಪರಾಕ್ರಮವೂ, ಅವನ ಮೇಲೆಯೂ, ಇಸ್ರಾಯೇಲಿನ ಮೇಲೆಯೂ, ಬೇರೆ ದೇಶಗಳ ಸಮಸ್ತ ರಾಜ್ಯಗಳ ಮೇಲೆಯೂ ಸಂಭವಿಸಿದ ಘಟನೆಗಳು, <verse eid="1CH 29:29"/><verse number="30" style="v" sid="1CH 29:30"/>ದರ್ಶಿಯಾದ ಸಮುಯೇಲನ ಪುಸ್ತಕದಲ್ಲಿ, ಪ್ರವಾದಿಯಾದ ನಾತಾನನ ಪುಸ್ತಕದಲ್ಲಿ ಮತ್ತು ದರ್ಶಿಯಾದ ಗಾದನ ಪುಸ್ತಕದಲ್ಲಿಯೂ ಲಿಖಿತವಾಗಿವೆ.<verse eid="1CH 29:30"/></para>
  <chapter eid="1CH 29"/>
</usx>
