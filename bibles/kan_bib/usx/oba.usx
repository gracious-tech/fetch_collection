<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="OBA" style="id">- Biblica® Open Kannada Contemporary Version</book>
  <para style="h">ಓಬದ್ಯ</para>
  <para style="toc1">ಓಬದ್ಯ</para>
  <para style="toc2">ಓಬದ್ಯ</para>
  <para style="toc3">ಓಬದ್ಯ</para>
  <para style="mt1">ಓಬದ್ಯ</para>
  <chapter number="1" style="c" sid="OBA 1"/>
  <para style="s1">ಓಬದ್ಯನ ದರ್ಶನ</para>
  <para style="p">
    <verse number="1" style="v" sid="OBA 1:1"/>ಓಬದ್ಯನ ದರ್ಶನವು.</para>
  <para style="b" vid="OBA 1:1"/>
  <para style="b" vid="OBA 1:1"/>
  <para style="p" vid="OBA 1:1">ಸಾರ್ವಭೌಮ ಯೆಹೋವ ದೇವರು ಎದೋಮನ್ನು ಕುರಿತು ಹೀಗೆ ಹೇಳುತ್ತಾರೆ:</para>
  <para style="q1" vid="OBA 1:1">ಯೆಹೋವ ದೇವರಿಂದ ಸುದ್ದಿಯನ್ನು ಕೇಳಿದ್ದೇವೆ.</para>
  <para style="q2" vid="OBA 1:1">ಅವರು ದೂತನ ಮೂಲಕ ಜನಾಂಗಗಳಿಗೆ ಹೀಗೆ ಹೇಳಿ ಕಳುಹಿಸಿದ್ದಾರೆ:</para>
  <para style="q1" vid="OBA 1:1">“ಏಳಿರಿ, ಅದಕ್ಕೆ ವಿರೋಧವಾಗಿ ಯುದ್ಧಕ್ಕೆ ಹೋಗೋಣ!”<verse eid="OBA 1:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="OBA 1:2"/>“ಇಗೋ, ನಿನ್ನನ್ನು ಜನಾಂಗಗಳಲ್ಲಿ ಅತ್ಯಲ್ಪನನ್ನಾಗಿ ಮಾಡಿದ್ದೇನೆ.</para>
  <para style="q2" vid="OBA 1:2">ನೀನು ಬಹು ತಾತ್ಸಾರಕ್ಕೆ ಗುರಿಯಾಗುವೆ.<verse eid="OBA 1:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="OBA 1:3"/>ಬಂಡೆಯ ಬಿರುಕುಗಳಲ್ಲಿ ವಾಸಮಾಡುವವನೇ,</para>
  <para style="q2" vid="OBA 1:3">ಉನ್ನತದಲ್ಲಿ ನಿವಾಸಮಾಡಿಕೊಂಡವನೇ,</para>
  <para style="q2" vid="OBA 1:3">‘ಯಾರು ನನ್ನನ್ನು ನೆಲಕ್ಕೆ ಇಳಿಸಬಲ್ಲವರು?’</para>
  <para style="q1" vid="OBA 1:3">ಎಂದು ತನ್ನ ಹೃದಯದಲ್ಲಿ ಅನ್ನುವವನೇ,</para>
  <para style="q2" vid="OBA 1:3">ನಿನ್ನ ಹೃದಯದ ಗರ್ವವು ನಿನ್ನನ್ನು ಮೋಸಗೊಳಿಸಿದೆ.<verse eid="OBA 1:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="OBA 1:4"/>ನೀನು ಹದ್ದಿನಂತೆ ಏರಿಕೊಂಡು</para>
  <para style="q2" vid="OBA 1:4">ನಿನ್ನ ಗೂಡನ್ನು ನಕ್ಷತ್ರಗಳಲ್ಲಿ ಇಟ್ಟರೂ</para>
  <para style="q2" vid="OBA 1:4">ಅಲ್ಲಿಂದ ನಿನ್ನನ್ನು ಇಳಿಸುವೆನು,”</para>
  <para style="q2" vid="OBA 1:4">ಎಂದು ಯೆಹೋವ ದೇವರು ಹೇಳುತ್ತಾರೆ.<verse eid="OBA 1:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="OBA 1:5"/>“ನಿನ್ನಲ್ಲಿ ಕಳ್ಳರಾಗಲಿ,</para>
  <para style="q2" vid="OBA 1:5">ರಾತ್ರಿಯಲ್ಲಿ ಪಂಜುಗಳ್ಳರಾಗಲಿ ಬಂದರೆ</para>
  <para style="q1" vid="OBA 1:5">ಅವರು ತಮಗೆ ಬೇಕಾದಷ್ಟನ್ನು ಮಾತ್ರ ದೋಚಿಕೊಂಡು ಹೋಗುತ್ತಿದ್ದರಲ್ಲವೆ?</para>
  <para style="q1" vid="OBA 1:5">ದ್ರಾಕ್ಷಿ ಕೀಳುವವರು ನಿಮ್ಮ ಬಳಿಗೆ ಬಂದರೆ</para>
  <para style="q2" vid="OBA 1:5">ಸ್ವಲ್ಪ ದ್ರಾಕ್ಷಿಯನ್ನು ಬಿಡುವುದಿಲ್ಲವೇ?<verse eid="OBA 1:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="OBA 1:6"/>ಆದರೆ ಏಸಾವಿನ ಆಸ್ತಿಯು ಸಂಪೂರ್ಣ ನಾಶವಾಗಿ</para>
  <para style="q2" vid="OBA 1:6">ಅದರ ನಿಗೂಢ ನಿಕ್ಷೇಪಗಳು ಸೂರೆಯಾಗಿವೆ.<verse eid="OBA 1:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="OBA 1:7"/>ನಿನ್ನ ಸಂಗಡ ಒಡಂಬಟ್ಟ ಮನುಷ್ಯರೆಲ್ಲರು ನಿನ್ನನ್ನು ಮೇರೆಯವರೆಗೂ ತಂದಿದ್ದಾರೆ.</para>
  <para style="q2" vid="OBA 1:7">ನಿನ್ನ ಸಂಗಡ ಸಮಾಧಾನವಾಗಿದ್ದ ಮನುಷ್ಯರು</para>
  <para style="q2" vid="OBA 1:7">ನಿನ್ನನ್ನು ಮೋಸಮಾಡಿ ನಿನ್ನ ಮೇಲೆ ಜಯ ಹೊಂದಿದ್ದಾರೆ.</para>
  <para style="q1" vid="OBA 1:7">ನಿನ್ನ ರೊಟ್ಟಿಯನ್ನು ತಿನ್ನುವವರು ನಿನ್ನ ಕೆಳಗೆ ಬೋನು ಇಟ್ಟಿದ್ದಾರೆ.</para>
  <para style="q2" vid="OBA 1:7">ಆದರೆ ನೀನು ಅದನ್ನು ತಿಳಿದುಕೊಳ್ಳಲಾರೆ.<verse eid="OBA 1:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="OBA 1:8"/>“ಯೆಹೋವ ದೇವರು ಹೀಗೆ ಹೇಳುತ್ತಾರೆ,</para>
  <para style="q2" vid="OBA 1:8">‘ಆ ದಿವಸದಲ್ಲಿ,’ ಎದೋಮಿನೊಳಗಿಂದ ಜ್ಞಾನಿಗಳನ್ನೂ</para>
  <para style="q2" vid="OBA 1:8">ಏಸಾವನ ಬೆಟ್ಟದೊಳಗಿಂದ ವಿವೇಕವನ್ನೂ ನಾಶಮಾಡದಿರುವೆನೇ?<verse eid="OBA 1:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="OBA 1:9"/>ಸರ್ವರು ಸಂಹಾರದಿಂದ</para>
  <para style="q2" vid="OBA 1:9">ಏಸಾವನ ಬೆಟ್ಟದೊಳಗಿಂದ ನಾಶವಾಗುವ ಹಾಗೆ ತೇಮಾನೇ,</para>
  <para style="q2" vid="OBA 1:9">ನಿನ್ನ ಪರಾಕ್ರಮಶಾಲಿಗಳು ಗಾಬರಿಪಡುವರು.<verse eid="OBA 1:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="OBA 1:10"/>ನಿನ್ನ ತಮ್ಮನಾದ ಯಾಕೋಬನಿಗೆ ವಿರೋಧವಾದ ನಿನ್ನ ಹಿಂಸಾಕೃತ್ಯಗಳ ನಿಮಿತ್ತ</para>
  <para style="q2" vid="OBA 1:10">ನಾಚಿಕೆಯು ನಿನ್ನನ್ನು ಮುಚ್ಚುವುದು.</para>
  <para style="q2" vid="OBA 1:10">ನೀನು ಎಂದೆಂದಿಗೂ ನಾಶವಾಗಿ ಹೋಗುವೆ.<verse eid="OBA 1:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="OBA 1:11"/>ನೀನು ಪ್ರತ್ಯೇಕವಾಗಿ ಎದುರು ನಿಂತ ದಿವಸದಲ್ಲಿ</para>
  <para style="q2" vid="OBA 1:11">ಪರರು ಅವನ ಸೊತ್ತನ್ನು ತೆಗೆದುಕೊಂಡು ಹೋದ ದಿವಸದಲ್ಲಿ</para>
  <para style="q1" vid="OBA 1:11">ಪರಕೀಯರು ಅವನ ಬಾಗಿಲುಗಳಲ್ಲಿ ಪ್ರವೇಶಿಸಿ,</para>
  <para style="q2" vid="OBA 1:11">ಯೆರೂಸಲೇಮಿನ ಸೊತ್ತಿಗಾಗಿ ಚೀಟು ಹಾಕಿದಾಗ</para>
  <para style="q2" vid="OBA 1:11">ನೀನೂ ಅವರಲ್ಲಿ ಒಬ್ಬನ ಹಾಗಿದ್ದೆ.<verse eid="OBA 1:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="OBA 1:12"/>ನಿನ್ನ ಸಹೋದರನ ವಿಪತ್ತಿನ ದಿನದಲ್ಲಿ</para>
  <para style="q2" vid="OBA 1:12">ನೀನು ಅವನನ್ನು ಕೀಳು ದೃಷ್ಟಿಯಿಂದ ನೋಡಬಾರದಾಗಿತ್ತು.</para>
  <para style="q1" vid="OBA 1:12">ಯೆಹೂದದ ಜನರು ನಾಶವಾದಾಗ</para>
  <para style="q2" vid="OBA 1:12">ನೀನು ಸಂತೋಷಪಡಬಾರದಿತ್ತು.</para>
  <para style="q1" vid="OBA 1:12">ಅವರ ಕಷ್ಟದ ದಿವಸದಲ್ಲಿ</para>
  <para style="q2" vid="OBA 1:12">ಅಹಂಕಾರವಾಗಿ ಮಾತನಾಡಬಾರದಾಗಿತ್ತು;<verse eid="OBA 1:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="OBA 1:13"/>ನನ್ನ ಜನರ ಆಪತ್ತಿನ ದಿವಸದಲ್ಲಿ ಅವರ ದ್ವಾರಗಳ ಮೂಲಕ ಪ್ರವೇಶಿಸಬಾರದಿತ್ತು.</para>
  <para style="q2" vid="OBA 1:13">ಹೌದು, ನೀನು ಅವರ ಆಪತ್ತಿನ ದಿವಸದಲ್ಲಿ</para>
  <para style="q1" vid="OBA 1:13">ಅವರನ್ನು ಕೀಳು ದೃಷ್ಟಿಯಿಂದ ನೋಡಬಾರದಾಗಿತ್ತು.</para>
  <para style="q2" vid="OBA 1:13">ಅವರ ಆಪತ್ತಿನ ದಿವಸದಲ್ಲಿ</para>
  <para style="q2" vid="OBA 1:13">ಅವರ ಆಸ್ತಿಯ ಮೇಲೆ ಕೈ ಹಾಕಬಾರದಾಗಿತ್ತು.<verse eid="OBA 1:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="OBA 1:14"/>ಅವರಲ್ಲಿ ಓಡಿಹೋದವರನ್ನು ಕಡಿದುಬಿಡುವುದಕ್ಕೆ</para>
  <para style="q2" vid="OBA 1:14">ನೀನು ಕೂಡುವ ದಾರಿಯಲ್ಲಿ ನಿಲ್ಲಬಾರದಾಗಿತ್ತು.</para>
  <para style="q1" vid="OBA 1:14">ಕಷ್ಟದ ದಿವಸದಲ್ಲಿ</para>
  <para style="q2" vid="OBA 1:14">ಅವರಲ್ಲಿ ಉಳಿದುಕೊಂಡವರನ್ನು ಹಿಡಿದುಕೊಡಬಾರದಾಗಿತ್ತು.<verse eid="OBA 1:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="OBA 1:15"/>“ಯೆಹೋವ ದೇವರ ದಿವಸವು</para>
  <para style="q2" vid="OBA 1:15">ಎಲ್ಲಾ ಜನಾಂಗಗಳ ಮೇಲೆ ಸಮೀಪವಾಗಿದೆ.</para>
  <para style="q1" vid="OBA 1:15">ನೀನು ಮಾಡಿದ ಹಾಗೆಯೇ ನಿನಗೂ ಮಾಡಲಾಗುವುದು.</para>
  <para style="q2" vid="OBA 1:15">ನಿನ್ನ ಕಾರ್ಯಗಳು ನಿನ್ನ ತಲೆಯ ಮೇಲೆ ತಿರುಗುವುವು.<verse eid="OBA 1:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="OBA 1:16"/>ನೀವು ನನ್ನ ಪರಿಶುದ್ಧ ಪರ್ವತದ ಮೇಲೆ ಕುಡಿದ ಹಾಗೆಯೇ,</para>
  <para style="q2" vid="OBA 1:16">ಜನಾಂಗಗಳೆಲ್ಲಾ ನಿತ್ಯವಾಗಿ ಕುಡಿಯುವುವು.</para>
  <para style="q1" vid="OBA 1:16">ಹೌದು, ಕುಡಿದು ಎಂದೂ ಇಲ್ಲದವರ ಹಾಗೆ ಆಗುವುದು.<verse eid="OBA 1:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="OBA 1:17"/>ಆದರೆ ಚೀಯೋನ್ ಪರ್ವತದಲ್ಲಿ ಬಿಡುಗಡೆ ಇರುವುದು.</para>
  <para style="q2" vid="OBA 1:17">ಅದು ಪರಿಶುದ್ಧವಾಗಿರುವುದು.</para>
  <para style="q2" vid="OBA 1:17">ಯಾಕೋಬನ ಮನೆತನದವರು ತಮ್ಮ ಸೊತ್ತನ್ನು ಮರಳಿ ಅನುಭವಿಸುವರು.<verse eid="OBA 1:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="OBA 1:18"/>ಯಾಕೋಬನ ಮನೆತನದವರು ಬೆಂಕಿಯಾಗಿಯೂ</para>
  <para style="q2" vid="OBA 1:18">ಯೋಸೇಫನ ಮನೆತನದವರು ಜ್ವಾಲೆಯಾಗಿಯೂ ಇರುವರು;</para>
  <para style="q1" vid="OBA 1:18">ಏಸಾವನ ಮನೆತನದವರು ಕೂಳೆಯಂತೆ ಧಗಧಗನೆ ದಹಿಸಿ ನಾಶವಾಗುವರು.</para>
  <para style="q2" vid="OBA 1:18">ಏಸಾವನ ಮನೆತನದವರಲ್ಲಿ ಯಾರೂ ಉಳಿಯರು.”</para>
  <para style="q2" vid="OBA 1:18">ಯೆಹೋವ ದೇವರೇ ಇದನ್ನು ನುಡಿದಿದ್ದಾರೆ.<verse eid="OBA 1:18"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="OBA 1:19"/>ದಕ್ಷಿಣದವರು ಏಸಾವನ ಬೆಟ್ಟವನ್ನೂ ಬಯಲಿನವರು</para>
  <para style="q2" vid="OBA 1:19">ಫಿಲಿಷ್ಟಿಯರ ದೇಶವನ್ನೂ ಸ್ವತಂತ್ರಿಸಿಕೊಳ್ಳುವರು.</para>
  <para style="q1" vid="OBA 1:19">ಎಫ್ರಾಯೀಮಿನ ಹೊಲಗಳನ್ನು ಸಮಾರ್ಯದ ಹೊಲಗಳನ್ನು ಸಹ ಸ್ವಾಧೀನಮಾಡಿಕೊಳ್ಳುವರು</para>
  <para style="q2" vid="OBA 1:19">ಬೆನ್ಯಾಮೀನನು ಗಿಲ್ಯಾದನ್ನು ವಶಪಡಿಸಿಕೊಳ್ಳುವನು.<verse eid="OBA 1:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="OBA 1:20"/>ಚಾರೆಪತಿನವರೆಗೂ ಇರುವ ಪ್ರದೇಶವನ್ನು</para>
  <para style="q2" vid="OBA 1:20">ಕಾನಾನ್ಯರಲ್ಲಿರುವ ಇಸ್ರಾಯೇಲ್ ಸೆರೆವಾಸಿಗಳು ವಶಪಡಿಸಿಕೊಳ್ಳುವರು.</para>
  <para style="q1" vid="OBA 1:20">ಸೆಫಾರದಿನಲ್ಲಿರುವ ಯೆರೂಸಲೇಮಿನ ಸೆರೆಯವರು</para>
  <para style="q2" vid="OBA 1:20">ದಕ್ಷಿಣದ ಪಟ್ಟಣಗಳನ್ನು ಸ್ವಾಧೀನಮಾಡಿಕೊಳ್ಳುವರು.<verse eid="OBA 1:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="OBA 1:21"/>ರಕ್ಷಕನು ಏಸಾವಿನ ಪರ್ವತವನ್ನು</para>
  <para style="q2" vid="OBA 1:21">ಆಳಲು ಚೀಯೋನ್ ಪರ್ವತವನ್ನು ಏರುವನು.</para>
  <para style="q2" vid="OBA 1:21">ಆಗ ರಾಜ್ಯವು ಯೆಹೋವ ದೇವರದಾಗಿರುವುದು.<verse eid="OBA 1:21"/></para>
  <chapter eid="OBA 1"/>
</usx>
