<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="ZEP" style="id">- Biblica® Open Kannada Contemporary Version</book>
  <para style="h">ಚೆಫನ್ಯ</para>
  <para style="toc1">ಚೆಫನ್ಯ</para>
  <para style="toc2">ಚೆಫನ್ಯ</para>
  <para style="toc3">ಚೆಫನ್ಯ</para>
  <para style="mt1">ಚೆಫನ್ಯ</para>
  <chapter number="1" style="c" sid="ZEP 1"/>
  <para style="p">
    <verse number="1" style="v" sid="ZEP 1:1"/>ಯೆಹೂದದ ಅರಸನಾದ ಆಮೋನನ ಮಗನಾದ ಯೋಷೀಯನ ಕಾಲದಲ್ಲಿ ಕೂಷಿಯ ಮಗನೂ ಗೆದಲ್ಯನ ಮೊಮ್ಮಗನೂ ಹಿಜ್ಕೀಯನಿಗೆ ಹುಟ್ಟಿದ ಅಮರ್ಯನ ಮರಿಮಗನೂ ಆದ ಚೆಫನ್ಯನಿಗೆ ಯೆಹೋವ ದೇವರು ದಯಪಾಲಿಸಿದ ವಾಕ್ಯ:<verse eid="ZEP 1:1"/></para>
  <para style="b"/>
  <para style="s1">ಯೆಹೋವ ದೇವರ ದಿನದಂದು ಇಡೀ ಭೂಮಿಯ ಮೇಲೆ ತೀರ್ಪು</para>
  <para style="q1">
    <verse number="2" style="v" sid="ZEP 1:2"/>ಯೆಹೋವ ದೇವರು ಹೇಳುವುದೇನೆಂದರೆ,</para>
  <para style="q2" vid="ZEP 1:2">“ನಾನು ದೇಶದೊಳಗಿಂದ ಎಲ್ಲವುಗಳನ್ನು</para>
  <para style="q2" vid="ZEP 1:2">ಸಂಪೂರ್ಣವಾಗಿ ನಾಶಮಾಡುವೆನು.”<verse eid="ZEP 1:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="ZEP 1:3"/>“ಮನುಷ್ಯರನ್ನೂ ಮೃಗಗಳನ್ನೂ ನಾಶಮಾಡುವೆನು.</para>
  <para style="q2" vid="ZEP 1:3">ಆಕಾಶದ ಪಕ್ಷಿಗಳನ್ನೂ</para>
  <para style="q2" vid="ZEP 1:3">ಸಮುದ್ರದ ಮೀನುಗಳನ್ನೂ ನಾಶಮಾಡುವೆನು.”</para>
  <para style="b" vid="ZEP 1:3"/>
  <para style="q1" vid="ZEP 1:3">“ಮನುಷ್ಯರನ್ನು ದೇಶದೊಳಗಿಂದ ಕಡಿದು ಬಿಡುವಾಗ</para>
  <para style="q2" vid="ZEP 1:3">ದುಷ್ಟರಿಗೆ ಉಳಿಯುವುದು ಕಸದರಾಶಿಯೇ,”</para>
  <para style="q2" vid="ZEP 1:3">ಎಂದು ಯೆಹೋವ ದೇವರು ಹೇಳುತ್ತಾರೆ.<verse eid="ZEP 1:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="ZEP 1:4"/>“ಯೆಹೂದದ ಮೇಲೆಯೂ ಯೆರೂಸಲೇಮಿನ</para>
  <para style="q2" vid="ZEP 1:4">ಎಲ್ಲಾ ನಿವಾಸಿಗಳ ಮೇಲೆಯೂ ನನ್ನ ಕೈಚಾಚುವೆನು.</para>
  <para style="q1" vid="ZEP 1:4">ಈ ಸ್ಥಳದಲ್ಲಿ ಬಾಳನ ಪೂಜೆಗಳನ್ನು</para>
  <para style="q2" vid="ZEP 1:4">ಮತ್ತು ಉಳಿದಿರುವ ವಿಗ್ರಹಾರಾಧಕ ಯಾಜಕರ</para>
  <para style="q2" vid="ZEP 1:4">ಹೆಸರುಗಳನ್ನು ತೆಗೆದುಬಿಡುವೆನು.<verse eid="ZEP 1:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="ZEP 1:5"/>ಮಾಳಿಗೆಗಳ ಮೇಲೆ ತಲೆಬಾಗಿಸಿ</para>
  <para style="q2" vid="ZEP 1:5">ಆಕಾಶದ ನಕ್ಷತ್ರಗಣಕ್ಕೆ</para>
  <para style="q1" vid="ZEP 1:5">ಆರಾಧಿಸುವವರನ್ನೂ ಯೆಹೋವ ದೇವರ ಮೇಲೆಯೂ</para>
  <para style="q2" vid="ZEP 1:5">ಮಲ್ಕಾಮನ ಮೇಲೆಯೂ ಆಣೆ ಇಟ್ಟುಕೊಳ್ಳುವವರನ್ನೂ<verse eid="ZEP 1:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="ZEP 1:6"/>ಯೆಹೋವ ದೇವರನ್ನು ಅನುಸರಿಸದೆ ಹಿಂತಿರುಗಿ ಹೋಗುವವರನ್ನು</para>
  <para style="q2" vid="ZEP 1:6">ಯೆಹೋವ ದೇವರನ್ನು ಹುಡುಕದೆಯೂ ವಿಚಾರಿಸದೆಯೂ ಇರುವವರನ್ನೂ ಕಡಿದುಬಿಡುವೆನು.”<verse eid="ZEP 1:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="ZEP 1:7"/>ಸಾರ್ವಭೌಮ ಯೆಹೋವ ದೇವರ ಮುಂದೆ ಮೌನವಾಗಿರಿ.</para>
  <para style="q2" vid="ZEP 1:7">ಏಕೆಂದರೆ ಯೆಹೋವ ದೇವರ ದಿನವು ಸಮೀಪವಾಗಿದೆ.</para>
  <para style="q1" vid="ZEP 1:7">ಯೆಹೋವ ದೇವರು ಯಜ್ಞವನ್ನು ಸಿದ್ಧಮಾಡಿದ್ದಾರೆ.</para>
  <para style="q2" vid="ZEP 1:7">ಅವರು ಆಮಂತ್ರಿಸಿದವರನ್ನು ಅವರು ಪವಿತ್ರೀಕರಿಸಿದ್ದಾರೆ.<verse eid="ZEP 1:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="ZEP 1:8"/>ಯೆಹೋವ ದೇವರ ಯಜ್ಞದ ದಿನದಲ್ಲಿ</para>
  <para style="q2" vid="ZEP 1:8">ನಾನು ಪ್ರಧಾನರನ್ನು, ರಾಜಪುತ್ರರನ್ನು</para>
  <para style="q2" vid="ZEP 1:8">ಮತ್ತು ವಿದೇಶಿಯರ ಉಡುಪನ್ನು ತೊಟ್ಟುಕೊಳ್ಳುವವರೆಲ್ಲರನ್ನೂ ದಂಡಿಸುವೆನು.<verse eid="ZEP 1:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="ZEP 1:9"/>ಆ ದಿನದಲ್ಲಿ</para>
  <para style="q2" vid="ZEP 1:9">ಹೊಸ್ತಿಲನ್ನು ದಾಟುವವರೆಲ್ಲರನ್ನೂ</para>
  <para style="q1" vid="ZEP 1:9">ತಮ್ಮ ದೇವರುಗಳ ಆಲಯಗಳನ್ನು</para>
  <para style="q2" vid="ZEP 1:9">ಹಿಂಸಾಚಾರದಿಂದಲೂ ಮೋಸದಿಂದಲೂ ತುಂಬಿಸುವವರನ್ನೂ ದಂಡಿಸುವೆನು.<verse eid="ZEP 1:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="ZEP 1:10"/>“ಆ ದಿನದಲ್ಲಿ,</para>
  <para style="q2" vid="ZEP 1:10">ಮೀನಿನ ಬಾಗಿಲಿನಿಂದ ಕೂಗಿನ ಶಬ್ದವೂ</para>
  <para style="q1" vid="ZEP 1:10">ಹೊಸ ಮನೆಯಿಂದ ಗೋಳಾಟವೂ</para>
  <para style="q2" vid="ZEP 1:10">ಗುಡ್ಡಗಳ ಕಡೆಯಿಂದ ಮುರಿಯುವ ಬಲವಾದ ಶಬ್ದವೂ ಕೇಳಿಬರುವುದು, ಎಂದು</para>
  <para style="q2" vid="ZEP 1:10">ಯೆಹೋವ ದೇವರು ಹೇಳುತ್ತಾರೆ.<verse eid="ZEP 1:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="ZEP 1:11"/>ಮಾರುಕಟ್ಟೆಗಳ ಜಿಲ್ಲೆಯಲ್ಲಿ ವಾಸಿಸುವವರೇ,</para>
  <para style="q2" vid="ZEP 1:11">ಗೋಳಾಡಿರಿ. ಏಕೆಂದರೆ ವರ್ತಕರ ಜನರೆಲ್ಲಾ ಸಂಹಾರವಾದರು.</para>
  <para style="q2" vid="ZEP 1:11">ಬೆಳ್ಳಿಯ ವ್ಯಾಪಾರಿಗಳೆಲ್ಲರೂ ನಾಶವಾದರು.<verse eid="ZEP 1:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="ZEP 1:12"/>ಆ ಕಾಲದಲ್ಲಿ, ನಾನು ಯೆರೂಸಲೇಮನ್ನು ದೀಪಗಳಿಂದ ಹುಡುಕಿಬಿಡುವೆನು.</para>
  <para style="q2" vid="ZEP 1:12">‘ಯೆಹೋವ ದೇವರು ಒಳ್ಳೆಯದನ್ನಾದರೂ ಕೆಟ್ಟದ್ದನ್ನಾದರೂ ಮಾಡುವುದಿಲ್ಲ’ ಎಂದುಕೊಂಡು</para>
  <para style="q2" vid="ZEP 1:12">ಮಡ್ಡಿಯ ಮೇಲೆ ಮಂದವಾಗಿರುವ ದ್ರಾಕ್ಷಾರಸಕ್ಕೆ</para>
  <para style="q2" vid="ZEP 1:12">ಸಮಾನರಾದ ಜನರನ್ನೂ ದಂಡಿಸುವೆನು.<verse eid="ZEP 1:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="ZEP 1:13"/>ಆದ್ದರಿಂದ ಅವರ ಸಂಪತ್ತು ಕೊಳ್ಳೆಯಾಗುವುದು,</para>
  <para style="q2" vid="ZEP 1:13">ಅವರ ಮನೆಗಳು ಹಾಳಾಗುವುವು.</para>
  <para style="q1" vid="ZEP 1:13">ಅವರು ಮನೆಗಳನ್ನು ಕಟ್ಟಿಕೊಂಡರೂ</para>
  <para style="q2" vid="ZEP 1:13">ಅವುಗಳಲ್ಲಿ ವಾಸಮಾಡರು.</para>
  <para style="q1" vid="ZEP 1:13">ದ್ರಾಕ್ಷಿತೋಟಗಳನ್ನು ನೆಟ್ಟು</para>
  <para style="q2" vid="ZEP 1:13">ಅವುಗಳ ರಸವನ್ನು ಕುಡಿಯರು.”<verse eid="ZEP 1:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="ZEP 1:14"/>ಯೆಹೋವ ದೇವರ ಮಹಾದಿವಸವು ಸಮೀಪವಾಗಿದೆ,</para>
  <para style="q2" vid="ZEP 1:14">ಬಹು ತ್ವರೆಯಾಗಿ ಬರುತ್ತಿದೆ.</para>
  <para style="q1" vid="ZEP 1:14">ಕೇಳಿರಿ. ಯೆಹೋವ ದೇವರ ದಿನದಂದು ಕೂಗು ಕಹಿಯಾಗಿರುವುದು.</para>
  <para style="q2" vid="ZEP 1:14">ಶೂರನು ಅಲ್ಲಿ ಬೊಬ್ಬೆ ಹಾಕುವನು.<verse eid="ZEP 1:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="ZEP 1:15"/>ಆ ದಿವಸವು ರೌದ್ರದ ದಿವಸವು,</para>
  <para style="q2" vid="ZEP 1:15">ಇಕ್ಕಟ್ಟು ಸಂಕಟಗಳ ದಿವಸವು,</para>
  <para style="q3" vid="ZEP 1:15">ಹಾಳುಪಾಳುಗಳ ದಿವಸವು,</para>
  <para style="q2" vid="ZEP 1:15">ಕತ್ತಲೆ ಮಬ್ಬುಗಳ ದಿವಸವು,</para>
  <para style="q3" vid="ZEP 1:15">ಕಾರ್ಮುಗಿಲ ಕಗ್ಗತ್ತಲ ದಿವಸವು,<verse eid="ZEP 1:15"/></para>
  <para style="q2">
    <verse number="16" style="v" sid="ZEP 1:16"/>ಕೋಟೆಯುಳ್ಳ ಪಟ್ಟಣಗಳಿಗೆ ವಿರೋಧವಾಗಿಯೂ</para>
  <para style="q1" vid="ZEP 1:16">ಉನ್ನತವಾದ ಗೋಪುರಗಳಿಗೆ</para>
  <para style="q2" vid="ZEP 1:16">ವಿರೋಧವಾಗಿಯೂ ತುತೂರಿ ಆರ್ಭಟಗಳ ದಿವಸವು.<verse eid="ZEP 1:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="ZEP 1:17"/>“ನಾನು ಮನುಷ್ಯರ ಮೇಲೆ ಇಕ್ಕಟ್ಟು ತರಿಸುವೆನು.</para>
  <para style="q2" vid="ZEP 1:17">ಅವರು ಕುರುಡರ ಹಾಗೆ ತಡಕುವರು.</para>
  <para style="q2" vid="ZEP 1:17">ಏಕೆಂದರೆ ಯೆಹೋವ ದೇವರಿಗೆ ವಿರೋಧವಾಗಿ ಪಾಪಮಾಡಿದ್ದಾರೆ.</para>
  <para style="q1" vid="ZEP 1:17">ಅವರ ರಕ್ತವು ಧೂಳಿನಂತೆಯೂ</para>
  <para style="q2" vid="ZEP 1:17">ಅವರ ಮಾಂಸವು ಗೊಬ್ಬರದಂತೆಯೂ ಸುರಿದಿರುವುದು.<verse eid="ZEP 1:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="ZEP 1:18"/>ಯೆಹೋವ ದೇವರ ರೌದ್ರದಿನದಂದು</para>
  <para style="q2" vid="ZEP 1:18">ಅವರ ಬೆಳ್ಳಿಯಾದರೂ ಅವರ ಬಂಗಾರವಾದರೂ</para>
  <para style="q2" vid="ZEP 1:18">ಅವರನ್ನು ರಕ್ಷಿಸಲಾರವು.”</para>
  <para style="b" vid="ZEP 1:18"/>
  <para style="q1" vid="ZEP 1:18">ಅವರ ಅಸೂಯೆಯ ಬೆಂಕಿಯು</para>
  <para style="q2" vid="ZEP 1:18">ದೇಶವನ್ನೆಲ್ಲಾ ನುಂಗುವುದು.</para>
  <para style="q1" vid="ZEP 1:18">ಏಕೆಂದರೆ ದೇಶದ ನಿವಾಸಿಗಳನ್ನೆಲ್ಲಾ</para>
  <para style="q2" vid="ZEP 1:18">ಬೇಗ ನಿರ್ಮೂಲ ಮಾಡಿಬಿಡುವರು.<verse eid="ZEP 1:18"/></para>
  <chapter eid="ZEP 1"/>
  <chapter number="2" style="c" sid="ZEP 2"/>
  <para style="s1">ಅನ್ಯಜನರೊಂದಿಗೆ ಯೆಹೂದ ಮತ್ತು ಯೆರೂಸಲೇಮಿನ ತೀರ್ಪು</para>
  <para style="s2">ಪಶ್ಚಾತ್ತಾಪಪಡಲು ಯೆಹೂದಕ್ಕೆ ಆದೇಶ</para>
  <para style="q1">
    <verse number="1" style="v" sid="ZEP 2:1"/>ನಾಚಿಕೆ ಇಲ್ಲದ ಜನಾಂಗದವರೇ,</para>
  <para style="q2" vid="ZEP 2:1">ಒಟ್ಟಾಗಿ ಕೂಡಿಕೊಳ್ಳಿರಿ, ನೀವು ಒಟ್ಟಾಗಿ ಕೂಡಿಕೊಳ್ಳಿರಿ,<verse eid="ZEP 2:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="ZEP 2:2"/>ತೀರ್ಪು ಕಾರ್ಯಗತಗೊಳ್ಳುವ ಮುಂಚೆ</para>
  <para style="q2" vid="ZEP 2:2">ಮತ್ತು ಆ ದಿನವು ಗಾಳಿ ಬೀಸಿದ ಹೊಟ್ಟಿನಂತೆ ಹಾರಿಹೋಗುವುದಕ್ಕಿಂತ ಮುಂಚೆ</para>
  <para style="q1" vid="ZEP 2:2">ಯೆಹೋವ ದೇವರ ಉಗ್ರಕೋಪವು</para>
  <para style="q2" vid="ZEP 2:2">ನಿಮ್ಮ ಮೇಲೆ ಬರುವ ಮುಂಚೆ,</para>
  <para style="q1" vid="ZEP 2:2">ಯೆಹೋವ ದೇವರ ಕೋಪದ ದಿನವು</para>
  <para style="q2" vid="ZEP 2:2">ನಿಮ್ಮ ಮೇಲೆ ಬರುವ ಮುಂಚೆ,<verse eid="ZEP 2:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="ZEP 2:3"/>ದೇಶದ ದೀನರೇ, ಅವರ ಆಜ್ಞೆಗಳನ್ನು ಕೈಕೊಂಡು ನಡೆಯುವವರೆಲ್ಲರೇ</para>
  <para style="q2" vid="ZEP 2:3">ಯೆಹೋವ ದೇವರನ್ನು ಹುಡುಕಿರಿ.</para>
  <para style="q1" vid="ZEP 2:3">ನೀತಿಯನ್ನು ಹುಡುಕಿರಿ, ವಿನಯವನ್ನು ಹುಡುಕಿರಿ.</para>
  <para style="q2" vid="ZEP 2:3">ಒಂದು ವೇಳೆ ಯೆಹೋವ ದೇವರ ಕೋಪದ ದಿವಸದಲ್ಲಿ ಆಶ್ರಯ ಹೊಂದುವಿರಿ.<verse eid="ZEP 2:3"/></para>
  <para style="s2">ಫಿಲಿಷ್ಟಿಯದ ವಿರೋಧವಾಗಿ</para>
  <para style="q1">
    <verse number="4" style="v" sid="ZEP 2:4"/>ಗಾಜವು ಕೈಬಿಡಲಾಗುವುದು;</para>
  <para style="q2" vid="ZEP 2:4">ಅಷ್ಕೆಲೋನ್ ಹಾಳಾಗುವುದು;</para>
  <para style="q1" vid="ZEP 2:4">ಅಷ್ಡೋದನ್ನು ಮಧ್ಯಾಹ್ನದಲ್ಲಿ ಖಾಲಿಮಾಡುವರು,</para>
  <para style="q2" vid="ZEP 2:4">ಎಕ್ರೋನ್ ಕಿತ್ತೆಸೆಯಲಾಗುವುದು.<verse eid="ZEP 2:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="ZEP 2:5"/>ಅಯ್ಯೋ, ಕರಾವಳಿಯಲ್ಲಿ ವಾಸಿಸುವ</para>
  <para style="q2" vid="ZEP 2:5">ಕೆರೇತ್ಯ ಜನಾಂಗವೇ,</para>
  <para style="q1" vid="ZEP 2:5">ನಿನ್ನ ಗತಿಯನ್ನು ಏನು ಹೇಳಲಿ!</para>
  <para style="q2" vid="ZEP 2:5">ಕಾನಾನೇ, ಫಿಲಿಷ್ಟಿಯ ದೇಶವೇ,</para>
  <para style="q1" vid="ZEP 2:5">ಯೆಹೋವ ದೇವರ ವಾಕ್ಯವು ನಿನಗೆ ವಿರುದ್ಧವಾಗಿದೆ,</para>
  <para style="q2" vid="ZEP 2:5">“ನಿನ್ನಲ್ಲಿ ನಿವಾಸಿಯೇ ನಿಲ್ಲದಂತೆ ನಿನ್ನನ್ನು ನಾಶಮಾಡುವೆನು,”</para>
  <para style="q2" vid="ZEP 2:5">ಎಂದು ಅವರು ಹೇಳುತ್ತಾರೆ.<verse eid="ZEP 2:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="ZEP 2:6"/>ಸಮುದ್ರದ ತೀರವು</para>
  <para style="q2" vid="ZEP 2:6">ಕುರುಬರು ಮೇಯಿಸುವ ಸ್ಥಳಗಳಾಗಿಯೂ</para>
  <para style="q2" vid="ZEP 2:6">ಕುಂಟೆಗಳಾಗಿಯೂ ಕುರಿಹಟ್ಟಿಗಳಾಗಿಯೂ ಇರುವುದು.<verse eid="ZEP 2:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="ZEP 2:7"/>ಅದು ಯೆಹೂದದ ಮನೆತನದಲ್ಲಿ</para>
  <para style="q2" vid="ZEP 2:7">ಉಳಿದವರ ವಶವಾಗುವುದು.</para>
  <para style="q2" vid="ZEP 2:7">ಅದರ ಮೇಲೆ ಮೇಯಿಸುವರು.</para>
  <para style="q1" vid="ZEP 2:7">ಅಷ್ಕೆಲೋನಿನ ಮನೆತನಗಳಲ್ಲಿ</para>
  <para style="q2" vid="ZEP 2:7">ಸಾಯಂಕಾಲದಲ್ಲಿ ಅವರು ಮಲಗಿಕೊಳ್ಳುವರು.</para>
  <para style="q1" vid="ZEP 2:7">ಏಕೆಂದರೆ ಅವರ ದೇವರಾದ ಯೆಹೋವ ದೇವರು,</para>
  <para style="q2" vid="ZEP 2:7">ಅವರನ್ನು ಪರಿಪಾಲಿಸಿ, ಮತ್ತೆ ಏಳಿಗೆಗೆ ತರುವರು.<verse eid="ZEP 2:7"/></para>
  <para style="s2">ಅಮ್ಮೋನು ಮತ್ತು ಮೋವಾಬುಗಳ ವಿರೋಧವಾಗಿ</para>
  <para style="q1">
    <verse number="8" style="v" sid="ZEP 2:8"/>“ಮೋವಾಬಿನ ನಿಂದೆಯನ್ನೂ</para>
  <para style="q2" vid="ZEP 2:8">ಅಮ್ಮೋನ್ಯರ ಬೈಗಳವನ್ನೂ</para>
  <para style="q1" vid="ZEP 2:8">ಅವರು ನನ್ನ ಜನರನ್ನೂ ನಿಂದಿಸಿ,</para>
  <para style="q2" vid="ZEP 2:8">ಅವರ ಮೇರೆಗೆ ವಿರೋಧವಾಗಿ ತಮ್ಮನ್ನು ಹೆಚ್ಚಿಸಿಕೊಂಡದ್ದನ್ನೂ ನಾನು ಕೇಳಿದ್ದೇನೆ.<verse eid="ZEP 2:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="ZEP 2:9"/>ಆದ್ದರಿಂದ ಇಸ್ರಾಯೇಲಿನ ದೇವರಾದ</para>
  <para style="q2" vid="ZEP 2:9">ಸೇನಾಧೀಶ್ವರ ಯೆಹೋವ ದೇವರು ಹೇಳುವುದೇನೆಂದರೆ:</para>
  <para style="q2" vid="ZEP 2:9">ನನ್ನ ಜೀವದಾಣೆ,”</para>
  <para style="q1" vid="ZEP 2:9">“ನಿಶ್ಚಯವಾಗಿ ಮೋವಾಬು ಸೊದೋಮಿನ</para>
  <para style="q2" vid="ZEP 2:9">ಅಮ್ಮೋನ್ಯರು ಗೊಮೋರದ ಹಾಗೆ ಆಗುವುದು.</para>
  <para style="q1" vid="ZEP 2:9">ತುರುಚಿ ಗಿಡಗಳನ್ನು ಹುಟ್ಟಿಸುವಂಥ ಉಪ್ಪಿನ ಕುಳಿಗಳುಳ್ಳಂಥ</para>
  <para style="q2" vid="ZEP 2:9">ನಿತ್ಯವಾಗಿ ಹಾಳಾದ ಸ್ಥಳವಾಗುವರು.</para>
  <para style="q1" vid="ZEP 2:9">ನನ್ನ ಜನರಲ್ಲಿ ಉಳಿದವರು ಅವರನ್ನು ಸುಲಿದುಕೊಳ್ಳುವರು.</para>
  <para style="q2" vid="ZEP 2:9">ನನ್ನ ಜನರಲ್ಲಿ ಮಿಕ್ಕಾದವರು ಅವರ ದೇಶವನ್ನು ಸ್ವಾಧೀನಮಾಡಿಕೊಳ್ಳುವರು.”<verse eid="ZEP 2:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="ZEP 2:10"/>ಅವರು ಸೇನಾಧೀಶ್ವರ ಯೆಹೋವ ದೇವರ ಜನರನ್ನು</para>
  <para style="q2" vid="ZEP 2:10">ಅವಮಾನಿಸಿ ಮತ್ತು ಅಪಹಾಸ್ಯ ಮಾಡಿದ್ದರಿಂದಲೇ</para>
  <para style="q2" vid="ZEP 2:10">ಅವರ ಗರ್ವಕ್ಕೋಸ್ಕರ ಇದೇ ಅವರಿಗೆ ಸಿಕ್ಕುವುದು.<verse eid="ZEP 2:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="ZEP 2:11"/>ಅವರು ಭೂಮಿಯ ಎಲ್ಲಾ ದೇವರುಗಳನ್ನು ನಾಶಮಾಡುವಾಗ,</para>
  <para style="q2" vid="ZEP 2:11">ಯೆಹೋವ ದೇವರು ಅವರಿಗೆ ಭಯಂಕರವಾಗಿರುವರು.</para>
  <para style="q1" vid="ZEP 2:11">ಇತರ ಜನಾಂಗಗಳ ದ್ವೀಪಗಳವರೆಲ್ಲರು</para>
  <para style="q2" vid="ZEP 2:11">ತಮ್ಮ ತಮ್ಮ ಸ್ಥಳಗಳಲ್ಲಿ ಅವರನ್ನು ಆರಾಧಿಸುವರು.<verse eid="ZEP 2:11"/></para>
  <para style="s2">ಕೂಷ್ಯರ ವಿರೋಧವಾಗಿ</para>
  <para style="q1">
    <verse number="12" style="v" sid="ZEP 2:12"/>ಕೂಷ್ ದೇಶದವರೇ, ನೀವೂ ಸಹ</para>
  <para style="q2" vid="ZEP 2:12">ನನ್ನ ಖಡ್ಗದಿಂದ ಹತರಾಗುವಿರಿ.<verse eid="ZEP 2:12"/></para>
  <para style="s2">ಅಸ್ಸೀರಿಯ</para>
  <para style="q1">
    <verse number="13" style="v" sid="ZEP 2:13"/>ಅವರು ತನ್ನ ಕೈಯನ್ನು ಉತ್ತರದ ಮೇಲೆ ಚಾಚಿ,</para>
  <para style="q2" vid="ZEP 2:13">ಅಸ್ಸೀರಿಯರನ್ನು ನಾಶಮಾಡಿ</para>
  <para style="q1" vid="ZEP 2:13">ನಿನೆವೆಯನ್ನು ಹಾಳಾಗಿಯೂ</para>
  <para style="q2" vid="ZEP 2:13">ಮರುಭೂಮಿಯಂತೆ ಒಣಗಿದ್ದಾಗಿಯೂ ಮಾಡುವರು.<verse eid="ZEP 2:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="ZEP 2:14"/>ಅದು ದನಗಳ ಹಿಂಡುಗಳಿಗೂ ಕುರಿಗಳ ಮಂದೆಗಳಿಗೂ</para>
  <para style="q2" vid="ZEP 2:14">ಎಲ್ಲಾ ತರದ ಪ್ರಾಣಿಗಳಿಗೂ ಮಲಗುವ ಹಟ್ಟಿ ಆಗುವುದು,</para>
  <para style="q1" vid="ZEP 2:14">ಅದರ ಹಾಳುಬಿದ್ದ ಮನೆಯ ಕಂಬಗಳ ಮೇಲೆ</para>
  <para style="q2" vid="ZEP 2:14">ಗೂಬೆಗಳೂ, ಗುಬ್ಬಚ್ಚಿಗಳೂ ತಂಗುವುವು.</para>
  <para style="q1" vid="ZEP 2:14">ಗೂಬೆಯ ಘೂಂಕಾರವು ಕಿಟಕಿಗಳಿಂದ ಕೇಳಿಬರುವುದು,</para>
  <para style="q2" vid="ZEP 2:14">ಕಾಗೆಗಳ ಕೂಗು ಬಾಗಿಲಿನ ಹೊಸ್ತಿಲಲ್ಲೇ ಕೇಳುವುದು,</para>
  <para style="q2" vid="ZEP 2:14">ದೇವದಾರು ಮರದ ತೊಲೆಗಳು ಕಳಚಿಬೀಳುವುವು.<verse eid="ZEP 2:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="ZEP 2:15"/>“ನಿಶ್ಚಿಂತೆಯಾಗಿ ವಾಸಿಸಿದಂಥ ಉಲ್ಲಾಸದ ಪಟ್ಟಣ ನಾನೇ ಹೊರತು ಮತ್ತೊಂದಿಲ್ಲಾ,”</para>
  <para style="q2" vid="ZEP 2:15">ಎಂದು ತನ್ನೊಳಗೆ ಎಂದುಕೊಂಡಂಥ</para>
  <para style="q1" vid="ZEP 2:15">ಸುಭದ್ರ ನಿನೆವೆ ಪಟ್ಟಣವು ಇದೇ.</para>
  <para style="q2" vid="ZEP 2:15">ಅದು ಎಷ್ಟೋ ಹಾಳಾಯಿತು;</para>
  <para style="q1" vid="ZEP 2:15">ಮೃಗಗಳು ಮಲಗಿಕೊಳ್ಳುವ ಸ್ಥಳವಾಯಿತು.</para>
  <para style="q2" vid="ZEP 2:15">ಅದರಲ್ಲಿ ಹಾದುಹೋಗುವವರೆಲ್ಲರೂ</para>
  <para style="q2" vid="ZEP 2:15">ನಿಂದಿಸಿ ಅಪಹಾಸ್ಯ ಮಾಡುವರು.<verse eid="ZEP 2:15"/></para>
  <chapter eid="ZEP 2"/>
  <chapter number="3" style="c" sid="ZEP 3"/>
  <para style="s1">ಯೆರೂಸಲೇಮಿನ ಭವಿಷ್ಯತ್ತು</para>
  <para style="q1">
    <verse number="1" style="v" sid="ZEP 3:1"/>ಅಸಹ್ಯವಾದ, ಮೈಲಿಗೆಯಾದ,</para>
  <para style="q2" vid="ZEP 3:1">ಶ್ರಮೆಪಡಿಸುವ ಪಟ್ಟಣಕ್ಕೆ ಕಷ್ಟ!<verse eid="ZEP 3:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="ZEP 3:2"/>ಅವಳು ಯಾರಿಗೂ ವಿಧೇಯಳಾಗಲಿಲ್ಲ;</para>
  <para style="q2" vid="ZEP 3:2">ಶಿಕ್ಷೆಯನ್ನು ತೆಗೆದುಕೊಳ್ಳಲಿಲ್ಲ;</para>
  <para style="q1" vid="ZEP 3:2">ಯೆಹೋವ ದೇವರಲ್ಲಿ ಭರವಸೆ ಇಡಲಿಲ್ಲ;</para>
  <para style="q2" vid="ZEP 3:2">ತನ್ನ ದೇವರ ಸಮೀಪಕ್ಕೆ ಬರಲಿಲ್ಲ.<verse eid="ZEP 3:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="ZEP 3:3"/>ಅವಳ ಪ್ರಮುಖರು</para>
  <para style="q2" vid="ZEP 3:3">ಗರ್ಜಿಸುವ ಸಿಂಹಗಳು.</para>
  <para style="q1" vid="ZEP 3:3">ಅವಳ ನ್ಯಾಯಾಧಿಪತಿಗಳು ಸಂಜೆಯ ತೋಳಗಳು.</para>
  <para style="q2" vid="ZEP 3:3">ಕಡಿಯುವುದಕ್ಕೆ ಎಲುಬನ್ನು ಕೂಡ ಮರುದಿನದವರೆಗೆ ಉಳಿಸವು.<verse eid="ZEP 3:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="ZEP 3:4"/>ಅವಳ ಪ್ರವಾದಿಗಳು ಬಡಾಯಿ ಕೊಚ್ಚಿಕೊಳ್ಳುವವರೂ</para>
  <para style="q2" vid="ZEP 3:4">ವಿಶ್ವಾಸದ್ರೋಹಿಗಳೂ ಆಗಿದ್ದಾರೆ.</para>
  <para style="q1" vid="ZEP 3:4">ಅವಳ ಯಾಜಕರು ಪರಿಶುದ್ಧ ಸ್ಥಳವನ್ನು ಅಪವಿತ್ರಮಾಡುತ್ತಾರೆ,</para>
  <para style="q2" vid="ZEP 3:4">ದೈವನಿಯಮವನ್ನು ಭಂಗಪಡಿಸುತ್ತಾರೆ.<verse eid="ZEP 3:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="ZEP 3:5"/>ನೀತಿಯುಳ್ಳ ಯೆಹೋವ ದೇವರು ಅವಳ ಮಧ್ಯದಲ್ಲಿ ಇದ್ದಾರೆ.</para>
  <para style="q2" vid="ZEP 3:5">ಅವರು ಅನ್ಯಾಯ ಮಾಡುವುದಿಲ್ಲ;</para>
  <para style="q1" vid="ZEP 3:5">ಪ್ರತಿ ಬೆಳಿಗ್ಗೆ ತಮ್ಮ ನ್ಯಾಯತೀರ್ಪನ್ನು ಬೆಳಕಿಗೆ ತರುತ್ತಾರೆ;</para>
  <para style="q2" vid="ZEP 3:5">ಅವರು ತಪ್ಪುವವರಲ್ಲ.</para>
  <para style="q2" vid="ZEP 3:5">ಆದರೆ ಅನ್ಯಾಯವಂತನು ನಾಚಿಕೆಯನ್ನು ಅರಿಯನು.<verse eid="ZEP 3:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="ZEP 3:6"/>“ನಾನು ಜನಾಂಗಗಳನ್ನು ಕಡಿದು ಬಿಟ್ಟಿದ್ದೇನೆ.</para>
  <para style="q2" vid="ZEP 3:6">ಅವುಗಳ ಗೋಪುರಗಳು ಹಾಳಾಗಿವೆ.</para>
  <para style="q1" vid="ZEP 3:6">ಅವುಗಳ ಬೀದಿಗಳನ್ನು ಯಾರೂ ಹಾದುಹೋಗದ ಹಾಗೆ ಹಾಳುಮಾಡಿದ್ದೆನೆ.</para>
  <para style="q2" vid="ZEP 3:6">ಅವುಗಳ ಪಟ್ಟಣಗಳು ನಾಶವಾದವು.</para>
  <para style="q1" vid="ZEP 3:6">ಹೀಗೆ ಅಲ್ಲಿ ಯಾವನೂ ಇರುವುದಿಲ್ಲ;</para>
  <para style="q2" vid="ZEP 3:6">ಯಾವ ಮನುಷ್ಯನೂ ಅಲ್ಲಿ ವಾಸಿಸುವುದೂ ಇಲ್ಲ.<verse eid="ZEP 3:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="ZEP 3:7"/>‘ನಿಶ್ಚಯವಾಗಿ ನೀನು ನನಗೆ ಭಯಪಟ್ಟು</para>
  <para style="q2" vid="ZEP 3:7">ಶಿಕ್ಷಣವನ್ನು ಹೊಂದುವೆ,’</para>
  <para style="q2" vid="ZEP 3:7">ಹೀಗೆ ನಾನು ಅವರಿಗೆ ಶಿಕ್ಷೆ ವಿಧಿಸಿದರೂ</para>
  <para style="q1" vid="ZEP 3:7">ಅವರ ನಿವಾಸವು ನಾಶವಾಗುವುದಿಲ್ಲ.</para>
  <para style="q2" vid="ZEP 3:7">ಆದರೆ ಅವರು ಬೇಗನೆ ಎದ್ದು</para>
  <para style="q2" vid="ZEP 3:7">ತಮ್ಮ ನಡತೆಯನ್ನೆಲ್ಲಾ ಕೆಡಿಸಿಕೊಂಡರು.<verse eid="ZEP 3:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="ZEP 3:8"/>ಆದ್ದರಿಂದ ಯೆಹೋವ ದೇವರು ಹೀಗೆನ್ನುತ್ತಾರೆ:</para>
  <para style="q2" vid="ZEP 3:8">ನಾನು ಬೇಟೆ ಹಿಡಿಯಲಿಕ್ಕೆ ಏಳುವ ದಿವಸದವರೆಗೂ ನನಗೆ ಕಾದುಕೊಳ್ಳಿರಿ.”</para>
  <para style="q1" vid="ZEP 3:8">ಏಕೆಂದರೆ ಜನಾಂಗಗಳನ್ನು ಕೂಡಿಸುವುದಕ್ಕೂ</para>
  <para style="q2" vid="ZEP 3:8">ರಾಜ್ಯಗಳನ್ನು ಒಟ್ಟು ಸೇರಿಸುವುದಕ್ಕೂ</para>
  <para style="q1" vid="ZEP 3:8">ಅವುಗಳ ಮೇಲೆ ನನ್ನ ರೌದ್ರವನ್ನೂ</para>
  <para style="q2" vid="ZEP 3:8">ನನ್ನ ಕೋಪದ ಎಲ್ಲಾ ಉರಿಯನ್ನೂ</para>
  <para style="q1" vid="ZEP 3:8">ಹೊಯ್ಯುವುದಕ್ಕೂ ತೀರ್ಮಾನಿಸಿಕೊಂಡಿದ್ದೇನೆ.</para>
  <para style="q2" vid="ZEP 3:8">ಏಕೆಂದರೆ ನನ್ನ ರೋಷದ ಬೆಂಕಿಯಿಂದ ಭೂಮಿಯೆಲ್ಲಾ ದಹಿಸಲಾಗುವುದು.<verse eid="ZEP 3:8"/></para>
  <para style="s1">ಇಸ್ರಾಯೇಲಿನ ಅವಶೇಷಗಳ ಪುನಃಸ್ಥಾಪನೆ</para>
  <para style="q1">
    <verse number="9" style="v" sid="ZEP 3:9"/>“ಆಗ ನಾನು ಜನರ ತುಟಿಗಳನ್ನು ಶುದ್ಧೀಕರಿಸುವೆನು.</para>
  <para style="q2" vid="ZEP 3:9">ಅವರೆಲ್ಲರೂ ಯೆಹೋವ ದೇವರ ಹೆಸರಿನಿಂದ ಮೊರೆಯಿಡುವರು.</para>
  <para style="q2" vid="ZEP 3:9">ಏಕಮನಸ್ಸಿನಿಂದ ಆತನಿಗೆ ಸೇವೆಮಾಡುವರು.<verse eid="ZEP 3:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="ZEP 3:10"/>ಕೂಷಿನ ನದಿಗಳ ಆಚೆಯಿಂದ ನನ್ನ ಭಕ್ತರೂ ಚದರಿಹೋದ</para>
  <para style="q2" vid="ZEP 3:10">ನನ್ನ ಜನರೂ ನನಗೆ ಕಾಣಿಕೆಗಳನ್ನು ತರುವರು.<verse eid="ZEP 3:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="ZEP 3:11"/>ಆ ದಿವಸದಲ್ಲಿ ನೀನು ನನಗೆ ವಿರೋಧವಾಗಿ ಮಾಡಿದ</para>
  <para style="q2" vid="ZEP 3:11">ದುಷ್ಕೃತ್ಯಗಳಿಗಾಗಿ ನಾಚಿಕೆಗೆ ಗುರಿಯಾಗುವುದಿಲ್ಲ;</para>
  <para style="q1" vid="ZEP 3:11">ಏಕೆಂದರೆ ಆಗ ಗರ್ವದಿಂದ ಹೊಗಳಿಕೊಳ್ಳುವವರನ್ನು</para>
  <para style="q2" vid="ZEP 3:11">ನಿನ್ನ ಮಧ್ಯದೊಳಗಿಂದ ತೆಗೆದುಹಾಕುವೆನು.</para>
  <para style="q1" vid="ZEP 3:11">ನನ್ನ ಪರಿಶುದ್ಧ ಪರ್ವತದಲ್ಲಿ ಇನ್ನು ಮೇಲೆ</para>
  <para style="q2" vid="ZEP 3:11">ನೀನು ಗರ್ವಪಡದೇ ಬಾಳುವೆ.<verse eid="ZEP 3:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="ZEP 3:12"/>ಆದರೆ ನಿನ್ನ ಮಧ್ಯದಲ್ಲಿ</para>
  <para style="q2" vid="ZEP 3:12">ಸೌಮ್ಯರನ್ನೂ ದೀನರನ್ನೂ ಉಳಿಸುವೆನು.</para>
  <para style="q1" vid="ZEP 3:12">ಇವರು ಯೆಹೋವ ದೇವರ ಹೆಸರಿನಲ್ಲಿ ನಂಬಿಕೆ ಇಡುವರು.<verse eid="ZEP 3:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="ZEP 3:13"/>ಇಸ್ರಾಯೇಲಿನಲ್ಲಿ ಉಳಿದವರು</para>
  <para style="q2" vid="ZEP 3:13">ಅನ್ಯಾಯ ಮಾಡರು; ಸುಳ್ಳಾಡರು,</para>
  <para style="q1" vid="ZEP 3:13">ಅವರ ಬಾಯಲ್ಲಿ ಮೋಸವಿರದು.</para>
  <para style="q2" vid="ZEP 3:13">ಅವರು ಮಂದೆಯಂತೆ ಮೇದು ಮಲಗುವರು.</para>
  <para style="q2" vid="ZEP 3:13">ಅವರನ್ನು ಭಯಪಡಿಸುವವನು ಒಬ್ಬನೂ ಇರುವುದಿಲ್ಲ.”<verse eid="ZEP 3:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="ZEP 3:14"/>ಚೀಯೋನಿನ ಪುತ್ರಿಯೇ, ಹಾಡು.</para>
  <para style="q2" vid="ZEP 3:14">ಇಸ್ರಾಯೇಲೇ ಆರ್ಭಟಿಸು;</para>
  <para style="q1" vid="ZEP 3:14">ಯೆರೂಸಲೇಮಿನ ಪುತ್ರಿಯೇ,</para>
  <para style="q2" vid="ZEP 3:14">ಪೂರ್ಣಹೃದಯದಿಂದ ಸಂಭ್ರಮಿಸಿ ಉಲ್ಲಾಸಪಡು.<verse eid="ZEP 3:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="ZEP 3:15"/>ಯೆಹೋವ ದೇವರು ನಿನ್ನ ಶಿಕ್ಷೆಗಳನ್ನು ದೂರಮಾಡಿ</para>
  <para style="q2" vid="ZEP 3:15">ನಿನ್ನ ಶತ್ರುವನ್ನು ತೆಗೆದುಹಾಕಿದ್ದಾರೆ.</para>
  <para style="q1" vid="ZEP 3:15">ಇಸ್ರಾಯೇಲಿನ ಅರಸನಾದ ಯೆಹೋವ ದೇವರು ನಿನ್ನ ಮಧ್ಯದಲ್ಲಿ ಇದ್ದಾರೆ.</para>
  <para style="q2" vid="ZEP 3:15">ಇನ್ನು ಮೇಲೆ ನಿನಗೆ ಯಾವ ಕೇಡಿನ ಭಯವಿರುವುದಿಲ್ಲ.<verse eid="ZEP 3:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="ZEP 3:16"/>ಆ ದಿವಸದಲ್ಲಿ ಯೆರೂಸಲೇಮಿಗೆ ಹೀಗೆಂದು ಹೇಳುವರು,</para>
  <para style="q2" vid="ZEP 3:16">“ಚೀಯೋನೇ, ನೀನು ಭಯಪಡಬೇಡ;</para>
  <para style="q2" vid="ZEP 3:16">ನಿನ್ನ ಕೈಗಳು ಬಲಹೀನವಾಗದಿರಲಿ.<verse eid="ZEP 3:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="ZEP 3:17"/>ನಿನ್ನ ದೇವರಾದ ಯೆಹೋವ ದೇವರು ನಿನ್ನೊಂದಿಗಿದ್ದಾರೆ.</para>
  <para style="q2" vid="ZEP 3:17">ನಿನ್ನನ್ನು ರಕ್ಷಿಸಲು ಶಕ್ತರಾಗಿದ್ದಾರೆ.</para>
  <para style="q1" vid="ZEP 3:17">ನಿನ್ನಲ್ಲಿ ಬಹಳವಾಗಿ ಹರ್ಷಾನಂದಗೊಳ್ಳುವರು.</para>
  <para style="q2" vid="ZEP 3:17">ತಮ್ಮ ಪ್ರೀತಿಯ ನಿಮಿತ್ತ ಅವರು ಇನ್ನು ಮುಂದೆ ನಿನ್ನನ್ನು ಖಂಡಿಸುವುದಿಲ್ಲ,</para>
  <para style="q2" vid="ZEP 3:17">ಆದರೆ ಆನಂದ ಸ್ವರದಿಂದ ನಿನ್ನ ಮೇಲೆ ಉಲ್ಲಾಸಿಸುವರು.”<verse eid="ZEP 3:17"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="18" style="v" sid="ZEP 3:18"/>“ನೇಮಕವಾದ ಹಬ್ಬಗಳ ನಷ್ಟಕ್ಕಾಗಿರುವ ನಿಮ್ಮ ದುಃಖವನ್ನು</para>
  <para style="q2" vid="ZEP 3:18">ನಿಮ್ಮಿಂದ ನಾನು ತೆಗೆದುಬಿಡುವೆನು.</para>
  <para style="q2" vid="ZEP 3:18">ಅವು ನಿನಗೆ ಭಾರವಾಗಿಯೂ ನಿಂದೆಯಾಗಿಯೂ ಇದ್ದವು.<verse eid="ZEP 3:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="ZEP 3:19"/>ಆ ಕಾಲದಲ್ಲಿ</para>
  <para style="q2" vid="ZEP 3:19">ನಿನ್ನನ್ನು ಪೀಡಿಸುವವರನ್ನೆಲ್ಲಾ ದಂಡಿಸುವೆನು,</para>
  <para style="q1" vid="ZEP 3:19">ಕುಂಟಾದದ್ದನ್ನು ರಕ್ಷಿಸಿ,</para>
  <para style="q2" vid="ZEP 3:19">ಚದರಿಹೋದವರನ್ನು ಕೂಡಿಸುವೆನು;</para>
  <para style="q1" vid="ZEP 3:19">ಅವರು ಅವಮಾನ ಹೊಂದಿದ ದೇಶಗಳಲ್ಲೆಲ್ಲಾ</para>
  <para style="q2" vid="ZEP 3:19">ಅವರಿಗೆ ಹೊಗಳಿಕೆಯನ್ನೂ ಕೀರ್ತಿಯನ್ನೂ ಉಂಟುಮಾಡುವೆನು.<verse eid="ZEP 3:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="ZEP 3:20"/>ಆ ಕಾಲದಲ್ಲಿ ನಾನು ನಿಮ್ಮನ್ನು ಒಟ್ಟುಗೂಡಿಸುವೆನು.</para>
  <para style="q2" vid="ZEP 3:20">ಆ ಸಮಯದಲ್ಲಿ ನಾನು ಮನೆಗೆ ನಿಮ್ಮನ್ನು ಕರೆದುಕೊಂಡು ಬರುವೆನು.</para>
  <para style="q1" vid="ZEP 3:20">ನಾನು ನಿಮ್ಮ ಸೌಭಾಗ್ಯವನ್ನು</para>
  <para style="q2" vid="ZEP 3:20">ನಿಮ್ಮ ಕಣ್ಣೆದುರಿಗೆ ಪುನಃಸ್ಥಾಪಿಸಿ</para>
  <para style="q1" vid="ZEP 3:20">ಭೂಮಿಯ ಎಲ್ಲಾ ಜನರಲ್ಲಿ</para>
  <para style="q2" vid="ZEP 3:20">ನಿಮಗೆ ಕೀರ್ತಿಯನ್ನೂ ಹೊಗಳಿಕೆಯನ್ನೂ ಉಂಟುಮಾಡುವೆನು,”</para>
  <para style="q2" vid="ZEP 3:20">ಎಂದು ಯೆಹೋವ ದೇವರು ಹೇಳುತ್ತಾರೆ.<verse eid="ZEP 3:20"/></para>
  <chapter eid="ZEP 3"/>
</usx>
