<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="MAT" style="id">- Biblica® Open Kannada Contemporary Version</book>
  <para style="h">ಮತ್ತಾಯ</para>
  <para style="toc1">ಮತ್ತಾಯನು ಬರೆದ ಸುವಾರ್ತೆ</para>
  <para style="toc2">ಮತ್ತಾಯ</para>
  <para style="toc3">ಮತ್ತಾಯ</para>
  <para style="mt1">ಮತ್ತಾಯನು</para>
  <para style="mt2">ಬರೆದ ಸುವಾರ್ತೆ</para>
  <chapter number="1" style="c" sid="MAT 1"/>
  <para style="s1">ಯೇಸುಸ್ವಾಮಿಯ ವಂಶಾವಳಿ</para>
  <para style="li4">
    <verse number="1" style="v" sid="MAT 1:1"/>ಕ್ರಿಸ್ತ ಯೇಸುವಿನ ವಂಶಾವಳಿಯ ದಾಖಲೆ. ಯೇಸು ದಾವೀದನ ವಂಶದವರು, ದಾವೀದನು ಅಬ್ರಹಾಮನ ವಂಶದವನು:<verse eid="MAT 1:1"/></para>
  <para style="b"/>
  <para style="li1">
    <verse number="2" style="v" sid="MAT 1:2"/>ಅಬ್ರಹಾಮನು ಇಸಾಕನ ತಂದೆ,</para>
  <para style="li1" vid="MAT 1:2">ಇಸಾಕನು ಯಾಕೋಬನ ತಂದೆ,</para>
  <para style="li1" vid="MAT 1:2">ಯಾಕೋಬನು ಯೂದ ಮತ್ತು ಅವನ ಅಣ್ಣ ತಮ್ಮಂದಿರ ತಂದೆ,<verse eid="MAT 1:2"/></para>
  <para style="li1">
    <verse number="3" style="v" sid="MAT 1:3"/>ಯೂದನು ಪೆರೆಸ ಮತ್ತು ಜೆರಹನ ತಂದೆ, ತಾಮಾರಳು ಇವರ ತಾಯಿ,</para>
  <para style="li1" vid="MAT 1:3">ಪೆರೆಸನು ಹೆಚ್ರೋನನ ತಂದೆ,</para>
  <para style="li1" vid="MAT 1:3">ಹೆಚ್ರೋನನು ಅರಾಮನ ತಂದೆ,<verse eid="MAT 1:3"/></para>
  <para style="li1">
    <verse number="4" style="v" sid="MAT 1:4"/>ಅರಾಮನು ಅಮ್ಮೀನಾದಾಬನ ತಂದೆ,</para>
  <para style="li1" vid="MAT 1:4">ಅಮ್ಮೀನಾದಾಬನು ನಹಶೋನನ ತಂದೆ,</para>
  <para style="li1" vid="MAT 1:4">ನಹಶೋನನು ಸಲ್ಮೋನನ ತಂದೆ,<verse eid="MAT 1:4"/></para>
  <para style="li1">
    <verse number="5" style="v" sid="MAT 1:5"/>ಸಲ್ಮೋನನು ಬೋವಜನ ತಂದೆ, ಬೋವಜನ ತಾಯಿ ರಾಹಾಬಳು,</para>
  <para style="li1" vid="MAT 1:5">ಬೋವಜನು ಓಬೇದನ ತಂದೆ, ಓಬೇದನ ತಾಯಿ ರೂತಳು,</para>
  <para style="li1" vid="MAT 1:5">ಓಬೇದನು ಇಷಯನ ತಂದೆ,<verse eid="MAT 1:5"/></para>
  <para style="li1">
    <verse number="6" style="v" sid="MAT 1:6"/>ಇಷಯನು ರಾಜನಾದ ದಾವೀದನ ತಂದೆ.</para>
  <para style="b" vid="MAT 1:6"/>
  <para style="li1" vid="MAT 1:6">ದಾವೀದನು ಸೊಲೊಮೋನನ ತಂದೆ, ಇವನ ತಾಯಿ ಊರೀಯನ ಹೆಂಡತಿಯಾಗಿದ್ದವಳು,<verse eid="MAT 1:6"/></para>
  <para style="li1">
    <verse number="7" style="v" sid="MAT 1:7"/>ಸೊಲೊಮೋನನು ರೆಹಬ್ಬಾಮನ ತಂದೆ,</para>
  <para style="li1" vid="MAT 1:7">ರೆಹಬ್ಬಾಮನು ಅಬೀಯನ ತಂದೆ,</para>
  <para style="li1" vid="MAT 1:7">ಅಬೀಯನು ಆಸನ ತಂದೆ,<verse eid="MAT 1:7"/></para>
  <para style="li1">
    <verse number="8" style="v" sid="MAT 1:8"/>ಆಸನು ಯೆಹೋಷಾಫಾಟನ ತಂದೆ,</para>
  <para style="li1" vid="MAT 1:8">ಯೆಹೋಷಾಫಾಟನು ಯೆಹೋರಾಮನ ತಂದೆ,</para>
  <para style="li1" vid="MAT 1:8">ಯೆಹೋರಾಮನು ಉಜ್ಜೀಯನ ತಂದೆ,<verse eid="MAT 1:8"/></para>
  <para style="li1">
    <verse number="9" style="v" sid="MAT 1:9"/>ಉಜ್ಜೀಯನು ಯೋತಾಮನ ತಂದೆ,</para>
  <para style="li1" vid="MAT 1:9">ಯೋತಾಮನು ಆಹಾಜನ ತಂದೆ,</para>
  <para style="li1" vid="MAT 1:9">ಆಹಾಜನು ಹಿಜ್ಕೀಯನ ತಂದೆ,<verse eid="MAT 1:9"/></para>
  <para style="li1">
    <verse number="10" style="v" sid="MAT 1:10"/>ಹಿಜ್ಕೀಯನು ಮನಸ್ಸೆಯ ತಂದೆ,</para>
  <para style="li1" vid="MAT 1:10">ಮನಸ್ಸೆಯು ಆಮೋನನ ತಂದೆ,</para>
  <para style="li1" vid="MAT 1:10">ಆಮೋನನು ಯೋಷೀಯನ ತಂದೆ,<verse eid="MAT 1:10"/></para>
  <para style="li1">
    <verse number="11" style="v" sid="MAT 1:11"/>ಯೋಷೀಯನಿಗೆ ಯೆಕೊನ್ಯ<note caller="+" style="f"><char style="fr" closed="false">1:11 </char><char style="ft" closed="false">ಯೆಹೋಯಾಕೀನನು ಎಂದು ಸಹ ಕರೆಯಲಾಗುತ್ತಿತ್ತು.</char></note> ಮತ್ತು ಅವನ ಸಹೋದರರು ಹುಟ್ಟಿದರು, ಈ ಸಮಯದಲ್ಲಿಯೇ ಯೆಹೂದ್ಯರನ್ನು ಬಾಬಿಲೋನಿಗೆ ಸೆರೆ ಒಯ್ದದ್ದು.<verse eid="MAT 1:11"/></para>
  <para style="b"/>
  <para style="li4">
    <verse number="12" style="v" sid="MAT 1:12"/>ಬಾಬಿಲೋನಿಗೆ ಸೆರೆಹೋದ ಮೇಲೆ:</para>
  <para style="li1" vid="MAT 1:12">ಯೆಕೊನ್ಯನು ಶೆಯಲ್ತೀಯೇಲನನ್ನು ಪಡೆದನು,</para>
  <para style="li1" vid="MAT 1:12">ಶೆಯಲ್ತೀಯೇಲನು ಜೆರುಬ್ಬಾಬೆಲನ ತಂದೆ,<verse eid="MAT 1:12"/></para>
  <para style="li1">
    <verse number="13" style="v" sid="MAT 1:13"/>ಜೆರುಬ್ಬಾಬೆಲನು ಅಬಿಹೂದನ ತಂದೆ,</para>
  <para style="li1" vid="MAT 1:13">ಅಬಿಹೂದನು ಎಲಿಯಕೀಮನ ತಂದೆ,</para>
  <para style="li1" vid="MAT 1:13">ಎಲಿಯಕೀಮನು ಅಜೋರನ ತಂದೆ,<verse eid="MAT 1:13"/></para>
  <para style="li1">
    <verse number="14" style="v" sid="MAT 1:14"/>ಅಜೋರನು ಸದೋಕನ ತಂದೆ,</para>
  <para style="li1" vid="MAT 1:14">ಸದೋಕನು ಅಖೀಮನ ತಂದೆ,</para>
  <para style="li1" vid="MAT 1:14">ಅಖೀಮನು ಎಲಿಹೂದನ ತಂದೆ,<verse eid="MAT 1:14"/></para>
  <para style="li1">
    <verse number="15" style="v" sid="MAT 1:15"/>ಎಲಿಹೂದನು ಎಲಿಯಾಜರನ ತಂದೆ,</para>
  <para style="li1" vid="MAT 1:15">ಎಲಿಯಾಜರನು ಮತ್ತಾನನ ತಂದೆ,</para>
  <para style="li1" vid="MAT 1:15">ಮತ್ತಾನನು ಯಾಕೋಬನ ತಂದೆ,<verse eid="MAT 1:15"/></para>
  <para style="li1">
    <verse number="16" style="v" sid="MAT 1:16"/>ಯಾಕೋಬನು ಯೋಸೇಫನ ತಂದೆ, ಯೋಸೇಫನು ಮರಿಯಳ ಪತಿ, ಮರಿಯಳು ಕ್ರಿಸ್ತ ಎಂದು ಕರೆಯಲಾದ, ಯೇಸುಸ್ವಾಮಿಯ ತಾಯಿ.<verse eid="MAT 1:16"/></para>
  <para style="b"/>
  <para style="li4">
    <verse number="17" style="v" sid="MAT 1:17"/>ಈ ರೀತಿಯಲ್ಲಿ ಅಬ್ರಹಾಮನಿಂದ ದಾವೀದನವರೆಗೆ ಹದಿನಾಲ್ಕು ತಲೆಮಾರುಗಳು, ದಾವೀದನಿಂದ ಬಾಬಿಲೋನಿಗೆ ಸೆರೆ ಹೋಗುವವರೆಗೆ ಹದಿನಾಲ್ಕು ತಲೆಮಾರುಗಳು, ಬಾಬಿಲೋನಿಗೆ ಸೆರೆಹೋದ ದಿನದಿಂದ ಕ್ರಿಸ್ತರವರೆಗೆ ಹದಿನಾಲ್ಕು ತಲೆಮಾರುಗಳು.<verse eid="MAT 1:17"/></para>
  <para style="s1">ಕ್ರಿಸ್ತ ಯೇಸುವಿನ ಜನನ</para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 1:18"/>ಕ್ರಿಸ್ತ ಯೇಸುವಿನ ಜನನದ ವಿವರ: ಯೇಸುವಿನ ತಾಯಿ ಮರಿಯಳನ್ನು ಯೋಸೇಫನಿಗೆ ನಿಶ್ಚಯ ಮಾಡಿದ್ದರು, ಆದರೆ ಅವರಿಬ್ಬರು ಕೂಡಿಬಾಳುವುದಕ್ಕಿಂತ ಮುಂಚೆಯೇ, ಮರಿಯಳು ಪವಿತ್ರಾತ್ಮರಿಂದ ಗರ್ಭಧರಿಸಿರುವುದು ತಿಳಿದುಬಂತು. <verse eid="MAT 1:18"/><verse number="19" style="v" sid="MAT 1:19"/>ಯೋಸೇಫನು ನೀತಿವಂತನಾಗಿದ್ದರಿಂದ, ಆಕೆಯನ್ನು ಬಹಿರಂಗವಾಗಿ ಅವಮಾನ ಮಾಡುವುದಕ್ಕೆ ಮನಸ್ಸಿಲ್ಲದೆ, ಆಕೆಯನ್ನು ರಹಸ್ಯವಾಗಿ ಬಿಟ್ಟು ಬಿಡಬೇಕೆಂದಿದ್ದನು.<verse eid="MAT 1:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 1:20"/>ಅವನು ಹೀಗೆ ಯೋಚಿಸುತ್ತಿದ್ದಾಗ, ಕರ್ತನ ದೂತನು ಕನಸಿನಲ್ಲಿ ಅವನಿಗೆ ಪ್ರತ್ಯಕ್ಷನಾಗಿ, “ದಾವೀದನ ವಂಶದ ಯೋಸೇಫನೇ, ಮರಿಯಳನ್ನು ನಿನ್ನ ಹೆಂಡತಿಯನ್ನಾಗಿ ಸ್ವೀಕರಿಸಲು ಅಂಜಬೇಡ. ಆಕೆ ಗರ್ಭವತಿಯಾಗಿರುವುದು ಪವಿತ್ರಾತ್ಮರಿಂದಲೇ. <verse eid="MAT 1:20"/><verse number="21" style="v" sid="MAT 1:21"/>ಅವಳು ಒಬ್ಬ ಮಗನನ್ನು ಹೆರುವಳು, ನೀನು ಆತನಿಗೆ, ‘ಯೇಸು<note caller="+" style="f"><char style="fr" closed="false">1:21 </char><char style="fq" closed="false">ಯೇಸು </char><char style="ft" closed="false">ಎಂಬುದು ಗ್ರೀಕ್ ರೂಪವಾದ </char><char style="fqa" closed="false">ಯೆಹೋಶುವಾ </char><char style="ft" closed="false">ಇದರ ಅರ್ಥ </char><char style="fqa" closed="false">ಯೆಹೋವ ದೇವರು ರಕ್ಷಿಸುವರು</char></note>’ ಎಂದು ಹೆಸರಿಡಬೇಕು. ಏಕೆಂದರೆ ಅವರೇ ತಮ್ಮ ಜನರನ್ನು ಅವರ ಪಾಪಗಳಿಂದ ರಕ್ಷಿಸುವರು,” ಎಂದು ಹೇಳಿದನು.<verse eid="MAT 1:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 1:22"/>ದೇವರು ತಮ್ಮ ಪ್ರವಾದಿಯ ಮುಖಾಂತರ ಹೇಳಿದ ಈ ಮಾತು ನೆರವೇರುವಂತೆ ಇದೆಲ್ಲಾ ನಡೆಯಿತು: <verse eid="MAT 1:22"/><verse number="23" style="v" sid="MAT 1:23"/>“ಇಗೋ ಒಬ್ಬ ಕನ್ನಿಕೆಯು ಗರ್ಭಿಣಿಯಾಗಿ ಮಗನನ್ನು ಹೆರುವಳು, ಆ ಮಗುವಿಗೆ, ‘ಇಮ್ಮಾನುಯೇಲ್’<note caller="+" style="f"><char style="fr" closed="false">1:23 </char><char style="ft" closed="false"><char style="xt"><ref loc="ISA 7:14">ಯೆಶಾಯ 7:14</ref></char></char></note> ಎಂದು ಹೆಸರಿಡುವರು.” ಈ ಹೆಸರಿನ ಅರ್ಥ, “ದೇವರು ನಮ್ಮ ಸಂಗಡ ಇದ್ದಾರೆ,” ಎಂಬುದು.<verse eid="MAT 1:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 1:24"/>ಯೋಸೇಫನು ನಿದ್ದೆಯಿಂದ ಎದ್ದ ಮೇಲೆ, ಕರ್ತನ ದೂತನು ಆಜ್ಞಾಪಿಸಿದಂತೆ ಮರಿಯಳನ್ನು ತನ್ನ ಹೆಂಡತಿಯನ್ನಾಗಿ ಸ್ವೀಕರಿಸಿಕೊಂಡನು. <verse eid="MAT 1:24"/><verse number="25" style="v" sid="MAT 1:25"/>ಆದರೆ ಅವಳು ಮಗನನ್ನು ಹೆರುವತನಕ ಯೋಸೇಫನು ಆಕೆಯೊಂದಿಗೆ ದಾಂಪತ್ಯ ಜೀವನ ಮಾಡಲಿಲ್ಲ. ಯೋಸೇಫನು ಆ ಮಗುವಿಗೆ “ಯೇಸು” ಎಂದು ಹೆಸರಿಟ್ಟನು.<verse eid="MAT 1:25"/></para>
  <chapter eid="MAT 1"/>
  <chapter number="2" style="c" sid="MAT 2"/>
  <para style="s1">ಪೂರ್ವದೇಶದ ಜ್ಞಾನಿಗಳ ಭೇಟಿ</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 2:1"/>ಹೆರೋದ ರಾಜನ ಕಾಲದಲ್ಲಿ, ಯೂದಾಯದ ಬೇತ್ಲೆಹೇಮಿನಲ್ಲಿ ಯೇಸು ಜನಿಸಿದಾಗ, ಪೂರ್ವ ದೇಶದಿಂದ ಜ್ಞಾನಿಗಳು ಯೆರೂಸಲೇಮಿಗೆ ಬಂದು, <verse eid="MAT 2:1"/><verse number="2" style="v" sid="MAT 2:2"/>“ಯೆಹೂದ್ಯರ ಅರಸರಾಗಿ ಹುಟ್ಟಿದವರು ಎಲ್ಲಿ? ನಾವು ಅವರನ್ನು ಸೂಚಿಸುವ ನಕ್ಷತ್ರವನ್ನು ಪೂರ್ವದೇಶದಲ್ಲಿ ಕಂಡು ಅವರನ್ನು ಆರಾಧಿಸಲು ಬಂದಿದ್ದೇವೆ,” ಎಂದರು.<verse eid="MAT 2:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 2:3"/>ಇದನ್ನು ಕೇಳಿ ಹೆರೋದ ರಾಜನು ಮತ್ತು ಯೆರೂಸಲೇಮಿನ ಜನರೆಲ್ಲರು ಕಳವಳಗೊಂಡರು. <verse eid="MAT 2:3"/><verse number="4" style="v" sid="MAT 2:4"/>ರಾಜನು ಯೆಹೂದ್ಯರ ಮುಖ್ಯಯಾಜಕರನ್ನೂ ನಿಯಮ ಬೋಧಕರನ್ನೂ ಕರೆದು, “ಕ್ರಿಸ್ತನು ಹುಟ್ಟಬೇಕಾದದ್ದು ಎಲ್ಲಿ?” ಎಂದು ಅವರನ್ನು ವಿಚಾರಿಸಿದನು. <verse eid="MAT 2:4"/><verse number="5" style="v" sid="MAT 2:5"/>ಅದಕ್ಕೆ ಅವರು, “ಯೂದಾಯ ಪ್ರಾಂತದ ಬೇತ್ಲೆಹೇಮಿನಲ್ಲಿಯೇ,” ಏಕೆಂದರೆ, ಪ್ರವಾದಿಯು ಬರೆದಿರುವದು ಈ ರೀತಿಯಾಗಿದೆ:<verse eid="MAT 2:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="MAT 2:6"/>“ ‘ಯೆಹೂದ ಪ್ರಾಂತದಲ್ಲಿರುವ ಬೇತ್ಲೆಹೇಮೇ,</para>
  <para style="q2" vid="MAT 2:6">ಯೆಹೂದದ ಅಧಿಪತಿಗಳಲ್ಲಿ ನೀನು ಎಷ್ಟು ಮಾತ್ರಕ್ಕೂ ಅಲ್ಪವಲ್ಲ.</para>
  <para style="q1" vid="MAT 2:6">ಏಕೆಂದರೆ ನನ್ನ ಪ್ರಜೆಗಳಾದ ಇಸ್ರಾಯೇಲನ್ನು</para>
  <para style="q2" vid="MAT 2:6">ಪರಿಪಾಲಿಸಲು ಒಬ್ಬ ಅಧಿಪತಿಯು ನಿನ್ನೊಳಗಿಂದಲೇ ಬರುವನು,’<note caller="+" style="f"><char style="fr" closed="false">2:6 </char><char style="ft" closed="false"><char style="xt"><ref loc="MIC 5:2">ಮೀಕ 5:2</ref>,<ref loc="MIC 5:4">4</ref></char></char></note>”</para>
  <para style="m" vid="MAT 2:6">ಎಂದು ಹೇಳಿದರು.<verse eid="MAT 2:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 2:7"/>ಆಗ ಹೆರೋದನು ಆ ಜ್ಞಾನಿಗಳನ್ನು ರಹಸ್ಯವಾಗಿ ಕರೆದು, ಆ ನಕ್ಷತ್ರ ಕಾಣಿಸಿಕೊಂಡ ಕಾಲವನ್ನು ಸೂಕ್ಷ್ಮವಾಗಿ ವಿಚಾರಿಸಿದನು. <verse eid="MAT 2:7"/><verse number="8" style="v" sid="MAT 2:8"/>“ನೀವು ಹೋಗಿ ಆ ಮಗುವಿನ ವಿಷಯ ಜಾಗರೂಕತೆಯಿಂದ ವಿಚಾರಿಸಿ. ಆ ಮಗು ಸಿಕ್ಕಿದ ಮೇಲೆ ನನಗೆ ತಿಳಿಸಿರಿ, ಆಗ ನಾನೂ ಬಂದು ಅದನ್ನು ಆರಾಧಿಸುವೆನು,” ಎಂದು ಹೇಳಿ ಅವರನ್ನು ಬೇತ್ಲೆಹೇಮಿಗೆ ಕಳುಹಿಸಿದನು.<verse eid="MAT 2:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 2:9"/>ರಾಜನ ಮಾತನ್ನು ಕೇಳಿ ಅವರು ಹೊರಟಾಗ, ಪೂರ್ವದೇಶದಲ್ಲಿ ಅವರು ಕಂಡ ನಕ್ಷತ್ರವು ಪುನಃ ಕಾಣಿಸಿಕೊಂಡು, ಅವರ ಮುಂದೆ ಮುಂದೆ ಸಾಗುತ್ತಾ, ಆ ಮಗು ಇದ್ದ ಸ್ಥಳದ ಮೇಲೆ ಬಂದು ನಿಂತಿತು. <verse eid="MAT 2:9"/><verse number="10" style="v" sid="MAT 2:10"/>ಅವರು ನಕ್ಷತ್ರವನ್ನು ಕಂಡು, ಬಹಳವಾಗಿ ಸಂತೋಷಪಟ್ಟರು. <verse eid="MAT 2:10"/><verse number="11" style="v" sid="MAT 2:11"/>ಜ್ಞಾನಿಗಳು ಮನೆಯನ್ನು ಪ್ರವೇಶಿಸಿ, ಮಗುವನ್ನು ತಾಯಿ ಮರಿಯಳ ಬಳಿ ಕಂಡು, ಮಗುವಿಗೆ ಅಡ್ಡಬಿದ್ದು ಆರಾಧಿಸಿದರು. ತಮ್ಮ ಬೊಕ್ಕಸಗಳನ್ನು ತೆರೆದು ಮಗುವಿಗೆ ಚಿನ್ನ, ಧೂಪ ಮತ್ತು ರಕ್ತಬೋಳಗಳನ್ನು<note caller="+" style="f"><char style="fr" closed="false">2:11 </char><char style="fq" closed="false">ರಕ್ತಬೋಳ </char><char style="ft" closed="false">ಒಂದು ವಿಧವಾದ ಅರಬ್ ದೇಶದ </char><char style="fqa" closed="false">ಮರದ ರಸಗಂಧ</char></note> ಕಾಣಿಕೆಯಾಗಿ ಸಮರ್ಪಿಸಿದರು. <verse eid="MAT 2:11"/><verse number="12" style="v" sid="MAT 2:12"/>ಅನಂತರ ಅವರು ಕನಸಿನಲ್ಲಿ ಹೆರೋದನ ಬಳಿಗೆ ಹಿಂತಿರುಗಬಾರದೆಂಬ ಎಚ್ಚರಿಕೆಯನ್ನು ಹೊಂದಿದ್ದರಿಂದ, ಬೇರೆ ದಾರಿಯಿಂದ ತಮ್ಮ ದೇಶಕ್ಕೆ ಹೊರಟು ಹೋದರು.<verse eid="MAT 2:12"/></para>
  <para style="s1">ಈಜಿಪ್ಟಿಗೆ ಪಲಾಯನ</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 2:13"/>ಆ ಜ್ಞಾನಿಗಳು ಹೊರಟುಹೋದ ಮೇಲೆ, ಕರ್ತನ ದೂತನು ಯೋಸೇಫನಿಗೆ ಕನಸಿನಲ್ಲಿ ಪ್ರತ್ಯಕ್ಷನಾಗಿ, “ಎದ್ದೇಳು, ಮಗುವನ್ನೂ ತಾಯಿಯನ್ನೂ ಕರೆದುಕೊಂಡು ಈಜಿಪ್ಟಿಗೆ ಓಡಿಹೋಗು. ನಾನು ನಿನಗೆ ತಿಳಿಸುವವರೆಗೆ ಅಲ್ಲಿಯೇ ಇರು, ಏಕೆಂದರೆ ಹೆರೋದನು ಮಗುವನ್ನು ಹುಡುಕಿ ಕೊಲ್ಲಬೇಕೆಂದಿದ್ದಾನೆ,” ಎಂದನು.<verse eid="MAT 2:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 2:14"/>ಆಗ ಯೋಸೇಫನು ಎದ್ದು, ಆ ಮಗುವನ್ನೂ ತಾಯಿಯನ್ನೂ ಕರೆದುಕೊಂಡು ಅದೇ ರಾತ್ರಿ ಈಜಿಪ್ಟಿಗೆ ಹೊರಟುಹೋದನು. <verse eid="MAT 2:14"/><verse number="15" style="v" sid="MAT 2:15"/>ಹೀಗೆ ಹೆರೋದನು ಸಾಯುವವರೆಗೆ ಯೋಸೇಫನು ಅಲ್ಲೇ ಇದ್ದನು. ಕರ್ತನು ತನ್ನ ಪ್ರವಾದಿಯ ಮೂಲಕ: “ಈಜಿಪ್ಟಿನಿಂದ ನನ್ನ ಮಗನನ್ನು ನಾನು ಕರೆದೆನು,”<note caller="+" style="f"><char style="fr" closed="false">2:15 </char><char style="ft" closed="false"><char style="xt"><ref loc="HOS 11:1">ಹೋಶೇ 11:1</ref></char></char></note> ಎಂದು ಹೇಳಿದ ಮಾತು ಇದರಿಂದ ನೆರವೇರಿತು.<verse eid="MAT 2:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 2:16"/>ಜ್ಞಾನಿಗಳು ತನಗೆ ಮೋಸಮಾಡಿದರೆಂದು ತಿಳಿದ ಹೆರೋದನು ಬಹಳ ಕೋಪಗೊಂಡನು, ಜ್ಞಾನಿಗಳಿಂದ ಸೂಕ್ಷ್ಮವಾಗಿ ವಿಚಾರಿಸಿಕೊಂಡ ಪ್ರಕಾರವೇ, ಬೇತ್ಲೆಹೇಮ್ ಮತ್ತು ಅದರ ಸುತ್ತಮುತ್ತಲ ಪ್ರದೇಶದಲ್ಲಿದ್ದ ಎರಡು ವರ್ಷದೊಳಗಿನ ಎಲ್ಲಾ ಗಂಡು ಮಕ್ಕಳನ್ನು ಕೊಂದುಹಾಕಿಸಿದನು. <verse eid="MAT 2:16"/><verse number="17" style="v" sid="MAT 2:17"/>ಪ್ರವಾದಿಯಾದ ಯೆರೆಮೀಯನ ಮೂಲಕ ಹೇಳಿದ ಮಾತು ನೆರವೇರಿತು:<verse eid="MAT 2:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="MAT 2:18"/>“ರಾಮದಲ್ಲಿ ರೋದನೆಯು ಕೇಳಿಸಿತು,</para>
  <para style="q2" vid="MAT 2:18">ಗೋಳಾಟವೂ ಮಹಾ ಪ್ರಲಾಪವೂ ಕೇಳಿಬಂತು.</para>
  <para style="q1" vid="MAT 2:18">ರಾಹೇಲಳು ತನ್ನ ಮಕ್ಕಳಿಗಾಗಿ ಗೋಳಾಡುತ್ತಾ,</para>
  <para style="q2" vid="MAT 2:18">ಆದರಣೆ ಹೊಂದದೆ ಹೋಗಿದ್ದಾಳೆ.</para>
  <para style="q2" vid="MAT 2:18">ಏಕೆಂದರೆ ಅವಳ ಮಕ್ಕಳು ಇನ್ನಿಲ್ಲ.”<note caller="+" style="f"><char style="fr" closed="false">2:18 </char><char style="ft" closed="false"><char style="xt"><ref loc="JER 31:15">ಯೆರೆ 31:15</ref></char></char></note><verse eid="MAT 2:18"/></para>
  <para style="s1">ನಜರೇತಿಗೆ ಹಿಂದಿರುಗುವಿಕೆ</para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 2:19"/>ಹೆರೋದನು ಸತ್ತಮೇಲೆ ಈಜಿಪ್ಟಿನಲ್ಲಿದ್ದ ಯೋಸೇಫನಿಗೆ ಕರ್ತನ ದೂತನು ಕನಸಿನಲ್ಲಿ ಕಾಣಿಸಿಕೊಂಡು, <verse eid="MAT 2:19"/><verse number="20" style="v" sid="MAT 2:20"/>“ಎದ್ದೇಳು, ಮಗುವನ್ನೂ ತಾಯಿಯನ್ನೂ ಕರೆದುಕೊಂಡು ಇಸ್ರಾಯೇಲ್ ದೇಶಕ್ಕೆ ಹಿಂದಿರುಗು, ಮಗುವಿನ ಪ್ರಾಣ ತೆಗೆಯಬೇಕೆಂದಿದ್ದವರು ಸತ್ತುಹೋದರು,” ಎಂದು ಹೇಳಿದನು.<verse eid="MAT 2:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 2:21"/>ಆಗ ಅವನು ಎದ್ದು ಮಗುವನ್ನೂ ತಾಯಿಯನ್ನೂ ಕರೆದುಕೊಂಡು ಇಸ್ರಾಯೇಲ್ ದೇಶಕ್ಕೆ ಬಂದನು. <verse eid="MAT 2:21"/><verse number="22" style="v" sid="MAT 2:22"/>ಆದರೆ ಹೆರೋದನ ಮಗ ಅರ್ಖೆಲಾಯನು, ತಂದೆಯ ಬದಲಾಗಿ ಯೂದಾಯ ಪ್ರಾಂತವನ್ನು ಆಳುತ್ತಿದ್ದಾನೆಂದು ಕೇಳಿ, ಅಲ್ಲಿಗೆ ಹೋಗಲು ಭಯಪಟ್ಟನು. ಆಗ ಕನಸಿನಲ್ಲಿ ಹೊಂದಿದ ಎಚ್ಚರಿಕೆಯ ಪ್ರಕಾರ ಯೋಸೇಫನು ಗಲಿಲಾಯ ಪ್ರಾಂತಕ್ಕೆ ಹೋದನು. <verse eid="MAT 2:22"/><verse number="23" style="v" sid="MAT 2:23"/>ಅಲ್ಲಿ ನಜರೇತ್ ಎಂಬ ಊರಲ್ಲಿ ವಾಸಮಾಡಿದನು. ಹೀಗೆ, “ನಜರಾಯನೆಂಬ ಹೆಸರು ಯೇಸುವಿಗೆ ಬರುವುದು,” ಎಂದು ಪ್ರವಾದಿಗಳು ಹೇಳಿದ ಮಾತು ನೆರವೇರಿತು.<verse eid="MAT 2:23"/></para>
  <chapter eid="MAT 2"/>
  <chapter number="3" style="c" sid="MAT 3"/>
  <para style="s1">ಸ್ನಾನಿಕ ಯೋಹಾನನು ಮಾರ್ಗ ಸಿದ್ಧಮಾಡಿದ್ದು</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 3:1"/>ಆ ದಿನಗಳಲ್ಲಿ ಸ್ನಾನಿಕನಾದ ಯೋಹಾನನು ಯೂದಾಯ ಪ್ರಾಂತದ ಅರಣ್ಯಕ್ಕೆ ಬಂದು, <verse eid="MAT 3:1"/><verse number="2" style="v" sid="MAT 3:2"/>“ದೇವರ ಕಡೆಗೆ ತಿರುಗಿಕೊಳ್ಳಿರಿ, ಪರಲೋಕ ರಾಜ್ಯವು ಸಮೀಪಿಸಿದೆ,” ಎಂದು ಸಾರುತ್ತಿದ್ದನು.<verse eid="MAT 3:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="MAT 3:3"/>“ ‘ಕರ್ತದೇವರ ಮಾರ್ಗವನ್ನು ಸಿದ್ಧಮಾಡಿರಿ,</para>
  <para style="q2" vid="MAT 3:3">ಅವರ ದಾರಿಗಳನ್ನು ಸರಾಗಮಾಡಿರಿ,’</para>
  <para style="q1" vid="MAT 3:3">ಎಂದು ಅರಣ್ಯದಲ್ಲಿ ಕೂಗುವ ಸ್ವರವು,”<note caller="+" style="f"><char style="fr" closed="false">3:3 </char><char style="ft" closed="false"><char style="xt"><ref loc="ISA 40:3">ಯೆಶಾಯ 40:3</ref></char></char></note></para>
  <para style="m" vid="MAT 3:3">ಎಂದು ಪ್ರವಾದಿಯಾದ ಯೆಶಾಯನ ಮೂಲಕ ಸೂಚಿತನಾದವನು ಇವನೇ.<verse eid="MAT 3:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 3:4"/>ಯೋಹಾನನ ಉಡುಪು ಒಂಟೆಯ ಕೂದಲಿನಿಂದ ಮಾಡಲಾಗಿತ್ತು. ಅವನು ಸೊಂಟಕ್ಕೆ ಚರ್ಮದ ನಡುಕಟ್ಟನ್ನು ಕಟ್ಟಿಕೊಳ್ಳುತ್ತಿದ್ದನು<note caller="+" style="f"><char style="fr" closed="false">3:4 </char><char style="ft" closed="false">ನೋಡಿರಿ <char style="xt"><ref loc="2KI 1:8">2 ಅರಸು 1:8</ref></char> ವಚನದಲ್ಲಿ ಪ್ರವಾದಿ ಎಲೀಯನ ಉಡುಪು ಹಾಗು <char style="xt"><ref loc="ZEC 13:4">ಜೆಕರ್ಯ 13:4</ref></char></char></note>. ಮಿಡತೆಗಳು ಮತ್ತು ಕಾಡುಜೇನು ಅವನ ಆಹಾರವಾಗಿತ್ತು. <verse eid="MAT 3:4"/><verse number="5" style="v" sid="MAT 3:5"/>ಯೆರೂಸಲೇಮಿನಿಂದಲೂ ಯೂದಾಯ ಪ್ರಾಂತದ ಎಲ್ಲಾ ಸ್ಥಳಗಳಿಂದಲೂ ಯೊರ್ದನ್ ನದಿ ಸುತ್ತಲಿರುವ ಪ್ರದೇಶದಿಂದಲೂ ಜನರು ಅವನ ಬಳಿಗೆ ಬರುತ್ತಿದ್ದರು. <verse eid="MAT 3:5"/><verse number="6" style="v" sid="MAT 3:6"/>ಅವರು ತಮ್ಮ ತಮ್ಮ ಪಾಪಗಳನ್ನು ಅರಿಕೆಮಾಡುತ್ತಾ, ಅವನಿಂದ ಯೊರ್ದನ್ ನದಿಯಲ್ಲಿ ದೀಕ್ಷಾಸ್ನಾನ ಮಾಡಿಸಿಕೊಳ್ಳುತ್ತಿದ್ದರು.<verse eid="MAT 3:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 3:7"/>ಆದರೆ ಫರಿಸಾಯರು<note caller="+" style="f"><char style="fr" closed="false">3:7 </char><char style="ft" closed="false">ಫರಿಸಾಯರು ಅಂದರೆ ಯೆಹೂದ್ಯರಲ್ಲಿ ಕಟ್ಟುನಿಟ್ಟಾದ ಧಾರ್ಮಿಕ ಪಂಗಡದವರು</char></note> ಹಾಗೂ ಸದ್ದುಕಾಯರಲ್ಲಿ<note caller="+" style="f"><char style="fr" closed="false">3:7 </char><char style="ft" closed="false">ಸದ್ದುಕಾಯರು ಅಂದರೆ ಯೆಹೂದ್ಯರಲ್ಲಿ ಅದ್ಭುತ ಅನುಭವಗಳನ್ನು ನಂಬದ ಪಂಗಡದವರು. ಉದಾಹರಣೆ: ಮರಣದ ನಂತರ ಜೀವಿತ, ದೇವದೂತರು</char></note> ಅನೇಕರು ದೀಕ್ಷಾಸ್ನಾನಕ್ಕಾಗಿ ಬರುವುದನ್ನು ಕಂಡು, ಯೋಹಾನನು ಅವರಿಗೆ: “ಎಲೈ ಸರ್ಪಸಂತತಿಯವರೇ! ಮುಂದೆ ಬರುವ ಕೋಪಾಗ್ನಿಯಿಂದ ತಪ್ಪಿಸಿಕೊಳ್ಳಲು ನಿಮ್ಮನ್ನು ಎಚ್ಚರಿಸಿದವರು ಯಾರು? <verse eid="MAT 3:7"/><verse number="8" style="v" sid="MAT 3:8"/>ನಿಮ್ಮ ಮನಸ್ಸು ದೇವರ ಕಡೆಗೆ ತಿರುಗಿಕೊಂಡದ್ದಕ್ಕೆ ತಕ್ಕ ಫಲಗಳನ್ನು ತೋರಿಸಿರಿ. <verse eid="MAT 3:8"/><verse number="9" style="v" sid="MAT 3:9"/>‘ಅಬ್ರಹಾಮನು ನಮಗೆ ತಂದೆಯಾಗಿದ್ದಾನೆ,’ ಎಂದು ನಿಮ್ಮೊಳಗೆ ಕೊಚ್ಚಿಕೊಳ್ಳಬೇಡಿರಿ. ಈ ಕಲ್ಲುಗಳಿಂದಲೂ ದೇವರು ಅಬ್ರಹಾಮನಿಗೆ ಮಕ್ಕಳನ್ನು ಹುಟ್ಟಿಸಲು ಶಕ್ತರೆಂದು ನಾನು ನಿಮಗೆ ಹೇಳುತ್ತೇನೆ. <verse eid="MAT 3:9"/><verse number="10" style="v" sid="MAT 3:10"/>ಮರಗಳ ಬೇರಿಗೆ ಈಗಾಗಲೇ ಕೊಡಲಿ ಬಿದ್ದಿದೆ, ಒಳ್ಳೆಯ ಫಲವನ್ನು ಕೊಡದ ಪ್ರತಿಯೊಂದು ಮರವನ್ನು ಕಡಿದು ಬೆಂಕಿಯಲ್ಲಿ ಹಾಕಲಾಗುವುದು.<verse eid="MAT 3:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 3:11"/>“ನಾನಂತೂ ದೇವರ ಕಡೆಗೆ ತಿರುಗಿಕೊಂಡಿದ್ದಕ್ಕಾಗಿ ನಿಮಗೆ ನೀರಿನಿಂದ ದೀಕ್ಷಾಸ್ನಾನ ಕೊಡುತ್ತಿದ್ದೇನೆ. ಆದರೆ ನನ್ನ ಬಳಿಕ ಬರುವವರು ನನಗಿಂತಲೂ ಶಕ್ತರು, ಅವರ ಪಾದರಕ್ಷೆಗಳನ್ನು ಹೊರಲಿಕ್ಕೂ<note caller="+" style="f"><char style="fr" closed="false">3:11 </char><char style="ft" closed="false">ಅಂದರೆ, </char><char style="fqa" closed="false">ಗುಲಾಮನಾಗಿರುವುದಕ್ಕೂ</char></note> ನಾನು ಯೋಗ್ಯನಲ್ಲ. ಅವರಾದರೋ ಪವಿತ್ರಾತ್ಮರಲ್ಲಿಯೂ ಅಗ್ನಿಯಲ್ಲಿಯೂ ನಿಮಗೆ ದೀಕ್ಷಾಸ್ನಾನ ಕೊಡುವರು. <verse eid="MAT 3:11"/><verse number="12" style="v" sid="MAT 3:12"/>ಮೊರವು ಅವರ ಕೈಯಲ್ಲಿದೆ, ಅವರು ತಮ್ಮ ಕಣದಲ್ಲಿಯ ರಾಶಿಯನ್ನು ತೂರಿ ಶುದ್ಧಮಾಡಿ ಗೋಧಿಯನ್ನು ಕಣಜದಲ್ಲಿ ತುಂಬಿಕೊಂಡು, ಹೊಟ್ಟನ್ನು ಆರಿಸಲಾಗದ ಬೆಂಕಿಯಲ್ಲಿ ಸುಟ್ಟುಹಾಕುವರು,” ಎಂದು ಹೇಳಿದನು.<verse eid="MAT 3:12"/></para>
  <para style="s1">ಯೇಸುವಿನ ದೀಕ್ಷಾಸ್ನಾನ</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 3:13"/>ಆಮೇಲೆ ಯೇಸು ಯೋಹಾನನಿಂದ ದೀಕ್ಷಾಸ್ನಾನ ಪಡೆಯಲು ಗಲಿಲಾಯದಿಂದ ಯೊರ್ದನ್ ನದಿಗೆ ಬಂದರು. <verse eid="MAT 3:13"/><verse number="14" style="v" sid="MAT 3:14"/>ಆದರೆ ಯೋಹಾನನು ಅದಕ್ಕೆ ಅಡ್ಡಿ ಮಾಡುತ್ತಾ, “ನಾನೇ ನಿಮ್ಮಿಂದ ದೀಕ್ಷಾಸ್ನಾನ ಪಡೆಯಬೇಕಾಗಿರುವಲ್ಲಿ, ನೀವು ನನ್ನ ಬಳಿಗೆ ಬರಬಹುದೇ?” ಎಂದು ಕೇಳಿದನು.<verse eid="MAT 3:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 3:15"/>ಯೇಸು ಉತ್ತರವಾಗಿ, “ಸದ್ಯಕ್ಕೆ ಒಪ್ಪಿಕೋ, ಹೀಗೆ ನಾವು ಸಕಲ ನೀತಿಯನ್ನೂ ನೆರವೇರಿಸಬೇಕಾಗಿದೆ,” ಎಂದು ಹೇಳಿದಾಗ, ಯೋಹಾನನು ಒಪ್ಪಿಕೊಂಡನು.<verse eid="MAT 3:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 3:16"/>ಯೇಸು ದೀಕ್ಷಾಸ್ನಾನ ಪಡೆದುಕೊಂಡು ನೀರಿನಿಂದ ಮೇಲಕ್ಕೆ ಬಂದ ಕೂಡಲೇ, ಸ್ವರ್ಗವು ತೆರೆಯಿತು, ದೇವರ ಆತ್ಮ ಪಾರಿವಾಳದ ಹಾಗೆ ತಮ್ಮ ಮೇಲೆ ಇಳಿದು ಬರುವುದನ್ನು ಯೇಸು ಕಂಡರು. <verse eid="MAT 3:16"/><verse number="17" style="v" sid="MAT 3:17"/>ಸ್ವರ್ಗದೊಳಗಿಂದ, “ಈತನು ನನ್ನ ಪ್ರಿಯ ಮಗನು. ಈತನನ್ನು ನಾನು ಮೆಚ್ಚಿದ್ದೇನೆ,” ಎಂಬ ಧ್ವನಿ ಕೇಳಿಸಿತು.<verse eid="MAT 3:17"/></para>
  <chapter eid="MAT 3"/>
  <chapter number="4" style="c" sid="MAT 4"/>
  <para style="s1">ಯೇಸುವಿನ ಶೋಧನೆ</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 4:1"/>ಆಮೇಲೆ ಸೈತಾನನಿಂದ ಶೋಧಿತರಾಗಲೆಂದು ಪವಿತ್ರಾತ್ಮರು ಯೇಸುವನ್ನು ಅರಣ್ಯಕ್ಕೆ ನಡೆಸಿದರು. <verse eid="MAT 4:1"/><verse number="2" style="v" sid="MAT 4:2"/>ನಲವತ್ತು ದಿನ ಹಗಲೂ ರಾತ್ರಿ ಉಪವಾಸವಿದ್ದ ಮೇಲೆ ಯೇಸುವಿಗೆ ಹಸಿವಾಯಿತು. <verse eid="MAT 4:2"/><verse number="3" style="v" sid="MAT 4:3"/>ಆಗ ಶೋಧಕನು ಯೇಸುವಿನ ಬಳಿ ಬಂದು, “ನೀನು ದೇವರ ಪುತ್ರನಾಗಿದ್ದರೆ, ಈ ಕಲ್ಲುಗಳು ರೊಟ್ಟಿಗಳಾಗುವಂತೆ ಆಜ್ಞಾಪಿಸು,” ಎಂದನು.<verse eid="MAT 4:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 4:4"/>ಅದಕ್ಕೆ ಯೇಸು, “ಪವಿತ್ರ ವೇದದಲ್ಲಿ ಬರೆದಿರುವ ಪ್ರಕಾರ, ‘ಮನುಷ್ಯನು ಜೀವಿಸುವುದು ರೊಟ್ಟಿಯಿಂದ ಮಾತ್ರವಲ್ಲ, ದೇವರ ಬಾಯಿಂದ ಹೊರಡುವ ಪ್ರತಿಯೊಂದು ಮಾತಿನಿಂದಲೂ ಜೀವಿಸುತ್ತಾನೆ,’<note caller="+" style="f"><char style="fr" closed="false">4:4 </char><char style="ft" closed="false"><char style="xt"><ref loc="DEU 8:3">ಧರ್ಮೋ 8:3</ref></char></char></note>” ಎಂದರು.<verse eid="MAT 4:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 4:5"/>ಆಮೇಲೆ ಸೈತಾನನು ಯೇಸುವನ್ನು ಪವಿತ್ರ ನಗರಕ್ಕೆ ಕರೆದುಕೊಂಡು ಹೋಗಿ ದೇವಾಲಯದ ಅತಿ ಎತ್ತರವಾದ ಶಿಖರದ ಮೇಲೆ ನಿಲ್ಲಿಸಿ, <verse eid="MAT 4:5"/><verse number="6" style="v" sid="MAT 4:6"/>“ನೀನು ದೇವರ ಪುತ್ರನಾಗಿದ್ದರೆ, ಕೆಳಕ್ಕೆ ಧುಮುಕು. ಪವಿತ್ರ ವೇದದಲ್ಲಿ ಬರೆದಿರುವ ಪ್ರಕಾರ:</para>
  <para style="q1" vid="MAT 4:6">“ ‘ದೇವರು ನಿನ್ನ ವಿಷಯವಾಗಿ ತಮ್ಮ ದೂತರಿಗೆ ಆಜ್ಞಾಪಿಸುವರು,</para>
  <para style="q2" vid="MAT 4:6">ನಿನ್ನ ಪಾದಗಳು ಕಲ್ಲಿಗೆ ತಗಲದಂತೆ</para>
  <para style="q2" vid="MAT 4:6">ದೂತರು ನಿನ್ನನ್ನು ತಮ್ಮ ಕೈಗಳಲ್ಲಿ ಎತ್ತಿಕೊಳ್ಳುವರು,’<note caller="+" style="f"><char style="fr" closed="false">4:6 </char><char style="ft" closed="false"><char style="xt"><ref loc="PSA 91:11">ಕೀರ್ತನೆ 91:11</ref>,<ref loc="PSA 91:12">12</ref></char></char></note>”</para>
  <para style="m" vid="MAT 4:6">ಎಂದನು.<verse eid="MAT 4:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 4:7"/>ಅದಕ್ಕೆ ಯೇಸು, “ ‘ನಿನ್ನ ದೇವರಾದ ಕರ್ತದೇವರನ್ನು ಪರೀಕ್ಷಿಸಬಾರದು’<note caller="+" style="f"><char style="fr" closed="false">4:7 </char><char style="ft" closed="false"><char style="xt"><ref loc="DEU 6:16">ಧರ್ಮೋ 6:16</ref></char></char></note> ಎಂಬುದನ್ನು ಸಹ ಪವಿತ್ರ ವೇದದಲ್ಲಿ ಬರೆದಿದೆ,” ಎಂದರು.<verse eid="MAT 4:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 4:8"/>ಅನಂತರ ಸೈತಾನನು ಯೇಸುವನ್ನು ಬಹಳ ಎತ್ತರವಾದ ಪರ್ವತಕ್ಕೆ ಕರೆದುಕೊಂಡು ಹೋಗಿ, ಲೋಕದ ಎಲ್ಲಾ ರಾಜ್ಯಗಳನ್ನೂ ಅವುಗಳ ಮಹಿಮೆಯನ್ನೂ ಅವರಿಗೆ ತೋರಿಸಿ, <verse eid="MAT 4:8"/><verse number="9" style="v" sid="MAT 4:9"/>“ನೀನು ಅಡ್ಡಬಿದ್ದು ನನ್ನನ್ನು ಆರಾಧಿಸಿದರೆ ಇವೆಲ್ಲವನ್ನು ನಿನಗೆ ಕೊಡುವೆನು,” ಎಂದನು.<verse eid="MAT 4:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 4:10"/>ಯೇಸು ಅವನಿಗೆ, “ಸೈತಾನನೇ, ತೊಲಗು. ಏಕೆಂದರೆ, ‘ನಿನ್ನ ಕರ್ತದೇವರನ್ನು ಆರಾಧಿಸಿ, ಅವರಿಗೆ ಮಾತ್ರವೇ ಸೇವೆ ಸಲ್ಲಿಸಬೇಕು,’<note caller="+" style="f"><char style="fr" closed="false">4:10 </char><char style="ft" closed="false"><char style="xt"><ref loc="DEU 6:13">ಧರ್ಮೋ 6:13</ref></char></char></note> ಎಂದು ಪವಿತ್ರ ವೇದದಲ್ಲಿ ಬರೆದಿದೆ,” ಎಂದರು.<verse eid="MAT 4:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 4:11"/>ಆಗ ಸೈತಾನನು ಯೇಸುವನ್ನು ಬಿಟ್ಟುಹೋದನು. ದೇವದೂತರು ಬಂದು ಅವರಿಗೆ ಉಪಚಾರ ಮಾಡಿದರು.<verse eid="MAT 4:11"/></para>
  <para style="s1">ಯೇಸುವಿನ ಉಪದೇಶದ ಪ್ರಾರಂಭ</para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 4:12"/>ಯೋಹಾನನು ಬಂಧಿತನಾದನೆಂದು ಕೇಳಿ, ಯೇಸು ಗಲಿಲಾಯಕ್ಕೆ ಹಿಂದಿರುಗಿದರು. <verse eid="MAT 4:12"/><verse number="13" style="v" sid="MAT 4:13"/>ಬಳಿಕ ನಜರೇತನ್ನು ಬಿಟ್ಟು, ಜೆಬುಲೂನ್ ಮತ್ತು ನೆಫ್ತಲೀಮ್ ಪ್ರಾಂತಗಳಿಗೆ ಬಂದು ಸರೋವರದ ಬಳಿಯಲ್ಲಿದ್ದ ಕಪೆರ್ನೌಮ್ ಎಂಬ ಊರಿನಲ್ಲಿ ವಾಸಮಾಡಿದರು. <verse eid="MAT 4:13"/><verse number="14" style="v" sid="MAT 4:14"/>ಹೀಗೆ ಪ್ರವಾದಿ ಯೆಶಾಯನ ಮುಖಾಂತರ ಹೇಳಿಸಿರುವ ಈ ಮಾತು ನೆರವೇರಿತು. ಅದೇನೆಂದರೆ:<verse eid="MAT 4:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="MAT 4:15"/>“ಜೆಬುಲೂನ್ ನಾಡು ಮತ್ತು ನೆಫ್ತಲೀಮ್ ನಾಡು,</para>
  <para style="q2" vid="MAT 4:15">ಯೊರ್ದನ್ ನದಿಯ ಆಚೆ ಸರೋವರದ ಕಡೆ,</para>
  <para style="q2" vid="MAT 4:15">ಯೆಹೂದ್ಯರಲ್ಲದವರಿರುವ ಗಲಿಲಾಯ ನಾಡು,<verse eid="MAT 4:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="MAT 4:16"/>ಕತ್ತಲಲ್ಲಿ ವಾಸಿಸಿದ ಈ ಸ್ಥಳಗಳ ಜನರಿಗೆ</para>
  <para style="q2" vid="MAT 4:16">ಮಹಾ ಬೆಳಕು ಕಾಣಿಸಿತು;</para>
  <para style="q1" vid="MAT 4:16">ಮರಣ ಛಾಯೆಯ ಈ ಪ್ರದೇಶದಲ್ಲಿ ವಾಸಿಸುವವರಿಗೆ</para>
  <para style="q2" vid="MAT 4:16">ಬೆಳಕು ಉದಯಿಸಿತು.”<note caller="+" style="f"><char style="fr" closed="false">4:16 </char><char style="ft" closed="false"><char style="xt"><ref loc="ISA 9:1">ಯೆಶಾಯ 9:1</ref>,<ref loc="ISA 9:2">2</ref></char></char></note><verse eid="MAT 4:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 4:17"/>ಅಂದಿನಿಂದ ಯೇಸು, “ದೇವರ ಕಡೆಗೆ ತಿರುಗಿಕೊಳ್ಳಿರಿ, ಪರಲೋಕ ರಾಜ್ಯವು ಸಮೀಪಿಸಿದೆ,” ಎಂದು ಬೋಧಿಸತೊಡಗಿದರು.<verse eid="MAT 4:17"/></para>
  <para style="s1">ಯೇಸು ಪ್ರಥಮ ಶಿಷ್ಯರನ್ನು ಕರೆದದ್ದು</para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 4:18"/>ಯೇಸು ಗಲಿಲಾಯ ಸರೋವರದ ತೀರದಲ್ಲಿ ನಡೆದುಹೋಗುತ್ತಿರುವಾಗ, ಪೇತ್ರ ಎನಿಸಿಕೊಂಡ ಸೀಮೋನನನ್ನೂ ಅವನ ಸಹೋದರ ಅಂದ್ರೆಯನನ್ನೂ ಕಂಡರು. ಬೆಸ್ತರಾಗಿದ್ದ ಅವರು ಸರೋವರದಲ್ಲಿ ಬಲೆ ಬೀಸುತ್ತಿದ್ದರು. <verse eid="MAT 4:18"/><verse number="19" style="v" sid="MAT 4:19"/>ಯೇಸು ಅವರಿಗೆ, “ನನ್ನನ್ನು ಹಿಂಬಾಲಿಸಿರಿ. ನಾನು ನಿಮ್ಮನ್ನು, ಮನುಷ್ಯರನ್ನು ದೇವರ ಮಾರ್ಗದಲ್ಲಿ ನಡೆಸುವವರನ್ನಾಗಿ ಮಾಡುವೆನು,” ಎಂದು ಹೇಳಿದರು. <verse eid="MAT 4:19"/><verse number="20" style="v" sid="MAT 4:20"/>ತಕ್ಷಣವೇ, ಅವರು ತಮ್ಮ ಬಲೆಗಳನ್ನು ಬಿಟ್ಟು ಯೇಸುವನ್ನು ಹಿಂಬಾಲಿಸಿದರು.<verse eid="MAT 4:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 4:21"/>ಯೇಸು ಅಲ್ಲಿಂದ ಮುಂದೆ ಹೋಗುತ್ತಿದ್ದಾಗ ಇನ್ನಿಬ್ಬರು ಅಣ್ಣತಮ್ಮಂದಿರನ್ನು ಅಂದರೆ, ಜೆಬೆದಾಯನ ಮಗ ಯಾಕೋಬ ಮತ್ತು ಅವನ ಸಹೋದರ ಯೋಹಾನನನ್ನು ಕಂಡರು. ಅವರು ತಮ್ಮ ತಂದೆ ಜೆಬೆದಾಯನೊಡನೆ ದೋಣಿಯೊಳಗೆ ತಮ್ಮ ಬಲೆಗಳನ್ನು ಸರಿಪಡಿಸುತ್ತಿದ್ದರು. ಯೇಸು ಅವರನ್ನೂ ಕರೆದರು. <verse eid="MAT 4:21"/><verse number="22" style="v" sid="MAT 4:22"/>ಕೂಡಲೇ, ಅವರು ದೋಣಿಯನ್ನೂ ತಮ್ಮ ತಂದೆಯನ್ನೂ ಬಿಟ್ಟು ಯೇಸುವನ್ನು ಹಿಂಬಾಲಿಸಿದರು.<verse eid="MAT 4:22"/></para>
  <para style="s1">ಯೇಸು ಅಸ್ವಸ್ಥರನ್ನು ಗುಣಪಡಿಸಿದ್ದು</para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 4:23"/>ಯೇಸು ಗಲಿಲಾಯದಲ್ಲೆಲ್ಲಾ ಸಂಚರಿಸಿ, ಯೆಹೂದ್ಯರ ಸಭಾಮಂದಿರಗಳಲ್ಲಿ ಬೋಧಿಸುತ್ತಾ, ರಾಜ್ಯದ ಸುವಾರ್ತೆಯನ್ನು ಸಾರುತ್ತಾ, ಜನರಲ್ಲಿದ್ದ ಸಕಲ ವಿಧವಾದ ವ್ಯಾಧಿಗಳನ್ನೂ ಸಕಲ ವಿಧವಾದ ಬೇನೆಗಳನ್ನೂ ಗುಣಪಡಿಸುತ್ತಾ ಬಂದರು. <verse eid="MAT 4:23"/><verse number="24" style="v" sid="MAT 4:24"/>ಯೇಸುವಿನ ಸುದ್ದಿ ಸಿರಿಯಾ ದೇಶದಲ್ಲೆಲ್ಲಾ ಹಬ್ಬಿದ್ದರಿಂದ, ಜನರು ವಿವಿಧ ವ್ಯಾಧಿಗಳಿಂದಲೂ ತೀವ್ರ ವೇದನೆಯಿಂದಲೂ ಅಸ್ವಸ್ಥರಾದವರನ್ನೂ ದೆವ್ವ ಹಿಡಿದವರನ್ನೂ ಮೂರ್ಛಾರೋಗಿಗಳನ್ನೂ ಪಾರ್ಶ್ವವಾಯು ಪೀಡಿತರನ್ನೂ ಅವರ ಬಳಿಗೆ ಕರೆದುಕೊಂಡು ಬಂದರು; ಯೇಸು ಅವರನ್ನೆಲ್ಲಾ ಗುಣಪಡಿಸಿದರು. <verse eid="MAT 4:24"/><verse number="25" style="v" sid="MAT 4:25"/>ಗಲಿಲಾಯ, ದೆಕಪೊಲಿ,<note caller="+" style="f"><char style="fr" closed="false">4:25 </char><char style="ft" closed="false">ಅಂದರೆ, ಹತ್ತು ಪಟ್ಟಣಗಳು</char></note> ಯೆರೂಸಲೇಮ್, ಯೂದಾಯ ಹಾಗೂ ಯೊರ್ದನ್ ನದಿಯ ಆಚೆಕಡೆಯಿಂದಲೂ ಜನರು ದೊಡ್ಡ ಗುಂಪಾಗಿ ಯೇಸುವನ್ನು ಹಿಂಬಾಲಿಸಿದರು.<verse eid="MAT 4:25"/></para>
  <chapter eid="MAT 4"/>
  <chapter number="5" style="c" sid="MAT 5"/>
  <para style="s1">ಪರ್ವತ ಪ್ರಸಂಗಕ್ಕೆ ಮುನ್ನುಡಿ</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 5:1"/>ಯೇಸು ಜನರ ಗುಂಪನ್ನು ಕಂಡು, ಒಂದು ಬೆಟ್ಟವನ್ನೇರಿ ಕುಳಿತುಕೊಂಡರು. ಶಿಷ್ಯರು ಅವರ ಬಳಿಗೆ ಬಂದರು. <verse eid="MAT 5:1"/><verse number="2" style="v" sid="MAT 5:2"/>ಮತ್ತು ಯೇಸು ಅವರಿಗೆ ಉಪದೇಶಿಸಲು ಪ್ರಾರಂಭಿಸಿದರು.</para>
  <para style="s1" vid="MAT 5:2">ಧನ್ಯವಾಕ್ಯಗಳು</para>
  <para style="m" vid="MAT 5:2">ಅವರು ಹೀಗೆ ಹೇಳಿದರು:<verse eid="MAT 5:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="MAT 5:3"/>“ಆತ್ಮದಲ್ಲಿ ಬಡವರಾಗಿರುವವರು ಧನ್ಯರು,</para>
  <para style="q2" vid="MAT 5:3">ಪರಲೋಕ ರಾಜ್ಯವು ಅವರದು.<verse eid="MAT 5:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="MAT 5:4"/>ದುಃಖಿಸುವವರು ಧನ್ಯರು,</para>
  <para style="q2" vid="MAT 5:4">ಅವರು ಆದರಣೆ ಹೊಂದುವರು.<verse eid="MAT 5:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="MAT 5:5"/>ಸಾತ್ವಿಕರು ಧನ್ಯರು,</para>
  <para style="q2" vid="MAT 5:5">ಅವರು ಭೂಮಿಗೆ ಬಾಧ್ಯರಾಗುವರು.<verse eid="MAT 5:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="MAT 5:6"/>ನೀತಿಗೋಸ್ಕರ ಹಸಿದು ಬಾಯಾರುವವರು ಧನ್ಯರು,</para>
  <para style="q2" vid="MAT 5:6">ಅವರು ತೃಪ್ತಿಹೊಂದುವರು.<verse eid="MAT 5:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="MAT 5:7"/>ಕರುಣೆಯುಳ್ಳವರು ಧನ್ಯರು,</para>
  <para style="q2" vid="MAT 5:7">ಅವರು ಕರುಣೆ ಪಡೆಯುವರು.<verse eid="MAT 5:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="MAT 5:8"/>ಹೃದಯದಲ್ಲಿ ಶುದ್ಧರಾಗಿರುವವರು ಧನ್ಯರು,</para>
  <para style="q2" vid="MAT 5:8">ಅವರು ದೇವರನ್ನು ಕಾಣುವರು.<verse eid="MAT 5:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="MAT 5:9"/>ಸಮಾಧಾನ ಪಡಿಸುವವರು ಧನ್ಯರು,</para>
  <para style="q2" vid="MAT 5:9">ಅವರು ದೇವರ ಮಕ್ಕಳೆನಿಸಿಕೊಳ್ಳುವರು.<verse eid="MAT 5:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="MAT 5:10"/>ನೀತಿಯ ನಿಮಿತ್ತವಾಗಿ ಹಿಂಸೆಗೊಳಗಾಗುವವರು ಧನ್ಯರು,</para>
  <para style="q2" vid="MAT 5:10">ಪರಲೋಕ ರಾಜ್ಯವು ಅವರದು.<verse eid="MAT 5:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 5:11"/>“ನನ್ನ ನಿಮಿತ್ತವಾಗಿ ಜನರು ನಿಮ್ಮನ್ನು ನಿಂದಿಸಿ, ಹಿಂಸಿಸಿ ನಿಮ್ಮ ಮೇಲೆ ಎಲ್ಲಾ ವಿಧವಾದ ಕೆಟ್ಟ ಮಾತುಗಳನ್ನು ಸುಳ್ಳಾಗಿ ಹೊರಿಸಿದರೆ ನೀವು ಧನ್ಯರು. <verse eid="MAT 5:11"/><verse number="12" style="v" sid="MAT 5:12"/>ಸಂತೋಷಪಟ್ಟು ಆನಂದಿಸಿರಿ. ಏಕೆಂದರೆ ಪರಲೋಕದಲ್ಲಿ ನಿಮಗೆ ಮಹಾ ಪ್ರತಿಫಲ ಸಿಕ್ಕುವುದು. ಅವರು ನಿಮಗಿಂತ ಮುಂಚೆ ಇದ್ದ ಪ್ರವಾದಿಗಳನ್ನು ಸಹ ಇದೇ ರೀತಿಯಲ್ಲಿ ಹಿಂಸೆಪಡಿಸಿದರು.<verse eid="MAT 5:12"/></para>
  <para style="s1">ಉಪ್ಪು ಮತ್ತು ಬೆಳಕು</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 5:13"/>“ನೀವು ಭೂಮಿಗೆ ಉಪ್ಪಾಗಿದ್ದೀರಿ. ಉಪ್ಪು ಸಪ್ಪಗಾದರೆ, ಅದಕ್ಕೆ ಉಪ್ಪಿನ ರುಚಿ ಹೇಗೆ ಬಂದೀತು? ಅದು ಹೊರಗೆ ಹಾಕಿ ತುಳಿಯುವುದಕ್ಕೆ ಯೋಗ್ಯವೇ ಹೊರತು ಬೇರೆ ಯಾವ ಕೆಲಸಕ್ಕೂ ಬರುವುದಿಲ್ಲ.<verse eid="MAT 5:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 5:14"/>“ನೀವು ಲೋಕಕ್ಕೆ ಬೆಳಕಾಗಿದ್ದೀರಿ; ಬೆಟ್ಟದ ಮೇಲಿರುವ ಊರು ಮರೆಯಾಗಿರಲಾರದು. <verse eid="MAT 5:14"/><verse number="15" style="v" sid="MAT 5:15"/>ದೀಪವನ್ನು ಹಚ್ಚಿ ಯಾರೂ ಅಳೆಯುವ ಪಾತ್ರೆಯೊಳಗೆ ಇಡುವುದಿಲ್ಲ, ಅದನ್ನು ದೀಪಸ್ತಂಭದ ಮೇಲೆ ಇಡುತ್ತಾರೆ. ಆಗ ಅದು ಮನೆಯಲ್ಲಿರುವವರೆಲ್ಲರಿಗೆ ಬೆಳಕು ಕೊಡುತ್ತದೆ. <verse eid="MAT 5:15"/><verse number="16" style="v" sid="MAT 5:16"/>ಅದೇ ರೀತಿಯಲ್ಲಿ ನಿಮ್ಮ ಬೆಳಕು ಜನರ ಮುಂದೆ ಪ್ರಕಾಶಿಸಲಿ; ಹೀಗಾದರೆ ಜನರು ನಿಮ್ಮ ಸತ್ಕ್ರಿಯೆಗಳನ್ನು ಕಂಡು ಪರಲೋಕದಲ್ಲಿರುವ ನಿಮ್ಮ ತಂದೆಯನ್ನು ಮಹಿಮೆಪಡಿಸುವರು.<verse eid="MAT 5:16"/></para>
  <para style="s1">ಮೋಶೆಯ ನಿಯಮವನ್ನು ಈಡೇರಿಸಿದ್ದು</para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 5:17"/>“ಮೋಶೆಯ ನಿಯಮವನ್ನಾಗಲಿ, ಪ್ರವಾದನೆಗಳನ್ನಾಗಲಿ ರದ್ದು ಮಾಡುವುದಕ್ಕೆ ನಾನು ಬಂದೆನೆಂದು ಭಾವಿಸಬೇಡಿರಿ; ನಾನು ಅವುಗಳನ್ನು ರದ್ದುಗೊಳಿಸಲು ಬರಲಿಲ್ಲ, ನೆರವೇರಿಸಲು ಬಂದಿದ್ದೇನೆ. <verse eid="MAT 5:17"/><verse number="18" style="v" sid="MAT 5:18"/>ಭೂಮಿ ಆಕಾಶಗಳು ಗತಿಸಿಹೋಗುವವು, ಆದರೆ ನಿಯಮವೆಲ್ಲಾ ನೆರವೇರುವ ತನಕ ಅದರಲ್ಲಿ ಒಂದು ಚಿಕ್ಕ ಅಕ್ಷರವಾದರೂ ಚಿಕ್ಕ ಚುಕ್ಕೆಯಾದರೂ ಅಳಿದುಹೋಗುವುದಿಲ್ಲ ಎಂದು ನಾನು ನಿಮಗೆ ಸತ್ಯವಾಗಿ ಹೇಳುತ್ತೇನೆ. <verse eid="MAT 5:18"/><verse number="19" style="v" sid="MAT 5:19"/>ಆದ್ದರಿಂದ ಈ ಆಜ್ಞೆಗಳಲ್ಲಿ ಅತ್ಯಂತ ಚಿಕ್ಕದಾದ ಒಂದನ್ನು ಮೀರಿ, ಹಾಗೆಯೇ ಮೀರಲು ಇತರರಿಗೆ ಬೋಧಿಸುವವನು ಪರಲೋಕ ರಾಜ್ಯದಲ್ಲಿ ಅತಿ ಚಿಕ್ಕವನೆಂದು ಎನಿಸಿಕೊಳ್ಳುವನು. ಆದರೆ ಈ ಆಜ್ಞೆಗಳನ್ನು ಪಾಲಿಸಿ ಇತರರಿಗೆ ಬೋಧಿಸುವವನು ಪರಲೋಕ ರಾಜ್ಯದಲ್ಲಿ ದೊಡ್ಡವನೆಂದು ಎನಿಸಿಕೊಳ್ಳುವನು. <verse eid="MAT 5:19"/><verse number="20" style="v" sid="MAT 5:20"/>ನಿಮ್ಮ ನೀತಿಯು ಫರಿಸಾಯರ ಮತ್ತು ನಿಯಮ ಬೋಧಕರ ನೀತಿಗಿಂತಲೂ ಹೆಚ್ಚಿನದಾಗದಿದ್ದರೆ, ನೀವು ಪರಲೋಕ ರಾಜ್ಯವನ್ನು ಸೇರಲಾರಿರಿ ಎಂದು ನಿಮಗೆ ಹೇಳುತ್ತೇನೆ.<verse eid="MAT 5:20"/></para>
  <para style="s1">ನರಹತ್ಯೆ</para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 5:21"/>“ ‘ನರಹತ್ಯೆ ಮಾಡಬಾರದು,<note caller="+" style="f"><char style="fr" closed="false">5:21 </char><char style="ft" closed="false"><char style="xt"><ref loc="EXO 20:13">ವಿಮೋ 20:13</ref></char></char></note> ಯಾವನಾದರೂ ನರಹತ್ಯೆ ಮಾಡಿದರೆ ಅವನು ನ್ಯಾಯತೀರ್ಪಿಗೆ ಗುರಿಯಾಗುವನು,’ ಎಂದು ನಿಮ್ಮ ಪೂರ್ವಿಕರಿಗೆ ಹೇಳಿದ್ದನ್ನು ನೀವು ಕೇಳಿದ್ದೀರಷ್ಟೇ. <verse eid="MAT 5:21"/><verse number="22" style="v" sid="MAT 5:22"/>ಆದರೆ ನಾನು ನಿಮಗೆ ಹೇಳುವುದೇನೆಂದರೆ: ತನ್ನ ಸಹೋದರನ ಮೇಲೆ ಕೋಪಿಸಿಕೊಳ್ಳುವ<note caller="+" style="f"><char style="fr" closed="false">5:22 </char><char style="ft" closed="false">ಕೆಲವು ಹಸ್ತಪ್ರತಿಗಳ ಪ್ರಕಾರ </char><char style="fqa" closed="false">ಅವನು ತನ್ನ ಸಹೋದರನ ಮೇಲೆ ಯಾವುದೇ ಕಾರಣವಿಲ್ಲದೆ ಕೋಪಗೊಂಡಿದ್ದಾನೆ.</char></note> ಪ್ರತೀ ಮನುಷ್ಯನು ನ್ಯಾಯತೀರ್ಪಿಗೆ ಗುರಿಯಾಗುವನು. ಮಾತ್ರವಲ್ಲದೆ, ಯಾವನಾದರೂ ತನ್ನ ಸಹೋದರನನ್ನು ‘ಬುದ್ಧಿ ಇಲ್ಲದವನೇ’ ಎಂದರೂ ನ್ಯಾಯಸಭೆಯ ವಿಚಾರಣೆಗೆ ಒಳಗಾಗುವನು. ಯಾರನ್ನಾದರೂ, ‘ಮೂರ್ಖಾ,’ ಎನ್ನುವವನು ಅಗ್ನಿನರಕಕ್ಕೆ ಗುರಿಯಾಗುವನು.<verse eid="MAT 5:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 5:23"/>“ಆದ್ದರಿಂದ, ನೀನು ನಿನ್ನ ಕಾಣಿಕೆಯನ್ನು ಸಮರ್ಪಿಸಲು ಬಲಿಪೀಠದ ಬಳಿಗೆ ತಂದಾಗ, ನಿನ್ನ ಸಹೋದರನಿಗೆ ಅಥವಾ ನಿನ್ನ ಸಹೋದರಿಗೆ ನಿನ್ನ ಮೇಲೆ ಏನೋ ವಿರೋಧವಿದೆ ಎಂಬುದು ನಿನ್ನ ನೆನಪಿಗೆ ಬಂದರೆ, <verse eid="MAT 5:23"/><verse number="24" style="v" sid="MAT 5:24"/>ನಿನ್ನ ಕಾಣಿಕೆಯನ್ನು ಬಲಿಪೀಠದ ಮುಂದೆಯೇ ಬಿಟ್ಟು ಹೋಗಿ ಮೊದಲು ಸಹೋದರನೊಡನೆ ಅಥವಾ ಸಹೋದರಿಯೊಡನೆ ಸಂಧಾನಮಾಡಿಕೋ; ಆಮೇಲೆ ಬಂದು ನಿನ್ನ ಕಾಣಿಕೆಯನ್ನು ಸಮರ್ಪಿಸು.<verse eid="MAT 5:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 5:25"/>“ನಿನ್ನ ಎದುರಾಳಿ ನಿನ್ನನ್ನು ನ್ಯಾಯಾಲಯಕ್ಕೂ, ನ್ಯಾಯಾಧಿಪತಿಯು ನಿನ್ನನ್ನು ಅಧಿಕಾರಿಗೆ ಒಪ್ಪಿಸಿ ಸೆರೆಮನೆಗೆ ಹಾಕದಿರುವುದಕ್ಕೂ, ಎದುರಾಳಿಯ ಸಂಗಡ ದಾರಿಯಲ್ಲಿರುವಾಗಲೇ ಬೇಗ ಸಮಾಧಾನ ಮಾಡಿಕೋ. <verse eid="MAT 5:25"/><verse number="26" style="v" sid="MAT 5:26"/>ಇಲ್ಲದಿದ್ದರೆ, ನೀನು ಕೊನೆಯ ಪೈಸೆಯನ್ನಾದರೂ ಸಲ್ಲಿಸುವವರೆಗೂ ಅಲ್ಲಿಂದ ಹೊರಗೆ ಬರುವುದೇ ಇಲ್ಲವೆಂದು ನಿನಗೆ ಸತ್ಯವಾಗಿ ಹೇಳುತ್ತೇನೆ.<verse eid="MAT 5:26"/></para>
  <para style="s1">ವ್ಯಭಿಚಾರ</para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 5:27"/>“ ‘ವ್ಯಭಿಚಾರ ಮಾಡಬಾರದು,’<note caller="+" style="f"><char style="fr" closed="false">5:27 </char><char style="ft" closed="false"><char style="xt"><ref loc="EXO 20:14">ವಿಮೋ 20:14</ref></char></char></note> ಎಂದು ಹೇಳಿದ್ದನ್ನು ನೀವು ಕೇಳಿದ್ದೀರಷ್ಟೇ. <verse eid="MAT 5:27"/><verse number="28" style="v" sid="MAT 5:28"/>ಆದರೆ ಒಬ್ಬ ಸ್ತ್ರೀಯನ್ನು ಕಾಮದೃಷ್ಟಿಯಿಂದ ನೋಡುವ ಪ್ರತಿಯೊಬ್ಬನೂ ಆಗಲೇ ತನ್ನ ಹೃದಯದಲ್ಲಿ ಆಕೆಯ ಸಂಗಡ ವ್ಯಭಿಚಾರ ಮಾಡಿದ್ದಾನೆ ಎಂದು ನಾನು ನಿಮಗೆ ಹೇಳುತ್ತೇನೆ. <verse eid="MAT 5:28"/><verse number="29" style="v" sid="MAT 5:29"/>ಆದ್ದರಿಂದ ನಿನ್ನ ಬಲಗಣ್ಣು ನಿನ್ನ ಪಾಪಕ್ಕೆ ಕಾರಣವಾದರೆ, ಅದನ್ನು ನೀನು ಕಿತ್ತೆಸೆದುಬಿಡು. ಏಕೆಂದರೆ ನಿನ್ನ ಇಡೀ ದೇಹ ನರಕದಲ್ಲಿ ಎಸೆಯುವುದಕ್ಕಿಂತ ನಿನ್ನ ಒಂದು ಅಂಗವು ನಾಶವಾಗುವುದು ನಿನಗೆ ಒಳಿತು. <verse eid="MAT 5:29"/><verse number="30" style="v" sid="MAT 5:30"/>ನಿನ್ನ ಬಲಗೈ ನಿನ್ನ ಪಾಪಕ್ಕೆ ಕಾರಣವಾದರೆ, ಅದನ್ನು ನೀನು ಕತ್ತರಿಸಿ ಬಿಸಾಡಿಬಿಡು; ಏಕೆಂದರೆ ನಿನ್ನ ಇಡೀ ದೇಹ ನರಕದಲ್ಲಿ ಎಸೆಯುವುದಕ್ಕಿಂತ ನಿನ್ನ ಒಂದು ಅಂಗವು ನಾಶವಾಗುವುದು ನಿನಗೆ ಒಳಿತು.<verse eid="MAT 5:30"/></para>
  <para style="s1">ವಿವಾಹ ವಿಚ್ಛೇದನ</para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 5:31"/>“ಇದಲ್ಲದೆ, ‘ತನ್ನ ಹೆಂಡತಿಯನ್ನು ಬಿಡುವವನು ಆಕೆಗೆ ವಿವಾಹ ವಿಚ್ಛೇದನ ಪತ್ರವನ್ನು ಕೊಡಲಿ,’<note caller="+" style="f"><char style="fr" closed="false">5:31 </char><char style="ft" closed="false"><char style="xt"><ref loc="DEU 24:1">ಧರ್ಮೋ 24:1</ref></char></char></note> ಎಂದು ಹೇಳಿದೆಯಷ್ಟೆ. <verse eid="MAT 5:31"/><verse number="32" style="v" sid="MAT 5:32"/>ನಾನು ನಿಮಗೆ ಹೇಳುವುದೇನೆಂದರೆ, ಹಾದರದ ಕಾರಣದಿಂದಲ್ಲದೆ ತನ್ನ ಹೆಂಡತಿಯನ್ನು ಬಿಟ್ಟುಬಿಡುವವನು ಅವಳು ವ್ಯಭಿಚಾರ ಮಾಡುವುದಕ್ಕೆ ಕಾರಣನಾಗುತ್ತಾನೆ; ವಿವಾಹ ವಿಚ್ಛೇದನೆ ಹೊಂದಿದವಳನ್ನು ಮದುವೆ ಆಗುವವನು ವ್ಯಭಿಚಾರ ಮಾಡಿದವನಾಗುತ್ತಾನೆ.<verse eid="MAT 5:32"/></para>
  <para style="s1">ಆಣೆಗಳು</para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 5:33"/>“ ‘ಇದಲ್ಲದೆ ನೀನು ಆಣೆಯಿಟ್ಟರೆ ಅದನ್ನು ಮೀರಬಾರದು, ಕರ್ತನಿಗೆ ಮಾಡಿದ ಆಣೆಗಳನ್ನು ನೆರವೇರಿಸಲೇಬೇಕು,’ ಎಂದು ನಿಮ್ಮ ಪೂರ್ವಿಕರಿಗೆ ಹೇಳಿರುವುದನ್ನು ಕೇಳಿದ್ದೀರಿ. <verse eid="MAT 5:33"/><verse number="34" style="v" sid="MAT 5:34"/>ಆದರೆ ನಾನು ನಿಮಗೆ ಹೇಳುವುದೇನೆಂದರೆ, ಆಣೆಯಿಡಲೇ ಬೇಡಿರಿ. ಪರಲೋಕದ ಮೇಲೆ ಆಣೆ ಇಡಬೇಡಿರಿ, ಏಕೆಂದರೆ ಅದು ದೇವರ ಸಿಂಹಾಸನವು; <verse eid="MAT 5:34"/><verse number="35" style="v" sid="MAT 5:35"/>ಭೂಮಿಯ ಮೇಲೆ ಆಣೆ ಇಡಬೇಡಿರಿ, ಏಕೆಂದರೆ ಅದು ದೇವರ ಪಾದಪೀಠವು. ಯೆರೂಸಲೇಮಿನ ಮೇಲೆ ಆಣೆ ಇಡಬೇಡಿರಿ, ಏಕೆಂದರೆ ಅದು ಮಹಾರಾಜನ ಪಟ್ಟಣವಾಗಿದೆ. <verse eid="MAT 5:35"/><verse number="36" style="v" sid="MAT 5:36"/>ನಿನ್ನ ತಲೆಯ ಮೇಲೂ ಆಣೆಯಿಡುವುದು ಬೇಡ, ಏಕೆಂದರೆ ನೀನು ಒಂದು ಕೂದಲನ್ನಾದರೂ ಬೆಳ್ಳಗೆ ಅಥವಾ ಕಪ್ಪಗೆ ಮಾಡಲಾರೆ. <verse eid="MAT 5:36"/><verse number="37" style="v" sid="MAT 5:37"/>ಆದ್ದರಿಂದ ನಿಮ್ಮ ಮಾತು ಹೌದಾದರೆ ‘ಹೌದು’ ಇಲ್ಲವಾದರೆ ‘ಇಲ್ಲ’ ಎಂದಿರಲಿ. ಇದಕ್ಕಿಂತ ಹೆಚ್ಚಿನದು ಕೆಡುಕನಿಂದ ಬಂದದ್ದು.<verse eid="MAT 5:37"/></para>
  <para style="s1">ಕಣ್ಣಿಗೆ ಕಣ್ಣು</para>
  <para style="p">
    <verse number="38" style="v" sid="MAT 5:38"/>“ ‘ಕಣ್ಣಿಗೆ ಕಣ್ಣು, ಹಲ್ಲಿಗೆ ಹಲ್ಲು,’<note caller="+" style="f"><char style="fr" closed="false">5:38 </char><char style="ft" closed="false"><char style="xt"><ref loc="EXO 21:24">ವಿಮೋ 21:24</ref>; <ref loc="LEV 24:20">ಯಾಜಕ 24:20</ref>; <ref loc="DEU 19:21">ಧರ್ಮೋ 19:21</ref></char></char></note> ಎಂದು ಹೇಳಿರುವುದನ್ನು ನೀವು ಕೇಳಿದ್ದೀರಿ. <verse eid="MAT 5:38"/><verse number="39" style="v" sid="MAT 5:39"/>ಆದರೆ ನಾನು ನಿಮಗೆ ಹೇಳುವುದೇನೆಂದರೆ, ಕೆಡುಕನನ್ನು ಎದುರಿಸಬೇಡಿರಿ. ಯಾವನಾದರೂ ನಿನ್ನ ಬಲಗೆನ್ನೆಗೆ ಹೊಡೆದರೆ, ಅವನಿಗೆ ಮತ್ತೊಂದು ಕೆನ್ನೆಯನ್ನೂ ತಿರುಗಿಸಿಕೊಡು. <verse eid="MAT 5:39"/><verse number="40" style="v" sid="MAT 5:40"/>ನಿನ್ನೊಡನೆ ವ್ಯಾಜ್ಯ ಮಾಡಿ ನಿನ್ನ ಅಂಗಿಯನ್ನು ನಿನ್ನಿಂದ ಕಿತ್ತುಕೊಳ್ಳುವವನಿಗೆ, ನಿನ್ನ ಮೇಲಂಗಿಯನ್ನೂ ಕೊಟ್ಟುಬಿಡು. <verse eid="MAT 5:40"/><verse number="41" style="v" sid="MAT 5:41"/>ಯಾವನಾದರೂ ನಿನ್ನನ್ನು ಒಂದು ಕಿಲೋಮೀಟರು ದೂರ ಬಾ ಎಂದು ಒತ್ತಾಯ ಮಾಡಿದರೆ, ಅವನೊಡನೆ ಎರಡು ಕಿಲೋಮೀಟರು ದೂರ ಹೋಗು; <verse eid="MAT 5:41"/><verse number="42" style="v" sid="MAT 5:42"/>ಕೇಳುವವನಿಗೆ ಕೊಡು, ನಿನ್ನಿಂದ ಸಾಲ ಕೇಳುವವನ ಕಡೆಯಿಂದ ಮುಖ ತಿರುಗಿಸಿಕೊಳ್ಳಬೇಡ.<verse eid="MAT 5:42"/></para>
  <para style="s1">ವೈರಿಗಳನ್ನು ಪ್ರೀತಿಸುವುದು</para>
  <para style="p">
    <verse number="43" style="v" sid="MAT 5:43"/>“ ‘ನಿನ್ನ ನೆರೆಯವನನ್ನು ಪ್ರೀತಿಸಿ,<note caller="+" style="f"><char style="fr" closed="false">5:43 </char><char style="ft" closed="false"><char style="xt"><ref loc="LEV 19:18">ಯಾಜಕ 19:18</ref></char></char></note> ನಿನ್ನ ವೈರಿಯನ್ನು ದ್ವೇಷಿಸು,’ ಎಂದು ಹೇಳಿರುವುದನ್ನು ಕೇಳಿದ್ದೀರಿ. <verse eid="MAT 5:43"/><verse number="44" style="v" sid="MAT 5:44"/>ಆದರೆ ನಾನು ನಿಮಗೆ ಹೇಳುವುದೇನೆಂದರೆ, ನಿಮ್ಮ ವೈರಿಗಳನ್ನು ಪ್ರೀತಿಸಿರಿ, ನಿಮ್ಮನ್ನು ಹಿಂಸಿಸುವವರಿಗೋಸ್ಕರ ಪ್ರಾರ್ಥಿಸಿರಿ. <verse eid="MAT 5:44"/><verse number="45" style="v" sid="MAT 5:45"/>ಹೀಗೆ ಮಾಡಿದರೆ, ನೀವು ಪರಲೋಕದಲ್ಲಿರುವ ನಿಮ್ಮ ತಂದೆಗೆ ಮಕ್ಕಳಾಗುವಿರಿ. ಅವರು ಕೆಟ್ಟವರ ಮೇಲೆಯೂ ಒಳ್ಳೆಯವರ ಮೇಲೆಯೂ ತಮ್ಮ ಸೂರ್ಯನು ಉದಯಿಸುವಂತೆ ಮಾಡುತ್ತಾರೆ. ನೀತಿವಂತರ ಮೇಲೂ ಅನೀತಿವಂತರ ಮೇಲೂ ಮಳೆ ಸುರಿಸುತ್ತಾರೆ. <verse eid="MAT 5:45"/><verse number="46" style="v" sid="MAT 5:46"/>ನಿಮ್ಮನ್ನು ಪ್ರೀತಿಸುವವರನ್ನೇ ನೀವು ಪ್ರೀತಿಸಿದರೆ ನಿಮಗೇನು ಫಲ? ಸುಂಕದವರೂ ಹಾಗೆ ಮಾಡುವುದಿಲ್ಲವೇ? <verse eid="MAT 5:46"/><verse number="47" style="v" sid="MAT 5:47"/>ನಿಮ್ಮ ಸ್ವಂತದವರನ್ನು ಮಾತ್ರ ವಂದಿಸಿದರೆ ಹೆಚ್ಚೇನು ಮಾಡಿದ ಹಾಗಾಯಿತು? ಯೆಹೂದ್ಯರಲ್ಲದವರು ಸಹ ಹಾಗೆಯೇ ಮಾಡುತ್ತಾರಲ್ಲವೇ? <verse eid="MAT 5:47"/><verse number="48" style="v" sid="MAT 5:48"/>ಆದ್ದರಿಂದ, ಪರಲೋಕದಲ್ಲಿರುವ ನಿಮ್ಮ ತಂದೆಯು ಪರಿಪೂರ್ಣರಾಗಿರುವಂತೆ ನೀವೂ ಪರಿಪೂರ್ಣರಾಗಿರಿ.<verse eid="MAT 5:48"/></para>
  <chapter eid="MAT 5"/>
  <chapter number="6" style="c" sid="MAT 6"/>
  <para style="s1">ದಾನಧರ್ಮ ಮಾಡುವುದು</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 6:1"/>“ಜನರು ನೋಡಲಿ ಎಂದು ಅವರ ಮುಂದೆ, ನಿಮ್ಮ ದಾನಧರ್ಮಗಳನ್ನು ಮಾಡದಂತೆ ಎಚ್ಚರಿಕೆಯಿಂದಿರಿ. ಹಾಗೆ ಮಾಡಿದರೆ, ಪರಲೋಕದಲ್ಲಿರುವ ನಿಮ್ಮ ತಂದೆಯಿಂದ ನಿಮಗೆ ಪ್ರತಿಫಲ ಸಿಕ್ಕುವುದಿಲ್ಲ.<verse eid="MAT 6:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="MAT 6:2"/>“ಆದ್ದರಿಂದ ನೀನು ದಾನಧರ್ಮ ಮಾಡುವಾಗ, ಜನರಿಂದ ಹೊಗಳಿಸಿಕೊಳ್ಳಬೇಕೆಂದು ಕಪಟಿಗಳ ಹಾಗೆ ಸಭಾಮಂದಿರಗಳಲ್ಲಿಯೂ ಬೀದಿಗಳಲ್ಲಿಯೂ ತುತೂರಿಯನ್ನು ಊದಿಸಬೇಡ. ಅವರು ತಮ್ಮ ಪ್ರತಿಫಲವನ್ನು ಪೂರ್ತಿಯಾಗಿ ಹೊಂದಿದ್ದಾಯಿತೆಂದು ನಿಮಗೆ ಸತ್ಯವಾಗಿ ಹೇಳುತ್ತೇನೆ. <verse eid="MAT 6:2"/><verse number="3" style="v" sid="MAT 6:3"/>ಆದರೆ ನೀನು ದಾನಧರ್ಮ ಮಾಡುವಾಗ, ನಿನ್ನ ಬಲಗೈ ಕೊಡುವುದು ನಿನ್ನ ಎಡಗೈಗೆ ತಿಳಿಯದಿರಲಿ. <verse eid="MAT 6:3"/><verse number="4" style="v" sid="MAT 6:4"/>ಹೀಗೆ ನಿನ್ನ ದಾನಧರ್ಮವು ಗುಟ್ಟಾಗಿರುವಾಗ, ಅಂತರಂಗದಲ್ಲಿ ಮಾಡುವುದನ್ನು ಕಾಣುವ ನಿನ್ನ ತಂದೆ ನಿನಗೆ ಪ್ರತಿಫಲವನ್ನು ಕೊಡುವರು.<verse eid="MAT 6:4"/></para>
  <para style="s1">ಪ್ರಾರ್ಥನೆ</para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 6:5"/>“ನೀವು ಪ್ರಾರ್ಥನೆ ಮಾಡುವಾಗ, ಕಪಟಿಗಳಂತೆ ಮಾಡಬೇಡಿರಿ. ಅವರು ಜನರಿಗೆ ಕಾಣುವಂತೆ ಸಭಾಮಂದಿರಗಳಲ್ಲಿಯೂ ಬೀದಿಚೌಕಗಳಲ್ಲಿಯೂ ನಿಂತುಕೊಂಡು ಪ್ರಾರ್ಥನೆಮಾಡುವುದಕ್ಕೆ ಇಷ್ಟಪಡುತ್ತಾರೆ. ಅವರು ತಮ್ಮ ಪ್ರತಿಫಲವನ್ನು ಪೂರ್ತಿಯಾಗಿ ಹೊಂದಿದ್ದಾಯಿತೆಂದು ನಿಮಗೆ ಸತ್ಯವಾಗಿ ಹೇಳುತ್ತೇನೆ. <verse eid="MAT 6:5"/><verse number="6" style="v" sid="MAT 6:6"/>ಆದರೆ ನೀನು ಪ್ರಾರ್ಥನೆ ಮಾಡುವಾಗ, ನಿನ್ನ ಕೋಣೆಯೊಳಗೆ ಹೋಗಿ, ಬಾಗಿಲನ್ನು ಮುಚ್ಚಿ ಅದೃಶ್ಯವಾಗಿರುವ ನಿನ್ನ ತಂದೆಗೆ ಪ್ರಾರ್ಥನೆ ಸಲ್ಲಿಸು. ಆಗ ರಹಸ್ಯದಲ್ಲಿ ನಡೆಯುವುದನ್ನು ಕಾಣುವ ನಿನ್ನ ತಂದೆ ನಿನಗೆ ಪ್ರತಿಫಲ ಕೊಡುವರು. <verse eid="MAT 6:6"/><verse number="7" style="v" sid="MAT 6:7"/>ಆದರೆ ನೀವು ಪ್ರಾರ್ಥನೆ ಮಾಡುವಾಗ ಯೆಹೂದ್ಯರಲ್ಲದವರಂತೆ ವ್ಯರ್ಥವಾಗಿ ಹೇಳಿದ್ದನ್ನೇ ಪದೇಪದೇ ಹೇಳಬೇಡಿರಿ. ತಮ್ಮ ಅನೇಕ ಮಾತುಗಳ ದೆಸೆಯಿಂದ ತಮ್ಮ ಪ್ರಾರ್ಥನೆಯನ್ನು ದೇವರು ಆಲಿಸುತ್ತಾರೆಂದು ಅವರು ಭಾವಿಸುತ್ತಾರೆ. <verse eid="MAT 6:7"/><verse number="8" style="v" sid="MAT 6:8"/>ನೀವು ಅವರಂತೆ ಇರಬೇಡಿರಿ, ಏಕೆಂದರೆ ನೀವು ಕೇಳುವುದಕ್ಕೆ ಮೊದಲೇ, ನಿಮ್ಮ ತಂದೆಗೆ ನಿಮ್ಮ ಅಗತ್ಯಗಳು ತಿಳಿದಿವೆ.<verse eid="MAT 6:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 6:9"/>“ಆದ್ದರಿಂದ ನೀವು ಹೀಗೆ ಪ್ರಾರ್ಥಿಸಿರಿ:</para>
  <para style="q1" vid="MAT 6:9">“ ‘ಪರಲೋಕದಲ್ಲಿರುವ ನಮ್ಮ ತಂದೆಯೇ,</para>
  <para style="q1" vid="MAT 6:9">ನಿಮ್ಮ ನಾಮವು ಪರಿಶುದ್ಧವೆಂದು ಎಣಿಸಲಾಗಲಿ,<verse eid="MAT 6:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="MAT 6:10"/>ನಿಮ್ಮ ರಾಜ್ಯವು ಬರಲಿ;</para>
  <para style="q1" vid="MAT 6:10">ನಿಮ್ಮ ಚಿತ್ತವು ಪರಲೋಕದಲ್ಲಿ ನೆರವೇರುವ ಪ್ರಕಾರ</para>
  <para style="q2" vid="MAT 6:10">ಭೂಲೋಕದಲ್ಲಿಯೂ ನೆರವೇರಲಿ.<verse eid="MAT 6:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="MAT 6:11"/>ನಮ್ಮ ಅನುದಿನದ ಆಹಾರವನ್ನು ನಮಗೆ ಈ ದಿನವೂ ದಯಪಾಲಿಸಿರಿ.<verse eid="MAT 6:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="MAT 6:12"/>ನಮಗೆ ಸಾಲಮಾಡಿದವರನ್ನು<note caller="+" style="f"><char style="fr" closed="false">6:12 </char><char style="ft" closed="false">ಅಥವಾ </char><char style="fqa" closed="false">ತಪ್ಪುಮಾಡಿದವರನ್ನು</char></note> ನಾವು ಕ್ಷಮಿಸಿದಂತೆ,</para>
  <para style="q2" vid="MAT 6:12">ನಮ್ಮ ಸಾಲಗಳನ್ನು ಕ್ಷಮಿಸಿರಿ.<verse eid="MAT 6:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="MAT 6:13"/>ನಮ್ಮನ್ನು ಶೋಧನೆಗೆ ಸೇರಿಸದೆ,</para>
  <para style="q2" vid="MAT 6:13">ಕೇಡಿನಿಂದ ತಪ್ಪಿಸಿರಿ.</para>
  <para style="q1" vid="MAT 6:13">ಏಕೆಂದರೆ ರಾಜ್ಯವೂ ಬಲವೂ ಮಹಿಮೆಯೂ</para>
  <para style="q2" vid="MAT 6:13">ಸದಾಕಾಲ ನಿಮ್ಮದೇ. ಆಮೆನ್.<note caller="+" style="f"><char style="fr" closed="false">6:13 </char><char style="fq" closed="false">ಏಕೆಂದರೆ…ನಿಮ್ಮದೇ. ಆಮೆನ್ </char><char style="ft" closed="false">ಕೆಲವು ಪುರಾತನ ಪ್ರತಿಗಳಲ್ಲಿ ಈ ಪದಗಳಿರುವುದಿಲ್ಲ</char></note>’<verse eid="MAT 6:13"/></para>
  <para style="m">
    <verse number="14" style="v" sid="MAT 6:14"/>ನಿಮಗೆ ವಿರೋಧವಾಗಿ ತಪ್ಪುಮಾಡುವವರನ್ನು ನೀವು ಕ್ಷಮಿಸಿದರೆ ಪರಲೋಕದಲ್ಲಿರುವ ನಿಮ್ಮ ತಂದೆಯು ನಿಮ್ಮನ್ನು ಕ್ಷಮಿಸುವರು. <verse eid="MAT 6:14"/><verse number="15" style="v" sid="MAT 6:15"/>ಆದರೆ ನೀವು ಬೇರೆಯವರ ತಪ್ಪುಗಳನ್ನು ಕ್ಷಮಿಸದಿದ್ದರೆ, ನಿಮ್ಮ ತಂದೆ ಸಹ ನಿಮ್ಮ ತಪ್ಪುಗಳನ್ನು ಕ್ಷಮಿಸುವುದಿಲ್ಲ.<verse eid="MAT 6:15"/></para>
  <para style="s1">ಉಪವಾಸ</para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 6:16"/>“ನೀವು ಉಪವಾಸ ಮಾಡುವಾಗ ಕಪಟಿಗಳಂತೆ ಮುಖ ಸಪ್ಪಗೆ ಮಾಡಿಕೊಳ್ಳಬೇಡಿರಿ, ತಾವು ಉಪವಾಸ ಮಾಡುತ್ತಿದ್ದೇವೆಂದು ಜನರಿಗೆ ತೋರ್ಪಡಿಸಿಕೊಳ್ಳುವುದಕ್ಕಾಗಿ ಅವರು ತಮ್ಮ ಮುಖವನ್ನು ಬಾಡಿಸಿಕೊಂಡಿರುತ್ತಾರೆ. ಅವರು ತಮಗೆ ಬರತಕ್ಕ ಪ್ರತಿಫಲವನ್ನು ಪೂರ್ತಿಯಾಗಿ ಹೊಂದಿದ್ದಾಯಿತೆಂದು ನಿಮಗೆ ಸತ್ಯವಾಗಿ ಹೇಳುತ್ತೇನೆ. <verse eid="MAT 6:16"/><verse number="17" style="v" sid="MAT 6:17"/>ಆದರೆ ನೀನು ಉಪವಾಸ ಮಾಡುವಾಗ, ತಲೆಗೆ ಎಣ್ಣೆ ಹಚ್ಚಿಕೊಂಡು, ಮುಖ ತೊಳೆದುಕೋ. <verse eid="MAT 6:17"/><verse number="18" style="v" sid="MAT 6:18"/>ಹೀಗೆ ಮಾಡಿದರೆ, ಕಾಣದಿರುವ ನಿನ್ನ ತಂದೆಯ ಹೊರತು ಬೇರೆ ಯಾರಿಗೂ ನೀನು ಉಪವಾಸದಿಂದಿರುವುದು ತಿಳಿಯುವುದಿಲ್ಲ ಮತ್ತು ಗುಟ್ಟಾಗಿ ಮಾಡುವುದನ್ನು ಕಾಣುವ ನಿನ್ನ ತಂದೆ, ನಿನಗೆ ಪ್ರತಿಫಲ ಕೊಡುವರು.<verse eid="MAT 6:18"/></para>
  <para style="s1">ಸ್ವರ್ಗದಲ್ಲಿ ನಿಕ್ಷೇಪ</para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 6:19"/>“ಭೂಲೋಕದಲ್ಲಿ ನಿಮಗೋಸ್ಕರ ಆಸ್ತಿಪಾಸ್ತಿಯನ್ನು ಕೂಡಿಸಿಡಬೇಡಿರಿ, ಇಲ್ಲಿ ಅದಕ್ಕೆ ನುಸಿ ಮತ್ತು ಕಿಲುಬು ಹಿಡಿದು ಹಾಳಾಗುವುದು ಇಲ್ಲವೆ ಕಳ್ಳರು ಕನ್ನಾಕೊರೆದು ಕದಿಯುವರು. <verse eid="MAT 6:19"/><verse number="20" style="v" sid="MAT 6:20"/>ಆದರೆ ಪರಲೋಕದಲ್ಲಿ ನಿಮಗಾಗಿ ನಿಕ್ಷೇಪವನ್ನು ಕೂಡಿಟ್ಟುಕೊಳ್ಳಿರಿ, ಅಲ್ಲಿ ಅದಕ್ಕೆ ನುಸಿ ಮತ್ತು ಕಿಲುಬು ಹಿಡಿದು ಹಾಳಾಗುವುದಿಲ್ಲ. ಕಳ್ಳರು ಕನ್ನ ಕೊರೆದು ಕದಿಯುವುದಿಲ್ಲ. <verse eid="MAT 6:20"/><verse number="21" style="v" sid="MAT 6:21"/>ನಿಮ್ಮ ಸಂಪತ್ತು ಇರುವಲ್ಲಿಯೇ, ನಿಮ್ಮ ಹೃದಯವು ಸಹ ಇರುವುದು.<verse eid="MAT 6:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 6:22"/>“ಕಣ್ಣು ದೇಹಕ್ಕೆ ದೀಪವಾಗಿದೆ. ನಿನ್ನ ಕಣ್ಣು ಒಳ್ಳೆಯದಾಗಿದ್ದರೆ, ನಿನ್ನ ದೇಹವೆಲ್ಲಾ ಬೆಳಕಾಗಿರುವುದು. <verse eid="MAT 6:22"/><verse number="23" style="v" sid="MAT 6:23"/>ನಿನ್ನ ಕಣ್ಣು ಕೆಟ್ಟದ್ದಾಗಿದ್ದರೆ, ನಿನ್ನ ದೇಹವೆಲ್ಲಾ ಕತ್ತಲಾಗಿರುವುದು. ನಿನ್ನಲ್ಲಿರುವ ಬೆಳಕೇ ಕತ್ತಲಾಗಿರುವುದಾದರೆ ಅದು ಎಂತಹ ಕಾರ್ಗತ್ತಲಲ್ಲವೇ!<verse eid="MAT 6:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 6:24"/>“ಯಾವನೂ ಇಬ್ಬರು ಯಜಮಾನರಿಗೆ ಸೇವೆಮಾಡಲಾರನು. ಅವನು ಒಬ್ಬನನ್ನು ದ್ವೇಷಿಸಿ ಮತ್ತೊಬ್ಬನನ್ನು ಪ್ರೀತಿಸುವನು; ಇಲ್ಲವೆ ಒಬ್ಬನನ್ನು ಹೊಂದಿಕೊಂಡು ಮತ್ತೊಬ್ಬನನ್ನು ತಿರಸ್ಕರಿಸುವನು. ನೀವು ದೇವರಿಗೂ ಧನಕ್ಕೂ ಸೇವೆ ಮಾಡಲಾರಿರಿ.<verse eid="MAT 6:24"/></para>
  <para style="s1">ಚಿಂತಿಸಬೇಡಿರಿ</para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 6:25"/>“ಆದ್ದರಿಂದ ನಿಮ್ಮ ಜೀವನಕ್ಕಾಗಿ, ಏನು ಊಟಮಾಡಬೇಕು, ಏನು ಕುಡಿಯಬೇಕು ಅಥವಾ ನಿಮ್ಮ ದೇಹಕ್ಕೆ ಏನು ಧರಿಸಿಕೊಳ್ಳಬೇಕು ಎಂದು ಚಿಂತೆಮಾಡಬೇಡಿರಿ ಎಂದು ನಾನು ನಿಮಗೆ ಹೇಳುತ್ತೇನೆ. ಊಟಕ್ಕಿಂತ ಪ್ರಾಣವೂ ವಸ್ತ್ರಕ್ಕಿಂತ ದೇಹವೂ ಮೇಲಾದದ್ದಲ್ಲವೇ? <verse eid="MAT 6:25"/><verse number="26" style="v" sid="MAT 6:26"/>ಆಕಾಶದಲ್ಲಿ ಹಾರಾಡುವ ಹಕ್ಕಿಗಳನ್ನು ನೋಡಿರಿ. ಅವು ಬಿತ್ತುವುದಿಲ್ಲ, ಕೊಯ್ಯುವುದಿಲ್ಲ, ಕಣಜಗಳಲ್ಲಿ ಕೂಡಿಡುವುದಿಲ್ಲ. ಆದರೂ ಪರಲೋಕದಲ್ಲಿರುವ ನಿಮ್ಮ ತಂದೆಯು ಅವುಗಳನ್ನು ಪೋಷಿಸುತ್ತಾರೆ. ಅವುಗಳಿಗಿಂತ ನೀವು ಎಷ್ಟೋ ಶ್ರೇಷ್ಠರಲ್ಲವೇ? <verse eid="MAT 6:26"/><verse number="27" style="v" sid="MAT 6:27"/>ನೀವು ಚಿಂತಿಸುವುದರಿಂದ ನಿಮ್ಮ ಜೀವನಕ್ಕೆ ಒಂದು ತಾಸನ್ನು ಕೂಡಿಸಲು ಸಾಧ್ಯವೇ?<note caller="+" style="f"><char style="fr" closed="false">6:27 </char><char style="ft" closed="false">ಅಥವಾ </char><char style="fqa" closed="false">ಒಂದು ಮೊಳ</char></note><verse eid="MAT 6:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 6:28"/>“ನೀವು ಉಡುಪಿನ ವಿಷಯ ಚಿಂತಿಸುವುದೇಕೆ? ಅಡವಿಯಲ್ಲಿ ಹೂವುಗಳು ಬೆಳೆಯುವುದನ್ನು ಗಮನಿಸಿರಿ. ಅವು ದುಡಿಯುವುದಿಲ್ಲ, ನೂಲುವುದಿಲ್ಲ. <verse eid="MAT 6:28"/><verse number="29" style="v" sid="MAT 6:29"/>ಆದರೂ ಅರಸನಾದ ಸೊಲೊಮೋನನು ತನ್ನ ಸರ್ವವೈಭವದಲ್ಲಿ ಇದ್ದಾಗಲೂ ಆ ಹೂವುಗಳಲ್ಲಿ ಒಂದರಂತೆಯಾದರೂ ಉಡುಪನ್ನು ಧರಿಸಿರಲಿಲ್ಲ ಎಂದು, ನಾನು ನಿಮಗೆ ಹೇಳುತ್ತೇನೆ. <verse eid="MAT 6:29"/><verse number="30" style="v" sid="MAT 6:30"/>ಅಲ್ಪವಿಶ್ವಾಸಿಗಳೇ, ಇಂದಿದ್ದು ನಾಳೆ ಒಲೆಯ ಪಾಲಾಗುವ ಅಡವಿಯ ಹುಲ್ಲಿಗೇ ದೇವರು ಹೀಗೆ ಉಡಿಸಿದರೆ, ನಿಮಗೆ ಇನ್ನೂ ಎಷ್ಟೋ ಹೆಚ್ಚಾಗಿ ಉಡಿಸುವರಲ್ಲವೇ? <verse eid="MAT 6:30"/><verse number="31" style="v" sid="MAT 6:31"/>ಆದ್ದರಿಂದ, ‘ಏನು ಊಟಮಾಡಬೇಕು? ಏನು ಕುಡಿಯಬೇಕು ಮತ್ತು ಏನು ಧರಿಸಬೇಕು?’ ಎಂದು ಚಿಂತಿಸಬೇಡಿರಿ. <verse eid="MAT 6:31"/><verse number="32" style="v" sid="MAT 6:32"/>ಇವೆಲ್ಲವನ್ನು ದೇವರನ್ನು ಅರಿಯದವರು ಹುಡುಕುತ್ತಾರೆ. ಇವೆಲ್ಲಾ ನಿಮಗೆ ಅವಶ್ಯವೆಂದು ಪರಲೋಕದಲ್ಲಿರುವ ನಿಮ್ಮ ತಂದೆಯು ತಿಳಿದಿದ್ದಾರೆ. <verse eid="MAT 6:32"/><verse number="33" style="v" sid="MAT 6:33"/>ನೀವು ಮೊದಲು ದೇವರ ರಾಜ್ಯವನ್ನೂ ಅದರ ನೀತಿಯನ್ನೂ ಹುಡುಕಿರಿ. ಆಗ ಇವುಗಳ ಕೂಡ ಅವೆಲ್ಲವೂ ನಿಮಗೆ ದೊರಕುವವು. <verse eid="MAT 6:33"/><verse number="34" style="v" sid="MAT 6:34"/>ಆದ್ದರಿಂದ, ನಾಳೆಯ ವಿಷಯವಾಗಿ ಚಿಂತಿಸಬೇಡಿರಿ. ನಾಳೆಯ ದಿನವು ತನ್ನದನ್ನು ತಾನೇ ಚಿಂತಿಸಿಕೊಳ್ಳುವುದು, ಆ ದಿನದ ಪಾಡು ಆ ದಿನಕ್ಕೆ ಸಾಕು.<verse eid="MAT 6:34"/></para>
  <chapter eid="MAT 6"/>
  <chapter number="7" style="c" sid="MAT 7"/>
  <para style="s1">ತೀರ್ಪು ಮಾಡುವುದು</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 7:1"/>“ತೀರ್ಪುಮಾಡಬೇಡಿರಿ, ಆಗ ನಿಮಗೂ ಸಹ ತೀರ್ಪಾಗುವುದಿಲ್ಲ. <verse eid="MAT 7:1"/><verse number="2" style="v" sid="MAT 7:2"/>ನೀವು ಇತರರ ಬಗ್ಗೆ ಕೊಡುವ ತೀರ್ಪಿನ ಪ್ರಕಾರವೇ ನಿಮಗೂ ತೀರ್ಪಾಗುವುದು, ನೀವು ಅಳೆಯುವ ಅಳತೆಯಿಂದಲೇ ನಿಮಗೂ ಅಳೆದುಕೊಡಲಾಗುವುದು.<verse eid="MAT 7:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 7:3"/>“ನೀನು ನಿನ್ನ ಕಣ್ಣಿನಲ್ಲಿರುವ ಮರದ ದಿಮ್ಮಿಯನ್ನು ನೋಡದೆ, ನಿನ್ನ ಸಹೋದರನ ಕಣ್ಣಿನಲ್ಲಿರುವ ಮರದ ಚೂರನ್ನು ನೋಡುವುದೇಕೆ? <verse eid="MAT 7:3"/><verse number="4" style="v" sid="MAT 7:4"/>ನಿನ್ನ ಕಣ್ಣಿನಲ್ಲಿಯೇ ಮರದ ದಿಮ್ಮಿ ಇರುವಾಗ, ನಿನ್ನ ಸಹೋದರನಿಗೆ, ‘ನಾನು ನಿನ್ನ ಕಣ್ಣಿನಲ್ಲಿರುವ ಮರದ ಚೂರನ್ನು ತೆಗೆದುಬಿಡುತ್ತೇನೆ,’ ಎಂದು ನೀನು ಹೇಳುವುದು ಹೇಗೆ? <verse eid="MAT 7:4"/><verse number="5" style="v" sid="MAT 7:5"/>ಕಪಟಿಯೇ, ಮೊದಲು ನಿನ್ನ ಸ್ವಂತ ಕಣ್ಣಿನಲ್ಲಿರುವ ಮರದ ದಿಮ್ಮಿಯನ್ನು ತೆಗೆದುಹಾಕು. ಆಮೇಲೆ ನಿನ್ನ ಸಹೋದರನ ಕಣ್ಣಿನಲ್ಲಿರುವ ಮರದ ಚೂರನ್ನು ತೆಗೆಯಲು, ನಿನ್ನ ಕಣ್ಣು ಸ್ಪಷ್ಟವಾಗಿ ಕಾಣುವುದು.<verse eid="MAT 7:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 7:6"/>“ಪವಿತ್ರವಾದದ್ದನ್ನು ನಾಯಿಗಳಿಗೆ ಕೊಡಬೇಡಿರಿ. ಹಂದಿಗಳ ಮುಂದೆ ನಿಮ್ಮ ಮುತ್ತುಗಳನ್ನು ಚೆಲ್ಲಬೇಡಿರಿ. ಹಾಗೆ ಮಾಡಿದರೆ ಹಂದಿಗಳು ಮುತ್ತುಗಳನ್ನು ತಮ್ಮ ಕಾಲುಗಳಿಂದ ತುಳಿದು ಹಾಕಿಯಾವು. ನಾಯಿಗಳು ಹಿಂತಿರುಗಿ ಬಂದು ನಿಮ್ಮನ್ನು ಸೀಳಿಬಿಟ್ಟಾವು.<verse eid="MAT 7:6"/></para>
  <para style="s1">ಬೇಡಿರಿ, ಹುಡುಕಿರಿ, ತಟ್ಟಿರಿ</para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 7:7"/>“ಬೇಡಿಕೊಳ್ಳಿರಿ, ನಿಮಗೆ ಕೊಡಲಾಗುವುದು; ಹುಡುಕಿರಿ, ನಿಮಗೆ ಸಿಗುವುದು; ತಟ್ಟಿರಿ, ನಿಮಗೆ ಬಾಗಿಲು ತೆರೆಯಲಾಗುವುದು. <verse eid="MAT 7:7"/><verse number="8" style="v" sid="MAT 7:8"/>ಏಕೆಂದರೆ ಬೇಡಿಕೊಳ್ಳುವ ಪ್ರತಿಯೊಬ್ಬರು ಪಡೆದುಕೊಳ್ಳುವರು; ಹುಡುಕುವವರಿಗೆ ಸಿಗುವುದು; ತಟ್ಟುವವರಿಗೆ ಬಾಗಿಲು ತೆರೆಯಲಾಗುವುದು.<verse eid="MAT 7:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 7:9"/>“ನಿಮ್ಮಲ್ಲಿ ಯಾವನಾದರೂ ತನ್ನ ಮಗನು ರೊಟ್ಟಿಯನ್ನು ಕೇಳಿದರೆ ಅವನಿಗೆ ಕಲ್ಲನ್ನು ಕೊಡುವನೇ? <verse eid="MAT 7:9"/><verse number="10" style="v" sid="MAT 7:10"/>ಇಲ್ಲವೆ ಮೀನನ್ನು ಕೇಳಿದರೆ ಅವನಿಗೆ ಹಾವನ್ನು ಕೊಡುವನೇ? <verse eid="MAT 7:10"/><verse number="11" style="v" sid="MAT 7:11"/>ಕೆಟ್ಟವರಾದ ನೀವೇ ನಿಮ್ಮ ಮಕ್ಕಳಿಗೆ ಒಳ್ಳೆಯವುಗಳನ್ನು ಕೊಡಬಲ್ಲವರಾದರೆ, ಪರಲೋಕದಲ್ಲಿರುವ ನಿಮ್ಮ ತಂದೆಯು ತಮ್ಮಲ್ಲಿ ಬೇಡಿಕೊಳ್ಳುವವರಿಗೆ ಎಷ್ಟೋ ಹೆಚ್ಚಾಗಿ ಒಳ್ಳೆಯವುಗಳನ್ನು ಕೊಡುವರಲ್ಲವೇ! <verse eid="MAT 7:11"/><verse number="12" style="v" sid="MAT 7:12"/>ಆದ್ದರಿಂದ, ಜನರು ನಿಮಗೆ ಏನೇನು ಮಾಡಬೇಕೆಂದು ನೀವು ಬಯಸುತ್ತೀರೋ, ಅದರಂತೆಯೇ ನೀವು ಅವರಿಗೆ ಮಾಡಿರಿ; ಇದೇ ನಿಯಮ ಮತ್ತು ಪ್ರವಾದಿಗಳ ಬೋಧನೆಯ ಸಾರಾಂಶವು.<verse eid="MAT 7:12"/></para>
  <para style="s1">ಇಕ್ಕಟ್ಟಾದ ಹಾಗೂ ವಿಶಾಲ ಬಾಗಿಲು</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 7:13"/>“ಇಕ್ಕಟ್ಟಾದ ಬಾಗಿಲಿನಿಂದ ಪ್ರವೇಶಿಸಿರಿ. ಏಕೆಂದರೆ ನಾಶಕ್ಕೆ ಒಯ್ಯುವ ಬಾಗಿಲು, ಅಗಲವೂ ಅದರ ಮಾರ್ಗವು ವಿಶಾಲವೂ ಆಗಿವೆ; ಅದರೊಳಗೆ ಪ್ರವೇಶಿಸುವವರು ಅನೇಕರು. <verse eid="MAT 7:13"/><verse number="14" style="v" sid="MAT 7:14"/>ಜೀವಕ್ಕೆ ಒಯ್ಯುವ ಬಾಗಿಲು ಇಕ್ಕಟ್ಟಾದದ್ದೂ ದಾರಿಯು ಕಷ್ಟಕರವಾದದ್ದೂ ಆಗಿದೆ; ಅದನ್ನು ಕಂಡು ಹಿಡಿಯುವವರು ಕೆಲವರು ಮಾತ್ರ.<verse eid="MAT 7:14"/></para>
  <para style="s1">ಮರ ಹಾಗೂ ಫಲ</para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 7:15"/>“ಕುರಿಯ ವೇಷಹಾಕಿಕೊಂಡು ನಿಮ್ಮ ಬಳಿಗೆ ಬರುವ ಸುಳ್ಳು ಪ್ರವಾದಿಗಳ ಬಗ್ಗೆ ಎಚ್ಚರಿಕೆ. ಏಕೆಂದರೆ ಅವರು ಒಳಗೆ ಕ್ರೂರವಾದ ತೋಳಗಳಾಗಿದ್ದಾರೆ. <verse eid="MAT 7:15"/><verse number="16" style="v" sid="MAT 7:16"/>ಅವರವರ ಫಲಗಳಿಂದ ನೀವು ಅವರನ್ನು ತಿಳಿದುಕೊಳ್ಳುವಿರಿ. ಜನರು ಮುಳ್ಳುಗಳಿಂದ ದ್ರಾಕ್ಷಿಯನ್ನೂ ದತ್ತೂರಿ ಗಿಡಗಳಿಂದ ಅಂಜೂರಗಳನ್ನೂ ಕೀಳುವರೋ? <verse eid="MAT 7:16"/><verse number="17" style="v" sid="MAT 7:17"/>ಅದರಂತೆಯೇ, ಪ್ರತಿಯೊಂದು ಒಳ್ಳೆಯ ಮರವು ಒಳ್ಳೆಯ ಫಲವನ್ನು ಕೊಡುತ್ತದೆ. ಆದರೆ ಕೆಟ್ಟ ಮರವು ಕೆಟ್ಟ ಫಲವನ್ನು ಕೊಡುತ್ತದೆ. <verse eid="MAT 7:17"/><verse number="18" style="v" sid="MAT 7:18"/>ಒಳ್ಳೆಯ ಮರವು ಕೆಟ್ಟ ಫಲವನ್ನು ಕೊಡಲಾರದು, ಕೆಟ್ಟ ಮರವು ಒಳ್ಳೆಯ ಫಲವನ್ನು ಕೊಡಲಾರದು. <verse eid="MAT 7:18"/><verse number="19" style="v" sid="MAT 7:19"/>ಒಳ್ಳೆಯ ಫಲವನ್ನು ಕೊಡದ ಪ್ರತಿಯೊಂದು ಮರವನ್ನು ಕಡಿದು ಬೆಂಕಿಯಲ್ಲಿ ಹಾಕುವರು. <verse eid="MAT 7:19"/><verse number="20" style="v" sid="MAT 7:20"/>ಆದ್ದರಿಂದ ಅವರವರ ಫಲಗಳಿಂದಲೇ ನೀವು ಅವರನ್ನು ತಿಳಿದುಕೊಳ್ಳುವಿರಿ.<verse eid="MAT 7:20"/></para>
  <para style="s1">ನಿಜ ಹಾಗೂ ಸುಳ್ಳು ಶಿಷ್ಯರು</para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 7:21"/>“ನನ್ನನ್ನು, ‘ಸ್ವಾಮೀ, ಸ್ವಾಮೀ,’ ಎಂದು ಹೇಳುವವರೆಲ್ಲರೂ ಪರಲೋಕ ರಾಜ್ಯವನ್ನು ಪ್ರವೇಶಿಸುವುದಿಲ್ಲ. ಆದರೆ ಪರಲೋಕದಲ್ಲಿರುವ ನನ್ನ ತಂದೆಯ ಚಿತ್ತವನ್ನು ಮಾಡುವವನೇ ಅದರಲ್ಲಿ ಪ್ರವೇಶಿಸುವನು. <verse eid="MAT 7:21"/><verse number="22" style="v" sid="MAT 7:22"/>ಆ ದಿನದಲ್ಲಿ, ‘ಕರ್ತದೇವರೇ, ಕರ್ತದೇವರೇ, ನಿಮ್ಮ ಹೆಸರಿನಲ್ಲಿ ನಾವು ಪ್ರವಾದಿಸಲಿಲ್ಲವೇ? ನಿಮ್ಮ ಹೆಸರಿನಲ್ಲಿ ದೆವ್ವಗಳನ್ನು ಬಿಡಿಸಲಿಲ್ಲವೇ? ನಿಮ್ಮ ಹೆಸರಿನಲ್ಲಿ ಅನೇಕ ಮಹತ್ಕಾರ್ಯಗಳನ್ನು ಮಾಡಲಿಲ್ಲವೇ?’ ಎಂದು ಅನೇಕರು ನನಗೆ ಹೇಳುವರು. <verse eid="MAT 7:22"/><verse number="23" style="v" sid="MAT 7:23"/>ಆಗ ನಾನು ಅವರಿಗೆ, ‘ನಿಮ್ಮನ್ನು ನಾನೆಂದೂ ಅರಿಯೆನು, ನಿಯಮ ಮೀರಿ ಬಾಳಿದವರೇ ನನ್ನಿಂದ ತೊಲಗಿಹೋಗಿರಿ!’<note caller="+" style="f"><char style="fr" closed="false">7:23 </char><char style="ft" closed="false"><char style="xt"><ref loc="PSA 6:8">ಕೀರ್ತನೆ 6:8</ref>; <ref loc="PSA 119:115">ಕೀರ್ತನೆ 119:115</ref></char></char></note> ಎಂದು ಹೇಳಿಬಿಡುವೆನು.<verse eid="MAT 7:23"/></para>
  <para style="s1">ಬುದ್ಧಿವಂತ ಹಾಗೂ ಬುದ್ಧಿಹೀನ</para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 7:24"/>“ಆದ್ದರಿಂದ ಈ ನನ್ನ ಮಾತುಗಳನ್ನು ಕೇಳಿ ಅವುಗಳಂತೆ ಮಾಡುವ ಪ್ರತಿಯೊಬ್ಬನೂ ಬಂಡೆಯ ಮೇಲೆ ತನ್ನ ಮನೆಯನ್ನು ಕಟ್ಟಿದ ಬುದ್ಧಿವಂತನಿಗೆ ಸಮಾನ. <verse eid="MAT 7:24"/><verse number="25" style="v" sid="MAT 7:25"/>ಮಳೆಯು ಸುರಿದು ಹಳ್ಳಗಳು ಬಂದವು, ಗಾಳಿ ಬೀಸಿ ಆ ಮನೆಗೆ ಅಪ್ಪಳಿಸಿತು. ಆದರೂ ಆ ಮನೆ ಬೀಳಲಿಲ್ಲ. ಏಕೆಂದರೆ ಅದರ ಅಸ್ತಿವಾರವು ಬಂಡೆಯ ಮೇಲೆ ಕಟ್ಟಲಾಗಿತ್ತು. <verse eid="MAT 7:25"/><verse number="26" style="v" sid="MAT 7:26"/>ಈ ನನ್ನ ಮಾತುಗಳನ್ನು ಕೇಳುವ ಪ್ರತಿಯೊಬ್ಬನು ಅವುಗಳಂತೆ ನಡೆಯದೆ ಹೋದರೆ, ಅವನು ಮರಳಿನ ಮೇಲೆ ತನ್ನ ಮನೆಯನ್ನು ಕಟ್ಟಿದ ಬುದ್ಧಿಹೀನನಿಗೆ ಸಮಾನ. <verse eid="MAT 7:26"/><verse number="27" style="v" sid="MAT 7:27"/>ಮಳೆಯು ಸುರಿದು, ಹಳ್ಳಗಳು ಬಂದವು, ಗಾಳಿ ಬೀಸಿ ಆ ಮನೆಗೆ ಅಪ್ಪಳಿಸಿತು. ಆಗ ಆ ಮನೆ ಕುಸಿದು ಬಿತ್ತು. ಅದರ ಬೀಳುವಿಕೆಯು ಭಯಂಕರವಾಗಿತ್ತು,” ಎಂದರು.<verse eid="MAT 7:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 7:28"/>ಯೇಸು ಈ ಮಾತುಗಳನ್ನು ಹೇಳಿ ಮುಗಿಸಿದ ಮೇಲೆ, ಅವರ ಬೋಧನೆಯನ್ನು ಕೇಳಿ ಜನರು ಆಶ್ಚರ್ಯಪಟ್ಟರು. <verse eid="MAT 7:28"/><verse number="29" style="v" sid="MAT 7:29"/>ಏಕೆಂದರೆ, ಯೇಸು ಅವರ ನಿಯಮ ಬೋಧಕರಂತೆ ಬೋಧಿಸದೆ, ಅಧಿಕಾರವಿದ್ದವರಂತೆ ಬೋಧಿಸುತ್ತಿದ್ದರು.<verse eid="MAT 7:29"/></para>
  <chapter eid="MAT 7"/>
  <chapter number="8" style="c" sid="MAT 8"/>
  <para style="s1">ಯೇಸು ಕುಷ್ಠರೋಗಿಯನ್ನು ಸ್ವಸ್ಥಮಾಡಿದ್ದು</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 8:1"/>ಯೇಸು ಪರ್ವತವನ್ನು ಇಳಿದು ಬಂದಾಗ, ಜನರು ದೊಡ್ಡ ಸಮೂಹವಾಗಿ ಅವರನ್ನು ಹಿಂಬಾಲಿಸಿದರು. <verse eid="MAT 8:1"/><verse number="2" style="v" sid="MAT 8:2"/>ಅಲ್ಲಿಗೆ ಕುಷ್ಠರೋಗಿಯಾಗಿದ್ದ ಒಬ್ಬನು ಬಂದು, ಯೇಸುವಿನ ಮುಂದೆ ಮೊಣಕಾಲೂರಿ, “ಕರ್ತನೇ, ನೀವು ಮನಸ್ಸು ಮಾಡಿದರೆ, ನನ್ನನ್ನು ಶುದ್ಧಮಾಡಬಲ್ಲಿರಿ,” ಎಂದನು.<verse eid="MAT 8:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 8:3"/>ಆಗ ಯೇಸು ಕೈಚಾಚಿ ಅವನನ್ನು ಮುಟ್ಟಿ, “ನನಗೆ ಮನಸ್ಸಿದೆ, ನೀನು ಶುದ್ಧನಾಗು,” ಎಂದರು. ತಕ್ಷಣವೇ ಅವನ ಕುಷ್ಠವು ಹೋಗಿ ಅವನು ಶುದ್ಧನಾದನು. <verse eid="MAT 8:3"/><verse number="4" style="v" sid="MAT 8:4"/>ಆಗ ಯೇಸು ಅವನಿಗೆ, “ನೋಡು ಇದನ್ನು ನೀನು ಯಾರಿಗೂ ಹೇಳಬೇಡ, ಹೋಗಿ ಯಾಜಕನಿಗೆ ನಿನ್ನನ್ನು ತೋರಿಸಿಕೊಂಡು ಜನರಿಗೆ ಸಾಕ್ಷಿಯಾಗಿರುವಂತೆ ಮೋಶೆಯು ಆಜ್ಞಾಪಿಸಿದ ಕಾಣಿಕೆಯನ್ನು<note caller="+" style="f"><char style="fr" closed="false">8:4 </char><char style="ft" closed="false"><char style="xt"><ref loc="LEV 14:1-7">ಯಾಜಕ 14:1-7</ref></char></char></note> ಅರ್ಪಿಸು,” ಎಂದು ಹೇಳಿದರು.<verse eid="MAT 8:4"/></para>
  <para style="s1">ಯೇಸು ಶತಾಧಿಪತಿಯ ಆಳನ್ನು ಸ್ವಸ್ಥಮಾಡಿದ್ದು</para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 8:5"/>ಯೇಸು ಕಪೆರ್ನೌಮಿಗೆ ಪ್ರವೇಶಿಸಿದಾಗ, ಒಬ್ಬ ಶತಾಧಿಪತಿಯು ಅವರ ಬಳಿಗೆ ಬಂದು, <verse eid="MAT 8:5"/><verse number="6" style="v" sid="MAT 8:6"/>“ಸ್ವಾಮೀ, ನನ್ನ ಸೇವಕನು ಪಾರ್ಶ್ವವಾಯು ರೋಗದಿಂದ ಘೋರವಾಗಿ ನರಳುತ್ತಾ ಮನೆಯಲ್ಲಿ ಹಾಸಿಗೆ ಹಿಡಿದಿದ್ದಾನೆ,” ಎಂದು ಹೇಳಿಕೊಂಡನು.<verse eid="MAT 8:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 8:7"/>ಯೇಸು ಅವನಿಗೆ, “ನಾನು ಬಂದು ಅವನನ್ನು ಸ್ವಸ್ಥಮಾಡುತ್ತೇನೆ,” ಎಂದರು.<verse eid="MAT 8:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 8:8"/>ಅದಕ್ಕೆ ಶತಾಧಿಪತಿಯು, “ಸ್ವಾಮೀ, ನನ್ನ ಮನೆಯೊಳಗೆ ನೀವು ಬರುವಷ್ಟು ಯೋಗ್ಯತೆ ನನಗಿಲ್ಲ. ಆದರೆ, ನೀವು ಒಂದು ಮಾತು ಮಾತ್ರ ಹೇಳಿರಿ, ಆಗ ನನ್ನ ಸೇವಕ ಗುಣಹೊಂದುವನು. <verse eid="MAT 8:8"/><verse number="9" style="v" sid="MAT 8:9"/>ಏಕೆಂದರೆ ನಾನು ಸಹ ಮತ್ತೊಬ್ಬ ಅಧಿಕಾರಿಯ ಕೈಕೆಳಗಿರುವವನು, ನನ್ನ ಅಧೀನದಲ್ಲಿಯೂ ಸೈನಿಕರಿದ್ದಾರೆ ಮತ್ತು ನಾನು ಒಬ್ಬನಿಗೆ, ‘ಹೋಗು’ ಎಂದರೆ ಅವನು ಹೋಗುತ್ತಾನೆ. ಮತ್ತೊಬ್ಬನಿಗೆ, ‘ಬಾ’ ಎಂದರೆ ಅವನು ಬರುತ್ತಾನೆ. ನನ್ನ ಸೇವಕನಿಗೆ, ‘ಇದನ್ನು ಮಾಡು,’ ಎಂದರೆ ಅವನು ಮಾಡುತ್ತಾನೆ,” ಎಂದು ಹೇಳಿದನು.<verse eid="MAT 8:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 8:10"/>ಯೇಸು ಇದನ್ನು ಕೇಳಿ, ಆಶ್ಚರ್ಯಪಟ್ಟು ತಮ್ಮ ಹಿಂದೆ ಬರುತ್ತಿದ್ದವರಿಗೆ, “ಇಂಥ ಮಹಾ ನಂಬಿಕೆಯನ್ನು ನಾನು ಇಸ್ರಾಯೇಲ್ ಜನರಲ್ಲಿಯೂ ಕಾಣಲಿಲ್ಲ ಎಂದು ನಿಮಗೆ ನಿಜವಾಗಿ ಹೇಳುತ್ತೇನೆ. <verse eid="MAT 8:10"/><verse number="11" style="v" sid="MAT 8:11"/>ಅನೇಕರು ಪೂರ್ವದಿಂದಲೂ ಪಶ್ಚಿಮದಿಂದಲೂ ಬಂದು, ಪರಲೋಕ ರಾಜ್ಯದಲ್ಲಿ ಅಬ್ರಹಾಮ್, ಇಸಾಕ್, ಯಾಕೋಬರೊಂದಿಗೆ ಹಬ್ಬದ ಔತಣಕ್ಕೆ ಕುಳಿತುಕೊಳ್ಳುವರು. <verse eid="MAT 8:11"/><verse number="12" style="v" sid="MAT 8:12"/>ಆದರೆ ರಾಜ್ಯದ ಮಕ್ಕಳು ಹೊರಗೆ ಕತ್ತಲೆಗೆ ದಬ್ಬಲಾಗುವರು, ಅಲ್ಲಿ ಗೋಳಾಟವೂ ಹಲ್ಲು ಕಡಿಯೋಣವೂ ಇರುವವು ಎಂದು ನಿಮಗೆ ಹೇಳುತ್ತೇನೆ,” ಎಂದರು.<verse eid="MAT 8:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 8:13"/>ಅನಂತರ ಯೇಸು ಆ ಶತಾಧಿಪತಿಗೆ, “ಹೋಗು, ನೀನು ನಂಬಿದಂತೆಯೇ ನಿನಗಾಗಲಿ,” ಎಂದು ಹೇಳಿದರು. ಅವನ ಸೇವಕನು ಅದೇ ಗಳಿಗೆಯಲ್ಲಿ ಸ್ವಸ್ಥನಾದನು.<verse eid="MAT 8:13"/></para>
  <para style="s1">ಯೇಸು ಅನೇಕರನ್ನು ಗುಣಪಡಿಸಿದ್ದು</para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 8:14"/>ತರುವಾಯ ಯೇಸು ಪೇತ್ರನ ಮನೆಗೆ ಬಂದು, ಅವನ ಅತ್ತೆ ಜ್ವರದಿಂದ ಮಲಗಿರುವುದನ್ನು ಕಂಡರು. <verse eid="MAT 8:14"/><verse number="15" style="v" sid="MAT 8:15"/>ಯೇಸು ಆಕೆಯ ಕೈಯನ್ನು ಮುಟ್ಟಿದಾಗ ಜ್ವರವು ಆಕೆಯನ್ನು ಬಿಟ್ಟುಹೋಯಿತು. ಆಕೆಯು ಎದ್ದು ಅವರನ್ನು ಉಪಚರಿಸಿದಳು.<verse eid="MAT 8:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 8:16"/>ಸಂಜೆಯಾದಾಗ, ದೆವ್ವಹಿಡಿದ ಅನೇಕರನ್ನು ಜನರು ಯೇಸುವಿನ ಬಳಿಗೆ ಕರೆತಂದರು. ಯೇಸು ಮಾತಿನಿಂದಲೇ ದೆವ್ವಗಳನ್ನು ಬಿಡಿಸಿದ್ದಲ್ಲದೆ, ಎಲ್ಲಾ ರೋಗಪೀಡಿತರನ್ನೂ ಸ್ವಸ್ಥಪಡಿಸಿದರು. <verse eid="MAT 8:16"/><verse number="17" style="v" sid="MAT 8:17"/>ಹೀಗೆ,</para>
  <para style="q1" vid="MAT 8:17">“ಅವರು ತಾವೇ ನಮ್ಮ ಬಲಹೀನತೆಗಳನ್ನು ತೆಗೆದುಕೊಂಡು,</para>
  <para style="q2" vid="MAT 8:17">ನಮ್ಮ ರೋಗಗಳನ್ನು ಹೊತ್ತುಕೊಂಡರು,”<note caller="+" style="f"><char style="fr" closed="false">8:17 </char><char style="ft" closed="false"><char style="xt"><ref loc="ISA 53:4">ಯೆಶಾಯ 53:4</ref></char></char></note></para>
  <para style="m" vid="MAT 8:17">ಎಂದು ಯೆಶಾಯ ಪ್ರವಾದಿಯು ಹೇಳಿದ್ದು ನೆರವೇರಿತು.<verse eid="MAT 8:17"/></para>
  <para style="s1">ಯೇಸುವನ್ನು ಹಿಂಬಾಲಿಸುವ ಕ್ರಯ</para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 8:18"/>ಯೇಸು ತಮ್ಮ ಸುತ್ತಲಿದ್ದ ಜನರ ದೊಡ್ಡ ಸಮೂಹವನ್ನು ಕಂಡು, ಆಚೆದಡಕ್ಕೆ ಹೋಗಲು ಅಪ್ಪಣೆಕೊಟ್ಟರು. <verse eid="MAT 8:18"/><verse number="19" style="v" sid="MAT 8:19"/>ಆಗ ಒಬ್ಬ ನಿಯಮ ಬೋಧಕ ಬಂದು ಯೇಸುವಿಗೆ, “ಬೋಧಕರೇ, ನೀವು ಎಲ್ಲಿಗೆ ಹೋದರೂ ನಾನು ನಿಮ್ಮನ್ನು ಹಿಂಬಾಲಿಸುವೆನು,” ಎಂದನು.<verse eid="MAT 8:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 8:20"/>ಅದಕ್ಕೆ ಯೇಸು ಅವನಿಗೆ, “ನರಿಗಳಿಗೆ ಗುಹೆಗಳಿವೆ, ಆಕಾಶದಲ್ಲಿ ಹಾರಾಡುವ ಪಕ್ಷಿಗಳಿಗೆ ಗೂಡುಗಳಿವೆ, ಆದರೆ ಮನುಷ್ಯಪುತ್ರನಾದ<note caller="+" style="f"><char style="fr" closed="false">8:20 </char><char style="fq" closed="false">ಮನುಷ್ಯಪುತ್ರನು </char><char style="ft" closed="false">ಎಂಬುದು ಯೇಸುವನ್ನು ಸೂಚಿಸುತ್ತದೆ. </char><char style="fqa" closed="false">ಯೇಸು </char><char style="ft" closed="false">ಈ ರೀತಿಯಾಗಿ ತಮ್ಮ ಬಗ್ಗೆ ಮಾತನಾಡುತ್ತಿದ್ದರು.</char></note> ನನಗೆ ತಲೆಯಿಡುವುದಕ್ಕೂ ಸ್ಥಳ ಇಲ್ಲ,” ಎಂದರು.<verse eid="MAT 8:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 8:21"/>ಮತ್ತೊಬ್ಬ ಶಿಷ್ಯನು ಅವರಿಗೆ, “ಕರ್ತದೇವರೇ, ಮೊದಲು ನಾನು ಹೋಗಿ ನನ್ನ ತಂದೆಯ ಶವಸಂಸ್ಕಾರ ಮಾಡಿಬರಲು ಅನುಮತಿಕೊಡಿರಿ,” ಎಂದನು.<verse eid="MAT 8:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 8:22"/>ಆದರೆ ಯೇಸು ಅವನಿಗೆ, “ನನ್ನನ್ನು ಹಿಂಬಾಲಿಸು, ಸತ್ತವರೇ ತಮ್ಮವರಲ್ಲಿ ಸತ್ತುಹೋದವರನ್ನು ಸಮಾಧಿ ಮಾಡಿಕೊಳ್ಳಲಿ,” ಎಂದು ಹೇಳಿದರು.<verse eid="MAT 8:22"/></para>
  <para style="s1">ಯೇಸು ಬಿರುಗಾಳಿಯನ್ನು ನಿಲ್ಲಿಸಿದ್ದು</para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 8:23"/>ಯೇಸುವು ದೋಣಿಯನ್ನು ಹತ್ತಲು, ಶಿಷ್ಯರು ಸಹ ಅವರ ಸಂಗಡ ಹೋದರು. <verse eid="MAT 8:23"/><verse number="24" style="v" sid="MAT 8:24"/>ಇದ್ದಕ್ಕಿದ್ದ ಹಾಗೆ, ಸರೋವರದಲ್ಲಿ ದೊಡ್ಡ ಬಿರುಗಾಳಿ ಎದ್ದ ಕಾರಣ ದೋಣಿಯು ಅಲೆಗಳಿಂದ ಮುಚ್ಚುತ್ತಿತ್ತು. ಆದರೆ ಯೇಸು ನಿದ್ರಿಸುತ್ತಿದ್ದರು. <verse eid="MAT 8:24"/><verse number="25" style="v" sid="MAT 8:25"/>ಆಗ ಶಿಷ್ಯರು ಯೇಸುವಿನ ಬಳಿ ಬಂದು ಅವರನ್ನು ಎಬ್ಬಿಸಿ, “ಕರ್ತನೇ, ಕಾಪಾಡು! ನಾವು ಮುಳುಗುತ್ತಿದ್ದೇವೆ!” ಎಂದರು.<verse eid="MAT 8:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 8:26"/>ಆಗ ಯೇಸು ಅವರಿಗೆ, “ಅಲ್ಪವಿಶ್ವಾಸವುಳ್ಳವರೇ, ನೀವು ಏಕೆ ಭಯಪಡುತ್ತೀರಿ?” ಎಂದು ಹೇಳಿ, ಎದ್ದು ಬಿರುಗಾಳಿಯನ್ನೂ ಸರೋವರವನ್ನೂ ಗದರಿಸಿದರು. ಆಗ ಎಲ್ಲವೂ ಪ್ರಶಾಂತವಾಯಿತು.<verse eid="MAT 8:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 8:27"/>ಆದರೆ ಶಿಷ್ಯರು ಆಶ್ಚರ್ಯದಿಂದ, “ಇವರು ಎಂಥಾ ಮನುಷ್ಯನಾಗಿರಬಹುದು? ಗಾಳಿಯೂ ಸರೋವರವೂ ಸಹ ಇವರ ಮಾತುಗಳನ್ನು ಕೇಳುತ್ತವಲ್ಲಾ!” ಎಂದರು.<verse eid="MAT 8:27"/></para>
  <para style="s1">ಯೇಸು ಇಬ್ಬರಲ್ಲಿದ್ದ ಅನೇಕ ದೆವ್ವಗಳನ್ನು ಬಿಡಿಸಿದ್ದು</para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 8:28"/>ಯೇಸು ಆಚೆಯ ಕಡೆಯಲ್ಲಿದ್ದ ಗದರೇನರ<note caller="+" style="f"><char style="fr" closed="false">8:28 </char><char style="ft" closed="false">ಕೆಲವು ಹಸ್ತಪ್ರತಿಗಳಲ್ಲಿ </char><char style="fq" closed="false">ಗದರೇನ </char><char style="ft" closed="false">ಇಲ್ಲವೆ </char><char style="fqa" closed="false">ಗೆರಸೇನ </char><char style="ft" closed="false">ಎಂದಿವೆ.</char></note> ಪ್ರಾಂತಕ್ಕೆ ಬಂದಾಗ, ದೆವ್ವ ಹಿಡಿದಿದ್ದ ಇಬ್ಬರು ಸಮಾಧಿಯ ಗುಹೆಗಳಿಂದ ಬಂದು ಯೇಸುವಿಗೆ ಎದುರಾದರು. ಅವರು ಬಹು ಕ್ರೂರಿಗಳಾಗಿದ್ದುದರಿಂದ ಯಾರೂ ಆ ಮಾರ್ಗವಾಗಿ ಹೋಗಲಾಗುತ್ತಿರಲಿಲ್ಲ. <verse eid="MAT 8:28"/><verse number="29" style="v" sid="MAT 8:29"/>ಆಗ ಅವರು, “ದೇವಪುತ್ರನೇ, ನಮ್ಮ ಗೊಡವೆ ನಿಮಗೆ ಏಕೆ? ಸಮಯಕ್ಕೆ ಮುಂಚೆಯೇ ನಮ್ಮನ್ನು ಪೀಡಿಸಲು ಇಲ್ಲಿಗೆ ಬಂದೆಯಾ?” ಎಂದು ಕೂಗಿ ಹೇಳಿದರು.<verse eid="MAT 8:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="MAT 8:30"/>ಆಗ ಅವರಿಂದ ಸ್ವಲ್ಪ ದೂರದಲ್ಲಿ ಹಂದಿಗಳ ದೊಡ್ಡ ಹಿಂಡು ಮೇಯುತ್ತಿತ್ತು. <verse eid="MAT 8:30"/><verse number="31" style="v" sid="MAT 8:31"/>“ನೀನು ನಮ್ಮನ್ನು ಹೊರಗೆ ಹಾಕುವುದಾದರೆ ಆ ಹಂದಿಗಳ ಹಿಂಡಿಗೆ ನಮ್ಮನ್ನು ಕಳುಹಿಸಿಕೊಡಿ,” ಎಂದು ದೆವ್ವಗಳು ಯೇಸುವನ್ನು ಬೇಡಿಕೊಂಡವು.<verse eid="MAT 8:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 8:32"/>ಯೇಸು ಅವುಗಳಿಗೆ, “ಹೋಗಿರಿ,” ಎಂದರು. ಆಗ ಅವು ಹೊರಗೆ ಬಂದು ಹಂದಿಗಳ ಹಿಂಡನ್ನು ಹೊಕ್ಕವು. ಆಗ ಆ ಹಿಂಡೆಲ್ಲಾ ಕಡಿದಾದ ಬದಿಯಿಂದ ಓಡಿಹೋಗಿ ಸರೋವರದೊಳಗೆ ಬಿದ್ದು ಸತ್ತು ಹೋದವು. <verse eid="MAT 8:32"/><verse number="33" style="v" sid="MAT 8:33"/>ಆ ಹಂದಿಗಳನ್ನು ಮೇಯಿಸುತ್ತಿದ್ದವರು ಓಡಿಹೋಗಿ, ಪಟ್ಟಣದೊಳಕ್ಕೆ ಹೋಗಿ ದೆವ್ವ ಹಿಡಿದಿದ್ದವರಿಗೆ ಸಂಭವಿಸಿದ್ದನ್ನು ವರದಿಮಾಡಿದರು. <verse eid="MAT 8:33"/><verse number="34" style="v" sid="MAT 8:34"/>ಆಗ ಪಟ್ಟಣದವರೆಲ್ಲರೂ ಯೇಸುವನ್ನು ಕಾಣುವುದಕ್ಕೆ ಹೊರಗೆ ಬಂದರು. ಅವರು ಯೇಸುವನ್ನು ಕಂಡು, ತಮ್ಮ ಪ್ರಾಂತವನ್ನು ಬಿಟ್ಟುಹೋಗಬೇಕೆಂದು ಬೇಡಿಕೊಂಡರು.<verse eid="MAT 8:34"/></para>
  <chapter eid="MAT 8"/>
  <chapter number="9" style="c" sid="MAT 9"/>
  <para style="s1">ಯೇಸು ಪಾರ್ಶ್ವವಾಯು ರೋಗಿಯನ್ನು ಸ್ವಸ್ಥಮಾಡಿದ್ದು</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 9:1"/>ಯೇಸು ದೋಣಿ ಹತ್ತಿ, ಸರೋವರವನ್ನು ದಾಟಿ ತಮ್ಮ ಸ್ವಂತ ಪಟ್ಟಣಕ್ಕೆ ಬಂದರು. <verse eid="MAT 9:1"/><verse number="2" style="v" sid="MAT 9:2"/>ಆಗ ಹಾಸಿಗೆಯ ಮೇಲೆ ಮಲಗಿದ್ದ, ಒಬ್ಬ ಪಾರ್ಶ್ವವಾಯು ರೋಗಿಯನ್ನು ಜನರು ಯೇಸುವಿನ ಬಳಿಗೆ ತಂದರು. ಯೇಸು ಅವರ ನಂಬಿಕೆಯನ್ನು ಕಂಡು, ಆ ಪಾರ್ಶ್ವವಾಯು ರೋಗಿಗೆ, “ಮಗನೇ, ಧೈರ್ಯವಾಗಿರು. ನಿನ್ನ ಪಾಪಗಳು ಕ್ಷಮಿಸಲಾಗಿವೆ,” ಎಂದರು.<verse eid="MAT 9:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 9:3"/>ಆಗ ನಿಯಮ ಬೋಧಕರಲ್ಲಿ ಕೆಲವರು, “ಈತನು ದೇವದೂಷಣೆ ಮಾಡುತ್ತಿದ್ದಾನೆ,” ಎಂದು ತಮ್ಮತಮ್ಮೊಳಗೆ ಮಾತನಾಡಿಕೊಂಡರು.<verse eid="MAT 9:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 9:4"/>ಯೇಸು ಅವರ ಆಲೋಚನೆಗಳನ್ನು ತಿಳಿದುಕೊಂಡು, “ನೀವು ನಿಮ್ಮ ಮನಸ್ಸಿನಲ್ಲಿ ಕೆಟ್ಟದ್ದನ್ನು ಯೋಚಿಸುವುದೇಕೆ? <verse eid="MAT 9:4"/><verse number="5" style="v" sid="MAT 9:5"/>ಯಾವುದು ಸುಲಭ? ‘ನಿನ್ನ ಪಾಪಗಳು ಕ್ಷಮಿಸಲಾಗಿವೆ,’ ಎನ್ನುವುದೋ ಅಥವಾ ‘ಎದ್ದು ನಡೆ,’ ಎನ್ನುವುದೋ? <verse eid="MAT 9:5"/><verse number="6" style="v" sid="MAT 9:6"/>ಆದರೆ ಮನುಷ್ಯಪುತ್ರನಾದ ನನಗೆ ಈ ಭೂಲೋಕದಲ್ಲಿ ಪಾಪಗಳನ್ನು ಕ್ಷಮಿಸುವುದಕ್ಕೆ ಅಧಿಕಾರವುಂಟೆಂದು ನೀವು ತಿಳಿಯಬೇಕು,” ಎಂದು ಹೇಳಿ ಆ ಪಾರ್ಶ್ವವಾಯು ರೋಗಿಗೆ, “ಎದ್ದು ನಿನ್ನ ಹಾಸಿಗೆಯನ್ನು ಎತ್ತಿಕೊಂಡು ಮನೆಗೆ ಹೋಗು ಎಂದು ನಾನು ನಿನಗೆ ಹೇಳುತ್ತೇನೆ,” ಎಂದರು. <verse eid="MAT 9:6"/><verse number="7" style="v" sid="MAT 9:7"/>ಆಗ ಅವನು ಎದ್ದು ತನ್ನ ಮನೆಗೆ ಹೊರಟುಹೋದನು. <verse eid="MAT 9:7"/><verse number="8" style="v" sid="MAT 9:8"/>ಜನರ ಗುಂಪು ಇದನ್ನು ಕಂಡು ಬೆರಗಾಗಿ, ಮನುಷ್ಯರಿಗೆ ಇಂಥ ಅಧಿಕಾರವನ್ನು ಕೊಟ್ಟ ದೇವರನ್ನು ಕೊಂಡಾಡಿದರು.<verse eid="MAT 9:8"/></para>
  <para style="s1">ಮತ್ತಾಯನ ಕರೆಯುವಿಕೆ</para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 9:9"/>ಯೇಸು ಅಲ್ಲಿಂದ ಹಾದುಹೋಗುತ್ತಿದ್ದಾಗ, ಮತ್ತಾಯನೆಂಬ ಹೆಸರುಳ್ಳ ಒಬ್ಬ ಮನುಷ್ಯನು ಸುಂಕದ ಕಟ್ಟೆಯಲ್ಲಿ ಕೂತಿರುವುದನ್ನು ಕಂಡು ಅವನಿಗೆ, “ನನ್ನನ್ನು ಹಿಂಬಾಲಿಸು,” ಎಂದು ಹೇಳಿದರು. ಅವನು ಎದ್ದು ಯೇಸುವನ್ನು ಹಿಂಬಾಲಿಸಿದನು.<verse eid="MAT 9:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 9:10"/>ಇದಾದ ಮೇಲೆ ಯೇಸು ಮತ್ತಾಯನ ಮನೆಯಲ್ಲಿ ಊಟಕ್ಕೆ ಕುಳಿತಿದ್ದಾಗ, ಬಹುಮಂದಿ ಸುಂಕದವರೂ ಅಪಖ್ಯಾತಿಯ ಪಾಪಿಗಳೂ ಬಂದು ಯೇಸುವಿನೊಂದಿಗೂ ಅವರ ಶಿಷ್ಯರೊಂದಿಗೂ ಕುಳಿತುಕೊಂಡರು. <verse eid="MAT 9:10"/><verse number="11" style="v" sid="MAT 9:11"/>ಫರಿಸಾಯರು ಇದನ್ನು ಕಂಡು, “ನಿಮ್ಮ ಬೋಧಕನು ಸುಂಕದವರ ಮತ್ತು ಅಪಖ್ಯಾತಿಯ ಪಾಪಿಗಳ ಸಂಗಡ ಏಕೆ ಊಟಮಾಡುತ್ತಾನೆ?” ಎಂದು ಯೇಸುವಿನ ಶಿಷ್ಯರನ್ನು ಕೇಳಿದರು.<verse eid="MAT 9:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 9:12"/>ಆದರೆ ಯೇಸು ಇದನ್ನು ಕೇಳಿ ಅವರಿಗೆ, “ಆರೋಗ್ಯವಂತರಿಗೆ ವೈದ್ಯನು ಅವಶ್ಯವಿಲ್ಲ, ರೋಗಿಗಳಿಗೆ ವೈದ್ಯನು ಅವಶ್ಯ. <verse eid="MAT 9:12"/><verse number="13" style="v" sid="MAT 9:13"/>ಆದರೆ ನೀವು ಹೋಗಿ, ‘ನಾನು ಯಜ್ಞವನ್ನಲ್ಲ, ಕರುಣೆಯನ್ನೇ ಅಪೇಕ್ಷಿಸುತ್ತೇನೆ,’<note caller="+" style="f"><char style="fr" closed="false">9:13 </char><char style="ft" closed="false"><char style="xt"><ref loc="HOS 6:6">ಹೋಶೇ 6:6</ref></char></char></note> ಎಂಬುದರ ಅರ್ಥವನ್ನು ಕಲಿತುಕೊಳ್ಳಿರಿ. ಏಕೆಂದರೆ ನಾನು ನೀತಿವಂತರನ್ನಲ್ಲ, ಪಾಪಿಗಳನ್ನು ಕರೆಯಲು ಬಂದಿದ್ದೇನೆ,” ಎಂದು ಹೇಳಿದರು.<verse eid="MAT 9:13"/></para>
  <para style="s1">ಯೇಸುವಿಗೆ ಉಪವಾಸದ ವಿಷಯ ಪ್ರಶ್ನಿಸಿದ್ದು</para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 9:14"/>ಬಳಿಕ ಯೋಹಾನನ ಶಿಷ್ಯರು ಯೇಸುವಿನ ಬಳಿಗೆ ಬಂದು, “ನಾವೂ, ಫರಿಸಾಯರೂ ಉಪವಾಸ ಮಾಡುತ್ತೇವೆ. ಆದರೆ ನಿಮ್ಮ ಶಿಷ್ಯರು ಏಕೆ ಉಪವಾಸಮಾಡುವುದಿಲ್ಲ?” ಎಂದು ಕೇಳಿದರು.<verse eid="MAT 9:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 9:15"/>ಅದಕ್ಕೆ ಯೇಸು ಅವರಿಗೆ, “ಮದುಮಗನು ತಮ್ಮ ಜೊತೆಯಲ್ಲಿ ಇರುವ ತನಕ ಮದುಮಗನ ಆಪ್ತರು ದುಃಖಪಡುವುದುಂಟೇ? ಆದರೆ ಮದುಮಗನು ಅಗಲಬೇಕಾಗುವ ದಿವಸಗಳು ಬರುತ್ತವೆ; ಆಗ ಅವರು ಉಪವಾಸ ಮಾಡುವರು.<verse eid="MAT 9:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 9:16"/>“ಯಾರೂ ಹಳೆಯ ವಸ್ತ್ರಕ್ಕೆ ಹೊಸ ಬಟ್ಟೆಯ ತೇಪೆಯನ್ನು ಹಾಕುವುದಿಲ್ಲ. ಏಕೆಂದರೆ ಅದು ಆ ವಸ್ತ್ರವನ್ನು ಹಿಂಜುವುದರಿಂದ ಹರಕು ಹೆಚ್ಚಾಗುವುದು. <verse eid="MAT 9:16"/><verse number="17" style="v" sid="MAT 9:17"/>ಅಂತೆಯೇ ಜನರು ಹೊಸ ದ್ರಾಕ್ಷಾರಸವನ್ನು ಹಳೆಯ ಚರ್ಮದ ಚೀಲಗಳಲ್ಲಿ ತುಂಬಿಡುವುದಿಲ್ಲ. ಅವರು ಹಾಗೇನಾದರೂ ಮಾಡಿದರೆ ಚರ್ಮದ ಚೀಲಗಳು ಹರಿದು, ದ್ರಾಕ್ಷಾರಸವು ಚೆಲ್ಲಿಹೋಗಿ ಚರ್ಮದ ಚೀಲಗಳು ಹಾಳಾಗುತ್ತವೆ. ಹೊಸ ದ್ರಾಕ್ಷಾರಸವನ್ನು ಹೊಸ ಚರ್ಮದ ಚೀಲಗಳಲ್ಲಿ ತುಂಬಿಡುತ್ತಾರೆ. ಆಗ ಅವೆರಡೂ ಉಳಿಯುತ್ತವೆ,” ಎಂದರು.<verse eid="MAT 9:17"/></para>
  <para style="s1">ಸತ್ತ ಬಾಲಕಿ ಮತ್ತು ರೋಗಿಯಾದ ಸ್ತ್ರೀ</para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 9:18"/>ಯೇಸು ಇದೆಲ್ಲವನ್ನು ಅವರೊಂದಿಗೆ ಮಾತನಾಡುತ್ತಿದ್ದಾಗ, ಸಭಾಮಂದಿರದ ಒಬ್ಬ ಅಧಿಕಾರಿಯು ಬಂದು ಯೇಸುವಿನ ಮುಂದೆ ಮೊಣಕಾಲೂರಿ, “ನನ್ನ ಮಗಳು ಈಗ ತಾನೆ ಸತ್ತುಹೋದಳು. ಆದರೂ ನೀವು ಬಂದು ಆಕೆಯ ಮೇಲೆ ನಿಮ್ಮ ಕೈಯನ್ನಿಡಿರಿ; ಆಗ ಅವಳು ಬದುಕುವಳು,” ಎಂದು ಹೇಳಿದನು. <verse eid="MAT 9:18"/><verse number="19" style="v" sid="MAT 9:19"/>ಯೇಸು ಎದ್ದು ತಮ್ಮ ಶಿಷ್ಯರೊಂದಿಗೆ ಆ ಅಧಿಕಾರಿಯ ಹಿಂದೆ ಹೋದರು.<verse eid="MAT 9:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 9:20"/>ಆಗ ಅಲ್ಲಿ ಹನ್ನೆರಡು ವರ್ಷಗಳಿಂದ ರಕ್ತಸ್ರಾವ ರೋಗದಿಂದ ನರಳುತ್ತಿದ್ದ ಒಬ್ಬ ಸ್ತ್ರೀಯು ಹಿಂಬದಿಯಿಂದ ಬಂದು, ಯೇಸುವಿನ ನಿಲುವಂಗಿಯ ಅಂಚನ್ನು ಮುಟ್ಟಿ, <verse eid="MAT 9:20"/><verse number="21" style="v" sid="MAT 9:21"/>“ನಾನು ಯೇಸುವಿನ ಉಡುಪನ್ನು ಮುಟ್ಟಿದರೆ ಸಾಕು, ನನಗೆ ಗುಣವಾಗುವುದು,” ಎಂದು ಆಕೆಯು ತನ್ನೊಳಗೆ ಹೇಳಿಕೊಂಡಳು.<verse eid="MAT 9:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 9:22"/>ಯೇಸು ಹಿಂತಿರುಗಿ ಆಕೆಯನ್ನು ನೋಡಿ, “ಮಗಳೇ, ಧೈರ್ಯವಾಗಿರು; ನಿನ್ನ ನಂಬಿಕೆಯೇ ನಿನ್ನನ್ನು ಗುಣಪಡಿಸಿದೆ,” ಎಂದರು. ಆ ಗಳಿಗೆಯಲ್ಲೇ ಆ ಸ್ತ್ರೀಯು ಸ್ವಸ್ಥಳಾದಳು.<verse eid="MAT 9:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 9:23"/>ತರುವಾಯ ಯೇಸು ಆ ಅಧಿಕಾರಿಯ ಮನೆಯೊಳಗೆ ಬಂದು ಕೊಳಲೂದುವವರನ್ನೂ ಜನರ ಗೊಂದಲವನ್ನೂ ಕಂಡು, <verse eid="MAT 9:23"/><verse number="24" style="v" sid="MAT 9:24"/>ಅವರಿಗೆ, “ಹೊರಗೆ ಹೋಗಿರಿ, ಬಾಲಕಿಯು ಸತ್ತಿಲ್ಲ, ನಿದ್ರಿಸುತ್ತಿದ್ದಾಳೆ,” ಎಂದರು. ಅದಕ್ಕವರು ನಕ್ಕು ಯೇಸುವನ್ನು ಹಾಸ್ಯಮಾಡಿದರು. <verse eid="MAT 9:24"/><verse number="25" style="v" sid="MAT 9:25"/>ಆದರೆ ಜನರನ್ನು ಹೊರಗೆ ಕಳುಹಿಸಿದ ಮೇಲೆ ಯೇಸು ಒಳಗೆ ಹೋಗಿ, ಬಾಲಕಿಯ ಕೈಯನ್ನು ಹಿಡಿದು ಎಬ್ಬಿಸಿದಾಗ ಬಾಲಕಿಯು ಎದ್ದಳು. <verse eid="MAT 9:25"/><verse number="26" style="v" sid="MAT 9:26"/>ಈ ಸಮಾಚಾರವು ನಾಡಿನಲ್ಲೆಲ್ಲಾ ಹರಡಿತು.<verse eid="MAT 9:26"/></para>
  <para style="s1">ಯೇಸು ಕುರುಡರನ್ನು ಮತ್ತು ಮೂಕನನ್ನು ಸ್ವಸ್ಥಮಾಡಿದ್ದು</para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 9:27"/>ಯೇಸು ಅಲ್ಲಿಂದ ಹೋಗುತ್ತಿರುವಾಗ ಇಬ್ಬರು ಕುರುಡರು, “ದಾವೀದನ ಪುತ್ರನೇ, ನಮ್ಮ ಮೇಲೆ ಕರುಣೆಯಿಡು,” ಎಂದು ಮೊರೆಯಿಡುತ್ತಾ ಯೇಸುವಿನ ಹಿಂದೆ ಹೋದರು.<verse eid="MAT 9:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 9:28"/>ಯೇಸು ಮನೆಗೆ ಬಂದಾಗ, ಆ ಕುರುಡರು ಅವರ ಬಳಿಗೆ ಬಂದರು. ಆಗ ಯೇಸು ಅವರಿಗೆ, “ನಾನು ಇದನ್ನು ಮಾಡಲು ಶಕ್ತನೆಂದು ನೀವು ನಂಬುತ್ತೀರೋ?” ಎಂದು ಕೇಳಿದರು.</para>
  <para style="p" vid="MAT 9:28">ಅದಕ್ಕವರು ಯೇಸುವಿಗೆ, “ಹೌದು ಕರ್ತನೆ,” ಎಂದರು.<verse eid="MAT 9:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 9:29"/>ಆಗ ಯೇಸು ಅವರ ಕಣ್ಣುಗಳನ್ನು ಮುಟ್ಟಿ, “ನಿಮ್ಮ ನಂಬಿಕೆಯಂತೆ ನಿಮಗಾಗಲಿ,” ಎಂದು ಹೇಳಿದರು. <verse eid="MAT 9:29"/><verse number="30" style="v" sid="MAT 9:30"/>ಆಗ ಅವರಿಗೆ ದೃಷ್ಟಿ ಬಂದಿತು. ಯೇಸು ಅವರಿಗೆ, “ಇದು ಯಾರಿಗೂ ತಿಳಿಯಬಾರದು,” ಎಂದು ಅವರಿಗೆ ಖಂಡಿತವಾಗಿ ಎಚ್ಚರಿಸಿದರು. <verse eid="MAT 9:30"/><verse number="31" style="v" sid="MAT 9:31"/>ಆದರೆ ಸ್ವಸ್ಥರಾದವರು ಹೊರಟುಹೋಗಿ, ಆ ನಾಡಿನಲ್ಲೆಲ್ಲಾ ಯೇಸುವಿನ ಕೀರ್ತಿಯನ್ನು ಹರಡಿದರು.<verse eid="MAT 9:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 9:32"/>ಯೇಸು ಮತ್ತು ಶಿಷ್ಯರು ಹೊರಟು ಹೋಗುತ್ತಿದ್ದಾಗ, ದೆವ್ವ ಹಿಡಿದಿದ್ದ ಒಬ್ಬ ಮೂಕನನ್ನು ಕೆಲವರು ಯೇಸುವಿನ ಬಳಿಗೆ ತಂದರು. <verse eid="MAT 9:32"/><verse number="33" style="v" sid="MAT 9:33"/>ದೆವ್ವ ಬಿಡಿಸಿದ ಮೇಲೆ, ಆ ಮೂಕನು ಮಾತನಾಡಿದನು. ಜನರು ಆಶ್ಚರ್ಯಪಟ್ಟು, “ಇಂಥದ್ದನ್ನು ಎಂದೂ ಇಸ್ರಾಯೇಲಿನಲ್ಲಿ ಕಂಡಿಲ್ಲ,” ಎಂದು ಹೇಳಿದರು.<verse eid="MAT 9:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 9:34"/>ಆದರೆ ಫರಿಸಾಯರು, “ದೆವ್ವಗಳ ಅಧಿಪತಿಯಿಂದಲೇ ಈತನು ದೆವ್ವಗಳನ್ನು ಓಡಿಸುತ್ತಾನೆ,” ಎಂದರು.<verse eid="MAT 9:34"/></para>
  <para style="s1">ಕೆಲಸದವರು ಕೆಲವರೇ</para>
  <para style="p">
    <verse number="35" style="v" sid="MAT 9:35"/>ಯೇಸು ಎಲ್ಲಾ ಹಳ್ಳಿಗಳಲ್ಲಿಯೂ ಪಟ್ಟಣಗಳಲ್ಲಿಯೂ ಇದ್ದ ಸಭಾಮಂದಿರಗಳಲ್ಲಿ ಬೋಧಿಸುತ್ತಾ, ರಾಜ್ಯದ ಸುವಾರ್ತೆಯನ್ನು ಸಾರುತ್ತಾ, ಜನರ ಪ್ರತಿಯೊಂದು ವ್ಯಾಧಿಯನ್ನೂ ರೋಗವನ್ನೂ ಗುಣಪಡಿಸುತ್ತಾ ಸಂಚರಿಸಿದರು. <verse eid="MAT 9:35"/><verse number="36" style="v" sid="MAT 9:36"/>ಜನಸಮೂಹವೂ ಕುರುಬನಿಲ್ಲದ ಕುರಿಗಳಂತೆ ಅಲೆಯುವವರಾಗಿಯೂ ನಿಸ್ಸಹಾಯಕರಾಗಿಯೂ ಇರುವುದನ್ನು ಕಂಡು ಯೇಸು ಅವರ ಮೇಲೆ ಕನಿಕರಪಟ್ಟರು. <verse eid="MAT 9:36"/><verse number="37" style="v" sid="MAT 9:37"/>ಆಗ ಯೇಸು ತಮ್ಮ ಶಿಷ್ಯರಿಗೆ, “ಬೆಳೆಯೇನೋ ಬಹಳವಾಗಿದೆ, ಕೆಲಸದವರೋ ಕೆಲವರು. <verse eid="MAT 9:37"/><verse number="38" style="v" sid="MAT 9:38"/>ಆದ್ದರಿಂದ, ಬೆಳೆಯ ಯಜಮಾನನನ್ನು ತನ್ನ ಬೆಳೆಗೆ ತಕ್ಕಷ್ಟು ಕೆಲಸದವರನ್ನು ಕಳುಹಿಸುವಂತೆ, ನೀವು ಬೇಡಿಕೊಳ್ಳಿರಿ,” ಎಂದರು.<verse eid="MAT 9:38"/></para>
  <chapter eid="MAT 9"/>
  <chapter number="10" style="c" sid="MAT 10"/>
  <para style="s1">ಯೇಸು ಶಿಷ್ಯರನ್ನು ಕಳುಹಿಸಿದ್ದು</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 10:1"/>ಯೇಸು ತಮ್ಮ ಹನ್ನೆರಡು ಮಂದಿ ಶಿಷ್ಯರನ್ನು ತಮ್ಮ ಬಳಿಗೆ ಕರೆದು, ಅಶುದ್ಧಾತ್ಮಗಳನ್ನು ಓಡಿಸುವುದಕ್ಕೂ ಎಲ್ಲಾ ತರವಾದ ವ್ಯಾಧಿಯನ್ನೂ ರೋಗವನ್ನೂ ಸ್ವಸ್ಥಮಾಡುವುದಕ್ಕೂ ಅವರಿಗೆ ಅಧಿಕಾರವನ್ನು ಕೊಟ್ಟರು.<verse eid="MAT 10:1"/></para>
  <para style="b"/>
  <para style="li4">
    <verse number="2" style="v" sid="MAT 10:2"/>ಆ ಹನ್ನೆರಡು ಮಂದಿ ಅಪೊಸ್ತಲರ ಹೆಸರುಗಳು ಹೀಗಿದ್ದವು:</para>
  <para style="b" vid="MAT 10:2"/>
  <para style="li1" vid="MAT 10:2">ಮೊದಲನೆಯವನು, ಪೇತ್ರ ಎಂದು ಎನಿಸಿಕೊಂಡ ಸೀಮೋನ, ಅವನ ಸಹೋದರ ಅಂದ್ರೆಯ;</para>
  <para style="li1" vid="MAT 10:2">ಜೆಬೆದಾಯನ ಮಗ ಯಾಕೋಬ ಮತ್ತು ಅವನ ಸಹೋದರ ಯೋಹಾನ;<verse eid="MAT 10:2"/></para>
  <para style="li1">
    <verse number="3" style="v" sid="MAT 10:3"/>ಫಿಲಿಪ್ಪ, ಬಾರ್ತೊಲೊಮಾಯ;</para>
  <para style="li1" vid="MAT 10:3">ತೋಮ, ಸುಂಕದವನಾದ ಮತ್ತಾಯ;</para>
  <para style="li1" vid="MAT 10:3">ಅಲ್ಫಾಯನ ಮಗ ಯಾಕೋಬ, ತದ್ದಾಯ;<verse eid="MAT 10:3"/></para>
  <para style="li1">
    <verse number="4" style="v" sid="MAT 10:4"/>ಕಾನಾನ್ಯನಾದ ಸೀಮೋನ<note caller="+" style="f"><char style="fr" closed="false">10:4 </char><char style="ft" closed="false">ರೋಮನ್ನರ ವಿರುದ್ಧ ಹೋರಾಡಿದ ರಾಜಕೀಯ ಪಂಗಡ</char></note> ಮತ್ತು ಯೇಸುವನ್ನು ಹಿಡಿದುಕೊಟ್ಟ ಇಸ್ಕರಿಯೋತ ಯೂದ.<verse eid="MAT 10:4"/></para>
  <para style="b"/>
  <para style="p">
    <verse number="5" style="v" sid="MAT 10:5"/>ಯೇಸು ಈ ಹನ್ನೆರಡು ಮಂದಿಯನ್ನು ಕಳುಹಿಸುವಾಗ ಅವರಿಗೆ ಅಪ್ಪಣೆ ಕೊಟ್ಟಿದ್ದೇನೆಂದರೆ: “ಯೆಹೂದ್ಯರಲ್ಲದವರ ಬಳಿಗೆ ಹೋಗಬೇಡಿರಿ, ಸಮಾರ್ಯರ ಊರನ್ನೂ ಪ್ರವೇಶಿಸಬೇಡಿರಿ. <verse eid="MAT 10:5"/><verse number="6" style="v" sid="MAT 10:6"/>ಆದರೆ ತಪ್ಪಿಹೋದ ಕುರಿಗಳಾದ ಇಸ್ರಾಯೇಲಿನ ಮನೆತನದವರ ಬಳಿಗೆ ಹೋಗಿರಿ. <verse eid="MAT 10:6"/><verse number="7" style="v" sid="MAT 10:7"/>ನೀವು ಹೋಗುತ್ತಾ, ‘ಪರಲೋಕ ರಾಜ್ಯವು ಸಮೀಪವಾಯಿತು,’ ಎಂದು ಸಾರಿ ಹೇಳಿರಿ. <verse eid="MAT 10:7"/><verse number="8" style="v" sid="MAT 10:8"/>ರೋಗಿಗಳನ್ನು ಸ್ವಸ್ಥಮಾಡಿರಿ, ಮರಣಹೊಂದಿದವರನ್ನು ಎಬ್ಬಿಸಿರಿ, ಕುಷ್ಠರೋಗಿಗಳನ್ನು ಶುದ್ಧಮಾಡಿರಿ, ದೆವ್ವಗಳನ್ನು ಬಿಡಿಸಿರಿ. ನೀವು ಉಚಿತವಾಗಿ ಪಡೆದಿದ್ದೀರಿ; ಉಚಿತವಾಗಿ ಕೊಡಿರಿ.<verse eid="MAT 10:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 10:9"/>“ನಿಮ್ಮ ನಡುಕಟ್ಟುಗಳಲ್ಲಿ ಬಂಗಾರ, ಬೆಳ್ಳಿ ಮತ್ತು ತಾಮ್ರದ ನಾಣ್ಯಗಳನ್ನು ಇಟ್ಟುಕೊಳ್ಳಬೇಡಿರಿ. <verse eid="MAT 10:9"/><verse number="10" style="v" sid="MAT 10:10"/>ಪ್ರಯಾಣಕ್ಕೆ ಚೀಲವನ್ನಾಗಲಿ, ಎರಡು ಅಂಗಿಗಳನ್ನಾಗಲಿ, ಪಾದರಕ್ಷೆಗಳನ್ನಾಗಲಿ, ಕೋಲುಗಳನ್ನಾಗಲಿ ತೆಗೆದುಕೊಳ್ಳಬೇಡಿರಿ. ಏಕೆಂದರೆ ಕೆಲಸದವನು ತನ್ನ ಜೀವನಾಧಾರಕ್ಕೆ ಅರ್ಹನು. <verse eid="MAT 10:10"/><verse number="11" style="v" sid="MAT 10:11"/>ನೀವು ಯಾವುದಾದರೂ ಒಂದು ಪಟ್ಟಣವನ್ನು, ಇಲ್ಲವೆ ಹಳ್ಳಿಯನ್ನು ಪ್ರವೇಶಿಸುವಾಗ, ಅದರಲ್ಲಿ ಯೋಗ್ಯ ವ್ಯಕ್ತಿ ಯಾರೆಂದು ವಿಚಾರಿಸಿರಿ, ಅಲ್ಲಿಂದ ಹೊರಡುವವರೆಗೆ ಅಲ್ಲಿಯೇ ತಂಗಿರಿ. <verse eid="MAT 10:11"/><verse number="12" style="v" sid="MAT 10:12"/>ನೀವು ಒಂದು ಮನೆಯೊಳಗೆ ಪ್ರವೇಶಿಸಿದಾಗ, ಆ ಮನೆಯವರನ್ನು ಹರಸಿರಿ. <verse eid="MAT 10:12"/><verse number="13" style="v" sid="MAT 10:13"/>ಆ ಮನೆಯು ಅಯೋಗ್ಯವಾಗಿದ್ದರೆ, ನಿಮ್ಮ ಸಮಾಧಾನವು ನಿಮಗೆ ಹಿಂದಿರುಗಲಿ. <verse eid="MAT 10:13"/><verse number="14" style="v" sid="MAT 10:14"/>ಯಾರಾದರೂ ನಿಮ್ಮನ್ನು ಸ್ವಾಗತಿಸದೆ ಹೋದರೆ ಇಲ್ಲವೆ ನಿಮ್ಮ ಮಾತುಗಳನ್ನು ಕೇಳದೆ ಹೋದರೆ, ನೀವು ಆ ಮನೆಯನ್ನು ಇಲ್ಲವೆ ಆ ಪಟ್ಟಣವನ್ನು ಬಿಟ್ಟು ಹೊರಡುವಾಗ ನಿಮ್ಮ ಪಾದಗಳಿಗೆ ಹತ್ತಿದ ಧೂಳನ್ನು ಝಾಡಿಸಿಬಿಡಿರಿ. <verse eid="MAT 10:14"/><verse number="15" style="v" sid="MAT 10:15"/>ನ್ಯಾಯತೀರ್ಪಿನ ದಿನದಲ್ಲಿ ಸೊದೋಮ್ ಮತ್ತು ಗೊಮೋರ ಪಟ್ಟಣಗಳ ಗತಿಯು<note caller="+" style="f"><char style="fr" closed="false">10:15 </char><char style="ft" closed="false">ಈ ಎರಡು ಪಟ್ಟಣಗಳ ದುಷ್ಟಜನರನ್ನು ನಾಶಮಾಡಲು ದೇವರು ಬೆಂಕಿಯ ಮಳೆಯನ್ನು ಸುರಿಸಿದರು. ನೋಡಿರಿ ಆದಿ <char style="xt"><ref loc="MAT 19:1-19">19:1-19</ref></char></char></note> ಆ ಪಟ್ಟಣಕ್ಕಿಂತ ಹೆಚ್ಚು ತಾಳುವಂಥದ್ದಾಗಿರುವುದು ಎಂದು ನಾನು ನಿಮಗೆ ನಿಜವಾಗಿ ಹೇಳುತ್ತೇನೆ.<verse eid="MAT 10:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 10:16"/>“ತೋಳಗಳ ಮಧ್ಯದಲ್ಲಿ ಕುರಿಗಳನ್ನು ಕಳುಹಿಸುವಂತೆ ನಾನು ನಿಮ್ಮನ್ನು ಕಳುಹಿಸುತ್ತೇನೆ. ಆದ್ದರಿಂದ ನೀವು ಸರ್ಪಗಳಂತೆ ಜಾಣರೂ ಪಾರಿವಾಳಗಳಂತೆ ನಿಷ್ಕಪಟಿಗಳೂ ಆಗಿರಿ. <verse eid="MAT 10:16"/><verse number="17" style="v" sid="MAT 10:17"/>ಆದರೆ ಜನರ ವಿಷಯದಲ್ಲಿ ಎಚ್ಚರಿಕೆಯಾಗಿರಿ. ಏಕೆಂದರೆ ಅವರು ನಿಮ್ಮನ್ನು ನ್ಯಾಯಸ್ಥಾನಗಳಿಗೆ ಒಪ್ಪಿಸುವರು. ತಮ್ಮ ಸಭಾಮಂದಿರಗಳಲ್ಲಿ ನಿಮ್ಮನ್ನು ಕೊರಡೆಗಳಿಂದ ಹೊಡೆಯುವರು. <verse eid="MAT 10:17"/><verse number="18" style="v" sid="MAT 10:18"/>ನನ್ನ ನಿಮಿತ್ತವಾಗಿ ನಿಮ್ಮನ್ನು ಅಧಿಕಾರಿಗಳ ಮತ್ತು ಅರಸರ ಮುಂದೆ ಒಯ್ಯುವರು. ಹೀಗೆ ಅವರಿಗೂ ಯೆಹೂದ್ಯರಲ್ಲದವರಿಗೂ ನೀವು ಸಾಕ್ಷಿಗಳಾಗುವಿರಿ. <verse eid="MAT 10:18"/><verse number="19" style="v" sid="MAT 10:19"/>ಆದರೆ ಅವರು ನಿಮ್ಮನ್ನು ಬಂಧಿಸುವಾಗ, ನೀವು ಹೇಗೆ ಇಲ್ಲವೆ ಏನು ಮಾತನಾಡಬೇಕೆಂದು ಯೋಚಿಸಬೇಡಿರಿ. ನೀವು ಏನು ಮಾತನಾಡಬೇಕೆಂಬುದು ಆ ಗಳಿಗೆಯಲ್ಲೇ ನಿಮಗೆ ತಿಳಿಸಲಾಗುವುದು, <verse eid="MAT 10:19"/><verse number="20" style="v" sid="MAT 10:20"/>ಏಕೆಂದರೆ ಮಾತನಾಡುವವರು ನೀವಲ್ಲ, ನಿಮ್ಮ ತಂದೆಯ ಆತ್ಮವೇ ನಿಮ್ಮೊಳಗಿಂದ ಮಾತನಾಡುವರು.<verse eid="MAT 10:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 10:21"/>“ಸಹೋದರನು ತನ್ನ ಸಹೋದರನನ್ನೂ, ತಂದೆಯು ಮಗನನ್ನೂ ಮರಣಕ್ಕೆ ಒಪ್ಪಿಸುವರು. ಮಕ್ಕಳು ತಮ್ಮ ತಂದೆತಾಯಿಗಳಿಗೆ ವಿರೋಧವಾಗಿ ಎದ್ದು ಅವರನ್ನು ಕೊಲ್ಲಿಸುವರು. <verse eid="MAT 10:21"/><verse number="22" style="v" sid="MAT 10:22"/>ನನ್ನ ಹೆಸರಿನ ನಿಮಿತ್ತವಾಗಿ ಎಲ್ಲರೂ ನಿಮ್ಮನ್ನು ದ್ವೇಷಮಾಡುವರು. ಆದರೆ ಕೊನೆಯವರೆಗೂ ತಾಳುವವನೇ ರಕ್ಷಣೆಹೊಂದುವನು. <verse eid="MAT 10:22"/><verse number="23" style="v" sid="MAT 10:23"/>ಒಂದು ಸ್ಥಳದಲ್ಲಿ ನಿಮಗೆ ಹಿಂಸೆಯಾದರೆ ಇನ್ನೊಂದು ಸ್ಥಳಕ್ಕೆ ಓಡಿಹೋಗಿರಿ. ಮನುಷ್ಯಪುತ್ರನು ಬರುವಷ್ಟರಲ್ಲಿ ಇಸ್ರಾಯೇಲಿನ ಪಟ್ಟಣಗಳ ಸಂಚಾರವನ್ನು ನೀವು ಮುಗಿಸುವುದಿಲ್ಲವೆಂದು ನಾನು ನಿಮಗೆ ನಿಜವಾಗಿ ಹೇಳುತ್ತೇನೆ.<verse eid="MAT 10:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 10:24"/>“ತನ್ನ ಗುರುವಿಗಿಂತ ಶಿಷ್ಯನು ಶ್ರೇಷ್ಠನಲ್ಲ; ದಾಸನು ತನ್ನ ಯಜಮಾನನಿಗಿಂತ ಶ್ರೇಷ್ಠನಲ್ಲ. <verse eid="MAT 10:24"/><verse number="25" style="v" sid="MAT 10:25"/>ಶಿಷ್ಯನು ತನ್ನ ಗುರುವಿನಂತೆಯೂ ದಾಸನು ತನ್ನ ಯಜಮಾನನಂತೆಯೂ ಇದ್ದರೆ ಸಾಕು. ಮನೆಯ ಯಜಮಾನನನ್ನೇ ಅವರು, ‘ಬೆಲ್ಜೆಬೂಲನು’<note caller="+" style="f"><char style="fr" closed="false">10:25 </char><char style="fq" closed="false">ಬೆಲ್ಜೆಬೂಲನು </char><char style="ft" closed="false">ಅಂದರೆ </char><char style="fqa" closed="false">ದೆವ್ವಗಳ ರಾಜ</char></note> ಎಂದು ಕರೆದರೆ, ಯಜಮಾನನ ಮನೆಯವರನ್ನು ಇನ್ನೂ ಎಷ್ಟೋ ಕೆಟ್ಟದ್ದಾಗಿ ಕರೆಯುವರಲ್ಲವೇ!<verse eid="MAT 10:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 10:26"/>“ಆದ್ದರಿಂದ ಅವರಿಗೆ ಹೆದರಬೇಡಿರಿ, ಪ್ರಕಟಗೊಳ್ಳದಂತೆ ಯಾವುದೂ ಮುಚ್ಚಿಡಲಾಗುವುದಿಲ್ಲ, ತಿಳಿಯಲಾಗದಂತೆ ಯಾವುದೂ ಗುಪ್ತವಾಗಿರುವುದಿಲ್ಲ. <verse eid="MAT 10:26"/><verse number="27" style="v" sid="MAT 10:27"/>ನಾನು ನಿಮಗೆ ಕತ್ತಲಲ್ಲಿ ಹೇಳುವುದನ್ನು ನೀವು ಬೆಳಕಿನಲ್ಲಿ ಹೇಳಿರಿ. ನೀವು ಕಿವಿಯಲ್ಲಿ ಕೇಳುವುದನ್ನು ಮಾಳಿಗೆಯ ಮೇಲೆ ಸಾರಿರಿ. <verse eid="MAT 10:27"/><verse number="28" style="v" sid="MAT 10:28"/>ದೇಹವನ್ನು ಕೊಂದು ಆತ್ಮವನ್ನು ಕೊಲ್ಲಲಾಗದವರಿಗೆ ಹೆದರಬೇಡಿರಿ. ಆದರೆ ಆತ್ಮ ಮತ್ತು ದೇಹ ಎರಡನ್ನೂ ನರಕದಲ್ಲಿ ನಾಶಮಾಡಬಲ್ಲ ದೇವರಿಗೆ ಭಯಪಡಿರಿ. <verse eid="MAT 10:28"/><verse number="29" style="v" sid="MAT 10:29"/>ಒಂದು ರೂಪಾಯಿಗೆ<note caller="+" style="f"><char style="fr" closed="false">10:29 </char><char style="ft" closed="false">ಇದು ಒಂದು ತಾಮ್ರದ ನಾಣ್ಯ. ಇದರ ಬೆಲೆ ಒಂದು ರೂಪಾಯಿಯ ಹದಿನಾರನೆಯ ಭಾಗ. ಅಂದರೆ ಒಬ್ಬ ಮನುಷ್ಯನ ಅರ್ಧಗಂಟೆಯ ಕೂಲಿಗೆ ಸಮ.</char></note> ಎರಡು ಗುಬ್ಬಿಗಳನ್ನು ಮಾರುವುದಿಲ್ಲವೇ? ಆದರೂ ನಿಮ್ಮ ತಂದೆಯ ಚಿತ್ತವಿಲ್ಲದೆ ಅವುಗಳಲ್ಲಿ ಒಂದಾದರೂ ನೆಲಕ್ಕೆ ಬೀಳುವುದಿಲ್ಲ. <verse eid="MAT 10:29"/><verse number="30" style="v" sid="MAT 10:30"/>ನಿಮ್ಮ ತಲೆಯ ಕೂದಲುಗಳು ಸಹ ಎಲ್ಲವೂ ಎಣಿಕೆಯಾಗಿವೆ. <verse eid="MAT 10:30"/><verse number="31" style="v" sid="MAT 10:31"/>ಆದ್ದರಿಂದ ಭಯಪಡಬೇಡಿರಿ; ಅನೇಕ ಗುಬ್ಬಿಗಳಿಗಿಂತಲೂ ನೀವು ಎಷ್ಟೋ ಮೌಲ್ಯವುಳ್ಳವರು.<verse eid="MAT 10:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 10:32"/>“ಜನರ ಮುಂದೆ ನನ್ನನ್ನು ಒಪ್ಪಿಕೊಳ್ಳುವ ಪ್ರತಿಯೊಬ್ಬನನ್ನು, ನಾನು ಸಹ ಪರಲೋಕದಲ್ಲಿ ನನ್ನ ತಂದೆಯ ಮುಂದೆ ಒಪ್ಪಿಕೊಳ್ಳುವೆನು. <verse eid="MAT 10:32"/><verse number="33" style="v" sid="MAT 10:33"/>ಯಾವನಾದರೂ ಜನರ ಮುಂದೆ ನನ್ನನ್ನು ನಿರಾಕರಿಸಿದರೆ, ನಾನು ಸಹ ಅವನನ್ನು ಪರಲೋಕದಲ್ಲಿರುವ ನನ್ನ ತಂದೆಯ ಮುಂದೆ ನಿರಾಕರಿಸುವೆನು.<verse eid="MAT 10:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 10:34"/>“ನಾನು ಭೂಮಿಯ ಮೇಲೆ ಸಮಾಧಾನವನ್ನು ತರಲು ಬಂದೆನೆಂದು ಭಾವಿಸಬೇಡಿರಿ. ಸಮಾಧಾನವನ್ನಲ್ಲ, ಖಡ್ಗವನ್ನು ತರಲು ಬಂದೆನು. <verse eid="MAT 10:34"/><verse number="35" style="v" sid="MAT 10:35"/>ಹೇಗೆಂದರೆ,</para>
  <para style="q1" vid="MAT 10:35">“ ‘ಮಗನಿಗೂ ಅವನ ತಂದೆಗೂ,</para>
  <para style="q2" vid="MAT 10:35">ಮಗಳಿಗೂ ಆಕೆಯ ತಾಯಿಗೂ,</para>
  <para style="q1" vid="MAT 10:35">ಸೊಸೆಗೂ ಆಕೆಯ ಅತ್ತೆಗೂ ವಿರೋಧವನ್ನು ಹುಟ್ಟಿಸುವುದಕ್ಕೆ ನಾನು ಬಂದೆನು.<verse eid="MAT 10:35"/></para>
  <para style="q2">
    <verse number="36" style="v" sid="MAT 10:36"/>ಒಬ್ಬ ಮನುಷ್ಯನಿಗೆ ಅವನ ಮನೆಯವರೇ ವೈರಿಗಳಾಗುವರು.’<note caller="+" style="f"><char style="fr" closed="false">10:36 </char><char style="ft" closed="false"><char style="xt"><ref loc="MIC 7:6">ಮೀಕ 7:6</ref></char></char></note><verse eid="MAT 10:36"/></para>
  <para style="p">
    <verse number="37" style="v" sid="MAT 10:37"/>“ನನಗಿಂತ ಮೇಲಾಗಿ ತಂದೆಯನ್ನಾಗಲಿ, ತಾಯಿಯನ್ನಾಗಲಿ ಪ್ರೀತಿಸುವವನು ನನ್ನವನಾಗಲು ಯೋಗ್ಯನಲ್ಲ. ಮಗನನ್ನಾಗಲಿ, ಮಗಳನ್ನಾಗಲಿ ನನಗಿಂತ ಮೇಲಾಗಿ ಪ್ರೀತಿಸುವವನು ನನ್ನವನಾಗಲು ಯೋಗ್ಯನಲ್ಲ. <verse eid="MAT 10:37"/><verse number="38" style="v" sid="MAT 10:38"/>ತನ್ನ ಶಿಲುಬೆಯನ್ನು ತೆಗೆದುಕೊಂಡು ನನ್ನನ್ನು ಹಿಂಬಾಲಿಸದವನು ನನ್ನವನಾಗಲು ಯೋಗ್ಯನಲ್ಲ. <verse eid="MAT 10:38"/><verse number="39" style="v" sid="MAT 10:39"/>ತನ್ನ ಪ್ರಾಣವನ್ನು ಕಂಡುಕೊಳ್ಳುವವನು ಅದನ್ನು ಕಳೆದುಕೊಳ್ಳುವನು. ನನ್ನ ನಿಮಿತ್ತವಾಗಿ ತನ್ನ ಪ್ರಾಣವನ್ನು ಕಳೆದುಕೊಳ್ಳುವವನು ಅದನ್ನು ಕಂಡುಕೊಳ್ಳುವನು.<verse eid="MAT 10:39"/></para>
  <para style="p">
    <verse number="40" style="v" sid="MAT 10:40"/>“ನಿಮ್ಮನ್ನು ಸ್ವಾಗತಿಸುವವರು ನನ್ನನ್ನು ಸ್ವಾಗತಿಸುತ್ತಾರೆ. ನನ್ನನ್ನು ಸ್ವಾಗತಿಸಿದವರು, ನನ್ನನ್ನು ಕಳುಹಿಸಿದ ತಂದೆಯನ್ನು ಸ್ವಾಗತಿಸುತ್ತಾರೆ. <verse eid="MAT 10:40"/><verse number="41" style="v" sid="MAT 10:41"/>ಪ್ರವಾದಿಯೆಂದು ಪ್ರವಾದಿಯನ್ನು ಸ್ವಾಗತಿಸುವವರು ಪ್ರವಾದಿಯ ಪ್ರತಿಫಲವನ್ನು ಪಡೆಯುವರು; ನೀತಿವಂತನೆಂದು ನೀತಿವಂತನನ್ನು ಸ್ವಾಗತಿಸುವವರು ನೀತಿವಂತನ ಪ್ರತಿಫಲವನ್ನು ಪಡೆಯುವರು. <verse eid="MAT 10:41"/><verse number="42" style="v" sid="MAT 10:42"/>ಯಾವನಾದರೂ ಈ ಚಿಕ್ಕವರಲ್ಲಿ ಒಬ್ಬನಿಗೆ ನನ್ನ ಶಿಷ್ಯನೆಂದು ಕೇವಲ ಒಂದು ಲೋಟ ತಣ್ಣೀರನ್ನು ಕುಡಿಯುವುದಕ್ಕೆ ಕೊಡುವವನು ತನ್ನ ಪ್ರತಿಫಲವನ್ನು ಕಳೆದುಕೊಳ್ಳುವುದೇ ಇಲ್ಲವೆಂದು ಸತ್ಯವಾಗಿ ನಾನು ನಿಮಗೆ ಹೇಳುತ್ತೇನೆ.”<verse eid="MAT 10:42"/></para>
  <chapter eid="MAT 10"/>
  <chapter number="11" style="c" sid="MAT 11"/>
  <para style="s1">ಯೇಸು ಮತ್ತು ಸ್ನಾನಿಕ ಯೋಹಾನನು</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 11:1"/>ಯೇಸು ತಮ್ಮ ಹನ್ನೆರಡು ಮಂದಿ ಶಿಷ್ಯರಿಗೆ ಆದೇಶ ಕೊಟ್ಟಾದ ಮೇಲೆ, ಗಲಿಲಾಯ ಪ್ರದೇಶದ ಪಟ್ಟಣಗಳಲ್ಲಿ ಬೋಧಿಸುವುದಕ್ಕೂ ಶುಭವರ್ತಮಾನವನ್ನು ಸಾರುವುದಕ್ಕೂ ಅಲ್ಲಿಂದ ಹೊರಟು ಹೋದರು.<verse eid="MAT 11:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="MAT 11:2"/>ಆಗ ಸೆರೆಮನೆಯಲ್ಲಿ ಯೋಹಾನನು ಕ್ರಿಸ್ತನ ಕಾರ್ಯಗಳನ್ನು ಕೇಳಿ, ತನ್ನ ಶಿಷ್ಯರನ್ನು ಕಳುಹಿಸಿ ಯೇಸುವಿಗೆ, <verse eid="MAT 11:2"/><verse number="3" style="v" sid="MAT 11:3"/>“ಬರಬೇಕಾದ ಮೆಸ್ಸೀಯ ನೀನೋ ಇಲ್ಲವೇ ನಾವು ಇನ್ನೊಬ್ಬನಿಗಾಗಿ ಎದುರು ನೋಡಬೇಕೋ?” ಎಂದು ವಿಚಾರಿಸಿದನು.<verse eid="MAT 11:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 11:4"/>ಯೇಸು, “ನೀವು ಕೇಳುವುದನ್ನೂ ಕಾಣುವುದನ್ನೂ ಯೋಹಾನನಿಗೆ ಹೋಗಿ ತಿಳಿಸಿರಿ; <verse eid="MAT 11:4"/><verse number="5" style="v" sid="MAT 11:5"/>ಕುರುಡರು ನೋಡುತ್ತಾರೆ, ಕುಂಟರು ನಡೆಯುತ್ತಾರೆ, ಕುಷ್ಠರೋಗಿಗಳು ಶುದ್ಧರಾಗುತ್ತಾರೆ, ಕಿವುಡರು ಕೇಳುತ್ತಾರೆ, ಮರಣಹೊಂದಿದವರು ಜೀವ ಪಡೆಯುತ್ತಾರೆ ಮತ್ತು ಬಡವರಿಗೆ ಸುವಾರ್ತೆ ಸಾರಲಾಗುತ್ತದೆ. <verse eid="MAT 11:5"/><verse number="6" style="v" sid="MAT 11:6"/>ನನ್ನ ವಿಷಯದಲ್ಲಿ ವಿಶ್ವಾಸ ಕಳೆದುಕೊಳ್ಳದವನೇ ಧನ್ಯನು,”<note caller="+" style="f"><char style="fr" closed="false">11:6 </char><char style="ft" closed="false">ಕ್ರಿಸ್ತನು ಬಂದಾಗ ಇವೆಲ್ಲವೂ ನೆರವೇರುವಂತೆ ಪ್ರವಾದಿಸಲಾಗಿದೆ. ನೋಡಿರಿ, <char style="xt"><ref loc="ISA 35:5-6">ಯೆಶಾಯ 35:5-6</ref>; <ref loc="ISA 26:19">26:19</ref>; <ref loc="ISA 29:18-19">29:18-19</ref>; <ref loc="ISA 42:18">42:18</ref>; <ref loc="ISA 61:1">61:1</ref></char></char></note> ಎಂದರು.<verse eid="MAT 11:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 11:7"/>ಅವರು ಹೊರಟು ಹೋಗುತ್ತಿದ್ದಾಗ, ಯೇಸು ಯೋಹಾನನ ಕುರಿತಾಗಿ ಜನಸಮೂಹಕ್ಕೆ, “ನೀವು ಯಾವುದನ್ನು ಕಾಣುವುದಕ್ಕಾಗಿ ಅರಣ್ಯಕ್ಕೆ ಹೋದಿರಿ? ಗಾಳಿಗೆ ಓಲಾಡುವ ದಂಟನ್ನೋ? <verse eid="MAT 11:7"/><verse number="8" style="v" sid="MAT 11:8"/>ಇಲ್ಲವಾದರೆ, ನೀವು ಏನನ್ನು ಕಾಣುವುದಕ್ಕಾಗಿ ಹೋದಿರಿ? ನಯವಾದ ಉಡುಪನ್ನು ಧರಿಸಿದ್ದ ಮನುಷ್ಯನನ್ನೋ? ನಯವಾದ ಉಡುಪನ್ನು ಧರಿಸುವವರು ರಾಜರ ಅರಮನೆಗಳಲ್ಲಿ ಇರುತ್ತಾರೆ. <verse eid="MAT 11:8"/><verse number="9" style="v" sid="MAT 11:9"/>ಆದರೆ ಏನು ಕಾಣುವುದಕ್ಕಾಗಿ ಹೋದಿರಿ? ಒಬ್ಬ ಪ್ರವಾದಿಯನ್ನೋ? ಹೌದು, ಪ್ರವಾದಿಗಿಂತಲೂ ಹೆಚ್ಚಿನವನನ್ನು ನೋಡಿದಿರಿ, ಎಂದು ನಾನು ನಿಮಗೆ ಹೇಳುತ್ತೇನೆ. <verse eid="MAT 11:9"/><verse number="10" style="v" sid="MAT 11:10"/>ಯೋಹಾನನ ಕುರಿತು ಪವಿತ್ರ ವೇದದಲ್ಲಿ ಹೀಗೆ ಬರೆದಿದೆ:</para>
  <para style="q1" vid="MAT 11:10">“ ‘ಇಗೋ, ನಿನ್ನ ದಾರಿಯನ್ನು ನಿನ್ನ ಮುಂದೆ ಸಿದ್ಧಮಾಡುವಂತೆ</para>
  <para style="q2" vid="MAT 11:10">ನನ್ನ ದೂತನನ್ನು ನಿನ್ನ ಮುಂದೆ ಕಳುಹಿಸುತ್ತೇನೆ.’<note caller="+" style="f"><char style="fr" closed="false">11:10 </char><char style="ft" closed="false"><char style="xt"><ref loc="MAL 3:1">ಮಲಾಕಿ 3:1</ref></char></char></note><verse eid="MAT 11:10"/></para>
  <para style="m">
    <verse number="11" style="v" sid="MAT 11:11"/>ನಾನು ನಿಮಗೆ ನಿಜವಾಗಿ ಹೇಳುತ್ತೇನೆ, ಸ್ತ್ರೀಯರಲ್ಲಿ ಹುಟ್ಟಿದವರಲ್ಲಿ ಸ್ನಾನಿಕ ಯೋಹಾನನಿಗಿಂತ ದೊಡ್ಡವನು ಹುಟ್ಟಲಿಲ್ಲ; ಆದರೂ ಪರಲೋಕ ರಾಜ್ಯದಲ್ಲಿರುವ ಅತ್ಯಂತ ಚಿಕ್ಕವನು ಅವನಿಗಿಂತಲೂ ದೊಡ್ಡವನಾಗಿದ್ದಾನೆ. <verse eid="MAT 11:11"/><verse number="12" style="v" sid="MAT 11:12"/>ಸ್ನಾನಿಕನಾದ ಯೋಹಾನನ ದಿನಗಳಿಂದ ಇದುವರೆಗೆ, ಪರಲೋಕ ರಾಜ್ಯವು ಬಲಾತ್ಕಾರಕ್ಕೆ ಒಳಗಾಗಿದೆ,<note caller="+" style="f"><char style="fr" closed="false">11:12 </char><char style="ft" closed="false">ಅಂದರೆ, </char><char style="fqa" closed="false">ಒತ್ತಾಯದಿಂದ ಪ್ರಗತಿಯಾಗಿದೆ</char></note> ಬಲಾತ್ಕಾರಿಗಳು ಅದನ್ನು ಬಲವಂತವಾಗಿ ತೆಗೆದುಕೊಳ್ಳುತ್ತಾರೆ. <verse eid="MAT 11:12"/><verse number="13" style="v" sid="MAT 11:13"/>ಯೋಹಾನನ ಕಾಲದ ತನಕ ಮೋಶೆಯ ನಿಯಮ ಹಾಗು ಎಲ್ಲ ಪ್ರವಾದಿಗಳು ದೇವರ ರಾಜ್ಯವನ್ನು ಕುರಿತು ಪ್ರವಾದನೆ ಮಾಡಿದರು. <verse eid="MAT 11:13"/><verse number="14" style="v" sid="MAT 11:14"/>ನೀವು ಇದನ್ನು ಸ್ವೀಕರಿಸುವುದಕ್ಕೆ ಮನಸ್ಸಿದ್ದರೆ, ಬರತಕ್ಕ ಎಲೀಯನು ಈ ಯೋಹಾನನೇ. <verse eid="MAT 11:14"/><verse number="15" style="v" sid="MAT 11:15"/>ಕೇಳುವುದಕ್ಕೆ ಕಿವಿಯುಳ್ಳವನು ಕೇಳಿಸಿಕೊಳ್ಳಲಿ.<verse eid="MAT 11:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 11:16"/>“ಆದರೆ ಈ ಸಂತತಿಯನ್ನು ನಾನು ಯಾವುದಕ್ಕೆ ಹೋಲಿಸಲಿ? ಮಕ್ಕಳು ಪೇಟೆಗಳಲ್ಲಿ ಕೂತುಕೊಂಡು ಇತರರನ್ನು ಕರೆಯುತ್ತಾ:<verse eid="MAT 11:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="MAT 11:17"/>“ ‘ನಾವು ನಿಮಗಾಗಿ ಕೊಳಲೂದಿದೆವು,</para>
  <para style="q2" vid="MAT 11:17">ನೀವು ಕುಣಿಯಲಿಲ್ಲ;</para>
  <para style="q1" vid="MAT 11:17">ನಾವು ಶೋಕಗೀತೆ ಹಾಡಿದೆವು,</para>
  <para style="q2" vid="MAT 11:17">ನೀವು ಗೋಳಾಡಲಿಲ್ಲ,’</para>
  <para style="m" vid="MAT 11:17">ಎಂದು ಹೇಳುವವರಿಗೆ ಇದು ಹೋಲಿಕೆಯಾಗಿದೆ.<verse eid="MAT 11:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 11:18"/>“ಏಕೆಂದರೆ ಯೋಹಾನನು ಅನ್ನಪಾನಗಳನ್ನು ತೆಗೆದುಕೊಳ್ಳಲಿಲ್ಲ. ಅದಕ್ಕೆ ಅವರು, ‘ಅವನಿಗೆ ದೆವ್ವ ಹಿಡಿದಿದೆ,’ ಎಂದರು. <verse eid="MAT 11:18"/><verse number="19" style="v" sid="MAT 11:19"/>ಮನುಷ್ಯಪುತ್ರನಾದ ನಾನು ಅನ್ನಪಾನ ಸೇವಿಸುವವನಾಗಿ ಬಂದೆನು. ಅದಕ್ಕೆ ಅವರು, ‘ಇಗೋ, ಹೊಟ್ಟೆಬಾಕನು, ಕುಡುಕನು, ಸುಂಕದವರ ಮತ್ತು ಪಾಪಿಗಳ ಸ್ನೇಹಿತನು,’ ಎಂದು ಹೇಳುತ್ತಾರೆ. ಆದರೆ ಜ್ಞಾನವು ತನ್ನ ಕೃತ್ಯಗಳಿಂದಲೇ ಸಮರ್ಥಿಸಲಾಗುತ್ತದೆ,” ಎಂದು ಹೇಳಿದರು.<verse eid="MAT 11:19"/></para>
  <para style="s1">ಮಾನಸಾಂತರ ಪಡದ ಊರುಗಳನ್ನು ಗದರಿಸಿದ್ದು</para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 11:20"/>ತರುವಾಯ ತಮ್ಮ ಹೆಚ್ಚಾದ ಮಹತ್ಕಾರ್ಯಗಳು ನಡೆದ ಪಟ್ಟಣಗಳು, ದೇವರ ಕಡೆಗೆ ತಿರುಗಿಕೊಳ್ಳದೆ ಇದ್ದುದರಿಂದ ಯೇಸು ಅವುಗಳನ್ನು ಗದರಿಸತೊಡಗಿ, <verse eid="MAT 11:20"/><verse number="21" style="v" sid="MAT 11:21"/>“ಖೊರಾಜಿನೇ, ನಿನಗೆ ಕಷ್ಟ! ಬೇತ್ಸಾಯಿದವೇ, ನಿನಗೆ ಕಷ್ಟ! ಏಕೆಂದರೆ ನಿಮ್ಮಲ್ಲಿ ನಡೆದ ಮಹತ್ಕಾರ್ಯಗಳು ಟೈರ್ ಮತ್ತು ಸೀದೋನ್ ಪಟ್ಟಣಗಳಲ್ಲಿ ನಡೆದಿದ್ದರೆ, ಅಲ್ಲಿಯವರು ಬಹಳ ಕಾಲದ ಹಿಂದೆಯೇ, ಗೋಣಿತಟ್ಟನ್ನು ಸುತ್ತಿಕೊಂಡು ಬೂದಿಯಲ್ಲಿ ಕುಳಿತುಕೊಂಡು ದೇವರ ಕಡೆ ತಿರುಗಿಕೊಳ್ಳುತ್ತಿದ್ದರು. <verse eid="MAT 11:21"/><verse number="22" style="v" sid="MAT 11:22"/>ಆದರೂ ನ್ಯಾಯತೀರ್ಪಿನ ದಿನದಲ್ಲಿ ನಿಮಗಿಂತಲೂ ಟೈರ್ ಮತ್ತು ಸೀದೋನ್ ಪಟ್ಟಣಗಳ ಗತಿಯು ಹೆಚ್ಚು ತಾಳಬಹುದಾಗಿರುವುದು. <verse eid="MAT 11:22"/><verse number="23" style="v" sid="MAT 11:23"/>ಕಪೆರ್ನೌಮೇ, ನೀನು ಪರಲೋಕಕ್ಕೆ ಹೋಗುವೆ ಎಂದು ನೆನೆಸುತ್ತೀಯೋ? ಇಲ್ಲ, ನೀನು ಪಾತಾಳಕ್ಕೆ<note caller="+" style="f"><char style="fr" closed="false">11:23 </char><char style="fq" closed="false">ಪಾತಾಳ </char><char style="ft" closed="false">ಅಂದರೆ </char><char style="fqa" closed="false">ಸತ್ತವರ ಸ್ಥಳ</char></note> ಇಳಿಯುವೆ. ಏಕೆಂದರೆ ನಿನ್ನೊಳಗೆ ನಡೆದಿರುವ ಮಹತ್ಕಾರ್ಯಗಳು ಸೊದೋಮಿನಲ್ಲಿ<note caller="+" style="f"><char style="fr" closed="false">11:23 </char><char style="ft" closed="false">ನೋಡಿರಿ <char style="xt"><ref loc="GEN 19:24-29">ಆದಿ 19:24-29</ref></char></char></note> ನಡೆದಿದ್ದರೆ, ಅದು ಇಂದಿನವರೆಗೂ ಉಳಿಯುತ್ತಿತ್ತು. <verse eid="MAT 11:23"/><verse number="24" style="v" sid="MAT 11:24"/>ಆದರೆ ನ್ಯಾಯತೀರ್ಪಿನ ದಿನದಲ್ಲಿ ನಿಮಗಿಂತಲೂ ಸೊದೋಮ್ ಪಟ್ಟಣದ ಗತಿಯು ಹೆಚ್ಚು ತಾಳಬಹುದಾಗಿರುವುದು ಎಂದು ನಾನು ನಿಮಗೆ ಹೇಳುತ್ತೇನೆ,” ಎಂದರು.<verse eid="MAT 11:24"/></para>
  <para style="s1">ಕಷ್ಟಪಡುವವರಿಗೆ ವಿಶ್ರಾಂತಿ</para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 11:25"/>ಆ ಸಮಯದಲ್ಲಿ ಯೇಸು, “ತಂದೆಯೇ, ಪರಲೋಕ ಭೂಲೋಕಗಳ ಒಡೆಯನೇ, ನೀವು ಈ ವಿಷಯಗಳನ್ನು ಜ್ಞಾನಿಗಳಿಂದಲೂ ಬುದ್ಧಿವಂತರಿಂದಲೂ ಮರೆಮಾಡಿ, ಶಿಶುಗಳಿಗೆ ಪ್ರಕಟ ಮಾಡಿರುವುದರಿಂದ ನಾನು ನಿಮ್ಮನ್ನು ಕೊಂಡಾಡುತ್ತೇನೆ. <verse eid="MAT 11:25"/><verse number="26" style="v" sid="MAT 11:26"/>ಹೌದು ತಂದೆಯೇ, ಹೀಗೆ ಮಾಡುವುದು ನಿಮ್ಮ ದೃಷ್ಟಿಗೆ ಒಳ್ಳೆಯದಾಗಿ ತೋಚಿತು.<verse eid="MAT 11:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 11:27"/>“ನನ್ನ ತಂದೆ ಎಲ್ಲವನ್ನೂ ನನಗೆ ಒಪ್ಪಿಸಿದ್ದಾರೆ. ತಂದೆಯ ಹೊರತು ಬೇರೆ ಯಾರೂ ಪುತ್ರನನ್ನು ಅರಿಯರು ಮತ್ತು ಪುತ್ರನು ಯಾರಿಗೆ ತಂದೆಯನ್ನು ಪ್ರಕಟಪಡಿಸಲು ಇಷ್ಟಪಡುತ್ತಾನೋ ಅವರೇ ಹೊರತು ಯಾರೂ ತಂದೆಯನ್ನು ಅರಿಯರು.<verse eid="MAT 11:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 11:28"/>“ಕಷ್ಟಪಡುವವರೇ, ಹೊರೆಹೊತ್ತವರೇ, ನೀವೆಲ್ಲರೂ ನನ್ನ ಬಳಿಗೆ ಬನ್ನಿರಿ, ನಾನು ನಿಮಗೆ ವಿಶ್ರಾಂತಿಯನ್ನು ಕೊಡುವೆನು. <verse eid="MAT 11:28"/><verse number="29" style="v" sid="MAT 11:29"/>ನಾನು ಸಾತ್ವಿಕನೂ ದೀನ ಹೃದಯದವನೂ ಆಗಿರುವುದರಿಂದ ನೀವು ನನ್ನ ನೊಗವನ್ನು ನಿಮ್ಮ ಮೇಲೆ ತೆಗೆದುಕೊಂಡು ನನ್ನಿಂದ ಕಲಿತುಕೊಳ್ಳಿರಿ. ಆಗ ನಿಮ್ಮ ಆತ್ಮಗಳಿಗೆ ವಿಶ್ರಾಂತಿಯನ್ನು ಕಂಡುಕೊಳ್ಳುವಿರಿ. <verse eid="MAT 11:29"/><verse number="30" style="v" sid="MAT 11:30"/>ನನ್ನ ನೊಗವು ಮೃದುವಾದದ್ದೂ ನನ್ನ ಹೊರೆಯು ಹಗುರವಾದದ್ದೂ ಆಗಿದೆ,” ಎಂದು ಹೇಳಿದರು.<verse eid="MAT 11:30"/></para>
  <chapter eid="MAT 11"/>
  <chapter number="12" style="c" sid="MAT 12"/>
  <para style="s1">ಸಬ್ಬತ್ ದಿನಕ್ಕೆ ಒಡೆಯ</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 12:1"/>ಯೇಸು ಒಂದು ಸಬ್ಬತ್<note caller="+" style="f"><char style="fr" closed="false">12:1 </char><char style="ft" closed="false">ಇದು ವಾರದ ಏಳನೆಯ ದಿನ, ಈ ದಿನವನ್ನು ಯೆಹೂದ್ಯರು ಪವಿತ್ರ ದಿನ ಭಾವಿಸುತ್ತಿದ್ದರು. ಈ ದಿನದಲ್ಲಿ ಅವರು ಆರಾಧನೆ ಮತ್ತು ವಿಶ್ರಾಂತಿ ಮಾಡುತ್ತಿದ್ದರು.</char></note> ದಿನ ಪೈರಿನ ಹೊಲವನ್ನು ಹಾದುಹೋಗುತ್ತಿದ್ದಾಗ, ಅವರ ಶಿಷ್ಯರು ಹಸಿದಿದ್ದರಿಂದ ತೆನೆಗಳನ್ನು ಕಿತ್ತು ತಿನ್ನಲಾರಂಭಿಸಿದರು. <verse eid="MAT 12:1"/><verse number="2" style="v" sid="MAT 12:2"/>ಫರಿಸಾಯರು ಅದನ್ನು ಕಂಡು ಯೇಸುವಿಗೆ, “ಇಗೋ, ನಿನ್ನ ಶಿಷ್ಯರು ಸಬ್ಬತ್ ದಿನದಲ್ಲಿ ನಿಯಮಕ್ಕೆ ವಿರುದ್ಧವಾಗಿರುವದನ್ನು ಮಾಡುತ್ತಿದ್ದಾರೆ,” ಎಂದರು.<verse eid="MAT 12:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 12:3"/>ಅದಕ್ಕೆ ಯೇಸು ಅವರಿಗೆ, “ದಾವೀದನು ಮತ್ತು ಅವನ ಸಂಗಡಿಗರು ಹಸಿದಿದ್ದಾಗ ಅವನು ಏನು ಮಾಡಿದನೆಂದು ನೀವು ಓದಲಿಲ್ಲವೇ? <verse eid="MAT 12:3"/><verse number="4" style="v" sid="MAT 12:4"/>ಅವನು ದೇವರ ಆಲಯದೊಳಗೆ ಹೋಗಿ, ಯಾಜಕರ ಹೊರತು ತಾನಾಗಲಿ ತನ್ನ ಸಂಗಡಿಗರಾಗಲಿ, ತಿನ್ನುವುದಕ್ಕೆ ಧರ್ಮಸಮ್ಮತವಲ್ಲದ ನೈವೇದ್ಯದ ರೊಟ್ಟಿಯನ್ನು ತಿನ್ನಲಿಲ್ಲವೇ?<note caller="+" style="f"><char style="fr" closed="false">12:4 </char><char style="ft" closed="false"><char style="xt"><ref loc="1SA 21:1-6">1 ಸಮು 21:1-6</ref></char></char></note> <verse eid="MAT 12:4"/><verse number="5" style="v" sid="MAT 12:5"/>ಇದಲ್ಲದೆ ಸಬ್ಬತ್ ದಿನದಲ್ಲಿ ಯಾಜಕರು ದೇವಾಲಯದಲ್ಲಿ ಸಬ್ಬತ್ ದಿನವನ್ನು ಉಲ್ಲಂಘಿಸಿದರೂ ನಿರ್ದೋಷಿಗಳಾಗಿದ್ದಾರೆಂದು ನೀವು ನಿಯಮದಲ್ಲಿ ಓದಲಿಲ್ಲವೇ? <verse eid="MAT 12:5"/><verse number="6" style="v" sid="MAT 12:6"/>ದೇವಾಲಯಕ್ಕಿಂತಲೂ ದೊಡ್ಡವನು ಇಲ್ಲಿದ್ದಾನೆ ಎಂದು ನಾನು ನಿಮಗೆ ಹೇಳುತ್ತೇನೆ. <verse eid="MAT 12:6"/><verse number="7" style="v" sid="MAT 12:7"/>ಆದರೆ, ‘ನಾನು ಯಜ್ಞವನ್ನಲ್ಲ, ಕರುಣೆಯನ್ನೇ ಅಪೇಕ್ಷಿಸುತ್ತೇನೆ’<note caller="+" style="f"><char style="fr" closed="false">12:7 </char><char style="ft" closed="false"><char style="xt"><ref loc="HOS 6:6">ಹೋಶೇ 6:6</ref></char></char></note> ಎಂಬುದರ ಅರ್ಥವನ್ನು ನೀವು ತಿಳಿದಿದ್ದರೆ, ನಿರಪರಾಧಿಗಳನ್ನು ಖಂಡಿಸುತ್ತಿರಲಿಲ್ಲ. <verse eid="MAT 12:7"/><verse number="8" style="v" sid="MAT 12:8"/>ಏಕೆಂದರೆ ಮನುಷ್ಯಪುತ್ರನಾದ ನಾನು ಸಬ್ಬತ್ ದಿನಕ್ಕೆ ಒಡೆಯನಾಗಿದ್ದೇನೆ,” ಎಂದು ಹೇಳಿದರು.<verse eid="MAT 12:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 12:9"/>ಯೇಸು ಅಲ್ಲಿಂದ ಹೊರಟು ಅವರ ಸಭಾಮಂದಿರದೊಳಕ್ಕೆ ಹೋದರು. <verse eid="MAT 12:9"/><verse number="10" style="v" sid="MAT 12:10"/>ಅಲ್ಲಿ ಕೈ ಬತ್ತಿದ ಒಬ್ಬ ಮನುಷ್ಯನಿದ್ದನು. ಆಗ ಫರಿಸಾಯರು ಯೇಸುವಿನ ಮೇಲೆ ತಪ್ಪು ಹೊರಿಸಬೇಕೆಂದು ಆತನಿಗೆ, “ಸಬ್ಬತ್ ದಿನದಲ್ಲಿ ಸ್ವಸ್ಥಮಾಡುವುದು ನ್ಯಾಯಸಮ್ಮತವೋ?” ಎಂದು ಕೇಳಿದರು.<verse eid="MAT 12:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 12:11"/>ಅದಕ್ಕೆ ಯೇಸು ಅವರಿಗೆ, “ನಿಮ್ಮಲ್ಲಿ ಯಾವನಿಗಾದರೂ ಒಂದು ಕುರಿಯಿರಲಾಗಿ ಅದು ಸಬ್ಬತ್ ದಿನದಲ್ಲಿ ಕುಣಿಯೊಳಗೆ ಬಿದ್ದರೆ, ಅವನು ಅದನ್ನು ಮೇಲಕ್ಕೆ ಎತ್ತದೆ ಇರುವನೇ? <verse eid="MAT 12:11"/><verse number="12" style="v" sid="MAT 12:12"/>ಕುರಿಗಿಂತಲೂ ಒಬ್ಬ ಮನುಷ್ಯನು ಎಷ್ಟೋ ಮೌಲ್ಯವುಳ್ಳವನಾಗಿದ್ದಾನಲ್ಲವೇ? ಆದ್ದರಿಂದ ಸಬ್ಬತ್ ದಿನಗಳಲ್ಲಿ ಒಳ್ಳೆಯದನ್ನು ಮಾಡುವುದು ನ್ಯಾಯಸಮ್ಮತವಾಗಿದೆ!” ಎಂದು ಹೇಳಿದರು.<verse eid="MAT 12:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 12:13"/>ಆಗ ಯೇಸು ಆ ಮನುಷ್ಯನಿಗೆ, “ನಿನ್ನ ಕೈಚಾಚು” ಎಂದರು. ಅವನು ಕೈಚಾಚಿದಾಗ ಅದು ಸಂಪೂರ್ಣ ವಾಸಿಯಾಗಿ ಇನ್ನೊಂದು ಕೈಯಂತೆಯೇ ಆಯಿತು. <verse eid="MAT 12:13"/><verse number="14" style="v" sid="MAT 12:14"/>ಆದರೆ ಫರಿಸಾಯರು ಹೊರಗೆ ಹೋಗಿ ಯೇಸುವನ್ನು ಹೇಗೆ ಕೊಲ್ಲಬೇಕೆಂದು ಅವರ ವಿರೋಧವಾಗಿ ಆಲೋಚನೆಮಾಡಿದರು.<verse eid="MAT 12:14"/></para>
  <para style="s1">ದೇವರಿಗೆ ಮೆಚ್ಚಿಕೆಯಾದ ಸೇವಕನು</para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 12:15"/>ಆದರೆ ಯೇಸು ಅದನ್ನು ತಿಳಿದು ಅಲ್ಲಿಂದ ಹೊರಟು ಹೋದರು. ದೊಡ್ಡ ಜನರ ಗುಂಪು ಅವರನ್ನು ಹಿಂಬಾಲಿಸಿತು. ಯೇಸು ಅವರಲ್ಲಿ ಅಸ್ವಸ್ಥರಾದವರನ್ನು ಗುಣಪಡಿಸಿದರು. <verse eid="MAT 12:15"/><verse number="16" style="v" sid="MAT 12:16"/>ಆದರೆ ಯೇಸು ತಾನು ಯಾರೆಂದು ಯಾರಿಗೂ ಪ್ರಕಟಿಸಬಾರದೆಂದು ಅವರನ್ನು ಎಚ್ಚರಿಸಿದರು. <verse eid="MAT 12:16"/><verse number="17" style="v" sid="MAT 12:17"/>ಹೀಗೆ ದೇವರು ಪ್ರವಾದಿಯಾದ ಯೆಶಾಯನ ಮುಖಾಂತರ ಹೇಳಿದ ಮಾತು ನೆರವೇರಿತು. ಅದೇನೆಂದರೆ:<verse eid="MAT 12:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="MAT 12:18"/>“ಈತನು ನಾನು ಆರಿಸಿಕೊಂಡ ನನ್ನ ದಾಸನು,</para>
  <para style="q2" vid="MAT 12:18">ಈ ನನ್ನ ಪ್ರಿಯನಲ್ಲಿ ನನ್ನ ಪ್ರಾಣವು ಸಂಪೂರ್ಣ ಮೆಚ್ಚಿದೆ.</para>
  <para style="q1" vid="MAT 12:18">ನಾನು ಈತನ ಮೇಲೆ ನನ್ನ ಆತ್ಮವನ್ನು ಇರಿಸುವೆನು,</para>
  <para style="q2" vid="MAT 12:18">ಈತನು ಜನಾಂಗಗಳಿಗೆ ನ್ಯಾಯವನ್ನು ಸಾರುವನು.<verse eid="MAT 12:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="MAT 12:19"/>ಈತನು ಜಗಳವಾಡುವವನಲ್ಲ, ಕೂಗಾಡುವವನಲ್ಲ;</para>
  <para style="q2" vid="MAT 12:19">ಬೀದಿಗಳಲ್ಲಿ ಈತನ ಸ್ವರವನ್ನು ಯಾರೂ ಕೇಳಿಸಿಕೊಳ್ಳುವುದೂ ಇಲ್ಲ.<verse eid="MAT 12:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="MAT 12:20"/>ಈತನು ನ್ಯಾಯವನ್ನು ಜಯಕ್ಕೆ ನಡೆಸುವವರೆಗೆ,</para>
  <para style="q2" vid="MAT 12:20">ಜಜ್ಜಿದ ದಂಟನ್ನು ಮುರಿಯುವವನಲ್ಲ,</para>
  <para style="q1" vid="MAT 12:20">ಆರಿ ಹೋಗುತ್ತಿರುವ ಬತ್ತಿಯನ್ನು ನಂದಿಸುವವನೂ ಅಲ್ಲ.<verse eid="MAT 12:20"/></para>
  <para style="q2">
    <verse number="21" style="v" sid="MAT 12:21"/>ಈತನ ಹೆಸರಿನಲ್ಲಿಯೇ ಯೆಹೂದ್ಯರಲ್ಲದವರು ನಿರೀಕ್ಷೆ ಇಡುವರು.”<note caller="+" style="f"><char style="fr" closed="false">12:21 </char><char style="ft" closed="false"><char style="xt"><ref loc="ISA 42:1-4">ಯೆಶಾಯ 42:1-4</ref></char></char></note><verse eid="MAT 12:21"/></para>
  <para style="s1">ಯೇಸು ಮತ್ತು ಬೆಲ್ಜೆಬೂಲ</para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 12:22"/>ಆಗ ಕೆಲವರು ದೆವ್ವಹಿಡಿದ ಕುರುಡನೂ ಮೂಕನೂ ಆಗಿದ್ದ ಒಬ್ಬನನ್ನು ಯೇಸುವಿನ ಬಳಿಗೆ ತಂದರು. ಅವರು ಅವನನ್ನು ಗುಣಪಡಿಸಿದ್ದರಿಂದ, ಕುರುಡನೂ ಮೂಕನೂ ಆಗಿದ್ದವನು ಮಾತನಾಡಿದನು ಮತ್ತು ದೃಷ್ಟಿ ಹೊಂದಿದನು. <verse eid="MAT 12:22"/><verse number="23" style="v" sid="MAT 12:23"/>ಆಗ ಜನರೆಲ್ಲರೂ ವಿಸ್ಮಯಗೊಂಡವರಾಗಿ, “ದಾವೀದನ ಪುತ್ರನು ಈತನೇ ಅಲ್ಲವೇ?”<note caller="+" style="f"><char style="fr" closed="false">12:23 </char><char style="ft" closed="false">ದೇವರು ಅರಸನಾದ ದಾವೀದನಿಗೆ ಮುಂಬರುವ ಕ್ರಿಸ್ತನ ಬಗ್ಗೆ ತಿಳಿಸಿದ ಪ್ರವಾದನೆಯ ಸೂಚನೆಯೇ ಈ ದಾವೀದನ ಪುತ್ರ ಮತ್ತು ಇಸ್ರಾಯೇಲ್ ಜನರಲ್ಲಿ ದಾವೀದನ ಕುಟುಂಬದಲ್ಲಿ ವಿಮೋಚಕನಾದ ಮೆಸ್ಸೀಯನು ಹುಟ್ಟುವನೆಂಬ ನಿರೀಕ್ಷೆಯಿತ್ತು.</char></note> ಎಂದರು.<verse eid="MAT 12:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 12:24"/>ಆದರೆ ಫರಿಸಾಯರು ಇದನ್ನು ಕೇಳಿದಾಗ, “ಈತನು ದೆವ್ವಗಳನ್ನು ಓಡಿಸುತ್ತಿರುವುದು ದೆವ್ವಗಳ ಅಧಿಪತಿಯಾದ ಬೆಲ್ಜೆಬೂಲನಿಂದಲೇ,” ಎಂದರು.<verse eid="MAT 12:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 12:25"/>ಯೇಸು ಅವರ ಆಲೋಚನೆಗಳನ್ನು ತಿಳಿದು ಅವರಿಗೆ, “ತನಗೆ ವಿರೋಧವಾಗಿ ವಿಭಜಿಸಿಕೊಳ್ಳುವ ಪ್ರತಿಯೊಂದು ರಾಜ್ಯವು ನಾಶವಾಗುವುದು ಮತ್ತು ತನಗೆ ವಿರೋಧವಾಗಿ ವಿಭಾಗವಾಗಿರುವ ಪ್ರತಿಯೊಂದು ಪಟ್ಟಣವಾಗಲಿ ಮನೆಯಾಗಲಿ ನಿಲ್ಲುವುದಿಲ್ಲ. <verse eid="MAT 12:25"/><verse number="26" style="v" sid="MAT 12:26"/>ಇದಲ್ಲದೆ ಸೈತಾನನು ಸೈತಾನನನ್ನು ಹೊರಗೆ ಓಡಿಸಿದರೆ, ಅವನು ತನಗೆ ವಿರೋಧವಾಗಿ ವಿಭಾಗವಾಗಿರುವನು. ಹಾಗಾದರೆ ಅವನ ರಾಜ್ಯವು ನಿಲ್ಲುವುದು ಹೇಗೆ? <verse eid="MAT 12:26"/><verse number="27" style="v" sid="MAT 12:27"/>ಬೆಲ್ಜೆಬೂಲನಿಂದ ನಾನು ದೆವ್ವಗಳನ್ನು ಓಡಿಸುವುದಾದರೆ, ನಿಮ್ಮ ಜನರು ಯಾರಿಂದ ಅವುಗಳನ್ನು ಓಡಿಸುತ್ತಾರೆ? ಆದ್ದರಿಂದ, ನಿಮ್ಮವರೇ ನಿಮಗೆ ನ್ಯಾಯಾಧಿಪತಿಗಳಾಗಿರುವರು. <verse eid="MAT 12:27"/><verse number="28" style="v" sid="MAT 12:28"/>ನಾನು ದೇವರ ಆತ್ಮನಿಂದ ದೆವ್ವಗಳನ್ನು ಓಡಿಸುವುದಾದರೆ ದೇವರ ರಾಜ್ಯವು ನಿಸ್ಸಂದೇಹವಾಗಿ ನಿಮ್ಮ ಬಳಿಗೆ ಬಂದಿದೆಯಲ್ಲಾ.<verse eid="MAT 12:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 12:29"/>“ಇದಲ್ಲದೆ, ಯಾವನಾದರೂ ಮೊದಲು ಬಲಿಷ್ಠನನ್ನು ಕಟ್ಟಿಹಾಕದೆ, ಅವನ ಮನೆಯನ್ನು ಪ್ರವೇಶಿಸಿ ಅವನ ಸೊತ್ತನ್ನು ಸೂರೆ ಮಾಡಲಾದೀತೇ? ಕಟ್ಟಿದ ನಂತರ ಅವನ ಮನೆಯನ್ನು ಕೊಳ್ಳೆ ಹೊಡೆಯಬಹುದು.<verse eid="MAT 12:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="MAT 12:30"/>“ನನ್ನ ಪರವಾಗಿ ಇರದವನು ನನಗೆ ವಿರೋಧಿಯಾಗಿದ್ದಾನೆ, ನನ್ನೊಡನೆ ಶೇಖರಿಸದವನು ಚದರಿಸುತ್ತಾನೆ. <verse eid="MAT 12:30"/><verse number="31" style="v" sid="MAT 12:31"/>ಆದಕಾರಣ ನಾನು ನಿಮಗೆ ಹೇಳುವುದೇನೆಂದರೆ, ಮನುಷ್ಯರು ಮಾಡುವ ಎಲ್ಲಾ ಪಾಪಕ್ಕೂ ದೂಷಣೆಗೂ ಕ್ಷಮಾಪಣೆಯಾಗುವುದು, ಆದರೆ ಪವಿತ್ರಾತ್ಮರಿಗೆ ವಿರೋಧವಾಗಿ ದೂಷಣೆ ಮಾಡಿದರೆ ಅದಕ್ಕೆ ಕ್ಷಮಾಪಣೆಯಿಲ್ಲ. <verse eid="MAT 12:31"/><verse number="32" style="v" sid="MAT 12:32"/>ಯಾರಾದರೂ ಮನುಷ್ಯಪುತ್ರನಾದ ನನಗೆ ವಿರೋಧವಾಗಿ ಮಾತನಾಡುವ ಪ್ರತಿಯೊಬ್ಬರಿಗೂ ಕ್ಷಮಾಪಣೆಯಾಗುವುದು, ಆದರೆ ಪವಿತ್ರಾತ್ಮನಿಗೆ ವಿರೋಧವಾಗಿ ಮಾತನಾಡಿದರೆ, ಈ ಯುಗದಲ್ಲೇ ಆಗಲಿ ಬರುವ ಯುಗದಲ್ಲೇ ಆಗಲಿ ಅದಕ್ಕಾಗಿ ಅವರಿಗೆ ಕ್ಷಮೆ ದೊರಕುವುದಿಲ್ಲ.<verse eid="MAT 12:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 12:33"/>“ಮರವು ಒಳ್ಳೆಯದಾಗಿದ್ದರೆ, ಅದರ ಫಲವು ಒಳ್ಳೆಯದಾಗಿರುವುದು; ಮರವು ಕೆಟ್ಟದ್ದಾಗಿದ್ದರೆ, ಅದರ ಫಲವು ಕೆಟ್ಟದ್ದಾಗಿರುವುದು. ಏಕೆಂದರೆ ಮರವನ್ನು ಅದರ ಫಲದಿಂದಲೇ ಗುರುತಿಸಲಾಗುವುದು. <verse eid="MAT 12:33"/><verse number="34" style="v" sid="MAT 12:34"/>ಸರ್ಪಸಂತತಿಯವರೇ, ಕೆಟ್ಟವರಾಗಿರುವ ನೀವು ಒಳ್ಳೆಯದೇನನ್ನಾದರೂ ಮಾತನಾಡುವಿರೋ? ಹೃದಯದಲ್ಲಿ ತುಂಬಿರುವದನ್ನೇ ಅವನ ಬಾಯಿ ಮಾತನಾಡುತ್ತದೆ. <verse eid="MAT 12:34"/><verse number="35" style="v" sid="MAT 12:35"/>ಒಳ್ಳೆಯವನು ಒಳ್ಳೆಯ ಬೊಕ್ಕಸದಿಂದ ಒಳ್ಳೆಯದನ್ನೇ ಹೊರತರುತ್ತಾನೆ; ಕೆಟ್ಟವನು ಕೆಟ್ಟ ಬೊಕ್ಕಸದಿಂದ ಕೆಟ್ಟದ್ದನ್ನೇ ಹೊರತರುತ್ತಾನೆ. <verse eid="MAT 12:35"/><verse number="36" style="v" sid="MAT 12:36"/>ನಾನು ನಿಮಗೆ ಹೇಳುವುದೇನೆಂದರೆ, ಮನುಷ್ಯರು ಆಡುವ ಪ್ರತಿಯೊಂದು ವ್ಯರ್ಥ ಮಾತಿಗಾಗಿ ನ್ಯಾಯವಿಚಾರಣೆಯ ದಿನದಲ್ಲಿ ಅವರು ಲೆಕ್ಕಕೊಡಬೇಕು. <verse eid="MAT 12:36"/><verse number="37" style="v" sid="MAT 12:37"/>ನೀನು ನಿನ್ನ ಮಾತುಗಳಿಂದಲೇ ನೀತಿವಂತನೆಂದು ನಿರ್ಣಯಿಸಲಾಗುವುದು ಮತ್ತು ನಿನ್ನ ಮಾತುಗಳಿಂದಲೇ ನೀನು ಅಪರಾಧಿಯೆಂದು ನಿರ್ಣಯಿಸಲಾಗುವುದು,” ಎಂದು ಹೇಳಿದರು.<verse eid="MAT 12:37"/></para>
  <para style="s1">ಯೋನನ ಸೂಚಕಕಾರ್ಯವು</para>
  <para style="p">
    <verse number="38" style="v" sid="MAT 12:38"/>ಆಗ ನಿಯಮ ಬೋಧಕರೂ ಫರಿಸಾಯರೂ, “ಬೋಧಕರೇ, ನಿನ್ನಿಂದ ಒಂದು ಸೂಚಕಕಾರ್ಯವನ್ನು ಕಾಣಬೇಕೆಂದಿದ್ದೇವೆ,” ಎಂದು ಕೇಳಿದರು.<verse eid="MAT 12:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="MAT 12:39"/>ಯೇಸು ಉತ್ತರವಾಗಿ ಅವರಿಗೆ, “ವ್ಯಭಿಚಾರದ ಕೆಟ್ಟ ಸಂತತಿಯು ಸೂಚಕಕಾರ್ಯವನ್ನು ಹುಡುಕುತ್ತದೆ. ಪ್ರವಾದಿ ಯೋನನ<note caller="+" style="f"><char style="fr" closed="false">12:39 </char><char style="ft" closed="false">ಯೋನನು 8ನೇ ಶತಮಾನದ ಪ್ರವಾದಿ. ದೇವರು ಇವನನ್ನು ಮಹಾನಗರ ನಿನೆವೆಗೆ ಪ್ರವಾದಿಸಲು ಕಳುಹಿಸಿದ್ದನು.</char></note> ಸೂಚಕಕಾರ್ಯವೇ ಹೊರತು ಬೇರೆ ಯಾವ ಸೂಚಕಕಾರ್ಯವೂ ಈ ಸಂತತಿಗೆ ಕೊಡಲಾಗುವುದಿಲ್ಲ. <verse eid="MAT 12:39"/><verse number="40" style="v" sid="MAT 12:40"/>ಯೋನನು ಮೂರು ಹಗಲು ಮತ್ತು ಮೂರು ರಾತ್ರಿ ದೊಡ್ಡ ಮೀನಿನ ಹೊಟ್ಟೆಯಲ್ಲಿ ಇದ್ದ ಹಾಗೆಯೇ ಮನುಷ್ಯಪುತ್ರನಾದ ನಾನು ಮೂರು ಹಗಲು ಮತ್ತು ಮೂರು ರಾತ್ರಿ ಭೂಗರ್ಭದಲ್ಲಿರುವೆನು. <verse eid="MAT 12:40"/><verse number="41" style="v" sid="MAT 12:41"/>ನಿನೆವೆ ಪಟ್ಟಣದವರು ನ್ಯಾಯತೀರ್ಪಿನಲ್ಲಿ ಈ ಸಂತತಿಗೆ ಎದುರಾಗಿ ಎದ್ದು ನಿಂತು ಇದನ್ನು ಅಪರಾಧ ಎಂದು ತೀರ್ಪುಮಾಡುವರು, ಏಕೆಂದರೆ ಯೋನನು ಸಾರಿದ್ದನ್ನು ಕೇಳಿ ಅವರು ದೇವರ ಕಡೆಗೆ ತಿರುಗಿಕೊಂಡರು; ಇಗೋ, ಇಲ್ಲಿ ಯೋನನಿಗಿಂತಲೂ ತುಂಬಾ ದೊಡ್ಡವನು ಇದ್ದಾನೆ. <verse eid="MAT 12:41"/><verse number="42" style="v" sid="MAT 12:42"/>ನ್ಯಾಯತೀರ್ಪಿನಲ್ಲಿ ದಕ್ಷಿಣದ ರಾಣಿಯು<note caller="+" style="f"><char style="fr" closed="false">12:42 </char><char style="ft" closed="false"><char style="xt"><ref loc="1KI 10:1-13">1 ಅರಸು 10:1-13</ref>; <ref loc="2CH 9:1-12">2 ಪೂರ್ವ 9:1-12</ref></char></char></note> ಈ ಸಂತತಿಗೆ ಎದುರಾಗಿ ಎದ್ದು ಇವರನ್ನು ಅಪರಾಧಿಗಳೆಂದು ತೀರ್ಪುಮಾಡುವಳು. ಏಕೆಂದರೆ ಆಕೆಯು ಸೊಲೊಮೋನನ ಜ್ಞಾನವನ್ನು ಕೇಳುವುದಕ್ಕಾಗಿ ಭೂಮಿಯ ಕಟ್ಟಕಡೆಯಿಂದ ಬಂದಳು. ಇಗೋ, ಇಲ್ಲಿ ಸೊಲೊಮೋನನಿಗಿಂತಲೂ ತುಂಬಾ ದೊಡ್ಡವನು ಇಲ್ಲಿದ್ದಾನೆ.<verse eid="MAT 12:42"/></para>
  <para style="p">
    <verse number="43" style="v" sid="MAT 12:43"/>“ಅಶುದ್ಧಾತ್ಮವು ಒಬ್ಬ ಮನುಷ್ಯನಿಂದ ಹೊರಗೆ ಹೋದ ಮೇಲೆ ನೀರಿಲ್ಲದ ಸ್ಥಳಗಳಲ್ಲಿ ವಿಶ್ರಾಂತಿಗಾಗಿ ಹುಡುಕಾಡಿದರೂ ಅದನ್ನು ಕಂಡುಕೊಳ್ಳದೆ, ಅದು, <verse eid="MAT 12:43"/><verse number="44" style="v" sid="MAT 12:44"/>‘ನಾನು ಹೊರಟು ಬಂದ ನನ್ನ ಮನೆಗೆ ಹಿಂದಿರುಗುವೆನು,’ ಎಂದು ಹೇಳಿಕೊಂಡು ಬಂದು, ಆ ಮನೆಯು ಬರಿದಾಗಿಯೂ ಗುಡಿಸಿ ಅಲಂಕರಿಸಿರುವುದನ್ನು ಕಾಣುತ್ತದೆ. <verse eid="MAT 12:44"/><verse number="45" style="v" sid="MAT 12:45"/>ಆಗ ಅದು ಹೋಗಿ ತನಗಿಂತಲೂ ಕೆಟ್ಟವುಗಳಾದ ಬೇರೆ ಏಳು ಅಶುದ್ಧಾತ್ಮಗಳನ್ನು ತನ್ನೊಂದಿಗೆ ಕರೆದುಕೊಂಡು ಅವನ ಒಳಗೆ ಸೇರಿ ಅಲ್ಲಿ ವಾಸಮಾಡುವವು. ಹೀಗೆ ಆ ಮನುಷ್ಯನ ಕಡೆಯ ಸ್ಥಿತಿಯು ಮೊದಲಿಗಿಂತ ಕೆಟ್ಟದ್ದಾಗಿರುವುದು. ಅದರಂತೆಯೇ ಈ ದುಷ್ಟ ಸಂತತಿಗೂ ಆಗುವುದು,” ಎಂದು ಹೇಳಿದರು.<verse eid="MAT 12:45"/></para>
  <para style="s1">ಕ್ರಿಸ್ತ ಯೇಸುವಿನ ತಾಯಿ ಮತ್ತು ಸಹೋದರರು</para>
  <para style="p">
    <verse number="46" style="v" sid="MAT 12:46"/>ಯೇಸು ಇನ್ನೂ ಜನರ ಸಂಗಡ ಮಾತನಾಡುತ್ತಿದ್ದಾಗ, ಅವರ ತಾಯಿ ಮತ್ತು ಸಹೋದರರು ಅವರೊಂದಿಗೆ ಮಾತನಾಡಬೇಕೆಂದು ಅಪೇಕ್ಷಿಸಿ ಹೊರಗೆ ನಿಂತಿದ್ದರು. <verse eid="MAT 12:46"/><verse number="47" style="v" sid="MAT 12:47"/>ಆಗ ಒಬ್ಬನು ಯೇಸುವಿಗೆ, “ನಿಮ್ಮ ತಾಯಿಯೂ ಸಹೋದರರೂ ನಿಮ್ಮೊಂದಿಗೆ ಮಾತನಾಡಲು ಅಪೇಕ್ಷಿಸಿ ಹೊರಗೆ ನಿಂತಿದ್ದಾರೆ,” ಎಂದನು.<verse eid="MAT 12:47"/></para>
  <para style="p">
    <verse number="48" style="v" sid="MAT 12:48"/>ಅದಕ್ಕೆ ಯೇಸು ತಮಗೆ ಹೇಳಿದವನಿಗೆ ಉತ್ತರವಾಗಿ, “ನನ್ನ ತಾಯಿ ಯಾರು? ನನ್ನ ಸಹೋದರರು ಯಾರು?” ಎಂದು ಹೇಳಿ, <verse eid="MAT 12:48"/><verse number="49" style="v" sid="MAT 12:49"/>ಶಿಷ್ಯರ ಕಡೆಗೆ ತಮ್ಮ ಕೈಚಾಚಿ, “ಇಗೋ, ಇವರೇ ನನ್ನ ತಾಯಿ ಮತ್ತು ನನ್ನ ಸಹೋದರರು. <verse eid="MAT 12:49"/><verse number="50" style="v" sid="MAT 12:50"/>ಪರಲೋಕದಲ್ಲಿರುವ ನನ್ನ ತಂದೆಯ ಚಿತ್ತವನ್ನು ಮಾಡುವವನೇ ನನ್ನ ಸಹೋದರ, ಸಹೋದರಿ ಮತ್ತು ತಾಯಿ,” ಎಂದು ಹೇಳಿದರು.<verse eid="MAT 12:50"/></para>
  <chapter eid="MAT 12"/>
  <chapter number="13" style="c" sid="MAT 13"/>
  <para style="s1">ಬಿತ್ತುವವನ ಸಾಮ್ಯ</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 13:1"/>ಅದೇ ದಿನದಲ್ಲಿ ಯೇಸು ಮನೆಯಿಂದ ಹೊರಟುಹೋಗಿ ಸರೋವರದ ಬಳಿಯಲ್ಲಿ ಕುಳಿತುಕೊಂಡರು. <verse eid="MAT 13:1"/><verse number="2" style="v" sid="MAT 13:2"/>ಆಗ ಜನರ ದೊಡ್ಡ ಸಮೂಹವು ಯೇಸುವಿನ ಬಳಿಗೆ ಕೂಡಿಬಂದದ್ದರಿಂದ ಅವರು ದೋಣಿಯನ್ನು ಹತ್ತಿ ಕುಳಿತುಕೊಂಡರು, ಆ ಸಮೂಹದವರೆಲ್ಲಾ ದಡದ ಮೇಲೆ ನಿಂತಿದ್ದರು. <verse eid="MAT 13:2"/><verse number="3" style="v" sid="MAT 13:3"/>ಆಗ ಯೇಸು ಅನೇಕ ವಿಷಯಗಳನ್ನು ಅವರಿಗೆ ಸಾಮ್ಯಗಳಲ್ಲಿ ಹೇಳಿದ್ದು: “ಒಬ್ಬ ರೈತನು ಬಿತ್ತುವುದಕ್ಕೆ ಹೊರಟನು; <verse eid="MAT 13:3"/><verse number="4" style="v" sid="MAT 13:4"/>ಅವನು ಬಿತ್ತುತ್ತಿರುವಾಗ ಕೆಲವು ಬೀಜಗಳು ದಾರಿಯ ಪಕ್ಕದಲ್ಲಿ ಬಿದ್ದವು, ಪಕ್ಷಿಗಳು ಬಂದು ಅವುಗಳನ್ನು ತಿಂದುಬಿಟ್ಟವು. <verse eid="MAT 13:4"/><verse number="5" style="v" sid="MAT 13:5"/>ಕೆಲವು ಬೀಜಗಳು ಹೆಚ್ಚು ಮಣ್ಣಿಲ್ಲದ ಬಂಡೆಯ ಸ್ಥಳಗಳಲ್ಲಿ ಬಿದ್ದವು. ಅಲ್ಲಿ ಆಳವಾದ ಮಣ್ಣಿಲ್ಲದ ಕಾರಣ ಅವು ಬೇಗನೆ ಮೊಳೆತವು. <verse eid="MAT 13:5"/><verse number="6" style="v" sid="MAT 13:6"/>ಆದರೆ ಬಿಸಿಲೇರಿದಾಗ ಅವು ಬಾಡಿಹೋಗಿ, ಬೇರಿಲ್ಲದ ಕಾರಣ ಒಣಗಿಹೋದವು. <verse eid="MAT 13:6"/><verse number="7" style="v" sid="MAT 13:7"/>ಕೆಲವು ಬೀಜಗಳು ಮುಳ್ಳುಗಿಡಗಳ ಮಧ್ಯದಲ್ಲಿ ಬಿದ್ದವು, ಆ ಮುಳ್ಳುಗಿಡಗಳು ಬೆಳೆದು ಅವುಗಳನ್ನು ಅಡಗಿಸಿಬಿಟ್ಟವು. <verse eid="MAT 13:7"/><verse number="8" style="v" sid="MAT 13:8"/>ಆದರೆ ಕೆಲವು ಬೀಜಗಳು ಒಳ್ಳೆಯ ಭೂಮಿಯಲ್ಲಿ ಬಿದ್ದು, ಒಂದು ನೂರರಷ್ಟು ಮತ್ತೆ ಕೆಲವು ಅರವತ್ತರಷ್ಟು ಇನ್ನು ಕೆಲವು ಮೂವತ್ತರಷ್ಟು ಫಲಕೊಟ್ಟವು. <verse eid="MAT 13:8"/><verse number="9" style="v" sid="MAT 13:9"/>ಕೇಳುವುದಕ್ಕೆ ಕಿವಿಯುಳ್ಳವರು ಕೇಳಲಿ.”<verse eid="MAT 13:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 13:10"/>ತರುವಾಯ ಶಿಷ್ಯರು ಬಂದು ಯೇಸುವಿಗೆ, “ನೀವು ಸಾಮ್ಯಗಳಲ್ಲಿ ಅವರೊಡನೆ ಮಾತನಾಡುವುದೇಕೆ?” ಎಂದು ಕೇಳಿದರು.<verse eid="MAT 13:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 13:11"/>ಯೇಸು ಅದಕ್ಕೆ ಉತ್ತರವಾಗಿ ಹೇಳಿದ್ದು: “ಪರಲೋಕ ರಾಜ್ಯದ ರಹಸ್ಯಗಳನ್ನು ತಿಳಿದುಕೊಳ್ಳುವ ಜ್ಞಾನವು ನಿಮಗೆ ಕೊಡಲಾಗಿದೆ, ಆದರೆ ಅವರಿಗಲ್ಲ. <verse eid="MAT 13:11"/><verse number="12" style="v" sid="MAT 13:12"/>ಇದ್ದವರಿಗೆ ಇನ್ನೂ ಹೆಚ್ಚಾಗಿ ಕೊಡಲಾಗುವುದು, ಅವರಿಗೆ ಹೆಚ್ಚು ಸಮೃದ್ಧಿಯಾಗುವುದು. ಇಲ್ಲದವರ ಕಡೆಯಿಂದ ಇದ್ದ ಅಲ್ಪವನ್ನೂ ತೆಗೆದುಕೊಳ್ಳಲಾಗುವುದು.” <verse eid="MAT 13:12"/><verse number="13" style="v" sid="MAT 13:13"/>ಆದ್ದರಿಂದ, ನಾನು ಅವರೊಡನೆ ಸಾಮ್ಯಗಳಲ್ಲಿ ಮಾತನಾಡುತ್ತೇನೆ:</para>
  <para style="q1" vid="MAT 13:13">“ಏಕೆಂದರೆ ಅವರು ಕಣ್ಣಾರೆ ನೋಡಿದರೂ ಕಾಣುವುದಿಲ್ಲ;</para>
  <para style="q2" vid="MAT 13:13">ಕೇಳಿದರೂ ತಿಳಿದುಕೊಳ್ಳುವುದಿಲ್ಲ; ಅವರು ಗ್ರಹಿಸುವುದೂ ಇಲ್ಲ.<verse eid="MAT 13:13"/></para>
  <para style="m">
    <verse number="14" style="v" sid="MAT 13:14"/>ಹೀಗೆ ಯೆಶಾಯನ ಪ್ರವಾದನೆಯು ಅವರಲ್ಲಿ ನೆರವೇರಿತು. ಅದೇನೆಂದರೆ,</para>
  <para style="q1" vid="MAT 13:14">“ ‘ನೀವು ಕೇಳುತ್ತಲೇ ಇರುವಿರಿ, ಎಂದೆಂದೂ ಅರ್ಥಮಾಡಿಕೊಳ್ಳಲಾರಿರಿ;</para>
  <para style="q2" vid="MAT 13:14">ನೀವು ಕಾಣುತ್ತಲೇ ಇರುವಿರಿ, ಎಂದೆಂದೂ ಅರಿತುಕೊಳ್ಳಲಾರಿರಿ.<verse eid="MAT 13:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="MAT 13:15"/>ಈ ಜನರ ಹೃದಯವು ಕಠೋರವಾಗಿದೆ;</para>
  <para style="q2" vid="MAT 13:15">ಇವರ ಕಿವಿಗಳು ಕೇಳದ ಹಾಗೆ ಮಂದವಾಗಿವೆ,</para>
  <para style="q2" vid="MAT 13:15">ಇವರು ತಮ್ಮ ಕಣ್ಣುಗಳನ್ನು ಮುಚ್ಚಿಕೊಂಡಿದ್ದಾರೆ.</para>
  <para style="q1" vid="MAT 13:15">ಇಲ್ಲವಾದರೆ ತಾವು ಕಣ್ಣಿನಿಂದ ಕಂಡು,</para>
  <para style="q2" vid="MAT 13:15">ಕಿವಿಯಿಂದ ಕೇಳಿ.</para>
  <para style="q2" vid="MAT 13:15">ತಮ್ಮ ಹೃದಯದಿಂದ ತಿಳಿದು,</para>
  <para style="q1" vid="MAT 13:15">ನನ್ನ ಕಡೆಗೆ ತಿರುಗಿಕೊಂಡಿದ್ದರೆ, ನಾನು ಅವರನ್ನು ಸ್ವಸ್ಥಪಡಿಸುತ್ತಿದ್ದೆನು,’<note caller="+" style="f"><char style="fr" closed="false">13:15 </char><char style="ft" closed="false"><char style="xt"><ref loc="ISA 6:9">ಯೆಶಾಯ 6:9</ref>,<ref loc="ISA 6:10">10</ref></char></char></note></para>
  <para style="m" vid="MAT 13:15">ಎಂಬುದೇ. <verse eid="MAT 13:15"/><verse number="16" style="v" sid="MAT 13:16"/>ಆದರೆ ನಿಮ್ಮ ಕಣ್ಣುಗಳು ಕಾಣುವುದರಿಂದಲೂ ನಿಮ್ಮ ಕಿವಿಗಳು ಕೇಳುವುದರಿಂದಲೂ ನೀವು ಧನ್ಯರು. <verse eid="MAT 13:16"/><verse number="17" style="v" sid="MAT 13:17"/>ನಾನು ಸತ್ಯವಾಗಿ ನಿಮಗೆ ಹೇಳುತ್ತೇನೆ, ಅನೇಕ ಪ್ರವಾದಿಗಳು ಮತ್ತು ನೀತಿವಂತರು ನೀವು ಕಾಣುವಂಥವುಗಳನ್ನು ಕಾಣಬೇಕೆಂದು ಅಪೇಕ್ಷಿಸಿದರೂ ಕಾಣಲಿಲ್ಲ ಮತ್ತು ನೀವು ಕೇಳುವಂಥವುಗಳನ್ನು ಕೇಳಬೇಕೆಂದು ಅಪೇಕ್ಷಿಸಿದರೂ ಅವರು ಕೇಳಲಿಲ್ಲ.<verse eid="MAT 13:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 13:18"/>“ಆದ್ದರಿಂದ ಬಿತ್ತುವವನ ಸಾಮ್ಯದ ಅರ್ಥವನ್ನು ನೀವು ಕೇಳಿರಿ: <verse eid="MAT 13:18"/><verse number="19" style="v" sid="MAT 13:19"/>ಯಾರಾದರೂ ಪರಲೋಕ ರಾಜ್ಯದ ವಾಕ್ಯವನ್ನು ಕೇಳಿ ಗ್ರಹಿಸದೆ ಇರುವಾಗ, ಕೆಡುಕನು ಬಂದು ಅವರ ಹೃದಯದಲ್ಲಿ ಬಿತ್ತಿದ್ದನ್ನು ತೆಗೆದುಹಾಕುತ್ತಾನೆ, ಇದೇ ದಾರಿಯ ಪಕ್ಕದಲ್ಲಿ ಬಿತ್ತಲಾಗಿರುವ ಬೀಜವಾಗಿರುವದು. <verse eid="MAT 13:19"/><verse number="20" style="v" sid="MAT 13:20"/>ಕಲ್ಲು ನೆಲದ ಮೇಲೆ ಬಿತ್ತಲಾಗಿರುವ ಬೀಜವಾಗಿರುವವರು, ವಾಕ್ಯವನ್ನು ಕೇಳಿದ ಕೂಡಲೇ ಸಂತೋಷದಿಂದ ಅದನ್ನು ಸ್ವೀಕರಿಸುತ್ತಾರೆ. <verse eid="MAT 13:20"/><verse number="21" style="v" sid="MAT 13:21"/>ಆದರೆ ಅವರಲ್ಲಿ ಬೇರಿಲ್ಲದ ಕಾರಣ ಸ್ವಲ್ಪಕಾಲ ಮಾತ್ರ ಇದ್ದು, ವಾಕ್ಯದ ನಿಮಿತ್ತವಾಗಿ ಸಂಕಟ ಇಲ್ಲವೆ ಹಿಂಸೆ ಬಂದಾಗ, ಅವರು ಬೇಗನೆ ಬಿದ್ದು ಹೋಗುತ್ತಾರೆ.<note caller="+" style="f"><char style="fr" closed="false">13:21 </char><char style="ft" closed="false">ಅಂದರೆ </char><char style="fqa" closed="false">ವಿಶ್ವಾಸದಲ್ಲಿ ಬೀಳುತ್ತಾರೆ.</char></note> <verse eid="MAT 13:21"/><verse number="22" style="v" sid="MAT 13:22"/>ಮುಳ್ಳುಗಿಡಗಳಲ್ಲಿ ಬಿತ್ತಲಾಗಿರುವ ಬೀಜವಾಗಿರುವವರು ವಾಕ್ಯವನ್ನು ಕೇಳುತ್ತಾರೆ, ಆದರೆ ಈ ಜೀವನದ ಚಿಂತೆಗಳೂ ಐಶ್ವರ್ಯದ ವ್ಯಾಮೋಹವೂ ವಾಕ್ಯವನ್ನು ಅಡಗಿಸುವುದರಿಂದ, ವಾಕ್ಯವು ಫಲವನ್ನು ಕೊಡುವುದಿಲ್ಲ. <verse eid="MAT 13:22"/><verse number="23" style="v" sid="MAT 13:23"/>ಆದರೆ ಒಳ್ಳೆಯ ಭೂಮಿಯಲ್ಲಿ ಬಿತ್ತಲಾಗಿರುವ ಬೀಜವಾಗಿರುವವರು, ವಾಕ್ಯವನ್ನು ಕೇಳಿ ಅದನ್ನು ಗ್ರಹಿಸಿಕೊಳ್ಳುತ್ತಾರೆ. ಇವರು ಫಲ ಫಲಿಸುವವರಾಗಿ ನೂರರಷ್ಟು ಅರವತ್ತರಷ್ಟು ಮತ್ತು ಮೂವತ್ತರಷ್ಟು ಫಲವನ್ನು ಕೊಡುತ್ತಾರೆ.”<verse eid="MAT 13:23"/></para>
  <para style="s1">ಕಳೆಯನ್ನು ಕುರಿತು ಸಾಮ್ಯ</para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 13:24"/>ಯೇಸು ಮತ್ತೊಂದು ಸಾಮ್ಯವನ್ನು ಹೇಳಿದರು: “ಪರಲೋಕ ರಾಜ್ಯವು ಒಳ್ಳೆಯ ಬೀಜವನ್ನು ತನ್ನ ಹೊಲದಲ್ಲಿ ಬಿತ್ತಿದ ಒಬ್ಬ ಮನುಷ್ಯನಿಗೆ ಹೋಲಿಕೆಯಾಗಿದೆ. <verse eid="MAT 13:24"/><verse number="25" style="v" sid="MAT 13:25"/>ಆದರೆ ಜನರು ನಿದ್ರಿಸುತ್ತಿರುವಾಗ, ಅವನ ವೈರಿಯು ಬಂದು ಗೋಧಿಯ ನಡುವೆ ಕಳೆಯನ್ನು ಬಿತ್ತಿ ಹೊರಟುಹೋದನು. <verse eid="MAT 13:25"/><verse number="26" style="v" sid="MAT 13:26"/>ಗೋಧಿಯು ಮೊಳೆತು ಬೆಳೆಯುತ್ತಿರುವಾಗ, ಕಳೆ ಸಹ ಕಾಣಿಸಿಕೊಂಡಿತು.<verse eid="MAT 13:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 13:27"/>“ಮನೆಯ ಯಜಮಾನನ ಸೇವಕರು ಅವನ ಬಳಿಗೆ ಬಂದು ಅವನಿಗೆ, ‘ಅಯ್ಯಾ, ನೀನು ನಿನ್ನ ಹೊಲದಲ್ಲಿ ಒಳ್ಳೆಯ ಬೀಜವನ್ನು ಬಿತ್ತಿದೆಯಲ್ಲಾ? ಆದರೆ ಈ ಕಳೆಯು ಎಲ್ಲಿಂದ ಬಂತು?’ ಎಂದು ಕೇಳಿದರು.<verse eid="MAT 13:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 13:28"/>“ಯಜಮಾನನು ಅವರಿಗೆ, ‘ವೈರಿಯು ಇದನ್ನು ಮಾಡಿದ್ದಾನೆ,’ ಎಂದನು.</para>
  <para style="p" vid="MAT 13:28">“ಆಗ ಸೇವಕರು ಅವನಿಗೆ, ‘ನಾವು ಹೋಗಿ ಅವುಗಳನ್ನು ಕಿತ್ತುಹಾಕೋಣವೇ?’ ಎಂದು ಕೇಳಿದರು.<verse eid="MAT 13:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 13:29"/>“ಆದರೆ ಯಜಮಾನನು, ‘ಬೇಡ, ನೀವು ಕಳೆಯನ್ನು ಕೀಳುವಾಗ, ಅವುಗಳೊಂದಿಗೆ ಗೋಧಿಯನ್ನೂ ಕಿತ್ತುಬಿಟ್ಟೀರಿ. <verse eid="MAT 13:29"/><verse number="30" style="v" sid="MAT 13:30"/>ಸುಗ್ಗಿಯ ಕಾಲದವರೆಗೆ ಎರಡೂ ಜೊತೆಯಲ್ಲಿ ಬೆಳೆಯಲಿ. ಸುಗ್ಗಿಯ ಕಾಲದಲ್ಲಿ ನಾನು ಕೊಯ್ಯುವವರಿಗೆ: ಮೊದಲು ಕಳೆಯನ್ನು ಕೂಡಿಸಿ ಅವುಗಳನ್ನು ಸುಡುವುದಕ್ಕೆ ಬೇರೆ ಕಟ್ಟಿಡಿರಿ, ಗೋಧಿಯನ್ನು ನನ್ನ ಕಣಜದಲ್ಲಿ ಕೂಡಿಸಿರಿ ಎಂದು ಹೇಳುವೆನು,’ ಅಂದನು.”<verse eid="MAT 13:30"/></para>
  <para style="s1">ಸಾಸಿವೆಕಾಳಿನ ಸಾಮ್ಯ</para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 13:31"/>ಯೇಸು ಮತ್ತೊಂದು ಸಾಮ್ಯವನ್ನು ಅವರಿಗೆ ಹೇಳಿದರು: “ಪರಲೋಕ ರಾಜ್ಯವು, ಒಬ್ಬ ಮನುಷ್ಯನು ಸಾಸಿವೆ ಕಾಳನ್ನು ತೆಗೆದುಕೊಂಡುಹೋಗಿ ತನ್ನ ಹೊಲದಲ್ಲಿ ಬಿತ್ತಿದ್ದಕ್ಕೆ ಹೋಲಿಕೆಯಾಗಿದೆ. <verse eid="MAT 13:31"/><verse number="32" style="v" sid="MAT 13:32"/>ಅದು ಎಲ್ಲಾ ಬೀಜಗಳಿಗಿಂತಲೂ ಸಣ್ಣದಾಗಿದ್ದರೂ ಅದು ಬೆಳೆದಾಗ, ಎಲ್ಲಾ ಸಸ್ಯಗಳಿಗಿಂತಲೂ ದೊಡ್ಡದಾಗಿ ಮರವಾಯಿತು. ಹೀಗೆ ಆಕಾಶದ ಪಕ್ಷಿಗಳು ಬಂದು, ಅದರ ಕೊಂಬೆಗಳಲ್ಲಿ ಗೂಡು ಕಟ್ಟಿ ವಾಸಮಾಡುತ್ತವೆ.”<verse eid="MAT 13:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 13:33"/>ಯೇಸು ಮತ್ತೊಂದು ಸಾಮ್ಯವನ್ನು ಅವರಿಗೆ ಹೇಳಿದರು: “ಪರಲೋಕ ರಾಜ್ಯವು ಹುಳಿಹಿಟ್ಟಿಗೆ ಹೋಲಿಕೆಯಾಗಿದೆ. ಅದನ್ನು ಒಬ್ಬ ಸ್ತ್ರೀಯು ತೆಗೆದುಕೊಂಡು ಹುಳಿಯಿಲ್ಲದ ಸುಮಾರು ಇಪ್ಪತ್ತೇಳು ಕಿಲೋಗ್ರಾಂ<note caller="+" style="f"><char style="fr" closed="false">13:33 </char><char style="ft" closed="false">ಸುಮಾರು ಮೂವತ್ತು ಸೇರು</char></note> ಹಿಟ್ಟಿನಲ್ಲಿ ಕಲಸಿದಾಗ ಆ ಹಿಟ್ಟೆಲ್ಲಾ ಹುಳಿಯಾಯಿತು.”<verse eid="MAT 13:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 13:34"/>ಯೇಸು ಇವೆಲ್ಲವನ್ನು ಜನಸಮೂಹದೊಂದಿಗೆ ಸಾಮ್ಯಗಳಲ್ಲಿಯೇ ಹೇಳಿದರು; ಸಾಮ್ಯವಿಲ್ಲದೆ ಯೇಸು ಅವರಿಗೆ ಏನೂ ಹೇಳುತ್ತಿರಲಿಲ್ಲ. <verse eid="MAT 13:34"/><verse number="35" style="v" sid="MAT 13:35"/>ಹೀಗೆ ಒಬ್ಬ ಪ್ರವಾದಿಯ ಮೂಲಕ ಹೇಳಿದ ಮಾತು ನೆರವೇರಿತು:</para>
  <para style="q1" vid="MAT 13:35">“ನಾನು ಸಾಮ್ಯಗಳನ್ನು ಹೇಳುವಂತೆ ನನ್ನ ಬಾಯಿ ತೆರೆಯುವೆನು.</para>
  <para style="q2" vid="MAT 13:35">ನಾನು ಲೋಕ ಪ್ರಾರಂಭದಿಂದ ಮರೆಯಾದವುಗಳನ್ನು ಪ್ರಕಟಪಡಿಸುವೆನು.”<note caller="+" style="f"><char style="fr" closed="false">13:35 </char><char style="ft" closed="false"><char style="xt"><ref loc="PSA 78:2">ಕೀರ್ತನೆ 78:2</ref></char></char></note><verse eid="MAT 13:35"/></para>
  <para style="s1">ಕಳೆಯ ಸಾಮ್ಯದ ವಿವರಣೆ</para>
  <para style="p">
    <verse number="36" style="v" sid="MAT 13:36"/>ತರುವಾಯ ಯೇಸು ಜನಸಮೂಹವನ್ನು ಕಳುಹಿಸಿಬಿಟ್ಟು ಮನೆಯೊಳಕ್ಕೆ ಹೋದರು. ಆಗ ಶಿಷ್ಯರು ಯೇಸುವಿನ ಬಳಿಗೆ ಬಂದು, “ಹೊಲದಲ್ಲಿರುವ ಕಳೆಯ ಸಾಮ್ಯವನ್ನು ನಮಗೆ ವಿವರಿಸಿರಿ,” ಎಂದರು.<verse eid="MAT 13:36"/></para>
  <para style="p">
    <verse number="37" style="v" sid="MAT 13:37"/>ಯೇಸು ಉತ್ತರವಾಗಿ ಅವರಿಗೆ, “ಒಳ್ಳೆಯ ಬೀಜ ಬಿತ್ತುವವನು ಮನುಷ್ಯಪುತ್ರನು. <verse eid="MAT 13:37"/><verse number="38" style="v" sid="MAT 13:38"/>ಹೊಲವು ಈ ಲೋಕ; ಒಳ್ಳೆಯ ಬೀಜವು ದೇವರ ರಾಜ್ಯದ ಮಕ್ಕಳು; ಕಳೆಯು ಕೆಡುಕನ ಮಕ್ಕಳಾಗಿದ್ದಾರೆ. <verse eid="MAT 13:38"/><verse number="39" style="v" sid="MAT 13:39"/>ಅದನ್ನು ಬಿತ್ತಿದ ವೈರಿಯು ಸೈತಾನನೇ. ಸುಗ್ಗಿಯ ಕಾಲವು ಲೋಕಾಂತ್ಯವಾಗಿದೆ. ಕೊಯ್ಯುವವರು ದೇವದೂತರೇ.<verse eid="MAT 13:39"/></para>
  <para style="p">
    <verse number="40" style="v" sid="MAT 13:40"/>“ಹೇಗೆ ಕಳೆಯನ್ನು ಕಿತ್ತು ಬೆಂಕಿಯಲ್ಲಿ ಸುಡುವರೋ, ಹಾಗೆಯೇ ಈ ಲೋಕಾಂತ್ಯದಲ್ಲಿ ಆಗುವುದು. <verse eid="MAT 13:40"/><verse number="41" style="v" sid="MAT 13:41"/>ಮನುಷ್ಯಪುತ್ರನು ತನ್ನ ದೂತರನ್ನು ಕಳುಹಿಸುವನು. ಅವರು ಪಾಪಕ್ಕೆ ಆತಂಕವಾದ ಎಲ್ಲವನ್ನೂ, ಕೇಡುಮಾಡುವ ಎಲ್ಲರನ್ನೂ ಆತನ ರಾಜ್ಯದೊಳಗಿಂದ ಕೂಡಿಸಿ, <verse eid="MAT 13:41"/><verse number="42" style="v" sid="MAT 13:42"/>ದೂತರು ಅವರನ್ನು ಅಗ್ನಿಕುಂಡದಲ್ಲಿ ಹಾಕುವರು. ಅಲ್ಲಿ ಗೋಳಾಟವೂ ಹಲ್ಲು ಕಡಿಯುವಿಕೆಯೂ ಇರುವವು. <verse eid="MAT 13:42"/><verse number="43" style="v" sid="MAT 13:43"/>ಆಗ ನೀತಿವಂತರು ತಮ್ಮ ತಂದೆಯ ರಾಜ್ಯದಲ್ಲಿ ಸೂರ್ಯನಂತೆ ಪ್ರಕಾಶಿಸುವರು. ಕೇಳುವುದಕ್ಕೆ ಕಿವಿಯುಳ್ಳವರು ಕೇಳಲಿ.<verse eid="MAT 13:43"/></para>
  <para style="s1">ಹೂಳಿಟ್ಟ ನಿಕ್ಷೇಪ ಹಾಗೂ ಮುತ್ತುಗಳ ಸಾಮ್ಯ</para>
  <para style="p">
    <verse number="44" style="v" sid="MAT 13:44"/>“ಪರಲೋಕ ರಾಜ್ಯವು ಹೊಲದಲ್ಲಿ ಹೂಳಿಟ್ಟ ನಿಕ್ಷೇಪಕ್ಕೆ ಹೋಲಿಕೆಯಾಗಿದೆ. ಅದನ್ನು ಒಬ್ಬ ಮನುಷ್ಯನು ಕಂಡುಕೊಂಡು ಮುಚ್ಚಿಟ್ಟು, ಅದರ ಸಂತೋಷದ ನಿಮಿತ್ತ ಹೊರಟುಹೋಗಿ, ತನಗಿದ್ದದ್ದನ್ನೆಲ್ಲಾ ಮಾರಿ ಆ ಹೊಲವನ್ನು ಕೊಂಡುಕೊಳ್ಳುತ್ತಾನೆ.<verse eid="MAT 13:44"/></para>
  <para style="p">
    <verse number="45" style="v" sid="MAT 13:45"/>“ಪರಲೋಕ ರಾಜ್ಯವು ಒಳ್ಳೆಯ ಮುತ್ತುಗಳನ್ನು ಹುಡುಕುವ ವ್ಯಾಪಾರಸ್ಥನಿಗೆ ಹೋಲಿಕೆಯಾಗಿದೆ. <verse eid="MAT 13:45"/><verse number="46" style="v" sid="MAT 13:46"/>ಅವನು ಬಹು ಬೆಲೆಯುಳ್ಳ ಒಂದು ಮುತ್ತನ್ನು ಕಂಡು, ಹೊರಟುಹೋಗಿ ತನಗಿದ್ದದ್ದನ್ನೆಲ್ಲಾ ಮಾರಿ ಅದನ್ನು ಕೊಂಡುಕೊಳ್ಳುತ್ತಾನೆ.<verse eid="MAT 13:46"/></para>
  <para style="s1">ಬಲೆಯ ಸಾಮ್ಯ</para>
  <para style="p">
    <verse number="47" style="v" sid="MAT 13:47"/>“ಪರಲೋಕ ರಾಜ್ಯವು, ಸರೋವರದಲ್ಲಿ ಬೀಸಲಾಗಿ ಎಲ್ಲಾ ತರವಾದ ಮೀನುಗಳನ್ನು ಕೂಡಿಸಿದ ಬಲೆಗೆ ಹೋಲಿಕೆಯಾಗಿದೆ. <verse eid="MAT 13:47"/><verse number="48" style="v" sid="MAT 13:48"/>ಬಲೆ ತುಂಬಿದಾಗ, ಬೆಸ್ತರು ಅದನ್ನು ದಡಕ್ಕೆ ಎಳೆದು ಕೂತುಕೊಂಡು ಒಳ್ಳೆಯವುಗಳನ್ನು ಬುಟ್ಟಿಗಳಲ್ಲಿ ತುಂಬಿಸಿ, ಕೆಟ್ಟವುಗಳನ್ನು ಹೊರಗೆ ಬಿಸಾಡುತ್ತಾರೆ. <verse eid="MAT 13:48"/><verse number="49" style="v" sid="MAT 13:49"/>ಹಾಗೆಯೇ ಲೋಕಾಂತ್ಯದಲ್ಲಿ ಇರುವುದು. ದೇವದೂತರು ಹೊರಟುಬಂದು ನೀತಿವಂತರ ಮಧ್ಯದಿಂದ ಕೆಡುಕರನ್ನು ಪ್ರತ್ಯೇಕಿಸಿ, <verse eid="MAT 13:49"/><verse number="50" style="v" sid="MAT 13:50"/>ಅವರನ್ನು ಅಗ್ನಿಕುಂಡದಲ್ಲಿ ಹಾಕುವರು. ಅಲ್ಲಿ ಗೋಳಾಟವೂ ಹಲ್ಲು ಕಡಿಯುವಿಕೆಯೂ ಇರುವವು,” ಎಂದು ಹೇಳಿದರು.<verse eid="MAT 13:50"/></para>
  <para style="p">
    <verse number="51" style="v" sid="MAT 13:51"/>ಯೇಸು ಶಿಷ್ಯರಿಗೆ, “ಇವುಗಳನ್ನೆಲ್ಲಾ ನೀವು ಗ್ರಹಿಸಿದ್ದೀರಾ?” ಎಂದು ಕೇಳಿದರು.</para>
  <para style="p" vid="MAT 13:51">ಅದಕ್ಕೆ, ಅವರು ಯೇಸುವಿಗೆ, “ಹೌದು,” ಎಂದು ಹೇಳಿದರು.<verse eid="MAT 13:51"/></para>
  <para style="p">
    <verse number="52" style="v" sid="MAT 13:52"/>ಯೇಸು ಅವರಿಗೆ, “ಆದಕಾರಣ ಪರಲೋಕ ರಾಜ್ಯದ ಶಿಷ್ಯನಾಗಿರುವ ಪ್ರತಿಯೊಬ್ಬ ನಿಯಮ ಬೋಧಕನು, ತನ್ನ ಬೊಕ್ಕಸದೊಳಗಿಂದ ಹೊಸ ಮತ್ತು ಹಳೆಯ ವಸ್ತುಗಳನ್ನು ಹೊರಗೆ ತರುವ ಒಬ್ಬ ಮನೆ ಯಜಮಾನನಿಗೆ ಹೋಲಿಕೆಯಾಗಿದ್ದಾನೆ,” ಎಂದರು.<verse eid="MAT 13:52"/></para>
  <para style="s1">ಗೌರವವಿಲ್ಲದ ಪ್ರವಾದಿ</para>
  <para style="p">
    <verse number="53" style="v" sid="MAT 13:53"/>ಈ ಸಾಮ್ಯಗಳನ್ನು ಮುಗಿಸಿದ ತರುವಾಯ ಯೇಸು ಅಲ್ಲಿಂದ ಹೊರಟು ಹೋದರು. <verse eid="MAT 13:53"/><verse number="54" style="v" sid="MAT 13:54"/>ಯೇಸು ತಮ್ಮ ಸ್ವಂತ ಊರಿಗೆ ಬಂದು ಅವರ ಸಭಾಮಂದಿರದಲ್ಲಿ ಅವರಿಗೆ ಬೋಧನೆ ಮಾಡಲು ಪ್ರಾರಂಭಿಸಲು, ಅವರು ವಿಸ್ಮಯಗೊಂಡು, “ಈ ಜ್ಞಾನವೂ ಈ ಮಹತ್ಕಾರ್ಯಗಳೂ ಈತನಿಗೆ ಎಲ್ಲಿಂದ ಬಂದವು? <verse eid="MAT 13:54"/><verse number="55" style="v" sid="MAT 13:55"/>ಈತನು ಬಡಗಿಯ ಪುತ್ರನಲ್ಲವೇ? ಮರಿಯಳೆಂಬುವಳು ಈತನ ತಾಯಿಯಲ್ಲವೇ? ಯಾಕೋಬ, ಯೋಸೇಫ, ಸೀಮೋನ, ಯೂದ ಎಂಬುವರು ಈತನ ತಮ್ಮಂದಿರಲ್ಲವೇ? <verse eid="MAT 13:55"/><verse number="56" style="v" sid="MAT 13:56"/>ಈತನ ತಂಗಿಯರೆಲ್ಲರೂ ನಮ್ಮೊಂದಿಗೆ ಇದ್ದಾರಲ್ಲವೇ? ಹಾಗಾದರೆ, ಇವೆಲ್ಲವು ಈತನಿಗೆ ಎಲ್ಲಿಂದ ಬಂದವು?” ಎಂದು ಮಾತನಾಡಿಕೊಂಡರು. <verse eid="MAT 13:56"/><verse number="57" style="v" sid="MAT 13:57"/>ಅವರು ಯೇಸುವನ್ನು ತಾತ್ಸಾರ ಮಾಡಿದರು.</para>
  <para style="p" vid="MAT 13:57">ಆದರೆ ಯೇಸು ಅವರಿಗೆ, “ಪ್ರವಾದಿಗೆ ತನ್ನ ಸ್ವಂತ ಊರಿನಲ್ಲಿ ಹಾಗೂ ತನ್ನ ಸ್ವಂತ ಮನೆಯಲ್ಲಿ ಮಾತ್ರ ಮರ್ಯಾದೆ ಇರುವುದಿಲ್ಲ,” ಎಂದರು.<verse eid="MAT 13:57"/></para>
  <para style="p">
    <verse number="58" style="v" sid="MAT 13:58"/>ಯೇಸು ಅವರ ಅಪನಂಬಿಕೆಯ ದೆಸೆಯಿಂದ ಅಲ್ಲಿ ಬಹಳ ಮಹತ್ಕಾರ್ಯಗಳನ್ನು ಮಾಡಲಿಲ್ಲ.<verse eid="MAT 13:58"/></para>
  <chapter eid="MAT 13"/>
  <chapter number="14" style="c" sid="MAT 14"/>
  <para style="s1">ಸ್ನಾನಿಕನಾದ ಯೋಹಾನನ ಶಿರಚ್ಛೇದನ</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 14:1"/>ಆ ಕಾಲದಲ್ಲಿ ಚತುರಾಧಿಪತಿಯಾದ<note caller="+" style="f"><char style="fr" closed="false">14:1 </char><char style="ft" closed="false">ನಾಲ್ಕರಲ್ಲಿ ಒಂದು ಭಾಗವನ್ನು ಆಳುವವನು</char></note> ಹೆರೋದನು ಯೇಸುವಿನ ಕೀರ್ತಿಯನ್ನು ಕೇಳಿ, <verse eid="MAT 14:1"/><verse number="2" style="v" sid="MAT 14:2"/>ತನ್ನ ಸೇವಕರಿಗೆ, “ಈತನು ಸ್ನಾನಿಕನಾದ ಯೋಹಾನನೇ. ಈಗ ಇವನು ಸತ್ತವರೊಳಗಿಂದ ಎದ್ದಿದ್ದಾನೆ! ಆದ್ದರಿಂದಲೇ ಈತನಲ್ಲಿ ಅದ್ಭುತಕಾರ್ಯಗಳನ್ನು ನಡೆಸುವ ಶಕ್ತಿಗಳಿವೆ,” ಎಂದು ಹೇಳಿದನು.<verse eid="MAT 14:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 14:3"/>ಹೆರೋದನು ತನ್ನ ಸಹೋದರ ಫಿಲಿಪ್ಪನ ಹೆಂಡತಿಯಾದ ಹೆರೋದ್ಯಳ ನಿಮಿತ್ತವಾಗಿ, ಯೋಹಾನನನ್ನು ಹಿಡಿಸಿ, ಕಟ್ಟಿ ಸೆರೆಯಲ್ಲಿ ಹಾಕಿಸಿದ್ದನು. <verse eid="MAT 14:3"/><verse number="4" style="v" sid="MAT 14:4"/>ಏಕೆಂದರೆ ಯೋಹಾನನು, “ನೀನು ಅವಳನ್ನು ಇಟ್ಟುಕೊಂಡಿರುವುದು ನ್ಯಾಯವಲ್ಲ,” ಎಂದು ಅವನಿಗೆ ಹೇಳಿದ್ದನು. <verse eid="MAT 14:4"/><verse number="5" style="v" sid="MAT 14:5"/>ಹೆರೋದನು ಯೋಹಾನನನ್ನು ಕೊಲ್ಲಬೇಕೆಂದಿದ್ದರೂ ಜನಸಮೂಹಕ್ಕೆ ಭಯಪಟ್ಟನು. ಅವರು ಯೋಹಾನನನ್ನು ಪ್ರವಾದಿಯೆಂದು ಎಣಿಸಿದ್ದರು.<verse eid="MAT 14:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 14:6"/>ಆದರೆ ಹೆರೋದನ ಹುಟ್ಟಿದ ದಿನವನ್ನು ಆಚರಿಸುವಾಗ, ಹೆರೋದ್ಯಳ ಮಗಳು ಅವರ ಮುಂದೆ ನರ್ತನ ಮಾಡಿ ಹೆರೋದನನ್ನು ಬಹಳ ಮೆಚ್ಚಿಸಿದಳು. <verse eid="MAT 14:6"/><verse number="7" style="v" sid="MAT 14:7"/>ಆದ್ದರಿಂದ ಅವಳು ಏನು ಕೇಳಿಕೊಂಡರೂ ಅವಳಿಗೆ ಕೊಡುವೆನೆಂದು ಅರಸನು ಆಣೆಯಿಟ್ಟು ಪ್ರಮಾಣ ಮಾಡಿದನು. <verse eid="MAT 14:7"/><verse number="8" style="v" sid="MAT 14:8"/>ಅವಳು ತನ್ನ ತಾಯಿಯ ಸಲಹೆ ಪಡೆದು, “ಸ್ನಾನಿಕನಾದ ಯೋಹಾನನ ತಲೆಯನ್ನು ಇಲ್ಲಿಯೇ ಒಂದು ತಟ್ಟೆಯಲ್ಲಿ ನನಗೆ ತರಿಸಿಕೊಡು,” ಎಂದು ಹೇಳಿದಳು. <verse eid="MAT 14:8"/><verse number="9" style="v" sid="MAT 14:9"/>ಆಗ ಅರಸನು ದುಃಖಪಟ್ಟರೂ ತನ್ನ ಪ್ರಮಾಣದ ನಿಮಿತ್ತವಾಗಿ ಮತ್ತು ಭೋಜನಕ್ಕೆ ಬಂದ ಅತಿಥಿಗಳ ನಿಮಿತ್ತವಾಗಿ ಅದನ್ನು ಅವಳಿಗೆ ಕೊಡುವಂತೆ ಅಪ್ಪಣೆಕೊಟ್ಟನು. <verse eid="MAT 14:9"/><verse number="10" style="v" sid="MAT 14:10"/>ಅವನು ಆಳುಗಳನ್ನು ಕಳುಹಿಸಿ ಸೆರೆಮನೆಯಲ್ಲಿದ್ದ ಯೋಹಾನನ ತಲೆಯನ್ನು ಕಡಿಸಿದನು. <verse eid="MAT 14:10"/><verse number="11" style="v" sid="MAT 14:11"/>ಇದಲ್ಲದೆ ಅವನ ತಲೆಯನ್ನು ಒಂದು ತಟ್ಟೆಯಲ್ಲಿ ತಂದು ಆ ಹುಡುಗಿಗೆ ಕೊಟ್ಟರು. ಅವಳು ಅದನ್ನು ತನ್ನ ತಾಯಿಯ ಬಳಿಗೆ ತಂದಳು. <verse eid="MAT 14:11"/><verse number="12" style="v" sid="MAT 14:12"/>ಬಳಿಕ ಯೋಹಾನನ ಶಿಷ್ಯರು ಬಂದು ಅವನ ಶವವನ್ನು ತೆಗೆದುಕೊಂಡುಹೋಗಿ ಸಮಾಧಿಮಾಡಿದರು. ಅನಂತರ ಹೋಗಿ ಯೇಸುವಿಗೆ ತಿಳಿಸಿದರು.<verse eid="MAT 14:12"/></para>
  <para style="s1">ಯೇಸು ಐದು ಸಾವಿರ ಜನರಿಗೆ ಊಟಮಾಡಿಸಿದ್ದು</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 14:13"/>ಯೇಸು ಆ ವಿಷಯವನ್ನು ಕೇಳಿದಾಗ ದೋಣಿಯನ್ನು ಹತ್ತಿ ಅಲ್ಲಿಂದ ಏಕಾಂತ ಸ್ಥಳಕ್ಕೆ ಹೊರಟರು. ಜನರು ಇದನ್ನು ಕೇಳಿ ಪಟ್ಟಣಗಳಿಂದ ಕಾಲು ನಡಿಗೆಯಲ್ಲಿ ಯೇಸುವನ್ನು ಹಿಂಬಾಲಿಸಿದರು. <verse eid="MAT 14:13"/><verse number="14" style="v" sid="MAT 14:14"/>ಯೇಸು ದೋಣಿಯಿಂದ ಇಳಿದಾಗ ದೊಡ್ಡ ಜನಸಮೂಹವನ್ನು ಕಂಡು, ಅವರ ಮೇಲೆ ಕನಿಕರಪಟ್ಟು, ಅವರಲ್ಲಿದ್ದ ರೋಗಿಗಳನ್ನು ಸ್ವಸ್ಥಮಾಡಿದರು.<verse eid="MAT 14:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 14:15"/>ಸಂಜೆಯಾದಾಗ ಶಿಷ್ಯರು ಯೇಸುವಿನ ಬಳಿಗೆ ಬಂದು, “ಇದು ನಿರ್ಜನಪ್ರದೇಶ, ಸಮಯವು ದಾಟಿದೆ. ಜನರು ಹಳ್ಳಿಗಳಿಗೆ ಹೋಗಿ ತಮಗಾಗಿ ಆಹಾರವನ್ನು ಕೊಂಡುಕೊಳ್ಳುವಂತೆ ಅವರನ್ನು ಕಳುಹಿಸಿಬಿಡು,” ಎಂದರು.<verse eid="MAT 14:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 14:16"/>ಆದರೆ ಯೇಸುವು, “ಅವರು ಹೋಗಬೇಕಾಗಿಲ್ಲ. ನೀವೇ ಅವರಿಗೆ ಊಟಕ್ಕೆ ಏನಾದರೂ ಕೊಡಿರಿ,” ಎಂದು ಹೇಳಿದರು.<verse eid="MAT 14:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 14:17"/>ಅವರು ಯೇಸುವಿಗೆ, “ನಮ್ಮ ಹತ್ತಿರ ಐದು ರೊಟ್ಟಿ ಎರಡು ಮೀನುಗಳು ಮಾತ್ರ ಇವೆ,” ಎಂದು ಉತ್ತರಕೊಟ್ಟರು.<verse eid="MAT 14:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 14:18"/>ಯೇಸು, “ಅವುಗಳನ್ನು ತೆಗೆದುಕೊಂಡು ನನ್ನ ಬಳಿಗೆ ಬನ್ನಿರಿ,” ಎಂದರು. <verse eid="MAT 14:18"/><verse number="19" style="v" sid="MAT 14:19"/>ಜನಸಮೂಹವು ಹುಲ್ಲಿನ ಮೇಲೆ ಕುಳಿತುಕೊಳ್ಳಬೇಕೆಂದು ಯೇಸು ಅಪ್ಪಣೆಕೊಟ್ಟು, ಆ ಐದು ರೊಟ್ಟಿ ಎರಡು ಮೀನುಗಳನ್ನು ತೆಗೆದುಕೊಂಡು ಪರಲೋಕದ ಕಡೆಗೆ ನೋಡಿ, ಅವುಗಳನ್ನು ಆಶೀರ್ವದಿಸಿ ಮುರಿದು, ತಮ್ಮ ಶಿಷ್ಯರಿಗೆ ಕೊಟ್ಟರು. ಶಿಷ್ಯರು ಜನಸಮೂಹಕ್ಕೆ ಕೊಟ್ಟರು. <verse eid="MAT 14:19"/><verse number="20" style="v" sid="MAT 14:20"/>ಅವರೆಲ್ಲರೂ ತಿಂದು ತೃಪ್ತರಾದರು. ಶಿಷ್ಯರು ಉಳಿದ ತುಂಡುಗಳನ್ನು ಕೂಡಿಸಲು ಹನ್ನೆರಡು ಬುಟ್ಟಿ ತುಂಬಿದವು. <verse eid="MAT 14:20"/><verse number="21" style="v" sid="MAT 14:21"/>ಊಟಮಾಡಿದವರಲ್ಲಿ ಸ್ತ್ರೀಯರೂ ಮಕ್ಕಳೂ ಅಲ್ಲದೆ ಗಂಡಸರೇ ಹೆಚ್ಚು ಕಡಿಮೆ ಐದು ಸಾವಿರ ಮಂದಿ ಇದ್ದರು.<verse eid="MAT 14:21"/></para>
  <para style="s1">ಯೇಸು ನೀರಿನ ಮೇಲೆ ನಡೆದದ್ದು</para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 14:22"/>ಇದಾದ ಕೂಡಲೇ ಯೇಸು ಜನರ ಗುಂಪನ್ನು ಕಳುಹಿಸಿಬಿಡುವಷ್ಟರಲ್ಲಿ, ತಮ್ಮ ಶಿಷ್ಯರು ದೋಣಿಯನ್ನು ಹತ್ತಿ ತಮಗಿಂತ ಮುಂದಾಗಿ ಆಚೆದಡಕ್ಕೆ ಹೋಗಬೇಕೆಂದು ಆಜ್ಞಾಪಿಸಿದರು. <verse eid="MAT 14:22"/><verse number="23" style="v" sid="MAT 14:23"/>ಯೇಸು ಜನಸಮೂಹವನ್ನು ಕಳುಹಿಸಿದ ಮೇಲೆ, ಪ್ರಾರ್ಥನೆಮಾಡಲು ಏಕಾಂತವಾಗಿ ಬೆಟ್ಟಕ್ಕೆ ಹೋದರು. ಸಂಜೆಯಾದಾಗ ಯೇಸು ಒಬ್ಬರೇ ಅಲ್ಲಿ ಇದ್ದರು. <verse eid="MAT 14:23"/><verse number="24" style="v" sid="MAT 14:24"/>ಅಷ್ಟರಲ್ಲಿ ದೋಣಿಯು ತೀರದಿಂದ ಬಹುದೂರ ಹೋಗಿತ್ತು, ಎದುರುಗಾಳಿ ಬೀಸುತ್ತಿದ್ದದರಿಂದ ತೆರೆಗಳ ಬಡಿತಕ್ಕೆ ಸಿಕ್ಕಿ ಹೊಯ್ದಾಡುತ್ತಿತ್ತು.<verse eid="MAT 14:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 14:25"/>ರಾತ್ರಿ ಮೂರು ಗಂಟೆಯಲ್ಲಿ ಯೇಸು ಸರೋವರದ ಮೇಲೆ, ನಡೆಯುತ್ತಾ ಶಿಷ್ಯರ ಬಳಿಗೆ ಬಂದರು. <verse eid="MAT 14:25"/><verse number="26" style="v" sid="MAT 14:26"/>ಯೇಸು ಸರೋವರದ ಮೇಲೆ ನಡೆಯುವುದನ್ನು ಶಿಷ್ಯರು ಕಂಡು ಕಳವಳಪಟ್ಟು, “ಅದು ಭೂತ,” ಎಂದು ಭೀತಿಯಿಂದ ಕೂಗಿಕೊಂಡರು.<verse eid="MAT 14:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 14:27"/>ಯೇಸು ತಕ್ಷಣವೇ ಅವರಿಗೆ, “ಧೈರ್ಯವಾಗಿರಿ, ನಾನೇ, ಭಯಪಡಬೇಡಿರಿ,” ಎಂದರು.<verse eid="MAT 14:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 14:28"/>ಆಗ ಪೇತ್ರನು ಯೇಸುವಿಗೆ, “ಸ್ವಾಮೀ, ನೀವೇ ಆಗಿದ್ದರೆ, ನೀರಿನ ಮೇಲೆ ನಡೆದು ನಿಮ್ಮ ಬಳಿಗೆ ಬರಲು ನನಗೆ ಅಪ್ಪಣೆಕೊಡಿರಿ,” ಎಂದನು.<verse eid="MAT 14:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 14:29"/>ಅದಕ್ಕೆ ಯೇಸು, “ಬಾ,” ಎಂದರು.</para>
  <para style="p" vid="MAT 14:29">ಆಗ ಪೇತ್ರನು ದೋಣಿಯಿಂದ ಇಳಿದು, ಯೇಸುವಿನ ಬಳಿಗೆ ಹೋಗುವುದಕ್ಕಾಗಿ ನೀರಿನ ಮೇಲೆ ನಡೆದನು. <verse eid="MAT 14:29"/><verse number="30" style="v" sid="MAT 14:30"/>ಆದರೆ ಬಲವಾದ ಗಾಳಿಯನ್ನು ಕಂಡು, ಅವನು ಭಯಪಟ್ಟು ಮುಳುಗುತ್ತಾ, “ಸ್ವಾಮಿ, ನನ್ನನ್ನು ಕಾಪಾಡಿರಿ!” ಎಂದು ಕೂಗಿ ಹೇಳಿದನು.<verse eid="MAT 14:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 14:31"/>ತಕ್ಷಣವೇ ಯೇಸು ತಮ್ಮ ಕೈಯನ್ನು ಚಾಚಿ ಪೇತ್ರನನ್ನು ಹಿಡಿದು, “ಅಲ್ಪ ವಿಶ್ವಾಸಿಯೇ, ನೀನು ಏಕೆ ಸಂದೇಹಪಟ್ಟೆ?” ಎಂದರು.<verse eid="MAT 14:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 14:32"/>ಅವರು ದೋಣಿ ಹತ್ತಿದಾಗ, ಗಾಳಿ ನಿಂತುಹೋಯಿತು. <verse eid="MAT 14:32"/><verse number="33" style="v" sid="MAT 14:33"/>ದೋಣಿಯಲ್ಲಿದ್ದವರು ಯೇಸುವಿನ ಬಳಿಗೆ ಬಂದು ಅವರನ್ನು ಆರಾಧಿಸಿ, “ನಿಜವಾಗಿಯೂ ನೀವು ದೇವಪುತ್ರ,” ಎಂದು ಹೇಳಿದರು.<verse eid="MAT 14:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 14:34"/>ಅವರು ಸರೋವರವನ್ನು ದಾಟಿ, ಗೆನೆಜರೇತ್ ಊರಿಗೆ ಬಂದರು. <verse eid="MAT 14:34"/><verse number="35" style="v" sid="MAT 14:35"/>ಆಗ ಅಲ್ಲಿದ್ದ ಜನರು ಯೇಸುವಿನ ಗುರುತು ಹಿಡಿದು, ಸುತ್ತುಮುತ್ತಲಿನ ಊರುಗಳಿಗೆಲ್ಲಾ ಹೇಳಿ ಕಳುಹಿಸಿ, ರೋಗಿಗಳನ್ನೆಲ್ಲಾ ಯೇಸುವಿನ ಬಳಿಗೆ ತಂದರು. <verse eid="MAT 14:35"/><verse number="36" style="v" sid="MAT 14:36"/>ಅವರು ಯೇಸುವಿನ ಉಡುಪಿನ ಅಂಚನ್ನಾದರೂ ಸ್ಪರ್ಶಿಸಬೇಕೆಂದು ಅವರನ್ನು ಬೇಡಿಕೊಂಡರು. ಯೇಸುವನ್ನು ಮುಟ್ಟಿದವರೆಲ್ಲರೂ ಸ್ವಸ್ಥರಾದರು.<verse eid="MAT 14:36"/></para>
  <chapter eid="MAT 14"/>
  <chapter number="15" style="c" sid="MAT 15"/>
  <para style="s1">ಶುದ್ಧವೂ ಅಶುದ್ಧವೂ</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 15:1"/>ಯೆರೂಸಲೇಮಿನಿಂದ ಫರಿಸಾಯರು ಮತ್ತು ನಿಯಮ ಬೋಧಕರು ಯೇಸುವಿನ ಬಳಿಗೆ ಬಂದು, <verse eid="MAT 15:1"/><verse number="2" style="v" sid="MAT 15:2"/>“ನಿನ್ನ ಶಿಷ್ಯರು ಪೂರ್ವಿಕರ ಸಂಪ್ರದಾಯವನ್ನು ಏಕೆ ಮೀರುತ್ತಾರೆ? ಅವರು ಊಟಕ್ಕೆ ಮುಂಚೆ ತಮ್ಮ ಕೈಗಳನ್ನು ಏಕೆ ತೊಳೆದುಕೊಳ್ಳುವುದಿಲ್ಲ?” ಎಂದರು.<verse eid="MAT 15:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 15:3"/>ಅದಕ್ಕೆ ಯೇಸು ಪ್ರತ್ಯುತ್ತರವಾಗಿ, “ನಿಮ್ಮ ಸಂಪ್ರದಾಯದ ನಿಮಿತ್ತವಾಗಿ ನೀವು ದೇವರ ಆಜ್ಞೆಯನ್ನು ಏಕೆ ಮೀರುತ್ತೀರಿ? <verse eid="MAT 15:3"/><verse number="4" style="v" sid="MAT 15:4"/>‘ನಿಮ್ಮ ತಂದೆತಾಯಿಗಳನ್ನು ಸನ್ಮಾನಿಸಬೇಕು,’<note caller="+" style="f"><char style="fr" closed="false">15:4 </char><char style="ft" closed="false"><char style="xt"><ref loc="EXO 20:12">ವಿಮೋ 20:12</ref>; <ref loc="DEU 5:16">ಧರ್ಮೋ 5:16</ref></char></char></note> ಎಂದೂ ‘ತಂದೆತಾಯಿಗಳನ್ನು ದೂಷಿಸುವವನಿಗೆ ಮರಣದಂಡನೆ ಆಗಬೇಕು,’<note caller="+" style="f"><char style="fr" closed="false">15:4 </char><char style="ft" closed="false"><char style="xt"><ref loc="EXO 21:17">ವಿಮೋ 21:17</ref>; <ref loc="LEV 20:9">ಯಾಜಕ 20:9</ref></char></char></note> ಎಂದು ದೇವರು ಹೇಳಿದ್ದಾರೆ. <verse eid="MAT 15:4"/><verse number="5" style="v" sid="MAT 15:5"/>ಆದರೆ ನೀವು, ಯಾರಾದರೂ ತನ್ನ ತಂದೆಗೆ ಇಲ್ಲವೆ ತಾಯಿಗೆ, ನಾನು ನಿಮ್ಮ ಸಹಾಯಕ್ಕಾಗಿ ಇಟ್ಟಿದ್ದನ್ನು, ‘ದೇವರಿಗೆ ಕೊಟ್ಟಿದ್ದೇನೆ’ ಎಂದು ಹೇಳುವುದಾದರೆ, <verse eid="MAT 15:5"/><verse number="6" style="v" sid="MAT 15:6"/>‘ಅವನು ತನ್ನ ತಂದೆಯನ್ನಾಗಲಿ ತಾಯಿಯನ್ನಾಗಲಿ ಗೌರವಿಸಬೇಕಾಗಿಲ್ಲ’ ಎಂದು ಹೇಳುತ್ತೀರಿ. ಹೀಗೆ ನಿಮ್ಮ ಸಂಪ್ರದಾಯದ ನಿಮಿತ್ತವಾಗಿ ದೇವರ ವಾಕ್ಯವನ್ನು ನಿರರ್ಥಕಮಾಡುತ್ತೀರಿ. <verse eid="MAT 15:6"/><verse number="7" style="v" sid="MAT 15:7"/>ಕಪಟಿಗಳೇ, ನಿಮ್ಮ ವಿಷಯವಾಗಿ ಯೆಶಾಯನು ಸರಿಯಾಗಿ ಪ್ರವಾದಿಸಿದ್ದಾನೆ:<verse eid="MAT 15:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="MAT 15:8"/>“ ‘ಈ ಜನರು ತಮ್ಮ ತುಟಿಗಳಿಂದ ನನ್ನನ್ನು ಸನ್ಮಾನಿಸುತ್ತಾರೆ,</para>
  <para style="q2" vid="MAT 15:8">ಆದರೆ ಅವರ ಹೃದಯವು ನನ್ನಿಂದ ದೂರವಾಗಿದೆ.<verse eid="MAT 15:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="MAT 15:9"/>ಅವರು ಮನುಷ್ಯರ ಆಜ್ಞೆಗಳನ್ನು ಉಪದೇಶಗಳನ್ನಾಗಿ ಬೋಧಿಸುವುದರಿಂದ</para>
  <para style="q2" vid="MAT 15:9">ನನ್ನನ್ನು ಆರಾಧಿಸುವುದು ವ್ಯರ್ಥ.’<note caller="+" style="f"><char style="fr" closed="false">15:9 </char><char style="ft" closed="false"><char style="xt"><ref loc="ISA 29:13">ಯೆಶಾಯ 29:13</ref></char></char></note>”<verse eid="MAT 15:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 15:10"/>ಯೇಸು ಜನಸಮೂಹವನ್ನು ಕರೆದು ಅವರಿಗೆ, “ಕೇಳಿ ತಿಳಿದುಕೊಳ್ಳಿರಿ. <verse eid="MAT 15:10"/><verse number="11" style="v" sid="MAT 15:11"/>ಬಾಯೊಳಕ್ಕೆ ಹೋಗುವಂಥದ್ದು ಮನುಷ್ಯನನ್ನು ಅಶುದ್ಧ ಮಾಡುವುದಿಲ್ಲ, ಆದರೆ ಬಾಯೊಳಗಿಂದ ಹೊರಗೆ ಬರುವಂಥದ್ದೇ ಮನುಷ್ಯನನ್ನು ಅಶುದ್ಧ ಮಾಡುತ್ತದೆ,” ಎಂದು ಹೇಳಿದರು.<verse eid="MAT 15:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 15:12"/>ತರುವಾಯ ಯೇಸುವಿನ ಶಿಷ್ಯರು ಬಂದು, “ಫರಿಸಾಯರು ನಿಮ್ಮ ಈ ಮಾತನ್ನು ಕೇಳಿ ಬೇಸರಗೊಂಡರೆಂದು ನಿಮಗೆ ತಿಳಿಯಿತೇ?” ಎಂದು ಕೇಳಿದರು.<verse eid="MAT 15:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 15:13"/>ಅದಕ್ಕೆ ಯೇಸು ಉತ್ತರವಾಗಿ ಅವರಿಗೆ, “ಪರಲೋಕದ ನನ್ನ ತಂದೆಯು ನೆಡದೆ ಇರುವ ಪ್ರತಿಯೊಂದು ಗಿಡವು ಬೇರುಸಹಿತವಾಗಿ ಕಿತ್ತುಹಾಕಲಾಗುವುದು. <verse eid="MAT 15:13"/><verse number="14" style="v" sid="MAT 15:14"/>ಅವರನ್ನು ಬಿಡಿರಿ, ಅವರು ಕುರುಡರಿಗೆ ದಾರಿತೋರಿಸುವ ಕುರುಡರು. ಕುರುಡನು ಕುರುಡನಿಗೆ ದಾರಿತೋರಿಸಿದರೆ ಅವರಿಬ್ಬರೂ ಹಳ್ಳಕ್ಕೆ ಬೀಳುವರು,” ಎಂದು ಹೇಳಿದರು.<verse eid="MAT 15:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 15:15"/>ಪೇತ್ರನು, “ಈ ಸಾಮ್ಯವನ್ನು ನಮಗೆ ವಿವರಿಸು,” ಎಂದನು.<verse eid="MAT 15:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 15:16"/>ಅದಕ್ಕೆ ಯೇಸು, “ನೀವು ಸಹ ಇನ್ನೂ ಬುದ್ಧಿಯಿಲ್ಲದವರಾಗಿದ್ದೀರಾ?” ಎಂದು ಕೇಳಿ, <verse eid="MAT 15:16"/><verse number="17" style="v" sid="MAT 15:17"/>“ಬಾಯೊಳಕ್ಕೆ ಹೋಗಿ ಹೊಟ್ಟೆಯಲ್ಲಿ ಸೇರುವುದೆಲ್ಲವೂ ವಿಸರ್ಜಿತವಾಗುವುದೆಂದು ನೀವು ಇನ್ನೂ ಗ್ರಹಿಸಲಿಲ್ಲವೋ? <verse eid="MAT 15:17"/><verse number="18" style="v" sid="MAT 15:18"/>ಆದರೆ ಬಾಯೊಳಗಿಂದ ಹೊರಗೆ ಹೊರಡುವಂಥವು ಹೃದಯದೊಳಗಿಂದ ಬಂದು ಮನುಷ್ಯನನ್ನು ಅಶುದ್ಧ ಮಾಡುತ್ತವೆ. <verse eid="MAT 15:18"/><verse number="19" style="v" sid="MAT 15:19"/>ಏಕೆಂದರೆ ಹೃದಯದೊಳಗಿಂದ ದುರಾಲೋಚನೆಗಳು, ಕೊಲೆ, ವ್ಯಭಿಚಾರ, ಅನೈತಿಕತೆ, ಕಳ್ಳತನ, ಸುಳ್ಳುಸಾಕ್ಷಿ, ದೂರು ಇವು ಹೊರ ಬರುತ್ತವೆ. <verse eid="MAT 15:19"/><verse number="20" style="v" sid="MAT 15:20"/>ಇವುಗಳೇ ಮನುಷ್ಯನನ್ನು ಅಶುದ್ಧ ಮಾಡುತ್ತವೆ; ಆದರೆ ಕೈತೊಳೆದುಕೊಳ್ಳದೆ ಊಟಮಾಡುವುದು ಮನುಷ್ಯನನ್ನು ಅಶುದ್ಧ ಮಾಡುವುದಿಲ್ಲ,” ಎಂದರು.<verse eid="MAT 15:20"/></para>
  <para style="s1">ಕಾನಾನ್ಯ ಸ್ತ್ರೀಯ ನಂಬಿಕೆ</para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 15:21"/>ಯೇಸು ಅಲ್ಲಿಂದ ಹೊರಟು ಟೈರ್ ಸೀದೋನ್ ಪ್ರದೇಶಕ್ಕೆ ಬಂದರು. <verse eid="MAT 15:21"/><verse number="22" style="v" sid="MAT 15:22"/>ಆಗ, ಕಾನಾನ್ಯ ಸ್ತ್ರೀಯೊಬ್ಬಳು<note caller="+" style="f"><char style="fr" closed="false">15:22 </char><char style="ft" closed="false">ಯೆಹೂದ್ಯ ಅಲ್ಲದ ಸ್ತ್ರೀ</char></note> ಬಂದು ಅವರಿಗೆ, “ಸ್ವಾಮೀ, ದಾವೀದನ ಪುತ್ರನೇ, ನನ್ನನ್ನು ಕರುಣಿಸು. ನನ್ನ ಮಗಳು ದೆವ್ವದ ಕಾಟದಿಂದ ಬಹಳವಾಗಿ ಸಂಕಟಪಡುತ್ತಿದ್ದಾಳೆ,” ಎಂದು ಕೂಗಿಕೊಂಡಳು.<verse eid="MAT 15:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 15:23"/>ಆದರೆ ಯೇಸು ಆಕೆಗೆ ಉತ್ತರ ಕೊಡಲಿಲ್ಲ. ಆಗ ಶಿಷ್ಯರು ಯೇಸುವಿನ ಬಳಿ ಬಂದು, “ಆಕೆಯನ್ನು ಕಳುಹಿಸಿಬಿಡು, ಆಕೆಯು ನಮ್ಮ ಹಿಂದೆ ಕೂಗಿಕೊಂಡು ಬರುತ್ತಾಳೆ” ಎಂದು ಕೇಳಿಕೊಂಡರು.<verse eid="MAT 15:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 15:24"/>ಯೇಸು ಉತ್ತರವಾಗಿ, “ತಪ್ಪಿಸಿಕೊಂಡ ಕುರಿಗಳಂತಿರುವ ಇಸ್ರಾಯೇಲಿನ ಮನೆತನದವರ ಬಳಿಗೆ ಮಾತ್ರ ನನ್ನನ್ನು ಕಳುಹಿಸಲಾಗಿದೆ,” ಎಂದರು.<verse eid="MAT 15:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 15:25"/>ಆಕೆಯು ಬಂದು ಯೇಸುವಿನ ಮುಂದೆ ಮೊಣಕಾಲೂರಿ, “ಸ್ವಾಮೀ, ನನಗೆ ಸಹಾಯಮಾಡು!” ಎಂದು ಕೇಳಿಕೊಂಡಳು.<verse eid="MAT 15:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 15:26"/>ಆಗ ಯೇಸು, “ಮಕ್ಕಳು ತಿನ್ನುವ ರೊಟ್ಟಿಯನ್ನು ನಾಯಿಮರಿಗಳಿಗೆ ಹಾಕುವುದು ಸರಿಯಲ್ಲ,” ಎಂದು ಹೇಳಿದರು.<verse eid="MAT 15:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 15:27"/>ಆಗ ಆಕೆಯು, “ಸ್ವಾಮೀ, ಅದು ನಿಜವೇ, ಆದರೂ ತಮ್ಮ ಯಜಮಾನರ ಮೇಜಿನಿಂದ ಬೀಳುವ ರೊಟ್ಟಿತುಂಡುಗಳನ್ನು ನಾಯಿಮರಿಗಳು ತಿನ್ನುತ್ತವಲ್ಲಾ,” ಎಂದಳು.<verse eid="MAT 15:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 15:28"/>ಯೇಸು ಉತ್ತರವಾಗಿ ಆಕೆಗೆ, “ಅಮ್ಮಾ ನಿನ್ನ ನಂಬಿಕೆಯು ದೊಡ್ಡದು! ನೀನು ಇಷ್ಟಪಟ್ಟಂತೆಯೇ ನಿನಗಾಗಲಿ,” ಎಂದು ಹೇಳಿದರು. ಆಕೆಯ ಮಗಳು ಅದೇ ಗಳಿಗೆಯಲ್ಲಿ ಗುಣಹೊಂದಿದಳು.<verse eid="MAT 15:28"/></para>
  <para style="s1">ಯೇಸು ನಾಲ್ಕು ಸಾವಿರ ಜನರಿಗೆ ಊಟ ಕೊಟ್ಟಿದ್ದು</para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 15:29"/>ಯೇಸು ಅಲ್ಲಿಂದ ಹೊರಟು ಗಲಿಲಾಯ ಸರೋವರದ ಸಮೀಪಕ್ಕೆ ಬಂದು, ಬೆಟ್ಟವನ್ನು ಹತ್ತಿ ಅಲ್ಲಿ ಕುಳಿತುಕೊಂಡರು. <verse eid="MAT 15:29"/><verse number="30" style="v" sid="MAT 15:30"/>ಆಗ ಜನರ ದೊಡ್ಡ ಸಮೂಹಗಳು ಕುಂಟರನ್ನು, ಕುರುಡರನ್ನು, ಮೂಕರನ್ನು, ಊನವಾದವರನ್ನು ಮತ್ತು ಬೇರೆ ಅನೇಕ ರೋಗಿಗಳನ್ನು ತಮ್ಮೊಂದಿಗೆ ಕರೆದುಕೊಂಡು ಬಂದು ಯೇಸುವಿನ ಪಾದದ ಬಳಿಯಲ್ಲಿ ಬಿಟ್ಟರು. ಯೇಸು ಅವರನ್ನೆಲ್ಲಾ ಸ್ವಸ್ಥಪಡಿಸಿದರು. <verse eid="MAT 15:30"/><verse number="31" style="v" sid="MAT 15:31"/>ಮೂಕರು ಮಾತನಾಡುವುದನ್ನೂ ಊನವಾದವರು ಸ್ವಸ್ಥರಾಗಿರುವುದನ್ನೂ ಕುಂಟರು ನಡೆದಾಡುವುದನ್ನೂ ಕುರುಡರು ಕಾಣುವುದನ್ನೂ ಜನಸಮೂಹದವರು ಕಂಡು ಆಶ್ಚರ್ಯಪಟ್ಟರು. ಅವರು ಇಸ್ರಾಯೇಲಿನ ದೇವರನ್ನು ಕೊಂಡಾಡಿದರು.<verse eid="MAT 15:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 15:32"/>ಯೇಸು ತಮ್ಮ ಶಿಷ್ಯರನ್ನು ಕರೆದು, “ನಾನು ಈ ಜನಸಮೂಹವನ್ನು ನೋಡಿ ಕನಿಕರಪಡುತ್ತೇನೆ. ಮೂರು ದಿನಗಳಿಂದ ಇವರು ನನ್ನೊಂದಿಗಿದ್ದಾರೆ. ಇವರಿಗೆ ಊಟಕ್ಕೆ ಏನೂ ಇಲ್ಲ, ದಾರಿಯಲ್ಲಿ ಅವರು ಬಳಲಿ ಹೋಗುವರು. ಇವರನ್ನು ಉಪವಾಸವಾಗಿ ಕಳುಹಿಸುವುದಕ್ಕೆ ನನಗೆ ಮನಸ್ಸಿಲ್ಲ,” ಎಂದರು.<verse eid="MAT 15:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 15:33"/>ಅದಕ್ಕೆ ಶಿಷ್ಯರು, “ಇಂಥಾ ದೊಡ್ಡ ಸಮೂಹವನ್ನು ತೃಪ್ತಿಪಡಿಸುವಂತೆ ಈ ನಿರ್ಜನ ಪ್ರದೇಶದಲ್ಲಿ ನಮಗೆ ಎಲ್ಲಿಂದ ರೊಟ್ಟಿ ಸಿಕ್ಕೀತು?” ಎಂದರು.<verse eid="MAT 15:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 15:34"/>ಯೇಸು ಅವರಿಗೆ, “ನಿಮ್ಮ ಹತ್ತಿರ ಎಷ್ಟು ರೊಟ್ಟಿಗಳಿವೆ?” ಎಂದು ಕೇಳಿದರು.</para>
  <para style="p" vid="MAT 15:34">ಶಿಷ್ಯರು, “ಏಳು ರೊಟ್ಟಿಗಳು ಮತ್ತು ಕೆಲವು ಸಣ್ಣ ಮೀನುಗಳಿವೆ,” ಎಂದರು.<verse eid="MAT 15:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="MAT 15:35"/>ಯೇಸು ಜನಸಮೂಹವು ನೆಲದ ಮೇಲೆ ಕುಳಿತುಕೊಳ್ಳುವಂತೆ ಅಪ್ಪಣೆಕೊಟ್ಟರು. <verse eid="MAT 15:35"/><verse number="36" style="v" sid="MAT 15:36"/>ಅನಂತರ ಯೇಸು ಆ ಏಳು ರೊಟ್ಟಿಗಳನ್ನು ಮತ್ತು ಮೀನುಗಳನ್ನು ತೆಗೆದುಕೊಂಡು ದೇವರಿಗೆ ಸ್ತೋತ್ರಮಾಡಿ, ಅವುಗಳನ್ನು ಮುರಿದು ತಮ್ಮ ಶಿಷ್ಯರಿಗೆ ಕೊಡಲು ಶಿಷ್ಯರು ಜನಸಮೂಹಕ್ಕೆ ಕೊಟ್ಟರು. <verse eid="MAT 15:36"/><verse number="37" style="v" sid="MAT 15:37"/>ಅವರೆಲ್ಲರೂ ಊಟಮಾಡಿ ತೃಪ್ತರಾದರು. ಅನಂತರ ಶಿಷ್ಯರು ಮಿಕ್ಕ ತುಂಡುಗಳನ್ನು ಕೂಡಿಸಲಾಗಿ ಏಳು ಬುಟ್ಟಿಗಳು ತುಂಬಿದವು. <verse eid="MAT 15:37"/><verse number="38" style="v" sid="MAT 15:38"/>ಊಟಮಾಡಿದವರು ಸ್ತ್ರೀಯರೂ ಮಕ್ಕಳೂ ಅಲ್ಲದೆ ನಾಲ್ಕು ಸಾವಿರ ಗಂಡಸರಿದ್ದರು. <verse eid="MAT 15:38"/><verse number="39" style="v" sid="MAT 15:39"/>ತರುವಾಯ ಯೇಸು ಜನಸಮೂಹವನ್ನು ಕಳುಹಿಸಿಬಿಟ್ಟು ದೋಣಿಯನ್ನು ಹತ್ತಿ ಮಗದಾನ್ ಊರಿಗೆ ಬಂದರು.<verse eid="MAT 15:39"/></para>
  <chapter eid="MAT 15"/>
  <chapter number="16" style="c" sid="MAT 16"/>
  <para style="s1">ಸೂಚಕಕಾರ್ಯವನ್ನು ಕೇಳಿದ್ದು</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 16:1"/>ಸದ್ದುಕಾಯರೊಂದಿಗೆ ಫರಿಸಾಯರು ಸಹ ಬಂದು ಯೇಸುವನ್ನು ಪರೀಕ್ಷಿಸುವುದಕ್ಕಾಗಿ, ಪರಲೋಕದಿಂದ ತಮಗೆ ಒಂದು ಸೂಚಕಕಾರ್ಯವನ್ನು ತೋರಿಸಬೇಕೆಂದು ಕೇಳಿದರು.<verse eid="MAT 16:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="MAT 16:2"/>ಯೇಸು ಉತ್ತರವಾಗಿ ಅವರಿಗೆ, “ಸಂಜೆಯಾದಾಗ ಆಕಾಶವು ಕೆಂಪಾಗಿದ್ದರೆ, ‘ಒಳ್ಳೆಯ ಹವಾಮಾನ ಇರುವುದು’ ಎಂದೂ <verse eid="MAT 16:2"/><verse number="3" style="v" sid="MAT 16:3"/>ಬೆಳಿಗ್ಗೆ ಆಕಾಶವು ಮೋಡ ಕವಿದು ಕೆಂಪಾಗಿದ್ದರೆ, ‘ಇಂದು ಬಿರುಗಾಳಿ ಇರುವುದು’ ಎಂದೂ ನೀವು ಹೇಳುತ್ತೀರಿ. ಆಕಾಶದಲ್ಲಾಗುವ ಸೂಚನೆಗಳನ್ನು ನೀವು ಗ್ರಹಿಸಬಲ್ಲಿರಿ, ಆದರೆ ಕಾಲದ ಸೂಚನೆಗಳನ್ನು ನೀವು ಗ್ರಹಿಸಲಾರಿರಿ. <verse eid="MAT 16:3"/><verse number="4" style="v" sid="MAT 16:4"/>ವ್ಯಭಿಚಾರಿಯಾದ ಈ ಕೆಟ್ಟ ಸಂತತಿಯು ಸೂಚಕಕಾರ್ಯವನ್ನು ಹುಡುಕುತ್ತದೆ, ಆದರೆ ಪ್ರವಾದಿ ಯೋನನಲ್ಲಿ ಆದ ಸೂಚಕಕಾರ್ಯವೇ ಹೊರತು ಬೇರೆ ಯಾವ ಸೂಚಕಕಾರ್ಯವೂ ಇದಕ್ಕೆ ಸಿಕ್ಕುವುದಿಲ್ಲ,” ಎಂದು ಹೇಳಿ, ಯೇಸು ಅವರನ್ನು ಬಿಟ್ಟು ಹೊರಟು ಹೋದರು.<verse eid="MAT 16:4"/></para>
  <para style="s1">ಫರಿಸಾಯರ ಮತ್ತು ಸದ್ದುಕಾಯರ ಹುಳಿಯ ವಿಷಯ</para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 16:5"/>ಶಿಷ್ಯರು ರೊಟ್ಟಿಬುತ್ತಿಯನ್ನು ಕಟ್ಟಿಕೊಳ್ಳುವುದನ್ನು ಮರೆತು ಆಚೆದಡಕ್ಕೆ ಬಂದಿದ್ದರು. <verse eid="MAT 16:5"/><verse number="6" style="v" sid="MAT 16:6"/>ಆಗ ಯೇಸು ಅವರಿಗೆ, “ಫರಿಸಾಯರ ಮತ್ತು ಸದ್ದುಕಾಯರ ಹುಳಿಹಿಟ್ಟಿನ ಬಗ್ಗೆ ಎಚ್ಚರಿಕೆ ವಹಿಸಿ ಜಾಗರೂಕರಾಗಿರಿ,” ಎಂದು ಹೇಳಿದರು.<verse eid="MAT 16:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 16:7"/>ಅದಕ್ಕೆ ಅವರು ತಮ್ಮತಮ್ಮಲ್ಲಿಯೇ, “ನಾವು ರೊಟ್ಟಿ ತಂದಿಲ್ಲವೆಂದು ಹೀಗೆ ಹೇಳುತ್ತಾರೆ,” ಎಂದು ಮಾತನಾಡಿಕೊಂಡರು.<verse eid="MAT 16:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 16:8"/>ಯೇಸು ಅವರು ಮಾತನಾಡಿದ್ದನ್ನು ತಿಳಿದುಕೊಂಡು ಅವರಿಗೆ, “ಅಲ್ಪ ವಿಶ್ವಾಸದವರೇ, ನೀವು ರೊಟ್ಟಿ ಇಲ್ಲವೆಂದು ನಿಮ್ಮಲ್ಲಿ ಏಕೆ ಮಾತನಾಡಿಕೊಳ್ಳುತ್ತೀರಿ? <verse eid="MAT 16:8"/><verse number="9" style="v" sid="MAT 16:9"/>ಐದು ರೊಟ್ಟಿಗಳನ್ನು ಐದು ಸಾವಿರ ಜನರಿಗೆ ಹಂಚಿದಾಗ, ಎಷ್ಟು ಬುಟ್ಟಿಗಳನ್ನು ತುಂಬಿದಿರೆಂದು ನೀವು ಇನ್ನೂ ಗ್ರಹಿಸಲಿಲ್ಲವೇ? ನಿಮಗೆ ನೆನಪಿಲ್ಲವೇ? <verse eid="MAT 16:9"/><verse number="10" style="v" sid="MAT 16:10"/>ಇದಲ್ಲದೆ ಏಳು ರೊಟ್ಟಿಗಳನ್ನು ನಾಲ್ಕು ಸಾವಿರ ಜನರಿಗೆ ಹಂಚಿದಾಗ ಎಷ್ಟು ಬುಟ್ಟಿಗಳನ್ನು ತುಂಬಿದಿರಿ? <verse eid="MAT 16:10"/><verse number="11" style="v" sid="MAT 16:11"/>ನಾನು ರೊಟ್ಟಿಯ ವಿಷಯದಲ್ಲಿ ಅಲ್ಲ, ಫರಿಸಾಯರ ಮತ್ತು ಸದ್ದುಕಾಯರ ಹುಳಿಹಿಟ್ಟಿನ ವಿಷಯದಲ್ಲಿ ಎಚ್ಚರವಾಗಿರಬೇಕೆಂದು ಹೇಳಿದ್ದನ್ನು ನೀವು ಗ್ರಹಿಸದೆ ಇರುವುದು ಹೇಗೆ?” ಎಂದು ಕೇಳಿದರು. <verse eid="MAT 16:11"/><verse number="12" style="v" sid="MAT 16:12"/>ಆಗ ಅವರು, ರೊಟ್ಟಿ ಹುಳಿಯ ವಿಷಯದಲ್ಲಿ ಅಲ್ಲ, ಆದರೆ ಫರಿಸಾಯರ ಮತ್ತು ಸದ್ದುಕಾಯರ ಬೋಧನೆಯ ವಿಷಯದಲ್ಲಿ ತಾವು ಎಚ್ಚರವಾಗಿರಬೇಕೆಂದು ಯೇಸು ಹೇಳಿದ್ದನ್ನು ಗ್ರಹಿಸಿಕೊಂಡರು.<verse eid="MAT 16:12"/></para>
  <para style="s1">ಪೇತ್ರನ ಅರಿಕೆ</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 16:13"/>ಯೇಸು ಕೈಸರೈಯ ಫಿಲಿಪ್ಪಿ ಪ್ರಾಂತಗಳಿಗೆ ಬಂದಾಗ ತಮ್ಮ ಶಿಷ್ಯರಿಗೆ, “ಮನುಷ್ಯಪುತ್ರನಾದ ನನ್ನನ್ನು ಯಾರೆಂದು ಜನರು ಹೇಳುತ್ತಾರೆ?” ಎಂದು ಕೇಳಿದರು.<verse eid="MAT 16:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 16:14"/>ಅದಕ್ಕೆ ಅವರು, “ಕೆಲವರು ಸ್ನಾನಿಕನಾದ ಯೋಹಾನನು ಎಂದು ಹೇಳುತ್ತಾರೆ, ಇನ್ನು ಕೆಲವರು ಎಲೀಯನು ಎನ್ನುತ್ತಾರೆ, ಬೇರೆಯವರು ಯೆರೆಮೀಯನು, ಇಲ್ಲವೆ ಪ್ರವಾದಿಗಳಲ್ಲಿ ಒಬ್ಬನು ಎಂದು ಹೇಳುತ್ತಾರೆ” ಎಂದರು.<verse eid="MAT 16:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 16:15"/>ಯೇಸು ಅವರಿಗೆ, “ಆದರೆ ನೀವು ನನ್ನನ್ನು ಯಾರೆನ್ನುತ್ತೀರಿ?” ಎಂದು ಕೇಳಿದರು.<verse eid="MAT 16:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 16:16"/>ಅದಕ್ಕೆ ಸೀಮೋನ ಪೇತ್ರನು ಉತ್ತರವಾಗಿ, “ನೀವು ಕ್ರಿಸ್ತ ಮತ್ತು ಜೀವಂತ ದೇವರ ಪುತ್ರರಾಗಿದ್ದೀರಿ,” ಎಂದು ಉತ್ತರಕೊಟ್ಟನು.<verse eid="MAT 16:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 16:17"/>ಯೇಸು ಅವನಿಗೆ, “ಯೋನನ ಮಗ ಸೀಮೋನನೇ, ನೀನು ಧನ್ಯನು. ಏಕೆಂದರೆ ಇದನ್ನು ಪ್ರಕಟಿಸಿದ್ದು ಮಾನವರಲ್ಲ. ಪರಲೋಕದಲ್ಲಿರುವ ನನ್ನ ತಂದೆಯೇ ಇದನ್ನು ನಿನಗೆ ಪ್ರಕಟಿಸಿದರು. <verse eid="MAT 16:17"/><verse number="18" style="v" sid="MAT 16:18"/>ನಾನು ಸಹ ನಿನಗೆ ಹೇಳುವುದೇನಂದರೆ, ನೀನು ಪೇತ್ರನು.<note caller="+" style="f"><char style="fr" closed="false">16:18 </char><char style="fq" closed="false">ಪೇತ್ರ </char><char style="ft" closed="false">ಅಂದರೆ, </char><char style="fqa" closed="false">ಬಂಡೆ </char><char style="ft" closed="false">ಎಂದು ಅರ್ಥ</char></note> ಈ ಬಂಡೆಯ ಮೇಲೆ ನಾನು ನನ್ನ ಸಭೆಯನ್ನು ಕಟ್ಟುವೆನು. ಪಾತಾಳದ ದ್ವಾರಗಳು ಅದನ್ನು ಜಯಿಸಲಾರವು. <verse eid="MAT 16:18"/><verse number="19" style="v" sid="MAT 16:19"/>ನಾನು ನಿನಗೆ ಪರಲೋಕ ರಾಜ್ಯದ ಬೀಗದ ಕೈಗಳನ್ನು ಕೊಡುವೆನು; ನೀನು ಭೂಮಿಯಲ್ಲಿ ಯಾವುದನ್ನು ಬಂಧಿಸುತ್ತೀಯೋ ಅದು ಪರಲೋಕದಲ್ಲಿಯೂ ಬಂಧಿತವಾಗುವುದು. ನೀನು ಭೂಮಿಯಲ್ಲಿ ಏನನ್ನು ಬಿಚ್ಚುತ್ತೀಯೋ ಅದು ಪರಲೋಕದಲ್ಲಿಯೂ ಬಿಚ್ಚಲಾಗುವುದು,” ಎಂದರು. <verse eid="MAT 16:19"/><verse number="20" style="v" sid="MAT 16:20"/>ತರುವಾಯ ಯೇಸು, ತಾನೇ ಕ್ರಿಸ್ತ ಎಂಬುದನ್ನು ಯಾರಿಗೂ ಹೇಳಬಾರದೆಂದು ತಮ್ಮ ಶಿಷ್ಯರಿಗೆ ಆಜ್ಞಾಪಿಸಿದರು.<verse eid="MAT 16:20"/></para>
  <para style="s1">ಯೇಸು ತಮ್ಮ ಮರಣವನ್ನು ಮುಂತಿಳಿಸಿದ್ದು</para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 16:21"/>ತಾವು ಯೆರೂಸಲೇಮಿಗೆ ಹೋಗಿ ಹೇಗೆ ಹಿರಿಯರಿಂದಲೂ ಮುಖ್ಯಯಾಜಕರಿಂದಲೂ ನಿಯಮ ಬೋಧಕರಿಂದಲೂ ಬಹು ಕಷ್ಟಗಳನ್ನು ಅನುಭವಿಸಿ ಕೊಲೆಗೀಡಾಗಿ ಮೂರನೆಯ ದಿನದಲ್ಲಿ ಜೀವಂತವಾಗಿ ಎದ್ದು ಬರುವುದು ಅವಶ್ಯವಾಗಿದೆ ಎಂದು ಯೇಸು ಅಂದಿನಿಂದ ತಮ್ಮ ಶಿಷ್ಯರಿಗೆ ತಿಳಿಸಲಾರಂಭಿಸಿದರು.<verse eid="MAT 16:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 16:22"/>ಆಗ ಪೇತ್ರನು ಯೇಸುವಿನ ಕೈಹಿಡಿದು, “ಹಾಗೆ ಆಗಬಾರದು ಸ್ವಾಮೀ! ಅದು ನಿಮಗೆ ಎಂದಿಗೂ ಸಂಭವಿಸಬಾರದು!” ಎಂದು ಹೇಳಿ ಯೇಸುವನ್ನು ಗದರಿಸಲಾರಂಭಿಸಿದನು.<verse eid="MAT 16:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 16:23"/>ಆಗ ಯೇಸು ತಿರುಗಿಕೊಂಡು ಪೇತ್ರನಿಗೆ, “ಸೈತಾನನೇ, ನನ್ನಿಂದ ತೊಲಗಿಹೋಗು! ನೀನು ನನಗೆ ಅಡ್ಡಿಯಾಗಿದ್ದೀ; ನಿನ್ನ ಆಲೋಚನೆ ಮನುಷ್ಯರದೇ ಹೊರತು ದೇವರದಲ್ಲ,” ಎಂದರು.<verse eid="MAT 16:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 16:24"/>ತರುವಾಯ ಯೇಸು ತಮ್ಮ ಶಿಷ್ಯರಿಗೆ, “ಯಾರಾದರೂ ನನ್ನ ಶಿಷ್ಯರಾಗುವುದಕ್ಕೆ ಬಯಸಿದರೆ, ಅವರು ತಮ್ಮನ್ನು ತಾವೇ ನಿರಾಕರಿಸಿ ತಮ್ಮ ಶಿಲುಬೆಯನ್ನು ಹೊತ್ತುಕೊಂಡು ನನ್ನನ್ನು ಹಿಂಬಾಲಿಸಲಿ. <verse eid="MAT 16:24"/><verse number="25" style="v" sid="MAT 16:25"/>ತಮ್ಮ ಪ್ರಾಣವನ್ನು ಉಳಿಸಿಕೊಳ್ಳುವವರು ಅದನ್ನು ಕಳೆದುಕೊಳ್ಳುವರು, ಆದರೆ ನನ್ನ ನಿಮಿತ್ತವಾಗಿ ಯಾರಾದರೂ ತಮ್ಮ ಪ್ರಾಣವನ್ನು ಕಳೆದುಕೊಳ್ಳುವವರು ಅದನ್ನು ಕಂಡುಕೊಳ್ಳುವರು. <verse eid="MAT 16:25"/><verse number="26" style="v" sid="MAT 16:26"/>ಒಬ್ಬ ವ್ಯಕ್ತಿ ಲೋಕವನ್ನೆಲ್ಲಾ ಸಂಪಾದಿಸಿಕೊಂಡರೂ ತಮ್ಮ ಸ್ವಂತ ಆತ್ಮವನ್ನೇ ನಷ್ಟಪಡಿಸಿಕೊಂಡರೆ ಅವರಿಗೆ ಲಾಭವೇನು? ಇಲ್ಲವೆ ತಮ್ಮ ಆತ್ಮಕ್ಕೆ ಬದಲಾಗಿ ಏನು ಕೊಡುವರು? <verse eid="MAT 16:26"/><verse number="27" style="v" sid="MAT 16:27"/>ಮನುಷ್ಯಪುತ್ರನಾದ ನಾನು ನನ್ನ ತಂದೆಯ ಮಹಿಮೆಯಲ್ಲಿ ನನ್ನ ದೂತರೊಡನೆ ಬಂದಾಗ, ನಾನು ಪ್ರತಿಯೊಬ್ಬರಿಗೂ ಅವರವರ ಕೆಲಸಗಳಿಗೆ ತಕ್ಕಂತೆ ಪ್ರತಿಫಲವನ್ನು ಕೊಡುವೆನು.<verse eid="MAT 16:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 16:28"/>“ನಿಮಗೆ ನಿಜವಾಗಿ ಹೇಳುತ್ತೇನೆ: ಇಲ್ಲಿ ನಿಂತವರಲ್ಲಿ ಕೆಲವರು ಮನುಷ್ಯಪುತ್ರನಾದ ನಾನು ನನ್ನ ರಾಜ್ಯದಲ್ಲಿ ಬರುವುದನ್ನು ಕಾಣುವವರೆಗೆ ಮರಣವನ್ನು ಹೊಂದುವುದೇ ಇಲ್ಲ,” ಎಂದರು.<verse eid="MAT 16:28"/></para>
  <chapter eid="MAT 16"/>
  <chapter number="17" style="c" sid="MAT 17"/>
  <para style="s1">ಯೇಸು ರೂಪಾಂತರ ಹೊಂದಿದ್ದು</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 17:1"/>ಯೇಸು ಆರು ದಿನಗಳಾದ ಮೇಲೆ ಪೇತ್ರ, ಯಾಕೋಬ, ಅವನ ಸಹೋದರ ಯೋಹಾನನನ್ನೂ ಪ್ರತ್ಯೇಕವಾಗಿ ಕರೆದುಕೊಂಡು ಎತ್ತರವಾದ ಒಂದು ಬೆಟ್ಟಕ್ಕೆ ಹೋದರು. <verse eid="MAT 17:1"/><verse number="2" style="v" sid="MAT 17:2"/>ಅಲ್ಲಿ ಯೇಸು ಅವರ ಮುಂದೆ ರೂಪಾಂತರಗೊಂಡರು. ಅವರ ಮುಖವು ಸೂರ್ಯನಂತೆ ಪ್ರಕಾಶಿಸಿತು. ಅವರ ಉಡುಪು ಬೆಳಕಿನಂತೆ ಬೆಳಗಿತು. <verse eid="MAT 17:2"/><verse number="3" style="v" sid="MAT 17:3"/>ಇದಲ್ಲದೆ ಮೋಶೆಯೂ ಎಲೀಯನೂ ಅವರಿಗೆ ಕಾಣಿಸಿಕೊಂಡು ಯೇಸುವಿನೊಂದಿಗೆ ಮಾತನಾಡುತ್ತಿದ್ದರು.<verse eid="MAT 17:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 17:4"/>ಪೇತ್ರನು ಯೇಸುವಿಗೆ, “ಕರ್ತನೇ, ನಾವು ಇಲ್ಲಿಯೇ ಇರುವುದು ಒಳ್ಳೆಯದು. ನಿಮಗೆ ಮನಸ್ಸಿದ್ದರೆ ನಾನು ನಿಮಗೊಂದು, ಮೋಶೆಗೊಂದು, ಎಲೀಯನಿಗೊಂದರಂತೆ ಮೂರು ಗುಡಾರಗಳನ್ನು ಕಟ್ಟುವೆನು,” ಎಂದು ಹೇಳಿದನು.<verse eid="MAT 17:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 17:5"/>ಪೇತ್ರನು ಇನ್ನೂ ಮಾತನಾಡುತ್ತಿರುವಾಗಲೇ, ಪ್ರಕಾಶಮಾನವಾದ ಮೇಘವು ಅವರ ಮೇಲೆ ಕವಿಯಿತು. ಆಗ, “ಈತನು ಪ್ರಿಯನಾಗಿರುವ ನನ್ನ ಮಗನು. ಈತನನ್ನು ನಾನು ಸಂಪೂರ್ಣವಾಗಿ ಮೆಚ್ಚಿದ್ದೇನೆ. ಈತನ ಮಾತನ್ನು ನೀವು ಕೇಳಿರಿ,” ಎಂದು ಮೇಘದೊಳಗಿಂದ ಒಂದು ಧ್ವನಿ ಕೇಳಿತು.<verse eid="MAT 17:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 17:6"/>ಶಿಷ್ಯರು ಇದನ್ನು ಕೇಳಿ ಬಹಳವಾಗಿ ಹೆದರಿ ಬೋರಲು ಬಿದ್ದರು. <verse eid="MAT 17:6"/><verse number="7" style="v" sid="MAT 17:7"/>ಆಗ ಯೇಸು ಬಂದು ಅವರನ್ನು ಮುಟ್ಟಿ, “ಏಳಿರಿ, ಹೆದರಬೇಡಿರಿ,” ಎಂದು ಹೇಳಿದರು. <verse eid="MAT 17:7"/><verse number="8" style="v" sid="MAT 17:8"/>ಅವರು ತಮ್ಮ ಕಣ್ಣೆತ್ತಿ ನೋಡಿದಾಗ ಯೇಸುವನ್ನೇ ಹೊರತು ಮತ್ತಾರನ್ನೂ ಕಾಣಲಿಲ್ಲ.<verse eid="MAT 17:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 17:9"/>ಅವರು ಬೆಟ್ಟದಿಂದ ಇಳಿದು ಬರುತ್ತಿದ್ದಾಗ, ಯೇಸು ಅವರಿಗೆ, “ಮನುಷ್ಯಪುತ್ರನಾದ ನಾನು ಸತ್ತವರೊಳಗಿಂದ ಎದ್ದು ಬರುವವರೆಗೆ ಈ ದರ್ಶನವನ್ನು ಯಾರಿಗೂ ಹೇಳಬಾರದು,” ಎಂದು ಅವರಿಗೆ ಆಜ್ಞಾಪಿಸಿದರು.<verse eid="MAT 17:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 17:10"/>ಆಗ ಯೇಸುವಿನ ಶಿಷ್ಯರು ಅವರಿಗೆ, “ಎಲೀಯನು ಮೊದಲು ಬರುವುದು ಅಗತ್ಯವೆಂದು ನಿಯಮ ಬೋಧಕರು ಏಕೆ ಹೇಳುತ್ತಾರೆ?” ಎಂದು ಕೇಳಿದರು.<verse eid="MAT 17:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 17:11"/>ಯೇಸು ಉತ್ತರವಾಗಿ ಅವರಿಗೆ, “ಎಲೀಯನು ಮೊದಲು ಬಂದು ಎಲ್ಲವುಗಳನ್ನು ಪುನಃ ಸ್ಥಾಪಿಸುವುದು ನಿಜವೇ. <verse eid="MAT 17:11"/><verse number="12" style="v" sid="MAT 17:12"/>ಆದರೆ ಎಲೀಯನು ಆಗಲೇ ಬಂದಾಯಿತು; ಅವರು ಅವನನ್ನು ಅರಿಯದೆ ತಮಗೆ ಇಷ್ಟಬಂದಂತೆ ಅವನಿಗೆ ಮಾಡಿದ್ದಾಯಿತು. ಅದರಂತೆಯೇ ಮನುಷ್ಯಪುತ್ರನಾದ ನಾನು ಸಹ ಅವರಿಂದ ಕಷ್ಟವನ್ನು ಅನುಭವಿಸುವೆನು ಎಂದು ನಾನು ನಿಮಗೆ ಹೇಳುತ್ತೇನೆ,” ಎಂದರು. <verse eid="MAT 17:12"/><verse number="13" style="v" sid="MAT 17:13"/>ಸ್ನಾನಿಕ ಯೋಹಾನನ ವಿಷಯದಲ್ಲಿ ಯೇಸು ತಮ್ಮೊಂದಿಗೆ ಮಾತನಾಡಿದನೆಂದು ಶಿಷ್ಯರು ಆಗ ಗ್ರಹಿಸಿಕೊಂಡರು.<verse eid="MAT 17:13"/></para>
  <para style="s1">ಮೂರ್ಛಾರೋಗಿಯಾದ ಹುಡುಗನ ಸ್ವಸ್ಥತೆ</para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 17:14"/>ಅವರು ಜನಸಮೂಹದ ಬಳಿಗೆ ಬಂದಾಗ, ಒಬ್ಬ ಮನುಷ್ಯನು ಯೇಸುವಿನ ಬಳಿಗೆ ಬಂದು ಮೊಣಕಾಲೂರಿ, <verse eid="MAT 17:14"/><verse number="15" style="v" sid="MAT 17:15"/>“ಕರ್ತನೇ, ನನ್ನ ಮಗನ ಮೇಲೆ ಕರುಣೆಯಿಡು. ಏಕೆಂದರೆ ಅವನು ಮೂರ್ಛಾರೋಗದಿಂದ ಬಹಳವಾಗಿ ಕಷ್ಟಪಡುತ್ತಾನೆ. ಅನೇಕ ಸಾರಿ ಬೆಂಕಿಯಲ್ಲಿಯೂ ನೀರಿನಲ್ಲಿಯೂ ಬೀಳುತ್ತಾನೆ. <verse eid="MAT 17:15"/><verse number="16" style="v" sid="MAT 17:16"/>ನಾನು ಅವನನ್ನು ನಿಮ್ಮ ಶಿಷ್ಯರ ಬಳಿಗೆ ಕರೆತಂದೆನು. ಆದರೆ ಅವರು ಅವನನ್ನು ಸ್ವಸ್ಥ ಮಾಡದೆ ಹೋದರು,” ಎಂದು ಹೇಳಿದನು.<verse eid="MAT 17:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 17:17"/>ಆಗ ಯೇಸು, “ವಿಶ್ವಾಸವಿಲ್ಲದ ಮೂರ್ಖ ಸಂತತಿಯೇ, ಇನ್ನೂ ಎಷ್ಟು ಕಾಲ ನಾನು ನಿಮ್ಮೊಂದಿಗಿರಲಿ? ಎಷ್ಟು ಕಾಲ ನಾನು ನಿಮ್ಮನ್ನು ಸಹಿಸಲಿ? ಅವನನ್ನು ನನ್ನ ಬಳಿಗೆ ಕರೆದುಕೊಂಡು ಬನ್ನಿರಿ,” ಎಂದು ಹೇಳಿದರು. <verse eid="MAT 17:17"/><verse number="18" style="v" sid="MAT 17:18"/>ಆಗ ಯೇಸು ದೆವ್ವವನ್ನು ಗದರಿಸಲಾಗಿ ಅದು ಹುಡುಗನೊಳಗಿಂದ ಹೊರಟುಹೋಯಿತು. ಆಗ ಆ ಹುಡುಗನು ಅದೇ ಗಳಿಗೆಯಲ್ಲಿಯೇ ಗುಣಮುಖನಾದನು.<verse eid="MAT 17:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 17:19"/>ತರುವಾಯ ಶಿಷ್ಯರು ಪ್ರತ್ಯೇಕವಾಗಿ ಯೇಸುವಿನ ಬಳಿಗೆ ಬಂದು, “ಅದನ್ನು ಓಡಿಸುವುದಕ್ಕೆ ನಮ್ಮಿಂದ ಏಕೆ ಆಗಲಿಲ್ಲ?” ಎಂದು ಕೇಳಿದರು.<verse eid="MAT 17:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 17:20"/>ಯೇಸು ಅವರಿಗೆ, “ನಿಮ್ಮ ಅಪೂರ್ಣನಂಬಿಕೆಯೇ ಇದಕ್ಕೆ ಕಾರಣ. ಸಾಸಿವೆ ಕಾಳಿನಷ್ಟು ನಂಬಿಕೆ ನಿಮಗಿರುವುದಾದರೆ ನೀವು ಈ ಬೆಟ್ಟಕ್ಕೆ, ‘ಇಲ್ಲಿಂದ ಆ ಸ್ಥಳಕ್ಕೆ ಹೋಗು’ ಎಂದು ಹೇಳಿದರೆ ಅದು ಹೋಗುವುದು. ಯಾವುದೂ ನಿಮಗೆ ಅಸಾಧ್ಯವಾಗಿರುವುದಿಲ್ಲ. <verse eid="MAT 17:20"/><verse number="21" style="v" sid="MAT 17:21"/><char style="it">ಆದರೂ ದೇವರ ಪ್ರಾರ್ಥನೆ ಉಪವಾಸಗಳಿಂದ ಹೊರತು ಬೇರೆ ಯಾವುದರಿಂದಲೂ ಈ ರೀತಿಯಾದ ದೆವ್ವ ಹೊರಟು ಹೋಗುವುದಿಲ್ಲ,” ಎಂದರು.</char><note caller="+" style="f"><char style="fr" closed="false">17:21 </char><char style="ft" closed="false">ಕೆಲವು ಹಸ್ತಪ್ರತಿಗಳಲ್ಲಿ ಈ ವಾಕ್ಯ ಸೇರ್ಪಡೆಯಾಗಿರುವುದಿಲ್ಲ.</char></note><verse eid="MAT 17:21"/></para>
  <para style="s1">ಯೇಸು ತಮ್ಮ ಮರಣವನ್ನು ಎರಡನೆಯ ಬಾರಿ ಮುಂತಿಳಿಸಿದ್ದು</para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 17:22"/>ಅವರು ಗಲಿಲಾಯದಲ್ಲಿ ಒಟ್ಟಿಗೆ ಸೇರಿದ್ದಾಗ ಯೇಸು ಅವರಿಗೆ, “ಮನುಷ್ಯಪುತ್ರನಾದ ನನ್ನನ್ನು ಜನರ ಕೈಗಳಿಗೆ ಒಪ್ಪಿಸಿಕೊಡಲಾಗುವುದು. <verse eid="MAT 17:22"/><verse number="23" style="v" sid="MAT 17:23"/>ಅವರು ನನ್ನನ್ನು ಕೊಲ್ಲುವರು, ಆದರೆ ಮೂರನೆಯ ದಿನದಲ್ಲಿ ನಾನು ತಿರುಗಿ ಜೀವಿತನಾಗಿ ಎದ್ದು ಬರುವೆನು,” ಎಂದು ಹೇಳಿದರು. ಅದಕ್ಕೆ ಶಿಷ್ಯರು ಬಹಳ ದುಃಖಪಟ್ಟರು.<verse eid="MAT 17:23"/></para>
  <para style="s1">ಯೇಸು ದೇವಾಲಯದ ತೆರಿಗೆ ಕೊಟ್ಟದ್ದು</para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 17:24"/>ತರುವಾಯ ಯೇಸು ಕಪೆರ್ನೌಮಿಗೆ ಬಂದಾಗ, ದೇವಾಲಯದ ತೆರಿಗೆಗಾಗಿ ಎರಡು ಬೆಳ್ಳಿ ನಾಣ್ಯಗಳನ್ನು<note caller="+" style="f"><char style="fr" closed="false">17:24 </char><char style="ft" closed="false">ಮೂಲಭಾಷೆಯಲ್ಲಿ ದ್ರಹ್ಮ. ಒಂದು ದ್ರಹ್ಮ ನಾಣ್ಯದ ಮೌಲ್ಯವು, ಒಂದು ದಿನದ ಕೂಲಿ</char></note> ವಸೂಲಿಮಾಡುವವರು ಪೇತ್ರನ ಬಳಿಗೆ ಬಂದರು. ಅವರು ಪೇತ್ರನಿಗೆ, “ನಿಮ್ಮ ಬೋಧಕನು ತೆರಿಗೆ ಕಟ್ಟುವುದಿಲ್ಲವೋ?” ಎಂದು ಕೇಳಿದರು.<verse eid="MAT 17:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 17:25"/>ಅದಕ್ಕೆ ಪೇತ್ರನು, “ಹೌದು, ಕಟ್ಟುತ್ತಾರೆ,” ಎಂದನು.</para>
  <para style="p" vid="MAT 17:25">ಅವನು ಮನೆಯೊಳಕ್ಕೆ ಬಂದಾಗ ಯೇಸು ಮುಂದಾಗಿಯೇ ಅವನಿಗೆ, “ಸೀಮೋನನೇ ನಿನಗೆ ಹೇಗೆ ತೋರುತ್ತದೆ? ಭೂಲೋಕದ ರಾಜರು ಯಾರಿಂದ ಕಂದಾಯವನ್ನು ಇಲ್ಲವೆ ತೆರಿಗೆಯನ್ನು ವಸೂಲಿ ಮಾಡುತ್ತಾರೆ? ತಮ್ಮ ಪುತ್ರರಿಂದಲೋ ಇಲ್ಲವೆ ಪರರಿಂದಲೋ?” ಎಂದು ಕೇಳಿದರು.<verse eid="MAT 17:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 17:26"/>“ಪರರಿಂದ,” ಎಂದು ಪೇತ್ರನು ಹೇಳಿದನು.</para>
  <para style="p" vid="MAT 17:26">ಯೇಸು ಅವನಿಗೆ, “ಹಾಗಾದರೆ ಪುತ್ರನು ಕಟ್ಟಬೇಕಾಗಿಲ್ಲ. <verse eid="MAT 17:26"/><verse number="27" style="v" sid="MAT 17:27"/>ಆದರೂ ನಾವು ಅವರನ್ನು ಅಭ್ಯಂತರಪಡಿಸದಂತೆ, ನೀನು ಸರೋವರಕ್ಕೆ ಹೋಗಿ ಗಾಳವನ್ನು ಹಾಕು. ಆಗ ಮೊದಲು ಬರುವ ಮೀನನ್ನು ಹಿಡಿ. ನೀನು ಅದರ ಬಾಯನ್ನು ತೆರೆದಾಗ ಅದರಲ್ಲಿ ನಾಲ್ಕು ಬೆಳ್ಳಿ ನಾಣ್ಯಗಳನ್ನು ಕಾಣುವೆ. ಅದನ್ನು ತಂದು ನನ್ನ ಮತ್ತು ನಿನ್ನ ಪರವಾಗಿ ಅವರಿಗೆ ಕೊಡು,” ಎಂದು ಹೇಳಿದರು.<verse eid="MAT 17:27"/></para>
  <chapter eid="MAT 17"/>
  <chapter number="18" style="c" sid="MAT 18"/>
  <para style="s1">ಪರಲೋಕದಲ್ಲಿ ದೊಡ್ಡವನು</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 18:1"/>ಅದೇ ಸಮಯದಲ್ಲಿ ಶಿಷ್ಯರು ಯೇಸುವಿನ ಬಳಿಗೆ ಬಂದು, “ಪರಲೋಕ ರಾಜ್ಯದಲ್ಲಿ ಅತಿ ದೊಡ್ಡವನು ಯಾರು?” ಎಂದು ಕೇಳಿದರು.<verse eid="MAT 18:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="MAT 18:2"/>ಆಗ ಯೇಸು ಒಂದು ಚಿಕ್ಕ ಮಗುವನ್ನು ತಮ್ಮ ಬಳಿಗೆ ಕರೆದು, ಅದನ್ನು ಅವರ ಮಧ್ಯದಲ್ಲಿ ನಿಲ್ಲಿಸಿ, <verse eid="MAT 18:2"/><verse number="3" style="v" sid="MAT 18:3"/>“ನೀವು ಪರಿವರ್ತನೆ ಹೊಂದಿ ಚಿಕ್ಕಮಕ್ಕಳಂತೆ ಆಗದಿದ್ದರೆ, ಪರಲೋಕ ರಾಜ್ಯದೊಳಗೆ ಪ್ರವೇಶಿಸುವುದಿಲ್ಲವೆಂದು ನಾನು ನಿಮಗೆ ನಿಜವಾಗಿ ಹೇಳುತ್ತೇನೆ. <verse eid="MAT 18:3"/><verse number="4" style="v" sid="MAT 18:4"/>ಯಾರು ಈ ಚಿಕ್ಕಮಗುವಿನಂತೆ ತಮ್ಮನ್ನು ತಾವು ತಗ್ಗಿಸಿಕೊಳ್ಳುವರೋ ಅವರೇ ಪರಲೋಕ ರಾಜ್ಯದಲ್ಲಿ ಅತಿ ದೊಡ್ಡವರಾಗಿರುವರು. <verse eid="MAT 18:4"/><verse number="5" style="v" sid="MAT 18:5"/>ಯಾರಾದರೂ ಇಂಥ ಚಿಕ್ಕ ಮಗುವನ್ನು ನನ್ನ ಹೆಸರಿನಲ್ಲಿ ಸ್ವೀಕರಿಸಿಕೊಂಡರೆ ನನ್ನನ್ನೇ ಸ್ವೀಕರಿಸಿಕೊಳ್ಳುತ್ತಾರೆ.<verse eid="MAT 18:5"/></para>
  <para style="s1">ಪಾಪಕ್ಕೆ ಕಾರಣವಾಗಿರುವುದು</para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 18:6"/>“ಆದರೆ ನನ್ನಲ್ಲಿ ನಂಬಿಕೆಯಿಡುವ ಈ ಚಿಕ್ಕವರಲ್ಲಿ ಒಬ್ಬರಿಗೆ ಯಾರಾದರೂ ಪಾಪಕ್ಕೆ ಕಾರಣರಾದರೆ, ಅಂಥವರ ಕೊರಳಿಗೆ ಬೀಸುವ ಕಲ್ಲನ್ನು ನೇತುಹಾಕಿ ಅವರನ್ನು ಸಮುದ್ರದ ಆಳದಲ್ಲಿ ಮುಳುಗಿಸಿಡುವುದೇ ಲೇಸು, ಎಂದರು. <verse eid="MAT 18:6"/><verse number="7" style="v" sid="MAT 18:7"/>ಪಾಪಕ್ಕೆ ಕಾರಣವಾಗಿರುವ ಜಗತ್ತಿಗೆ ಕಷ್ಟ! ಇಂಥ ವಿಷಯಗಳು ಅನಿವಾರ್ಯ. ಆದರೆ ಪಾಪಕ್ಕೆ ಕಾರಣವಾಗಿರುವವರ ಗತಿಯನ್ನು ಏನೆಂದು ಹೇಳಲಿ! <verse eid="MAT 18:7"/><verse number="8" style="v" sid="MAT 18:8"/>ನಿಮ್ಮ ಕೈಯಾಗಲೀ ಕಾಲಾಗಲೀ ನಿಮ್ಮನ್ನು ಪಾಪಕ್ಕೆ ಕಾರಣವಾದರೆ ಅದನ್ನು ಕಡಿದುಹಾಕಿರಿ. ಎರಡು ಕೈಯುಳ್ಳವರಾಗಿ ಇಲ್ಲವೆ ಎರಡು ಕಾಲುಳ್ಳವರಾಗಿ ನಿತ್ಯ ಬೆಂಕಿಯಲ್ಲಿ ಹಾಕಿಸಿಕೊಳ್ಳುವುದಕ್ಕಿಂತ ಕುಂಟರಾಗಿ ಇಲ್ಲವೆ ಊನರಾಗಿ ಜೀವದಲ್ಲಿ ಪ್ರವೇಶಿಸುವುದು ನಿಮಗೆ ಲೇಸು. <verse eid="MAT 18:8"/><verse number="9" style="v" sid="MAT 18:9"/>ನಿಮ್ಮ ಕಣ್ಣು ನಿಮ್ಮ ಪಾಪಕ್ಕೆ ಕಾರಣವಾದರೆ ಅದನ್ನು ಕಿತ್ತುಬಿಡಿರಿ. ನೀವು ಎರಡು ಕಣ್ಣುಳ್ಳವರಾಗಿ ನರಕದ ಬೆಂಕಿಯಲ್ಲಿ ಹಾಕಿಸಿಕೊಳ್ಳುವುದಕ್ಕಿಂತ ಒಂದು ಕಣ್ಣುಳ್ಳವರಾಗಿ ಜೀವದಲ್ಲಿ ಪ್ರವೇಶಿಸುವುದು ನಿಮಗೆ ಲೇಸು.<verse eid="MAT 18:9"/></para>
  <para style="s1">ಕಳೆದುಹೋದ ಕುರಿಯ ಸಾಮ್ಯ</para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 18:10"/>“ಚಿಕ್ಕವರಲ್ಲಿ ಒಬ್ಬನನ್ನಾದರೂ ನೀವು ಹೀನೈಸದಂತೆ ನೋಡಿಕೊಳ್ಳಿರಿ. ಪರಲೋಕದಲ್ಲಿರುವ ಅವರ ದೂತರು ಪರಲೋಕದ ನನ್ನ ತಂದೆಯ ಮುಖವನ್ನು ಯಾವಾಗಲೂ ನೋಡುತ್ತಿದ್ದಾರೆ. <verse eid="MAT 18:10"/><verse number="11" style="v" sid="MAT 18:11"/><char style="it">ತಪ್ಪಿಹೋದದ್ದನ್ನು ಹುಡುಕಿ ರಕ್ಷಿಸುವುದಕ್ಕಲ್ಲವೇ ಮನುಷ್ಯಪುತ್ರನಾದ ನಾನು ಬಂದೆನು,” ಎಂದು ಹೇಳಿದರು.</char><note caller="+" style="f"><char style="fr" closed="false">18:11 </char><char style="ft" closed="false">ಕೆಲವು ಹಸ್ತಪ್ರತಿಗಳಲ್ಲಿ ಈ ವಾಕ್ಯ ಸೇರ್ಪಡೆಯಾಗಿರುವುದಿಲ್ಲ.</char></note><verse eid="MAT 18:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 18:12"/>“ಆಗ ನಿಮಗೆ ಏನು ಅನಿಸುತ್ತದೆ? ಒಬ್ಬ ಮನುಷ್ಯನಿಗೆ ನೂರು ಕುರಿಗಳಿರಲಾಗಿ, ಅವುಗಳಲ್ಲಿ ಒಂದು ತಪ್ಪಿಸಿಕೊಂಡುಹೋದರೆ, ಅವನು ತೊಂಬತ್ತೊಂಬತ್ತು ಕುರಿಗಳನ್ನು ಬಿಟ್ಟು ಬೆಟ್ಟಗಳಿಗೆ ಹೋಗಿ, ತಪ್ಪಿಸಿಕೊಂಡದ್ದನ್ನು ಹುಡುಕುವುದಿಲ್ಲವೇ? <verse eid="MAT 18:12"/><verse number="13" style="v" sid="MAT 18:13"/>ಅವನು ಅದನ್ನು ಕಂಡರೆ, ತಪ್ಪಿಸಿಕೊಳ್ಳದ ತೊಂಬತ್ತೊಂಬತ್ತು ಕುರಿಗಳಿಗಿಂತ ಈ ಒಂದು ಕುರಿಯ ವಿಷಯದಲ್ಲಿ ಹೆಚ್ಚು ಸಂತೋಷ ಪಡುತ್ತಾನೆಂದು ನಿಮಗೆ ನಿಜವಾಗಿ ಹೇಳುತ್ತೇನೆ. <verse eid="MAT 18:13"/><verse number="14" style="v" sid="MAT 18:14"/>ಅದರಂತೆಯೇ ಈ ಚಿಕ್ಕವರಲ್ಲಿ ಒಬ್ಬರಾದರೂ ನಾಶವಾಗುವುದು ಪರಲೋಕದಲ್ಲಿರುವ ನಿಮ್ಮ ತಂದೆಯ ಚಿತ್ತವಲ್ಲ.<verse eid="MAT 18:14"/></para>
  <para style="s1">ಸಹೋದರನು ನಿಮಗೆ ವಿರುದ್ಧವಾಗಿ ಪಾಪಮಾಡಿದರೆ</para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 18:15"/>“ನಿನ್ನ ಸಹೋದರ ಅಥವಾ ಸಹೋದರಿ ಪಾಪಮಾಡಿದರೆ, ನೀವಿಬ್ಬರೇ ಇರುವಾಗ ಹೋಗಿ ಅವರನ್ನು ಖಂಡಿಸು. ಅವರು ನಿನಗೆ ಕಿವಿಗೊಟ್ಟರೆ ನೀನು ನಿನ್ನ ಸಹೋದರ ಅಥವಾ ಸಹೋದರಿಯನ್ನು ಗೆದ್ದುಕೊಂಡಿರುವೆ. <verse eid="MAT 18:15"/><verse number="16" style="v" sid="MAT 18:16"/>ಆದರೆ ಅವರು ನಿನಗೆ ಕಿವಿಗೊಡದೆ ಹೋದರೆ, ನಿನ್ನೊಂದಿಗೆ ಇಬ್ಬರನ್ನು ಕರೆದುಕೊಂಡು ಹೋಗು. ಹೀಗೆ, ‘ಇಬ್ಬರ ಇಲ್ಲವೆ ಮೂವರ ಸಾಕ್ಷಿಗಳ ಬಾಯಿಂದ ಪ್ರತಿಯೊಂದು ಮಾತು ಸ್ಥಾಪಿತವಾಗಲಿ.’<note caller="+" style="f"><char style="fr" closed="false">18:16 </char><char style="ft" closed="false"><char style="xt"><ref loc="DEU 19:15">ಧರ್ಮೋ 19:15</ref></char></char></note> <verse eid="MAT 18:16"/><verse number="17" style="v" sid="MAT 18:17"/>ಅವರು ಅವರಿಗೂ ಕಿವಿಗೊಡದೆ ಹೋದರೆ ಅದನ್ನು ಸಭೆಗೆ ತಿಳಿಸು. ಅವರು ಸಭೆಗೂ ಕಿವಿಗೊಡದೆ ಹೋದರೆ, ಅವನು ನಿನಗೆ ಅನ್ಯನಂತೆಯೂ ಸುಂಕದವನಂತೆಯೂ ಇರಲಿ.<verse eid="MAT 18:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 18:18"/>“ನೀವು ಭೂಮಿಯಲ್ಲಿ ಯಾವುದನ್ನು ಬಂಧಿಸುತ್ತೀರೋ ಅದು ಪರಲೋಕದಲ್ಲಿಯೂ ಬಂಧಿತವಾಗುವುದು. ನೀವು ಭೂಮಿಯಲ್ಲಿ ಏನನ್ನು ಬಿಚ್ಚುತ್ತೀರೋ ಅದು ಪರಲೋಕದಲ್ಲಿಯೂ ಬಿಚ್ಚಲಾಗುವುದು ಎಂದು ನಿಮಗೆ ನಿಜವಾಗಿ ಹೇಳುತ್ತೇನೆ.<verse eid="MAT 18:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 18:19"/>“ಇನ್ನೂ ನಾನು ನಿಮಗೆ ನಿಜವಾಗಿ ಹೇಳುವುದೇನೆಂದರೆ: ನಿಮ್ಮಲ್ಲಿ ಇಬ್ಬರು ತಾವು ಬೇಡಿಕೊಳ್ಳುವ ಯಾವುದೇ ವಿಷಯಕ್ಕಾಗಿ ಭೂಮಿಯಲ್ಲಿ ಒಂದೇ ಮನಸ್ಸುಳ್ಳವರಾಗಿದ್ದರೆ, ಅದು ಪರಲೋಕದಲ್ಲಿರುವ ನನ್ನ ತಂದೆಯಿಂದ ಅವರಿಗೆ ಆಗುವುದು. <verse eid="MAT 18:19"/><verse number="20" style="v" sid="MAT 18:20"/>ಏಕೆಂದರೆ ಇಬ್ಬರಾಗಲಿ ಮೂವರಾಗಲಿ ನನ್ನ ಹೆಸರಿನಲ್ಲಿ ಎಲ್ಲಿ ಸೇರಿ ಬರುತ್ತಾರೋ ಅವರ ಮಧ್ಯದಲ್ಲಿ ನಾನು ಇದ್ದೇನೆ,” ಎಂದರು.<verse eid="MAT 18:20"/></para>
  <para style="s1">ಕರುಣಿಸದ ಸೇವಕನ ಸಾಮ್ಯ</para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 18:21"/>ತರುವಾಯ ಪೇತ್ರನು ಯೇಸುವಿನ ಬಳಿಗೆ ಬಂದು, “ಕರ್ತನೇ, ನನ್ನ ಸಹೋದರ ಅಥವಾ ಸಹೋದರಿ ನನಗೆ ವಿರೋಧವಾಗಿ ಪಾಪಮಾಡಿದರೆ ನಾನು ಎಷ್ಟು ಸಲ ಅವರನ್ನು ಕ್ಷಮಿಸಬೇಕು? ಏಳು ಸಲವೋ?” ಎಂದು ಕೇಳಿದನು.<verse eid="MAT 18:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 18:22"/>ಅದಕ್ಕೆ ಯೇಸು, “ಏಳು ಸಲವಲ್ಲ, ಏಳೆಪ್ಪತ್ತು ಸಲ ಎಂದು ನಾನು ನಿಮಗೆ ಹೇಳುತ್ತೇನೆ.<verse eid="MAT 18:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 18:23"/>“ಆದ್ದರಿಂದ ಪರಲೋಕ ರಾಜ್ಯವು ತನ್ನ ಸೇವಕರಿಂದ ಲೆಕ್ಕ ತೆಗೆದುಕೊಳ್ಳಬೇಕೆಂದಿದ್ದ ಒಬ್ಬ ಅರಸನಿಗೆ ಹೋಲಿಕೆಯಾಗಿದೆ. <verse eid="MAT 18:23"/><verse number="24" style="v" sid="MAT 18:24"/>ಅವನು ಲೆಕ್ಕ ತೆಗೆದುಕೊಳ್ಳಲು ಪ್ರಾರಂಭಿಸಿದಾಗ, ಹತ್ತು ಕೋಟಿ ಚಿನ್ನದ ನಾಣ್ಯಗಳ<note caller="+" style="f"><char style="fr" closed="false">18:24 </char><char style="ft" closed="false">ಗ್ರೀಕ್ ಭಾಷೆಯಲ್ಲಿ ಹತ್ತು ಸಾವಿರ </char><char style="fqa" closed="false">ತಲಾಂತು. </char><char style="ft" closed="false">ದೊಡ್ಡ ಮೊತ್ತದ ಹಣ</char></note> ಸಾಲ ಕೊಡಬೇಕಾದವನನ್ನು ಅವನ ಬಳಿಗೆ ತಂದರು. <verse eid="MAT 18:24"/><verse number="25" style="v" sid="MAT 18:25"/>ಆದರೆ ಕೊಡುವುದಕ್ಕೆ ಅವನಲ್ಲಿ ಏನೂ ಇಲ್ಲದ್ದರಿಂದ ಅವನನ್ನೂ ಅವನ ಹೆಂಡತಿಯನ್ನೂ ಮಕ್ಕಳನ್ನೂ ಅವನಿಗಿದ್ದದ್ದೆಲ್ಲವನ್ನೂ ಮಾರಿ ಸಾಲ ತೀರಿಸಬೇಕೆಂದು ಅರಸನು ಅಪ್ಪಣೆಕೊಟ್ಟನು.<verse eid="MAT 18:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 18:26"/>“ಆಗ ಆ ಸೇವಕನು ಮೊಣಕಾಲೂರಿ, ‘ನನ್ನನ್ನು ಸ್ವಲ್ಪ ಸಹಿಸಿಕೊಳ್ಳಿರಿ. ನಾನು ನಿನ್ನ ಸಾಲವನ್ನೆಲ್ಲಾ ತೀರಿಸಿಬಿಡುತ್ತೇನೆ,’ ಎಂದು ಹೇಳಿದನು. <verse eid="MAT 18:26"/><verse number="27" style="v" sid="MAT 18:27"/>ಆಗ ಅರಸನು ಸೇವಕನ ಮೇಲೆ ಕನಿಕರಪಟ್ಟು, ಅವನನ್ನು ಬಿಡುಗಡೆ ಮಾಡಿ ಅವನ ಸಾಲವನ್ನೆಲ್ಲಾ ಮನ್ನಿಸಿಬಿಟ್ಟನು.<verse eid="MAT 18:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 18:28"/>“ಆದರೆ ಅದೇ ಸೇವಕನು ಹೊರಗೆ ಹೋಗಿ, ತನಗೆ ಸುಮಾರು ನೂರು ಬೆಳ್ಳಿ ನಾಣ್ಯಗಳನ್ನು<note caller="+" style="f"><char style="fr" closed="false">18:28 </char><char style="ft" closed="false">ಒಂದು ದಿನಾರಿಯ ಬೆಳ್ಳಿ ನಾಣ್ಯವು ಒಂದು ದಿನದ ಕೂಲಿಗೆ ಸಮವಾಗಿತ್ತು</char></note> ಸಾಲ ಕೊಡಬೇಕಾಗಿದ್ದ ತನ್ನ ಜೊತೆಯ ಸೇವಕರಲ್ಲಿ ಒಬ್ಬನನ್ನು ಕಂಡು, ಅವನನ್ನು ಹಿಡಿದು ಕುತ್ತಿಗೆ ಹಿಸುಕಿ, ‘ನನ್ನ ಸಾಲವನ್ನು ತೀರಿಸು,’ ಎಂದನು.<verse eid="MAT 18:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 18:29"/>“ಆಗ ಅವನ ಜೊತೆಯ ಸೇವಕನು ಮೊಣಕಾಲೂರಿ ಅವನಿಗೆ, ‘ನನ್ನನ್ನು ಸ್ವಲ್ಪ ಸಹಿಸಿಕೊಳ್ಳಿರಿ. ನಾನು ಸಾಲವನ್ನೆಲ್ಲಾ ತೀರಿಸಿಬಿಡುತ್ತೇನೆ,’ ಎಂದು ಅವನನ್ನು ಬೇಡಿಕೊಂಡನು.<verse eid="MAT 18:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="MAT 18:30"/>“ಆದರೆ ಅವನು ಅದಕ್ಕೆ ಒಪ್ಪದೆ ಹೊರಟುಹೋಗಿ, ತನ್ನ ಸಾಲವನ್ನು ತೀರಿಸುವವರೆಗೆ ಅವನನ್ನು ಸೆರೆಮನೆಯಲ್ಲಿ ಹಾಕಿಸಿದನು. <verse eid="MAT 18:30"/><verse number="31" style="v" sid="MAT 18:31"/>ಅವನ ಜೊತೆಯ ಸೇವಕರು ನಡೆದದ್ದನ್ನು ನೋಡಿ, ಬಹಳ ವ್ಯಥೆಪಟ್ಟು ಹೋಗಿ ತಮ್ಮ ಅರಸನಿಗೆ ನಡೆದದ್ದೆಲ್ಲವನ್ನು ವರದಿಮಾಡಿದರು.<verse eid="MAT 18:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 18:32"/>“ಆಗ ಅರಸನು ಅವನನ್ನು ತನ್ನ ಬಳಿಗೆ ಕರೆದು ಅವನಿಗೆ, ‘ದುಷ್ಟ ಸೇವಕನೇ, ನೀನು ನನ್ನನ್ನು ಬೇಡಿಕೊಂಡಿದ್ದರಿಂದ ನಾನು ನಿನ್ನ ಸಾಲವನ್ನೆಲ್ಲಾ ಮನ್ನಿಸಿದೆನು. <verse eid="MAT 18:32"/><verse number="33" style="v" sid="MAT 18:33"/>ನಾನು ನಿನ್ನ ಮೇಲೆ ಕರುಣೆ ತೋರಿಸಿದಂತೆಯೇ ನೀನು ಸಹ ನಿನ್ನ ಜೊತೆ ಸೇವಕನ ಮೇಲೆ ಕರುಣೆ ತೋರಿಸಬೇಕಿತ್ತಲ್ಲವೇ?’ ಎಂದು ಹೇಳಿ, <verse eid="MAT 18:33"/><verse number="34" style="v" sid="MAT 18:34"/>ಕೋಪಗೊಂಡು ತನಗೆ ಕೊಡಬೇಕಾದ ಸಾಲವನ್ನೆಲ್ಲಾ ತೀರಿಸುವ ತನಕ ಅರಸನು ಅವನನ್ನು ಕಠಿಣ ಶಿಕ್ಷೆಗೆ ಒಳಪಡಿಸಲು ಸೆರೆಮನೆಯ ಅಧಿಕಾರಿಯ ವಶಕ್ಕೆ ಒಪ್ಪಿಸಿದನು.<verse eid="MAT 18:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="MAT 18:35"/>“ಅದರಂತೆಯೇ ನಿಮ್ಮಲ್ಲಿ ಪ್ರತಿಯೊಬ್ಬರು ಹೃದಯಪೂರ್ವಕವಾಗಿ ತನ್ನ ಸಹೋದರನನ್ನು ಕ್ಷಮಿಸದೆ ಹೋದರೆ ಪರಲೋಕದಲ್ಲಿರುವ ನನ್ನ ತಂದೆಯು ಸಹ ನಿಮಗೆ ಹಾಗೆಯೇ ಮಾಡುವರು,” ಎಂದರು.<verse eid="MAT 18:35"/></para>
  <chapter eid="MAT 18"/>
  <chapter number="19" style="c" sid="MAT 19"/>
  <para style="s1">ವಿವಾಹ ವಿಚ್ಛೇದನದ ವಿಷಯ</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 19:1"/>ಯೇಸು ಈ ಮಾತುಗಳನ್ನು ಹೇಳಿ ಮುಗಿಸಿದ ಮೇಲೆ, ಗಲಿಲಾಯದಿಂದ ಹೊರಟು ಯೊರ್ದನ್ ನದಿಯ ಆಚೆಯ ಯೂದಾಯ ಪ್ರಾಂತಕ್ಕೆ ಬಂದರು. <verse eid="MAT 19:1"/><verse number="2" style="v" sid="MAT 19:2"/>ಜನರ ದೊಡ್ಡ ಸಮೂಹಗಳು ಅವರನ್ನು ಹಿಂಬಾಲಿಸಿದವು, ಯೇಸು ಅವರನ್ನು ಅಲ್ಲಿ ಸ್ವಸ್ಥಮಾಡಿದರು.<verse eid="MAT 19:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 19:3"/>ಫರಿಸಾಯರಲ್ಲಿ ಕೆಲವರು ಯೇಸುವನ್ನು ಪರೀಕ್ಷಿಸುವುದಕ್ಕಾಗಿ ಅವರ ಬಳಿಗೆ ಬಂದು, “ಒಬ್ಬ ಪುರುಷನು ಯಾವ ಕಾರಣದಿಂದಾದರೂ ತನ್ನ ಹೆಂಡತಿಯನ್ನು ಬಿಟ್ಟುಬಿಡುವುದು ಧರ್ಮಸಮ್ಮತವೋ?” ಎಂದು ಕೇಳಿದರು.<verse eid="MAT 19:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 19:4"/>ಯೇಸು ಉತ್ತರವಾಗಿ ಅವರಿಗೆ, “ಆದಿಯಿಂದಲೇ ಸೃಷ್ಟಿಕರ್ತ, ‘ಅವರನ್ನು ಗಂಡು ಹೆಣ್ಣಾಗಿ ಮಾಡಿದರು.<note caller="+" style="f"><char style="fr" closed="false">19:4 </char><char style="ft" closed="false"><char style="xt"><ref loc="GEN 1:27">ಆದಿ 1:27</ref></char></char></note> <verse eid="MAT 19:4"/><verse number="5" style="v" sid="MAT 19:5"/>ಈ ಕಾರಣದಿಂದ ಪುರುಷನು ತಂದೆತಾಯಿಗಳನ್ನು ಬಿಟ್ಟು ತನ್ನ ಹೆಂಡತಿಯನ್ನು ಸೇರಿಕೊಳ್ಳುವನು; ಅವರಿಬ್ಬರೂ ಒಂದೇ ಶರೀರವಾಗಿರುವರು,’<note caller="+" style="f"><char style="fr" closed="false">19:5 </char><char style="ft" closed="false"><char style="xt"><ref loc="GEN 2:24">ಆದಿ 2:24</ref></char></char></note> ಎಂದು ಹೇಳಿದ್ದನ್ನು ನೀವು ಓದಲಿಲ್ಲವೇ? <verse eid="MAT 19:5"/><verse number="6" style="v" sid="MAT 19:6"/>ಆದ್ದರಿಂದ ಅವರು ಇನ್ನು ಇಬ್ಬರಲ್ಲ, ಒಂದೇ ಶರೀರವಾಗಿದ್ದಾರೆ. ಆದಕಾರಣ ದೇವರು ಕೂಡಿಸಿದ್ದನ್ನು, ಮನುಷ್ಯನು ಅಗಲಿಸಬಾರದು,” ಎಂದು ಹೇಳಿದರು.<verse eid="MAT 19:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 19:7"/>ಅದಕ್ಕೆ ಅವರು ಯೇಸುವಿಗೆ, “ಹಾಗಾದರೆ ವಿವಾಹ ವಿಚ್ಛೇದನ ಪತ್ರವನ್ನು ಕೊಟ್ಟು ಆಕೆಯನ್ನು ಬಿಟ್ಟು ಬಿಡಬಹುದೆಂದು ಮೋಶೆಯು ಏಕೆ ಅಪ್ಪಣೆಕೊಟ್ಟನು?” ಎಂದು ಕೇಳಿದರು.<verse eid="MAT 19:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 19:8"/>ಯೇಸು ಉತ್ತರವಾಗಿ ಅವರಿಗೆ, “ಮೋಶೆಯು ನಿಮ್ಮ ಹೃದಯ ಕಾಠಿಣ್ಯದ ದೆಸೆಯಿಂದ ಹೆಂಡತಿಯನ್ನು ಬಿಟ್ಟುಬಿಡುವುದಕ್ಕೆ ನಿಮಗೆ ಅನುಮತಿ ಕೊಟ್ಟನು. ಆದರೆ ಆದಿಯಿಂದ ಅದು ಹಾಗೆ ಇರಲಿಲ್ಲ. <verse eid="MAT 19:8"/><verse number="9" style="v" sid="MAT 19:9"/>ನಾನು ನಿಮಗೆ ಹೇಳುವುದೇನೆಂದರೆ, ಹಾದರದ ಕಾರಣದಿಂದಲ್ಲದೆ, ಯಾವನಾದರೂ ತನ್ನ ಹೆಂಡತಿಯನ್ನು ಬಿಟ್ಟು, ಮತ್ತೊಬ್ಬಳನ್ನು ಮದುವೆಯಾಗುವವನು ವ್ಯಭಿಚಾರ ಮಾಡುವವನಾಗಿದ್ದಾನೆ,” ಎಂದರು.<verse eid="MAT 19:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 19:10"/>ಆಗ ಶಿಷ್ಯರು ಯೇಸುವಿಗೆ, “ಸತಿಪತಿಯರ ಸಂಬಂಧ ಹೀಗಿರುವುದಾದರೆ, ಮದುವೆ ಆಗದಿರುವುದೇ ಒಳ್ಳೆಯದು,” ಎಂದರು.<verse eid="MAT 19:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 19:11"/>ಆದರೆ ಯೇಸು ಅವರಿಗೆ, “ಯಾರಿಗೆ ಇದು ಅನುಮತಿಸಲಾಗಿದೆಯೋ ಅವರೇ ಹೊರತು ಎಲ್ಲರೂ ಈ ಮಾತನ್ನು ಸ್ವೀಕರಿಸಲಾರರು. <verse eid="MAT 19:11"/><verse number="12" style="v" sid="MAT 19:12"/>ತಮ್ಮ ತಾಯಿಯ ಗರ್ಭದಿಂದ ಹುಟ್ಟಿದಾಗಲೇ ಕೆಲವರು ನಪುಂಸಕರಾದವರಿದ್ದಾರೆ, ಕೆಲವರು ಮನುಷ್ಯರಿಂದ ಮಾಡಲಾದ ನಪುಂಸಕರು ಇದ್ದಾರೆ. ಇನ್ನು ಕೆಲವರು ಪರಲೋಕ ರಾಜ್ಯದ ನಿಮಿತ್ತವಾಗಿ ತಮ್ಮನ್ನು ತಾವೇ ನಪುಂಸಕರಾಗಿ ಮಾಡಿಕೊಂಡವರೂ ಇದ್ದಾರೆ. ಇದನ್ನು ಸ್ವೀಕರಿಸಬಲ್ಲವನು ಸ್ವೀಕರಿಸಲಿ,” ಎಂದರು.<verse eid="MAT 19:12"/></para>
  <para style="s1">ಯೇಸುವಿನ ಬಳಿಗೆ ಬಂದ ಚಿಕ್ಕಮಕ್ಕಳು</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 19:13"/>ಯೇಸು ತಮ್ಮ ಕೈಗಳನ್ನಿಟ್ಟು ಪ್ರಾರ್ಥಿಸುವಂತೆ ಕೆಲವು ಜನರು ಚಿಕ್ಕಮಕ್ಕಳನ್ನು ಯೇಸುವಿನ ಬಳಿಗೆ ತಂದರು. ಆದರೆ ಶಿಷ್ಯರು ಅವರನ್ನು ಗದರಿಸಿದರು.<verse eid="MAT 19:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 19:14"/>ಆದರೆ ಯೇಸು, “ಚಿಕ್ಕಮಕ್ಕಳನ್ನು ನನ್ನ ಬಳಿಗೆ ಬರಲು ಬಿಡಿರಿ, ಅವುಗಳಿಗೆ ಅಡ್ಡಿಮಾಡಬೇಡಿರಿ, ಪರಲೋಕ ರಾಜ್ಯವು ಇಂಥವರದೇ,” ಎಂದರು. <verse eid="MAT 19:14"/><verse number="15" style="v" sid="MAT 19:15"/>ತರುವಾಯ ಯೇಸು ಮಕ್ಕಳ ಮೇಲೆ ತಮ್ಮ ಕೈಯಿಟ್ಟು ಆಶೀರ್ವದಿಸಿ ಅಲ್ಲಿಂದ ಹೊರಟು ಹೋದರು.<verse eid="MAT 19:15"/></para>
  <para style="s1">ಧನಿಕ ಯುವಕನು</para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 19:16"/>ಆಗ ಒಬ್ಬನು ಬಂದು ಯೇಸುವಿಗೆ, “ಒಳ್ಳೆಯ ಬೋಧಕರೇ, ನಾನು ನಿತ್ಯಜೀವವನ್ನು ಹೊಂದುವುದಕ್ಕೆ ಯಾವ ಒಳ್ಳೆಯ ಕಾರ್ಯವನ್ನು ಮಾಡಬೇಕು?” ಎಂದು ಕೇಳಿದನು.<verse eid="MAT 19:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 19:17"/>“ನೀನು ಒಳ್ಳೆಯದನ್ನು ಕುರಿತು ನನ್ನನ್ನು ಕೇಳುವುದೇಕೆ? ಒಬ್ಬಾತನೇ ಒಳ್ಳೆಯವನು. ಆದರೆ ನೀನು ಜೀವದಲ್ಲಿ ಪ್ರವೇಶಿಸಬೇಕಾದರೆ ದೇವರ ಆಜ್ಞೆಗಳನ್ನು ಅನುಸರಿಸಿ ನಡೆದುಕೋ,” ಎಂದು ಯೇಸು ಉತ್ತರಕೊಟ್ಟರು.<verse eid="MAT 19:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 19:18"/>ಅವನು ಯೇಸುವಿಗೆ, “ಅವು ಯಾವುವು?” ಎಂದು ಕೇಳಿದನು.</para>
  <para style="p" vid="MAT 19:18">ಅದಕ್ಕೆ ಯೇಸು, “ನರಹತ್ಯೆ ಮಾಡಬಾರದು, ವ್ಯಭಿಚಾರ ಮಾಡಬಾರದು, ಕದಿಯಬಾರದು, ಸುಳ್ಳುಸಾಕ್ಷಿ ಹೇಳಬಾರದು, <verse eid="MAT 19:18"/><verse number="19" style="v" sid="MAT 19:19"/>ನಿನ್ನ ತಂದೆತಾಯಿಗಳನ್ನು ಗೌರವಿಸಬೇಕು. ನಿನ್ನ ನೆರೆಯವನನ್ನು ನಿನ್ನಂತೆಯೇ ಪ್ರೀತಿಸಬೇಕು,”<note caller="+" style="f"><char style="fr" closed="false">19:19 </char><char style="ft" closed="false"><char style="xt"><ref loc="EXO 20:12-16">ವಿಮೋ 20:12-16</ref>; <ref loc="DEU 5:16-20">ಧರ್ಮೋ 5:16-20</ref>; <ref loc="LEV 19:18">ಯಾಜಕ 19:18</ref></char></char></note> ಎಂದು ಹೇಳಿದರು.<verse eid="MAT 19:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 19:20"/>ಆ ಯೌವನಸ್ಥನು ಯೇಸುವಿಗೆ, “ಇವೆಲ್ಲವನ್ನೂ ನಾನು ಕೈಗೊಂಡಿದ್ದೇನೆ, ಇನ್ನು ನನಗೇನು ಕಡಿಮೆಯಾಗಿದೆ?” ಎಂದು ಕೇಳಿದನು.<verse eid="MAT 19:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 19:21"/>ಯೇಸು ಅವನಿಗೆ, “ನೀನು ಸಂಪೂರ್ಣನಾಗಲು ಅಪೇಕ್ಷಿಸಿದರೆ, ಹೋಗಿ ನಿನ್ನ ಆಸ್ತಿಯನ್ನೆಲ್ಲಾ ಮಾರಿ ಬಡವರಿಗೆ ಕೊಡು; ನಿನಗೆ ಪರಲೋಕದಲ್ಲಿ ಸಂಪತ್ತಿರುವುದು. ನೀನು ಬಂದು ನನ್ನನ್ನು ಹಿಂಬಾಲಿಸು,” ಎಂದು ಹೇಳಿದರು.<verse eid="MAT 19:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 19:22"/>ಆದರೆ ಆ ಯುವಕನು ಯೇಸು ಹೇಳಿದ್ದನ್ನು ಕೇಳಿ, ದುಃಖದಿಂದ ಹೊರಟುಹೋದನು. ಏಕೆಂದರೆ ಅವನಿಗೆ ಬಹಳ ಆಸ್ತಿ ಇತ್ತು.<verse eid="MAT 19:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 19:23"/>ಆಗ ಯೇಸು ತಮ್ಮ ಶಿಷ್ಯರಿಗೆ, “ಐಶ್ವರ್ಯವಂತನು ಪರಲೋಕ ರಾಜ್ಯದಲ್ಲಿ ಸೇರುವುದು ಕಷ್ಟ ಎಂದು ನಾನು ನಿಮಗೆ ನಿಜವಾಗಿ ಹೇಳುತ್ತೇನೆ. <verse eid="MAT 19:23"/><verse number="24" style="v" sid="MAT 19:24"/>ಐಶ್ವರ್ಯವಂತನು ದೇವರ ರಾಜ್ಯದಲ್ಲಿ ಸೇರುವುದಕ್ಕಿಂತ ಒಂಟೆಯು ಸೂಜಿಯ ಕಣ್ಣಿನಲ್ಲಿ ನುಗ್ಗುವುದು ಸುಲಭ ಎಂದು ಪುನಃ ನಿಮಗೆ ಹೇಳುತ್ತೇನೆ,” ಎಂದರು.<verse eid="MAT 19:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 19:25"/>ಇದನ್ನು ಕೇಳಿದಾಗ ಯೇಸುವಿನ ಶಿಷ್ಯರು ಅತ್ಯಂತ ವಿಸ್ಮಯಗೊಂಡು, “ಹಾಗಾದರೆ ಯಾರು ರಕ್ಷಣೆಹೊಂದುವರು?” ಎಂದು ಕೇಳಿದರು.<verse eid="MAT 19:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 19:26"/>ಅದಕ್ಕೆ ಯೇಸು ಅವರನ್ನು ದೃಷ್ಟಿಸಿ ನೋಡಿ ಅವರಿಗೆ, “ಮನುಷ್ಯರಿಗೆ ಇದು ಅಸಾಧ್ಯ; ಆದರೆ ದೇವರಿಗೆ ಎಲ್ಲವೂ ಸಾಧ್ಯ,” ಎಂದು ಹೇಳಿದರು.<verse eid="MAT 19:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 19:27"/>ಪೇತ್ರನು ಯೇಸುವಿಗೆ, “ಇಗೋ, ನಾವು ಎಲ್ಲವನ್ನು ಬಿಟ್ಟು ನಿನ್ನನ್ನು ಹಿಂಬಾಲಿಸಿದ್ದೇವೆ! ನಮಗೆ ಏನು ದೊರೆಯುವುದು?” ಎಂದು ಕೇಳಿದನು.<verse eid="MAT 19:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 19:28"/>ಯೇಸು ಅವರಿಗೆ, “ನಾನು ನಿಮಗೆ ನಿಜವಾಗಿ ಹೇಳುತ್ತೇನೆ, ಸಮಸ್ತವೂ ನವೀಕರಣವಾಗುವಾಗ, ಮನುಷ್ಯಪುತ್ರನಾದ ನಾನು ನನ್ನ ಮಹಿಮೆಯ ಸಿಂಹಾಸನದಲ್ಲಿ ಕುಳಿತುಕೊಂಡಿರಲು, ನನ್ನನ್ನು ಹಿಂಬಾಲಿಸಿದವರಾದ ನೀವು ಸಹ ಹನ್ನೆರಡು ಸಿಂಹಾಸನಗಳ ಮೇಲೆ ಕುಳಿತುಕೊಂಡು, ಇಸ್ರಾಯೇಲಿನ ಹನ್ನೆರಡು ಗೋತ್ರಗಳಿಗೆ ನ್ಯಾಯತೀರಿಸುವಿರಿ. <verse eid="MAT 19:28"/><verse number="29" style="v" sid="MAT 19:29"/>ತನ್ನ ಮನೆಗಳನ್ನಾಗಲಿ, ಸಹೋದರರನ್ನಾಗಲಿ, ಸಹೋದರಿಯರನ್ನಾಗಲಿ, ತಂದೆಯನ್ನಾಗಲಿ, ತಾಯಿಯನ್ನಾಗಲಿ, ಮಕ್ಕಳನ್ನಾಗಲಿ, ಹೊಲವನ್ನಾಗಲಿ, ನನ್ನ ಹೆಸರಿನ ನಿಮಿತ್ತವಾಗಿ ಬಿಟ್ಟುಬಿಡುವ ಪ್ರತಿಯೊಬ್ಬನು ನೂರರಷ್ಟು ಪಡೆದುಕೊಳ್ಳುವನು ಮತ್ತು ನಿತ್ಯಜೀವಕ್ಕೆ ಬಾಧ್ಯನಾಗುವನು. <verse eid="MAT 19:29"/><verse number="30" style="v" sid="MAT 19:30"/>ಆದರೆ ಮೊದಲನೆಯವರಾದ ಅನೇಕರು ಕಡೆಯವರಾಗುವರು, ಕಡೆಯವರಾದವರು ಮೊದಲನೆಯವರಾಗುವರು.<verse eid="MAT 19:30"/></para>
  <chapter eid="MAT 19"/>
  <chapter number="20" style="c" sid="MAT 20"/>
  <para style="s1">ದ್ರಾಕ್ಷಿಯ ತೋಟದ ಕೂಲಿಯಾಳುಗಳ ಸಾಮ್ಯ</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 20:1"/>“ಪರಲೋಕ ರಾಜ್ಯವನ್ನು ತನ್ನ ದ್ರಾಕ್ಷಿಯ ತೋಟಕ್ಕೆ ಕೂಲಿಯಾಳುಗಳನ್ನು ಕರೆಯುವುದಕ್ಕಾಗಿ ಬೆಳಿಗ್ಗೆ ಹೊರಟ ಒಬ್ಬ ಯಜಮಾನನಿಗೆ ಹೋಲಿಸಲಾಗಿದೆ. <verse eid="MAT 20:1"/><verse number="2" style="v" sid="MAT 20:2"/>ಅವನು ದಿನಕ್ಕೆ ಒಂದು ಬೆಳ್ಳಿನಾಣ್ಯ<note caller="+" style="f"><char style="fr" closed="false">20:2 </char><char style="ft" closed="false">ಒಂದು ದಿನಾರಿಯ ನಾಣ್ಯವು ಒಂದು ದಿನದ ಕೂಲಿಗೆ ಸಮವಾಗಿತ್ತು</char></note> ಕೂಲಿಯಾಳುಗಳೊಂದಿಗೆ ಒಪ್ಪಂದ ಮಾಡಿಕೊಂಡು ತನ್ನ ದ್ರಾಕ್ಷಿಯ ತೋಟಕ್ಕೆ ಅವರನ್ನು ಕಳುಹಿಸಿಕೊಟ್ಟನು.<verse eid="MAT 20:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 20:3"/>“ಅವನು ಸುಮಾರು ಒಂಬತ್ತು ಗಂಟೆಗೆ ಹೊರಗೆ ಹೋಗಿ ಇನ್ನು ಕೆಲವರು ಸಂತೆಯ ಸ್ಥಳದಲ್ಲಿ ಕೆಲಸವಿಲ್ಲದೆ ನಿಂತಿರುವುದನ್ನು ಕಂಡು, <verse eid="MAT 20:3"/><verse number="4" style="v" sid="MAT 20:4"/>ಅವರಿಗೆ, ‘ನೀವು ಸಹ ದ್ರಾಕ್ಷಿಯ ತೋಟಕ್ಕೆ ಹೋಗಿರಿ; ಸರಿಯಾದ ಕೂಲಿಯನ್ನು ನಾನು ನಿಮಗೆ ಕೊಡುತ್ತೇನೆ,’ ಎಂದು ಹೇಳಿದನು. <verse eid="MAT 20:4"/><verse number="5" style="v" sid="MAT 20:5"/>ಆಗ ಅವರು ಹೊರಟು ಹೋದರು.</para>
  <para style="p" vid="MAT 20:5">“ಅವನು ಸುಮಾರು ಹನ್ನೆರಡು ಗಂಟೆಗೂ ಅನಂತರ ಮೂರು ಗಂಟೆಗೂ ತಿರುಗಿ ಹೋಗಿ ಹಾಗೆಯೇ ಮಾಡಿದನು. <verse eid="MAT 20:5"/><verse number="6" style="v" sid="MAT 20:6"/>ತರುವಾಯ ಸುಮಾರು ಐದು ಗಂಟೆಗೆ ಅವನು ಹೊರಗೆ ಹೋಗಿ ಬೇರೆ ಕೆಲವರು ಕೆಲಸವಿಲ್ಲದೆ ನಿಂತಿರುವುದನ್ನು ಕಂಡು, ‘ನೀವು ದಿನವೆಲ್ಲಾ ಇಲ್ಲಿ ಕೆಲಸವಿಲ್ಲದೆ ನಿಂತಿರುವುದೇಕೆ?’ ಎಂದು ಕೇಳಿದನು.<verse eid="MAT 20:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 20:7"/>“ಅವರು, ‘ಯಾರೂ ನಮ್ಮನ್ನು ಕೂಲಿಗೆ ಕರೆಯಲಿಲ್ಲ,’ ಎಂದರು.</para>
  <para style="p" vid="MAT 20:7">“ಆಗ ಅವನು, ‘ನೀವು ಸಹ ದ್ರಾಕ್ಷಿಯ ತೋಟಕ್ಕೆ ಹೋಗಿರಿ,’ ಎಂದು ಹೇಳಿದನು.<verse eid="MAT 20:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 20:8"/>“ಸಂಜೆಯಾದಾಗ, ದ್ರಾಕ್ಷಿಯ ತೋಟದ ಯಜಮಾನನು ತನ್ನ ಮೇಸ್ತ್ರಿಗೆ, ‘ಕೂಲಿಯಾಳುಗಳನ್ನು ಕರೆದು, ಕೊನೆಯವನಿಂದ ಪ್ರಾರಂಭಿಸಿ ಮೊದಲನೆಯವನವರೆಗೆ ಕೂಲಿಯನ್ನು ಕೊಡು,’ ಎಂದು ಹೇಳಿದನು.<verse eid="MAT 20:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 20:9"/>“ಆಗ ಐದು ಗಂಟೆಗೆ ಕರೆದವರು ಬಂದಾಗ ಪ್ರತಿಯೊಬ್ಬನಿಗೂ ಒಂದೊಂದು ಬೆಳ್ಳಿನಾಣ್ಯ ಸಿಕ್ಕಿತು. <verse eid="MAT 20:9"/><verse number="10" style="v" sid="MAT 20:10"/>ಆಗ ಮೊದಲು ಬಂದವರು, ತಮಗೆ ಹೆಚ್ಚು ದೊರೆಯುವುದೆಂದು ನೆನಸಿದರು. ಆದರೆ ಅವರಲ್ಲಿ ಪ್ರತಿಯೊಬ್ಬನಿಗೂ ಅದೇ ರೀತಿಯಲ್ಲಿ ಒಂದೊಂದೇ ಬೆಳ್ಳಿನಾಣ್ಯ ಸಿಕ್ಕಿತು. <verse eid="MAT 20:10"/><verse number="11" style="v" sid="MAT 20:11"/>ಅವರು ಅದನ್ನು ತೆಗೆದುಕೊಂಡಾಗ, ಯಜಮಾನನ ವಿರೋಧವಾಗಿ ಗೊಣುಗುಟ್ಟುತ್ತಾ, <verse eid="MAT 20:11"/><verse number="12" style="v" sid="MAT 20:12"/>‘ಕಡೆಯವರಾದ ಇವರು ಒಂದೇ ತಾಸು ಕೆಲಸಮಾಡಿದ್ದಾರೆ, ಆದರೆ ದಿನವೆಲ್ಲಾ ಬಿಸಿಲಿನಲ್ಲಿ ಭಾರ ಹೊತ್ತು ಕೆಲಸಮಾಡಿದ ನಮ್ಮನ್ನು ನೀನು ಇವರಿಗೆ ಸಮಮಾಡಿದ್ದಿ,’ ಎಂದರು.<verse eid="MAT 20:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 20:13"/>“ಆದರೆ ಯಜಮಾನನು ಅವರಲ್ಲಿ ಒಬ್ಬನಿಗೆ ಉತ್ತರವಾಗಿ, ‘ಸ್ನೇಹಿತನೇ, ನಾನು ನಿನಗೆ ಅನ್ಯಾಯ ಮಾಡಲಿಲ್ಲ. ಒಂದು ಬೆಳ್ಳಿ ನಾಣ್ಯಕ್ಕೆ ನೀನು ನನ್ನೊಂದಿಗೆ ಒಪ್ಪಂದ ಮಾಡಿಕೊಳ್ಳಲಿಲ್ಲವೇ? <verse eid="MAT 20:13"/><verse number="14" style="v" sid="MAT 20:14"/>ನಿನ್ನ ಕೂಲಿ ತೆಗೆದುಕೊಂಡು ಹೋಗು. ನಿನಗೆ ನಾನು ಕೊಟ್ಟಂತೆಯೇ ಈ ಕಡೆಯವನಿಗೂ ಕೊಡುವುದು ನನ್ನ ಇಷ್ಟ. <verse eid="MAT 20:14"/><verse number="15" style="v" sid="MAT 20:15"/>ನನ್ನದನ್ನು ನನ್ನ ಇಷ್ಟಬಂದಂತೆ ಕೊಡುವುದಕ್ಕೆ ನನಗೆ ಹಕ್ಕಿಲ್ಲವೇ? ನಾನು ಔದಾರ್ಯವುಳ್ಳವನಾದ್ದರಿಂದ, ನಿನಗೆ ಹೊಟ್ಟೆಯುರಿಯೋ?’ ಎಂದನು.<verse eid="MAT 20:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 20:16"/>“ಹೀಗೆ ಕಡೆಯವರು ಮೊದಲನೆಯವರಾಗುವರು, ಮೊದಲನೆಯವರು ಕಡೆಯವರಾಗುವರು,” ಎಂದು ಹೇಳಿದರು.<verse eid="MAT 20:16"/></para>
  <para style="s1">ಯೇಸು ತಮ್ಮ ಮರಣದ ವಿಷಯ ಪ್ರವಾದಿಸಿದ್ದು</para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 20:17"/>ಯೇಸು ಯೆರೂಸಲೇಮಿಗೆ ಹೋಗುತ್ತಿರುವಾಗ ಹನ್ನೆರಡು ಮಂದಿ ಶಿಷ್ಯರನ್ನು ದಾರಿಯಲ್ಲಿ ಪ್ರತ್ಯೇಕವಾಗಿ ಕರೆದು ಅವರಿಗೆ, <verse eid="MAT 20:17"/><verse number="18" style="v" sid="MAT 20:18"/>“ಇಗೋ, ನಾವು ಯೆರೂಸಲೇಮಿಗೆ ಹೋಗುತ್ತಿದ್ದೇವೆ. ಅಲ್ಲಿ ಮನುಷ್ಯಪುತ್ರನಾದ ನನ್ನನ್ನು ಮುಖ್ಯಯಾಜಕರ ಮತ್ತು ನಿಯಮ ಬೋಧಕರ ಕೈಗೆ ಒಪ್ಪಿಸಿಕೊಡುವರು. ಅವರು ನನಗೆ ಮರಣದಂಡನೆಯನ್ನು ವಿಧಿಸುವರು. <verse eid="MAT 20:18"/><verse number="19" style="v" sid="MAT 20:19"/>ಇದಲ್ಲದೆ ನನ್ನನ್ನು ಹಾಸ್ಯಮಾಡುವುದಕ್ಕೂ ಕೊರಡೆಗಳಿಂದ ಹೊಡೆಯುವುದಕ್ಕೂ ಶಿಲುಬೆಗೆ ಹಾಕುವುದಕ್ಕೂ ಯೆಹೂದ್ಯರಲ್ಲದವರ ಕೈಗೆ ಒಪ್ಪಿಸಿಕೊಡುವರು. ನಾನಾದರೋ ಮೂರು ದಿನದ ಮೇಲೆ ಜೀವಿತನಾಗಿ ಎದ್ದು ಬರುವೆನು,” ಎಂದು ಹೇಳಿದರು.<verse eid="MAT 20:19"/></para>
  <para style="s1">ತಾಯಿಯ ಬೇಡಿಕೆ</para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 20:20"/>ಜೆಬೆದಾಯನ ಮಕ್ಕಳ ತಾಯಿ ತನ್ನ ಪುತ್ರರ ಸಮೇತ ಯೇಸುವಿನ ಬಳಿಗೆ ಬಂದು, ಅವರ ಮುಂದೆ ಮೊಣಕಾಲೂರಿ ಬೇಡಿಕೊಂಡಳು.<verse eid="MAT 20:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 20:21"/>ಯೇಸು, “ನಿನ್ನ ಬೇಡಿಕೆ ಏನು?” ಎಂದು ಕೇಳಿದರು.</para>
  <para style="p" vid="MAT 20:21">“ನಿಮ್ಮ ರಾಜ್ಯದಲ್ಲಿ ಈ ನನ್ನ ಇಬ್ಬರು ಪುತ್ರರಲ್ಲಿ ಒಬ್ಬನು ನಿಮ್ಮ ಬಲಗಡೆಯಲ್ಲೂ ಇನ್ನೊಬ್ಬನು ನಿಮ್ಮ ಎಡಗಡೆಯಲ್ಲೂ ಕುಳಿತುಕೊಳ್ಳುವಂತೆ ಅನುಗ್ರಹಿಸಬೇಕು,” ಎಂದು ಬೇಡಿಕೊಂಡಳು.<verse eid="MAT 20:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 20:22"/>ಯೇಸು ಉತ್ತರವಾಗಿ, “ನೀವು ಬೇಡಿಕೊಂಡದ್ದು ಏನೆಂದು ನಿಮಗೆ ತಿಳಿಯದು. ನಾನು ಕುಡಿಯಲಿರುವ ಪಾತ್ರೆಯಿಂದ ಕುಡಿಯಲು ನಿಮ್ಮಿಂದಾದೀತೇ?” ಎಂದು ಕೇಳಿದರು.</para>
  <para style="p" vid="MAT 20:22">ಅವರು, “ಹೌದು, ನಮ್ಮಿಂದಾಗುವುದು,” ಎಂದು ಹೇಳಿದರು.<verse eid="MAT 20:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 20:23"/>ಅದಕ್ಕೆ ಯೇಸು, “ನನ್ನ ಪಾತ್ರೆಯಿಂದ ನೀವು ಕುಡಿಯುವಿರಿ, ಆದರೆ ನನ್ನ ಬಲಗಡೆಯಲ್ಲಾಗಲಿ ಎಡಗಡೆಯಲ್ಲಾಗಲಿ ಕುಳಿತುಕೊಳ್ಳುವಂತೆ ಅನುಗ್ರಹಿಸುವುದು ನನ್ನದಲ್ಲ, ನನ್ನ ತಂದೆಯಿಂದ ಅದು ಯಾರಿಗೋಸ್ಕರ ಸಿದ್ಧವಾಗಿದೆಯೋ ಅವರಿಗೇ ಕೊಡಲಾಗುವುದು,” ಎಂದು ಹೇಳಿದರು.<verse eid="MAT 20:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 20:24"/>ಬೇರೆ ಹತ್ತು ಮಂದಿ ಶಿಷ್ಯರು ಇದನ್ನು ಕೇಳಿದಾಗ, ಆ ಇಬ್ಬರು ಸಹೋದರರ ಮೇಲೆ ಸಿಟ್ಟುಗೊಂಡರು. <verse eid="MAT 20:24"/><verse number="25" style="v" sid="MAT 20:25"/>ಆದರೆ ಯೇಸು ಶಿಷ್ಯರನ್ನು ತಮ್ಮ ಹತ್ತಿರಕ್ಕೆ ಕರೆದು, “ಯೆಹೂದ್ಯರಲ್ಲದವರ ಅಧಿಪತಿಗಳು ತಮ್ಮ ಪ್ರಜೆಗಳ ಮೇಲೆ ದೊರೆತನ ಮಾಡುತ್ತಾರೆಂದೂ ಉನ್ನತ ಅಧಿಕಾರಿಗಳು ಅವರ ಮೇಲೆ ಅಧಿಕಾರವನ್ನು ನಡೆಸುತ್ತಾರೆಂದೂ ನಿಮಗೆ ತಿಳಿದಿದೆ. <verse eid="MAT 20:25"/><verse number="26" style="v" sid="MAT 20:26"/>ಆದರೆ ನೀವು ಹಾಗಿರಬಾರದು. ನಿಮ್ಮಲ್ಲಿ ದೊಡ್ಡವನಾಗಿರಬೇಕೆಂದಿರುವವನು ನಿಮ್ಮ ಸೇವಕನಾಗಿರಲಿ. <verse eid="MAT 20:26"/><verse number="27" style="v" sid="MAT 20:27"/>ನಿಮ್ಮಲ್ಲಿ ಯಾವನಾದರೂ ಪ್ರಮುಖನಾಗಬೇಕೆಂದಿದ್ದರೆ, ಅವನು ನಿಮ್ಮ ಆಳಾಗಿರಲಿ. <verse eid="MAT 20:27"/><verse number="28" style="v" sid="MAT 20:28"/>ಮನುಷ್ಯಪುತ್ರನಾದ ನಾನು ಸಹ ಸೇವೆಮಾಡಿಸಿಕೊಳ್ಳುವುದಕ್ಕಾಗಿ ಅಲ್ಲ, ಸೇವೆಮಾಡುವುದಕ್ಕಾಗಿಯೂ ಅನೇಕರಿಗಾಗಿ ನನ್ನ ಪ್ರಾಣವನ್ನೇ ಈಡಾಗಿ ಕೊಡುವುದಕ್ಕಾಗಿಯೂ ಬಂದಿದ್ದೇನೆ,” ಎಂದು ಹೇಳಿದರು.<verse eid="MAT 20:28"/></para>
  <para style="s1">ಯೇಸು ಇಬ್ಬರು ಕುರುಡರಿಗೆ ದೃಷ್ಟಿಕೊಟ್ಟದ್ದು</para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 20:29"/>ಯೇಸು ಮತ್ತು ಅವರ ಶಿಷ್ಯರು ಯೆರಿಕೋವಿನಿಂದ ಹೊರಟು ಹೋಗುತ್ತಿರುವಾಗ, ಜನರು ದೊಡ್ಡ ಸಮೂಹವಾಗಿ ಯೇಸುವನ್ನು ಹಿಂಬಾಲಿಸಿದರು. <verse eid="MAT 20:29"/><verse number="30" style="v" sid="MAT 20:30"/>ದಾರಿಯ ಮಗ್ಗುಲಲ್ಲಿ ಕೂತಿದ್ದ ಇಬ್ಬರು ಕುರುಡರು ಯೇಸು ಹಾದು ಹೋಗುತ್ತಿದ್ದಾರೆಂದು ಕೇಳಿ, “ಕರ್ತನೇ, ದಾವೀದನ ಪುತ್ರನೇ, ನಮ್ಮ ಮೇಲೆ ಕರುಣೆಯಿಡು!” ಎಂದು ಕೂಗಿ ಹೇಳಿದರು.<verse eid="MAT 20:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 20:31"/>ಅವರು ಸುಮ್ಮನಿರುವಂತೆ ಜನರ ಸಮೂಹವು ಅವರನ್ನು ಗದರಿಸಿತು. ಆದರೂ ಅವರು, “ಕರ್ತನೇ, ದಾವೀದನ ಪುತ್ರನೇ, ನಮ್ಮ ಮೇಲೆ ಕರುಣೆಯಿಡು!” ಎಂದು ಇನ್ನೂ ಗಟ್ಟಿಯಾಗಿ ಕೂಗಿಕೊಂಡರು.<verse eid="MAT 20:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 20:32"/>ಆಗ ಯೇಸು ನಿಂತು, ಅವರನ್ನು ಕರೆದು, “ನಾನು ನಿಮಗೆ ಏನು ಮಾಡಬೇಕೆಂದು ಅಪೇಕ್ಷಿಸುತ್ತೀರಿ?” ಎಂದು ಕೇಳಿದರು.<verse eid="MAT 20:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 20:33"/>ಅವರು ಯೇಸುವಿಗೆ, “ಕರ್ತದೇವರೇ, ನಮಗೆ ಕಣ್ಣು ಕಾಣುವಂತೆ ಮಾಡು,” ಎಂದರು.<verse eid="MAT 20:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 20:34"/>ಯೇಸು ಅವರ ಮೇಲೆ ಕನಿಕರಪಟ್ಟು ಅವರ ಕಣ್ಣುಗಳನ್ನು ಮುಟ್ಟಿದರು. ಕೂಡಲೇ ಅವರ ಕಣ್ಣುಗಳು ದೃಷ್ಟಿಯನ್ನು ಪಡೆದವು. ಅವರೂ ಯೇಸುವನ್ನು ಹಿಂಬಾಲಿಸಿದರು.<verse eid="MAT 20:34"/></para>
  <chapter eid="MAT 20"/>
  <chapter number="21" style="c" sid="MAT 21"/>
  <para style="s1">ಯೆರೂಸಲೇಮಿನಲ್ಲಿ ಯೇಸು ಅರಸನಂತೆ ಪ್ರವೇಶ</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 21:1"/>ಅವರು ಯೆರೂಸಲೇಮಿಗೆ ಸಮೀಪಿಸಿ ಓಲಿವ್ ಗುಡ್ಡದ ಬೇತ್ಫಗೆ ಬಂದಾಗ, ಯೇಸು ಇಬ್ಬರು ಶಿಷ್ಯರನ್ನು ಕಳುಹಿಸಿ, <verse eid="MAT 21:1"/><verse number="2" style="v" sid="MAT 21:2"/>ಅವರಿಗೆ, “ನಿಮ್ಮ ಎದುರಿಗಿರುವ ಹಳ್ಳಿಗೆ ಹೋಗಿರಿ. ತಕ್ಷಣವೇ ಒಂದು ಕತ್ತೆಯು ತನ್ನ ಮರಿಯೊಂದಿಗೆ ಕಟ್ಟಿರುವುದನ್ನು ನೀವು ಕಾಣುವಿರಿ. ಅವುಗಳನ್ನು ಬಿಚ್ಚಿ ನನ್ನ ಬಳಿಗೆ ತೆಗೆದುಕೊಂಡು ಬನ್ನಿರಿ. <verse eid="MAT 21:2"/><verse number="3" style="v" sid="MAT 21:3"/>ಯಾವನಾದರೂ ನಿಮಗೆ ಏನಾದರೂ ಕೇಳಿದರೆ, ನೀವು ಅವನಿಗೆ, ‘ಇವು ಕರ್ತದೇವರಿಗೆ ಅವಶ್ಯವಾಗಿವೆ’ ಎಂದು ಹೇಳಿರಿ. ಆಗ ಅವನು ಅವುಗಳನ್ನು ಕೂಡಲೇ ಕಳುಹಿಸುವನು,” ಎಂದು ಹೇಳಿದರು.<verse eid="MAT 21:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 21:4"/>ಇದೆಲ್ಲವೂ ಪವಿತ್ರ ವೇದದಲ್ಲಿ ಪ್ರವಾದಿಯ ಮುಖಾಂತರ ಹೇಳಿದ ಮಾತು ನೆರವೇರುವಂತೆ ಆಯಿತು. ಅದೇನೆಂದರೆ,<verse eid="MAT 21:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="MAT 21:5"/>“ಚೀಯೋನಿನ ಪುತ್ರಿಗೆ ಹೇಳಿರಿ,<note caller="+" style="f"><char style="fr" closed="false">21:5 </char><char style="fq" closed="false">ಚೀಯೋನ </char><char style="ft" closed="false">ಅಂದರೆ </char><char style="fqa" closed="false">ಯೆರೂಸಲೇಮ</char></note></para>
  <para style="q2" vid="MAT 21:5">‘ಇಗೋ, ನಿನ್ನ ಅರಸನು,</para>
  <para style="q1" vid="MAT 21:5">ಸಾತ್ವಿಕನಾಗಿ, ಕತ್ತೆಯನ್ನೂ,</para>
  <para style="q2" vid="MAT 21:5">ಕತ್ತೆಯಮರಿಯನ್ನೂ ಹತ್ತಿದವನಾಗಿ ನಿನ್ನ ಬಳಿಗೆ ಬರುತ್ತಾನೆ.’ ”<note caller="+" style="f"><char style="fr" closed="false">21:5 </char><char style="ft" closed="false"><char style="xt"><ref loc="ZEC 9:9">ಜೆಕರ್ಯ 9:9</ref></char></char></note><verse eid="MAT 21:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 21:6"/>ಆಗ ಶಿಷ್ಯರು ಹೊರಟುಹೋಗಿ ಯೇಸು ತಮಗೆ ಅಪ್ಪಣೆ ಕೊಟ್ಟಂತೆಯೇ ಮಾಡಿದರು. <verse eid="MAT 21:6"/><verse number="7" style="v" sid="MAT 21:7"/>ಅವರು ಕತ್ತೆಯನ್ನೂ ಅದರ ಮರಿಯನ್ನೂ ತಂದು ಅವುಗಳ ಮೇಲೆ ತಮ್ಮ ಬಟ್ಟೆಗಳನ್ನು ಹಾಕಿದರು; ಯೇಸು ಅದರ ಮೇಲೆ ಕೂತುಕೊಂಡರು. <verse eid="MAT 21:7"/><verse number="8" style="v" sid="MAT 21:8"/>ಆಗ ಜನರ ದೊಡ್ಡ ಸಮೂಹವು ತಮ್ಮ ಬಟ್ಟೆಗಳನ್ನು ದಾರಿಯಲ್ಲಿ ಹಾಸಿದರು. ಇತರರು ಮರಗಳಿಂದ ಕೊಂಬೆಗಳನ್ನು ಕೊಯ್ದು ದಾರಿಯಲ್ಲಿ ಹರಡಿದರು. <verse eid="MAT 21:8"/><verse number="9" style="v" sid="MAT 21:9"/>ಯೇಸುವಿನ ಮುಂದೆಯೂ ಹಿಂದೆಯೂ ಹೋಗುತ್ತಿದ್ದ ಜನರ ಸಮೂಹಗಳು,</para>
  <para style="q1" vid="MAT 21:9">“ದಾವೀದನ ಪುತ್ರನಿಗೆ ಹೊಸನ್ನ<note caller="+" style="f"><char style="fr" closed="false">21:9 </char><char style="fq" closed="false">ಹೊಸನ್ನ </char><char style="ft" closed="false">ಹೀಬ್ರೂ ಭಾಷೆಯಲ್ಲಿ </char><char style="fqa" closed="false">ನಮ್ಮನ್ನು ರಕ್ಷಿಸು</char></note>!”</para>
  <para style="b" vid="MAT 21:9"/>
  <para style="q1" vid="MAT 21:9">“ಕರ್ತನ ಹೆಸರಿನಲ್ಲಿ ಬರುವವನಿಗೆ ಆಶೀರ್ವಾದ!”<note caller="+" style="f"><char style="fr" closed="false">21:9 </char><char style="ft" closed="false"><char style="xt"><ref loc="PSA 118:25">ಕೀರ್ತನೆ 118:25</ref>,<ref loc="PSA 118:26">26</ref></char></char></note></para>
  <para style="b" vid="MAT 21:9"/>
  <para style="q1" vid="MAT 21:9">“ಮಹೋನ್ನತದಲ್ಲಿ ಜಯ!”</para>
  <para style="m" vid="MAT 21:9">ಎಂದು ಘೋಷಿಸಿದರು.<verse eid="MAT 21:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 21:10"/>ಯೆರೂಸಲೇಮಿಗೆ ಪ್ರವೇಶಿಸಿದಾಗ, ಪಟ್ಟಣದಲ್ಲಿ ಕೋಲಾಹಲವುಂಟಾಗಿ, “ಇವರು ಯಾರು?” ಎಂದು ಕೇಳಿದರು.<verse eid="MAT 21:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 21:11"/>ಅದಕ್ಕೆ ಜನಸಮೂಹವು, “ಇವರು ಯೇಸು, ಗಲಿಲಾಯದ ನಜರೇತಿನ ಪ್ರವಾದಿ,” ಎಂದು ಹೇಳಿತು.<verse eid="MAT 21:11"/></para>
  <para style="s1">ದೇವಾಲಯದಲ್ಲಿ ಯೇಸು</para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 21:12"/>ಯೇಸು ದೇವಾಲಯದ ಅಂಗಳದೊಳಗೆ ಹೋಗಿ ಮಾರುತ್ತಿದ್ದವರನ್ನೂ ಕೊಂಡುಕೊಳ್ಳುತ್ತಿದ್ದವರನ್ನೂ ಹೊರಗಟ್ಟಿದರು. ಹಣ ವಿನಿಮಯ ಮಾಡುತ್ತಿದ್ದವರ ಮೇಜುಗಳನ್ನೂ ಪಾರಿವಾಳ ಮಾರುವವರ ಆಸನಗಳನ್ನೂ ಕೆಡವಿಹಾಕಿದರು. <verse eid="MAT 21:12"/><verse number="13" style="v" sid="MAT 21:13"/>ಯೇಸು ಅವರಿಗೆ, “ ‘ನನ್ನ ಮನೆಯು ಪ್ರಾರ್ಥನೆಯ ಮನೆಯಾಗಿದೆ,’<note caller="+" style="f"><char style="fr" closed="false">21:13 </char><char style="ft" closed="false"><char style="xt"><ref loc="ISA 56:7">ಯೆಶಾಯ 56:7</ref></char></char></note> ಎಂದು ಬರೆದದೆ. ಆದರೆ ನೀವಾದರೋ ಅದನ್ನು, ‘ಕಳ್ಳರ ಗವಿಯನ್ನಾಗಿ’ ಮಾಡಿದ್ದೀರಿ,”<note caller="+" style="f"><char style="fr" closed="false">21:13 </char><char style="ft" closed="false"><char style="xt"><ref loc="JER 7:11">ಯೆರೆ 7:11</ref></char></char></note> ಎಂದು ಹೇಳಿದರು.<verse eid="MAT 21:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 21:14"/>ಆಗ ಕುರುಡರು ಮತ್ತು ಕುಂಟರು ದೇವಾಲಯದಲ್ಲಿ ಅವರ ಬಳಿಗೆ ಬಂದರು. ಯೇಸು ಅವರನ್ನು ಸ್ವಸ್ಥಮಾಡಿದರು. <verse eid="MAT 21:14"/><verse number="15" style="v" sid="MAT 21:15"/>ಯೇಸು ಮಾಡಿದ ಅದ್ಭುತಕಾರ್ಯಗಳನ್ನು ಮತ್ತು ಮಕ್ಕಳು ದೇವಾಲಯದಲ್ಲಿ, “ದಾವೀದನ ಪುತ್ರನಿಗೆ ಹೊಸನ್ನ,” ಎಂದು ಕೂಗುವುದನ್ನು ಮುಖ್ಯಯಾಜಕರೂ ನಿಯಮ ಬೋಧಕರೂ ಕಂಡು ಕೋಪಗೊಂಡರು.<verse eid="MAT 21:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 21:16"/>“ಮಕ್ಕಳು ಹೇಳುವುದೇನೆಂದು ನಿನಗೆ ಕೇಳಿಸುತ್ತಿದೆಯೋ?” ಎಂದು ಯೇಸುವನ್ನು ಕೇಳಿದರು.</para>
  <para style="p" vid="MAT 21:16">ಯೇಸು, “ಹೌದು,” ಎಂದು ಉತ್ತರಿಸಿ ಅವರಿಗೆ,</para>
  <para style="q1" vid="MAT 21:16">“ ‘ಸಣ್ಣ ಮಕ್ಕಳ ಮತ್ತು ಹಾಲುಣ್ಣುವ ಕೂಸುಗಳ ಬಾಯಿಂದ</para>
  <para style="q2" vid="MAT 21:16">ನೀನು ಸ್ತೋತ್ರವನ್ನು ಸಿದ್ಧಿಗೆ ತಂದಿದ್ದೀ,’<note caller="+" style="f"><char style="fr" closed="false">21:16 </char><char style="ft" closed="false"><char style="xt"><ref loc="PSA 8:2">ಕೀರ್ತನೆ 8:2</ref></char></char></note></para>
  <para style="m" vid="MAT 21:16">ಎಂಬುದನ್ನು ಓದಲಿಲ್ಲವೋ?” ಎಂದರು.<verse eid="MAT 21:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 21:17"/>ಯೇಸು ಅವರನ್ನು ಬಿಟ್ಟು ಪಟ್ಟಣದಿಂದ ಹೊರಟು ಬೇಥಾನ್ಯಕ್ಕೆ ಹೋಗಿ, ಅಲ್ಲಿ ರಾತ್ರಿ ಉಳಿದುಕೊಂಡರು.<verse eid="MAT 21:17"/></para>
  <para style="s1">ಅಂಜೂರದ ಮರವು ಒಣಗಿದ್ದು</para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 21:18"/>ಬೆಳಿಗ್ಗೆ ಪಟ್ಟಣಕ್ಕೆ ಹಿಂದಿರುಗಿ ಬರುತ್ತಿದ್ದಾಗ, ಯೇಸುವಿಗೆ ಹಸಿವಾಯಿತು. <verse eid="MAT 21:18"/><verse number="19" style="v" sid="MAT 21:19"/>ಯೇಸು ದಾರಿಯಲ್ಲಿ ಒಂದು ಅಂಜೂರದ ಮರವನ್ನು ಕಂಡು, ಅದರ ಹತ್ತಿರಕ್ಕೆ ಬಂದಾಗ ಎಲೆಗಳನ್ನೇ ಹೊರತು ಮತ್ತೇನೂ ಕಾಣಲಿಲ್ಲ. ಆಗ ಯೇಸು, ಆ ಮರಕ್ಕೆ, “ಇನ್ನು ಮೇಲೆ ಎಂದೆಂದಿಗೂ ನಿನ್ನಲ್ಲಿ ಫಲವು ಬಾರದಿರಲಿ,” ಎಂದರು. ತಕ್ಷಣವೇ ಅಂಜೂರದ ಮರವು ಒಣಗಿ ಹೋಯಿತು.<verse eid="MAT 21:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 21:20"/>ಶಿಷ್ಯರು ಅದನ್ನು ಕಂಡು ಆಶ್ಚರ್ಯದಿಂದ, “ಇಷ್ಟು ಬೇಗನೆ ಈ ಅಂಜೂರದ ಮರವು ಒಣಗಿಹೋಯಿತಲ್ಲಾ?” ಎಂದು ಕೇಳಿದರು.<verse eid="MAT 21:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 21:21"/>ಯೇಸು ಉತ್ತರವಾಗಿ ಅವರಿಗೆ, “ನಾನು ನಿಮಗೆ ನಿಜವಾಗಿ ಹೇಳುತ್ತೇನೆ: ಸಂದೇಹ ಪಡದೆ ನಂಬಿದರೆ, ನಾನು ಈ ಅಂಜೂರದ ಮರಕ್ಕೆ ಮಾಡಿದಂತೆಯೇ ನೀವೂ ಮಾಡುವಿರಿ. ಇದಲ್ಲದೆ ನೀವು ಈ ಬೆಟ್ಟಕ್ಕೆ, ‘ನೀನು ಕಿತ್ತುಕೊಂಡು ಹೋಗಿ ಸಮುದ್ರದಲ್ಲಿ ಬೀಳು’ ಎಂದು ಹೇಳಿದರೂ ಅದು ಹಾಗೆಯೇ ಆಗುವುದು. <verse eid="MAT 21:21"/><verse number="22" style="v" sid="MAT 21:22"/>ನೀವು ನಂಬಿಕೆಯಿಂದ ಪ್ರಾರ್ಥನೆಯಲ್ಲಿ ಏನೇನು ಬೇಡಿಕೊಳ್ಳುವಿರೋ ಅವುಗಳನ್ನೆಲ್ಲಾ ಪಡೆಯುವಿರಿ,” ಎಂದರು.<verse eid="MAT 21:22"/></para>
  <para style="s1">ಯೇಸುವಿನ ಅಧಿಕಾರವನ್ನು ಪ್ರಶ್ನೆ ಮಾಡಿದ್ದು</para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 21:23"/>ಅನಂತರ ಯೇಸು ದೇವಾಲಯಕ್ಕೆ ಬಂದು ಬೋಧಿಸುತ್ತಿದ್ದಾಗ, ಮುಖ್ಯಯಾಜಕರೂ ಜನರ ಹಿರಿಯರೂ ಯೇಸುವಿನ ಬಳಿಗೆ ಬಂದು, “ಯಾವ ಅಧಿಕಾರದಿಂದ ನೀನು ಇವುಗಳನ್ನು ಮಾಡುತ್ತೀ? ಈ ಅಧಿಕಾರವನ್ನು ನಿನಗೆ ಕೊಟ್ಟವರು ಯಾರು?” ಎಂದು ಕೇಳಿದರು.<verse eid="MAT 21:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 21:24"/>ಅದಕ್ಕೆ ಯೇಸು, “ನಾನು ಸಹ ನಿಮಗೆ ಒಂದು ಪ್ರಶ್ನೆಯನ್ನು ಕೇಳುತ್ತೇನೆ; ಅದಕ್ಕೆ ನೀವು ನನಗೆ ಉತ್ತರ ಹೇಳಿದರೆ ನಾನು ಯಾವ ಅಧಿಕಾರದಿಂದ ಇವುಗಳನ್ನು ಮಾಡುತ್ತೇನೆಂದು ನಿಮಗೆ ಹೇಳುತ್ತೇನೆ. ಎಂದು ಹೇಳಿ, <verse eid="MAT 21:24"/><verse number="25" style="v" sid="MAT 21:25"/>ದೀಕ್ಷಾಸ್ನಾನ ಕೊಡುವ ಅಧಿಕಾರವು ಯೋಹಾನನಿಗೆ ಎಲ್ಲಿಂದ ಬಂತು? ಪರಲೋಕದಿಂದಲೋ ಇಲ್ಲವೆ ಮನುಷ್ಯರಿಂದಲೋ?” ಎಂದು ಕೇಳಿದ್ದಕ್ಕೆ,</para>
  <para style="p" vid="MAT 21:25">ಅವರು ತಮ್ಮತಮ್ಮೊಳಗೆ ತರ್ಕಿಸುತ್ತಾ, “ಪರಲೋಕದಿಂದ ಎಂದು ನಾವು ಹೇಳಿದರೆ, ‘ನೀವು ಏಕೆ ಅವನನ್ನು ನಂಬಲಿಲ್ಲ?’ ಎಂದು ಕೇಳುವರು. <verse eid="MAT 21:25"/><verse number="26" style="v" sid="MAT 21:26"/>‘ಮನುಷ್ಯರಿಂದ ಬಂತು,’ ಎಂದು ಹೇಳಿದರೆ ಜನರಿಗೆ ನಾವು ಭಯಪಡಬೇಕಾಗಿದೆ. ಏಕೆಂದರೆ ಯೋಹಾನನು ಪ್ರವಾದಿಯೆಂದು ಎಲ್ಲರೂ ಗೌರವಿಸುತ್ತಾರೆ,” ಎಂದುಕೊಂಡರು.<verse eid="MAT 21:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 21:27"/>ತರುವಾಯ ಅವರು ಯೇಸುವಿಗೆ, “ನಮಗೆ ಗೊತ್ತಿಲ್ಲ” ಎಂದರು.</para>
  <para style="p" vid="MAT 21:27">ಅದಕ್ಕೆ ಯೇಸು ಅವರಿಗೆ, “ನಾನು ಸಹ ಯಾವ ಅಧಿಕಾರದಿಂದ ಇವುಗಳನ್ನು ಮಾಡುತ್ತೇನೆಂದು ನಿಮಗೆ ಹೇಳುವುದಿಲ್ಲ,” ಎಂದರು.<verse eid="MAT 21:27"/></para>
  <para style="s1">ಇಬ್ಬರು ಪುತ್ರರ ಸಾಮ್ಯ</para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 21:28"/>ಅನಂತರ ಯೇಸು, “ನಿಮಗೇನು ಅನಿಸುತ್ತದೆ? ಒಬ್ಬ ಮನುಷ್ಯನಿಗೆ ಇಬ್ಬರು ಮಕ್ಕಳಿದ್ದರು. ಅವನು ಮೊದಲನೆಯವನ ಬಳಿಗೆ ಬಂದು, ‘ಮಗನೇ, ಹೋಗಿ ಈ ಹೊತ್ತು ನನ್ನ ದ್ರಾಕ್ಷಿಯ ತೋಟದಲ್ಲಿ ಕೆಲಸ ಮಾಡು,’ ಎಂದು ಹೇಳಿದನು.<verse eid="MAT 21:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 21:29"/>“ಮಗನು ಉತ್ತರವಾಗಿ, ‘ನಾನು ಹೋಗುವುದಿಲ್ಲ’ ಎಂದು ಹೇಳಿ, ಅನಂತರ ಪಶ್ಚಾತ್ತಾಪಪಟ್ಟು ತೋಟಕ್ಕೆ ಹೋದನು.<verse eid="MAT 21:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="MAT 21:30"/>“ಆಮೇಲೆ ತಂದೆ ಎರಡನೆಯವನ ಬಳಿಗೆ ಬಂದು ಅದೇ ಪ್ರಕಾರ ಅವನಿಗೆ ಹೇಳಿದನು. ಅದಕ್ಕವನು ಉತ್ತರವಾಗಿ, ‘ಅಪ್ಪಾ, ನಾನು ಹೋಗುತ್ತೇನೆ,’ ಎಂದು ಹೇಳಿದರೂ ಹೋಗಲಿಲ್ಲ.<verse eid="MAT 21:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 21:31"/>“ಈ ಇಬ್ಬರಲ್ಲಿ ಯಾವನು ತನ್ನ ತಂದೆಯ ಇಷ್ಟದಂತೆ ನಡೆದವನು?” ಎಂದು ಕೇಳಲು ಅವರು ಯೇಸುವಿಗೆ,</para>
  <para style="p" vid="MAT 21:31">“ಮೊದಲನೆಯವನೇ,” ಎಂದರು.</para>
  <para style="p" vid="MAT 21:31">ಆಗ ಯೇಸು ಅವರಿಗೆ, “ಸುಂಕದವರೂ ವೇಶ್ಯೆಯರೂ ನಿಮಗಿಂತ ಮೊದಲು ದೇವರ ರಾಜ್ಯದೊಳಗೆ ಸೇರುವರೆಂದು ನಿಮಗೆ ನಿಜವಾಗಿ ಹೇಳುತ್ತೇನೆ. <verse eid="MAT 21:31"/><verse number="32" style="v" sid="MAT 21:32"/>ಏಕೆಂದರೆ ಯೋಹಾನನು ನೀತಿ ಮಾರ್ಗದೊಡನೆ ನಿಮ್ಮ ಬಳಿಗೆ ಬಂದನು. ನೀವು ಅವನನ್ನು ನಂಬಲಿಲ್ಲ. ಆದರೆ ಸುಂಕದವರೂ ವೇಶ್ಯೆಯರೂ ಅವನನ್ನು ನಂಬಿದರು. ನೀವು ಇದನ್ನು ಕಂಡ ಮೇಲೆಯೂ ಅವನನ್ನು ನಂಬುವಂತೆ ಪಶ್ಚಾತ್ತಾಪ ಪಡಲಿಲ್ಲ.”<verse eid="MAT 21:32"/></para>
  <para style="s1">ಗೇಣಿಗೆದಾರರ ಸಾಮ್ಯ</para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 21:33"/>“ಮತ್ತೊಂದು ಸಾಮ್ಯವನ್ನು ಕೇಳಿರಿ: ಒಬ್ಬ ಯಜಮಾನನು ದ್ರಾಕ್ಷಿಯ ತೋಟವನ್ನು ಮಾಡಿ ಅದರ ಸುತ್ತಲೂ ಬೇಲಿ ಹಾಕಿದನು. ಅದರೊಳಗೆ ದ್ರಾಕ್ಷಾರಸವನ್ನು ತೆಗೆಯಲು ಆಲೆಯನ್ನು ಅಗೆದು ಕಾವಲುಗೋಪುರವನ್ನು ಕಟ್ಟಿ ರೈತರಿಗೆ ಗೇಣಿಗೆ ಕೊಟ್ಟು ದೂರದೇಶಕ್ಕೆ ಹೋದನು. <verse eid="MAT 21:33"/><verse number="34" style="v" sid="MAT 21:34"/>ಫಲದ ಕಾಲ ಸಮೀಪಿಸಿದಾಗ, ತನ್ನ ಫಲಗಳನ್ನು ಪಡೆದುಕೊಳ್ಳುವುದಕ್ಕೆ ತನ್ನ ಸೇವಕರನ್ನು ಗೇಣಿಗೆದಾರರ ಬಳಿಗೆ ಕಳುಹಿಸಿದನು.<verse eid="MAT 21:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="MAT 21:35"/>“ಆಗ ಗೇಣಿಗೆದಾರರು ಅವನ ಸೇವಕರನ್ನು ಹಿಡಿದು ಒಬ್ಬನನ್ನು ಹೊಡೆದು, ಇನ್ನೊಬ್ಬನನ್ನು ಕೊಂದುಹಾಕಿದರು. ಮತ್ತೊಬ್ಬನ ಮೇಲೆ ಕಲ್ಲೆಸೆದರು. <verse eid="MAT 21:35"/><verse number="36" style="v" sid="MAT 21:36"/>ಯಜಮಾನನು ಮೊದಲನೆಯವರಿಗಿಂತ ಹೆಚ್ಚು ಸೇವಕರನ್ನು ಕಳುಹಿಸಿಕೊಟ್ಟನು. ಗೇಣಿಗೆದಾರರು ಅವರಿಗೂ ಹಾಗೆಯೇ ಮಾಡಿದರು. <verse eid="MAT 21:36"/><verse number="37" style="v" sid="MAT 21:37"/>ಕೊನೆಗೆ ಯಜಮಾನನು, ‘ಅವರು ನನ್ನ ಮಗನಿಗಾದರೂ ಮರ್ಯಾದೆ ಕೊಡುವರು’ ಎಂದುಕೊಂಡು ತನ್ನ ಮಗನನ್ನು ಅವರ ಬಳಿಗೆ ಕಳುಹಿಸಿದನು.<verse eid="MAT 21:37"/></para>
  <para style="p">
    <verse number="38" style="v" sid="MAT 21:38"/>“ಆದರೆ ಗೇಣಿಗೆದಾರರು ಆ ಮಗನನ್ನು ನೋಡಿ ತಮ್ಮತಮ್ಮೊಳಗೆ, ‘ಇವನೇ ಬಾಧ್ಯಸ್ಥನು. ಬನ್ನಿರಿ, ನಾವು ಇವನನ್ನು ಕೊಂದು ಇವನ ಆಸ್ತಿಯನ್ನು ಕಿತ್ತುಕೊಳ್ಳೋಣ,’ ಎಂದುಕೊಂಡು, <verse eid="MAT 21:38"/><verse number="39" style="v" sid="MAT 21:39"/>ಅವನನ್ನು ಹಿಡಿದು ದ್ರಾಕ್ಷಿಯ ತೋಟದಿಂದ ಹೊರಗೆ ಹಾಕಿ ಅವನನ್ನು ಕೊಂದುಹಾಕಿದರು.<verse eid="MAT 21:39"/></para>
  <para style="p">
    <verse number="40" style="v" sid="MAT 21:40"/>“ಹೀಗಿರುವುದರಿಂದ ದ್ರಾಕ್ಷಿತೋಟದ ಯಜಮಾನನೇ ಬಂದಾಗ, ಆ ಗೇಣಿಗೆದಾರರಿಗೆ ಏನು ಮಾಡುವನು?” ಎಂದು ಯೇಸು ಕೇಳಲು,<verse eid="MAT 21:40"/></para>
  <para style="p">
    <verse number="41" style="v" sid="MAT 21:41"/>ಮುಖ್ಯಯಾಜಕರೂ ಜನರ ಹಿರಿಯರೂ ಯೇಸುವಿಗೆ, “ಅವನು ಆ ದುಷ್ಟ ಮನುಷ್ಯರನ್ನು ಕ್ರೂರವಾಗಿ ಸಂಹರಿಸುವನು. ತಕ್ಕ ಕಾಲದಲ್ಲಿ ತನಗೆ ಫಲಗಳನ್ನು ಸಲ್ಲಿಸುವ ಬೇರೆ ಗೇಣಿಗೆದಾರರಿಗೆ ತನ್ನ ದ್ರಾಕ್ಷಿತೋಟವನ್ನು ಗೇಣಿಗೆ ಕೊಡುವನು,” ಎಂದು ಹೇಳಿದರು.<verse eid="MAT 21:41"/></para>
  <para style="p">
    <verse number="42" style="v" sid="MAT 21:42"/>ಯೇಸು ಅವರಿಗೆ,</para>
  <para style="q1" vid="MAT 21:42">“ ‘ಮನೆ ಕಟ್ಟುವವರು ತಿರಸ್ಕರಿಸಿದ ಕಲ್ಲೇ</para>
  <para style="q2" vid="MAT 21:42">ಮುಖ್ಯವಾದ ಮೂಲೆಗಲ್ಲಾಯಿತು.</para>
  <para style="q1" vid="MAT 21:42">ಇದು ಕರ್ತನಿಂದಲೇ ಆಯಿತು.</para>
  <para style="q2" vid="MAT 21:42">ಇದು ನಮ್ಮ ದೃಷ್ಟಿಯಲ್ಲಿ ಆಶ್ಚರ್ಯವಾಗಿ ತೋರುತ್ತದೆ,’<note caller="+" style="f"><char style="fr" closed="false">21:42 </char><char style="ft" closed="false"><char style="xt"><ref loc="PSA 118:22">ಕೀರ್ತನೆ 118:22</ref>,<ref loc="PSA 118:23">23</ref></char></char></note></para>
  <para style="m" vid="MAT 21:42">ಎಂಬುದನ್ನು ನೀವು ಪವಿತ್ರ ವೇದದಲ್ಲಿ ಎಂದೂ ಓದಲಿಲ್ಲವೇ?<verse eid="MAT 21:42"/></para>
  <para style="p">
    <verse number="43" style="v" sid="MAT 21:43"/>“ಆದ್ದರಿಂದ, ದೇವರ ರಾಜ್ಯವು ನಿಮ್ಮಿಂದ ಕಿತ್ತುಕೊಂಡು ತಕ್ಕ ಫಲಕೊಡುವ ಜನರಿಗೆ ಕೊಡಲಾಗುವುದು ಎಂದು ನಾನು ನಿಮಗೆ ಹೇಳುತ್ತೇನೆ. <verse eid="MAT 21:43"/><verse number="44" style="v" sid="MAT 21:44"/>ಈ ಕಲ್ಲಿನ ಮೇಲೆ ಬೀಳುವವನು ತುಂಡುತುಂಡಾಗುವನು, ಆದರೆ ಇದೇ ಕಲ್ಲು ಯಾವನ ಮೇಲೆ ಬೀಳುವುದೋ ಅವನನ್ನು ಅದು ಜಜ್ಜಿ ಹೋಗುವಂತೆ ಮಾಡುವುದು,” ಎಂದರು.<verse eid="MAT 21:44"/></para>
  <para style="p">
    <verse number="45" style="v" sid="MAT 21:45"/>ಮುಖ್ಯಯಾಜಕರೂ ಫರಿಸಾಯರೂ ಯೇಸುವಿನ ಸಾಮ್ಯಗಳನ್ನು ಕೇಳಿದಾಗ, ತಮ್ಮ ವಿಷಯದಲ್ಲಿಯೇ ಅದನ್ನು ಹೇಳಿದರೆಂದು ಅರ್ಥಮಾಡಿಕೊಂಡರು. <verse eid="MAT 21:45"/><verse number="46" style="v" sid="MAT 21:46"/>ಅವರು ಯೇಸುವನ್ನು ಹಿಡಿಯುವುದಕ್ಕೆ ಪ್ರಯತ್ನಿಸಿದರು. ಆದರೂ ಜನಸಮೂಹಕ್ಕೆ ಭಯಪಟ್ಟರು. ಏಕೆಂದರೆ ಜನರು ಯೇಸುವನ್ನು ಪ್ರವಾದಿಯೆಂದು ನಂಬಿದ್ದರು.<verse eid="MAT 21:46"/></para>
  <chapter eid="MAT 21"/>
  <chapter number="22" style="c" sid="MAT 22"/>
  <para style="s1">ಮದುವೆ ಔತಣದ ಸಾಮ್ಯ</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 22:1"/>ಯೇಸು ಪುನಃ ಸಾಮ್ಯಗಳ ಮೂಲಕ ಅವರ ಕೂಡ ಮಾತನಾಡುತ್ತಾ: <verse eid="MAT 22:1"/><verse number="2" style="v" sid="MAT 22:2"/>“ಪರಲೋಕ ರಾಜ್ಯವು ಮಗನ ಮದುವೆ ಮಾಡಿದ ಒಬ್ಬ ಅರಸನಿಗೆ ಹೋಲಿಕೆಯಾಗಿದೆ. <verse eid="MAT 22:2"/><verse number="3" style="v" sid="MAT 22:3"/>ಅವನು ಮದುವೆಗೆ ಆಹ್ವಾನಿತರಾಗಿದ್ದವರನ್ನು ಕರೆಯುವುದಕ್ಕೆ ತನ್ನ ಸೇವಕರನ್ನು ಕಳುಹಿಸಿದನು. ಆದರೆ ಅವರು ಬರಲು ಒಪ್ಪಲಿಲ್ಲ.<verse eid="MAT 22:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 22:4"/>“ಅವನು ಪುನಃ ಬೇರೆ ಸೇವಕರನ್ನು ಕಳುಹಿಸಿ ಅವರಿಗೆ, ‘ಇಗೋ ಔತಣವು ಸಿದ್ಧವಾಗಿದೆ. ಶ್ರೇಷ್ಠ ಔತಣ ಮಾಡಿಸಿದ್ದೇನೆ: ಎಲ್ಲವೂ ಸಿದ್ಧವಾಗಿವೆ. ಮದುವೆಗೆ ಬನ್ನಿರಿ ಎಂದು ಆಹ್ವಾನಿತರಿಗೆ ಹೇಳಿರಿ,’ ಎಂದನು.<verse eid="MAT 22:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 22:5"/>“ಆದರೆ ಅವರು ಅದನ್ನು ಅಲಕ್ಷ್ಯಮಾಡಿ, ಒಬ್ಬನು ತನ್ನ ಹೊಲಕ್ಕೂ ಇನ್ನೊಬ್ಬನು ತನ್ನ ವ್ಯಾಪಾರಕ್ಕೂ ಹೊರಟು ಹೋದರು. <verse eid="MAT 22:5"/><verse number="6" style="v" sid="MAT 22:6"/>ಉಳಿದವರು ಅವನ ಸೇವಕರನ್ನು ಹಿಡಿದು ಅವಮಾನಪಡಿಸಿ, ಅವರನ್ನು ಕೊಂದುಹಾಕಿದರು. <verse eid="MAT 22:6"/><verse number="7" style="v" sid="MAT 22:7"/>ಆದರೆ ಅರಸನು ಅದನ್ನು ಕೇಳಿ ಬಹುಕೋಪಗೊಂಡು ತನ್ನ ಸೈನ್ಯಗಳನ್ನು ಕಳುಹಿಸಿ ಆ ಕೊಲೆಗಾರರನ್ನು ಸಂಹರಿಸಿ ಅವರ ಪಟ್ಟಣವನ್ನು ಸುಟ್ಟುಬಿಟ್ಟನು.<verse eid="MAT 22:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 22:8"/>“ತರುವಾಯ ಅವನು ತನ್ನ ಸೇವಕರಿಗೆ, ‘ಮದುವೆಯ ಔತಣ ಸಿದ್ಧವಾಗಿದೆ, ಆದರೆ ಆಹ್ವಾನಿತರು ಸಿದ್ಧರಾಗಿರಲಿಲ್ಲ. <verse eid="MAT 22:8"/><verse number="9" style="v" sid="MAT 22:9"/>ಆದ್ದರಿಂದ ನೀವು ಮುಖ್ಯ ಬೀದಿಗಳಿಗೆ ಹೊರಟುಹೋಗಿ ಅಲ್ಲಿ ಕಂಡವರನ್ನೆಲ್ಲಾ ಮದುವೆಗೆ ಆಹ್ವಾನಿಸಿರಿ,’ ಎಂದನು. <verse eid="MAT 22:9"/><verse number="10" style="v" sid="MAT 22:10"/>ಆಗ ಆ ಸೇವಕರು ಮುಖ್ಯ ಬೀದಿಗಳಿಗೆ ಹೋಗಿ ತಾವು ಕಂಡ ಕೆಟ್ಟವರನ್ನೂ ಒಳ್ಳೆಯವರನ್ನೂ ಕರೆತಂದರು. ಹೀಗೆ ಮದುವೆ ಮಂಟಪವು ಅತಿಥಿಗಳಿಂದ ತುಂಬಿಹೋಯಿತು.<verse eid="MAT 22:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 22:11"/>“ಅನಂತರ ಅರಸನು ಅತಿಥಿಗಳನ್ನು ನೋಡುವುದಕ್ಕಾಗಿ ಒಳಗೆ ಬಂದಾಗ, ಅಲ್ಲಿ ಮದುವೆಯ ವಸ್ತ್ರವಿಲ್ಲದೆ ಇದ್ದ ಒಬ್ಬ ಮನುಷ್ಯನನ್ನು ಕಂಡನು. <verse eid="MAT 22:11"/><verse number="12" style="v" sid="MAT 22:12"/>ಅರಸನು ಆ ಮನುಷ್ಯನಿಗೆ, ‘ಸ್ನೇಹಿತನೇ, ಮದುವೆಯ ವಸ್ತ್ರವಿಲ್ಲದೆ ನೀನು ಒಳಗೆ ಹೇಗೆ ಬಂದೆ?’ ಎಂದು ಕೇಳಲು ಅವನು ಸುಮ್ಮನಿದ್ದನು.<verse eid="MAT 22:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 22:13"/>“ಆಗ ಅರಸನು ಸೇವಕರಿಗೆ, ‘ಅವನ ಕೈಕಾಲುಗಳನ್ನು ಕಟ್ಟಿ ತೆಗೆದುಕೊಂಡು ಹೊರಗೆ ಕತ್ತಲೆಯಲ್ಲಿ ಹಾಕಿರಿ. ಅಲ್ಲಿ ಹಲ್ಲು ಕಡಿಯುತ್ತಾ ಗೋಳಾಡುತ್ತಿರಲಿ,’ ಎಂದು ಹೇಳಿದನು.<verse eid="MAT 22:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 22:14"/>“ಹೀಗೆಯೇ ಆಹ್ವಾನಿತರಾದವರು ಅನೇಕರು, ಆದರೆ ಆಯ್ಕೆಯಾದವರು ಕೆಲವರು ಮಾತ್ರ,” ಎಂದನು.<verse eid="MAT 22:14"/></para>
  <para style="s1">ಚಕ್ರವರ್ತಿಗೆ ತೆರಿಗೆ ಕೊಡುವುದು</para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 22:15"/>ಆಗ ಫರಿಸಾಯರು ಹೊರಟುಹೋಗಿ ಯೇಸುವನ್ನು ಮಾತಿನಲ್ಲಿ ಹೇಗೆ ಸಿಕ್ಕಿಸಬೇಕೆಂದು ಆಲೋಚನೆ ಮಾಡಿಕೊಂಡರು. <verse eid="MAT 22:15"/><verse number="16" style="v" sid="MAT 22:16"/>ಅವರು ತಮ್ಮ ಶಿಷ್ಯರನ್ನು ಹೆರೋದ್ಯರೊಂದಿಗೆ<note caller="+" style="f"><char style="fr" closed="false">22:16 </char><char style="ft" closed="false">ಈ ಜನರು ಹೆರೋದನ ತಲೆಮಾರಿನವರು ಮತ್ತು ರೋಮನ್ನರ ಆಳ್ವಿಕೆ ಬಯಸುವವರಾಗಿದ್ದರು</char></note> ಯೇಸುವಿನ ಬಳಿಗೆ ಕಳುಹಿಸಿ, “ಬೋಧಕರೇ, ನೀವು ಸತ್ಯವಂತರು, ದೇವರ ಮಾರ್ಗವನ್ನು ಸತ್ಯದಿಂದಲೇ ಬೋಧಿಸುವವರು, ನೀವು ಯಾರನ್ನೂ ಲಕ್ಷ್ಯ ಮಾಡುವವರಲ್ಲ, ನೀವು ಮುಖದಾಕ್ಷಿಣ್ಯ ಮಾಡುವವರೂ ಅಲ್ಲ ಎಂದು ನಮಗೆ ಗೊತ್ತಿದೆ. <verse eid="MAT 22:16"/><verse number="17" style="v" sid="MAT 22:17"/>ಆದ್ದರಿಂದ ಕೈಸರನಿಗೆ ತೆರಿಗೆ<note caller="+" style="f"><char style="fr" closed="false">22:17 </char><char style="ft" closed="false">ರೋಮನವರು ಅಲ್ಲದವರು ತೆರಿಗೆ ಕಟ್ಟಬೇಕಾಗಿತ್ತು.</char></note> ಕೊಡುವುದು ಧರ್ಮಸಮ್ಮತವೋ ಅಲ್ಲವೋ? ನಿಮ್ಮ ಅಭಿಪ್ರಾಯವೇನು? ನಮಗೆ ಹೇಳು,” ಎಂದರು.<verse eid="MAT 22:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 22:18"/>ಯೇಸು ಅವರ ಕುಯುಕ್ತಿಯನ್ನು ತಿಳಿದುಕೊಂಡು, “ಕಪಟಿಗಳೇ, ನೀವು ನನ್ನನ್ನೇಕೆ ಪರೀಕ್ಷಿಸುತ್ತೀರಿ? <verse eid="MAT 22:18"/><verse number="19" style="v" sid="MAT 22:19"/>ತೆರಿಗೆಯ ನಾಣ್ಯವನ್ನು ನನಗೆ ತೋರಿಸಿರಿ,” ಎಂದರು. ಆಗ ಅವರು ಒಂದು ನಾಣ್ಯವನ್ನು ತಂದು ಕೊಟ್ಟರು. <verse eid="MAT 22:19"/><verse number="20" style="v" sid="MAT 22:20"/>ಯೇಸು ಅವರಿಗೆ, “ಇದರ ಮುಖ ಮುದ್ರೆಯು ಮತ್ತು ಇದರ ಮೇಲಿರುವ ಲಿಪಿ ಯಾರದು?” ಎಂದು ಕೇಳಿದರು.<verse eid="MAT 22:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 22:21"/>ಅದಕ್ಕೆ ಅವರು, “ಕೈಸರನದು,” ಎಂದರು.</para>
  <para style="p" vid="MAT 22:21">ಆಗ ಯೇಸು, “ಕೈಸರನಿಗೆ ಸಲ್ಲತಕ್ಕದ್ದನ್ನು ಕೈಸರನಿಗೂ ದೇವರಿಗೆ ಸಲ್ಲತಕ್ಕದ್ದನ್ನು ದೇವರಿಗೂ ಕೊಡಿರಿ,” ಎಂದರು.<verse eid="MAT 22:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 22:22"/>ಅವರು ಇದನ್ನು ಕೇಳಿ ಆಶ್ಚರ್ಯಪಟ್ಟು, ಯೇಸುವನ್ನು ಬಿಟ್ಟು ಹೊರಟು ಹೋದರು.<verse eid="MAT 22:22"/></para>
  <para style="s1">ಪುನರುತ್ಥಾನದಲ್ಲಿ ಮದುವೆ ಬಗ್ಗೆ ಪ್ರಶ್ನೆ</para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 22:23"/>ಪುನರುತ್ಥಾನವಿಲ್ಲವೆಂದು ಹೇಳುವ ಸದ್ದುಕಾಯರು ಅದೇ ದಿನದಲ್ಲಿ ಯೇಸುವಿನ ಬಳಿಗೆ ಬಂದು, <verse eid="MAT 22:23"/><verse number="24" style="v" sid="MAT 22:24"/>“ಬೋಧಕರೇ, ಒಬ್ಬನು ಮಕ್ಕಳಿಲ್ಲದೆ ಸತ್ತರೆ, ಅವನ ತಮ್ಮನು ವಿಧವೆಯನ್ನು ಮದುವೆಯಾಗಿ ತನ್ನ ಅಣ್ಣನಿಗೆ ಸಂತಾನವನ್ನು ಪಡೆಯಬೇಕೆಂದು ಮೋಶೆಯು ಹೇಳಿದ್ದಾನೆ. <verse eid="MAT 22:24"/><verse number="25" style="v" sid="MAT 22:25"/>ಹೀಗಿರಲಾಗಿ ನಮ್ಮಲ್ಲಿ ಏಳುಮಂದಿ ಸಹೋದರರಿದ್ದರು. ಮೊದಲನೆಯವನು ಮದುವೆಮಾಡಿಕೊಂಡು ಸತ್ತನು. ಸಂತಾನವಿಲ್ಲದ ಕಾರಣ ತನ್ನ ಹೆಂಡತಿಯನ್ನು ತನ್ನ ತಮ್ಮನಿಗೆ ಬಿಟ್ಟನು. <verse eid="MAT 22:25"/><verse number="26" style="v" sid="MAT 22:26"/>ಅದರಂತೆಯೇ ಎರಡನೆಯವನು ಮತ್ತು ಮೂರನೆಯವನು ಹೀಗೆ ಏಳನೆಯವನವರೆಗೂ ಸಂಭವಿಸಿತು. <verse eid="MAT 22:26"/><verse number="27" style="v" sid="MAT 22:27"/>ಕಡೆಯದಾಗಿ, ಆ ಸ್ತ್ರೀಯೂ ಸತ್ತಳು. <verse eid="MAT 22:27"/><verse number="28" style="v" sid="MAT 22:28"/>ಆದ್ದರಿಂದ, ಪುನರುತ್ಥಾನದ ಜೀವನದಲ್ಲಿ, ಆ ಏಳುಮಂದಿಯಲ್ಲಿ ಆಕೆ ಯಾರಿಗೆ ಹೆಂಡತಿಯಾಗಿರುವಳು? ಏಕೆಂದರೆ ಅವರೆಲ್ಲರೂ ಆಕೆಯನ್ನು ಮದುವೆ ಮಾಡಿಕೊಂಡಿದ್ದರಲ್ಲಾ?” ಎಂದು ಕೇಳಿದರು.<verse eid="MAT 22:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 22:29"/>ಅದಕ್ಕೆ ಯೇಸು ಉತ್ತರವಾಗಿ, “ನೀವು ಪವಿತ್ರ ವೇದವನ್ನಾಗಲಿ ದೇವರ ಶಕ್ತಿಯನ್ನಾಗಲಿ ಅರ್ಥ ಮಾಡಿಕೊಳ್ಳದೆ ತಪ್ಪುತ್ತಿದ್ದೀರಿ. <verse eid="MAT 22:29"/><verse number="30" style="v" sid="MAT 22:30"/>ಏಕೆಂದರೆ ಪುನರುತ್ಥಾನದ ಜೀವನದಲ್ಲಿ ಅವರು ಮದುವೆಮಾಡಿಕೊಳ್ಳುವುದೂ ಇಲ್ಲ, ಮದುವೆಮಾಡಿಕೊಡುವುದೂ ಇಲ್ಲ. ಆದರೆ ಅವರು ಪರಲೋಕದಲ್ಲಿರುವ ದೇವದೂತರಂತೆ ಇರುತ್ತಾರೆ. <verse eid="MAT 22:30"/><verse number="31" style="v" sid="MAT 22:31"/>ಆದರೆ ಸತ್ತವರ ಪುನರುತ್ಥಾನದ ವಿಷಯವಾಗಿ, <verse eid="MAT 22:31"/><verse number="32" style="v" sid="MAT 22:32"/>‘ನಾನು ಅಬ್ರಹಾಮನ ದೇವರು, ಇಸಾಕನ ದೇವರು ಮತ್ತು ಯಾಕೋಬನ ದೇವರು ಆಗಿದ್ದೇನೆ,’<note caller="+" style="f"><char style="fr" closed="false">22:32 </char><char style="ft" closed="false"><char style="xt"><ref loc="EXO 3:6">ವಿಮೋ 3:6</ref></char></char></note> ಎಂದು ದೇವರು ನಿಮಗೆ ಹೇಳಿದ್ದನ್ನು ನೀವು ಓದಲಿಲ್ಲವೋ? ದೇವರು ಜೀವಿತರಿಗೆ ದೇವರಾಗಿದ್ದಾರೆ ಹೊರತು ಸತ್ತವರಿಗಲ್ಲ,” ಎಂದು ಹೇಳಿದರು.<verse eid="MAT 22:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 22:33"/>ಜನಸಮೂಹದವರು ಇದನ್ನು ಕೇಳಿದಾಗ, ಯೇಸುವಿನ ಬೋಧನೆಗೆ ವಿಸ್ಮಯಗೊಂಡರು.<verse eid="MAT 22:33"/></para>
  <para style="s1">ಮಹಾ ಆಜ್ಞೆ</para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 22:34"/>ಯೇಸು ಸದ್ದುಕಾಯರ ಬಾಯನ್ನು ಮುಚ್ಚಿದನೆಂದು ಫರಿಸಾಯರು ಕೇಳಿದಾಗ ಅವರು ಯೇಸುವಿನ ಬಳಿಗೆ ಬಂದರು. <verse eid="MAT 22:34"/><verse number="35" style="v" sid="MAT 22:35"/>ಅವರಲ್ಲಿ ಮೋಶೆಯ ನಿಯಮ ಬೋಧಕನಾಗಿದ್ದ ಒಬ್ಬನು, ಯೇಸುವನ್ನು ಪರೀಕ್ಷಿಸುವುದಕ್ಕಾಗಿ, <verse eid="MAT 22:35"/><verse number="36" style="v" sid="MAT 22:36"/>“ಬೋಧಕರೇ, ನಿಯಮದಲ್ಲಿ ಅತ್ಯಂತ ಮಹಾ ಆಜ್ಞೆ ಯಾವುದು?” ಎಂದು ಪ್ರಶ್ನಿಸಿದನು.<verse eid="MAT 22:36"/></para>
  <para style="p">
    <verse number="37" style="v" sid="MAT 22:37"/>ಯೇಸು ಅವನಿಗೆ, “ ‘ನೀನು ನಿನ್ನ ದೇವರಾದ ಕರ್ತನನ್ನು ನಿನ್ನ ಪೂರ್ಣಹೃದಯದಿಂದಲೂ ಪೂರ್ಣಪ್ರಾಣದಿಂದಲೂ ಪೂರ್ಣಮನಸ್ಸಿನಿಂದಲೂ ಪ್ರೀತಿಸಬೇಕು.’<note caller="+" style="f"><char style="fr" closed="false">22:37 </char><char style="ft" closed="false"><char style="xt"><ref loc="DEU 6:5">ಧರ್ಮೋ 6:5</ref></char></char></note> <verse eid="MAT 22:37"/><verse number="38" style="v" sid="MAT 22:38"/>ಇದೇ ಅತ್ಯಂತ ಮಹಾ ಆಜ್ಞೆಯೂ ಮೊದಲನೆಯ ಆಜ್ಞೆಯೂ ಆಗಿದೆ. <verse eid="MAT 22:38"/><verse number="39" style="v" sid="MAT 22:39"/>ಇದರಂತೆಯೇ ಇರುವ ಎರಡನೆಯ ಆಜ್ಞೆಯು: ‘ನಿನ್ನ ನೆರೆಯವನನ್ನು ನಿನ್ನಂತೆಯೇ ಪ್ರೀತಿಸಬೇಕು’<note caller="+" style="f"><char style="fr" closed="false">22:39 </char><char style="ft" closed="false"><char style="xt"><ref loc="LEV 19:18">ಯಾಜಕ 19:18</ref></char></char></note> ಎಂಬುದೇ. <verse eid="MAT 22:39"/><verse number="40" style="v" sid="MAT 22:40"/>ಇಡೀ ನಿಯಮವೂ ಪ್ರವಾದಿಗಳ ಗ್ರಂಥಗಳೂ ಈ ಎರಡು ಆಜ್ಞೆಗಳ ಮೇಲೆ ಆಧಾರಗೊಂಡಿವೆ,” ಎಂದರು.<verse eid="MAT 22:40"/></para>
  <para style="s1">ಕ್ರಿಸ್ತನು ಯಾರ ಪುತ್ರನು</para>
  <para style="p">
    <verse number="41" style="v" sid="MAT 22:41"/>ಫರಿಸಾಯರು ಕೂಡಿಬಂದಿದ್ದಾಗ ಯೇಸು ಅವರಿಗೆ, <verse eid="MAT 22:41"/><verse number="42" style="v" sid="MAT 22:42"/>“ಕ್ರಿಸ್ತನ ವಿಷಯವಾಗಿ ನಿಮ್ಮ ಅಭಿಪ್ರಾಯವೇನು? ಆತನು ಯಾರ ಪುತ್ರನು?” ಎಂದು ಕೇಳಿದ್ದಕ್ಕೆ ಅವರು ಯೇಸುವಿಗೆ,</para>
  <para style="p" vid="MAT 22:42">“ದಾವೀದನ ಪುತ್ರನು,” ಎಂದರು.<verse eid="MAT 22:42"/></para>
  <para style="p">
    <verse number="43" style="v" sid="MAT 22:43"/>“ಹಾಗಾದರೆ ದಾವೀದನು ಆತ್ಮದಲ್ಲಿ ಆತನಿಗೆ, ‘ಕರ್ತನು’ ಎಂದು ಕರೆದು,<verse eid="MAT 22:43"/></para>
  <para style="q1">
    <verse number="44" style="v" sid="MAT 22:44"/>“ ‘ಕರ್ತದೇವರು ನನ್ನ ಕರ್ತದೇವರಿಗೆ<note caller="+" style="f"><char style="fr" closed="false">22:44 </char><char style="ft" closed="false">ಅಂದರೆ </char><char style="fqa" closed="false">ತಂದೆಯಾದ ದೇವರು ಕ್ರಿಸ್ತ ಯೇಸುವಿಗೆ</char></note>:</para>
  <para style="q2" vid="MAT 22:44">“ನಾನು ನಿನ್ನ ವಿರೋಧಿಗಳನ್ನು</para>
  <para style="q1" vid="MAT 22:44">ನಿನ್ನ ಪಾದದಡಿಯಲ್ಲಿ ಹಾಕುವವರೆಗೆ</para>
  <para style="q2" vid="MAT 22:44">ನನ್ನ ಬಲಗಡೆಯಲ್ಲಿ ಕುಳಿತುಕೊಂಡಿರು,” ’<note caller="+" style="f"><char style="fr" closed="false">22:44 </char><char style="ft" closed="false"><char style="xt"><ref loc="PSA 110:1">ಕೀರ್ತನೆ 110:1</ref></char></char></note></para>
  <para style="m" vid="MAT 22:44">ಎಂದು ಹೇಳಿದನಲ್ಲವೇ? <verse eid="MAT 22:44"/><verse number="45" style="v" sid="MAT 22:45"/>ದಾವೀದನು ತಾನೇ ಅವರನ್ನು, ‘ನನ್ನ ಕರ್ತದೇವರೇ’ ಎಂದು ಕರೆಯುವುದಾದರೆ, ಆತನು ದಾವೀದನ ಪುತ್ರನಾಗುವುದು ಹೇಗೆ?” ಎಂದು ಕೇಳಿದನು. <verse eid="MAT 22:45"/><verse number="46" style="v" sid="MAT 22:46"/>ಅದಕ್ಕೆ ಯಾರೂ ಒಂದು ಮಾತನ್ನು ಸಹ ಯೇಸುವಿಗೆ ಉತ್ತರ ಕೊಡಲಾರದೆ ಹೋದರು. ಇದಲ್ಲದೆ ಆ ದಿನದಿಂದ ಯೇಸುವನ್ನು ಪ್ರಶ್ನಿಸುವುದಕ್ಕೆ ಯಾರಿಗೂ ಧೈರ್ಯ ಬರಲಿಲ್ಲ.<verse eid="MAT 22:46"/></para>
  <chapter eid="MAT 22"/>
  <chapter number="23" style="c" sid="MAT 23"/>
  <para style="s1">ಯೇಸು ಮತ್ತು ಯೆಹೂದಿ ನಾಯಕರು</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 23:1"/>ಯೇಸು ಜನಸಮೂಹಕ್ಕೂ ತಮ್ಮ ಶಿಷ್ಯರಿಗೂ <verse eid="MAT 23:1"/><verse number="2" style="v" sid="MAT 23:2"/>ಹೇಳಿದ್ದೇನೆಂದರೆ: “ನಿಯಮ ಬೋಧಕರೂ ಫರಿಸಾಯರೂ ಮೋಶೆಯ ಆಸನದಲ್ಲಿ ಕುಳಿತಿದ್ದಾರೆ. <verse eid="MAT 23:2"/><verse number="3" style="v" sid="MAT 23:3"/>ಆದ್ದರಿಂದ ಅವರು ನಿಮಗೆ ಹೇಳುವುದನ್ನೆಲ್ಲಾ ಅನುಸರಿಸಿ ನಡೆಯಿರಿ. ಆದರೆ ಅವರ ನಡತೆಗಳ ಪ್ರಕಾರ ನೀವು ನಡೆಯಬೇಡಿರಿ. ಏಕೆಂದರೆ ಅವರು ಹೇಳಿದಂತೆ ಮಾಡುವುದಿಲ್ಲ. <verse eid="MAT 23:3"/><verse number="4" style="v" sid="MAT 23:4"/>ಹೊರುವುದಕ್ಕೆ ಭಾರವಾದ ಮತ್ತು ಹೊರಲಾಗದ ಹೊರೆಗಳನ್ನು ಕಟ್ಟಿ ಜನರ ಹೆಗಲುಗಳ ಮೇಲೆ ಅವರು ಹೊರಿಸುತ್ತಾರೆ. ತಾವಾದರೋ ತಮ್ಮ ಬೆರಳಿನಿಂದಲೂ ಅವುಗಳನ್ನು ಮುಟ್ಟುವುದಿಲ್ಲ.<verse eid="MAT 23:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 23:5"/>“ಆದರೆ ತಾವು ಮಾಡುವ ತಮ್ಮ ಕ್ರಿಯೆಗಳನ್ನೆಲ್ಲಾ ಜನರು ನೋಡುವಂತೆ ಮಾಡುತ್ತಾರೆ. ಅವರು ತಮ್ಮ ಬಾಹುಗಳ ಮೇಲೆ ದೇವರ ವಾಕ್ಯವುಳ್ಳ ಡಬ್ಬಿಗಳನ್ನು ಮತ್ತು ಹಣೆಯ ಮೇಲೆ ಅಗಲ ಪಟ್ಟಿಗಳನ್ನು ಮಾಡಿ ಉಡುಪುಗಳ ಅಂಚುಗಳನ್ನು ಉದ್ದಮಾಡುತ್ತಾರೆ. <verse eid="MAT 23:5"/><verse number="6" style="v" sid="MAT 23:6"/>ಔತಣಗಳಲ್ಲಿ ಮುಖ್ಯಸ್ಥಾನಗಳನ್ನೂ ಸಭಾಮಂದಿರಗಳಲ್ಲಿ ಅತ್ಯುನ್ನತ ಆಸನಗಳನ್ನೂ <verse eid="MAT 23:6"/><verse number="7" style="v" sid="MAT 23:7"/>ಮಾರುಕಟ್ಟೆ ಬೀದಿಗಳಲ್ಲಿ ವಂದನೆಗಳನ್ನೂ ಮತ್ತು ಜನರಿಂದ, ‘ಬೋಧಕರೇ,’ ಎಂದು ಕರೆಯಿಸಿಕೊಳ್ಳಲು ಅವರು ಇಚ್ಛಿಸುತ್ತಾರೆ.<verse eid="MAT 23:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 23:8"/>“ಆದರೆ ನೀವು, ‘ಬೋಧಕರು,’ ಎಂದು ಕರೆಯಿಸಿಕೊಳ್ಳಬೇಡಿರಿ. ಏಕೆಂದರೆ ನಿಮಗಿರುವ ಬೋಧಕರು ಒಬ್ಬರೇ ನೀವೆಲ್ಲರೂ ಸಹೋದರರು. <verse eid="MAT 23:8"/><verse number="9" style="v" sid="MAT 23:9"/>ಭೂಮಿಯಲ್ಲಿ ಯಾರನ್ನೂ ‘ತಂದೆ’ ಎಂದು ಕರೆಯಬೇಡಿರಿ, ಪರಲೋಕದಲ್ಲಿ ಇರುವವರೇ ನಿಮ್ಮ ತಂದೆ. <verse eid="MAT 23:9"/><verse number="10" style="v" sid="MAT 23:10"/>ಗುರುವೆಂದೂ ಕರೆಯಿಸಿಕೊಳ್ಳಬೇಡಿರಿ. ಏಕೆಂದರೆ ಕ್ರಿಸ್ತನೊಬ್ಬನೇ ನಿಮ್ಮ ಗುರುವು. <verse eid="MAT 23:10"/><verse number="11" style="v" sid="MAT 23:11"/>ಆದರೆ ನಿಮ್ಮಲ್ಲಿ ಅತಿ ದೊಡ್ಡವನಾಗಿರುವವನು ನಿಮ್ಮ ಸೇವಕನಾಗಿರಬೇಕು. <verse eid="MAT 23:11"/><verse number="12" style="v" sid="MAT 23:12"/>ತಮ್ಮನ್ನು ತಾವೇ ಹೆಚ್ಚಿಸಿಕೊಳ್ಳುವವರು ತಗ್ಗಿನ ಅನುಭವ ಹೊಂದುವರು. ತಮ್ಮನ್ನು ತಾವೇ ತಗ್ಗಿಸಿಕೊಳ್ಳುವವರು ಉನ್ನತ ಅನುಭವ ಹೊಂದುವರು.<verse eid="MAT 23:12"/></para>
  <para style="s1">ನಿಯಮ ಬೋಧಕರು ಮತ್ತು ಫರಿಸಾಯರ ಮೇಲಿನ ಸಪ್ತ ತಿದ್ದುವಿಕೆಗಳು</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 23:13"/>“ಆದರೆ ಕಪಟಿಗಳಾದ ನಿಯಮ ಬೋಧಕರೇ, ಫರಿಸಾಯರೇ, ನಿಮಗೆ ಕಷ್ಟ! ಏಕೆಂದರೆ ನೀವು ಮನುಷ್ಯರ ಮುಂದೆ ಪರಲೋಕ ರಾಜ್ಯವನ್ನು ಮುಚ್ಚುತ್ತೀರಿ. ನೀವೂ ಪ್ರವೇಶಿಸುವುದಿಲ್ಲ, ಪ್ರವೇಶಿಸುವವರನ್ನೂ ನೀವು ಒಳಗೆ ಬಿಡುವುದಿಲ್ಲ.<verse eid="MAT 23:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 23:14"/>
    <char style="it">“ಕಪಟಿಗಳಾದ ನಿಯಮ ಬೋಧಕರೇ, ಫರಿಸಾಯರೇ, ನಿಮಗೆ ಕಷ್ಟ, ಏಕೆಂದರೆ ನೀವು ವಿಧವೆಯರ ಮನೆಗಳನ್ನು ನುಂಗುತ್ತೀರಿ. ನಟನೆಗಾಗಿ ಉದ್ದವಾದ ಪ್ರಾರ್ಥನೆಯನ್ನು ಮಾಡುತ್ತೀರಿ. ಆದ್ದರಿಂದ ನೀವು ಹೆಚ್ಚಾದ ದಂಡನೆಯನ್ನು ಹೊಂದುವಿರಿ.</char>
    <note caller="+" style="f">
      <char style="fr" closed="false">23:14 </char>
      <char style="ft" closed="false">ಇದು ಕೆಲವು ಹಳೆಯ ಮೂಲ ಹಸ್ತಪ್ರತಿಗಳಲ್ಲಿ ಈ ವಾಕ್ಯ ಸೇರ್ಪಡೆಯಾಗಿರುವುದಿಲ್ಲ.</char>
    </note><verse eid="MAT 23:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 23:15"/>“ಕಪಟಿಗಳಾದ ನಿಯಮ ಬೋಧಕರೇ, ಫರಿಸಾಯರೇ ನಿಮಗೆ ಕಷ್ಟ! ಏಕೆಂದರೆ ಒಬ್ಬನನ್ನು ಮತಾಂತರ ಮಾಡುವುದಕ್ಕೆ ನೀವು ಸಮುದ್ರವನ್ನೂ ಭೂಮಿಯನ್ನೂ ಸುತ್ತುತ್ತೀರಿ. ಮತಾಂತರ ಮಾಡಿದ ಮೇಲೆ ಅವನನ್ನು ನಿಮಗಿಂತಲೂ ಎರಡರಷ್ಟು ನರಕಕ್ಕೆ ಗುರಿಯಾಗುವಂತೆ ಮಾಡುತ್ತೀರಿ.<verse eid="MAT 23:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 23:16"/>“ಕುರುಡರಾದ ಮಾರ್ಗದರ್ಶಕರೇ! ನಿಮಗೆ ಕಷ್ಟ, ‘ಯಾವನಾದರೂ ದೇವಾಲಯದ ಮೇಲೆ ಆಣೆಯಿಟ್ಟರೆ ಅದು ಏನೂ ಅಲ್ಲ ಎನ್ನುತ್ತೀರಿ. ಆದರೆ ಯಾವನಾದರೂ ದೇವಾಲಯದ ಚಿನ್ನದ ಮೇಲೆ ಆಣೆಯಿಟ್ಟರೆ ಅವನು ಅದನ್ನು ಕೊಟ್ಟುಬಿಡಬೇಕು,’ ಎನ್ನುತ್ತೀರಿ. <verse eid="MAT 23:16"/><verse number="17" style="v" sid="MAT 23:17"/>ಮೂರ್ಖರೇ, ಕುರುಡರೇ, ಯಾವುದು ದೊಡ್ಡದು? ಚಿನ್ನವೋ ಚಿನ್ನವನ್ನು ಪಾವನ ಮಾಡುವ ದೇವಾಲಯವೋ? <verse eid="MAT 23:17"/><verse number="18" style="v" sid="MAT 23:18"/>‘ಯಾರಾದರೂ ಬಲಿಪೀಠದ ಮೇಲೆ ಆಣೆಯಿಟ್ಟರೆ ಅದು ಏನೂ ಅಲ್ಲವೆಂದೂ ಯಾರಾದರೂ ಅದರಲ್ಲಿರುವ ಕಾಣಿಕೆ ಮೇಲೆ ಆಣೆಯಿಟ್ಟರೆ ಅವನು ಅದನ್ನು ಕೊಟ್ಟುಬಿಡಬೇಕು,’ ಎನ್ನುತ್ತೀರಿ. <verse eid="MAT 23:18"/><verse number="19" style="v" sid="MAT 23:19"/>ಕುರುಡರೇ, ಯಾವುದು ದೊಡ್ಡದು? ಕಾಣಿಕೆಯೋ ಕಾಣಿಕೆಯನ್ನು ಪಾವನ ಮಾಡುವ ಬಲಿಪೀಠವೋ? <verse eid="MAT 23:19"/><verse number="20" style="v" sid="MAT 23:20"/>ಆದ್ದರಿಂದ, ಬಲಿಪೀಠದ ಮೇಲೆ ಆಣೆಯಿಡುವವನು ಅದರ ಮೇಲೆಯೂ ಅದರಲ್ಲಿರುವ ಎಲ್ಲದರ ಮೇಲೆಯೂ ಆಣೆಯಿಡುವವನಾಗಿದ್ದಾನೆ. <verse eid="MAT 23:20"/><verse number="21" style="v" sid="MAT 23:21"/>ದೇವಾಲಯದ ಮೇಲೆ ಆಣೆಯಿಡುವವನು ಅದರ ಮೇಲೆಯೂ ಅದರಲ್ಲಿ ವಾಸಿಸುವ ದೇವರ ಮೇಲೆಯೂ ಆಣೆಯಿಡುವವನಾಗಿದ್ದಾನೆ. <verse eid="MAT 23:21"/><verse number="22" style="v" sid="MAT 23:22"/>ಪರಲೋಕದ ಮೇಲೆ ಆಣೆಯಿಡುವವನು ದೇವರ ಸಿಂಹಾಸನದ ಮೇಲೆಯೂ ಅದರ ಮೇಲೆ ಆಸೀನರಾದ ದೇವರ ಮೇಲೆಯೂ ಆಣೆಯಿಡುವವನಾಗಿದ್ದಾನೆ.<verse eid="MAT 23:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 23:23"/>“ಕಪಟಿಗಳಾದ ನಿಯಮ ಬೋಧಕರೇ, ಫರಿಸಾಯರೇ, ನಿಮಗೆ ಕಷ್ಟ! ಏಕೆಂದರೆ ನೀವು ಪುದೀನ, ಸದಾಪು, ಜೀರಿಗೆಗಳ ದಶಮಭಾಗವನ್ನು ಸಲ್ಲಿಸುತ್ತೀರಿ. ಆದರೆ ನಿಯಮದ ನ್ಯಾಯನೀತಿ, ಕರುಣೆ, ನಂಬಿಕೆ ಎಂಬ ಈ ಪ್ರಮುಖವಾದವುಗಳನ್ನು ಬಿಟ್ಟುಬಿಟ್ಟಿದ್ದೀರಿ. ಇವುಗಳೊಂದಿಗೆ ಆ ಬೇರೆಯವುಗಳನ್ನು ಬಿಟ್ಟುಬಿಡದೆ ಮಾಡಬೇಕಾಗಿತ್ತು. <verse eid="MAT 23:23"/><verse number="24" style="v" sid="MAT 23:24"/>ಕುರುಡ ಮಾರ್ಗದರ್ಶಕರಾದ ನೀವು ಸೊಳ್ಳೆ ಸೋಸುತ್ತೀರಿ ಒಂಟೆ ನುಂಗುತ್ತೀರಿ.<verse eid="MAT 23:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 23:25"/>“ಕಪಟಿಗಳಾದ ನಿಯಮ ಬೋಧಕರೇ, ಫರಿಸಾಯರೇ, ನಿಮಗೆ ಕಷ್ಟ! ನೀವು ಪಾತ್ರೆಯ ಮತ್ತು ತಟ್ಟೆಯ ಹೊರಭಾಗವನ್ನು ಶುಚಿಮಾಡುತ್ತೀರಿ, ಆದರೆ ಅವು ಒಳಗೆ ಸುಲಿಗೆಯಿಂದಲೂ ದುರಾಶೆಯಿಂದಲೂ ತುಂಬಿರುತ್ತವೆ. <verse eid="MAT 23:25"/><verse number="26" style="v" sid="MAT 23:26"/>ಕುರುಡನಾದ ಫರಿಸಾಯನೇ, ಮೊದಲು ಪಾತ್ರೆಯ ಮತ್ತು ತಟ್ಟೆಯ ಒಳಗಿನ ಭಾಗವನ್ನು ಶುಚಿಮಾಡು. ಆಗ ಅವುಗಳ ಹೊರಭಾಗವೂ ಶುಚಿಯಾಗುವುದು.<verse eid="MAT 23:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 23:27"/>“ಕಪಟಿಗಳಾದ ನಿಯಮ ಬೋಧಕರೇ, ಫರಿಸಾಯರೇ, ನಿಮಗೆ ಕಷ್ಟ! ಏಕೆಂದರೆ ನೀವು ಸುಣ್ಣ ಹಚ್ಚಿದ ಸಮಾಧಿಗಳಿಗೆ ಹೋಲಿಕೆಯಾಗಿದ್ದೀರಿ. ಅವು ಹೊರಗೆ ನಿಜಕ್ಕೂ ಅಂದವಾಗಿ ಕಾಣುತ್ತವೆ. ಆದರೆ ಒಳಗೆ ಸತ್ತವರ ಎಲುಬುಗಳಿಂದಲೂ ಎಲ್ಲಾ ಅಶುದ್ಧತೆಯಿಂದಲೂ ತುಂಬಿರುತ್ತವೆ. <verse eid="MAT 23:27"/><verse number="28" style="v" sid="MAT 23:28"/>ಅದರಂತೆಯೇ, ನೀವು ಸಹ ಹೊರಗಡೆ ಮನುಷ್ಯರಿಗೆ ನೀತಿವಂತರಂತೆ ಕಾಣಿಸಿಕೊಳ್ಳುತ್ತೀರಿ. ಆದರೆ ನೀವು ಒಳಗೆ ಕಪಟದಿಂದಲೂ ಅನ್ಯಾಯದಿಂದಲೂ ತುಂಬಿದವರಾಗಿದ್ದೀರಿ.<verse eid="MAT 23:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 23:29"/>“ಕಪಟಿಗಳಾದ ನಿಯಮ ಬೋಧಕರೇ, ಫರಿಸಾಯರೇ, ನಿಮಗೆ ಕಷ್ಟ! ಏಕೆಂದರೆ ನೀವು ಪ್ರವಾದಿಗಳ ಸಮಾಧಿಗಳನ್ನು ಕಟ್ಟಿ ನೀತಿವಂತರ ಸಮಾಧಿಗಳನ್ನು ಅಲಂಕರಿಸುತ್ತೀರಿ. <verse eid="MAT 23:29"/><verse number="30" style="v" sid="MAT 23:30"/>ಆದರೆ, ‘ನಾವು ನಮ್ಮ ಪಿತೃಗಳ ದಿನಗಳಲ್ಲಿ ಇರುತ್ತಿದ್ದರೆ ಪ್ರವಾದಿಗಳ ರಕ್ತಪಾತದಲ್ಲಿ ಪಿತೃಗಳೊಂದಿಗೆ ಪಾಲುಗಾರರಾಗುತ್ತಿರಲಿಲ್ಲ’ ಎಂದು ಹೇಳುತ್ತೀರಿ. <verse eid="MAT 23:30"/><verse number="31" style="v" sid="MAT 23:31"/>ಆದ್ದರಿಂದ ನೀವು ಆ ಪ್ರವಾದಿಗಳನ್ನು ಕೊಂದವರ ಮಕ್ಕಳೇ ಎಂದು ನಿಮಗೆ ನೀವೇ ಸಾಕ್ಷಿಗಳಾಗಿದ್ದೀರಿ. <verse eid="MAT 23:31"/><verse number="32" style="v" sid="MAT 23:32"/>ಹಾಗಾದರೆ ನಿಮ್ಮ ಪಿತೃಗಳ ಅಪರಾಧದ ಅಳತೆಯನ್ನು ನೀವೇ ಪೂರ್ಣಗೊಳಿಸಿರಿ.<verse eid="MAT 23:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 23:33"/>“ಹಾವುಗಳೇ, ಸರ್ಪಸಂತತಿಯವರೇ, ನೀವು ನರಕದಂಡನೆಯಿಂದ ಹೇಗೆ ತಪ್ಪಿಸಿಕೊಂಡೀರಿ? <verse eid="MAT 23:33"/><verse number="34" style="v" sid="MAT 23:34"/>ಆದ್ದರಿಂದ ನೋಡಿರಿ, ನಾನು ಪ್ರವಾದಿಗಳನ್ನೂ ಜ್ಞಾನಿಗಳನ್ನೂ ನಿಯಮ ಬೋಧಕರನ್ನೂ ನಿಮ್ಮ ಬಳಿಗೆ ಕಳುಹಿಸುತ್ತೇನೆ. ಅವರಲ್ಲಿ ಕೆಲವರನ್ನು ಕೊಲ್ಲುವಿರಿ, ಶಿಲುಬೆಗೆ ಏರಿಸುವಿರಿ. ಕೆಲವರನ್ನು ನೀವು ನಿಮ್ಮ ಸಭಾಮಂದಿರಗಳಲ್ಲಿ ಕೊರಡೆಗಳಿಂದ ಹೊಡೆದು ಅವರನ್ನು ಪಟ್ಟಣದಿಂದ ಪಟ್ಟಣಕ್ಕೆ ಅಟ್ಟಿ ಹಿಂಸಿಸುವಿರಿ. <verse eid="MAT 23:34"/><verse number="35" style="v" sid="MAT 23:35"/>ಹೀಗೆ ನೀತಿವಂತನಾದ ಹೇಬೆಲನ<note caller="+" style="f"><char style="fr" closed="false">23:35 </char><char style="ft" closed="false">ನೋಡಿರಿ <char style="xt"><ref loc="GEN 4:8">ಆದಿ 4:8</ref></char></char></note> ರಕ್ತ ಮೊದಲುಗೊಂಡು ದೇವಾಲಯಕ್ಕೂ ಬಲಿಪೀಠಕ್ಕೂ ನಡುವೆ ನೀವು ಕೊಂದುಹಾಕಿದ ಬರಕೀಯನ ಮಗ ಜಕರೀಯನ<note caller="+" style="f"><char style="fr" closed="false">23:35 </char><char style="ft" closed="false">ನೋಡಿರಿ <char style="xt"><ref loc="2CH 24:20-22">2 ಪೂರ್ವ 24:20-22</ref></char></char></note> ರಕ್ತದವರೆಗೂ ಭೂಮಿಯಲ್ಲಿ ಸುರಿಸಲಾದ ಎಲ್ಲಾ ನೀತಿವಂತರ ರಕ್ತಾಪರಾಧವು<note caller="+" style="f"><char style="fr" closed="false">23:35 </char><char style="fq" closed="false">ರಕ್ತಾಪರಾಧ </char><char style="ft" closed="false">ಅಂದರೆ </char><char style="fqa" closed="false">ಕೊಲೆಗೆ ಹೊಣೆ</char></note> ನಿಮ್ಮ ಮೇಲೆ ಬರುವುದು. <verse eid="MAT 23:35"/><verse number="36" style="v" sid="MAT 23:36"/>ನಿಮಗೆ ನಿಜವಾಗಿ ಹೇಳುತ್ತೇನೆ: ಇವೆಲ್ಲವೂ ಈ ಸಂತತಿಯವರ ಮೇಲೆ ಬರುವವು.<verse eid="MAT 23:36"/></para>
  <para style="p">
    <verse number="37" style="v" sid="MAT 23:37"/>“ಯೆರೂಸಲೇಮೇ, ಯೆರೂಸಲೇಮೇ, ಪ್ರವಾದಿಗಳನ್ನು ಕೊಲ್ಲುವವಳೇ, ನಿನ್ನ ಬಳಿಗೆ ಕಳುಹಿಸಿದವರನ್ನು ಕಲ್ಲೆಸೆಯುವವಳೇ, ಕೋಳಿಯು ತನ್ನ ಮರಿಗಳನ್ನು ತನ್ನ ರೆಕ್ಕೆಗಳ ಕೆಳಗೆ ಕೂಡಿಸುವಂತೆ ನಾನು ನಿನ್ನ ಮಕ್ಕಳನ್ನು ಕೂಡಿಸುವುದಕ್ಕೆ ನನಗೆ ಎಷ್ಟೋ ಸಾರಿ ಮನಸ್ಸಿತ್ತು. ಆದರೆ ನಿನಗೆ ಮನಸ್ಸಿಲ್ಲದೆ ಹೋಯಿತು. <verse eid="MAT 23:37"/><verse number="38" style="v" sid="MAT 23:38"/>ನೋಡಿರಿ, ನಿಮ್ಮ ದೇವಾಲಯವು ನಿಮಗೆ ಬರಿದಾಗಿ ಹಾಳುಬೀಳುವುದು. <verse eid="MAT 23:38"/><verse number="39" style="v" sid="MAT 23:39"/>ಏಕೆಂದರೆ, ‘ಕರ್ತನ ಹೆಸರಿನಲ್ಲಿ ಬರುವವರು ಧನ್ಯರು’<note caller="+" style="f"><char style="fr" closed="false">23:39 </char><char style="ft" closed="false"><char style="xt"><ref loc="PSA 118:26">ಕೀರ್ತನೆ 118:26</ref></char></char></note> ಎಂದು ನೀವು ಹೇಳುವ ಸಮಯವು ಬರುವ ತನಕ ನೀವು ನನ್ನನ್ನು ಕಾಣುವುದೇ ಇಲ್ಲ ಎಂದು ನಾನು ನಿಮಗೆ ಹೇಳುತ್ತೇನೆ” ಎಂದರು.<verse eid="MAT 23:39"/></para>
  <chapter eid="MAT 23"/>
  <chapter number="24" style="c" sid="MAT 24"/>
  <para style="s1">ಯುಗದ ಅಂತ್ಯದ ಸೂಚನೆಗಳು</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 24:1"/>ಯೇಸು ದೇವಾಲಯದಿಂದ ಹೊರಗೆ ಹೋದಾಗ ಅವರ ಶಿಷ್ಯರು ಆ ದೇವಾಲಯದ ಕಟ್ಟಡಗಳನ್ನು ತೋರಿಸುವುದಕ್ಕಾಗಿ ಯೇಸುವಿನ ಬಳಿಗೆ ಬಂದರು. <verse eid="MAT 24:1"/><verse number="2" style="v" sid="MAT 24:2"/>ಆಗ ಯೇಸು ಅವರಿಗೆ, “ಇವುಗಳನ್ನೆಲ್ಲಾ ನೀವು ನೋಡುತ್ತೀರಲ್ಲಾ? ಇಲ್ಲಿ ಕಲ್ಲಿನ ಮೇಲೆ ಕಲ್ಲು ಉಳಿಯುವುದಿಲ್ಲ; ಎಲ್ಲವೂ ಕೆಡವಲಾಗುವವು ಎಂದು ನಾನು ನಿಮಗೆ ನಿಜವಾಗಿ ಹೇಳುತ್ತೇನೆ,” ಎಂದರು.<verse eid="MAT 24:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 24:3"/>ಯೇಸು ಓಲಿವ್ ಗುಡ್ಡದ ಮೇಲೆ ಕುಳಿತುಕೊಂಡಾಗ, ಶಿಷ್ಯರು ಪ್ರತ್ಯೇಕವಾಗಿ ಯೇಸುವಿನ ಬಳಿಗೆ ಬಂದು, “ಈ ಸಂಗತಿಗಳು ಸಂಭವಿಸುವುದು ಯಾವಾಗ? ನಿನ್ನ ಆಗಮನದ ಹಾಗೂ ಲೋಕಾಂತ್ಯದ ಸೂಚನೆ ಏನು? ನಮಗೆ ತಿಳಿಸು,” ಎಂದು ಕೇಳಿದರು.<verse eid="MAT 24:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 24:4"/>ಆಗ ಯೇಸು ಉತ್ತರವಾಗಿ ಅವರಿಗೆ, “ಯಾರೂ ನಿಮ್ಮನ್ನು ಮೋಸಗೊಳಿಸದಂತೆ ಎಚ್ಚರಿಕೆಯಾಗಿರಿ. <verse eid="MAT 24:4"/><verse number="5" style="v" sid="MAT 24:5"/>ಅನೇಕರು ನನ್ನ ಹೆಸರಿನಲ್ಲಿ ಬಂದು, ‘ನಾನೇ ಕ್ರಿಸ್ತನು’ ಎಂದು ಹೇಳಿ ಅನೇಕರನ್ನು ಮೋಸಗೊಳಿಸುವರು. <verse eid="MAT 24:5"/><verse number="6" style="v" sid="MAT 24:6"/>ಯುದ್ಧಗಳನ್ನೂ ಯುದ್ಧಗಳ ಸುದ್ದಿಗಳನ್ನೂ ನೀವು ಕೇಳುವಿರಿ, ಆದರೆ ನೀವು ಕಳವಳಗೊಳ್ಳದಂತೆ ನೋಡಿಕೊಳ್ಳಿರಿ. ಏಕೆಂದರೆ ಇವೆಲ್ಲವು ಸಂಭವಿಸುವುದು ಅಗತ್ಯ. ಆದರೆ ಇದು ಇನ್ನೂ ಅಂತ್ಯವಲ್ಲ. <verse eid="MAT 24:6"/><verse number="7" style="v" sid="MAT 24:7"/>ಜನಾಂಗಕ್ಕೆ ವಿರೋಧವಾಗಿ ಜನಾಂಗವೂ ರಾಜ್ಯಕ್ಕೆ ವಿರೋಧವಾಗಿ ರಾಜ್ಯವೂ ಏಳುವವು. ಅಲ್ಲಲ್ಲಿ ಬರಗಾಲಗಳು ಮತ್ತು ಭೂಕಂಪಗಳು ಸಂಭವಿಸುತ್ತವೆ. <verse eid="MAT 24:7"/><verse number="8" style="v" sid="MAT 24:8"/>ಇವೆಲ್ಲವೂ ಪ್ರಸವವೇದನೆಯ ಪ್ರಾರಂಭ ಮಾತ್ರ.<verse eid="MAT 24:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 24:9"/>“ಆಗ ಜನರು ನಿಮ್ಮನ್ನು ಹಿಂಸೆಪಡಿಸುವುದಕ್ಕಾಗಿ ಒಪ್ಪಿಸಿ ನಿಮ್ಮನ್ನು ಕೊಲ್ಲುವರು. ಇದಲ್ಲದೆ ನನ್ನ ಹೆಸರಿನ<note caller="+" style="f"><char style="fr" closed="false">24:9 </char><char style="ft" closed="false">ಅಂದರೆ ಯೇಸುವಿನ ಹಿಂಬಾಲಕರು ಆಗಿರುವುದರಿಂದ</char></note> ನಿಮಿತ್ತವಾಗಿ ಎಲ್ಲಾ ಜನಾಂಗದವರು ನಿಮ್ಮನ್ನು ದ್ವೇಷಮಾಡುವರು. <verse eid="MAT 24:9"/><verse number="10" style="v" sid="MAT 24:10"/>ಆಗ ಅನೇಕರು ವಿಶ್ವಾಸದಿಂದ ಬಿದ್ದವರಾಗಿ ಒಬ್ಬರಿಗೊಬ್ಬರು ದ್ರೋಹ ಬಗೆಯುವರು ಮತ್ತು ಒಬ್ಬರನ್ನೊಬ್ಬರು ದ್ವೇಷಿಸುವರು. <verse eid="MAT 24:10"/><verse number="11" style="v" sid="MAT 24:11"/>ಬಹುಮಂದಿ ಸುಳ್ಳು ಪ್ರವಾದಿಗಳು ಎದ್ದು ಅನೇಕರನ್ನು ಮೋಸಗೊಳಿಸುವರು. <verse eid="MAT 24:11"/><verse number="12" style="v" sid="MAT 24:12"/>ಅನ್ಯಾಯವು ಹೆಚ್ಚಾಗುವುದರಿಂದ ಬಹುಜನರ ಪ್ರೀತಿಯು ತಣ್ಣಗಾಗುವುದು. <verse eid="MAT 24:12"/><verse number="13" style="v" sid="MAT 24:13"/>ಆದರೆ ಕೊನೆಯವರೆಗೂ ತಾಳುವವನೇ ರಕ್ಷಣೆಹೊಂದುವನು. <verse eid="MAT 24:13"/><verse number="14" style="v" sid="MAT 24:14"/>ಪರಲೋಕ ರಾಜ್ಯದ ಈ ಸುವಾರ್ತೆಯು ಲೋಕದಲ್ಲೆಲ್ಲಾ ಸರ್ವಜನಾಂಗಗಳಿಗೆ ಸಾಕ್ಷಿಯಾಗಿ ಸಾರಲಾಗುವದು, ತರುವಾಯ ಅಂತ್ಯ ಬರುವುದು.<verse eid="MAT 24:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 24:15"/>“ಆದ್ದರಿಂದ ಪ್ರವಾದಿ ದಾನಿಯೇಲನಿಂದ ಹೇಳಿದ ಹಾಗೆ ‘ಅಸಹ್ಯ ವಸ್ತು’<note caller="+" style="f"><char style="fr" closed="false">24:15 </char><char style="ft" closed="false"><char style="xt"><ref loc="DAN 9:27">ದಾನಿ 9:27</ref>; <ref loc="DAN 11:31">11:31</ref>; <ref loc="DAN 12:11">12:11</ref></char></char></note> ಪವಿತ್ರ ಸ್ಥಳದಲ್ಲಿ ನಿಂತಿರುವುದನ್ನು ನೀವು ಕಾಣುವಾಗ, ಓದುವವನು ತಿಳಿದುಕೊಳ್ಳಲಿ. <verse eid="MAT 24:15"/><verse number="16" style="v" sid="MAT 24:16"/>ಆಗ ಯೂದಾಯದಲ್ಲಿ ಇರುವವರು ಬೆಟ್ಟಗಳಿಗೆ ಓಡಿಹೋಗಲಿ. <verse eid="MAT 24:16"/><verse number="17" style="v" sid="MAT 24:17"/>ಮಾಳಿಗೆಯ ಮೇಲಿರುವವನು ತನ್ನ ಮನೆಯೊಳಗಿಂದ ಏನಾದರೂ ತೆಗೆದುಕೊಳ್ಳುವುದಕ್ಕೆ ಕೆಳಗೆ ಇಳಿಯದಿರಲಿ. <verse eid="MAT 24:17"/><verse number="18" style="v" sid="MAT 24:18"/>ಹೊಲದಲ್ಲಿರುವವನು ತನ್ನ ಬಟ್ಟೆಗಳನ್ನು ತೆಗೆದುಕೊಳ್ಳುವುದಕ್ಕೆ ಹಿಂದಿರುಗದಿರಲಿ. <verse eid="MAT 24:18"/><verse number="19" style="v" sid="MAT 24:19"/>ಆ ದಿವಸಗಳಲ್ಲಿ ಗರ್ಭಿಣಿಯರಿಗೂ ಹಾಲುಣಿಸುವ ತಾಯಂದಿರಿಗೂ ಕಷ್ಟ! <verse eid="MAT 24:19"/><verse number="20" style="v" sid="MAT 24:20"/>ಆದರೆ ನಿಮ್ಮ ಪಲಾಯನವು ಚಳಿಗಾಲದಲ್ಲಾಗಲಿ, ಸಬ್ಬತ್ ದಿನದಲ್ಲಾಗಲಿ ಆಗದಂತೆ ಪ್ರಾರ್ಥಿಸಿರಿ. <verse eid="MAT 24:20"/><verse number="21" style="v" sid="MAT 24:21"/>ಅಂಥ ಮಹಾ ಸಂಕಟವು ಲೋಕಾದಿಯಿಂದ ಇಂದಿನವರೆಗೂ ಆಗಲಿಲ್ಲ. ಇನ್ನು ಮುಂದೆಯೂ ಆಗುವುದಿಲ್ಲ.<verse eid="MAT 24:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 24:22"/>“ಆ ದಿನಗಳನ್ನು ಕಡಿಮೆ ಮಾಡದಿದ್ದರೆ, ಒಬ್ಬನೂ ಉಳಿಯುವಂತಿಲ್ಲ. ಆದರೆ ಆಯ್ಕೆಯಾದವರಿಗಾಗಿ ಆ ದಿನಗಳನ್ನು ಕಡಿಮೆ ಮಾಡಲಾಗುವುದು. <verse eid="MAT 24:22"/><verse number="23" style="v" sid="MAT 24:23"/>ಆಗ ಯಾರಾದರೂ ನಿಮಗೆ, ‘ಇಗೋ ಕ್ರಿಸ್ತನು ಇಲ್ಲಿದ್ದಾನೆ! ಅಗೋ ಅಲ್ಲಿದ್ದಾನೆ!’ ಎಂದು ಹೇಳಿದರೆ ಅವನನ್ನು ನಂಬಬೇಡಿರಿ. <verse eid="MAT 24:23"/><verse number="24" style="v" sid="MAT 24:24"/>ಏಕೆಂದರೆ ಸುಳ್ಳು ಕ್ರಿಸ್ತರು ಮತ್ತು ಸುಳ್ಳು ಪ್ರವಾದಿಗಳು ಎದ್ದು ಸಾಧ್ಯವಾದರೆ ಆಯ್ಕೆಯಾದವರನ್ನು ಸಹ ಮೋಸಗೊಳಿಸುವಂತೆ ದೊಡ್ಡ ಸೂಚಕಕಾರ್ಯಗಳನ್ನೂ ಅದ್ಭುತಕಾರ್ಯಗಳನ್ನೂ ಮಾಡಿ ತೋರಿಸುವರು. <verse eid="MAT 24:24"/><verse number="25" style="v" sid="MAT 24:25"/>ನೋಡಿರಿ, ಮುಂಚಿತವಾಗಿ ನಾನು ನಿಮಗೆ ಹೇಳಿದ್ದೇನೆ.<verse eid="MAT 24:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 24:26"/>“ಅವರು ನಿಮಗೆ, ‘ನೋಡಿ, ಆತನು ಅರಣ್ಯದಲ್ಲಿದ್ದಾನೆ’ ಎಂದು ಹೇಳಿದರೆ ಹೋಗಬೇಡಿರಿ. ‘ನೋಡಿ, ಆತನು ಒಳ ಕೋಣೆಯಲ್ಲಿದ್ದಾನೆ,’ ಎಂದು ಹೇಳಿದರೂ ನಂಬಬೇಡಿರಿ. <verse eid="MAT 24:26"/><verse number="27" style="v" sid="MAT 24:27"/>ಏಕೆಂದರೆ ಮಿಂಚು ಪೂರ್ವದಿಂದ ಮಿನುಗಿ ಪಶ್ಚಿಮದವರೆಗೆ ಹೊಳೆಯುವಂತೆಯೇ ಮನುಷ್ಯಪುತ್ರನಾದ ನನ್ನ ಬರುವಿಕೆಯೂ ಇರುವುದು. <verse eid="MAT 24:27"/><verse number="28" style="v" sid="MAT 24:28"/>ಹೆಣ ಇದ್ದಲ್ಲಿಗೆ, ಹದ್ದುಗಳು ಬಂದು ಸೇರುತ್ತವೆ.<note caller="+" style="f"><char style="fr" closed="false">24:28 </char><char style="ft" closed="false">ಈ ಸಂಕೇತಗಳು ಕೊನೆಯ ದಿನಗಳನ್ನು ಸೂಚಿಸುತ್ತವೆ.</char></note><verse eid="MAT 24:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 24:29"/>“ಆ ಸಂಕಟದ ದಿವಸಗಳು ಮುಗಿದ ತಕ್ಷಣವೇ,</para>
  <para style="q1" vid="MAT 24:29">“ ‘ಸೂರ್ಯನು ಕತ್ತಲಾಗುವನು;</para>
  <para style="q2" vid="MAT 24:29">ಚಂದ್ರನು ಕಾಂತಿಹೀನನಾಗುವನು.</para>
  <para style="q1" vid="MAT 24:29">ಆಕಾಶದಿಂದ ನಕ್ಷತ್ರಗಳು ಬೀಳುವವು;</para>
  <para style="q2" vid="MAT 24:29">ಮತ್ತು ಆಕಾಶದ ಶಕ್ತಿಗಳು<note caller="+" style="f"><char style="fr" closed="false">24:29 </char><char style="ft" closed="false">ಅಥವಾ </char><char style="fqa" closed="false">ಆಕಾಶದ ಗೋಳಗಳು</char></note> ಕದಲುವವು.’<note caller="+" style="f"><char style="fr" closed="false">24:29 </char><char style="ft" closed="false"><char style="xt"><ref loc="ISA 13:10">ಯೆಶಾಯ 13:10</ref>; <ref loc="ISA 34:4">34:4</ref></char></char></note><verse eid="MAT 24:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="MAT 24:30"/>“ಆಗ ಮನುಷ್ಯಪುತ್ರನಾದ ನನ್ನ ಸೂಚನೆಯು ಆಕಾಶದಲ್ಲಿ ಕಾಣುವುದು. ಭೂಮಿಯ ಎಲ್ಲಾ ಜನಾಂಗದವರು ಗೋಳಾಡುವರು. ಮನುಷ್ಯಪುತ್ರನಾದ ನಾನು ಆಕಾಶದ ಮೇಘಗಳಲ್ಲಿ, ಶಕ್ತಿಯಿಂದಲೂ ಮಹಾಪ್ರಭಾವದಿಂದಲೂ ಬರುವುದನ್ನು ಅವರು ಕಾಣುವರು.<note caller="+" style="f"><char style="fr" closed="false">24:30 </char><char style="ft" closed="false">ನೋಡಿರಿ <char style="xt"><ref loc="DAN 7:13-14">ದಾನಿ 7:13-14</ref></char></char></note> <verse eid="MAT 24:30"/><verse number="31" style="v" sid="MAT 24:31"/>ಆತನು ತನ್ನ ದೂತರನ್ನು ತುತೂರಿಯ ಮಹಾಶಬ್ದದೊಂದಿಗೆ ಕಳುಹಿಸುವನು. ಆಗ ಅವರು ಆತನಿಂದ ಆಯ್ಕೆಯಾದವರನ್ನು ನಾಲ್ಕು ದಿಕ್ಕುಗಳಿಂದಲೂ ಆಕಾಶದ ಒಂದು ಕಡೆಯಿಂದ ಮತ್ತೊಂದು ಕಡೆಯವರೆಗೂ ಒಟ್ಟುಗೂಡಿಸುವರು.<verse eid="MAT 24:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 24:32"/>“ಅಂಜೂರ ಮರದ ದೃಷ್ಟಾಂತದಿಂದ ಈ ಪಾಠವನ್ನು ಕಲಿತುಕೊಳ್ಳಿರಿ: ಅದರ ರೆಂಬೆ ಇನ್ನೂ ಎಳೆಯದಾಗಿದ್ದು ಎಲೆಗಳನ್ನು ಬಿಡುವಾಗ ಬೇಸಿಗೆಯು ಹತ್ತಿರವಾಯಿತೆಂದು ನೀವು ತಿಳಿದುಕೊಳ್ಳುತ್ತೀರಿ. <verse eid="MAT 24:32"/><verse number="33" style="v" sid="MAT 24:33"/>ಅದೇ ಪ್ರಕಾರ, ಇವೆಲ್ಲವೂ ಆಗುವುದನ್ನು ನೀವು ಕಾಣುವಾಗ, ಅಂತ್ಯವು ಬಾಗಿಲ ಹತ್ತಿರದಲ್ಲಿಯೇ ಇದೆ ಎಂದು ತಿಳಿದುಕೊಳ್ಳಿರಿ. <verse eid="MAT 24:33"/><verse number="34" style="v" sid="MAT 24:34"/>ಇವೆಲ್ಲವೂ ನೆರವೇರುವವರೆಗೆ ಈ ಸಂತತಿಯು ಅಳಿದುಹೋಗುವುದೇ ಇಲ್ಲವೆಂದು ನಾನು ನಿಮಗೆ ನಿಜವಾಗಿ ಹೇಳುತ್ತೇನೆ. <verse eid="MAT 24:34"/><verse number="35" style="v" sid="MAT 24:35"/>ಭೂಮ್ಯಾಕಾಶಗಳು ಅಳಿದುಹೋಗುವುವು, ಆದರೆ ನನ್ನ ಮಾತುಗಳು ಅಳಿದುಹೋಗುವುದೇ ಇಲ್ಲ.<verse eid="MAT 24:35"/></para>
  <para style="s1">ತಿಳಿಯದ ದಿನ ಹಾಗೂ ಗಳಿಗೆ</para>
  <para style="p">
    <verse number="36" style="v" sid="MAT 24:36"/>“ಆ ದಿನದ ಮತ್ತು ಆ ಗಳಿಗೆಯ ವಿಷಯವಾಗಿ ತಂದೆಗೆ ಹೊರತು ಯಾವ ಮನುಷ್ಯನಿಗಾಗಲಿ, ಪರಲೋಕದಲ್ಲಿರುವ ದೂತರಿಗಾಗಲಿ, ಮನುಷ್ಯಪುತ್ರನಾದ ನನಗೂ ತಿಳಿಯದು. <verse eid="MAT 24:36"/><verse number="37" style="v" sid="MAT 24:37"/>ಆದರೆ ನೋಹನ ದಿವಸಗಳು ಇದ್ದಂತೆಯೇ, ಮನುಷ್ಯಪುತ್ರನಾದ ನನ್ನ ಬರುವಿಕೆಯೂ ಇರುವುದು. <verse eid="MAT 24:37"/><verse number="38" style="v" sid="MAT 24:38"/>ಪ್ರಳಯವು ಬರುವುದಕ್ಕಿಂತ ಮುಂಚಿನ ಆ ದಿವಸಗಳಲ್ಲಿ, ನೋಹನು ನಾವೆಯಲ್ಲಿ ಸೇರಿದ ದಿವಸದವರೆಗೆ ಜನರು ತಿನ್ನುತ್ತಾ, ಕುಡಿಯುತ್ತಾ, ಮದುವೆ ಮಾಡಿಕೊಳ್ಳುತ್ತಾ, ಮದುವೆ ಮಾಡಿಕೊಡುತ್ತಾ ಇದ್ದರು. <verse eid="MAT 24:38"/><verse number="39" style="v" sid="MAT 24:39"/>ಜಲಪ್ರಳಯವು ಬಂದು ಅವರನ್ನು ಕೊಚ್ಚಿಕೊಂಡು ಹೋಗುವವರೆಗೂ ಅವರಿಗೆ ಅದು ತಿಳಿದಿರಲಿಲ್ಲ. ಹಾಗೆಯೇ ಮನುಷ್ಯಪುತ್ರನಾದ ನನ್ನ ಬರುವಿಕೆಯೂ ಇರುವುದು. <verse eid="MAT 24:39"/><verse number="40" style="v" sid="MAT 24:40"/>ಆಗ ಇಬ್ಬರು ಹೊಲದಲ್ಲಿರುವರು; ಒಬ್ಬನನ್ನು ತೆಗೆದುಕೊಳ್ಳಲಾಗುವುದು, ಮತ್ತೊಬ್ಬನನ್ನು ಬಿಡಲಾಗುವುದು. <verse eid="MAT 24:40"/><verse number="41" style="v" sid="MAT 24:41"/>ಇಬ್ಬರು ಹೆಂಗಸರು ಬೀಸುವ ಕಲ್ಲಿನಲ್ಲಿ ಬೀಸುತ್ತಿರುವಾಗ, ಒಬ್ಬಳನ್ನು ತೆಗೆದುಕೊಳ್ಳಲಾಗುವುದು, ಮತ್ತೊಬ್ಬಳನ್ನು ಬಿಡಲಾಗುವುದು.<verse eid="MAT 24:41"/></para>
  <para style="p">
    <verse number="42" style="v" sid="MAT 24:42"/>“ನಿಮ್ಮ ಕರ್ತನು ಯಾವ ಗಳಿಗೆಯಲ್ಲಿ ಬರುತ್ತಾನೋ ನಿಮಗೇ ಗೊತ್ತಿಲ್ಲವಾದ್ದರಿಂದ ಎಚ್ಚರವಾಗಿರಿ. <verse eid="MAT 24:42"/><verse number="43" style="v" sid="MAT 24:43"/>ಕಳ್ಳನು ಯಾವ ಗಳಿಗೆಯಲ್ಲಿ ಬರುತ್ತಾನೆಂದು ಮನೆಯ ಯಜಮಾನನಿಗೆ ತಿಳಿದಿದ್ದರೆ, ಅವನು ಎಚ್ಚರವಾಗಿದ್ದು ತನ್ನ ಮನೆಗೆ ಕನ್ನಾಹಾಕದಂತೆ ಕಾಯುತ್ತಿದ್ದನೆಂದು ನೀವು ತಿಳಿದುಕೊಳ್ಳಿರಿ. <verse eid="MAT 24:43"/><verse number="44" style="v" sid="MAT 24:44"/>ಆದಕಾರಣ ನೀವು ಸಹ ಸಿದ್ಧವಾಗಿರಿ, ಏಕೆಂದರೆ ನೀವು ನಿರೀಕ್ಷಿಸದ ಸಮಯದಲ್ಲಿ ಮನುಷ್ಯಪುತ್ರನಾದ ನಾನು ಬರುತ್ತೇನೆ.<verse eid="MAT 24:44"/></para>
  <para style="p">
    <verse number="45" style="v" sid="MAT 24:45"/>“ಹಾಗಾದರೆ ತನ್ನ ಮನೆಯಲ್ಲಿದ್ದವರಿಗೆ ತಕ್ಕ ಕಾಲದಲ್ಲಿ ಆಹಾರ ಕೊಡುವಂತೆ ಅವರ ಮೇಲೆ ತನ್ನ ಯಜಮಾನನು ನೇಮಿಸಿದ ನಂಬಿಗಸ್ತನೂ ಜ್ಞಾನಿಯೂ ಆಗಿರುವ ಸೇವಕನು ಯಾರು? <verse eid="MAT 24:45"/><verse number="46" style="v" sid="MAT 24:46"/>ತನ್ನ ಯಜಮಾನನು ಬಂದಾಗ ಯಾವ ಸೇವಕನು ಸೇವೆ ಮಾಡುವುದನ್ನು ಕಾಣುವನೋ ಆ ಸೇವಕನು ಧನ್ಯನು. <verse eid="MAT 24:46"/><verse number="47" style="v" sid="MAT 24:47"/>ಅವನನ್ನು ಯಜಮಾನನು ತನ್ನ ಎಲ್ಲಾ ಆಸ್ತಿಯ ಮೇಲೆ ಆಡಳಿತಗಾರನಾಗಿ ನೇಮಿಸುವನೆಂದು ನಾನು ನಿಮಗೆ ನಿಜವಾಗಿ ಹೇಳುತ್ತೇನೆ. <verse eid="MAT 24:47"/><verse number="48" style="v" sid="MAT 24:48"/>ಆದರೆ ದುಷ್ಟ ಸೇವಕನು ತನ್ನ ಹೃದಯದಲ್ಲಿ, ‘ನನ್ನ ಯಜಮಾನನು ಬರುವದಕ್ಕೆ ತಡಮಾಡುತ್ತಾನೆ,’ ಎಂದು ಹೇಳಿಕೊಂಡು <verse eid="MAT 24:48"/><verse number="49" style="v" sid="MAT 24:49"/>ತನ್ನ ಜೊತೆಯ ಸೇವಕರನ್ನು ಹೊಡೆಯುತ್ತಾ, ಕುಡುಕರ ಸಂಗಡ ತಿನ್ನುವುದಕ್ಕೂ, ಕುಡಿಯುವುದಕ್ಕೂ ಪ್ರಾರಂಭಿಸುವುದಾದರೆ, <verse eid="MAT 24:49"/><verse number="50" style="v" sid="MAT 24:50"/>ಆ ಸೇವಕನು ನಿರೀಕ್ಷಿಸದ ದಿನದಲ್ಲಿಯೂ ತಿಳಿಯದ ಸಮಯದಲ್ಲಿಯೂ ಅವನ ಯಜಮಾನನು ಬಂದು, <verse eid="MAT 24:50"/><verse number="51" style="v" sid="MAT 24:51"/>ಅವನನ್ನು ಕ್ರೂರವಾಗಿ ಹಿಂಸಿಸಿ ಕಪಟಿಗಳೊಂದಿಗೆ ಅವನ ಪಾಲನ್ನು ನೇಮಿಸುವನು. ಅಲ್ಲಿ ಗೋಳಾಟವೂ ಹಲ್ಲು ಕಡಿಯುವಿಕೆಯೂ ಇರುವವು.<verse eid="MAT 24:51"/></para>
  <chapter eid="MAT 24"/>
  <chapter number="25" style="c" sid="MAT 25"/>
  <para style="s1">ಹತ್ತು ಮಂದಿ ಕನ್ಯೆಯರ ಸಾಮ್ಯ</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 25:1"/>“ಪರಲೋಕ ರಾಜ್ಯವು ತಮ್ಮ ದೀಪಗಳನ್ನು ತೆಗೆದುಕೊಂಡು ಮದುಮಗನನ್ನು ಎದುರುಗೊಳ್ಳುವುದಕ್ಕಾಗಿ ಹೊರಟುಹೋದ ಹತ್ತು ಮಂದಿ ಕನ್ಯೆಯರಿಗೆ ಹೋಲಿಕೆಯಾಗಿರುವುದು. <verse eid="MAT 25:1"/><verse number="2" style="v" sid="MAT 25:2"/>ಅವರಲ್ಲಿ ಐದು ಮಂದಿ ಬುದ್ಧಿವಂತೆಯರೂ ಐದು ಮಂದಿ ಬುದ್ಧಿಹೀನರೂ ಇದ್ದರು. <verse eid="MAT 25:2"/><verse number="3" style="v" sid="MAT 25:3"/>ಬುದ್ಧಿಹೀನರು, ತಮ್ಮ ದೀಪಗಳನ್ನು ತೆಗೆದುಕೊಂಡರು, ಆದರೆ ತಮ್ಮೊಂದಿಗೆ ಎಣ್ಣೆಯನ್ನು ತೆಗೆದುಕೊಳ್ಳಲಿಲ್ಲ. <verse eid="MAT 25:3"/><verse number="4" style="v" sid="MAT 25:4"/>ಬುದ್ಧಿವಂತೆಯರೋ, ತಮ್ಮ ದೀಪಗಳೊಂದಿಗೆ ಪಾತ್ರೆಯಲ್ಲಿ ಎಣ್ಣೆಯನ್ನೂ ತೆಗೆದುಕೊಂಡರು. <verse eid="MAT 25:4"/><verse number="5" style="v" sid="MAT 25:5"/>ಮದುಮಗನು ತಡಮಾಡಿದಾಗ ಅವರೆಲ್ಲರೂ ತೂಕಡಿಸುತ್ತಾ ನಿದ್ರೆ ಹೋದರು.<verse eid="MAT 25:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 25:6"/>“ಮಧ್ಯರಾತ್ರಿಯಲ್ಲಿ, ‘ನೋಡಿರಿ, ಮದುಮಗನು ಬರುತ್ತಿದ್ದಾನೆ, ಅವನನ್ನು ಎದುರುಗೊಳ್ಳುವುದಕ್ಕಾಗಿ ಹೊರಡಿರಿ,’ ಎಂಬ ಕೂಗಾಯಿತು.<verse eid="MAT 25:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 25:7"/>“ಆಗ ಆ ಕನ್ಯೆಯರೆಲ್ಲರೂ ಎದ್ದು ತಮ್ಮ ದೀಪಗಳನ್ನು ಸರಿಪಡಿಸಿಕೊಂಡರು. <verse eid="MAT 25:7"/><verse number="8" style="v" sid="MAT 25:8"/>ಬುದ್ಧಿಹೀನರು ಬುದ್ಧಿವಂತೆಯರಿಗೆ, ‘ನಿಮ್ಮ ಎಣ್ಣೆಯಲ್ಲಿ ನಮಗೂ ಕೊಂಚ ಕೊಡಿರಿ, ಏಕೆಂದರೆ ನಮ್ಮ ದೀಪಗಳು ಆರಿಹೋಗುತ್ತವೆ,’ ಎಂದರು.<verse eid="MAT 25:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 25:9"/>“ಆದರೆ ಬುದ್ಧಿವಂತೆಯರು ಉತ್ತರವಾಗಿ, ‘ಹಾಗಲ್ಲ, ಅದು ನಮಗೂ ಸಾಲದೆ ಹೋದೀತು. ಆದ್ದರಿಂದ ನೀವು ಮಾರುವವರ ಬಳಿಗೆ ಹೋಗಿ ನಿಮಗೋಸ್ಕರ ಕೊಂಡುಕೊಳ್ಳಿರಿ,’ ಎಂದರು.<verse eid="MAT 25:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 25:10"/>“ಅವರು ಕೊಂಡುಕೊಳ್ಳುವುದಕ್ಕೆ ಹೋದಾಗ, ಮದುಮಗನು ಬಂದನು. ಆಗ ಸಿದ್ಧವಾಗಿದ್ದವರು ಆತನೊಂದಿಗೆ ಮದುವೆಯ ಔತಣಕ್ಕೆ ಒಳಗೆ ಹೋದರು. ತರುವಾಯ ಬಾಗಿಲು ಮುಚ್ಚಲಾಯಿತು.<verse eid="MAT 25:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 25:11"/>“ಇದಾದ ಮೇಲೆ ಆ ಬೇರೆ ಕನ್ಯೆಯರು ಸಹ ಬಂದು, ‘ಕರ್ತನೇ, ಕರ್ತನೇ, ನಮಗೆ ಬಾಗಿಲನ್ನು ತೆರೆಯಿರಿ,’ ಎಂದರು.<verse eid="MAT 25:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 25:12"/>“ಆದರೆ ಆತನು ಉತ್ತರವಾಗಿ, ‘ನಾನು ನಿಮ್ಮನ್ನು ಅರಿಯೆನು ಎಂದು ನಿಮಗೆ ನಿಜವಾಗಿ ಹೇಳುತ್ತೇನೆ,’ ಎಂದನು.<verse eid="MAT 25:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 25:13"/>“ಆದ್ದರಿಂದ ಎಚ್ಚರವಾಗಿರಿ, ಏಕೆಂದರೆ ಮನುಷ್ಯಪುತ್ರನಾದ ನನ್ನ ಬರುವ ದಿನವನ್ನಾಗಲಿ ಗಳಿಗೆಯನ್ನಾಗಲಿ ನೀವು ಅರಿಯದವರಾಗಿದ್ದೀರಿ, ಎಂದರು.<verse eid="MAT 25:13"/></para>
  <para style="s1">ಚಿನ್ನದ ನಾಣ್ಯಗಳ ಸಾಮ್ಯ</para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 25:14"/>“ಪರಲೋಕ ರಾಜ್ಯವು ದೂರದೇಶಕ್ಕೆ ಪ್ರಯಾಣ ಮಾಡುವ ಒಬ್ಬ ಮನುಷ್ಯನು ತನ್ನ ಸೇವಕರನ್ನು ಕರೆದು ಅವರಿಗೆ ತನ್ನ ಆಸ್ತಿಯನ್ನು ಒಪ್ಪಿಸಿದಂತೆ ಇದೆ. <verse eid="MAT 25:14"/><verse number="15" style="v" sid="MAT 25:15"/>ಅವನು ಒಬ್ಬನಿಗೆ ಐದು ಚಿನ್ನದ ನಾಣ್ಯಗಳನ್ನು,<note caller="+" style="f"><char style="fr" closed="false">25:15 </char><char style="ft" closed="false">ಮೂಲಭಾಷೆಯಲ್ಲಿ </char><char style="fqa" closed="false">ತಲಾಂತು. </char><char style="ft" closed="false">ಅಂದರೆ ಒಬ್ಬ ಕೂಲಿಕಾರನ 20 ವರ್ಷದ ಕೂಲಿ</char></note> ಇನ್ನೊಬ್ಬನಿಗೆ ಎರಡು, ಮತ್ತೊಬ್ಬನಿಗೆ ಒಂದು; ಹೀಗೆ ಅವನವನ ಸಾಮರ್ಥ್ಯದ ಪ್ರಕಾರ ಕೊಟ್ಟು ಕೂಡಲೇ ಪ್ರಯಾಣಮಾಡಿದನು. <verse eid="MAT 25:15"/><verse number="16" style="v" sid="MAT 25:16"/>ಐದು ಚಿನ್ನದ ನಾಣ್ಯಗಳನ್ನು ಹೊಂದಿದವನು ಹೋಗಿ ಅವುಗಳಿಂದ ವ್ಯಾಪಾರಮಾಡಿ ಬೇರೆ ಐದು ಚಿನ್ನದ ನಾಣ್ಯಗಳನ್ನು ಸಂಪಾದಿಸಿದನು. <verse eid="MAT 25:16"/><verse number="17" style="v" sid="MAT 25:17"/>ಅದೇ ಪ್ರಕಾರ, ಎರಡು ಚಿನ್ನದ ನಾಣ್ಯಗಳನ್ನು ಹೊಂದಿದವನು ಸಹ ಇನ್ನು ಬೇರೆ ಎರಡು ಚಿನ್ನದ ನಾಣ್ಯಗಳನ್ನು ಸಂಪಾದಿಸಿದನು. <verse eid="MAT 25:17"/><verse number="18" style="v" sid="MAT 25:18"/>ಆದರೆ ಒಂದು ಚಿನ್ನದ ನಾಣ್ಯವನ್ನು ಹೊಂದಿದವನು ಹೋಗಿ ಭೂಮಿಯನ್ನು ಅಗೆದು, ತನ್ನ ಯಜಮಾನನ ಹಣವನ್ನು ಬಚ್ಚಿಟ್ಟನು.<verse eid="MAT 25:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 25:19"/>“ಬಹುಕಾಲವಾದ ಮೇಲೆ ಆ ಸೇವಕರ ಯಜಮಾನನು ಬಂದು ಅವರಿಂದ ಲೆಕ್ಕ ಕೇಳಿದನು. <verse eid="MAT 25:19"/><verse number="20" style="v" sid="MAT 25:20"/>ಆಗ ಐದು ಚಿನ್ನದ ನಾಣ್ಯಗಳನ್ನು ಹೊಂದಿದ್ದವನು ಬಂದು ಬೇರೆ ಐದು ಚಿನ್ನದ ನಾಣ್ಯಗಳನ್ನು ತಂದು, ‘ಒಡೆಯನೇ, ನೀನು ನನಗೆ ಐದು ಚಿನ್ನದ ನಾಣ್ಯಗಳನ್ನು ಒಪ್ಪಿಸಿದ್ದೆ. ನೋಡು, ಅವುಗಳಲ್ಲದೆ ಇನ್ನೂ ಬೇರೆ ಐದು ಚಿನ್ನದ ನಾಣ್ಯಗಳನ್ನು ನಾನು ಸಂಪಾದಿಸಿದ್ದೇನೆ,’ ಎಂದನು.<verse eid="MAT 25:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 25:21"/>“ಆಗ ಅವನ ಯಜಮಾನನು ಅವನಿಗೆ, ‘ಭಲಾ, ನಂಬಿಗಸ್ತನಾದ ಒಳ್ಳೆಯ ಸೇವಕನೇ, ಒಳ್ಳೆಯದನ್ನು ಮಾಡಿದ್ದಿ. ಚಿಕ್ಕ ಕಾರ್ಯದಲ್ಲಿ ನೀನು ನಂಬಿಗಸ್ತನಾದದ್ದರಿಂದ ನಾನು ನಿನ್ನನ್ನು ದೊಡ್ಡ ಕಾರ್ಯಗಳ ಮೇಲೆ ಅಧಿಕಾರಿಯನ್ನಾಗಿ ನೇಮಿಸುವೆನು. ನೀನು ನಿನ್ನ ಯಜಮಾನನ ಸಂತೋಷದಲ್ಲಿ ಭಾಗಿಯಾಗು,’ ಎಂದನು.<verse eid="MAT 25:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 25:22"/>“ಎರಡು ಚಿನ್ನದ ನಾಣ್ಯಗಳನ್ನು ಹೊಂದಿದ್ದವನು ಸಹ ಬಂದು, ‘ಒಡೆಯನೇ, ನೀನು ನನಗೆ ಎರಡು ಚಿನ್ನದ ನಾಣ್ಯಗಳನ್ನು ಒಪ್ಪಿಸಿದ್ದೆ. ನೋಡು, ಇನ್ನೂ ಎರಡು ಚಿನ್ನದ ನಾಣ್ಯಗಳನ್ನು ನಾನು ಸಂಪಾದಿಸಿದ್ದೇನೆ,’ ಎಂದನು.<verse eid="MAT 25:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 25:23"/>“ಆಗ ಯಜಮಾನನು ಅವನಿಗೆ, ‘ಭಲಾ, ನಂಬಿಗಸ್ತನಾದ ಒಳ್ಳೆಯ ಸೇವಕನೇ, ಒಳ್ಳೆಯದನ್ನು ಮಾಡಿದ್ದಿ. ಚಿಕ್ಕ ಕಾರ್ಯದಲ್ಲಿ ನೀನು ನಂಬಿಗಸ್ತನಾದದ್ದರಿಂದ, ನಾನು ನಿನ್ನನ್ನು ದೊಡ್ಡ ಕಾರ್ಯಗಳ ಮೇಲೆ ಅಧಿಕಾರಿಯನ್ನಾಗಿ ನೇಮಿಸುವೆನು. ನೀನು ನಿನ್ನ ಯಜಮಾನನ ಸಂತೋಷದಲ್ಲಿ ಭಾಗಿಯಾಗು,’ ಎಂದನು.<verse eid="MAT 25:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 25:24"/>“ಆಗ ಒಂದು ಚಿನ್ನದ ನಾಣ್ಯ ಹೊಂದಿದ್ದವನು ಬಂದು, ‘ಒಡೆಯನೇ, ನೀನು ಬಿತ್ತದಿರುವಲ್ಲಿ ಕೊಯ್ಯುವವನೂ ತೂರದಿರುವಲ್ಲಿ ಕೂಡಿಸುವವನೂ ಆಗಿರುವ ಕಠಿಣ ಮನುಷ್ಯನೆಂದು ನಾನು ಬಲ್ಲೆನು. <verse eid="MAT 25:24"/><verse number="25" style="v" sid="MAT 25:25"/>ಆದ್ದರಿಂದ ನಾನು ಭಯಪಟ್ಟು ಹೋಗಿ ನಿನ್ನ ಚಿನ್ನದ ನಾಣ್ಯವನ್ನು ಭೂಮಿಯಲ್ಲಿ ಬಚ್ಚಿಟ್ಟೆನು. ನೋಡು, ನೀನು ಕೊಟ್ಟಿದ್ದನ್ನು ನಿನಗೇ ಕೊಡುತ್ತೇನೆ,’ ಎಂದನು.<verse eid="MAT 25:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 25:26"/>“ಅದಕ್ಕೆ ಅವನ ಯಜಮಾನನು ಉತ್ತರವಾಗಿ, ‘ಮೈಗಳ್ಳನಾದ ದುಷ್ಟ ಸೇವಕನೇ, ನಾನು ಬಿತ್ತದಿರುವಲ್ಲಿ ಕೊಯ್ಯುವವನೆಂತಲೂ ತೂರದಿರುವಲ್ಲಿ ಕೂಡಿಸುವವನೆಂತಲೂ ನೀನು ತಿಳಿದಿದ್ದೀಯಲ್ಲಾ. <verse eid="MAT 25:26"/><verse number="27" style="v" sid="MAT 25:27"/>ಹಾಗಿದ್ದರೆ, ನೀನು ನನ್ನ ಹಣವನ್ನು ಬಡ್ಡಿ ಅಂಗಡಿಯಲ್ಲಿ ಕೊಡಬೇಕಾಗಿತ್ತು; ನಾನು ಬಂದಾಗ ಹಣವನ್ನು ಬಡ್ಡಿ ಸಮೇತವಾಗಿ ಪಡೆದುಕೊಳ್ಳುತ್ತಿದ್ದೆನು,’ ಎಂದು ಹೇಳಿ,<verse eid="MAT 25:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 25:28"/>“ತನ್ನ ಸೇವಕರಿಗೆ, ‘ಅವನಿಂದ ಆ ಚಿನ್ನದ ನಾಣ್ಯವನ್ನು ತೆಗೆದುಕೊಂಡು ಹತ್ತು ಚಿನ್ನದ ನಾಣ್ಯಗಳು ಇದ್ದವನಿಗೆ ಕೊಡಿರಿ. <verse eid="MAT 25:28"/><verse number="29" style="v" sid="MAT 25:29"/>ಇದ್ದವರಿಗೆ ಇನ್ನೂ ಹೆಚ್ಚಾಗಿ ಕೊಡಲಾಗುವುದು, ಅವರಿಗೆ ಹೆಚ್ಚು ಸಮೃದ್ಧಿಯಾಗುವುದು. ಇಲ್ಲದವರ ಕಡೆಯಿಂದ ಇದ್ದ ಅಲ್ಪವನ್ನೂ ತೆಗೆದುಕೊಳ್ಳಲಾಗುವುದು. <verse eid="MAT 25:29"/><verse number="30" style="v" sid="MAT 25:30"/>ನಿಷ್ಪ್ರಯೋಜಕನಾದ ಆ ಸೇವಕನನ್ನು ನೀವು ಹೊರಗೆ ಕತ್ತಲೆಯಲ್ಲಿ ಹಾಕಿರಿ. ಅಲ್ಲಿ ಗೋಳಾಟವೂ ಹಲ್ಲು ಕಡಿಯೋಣವೂ ಇರುವವು,’ ಎಂದನು.<verse eid="MAT 25:30"/></para>
  <para style="s1">ಕುರಿ ಆಡುಗಳ ಸಾಮ್ಯ</para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 25:31"/>“ಮನುಷ್ಯಪುತ್ರನಾದ ನಾನು ಮಹಿಮೆಯಲ್ಲಿ ಎಲ್ಲಾ ಪರಿಶುದ್ಧ ದೂತರೊಂದಿಗೆ ಬರುವಾಗ, ನನ್ನ ಮಹಿಮೆಯ ಸಿಂಹಾಸನದ ಮೇಲೆ ಕುಳಿತುಕೊಳ್ಳುವೆನು. <verse eid="MAT 25:31"/><verse number="32" style="v" sid="MAT 25:32"/>ನನ್ನ ಮುಂದೆ ಎಲ್ಲಾ ಜನಾಂಗದವರನ್ನು ಒಟ್ಟುಗೂಡಿಸಲಾಗುವುದು. ಆಗ ಕುರುಬನು ತನ್ನ ಕುರಿಗಳನ್ನು ಆಡುಗಳಿಂದ ಪ್ರತ್ಯೇಕಿಸುವಂತೆಯೇ ನಾನು ಅವರನ್ನು ಪ್ರತ್ಯೇಕಿಸುವೆನು. <verse eid="MAT 25:32"/><verse number="33" style="v" sid="MAT 25:33"/>ನಾನು ಕುರಿಗಳನ್ನು ನನ್ನ ಬಲಗಡೆಯಲ್ಲಿಯೂ ಆಡುಗಳನ್ನು ಎಡಗಡೆಯಲ್ಲಿಯೂ ನಿಲ್ಲಿಸುವೆನು.<verse eid="MAT 25:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 25:34"/>“ಆಗ ನಾನು ನನ್ನ ಬಲಗಡೆಯಲ್ಲಿರುವವರಿಗೆ, ‘ನನ್ನ ತಂದೆಯಿಂದ ಆಶೀರ್ವಾದ ಹೊಂದಿದವರೇ, ಬನ್ನಿರಿ, ಭೂಲೋಕಕ್ಕೆ ಅಸ್ತಿವಾರ ಹಾಕಿದ ದಿನದಿಂದ ನಿಮಗೋಸ್ಕರ ಸಿದ್ಧಮಾಡಿದ ರಾಜ್ಯವನ್ನು ಆಸ್ತಿಯನ್ನಾಗಿ ಹೊಂದಿರಿ. <verse eid="MAT 25:34"/><verse number="35" style="v" sid="MAT 25:35"/>ನಾನು ಹಸಿದಿದ್ದೆನು, ನೀವು ನನಗೆ ಊಟವನ್ನು ಕೊಟ್ಟಿರಿ. ನಾನು ಬಾಯಾರಿದ್ದೆನು, ನೀವು ನನಗೆ ಕುಡಿಯುವುದಕ್ಕೆ ಕೊಟ್ಟಿರಿ. ನಾನು ಪರದೇಶಿಯಾಗಿದ್ದೆನು, ನೀವು ನನಗೆ ಆಶ್ರಯ ಕೊಟ್ಟಿರಿ. <verse eid="MAT 25:35"/><verse number="36" style="v" sid="MAT 25:36"/>ನಾನು ಬಟ್ಟೆಯಿಲ್ಲದವನಾಗಿದ್ದೆನು, ನೀವು ನನಗೆ ಉಡಿಸಿದಿರಿ. ನಾನು ಅಸ್ವಸ್ಥನಾಗಿದ್ದೆನು, ನೀವು ನನ್ನನ್ನು ಉಪಚರಿಸಿದಿರಿ. ನಾನು ಸೆರೆಯಲ್ಲಿದ್ದೆನು, ನೀವು ನನ್ನ ಬಳಿಗೆ ಬಂದಿರಿ,’ ಎಂದು ಹೇಳುವೆನು.<verse eid="MAT 25:36"/></para>
  <para style="p">
    <verse number="37" style="v" sid="MAT 25:37"/>“ಆಗ ಆ ನೀತಿವಂತರು ಉತ್ತರವಾಗಿ ನನಗೆ, ‘ಕರ್ತನೇ, ನೀನು ಯಾವಾಗ ಹಸಿದದ್ದನ್ನು ನೋಡಿ ನಾವು ನಿನಗೆ ಉಣಿಸಿದೆವು? ಇಲ್ಲವೆ ಬಾಯಾರಿದ್ದಾಗ ನಿನಗೆ ಕುಡಿಯುವುದಕ್ಕೆ ಕೊಟ್ಟೆವು? <verse eid="MAT 25:37"/><verse number="38" style="v" sid="MAT 25:38"/>ನೀನು ಪರದೇಶಿಯಾಗಿರುವುದನ್ನು ನಾವು ಯಾವಾಗ ಕಂಡು ನಿನಗೆ ಆಶ್ರಯ ಕೊಟ್ಟೆವು? ಇಲ್ಲವೆ ಬಟ್ಟೆಯಿಲ್ಲದಿರುವಾಗ ನಿನಗೆ ಉಡಿಸಿದೆವು? <verse eid="MAT 25:38"/><verse number="39" style="v" sid="MAT 25:39"/>ಯಾವಾಗ ನೀನು ಅಸ್ವಸ್ಥನಾಗಿ ಇಲ್ಲವೆ ಸೆರೆಯಲ್ಲಿದ್ದಾಗ ನಾವು ನಿನ್ನ ಬಳಿಗೆ ಬಂದೆವು?’ ಎಂದು ಕೇಳುವರು.<verse eid="MAT 25:39"/></para>
  <para style="p">
    <verse number="40" style="v" sid="MAT 25:40"/>“ಅದಕ್ಕೆ ನಾನು ಉತ್ತರವಾಗಿ ಅವರಿಗೆ, ‘ನಾನು ನಿಮಗೆ ನಿಜವಾಗಿ ಹೇಳುತ್ತೇನೆ: ನೀವು ಈ ನನ್ನ ಸಹೋದರರಲ್ಲಿ ಅತ್ಯಲ್ಪನಾದವನೊಬ್ಬನಿಗೆ, ಮಾಡಿದ್ದು ನನಗೇ ಮಾಡಿದಂತಾಯಿತು,’ ಎನ್ನುವೆನು.<verse eid="MAT 25:40"/></para>
  <para style="p">
    <verse number="41" style="v" sid="MAT 25:41"/>“ನಾನು ಎಡಗಡೆಯಲ್ಲಿರುವವರಿಗೆ, ‘ಶಾಪಗ್ರಸ್ತರೇ, ನೀವು ನನ್ನಿಂದ ತೊಲಗಿ ಸೈತಾನನಿಗೂ ಅವನ ದೂತರಿಗೂ ಸಿದ್ಧಮಾಡಿರುವ ನಿತ್ಯ ಬೆಂಕಿಯೊಳಕ್ಕೆ ಹೋಗಿರಿ. <verse eid="MAT 25:41"/><verse number="42" style="v" sid="MAT 25:42"/>ನಾನು ಹಸಿದಿದ್ದೆನು, ನೀವು ನನಗೆ ಊಟ ಕೊಡಲಿಲ್ಲ. ನಾನು ಬಾಯಾರಿದವನಾಗಿದ್ದೆನು, ನೀವು ನನಗೆ ಕುಡಿಯುವುದಕ್ಕೆ ಕೊಡಲಿಲ್ಲ. <verse eid="MAT 25:42"/><verse number="43" style="v" sid="MAT 25:43"/>ನಾನು ಪರದೇಶಿಯಾಗಿದ್ದೆನು, ನೀವು ನನ್ನನ್ನು ಒಳಕ್ಕೆ ಸೇರಿಸಿಕೊಳ್ಳಲಿಲ್ಲ. ಬಟ್ಟೆಯಿಲ್ಲದವನಾಗಿದ್ದಾಗ ನೀವು ನನಗೆ ಉಡಿಸಲಿಲ್ಲ. ಅಸ್ವಸ್ಥನಾಗಿದ್ದೆನು, ಸೆರೆಮನೆಯಲ್ಲಿದ್ದೆನು, ನೀವು ನನ್ನನ್ನು ಸಂದರ್ಶಿಸಲಿಲ್ಲ,’ ಎಂದು ಹೇಳುವೆನು.<verse eid="MAT 25:43"/></para>
  <para style="p">
    <verse number="44" style="v" sid="MAT 25:44"/>“ಆಗ ಅವರು ಸಹ ಉತ್ತರವಾಗಿ ನನಗೆ, ‘ಕರ್ತನೇ, ನೀನು ಹಸಿದಿದ್ದನ್ನೂ ಬಾಯಾರಿದ್ದನ್ನೂ ಪರದೇಶಿಯಾದದ್ದನ್ನೂ ಬಟ್ಟೆಯಿಲ್ಲದವನಾಗಿದ್ದದ್ದನ್ನೂ ಅಸ್ವಸ್ಥನಾಗಿದ್ದದ್ದನ್ನೂ ಸೆರೆಯಲ್ಲಿದ್ದದ್ದನ್ನೂ ನಾವು ಯಾವಾಗ ನೋಡಿ ನಿನಗೆ ಉಪಚಾರಮಾಡಲಿಲ್ಲ?’ ಎಂದು ಕೇಳುವರು.<verse eid="MAT 25:44"/></para>
  <para style="p">
    <verse number="45" style="v" sid="MAT 25:45"/>“ಆಗ ನಾನು ಅವರಿಗೆ ಉತ್ತರವಾಗಿ, ‘ನಾನು ನಿಮಗೆ ಸತ್ಯವಾಗಿ ಹೇಳುವುದೇನೆಂದರೆ, ನೀವು ಇವರಲ್ಲಿ ಅತ್ಯಲ್ಪನಾದ ಒಬ್ಬನಿಗೆ ಏನೇನು ಮಾಡಲಿಲ್ಲವೋ ಅದನ್ನು ನನಗೂ ಮಾಡಲಿಲ್ಲ,’ ಎಂದು ಹೇಳುವೆನು.<verse eid="MAT 25:45"/></para>
  <para style="p">
    <verse number="46" style="v" sid="MAT 25:46"/>“ಹೀಗೆ ಇವರು ನಿತ್ಯವಾದ ಶಿಕ್ಷೆಗೆ ಒಳಗಾಗುವರು. ಆದರೆ ನೀತಿವಂತರು ನಿತ್ಯಜೀವಕ್ಕೆ ಹೋಗುವರು,” ಎಂದು ಹೇಳುವೆನು.<verse eid="MAT 25:46"/></para>
  <chapter eid="MAT 25"/>
  <chapter number="26" style="c" sid="MAT 26"/>
  <para style="s1">ಯೇಸುವಿನ ವಿರುದ್ಧ ಪಿತೂರಿ</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 26:1"/>ಯೇಸು ಈ ಮಾತುಗಳನ್ನೆಲ್ಲಾ ಹೇಳಿ ಮುಗಿಸಿದ ನಂತರ ತಮ್ಮ ಶಿಷ್ಯರಿಗೆ, <verse eid="MAT 26:1"/><verse number="2" style="v" sid="MAT 26:2"/>“ಎರಡು ದಿವಸಗಳಾದ ಮೇಲೆ ಪಸ್ಕಹಬ್ಬ ಇರುವುದೆಂದು ನೀವು ಬಲ್ಲಿರಿ. ಆಗ ಮನುಷ್ಯಪುತ್ರನಾದ ನನ್ನನ್ನು ಶಿಲುಬೆಗೆ ಹಾಕಲು ಹಿಡಿದುಕೊಡುವರು,” ಎಂದರು.<verse eid="MAT 26:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 26:3"/>ಆಗ ಮುಖ್ಯಯಾಜಕರೂ ಜನರ ಹಿರಿಯರೂ ಒಟ್ಟಾಗಿ ಸೇರಿ, ಕಾಯಫನೆಂಬ ಮಹಾಯಾಜಕನ ಅರಮನೆಗೆ ಬಂದು <verse eid="MAT 26:3"/><verse number="4" style="v" sid="MAT 26:4"/>ತಾವು ಕುಯುಕ್ತಿಯಿಂದ ಯೇಸುವನ್ನು ಹಿಡಿದು ಕೊಲ್ಲಬೇಕೆಂದು ಆಲೋಚನೆ ಮಾಡಿಕೊಂಡರು. <verse eid="MAT 26:4"/><verse number="5" style="v" sid="MAT 26:5"/>ಆದರೆ ಅವರು, “ಜನರಲ್ಲಿ ಗದ್ದಲವಾದೀತು, ಹಬ್ಬದಲ್ಲಿ ಬೇಡ,” ಎಂದರು.<verse eid="MAT 26:5"/></para>
  <para style="s1">ಬೇಥಾನ್ಯದಲ್ಲಿ ಯೇಸು</para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 26:6"/>ಯೇಸು ಬೇಥಾನ್ಯದಲ್ಲಿ ಕುಷ್ಠರೋಗಿಯಾದ ಸೀಮೋನನ ಮನೆಯಲ್ಲಿದ್ದರು. <verse eid="MAT 26:6"/><verse number="7" style="v" sid="MAT 26:7"/>ಯೇಸು ಅಲ್ಲಿ ಊಟಕ್ಕೆ ಕುಳಿತಿದ್ದಾಗ ಒಬ್ಬ ಸ್ತ್ರೀಯು ಬಹು ಬೆಲೆಯುಳ್ಳ ಸುಗಂಧ ತೈಲದ ಭರಣಿಯೊಂದಿಗೆ ಯೇಸುವಿನ ಬಳಿಗೆ ಬಂದು, ಅದನ್ನು ಅವರ ತಲೆಯ ಮೇಲೆ ಸುರಿದಳು.<verse eid="MAT 26:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 26:8"/>ಯೇಸುವಿನ ಶಿಷ್ಯರು ಇದನ್ನು ಕಂಡು ಕೋಪಗೊಂಡು, “ಏಕೆ ಈ ವ್ಯರ್ಥ ಖರ್ಚು? <verse eid="MAT 26:8"/><verse number="9" style="v" sid="MAT 26:9"/>ಈ ತೈಲವನ್ನು ಹೆಚ್ಚಿನ ಬೆಲೆಗೆ ಮಾರಿ ಬಡವರಿಗೆ ಕೊಡಬಹುದಾಗಿತ್ತಲ್ಲಾ?” ಎಂದರು.<verse eid="MAT 26:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 26:10"/>ಯೇಸು ಅದನ್ನು ತಿಳಿದವರಾಗಿ ಅವರಿಗೆ, “ನೀವು ಏಕೆ ಈ ಸ್ತ್ರೀಗೆ ತೊಂದರೆಪಡಿಸುತ್ತೀರಿ? ಈಕೆ ನನಗೆ ಒಳ್ಳೆಯ ಕಾರ್ಯವನ್ನು ಮಾಡಿದ್ದಾಳೆ. <verse eid="MAT 26:10"/><verse number="11" style="v" sid="MAT 26:11"/>ಬಡವರು ಯಾವಾಗಲೂ ನಿಮ್ಮ ಸಂಗಡ ಇರುತ್ತಾರೆ.<note caller="+" style="f"><char style="fr" closed="false">26:11 </char><char style="ft" closed="false"><char style="xt"><ref loc="DEU 15:11">ಧರ್ಮೋ 15:11</ref></char></char></note> ಆದರೆ ನಾನು ಯಾವಾಗಲೂ ನಿಮ್ಮ ಸಂಗಡ ಇರುವುದಿಲ್ಲ. <verse eid="MAT 26:11"/><verse number="12" style="v" sid="MAT 26:12"/>ಈಕೆ ಈ ತೈಲವನ್ನು ನನ್ನ ದೇಹದ ಮೇಲೆ ಸುರಿದದ್ದರಿಂದ, ನನ್ನ ಶವಸಂಸ್ಕಾರಕ್ಕೆ ಸಿದ್ಧಮಾಡಿದ್ದಾಳೆ. <verse eid="MAT 26:12"/><verse number="13" style="v" sid="MAT 26:13"/>ನಾನು ನಿಮಗೆ ನಿಜವಾಗಿ ಹೇಳುತ್ತೇನೆ, ಲೋಕದಾದ್ಯಂತ ಎಲ್ಲೆಲ್ಲಿ ಸುವಾರ್ತೆಯು ಸಾರಲಾಗುವದೋ, ಅಲ್ಲೆಲ್ಲಾ ಈ ಸ್ತ್ರೀಯು ಮಾಡಿದ್ದನ್ನು ಸಹ ಈಕೆಯ ಜ್ಞಾಪಕಾರ್ಥವಾಗಿ ಹೇಳಲಾಗುವುದು,” ಎಂದರು.<verse eid="MAT 26:13"/></para>
  <para style="s1">ಯೇಸುವನ್ನು ಹಿಡಿದುಕೊಡಲು ಯೂದನು ಒಪ್ಪಿದ್ದು</para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 26:14"/>ಆಗ ಹನ್ನೆರಡು ಮಂದಿ ಶಿಷ್ಯರಲ್ಲಿ ಒಬ್ಬನಾದ ಯೂದ ಇಸ್ಕರಿಯೋತ ಎಂಬುವನು ಮುಖ್ಯಯಾಜಕರ ಬಳಿಗೆ ಹೋಗಿ, <verse eid="MAT 26:14"/><verse number="15" style="v" sid="MAT 26:15"/>“ನಾನು ಆತನನ್ನು ನಿಮಗೆ ಒಪ್ಪಿಸಿಕೊಟ್ಟರೆ ನೀವು ನನಗೆ ಏನು ಕೊಡುತ್ತೀರಿ?” ಎಂದನು. ಆಗ ಅವರು ಅವನಿಗೆ ಮೂವತ್ತು ಬೆಳ್ಳಿಯ ನಾಣ್ಯಗಳನ್ನು ಎಣಿಸಿ ಕೊಟ್ಟರು. <verse eid="MAT 26:15"/><verse number="16" style="v" sid="MAT 26:16"/>ಅಂದಿನಿಂದ ಯೂದನು ಯೇಸುವನ್ನು ಹಿಡಿದುಕೊಡುವುದಕ್ಕೆ ಸಂದರ್ಭವನ್ನು ಕಾಯುತ್ತಿದ್ದನು.<verse eid="MAT 26:16"/></para>
  <para style="s1">ಕರ್ತನ ಭೋಜನ</para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 26:17"/>ಹುಳಿಯಿಲ್ಲದ ರೊಟ್ಟಿಯ ಹಬ್ಬದ ಮೊದಲನೆಯ ದಿನದಲ್ಲಿ ಶಿಷ್ಯರು ಯೇಸುವಿನ ಬಳಿಗೆ ಬಂದು, “ನೀವು ಪಸ್ಕದ ಊಟ ಮಾಡಲು ನಾವು ನಿಮಗಾಗಿ ಎಲ್ಲಿ ಸಿದ್ಧಮಾಡಬೇಕೆಂದು ಬಯಸುತ್ತೀರಿ?” ಎಂದು ಕೇಳಿದರು.<verse eid="MAT 26:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 26:18"/>ಅದಕ್ಕೆ ಯೇಸು, “ನೀವು ಪಟ್ಟಣದೊಳಕ್ಕೆ ಇಂಥವನ ಬಳಿಗೆ ಹೋಗಿ, ‘ನನ್ನ ಸಮಯವು ಸಮೀಪವಾಗಿದೆ. ನನ್ನ ಶಿಷ್ಯರ ಜೊತೆಗೆ ನಿನ್ನ ಮನೆಯಲ್ಲಿ ಪಸ್ಕವನ್ನು ಆಚರಿಸುತ್ತೇನೆಂದು ಬೋಧಕರು ಕೇಳುತ್ತಾರೆ’ ಎಂಬುದಾಗಿ ಅವನಿಗೆ ಹೇಳಿರಿ,” ಎಂದರು. <verse eid="MAT 26:18"/><verse number="19" style="v" sid="MAT 26:19"/>ಯೇಸು ಅವರಿಗೆ ಆಜ್ಞಾಪಿಸಿದಂತೆ ಶಿಷ್ಯರು ಪಸ್ಕವನ್ನು ಸಿದ್ಧಮಾಡಿದರು.<verse eid="MAT 26:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 26:20"/>ಸಂಜೆಯಾದಾಗ, ಯೇಸು ಹನ್ನೆರಡು ಮಂದಿ ಶಿಷ್ಯರೊಂದಿಗೆ ಊಟಕ್ಕೆ ಕುಳಿತುಕೊಂಡರು. <verse eid="MAT 26:20"/><verse number="21" style="v" sid="MAT 26:21"/>ಅವರು ಊಟಮಾಡುತ್ತಿದ್ದಾಗ ಯೇಸು, “ನಾನು ನಿಮಗೆ ನಿಜವಾಗಿ ಹೇಳುತ್ತೇನೆ, ನಿಮ್ಮಲ್ಲಿ ಒಬ್ಬನು ನನಗೆ ದ್ರೋಹ ಮಾಡುವನು,” ಎಂದರು.<verse eid="MAT 26:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 26:22"/>ಆಗ ಅವರು ದುಃಖಪಟ್ಟು, “ಕರ್ತನೇ, ಅವನು ನಾನಲ್ಲವಲ್ಲಾ?” ಎಂದು ಅವರಲ್ಲಿ ಪ್ರತಿಯೊಬ್ಬರೂ ಯೇಸುವನ್ನು ಕೇಳಲಾರಂಭಿಸಿದರು.<verse eid="MAT 26:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 26:23"/>ಅದಕ್ಕೆ ಯೇಸು ಉತ್ತರವಾಗಿ, “ನನ್ನ ಸಂಗಡ ಪಾತ್ರೆಯಲ್ಲಿ ಕೈ ಅದ್ದಿದವನೇ ನನಗೆ ದ್ರೋಹ ಮಾಡುವನು. <verse eid="MAT 26:23"/><verse number="24" style="v" sid="MAT 26:24"/>ಮನುಷ್ಯಪುತ್ರನಾದ ನನ್ನ ವಿಷಯದಲ್ಲಿ ಬರೆದಿರುವ ಪ್ರಕಾರ ಹೊರಟುಹೋಗುತ್ತೇನೆ. ಆದರೆ ಮನುಷ್ಯಪುತ್ರನಾದ ನನಗೆ ಯಾವನು ದ್ರೋಹಬಗೆಯುತ್ತಾನೋ ಆ ಮನುಷ್ಯನಿಗೆ ಕಷ್ಟ! ಆ ಮನುಷ್ಯನು ಹುಟ್ಟದೆ ಹೋಗಿದ್ದರೆ ಅವನಿಗೆ ಎಷ್ಟೋ ಒಳ್ಳೆಯದಾಗುತ್ತಿತ್ತು,” ಎಂದರು.<verse eid="MAT 26:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 26:25"/>ಆಗ ಯೇಸುವನ್ನು ಹಿಡಿದುಕೊಡಬೇಕೆಂದಿದ್ದ ಯೂದನು, “ಗುರುವೇ, ಅವನು ನಾನಲ್ಲವಲ್ಲಾ?” ಎಂದನು.</para>
  <para style="p" vid="MAT 26:25">“ನೀನೇ ಹೇಳಿದ್ದೀ,” ಎಂದು ಯೇಸು ಉತ್ತರಕೊಟ್ಟರು.<verse eid="MAT 26:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 26:26"/>ಅವರು ಊಟಮಾಡುತ್ತಿರುವಾಗ, ಯೇಸು ರೊಟ್ಟಿಯನ್ನು ತೆಗೆದುಕೊಂಡು ಅದನ್ನು ಆಶೀರ್ವದಿಸಿ, ಮುರಿದು ತಮ್ಮ ಶಿಷ್ಯರಿಗೆ ಕೊಟ್ಟು, “ತೆಗೆದುಕೊಳ್ಳಿರಿ, ತಿನ್ನಿರಿ, ಇದು ನನ್ನ ದೇಹ,” ಎಂದರು.<verse eid="MAT 26:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 26:27"/>ಪಾತ್ರೆಯನ್ನು ತೆಗೆದುಕೊಂಡು ದೇವರಿಗೆ ಕೃತಜ್ಞತಾಸ್ತುತಿ ಮಾಡಿ ಅವರಿಗೆ ಕೊಟ್ಟು, “ನೀವೆಲ್ಲರೂ ಇದರಲ್ಲಿರುವುದನ್ನು ಕುಡಿಯಿರಿ. <verse eid="MAT 26:27"/><verse number="28" style="v" sid="MAT 26:28"/>ಇದು ಬಹುಜನರ ಪಾಪಗಳ ಪರಿಹಾರಕ್ಕೋಸ್ಕರ ಸುರಿಸಲಾಗುವ ಹೊಸ ಒಡಂಬಡಿಕೆಯ ನನ್ನ ರಕ್ತ. <verse eid="MAT 26:28"/><verse number="29" style="v" sid="MAT 26:29"/>ನಾನು ನಿಮಗೆ ಹೇಳುವುದೇನೆಂದರೆ, ಇಂದಿನಿಂದ ನನ್ನ ತಂದೆಯ ರಾಜ್ಯದಲ್ಲಿ ನಿಮ್ಮೊಂದಿಗೆ ಹೊಸದಾಗಿ ಕುಡಿಯುವ ಆ ದಿನದವರೆಗೆ ನಾನು ಈ ದ್ರಾಕ್ಷಾರಸವನ್ನು ಕುಡಿಯುವುದೇ ಇಲ್ಲ,” ಎಂದರು.<verse eid="MAT 26:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="MAT 26:30"/>ಬಳಿಕ ಅವರೆಲ್ಲರು ಒಂದು ಕೀರ್ತನೆ ಹಾಡಿ ಓಲಿವ್ ಗುಡ್ಡಕ್ಕೆ ಹೊರಟು ಹೋದರು.<verse eid="MAT 26:30"/></para>
  <para style="s1">ಪೇತ್ರನು ತನ್ನನ್ನು ಅಲ್ಲಗಳೆಯುವನೆಂದು ಯೇಸು ಮುಂತಿಳಿಸಿದ್ದು</para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 26:31"/>ಆಗ ಯೇಸು ಅವರಿಗೆ, “ನೀವೆಲ್ಲರೂ ಈ ರಾತ್ರಿ ನನ್ನನ್ನು ಬಿಟ್ಟು ಓಡಿಹೋಗುವಿರಿ. ಪವಿತ್ರ ವೇದದಲ್ಲಿ ಹೀಗೆ ಬರೆದಿದೆ:</para>
  <para style="q1" vid="MAT 26:31">“ ‘ಏಕೆಂದರೆ ನಾನು ಕುರುಬನನ್ನು ಹೊಡೆಯುವೆನು,</para>
  <para style="q2" vid="MAT 26:31">ಮಂದೆಯ ಕುರಿಗಳು ಚದರಿಹೋಗುವುವು,’<note caller="+" style="f"><char style="fr" closed="false">26:31 </char><char style="ft" closed="false"><char style="xt"><ref loc="ZEC 13:7">ಜೆಕರ್ಯ 13:7</ref></char></char></note><verse eid="MAT 26:31"/></para>
  <para style="m">
    <verse number="32" style="v" sid="MAT 26:32"/>ಆದರೆ ನಾನು ಎದ್ದ ಮೇಲೆ, ನಿಮಗಿಂತ ಮುಂದಾಗಿ ಗಲಿಲಾಯಕ್ಕೆ ಹೋಗುವೆನು,” ಎಂದು ಹೇಳಿದರು.<verse eid="MAT 26:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 26:33"/>ಆಗ ಪೇತ್ರನು ಯೇಸುವಿಗೆ, “ಎಲ್ಲರೂ ನಿಮ್ಮನ್ನು ಬಿಟ್ಟು ಹೋದರೂ ನಾನು ನಿಮ್ಮನ್ನು ಬಿಟ್ಟು ಹೋಗುವುದಿಲ್ಲ,” ಎಂದನು.<verse eid="MAT 26:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 26:34"/>ಯೇಸು ಅವನಿಗೆ, “ಈ ರಾತ್ರಿಯಲ್ಲಿ ಹುಂಜ ಕೂಗುವುದಕ್ಕಿಂತ ಮುಂಚೆ, ನೀನು ಮೂರು ಸಾರಿ ನನ್ನನ್ನು ನಿರಾಕರಿಸುವೆ ಎಂದು ನಾನು ನಿನಗೆ ಸತ್ಯವಾಗಿ ಹೇಳುತ್ತೇನೆ,” ಎಂದರು.<verse eid="MAT 26:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="MAT 26:35"/>ಅದಕ್ಕೆ ಪೇತ್ರನು ಯೇಸುವಿಗೆ, “ನಾನು ನಿಮ್ಮೊಂದಿಗೆ ಸಾಯಬೇಕಾದರೂ ನಿಮ್ಮನ್ನು ನಿರಾಕರಿಸುವುದೇ ಇಲ್ಲ,” ಎಂದನು. ಅದರಂತೆಯೇ ಉಳಿದ ಶಿಷ್ಯರೆಲ್ಲರೂ ಹೇಳಿದರು.<verse eid="MAT 26:35"/></para>
  <para style="s1">ಗೆತ್ಸೇಮನೆ</para>
  <para style="p">
    <verse number="36" style="v" sid="MAT 26:36"/>ತರುವಾಯ ಯೇಸು ತಮ್ಮ ಶಿಷ್ಯರ ಸಂಗಡ ಗೆತ್ಸೇಮನೆ ಎಂಬ ಸ್ಥಳಕ್ಕೆ ಬಂದು ಅವರಿಗೆ, “ನಾನು ಅಲ್ಲಿಗೆ ಹೋಗಿ ಪ್ರಾರ್ಥಿಸುವವರೆಗೆ ನೀವು ಇಲ್ಲೇ ಕುಳಿತುಕೊಳ್ಳಿರಿ,” ಎಂದರು. <verse eid="MAT 26:36"/><verse number="37" style="v" sid="MAT 26:37"/>ಯೇಸು ತಮ್ಮ ಜೊತೆಯಲ್ಲಿ ಪೇತ್ರನನ್ನೂ ಜೆಬೆದಾಯನ ಇಬ್ಬರು ಪುತ್ರರನ್ನೂ ಕರೆದುಕೊಂಡು ಹೋಗಿ, ದುಃಖಿಸುವುದಕ್ಕೂ ಬಹು ವ್ಯಥೆಪಡುವುದಕ್ಕೂ ಆರಂಭಿಸಿದರು. <verse eid="MAT 26:37"/><verse number="38" style="v" sid="MAT 26:38"/>ಯೇಸು ಅವರಿಗೆ, “ನನ್ನ ಪ್ರಾಣವು ಸಾಯುವಷ್ಟು ತೀವ್ರವಾದ ದುಃಖಕ್ಕೆ ಒಳಗಾಗಿದೆ. ನೀವು ಇಲ್ಲೇ ಇದ್ದು ನನ್ನೊಡನೆ ಎಚ್ಚರವಾಗಿರಿ,” ಎಂದರು.<verse eid="MAT 26:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="MAT 26:39"/>ಆಮೇಲೆ ಯೇಸು ಸ್ವಲ್ಪ ಮುಂದಕ್ಕೆ ಹೋಗಿ, ಬೋರಲು ಬಿದ್ದು ಪ್ರಾರ್ಥಿಸುತ್ತಾ, “ನನ್ನ ತಂದೆಯೇ, ಸಾಧ್ಯವಾದರೆ ಈ ಪಾತ್ರೆಯು ನನ್ನನ್ನು ಬಿಟ್ಟು ಹೋಗಲಿ. ಆದರೂ ನನ್ನ ಚಿತ್ತದಂತಲ್ಲ, ನಿನ್ನ ಚಿತ್ತದಂತೆಯೇ ಆಗಲಿ,” ಎಂದರು.<verse eid="MAT 26:39"/></para>
  <para style="p">
    <verse number="40" style="v" sid="MAT 26:40"/>ತರುವಾಯ ಯೇಸು ಬಂದು, ಶಿಷ್ಯರು ನಿದ್ರೆ ಮಾಡುವುದನ್ನು ಕಂಡು ಪೇತ್ರನಿಗೆ, “ಏನು, ನೀವು ಒಂದು ಗಳಿಗೆಯಾದರೂ ನನ್ನೊಡನೆ ಎಚ್ಚರವಾಗಿರಲಾರಿರಾ? <verse eid="MAT 26:40"/><verse number="41" style="v" sid="MAT 26:41"/>ನೀವು ಶೋಧನೆಗೆ ಒಳಗಾಗದಂತೆ ಎಚ್ಚರವಾಗಿದ್ದು ಪ್ರಾರ್ಥಿಸಿರಿ. ಆತ್ಮವು ಸಿದ್ಧವಾಗಿದೆ, ಆದರೆ ಶರೀರವು ಬಲಹೀನವಾಗಿದೆ,” ಎಂದು ಹೇಳಿದರು.<verse eid="MAT 26:41"/></para>
  <para style="p">
    <verse number="42" style="v" sid="MAT 26:42"/>ಯೇಸು ಎರಡನೆಯ ಸಾರಿ ಹೋಗಿ, ಪ್ರಾರ್ಥಿಸುತ್ತಾ, “ನನ್ನ ತಂದೆಯೇ ನಾನು ಕುಡಿಯದ ಹೊರತು ಈ ಪಾತ್ರೆಯು ನನ್ನನ್ನು ಬಿಟ್ಟು ಹೋಗಕೂಡದಾಗಿದ್ದರೆ, ನಿನ್ನ ಚಿತ್ತವೇ ಆಗಲಿ,” ಎಂದರು.<verse eid="MAT 26:42"/></para>
  <para style="p">
    <verse number="43" style="v" sid="MAT 26:43"/>ಯೇಸು ಹಿಂತಿರುಗಿದಾಗ, ಅವರು ತಿರುಗಿ ನಿದ್ರೆ ಮಾಡುವುದನ್ನು ಕಂಡರು. ಅವರ ಕಣ್ಣುಗಳು ಭಾರವಾಗಿದ್ದವು. <verse eid="MAT 26:43"/><verse number="44" style="v" sid="MAT 26:44"/>ಯೇಸು ಅವರನ್ನು ಬಿಟ್ಟು ಹೊರಟುಹೋಗಿ ಮೂರನೆಯ ಸಾರಿ ಅದೇ ಮಾತುಗಳನ್ನು ಪುನಃ ಹೇಳಿ ಪ್ರಾರ್ಥಿಸಿದರು.<verse eid="MAT 26:44"/></para>
  <para style="p">
    <verse number="45" style="v" sid="MAT 26:45"/>ತರುವಾಯ ಯೇಸು ತಮ್ಮ ಶಿಷ್ಯರ ಬಳಿಗೆ ಬಂದು ಅವರಿಗೆ, “ಇನ್ನೂ ವಿಶ್ರಮಿಸುತ್ತಿದ್ದೀರಾ? ಇಗೋ, ಮನುಷ್ಯಪುತ್ರನಾದ ನಾನು ಪಾಪಿಗಳ ಕೈವಶವಾಗುವ ಸಮಯವು ಸಮೀಪಿಸಿದೆ. <verse eid="MAT 26:45"/><verse number="46" style="v" sid="MAT 26:46"/>ಏಳಿರಿ ಹೋಗೋಣ. ಇಗೋ, ನನಗೆ ದ್ರೋಹಬಗೆಯುವವನು ಸಮೀಪದಲ್ಲಿ ಇದ್ದಾನೆ,” ಎಂದು ಹೇಳಿದರು.<verse eid="MAT 26:46"/></para>
  <para style="s1">ಯೇಸುವನ್ನು ಬಂಧಿಸಿದ್ದು</para>
  <para style="p">
    <verse number="47" style="v" sid="MAT 26:47"/>ಯೇಸು ಇನ್ನೂ ಮಾತನಾಡುತ್ತಿರುವಾಗಲೇ, ಹನ್ನೆರಡು ಮಂದಿ ಶಿಷ್ಯರಲ್ಲಿ ಒಬ್ಬನಾದ ಯೂದನು ಬಂದನು. ಮುಖ್ಯಯಾಜಕರ ಮತ್ತು ಜನರ ಹಿರಿಯರ ಕಡೆಯಿಂದ ಬಂದಿದ್ದ ಜನರ ದೊಡ್ಡ ಸಮೂಹವು ಖಡ್ಗ ದೊಣ್ಣೆಗಳನ್ನು ಹಿಡಿದುಕೊಂಡು ಅವನೊಂದಿಗಿತ್ತು. <verse eid="MAT 26:47"/><verse number="48" style="v" sid="MAT 26:48"/>ಯೇಸುವಿಗೆ ದ್ರೋಹಮಾಡುವುದಕ್ಕಿದ್ದವನು ಅವರಿಗೆ, “ನಾನು ಯಾರಿಗೆ ಮುದ್ದಿಡುತ್ತೇನೋ ಆತನೇ ಯೇಸು; ಆತನನ್ನು ಹಿಡಿಯಿರಿ,” ಎಂದು ಗುರುತು ಹೇಳಿಕೊಟ್ಟಿದ್ದನು. <verse eid="MAT 26:48"/><verse number="49" style="v" sid="MAT 26:49"/>ಯೂದನು ಬಂದ ಕೂಡಲೇ ನೇರವಾಗಿ ಯೇಸುವಿನ ಕಡೆಗೆ ಹೋಗಿ, “ಗುರುವೇ, ನಮಸ್ಕಾರ,” ಎಂದು ಹೇಳಿ ಅವರಿಗೆ ಮುದ್ದಿಟ್ಟನು.<verse eid="MAT 26:49"/></para>
  <para style="p">
    <verse number="50" style="v" sid="MAT 26:50"/>ಅದಕ್ಕೆ ಯೇಸು ಅವನಿಗೆ, “ಸ್ನೇಹಿತನೇ, ನೀನು ಮಾಡಲು ಬಂದ ಕೆಲಸವನ್ನು ಮುಗಿಸು,”<note caller="+" style="f"><char style="fr" closed="false">26:50 </char><char style="ft" closed="false">ಅಥವಾ </char><char style="fqa" closed="false">ಸ್ನೇಹಿತನೇ, ನೀನು ಇಲ್ಲಿ ಬಂದದ್ದು ಏಕೆ?</char></note> ಎಂದು ಹೇಳಿದರು.</para>
  <para style="p" vid="MAT 26:50">ಕೂಡಲೇ ಆ ಜನರು ಮುಂದೆ ಬಂದು, ಯೇಸುವನ್ನು ಹಿಡಿದು ಬಂಧಿಸಿದರು. <verse eid="MAT 26:50"/><verse number="51" style="v" sid="MAT 26:51"/>ಆಗ, ಯೇಸುವಿನ ಸಂಗಡ ಇದ್ದವರಲ್ಲಿ ಒಬ್ಬನು ಕೈಚಾಚಿ ತನ್ನ ಖಡ್ಗವನ್ನು ಹಿರಿದು, ಮಹಾಯಾಜಕನ ಆಳನ್ನು ಹೊಡೆದು ಅವನ ಕಿವಿಯನ್ನು ಕಡಿದುಹಾಕಿದನು.<verse eid="MAT 26:51"/></para>
  <para style="p">
    <verse number="52" style="v" sid="MAT 26:52"/>ಆಗ ಯೇಸು ಅವನಿಗೆ, “ನಿನ್ನ ಖಡ್ಗವನ್ನು ತಿರುಗಿ ಅದರ ಒರೆಯಲ್ಲಿ ಹಾಕು. ಖಡ್ಗವನ್ನು ಹಿಡಿದವರೆಲ್ಲರೂ ಖಡ್ಗದಿಂದ ನಾಶವಾಗುವರು. <verse eid="MAT 26:52"/><verse number="53" style="v" sid="MAT 26:53"/>ನಾನು ಈಗ ನನ್ನ ತಂದೆಗೆ ಕೇಳಿಕೊಂಡರೆ ಅವರು ಈಗಲೇ ಹನ್ನೆರಡು ದಳಗಳಿಗಿಂತ ಹೆಚ್ಚಾದ ದೂತರನ್ನು ನನಗೆ ಕೊಡಲಾರರೆಂದು ನೀನು ನೆನಸುತ್ತೀಯಾ? <verse eid="MAT 26:53"/><verse number="54" style="v" sid="MAT 26:54"/>ಹಾಗಾದರೆ ಇವುಗಳು ಹೀಗೆಯೇ ಆಗಬೇಕೆಂಬ ಪವಿತ್ರ ವೇದದ ವಾಕ್ಯಗಳು ನೆರವೇರುವುದು ಹೇಗೆ?” ಎಂದರು.<verse eid="MAT 26:54"/></para>
  <para style="p">
    <verse number="55" style="v" sid="MAT 26:55"/>ಅದೇ ಗಳಿಗೆಯಲ್ಲಿ ಯೇಸು ಜನಸಮೂಹಕ್ಕೆ, “ಒಬ್ಬ ಕಳ್ಳನನ್ನು ಹಿಡಿಯುವುದಕ್ಕೆ ಬರುವಂತೆ ಖಡ್ಗಗಳೊಂದಿಗೆ ದೊಣ್ಣೆಗಳೊಂದಿಗೆ ನನ್ನನ್ನು ಹಿಡಿಯುವುದಕ್ಕಾಗಿ ಬಂದಿರಾ? ನಾನು ದಿನಾಲು ನಿಮ್ಮ ಸಂಗಡ ದೇವಾಲಯದಲ್ಲಿ ಕುಳಿತುಕೊಂಡು ಬೋಧಿಸುತ್ತಿದ್ದಾಗ, ನೀವು ನನ್ನನ್ನು ಹಿಡಿಯಲಿಲ್ಲ. <verse eid="MAT 26:55"/><verse number="56" style="v" sid="MAT 26:56"/>ಆದರೆ ಪವಿತ್ರ ವೇದದ ಪ್ರವಾದನೆಗಳು ನೆರವೇರುವಂತೆ ಇದೆಲ್ಲಾ ಆಯಿತು,” ಎಂದು ಹೇಳಿದರು. ಆಗ ಶಿಷ್ಯರೆಲ್ಲರೂ ಯೇಸುವನ್ನು ಬಿಟ್ಟು ಓಡಿಹೋದರು.<verse eid="MAT 26:56"/></para>
  <para style="s1">ಯೇಸು ನ್ಯಾಯಸಭೆಯ ಮುಂದೆ</para>
  <para style="p">
    <verse number="57" style="v" sid="MAT 26:57"/>ಯೇಸುವನ್ನು ಹಿಡಿದಿದ್ದವರು ಅವರನ್ನು ಮಹಾಯಾಜಕನಾದ ಕಾಯಫನ ಬಳಿಗೆ ತೆಗೆದುಕೊಂಡು ಹೋದರು. ಅಲ್ಲಿ ನಿಯಮ ಬೋಧಕರೂ ಹಿರಿಯರೂ ಕೂಡಿ ಬಂದಿದ್ದರು. <verse eid="MAT 26:57"/><verse number="58" style="v" sid="MAT 26:58"/>ಆದರೆ ಪೇತ್ರನು ಮಹಾಯಾಜಕನ ಅರಮನೆಗೆ ದೂರದಿಂದಲೇ ಯೇಸುವನ್ನು ಹಿಂಬಾಲಿಸಿ, ಒಳಗೆ ಹೋಗಿ ಅಂತ್ಯವೇನಾಗುವುದೆಂದು ನೋಡಲು ಸೇವಕರೊಂದಿಗೆ ಕುಳಿತುಕೊಂಡನು.<verse eid="MAT 26:58"/></para>
  <para style="p">
    <verse number="59" style="v" sid="MAT 26:59"/>ಆಗ ಮುಖ್ಯಯಾಜಕರೂ ಆಲೋಚನಾ ಸಭೆಯವರೆಲ್ಲರೂ ಯೇಸುವಿಗೆ ವಿರೋಧವಾಗಿ ಯೇಸುವನ್ನು ಕೊಲ್ಲಿಸಬೇಕೆಂದು ಸುಳ್ಳುಸಾಕ್ಷಿಗಾಗಿ ಹುಡುಕಿದರು. <verse eid="MAT 26:59"/><verse number="60" style="v" sid="MAT 26:60"/>ಬಹುಮಂದಿ ಸುಳ್ಳುಸಾಕ್ಷಿಗಳು ಬಂದರೂ ಅವರಿಗೆ ಸರಿಯಾದ ಸಾಕ್ಷ್ಯವು ದೊರೆಯಲಿಲ್ಲ.</para>
  <para style="p" vid="MAT 26:60">ಕಡೆಯಲ್ಲಿ ಇಬ್ಬರು ಸುಳ್ಳುಸಾಕ್ಷಿಗಳು ಬಂದು, <verse eid="MAT 26:60"/><verse number="61" style="v" sid="MAT 26:61"/>“ನಾನು ದೇವಾಲಯವನ್ನು ಕೆಡವಿ ಮೂರು ದಿನಗಳಲ್ಲಿ ಕಟ್ಟಬಲ್ಲೆನೆಂದು ಈತನು ಹೇಳಿದನು,” ಎಂದರು.<verse eid="MAT 26:61"/></para>
  <para style="p">
    <verse number="62" style="v" sid="MAT 26:62"/>ಮಹಾಯಾಜಕನು ಎದ್ದು ಯೇಸುವಿಗೆ, “ನೀನು ಏನೂ ಉತ್ತರ ಕೊಡುವುದಿಲ್ಲವೋ? ಇವರು ನಿನಗೆ ವಿರೋಧವಾಗಿ ಸಾಕ್ಷಿ ಹೇಳುವುದು ಏನು?” ಎಂದು ಕೇಳಿದನು. <verse eid="MAT 26:62"/><verse number="63" style="v" sid="MAT 26:63"/>ಆದರೆ ಯೇಸು ಸುಮ್ಮನಿದ್ದರು.</para>
  <para style="p" vid="MAT 26:63">ಆಗ ಮಹಾಯಾಜಕನು ಉತ್ತರವಾಗಿ ಯೇಸುವಿಗೆ, “ಜೀವಸ್ವರೂಪನಾದ ದೇವರ ಮೇಲೆ ಆಣೆಯಿಟ್ಟು ನಮಗೆ ಇದನ್ನು ಹೇಳು: ನೀನು ದೇವಪುತ್ರನಾದ ಕ್ರಿಸ್ತನೋ?” ಎಂದನು.<verse eid="MAT 26:63"/></para>
  <para style="p">
    <verse number="64" style="v" sid="MAT 26:64"/>ಅದಕ್ಕೆ ಯೇಸು ಅವನಿಗೆ, “ನೀನೇ ಹೇಳಿದ್ದೀ; ಆದರೂ ಇನ್ನು ಮೇಲೆ ಮನುಷ್ಯಪುತ್ರನಾದ ನಾನು ಸರ್ವಶಕ್ತರ ಬಲಗಡೆಯಲ್ಲಿ ಕುಳಿತಿರುವುದನ್ನೂ ಆಕಾಶದ ಮೇಘಗಳ ಮೇಲೆ ಬರುವುದನ್ನೂ ನೀವು ಕಾಣುವಿರಿ ಎಂದು ನಾನು ನಿಮಗೆ ಹೇಳುತ್ತೇನೆ,”<note caller="+" style="f"><char style="fr" closed="false">26:64 </char><char style="ft" closed="false"><char style="xt"><ref loc="PSA 110:1">ಕೀರ್ತನೆ 110:1</ref>; <ref loc="DAN 7:13">ದಾನಿ 7:13</ref></char></char></note> ಎಂದರು.<verse eid="MAT 26:64"/></para>
  <para style="p">
    <verse number="65" style="v" sid="MAT 26:65"/>ಆಗ ಮಹಾಯಾಜಕನು ತನ್ನ ಬಟ್ಟೆಗಳನ್ನು ಹರಿದುಕೊಂಡು, “ಈತನು ದೇವದೂಷಣೆ ಮಾಡಿದ್ದಾನೆ. ನಮಗೆ ಇನ್ನು ಹೆಚ್ಚಿನ ಸಾಕ್ಷಿಗಳು ಏತಕ್ಕೆ? ನೋಡಿ, ಈಗ ಈತನ ದೇವದೂಷಣೆಯನ್ನು ನೀವೇ ಕೇಳಿದ್ದೀರಲ್ಲಾ <verse eid="MAT 26:65"/><verse number="66" style="v" sid="MAT 26:66"/>ನಿಮಗೆ ಹೇಗೆ ತೋರುತ್ತದೆ?” ಎಂದು ಕೇಳಿದ್ದಕ್ಕೆ ಅವರು ಉತ್ತರವಾಗಿ,</para>
  <para style="p" vid="MAT 26:66">“ಈತನು ಮರಣಕ್ಕೆ ಪಾತ್ರನು,” ಎಂದರು.<verse eid="MAT 26:66"/></para>
  <para style="p">
    <verse number="67" style="v" sid="MAT 26:67"/>ಆಮೇಲೆ ಅವರು ಯೇಸುವಿನ ಮುಖದ ಮೇಲೆ ಉಗುಳಿ ಅವರನ್ನು ಗುದ್ದಿದರು. ಬೇರೆ ಕೆಲವರು ಅವರ ಕೆನ್ನೆಗೆ ಹೊಡೆದು, <verse eid="MAT 26:67"/><verse number="68" style="v" sid="MAT 26:68"/>“ಕ್ರಿಸ್ತನೇ, ನಿನ್ನನ್ನು ಹೊಡೆದವರು ಯಾರು? ನಮಗೆ ಪ್ರವಾದನೆ ಹೇಳು,” ಎಂದರು.<verse eid="MAT 26:68"/></para>
  <para style="s1">ಪೇತ್ರನು ಯೇಸುವನ್ನು ನಿರಾಕರಿಸಿದ್ದು</para>
  <para style="p">
    <verse number="69" style="v" sid="MAT 26:69"/>ಆಗ ಪೇತ್ರನು ಹೊರಾಂಗಣದಲ್ಲಿ ಕುಳಿತಿರಲು, ಒಬ್ಬ ದಾಸಿಯು ಅವನ ಬಳಿಗೆ ಬಂದು, “ನೀನೂ ಗಲಿಲಾಯದ ಯೇಸುವಿನೊಂದಿಗೆ ಇದ್ದವನು,” ಎಂದಳು.<verse eid="MAT 26:69"/></para>
  <para style="p">
    <verse number="70" style="v" sid="MAT 26:70"/>ಆದರೆ ಅವನು ಎಲ್ಲರ ಮುಂದೆ, “ನೀನು ಏನು ಹೇಳುತ್ತೀಯೋ ನನಗೆ ತಿಳಿಯದು,” ಎಂದು ನಿರಾಕರಿಸಿದನು.<verse eid="MAT 26:70"/></para>
  <para style="p">
    <verse number="71" style="v" sid="MAT 26:71"/>ಅವನು ಮುಖ್ಯ ದ್ವಾರದೊಳಗೆ ಹೋದಾಗ, ಮತ್ತೊಬ್ಬ ಹುಡುಗಿಯು ಅವನನ್ನು ನೋಡಿ ಅಲ್ಲಿದ್ದವರಿಗೆ, “ಇವನು ಸಹ ನಜರೇತಿನ ಯೇಸುವಿನೊಂದಿಗೆ ಇದ್ದವನು,” ಎಂದಳು.<verse eid="MAT 26:71"/></para>
  <para style="p">
    <verse number="72" style="v" sid="MAT 26:72"/>ಆಗ ಅವನು ಆಣೆ ಮಾಡಿ, “ನಾನು ಆ ಮನುಷ್ಯನನ್ನು ಅರಿಯೆನು,” ಎಂದು ತಿರುಗಿ ನಿರಾಕರಿಸಿದನು.<verse eid="MAT 26:72"/></para>
  <para style="p">
    <verse number="73" style="v" sid="MAT 26:73"/>ಸ್ವಲ್ಪ ಸಮಯವಾದ ಮೇಲೆ ಅಲ್ಲಿ ನಿಂತಿದ್ದವರು ಪೇತ್ರನಿಗೆ, “ನಿಶ್ಚಯವಾಗಿಯೂ ನೀನು ಸಹ ಅವರಲ್ಲಿ ಒಬ್ಬನು. ನಿಜವಾಗಿಯೂ ನಿನ್ನ ಭಾಷೆಯು ನಿನ್ನನ್ನು ತೋರಿಸಿಕೊಡುತ್ತದೆ,” ಎಂದರು.<verse eid="MAT 26:73"/></para>
  <para style="p">
    <verse number="74" style="v" sid="MAT 26:74"/>ಅದಕ್ಕೆ ಅವನು, “ಆ ಮನುಷ್ಯನನ್ನು ನಾನು ಅರಿಯೆನು,” ಎಂದು ಶಪಿಸಿಕೊಳ್ಳುವುದಕ್ಕೂ ಆಣೆಯಿಟ್ಟುಕೊಳ್ಳುವುದಕ್ಕೂ ಪ್ರಾರಂಭಿಸಿದನು.</para>
  <para style="p" vid="MAT 26:74">ಕೂಡಲೇ ಹುಂಜ ಕೂಗಿತು. <verse eid="MAT 26:74"/><verse number="75" style="v" sid="MAT 26:75"/>ಆಗ ಪೇತ್ರನು, “ಹುಂಜ ಕೂಗುವುದಕ್ಕಿಂತ ಮುಂಚಿತವಾಗಿ ನೀನು ಮೂರು ಸಾರಿ ನನ್ನನ್ನು ನಿರಾಕರಿಸುವೆ,” ಎಂದು ಯೇಸು ತನಗೆ ಹೇಳಿದ ಮಾತನ್ನು ಜ್ಞಾಪಕಮಾಡಿಕೊಂಡು ಹೊರಗೆ ಹೋಗಿ ಬಹಳವಾಗಿ ವ್ಯಥೆಪಟ್ಟು ಅತ್ತನು.<verse eid="MAT 26:75"/></para>
  <chapter eid="MAT 26"/>
  <chapter number="27" style="c" sid="MAT 27"/>
  <para style="s1">ಯೂದನು ನೇಣು ಹಾಕಿಕೊಂಡದ್ದು</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 27:1"/>ಬೆಳಗಾದಾಗ, ಎಲ್ಲಾ ಮುಖ್ಯಯಾಜಕರೂ ಜನರ ಹಿರಿಯರೂ ಯೇಸುವನ್ನು ಕೊಲ್ಲಿಸುವುದಕ್ಕೆ ಆತನಿಗೆ ವಿರೋಧವಾಗಿ ಆಲೋಚನೆ ಮಾಡಿಕೊಂಡರು. <verse eid="MAT 27:1"/><verse number="2" style="v" sid="MAT 27:2"/>ಅವರು ಯೇಸುವನ್ನು ಕಟ್ಟಿ, ಕರೆದುಕೊಂಡು ಹೋಗಿ ರಾಜ್ಯಪಾಲ ಪಿಲಾತನಿಗೆ ಒಪ್ಪಿಸಿದರು.<verse eid="MAT 27:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 27:3"/>ಯೇಸುವಿಗೆ ದ್ರೋಹಮಾಡಿದ ಯೂದನು ಗುರುವಿಗೆ ಮರಣ ದಂಡನೆಯ ತೀರ್ಪಾದದ್ದನ್ನು ಕಂಡು ವಿಷಾದಿಸಿ, ಆ ಮೂವತ್ತು ಬೆಳ್ಳಿಯ ನಾಣ್ಯಗಳನ್ನು ಮುಖ್ಯಯಾಜಕರ ಮತ್ತು ಹಿರಿಯರ ಬಳಿಗೆ ಮರಳಿ ತಂದನು. <verse eid="MAT 27:3"/><verse number="4" style="v" sid="MAT 27:4"/>ಅವನು, “ನಾನು ನಿರಪರಾಧಿಯ ರಕ್ತಕ್ಕೆ ದ್ರೋಹ ಬಗೆದು ಪಾಪಮಾಡಿದ್ದೇನೆ,” ಎಂದನು.</para>
  <para style="p" vid="MAT 27:4">ಅದಕ್ಕೆ ಅವರು, “ನಮಗೇನು? ನೀನೇ ಅದನ್ನು ನೋಡಿಕೋ,” ಎಂದರು.<verse eid="MAT 27:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 27:5"/>ಅವನು ಆ ಬೆಳ್ಳಿಯ ನಾಣ್ಯಗಳನ್ನು ದೇವಾಲಯದಲ್ಲಿ ಬಿಸಾಡಿಬಿಟ್ಟು ಹೊರಟುಹೋಗಿ ನೇಣು ಹಾಕಿಕೊಂಡನು.<verse eid="MAT 27:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 27:6"/>ಆಗ ಮುಖ್ಯಯಾಜಕರು ಆ ಬೆಳ್ಳಿಯ ನಾಣ್ಯಗಳನ್ನು ತೆಗೆದುಕೊಂಡು, “ಇವುಗಳನ್ನು ಕಾಣಿಕೆ ಪೆಟ್ಟಿಗೆಯಲ್ಲಿ ಹಾಕುವುದು ನ್ಯಾಯವಲ್ಲ. ಅದು ರಕ್ತದ ಕ್ರಯವಾಗಿದೆ,” ಎಂದರು. <verse eid="MAT 27:6"/><verse number="7" style="v" sid="MAT 27:7"/>ಅವರು ಆಲೋಚನೆ ಮಾಡಿ ಪರದೇಶಿಗಳನ್ನು ಹೂಳಿಡುವುದಕ್ಕೆ ಆ ಹಣದಿಂದ ಕುಂಬಾರನ ಹೊಲವನ್ನು ಕೊಂಡುಕೊಂಡರು. <verse eid="MAT 27:7"/><verse number="8" style="v" sid="MAT 27:8"/>ಈ ಕಾರಣದಿಂದ ಆ ಹೊಲವನ್ನು “ರಕ್ತದ ಹೊಲ” ಎಂದು ಈ ದಿನದವರೆಗೆ ಕರೆಯಲಾಗುತ್ತಿದೆ. <verse eid="MAT 27:8"/><verse number="9" style="v" sid="MAT 27:9"/>ಹೀಗೆ ಪ್ರವಾದಿ ಯೆರೆಮೀಯನು ಹೇಳಿದ ಮಾತು ನೆರವೇರಿತು. ಅದೇನೆಂದರೆ, “ಇಸ್ರಾಯೇಲಿನ ಮಕ್ಕಳಲ್ಲಿ ಅವರು ಬೆಲೆ ಕಟ್ಟಿದವನ ಬೆಲೆಯಾದ ಮೂವತ್ತು ಬೆಳ್ಳಿ ನಾಣ್ಯಗಳನ್ನು ತೆಗೆದುಕೊಂಡು, <verse eid="MAT 27:9"/><verse number="10" style="v" sid="MAT 27:10"/>ಕರ್ತನು ನನಗೆ ಆಜ್ಞಾಪಿಸಿದಂತೆ ಅವುಗಳನ್ನು, ‘ಕುಂಬಾರನ ಹೊಲ’ ಕೊಳ್ಳಲು ಕೊಟ್ಟರು,”<note caller="+" style="f"><char style="fr" closed="false">27:10 </char><char style="ft" closed="false"><char style="xt"><ref loc="ZEC 11:12">ಜೆಕರ್ಯ 11:12</ref>,<ref loc="ZEC 11:13">13</ref>; <ref loc="JER 19:1-13">ಯೆರೆ 19:1-13</ref>; <ref loc="JER 32:6-9">32:6-9</ref></char></char></note> ಎಂಬುದು.<verse eid="MAT 27:10"/></para>
  <para style="s1">ಪಿಲಾತನು ಯೇಸುವನ್ನು ಮರಣದಂಡನೆಗೆ ಒಪ್ಪಿಸಿದ್ದು</para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 27:11"/>ಯೇಸು ರಾಜ್ಯಪಾಲನ ಮುಂದೆ ನಿಂತಿದ್ದರು. ಆಗ ಅವನು ಯೇಸುವಿಗೆ, “ನೀನು ಯೆಹೂದ್ಯರ ಅರಸನೋ?” ಎಂದು ಕೇಳಿದನು.</para>
  <para style="p" vid="MAT 27:11">ಅದಕ್ಕೆ ಯೇಸು ಅವನಿಗೆ, “ನೀನೇ ಹೇಳುತ್ತಿದ್ದಿ,” ಎಂದರು.<verse eid="MAT 27:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 27:12"/>ಆಗ ಮುಖ್ಯಯಾಜಕರೂ ಹಿರಿಯರೂ ಯೇಸುವಿನ ಮೇಲೆ ದೂರು ಹೇಳುತ್ತಿದ್ದರೂ ಅವರು ಏನೂ ಉತ್ತರ ಕೊಡಲಿಲ್ಲ. <verse eid="MAT 27:12"/><verse number="13" style="v" sid="MAT 27:13"/>ಆಗ ಪಿಲಾತನು ಯೇಸುವಿಗೆ, “ನಿನಗೆ ವಿರೋಧವಾಗಿ ಇವರು ಇಷ್ಟು ದೂರು ಹೇಳುತ್ತಿರುವುದು ನಿನಗೆ ಕೇಳಿಸುವುದಿಲ್ಲವೋ?” ಎಂದನು. <verse eid="MAT 27:13"/><verse number="14" style="v" sid="MAT 27:14"/>ಒಂದು ಮಾತಿಗಾದರೂ ಯೇಸು ಅವನಿಗೆ ಉತ್ತರ ಕೊಡದೆ ಇದ್ದುದರಿಂದ ರಾಜ್ಯಪಾಲನು ಅತ್ಯಾಶ್ಚರ್ಯಪಟ್ಟನು.<verse eid="MAT 27:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 27:15"/>ಆ ಹಬ್ಬದಲ್ಲಿ ಜನರು ಇಷ್ಟಪಡುವ ಒಬ್ಬ ಸೆರೆಯಾಳನ್ನು ರಾಜ್ಯಪಾಲನು ಬಿಟ್ಟುಕೊಡುವ ಪದ್ಧತಿಯಿತ್ತು. <verse eid="MAT 27:15"/><verse number="16" style="v" sid="MAT 27:16"/>ಆ ಸಮಯದಲ್ಲಿ ಬರಬ್ಬನೆಂಬ<note caller="+" style="f"><char style="fr" closed="false">27:16 </char><char style="ft" closed="false">ಬರಬ್ಬನ ಪ್ರಾರಂಭದ ಹೆಸರು ಯೇಸು</char></note> ಪ್ರಸಿದ್ಧ ಸೆರೆಯಾಳು ಅವರಲ್ಲಿ ಇದ್ದನು. <verse eid="MAT 27:16"/><verse number="17" style="v" sid="MAT 27:17"/>ಜನಸಮೂಹ ಕೂಡಿಬಂದಿದ್ದಾಗ ಪಿಲಾತನು ಅವರಿಗೆ, “ನಿಮಗೆ ಯಾರನ್ನು ಬಿಡುಗಡೆ ಮಾಡಬೇಕೆನ್ನುತ್ತೀರಿ? ಬರಬ್ಬನನ್ನೋ? ಕ್ರಿಸ್ತನೆನ್ನಿಸಿಕೊಳ್ಳುವ ಯೇಸುವನ್ನೋ?” ಎಂದು ಕೇಳಿದನು. <verse eid="MAT 27:17"/><verse number="18" style="v" sid="MAT 27:18"/>ಯೇಸುವನ್ನು ಅವರು ಹೊಟ್ಟೆಕಿಚ್ಚಿನಿಂದ ಒಪ್ಪಿಸಿಕೊಟ್ಟಿದ್ದರೆಂದು ಪಿಲಾತನಿಗೆ ತಿಳಿದಿತ್ತು.<verse eid="MAT 27:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 27:19"/>ಪಿಲಾತನು ನ್ಯಾಯಾಸನದ ಮೇಲೆ ಕೂತಿದ್ದಾಗ, ಅವನ ಹೆಂಡತಿಯು ಅವನಿಗೆ, “ನೀನು ಆ ನೀತಿವಂತನ ಗೊಡವೆಗೆ ಹೋಗಬೇಡ. ಈ ದಿವಸ ನಾನು ಸ್ವಪ್ನದಲ್ಲಿ ಆತನ ವಿಷಯವಾಗಿ ಬಹಳ ಕಷ್ಟಪಟ್ಟಿದ್ದೇನೆ,” ಎಂದು ಹೇಳಿ ಕಳುಹಿಸಿದಳು.<verse eid="MAT 27:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 27:20"/>ಆದರೆ ಮುಖ್ಯಯಾಜಕರು ಮತ್ತು ಹಿರಿಯರು ಬರಬ್ಬನನ್ನು ಬಿಟ್ಟುಕೊಟ್ಟು ಯೇಸುವನ್ನು ಕೊಲ್ಲುವಂತೆ ಬೇಡಿಕೊಳ್ಳುವ ಹಾಗೆ ಸಮೂಹವನ್ನು ಒಡಂಬಡಿಸಿದರು.<verse eid="MAT 27:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 27:21"/>ರಾಜ್ಯಪಾಲನು ಅವರಿಗೆ, “ಈ ಇಬ್ಬರಲ್ಲಿ ನಿಮಗೆ ಯಾರನ್ನು ಬಿಟ್ಟು ಕೊಡಬೇಕೆನ್ನುತ್ತೀರಿ?” ಎಂದು ಕೇಳಲು ಅವರು,</para>
  <para style="p" vid="MAT 27:21">“ಬರಬ್ಬನನ್ನು,” ಎಂದರು.<verse eid="MAT 27:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 27:22"/>ಪಿಲಾತನು ಅವರಿಗೆ, “ಹಾಗಾದರೆ ಕ್ರಿಸ್ತನೆನ್ನಿಸಿಕೊಳ್ಳುವ ಯೇಸುವನ್ನು ನಾನೇನು ಮಾಡಲಿ?” ಎಂದು ಕೇಳಲು ಅವರೆಲ್ಲರೂ,</para>
  <para style="p" vid="MAT 27:22">“ಆತನನ್ನು ಶಿಲುಬೆಗೆ ಹಾಕಿಸು,” ಎಂದು ಹೇಳಿದರು.<verse eid="MAT 27:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 27:23"/>ಆಗ ಪಿಲಾತನು ಅವರಿಗೆ, “ಏಕೆ? ಆತನು ಯಾವ ಅಪರಾಧ ಮಾಡಿದ್ದಾನೆ?” ಎಂದು ಕೇಳಲು ಅವರು,</para>
  <para style="p" vid="MAT 27:23">“ಆತನನ್ನು ಶಿಲುಬೆಗೆ ಹಾಕಿಸು,” ಎಂದು ಮತ್ತಷ್ಟು ಹೆಚ್ಚಾಗಿ ಕೂಗಿಕೊಂಡರು.<verse eid="MAT 27:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 27:24"/>ಪಿಲಾತನು ತನ್ನ ಯತ್ನ ನಡೆಯಲಿಲ್ಲವೆಂದೂ ಅದಕ್ಕೆ ಬದಲಾಗಿ ಗದ್ದಲವೇ ಹೆಚ್ಚಾಗುತ್ತದೆಂದೂ ನೋಡಿ, ನೀರನ್ನು ತೆಗೆದುಕೊಂಡು ಸಮೂಹದ ಮುಂದೆ ತನ್ನ ಕೈಗಳನ್ನು ತೊಳೆದು, “ಈ ನೀತಿವಂತನ ರಕ್ತದ ವಿಷಯದಲ್ಲಿ ನಾನು ನಿರಪರಾಧಿ, ಇದಕ್ಕೆ ನೀವೇ ಜವಾಬ್ದಾರಿ,” ಎಂದನು.<verse eid="MAT 27:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 27:25"/>ಅದಕ್ಕೆ ಜನರೆಲ್ಲರೂ ಉತ್ತರವಾಗಿ, “ಆತನ ರಕ್ತವು ನಮ್ಮ ಮೇಲೆಯೂ ನಮ್ಮ ಮಕ್ಕಳ ಮೇಲೆಯೂ ಇರಲಿ,” ಎಂದರು.<verse eid="MAT 27:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 27:26"/>ಆಗ ಪಿಲಾತನು ಬರಬ್ಬನನ್ನು ಅವರಿಗೆ ಬಿಟ್ಟುಕೊಟ್ಟು, ಯೇಸುವನ್ನು ಕೊರಡೆಗಳಿಂದ ಹೊಡೆಸಿ ಶಿಲುಬೆಗೆ ಹಾಕುವುದಕ್ಕೆ ಒಪ್ಪಿಸಿದನು.<verse eid="MAT 27:26"/></para>
  <para style="s1">ಯೇಸುವನ್ನು ಸೈನಿಕರು ಅಪಹಾಸ್ಯಮಾಡಿದ್ದು</para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 27:27"/>ತರುವಾಯ ರಾಜ್ಯಪಾಲನ ಸೈನಿಕರು ಯೇಸುವನ್ನು ರಾಜಭವನದೊಳಕ್ಕೆ ತೆಗೆದುಕೊಂಡುಹೋಗಿ ಸೈನ್ಯದ ಪೂರ್ಣತಂಡವನ್ನು ಯೇಸುವಿನ ಸುತ್ತಲೂ ಕೂಡಿಸಿದರು. <verse eid="MAT 27:27"/><verse number="28" style="v" sid="MAT 27:28"/>ಅವರು ಯೇಸುವಿನ ಬಟ್ಟೆಗಳನ್ನು ತೆಗೆದುಹಾಕಿ ಕಡುಗೆಂಪು ನಿಲುವಂಗಿಯನ್ನು ಅವರಿಗೆ ತೊಡಿಸಿದರು. <verse eid="MAT 27:28"/><verse number="29" style="v" sid="MAT 27:29"/>ಅವರು ಒಂದು ಮುಳ್ಳಿನ ಕಿರೀಟವನ್ನು ಹೆಣೆದು, ಯೇಸುವಿನ ತಲೆಯ ಮೇಲಿಟ್ಟು, ಬಲಗೈಯಲ್ಲಿ ಒಂದು ಬೆತ್ತವನ್ನು ಕೊಟ್ಟು ಅವರ ಮುಂದೆ ಮೊಣಕಾಲೂರಿ, “ಯೆಹೂದ್ಯರ ಅರಸನೇ, ನಮಸ್ಕಾರ!” ಎಂದು ಹೇಳಿ ಯೇಸುವನ್ನು ಹಾಸ್ಯಮಾಡಿದರು. <verse eid="MAT 27:29"/><verse number="30" style="v" sid="MAT 27:30"/>ಅವರು ಯೇಸುವಿನ ಮೇಲೆ ಉಗುಳಿ, ಆ ಬೆತ್ತವನ್ನು ತೆಗೆದುಕೊಂಡು ಅವರ ತಲೆಯ ಮೇಲೆ ಮತ್ತೆ ಮತ್ತೆ ಹೊಡೆದರು. <verse eid="MAT 27:30"/><verse number="31" style="v" sid="MAT 27:31"/>ಹೀಗೆ ಹಾಸ್ಯ ಮಾಡಿದ ಮೇಲೆ, ಆ ನಿಲುವಂಗಿಯನ್ನು ಯೇಸುವಿನಿಂದ ತೆಗೆದುಹಾಕಿ ಅವರ ವಸ್ತ್ರವನ್ನು ಹೊದಿಸಿ, ಯೇಸುವನ್ನು ಶಿಲುಬೆಗೆ ಹಾಕುವುದಕ್ಕಾಗಿ ನಡೆಸಿಕೊಂಡು ಹೋದರು.<verse eid="MAT 27:31"/></para>
  <para style="s1">ಯೇಸುವನ್ನು ಶಿಲುಬೆಗೆ ಹಾಕಿದರು</para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 27:32"/>ಅವರು ಹೊರಗೆ ಹೋಗುತ್ತಿರುವಾಗ, ಕುರೇನೆ ಗ್ರಾಮದ ಸೀಮೋನನೆಂಬ ಮನುಷ್ಯನನ್ನು ಕಂಡು, ಯೇಸುವಿನ ಶಿಲುಬೆಯನ್ನು ಹೊರುವಂತೆ ಅವನನ್ನು ಬಲವಂತ ಮಾಡಿದರು. <verse eid="MAT 27:32"/><verse number="33" style="v" sid="MAT 27:33"/>ಆಮೇಲೆ ಅವರು “ಗೊಲ್ಗೊಥಾ” ಎಂದು ಕರೆಯಲಾಗುತ್ತಿದ್ದ ಸ್ಥಳಕ್ಕೆ ಬಂದರು. ಅದರ ಅರ್ಥ “ತಲೆಬುರುಡೆಯ ಸ್ಥಳ” ಎಂಬುದು. <verse eid="MAT 27:33"/><verse number="34" style="v" sid="MAT 27:34"/>ಆಗ ಅವರು ಯೇಸುವಿಗೆ ಕಹಿ ಬೆರೆಸಿದ ದ್ರಾಕ್ಷಾರಸವನ್ನು ಕುಡಿಯಲು ಕೊಟ್ಟರು. ಯೇಸು ಅದನ್ನು ರುಚಿ ನೋಡಿ ಕುಡಿಯಲು ಇಷ್ಟಪಡಲಿಲ್ಲ. <verse eid="MAT 27:34"/><verse number="35" style="v" sid="MAT 27:35"/>ಯೇಸುವನ್ನು ಶಿಲುಬೆಗೆ ಹಾಕಿದ ಮೇಲೆ, ಅವರ ಬಟ್ಟೆಗಳಿಗಾಗಿ ಸೈನಿಕರು ಚೀಟುಹಾಕಿ ಹಂಚಿಕೊಂಡರು <verse eid="MAT 27:35"/><verse number="36" style="v" sid="MAT 27:36"/>ಮತ್ತು ಅವರು ಅಲ್ಲಿ ಕೆಳಗೆ ಕುಳಿತು ಕಾವಲು ಕಾಯುತ್ತಿದ್ದರು. <verse eid="MAT 27:36"/><verse number="37" style="v" sid="MAT 27:37"/>ಯೇಸುವಿನ ತಲೆಯ ಮೇಲ್ಭಾಗದಲ್ಲಿ ಅವರ ವಿರುದ್ಧ ದೋಷಾರೋಪಣೆಯನ್ನು ಬರೆದಿಟ್ಟರು. ಅದೇನೆಂದರೆ:</para>
  <para style="pc" vid="MAT 27:37">
    <char style="sc">ಈತನು ಯೆಹೂದ್ಯರ ಅರಸನಾದ ಯೇಸು.</char><verse eid="MAT 27:37"/></para>
  <para style="p">
    <verse number="38" style="v" sid="MAT 27:38"/>ಯೇಸುವಿನೊಂದಿಗೆ ಇಬ್ಬರು ಕಳ್ಳರನ್ನು ತಂದು ಒಬ್ಬನನ್ನು ಬಲಗಡೆಯಲ್ಲಿ ಇನ್ನೊಬ್ಬನನ್ನು ಎಡಗಡೆಯಲ್ಲಿ ಶಿಲುಬೆಗೆ ಹಾಕಿದರು. <verse eid="MAT 27:38"/><verse number="39" style="v" sid="MAT 27:39"/>ಅಲ್ಲಿ ಹಾದು ಹೋಗುತ್ತಿದ್ದವರು ಯೇಸುವನ್ನು ದೂಷಿಸಿ, ತಮ್ಮ ತಲೆಗಳನ್ನು ಅಲ್ಲಾಡಿಸುತ್ತಾ, <verse eid="MAT 27:39"/><verse number="40" style="v" sid="MAT 27:40"/>“ದೇವಾಲಯವನ್ನು ಕೆಡವಿ ಮೂರು ದಿನಗಳಲ್ಲಿ ಕಟ್ಟುವವನೇ, ನಿನ್ನನ್ನು ನೀನೇ ರಕ್ಷಿಸಿಕೋ, ನೀನು ದೇವಪುತ್ರನಾಗಿದ್ದರೆ ಶಿಲುಬೆಯಿಂದ ಕೆಳಗೆ ಇಳಿದು ಬಾ,” ಎಂದರು. <verse eid="MAT 27:40"/><verse number="41" style="v" sid="MAT 27:41"/>ಅದೇ ಮೇರೆಗೆ ಮುಖ್ಯಯಾಜಕರೂ ನಿಯಮ ಬೋಧಕರೂ ಹಿರಿಯರೂ ಯೇಸುವನ್ನು ಹಾಸ್ಯಮಾಡಿ, <verse eid="MAT 27:41"/><verse number="42" style="v" sid="MAT 27:42"/>“ಈತನು ಬೇರೆಯವರನ್ನು ರಕ್ಷಿಸಿದನು; ತನ್ನನ್ನು ತಾನೇ ರಕ್ಷಿಸಿಕೊಳ್ಳಲಾರನು! ಈತನು ಇಸ್ರಾಯೇಲಿನ ಅರಸನಾಗಿದ್ದರೆ ಈಗಲೇ ಶಿಲುಬೆಯಿಂದ ಕೆಳಗೆ ಇಳಿದು ಬರಲಿ. ಆಗ ನಾವು ಈತನನ್ನು ನಂಬುವೆವು. <verse eid="MAT 27:42"/><verse number="43" style="v" sid="MAT 27:43"/>ಈತನು ದೇವರಲ್ಲಿ ಭರವಸೆ ಇಟ್ಟಿದ್ದಾನೆ. ದೇವರಿಗೆ ಈತನಲ್ಲಿ ಇಷ್ಟವಿದ್ದರೆ, ದೇವರೇ ಈತನನ್ನು ಈಗ ಬಿಡಿಸಲಿ, ಏಕೆಂದರೆ ಈತನು, ‘ನಾನು ದೇವಪುತ್ರನು’ ಎಂದು ಹೇಳಿದ್ದಾನೆ,” ಎಂದರು. <verse eid="MAT 27:43"/><verse number="44" style="v" sid="MAT 27:44"/>ಯೇಸುವಿನ ಜೊತೆಗೆ ಶಿಲುಬೆಗೇರಿಸಲಾಗಿದ್ದ ಕಳ್ಳರು ಸಹ ಅದೇ ರೀತಿಯಾಗಿ ಅವರನ್ನು ನಿಂದಿಸಿದರು.<verse eid="MAT 27:44"/></para>
  <para style="s1">ಯೇಸುವಿನ ಮರಣ</para>
  <para style="p">
    <verse number="45" style="v" sid="MAT 27:45"/>ಆಗ ಮಧ್ಯಾಹ್ನದಿಂದ ಮೂರು ಗಂಟೆಯವರೆಗೆ ದೇಶದ ಮೇಲೆಲ್ಲಾ ಕತ್ತಲೆ ಕವಿಯಿತು. <verse eid="MAT 27:45"/><verse number="46" style="v" sid="MAT 27:46"/>ಸುಮಾರು ಮೂರು ಗಂಟೆಗೆ ಯೇಸು, <char style="tl">“ಏಲೀ, ಏಲೀ, ಲಮಾ ಸಬಕ್ತಾನೀ?”</char> ಅಂದರೆ, “ನನ್ನ ದೇವರೇ, ನನ್ನ ದೇವರೇ ಏಕೆ ನನ್ನನ್ನು ಕೈಬಿಟ್ಟಿದ್ದೀ?”<note caller="+" style="f"><char style="fr" closed="false">27:46 </char><char style="ft" closed="false"><char style="xt"><ref loc="PSA 22:1">ಕೀರ್ತನೆ 22:1</ref></char></char></note> ಎಂದು ಮಹಾಧ್ವನಿಯಿಂದ ಕೂಗಿ ಹೇಳಿದರು.<verse eid="MAT 27:46"/></para>
  <para style="p">
    <verse number="47" style="v" sid="MAT 27:47"/>ಆಗ ಅಲ್ಲಿ ನಿಂತಿದ್ದವರಲ್ಲಿ ಕೆಲವರು, “ಈತನು ಎಲೀಯನನ್ನು ಕರೆಯುತ್ತಿದ್ದಾನೆ,” ಎಂದರು.<verse eid="MAT 27:47"/></para>
  <para style="p">
    <verse number="48" style="v" sid="MAT 27:48"/>ಕೂಡಲೇ ಅವರಲ್ಲಿ ಒಬ್ಬನು ಓಡಿಹೋಗಿ ಹೀರುವ ವಸ್ತುವಿನಿಂದ ಹುಳಿರಸದಲ್ಲಿ ಅದ್ದಿ ಒಂದು ಕೋಲಿಗೆ ಸಿಕ್ಕಿಸಿ ಯೇಸುವಿಗೆ ಕುಡಿಯುವುದಕ್ಕೆ ಕೊಟ್ಟನು. <verse eid="MAT 27:48"/><verse number="49" style="v" sid="MAT 27:49"/>ಉಳಿದವರು, “ಇರಲಿ ಬಿಡು, ಎಲೀಯನು ಬಂದು ಈತನನ್ನು ರಕ್ಷಿಸುವನೇನೋ ನೋಡೋಣ,” ಎಂದರು.<verse eid="MAT 27:49"/></para>
  <para style="p">
    <verse number="50" style="v" sid="MAT 27:50"/>ಯೇಸು ತಿರುಗಿ ಗಟ್ಟಿಯಾಗಿ ಕೂಗಿ, ತಮ್ಮ ಆತ್ಮವನ್ನು ಒಪ್ಪಿಸಿಕೊಟ್ಟರು.<verse eid="MAT 27:50"/></para>
  <para style="p">
    <verse number="51" style="v" sid="MAT 27:51"/>ಅದೇ ಸಮಯದಲ್ಲಿ, ದೇವಾಲಯದ ತೆರೆಯು ಮೇಲಿನಿಂದ ಕೆಳಗಿನವರೆಗೆ ಹರಿದು ಎರಡು ಭಾಗವಾಯಿತು. ಭೂಮಿಯು ಕಂಪಿಸಿತು. ಬಂಡೆಗಳು ಸೀಳಿಹೋದವು. <verse eid="MAT 27:51"/><verse number="52" style="v" sid="MAT 27:52"/>ಇದಲ್ಲದೆ ಸಮಾಧಿಗಳು ತೆರೆದುಕೊಂಡವು. ಮರಣ ಹೊಂದಿದ ಅನೇಕ ಭಕ್ತರ ದೇಹಗಳು ಎದ್ದವು. <verse eid="MAT 27:52"/><verse number="53" style="v" sid="MAT 27:53"/>ಯೇಸು ಪುನರುತ್ಥಾನವಾದ ಮೇಲೆ ಅವರು ಸಮಾಧಿಗಳೊಳಗಿಂದ ಹೊರಗೆ ಬಂದು ಪವಿತ್ರ ಪಟ್ಟಣದೊಳಕ್ಕೆ ಹೋಗಿ ಅನೇಕರಿಗೆ ಕಾಣಿಸಿಕೊಂಡರು.<verse eid="MAT 27:53"/></para>
  <para style="p">
    <verse number="54" style="v" sid="MAT 27:54"/>ಆಗ ಶತಾಧಿಪತಿಯು ಮತ್ತು ಅವನ ಸಂಗಡ ಯೇಸುವನ್ನು ಕಾಯುತ್ತಿದ್ದವರು ಭೂಕಂಪವನ್ನೂ ಸಂಭವಿಸಿದ್ದೆಲ್ಲವನ್ನೂ ಕಂಡು ಬಹಳವಾಗಿ ಭಯಪಟ್ಟು, “ನಿಜವಾಗಿಯೂ ಈತನು ದೇವಪುತ್ರನಾಗಿದ್ದನು,” ಎಂದರು.<verse eid="MAT 27:54"/></para>
  <para style="p">
    <verse number="55" style="v" sid="MAT 27:55"/>ಯೇಸುವನ್ನು ಗಲಿಲಾಯದಿಂದ ಹಿಂಬಾಲಿಸಿ, ಅವರಿಗೆ ಸೇವೆಮಾಡಿದ ಅನೇಕ ಸ್ತ್ರೀಯರು ದೂರದಿಂದ ನೋಡುತ್ತಿದ್ದರು. <verse eid="MAT 27:55"/><verse number="56" style="v" sid="MAT 27:56"/>ಅವರಲ್ಲಿ ಮಗ್ದಲದ ಮರಿಯಳು, ಯಾಕೋಬ ಮತ್ತು ಯೋಸೆಯ ತಾಯಿ ಮರಿಯಳು ಹಾಗೂ ಜೆಬೆದಾಯನ ಮಕ್ಕಳ ತಾಯಿ ಇದ್ದರು.<verse eid="MAT 27:56"/></para>
  <para style="s1">ಯೇಸುವಿನ ಸಮಾಧಿ</para>
  <para style="p">
    <verse number="57" style="v" sid="MAT 27:57"/>ಸಂಜೆಯಾದಾಗ, ಅರಿಮಥಾಯ ಊರಿನ ಯೋಸೇಫನೆಂಬ ಹೆಸರುಳ್ಳ ಧನವಂತನಾದ ಒಬ್ಬ ಮನುಷ್ಯನು ಅಲ್ಲಿಗೆ ಬಂದನು. ಅವನು ಸಹ ಯೇಸುವಿನ ಶಿಷ್ಯನಾಗಿದ್ದನು. <verse eid="MAT 27:57"/><verse number="58" style="v" sid="MAT 27:58"/>ಅವನು ಪಿಲಾತನ ಬಳಿಗೆ ಹೋಗಿ ಯೇಸುವಿನ ದೇಹವನ್ನು ಕೇಳಿಕೊಂಡನು. ಆಗ ಪಿಲಾತನು ದೇಹವನ್ನು ಅವನಿಗೆ ಒಪ್ಪಿಸುವಂತೆ ಅಪ್ಪಣೆಕೊಟ್ಟನು. <verse eid="MAT 27:58"/><verse number="59" style="v" sid="MAT 27:59"/>ಯೋಸೇಫನು ಆ ದೇಹವನ್ನು ತೆಗೆದುಕೊಂಡ ಮೇಲೆ, ಅದನ್ನು ಶುದ್ಧವಾದ ನಾರುಮಡಿ ಬಟ್ಟೆಯಲ್ಲಿ ಸುತ್ತಿ, <verse eid="MAT 27:59"/><verse number="60" style="v" sid="MAT 27:60"/>ಬಂಡೆಯಲ್ಲಿ ತಾನು ಕೊರೆದಿದ್ದ ತನ್ನ ಹೊಸ ಸಮಾಧಿಯಲ್ಲಿ ಅದನ್ನು ಇಟ್ಟು, ಆ ಸಮಾಧಿಯ ಬಾಗಿಲಿಗೆ ದೊಡ್ಡ ಬಂಡೆಯನ್ನು ಉರುಳಿಸಿ ಹೊರಟುಹೋದನು. <verse eid="MAT 27:60"/><verse number="61" style="v" sid="MAT 27:61"/>ಅಲ್ಲಿ ಮಗ್ದಲದ ಮರಿಯಳು ಮತ್ತು ಇನ್ನೊಬ್ಬ ಮರಿಯಳು ಆ ಸಮಾಧಿಗೆ ಎದುರಾಗಿ ಕುಳಿತುಕೊಂಡಿದ್ದರು.<verse eid="MAT 27:61"/></para>
  <para style="s1">ಸಮಾಧಿಯ ಹತ್ತಿರ ಕಾವಲುಗಾರರು</para>
  <para style="p">
    <verse number="62" style="v" sid="MAT 27:62"/>ಮರುದಿನ, ಅಂದರೆ ಪಸ್ಕಹಬ್ಬದ ಸಿದ್ಧತೆಯ ದಿನ ಕಳೆದ ಮೇಲೆ ಮುಖ್ಯಯಾಜಕರು, ಫರಿಸಾಯರು ಒಟ್ಟಾಗಿ ಪಿಲಾತನ ಬಳಿಗೆ ಬಂದು, <verse eid="MAT 27:62"/><verse number="63" style="v" sid="MAT 27:63"/>“ಅಯ್ಯಾ, ಆ ಮೋಸಗಾರನು ಇನ್ನೂ ಜೀವದಿಂದಿರುವಾಗ, ‘ಮೂರು ದಿನಗಳಾದ ಮೇಲೆ ನಾನು ತಿರುಗಿ ಏಳುವೆನು,’ ಎಂದು ಹೇಳಿದ್ದು ನಮಗೆ ನೆನಪಿದೆ. <verse eid="MAT 27:63"/><verse number="64" style="v" sid="MAT 27:64"/>ಯೇಸುವಿನ ಶಿಷ್ಯರು ರಾತ್ರಿಯಲ್ಲಿ ಬಂದು ಆತನನ್ನು ಕದ್ದುಕೊಂಡು ಹೋಗಿ, ಯೇಸು ಸತ್ತವರೊಳಗಿಂದ ಎದ್ದಿದ್ದಾನೆ ಎಂದು ಜನರಿಗೆ ಹೇಳಿಯಾರು. ಆಗ ಮೊದಲನೆಯ ಮೋಸಕ್ಕಿಂತ ಕಡೆಯ ಮೋಸವು ಕೆಡುಕಾದೀತು. ಆದಕಾರಣ ಮೂರನೆಯ ದಿನದವರೆಗೆ ಸಮಾಧಿಯನ್ನು ಭದ್ರಪಡಿಸುವಂತೆ ಅಪ್ಪಣೆಕೊಡಬೇಕು,” ಎಂದರು.<verse eid="MAT 27:64"/></para>
  <para style="p">
    <verse number="65" style="v" sid="MAT 27:65"/>ಪಿಲಾತನು ಅವರಿಗೆ, “ಕಾವಲುಗಾರರು ಇದ್ದಾರಲ್ಲಾ, ಹೋಗಿ ನಿಮಗೆ ತಿಳಿದಮಟ್ಟಿಗೆ ಅದನ್ನು ಭದ್ರಪಡಿಸಿರಿ,” ಎಂದನು. <verse eid="MAT 27:65"/><verse number="66" style="v" sid="MAT 27:66"/>ಅವರು ಹೋಗಿ ಸಮಾಧಿಯನ್ನು ಭದ್ರಪಡಿಸಿ ಕಲ್ಲಿಗೆ ಮುದ್ರೆಹಾಕಿ, ಕಾವಲನ್ನು ಇಟ್ಟರು.<verse eid="MAT 27:66"/></para>
  <chapter eid="MAT 27"/>
  <chapter number="28" style="c" sid="MAT 28"/>
  <para style="s1">ಯೇಸುವಿನ ಪುನರುತ್ಥಾನ</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 28:1"/>ಸಬ್ಬತ್ ಮುಗಿದ ಮೇಲೆ, ವಾರದ ಮೊದಲನೆಯ ದಿನ ಬೆಳಗಾಗುವಾಗ ಮಗ್ದಲದ ಮರಿಯಳು ಮತ್ತು ಇನ್ನೊಬ್ಬ ಮರಿಯಳು ಸಮಾಧಿಯನ್ನು ನೋಡಲು ಬಂದರು.<verse eid="MAT 28:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="MAT 28:2"/>ಆಗ ಮಹಾ ಭೂಕಂಪವಾಯಿತು. ಕರ್ತನ ದೂತನು ಪರಲೋಕದಿಂದ ಇಳಿದುಬಂದು, ಬಾಗಿಲಿನಿಂದ ಬಂಡೆಯನ್ನು ಉರುಳಿಸಿ ಅದರ ಮೇಲೆ ಕುಳಿತುಕೊಂಡನು. <verse eid="MAT 28:2"/><verse number="3" style="v" sid="MAT 28:3"/>ಅವನ ರೂಪವು ಮಿಂಚಿನಂತೆಯೂ ಅವನ ಉಡುಪು ಹಿಮದಂತೆಯೂ ಬಿಳುಪಾಗಿತ್ತು. <verse eid="MAT 28:3"/><verse number="4" style="v" sid="MAT 28:4"/>ಕಾವಲುಗಾರರು ಅವನಿಗೆ ಭಯಪಟ್ಟು ನಡುಗುತ್ತಾ ಸತ್ತಂತಾದರು.<verse eid="MAT 28:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 28:5"/>ಆ ದೂತನು ಸ್ತ್ರೀಯರಿಗೆ, “ನೀವು ಭಯಪಡಬೇಡಿರಿ. ಶಿಲುಬೆಗೇರಿಸಿದ ಯೇಸುವನ್ನು ನೀವು ಹುಡುಕುತ್ತಿದ್ದೀರೆಂದು ನಾನು ಬಲ್ಲೆನು. <verse eid="MAT 28:5"/><verse number="6" style="v" sid="MAT 28:6"/>ಅವರು ಇಲ್ಲಿ ಇಲ್ಲ. ಅವರು ಹೇಳಿದಂತೆಯೇ ಜೀವಂತರಾಗಿ ಎದ್ದಿದ್ದಾರೆ. ಕರ್ತನನ್ನು ಇಟ್ಟಿದ್ದ ಸ್ಥಳವನ್ನು ಬಂದು ನೋಡಿರಿ. <verse eid="MAT 28:6"/><verse number="7" style="v" sid="MAT 28:7"/>ಬೇಗನೆ ಹೋಗಿ ಅವರ ಶಿಷ್ಯರಿಗೆ, ‘ಅವರು ಮರಣದಿಂದ ಎದ್ದಿದ್ದಾರೆ. ಅವರು ನಿಮಗಿಂತ ಮುಂಚಿತವಾಗಿ ಗಲಿಲಾಯಕ್ಕೆ ಹೋಗುತ್ತಾರೆ. ನೀವು ಅಲ್ಲಿಯೇ ಅವರನ್ನು ಕಾಣುವಿರಿ,’ ಎಂದು ತಿಳಿಸಿರಿ. ಇದೇ ನಾನು ನಿಮಗೆ ತಿಳಿಸಬೇಕಾದ ಸಂಗತಿ,” ಎಂದನು.<verse eid="MAT 28:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 28:8"/>ಅವರು ಭಯದಿಂದಲೂ ಮಹಾ ಸಂತೋಷದಿಂದಲೂ ಸಮಾಧಿಯಿಂದ ಬೇಗನೆ ಹೊರಟು, ಶಿಷ್ಯರಿಗೆ ತಿಳಿಸುವುದಕ್ಕಾಗಿ ಓಡಿಹೋದರು. <verse eid="MAT 28:8"/><verse number="9" style="v" sid="MAT 28:9"/>ಅವರು ಶಿಷ್ಯರಿಗೆ ತಿಳಿಸುವುದಕ್ಕೆ ಹೋಗುತ್ತಿದ್ದಾಗ, ಯೇಸು ಅವರನ್ನು ಸಂಧಿಸಿ, “ಶುಭವಾಗಲಿ” ಎಂದರು. ಅವರು ಬಂದು ಯೇಸುವಿನ ಪಾದಗಳನ್ನು ಹಿಡಿದು ಅವರನ್ನು ಆರಾಧಿಸಿದರು. <verse eid="MAT 28:9"/><verse number="10" style="v" sid="MAT 28:10"/>ಆಗ ಯೇಸು ಅವರಿಗೆ, “ಭಯಪಡಬೇಡಿರಿ, ನನ್ನ ಸಹೋದರರು ಗಲಿಲಾಯಕ್ಕೆ ಹೋಗಬೇಕೆಂದೂ ಅಲ್ಲಿ ಅವರು ನನ್ನನ್ನು ಕಾಣುವರೆಂದೂ ಹೋಗಿ ಅವರಿಗೆ ಹೇಳಿರಿ,” ಎಂದರು.<verse eid="MAT 28:10"/></para>
  <para style="s1">ಕಾವಲುಗಾರರ ವರದಿ</para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 28:11"/>ಅವರು ಹೋಗುತ್ತಿರುವಾಗ, ಕಾವಲುಗಾರರಲ್ಲಿ ಕೆಲವರು ಪಟ್ಟಣದೊಳಕ್ಕೆ ಬಂದು ಮುಖ್ಯಯಾಜಕರಿಗೆ ನಡೆದ ಸಂಗತಿಗಳನ್ನೆಲ್ಲಾ ಹೇಳಿದರು. <verse eid="MAT 28:11"/><verse number="12" style="v" sid="MAT 28:12"/>ಇವರು ಹಿರಿಯರೊಂದಿಗೆ ಕೂಡಿಬಂದು ಆಲೋಚನೆ ಮಾಡಿ ಸೈನಿಕರಿಗೆ ಬಹಳ ಹಣಕೊಟ್ಟು, <verse eid="MAT 28:12"/><verse number="13" style="v" sid="MAT 28:13"/>“ ‘ನಾವು ನಿದ್ರೆ ಮಾಡುತ್ತಿದ್ದಾಗ ಅವನ ಶಿಷ್ಯರು ರಾತ್ರಿಯಲ್ಲಿ ಬಂದು ಅವನನ್ನು ಕದ್ದುಕೊಂಡು ಹೋದರು,’ ಎಂದು ನೀವು ಹೇಳಿರಿ. <verse eid="MAT 28:13"/><verse number="14" style="v" sid="MAT 28:14"/>ಇದು ರಾಜ್ಯಪಾಲನ ಕಿವಿಗೆ ಬಿದ್ದರೆ, ನೀವು ತಪ್ಪಿಸಿಕೊಳ್ಳುವ ಹಾಗೆ ನಾವು ಅವನನ್ನು ಸಮಾಧಾನಪಡಿಸುವೆವು,” ಎಂದರು. <verse eid="MAT 28:14"/><verse number="15" style="v" sid="MAT 28:15"/>ಹೀಗೆ ಅವರು ಆ ಹಣವನ್ನು ತೆಗೆದುಕೊಂಡು ತಮಗೆ ಕಲಿಸಿದಂತೆ ವರದಿಮಾಡಿದರು. ಈ ಕಥೆಯು ಈ ದಿನದವರೆಗೂ ಯೆಹೂದ್ಯರಲ್ಲಿ ಹಬ್ಬಿದೆ.<verse eid="MAT 28:15"/></para>
  <para style="s1">ಮಹಾ ಆದೇಶವು</para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 28:16"/>ಆಗ ಹನ್ನೊಂದು ಮಂದಿ ಶಿಷ್ಯರು ಯೇಸು ತಮಗೆ ನೇಮಿಸಿದ ಗಲಿಲಾಯದಲ್ಲಿರುವ ಬೆಟ್ಟಕ್ಕೆ ಹೋದರು. <verse eid="MAT 28:16"/><verse number="17" style="v" sid="MAT 28:17"/>ಅವರು ಯೇಸುವನ್ನು ಕಂಡು ಆರಾಧಿಸಿದರು. ಆದರೆ ಕೆಲವರು ಸಂದೇಹ ಪಟ್ಟರು. <verse eid="MAT 28:17"/><verse number="18" style="v" sid="MAT 28:18"/>ಯೇಸು ಬಂದು ಅವರೊಂದಿಗೆ ಮಾತನಾಡಿ, “ಪರಲೋಕದಲ್ಲಿಯೂ ಭೂಲೋಕದಲ್ಲಿಯೂ ಎಲ್ಲಾ ಅಧಿಕಾರ ನನಗೆ ಕೊಡಲಾಗಿದೆ. <verse eid="MAT 28:18"/><verse number="19" style="v" sid="MAT 28:19"/>ಆದ್ದರಿಂದ ನೀವು ಹೋಗಿ ಎಲ್ಲಾ ದೇಶಗಳ ಜನರನ್ನು ಶಿಷ್ಯರನ್ನಾಗಿ ಮಾಡಿರಿ. ಅವರಿಗೆ ತಂದೆಯ, ಮಗನ ಮತ್ತು ಪವಿತ್ರಾತ್ಮನ ಹೆಸರಿನಲ್ಲಿ ದೀಕ್ಷಾಸ್ನಾನ ಮಾಡಿಸಿ, <verse eid="MAT 28:19"/><verse number="20" style="v" sid="MAT 28:20"/>ನಾನು ನಿಮಗೆ ಆಜ್ಞಾಪಿಸಿದ್ದೆಲ್ಲವನ್ನು ಅನುಸರಿಸುವ ಹಾಗೆ ಅವರಿಗೆ ಬೋಧಿಸಿರಿ. ಇಗೋ, ಲೋಕಾಂತ್ಯದವರೆಗೂ ಎಲ್ಲಾ ದಿವಸ ನಾನು ನಿಮ್ಮ ಸಂಗಡ ಇರುತ್ತೇನೆ,” ಎಂದರು.<verse eid="MAT 28:20"/></para>
  <chapter eid="MAT 28"/>
</usx>
