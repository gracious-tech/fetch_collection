<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="HEB" style="id">- Biblica® Open Kannada Contemporary Version</book>
  <para style="h">ಇಬ್ರಿಯರಿಗೆ</para>
  <para style="toc1">ಇಬ್ರಿಯರಿಗೆ ಬರೆದ ಪತ್ರಿಕೆ</para>
  <para style="toc2">ಇಬ್ರಿಯರಿಗೆ</para>
  <para style="toc3">ಇಬ್ರಿ</para>
  <para style="mt1">ಇಬ್ರಿಯರಿಗೆ</para>
  <para style="mt2">ಬರೆದ ಪತ್ರಿಕೆ</para>
  <chapter number="1" style="c" sid="HEB 1"/>
  <para style="s1">ಕ್ರಿಸ್ತ ಯೇಸುವೇ ದೇವರ ಅಂತಿಮ ಮಾತು</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 1:1"/>ಗತಕಾಲದಲ್ಲಿ ನಮ್ಮ ಪಿತೃಗಳ ಸಂಗಡ ವಿವಿಧ ರೀತಿಯಲ್ಲಿಯೂ ಅನೇಕಬಾರಿ ಪ್ರವಾದಿಗಳ ಮುಖಾಂತರವೂ ಮಾತನಾಡಿದ ದೇವರು, <verse eid="HEB 1:1"/><verse number="2" style="v" sid="HEB 1:2"/>ಈ ಅಂತ್ಯ ದಿನಗಳಲ್ಲಿ ನಮ್ಮ ಸಂಗಡ ತಮ್ಮ ಪುತ್ರ ಆಗಿರುವ ಕ್ರಿಸ್ತ ಯೇಸುವಿನ ಮುಖಾಂತರ ಮಾತನಾಡಿದ್ದಾರೆ. ಈ ಕ್ರಿಸ್ತ ಯೇಸುವನ್ನೇ ದೇವರು ಎಲ್ಲಕ್ಕೂ ಬಾಧ್ಯರನ್ನಾಗಿ ನೇಮಿಸಿದರು. ಇವರ ಮೂಲಕವೇ ಇಡೀ ವಿಶ್ವವನ್ನು ಉಂಟುಮಾಡಿದರು. <verse eid="HEB 1:2"/><verse number="3" style="v" sid="HEB 1:3"/>ಈ ಕ್ರಿಸ್ತ ಯೇಸುವೇ ದೇವರ ಮಹಿಮೆಯ ಪ್ರಕಾಶವೂ ಅವರ ವ್ಯಕ್ತಿತ್ವದ ಪ್ರತಿರೂಪವಾಗಿರುವ ದೇವಪುತ್ರ ಆಗಿದ್ದಾರೆ. ಈ ಕ್ರಿಸ್ತ ಯೇಸುವೇ ತಮ್ಮ ಶಕ್ತಿಯುತ ವಾಕ್ಯದಿಂದ ಸಮಸ್ತಕ್ಕೂ ಆಧಾರವಾಗಿದ್ದಾರೆ. ಕ್ರಿಸ್ತ ಯೇಸು ತಾವಾಗಿಯೇ ನಮ್ಮ ಪಾಪಗಳನ್ನು ಶುದ್ಧಿಮಾಡಿ ಉನ್ನತದೊಳಗೆ ಮಹೋನ್ನತ ದೇವರ ಬಲಗಡೆಯಲ್ಲಿ ಕುಳಿತುಕೊಂಡಿದ್ದಾರೆ. <verse eid="HEB 1:3"/><verse number="4" style="v" sid="HEB 1:4"/>ದೇವಪುತ್ರ ಆಗಿರುವ ಕ್ರಿಸ್ತ ಯೇಸುವು ದೇವದೂತರಿಗಿಂತಲೂ ಶ್ರೇಷ್ಠರಾಗಿದ್ದಾರೆ. ಅವರಿಗಿಂತ ಅತಿ ಶ್ರೇಷ್ಠ ಹೆಸರನ್ನು ಬಾಧ್ಯವಾಗಿ ಹೊಂದಿದವರೂ ಆಗಿದ್ದಾರೆ.<verse eid="HEB 1:4"/></para>
  <para style="s1">ಪುತ್ರ ಆಗಿರುವ ಕ್ರಿಸ್ತ ಯೇಸು ದೇವದೂತರಿಗಿಂತಲೂ ಶ್ರೇಷ್ಠರು</para>
  <para style="p">
    <verse number="5" style="v" sid="HEB 1:5"/>ದೇವರು ತಮ್ಮ ದೂತರೊಳಗೆ ಯಾರಿಗಾದರೂ ಹೀಗೆ ಎಂದಾದರೂ ಹೇಳಿದ್ದುಂಟೋ,</para>
  <para style="q1" vid="HEB 1:5">“ನೀನು ನನ್ನ ಪುತ್ರನು;</para>
  <para style="q2" vid="HEB 1:5">ಇಂದು ನಾನು ನಿನ್ನ ತಂದೆಯಾಗಿದ್ದೇನೆ!”<note caller="+" style="f"><char style="fr" closed="false">1:5 </char><char style="ft" closed="false"><char style="xt"><ref loc="PSA 2:7">ಕೀರ್ತನೆ 2:7</ref></char></char></note></para>
  <para style="m" vid="HEB 1:5">ಎಂದೂ,</para>
  <para style="q1" vid="HEB 1:5">“ನಾನು ಆತನ ತಂದೆಯಾಗಿರುವೆನು;</para>
  <para style="q2" vid="HEB 1:5">ಆತನು ನನಗೆ ಮಗನಾಗಿರುವನು!”<note caller="+" style="f"><char style="fr" closed="false">1:5 </char><char style="ft" closed="false"><char style="xt"><ref loc="2SA 7:14">2 ಸಮು 7:14</ref>; <ref loc="1CH 17:13">1 ಪೂರ್ವ 17:13</ref></char></char></note><verse eid="HEB 1:5"/></para>
  <para style="m">
    <verse number="6" style="v" sid="HEB 1:6"/>ಇದಲ್ಲದೆ ಮೊದಲು ಹುಟ್ಟಿದವರನ್ನು ದೇವರು ಲೋಕದೊಳಗೆ ಬರಮಾಡುವಾಗ,</para>
  <para style="q1" vid="HEB 1:6">“ದೇವದೂತರೆಲ್ಲರೂ ಆತನನ್ನು ಆರಾಧಿಸಲಿ!”<note caller="+" style="f"><char style="fr" closed="false">1:6 </char><char style="ft" closed="false"><char style="xt"><ref loc="DEU 32:43">ಧರ್ಮೋ 32:43</ref></char></char></note> ಎಂದು ಹೇಳಿದ್ದಾರೆ.<verse eid="HEB 1:6"/></para>
  <para style="m">
    <verse number="7" style="v" sid="HEB 1:7"/>ದೂತರ ವಿಷಯದಲ್ಲಿ ದೇವರು ಮಾತನಾಡುವಾಗ,</para>
  <para style="q1" vid="HEB 1:7">“ಅವರು ತಮ್ಮ ದೂತರನ್ನು ಆತ್ಮಗಳಾಗಿಯೂ</para>
  <para style="q2" vid="HEB 1:7">ತಮ್ಮ ಸೇವಕರನ್ನು ಅಗ್ನಿಜ್ವಾಲೆಯನ್ನಾಗಿಯೂ ಮಾಡುತ್ತಾರೆ!”<note caller="+" style="f"><char style="fr" closed="false">1:7 </char><char style="ft" closed="false"><char style="xt"><ref loc="PSA 104:4">ಕೀರ್ತನೆ 104:4</ref></char></char></note> ಎಂದು ಹೇಳಿದ್ದಾರೆ.<verse eid="HEB 1:7"/></para>
  <para style="m">
    <verse number="8" style="v" sid="HEB 1:8"/>ತಂದೆ ದೇವರು ತಮ್ಮ ಪುತ್ರ ಆಗಿರುವವರ ವಿಷಯದಲ್ಲಿ ಹೀಗೆ ಹೇಳಿದ್ದಾರೆ:</para>
  <para style="q1" vid="HEB 1:8">“ದೇವರೇ, ನಿಮ್ಮ ಸಿಂಹಾಸನವು ಯುಗಯುಗಾಂತರಗಳಲ್ಲಿಯೂ ಇರುವುದು.</para>
  <para style="q2" vid="HEB 1:8">ನೀತಿದಂಡವೇ ನಿಮ್ಮ ರಾಜದಂಡವಾಗಿದೆ.<verse eid="HEB 1:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="HEB 1:9"/>ನೀವು ನೀತಿಯನ್ನು ಪ್ರೀತಿಸಿದ್ದೀರಿ. ಅನೀತಿಯನ್ನು ದ್ವೇಷಿಸಿದ್ದೀರಿ;</para>
  <para style="q2" vid="HEB 1:9">ಆದ್ದರಿಂದ ದೇವರೇ, ನಿಮ್ಮ ದೇವರು ನಿಮ್ಮನ್ನು ನಿಮ್ಮ ಜೊತೆಗಾರರಿಗಿಂತ ಮಿಗಿಲಾಗಿ</para>
  <para style="q2" vid="HEB 1:9">ಆನಂದದ ತೈಲದಿಂದ ಅಭಿಷೇಕಿಸಿದ್ದಾರೆ!”<note caller="+" style="f"><char style="fr" closed="false">1:9 </char><char style="ft" closed="false"><char style="xt"><ref loc="PSA 45:6">ಕೀರ್ತನೆ 45:6</ref>,<ref loc="PSA 45:7">7</ref></char></char></note><verse eid="HEB 1:9"/></para>
  <para style="m">
    <verse number="10" style="v" sid="HEB 1:10"/>ಇದಲ್ಲದೆ ದೇವರು ಹೀಗೆಂದರು:</para>
  <para style="q1" vid="HEB 1:10">“ಕರ್ತದೇವರೇ, ಆದಿಯಲ್ಲಿ ನೀವು ಭೂಮಿಗೆ ಅಸ್ತಿವಾರವನ್ನು ಹಾಕಿದ್ದೀರಿ,</para>
  <para style="q2" vid="HEB 1:10">ಆಕಾಶಗಳು ನಿಮ್ಮ ಕೈಕೆಲಸಗಳಾಗಿವೆ.<verse eid="HEB 1:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="HEB 1:11"/>ಅವು ನಾಶವಾಗುವವು. ಆದರೆ ನೀವು ಸದಾಕಾಲವೂ ಜೀವಿಸುತ್ತೀರಿ.</para>
  <para style="q2" vid="HEB 1:11">ಅವೆಲ್ಲವೂ ವಸ್ತ್ರದಂತೆ ಹಳೆಯದಾಗುವವು.<verse eid="HEB 1:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="HEB 1:12"/>ಅವುಗಳನ್ನು ಮೇಲಂಗಿಯಂತೆ ಮಡಿಸುತ್ತಿರಿ,</para>
  <para style="q2" vid="HEB 1:12">ಅವು ವಸ್ತ್ರದಂತೆ ಮಾರ್ಪಡುತ್ತವೆ.</para>
  <para style="q1" vid="HEB 1:12">ಆದರೆ ನೀವು ಏಕರೀತಿಯಾಗಿದ್ದೀರಿ.</para>
  <para style="q2" vid="HEB 1:12">ನಿಮ್ಮ ವರ್ಷಗಳು ಮುಗಿದುಹೋಗುವುದಿಲ್ಲ!”<note caller="+" style="f"><char style="fr" closed="false">1:12 </char><char style="ft" closed="false"><char style="xt"><ref loc="PSA 102:25-27">ಕೀರ್ತನೆ 102:25-27</ref></char></char></note><verse eid="HEB 1:12"/></para>
  <para style="m">
    <verse number="13" style="v" sid="HEB 1:13"/>ಆದರೆ ದೇವದೂತರಲ್ಲಿ ಯಾರ ವಿಷಯದಲ್ಲಿಯಾದರೂ,</para>
  <para style="q1" vid="HEB 1:13">“ನಾನು ನಿನ್ನ ವಿರೋಧಿಗಳನ್ನು</para>
  <para style="q2" vid="HEB 1:13">ನಿನ್ನ ಪಾದಗಳ ಪೀಠವಾಗಿ ಮಾಡುವವರೆಗೂ</para>
  <para style="q2" vid="HEB 1:13">ನನ್ನ ಬಲಗಡೆಯಲ್ಲಿ ಕುಳಿತುಕೊಂಡಿರು!”<note caller="+" style="f"><char style="fr" closed="false">1:13 </char><char style="ft" closed="false"><char style="xt"><ref loc="PSA 110:1">ಕೀರ್ತನೆ 110:1</ref></char></char></note></para>
  <para style="m" vid="HEB 1:13">ಎಂಬುದಾಗಿ ದೇವರು ಎಂದಾದರೂ ಹೇಳಿದ್ದುಂಟೇ?<verse eid="HEB 1:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="HEB 1:14"/>ಈ ದೇವದೂತರೆಲ್ಲರೂ ರಕ್ಷಣೆಯನ್ನು ಬಾಧ್ಯವಾಗಿ ಹೊಂದಬೇಕಾಗಿರುವವರ ಸೇವೆಗೋಸ್ಕರ ಕಳುಹಿಸಲಾದ ಸೇವೆಯ ಆತ್ಮಗಳು ಅಲ್ಲವೇ?<verse eid="HEB 1:14"/></para>
  <chapter eid="HEB 1"/>
  <chapter number="2" style="c" sid="HEB 2"/>
  <para style="s1">ಲಕ್ಷ್ಯಕೊಡಲು ಎಚ್ಚರಿಕೆ</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 2:1"/>ಆದ್ದರಿಂದ ದಾರಿಬಿಟ್ಟು ಹೋಗದಂತೆ, ನಾವು ಕೇಳಿದ ಸಂಗತಿಗಳಿಗೆ ಹೆಚ್ಚು ಲಕ್ಷ್ಯ ಕೊಡುವವರಾಗಿರಬೇಕು. <verse eid="HEB 2:1"/><verse number="2" style="v" sid="HEB 2:2"/>ಏಕೆಂದರೆ ದೇವದೂತರ ಮೂಲಕ ಹೇಳಲಾದ ವಾಕ್ಯವೇ ದೃಢಪಡಿಸಲಾಯಿತು. ಆದ್ದರಿಂದ ಆ ವಾಕ್ಯವನ್ನು ಮೀರಿದವರಿಗೂ ಅವಿಧೇಯರಾದವರಿಗೂ ನ್ಯಾಯವಾದ ದಂಡನೆ ಕೊಡಲಾಯಿತು. <verse eid="HEB 2:2"/><verse number="3" style="v" sid="HEB 2:3"/>ಇಂತಹ ಮಹಾ ರಕ್ಷಣೆಯನ್ನು ನಾವು ಅಲಕ್ಷ್ಯ ಮಾಡಿದರೆ ತಪ್ಪಿಸಿಕೊಳ್ಳುವುದು ಹೇಗೆ? ಈ ರಕ್ಷಣೆಯನ್ನು ನಮಗೆ ಕರ್ತ ಆಗಿರುವ ಯೇಸುವೇ ಮೊದಲು ತಿಳಿಸಿದ್ದಾರೆ. ಅವರಿಂದ ಕೇಳಿಸಿಕೊಂಡವರೂ ನಮಗೆ ಆ ರಕ್ಷಣೆಯನ್ನು ದೃಢಪಡಿಸಿದ್ದಾರೆ. <verse eid="HEB 2:3"/><verse number="4" style="v" sid="HEB 2:4"/>ದೇವರು ಸಹ ಸೂಚಕಕಾರ್ಯಗಳಿಂದಲೂ ಅದ್ಭುತಕಾರ್ಯಗಳಿಂದಲೂ ನಾನಾ ವಿಧವಾದ ಮಹತ್ಕಾರ್ಯಗಳಿಂದಲೂ ತಮ್ಮ ಚಿತ್ತಾನುಸಾರವಾಗಿ ದಯಪಾಲಿಸಿದ ಪವಿತ್ರಾತ್ಮರ ವರದಾನಗಳಿಂದಲೂ ಸಾಕ್ಷಿನೀಡಿ ದೃಢಪಡಿಸಿದ್ದಾರೆ.<verse eid="HEB 2:4"/></para>
  <para style="s1">ಯೇಸುವಿನ ಪೂರ್ಣ ಮಾನವೀಯತೆ</para>
  <para style="p">
    <verse number="5" style="v" sid="HEB 2:5"/>ನಾವು ಸಾರುತ್ತಿರುವ ಮುಂದಣ ಲೋಕವನ್ನು ದೇವರು ತಮ್ಮ ದೂತರಿಗೆ ಅಧೀನ ಮಾಡಲಿಲ್ಲವಲ್ಲ. <verse eid="HEB 2:5"/><verse number="6" style="v" sid="HEB 2:6"/>ಆದರೆ ಪವಿತ್ರ ವೇದದ ಒಂದು ಸ್ಥಳದಲ್ಲಿ ಒಬ್ಬನು ಹೀಗೆ ಸಾಕ್ಷಿ ಹೇಳಿದ್ದಾನೆ:</para>
  <para style="q1" vid="HEB 2:6">“ಮನುಷ್ಯನನ್ನು ನೀನು ನೆನಸುವುದಕ್ಕೆ ಅವನು ಎಷ್ಟು ಮಾತ್ರದವನು?</para>
  <para style="q2" vid="HEB 2:6">ಮನುಷ್ಯಪುತ್ರನನ್ನು ಲಕ್ಷ್ಯವಿಡುವುದಕ್ಕೆ ಅವನು ಎಷ್ಟರವನು?<verse eid="HEB 2:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="HEB 2:7"/>ನೀನು ಆತನನ್ನು ದೇವದೂತರಿಗಿಂತ ಸ್ವಲ್ಪವೇ<note caller="+" style="f"><char style="fr" closed="false">2:7 </char><char style="ft" closed="false">ಅಥವಾ </char><char style="fqa" closed="false">ಸ್ವಲ್ಪ ಕಾಲಕ್ಕೆ</char></note> ಕಡಿಮೆಯಾಗಿ ಮಾಡಿದೆಯಲ್ಲಾ?</para>
  <para style="q2" vid="HEB 2:7">ಮಹಿಮೆಯನ್ನೂ ಮಾನವನ್ನೂ ಆತನಿಗೆ ಕಿರೀಟವನ್ನಾಗಿ ಇಟ್ಟೆ.<verse eid="HEB 2:7"/></para>
  <para style="q2">
    <verse number="8" style="v" sid="HEB 2:8"/>ಎಲ್ಲವನ್ನೂ ಆತನ ಪಾದಗಳ ಕೆಳಗೆ ಹಾಕಿ ಆತನಿಗೆ ಅಧೀನ ಮಾಡಿದ್ದೀಯಲ್ಲವೇ?”<note caller="+" style="f"><char style="fr" closed="false">2:8 </char><char style="ft" closed="false"><char style="xt"><ref loc="PSA 8:4">ಕೀರ್ತನೆ 8:4</ref>,<ref loc="PSA 8:5">5</ref>,<ref loc="PSA 8:6">6</ref></char></char></note></para>
  <para style="m" vid="HEB 2:8">ಹೀಗೆ ದೇವರು ಎಲ್ಲವನ್ನೂ ಆತನಿಗೆ ಅಧೀನ ಮಾಡಿದರೆಂಬುದರಲ್ಲಿ ಆತನಿಗೆ ಒಂದನ್ನಾದರೂ ಅಧೀನಮಾಡದೆ ಬಿಡಲಿಲ್ಲ ಎಂಬುದು ಸ್ವಷ್ಟವಾಗುತ್ತದೆ. ಆದರೆ ಈಗ ಎಲ್ಲವೂ ಆತನಿಗೆ ಅಧೀನವಾಗಿರುವುದನ್ನು ನಾವು ಇನ್ನೂ ಕಾಣುವದಿಲ್ಲ. <verse eid="HEB 2:8"/><verse number="9" style="v" sid="HEB 2:9"/>ಆದರೂ ದೇವದೂತರಿಗಿಂತ ಸ್ವಲ್ಪಕಾಲ ಕಡಿಮೆಯಾಗಿ ಮಾಡಲಾದ ಆ ಒಬ್ಬಾತನು ಯೇಸುವೇ. ಈ ಯೇಸು ಬಾಧೆಪಟ್ಟು ಮೃತಪಟ್ಟಿದ್ದರಿಂದಲೇ ಮಹಿಮೆಯನ್ನೂ ಮಾನವನ್ನೂ ಕಿರೀಟವಾಗಿ ಹೊಂದಿದರೆಂದು ಎಂದು ನಾವು ಕಾಣುತ್ತೇವೆ. ದೇವರ ಕೃಪೆಯಿಂದಲೇ ಎಲ್ಲರಿಗೋಸ್ಕರ ಮರಣವನ್ನು ಈ ಯೇಸು ಅನುಭವಿಸಬೇಕಾಗಿತ್ತು.<verse eid="HEB 2:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="HEB 2:10"/>ದೇವರು ಸಮಸ್ತವನ್ನೂ ತಮಗೋಸ್ಕರವೂ ತಮ್ಮ ಮೂಲಕವೂ ಉಂಟುಮಾಡಿ ಬಹುಮಂದಿ ಮಕ್ಕಳನ್ನು ಮಹಿಮೆಗೆ ತರುವಂತೆ ಅವರ ರಕ್ಷಣಾ ನಾಯಕರಾದ ಕ್ರಿಸ್ತ ಯೇಸುವನ್ನು ಬಾಧೆಗಳ ಮೂಲಕ ಸಿದ್ಧಿಗೆ ತರುವುದು ದೇವರಿಗೆ ಯುಕ್ತವಾಗಿತ್ತು. <verse eid="HEB 2:10"/><verse number="11" style="v" sid="HEB 2:11"/>ಪವಿತ್ರ ಮಾಡುವ ದೇವರೂ ಪವಿತ್ರರಾದವರೆಲ್ಲರೂ ಒಂದೇ ಕುಟುಂಬಕ್ಕೆ ಸೇರಿದವರಾಗಿದ್ದಾರೆ. ಈ ಕಾರಣದಿಂದ ಯೇಸು ಅವರನ್ನು ಸಹೋದರರೆಂದು ಕರೆಯುವುದಕ್ಕೆ ನಾಚಿಕೆಪಡದೆ, <verse eid="HEB 2:11"/><verse number="12" style="v" sid="HEB 2:12"/>ಹೇಳಿದ್ದು,</para>
  <para style="q1" vid="HEB 2:12">“ನಿಮ್ಮ ಹೆಸರನ್ನು ನನ್ನ ಸಹೋದರರಿಗೆ ಸಾರುವೆನು.</para>
  <para style="q2" vid="HEB 2:12">ಸಭಾ ಮಧ್ಯದಲ್ಲಿ ನಿಮಗೆ ಸ್ತುತಿ ಪದಗಳನ್ನು ಹಾಡುವೆನು.”<note caller="+" style="f"><char style="fr" closed="false">2:12 </char><char style="ft" closed="false"><char style="xt"><ref loc="PSA 22:22">ಕೀರ್ತನೆ 22:22</ref></char></char></note><verse eid="HEB 2:12"/></para>
  <para style="m">
    <verse number="13" style="v" sid="HEB 2:13"/>ಎಂದೂ ಪುನಃ,</para>
  <para style="q1" vid="HEB 2:13">“ನಾನು ದೇವರ ಮೇಲೆ ಭರವಸೆ ಇಡುವೆನು.”<note caller="+" style="f"><char style="fr" closed="false">2:13 </char><char style="ft" closed="false"><char style="xt"><ref loc="ISA 8:17">ಯೆಶಾಯ 8:17</ref></char></char></note></para>
  <para style="m" vid="HEB 2:13">ಎಂದೂ ಪುನಃ,</para>
  <para style="q1" vid="HEB 2:13">“ಇಗೋ ನಾನೂ, ದೇವರು ನನಗೆ ದಯಪಾಲಿಸಿರುವ ಮಕ್ಕಳೂ ನನಗಿದ್ದಾರೆ.”<note caller="+" style="f"><char style="fr" closed="false">2:13 </char><char style="ft" closed="false"><char style="xt"><ref loc="ISA 8:18">ಯೆಶಾಯ 8:18</ref></char></char></note></para>
  <para style="m" vid="HEB 2:13">ಎಂದು ಹೇಳಿದ್ದಾರೆ.<verse eid="HEB 2:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="HEB 2:14"/>ಮಕ್ಕಳು ರಕ್ತಮಾಂಸಧಾರಿಗಳು ಆಗಿರುವುದರಿಂದ ಯೇಸು ತಮ್ಮ ಮರಣದಿಂದಲೇ ಮರಣಾಧಿಕಾರಿಯನ್ನು ಅಂದರೆ, ಸೈತಾನನನ್ನು ನಾಶಮಾಡುವುದಕ್ಕೂ <verse eid="HEB 2:14"/><verse number="15" style="v" sid="HEB 2:15"/>ಮರಣ ಭಯದಿಂದ ಜೀವಮಾನದಲ್ಲೆಲ್ಲಾ ದಾಸತ್ವದೊಳಗಿದ್ದವರನ್ನು ಬಿಡಿಸುವುದಕ್ಕೂ ಅವರ ಮಾನವತ್ವದಲ್ಲಿ ಪಾಲುಗಾರರಾದರು. <verse eid="HEB 2:15"/><verse number="16" style="v" sid="HEB 2:16"/>ಯೇಸು ನಿಜವಾಗಿಯೂ ದೂತರಿಗಾಗಿ ಹಾಗೆ ಮಾಡದೆ ಅಬ್ರಹಾಮನ ಸಂತತಿಯವರಿಗಾಗಿ ಹಾಗೆ ಮಾಡಿದರು. <verse eid="HEB 2:16"/><verse number="17" style="v" sid="HEB 2:17"/>ಆದ್ದರಿಂದ ಯೇಸು ಎಲ್ಲಾ ವಿಷಯಗಳಲ್ಲಿಯೂ ತಮ್ಮ ಸಹೋದರರಿಗೆ ಸಮಾನವಾಗಬೇಕಾಯಿತು. ಹೀಗೆ ಅವರು ಜನರ ಪಾಪಗಳನ್ನು ನಿವಾರಣೆ ಮಾಡುವುದಕ್ಕಾಗಿ ದೇವರ ಸೇವೆಯಲ್ಲಿ ಕರುಣೆಯುಳ್ಳ ನಂಬಿಗಸ್ತರಾದ ಮಹಾಯಾಜಕರಾದರು. <verse eid="HEB 2:17"/><verse number="18" style="v" sid="HEB 2:18"/>ಆದ್ದರಿಂದ ಯೇಸು ತಾವೇ ಶೋಧನೆಗೊಳಗಾಗಿ ಬಾಧೆಯನ್ನು ಅನುಭವಿಸಿರುವುದರಿಂದ, ಶೋಧನೆಗೆ ಒಳಗಾಗುವವರಿಗೆ ಸಹಾಯ ಮಾಡುವುದಕ್ಕೆ ಶಕ್ತರಾಗಿದ್ದಾರೆ.<verse eid="HEB 2:18"/></para>
  <chapter eid="HEB 2"/>
  <chapter number="3" style="c" sid="HEB 3"/>
  <para style="s1">ಮೋಶೆಗಿಂತ ಯೇಸು ಶ್ರೇಷ್ಠರು</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 3:1"/>ಆದ್ದರಿಂದ ಪರಿಶುದ್ಧರಾದ ಪ್ರಿಯರೇ, ಪರಲೋಕದ ಕರೆಯುವಿಕೆಯಲ್ಲಿ ಪಾಲುಗಾರರೇ, ನಾವು ಅರಿಕೆಮಾಡುವ ಅಪೊಸ್ತಲರೂ ಮಹಾಯಾಜಕರೂ ಆಗಿರುವ ಯೇಸುವನ್ನೇ ಆಲೋಚಿಸಿರಿ. <verse eid="HEB 3:1"/><verse number="2" style="v" sid="HEB 3:2"/>ಮೋಶೆಯು ದೇವರ ಮನೆಯಲ್ಲೆಲ್ಲಾ ನಂಬಿಗಸ್ತನಾಗಿದ್ದಂತೆಯೇ ಯೇಸು ತಮ್ಮನ್ನು ನೇಮಿಸಿದವರಿಗೆ ನಂಬಿಗಸ್ತರಾಗಿದ್ದಾರೆ. <verse eid="HEB 3:2"/><verse number="3" style="v" sid="HEB 3:3"/>ಮನೆಗಿಂತ ಮನೆಕಟ್ಟಿದವನಿಗೆ ಹೆಚ್ಚಾದ ಗೌರವವಿರುವುದರಿಂದ, ಮೋಶೆಗಿಂತ ಯೇಸು ಹೆಚ್ಚಾದ ಮಹಿಮೆಗೆ ಯೋಗ್ಯರೆಂದು ಎಣಿಸಿಕೊಂಡಿದ್ದಾರೆ. <verse eid="HEB 3:3"/><verse number="4" style="v" sid="HEB 3:4"/>ಏಕೆಂದರೆ ಪ್ರತಿಯೊಂದು ಮನೆಯೂ ಯಾರೋ ಒಬ್ಬರಿಂದ ಕಟ್ಟಲಾಗುತ್ತದೆ. ಆದರೆ ಸಮಸ್ತವನ್ನು ಕಟ್ಟಿದವರು ದೇವರೇ. <verse eid="HEB 3:4"/><verse number="5" style="v" sid="HEB 3:5"/>“ನಿಜವಾಗಿಯೂ ಮೋಶೆಯು ಸೇವಕನಾಗಿ ದೇವರ ಮನೆಯಲ್ಲೆಲ್ಲಾ ನಂಬಿಗಸ್ತನಾಗಿದ್ದನು.”<note caller="+" style="f"><char style="fr" closed="false">3:5 </char><char style="ft" closed="false"><char style="xt"><ref loc="NUM 12:7">ಅರಣ್ಯ 12:7</ref></char></char></note> ಅವನು, ಮುಂದೆ ಪ್ರಕಟವಾಗಬೇಕಾಗಿದ್ದ ಒಬ್ಬರಿಗೆ ಸಾಕ್ಷಿಯಾಗಿದ್ದನು. <verse eid="HEB 3:5"/><verse number="6" style="v" sid="HEB 3:6"/>ಕ್ರಿಸ್ತ ಯೇಸುವಾದರೋ ಮಗನಾಗಿ ದೇವರ ಮನೆಯ ಮೇಲೆ ನಂಬಿಗಸ್ತರಾಗಿದ್ದಾರೆ. ಆದುದರಿಂದ ನಾವು ನಮ್ಮ ಧೈರ್ಯವನ್ನೂ ನಾವು ಹೊಗಳಿಕೊಳ್ಳುವ ನಿರೀಕ್ಷೆಯನ್ನೂ ಕಡೆಯತನಕ ದೃಢವಾಗಿ ಹಿಡಿದುಕೊಂಡಿದ್ದರೆ ನಾವೇ ದೇವರ ಮನೆಯಾಗಿರುತ್ತೇವೆ.<verse eid="HEB 3:6"/></para>
  <para style="s1">ಅವಿಶ್ವಾಸದ ವಿರುದ್ಧ ಎಚ್ಚರಿಕೆ</para>
  <para style="p">
    <verse number="7" style="v" sid="HEB 3:7"/>ಆದ್ದರಿಂದ ಪವಿತ್ರಾತ್ಮ ದೇವರು ಹೇಳುವ ಪ್ರಕಾರ,</para>
  <para style="q1" vid="HEB 3:7">“ನೀವು ಈ ಹೊತ್ತು ದೇವರ ಸ್ವರಕ್ಕೆ ಕಿವಿಗೊಟ್ಟರೆ,<verse eid="HEB 3:7"/></para>
  <para style="q2">
    <verse number="8" style="v" sid="HEB 3:8"/>ಅರಣ್ಯದಲ್ಲಿದ್ದಾಗ ನನ್ನನ್ನು ಪರೀಕ್ಷಿಸಿದ</para>
  <para style="q1" vid="HEB 3:8">ದಿನದಲ್ಲಿ ಕೋಪಕ್ಕೆ ಈಡುಮಾಡಿದಂತೆ,</para>
  <para style="q2" vid="HEB 3:8">ನಿಮ್ಮ ಹೃದಯಗಳನ್ನು ಕಠಿಣ ಮಾಡಿಕೊಳ್ಳಬೇಡಿರಿ.<verse eid="HEB 3:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="HEB 3:9"/>ನಿಮ್ಮ ಪಿತೃಗಳು ನನ್ನನ್ನು ಕೆಣಕಿ ಪರೀಕ್ಷಿಸಿದರು,</para>
  <para style="q2" vid="HEB 3:9">ನಲವತ್ತು ವರ್ಷ ನನ್ನ ಕಾರ್ಯಗಳನ್ನು ನೋಡಿದರು.<verse eid="HEB 3:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="HEB 3:10"/>ಆದ್ದರಿಂದ ನಾನು ಆ ಸಂತತಿಯವರ ಮೇಲೆ ಕೋಪಿಸಿಕೊಂಡು,</para>
  <para style="q2" vid="HEB 3:10">‘ಅವರು ಯಾವಾಗಲೂ ತಮ್ಮ ಹೃದಯದಲ್ಲಿ ತಪ್ಪಿಹೋಗುತ್ತಾರೆ,</para>
  <para style="q2" vid="HEB 3:10">ಅವರು ನನ್ನ ಮಾರ್ಗಗಳನ್ನು ತಿಳಿದುಕೊಳ್ಳಲಿಲ್ಲ.’<verse eid="HEB 3:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="HEB 3:11"/>ಆದ್ದರಿಂದ, ‘ಅವರು ನನ್ನ ವಿಶ್ರಾಂತಿಯಲ್ಲಿ ಸೇರುವುದೇ ಇಲ್ಲ!’</para>
  <para style="q2" vid="HEB 3:11">ಎಂದು ನಾನು ನನ್ನ ಕೋಪದಲ್ಲಿ ಪ್ರಮಾಣಮಾಡಿದೆನು!”<note caller="+" style="f"><char style="fr" closed="false">3:11 </char><char style="ft" closed="false"><char style="xt"><ref loc="PSA 95:7-11">ಕೀರ್ತನೆ 95:7-11</ref></char></char></note><verse eid="HEB 3:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="HEB 3:12"/>ಪ್ರಿಯರೇ, ದೇವರನ್ನು ಬಿಟ್ಟುಹೋಗುವ ಅವಿಶ್ವಾಸಯುಳ್ಳ ದುಷ್ಟ ಹೃದಯವು ನಿಮ್ಮಲ್ಲಿ ಯಾರಿಗೂ ಇರದಂತೆ ಎಚ್ಚರಿಕೆಯಿಂದ ನೋಡಿಕೊಳ್ಳಿರಿ. <verse eid="HEB 3:12"/><verse number="13" style="v" sid="HEB 3:13"/>ನಿಮ್ಮಲ್ಲಿ ಯಾರೂ ಪಾಪದಿಂದ ಮೋಸಹೋಗಿ ಕಠಿಣರಾಗದಂತೆ, “ಈ ಹೊತ್ತು” ಎಂಬುದು ಇರುವವರೆಗೆ ಪ್ರತಿದಿನವೂ ಒಬ್ಬರನ್ನೊಬ್ಬರು ಪ್ರೋತ್ಸಾಹಿಸಿರಿ. <verse eid="HEB 3:13"/><verse number="14" style="v" sid="HEB 3:14"/>ಮೊದಲಿನಿಂದಿರುವ ನಮ್ಮ ನಿರೀಕ್ಷೆಯನ್ನು ಅಂತ್ಯದವರೆಗೂ ನಾವು ದೃಢವಾಗಿ ಹಿಡಿದುಕೊಳ್ಳುವುದಾದರೆ ಕ್ರಿಸ್ತ ಯೇಸುವಿನ ಭಾಗಿಗಳಾಗಿದ್ದೇವಲ್ಲಾ! <verse eid="HEB 3:14"/><verse number="15" style="v" sid="HEB 3:15"/>ಈಗಲೇ ಹೇಳಿದಂತೆ:</para>
  <para style="q1" vid="HEB 3:15">“ನೀವು ಈ ಹೊತ್ತು ದೇವರ ಸ್ವರವನ್ನು ಕೇಳಿದರೆ,</para>
  <para style="q2" vid="HEB 3:15">ತಿರುಗಿಬಿದ್ದಾಗ ನಡೆದಂತೆ</para>
  <para style="q2" vid="HEB 3:15">ನಿಮ್ಮ ಹೃದಯಗಳನ್ನು ಕಠಿಣ ಮಾಡಿಕೊಳ್ಳಬೇಡಿರಿ.”<note caller="+" style="f"><char style="fr" closed="false">3:15 </char><char style="ft" closed="false"><char style="xt"><ref loc="PSA 95:7">ಕೀರ್ತನೆ 95:7</ref>,<ref loc="PSA 95:8">8</ref></char></char></note><verse eid="HEB 3:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="HEB 3:16"/>“ದೇವರು ನುಡಿದದ್ದನ್ನು ಕೇಳಿ ಕೋಪಗೊಂಡು ವಿರೋಧಿಸಿದವರು ಯಾರು? ಆದರೂ ಮೋಶೆಯ ಮೂಲಕ ಈಜಿಪ್ಟಿನಿಂದ ಹೊರಟು ಬಂದವರೆಲ್ಲರೂ ಹಾಗೆ ಮಾಡಲಿಲ್ಲವಲ್ಲಾ? <verse eid="HEB 3:16"/><verse number="17" style="v" sid="HEB 3:17"/>ನಲವತ್ತು ವರ್ಷ ದೇವರು ಯಾರ ಮೇಲೆ ಕೋಪಗೊಂಡರು? ಪಾಪಮಾಡಿದವರ ಮೇಲೆ ಅಲ್ಲವೇ? ಅವರ ಶವಗಳು ಅರಣ್ಯದಲ್ಲಿ ಬಿದ್ದವಲ್ಲಾ! <verse eid="HEB 3:17"/><verse number="18" style="v" sid="HEB 3:18"/>ವಿಶ್ರಾಂತಿಯಲ್ಲಿ ಅವರು ಸೇರುವುದೇ ಇಲ್ಲ!” ಎಂದು ಯಾರನ್ನು ಕುರಿತು ಅವರು ಪ್ರಮಾಣ ಮಾಡಿದರು, ಅವಿಧೇಯರಾದವರ ಕುರಿತಲ್ಲವೇ? <verse eid="HEB 3:18"/><verse number="19" style="v" sid="HEB 3:19"/>ಅವರು ಸೇರಲಾರದೆ ಹೋದದ್ದು ಅವರ ಅವಿಶ್ವಾಸದಿಂದಲೇ ಎಂದು ಕಾಣುತ್ತೇವೆ.<verse eid="HEB 3:19"/></para>
  <chapter eid="HEB 3"/>
  <chapter number="4" style="c" sid="HEB 4"/>
  <para style="s1">ದೇವಜನರಿಗೆ ಸಬ್ಬತ್ ಒಂದು ವಿಶ್ರಾಂತಿ ದಿನ</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 4:1"/>ಹೀಗಿರಲಾಗಿ ದೇವರ ವಿಶ್ರಾಂತಿಯಲ್ಲಿ ಸೇರುವೆವು ಎಂಬ ವಾಗ್ದಾನವು ಇನ್ನೂ ಉಳಿದಿರಲು ನಿಮ್ಮಲ್ಲಿ ಯಾರಾದರೂ ಅದನ್ನು ಹೊಂದದೆ ಇರಬಾರದು ಎಂದು ಎಚ್ಚರವಹಿಸೋಣ. <verse eid="HEB 4:1"/><verse number="2" style="v" sid="HEB 4:2"/>ಇಸ್ರಾಯೇಲರಿಗೆ ಸುವಾರ್ತೆಯು ಸಾರೋಣವಾದಂತೆಯೇ ನಮಗೂ ಸಾರಿಹೇಳಲಾಯಿತು. ಆದರೆ ಕೇಳಿದವರು ವಿಧೇಯರಾದವರ ನಂಬಿಕೆಯಲ್ಲಿ ಭಾಗವಹಿಸದೇ ಹೋದದ್ದರಿಂದ, ಸಾರಿದ ವಾಕ್ಯವು ಅವರಿಗೆ ಪ್ರಯೋಜನವಾಗಲಿಲ್ಲ. <verse eid="HEB 4:2"/><verse number="3" style="v" sid="HEB 4:3"/>ಈಗ ದೇವರು ಹೇಳಿದಂತೆಯೇ ವಿಶ್ವಾಸದಲ್ಲಿರುವ ನಾವು ಆ ವಿಶ್ರಾಂತಿಯಲ್ಲಿ ಪ್ರವೇಶಿಸಿದೆವು,</para>
  <para style="q1" vid="HEB 4:3">“ ‘ಅವರು ನನ್ನ ವಿಶ್ರಾಂತಿಯಲ್ಲಿ ಸೇರುವುದೇ ಇಲ್ಲ’</para>
  <para style="q2" vid="HEB 4:3">ಎಂದು ನಾನು ಕೋಪದಿಂದ ಪ್ರಮಾಣಮಾಡಿದೆನು,”<note caller="+" style="f"><char style="fr" closed="false">4:3 </char><char style="ft" closed="false"><char style="xt"><ref loc="PSA 95:11">ಕೀರ್ತನೆ 95:11</ref></char></char></note></para>
  <para style="m" vid="HEB 4:3">ಆದರೂ ದೇವರ ಕೆಲಸವು ಜಗತ್ತಿನ ಸೃಷ್ಟಿಯ ಕಾರ್ಯದಿಂದಲೇ ಮುಗಿದಿದೆ. <verse eid="HEB 4:3"/><verse number="4" style="v" sid="HEB 4:4"/>ಪವಿತ್ರ ವೇದದ ಯಾವುದೋ ಒಂದು ಸ್ಥಳದಲ್ಲಿ ಏಳನೆಯ ದಿವಸವನ್ನು ಕುರಿತು, “ದೇವರು ತಮ್ಮ ಕಾರ್ಯಗಳನ್ನೆಲ್ಲಾ ಮುಗಿಸಿದ ಮೇಲೆ ಏಳನೆಯ ದಿನದಲ್ಲಿ ವಿಶ್ರಮಿಸಿಕೊಂಡರು,”<note caller="+" style="f"><char style="fr" closed="false">4:4 </char><char style="ft" closed="false"><char style="xt"><ref loc="GEN 2:2">ಆದಿ 2:2</ref></char></char></note> ಎಂತಲೂ, <verse eid="HEB 4:4"/><verse number="5" style="v" sid="HEB 4:5"/>ಮೇಲಿನ ವಾಕ್ಯಕ್ಕೆ ಸಂಬಂಧಿಸಿ, “ಇವರು ನನ್ನ ವಿಶ್ರಾಂತಿಯಲ್ಲಿ ಸೇರುವುದೇ ಇಲ್ಲ,” ಎಂದೂ ದೇವರು ಇನ್ನೊಂದು ಕಡೆ ಹೇಳಿದ್ದಾರೆ.<verse eid="HEB 4:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="HEB 4:6"/>ಆದ್ದರಿಂದ ಯಾರಿಗೆ ಮೊದಲು ಸುವಾರ್ತೆಯು ಸಾರಲಾಯಿತೋ ಅವರು ಅವಿಧೇಯತೆಯ ನಿಮಿತ್ತ ಆ ವಿಶ್ರಾಂತಿಯಲ್ಲಿ ಸೇರದೆಹೋದರು. ಆದರೂ ಕೆಲವರು ಆ ವಿಶ್ರಾಂತಿಯಲ್ಲಿ ಪ್ರವೇಶಿಸುವ ಅವಕಾಶ ಇನ್ನೂ ಇರುವುದರಿಂದ ಅವರು ಸೇರುವರು. <verse eid="HEB 4:6"/><verse number="7" style="v" sid="HEB 4:7"/>ದೇವರು “ಈ ಹೊತ್ತೇ” ಎಂದು ಬೇರೊಂದು ದಿವಸವನ್ನು ಗೊತ್ತು ಮಾಡುತ್ತಾರೆ. ಈ ದಿನವನ್ನು ಕುರಿತೇ ಬಹುಕಾಲದ ನಂತರ ದಾವೀದನ ಮೂಲಕ ಮೊದಲೇ ಹೀಗೆ ಹೇಳಿದ್ದಾರೆ:</para>
  <para style="q1" vid="HEB 4:7">“ನೀವು ಈ ಹೊತ್ತು ದೇವರ ಸ್ವರಕ್ಕೆ ಕಿವಿಗೊಟ್ಟರೆ,</para>
  <para style="q2" vid="HEB 4:7">ನಿಮ್ಮ ಹೃದಯಗಳನ್ನು ಕಠಿಣ ಮಾಡಿಕೊಳ್ಳಬೇಡಿರಿ.”<note caller="+" style="f"><char style="fr" closed="false">4:7 </char><char style="ft" closed="false"><char style="xt"><ref loc="PSA 95:7">ಕೀರ್ತನೆ 95:7</ref>,<ref loc="PSA 95:8">8</ref></char></char></note><verse eid="HEB 4:7"/></para>
  <para style="m">
    <verse number="8" style="v" sid="HEB 4:8"/>ಯೆಹೋಶುವನು ಅವರನ್ನು ಆ ವಿಶ್ರಾಂತಿಯಲ್ಲಿ ಸೇರಿಸಿದ್ದಾದರೆ, ದೇವರು ಬೇರೊಂದು ದಿವಸವನ್ನು ಕುರಿತು ಹೇಳುತ್ತಿರಲಿಲ್ಲವಲ್ಲ. <verse eid="HEB 4:8"/><verse number="9" style="v" sid="HEB 4:9"/>ಆದ್ದರಿಂದ ದೇವಜನರಿಗೆ ಸಬ್ಬತ್ ಎಂಬ ವಿಶ್ರಾಂತಿಯು ಇನ್ನೂ ಇದೆ. <verse eid="HEB 4:9"/><verse number="10" style="v" sid="HEB 4:10"/>ದೇವರು ತಮ್ಮ ಸೃಷ್ಟಿಕಾರ್ಯವನ್ನು ಮುಗಿಸಿ ವಿಶ್ರಾಂತಿ ಪಡೆದಂತೆ, ದೇವರ ವಿಶ್ರಾಂತಿಯನ್ನು ಪಡೆದವರು ಸಹ ತಮ್ಮ ಕೆಲಸ ಕಾರ್ಯಗಳನ್ನು ಮುಗಿಸಿ ವಿಶ್ರಾಂತಿ ಪಡೆಯುತ್ತಾರೆ. <verse eid="HEB 4:10"/><verse number="11" style="v" sid="HEB 4:11"/>ಆದ್ದರಿಂದ ಈ ವಿಶ್ರಾಂತಿಯನ್ನು ಪಡೆಯಲು ನಾವು ಪ್ರಯತ್ನಿಸೋಣ. ನಮ್ಮಲ್ಲಿ ಯಾರೂ ಆ ಜನರ ಅವಿಧೇಯತೆಯನ್ನು ಅನುಸರಿಸಿ, ನಾಶರಾಗದೇ ಇರೋಣ.<verse eid="HEB 4:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="HEB 4:12"/>ಯಾಕೆಂದರೆ ದೇವರ ವಾಕ್ಯವು ಸಜೀವವಾದದ್ದು, ಕ್ರಿಯಾತ್ಮಕವಾದದ್ದು, ಇಬ್ಬಾಯಿ ಕತ್ತಿಗಿಂತಲೂ ಹರಿತವಾದದ್ದು, ಪ್ರಾಣ ಮತ್ತು ಆತ್ಮಗಳ ಕೀಲು ಮಜ್ಜೆಗಳನ್ನು ವಿಭಾಗಿಸುವಷ್ಟರ ಮಟ್ಟಿಗೆ ಛೇದಿಸುವಂಥದ್ದು, ಹೃದಯದ ಆಲೋಚನೆಗಳನ್ನೂ ಉದ್ದೇಶಗಳನ್ನೂ ವಿವೇಚಿಸಿ ತೀರ್ಪು ನೀಡುವಂಥದ್ದು ಆಗಿದೆ. <verse eid="HEB 4:12"/><verse number="13" style="v" sid="HEB 4:13"/>ನಾವು ಲೆಕ್ಕ ಒಪ್ಪಿಸಬೇಕಾಗಿರುವ ದೇವರ ದೃಷ್ಟಿಗೆ ಸಮಸ್ತವೂ ಬಹಿರಂಗವಾದದ್ದಾಗಿಯೂ ಬಯಲಾದದ್ದಾಗಿಯೂ ಆಗಿದೆ. ಎಲ್ಲಾ ಸೃಷ್ಟಿಯಲ್ಲಿ ದೇವರ ದೃಷ್ಟಿಗೆ ಮರೆಯಾದದ್ದು ಯಾವುದೂ ಇಲ್ಲ.<verse eid="HEB 4:13"/></para>
  <para style="s1">ಯೇಸುವೇ ಶ್ರೇಷ್ಠ ಮಹಾಯಾಜಕರು</para>
  <para style="p">
    <verse number="14" style="v" sid="HEB 4:14"/>ಆದ್ದರಿಂದ ಪರಲೋಕಗಳನ್ನು ದಾಟಿಹೋದ ದೇವಪುತ್ರ ಯೇಸು ಎಂಬ ಶ್ರೇಷ್ಠ ಮಹಾಯಾಜಕರು ನಮಗಿರುವುದರಿಂದ ನಾವು ಅರಿಕೆಮಾಡುವ ವಿಶ್ವಾಸವನ್ನು ಬಿಗಿಯಾಗಿ ಹಿಡಿಯೋಣ. <verse eid="HEB 4:14"/><verse number="15" style="v" sid="HEB 4:15"/>ನಮಗಿರುವ ಮಹಾಯಾಜಕ ನಮ್ಮ ಬಲಹೀನತೆಗಳನ್ನು ಕುರಿತು ಅನುಕಂಪಗೊಳ್ಳದೆ ಇರುವವರಲ್ಲ. ಅವರು ಸರ್ವ ವಿಷಯಗಳಲ್ಲಿ ನಮ್ಮ ಹಾಗೆ ಶೋಧನೆಗೆ ಗುರಿಯಾದರೂ ಪಾಪ ಮಾತ್ರ ಮಾಡಲಿಲ್ಲ. <verse eid="HEB 4:15"/><verse number="16" style="v" sid="HEB 4:16"/>ನಾವು ಕರುಣೆಯನ್ನು ಹೊಂದುವಂತೆಯೂ ತಕ್ಕ ಸಮಯದಲ್ಲಿ ಸಹಾಯ ಮಾಡುವ ಕೃಪೆಯನ್ನು ಪಡೆಯುವಂತೆಯೂ ಧೈರ್ಯದಿಂದ ಕೃಪಾಸನದ ಬಳಿಗೆ ಬರೋಣ.<verse eid="HEB 4:16"/></para>
  <chapter eid="HEB 4"/>
  <chapter number="5" style="c" sid="HEB 5"/>
  <para style="p">
    <verse number="1" style="v" sid="HEB 5:1"/>ಪ್ರತಿಯೊಬ್ಬ ಮಹಾಯಾಜಕ ಮನುಷ್ಯರೊಳಗಿಂದ ಆರಿಸಲಾಗಿ ಕಾಣಿಕೆಗಳನ್ನೂ ಯಜ್ಞಗಳನ್ನೂ ಪಾಪಗಳಿಗಾಗಿ ಸಮರ್ಪಿಸಲು ಮನುಷ್ಯರ ಪರವಾಗಿ ದೇವರ ಕಾರ್ಯಗಳಿಗಾಗಿ ನೇಮಿಸಲಾಗುತ್ತಾನಲ್ಲಾ. <verse eid="HEB 5:1"/><verse number="2" style="v" sid="HEB 5:2"/>ಮಹಾಯಾಜಕನು ತಾನೂ ಬಲಹೀನ ಆಗಿರುವುದರಿಂದ ಆತನು ಅಜ್ಞಾನಿಗಳನ್ನೂ ಮಾರ್ಗ ತಪ್ಪಿದವರನ್ನೂ ಕುರಿತು ಕನಿಕರ ತೋರಿಸಬಲ್ಲನು. <verse eid="HEB 5:2"/><verse number="3" style="v" sid="HEB 5:3"/>ಆ ಬಲಹೀನತೆಯ ಕಾರಣದಿಂದ ಆತನು ಜನರಿಗೋಸ್ಕರ ಹೇಗೋ ಹಾಗೆಯೇ ತನಗೋಸ್ಕರವೂ ಪಾಪಗಳಿಗಾಗಿ ಯಜ್ಞಗಳನ್ನು ಅರ್ಪಿಸಬೇಕಾದವನಾಗಿದ್ದಾನೆ. <verse eid="HEB 5:3"/><verse number="4" style="v" sid="HEB 5:4"/>ಆರೋನನಂತೆ ದೇವರಿಂದ ಕರೆ ಹೊಂದದ ಹೊರತು ಯಾವನೂ ತನ್ನಷ್ಟಕ್ಕೆ ತಾನೇ ಈ ಗೌರವ ಪದವಿಯನ್ನು ವಹಿಸಿಕೊಳ್ಳಲಾರನು.<verse eid="HEB 5:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="HEB 5:5"/>ಅದೇ ರೀತಿಯಾಗಿ ಕ್ರಿಸ್ತ ಯೇಸು ಮಹಾಯಾಜಕರಾಗುವ ಮಹಿಮೆಯನ್ನು ತಮ್ಮ ಮೇಲೆ ತಾವೇ ತೆಗೆದುಕೊಳ್ಳಲಿಲ್ಲ. ಆದರೆ ದೇವರು,</para>
  <para style="q1" vid="HEB 5:5">“ನೀನು ನನ್ನ ಪುತ್ರನು,</para>
  <para style="q2" vid="HEB 5:5">ಇಂದು ನಾನು ನಿನ್ನ ತಂದೆಯಾಗಿದ್ದೇನೆ!”<note caller="+" style="f"><char style="fr" closed="false">5:5 </char><char style="ft" closed="false"><char style="xt"><ref loc="PSA 2:7">ಕೀರ್ತನೆ 2:7</ref></char></char></note> ಎಂದು ಹೇಳಿದರು.<verse eid="HEB 5:5"/></para>
  <para style="m">
    <verse number="6" style="v" sid="HEB 5:6"/>ದೇವರು ಇನ್ನೊಂದು ಸ್ಥಳದಲ್ಲಿ:</para>
  <para style="q1" vid="HEB 5:6">“ನೀನು ಸದಾಕಾಲವೂ</para>
  <para style="q2" vid="HEB 5:6">ಮೆಲ್ಕಿಜೆದೇಕನ ಕ್ರಮದ ಪ್ರಕಾರವಿರುವ ಯಾಜಕನು!”<note caller="+" style="f"><char style="fr" closed="false">5:6 </char><char style="ft" closed="false"><char style="xt"><ref loc="PSA 110:4">ಕೀರ್ತನೆ 110:4</ref></char></char></note></para>
  <para style="m" vid="HEB 5:6">ಎಂದು ಹೇಳುತ್ತಾರೆ.<verse eid="HEB 5:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="HEB 5:7"/>ಕ್ರಿಸ್ತ ಯೇಸುವು ಭೂಲೋಕದ ದಿನಗಳಲ್ಲಿ ಮರಣದಿಂದ ತಪ್ಪಿಸಲು ಶಕ್ತರಾಗಿರುವ ದೇವರಿಗೆ ಬಲವಾಗಿ ಕೂಗುತ್ತಾ ಕಣ್ಣೀರಿಟ್ಟರು. ಯೇಸುವಿನ ಭಯಭಕ್ತಿಯ ನಿಮಿತ್ತ ಅವರ ಪ್ರಾರ್ಥನೆ, ವಿಜ್ಞಾಪನೆಗಳಿಗೆ ಉತ್ತರ ಸಿಕ್ಕಿತ್ತು. <verse eid="HEB 5:7"/><verse number="8" style="v" sid="HEB 5:8"/>ಕ್ರಿಸ್ತ ಯೇಸು ದೇವರ ಪುತ್ರರಾಗಿದ್ದರೂ ತಾವು ಅನುಭವಿಸಿದ ಬಾಧೆಗಳಿಂದಲೇ ವಿಧೇಯತೆಯನ್ನು ಕಲಿತುಕೊಂಡರು. <verse eid="HEB 5:8"/><verse number="9" style="v" sid="HEB 5:9"/>ಹೀಗೆ ಯೇಸು ಪರಿಪೂರ್ಣರಾಗಿ ತಮಗೆ ವಿಧೇಯರಾಗುವ ಎಲ್ಲರಿಗೂ ನಿರಂತರವಾಗಿ ರಕ್ಷಣೆಗೆ ಕಾರಣರಾದರು. <verse eid="HEB 5:9"/><verse number="10" style="v" sid="HEB 5:10"/>ಯೇಸು ದೇವರಿಂದ ನೇಮಕಗೊಂಡು, ಮೆಲ್ಕಿಜೆದೇಕನ ಕ್ರಮದ ಪ್ರಕಾರ ಮಹಾಯಾಜಕರಾದರು.<verse eid="HEB 5:10"/></para>
  <para style="s1">ಬಿದ್ದು ಹೋಗುವುದರ ಬಗ್ಗೆ ಎಚ್ಚರಿಕೆ</para>
  <para style="p">
    <verse number="11" style="v" sid="HEB 5:11"/>ಈ ವಿಷಯದಲ್ಲಿ ನಾವು ಹೇಳಬೇಕಾದದ್ದು ಎಷ್ಟೋ ಇದೆ. ನೀವು ಗ್ರಹಿಸ ಬಯಸದಿರುವುದರಿಂದ ಅದನ್ನೆಲ್ಲಾ ವಿವರಿಸುವುದು ಕಷ್ಟವಾಗಿದೆ. <verse eid="HEB 5:11"/><verse number="12" style="v" sid="HEB 5:12"/>ನೀವು ಇಷ್ಟರೊಳಗೆ ಬೋಧಕರಾಗಿ ಇರಬೇಕಾಗಿತ್ತು. ಆದರೂ ನಿಮಗೆ ದೇವರ ವಾಕ್ಯಗಳ ಪ್ರಾಥಮಿಕ ಉಪದೇಶಗಳನ್ನೇ ಕಲಿಸಿಕೊಡಬೇಕಾಗಿದೆ. ನಿಮಗೆ ಹಾಲಿನ ಅವಶ್ಯಕತೆಯಿದೆಯೇ ಹೊರತು ಗಟ್ಟಿಯಾದ ಆಹಾರವಲ್ಲ. <verse eid="HEB 5:12"/><verse number="13" style="v" sid="HEB 5:13"/>ಹಾಲು ಕುಡಿಯುವವರು ಕೂಸಿನಂತಿದ್ದು ನೀತಿ ಬೋಧನೆಯಲ್ಲಿ ಅನುಭವ ಇಲ್ಲದವರಾಗಿದ್ದಾರೆ. <verse eid="HEB 5:13"/><verse number="14" style="v" sid="HEB 5:14"/>ಆದರೆ ಗಟ್ಟಿಯಾದ ಆಹಾರವು, ತಮ್ಮ ಜ್ಞಾನೇಂದ್ರಿಯಗಳನ್ನು ಅಭ್ಯಾಸಿಸಿ, ತರಬೇತುಗೊಂಡದ್ದರಿಂದ ಒಳ್ಳೆಯದನ್ನು ಹಾಗೂ ಕೆಟ್ಟದ್ದನ್ನು ವಿವೇಚಿಸಿ ಪೂರ್ಣ ಬೆಳವಣಿಗೆ ಹೊಂದಿದವರಿಗೆ ಸೇರಿದ್ದಾಗಿದೆ.<verse eid="HEB 5:14"/></para>
  <chapter eid="HEB 5"/>
  <chapter number="6" style="c" sid="HEB 6"/>
  <para style="p">
    <verse number="1" style="v" sid="HEB 6:1"/>ಆದ್ದರಿಂದ ಕ್ರಿಸ್ತ ಯೇಸುವಿನ ವಿಷಯವಾದ ಪ್ರಾಥಮಿಕ ಉಪದೇಶಗಳನ್ನು ಬಿಟ್ಟು, ನಿರ್ಜೀವ ಕ್ರಿಯೆಗಳಿಂದ<note caller="+" style="f"><char style="fr" closed="false">6:1 </char><char style="ft" closed="false">ಅಥವಾ </char><char style="fqa" closed="false">ಉಪಯೊಗವಿಲ್ಲದ ಆಚರಣೆ</char></note> ದೇವರ ಕಡೆಗೆ ತಿರುಗಿಕೊಳ್ಳುವುದೂ ದೇವರಲ್ಲಿ ನಂಬಿಕೆಯಿಡುವುದೂ <verse eid="HEB 6:1"/><verse number="2" style="v" sid="HEB 6:2"/>ದೀಕ್ಷಾಸ್ನಾನಗಳ ಬೋಧನೆಯೂ ಹಸ್ತಾರ್ಪಣೆಯೂ ಸತ್ತವರ ಪುನರುತ್ಥಾನವೂ ನಿತ್ಯವಾದ ನ್ಯಾಯತೀರ್ಪೂ ಮುಂತಾದವುಗಳನ್ನು ಪುನಃ ಅಸ್ತಿವಾರವನ್ನಾಗಿ ಹಾಕದೆ, ನಾವು ಪರಿಪೂರ್ಣತೆಗೆ ಹೋಗೋಣ. <verse eid="HEB 6:2"/><verse number="3" style="v" sid="HEB 6:3"/>ದೇವರು ಅನುಮತಿಸಿದರೆ ನಾವು ಇದನ್ನು ಮಾಡೋಣ.<verse eid="HEB 6:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="HEB 6:4"/>ಒಂದು ಸಾರಿ ಬೆಳಕನ್ನು ಪಡೆದು, ಪರಲೋಕದ ವರವನ್ನು ರುಚಿ ನೋಡಿ, ಪವಿತ್ರಾತ್ಮ ದೇವರ ಪಾಲನ್ನು ಹೊಂದಿ, <verse eid="HEB 6:4"/><verse number="5" style="v" sid="HEB 6:5"/>ದೇವರ ವಾಕ್ಯದ ಒಳ್ಳೆತನವನ್ನೂ ಬರುವ ಲೋಕದ ಶಕ್ತಿಯನ್ನೂ ರುಚಿ ನೋಡಿದವರು <verse eid="HEB 6:5"/><verse number="6" style="v" sid="HEB 6:6"/>ಬಿದ್ದುಹೋದರೆ, ಅವರನ್ನು ತಿರುಗಿ ಪಶ್ಚಾತ್ತಾಪಕ್ಕೆ ನಡೆಸುವುದು ಅಸಾಧ್ಯ. ಏಕೆಂದರೆ ಅವರು ತಾವಾಗಿಯೇ ದೇವರ ಪುತ್ರ ಆಗಿರುವವರನ್ನು ಪುನಃ ಶಿಲುಬೆಗೆ ಹಾಕುವವರೂ ಅವರನ್ನು ಬಹಿರಂಗವಾಗಿ ಅವಮಾನ ಪಡಿಸುವವರೂ ಆಗಿರುತ್ತಾರೆ. <verse eid="HEB 6:6"/><verse number="7" style="v" sid="HEB 6:7"/>ಭೂಮಿಯು ತನ್ನ ಮೇಲೆ ಆಗಾಗ್ಗೆ ಬೀಳುವ ಮಳೆಯನ್ನು ಹೀರಿಕೊಂಡು ಅದು ತನ್ನ ಒಡೆಯನಿಗೆ ಯೋಗ್ಯವಾದ ಬೆಳೆಯನ್ನು ಕೊಡುವುದಾದರೆ, ಅದು ದೇವರ ಆಶೀರ್ವಾದವನ್ನು ಹೊಂದುತ್ತದೆ. <verse eid="HEB 6:7"/><verse number="8" style="v" sid="HEB 6:8"/>ಆದರೆ ಅದು ಮುಳ್ಳುಗಿಡಗಳನ್ನೂ ಕಳೆಗಳನ್ನೂ ಬೆಳೆಸಿದರೆ, ನಿಷ್ಪ್ರಯೋಜಕವಾದದ್ದಾಗಿ ಶಾಪಕ್ಕೆ ಗುರಿಯಾಗಿ, ಕೊನೆಗದು ಬೆಂಕಿಗೆ ತುತ್ತಾಗುತ್ತದೆ.<verse eid="HEB 6:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="HEB 6:9"/>ಪ್ರಿಯರೇ, ನಾವು ಈ ರೀತಿಯಾಗಿ ಮಾತನಾಡಿದರೂ ನಿಮ್ಮ ವಿಷಯವಾಗಿಯೂ ನೀವು ಉತ್ತಮವಾದವುಗಳನ್ನೂ ರಕ್ಷಣೆಯ ಕಾರ್ಯಗಳನ್ನೂ ಹೊಂದಿದ್ದೀರಿ ಎಂಬ ನಿಶ್ಚಯ ನಮಗಿದೆ. <verse eid="HEB 6:9"/><verse number="10" style="v" sid="HEB 6:10"/>ಅವರು ನಿಮ್ಮ ಸೇವೆಯನ್ನೂ ನೀವು ಪರಿಶುದ್ಧರಿಗೆ ಸೇವೆಮಾಡಿದ್ದರಲ್ಲಿ ಇನ್ನೂ ಮಾಡುತ್ತಿರುವುದರಲ್ಲಿ ದೇವರ ಹೆಸರಿನ ಕಡೆಗೆ ತೋರಿಸಿದ ಪ್ರೀತಿಯನ್ನೂ ಅವರು ಮರೆಯುವುದಕ್ಕೆ ದೇವರು ಅನ್ಯಾಯಗಾರರಲ್ಲ. <verse eid="HEB 6:10"/><verse number="11" style="v" sid="HEB 6:11"/>ಅಂತ್ಯದವರೆಗೆ ನೀವು ನಿಮ್ಮ ನಿರೀಕ್ಷೆಯ ಪೂರ್ಣ ನಿಶ್ಚಯವನ್ನು ಗ್ರಹಿಸುವುದಕ್ಕಾಗಿ ನಿಮ್ಮಲ್ಲಿ ಪ್ರತಿಯೊಬ್ಬರು ಅದೇ ಆಸಕ್ತಿಯನ್ನು ತೋರಿಸಬೇಕೆಂದು ನಾವು ಅಪೇಕ್ಷಿಸುತ್ತೇವೆ. <verse eid="HEB 6:11"/><verse number="12" style="v" sid="HEB 6:12"/>ನೀವು ಸೋಮಾರಿಗಳಾಗಿರಬಾರದು. ವಿಶ್ವಾಸದಿಂದಲೂ ತಾಳ್ಮೆಯಿಂದಲೂ ವಾಗ್ದಾನಗಳನ್ನು ಬಾಧ್ಯವಾಗಿ ಹೊಂದುವವರನ್ನು ಅನುಸರಿಸುವವರಾಗಿರಬೇಕು.<verse eid="HEB 6:12"/></para>
  <para style="s1">ದೇವರ ವಾಗ್ದಾನದ ನಿಶ್ಚಯ</para>
  <para style="p">
    <verse number="13" style="v" sid="HEB 6:13"/>ದೇವರು ಅಬ್ರಹಾಮನಿಗೆ ವಾಗ್ದಾನ ಮಾಡಿದಾಗ ತಮಗಿಂತಲೂ ಹೆಚ್ಚು ದೊಡ್ಡವರಾರೂ ಇಲ್ಲದ್ದರಿಂದ ತಮ್ಮ ಮೇಲೆ ಆಣೆಯಿಟ್ಟು, <verse eid="HEB 6:13"/><verse number="14" style="v" sid="HEB 6:14"/>“ನಿಶ್ಚಯವಾಗಿ ನಾನು ನಿನ್ನನ್ನು ಆಶೀರ್ವದಿಸೇ ಆಶೀರ್ವದಿಸುವೆನು, ನಿನ್ನ ಸಂತಾನವನ್ನು ಹೆಚ್ಚಿಸೇ ಹೆಚ್ಚಿಸುವೆನು,”<note caller="+" style="f"><char style="fr" closed="false">6:14 </char><char style="ft" closed="false"><char style="xt"><ref loc="GEN 22:17">ಆದಿ 22:17</ref></char></char></note> ಎಂದು ಹೇಳಿದರಷ್ಟೆ. <verse eid="HEB 6:14"/><verse number="15" style="v" sid="HEB 6:15"/>ಹೀಗೆ ಅಬ್ರಹಾಮನು ತಾಳ್ಮೆಯಿಂದ ಕಾದಿದ್ದು ವಾಗ್ದಾನವನ್ನು ಪಡೆದುಕೊಂಡನು.<verse eid="HEB 6:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="HEB 6:16"/>ಮನುಷ್ಯರು ನಿಜವಾಗಿಯೂ ದೊಡ್ಡವರ ಮೇಲೆ ಆಣೆ ಇಡುತ್ತಾರಷ್ಟೆ. ಆಣೆಯನ್ನು ದೃಢಪಡಿಸುವುದು ಪ್ರತಿಯೊಂದು ವಿವಾದಕ್ಕೂ ಅಂತ್ಯವಾಗಿರುವುದು. <verse eid="HEB 6:16"/><verse number="17" style="v" sid="HEB 6:17"/>ದೇವರು ತಮ್ಮ ಮಾರ್ಪಡದ ಉದ್ದೇಶವನ್ನು ವಾಗ್ದಾನದ ಬಾಧ್ಯಸ್ಥರಿಗೆ ಇನ್ನೂ ಹೆಚ್ಚಾಗಿಯೇ ತೋರಿಸಬೇಕೆಂದು ಆಣೆಯಿಟ್ಟು ಸ್ಥಿರಪಡಿಸಿದರು. <verse eid="HEB 6:17"/><verse number="18" style="v" sid="HEB 6:18"/>ದೇವರ ವಾಗ್ದಾನ ಮತ್ತು ಆಣೆ ಇವೆರಡೂ ಬದಲಾಗದ ಆಧಾರಗಳು. ಇವುಗಳ ವಿಷಯವಾಗಿ ದೇವರು ನಮಗೆ ಸುಳ್ಳಾಡುವವರಲ್ಲ. ಇದರಿಂದಾಗಿ, ದೇವರ ಆಶ್ರಯವನ್ನು ಹೊಂದುವುದಕ್ಕೆ ಓಡಿಬಂದಿರುವ ನಾವು, ನಮ್ಮ ಮುಂದೆ ಇಟ್ಟಿರುವ ನಿರೀಕ್ಷೆಯನ್ನು ಹಿಡಿದುಕೊಳ್ಳಲು ಬಲವಾದ ಉತ್ತೇಜನ ಉಂಟಾಯಿತು. <verse eid="HEB 6:18"/><verse number="19" style="v" sid="HEB 6:19"/>ಈ ನಿರೀಕ್ಷೆಯು ನಮ್ಮ ಆತ್ಮಕ್ಕೆ ನಿಶ್ಚಯವಾದದ್ದೂ ಸ್ಥಿರವಾದದ್ದೂ ಆಗಿರುವ ಲಂಗರದ ಹಾಗಿದೆ. ಅದು ಅತಿ ಪರಿಶುದ್ಧಸ್ಥಳದ ತೆರೆಯ ಒಳಗಡೆ ಪ್ರವೇಶಿಸುವಂಥದ್ದೂ ಆಗಿದೆ. <verse eid="HEB 6:19"/><verse number="20" style="v" sid="HEB 6:20"/>ಯೇಸು ಸದಾಕಾಲವೂ ಮೆಲ್ಕಿಜೆದೇಕನ ಕ್ರಮದ ಮಹಾಯಾಜಕರಾಗಿ ಅತಿ ಪರಿಶುದ್ಧ ಸ್ಥಳಕ್ಕೆ ಮುಂದಾಗಿ ಹೋಗಿ ಯೇಸು ನಮ್ಮ ಪರವಾಗಿ ಪ್ರವೇಶಿಸಿದ್ದಾರೆ.<verse eid="HEB 6:20"/></para>
  <chapter eid="HEB 6"/>
  <chapter number="7" style="c" sid="HEB 7"/>
  <para style="s1">ಯಾಜಕ ಮೆಲ್ಕಿಜೆದೇಕ</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 7:1"/>ಈ ಮೆಲ್ಕಿಜೆದೇಕನು ಸಾಲೇಮಿನ ಅರಸನೂ ಮಹೋನ್ನತರಾದ ದೇವರ ಯಾಜಕನೂ ಆಗಿದ್ದನು. ರಾಜರನ್ನು ಸೋಲಿಸಿ, ಹಿಂದಿರುಗಿ ಬರುತ್ತಿದ್ದ ಅಬ್ರಹಾಮನನ್ನು ಸಂಧಿಸಿ ಅವನನ್ನು ಆಶೀರ್ವದಿಸಿದನು. <verse eid="HEB 7:1"/><verse number="2" style="v" sid="HEB 7:2"/>ಅಬ್ರಹಾಮನು ಎಲ್ಲವುಗಳಲ್ಲಿ ಅವನಿಗೆ ಹತ್ತರಲ್ಲಿ ಒಂದು ಭಾಗವನ್ನು ಕೊಟ್ಟನು. ಅವನ ಹೆಸರಿಗೆ ಮೊದಲನೆಯದಾಗಿ, “ನೀತಿರಾಜನು” ಎಂದೂ ತರುವಾಯ “ಸಾಲೇಮಿನ ರಾಜ,” ಅಂದರೆ, “ಸಮಾಧಾನದ ಅರಸನು” ಎಂದರ್ಥ. <verse eid="HEB 7:2"/><verse number="3" style="v" sid="HEB 7:3"/>ಈ ಮೆಲ್ಕಿಜೆದೇಕನಿಗೆ ತಂದೆಯೂ, ತಾಯಿಯೂ, ವಂಶಾವಳಿಯೂ ಇಲ್ಲ. ಅವನ ಜನ್ಮಕ್ಕೆ ಆದಿಯಾಗಲಿ, ಜೀವನಕ್ಕೆ ಅಂತ್ಯವಾಗಲಿ ಇಲ್ಲ. ಅವನು ದೇವರ ಪುತ್ರ ಆಗಿರುವವರಿಗೆ ಹೋಲಿಕೆಯಾಗಿರುವ ನಿತ್ಯ ಯಾಜಕನಾಗಿ ಉಳಿಯುತ್ತಾನೆ.<verse eid="HEB 7:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="HEB 7:4"/>ಮೆಲ್ಕಿಜೆದೇಕನು ಎಷ್ಟು ದೊಡ್ಡವನಾಗಿದ್ದನೆಂದು ಆಲೋಚಿಸಿರಿ. ಮೂಲ ಪಿತೃವಾದ ಅಬ್ರಹಾಮನು ಗೆದ್ದು ತಂದವುಗಳಲ್ಲಿ ಹತ್ತರಲ್ಲಿ ಒಂದು ಭಾಗವನ್ನು ಇವನಿಗೇ ಕೊಟ್ಟನಲ್ಲಾ. <verse eid="HEB 7:4"/><verse number="5" style="v" sid="HEB 7:5"/>ನಿಜವಾಗಿಯೂ ಲೇವಿಯ ಮಕ್ಕಳಲ್ಲಿ ಯಾಜಕೋದ್ಯೋಗವನ್ನು ಹೊಂದುವವರು, ಜನರಿಂದ ಅಂದರೆ ಅಬ್ರಹಾಮನ ವಂಶಸ್ಥರಾಗಿರುವ ತಮ್ಮ ಸಹೋದರರಿಂದಲೇ ದಶಮಭಾಗಗಳನ್ನು ತೆಗೆದುಕೊಳ್ಳುವುದಕ್ಕೆ ಮೋಶೆಯ ನಿಯಮದಲ್ಲಿ ಅಪ್ಪಣೆಯಿದೆ. <verse eid="HEB 7:5"/><verse number="6" style="v" sid="HEB 7:6"/>ಆದರೆ ವಂಶಾವಳಿಯಲ್ಲಿ ಸೇರದೆ ಇರುವ ಮೆಲ್ಕಿಜೆದೇಕನು ಅಬ್ರಹಾಮನಿಂದ ದಶಮಭಾಗವನ್ನು ತೆಗೆದುಕೊಂಡದ್ದಲ್ಲದೆ, ವಾಗ್ದಾನಗಳನ್ನು ಪಡೆದಿದ್ದ ಅಬ್ರಹಾಮನನ್ನು ಆಶೀರ್ವದಿಸಿದನು. <verse eid="HEB 7:6"/><verse number="7" style="v" sid="HEB 7:7"/>ಆಶೀರ್ವಾದ ಹೊಂದುವವನಿಗಿಂತ ಆಶೀರ್ವದಿಸುವವನೇ ದೊಡ್ಡವನು ಎಂಬುದರಲ್ಲಿ ವಿವಾದವಿಲ್ಲ. <verse eid="HEB 7:7"/><verse number="8" style="v" sid="HEB 7:8"/>ಇಲ್ಲಿ ದಶಮಭಾಗಗಳನ್ನು ತೆಗೆದುಕೊಳ್ಳುತ್ತಿರುವ ಲೇವಿಯರು ಕೇವಲ ಮರ್ತ್ಯ ಮಾನವರು. ಆದರೆ ಅಲ್ಲಿ ತೆಗೆದುಕೊಳ್ಳುವ ಮೆಲ್ಕಿಜೆದೇಕನು ಜೀವಿಸುತ್ತಿದ್ದಾನೆಂದು ಸಾಕ್ಷಿ ಹೊಂದಿರುವವನು. <verse eid="HEB 7:8"/><verse number="9" style="v" sid="HEB 7:9"/>ಇದು ಮಾತ್ರವಲ್ಲದೆ ದಶಮಭಾಗಗಳನ್ನು ತೆಗೆದುಕೊಳ್ಳುವ ಲೇವಿಯೂ ಅಬ್ರಹಾಮನ ಮೂಲಕ ದಶಮಭಾಗಗಳನ್ನು ಕೊಟ್ಟ ಹಾಗಾಯಿತು. <verse eid="HEB 7:9"/><verse number="10" style="v" sid="HEB 7:10"/>ಹೇಗೆಂದರೆ, ಮೆಲ್ಕಿಜೆದೇಕನು ಅಬ್ರಹಾಮನನ್ನು ಸಂಧಿಸಿದಾಗ, ಲೇವಿಯು ತನ್ನ ಪಿತೃ ಆದ ಅಬ್ರಹಾಮನ ದೇಹದಲ್ಲಿ ಇದ್ದನು ಎಂದು ಪರಿಗಣಿಸಬಹುದು.<verse eid="HEB 7:10"/></para>
  <para style="s1">ಯೇಸು ಮೆಲ್ಕಿಜೆದೇಕನಂಥ ಯಾಜಕ</para>
  <para style="p">
    <verse number="11" style="v" sid="HEB 7:11"/>ಲೇವಿಯರ ಯಾಜಕತ್ವದ ಆಧಾರದ ಮೇಲೆ ಜನರು ನಿಯಮವನ್ನು ಪಡೆದಿದ್ದರು. ಈ ಯಾಜಕತ್ವದ ಮೂಲಕವೇ ಪರಿಪೂರ್ಣತೆಯು ಉಂಟಾಗಿದ್ದರೆ, ಆರೋನನ ಕ್ರಮಾನುಸಾರವಾಗಿರದೆ ಮೆಲ್ಕಿಜೆದೇಕನ ಕ್ರಮದ ಪ್ರಕಾರ ಬೇರೊಬ್ಬ ಯಾಜಕನು ಎದ್ದೇಳುವ ಅವಶ್ಯವೇನಿತ್ತು? <verse eid="HEB 7:11"/><verse number="12" style="v" sid="HEB 7:12"/>ಯಾಜಕತ್ವವು ಬದಲಾದಾಗ ನಿಯಮವು ಸಹ ಬದಲಾಗುವುದು ಅಗತ್ಯ. <verse eid="HEB 7:12"/><verse number="13" style="v" sid="HEB 7:13"/>ಇವು ಯಾರ ವಿಷಯದಲ್ಲಿ ಹೇಳಿದೆಯೋ ಆ ವ್ಯಕ್ತಿ ಬೇರೊಂದು ಗೋತ್ರಕ್ಕೆ ಸೇರಿದವನು. ಆ ಗೋತ್ರದಿಂದ ಎಂದೂ ಯಾರೂ ಬಲಿಪೀಠದ ಬಳಿ ಸೇವೆ ಮಾಡಿದವರಲ್ಲ. <verse eid="HEB 7:13"/><verse number="14" style="v" sid="HEB 7:14"/>ಹೀಗೆ ನಮ್ಮ ಕರ್ತ ಯೇಸು ಯೂದಾ ಗೋತ್ರಕ್ಕೆ ಸೇರಿದವರೆಂದು ತಿಳಿದ ಸಂಗತಿಯಾಗಿದೆ. ಈ ಗೋತ್ರವನ್ನು ಸಂಬಂಧಿಸಿ ಮೋಶೆಯು ಯಾಜಕರ ವಿಷಯವಾಗಿ ಏನನ್ನೂ ಹೇಳಲಿಲ್ಲ. <verse eid="HEB 7:14"/><verse number="15" style="v" sid="HEB 7:15"/>ಮೆಲ್ಕಿಜೆದೇಕನಂತೆ ಇನ್ನೊಬ್ಬ ಯಾಜಕನು ಏಳುತ್ತಾನೆಂಬುದು ಇನ್ನೂ ಎಷ್ಟೋ ಹೆಚ್ಚಾಗಿ ಸ್ಪಷ್ಟವಾಗಿದೆ. <verse eid="HEB 7:15"/><verse number="16" style="v" sid="HEB 7:16"/>ಕ್ರಿಸ್ತ ಯೇಸು ಯಾಜಕರಾದುದು ಅಳಿವಿಲ್ಲದ ಜೀವದ ಶಕ್ತಿಗೆ ಅನುಸಾರವಾಗಿದೆಯೇ ಹೊರತು ನಿಯಮಾನುಸಾರವಾದ ದೈಹಿಕ ಹುಟ್ಟಿನಿಂದಲ್ಲ. <verse eid="HEB 7:16"/><verse number="17" style="v" sid="HEB 7:17"/>ಕರ್ತ ಯೇಸುವಿನ ವಿಷಯದಲ್ಲಿ,</para>
  <para style="q1" vid="HEB 7:17">“ನೀನು ಸದಾಕಾಲವೂ,</para>
  <para style="q2" vid="HEB 7:17">ಮೆಲ್ಕಿಜೆದೇಕನ ಕ್ರಮದ ಯಾಜಕನಾಗಿದ್ದೀ,”<note caller="+" style="f"><char style="fr" closed="false">7:17 </char><char style="ft" closed="false"><char style="xt"><ref loc="PSA 110:4">ಕೀರ್ತನೆ 110:4</ref></char></char></note></para>
  <para style="m" vid="HEB 7:17">ಎಂಬ ಸಾಕ್ಷಿಯಿದೆ.<verse eid="HEB 7:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="HEB 7:18"/>ಏಕೆಂದರೆ ಮೊದಲಿದ್ದ ಆಜ್ಞೆಯು ನಿರ್ಬಲವೂ ನಿಷ್ಪ್ರಯೋಜಕವೂ ಆಗಿರುವ ಕಾರಣದಿಂದ ಅದು ರದ್ದಾಯಿತು. <verse eid="HEB 7:18"/><verse number="19" style="v" sid="HEB 7:19"/>ಮೋಶೆಯ ನಿಯಮವು ಯಾವುದನ್ನೂ ಪರಿಪೂರ್ಣ ಮಾಡುವುದಿಲ್ಲ. ಅದಕ್ಕೆ ಬದಲಾಗಿ ದೇವರ ಸಮೀಪಕ್ಕೆ ಒಯ್ಯುವಂತೆ ಹೊಸ ಉತ್ತಮ ನಿರೀಕ್ಷೆಗೆ ನಡಿಸುತ್ತದೆ.<verse eid="HEB 7:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="HEB 7:20"/>ಇದಂತೂ ಆಣೆಯಿಲ್ಲದೆ ಆಗಿರುವಂಥದ್ದಲ್ಲ! ಲೇವಿಯರು ಆಣೆಯಿಲ್ಲದೆಯೇ ಯಾಜಕರಾದರು, <verse eid="HEB 7:20"/><verse number="21" style="v" sid="HEB 7:21"/>ಆದರೆ ಯೇಸು ದೇವರ ಆಣೆಯಿಂದಲೇ ಯಾಜಕರಾದರು. ಹೀಗೆ ದೇವರು ಹೇಳಿದ್ದೇನೆಂದರೆ:</para>
  <para style="q1" vid="HEB 7:21">“ ಕರ್ತ ಆಗಿರುವ ನಾನು ಆಣೆಯಿಟ್ಟು ಹೇಳಿದ್ದೇನೆ.</para>
  <para style="q2" vid="HEB 7:21">ನಾನು ಎಂದಿಗೂ ಮನಸ್ಸನ್ನು ಬದಲಾಯಿಸುವುದಿಲ್ಲ.</para>
  <para style="q2" vid="HEB 7:21">‘ನೀನು ಸದಾಕಾಲವೂ ಯಾಜಕನಾಗಿದ್ದೀ.’ ”<note caller="+" style="f"><char style="fr" closed="false">7:21 </char><char style="ft" closed="false"><char style="xt"><ref loc="PSA 110:4">ಕೀರ್ತನೆ 110:4</ref></char></char></note><verse eid="HEB 7:21"/></para>
  <para style="m">
    <verse number="22" style="v" sid="HEB 7:22"/>ಇದರಿಂದಲೇ ಯೇಸು ಎಷ್ಟೋ ಉತ್ತಮವಾದ ಒಡಂಬಡಿಕೆಗೆ ಹೊಣೆಗಾರರಾದರು.<verse eid="HEB 7:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="HEB 7:23"/>ಒಂದು ಕಡೆ ಆ ಯಾಜಕರು ಮುಂದುವರಿಯದಂತೆ ಮರಣವು ಅಡ್ಡಿಯಾದದ್ದರಿಂದ ಅನೇಕರು ಯಾಜಕರಾಗಬೇಕಾಗುತ್ತಿತ್ತು. <verse eid="HEB 7:23"/><verse number="24" style="v" sid="HEB 7:24"/>ಇನ್ನೊಂದು ಕಡೆ ಯೇಸುವಾದರೋ ಸದಾಕಾಲ ಇರುವುದರಿಂದ ನಿರಂತರವಾಗಿ ತಮ್ಮ ಯಾಜಕತ್ವವನ್ನು ಹೊಂದಿದವರಾಗಿದ್ದಾರೆ. <verse eid="HEB 7:24"/><verse number="25" style="v" sid="HEB 7:25"/>ಇದಲ್ಲದೆ ಯೇಸು ತಮ್ಮ ಮೂಲಕ ದೇವರ ಕಡೆ ಬರುವವರನ್ನು ಪರಿಪೂರ್ಣವಾಗಿ ರಕ್ಷಿಸುವುದಕ್ಕೆ ಶಕ್ತರಾಗಿದ್ದಾರೆ. ಏಕೆಂದರೆ ಅವರಿಗೋಸ್ಕರ ಯೇಸು ವಿಜ್ಞಾಪನೆ ಮಾಡುವುದಕ್ಕಾಗಿ ಯಾವಾಗಲೂ ಬದುಕುವವರಾಗಿದ್ದಾರೆ.<verse eid="HEB 7:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="HEB 7:26"/>ಪರಿಶುದ್ಧರು, ನಿರ್ದೋಷಿ, ನಿಷ್ಕಳಂಕರು, ಪಾಪಿಗಳಿಂದ ಪ್ರತ್ಯೇಕಿಸಲಾದವರೂ ಗಗನ ಮಂಡಲಗಳಿಗಿಂತ ಉನ್ನತಕ್ಕೇರಿದಾತರೂ ಆಗಿರುವ ಇಂಥಾ ಮಹಾಯಾಜಕ ನಮಗಿದ್ದಾರೆ. <verse eid="HEB 7:26"/><verse number="27" style="v" sid="HEB 7:27"/>ಮೊದಲು ತನ್ನ ಸ್ವಂತ ಪಾಪಗಳಿಗಾಗಿಯೂ ಯಜ್ಞಾರ್ಪಣೆ ಮಾಡುವ ಆ ಮಹಾಯಾಜಕರಂತೆ ಯೇಸು ಪ್ರತಿದಿನವೂ ಬಲಿ ಸಮರ್ಪಿಸಬೇಕಾದ ಅವಶ್ಯವಿಲ್ಲ. ಏಕೆಂದರೆ ಇವರು ತಮ್ಮನ್ನೇ ಬಲಿಯಾಗಿ ಸಮರ್ಪಿಸಿಕೊಂಡಾಗ ಅದನ್ನು ಒಂದೇ ಸಾರಿ ಮಾಡಿ ಮುಗಿಸಿದರು. <verse eid="HEB 7:27"/><verse number="28" style="v" sid="HEB 7:28"/>ಏಕೆಂದರೆ ಮೋಶೆಯ ನಿಯಮವು ಬಲಹೀನರಾದ ಮನುಷ್ಯರನ್ನು ಮಹಾಯಾಜಕರನ್ನಾಗಿ ನೇಮಿಸುತ್ತದೆ. ಆದರೆ ಮೋಶೆಯ ನಿಯಮದ ತರುವಾಯ ದೇವರ ಆಣೆಯೊಡನೆ ಬಂದ ವಾಕ್ಯವು ನಿತ್ಯವಾಗಿ ಪರಿಪೂರ್ಣರಾದ ಪುತ್ರನನ್ನೇ ಪ್ರಧಾನಯಾಜಕರನ್ನಾಗಿ ನೇಮಿಸುತ್ತದೆ.<verse eid="HEB 7:28"/></para>
  <chapter eid="HEB 7"/>
  <chapter number="8" style="c" sid="HEB 8"/>
  <para style="s1">ಹೊಸ ಒಡಂಬಡಿಕೆಯ ಮಹಾಯಾಜಕ</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 8:1"/>ನಾವು ಈಗ ಹೇಳುವ ವಿಷಯಗಳ ಮುಖ್ಯಾಂಶ ಇದು: ಪರಲೋಕದೊಳಗೆ ಮಹೋನ್ನತ ದೇವರ ಸಿಂಹಾಸನದ ಬಲಗಡೆಯಲ್ಲಿ ಕುಳಿತುಕೊಂಡಿರುವಂಥ ಮಹಾಯಾಜಕ ಒಬ್ಬರು ನಮಗಿದ್ದಾರೆ. <verse eid="HEB 8:1"/><verse number="2" style="v" sid="HEB 8:2"/>ಕ್ರಿಸ್ತ ಯೇಸು ಆಗಿರುವ ಇವರು ಪವಿತ್ರ ಸ್ಥಾನದಲ್ಲಿ ಅಂದರೆ, ಮನುಷ್ಯರಿಂದಲ್ಲ ದೇವರೇ ನಿರ್ಮಿಸಿದ ಪವಿತ್ರ ಸ್ಥಾನದ ನಿಜ ಗುಡಾರದಲ್ಲಿ ಸೇವೆಮಾಡುವವರಾಗಿದ್ದಾರೆ.<verse eid="HEB 8:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="HEB 8:3"/>ಪ್ರತಿಯೊಬ್ಬ ಮಹಾಯಾಜಕನು ಕಾಣಿಕೆಗಳನ್ನೂ ಯಜ್ಞಗಳನ್ನೂ ಸಮರ್ಪಿಸುವುದಕ್ಕೆ ನೇಮಕವಾಗಿರುತ್ತಾನೆ. ಆದ್ದರಿಂದ ಸಮರ್ಪಿಸುವುದಕ್ಕೆ ಯೇಸುವಿಗೆ ಸಹ ಏನಾದರೂ ಇರುವುದು ಅವಶ್ಯವಾಗಿದೆ. <verse eid="HEB 8:3"/><verse number="4" style="v" sid="HEB 8:4"/>ಯೇಸು ಭೂಮಿಯ ಮೇಲೆ ಇರುವುದಾದರೆ ಯಾಜಕರೇ ಆಗುತ್ತಿರಲಿಲ್ಲ. ಏಕೆಂದರೆ ಮೋಶೆಯ ನಿಯಮದ ಪ್ರಕಾರ ಕಾಣಿಕೆಗಳನ್ನು ಸಮರ್ಪಿಸುವವರು ಇದ್ದಾರಲ್ಲಾ. <verse eid="HEB 8:4"/><verse number="5" style="v" sid="HEB 8:5"/>ಅವರು ಪರಲೋಕದಲ್ಲಿರುವವುಗಳ ನಿದರ್ಶನವೂ ಛಾಯೆಯೂ ಆಗಿರುವ ಆಲಯಗಳಲ್ಲಿ ಸೇವೆಯನ್ನು ನಡೆಸುವರು. ಇದರಂತೆಯೇ ಮೋಶೆಯು ಗುಡಾರವನ್ನು ಮಾಡುವುದಕ್ಕಿದ್ದಾಗ, “ನೋಡು, ನಾನು ಬೆಟ್ಟದಲ್ಲಿ ನಿನಗೆ ತೋರಿಸಿದ ಮಾದರಿಯ ಪ್ರಕಾರವೇ ಎಲ್ಲವನ್ನೂ ಮಾಡಬೇಕು,”<note caller="+" style="f"><char style="fr" closed="false">8:5 </char><char style="ft" closed="false"><char style="xt"><ref loc="EXO 25:40">ವಿಮೋ 25:40</ref></char></char></note> ಎಂದು ದೇವರಿಂದ ಎಚ್ಚರಿಕೆ ಕೊಡಲಾಗಿತ್ತಲ್ಲವೇ? <verse eid="HEB 8:5"/><verse number="6" style="v" sid="HEB 8:6"/>ಯೇಸುವಾದರೋ ಈಗ ಅದಕ್ಕಿಂತ ಶ್ರೇಷ್ಠ ಸೇವೆಯನ್ನು ಹೊಂದಿದವರಾಗಿದ್ದಾರೆ. ಅಷ್ಟೇ ಅಲ್ಲದೆ ಇವರು ಉತ್ತಮ ವಾಗ್ದಾನಗಳ ಮೇಲೆ ಸ್ಥಾಪಿತವಾದ ಒಡಂಬಡಿಕೆಗೆ ಸಹ ಮಧ್ಯಸ್ಥರಾಗಿದ್ದಾರೆ.<verse eid="HEB 8:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="HEB 8:7"/>ಆ ಮೊದಲನೆಯ ಒಡಂಬಡಿಕೆಯು ತಪ್ಪಿಲ್ಲದ್ದಾಗಿದ್ದರೆ, ಎರಡನೆಯ ಒಡಂಬಡಿಕೆಯ ಅವಶ್ಯಕತೆಯೇ ಇರುತ್ತಿರಲಿಲ್ಲ. <verse eid="HEB 8:7"/><verse number="8" style="v" sid="HEB 8:8"/>ಆದರೆ ದೇವರು ಜನರಲ್ಲಿ ತಪ್ಪನ್ನು ಕಂಡುಹಿಡಿದು ಹೀಗೆಂದರು,</para>
  <para style="q1" vid="HEB 8:8">“ಇಗೋ, ನಾನು ಇಸ್ರಾಯೇಲ್ ವಂಶದವರೊಂದಿಗೂ</para>
  <para style="q2" vid="HEB 8:8">ಯೂದ ವಂಶದವರೊಂದಿಗೂ</para>
  <para style="q1" vid="HEB 8:8">ಒಂದು ಹೊಸ ಒಡಂಬಡಿಕೆಯನ್ನು</para>
  <para style="q2" vid="HEB 8:8">ಮಾಡಿಕೊಳ್ಳುವ ದಿನಗಳು ಬರುವವು.<verse eid="HEB 8:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="HEB 8:9"/>ಈ ಒಡಂಬಡಿಕೆಯು ನಾನು ಇವರ ಪೂರ್ವಜರನ್ನು ಕೈಹಿಡಿದು,</para>
  <para style="q2" vid="HEB 8:9">ಈಜಿಪ್ಟ್ ದೇಶದಿಂದ ಕರೆದುಕೊಂಡು ಬಂದ ದಿವಸದಂದು</para>
  <para style="q2" vid="HEB 8:9">ಅವರ ಸಂಗಡ ಮಾಡಿಕೊಂಡ ಒಡಂಬಡಿಕೆಯಂಥದಲ್ಲ.</para>
  <para style="q1" vid="HEB 8:9">ಏಕೆಂದರೆ ಅವರು ನನ್ನ ಒಡಂಬಡಿಕೆಯಲ್ಲಿ ಸ್ಥಿರವಾಗಿ ನಿಲ್ಲಲಿಲ್ಲ.</para>
  <para style="q2" vid="HEB 8:9">ಆದ್ದರಿಂದ ನಾನು ಅವರನ್ನು ಲಕ್ಷಿಸಲಿಲ್ಲ,</para>
  <para style="q2" vid="HEB 8:9">ಎಂದು ಕರ್ತದೇವರು ಹೇಳುತ್ತಾರೆ.<verse eid="HEB 8:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="HEB 8:10"/>ಆ ದಿನಗಳ ತರುವಾಯ</para>
  <para style="q2" vid="HEB 8:10">ನಾನು ಇಸ್ರಾಯೇಲ್ ವಂಶದವರೊಂದಿಗೆ ಮಾಡಿಕೊಳ್ಳುವ ಒಡಂಬಡಿಕೆಯು ಹೀಗಿರುವುದು:</para>
  <para style="q1" vid="HEB 8:10">ನಾನು ನನ್ನ ನಿಯಮಗಳನ್ನು ಅವರ ಮನಸ್ಸಿನಲ್ಲಿ ಇಡುವೆನು.</para>
  <para style="q2" vid="HEB 8:10">ನಾನು ಅವರ ಹೃದಯಗಳ ಮೇಲೆ ಅವುಗಳನ್ನು ಬರೆಯುವೆನು.</para>
  <para style="q1" vid="HEB 8:10">ನಾನು ಅವರಿಗೆ ದೇವರಾಗಿರುವೆನು.</para>
  <para style="q2" vid="HEB 8:10">ಅವರು ನನಗೆ ಪ್ರಜೆಯಾಗಿರುವರು.<verse eid="HEB 8:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="HEB 8:11"/>ಇದಲ್ಲದೆ ಪ್ರತಿಯೊಬ್ಬನು ತನ್ನ ನೆರೆಯವನಿಗೂ,</para>
  <para style="q2" vid="HEB 8:11">ತನ್ನ ಸಹೋದರನಿಗೂ, ‘ಕರ್ತದೇವರನ್ನು ಅರಿತುಕೊಳ್ಳಿರಿ,’ ಎಂದು ಬೋಧಿಸಬೇಕಾಗಿಲ್ಲ.</para>
  <para style="q1" vid="HEB 8:11">ಏಕೆಂದರೆ ಚಿಕ್ಕವರಿಂದ ದೊಡ್ಡವರವರೆಗೂ</para>
  <para style="q2" vid="HEB 8:11">ಎಲ್ಲರೂ ನನ್ನನ್ನು ಅರಿತುಕೊಳ್ಳುವರು.<verse eid="HEB 8:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="HEB 8:12"/>ನಾನು ಅವರ ದುಷ್ಕೃತ್ಯಗಳನ್ನು ಕ್ಷಮಿಸುವೆನು</para>
  <para style="q2" vid="HEB 8:12">ಮತ್ತು ಅವರ ಪಾಪಗಳನ್ನು ಇನ್ನೆಂದಿಗೂ ನನ್ನ ನೆನಪಿಗೆ ತಂದುಕೊಳ್ಳುವುದಿಲ್ಲ,</para>
  <para style="m" vid="HEB 8:12">ಎಂದು ಕರ್ತದೇವರು ನುಡಿಯುತ್ತಾರೆ.”<note caller="+" style="f"><char style="fr" closed="false">8:12 </char><char style="ft" closed="false"><char style="xt"><ref loc="JER 31:31-34">ಯೆರೆ 31:31-34</ref></char></char></note><verse eid="HEB 8:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="HEB 8:13"/>ಇಲ್ಲಿ ದೇವರು “ಹೊಸ ಒಡಂಬಡಿಕೆ” ಎಂದು ಹೇಳಿರುವಾಗ ಮೊದಲಿದ್ದದ್ದನ್ನು ಹಳೆಯದಾಗಿ ಮಾಡಿದ್ದಾರೆ. ಅದು ಹಳೆಯದಾಗುತ್ತಾ ಕ್ಷೀಣವಾಗಿ ಅಳಿದು ಹೋಗಲಿದೆ.<verse eid="HEB 8:13"/></para>
  <chapter eid="HEB 8"/>
  <chapter number="9" style="c" sid="HEB 9"/>
  <para style="s1">ಭೂಲೋಕದ ಗುಡಾರದಲ್ಲಿ ಆರಾಧನೆ</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 9:1"/>ಮೊದಲನೆಯ ಒಡಂಬಡಿಕೆಯಲ್ಲಿ ದೈವಿಕ ಆರಾಧನೆಯ ಕ್ರಮಗಳಿದ್ದವು. ಮಾತ್ರವಲ್ಲದೆ ಮಾನವ ನಿರ್ಮಿತ ಪವಿತ್ರ ಸ್ಥಳವೂ ಇತ್ತು. <verse eid="HEB 9:1"/><verse number="2" style="v" sid="HEB 9:2"/>ಅದರೊಳಗೆ ಒಂದು ಗುಡಾರವು ಕಟ್ಟಲಾಗಿತ್ತು. ಅದರ ಪ್ರಥಮ ಭಾಗದಲ್ಲಿ ದೀಪಸ್ತಂಭ, ಮೇಜು, ಸಮ್ಮುಖದ ರೊಟ್ಟಿ ಇವುಗಳಿದ್ದವು. ಅದು ಪವಿತ್ರ ಸ್ಥಳ ಎಂದು ಕರೆಯಲಾಗಿತ್ತು. <verse eid="HEB 9:2"/><verse number="3" style="v" sid="HEB 9:3"/>ಎರಡನೆಯ ತೆರೆಯ ಆಚೆ ಅತಿ ಪವಿತ್ರ ಸ್ಥಳ ಎಂದು ಕರೆಯಲಾದ ಗುಡಾರವಿತ್ತು. <verse eid="HEB 9:3"/><verse number="4" style="v" sid="HEB 9:4"/>ಅದರಲ್ಲಿ ಚಿನ್ನದ ಧೂಪಾರತಿ, ಒಳಗೂ ಹೊರಗೂ ಚಿನ್ನದಿಂದ ಹೊದಿಸಿದ್ದ ಒಡಂಬಡಿಕೆಯ ಮಂಜೂಷ ಇವುಗಳಿದ್ದವು. ಆ ಮಂಜೂಷದೊಳಗೆ ಮನ್ನಾ ಇಟ್ಟಿದ್ದ ಚಿನ್ನದ ಪಾತ್ರೆಯೂ ಆರೋನನ ಚಿಗುರಿದ ಕೋಲೂ ಒಡಂಬಡಿಕೆಯ ಶಿಲಾಶಾಸನಗಳೂ ಇದ್ದವು. <verse eid="HEB 9:4"/><verse number="5" style="v" sid="HEB 9:5"/>ಮಂಜೂಷದ ಮೇಲೆ ಮಹಿಮೆಯ ಕೆರೂಬಿಯರು ಕರುಣಾಸನವನ್ನು<note caller="+" style="f"><char style="fr" closed="false">9:5 </char><char style="ft" closed="false">ಅಥವಾ </char><char style="fqa" closed="false">ಕ್ಷಮಾಪಣೆಯ ಮುಚ್ಚಳ</char></note> ಮುಚ್ಚಿಕೊಂಡಿದ್ದವು. ಸದ್ಯಕ್ಕೆ ಈ ವಿಷಯಗಳನ್ನು ಸವಿಸ್ತಾರವಾಗಿ ನಾನು ಹೇಳುವುದಕ್ಕಾಗದು.<verse eid="HEB 9:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="HEB 9:6"/>ಇವುಗಳು ಹೀಗೆ ಸಿದ್ಧವಾದ ಬಳಿಕ ಯಾಜಕರು ಯಾವಾಗಲೂ ಹೊರಗಿನ ಗುಡಾರವನ್ನು ಪ್ರವೇಶಿಸಿ ದೈವಿಕ ಆರಾಧನೆಯನ್ನು ನಡೆಸುತ್ತಿದ್ದರು. <verse eid="HEB 9:6"/><verse number="7" style="v" sid="HEB 9:7"/>ಆದರೆ ಎರಡನೆಯ ಭಾಗದೊಳಗೆ ಮಹಾಯಾಜಕನೊಬ್ಬನೇ ವರ್ಷಕ್ಕೆ ಒಂದೇ ಸಾರಿ ಪ್ರವೇಶಿಸುತ್ತಿದ್ದನು. ಅವನು ರಕ್ತವನ್ನು ತೆಗೆದುಕೊಳ್ಳದೆ ಎಂದಿಗೂ ಹೋಗುತ್ತಿರಲಿಲ್ಲ. ಬಲಿಯ ರಕ್ತವನ್ನು ತನಗೋಸ್ಕರವೂ ಜನರು ತಿಳಿಯದೆ ಮಾಡಿದ ಪಾಪಗಳಿಗೋಸ್ಕರವೂ ಸಮರ್ಪಿಸುತ್ತಿದ್ದನು. <verse eid="HEB 9:7"/><verse number="8" style="v" sid="HEB 9:8"/>ಹೊರಗಿನ ಗುಡಾರವು ಇನ್ನೂ ಇರುವ ತನಕ ಅತಿ ಪವಿತ್ರ ಸ್ಥಳಕ್ಕೆ ಹೋಗುವ ಮಾರ್ಗವು ಇದುವರೆಗೂ ಪ್ರಕಟವಾಗಲಿಲ್ಲವೆಂಬುದನ್ನು ಪವಿತ್ರಾತ್ಮ ದೇವರು ವ್ಯಕ್ತಪಡಿಸುತ್ತಾರೆ <verse eid="HEB 9:8"/><verse number="9" style="v" sid="HEB 9:9"/>ಈ ಗುಡಾರವು ಈ ಕಾಲವನ್ನು ಸೂಚಿಸುವ ಒಂದು ಮಾದರಿಯಾಗಿದೆ. ಆಗ ಆರಾಧಿಸುವವರ ಮನಸ್ಸಾಕ್ಷಿಯನ್ನು ಪರಿಪೂರ್ಣ ಮಾಡಲಾರದ ಕಾಣಿಕೆಗಳೂ ಯಜ್ಞಗಳೂ ಅರ್ಪಿಸಲಾಗುತ್ತಿದ್ದವು. <verse eid="HEB 9:9"/><verse number="10" style="v" sid="HEB 9:10"/>ಅವು ಅನ್ನಪಾನಾದಿಗಳಲ್ಲಿಯೂ ವಿವಿಧ ಸ್ನಾನಗಳಲ್ಲಿಯೂ ಮುಂತಾದ ಬಾಹ್ಯಾಚಾರದ ಕ್ರಮಗಳಾಗಿದ್ದವು. ಅವು ಹೊಸ ಕ್ರಮಕಾಲದವರೆಗೆ ಮಾತ್ರ ನೇಮಕವಾಗಿದ್ದವು.<verse eid="HEB 9:10"/></para>
  <para style="s1">ಕ್ರಿಸ್ತ ಯೇಸುವಿನ ರಕ್ತ</para>
  <para style="p">
    <verse number="11" style="v" sid="HEB 9:11"/>ಆದರೆ ಕ್ರಿಸ್ತ ಯೇಸು ಈಗಾಗಲೇ ಮಹಾಯಾಜಕರಾಗಿ ಬಂದಿದ್ದಾರೆ. ಅವರು ಕೊಡುವ ಒಳ್ಳೆಯವುಗಳು ಈಗಾಗಲೇ ನಮಗೆ ದೊರೆತಿವೆ. ಅವರು ಹಿಂದಿನವುಗಳಿಗಿಂತಲೂ ಶ್ರೇಷ್ಠವಾದದ್ದೂ ಪರಿಪೂರ್ಣವಾದದ್ದೂ ಆಗಿರುವ ಗುಡಾರವನ್ನು ಅಂದರೆ ಕೈಯಿಂದ ಕಟ್ಟಿರದಂತದ್ದೂ ಇಹಲೋಕದ ಸೃಷ್ಟಿಗೆ ಸಂಬಂಧಪಟ್ಟಿರದಂತದ್ದೂ ಆಗಿರುವ ಗುಡಾರವನ್ನು ಪ್ರವೇಶಿಸಿದರು. <verse eid="HEB 9:11"/><verse number="12" style="v" sid="HEB 9:12"/>ಕ್ರಿಸ್ತ ಯೇಸು ಹೋತಗಳ ಮತ್ತು ಕರುಗಳ ರಕ್ತವನ್ನು ತೆಗೆದುಕೊಳ್ಳದೆ ತಮ್ಮ ಸ್ವಂತ ರಕ್ತವನ್ನೇ ತೆಗೆದುಕೊಂಡು ನಮಗೋಸ್ಕರ ನಿತ್ಯವಿಮೋಚನೆಯನ್ನು ಸಂಪಾದಿಸಿಕೊಂಡವರಾಗಿ ಒಂದೇ ಸಾರಿ ಮಹಾ ಪವಿತ್ರ ಸ್ಥಳದೊಳಗೆ ಪ್ರವೇಶಿಸಿದರು. <verse eid="HEB 9:12"/><verse number="13" style="v" sid="HEB 9:13"/>ಹೋತ ಹೋರಿಗಳ ರಕ್ತವನ್ನೂ ಅಶುದ್ಧರಾದವರ ಮೇಲೆ ಚಿಮುಕಿಸಲಾಯಿತು. ಯಜ್ಞಪಶುಗಳ ಬೂದಿಯನ್ನೂ ಅವರ ಮೇಲೆ ತೂರಲಾಯಿತು. ಇದು ಅವರ ದೇಹವನ್ನು ಶುದ್ಧೀಕರಿಸಿತು. <verse eid="HEB 9:13"/><verse number="14" style="v" sid="HEB 9:14"/>ನಿತ್ಯಾತ್ಮರಿಂದ ತಮ್ಮನ್ನು ತಾವೇ ನಿರ್ದೋಷಿಯನ್ನಾಗಿ ದೇವರಿಗೆ ಸಮರ್ಪಿಸಿಕೊಂಡ ಕ್ರಿಸ್ತ ಯೇಸುವಿನ ರಕ್ತವು ಎಷ್ಟೋ ಹೆಚ್ಚಾಗಿ ನಿರ್ಜೀವ ಕ್ರಿಯೆಗಳಿಂದ ನಮ್ಮನ್ನು ಬಿಡಿಸಿ ಜೀವವುಳ್ಳ ದೇವರನ್ನು ಆರಾಧಿಸುವಂತೆ ನಮ್ಮ ಮನಸ್ಸಾಕ್ಷಿಯನ್ನು ಶುದ್ಧೀಕರಿಸುವುದಲ್ಲವೇ?<verse eid="HEB 9:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="HEB 9:15"/>ಈ ಕಾರಣದಿಂದ ಕರೆಯಲಾದವರು ವಾಗ್ದಾನವಾದ ನಿತ್ಯಬಾಧ್ಯತೆಯನ್ನು ಸ್ವೀಕರಿಸುವಂತೆ ಕ್ರಿಸ್ತ ಯೇಸು ಹೊಸ ಒಡಂಬಡಿಕೆಗೆ ಮಧ್ಯಸ್ಥರಾಗಿದ್ದಾರೆ. ಮೊದಲಿನ ಒಡಂಬಡಿಕೆಯ ಕೆಳಗೆ ಮಾಡಿದ ಪಾಪಗಳಿಂದ ಅವರನ್ನು ವಿಮೋಚಿಸಲು ಯೇಸು ಆಗಲೇ ಈಡಾಗಿ ತಮ್ಮ ಪ್ರಾಣಕೊಟ್ಟಿದ್ದಾರೆ.<verse eid="HEB 9:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="HEB 9:16"/>ಮರಣ ಶಾಸನವು ಎಲ್ಲಿದೆಯೋ ಅಲ್ಲಿ ಅದನ್ನು ಮಾಡಿಕೊಂಡಾತನ ಮರಣ ಅವಶ್ಯ ಎಂಬುದನ್ನು ರುಜುಪಡಿಸಬೇಕು. <verse eid="HEB 9:16"/><verse number="17" style="v" sid="HEB 9:17"/>ಮರಣ ಶಾಸನವು ಬರೆದವನು ಜೀವದಿಂದಿರುವವರೆಗೂ ಅದು ಎಂದಿಗೂ ಜಾರಿಗೆ ಬರುವುದಿಲ್ಲ. <verse eid="HEB 9:17"/><verse number="18" style="v" sid="HEB 9:18"/>ಆದ್ದರಿಂದ ಮೊದಲನೆಯ ಒಡಂಬಡಿಕೆಯು ಸಹ ರಕ್ತವಿಲ್ಲದೆ ಪ್ರತಿಷ್ಠಾಪನೆ ಆಗಲಿಲ್ಲ. <verse eid="HEB 9:18"/><verse number="19" style="v" sid="HEB 9:19"/>ಮೋಶೆಯು ಪ್ರತಿಯೊಂದು ಆಜ್ಞೆಯನ್ನು ನಿಯಮದ ಪ್ರಕಾರ ಜನರೆಲ್ಲರಿಗೆ ಹೇಳಿದ ಮೇಲೆ ಅವನು ನೀರು, ಕೆಂಪು ಉಣ್ಣೆ, ಹಿಸ್ಸೋಪು ಇವುಗಳೊಂದಿಗೆ ಕರುಗಳ ಮತ್ತು ಹೋತಗಳ ರಕ್ತವನ್ನು ತೆಗೆದುಕೊಂಡು ಸುರುಳಿಗಳ ಮೇಲೆಯೂ ಎಲ್ಲಾ ಜನರ ಮೇಲೆಯೂ ಚಿಮುಕಿಸಿದನು. <verse eid="HEB 9:19"/><verse number="20" style="v" sid="HEB 9:20"/>ಹಾಗೆ ಚಿಮುಕಿಸುವಾಗ ಮೋಶೆಯು, “ಇದು ದೇವರು ನಿಮಗೆ ಆಜ್ಞಾಪಿಸಿದ ಒಡಂಬಡಿಕೆಯ ರಕ್ತ,”<note caller="+" style="f"><char style="fr" closed="false">9:20 </char><char style="ft" closed="false"><char style="xt"><ref loc="EXO 24:8">ವಿಮೋ 24:8</ref></char></char></note> ಎಂದು ಹೇಳಿದನು. <verse eid="HEB 9:20"/><verse number="21" style="v" sid="HEB 9:21"/>ಅದೇ ರೀತಿಯಾಗಿ ಮೋಶೆಯು ಗುಡಾರದ ಮೇಲೆಯೂ ಸೇವೆಯ ಎಲ್ಲಾ ಉಪ ಪಾತ್ರೆಗಳ ಮೇಲೆಯೂ ರಕ್ತವನ್ನು ಚಿಮುಕಿಸಿದನು. <verse eid="HEB 9:21"/><verse number="22" style="v" sid="HEB 9:22"/>ಹೀಗೆ ದೇವರ ನಿಯಮದ ಪ್ರಕಾರ ಎಲ್ಲವೂ ರಕ್ತದಿಂದಲೇ ಶುದ್ಧಿಯಾಗಬೇಕು. ರಕ್ತಧಾರೆ ಇಲ್ಲದೆ ಪಾಪಪರಿಹಾರವು ಉಂಟಾಗುವುದಿಲ್ಲ.<verse eid="HEB 9:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="HEB 9:23"/>ಆದ್ದರಿಂದ ಪರಲೋಕದಲ್ಲಿರುವ ವಸ್ತುಗಳ ಛಾಯೆಯಂತೆ ಇರುವ ವಸ್ತುಗಳನ್ನು ಈ ಯಜ್ಞಗಳಿಂದ ಶುದ್ಧಿಮಾಡುವುದು ಅವಶ್ಯವಾಗಿದೆ. ಹಾಗಾದರೆ ಪರಲೋಕದ ನಿಜ ವಸ್ತುಗಳಿಗೆ ಇವುಗಳಿಗಿಂತ ಉತ್ತಮವಾದ ಯಜ್ಞಗಳು ಅವಶ್ಯಕವಾಗಿವೆ. <verse eid="HEB 9:23"/><verse number="24" style="v" sid="HEB 9:24"/>ಏಕೆಂದರೆ ಕ್ರಿಸ್ತ ಯೇಸು ನಿಜ ದೇವಾಲಯದ ಪ್ರತಿರೂಪದಂತಿರುವ, ಕೈಯಿಂದ ಕಟ್ಟಿದ ಪವಿತ್ರ ಸ್ಥಳವನ್ನು ಪ್ರವೇಶಿಸದೆ, ದೇವರ ಸನ್ನಿಧಿಯಲ್ಲಿ ನಮಗೋಸ್ಕರ ಈಗ ಕಾಣಿಸಿಕೊಳ್ಳುವಂತೆ ಪರಲೋಕದಲ್ಲಿಯೇ ಪ್ರವೇಶಿಸಿದರು. <verse eid="HEB 9:24"/><verse number="25" style="v" sid="HEB 9:25"/>ಇದಲ್ಲದೆ ಮಹಾಯಾಜಕನು ಪ್ರತಿವರ್ಷವೂ ತನ್ನ ಸ್ವಂತದ್ದಾಗಿರದ ರಕ್ತವನ್ನು ತೆಗದುಕೊಂಡು ಅತಿ ಪವಿತ್ರ ಸ್ಥಳದಲ್ಲಿ ಪ್ರವೇಶಿಸುವ ಪ್ರಕಾರ ಯೇಸು ತಮ್ಮನ್ನು ಅನೇಕ ಸಾರಿ ಸಮರ್ಪಿಸುವುದಕ್ಕೆ ಪ್ರವೇಶಿಸಲಿಲ್ಲ. <verse eid="HEB 9:25"/><verse number="26" style="v" sid="HEB 9:26"/>ಹಾಗಿದ್ದರೆ, ಕ್ರಿಸ್ತ ಯೇಸುವು ಲೋಕದ ಅಸ್ತಿವಾರದಿಂದ ಅನೇಕ ಸಾರಿ ಬಾಧೆಪಡಬೇಕಾಗಿತ್ತು. ಆದರೆ ಈಗ ಅವರು ಒಂದೇ ಸಾರಿ ಲೋಕಾಂತ್ಯದಲ್ಲಿ ಪಾಪ ನಿವಾರಣೆ ಮಾಡುವುದಕ್ಕೆ ತಮ್ಮನ್ನು ತಾವೇ ಯಜ್ಞ ಮಾಡಿಕೊಳ್ಳುವವರಾಗಿ ಪ್ರತ್ಯಕ್ಷರಾದರು. <verse eid="HEB 9:26"/><verse number="27" style="v" sid="HEB 9:27"/>ಒಂದೇ ಸಾರಿ ಸಾಯುವುದೂ ತರುವಾಯ ನ್ಯಾಯತೀರ್ಪು ಪಡೆಯುವುದೂ ಮನುಷ್ಯರಿಗಾಗಿ ನೇಮಕವಾಗಿದೆ. <verse eid="HEB 9:27"/><verse number="28" style="v" sid="HEB 9:28"/>ಅದರಂತೆಯೇ ಕ್ರಿಸ್ತ ಯೇಸು ಬಹುಜನರ ಪಾಪಗಳನ್ನು ಹೊತ್ತುಕೊಳ್ಳುವುದಕ್ಕೋಸ್ಕರ ಒಂದೇ ಸಾರಿ ಸಮರ್ಪಿತರಾದರು. ತಮಗಾಗಿ ಕಾದಿರುವವರಿಗೆ ರಕ್ಷಣೆ ಕೊಡಲು ಕ್ರಿಸ್ತ ಯೇಸು ಎರಡನೆಯ ಸಲ ಕಾಣಿಸಿಕೊಳ್ಳುವರು. ಆಗ ಪಾಪ ಹೊತ್ತುಕೊಳ್ಳುವುದಕ್ಕಾಗಿ ಬರುವುದಿಲ್ಲ.<verse eid="HEB 9:28"/></para>
  <chapter eid="HEB 9"/>
  <chapter number="10" style="c" sid="HEB 10"/>
  <para style="s1">ಕ್ರಿಸ್ತ ಯೇಸುವಿನ ಒಂದೇ ಯಜ್ಞವು ಸದಾಕಾಲಕ್ಕೂ ಸಾರ್ಥಕವಾದದ್ದು</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 10:1"/>ಮೋಶೆಯ ನಿಯಮವು ಬರಬೇಕಾಗಿದ್ದ ವಸ್ತುಗಳ ಛಾಯೆಯಾಗಿದೆ ಹೊರತು ಅವುಗಳ ನಿಜಸ್ವರೂಪವಲ್ಲ. ಈ ಕಾರಣದಿಂದ ಅದು ಪ್ರತಿವರ್ಷ ಯಾವಾಗಲೂ ಯಜ್ಞಗಳನ್ನು ಅರ್ಪಿಸುವುದಕ್ಕೆ ಬರುವವರನ್ನು ಮೋಶೆಯ ನಿಯಮವು ಎಂದಿಗೂ ಪರಿಪೂರ್ಣತೆಗೆ ತರಲಾರದು. <verse eid="HEB 10:1"/><verse number="2" style="v" sid="HEB 10:2"/>ಒಂದು ವೇಳೆ ತಂದಿದ್ದ ಪಕ್ಷದಲ್ಲಿ ಆ ಯಜ್ಞಗಳ ಸಮರ್ಪಣೆಯು ನಿಂತು ಹೋಗುತ್ತಿತ್ತಲ್ಲಾ. ಏಕೆಂದರೆ ಆರಾಧನೆ ಮಾಡುವವರು ಒಂದು ಸಾರಿ ಪಾಪದಿಂದ ಶುದ್ಧೀಕರಣ ಹೊಂದಿದ ಮೇಲೆ ಅವರಿಗೆ ಎಂದಿಗೂ ಪಾಪಗಳ ಮನಸ್ಸಾಕ್ಷಿ ಇರುತ್ತಿರಲಿಲ್ಲ. <verse eid="HEB 10:2"/><verse number="3" style="v" sid="HEB 10:3"/>ಆ ಯಜ್ಞಗಳು ಪ್ರತಿವರ್ಷವೂ ಪಾಪಗಳ ಜ್ಞಾಪಕವನ್ನು ಉಂಟುಮಾಡುತ್ತಿತ್ತು. <verse eid="HEB 10:3"/><verse number="4" style="v" sid="HEB 10:4"/>ಏಕೆಂದರೆ ಹೋರಿಗಳ ಮತ್ತು ಹೋತಗಳ ರಕ್ತವು ಪಾಪಗಳನ್ನು ತೆಗೆದುಹಾಕುವುದು ಅಸಾಧ್ಯ.<verse eid="HEB 10:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="HEB 10:5"/>ಆದ್ದರಿಂದ ಕ್ರಿಸ್ತ ಯೇಸು ಭೂಲೋಕದೊಳಗೆ ಬಂದಾಗ,</para>
  <para style="q1" vid="HEB 10:5">“ಯಜ್ಞ ಮತ್ತು ಅರ್ಪಣೆಯನ್ನು ನೀವು ಇಷ್ಟಪಡಲಿಲ್ಲ,</para>
  <para style="q2" vid="HEB 10:5">ಆದರೆ ನನಗೆ ದೇಹವನ್ನು ಸಿದ್ಧಮಾಡಿ ಕೊಟ್ಟಿರುವೆ;<verse eid="HEB 10:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="HEB 10:6"/>ದಹನಬಲಿಗಳಲ್ಲಿಯೂ ಪಾಪಪರಿಹಾರ ಬಲಿಗಳಲ್ಲಿಯೂ</para>
  <para style="q2" vid="HEB 10:6">ನೀನು ಸಂತೋಷಪಡುವುದಿಲ್ಲ.<verse eid="HEB 10:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="HEB 10:7"/>ಆಗ ನಾನು ಹೀಗೆಂದೆನು, ‘ಓ, ದೇವರೇ, ಪವಿತ್ರ ವೇದದ ಸುರುಳಿಯಲ್ಲಿ ನನ್ನನ್ನು ಕುರಿತು ಬರೆದಿರುವಂತೆ</para>
  <para style="q2" vid="HEB 10:7">ನಾನು ನಿನ್ನ ಚಿತ್ತವನ್ನು ನೆರವೇರಿಸುವುದಕ್ಕೆ ಬಂದಿದ್ದೇನೆ.’ ”<note caller="+" style="f"><char style="fr" closed="false">10:7 </char><char style="ft" closed="false"><char style="xt"><ref loc="PSA 40:6-8">ಕೀರ್ತನೆ 40:6-8</ref></char></char></note><verse eid="HEB 10:7"/></para>
  <para style="m">
    <verse number="8" style="v" sid="HEB 10:8"/>ಮೋಶೆಯ ನಿಯಮದ ಪ್ರಕಾರವಾಗಿ ಅರ್ಪಿಸಲಾಗುತ್ತಿದ್ದಂತೆಯೇ, “ಯಜ್ಞವೂ ಅರ್ಪಣೆಯೂ ದಹನಬಲಿಗಳೂ ಪಾಪ ಪರಿಹಾರದ ಬಲಿಯೂ ನಿಮಗೆ ಇಷ್ಟವಾಗಿರಲಿಲ್ಲ. ಅವುಗಳಲ್ಲಿ ನಿಮಗೆ ಸಂತೋಷವಿರಲಿಲ್ಲ,” ಎಂದು ಮೊದಲು ಅವರು ಹೇಳಿ, <verse eid="HEB 10:8"/><verse number="9" style="v" sid="HEB 10:9"/>ತರುವಾಯ, “ಇಗೋ, ದೇವರೇ, ನಿಮ್ಮ ಚಿತ್ತವನ್ನು ನೆರವೇರಿಸಲು ಬಂದಿದ್ದೇನೆ!” ಎಂದು ಹೇಳಿದ್ದಾರೆ. ಹೀಗೆ ಅವರು ಎರಡನೆಯದನ್ನು ಸ್ಥಾಪಿಸುವುದಕ್ಕಾಗಿ ಮೊದಲನೆಯದನ್ನು ರದ್ದು ಮಾಡಿದ್ದಾರೆ. <verse eid="HEB 10:9"/><verse number="10" style="v" sid="HEB 10:10"/>ಹೀಗೆ ಒಂದೇ ಸಾರಿ ಎಲ್ಲಾ ಕಾಲಕ್ಕೂ ಕ್ರಿಸ್ತ ಯೇಸು ತಮ್ಮ ದೇಹವನ್ನು ಸಮರ್ಪಿಸಿದ್ದರ ಮೂಲಕ ದೇವರ ಚಿತ್ತವನ್ನು ನೆರವೇರಿಸಿ, ನಮ್ಮನ್ನು ಶುದ್ಧರನ್ನಾಗಿ ಮಾಡಿದ್ದಾರೆ.<verse eid="HEB 10:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="HEB 10:11"/>ಇದಲ್ಲದೆ ಪ್ರತಿ ಯಾಜಕನು ಅನುದಿನವೂ ಸೇವೆಮಾಡುತ್ತಾ ನಿಂತಿರುವನು. ಆದರೆ ಎಂದಿಗೂ ಪಾಪಗಳನ್ನು ತೆಗೆದುಹಾಕಲಾರದಂಥ ಯಜ್ಞಗಳನ್ನು ಪದೇಪದೇ ಅರ್ಪಿಸುತ್ತಿದ್ದನು. <verse eid="HEB 10:11"/><verse number="12" style="v" sid="HEB 10:12"/>ಕ್ರಿಸ್ತ ಯೇಸುವು ಪಾಪಗಳಿಗೋಸ್ಕರ ನಿರಂತರವಾದ ಒಂದೇ ಯಜ್ಞವನ್ನು ಅರ್ಪಿಸಿದ ಮೇಲೆ ದೇವರ ಬಲಗಡೆಯಲ್ಲಿ ಕುಳಿತುಕೊಂಡರು. <verse eid="HEB 10:12"/><verse number="13" style="v" sid="HEB 10:13"/>ಅಂದಿನಿಂದ ತಮ್ಮ ವಿರೋಧಿಗಳನ್ನು ತಮ್ಮ ಪಾದಪೀಠವಾಗಿ ಮಾಡಿಕೊಳ್ಳುವ ತನಕ ಕ್ರಿಸ್ತ ಯೇಸು ಕಾಯುತ್ತಿರುವರು. <verse eid="HEB 10:13"/><verse number="14" style="v" sid="HEB 10:14"/>ಏಕೆಂದರೆ ಕ್ರಿಸ್ತ ಯೇಸುವು ಒಂದೇ ಬಲಿ ಅರ್ಪಣೆಯಿಂದ ಪವಿತ್ರವಾಗುವವರನ್ನು ನಿರಂತರ ಪರಿಪೂರ್ಣರನ್ನಾಗಿ ಮಾಡಿದ್ದಾರೆ.<verse eid="HEB 10:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="HEB 10:15"/>ಪವಿತ್ರಾತ್ಮ ದೇವರು ಸಹ ನಿಮಗೆ ಸಾಕ್ಷಿ ಕೊಡುವವರಾಗಿ,<verse eid="HEB 10:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="HEB 10:16"/>“ಆ ದಿನಗಳ ತರುವಾಯ,</para>
  <para style="q2" vid="HEB 10:16">ನಾನು ಅವರ ಸಂಗಡ ಮಾಡಿಕೊಳ್ಳುವ ಒಡಂಬಡಿಕೆಯು ಹೀಗಿರುವುದು:</para>
  <para style="q1" vid="HEB 10:16">ನಾನು ನನ್ನ ನಿಯಮಗಳನ್ನು ಅವರ ಹೃದಯಗಳಲ್ಲಿ ಇಡುವೆನು.</para>
  <para style="q2" vid="HEB 10:16">ಅವರ ಮನಸ್ಸಿನಲ್ಲಿ ಅವುಗಳನ್ನು ಬರೆಯುವೆನು, ಎಂದು ಕರ್ತದೇವರು ಹೇಳುತ್ತಾರೆ.”<note caller="+" style="f"><char style="fr" closed="false">10:16 </char><char style="ft" closed="false"><char style="xt"><ref loc="JER 31:33">ಯೆರೆ 31:33</ref></char></char></note><verse eid="HEB 10:16"/></para>
  <para style="m">
    <verse number="17" style="v" sid="HEB 10:17"/>ತರುವಾಯ ಅವರು,</para>
  <para style="q1" vid="HEB 10:17">“ನಾನು ಅವರ ಪಾಪಗಳನ್ನೂ ಅಧರ್ಮಗಳನ್ನೂ</para>
  <para style="q2" vid="HEB 10:17">ಇನ್ನೆಂದಿಗೂ ನನ್ನ ನೆನಪಿಗೆ ತಂದುಕೊಳ್ಳುವುದಿಲ್ಲ!”<note caller="+" style="f"><char style="fr" closed="false">10:17 </char><char style="ft" closed="false"><char style="xt"><ref loc="JER 31:34">ಯೆರೆ 31:34</ref></char></char></note></para>
  <para style="m" vid="HEB 10:17">ಎಂದು ಹೇಳುತ್ತಾರೆ.<verse eid="HEB 10:17"/></para>
  <para style="m">
    <verse number="18" style="v" sid="HEB 10:18"/>ಆದ್ದರಿಂದ, ಈಗ ಕ್ಷಮಾಪಣೆಯಾದ ಬಳಿಕ ಪಾಪ ಪರಿಹಾರದ ಬಲಿಯ ಅವಶ್ಯಕತೆ ಇಲ್ಲ.<verse eid="HEB 10:18"/></para>
  <para style="s1">ವಿಶ್ವಾಸದಲ್ಲಿರಲು ಕರೆ</para>
  <para style="p">
    <verse number="19" style="v" sid="HEB 10:19"/>ಆದ್ದರಿಂದ ಪ್ರಿಯರೇ, ಯೇಸುವಿನ ರಕ್ತದಿಂದ ಅವರ ದೇಹವೆಂಬ ಪರದೆಯ ಮೂಲಕ ನಮಗೆ ತೆರೆಯಲಾದ <verse eid="HEB 10:19"/><verse number="20" style="v" sid="HEB 10:20"/>ಹೊಸ ಹಾಗೂ ಸಜೀವವಾದ ಮಾರ್ಗವಿರುವುದರಿಂದ ಅತಿಪರಿಶುದ್ಧವಾದ ಸ್ಥಳವನ್ನು ಪ್ರವೇಶಿಸಲು ಭರವಸೆಯಿದೆ. <verse eid="HEB 10:20"/><verse number="21" style="v" sid="HEB 10:21"/>ದೇವರ ಮನೆಯ ಮೇಲೆ ಮಹಾಯಾಜಕನು ನಮಗಿರುವುದರಿಂದ <verse eid="HEB 10:21"/><verse number="22" style="v" sid="HEB 10:22"/>ಆದಕಾರಣ ಅಪರಾಧ ಮನಸ್ಸಾಕ್ಷಿಯೆಂದು ನಮ್ಮ ಮನಸ್ಸು ನಮಗೆ ಸಾಕ್ಷಿಹೇಳದಂತೆ ನಾವು ಹೃದಯವನ್ನು ಪ್ರೋಕ್ಷಿಸಿಕೊಂಡು ದೇಹವನ್ನು ಶುದ್ಧ ನೀರಿನಿಂದ ತೊಳೆದುಕೊಂಡು ಪರಿಪೂರ್ಣವಾದ ನಂಬಿಕೆಯುಳ್ಳವರಾಗಿಯೂ ಯಥಾರ್ಥ ಹೃದಯವುಳ್ಳವರಾಗಿಯೂ ದೇವರ ಸಮೀಪಕ್ಕೆ ಬರೋಣ. <verse eid="HEB 10:22"/><verse number="23" style="v" sid="HEB 10:23"/>ನಾವು ನಮ್ಮ ನಿರೀಕ್ಷೆಯ ಅರಿಕೆಯನ್ನು ಚಂಚಲರಾಗದೆ ಬಿಗಿಯಾಗಿ ಹಿಡಿಯೋಣ. ಏಕೆಂದರೆ ವಾಗ್ದಾನ ಮಾಡಿದವರು ನಂಬಿಗಸ್ತರು. <verse eid="HEB 10:23"/><verse number="24" style="v" sid="HEB 10:24"/>ನಾವು ಒಬ್ಬರನ್ನೊಬ್ಬರು ಪ್ರೀತಿಸುವುದಕ್ಕಾಗಿಯೂ ಸತ್ಕಾರ್ಯ ಮಾಡುವುದಕ್ಕಾಗಿಯೂ ಹೇಗೆ ಒಬ್ಬರನ್ನೊಬ್ಬರು ಪ್ರೋತ್ಸಾಹಿಸಬೇಕೆಂದು ಯೋಚಿಸೋಣ. <verse eid="HEB 10:24"/><verse number="25" style="v" sid="HEB 10:25"/>ಸಭೆಯಾಗಿ ಸೇರುವುದನ್ನು ಕೆಲವರಿಗೆ ರೂಢಿಯಾಗಿ ಬಿಟ್ಟಂತೆ, ನಾವು ಹಾಗೆ ಮಾಡದಿರೋಣ. ಕರ್ತ ಯೇಸುವಿನ ಪ್ರತ್ಯಕ್ಷತೆಯ ದಿನವು ಸಮೀಪಿಸುತ್ತಾ ಬರುತ್ತದೆ ಎಂದು ನೀವು ತಿಳಿದಿರುವುದರಿಂದ ಒಬ್ಬರನ್ನೊಬ್ಬರು ಪ್ರೋತ್ಸಾಹಗೊಳಿಸುವುದನ್ನು ಇನ್ನೂ ಹೆಚ್ಚಾಗಿ ಮಾಡಿರಿ.<verse eid="HEB 10:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="HEB 10:26"/>ಏಕೆಂದರೆ, ನಾವು ಸತ್ಯದ ಅರಿವನ್ನು ಹೊಂದಿದ ಮೇಲೆ ಬೇಕೆಂದು ಪಾಪ ಮಾಡುತ್ತಾ ಇದ್ದರೆ, ಪಾಪಗಳಿಗಾಗಿ ಇನ್ನಾವ ಯಜ್ಞವೂ ಉಳಿದಿರುವುದಿಲ್ಲ. <verse eid="HEB 10:26"/><verse number="27" style="v" sid="HEB 10:27"/>ಆದರೆ ಖಂಡಿತವಾಗಿ ಎದುರು ನೋಡತಕ್ಕ ಭಯಂಕರವಾದ ನ್ಯಾಯತೀರ್ಪು ವಿರೋಧಿಗಳನ್ನು ದಹಿಸುವ ಕೋಪಾಗ್ನಿಯೂ ಇರುವುವು. <verse eid="HEB 10:27"/><verse number="28" style="v" sid="HEB 10:28"/>ಮೋಶೆಯ ನಿಯಮವನ್ನು ಅಸಡ್ಡೆ ಮಾಡಿದವನಿಗೆ ಇಬ್ಬರು ಇಲ್ಲವೆ ಮೂವರು ಸಾಕ್ಷಿಗಳಿಂದ ಕರುಣೆಯಿಲ್ಲದೆ ಮರಣದಂಡನೆಯಾಗುತ್ತಿತ್ತು. <verse eid="HEB 10:28"/><verse number="29" style="v" sid="HEB 10:29"/>ಯಾವನು ದೇವಪುತ್ರರನ್ನೇ ತುಳಿದು ತನ್ನನ್ನು ಶುದ್ಧೀಕರಿಸಿದ ಒಡಂಬಡಿಕೆಯ ರಕ್ತವನ್ನು ಅಶುದ್ಧವೆಂದೆಣಿಸಿ ಕೃಪೆಯ ಪವಿತ್ರಾತ್ಮ ದೇವರನ್ನು ತಿರಸ್ಕಾರ ಮಾಡಿದ್ದಾನೋ, ಅವನು ಇನ್ನೂ ಎಷ್ಟೋ ಕ್ರೂರವಾದ ದಂಡನೆಗೆ ಪಾತ್ರನಾಗುವನೆಂಬುದನ್ನು ಯೋಚಿಸಿರಿ. <verse eid="HEB 10:29"/><verse number="30" style="v" sid="HEB 10:30"/>ಏಕೆಂದರೆ, “ಮುಯ್ಯಿ ತೀರಿಸುವುದು ನನಗೆ ಸಂಬಂಧಪಟ್ಟದ್ದು, ನಾನೇ ಪ್ರತಿಫಲವನ್ನು ಕೊಡುವೆನು,”<note caller="+" style="f"><char style="fr" closed="false">10:30 </char><char style="ft" closed="false"><char style="xt"><ref loc="DEU 32:35">ಧರ್ಮೋ 32:35</ref></char></char></note> ಎಂದು ಹೇಳಿದ ಕರ್ತದೇವರನ್ನು ನಾವು ಬಲ್ಲೆವು. ಇದಲ್ಲದೆ, “ಕರ್ತದೇವರು ತಮ್ಮ ಜನರಿಗೆ ನ್ಯಾಯತೀರಿಸುವರು,”<note caller="+" style="f"><char style="fr" closed="false">10:30 </char><char style="ft" closed="false"><char style="xt"><ref loc="DEU 32:36">ಧರ್ಮೋ 32:36</ref>; <ref loc="PSA 135:14">ಕೀರ್ತನೆ 135:14</ref></char></char></note> ಎಂದೂ ಹೇಳಲಾಗಿದೆ. <verse eid="HEB 10:30"/><verse number="31" style="v" sid="HEB 10:31"/>ಸಜೀವ ದೇವರ ಕೈಯಲ್ಲಿ ಬೀಳುವುದು ಭಯಂಕರವಾದದ್ದು.<verse eid="HEB 10:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="HEB 10:32"/>ಆದರೆ ನೀವು ಬೆಳಕನ್ನು ಹೊಂದಿದ ಮೇಲೆ ಬಾಧೆಗಳ ಬಹು ಹೋರಾಟವನ್ನು ಸಹಿಸಿಕೊಂಡ ಹಿಂದಿನ ದಿನಗಳನ್ನು ನೆನಪುಮಾಡಿಕೊಳ್ಳಿರಿ. <verse eid="HEB 10:32"/><verse number="33" style="v" sid="HEB 10:33"/>ಕೆಲವು ಸಾರಿ ನೀವು ನಿಂದೆಗಳನ್ನೂ ಉಪದ್ರವಗಳನ್ನೂ ಅನುಭವಿಸಿ ಬಹಿರಂಗ ಹಾಸ್ಯಕ್ಕೆ ಗುರಿಯಾದಿರಿ. ಕೆಲವು ಸಾರಿ ಅಂಥವುಗಳನ್ನು ಅನುಭವಿಸುವವರ ಭಾಗಿಗಳಾದಿರಿ. <verse eid="HEB 10:33"/><verse number="34" style="v" sid="HEB 10:34"/>ನೀವು ಸೆರೆಯವರಿಗೆ ಅನುತಾಪ ತೋರಿಸಿ, ನಿಮಗೋಸ್ಕರವಾಗಿ ಸ್ಥಿರವಾದ ಉತ್ತಮ ಆಸ್ತಿಯಿದೆ ಎಂದು ತಿಳಿದು, ನಿಮ್ಮ ಆಸ್ತಿ ಸುಲಿಗೆಯಾದಾಗ ಸಂತೋಷವಾಗಿ ಬಿಟ್ಟುಕೊಟ್ಟಿದ್ದೀರಿ. <verse eid="HEB 10:34"/><verse number="35" style="v" sid="HEB 10:35"/>ಮಹಾ ಪ್ರತಿಫಲ ನಿಮಗಿರುವುದರಿಂದ ನಿಮ್ಮ ಧೈರ್ಯವನ್ನು ಕಳೆದುಕೊಳ್ಳಬೇಡಿರಿ.<verse eid="HEB 10:35"/></para>
  <para style="p">
    <verse number="36" style="v" sid="HEB 10:36"/>ನೀವು ದೇವರ ಚಿತ್ತವನ್ನು ನೆರವೇರಿಸಿದ ಮೇಲೆ ಅವರು ಮಾಡಿದ ವಾಗ್ದಾನವನ್ನು ಹೊಂದುವಂತೆ ನಿಮಗೆ ತಾಳ್ಮೆಯು ಅವಶ್ಯವಾಗಿದೆ: <verse eid="HEB 10:36"/><verse number="37" style="v" sid="HEB 10:37"/>ಏಕೆಂದರೆ,</para>
  <para style="q1" vid="HEB 10:37">“ಇನ್ನು ಸ್ವಲ್ಪ ಸಮಯದಲ್ಲಿಯೇ,</para>
  <para style="q2" vid="HEB 10:37">ಬರಲಿರುವ ಒಬ್ಬರು ಬಂದೇ ಬರುವರು.</para>
  <para style="q2" vid="HEB 10:37">ಅವರು ತಡಮಾಡುವುದಿಲ್ಲ.”<note caller="+" style="f"><char style="fr" closed="false">10:37 </char><char style="ft" closed="false"><char style="xt"><ref loc="ISA 26:20">ಯೆಶಾಯ 26:20</ref>; <ref loc="HAB 2:3">ಹಬ 2:3</ref></char></char></note><verse eid="HEB 10:37"/></para>
  <para style="m">
    <verse number="38" style="v" sid="HEB 10:38"/>ಆದರೆ,</para>
  <para style="q1" vid="HEB 10:38">“ನನ್ನ ನೀತಿವಂತನು ನಂಬಿಕೆಯಿಂದಲೇ ಬದುಕುವನು,</para>
  <para style="q2" vid="HEB 10:38">ಅವನು ಹಿಂಜರಿದರೆ,</para>
  <para style="q2" vid="HEB 10:38">ಅವನಲ್ಲಿ ನನಗೆ ಸಂತೋಷವಿರುವುದಿಲ್ಲ.”<note caller="+" style="f"><char style="fr" closed="false">10:38 </char><char style="ft" closed="false"><char style="xt"><ref loc="HAB 2:4">ಹಬ 2:4</ref></char></char></note><verse eid="HEB 10:38"/></para>
  <para style="m">
    <verse number="39" style="v" sid="HEB 10:39"/>ನಾವಾದರೋ ಹಿಂಜರಿದು ನಾಶವಾಗುವವರಲ್ಲ, ನಂಬುವವರಾಗಿ ಆ ರಕ್ಷಣೆಯನ್ನು ಹೊಂದುವವರಾಗಿದ್ದೇವೆ.<verse eid="HEB 10:39"/></para>
  <chapter eid="HEB 10"/>
  <chapter number="11" style="c" sid="HEB 11"/>
  <para style="s1">ನಂಬಿಕೆಯ ವೀರರು</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 11:1"/>ನಂಬಿಕೆ ಎಂಬುದು ನಾವು ನಿರೀಕ್ಷಿಸುವವುಗಳ ನಿಶ್ಚಯವೂ ಕಾಣದವುಗಳ ನಿದರ್ಶನವೂ ಆಗಿದೆ. <verse eid="HEB 11:1"/><verse number="2" style="v" sid="HEB 11:2"/>ಹಿರಿಯರು ನಂಬಿಕೆಯಿಂದಲೇ ಒಳ್ಳೆಯ ಸಾಕ್ಷಿಹೊಂದಿದರು.<verse eid="HEB 11:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="HEB 11:3"/>ವಿಶ್ವವು ದೇವರ ವಾಕ್ಯದಿಂದ ಉಂಟಾದವೆಂದೂ ಕಾಣುವಂತವುಗಳು ಕಾಣದವುಗಳಿಂದ ಉಂಟಾದವು ಎಂಬುದನ್ನು ನಾವು ನಂಬಿಕೆಯಿಂದ ತಿಳಿದುಕೊಂಡದ್ದರಿಂದ ಗ್ರಹಿಸುತ್ತೇವೆ.<verse eid="HEB 11:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="HEB 11:4"/>ನಂಬಿಕೆಯಿಂದಲೇ ಹೇಬೆಲನು ಕಾಯಿನನ ಯಜ್ಞಕ್ಕಿಂತ ಉತ್ತಮ ಯಜ್ಞವನ್ನು ದೇವರಿಗೆ ಸಮರ್ಪಿಸಿದನು. ಅದರ ಮೂಲಕ ಅವನು ನೀತಿವಂತನೆಂದು ಸಾಕ್ಷಿಹೊಂದಿದನು. ದೇವರು ಸಹ ಅವನ ಕಾಣಿಕೆಗಳನ್ನು ಸ್ವೀಕಾರಮಾಡಿದರು. ಅವನು ಸತ್ತು ಹೋಗಿದ್ದರೂ ನಂಬಿಕೆಯ ಮೂಲಕ ಇನ್ನೂ ಮಾತನಾಡುತ್ತಿದ್ದಾನೆ.<verse eid="HEB 11:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="HEB 11:5"/>ನಂಬಿಕೆಯಿಂದಲೇ ಹನೋಕನು ಮರಣ ಹೊಂದದೆ, ಒಯ್ಯಲಾದನು. “ದೇವರು ಅವನನ್ನು ತೆಗೆದುಕೊಂಡು ಹೋದದ್ದರಿಂದ ಅವನು ಕಾಣಲಿಲ್ಲ.”<note caller="+" style="f"><char style="fr" closed="false">11:5 </char><char style="ft" closed="false"><char style="xt"><ref loc="GEN 5:24">ಆದಿ 5:24</ref></char></char></note> ಅವನು ಒಯ್ಯಲಾಗುವುದಕ್ಕಿಂತ ಮುಂಚೆ ದೇವರನ್ನು ಮೆಚ್ಚಿಸುವವನಾಗಿದ್ದನೆಂದು ಸಾಕ್ಷಿಹೊಂದಿದನು. <verse eid="HEB 11:5"/><verse number="6" style="v" sid="HEB 11:6"/>ನಂಬಿಕೆಯಿಲ್ಲದೆ ದೇವರನ್ನು ಮೆಚ್ಚಿಸುವುದು ಅಸಾಧ್ಯ. ಏಕೆಂದರೆ ದೇವರ ಬಳಿಗೆ ಬರುವವರು, ದೇವರು ಇದ್ದಾರೆಂತಲೂ ತಮ್ಮನ್ನು ಜಾಗ್ರತೆಯಿಂದ ಹುಡುಕುವವರಿಗೆ ಪ್ರತಿಫಲವನ್ನು ಕೊಡುತ್ತಾರೆಂತಲೂ ನಂಬಬೇಕು.<verse eid="HEB 11:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="HEB 11:7"/>ನಂಬಿಕೆಯಿಂದಲೇ ನೋಹನು ಇನ್ನೂ ಕಾಣದಿದ್ದವುಗಳ ವಿಷಯವಾಗಿ ದೇವರಿಂದ ಎಚ್ಚರಿಕೆ ಪಡೆದು ಭಕ್ತಿಯಲ್ಲಿ ತನ್ನ ಮನೆಯವರ ರಕ್ಷಣೆಗಾಗಿ ನಾವೆಯನ್ನು ಸಿದ್ಧಮಾಡಿದನು. ಅವನು ಲೋಕದವರನ್ನು ಖಂಡಿಸಿ ತರುವಾಯ ನಂಬಿಕೆಗೆ ಅನುಸಾರವಾಗಿ ನಂಬಿಕೆಯಿಂದ ಬರುವ ನೀತಿಗೆ ಬಾಧ್ಯನಾದನು.<verse eid="HEB 11:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="HEB 11:8"/>ನಂಬಿಕೆಯಿಂದಲೇ ಅಬ್ರಹಾಮನು ಕರೆಕೊಟ್ಟಾಗ ವಿಧೇಯನಾಗಿ ತಾನು ಬಾಧ್ಯವಾಗಿ ಹೊಂದಬೇಕಾಗಿದ್ದ ಸ್ಥಳಕ್ಕೆ ಹೊರಟುಹೋದನು. ತಾನು ಹೋಗುವುದು ಎಲ್ಲಿಗೆ ಎಂದು ತಿಳಿಯದೆ ಹೊರಟನು. <verse eid="HEB 11:8"/><verse number="9" style="v" sid="HEB 11:9"/>ನಂಬಿಕೆಯಿಂದಲೇ ಅವನು ವಾಗ್ದಾನದ ದೇಶಕ್ಕೆ<note caller="+" style="f"><char style="fr" closed="false">11:9 </char><char style="ft" closed="false">ಸ್ವಂತವಾಗಿರಲು ದೇವರು ಕೊಟ್ಟ ದೇಶ</char></note> ಬಂದಾಗಲೂ ಅನ್ಯದೇಶದಲ್ಲಿ ಇದ್ದವನಂತೆ ಗುಡಾರಗಳಲ್ಲಿ ಇದ್ದುಕೊಂಡು ಪ್ರವಾಸಿಯಾಗಿದ್ದನು. ಅದೇ ವಾಗ್ದಾನಕ್ಕೆ ಬಾಧ್ಯರಾಗಿದ್ದ ಇಸಾಕ ಯಾಕೋಬರು ಸಹ ಗುಡಾರಗಳಲ್ಲಿ ವಾಸಿಸಿದರು. <verse eid="HEB 11:9"/><verse number="10" style="v" sid="HEB 11:10"/>ಏಕೆಂದರೆ ದೇವರು ಯಾವುದನ್ನು ಕಟ್ಟುವವರೂ ಮಾಡುವವರೂ ಆಗಿದ್ದಾರೋ ಆ ಅಸ್ತಿವಾರಗಳುಳ್ಳ ಪಟ್ಟಣಕ್ಕೋಸ್ಕರ ಅವರು ಎದುರುನೋಡುತ್ತಿದ್ದರು. <verse eid="HEB 11:10"/><verse number="11" style="v" sid="HEB 11:11"/>ನಂಬಿಕೆಯಿಂದಲೇ ಸಾರಳು ಸಹ ವಾಗ್ದಾನ ಮಾಡಿದ ದೇವರು ನಂಬಿಗಸ್ತರು ಎಂದೆಣಿಸಿ ತಾನು ಪ್ರಾಯಮೀರಿದವಳಾಗಿದ್ದರೂ ಗರ್ಭವತಿಯಾಗುವುದಕ್ಕೆ ಸಾಮರ್ಥ್ಯ ಹೊಂದಿ, ಒಂದು ಮಗುವನ್ನು ಹೆತ್ತಳು. <verse eid="HEB 11:11"/><verse number="12" style="v" sid="HEB 11:12"/>ಆದ್ದರಿಂದ ಮೃತಪ್ರಾಯನಾಗಿದ್ದ ಒಬ್ಬನಿಂದ ಆಕಾಶದ ನಕ್ಷತ್ರಗಳಂತೆ ಗುಂಪುಗುಂಪಾಗಿಯೂ ಸಮುದ್ರ ತೀರದಲ್ಲಿರುವ ಮರಳಿನಂತೆ ಅಸಂಖ್ಯವಾಗಿಯೂ ಸಂತತಿಯವರು ಹುಟ್ಟಿದರು.<verse eid="HEB 11:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="HEB 11:13"/>ಈ ಎಲ್ಲಾ ಜನರು ಮರಣ ಹೊಂದುವಾಗಲೂ ವಿಶ್ವಾಸದಿಂದ ಜೀವಿಸುವವರಾಗಿದ್ದರು. ವಾಗ್ದಾನದ ಸಂಗತಿಗಳನ್ನು ಅವರು ಹೊಂದಲಿಲ್ಲ. ಅವುಗಳನ್ನು ಅವರು ದೂರದಿಂದಲೇ ನೋಡಿ ಸ್ವಾಗತಿಸಿದರು. ತಾವು ಭೂಮಿಯ ಮೇಲೆ ಪರದೇಶದವರೂ ಅಪರಿಚಿತರೂ ಆಗಿದ್ದೇವೆಂದು ಒಪ್ಪಿಕೊಂಡರು. <verse eid="HEB 11:13"/><verse number="14" style="v" sid="HEB 11:14"/>ಇಂಥಾ ಸಂಗತಿಗಳನ್ನು ಹೇಳುವ ಜನರು ತಮ್ಮ ಸ್ವಂತ ದೇಶಕ್ಕಾಗಿ ಎದುರುನೋಡುತ್ತಿದ್ದರು. <verse eid="HEB 11:14"/><verse number="15" style="v" sid="HEB 11:15"/>ಒಂದು ವೇಳೆ ತಾವು ಬಿಟ್ಟುಬಂದ ದೇಶವನ್ನು ಕುರಿತು ಅವರು ಯೋಚಿಸುತ್ತಿದ್ದರೆ, ಅಲ್ಲಿಗೆ ಹಿಂದಿರುಗಿ ಹೋಗುವ ಅವಕಾಶಗಳು ಅವರಿಗಿದ್ದವು. <verse eid="HEB 11:15"/><verse number="16" style="v" sid="HEB 11:16"/>ಅದರ ಬದಲು ಅವರು ಅದಕ್ಕಿಂತ ಉತ್ತಮವಾದ ಪರಲೋಕದ ದೇಶವನ್ನು ನಿರೀಕ್ಷಿಸಿದರು. ಆದ್ದರಿಂದ ದೇವರು ಅವರ ದೇವರೆನಿಸಿಕೊಳ್ಳುವುದಕ್ಕೆ ನಾಚಿಕೊಳ್ಳದೆ ಅವರಿಗಾಗಿ ಒಂದು ಪಟ್ಟಣವನ್ನು ಸಿದ್ಧಮಾಡಿದ್ದಾರೆ.<verse eid="HEB 11:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="HEB 11:17"/>ಅಬ್ರಹಾಮನು ಪರೀಕ್ಷೆಗೆ ಒಳಗಾದಾಗ ಇಸಾಕನನ್ನು ನಂಬಿಕೆಯಿಂದಲೇ ಸಮರ್ಪಿಸಿದನು. ಆ ವಾಗ್ದಾನಗಳನ್ನು ಹೊಂದಿದ ಅವನು ತನ್ನ ಒಬ್ಬನೇ ಮಗನನ್ನು ಸಮರ್ಪಿಸಿದನು. <verse eid="HEB 11:17"/><verse number="18" style="v" sid="HEB 11:18"/>ಅವನ ವಿಷಯದಲ್ಲಿ, “ಇಸಾಕನಿಂದ ಹುಟ್ಟುವವರೇ ನಿನ್ನ ಸಂತತಿ ಎನಿಸಿಕೊಳ್ಳುವರು,”<note caller="+" style="f"><char style="fr" closed="false">11:18 </char><char style="ft" closed="false"><char style="xt"><ref loc="GEN 21:12">ಆದಿ 21:12</ref></char></char></note> ಎಂದು ದೇವರು ಅವನಿಗೆ ಹೇಳಿದ್ದರೂ ವಾಗ್ದಾನ ಸ್ವೀಕರಿಸಿದವನು ತನ್ನ ಒಬ್ಬನೇ ಮಗನನ್ನು ಬಲಿಗಾಗಿ ಅರ್ಪಿಸಿದನು. <verse eid="HEB 11:18"/><verse number="19" style="v" sid="HEB 11:19"/>ತನ್ನ ದೇವರು ಸತ್ತವರೊಳಗಿಂದ ಎಬ್ಬಿಸಲು ಸಮರ್ಥರು ಎಂದು ಅಬ್ರಹಾಮನು ತಿಳಿದಿದ್ದನು. ಅವನು ಇಸಾಕನನ್ನು ಸತ್ತವರೊಳಗಿಂದಲೇ ಜೀವಿತನಾಗಿ ಬಂದವನಂತೆ ಅವನನ್ನು ಹೊಂದಿದನು.<verse eid="HEB 11:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="HEB 11:20"/>ನಂಬಿಕೆಯಿಂದಲೇ ಇಸಾಕನು ಮುಂದೆ ಬರಬೇಕಾದವುಗಳ ವಿಷಯದಲ್ಲಿ ಯಾಕೋಬನನ್ನೂ ಏಸಾವನನ್ನೂ ಆಶೀರ್ವದಿಸಿದನು.<verse eid="HEB 11:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="HEB 11:21"/>ನಂಬಿಕೆಯಿಂದಲೇ ಯಾಕೋಬನು ಮರಣ ಹೊಂದುವ ಸಮಯದಲ್ಲಿ ಯೋಸೇಫನ ಮಕ್ಕಳನ್ನು ಆಶೀರ್ವದಿಸಿದನು. ತನ್ನ ಕೋಲಿನ ಮೇಲೆ ಒರಗಿಕೊಂಡು ದೇವರನ್ನು ಆರಾಧಿಸಿದನು.<verse eid="HEB 11:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="HEB 11:22"/>ನಂಬಿಕೆಯಿಂದಲೇ ಯೋಸೇಫನು ಸಾಯುವಾಗ ಇಸ್ರಾಯೇಲರು ಹೊರಡುವುದನ್ನು ಕುರಿತು ಮಾತನಾಡಿ ತನ್ನ ಎಲುಬುಗಳ ವಿಷಯದಲ್ಲಿ ಅಪ್ಪಣೆಕೊಟ್ಟನು.<verse eid="HEB 11:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="HEB 11:23"/>ನಂಬಿಕೆಯಿಂದಲೇ ಮೋಶೆ ಹುಟ್ಟಿದಾಗ ಕೂಸು ಸುಂದರವಾಗಿರುವುದನ್ನು ಅವನ ತಂದೆತಾಯಿಗಳು ನೋಡಿ ಅರಸನ ಅಪ್ಪಣೆಗೆ ಭಯಪಡದೆ ಅವನನ್ನು ಮೂರು ತಿಂಗಳು ಬಚ್ಚಿಟ್ಟರು.<verse eid="HEB 11:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="HEB 11:24"/>ಮೋಶೆಯು ದೊಡ್ಡವನಾಗಿ ಬೆಳೆದ ಮೇಲೆ ನಂಬಿಕೆಯಿಂದಲೇ ಫರೋಹನ ಪುತ್ರಿಯ ಮಗನೆಂದು ಕರೆಯಿಸಿಕೊಳ್ಳಲು ನಿರಾಕರಿಸಿದ್ದನು. <verse eid="HEB 11:24"/><verse number="25" style="v" sid="HEB 11:25"/>ಮೋಶೆ ಗತಿಸಿ ಹೋಗುವ ಪಾಪಭೋಗಗಳನ್ನು ಅನುಭವಿಸುವುದಕ್ಕಿಂತ, ದೇವಜನರೊಂದಿಗೆ ಕಷ್ಟ ಅನುಭವಿಸುವುದನ್ನೇ ಆರಿಸಿಕೊಂಡನು. <verse eid="HEB 11:25"/><verse number="26" style="v" sid="HEB 11:26"/>ಈಜಿಪ್ಟಿನ ನಿಕ್ಷೇಪಕ್ಕಿಂತಲೂ ಕ್ರಿಸ್ತ ಯೇಸುವಿಗಾಗಿ ನಿಂದೆಯನ್ನು ಹೊಂದುವುದು ಮಹಾಐಶ್ವರ್ಯವೆಂದೆಣಿಸಿಕೊಂಡನು. ಏಕೆಂದರೆ ಅವನು ತನ್ನ ಬಹುಮಾನಕ್ಕಾಗಿ ಎದುರು ನೋಡಿದನು. <verse eid="HEB 11:26"/><verse number="27" style="v" sid="HEB 11:27"/>ನಂಬಿಕೆಯಿಂದಲೇ ಮೋಶೆ ಅರಸನ ಕೋಪಕ್ಕೆ ಭಯಪಡದೆ ಈಜಿಪ್ಟನ್ನು ಬಿಟ್ಟುಹೋದನು. ಏಕೆಂದರೆ ಅವನು ಕಣ್ಣಿಗೆ ಕಾಣದ ದೇವರನ್ನು ಕಣ್ಣಾರೆ ಕಾಣುತ್ತಿರುವನೋ ಎನ್ನುವಷ್ಟು ದೃಢಚಿತ್ತನಾಗಿದ್ದನು. <verse eid="HEB 11:27"/><verse number="28" style="v" sid="HEB 11:28"/>ಚೊಚ್ಚಲ ಮಕ್ಕಳನ್ನು ಸಂಹರಿಸುವ ದೂತನು ಇಸ್ರಾಯೇಲರ ಚೊಚ್ಚಲ ಮಕ್ಕಳನ್ನು ಮುಟ್ಟದಂತೆ ಮೋಶೆ ನಂಬಿಕೆಯಿಂದಲೇ ಪಸ್ಕವನ್ನೂ ರಕ್ತ ಪ್ರೋಕ್ಷಣೆಯನ್ನೂ ಆಚರಿಸಿದ್ದನು.<verse eid="HEB 11:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="HEB 11:29"/>ನಂಬಿಕೆಯಿಂದಲೇ ಇಸ್ರಾಯೇಲರು ಒಣ ಭೂಮಿಯನ್ನು ದಾಟುವಂತೆ ಕೆಂಪು ಸಮುದ್ರವನ್ನು ದಾಟಿದರು. ಈಜಿಪ್ಟಿನವರು ಅದನ್ನು ದಾಟುವುದಕ್ಕೆ ಪ್ರಯತ್ನಿಸಿ ಮುಳುಗಿ ಹೋದರು.<verse eid="HEB 11:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="HEB 11:30"/>ಇಸ್ರಾಯೇಲರು ಏಳು ದಿವಸಗಳು ಯೆರಿಕೋವಿನ ಗೋಡೆಗಳನ್ನು ಸುತ್ತಿದ ಮೇಲೆ, ಅವು ಬಿದ್ದು ಹೋದದ್ದು ನಂಬಿಕೆಯಿಂದಲೇ.<verse eid="HEB 11:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="HEB 11:31"/>ರಹಾಬಳೆಂಬ ವೇಶ್ಯೆಯು ಗೂಢಚಾರರನ್ನು ಸಮಾಧಾನವಾಗಿ ಸ್ವಾಗತಿಸಿದ್ದರಿಂದ ಅವಿಧೇಯರೊಂದಿಗೆ ನಾಶವಾಗದೆ ಉಳಿದದ್ದು ನಂಬಿಕೆಯಿಂದಲೇ.<verse eid="HEB 11:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="HEB 11:32"/>ಇನ್ನೂ ಏನು ಹೇಳಬೇಕು? ಗಿಡಿಯೋನ್, ಬಾರಾಕ್, ಸಂಸೋನ್, ಎಪ್ತಾಹ, ದಾವೀದ, ಸಮುಯೇಲ ಮತ್ತು ಪ್ರವಾದಿಗಳ ವಿಷಯವಾಗಿ ಹೇಳುವುದಕ್ಕೆ ನನಗೆ ಸಮಯ ಸಾಲದು. <verse eid="HEB 11:32"/><verse number="33" style="v" sid="HEB 11:33"/>ಇವರೆಲ್ಲರೂ ನಂಬಿಕೆಯ ಮೂಲಕವೇ ರಾಜ್ಯಗಳನ್ನು ಸ್ವಾಧೀನಮಾಡಿಕೊಂಡರು. ನೀತಿಯನ್ನು ಸ್ಥಾಪಿಸಿದರು, ವಾಗ್ದಾನಗಳನ್ನು ಪಡೆದುಕೊಂಡರು, ಸಿಂಹಗಳ ಬಾಯಿ ಕಟ್ಟಿದರು, <verse eid="HEB 11:33"/><verse number="34" style="v" sid="HEB 11:34"/>ಬೆಂಕಿಯ ಶಕ್ತಿಯನ್ನು ಆರಿಸಿದರು, ಕತ್ತಿಯ ಬಾಯಿಂದ ತಪ್ಪಿಸಿಕೊಂಡರು, ಬಲಹೀನತೆಯಿಂದ ಬಲಿಷ್ಠರಾದರು, ಯುದ್ಧದಲ್ಲಿ ಪರಾಕ್ರಮಶಾಲಿಗಳಾದರು, ಪರರ ಸೈನ್ಯಗಳನ್ನು ಓಡಿಸಿಬಿಟ್ಟರು, <verse eid="HEB 11:34"/><verse number="35" style="v" sid="HEB 11:35"/>ಸ್ತ್ರೀಯರು ಸತ್ತು ಹೋಗಿದ್ದ ತಮ್ಮವರನ್ನು ಜೀವದಿಂದ ತಿರುಗಿ ಪಡೆದುಕೊಂಡರು. ಆದರೆ ಬೇರೆ ಕೆಲವರು ತಾವು ಯಾತನೆ ಹೊಂದುತ್ತಿರುವಾಗ ಉತ್ತಮ ಪುನರುತ್ಥಾನ ಹೊಂದುವುದಕ್ಕಾಗಿ ತಮಗೆ ಬಿಡುಗಡೆಯನ್ನು ಸ್ವೀಕರಿಸದೆ ಹೋದರು, <verse eid="HEB 11:35"/><verse number="36" style="v" sid="HEB 11:36"/>ಇನ್ನೂ ಬೇರೆ ಕೆಲವರು ಅಪಹಾಸ್ಯ, ಕೊರಡೆಯ ಪೆಟ್ಟು ತಿಂದು ಬೇಡಿ ಸೆರೆವಾಸವನ್ನು ಸಹ ಅನುಭವಿಸಿದರು, <verse eid="HEB 11:36"/><verse number="37" style="v" sid="HEB 11:37"/>ಕೆಲವರ ಮೇಲೆ ಕಲ್ಲೆಸೆದರು, ಕೆಲವರನ್ನು ಗರಗಸದಿಂದ ಎರಡು ಭಾಗವಾಗಿ ಕೊಯ್ದು ಸಾಯಿಸಿದರು, ಕೆಲವರನ್ನು ಶೋಧಿಸಿದರು, ಕೆಲವರನ್ನು ಕತ್ತಿಯಿಂದ ಕೊಂದರು, ಕೆಲವರು ಕೊರತೆ, ಹಿಂಸೆ, ಬಾಧೆ ಇವುಗಳನ್ನು ಅನುಭವಿಸುವವರಾಗಿದ್ದು ಕುರಿಮೇಕೆಗಳ ಚರ್ಮಗಳನ್ನು ಉಟ್ಟುಕೊಂಡವರಾಗಿ <verse eid="HEB 11:37"/><verse number="38" style="v" sid="HEB 11:38"/>ಭೂಮಿಯ ಕಾಡು, ಬೆಟ್ಟ, ಗವಿ, ಕುಣಿಗಳಲ್ಲಿ ಅಲೆಯುವವರಾಗಿದ್ದರು. ಇಂಥವರಿಗೆ ಈ ಲೋಕವು ಯೋಗ್ಯವಾದ ಸ್ಥಳವಲ್ಲ.<verse eid="HEB 11:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="HEB 11:39"/>ಇವರೆಲ್ಲರೂ ತಮ್ಮ ನಂಬಿಕೆಯ ಮೂಲಕ ಒಳ್ಳೆಯ ಸಾಕ್ಷಿಯನ್ನು ಹೊಂದಿದವರಾಗಿದ್ದರೂ ವಾಗ್ದಾನವಾದದ್ದನ್ನು ಹೊಂದಲಿಲ್ಲ. <verse eid="HEB 11:39"/><verse number="40" style="v" sid="HEB 11:40"/>ಏಕೆಂದರೆ ನಮ್ಮೊಂದಿಗೆ ಅವರು ಪರಿಪೂರ್ಣರಾಗಬೇಕೆಂದು ದೇವರು ನಮಗೋಸ್ಕರ ಉತ್ತಮವಾದದ್ದನ್ನು ಸಂಕಲ್ಪಿಸಿದ್ದಾರೆ.<verse eid="HEB 11:40"/></para>
  <chapter eid="HEB 11"/>
  <chapter number="12" style="c" sid="HEB 12"/>
  <para style="p">
    <verse number="1" style="v" sid="HEB 12:1"/>ಆದಕಾರಣ ಸಾಕ್ಷಿಗಳು ದೊಡ್ಡ ಮೇಘದಂತೆ ನಮ್ಮ ಸುತ್ತಲೂ ಇರುವುದರಿಂದ ಎಲ್ಲಾ ಭಾರವನ್ನೂ ಸುಲಭವಾಗಿ ಮುತ್ತಿಕೊಳ್ಳುವ ಪಾಪವನ್ನೂ ನಾವು ಎಸೆದುಬಿಟ್ಟು, <verse eid="HEB 12:1"/><verse number="2" style="v" sid="HEB 12:2"/>ನಮ್ಮಲ್ಲಿ ನಂಬಿಕೆಯನ್ನು ಹುಟ್ಟಿಸುವವರೂ ಅದನ್ನು ಪರಿಪೂರ್ಣಗೊಳಿಸುವವರೂ ಆಗಿರುವ ಯೇಸುವಿನ ಮೇಲೆ ದೃಷ್ಟಿಯಿಟ್ಟು, ನಮ್ಮ ಮುಂದೆ ಇಟ್ಟಿರುವ ಓಟವನ್ನು ಸಹನೆಯಿಂದ ಓಡೋಣ. ಯೇಸು ತಮ್ಮ ಮುಂದೆ ಇಟ್ಟಿದ್ದ ಸಂತೋಷಕ್ಕಾಗಿ ಶಿಲುಬೆಯನ್ನು ಸಹಿಸಿಕೊಂಡು ಅವಮಾನವನ್ನು ಅಲಕ್ಷ್ಯಮಾಡಿ, ಈಗ ದೇವರ ಸಿಂಹಾಸನದ ಬಲಗಡೆಯಲ್ಲಿ ಆಸೀನರಾಗಿದ್ದಾರೆ. <verse eid="HEB 12:2"/><verse number="3" style="v" sid="HEB 12:3"/>ನೀವು ಮನಗುಂದಿದವರಾಗಿ ಬೇಸರಗೊಳ್ಳದಂತೆ ಪಾಪಿಗಳಿಂದ ಎಷ್ಟೋ ವಿರೋಧವನ್ನು ಸಹಿಸಿಕೊಂಡ ಯೇಸುವನ್ನು ಕುರಿತು ನೀವು ಯೋಚಿಸಿರಿ.<verse eid="HEB 12:3"/></para>
  <para style="s1">ದೇವರು ತಮ್ಮ ಪುತ್ರರನ್ನು ಶಿಕ್ಷಿಸುತ್ತಾರೆ</para>
  <para style="p">
    <verse number="4" style="v" sid="HEB 12:4"/>ನೀವು ಪಾಪಕ್ಕೆ ವಿರೋಧವಾಗಿ ಹೋರಾಡುವುದರಲ್ಲಿ, ಇನ್ನೂ ರಕ್ತವನ್ನು ಸುರಿಸುವಷ್ಟು ಅದನ್ನು ಎದುರಿಸಲಿಲ್ಲ. <verse eid="HEB 12:4"/><verse number="5" style="v" sid="HEB 12:5"/>ಒಬ್ಬ ತಂದೆ ಮಕ್ಕಳಾಗಿರುವ ನಿಮಗೆ ಎಚ್ಚರಿಸಲಾದ ಮಾತನ್ನು ನೀವು ಮರೆತಿದ್ದೀರಿ. ಅದು,</para>
  <para style="q1" vid="HEB 12:5">“ನನ್ನ ಮಗನೇ, ಕರ್ತದೇವರ ಶಿಕ್ಷೆಯನ್ನು ಹಗುರವಾಗಿ ಎಣಿಸಬೇಡ.</para>
  <para style="q2" vid="HEB 12:5">ಅವರು ನಿನ್ನನ್ನು ಗದರಿಸುವಾಗ ಬೇಸರಗೊಳ್ಳಬೇಡ.<verse eid="HEB 12:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="HEB 12:6"/>ಏಕೆಂದರೆ, ಕರ್ತದೇವರು ಯಾರನ್ನು ಪ್ರೀತಿಸುತ್ತಾರೋ ಅವರನ್ನು ಶಿಕ್ಷಿಸುತ್ತಾರೆ.</para>
  <para style="q2" vid="HEB 12:6">ತಾವು ಸ್ವೀಕರಿಸುವ ಪ್ರತಿಯೊಬ್ಬ ಮಗನನ್ನು ಹೊಡೆಯುತ್ತಾರೆ!”<note caller="+" style="f"><char style="fr" closed="false">12:6 </char><char style="ft" closed="false"><char style="xt"><ref loc="PRO 3:11">ಜ್ಞಾನೋಕ್ತಿ 3:11</ref>,<ref loc="PRO 3:12">12</ref></char></char></note></para>
  <para style="m" vid="HEB 12:6">ಎಂಬುದಾಗಿದೆ.<verse eid="HEB 12:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="HEB 12:7"/>ಶಿಸ್ತಿಗಾಗಿ ಕಷ್ಟವನ್ನು ನೀವು ಸಹಿಸಿಕೊಳ್ಳಬೇಕು. ದೇವರು ನಿಮ್ಮನ್ನು ಮಕ್ಕಳೆಂದು ನಡೆಸಿಕೊಳ್ಳುತ್ತಾರೆ. ಏಕೆಂದರೆ ತಂದೆಯಿಂದ ಶಿಸ್ತುಹೊಂದದ ಮಕ್ಕಳೆಲ್ಲಿ? <verse eid="HEB 12:7"/><verse number="8" style="v" sid="HEB 12:8"/>ನೀವು ಶಿಕ್ಷೆ ಹೊಂದುವವರೆಲ್ಲರೊಂದಿಗೆ ಪಾಲುಗಾರರಾಗಿರದಿದ್ದರೆ, ನೀವು ಅಕ್ರಮವಾಗಿ ಹುಟ್ಟಿದ ಮಕ್ಕಳೇ ಹೊರತು ನಿಜ ಮಕ್ಕಳಲ್ಲ. <verse eid="HEB 12:8"/><verse number="9" style="v" sid="HEB 12:9"/>ಇದು ಮಾತ್ರವಲ್ಲದೆ, ನಮ್ಮನ್ನು ಶಿಕ್ಷಿಸಿದ ಇಹಲೋಕದ ಶಾರೀರಿಕ ತಂದೆಗಳನ್ನು ನಾವು ಸನ್ಮಾನಿಸಿದೆವಷ್ಟೆ. ಆತ್ಮಗಳಿಗೆ ತಂದೆಯಾದ ದೇವರಿಗೆ ನಾವು ಇನ್ನೂ ಎಷ್ಟೋ ಹೆಚ್ಚಾಗಿ ಅಧೀನರಾಗಿ ಜೀವಿಸಬೇಕಲ್ಲವೇ? <verse eid="HEB 12:9"/><verse number="10" style="v" sid="HEB 12:10"/>ನಮ್ಮ ತಂದೆಯಾದವರು ತಮಗೆ ಒಳ್ಳೆಯದೆಂದು ತಿಳಿದಾಗ, ಸ್ವಲ್ಪಕಾಲ ನಮ್ಮನ್ನು ಶಿಕ್ಷಿಸಿದರು. ಆದರೆ ದೇವರು ತಮ್ಮ ಪವಿತ್ರತೆಯಲ್ಲಿ ನಾವು ಪಾಲುಗಾರರಾಗಬೇಕೆಂದು ನಮ್ಮ ಒಳ್ಳೆಯದಕ್ಕಾಗಿಯೇ ಶಿಕ್ಷಿಸುತ್ತಾರೆ. <verse eid="HEB 12:10"/><verse number="11" style="v" sid="HEB 12:11"/>ಯಾವ ಶಿಕ್ಷೆಯಾದರೂ ಆ ಸಮಯಕ್ಕೆ ಸಂತೋಷಕರವಾಗಿ ತೋಚದೆ, ದುಃಖಕರವಾಗಿ ತೋಚುತ್ತದೆ. ತರುವಾಯ, ಅದು ಶಿಕ್ಷೆ ಹೊಂದಿದವರಿಗೆ ಸಮಾಧಾನವುಳ್ಳ ನೀತಿಯ ಫಲವನ್ನು ಕೊಡುತ್ತದೆ.<verse eid="HEB 12:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="HEB 12:12"/>ಆದ್ದರಿಂದ, ಜೋತು ಬಿದ್ದ ಕೈಗಳನ್ನೂ ಬಲಹೀನವಾದ ಮೊಣಕಾಲುಗಳನ್ನೂ ಬಲಪಡಿಸಿರಿ. <verse eid="HEB 12:12"/><verse number="13" style="v" sid="HEB 12:13"/>“ನಿಮ್ಮ ಪಾದಗಳಿಗೆ ನೇರವಾದ ದಾರಿಯನ್ನು ಮಾಡಿರಿ.”<note caller="+" style="f"><char style="fr" closed="false">12:13 </char><char style="ft" closed="false"><char style="xt"><ref loc="PRO 4:26">ಜ್ಞಾನೋಕ್ತಿ 4:26</ref></char></char></note> ಹೀಗೆ ಮಾಡಿದರೆ ಕುಂಟ ಕಾಲು ಉಳುಕಿಹೋಗದೆ ವಾಸಿಯಾಗುವುದು.<verse eid="HEB 12:13"/></para>
  <para style="s1">ದೇವರನ್ನು ತಿರಸ್ಕರಿಸುವುದರ ವಿರುದ್ಧ ಎಚ್ಚರಿಕೆ</para>
  <para style="p">
    <verse number="14" style="v" sid="HEB 12:14"/>ಎಲ್ಲರ ಸಂಗಡ ಸಮಾಧಾನದಿಂದ ಜೀವಿಸಲು ಮತ್ತು ಪವಿತ್ರರಾಗಿರಲು ಸರ್ವಪ್ರಯತ್ನ ಮಾಡಿರಿ. ಪರಿಶುದ್ಧತೆಯಿಲ್ಲದೆ ಯಾರೂ ದೇವರನ್ನು ಕಾಣುವುದಿಲ್ಲ. <verse eid="HEB 12:14"/><verse number="15" style="v" sid="HEB 12:15"/>ನಿಮ್ಮಲ್ಲಿ ಯಾರೂ ದೇವರ ಕೃಪೆಗೆ ತಪ್ಪಿಹೋಗದಂತೆಯೂ ಯಾವ ವಿಷವುಳ್ಳ ಬೇರೂ ನಿಮ್ಮಲ್ಲಿ ಚಿಗುರಿ ಅಸಮಾಧಾನವನ್ನು ಹುಟ್ಟಿಸಿ ಅದರಿಂದ ಅನೇಕರು ಮಲಿನರಾಗದಂತೆಯೂ <verse eid="HEB 12:15"/><verse number="16" style="v" sid="HEB 12:16"/>ಯಾವ ಕಾಮುಕರಾಗಲಿ, ಏಸಾವನಂಥ ಪ್ರಾಪಂಚಿಕರಾಗಲಿ ನಿಮ್ಮಲ್ಲಿ ಇರದಂತೆಯೂ ಜಾಗ್ರತೆಯಿಂದ ನೋಡಿಕೊಳ್ಳಿರಿ. ಅವನು ಒಂದು ತುತ್ತು ಅನ್ನಕ್ಕಾಗಿ ತನ್ನ ಚೊಚ್ಚಲುತನದ ಹಕ್ಕನ್ನು ಮಾರಿಬಿಟ್ಟನು. <verse eid="HEB 12:16"/><verse number="17" style="v" sid="HEB 12:17"/>ತರುವಾಯ ಅವನು ಆಶೀರ್ವಾದವನ್ನು ಬಾಧ್ಯವಾಗಿ ಹೊಂದಬೇಕೆಂದು ಬಯಸಿ, ಕಣ್ಣೀರನ್ನು ಸುರಿಸುತ್ತಾ ಬೇಡಿಕೊಂಡರೂ ಪಶ್ಚಾತ್ತಾಪಕ್ಕೆ ಮಾರ್ಗವಿಲ್ಲದೆ ನಿರಾಕರಿಸಲಾದವನೆಂದು ನೀವು ಬಲ್ಲಿರಿ.<verse eid="HEB 12:17"/></para>
  <para style="s1">ಭಯದ ಪರ್ವತವೂ ಆನಂದದ ಪರ್ವತವೂ</para>
  <para style="p">
    <verse number="18" style="v" sid="HEB 12:18"/>ನೀವು ಮುಟ್ಟಬಹುದಾದ ಮತ್ತು ಬೆಂಕಿಹತ್ತಿದಂಥ ಬೆಟ್ಟಕ್ಕೂ ಮಬ್ಬಿಗೂ ಕತ್ತಲೆಗೂ ಬಿರುಗಾಳಿಗೂ <verse eid="HEB 12:18"/><verse number="19" style="v" sid="HEB 12:19"/>ತುತೂರಿಯ ಧ್ವನಿಗೂ ಮಾತುಗಳ ಶಬ್ದಕ್ಕೂ ಬಂದವರಲ್ಲ. ಆ ಶಬ್ದವನ್ನು ಕೇಳಿದವರು, ತಮಗೆ ಇನ್ನು ಒಂದು ಮಾತನ್ನಾದರೂ ಹೇಳಬಾರದೆಂದು ಬೇಡಿಕೊಂಡರು. <verse eid="HEB 12:19"/><verse number="20" style="v" sid="HEB 12:20"/>ಏಕೆಂದರೆ, “ಯಾವ ಮೃಗವಾದರೂ ಬೆಟ್ಟವನ್ನು ಮುಟ್ಟಿದರೆ, ಅದನ್ನು ಕಲ್ಲೆಸೆದು ಕೊಲ್ಲಬೇಕು, ಇಲ್ಲವೆ ಈಟಿಯಿಂದ ತಿವಿಯಬೇಕು,”<note caller="+" style="f"><char style="fr" closed="false">12:20 </char><char style="ft" closed="false"><char style="xt"><ref loc="EXO 19:12">ವಿಮೋ 19:12</ref>,<ref loc="EXO 19:13">13</ref></char></char></note> ಎಂದು ಆಜ್ಞಾಪಿಸಿದ್ದನ್ನು ಅವರು ತಾಳಲಾರದೆ ಹೋದರು. <verse eid="HEB 12:20"/><verse number="21" style="v" sid="HEB 12:21"/>ಇದಲ್ಲದೆ ಆ ದೃಶ್ಯವು ಎಷ್ಟೋ ಭಯಂಕರವಾದದ್ದರಿಂದ ಮೋಶೆಯು, “ನಾನು ಭಯದಿಂದಲೂ ನಡುಕದಿಂದಲೂ ತುಂಬಿದವನಾಗಿದ್ದೇನೆ!”<note caller="+" style="f"><char style="fr" closed="false">12:21 </char><char style="ft" closed="false"><char style="xt"><ref loc="DEU 9:19">ಧರ್ಮೋ 9:19</ref></char></char></note> ಎಂದು ಹೇಳಿದನು.<verse eid="HEB 12:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="HEB 12:22"/>ಆದರೆ ನೀವು ಚೀಯೋನ್ ಪರ್ವತಕ್ಕೂ ಜೀವವುಳ್ಳ ದೇವರ ಪಟ್ಟಣವಾಗಿರುವ ಪರಲೋಕದ ಯೆರೂಸಲೇಮಿಗೂ ಆನಂದಭರಿತ ಅಸಂಖ್ಯಾತ ದೇವದೂತಗಣಗಳ ಬಳಿಗೂ <verse eid="HEB 12:22"/><verse number="23" style="v" sid="HEB 12:23"/>ಪರಲೋಕದಲ್ಲಿ ಹೆಸರು ದಾಖಲಾಗಿರುವ ಮಂಡಳಿಗೂ ಚೊಚ್ಚಲ ಮಕ್ಕಳ ಸಭೆಗೂ ಎಲ್ಲರಿಗೂ ನ್ಯಾಯಾಧಿಪತಿಯಾಗಿರುವ ದೇವರ ಬಳಿಗೂ ಪರಿಪೂರ್ಣವಾಗಿರುವ ನೀತಿವಂತರ ಆತ್ಮಗಳ ಬಳಿಗೂ <verse eid="HEB 12:23"/><verse number="24" style="v" sid="HEB 12:24"/>ಹೊಸ ಒಡಂಬಡಿಕೆಗೆ ಮಧ್ಯಸ್ಥರಾಗಿರುವ ಯೇಸುವಿನ ಬಳಿಗೂ ಹೇಬೆಲನ ರಕ್ತಕ್ಕಿಂತ ಉತ್ತಮವಾಗಿ ಮಾತನಾಡುವ, ಪ್ರೋಕ್ಷಿಸಿದ ರಕ್ತದ ಬಳಿಗೂ ಬಂದಿದ್ದೀರಿ.<verse eid="HEB 12:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="HEB 12:25"/>ಮಾತನಾಡುವ ದೇವರನ್ನು ನೀವು ಅಸಡ್ಡೆ ಮಾಡದಂತೆ ನೋಡಿಕೊಳ್ಳಿರಿ. ಏಕೆಂದರೆ ಭೂಮಿಯ ಮೇಲೆ ಎಚ್ಚರಿಸಿದವರನ್ನು ಅಸಡ್ಡೆ ಮಾಡಿದ್ದಕ್ಕೆ ಅವರು ತಪ್ಪಿಸಿಕೊಳ್ಳದಿದ್ದರೆ, ಪರಲೋಕದಿಂದ ಎಚ್ಚರಿಸುವ ದೇವರಿಂದ ನಾವು ತೊಲಗಿ ಹೋದರೆ, ಹೇಗೆ ತಾನೆ ದಂಡನೆಯಿಂದ ನಾವು ತಪ್ಪಿಸಿಕೊಳ್ಳಬಲ್ಲೆವು? <verse eid="HEB 12:25"/><verse number="26" style="v" sid="HEB 12:26"/>ಆ ಕಾಲದಲ್ಲಿ ದೇವರ ಧ್ವನಿಯು ಭೂಮಿಯನ್ನು ಕದಲಿಸಿತು. ಈಗಲಾದರೋ, “ಇನ್ನೊಂದು ಸಾರಿ ನಾನು ಭೂಮಿಯನ್ನು ಮಾತ್ರವಲ್ಲದೆ ಪರಲೋಕವನ್ನೂ ಕದಲಿಸುತ್ತೇನೆ!”<note caller="+" style="f"><char style="fr" closed="false">12:26 </char><char style="ft" closed="false"><char style="xt"><ref loc="HAG 2:6">ಹಗ್ಗಾ 2:6</ref></char></char></note> ಎಂದು ದೇವರು ವಾಗ್ದಾನಮಾಡಿದ್ದಾರೆ. <verse eid="HEB 12:26"/><verse number="27" style="v" sid="HEB 12:27"/>“ಇನ್ನೂ ಒಂದು ಸಾರಿ,” ಎಂಬ ಮಾತು ನಿರ್ಮಿತವಾಗಿರುವ ಕದಲುವ ವಸ್ತುಗಳು ತೆಗೆದುಹಾಕಲಾಗುವುದು ಎಂದೂ ಕದಲಿಸದೆ ಇರುವ ವಸ್ತುಗಳು ಸ್ಥಿರವಾಗಿರುವುದು ಎಂಬುದನ್ನು ಸೂಚಿಸುತ್ತದೆ.<verse eid="HEB 12:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="HEB 12:28"/>ಆದಕಾರಣ ಯಾರೂ ಕದಲಿಸಲಾರದ ರಾಜ್ಯವನ್ನು, ಸ್ವೀಕರಿಸುವವರಾಗಿದ್ದುದರಿಂದ ನಾವು ಕೃತಜ್ಞತೆಯಿಂದ ಇರೋಣ. ನಾವು ದೇವರಿಗೆ ಭಯಭಕ್ತಿಯಿಂದ ಕೂಡಿದ ಮೆಚ್ಚಿಕೆಯುಳ್ಳ ಸೇವೆಯನ್ನು ಸಲ್ಲಿಸುವಂತೆ ಕೃತಜ್ಞತೆಯನ್ನು ತೋರಿಸುವವರಾಗಿರೋಣ. <verse eid="HEB 12:28"/><verse number="29" style="v" sid="HEB 12:29"/>ಏಕೆಂದರೆ ನಮ್ಮ, “ದೇವರು ದಹಿಸುವ ಅಗ್ನಿಯಾಗಿದ್ದಾರೆ.”<note caller="+" style="f"><char style="fr" closed="false">12:29 </char><char style="ft" closed="false"><char style="xt"><ref loc="DEU 4:24">ಧರ್ಮೋ 4:24</ref></char></char></note><verse eid="HEB 12:29"/></para>
  <chapter eid="HEB 12"/>
  <chapter number="13" style="c" sid="HEB 13"/>
  <para style="s1">ಮುಕ್ತಾಯದ ಪ್ರಬೋಧನೆಗಳು</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 13:1"/>ಪ್ರಿಯರೇ, ಒಬ್ಬರಿಗೊಬ್ಬರು ಪ್ರೀತಿಯಲ್ಲಿ ಮುಂದುವರೆಯಿರಿ. <verse eid="HEB 13:1"/><verse number="2" style="v" sid="HEB 13:2"/>ಪರಕೀಯರಿಗೆ ಸತ್ಕಾರ ಮಾಡುವುದನ್ನು ಅಲಕ್ಷ್ಯ ಮಾಡಬೇಡಿರಿ. ಏಕೆಂದರೆ ಅದನ್ನು ಮಾಡುವುದರ ಮೂಲಕ, ಕೆಲವರು ತಿಳಿಯದೆ ದೇವದೂತರನ್ನೂ ಸತ್ಕರಿಸಿದ್ದಾರೆ. <verse eid="HEB 13:2"/><verse number="3" style="v" sid="HEB 13:3"/>ಸೆರೆಯವರ ಸಂಗಡ ನೀವೂ ಜೊತೆಸೆರೆಯವರೆಂಬಂತೆ ಅವರನ್ನು ಜ್ಞಾಪಕಮಾಡಿಕೊಳ್ಳಿರಿ. ಕಷ್ಟ ಅನುಭವಿಸುವವರ ಸಂಗಡ ನೀವು ಸಹ ಕಷ್ಟ ಅನುಭವಿಸುವವರೆಂಬಂತೆ ನೆನೆಸಿರಿ.<verse eid="HEB 13:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="HEB 13:4"/>ಎಲ್ಲರೂ ವಿವಾಹವನ್ನು ಗೌರವಿಸಬೇಕು ಮತ್ತು ದಾಂಪತ್ಯ ಜೀವನವು ಪರಿಶುದ್ಧವಾದದ್ದಾಗಿರಬೇಕು. ಏಕೆಂದರೆ ಜಾರರಿಗೂ ವ್ಯಭಿಚಾರಿಗಳಿಗೂ ದೇವರು ನ್ಯಾಯತೀರಿಸುವರು. <verse eid="HEB 13:4"/><verse number="5" style="v" sid="HEB 13:5"/>ಹಣದಾಶೆಯಿಂದ ನಿಮ್ಮ ಜೀವನ ದೂರವಾಗಿರಲಿ, ನಿಮಗಿರುವವುಗಳಲ್ಲಿ ತೃಪ್ತರಾಗಿರಿ. ಏಕೆಂದರೆ ದೇವರು ಹೀಗೆ ಹೇಳಿದ್ದಾರೆ,</para>
  <para style="q1" vid="HEB 13:5">“ನಾನು ನಿನ್ನನ್ನು ಎಂದಿಗೂ ಕೈಬಿಡುವುದಿಲ್ಲ,</para>
  <para style="q2" vid="HEB 13:5">ಎಂದಿಗೂ ತೊರೆಯುವುದಿಲ್ಲ!”<note caller="+" style="f"><char style="fr" closed="false">13:5 </char><char style="ft" closed="false"><char style="xt"><ref loc="DEU 31:6">ಧರ್ಮೋ 31:6</ref></char></char></note><verse eid="HEB 13:5"/></para>
  <para style="m">
    <verse number="6" style="v" sid="HEB 13:6"/>ಆದ್ದರಿಂದ,</para>
  <para style="q1" vid="HEB 13:6">“ಕರ್ತದೇವರು ನನ್ನ ಸಹಾಯಕರು, ನಾನು ಭಯಪಡೆನು.</para>
  <para style="q2" vid="HEB 13:6">ಮನುಷ್ಯನು ನನಗೆ ಏನು ಮಾಡಬಲ್ಲನು?”<note caller="+" style="f"><char style="fr" closed="false">13:6 </char><char style="ft" closed="false"><char style="xt"><ref loc="PSA 118:6">ಕೀರ್ತನೆ 118:6</ref>,<ref loc="PSA 118:7">7</ref></char></char></note></para>
  <para style="m" vid="HEB 13:6">ಎಂದು ನಾವು ಧೈರ್ಯವಾಗಿ ಹೇಳುವೆವು.<verse eid="HEB 13:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="HEB 13:7"/>ನಿಮಗೆ ದೇವರ ವಾಕ್ಯವನ್ನು ತಿಳಿಸಿ, ನಿಮ್ಮನ್ನು ನಡೆಸಿದ ನಿಮ್ಮ ಪಾಲಕರನ್ನು ಜ್ಞಾಪಕಮಾಡಿಕೊಳ್ಳಿರಿ. ಅವರು ಜೀವಿಸಿದ ದಾರಿಯ ಅಂತ್ಯ ಫಲವನ್ನು ಆಲೋಚಿಸಿ, ಅವರ ನಂಬಿಕೆಯನ್ನು ಅನುಸರಿಸಿರಿ. <verse eid="HEB 13:7"/><verse number="8" style="v" sid="HEB 13:8"/>ಕ್ರಿಸ್ತ ಯೇಸುವು ನಿನ್ನೆ ಇದ್ದ ಹಾಗೆ ಈ ಹೊತ್ತೂ ಇದ್ದಾರೆ, ನಿರಂತರವೂ ಹಾಗೆಯೇ ಇರುವರು.<verse eid="HEB 13:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="HEB 13:9"/>ವಿಚಿತ್ರವಾದ ವಿವಿಧ ಬೋಧನೆಗಳ ಸೆಳೆತಕ್ಕೆ ಸಿಲುಕದಿರಿ. ಏಕೆಂದರೆ ಕೃಪೆಯ ಮೂಲಕ ಹೃದಯವನ್ನು ಬಲಪಡಿಸಿಕೊಳ್ಳುವುದು ಒಳ್ಳೆಯದು. ಭೋಜನ ಪದಾರ್ಥಗಳಲ್ಲಿ ಮಗ್ನರಾದವರು, ಅವುಗಳಿಂದ ಏನೂ ಪ್ರಯೋಜನ ಹೊಂದಲಿಲ್ಲ. <verse eid="HEB 13:9"/><verse number="10" style="v" sid="HEB 13:10"/>ನಮಗೊಂದು ಬಲಿಪೀಠ ಉಂಟು. ಅದರ ಪದಾರ್ಥವನ್ನು ತಿನ್ನುವುದಕ್ಕೆ ಗುಡಾರದ ಸೇವೆ ಮಾಡುವವರಿಗೆ ಹಕ್ಕಿಲ್ಲ.<verse eid="HEB 13:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="HEB 13:11"/>ಮಹಾಯಾಜಕನು ಪಾಪದ ನಿಮಿತ್ತವಾಗಿ ಪಶುಗಳ ರಕ್ತವನ್ನು ತೆಗೆದುಕೊಂಡು ಮಹಾ ಪವಿತ್ರ ಸ್ಥಳದೊಳಗೆ ಹೋದ ಮೇಲೆ, ಆ ಪಶುಗಳ ದೇಹಗಳು ಪಾಳೆಯದ ಆಚೆ ಸುಟ್ಟು ಬಿಡಲಾಗುತ್ತವಲ್ಲಾ. <verse eid="HEB 13:11"/><verse number="12" style="v" sid="HEB 13:12"/>ಅದರಂತೆ ಯೇಸು ಸಹ ತಮ್ಮ ಸ್ವಂತ ರಕ್ತದಿಂದ ಜನರನ್ನು ಪವಿತ್ರಪಡಿಸುವುದಕ್ಕೋಸ್ಕರ ಊರ ಹೊರಗೆ ಬಾಧೆಪಟ್ಟರು. <verse eid="HEB 13:12"/><verse number="13" style="v" sid="HEB 13:13"/>ಆದ್ದರಿಂದ ನಾವು ಯೇಸು ಹೇಗೆ ನಿಂದನೆಯನ್ನು ಹೊತ್ತುಕೊಂಡರೋ ಹಾಗೆ ಹೊತ್ತು ಪಾಳೆಯದ ಆಚೆ ಅವರ ಬಳಿಗೆ ಹೊರಟು ಹೋಗೋಣ. <verse eid="HEB 13:13"/><verse number="14" style="v" sid="HEB 13:14"/>ಏಕೆಂದರೆ ಶಾಶ್ವತವಾದ ಪಟ್ಟಣವು ಇಲ್ಲಿ ನಮಗಿಲ್ಲ. ಮುಂದೆ ಬರುವ ಪಟ್ಟಣವನ್ನು ಹುಡುಕುತ್ತಾ ಇದ್ದೇವೆ.<verse eid="HEB 13:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="HEB 13:15"/>ಆದ್ದರಿಂದ ಯೇಸುವಿನ ಮೂಲಕವಾಗಿಯೇ ದೇವರಿಗೆ ಸ್ತೋತ್ರದ ಯಜ್ಞವನ್ನು ಎಡೆಬಿಡದೆ ಸಮರ್ಪಿಸೋಣ. ಅದು ದೇವರ ಹೆಸರಿಗೆ ಸಲ್ಲಿಸುವ ಕೃತಜ್ಞತೆಯೆಂಬ ತುಟಿಗಳ ಫಲವೇ ಆಗಿದೆ. <verse eid="HEB 13:15"/><verse number="16" style="v" sid="HEB 13:16"/>ಇದಲ್ಲದೆ ಒಳ್ಳೆಯದನ್ನು ಮಾಡುವುದನ್ನೂ ಪರರೊಡನೆ ಹಂಚಿಕೊಳ್ಳುವುದನ್ನೂ ಮರೆಯಬೇಡಿರಿ. ಏಕೆಂದರೆ ಇಂಥಾ ಯಜ್ಞಗಳನ್ನು ದೇವರು ಮೆಚ್ಚುತ್ತಾರೆ.<verse eid="HEB 13:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="HEB 13:17"/>ನಿಮ್ಮ ನಾಯಕರಿಗೆ ವಿಧೇಯರಾಗಿದ್ದು, ಅವರಿಗೆ ಅಧೀನರಾಗಿರಿ. ಏಕೆಂದರೆ ಅವರು ಲೆಕ್ಕ ಒಪ್ಪಿಸಬೇಕಾದವರಾಗಿ ನಿಮ್ಮ ಆತ್ಮಗಳನ್ನು ಕಾಯುವವರಾಗಿದ್ದಾರೆ. ಅವರು ಮನನೊಂದವರಾಗದೆ ಸಂತೋಷದಿಂದ ಇದನ್ನು ಮಾಡುವವರಾಗಲಿ. ಏಕೆಂದರೆ ಅವರು ಮನನೊಂದವರಾಗಿರುವುದು ನಿಮಗೆ ಪ್ರಯೋಜನಕರವಾದದ್ದಲ್ಲ.<verse eid="HEB 13:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="HEB 13:18"/>ನಮಗೋಸ್ಕರ ಪ್ರಾರ್ಥಿಸಿರಿ. ನಾವು ಎಲ್ಲಾ ವಿಷಯಗಳಲ್ಲಿ ಶುದ್ಧಮನಸ್ಸಾಕ್ಷಿಯಿಂದ ಪ್ರತಿಯೊಂದರಲ್ಲಿಯೂ ಪ್ರಾಮಾಣಿಕವಾಗಿ ಇರಲು ಬಯಸುತ್ತೇವೆ. <verse eid="HEB 13:18"/><verse number="19" style="v" sid="HEB 13:19"/>ನೀವು ಪ್ರಾರ್ಥನೆ ಮಾಡುವಂತೆ, ನಾನು ನಿಮ್ಮನ್ನು ಬಹು ವಿಶೇಷವಾಗಿ ಬೇಡಿಕೊಳ್ಳುತ್ತೇನೆ. ಇದರ ಮೂಲಕ ನಾನು ಅತಿ ಶೀಘ್ರವಾಗಿ ನಿಮ್ಮ ಬಳಿಗೆ ಪುನಃ ಬರುವೆನು.<verse eid="HEB 13:19"/></para>
  <para style="s1">ಅಂತ್ಯಾಶೀರ್ವಾದ ಹಾಗೂ ಅಂತಿಮ ವಂದನೆಗಳು</para>
  <para style="p">
    <verse number="20" style="v" sid="HEB 13:20"/>ಕುರಿ ಹಿಂಡಿಗೆ ಮಹಾಕುರುಬ ಆಗಿರುವ ನಮ್ಮ ಕರ್ತ ಯೇಸುವನ್ನು ನಿತ್ಯಒಡಂಬಡಿಕೆಯ ರಕ್ತದ ಮೂಲಕ ಸಮಾಧಾನದ ದೇವರು ಸತ್ತವರೊಳಗಿಂದ ಜೀವಂತವಾಗಿ ಬರಮಾಡಿದರು. <verse eid="HEB 13:20"/><verse number="21" style="v" sid="HEB 13:21"/>ನೀವು ದೇವರ ಚಿತ್ತಾನುಸಾರವಾಗಿ ಎಲ್ಲವನ್ನೂ ಮಾಡುವಂತೆ ನಿಮ್ಮನ್ನು ಸನ್ನದ್ಧರಾಗಿ ಮಾಡಲಿ. ಕ್ರಿಸ್ತ ಯೇಸುವಿನ ಶಕ್ತಿಯ ಮೂಲಕವಾಗಿ ಪ್ರತಿಯೊಂದು ಸತ್ಕಾರ್ಯಗಳನ್ನು ತಮಗೆ ಮೆಚ್ಚಿಕೆಯಾಗುವಂತೆ ನಿಮ್ಮ ಮೂಲಕವಾಗಿ ನೆರವೇರಿಸಲಿ. ಯುಗಯುಗಾಂತರಗಳಲ್ಲಿಯೂ ಯೇಸುವಿಗೆ ಮಹಿಮೆ ಉಂಟಾಗಲಿ. ಆಮೆನ್.<verse eid="HEB 13:21"/></para>
  <para style="b"/>
  <para style="b"/>
  <para style="p">
    <verse number="22" style="v" sid="HEB 13:22"/>ಪ್ರಿಯರೇ, ಈ ಪ್ರಬೋಧನೆಗಳನ್ನು ಸಹಿಸಿಕೊಳ್ಳಬೇಕೆಂದು ನಿಮ್ಮನ್ನು ಬೇಡಿಕೊಳ್ಳುವ ಹಾಗೆ ಸಂಕ್ಷೇಪವಾಗಿ ನಾನು ಈ ಪತ್ರವನ್ನು ಬರೆದಿದ್ದೇನೆ.<verse eid="HEB 13:22"/></para>
  <para style="b"/>
  <para style="p">
    <verse number="23" style="v" sid="HEB 13:23"/>ನಮ್ಮ ಸಹೋದರನಾದ ತಿಮೊಥೆಯನಿಗೆ ಬಿಡುಗಡೆಯಾಯಿತೆಂಬುದು ನಿಮಗೆ ತಿಳಿದಿರಲಿ. ಅವನು ಬೇಗ ಬಂದರೆ ನಾನು ಅವನೊಂದಿಗೆ ಬಂದು ನಿಮ್ಮನ್ನು ಕಾಣುವೆನು.<verse eid="HEB 13:23"/></para>
  <para style="b"/>
  <para style="p">
    <verse number="24" style="v" sid="HEB 13:24"/>ನಿಮ್ಮ ಎಲ್ಲಾ ನಾಯಕರಿಗೆ, ದೇವಜನರಿಗೆ ವಂದನೆಗಳು.</para>
  <para style="p" vid="HEB 13:24">ಇಟಲಿಯವರು ನಿಮ್ಮನ್ನು ವಂದಿಸುತ್ತಾರೆ.<verse eid="HEB 13:24"/></para>
  <para style="b"/>
  <para style="p">
    <verse number="25" style="v" sid="HEB 13:25"/>ಕೃಪೆಯು ನಿಮ್ಮೆಲ್ಲರೊಂದಿಗೆ ಇರಲಿ!<verse eid="HEB 13:25"/></para>
  <chapter eid="HEB 13"/>
</usx>
