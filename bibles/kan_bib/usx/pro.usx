<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="PRO" style="id">- Biblica® Open Kannada Contemporary Version</book>
  <para style="h">ಜ್ಞಾನೋಕ್ತಿಗಳು</para>
  <para style="toc1">ಜ್ಞಾನೋಕ್ತಿಗಳು</para>
  <para style="toc2">ಜ್ಞಾನೋಕ್ತಿಗಳು</para>
  <para style="toc3">ಜ್ಞಾನೋಕ್ತಿ</para>
  <para style="mt1">ಜ್ಞಾನೋಕ್ತಿಗಳು</para>
  <chapter number="1" style="c" sid="PRO 1"/>
  <para style="ms1">ಜ್ಞಾನೋಕ್ತಿಗಳು</para>
  <para style="p">
    <verse number="1" style="v" sid="PRO 1:1"/>ಇಸ್ರಾಯೇಲರ ಅರಸನೂ ದಾವೀದನ ಮಗನೂ ಆದ ಸೊಲೊಮೋನನ ಜ್ಞಾನೋಕ್ತಿಗಳು:<verse eid="PRO 1:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 1:2"/>ಜನರು ಜ್ಞಾನವನ್ನೂ ಶಿಸ್ತನ್ನೂ ಪಡೆದುಕೊಳ್ಳುವುದಕ್ಕೆ;</para>
  <para style="q2" vid="PRO 1:2">ವಿವೇಕದ ಮಾತುಗಳನ್ನು ಗ್ರಹಿಸುವುದಕ್ಕೆ;<verse eid="PRO 1:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 1:3"/>ಅಂದರೆ, ಶಿಕ್ಷಣ, ವಿವೇಕ ನಡವಳಿ, ಸರಿಯಾದದ್ದನ್ನು ಮಾಡುವುದು</para>
  <para style="q2" vid="PRO 1:3">ನ್ಯಾಯ ಮತ್ತು ಯುಕ್ತವಾದವುಗಳನ್ನು ನಡೆಸುವ ಜ್ಞಾನೋಕ್ತಿಗಳು;<verse eid="PRO 1:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 1:4"/>ಮುಗ್ಧರಿಗೆ ವಿವೇಕವನ್ನೂ ಯೌವನಸ್ಥರಿಗೆ ತಿಳುವಳಿಕೆ ಹಾಗೂ</para>
  <para style="q2" vid="PRO 1:4">ಸ್ವವಿವೇಚನೆಯನ್ನೂ ಕೊಡುವುದಕ್ಕಾಗಿ ಈ ಜ್ಞಾನೋಕ್ತಿಗಳಿವೆ.<verse eid="PRO 1:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 1:5"/>ಜ್ಞಾನಿಯು ಜ್ಞಾನೋಕ್ತಿಗಳನ್ನು ಕೇಳಿ, ಜ್ಞಾನವನ್ನು ಹೆಚ್ಚಿಸಿಕೊಳ್ಳಲಿ;</para>
  <para style="q2" vid="PRO 1:5">ವಿವೇಚಿಸುವವರು ಮಾರ್ಗದರ್ಶನವನ್ನು ಹೊಂದಿಕೊಳ್ಳಲಿ.<verse eid="PRO 1:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 1:6"/>ಜ್ಞಾನೋಕ್ತಿಗಳನ್ನು, ಸಾಮ್ಯಗಳನ್ನು, ಜ್ಞಾನಿಗಳ ಮಾತು ಹಾಗೂ ಒಗಟುಗಳನ್ನು</para>
  <para style="q2" vid="PRO 1:6">ಅರ್ಥಮಾಡಿಕೊಳ್ಳಲು ಇವು ಬರೆಯಲಾಗಿವೆ.<verse eid="PRO 1:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 1:7"/>ಯೆಹೋವ ದೇವರ ಭಯವೇ ಜ್ಞಾನದ ಮೂಲವಾಗಿದೆ.</para>
  <para style="q2" vid="PRO 1:7">ಆದರೆ ಮೂರ್ಖರು ಜ್ಞಾನವನ್ನೂ ಶಿಕ್ಷಣವನ್ನೂ ಅಸಡ್ಡೆ ಮಾಡುತ್ತಾರೆ.<verse eid="PRO 1:7"/></para>
  <para style="ms1">ಮುನ್ನುಡಿ: ಬುದ್ಧಿವಂತಿಕೆಯನ್ನು ಅಳವಡಿಸಿಕೊಳ್ಳಲು ಉಪದೇಶಗಳು</para>
  <para style="s1">ಪಾಪ ಸಂಬಧಿತ ಎಚ್ಚರಿಕೆ</para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 1:8"/>ಮಗನೇ, ನಿನ್ನ ತಂದೆಯ ಶಿಕ್ಷಣಗಳನ್ನು ಕೇಳು,</para>
  <para style="q2" vid="PRO 1:8">ನಿನ್ನ ತಾಯಿಯ ಉಪದೇಶವನ್ನು ತೊರೆಯಬೇಡ.<verse eid="PRO 1:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 1:9"/>ಅವು ನಿನ್ನ ತಲೆಗೆ ಸುಂದರ ಕಿರೀಟ</para>
  <para style="q2" vid="PRO 1:9">ನಿನ್ನ ಕೊರಳನ್ನು ಅಲಂಕರಿಸುವ ಹಾರ.<verse eid="PRO 1:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 1:10"/>ಮಗನೇ, ಪಾಪಿಗಳು ನಿನ್ನನ್ನು ಸೆಳೆದರೆ</para>
  <para style="q2" vid="PRO 1:10">ನೀನು ಒಪ್ಪಬೇಡ.<verse eid="PRO 1:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 1:11"/>ಒಂದು ವೇಳೆ ಅವರು ನಿನಗೆ, “ನಮ್ಮೊಂದಿಗೆ ಬಾ,</para>
  <para style="q2" vid="PRO 1:11">ಜನರ ರಕ್ತಕ್ಕಾಗಿ ಒಳಸಂಚು ಮಾಡೋಣ,</para>
  <para style="q2" vid="PRO 1:11">ನಿರಪರಾಧಿಯ ರಕ್ತಕ್ಕಾಗಿ;<verse eid="PRO 1:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 1:12"/>ಸಮಾಧಿಯು ನುಂಗುವಂತೆ ಜೀವಂತವಾಗಿ ಅವರನ್ನು ದಾಳಿಮಾಡೋಣ</para>
  <para style="q2" vid="PRO 1:12">ಗುಂಡಿಯೊಳಕ್ಕೆ ಹೋಗುವವರನ್ನು ಸಂಪೂರ್ಣವಾಗಿ ನಾವು ಅವರನ್ನು ನುಂಗಿಬಿಡೋಣ.<verse eid="PRO 1:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 1:13"/>ಅಮೂಲ್ಯವಾದ ಸೊತ್ತನ್ನೆಲ್ಲಾ ನಾವು ಕಂಡುಹಿಡಿದು</para>
  <para style="q2" vid="PRO 1:13">ಕೊಳ್ಳೆಹೊಡೆದು ನಮ್ಮ ಮನೆಗಳನ್ನು ತುಂಬಿಕೊಳ್ಳೋಣ;<verse eid="PRO 1:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 1:14"/>ನೀನು ನಮ್ಮ ಮಧ್ಯದಲ್ಲಿ ಚೀಟನ್ನು ಹಾಕು,</para>
  <para style="q2" vid="PRO 1:14">ನಾವೆಲ್ಲರೂ ಹಣಹಂಚಿಕೊಳ್ಳೋಣ,” ಎಂದು ಹೇಳುವುದಾದರೆ.<verse eid="PRO 1:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 1:15"/>ಮಗನೇ, ಅವರೊಂದಿಗೆ ಸೇರಬೇಡ,</para>
  <para style="q2" vid="PRO 1:15">ಅವರ ಮಾರ್ಗದಲ್ಲಿ ಹೆಜ್ಜೆಯಿಡಬೇಡ.<verse eid="PRO 1:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 1:16"/>ಏಕೆಂದರೆ ಅವರ ಪಾದಗಳು ಕೇಡಿಗೆ ಓಡುತ್ತವೆ,</para>
  <para style="q2" vid="PRO 1:16">ರಕ್ತಸುರಿಸುವುದಕ್ಕೆ ಆತುರಪಡುತ್ತವೆ.<verse eid="PRO 1:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 1:17"/>ಪಕ್ಷಿಗಳ ಕಣ್ಣೆದುರಿಗೆ ಕಾಣುವಂತೆ</para>
  <para style="q2" vid="PRO 1:17">ಬಲೆಯನ್ನು ಹರಡುವುದು ವ್ಯರ್ಥವಲ್ಲವೇ!<verse eid="PRO 1:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 1:18"/>ಈ ಜನರು ಒಳಸಂಚು ಮಾಡುವುದು ತಮ್ಮ ಸ್ವಂತ ರಕ್ತಕ್ಕೆ.</para>
  <para style="q2" vid="PRO 1:18">ಅವರು ಮಾಡುವ ದುರಾಲೋಚನೆ ಅವರನ್ನೇ ನಾಶಮಾಡುವುದು.<verse eid="PRO 1:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 1:19"/>ಅಕ್ರಮ ಲಾಭದ ಬೆನ್ನಟ್ಟಿ ಹೋಗುವವರೆಲ್ಲರ ಗತಿ ಇದೇ.</para>
  <para style="q2" vid="PRO 1:19">ಕೊಳ್ಳೆಯು ಕೊಳ್ಳೆಗಾರರ ಜೀವವನ್ನೇ ಕೊಳ್ಳೆಮಾಡುವದು.<verse eid="PRO 1:19"/></para>
  <para style="s1">ಜ್ಞಾನವನ್ನು ತಿರಸ್ಕರಿಸುವವರ ವಿರುದ್ಧ ಎಚ್ಚರಿಕೆ</para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 1:20"/>ಜ್ಞಾನವೆಂಬಾಕೆಯು ಬೀದಿಯಲ್ಲಿ ಕೂಗುತ್ತಾಳೆ,</para>
  <para style="q2" vid="PRO 1:20">ಬಹಿರಂಗ ಸ್ಥಳಗಳಲ್ಲಿ ಆಕೆಯು ತನ್ನ ಧ್ವನಿಗೈಯುತ್ತಾಳೆ.<verse eid="PRO 1:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 1:21"/>ಜನಭರಿತ ಬೀದಿಗಳಲ್ಲಿ ಆಕೆ ಕರೆಯುತ್ತಾಳೆ,</para>
  <para style="q2" vid="PRO 1:21">ಪಟ್ಟಣದ ಹೆಬ್ಬಾಗಿಲುಗಳಲ್ಲಿ ಹೀಗೆಂದು ಭಾಷಣ ಮಾಡುತ್ತಾಳೆ:<verse eid="PRO 1:21"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 1:22"/>“ಮುಗ್ಧರೇ ನೀವು ಎಷ್ಟು ಕಾಲ ಮುಗ್ಧತೆಯನ್ನು ಪ್ರೀತಿಸುವಿರಿ.</para>
  <para style="q2" vid="PRO 1:22">ಕುಚೋದ್ಯಗಾರರೇ ಎಷ್ಟು ಕಾಲ ಕುಚೋದ್ಯಗಾರರಾಗಿರಲು ಇಚ್ಛಿಸುವಿರಿ?</para>
  <para style="q2" vid="PRO 1:22">ಜ್ಞಾನಹೀನರೇ, ಎಷ್ಟು ಕಾಲ ಪರಿಜ್ಞಾನವನ್ನು ಹಗೆ ಮಾಡುವಿರಿ?<verse eid="PRO 1:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 1:23"/>ನನ್ನ ಗದರಿಕೆ ಕೇಳಿ ನೀವು ಪಶ್ಚಾತ್ತಾಪಪಡಿರಿ!</para>
  <para style="q2" vid="PRO 1:23">ಆಗ ನಿಮ್ಮ ಮೇಲೆ ನನ್ನ ಆತ್ಮವನ್ನು ಸುರಿಸಿ,</para>
  <para style="q2" vid="PRO 1:23">ನಿಮಗೆ ನನ್ನ ಬೋಧನೆಗಳನ್ನು ಪ್ರಕಟಿಸುವೆನು.<verse eid="PRO 1:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 1:24"/>ನಾನು ಕರೆದಾಗ ನೀವು ನನ್ನನ್ನು ತಿರಸ್ಕರಿಸಿದ್ದೀರಿ</para>
  <para style="q2" vid="PRO 1:24">ನಾನು ನನ್ನ ಕೈಚಾಚಿದಾಗ ಯಾರೂ ಮನುಷ್ಯನೂ ಗಮನಿಸಲಿಲ್ಲ.<verse eid="PRO 1:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 1:25"/>ನನ್ನ ಆಲೋಚನೆಯನ್ನು ನೀವು ಲಕ್ಷಿಸದೆ;</para>
  <para style="q2" vid="PRO 1:25">ನನ್ನ ಗದರಿಕೆಯನ್ನು ನೀವು ಬೇಡವೆಂದು ತಳ್ಳಿಬಿಟ್ಟಿದ್ದರಿಂದ<verse eid="PRO 1:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 1:26"/>ಬಿರುಗಾಳಿಯಂತೆ ನಿಮಗೆ ವಿಪತ್ತು ಬಂದಾಗ ನಾನು ನಗುವೆನು.</para>
  <para style="q2" vid="PRO 1:26">ಆಪತ್ತು ನಿಮ್ಮನ್ನು ಹಿಂದಿಕ್ಕಿದಾಗ, ನಾನು ಪರಿಹಾಸ್ಯ ಮಾಡುವೆನು.<verse eid="PRO 1:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 1:27"/>ಚಂಡಮಾರುತವು ನಿಮ್ಮನ್ನು ಬಿರುಗಾಳಿಯಂತೆ ತಾಕಿದಾಗ,</para>
  <para style="q2" vid="PRO 1:27">ವಿಪತ್ತು ಸುಂಟರಗಾಳಿಯಂತೆ ನಿಮ್ಮ ಮೇಲೆ ಬೀಸಿದಾಗ,</para>
  <para style="q2" vid="PRO 1:27">ಯಾತನೆ ಮತ್ತು ತೊಂದರೆ ನಿಮ್ಮನ್ನು ಆವರಿಸಿದಾಗಲೂ ಪರಿಹಾಸ್ಯಕ್ಕೆ ಒಳಗಾಗುವಿರಿ.<verse eid="PRO 1:27"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 1:28"/>“ಆಗ ಅವರು ನನಗೆ ಮೊರೆಯಿಡುವರು, ಆದರೆ ನಾನು ಅವರಿಗೆ ಉತ್ತರ ಕೊಡೆನು.</para>
  <para style="q2" vid="PRO 1:28">ಅವರು ನನ್ನನ್ನು ಆತುರದಿಂದ ಹುಡುಕುವರು, ಆದರೆ ಅವರು ನನ್ನನ್ನು ಕಂಡುಕೊಳ್ಳುವುದಿಲ್ಲ.<verse eid="PRO 1:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 1:29"/>ಏಕೆಂದರೆ ಅವರು ಅರಿವನ್ನು ಹಗೆಮಾಡಿ,</para>
  <para style="q2" vid="PRO 1:29">ಯೆಹೋವ ದೇವರಿಗೆ ಭಯಪಡುವುದನ್ನು ಆರಿಸಿಕೊಳ್ಳದೆ ಹೋದರು.<verse eid="PRO 1:29"/></para>
  <para style="q1">
    <verse number="30" style="v" sid="PRO 1:30"/>ನನ್ನ ಬುದ್ಧಿವಾದವನ್ನು ಸ್ವೀಕರಿಸದೆ,</para>
  <para style="q2" vid="PRO 1:30">ನನ್ನ ಗದರಿಕೆಯನ್ನೆಲ್ಲಾ ಅಸಡ್ಡೆ ಮಾಡಿದರು.<verse eid="PRO 1:30"/></para>
  <para style="q1">
    <verse number="31" style="v" sid="PRO 1:31"/>ಅವರು ತಮ್ಮ ಸ್ವಂತ ನಡತೆಯ ಫಲವನ್ನು ಅನುಭವಿಸಿ,</para>
  <para style="q2" vid="PRO 1:31">ತಮ್ಮ ಸ್ವಂತ ಕುಯುಕ್ತಿಗಳಿಂದಲೇ ಹೊಟ್ಟೆ ತುಂಬಿಕೊಳ್ಳುವರು.<verse eid="PRO 1:31"/></para>
  <para style="q1">
    <verse number="32" style="v" sid="PRO 1:32"/>ಮುಗ್ಧರ ದಾರಿತಪ್ಪುವಿಕೆಯು ಅವರನ್ನು ಕೊಲ್ಲುವುದು.</para>
  <para style="q2" vid="PRO 1:32">ಜ್ಞಾನಹೀನರ ನಿಶ್ಚಿಂತೆಯು ಅವರನ್ನು ನಾಶಮಾಡುವುದು.<verse eid="PRO 1:32"/></para>
  <para style="q1">
    <verse number="33" style="v" sid="PRO 1:33"/>ನನಗೆ ಕಿವಿಗೊಡುವವರಾದರೋ ಸುರಕ್ಷಿತರಾಗಿ ಜೀವಿಸುವರು,</para>
  <para style="q2" vid="PRO 1:33">ಕೇಡಿನ ಭಯವಿಲ್ಲದೇ ನೆಮ್ಮದಿಯಿಂದ ಇರುವರು.”<verse eid="PRO 1:33"/></para>
  <chapter eid="PRO 1"/>
  <chapter number="2" style="c" sid="PRO 2"/>
  <para style="s1">ಜ್ಞಾನದಿಂದ ಆಗುವ ನೈತಿಕ ಲಾಭಗಳು</para>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 2:1"/>ಮಗನೇ, ನನ್ನ ಮಾತುಗಳನ್ನು ನೀನು ಅಂಗೀಕರಿಸಿ,</para>
  <para style="q2" vid="PRO 2:1">ನನ್ನ ಆಜ್ಞೆಗಳನ್ನು ನಿನ್ನಲ್ಲಿ ಕಾದಿರಿಸು.<verse eid="PRO 2:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 2:2"/>ನೀನು ಜ್ಞಾನಕ್ಕೆ ಕಿವಿಗೊಟ್ಟು,</para>
  <para style="q2" vid="PRO 2:2">ತಿಳುವಳಿಕೆಗೆ ನಿನ್ನ ಹೃದಯವನ್ನು ತಿರುಗಿಸು,<verse eid="PRO 2:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 2:3"/>ಹೌದು, ನೀನು ಒಳನೋಟಕ್ಕಾಗಿ ಮೊರೆಯಿಟ್ಟು,</para>
  <para style="q2" vid="PRO 2:3">ತಿಳುವಳಿಕೆಗಾಗಿ ನಿನ್ನ ಸ್ವರವೆತ್ತಿ,<verse eid="PRO 2:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 2:4"/>ಬೆಳ್ಳಿಯಂತೆ ನೀನು ಅದನ್ನು ಹಂಬಲಿಸಿದರೆ,</para>
  <para style="q2" vid="PRO 2:4">ನಿಗೂಢ ನಿಕ್ಷೇಪದಂತೆ ನೀನು ಅದಕ್ಕಾಗಿ ಹುಡುಕಿದರೆ,<verse eid="PRO 2:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 2:5"/>ಆಗ ನೀನು ಯೆಹೋವ ದೇವರ ಭಯಭಕ್ತಿಯನ್ನು ತಿಳಿದುಕೊಳ್ಳುವೆ;</para>
  <para style="q2" vid="PRO 2:5">ದೇವರ ಅರಿವನ್ನು ಕಂಡುಕೊಳ್ಳುವೆ.<verse eid="PRO 2:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 2:6"/>ಏಕೆಂದರೆ ಯೆಹೋವ ದೇವರೇ ಜ್ಞಾನವನ್ನು ಕೊಡುತ್ತಾರೆ;</para>
  <para style="q2" vid="PRO 2:6">ಅವರ ಬಾಯಿಂದಲೇ ಅರಿವೂ ತಿಳುವಳಿಕೆಯೂ ಹೊರಟುಬರುತ್ತವೆ.<verse eid="PRO 2:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 2:7"/>ನೀತಿವಂತರಿಗೋಸ್ಕರ ದೇವರು ಸುಜ್ಞಾನವನ್ನು ಕೂಡಿಸಿಡುವರು,</para>
  <para style="q2" vid="PRO 2:7">ನಿರ್ದೋಷಿಯಾಗಿ ನಡೆದುಕೊಳ್ಳುವವರಿಗೆ ದೇವರು ಗುರಾಣಿಯಾಗಿದ್ದಾರೆ.<verse eid="PRO 2:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 2:8"/>ನ್ಯಾಯವಂತರ ದಾರಿಗಳನ್ನು ದೇವರು ಕಾಯುತ್ತಾರೆ;</para>
  <para style="q2" vid="PRO 2:8">ತಮ್ಮ ನಂಬಿಗಸ್ತರ ಮಾರ್ಗವನ್ನು ಭದ್ರಪಡಿಸುತ್ತಾರೆ.<verse eid="PRO 2:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 2:9"/>ಆಗ ನೀನು ಸರಿಯಾದದ್ದನ್ನೂ ನ್ಯಾಯವನ್ನೂ ಯುಕ್ತವಾದದ್ದನ್ನು ಅರ್ಥಮಾಡಿಕೊಳ್ಳುವೆ,</para>
  <para style="q2" vid="PRO 2:9">ಮಾತ್ರವಲ್ಲದೆ ಪ್ರತಿಯೊಂದು ಸನ್ಮಾರ್ಗವನ್ನೂ ತಿಳಿದುಕೊಳ್ಳುವೆ.<verse eid="PRO 2:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 2:10"/>ನಿನ್ನ ಹೃದಯದಲ್ಲಿ ಜ್ಞಾನವು ಪ್ರವೇಶಿಸಿ,</para>
  <para style="q2" vid="PRO 2:10">ನಿನ್ನ ಪ್ರಾಣಕ್ಕೆ ತಿಳುವಳಿಕೆಯು ಹಿತಕರವಾಗಿರುವುದು.<verse eid="PRO 2:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 2:11"/>ನಿನ್ನ ವಿವೇಚನೆಯು ನಿನ್ನನ್ನು ಭದ್ರವಾಗಿ ಕಾಯುವುದು;</para>
  <para style="q2" vid="PRO 2:11">ತಿಳುವಳಿಕೆಯು ನಿನ್ನನ್ನು ಕಾಪಾಡುವುದು.<verse eid="PRO 2:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 2:12"/>ಜ್ಞಾನವು ದುಷ್ಟರ ಮಾರ್ಗಗಳಿಂದಲೂ,</para>
  <para style="q2" vid="PRO 2:12">ವಕ್ರರ ಮಾತುಗಳಿಂದಲೂ ಕಾಪಾಡುವುದು.<verse eid="PRO 2:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 2:13"/>ಅವರು ಕತ್ತಲೆಯ ಹಾದಿಗಳಲ್ಲಿ ನಡೆಯುವುದಕ್ಕೆ</para>
  <para style="q2" vid="PRO 2:13">ನೇರವಾದ ದಾರಿಗಳನ್ನು ತೊರೆದುಬಿಡುತ್ತಾರೆ.<verse eid="PRO 2:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 2:14"/>ಅವರು ಕೆಟ್ಟದ್ದನ್ನು ಮಾಡುವುದಕ್ಕೆ ಸಂತೋಷಿಸುತ್ತಾರೆ.</para>
  <para style="q2" vid="PRO 2:14">ಕೇಡಿನ ವಕ್ರತನದಲ್ಲಿ ಆನಂದಿಸುತ್ತಾರೆ.<verse eid="PRO 2:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 2:15"/>ಅವರ ಮಾರ್ಗಗಳು ವಕ್ರವಾಗಿವೆ;</para>
  <para style="q2" vid="PRO 2:15">ತಮ್ಮ ನಡತೆಗಳಲ್ಲಿ ಅವರು ತಪ್ಪಿಹೋಗಿದ್ದಾರೆ.<verse eid="PRO 2:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 2:16"/>ಜಾರಿಣಿಯಿಂದಲೂ ದಾರಿತಪ್ಪಿದ</para>
  <para style="q2" vid="PRO 2:16">ಪರಸ್ತ್ರೀಯ ವಶೀಕರಣದ ಮಾತುಗಳಿಂದಲೂ ಜ್ಞಾನವು ನಿನ್ನನ್ನು ರಕ್ಷಿಸುವುದು.<verse eid="PRO 2:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 2:17"/>ಅವಳು ತನ್ನ ಯೌವನ ಕಾಲದ ಪತಿಯನ್ನು ತ್ಯಜಿಸಿದ್ದಾಳೆ,</para>
  <para style="q2" vid="PRO 2:17">ದೇವರ ಸನ್ನಿಧಿಯಲ್ಲಿ ಮಾಡಿಕೊಂಡ ಒಡಂಬಡಿಕೆಯನ್ನೂ ಕಡೆಗಣಿಸಿದ್ದಾಳೆ.<verse eid="PRO 2:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 2:18"/>ಏಕೆಂದರೆ ಅವಳ ಮನೆ ಮರಣ ಮಾರ್ಗ.</para>
  <para style="q2" vid="PRO 2:18">ಅವಳ ದಾರಿ ಮೃತರ ಕಡೆಗೂ ನಡೆಸುತ್ತವೆ.<verse eid="PRO 2:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 2:19"/>ಅವಳ ಬಳಿಗೆ ಹೋಗುವ ಯಾವನೂ ಹಿಂದಿರುಗುವುದಿಲ್ಲ;</para>
  <para style="q2" vid="PRO 2:19">ಜೀವಮಾರ್ಗಗಳನ್ನು ಅಂಥವರು ಹಿಡಿಯುವುದೇ ಇಲ್ಲ.<verse eid="PRO 2:19"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 2:20"/>ಆದ್ದರಿಂದ ಒಳ್ಳೆಯವರ ಮಾರ್ಗದಲ್ಲಿ ನೀನು ನಡೆಯುವೆ</para>
  <para style="q2" vid="PRO 2:20">ನೀತಿವಂತರ ದಾರಿಯನ್ನು ನೀನು ಹಿಡಿಯುವೆ.<verse eid="PRO 2:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 2:21"/>ಏಕೆಂದರೆ ಪ್ರಾಮಾಣಿಕರು ದೇಶದಲ್ಲಿ ವಾಸಿಸುವರು,</para>
  <para style="q2" vid="PRO 2:21">ನಿರ್ದೋಷಿಗಳು ಅದರಲ್ಲಿ ನೆಲೆಯಾಗಿ ಇರುವರು.<verse eid="PRO 2:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 2:22"/>ದುಷ್ಟರಾದರೋ ಭೂಮಿಯಿಂದ ತೆಗೆದುಹಾಕಲಾಗುವರು;</para>
  <para style="q2" vid="PRO 2:22">ದ್ರೋಹಿಗಳು ಬೇರುಸಹಿತವಾಗಿ ಕಿತ್ತುಹಾಕಲಾಗುವರು.<verse eid="PRO 2:22"/></para>
  <chapter eid="PRO 2"/>
  <chapter number="3" style="c" sid="PRO 3"/>
  <para style="s1">ಜ್ಞಾನದಿಂದ ಇನ್ನಷ್ಟು ಲಾಭಗಳು</para>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 3:1"/>ಮಗನೇ, ನನ್ನ ಉಪದೇಶವನ್ನು ಮರೆಯಬೇಡ;</para>
  <para style="q2" vid="PRO 3:1">ನನ್ನ ಆಜ್ಞೆಗಳನ್ನು ನಿನ್ನ ಹೃದಯದಲ್ಲಿ ಇಟ್ಟುಕೋ.<verse eid="PRO 3:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 3:2"/>ಏಕೆಂದರೆ ಅವು ನಿನ್ನ ದಿನಗಳನ್ನು ಹೆಚ್ಚಿಸಿ ದೀರ್ಘಾಯುಷ್ಯವನ್ನು ನೀಡುವುದು,</para>
  <para style="q2" vid="PRO 3:2">ಸಮಾಧಾನವನ್ನೂ ಸಮೃದ್ಧಿಯನ್ನೂ ನಿನಗೆ ಕೊಡುವುದು.<verse eid="PRO 3:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 3:3"/>ಪ್ರೀತಿ, ನಂಬಿಗಸ್ತಿಕೆಗಳು ನಿನ್ನನ್ನು ಬಿಡದಿರಲಿ;</para>
  <para style="q2" vid="PRO 3:3">ಅವು ನಿನ್ನ ಕೊರಳಿನ ಸುತ್ತಲೂ ಕಟ್ಟಿರಲಿ,</para>
  <para style="q2" vid="PRO 3:3">ನಿನ್ನ ಹೃದಯದ ಹಲಗೆಯ ಮೇಲೆ ಅವು ಬರೆದಿರಲಿ.<verse eid="PRO 3:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 3:4"/>ಆಗ ದೇವರ ಮುಂದೆಯೂ ಮನುಷ್ಯರ ಮುಂದೆಯೂ ದಯೆಯನ್ನೂ,</para>
  <para style="q2" vid="PRO 3:4">ಒಳ್ಳೆಯ ಹೆಸರನ್ನೂ ನೀನು ಪಡೆದುಕೊಳ್ಳುವೆ.<verse eid="PRO 3:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 3:5"/>ಪೂರ್ಣಹೃದಯದಿಂದ ಯೆಹೋವ ದೇವರಲ್ಲಿ ಭರವಸೆ ಇಡು</para>
  <para style="q2" vid="PRO 3:5">ನಿನ್ನ ಸ್ವಂತ ಬುದ್ಧಿಯ ಮೇಲೆಯೇ ಆಧಾರಗೊಳ್ಳಬೇಡ.<verse eid="PRO 3:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 3:6"/>ನಿನ್ನ ಎಲ್ಲಾ ಮಾರ್ಗಗಳಲ್ಲಿ ದೇವರಿಗೆ ಅಧೀನವಾಗಿರು.</para>
  <para style="q2" vid="PRO 3:6">ಆಗ ದೇವರು ನಿನ್ನ ಮಾರ್ಗಗಳನ್ನು ಸರಾಗ ಮಾಡುವರು.<verse eid="PRO 3:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 3:7"/>ನಿನ್ನ ದೃಷ್ಟಿಯಲ್ಲಿ ನೀನೇ ಜ್ಞಾನಿ ಎಂದು ಇರಬೇಡ;</para>
  <para style="q2" vid="PRO 3:7">ಯೆಹೋವ ದೇವರಿಗೆ ಭಯಪಟ್ಟು, ಕೆಟ್ಟದ್ದನ್ನು ತೊರೆದುಬಿಡು.<verse eid="PRO 3:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 3:8"/>ನಿನ್ನ ದೇಹಕ್ಕೆ ಅದು ಆರೋಗ್ಯವನ್ನು ತರುವುದು;</para>
  <para style="q2" vid="PRO 3:8">ನಿನ್ನ ಎಲುಬುಗಳಿಗೆ ಅದು ಪೋಷಣೆಯನ್ನೂ ತರುವುದು.<verse eid="PRO 3:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 3:9"/>ನಿನ್ನ ಆಸ್ತಿಯಿಂದಲೂ</para>
  <para style="q2" vid="PRO 3:9">ನಿನ್ನ ಎಲ್ಲಾ ಬೆಳೆಯ ಪ್ರಥಮ ಫಲದಿಂದಲೂ ಯೆಹೋವ ದೇವರನ್ನು ಸನ್ಮಾನಿಸು.<verse eid="PRO 3:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 3:10"/>ಆಗ ನಿನ್ನ ಕಣಜಗಳು ಸಮೃದ್ಧಿಯಿಂದ ತುಂಬುವವು;</para>
  <para style="q2" vid="PRO 3:10">ಹೊಸ ದ್ರಾಕ್ಷಾರಸದಿಂದ ನಿನ್ನ ತೊಟ್ಟಿಗಳು ತುಂಬಿರುವುದು.<verse eid="PRO 3:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 3:11"/>ಮಗನೇ, ಯೆಹೋವ ದೇವರ ಶಿಕ್ಷೆಯನ್ನು ತಾತ್ಸಾರ ಮಾಡಬೇಡ;</para>
  <para style="q2" vid="PRO 3:11">ಅವರು ನಿನ್ನನ್ನು ಗದರಿಸುವಾಗ ಬೇಸರಗೊಳ್ಳಬೇಡ.<verse eid="PRO 3:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 3:12"/>ಏಕೆಂದರೆ ತಂದೆಯು ತನ್ನ ಮುದ್ದುಮಗನನ್ನು ಶಿಕ್ಷಿಸುವಂತೆ,</para>
  <para style="q2" vid="PRO 3:12">ಯೆಹೋವ ದೇವರು ಯಾರನ್ನು ಪ್ರೀತಿಸುತ್ತಾರೋ, ಅವರನ್ನು ಶಿಸ್ತುಗೊಳಿಸುವರು.<verse eid="PRO 3:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 3:13"/>ಜ್ಞಾನವನ್ನು ಕಂಡುಕೊಳ್ಳುವವನು ಧನ್ಯನು,</para>
  <para style="q2" vid="PRO 3:13">ವಿವೇಕವನ್ನು ಸಂಪಾದಿಸಿಕೊಳ್ಳುವವನೂ ಧನ್ಯನು.<verse eid="PRO 3:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 3:14"/>ಏಕೆಂದರೆ ಜ್ಞಾನವು ಬೆಳ್ಳಿಗಿಂತ ಹೆಚ್ಚು ಲಾಭವೂ;</para>
  <para style="q2" vid="PRO 3:14">ಬಂಗಾರಕ್ಕಿಂತ ಹೆಚ್ಚು ಆದಾಯವನ್ನು ಕೊಡುವುದು.<verse eid="PRO 3:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 3:15"/>ಜ್ಞಾನವು ಮಾಣಿಕ್ಯಗಳಿಗಿಂತಲೂ ಬಹು ಅಮೂಲ್ಯ;</para>
  <para style="q2" vid="PRO 3:15">ನಿನ್ನ ಇಷ್ಟ ವಸ್ತುಗಳೆಲ್ಲವೂ ಅದಕ್ಕೆ ಸಮವಾಗುವುದಿಲ್ಲ.<verse eid="PRO 3:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 3:16"/>ಜ್ಞಾನದ ಬಲಗೈಯಲ್ಲಿ ದೀರ್ಘಾಯುಷ್ಯವಿದೆ;</para>
  <para style="q2" vid="PRO 3:16">ಎಡಗೈಯಲ್ಲಿ ಐಶ್ವರ್ಯವೂ ಘನತೆಯೂ ಇವೆ.<verse eid="PRO 3:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 3:17"/>ಜ್ಞಾನದ ಮಾರ್ಗಗಳು ಸಂತೋಷಕರ;</para>
  <para style="q2" vid="PRO 3:17">ಅದರ ದಾರಿಗಳೆಲ್ಲಾ ಶಾಂತಿಯ ದಾರಿಗಳೇ.<verse eid="PRO 3:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 3:18"/>ಜ್ಞಾನವನ್ನು ಹಿಡಿದುಕೊಳ್ಳುವವರಿಗೆ ಜ್ಞಾನವು ಜೀವವೃಕ್ಷವಾಗಿದೆ;</para>
  <para style="q2" vid="PRO 3:18">ಅದನ್ನು ಭದ್ರವಾಗಿ ಇಟ್ಟುಕೊಳ್ಳುವವರು ಧನ್ಯರು.<verse eid="PRO 3:18"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 3:19"/>ಯೆಹೋವ ದೇವರು ಜ್ಞಾನದಿಂದ ಭೂಮಿಯನ್ನು ಸ್ಥಾಪಿಸಿದರು,</para>
  <para style="q2" vid="PRO 3:19">ತಮ್ಮ ತಿಳುವಳಿಕೆಯ ಮೂಲಕ ಅವರು ಆಕಾಶಗಳನ್ನು ಸ್ಥಿರಪಡಿಸಿದರು.<verse eid="PRO 3:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 3:20"/>ದೇವರು ತಮ್ಮ ಅರಿವಿನಿಂದಲೇ ಸೆಲೆಗಳು ಒಡೆದು,</para>
  <para style="q2" vid="PRO 3:20">ಮೇಘಗಳು ಇಬ್ಬನಿಯನ್ನು ಸುರಿಸುತ್ತವೆ.<verse eid="PRO 3:20"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 3:21"/>ಮಗನೇ, ಜ್ಞಾನವನ್ನೂ ತಿಳುವಳಿಕೆಯನ್ನೂ ಕಾಪಾಡಿಕೋ,</para>
  <para style="q2" vid="PRO 3:21">ನಿನ್ನ ಕಣ್ಣುಗಳಿಂದ ಅವು ತಪ್ಪಿಹೋಗದೆ ಇರಲಿ.<verse eid="PRO 3:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 3:22"/>ಅವು ನಿನಗೆ ಜೀವವಾಗಿರಲಿ.</para>
  <para style="q2" vid="PRO 3:22">ನಿನ್ನ ಕೊರಳಿಗೆ ಆಭರಣವೂ ಆಗಿರುವುವು.<verse eid="PRO 3:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 3:23"/>ಆಗ ನಿನ್ನ ಮಾರ್ಗದಲ್ಲಿ ಸುರಕ್ಷಿತವಾಗಿರುವೆ;</para>
  <para style="q2" vid="PRO 3:23">ನೀನು ಎಡವದೆ ನಡೆಯುವೆ.<verse eid="PRO 3:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 3:24"/>ನೀನು ಮಲಗುವಾಗ ನಿನಗೆ ಹೆದರಿಕೆ ಇರುವುದಿಲ್ಲ;</para>
  <para style="q2" vid="PRO 3:24">ನೀನು ಮಲಗಿದಾಗ ನಿದ್ರೆಯು ಸುಖವಾಗಿರುವುದು.<verse eid="PRO 3:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 3:25"/>ಆಕಸ್ಮಿಕ ವಿಪತ್ತಿಗೆ ನೀನು ಅಂಜುವುದಿಲ್ಲ;</para>
  <para style="q2" vid="PRO 3:25">ದುಷ್ಟರ ಮೇಲೆ ಬರುವ ನಾಶನಕ್ಕೂ ನೀನು ಭಯಪಡದಿರುವೆ.<verse eid="PRO 3:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 3:26"/>ಏಕೆಂದರೆ ಯೆಹೋವ ದೇವರೇ ನಿನಗೆ ಭರವಸೆ ಆಗಿದ್ದಾರೆ,</para>
  <para style="q2" vid="PRO 3:26">ನಿನ್ನ ಪಾದವು ಉರುಲಿಗೆ ಸಿಕ್ಕದಂತೆ ಅವರು ಕಾಪಾಡುವರು.<verse eid="PRO 3:26"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 3:27"/>ನಿನಗೆ ಶಕ್ತಿಯಿರುವಾಗಲೇ ಇತರರಿಗೆ ಉಪಕಾರಮಾಡು</para>
  <para style="q2" vid="PRO 3:27">ಒಳಿತು ಮಾಡುವುದನ್ನು ನಿನ್ನಲ್ಲಿಯೇ ಇಟ್ಟುಕೊಳ್ಳಬೇಡ.<verse eid="PRO 3:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 3:28"/>ಕೊಡತಕ್ಕದ್ದು ಈಗಾಗಲೇ ನಿನ್ನಲ್ಲಿರುವಾಗ,</para>
  <para style="q2" vid="PRO 3:28">“ಹೋಗಿ ಬಾ, ನಾಳೆ ನಿನಗೆ ಕೊಡುತ್ತೇನೆ,”</para>
  <para style="q2" vid="PRO 3:28">ಎಂದು ನಿನ್ನ ನೆರೆಯವನಿಗೆ ಹೇಳಬೇಡ.<verse eid="PRO 3:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 3:29"/>ನಿನ್ನ ನೆರೆಯವನು ಭರವಸೆಯಿಂದ ನಿನ್ನ ಪಕ್ಕದಲ್ಲಿ ವಾಸಮಾಡುತ್ತಿರುವಾಗ,</para>
  <para style="q2" vid="PRO 3:29">ಅವನಿಗೆ ವಿರೋಧವಾಗಿ ಕೇಡನ್ನು ಕಲ್ಪಿಸಬೇಡ.<verse eid="PRO 3:29"/></para>
  <para style="q1">
    <verse number="30" style="v" sid="PRO 3:30"/>ಒಬ್ಬನು ನಿನಗೆ ಯಾವ ತೊಂದರೆ ಮಾಡದಿದ್ದರೆ,</para>
  <para style="q2" vid="PRO 3:30">ಅವನೊಂದಿಗೆ ಕಾರಣವಿಲ್ಲದೆ ದೂರು ನುಡಿಯಬೇಡ.<verse eid="PRO 3:30"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="31" style="v" sid="PRO 3:31"/>ಬಲಾತ್ಕಾರಿಯ ವಿಷಯದಲ್ಲಿ ನೀನು ಹೊಟ್ಟೆಕಿಚ್ಚುಪಡಬೇಡ;</para>
  <para style="q2" vid="PRO 3:31">ಅವನ ಮಾರ್ಗಗಳಲ್ಲಿ ಯಾವುದನ್ನೂ ನೀನು ಆರಿಸಿಕೊಳ್ಳಬೇಡ.<verse eid="PRO 3:31"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="32" style="v" sid="PRO 3:32"/>ಏಕೆಂದರೆ ವಕ್ರಬುದ್ಧಿ ಯೆಹೋವ ದೇವರಿಗೆ ಅಸಹ್ಯ;</para>
  <para style="q2" vid="PRO 3:32">ಆದರೆ ದೇವರ ನಂಬಿಗಸ್ತಿಕೆ ನೀತಿವಂತರೊಂದಿಗೆ ಇದೆ.<verse eid="PRO 3:32"/></para>
  <para style="q1">
    <verse number="33" style="v" sid="PRO 3:33"/>ದುಷ್ಟರ ಮನೆಯ ಮೇಲೆ ದೈವಶಾಪವಿದೆ.</para>
  <para style="q2" vid="PRO 3:33">ಆದರೆ ನೀತಿವಂತರ ನಿವಾಸದ ಮೇಲೆ ದೈವಾಶೀರ್ವಾದವಿರುವುದು.<verse eid="PRO 3:33"/></para>
  <para style="q1">
    <verse number="34" style="v" sid="PRO 3:34"/>ದೇವರು ಗರ್ವಿಷ್ಠ ಪರಿಹಾಸ್ಯಗಾರರನ್ನು ಪರಿಹಾಸ್ಯ ಮಾಡುತ್ತಾರೆ;</para>
  <para style="q2" vid="PRO 3:34">ದೀನರಿಗಾದರೋ ದೇವರು ಕೃಪೆಯನ್ನು ಕೊಡುತ್ತಾರೆ.<verse eid="PRO 3:34"/></para>
  <para style="q1">
    <verse number="35" style="v" sid="PRO 3:35"/>ಜ್ಞಾನಿಗಳು ಸನ್ಮಾನಕ್ಕೆ ಬಾಧ್ಯನಾಗುವರು;</para>
  <para style="q2" vid="PRO 3:35">ಆದರೆ ಜ್ಞಾನಹೀನರ ಪ್ರತಿಫಲವು ಅವಮಾನವೆ.<verse eid="PRO 3:35"/></para>
  <chapter eid="PRO 3"/>
  <chapter number="4" style="c" sid="PRO 4"/>
  <para style="s1">ಹೇಗಾದರೂ ಜ್ಞಾನವನ್ನು ಪಡೆಯಿರಿ</para>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 4:1"/>ಮಕ್ಕಳೇ, ತಂದೆಯ ಶಿಕ್ಷಣವನ್ನು ಕೇಳಿರಿ;</para>
  <para style="q2" vid="PRO 4:1">ತಿಳುವಳಿಕೆಯನ್ನು ಗ್ರಹಿಸಲಿಕ್ಕೆ ಗಮನಕೊಡಿರಿ.<verse eid="PRO 4:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 4:2"/>ಏಕೆಂದರೆ ನಾನು ನಿಮಗೆ ಸದುಪದೇಶವನ್ನು ಮಾಡುವೆನು,</para>
  <para style="q2" vid="PRO 4:2">ನನ್ನ ಉಪದೇಶವನ್ನು ಬಿಟ್ಟುಬಿಡಬೇಡಿರಿ.<verse eid="PRO 4:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 4:3"/>ನಾನೂ ಕೂಡ ನನ್ನ ತಂದೆಗೆ ನೆಚ್ಚಿನ ಮಗನೂ</para>
  <para style="q2" vid="PRO 4:3">ನನ್ನ ತಾಯಿಗೆ ಮುದ್ದು ಮಗನೂ ಆಗಿದ್ದೆನು.<verse eid="PRO 4:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 4:4"/>ನನ್ನ ತಂದೆ ನನಗೆ ಬೋಧಿಸಿ ಹೇಳಿದ್ದೇನೆಂದರೆ,</para>
  <para style="q2" vid="PRO 4:4">“ನನ್ನ ಮಾತುಗಳನ್ನು ಮನಃಪೂರ್ವಕವಾಗಿ ಪಾಲಿಸು;</para>
  <para style="q2" vid="PRO 4:4">ನನ್ನ ಆಜ್ಞೆಗಳನ್ನು ಕೈಗೊಳ್ಳು, ಆಗ ನೀನು ಬಾಳುವೆ.<verse eid="PRO 4:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 4:5"/>ಜ್ಞಾನವನ್ನು ಪಡೆ, ತಿಳುವಳಿಕೆಯನ್ನು ಸಂಪಾದಿಸು;</para>
  <para style="q2" vid="PRO 4:5">ನನ್ನ ಮಾತುಗಳನ್ನು ಮರೆಯದಿರು, ಅವುಗಳಿಂದ ದೂರವಾಗಬೇಡ.<verse eid="PRO 4:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 4:6"/>ಜ್ಞಾನವನ್ನು ಬಿಟ್ಟುಬಿಡಬೇಡ, ಆಕೆ<note caller="+" style="f"><char style="fr" closed="false">4:6 </char><char style="fq" closed="false">ಆಕೆ </char><char style="ft" closed="false">ಅಂದರೆ </char><char style="fqa" closed="false">ಜ್ಞಾನ</char></note> ನಿನ್ನನ್ನು ಕಾಪಾಡುವಳು;</para>
  <para style="q2" vid="PRO 4:6">ಆಕೆಯನ್ನು ಪ್ರೀತಿಸು, ಆಕೆ ನಿನ್ನನ್ನು ಕಾಯುವಳು.<verse eid="PRO 4:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 4:7"/>ಜ್ಞಾನವೇ ಮುಖ್ಯವಾದದ್ದು, ಆದ್ದರಿಂದ ಜ್ಞಾನವನ್ನು ಸಂಪಾದಿಸು;</para>
  <para style="q2" vid="PRO 4:7">ನಿನ್ನಲ್ಲಿರುವ ಎಲ್ಲಾ ಸಂಪತ್ತನ್ನು ವ್ಯಯಮಾಡಿದರೂ ತಿಳುವಳಿಕೆಯನ್ನು ಪಡೆದುಕೋ.<verse eid="PRO 4:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 4:8"/>ಜ್ಞಾನವನ್ನು ನೀನು ಅಮೂಲ್ಯವೆಂದು ಎಣಿಸು, ಆಕೆಯು ನಿನ್ನನ್ನು ಮೇಲೆತ್ತುವಳು;</para>
  <para style="q2" vid="PRO 4:8">ಆಕೆಯನ್ನು ನೀನು ಅಪ್ಪಿಕೊ, ಆಕೆಯು ನಿನ್ನನ್ನು ಘನಪಡಿಸುವಳು.<verse eid="PRO 4:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 4:9"/>ಆಕೆಯನ್ನು ನಿನ್ನ ತಲೆಗೆ ಮಹಿಮೆಯ ಕಿರೀಟವಾಗಿರುವಳು;</para>
  <para style="q2" vid="PRO 4:9">ಆಕೆಯನ್ನು ನಿನಗೆ ಘನತೆಯ ಕಿರೀಟವನ್ನು ಸಮರ್ಪಿಸುವಳು.”<verse eid="PRO 4:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 4:10"/>ಮಗನೇ, ಆಲಿಸಿ ನನ್ನ ಮಾತುಗಳನ್ನು ಸ್ವೀಕರಿಸು,</para>
  <para style="q2" vid="PRO 4:10">ಆಗ ನಿನ್ನ ಜೀವನದ ವರ್ಷಗಳು ಹೆಚ್ಚುವವು.<verse eid="PRO 4:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 4:11"/>ಜ್ಞಾನ ಮಾರ್ಗದಲ್ಲಿ ನಾನು ನಿನಗೆ ಶಿಕ್ಷಣಕೊಡುವೆನು,</para>
  <para style="q2" vid="PRO 4:11">ನೇರ ಮಾರ್ಗಗಳಲ್ಲಿ ನಿನ್ನನ್ನು ಮುನ್ನಡಿಸುವೆನು.<verse eid="PRO 4:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 4:12"/>ನೀನು ನಡೆಯುವಾಗ ನಿನ್ನ ಹೆಜ್ಜೆಗೆ ತಡೆಯಾಗದು;</para>
  <para style="q2" vid="PRO 4:12">ನೀನು ಓಡುವಾಗ ಮುಗ್ಗರಿಸಿ ಬೀಳುವುದಿಲ್ಲ.<verse eid="PRO 4:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 4:13"/>ಶಿಕ್ಷಣವನ್ನು ಗಟ್ಟಿಯಾಗಿ ಹಿಡಿದುಕೋ, ಅದು ನಿನ್ನಿಂದ ತೊಲಗದೆ ಇರಲಿ;</para>
  <para style="q2" vid="PRO 4:13">ಸದುಪದೇಶವನ್ನು ಕಾಪಾಡಿಕೋ, ಏಕೆಂದರೆ ಅದು ನಿನ್ನ ಜೀವವಾಗಿದೆ.<verse eid="PRO 4:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 4:14"/>ದುಷ್ಟರ ದಾರಿಯೊಳಗೆ ನೀನು ಪ್ರವೇಶಿಸದಿರು</para>
  <para style="q2" vid="PRO 4:14">ಕೆಟ್ಟವರ ಮಾರ್ಗದಲ್ಲಿ ನೀನು ಹೋಗಬೇಡ.<verse eid="PRO 4:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 4:15"/>ಆ ದಾರಿಯಿಂದ ತೊಲಗು, ಅದರ ಪಕ್ಕದಲ್ಲಿ ಹಾದು ಹೋಗಬೇಡ;</para>
  <para style="q2" vid="PRO 4:15">ಅದರಿಂದ ತಪ್ಪಿಸಿಕೊಂಡು, ನಿನ್ನ ಮಾರ್ಗದಲ್ಲಿ ಮುಂದೆ ನಡೆ.<verse eid="PRO 4:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 4:16"/>ಕೇಡು ಮಾಡದಿದ್ದರೆ ದುಷ್ಟರಿಗೆ ನಿದ್ರೆಬಾರದು;</para>
  <para style="q2" vid="PRO 4:16">ಯಾರನ್ನಾದರೂ ಬೀಳಿಸದಿದ್ದರೆ, ಅವರಿಗೆ ನಿದ್ರೆ ಹತ್ತುವುದಿಲ್ಲ.<verse eid="PRO 4:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 4:17"/>ಅವರಿಗೆ ದುಷ್ಟತನವೇ ಆಹಾರ,</para>
  <para style="q2" vid="PRO 4:17">ಬಲಾತ್ಕಾರವೇ ಅವರಿಗೆ ದ್ರಾಕ್ಷಾರಸ.<verse eid="PRO 4:17"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 4:18"/>ನೀತಿವಂತರ ಮಾರ್ಗವು ಮುಂಜಾನೆಯ ಸೂರ್ಯನ ಬೆಳಕಿನಂತೆ ಇದ್ದು,</para>
  <para style="q2" vid="PRO 4:18">ದಿನದ ಪೂರ್ಣ ಬೆಳಕಿನವರೆಗೂ ಪ್ರಕಾಶಿಸಿ ಹೊಳೆಯುತ್ತಾ ಇರುವುದು.<verse eid="PRO 4:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 4:19"/>ಆದರೆ, ದುಷ್ಟರ ಮಾರ್ಗವು ಕಗ್ಗತ್ತಲಿನಂತಿದೆ.</para>
  <para style="q2" vid="PRO 4:19">ಅವರು ಯಾವುದಕ್ಕೆ ಎಡವಿ ಬೀಳುತ್ತಾರೋ ಅದು ಅವರಿಗೆ ಗೊತ್ತಾಗದು.<verse eid="PRO 4:19"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 4:20"/>ಮಗನೇ, ನನ್ನ ಮಾತುಗಳಿಗೆ ಗಮನಕೊಡು;</para>
  <para style="q2" vid="PRO 4:20">ನನ್ನ ನುಡಿಗಳಿಗೆ ಕಿವಿಗೊಡು.<verse eid="PRO 4:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 4:21"/>ಆ ನುಡಿಗಳು ನಿನ್ನ ಕಣ್ಣುಗಳಿಂದ ತಪ್ಪಿ ಹೋಗದಿರಲಿ;</para>
  <para style="q2" vid="PRO 4:21">ಅವುಗಳನ್ನು ನಿನ್ನ ಹೃದಯದೊಳಗೆ ಇಟ್ಟುಕೋ.<verse eid="PRO 4:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 4:22"/>ಏಕೆಂದರೆ ಆ ನುಡಿಗಳನ್ನು ಕಂಡುಕೊಳ್ಳುವವರಿಗೆ ಅವು ಜೀವವೂ,</para>
  <para style="q2" vid="PRO 4:22">ದೇಹಕ್ಕೆಲ್ಲಾ ಆರೋಗ್ಯವೂ ಆಗಿವೆ.<verse eid="PRO 4:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 4:23"/>ಬಹು ಜಾಗ್ರತೆಯಿಂದ ನಿನ್ನ ಹೃದಯವನ್ನು ಕಾಪಾಡಿಕೋ;</para>
  <para style="q2" vid="PRO 4:23">ಏಕೆಂದರೆ ಅದರೊಳಗಿಂದ ನಿನ್ನ ಕೃತ್ಯಗಳು ಜೀವಧಾರೆಯಾಗಿ ಹೊರಡುತ್ತವೆ.<verse eid="PRO 4:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 4:24"/>ವಕ್ರಮಾತುಗಳನ್ನು ನಿನ್ನ ಬಾಯಿಂದ ತೊಲಗಿಸಿ;</para>
  <para style="q2" vid="PRO 4:24">ಕೆಟ್ಟ ಮಾತುಗಳು ನಿನ್ನ ತುಟಿಗಳಿಂದ ದೂರವಿರಲಿ.<verse eid="PRO 4:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 4:25"/>ನಿನ್ನ ದೃಷ್ಟಿ ನೇರವಾಗಿಯೇ ನೋಡಲಿ;</para>
  <para style="q2" vid="PRO 4:25">ನಿನ್ನ ನೋಟವು ನೇರವಾಗಿ ನಿನ್ನ ಮುಂದೆಯೇ ನಾಟಿರಲಿ.<verse eid="PRO 4:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 4:26"/>ನೀನು ನಡೆಯುವ ದಾರಿಯ ಬಗ್ಗೆ ಗಮನವಿರಲಿ;</para>
  <para style="q2" vid="PRO 4:26">ನೀನು ಕೈಗೊಳ್ಳುವ ಹಾದಿ ಸ್ಥಿರವಾಗಿರಲಿ.<verse eid="PRO 4:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 4:27"/>ನಿನ್ನ ಬಲಕ್ಕಾಗಲಿ, ಎಡಕ್ಕಾಗಲಿ ತಿರುಗಬೇಡ;</para>
  <para style="q2" vid="PRO 4:27">ಕೇಡಿನಿಂದ ನಿನ್ನ ಕಾಲುಗಳು ದೂರವಿರಲಿ.<verse eid="PRO 4:27"/></para>
  <chapter eid="PRO 4"/>
  <chapter number="5" style="c" sid="PRO 5"/>
  <para style="s1">ವ್ಯಭಿಚಾರವನ್ನು ಕುರಿತು ಎಚ್ಚರಿಕೆ</para>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 5:1"/>ಮಗನೇ, ನನ್ನ ಜ್ಞಾನಕ್ಕೆ ಗಮನಕೊಡು;</para>
  <para style="q2" vid="PRO 5:1">ನನ್ನ ಒಳನೋಟದ ಮಾತುಗಳಿಗೆ ಕಿವಿಗೊಡು.<verse eid="PRO 5:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 5:2"/>ಆಗ ನಿನ್ನ ವಿವೇಚನೆಯನ್ನು ಉಳಿಸಿಕೊಳ್ಳುವೆ.</para>
  <para style="q2" vid="PRO 5:2">ನಿನ್ನ ತುಟಿಗಳು ತಿಳುವಳಿಕೆಯನ್ನು ಕಾಪಾಡುವವು.<verse eid="PRO 5:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 5:3"/>ಏಕೆಂದರೆ ಜಾರಿಣಿಯ ತುಟಿಗಳು ಜೇನುಗರೆಯುವುದು;</para>
  <para style="q2" vid="PRO 5:3">ಅವಳ ಮಾತು ಎಣ್ಣೆಗಿಂತಲೂ ಮೃದು.<verse eid="PRO 5:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 5:4"/>ಆದರೆ ಅಂತ್ಯದಲ್ಲಿ ಅವಳು ಮಾಚಿಪತ್ರೆಯಂತೆ ಕಹಿಯೂ,</para>
  <para style="q2" vid="PRO 5:4">ಇಬ್ಬಾಯಿ ಖಡ್ಗದಂತೆ ಹರಿತವೂ ಆಗಿರುವಳು.<verse eid="PRO 5:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 5:5"/>ಅವಳ ಪಾದಗಳು ಮರಣದ ಕಡೆಗೆ ಇಳಿದುಹೋಗುತ್ತವೆ;</para>
  <para style="q2" vid="PRO 5:5">ಅವಳ ಹೆಜ್ಜೆಗಳು ನೇರವಾಗಿ ಪಾತಾಳಕ್ಕೆ ನಡೆಸುತ್ತವೆ.<verse eid="PRO 5:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 5:6"/>ಜೀವಮಾರ್ಗದ ವಿಚಾರ ಅವಳಿಗಿಲ್ಲ;</para>
  <para style="q2" vid="PRO 5:6">ಆದ್ದರಿಂದ ಅವಳ ಮಾರ್ಗಗಳು ಚಂಚಲವಾಗಿವೆ, ಅದರ ಅರಿವೂ ಅವಳಿಗಿಲ್ಲ.<verse eid="PRO 5:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 5:7"/>ಮಕ್ಕಳಿರಾ, ನನ್ನ ಕಡೆಗೆ ಈಗ ಕಿವಿಗೊಡಿರಿ;</para>
  <para style="q2" vid="PRO 5:7">ನನ್ನ ಬಾಯಿಯ ಮಾತುಗಳಿಂದ ದೂರವಾಗಬೇಡಿರಿ.<verse eid="PRO 5:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 5:8"/>ಅವಳ ಕಡೆಯಿಂದ ನಿನ್ನ ದಾರಿಯನ್ನು ದೂರಮಾಡು;</para>
  <para style="q2" vid="PRO 5:8">ಅವಳ ಮನೆಯ ಬಾಗಿಲ ಹತ್ತಿರಕ್ಕೆ ಹೋಗದೆ ಇರು.<verse eid="PRO 5:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 5:9"/>ನೀನು ನಿನ್ನ ಗೌರವವನ್ನು ಬೇರೆಯವರಿಗೆ ಕಳೆಯಬೇಡ,</para>
  <para style="q2" vid="PRO 5:9">ನಿನ್ನ ಘನತೆನ್ನು ಕ್ರೂರನಿಗೂ ಕೊಡಬೇಡ.<verse eid="PRO 5:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 5:10"/>ನಿನ್ನ ಸಂಪತ್ತನ್ನು ಪರರು ತುಂಬಿಕೊಳ್ಳದಂತೆ ಎಚ್ಚರಿಕೆ,</para>
  <para style="q2" vid="PRO 5:10">ನಿನ್ನ ಪ್ರಯಾಸದ ಫಲವು ಪರರ ಮನೆ ಸೇರದಂತೆ ನೋಡಿಕೋ.<verse eid="PRO 5:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 5:11"/>ನಿನ್ನ ಜೀವನದ ಅಂತ್ಯದಲ್ಲಿ</para>
  <para style="q2" vid="PRO 5:11">ನಿನ್ನ ದೇಹವೂ ಕ್ಷೀಣಿಸಿದಾಗ, ನೀನು ನರಳಬೇಕಾದೀತು.<verse eid="PRO 5:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 5:12"/>ಆಗ ನೀನು, “ಶಿಸ್ತನ್ನು ನಾನು ಎಷ್ಟೋ ಹಗೆ ಮಾಡಿದೆ;</para>
  <para style="q2" vid="PRO 5:12">ನನ್ನ ಹೃದಯವು ಗದರಿಕೆಯನ್ನು ತಿರಸ್ಕಾರ ಮಾಡಿತು.<verse eid="PRO 5:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 5:13"/>ನನ್ನ ಬೋಧಕರ ಸ್ವರಕ್ಕೆ ನಾನು ವಿಧೇಯನಾಗದೆ ಹೋದೆ.</para>
  <para style="q2" vid="PRO 5:13">ನನ್ನ ಉಪದೇಶಕರಿಗೆ ನಾನು ಕಿವಿಗೊಡದೆ ಹೋದೆ.<verse eid="PRO 5:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 5:14"/>ನಾನು ದೇವರ ಸಭೆಯಲ್ಲಿ</para>
  <para style="q2" vid="PRO 5:14">ಗಂಭೀರ ಸಮಸ್ಯೆಗೆ ಒಳಗಾದೆ,” ಎಂದು ಹೇಳುವೆ.<verse eid="PRO 5:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 5:15"/>ನಿನ್ನ ಸ್ವಂತ ಕೊಳದ ನೀರನ್ನು ಕುಡಿ,</para>
  <para style="q2" vid="PRO 5:15">ನಿನ್ನ ಸ್ವಂತ ಬಾವಿಯೊಳಗಿಂದ ಉಕ್ಕಿಬರುವ ಜಲವನ್ನು ಕುಡಿ.<verse eid="PRO 5:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 5:16"/>ನಿನ್ನ ಬುಗ್ಗೆಗಳು ಬೀದಿಗಳಲ್ಲಿ ಹರಡುವುದು ಯುಕ್ತವೋ?</para>
  <para style="q2" vid="PRO 5:16">ನೀರಿನ ಒರತೆಗಳು ಬೀದಿಚೌಕಗಳಲ್ಲಿ ಹರಿಯುವುದು ಸರಿಯೇ?<verse eid="PRO 5:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 5:17"/>ಅವು ನಿನಗೆ ಸ್ವಂತವಾಗಿರಲಿ;</para>
  <para style="q2" vid="PRO 5:17">ಪರರು ಭಾಗಿಗಳಾಗಿರಬಾರದು.<verse eid="PRO 5:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 5:18"/>ನಿನ್ನ ಬುಗ್ಗೆಯು ಆಶೀರ್ವಾದ ಹೊಂದಲಿ;</para>
  <para style="q2" vid="PRO 5:18">ನಿನ್ನ ಆನಂದವು ಯೌವನದ ಕಾಲದ ಹೆಂಡತಿಯೊಂದಿಗಿರಲಿ.<verse eid="PRO 5:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 5:19"/>ಆಕೆಯು ಮನೋಹರವಾದ ಹರಿಣಿ, ಅಂದವಾದ ಜಿಂಕೆಯ ಹಾಗೆಯೂ;</para>
  <para style="q2" vid="PRO 5:19">ಆಕೆಯ ಎದೆಯು ನಿನ್ನನ್ನು ಸದಾ ತೃಪ್ತಿಪಡಿಸಲಿ;</para>
  <para style="q2" vid="PRO 5:19">ಆಕೆಯ ಪ್ರೀತಿಯಿಂದ ನೀನು ಸದಾ ಪರವಶನಾಗಿರು.<verse eid="PRO 5:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 5:20"/>ಮಗನೇ, ಬೇರೆಯವನ ಹೆಂಡತಿಗೆ ವಶವಾಗುವುದೇಕೆ?</para>
  <para style="q2" vid="PRO 5:20">ಅನ್ಯಳ ಎದೆಯನ್ನೇಕೆ ಅಪ್ಪಿಕೊಳ್ಳುವೆ?<verse eid="PRO 5:20"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 5:21"/>ನಿನ್ನ ಮಾರ್ಗಗಳು ಯೆಹೋವ ದೇವರ ಮುಂದೆಯೇ ಇವೆ.</para>
  <para style="q2" vid="PRO 5:21">ಅವರು ನಿನ್ನ ಮಾರ್ಗಗಳನ್ನೆಲ್ಲಾ ಪರೀಕ್ಷಿಸುತ್ತಾರೆ.<verse eid="PRO 5:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 5:22"/>ದುಷ್ಟನನ್ನು ಅವನ ಸ್ವಂತ ದ್ರೋಹಗಳೇ ಹಿಡಿಯುತ್ತವೆ;</para>
  <para style="q2" vid="PRO 5:22">ತನ್ನ ಪಾಪಗಳ ಪಾಶಗಳೇ ಅವನನ್ನು ಬಂಧಿಸುತ್ತದೆ.<verse eid="PRO 5:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 5:23"/>ಶಿಸ್ತುಪಾಲನೆಯಿಲ್ಲದೆ ಅವನು ನಾಶವಾಗುವನು;</para>
  <para style="q2" vid="PRO 5:23">ತನ್ನ ಅತಿಮೂರ್ಖತನದಿಂದಲೇ ತಪ್ಪಿಹೋಗುವನು.<verse eid="PRO 5:23"/></para>
  <chapter eid="PRO 5"/>
  <chapter number="6" style="c" sid="PRO 6"/>
  <para style="s1">ಬುದ್ಧಿಹೀನತೆಯ ವಿರುದ್ಧ ಎಚ್ಚರಿಕೆಗಳು</para>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 6:1"/>ಮಗನೇ, ನಿನ್ನ ನೆರೆಯವನಿಗೆ ನೀನು ಹೊಣೆಯಾಗಿದ್ದರೆ,</para>
  <para style="q2" vid="PRO 6:1">ಪರನಿಗಾಗಿ ನಿನ್ನ ಕೈಯನ್ನು ಒಡ್ಡಿದ್ದರೆ,<verse eid="PRO 6:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 6:2"/>ನೀನು ನುಡಿದ ನಿನ್ನ ಬಾಯಿ ಮಾತುಗಳಿಂದಲೇ ಸಿಕ್ಕಿಕೊಂಡಿರುವೆ.</para>
  <para style="q2" vid="PRO 6:2">ನಿನ್ನ ಬಾಯಿ ಮಾತುಗಳೇ ನಿನ್ನನ್ನು ಸೆರೆಹಿಡಿದಿದೆ.<verse eid="PRO 6:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 6:3"/>ಮಗನೇ, ನೀನು ನಿನ್ನ ನೆರೆಯವನ ಕೈಗೆ ಸಿಕ್ಕಿಕೊಂಡದರಿಂದ,</para>
  <para style="q2" vid="PRO 6:3">ನಿನ್ನನ್ನು ನೀನು ತಪ್ಪಿಸಿಕೊಳ್ಳಲು ಇದನ್ನು ಮಾಡು:</para>
  <para style="q1" vid="PRO 6:3">ಹೋಗಿ ನಿನ್ನನ್ನು ನೀನು ತಗ್ಗಿಸಿಕೋ,</para>
  <para style="q2" vid="PRO 6:3">ನಿನ್ನ ನೆರೆಯವನಿಗೆ ವಿಶ್ರಾಂತಿಯನ್ನು ಕೊಡಬೇಡ.<verse eid="PRO 6:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 6:4"/>ನಿನ್ನ ಕಣ್ಣುಗಳಿಗೆ ನಿದ್ರೆಯನ್ನೂ</para>
  <para style="q2" vid="PRO 6:4">ನಿನ್ನ ರೆಪ್ಪೆಗಳಿಗೆ ತೂಕಡಿಕೆಯನ್ನೂ ಕೊಡಬೇಡ.<verse eid="PRO 6:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 6:5"/>ಬೇಟೆಗಾರನ ಕೈಯಿಂದ ಜಿಂಕೆಯೂ,</para>
  <para style="q2" vid="PRO 6:5">ಬಲೆ ಬೀಸುವವನ ಕೈಯಿಂದ ಪಕ್ಷಿಯೂ ತಪ್ಪಿಸಿಕೊಳ್ಳುವಂತೆ ನೀನು ತಪ್ಪಿಸಿಕೋ.<verse eid="PRO 6:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 6:6"/>ಸೋಮಾರಿಯೇ, ನೀನು ಇರುವೆಯ ಹತ್ತಿರ ಹೋಗಿ,</para>
  <para style="q2" vid="PRO 6:6">ಅದರ ನಡವಳಿಕೆಯನ್ನು ನೋಡಿ ಜ್ಞಾನವಂತನಾಗು.<verse eid="PRO 6:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 6:7"/>ನಾಯಕನಾಗಲೀ, ಮೇಲ್ವಿಚಾರಕನಾಗಲೀ,</para>
  <para style="q2" vid="PRO 6:7">ಅಧಿಕಾರಿಯಾಗಲೀ ಇರುವೆಗೆ ಇಲ್ಲದೆ ಹೋದರೂ,<verse eid="PRO 6:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 6:8"/>ಬೇಸಿಗೆಯಲ್ಲಿ ಅದು ತನ್ನ ಆಹಾರವನ್ನು ಸಂಗ್ರಹಿಸುತ್ತದೆ.</para>
  <para style="q2" vid="PRO 6:8">ಸುಗ್ಗಿಯಲ್ಲಿ ತನ್ನ ಆಹಾರವನ್ನು ಕೂಡಿಸಿಕೊಳ್ಳುತ್ತದೆ.<verse eid="PRO 6:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 6:9"/>ಸೋಮಾರಿಯೇ, ಎಷ್ಟು ಹೊತ್ತು ನೀನು ನಿದ್ರೆ ಮಾಡುವುದು?</para>
  <para style="q2" vid="PRO 6:9">ನಿನ್ನ ನಿದ್ರೆಯಿಂದ ಯಾವಾಗ ಎಚ್ಚರಗೊಳ್ಳುವೆ?<verse eid="PRO 6:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 6:10"/>ಇನ್ನು ಸ್ವಲ್ಪ ನಿದ್ರೆ, ಇನ್ನು ಸ್ವಲ್ಪ ತೂಕಡಿಕೆ,</para>
  <para style="q2" vid="PRO 6:10">ಇನ್ನೂ ಸ್ವಲ್ಪ ವಿಶ್ರಾಂತಿಗಾಗಿ ಕೈ ಮುದುರಿಕೊಳ್ಳುವೆ ಎನ್ನುವೆಯಾ?<verse eid="PRO 6:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 6:11"/>ಹೀಗೆ ನಿನಗೆ ಬಡತನವು ಕಳ್ಳನಂತೆಯೂ</para>
  <para style="q2" vid="PRO 6:11">ಕೊರತೆಯು ಶಸ್ತ್ರಧಾರಿಯಂತೆಯೂ ನಿನ್ನ ಮೇಲೆ ಬರುವುವು.<verse eid="PRO 6:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 6:12"/>ತೊಂದರೆಕೊಡುವವನೂ ಕೆಡುಕನೂ</para>
  <para style="q2" vid="PRO 6:12">ಆಗಿರುವವನ ಬಾಯಿಂದ ಕುಟಿಲ ಮಾತೇ ಬರುವುದು.<verse eid="PRO 6:12"/></para>
  <para style="q2">
    <verse number="13" style="v" sid="PRO 6:13"/>ಅವನು ಕಣ್ಣು ಮಿಟುಕಿಸುತ್ತಾನೆ,</para>
  <para style="q2" vid="PRO 6:13">ಕಾಲು ಕೆರೆಯುತ್ತಾನೆ,</para>
  <para style="q2" vid="PRO 6:13">ಬೆರಳು ಸನ್ನೆಮಾಡುತ್ತಾನೆ,<verse eid="PRO 6:13"/></para>
  <para style="q2">
    <verse number="14" style="v" sid="PRO 6:14"/>ಅವನು ತನ್ನ ಹೃದಯದಲ್ಲಿ ಮೋಸಕರ ಯೋಜನೆಯನ್ನೇ ಮಾಡುತ್ತಾನೆ;</para>
  <para style="q2" vid="PRO 6:14">ಯಾವಾಗಲೂ ಅವನು ಜಗಳವನ್ನು ಕಲ್ಪಿಸುತ್ತಾನೆ.<verse eid="PRO 6:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 6:15"/>ಆದ್ದರಿಂದ ಅವನಿಗೆ ವಿಪತ್ತು ಬೇಗ ಬರುವುದು;</para>
  <para style="q2" vid="PRO 6:15">ಯಾವ ಪರಿಹಾರವಿಲ್ಲದೆ ಅವನು ತಟ್ಟನೆ ನಾಶವಾಗುವನು.<verse eid="PRO 6:15"/></para>
  <para style="b"/>
  <para style="li1">
    <verse number="16" style="v" sid="PRO 6:16"/>ಈ ಆರು ವಿಷಯಗಳನ್ನು ಯೆಹೋವ ದೇವರು ಹಗೆ ಮಾಡುತ್ತಾರೆ;</para>
  <para style="li2" vid="PRO 6:16">ಹೌದು, ಏಳು ದೇವರಿಗೆ ಅಸಹ್ಯವಾಗಿವೆ, ಅವು ಯಾವವೆಂದರೆ:<verse eid="PRO 6:16"/></para>
  <para style="li3">
    <verse number="17" style="v" sid="PRO 6:17"/>ಹೆಮ್ಮೆಯ ದೃಷ್ಟಿ,</para>
  <para style="li3" vid="PRO 6:17">ಸುಳ್ಳಾಡುವ ನಾಲಿಗೆ,</para>
  <para style="li3" vid="PRO 6:17">ನಿರಪರಾಧಿಯ ರಕ್ತವನ್ನು ಸುರಿಸುವ ಕೈಗಳು,<verse eid="PRO 6:17"/></para>
  <para style="li3">
    <verse number="18" style="v" sid="PRO 6:18"/>ದುರಾಲೋಚನೆಗಳನ್ನು ಕಲ್ಪಿಸುವ ಹೃದಯ,</para>
  <para style="li3" vid="PRO 6:18">ಕೇಡಿಗೆ ನುಗ್ಗಲು ತ್ವರೆಪಡುವ ಕಾಲುಗಳು,<verse eid="PRO 6:18"/></para>
  <para style="li3">
    <verse number="19" style="v" sid="PRO 6:19"/>ಅಸತ್ಯವನ್ನಾಡುವ ಸುಳ್ಳುಸಾಕ್ಷಿ ಮತ್ತು</para>
  <para style="li3" vid="PRO 6:19">ಸಹೋದರರಲ್ಲಿ ಜಗಳ ಹುಟ್ಟಿಸುವ ವ್ಯಕ್ತಿ.<verse eid="PRO 6:19"/></para>
  <para style="s1">ವ್ಯಭಿಚಾರಕ್ಕೆ ವಿರುದ್ಧವಾಗಿ ಎಚ್ಚರಿಕೆ</para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 6:20"/>ಮಗನೇ, ನಿನ್ನ ತಂದೆಯ ಆಜ್ಞೆಯನ್ನು ಕೈಗೊಳ್ಳು,</para>
  <para style="q2" vid="PRO 6:20">ನಿನ್ನ ತಾಯಿಯ ಬೋಧನೆಯನ್ನು ತ್ಯಜಿಸಬೇಡ.<verse eid="PRO 6:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 6:21"/>ಅವುಗಳನ್ನು ಯಾವಾಗಲೂ ನಿನ್ನ ಹೃದಯದಲ್ಲಿ ಬಂಧಿಸಿಕೋ.</para>
  <para style="q2" vid="PRO 6:21">ಅವುಗಳನ್ನು ನಿನ್ನ ಕೊರಳಿಗೆ ಧರಿಸಿಕೋ.<verse eid="PRO 6:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 6:22"/>ನೀನು ನಡೆಯುವಾಗ ಅವು ನಿನಗೆ ಮಾರ್ಗದರ್ಶಿಯಾಗಿರುತ್ತವೆ.</para>
  <para style="q2" vid="PRO 6:22">ನೀನು ಮಲಗುವಾಗ ಅವು ನಿನ್ನನ್ನು ಕಾಯುತ್ತವೆ.</para>
  <para style="q2" vid="PRO 6:22">ನೀನು ಎಚ್ಚರಗೊಂಡಾಗ ಅವು ನಿನ್ನೊಂದಿಗೆ ಮಾತಾಡುತ್ತವೆ.<verse eid="PRO 6:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 6:23"/>ಆಜ್ಞೆಯೇ ದೀಪವಾಗಿದೆ,</para>
  <para style="q2" vid="PRO 6:23">ಬೋಧನೆಯೇ ಬೆಳಕಾಗಿದೆ;</para>
  <para style="q1" vid="PRO 6:23">ಶಿಕ್ಷಣದ ತಿದ್ದುವಿಕೆಗಳು</para>
  <para style="q2" vid="PRO 6:23">ಜೀವ ಮಾರ್ಗವಾಗಿವೆ.<verse eid="PRO 6:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 6:24"/>ಅವು ಕೆಟ್ಟ ಹೆಂಗಸಿನಿಂದಲೂ,</para>
  <para style="q2" vid="PRO 6:24">ಪರಸ್ತ್ರೀಯ ವಂಚಕ ಮಾತಿನಿಂದಲೂ ನಿನ್ನನ್ನು ತಪ್ಪಿಸಿ ಕಾಪಾಡಬಲ್ಲವು.<verse eid="PRO 6:24"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 6:25"/>ನಿನ್ನ ಹೃದಯ ಅವಳ ಸೌಂದರ್ಯವನ್ನು ಮೋಹಿಸದಿರಲಿ.</para>
  <para style="q2" vid="PRO 6:25">ಅವಳ ಕಣ್ಣುರೆಪ್ಪೆಗಳಿಂದ ಅವಳು ನಿನ್ನನ್ನು ವಶಮಾಡಿಕೊಳ್ಳದೆ ಇರಲಿ.<verse eid="PRO 6:25"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 6:26"/>ಏಕೆಂದರೆ ವೇಶ್ಯೆಯನ್ನು ಊಟದಿಂದ ಕೊಂಡುಕೊಳ್ಳಬಹುದು,</para>
  <para style="q2" vid="PRO 6:26">ಆದರೆ ವ್ಯಭಿಚಾರಿಣಿ ಅಮೂಲ್ಯ ಜೀವವನ್ನೇ ಬೇಟೆಯಾಡುವಳು.<verse eid="PRO 6:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 6:27"/>ಒಬ್ಬನು ತನ್ನ ಮಡಿಲಲ್ಲಿ ಬೆಂಕಿಯನ್ನು ಇಟ್ಟುಕೊಂಡರೆ,</para>
  <para style="q2" vid="PRO 6:27">ಅವನ ವಸ್ತ್ರಗಳು ಸುಡುವುದಿಲ್ಲವೋ?<verse eid="PRO 6:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 6:28"/>ಒಬ್ಬನು ಧಗಧಗಿಸುವ ಕೆಂಡದ ಮೇಲೆ ನಡೆದರೆ,</para>
  <para style="q2" vid="PRO 6:28">ಅವನ ಪಾದಗಳು ಸುಡುವುದಿಲ್ಲವೋ?<verse eid="PRO 6:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 6:29"/>ಪರನ ಹೆಂಡತಿಯನ್ನು ಕೂಡುವವನ ಗತಿಯು ಹೀಗೆಯೇ ಇರುವದು.</para>
  <para style="q2" vid="PRO 6:29">ಅವಳನ್ನು ಮುಟ್ಟುವ ಯಾವನೂ ದಂಡನೆಯಿಂದ ತಪ್ಪಿಸಿಕೊಳ್ಳನು.<verse eid="PRO 6:29"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="30" style="v" sid="PRO 6:30"/>ಹಸಿದಾಗ ಕಳ್ಳನು ತನ್ನ ಹಸಿವೆಯನ್ನು ತೃಪ್ತಿಪಡಿಸಲು ಕಳವು ಮಾಡಿದರೆ,</para>
  <para style="q2" vid="PRO 6:30">ಜನರು ಅವನನ್ನು ಹೀಯಾಳಿಸುವುದಿಲ್ಲ.<verse eid="PRO 6:30"/></para>
  <para style="q1">
    <verse number="31" style="v" sid="PRO 6:31"/>ಅವನು ಸಿಕ್ಕಿಕೊಂಡರೆ ಏಳರಷ್ಟು ಹಿಂದಕ್ಕೆ ಕೊಡಬೇಕಾಗುವುದು.</para>
  <para style="q2" vid="PRO 6:31">ತನ್ನ ಮನೆಯ ಆಸ್ತಿಯನ್ನೆಲ್ಲಾ ಸಹ ಅವನು ಕೊಡಬೇಕಾಗುವುದು.<verse eid="PRO 6:31"/></para>
  <para style="q1">
    <verse number="32" style="v" sid="PRO 6:32"/>ವ್ಯಭಿಚಾರಿಯು ಬುದ್ಧಿಹೀನನಾಗಿದ್ದಾನೆ.</para>
  <para style="q2" vid="PRO 6:32">ಹಾಗೆ ಮಾಡುವವನು ತನ್ನನ್ನೇ ನಾಶಮಾಡಿಕೊಳ್ಳುವನು.<verse eid="PRO 6:32"/></para>
  <para style="q1">
    <verse number="33" style="v" sid="PRO 6:33"/>ಅವನಿಗೆ ಗಾಯವೂ ಅವಮಾನವೂ ಆಗುತ್ತವೆ.</para>
  <para style="q2" vid="PRO 6:33">ಅವನ ನಿಂದೆಯು ಎಂದಿಗೂ ಅಳಿಸಲಾಗದು.<verse eid="PRO 6:33"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="34" style="v" sid="PRO 6:34"/>ಏಕೆಂದರೆ ಮತ್ಸರವು ಪತಿಯ ಕ್ರೋಧವನ್ನು ಉದ್ರೇಕಿಸುವುದು.</para>
  <para style="q2" vid="PRO 6:34">ಆದ್ದರಿಂದ ಮುಯ್ಯಿ ತೀರಿಸುವಾಗ ಅವನು ಕರುಣೆ ತೋರನು.<verse eid="PRO 6:34"/></para>
  <para style="q1">
    <verse number="35" style="v" sid="PRO 6:35"/>ಅವನು ಯಾವ ಪರಿಹಾರವನ್ನು ಒಪ್ಪುವುದಿಲ್ಲ;</para>
  <para style="q2" vid="PRO 6:35">ಎಷ್ಟು ದೊಡ್ಡ ಲಂಚ ಕೊಟ್ಟರೂ ಅವನು ಅದನ್ನು ತಿರಸ್ಕರಿಸುವನು.<verse eid="PRO 6:35"/></para>
  <chapter eid="PRO 6"/>
  <chapter number="7" style="c" sid="PRO 7"/>
  <para style="s1">ವ್ಯಭಿಚಾರಿಣಿಯ ವಿರುದ್ಧ ಎಚ್ಚರಿಕೆ</para>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 7:1"/>ಮಗನೇ, ನನ್ನ ಮಾತುಗಳನ್ನು ಅನುಸರಿಸಿ,</para>
  <para style="q2" vid="PRO 7:1">ನನ್ನ ಆಜ್ಞೆಗಳನ್ನು ನಿನ್ನಲ್ಲಿ ಇಟ್ಟುಕೋ.<verse eid="PRO 7:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 7:2"/>ನನ್ನ ಆಜ್ಞೆಗಳನ್ನು ಅನುಸರಿಸಿ ಬಾಳು;</para>
  <para style="q2" vid="PRO 7:2">ನಿನ್ನ ಕಣ್ಣುಗುಡ್ಡೆಯಂತೆ ನನ್ನ ಕಟ್ಟಳೆಗಳನ್ನು ಕಾಪಾಡು.<verse eid="PRO 7:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 7:3"/>ಅವುಗಳನ್ನು ನಿನ್ನ ಬೆರಳುಗಳಿಗೆ ಉಂಗುರವಾಗಿಟ್ಟುಕೋ;</para>
  <para style="q2" vid="PRO 7:3">ನಿನ್ನ ಹೃದಯದ ಹಲಗೆಯಲ್ಲಿ ಅವುಗಳನ್ನು ಬರೆ.<verse eid="PRO 7:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 7:4"/>ಜ್ಞಾನಕ್ಕೆ, “ನೀನು ನನ್ನ ಸಹೋದರಿ,” ಎಂದೂ,</para>
  <para style="q2" vid="PRO 7:4">ಒಳನೋಟಕ್ಕೆ, “ನನ್ನ ಬಂಧು” ಎಂದೂ ಹೇಳು.<verse eid="PRO 7:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 7:5"/>ಅವು ವ್ಯಭಿಚಾರಿಣಿಯಿಂದಲೂ</para>
  <para style="q2" vid="PRO 7:5">ಸವಿಮಾತನಾಡುವ ದಾರಿತಪ್ಪಿದ ಸ್ತ್ರೀಯಿಂದಲೂ ನಿನ್ನನ್ನು ಕಾಪಾಡುತ್ತವೆ.<verse eid="PRO 7:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 7:6"/>ನಾನು ನನ್ನ ಮನೆಯ ಕಿಟಿಕಿಯ</para>
  <para style="q2" vid="PRO 7:6">ಜಾಲರಿಯಿಂದ ಇಣಕಿ ನೋಡಿದಾಗ,<verse eid="PRO 7:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 7:7"/>ಮುಗ್ಧರ ನಡುವೆ,</para>
  <para style="q2" vid="PRO 7:7">ಯುವಕರ ಮಧ್ಯದಲ್ಲಿ,</para>
  <para style="q2" vid="PRO 7:7">ತಿಳುವಳಿಕೆಯಿಲ್ಲದ ಯೌವನಸ್ಥನನ್ನು ಕಂಡೆನು.<verse eid="PRO 7:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 7:8"/>ಅವನು ಅವಳ ಮೂಲೆ ಮನೆಯ ದಿಕ್ಕಿನಲ್ಲಿ</para>
  <para style="q2" vid="PRO 7:8">ಬೀದಿಯಿಂದ ಹಾದುಹೋಗುತ್ತಿದ್ದನು.<verse eid="PRO 7:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 7:9"/>ಸಂಜೆಯ ಮಬ್ಬಿನಲ್ಲಿ</para>
  <para style="q2" vid="PRO 7:9">ರಾತ್ರಿಯ ಕತ್ತಲೆಯು ಕವಿಯುತ್ತಿತ್ತು.<verse eid="PRO 7:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 7:10"/>ಇಗೋ, ವೇಶ್ಯೆಯ ವಸ್ತ್ರವನ್ನು ಧರಿಸಿಕೊಂಡು</para>
  <para style="q2" vid="PRO 7:10">ಒಬ್ಬ ಕಪಟ ಸ್ತ್ರೀಯು ಅವನನ್ನು ಎದುರುಗೊಂಡಳು.<verse eid="PRO 7:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 7:11"/>ಅವಳು ಕೂಗಾಟದವಳು, ಹಟಮಾರಿ;</para>
  <para style="q2" vid="PRO 7:11">ಅವಳ ಪಾದಗಳು ಮನೆಯಲ್ಲಿ ನಿಲ್ಲುವುದೇ ಇಲ್ಲ.<verse eid="PRO 7:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 7:12"/>ಒಮ್ಮೆ ಬೀದಿಯಲ್ಲಿ ಮತ್ತೊಮ್ಮೆ ಚೌಕಗಳಲ್ಲಿ ಹೀಗೆ</para>
  <para style="q2" vid="PRO 7:12">ಅವಳು ಮೂಲೆ ಮೂಲೆಗೂ ಹೊಂಚು ಹಾಕುತ್ತಾಳೆ.<verse eid="PRO 7:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 7:13"/>ಅವಳು ಆ ಯುವಕನನ್ನು ಹಿಡಿದುಕೊಂಡು ಮುದ್ದಿಟ್ಟು,</para>
  <para style="q2" vid="PRO 7:13">ನಾಚಿಕೆಯಿಲ್ಲದೆ ಅವಳು ಹೀಗೆನ್ನುತ್ತಾಳೆ:<verse eid="PRO 7:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 7:14"/>“ಈ ದಿವಸ ನನ್ನ ಹರಕೆಗಳನ್ನು ನಾನು ಸಲ್ಲಿಸಿದ್ದೇನೆ.</para>
  <para style="q2" vid="PRO 7:14">ನಾನು ನನ್ನ ಸಮಾಧಾನದ ಯಜ್ಞವನ್ನು ಅರ್ಪಿಸಿದ್ದೇನೆ.<verse eid="PRO 7:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 7:15"/>ಆದಕಾರಣ ನಾನು ನಿನ್ನನ್ನು ಎದುರುಗೊಳ್ಳುವುದಕ್ಕೆ ಬಂದೆನು;</para>
  <para style="q2" vid="PRO 7:15">ಅತ್ಯಾಶೆಯಿಂದ ನಿನ್ನನ್ನು ಹುಡುಕಿ ಕಂಡುಕೊಂಡಿದ್ದೇನೆ.<verse eid="PRO 7:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 7:16"/>ಈಜಿಪ್ಟಿನ ನಯವಾದ ನಾರು ಮಡಿಯಿಂದಲೂ</para>
  <para style="q2" vid="PRO 7:16">ನನ್ನ ಹಾಸಿಗೆಯನ್ನು ಅಲಂಕರಿಸಿದ್ದೇನೆ.<verse eid="PRO 7:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 7:17"/>ರಕ್ತಬೋಳ, ಅಗರು, ಲವಂಗ, ಚಕ್ಕೆಗಳಿಂದ</para>
  <para style="q2" vid="PRO 7:17">ನನ್ನ ಹಾಸಿಗೆಯನ್ನು ಸುವಾಸನೆಗೊಳಿಸಿದ್ದೇನೆ.<verse eid="PRO 7:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 7:18"/>ಬಾ, ಬೆಳಗಿನವರೆಗೂ ತೃಪ್ತಿಯಾಗುವ ತನಕ</para>
  <para style="q2" vid="PRO 7:18">ಪ್ರೀತಿಯ ವಶದಲ್ಲಿ ತುಂಬಿಕೊಂಡು ಕಾಮ ವಿಲಾಸಗಳಿಂದ ನಾವು ಸಂತೋಷಿಸೋಣ.<verse eid="PRO 7:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 7:19"/>ಏಕೆಂದರೆ ಯಜಮಾನನು ಮನೆಯಲ್ಲಿ ಇಲ್ಲ;</para>
  <para style="q2" vid="PRO 7:19">ಅವನು ದೀರ್ಘ ಪ್ರಯಾಣದಲ್ಲಿದ್ದಾನೆ.<verse eid="PRO 7:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 7:20"/>ಅವನು ತನ್ನೊಂದಿಗೆ ಹಣದ ಗಂಟನ್ನು ತೆಗೆದುಕೊಂಡು ಹೋಗಿದ್ದಾನೆ;</para>
  <para style="q2" vid="PRO 7:20">ಹುಣ್ಣಿಮೆಗೆ ಮುಂಚೆ ಅವನು ಮನೆಗೆ ಬರುವುದಿಲ್ಲ.”<verse eid="PRO 7:20"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 7:21"/>ಮನವೊಲಿಸುವ ಮಾತುಗಳಿಂದ ಅವಳು ಅವನನ್ನು ದಾರಿ ತಪ್ಪಿಸಿ,</para>
  <para style="q2" vid="PRO 7:21">ಅವಳು ತನ್ನ ಮೋಹಕ ಮಾತುಗಳಿಂದ ಅವನನ್ನು ಆಕರ್ಷಿಸುತ್ತಾಳೆ.<verse eid="PRO 7:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 7:22"/>ಎತ್ತು ವಧೆಯ ಸ್ಥಾನಕ್ಕೆ ಹೋಗುವಂತೆ,</para>
  <para style="q2" vid="PRO 7:22">ಅಥವಾ ಜಿಂಕೆಯು<note caller="+" style="f"><char style="fr" closed="false">7:22 </char><char style="fq" closed="false">ಜಿಂಕೆಯು </char><char style="ft" closed="false">ಹಿಬ್ರೂವಿನಲ್ಲಿ ಮಾಡಿದ ಭಾಷಾಂತರ </char><char style="fqa" closed="false">ಮೂರ್ಖನು</char></note> ಬಲೆಗೆ ಸಿಕ್ಕಿಬೀಳುವಂತೆ,<verse eid="PRO 7:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 7:23"/>ಅವನು ತನ್ನ ಪ್ರಾಣವು ಅಪಾಯದಲ್ಲಿರುವುದನ್ನು ತಿಳಿಯದೆ,</para>
  <para style="q1" vid="PRO 7:23">ಒಂದು ಬಾಣವು ತನ್ನ ಕಾಳಿಜವನ್ನು ತಿವಿಯುವವರೆಗೆ,</para>
  <para style="q2" vid="PRO 7:23">ಪಕ್ಷಿಯು ಬಲೆಯ ಕಡೆಗೆ ಓಡುವ ಹಾಗೆ ಅವನು ತಟ್ಟನೆ ಅವಳ ಹಿಂದೆ ಹೋಗುತ್ತಾನೆ.<verse eid="PRO 7:23"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 7:24"/>ಆದ್ದರಿಂದ ನನ್ನ ಮಕ್ಕಳೇ, ನನಗೆ ಕಿವಿಗೊಡಿರಿ,</para>
  <para style="q2" vid="PRO 7:24">ನನ್ನ ಮಾತುಗಳನ್ನು ಆಲಿಸಿರಿ.<verse eid="PRO 7:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 7:25"/>ಅವಳ ಮಾರ್ಗಗಳಿಗೆ ನಿಮ್ಮ ಹೃದಯವು ತಿರುಗದೆ ಇರಲಿ;</para>
  <para style="q2" vid="PRO 7:25">ತಪ್ಪಿಯೂ ಅವಳ ದಾರಿಯಲ್ಲಿ ಹೋಗಬೇಡಿರಿ.<verse eid="PRO 7:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 7:26"/>ಏಕೆಂದರೆ ಅನೇಕರು ಅವಳಿಗೆ ಬಲಿಯಾಗಿ ಬಿದ್ದಿದ್ದಾರೆ.</para>
  <para style="q2" vid="PRO 7:26">ಬಲಿಷ್ಠರಾದ ಅನೇಕ ಪುರುಷರು ಅವಳಿಂದ ಹತರಾಗಿದ್ದಾರೆ.<verse eid="PRO 7:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 7:27"/>ಅವಳ ಮನೆಯು ಪಾತಾಳಕ್ಕೆ ಹೆದ್ದಾರಿ,</para>
  <para style="q2" vid="PRO 7:27">ಅದು ಮೃತ್ಯುವಿನ ಕೊಠಡಿಗೆ ಇಳಿದು ಹೋಗುತ್ತದೆ.<verse eid="PRO 7:27"/></para>
  <chapter eid="PRO 7"/>
  <chapter number="8" style="c" sid="PRO 8"/>
  <para style="s1">ಜ್ಞಾನದ ಕರೆ</para>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 8:1"/>ಜ್ಞಾನವು ಕರೆಯುತ್ತದಲ್ಲವೋ?</para>
  <para style="q2" vid="PRO 8:1">ತಿಳುವಳಿಕೆ ಎಂಬಾಕೆಯು ತನ್ನ ಸ್ವರವನ್ನು ಎತ್ತಿ ಕೂಗಿ ಕರೆಯುವುದಿಲ್ಲವೋ?<verse eid="PRO 8:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 8:2"/>ಉನ್ನತ ಸ್ಥಳಗಳ ತುದಿಯಲ್ಲಿಯೂ,</para>
  <para style="q2" vid="PRO 8:2">ಹಾದಿಗಳ ಸಂಧಿಗಳಲ್ಲಿಯೂ ನಿಂತುಕೊಳ್ಳುತ್ತಾಳೆ.<verse eid="PRO 8:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 8:3"/>ಪಟ್ಟಣದ ಪ್ರವೇಶ ದ್ವಾರಗಳಲ್ಲಿಯೂ</para>
  <para style="q2" vid="PRO 8:3">ಒಳಗೆ ಬರುವಾಗ ಅವಳು ಸ್ವರವೆತ್ತಿ ಹೇಳುವುದೇನೆಂದರೆ,<verse eid="PRO 8:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 8:4"/>“ಮನುಷ್ಯರೇ, ನಾನು ಕರೆಯುತ್ತಿರುವುದು ನಿಮ್ಮನ್ನೇ,</para>
  <para style="q2" vid="PRO 8:4">ಮಾನವರಿಗಾಗಿಯೇ ನಾನು ಧ್ವನಿಗೈಯುತ್ತೇನೆ.<verse eid="PRO 8:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 8:5"/>ಮುಗ್ಧರೇ, ಜ್ಞಾನವನ್ನು ಗ್ರಹಿಸಿರಿ.</para>
  <para style="q2" vid="PRO 8:5">ಬುದ್ಧಿಹೀನರೇ, ನೀವು ತಿಳುವಳಿಕೆಯ ಹೃದಯದವರಾಗಿರಿ.<verse eid="PRO 8:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 8:6"/>ಕೇಳಿರಿ, ಉತ್ಕೃಷ್ಟ ಸಂಗತಿಗಳನ್ನು ನಾನು ಮಾತಾಡುವೆನು;</para>
  <para style="q2" vid="PRO 8:6">ನ್ಯಾಯವಾದ ಸಂಗತಿಗಳಿಗಾಗಿ ನನ್ನ ತುಟಿಗಳನ್ನು ತೆರೆಯುವೆನು.<verse eid="PRO 8:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 8:7"/>ನನ್ನ ಬಾಯಿಯು ಸತ್ಯವನ್ನು ಮಾತಾಡುವುದು;</para>
  <para style="q2" vid="PRO 8:7">ನನ್ನ ತುಟಿಗಳಿಗೆ ಕೆಟ್ಟತನವು ಅಸಹ್ಯವಾಗಿದೆ.<verse eid="PRO 8:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 8:8"/>ನನ್ನ ಬಾಯಿಯ ಮಾತುಗಳೆಲ್ಲಾ ನೀತಿಯುಕ್ತವಾಗಿವೆ;</para>
  <para style="q2" vid="PRO 8:8">ಮೂರ್ಖತನವಾಗಲಿ, ವಕ್ರತೆಯಾಗಲಿ ಅವುಗಳಲ್ಲಿ ಇಲ್ಲ.<verse eid="PRO 8:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 8:9"/>ವಿವೇಚಿಸುವವನಿಗೆ ನನ್ನ ಎಲ್ಲ ಮಾತುಗಳು ನೇರವಾಗಿರುವುದು.</para>
  <para style="q2" vid="PRO 8:9">ತಿಳುವಳಿಕೆ ಉಳ್ಳವನಿಗೆ ಅವು ಪ್ರಾಮಾಣಿಕವಾಗಿಯೂ ಇರುವುದು.<verse eid="PRO 8:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 8:10"/>ಬೆಳ್ಳಿಗಿಂತ ನನ್ನ ಬೋಧನೆಯನ್ನು ಆರಿಸಿಕೋ</para>
  <para style="q2" vid="PRO 8:10">ಉತ್ತಮ ಬಂಗಾರಕ್ಕಿಂತ ಮಿಗಿಲಾದ ತಿಳುವಳಿಕೆಯನ್ನು ಪಡೆದುಕೋ.<verse eid="PRO 8:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 8:11"/>ಏಕೆಂದರೆ ಮಾಣಿಕ್ಯಗಳಿಗಿಂತ ಜ್ಞಾನವು ಅಮೂಲ್ಯವಾದದ್ದು.</para>
  <para style="q2" vid="PRO 8:11">ಅಪೇಕ್ಷಿಸತಕ್ಕ ಯಾವ ವಸ್ತುಗಳನ್ನು ಅದಕ್ಕೆ ಹೋಲಿಸಲಾಗದು.<verse eid="PRO 8:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 8:12"/>“ಜ್ಞಾನವೆಂಬ ನಾನು ವಿವೇಕದೊಂದಿಗೆ ವಾಸವಾಗಿದ್ದೇನೆ.</para>
  <para style="q2" vid="PRO 8:12">ತಿಳುವಳಿಕೆಯನ್ನೂ ವಿವೇಚನೆಯನ್ನೂ ನಾನು ಹೊಂದಿದ್ದೇನೆ.<verse eid="PRO 8:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 8:13"/>ಕೆಟ್ಟದ್ದನ್ನು ಹಗೆ ಮಾಡುವುದೇ ಯೆಹೋವ ದೇವರ ಭಯವಾಗಿದೆ;</para>
  <para style="q2" vid="PRO 8:13">ಗರ್ವ, ಅಹಂಕಾರ, ಕೆಟ್ಟನಡವಳಿಕೆ,</para>
  <para style="q2" vid="PRO 8:13">ವಕ್ರ ಭಾಷಣಗಳನ್ನು ನಾನು ಹಗೆಮಾಡುತ್ತೇನೆ.<verse eid="PRO 8:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 8:14"/>ಸಮಾಲೋಚನೆಯೂ ಒಳ್ಳೆಯ ನ್ಯಾಯವೂ ನನ್ನಲ್ಲಿದೆ.</para>
  <para style="q2" vid="PRO 8:14">ನನ್ನಲ್ಲಿ ಒಳನೋಟವೂ ಶಕ್ತಿಯೂ ಇವೆ.<verse eid="PRO 8:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 8:15"/>ನನ್ನ ಮೂಲಕ ರಾಜರು ಆಳುವರು;</para>
  <para style="q2" vid="PRO 8:15">ಪ್ರಧಾನರು ನ್ಯಾಯವಾದ ತೀರ್ಪು ಕೊಡುವರು.<verse eid="PRO 8:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 8:16"/>ನನ್ನಿಂದ ಅಧಿಪತಿಗಳು ಆಳುತ್ತಾರೆ,</para>
  <para style="q2" vid="PRO 8:16">ಕೀರ್ತಿವಂತರೆಲ್ಲರೂ ಭೂಮಿಯ ಮೇಲೆ ಆಳುವರು.<verse eid="PRO 8:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 8:17"/>ನನ್ನನ್ನು ಪ್ರೀತಿಸುವವರನ್ನು ನಾನು ಪ್ರೀತಿಸುತ್ತೇನೆ;</para>
  <para style="q2" vid="PRO 8:17">ಹಂಬಲಿಸಿ ನನ್ನನ್ನು ಹುಡುಕುವವರು ನನ್ನನ್ನು ಕಂಡುಕೊಳ್ಳುವರು.<verse eid="PRO 8:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 8:18"/>ಐಶ್ವರ್ಯವೂ ಘನತೆಯೂ,</para>
  <para style="q2" vid="PRO 8:18">ಶಾಶ್ವತ ಸಂಪತ್ತು ಹಾಗೂ ಸಮೃದ್ಧಿಯು ನನ್ನೊಂದಿಗಿವೆ.<verse eid="PRO 8:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 8:19"/>ನನ್ನ ಫಲವು ಬಂಗಾರಕ್ಕಿಂತಲೂ,</para>
  <para style="q2" vid="PRO 8:19">ನನ್ನ ಆದಾಯವು ಉತ್ತಮವಾದ ಬೆಳ್ಳಿಗಿಂತಲೂ ಶ್ರೇಷ್ಠವಾಗಿವೆ.<verse eid="PRO 8:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 8:20"/>ನೀತಿಯ ಮಾರ್ಗದಲ್ಲಿಯೂ</para>
  <para style="q2" vid="PRO 8:20">ನ್ಯಾಯದ ದಾರಿ ನಡುವೆಯೂ ನಾನು ನಡೆಯುತ್ತೇನೆ.<verse eid="PRO 8:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 8:21"/>ನನ್ನನ್ನು ಪ್ರೀತಿಸುವವರು ಸಂಪತ್ತನ್ನು ಬಾಧ್ಯವಾಗಿ ಹೊಂದುವರು.</para>
  <para style="q2" vid="PRO 8:21">ನಾನು ಅವರ ಬೊಕ್ಕಸಗಳನ್ನು ತುಂಬಿಸುವೆನು.<verse eid="PRO 8:21"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 8:22"/>“ಯೆಹೋವ ದೇವರು ತಮ್ಮ ಸೃಷ್ಟಿಕ್ರಮದಲ್ಲಿ ನನ್ನನ್ನು ಮೊದಲು ನಿರ್ಮಿಸಿದರು,</para>
  <para style="q2" vid="PRO 8:22">ದೇವರ ಪುರಾತನ ಕಾರ್ಯಗಳಲ್ಲಿ ನಾನೇ ಮೊದಲು;<verse eid="PRO 8:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 8:23"/>ಪ್ರಾರಂಭದಲ್ಲಿ ಜಗದುತ್ಪತ್ತಿಗೆ ಮುಂಚೆಯೇ</para>
  <para style="q2" vid="PRO 8:23">ಅನಾದಿಕಾಲದಲ್ಲಿ ದೇವರು ನನ್ನನ್ನು ಸೃಷ್ಟಿಸಿದರು.<verse eid="PRO 8:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 8:24"/>ಆಗಾಧಗಳು ಇಲ್ಲದೆ ಇರುವಾಗ ನಾನು ಹುಟ್ಟಿ ಬಂದೆನು,</para>
  <para style="q2" vid="PRO 8:24">ನೀರಿನ ಬುಗ್ಗೆಗಳು ಇಲ್ಲದೆ ಇರುವಾಗಲೇ ನಾನಿದ್ದೆನು.<verse eid="PRO 8:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 8:25"/>ಪರ್ವತಗಳು ಸ್ಥಾಪಿತವಾಗುವುದಕ್ಕಿಂತ ಮುಂಚೆಯೂ</para>
  <para style="q2" vid="PRO 8:25">ಬೆಟ್ಟಗುಡ್ಡಗಳಿಗಿಂತ ಮೊದಲು ನಾನು ಜನಿಸಿದೆನು.<verse eid="PRO 8:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 8:26"/>ಭೂಮಿಯನ್ನೂ ಹೊಲಗಳನ್ನೂ ಲೋಕದ ಅಣುಗಳನ್ನೂ</para>
  <para style="q2" vid="PRO 8:26">ಅವರು ನಿರ್ಮಿಸದೆ ಇರುವಾಗಲೇ ನಾನು ಜನಿಸಿದೆನು.<verse eid="PRO 8:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 8:27"/>ಅವರು ಆಕಾಶಗಳನ್ನು ಸಿದ್ಧಪಡಿಸಿದಾಗ</para>
  <para style="q2" vid="PRO 8:27">ಸಾಗರದ ಮೇಲೆ ಚಕ್ರವನ್ನು ಹಾಕಿದಾಗ,<verse eid="PRO 8:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 8:28"/>ಮೇಲೆ ಮೇಘಗಳನ್ನು ಅವರು ಸ್ಥಾಪಿಸಿದಾಗ</para>
  <para style="q2" vid="PRO 8:28">ಅಗಾಧದ ಬುಗ್ಗೆಗಳನ್ನು ಅವರು ಬಲಪಡಿಸಿದಾಗ,<verse eid="PRO 8:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 8:29"/>ಪ್ರವಾಹಗಳು ತನ್ನ ಆಜ್ಞೆಯನ್ನು ಮೀರದಂತೆ ಸಮುದ್ರಕ್ಕೆ</para>
  <para style="q2" vid="PRO 8:29">ಅವರು ಮೇರೆಯನ್ನು ಮಾಡಿ</para>
  <para style="q1" vid="PRO 8:29">ಭೂಮಿಯ ಅಸ್ತಿವಾರಗಳನ್ನು ನೇಮಿಸಿದಾಗ, ನಾನು ಅಲ್ಲಿ ಇದ್ದೆನು.<verse eid="PRO 8:29"/></para>
  <para style="q2">
    <verse number="30" style="v" sid="PRO 8:30"/>ಆಗ ನಾನು ಅವರೊಂದಿಗೆ ಕುಶಲ ಶಿಲ್ಪಿಯಂತೆ</para>
  <para style="q1" vid="PRO 8:30">ಅವರ ಹತ್ತಿರ ಇದ್ದೆನು.</para>
  <para style="q2" vid="PRO 8:30">ಅವರ ಸನ್ನಿಧಿಯಲ್ಲಿ ಯಾವಾಗಲೂ ಆನಂದಿಸುತ್ತಾ ಅನುದಿನವೂ ಸಂತೋಷಿಸುತ್ತಿದ್ದೆನು.<verse eid="PRO 8:30"/></para>
  <para style="q1">
    <verse number="31" style="v" sid="PRO 8:31"/>ಅವರ ಭೂಮಿಯ ವಾಸಸ್ಥಳದ ಭಾಗದಲ್ಲಿ ಸಂತೋಷಿಸುತ್ತಿದ್ದೆನು;</para>
  <para style="q2" vid="PRO 8:31">ಮಾನವರೊಂದಿಗೆ ಆನಂದಿಸುತ್ತಿದ್ದೆನು.<verse eid="PRO 8:31"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="32" style="v" sid="PRO 8:32"/>“ಆದ್ದರಿಂದ ಮಕ್ಕಳೇ, ಈಗ ನನ್ನ ಕಡೆಗೆ ಕಿವಿಗೊಡಿರಿ;</para>
  <para style="q2" vid="PRO 8:32">ನನ್ನ ಮಾರ್ಗಗಳನ್ನು ಅನುಸರಿಸುವವರು ಧನ್ಯರು.<verse eid="PRO 8:32"/></para>
  <para style="q1">
    <verse number="33" style="v" sid="PRO 8:33"/>ನನ್ನ ಬೋಧನೆಯನ್ನು ಕೇಳಿ ಬುದ್ಧಿವಂತರಾಗಿರಿ;</para>
  <para style="q2" vid="PRO 8:33">ಅದನ್ನು ನೀವು ತಿರಸ್ಕರಿಸಬೇಡಿರಿ.<verse eid="PRO 8:33"/></para>
  <para style="q1">
    <verse number="34" style="v" sid="PRO 8:34"/>ನನ್ನ ದ್ವಾರಗಳ ಬಳಿಯಲ್ಲಿ ಪ್ರತಿದಿನ ಕಾಯುತ್ತಾ,</para>
  <para style="q2" vid="PRO 8:34">ನನ್ನ ಬಾಗಿಲುಗಳ ನಿಲುವುಗಳಲ್ಲಿ ನಿರೀಕ್ಷಿಸುತ್ತಾ,</para>
  <para style="q2" vid="PRO 8:34">ನನ್ನ ಮಾತುಗಳನ್ನು ಕೇಳುವವರು ಧನ್ಯರು.<verse eid="PRO 8:34"/></para>
  <para style="q1">
    <verse number="35" style="v" sid="PRO 8:35"/>ಏಕೆಂದರೆ ನನ್ನನ್ನು ಕಂಡುಕೊಳ್ಳುವವನು ಜೀವವನ್ನು ಕಂಡುಕೊಂಡು</para>
  <para style="q2" vid="PRO 8:35">ಯೆಹೋವ ದೇವರ ಕೃಪೆಯನ್ನು ಹೊಂದುವನು.<verse eid="PRO 8:35"/></para>
  <para style="q1">
    <verse number="36" style="v" sid="PRO 8:36"/>ಆದರೆ ನನ್ನನ್ನು ಬಿಟ್ಟು ದೂರಹೋಗುವವನು</para>
  <para style="q2" vid="PRO 8:36">ತನ್ನ ಸ್ವಂತ ಪ್ರಾಣಕ್ಕೆ ಕೇಡುಮಾಡಿಕೊಳ್ಳುತ್ತಾನೆ,</para>
  <para style="q2" vid="PRO 8:36">ನನ್ನನ್ನು ಹಗೆಮಾಡುವವರೆಲ್ಲರೂ ಮರಣವನ್ನು ಪ್ರೀತಿಸುತ್ತಾರೆ.”<verse eid="PRO 8:36"/></para>
  <chapter eid="PRO 8"/>
  <chapter number="9" style="c" sid="PRO 9"/>
  <para style="s1">ಜ್ಞಾನದ ಹಾಗೂ ಮೂರ್ಖತನದ ಕರೆ</para>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 9:1"/>ಜ್ಞಾನ ಎಂಬಾಕೆಯು ತನ್ನ ಮನೆಯನ್ನು ಕಟ್ಟಿಕೊಂಡಿದ್ದಾಳೆ;</para>
  <para style="q2" vid="PRO 9:1">ಆಕೆಯು ತನ್ನ ಏಳು ಕಂಬಗಳನ್ನು ಕೆತ್ತಿಸಿದ್ದಾಳೆ.<verse eid="PRO 9:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 9:2"/>ಆಕೆಯು ಮಾಂಸದ ಆಹಾರನ್ನು ತಯಾರಿಸಿ, ತನ್ನ ದ್ರಾಕ್ಷಾರಸವನ್ನು ಬೆರೆಸಿ,</para>
  <para style="q2" vid="PRO 9:2">ತನ್ನ ಮೇಜನ್ನು ಸಹ ಸಿದ್ಧಪಡಿಸಿದಳು.<verse eid="PRO 9:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 9:3"/>ಆಕೆಯು ತನ್ನ ದಾಸಿಯರನ್ನು ಕಳುಹಿಸುತ್ತಾಳೆ;</para>
  <para style="q2" vid="PRO 9:3">ಆಕೆಯು ಪಟ್ಟಣದ ಅತಿ ಉನ್ನತ ಸ್ಥಳದಿಂದ ಕೂಗುತ್ತಾಳೆ,<verse eid="PRO 9:3"/></para>
  <para style="q2">
    <verse number="4" style="v" sid="PRO 9:4"/>“ಯಾರು ಮುಗ್ಧರೋ ಅವರು ನನ್ನ ಮನೆಗೆ ಬರಲಿ,”</para>
  <para style="q1" vid="PRO 9:4">ಬುದ್ಧಿ ಇಲ್ಲದೆ ಇರುವವನಿಗೆ ಆಕೆಯು ಹೇಳುತ್ತಾಳೆ,<verse eid="PRO 9:4"/></para>
  <para style="q2">
    <verse number="5" style="v" sid="PRO 9:5"/>“ಬಾ, ನನ್ನ ಆಹಾರವನ್ನು ತಿಂದು,</para>
  <para style="q2" vid="PRO 9:5">ನಾನು ಬೆರೆಸಿದ ದ್ರಾಕ್ಷಾರಸವನ್ನು ಕುಡಿ,” ಎಂದೂ<verse eid="PRO 9:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 9:6"/>“ನಿಮ್ಮ ಮೂಢತ್ವವನ್ನು ಬಿಟ್ಟು ಬಾಳಿರಿ</para>
  <para style="q2" vid="PRO 9:6">ಮತ್ತು ವಿವೇಕದ ಮಾರ್ಗದಲ್ಲಿ ಹೋಗು,” ಎಂದೂ ಕೂಗುತ್ತಾಳೆ.<verse eid="PRO 9:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 9:7"/>ಪರಿಹಾಸ್ಯ ಮಾಡುವವನನ್ನು ಗದರಿಸುವವನು ತನ್ನನ್ನು ತಾನೇ ಅವಮಾನಕ್ಕೆ ಗುರಿಮಾಡಿಕೊಳ್ಳುವನು;</para>
  <para style="q2" vid="PRO 9:7">ದುಷ್ಟನನ್ನು ಗದರಿಸುವವನು ತನಗೆ ತಾನೇ ಕಳಂಕವನ್ನು ತಂದುಕೊಳ್ಳುವನು.<verse eid="PRO 9:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 9:8"/>ಪರಿಹಾಸ್ಯ ಮಾಡುವವನನ್ನು ಗದರಿಸಬೇಡ ಅವನು ನಿನ್ನನ್ನು ಹಗೆ ಮಾಡುವನು;</para>
  <para style="q2" vid="PRO 9:8">ಜ್ಞಾನಿಯನ್ನು ಗದರಿಸಿದರೆ ಅವನು ನಿನ್ನನ್ನು ಪ್ರೀತಿ ಮಾಡುವನು.<verse eid="PRO 9:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 9:9"/>ಜ್ಞಾನಿಗೆ ಶಿಕ್ಷಣ ನೀಡಿದರೆ ಅವನು ಇನ್ನೂ ಹೆಚ್ಚಾಗಿ ಜ್ಞಾನವಂತನಾಗಿರುವನು;</para>
  <para style="q2" vid="PRO 9:9">ನೀತಿವಂತನಿಗೆ ಬೋಧಿಸಿದರೆ ಅವನು ಜ್ಞಾನವನ್ನು ಹೆಚ್ಚಿಸಿಕೊಳ್ಳುವನು.<verse eid="PRO 9:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 9:10"/>ಯೆಹೋವ ದೇವರ ಭಯವೇ ಜ್ಞಾನಕ್ಕೆ ಮೂಲವು.</para>
  <para style="q2" vid="PRO 9:10">ಪರಿಶುದ್ಧರ ಪರಿಜ್ಞಾನವೇ ತಿಳುವಳಿಕೆಯಾಗಿದೆ.<verse eid="PRO 9:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 9:11"/>ಏಕೆಂದರೆ ಜ್ಞಾನದ ಮೂಲಕ ನಿನ್ನ ಜೀವನದ ದಿನಗಳು ಹೆಚ್ಚುವುವು;</para>
  <para style="q2" vid="PRO 9:11">ನಿನ್ನ ಜೀವನದ ವರ್ಷಗಳು ವೃದ್ಧಿಯಾಗುವುವು.<verse eid="PRO 9:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 9:12"/>ನೀನು ಜ್ಞಾನಿಯಾದರೆ, ನಿನ್ನ ಜ್ಞಾನವು ನಿನಗೆ ಪ್ರತಿಫಲ ಕೊಡುವುದು;</para>
  <para style="q2" vid="PRO 9:12">ನೀನು ನಿಂದಿಸುವವನಾದರೆ, ನೀನೇ ಅದರ ಫಲವನ್ನು ಅನುಭವಿಸುವಿ.<verse eid="PRO 9:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 9:13"/>ಬುದ್ಧಿಹೀನಳಾದ ಸ್ತ್ರೀಯು ಕೂಗಾಟದವಳು;</para>
  <para style="q2" vid="PRO 9:13">ಅವಳು ಅರಿವಿಲ್ಲದವಳು, ಏನೂ ತಿಳಿಯದವಳು.<verse eid="PRO 9:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 9:14"/>ಅವಳು ತನ್ನ ಮನೆಯ ಬಾಗಿಲಿನಲ್ಲಿ ಕುಳಿತು,</para>
  <para style="q2" vid="PRO 9:14">ಪಟ್ಟಣದ ಎತ್ತರವಾದ ಸ್ಥಳಗಳ ಪೀಠದ ಮೇಲೆ ನಿಂತು,<verse eid="PRO 9:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 9:15"/>ತಮ್ಮ ಮಾರ್ಗವನ್ನು ಹಿಡಿದು ಹೋಗುವ</para>
  <para style="q2" vid="PRO 9:15">ಪ್ರಯಾಣಿಕರನ್ನು ಕರೆಯುತ್ತಾಳೆ,<verse eid="PRO 9:15"/></para>
  <para style="q2">
    <verse number="16" style="v" sid="PRO 9:16"/>“ಯಾರು ಮುಗ್ಧರೋ ಅವರು ನನ್ನ ಮನೆಗೆ ಬರಲಿ,”</para>
  <para style="q1" vid="PRO 9:16">ಬುದ್ಧಿ ಇಲ್ಲದೆ ಇರುವವನಿಗೆ ಆಕೆಯು ಹೇಳುತ್ತಾಳೆ,<verse eid="PRO 9:16"/></para>
  <para style="q2">
    <verse number="17" style="v" sid="PRO 9:17"/>“ಕದ್ದ ನೀರು ಸಿಹಿಯಾಗಿದೆ;</para>
  <para style="q2" vid="PRO 9:17">ರಹಸ್ಯದಲ್ಲಿ ತಿನ್ನುವ ಆಹಾರವು ರುಚಿಯಾಗಿದೆ,” ಎಂದು ಹೇಳುತ್ತಾಳೆ.<verse eid="PRO 9:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 9:18"/>ಆದರೆ ಆ ಮನೆ ಸತ್ತವರ ಸ್ಥಾನವಾಗಿದೆ.</para>
  <para style="q2" vid="PRO 9:18">ಅವಳ ಅತಿಥಿಗಳು ಪಾತಾಳದ ಅಗಾಧದಲ್ಲಿ ಬಿದ್ದಿದ್ದಾರೆಂದು ಅವನಿಗೆ ತಿಳಿಯದು.<verse eid="PRO 9:18"/></para>
  <chapter eid="PRO 9"/>
  <chapter number="10" style="c" sid="PRO 10"/>
  <para style="ms1">ಸೊಲೊಮೋನನ ಜ್ಞಾನೋಕ್ತಿಗಳು</para>
  <para style="p">
    <verse number="1" style="v" sid="PRO 10:1"/>ಸೊಲೊಮೋನನ ಜ್ಞಾನೋಕ್ತಿಗಳು:</para>
  <para style="q1" vid="PRO 10:1">ಜ್ಞಾನಿಯಾದ ಮಗನು ತಂದೆಗೆ ಸಂತೋಷವನ್ನು ಉಂಟುಮಾಡುತ್ತಾನೆ.</para>
  <para style="q2" vid="PRO 10:1">ಅಜ್ಞಾನಿಯಾದ ಮಗನಾದರೋ ತನ್ನ ತಾಯಿಗೆ ಶೋಕವನ್ನುಂಟು ಮಾಡುತ್ತಾನೆ.<verse eid="PRO 10:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 10:2"/>ಅನ್ಯಾಯದ ಸಂಪತ್ತುಗಳು ಶಾಶ್ವತವಲ್ಲ,</para>
  <para style="q2" vid="PRO 10:2">ಆದರೆ ನೀತಿಯು ಮರಣದಿಂದ ಬಿಡಿಸುತ್ತದೆ.<verse eid="PRO 10:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 10:3"/>ನೀತಿವಂತನನ್ನು ಹಸಿವೆಯಿಂದ ಬಳಲುವಂತೆ ಯೆಹೋವ ದೇವರು ಬಿಡುವುದಿಲ್ಲ;</para>
  <para style="q2" vid="PRO 10:3">ಆದರೆ ದುಷ್ಟರ ಆಶೆಯನ್ನು ಅವರು ಭಂಗಪಡಿಸುತ್ತಾರೆ.<verse eid="PRO 10:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 10:4"/>ಆಲಸ್ಯದ ಕೈ ದರಿದ್ರನನ್ನಾಗಿ ಮಾಡುವದು;</para>
  <para style="q2" vid="PRO 10:4">ಆದರೆ ಚುರುಕಾದ ಕೈ ಐಶ್ವರ್ಯವನ್ನುಂಟು ಮಾಡುತ್ತದೆ.<verse eid="PRO 10:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 10:5"/>ಬೇಸಿಗೆಯಲ್ಲಿ ಫಸಲನ್ನು ಕೂಡಿಸುವವರು ಬುದ್ಧಿವಂತ ಮಕ್ಕಳು,</para>
  <para style="q2" vid="PRO 10:5">ಸುಗ್ಗಿಯಲ್ಲಿ ನಿದ್ರೆ ಮಾಡುವವರು ನಾಚಿಕೆಗೆಟ್ಟ ಮಕ್ಕಳು.<verse eid="PRO 10:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 10:6"/>ನೀತಿವಂತರ ತಲೆಯ ಮೇಲೆ ಆಶೀರ್ವಾದವಿದೆ;</para>
  <para style="q2" vid="PRO 10:6">ಆದರೆ ದುಷ್ಟರ ಬಾಯಲ್ಲಿ ಕ್ರೌರ್ಯ ಅಡಗಿದೆ.<verse eid="PRO 10:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 10:7"/>ನೀತಿವಂತರ ಸ್ಮರಣೆಯು ಆಶೀರ್ವಾದಕ್ಕೆ ಆಸ್ಪದ;</para>
  <para style="q2" vid="PRO 10:7">ಆದರೆ ದುಷ್ಟನ ಹೆಸರು ಕೊಳೆಯುವುದು.<note caller="+" style="f"><char style="fr" closed="false">10:7 </char><char style="ft" closed="false"><char style="xt"><ref loc="GEN 48:20">ಆದಿ 48:20</ref></char></char></note><verse eid="PRO 10:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 10:8"/>ಜ್ಞಾನ ಹೃದಯದವರು ಆಜ್ಞೆಗಳನ್ನು ಸ್ವೀಕರಿಸುವರು;</para>
  <para style="q2" vid="PRO 10:8">ಆದರೆ ಹರಟೆಯ ಮೂರ್ಖನು ಬೀಳುವನು.<verse eid="PRO 10:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 10:9"/>ಯಥಾರ್ಥ ನಡತೆಯವರು ಸುರಕ್ಷಿತವಾಗಿ ಜೀವಿಸುತ್ತಾರೆ;</para>
  <para style="q2" vid="PRO 10:9">ಆದರೆ ವಕ್ರಮಾರ್ಗಗಳಲ್ಲಿ ನಡೆಯುವವನು ಬಯಲಿಗೆ ಬರುವನು.<verse eid="PRO 10:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 10:10"/>ದುರುದ್ದೇಶದಿಂದ ಕಣ್ಣು ಮಿಟಕಿಸುವವನು ದುಃಖವನ್ನು ಉಂಟುಮಾಡುತ್ತಾನೆ,</para>
  <para style="q2" vid="PRO 10:10">ಆದರೆ ಹರಟೆಯ ಮೂರ್ಖನು ಬೀಳುವನು.<verse eid="PRO 10:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 10:11"/>ನೀತಿವಂತನ ಬಾಯಿಯು ಜೀವದ ಬುಗ್ಗೆ;</para>
  <para style="q2" vid="PRO 10:11">ಆದರೆ ದುಷ್ಟನ ಬಾಯಿ ಹಿಂಸೆಯನ್ನು ಮರೆಮಾಡುತ್ತದೆ.<verse eid="PRO 10:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 10:12"/>ದ್ವೇಷವು ಜಗಳಗಳನ್ನು ಎಬ್ಬಿಸುತ್ತದೆ;</para>
  <para style="q2" vid="PRO 10:12">ಆದರೆ ಪ್ರೀತಿಯು ಎಲ್ಲಾ ಪಾಪಗಳನ್ನು ಮುಚ್ಚುತ್ತದೆ.<verse eid="PRO 10:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 10:13"/>ವಿವೇಕವುಳ್ಳ ತುಟಿಗಳಲ್ಲಿ ಜ್ಞಾನವು ಸಿಕ್ಕುತ್ತದೆ;</para>
  <para style="q2" vid="PRO 10:13">ವಿವೇಕವಿಲ್ಲದವನ ಬೆನ್ನಿಗೆ ಬೆತ್ತವೇ ಸರಿ.<verse eid="PRO 10:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 10:14"/>ಜ್ಞಾನಿಗಳು ತಿಳುವಳಿಕೆಯನ್ನು ಇಟ್ಟುಕೊಳ್ಳುತ್ತಾರೆ;</para>
  <para style="q2" vid="PRO 10:14">ಆದರೆ ಮೂರ್ಖನ ಬಾಯಿ ವಿನಾಶವನ್ನು ಆಹ್ವಾನಿಸುತ್ತದೆ.<verse eid="PRO 10:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 10:15"/>ಐಶ್ವರ್ಯವಂತರಿಗೆ ಸಂಪತ್ತೇ ಅವರ ಬಲವಾದ ಕೋಟೆ;</para>
  <para style="q2" vid="PRO 10:15">ಆದರೆ, ಬಡತನವೇ ಬಡವರ ನಾಶನಕ್ಕೆ ಕಾರಣ.<verse eid="PRO 10:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 10:16"/>ನೀತಿವಂತರ ದುಡಿತವು ಜೀವವಾಗುವುದು;</para>
  <para style="q2" vid="PRO 10:16">ಆದರೆ, ದುಷ್ಟರ ಆದಾಯವು ಪಾಪ ಹಾಗು ಮರಣ.<verse eid="PRO 10:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 10:17"/>ಶಿಸ್ತನ್ನು ಕೈಗೊಳ್ಳುವವನು ಜೀವದ ಮಾರ್ಗವನ್ನು ತೋರಿಸುವನು;</para>
  <para style="q2" vid="PRO 10:17">ಆದರೆ ತಿದ್ದುಪಾಟನ್ನು ತಿರಸ್ಕರಿಸುವವನು ಇತರರ ದಾರಿತಪ್ಪಿಸುವನು.<verse eid="PRO 10:17"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 10:18"/>ದ್ವೇಷವನ್ನು ಮರೆಮಾಚುವವನು ಸುಳ್ಳುಗಾರ</para>
  <para style="q2" vid="PRO 10:18">ಮತ್ತು ಚಾಡಿ ಹೇಳುವವನು ಮೂರ್ಖನು.<verse eid="PRO 10:18"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 10:19"/>ಅತಿಯಾದ ಮಾತುಗಳಿಂದ ಪಾಪವು ಕೊನೆಗೊಳ್ಳುವುದಿಲ್ಲ.</para>
  <para style="q2" vid="PRO 10:19">ಆದರೆ ಜ್ಞಾನವಂತನು ತನ್ನ ನಾಲಿಗೆಯನ್ನು ತಡೆಯುವನು.<verse eid="PRO 10:19"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 10:20"/>ನೀತಿವಂತರ ನಾಲಿಗೆಯು ಚೊಕ್ಕಬೆಳ್ಳಿಯಂತಿದೆ;</para>
  <para style="q2" vid="PRO 10:20">ದುಷ್ಟರ ಹೃದಯವು ಬೆಲೆಯಿಲ್ಲದ್ದು.<verse eid="PRO 10:20"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 10:21"/>ನೀತಿವಂತರ ತುಟಿಗಳು ಅನೇಕರನ್ನು ಪೋಷಿಸುತ್ತವೆ,</para>
  <para style="q2" vid="PRO 10:21">ಜ್ಞಾನದ ಕೊರತೆಯಿಂದ ಬುದ್ಧಿಹೀನರು ಸಾಯುತ್ತಾರೆ.<verse eid="PRO 10:21"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 10:22"/>ಯೆಹೋವ ದೇವರ ಆಶೀರ್ವಾದವು ಸಂಪತ್ತನ್ನು ಉಂಟುಮಾಡುವುದು;</para>
  <para style="q2" vid="PRO 10:22">ಅವರು ಅದರೊಂದಿಗೆ ಯಾವ ದುಃಖವನ್ನೂ ಸೇರಿಸುವುದಿಲ್ಲ.<verse eid="PRO 10:22"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 10:23"/>ಮೂರ್ಖನಿಗೆ ಕೇಡು ಮಾಡುವುದರಲ್ಲಿ ಆನಂದ;</para>
  <para style="q2" vid="PRO 10:23">ಆದರೆ ತಿಳುವಳಿಕೆಯ ವ್ಯಕ್ತಿಯು ಜ್ಞಾನದಲ್ಲಿ ಸಂತೋಷಪಡುತ್ತಾನೆ.<verse eid="PRO 10:23"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 10:24"/>ದುಷ್ಟನ ಭೀತಿಯೇ ಅವನನ್ನು ಹಿಂದಿಕ್ಕುವುದು;</para>
  <para style="q2" vid="PRO 10:24">ಆದರೆ ನೀತಿವಂತರ ಇಷ್ಟವು ಸಫಲವಾಗುವುದು.<verse eid="PRO 10:24"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 10:25"/>ಬಿರುಗಾಳಿಯು ಬೀಸಿದರೆ, ದುಷ್ಟರು ಇಲ್ಲವಾಗುವರು;</para>
  <para style="q2" vid="PRO 10:25">ಆದರೆ ನೀತಿವಂತರು ಶಾಶ್ವತವಾಗಿ ನಿಲ್ಲುವರು.<verse eid="PRO 10:25"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 10:26"/>ಹಲ್ಲುಗಳಿಗೆ ಹುಳಿಯೂ, ಕಣ್ಣುಗಳಿಗೆ ಹೊಗೆಯೂ ಹೇಗೋ,</para>
  <para style="q2" vid="PRO 10:26">ಯಜಮಾನನಿಗೆ ಸೋಮಾರಿಯು ಹಾಗೆಯೇ ಇರುವನು.<verse eid="PRO 10:26"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 10:27"/>ಯೆಹೋವ ದೇವರ ಭಯವು ಜೀವನದ ದಿನಗಳನ್ನು ಹೆಚ್ಚಿಸುತ್ತದೆ;</para>
  <para style="q2" vid="PRO 10:27">ದುಷ್ಟರ ವರ್ಷಗಳು ಕಡಿಮೆ ಆಗುವವು.<verse eid="PRO 10:27"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 10:28"/>ನೀತಿವಂತರ ನಿರೀಕ್ಷೆಯು ಆನಂದಕರವಾಗಿರುವುದು;</para>
  <para style="q2" vid="PRO 10:28">ಆದರೆ ದುಷ್ಟರ ನಿರೀಕ್ಷೆಯು ನಾಶವಾಗುವುದು.<verse eid="PRO 10:28"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 10:29"/>ಯೆಹೋವ ದೇವರ ಮಾರ್ಗವು ನಿರ್ದೋಷಿಗಳಿಗೆ ಆಶ್ರಯವಾಗಿದೆ;</para>
  <para style="q2" vid="PRO 10:29">ಆದರೆ ಕೇಡು ಮಾಡುವವರಿಗೆ ಅದು ವಿನಾಶಕರವಾಗಿದೆ.<verse eid="PRO 10:29"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="30" style="v" sid="PRO 10:30"/>ನೀತಿವಂತರು ಎಂದಿಗೂ ಕದಲುವುದೇ ಇಲ್ಲ;</para>
  <para style="q2" vid="PRO 10:30">ಆದರೆ ದುಷ್ಟರು ಭೂಮಿಯಲ್ಲಿ ನಿಲ್ಲುವುದಿಲ್ಲ.<verse eid="PRO 10:30"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="31" style="v" sid="PRO 10:31"/>ನೀತಿವಂತರ ಬಾಯಲ್ಲಿ ಜ್ಞಾನವು ಫಲಿಸುತ್ತದೆ;</para>
  <para style="q2" vid="PRO 10:31">ಆದರೆ ಮೂರ್ಖನ ನಾಲಿಗೆಯು ಕತ್ತರಿಸಲಾಗುವುದು.<verse eid="PRO 10:31"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="32" style="v" sid="PRO 10:32"/>ಯೋಗ್ಯವಾದದ್ದು ಯಾವುದೆಂದು ನೀತಿವಂತರ ತುಟಿಗಳಿಗೆ ತಿಳಿಯುವುದು,</para>
  <para style="q2" vid="PRO 10:32">ಆದರೆ, ದುಷ್ಟರ ಬಾಯಿ ಮೂರ್ಖತನವನ್ನೇ ಹೊರಗೆಡವುದು.<verse eid="PRO 10:32"/></para>
  <para style="b"/>
  <chapter eid="PRO 10"/>
  <chapter number="11" style="c" sid="PRO 11"/>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 11:1"/>ಮೋಸದ ತಕ್ಕಡಿ ಯೆಹೋವ ದೇವರಿಗೆ ಅಸಹ್ಯವಾಗಿದೆ;</para>
  <para style="q2" vid="PRO 11:1">ಆದರೆ ನ್ಯಾಯದ ತೂಕ ಅವರಿಗೆ ಮೆಚ್ಚುಗೆ.<verse eid="PRO 11:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 11:2"/>ಗರ್ವ ಬಂದಾಗ ನಾಚಿಕೆಯೂ ಬರುತ್ತದೆ;</para>
  <para style="q2" vid="PRO 11:2">ಆದರೆ ದೀನತೆಯೊಂದಿಗೆ ಜ್ಞಾನ ಬರುವುದು.<verse eid="PRO 11:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 11:3"/>ಯಥಾರ್ಥವಂತರ ಪ್ರಾಮಾಣಿಕತೆ ಅವರನ್ನು ನಡೆಸುವುದು;</para>
  <para style="q2" vid="PRO 11:3">ಅಪನಂಬಿಗಸ್ತರ ಕಪಟತನವೇ ಅವರನ್ನು ನಾಶಪಡಿಸುವುದು.<verse eid="PRO 11:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 11:4"/>ಉಗ್ರತೆಯ ದಿನದಲ್ಲಿ ಸಂಪತ್ತು ಲಾಭಕರವಾಗುವುದಿಲ್ಲ;</para>
  <para style="q2" vid="PRO 11:4">ಆದರೆ ನೀತಿಯ ನಡತೆ ಮರಣದಿಂದ ವಿಮೋಚಿಸುವುದು.<verse eid="PRO 11:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 11:5"/>ನಿಷ್ಕಳಂಕರ ನೀತಿಯು ಅವರ ಮಾರ್ಗವನ್ನು ಸರಾಗ ಮಾಡುವುದು;</para>
  <para style="q2" vid="PRO 11:5">ಆದರೆ ದುಷ್ಟರು ತಮ್ಮ ದುಷ್ಟತ್ವದಿಂದಲೇ ಬೀಳುವರು.<verse eid="PRO 11:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 11:6"/>ಯಥಾರ್ಥವಂತರ ನೀತಿಯು ಅವರನ್ನು ಬಿಡಿಸುವುದು;</para>
  <para style="q2" vid="PRO 11:6">ಆದರೆ ಅಪನಂಬಿಗಸ್ತರು ದುಷ್ಟ ಆಸೆಗಳಿಂದ ಸಿಕ್ಕಿಹಾಕಿಕೊಳ್ಳುತ್ತಾರೆ.<verse eid="PRO 11:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 11:7"/>ದುಷ್ಟನು ಸಾಯುವಾಗ ಅವನ ನಿರೀಕ್ಷೆಗಳು ಹಾಳಾಗುವುವು;</para>
  <para style="q2" vid="PRO 11:7">ತನ್ನ ಬಲದಿಂದ ನಿರೀಕ್ಷಿಸಿದ್ದೆಲ್ಲವೂ ಇಲ್ಲದಂತಾಗುವುದು.<verse eid="PRO 11:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 11:8"/>ನೀತಿವಂತನು ಇಕ್ಕಟ್ಟಿನಿಂದ ತಪ್ಪಿಸಿಕೊಳ್ಳುತ್ತಾನೆ,</para>
  <para style="q2" vid="PRO 11:8">ದುಷ್ಟನು ಅದರ ಸ್ಥಳದಲ್ಲಿ ಸಿಕ್ಕಿಬೀಳುವನು.<verse eid="PRO 11:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 11:9"/>ಒಬ್ಬ ಭಕ್ತಿಹೀನನು ಬಾಯಿಂದ ತನ್ನ ನೆರೆಯವನನ್ನು ಹಾಳು ಮಾಡುತ್ತಾನೆ,</para>
  <para style="q2" vid="PRO 11:9">ಆದರೆ ನೀತಿವಂತನು ತಿಳುವಳಿಕೆಯ ಮೂಲಕ ಬಿಡಿಸಲಾಗುವನು.<verse eid="PRO 11:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 11:10"/>ನೀತಿವಂತರು ಅಭಿವೃದ್ಧಿಹೊಂದಿದರೆ, ಪಟ್ಟಣವು ಉಲ್ಲಾಸಿಸುತ್ತದೆ;</para>
  <para style="q2" vid="PRO 11:10">ದುಷ್ಟರು ನಾಶವಾದರೆ, ಜಯೋತ್ಸವ ಉಂಟಾಗುತ್ತದೆ.<verse eid="PRO 11:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 11:11"/>ಯಥಾರ್ಥವಂತರ ಆಶೀರ್ವಾದದಿಂದ ಪಟ್ಟಣವು ಪ್ರಗತಿಯಾಗುತ್ತದೆ,</para>
  <para style="q2" vid="PRO 11:11">ಆದರೆ ದುಷ್ಟರ ಬಾಯಿಂದ ಅದು ನಾಶವಾಗುತ್ತದೆ.<verse eid="PRO 11:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 11:12"/>ಜ್ಞಾನವಿಲ್ಲದವನು ತನ್ನ ನೆರಯವನನ್ನು ಹೀನೈಸುತ್ತಾನೆ,</para>
  <para style="q2" vid="PRO 11:12">ಆದರೆ ತಿಳುವಳಿಕೆಯುಳ್ಳವನು ಮೌನವಾಗಿರುತ್ತಾನೆ.<verse eid="PRO 11:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 11:13"/>ಚಾಡಿಕೋರನು ರಹಸ್ಯಗಳನ್ನು ಬಹಿರಂಗಪಡಿಸುತ್ತಾನೆ,</para>
  <para style="q2" vid="PRO 11:13">ಆದರೆ ನಂಬಿಗಸ್ತನು ಆ ಸಂಗತಿಯನ್ನು ಮುಚ್ಚುತ್ತಾನೆ.<verse eid="PRO 11:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 11:14"/>ಆಲೋಚನೆ ಇಲ್ಲದೆ ಇರುವಲ್ಲಿ ಜನರು ಬೀಳುತ್ತಾರೆ,</para>
  <para style="q2" vid="PRO 11:14">ಆದರೆ ಸಲಹೆಗಾರರ ಸಮೂಹದಲ್ಲಿ ಭದ್ರತೆ ಇದೆ.<verse eid="PRO 11:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 11:15"/>ಅನ್ಯನಿಗೆ ಹೊಣೆಯಾಗುವವನು ಹಾನಿಗೆ ಗುರಿಯಾಗುತ್ತಾನೆ,</para>
  <para style="q2" vid="PRO 11:15">ಹೊಣೆಗಾರನಾಗಿರದವನು ಸುರಕ್ಷಿತವಾಗಿರುವನು.<verse eid="PRO 11:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 11:16"/>ದಯೆಯುಳ್ಳ ಸ್ತ್ರೀಯು ತನ್ನ ಗೌರವವನ್ನು ಸಂಪಾದಿಸಿಕೊಳ್ಳುತ್ತಾಳೆ,</para>
  <para style="q2" vid="PRO 11:16">ನಿಷ್ಕರುಣ ವ್ಯಕ್ತಿ ಸಂಪತ್ತನ್ನು ಮಾತ್ರ ಪಡೆದುಕೊಳ್ಳುತ್ತಾನೆ.<verse eid="PRO 11:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 11:17"/>ದಯೆಯುಳ್ಳವನು ತನಗೆ ತಾನೇ ಒಳ್ಳೆಯದನ್ನು ಮಾಡಿಕೊಳ್ಳುತ್ತಾನೆ,</para>
  <para style="q2" vid="PRO 11:17">ಕಠೋರಿಯು ತನ್ನ ಶರೀರವನ್ನು ಬಾಧಿಸಿಕೊಳ್ಳುತ್ತಾನೆ.<verse eid="PRO 11:17"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 11:18"/>ದುಷ್ಟನು ಮೋಸದ ಸಂಬಳವನ್ನು ಸಂಪಾದಿಸುತ್ತಾನೆ,</para>
  <para style="q2" vid="PRO 11:18">ನೀತಿಯನ್ನು ಬಿತ್ತುವವನಿಗೆ ನಿಸ್ಸಂದೇಹವಾದ ಬಹುಮಾನವಿರುವುದು.<verse eid="PRO 11:18"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 11:19"/>ನೀತಿವಂತನ ಮಾರ್ಗಗಳಲ್ಲಿ ಅಚಲವಾಗಿರುವವನು ಜೀವ ಹೊಂದುತ್ತಾನೆ,</para>
  <para style="q2" vid="PRO 11:19">ಕೆಟ್ಟದ್ದನ್ನು ಬೆನ್ನಟ್ಟುವವನು ತನ್ನ ಮರಣವನ್ನು ಬೆನ್ನಟ್ಟುತ್ತಾನೆ.<verse eid="PRO 11:19"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 11:20"/>ವಕ್ರ ಹೃದಯವುಳ್ಳವರು ಯೆಹೋವ ದೇವರಿಗೆ ಅಸಹ್ಯವಾದವರು,</para>
  <para style="q2" vid="PRO 11:20">ಆದರೆ, ಸನ್ಮಾರ್ಗದಲ್ಲಿ ಯಥಾರ್ಥವಾಗಿ ಇರುವವರಲ್ಲಿ ಅವರು ಆನಂದಿಸುತ್ತಾರೆ.<verse eid="PRO 11:20"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 11:21"/>ದುಷ್ಟನಿಗೆ ಶಿಕ್ಷೆ ತಪ್ಪುವುದಿಲ್ಲ;</para>
  <para style="q2" vid="PRO 11:21">ನೀತಿವಂತರ ವಂಶವು ಬಿಡುಗಡೆ ಹೊಂದುವುದು.<verse eid="PRO 11:21"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 11:22"/>ಹಂದಿಯ ಮೂಗಿಗೆ ಬಂಗಾರದ ಮೂಗುತಿಯು ಹೇಗೋ,</para>
  <para style="q2" vid="PRO 11:22">ಹಾಗೆಯೇ ವಿವೇಕವಿಲ್ಲದ ಸ್ತ್ರೀಗೆ ಸೌಂದರ್ಯವು.<verse eid="PRO 11:22"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 11:23"/>ನೀತಿವಂತರ ಅಪೇಕ್ಷೆಯು ಶುಭಕ್ಕಾಸ್ಪದ,</para>
  <para style="q2" vid="PRO 11:23">ದುಷ್ಟರ ಅಪೇಕ್ಷೆಯು ತೀರ್ಪಿಗೀಡು.<verse eid="PRO 11:23"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 11:24"/>ಒಬ್ಬನು ತನ್ನ ಸಂಪತ್ತನ್ನು ಉದಾರವಾಗಿ ವ್ಯಯಮಾಡಿದರೂ ಅವನು ವೃದ್ಧಿಯಾಗುತ್ತಾನೆ,</para>
  <para style="q2" vid="PRO 11:24">ಆದರೆ ಇನ್ನೊಬ್ಬನು ನ್ಯಾಯವಾದದ್ದನ್ನು ಬಿಗಿಹಿಡಿದರೂ ಅವನು ಬಡತನಕ್ಕೆ ಬರುತ್ತಾನೆ.<verse eid="PRO 11:24"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 11:25"/>ಉದಾರಿಯು ಅಭಿವೃದ್ಧಿ ಹೊಂದುವನು;</para>
  <para style="q2" vid="PRO 11:25">ಬೇರೆಯವರಿಗೆ ಚೈತನ್ಯ ಕೊಡುವವನು ಚೈತನ್ಯ ಹೊಂದುವನು.<verse eid="PRO 11:25"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 11:26"/>ಧಾನ್ಯವನ್ನು ಬಚ್ಚಿಟ್ಟುಕೊಳ್ಳುವವನನ್ನು ಜನರು ಶಪಿಸುವರು;</para>
  <para style="q2" vid="PRO 11:26">ಆದರೆ ಅದನ್ನು ಮಾರುವವನ ಮೇಲೆ ಆಶೀರ್ವಾದವು ನೆಲೆಯಾಗಿರುವುದು.<verse eid="PRO 11:26"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 11:27"/>ಒಳ್ಳೆಯದನ್ನು ಸೂಕ್ಷ್ಮವಾಗಿ ಹುಡುಕುವವನು ದಯೆಯನ್ನು ಹೊಂದುತ್ತಾನೆ;</para>
  <para style="q2" vid="PRO 11:27">ಆದರೆ ಕೇಡನ್ನು ಹುಡುಕುವವನಿಗೆ ಕೇಡೇ ಆಗುವುದು.<verse eid="PRO 11:27"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 11:28"/>ತನ್ನ ಐಶ್ವರ್ಯದಲ್ಲಿ ಭರವಸೆ ಇಡುವವನು ಬಿದ್ದುಹೋಗುವನು,</para>
  <para style="q2" vid="PRO 11:28">ಆದರೆ ನೀತಿವಂತರು ಹಸಿರೆಲೆಯ ಹಾಗೆ ಚಿಗುರುವರು.<verse eid="PRO 11:28"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 11:29"/>ತನ್ನ ಮನೆಯವರನ್ನು ಬಾಧಿಸುವವನು ಗಾಳಿಯನ್ನು ಬಾಧ್ಯವಾಗಿ ಹೊಂದುವನು;</para>
  <para style="q2" vid="PRO 11:29">ಮೂರ್ಖನು ಜ್ಞಾನನಿಗೆ ಸೇವಕನಾಗಿರುವನು.<verse eid="PRO 11:29"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="30" style="v" sid="PRO 11:30"/>ನೀತಿವಂತರ ಫಲವು ಜೀವವೃಕ್ಷ;</para>
  <para style="q2" vid="PRO 11:30">ಆತ್ಮಗಳನ್ನು ಗೆಲ್ಲುವವನು ಜ್ಞಾನಿಯಾಗಿದ್ದಾನೆ.<verse eid="PRO 11:30"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="31" style="v" sid="PRO 11:31"/>ಇಗೋ, ಭೂಮಿಯ ಮೇಲೆ ನೀತಿವಂತರು ತಮ್ಮ ಫಲವನ್ನು ಹೊಂದಲಿಕ್ಕಿರುವಾಗ,</para>
  <para style="q2" vid="PRO 11:31">ದುಷ್ಟರು ಮತ್ತು ಪಾಪಿಗಳು ಎಷ್ಟೋ ಹೆಚ್ಚಾಗಿ ತಮ್ಮ ಫಲವನ್ನು ಹೊಂದುತ್ತಾರೆ.<verse eid="PRO 11:31"/></para>
  <para style="b"/>
  <chapter eid="PRO 11"/>
  <chapter number="12" style="c" sid="PRO 12"/>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 12:1"/>ಶಿಸ್ತನ್ನು ಪ್ರೀತಿಸುವವನು ಪರಿಜ್ಞಾನವನ್ನು ಪ್ರೀತಿಸುವವನಾಗಿದ್ದಾನೆ,</para>
  <para style="q2" vid="PRO 12:1">ಆದರೆ ತಿದ್ದುವಿಕೆಯನ್ನು ಹಗೆಮಾಡುವವನು ದಡ್ಡನು.<verse eid="PRO 12:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 12:2"/>ಒಳ್ಳೆಯವನು ಯೆಹೋವ ದೇವರ ದಯೆಯನ್ನು ಹೊಂದುತ್ತಾನೆ,</para>
  <para style="q2" vid="PRO 12:2">ಆದರೆ ಕುಯುಕ್ತಿ ಮಾಡುವವನನ್ನು ಅವರು ದುಷ್ಟನೆಂದು ಖಂಡಿಸುತ್ತಾರೆ.<verse eid="PRO 12:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 12:3"/>ಒಬ್ಬ ಮನುಷ್ಯನು ದುಷ್ಟತನದಿಂದ ಸ್ಥಿರವಾಗುವುದಿಲ್ಲ.</para>
  <para style="q2" vid="PRO 12:3">ಆದರೆ ನೀತಿವಂತರನ್ನು ಕಿತ್ತುಹಾಕಲಾಗುವುದಿಲ್ಲ.<verse eid="PRO 12:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 12:4"/>ಗುಣವತಿಯಾದ ಸ್ತ್ರೀಯು ತನ್ನ ಪತಿಗೆ ಕಿರೀಟ;</para>
  <para style="q2" vid="PRO 12:4">ಆದರೆ ನಾಚಿಕೆ ಪಡಿಸುವವಳು ಅವನ ಎಲುಬುಗಳಿಗೆ ಕ್ಷಯ ರೋಗದಂತೆ ಇರುವಳು.<verse eid="PRO 12:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 12:5"/>ನೀತಿವಂತರ ಯೋಜನೆಗಳು ನ್ಯಾಯವಾಗಿವೆ;</para>
  <para style="q2" vid="PRO 12:5">ದುಷ್ಟರ ಸಲಹೆ ಮೋಸಭರಿತ.<verse eid="PRO 12:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 12:6"/>ದುಷ್ಟರ ಮಾತುಗಳು ರಕ್ತಕ್ಕೆ ಹೊಂಚು,</para>
  <para style="q2" vid="PRO 12:6">ಯಥಾರ್ಥವಂತರ ನುಡಿ ಅವರನ್ನು ಬಿಡಿಸುವುದು.<verse eid="PRO 12:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 12:7"/>ದುಷ್ಟರು ನೆಲಕ್ಕುರುಳಿ ನಿರ್ಮೂಲರಾಗುವರು,</para>
  <para style="q2" vid="PRO 12:7">ಆದರೆ ನೀತಿವಂತರ ಮನೆಯು ಸ್ಥಿರವಾಗಿ ನಿಲ್ಲುವುದು.<verse eid="PRO 12:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 12:8"/>ತನ್ನ ಜ್ಞಾನಕ್ಕನುಸಾರವಾಗಿ ಮನುಷ್ಯನು ಗೌರವ ಹೊಂದುವನು;</para>
  <para style="q2" vid="PRO 12:8">ವಕ್ರಹೃದಯವುಳ್ಳವನು ಕಡೆಗಣಿಸಲಾಗುವನು.<verse eid="PRO 12:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 12:9"/>ಹೊಟ್ಟೆಗೆ ಕೊರತೆ ಇದ್ದು ತನ್ನನ್ನು ತಾನೇ ಘನಪಡಿಸಿಕೊಳ್ಳುವವನಿಗಿಂತಲೂ</para>
  <para style="q2" vid="PRO 12:9">ಸಾಮಾನ್ಯ ಸೇವಕನೇ ಮೇಲು.<verse eid="PRO 12:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 12:10"/>ನೀತಿವಂತನು ತನ್ನ ಪ್ರಾಣಿಗಳಿಗೂ ಕಾಳಜಿ ತೋರುವನು;</para>
  <para style="q2" vid="PRO 12:10">ಆದರೆ ದುಷ್ಟರ ಕರುಣೆಯ ಕಾರ್ಯಗಳು ಕ್ರೂರತನವೇ.<verse eid="PRO 12:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 12:11"/>ತನ್ನ ಹೊಲವನ್ನು ವ್ಯವಸಾಯ ಮಾಡುವವನು ಆಹಾರದಿಂದ ತೃಪ್ತಿಹೊಂದುವನು,</para>
  <para style="q2" vid="PRO 12:11">ಆದರೆ ವ್ಯರ್ಥ ಕಾರ್ಯವನ್ನು ಹಿಂಬಾಲಿಸುವವನು ವಿವೇಕಶೂನ್ಯನು.<verse eid="PRO 12:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 12:12"/>ದುಷ್ಟರು ಕೆಟ್ಟವರ ಭದ್ರಕೋಟೆಯನ್ನು ಅಪೇಕ್ಷಿಸುತ್ತಾರೆ;</para>
  <para style="q2" vid="PRO 12:12">ಆದರೆ ನೀತಿವಂತರ ಬೇರು ಫಲವನ್ನು ಕೊಡುತ್ತದೆ.<verse eid="PRO 12:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 12:13"/>ದುಷ್ಟನು ತನ್ನ ತಪ್ಪು ಮಾತುಗಳಿಂದ ಬಲೆಗೆ ಬೀಳುವನು,</para>
  <para style="q2" vid="PRO 12:13">ಆದರೆ ನೀತಿವಂತರು ಇಕ್ಕಟ್ಟಿನೊಳಗಿಂದ ತಪ್ಪಿಸಿಕೊಳ್ಳುವರು.<verse eid="PRO 12:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 12:14"/>ತನ್ನ ಬಾಯಿಯ ಫಲದ ಮುಖಾಂತರ ಒಬ್ಬ ಮನುಷ್ಯನು ಒಳ್ಳೆಯದರಿಂದ ತೃಪ್ತನಾಗುವನು,</para>
  <para style="q2" vid="PRO 12:14">ಮನುಷ್ಯನ ಕೈಕೆಲಸಗಳು ಅವನಿಗೆ ಪ್ರತಿಫಲವನ್ನು ಕೊಡುವುವು.<verse eid="PRO 12:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 12:15"/>ಮೂರ್ಖನ ಮಾರ್ಗವು ತನ್ನ ಕಣ್ಣುಗಳಿಗೆ ಸರಿಯಾಗಿದೆ,</para>
  <para style="q2" vid="PRO 12:15">ಆದರೆ ಜ್ಞಾನಿಯು ಸಲಹೆಗೆ ಕಿವಿಗೊಡುವನು.<verse eid="PRO 12:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 12:16"/>ಮೂರ್ಖನ ಕೋಪವು ತಟ್ಟನೆ ರಟ್ಟಾಗುವುದು,</para>
  <para style="q2" vid="PRO 12:16">ಆದರೆ ಜಾಣನು ಅವಮಾನವನ್ನು ನಿರ್ಲಕ್ಷಿಸುತ್ತಾನೆ.<verse eid="PRO 12:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 12:17"/>ಒಬ್ಬ ಪ್ರಾಮಾಣಿಕ ಸಾಕ್ಷಿ ಸತ್ಯವನ್ನು ಹೇಳುತ್ತಾನೆ,</para>
  <para style="q2" vid="PRO 12:17">ಆದರೆ ಸುಳ್ಳುಸಾಕ್ಷಿಯು ಸುಳ್ಳನ್ನು ಹೇಳುತ್ತಾನೆ.<verse eid="PRO 12:17"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 12:18"/>ಅಜಾಗರೂಕತೆಯ ಮಾತುಗಳು ಖಡ್ಗಗಳಂತೆ ಚುಚ್ಚುತ್ತವೆ,</para>
  <para style="q2" vid="PRO 12:18">ಆದರೆ ಜ್ಞಾನವಂತರ ನಾಲಿಗೆಯು ಸ್ವಸ್ಥತೆಯನ್ನು ತರುವುದು.<verse eid="PRO 12:18"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 12:19"/>ಸತ್ಯದ ತುಟಿಯು ಸದಾ ಸ್ಥಿರಗೊಳ್ಳುವುದು,</para>
  <para style="q2" vid="PRO 12:19">ಸುಳ್ಳಾಡುವ ನಾಲಿಗೆಯು ಕ್ಷಣಿಕ.<verse eid="PRO 12:19"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 12:20"/>ಕೇಡನ್ನು ಕಲ್ಪಿಸುವವರ ಹೃದಯದಲ್ಲಿ ಮೋಸ;</para>
  <para style="q2" vid="PRO 12:20">ಸಮಾಧಾನದ ಆಲೋಚನೆಯನ್ನು ಹೇಳುವವರಿಗೆ ಸಂತೋಷ.<verse eid="PRO 12:20"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 12:21"/>ನೀತಿವಂತನಿಗೆ ಯಾವ ಕೇಡೂ ಸಂಭವಿಸದು,</para>
  <para style="q2" vid="PRO 12:21">ಆದರೆ ದುಷ್ಟರು ಕೇಡಿನಿಂದ ತುಂಬಿಕೊಳ್ಳುವರು.<verse eid="PRO 12:21"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 12:22"/>ಸುಳ್ಳಾಡುವ ತುಟಿಗಳು ಯೆಹೋವ ದೇವರಿಗೆ ಅಸಹ್ಯವಾಗಿವೆ;</para>
  <para style="q2" vid="PRO 12:22">ಆದರೆ ಸತ್ಯವಂತರಲ್ಲಿ ಅವರು ಆನಂದಿಸುತ್ತಾರೆ.<verse eid="PRO 12:22"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 12:23"/>ಜಾಣನು ತನ್ನ ಜ್ಞಾನವನ್ನು ಗುಪ್ತಪಡಿಸುತ್ತಾನೆ;</para>
  <para style="q2" vid="PRO 12:23">ಆದರೆ ಮೂರ್ಖನ ಹೃದಯವು ಮೂರ್ಖತನವನ್ನು ಹೇಳುತ್ತದೆ.<verse eid="PRO 12:23"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 12:24"/>ಚುರುಕು ಕೈಯುಳ್ಳವನು ಆಳುವನು;</para>
  <para style="q2" vid="PRO 12:24">ಸೋಮಾರಿಗಳು ಗುಲಾಮರಾಗುವರು.<verse eid="PRO 12:24"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 12:25"/>ಆತಂಕವು ಹೃದಯವನ್ನು ಕುಗ್ಗಿಸುವುದು,</para>
  <para style="q2" vid="PRO 12:25">ಆದರೆ ಕನಿಕರದ ಮಾತು ಹುರಿದುಂಬಿಸುವುದು.<verse eid="PRO 12:25"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 12:26"/>ನೀತಿವಂತರು ತಮ್ಮ ಸ್ನೇಹಿತರನ್ನು ಎಚ್ಚರಿಕೆಯಿಂದ ಆರಿಸುತ್ತಾರೆ,</para>
  <para style="q2" vid="PRO 12:26">ಆದರೆ ದುಷ್ಟರ ಮಾರ್ಗವು ಅವರನ್ನು ತಪ್ಪು ದಾರಿಗೆ ಎಳೆಯುತ್ತದೆ.<verse eid="PRO 12:26"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 12:27"/>ಸೋಮಾರಿಯು ಬೇಟೆಯಾಡಿದ್ದನ್ನು ಬೇಯಿಸುವುದಿಲ್ಲ,</para>
  <para style="q2" vid="PRO 12:27">ಆದರೆ ಶ್ರಮಪಡುವವರು ಅದನ್ನು ತೃಪ್ತಿಯಿಂದ ತಿನ್ನುತ್ತಾರೆ.<verse eid="PRO 12:27"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 12:28"/>ನೀತಿಯ ಮಾರ್ಗದಲ್ಲಿ ಜೀವವಿದೆ;</para>
  <para style="q2" vid="PRO 12:28">ಅದರ ದಾರಿಯಲ್ಲಿ ಮರಣವೇ ಇಲ್ಲ.<verse eid="PRO 12:28"/></para>
  <para style="b"/>
  <chapter eid="PRO 12"/>
  <chapter number="13" style="c" sid="PRO 13"/>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 13:1"/>ಜ್ಞಾನಿಯಾದ ಮಗನು ತನ್ನ ತಂದೆಯ ಉಪದೇಶವನ್ನು ಸ್ವೀಕರಿಸುತ್ತಾನೆ;</para>
  <para style="q2" vid="PRO 13:1">ಆದರೆ ಅಪಹಾಸ್ಯ ಮಾಡುವವನು ಗದರಿಕೆಯನ್ನು ಕೇಳುವುದಿಲ್ಲ.<verse eid="PRO 13:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 13:2"/>ತನ್ನ ಬಾಯಿಯ ಫಲದಿಂದ ಒಬ್ಬ ಮನುಷ್ಯನು ಶ್ರೇಷ್ಠವಾದದ್ದನ್ನು ಆನಂದಿಸುತ್ತಾನೆ,</para>
  <para style="q2" vid="PRO 13:2">ಆದರೆ ವಿಶ್ವಾಸದ್ರೋಹಿಗಳಿಗೆ ಹಿಂಸೆಯ ಹಸಿವು ಇರುತ್ತದೆ.<verse eid="PRO 13:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 13:3"/>ತನ್ನ ಬಾಯನ್ನು ಕಾಯುವವನು ಜೀವವನ್ನು ಕಾಯುತ್ತಾನೆ;</para>
  <para style="q2" vid="PRO 13:3">ತನ್ನ ತುಟಿಗಳನ್ನು ಹತೋಟಿಯಲ್ಲಿಡದವನು ನಾಶವಾಗುವನು.<verse eid="PRO 13:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 13:4"/>ಸೋಮಾರಿಯ ಹಸಿವು ಎಂದಿಗೂ ತುಂಬುವುದಿಲ್ಲ;</para>
  <para style="q2" vid="PRO 13:4">ಆದರೆ ಶ್ರಮಪಡುವವರ ಆಸೆಗಳು ಸಂಪೂರ್ಣವಾಗಿ ಈಡೇರುವವು.<verse eid="PRO 13:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 13:5"/>ನೀತಿವಂತನು ಸುಳ್ಳನ್ನು ಹಗೆಮಾಡುತ್ತಾನೆ,</para>
  <para style="q2" vid="PRO 13:5">ಆದರೆ ದುಷ್ಟರು ತಮ್ಮನ್ನು ತಾವೇ ದುರ್ವಾಸನೆಗೊಳಪಡಿಸಿಕೊಳ್ಳುತ್ತಾರೆ</para>
  <para style="q2" vid="PRO 13:5">ಮತ್ತು ತಮ್ಮ ಮೇಲೆ ಅವಮಾನವನ್ನು ತಂದುಕೊಳ್ಳುತ್ತಾರೆ.<verse eid="PRO 13:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 13:6"/>ನೀತಿಯು ಯಥಾರ್ಥವಂತನನ್ನು ಕಾಪಾಡುತ್ತದೆ;</para>
  <para style="q2" vid="PRO 13:6">ಆದರೆ ದುಷ್ಟತನವು ಪಾಪಿಯನ್ನು ಕೆಡವುತ್ತದೆ.<verse eid="PRO 13:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 13:7"/>ಬಡವನಾಗಿದ್ದರೂ ಐಶ್ವರ್ಯವಂತನಾಗಿ ನಟಿಸುವವನು ಇದ್ದಾನೆ;</para>
  <para style="q2" vid="PRO 13:7">ಮತ್ತೊಬ್ಬನು ದರಿದ್ರನಾಗಿ ಕಾಣಿಸಿದರೂ ಬಹು ಸಿರಿವಂತನೇ.<verse eid="PRO 13:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 13:8"/>ಐಶ್ವರ್ಯವಂತನ ಪ್ರಾಣದ ವಿಮೋಚನೆಯು ಅವನ ಐಶ್ವರ್ಯದಿಂದಲೇ;</para>
  <para style="q2" vid="PRO 13:8">ಆದರೆ ಬಡವನು ಬೆದರಿಕೆಗಳಿಗೆ ಪ್ರತಿಕ್ರಿಯಿಸಲು ಸಾಧ್ಯವಿಲ್ಲ.<verse eid="PRO 13:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 13:9"/>ನೀತಿವಂತರ ಬೆಳಕು ಪ್ರಕಾಶಮಾನವಾಗಿ ಹೊಳೆಯುತ್ತದೆ;</para>
  <para style="q2" vid="PRO 13:9">ದುಷ್ಟರ ದೀಪವು ಆರಿಹೋಗುವುದು.<verse eid="PRO 13:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 13:10"/>ಎಲ್ಲಿ ಗರ್ವವೋ ಅಲ್ಲಿ ಕಲಹ;</para>
  <para style="q2" vid="PRO 13:10">ಆದರೆ ಒಳ್ಳೆಯ ಸಲಹೆಯನ್ನು ತೆಗೆದುಕೊಳ್ಳುವವರಲ್ಲಿ ಜ್ಞಾನವು ಕಂಡುಬರುತ್ತದೆ.<verse eid="PRO 13:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 13:11"/>ಅಪ್ರಾಮಾಣಿಕವಾಗಿ ಹೊಂದಿದ ಸಂಪತ್ತು ಕ್ಷಯಿಸುವುದು;</para>
  <para style="q2" vid="PRO 13:11">ಪ್ರಯಾಸದಿಂದ ಕೂಡಿಸಿದ ಸಂಪತ್ತು ವೃದ್ಧಿಗೊಳ್ಳುವುದು.<verse eid="PRO 13:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 13:12"/>ನಿರೀಕ್ಷೆ ತಡವಾದರೆ ಹೃದಯವು ಅಸ್ವಸ್ಥಗೊಳ್ಳುತ್ತದೆ;</para>
  <para style="q2" vid="PRO 13:12">ಆಶೆಯು ಈಡೇರಿದರೆ, ಅದು ಜೀವಕರವಾದ ವೃಕ್ಷವು.<verse eid="PRO 13:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 13:13"/>ದೇವರ ವಾಕ್ಯವನ್ನು ಉಲ್ಲಂಘಿಸುವವನು ನಾಶವಾಗುವನು;</para>
  <para style="q2" vid="PRO 13:13">ಆಜ್ಞೆಗೆ ಭಯಪಡುವವನು ಪ್ರತಿಫಲ ಹೊಂದುವನು.<verse eid="PRO 13:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 13:14"/>ಮರಣದ ಪಾಶಗಳಿಂದ ತಪ್ಪಿಸಿಕೊಳ್ಳುವುದಕ್ಕೆ</para>
  <para style="q2" vid="PRO 13:14">ಜ್ಞಾನವಂತರ ಉಪದೇಶವು ಜೀವದ ಬುಗ್ಗೆಯಾಗಿದೆ.<verse eid="PRO 13:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 13:15"/>ಒಳ್ಳೆಯ ಪ್ರಜ್ಞೆ ಇರುವ ವ್ಯಕ್ತಿಯನ್ನು ಗೌರವಿಸಲಾಗುತ್ತದೆ;</para>
  <para style="q2" vid="PRO 13:15">ಆದರೆ ವಿಶ್ವಾಸದ್ರೋಹಿಯ ಮಾರ್ಗವು ನಾಶಕರವಾಗಿದೆ.<verse eid="PRO 13:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 13:16"/>ಪ್ರತಿ ಜಾಣನು ತಿಳುವಳಿಕೆಯಿಂದ ವರ್ತಿಸುತ್ತಾನೆ;</para>
  <para style="q2" vid="PRO 13:16">ಆದರೆ ಮೂರ್ಖನು ತನ್ನ ಮೂರ್ಖತ್ವವನ್ನು ಹೊರಗೆಡವುತ್ತಾನೆ.<verse eid="PRO 13:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 13:17"/>ದುಷ್ಟ ದೂತನು ಕೇಡಿಗೆ ಬೀಳುತ್ತಾನೆ;</para>
  <para style="q2" vid="PRO 13:17">ಆದರೆ ನಂಬಿಗಸ್ತನಾದ ರಾಯಭಾರಿಯು ಆರೋಗ್ಯದಾಯಕನು.<verse eid="PRO 13:17"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 13:18"/>ಬೋಧನೆಯನ್ನು ಕಡೆಗಣಿಸುವವನಿಗೆ ಬಡತನವೂ, ಅವಮಾನವೂ ಬರುವುವು;</para>
  <para style="q2" vid="PRO 13:18">ಗದರಿಕೆಯನ್ನು ಗಮನಿಸುವವನು ಸನ್ಮಾನ ಹೊಂದುವನು.<verse eid="PRO 13:18"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 13:19"/>ಕನಸುಗಳು ನನಸಾಗುವುದನ್ನು ನೋಡುವುದು ಆಹ್ಲಾದಕರವಾಗಿರುತ್ತದೆ;</para>
  <para style="q2" vid="PRO 13:19">ಕೆಟ್ಟತನದಿಂದ ತಿರುಗುವುದು ಮೂರ್ಖರಿಗೆ ಅಸಹ್ಯವಾಗಿದೆ.<verse eid="PRO 13:19"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 13:20"/>ಜ್ಞಾನವಂತರ ಜೊತೆಗೆ ನಡೆಯುವವನು ಜ್ಞಾನಿಯಾಗುವನು;</para>
  <para style="q2" vid="PRO 13:20">ಆದರೆ ಮೂರ್ಖರ ಜೊತೆಗಾರನು ಸಂಕಟಪಡುವನು.<verse eid="PRO 13:20"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 13:21"/>ವಿಪತ್ತು ಪಾಪಿಗಳನ್ನು ಹಿಂಬಾಲಿಸುತ್ತದೆ;</para>
  <para style="q2" vid="PRO 13:21">ಆದರೆ ನೀತಿವಂತರಿಗೆ ಒಳ್ಳೆಯದು ಪ್ರತಿಫಲವಾಗುವುದು.<verse eid="PRO 13:21"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 13:22"/>ಒಳ್ಳೆಯವನು ಮೊಮ್ಮಕ್ಕಳಿಗೆ ಆಸ್ತಿಯನ್ನು ಬಿಟ್ಟುಬಿಡುವನು;</para>
  <para style="q2" vid="PRO 13:22">ಆದರೆ ಪಾಪಿಯ ಸಂಪತ್ತು ನೀತಿವಂತರಿಗಾಗಿ ಸಂಗ್ರಹವಾಗಿದೆ.<verse eid="PRO 13:22"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 13:23"/>ಬಡವರಿಗೆ ಜವುಳು ಭೂಮಿಯಲ್ಲಿಯೂ ಬಹು ಬೆಳೆಯು ಸಿಕ್ಕುತ್ತದೆ;</para>
  <para style="q2" vid="PRO 13:23">ಅನ್ಯಾಯವು ಅದನ್ನು ಹಾರಿಸಿಬಿಡುವುದು.<verse eid="PRO 13:23"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 13:24"/>ಬೆತ್ತವನ್ನು ಹಿಡಿಯದವನು ತನ್ನ ಮಗನನ್ನು ಹಗೆಮಾಡುತ್ತಾನೆ;</para>
  <para style="q2" vid="PRO 13:24">ಆದರೆ ತಮ್ಮ ಮಕ್ಕಳನ್ನು ಪ್ರೀತಿಸುವವನು ಅವರನ್ನು ಶಿಸ್ತು ಮಾಡಲು ಜಾಗರೂಕರಾಗಿರುತ್ತಾನೆ.<verse eid="PRO 13:24"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 13:25"/>ನೀತಿವಂತನು ತನ್ನ ಪ್ರಾಣವು ತೃಪ್ತಿಯಾಗುವವರೆಗೆ ತಿನ್ನುತ್ತಾನೆ;</para>
  <para style="q2" vid="PRO 13:25">ದುಷ್ಟರ ಹೊಟ್ಟೆಗೆ ಕೊರತೆಯಾಗುವುದು.<verse eid="PRO 13:25"/></para>
  <para style="b"/>
  <chapter eid="PRO 13"/>
  <chapter number="14" style="c" sid="PRO 14"/>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 14:1"/>ಜ್ಞಾನಿಯಾದ ಸ್ತ್ರೀಯು ತನ್ನ ಮನೆಯನ್ನು ಕಟ್ಟುತ್ತಾಳೆ;</para>
  <para style="q2" vid="PRO 14:1">ಬುದ್ಧಿಹೀನಳೋ ತನ್ನ ಕೈಗಳಿಂದಲೇ ಅದನ್ನು ಕಿತ್ತುಹಾಕುತ್ತಾಳೆ.<verse eid="PRO 14:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 14:2"/>ತನ್ನ ಯಥಾರ್ಥತೆಯಲ್ಲಿ ನಡೆಯುವವನು ಯೆಹೋವ ದೇವರಿಗೆ ಭಯಪಡುತ್ತಾನೆ,</para>
  <para style="q2" vid="PRO 14:2">ಆದರೆ ಅವರನ್ನು ತಿರಸ್ಕರಿಸುವವರು ತಮ್ಮ ಮಾರ್ಗಗಳಲ್ಲಿ ಮೋಸ ಹೋಗುತ್ತಾರೆ.<verse eid="PRO 14:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 14:3"/>ಬುದ್ಧಿಹೀನನ ಬಾಯಿಯಲ್ಲಿ ಗರ್ವದ ಅಂಕುರವಿದೆ,</para>
  <para style="q2" vid="PRO 14:3">ಆದರೆ ಜ್ಞಾನವಂತರ ತುಟಿಗಳು ಅವರನ್ನು ಕಾಪಾಡುವುವು.<verse eid="PRO 14:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 14:4"/>ಎತ್ತುಗಳು ಇಲ್ಲದೆ ಇರುವಲ್ಲಿ ಗೋದಲಿಯು ಶುಚಿಯಾಗಿರುತ್ತದೆ,</para>
  <para style="q2" vid="PRO 14:4">ಆದರೆ ಎತ್ತಿನ ಬಲದಿಂದಲೇ ಬೆಳೆಯು ಹೇರಳವಾಗಿ ವೃದ್ಧಿಯಾಗುತ್ತದೆ.<verse eid="PRO 14:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 14:5"/>ಪ್ರಾಮಾಣಿಕ ಸಾಕ್ಷಿಯು ಸುಳ್ಳಾಡನು,</para>
  <para style="q2" vid="PRO 14:5">ಆದರೆ ಸುಳ್ಳುಸಾಕ್ಷಿಯು ಅಸತ್ಯವನ್ನೇ ಆಡುವನು.<verse eid="PRO 14:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 14:6"/>ಅಪಹಾಸ್ಯ ಮಾಡುವವನು ಜ್ಞಾನವನ್ನು ಹುಡುಕಿದರೂ ಅದನ್ನು ಕಂಡುಕೊಳ್ಳುವುದಿಲ್ಲ,</para>
  <para style="q2" vid="PRO 14:6">ಆದರೆ ವಿವೇಚಿಸುವವನಿಗೆ ಜ್ಞಾನವು ಸುಲಭವಾಗಿದೆ.<verse eid="PRO 14:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 14:7"/>ನೀನು ಬುದ್ಧಿಹೀನನ ತುಟಿಗಳಲ್ಲಿ ಪರಿಜ್ಞಾನವನ್ನು ಕಾಣದೆ ಹೋದರೆ,</para>
  <para style="q2" vid="PRO 14:7">ಅವನ ಬಳಿಯಿಂದ ಹೊರಟು ಹೋಗು.<verse eid="PRO 14:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 14:8"/>ಜಾಣನ ಜ್ಞಾನವು ತನ್ನ ಮಾರ್ಗಗಳಿಗೆ ಆಲೋಚನೆ ನೀಡುತ್ತದೆ.</para>
  <para style="q2" vid="PRO 14:8">ಮೂಢರ ಬುದ್ಧಿಹೀನತೆಯು ಮೋಸಕರ.<verse eid="PRO 14:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 14:9"/>ಬುದ್ಧಿಹೀನರು ಪಾಪಪರಿಹಾರವನ್ನು ಅಪಹಾಸ್ಯ ಮಾಡುವರು,</para>
  <para style="q2" vid="PRO 14:9">ಆದರೆ ನೀತಿವಂತರಿಗೆ ದಯೆಯಿದೆ.<verse eid="PRO 14:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 14:10"/>ಹೃದಯಕ್ಕೆ ತನ್ನ ವ್ಯಥೆಯು ಗೊತ್ತು;</para>
  <para style="q2" vid="PRO 14:10">ಪರನು ಅದರ ಸಂತೋಷದಲ್ಲಿ ಪಾಲಾಗುವುದಿಲ್ಲ.<verse eid="PRO 14:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 14:11"/>ದುಷ್ಟರ ಮನೆಯು ನಾಶವಾಗುವುದು,</para>
  <para style="q2" vid="PRO 14:11">ಆದರೆ ಯಥಾರ್ಥವಂತರ ಗುಡಾರವು ಏಳಿಗೆಯಾಗುವುದು.<verse eid="PRO 14:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 14:12"/>ಮನುಷ್ಯ ದೃಷ್ಟಿಗೆ ಸರಿ ತೋರುವ ಒಂದು ಮಾರ್ಗವಿದೆ,</para>
  <para style="q2" vid="PRO 14:12">ಆದರೆ ಅದರ ಅಂತ್ಯವು ಮರಣದ ಮಾರ್ಗಗಳೇ.<verse eid="PRO 14:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 14:13"/>ನಗೆಯಲ್ಲಿಯೂ ಹೃದಯವು ದುಃಖದಿಂದ ಇರುವುದು,</para>
  <para style="q2" vid="PRO 14:13">ಅದರ ಉಲ್ಲಾಸದ ಅಂತ್ಯವು ಸಂತಾಪವೇ.<verse eid="PRO 14:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 14:14"/>ಭ್ರಷ್ಟನು ತನ್ನ ದುಷ್ಕರ್ಮಗಳಿಂದ ದಣಿಯನು,</para>
  <para style="q2" vid="PRO 14:14">ಒಳ್ಳೆಯವನು ತನ್ನಲ್ಲಿ ತಾನೇ ತೃಪ್ತಿಹೊಂದುವನು.<verse eid="PRO 14:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 14:15"/>ಅರಿವಿಲ್ಲದವರು ಯಾವ ಮಾತನ್ನಾದರೂ ನಂಬುತ್ತಾರೆ,</para>
  <para style="q2" vid="PRO 14:15">ಜಾಣನು ತನ್ನ ನಡತೆಯನ್ನು ಚೆನ್ನಾಗಿ ಗಮನಿಸುವನು.<verse eid="PRO 14:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 14:16"/>ಜ್ಞಾನಿಯು ಯೆಹೋವ ದೇವರಿಗೆ ಭಯಪಟ್ಟು ಕೆಟ್ಟತನದಿಂದ ದೂರ ಹೋಗುವನು,</para>
  <para style="q2" vid="PRO 14:16">ಆದರೆ ಬುದ್ಧಿಹೀನನು ಯೋಚಿಸದೆ ಆತ್ಮವಿಶ್ವಾಸದಿಂದ ನಡೆಯುವನು.<verse eid="PRO 14:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 14:17"/>ಮುಂಗೋಪಿಯು ಬುದ್ಧಿಹೀನನಾಗಿ ವರ್ತಿಸುತ್ತಾನೆ,</para>
  <para style="q2" vid="PRO 14:17">ಜನರು ಕುಯುಕ್ತಿಯುಳ್ಳವನನ್ನು ಹಗೆ ಮಾಡುತ್ತಾರೆ.<verse eid="PRO 14:17"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 14:18"/>ಅರಿವಿಲ್ಲದವರು ಮೂರ್ಖತನಕ್ಕೆ ಬಾಧ್ಯರಾಗುತ್ತಾರೆ,</para>
  <para style="q2" vid="PRO 14:18">ಆದರೆ ಜಾಣರು ಪರಿಜ್ಞಾನದಿಂದ ಆವರಿಸುತ್ತಾರೆ.<verse eid="PRO 14:18"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 14:19"/>ದುಷ್ಟರು ಒಳ್ಳೆಯವರಿಗೆ ಬಾಗುತ್ತಾರೆ,</para>
  <para style="q2" vid="PRO 14:19">ದುಷ್ಟರು ನೀತಿವಂತರ ದ್ವಾರಗಳಲ್ಲಿ ಅಡ್ಡ ಬೀಳುತ್ತಾರೆ.<verse eid="PRO 14:19"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 14:20"/>ಬಡವನು ಅವನ ನೆರೆಯವನಿಂದಲೇ ಕಡೆಗಣಿಸಲಾಗುವನು;</para>
  <para style="q2" vid="PRO 14:20">ಆದರೆ ಐಶ್ವರ್ಯವಂತನಿಗೆ ಬಹುಜನ ಮಿತ್ರರು.<verse eid="PRO 14:20"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 14:21"/>ತನ್ನ ನೆರೆಯವನನ್ನು ಅವಮಾನ ಮಾಡುವವನು ಪಾಪಮಾಡುತ್ತಾನೆ,</para>
  <para style="q2" vid="PRO 14:21">ಬಡವರ ಮೇಲೆ ಕನಿಕರ ತೋರಿಸುವವನು ಧನ್ಯನು.<verse eid="PRO 14:21"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 14:22"/>ಕೆಟ್ಟದ್ದನ್ನು ಕಲ್ಪಿಸುವವರು ದಾರಿ ತಪ್ಪುವುದಿಲ್ಲವೇ?</para>
  <para style="q2" vid="PRO 14:22">ಆದರೆ ಒಳ್ಳೆಯದನ್ನು ಕಲ್ಪಿಸುವವರಿಗೆ ಪ್ರೀತಿ ಸತ್ಯತೆಯು ಇರುವುವು.<verse eid="PRO 14:22"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 14:23"/>ಎಲ್ಲಾ ಪ್ರಯಾಸದಲ್ಲಿ ಲಾಭವಿದೆ,</para>
  <para style="q2" vid="PRO 14:23">ಹರಟೆ ಮಾತು ಬಡತನಕ್ಕೆ ಮಾತ್ರ ದಾರಿ.<verse eid="PRO 14:23"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 14:24"/>ಜ್ಞಾನವಂತರ ಕಿರೀಟವೇ ಅವರ ಸಂಪತ್ತು,</para>
  <para style="q2" vid="PRO 14:24">ಆದರೆ ಬುದ್ಧಿಹೀನರ ಬುದ್ಧಿಹೀನತೆಯು ಅವರ ಮೂರ್ಖತನವನ್ನು ನೀಡುತ್ತದೆ.<verse eid="PRO 14:24"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 14:25"/>ಸತ್ಯಸಾಕ್ಷಿಯು ಪ್ರಾಣಗಳನ್ನು ರಕ್ಷಿಸುತ್ತಾನೆ,</para>
  <para style="q2" vid="PRO 14:25">ಸುಳ್ಳುಸಾಕ್ಷಿಯು ಮೋಸಗಾರನು.<verse eid="PRO 14:25"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 14:26"/>ಯೆಹೋವ ದೇವರಿಗೆ ಭಯಪಡುವವನು ಭದ್ರಕೋಟೆಯನ್ನು ಹೊಂದಿದ್ದಾನೆ.</para>
  <para style="q2" vid="PRO 14:26">ಆತನ ಮಕ್ಕಳಿಗೆ ಆಶ್ರಯವು ಇರುವುದು.<verse eid="PRO 14:26"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 14:27"/>ಯೆಹೋವ ದೇವರ ಭಯವು ಜೀವದ ಬುಗ್ಗೆಯಾಗಿದೆ.</para>
  <para style="q2" vid="PRO 14:27">ಅದು ಮನುಷ್ಯನನ್ನು ಮರಣದ ಪಾಶಗಳಿಂದ ತಿರುಗಿಸುತ್ತದೆ.<verse eid="PRO 14:27"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 14:28"/>ಜನಸಮೂಹದಲ್ಲಿ ಅರಸನ ಘನತೆ ಇದೆ.</para>
  <para style="q2" vid="PRO 14:28">ಆದರೆ ಜನರ ಕೊರತೆಯಲ್ಲಿ ರಾಜಪುತ್ರನ ನಾಶ.<verse eid="PRO 14:28"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 14:29"/>ತಾಳ್ಮೆಯುಳ್ಳವನು ಬಹು ವಿವೇಕಿ,</para>
  <para style="q2" vid="PRO 14:29">ಮುಂಗೋಪಿಯು ಮೂರ್ಖತನವನ್ನು ಎತ್ತಿಹಿಡಿಯುವನು.<verse eid="PRO 14:29"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="30" style="v" sid="PRO 14:30"/>ಶಾಂತ ಹೃದಯವು ದೇಹಕ್ಕೆ ಜೀವ;</para>
  <para style="q2" vid="PRO 14:30">ಆದರೆ ಮತ್ಸರವು ಎಲುಬುಗಳಿಗೆ ಕ್ಷಯ.<verse eid="PRO 14:30"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="31" style="v" sid="PRO 14:31"/>ಬಡವರನ್ನು ಹಿಂಸಿಸುವವನು, ತನ್ನ ಸೃಷ್ಟಿಕರ್ತನನ್ನು ಹೀನೈಸುವನು,</para>
  <para style="q2" vid="PRO 14:31">ಆದರೆ ಬಡವರನ್ನು ಕನಿಕರಿಸುವವನು ದೇವರನ್ನು ಸನ್ಮಾನಿಸುವನು.<verse eid="PRO 14:31"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="32" style="v" sid="PRO 14:32"/>ದುಷ್ಟನು ತನ್ನ ಆಪತ್ಕಾಲದಲ್ಲಿ ಹಾಳಾಗುತ್ತಾನೆ,</para>
  <para style="q2" vid="PRO 14:32">ಆದರೆ ನೀತಿವಂತನಿಗೆ ಮರಣದಲ್ಲಿಯೂ ಆಶ್ರಯ ಇದೆ.<verse eid="PRO 14:32"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="33" style="v" sid="PRO 14:33"/>ತಿಳುವಳಿಕೆಯುಳ್ಳವನ ಹೃದಯದಲ್ಲಿ ಜ್ಞಾನವು ನೆಲೆಯಾಗಿದೆ,</para>
  <para style="q2" vid="PRO 14:33">ಆದರೆ ಮೂರ್ಖರಲ್ಲಿ ಜ್ಞಾನವು ಕಂಡುಬರುವುದಿಲ್ಲ.<verse eid="PRO 14:33"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="34" style="v" sid="PRO 14:34"/>ನೀತಿಯು ಜನಾಂಗವನ್ನು ವೃದ್ಧಿಮಾಡುತ್ತದೆ;</para>
  <para style="q2" vid="PRO 14:34">ಆದರೆ ಯಾವ ಪ್ರಜೆಗಾದರೂ ಪಾಪವು ಅವಮಾನವಾಗಿದೆ.<verse eid="PRO 14:34"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="35" style="v" sid="PRO 14:35"/>ಜ್ಞಾನವುಳ್ಳ ಸೇವಕನ ಕಡೆಗೆ ಅರಸನ ದಯೆ ಇದೆ;</para>
  <para style="q2" vid="PRO 14:35">ಆದರೆ ಮಾನಗೇಡಿ ಸೇವಕನ ಮೇಲೆ ಅರಸನ ಕೋಪ ಎರಗುತ್ತದೆ.<verse eid="PRO 14:35"/></para>
  <para style="b"/>
  <chapter eid="PRO 14"/>
  <chapter number="15" style="c" sid="PRO 15"/>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 15:1"/>ಮೃದುವಾದ ಉತ್ತರವು ಕೋಪವನ್ನು ತಿರುಗಿಸಿಬಿಡುತ್ತದೆ.</para>
  <para style="q2" vid="PRO 15:1">ಆದರೆ ಬಿರುಸಾದ ಮಾತುಗಳು ಕೋಪವನ್ನು ಎಬ್ಬಿಸುತ್ತದೆ.<verse eid="PRO 15:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 15:2"/>ಜ್ಞಾನಿಯ ನಾಲಿಗೆಯು ಒಳ್ಳೆಯ ಪರಿಜ್ಞಾನವನ್ನು ಹರಡುತ್ತದೆ.</para>
  <para style="q2" vid="PRO 15:2">ಆದರೆ ಬುದ್ಧಿಹೀನರ ಬಾಯಿಯು ಮೂರ್ಖತನವನ್ನು ಹೊರಗೆಡವುತ್ತದೆ.<verse eid="PRO 15:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 15:3"/>ಯೆಹೋವ ದೇವರ ಕಣ್ಣುಗಳು ಪ್ರತಿಯೊಂದು ಸ್ಥಳದಲ್ಲಿ ಇವೆ.</para>
  <para style="q2" vid="PRO 15:3">ಕೆಟ್ಟವರನ್ನೂ ಒಳ್ಳೆಯವರನ್ನೂ ನೋಡುತ್ತಾ ಇರುವರು.<verse eid="PRO 15:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 15:4"/>ಹಿತವಾದ ನಾಲಿಗೆಯು ಜೀವವೃಕ್ಷ.</para>
  <para style="q2" vid="PRO 15:4">ಆದರೆ ವಕ್ರ ನಾಲಿಗೆಯು ಆತ್ಮಚೈತನ್ಯವನ್ನು ನಾಶಮಾಡುವುದು.<verse eid="PRO 15:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 15:5"/>ಮೂರ್ಖನು ತನ್ನ ತಂದೆಯ ಶಿಸ್ತನ್ನು ತಿರಸ್ಕರಿಸುತ್ತಾನೆ.</para>
  <para style="q2" vid="PRO 15:5">ಆದರೆ ಜಾಣನು ಗದರಿಕೆಯನ್ನು ಲಕ್ಷಿಸುವನು.<verse eid="PRO 15:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 15:6"/>ನೀತಿವಂತನ ಮನೆಯಲ್ಲಿ ಬಹಳ ಸಂಪತ್ತು.</para>
  <para style="q2" vid="PRO 15:6">ಆದರೆ ದುಷ್ಟನ ಆದಾಯವು ವಿನಾಶ ತರುವುದು.<verse eid="PRO 15:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 15:7"/>ಜ್ಞಾನಿಗಳ ತುಟಿಗಳು ಪರಿಜ್ಞಾನವನ್ನು ಹರಡುತ್ತವೆ.</para>
  <para style="q2" vid="PRO 15:7">ಆದರೆ ಬುದ್ಧಿಹೀನರ ಹೃದಯವು ಹಾಗೆ ಮಾಡುವುದೇ ಇಲ್ಲ.<verse eid="PRO 15:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 15:8"/>ದುಷ್ಟರ ಯಜ್ಞವು ಯೆಹೋವ ದೇವರಿಗೆ ಅಸಹ್ಯ.</para>
  <para style="q2" vid="PRO 15:8">ಆದರೆ ಯಥಾರ್ಥವಂತರ ಪ್ರಾರ್ಥನೆಯು ಅವರಿಗೆ ಮೆಚ್ಚುಗೆ.<verse eid="PRO 15:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 15:9"/>ದುಷ್ಟರ ಮಾರ್ಗವು ಯೆಹೋವ ದೇವರಿಗೆ ಅಸಹ್ಯ.</para>
  <para style="q2" vid="PRO 15:9">ಆದರೆ ನೀತಿಯನ್ನು ಹಿಂಬಾಲಿಸುವವನನ್ನು ಅವರು ಪ್ರೀತಿಸುತ್ತಾರೆ.<verse eid="PRO 15:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 15:10"/>ಮಾರ್ಗವನ್ನು ತೊರೆದುಬಿಟ್ಟವನಿಗೆ ಶಿಕ್ಷೆಯು ಕಠಿಣವಾಗಿದೆ.</para>
  <para style="q2" vid="PRO 15:10">ಗದರಿಕೆಯನ್ನು ಹಗೆಮಾಡುವವನು ಸಾಯುವನು.<verse eid="PRO 15:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 15:11"/>ಮರಣವೂ ಪಾತಾಳವೂ ಯೆಹೋವ ದೇವರಿಗೆ ಕಾಣುತ್ತಿರುವಾಗ,</para>
  <para style="q2" vid="PRO 15:11">ಮನುಷ್ಯರ ಹೃದಯಗಳು ಅವರಿಗೆ ಮುಚ್ಚುಮರೆಯೇ?<verse eid="PRO 15:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 15:12"/>ಕುಚೋದ್ಯಗಾರನು ಬುದ್ಧಿವಾದವನ್ನು ದ್ವೇಷಿಸುತ್ತಾನೆ.</para>
  <para style="q2" vid="PRO 15:12">ಅವನು ಜ್ಞಾನಿಗಳಿಂದ ದೂರವಿರುತ್ತಾನೆ.<verse eid="PRO 15:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 15:13"/>ಸಂತೋಷದ ಹೃದಯವು ಹರ್ಷವುಳ್ಳ ಮುಖಭಾವ ತೋರುವುದು.</para>
  <para style="q2" vid="PRO 15:13">ಆದರೆ ನೊಂದ ಹೃದಯವು ಆತ್ಮಚೈತನ್ಯವನ್ನು ಕುಂದಿಸುತ್ತದೆ.<verse eid="PRO 15:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 15:14"/>ವಿವೇಕವುಳ್ಳವನ ಹೃದಯವು ಪರಿಜ್ಞಾನವನ್ನು ಹುಡುಕುತ್ತದೆ.</para>
  <para style="q2" vid="PRO 15:14">ಆದರೆ ಬುದ್ಧಿಹೀನರ ಬಾಯಿಯು ಮೂರ್ಖತನವನ್ನೇ ತಿನ್ನುತ್ತದೆ.<verse eid="PRO 15:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 15:15"/>ಬಾಧಿತರ ದಿನಗಳೆಲ್ಲವೂ ದುಃಖಭರಿತ.</para>
  <para style="q2" vid="PRO 15:15">ಆದರೆ ಸಂತೋಷ ಹೃದಯವುಳ್ಳವನಿಗೆ ನಿತ್ಯವೂ ಔತಣ.<verse eid="PRO 15:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 15:16"/>ತೊಂದರೆಯಿಂದ ಕೂಡಿದ ದೊಡ್ಡ ಸಂಪತ್ತಿಗಿಂತ</para>
  <para style="q2" vid="PRO 15:16">ಯೆಹೋವ ದೇವರ ಭಯದಿಂದ ಕೂಡಿದ ಅಲ್ಪವೇ ಮೇಲು.<verse eid="PRO 15:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 15:17"/>ದ್ವೇಷವಿರುವಲ್ಲಿ ಕೊಬ್ಬಿದ ಎತ್ತಿನ ಮಾಂಸಕ್ಕಿಂತಲೂ,</para>
  <para style="q2" vid="PRO 15:17">ಪ್ರೀತಿ ಇರುವಲ್ಲಿ ಸಸ್ಯಾಹಾರ ಊಟವೇ ಉತ್ತಮ.<verse eid="PRO 15:17"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 15:18"/>ಕೋಪಿಷ್ಟನು ವಿವಾದವನ್ನು ಎಬ್ಬಿಸುವನು.</para>
  <para style="q2" vid="PRO 15:18">ಆದರೆ ತಾಳ್ಮೆಯಿಂದ ಇರುವವನು ಜಗಳವನ್ನು ಶಾಂತಗೊಳಿಸುವನು.<verse eid="PRO 15:18"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 15:19"/>ಸೋಮಾರಿಯ ಮಾರ್ಗವು ಮುಳ್ಳಿನ ಬೇಲಿಯಂತೆ ಇದೆ.</para>
  <para style="q2" vid="PRO 15:19">ಆದರೆ ಯಥಾರ್ಥವಂತನ ಮಾರ್ಗವು ರಾಜಮಾರ್ಗ.<verse eid="PRO 15:19"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 15:20"/>ಜ್ಞಾನಿಯಾದ ಮಗನು ತಂದೆಯನ್ನು ಉಲ್ಲಾಸಗೊಳಿಸುತ್ತಾನೆ.</para>
  <para style="q2" vid="PRO 15:20">ಬುದ್ಧಿಹೀನನಾದರೋ ತನ್ನ ತಾಯಿಯನ್ನು ತಿರಸ್ಕರಿಸುತ್ತಾನೆ.<verse eid="PRO 15:20"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 15:21"/>ಬುದ್ಧಿಹೀನನು ಮೂರ್ಖತನದಲ್ಲಿ ಉಲ್ಲಾಸಿಸುವನು.</para>
  <para style="q2" vid="PRO 15:21">ತಿಳುವಳಿಕೆಯನ್ನು ಹೊಂದಿರುವವನು ನೇರ ಮಾರ್ಗದಲ್ಲಿ ನಡೆಯುತ್ತಾನೆ.<verse eid="PRO 15:21"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 15:22"/>ಸಲಹೆಯ ಕೊರತೆಯಿಂದ ಯೋಜನೆಗಳು ವಿಫಲಗೊಳ್ಳುತ್ತವೆ.</para>
  <para style="q2" vid="PRO 15:22">ಆದರೆ ಬಹುಮಂದಿ ಸಲಹೆಗಾರರಿರುವಲ್ಲಿ ಅವು ಸಫಲಗೊಳ್ಳುವುವು.<verse eid="PRO 15:22"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 15:23"/>ಸೂಕ್ತವಾದ ಉತ್ತರವನ್ನು ನೀಡುವಲ್ಲಿ ಮನುಷ್ಯನು ಸಂತೋಷವನ್ನು ಕಂಡುಕೊಳ್ಳುತ್ತಾನೆ.</para>
  <para style="q2" vid="PRO 15:23">ತಕ್ಕ ಕಾಲದಲ್ಲಿ ಆಡಿದ ಮಾತು ಎಷ್ಟೋ ಒಳ್ಳೆಯದು.<verse eid="PRO 15:23"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 15:24"/>ಜೀವದ ಮಾರ್ಗವು ಜಾಣನನ್ನು ಮೇಲಕ್ಕೆತ್ತುವುದು.</para>
  <para style="q2" vid="PRO 15:24">ಅದು ಅವನನ್ನು ಪಾತಾಳಕ್ಕೆ ಇಳಿಯುವದರಿಂದ ತಪ್ಪಿಸುವುದು.<verse eid="PRO 15:24"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 15:25"/>ಯೆಹೋವ ದೇವರು ಗರ್ವಿಷ್ಠರ ಮನೆಯನ್ನು ಕೆಡವಿಬಿಡುವರು,</para>
  <para style="q2" vid="PRO 15:25">ಆದರೆ ವಿಧವೆಯರ ಮೇರೆಯನ್ನು ಅವರು ನೆಲೆಗೊಳಿಸುವರು.<verse eid="PRO 15:25"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 15:26"/>ದುಷ್ಟರ ಆಲೋಚನೆಯು ಯೆಹೋವ ದೇವರಿಗೆ ಅಸಹ್ಯವಾಗಿದೆ,</para>
  <para style="q2" vid="PRO 15:26">ಆದರೆ ಸೌಜನ್ಯಶೀಲ ಮಾತುಗಳು ಅವರ ದೃಷ್ಟಿಯಲ್ಲಿ ಶುದ್ಧವಾಗಿವೆ.<verse eid="PRO 15:26"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 15:27"/>ದುರಾಶೆಯುಳ್ಳವನು ತನ್ನ ಕುಟುಂಬವನ್ನು ಬಾಧಿಸುತ್ತಾನೆ.</para>
  <para style="q2" vid="PRO 15:27">ಲಂಚವನ್ನು ಹಗೆಮಾಡುವವನು ಬದುಕುವನು.<verse eid="PRO 15:27"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 15:28"/>ನೀತಿವಂತರ ಹೃದಯವು ಹೇಗೆ ಉತ್ತರಿಸಬೇಕೆಂದು ಯೋಚಿಸುತ್ತದೆ.</para>
  <para style="q2" vid="PRO 15:28">ಆದರೆ ದುಷ್ಟರ ಬಾಯಿಯು ಕೆಟ್ಟವುಗಳನ್ನು ಹೊರಗೆಡವುತ್ತದೆ.<verse eid="PRO 15:28"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 15:29"/>ಯೆಹೋವ ದೇವರು ದುಷ್ಟರಿಗೆ ದೂರ;</para>
  <para style="q2" vid="PRO 15:29">ಆದರೆ ನೀತಿವಂತರ ಪ್ರಾರ್ಥನೆಯನ್ನು ಅವರು ಕೇಳುತ್ತಾರೆ.<verse eid="PRO 15:29"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="30" style="v" sid="PRO 15:30"/>ಹರ್ಷಚಿತ್ತದ ನೋಟವು ಹೃದಯಕ್ಕೆ ಸಂತೋಷವನ್ನು ತರುತ್ತದೆ.</para>
  <para style="q2" vid="PRO 15:30">ಒಳ್ಳೆಯ ವಾರ್ತೆಯು ಎಲುಬುಗಳನ್ನು ಪುಷ್ಟಿಗೊಳಿಸುತ್ತದೆ.<verse eid="PRO 15:30"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="31" style="v" sid="PRO 15:31"/>ಜೀವದ ಗದರಿಕೆಗೆ ಕಿವಿಗೊಡುವವನು,</para>
  <para style="q2" vid="PRO 15:31">ಜ್ಞಾನಿಗಳ ನಡುವೆ ವಾಸಿಸುವವನಾಗಿದ್ದಾನೆ.<verse eid="PRO 15:31"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="32" style="v" sid="PRO 15:32"/>ಶಿಸ್ತನ್ನು ನಿರಾಕರಿಸುವವನು, ತನಗೆ ತಾನೆ ಹಾನಿ ತಂದುಕೊಳ್ಳುತ್ತಾನೆ,</para>
  <para style="q2" vid="PRO 15:32">ಆದರೆ ಗದರಿಕೆಗೆ ಕಿವಿಗೊಡುವವನು ವಿವೇಕವನ್ನು ಪಡೆಯುತ್ತಾನೆ.<verse eid="PRO 15:32"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="33" style="v" sid="PRO 15:33"/>ಯೆಹೋವ ದೇವರ ಭಯವೇ ಜ್ಞಾನವನ್ನು ಕಲಿಸುತ್ತದೆ.</para>
  <para style="q2" vid="PRO 15:33">ನಮ್ರತೆ ಗೌರವಕ್ಕೆ ಮೊದಲು ಬರುತ್ತದೆ.<verse eid="PRO 15:33"/></para>
  <para style="b"/>
  <chapter eid="PRO 15"/>
  <chapter number="16" style="c" sid="PRO 16"/>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 16:1"/>ಮನುಷ್ಯನಲ್ಲಿ ತನ್ನ ಹೃದಯದ ಯೋಜನೆಗಳು,</para>
  <para style="q2" vid="PRO 16:1">ಆದರೆ ಸರಿಯಾದ ಉತ್ತರಕೊಡುವ ಶಕ್ತಿ ಯೆಹೋವ ದೇವರಿಂದಲೇ ಬರುವವು.<verse eid="PRO 16:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 16:2"/>ಮನುಷ್ಯನ ಮಾರ್ಗಗಳೆಲ್ಲಾ ತನ್ನ ದೃಷ್ಟಿಯಲ್ಲಿ ಶುದ್ಧವಾಗಿವೆ,</para>
  <para style="q2" vid="PRO 16:2">ಆದರೆ ಯೆಹೋವ ದೇವರು ಅವನ ಉದ್ದೇಶಗಳನ್ನು ಪರೀಕ್ಷಿಸುತ್ತಾರೆ.<verse eid="PRO 16:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 16:3"/>ನಿನ್ನ ಕಾರ್ಯಗಳನ್ನು ಯೆಹೋವ ದೇವರಿಗೆ ಒಪ್ಪಿಸು,</para>
  <para style="q2" vid="PRO 16:3">ಆಗ ನಿನ್ನ ಯೋಜನೆಗಳು ಸ್ಥಿರವಾಗುವುವು.<verse eid="PRO 16:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 16:4"/>ಯೆಹೋವ ದೇವರು ಎಲ್ಲವುಗಳನ್ನು ಅದರದೇ ಆದ ಉದ್ದೇಶಗಳಿಗಾಗಿ ಮಾಡಿದ್ದಾರೆ.</para>
  <para style="q2" vid="PRO 16:4">ಹೌದು, ಕೇಡಿನ ದಿನಕ್ಕಾಗಿಯೂ ಕೆಡುಕರನ್ನು ಮಾಡಿದ್ದಾರೆ.<verse eid="PRO 16:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 16:5"/>ಹೃದಯದಲ್ಲಿ ಗರ್ವಿಷ್ಠನಾದ ಪ್ರತಿಯೊಬ್ಬನೂ ಯೆಹೋವ ದೇವರಿಗೆ ಅಸಹ್ಯ.</para>
  <para style="q2" vid="PRO 16:5">ದುಷ್ಟನಿಗೆ ಶಿಕ್ಷೆಯು ತಪ್ಪುವುದಿಲ್ಲ.<verse eid="PRO 16:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 16:6"/>ಪ್ರೀತಿ ಮತ್ತು ಸತ್ಯತೆಗಳಿಂದ ಪಾಪಕ್ಕೆ ಪ್ರಾಯಶ್ಚಿತ್ತವಾಗುತ್ತದೆ.</para>
  <para style="q2" vid="PRO 16:6">ಯೆಹೋವ ದೇವರ ಭಯದ ಮೂಲಕ ಮನುಷ್ಯರು ಕೆಟ್ಟದ್ದರಿಂದ ತೊಲಗುತ್ತಾರೆ.<verse eid="PRO 16:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 16:7"/>ಮನುಷ್ಯನ ಮಾರ್ಗಗಳು ಯೆಹೋವ ದೇವರನ್ನು ಮೆಚ್ಚಿಸಿದಾಗ,</para>
  <para style="q2" vid="PRO 16:7">ಅವರು ಅವನ ಶತ್ರುಗಳನ್ನು ಸಹ ಅವನೊಂದಿಗೆ ಸಮಾಧಾನದಲ್ಲಿರುವಂತೆ ಮಾಡುತ್ತಾರೆ.<verse eid="PRO 16:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 16:8"/>ಅನ್ಯಾಯದ ದೊಡ್ಡ ಆದಾಯಕ್ಕಿಂತಲೂ</para>
  <para style="q2" vid="PRO 16:8">ನೀತಿಯೊಂದಿಗಿರುವ ಸ್ವಲ್ಪವೇ ಉತ್ತಮ.<verse eid="PRO 16:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 16:9"/>ಒಬ್ಬ ಮನುಷ್ಯನ ಹೃದಯವು ಅವನ ಮಾರ್ಗವನ್ನು ಕಲ್ಪಿಸುತ್ತದೆ,</para>
  <para style="q2" vid="PRO 16:9">ಆದರೆ ಯೆಹೋವ ದೇವರು ಅವನ ಹೆಜ್ಜೆಗಳನ್ನು ಸ್ಥಾಪಿಸುತ್ತಾರೆ.<verse eid="PRO 16:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 16:10"/>ಅರಸನ ತುಟಿಗಳಲ್ಲಿ ದೈವೋಕ್ತಿ.</para>
  <para style="q2" vid="PRO 16:10">ನ್ಯಾಯತೀರ್ಪಿನಲ್ಲಿ ಅವನ ಬಾಯಿಯು ದೋಷ ಮಾಡುವುದಿಲ್ಲ.<verse eid="PRO 16:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 16:11"/>ನ್ಯಾಯದ ತೂಕವೂ ತಕ್ಕಡಿಯೂ ಯೆಹೋವ ದೇವರದೇ.</para>
  <para style="q2" vid="PRO 16:11">ಚೀಲದ ತೂಕಗಳು ಅವರ ಕೈಕೆಲಸವೇ.<verse eid="PRO 16:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 16:12"/>ಕೆಟ್ಟದ್ದನ್ನು ಮಾಡುವವರು ರಾಜರಿಗೆ ಅಸಹ್ಯರು.</para>
  <para style="q2" vid="PRO 16:12">ಏಕೆಂದರೆ ನೀತಿಯಿಂದ ಸಿಂಹಾಸನವು ಸ್ಥಾಪಿಸಲಾಗುತ್ತದೆ.<verse eid="PRO 16:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 16:13"/>ನೀತಿಯ ತುಟಿಗಳಲ್ಲಿ ಅರಸರು ಆನಂದಿಸುತ್ತಾರೆ,</para>
  <para style="q2" vid="PRO 16:13">ಯಥಾರ್ಥವಾದಿಯನ್ನು ಅವರು ಪ್ರೀತಿಸುತ್ತಾರೆ.<verse eid="PRO 16:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 16:14"/>ಅರಸನ ಕೋಪವು ಮೃತ್ಯುವಿನ ದೂತರಂತೆ ಇರುತ್ತದೆ,</para>
  <para style="q2" vid="PRO 16:14">ಆದರೆ ಜ್ಞಾನಿಯು ಅದನ್ನು ಶಮನಪಡಿಸುವನು.<verse eid="PRO 16:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 16:15"/>ಪ್ರಕಾಶಮಾನವಾದ ಅರಸನ ಮುಖದಲ್ಲಿ ಜೀವ,</para>
  <para style="q2" vid="PRO 16:15">ಅವನ ದಯೆಯು ಹಿಂಗಾರು ಮಳೆಯ ಮೇಘದಂತಿದೆ.<verse eid="PRO 16:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 16:16"/>ಬಂಗಾರಕ್ಕಿಂತ ಜ್ಞಾನವನ್ನು ಪಡೆಯುವುದು ಎಷ್ಟೋ ಮೇಲು!</para>
  <para style="q2" vid="PRO 16:16">ಬೆಳ್ಳಿಗಿಂತ ವಿವೇಕವನ್ನು ಆರಿಸಿಕೊಳ್ಳುವುದು ಎಷ್ಟೋ ಉತ್ತಮ.<verse eid="PRO 16:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 16:17"/>ಯಥಾರ್ಥವಂತರ ಹೆದ್ದಾರಿಯು ಕೆಟ್ಟತನದಿಂದ ಬಹುದೂರ.</para>
  <para style="q2" vid="PRO 16:17">ತನ್ನ ಮಾರ್ಗವನ್ನು ಕಾಯುವವನು ತನ್ನ ಪ್ರಾಣವನ್ನು ಕಾಪಾಡಿಕೊಳ್ಳುತ್ತಾನೆ.<verse eid="PRO 16:17"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 16:18"/>ನಾಶನಕ್ಕೆ ಮುಂದಾಗಿ ಗರ್ವ ಹೋಗುತ್ತದೆ.</para>
  <para style="q2" vid="PRO 16:18">ಬೀಳುವಿಕೆಯ ಮುಂಚೆ ಜಂಬದ ಆತ್ಮ.<verse eid="PRO 16:18"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 16:19"/>ಅಹಂಕಾರಿಗಳೊಂದಿಗೆ ಕೊಳ್ಳೆಯನ್ನು ಹಂಚಿಕೊಳ್ಳುವದಕ್ಕಿಂತ,</para>
  <para style="q2" vid="PRO 16:19">ದೀನರೊಂದಿಗೆ ದೀನ ಆತ್ಮವುಳ್ಳವರಾಗಿ ಇರುವುದು ಉತ್ತಮ.<verse eid="PRO 16:19"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 16:20"/>ಕಾರ್ಯವನ್ನು ಜ್ಞಾನದಿಂದ ನಡೆಸುವವನು ಒಳ್ಳೆಯದನ್ನು ಪಡೆಯುವನು.</para>
  <para style="q2" vid="PRO 16:20">ಯೆಹೋವ ದೇವರಲ್ಲಿ ಭರವಸೆ ಇಡುವವನು ಧನ್ಯನು.<verse eid="PRO 16:20"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 16:21"/>ಹೃದಯದಲ್ಲಿ ಜ್ಞಾನವಂತರು ವಿವೇಚನೆಯುಳ್ಳವರು ಎಂದು ಕರೆಯಲಾಗುವರು.</para>
  <para style="q2" vid="PRO 16:21">ತುಟಿಗಳ ಮಾಧುರ್ಯ ಮನವೊಲಿಸುವವು.<verse eid="PRO 16:21"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 16:22"/>ವಿವೇಕವು ವಿವೇಕಿಗಳಿಗೆ ಜೀವನದ ಬುಗ್ಗೆ,</para>
  <para style="q2" vid="PRO 16:22">ಆದರೆ ಮೂರ್ಖತನವು ಮೂರ್ಖರಿಗೆ ಶಿಕ್ಷೆಯನ್ನು ತರುತ್ತದೆ.<verse eid="PRO 16:22"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 16:23"/>ಜ್ಞಾನಿಯ ಹೃದಯವು ಅವನ ಬಾಯಿಗೆ ಜಾಣತನವನ್ನೂ,</para>
  <para style="q2" vid="PRO 16:23">ಅವನ ತುಟಿಗಳಿಗೆ ಉಪದೇಶ ಶಕ್ತಿಯನ್ನೂ ಹೆಚ್ಚಿಸುವುದು.<verse eid="PRO 16:23"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 16:24"/>ವಿನಯದ ಮಾತುಗಳು ಜೇನುಗೂಡು ಪ್ರಾಣಕ್ಕೆ ಮಧುರವೂ,</para>
  <para style="q2" vid="PRO 16:24">ಎಲುಬುಗಳಿಗೆ ಕ್ಷೇಮವೂ ಆಗಿವೆ.<verse eid="PRO 16:24"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 16:25"/>ಮನುಷ್ಯರಿಗೆ ಸರಿಯಾಗಿ ತೋರುವ ಒಂದು ಮಾರ್ಗ ಉಂಟು,</para>
  <para style="q2" vid="PRO 16:25">ಆದರೆ ಅದರ ಅಂತ್ಯವು ಮರಣದ ಮಾರ್ಗವೇ.<verse eid="PRO 16:25"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 16:26"/>ದುಡಿಯುವವನಿಗೆ ಅವನ ಹಸಿವೇ ದುಡಿಯುವಂತೆ ಮಾಡುವುದು,</para>
  <para style="q2" vid="PRO 16:26">ಅವನ ಹಸಿವು ಅವನನ್ನು ಒತ್ತಾಯ ಮಾಡುವುದು.<verse eid="PRO 16:26"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 16:27"/>ಭಕ್ತಿಹೀನನು ಕೇಡಿನ ಕುಣಿ ಅಗೆಯುತ್ತಾನೆ.</para>
  <para style="q2" vid="PRO 16:27">ಅವನ ತುಟಿಗಳು ಉರಿಯುವ ಬೆಂಕಿಯಂತಿವೆ.<verse eid="PRO 16:27"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 16:28"/>ಮೂರ್ಖನು ಜಗಳವನ್ನು ಬಿತ್ತುತ್ತಾನೆ.</para>
  <para style="q2" vid="PRO 16:28">ಚಾಡಿಕೋರನು ಪ್ರಮುಖ ಸ್ನೇಹಿತರನ್ನು ಅಗಲಿಸುತ್ತಾನೆ.<verse eid="PRO 16:28"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 16:29"/>ಬಲಾತ್ಕಾರಿಯು ನೆರೆಯವನನ್ನು ಮರುಳುಗೊಳಿಸಿ,</para>
  <para style="q2" vid="PRO 16:29">ದುರ್ಮಾರ್ಗಕ್ಕೆ ಎಳೆಯುತ್ತಾನೆ.<verse eid="PRO 16:29"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="30" style="v" sid="PRO 16:30"/>ವಕ್ರಬುದ್ಧಿಯ ಒಳಸಂಚುಗಳಿಗೆ ಅವನು ತನ್ನ ಕಣ್ಣುಗಳನ್ನು ಮುಚ್ಚಿಕೊಳ್ಳುತ್ತಾನೆ.</para>
  <para style="q2" vid="PRO 16:30">ತನ್ನ ತುಟಿಗಳನ್ನು ಕದಲಿಸುತ್ತಾ ಕೆಟ್ಟದ್ದು ಸಂಭವಿಸುವಂತೆ ಮಾಡುತ್ತಾನೆ.<verse eid="PRO 16:30"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="31" style="v" sid="PRO 16:31"/>ನರೆಗೂದಲು ಉಜ್ವಲ ಕಿರೀಟ,</para>
  <para style="q2" vid="PRO 16:31">ಅದು ನೀತಿಯ ಜೀವಿತದಲ್ಲಿ ಒದಗುತ್ತದೆ.<verse eid="PRO 16:31"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="32" style="v" sid="PRO 16:32"/>ದೀರ್ಘಶಾಂತನು ಶೂರರಿಗಿಂತಲೂ ಶ್ರೇಷ್ಠ,</para>
  <para style="q2" vid="PRO 16:32">ತನ್ನ ಮನಸ್ಸನ್ನು ಆಳುವವನು, ಪಟ್ಟಣವನ್ನು ಗೆದ್ದವನಿಗಿಂತಲೂ ಉತ್ತಮನು.<verse eid="PRO 16:32"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="33" style="v" sid="PRO 16:33"/>ಉಡಿಯಲ್ಲಿ ಚೀಟು ಹಾಕಬಹುದು,</para>
  <para style="q2" vid="PRO 16:33">ಆದರೆ ಪ್ರತಿ ತೀರ್ಪು ಯೆಹೋವ ದೇವರದ್ದೇ.<verse eid="PRO 16:33"/></para>
  <para style="b"/>
  <chapter eid="PRO 16"/>
  <chapter number="17" style="c" sid="PRO 17"/>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 17:1"/>ವಿವಾದದೊಂದಿಗೆ ತುಂಬಿದ ಔತಣದ ಮನೆಗಿಂತ,</para>
  <para style="q2" vid="PRO 17:1">ಶಾಂತಿ ಸಮಾಧಾನದ ಒಣ ತುತ್ತು ಮೇಲು.<verse eid="PRO 17:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 17:2"/>ನಾಚಿಕೆಪಡಿಸುವ ಮಗನ ಮೇಲೆ ಜಾಣನಾದ ಸೇವಕನು ಆಳುವವನಾಗಿ</para>
  <para style="q2" vid="PRO 17:2">ಸಹೋದರರಲ್ಲಿ ಬಾಧ್ಯತೆಗೆ ಪಾಲುಗಾರನಾಗುವನು.<verse eid="PRO 17:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 17:3"/>ಸೋಸುವುದಕ್ಕೆ ಬೆಳ್ಳಿಗೆ ಕುಲುಮೆ ಪುಟ, ಬಂಗಾರಕ್ಕೆ ಆವಿಗೆ;</para>
  <para style="q2" vid="PRO 17:3">ಆದರೆ ಯೆಹೋವ ದೇವರು ಹೃದಯಗಳನ್ನು ಪರಿಶೋಧಿಸುತ್ತಾರೆ.<verse eid="PRO 17:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 17:4"/>ಕೇಡು ಮಾಡುವವನು ಕೆಟ್ಟ ಮಾತುಗಳಿಗೆ ಕಿವಿಗೊಡುತ್ತಾನೆ;</para>
  <para style="q2" vid="PRO 17:4">ಸುಳ್ಳುಗಾರನು ನೀಚವಾದ ನಾಲಿಗೆಗೆ ಕಿವಿಗೊಡುವನು.<verse eid="PRO 17:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 17:5"/>ಬಡವರನ್ನು ಹಾಸ್ಯಮಾಡುವವನು, ತನ್ನನ್ನು ಸೃಷ್ಟಿಸಿದ ಯೆಹೋವ ದೇವರನ್ನು ನಿಂದಿಸುತ್ತಾನೆ;</para>
  <para style="q2" vid="PRO 17:5">ಬೇರೆಯವರ ವಿಪತ್ತುಗಳಿಗೆ ಸಂತೋಷಿಸುವವನು ಶಿಕ್ಷೆಯನ್ನು ಹೊಂದುವನು.<verse eid="PRO 17:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 17:6"/>ಮಕ್ಕಳ ಮಕ್ಕಳು ವೃದ್ಧರಿಗೆ ಕಿರೀಟ;</para>
  <para style="q2" vid="PRO 17:6">ಮಕ್ಕಳ ಭೂಷಣವು ಅವರ ತಂದೆತಾಯಿಗಳೇ.<verse eid="PRO 17:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 17:7"/>ಉತ್ತಮವಾದ ಪದಗಳು ಮೂರ್ಖನಿಗೆ ಸೂಕ್ತವಲ್ಲ;</para>
  <para style="q2" vid="PRO 17:7">ಆಳುವವನಿಗೆ ಸುಳ್ಳಾಡುವ ತುಟಿಗಳು ಇನ್ನೂ ಎಷ್ಟೋ ಆಯುಕ್ತವಲ್ಲವೇ.<verse eid="PRO 17:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 17:8"/>ಕೊಡುವವನ ಕಣ್ಣಿಗೆ ಲಂಚವು ಆಕರ್ಷಣೆಯಾಗಿದೆ;</para>
  <para style="q2" vid="PRO 17:8">ಪ್ರತಿ ತಿರುವಿನಲ್ಲಿಯೂ ಯಶಸ್ಸು ಬರುತ್ತದೆ ಎಂದು ಅವರು ಭಾವಿಸುತ್ತಾರೆ.<verse eid="PRO 17:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 17:9"/>ದೋಷವನ್ನು ಕ್ಷಮಿಸುವವನು ಪ್ರೀತಿಯನ್ನು ಹುಡುಕುತ್ತಾನೆ;</para>
  <para style="q2" vid="PRO 17:9">ಆದರೆ ದೋಷವನ್ನು ಎತ್ತಿ ಆಡುವವನು ಸ್ನೇಹಿತರಿಂದ ಪ್ರತ್ಯೇಕಗೊಳ್ಳುತ್ತಾನೆ.<verse eid="PRO 17:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 17:10"/>ಬುದ್ಧಿಹೀನನ ಬೆನ್ನಿಗೆ ನೂರು ಪೆಟ್ಟುಗಳಿಗಿಂತ</para>
  <para style="q2" vid="PRO 17:10">ಜ್ಞಾನಿಗೆ ಒಂದು ಗದರಿಕೆಯ ಮಾತು ಹೆಚ್ಚಾಗಿ ನಾಟುತ್ತದೆ.<verse eid="PRO 17:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 17:11"/>ತಿರುಗಿ ಬೀಳುವವನು ಕೆಟ್ಟದ್ದಕ್ಕೇ ತವಕಪಡುತ್ತಾನೆ;</para>
  <para style="q2" vid="PRO 17:11">ಆದಕಾರಣ ಮರಣ ದೂತರನ್ನು ಅವನ ವಿರುದ್ಧ ಕಳುಹಿಸಲಾಗುವದು.<verse eid="PRO 17:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 17:12"/>ತನ್ನ ಮೂಢತೆಯಲ್ಲಿರುವ ಬುದ್ಧಿಹೀನನನ್ನು ಸಂಧಿಸುವುದಕ್ಕಿಂತ</para>
  <para style="q2" vid="PRO 17:12">ಮರಿಗಳನ್ನು ಕಳೆದುಕೊಂಡ ಕರಡಿಯನ್ನು ಸಂಧಿಸುವುದು ಮೇಲು.<verse eid="PRO 17:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 17:13"/>ಉಪಕಾರಕ್ಕೆ ಅಪಕಾರವನ್ನು ಮಾಡುವವನ</para>
  <para style="q2" vid="PRO 17:13">ಮನೆಯಿಂದ ಕೇಡು ತೊಲಗುವುದೇ ಇಲ್ಲ.<verse eid="PRO 17:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 17:14"/>ಕಲಹದ ಪ್ರಾರಂಭವು ಆಣೆಕಟ್ಟು ಒಡೆದಂತೆ ಇರುವುದು;</para>
  <para style="q2" vid="PRO 17:14">ಆದಕಾರಣ ಆ ಕಲಹಕ್ಕೆ ಕೈಹಾಕುವುದಕ್ಕಿಂತ ಮುಂಚೆ ಅದನ್ನು ಬಿಟ್ಟುಬಿಡು.<verse eid="PRO 17:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 17:15"/>ದುಷ್ಟರನ್ನು ನೀತಿವಂತರೆಂದು ನಿರ್ಣಯಿಸುವವನು,</para>
  <para style="q2" vid="PRO 17:15">ನೀತಿವಂತರನ್ನು ಖಂಡಿಸುವವನೂ ಇವರಿಬ್ಬರೂ ಯೆಹೋವ ದೇವರಿಗೆ ಅಸಹ್ಯ.<verse eid="PRO 17:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 17:16"/>ಜ್ಞಾನವನ್ನು ಸಂಪಾದಿಸುವುದಕ್ಕೆ ಬುದ್ಧಿಹೀನನ ಕೈಯಲ್ಲಿ ಹಣ ಏಕೆ?</para>
  <para style="q2" vid="PRO 17:16">ಅವನಿಗೆ ಕಲಿಯಲು ಮನಸ್ಸಿಲ್ಲವಲ್ಲ.<verse eid="PRO 17:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 17:17"/>ಸ್ನೇಹಿತನು ಎಲ್ಲಾ ಸಮಯದಲ್ಲಿ ಪ್ರೀತಿಸುತ್ತಾನೆ;</para>
  <para style="q2" vid="PRO 17:17">ಆಪತ್ತಿನಲ್ಲಿ ಸಹಾಯಮಾಡುವಗೋಸ್ಕರ ಸಹೋದರನು ಹುಟ್ಟಿದ್ದಾನೆ.<verse eid="PRO 17:17"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 17:18"/>ಬುದ್ಧಿಹೀನನು ಕೈ ಕುಲುಕಿ</para>
  <para style="q2" vid="PRO 17:18">ತನ್ನ ನೆರೆಯವನಿಗೆ ಜಾಮಿನನಾಗುತ್ತಾನೆ.<verse eid="PRO 17:18"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 17:19"/>ಕಲಹವನ್ನು ಪ್ರೀತಿಮಾಡುವವನು ಪಾಪವನ್ನು ಪ್ರೀತಿಮಾಡುತ್ತಾನೆ;</para>
  <para style="q2" vid="PRO 17:19">ತನ್ನ ಗೋಡೆಯನ್ನು ಹೆಚ್ಚಿಸಿಕೊಳ್ಳುವವನು ನಾಶನವನ್ನು ಆಮಂತ್ರಿಸುತ್ತಾನೆ.<verse eid="PRO 17:19"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 17:20"/>ವಕ್ರಹೃದಯವುಳ್ಳವನು ಸಮೃದ್ಧಿಯನ್ನು ಹೊಂದುವುದಿಲ್ಲ;</para>
  <para style="q2" vid="PRO 17:20">ಮೋಸದ ನಾಲಿಗೆಯುಳ್ಳವನು ಹಾನಿಗೆ ಬೀಳುವನು.<verse eid="PRO 17:20"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 17:21"/>ಬುದ್ಧಿಹೀನ ಹೆತ್ತವನಿಗೆ ವ್ಯಥೆ;</para>
  <para style="q2" vid="PRO 17:21">ಬುದ್ಧಿಹೀನನ ತಂದೆಗೆ ಸಂತೋಷವಿರುವುದಿಲ್ಲ.<verse eid="PRO 17:21"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 17:22"/>ಹರ್ಷಹೃದಯವು ಒಳ್ಳೆಯ ಔಷಧ;</para>
  <para style="q2" vid="PRO 17:22">ಆದರೆ ಕುಗ್ಗಿದ ಮನಸ್ಸು ಎಲುಬುಗಳನ್ನು ಒಣಗಿಸುತ್ತದೆ.<verse eid="PRO 17:22"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 17:23"/>ನ್ಯಾಯದ ಮಾರ್ಗಗಳನ್ನು ತಿರುಗಿಸಿಬಿಡುವುದಕ್ಕೆ</para>
  <para style="q2" vid="PRO 17:23">ದುಷ್ಟನು ಗುಪ್ತವಾಗಿ ಲಂಚವನ್ನು ತೆಗೆದುಕೊಳ್ಳುತ್ತಾನೆ.<verse eid="PRO 17:23"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 17:24"/>ವಿವೇಕಿಯು ಜ್ಞಾನವನ್ನು ತನ್ನ ಮುಂದೆ ಇಟ್ಟುಕೊಳ್ಳುತ್ತಾನೆ.</para>
  <para style="q2" vid="PRO 17:24">ಆದರೆ ಬುದ್ಧಿಹೀನ ಕಣ್ಣುಗಳು ಭೂಮಿಯ ಅಂತ್ಯಗಳಲ್ಲಿ ಅಲೆಯುವವು.<verse eid="PRO 17:24"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 17:25"/>ಬುದ್ಧಿಹೀನನಾದ ಮಗನು ತನ್ನ ತಂದೆಗೆ ದುಃಖವೂ,</para>
  <para style="q2" vid="PRO 17:25">ತನ್ನನ್ನು ಹೆತ್ತವಳಿಗೆ ಕಹಿಯೂ ಆಗಿದ್ದಾನೆ.<verse eid="PRO 17:25"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 17:26"/>ನೀತಿವಂತನಿಗೆ ದಂಡ ವಿಧಿಸುವುದು ಒಳ್ಳೆಯದಲ್ಲದಿದ್ದರೆ,</para>
  <para style="q2" vid="PRO 17:26">ಖಂಡಿತವಾಗಿಯೂ ಪ್ರಾಮಾಣಿಕ ಅಧಿಕಾರಿಗಳನ್ನು ಹೊಡೆಯುವುದು ಸರಿಯಲ್ಲ.<verse eid="PRO 17:26"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 17:27"/>ಪರಿಜ್ಞಾನ ಹೊಂದಿರುವವನು ಮಿತವಾಗಿ ಮಾತನಾಡುತ್ತಾನೆ;</para>
  <para style="q2" vid="PRO 17:27">ತಿಳುವಳಿಕೆಯನ್ನು ಹೊಂದಿರುವವನು ಶ್ರೇಷ್ಠವಾದ ಆತ್ಮವುಳ್ಳವನಾಗಿದ್ದಾನೆ.<verse eid="PRO 17:27"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 17:28"/>ಬುದ್ಧಿಹೀನನು ಮೌನವಾಗಿದ್ದರೆ ಜ್ಞಾನಿಯೆನಿಸಿಕೊಳ್ಳುವನು;</para>
  <para style="q2" vid="PRO 17:28">ತನ್ನ ತುಟಿಗಳನ್ನು ಬಿಗಿ ಹಿಡಿಯುವವನು ವಿವೇಕಿ ಎನಿಸಿಕೊಳ್ಳುವನು.<verse eid="PRO 17:28"/></para>
  <para style="b"/>
  <chapter eid="PRO 17"/>
  <chapter number="18" style="c" sid="PRO 18"/>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 18:1"/>ಜನರಲ್ಲಿ ಸೇರದವನು ಸ್ವೇಚ್ಛಾನುಸಾರ ನಡೆಯುತ್ತಾ</para>
  <para style="q2" vid="PRO 18:1">ಸಮಸ್ತ ಸುಜ್ಞಾನಕ್ಕೂ ರೇಗುವನು.<verse eid="PRO 18:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 18:2"/>ವಿವೇಕದಲ್ಲಿ ಬುದ್ಧಿಹೀನನಿಗೆ ಸಂತೋಷವಿಲ್ಲ;</para>
  <para style="q2" vid="PRO 18:2">ಆದರೆ ತನ್ನ ಹೃದಯವನ್ನು ಹೊರಪಡಿಸಿಕೊಳ್ಳುವುದೇ ಅವನಿಗೆ ಸಂತೋಷ.<verse eid="PRO 18:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 18:3"/>ದುಷ್ಟತ್ವವು ಬಂದಾಗ ತಾತ್ಸಾರವೂ,</para>
  <para style="q2" vid="PRO 18:3">ಅವಮಾನದೊಂದಿಗೆ ನಿಂದೆಯೂ ಬರುತ್ತವೆ.<verse eid="PRO 18:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 18:4"/>ಮನುಷ್ಯನ ಬಾಯಿಯ ಮಾತುಗಳು ಆಳವಾದ ನೀರಿನಂತೆಯೂ,</para>
  <para style="q2" vid="PRO 18:4">ಜ್ಞಾನದ ಬುಗ್ಗೆಯು ಹರಿಯುವ ತೊರೆಯಂತೆಯೂ ಇವೆ.<verse eid="PRO 18:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 18:5"/>ನ್ಯಾಯತೀರ್ಪಿನಲ್ಲಿ ನೀತಿವಂತರನ್ನು ಕೆಡವುವಂತೆ,</para>
  <para style="q2" vid="PRO 18:5">ದುಷ್ಟರಿಗೆ ಪಕ್ಷಪಾತ ತೋರಿಸುವುದು ಯುಕ್ತವಲ್ಲ.<verse eid="PRO 18:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 18:6"/>ಜ್ಞಾನಹೀನನ ತುಟಿಗಳು ಕಲಹದಲ್ಲಿ ಸೇರುವುದರಿಂದ</para>
  <para style="q2" vid="PRO 18:6">ಏಟುಗಳನ್ನು ತಿನ್ನುವುದಕ್ಕೆ ಅವನ ಬಾಯಿಯು ಕೂಗಿಕೊಳ್ಳುತ್ತದೆ.<verse eid="PRO 18:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 18:7"/>ಬುದ್ಧಿಹೀನನ ಬಾಯಿಯು ಅವನ ನಾಶನ;</para>
  <para style="q2" vid="PRO 18:7">ಅವನ ತುಟಿಗಳು ಅವನ ಪ್ರಾಣಕ್ಕೆ ಪಾಶ.<verse eid="PRO 18:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 18:8"/>ಚಾಡಿಕೋರನ ಮಾತುಗಳು ರುಚಿಕರವಾದ ತುತ್ತುಗಳು;</para>
  <para style="q2" vid="PRO 18:8">ಅವು ಹೊಟ್ಟೆಯ ಒಳಭಾಗಗಳಿಗೆ ಇಳಿದು ಹೋಗುವುವು.<verse eid="PRO 18:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 18:9"/>ತನ್ನ ಕೆಲಸದಲ್ಲಿ ಸೋಮಾರಿಯಾಗಿರುವವನು,</para>
  <para style="q2" vid="PRO 18:9">ಕೆಡುಕನಿಗೆ ಸಹೋದರನಾಗಿದ್ದಾನೆ.<verse eid="PRO 18:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 18:10"/>ಯೆಹೋವ ದೇವರ ನಾಮವು ಬಲವಾದ ಬುರುಜು;</para>
  <para style="q2" vid="PRO 18:10">ನೀತಿವಂತನು ಅದರೊಳಕ್ಕೆ ಓಡಿ ಭದ್ರವಾಗಿರುತ್ತಾನೆ.<verse eid="PRO 18:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 18:11"/>ಧನವಂತರ ಸಂಪತ್ತು ಅವರಿಗೆ ಬಲವಾದ ಪಟ್ಟಣವೂ</para>
  <para style="q2" vid="PRO 18:11">ಅವನ ಕಲ್ಪನೆಯಲ್ಲಿ ಅದು ಸುರಕ್ಷತೆಯ ಎತ್ತರವಾದ ಗೋಡೆಯೂ ಆಗಿದೆ.<verse eid="PRO 18:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 18:12"/>ನಾಶನಕ್ಕೆ ಮುಂಚೆ ಮನುಷ್ಯನ ಹೃದಯವು ಗರ್ವಿಷ್ಠವಾಗಿರುವುದು;</para>
  <para style="q2" vid="PRO 18:12">ಸನ್ಮಾನಕ್ಕೆ ಮುಂಚೆ ದೀನತ್ವವು ಬರುತ್ತದೆ.<verse eid="PRO 18:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 18:13"/>ಕೇಳಿಸಿಕೊಳ್ಳದೆ ಉತ್ತರ ಕೊಡುವವರಿಗೆ</para>
  <para style="q2" vid="PRO 18:13">ಅದು ಮೂರ್ಖತನವೂ, ಅವಮಾನವೂ ಆಗಿದೆ.<verse eid="PRO 18:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 18:14"/>ಮನುಷ್ಯನ ಆತ್ಮವು ಅಸ್ವಸ್ಥತೆಯನ್ನು ಸಹಿಸುವುದು;</para>
  <para style="q2" vid="PRO 18:14">ಆದರೆ ಮುರಿದ ಆತ್ಮವನ್ನು ಸಹಿಸುವವರು ಯಾರು?<verse eid="PRO 18:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 18:15"/>ವಿವೇಕಿಯ ಹೃದಯವು ತಿಳುವಳಿಕೆಯನ್ನು ಸಂಪಾದಿಸುತ್ತದೆ;</para>
  <para style="q2" vid="PRO 18:15">ಜ್ಞಾನಿಯ ಕಿವಿಯು ತಿಳುವಳಿಕೆಯನ್ನು ಹುಡುಕುತ್ತದೆ.<verse eid="PRO 18:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 18:16"/>ಕಾಣಿಕೆಯನ್ನು ಕೊಡುವವನಿಗೆ ಬಾಗಿಲು ತೆರೆಯುತ್ತದೆ;</para>
  <para style="q2" vid="PRO 18:16">ಅದು ದೊಡ್ಡವರ ಸನ್ನಿಧಾನಕ್ಕೂ ಅವನನ್ನು ಕರೆದುಕೊಂಡು ಹೋಗುತ್ತದೆ.<verse eid="PRO 18:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 18:17"/>ಪ್ರತಿವಾದಿ ಬಂದು ಪರಿಶೀಲಿಸುವವರೆಗೆ,</para>
  <para style="q2" vid="PRO 18:17">ಮೊದಲು ವಾದಿಸುವವನು ನ್ಯಾಯವಂತನೆಂದು ತೋರುತ್ತಾನೆ.<verse eid="PRO 18:17"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 18:18"/>ಚೀಟು ಹಾಕುವುದರಿಂದ ವ್ಯಾಜ್ಯಶಮನ;</para>
  <para style="q2" vid="PRO 18:18">ಬಲಿಷ್ಠ ಪ್ರತಿವಾದಿಗಳ ವಿವಾದಗಳನ್ನು ಸಹ ಬಗೆಹರಿಸುತ್ತದೆ.<verse eid="PRO 18:18"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 18:19"/>ಬಲವಾದ ಪಟ್ಟಣವನ್ನು ಗೆಲ್ಲುವುದಕ್ಕಿಂತ ಬೇಸರಗೊಂಡ ಸಹೋದರನನ್ನು ಗೆಲ್ಲುವುದು ಕಷ್ಟಕರ;</para>
  <para style="q2" vid="PRO 18:19">ಅವರ ಕಲಹಗಳು ಕೋಟೆಯ ಬಾಗಿಲಿಗೆ ಅಗುಳಿಗಳಂತೆ ಇವೆ.<verse eid="PRO 18:19"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 18:20"/>ತನ್ನ ಬಾಯಿಯ ಫಲದಿಂದ ಮನುಷ್ಯನ ಹೊಟ್ಟೆಯು ತೃಪ್ತಿ ಹೊಂದುವುದು;</para>
  <para style="q2" vid="PRO 18:20">ತನ್ನ ತುಟಿಗಳ ಆದಾಯದಿಂದ ಅವನು ತೃಪ್ತಿಹೊಂದುವನು.<verse eid="PRO 18:20"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 18:21"/>ನಾಲಿಗೆಗೆ ಮರಣ ಮತ್ತು ಜೀವದ ಶಕ್ತಿಯಿದೆ;</para>
  <para style="q2" vid="PRO 18:21">ಅದನ್ನು ಪ್ರೀತಿಸುವವರು ಅದರ ಫಲವನ್ನು ತಿನ್ನುವರು.<verse eid="PRO 18:21"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 18:22"/>ಪತ್ನಿಯನ್ನು ದೊರಕಿಸಿಕೊಂಡವನು ಒಳ್ಳೆಯದನ್ನು ಸಂಪಾದಿಸಿದವನಾಗಿ,</para>
  <para style="q2" vid="PRO 18:22">ಯೆಹೋವ ದೇವರ ದಯೆಯನ್ನು ಹೊಂದುತ್ತಾನೆ.<verse eid="PRO 18:22"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 18:23"/>ಬಡವನು ಕರುಣೆಗಾಗಿ ವಿಜ್ಞಾಪನೆ ಮಾಡುತ್ತಾನೆ;</para>
  <para style="q2" vid="PRO 18:23">ಆದರೆ ಧನಿಕನು ಕಠಿಣವಾಗಿ ಉತ್ತರ ಕೊಡುತ್ತಾರೆ.<verse eid="PRO 18:23"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 18:24"/>ವಿಶ್ವಾಸಕ್ಕೆ ಅರ್ಹರಲ್ಲದ ಸ್ನೇಹಿತರನ್ನು ಹೊಂದಿರುವವನು ಶೀಘ್ರವೇ ನಾಶವಾಗುತ್ತಾನೆ;</para>
  <para style="q2" vid="PRO 18:24">ಸಹೋದರನಿಗಿಂತ ಹತ್ತಿರ ಹೊಂದಿಕೊಳ್ಳುವ ಸ್ನೇಹಿತನಿದ್ದಾನೆ.<verse eid="PRO 18:24"/></para>
  <para style="b"/>
  <chapter eid="PRO 18"/>
  <chapter number="19" style="c" sid="PRO 19"/>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 19:1"/>ಬುದ್ಧಿಹೀನನ ವಕ್ರ ತುಟಿಗಳಿಗಿಂತ,</para>
  <para style="q2" vid="PRO 19:1">ನಿರ್ದೋಷವಾಗಿ ನಡೆಯುವ ಬಡವನು ಉತ್ತಮ.<verse eid="PRO 19:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 19:2"/>ಪರಿಜ್ಞಾನವಿಲ್ಲದ ಆಸಕ್ತಿಯು ಯುಕ್ತವಲ್ಲ;</para>
  <para style="q2" vid="PRO 19:2">ತನ್ನ ಹೆಜ್ಜೆಗಳಲ್ಲಿ ದುಡುಕುವವನು ದಾರಿ ತಪ್ಪುವನು.<verse eid="PRO 19:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 19:3"/>ಮನುಷ್ಯನ ಬುದ್ಧಿಹೀನತೆ ಅವನ ದುರ್ಗತಿಗೆ ದಾರಿಯಾಗಿದೆ,</para>
  <para style="q2" vid="PRO 19:3">ಆದರೂ ಅವನ ಹೃದಯವು ಯೆಹೋವ ದೇವರಿಗೆ ವಿರೋಧವಾಗಿ ಉರಿಗೊಳ್ಳುತ್ತದೆ.<verse eid="PRO 19:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 19:4"/>ಸಂಪತ್ತು ಅನೇಕ ಮಂದಿ ಸ್ನೇಹಿತರನ್ನು ಮಾಡಿಕೊಳ್ಳುತ್ತದೆ;</para>
  <para style="q2" vid="PRO 19:4">ಆದರೆ ಬಡವನು ತನ್ನ ಆಪ್ತಸ್ನೇಹಿತನಿಂದ ದೂರವಾಗುತ್ತಾನೆ.<verse eid="PRO 19:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 19:5"/>ಸುಳ್ಳುಸಾಕ್ಷಿಯು ದಂಡನೆಯನ್ನು ಹೊಂದದಿರನು;</para>
  <para style="q2" vid="PRO 19:5">ಸುಳ್ಳಾಡುವವನು ತಪ್ಪಿಸಿಕೊಳ್ಳದೆ ಇರಲಾರನು.<verse eid="PRO 19:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 19:6"/>ಅನೇಕರು ಅಧಿಪತಿಯಿಂದ ಸಹಾಯ ಪಡೆಯುತ್ತಾರೆ.</para>
  <para style="q2" vid="PRO 19:6">ಕಾಣಿಕೆಗಳನ್ನು ಕೊಡುವವನಿಗೆ ಪ್ರತಿಯೊಬ್ಬನೂ ಸ್ನೇಹಿತನೇ.<verse eid="PRO 19:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 19:7"/>ಬಡವನ ಬಂಧುಗಳೆಲ್ಲರು ಅವನನ್ನು ಹಗೆ ಮಾಡುತ್ತಾರೆ;</para>
  <para style="q2" vid="PRO 19:7">ತನ್ನ ಸ್ನೇಹಿತರು ತನ್ನಿಂದ ಎಷ್ಟೋ ಹೆಚ್ಚಾಗಿ ದೂರ ಹೋಗುತ್ತಾರಲ್ಲವೇ?</para>
  <para style="q1" vid="PRO 19:7">ಮಾತುಗಳಿಂದ ಅವನು ಮೊರೆಯಿಟ್ಟು ಹಿಂಬಾಲಿಸಿದರೂ</para>
  <para style="q2" vid="PRO 19:7">ಅವನಿಗೆ ಏನೂ ದೊರಕದು.<verse eid="PRO 19:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 19:8"/>ಜ್ಞಾನವನ್ನು ಸಂಪಾದಿಸಿಕೊಳ್ಳುವವನು ತನ್ನ ಪ್ರಾಣವನ್ನೇ ಪ್ರೀತಿಸುತ್ತಾನೆ;</para>
  <para style="q2" vid="PRO 19:8">ತಿಳುವಳಿಕೆಯನ್ನು ಪ್ರೀತಿಸುವವನು ಶೀಘ್ರದಲ್ಲೇ ಏಳಿಗೆ ಹೊಂದುತ್ತಾನೆ.<verse eid="PRO 19:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 19:9"/>ಸುಳ್ಳುಸಾಕ್ಷಿಯು ಶಿಕ್ಷೆಹೊಂದದೇ ಇರುವುದಿಲ್ಲ;</para>
  <para style="q2" vid="PRO 19:9">ಸುಳ್ಳಾಡುವವನು ಹಾಳಾಗಿ ಹೋಗುವನು.<verse eid="PRO 19:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 19:10"/>ಬುದ್ಧಿಹೀನನಿಗೆ ಭೋಗಜೀವನವು ಯುಕ್ತವಲ್ಲ;</para>
  <para style="q2" vid="PRO 19:10">ಅಧಿಪತಿಗಳ ಮೇಲೆ ದೊರೆತನ ಮಾಡುವುದು ಸೇವಕನಿಗೆ ಯುಕ್ತವೇ ಅಲ್ಲ.<verse eid="PRO 19:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 19:11"/>ಮನುಷ್ಯನ ಜ್ಞಾನವು ತಾಳ್ಮೆಯನ್ನು ನೀಡುತ್ತದೆ;</para>
  <para style="q2" vid="PRO 19:11">ಅಪರಾಧವನ್ನು ಲಕ್ಷಿಸದೆ ಇರುವುದು ಅವನಿಗೆ ಮಹಿಮೆಯಾಗಿದೆ.<verse eid="PRO 19:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 19:12"/>ಅರಸನ ಕೋಪವು ಸಿಂಹದ ಘರ್ಜನೆಯಂತಿದೆ;</para>
  <para style="q2" vid="PRO 19:12">ಆದರೆ ಅವನ ದಯೆಯು ಹುಲ್ಲಿನ ಮೇಲಿರುವ ಇಬ್ಬನಿಯಂತಿದೆ.<verse eid="PRO 19:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 19:13"/>ಬುದ್ಧಿಹೀನನಾದ ಮಗನು ತನ್ನ ತಂದೆಗೆ ಹಾನಿಕರನು;</para>
  <para style="q2" vid="PRO 19:13">ಜಗಳವಾಡುವ ಹೆಂಡತಿ</para>
  <para style="q2" vid="PRO 19:13">ಯಾವಾಗಲೂ ತೊಟ್ಟಿಕ್ಕುವ ಹನಿ.<verse eid="PRO 19:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 19:14"/>ಮನೆಯೂ ಸಂಪತ್ತೂ ಪಿತೃಗಳ ಸ್ವಾಸ್ತ್ಯವು;</para>
  <para style="q2" vid="PRO 19:14">ವಿವೇಕಿಯಾದ ಹೆಂಡತಿಯು ಯೆಹೋವ ದೇವರಿಂದಲೇ.<verse eid="PRO 19:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 19:15"/>ಮೈಗಳ್ಳತನವು ಗಾಢನಿದ್ರೆಯಲ್ಲಿ ಮುಳುಗಿಸುತ್ತದೆ;</para>
  <para style="q2" vid="PRO 19:15">ಸೋಮಾರಿಯು ಹಸಿವೆಗೊಳ್ಳುವನು.<verse eid="PRO 19:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 19:16"/>ಯಾರು ಆಜ್ಞೆಗಳನ್ನು ಪಾಲಿಸುತ್ತಾನೋ ಅವನು ತನ್ನ ಜೀವವನ್ನು ಉಳಿಸಿಕೊಳ್ಳುತ್ತಾನೆ,</para>
  <para style="q2" vid="PRO 19:16">ಆದರೆ ಅವುಗಳನ್ನು ಅಸಡ್ಡೆ ಮಾಡುವವನು ಸಾಯುವನು.<verse eid="PRO 19:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 19:17"/>ಬಡವರಿಗೆ ದಯೆ ತೋರಿಸುವವನು ಯೆಹೋವ ದೇವರಿಗೆ ಸಾಲ ಕೊಡುತ್ತಾನೆ;</para>
  <para style="q2" vid="PRO 19:17">ಆತನು ಅವನ ಉಪಕಾರಕ್ಕಾಗಿ ಪ್ರತ್ಯುಪಕಾರ ಮಾಡುವನು.<verse eid="PRO 19:17"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 19:18"/>ಇನ್ನೂ ನಿರೀಕ್ಷೆ ಇರುವಾಗಲೇ ನಿನ್ನ ಮಗನನ್ನು ಶಿಕ್ಷಿಸು;</para>
  <para style="q2" vid="PRO 19:18">ಅವನ ಮರಣಕ್ಕೆ ನೀನು ಕಾರಣನಾಗಬೇಡ.<verse eid="PRO 19:18"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 19:19"/>ಕೋಪಿಷ್ಟನು ಶಿಕ್ಷೆಯನ್ನು ಅನುಭವಿಸುವನು;</para>
  <para style="q2" vid="PRO 19:19">ಅವನನ್ನು ನೀನು ಬಿಡಿಸಿದರೆ, ತಿರುಗಿ ನೀನು ಬಿಡಿಸಬೇಕಾಗುವುದು.<verse eid="PRO 19:19"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 19:20"/>ಬುದ್ಧಿವಾದವನ್ನು ಕೇಳಿ, ಶಿಕ್ಷಣವನ್ನು ಅಂಗೀಕರಿಸು;</para>
  <para style="q2" vid="PRO 19:20">ಕಡೆಯಲ್ಲಿ ನೀನು ಜ್ಞಾನಿಯಾಗುವೆ.<verse eid="PRO 19:20"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 19:21"/>ಮನುಷ್ಯನ ಹೃದಯದಲ್ಲಿ ಅನೇಕ ಯೋಜನೆಗಳಿವೆ;</para>
  <para style="q2" vid="PRO 19:21">ಆದರೂ ಯೆಹೋವ ದೇವರ ಸಂಕಲ್ಪವೇ ಈಡೇರುವುದು.<verse eid="PRO 19:21"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 19:22"/>ನಿಷ್ಠೆಯು ಮನುಷ್ಯನನ್ನು ಆಕರ್ಷಕನನ್ನಾಗಿ ಮಾಡುತ್ತದೆ.</para>
  <para style="q2" vid="PRO 19:22">ಬಡವನು ಸುಳ್ಳುಗಾರನಿಗಿಂತ ಲೇಸು.<verse eid="PRO 19:22"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 19:23"/>ಯೆಹೋವ ದೇವರ ಭಯವು ಜೀವದಾಯಕವು;</para>
  <para style="q2" vid="PRO 19:23">ಆಗ ಅವನು ತೃಪ್ತನಾಗಿ ನೆಲೆಗೊಳ್ಳುವನು; ಅವನಿಗೆ ಕೇಡು ಸಂಭವಿಸುವುದಿಲ್ಲ.<verse eid="PRO 19:23"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 19:24"/>ಮೈಗಳ್ಳನು ಪಾತ್ರೆಯೊಳಗೆ ತನ್ನ ಕೈಯನ್ನು ಮುಳುಗಿಸಿ,</para>
  <para style="q2" vid="PRO 19:24">ಅವನು ಅದನ್ನು ಮತ್ತೆ ತನ್ನ ಬಾಯಿಗೆ ತರುವುದಿಲ್ಲ!<verse eid="PRO 19:24"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 19:25"/>ಪರಿಹಾಸ್ಯಗಾರನನ್ನು ಹೊಡೆದರೆ, ಮುಗ್ಧರು ಎಚ್ಚರಗೊಳ್ಳುವರು;</para>
  <para style="q2" vid="PRO 19:25">ವಿವೇಕಿಯನ್ನು ಗದರಿಸಿದರೆ, ಅವನು ಪರಿಜ್ಞಾನವನ್ನು ಗ್ರಹಿಸುವನು.<verse eid="PRO 19:25"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 19:26"/>ಯಾರು ತಂದೆಯನ್ನು ದೋಚಿಕೊಂಡು ತಾಯಿಯನ್ನು ಓಡಿಸುವರೋ</para>
  <para style="q2" vid="PRO 19:26">ನಾಚಿಕೆಯನ್ನುಂಟುಮಾಡಿ, ನಿಂದೆಯನ್ನು ತರುತ್ತಾರೆ.<verse eid="PRO 19:26"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 19:27"/>ಮಗನೇ, ನೀನು ಬುದ್ಧಿವಾದಕ್ಕೆ ಲಕ್ಷ್ಯಕೊಡದಿದ್ದರೆ,</para>
  <para style="q2" vid="PRO 19:27">ಪರಿಜ್ಞಾನದ ಮಾತುಗಳಿಂದ ದಾರಿತಪ್ಪುವೆ.<verse eid="PRO 19:27"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 19:28"/>ಭ್ರಷ್ಟನ ಸಾಕ್ಷಿಯು ನ್ಯಾಯತೀರ್ಪನ್ನು ಗೇಲಿ ಮಾಡುತ್ತದೆ;</para>
  <para style="q2" vid="PRO 19:28">ದುಷ್ಟನ ಬಾಯಿಯು ದ್ರೋಹವನ್ನು ನುಂಗುವುದು.<verse eid="PRO 19:28"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 19:29"/>ಪರಿಹಾಸ್ಯಗಾರರಿಗೆ ನ್ಯಾಯ ತೀರ್ಪುಗಳೂ,</para>
  <para style="q2" vid="PRO 19:29">ಬುದ್ಧಿಹೀನರ ಬೆನ್ನಿಗೆ ಪೆಟ್ಟುಗಳೂ ಸಿದ್ಧವಾಗಿವೆ.<verse eid="PRO 19:29"/></para>
  <para style="b"/>
  <chapter eid="PRO 19"/>
  <chapter number="20" style="c" sid="PRO 20"/>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 20:1"/>ದ್ರಾಕ್ಷಾರಸವು ಪರಿಹಾಸ್ಯಕರವಾಗಿದೆ; ಮಾದಕ ಮದ್ಯವು ಉದ್ರೇಕಿಸುತ್ತದೆ;</para>
  <para style="q2" vid="PRO 20:1">ಇವುಗಳಿಂದ ಮೋಸ ಹೋದವನು ಜ್ಞಾನಿಯಲ್ಲ.<verse eid="PRO 20:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 20:2"/>ಅರಸನ ಭಯವು ಸಿಂಹದ ಘರ್ಜನೆಯಂತಿದೆ;</para>
  <para style="q2" vid="PRO 20:2">ಅವನ ಕೋಪವನ್ನೆಬ್ಬಿಸುವವರು, ತಮ್ಮ ಪ್ರಾಣಕ್ಕೆ ಅಪಾಯ ತಂದುಕೊಳ್ಳುವರು.<verse eid="PRO 20:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 20:3"/>ಕಲಹವನ್ನು ತಡೆಯುವವನು, ಮಾನಕ್ಕೆ ಯೋಗ್ಯನು;</para>
  <para style="q2" vid="PRO 20:3">ಆದರೆ ಬುದ್ಧಿಹೀನನು ಮಾತ್ರ ಜಗಳವಾಡಲು ಒತ್ತಾಯಿಸುತ್ತಾನೆ.<verse eid="PRO 20:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 20:4"/>ಮೈಗಳ್ಳನು ಮಳೆಗಾಲದಲ್ಲಿ ಉಳುಮೆ ಮಾಡುವುದಿಲ್ಲ;</para>
  <para style="q2" vid="PRO 20:4">ಆದಕಾರಣ ಸುಗ್ಗಿಯಲ್ಲಿ ಅವನು ಅಪೇಕ್ಷಿಸಿದರೂ ಏನೂ ಸಿಕ್ಕುವುದಿಲ್ಲ.<verse eid="PRO 20:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 20:5"/>ಮನುಷ್ಯನ ಹೃದಯದ ಆಲೋಚನೆಯು ಆಳವಾದ ಬಾವಿಯ ನೀರಿನಂತಿದೆ;</para>
  <para style="q2" vid="PRO 20:5">ವಿವೇಕಿಯು ಅದನ್ನು ಸೇದುವನು.<verse eid="PRO 20:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 20:6"/>ಅನೇಕರಲ್ಲಿ ಪ್ರತಿಯೊಬ್ಬನು ತನ್ನ ಸ್ವಂತ ಪ್ರಾಮಾಣಿಕತೆಯನ್ನು ಸಾರುವನು;</para>
  <para style="q2" vid="PRO 20:6">ಆದರೆ ನಂಬಿಗಸ್ತನಾದ ಮನುಷ್ಯನನ್ನು ಯಾರು ಕಂಡುಕೊಳ್ಳಬಲ್ಲರು?<verse eid="PRO 20:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 20:7"/>ನೀತಿವಂತನು ನಿರ್ದೋಷವಾಗಿ ಜೀವಿಸುತ್ತಾನೆ;</para>
  <para style="q2" vid="PRO 20:7">ಅವನನ್ನು ಅನುಸರಿಸುವ ಅವನ ಮಕ್ಕಳು ಆಶೀರ್ವಾದ ಹೊಂದುವರು.<verse eid="PRO 20:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 20:8"/>ಅರಸನು ತನ್ನ ನ್ಯಾಯತೀರ್ಪಿನ ಸಿಂಹಾಸನದ ಮೇಲೆ ಕೂತಿರುವಾಗ,</para>
  <para style="q2" vid="PRO 20:8">ತನ್ನ ದೃಷ್ಟಿಯಿಂದ ಸಕಲ ಕೆಟ್ಟತನವನ್ನು ತೂರುವನು.<verse eid="PRO 20:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 20:9"/>“ನನ್ನ ಹೃದಯವನ್ನು ಶುದ್ಧವಾಗಿ ಇಟ್ಟುಕೊಂಡಿದ್ದೇನೆ.</para>
  <para style="q2" vid="PRO 20:9">ನಾನು ಶುದ್ಧನೂ ಪಾಪರಹಿತನೂ,” ಎಂದು ಯಾರು ಹೇಳಬಲ್ಲರು?<verse eid="PRO 20:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 20:10"/>ಮೋಸದ ತೂಕಗಳೂ, ಮೋಸದ ಅಳತೆಗಳೂ</para>
  <para style="q2" vid="PRO 20:10">ಇವೆರಡೂ ಯೆಹೋವ ದೇವರಿಗೆ ಅಸಹ್ಯ.<verse eid="PRO 20:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 20:11"/>ಚಿಕ್ಕ ಮಕ್ಕಳಾದರೋ ತಮ್ಮ ಕ್ರಿಯೆಗಳಿಂದಲೇ,</para>
  <para style="q2" vid="PRO 20:11">ತಾವು ಶುದ್ಧರೋ ಯಥಾರ್ಥರೋ ಎಂಬುದನ್ನು ತೋರ್ಪಡಿಸಿಕೊಳ್ಳುತ್ತಾರೆ.<verse eid="PRO 20:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 20:12"/>ಕೇಳುವ ಕಿವಿ, ನೋಡುವ ಕಣ್ಣು ಇವೆರಡನ್ನು</para>
  <para style="q2" vid="PRO 20:12">ಯೆಹೋವ ದೇವರು ಉಂಟುಮಾಡಿದ್ದಾನೆ.<verse eid="PRO 20:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 20:13"/>ನೀವು ನಿದ್ರೆಯನ್ನು ಪ್ರೀತಿಸಿದರೆ, ನೀವು ಬಡತನದಲ್ಲಿ ಕೊನೆಗೊಳ್ಳುತ್ತೀರಿ;</para>
  <para style="q2" vid="PRO 20:13">ನಿಮ್ಮ ಕಣ್ಣುಗಳನ್ನು ತೆರೆದರೆ, ಸಾಕಷ್ಟು ಆಹಾರ ಇರುತ್ತದೆ!<verse eid="PRO 20:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 20:14"/>“ಇದು ಒಳ್ಳೆಯದಲ್ಲ ಇದು ಒಳ್ಳೆಯದಲ್ಲ!” ಎಂದು ಕೊಳ್ಳುವವನು ಹೇಳುತ್ತಾನೆ;</para>
  <para style="q2" vid="PRO 20:14">ಆದರೆ ಅವನು ಕೊಂಡು ಹೋದ ಮೇಲೆ ಅದನ್ನೇ ಹೊಗಳುತ್ತಾನೆ.<verse eid="PRO 20:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 20:15"/>ಬಂಗಾರವೂ ಮಾಣಿಕ್ಯಗಳ ರಾಶಿಯೂ ಇವೆ;</para>
  <para style="q2" vid="PRO 20:15">ಆದರೆ ಪರಿಜ್ಞಾನದ ತುಟಿಗಳು ಅಪರೂಪದ ರತ್ನವಾಗಿವೆ.<verse eid="PRO 20:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 20:16"/>ಅಪರಿಚಿತನಿಗೆ ಭದ್ರತೆಯನ್ನು ನೀಡುವವನ ವಸ್ತ್ರವನ್ನು ತೆಗೆದುಕೋ;</para>
  <para style="q2" vid="PRO 20:16">ವಿದೇಶಿಯರಿಗೆ ಇದನ್ನು ಮಾಡಿದರೆ ಅದನ್ನು ಒತ್ತೆ ಇಟ್ಟುಕೋ.<verse eid="PRO 20:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 20:17"/>ವಂಚನೆಯಿಂದ ಸಿಕ್ಕಿದ ಆಹಾರವು ರುಚಿ;</para>
  <para style="q2" vid="PRO 20:17">ಆದರೆ ಆಮೇಲೆ ಅವನ ಬಾಯಿಯು ಮರಳಿನಿಂದ ತುಂಬುವುದು.<verse eid="PRO 20:17"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 20:18"/>ಸಲಹೆಯಿಂದ ಯೋಜನೆಗಳು ನೆರವೆರುವವು;</para>
  <para style="q2" vid="PRO 20:18">ಜ್ಞಾನಿಯ ಸಲಹೆಯಿಲ್ಲದೆ ಯುದ್ಧಕ್ಕೆ ಹೋಗಬೇಡಿ.<verse eid="PRO 20:18"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 20:19"/>ಚಾಡಿಕೋರನು ಗುಟ್ಟುಗಳನ್ನು ರಟ್ಟುಮಾಡುತ್ತಾನೆ;</para>
  <para style="q2" vid="PRO 20:19">ಆದಕಾರಣ ಹರಟೆ ಹೊಡೆಯುವವನ ಸಹವಾಸ ಮಾಡಬೇಡ.<verse eid="PRO 20:19"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 20:20"/>ತನ್ನ ತಂದೆಯನ್ನಾಗಲಿ, ತನ್ನ ತಾಯಿಯನ್ನಾಗಲಿ ಶಪಿಸುವವನ</para>
  <para style="q2" vid="PRO 20:20">ದೀಪವು ಮಧ್ಯರಾತ್ರಿಯ ಕತ್ತಲೆಯಲ್ಲಿ ಆರಿಹೋಗುವುದು.<verse eid="PRO 20:20"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 20:21"/>ಪ್ರಾರಂಭದಲ್ಲಿ ತ್ವರೆಯಾಗಿ ಪಡೆದುಕೊಂಡ ಆಸ್ತಿಯೂ</para>
  <para style="q2" vid="PRO 20:21">ಅಂತ್ಯದಲ್ಲಿ ಆಶೀರ್ವಾದವಾಗಿರುವುದಿಲ್ಲ.<verse eid="PRO 20:21"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 20:22"/>ನೀನು, “ಕೇಡಿಗೆ ಮುಯ್ಯಿತೀರಿಸುವೆನು,” ಎಂದು ಹೇಳಬೇಡ;</para>
  <para style="q2" vid="PRO 20:22">ಯೆಹೋವ ದೇವರನ್ನು ನಿರೀಕ್ಷಿಸು; ಆಗ ಅವರೇ ನಿಮ್ಮನ್ನು ರಕ್ಷಿಸಿ ಉದ್ಧರಿಸುವನು.<verse eid="PRO 20:22"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 20:23"/>ವ್ಯತ್ಯಾಸದ ತೂಕಗಳು ಯೆಹೋವ ದೇವರಿಗೆ ಅಸಹ್ಯವಾಗಿವೆ;</para>
  <para style="q2" vid="PRO 20:23">ಅಪ್ರಾಮಾಣಿಕ ತಕ್ಕಡಿಗಳು ಅವರನ್ನು ಮೆಚ್ಚಿಸುವುದಿಲ್ಲ.<verse eid="PRO 20:23"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 20:24"/>ಮನುಷ್ಯನ ಹೆಜ್ಜೆಗಳನ್ನು ಯೆಹೋವ ದೇವರು ನಿರ್ದೇಶಿಸುತ್ತಾರೆ.</para>
  <para style="q2" vid="PRO 20:24">ಹಾಗಾದರೆ ಒಬ್ಬ ಮನುಷ್ಯನು ತನ್ನ ಮಾರ್ಗವನ್ನು ಹೇಗೆ ತಿಳಿದುಕೊಳ್ಳಬಲ್ಲನು?<verse eid="PRO 20:24"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 20:25"/>ದುಡುಕಿ ಪ್ರತಿಷ್ಠೆಗಾಗಿ ದೇವರಿಗೆ ಹರಕೆ ಮಾಡಿಕೊಂಡು</para>
  <para style="q2" vid="PRO 20:25">ಆಮೇಲೆ ವಿಚಾರಿಸುವುದು ಉರುಲಾಗಿದೆ.<verse eid="PRO 20:25"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 20:26"/>ಜ್ಞಾನಿಯಾದ ಅರಸನು ದುಷ್ಟರನ್ನು ತೂರುವನು;</para>
  <para style="q2" vid="PRO 20:26">ಅವರ ಮೇಲೆ ಕಣದ ಚಕ್ರವನ್ನು ಎಳೆಯುವನು.<verse eid="PRO 20:26"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 20:27"/>ಮನುಷ್ಯನ ಆತ್ಮವು ಯೆಹೋವ ದೇವರ ದೀಪವಾಗಿದೆ.</para>
  <para style="q2" vid="PRO 20:27">ಅದು ಅವನ ಅಂತರಂಗವನ್ನು ಶೋಧಿಸುತ್ತದೆ.<verse eid="PRO 20:27"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 20:28"/>ಪ್ರೀತಿಯೂ ನಂಬಿಗಸ್ತಿಕೆಯೂ ಅರಸನನ್ನು ಕಾಯುತ್ತವೆ;</para>
  <para style="q2" vid="PRO 20:28">ಪ್ರೀತಿಯಿಂದಲೇ ಅವನ ಸಿಂಹಾಸನವು ಸ್ಥಿರಗೊಳ್ಳುತ್ತದೆ.<verse eid="PRO 20:28"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 20:29"/>ಯೌವನಸ್ಥರ ಮಹಿಮೆ ಅವರ ಬಲವೇ;</para>
  <para style="q2" vid="PRO 20:29">ಮುದುಕರ ವೈಭವ ನರೆತ ತಲೆಯೇ.<verse eid="PRO 20:29"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="30" style="v" sid="PRO 20:30"/>ಗಾಯಗೊಳಿಸುವ ಏಟುಗಳು ದುಷ್ಟತ್ವವನ್ನು ತೊಳೆಯುತ್ತವೆ;</para>
  <para style="q2" vid="PRO 20:30">ಪೆಟ್ಟುಗಳು ಅಂತರಂಗವನ್ನೂ ಶುದ್ಧಿಗೊಳಿಸುತ್ತವೆ.<verse eid="PRO 20:30"/></para>
  <para style="b"/>
  <chapter eid="PRO 20"/>
  <chapter number="21" style="c" sid="PRO 21"/>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 21:1"/>ಅರಸನ ಹೃದಯವು ಯೆಹೋವ ದೇವರ ಕೈಯಲ್ಲಿ ನೀರಿನ ಕಾಲುವೆಗಳಂತೆ;</para>
  <para style="q2" vid="PRO 21:1">ತನಗೆ ಇಷ್ಟವಾದ ಕಡೆಗೆ ಆತನು ಅದನ್ನು ತಿರುಗಿಸುತ್ತಾನೆ.<verse eid="PRO 21:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 21:2"/>ಮನುಷ್ಯನ ಪ್ರತಿಯೊಂದು ಮಾರ್ಗವು ಅವನ ದೃಷ್ಟಿಯಲ್ಲಿ ಸರಿಯಾಗಿದೆ;</para>
  <para style="q2" vid="PRO 21:2">ಆದರೆ ಯೆಹೋವ ದೇವರು ಹೃದಯಗಳನ್ನು ಪರೀಕ್ಷಿಸುತ್ತಾರೆ.<verse eid="PRO 21:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 21:3"/>ಯಜ್ಞಕ್ಕಿಂತ ನೀತಿ ನ್ಯಾಯಗಳನ್ನು ನಡೆಸುವುದು</para>
  <para style="q2" vid="PRO 21:3">ಯೆಹೋವ ದೇವರಿಗೆ ಎಷ್ಟೋ ಮೆಚ್ಚಿಗೆಯಾಗಿದೆ.<verse eid="PRO 21:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 21:4"/>ಹೆಮ್ಮೆಯ ದೃಷ್ಟಿ, ಗರ್ವದ ಹೃದಯ,</para>
  <para style="q2" vid="PRO 21:4">ದುಷ್ಟರ ಉಳುವಿಕೆ ಇವೆಲ್ಲಾ ಪಾಪವೇ.<verse eid="PRO 21:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 21:5"/>ಶ್ರದ್ಧೆಯುಳ್ಳವನ ಯೋಜನೆಗಳಿಂದ ಸಮೃದ್ಧಿ;</para>
  <para style="q2" vid="PRO 21:5">ಆತುರತೆಯು ಬಡತನಕ್ಕೆ ನಡೆಸುತ್ತದೆ.<verse eid="PRO 21:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 21:6"/>ಸುಳ್ಳಿನ ನಾಲಿಗೆಯಿಂದ ಸಂಪಾದಿಸಿದ ಸಂಪತ್ತು</para>
  <para style="q2" vid="PRO 21:6">ಕ್ಷಣಿಕ ಆವಿಯಂತೆಯೂ ಮೃತ್ಯುಪಾಶದಂತೆಯೂ ಆಗಿದೆ.<verse eid="PRO 21:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 21:7"/>ದುಷ್ಟರ ಹಿಂಸೆಯು ಅವರನ್ನು ನಾಶಪಡಿಸುವುದು;</para>
  <para style="q2" vid="PRO 21:7">ಏಕೆಂದರೆ ನ್ಯಾಯವಾದದ್ದನ್ನು ಮಾಡುವುದನ್ನು ಅವರು ನಿರಾಕರಿಸುತ್ತಾರೆ.<verse eid="PRO 21:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 21:8"/>ದೋಷಿಯ ಮಾರ್ಗವು ಡೊಂಕು,</para>
  <para style="q2" vid="PRO 21:8">ಮುಗ್ಧನ ನಡತೆ ಯಥಾರ್ಥ.<verse eid="PRO 21:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 21:9"/>ಮನೆಯಲ್ಲಿ ಜಗಳಗಂಟಿಯೊಂದಿಗೆ ಇರುವುದಕ್ಕಿಂತ,</para>
  <para style="q2" vid="PRO 21:9">ಮಾಳಿಗೆಯ ಒಂದು ಮೂಲೆಯಲ್ಲಿ ವಾಸಿಸುವುದು ಲೇಸು.<verse eid="PRO 21:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 21:10"/>ದುಷ್ಟರು ಕೇಡನ್ನು ಅಪೇಕ್ಷಿಸುತ್ತಾರೆ;</para>
  <para style="q2" vid="PRO 21:10">ಅವನು ತನ್ನ ನೆರೆಯವನಿಗೂ ಯಾವ ದಯೆಯನ್ನೂ ತೋರಿಸನು.<verse eid="PRO 21:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 21:11"/>ಪರಿಹಾಸ್ಯಕಾರರನ್ನು ಶಿಕ್ಷಿಸಿದರೆ, ಮುಗ್ಧರು ಜ್ಞಾನವಂತರಾಗುವರು;</para>
  <para style="q2" vid="PRO 21:11">ಜ್ಞಾನಿಯು ಶಿಕ್ಷಣ ಹೊಂದಿದರೆ, ಅವನು ಪರಿಜ್ಞಾನವನ್ನು ಹೊಂದುತ್ತಾನೆ.<verse eid="PRO 21:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 21:12"/>ನೀತಿವಂತನು ದುಷ್ಟರ ಮನೆಯನ್ನು ಗಮನಿಸುತ್ತಾನೆ;</para>
  <para style="q2" vid="PRO 21:12">ದುಷ್ಟರನ್ನು ಕೇಡಿಗೆ ತಳ್ಳುವನು.<verse eid="PRO 21:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 21:13"/>ಬಡವರ ಕೂಗಿಗೆ ತನ್ನ ಕಿವಿಗಳನ್ನು ಮುಚ್ಚಿಕೊಳ್ಳುವವನು</para>
  <para style="q2" vid="PRO 21:13">ತಾನೇ ಕೂಗಿದಾಗ ಯಾರೂ ಅವನಿಗೆ ಉತ್ತರ ಕೊಡುವುದಿಲ್ಲ.<verse eid="PRO 21:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 21:14"/>ಗುಟ್ಟಾಗಿ ಕೊಡುವ ಬಹುಮಾನವು ಕೋಪವನ್ನು ಅಡಗಿಸುವುದು;</para>
  <para style="q2" vid="PRO 21:14">ಮಡಿಲಲ್ಲಿ ಇಟ್ಟ ಲಂಚವು ಮಹಾ ಕೋಪವನ್ನು ಆರಿಸುವುದು.<verse eid="PRO 21:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 21:15"/>ನ್ಯಾಯತೀರಿಸುವುದು ನೀತಿವಂತರಿಗೆ ಸಂತೋಷ;</para>
  <para style="q2" vid="PRO 21:15">ಆದರೆ ಕೆಟ್ಟದ್ದನ್ನು ಮಾಡುವವರಿಗೆ ಭೀತಿ.<verse eid="PRO 21:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 21:16"/>ವಿವೇಕದ ಹಾದಿಯಿಂದ ತಪ್ಪಿಸಿಕೊಳ್ಳುವವನು</para>
  <para style="q2" vid="PRO 21:16">ಸತ್ತವರ ಸಹವಾಸದಲ್ಲಿ ವಿಶ್ರಾಂತಿ ಪಡೆಯುವನು.<verse eid="PRO 21:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 21:17"/>ಭೋಗಾಸಕ್ತನು ಕೊರತೆಪಡುವನು; ದ್ರಾಕ್ಷಾರಸವನ್ನೂ,</para>
  <para style="q2" vid="PRO 21:17">ತೈಲವನ್ನೂ ಅಪೇಕ್ಷಿಸುವವನು ಎಂದಿಗೂ ಧನವಂತನಾಗನು.<verse eid="PRO 21:17"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 21:18"/>ದುಷ್ಟರು ನೀತಿವಂತರಿಗೂ,</para>
  <para style="q2" vid="PRO 21:18">ದ್ರೋಹಿಗಳು ಸನ್ಮಾರ್ಗಿಗಳಿಗೂ ಈಡಾಗಿದ್ದಾರೆ.<verse eid="PRO 21:18"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 21:19"/>ಕಾಡುವ ಜಗಳಗಂಟಿ ಹೆಂಡತಿಯೊಂದಿಗೆ ವಾಸಮಾಡುವುದಕ್ಕಿಂತ,</para>
  <para style="q2" vid="PRO 21:19">ಮರಭೂಮಿಯಲ್ಲಿ ವಾಸಿಸುವುದು ಲೇಸು.<verse eid="PRO 21:19"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 21:20"/>ಜ್ಞಾನವಂತರ ನಿವಾಸದಲ್ಲಿ ಆಯ್ದ ಐಶ್ವರ್ಯವೂ, ಎಣ್ಣೆಯೂ ಇರುತ್ತವೆ;</para>
  <para style="q2" vid="PRO 21:20">ಆದರೆ ಬುದ್ಧಿಹೀನನು ಇದ್ದದ್ದೆಲ್ಲವನ್ನು ನುಂಗಿಬಿಡುತ್ತಾನೆ.<verse eid="PRO 21:20"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 21:21"/>ನೀತಿಯನ್ನೂ, ಕರುಣೆಯನ್ನೂ ಹಿಂಬಾಲಿಸುವವನು</para>
  <para style="q2" vid="PRO 21:21">ಜೀವವನ್ನೂ, ನೀತಿಯನ್ನೂ, ಕೀರ್ತಿಯನ್ನೂ ಕಂಡುಕೊಳ್ಳುತ್ತಾನೆ.<verse eid="PRO 21:21"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 21:22"/>ಜ್ಞಾನಿಯು ಬಲಿಷ್ಠರ ಪಟ್ಟಣವನ್ನು ಹತ್ತಿ,</para>
  <para style="q2" vid="PRO 21:22">ಅವರು ಭರವಸವಿಟ್ಟ ಬಲವಾದ ಕೋಟೆಯನ್ನು ಕೆಡವಿ ಹಾಕುತ್ತಾನೆ.<verse eid="PRO 21:22"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 21:23"/>ತನ್ನ ಬಾಯಿಯನ್ನೂ, ನಾಲಿಗೆಯನ್ನೂ ಕಾಯುವವನು,</para>
  <para style="q2" vid="PRO 21:23">ಇಕ್ಕಟ್ಟುಗಳಿಂದ ತನ್ನ ಪ್ರಾಣವನ್ನು ಕಾಪಾಡಿಕೊಳ್ಳುತ್ತಾನೆ.<verse eid="PRO 21:23"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 21:24"/>ಸೊಕ್ಕೇರಿ ಗರ್ವದಲ್ಲಿ ವರ್ತಿಸುವವನ</para>
  <para style="q2" vid="PRO 21:24">ಹೆಸರು ಅಹಂಕಾರಿ ಮತ್ತು ಪರಿಹಾಸ್ಯಕ.<verse eid="PRO 21:24"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 21:25"/>ಸೋಮಾರಿಯ ಆಸೆಯು ಅವನನ್ನು ಕೊಲ್ಲುತ್ತದೆ;</para>
  <para style="q2" vid="PRO 21:25">ಅವನ ಕೈಗಳು ದುಡಿಯುವುದಕ್ಕೆ ನಿರಾಕರಿಸುತ್ತವೆ.<verse eid="PRO 21:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 21:26"/>ದಿನವೆಲ್ಲಾ ಅವನು ದುರಾಶೆಯಿಂದ ಆಶಿಸುತ್ತಾನೆ;</para>
  <para style="q2" vid="PRO 21:26">ಆದರೆ ನೀತಿವಂತನು ಹಿಂತೆಗೆಯದೇ ಕೊಡುತ್ತಾನೆ.<verse eid="PRO 21:26"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 21:27"/>ದುಷ್ಟರ ಯಜ್ಞವು ಅಸಹ್ಯ;</para>
  <para style="q2" vid="PRO 21:27">ಅದನ್ನು ದುರ್ಬುದ್ಧಿಯಿಂದ ಅರ್ಪಿಸಿದರೆ, ಇನ್ನೂ ಎಷ್ಟೋ ಅಸಹ್ಯಕರ.<verse eid="PRO 21:27"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 21:28"/>ಸುಳ್ಳುಸಾಕ್ಷಿಯವನು ನಾಶವಾಗುವನು;</para>
  <para style="q2" vid="PRO 21:28">ಆದರೆ ಕೇಳಿದ್ದನ್ನೇ ನುಡಿಯುವವನ ಸಾಕ್ಷಿ ಸದಾ ನಿಲ್ಲುವುದು.<verse eid="PRO 21:28"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 21:29"/>ದುಷ್ಟನು ತನ್ನ ಮುಖವನ್ನು ಕಠಿಣ ಮಾಡಿಕೊಳ್ಳುತ್ತಾನೆ;</para>
  <para style="q2" vid="PRO 21:29">ಯಥಾರ್ಥವಂತನಾದರೋ ತನ್ನ ಮಾರ್ಗಗಳನ್ನು ಯೋಚಿಸುತ್ತಾರೆ.<verse eid="PRO 21:29"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="30" style="v" sid="PRO 21:30"/>ಯೆಹೋವ ದೇವರಿಗೆ ವಿರೋಧವಾಗಿ</para>
  <para style="q2" vid="PRO 21:30">ಯಾವ ಜ್ಞಾನವೂ, ವಿವೇಕವೂ, ಯೋಜನೆಯೂ ಇಲ್ಲ.<verse eid="PRO 21:30"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="31" style="v" sid="PRO 21:31"/>ಯುದ್ಧದ ದಿನಕ್ಕಾಗಿ ಕುದುರೆಯು ಸಿದ್ಧವಾಗಿರುತ್ತದೆ;</para>
  <para style="q2" vid="PRO 21:31">ಆದರೆ ಜಯ ದೊರೆಯುವುದು ಯೆಹೋವ ದೇವರಿಂದಲೇ.<verse eid="PRO 21:31"/></para>
  <para style="b"/>
  <chapter eid="PRO 21"/>
  <chapter number="22" style="c" sid="PRO 22"/>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 22:1"/>ಬಹು ಐಶ್ವರ್ಯಕ್ಕಿಂತಲೂ ಒಳ್ಳೆಯ ಹೆಸರು ಉತ್ತಮ;</para>
  <para style="q2" vid="PRO 22:1">ಬೆಳ್ಳಿಬಂಗಾರಕ್ಕಿಂತಲೂ ಗೌರವದಿಂದಿರುವುದು ಉತ್ತಮ.<verse eid="PRO 22:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 22:2"/>ಧನಿಕರು, ಬಡವರು ಇದನ್ನು ಸಾಮಾನ್ಯವಾಗಿ ಹೊಂದಿರುವರು:</para>
  <para style="q2" vid="PRO 22:2">ಇವರೆಲ್ಲರನ್ನು ಸೃಷ್ಟಿಸಿದಾತ ಯೆಹೋವ ದೇವರೇ.<verse eid="PRO 22:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 22:3"/>ಜಾಣನು ಕೇಡನ್ನು ಮುಂದಾಗಿ ಕಂಡು ತಾನು ಅಡಗಿಕೊಳ್ಳುತ್ತಾನೆ;</para>
  <para style="q2" vid="PRO 22:3">ಆದರೆ ಮುಗ್ಧನು ಮುಂದೆ ಹೋಗಿ ಶಿಕ್ಷೆಯನ್ನು ಹೊಂದುತ್ತಾನೆ.<verse eid="PRO 22:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 22:4"/>ಯೆಹೋವ ದೇವರ ಭಯವೂ ದೀನತೆಯೂ ಕೊಡುವ ಪ್ರತಿಫಲ,</para>
  <para style="q2" vid="PRO 22:4">ಐಶ್ವರ್ಯವೂ ಮಾನವೂ ಜೀವವೂ ಆಗಿದೆ.<verse eid="PRO 22:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 22:5"/>ದುಷ್ಟರ ದಾರಿಯಲ್ಲಿ ಮುಳ್ಳುಗಳೂ, ಉರುಲುಗಳೂ ಇವೆ;</para>
  <para style="q2" vid="PRO 22:5">ತನ್ನ ಜೀವವನ್ನು ಕಾಪಾಡಿಕೊಳ್ಳುವವನು ಅವುಗಳಿಂದ ದೂರವಾಗಿರುವನು.<verse eid="PRO 22:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 22:6"/>ನಡೆಯಬೇಕಾದ ಮಾರ್ಗಕ್ಕೆ ತಕ್ಕಂತೆ ಮಕ್ಕಳಿಗೆ ಶಿಕ್ಷಣವನ್ನು ಕೊಡು;</para>
  <para style="q2" vid="PRO 22:6">ಆಗ ಮುಪ್ಪಿನಲ್ಲಿಯೂ ಅವನು ಅದರಿಂದ ದೂರ ಹೋಗುವುದಿಲ್ಲ.<verse eid="PRO 22:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 22:7"/>ಐಶ್ವರ್ಯವಂತನು ಬಡವನ ಮೇಲೆ ಆಳುತ್ತಾನೆ;</para>
  <para style="q2" vid="PRO 22:7">ಸಾಲಗಾರನು ಸಾಲಕೊಟ್ಟವನಿಗೆ ಗುಲಾಮನು.<verse eid="PRO 22:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 22:8"/>ಕೆಟ್ಟತನವನ್ನು ಬಿತ್ತುವವನು ಕೇಡನ್ನು ಕೊಯ್ಯುವನು;</para>
  <para style="q2" vid="PRO 22:8">ಅವನ ಕೋಪದ ಬೆತ್ತವು ಮುರಿದು ಹೋಗುವುದು.<verse eid="PRO 22:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 22:9"/>ಉದಾರವಾಗಿ ಕೊಡುವವನು ಆಶೀರ್ವಾದವನ್ನು ಹೊಂದುವನು,</para>
  <para style="q2" vid="PRO 22:9">ಏಕೆಂದರೆ ತನಗಿದ್ದ ಆಹಾರದಲ್ಲಿ ಬಡವರಿಗೆ ಕೊಡುತ್ತಾನೆ.<verse eid="PRO 22:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 22:10"/>ಪರಿಹಾಸ್ಯ ಮಾಡುವವನನ್ನು ಹೊರಗೆ ತಳ್ಳಿಬಿಟ್ಟರೆ ಕಲಹವು ನಿಲ್ಲುವುದು;</para>
  <para style="q2" vid="PRO 22:10">ವಿವಾದವೂ ನಿಂದೆಯೂ ನಿಂತುಹೋಗುವುವು.<verse eid="PRO 22:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 22:11"/>ಶುದ್ಧ ಹೃದಯವನ್ನು ಪ್ರೀತಿಸಿ, ಕೃಪೆಯಿಂದ ಮಾತನಾಡುವವನಿಗೆ</para>
  <para style="q2" vid="PRO 22:11">ಅರಸನು ಸ್ನೇಹಿತನಾಗಿರುವನು.<verse eid="PRO 22:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 22:12"/>ಯೆಹೋವ ದೇವರ ಕಣ್ಣುಗಳು ತಿಳುವಳಿಕೆಯನ್ನು ಕಾಯುತ್ತವೆ;</para>
  <para style="q2" vid="PRO 22:12">ಅವರು ದ್ರೋಹಿಯ ಮಾತುಗಳನ್ನು ಕೆಡವಿ ಹಾಕುತ್ತಾರೆ.<verse eid="PRO 22:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 22:13"/>ಸೋಮಾರಿಯು, “ಹೊರಗೆ ಸಿಂಹವಿದೆ!</para>
  <para style="q2" vid="PRO 22:13">ಅದು ನನ್ನನ್ನು ಬೀದಿಗಳಲ್ಲಿ ಕೊಂದುಹಾಕುತ್ತದೆ,” ಎಂದು ಹೇಳುತ್ತಾನೆ.<verse eid="PRO 22:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 22:14"/>ವ್ಯಭಿಚಾರಿಣಿಯ ಬಾಯಿ ಆಳವಾದ ಬಾವಿ;</para>
  <para style="q2" vid="PRO 22:14">ಯೆಹೋವ ದೇವರಿಗೆ ಸಿಟ್ಟನ್ನು ಎಬ್ಬಿಸುವವನು ಅದರಲ್ಲಿ ಬೀಳುವನು.<verse eid="PRO 22:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 22:15"/>ಮೂರ್ಖತನ ಯುವಕನ ಹೃದಯದಲ್ಲಿ ಬಂಧಿಸಲಾಗಿದೆ;</para>
  <para style="q2" vid="PRO 22:15">ಆದರೆ ಶಿಕ್ಷೆಯ ಬೆತ್ತವು ಅದನ್ನು ಅವನಿಂದ ದೂರವಾಗಿ ಓಡಿಸಿಬಿಡುವುದು.<verse eid="PRO 22:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 22:16"/>ತನ್ನ ಸಂಪತ್ತನ್ನು ವೃದ್ಧಿಗೊಳಿಸುವುದಕ್ಕೆ ಬಡವರನ್ನು ಹಿಂಸಿಸುವವನೂ</para>
  <para style="q2" vid="PRO 22:16">ಐಶ್ವರ್ಯವಂತರಿಗೆ ದಾನ ಕೊಡುವವನೂ ನಿಶ್ಚಯವಾಗಿ ಕೊರತೆಪಡುವನು.<verse eid="PRO 22:16"/></para>
  <para style="ms1">ಜ್ಞಾನಿಯ ಮೂವತ್ತು ಹೇಳಿಕೆಗಳು</para>
  <para style="s2">ಮೊದಲನೆಯ ಹೇಳಿಕೆ</para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 22:17"/>ಜ್ಞಾನಿಗಳ ಮಾತುಗಳನ್ನು ಕಿವಿಗೊಟ್ಟು ಕೇಳು;</para>
  <para style="q2" vid="PRO 22:17">ನನ್ನ ಬೋಧನೆಯನ್ನು ನಿನ್ನ ಹೃದಯವು ಅನ್ವಯಿಸಲಿ.<verse eid="PRO 22:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 22:18"/>ಏಕೆಂದರೆ ಅವುಗಳನ್ನು ನಿನ್ನ ಹೃದಯದಲ್ಲಿ ಇಟ್ಟು ಕಾಪಾಡು,</para>
  <para style="q2" vid="PRO 22:18">ಅವು ನಿನ್ನ ತುಟಿಗಳ ಮೇಲೆ ಸಿದ್ಧವಿದ್ದರೆ ಮೆಚ್ಚುಗೆಯಾಗಿವೆ.<verse eid="PRO 22:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 22:19"/>ನಿನ್ನ ಭರವಸೆಯು ಯೆಹೋವ ದೇವರಲ್ಲಿ ಇರುವಂತೆ</para>
  <para style="q2" vid="PRO 22:19">ಈ ದಿವಸ ನಿನಗೇ ತಿಳಿಯಪಡಿಸಿದ್ದೇನೆ.<verse eid="PRO 22:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 22:20"/>ನಾನು ನಿಮಗಾಗಿ ಮೂವತ್ತು ಹೇಳಿಕೆಗಳನ್ನು ಬರೆದಿಲ್ಲವೋ?</para>
  <para style="q2" vid="PRO 22:20">ಸಲಹೆ ಮತ್ತು ಪರಿಜ್ಞಾನದ ಹೇಳಿಕೆಗಳು,<verse eid="PRO 22:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 22:21"/>ಪ್ರಾಮಾಣಿಕವಾಗಿರಲು ಮತ್ತು ಸತ್ಯವನ್ನು ಮಾತನಾಡಲು ನಿಮಗೆ ಕಲಿಸುವುದು,</para>
  <para style="q2" vid="PRO 22:21">ಆದ್ದರಿಂದ ನೀವು ಸೇವೆ ಸಲ್ಲಿಸುವವರಿಗೆ</para>
  <para style="q2" vid="PRO 22:21">ಸತ್ಯವಾದ ವರದಿಗಳನ್ನು ಹಿಂತಿರುಗಿಸುವಂತೆ ನಾನು ನಿಮಗೆ ಬರೆದಿದ್ದೇನೆ.<verse eid="PRO 22:21"/></para>
  <para style="s2">ಎರಡನೆಯ ಹೇಳಿಕೆ</para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 22:22"/>ಬಡವರಿಗೆ ದಿಕ್ಕಿಲ್ಲವೆಂದು ತಿಳಿದು ಅವರನ್ನು ಸೂರೆಮಾಡಬೇಡ;</para>
  <para style="q2" vid="PRO 22:22">ನ್ಯಾಯಾಲಯದಲ್ಲಿ ದರಿದ್ರರನ್ನು ತುಳಿಯಬೇಡ.<verse eid="PRO 22:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 22:23"/>ಏಕೆಂದರೆ ಯೆಹೋವ ದೇವರು ಅವರ ವ್ಯಾಜ್ಯವನ್ನು ನಡೆಸಿ,</para>
  <para style="q2" vid="PRO 22:23">ಸೂರೆ ಮಾಡಿದವರ ಪ್ರಾಣವನ್ನು ಸೂರೆ ಮಾಡುವರು.<verse eid="PRO 22:23"/></para>
  <para style="s2">ಮೂರನೆಯ ಹೇಳಿಕೆ</para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 22:24"/>ಮುಂಗೊಪಿಯೊಂದಿಗೆ ಸ್ನೇಹ ಬೆಳೆಸಬೇಡ;</para>
  <para style="q2" vid="PRO 22:24">ಸುಲಭವಾಗಿ ಕೋಪಗೊಳ್ಳುವವರೊಂದಿಗೆ ಸಹವಾಸ ಮಾಡಬೇಡ;<verse eid="PRO 22:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 22:25"/>ಹಾಗೆ ಮಾಡಿದರೆ ನೀನು ಅವನ ನಡತೆಗಳನ್ನು ಕಲಿತು,</para>
  <para style="q2" vid="PRO 22:25">ನಿನ್ನನ್ನೇ ಉರುಲಿಗೆ ಸಿಕ್ಕಿಸಿಕೊಳ್ಳುವೆ.<verse eid="PRO 22:25"/></para>
  <para style="s2">ನಾಲ್ಕನೆಯ ಹೇಳಿಕೆ</para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 22:26"/>ಬೇರೆಯವರ ಸಾಲವನ್ನು ಖಾತರಿಪಡಿಸಲೂ</para>
  <para style="q2" vid="PRO 22:26">ಬೇರೊಬ್ಬರಿಗೆ ಭದ್ರತೆಯನ್ನು ನೀಡಲು ಒಪ್ಪಬೇಡ.<verse eid="PRO 22:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 22:27"/>ಸಾಲ ತೀರಿಸಲು ನಿನಗೆ ಏನೂ ಇಲ್ಲದೆ ಹೋದರೆ</para>
  <para style="q2" vid="PRO 22:27">ನಿನ್ನ ಕೆಳಗಿನ ಹಾಸಿಗೆಯನ್ನು ಅವನು ತೆಗೆದುಕೊಂಡು ಹೋಗುವನಲ್ಲವೇ?<verse eid="PRO 22:27"/></para>
  <para style="s2">ಐದನೆಯ ಹೇಳಿಕೆ</para>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 22:28"/>ನಿನ್ನ ಪಿತೃಗಳು ಹಾಕಿದ ಪೂರ್ವಕಾಲದ</para>
  <para style="q2" vid="PRO 22:28">ಮೇರೆಯನ್ನು ತೆಗೆಯಬೇಡ.<verse eid="PRO 22:28"/></para>
  <para style="s2">ಆರನೆಯ ಹೇಳಿಕೆ</para>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 22:29"/>ತನ್ನ ಕೆಲಸದಲ್ಲಿ ಶ್ರದ್ಧೆಯುಳ್ಳವನನ್ನು ನೀನು ನೋಡಿದ್ದೀಯಾ?</para>
  <para style="q2" vid="PRO 22:29">ಅವನು ನೀಚರ ಮುಂದೆ ಅಲ್ಲ,</para>
  <para style="q2" vid="PRO 22:29">ಅರಸರ ಮುಂದೆಯೇ ಸೇವೆ ಸಲ್ಲಿಸುವನು.<verse eid="PRO 22:29"/></para>
  <chapter eid="PRO 22"/>
  <chapter number="23" style="c" sid="PRO 23"/>
  <para style="s2">ಏಳನೆಯ ಹೇಳಿಕೆ</para>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 23:1"/>ಆಳುವವನ ಸಂಗಡ ನೀನು ಊಟಕ್ಕೆ ಕುಳಿತಿರುವಾಗ,</para>
  <para style="q2" vid="PRO 23:1">ನಿನ್ನ ಎದುರಿನಲ್ಲಿ ಏನಿದೆ ಎಂದು ಶ್ರದ್ಧೆಯಿಂದ ಗಮನಿಸು.<verse eid="PRO 23:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 23:2"/>ನೀನು ಹೊಟ್ಟೆಬಾಕನಾಗಿದ್ದರೆ,</para>
  <para style="q2" vid="PRO 23:2">ನಿನ್ನ ಕುತ್ತಿಗೆಗೆ ಖಡ್ಗವನ್ನು ಇಟ್ಟುಕೋ.<verse eid="PRO 23:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 23:3"/>ಅವನ ರುಚಿ ಪದಾರ್ಥಗಳನ್ನು ಅಪೇಕ್ಷಿಸಬೇಡ;</para>
  <para style="q2" vid="PRO 23:3">ಏಕೆಂದರೆ ಅದು ಮೋಸದ ಆಹಾರವು.<verse eid="PRO 23:3"/></para>
  <para style="s2">ಎಂಟನೆಯ ಹೇಳಿಕೆ</para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 23:4"/>ಐಶ್ವರ್ಯವಂತನಾಗುವುದಕ್ಕೆ ಪ್ರಯಾಸಪಡಬೇಡ;</para>
  <para style="q2" vid="PRO 23:4">ಅದಕ್ಕಾಗಿ ಸ್ವಬುದ್ಧಿಯನ್ನೇ ಆಶ್ರಯಿಸಬೇಡ.<verse eid="PRO 23:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 23:5"/>ಕಣ್ಣು ಮಿಟುಕಿಸುವುದರಲ್ಲಿ ಐಶ್ವರ್ಯ ಕಣ್ಮರೆಯಾಗುತ್ತದೆ.</para>
  <para style="q2" vid="PRO 23:5">ಅದು ನಿಸ್ಸಂದೇಹವಾಗಿ ರೆಕ್ಕೆಗಳನ್ನು ಕಟ್ಟಿಕೊಂಡು</para>
  <para style="q2" vid="PRO 23:5">ಹದ್ದಿನಂತೆ ಆಕಾಶದ ಕಡೆಗೆ ಹಾರಿಹೋಗುವುದು.<verse eid="PRO 23:5"/></para>
  <para style="s2">ಒಂಬತ್ತನೆಯ ಹೇಳಿಕೆ</para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 23:6"/>ಜಿಪುಣನ ಆಹಾರವನ್ನು ತಿನ್ನಬೇಡ;</para>
  <para style="q2" vid="PRO 23:6">ಅವನ ರುಚಿ ಪದಾರ್ಥಗಳನ್ನು ಆಶಿಸಬೇಡ.<verse eid="PRO 23:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 23:7"/>ಏಕೆಂದರೆ, ಅವನು ಎಲ್ಲದಕ್ಕೂ ಬೆಲೆ ಕಟ್ಟುವ</para>
  <para style="q2" vid="PRO 23:7">ಯೋಚನೆಯುಳ್ಳವನಂತೆ ಇದ್ದಾನೆ;</para>
  <para style="q1" vid="PRO 23:7">ಅವನು, “ತಿನ್ನು, ಕುಡಿ,” ಎಂದು ಹೇಳುತ್ತಾನೆ;</para>
  <para style="q2" vid="PRO 23:7">ಆದರೆ ಅವನ ಹೃದಯವು ನಿನ್ನೊಂದಿಗಿಲ್ಲ.<verse eid="PRO 23:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 23:8"/>ನೀನು ತಿಂದ ಸ್ವಲ್ಪ ತುತ್ತನ್ನು ಕಕ್ಕಿಬಿಡುವೆ;</para>
  <para style="q2" vid="PRO 23:8">ನಿನ್ನ ಸವಿಮಾತುಗಳೆಲ್ಲಾ ವ್ಯರ್ಥವೇ.<verse eid="PRO 23:8"/></para>
  <para style="s2">ಹತ್ತನೆಯ ಹೇಳಿಕೆ</para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 23:9"/>ಬುದ್ಧಿಹೀನರ ಸಂಗಡ ಮಾತಾಡಬೇಡ;</para>
  <para style="q2" vid="PRO 23:9">ಏಕೆಂದರೆ ನಿನ್ನ ಜ್ಞಾನದ ಮಾತುಗಳನ್ನು ಅವರು ತಿರಸ್ಕರಿಸುವನು.<verse eid="PRO 23:9"/></para>
  <para style="s2">ಹನ್ನೊಂದನೆಯ ಹೇಳಿಕೆ</para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 23:10"/>ಪೂರ್ವಕಾಲದ ಮೇರೆಯನ್ನು ತೆಗೆಯಬೇಡ;</para>
  <para style="q2" vid="PRO 23:10">ಅನಾಥರ ಹೊಲಗಳನ್ನು ಅತಿಕ್ರಮಿಸಬೇಡ.<verse eid="PRO 23:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 23:11"/>ಏಕೆಂದರೆ ಅವನ ವಿಮೋಚಕನು ಬಲಶಾಲಿಯಾಗಿದ್ದಾನೆ;</para>
  <para style="q2" vid="PRO 23:11">ಅವರ ವ್ಯಾಜ್ಯಕ್ಕಾಗಿ ಆತನು ವಾದಿಸುವನು.<verse eid="PRO 23:11"/></para>
  <para style="s2">ಹನ್ನೆರಡನೆಯ ಹೇಳಿಕೆ</para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 23:12"/>ಶಿಸ್ತಿಗೆ ನಿನ್ನ ಹೃದಯವನ್ನೂ</para>
  <para style="q2" vid="PRO 23:12">ತಿಳುವಳಿಕೆಯ ಮಾತುಗಳಿಗೆ ನಿನ್ನ ಕಿವಿಗಳನ್ನೂ ಕೊಡು.<verse eid="PRO 23:12"/></para>
  <para style="s2">ಹದಿಮೂರನೆಯ ಹೇಳಿಕೆ</para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 23:13"/>ಮಕ್ಕಳನ್ನು ಶಿಕ್ಷಿಸಲು ಹಿಂದೆಗೆಯಬೇಡ;</para>
  <para style="q2" vid="PRO 23:13">ಬೆತ್ತದಿಂದ ಹೊಡೆದರೆ, ಅವರು ಸಾಯುವುದಿಲ್ಲ.<verse eid="PRO 23:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 23:14"/>ಅವರನ್ನು ಬೆತ್ತದಿಂದ ಹೊಡೆದು,</para>
  <para style="q2" vid="PRO 23:14">ಪಾತಾಳದಿಂದ ಅವರ ಮರಣವನ್ನು ತಪ್ಪಿಸುವೆ.<verse eid="PRO 23:14"/></para>
  <para style="s2">ಹದಿನಾಲ್ಕನೆಯ ಹೇಳಿಕೆ</para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 23:15"/>ಮಗನೇ, ನಿನ್ನ ಹೃದಯವು ಜ್ಞಾನವುಳ್ಳದ್ದಾಗಿದ್ದರೆ,</para>
  <para style="q2" vid="PRO 23:15">ನನ್ನ ಹೃದಯವು ಹರ್ಷಿಸುವುದು.<verse eid="PRO 23:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 23:16"/>ನಿನ್ನ ತುಟಿಗಳು ಯಥಾರ್ಥವಾದವುಗಳನ್ನು ಮಾತಾಡಿದರೆ,</para>
  <para style="q2" vid="PRO 23:16">ನನ್ನ ಅಂತರಾತ್ಮವು ಸಂತೋಷಿಸುವುದು.<verse eid="PRO 23:16"/></para>
  <para style="s2">ಹದಿನೈದನೆಯ ಹೇಳಿಕೆ</para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 23:17"/>ಪಾಪಿಗಳನ್ನು ನೋಡಿ ನಿನ್ನ ಹೃದಯವು ಅಸೂಯೆಪಡದಿರಲಿ;</para>
  <para style="q2" vid="PRO 23:17">ಆದರೆ ಯೆಹೋವ ದೇವರ ಭಯದಲ್ಲಿರಲು ಯಾವಾಗಲೂ ಆಸಕ್ತನಾಗಿರು.<verse eid="PRO 23:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 23:18"/>ಖಂಡಿತವಾಗಿಯೂ ನಿನಗೆ ಮುಂದಿನ ನಿರೀಕ್ಷೆಯಿದೆ;</para>
  <para style="q2" vid="PRO 23:18">ನಿನ್ನ ನಿರೀಕ್ಷೆಯು ನಿರರ್ಥಕವಾಗದು.<verse eid="PRO 23:18"/></para>
  <para style="s2">ಹದಿನಾರನೆಯ ಹೇಳಿಕೆ</para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 23:19"/>ಮಗನೇ, ಕೇಳಿ ಜ್ಞಾನವಂತನಾಗು;</para>
  <para style="q2" vid="PRO 23:19">ನೀತಿ ಮಾರ್ಗದಲ್ಲಿ ನಿನ್ನ ಹೃದಯವನ್ನು ನಡೆಸು.<verse eid="PRO 23:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 23:20"/>ಅತಿ ಮದ್ಯಪಾನ ಮಾಡುವವರಲ್ಲಿ</para>
  <para style="q2" vid="PRO 23:20">ಅತಿ ಮಾಂಸಭಕ್ಷರಲ್ಲಿಯೂ ಸೇರಬೇಡ.<verse eid="PRO 23:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 23:21"/>ಏಕೆಂದರೆ ಕುಡುಕರೂ ಹೊಟ್ಟೆಬಾಕರೂ ದುರ್ಗತಿಗೆ ಬರುವರು;</para>
  <para style="q2" vid="PRO 23:21">ತೂಕಡಿಕೆಯು ಹರಕು ಬಟ್ಟೆಗಳನ್ನು ಹೊದಿಸುವದು.<verse eid="PRO 23:21"/></para>
  <para style="s2">ಹದಿನೇಳನೆಯ ಹೇಳಿಕೆ</para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 23:22"/>ನಿನ್ನನ್ನು ಹೆತ್ತ ತಂದೆಯ ಮಾತಿಗೆ ಕಿವಿಗೊಡು,</para>
  <para style="q2" vid="PRO 23:22">ನಿನ್ನ ತಾಯಿ ಮುಪ್ಪಿನವಳಾದಾಗ ಆಕೆಯನ್ನು ಅಸಡ್ಡೆ ಮಾಡಬೇಡ.<verse eid="PRO 23:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 23:23"/>ಸತ್ಯವನ್ನೂ ಜ್ಞಾನವನ್ನೂ ಶಿಕ್ಷಣವನ್ನೂ ವಿವೇಕವನ್ನೂ ಕೊಂಡುಕೋ;</para>
  <para style="q2" vid="PRO 23:23">ಆದರೆ ಅವುಗಳನ್ನು ಮಾರಬೇಡ.<verse eid="PRO 23:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 23:24"/>ನೀತಿವಂತನ ತಂದೆಯು ಬಹಳವಾಗಿ ಸಂತೋಷಪಡುವನು;</para>
  <para style="q2" vid="PRO 23:24">ಜ್ಞಾನಿಯಾದ ಮಗುವನ್ನು ಪಡೆದವನಿಗೆ ಅವನಿಂದ ಆನಂದವಾಗುವುದು.<verse eid="PRO 23:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 23:25"/>ನಿನ್ನ ತಂದೆತಾಯಿಗಳು ಸಂತೋಷಿಸುವರು;</para>
  <para style="q2" vid="PRO 23:25">ನಿನ್ನ ಹೆತ್ತ ತಾಯಿ ಆನಂದಿಸುವಳು.<verse eid="PRO 23:25"/></para>
  <para style="s2">ಹದಿನೆಂಟನೆಯ ಹೇಳಿಕೆ</para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 23:26"/>ಮಗನೇ, ನಿನ್ನ ಮನಸ್ಸನ್ನು ನನಗೆ ಕೊಡು;</para>
  <para style="q2" vid="PRO 23:26">ನನ್ನ ಮಾರ್ಗಗಳನ್ನು ಅನುಸರಿಸುವಲ್ಲಿ ನಿಮ್ಮ ಕಣ್ಣುಗಳು ಆನಂದಿಸಲಿ.<verse eid="PRO 23:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 23:27"/>ವೇಶ್ಯೆಯು ಆಳವಾದ ಕುಣಿ;</para>
  <para style="q2" vid="PRO 23:27">ವ್ಯಭಿಚಾರಿಣಿಯು ಇಕ್ಕಟ್ಟಾದ ಗುಂಡಿ.<verse eid="PRO 23:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 23:28"/>ಕಳ್ಳನಂತೆ ಅವಳು ಹೊಂಚು ಹಾಕಿ</para>
  <para style="q2" vid="PRO 23:28">ಮನುಷ್ಯರಲ್ಲಿ ದ್ರೋಹಿಗಳನ್ನು ಹೆಚ್ಚಿಸುತ್ತಾಳೆ.<verse eid="PRO 23:28"/></para>
  <para style="s2">ಹತ್ತೊಂಬತ್ತನೆಯ ಹೇಳಿಕೆ</para>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 23:29"/>ಯಾರಿಗೆ ಕಷ್ಟ? ಯಾರಿಗೆ ದುಃಖ?</para>
  <para style="q2" vid="PRO 23:29">ಯಾರಿಗೆ ಕಲಹಗಳು? ಯಾರು ಗೊಣಗುಟ್ಟುತ್ತಾರೆ?</para>
  <para style="q2" vid="PRO 23:29">ಯಾರು ಸುಮ್ಮಸುಮ್ಮನೆ ಗಾಯಪಡುತ್ತಾರೆ? ಯಾರಿಗೆ ಕೆಂಪೇರಿದ ಕಣ್ಣುಗಳು?<verse eid="PRO 23:29"/></para>
  <para style="q1">
    <verse number="30" style="v" sid="PRO 23:30"/>ಮದ್ಯಪಾನದಲ್ಲಿ ಆಸಕ್ತರಾಗಿ,</para>
  <para style="q2" vid="PRO 23:30">ಮಿಶ್ರ ಮದ್ಯಪಾನವನ್ನು ಕುಡಿಯ ಬಯಸುವವರೇ ಅಲ್ಲವೇ!<verse eid="PRO 23:30"/></para>
  <para style="q1">
    <verse number="31" style="v" sid="PRO 23:31"/>ದ್ರಾಕ್ಷಾರಸವು ಕೆಂಪಾಗಿದ್ದು,</para>
  <para style="q2" vid="PRO 23:31">ಪಾತ್ರೆಯಲ್ಲಿ ಥಳಥಳಿಸುತ್ತಾ ಚಲಿಸಿದರೆ,</para>
  <para style="q2" vid="PRO 23:31">ಅದನ್ನು ನೋಡಬೇಡ.<verse eid="PRO 23:31"/></para>
  <para style="q1">
    <verse number="32" style="v" sid="PRO 23:32"/>ಕೊನೆಗೆ ಅದು ಹಾವಿನಂತೆ ಕಚ್ಚುವುದು</para>
  <para style="q2" vid="PRO 23:32">ಮತ್ತು ಸರ್ಪದಂತೆ ವಿಷವುಕ್ಕಿಸುವುದು.<verse eid="PRO 23:32"/></para>
  <para style="q1">
    <verse number="33" style="v" sid="PRO 23:33"/>ನಿಮ್ಮ ಕಣ್ಣುಗಳು ವಿಚಿತ್ರ ದೃಶ್ಯಗಳನ್ನು ನೋಡುತ್ತವೆ.</para>
  <para style="q2" vid="PRO 23:33">ನಿಮ್ಮ ಮನಸ್ಸು ಗೊಂದಲಮಯ ವಿಷಯಗಳನ್ನು ಕಲ್ಪಿಸುತ್ತದೆ.<verse eid="PRO 23:33"/></para>
  <para style="q1">
    <verse number="34" style="v" sid="PRO 23:34"/>ನೀನು ಸಮುದ್ರದ ಮಧ್ಯದಲ್ಲಿ ಮಲಗಿರುವವನಂತೆ</para>
  <para style="q2" vid="PRO 23:34">ಇಲ್ಲವೆ ಹಡಗಿನ ಕಂಬದ ತುದಿಯಲ್ಲಿ ಇರುವಿ.<verse eid="PRO 23:34"/></para>
  <para style="q1">
    <verse number="35" style="v" sid="PRO 23:35"/>“ಜನರು ನನ್ನನ್ನು ಹೊಡೆದರೂ</para>
  <para style="q2" vid="PRO 23:35">ನನಗೆ ನೋವಾಗಲಿಲ್ಲ;</para>
  <para style="q1" vid="PRO 23:35">ನಾನು ಎಚ್ಚರವಾಗುವುದು ಯಾವಾಗ?</para>
  <para style="q2" vid="PRO 23:35">ಪುನಃ ನಾನು ಅದನ್ನು ಕುಡಿದೇನು?” ಎಂದುಕೊಳ್ಳುವೆ.<verse eid="PRO 23:35"/></para>
  <chapter eid="PRO 23"/>
  <chapter number="24" style="c" sid="PRO 24"/>
  <para style="s2">ಇಪ್ಪತ್ತನೆಯ ಹೇಳಿಕೆ</para>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 24:1"/>ಕೆಟ್ಟವರಿಗೆ ವಿರೋಧವಾಗಿ ನೀನು ಅಸೂಯೆ ಪಡದಿರು;</para>
  <para style="q2" vid="PRO 24:1">ಇಲ್ಲವೆ ಅವರ ಸಂಗಡ ಇರುವುದಕ್ಕೆ ಅಪೇಕ್ಷಿಸಬೇಡ.<verse eid="PRO 24:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 24:2"/>ಏಕೆಂದರೆ ಅವರ ಹೃದಯವು ಹಿಂಸೆಯನ್ನು ಯೋಜಿಸುತ್ತದೆ;</para>
  <para style="q2" vid="PRO 24:2">ಅವರ ತುಟಿಗಳು ಹಾನಿಯನ್ನು ಪ್ರಸ್ತಾಪಿಸುತ್ತವೆ.<verse eid="PRO 24:2"/></para>
  <para style="s2">ಇಪ್ಪತ್ತೊಂದನೆಯ ಹೇಳಿಕೆ</para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 24:3"/>ಜ್ಞಾನದಿಂದ ಮನೆಯು ಕಟ್ಟಲಾಗುತ್ತದೆ.</para>
  <para style="q2" vid="PRO 24:3">ತಿಳುವಳಿಕೆಯಿಂದ ಅದು ಸ್ಥಿರಗೊಳ್ಳುತ್ತದೆ.<verse eid="PRO 24:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 24:4"/>ತಿಳುವಳಿಕೆಯಿಂದ ಅದರ ಕೋಣೆಗಳು ಅಮೂಲ್ಯವಾದ</para>
  <para style="q2" vid="PRO 24:4">ಎಲ್ಲಾ ಇಷ್ಟ ಸಂಪತ್ತಿನಿಂದ ತುಂಬುವುದು.<verse eid="PRO 24:4"/></para>
  <para style="s2">ಇಪ್ಪತ್ತೇರಡನೆಯ ಹೇಳಿಕೆ</para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 24:5"/>ಬಲವುಳ್ಳವನಿಗಿಂತ ಜ್ಞಾನಿಯು ಶಕ್ತಿಶಾಲಿ;</para>
  <para style="q2" vid="PRO 24:5">ತಿಳುವಳಿಕೆಯುಳ್ಳವನು ಬಲವನ್ನು ಹೆಚ್ಚಿಸಿಕೊಳ್ಳುತ್ತಾನೆ.<verse eid="PRO 24:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 24:6"/>ಖಂಡಿತವಾಗಿಯೂ ನಿಮಗೆ ಯುದ್ಧಮಾಡಲು ಮಾರ್ಗದರ್ಶನ ಬೇಕು,</para>
  <para style="q2" vid="PRO 24:6">ಬಹುಮಂದಿ ಸಲಹೆಗಾರರು ಇರುವಲ್ಲಿ ಜಯವಿರುವುದು.<verse eid="PRO 24:6"/></para>
  <para style="s2">ಇಪ್ಪತ್ಮೂರನೆಯ ಹೇಳಿಕೆ</para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 24:7"/>ಜ್ಞಾನವು ಬುದ್ಧಿಹೀನನಿಗೆ ನಿಲುಕದು;</para>
  <para style="q2" vid="PRO 24:7">ಪುರದ್ವಾರದಲ್ಲಿ ಕೂಡಿಬಂದ ಸಭೆಯಲ್ಲಿ ಅವನು ತನ್ನ ಬಾಯಿಯನ್ನು ತೆರೆಯುವುದೇ ಇಲ್ಲ.<verse eid="PRO 24:7"/></para>
  <para style="s2">ಇಪ್ಪತ್ತನಾಲ್ಕನೆಯ ಹೇಳಿಕೆ</para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 24:8"/>ಕೇಡನ್ನು ಕಲ್ಪಿಸುವವನು</para>
  <para style="q2" vid="PRO 24:8">ಕುಚೋದ್ಯಗಾರನೆಂದು ಕರೆಯಲ್ಪಡುವನು.<verse eid="PRO 24:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 24:9"/>ಬುದ್ಧಿಹೀನನ ಆಲೋಚನೆಯು ಪಾಪಮಯ;</para>
  <para style="q2" vid="PRO 24:9">ಪರಿಹಾಸ್ಯಗಾರನು ಮನುಷ್ಯರಿಗೆ ಅಸಹ್ಯ.<verse eid="PRO 24:9"/></para>
  <para style="s2">ಇಪ್ಪತ್ತೈದನೆಯ ಹೇಳಿಕೆ</para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 24:10"/>ಇಕ್ಕಟ್ಟಿನ ಸಮಯದಲ್ಲಿ ನೀನು ಬಳಲಿ ಹೋದರೆ,</para>
  <para style="q2" vid="PRO 24:10">ನಿನ್ನ ಬಲವು ಕೊಂಚವಾಗಿದೆ.<verse eid="PRO 24:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 24:11"/>ಅನ್ಯಾಯವಾಗಿ ಮರಣಕ್ಕೆ ಸಾಗಿಸುವನನ್ನು ಬಿಡಿಸುವುದಕ್ಕೆ ಯತ್ನಿಸು;</para>
  <para style="q2" vid="PRO 24:11">ಕೊಲೆಗೆ ನೇಮಿತವಾದವರನ್ನು ನೀನು ರಕ್ಷಿಸು.<verse eid="PRO 24:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 24:12"/>ನೀನು, “ಅದು ನನಗೆ ಏನೂ ಗೊತ್ತಿಲ್ಲ” ಎಂದು ಹೇಳಿದರೆ,</para>
  <para style="q2" vid="PRO 24:12">ಹೃದಯವನ್ನು ಪರಿಶೋಧಿಸುವ ದೇವರು ಅದನ್ನು ತಿಳಿಯುವದಿಲ್ಲವೋ?</para>
  <para style="q1" vid="PRO 24:12">ನಿನ್ನ ಜೀವವನ್ನು ಕಾಯುವಾತನು ಅದನ್ನು ತಿಳಿಯುವುದಿಲ್ಲವೋ?</para>
  <para style="q2" vid="PRO 24:12">ಪ್ರತಿಯೊಬ್ಬನ ಕಾರ್ಯಗಳಿಗನುಸಾರವಾಗಿ ಆತನು ಪ್ರತಿಫಲವನ್ನು ಕೊಡದೆ ಇರುವನೇ?<verse eid="PRO 24:12"/></para>
  <para style="s2">ಇಪ್ಪತ್ತಾರನೆಯ ಹೇಳಿಕೆ</para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 24:13"/>ಮಗನೇ, ಜೇನನ್ನು ತಿನ್ನು, ಅದು ಚೆನ್ನಾಗಿದೆ;</para>
  <para style="q2" vid="PRO 24:13">ಜೇನು ಗೂಡಿನ ಜೇನುತುಪ್ಪವು ನಿನ್ನ ಬಾಯಿಗೆ ಸಿಹಿಯಾಗಿದೆ.<verse eid="PRO 24:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 24:14"/>ಅಂತೆಯೇ ಜ್ಞಾನವು ನಿನಗೆ ಜೇನುತುಪ್ಪದಂತೆ ತಿಳಿದುಕೋ.</para>
  <para style="q2" vid="PRO 24:14">ಅದು ಸಿಕ್ಕಿದಾಗ ನಿನಗೆ ಉಜ್ವಲ ಭವಿಷ್ಯವಿದೆ.</para>
  <para style="q2" vid="PRO 24:14">ನಿನ್ನ ನಿರೀಕ್ಷೆಯು ನಿರರ್ಥಕವಾಗುವುದಿಲ್ಲ.<verse eid="PRO 24:14"/></para>
  <para style="s2">ಇಪ್ಪತ್ತೇಳನೆಯ ಹೇಳಿಕೆ</para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 24:15"/>ದುಷ್ಟನೇ, ನೀತಿವಂತನ ನಿವಾಸಕ್ಕೆ ಹೊಂಚು ಹಾಕಬೇಡ;</para>
  <para style="q2" vid="PRO 24:15">ಅವನ ವಿಶ್ರಾಂತಿಯ ಸ್ಥಳವನ್ನು ಸೂರೆಮಾಡಬೇಡ.<verse eid="PRO 24:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 24:16"/>ಏಕೆಂದರೆ ನೀತಿವಂತನು ಏಳು ಸಾರಿ ಬಿದ್ದರೂ ಮತ್ತೆ ಏಳುತ್ತಾನೆ;</para>
  <para style="q2" vid="PRO 24:16">ಆದರೆ ದುಷ್ಟನು ಕೇಡು ಬಂದಾಗ ಬೀಳುವನು.<verse eid="PRO 24:16"/></para>
  <para style="s2">ಇಪ್ಪತ್ತೆಂಟನೆಯ ಹೇಳಿಕೆ</para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 24:17"/>ನಿನ್ನ ಶತ್ರು ಬಿದ್ದರೆ ಆನಂದಿಸಬೇಡ;</para>
  <para style="q2" vid="PRO 24:17">ಅವನು ಎಡವಿದರೆ ನಿನ್ನ ಹೃದಯವು ಹರ್ಷಿಸದಿರಲಿ.<verse eid="PRO 24:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 24:18"/>ಯೆಹೋವ ದೇವರು ಅದನ್ನು ಕಂಡು, ಅದು ಅವರಿಗೆ ಇಷ್ಟವಿಲ್ಲದ್ದರಿಂದ,</para>
  <para style="q2" vid="PRO 24:18">ಅವರು ಅವನ ಕಡೆಯಿಂದ ತನ್ನ ಕೋಪವನ್ನು ತಿರುಗಿಸಿಬಿಟ್ಟಾರು.<verse eid="PRO 24:18"/></para>
  <para style="s2">ಇಪ್ಪತ್ತೊಂಬತ್ತನೆಯ ಹೇಳಿಕೆ</para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 24:19"/>ಕೆಟ್ಟವರನ್ನು ಕಂಡು ಉರಿಗೊಳ್ಳಬೇಡ;</para>
  <para style="q2" vid="PRO 24:19">ಇಲ್ಲವೆ ದುಷ್ಟರನ್ನು ಕಂಡು ಅಸೂಯೆಪಡಬೇಡ.<verse eid="PRO 24:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 24:20"/>ಏಕೆಂದರೆ ಕೆಡುಕನಿಗೆ ಭವಿಷ್ಯದ ನಿರೀಕ್ಷೆ ಇರುವುದಿಲ್ಲ;</para>
  <para style="q2" vid="PRO 24:20">ದುಷ್ಟರ ದೀಪವು ಆರಿಹೋಗುವುದು.<verse eid="PRO 24:20"/></para>
  <para style="s2">ಮೂವತ್ತನೆಯ ಹೇಳಿಕೆ</para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 24:21"/>ಮಗನೇ, ಯೆಹೋವ ದೇವರಿಗೂ, ಅರಸನಿಗೂ ಭಯಪಡು;</para>
  <para style="q2" vid="PRO 24:21">ತಿರುಗಿಬೀಳುವವರ ಸಹವಾಸ ಮಾಡಬೇಡ,<verse eid="PRO 24:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 24:22"/>ಏಕೆಂದರೆ ಅವರಿಬ್ಬರು ವಿಧಿಸುವ ವಿಪತ್ತು ಫಕ್ಕನೆ ಸಂಭವಿಸುವದು;</para>
  <para style="q2" vid="PRO 24:22">ಅವರು ಯಾವ ವಿಪತ್ತುಗಳನ್ನು ತರಬಹುದು ಎಂದು ಯಾರಿಗೆ ತಿಳಿದಿದೆ?<verse eid="PRO 24:22"/></para>
  <para style="ms1">ಜ್ಞಾನಿಯ ಮತ್ತಷ್ಟು ಹೇಳಿಕೆಗಳು</para>
  <para style="p">
    <verse number="23" style="v" sid="PRO 24:23"/>ಇವು ಜ್ಞಾನಿಗಳ ಹೇಳಿಕೆಗಳಾಗಿವೆ:</para>
  <para style="q1" vid="PRO 24:23">ನ್ಯಾಯ ವಿಚಾರಣೆಯಲ್ಲಿ ಪಕ್ಷಪಾತವು ಸರಿಯಲ್ಲ.<verse eid="PRO 24:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 24:24"/>ಯಾವನು ದುಷ್ಟನಿಗೆ, “ನೀನು ನೀತಿವಂತನು” ಎಂದು ಹೇಳುತ್ತಾನೋ</para>
  <para style="q2" vid="PRO 24:24">ಅವನನ್ನು ಜನರು ಶಪಿಸುವರು; ಜನಾಂಗಗಳು ಅವನನ್ನು ದೂಷಿಸುವರು.<verse eid="PRO 24:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 24:25"/>ಆದರೆ ತಪ್ಪುಮಾಡಿದವರನ್ನು ತಿದ್ದುವವರಿಗೆ ಶುಭವಾಗುವುದು;</para>
  <para style="q2" vid="PRO 24:25">ಅವರ ಮೇಲೆ ಒಳ್ಳೆಯ ಆಶೀರ್ವಾದವು ಬರುವುದು.<verse eid="PRO 24:25"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 24:26"/>ಪ್ರಾಮಾಣಿಕವಾದ ಉತ್ತರವು</para>
  <para style="q2" vid="PRO 24:26">ತುಟಿಗೆ ಮುದ್ದಿಟ್ಟಂತೆ.<verse eid="PRO 24:26"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 24:27"/>ನಿನ್ನ ಹೊರಗಿನ ಕೆಲಸವನ್ನು ಕ್ರಮವಾಗಿ ಇರಿಸು.</para>
  <para style="q2" vid="PRO 24:27">ನಿನ್ನ ಹೊಲಗಳನ್ನು ಸಿದ್ಧಪಡಿಸು;</para>
  <para style="q2" vid="PRO 24:27">ತರುವಾಯ ನಿನ್ನ ಮನೆಯನ್ನು ಕಟ್ಟಿಕೋ.<verse eid="PRO 24:27"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 24:28"/>ಕಾರಣವಿಲ್ಲದೆ ನೆರೆಯವನಿಗೆ ವಿರುದ್ಧವಾಗಿ ಸಾಕ್ಷಿ ಹೇಳಬೇಡ;</para>
  <para style="q2" vid="PRO 24:28">ನಿನ್ನ ಮಾತುಗಳಿಂದ ಅವನಿಗೆ ಮೋಸ ಮಾಡಬೇಡ.<verse eid="PRO 24:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 24:29"/>ನನಗೆ, “ಅವನು ಮಾಡಿದಂತೆ ನಾನೂ ಅವನಿಗೆ ಮಾಡುವೆನು;</para>
  <para style="q2" vid="PRO 24:29">ಅವನು ಮಾಡಿದ್ದಕ್ಕೆ ಸರಿಯಾಗಿ ಮುಯ್ಯಿತೀರಿಸುವೆನು,” ಎಂದು ಹೇಳಬೇಡ.<verse eid="PRO 24:29"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="30" style="v" sid="PRO 24:30"/>ನಾನು ಸೋಮಾರಿಯ ಹೊಲದ ಪಕ್ಕದಲ್ಲಿ</para>
  <para style="q2" vid="PRO 24:30">ಬುದ್ಧಿಹೀನನ ದ್ರಾಕ್ಷಿತೋಟದ ಕಡೆಯಲ್ಲಿ ಹಾದು ಹೋದೆನು.<verse eid="PRO 24:30"/></para>
  <para style="q1">
    <verse number="31" style="v" sid="PRO 24:31"/>ಆಗ ಇಗೋ, ಹೊಲವೆಲ್ಲವೂ ಮುಳ್ಳು ಗಿಡಗಳಿಂದ ಬೆಳೆದು</para>
  <para style="q2" vid="PRO 24:31">ಕಳೆಗಳು ಅವುಗಳನ್ನು ಮುಚ್ಚಿ</para>
  <para style="q2" vid="PRO 24:31">ಅದರ ಕಲ್ಲಿನ ಗೋಡೆಯು ಬಿದ್ದುಹೋಗಿತ್ತು.<verse eid="PRO 24:31"/></para>
  <para style="q1">
    <verse number="32" style="v" sid="PRO 24:32"/>ಆಗ ನಾನು ಅದನ್ನು ನೋಡಿ ಚಿಂತಿಸತೊಡಗಿದೆ;</para>
  <para style="q2" vid="PRO 24:32">ನಾನು ಕಂಡದ್ದರಿಂದ ಪಾಠ ಕಲಿತೆನು.<verse eid="PRO 24:32"/></para>
  <para style="q1">
    <verse number="33" style="v" sid="PRO 24:33"/>ಇನ್ನು ಸ್ವಲ್ಪ ನಿದ್ರೆ, ಇನ್ನು ಸ್ವಲ್ಪ ತೂಕಡಿಕೆ,</para>
  <para style="q2" vid="PRO 24:33">ಇನ್ನು ಸ್ವಲ್ಪ ವಿಶ್ರಾಂತಿಗಾಗಿ ಕೈ ಮುದುರಿಕೊಳ್ಳುವೆ ಎನ್ನುವೆಯಾ?<verse eid="PRO 24:33"/></para>
  <para style="q1">
    <verse number="34" style="v" sid="PRO 24:34"/>ಹೀಗೆ ನಿನಗೆ ಬಡತನವು ಕಳ್ಳನಂತೆಯೂ</para>
  <para style="q2" vid="PRO 24:34">ಕೊರತೆಯು ಶಸ್ತ್ರಧಾರಿಯಂತೆಯೂ ನಿನ್ನ ಮೇಲೆ ಬರುವುವು.<verse eid="PRO 24:34"/></para>
  <chapter eid="PRO 24"/>
  <chapter number="25" style="c" sid="PRO 25"/>
  <para style="ms1">ಮತ್ತಷ್ಟು ಸೊಲೊಮೋನನ ಜ್ಞಾನೋಕ್ತಿಗಳು</para>
  <para style="p">
    <verse number="1" style="v" sid="PRO 25:1"/>ಯೆಹೂದದ ಅರಸನಾದ ಹಿಜ್ಕೀಯನ ಲೇಖಕರು ಬರೆದಿರುವ ಇವು ಕೂಡ ಸೊಲೊಮೋನನ ಜ್ಞಾನೋಕ್ತಿಗಳೇ.<verse eid="PRO 25:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 25:2"/>ವಿಷಯವನ್ನು ರಹಸ್ಯ ಮಾಡುವುದು ದೇವರ ಮಹಿಮೆ.</para>
  <para style="q2" vid="PRO 25:2">ಒಂದು ವಿಷಯವನ್ನು ಹುಡುಕುವುದು ರಾಜರ ಮಹಿಮೆ.<verse eid="PRO 25:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 25:3"/>ಆಕಾಶದ ಎತ್ತರವನ್ನು, ಭೂಮಿಯ ಆಳವನ್ನು ಯಾರೂ ಗ್ರಹಿಸಲು ಸಾಧ್ಯವಿಲ್ಲ.</para>
  <para style="q2" vid="PRO 25:3">ಹಾಗೆಯೇ ಅರಸರ ಹೃದಯವು ಅಗೋಚರ.<verse eid="PRO 25:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 25:4"/>ಬೆಳ್ಳಿಯಿಂದ ಕಲ್ಮಷವನ್ನು ತೆಗೆದುಹಾಕಿದರೆ,</para>
  <para style="q2" vid="PRO 25:4">ಅಕ್ಕಸಾಲಿಗನಿಗೆ ಬೇಕಾದ ಪಾತ್ರೆಯು ರೂಪಗೊಳ್ಳುವುದು.<verse eid="PRO 25:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 25:5"/>ಅರಸನ ಸನ್ನಿಧಾನದಿಂದ ದುಷ್ಟರನ್ನು ತೆಗೆದುಹಾಕಿದರೆ,</para>
  <para style="q2" vid="PRO 25:5">ಆಗ ಅವನ ಸಿಂಹಾಸನವು ನೀತಿಯಲ್ಲಿ ಸ್ಥಿರವಾಗುವುದು.<verse eid="PRO 25:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 25:6"/>ಅರಸನ ಸನ್ನಿಧಿಯಲ್ಲಿ ನಿನ್ನನ್ನು ಹೆಚ್ಚಿಸಿಕೊಳ್ಳಬೇಡ;</para>
  <para style="q2" vid="PRO 25:6">ದೊಡ್ಡವರಿಗೆ ಏರ್ಪಡಿಸಿದ ಸ್ಥಾನವನ್ನು ಕೇಳಬೇಡ.<verse eid="PRO 25:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 25:7"/>ಘನವಂತರ ಸನ್ನಿಧಿಯಲ್ಲಿ ನಿನ್ನನ್ನು ತಗ್ಗಿಸಿಕೊಳ್ಳುವುದಕ್ಕಿಂತ,</para>
  <para style="q2" vid="PRO 25:7">“ಮೇಲಕ್ಕೆ ಬಾ,” ಎಂದು ಅರಸನು ನಿನಗೆ ಹೇಳುವುದು ಲೇಸು.</para>
  <para style="b" vid="PRO 25:7"/>
  <para style="q1" vid="PRO 25:7">ನೀವು ಏನನ್ನೋ ಕಂಡಿದ್ದರಿಂದ,<verse eid="PRO 25:7"/></para>
  <para style="q2">
    <verse number="8" style="v" sid="PRO 25:8"/>ದುಡುಕಿ ವ್ಯಾಜ್ಯಮಾಡುವುದಕ್ಕಾಗಿ ಹೋಗಬೇಡ.</para>
  <para style="q1" vid="PRO 25:8">ಏಕೆಂದರೆ ನಿನ್ನ ನೆರೆಯವನು ನಿನ್ನನ್ನು ಅವಮಾನ ಮಾಡಿದಾಗ,</para>
  <para style="q2" vid="PRO 25:8">ನೀನು ಕಡೆಯಲ್ಲಿ ಏನು ಮಾಡುವೆ?<verse eid="PRO 25:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 25:9"/>ನಿನ್ನ ನೆರೆಯವನೊಂದಿಗೆ ನಿನ್ನ ವ್ಯಾಜ್ಯವನ್ನು ಚರ್ಚಿಸು;</para>
  <para style="q2" vid="PRO 25:9">ಇನ್ನೊಬ್ಬರ ಗುಟ್ಟನ್ನು ಬಹಿರಂಗಪಡಿಸಬೇಡ,<verse eid="PRO 25:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 25:10"/>ಅದನ್ನು ಕೇಳುವವನು ನಿನ್ನನ್ನು ಅವಮಾನಕ್ಕೆ ಗುರಿಪಡಿಸಿಯಾನು;</para>
  <para style="q2" vid="PRO 25:10">ನಿನ್ನ ಅಪಕೀರ್ತಿಯು ಹೋಗದೆ ಇದ್ದೀತು.<verse eid="PRO 25:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 25:11"/>ಸಮಯೋಚಿತವಾದ ಮಾತು</para>
  <para style="q2" vid="PRO 25:11">ಬೆಳ್ಳಿಯ ಚಿತ್ರಗಳಲ್ಲಿ ಬಂಗಾರದ ಸೇಬಿನಂತಿದೆ.<verse eid="PRO 25:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 25:12"/>ಕೇಳುವ ಕಿವಿಗೆ ಜ್ಞಾನಿಯ ತಿದ್ದುವಿಕೆಯು ಬಂಗಾರದ ಮುರು;</para>
  <para style="q2" vid="PRO 25:12">ಚೊಕ್ಕ ಬಂಗಾರದ ಆಭರಣ.<verse eid="PRO 25:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 25:13"/>ಸುಗ್ಗಿಯ ಕಾಲದಲ್ಲಿ ಹಿಮದ ಶೀತದ ಹಾಗೆ</para>
  <para style="q2" vid="PRO 25:13">ತನ್ನನ್ನು ಕಳುಹಿಸುವವರಿಗೆ ನಂಬಿಗಸ್ತನಾದ ಸೇವಕನಿದ್ದಾನೆ;</para>
  <para style="q2" vid="PRO 25:13">ಏಕೆಂದರೆ ತನ್ನ ಯಜಮಾನರ ಪ್ರಾಣವನ್ನು ಅವನು ನವಚೈತನ್ಯಗೊಳಿಸುತ್ತಾನೆ.<verse eid="PRO 25:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 25:14"/>ದಾನ ಕೊಡದೆ ಕೊಟ್ಟಿದ್ದೇನೆಂದು ಹೊಗಳಿಕೊಳ್ಳುವವನು,</para>
  <para style="q2" vid="PRO 25:14">ಮಳೆ ಇಲ್ಲದ ಮೋಡಗಳ ಮತ್ತು ಗಾಳಿಯ ಹಾಗೆ ಇದ್ದಾನೆ.<verse eid="PRO 25:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 25:15"/>ತಾಳ್ಮೆಯ ಮೂಲಕ ಪ್ರಭುವನ್ನು ಒಲಿಸಿಕೊಳ್ಳಬಹುದು;</para>
  <para style="q2" vid="PRO 25:15">ಮೃದುವಾದ ಮಾತು ಎಲುಬನ್ನು ಮುರಿಯುತ್ತದೆ.<verse eid="PRO 25:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 25:16"/>ಜೇನನ್ನು ಕಂಡುಕೊಂಡಿದ್ದೀಯಾ? ಅದನ್ನು ನಿನಗೆ ತೃಪ್ತಿಯಾಗುವಷ್ಟೇ ತಿನ್ನು;</para>
  <para style="q2" vid="PRO 25:16">ಹೊಟ್ಟೆ ತುಂಬಾ ತಿಂದರೆ ಕಾರಬೇಕಾದೀತು.<verse eid="PRO 25:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 25:17"/>ನಿನ್ನ ನೆರೆಯವನ ಮನೆಗೆ ಅಪರೂಪಕ್ಕೆ ಹೆಜ್ಜೆ ಇಡು;</para>
  <para style="q2" vid="PRO 25:17">ಇಲ್ಲವಾದರೆ ನಿನ್ನ ವಿಷಯವಾಗಿ ಅವನು ಬೇಸರಗೊಂಡು ನಿನ್ನನ್ನು ಹಗೆಮಾಡಾನು.<verse eid="PRO 25:17"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 25:18"/>ತನ್ನ ನೆರೆಯವನಿಗೆ ವಿರೋಧವಾಗಿ ಸುಳ್ಳುಸಾಕ್ಷಿ ಹೇಳುವವನು</para>
  <para style="q2" vid="PRO 25:18">ಚಮಟಿಗೆ, ಖಡ್ಗ, ಹರಿತವಾದ ಬಾಣವಾಗಿದ್ದಾನೆ.<verse eid="PRO 25:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 25:19"/>ಕಷ್ಟಕಾಲದಲ್ಲಿ ಅಪನಂಬಿಗಸ್ತನಾದ ಮನುಷ್ಯನಲ್ಲಿಯ</para>
  <para style="q2" vid="PRO 25:19">ಭರವಸೆಯು ಮುರಿದ ಹಲ್ಲು, ಕೀಲು ತಪ್ಪಿದ ಪಾದವು.<verse eid="PRO 25:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 25:20"/>ಮನಗುಂದಿದವನಿಗೆ ಸಂಗೀತ ಹಾಡುವುದು</para>
  <para style="q2" vid="PRO 25:20">ಚಳಿಯಲ್ಲಿ ಬಟ್ಟೆ ಬಿಚ್ಚಿದ ಹಾಗೆಯೂ</para>
  <para style="q2" vid="PRO 25:20">ಹುಳಿ ಉಪ್ಪನ್ನು ಗಾಯಕ್ಕೆ ಹಚ್ಚಿದಂತೆಯೂ.<verse eid="PRO 25:20"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 25:21"/>ನಿನ್ನ ಶತ್ರು ಹಸಿದಿದ್ದರೆ ಉಣ್ಣುವುದಕ್ಕೆ ಅವನಿಗೆ ಊಟಕೊಡು;</para>
  <para style="q2" vid="PRO 25:21">ಅವನು ಬಾಯಾರಿದ್ದರೆ ಕುಡಿಯುವುದಕ್ಕೆ ನೀರು ಕೊಡು.<verse eid="PRO 25:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 25:22"/>ಏಕೆಂದರೆ ಅದು ಅವನ ತಲೆಯ ಮೇಲೆ ಉರಿಯುವ ಬೆಂಕಿಯ ಕೆಂಡಗಳನ್ನು ಸುರಿಯುವಂತಿರುವುದು;</para>
  <para style="q2" vid="PRO 25:22">ಯೆಹೋವ ದೇವರು ನಿನಗೆ ಪ್ರತಿಫಲ ಕೊಡುವರು.<verse eid="PRO 25:22"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 25:23"/>ಅನಿರೀಕ್ಷಿತ ಮಳೆಯನ್ನು ತರುವ ಉತ್ತರದ ಗಾಳಿಯಂತೆ</para>
  <para style="q2" vid="PRO 25:23">ಚಾಡಿಯ ನಾಲಿಗೆ ಕೋಪದ ಮುಖ ಮಾಡುತ್ತದೆ.<verse eid="PRO 25:23"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 25:24"/>ಮನೆಯಲ್ಲಿ ಜಗಳಗಂಟಿಯೊಂದಿಗೆ ಇರುವುದಕ್ಕಿಂತ,</para>
  <para style="q2" vid="PRO 25:24">ಮಾಳಿಗೆಯ ಒಂದು ಮೂಲೆಯಲ್ಲಿ ವಾಸಿಸುವುದು ಲೇಸು.<verse eid="PRO 25:24"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 25:25"/>ಬಾಯಾರಿದವನಿಗೆ ತಣ್ಣೀರು ಹೇಗೋ</para>
  <para style="q2" vid="PRO 25:25">ದೂರದೇಶದಿಂದ ಬಂದ ಒಳ್ಳೆಯ ಸಮಾಚಾರವು ಹಾಗೆಯೇ.<verse eid="PRO 25:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 25:26"/>ದುಷ್ಟರ ಮುಂದೆ ನೀತಿವಂತನು ಸೋಲುವುದು, ಕೆಸರಿನ ಬುಗ್ಗೆಗೂ</para>
  <para style="q2" vid="PRO 25:26">ಕೊಳಕು ಒರತೆಗೂ ಸಮಾನ.<verse eid="PRO 25:26"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 25:27"/>ಜೇನನ್ನು ಹೆಚ್ಚಾಗಿ ತಿನ್ನುವುದು ಹಿತವಲ್ಲ;</para>
  <para style="q2" vid="PRO 25:27">ಹಾಗೆಯೇ ಮನುಷ್ಯರು ಸ್ವಂತ ಗೌರವವನ್ನು ಹುಡುಕುವುದು ಗೌರವವಲ್ಲ.<verse eid="PRO 25:27"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 25:28"/>ತನ್ನ ಸ್ವಂತ ಆತ್ಮವನ್ನು ಆಳದಿರುವವನು,</para>
  <para style="q2" vid="PRO 25:28">ಗೋಡೆ ಬಿದ್ದ ಹಾಳೂರಿಗೆ ಸಮಾನ.<verse eid="PRO 25:28"/></para>
  <chapter eid="PRO 25"/>
  <chapter number="26" style="c" sid="PRO 26"/>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 26:1"/>ಬೇಸಿಗೆಯಲ್ಲಿ ಹಿಮದಂತೆಯೂ,</para>
  <para style="q2" vid="PRO 26:1">ಸುಗ್ಗಿಯಲ್ಲಿ ಮಳೆಯಂತೆಯೂ ಬುದ್ಧಿಹೀನನಿಗೆ ಮಾನವು ಸರಿಯಲ್ಲ.<verse eid="PRO 26:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 26:2"/>ಅಲೆದಾಡುವ ಪಕ್ಷಿಯಂತೆಯೂ,</para>
  <para style="q2" vid="PRO 26:2">ಹಾರಾಡುವ ಬಾನಕ್ಕಿಯಂತೆಯೂ ಕಾರಣವಿಲ್ಲದೆ ಕೊಡುವ ಶಾಪವು ತಗಲದು.<verse eid="PRO 26:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 26:3"/>ಕುದುರೆಗೆ ಬಾರುಗೋಲು, ಕತ್ತೆಗೆ ಕಡಿವಾಣವು,</para>
  <para style="q2" vid="PRO 26:3">ಮೂಢನ ಬೆನ್ನಿಗೆ ಬೆತ್ತ.<verse eid="PRO 26:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 26:4"/>ಮೂಢನ ಮೂರ್ಖತನಕ್ಕೆ ತಕ್ಕಂತೆ ಉತ್ತರಿಸಬೇಡ;</para>
  <para style="q2" vid="PRO 26:4">ಇಲ್ಲವಾದರೆ ನೀನೂ ಅವನಿಗೆ ಸಮಾನನಾದೀಯೆ.<verse eid="PRO 26:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 26:5"/>ಮೂಢನ ಮೂರ್ಖತನಕ್ಕೆ ತಕ್ಕಂತೆ ಉತ್ತರಕೊಡು;</para>
  <para style="q2" vid="PRO 26:5">ಇಲ್ಲವಾದರೆ ತನ್ನನ್ನು ಜ್ಞಾನಿಯೆಂದು ಎಣಿಸಿಕೊಂಡಾನು.<verse eid="PRO 26:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 26:6"/>ಬುದ್ಧಿಹೀನನ ಮೂಲಕ ವರ್ತಮಾನ ಕಳುಹಿಸುವವನು</para>
  <para style="q2" vid="PRO 26:6">ತನ್ನ ಪಾದಗಳನ್ನು ತಾನೇ ಕಡಿದುಕೊಂಡು ಇಲ್ಲವೆ ಕೇಡನ್ನು ಕುಡಿಯುತ್ತಾನೆ.<verse eid="PRO 26:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 26:7"/>ಕುಂಟನ ಕಾಲುಗಳು ಜೋಲಾಡುವ ಹಾಗೆಯೇ,</para>
  <para style="q2" vid="PRO 26:7">ಬುದ್ಧಿಹೀನರ ಬಾಯಲ್ಲಿ ಜ್ಞಾನೋಕ್ತಿಯು ಇರುತ್ತದೆ.<verse eid="PRO 26:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 26:8"/>ಮೂಢನಿಗೆ ಕೊಡುವ ಮಾನವು</para>
  <para style="q2" vid="PRO 26:8">ಕವಣಿಯಲ್ಲಿಟ್ಟ ಕಲ್ಲಿನ ಹಾಗೆ.<verse eid="PRO 26:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 26:9"/>ಕುಡುಕನ ಕೈಯಲ್ಲಿ ಮುಳ್ಳು ಕೋಲಿನಂತೆ</para>
  <para style="q2" vid="PRO 26:9">ಬುದ್ಧಿಹೀನರ ಬಾಯಲ್ಲಿ ಜ್ಞಾನೋಕ್ತಿಯು ಇರುವುದು.<verse eid="PRO 26:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 26:10"/>ಮೂಢರನ್ನೂ ದಾರಿಹೋಕರನ್ನೂ ಕೂಲಿಗೆ ಕರೆಯುವವನು</para>
  <para style="q2" vid="PRO 26:10">ಯಾರಿಗಾದರೂ ತಗಲಲಿ ಎಂದು ಬಾಣ ಎಸೆಯುವ ಬಿಲ್ಲುಗಾರನಂತೆ.<verse eid="PRO 26:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 26:11"/>ತಾನು ಕಕ್ಕಿದ್ದಕ್ಕೆ ನಾಯಿಯು ತಿರುಗುವಂತೆ ಮೂಢನು</para>
  <para style="q2" vid="PRO 26:11">ತನ್ನ ಮೂಢತನಕ್ಕೆ ಹಿಂದಿರುಗುತ್ತಾನೆ.<verse eid="PRO 26:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 26:12"/>ತನ್ನ ಸ್ವಂತ ಅಭಿಪ್ರಾಯದಲ್ಲಿ ಜ್ಞಾನಿಯಾದವನನ್ನು ನೀನು ಕಾಣುತ್ತಿದ್ದೀಯೋ?</para>
  <para style="q2" vid="PRO 26:12">ಅವನಿಗಿಂತ ಮೂಢನ ವಿಷಯದಲ್ಲಿ ಹೆಚ್ಚು ನಿರೀಕ್ಷೆಯು ಇರುತ್ತದೆ.<verse eid="PRO 26:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 26:13"/>ಸೋಮಾರಿಯು, “ದಾರಿಯಲ್ಲಿ ಸಿಂಹವಿದೆ,</para>
  <para style="q2" vid="PRO 26:13">ಬೀದಿಗಳಲ್ಲಿ ಭೀಕರ ಸಿಂಹ ಇದೆ,” ಎಂದು ಹೇಳುತ್ತಾನೆ.<verse eid="PRO 26:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 26:14"/>ಬಾಗಿಲು ತಿರುಗುಣಿಗಳ ಮೇಲೆ ಹೇಗೆ ತಿರುಗುತ್ತದೋ,</para>
  <para style="q2" vid="PRO 26:14">ಹಾಗೆಯೇ ಸೋಮಾರಿಯು ತನ್ನ ಹಾಸಿಗೆಯ ಮೇಲೆ ಹೊರಳಾಡುತ್ತಾನೆ.<verse eid="PRO 26:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 26:15"/>ಸೋಮಾರಿಯು ತಟ್ಟೆಯಲ್ಲಿ ತನ್ನ ಕೈಯನ್ನು ಹಾಕಿ,</para>
  <para style="q2" vid="PRO 26:15">ತಿರುಗಿ ಅದನ್ನು ತನ್ನ ಬಾಯಿಗೆ ತರಲಾರದಷ್ಟು ಆಯಾಸಪಡುತ್ತಾನೆ.<verse eid="PRO 26:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 26:16"/>ಜ್ಞಾನದಿಂದ ಉತ್ತರಿಸಬಲ್ಲ ಏಳು ಜನರಿಗಿಂತ,</para>
  <para style="q2" vid="PRO 26:16">ತಾನೇ ಜ್ಞಾನಿ ಎಂದು ಸೋಮಾರಿಯು ಭಾವಿಸುತ್ತಾನೆ.<verse eid="PRO 26:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 26:17"/>ಒಬ್ಬನು ಹಾದುಹೋಗುತ್ತಾ ತನಗೆ ಸಂಬಂಧಿಸದೇ ಇರುವ ವ್ಯಾಜ್ಯದಲ್ಲಿ</para>
  <para style="q2" vid="PRO 26:17">ತಲೆಹಾಕುವವನು ನಾಯಿಯ ಕಿವಿ ಹಿಡಿದವನಂತೆ ಇದ್ದಾನೆ.<verse eid="PRO 26:17"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="18-19" style="v" sid="PRO 26:18-19"/>ತನ್ನ ನೆರೆಯವನನ್ನು ಮೋಸಗೊಳಿಸಿ,</para>
  <para style="q2" vid="PRO 26:18-19">“ಇದು ತಮಾಷೆಗೋಸ್ಕರ ಮಾಡುತ್ತೇನೆ,” ಎಂದು ಹೇಳುವವನು,</para>
  <para style="q1" vid="PRO 26:18-19">ಕೊಳ್ಳಿಗಳನ್ನೂ, ಬಾಣಗಳನ್ನೂ,</para>
  <para style="q2" vid="PRO 26:18-19">ಸಾವನ್ನೂ ಬೀರುವ ಹುಚ್ಚನಂತೆಯೇ.<verse eid="PRO 26:18-19"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 26:20"/>ಕಟ್ಟಿಗೆ ಇಲ್ಲದಿರುವಲ್ಲಿ ಬೆಂಕಿಯು ಆರಿಹೋಗುತ್ತದೆ;</para>
  <para style="q2" vid="PRO 26:20">ಹಾಗೆಯೇ ಚಾಡಿಕೋರನು ಇಲ್ಲದಿರುವಲ್ಲಿ ಜಗಳ ಶಮನವಾಗುವುದು.<verse eid="PRO 26:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 26:21"/>ಕೆಂಡಗಳಿಗೆ ಇದ್ದಲು, ಬೆಂಕಿಗೆ ಕಟ್ಟಿಗೆ;</para>
  <para style="q2" vid="PRO 26:21">ಹಾಗೆಯೇ ಜಗಳವನ್ನು ಕೆರಳಿಸುವಂತೆ ಕಲಹ ಮಾಡುವವನು ಇರುವನು.<verse eid="PRO 26:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 26:22"/>ಚಾಡಿಕೋರನ ಮಾತುಗಳು ರುಚಿಕರ ಭಕ್ಷ್ಯದ</para>
  <para style="q2" vid="PRO 26:22">ಹಾಗೆ ಹೊಟ್ಟೆಯ ಅಂತರ್ಭಾಗಗಳಿಗೆ ಇಳಿಯುತ್ತವೆ.<verse eid="PRO 26:22"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 26:23"/>ಕೆಟ್ಟ ಹೃದಯದಿಂದ ಸವಿನುಡಿಯುವ ತುಟಿಯು,</para>
  <para style="q2" vid="PRO 26:23">ಬೆಳ್ಳಿಯ ಹೊದಿಕೆಯಿಂದ ಮುಚ್ಚಲ್ಪಟ್ಟ ಬೋಕಿಯಂತೆ ಇದೆ.<verse eid="PRO 26:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 26:24"/>ಶತ್ರುಗಳು ತಮ್ಮ ತುಟಿಗಳಿಂದ ವೇಷ ಧರಿಸುತ್ತಾರೆ,</para>
  <para style="q2" vid="PRO 26:24">ತನ್ನ ಅಂತರಂಗದಲ್ಲಿ ಮೋಸವನ್ನು ಇಟ್ಟುಕೊಳ್ಳುತ್ತಾರೆ.<verse eid="PRO 26:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 26:25"/>ಸವಿಮಾತನ್ನಾಡಿದರೆ ಅವನನ್ನು ನಂಬಬೇಡ;</para>
  <para style="q2" vid="PRO 26:25">ಏಕೆಂದರೆ ಅವನ ಹೃದಯದಲ್ಲಿ ಏಳು ಅಸಹ್ಯ ಕಾರ್ಯಗಳಿವೆ.<verse eid="PRO 26:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 26:26"/>ಅವನ ಹಗೆತನವು ಮೋಸದಿಂದ ಮುಚ್ಚಲ್ಪಟ್ಟಿದ್ದರೂ,</para>
  <para style="q2" vid="PRO 26:26">ಅವನ ಕೆಟ್ಟತನವು ಸಭೆಯಲ್ಲಿ ಬಯಲಾಗುವುದು.<verse eid="PRO 26:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 26:27"/>ಗುಂಡಿಯನ್ನು ತೋಡುವವನು ತಾನೇ ಅದರಲ್ಲಿ ಬೀಳುತ್ತಾನೆ;</para>
  <para style="q2" vid="PRO 26:27">ಕಲ್ಲು ಹೊರಳಿಸುವವನ ಮೇಲೆಯೇ ಅದು ತಿರುಗಿ ಹೊರಳುವುದು.<verse eid="PRO 26:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 26:28"/>ಸುಳ್ಳು ನಾಲಿಗೆಯವನು ತಾನು ಬಾಧಿಸಿದವರನ್ನೇ ಹಗೆ ಮಾಡುವನು;</para>
  <para style="q2" vid="PRO 26:28">ಮುಖಸ್ತುತಿ ಮಾಡುವ ಬಾಯಿಯು ನಾಶವನ್ನುಂಟುಮಾಡುತ್ತದೆ.<verse eid="PRO 26:28"/></para>
  <para style="b"/>
  <chapter eid="PRO 26"/>
  <chapter number="27" style="c" sid="PRO 27"/>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 27:1"/>ನಾಳೆಯ ವಿಷಯವಾಗಿ ಕೊಚ್ಚಿಕೊಳ್ಳಬೇಡ;</para>
  <para style="q2" vid="PRO 27:1">ಏಕೆಂದರೆ ಒಂದು ದಿನದೊಳಗೆ ಏನಾಗುವುದೋ ನಿನಗೆ ತಿಳಿಯದು.<verse eid="PRO 27:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 27:2"/>ನಿನ್ನ ಬಾಯಿ ಅಲ್ಲ, ಮತ್ತೊಬ್ಬನು ನಿನ್ನನ್ನು ಹೊಗಳಲಿ;</para>
  <para style="q2" vid="PRO 27:2">ನಿನ್ನ ಸ್ವಂತ ತುಟಿಗಳಲ್ಲ, ಪರನೇ ನಿನ್ನನ್ನು ಹೊಗಳಲಿ.<verse eid="PRO 27:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 27:3"/>ಕಲ್ಲು ಭಾರ, ಮರಳು ಭಾರ;</para>
  <para style="q2" vid="PRO 27:3">ಆದರೆ ಇವೆರಡಕ್ಕಿಂತ ಮೂಢನ ಕೋಪವು ಬಹು ಭಾರ.<verse eid="PRO 27:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 27:4"/>ಕ್ರೋಧವು ಕ್ರೂರ, ಕೋಪವು ಪ್ರವಾಹ;</para>
  <para style="q2" vid="PRO 27:4">ಆದರೆ ಅಸೂಯೆದ ಮುಂದೆ ಯಾವನು ನಿಂತಾನು?<verse eid="PRO 27:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 27:5"/>ರಹಸ್ಯವಾದ ಪ್ರೀತಿಗಿಂತಲೂ</para>
  <para style="q2" vid="PRO 27:5">ಬಹಿರಂಗವಾದ ಗದರಿಕೆಯೇ ಲೇಸು.<verse eid="PRO 27:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 27:6"/>ಸ್ನೇಹಿತನು ಮಾಡುವ ಗಾಯಗಳು ಭರವಸೆಗೆ ಯೋಗ್ಯವಾದದ್ದು;</para>
  <para style="q2" vid="PRO 27:6">ಆದರೆ ಶತ್ರುವಿನ ಮುದ್ದುಗಳು ಹೇರಳವಾಗಿವೆ.<verse eid="PRO 27:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 27:7"/>ತೃಪ್ತಿ ಹೊಂದಿದವನು ಜೇನುತುಪ್ಪವನ್ನೂ ಅಸಹ್ಯಿಸಿಕೊಳ್ಳುತ್ತಾನೆ;</para>
  <para style="q2" vid="PRO 27:7">ಆದರೆ ಹಸಿದವನಿಗೆ ಕಹಿಯಾದ ಪ್ರತಿಯೊಂದು ವಸ್ತುವು ಸಿಹಿಯಾಗಿದೆ.<verse eid="PRO 27:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 27:8"/>ತನ್ನ ಮನೆಯನ್ನು ಬಿಟ್ಟು ಅಲೆಯುವ ಮನುಷ್ಯನು</para>
  <para style="q2" vid="PRO 27:8">ತನ್ನ ಗೂಡನ್ನು ಬಿಟ್ಟು ಅಲೆಯುವ ಪಕ್ಷಿಯಂತೆ ಇದ್ದಾನೆ.<verse eid="PRO 27:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 27:9"/>ತೈಲವೂ ಸುಗಂಧದ್ರವ್ಯವೂ ಹೃದಯವನ್ನು ಸಂತೋಷಪಡಿಸುವ ಹಾಗೆ,</para>
  <para style="q2" vid="PRO 27:9">ಆದರಣೆಯ ಸಲಹೆಯೂ ಸ್ನೇಹಿತನಿಗೆ ಮಧುರವಾಗಿರುತ್ತದೆ.<verse eid="PRO 27:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 27:10"/>ನಿನ್ನ ಸ್ನೇಹಿತನನ್ನೂ ನಿನ್ನ ತಂದೆಯ ಸ್ನೇಹಿತನನ್ನೂ ತ್ಯಜಿಸಬೇಡ;</para>
  <para style="q2" vid="PRO 27:10">ಅಲ್ಲದೆ ನಿನ್ನ ಇಕ್ಕಟ್ಟಿನ ದಿನದಲ್ಲಿ ನಿನ್ನ ಸಹೋದರನ ಮನೆಗೆ ಹೋಗಬೇಡ;</para>
  <para style="q2" vid="PRO 27:10">ಏಕೆಂದರೆ ದೂರವಾಗಿರುವ ಸಹೋದರನಿಗಿಂತ ಹತ್ತಿರವಾಗಿರುವ ನೆರೆಯವನೇ ಲೇಸು.<verse eid="PRO 27:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 27:11"/>ನನ್ನನ್ನು ನಿಂದಿಸುವವರಿಗೆ ನಾನು ಉತ್ತರಿಸುವಂತೆಯೂ,</para>
  <para style="q2" vid="PRO 27:11">ನನ್ನ ಹೃದಯವನ್ನು ಸಂತೋಷಪಡಿಸುವಂತೆಯೂ, ನನ್ನ ಮಗುವೇ, ಜ್ಞಾನಿಯಾಗಿರು.<verse eid="PRO 27:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 27:12"/>ಜಾಣನು ಕೇಡನ್ನು ಮುಂದಾಗಿ ಕಂಡು ಅಡಗಿಕೊಳ್ಳುತ್ತಾನೆ;</para>
  <para style="q2" vid="PRO 27:12">ಆದರೆ ಮುಗ್ಧನು ಮುಂದೆ ಹೋಗಿ ಹಾನಿಗೆ ಈಡಾಗುತ್ತಾನೆ.<verse eid="PRO 27:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 27:13"/>ಅಪರಿಚಿತನಿಗೆ ಭದ್ರತೆಯನ್ನು ನೀಡುವವನ ವಸ್ತ್ರವನ್ನು ತೆಗೆದುಕೋ;</para>
  <para style="q2" vid="PRO 27:13">ವಿದೇಶಿಯರಿಗೆ ಇದನ್ನು ಮಾಡಿದರೆ ಅದನ್ನು ಒತ್ತೆ ಇಟ್ಟುಕೋ.<verse eid="PRO 27:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 27:14"/>ಮುಂಜಾನೆ ಎದ್ದು ತನ್ನ ಸ್ನೇಹಿತನನ್ನು ದೊಡ್ಡ ಕೂಗಿನಿಂದ ಆಶೀರ್ವದಿಸುವವನಿಗೆ,</para>
  <para style="q2" vid="PRO 27:14">ಅದು ಶಾಪವೆಂದು ಪರಿಗಣಿಸಲಾಗುವುದು.<verse eid="PRO 27:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 27:15"/>ಜಗಳ ಮಾಡುವ ಹೆಂಡತಿಯು</para>
  <para style="q2" vid="PRO 27:15">ಮಳೆಗಾಲದಲ್ಲಿ ಸೋರುವ ಛಾವಣಿಯಂತಿದೆ.<verse eid="PRO 27:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 27:16"/>ಅವಳನ್ನು ಅಡಗಿಸುವುದು, ಗಾಳಿಯನ್ನು ಅಡಗಿಸಿದಂತೆ;</para>
  <para style="q2" vid="PRO 27:16">ಕೈಯಿಂದ ಎಣ್ಣೆಯನ್ನು ಹಿಡಿದಂತೆ.<verse eid="PRO 27:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 27:17"/>ಕಬ್ಬಿಣವು ಕಬ್ಬಿಣವನ್ನು ಹರಿತ ಮಾಡುವಂತೆ</para>
  <para style="q2" vid="PRO 27:17">ಒಬ್ಬನು ಮತ್ತೊಬ್ಬನನ್ನು ಹರಿತ ಮಾಡುವನು.<verse eid="PRO 27:17"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 27:18"/>ಅಂಜೂರದ ಮರವನ್ನು ಕಾಯುವವನು ಅದರ ಫಲವನ್ನು ತಿನ್ನುವನು;</para>
  <para style="q2" vid="PRO 27:18">ಹಾಗೆಯೇ ಯಜಮಾನನಿಗಾಗಿ ಕಾಯುವವನು ಸನ್ಮಾನ ಹೊಂದುವನು.<verse eid="PRO 27:18"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 27:19"/>ನೀರಿನಲ್ಲಿ ಮುಖವು ಪ್ರತಿಬಿಂಬಿಸುವಂತೆ ಮನುಷ್ಯನ ಜೀವನವು</para>
  <para style="q2" vid="PRO 27:19">ಅವನ ಹೃದಯವನ್ನು ಪ್ರತಿಬಿಂಬಿಸುತ್ತದೆ.<note caller="+" style="f"><char style="fr" closed="false">27:19 </char><char style="ft" closed="false">ಆದ್ದರಿಂದ ಇತರರು ನಿಮ್ಮ ಹೃದಯವನ್ನು ನಿಮಗೆ ಹಿಂದಿರುಗಿಸುತ್ತಾರೆ</char></note><verse eid="PRO 27:19"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 27:20"/>ಪಾತಾಳಕ್ಕೂ ವಿನಾಶಕ್ಕೂ ತೃಪ್ತಿ ಇಲ್ಲವೇ ಇಲ್ಲ;</para>
  <para style="q2" vid="PRO 27:20">ಹಾಗೆಯೇ, ಮನುಷ್ಯನ ಕಣ್ಣುಗಳು ಎಂದಿಗೂ ತೃಪ್ತಿಹೊಂದುವುದಿಲ್ಲ.<verse eid="PRO 27:20"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 27:21"/>ಬೆಳ್ಳಿ, ಬಂಗಾರಗಳ ಪುಟಕ್ಕೆ ಕುಲುಮೆ ಹೇಗೆಯೋ,</para>
  <para style="q2" vid="PRO 27:21">ಹಾಗೆಯೇ ಹೊಗಳಿಕೆಯು ಮನುಷ್ಯನನ್ನು ಪರೀಕ್ಷಿಸುತ್ತದೆ.<verse eid="PRO 27:21"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 27:22"/>ಬುದ್ಧಿಹೀನನನ್ನು ಒರಳಿನಲ್ಲಿ ಗೋಧಿಯೊಂದಿಗೆ ಹಾಕಿ,</para>
  <para style="q2" vid="PRO 27:22">ಒಣಕೆಯಿಂದ ಕುಟ್ಟಿದರೂ,</para>
  <para style="q2" vid="PRO 27:22">ಅವನಿಂದ ಮೂರ್ಖನತವು ತೊಲಗುವುದಿಲ್ಲ.<verse eid="PRO 27:22"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 27:23"/>ನಿನ್ನ ಹಿಂಡುಗಳ ಸ್ಥಿತಿಯನ್ನು ತಿಳಿದುಕೊಳ್ಳುವಂತೆ ಶ್ರದ್ಧೆವಹಿಸು;</para>
  <para style="q2" vid="PRO 27:23">ನಿನ್ನ ಮಂದೆಗಳನ್ನು ಚೆನ್ನಾಗಿ ನೋಡಿಕೋ.<verse eid="PRO 27:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 27:24"/>ಐಶ್ವರ್ಯವು ಶಾಶ್ವತವಲ್ಲ;</para>
  <para style="q2" vid="PRO 27:24">ಕಿರೀಟವು ತಲತಲಾಂತರಕ್ಕೂ ಇರುವುದಿಲ್ಲ.<verse eid="PRO 27:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 27:25"/>ಒಣಹುಲ್ಲನ್ನು ಕೊಯ್ದು ನಂತರ ಹೊಸ ಬೆಳೆ ಕಾಣಿಸಿಕೊಂಡಾಗ</para>
  <para style="q2" vid="PRO 27:25">ಮತ್ತು ಬೆಟ್ಟಗಳಿಂದ ಹುಲ್ಲು ಸಂಗ್ರಹಿಸಿದಾಗ,<verse eid="PRO 27:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 27:26"/>ಆಗ ಕುರಿಮರಿಗಳು ನಿಮಗೆ ಬಟ್ಟೆಗಳನ್ನು ಒದಗಿಸುತ್ತವೆ,</para>
  <para style="q2" vid="PRO 27:26">ಆಡುಗಳ ಬೆಲೆಗೆ ನೀವು ಹೊಲವನ್ನು ಖರೀದಿಸಬಹುದು,<verse eid="PRO 27:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 27:27"/>ನಿನ್ನ ಊಟಕ್ಕಾಗಿಯೂ, ನಿನ್ನ ಮನೆಯವರ ಆಹಾರಕ್ಕಾಗಿಯೂ</para>
  <para style="q2" vid="PRO 27:27">ನಿನ್ನ ದಾಸಿಯರ ಜೀವನಕ್ಕಾಗಿಯೂ ಬೇಕಾದಷ್ಟು ಆಡುಗಳ ಹಾಲು ಸಾಕಾಗುತ್ತದೆ.<verse eid="PRO 27:27"/></para>
  <para style="b"/>
  <chapter eid="PRO 27"/>
  <chapter number="28" style="c" sid="PRO 28"/>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 28:1"/>ಹಿಂದಟ್ಟುವವನು ಇಲ್ಲದಿದ್ದರೂ ದುಷ್ಟನು ಓಡಿಹೋಗುತ್ತಾನೆ.</para>
  <para style="q2" vid="PRO 28:1">ಆದರೆ ಸಿಂಹದ ಹಾಗೆ ನೀತಿವಂತರು ಧೈರ್ಯದಿಂದ ಇರುತ್ತಾರೆ.<verse eid="PRO 28:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 28:2"/>ದೇಶದ ದಂಗೆಯಿಂದ ಅನೇಕರು ನಾಯಕರಾಗುತ್ತಾರೆ.</para>
  <para style="q2" vid="PRO 28:2">ಆದರೆ ಒಳನೋಟ ಹಾಗು ತಿಳುವಳಿಕೆಯ ನಾಯಕನಿಂದಲೇ ದೇಶವು ಸುಸ್ಥಿರವಾಗುವುದು.<verse eid="PRO 28:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 28:3"/>ಬಡವರನ್ನು ಹಿಂಸಿಸುವ ಅಧಿಕಾರಿಯು</para>
  <para style="q2" vid="PRO 28:3">ಆಹಾರವನ್ನು ಉಳಿಸದಂತೆ ಸುರಿಯುವ ಮಳೆಯಂತಿದ್ದಾನೆ.<verse eid="PRO 28:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 28:4"/>ಬೋಧನೆಯನ್ನು ತ್ಯಜಿಸುವವರು ದುಷ್ಟರನ್ನು ಹೊಗಳುತ್ತಾರೆ;</para>
  <para style="q2" vid="PRO 28:4">ಆದರೆ ಬೋಧನೆಯನ್ನು ಕೈಗೊಳ್ಳುವವರು ಅವರೊಂದಿಗೆ ಹೋರಾಡುತ್ತಾರೆ.<verse eid="PRO 28:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 28:5"/>ನ್ಯಾಯವನ್ನು ದುಷ್ಟರು ಗ್ರಹಿಸುವುದಿಲ್ಲ;</para>
  <para style="q2" vid="PRO 28:5">ಆದರೆ ಯೆಹೋವ ದೇವರನ್ನು ಹುಡುಕುವವರು ಎಲ್ಲವುಗಳನ್ನು ಗ್ರಹಿಸುತ್ತಾರೆ.<verse eid="PRO 28:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 28:6"/>ಐಶ್ವರ್ಯವಂತನಾಗಿದ್ದರೂ ತನ್ನ ಮಾರ್ಗದಲ್ಲಿ ವಕ್ರವಾಗಿರುವವನಿಗಿಂತ</para>
  <para style="q2" vid="PRO 28:6">ನಿರ್ದೋಷಿಯಾಗಿ ನಡೆಯುವ ದರಿದ್ರನು ಶ್ರೇಷ್ಠನು.<verse eid="PRO 28:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 28:7"/>ವಿವೇಚನೆಯ ಮಗನು ದೇವರ ಶಿಕ್ಷಣವನ್ನು ಕೈಗೊಳ್ಳುವನು.</para>
  <para style="q2" vid="PRO 28:7">ಆದರೆ ಹೊಟ್ಟೆಬಾಕರ ಸಂಗಡಿಗನು ತನ್ನ ತಂದೆಯನ್ನು ಅವಮಾನಪಡಿಸುತ್ತಾನೆ.<verse eid="PRO 28:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 28:8"/>ಬಡ್ಡಿಯಿಂದಲೂ ಅನ್ಯಾಯದ ಲಾಭದಿಂದಲೂ ತನ್ನ ಆಸ್ತಿಯನ್ನು ವೃದ್ಧಿಗೊಳಿಸುವವನು,</para>
  <para style="q2" vid="PRO 28:8">ಬಡವರ ಮೇಲೆ ದಯೆ ತೋರಿಸುವವನಿಗೆ ಅದನ್ನು ಕೂಡಿಸುವನು.<verse eid="PRO 28:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 28:9"/>ಶಿಕ್ಷಣವನ್ನು ಕೇಳದಂತೆ ತನ್ನ ಕಿವಿ ಮುಚ್ಚಿಕೊಳ್ಳುವವನ</para>
  <para style="q2" vid="PRO 28:9">ಪ್ರಾರ್ಥನೆಯು ದೇವರಿಗೆ ಅಸಹ್ಯ.<verse eid="PRO 28:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 28:10"/>ಪ್ರಾಮಾಣಿಕರನ್ನು ದುರ್ಮಾರ್ಗದಲ್ಲಿ ದಾರಿತಪ್ಪಿಸುವವನು,</para>
  <para style="q2" vid="PRO 28:10">ತಾನೇ ತೋಡಿದ ಗುಂಡಿಯಲ್ಲಿ ಬೀಳುವನು.</para>
  <para style="q2" vid="PRO 28:10">ನಿರ್ದೋಷಿಗಳಾದರೋ ಒಳ್ಳೆಯ ಸೊತ್ತನ್ನು ಪಡೆಯುವರು.<verse eid="PRO 28:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 28:11"/>ಐಶ್ವರ್ಯವಂತನು ತನ್ನ ಸ್ವಂತ ಅಭಿಪ್ರಾಯದಲ್ಲಿ ಜ್ಞಾನಿಯಾಗಿದ್ದಾನೆ.</para>
  <para style="q2" vid="PRO 28:11">ಆದರೆ ವಿವೇಚನೆಯುಳ್ಳ ಬಡವನು ಅವನ ವಂಚನೆಯನ್ನು ನೋಡಬಲ್ಲನು.<verse eid="PRO 28:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 28:12"/>ನೀತಿವಂತರಿಗೆ ಜಯವಾದರೆ, ದೊಡ್ಡ ಘನತೆ ಇರುವುದು.</para>
  <para style="q2" vid="PRO 28:12">ಆದರೆ ದುಷ್ಟರಿಗೆ ಏಳಿಗೆಯಾದರೆ, ಮನುಷ್ಯರು ಅಡಗಿಕೊಳ್ಳುತ್ತಾರೆ.<verse eid="PRO 28:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 28:13"/>ತನ್ನ ಪಾಪಗಳನ್ನು ಮುಚ್ಚಿಕೊಳ್ಳುವವನಿಗೆ ಏಳಿಗೆ ಆಗುವುದಿಲ್ಲ.</para>
  <para style="q2" vid="PRO 28:13">ಆದರೆ ಪಾಪಗಳನ್ನು ಒಪ್ಪಿಕೊಂಡು ಬಿಟ್ಟುಬಿಡುವವನಿಗೆ ಕರುಣೆ ದೊರಕುವುದು.<verse eid="PRO 28:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 28:14"/>ಯಾವಾಗಲೂ ಯೆಹೋವ ದೇವರ ಭಯಭಕ್ತಿಯಲ್ಲಿ ನಡೆದುಕೊಳ್ಳುವವನು ಧನ್ಯನು.</para>
  <para style="q2" vid="PRO 28:14">ಆದರೆ ಹೃದಯವನ್ನು ಕಠಿಣಪಡಿಸಿಕೊಳ್ಳುವವನು ಕೇಡಿಗೆ ಸಿಕ್ಕಿಬೀಳುವನು.<verse eid="PRO 28:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 28:15"/>ಗರ್ಜಿಸುವ ಸಿಂಹದಂತೆಯೂ ಅಲೆದಾಡುವ ಕರಡಿಯಂತೆಯೂ,</para>
  <para style="q2" vid="PRO 28:15">ಬಡವರನ್ನು ದುಷ್ಟನು ಆಳುವನು.<verse eid="PRO 28:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 28:16"/>ಗ್ರಹಿಕೆಯಿಲ್ಲದ ಅಧಿಕಾರಿಯು ಮಹಾ ಸುಲಿಗೆಗಾರನು.</para>
  <para style="q2" vid="PRO 28:16">ಆದರೆ ಲೋಭವನ್ನು ಹಗೆಮಾಡುವವನು ದೀರ್ಘಾಯುಷ್ಯನು.<verse eid="PRO 28:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 28:17"/>ನರಹತ್ಯದ ಅಪರಾಧ ಭಾವನೆಯಿಂದ ಇರುವವನು,</para>
  <para style="q2" vid="PRO 28:17">ಮರಣದೆಡೆಗೆ ಓಡುತ್ತಿರುವನು,</para>
  <para style="q2" vid="PRO 28:17">ಅವನನ್ನು ಯಾರೂ ತಡೆಯದಿರಲಿ.<verse eid="PRO 28:17"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 28:18"/>ನಿರ್ದೋಷಿಯಾಗಿ ನಡೆಯುವವನು ಸಂರಕ್ಷಣೆ ಹೊಂದುವನು.</para>
  <para style="q2" vid="PRO 28:18">ವಕ್ರಮಾರ್ಗಿಯು ತಟ್ಟನೆ ಬೀಳುವನು.<verse eid="PRO 28:18"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 28:19"/>ತನ್ನ ಹೊಲವನ್ನು ವ್ಯವಸಾಯ ಮಾಡುವವನು ಆಹಾರದಿಂದ ತೃಪ್ತಿಹೊಂದುವನು.</para>
  <para style="q2" vid="PRO 28:19">ಆದರೆ ವ್ಯರ್ಥ ಕಾರ್ಯವನ್ನು ಹಿಂಬಾಲಿಸುವವನಿಗೆ ಸಾಕಾದಷ್ಟು ಬಡತನವು ಇರುವುದು.<verse eid="PRO 28:19"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 28:20"/>ನಂಬಿಗಸ್ತನಾದ ಮನುಷ್ಯನು ಆಶೀರ್ವಾದಗಳಲ್ಲಿ ತುಂಬಿತುಳುಕುವನು;</para>
  <para style="q2" vid="PRO 28:20">ಆದರೆ ಧನವಂತನಾಗಲು ಆತುರಪಡುವವನು, ನಿರ್ದೋಷಿಯಾಗಿರುವುದಿಲ್ಲ.<verse eid="PRO 28:20"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 28:21"/>ಪಕ್ಷಪಾತವು ಸರಿಯಲ್ಲ;</para>
  <para style="q2" vid="PRO 28:21">ತುತ್ತು ರೊಟ್ಟಿಗಾಗಿ ಒಬ್ಬನು ದ್ರೋಹ ಮಾಡುವನು.<verse eid="PRO 28:21"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 28:22"/>ಧನವಂತನಾಗಲು ಆತುರಪಡುವವನು ಕೆಟ್ಟ ಕಣ್ಣುಳ್ಳವನಾಗಿದ್ದಾನೆ;</para>
  <para style="q2" vid="PRO 28:22">ತನಗೆ ಬಡತನವು ಬರುವುದನ್ನು ಅವನು ಯೋಚಿಸುವುದಿಲ್ಲ.<verse eid="PRO 28:22"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 28:23"/>ತನ್ನ ನಾಲಿಗೆಯಿಂದ ಮುಖಸ್ತುತಿ ಮಾಡುವವನಿಗಿಂತ,</para>
  <para style="q2" vid="PRO 28:23">ಒಬ್ಬನನ್ನು ಗದರಿಸುವವನು ತರುವಾಯ ಹೆಚ್ಚು ದಯಾಪಾತ್ರನಾಗುವನು.<verse eid="PRO 28:23"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 28:24"/>ತನ್ನ ತಂದೆಯಾನ್ನಾಗಲಿ,</para>
  <para style="q2" vid="PRO 28:24">ತಾಯಿಯನ್ನಾಗಲಿ ದೋಚಿಕೊಂಡು,</para>
  <para style="q2" vid="PRO 28:24">“ಇದು ದೋಷವಲ್ಲ,” ಎಂದು ಹೇಳುವವನು ಕೆಡುಕನಿಗೆ ಜೊತೆಗಾರನು.<verse eid="PRO 28:24"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 28:25"/>ದುರಾಶೆಯುಳ್ಳವನು ಕಲಹವನ್ನೆಬ್ಬಿಸುವನು;</para>
  <para style="q2" vid="PRO 28:25">ಯೆಹೋವ ದೇವರಲ್ಲಿ ಭರವಸವಿಡುವವನು ಪುಷ್ಟನಾಗುವನು.<verse eid="PRO 28:25"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 28:26"/>ತನ್ನ ಬುದ್ಧಿಯಲ್ಲಿಯೇ ಭರವಸವಿಡುವವನು ಬುದ್ಧಿಹೀನನು;</para>
  <para style="q2" vid="PRO 28:26">ಆದರೆ ಜ್ಞಾನದಿಂದ ನಡೆಯುವವನು ಉದ್ಧಾರ ಹೊಂದುವನು.<verse eid="PRO 28:26"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 28:27"/>ಬಡವರಿಗೆ ದಾನ ಮಾಡುವವನು, ಕೊರತೆ ಪಡುವುದಿಲ್ಲ;</para>
  <para style="q2" vid="PRO 28:27">ಆದರೆ ತನ್ನ ಕಣ್ಣುಗಳನ್ನು ಮುಚ್ಚಿಕೊಳ್ಳುವವನಿಗೆ ಅನೇಕ ಶಾಪಗಳು.<verse eid="PRO 28:27"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 28:28"/>ದುಷ್ಟರು ಎದ್ದರೆ ಜನರು ಅಡಗಿಕೊಳ್ಳುತ್ತಾರೆ,</para>
  <para style="q2" vid="PRO 28:28">ಆದರೆ ಅವರು ನಾಶವಾದಾಗ ನೀತಿವಂತರು ವೃದ್ಧಿಯಾಗುತ್ತಾರೆ.<verse eid="PRO 28:28"/></para>
  <para style="b"/>
  <chapter eid="PRO 28"/>
  <chapter number="29" style="c" sid="PRO 29"/>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 29:1"/>ಅನೇಕಬಾರಿ ಗದರಿಸಿದರೂ ತಗ್ಗದ ಹಟಮಾರಿ</para>
  <para style="q2" vid="PRO 29:1">ಪರಿಹಾರವಿಲ್ಲದೆ ಫಕ್ಕನೆ ಮುರಿದು ಬೀಳುವನು.<verse eid="PRO 29:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 29:2"/>ಶಿಷ್ಟರು ಅಧಿಕಾರಕ್ಕೆ ಬಂದರೆ ಜನರು ಹರ್ಷಿಸುತ್ತಾರೆ.</para>
  <para style="q2" vid="PRO 29:2">ಆದರೆ ದುಷ್ಟರು ಆಳಿದರೆ, ಜನರಿಗೆ ನರಳಾಟ.<verse eid="PRO 29:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 29:3"/>ಜ್ಞಾನಪ್ರಿಯನು ತಂದೆಗೆ ಆನಂದ</para>
  <para style="q2" vid="PRO 29:3">ಆದರೆ ವೇಶ್ಯೆಯರ ಸಹವಾಸದಿಂದ ಆಸ್ತಿಯ ವಿನಾಶ.<verse eid="PRO 29:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 29:4"/>ನ್ಯಾಯದಿಂದ ಅರಸನು ದೇಶವನ್ನು ಸ್ಥಿರಗೊಳಿಸುತ್ತಾನೆ,</para>
  <para style="q2" vid="PRO 29:4">ಆದರೆ ಲಂಚಕೋರ ಅಧಿಕಾರಿ ದೇಶವನ್ನು ಕೆಡವಿ ಹಾಕುತ್ತಾನೆ.<verse eid="PRO 29:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 29:5"/>ತನ್ನ ನೆರೆಯವನನ್ನು ಸುಮ್ಮನೇ ಹೊಗಳುತ್ತಿರುವವನು,</para>
  <para style="q2" vid="PRO 29:5">ನೆರೆಯವನ ಕಾಲಿಗೆ ಬಲೆಯನ್ನು ಒಡ್ಡುತ್ತಾನೆ.<verse eid="PRO 29:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 29:6"/>ಕೆಟ್ಟವನು ತನ್ನ ಪಾಪದಿಂದಲೇ ಸಿಕ್ಕಿಹಾಕಿಕೊಳ್ಳುತ್ತಾನೆ,</para>
  <para style="q2" vid="PRO 29:6">ಆದರೆ ನೀತಿವಂತನು ಸಂತೋಷದಿಂದ ಹಾಡಿ ಹರ್ಷಿಸುತ್ತಾನೆ.<verse eid="PRO 29:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 29:7"/>ಬಡವರ ನ್ಯಾಯಕ್ಕಾಗಿ ನೀತಿವಂತನು ಚಿಂತಿಸುತ್ತಾನೆ.</para>
  <para style="q2" vid="PRO 29:7">ಆದರೆ ದುಷ್ಟನಿಗೆ ಅಂಥಾ ಚಿಂತೆಯೇ ಇಲ್ಲ.<verse eid="PRO 29:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 29:8"/>ಪರಿಹಾಸ್ಯಗಾರರು ಪಟ್ಟಣದಲ್ಲಿ ಗಲಾಟೆ ಎಬ್ಬಿಸುತ್ತಾರೆ.</para>
  <para style="q2" vid="PRO 29:8">ಆದರೆ ಜ್ಞಾನಿಗಳು ಕೋಪವನ್ನು ಆರಿಸುವರು.<verse eid="PRO 29:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 29:9"/>ಜ್ಞಾನಿಯು ಬುದ್ಧಿಹೀನನೊಂದಿಗೆ ವ್ಯಾಜ್ಯಮಾಡುವಾಗ,</para>
  <para style="q2" vid="PRO 29:9">ಮೂರ್ಖನು ರೇಗಿದರೂ ಅಪಹಾಸ್ಯಮಾಡಿದರೂ ಸಮಾಧಾನವೇ ಇರುವುದಿಲ್ಲ.<verse eid="PRO 29:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 29:10"/>ಕೊಲೆಪಾತಕರು ಪ್ರಾಮಾಣಿಕರನ್ನು ದ್ವೇಷಿಸುತ್ತಾರೆ.</para>
  <para style="q2" vid="PRO 29:10">ಆದರೆ ಯಥಾರ್ಥವಂತರನ್ನು ನಾಶಮಾಡಲು ಯತ್ನಿಸುತ್ತಾರೆ.<verse eid="PRO 29:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 29:11"/>ಮೂಢನು ತನ್ನ ಕೋಪವನ್ನೆಲ್ಲಾ ವ್ಯಕ್ತಪಡಿಸುವನು.</para>
  <para style="q2" vid="PRO 29:11">ಆದರೆ ಜ್ಞಾನಿಯು ಕೋಪವನ್ನು ಶಾಂತಿಯಿಂದ ತಡೆಹಿಡಿಯುತ್ತಾನೆ.<verse eid="PRO 29:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 29:12"/>ಒಬ್ಬ ಅಧಿಕಾರಿಯು ಸುಳ್ಳಿಗೆ ಕಿವಿಗೊಟ್ಟರೆ,</para>
  <para style="q2" vid="PRO 29:12">ಅವನ ಸೇವಕರೆಲ್ಲರೂ ದುಷ್ಟರಾಗುತ್ತಾರೆ.<verse eid="PRO 29:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 29:13"/>ಬಡವರಿಗೂ ದಬ್ಬಾಳಿಕೆ ನಡೆಸುವವರಿಗೂ ಒಂದು ಸಂಗತಿ ಹುದುವಾಗಿರುವುದು:</para>
  <para style="q2" vid="PRO 29:13">ಯೆಹೋವ ದೇವರು ಅವರಿಬ್ಬರ ಕಣ್ಣುಗಳನ್ನು ಬೆಳಗಿಸುವರು ಎಂಬುದೇ.<verse eid="PRO 29:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 29:14"/>ಅರಸನು ಬಡವರಿಗೆ ಪಕ್ಷಪಾತವಿಲ್ಲದೆ ನ್ಯಾಯತೀರಿಸಿದರೆ,</para>
  <para style="q2" vid="PRO 29:14">ಅವನ ಸಿಂಹಾಸನವು ಎಂದೆಂದಿಗೂ ಸ್ಥಿರಗೊಳ್ಳುವುದು.<verse eid="PRO 29:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 29:15"/>ಬೆತ್ತ ಮತ್ತು ಬೆದರಿಕೆಗಳು ಜ್ಞಾನವನ್ನುಂಟುಮಾಡುತ್ತವೆ;</para>
  <para style="q2" vid="PRO 29:15">ಆದರೆ ಶಿಕ್ಷಿಸದೆ ಬಿಟ್ಟ ಹುಡುಗನು ತನ್ನ ತಾಯಿಗೆ ಅವಮಾನವನ್ನು ತರುತ್ತಾನೆ.<verse eid="PRO 29:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 29:16"/>ದುಷ್ಟರು ವೃದ್ಧಿಯಾದಾಗ, ಪಾಪವು ವೃದ್ಧಿಯಾಗುತ್ತದೆ.</para>
  <para style="q2" vid="PRO 29:16">ಆದರೆ ನೀತಿವಂತರು ದುಷ್ಟರ ಬೀಳುವಿಕೆಯನ್ನು ಕಣ್ಣಾರೆ ನೋಡುವರು.<verse eid="PRO 29:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 29:17"/>ನಿನ್ನ ಮಕ್ಕಳನ್ನು ಶಿಕ್ಷಿಸಿದರೆ, ಅವರು ನಿನಗೆ ಮನಶಾಂತಿಯನ್ನು ಕೊಡುವರು;</para>
  <para style="q2" vid="PRO 29:17">ಹೌದು, ಅವರು ನೀನು ಬಯಸುವ ಹರ್ಷವನ್ನು ನಿನಗೆ ತರುವರು.<verse eid="PRO 29:17"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 29:18"/>ದೈವ ಪ್ರಕಟನೆ ಇಲ್ಲದಿರುವಾಗ, ಜನರು ನಾಶವಾಗುತ್ತಾರೆ;</para>
  <para style="q2" vid="PRO 29:18">ಆದರೆ ಜ್ಞಾನೋಪದೇಶವನ್ನು ಕೈಗೊಳ್ಳುವವನು ಧನ್ಯನು.<verse eid="PRO 29:18"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 29:19"/>ಮಾತಿನಿಂದ ಮಾತ್ರ ಕೆಲಸಗಾರರನ್ನು ತಿದ್ದಲು ಸಾಧ್ಯವಿಲ್ಲ;</para>
  <para style="q2" vid="PRO 29:19">ಏಕೆಂದರೆ ಅವರು ಅರ್ಥಮಾಡಿಕೊಂಡರೂ, ಅದರಂತೆ ನಡೆಯುವುದಿಲ್ಲ.<verse eid="PRO 29:19"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 29:20"/>ದುಡುಕಿ ಮಾತನಾಡುವ ವ್ಯಕ್ತಿಯನ್ನು ನೀನು ನೋಡಿದ್ದೀಯೋ?</para>
  <para style="q2" vid="PRO 29:20">ಅಂಥವನಿಗಿಂತಲೂ ಬುದ್ಧಿಹೀನನ ವಿಷಯದಲ್ಲಿ ಹೆಚ್ಚು ನಿರೀಕ್ಷೆ ಇದೆ.<verse eid="PRO 29:20"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 29:21"/>ಬಾಲ್ಯದಿಂದ ಕೆಲಸಗಾರನನ್ನು ಅನುಕೂಲವಾಗಿ ಸಾಕಿ ಬಿಟ್ಟರೆ,</para>
  <para style="q2" vid="PRO 29:21">ತರುವಾಯ ಅವನು ಎದುರು ಬೀಳಲು ಸಾಧ್ಯ.<verse eid="PRO 29:21"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 29:22"/>ಕೋಪಿಷ್ಟನು ಜಗಳವನ್ನೆಬ್ಬಿಸುವನು,</para>
  <para style="q2" vid="PRO 29:22">ಮುಂಗೋಪಿಯು ಅನೇಕ ಪಾಪಗಳನ್ನು ಮಾಡುತ್ತಾನೆ.<verse eid="PRO 29:22"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 29:23"/>ಗರ್ವವು ಮನುಷ್ಯನನ್ನು ಹೀನಸ್ಥಿತಿಗೆ ತರುವುದು;</para>
  <para style="q2" vid="PRO 29:23">ಆದರೆ ಆತ್ಮದಲ್ಲಿ ದೀನರು ಮೆಚ್ಚಿಕೆಯನ್ನು ಪಡೆಯುವರು.<verse eid="PRO 29:23"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 29:24"/>ಕಳ್ಳರ ಸಹವಾಸ ಮಾಡುವವರು ತಮಗೆ ತಾವೇ ಶತ್ರುಗಳು.</para>
  <para style="q2" vid="PRO 29:24">ಅವರು ಆಣೆ ಇಟ್ಟರೂ ಅವರಲ್ಲಿ ಬದಲಾವಣೆ ಇರುವುದಿಲ್ಲ.<verse eid="PRO 29:24"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 29:25"/>ಖಂಡಿತವಾಗಿಯೂ ಮನುಷ್ಯನ ಭಯವು ಒಂದು ಉರುಲಾಗಿರುವುದು;</para>
  <para style="q2" vid="PRO 29:25">ಯೆಹೋವ ದೇವರಲ್ಲಿ ಭರವಸವಿಡುವವನು, ಸಂರಕ್ಷಣೆ ಹೊಂದುವನು.<verse eid="PRO 29:25"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 29:26"/>ಅನೇಕರು ಅಧಿಕಾರಿಯ ದಯೆಯನ್ನು ಹುಡುಕುತ್ತಾರೆ.</para>
  <para style="q2" vid="PRO 29:26">ಆದರೆ ಯೆಹೋವ ದೇವರಿಂದಲೇ ಪ್ರತಿಯೊಬ್ಬರಿಗೂ ನ್ಯಾಯ ದೊರಕುತ್ತದೆ.<verse eid="PRO 29:26"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 29:27"/>ನೀತಿವಂತರು ಅಪ್ರಾಮಾಣಿಕರನ್ನು ದ್ವೇಷಿಸುತ್ತಾರೆ.</para>
  <para style="q2" vid="PRO 29:27">ದುಷ್ಟರು ಪ್ರಾಮಾಣಿಕರನ್ನು ತಿರಸ್ಕರಿಸುತ್ತಾರೆ.<verse eid="PRO 29:27"/></para>
  <chapter eid="PRO 29"/>
  <chapter number="30" style="c" sid="PRO 30"/>
  <para style="ms1">ಆಗೂರನ ಹೇಳಿಕೆಗಳು</para>
  <para style="p">
    <verse number="1" style="v" sid="PRO 30:1"/>ಜಾಕೆ ಎಂಬುವನ ಮಗನಾದ ಆಗೂರನ ದೈವಿಕ ಬುದ್ಧಿಮಾತುಗಳು.</para>
  <para style="q1" vid="PRO 30:1">ಇವನು ಇಥಿಯೇಲನಿಗೂ ಉಕ್ಕಾಲನಿಗೂ ಹೀಗೆ ಹೇಳಿದನು:<note caller="+" style="f"><char style="fr" closed="false">30:1 </char><char style="ft" closed="false">ದೈವ ಪ್ರೇರಿತ ಪ್ರಕಟನೆಗಳು </char><char style="fqa" closed="false">ಇಥಿಯೇಲನಿಗೆ ಆಗೂರನ ಬುದ್ಧಿಮಾತುಗಳು</char></note></para>
  <para style="b" vid="PRO 30:1"/>
  <para style="q1" vid="PRO 30:1">“ದೇವರೇ, ನಾನು ದಣಿದಿದ್ದೇನೆ,</para>
  <para style="q2" vid="PRO 30:1">ಆದರೆ ನಾನು ಜಯಶಾಲಿಯಾಗುವೆನು.<verse eid="PRO 30:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 30:2"/>ಖಂಡಿತವಾಗಿಯೂ ನಾನು ಮನುಷ್ಯನಲ್ಲ, ಮೃಗ.</para>
  <para style="q2" vid="PRO 30:2">ನನಗೆ ಮನುಷ್ಯನ ಗ್ರಹಿಕೆ ಇಲ್ಲ.<verse eid="PRO 30:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 30:3"/>ನಾನು ಜ್ಞಾನವನ್ನು ಕಲಿತುಕೊಂಡಿಲ್ಲ;</para>
  <para style="q2" vid="PRO 30:3">ಅಲ್ಲದೆ ಪರಿಶುದ್ಧ ದೇವರ ಅರಿವು ನನಗಿಲ್ಲ.<verse eid="PRO 30:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 30:4"/>ಯಾರು ಸ್ವರ್ಗಕ್ಕೆ ಹೋಗಿ ಕೆಳಗಿಳಿದು ಬಂದಿದ್ದಾರೆ?</para>
  <para style="q2" vid="PRO 30:4">ಯಾರ ಕೈಗಳು ಗಾಳಿಯನ್ನು ಒಟ್ಟುಗೂಡಿಸಿವೆ?</para>
  <para style="q1" vid="PRO 30:4">ಯಾರು ತಮ್ಮ ವಸ್ತ್ರದಲ್ಲಿ ಸಾಗರಗಳನ್ನು ಮೂಟೆಕಟ್ಟಿಕೊಂಡಿದ್ದಾರೆ?</para>
  <para style="q2" vid="PRO 30:4">ಭೂಮಿಯ ಎಲ್ಲೆಗಳನ್ನೆಲ್ಲಾ ಸ್ಥಾಪಿಸಿದವರು ಯಾರು?</para>
  <para style="q1" vid="PRO 30:4">ಅವರ ಹೆಸರೇನು? ಅವರ ಮಗನ ಹೆಸರೇನು?</para>
  <para style="q2" vid="PRO 30:4">ಖಂಡಿತವಾಗಿಯೂ ನಿಮಗೆ ಗೊತ್ತಿರಬೇಕು!<verse eid="PRO 30:4"/></para>
  <para style="b"/>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 30:5"/>“ದೇವರ ಪ್ರತಿಯೊಂದು ಮಾತು ದೋಷವಿಲ್ಲದ್ದು;</para>
  <para style="q2" vid="PRO 30:5">ದೇವರಲ್ಲಿ ಭರವಸವಿಡುವವನಿಗೆ ಅವರು ಗುರಾಣಿಯಾಗಿದ್ದಾರೆ.<verse eid="PRO 30:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 30:6"/>ದೇವರ ಮಾತುಗಳಿಗೆ ಯಾವುದನ್ನೂ ಸೇರಿಸಬೇಡ.</para>
  <para style="q2" vid="PRO 30:6">ಇಲ್ಲವಾದರೆ ದೇವರು ನಿನ್ನನ್ನು ಗದರಿಸಿ ನಿನ್ನನ್ನು ಸುಳ್ಳುಗಾರನೆಂದು ಸಾಬೀತುಪಡಿಸುವರು.<verse eid="PRO 30:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 30:7"/>“ಯೆಹೋವ ದೇವರೇ, ನಾನು ನಿಮ್ಮನ್ನು ಎರಡು ವಿಷಯಗಳನ್ನು ಕೇಳುತ್ತೇನೆ.</para>
  <para style="q2" vid="PRO 30:7">ನಿರಾಕರಿಸಬೇಡಿ ನಾನು ಸಾಯುವ ಮೊದಲು ಅವೆರಡನ್ನು ಅನುಗ್ರಹಿಸಿರಿ.<verse eid="PRO 30:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 30:8"/>ವಂಚನೆ ಸುಳ್ಳನ್ನು ನನ್ನಿಂದ ದೂರಮಾಡಿರಿ.</para>
  <para style="q2" vid="PRO 30:8">ಬಡತನವನ್ನಾಗಲಿ, ಐಶ್ವರ್ಯವನ್ನಾಗಲಿ ನನಗೆ ಕೊಡಬೇಡಿರಿ.</para>
  <para style="q2" vid="PRO 30:8">ನನಗೆ ಅನುದಿನದ ಆಹಾರವನ್ನು ದಯಪಾಲಿಸಿರಿ.<verse eid="PRO 30:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 30:9"/>ನಾನು ಐಶ್ವರ್ಯವಂತನಾದರೆ ನಿನ್ನನ್ನು ನಿರಾಕರಿಸಿ,</para>
  <para style="q2" vid="PRO 30:9">‘ಯೆಹೋವ ದೇವರು ಯಾರು?’ ಎಂದು ಹೇಳೇನು.</para>
  <para style="q1" vid="PRO 30:9">ನಾನು ಬಡವನಾದರೆ ಕಳ್ಳತನಮಾಡಿ</para>
  <para style="q2" vid="PRO 30:9">ನನ್ನ ದೇವರಾದ ನಿಮ್ಮ ಹೆಸರಿಗೆ ಅಪಕೀರ್ತಿ ತಂದೇನು.<verse eid="PRO 30:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 30:10"/>“ಕೆಲಸಗಾರರ ವಿಷಯವಾಗಿ ಅವನ ಯಜಮಾನನಿಗೆ ದೂರು ಹೇಳಬೇಡ;</para>
  <para style="q2" vid="PRO 30:10">ಇದರಿಂದ ಆ ಕೆಲಸಗಾರ ನಿನ್ನನ್ನು ಶಪಿಸಾನು, ಆಗ ನೀನು ದೋಷಿಯಾಗುವೆ.<verse eid="PRO 30:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 30:11"/>“ತಮ್ಮ ತಂದೆಯನ್ನು ಶಪಿಸಿ,</para>
  <para style="q2" vid="PRO 30:11">ತಮ್ಮ ತಾಯಿಗೆ ಶುಭವನ್ನು ಕೋರದೆ ಇರುವವರು ಇದ್ದಾರೆ.<verse eid="PRO 30:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 30:12"/>ತಮ್ಮ ದೃಷ್ಟಿಯಲ್ಲಿ ಶುದ್ಧವಾಗಿರುವವರು ಇದ್ದಾರೆ;</para>
  <para style="q2" vid="PRO 30:12">ಆದರೆ ಅವರು ತಮ್ಮ ಕೊಳೆಯನ್ನು ತೊಳೆದುಕೊಂಡಿರುವುದಿಲ್ಲ.<verse eid="PRO 30:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 30:13"/>ಅವರ ಕಣ್ಣುಗಳು ಯಾವಾಗಲೂ ಅಹಂಕಾರದಿಂದ ಕೂಡಿರುತ್ತವೆ.</para>
  <para style="q2" vid="PRO 30:13">ಅವರ ದೃಷ್ಟಿ ಅಸಹ್ಯವಾಗಿದೆ.<verse eid="PRO 30:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 30:14"/>ಖಡ್ಗಗಳಂತೆ ಹಲ್ಲುಗಳುಳ್ಳವರೂ</para>
  <para style="q2" vid="PRO 30:14">ಚೂರಿಗಳಂತೆ ದವಡೆಗಳುಳ್ಳವರೂ</para>
  <para style="q1" vid="PRO 30:14">ಬಡವರನ್ನು ಭೂಮಿಯಿಂದಲೂ</para>
  <para style="q2" vid="PRO 30:14">ದಿಕ್ಕಿಲ್ಲದವರನ್ನು ಮಾನವಕುಲದಿಂದಲೂ ಕಬಳಿಸುವವರೂ ಆಗಿದ್ದಾರೆ.<verse eid="PRO 30:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 30:15"/>“ಜಿಗಣೆಗೆ, ‘ಕೊಡು! ಕೊಡು!’ ಎಂದು ಕೂಗುವ</para>
  <para style="q2" vid="PRO 30:15">ಇಬ್ಬರು ಹೆಣ್ಣುಮಕ್ಕಳುಂಟು.</para>
  <para style="b" vid="PRO 30:15"/>
  <para style="li1" vid="PRO 30:15">“ಎಂದಿಗೂ ತೃಪ್ತಿಪಡದ ಮೂರು ಸಂಗತಿಗಳು ಇವೆ,</para>
  <para style="li2" vid="PRO 30:15">ಹೌದು, ‘ಸಾಕು!’ ಎಂದು ಹೇಳದಿರುವ ನಾಲ್ಕು ಸಂಗತಿಗಳಿವೆ:<verse eid="PRO 30:15"/></para>
  <para style="li3">
    <verse number="16" style="v" sid="PRO 30:16"/>ಸಮಾಧಿ,</para>
  <para style="li3" vid="PRO 30:16">ಬಂಜೆಯಾದ ಗರ್ಭ,</para>
  <para style="li3" vid="PRO 30:16">ನೀರಿನಿಂದ ಎಂದೂ ತೃಪ್ತಿ ಹೊಂದದ ಭೂಮಿ,</para>
  <para style="li3" vid="PRO 30:16">‘ಸಾಕು!’ ಎಂದು ಹೇಳದಿರುವ ಬೆಂಕಿ.<verse eid="PRO 30:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 30:17"/>“ತನ್ನ ತಂದೆಯನ್ನು ಹಾಸ್ಯಮಾಡಿ,</para>
  <para style="q2" vid="PRO 30:17">ತನ್ನ ತಾಯಿಯನ್ನು ಧಿಕ್ಕರಿಸುವ ಕಣ್ಣನ್ನು,</para>
  <para style="q1" vid="PRO 30:17">ಕಣಿವೆಯ ಕಾಗೆಗಳು ಕಿತ್ತು ಕಕ್ಕುವವು.</para>
  <para style="q2" vid="PRO 30:17">ರಣಹದ್ದುಗಳು ಅದನ್ನು ತಿಂದುಬಿಡುವವು.<verse eid="PRO 30:17"/></para>
  <para style="b"/>
  <para style="li1">
    <verse number="18" style="v" sid="PRO 30:18"/>“ನನಗೆ ಆಶ್ಚರ್ಯವಾದ ಮೂರು ಸಂಗತಿಗಳಿವೆ,</para>
  <para style="li2" vid="PRO 30:18">ಹೌದು, ನನಗೆ ಅರ್ಥವಾಗದಿರುವ ನಾಲ್ಕು ಸಂಗತಿಗಳಿವೆ:<verse eid="PRO 30:18"/></para>
  <para style="li3">
    <verse number="19" style="v" sid="PRO 30:19"/>ಆಕಾಶದಲ್ಲಿ ಹದ್ದಿನ ಮಾರ್ಗ,</para>
  <para style="li3" vid="PRO 30:19">ಬಂಡೆಯ ಮೇಲೆ ಸರ್ಪದ ಮಾರ್ಗ,</para>
  <para style="li3" vid="PRO 30:19">ಸಮುದ್ರ ನಡುವೆ ಹಡಗಿನ ಮಾರ್ಗ,</para>
  <para style="li3" vid="PRO 30:19">ಯುವಕ ಯುವತಿಯರ ಪ್ರೀತಿ ಮಾರ್ಗ.<verse eid="PRO 30:19"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 30:20"/>“ಜಾರಸ್ತ್ರೀಯ ನಡತೆಯು ಹೀಗಿದೆ:</para>
  <para style="q2" vid="PRO 30:20">ಅವಳು ತಿಂದು, ತನ್ನ ಬಾಯನ್ನು ಒರೆಸಿಕೊಂಡು</para>
  <para style="q2" vid="PRO 30:20">‘ನಾನು ಯಾವುದೇ ತಪ್ಪು ಮಾಡಿಲ್ಲ,’ ಎಂದು ಹೇಳುತ್ತಾಳೆ.<verse eid="PRO 30:20"/></para>
  <para style="b"/>
  <para style="li1">
    <verse number="21" style="v" sid="PRO 30:21"/>“ಭೂಮಿಯು ಮೂರು ವಿಷಯಗಳಿಂದ ಕಳವಳಗೊಳ್ಳುತ್ತದೆ,</para>
  <para style="li2" vid="PRO 30:21">ನಾಲ್ವರನ್ನು ಅದು ತಾಳಲಾರದು:<verse eid="PRO 30:21"/></para>
  <para style="li3">
    <verse number="22" style="v" sid="PRO 30:22"/>ಅರಸನಾಗುವ ದಾಸನು,</para>
  <para style="li3" vid="PRO 30:22">ತಿನ್ನಲು ಸಾಕಷ್ಟು ಪಡೆಯುವ ಮೂರ್ಖನು,<verse eid="PRO 30:22"/></para>
  <para style="li3">
    <verse number="23" style="v" sid="PRO 30:23"/>ತಿರಸ್ಕಾರಕ್ಕೆ ಅರ್ಹಳಾದ ಮಹಿಳೆ, ಮದುವೆಯಾಗುವುದು.</para>
  <para style="li3" vid="PRO 30:23">ಪತ್ನಿಯ ಸ್ಥಾನವನ್ನು ಕಸಿದುಕೊಂಡ ದಾಸಿ.<verse eid="PRO 30:23"/></para>
  <para style="b"/>
  <para style="li1">
    <verse number="24" style="v" sid="PRO 30:24"/>“ಭೂಮಿಯ ಮೇಲೆ ಅಧಿಕ ಜ್ಞಾನವುಳ್ಳವುಗಳಾದ</para>
  <para style="li2" vid="PRO 30:24">ನಾಲ್ಕು ಸಣ್ಣ ಪ್ರಾಣಿಗಳು ಇವೆ:<verse eid="PRO 30:24"/></para>
  <para style="li2">
    <verse number="25" style="v" sid="PRO 30:25"/>ಇರುವೆಗಳು ಬಲಹೀನ ಜೀವಿಗಳು,</para>
  <para style="li3" vid="PRO 30:25">ಆದರೂ ಅವು ಬೇಸಿಗೆಯಲ್ಲಿ ತಮ್ಮ ಆಹಾರವನ್ನು ಸಿದ್ಧಮಾಡಿಕೊಳ್ಳುತ್ತವೆ.<verse eid="PRO 30:25"/></para>
  <para style="li2">
    <verse number="26" style="v" sid="PRO 30:26"/>ಬೆಟ್ಟದ ಮೊಲಗಳು ಬಲಹೀನ ಪ್ರಾಣಿಗಳಾಗಿದ್ದರೂ</para>
  <para style="li3" vid="PRO 30:26">ಅವು ಬಂಡೆಗಳಲ್ಲಿ ತಮ್ಮ ಮನೆಗಳನ್ನು ಮಾಡಿಕೊಳ್ಳುತ್ತವೆ.<verse eid="PRO 30:26"/></para>
  <para style="li2">
    <verse number="27" style="v" sid="PRO 30:27"/>ಮಿಡತೆಗಳಿಗೆ ಅರಸನಿಲ್ಲ;</para>
  <para style="li3" vid="PRO 30:27">ಆದರೂ ಅವೆಲ್ಲಾ ದಂಡುದಂಡಾಗಿ ಹೋಗುತ್ತವೆ.<verse eid="PRO 30:27"/></para>
  <para style="li2">
    <verse number="28" style="v" sid="PRO 30:28"/>ಹಲ್ಲಿಯನ್ನು ಅಂಗೈಯಿಂದ ಹಿಡಿಯಬಹುದಾದರೂ</para>
  <para style="li3" vid="PRO 30:28">ಅರಸನ ಅರಮನೆಗಳಲ್ಲಿ ಕಂಡುಬರುತ್ತವೆ.<verse eid="PRO 30:28"/></para>
  <para style="b"/>
  <para style="li1">
    <verse number="29" style="v" sid="PRO 30:29"/>“ಗಂಭೀರ ಗಮನದ ಮೂರು ಪ್ರಾಣಿಗಳಿವೆ,</para>
  <para style="li2" vid="PRO 30:29">ಹೌದು, ಗಂಭೀರ ಗತಿಯ ನಾಲ್ಕಿವೆ:<verse eid="PRO 30:29"/></para>
  <para style="li3">
    <verse number="30" style="v" sid="PRO 30:30"/>ಮೃಗಗಳಲ್ಲಿ ಬಲಿಷ್ಠವಾಗಿರುವ ಸಿಂಹವು, ಯಾವುದಕ್ಕೂ ಹಿಮ್ಮೆಟ್ಟದು.<verse eid="PRO 30:30"/></para>
  <para style="li3">
    <verse number="31" style="v" sid="PRO 30:31"/>ಕತ್ತೆತ್ತಿ ನಡೆಯುವ ಹುಂಜ,</para>
  <para style="li3" vid="PRO 30:31">ಹೋತವು,</para>
  <para style="li3" vid="PRO 30:31">ತನ್ನ ಸುತ್ತಲೂ ಸೈನಿಕರಿರುವ ಅರಸನು.<verse eid="PRO 30:31"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="32" style="v" sid="PRO 30:32"/>“ನೀನು ಹೆಮ್ಮೆಪಟ್ಟು ಮೂರ್ಖನಾಗಿ ನಡೆದಿದ್ದರೆ,</para>
  <para style="q2" vid="PRO 30:32">ಇಲ್ಲವೆ ಕೆಟ್ಟದ್ದಾಗಿ ಆಲೋಚಿಸಿದ್ದರೆ,</para>
  <para style="q2" vid="PRO 30:32">ನಿನ್ನ ಬಾಯಿಯ ಮೇಲೆ ಕೈಯಿಟ್ಟುಕೊ.<verse eid="PRO 30:32"/></para>
  <para style="q1">
    <verse number="33" style="v" sid="PRO 30:33"/>ಹಾಲನ್ನು ಕಡೆಯುವುದರಿಂದ ಬೆಣ್ಣೆ,</para>
  <para style="q2" vid="PRO 30:33">ಮೂಗನ್ನು ಹಿಂಡುವುದರಿಂದ ರಕ್ತ,</para>
  <para style="q2" vid="PRO 30:33">ಹಾಗೆಯೇ ಕೋಪವನ್ನೆಬ್ಬಿಸುವುದರಿಂದ ಜಗಳ.”<verse eid="PRO 30:33"/></para>
  <chapter eid="PRO 30"/>
  <chapter number="31" style="c" sid="PRO 31"/>
  <para style="ms1">ಅರಸ ಲೆಮೂವೇಲನ ಹೇಳಿಕೆಗಳು</para>
  <para style="p">
    <verse number="1" style="v" sid="PRO 31:1"/>ಅರಸನಾದ ಲೆಮೂವೇಲನ ಮಾತುಗಳು, ಅಂದರೆ ಅವನ ತಾಯಿಯು ಅವನಿಗೆ ಉಪದೇಶಿಸಿದ ದೈವಿಕ ಬುದ್ಧಿಮಾತುಗಳು:<verse eid="PRO 31:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 31:2"/>ನನ್ನ ಮಗನೇ ಕೇಳು, ನನ್ನ ಗರ್ಭಪುತ್ರನೇ ಕೇಳು!</para>
  <para style="q2" vid="PRO 31:2">ನನ್ನ ಪ್ರಾರ್ಥನೆಗೆ ಉತ್ತರವಾದ ನನ್ನ ಮಗನೇ ಕೇಳು!<verse eid="PRO 31:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 31:3"/>ನಿನ್ನ ತ್ರಾಣವನ್ನು ಸ್ತ್ರೀಯರಿಗೆ ಒಪ್ಪಿಸದಿರು.</para>
  <para style="q2" vid="PRO 31:3">ರಾಜರನ್ನೇ ಹಾಳುಮಾಡಬಲ್ಲ ಸ್ತ್ರೀಯರಿಗೆ ನಿನ್ನ ಹಣ ಸಮಯವನ್ನು ವ್ಯಯಮಾಡದಿರು.<verse eid="PRO 31:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 31:4"/>ಲೆಮೂವೇಲನೇ, ಕುಡುಕತನವು ರಾಜರಿಗಾಗಿ ಅಲ್ಲ,</para>
  <para style="q2" vid="PRO 31:4">ದ್ರಾಕ್ಷಾರಸ ಕುಡಿಯುವದು ರಾಜರಿಗೆ ಯೋಗ್ಯವಲ್ಲ.</para>
  <para style="q2" vid="PRO 31:4">ಮದ್ಯಪಾನ ಅಧಿಕಾರಿಗಳಿಗೆ ಯೋಗ್ಯವಲ್ಲ;<verse eid="PRO 31:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 31:5"/>ಕುಡಿದರೆ ಅವರು ನಿಯಮವನ್ನು ಮರೆತು,</para>
  <para style="q2" vid="PRO 31:5">ಬಾಧಿತರಿಗೆ ನ್ಯಾಯವನ್ನು ನೀಡುವುದಿಲ್ಲ.<verse eid="PRO 31:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 31:6"/>ನಾಶವಾಗುವವರಿಗೆ ಮದ್ಯಪಾನವಿರಲಿ.</para>
  <para style="q2" vid="PRO 31:6">ಮನೋವ್ಯಥೆಪಡುವವರಿಗೆ ಮದ್ಯವಿರಲಿ.<verse eid="PRO 31:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 31:7"/>ಅವರು ಕುಡಿದು ಬಡತನವನ್ನು ಮರೆಯಲಿ.</para>
  <para style="q2" vid="PRO 31:7">ತಮ್ಮ ಯಾತನೆಯನ್ನು ಜ್ಞಾಪಕಕ್ಕೆ ತಾರದಿರಲಿ.<verse eid="PRO 31:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 31:8"/>ತಮಗಾಗಿ ಮಾತನಾಡಲು ಸಾಧ್ಯವಾಗದವರಿಗಾಗಿ ಮಾತನಾಡು,</para>
  <para style="q2" vid="PRO 31:8">ಅನಾಥರ ಪರವಾಗಿ ನ್ಯಾಯ ದೊರಕುವಂತೆ ಬಾಯಿಬಿಟ್ಟು ಮಾತನಾಡು.<verse eid="PRO 31:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 31:9"/>ಅವರ ಪರವಾಗಿ ಮಾತನಾಡಿ, ನೀತಿನ್ಯಾಯವನ್ನು ಸ್ಥಾಪಿಸು.</para>
  <para style="q2" vid="PRO 31:9">ಬಡವರಿಗಾಗಿಯೂ ದಿಕ್ಕಿಲ್ಲದವರಿಗಾಗಿಯೂ ಹಕ್ಕುಬಾಧ್ಯತೆಯನ್ನು ಕಾಪಾಡು.<verse eid="PRO 31:9"/></para>
  <para style="ms1">ಉಪಸಂಹಾರ: ಗುಣವತಿಯಾದ ಹೆಂಡತಿ</para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 31:10"/>ಗುಣವತಿಯಾದ ಹೆಂಡತಿ ಎಲ್ಲಿ ಸಿಕ್ಕಾಳು?</para>
  <para style="q2" vid="PRO 31:10">ಅವಳು ಹವಳಕ್ಕಿಂತಲೂ ಬಹು ಅಮೂಲ್ಯಳು.<verse eid="PRO 31:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 31:11"/>ಅವಳ ಪತಿಯ ಹೃದಯವು ಅವಳಲ್ಲಿ ಭರವಸೆ ಇಡುತ್ತದೆ,</para>
  <para style="q2" vid="PRO 31:11">ಅವನಿಗೆ ಯಾವ ಆದಾಯದ ಕೊರತೆಯೂ ಇರುವುದಿಲ್ಲ.<verse eid="PRO 31:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 31:12"/>ತನ್ನ ಜೀವಮಾನದಲ್ಲೆಲ್ಲಾ ಆಕೆಯು ಅವನಿಗೆ ಕೆಟ್ಟದ್ದನ್ನಲ್ಲ,</para>
  <para style="q2" vid="PRO 31:12">ಒಳ್ಳೆಯದನ್ನೇ ಮಾಡುವಳು.<verse eid="PRO 31:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 31:13"/>ಆಕೆಯು ಉಣ್ಣೆಯನ್ನೂ ಸೆಣಬನ್ನೂ ತಂದು,</para>
  <para style="q2" vid="PRO 31:13">ತನ್ನ ಚಟುವಟಿಕೆಯ ಕೈಗಳಿಂದ ಕೆಲಸ ಮಾಡುವಳು.<verse eid="PRO 31:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 31:14"/>ಆಕೆಯು ವರ್ತಕರ ಹಡಗುಗಳಂತೆ ಇರುವಳು;</para>
  <para style="q2" vid="PRO 31:14">ದೂರದಿಂದ ಆಹಾರವನ್ನು ಆಕೆಯು ತರುವಳು.<verse eid="PRO 31:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 31:15"/>ಇನ್ನೂ ಕತ್ತಲಿರುವಾಗಲೇ ಆಕೆಯು ಏಳುವಳು;</para>
  <para style="q2" vid="PRO 31:15">ತನ್ನ ಮನೆಯವರಿಗೆ ಆಹಾರವನ್ನು ಕೊಟ್ಟು,</para>
  <para style="q2" vid="PRO 31:15">ತನ್ನ ದಾಸಿಯರಿಗೆ ದಿನದ ಕೆಲಸವನ್ನು ಹಂಚುವಳು.<verse eid="PRO 31:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 31:16"/>ಆಕೆಯು ಹೊಲವನ್ನು ನೋಡಿ, ಅದನ್ನು ಕೊಂಡುಕೊಳ್ಳುತ್ತಾಳೆ.</para>
  <para style="q2" vid="PRO 31:16">ತನ್ನ ಕೈಕೆಲಸದ ಆದಾಯದಿಂದ ದ್ರಾಕ್ಷಾಲತೆಗಳನ್ನು ನೆಡುತ್ತಾಳೆ.<verse eid="PRO 31:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 31:17"/>ಆಕೆಯು ನಡುಕಟ್ಟಿ ಆಸಕ್ತಿಯಿಂದ ಕೆಲಸ ಮಾಡುತ್ತಾಳೆ.</para>
  <para style="q2" vid="PRO 31:17">ತನ್ನ ಶಕ್ತಿಯುತ ತೋಳುಗಳಿಂದ ಕೆಲಸ ಮಾಡುತ್ತಾಳೆ.<verse eid="PRO 31:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 31:18"/>ತನ್ನ ವ್ಯಾಪಾರವು ಲಾಭದಾಯಕವೆಂದು ಅವಳು ನೋಡುತ್ತಾಳೆ.</para>
  <para style="q2" vid="PRO 31:18">ಆಕೆಯ ದೀಪವು ರಾತ್ರಿಯಲ್ಲೆಲ್ಲಾ ಆರದು.<verse eid="PRO 31:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 31:19"/>ಅವಳು ರಾಟೆಯ ಮೇಲೆ ಕೈಹಾಕಿ,</para>
  <para style="q2" vid="PRO 31:19">ಕದಿರನ್ನು ಹಿಡಿಯುತ್ತಾಳೆ.<verse eid="PRO 31:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 31:20"/>ಆಕೆಯು ಬಡವರಿಗಾಗಿ ಕೈ ಬಿಚ್ಚಿ ಕೊಡುತ್ತಾಳೆ.</para>
  <para style="q2" vid="PRO 31:20">ಹೌದು, ದಿಕ್ಕಿಲ್ಲದವರಿಗೆ ದಾನ ಮಾಡುತ್ತಾಳೆ.<verse eid="PRO 31:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 31:21"/>ಚಳಿಗಾಲದಲ್ಲಿ ತನ್ನ ಮನೆಯವರ ಬಗ್ಗೆ ಆಕೆಯು ಚಿಂತಿಸಬೇಕಾಗಿಲ್ಲ.</para>
  <para style="q2" vid="PRO 31:21">ಏಕೆಂದರೆ ಆಕೆಯ ಮನೆಯವರೆಲ್ಲರಿಗೂ ಬೆಚ್ಚನೆಯ ಕಂಬಳಿಗಳಿವೆ.<verse eid="PRO 31:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 31:22"/>ಆಕೆಯು ತಾನೇ ಕಂಬಳಿಗಳನ್ನು ನೇಯುತ್ತಾಳೆ.</para>
  <para style="q2" vid="PRO 31:22">ಆಕೆಯ ಉಡುಪೋ ನಾರುಮಡಿ, ರಕ್ತಾಂಬರ.<verse eid="PRO 31:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 31:23"/>ಆಕೆಯ ಪತಿಯು ಪಟ್ಟಣದಲ್ಲಿ ಸನ್ಮಾನಿತ.</para>
  <para style="q2" vid="PRO 31:23">ದೇಶದ ಹಿರಿಯರ ಮಧ್ಯದಲ್ಲಿ ಪ್ರಸಿದ್ಧನಾಗಿ ಕುಳಿತಿರುವನು.<verse eid="PRO 31:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 31:24"/>ಆಕೆಯು ನಯವಾದ ನಾರುಮಡಿಯನ್ನು ನೇಯ್ದು ಮಾರಾಟ ಮಾಡುತ್ತಾಳೆ.</para>
  <para style="q2" vid="PRO 31:24">ಆಕೆಯು ನಡುಕಟ್ಟುಗಳನ್ನು ತಯಾರಿಸಿ ವರ್ತಕರಿಗೆ ಒದಗಿಸುತ್ತಾಳೆ.<verse eid="PRO 31:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 31:25"/>ಆಕೆಯ ಉಡುಪು ಬಲವೂ ಘನತೆಯೂ ಆಗಿವೆ.</para>
  <para style="q2" vid="PRO 31:25">ಭವಿಷ್ಯತ್ತಿನ ಭಯವಿಲ್ಲದೆ ಆಕೆಯು ನಗುವಳು.<verse eid="PRO 31:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 31:26"/>ಆಕೆಯು ಜ್ಞಾನದಿಂದ ಮಾತನಾಡುತ್ತಾಳೆ.</para>
  <para style="q2" vid="PRO 31:26">ಆಕೆಯ ನಾಲಿಗೆಯ ಮೇಲೆ ನಂಬಿಗಸ್ತ ಶಿಕ್ಷಣ ಇದೆ.<verse eid="PRO 31:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 31:27"/>ಆಕೆಯು ತನ್ನ ಗೃಹಕೃತ್ಯಗಳನ್ನೆಲ್ಲಾ ಚೆನ್ನಾಗಿ ನೋಡಿಕೊಳ್ಳುತ್ತಾಳೆ.</para>
  <para style="q2" vid="PRO 31:27">ಸೋಮಾರಿಯಾಗಿ ಕೆಲಸಮಾಡದೆ ಆಹಾರವನ್ನು ತಿನ್ನುವುದಿಲ್ಲ.<verse eid="PRO 31:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 31:28"/>ಆಕೆಯ ಮಕ್ಕಳು ಎದ್ದು, ಆಕೆಯನ್ನು ಧನ್ಯಳೆಂದು ಕರೆಯುವರು.</para>
  <para style="q2" vid="PRO 31:28">ಆಕೆಯ ಪತಿಯು ಸಹ ಆಕೆಯನ್ನು,<verse eid="PRO 31:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 31:29"/>“ಬಹುಮಂದಿ ಸ್ತ್ರೀಯರು ಗುಣವತಿಯರಾಗಿದ್ದಾರೆ.</para>
  <para style="q2" vid="PRO 31:29">ಆದರೆ ನೀನು ಅವರೆಲ್ಲರಿಗಿಂತಲೂ ಶ್ರೇಷ್ಠಳು,” ಎಂದು ಹೊಗಳುವನು.<verse eid="PRO 31:29"/></para>
  <para style="q1">
    <verse number="30" style="v" sid="PRO 31:30"/>ಸೌಂದರ್ಯವು ಮೋಸಕರವಾದದ್ದು, ಸೌಂದರ್ಯವು ಶಾಶ್ವತವಲ್ಲ.</para>
  <para style="q2" vid="PRO 31:30">ಆದರೆ ಯೆಹೋವ ದೇವರಿಗೆ ಭಯಪಡುವವಳೇ ಪ್ರಶಂಸನೀಯಳು.<verse eid="PRO 31:30"/></para>
  <para style="q1">
    <verse number="31" style="v" sid="PRO 31:31"/>ಆಕೆಯ ಕೈಕೆಲಸಕ್ಕೆ ತಕ್ಕ ಪ್ರತಿಫಲವನ್ನು ಸಲ್ಲಿಸಿ ಗೌರವಿಸಿರಿ.</para>
  <para style="q2" vid="PRO 31:31">ಪಟ್ಟಣದ ದ್ವಾರಗಳಲ್ಲಿ ಆಕೆಯ ಕಾರ್ಯಗಳು ಆಕೆಯನ್ನು ಹೊಗಳಲಿ.<verse eid="PRO 31:31"/></para>
  <chapter eid="PRO 31"/>
</usx>
