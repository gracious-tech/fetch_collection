<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="EZR" style="id">- Biblica® Open Kannada Contemporary Version</book>
  <para style="h">ಎಜ್ರ</para>
  <para style="toc1">ಎಜ್ರ</para>
  <para style="toc2">ಎಜ್ರ</para>
  <para style="toc3">ಎಜ್ರ</para>
  <para style="mt1">ಎಜ್ರ</para>
  <chapter number="1" style="c" sid="EZR 1"/>
  <para style="s1">ಕೋರೆಷನು ಸ್ವದೇಶಕ್ಕೆ ಹೋಗುವುದಕ್ಕೆ ಅಪ್ಪಣೆ ಕೊಟ್ಟದ್ದು</para>
  <para style="p">
    <verse number="1" style="v" sid="EZR 1:1"/>ಆದರೆ ಪಾರಸಿಯ ಅರಸ ಕೋರೆಷನ ಮೊದಲನೆಯ ವರ್ಷದಲ್ಲಿ ಯೆಹೋವ ದೇವರು ಯೆರೆಮೀಯನ ಮುಂಖಾತರ ಹೇಳಿದ ವಾಕ್ಯವು ಈಡೇರುವ ಹಾಗೆ ಯೆಹೋವ ದೇವರು ಪಾರಸಿಯ ಅರಸ ಕೋರೆಷನ ಆತ್ಮವನ್ನು ಪ್ರೇರೇಪಿಸಿದ್ದರಿಂದ, ಅವನು ತನ್ನ ಸಮಸ್ತ ರಾಜ್ಯದಲ್ಲಿ ಡಂಗುರದಿಂದಲೂ, ಪತ್ರಗಳಿಂದಲೂ ಸಾರಿ ಹೇಳಿದ್ದೇನೆಂದರೆ:<verse eid="EZR 1:1"/></para>
  <para style="pmo">
    <verse number="2" style="v" sid="EZR 1:2"/>“ಪಾರಸಿಯ ಅರಸ ಕೋರೆಷನು ಹೀಗೆ ಹೇಳುತ್ತಾನೆ:</para>
  <para style="pm" vid="EZR 1:2">“ ‘ಪರಲೋಕದ ದೇವರಾದ ಯೆಹೋವ ದೇವರು ಭೂಲೋಕದ ರಾಜ್ಯಗಳನ್ನೆಲ್ಲಾ ನನಗೆ ಕೊಟ್ಟಿದ್ದಾರೆ ಮತ್ತು ಅವರು ಯೆಹೂದ ದೇಶದ ಯೆರೂಸಲೇಮಿನಲ್ಲಿ ತಮಗೆ ಆಲಯವನ್ನು ಕಟ್ಟಿಸಲು ನನಗೆ ಆಜ್ಞಾಪಿಸಿದ್ದಾರೆ. <verse eid="EZR 1:2"/><verse number="3" style="v" sid="EZR 1:3"/>ನಿಮ್ಮಲ್ಲಿ ಯಾರು ಅವರ ಪ್ರಜೆಗಳಾಗಿರುತ್ತೀರೋ, ಅಂಥವರು ಯೆಹೂದ, ಯೆರೂಸಲೇಮಿಗೆ ಹೋಗಿ, ಅಲ್ಲಿ ವಾಸಿಸುತ್ತಿರುವ ಇಸ್ರಾಯೇಲ್ ದೇವರಾದ ಯೆಹೋವ ದೇವರಿಗೆ ಒಂದು ದೇವಾಲಯವನ್ನು ಕಟ್ಟಲಿ, ಅವರ ಸಂಗಡ ಅವರ ದೇವರು ಇರಲಿ! <verse eid="EZR 1:3"/><verse number="4" style="v" sid="EZR 1:4"/>ಯೆಹೂದ್ಯರಲ್ಲಿ ಬದುಕುಳಿದವರು ಈಗ ವಾಸಿಸುತ್ತಿರುವ ಯಾವುದೇ ಪ್ರದೇಶದಲ್ಲಿ, ಜನರು ಅವರಿಗೆ ಬೆಳ್ಳಿ ಮತ್ತು ಬಂಗಾರ, ಸರಕುಗಳು ಮತ್ತು ಪ್ರಾಣಿಪಶುಗಳನ್ನು ಮತ್ತು ಯೆರೂಸಲೇಮಿನ ದೇವಾಲಯಕ್ಕೆ ಉಚಿತ ಕಾಣಿಕೆಗಳನ್ನು ಒದಗಿಸಬೇಕು.’ ”<verse eid="EZR 1:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="EZR 1:5"/>ಆಗ ಯೆಹೂದ ಹಾಗೂ ಬೆನ್ಯಾಮೀನ್ ಕುಟುಂಬಗಳ ಮುಖ್ಯಸ್ಥರೂ, ಯಾಜಕರೂ, ಲೇವಿಯರೂ, ಯೆರೂಸಲೇಮಿನಲ್ಲಿರುವ ಯೆಹೋವ ದೇವರ ಆಲಯವನ್ನು ಕಟ್ಟುವುದಕ್ಕೆ ಹೋಗಲು ಯೆಹೋವ ದೇವರಿಂದ ಪ್ರೇರಿತರಾದವರೆಲ್ಲರೂ ಎದ್ದರು. <verse eid="EZR 1:5"/><verse number="6" style="v" sid="EZR 1:6"/>ಅವರ ನೆರೆಯವರೆಲ್ಲರು ಎಲ್ಲಾ ಕಾಣಿಕೆಗಳಲ್ಲದೇ, ಬೆಳ್ಳಿ ಹಾಗೂ ಬಂಗಾರದಿಂದ ಮಾಡಿದ ವಸ್ತುಗಳಿಂದಲೂ, ಪಶುಗಳಿಂದಲೂ, ಬೆಲೆಯುಳ್ಳವುಗಳಿಂದಲೂ ಅವರಿಗೆ ಧಾರಾಳವಾಗಿ ಸಹಾಯ ಮಾಡಿದರು.<verse eid="EZR 1:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="EZR 1:7"/>ನೆಬೂಕದ್ನೆಚ್ಚರನು ಯೆರೂಸಲೇಮಿನಿಂದ ತಂದು, ತನ್ನ ದೇವರುಗಳ ಮಂದಿರಗಳಲ್ಲಿ ಇರಿಸಿದ್ದ ಯೆಹೋವ ದೇವರ ಆಲಯದ ಸಲಕರಣೆಗಳನ್ನು ಪಾರಸಿಯ ಅರಸನಾದ ಕೋರೆಷನು ತರಿಸಿದನು. <verse eid="EZR 1:7"/><verse number="8" style="v" sid="EZR 1:8"/>ಅವುಗಳನ್ನು ಪಾರಸಿಯ ಅರಸನಾದ ಕೋರೆಷನು ಬೊಕ್ಕಸದವನಾದ ಮಿತ್ರದಾತನ ಕೈಯಿಂದ ತರಿಸಿ, ಯೆಹೂದದ ರಾಜಕುಮಾರನಾದ ಶೆಷ್ಬಚ್ಚರನಿಗೆ ಎಣಿಸಿಕೊಟ್ಟನು.<verse eid="EZR 1:8"/></para>
  <para style="b"/>
  <para style="li4">
    <verse number="9" style="v" sid="EZR 1:9"/>ಅವುಗಳ ಲೆಕ್ಕವು ಹೀಗಿವೆ:</para>
  <para style="b" vid="EZR 1:9"/>
  <para style="li1" vid="EZR 1:9">ಬಂಗಾರದ 30 ತಟ್ಟೆಗಳು.</para>
  <para style="li1" vid="EZR 1:9">ಬೆಳ್ಳಿಯ 1,000 ತಟ್ಟೆಗಳು.</para>
  <para style="li1" vid="EZR 1:9">ಬೆಳ್ಳಿಯ 29 ಪಾತ್ರೆಗಳು.<verse eid="EZR 1:9"/></para>
  <para style="li1">
    <verse number="10" style="v" sid="EZR 1:10"/>ಬಂಗಾರದ 30 ಬಟ್ಟಲುಗಳು.</para>
  <para style="li1" vid="EZR 1:10">ಬೆಳ್ಳಿಯ 410 ಬಟ್ಟಲುಗಳು.</para>
  <para style="li1" vid="EZR 1:10">ಇನ್ನಿತರು 1,000 ವಸ್ತುಗಳು.<verse eid="EZR 1:10"/></para>
  <para style="b"/>
  <para style="li4">
    <verse number="11" style="v" sid="EZR 1:11"/>ಒಟ್ಟು 5,400 ಬೆಳ್ಳಿಬಂಗಾರದಿಂದ ಮಾಡಿದ ವಸ್ತುಗಳು.</para>
  <para style="b" vid="EZR 1:11"/>
  <para style="p" vid="EZR 1:11">ಇವುಗಳನ್ನೆಲ್ಲಾ ಬಾಬಿಲೋನಿನಿಂದ ಯೆರೂಸಲೇಮಿಗೆ ಪ್ರಯಾಣಮಾಡಿದವರ ಸಂಗಡ ಶೆಷ್ಬಚ್ಚರನು ತೆಗೆದುಕೊಂಡು ಹೋದನು.<verse eid="EZR 1:11"/></para>
  <chapter eid="EZR 1"/>
  <chapter number="2" style="c" sid="EZR 2"/>
  <para style="s1">ಸೆರೆಯಿಂದ ತಿರುಗಿ ಬಂದವರ ಸಂಖ್ಯೆ</para>
  <para style="li4">
    <verse number="1" style="v" sid="EZR 2:1"/>ಬಾಬಿಲೋನಿನ ಅರಸನಾದ ನೆಬೂಕದ್ನೆಚ್ಚರನಿಂದ, ಬಾಬಿಲೋನಿಗೆ ಸೆರೆಯಾಗಿ ಹೋಗಿ, ಅನಂತರ ಬಂಧನದಿಂದ ಬಿಡುಗಡೆಯಾಗಿ ಯೆರೂಸಲೇಮಿಗೂ, ಯೆಹೂದಕ್ಕೂ, ತಮ್ಮ ತಮ್ಮ ಪಟ್ಟಣಗಳಿಗೂ <verse eid="EZR 2:1"/><verse number="2" style="v" sid="EZR 2:2"/>ಜೆರುಬ್ಬಾಬೆಲನ ಸಂಗಡ ಹಿಂದಿರುಗಿದವರು ಯಾರೆಂದರೆ: ಯೇಷೂವ, ನೆಹೆಮೀಯ, ಸೆರಾಯ, ರೆಲಾಯ, ಮೊರ್ದೆಕೈ, ಬಿಲ್ಷಾನ್, ಮಿಸ್ಪಾರ್, ಬಿಗ್ವೈ, ರೆಹೂಮ್ ಹಾಗೂ ಬಾಣ.</para>
  <para style="b" vid="EZR 2:2"/>
  <para style="li4" vid="EZR 2:2">ಇಸ್ರಾಯೇಲ್ ಜನಾಂಗದ ಪುರುಷರ ಸಂಖ್ಯೆ:<verse eid="EZR 2:2"/></para>
  <para style="li1">
    <verse number="3" style="v" sid="EZR 2:3"/>ಪರೋಷನ ವಂಶಜರು 2,172<verse eid="EZR 2:3"/></para>
  <para style="li1">
    <verse number="4" style="v" sid="EZR 2:4"/>ಶೆಫಟ್ಯನ ವಂಶಜರು 372<verse eid="EZR 2:4"/></para>
  <para style="li1">
    <verse number="5" style="v" sid="EZR 2:5"/>ಆರಹನ ವಂಶಜರು 775<verse eid="EZR 2:5"/></para>
  <para style="li1">
    <verse number="6" style="v" sid="EZR 2:6"/>ಯೇಷೂವ, ಯೋವಾಬ್ ಎಂಬವರ ಮಕ್ಕಳಲ್ಲಿ ಪಹತ್ ಮೋವಾಬನ ವಂಶಜರು 2,812<verse eid="EZR 2:6"/></para>
  <para style="li1">
    <verse number="7" style="v" sid="EZR 2:7"/>ಏಲಾಮನ ವಂಶಜರು 1,254<verse eid="EZR 2:7"/></para>
  <para style="li1">
    <verse number="8" style="v" sid="EZR 2:8"/>ಜತ್ತೂವಿನ ವಂಶಜರು 945<verse eid="EZR 2:8"/></para>
  <para style="li1">
    <verse number="9" style="v" sid="EZR 2:9"/>ಜಕ್ಕೈನ ವಂಶಜರು 760<verse eid="EZR 2:9"/></para>
  <para style="li1">
    <verse number="10" style="v" sid="EZR 2:10"/>ಬಾನೀಯ ವಂಶಜರು 642<verse eid="EZR 2:10"/></para>
  <para style="li1">
    <verse number="11" style="v" sid="EZR 2:11"/>ಬೇಬೈನ ವಂಶಜರು 623<verse eid="EZR 2:11"/></para>
  <para style="li1">
    <verse number="12" style="v" sid="EZR 2:12"/>ಅಜ್ಗಾದನ ವಂಶಜರು 1,222<verse eid="EZR 2:12"/></para>
  <para style="li1">
    <verse number="13" style="v" sid="EZR 2:13"/>ಅದೋನೀಕಾಮಿನ ವಂಶಜರು 666<verse eid="EZR 2:13"/></para>
  <para style="li1">
    <verse number="14" style="v" sid="EZR 2:14"/>ಬಿಗ್ವೈ ವಂಶಜರು 2,056<verse eid="EZR 2:14"/></para>
  <para style="li1">
    <verse number="15" style="v" sid="EZR 2:15"/>ಅದೀನನ ವಂಶಜರು 454<verse eid="EZR 2:15"/></para>
  <para style="li1">
    <verse number="16" style="v" sid="EZR 2:16"/>ಹಿಜ್ಕೀಯನ ಮಗನಾದ ಆಟೇರ್ ವಂಶಜರು 98<verse eid="EZR 2:16"/></para>
  <para style="li1">
    <verse number="17" style="v" sid="EZR 2:17"/>ಬೇಚೈಯ ವಂಶಜರು 323<verse eid="EZR 2:17"/></para>
  <para style="li1">
    <verse number="18" style="v" sid="EZR 2:18"/>ಯೋರನ ವಂಶಜರು 112<verse eid="EZR 2:18"/></para>
  <para style="li1">
    <verse number="19" style="v" sid="EZR 2:19"/>ಹಾಷುಮನ ವಂಶಜರು 223<verse eid="EZR 2:19"/></para>
  <para style="li1">
    <verse number="20" style="v" sid="EZR 2:20"/>ಗಿಬ್ಬಾರನ ವಂಶಜರು 95<verse eid="EZR 2:20"/></para>
  <para style="li1">
    <verse number="21" style="v" sid="EZR 2:21"/>ಬೇತ್ಲೆಹೇಮನ ವಂಶಜರು 123<verse eid="EZR 2:21"/></para>
  <para style="li1">
    <verse number="22" style="v" sid="EZR 2:22"/>ನೆಟೋಫದ ಜನರು 56<verse eid="EZR 2:22"/></para>
  <para style="li1">
    <verse number="23" style="v" sid="EZR 2:23"/>ಅನಾತೋತ್ ಊರಿನವರು 128<verse eid="EZR 2:23"/></para>
  <para style="li1">
    <verse number="24" style="v" sid="EZR 2:24"/>ಅಜ್ಮಾವೆತಿನವರು 42<verse eid="EZR 2:24"/></para>
  <para style="li1">
    <verse number="25" style="v" sid="EZR 2:25"/>ಕಿರ್ಯತ್ ಯಾರೀಮ್, ಕೆಫೀರಾ, ಬೇರೋತ್ ಎಂಬ ಪಟ್ಟಣದವರು 743<verse eid="EZR 2:25"/></para>
  <para style="li1">
    <verse number="26" style="v" sid="EZR 2:26"/>ರಾಮಾ ಗೆಬ ಎಂಬ ಪಟ್ಟಣದವರು 621<verse eid="EZR 2:26"/></para>
  <para style="li1">
    <verse number="27" style="v" sid="EZR 2:27"/>ಮಿಕ್ಮಾಷದ ಜನರು 122<verse eid="EZR 2:27"/></para>
  <para style="li1">
    <verse number="28" style="v" sid="EZR 2:28"/>ಬೇತೇಲ್ ಮತ್ತು ಆಯಿ ಎಂಬ ಪಟ್ಟಣದವರು 223<verse eid="EZR 2:28"/></para>
  <para style="li1">
    <verse number="29" style="v" sid="EZR 2:29"/>ನೆಬೋ ಊರಿನವರು 52<verse eid="EZR 2:29"/></para>
  <para style="li1">
    <verse number="30" style="v" sid="EZR 2:30"/>ಮಗ್ಬೀಷನ ಜನರು 156<verse eid="EZR 2:30"/></para>
  <para style="li1">
    <verse number="31" style="v" sid="EZR 2:31"/>ಮತ್ತೊಬ್ಬ ಏಲಾಮನ ವಂಶಜರು 1,254<verse eid="EZR 2:31"/></para>
  <para style="li1">
    <verse number="32" style="v" sid="EZR 2:32"/>ಹಾರಿಮನ ವಂಶಜರು 320<verse eid="EZR 2:32"/></para>
  <para style="li1">
    <verse number="33" style="v" sid="EZR 2:33"/>ಲೋದ್, ಹಾದೀದ್, ಓನೋ ಎಂಬ ಊರಿನ ಜನರು 725<verse eid="EZR 2:33"/></para>
  <para style="li1">
    <verse number="34" style="v" sid="EZR 2:34"/>ಯೆರಿಕೋವಿನ ವಂಶಜರು 345<verse eid="EZR 2:34"/></para>
  <para style="li1">
    <verse number="35" style="v" sid="EZR 2:35"/>ಸೆನಾಹನ ವಂಶಜರು 3,630.<verse eid="EZR 2:35"/></para>
  <para style="b"/>
  <para style="li4">
    <verse number="36" style="v" sid="EZR 2:36"/>ಯಾಜಕರು:</para>
  <para style="li1" vid="EZR 2:36">ಯೇಷೂವನ ಕುಟುಂಬದವರಾದ ಯೆದಾಯನ ವಂಶಜರು 973<verse eid="EZR 2:36"/></para>
  <para style="li1">
    <verse number="37" style="v" sid="EZR 2:37"/>ಇಮ್ಮೇರನ ವಂಶಜರು 1,052<verse eid="EZR 2:37"/></para>
  <para style="li1">
    <verse number="38" style="v" sid="EZR 2:38"/>ಪಷ್ಹೂರನ ವಂಶಜರು 1,247<verse eid="EZR 2:38"/></para>
  <para style="li1">
    <verse number="39" style="v" sid="EZR 2:39"/>ಹಾರಿಮನ ವಂಶಜರು 1,017.<verse eid="EZR 2:39"/></para>
  <para style="b"/>
  <para style="li4">
    <verse number="40" style="v" sid="EZR 2:40"/>ಲೇವಿಯರು: ಹೋದವ್ಯನ ಸಂತತಿಯಾದ ಯೇಷೂವನ, ಕದ್ಮಿಯೇಲನ ವಂಶಜರು 74.<verse eid="EZR 2:40"/></para>
  <para style="b"/>
  <para style="li4">
    <verse number="41" style="v" sid="EZR 2:41"/>ಹಾಡುಗಾರರು: ಆಸಾಫನ ವಂಶಜರು 128.<verse eid="EZR 2:41"/></para>
  <para style="b"/>
  <para style="li4">
    <verse number="42" style="v" sid="EZR 2:42"/>ದೇವಾಲಯದ ದ್ವಾರಪಾಲಕರಾದ ಶಲ್ಲೂಮ್, ಆಟೇರ್, ಟಲ್ಮೋನ್, ಅಕ್ಕೂಬ್, ಹಟೀಟ, ಶೋಬೈ ಮುಂತಾದವರ ಮಕ್ಕಳು ಒಟ್ಟು 139.<verse eid="EZR 2:42"/></para>
  <para style="b"/>
  <para style="li4">
    <verse number="43" style="v" sid="EZR 2:43"/>ದೇವಾಲಯದ ಸೇವಕರು: ಜೀಹ, ಹಸೂಫ, ಟಬ್ಬಾವೋತ್ ಇವರ ವಂಶಜರು.<verse eid="EZR 2:43"/></para>
  <para style="li1">
    <verse number="44" style="v" sid="EZR 2:44"/>ಕೆರೋಸ್, ಸೀಯಹಾ, ಪದೋನ್,<verse eid="EZR 2:44"/></para>
  <para style="li1">
    <verse number="45" style="v" sid="EZR 2:45"/>ಲೆಬಾನ, ಹಗಾಬ, ಅಕ್ಕೂಬ್<verse eid="EZR 2:45"/></para>
  <para style="li1">
    <verse number="46" style="v" sid="EZR 2:46"/>ಹಗಾಬ್, ಶಲ್ಮೈ, ಹಾನಾನ್,<verse eid="EZR 2:46"/></para>
  <para style="li1">
    <verse number="47" style="v" sid="EZR 2:47"/>ಗಿದ್ದೇಲ್, ಗಹರ್, ರೆವಾಯ,<verse eid="EZR 2:47"/></para>
  <para style="li1">
    <verse number="48" style="v" sid="EZR 2:48"/>ರೆಚೀನ್, ನೆಕೋದ, ಗಜ್ಜಾಮ್,<verse eid="EZR 2:48"/></para>
  <para style="li1">
    <verse number="49" style="v" sid="EZR 2:49"/>ಉಜ್ಜ, ಪಾಸೇಹ, ಬೇಸೈ,<verse eid="EZR 2:49"/></para>
  <para style="li1">
    <verse number="50" style="v" sid="EZR 2:50"/>ಅಸ್ನ, ಮೆಯನೀಮ್, ನೆಫೀಸೀಮ್,<verse eid="EZR 2:50"/></para>
  <para style="li1">
    <verse number="51" style="v" sid="EZR 2:51"/>ಬಕ್ಬೂಕ್, ಹಕ್ಕೂಫ, ಹರ್ಹೂರ್,<verse eid="EZR 2:51"/></para>
  <para style="li1">
    <verse number="52" style="v" sid="EZR 2:52"/>ಬಚ್ಲೂತ್, ಮೆಹೀದ, ಹರ್ಷ,<verse eid="EZR 2:52"/></para>
  <para style="li1">
    <verse number="53" style="v" sid="EZR 2:53"/>ಬರ್ಕೋಸ್, ಸೀಸೆರ, ತೆಮಹ,<verse eid="EZR 2:53"/></para>
  <para style="li1">
    <verse number="54" style="v" sid="EZR 2:54"/>ನೆಚೀಹ, ಹಟೀಫ, ಇವರ ವಂಶಜರು.<verse eid="EZR 2:54"/></para>
  <para style="li4">
    <verse number="55" style="v" sid="EZR 2:55"/>ಸೊಲೊಮೋನನ ಸೇವಕರ ವಂಶಜರು: ಸೋಟೈ, ಹಸ್ಸೋಫೆರೆತ್, ಪೆರೂದ,<verse eid="EZR 2:55"/></para>
  <para style="li1">
    <verse number="56" style="v" sid="EZR 2:56"/>ಯಾಲ, ದರ್ಕೋನ್, ಗಿದ್ದೇಲ್,<verse eid="EZR 2:56"/></para>
  <para style="li1">
    <verse number="57" style="v" sid="EZR 2:57"/>ಶೆಫಟ್ಯ, ಹಟ್ಟೀಲ್, ಪೋಕೆರೆತ್ ಹಚ್ಚೆಬಾಯೀಮ್, ಮತ್ತು ಆಮೀ ಇವರ ವಂಶಜರು.<verse eid="EZR 2:57"/></para>
  <para style="li1">
    <verse number="58" style="v" sid="EZR 2:58"/>ದೇವಾಲಯದ ಸೇವಕರ ಹಾಗೂ ಸೊಲೊಮೋನನ ಸೇವಕರ ವಂಶಜರು ಒಟ್ಟು 392 ಮಂದಿ.<verse eid="EZR 2:58"/></para>
  <para style="b"/>
  <para style="li4">
    <verse number="59" style="v" sid="EZR 2:59"/>ತೇಲ್ಮೆಲಹ, ತೇಲ್ಹರ್ಷ, ಕೆರೂಬ್, ಅದ್ದಾನ್, ಇಮ್ಮೇರ್ ಎಂಬ ಊರುಗಳಿಂದ ಹೊರಟುಬಂದವರಾಗಿದ್ದು, ತಮ್ಮ ಗೋತ್ರವಂಶಾವಳಿಗಳನ್ನು ತೋರಿಸಿ, ತಾವು ಇಸ್ರಾಯೇಲರೆಂಬುದನ್ನು ರುಜುಪಡಿಸಲಾಗದೇ ಇದ್ದವರು ಯಾರೆಂದರೆ:<verse eid="EZR 2:59"/></para>
  <para style="li1">
    <verse number="60" style="v" sid="EZR 2:60"/>ದೆಲಾಯ, ಟೋಬೀಯ, ನೆಕೋದ ಇವರ ಸಂತಾನದವರು ಒಟ್ಟು 652 ಮಂದಿ.<verse eid="EZR 2:60"/></para>
  <para style="b"/>
  <para style="li4">
    <verse number="61" style="v" sid="EZR 2:61"/>ಯಾಜಕರಲ್ಲಿ:</para>
  <para style="li1" vid="EZR 2:61">ಹಬಯ್ಯ, ಹಕ್ಕೋಚ್, ಬರ್ಜಿಲ್ಲೈ ಇವರ ಸಂತಾನದವರು.</para>
  <para style="li2" vid="EZR 2:61">ಈ ಬರ್ಜಿಲ್ಲೈ ಎಂಬವನು ಗಿಲ್ಯಾದ್ಯನಾದ ಬರ್ಜಿಲ್ಲೈಯನ ಪುತ್ರಿಯರಲ್ಲಿ ಒಬ್ಬಳನ್ನು ಮದುವೆಮಾಡಿಕೊಂಡ ಕಾರಣ, ಅವನ ಹೆಸರನ್ನು ಇಟ್ಟುಕೊಂಡಿದ್ದನು.<verse eid="EZR 2:61"/></para>
  <para style="li4">
    <verse number="62" style="v" sid="EZR 2:62"/>ಇವರು ತಮ್ಮ ವಂಶಾವಳಿಯ ದಾಖಲಾತಿಗಳಲ್ಲಿ ತಮ್ಮ ಹೆಸರುಗಳನ್ನು ಹುಡುಕಿದರು, ಆದರೆ ಅವು ಸಿಕ್ಕದೆ ಹೋದದ್ದರಿಂದ ಅವರು ಅಶುದ್ಧರೆಂದು ಪರಿಗಣಿಸಿ ಯಾಜಕ ಉದ್ಯೋಗದಿಂದ ಬಹಿಷ್ಕಾರವಾದರು. <verse eid="EZR 2:62"/><verse number="63" style="v" sid="EZR 2:63"/>ಆದ್ದರಿಂದ ಊರೀಮ್, ತುಮ್ಮೀಮ್ ಮುಖಾಂತರ ದೈವನಿರ್ಣಯವನ್ನು ತಿಳಿಸಬಲ್ಲ ಯಾಜಕನು ದೊರೆಯುವ ತನಕ, ಇವರು ಮಹಾಪರಿಶುದ್ಧವಾದ ಪದಾರ್ಥಗಳನ್ನು ತಿನ್ನಬಾರದೆಂದು ರಾಜ್ಯಪಾಲನು ಆದೇಶಿಸಿದನು.<verse eid="EZR 2:63"/></para>
  <para style="b"/>
  <para style="li4">
    <verse number="64" style="v" sid="EZR 2:64"/>ಹೀಗೆ ಹಿಂದಿರುಗಿ ಬಂದು, ಸಭೆ ಸೇರಿದ ಸರ್ವಸಮೂಹದ ಒಟ್ಟು ಸಂಖ್ಯೆ 42,360. <verse eid="EZR 2:64"/><verse number="65" style="v" sid="EZR 2:65"/>ಅವರ ಹೊರತಾಗಿ ಅವರ ದಾಸರೂ, ದಾಸಿಯರೂ 7,337 ಮಂದಿಯೂ, ಅವರ ಹಾಡುಗಾರರೂ, ಹಾಡುಗಾರ್ತಿಯರೂ 200 ಮಂದಿ ಇದ್ದರು. <verse eid="EZR 2:65"/><verse number="66" style="v" sid="EZR 2:66"/>ಅವರ 736 ಕುದುರೆಗಳು, ಅವರ 245 ಹೇಸರಕತ್ತೆಗಳು, <verse eid="EZR 2:66"/><verse number="67" style="v" sid="EZR 2:67"/>ಅವರ 435 ಒಂಟೆಗಳು, ಅವರ ಒಟ್ಟು 6,720 ಕತ್ತೆಗಳು.<verse eid="EZR 2:67"/></para>
  <para style="b"/>
  <para style="p">
    <verse number="68" style="v" sid="EZR 2:68"/>ಅವರು ಯೆರೂಸಲೇಮಿನಲ್ಲಿರುವ ಯೆಹೋವ ದೇವರ ಆಲಯಕ್ಕೆ ಬಂದ ತರುವಾಯ, ಕುಟುಂಬಗಳ ಕೆಲವು ಮುಖ್ಯಸ್ಥರು ದೇವರ ಆಲಯವನ್ನು ಅದರ ಸ್ಥಳದಲ್ಲಿ ಕಟ್ಟುವುದಕ್ಕೆ ಉಚಿತವಾದ ಕಾಣಿಕೆಗಳನ್ನು ಕೊಟ್ಟರು. <verse eid="EZR 2:68"/><verse number="69" style="v" sid="EZR 2:69"/>ಅವರು ತಮ್ಮ ಶಕ್ತಿಗೆ ತಕ್ಕ ಹಾಗೆ ಕೆಲಸಕ್ಕಾಗಿ ಬೊಕ್ಕಸಕ್ಕೆ 400 ಕಿಲೋಗ್ರಾಂ ಬಂಗಾರವನ್ನೂ, 2,800 ಕಿಲೋಗ್ರಾಂ ಬೆಳ್ಳಿಯನ್ನೂ, ನೂರು ಯಾಜಕರ ಅಂಗಿಗಳನ್ನೂ ಕೊಟ್ಟರು.<verse eid="EZR 2:69"/></para>
  <para style="p">
    <verse number="70" style="v" sid="EZR 2:70"/>ಯಾಜಕರೂ, ಲೇವಿಯರೂ, ದ್ವಾರಪಾಲಕರೂ, ಹಾಡುಗಾರರೂ, ದೇವಾಲಯದ ಸೇವಕರೂ ತಮ್ಮ ತಮ್ಮ ಪಟ್ಟಣಗಳಲ್ಲಿಯೂ ಉಳಿದ ಇಸ್ರಾಯೇಲರು ತಮ್ಮ ಪಟ್ಟಣಗಳಲ್ಲಿಯೂ ವಾಸವಾಗಿದ್ದರು.<verse eid="EZR 2:70"/></para>
  <chapter eid="EZR 2"/>
  <chapter number="3" style="c" sid="EZR 3"/>
  <para style="s1">ಬಲಿಪೀಠವನ್ನು ಪುನಃ ನಿರ್ಮಿಸಿದ್ದು</para>
  <para style="p">
    <verse number="1" style="v" sid="EZR 3:1"/>ತಮ್ಮ ತಮ್ಮ ಪಟ್ಟಣಗಳಲ್ಲಿ ವಾಸಿಸುತ್ತಿದ್ದ ಇಸ್ರಾಯೇಲರು, ಏಳನೆಯ ತಿಂಗಳಿನಲ್ಲಿ ಏಕಮನಸ್ಸಿನಿಂದ ಯೆರೂಸಲೇಮಿಗೆ ಕೂಡಿಬಂದರು. <verse eid="EZR 3:1"/><verse number="2" style="v" sid="EZR 3:2"/>ಆಗ ಯೋಚಾದಾಕನ ಮಗನಾದ ಯೇಷೂವನೂ, ಅವನ ಜೊತೆ ಯಾಜಕರೂ, ಶೆಯಲ್ತಿಯೇಲನ ಮಗ ಜೆರುಬ್ಬಾಬೆಲನೂ, ಅವನ ಸಹಾಯಕರು ಎದ್ದು ದೇವರ ಮನುಷ್ಯನಾದ ಮೋಶೆಯ ನಿಯಮದಲ್ಲಿ ಬರೆದಿರುವ ಹಾಗೆ ದಹನಬಲಿಗಳನ್ನು ಅರ್ಪಿಸುವುದಕ್ಕೆ ಇಸ್ರಾಯೇಲ್ ದೇವರ ಬಲಿಪೀಠವನ್ನು ಕಟ್ಟಿಸಿದರು. <verse eid="EZR 3:2"/><verse number="3" style="v" sid="EZR 3:3"/>ಸುತ್ತಮುತ್ತಲಿನ ಜನರ ಭಯವಿದ್ದರೂ, ಅವರು ಬಲಿಪೀಠವನ್ನು ಅದರ ಅಸ್ತಿವಾರದ ಮೇಲೆ ಕಟ್ಟಿದರು. ಅದರ ಮೇಲೆ ಯೆಹೋವ ದೇವರಿಗೆ ದಹನಬಲಿಗಳನ್ನು ಉದಯದಲ್ಲಿಯೂ, ಸಾಯಂಕಾಲದಲ್ಲಿಯೂ ಅರ್ಪಿಸಿದರು. <verse eid="EZR 3:3"/><verse number="4" style="v" sid="EZR 3:4"/>ಇದಲ್ಲದೆ ದೇವರ ನಿಯಮದಲ್ಲಿ ಬರೆದಿರುವಂತೆ ಅವರು ಗುಡಾರಗಳ ಹಬ್ಬವನ್ನು ಆಚರಿಸಿ ಪ್ರತಿದಿನದ ಕಾರ್ಯಕ್ಕೆ ತಕ್ಕ ನೇಮಕದ ಹಾಗೆ ಲೆಕ್ಕದಿಂದ ಪ್ರತಿದಿನದ ದಹನಬಲಿಗಳನ್ನು ಅರ್ಪಿಸಿದರು. <verse eid="EZR 3:4"/><verse number="5" style="v" sid="EZR 3:5"/>ಅದರ ತರುವಾಯ ಅವರು ನಿತ್ಯ ದಹನಬಲಿ, ಅಮಾವಾಸ್ಯೆ ಬಲಿ, ಯೆಹೋವ ದೇವರ ಎಲ್ಲಾ ಪರಿಶುದ್ಧ ಹಬ್ಬಗಳಲ್ಲಿಯೂ ಜನರು ಅರ್ಪಿಸುವ ಸ್ವಂತ ಇಚ್ಛೆಯಿಂದ ತಂದ ಬಲಿದಾನಗಳ ಬಲಿಯನ್ನೂ ಸಮರ್ಪಿಸಿದರು. <verse eid="EZR 3:5"/><verse number="6" style="v" sid="EZR 3:6"/>ಏಳನೆಯ ತಿಂಗಳಿನ, ಮೊದಲನೆಯ ದಿವಸದಲ್ಲಿ ಯೆಹೋವ ದೇವರಿಗೆ ದಹನಬಲಿಗಳನ್ನು ಅರ್ಪಿಸಲು ಪ್ರಾರಂಭಿಸಿದರು. ಆದರೆ ಯೆಹೋವ ದೇವರ ಮಂದಿರದ ಅಸ್ತಿವಾರವನ್ನು ಇನ್ನೂ ಹಾಕಿರಲಿಲ್ಲ.<verse eid="EZR 3:6"/></para>
  <para style="s1">ದೇವಾಲಯವನ್ನು ಪುನಃ ನಿರ್ಮಿಸಿದ್ದು</para>
  <para style="p">
    <verse number="7" style="v" sid="EZR 3:7"/>ಅವರು ಕಲ್ಲುಕುಟಿಕರಿಗೂ, ಬಡಗಿಯವರಿಗೂ, ಹಣವನ್ನು ಕೊಟ್ಟು ಪಾರಸಿಯ ಅರಸನಾದ ಕೋರೆಷನಿಂದ ಹೊಂದಿದ ಅಪ್ಪಣೆಯ ಪ್ರಕಾರ, ಲೆಬನೋನಿನಿಂದ ಯೊಪ್ಪದ ಸಮುದ್ರದ ಮಟ್ಟಿಗೂ ದೇವದಾರು ಮರಗಳನ್ನು ತೆಗೆದುಕೊಂಡು ಬರಲು ಸೀದೋನ್ಯರಿಗೂ, ಟೈರಿನವರಿಗೂ ಅನ್ನಪಾನಗಳನ್ನೂ, ಎಣ್ಣೆಯನ್ನೂ ಕೊಟ್ಟರು.<verse eid="EZR 3:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="EZR 3:8"/>ಅವರು ಯೆರೂಸಲೇಮಿನಲ್ಲಿದ್ದ ದೇವರ ಆಲಯಕ್ಕೆ ಬಂದ ಎರಡನೆಯ ವರ್ಷದ, ಎರಡನೆಯ ತಿಂಗಳಲ್ಲಿ ಶೆಯಲ್ತಿಯೇಲನ ಮಗ ಜೆರುಬ್ಬಾಬೆಲನೂ, ಯೋಚಾದಾಕನ ಮಗ ಯೇಷೂವನೂ, ಉಳಿದ ಅವರ ಸಹೋದರರಾದ ಯಾಜಕರೂ, ಲೇವಿಯರೂ ಸೆರೆಯಿಂದ ಯೆರೂಸಲೇಮಿಗೆ ಬಂದ ಎಲ್ಲರೂ, ಕೆಲಸವನ್ನು ಪ್ರಾರಂಭಿಸಿ ಇಪ್ಪತ್ತು ವರ್ಷ ಪ್ರಾಯಕ್ಕೆ ಹೆಚ್ಚಿದ ಲೇವಿಯರನ್ನು ಯೆಹೋವ ದೇವರ ಆಲಯದ ಕೆಲಸ ಮಾಡುವವರ ಮೇಲೆ ಮೇಲ್ವಿಚಾರಕರನ್ನಾಗಿ ನೇಮಿಸಿದರು. <verse eid="EZR 3:8"/><verse number="9" style="v" sid="EZR 3:9"/>ಯೇಷೂವನೂ, ಅವನ ಮಕ್ಕಳೂ, ಅವನ ಸಹೋದರರೂ, ಕದ್ಮಿಯೇಲ್ ಮತ್ತು ಅವನ ಮಕ್ಕಳೂ, ಇವರು ಹೋದವ್ಯನ<note caller="+" style="f"><char style="fr" closed="false">3:9 </char><char style="fq" closed="false">ಹೋದವ್ಯನ </char><char style="ft" closed="false">ಅಥವಾ </char><char style="fqa" closed="false">ಯೆಹೂದ</char></note> ವಂಶಜರು. ಹೇನಾದಾದನ ಮಕ್ಕಳೂ, ಅವರ ಮಕ್ಕಳೂ, ಅವರ ಸಹೋದರರೂ, ಲೇವಿಯರೂ ಆಗ ದೇವರ ಆಲಯದಲ್ಲಿ ಕೆಲಸ ಮಾಡುವವರ ಮೇಲ್ವಿಚಾರಣೆ ಮಾಡಲು ನಿಂತರು.<verse eid="EZR 3:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="EZR 3:10"/>ಕಟ್ಟುವವರು ಯೆಹೋವ ದೇವರ ಮಂದಿರಕ್ಕೆ ಅಸ್ತಿವಾರ ಹಾಕಿದಾಗ ಇಸ್ರಾಯೇಲಿನ ಅರಸನಾದ ದಾವೀದನ ಕಟ್ಟಳೆಯ ಪ್ರಕಾರ ಯೆಹೋವ ದೇವರನ್ನು ಸ್ತುತಿಸುವುದಕ್ಕೆ ವಸ್ತ್ರಗಳನ್ನು ಧರಿಸಿಕೊಂಡವರಾಗಿ ತುತೂರಿಗಳನ್ನೂದುವ ಯಾಜಕರನ್ನೂ, ತಾಳಗಳನ್ನು ಬಡಿಯುವ ಆಸಾಫನ ಮಕ್ಕಳಾದ ಲೇವಿಯರನ್ನೂ ಸಿದ್ಧಪಡಿಸಿದರು. <verse eid="EZR 3:10"/><verse number="11" style="v" sid="EZR 3:11"/>ಪರಸ್ಪರವಾಗಿ ಹಾಡುತ್ತಾ, ಕೃತಜ್ಞತಾಸ್ತುತಿ ಮಾಡುತ್ತಾ ಯೆಹೋವ ದೇವರನ್ನು ಕೀರ್ತಿಸಿದರು:</para>
  <para style="q1" vid="EZR 3:11">“ಯೆಹೋವ ದೇವರು ಒಳ್ಳೆಯವರು!</para>
  <para style="q2" vid="EZR 3:11">ಅವರ ಅಚಲ ಪ್ರೀತಿ ಇಸ್ರಾಯೇಲರ ಮೇಲೆ ಶಾಶ್ವತ!”</para>
  <para style="m" vid="EZR 3:11">ಈ ಸ್ತುತಿ ಕೀರ್ತನೆ ಕೇಳಿಸಿದ ಕೂಡಲೆ, ಯೆಹೋವ ದೇವರ ಆಲಯಕ್ಕೆ ಅಸ್ತಿವಾರ ಹಾಕಲಾಯಿತೆಂದು ಜನರೆಲ್ಲರು ಉತ್ಸಾಹಧ್ವನಿಯಿಂದ ಆರ್ಭಟಿಸಿದರು. <verse eid="EZR 3:11"/><verse number="12" style="v" sid="EZR 3:12"/>ಮೊದಲಿನ ಮಂದಿರವನ್ನು ಕಂಡಿದ್ದ ವೃದ್ಧರಾದ ಯಾಜಕರೂ ಲೇವಿಯ ಅನೇಕ ಕುಟುಂಬಗಳ ಪ್ರಮುಖರೂ ಅನೇಕರು ಈ ಮಂದಿರದ ಅಸ್ತಿವಾರವನ್ನು ತಮ್ಮ ಮುಂದೆ ಹಾಕುತ್ತಿರುವಾಗ ದೊಡ್ಡ ಶಬ್ದದಿಂದ ಅತ್ತರು. <verse eid="EZR 3:12"/><verse number="13" style="v" sid="EZR 3:13"/>ಜನರು ಹೀಗೆ ಮಹಾಧ್ವನಿಯಿಂದ ಆರ್ಭಟಿಸುತ್ತಾ ಇದ್ದುದರಿಂದ, ಹರ್ಷಧ್ವನಿ ಯಾವುದು, ಅಳುವವರ ಧ್ವನಿ ಯಾವುದು ಎಂದು ಗುರುತಿಸಲಾಗಲಿಲ್ಲ. ಗದ್ದಲವು ಬಹು ದೂರದವರೆಗೂ ಕೇಳಿಸುತ್ತಿತ್ತು.<verse eid="EZR 3:13"/></para>
  <chapter eid="EZR 3"/>
  <chapter number="4" style="c" sid="EZR 4"/>
  <para style="s1">ದೇವಾಲಯವನ್ನು ಪುನಃ ಕಟ್ಟುವುದಕ್ಕೆ ಅಡ್ಡಿ ಮಾಡಿದ್ದು</para>
  <para style="p">
    <verse number="1" style="v" sid="EZR 4:1"/>ಸೆರೆಯಿಂದ ಬಂದವರು ಇಸ್ರಾಯೇಲ್ ದೇವರಾದ ಯೆಹೋವ ದೇವರಿಗಾಗಿ ಆಲಯವನ್ನು ಕಟ್ಟುತ್ತಾರೆಂಬುದಾಗಿ ಯೆಹೂದದ ಮತ್ತು ಬೆನ್ಯಾಮೀನನ ಶತ್ರುಗಳು ಕೇಳಿದಾಗ <verse eid="EZR 4:1"/><verse number="2" style="v" sid="EZR 4:2"/>ಅವರು ಜೆರುಬ್ಬಾಬೆಲನ ಬಳಿಗೂ, ಕುಟುಂಬಗಳ ಮುಖ್ಯಸ್ಥರ ಬಳಿಗೂ ಬಂದು ಅವರಿಗೆ, “ನಾವು ನಿಮ್ಮ ಹಾಗೆ ನಿಮ್ಮ ದೇವರನ್ನು ಹುಡುಕುತ್ತೇವೆ. ನಮ್ಮನ್ನು ಇಲ್ಲಿಗೆ ಬರಮಾಡಿದ ಅಸ್ಸೀರಿಯದ ಅರಸನಾದ ಏಸರ್‌ಹದ್ದೋನ್ ಎಂಬವನ ದಿವಸಗಳು ಮೊದಲುಗೊಂಡು, ಅವರಿಗೆ ನಾವೂ ಬಲಿಯನ್ನು ಅರ್ಪಿಸುತ್ತಾ ಇದ್ದೇವೆ, ಕಟ್ಟುವುದರಲ್ಲಿ ನಾವು ಸಹಾಯ ಮಾಡುತ್ತೇವೆ,” ಎಂದರು.<verse eid="EZR 4:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="EZR 4:3"/>ಆದರೆ ಜೆರುಬ್ಬಾಬೆಲನೂ, ಯೇಷೂವನೂ, ಮಿಕ್ಕಾದ ಇಸ್ರಾಯೇಲಿನ ಕುಟುಂಬಗಳ ಮುಖ್ಯಸ್ಥರೂ ಅವರಿಗೆ, “ನಮ್ಮ ದೇವರಿಗೆ ಆಲಯವನ್ನು ಕಟ್ಟುವುದರಲ್ಲಿ ನಿಮಗೆ ಭಾಗವಿಲ್ಲ. ಪಾರಸಿಯ ಅರಸನಾದ ಕೋರೆಷನು ನಮಗೆ ಆಜ್ಞಾಪಿಸಿದ ಹಾಗೆ, ನಾವು ಇಸ್ರಾಯೇಲ್ ದೇವರಾಗಿರುವ ಯೆಹೋವ ದೇವರಿಗೆ ಅದನ್ನು ಕಟ್ಟುವೆವು,” ಎಂದರು.<verse eid="EZR 4:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="EZR 4:4"/>ಆಗ ಸುತ್ತಲಿದ್ದ ಜನಾಂಗಗಳವರು ಯೆಹೂದದ ಜನರನ್ನು ನಿರಾಶರನ್ನಾಗಿ ಮಾಡಲು ಮತ್ತು ಕಟ್ಟುವುದನ್ನು ಮುಂದುವರಿಸುವ ವಿಷಯದಲ್ಲಿ ಭಯಪಡಿಸಲು ಮುಂದಿದ್ದರು. <verse eid="EZR 4:4"/><verse number="5" style="v" sid="EZR 4:5"/>ಪಾರಸಿಯ ಅರಸನಾದ ಕೋರೆಷನ ದಿನಗಳಿಂದ ಹಿಡಿದು, ಪಾರಸಿಯ ಅರಸನಾದ ದಾರ್ಯಾವೆಷನ ಆಳ್ವಿಕೆಯವರೆಗೂ, ಅವರ ಯೋಚನೆಯನ್ನು ವ್ಯರ್ಥಮಾಡುವುದಕ್ಕೆ ಅವರ ವಿರೋಧವಾಗಿ ವಕೀಲರನ್ನು ಹಣಕೊಟ್ಟು ಇಟ್ಟುಕೊಂಡರು.<verse eid="EZR 4:5"/></para>
  <para style="s1">ಅಹಷ್ವೇರೋಷನ ಮತ್ತು ಅರ್ತಷಸ್ತನ ಆಳ್ವಿಕೆಯಲ್ಲಿ ವಿರೋಧ</para>
  <para style="p">
    <verse number="6" style="v" sid="EZR 4:6"/>ಆದರೆ ಅಹಷ್ವೇರೋಷನು ಆಳುವಾಗ, ಅವನ ಆಳ್ವಿಕೆಯ ಪ್ರಾರಂಭದಲ್ಲಿ, ಅವರು ಯೆಹೂದ ಮತ್ತು ಯೆರೂಸಲೇಮಿನ ನಿವಾಸಿಗಳಿಗೆ ವಿರೋಧವಾಗಿ ದೂರು ಸಲ್ಲಿಸಿದರು.<verse eid="EZR 4:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="EZR 4:7"/>ಅರ್ತಷಸ್ತನ ದಿವಸಗಳಲ್ಲಿ ಬಿಷ್ಲಾಮನೂ, ಮಿತ್ರದಾತನೂ, ಟಾಬೆಯೇಲನೂ, ಮಿಕ್ಕಾದ ಅವರ ಜೊತೆಗಾರರೂ ಪಾರಸಿಯ ಅರಸನಾದ ಅರ್ತಷಸ್ತನಿಗೆ ಒಂದು ಪತ್ರ ಬರೆದರು. ಬರೆದ ಆ ಪತ್ರವು ಅರಾಮ್ಯ ಭಾಷೆಯಲ್ಲಿಯೂ, ಅರಾಮ್ಯ ಲಿಪಿಯಲ್ಲಿಯೂ ಇತ್ತು.<verse eid="EZR 4:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="EZR 4:8"/>ದೇಶಾಧಿಪತಿಯಾದ ರೆಹೂಮ್ ಹಾಗು ಕಾರ್ಯದರ್ಶಿ ಶಿಂಷೈ, ಯೆರೂಸಲೇಮಿಗೆ ವಿರೋಧವಾಗಿ ಈ ಕೆಳಗೆ ಕಂಡಂತೆ ಕಾಗದವನ್ನು ಬರೆದು ಅರ್ತಷಸ್ತನಿಗೆ ಕಳುಹಿಸಿದ್ದರು.<verse eid="EZR 4:8"/></para>
  <para style="pmo">
    <verse number="9" style="v" sid="EZR 4:9"/>ದೇಶಾಧಿಪತಿಯಾದ ರೆಹೂಮ್ ಹಾಗು ಕಾರ್ಯದರ್ಶಿ ಶಿಂಷೈ, ಪರ್ಷಿಯಾ, ಯೆರೆಕ್ ಹಾಗೂ ಬಾಬೆಲಿನವರು, ಶೂಷನಿನವರ ಮತ್ತು ಏಲಾಮ್ಯರ ನ್ಯಾಯಾಧೀಶರು, ಅಧಿಕಾರಿಗಳು ಮತ್ತು ಆಡಳಿತಗಾರರು, <verse eid="EZR 4:9"/><verse number="10" style="v" sid="EZR 4:10"/>ಮತ್ತು ಮಹಾ ಶ್ರೀಮತ್ ಆಸೆನಪ್ಪರನು ಕರೆದುತಂದು ಸಮಾರ್ಯ ಪಟ್ಟಣದಲ್ಲಿ ಮತ್ತು ಯೂಫ್ರೇಟೀಸ್ ನದಿಯ ಈಚೆಗಿರುವ ಬೇರೆ ಊರುಗಳಲ್ಲಿ ಇರಿಸಿದ ಇತರ ಜನರು, ಬರೆಯುವುದು ಏನೆಂದರೆ:<verse eid="EZR 4:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="EZR 4:11"/>ಅವರು ಅರಸನಿಗೆ ಕಳುಹಿಸಿದ ಪತ್ರದ ಪ್ರತಿ ಈ ರೀತಿಯಿತ್ತು:</para>
  <para style="pmo" vid="EZR 4:11">ಅರ್ತಷಸ್ತ ರಾಜರಿಗೆ,</para>
  <para style="pmo" vid="EZR 4:11">ತಮ್ಮ ಸೇವಕರಾದ ಯೂಫ್ರೇಟೀಸ್ ನದಿಯ ಈಚೆಯವರು:<verse eid="EZR 4:11"/></para>
  <para style="pm">
    <verse number="12" style="v" sid="EZR 4:12"/>ಅದಾಗಿ, ತಮ್ಮ ಸನ್ನಿಧಿಯಿಂದ ನಮ್ಮ ಬಳಿಗೆ ಬಂದ ಯೆಹೂದ್ಯರು, ಯೆರೂಸಲೇಮನ್ನು ಸೇರಿ, ರಾಜಕಂಟಕವಾದ ಆ ದುಷ್ಟ ಪಟ್ಟಣವನ್ನೂ, ಅದರ ಪೌಳಿಗೋಡೆಯನ್ನೂ ಮತ್ತೆ ಕಟ್ಟುವುದಕ್ಕೆ ಪ್ರಾರಂಭಿಸಿ, ಪೌಳಿಗೋಡೆಯ ಅಸ್ತಿವಾರವನ್ನು ಮುಗಿಸಿದ್ದಾರೆ ಎಂಬುದಾಗಿ ನಾವು ರಾಜರಿಗೆ ಅರಿಕೆ ಮಾಡಿಕೊಳ್ಳುತ್ತೇವೆ.<verse eid="EZR 4:12"/></para>
  <para style="pm">
    <verse number="13" style="v" sid="EZR 4:13"/>ಆ ಪಟ್ಟಣವನ್ನೂ, ಅದರ ಗೋಡೆಗಳನ್ನೂ ಕಟ್ಟುವುದು ಮುಗಿದರೆ, ಅವರು ಕಪ್ಪ, ತೆರಿಗೆ, ಸುಂಕಗಳನ್ನು ಕೊಡುವುದಿಲ್ಲ. ಕಡೆಯಲ್ಲಿ ಅರಸರಿಗೆ ನಷ್ಟವುಂಟಾಗುವುದೆಂದು ತಮಗೆ ತಿಳಿದಿರಲಿ. <verse eid="EZR 4:13"/><verse number="14" style="v" sid="EZR 4:14"/>ನಾವಾದರೋ ಅರಮನೆಯ ಉಪ್ಪನ್ನು ತಿನ್ನುವವರು, ಅರಸರಿಗೆ ಅಪಮಾನವಾಗುವುದನ್ನು ಕಂಡು ಸುಮ್ಮನೆ ಇರುವುದು ಉಚಿತವಲ್ಲವೆಂದು ತಿಳಿದು, ತಮಗೆ ಈ ಪತ್ರದ ಮೂಲಕ ಸುದ್ದಿ ಕಳುಹಿಸಿದ್ದೇವೆ. <verse eid="EZR 4:14"/><verse number="15" style="v" sid="EZR 4:15"/>ಈ ವಿಷಯವಾಗಿ ತಾವು ತಮ್ಮ ತಂದೆತಾತಂದಿರ ಚರಿತ್ರ ಗ್ರಂಥದಲ್ಲಿ ಪರಿಶೋಧಿಸಬೇಕೆಂಬುದು ನಮ್ಮ ಅಭಿಪ್ರಾಯ. ಆ ಪಟ್ಟಣ ರಾಜಕಂಟಕವಾದ ಪಟ್ಟಣ. ಅರಸರಿಗೂ, ಸಂಸ್ಥಾನಗಳಿಗೂ ತೊಂದರೆ ಹುಟ್ಟಿಸುವಂಥ ಪಟ್ಟಣ. ಇದು ಪೂರ್ವಕಾಲದಿಂದಲೂ ದೇಶದ್ರೋಹ ಮಾಡುತ್ತಾ ಬಂದಿದೆ ಎಂದೂ ಹಾಗು ಆ ಕಾರಣದಿಂದಲೇ ನೆಲಸಮವಾಯಿತೆಂದೂ ಆ ಚರಿತ್ರ ಗ್ರಂಥದಲ್ಲಿ ಕಂಡುಬರುತ್ತದೆ. <verse eid="EZR 4:15"/><verse number="16" style="v" sid="EZR 4:16"/>ಆ ಪಟ್ಟಣವನ್ನೂ, ಅದರ ಗೋಡೆಗಳನ್ನೂ ಪುನಃ ಕಟ್ಟುವುದಾದರೆ, ತಮಗೆ ಯೂಫ್ರೇಟೀಸ್ ನದಿಯ ಈಚೆಯಲ್ಲಿ ಒಂದು ಅಂಗುಲವೂ ಉಳಿಯದು ಎಂಬುದಾಗಿ ಅರಸನಿಗೆ ಅರಿಕೆ ಮಾಡಿಕೊಳ್ಳುತ್ತೇವೆ.<verse eid="EZR 4:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="EZR 4:17"/>ಈ ಪತ್ರಕ್ಕೆ ಅರಸನು ಅವರಿಗೆ ಕೊಟ್ಟ ಉತ್ತರ:</para>
  <para style="pmo" vid="EZR 4:17">ದೇಶಾಧಿಪತಿಯಾದ ರೆಹೂಮ್ ಹಾಗು ಕಾರ್ಯದರ್ಶಿ ಶಿಂಷೈ ಅವರಿಗೂ, ಸಮಾರ್ಯದಲ್ಲಿರುವವರಿಗೂ ಯೂಫ್ರೇಟೀಸ್ ನದಿಯ ಈಚೆಯಲ್ಲಿರುವ ಇತರರಿಗೂ,</para>
  <para style="pmo" vid="EZR 4:17">ಕ್ಷೇಮಾಭಿಲಾಶೆಗಳು.<verse eid="EZR 4:17"/></para>
  <para style="pm">
    <verse number="18" style="v" sid="EZR 4:18"/>ನೀವು ಕಳುಹಿಸಿದ್ದ ಪತ್ರವನ್ನು ನನ್ನ ಸನ್ನಿಧಿಯಲ್ಲಿ ಸ್ಪಷ್ಟವಾಗಿ ಓದಿ ಅನುವಾದ ಮಾಡಲಾಯಿತು. <verse eid="EZR 4:18"/><verse number="19" style="v" sid="EZR 4:19"/>ನನ್ನ ಆಜ್ಞಾನುಸಾರ ವಿಚಾರಣೆಯಾದಾಗ, ಆ ಪಟ್ಟಣದವರು ಪೂರ್ವಕಾಲದಿಂದಲೇ ಅರಸರಿಗೆ ವಿರೋಧವಾಗಿ ಪ್ರತಿಭಟಿಸುತ್ತಾ, ದೇಶದ್ರೋಹ ಮಾಡುತ್ತಾ ಬಂದಿದ್ದಾರೆ. <verse eid="EZR 4:19"/><verse number="20" style="v" sid="EZR 4:20"/>ಇದಲ್ಲದೆ ಯೆರೂಸಲೇಮಿನಲ್ಲಿ ಬಲಿಷ್ಠ ರಾಜರು ಆಳುತ್ತಾ, ಯೂಫ್ರೇಟೀಸ್ ನದಿಯಾಚೆಯ ಎಲ್ಲಾ ಪ್ರದೇಶಗಳಲ್ಲಿ ಅಧಿಕಾರ ನಡೆಸುತ್ತಾ, ಕಪ್ಪ, ತೆರಿಗೆ, ಸುಂಕಗಳನ್ನು ತೆಗೆದುಕೊಳ್ಳುತ್ತಿದ್ದರೆಂದು ಕಂಡುಬಂದಿದೆ. <verse eid="EZR 4:20"/><verse number="21" style="v" sid="EZR 4:21"/>ಆದ್ದರಿಂದ ಆ ಜನರನ್ನು ತಡೆಯಬೇಕೆಂತಲೂ, ನನ್ನ ಅಪ್ಪಣೆಯಾಗುವವರೆಗೆ ಆ ಪಟ್ಟಣವನ್ನು ಕಟ್ಟಲು ಅವಕಾಶ ಕೊಡಬಾರದೆಂತಲೂ ಪ್ರಕಟಿಸಿರಿ. <verse eid="EZR 4:21"/><verse number="22" style="v" sid="EZR 4:22"/>ರಾಜರಿಗೆ ಹಾನಿಯುಂಟಾಗದ ಹಾಗೆ ಜಾಗರೂಕತೆಯಿಂದ ಇರಿ, ಉದಾಸೀನರಾಗಿರಬೇಡಿರಿ.<verse eid="EZR 4:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="EZR 4:23"/>ಅರಸನಾದ ಅರ್ತಷಸ್ತನ ಪತ್ರದ ಪ್ರತಿಯು ರೆಹೂಮನಿಗೂ, ಕಾರ್ಯದರ್ಶಿ ಶಿಂಷೈಯಿಗೂ, ಅವರ ಜೊತೆಗಾರರಿಗೂ ಓದಿದ ತರುವಾಯ, ಅವರು ಯೆರೂಸಲೇಮಿನಲ್ಲಿ ಇರುವ ಯೆಹೂದ್ಯರ ಬಳಿಗೆ ತ್ವರೆಯಾಗಿ ಹೋಗಿ, ಒತ್ತಾಯದಿಂದ ಮತ್ತು ಅಧಿಕಾರದಿಂದ ಅವರನ್ನು ನಿಲ್ಲಿಸುವಂತೆ ಮಾಡಿದರು.<verse eid="EZR 4:23"/></para>
  <para style="b"/>
  <para style="p">
    <verse number="24" style="v" sid="EZR 4:24"/>ಅಂದಿನಿಂದ ಪರ್ಷಿಯ ದೇಶದ ರಾಜ ದಾರ್ಯಾವೆಷನ ಆಳ್ವಿಕೆಯ ಎರಡನೆಯ ವರ್ಷದವರೆಗೂ ಯೆರೂಸಲೇಮಿನ ದೇವಾಲಯವನ್ನು ಕಟ್ಟುವ ಕೆಲಸವು ನಿಂತುಹೋಯಿತು.<verse eid="EZR 4:24"/></para>
  <chapter eid="EZR 4"/>
  <chapter number="5" style="c" sid="EZR 5"/>
  <para style="s1">ದಾರ್ಯಾವೆಷನಿಗೆ ತತ್ತೆನೈಯ ಪತ್ರ</para>
  <para style="p">
    <verse number="1" style="v" sid="EZR 5:1"/>ಈಗ ಪ್ರವಾದಿಗಳಾದ ಹಗ್ಗಾಯನೂ, ಇದ್ದೋನನ ಮಗ ಜೆಕರ್ಯನೂ ಯೆಹೂದ ಮತ್ತು ಯೆರೂಸಲೇಮಿನಲ್ಲಿ ಇರುವ ಯೆಹೂದ್ಯರಿಗೆ, ಇಸ್ರಾಯೇಲ್ ದೇವರ ನಾಮದಲ್ಲಿ ಅವರಿಗೆ ಪ್ರವಾದಿಸಿದರು. <verse eid="EZR 5:1"/><verse number="2" style="v" sid="EZR 5:2"/>ಆಗ ಶೆಯಲ್ತಿಯೇಲನ ಮಗ ಜೆರುಬ್ಬಾಬೆಲನೂ, ಯೋಚಾದಾಕನ ಮಗ ಯೇಷೂವನೂ ಎದ್ದು ಯೆರೂಸಲೇಮಿನಲ್ಲಿರುವ ದೇವರ ಆಲಯವನ್ನು ಪುನಃ ಕಟ್ಟಿಸಲು ಪ್ರಾರಂಭಿಸಿದರು. ಅವರಿಗೆ ಸಹಾಯಕರಾಗಿ ದೇವರ ಪ್ರವಾದಿಗಳು ಅವರ ಸಂಗಡ ಇದ್ದರು.<verse eid="EZR 5:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="EZR 5:3"/>ಆ ವೇಳೆಯಲ್ಲಿ ಯೂಫ್ರೇಟೀಸ್ ನದಿಯ ಈಚೆಯಲ್ಲಿರುವ ಪ್ರದೇಶಗಳ ಅಧಿಪತಿಯಾಗಿದ್ದ ತತ್ತೆನೈಯೂ, ಶೆತರ್ ಬೋಜೆನೈಯೂ, ಅವರ ಜೊತೆಗಾರರೂ ಅವರ ಬಳಿಗೆ ಬಂದು, “ಈ ಆಲಯವನ್ನು ಪುನಃ ಕಟ್ಟಿ ತೀರಿಸುವುದಕ್ಕೆ ನಿಮಗೆ ಅಪ್ಪಣೆ ಕೊಟ್ಟವರು ಯಾರು?” ಎಂದು ಕೇಳಿದರು. <verse eid="EZR 5:3"/><verse number="4" style="v" sid="EZR 5:4"/>ಇದಲ್ಲದೆ ಅವರು, “ಈ ಕಟ್ಟಡವನ್ನು ಕಟ್ಟಿಸುವವರ ಹೆಸರುಗಳೇನು?” ಎಂದು ವಿಚಾರಿಸಿದರು. <verse eid="EZR 5:4"/><verse number="5" style="v" sid="EZR 5:5"/>ಆದರೆ ಈ ಕಾರ್ಯವು ದಾರ್ಯಾವೆಷನ ಬಳಿಗೆ ಬರುವವರೆಗೂ, ಅವರು ಇವರನ್ನು ನಿಲ್ಲಿಸದ ಹಾಗೆ ಇವರ ದೇವರ ಕಣ್ಣು ಯೆಹೂದ್ಯರ ಹಿರಿಯರ ಮೇಲೆ ಇತ್ತು. ಆಗ ಇದನ್ನು ಕುರಿತು ಅವರು ಉತ್ತರವನ್ನು ಪತ್ರದಲ್ಲಿ ಕಳುಹಿಸಿದರು.<verse eid="EZR 5:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="EZR 5:6"/>ಯೂಫ್ರೇಟೀಸ್ ನದಿಯ ಈಚೆಯಲ್ಲಿರುವ ಅಧಿಪತಿಯಾದ ತತ್ತೆನೈನೂ, ಶೆತರ್ ಬೋಜೆನೈಯೂ ಯೂಫ್ರೇಟೀಸ್ ನದಿಯ ಈಚೆಯಲ್ಲಿರುವ ಅವನ ಜೊತೆಗಾರರೂ, ಅರಸನಾದ ದಾರ್ಯಾವೆಷನಿಗೆ ಪತ್ರ ಬರೆದು ಕಳುಹಿಸಿದರು. <verse eid="EZR 5:6"/><verse number="7" style="v" sid="EZR 5:7"/>ಅವರು ಅವನ ಬಳಿಗೆ ಕಳುಹಿಸಿದ ಪತ್ರದ ಪ್ರತಿಯಲ್ಲಿ:</para>
  <para style="pmo" vid="EZR 5:7">ಅರಸನಾದ ದಾರ್ಯಾವೆಷನಿಗೆ:</para>
  <para style="pmo" vid="EZR 5:7">ಸರ್ವತಾ ಕ್ಷೇಮ.<verse eid="EZR 5:7"/></para>
  <para style="pm">
    <verse number="8" style="v" sid="EZR 5:8"/>ಅರಸನಿಗೆ ತಿಳಿಯಬೇಕಾದದ್ದೇನೆಂದರೆ, ನಾವು ಯೆಹೂದರ ದೇಶದಲ್ಲಿರುವ ಮಹಾ ದೇವರ ಆಲಯಕ್ಕೆ ಹೋದೆವು. ಅದನ್ನು ದೊಡ್ಡ ಕಲ್ಲುಗಳಿಂದ ಕಟ್ಟುತ್ತಿದ್ದಾರೆ. ಗೋಡೆಗಳ ಮೇಲೆ ತೊಲೆಗಳನ್ನು ಇಡುತ್ತಿದ್ದಾರೆ. ಆ ಕೆಲಸವು ತೀವ್ರವಾಗಿ ನಡೆಯುತ್ತಾ ಅವರ ಕೈಗಳಿಂದ ವೇಗವಾಗಿ ವೃದ್ಧಿಯಾಗುತ್ತದೆ.<verse eid="EZR 5:8"/></para>
  <para style="pm">
    <verse number="9" style="v" sid="EZR 5:9"/>“ಆಗ ಈ ಆಲಯವನ್ನು ಕಟ್ಟುವುದಕ್ಕೂ ನಿಮಗೆ ಅಪ್ಪಣೆ ಕೊಟ್ಟವರು ಯಾರು?” ಎಂದು ನಾವು ಆ ಹಿರಿಯರನ್ನು ಕೇಳಿದೆವು. <verse eid="EZR 5:9"/><verse number="10" style="v" sid="EZR 5:10"/>ಇದಲ್ಲದೆ ಅವರಲ್ಲಿರುವ ಮುಖ್ಯಸ್ಥರ ಹೆಸರುಗಳನ್ನು ನಿಮಗೆ ಬರೆದು ತಿಳಿಸುವಂತೆ ಅವರ ಹೆಸರುಗಳನ್ನು ಕೇಳಿದೆವು.<verse eid="EZR 5:10"/></para>
  <para style="pm">
    <verse number="11" style="v" sid="EZR 5:11"/>ಅವರು ನಮಗೆ ಕೊಟ್ಟ ಉತ್ತರವೇನೆಂದರೆ:</para>
  <para style="b" vid="EZR 5:11"/>
  <para style="pm" vid="EZR 5:11">“ನಾವು ಪರಲೋಕ ಮತ್ತು ಭೂಲೋಕಗಳ ದೇವರ ಸೇವಕರಾಗಿದ್ದೇವೆ. ಅನೇಕ ವರ್ಷಗಳ ಹಿಂದೆ ಇಸ್ರಾಯೇಲಿನಲ್ಲಿದ್ದ ಒಬ್ಬ ಮಹಾ ಅರಸನು ಕಟ್ಟಿದ್ದ ಆಲಯವನ್ನು ನಾವು ಪುನಃ ಕಟ್ಟುತ್ತಿದ್ದೇವೆ. <verse eid="EZR 5:11"/><verse number="12" style="v" sid="EZR 5:12"/>ಆದರೆ ನಮ್ಮ ಪಿತೃಗಳು ಪರಲೋಕದ ದೇವರಿಗೆ ಕೋಪವನ್ನು ಎಬ್ಬಿಸಿದ ಕಾರಣ, ದೇವರು ಅವರನ್ನು ಬಾಬಿಲೋನಿನ ಅರಸನಾಗಿದ್ದ ಕಸ್ದೀಯರ ದೇಶದವನಾದ ನೆಬೂಕದ್ನೆಚ್ಚರನ ಕೈಯಲ್ಲಿ ಒಪ್ಪಿಸಿಕೊಟ್ಟರು. ಆ ಅರಸನು ಆ ಆಲಯವನ್ನು ಹಾಳು ಮಾಡಿ, ಜನರನ್ನು ಬಾಬಿಲೋನಿಗೆ ಸೆರೆಹಿಡಿದುಕೊಂಡು ಹೋದನು.<verse eid="EZR 5:12"/></para>
  <para style="pm">
    <verse number="13" style="v" sid="EZR 5:13"/>“ಆದರೆ ಬಾಬಿಲೋನಿನ ಅರಸನಾದ ಕೋರೆಷನ ಮೊದಲನೆಯ ವರ್ಷದಲ್ಲಿ ಅರಸನಾದ ಕೋರೆಷನು ದೇವರ ಈ ಆಲಯವನ್ನು ಪುನಃ ಕಟ್ಟಲು ಆಜ್ಞೆಯನ್ನು ಕೊಟ್ಟನು. <verse eid="EZR 5:13"/><verse number="14" style="v" sid="EZR 5:14"/>ಇದಲ್ಲದೆ ನೆಬೂಕದ್ನೆಚ್ಚರನು ಯೆರೂಸಲೇಮಿನಲ್ಲಿರುವ ದೇವಾಲಯದಿಂದ ತೆಗೆದುಕೊಂಡು, ಬಾಬಿಲೋನಿನ ಮಂದಿರಕ್ಕೆ ತಂದ ದೇವಸ್ಥಾನದ ಬೆಳ್ಳಿಬಂಗಾರದ ಸಾಮಗ್ರಿಗಳನ್ನು ಅರಸನಾದ ಕೋರೆಷನು ಬಾಬಿಲೋನಿನ ಮಂದಿರದಿಂದ ತೆಗೆದುಕೊಂಡು, ತಾನು ನೇಮಿಸಿದ ಅಧಿಪತಿಯಾದ ಶೆಷ್ಬಚ್ಚರನಿಗೆ ಒಪ್ಪಿಸಿಕೊಟ್ಟನು. <verse eid="EZR 5:14"/><verse number="15" style="v" sid="EZR 5:15"/>ಅವನಿಗೆ, ‘ಈ ಸಾಮಗ್ರಿಗಳನ್ನು ತೆಗೆದುಕೊಂಡು ಯೆರೂಸಲೇಮಿನಲ್ಲಿರುವ ದೇವಾಲಯಕ್ಕೆ ತೆಗೆದುಕೊಂಡು ಹೋಗು. ದೇವಾಲಯವನ್ನು ಪುನಃ ಅದರ ಸ್ಥಳದಲ್ಲಿ ಕಟ್ಟು,’ ಎಂದು ಆಜ್ಞಾಪಿಸಿದನು.<verse eid="EZR 5:15"/></para>
  <para style="pm">
    <verse number="16" style="v" sid="EZR 5:16"/>“ಆಗ ಶೆಷ್ಬಚ್ಚರನು ಬಂದು, ಯೆರೂಸಲೇಮಿನಲ್ಲಿರುವ ದೇವರ ಆಲಯಕ್ಕೆ ಅಸ್ತಿವಾರವನ್ನು ಹಾಕಿದನು. ಅಂದಿನಿಂದ ಇಂದಿನವರೆಗೂ ಕಟ್ಟುವ ಕೆಲಸ ನಡೆಯುತ್ತಾ ಇದೆ, ಇನ್ನೂ ಮುಗಿಯಲಿಲ್ಲ,” ಎಂದರು.<verse eid="EZR 5:16"/></para>
  <para style="b"/>
  <para style="pm">
    <verse number="17" style="v" sid="EZR 5:17"/>“ಆದ್ದರಿಂದ ಅರಸನಿಗೆ ಸರಿ ತೋರುವುದಾದರೆ, ಯೆರೂಸಲೇಮಿನಲ್ಲಿರುವ ದೇವರ ಆಲಯವನ್ನು ಪುನಃ ಕಟ್ಟಲು ಅರಸನಾದ ಕೋರೆಷನು ಅಪ್ಪಣೆ ಮಾಡಿದ್ದು ಉಂಟೋ, ಇಲ್ಲವೋ ಎಂಬುದನ್ನು ಬಾಬಿಲೋನಿನಲ್ಲಿರುವ ಅರಸನ ಬೊಕ್ಕಸದ ಮನೆಯಲ್ಲಿ ವಿಚಾರಿಸಲಿ. ತರುವಾಯ ಅರಸನು ಈ ಕಾರ್ಯಕ್ಕೋಸ್ಕರ ತನ್ನ ಚಿತ್ತವೇನೆಂದು ನಮಗೆ ತಿಳಿಸೋಣವಾಗಲಿ,” ಎಂಬುದಾಗಿ ಉತ್ತರಕೊಟ್ಟರು.<verse eid="EZR 5:17"/></para>
  <chapter eid="EZR 5"/>
  <chapter number="6" style="c" sid="EZR 6"/>
  <para style="s1">ದಾರ್ಯಾವೆಷನ ತೀರ್ಪು</para>
  <para style="p">
    <verse number="1" style="v" sid="EZR 6:1"/>ಆಗ ಅರಸನಾದ ದಾರ್ಯಾವೆಷನ ಅಪ್ಪಣೆಯ ಪ್ರಕಾರ ಅವರು ಬಾಬಿಲೋನಿನ ಭಂಡಾರದಲ್ಲಿದ್ದ ಗ್ರಂಥಾಲಯದಲ್ಲಿ ಹುಡುಕಿದರು. <verse eid="EZR 6:1"/><verse number="2" style="v" sid="EZR 6:2"/>ಮೇದ್ಯರ ದೇಶದಲ್ಲಿರುವ ಅಹ್ಮೆತಾ ರಾಜಧಾನಿಯಲ್ಲಿ ಜ್ಞಾಪಕಾರ್ಥದ ಒಂದು ಸುರುಳಿ ಸಿಕ್ಕಿತು.</para>
  <para style="pmo" vid="EZR 6:2">ಅದರಲ್ಲಿ ಹೀಗೆ ಬರೆಯಲಾಗಿತ್ತು:<verse eid="EZR 6:2"/></para>
  <para style="pm">
    <verse number="3" style="v" sid="EZR 6:3"/>ಅರಸನಾದ ಕೋರೆಷನ ಮೊದಲನೆಯ ವರ್ಷದಲ್ಲಿ ಅರಸನಾದ ಕೋರೆಷನು ಯೆರೂಸಲೇಮಿನಲ್ಲಿರುವ ದೇವರ ಆಲಯಕ್ಕೋಸ್ಕರ ಕೊಟ್ಟ ಅಪ್ಪಣೆ ಏನೆಂದರೆ:</para>
  <para style="b" vid="EZR 6:3"/>
  <para style="pm" vid="EZR 6:3">ಜನರು ಬಲಿಗಳನ್ನು ಸಮರ್ಪಿಸುವುದಕ್ಕಾಗಿ ಆಲಯವನ್ನು ಪುನಃ ಕಟ್ಟಬೇಕು. ಅದರ ಅಸ್ತಿವಾರಗಳನ್ನು ಬಲವಾಗಿ ಹಾಕಬೇಕು. ಅದರ ಎತ್ತರ 27 ಮೀಟರ್, ಅದರ ಅಗಲ 27 ಮೀಟರ್ ಆಗಿರಲಿ. <verse eid="EZR 6:3"/><verse number="4" style="v" sid="EZR 6:4"/>ದೊಡ್ಡ ಕಲ್ಲುಗಳ ಮೂರು ಸಾಲುಗಳೂ, ಹೊಸ ತೊಲೆಗಳ ಒಂದು ಸಾಲೂ ಇರಲಿ. ಅದರ ಖರ್ಚು ಅರಮನೆಯ ಬೊಕ್ಕಸದಿಂದ ಕೊಡಲಾಗುವುದು. <verse eid="EZR 6:4"/><verse number="5" style="v" sid="EZR 6:5"/>ಇದಲ್ಲದೆ ನೆಬೂಕದ್ನೆಚ್ಚರನು ಯೆರೂಸಲೇಮಿನಲ್ಲಿರುವ ಮಂದಿರದಿಂದ ತೆಗೆದುಕೊಂಡು ಬಾಬಿಲೋನಿಗೆ ಒಯ್ದ ದೇವರ ಆಲಯದ ಬೆಳ್ಳಿಬಂಗಾರದ ಸಲಕರಣೆಗಳನ್ನು ತಿರುಗಿ ಯೆರೂಸಲೇಮಿನಲ್ಲಿರುವ ಮಂದಿರಕ್ಕೆ ತೆಗೆದುಕೊಂಡುಹೋಗಿ, ದೇವರ ಆಲಯದೊಳಗೆ ಅದರದರ ಸ್ಥಳದಲ್ಲಿ ಇಡಬೇಕು.<verse eid="EZR 6:5"/></para>
  <para style="b"/>
  <para style="pm">
    <verse number="6" style="v" sid="EZR 6:6"/>ಬಳಿಕ ದಾರ್ಯಾವೆಷನು ಬರೆದು ಕಳುಹಿಸಿದ್ದು ಏನೆಂದರೆ, ಯೂಫ್ರೇಟೀಸ್ ನದಿಯ ಆಚೆಯಲ್ಲಿರುವ ಅಧಿಪತಿಯಾದ ತತ್ತೆನೈನೇ, ಶೆತರ್ ಬೋಜೆನೈಯೇ, ನದಿಯ ಆಚೆಯಲ್ಲಿರುವ ನಿಮ್ಮ ಜೊತೆಗಾರರು ಸಹ ಆ ಸ್ಥಳವನ್ನು ಬಿಟ್ಟು ದೂರವಾಗಿರಿ. <verse eid="EZR 6:6"/><verse number="7" style="v" sid="EZR 6:7"/>ದೇವರ ಆಲಯವನ್ನು ಕಟ್ಟುವ ಕೆಲಸಕ್ಕೆ ನೀವು ಅಡ್ಡಿಮಾಡಬೇಡಿರಿ. ಯೆಹೂದ್ಯರ ಅಧಿಪತಿಯೂ, ಯೆಹೂದ್ಯರ ಹಿರಿಯರೂ ಅದರ ಸ್ಥಳದಲ್ಲಿ ದೇವರ ಆಲಯವನ್ನು ಕಟ್ಟಿಸಲಿ.<verse eid="EZR 6:7"/></para>
  <para style="pm">
    <verse number="8" style="v" sid="EZR 6:8"/>ಇದಲ್ಲದೆ ದೇವರ ಈ ಆಲಯವನ್ನು ಕಟ್ಟುವುದಕ್ಕೆ ಯೆಹೂದ್ಯರ ಹಿರಿಯರಿಗೆ ನೀವು ಮಾಡತಕ್ಕದ್ದನ್ನು ಕುರಿತು ನಾನು ಕೊಡುವ ಅಪ್ಪಣೆ ಏನೆಂದರೆ:</para>
  <para style="pm" vid="EZR 6:8">ಅವರು ಅಭ್ಯಂತರ ಮಾಡದ ಹಾಗೆ ನದಿಯ ಆಚೆಯಲ್ಲಿಂದ ಬರುವ ಅರಸನ ತೆರಿಗೆಯಿಂದಲೇ ಈ ಮನುಷ್ಯರಿಗೆ ವೆಚ್ಚವನ್ನು ಕೊಡಬೇಕು. <verse eid="EZR 6:8"/><verse number="9" style="v" sid="EZR 6:9"/>ಪರಲೋಕದ ದೇವರಿಗೆ ದಹನಬಲಿಗಳ ನಿಮಿತ್ತ ಅವರಿಗೆ ಬೇಕಾದ ಹೋರಿಗಳೂ, ಟಗರುಗಳೂ, ಕುರಿಮರಿಗಳೂ, ಗೋಧಿಯೂ, ಉಪ್ಪೂ, ದ್ರಾಕ್ಷಾರಸವೂ, ಎಣ್ಣೆಯೂ ಪ್ರತಿದಿನ ತಪ್ಪದೆ ಯೆರೂಸಲೇಮಿನಲ್ಲಿರುವ ಯಾಜಕರ ನೇಮಕದ ಪ್ರಕಾರ ಅವರಿಗೆ ಕೊಡಬೇಕು. <verse eid="EZR 6:9"/><verse number="10" style="v" sid="EZR 6:10"/>ಇದಲ್ಲದೆ ಅವರು ಪರಲೋಕದ ದೇವರಿಗೆ ಸುವಾಸನೆಯುಳ್ಳ ಬಲಿಗಳನ್ನು ಅರ್ಪಿಸುವ ಹಾಗೆಯೂ, ಅರಸನ ಪ್ರಾಣಕ್ಕೋಸ್ಕರವೂ, ಅವನ ಮಕ್ಕಳ ಪ್ರಾಣಕ್ಕೋಸ್ಕರವೂ ಪ್ರಾರ್ಥನೆ ಮಾಡಬೇಕು.<verse eid="EZR 6:10"/></para>
  <para style="pm">
    <verse number="11" style="v" sid="EZR 6:11"/>ನಾನು ಕೊಡುವ ಅಪ್ಪಣೆ ಏನೆಂದರೆ, ಯಾವನಾದರೂ ಈ ನನ್ನ ಆಜ್ಞೆಯನ್ನು ಬದಲು ಮಾಡಿದರೆ, ಅವನ ಮನೆಯಿಂದ ಒಂದು ತೊಲೆಯನ್ನು ತೆಗೆದು ಅದರಿಂದಲೇ ಅವನನ್ನು ಗಲ್ಲಿಗೆ ಏರಿಸಬೇಕು. ಅವನ ಮನೆಯನ್ನು ಇದರ ನಿಮಿತ್ತ ತಿಪ್ಪೆಯನ್ನಾಗಿ ಮಾಡಿಬಿಡಬೇಕು. <verse eid="EZR 6:11"/><verse number="12" style="v" sid="EZR 6:12"/>ಇದಲ್ಲದೆ ದೇವರು ತಮ್ಮ ಹೆಸರನ್ನು ಸ್ಥಾಪಿಸುವುದಕ್ಕಾಗಿ ಆ ಸ್ಥಳವನ್ನು ಆರಿಸಿಕೊಂಡಿರಲು, ಯೆರೂಸಲೇಮಿನ ಈ ದೇವಾಲಯವನ್ನು ಕಟ್ಟಬೇಕೆಂಬ ಆಜ್ಞೆಯನ್ನು ಬದಲಿಸುವುದಕ್ಕಾಗಲಿ, ದೇವಾಲಯವನ್ನು ನಾಶಮಾಡುವುದಕ್ಕಾಗಲಿ ಕೈಯೆತ್ತುವ ಪ್ರತಿಯೊಬ್ಬ ರಾಜನನ್ನೂ, ಜನರನ್ನೂ ದೇವರು ನಾಶಮಾಡಲಿ.</para>
  <para style="pm" vid="EZR 6:12">ದಾರ್ಯಾವೆಷನಾದ ನಾನು ಈ ಆಜ್ಞೆಯನ್ನು ಕೊಟ್ಟಿದ್ದೇನೆ. ಇದನ್ನು ಶ್ರದ್ಧೆಯಿಂದ ಪಾಲಿಸಬೇಕು, ಎಂಬುದು.<verse eid="EZR 6:12"/></para>
  <para style="s1">ದೇವಾಲಯ ಪ್ರತಿಷ್ಠಾಪನೆ</para>
  <para style="p">
    <verse number="13" style="v" sid="EZR 6:13"/>ಆಗ ಯೂಫ್ರೇಟೀಸ್ ನದಿಯ ಈಚೆಯಲ್ಲಿರುವ ಅಧಿಪತಿಯಾದ ತತ್ತೆನೈಯೂ, ಶೆತರ್ ಬೋಜೆನೈಯೂ, ಅವರ ಜೊತೆಗಾರರೂ ಅರಸನಾದ ದಾರ್ಯಾವೆಷನು ಕಳುಹಿಸಿದ ಆಜ್ಞೆಯ ಪ್ರಕಾರ ತ್ವರೆಯಾಗಿ ಮಾಡಿದರು. <verse eid="EZR 6:13"/><verse number="14" style="v" sid="EZR 6:14"/>ಹಾಗೆಯೇ ಯೆಹೂದ್ಯರ ಹಿರಿಯರು ಕಟ್ಟಿಸಿ, ಪ್ರವಾದಿಗಳಾದ ಹಗ್ಗಾಯನೂ, ಇದ್ದೋನನ ಮಗನಾದ ಜೆಕರ್ಯನೂ ಪ್ರವಾದಿಸಿದ್ದರಿಂದ ಅಭಿವೃದ್ಧಿಯನ್ನು ಹೊಂದಿದರು. ಅವರು ಇಸ್ರಾಯೇಲ್ ದೇವರ ಅಪ್ಪಣೆಯ ಪ್ರಕಾರವೂ, ಕೋರೆಷ್, ದಾರ್ಯಾವೆಷ್ ಹಾಗೂ ಅರ್ತಷಸ್ತ ಎಂಬ ಪರ್ಷಿಯದ ರಾಜರ ಅಪ್ಪಣೆಯ ಪ್ರಕಾರವೂ ಕಟ್ಟಿ ತೀರಿಸಿದರು. <verse eid="EZR 6:14"/><verse number="15" style="v" sid="EZR 6:15"/>ಅರಸನಾದ ದಾರ್ಯಾವೆಷನ ಆಳಿಕೆಯ ಆರನೆಯ ವರ್ಷದ ಆಡಾರ್ ತಿಂಗಳ, ಮೂರನೆಯ ದಿವಸದಲ್ಲಿ ಈ ಆಲಯವನ್ನು ಕಟ್ಟಿ ಮುಗಿಸಲಾಯಿತು.<verse eid="EZR 6:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="EZR 6:16"/>ಆಗ ಇಸ್ರಾಯೇಲರೂ, ಯಾಜಕರೂ, ಲೇವಿಯರೂ, ಸೆರೆಯಿಂದ ಬಂದ ಮಿಕ್ಕಾದವರೂ ದೇವರ ಆಲಯವನ್ನು ಸಂತೋಷದಿಂದ ಪ್ರತಿಷ್ಠಾಪಿಸಿದರು. <verse eid="EZR 6:16"/><verse number="17" style="v" sid="EZR 6:17"/>ದೇವರ ಆಲಯದ ಪ್ರತಿಷ್ಠಾಪನೆಗೋಸ್ಕರ ನೂರು ಹೋರಿಗಳನ್ನೂ, ಇನ್ನೂರು ಟಗರುಗಳನ್ನೂ, ನಾನೂರು ಕುರಿಮರಿಗಳನ್ನೂ, ಇಸ್ರಾಯೇಲ್ ಕುಲ ಗೋತ್ರಗಳ ಲೆಕ್ಕದ ಪ್ರಕಾರ, ಸಮಸ್ತ ಇಸ್ರಾಯೇಲರ ದೋಷಪರಿಹಾರ ಬಲಿಗಾಗಿ ಹನ್ನೆರಡು ಮೇಕೆಯ ಹೋತಗಳನ್ನೂ ಅರ್ಪಿಸಿದರು. <verse eid="EZR 6:17"/><verse number="18" style="v" sid="EZR 6:18"/>ಮೋಶೆಯ ಗ್ರಂಥದಲ್ಲಿ ಬರೆದ ಹಾಗೆ ಯೆರೂಸಲೇಮಿನಲ್ಲಿ ವಾಸವಾಗಿರುವ ದೇವರ ಆರಾಧನೆಗೋಸ್ಕರ ಯಾಜಕರನ್ನು ಮತ್ತು ಲೇವಿಯರನ್ನು ಅವರ ಸರತಿಯ ಪ್ರಕಾರವೂ ನೇಮಿಸಿದರು.<verse eid="EZR 6:18"/></para>
  <para style="s1">ಪಸ್ಕಹಬ್ಬ</para>
  <para style="p">
    <verse number="19" style="v" sid="EZR 6:19"/>ಇದಲ್ಲದೆ ಸೆರೆಯಿಂದ ಬಂದವರು ಮೊದಲನೆಯ ತಿಂಗಳಿನ, ಹದಿನಾಲ್ಕನೆಯ ದಿವಸದಲ್ಲಿ ಪಸ್ಕವನ್ನು ಆಚರಿಸಿದರು. <verse eid="EZR 6:19"/><verse number="20" style="v" sid="EZR 6:20"/>ಯಾಜಕರೂ ಲೇವಿಯರೂ ಕೂಡ ಶುದ್ಧ ಮಾಡಿಕೊಂಡಿದ್ದರು. ಅವರೆಲ್ಲರು ಶುದ್ಧರಾದ ನಂತರ, ಲೇವಿಯರು ಸೆರೆಯಿಂದ ಬಂದವರೆಲ್ಲರಿಗೋಸ್ಕರವೂ, ಯಾಜಕರಾದ ತಮ್ಮ ಸಹೋದರರಿಗೋಸ್ಕರವೂ, ತಮಗೋಸ್ಕರವೂ ಪಸ್ಕದ ಕುರಿಮರಿಯನ್ನು ವಧಿಸಿದರು. <verse eid="EZR 6:20"/><verse number="21" style="v" sid="EZR 6:21"/>ಸೆರೆಯಿಂದ ತಿರುಗಿ ಬಂದ ಇಸ್ರಾಯೇಲರು ತಮ್ಮ ಇಸ್ರಾಯೇಲ್ ದೇವರಾಗಿರುವ ಯೆಹೋವ ದೇವರನ್ನು ಹುಡುಕಲು ದೇಶದ ಜನಾಂಗಗಳ ಅಶುದ್ಧತೆಯಿಂದ ತಮ್ಮನ್ನು ಪ್ರತ್ಯೇಕಿಸಿಕೊಂಡು, ಅವರ ಕಡೆಗೆ ಸೇರಿದ ಸಮಸ್ತರೂ ಅದನ್ನು ತಿಂದು, <verse eid="EZR 6:21"/><verse number="22" style="v" sid="EZR 6:22"/>ಹುಳಿಯಿಲ್ಲದ ರೊಟ್ಟಿಗಳ ಹಬ್ಬವನ್ನು ಸಂತೋಷದಿಂದ ಏಳು ದಿವಸ ಆಚರಿಸಿದರು. ಏಕೆಂದರೆ ಇಸ್ರಾಯೇಲ್ ದೇವರಾಗಿರುವ ಯೆಹೋವ ದೇವರ ಆಲಯದ ಕಾರ್ಯದಲ್ಲಿ ಅವರ ಕೈಗಳನ್ನು ಬಲಪಡಿಸುವುದಕ್ಕೆ ಅಸ್ಸೀರಿಯ ದೇಶದ ಅರಸನ ಹೃದಯವನ್ನು, ಅವರ ಕಡೆಗೆ ಮನಪರಿವರ್ತಿಸಿದ್ದರಿಂದ ಯೆಹೋವ ದೇವರು ಅವರನ್ನು ಸಂತೋಷಪಡಿಸಿದರು.<verse eid="EZR 6:22"/></para>
  <chapter eid="EZR 6"/>
  <chapter number="7" style="c" sid="EZR 7"/>
  <para style="s1">ಎಜ್ರನು ಯೆರೂಸಲೇಮಿಗೆ ಬಂದದ್ದು</para>
  <para style="p">
    <verse number="1" style="v" sid="EZR 7:1"/>ಈ ಕಾರ್ಯಗಳಾದ ತರುವಾಯ ಪಾರಸಿಯ ಅರಸನಾದ ಅರ್ತಷಸ್ತನ ಆಳಿಕೆಯಲ್ಲಿ ಎಜ್ರನು ಬಾಬಿಲೋನಿನಿಂದ ಹೊರಟುಹೋದನು. ಇವನು ಸೆರಾಯನ ಮಗನು; ಇವನು ಅಜರ್ಯನ ಮಗನು; ಇವನು ಹಿಲ್ಕೀಯನ ಮಗನು; <verse eid="EZR 7:1"/><verse number="2" style="v" sid="EZR 7:2"/>ಇವನು ಶಲ್ಲೂಮನ ಮಗನು; ಇವನು ಚಾದೋಕನ ಮಗನು; ಇವನು ಅಹೀಟೂಬನ ಮಗನು; <verse eid="EZR 7:2"/><verse number="3" style="v" sid="EZR 7:3"/>ಇವನು ಅಮರ್ಯನ ಮಗನು; ಇವನು ಅಜರ್ಯನ ಮಗನು; ಇವನು ಮೆರಾಯೋತನ ಮಗನು; <verse eid="EZR 7:3"/><verse number="4" style="v" sid="EZR 7:4"/>ಇವನು ಜೆರಹ್ಯನ ಮಗನು; ಇವನು ಉಜ್ಜೀಯನ ಮಗನು; ಇವನು ಬುಕ್ಕೀಯ ಮಗನು; <verse eid="EZR 7:4"/><verse number="5" style="v" sid="EZR 7:5"/>ಇವನು ಅಬೀಷೂವನ ಮಗನು; ಇವನು ಫೀನೆಹಾಸನ ಮಗನು; ಇವನು ಎಲಿಯಾಜರನ ಮಗನು; ಇವನು ಮುಖ್ಯಯಾಜಕನಾದ ಆರೋನನ ಮಗನು. <verse eid="EZR 7:5"/><verse number="6" style="v" sid="EZR 7:6"/>ಈ ಎಜ್ರನು ಬಾಬಿಲೋನಿನಿಂದ ಬಂದನು, ಅವನು ಇಸ್ರಾಯೇಲ್ ದೇವರಾಗಿರುವ ಯೆಹೋವ ದೇವರು ಕೊಟ್ಟ ಮೋಶೆಯ ನಿಯಮದಲ್ಲಿ ಪಾಂಡಿತ್ಯ ಪಡೆದ ನಿಯಮಶಾಸ್ತ್ರಿ ಆಗಿದ್ದನು. ಅವನ ಮೇಲೆ ಅವನ ದೇವರಾಗಿರುವ ಯೆಹೋವ ದೇವರ ಕೈ ಇದ್ದುದರಿಂದ, ಅವನು ಕೇಳಿದ್ದನ್ನೆಲ್ಲಾ ಅರಸನು ಕೊಟ್ಟನು. <verse eid="EZR 7:6"/><verse number="7" style="v" sid="EZR 7:7"/>ಅವನ ಸಂಗಡ ಇಸ್ರಾಯೇಲರಲ್ಲಿಯೂ ಯಾಜಕರಲ್ಲಿಯೂ ಲೇವಿಯರಲ್ಲಿಯೂ ಹಾಡುಗಾರರಲ್ಲಿಯೂ ದ್ವಾರಪಾಲಕರಲ್ಲಿಯೂ ದೇವಾಲಯದ ಸೇವಕರಲ್ಲಿಯೂ ಕೆಲವರು ಅರಸನಾದ ಅರ್ತಷಸ್ತನ ಆಳ್ವಿಕೆಯ ಏಳನೆಯ ವರ್ಷದಲ್ಲಿ ಯೆರೂಸಲೇಮಿಗೆ ಹೋದರು.<verse eid="EZR 7:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="EZR 7:8"/>ಅರಸನ ಏಳನೆಯ ವರ್ಷದ, ಐದನೆಯ ತಿಂಗಳಲ್ಲಿ ಎಜ್ರನು ಯೆರೂಸಲೇಮಿಗೆ ಬಂದನು. <verse eid="EZR 7:8"/><verse number="9" style="v" sid="EZR 7:9"/>ಅವನು ಮೊದಲನೆಯ ತಿಂಗಳಿನ, ಮೊದಲನೆಯ ದಿವಸದಲ್ಲಿ ಬಾಬಿಲೋನಿನಿಂದ ಹೊರಟು, ಐದನೆಯ ತಿಂಗಳಿನ, ಮೊದಲನೆಯ ದಿವಸದಲ್ಲಿ ಯೆರೂಸಲೇಮಿಗೆ ಬಂದು ಸೇರಿದನು. ಏಕೆಂದರೆ ಅವನ ದೇವರಾದ ಯೆಹೋವ ದೇವರ ಹಸ್ತವು ಅವನ ಮೇಲಿತ್ತು. <verse eid="EZR 7:9"/><verse number="10" style="v" sid="EZR 7:10"/>ಏಕೆಂದರೆ ಎಜ್ರನು ಯೆಹೋವ ದೇವರ ನಿಯಮವನ್ನು ಅಭ್ಯಾಸ ಮಾಡುವುದಕ್ಕೂ ಅದನ್ನು ಕೈಗೊಂಡು ನಡೆಯುವುದಕ್ಕೂ ಇಸ್ರಾಯೇಲರಿಗೆ ಅದರ ತೀರ್ಪುಗಳನ್ನು ಹಾಗೂ ನಿಯಮಗಳನ್ನು ಬೋಧಿಸುವುದಕ್ಕೂ ತನ್ನನ್ನು ಪ್ರತಿಷ್ಠಿಸಿಕೊಂಡಿದ್ದನು.<verse eid="EZR 7:10"/></para>
  <para style="s1">ಅರ್ತಷಸ್ತನು ಎಜ್ರನಿಗೆ ಬರೆದ ಪತ್ರ</para>
  <para style="p">
    <verse number="11" style="v" sid="EZR 7:11"/>ಯಾಜಕನು, ನಿಯಮಶಾಸ್ತ್ರಿಯು ಹಾಗೂ ಇಸ್ರಾಯೇಲರಿಗೆ ಕೊಡಲಾದ ಯೆಹೋವ ದೇವರ ಆಜ್ಞಾಸೂತ್ರಗಳಲ್ಲಿ ವಿದ್ವಾಂಸನೂ ಆದ ಎಜ್ರನಿಗೆ ಅರಸನಾದ ಅರ್ತಷಸ್ತನು ಕೊಟ್ಟ ಪತ್ರದ ನಕಲು ಇದು:<verse eid="EZR 7:11"/></para>
  <para style="pmo">
    <verse number="12" style="v" sid="EZR 7:12"/>ರಾಜಾಧಿರಾಜನಾದ ಅರ್ತಷಸ್ತನು,</para>
  <para style="pmo" vid="EZR 7:12">ಯಾಜಕನೂ, ಪರಲೋಕ ದೇವರ ನಿಯಮದಲ್ಲಿ ಪ್ರವೀಣನೂ ಆದ ಎಜ್ರನಿಗೆ,</para>
  <para style="pmo" vid="EZR 7:12">ವಂದನೆಗಳು.<verse eid="EZR 7:12"/></para>
  <para style="pm">
    <verse number="13" style="v" sid="EZR 7:13"/>ನನ್ನ ರಾಜ್ಯದಲ್ಲಿರುವ ಇಸ್ರಾಯೇಲರಲ್ಲಿ, ಯಾಜಕರಲ್ಲಿ ಹಾಗು ಲೇವಿಯರಲ್ಲಿ ಯಾರಿಗೆ ಯೆರೂಸಲೇಮಿಗೆ ಹೋಗುವುದಕ್ಕೆ ಮನಸ್ಸಿದೆಯೋ, ಅವರೆಲ್ಲರು ನಿನ್ನೊಂದಿಗೆ ಹೋಗಬಹುದೆಂದು ಅಪ್ಪಣೆ ಮಾಡುತ್ತೇನೆ. <verse eid="EZR 7:13"/><verse number="14" style="v" sid="EZR 7:14"/>ನೀನು ಹೋಗಿ ಯೆಹೂದದವರ ಮತ್ತು ಯೆರೂಸಲೇಮಿನವರ ಆಚರಣೆಯು ನಿನ್ನ ಕೈಯಲ್ಲಿರುವ ನಿನ್ನ ದೇವರ ನಿಯಮ ಗ್ರಂಥಕ್ಕೆ ಅನುಗುಣವಾಗಿ ಇದೆಯೋ, ಇಲ್ಲವೋ ವಿಮರ್ಶೆ ಮಾಡಬೇಕು. <verse eid="EZR 7:14"/><verse number="15" style="v" sid="EZR 7:15"/>ಅರಸನು ಮತ್ತು ಅವನ ಮಂತ್ರಿಗಳು ಯೆರೂಸಲೇಮಿನಲ್ಲಿ ವಾಸಿಸುತ್ತಿರುವ ಇಸ್ರಾಯೇಲ್ ದೇವರಿಗೆ ಕಾಣಿಕೆಯಾಗಿ ಸಮರ್ಪಿಸಿದ ಬೆಳ್ಳಿಬಂಗಾರವನ್ನು, <verse eid="EZR 7:15"/><verse number="16" style="v" sid="EZR 7:16"/>ಬಾಬಿಲೋನ್ ಸಂಸ್ಥಾನದಲ್ಲಿ ಸಿಕ್ಕುವ ಬೆಳ್ಳಿಬಂಗಾರವನ್ನು ಹಾಗು ಇಸ್ರಾಯೇಲ್ ಜನ ಸಾಮಾನ್ಯರೂ, ಯಾಜಕರೂ, ಯೆರೂಸಲೇಮಿನಲ್ಲಿರುವ ತಮ್ಮ ದೇವರ ಆಲಯಕ್ಕಾಗಿ ಸ್ವಂತ ಇಚ್ಛೆಯಿಂದ ಕೊಡುವ ಕಾಣಿಕೆಗಳನ್ನು ಅಲ್ಲಿಗೆ ಒಪ್ಪಿಸಬೇಕು. ಹೀಗೆಂದು ತಿಳಿಸಿ, ನಾನೂ ಮತ್ತು ನನ್ನ ಏಳುಮಂದಿ ಮಂತ್ರಿಗಳೂ ನಿನ್ನನ್ನು ಕಳುಹಿಸುತ್ತಿದ್ದೇವೆ. <verse eid="EZR 7:16"/><verse number="17" style="v" sid="EZR 7:17"/>ನೀನು ಈ ಹಣದಿಂದ ಹೋರಿ, ಟಗರು, ಕುರಿ, ಇವುಗಳನ್ನೂ ಮತ್ತು ಇವುಗಳೊಡನೆ ಸಮರ್ಪಣೆಯಾಗತಕ್ಕ ಧಾನ್ಯದ್ರವ್ಯ, ಪಾನದ್ರವ್ಯಗಳನ್ನೂ ಕೊಂಡುಕೊಂಡು, ಅವುಗಳನ್ನು ಯೆರೂಸಲೇಮಿನಲ್ಲಿರುವ ನಿಮ್ಮ ದೇವರ ಆಲಯದ ಬಲಿಪೀಠದ ಮೇಲೆ ಸಮರ್ಪಿಸಬೇಕು.<verse eid="EZR 7:17"/></para>
  <para style="pm">
    <verse number="18" style="v" sid="EZR 7:18"/>ಉಳಿದ ಬೆಳ್ಳಿಬಂಗಾರವನ್ನು, ನಿಮ್ಮ ದೇವರ ಚಿತ್ತದ ಪ್ರಕಾರ ನಿನಗೂ, ನಿನ್ನ ಸಹೋದರರಿಗೂ ಸರಿತೋರುವಂತೆ ವೆಚ್ಚ ಮಾಡಿರಿ. <verse eid="EZR 7:18"/><verse number="19" style="v" sid="EZR 7:19"/>ನಿನ್ನ ದೇವರ ಆಲಯದ ಆರಾಧನೆಗಾಗಿ ನಿನ್ನ ವಶಕ್ಕೆ ಕೊಡುವ ಸಾಮಗ್ರಿಗಳನ್ನು ಯೆರೂಸಲೇಮಿನ ದೇವರ ಸನ್ನಿಧಿಗೆ ತೆಗೆದುಕೊಂಡು ಹೋಗು. <verse eid="EZR 7:19"/><verse number="20" style="v" sid="EZR 7:20"/>ನಿನ್ನ ದೇವರ ಆಲಯಕ್ಕಾಗಿ ನೀನು ಬೇರೆ ಯಾವುದನ್ನಾದರೂ ವೆಚ್ಚಮಾಡಬೇಕಾದರೆ, ಅದನ್ನು ರಾಜ ಭಂಡಾರದಿಂದ ತೆಗೆದುಕೊಂಡು ವೆಚ್ಚಮಾಡು.<verse eid="EZR 7:20"/></para>
  <para style="pm">
    <verse number="21" style="v" sid="EZR 7:21"/>“ಅರ್ತಷಸ್ತ ರಾಜನಾದ ನಾನು, ಯೂಫ್ರೇಟೀಸ್ ನದಿ ಆಚೆಯ ಪ್ರಾಂತಗಳ ಭಂಡಾರ ಮುಖ್ಯಸ್ಥರಿಗೆ ಆಜ್ಞಾಪಿಸುವುದೇನೆಂದರೆ ಯಾಜಕನೂ, ಪರಲೋಕ ದೇವರ ಧರ್ಮಾಚಾರ್ಯನೂ ಆದ ಎಜ್ರನು ಕೇಳಿಕೊಳ್ಳುವುದನ್ನೆಲ್ಲಾ ನೀವು ತಪ್ಪದೆ ಕೊಡಬೇಕು. <verse eid="EZR 7:21"/><verse number="22" style="v" sid="EZR 7:22"/>3.4 ಮೆಟ್ರಿಕ್ ಟನ್ ಬೆಳ್ಳಿಯನ್ನು, 16 ಮೆಟ್ರಿಕ್ ಟನ್ ಗೋಧಿಯನ್ನು, 2,200 ಲೀಟರ್ ದ್ರಾಕ್ಷಾರಸವನ್ನು, 2,200 ಲೀಟರ್ ಎಣ್ಣೆಯನ್ನು, ಇಷ್ಟರ ಮಟ್ಟಿಗೂ ಕೊಡಬೇಕು. ಉಪ್ಪನ್ನು ಎಷ್ಟು ಬೇಕಾದರೂ ಕೊಡಬಹುದು. <verse eid="EZR 7:22"/><verse number="23" style="v" sid="EZR 7:23"/>ಅರಸನ ಮತ್ತು ಅವನ ಸಂತಾನದವರ ರಾಜ್ಯದ ಮೇಲೆ ದೇವ ಕೋಪವುಂಟಾಗದ ಹಾಗೆ, ನೀವು ಪರಲೋಕ ದೇವರ ಆಜ್ಞಾನುಸಾರ ಬೇಕಾದುದನ್ನೆಲ್ಲಾ ಯಾವ ಕೊರತೆಯೂ ಇಲ್ಲದೆ ಶ್ರದ್ಧೆಯಿಂದ ಒದಗಿಸಿಕೊಡಬೇಕು. <verse eid="EZR 7:23"/><verse number="24" style="v" sid="EZR 7:24"/>ಇದಲ್ಲದೆ, ಆ ದೇವಾಲಯದ ಯಾಜಕ, ಲೇವಿಯ, ಗಾಯಕ, ದ್ವಾರಪಾಲಕ, ಚಾಕರ ಮುಂತಾದ ಸೇವಕರಲ್ಲಿ ಯಾವನಿಂದಲೂ ಶುಲ್ಕ, ತೆರಿಗೆ, ಸುಂಕ, ಇವುಗಳನ್ನು ವಸೂಲಿ ಮಾಡುವುದಕ್ಕೆ ನಿಮಗೆ ಅಧಿಕಾರವಿಲ್ಲ ಎಂಬುದು ತಿಳಿದಿರಲಿ.”<verse eid="EZR 7:24"/></para>
  <para style="pm">
    <verse number="25" style="v" sid="EZR 7:25"/>“ಎಜ್ರನೇ, ನಿನ್ನಲ್ಲಿರುವ ನಿನ್ನ ದೇವರ ಜ್ಞಾನಕ್ಕೆ ಅನುಸಾರವಾಗಿ ನ್ಯಾಯಾಧೀಶರನ್ನೂ, ದಂಡಾಧಿಕಾರಿಯನ್ನೂ ನೇಮಿಸು. ಅವರು ನದಿಯಾಚೆಯ ಇಸ್ರಾಯೇಲರಲ್ಲಿ, ನಿನ್ನ ದೇವರ ನಿಯಮಗಳನ್ನು ಅರಿತಿರುವವರೆಲ್ಲರ ವ್ಯಾಜ್ಯಗಳನ್ನು ತೀರಿಸಲಿ. ಅರಿಯದವರಿಗೆ ನೀನು ಅದನ್ನು ಕಲಿಸಬೇಕು. <verse eid="EZR 7:25"/><verse number="26" style="v" sid="EZR 7:26"/>ನಿನ್ನ ದೇವರಾಜ್ಞೆಯನ್ನೂ, ರಾಜಾಜ್ಞೆಯನ್ನೂ ಕೈಗೊಳ್ಳದವರಿಗೆಲ್ಲಾ ಮರಣದಂಡನೆ ವಿಧಿಸುವುದು, ಗಡಿಪಾರು ಮಾಡುವುದು, ದಂಡ ತೆರಿಸುವುದು, ಬೇಡಿ ಹಾಕುವುದು, ಈ ವಿಧವಾದ ಶಿಕ್ಷೆಯನ್ನು ತಪ್ಪದೆ ನೀಡಬೇಕು.”<verse eid="EZR 7:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="EZR 7:27"/>ಆಗ ಎಜ್ರನು, “ನಮ್ಮ ತಂದೆಗಳ ದೇವರಾಗಿರುವ ಯೆಹೋವ ದೇವರು ಸ್ತುತಿಹೊಂದಲಿ! ಯೆರೂಸಲೇಮಿನಲ್ಲಿರುವ ಯೆಹೋವ ದೇವರ ಆಲಯಕ್ಕೆ ಮಹಿಮೆಯನ್ನು ತರುವಂತೆ, ಅರಸನ ಹೃದಯದಲ್ಲಿ ಇಂಥಾದ್ದನ್ನು ಇಟ್ಟಿದ್ದಾರೆ. <verse eid="EZR 7:27"/><verse number="28" style="v" sid="EZR 7:28"/>ಅರಸನ ಮುಂದೆಯೂ, ಅವನ ಸಲಹೆಗಾರರ ಮುಂದೆಯೂ, ಅರಸನ ಪರಾಕ್ರಮವುಳ್ಳ ಪ್ರಧಾನರ ಮುಂದೆಯೂ ನನಗೆ ಕೃಪೆತೋರಿಸಿದ್ದಾರೆ. ಹೀಗೆಯೇ ನನ್ನ ದೇವರಾಗಿರುವ ಯೆಹೋವ ದೇವರ ಹಸ್ತವು ನನ್ನ ಮೇಲೆ ಇದ್ದುದರಿಂದ, ನಾನು ಧೈರ್ಯಗೊಂಡು ಇಸ್ರಾಯೇಲಿನೊಳಗಿಂದ ಮುಖ್ಯಸ್ಥರನ್ನು ನನ್ನ ಸಂಗಡ ಹೋಗಲು ಕೂಡಿಸಿಕೊಂಡೆನು,” ಎಂದನು.<verse eid="EZR 7:28"/></para>
  <chapter eid="EZR 7"/>
  <chapter number="8" style="c" sid="EZR 8"/>
  <para style="s1">ಎಜ್ರನೊಂದಿಗೆ ಹಿಂದಿರುಗಿದ ಕುಟುಂಬಗಳ ನಾಯಕರು</para>
  <para style="li4">
    <verse number="1" style="v" sid="EZR 8:1"/>ಅರಸನಾದ ಅರ್ತಷಸ್ತನ ಆಳಿಕೆಯಲ್ಲಿ ಬಾಬಿಲೋನಿನಿಂದ ನನ್ನ ಸಂಗಡ ಹೊರಟು ಬಂದವರ ಕುಟುಂಬಗಳಲ್ಲಿ ಮುಖ್ಯಸ್ಥರು ಯಾರೆಂದರೆ:<verse eid="EZR 8:1"/></para>
  <para style="b"/>
  <para style="li1">
    <verse number="2" style="v" sid="EZR 8:2"/>ಫೀನೆಹಾಸನ ವಂಶಜರಲ್ಲಿ</para>
  <para style="li2" vid="EZR 8:2">ಗೇರ್ಷೋಮನೂ,</para>
  <para style="li1" vid="EZR 8:2">ಈತಾಮಾರನ ವಂಶಜರಲ್ಲಿ</para>
  <para style="li2" vid="EZR 8:2">ದಾನಿಯೇಲನೂ;</para>
  <para style="li1" vid="EZR 8:2">ದಾವೀದನ ವಂಶಜರಲ್ಲಿ</para>
  <para style="li2" vid="EZR 8:2">ಹಟ್ಟೂಷನೂ. <verse eid="EZR 8:2"/><verse number="3" style="v" sid="EZR 8:3"/>ಇವನು ಶೆಕನ್ಯನ ವಂಶಜನು.</para>
  <para style="li1" vid="EZR 8:3">ಪರೋಷಿನ ವಂಶಜರಲ್ಲಿ</para>
  <para style="li2" vid="EZR 8:3">ಜೆಕರ್ಯನೂ, ಅವನ ಸಂಗಡ ವಂಶಜರಲ್ಲಿ 150 ಮಂದಿ ಗಂಡಸರು.<verse eid="EZR 8:3"/></para>
  <para style="li1">
    <verse number="4" style="v" sid="EZR 8:4"/>ಪಹತ್ ಮೋವಾಬನ ವಂಶಜರಲ್ಲಿ</para>
  <para style="li2" vid="EZR 8:4">ಜೆರಹ್ಯನ ಮಗನಾದ ಎಲಿಹೋಯೇನೈನೂ, ಅವನ ಸಂಗಡ 200 ಮಂದಿ ಗಂಡಸರು.<verse eid="EZR 8:4"/></para>
  <para style="li1">
    <verse number="5" style="v" sid="EZR 8:5"/>ಜತ್ತುವಿನ ವಂಶಜರಲ್ಲಿ</para>
  <para style="li2" vid="EZR 8:5">ಯಹಜಿಯೇಲನ ಮಗನಾದ ಶೆಕನ್ಯನು ಮತ್ತು ಅವನ ಸಂಗಡ 300 ಮಂದಿ ಗಂಡಸರು.<verse eid="EZR 8:5"/></para>
  <para style="li1">
    <verse number="6" style="v" sid="EZR 8:6"/>ಅದೀನನ ವಂಶಜರಲ್ಲಿ</para>
  <para style="li2" vid="EZR 8:6">ಯೋನಾತಾನನ ಮಗ ಏಬೆದನೂ, ಅವನ ಸಂಗಡ 50 ಮಂದಿ ಗಂಡಸರು.<verse eid="EZR 8:6"/></para>
  <para style="li1">
    <verse number="7" style="v" sid="EZR 8:7"/>ಏಲಾಮನ ವಂಶಜರಲ್ಲಿ</para>
  <para style="li2" vid="EZR 8:7">ಅತಲ್ಯನ ಮಗ ಯೆಶಾಯನೂ, ಅವನ ಸಂಗಡ 70 ಮಂದಿ ಗಂಡಸರು.<verse eid="EZR 8:7"/></para>
  <para style="li1">
    <verse number="8" style="v" sid="EZR 8:8"/>ಶೆಫಟ್ಯನ ವಂಶಜರಲ್ಲಿ</para>
  <para style="li2" vid="EZR 8:8">ಮೀಕಾಯೇಲನ ಮಗ ಜೆಬದ್ಯನೂ, ಅವನ ಸಂಗಡ 80 ಮಂದಿ ಗಂಡಸರು.<verse eid="EZR 8:8"/></para>
  <para style="li1">
    <verse number="9" style="v" sid="EZR 8:9"/>ಯೋವಾಬನ ವಂಶಜರಲ್ಲಿ</para>
  <para style="li2" vid="EZR 8:9">ಯೆಹೀಯೇಲನ ಮಗ ಓಬದ್ಯನೂ, ಅವನ ಸಂಗಡ 218 ಮಂದಿ ಗಂಡಸರು.<verse eid="EZR 8:9"/></para>
  <para style="li1">
    <verse number="10" style="v" sid="EZR 8:10"/>ಬಾನೀಯ ವಂಶಜರಲ್ಲಿ</para>
  <para style="li2" vid="EZR 8:10">ಯೋಸಿಫ್ಯನ ಮಗ ಶೆಲೋಮೀತನು ಮತ್ತು ಅವನ ಸಂಗಡ 160 ಮಂದಿ ಗಂಡಸರು.<verse eid="EZR 8:10"/></para>
  <para style="li1">
    <verse number="11" style="v" sid="EZR 8:11"/>ಬೇಬೈನ ವಂಶಜರಲ್ಲಿ</para>
  <para style="li2" vid="EZR 8:11">ಬೆಬಾಯಿಯ ಮಗ ಜೆಕರ್ಯನು; ಅವನ ಸಂಗಡ 28 ಮಂದಿ ಗಂಡಸರು.<verse eid="EZR 8:11"/></para>
  <para style="li1">
    <verse number="12" style="v" sid="EZR 8:12"/>ಅಜ್ಗಾದನ ವಂಶಜರಲ್ಲಿ</para>
  <para style="li2" vid="EZR 8:12">ಹಕ್ಕಾಟಾನನ ಮಗ ಯೋಹಾನಾನನೂ, ಅವನ ಸಂಗಡ 110 ಮಂದಿ ಗಂಡಸರು;<verse eid="EZR 8:12"/></para>
  <para style="li1">
    <verse number="13" style="v" sid="EZR 8:13"/>ಅದೋನೀಕಾಮಿನ ವಂಶಜರಲ್ಲಿ</para>
  <para style="li2" vid="EZR 8:13">ಕಡೇ ಪುತ್ರರಾದ ಎಲೀಫೆಲೆಟ್, ಯೆವಿಯೇಲನು, ಶೆಮಾಯನು ಎಂಬ ಹೆಸರುಳ್ಳವರೂ, ಅವರ ಸಂಗಡ 60 ಮಂದಿ ಗಂಡಸರು;<verse eid="EZR 8:13"/></para>
  <para style="li1">
    <verse number="14" style="v" sid="EZR 8:14"/>ಬಿಗ್ವೈ ವಂಶಜರಲ್ಲಿ</para>
  <para style="li2" vid="EZR 8:14">ಜಕ್ಕೂರನ ಮಗನಾದ ಊತೈ ಮತ್ತು ಅವನ ಸಂಗಡ 70 ಮಂದಿ ಗಂಡಸರು.<verse eid="EZR 8:14"/></para>
  <para style="s1">ಯೆರೂಸಲೇಮಿಗೆ ಹಿಂದಿರುಗಿ ಬಂದದ್ದು</para>
  <para style="p">
    <verse number="15" style="v" sid="EZR 8:15"/>ಇವರನ್ನು ನಾನು ಅಹಾವಕ್ಕೆ ಹರಿಯುವ ನದಿಯ ಬಳಿಯಲ್ಲಿ ಕೂಡಿಸಿಕೊಂಡು, ಅಲ್ಲಿ ಮೂರು ದಿವಸ ಡೇರೆಗಳಲ್ಲಿ ವಾಸಿಸಿದ್ದೆವು. ನಾನು ಜನರನ್ನೂ, ಯಾಜಕರನ್ನೂ ಶೋಧಿಸಿ ನೋಡುವಾಗ, ಲೇವಿಯರಲ್ಲಿ ಒಬ್ಬನೂ ಅಲ್ಲಿ ಸಿಕ್ಕಲಿಲ್ಲ. <verse eid="EZR 8:15"/><verse number="16" style="v" sid="EZR 8:16"/>ಆಗ ನಾನು ಎಲೀಯೆಜೆರನು, ಅರೀಯೇಲನು, ಶೆಮಾಯನು, ಎಲ್ನತಾನನು, ಯಾರೀಬನು, ಎಲ್ನಾತಾನನು, ನಾತಾನನು, ಜೆಕರ್ಯನು, ಮೆಷುಲ್ಲಾಮನು ಎಂಬ ಪ್ರಮುಖರನ್ನೂ, ಯೋಯಾರೀಬನು, ಎಲ್ನತಾನನು ಎಂಬ ಗ್ರಹಿಕೆಯುಳ್ಳವರನ್ನೂ ಕರೆಕಳುಹಿಸಿದೆನು. <verse eid="EZR 8:16"/><verse number="17" style="v" sid="EZR 8:17"/>ಕಾಸಿಫ್ಯದಲ್ಲಿರುವ ಅಧಿಪತಿಯಾದ ಇದ್ದೋನನ ಬಳಿಗೆ ಅಪ್ಪಣೆಕೊಟ್ಟು ಕಳುಹಿಸಿ, ಅವರು ನಮ್ಮ ದೇವರ ಆಲಯಕ್ಕೋಸ್ಕರ ಸೇವಕರನ್ನು ತರುವ ಹಾಗೆ ಅವರು ಕಸಿಪ್ಯವೆಂಬ ಸ್ಥಳದಲ್ಲಿರುವ ಇದ್ದೋವಿಗೂ, ಅವನ ಸಹೋದರರಾದ ನೆತಿನಿಯರಿಗೂ ಹೇಳಬೇಕಾದದ್ದನ್ನು ತಿಳಿಸಿದೆನು. <verse eid="EZR 8:17"/><verse number="18" style="v" sid="EZR 8:18"/>ನಮ್ಮ ದೇವರ ಕೃಪಾಹಸ್ತವು ನಮ್ಮ ಮೇಲೆ ಇದ್ದುದರಿಂದ, ಅವರು ಇಸ್ರಾಯೇಲಿನ ಮಗನಾಗಿರುವ ಲೇವಿಯ ಮಗ ಮಹ್ಲೀಯ ಪುತ್ರರಲ್ಲಿ ಬುದ್ಧಿವಂತನಾದ ಶೇರೇಬ್ಯನೂ, ಅವನ ಪುತ್ರರೂ, ಸಹೋದರರೂ ಆದ ಹದಿನೆಂಟು ಮಂದಿಯನ್ನೂ, <verse eid="EZR 8:18"/><verse number="19" style="v" sid="EZR 8:19"/>ಹಷಬ್ಯನೂ, ಅವನ ಸಂಗಡ ಮೆರಾರೀಯ ಪುತ್ರರಲ್ಲಿ ಯೆಶಾಯನೂ, ಅವನ ಸಹೋದರರೂ, ಅವರ ಪುತ್ರರೂ ಆದ ಇಪ್ಪತ್ತು ಮಂದಿಯನ್ನೂ, <verse eid="EZR 8:19"/><verse number="20" style="v" sid="EZR 8:20"/>ದಾವೀದನೂ, ಪ್ರಧಾನರೂ, ಲೇವಿಯರನ್ನು ಸೇವಿಸುವುದಕ್ಕೆ ನೇಮಿಸಿದ ದೇವಾಲಯದ ಸೇವಕರಲ್ಲಿ ಇನ್ನೂರ ಇಪ್ಪತ್ತು ಮಂದಿ ಸೇವಕರನ್ನೂ, ನಮ್ಮ ಬಳಿಗೆ ಕರೆದುಕೊಂಡು ಬಂದರು. ಅವರೆಲ್ಲರ ಹೆಸರುಗಳು ದಾಖಲೆಯಾಗಿದ್ದವು.<verse eid="EZR 8:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="EZR 8:21"/>ಆಗ ನಾವು ನಮ್ಮ ದೇವರ ಮುಂದೆ ನಮ್ಮನ್ನು ತಗ್ಗಿಸಿಕೊಳ್ಳುವುದಕ್ಕೂ, ನಮಗೂ ನಮ್ಮ ಮಕ್ಕಳಿಗೂ, ನಮ್ಮ ಎಲ್ಲಾ ಸ್ಥಿತಿಗೂ ಅವರಿಂದ ಸರಿಯಾದ ಮಾರ್ಗವನ್ನು ಹುಡುಕುವುದಕ್ಕೂ, ನಾನು ಅಲ್ಲಿ ಅಹಾವ ನದಿಯ ಬಳಿಯಲ್ಲಿ ಉಪವಾಸವನ್ನು ಮಾಡಲು ಪ್ರಕಟಿಸಿದೆನು. <verse eid="EZR 8:21"/><verse number="22" style="v" sid="EZR 8:22"/>“ನಮ್ಮ ದೇವರ ಕೃಪಾಹಸ್ತವು ಅವರನ್ನು ಹುಡುಕುವವರೆಲ್ಲರ ಮೇಲೆಯೂ ಇದೆ, ಆದರೆ ಅವರ ಕೋಪವು ಅವರನ್ನು ತ್ಯಜಿಸುವ ಎಲ್ಲರ ವಿರುದ್ಧವಾಗಿರುತ್ತದೆ,” ಎಂದು ನಾವು ಅರಸನಿಗೆ ಹೇಳಿದ್ದರಿಂದ, ಮಾರ್ಗದಲ್ಲಿ ಶತ್ರುವಿಗೆ ವಿರೋಧವಾಗಿ ನಮಗೆ ಸಹಾಯ ಕೊಡಲು ಸೈನ್ಯವನ್ನೂ ಅಶ್ವಬಲವನ್ನೂ ಅರಸನಿಂದ ಕೇಳಲು ನಾಚಿಕೆಪಟ್ಟೆವು. <verse eid="EZR 8:22"/><verse number="23" style="v" sid="EZR 8:23"/>ಆದ್ದರಿಂದ ನಾವು ಉಪವಾಸ ಮಾಡಿ ಇದಕ್ಕೋಸ್ಕರ ನಮ್ಮ ದೇವರನ್ನು ಬೇಡಿಕೊಂಡೆವು. ದೇವರು ನಮ್ಮ ವಿಜ್ಞಾಪನೆಯನ್ನು ಕೇಳಿದರು.<verse eid="EZR 8:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="EZR 8:24"/>ನಾನು ಯಾಜಕರ ಪ್ರಮುಖರಲ್ಲಿ ಹನ್ನೆರಡು ಮಂದಿಯಾಗಿರುವ ಶೇರೇಬ್ಯ, ಹಷಬ್ಯ ಇವರ ಸಂಗಡ ಅವರ ಸಹೋದರರಲ್ಲಿ ಹತ್ತು ಮಂದಿಯನ್ನೂ ಪ್ರತ್ಯೇಕಿಸಿ <verse eid="EZR 8:24"/><verse number="25" style="v" sid="EZR 8:25"/>ಅರಸನೂ, ಅವನ ಸಲಹೆಗಾರರೂ, ಅವನ ಪ್ರಧಾನರೂ ಅಲ್ಲಿದ್ದ ಎಲ್ಲಾ ಇಸ್ರಾಯೇಲರೂ ನಮ್ಮ ದೇವರ ಆಲಯಕ್ಕೆ ಅರ್ಪಿಸಿದ ಕಾಣಿಕೆಯಾದ ಬೆಳ್ಳಿಯನ್ನೂ, ಬಂಗಾರವನ್ನೂ, ಸಲಕರಣೆಗಳನ್ನೂ ಅವರಿಗೆ ತೂಕಮಾಡಿ ಕೊಟ್ಟೆನು. <verse eid="EZR 8:25"/><verse number="26" style="v" sid="EZR 8:26"/>ಅವರ ಕೈಗೆ ಕೊಟ್ಟ ಸಲಕರಣೆಗಳ ತೂಕ 22 ಬೆಳ್ಳಿ ಮೆಟ್ರಿಕ್ ಟನ್; ಬೆಳ್ಳಿಯ ನೂರು ಸಾಮಗ್ರಿಗಳ ತೂಕ 3.4 ಮೆಟ್ರಿಕ್ ಟನ್; ಬಂಗಾರ 3.4 ಮೆಟ್ರಿಕ್ ಟನ್. <verse eid="EZR 8:26"/><verse number="27" style="v" sid="EZR 8:27"/>ಬಂಗಾರದ ಇಪ್ಪತ್ತು ಬಟ್ಟಲುಗಳು ಪ್ರತಿಯೊಂದೂ 8.4 ಕಿಲೋಗ್ರಾಂ, ಇವುಗಳಲ್ಲದೆ ಶ್ರೇಷ್ಠವಾದ ಕಂಚಿನ ಎರಡು ಪಾತ್ರೆಗಳಿದ್ದವು. ಅವು ಬಂಗಾರದಷ್ಟು ಬೆಲೆಯುಳ್ಳವುಗಳು.<verse eid="EZR 8:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="EZR 8:28"/>ನಾನು ಅವರಿಗೆ, “ನೀವು ಯೆಹೋವ ದೇವರಿಗೆ ಪ್ರತಿಷ್ಠಿತರಾಗಿದ್ದೀರಿ. ಈ ವಸ್ತುಗಳು ಹಾಗೆಯೇ ಪ್ರತಿಷ್ಠಿತವು. ಈ ಬೆಳ್ಳಿ ಬಂಗಾರವು ನಿಮ್ಮ ಪಿತೃಗಳ ದೇವರಾಗಿರುವ ಯೆಹೋವ ದೇವರಿಗೆ ಸಮರ್ಪಿತವಾದ ಕಾಣಿಕೆ. <verse eid="EZR 8:28"/><verse number="29" style="v" sid="EZR 8:29"/>ನೀವು ಯೆರೂಸಲೇಮಿನಲ್ಲಿ ಯೆಹೋವ ದೇವರ ಆಲಯದ ಕೊಠಡಿಗಳೊಳಗೆ ಯಾಜಕರ ಲೇವಿಯರ, ಪ್ರಧಾನರ ಮುಂದೆಯೂ ಇಸ್ರಾಯೇಲ್ ಕುಟುಂಬಗಳ ಪ್ರಧಾನರ ಮುಂದೆಯೂ ತೂಕಮಾಡುವವರೆಗೆ ಜಾಗ್ರತೆಯಾಗಿ ಕಾಪಾಡಿರಿ,” ಎಂದೆನು. <verse eid="EZR 8:29"/><verse number="30" style="v" sid="EZR 8:30"/>ಹಾಗೆಯೇ ಯಾಜಕರೂ, ಲೇವಿಯರೂ ತೂಕದ ಹಾಗೆ ಬೆಳ್ಳಿಯನ್ನೂ, ಬಂಗಾರವನ್ನೂ, ವಸ್ತುಗಳನ್ನೂ ಯೆರೂಸಲೇಮಿನಲ್ಲಿರುವ ನಮ್ಮ ದೇವರ ಆಲಯಕ್ಕೆ ತೆಗೆದುಕೊಂಡು ಬಂದರು.<verse eid="EZR 8:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="EZR 8:31"/>ನಾವು ಯೆರೂಸಲೇಮಿಗೆ ಹೋದ ಮೊದಲನೆಯ ತಿಂಗಳ, ಹನ್ನೆರಡನೆಯ ದಿವಸದಲ್ಲಿ ಅಹಾವ ನದಿಯನ್ನು ಬಿಟ್ಟು ಹೊರಟೆವು. ನಮ್ಮ ದೇವರ ಹಸ್ತವು ನಮ್ಮ ಮೇಲೆ ಇದ್ದುದರಿಂದ, ದೇವರು ಶತ್ರುವಿನ ಕೈಗೂ, ಮಾರ್ಗದಲ್ಲಿ ಹೊಂಚುಹಾಕುವವರ ಕೈಗೂ ನಮ್ಮನ್ನು ತಪ್ಪಿಸಿಬಿಟ್ಟರು. <verse eid="EZR 8:31"/><verse number="32" style="v" sid="EZR 8:32"/>ನಾವು ಯೆರೂಸಲೇಮಿಗೆ ಬಂದು, ಅಲ್ಲಿ ಮೂರು ದಿವಸ ವಿಶ್ರಮಿಸಿಕೊಂಡೆವು.<verse eid="EZR 8:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="EZR 8:33"/>ತರುವಾಯ ನಾಲ್ಕನೆಯ ದಿವಸದಲ್ಲಿ ಆ ಬೆಳ್ಳಿಯೂ, ಬಂಗಾರವೂ, ಸಲಕರಣೆಗಳೂ ನಮ್ಮ ದೇವರ ಆಲಯದಲ್ಲಿ ಯಾಜಕರಾಗಿರುವ ಊರೀಯನ ಮಗ ಮೆರೇಮೋತನ ಕೈಯಿಂದ ತೂಕಮಾಡಿ ಕೊಟ್ಟೆವು. ಅವನ ಸಂಗಡ ಲೇವಿಯರಾದ ಫೀನೆಹಾಸನ ಮಗನಾಗಿರುವ ಎಲಿಯಾಜರನೂ, ಯೇಷೂವನ ಮಗ ಯೋಜಾಬಾದನೂ, ಬಿನ್ನೂಯ್ ಮಗ ನೋವದ್ಯನೂ ಇದ್ದರು. <verse eid="EZR 8:33"/><verse number="34" style="v" sid="EZR 8:34"/>ಅದರದರ ಲೆಕ್ಕದ ಪ್ರಕಾರವೂ, ತೂಕದ ಪ್ರಕಾರವೂ ಎಲ್ಲವುಗಳ ತೂಕವು ತಕ್ಷಣವೇ ಲಿಖಿತವಾಯಿತು.<verse eid="EZR 8:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="EZR 8:35"/>ಸೆರೆಯಿಂದ ಮರಳಿ ಬಂದವರು ಇಸ್ರಾಯೇಲ್ ದೇವರಿಗೆ ದಹನಬಲಿಗಳನ್ನು ಅರ್ಪಿಸಿದರು. ಸಮಸ್ತ ಇಸ್ರಾಯೇಲರಿಗೋಸ್ಕರ ಹನ್ನೆರಡು ಹೋರಿಗಳನ್ನೂ, ತೊಂಬತ್ತಾರು ಟಗರುಗಳನ್ನೂ, ಎಪ್ಪತ್ತೇಳು ಕುರಿಮರಿಗಳನ್ನೂ, ದೋಷಪರಿಹಾರಕ್ಕಾಗಿ ಹನ್ನೆರಡು ಹೋತಗಳನ್ನೂ ಅರ್ಪಿಸಿದರು. ಇವೆಲ್ಲಾ ಯೆಹೋವ ದೇವರಿಗೆ ದಹನಬಲಿಯಾಗಿತ್ತು. <verse eid="EZR 8:35"/><verse number="36" style="v" sid="EZR 8:36"/>ಅವರು ಅರಸನ ಆಜ್ಞೆಗಳನ್ನು ಯೂಫ್ರೇಟೀಸ್ ನದಿಯ ಈಚೆಯಲ್ಲಿರುವ ಅರಸನ ಅಧಿಪತಿಗಳಿಗೂ, ಯಜಮಾನರಿಗೂ ಒಪ್ಪಿಸಿದರು. ಆಗ ಅವರು ಜನರಿಗೂ, ದೇವರ ಆಲಯಕ್ಕೂ ಸಹಾಯ ಮಾಡಿದರು.<verse eid="EZR 8:36"/></para>
  <chapter eid="EZR 8"/>
  <chapter number="9" style="c" sid="EZR 9"/>
  <para style="s1">ಅಂತರ ವಿವಾಹದ ಬಗ್ಗೆ ಎಜ್ರನ ಪ್ರಾರ್ಥನೆ</para>
  <para style="p">
    <verse number="1" style="v" sid="EZR 9:1"/>ಈ ಸಂಗತಿಗಳನ್ನು ಮಾಡಿದ ತರುವಾಯ ಪ್ರಧಾನರು ನನ್ನ ಬಳಿಗೆ ಬಂದು, “ಇಸ್ರಾಯೇಲರೂ, ಯಾಜಕರೂ, ಲೇವಿಯರೂ ತಮ್ಮ ನೆರೆಯವರಿಂದ ಪ್ರತ್ಯೇಕಿಸಿಕೊಳ್ಳಲಿಲ್ಲ. ಅವರು ಕಾನಾನ್ಯರು, ಹಿತ್ತಿಯರು, ಪೆರಿಜೀಯರು, ಯೆಬೂಸಿಯರು, ಅಮ್ಮೋನ್ಯರು, ಮೋವಾಬ್ಯರು, ಈಜಿಪ್ಟರು, ಅಮೋರಿಯರು ಇವರ ಅಸಹ್ಯ ಸಂಗತಿಗಳ ಪದ್ಧತಿಗಳಂತೆ ನಡೆಯುತ್ತಾ ಇದ್ದಾರೆ. <verse eid="EZR 9:1"/><verse number="2" style="v" sid="EZR 9:2"/>ಇಸ್ರಾಯೇಲರು ತಮಗೂ, ತಮ್ಮ ಪುತ್ರರಿಗೂ ಅವರ ಪುತ್ರಿಯರನ್ನು ತೆಗೆದುಕೊಂಡರು. ಆದಕಾರಣ ಪರಿಶುದ್ಧ ಸಂತಾನದವರು ಈ ದೇಶದ ಜನರ ಸಂಗಡ ಬೆರೆತುಕೊಂಡಿದ್ದಾರೆ. ನಿಶ್ಚಯವಾಗಿ ಪ್ರಧಾನರು ಮತ್ತು ಅಧಿಕಾರಸ್ಥರು ಈ ಅಪನಂಬಿಗಸ್ತಿಕೆಗೆ ಮುಂದಾಳುಗಳಾದರು,” ಎಂದು ತಿಳಿಸಿದರು.<verse eid="EZR 9:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="EZR 9:3"/>ನಾನು ಇದನ್ನು ಕೇಳಿದಾಗ ನನ್ನ ವಸ್ತ್ರವನ್ನೂ, ನನ್ನ ನಿಲುವಂಗಿಯನ್ನೂ ಹರಿದು ನನ್ನ ತಲೆಯ ಮತ್ತು ಗಡ್ಡದ ಕೂದಲನ್ನು ಕಿತ್ತು, ಸ್ತಬ್ಧನಾಗಿ ಕುಳಿತುಕೊಂಡೆನು. <verse eid="EZR 9:3"/><verse number="4" style="v" sid="EZR 9:4"/>ಆಗ ಸೆರೆಯಿಂದ ಬಂದವರ ಅಪರಾಧಕ್ಕೋಸ್ಕರ ಇಸ್ರಾಯೇಲ್ ದೇವರ ಮಾತುಗಳಿಗೆ ಹೆದರಿಕೊಂಡಿದ್ದ ಮನುಷ್ಯರೆಲ್ಲರೂ, ನನ್ನ ಬಳಿಗೆ ಕೂಡಿಬಂದರು. ಆದರೆ ನಾನು ಸಾಯಂಕಾಲದ ಬಲಿಯನ್ನು ಅರ್ಪಿಸುವವರೆಗೆ ಸ್ತಬ್ಧನಾಗಿ ಕುಳಿತುಕೊಂಡಿದ್ದೆನು.<verse eid="EZR 9:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="EZR 9:5"/>ಆದರೆ ಸಾಯಂಕಾಲದ ಬಲಿಯನ್ನರ್ಪಿಸುವಾಗ, ನಾನು ನನ್ನ ಶೋಕ ಸ್ಥಿತಿಯಿಂದ ಎದ್ದು, ನನ್ನ ವಸ್ತ್ರವನ್ನೂ, ನನ್ನ ನಿಲುವಂಗಿಯನ್ನೂ ಹರಿದುಕೊಂಡವನಾಗಿ, ನನ್ನ ಮೊಣಕಾಲುಗಳನ್ನೂರಿ, ನನ್ನ ಕೈಗಳನ್ನು ನನ್ನ ದೇವರಾಗಿರುವ ಯೆಹೋವ ದೇವರ ಮುಂದೆ ಚಾಚಿ, <verse eid="EZR 9:5"/><verse number="6" style="v" sid="EZR 9:6"/>ಪ್ರಾರ್ಥಿಸಿದೆನು:</para>
  <para style="pm" vid="EZR 9:6">“ನನ್ನ ದೇವರೇ, ನಾನು ನನ್ನ ಮುಖವನ್ನು ನಿಮ್ಮ ಮುಂದೆ ಎತ್ತಲಾರದೆ, ಲಜ್ಜೆಯಿಂದ ನಾಚಿಕೆಪಡುತ್ತೇನೆ. ನನ್ನ ದೇವರೇ, ನಮ್ಮ ಅಕ್ರಮಗಳು ನಮ್ಮ ತಲೆಮೀರಿ ಬೆಳೆದಿವೆ. ನಮ್ಮ ಅಪರಾಧವು ಆಕಾಶವನ್ನು ಮುಟ್ಟುವಷ್ಟು ದೊಡ್ಡದಾಗಿವೆ. <verse eid="EZR 9:6"/><verse number="7" style="v" sid="EZR 9:7"/>ನಮ್ಮ ತಂದೆಗಳ ದಿವಸಗಳು ಮೊದಲ್ಗೊಂಡು ಈ ದಿವಸದವರೆಗೆ ದೊಡ್ಡ ಅಪರಾಧಕ್ಕೊಳಗಾಗಿದ್ದೇವೆ. ಇಂದಿನ ಪ್ರಕಾರವೇ ನಾವು ಅನ್ಯದೇಶಗಳ ಅರಸರ ಕೈಗೆ ಸಿಕ್ಕಿಬಿದ್ದೆವು. ನಮ್ಮ ಅಕ್ರಮಗಳಿಗೋಸ್ಕರ ನಾವೂ, ನಮ್ಮ ಅರಸರೂ ನಮ್ಮ ಯಾಜಕರೂ ಖಡ್ಗವೂ ಸೆರೆಗೂ ಕೊಳ್ಳೆಗೂ ನಾಚಿಕೆಗೂ ಗುರಿಯಾಗಿದ್ದೇವೆ.<verse eid="EZR 9:7"/></para>
  <para style="pm">
    <verse number="8" style="v" sid="EZR 9:8"/>“ಈಗ ನಮ್ಮ ಯೆಹೋವ ದೇವರೇ, ಸ್ವಲ್ಪ ಹೊತ್ತು ನಮಗೆ ದಯೆತೋರಿ ನಮ್ಮ ದಾಸತ್ವದಿಂದ ನಮಗೆ ಬಿಡುಗಡೆ ಕೊಟ್ಟಿದ್ದೀರಿ. ನಮ್ಮ ಕಣ್ಣುಗಳನ್ನು ಬೆಳಗಿಸಿ, ತಮ್ಮ ಪರಿಶುದ್ಧ ಸ್ಥಾನದಲ್ಲಿ ನೆಲೆಗೊಳಿಸುವಂತೆ ಮಾಡಿದ್ದೀರಿ <verse eid="EZR 9:8"/><verse number="9" style="v" sid="EZR 9:9"/>ನಾವು ಗುಲಾಮರಾದರೂ ನಮ್ಮ ದೇವರು ನಮ್ಮ ದಾಸತ್ವದಲ್ಲಿ ನಮ್ಮನ್ನು ಕೈಬಿಡಲಿಲ್ಲ; ಹಾಳುಬಿದ್ದ ದೇವಾಲಯವನ್ನು ಪುನಃ ಕಟ್ಟಿ ಭದ್ರಪಡಿಸಲು ನಮಗೆ ನವಜೀವನ ಕೊಟ್ಟು, ಯೆಹೂದ ಮತ್ತು ಯೆರೂಸಲೇಮಿನಲ್ಲಿ ನಮಗೆ ಸಂರಕ್ಷಣೆಯ ಗೋಡೆ ಸಿಗುವಂತೆ, ಪಾರಸಿಯ ರಾಜರ ಸಮ್ಮುಖದಲ್ಲಿ ನಮಗೆ ದಯೆಯನ್ನು ದಯಪಾಲಿಸಿದ್ದೀರಿ.<verse eid="EZR 9:9"/></para>
  <para style="pm">
    <verse number="10" style="v" sid="EZR 9:10"/>“ಆದರೆ ಈಗ ನಮ್ಮ ದೇವರೇ, ಇದರ ತರುವಾಯ ನಾವು ಏನು ಹೇಳೋಣ? ನಿಮ್ಮ ಆಜ್ಞೆಗಳನ್ನು ನಾವು ತೊರೆದಿದ್ದೇವೆ. <verse eid="EZR 9:10"/><verse number="11" style="v" sid="EZR 9:11"/>ನಿಮ್ಮ ಸೇವಕರಾದ ಪ್ರವಾದಿಗಳ ಮುಖಾಂತರ ನೀವು ಆ ನಿಮ್ಮ ಆಜ್ಞೆಗಳನ್ನು ಕೊಟ್ಟಿದ್ದೀರಿ. ‘ನೀವು ಸ್ವಾಧೀನಮಾಡಿಕೊಳ್ಳಲು ಹೋಗುವ ದೇಶವು, ಆ ದೇಶಗಳ ಜನರ ಅಶುದ್ಧತ್ವದಿಂದ ಮೈಲಿಗೆಯಾದ ದೇಶವಾಗಿದೆ. ಆ ಜನರು ತಮ್ಮ ಅಸಹ್ಯ ಅಭ್ಯಾಸಗಳಿಂದ ಅದನ್ನು ಒಂದು ಮೂಲೆಯಿಂದ ಮತ್ತೊಂದು ಮೂಲೆಯವರೆಗೂ ತುಂಬಿಸಿದ್ದಾರೆ. <verse eid="EZR 9:11"/><verse number="12" style="v" sid="EZR 9:12"/>ಆದ್ದರಿಂದ ನೀವು ಪ್ರಬಲವಾಗಿ ದೇಶದ ಸಮೃದ್ಧಿಯನ್ನು ಅನುಭವಿಸಿ, ಅದನ್ನು ನಿಮ್ಮ ಮಕ್ಕಳಿಗೆ ಶಾಶ್ವತ ಸ್ವಾಸ್ತ್ಯವನ್ನಾಗಿ ಕೊಡುವ ಹಾಗೆ ನೀವು ನಿಮ್ಮ ಪುತ್ರಿಯರನ್ನು ಅವರ ಪುತ್ರರಿಗೆ ಮದುವೆಮಾಡಿಕೊಡಬೇಡಿರಿ. ಅವರ ಪುತ್ರಿಯರನ್ನು ನಿಮ್ಮ ಪುತ್ರರಿಗೆ ತೆಗೆದುಕೊಳ್ಳಬೇಡಿರಿ. ಅವರ ಸಮಾಧಾನವನ್ನೂ, ಅವರ ಮೇಲನ್ನೂ ಹುಡುಕಲೇ ಬೇಡಿರಿ,’ ಎಂದು ದೇವರೇ ನಮಗೆ ಹೇಳಿದಿರಲ್ಲವೇ?<verse eid="EZR 9:12"/></para>
  <para style="pm">
    <verse number="13" style="v" sid="EZR 9:13"/>“ನಮ್ಮ ದುಷ್ಕಾರ್ಯ ಹಾಗೂ ನಮ್ಮ ಮಹಾ ಅಪರಾಧಕ್ಕಾಗಿ ನಮ್ಮ ಮೇಲೆ ಬಂದದ್ದೆಲ್ಲ ಬಂದ ತರುವಾಯ, ನಮ್ಮ ದೇವರಾಗಿರುವ ನೀವು ನಮ್ಮ ಪಾಪಗಳಿಗಿಂತ ಕಡಿಮೆ ಶಿಕ್ಷೆ ನೀಡಿದ್ದೀರಿ ಮತ್ತು ನಮ್ಮಲ್ಲಿ ಈ ರೀತಿಯಾಗಿ ಇಷ್ಟುಮಂದಿಯನ್ನು ಉಳಿಸಿದ್ದೀರಿ. <verse eid="EZR 9:13"/><verse number="14" style="v" sid="EZR 9:14"/>ನಾವು ನಿಮ್ಮ ಆಜ್ಞೆಗಳನ್ನು ಪುನಃ ಮೀರಿ ಅಸಹ್ಯ ಅಭ್ಯಾಸಕರಾದ ಈ ಜನರ ಸಂಗಡ ವಿವಾಹ ಸಂಬಂಧ ಮಾಡಬಹುದೇ? ಹಾಗೆ ಮಾಡಿದರೆ, ಉಳಿದವರೂ ತಪ್ಪಿಸಿಕೊಂಡವರೂ ಇಲ್ಲದಂತೆ ದಂಡಿಸಲು, ನೀವು ನಮ್ಮ ಮೇಲೆ ಕೋಪಗೊಳ್ಳುವುದು ಯೋಗ್ಯವೇ? <verse eid="EZR 9:14"/><verse number="15" style="v" sid="EZR 9:15"/>ಇಸ್ರಾಯೇಲರ ದೇವರಾಗಿರುವ ಯೆಹೋವ ದೇವರೇ, ನೀವು ನೀತಿವಂತರು! ನಾವು ಇಂದು ತಪ್ಪಿಸಿಕೊಂಡು ಉಳಿದಿದ್ದೇವೆ. ನಾವು ನಮ್ಮ ಅಪರಾಧಗಳ ನಿಮಿತ್ತ ನಿಮ್ಮ ಮುಂದೆ ನಿಲ್ಲಲು ಯೋಗ್ಯರಲ್ಲದಿದ್ದರೂ, ನಮ್ಮ ಅಪರಾಧಗಳೊಂದಿಗೆ ನಿಮ್ಮ ಮುಂದೆ ನಿಂತಿದ್ದೇವೆ,” ಎಂದು ಪ್ರಾರ್ಥನೆಮಾಡಿದೆ.<verse eid="EZR 9:15"/></para>
  <chapter eid="EZR 9"/>
  <chapter number="10" style="c" sid="EZR 10"/>
  <para style="s1">ಜನರು ಪಾಪದ ಅರಿಕೆಮಾಡಿದ್ದು</para>
  <para style="p">
    <verse number="1" style="v" sid="EZR 10:1"/>ಎಜ್ರನು ಪ್ರಾರ್ಥಿಸಿ ಅರಿಕೆಮಾಡಿ ಅತ್ತು ದೇವರ ಆಲಯದ ಮುಂದೆ ಅಡ್ಡಬಿದ್ದ ತರುವಾಯ ಇಸ್ರಾಯೇಲರಲ್ಲಿ ಸ್ತ್ರೀಯರೂ, ಪುರುಷರೂ, ಮಕ್ಕಳು ಮಹಾಕೂಟವಾಗಿ ಅವನ ಬಳಿಯಲ್ಲಿ ಕೂಡಿಕೊಂಡು ಬಂದರು. ಜನರು ಬಹಳವಾಗಿ ಅತ್ತರು. <verse eid="EZR 10:1"/><verse number="2" style="v" sid="EZR 10:2"/>ಆಗ ಏಲಾಮನ ವಂಶಜರಲ್ಲಿ ಒಬ್ಬನಾದ ಯೆಹೀಯೇಲನ ಮಗನಾದ ಶೆಕನ್ಯನು ಎಜ್ರನಿಗೆ, “ನಾವು ಅನ್ಯದೇಶನಿವಾಸಿಗಳಿಂದ ಹೆಣ್ಣನ್ನು ತೆಗೆದುಕೊಂಡದ್ದರಿಂದ, ನಮ್ಮ ದೇವರಿಗೆ ವಿರೋಧವಾಗಿ ದ್ರೋಹಮಾಡಿದ್ದೇವೆ. ಆದರೂ ಈಗ ಈ ಕಾರ್ಯವನ್ನು ಕುರಿತು ಇಸ್ರಾಯೇಲರಲ್ಲಿ ನಿರೀಕ್ಷೆ ಉಂಟು. <verse eid="EZR 10:2"/><verse number="3" style="v" sid="EZR 10:3"/>ಆದಕಾರಣ ನಮ್ಮ ಒಡೆಯನಾದ ನಿನ್ನ ಯೋಚನೆಯ ಪ್ರಕಾರವಾಗಿಯೂ, ನಮ್ಮ ದೇವರ ಆಜ್ಞೆಗೆ ಭಯಪಡುವವರ ಯೋಚನೆಯ ಪ್ರಕಾರವಾಗಿಯೂ ಆ ಸಮಸ್ತ ಸ್ತ್ರೀಯರನ್ನೂ, ಅವರಿಂದ ಹುಟ್ಟಿದವರನ್ನೂ ಕಳುಹಿಸಿಬಿಡಲು, ಈಗಲೇ ನಮ್ಮ ದೇವರ ಮುಂದೆ ಒಡಂಬಡಿಕೆ ಮಾಡಿಕೊಂಡು, ದೇವರ ನಿಯಮದ ಪ್ರಕಾರ ನಡೆಯೋಣ. <verse eid="EZR 10:3"/><verse number="4" style="v" sid="EZR 10:4"/>ನೀನು ಏಳು, ಏಕೆಂದರೆ ಈ ಕಾರ್ಯ ನಿನಗೆ ಸಂಬಂಧಿಸಿದೆ. ನಾವು ನಿನ್ನ ಸಂಗಡ ನಿಲ್ಲುತ್ತೇವೆ. ಧೈರ್ಯದಿಂದ ಅದನ್ನು ಮಾಡು,” ಎಂದನು.<verse eid="EZR 10:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="EZR 10:5"/>ಆಗ ಎಜ್ರನು ಎದ್ದು, ಮಹಾಯಾಜಕರೂ ಲೇವಿಯರೂ ಸಮಸ್ತ ಇಸ್ರಾಯೇಲರೂ ಈ ಮಾತಿನ ಪ್ರಕಾರವಾಗಿ ಮಾಡಲು, ಅವರು ಆಣೆಯಿಡುವ ಹಾಗೆ ಮಾಡಿದನು. ಅವರು ಆಣೆ ಇಟ್ಟರು. <verse eid="EZR 10:5"/><verse number="6" style="v" sid="EZR 10:6"/>ಆಮೇಲೆ ಎಜ್ರನು ಎದ್ದು ದೇವರ ಆಲಯದ ಮುಂಭಾಗದ ಸ್ಥಳವನ್ನು ಬಿಟ್ಟು, ಎಲ್ಯಾಷೀಬನ ಮಗ ಯೆಹೋಹಾನಾನನ ಕೊಠಡಿಗೆ ಹೋಗಿ, ದುಃಖಿಸುತ್ತಾ ಅನ್ನಪಾನಗಳನ್ನು ತೆಗೆದುಕೊಳ್ಳದೆ ರಾತ್ರಿಯನ್ನು ಕಳೆದನು. ಏಕೆಂದರೆ ಸೆರೆಯಿಂದ ಯೆರೂಸಲೇಮಿಗೆ ಬಂದಿದ್ದ ಯೆಹೂದ್ಯರ ಅಪನಂಬಿಗಸ್ತಿಕೆಯ ಬಗ್ಗೆ ತುಂಬಾ ದುಃಖಿತನಾಗಿದ್ದನು.<verse eid="EZR 10:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="EZR 10:7"/>ತರುವಾಯ ಸೆರೆಯಿಂದ ಬಂದವರೆಲ್ಲರೂ ಯೆರೂಸಲೇಮಿಗೆ ಕೂಡಿಬರಬೇಕೆಂದು ಸಮಸ್ತ ಯೆಹೂದ ಮತ್ತು ಯೆರೂಸಲೇಮಿನಲ್ಲಿ ಸಾರಲಾಗಿತ್ತು. <verse eid="EZR 10:7"/><verse number="8" style="v" sid="EZR 10:8"/>ಇದಲ್ಲದೆ ಯಾವನಾದರೂ ಪ್ರಧಾನರ, ಹಿರಿಯರ ನಿರ್ಣಯದ ಪ್ರಕಾರ ಮೂರು ದಿವಸದಲ್ಲಿ ಬಾರದೆ ಇದ್ದರೆ, ಅವನ ಆಸ್ತಿಯೆಲ್ಲಾ ದಂಡವಾಗಿ ತೆಗೆದುಕೊಳ್ಳಲಾಗುವುದೆಂದೂ, ಅವನು ಸೆರೆಯಿಂದ ಬಂದವರ ಕೂಟದಿಂದ ಬಹಿಷ್ಕೃತನಾಗುವನು ಎಂದೂ ಪ್ರಕಟಿಸಿದರು.<verse eid="EZR 10:8"/></para>
  <para style="b"/>
  <para style="p">
    <verse number="9" style="v" sid="EZR 10:9"/>ಆಗ ಯೆಹೂದ ಮತ್ತು ಬೆನ್ಯಾಮೀನಿನ ಮನುಷ್ಯರೆಲ್ಲರೂ ಮೂರು ದಿವಸಗಳೊಳಗೆ ಯೆರೂಸಲೇಮಿನಲ್ಲಿ ಕೂಡಿದರು. ಅದು ಒಂಬತ್ತನೆಯ ತಿಂಗಳ, ಇಪ್ಪತ್ತನೆಯ ದಿವಸವಾಗಿತ್ತು. ಜನರೆಲ್ಲರು ದೇವರ ಆಲಯದ ಬೀದಿಯಲ್ಲಿ ಆ ಕಾರ್ಯಕ್ಕೋಸ್ಕರವೂ, ಮಳೆಗೋಸ್ಕರವೂ ನಡುಗಿ ಕುಳಿತುಕೊಂಡಿದ್ದರು. <verse eid="EZR 10:9"/><verse number="10" style="v" sid="EZR 10:10"/>ಆಗ ಯಾಜಕನಾದ ಎಜ್ರನು ಎದ್ದು ಅವರಿಗೆ, “ನೀವು ಇಸ್ರಾಯೇಲರ ಅಪರಾಧವನ್ನು ಅಧಿಕವಾಗಿ ಮಾಡಲು, ಅನ್ಯ ಸ್ತ್ರೀಯರನ್ನು ಮದುವೆ ಮಾಡಿಕೊಂಡಿದ್ದರಿಂದ ದ್ರೋಹ ಮಾಡಿದಿರಿ. <verse eid="EZR 10:10"/><verse number="11" style="v" sid="EZR 10:11"/>ಆದ್ದರಿಂದ ನೀವು ನಿಮ್ಮ ಪಿತೃಗಳ ದೇವರಾಗಿರುವ ಯೆಹೋವ ದೇವರ ಮುಂದೆ ನಿಮ್ಮ ಪಾಪಗಳನ್ನು ಅರಿಕೆಮಾಡಿ, ಅವರ ಚಿತ್ತದ ಪ್ರಕಾರಮಾಡಿ, ಈ ದೇಶದ ಜನರಿಂದಲೂ, ಅನ್ಯ ಸ್ತ್ರೀಯರಿಂದಲೂ ನಿಮ್ಮನ್ನು ಪ್ರತ್ಯೇಕಿಸಿಕೊಳ್ಳಿರಿ,” ಎಂದನು.<verse eid="EZR 10:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="EZR 10:12"/>ಆಗ ಸಭೆಯೆಲ್ಲಾ ಉತ್ತರವಾಗಿ ದೊಡ್ಡ ಶಬ್ದದಿಂದ, “ನೀನು ಸರಿಯಾಗಿ ಹೇಳಿದೆ! ನೀನು ಹೇಳಿದ ಪ್ರಕಾರವೇ ನಾವು ಮಾಡಬೇಕು. <verse eid="EZR 10:12"/><verse number="13" style="v" sid="EZR 10:13"/>ಆದರೆ ಜನರು ಅನೇಕರು. ಇದು ಮಳೆಗಾಲವಾಗಿರುವುದರಿಂದ ಹೊರಗೆ ಇರಲಾರೆವು. ಇದಲ್ಲದೆ ಇದು ಒಂದೆರಡು ದಿನಗಳ ಕೆಲಸವಲ್ಲ. ಏಕೆಂದರೆ ಈ ಕಾರ್ಯದಲ್ಲಿ ನಮ್ಮ ಅಪರಾಧವು ದೊಡ್ಡದು. <verse eid="EZR 10:13"/><verse number="14" style="v" sid="EZR 10:14"/>ಆದಕಾರಣ ದಯಮಾಡಿ ಸಭೆಯ ಎಲ್ಲಾದರಲ್ಲಿ ನಮ್ಮ ಪ್ರಧಾನರು ನಿಲ್ಲಲಿ. ಈ ಕಾರ್ಯದ ನಿಮಿತ್ತ ನಮ್ಮ ದೇವರ ಕಠಿಣ ಕೋಪವು ನಮ್ಮನ್ನು ಬಿಟ್ಟು ಹೋಗುವವರೆಗೆ, ನಮ್ಮ ಪಟ್ಟಣಗಳಲ್ಲಿ ಯಹೂದ್ಯರಲ್ಲದ ಸ್ತ್ರೀಯರನ್ನು ತೆಗೆದುಕೊಂಡವರು, ನೇಮಿಸಿದ ಕಾಲದಲ್ಲಿ ಬಂದು, ಅವರ ಸಂಗಡ ಪ್ರತಿ ಪಟ್ಟಣದ ಹಿರಿಯರೂ, ಅದರ ನ್ಯಾಯಾಧಿಪತಿಗಳೂ ಇರಲಿ,” ಎಂದರು. <verse eid="EZR 10:14"/><verse number="15" style="v" sid="EZR 10:15"/>ಆದರೆ ಅಸಾಯೇಲನ ಮಗ ಯೋನಾತಾನ್ ಹಾಗು, ತಿಕ್ವನ ಮಗ ಯಹ್ಜೆಯ ಇದನ್ನು ವಿರೋಧಿಸಿದರು. ಮೆಷುಲ್ಲಾಮನೂ ಲೇವಿಯನಾದ ಶಬ್ಬೆತೈನೂ ಅವರನ್ನು ಬೆಂಬಲಿಸಿದರು.<verse eid="EZR 10:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="EZR 10:16"/>ಸೆರೆಯಿಂದ ಬಂದವರು ಇದೇ ಪ್ರಕಾರ ಮಾಡಿದರು. ಆದ್ದರಿಂದ ಯಾಜಕ ಎಜ್ರನು, ಕುಟುಂಬಗಳ ಮುಖ್ಯಸ್ಥರನ್ನಾಗಿ ಕುಟುಂಬಕ್ಕೆ ಒಬ್ಬೊಬ್ಬರನ್ನು ಆಯ್ದುಕೊಂಡನು. ಅವರನ್ನು ಹೆಸರು ಹಿಡಿದು ನೇಮಿಸಿದನು. ಈ ಕಾರ್ಯವನ್ನು ಶೋಧಿಸಲು ಹತ್ತನೆಯ ತಿಂಗಳ, ಮೊದಲನೆಯ ದಿವಸದಲ್ಲಿ ಕುಳಿತುಕೊಂಡರು. <verse eid="EZR 10:16"/><verse number="17" style="v" sid="EZR 10:17"/>ಅನ್ಯ ಸ್ತ್ರೀಯರನ್ನು ಹೊಂದಿದವರೆಲ್ಲರ ಕಾರ್ಯವನ್ನು ಮೊದಲನೆಯ ತಿಂಗಳ, ಮೊದಲನೆಯ ದಿವಸದಲ್ಲಿ ಮುಗಿಸಿದರು.<verse eid="EZR 10:17"/></para>
  <para style="s1">ಅಂತರ ವಿವಾಹದಿಂದ ಅಪರಾಧಿಗಳಾದವರು</para>
  <para style="li4">
    <verse number="18" style="v" sid="EZR 10:18"/>ಯಾಜಕರ ವಂಶಜರಲ್ಲಿ ಅನ್ಯ ಸ್ತ್ರೀಯರನ್ನು ಮದುವೆ ಮಾಡಿಕೊಂಡವರು ಯಾರೆಂದರೆ:</para>
  <para style="li1" vid="EZR 10:18">ಯೋಚಾದಾಕನ ಮಗ ಯೇಷೂವನು ಮತ್ತು ಅವನ ಸಹೋದರರಲ್ಲಿ:</para>
  <para style="li2" vid="EZR 10:18">ಮಾಸೇಯನು, ಎಲೀಯೆಜೆರನು, ಯಾರೀಬನು, ಗೆದಲ್ಯನು. <verse eid="EZR 10:18"/><verse number="19" style="v" sid="EZR 10:19"/>ಇವರು ತಮ್ಮ ಹೆಂಡತಿಯರನ್ನು ಹೊರಡಿಸಿಬಿಡುವೆವೆಂದು ಪ್ರತಿಜ್ಞೆ ಮಾಡಿ, ತಾವು ಅಪರಾಧಸ್ಥರಾದ್ದರಿಂದ ಅಪರಾಧ ಕಳೆಯುವುದಕ್ಕೆ ಮಂದೆಯಿಂದ ತಂದ ಒಂದು ಟಗರನ್ನು ಅರ್ಪಿಸಿದರು.<verse eid="EZR 10:19"/></para>
  <para style="li1">
    <verse number="20" style="v" sid="EZR 10:20"/>ಇಮ್ಮೇರನ ವಂಶಜರಲ್ಲಿ:</para>
  <para style="li2" vid="EZR 10:20">ಹನಾನೀ, ಜೆಬದ್ಯ.<verse eid="EZR 10:20"/></para>
  <para style="li1">
    <verse number="21" style="v" sid="EZR 10:21"/>ಹಾರಿಮನ ವಂಶಜರಲ್ಲಿ:</para>
  <para style="li2" vid="EZR 10:21">ಮಾಸೇಯ, ಎಲೀಯ, ಶೆಮಾಯ, ಯೆಹೀಯೇಲ್, ಉಜ್ಜೀಯ.<verse eid="EZR 10:21"/></para>
  <para style="li1">
    <verse number="22" style="v" sid="EZR 10:22"/>ಪಷ್ಹೂರನ ವಂಶಜರಲ್ಲಿ:</para>
  <para style="li2" vid="EZR 10:22">ಎಲ್ಯೋವೇನೈ, ಮಾಸೇಯ, ಇಷ್ಮಾಯೇಲ್, ನೆತನೆಯೇಲ್, ಯೋಜಾಬಾದ್ ಮತ್ತು ಎಲ್ಲಾಸ.<verse eid="EZR 10:22"/></para>
  <para style="b"/>
  <para style="li4">
    <verse number="23" style="v" sid="EZR 10:23"/>ಲೇವಿಯರಲ್ಲಿ</para>
  <para style="li2" vid="EZR 10:23">ಯೋಜಾಬಾದ್, ಶಿಮ್ಮೀ, ಕೆಲೀಟನೆಂಬ ಕೇಲಾಯ, ಪೆತಹ್ಯ, ಯೆಹೂದ, ಎಲೀಯೆಜೆರ್.<verse eid="EZR 10:23"/></para>
  <para style="li1">
    <verse number="24" style="v" sid="EZR 10:24"/>ಹಾಡುಗಾರರಲ್ಲಿ:</para>
  <para style="li2" vid="EZR 10:24">ಎಲ್ಯಾಷೀಬ್.</para>
  <para style="li1" vid="EZR 10:24">ದ್ವಾರಪಾಲಕರಲ್ಲಿ:</para>
  <para style="li2" vid="EZR 10:24">ಶಲ್ಲೂಮ್, ಟೆಲೆಮ್, ಊರಿ.<verse eid="EZR 10:24"/></para>
  <para style="b"/>
  <para style="li4">
    <verse number="25" style="v" sid="EZR 10:25"/>ಇಸ್ರಾಯೇಲರಲ್ಲಿ:</para>
  <para style="li1" vid="EZR 10:25">ಪರೋಷನ ವಂಶಜರಲ್ಲಿ:</para>
  <para style="li2" vid="EZR 10:25">ರಮ್ಯಾಹ, ಇಜ್ಜೀಯ, ಮಲ್ಕೀಯ, ಮಿಯಾಮಿನ್, ಎಲಿಯಾಜರ್, ಮಲ್ಕೀಯ, ಬೆನಾಯ.<verse eid="EZR 10:25"/></para>
  <para style="li1">
    <verse number="26" style="v" sid="EZR 10:26"/>ಏಲಾಮನ ವಂಶಜರಲ್ಲಿ:</para>
  <para style="li2" vid="EZR 10:26">ಮತ್ತನ್ಯ, ಜೆಕರ್ಯ, ಯೆಹೀಯೇಲ್, ಅಬ್ದೀ, ಯೆರೀಮೋತ್, ಎಲೀಯ.<verse eid="EZR 10:26"/></para>
  <para style="li1">
    <verse number="27" style="v" sid="EZR 10:27"/>ಜತ್ತೂ ವಂಶಜರಲ್ಲಿ:</para>
  <para style="li2" vid="EZR 10:27">ಎಲ್ಯೋವೇನೈ, ಎಲ್ಯಾಷೀಬ್, ಮತ್ತನ್ಯ, ಯೆರೀಮೋತ್, ಜಾಬಾದ್ ಮತ್ತು ಅಜೀಜಾ.<verse eid="EZR 10:27"/></para>
  <para style="li1">
    <verse number="28" style="v" sid="EZR 10:28"/>ಬೇಬೈನ ವಂಶಜರಲ್ಲಿ:</para>
  <para style="li2" vid="EZR 10:28">ಯೆಹೋಹಾನಾನ್, ಹನನ್ಯ, ಜಬ್ಬೈ, ಅತ್ಲೈ.<verse eid="EZR 10:28"/></para>
  <para style="li1">
    <verse number="29" style="v" sid="EZR 10:29"/>ಬಾನೀ ವಂಶಜರಲ್ಲಿ:</para>
  <para style="li2" vid="EZR 10:29">ಮೆಷುಲ್ಲಾಮ್, ಮಲ್ಲೂಕ್, ಅದಾಯ, ಯಾಷೂಬ್, ಶೆಯಾಲ್ ಮತ್ತು ರಾಮೋತ್.<verse eid="EZR 10:29"/></para>
  <para style="li1">
    <verse number="30" style="v" sid="EZR 10:30"/>ಪಹತ್ ಮೋವಾಬಿನ ವಂಶಜರಲ್ಲಿ:</para>
  <para style="li2" vid="EZR 10:30">ಅದ್ನ, ಕೆಲಾಲ್, ಬೆನಾಯ, ಮಾಸೇಯ, ಮತ್ತನ್ಯ, ಬೆಚಲಯೇಲ್, ಬಿನ್ನೂಯ್, ಮನಸ್ಸೆ.<verse eid="EZR 10:30"/></para>
  <para style="li1">
    <verse number="31" style="v" sid="EZR 10:31"/>ಹಾರಿಮನ ವಂಶಜರಲ್ಲಿ:</para>
  <para style="li2" vid="EZR 10:31">ಎಲೀಯೆಜೆರ್, ಇಷೀಯ, ಮಲ್ಕೀಯ, ಶೆಮಾಯ, ಸಿಮೆಯೋನ್, <verse eid="EZR 10:31"/><verse number="32" style="v" sid="EZR 10:32"/>ಬೆನ್ಯಾಮೀನ್, ಮಲ್ಲೂಕ್, ಶೆಮರ್ಯ.<verse eid="EZR 10:32"/></para>
  <para style="li1">
    <verse number="33" style="v" sid="EZR 10:33"/>ಹಾಷುಮ್ ವಂಶಜರಲ್ಲಿ:</para>
  <para style="li2" vid="EZR 10:33">ಮತ್ತೆನೈ, ಮತ್ತತ್ತ, ಜಾಬಾದ್, ಎಲೀಫೆಲೆಟ್, ಯೆರೇಮೈ, ಮನಸ್ಸೆ, ಶಿಮ್ಮೀ.<verse eid="EZR 10:33"/></para>
  <para style="li1">
    <verse number="34" style="v" sid="EZR 10:34"/>ಬಾನೀ ವಂಶಜರಲ್ಲಿ:</para>
  <para style="li2" vid="EZR 10:34">ಮಾದೈ, ಅಮ್ರಾಮ್, ಉಯೇಲ್, <verse eid="EZR 10:34"/><verse number="35" style="v" sid="EZR 10:35"/>ಬೆನಾಯ, ಬೇದೆಯ, ಕೆಲೂಹಿ. <verse eid="EZR 10:35"/><verse number="36" style="v" sid="EZR 10:36"/>ವನ್ಯಾಹ, ಮೆರೇಮೋತ್, ಎಲ್ಯಾಷೀಬ್, <verse eid="EZR 10:36"/><verse number="37" style="v" sid="EZR 10:37"/>ಮತ್ತನ್ಯ, ಮತ್ತೆನೈ, ಯಾಸೈ.<verse eid="EZR 10:37"/></para>
  <para style="li1">
    <verse number="38" style="v" sid="EZR 10:38"/>ಬಾನೀ, ಬಿನ್ನೂಯ್ ವಂಶಜರಲ್ಲಿ:</para>
  <para style="li2" vid="EZR 10:38">ಶಿಮ್ಮೀ, <verse eid="EZR 10:38"/><verse number="39" style="v" sid="EZR 10:39"/>ಶೆಲೆಮ್ಯ, ನಾತಾನ್, ಅದಾಯ, <verse eid="EZR 10:39"/><verse number="40" style="v" sid="EZR 10:40"/>ಮಕ್ನದೆಬೈ, ಶಾಷೈ, ಶಾರೈ, <verse eid="EZR 10:40"/><verse number="41" style="v" sid="EZR 10:41"/>ಅಜರಯೇಲ್, ಶೆಲೆಮ್ಯ, ಶೆಮರ್ಯ, <verse eid="EZR 10:41"/><verse number="42" style="v" sid="EZR 10:42"/>ಶಲ್ಲೂಮ್, ಅಮರ್ಯ, ಯೋಸೇಫ್.<verse eid="EZR 10:42"/></para>
  <para style="li1">
    <verse number="43" style="v" sid="EZR 10:43"/>ನೆಬೋ ವಂಶಜರಲ್ಲಿ:</para>
  <para style="li2" vid="EZR 10:43">ಯೆಹಿಯೇಲ್, ಮತ್ತಿತ್ಯ, ಜಾಬಾದ್, ಜೆಬೀನ, ಯದ್ದೈ, ಯೋಯೇಲ್ ಮತ್ತು ಬೆನಾಯ.<verse eid="EZR 10:43"/></para>
  <para style="b"/>
  <para style="li4">
    <verse number="44" style="v" sid="EZR 10:44"/>ಇವರೆಲ್ಲರು ಅನ್ಯ ಸ್ತ್ರೀಯರನ್ನು ಮದುವೆಯಾಗಿದ್ದರು. ಇವರಲ್ಲಿ ಕೆಲವರಿಗೆ ಈ ಹೆಂಡತಿಯರಿಂದ ಮಕ್ಕಳಾಗಿದ್ದರು.<verse eid="EZR 10:44"/></para>
  <chapter eid="EZR 10"/>
</usx>
