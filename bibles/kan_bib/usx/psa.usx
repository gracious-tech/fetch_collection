<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="PSA" style="id">- Biblica® Open Kannada Contemporary Version</book>
  <para style="h">ಕೀರ್ತನೆಗಳು</para>
  <para style="toc1">ಕೀರ್ತನೆಗಳು</para>
  <para style="toc2">ಕೀರ್ತನೆಗಳು</para>
  <para style="toc3">ಕೀರ್ತನೆ</para>
  <para style="mt1">ಕೀರ್ತನೆಗಳು</para>
  <chapter number="1" style="c" sid="PSA 1"/>
  <para style="ms">ಭಾಗ 1</para>
  <para style="mr">ಕೀರ್ತನೆಗಳು <ref loc="PSA 1-41">1–41</ref></para>
  <para style="cl">ಕೀರ್ತನೆ 1</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 1:1"/>ದುಷ್ಟರ ಆಲೋಚನೆಯಂತೆ ನಡೆಯದೆ,</para>
  <para style="q2" vid="PSA 1:1">ಪಾಪಿಗಳ ಮಾರ್ಗದಲ್ಲಿ ನಿಲ್ಲದೆ,</para>
  <para style="q2" vid="PSA 1:1">ಅಪಹಾಸ್ಯಗಾರರ ಕೂಟದಲ್ಲಿ ಕೂತುಕೊಳ್ಳದೆ,<verse eid="PSA 1:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 1:2"/>ಯೆಹೋವ ದೇವರ ನಿಯಮದಲ್ಲಿ ಆನಂದಿಸುತ್ತಾ,</para>
  <para style="q2" vid="PSA 1:2">ದೇವರ ನಿಯಮವನ್ನು ರಾತ್ರಿ ಹಗಲು ಧ್ಯಾನಿಸುತ್ತಾ ಬದುಕುವವರು ಧನ್ಯರು.<verse eid="PSA 1:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 1:3"/>ಅಂಥವರು ನೀರಿನ ಕಾಲುವೆಗಳ ಬಳಿಯಲ್ಲಿ ನೆಟ್ಟಿರುವ, ಮರದ ಹಾಗಿರುವರು.</para>
  <para style="q2" vid="PSA 1:3">ಅಂಥ ಮರವು ತಕ್ಕ ಕಾಲದಲ್ಲಿ ಫಲಕೊಡುತ್ತದೆ,</para>
  <para style="q1" vid="PSA 1:3">ಅದರ ಎಲೆ ಉದುರುವುದೇ ಇಲ್ಲ<note caller="+" style="f"><char style="fr" closed="false">1:3 </char><char style="fq" closed="false">ಎಲೆ ಉದುರುವುದೇ ಇಲ್ಲ </char><char style="ft" closed="false">ಪದದ ಅರ್ಥ </char><char style="fqa" closed="false">ಯಾವಾಗಲೂ ಆರೋಗ್ಯವಾಗಿರುವ</char></note>.</para>
  <para style="q2" vid="PSA 1:3">ಅದರಂತೆ ಅವರು ಮಾಡುವ ಕಾರ್ಯವೆಲ್ಲವೂ ಸಫಲವಾಗುವುದು.<verse eid="PSA 1:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 1:4"/>ಆದರೆ ದುಷ್ಟರು ಹಾಗಲ್ಲ!</para>
  <para style="q2" vid="PSA 1:4">ಅವರು ಗಾಳಿ ಬಡಿದುಕೊಂಡು ಹೋಗುವ</para>
  <para style="q2" vid="PSA 1:4">ಹೊಟ್ಟಿನ ಹಾಗೆಯೇ ಇದ್ದಾರೆ.<verse eid="PSA 1:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 1:5"/>ಆದ್ದರಿಂದ ದುಷ್ಟರು ನ್ಯಾಯತೀರ್ಪಿಗೆ ಒಳಗಾಗುವರು,</para>
  <para style="q2" vid="PSA 1:5">ಪಾಪಿಗಳಿಗೆ ನೀತಿವಂತರ ಸಭೆಯಲ್ಲಿ ಸ್ಥಳವಿರುವುದಿಲ್ಲ.<verse eid="PSA 1:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 1:6"/>ಯೆಹೋವ ದೇವರು ನೀತಿವಂತರ ಮಾರ್ಗವನ್ನು ಅರಿತಿದ್ದಾರೆ;</para>
  <para style="q2" vid="PSA 1:6">ಆದರೆ ದುಷ್ಟರ ಮಾರ್ಗವು ನಾಶಕ್ಕೆ ನಡೆಸುವುದು.<verse eid="PSA 1:6"/></para>
  <chapter eid="PSA 1"/>
  <chapter number="2" style="c" sid="PSA 2"/>
  <para style="cl">ಕೀರ್ತನೆ 2</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 2:1"/>ರಾಷ್ಟ್ರಗಳು ಒಳಸಂಚು ಮಾಡುವುದೂ</para>
  <para style="q2" vid="PSA 2:1">ಜನಾಂಗಗಳು ವ್ಯರ್ಥವಾಗಿ ಕುತಂತ್ರ ಮಾಡುವುದೂ ಏಕೆ?<verse eid="PSA 2:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 2:2"/>ಯೆಹೋವ ದೇವರಿಗೂ ಅವರ ಅಭಿಷಿಕ್ತನಿಗೂ ವಿರೋಧವಾಗಿ,</para>
  <para style="q2" vid="PSA 2:2">ಭೂಲೋಕದ ಅರಸರು ನಿಂತುಕೊಳ್ಳುತ್ತಾರೆ.</para>
  <para style="q2" vid="PSA 2:2">ಅಧಿಪತಿಗಳೂ ಒಂದಾಗಿ ಕೂಡಿಕೊಳ್ಳುತ್ತಿರುವರು.<verse eid="PSA 2:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 2:3"/>“ಅವರು ಹಾಕಿದ ಬೇಡಿಗಳನ್ನು ಮುರಿದು</para>
  <para style="q2" vid="PSA 2:3">ಬಂಧಗಳನ್ನು ಹರಿದು ಬೀಸಾಡೋಣ,” ಎನ್ನುತ್ತಾರೆ.<verse eid="PSA 2:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 2:4"/>ಪರಲೋಕದಲ್ಲಿ ಕೂತಿರುವ ದೇವರು ಅದಕ್ಕೆ ನಗುವರು,</para>
  <para style="q2" vid="PSA 2:4">ಕರ್ತದೇವರು ಅವರನ್ನು ಕಂಡು ಅಪಹಾಸ್ಯ ಮಾಡುವರು.<verse eid="PSA 2:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 2:5"/>ಕರ್ತದೇವರು ತಮ್ಮ ಕೋಪದಿಂದ ಅವರನ್ನು ಗದರಿಸುತ್ತಾ,</para>
  <para style="q2" vid="PSA 2:5">ತಮ್ಮ ಬೇಸರದಿಂದ ಅವರನ್ನು ಕಳವಳಪಡಿಸಿ ಹೀಗೆ ಹೇಳುವರು,<verse eid="PSA 2:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 2:6"/>“ನಾನು ನನ್ನ ಅರಸನನ್ನು ನನ್ನ ಪರಿಶುದ್ಧ ಪರ್ವತವಾದ</para>
  <para style="q2" vid="PSA 2:6">ಚೀಯೋನಿನ ಮೇಲೆ ಸ್ಥಾಪಿಸಿದ್ದೇನೆ.”<verse eid="PSA 2:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="PSA 2:7"/>ನಾನು ಯೆಹೋವ ದೇವರ ತೀರ್ಪನ್ನು ಹೀಗೆ ಪ್ರಕಟಿಸುವೆನು:</para>
  <para style="q1" vid="PSA 2:7">ಅವರು ನನಗೆ ಹೇಳಿದ್ದು, “ನೀನು ನನ್ನ ಪುತ್ರನು;</para>
  <para style="q2" vid="PSA 2:7">ಇಂದು ನಾನು ನಿನ್ನ ತಂದೆಯಾಗಿದ್ದೇನೆ.<verse eid="PSA 2:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 2:8"/>ನನ್ನನ್ನು ಕೇಳು,</para>
  <para style="q2" vid="PSA 2:8">ಆಗ ನಾನು ರಾಷ್ಟ್ರಗಳನ್ನು ನಿನ್ನ ವಾರಸಾಗಿಯೂ,</para>
  <para style="q2" vid="PSA 2:8">ಭೂಮಿಯ ಕಟ್ಟಕಡೆಯವರೆಗೂ ಇರುವ ದೇಶಗಳನ್ನೂ ನಿಮ್ಮ ಸೊತ್ತಾಗಿಯೂ ಕೊಡುವೆನು.<verse eid="PSA 2:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 2:9"/>ಕಬ್ಬಿಣದ ಗದೆಯಿಂದ ನೀನು ಅವರನ್ನು ದಂಡಿಸಿ,</para>
  <para style="q2" vid="PSA 2:9">ಮಣ್ಣಿನ ಮಡಕೆಯಂತೆ ಚೂರುಚೂರಾಗಿ ಅವರನ್ನು ಒಡೆದುಹಾಕುವೆ.”<verse eid="PSA 2:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 2:10"/>ಆದ್ದರಿಂದ, ರಾಜರುಗಳೇ, ಈಗ ಜ್ಞಾನವಂತರಾಗಿರಿ.</para>
  <para style="q2" vid="PSA 2:10">ಭೂಲೋಕದ ಅಧಿಕಾರಿಗಳೇ, ಎಚ್ಚರಿಕೆಯಿಂದಿರಿ.<verse eid="PSA 2:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 2:11"/>ಭಯಭಕ್ತಿಯಿಂದ ಯೆಹೋವ ದೇವರ ಸೇವೆಮಾಡಿರಿ,</para>
  <para style="q2" vid="PSA 2:11">ನಡುಗುತ್ತಾ ಅವರ ಆಳ್ವಿಕೆಯಲ್ಲಿ ಉಲ್ಲಾಸಪಡಿರಿ.<verse eid="PSA 2:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 2:12"/>ಯೆಹೋವ ದೇವರು ಬೇಸರಗೊಂಡು,</para>
  <para style="q2" vid="PSA 2:12">ನೀವು ನಿಮ್ಮ ಮಾರ್ಗದಲ್ಲಿ ನಾಶವಾಗದಂತೆ ಅವರ ಮಗನನ್ನು ಮುದ್ದಿಸಿರಿ.</para>
  <para style="q1" vid="PSA 2:12">ಏಕೆಂದರೆ ದೇವರ ರೋಷವು ಕ್ಷಣಮಾತ್ರದಲ್ಲಿ ಜ್ವಾಲಿಸುವುದು.</para>
  <para style="q2" vid="PSA 2:12">ದೇವರ ಆಶ್ರಯ ಪಡೆಯುವವರೆಲ್ಲಾ ಧನ್ಯರು.<verse eid="PSA 2:12"/></para>
  <chapter eid="PSA 2"/>
  <chapter number="3" style="c" sid="PSA 3"/>
  <para style="cl">ಕೀರ್ತನೆ 3</para>
  <para style="d">ದಾವೀದನ ಕೀರ್ತನೆ. ಅವನು ತನ್ನ ಮಗನಾದ ಅಬ್ಷಾಲೋಮನಿಂದ ಓಡಿಹೋದಾಗ ರಚಿಸಿದ್ದು.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 3:1"/>ಯೆಹೋವ ದೇವರೇ, ನನ್ನ ವೈರಿಗಳು ಬಹುಜನ!</para>
  <para style="q2" vid="PSA 3:1">ನನಗೆ ವಿರೋಧವಾಗಿ ಏಳುವವರು ಎಷ್ಟೋ ಜನ!<verse eid="PSA 3:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 3:2"/>“ದೇವರು ಅವನನ್ನು ಬಿಡುಗಡೆ ಮಾಡುವುದಿಲ್ಲ,” ಎಂದು</para>
  <para style="q2" vid="PSA 3:2">ಅನೇಕರು ನನ್ನ ಬಗ್ಗೆ ಹೇಳುತ್ತಾರೆ.<verse eid="PSA 3:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 3:3"/>ಆದರೆ ಯೆಹೋವ ದೇವರೇ, ನೀವೇ ನನ್ನ ಸುತ್ತಲಿರುವ ಗುರಾಣಿಯೂ,</para>
  <para style="q2" vid="PSA 3:3">ನನ್ನ ಮಹಿಮೆಯೂ ನನ್ನ ತಲೆ ಮೇಲೆತ್ತುವವರೂ<note caller="+" style="f"><char style="fr" closed="false">3:3 </char><char style="fq" closed="false">ತಲೆ ಮೇಲೆತ್ತುವವರೂ </char><char style="ft" closed="false">ಇದರ ಅರ್ಥ </char><char style="fqa" closed="false">ನೀವು ಜಯವನ್ನೂ ಮಹಾ ಘನತೆಯನ್ನೂ ಕೊಡುವವರಾಗಿದ್ದೀರಿ</char></note> ಆಗಿದ್ದೀರಿ.<verse eid="PSA 3:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 3:4"/>ನಾನು ನನ್ನ ಧ್ವನಿಯೆತ್ತಿ ಯೆಹೋವ ದೇವರಿಗೆ ಮೊರೆಯಿಡುವೆನು,</para>
  <para style="q2" vid="PSA 3:4">ಅವರು ತಮ್ಮ ಪರಿಶುದ್ಧ ಪರ್ವತದಿಂದ ನನಗೆ ಉತ್ತರಕೊಡುವರು.<verse eid="PSA 3:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 3:5"/>ನಾನು ಮಲಗಿ ನಿದ್ರಿಸುವೆನು;</para>
  <para style="q2" vid="PSA 3:5">ಯೆಹೋವ ದೇವರು ನನ್ನನ್ನು ಕಾಪಾಡಿದ್ದರಿಂದ ನಾನು ಎಚ್ಚರಗೊಂಡೆನು.<verse eid="PSA 3:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 3:6"/>ಸಾವಿರಾರು ಜನರು ನನಗೆ ವಿರೋಧವಾಗಿ</para>
  <para style="q2" vid="PSA 3:6">ನನ್ನ ಸುತ್ತುವರಿದರೂ ನಾನು ಭಯಪಡೆನು.<verse eid="PSA 3:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 3:7"/>ಯೆಹೋವ ದೇವರೇ, ಏಳಿರಿ!</para>
  <para style="q2" vid="PSA 3:7">ನನ್ನ ದೇವರೇ, ನನ್ನನ್ನು ರಕ್ಷಿಸಿರಿ.</para>
  <para style="q1" vid="PSA 3:7">ನನ್ನ ಶತ್ರುಗಳೆಲ್ಲರ ದವಡೆಗೆ ಹೊಡೆಯಿರಿ;</para>
  <para style="q2" vid="PSA 3:7">ದುಷ್ಟರ ಹಲ್ಲುಗಳನ್ನು ಮುರಿದುಬಿಡಿರಿ.<verse eid="PSA 3:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 3:8"/>ರಕ್ಷಣೆಯು ಯೆಹೋವ ದೇವರಿಂದಲೇ ಬರುವುದು.</para>
  <para style="q2" vid="PSA 3:8">ನಿಮ್ಮ ಜನರ ಮೇಲೆ ನಿಮ್ಮ ಆಶೀರ್ವಾದವಿರಲಿ.<verse eid="PSA 3:8"/></para>
  <chapter eid="PSA 3"/>
  <chapter number="4" style="c" sid="PSA 4"/>
  <para style="cl">ಕೀರ್ತನೆ 4</para>
  <para style="d">ಸಂಗೀತ ನಿರ್ದೇಶಕನಿಗಾಗಿರುವ ಕೀರ್ತನೆ. ತಂತಿವಾದ್ಯದೊಡನೆ ಹಾಡತಕ್ಕದ್ದು. ದಾವೀದನ ಕೀರ್ತನೆ.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 4:1"/>ನನ್ನ ನೀತಿಯಾಗಿರುವ ದೇವರೇ,</para>
  <para style="q2" vid="PSA 4:1">ನಾನು ಕರೆಯುವಾಗ ನನಗೆ ಸದುತ್ತರವನ್ನು ಕೊಡಿರಿ.</para>
  <para style="q1" vid="PSA 4:1">ನನ್ನ ಸಂಕಟದಿಂದ ನನಗೆ ನೆಮ್ಮದಿಯನ್ನು ನೀಡಿರಿ;</para>
  <para style="q2" vid="PSA 4:1">ನನ್ನನ್ನು ಕರುಣಿಸಿ, ನನ್ನ ಪ್ರಾರ್ಥನೆಯನ್ನು ಕೇಳಿರಿ.<verse eid="PSA 4:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 4:2"/>ಓ ಮಾನವ, ನೀನು ಎಲ್ಲಿಯತನಕ ನನ್ನ ಮಹಿಮೆಯನ್ನು ಅವಮಾನಕ್ಕೆ ಗುರಿಪಡಿಸುವಿ?</para>
  <para style="q2" vid="PSA 4:2">ನೀನು ಎಲ್ಲಿಯತನಕ ವ್ಯರ್ಥವಾದದ್ದನ್ನು ಪ್ರೀತಿಸಿ, ಸುಳ್ಳನ್ನು<note caller="+" style="f"><char style="fr" closed="false">4:2 </char><char style="ft" closed="false">ಅಥವಾ, </char><char style="fqa" closed="false">ಸುಳ್ಳು ದೇವರನ್ನು</char></note> ಹುಡುಕುವಿ?<verse eid="PSA 4:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 4:3"/>ಯೆಹೋವ ದೇವರು ತಮ್ಮ ನಂಬಿಗಸ್ತರನ್ನು</para>
  <para style="q2" vid="PSA 4:3">ತಮಗಾಗಿ ಪ್ರತ್ಯೇಕಿಸಿದ್ದಾರೆ ಎಂದು ತಿಳಿದುಕೊಳ್ಳಿರಿ;</para>
  <para style="q2" vid="PSA 4:3">ನಾನು ಬೇಡಿಕೊಳ್ಳಲು ಯೆಹೋವ ದೇವರು ನನಗೆ ಉತ್ತರ ನೀಡುವರು.<verse eid="PSA 4:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 4:4"/>ನಡುಗಿರಿ,<note caller="+" style="f"><char style="fr" closed="false">4:4 </char><char style="fq" closed="false">ನಡುಗಿರಿ </char><char style="ft" closed="false">ಹೀಬ್ರೂ ಭಾಷೆಯಲ್ಲಿ </char><char style="fqa" closed="false">ಕೋಪಗೊಂಡರೂ</char></note> ಪಾಪಮಾಡಬೇಡಿರಿ;</para>
  <para style="q2" vid="PSA 4:4">ನೀವು ನಿಮ್ಮ ಹಾಸಿಗೆಯ ಮೇಲೆ ಇರುವಾಗ,</para>
  <para style="q2" vid="PSA 4:4">ನಿಮ್ಮ ಹೃದಯಗಳಲ್ಲಿ ಧ್ಯಾನಮಾಡಿ ಮೌನವಾಗಿರಿ.<verse eid="PSA 4:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 4:5"/>ನೀತಿಯ ಬಲಿಗಳನ್ನು ಅರ್ಪಿಸಿರಿ</para>
  <para style="q2" vid="PSA 4:5">ಯೆಹೋವ ದೇವರಲ್ಲಿ ನಿಮ್ಮ ಭರವಸೆಯನ್ನು ಇಡಿರಿ.<verse eid="PSA 4:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 4:6"/>ಯೆಹೋವ ದೇವರೇ, “ನಮಗೆ ಒಳ್ಳೆಯದನ್ನು ಮಾಡುವವರು ಯಾರು?”</para>
  <para style="q2" vid="PSA 4:6">ಎಂದು ಕೇಳುವವರು ಅನೇಕರಿದ್ದಾರೆ.</para>
  <para style="q2" vid="PSA 4:6">ನಿಮ್ಮ ಮುಖಪ್ರಕಾಶವು ನಮ್ಮ ಮೇಲೆ ಬೆಳಗಲಿ.<verse eid="PSA 4:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 4:7"/>ಧಾನ್ಯವೂ ಹೊಸ ದ್ರಾಕ್ಷಾರಸವೂ ಸುಗ್ಗಿಕಾಲದಲ್ಲಿ</para>
  <para style="q2" vid="PSA 4:7">ಸಮೃದ್ಧಿಯಾದಾಗ ಇರುವುದಕ್ಕಿಂತಲೂ ಅಧಿಕವಾದ</para>
  <para style="q2" vid="PSA 4:7">ಆನಂದವನ್ನು ನೀವು ನನ್ನ ಹೃದಯದಲ್ಲಿ ಇಟ್ಟಿದ್ದೀರಿ.<verse eid="PSA 4:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 4:8"/>ಸಮಾಧಾನವಾಗಿ ಮಲಗಿ ನಿದ್ರೆ ಮಾಡುವೆನು,</para>
  <para style="q2" vid="PSA 4:8">ಏಕೆಂದರೆ ಯೆಹೋವ ದೇವರೇ,</para>
  <para style="q2" vid="PSA 4:8">ನೀವೊಬ್ಬರೇ ನನ್ನನ್ನು ಸುರಕ್ಷಿತವಾಗಿ ವಾಸಿಸುವಂತೆ ಮಾಡುತ್ತೀರಿ.<verse eid="PSA 4:8"/></para>
  <chapter eid="PSA 4"/>
  <chapter number="5" style="c" sid="PSA 5"/>
  <para style="cl">ಕೀರ್ತನೆ 5</para>
  <para style="d">ಸಂಗೀತ ನಿರ್ದೇಶಕನಿಗಾಗಿರುವ ಕೀರ್ತನೆ. ಕೊಳಲು ವಾದ್ಯದೊಡನೆ ಹಾಡತಕ್ಕದ್ದು, ದಾವೀದನ ಕೀರ್ತನೆ.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 5:1"/>ಯೆಹೋವ ದೇವರೇ, ನನ್ನ ಮಾತುಗಳಿಗೆ ಕಿವಿಗೊಡಿರಿ,</para>
  <para style="q2" vid="PSA 5:1">ನನ್ನ ಪ್ರಲಾಪವನ್ನು ಲಕ್ಷ್ಯಕ್ಕೆ ತಂದುಕೊಳ್ಳಿರಿ.<verse eid="PSA 5:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 5:2"/>ನನ್ನ ಅರಸರೇ, ನನ್ನ ದೇವರೇ,</para>
  <para style="q2" vid="PSA 5:2">ಸಹಾಯಕ್ಕಾಗಿರುವ ನನ್ನ ಮೊರೆಯನ್ನು ಕೇಳಿರಿ,</para>
  <para style="q2" vid="PSA 5:2">ನಿಮಗೇ ನಾನು ಪ್ರಾರ್ಥಿಸುತ್ತೇನೆ.<verse eid="PSA 5:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 5:3"/>ಯೆಹೋವ ದೇವರೇ, ಉದಯಕಾಲದಲ್ಲಿ ನನ್ನ ಸ್ವರವನ್ನು ಕೇಳಿರಿ;</para>
  <para style="q2" vid="PSA 5:3">ಮುಂಜಾನೆಯಲ್ಲಿ ನಾನು ನನ್ನ ಬೇಡಿಕೆಗಳನ್ನು ನಿಮ್ಮ ಮುಂದೆ ಸಮರ್ಪಿಸಿ,</para>
  <para style="q2" vid="PSA 5:3">ಎದುರುನೋಡುತ್ತಾ ಕಾದುಕೊಂಡಿರುವೆನು.<verse eid="PSA 5:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 5:4"/>ನೀವು ದುಷ್ಟತನವನ್ನು ಮೆಚ್ಚುವ ದೇವರಲ್ಲ;</para>
  <para style="q2" vid="PSA 5:4">ಕೆಡುಕರು ನಿಮ್ಮ ಬಳಿಯಲ್ಲಿ ವಾಸಿಸುವುದಿಲ್ಲ.<verse eid="PSA 5:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 5:5"/>ನಿಮ್ಮ ಸನ್ನಿಧಿಯಲ್ಲಿ</para>
  <para style="q2" vid="PSA 5:5">ಗರ್ವಿಗಳು ನಿಂತುಕೊಳ್ಳಲಾರರು.</para>
  <para style="q1" vid="PSA 5:5">ಅಧರ್ಮ ಮಾಡುವವರೆಲ್ಲರನ್ನು ನೀವು ದ್ವೇಷಿಸುತ್ತೀರಿ.<verse eid="PSA 5:5"/></para>
  <para style="q2">
    <verse number="6" style="v" sid="PSA 5:6"/>ಸುಳ್ಳಾಡುವವರನ್ನು ನೀವು ದಂಡಿಸುತ್ತೀರಿ.</para>
  <para style="q1" vid="PSA 5:6">ಕೊಲೆಗಾರರನ್ನೂ ಮೋಸಗಾರರನ್ನೂ</para>
  <para style="q2" vid="PSA 5:6">ಯೆಹೋವ ದೇವರು ಅಸಹ್ಯಪಡುತ್ತಾರೆ.<verse eid="PSA 5:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 5:7"/>ನಾನಾದರೋ, ನಿಮ್ಮ ಒಡಂಬಡಿಕೆಯ ಪ್ರೀತಿಯಿಂದ</para>
  <para style="q2" vid="PSA 5:7">ನಿಮ್ಮ ಮನೆಗೆ ಬರುವೆನು;</para>
  <para style="q1" vid="PSA 5:7">ಭಕ್ತಿಭಾವದಿಂದ ನಿಮ್ಮ ಪರಿಶುದ್ಧ</para>
  <para style="q2" vid="PSA 5:7">ಆಲಯದ ಕಡೆಗೆ ತಲೆಬಾಗುವೆನು.<verse eid="PSA 5:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 5:8"/>ಯೆಹೋವ ದೇವರೇ, ನನ್ನ ವಿರೋಧಿಗಳ ನಿಮಿತ್ತ</para>
  <para style="q2" vid="PSA 5:8">ನಿಮ್ಮ ನೀತಿಯಲ್ಲಿ ನನ್ನನ್ನು ನಡೆಸಿರಿ;</para>
  <para style="q2" vid="PSA 5:8">ನಿಮ್ಮ ಮಾರ್ಗವನ್ನು ನನ್ನ ಮುಂದೆ ನೇರವಾಗಿ ಮಾಡಿರಿ.<verse eid="PSA 5:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 5:9"/>ಅವರ ಬಾಯಿಯಲ್ಲಿ ಯಥಾರ್ಥ ಮಾತು ಒಂದೂ ಇಲ್ಲ;</para>
  <para style="q2" vid="PSA 5:9">ಅವರ ಹೃದಯವು ನಾಶನದಿಂದ ತುಂಬಿದೆ.</para>
  <para style="q1" vid="PSA 5:9">ಅವರ ಗಂಟಲು ತೆರೆದ ಸಮಾಧಿಯೇ;</para>
  <para style="q2" vid="PSA 5:9">ತಮ್ಮ ನಾಲಿಗೆಯಿಂದ ಮುಖಸ್ತುತಿ ಮಾಡುತ್ತಾರೆ.<verse eid="PSA 5:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 5:10"/>ಓ ದೇವರೇ! ಅವರನ್ನು ಅಪರಾಧಿಗಳೆಂದು ನಿರ್ಣಯಿಸಿರಿ,</para>
  <para style="q2" vid="PSA 5:10">ಅವರು ತಮ್ಮ ಸ್ವಂತ ಕುತಂತ್ರಗಳಿಂದ ಬಿದ್ದುಹೋಗಲಿ.</para>
  <para style="q1" vid="PSA 5:10">ಅವರ ಬಹು ಪಾಪಗಳ ನಿಮಿತ್ತ ಅವರನ್ನು ಬಹಿಷ್ಕರಿಸಿರಿ,</para>
  <para style="q2" vid="PSA 5:10">ಏಕೆಂದರೆ ಅವರು ನಿಮಗೆ ವಿರೋಧವಾಗಿ ತಿರುಗಿಬಿದ್ದಿದ್ದಾರೆ.<verse eid="PSA 5:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 5:11"/>ಆದರೆ ನಿಮ್ಮನ್ನು ಆಶ್ರಯಿಸುವವರೆಲ್ಲರು ಆನಂದಿಸಲಿ;</para>
  <para style="q2" vid="PSA 5:11">ಅವರು ಸದಾ ನಿಮ್ಮ ಆನಂದ ಗಾನವನ್ನು ಹಾಡಲಿ.</para>
  <para style="q1" vid="PSA 5:11">ನಿಮ್ಮ ಹೆಸರನ್ನು ಪ್ರೀತಿಸುವವರು ನಿಮ್ಮಲ್ಲಿ ಆನಂದಿಸುವಂತೆ</para>
  <para style="q2" vid="PSA 5:11">ಅವರನ್ನು ನಿಮ್ಮ ಸಂರಕ್ಷಣೆಯಿಂದ ಆವರಿಸಿಕೊಳ್ಳಿರಿ.<verse eid="PSA 5:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 5:12"/>ಯೆಹೋವ ದೇವರೇ, ನೀವು ನೀತಿವಂತರನ್ನು ನಿಶ್ಚಯವಾಗಿ ಆಶೀರ್ವದಿಸಿದ್ದೀರಿ;</para>
  <para style="q2" vid="PSA 5:12">ನೀವು ಅವರನ್ನು ನಿಮ್ಮ ಮೆಚ್ಚುಗೆಯಿಂದ ಗುರಾಣಿಯಂತೆಯೇ ಆವರಿಸಿಕೊಳ್ಳಿರಿ.<verse eid="PSA 5:12"/></para>
  <chapter eid="PSA 5"/>
  <chapter number="6" style="c" sid="PSA 6"/>
  <para style="cl">ಕೀರ್ತನೆ 6</para>
  <para style="d">ಸಂಗೀತ ನಿರ್ದೇಶಕನಿಗಾಗಿರುವ ಕೀರ್ತನೆ. ತಂತಿವಾದ್ಯದೊಡನೆ <char style="tl">ಶೆಮಿನಿಥ್</char> ಸ್ವರದೊಂದಿಗೆ ಹಾಡತಕ್ಕದ್ದು. ದಾವೀದನ ಕೀರ್ತನೆ.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 6:1"/>ಯೆಹೋವ ದೇವರೇ, ನೀವು ಬೇಸರದಿಂದ ನನ್ನನ್ನು ಗದರಿಸಬೇಡಿರಿ,</para>
  <para style="q2" vid="PSA 6:1">ರೋಷದಿಂದಲೂ ನನ್ನನ್ನು ದಂಡಿಸಬೇಡಿರಿ.<verse eid="PSA 6:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 6:2"/>ಯೆಹೋವ ದೇವರೇ, ನನ್ನನ್ನು ಕರುಣಿಸಿರಿ, ನಾನು ಬಲಹೀನನಾಗಿದ್ದೇನೆ;</para>
  <para style="q2" vid="PSA 6:2">ಯೆಹೋವ ದೇವರೇ, ನನ್ನನ್ನು ಸ್ವಸ್ಥಮಾಡಿರಿ, ನನ್ನ ಎಲುಬುಗಳು ಬಹು ವ್ಯಥೆಗೊಳಗಾಗಿವೆ.<verse eid="PSA 6:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 6:3"/>ನನ್ನ ಪ್ರಾಣವು ಬಹು ಸಂಕಟದಲ್ಲಿದೆ.</para>
  <para style="q2" vid="PSA 6:3">ಎಲ್ಲಿಯತನಕ, ಯೆಹೋವ ದೇವರೇ, ಇನ್ನೂ ಎಲ್ಲಿಯತನಕ?<verse eid="PSA 6:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 6:4"/>ಯೆಹೋವ ದೇವರೇ, ನನ್ನ ಕಡೆಗೆ ಹಿಂದಿರುಗಿರಿ, ನನ್ನನ್ನು ಬಿಡುಗಡೆ ಮಾಡಿರಿ;</para>
  <para style="q2" vid="PSA 6:4">ನಿಮ್ಮ ಒಡಂಬಡಿಕೆಯ ಪ್ರೀತಿಯ ನಿಮಿತ್ತ ನನ್ನನ್ನು ರಕ್ಷಿಸಿರಿ.<verse eid="PSA 6:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 6:5"/>ಸತ್ತವರಲ್ಲಿ ನಿಮ್ಮನ್ನು ಸ್ಮರಿಸುವವರಿಲ್ಲ.</para>
  <para style="q2" vid="PSA 6:5">ಪಾತಾಳದಲ್ಲಿ ನಿಮ್ಮನ್ನು ಸ್ತುತಿಸುವವರು ಯಾರು?<verse eid="PSA 6:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 6:6"/>ನನ್ನ ನರಳಾಟದಿಂದ ದಣಿದು ಹೋಗಿದ್ದೇನೆ.</para>
  <para style="b" vid="PSA 6:6"/>
  <para style="q1" vid="PSA 6:6">ರಾತ್ರಿಯೆಲ್ಲಾ ನಾನು ಅಳುವುದರಿಂದ ನನ್ನ ಹಾಸಿಗೆಯು</para>
  <para style="q2" vid="PSA 6:6">ಕಣ್ಣೀರಿನ ಪ್ರವಾಹದಿಂದ ತೇಲಾಡುತ್ತದೆ,</para>
  <para style="q2" vid="PSA 6:6">ಕಣ್ಣೀರಿನಿಂದ ನನ್ನ ಮಂಚವನ್ನು ತೊಯಿಸಿದ್ದೇನೆ.<verse eid="PSA 6:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 6:7"/>ದುಃಖದಿಂದ ನನ್ನ ಕಣ್ಣುಗಳು ಬಲಹೀನವಾಗಿವೆ,</para>
  <para style="q2" vid="PSA 6:7">ನನ್ನ ಸಕಲ ವೈರಿಗಳಿಂದ ಅವು ಮೊಬ್ಬಾಗಿವೆ.<verse eid="PSA 6:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 6:8"/>ಕೆಟ್ಟದ್ದನ್ನು ಮಾಡುವವರೇ, ನೀವೆಲ್ಲರು ನನ್ನಿಂದ ತೊಲಗಿಹೋಗಿರಿ,</para>
  <para style="q2" vid="PSA 6:8">ಏಕೆಂದರೆ ಯೆಹೋವ ದೇವರು ನನ್ನ ಗೋಳಾಟವನ್ನು ಕೇಳಿದ್ದಾರೆ.<verse eid="PSA 6:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 6:9"/>ಯೆಹೋವ ದೇವರು ನಾನು ಕರುಣೆಗಾಗಿ ಕೇಳಿದ ನನ್ನ ಮೊರೆಯನ್ನು ಆಲಿಸಿದ್ದಾರೆ;</para>
  <para style="q2" vid="PSA 6:9">ಯೆಹೋವ ದೇವರು ನನ್ನ ಪ್ರಾರ್ಥನೆಯನ್ನು ಸ್ವೀಕರಿಸುವರು.<verse eid="PSA 6:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 6:10"/>ನನ್ನ ಶತ್ರುಗಳೆಲ್ಲರೂ ನಾಚಿಕೆಪಟ್ಟು ತತ್ತರಿಸುವರು;</para>
  <para style="q2" vid="PSA 6:10">ಕ್ಷಣಮಾತ್ರದಲ್ಲಿ ಅವರು ಅವಮಾನಗೊಂಡು ಹಿಂದಿರುಗಿ ಹೋಗುವರು.<verse eid="PSA 6:10"/></para>
  <chapter eid="PSA 6"/>
  <chapter number="7" style="c" sid="PSA 7"/>
  <para style="cl">ಕೀರ್ತನೆ 7</para>
  <para style="d">ಬೆನ್ಯಾಮೀನವನಾದ ಕೂಷನ ಮಾತುಗಳ ನಿಮಿತ್ತ ದಾವೀದನು ಯೆಹೋವ ದೇವರಿಗೆ ಹಾಡಿದ <char style="tl">ಶಿಗ್ಗಯೋನ್ ಗೀತೆ.</char></para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 7:1"/>ನನ್ನ ಯೆಹೋವ ದೇವರೇ, ನಿಮ್ಮನ್ನೇ ಆಶ್ರಯಿಸಿದ್ದೇನೆ;</para>
  <para style="q2" vid="PSA 7:1">ನನ್ನನ್ನು ಬೆನ್ನಟ್ಟಿದ ಎಲ್ಲರಿಂದಲೂ ನನ್ನನ್ನು ರಕ್ಷಿಸಿ ಕಾಪಾಡಿರಿ,<verse eid="PSA 7:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 7:2"/>ಇಲ್ಲದಿದ್ದರೆ, ನನ್ನನ್ನು ಸಿಂಹದಂತೆ ಅವರು ಹರಿದುಬಿಡುವರು</para>
  <para style="q2" vid="PSA 7:2">ರಕ್ಷಿಸಲು ಯಾರೂ ಇಲ್ಲವೆಂದು ನನ್ನನ್ನು ನಾಶಮಾಡಿಬಿಡುವರು.<verse eid="PSA 7:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 7:3"/>ನನ್ನ ಯೆಹೋವ ದೇವರೇ, ನಾನು ಅನ್ಯಾಯ ಮಾಡಿದ್ದರೆ,</para>
  <para style="q2" vid="PSA 7:3">ನನ್ನ ಕೈಗಳಲ್ಲಿ ಅಪರಾಧವಿದ್ದರೆ,<verse eid="PSA 7:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 7:4"/>ನನ್ನೊಂದಿಗೆ ಸಮಾಧಾನದಿಂದ ಇದ್ದವನಿಗೆ ನಾನು ಕೇಡುಮಾಡಿದ್ದರೆ,</para>
  <para style="q2" vid="PSA 7:4">ಕಾರಣವಿಲ್ಲದೆ ನನ್ನ ವೈರಿಯಿಂದ ಏನನ್ನಾದರೂ ಸುಲಿದುಕೊಂಡಿದ್ದರೆ,<verse eid="PSA 7:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 7:5"/>ಆಗ ನನ್ನ ವೈರಿಯು ಬೆನ್ನಟ್ಟಿ ನನ್ನನ್ನು ಹಿಡಿದುಕೊಳ್ಳಲಿ.</para>
  <para style="q2" vid="PSA 7:5">ನನ್ನ ಜೀವವನ್ನು ನೆಲಕ್ಕೆ ಹಾಕಿ ತುಳಿದು ಬಿಡಲಿ</para>
  <para style="q2" vid="PSA 7:5">ಮತ್ತು ನನ್ನ ಮಾನವನ್ನು ಮಣ್ಣು ಪಾಲಾಗುವಂತೆ ಮಾಡಲಿ.<verse eid="PSA 7:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 7:6"/>ಯೆಹೋವ ದೇವರೇ, ನೀವು ಕೋಪದಿಂದ ಎದ್ದೇಳಿರಿ;</para>
  <para style="q2" vid="PSA 7:6">ನನ್ನ ವೈರಿಗಳ ಕ್ರೋಧಕ್ಕೆ ವಿರೋಧವಾಗಿ ಎಚ್ಚರಗೊಳ್ಳಿರಿ.</para>
  <para style="q2" vid="PSA 7:6">ನನ್ನ ದೇವರೇ, ನ್ಯಾಯಕ್ಕೆ ನಿಮ್ಮ ತೀರ್ಪನ್ನು ನೀಡಲು ಎದ್ದೇಳಿರಿ.<verse eid="PSA 7:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 7:7"/>ರಾಷ್ಟ್ರಗಳು ನಿಮ್ಮ ಸುತ್ತಲು ಬಂದು ಸೇರಲಿ,</para>
  <para style="q2" vid="PSA 7:7">ಉನ್ನತದಿಂದ ನೀವು ಅವರ ಮೇಲೆ ಸಿಂಹಾಸನದಲ್ಲಿದ್ದು ಆಳಿರಿ.<verse eid="PSA 7:7"/></para>
  <para style="q2">
    <verse number="8" style="v" sid="PSA 7:8"/>ಯೆಹೋವ ದೇವರು ಜನಗಳಿಗೆ ನ್ಯಾಯತೀರಿಸಲಿ.</para>
  <para style="q1" vid="PSA 7:8">ಮಹೋನ್ನತರಾದ ಯೆಹೋವ ದೇವರೇ, ನನ್ನ ನೀತಿಯ ಪ್ರಕಾರವೂ,</para>
  <para style="q2" vid="PSA 7:8">ಯಥಾರ್ಥತೆಯ ಪ್ರಕಾರವೂ ನನಗೆ ನ್ಯಾಯತೀರಿಸಿರಿ.<verse eid="PSA 7:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 7:9"/>ದುಷ್ಟರ ಕೆಟ್ಟತನವು ಅಂತ್ಯವಾಗುವಂತೆಯೂ</para>
  <para style="q2" vid="PSA 7:9">ನೀತಿವಂತರ ಭದ್ರತೆಯು ನಿಶ್ಚಯವಾಗುವಂತೆಯೂ ಮಾಡಿರಿ.</para>
  <para style="q1" vid="PSA 7:9">ನೀತಿಯುಳ್ಳ ದೇವರೇ,</para>
  <para style="q2" vid="PSA 7:9">ನೀವು ಹೃದಯವನ್ನೂ ಮನಸ್ಸನ್ನೂ ಪರಿಶೋಧಿಸುವವರಾಗಿದ್ದೀರಿ.<verse eid="PSA 7:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 7:10"/>ಮಹೋನ್ನತರಾದ ದೇವರು ನನ್ನ ಗುರಾಣಿಯಾಗಿದ್ದಾರೆ,<note caller="+" style="f"><char style="fr" closed="false">7:10 </char><char style="fq" closed="false">ಗುರಾಣಿಯಾಗಿದ್ದಾರೆ </char><char style="ft" closed="false">ಅಥವಾ </char><char style="fqa" closed="false">ಪ್ರಭುವಾಗಿದ್ದಾರೆ</char></note></para>
  <para style="q2" vid="PSA 7:10">ಅವರು ಯಥಾರ್ಥ ಹೃದಯವುಳ್ಳವರನ್ನು ರಕ್ಷಿಸುತ್ತಾರೆ.<verse eid="PSA 7:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 7:11"/>ದೇವರು ನೀತಿಯುಳ್ಳ ನ್ಯಾಯಾಧಿಪತಿಯಾಗಿದ್ದಾರೆ.</para>
  <para style="q2" vid="PSA 7:11">ದೇವರು ದುಷ್ಟನ ಮೇಲೆ ಸದಾ ರೋಷವುಳ್ಳವರಾಗಿದ್ದಾರೆ.<verse eid="PSA 7:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 7:12"/>ಅಂಥವರು ತಿರುಗಿಕೊಳ್ಳದಿದ್ದರೆ</para>
  <para style="q2" vid="PSA 7:12">ದೇವರು ತಮ್ಮ ಖಡ್ಗ ಮಸೆಯುವರು;</para>
  <para style="q2" vid="PSA 7:12">ತಮ್ಮ ಬಿಲ್ಲು ಬಗ್ಗಿಸಿ ಅದನ್ನು ಸಿದ್ಧಮಾಡುವರು.<verse eid="PSA 7:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 7:13"/>ಅಂಥವರಿಗೆ ಮರಣಾಯುಧಗಳನ್ನು ಸಹ ಸಿದ್ಧಮಾಡಿದ್ದಾರೆ;</para>
  <para style="q2" vid="PSA 7:13">ತಮ್ಮ ಅಗ್ನಿಬಾಣಗಳನ್ನು ಸಿದ್ಧಮಾಡುತ್ತಾರೆ.<verse eid="PSA 7:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 7:14"/>ಅಂಥವರು ದುಷ್ಟತನವನ್ನು ಗರ್ಭಧರಿಸಿ,</para>
  <para style="q2" vid="PSA 7:14">ಸೇಡನ್ನು ಗರ್ಭದಲ್ಲಿಟ್ಟುಕೊಂಡು ಸುಳ್ಳನ್ನು ಹೆರುವರು.<verse eid="PSA 7:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 7:15"/>ಅಂಥವರು ಕುಣಿಯನ್ನು ಅಗೆದಿದ್ದಾರೆ.</para>
  <para style="q2" vid="PSA 7:15">ಆದರೆ ತಾವು ಅಗೆದ ಕುಣಿಯೊಳಗೆ ತಾವೇ ಬೀಳುವರು.<verse eid="PSA 7:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 7:16"/>ಅಂಥವರ ಕೇಡು ಅವರ ಮೇಲೆಯೇ ತಿರುಗುವುದು;</para>
  <para style="q2" vid="PSA 7:16">ಅವರ ತಲೆಯ ಮೇಲೆ ಅವರ ಬಲಾತ್ಕಾರವೇ ಇಳಿಯುವುದು.<verse eid="PSA 7:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 7:17"/>ನಾನು ಯೆಹೋವ ದೇವರನ್ನು ಕೊಂಡಾಡುವೆನು; ಏಕೆಂದರೆ, ಅವರು ನೀತಿಯುಳ್ಳವರು.</para>
  <para style="q2" vid="PSA 7:17">ಮಹೋನ್ನತರಾದ ಯೆಹೋವ ದೇವರ ಹೆಸರನ್ನು ಕೀರ್ತನೆ ಮಾಡುವೆನು.<verse eid="PSA 7:17"/></para>
  <chapter eid="PSA 7"/>
  <chapter number="8" style="c" sid="PSA 8"/>
  <para style="cl">ಕೀರ್ತನೆ 8</para>
  <para style="d">ಸಂಗೀತ ನಿರ್ದೇಶಕನಿಗಾಗಿರುವ ಕೀರ್ತನೆ. <char style="tl">ಗಿತ್ತೀ</char> ರಾಗದಲ್ಲಿ ಹಾಡತಕ್ಕದ್ದು. ದಾವೀದನ ಕೀರ್ತನೆ.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 8:1"/>ನಮ್ಮ ಕರ್ತ ಆಗಿರುವ ಯೆಹೋವ ದೇವರೇ,</para>
  <para style="q2" vid="PSA 8:1">ನಿಮ್ಮ ಹೆಸರು ಭೂಮಿಯಲ್ಲೆಲ್ಲಾ ಎಷ್ಟೋ ವೈಭವವುಳ್ಳದ್ದಾಗಿದೆ!</para>
  <para style="b" vid="PSA 8:1"/>
  <para style="q1" vid="PSA 8:1">ನೀವು ನಿಮ್ಮ ಮಹಿಮೆಯನ್ನು</para>
  <para style="q2" vid="PSA 8:1">ಆಕಾಶಗಳಲ್ಲಿ ಸ್ಥಾಪಿಸಿದ್ದೀರಿ.<verse eid="PSA 8:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 8:2"/>ಸಣ್ಣ ಮಕ್ಕಳ ಮತ್ತು ಹಾಲುಣ್ಣುವ ಕೂಸುಗಳ ಸ್ತೋತ್ರದ ಮೂಲಕ</para>
  <para style="q2" vid="PSA 8:2">ನಿಮ್ಮ ಶತ್ರುಗಳ ವಿರೋಧವಾಗಿ ಭದ್ರಕೋಟೆಯನ್ನು ಸ್ಥಾಪಿಸಿ,</para>
  <para style="q2" vid="PSA 8:2">ನಿಮ್ಮ ವೈರಿಗಳನ್ನೂ ಮುಯ್ಯಿ ತೀರಿಸುವವರನ್ನೂ ನೀವು ಸುಮ್ಮಗಿರಿಸಿದ್ದೀರಿ.<verse eid="PSA 8:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 8:3"/>ನಿಮ್ಮ ಬೆರಳಿನ ಸೃಷ್ಟಿಯಾದ ಆಕಾಶಮಂಡಲವನ್ನೂ</para>
  <para style="q2" vid="PSA 8:3">ನೀವು ಉಂಟುಮಾಡಿದ ಚಂದ್ರನಕ್ಷತ್ರಗಳನ್ನೂ</para>
  <para style="q2" vid="PSA 8:3">ನಾನು ನೋಡಿದಾಗ,<verse eid="PSA 8:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 8:4"/>ನೀವು ಮಾನವರನ್ನು ನೆನಸಲು ಅವರು ಎಷ್ಟರವರು?</para>
  <para style="q2" vid="PSA 8:4">ಮನುಷ್ಯಪುತ್ರನನ್ನು ಲಕ್ಷ್ಯವಿಡಲು ಅವನು ಯಾರು?<verse eid="PSA 8:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 8:5"/>ನೀವು ಮನುಷ್ಯಪುತ್ರನನ್ನು ದೇವರಿಗಿಂತಲೂ<note caller="+" style="f"><char style="fr" closed="false">8:5 </char><char style="fq" closed="false">ದೇವರಿಗಿಂತಲೂ </char><char style="ft" closed="false">ಅಥವಾ </char><char style="fqa" closed="false">ದೇವದೂತರಿಗಿಂತಲೂ</char></note> ಸ್ವಲ್ಪ ಕಡಿಮೆ ಮಾಡಿ,</para>
  <para style="q2" vid="PSA 8:5">ಮಹಿಮೆಯನ್ನೂ ಮಾನವನ್ನೂ ಅವನಿಗೆ ಕಿರೀಟವಾಗಿಟ್ಟಿದ್ದೀರಿ.<verse eid="PSA 8:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 8:6"/>ನೀವು ನಿಮ್ಮ ಕೈಕೃತಿಗಳ ಮೇಲೆ ಅವನನ್ನು ಅಧಿಕಾರಿಯನ್ನಾಗಿ ಮಾಡಿ,</para>
  <para style="q2" vid="PSA 8:6">ಸಮಸ್ತವನ್ನೂ ಅವನ ಪಾದಗಳ ಕೆಳಗೆ ಹಾಕಿದ್ದೀರಿ:<verse eid="PSA 8:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 8:7"/>ಎಲ್ಲಾ ಕುರಿದನಗಳನ್ನೂ</para>
  <para style="q2" vid="PSA 8:7">ಅಡವಿಯ ಮೃಗಗಳನ್ನೂ<verse eid="PSA 8:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 8:8"/>ಆಕಾಶದ ಪಕ್ಷಿಗಳನ್ನೂ</para>
  <para style="q2" vid="PSA 8:8">ಸಮುದ್ರದ ಮೀನುಗಳನ್ನೂ ಸಮುದ್ರದ ಹಾದಿಗಳಲ್ಲಿ ಸಂಚರಿಸುವ ಎಲ್ಲ ವಿಧವಾದ ಜೀವಜಂತುಗಳನ್ನೂ</para>
  <para style="q2" vid="PSA 8:8">ಅವನ ಪಾದಗಳ ಕೆಳಗೆ ಹಾಕಿದ್ದೀರಿ.<verse eid="PSA 8:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 8:9"/>ನಮ್ಮ ಕರ್ತ ಆಗಿರುವ ಯೆಹೋವ ದೇವರೇ,</para>
  <para style="q2" vid="PSA 8:9">ನಿಮ್ಮ ಹೆಸರು ಭೂಮಿಯಲ್ಲೆಲ್ಲಾ ಎಷ್ಟೋ ಮಹಿಮೆಯುಳ್ಳದ್ದಾಗಿದೆ!<verse eid="PSA 8:9"/></para>
  <chapter eid="PSA 8"/>
  <chapter number="9" style="c" sid="PSA 9"/>
  <para style="cl">ಕೀರ್ತನೆ 9<note caller="+" style="f"><char style="fr" closed="false">9:0 </char><char style="ft" closed="false">9 ಮತ್ತು 10 ನೇ ಕೀರ್ತನೆಗಳು ಮೂಲತಃ ಒಂದೇ ಕವಿತೆಯಾಗಿರಬಹುದು. ಇದರಲ್ಲಿ ಹೀಬ್ರೂ ವರ್ಣಮಾಲೆಯ ಅನುಕ್ರಮ ಅಕ್ಷರಗಳೊಂದಿಗೆ ಪರ್ಯಾಯ ರೇಖೆಗಳು ಪ್ರಾರಂಭವಾದವು.</char></note></para>
  <para style="d">ಸಂಗೀತ ನಿರ್ದೇಶಕನಿಗಾಗಿರುವ ಕೀರ್ತನೆ. “ಪುತ್ರನ ಮರಣದ” ರಾಗ. ದಾವೀದನ ಕೀರ್ತನೆ.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 9:1"/>ಯೆಹೋವ ದೇವರೇ, ನನ್ನ ಪೂರ್ಣಹೃದಯದಿಂದ ನಾನು ನಿಮ್ಮನ್ನು ಸ್ತುತಿಸುವೆನು;</para>
  <para style="q2" vid="PSA 9:1">ನಿಮ್ಮ ಅದ್ಭುತ ಕಾರ್ಯಗಳನ್ನೆಲ್ಲಾ ನಾನು ವರ್ಣಿಸುವೆನು.<verse eid="PSA 9:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 9:2"/>ನಾನು ನಿಮ್ಮಲ್ಲಿ ಆನಂದಿಸಿ ಉಲ್ಲಾಸಪಡುವೆನು;</para>
  <para style="q2" vid="PSA 9:2">ಮಹೋನ್ನತರೇ, ನಾನು ನಿಮ್ಮ ಹೆಸರನ್ನು ಕೊಂಡಾಡಿ ಹಾಡುವೆನು.<verse eid="PSA 9:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 9:3"/>ನನ್ನ ಶತ್ರುಗಳು ಹಿಂದಿರುಗಿ ಓಡುವರು;</para>
  <para style="q2" vid="PSA 9:3">ಅವರು ನಿಮ್ಮ ಮುಂದೆ ಎಡವಿಬಿದ್ದು ನಾಶವಾಗುವರು.<verse eid="PSA 9:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 9:4"/>ನೀವು ನನ್ನ ನ್ಯಾಯವನ್ನೂ ವ್ಯಾಜ್ಯವನ್ನೂ ತೀರಿಸಲು</para>
  <para style="q2" vid="PSA 9:4">ನೀತಿಯುಳ್ಳ ನ್ಯಾಯಾಧಿಪತಿಯಾಗಿ ಸಿಂಹಾಸನದಲ್ಲಿ ಕುಳಿತುಕೊಂಡಿದ್ದೀರಿ.<verse eid="PSA 9:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 9:5"/>ರಾಷ್ಟ್ರಗಳನ್ನು ಖಂಡಿಸಿ ದುಷ್ಟರನ್ನು ದಂಡಿಸಿದ್ದೀರಿ;</para>
  <para style="q2" vid="PSA 9:5">ಅವರ ಹೆಸರನ್ನು ಯುಗಯುಗಾಂತರಗಳವರೆಗೂ ಅಳಿಸಿಬಿಟ್ಟಿದ್ದೀರಿ.<verse eid="PSA 9:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 9:6"/>ವೈರಿಯನ್ನು ವಿನಾಶವು ನಿರಂತರವಾಗಿ ಬೆನ್ನಟ್ಟಿದೆ,</para>
  <para style="q2" vid="PSA 9:6">ನೀವು ಅವರ ಪಟ್ಟಣಗಳನ್ನು ಕೆಡವಿದ್ದೀರಿ;</para>
  <para style="q2" vid="PSA 9:6">ಅವರ ಸ್ಮರಣೆಯು ಅವರೊಂದಿಗೇ ನಾಶವಾಯಿತು.<verse eid="PSA 9:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 9:7"/>ಯೆಹೋವ ದೇವರು ಸದಾ ಆಳುವವರು;</para>
  <para style="q2" vid="PSA 9:7">ಅವರು ನ್ಯಾಯಕ್ಕಾಗಿ ತಮ್ಮ ಸಿಂಹಾಸನವನ್ನು ಸ್ಥಾಪಿಸಿದ್ದಾರೆ.<verse eid="PSA 9:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 9:8"/>ಅವರು ನೀತಿಯಿಂದ ಲೋಕಕ್ಕೆ ನ್ಯಾಯತೀರಿಸುವರು;</para>
  <para style="q2" vid="PSA 9:8">ಪ್ರಜೆಗಳಿಗೆ ಯಥಾರ್ಥವಾದ ತೀರ್ಪು ನೀಡುವರು.<verse eid="PSA 9:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 9:9"/>ಯೆಹೋವ ದೇವರು ಕುಗ್ಗಿದವರಿಗೆ ಆಶ್ರಯವಾಗಿರುವರು,</para>
  <para style="q2" vid="PSA 9:9">ಇಕ್ಕಟ್ಟಿನ ದಿವಸಗಳಲ್ಲಿ ಭದ್ರಕೋಟೆಯಾಗಿರುವರು.<verse eid="PSA 9:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 9:10"/>ನಿಮ್ಮ ಹೆಸರನ್ನು ತಿಳಿದವರು ನಿಮ್ಮಲ್ಲಿ ಭರವಸೆ ಇಡುವರು,</para>
  <para style="q2" vid="PSA 9:10">ಏಕೆಂದರೆ ಯೆಹೋವ ದೇವರೇ,</para>
  <para style="q2" vid="PSA 9:10">ನಿಮ್ಮನ್ನು ಹುಡುಕುವವರನ್ನು ನೀವು ಎಂದಿಗೂ ತೊರೆದುಬಿಡುವುದಿಲ್ಲ.<verse eid="PSA 9:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 9:11"/>ಚೀಯೋನಿನಲ್ಲಿ ವಾಸಿಸುವ ಯೆಹೋವ ದೇವರಿಗೆ ಸ್ತುತಿಹಾಡಿರಿ;</para>
  <para style="q2" vid="PSA 9:11">ಅವರ ಕ್ರಿಯೆಗಳನ್ನು ರಾಷ್ಟ್ರಗಳಲ್ಲಿ ಸಾರಿ ಹೇಳಿರಿ.<verse eid="PSA 9:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 9:12"/>ಅವರು ಪ್ರಾಣಹತ್ಯೆ ಮಾಡುವವರನ್ನು ಮುಯ್ಯಿತೀರಿಸಲು ಜ್ಞಾಪಕಮಾಡಿಕೊಳ್ಳುವರು;</para>
  <para style="q2" vid="PSA 9:12">ಬಾಧೆಗೆ ಒಳಗಾಗಿರುವ ದೀನರ ಕೂಗನ್ನು ಅವರು ಅಲಕ್ಷ್ಯಮಾಡುವುದಿಲ್ಲ.<verse eid="PSA 9:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 9:13"/>ಯೆಹೋವ ದೇವರೇ, ನನ್ನ ವೈರಿಗಳು ನನ್ನನ್ನು ಹಿಂಸಿಸುವುದನ್ನು ನೋಡಿರಿ.</para>
  <para style="q2" vid="PSA 9:13">ನನ್ನನ್ನು ಕರುಣಿಸಿ, ಮರಣ ದ್ವಾರದಿಂದ ನನ್ನನ್ನು ಮೇಲಕ್ಕೆತ್ತಿರಿ.<verse eid="PSA 9:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 9:14"/>ಆಗ ಚೀಯೋನೆಂಬ ನಗರ ದ್ವಾರಗಳಲ್ಲಿ</para>
  <para style="q2" vid="PSA 9:14">ನಿಮ್ಮ ಸ್ತುತಿಯನ್ನು ಸಾರುವೆನು.</para>
  <para style="q2" vid="PSA 9:14">ನಿಮ್ಮ ರಕ್ಷಣೆಯಲ್ಲಿ ಆನಂದಿಸುವೆನು.<verse eid="PSA 9:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 9:15"/>ರಾಷ್ಟ್ರಗಳು ತಾವು ಅಗೆದ ಕುಣಿಯಲ್ಲಿ ತಾವೇ ಬಿದ್ದಿದ್ದಾರೆ;</para>
  <para style="q2" vid="PSA 9:15">ಅವರು ಅಡಗಿಸಿಟ್ಟ ಬಲೆಯಲ್ಲೇ ಅವರ ಕಾಲುಗಳು ಸಿಕ್ಕಿಕೊಂಡಿವೆ.<verse eid="PSA 9:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 9:16"/>ಯೆಹೋವ ದೇವರು ತಮ್ಮ ನ್ಯಾಯಕೃತ್ಯಗಳಲ್ಲಿ ಪ್ರಸಿದ್ಧರಾಗಿದ್ದಾರೆ;</para>
  <para style="q2" vid="PSA 9:16">ದುಷ್ಟರು ತಮ್ಮ ಕೈಕೆಲಸದಲ್ಲಿ ಸಿಕ್ಕಿಕೊಂಡಿದ್ದಾರೆ.<verse eid="PSA 9:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 9:17"/>ದುಷ್ಟರು ಪಾತಾಳಕ್ಕೆ ತಿರುಗುವರು,</para>
  <para style="q2" vid="PSA 9:17">ದೇವರನ್ನು ಮರೆಯುವ ರಾಷ್ಟ್ರಗಳ ಅಂತ್ಯವೂ ಹಾಗೇ ಇರುವುದು.<verse eid="PSA 9:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 9:18"/>ಆದರೆ ದೇವರು ಬಡವರನ್ನು ಎಂದೆಂದಿಗೂ ಮರೆಯುವುದಿಲ್ಲ;</para>
  <para style="q2" vid="PSA 9:18">ಕುಗ್ಗಿದವರ ನಿರೀಕ್ಷೆ ಎಂದೆಂದಿಗೂ ನಾಶವಾಗುವುದಿಲ್ಲ.<verse eid="PSA 9:18"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 9:19"/>ಯೆಹೋವ ದೇವರೇ ಎದ್ದೇಳಿರಿ, ಮನುಷ್ಯರು ನನ್ನ ಮೇಲೆ ವಿಜಯ ಸಾಧಿಸದಿರಲಿ;</para>
  <para style="q2" vid="PSA 9:19">ರಾಷ್ಟ್ರಗಳಿಗೆ ನಿಮ್ಮ ಮುಂದೆಯೇ ನ್ಯಾಯತೀರ್ಪಾಗಲಿ.<verse eid="PSA 9:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 9:20"/>ಯೆಹೋವ ದೇವರೇ, ಅವರನ್ನು ಭಯದಲ್ಲಿರಿಸಿರಿ;</para>
  <para style="q2" vid="PSA 9:20">ರಾಷ್ಟ್ರಗಳು ತಾವು ಮನುಷ್ಯರೇ ಎಂದು ತಿಳಿದುಕೊಳ್ಳಲಿ.<verse eid="PSA 9:20"/></para>
  <chapter eid="PSA 9"/>
  <chapter number="10" style="c" sid="PSA 10"/>
  <para style="cl">ಕೀರ್ತನೆ 10</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 10:1"/>ಯೆಹೋವ ದೇವರೇ, ನೀವು ದೂರದಲ್ಲಿ ನಿಂತುಕೊಳ್ಳುವುದು ಏಕೆ?</para>
  <para style="q2" vid="PSA 10:1">ಇಕ್ಕಟ್ಟಿನ ಕಾಲಗಳಲ್ಲಿ ನೀವು ಮರೆಯಾಗಿರುವುದೂ ಏಕೆ?<verse eid="PSA 10:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 10:2"/>ದುಷ್ಟನು ಗರ್ವದಿಂದ ದೀನನನ್ನು ಬೇಟೆಯಾಡುತ್ತಾನೆ,</para>
  <para style="q2" vid="PSA 10:2">ಅವನು ಕಲ್ಪಿಸಿದ ಕುಯುಕ್ತಿಗಳಲ್ಲಿ ಅವನೇ ಸಿಕ್ಕಿಬೀಳುತ್ತಾನೆ.<verse eid="PSA 10:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 10:3"/>ದುಷ್ಟನು ತನ್ನ ಹೃದಯಭಿಲಾಷೆಯಲ್ಲಿ ಕೊಚ್ಚಿಕೊಳ್ಳುತ್ತಾನೆ;</para>
  <para style="q2" vid="PSA 10:3">ಅವನು ದುರಾಶೆಯುಳ್ಳವರನ್ನು ಆಶೀರ್ವದಿಸುವವನೂ ಯೆಹೋವ ದೇವರನ್ನು ಶಪಿಸುವವನೂ ಆಗಿದ್ದಾನೆ.<verse eid="PSA 10:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 10:4"/>ದುಷ್ಟನು ತನ್ನ ಗರ್ವದಲ್ಲಿ ದೇವರನ್ನು ಹುಡುಕುವುದಿಲ್ಲ;</para>
  <para style="q2" vid="PSA 10:4">ಅವನ ಎಲ್ಲ ಯೋಚನೆಗಳಲ್ಲಿಯೂ ದೇವರಿಗೆ ಸ್ಥಳವೇ ಇಲ್ಲ.<verse eid="PSA 10:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 10:5"/>ಅವನ ಮಾರ್ಗಗಳು ಯಾವಾಗಲೂ ಸಮೃದ್ಧಿಯಾಗಿರುತ್ತವೆ;</para>
  <para style="q2" vid="PSA 10:5">ಆದರೆ ನಿಮ್ಮ ನಿಯಮಗಳು ಅವನ ದೃಷ್ಟಿಗೆ ಬಹು ದೂರವಾಗಿವೆ;</para>
  <para style="q2" vid="PSA 10:5">ಅವನು ತನ್ನ ಎಲ್ಲಾ ವೈರಿಗಳನ್ನು ಹೀಯಾಳಿಸುತ್ತಾನೆ.<verse eid="PSA 10:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 10:6"/>ಅವನು ತನ್ನ ಹೃದಯದಲ್ಲಿ ಹೀಗೆ ಹೇಳುವನು, “ಯಾವುದೂ ಎಂದೂ ನನ್ನನ್ನು ಕದಲಿಸುವುದಿಲ್ಲ.”</para>
  <para style="q2" vid="PSA 10:6">ಅವನು ಹೀಗೆ ಶಪಥ ಮಾಡುವನು, “ಯಾರೂ ಎಂದಿಗೂ ನನಗೆ ಕೇಡುಮಾಡಲಾರರು.”<verse eid="PSA 10:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 10:7"/>ಅವನ ಬಾಯಿ ಸುಳ್ಳಿನಿಂದಲೂ ಬೆದರಿಕೆಯಿಂದಲೂ ತುಂಬಿದೆ.</para>
  <para style="q2" vid="PSA 10:7">ಕೇಡೂ ನಾಶನವೂ ಅವನ ನಾಲಿಗೆಯ ಕೆಳಗೆ ಇರುತ್ತವೆ.<verse eid="PSA 10:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 10:8"/>ಅವನು ಗ್ರಾಮಗಳಲ್ಲಿ ಹೊಂಚಿಕೊಂಡು ಮರೆಯಾದ ಸ್ಥಳಗಳಲ್ಲಿ,</para>
  <para style="q2" vid="PSA 10:8">ನಿರಪರಾಧಿಯನ್ನು ಕೊಲ್ಲುತ್ತಾನೆ.</para>
  <para style="q1" vid="PSA 10:8">ಅವನ ಕಣ್ಣುಗಳು ನಿರ್ಗತಿಕರನ್ನು ಹೊಂಚಿ ನೋಡುತ್ತವೆ;<verse eid="PSA 10:8"/></para>
  <para style="q2">
    <verse number="9" style="v" sid="PSA 10:9"/>ಸಿಂಹದ ಹಾಗೆ, ಮರೆಯಲ್ಲಿ ಹೊಂಚುಹಾಕುತ್ತಾನೆ;</para>
  <para style="q1" vid="PSA 10:9">ಅಸಹಾಯಕರನ್ನು ಹಿಡಿಯಲು ಕಾಯುತ್ತಾನೆ</para>
  <para style="q2" vid="PSA 10:9">ಕುಗ್ಗಿದವನನ್ನು ಹಿಡಿದೆಳೆದು ತನ್ನ ಬಲೆಯಲ್ಲಿ ಹಾಕುತ್ತಾನೆ.<verse eid="PSA 10:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 10:10"/>ಅವನ ಕೈಯಲ್ಲಿ ಸಿಕ್ಕುವವರು ಜಜ್ಜಿಹೋಗುತ್ತಾರೆ,</para>
  <para style="q2" vid="PSA 10:10">ಅವನ ಬಲದ ಎದುರು ಸೋತುಹೋಗುತ್ತಾರೆ.<verse eid="PSA 10:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 10:11"/>“ದೇವರು ಮರೆತುಬಿಟ್ಟಿದ್ದಾರೆ; ತಮ್ಮ ಮುಖ ಮರೆ ಮಾಡಿಕೊಂಡಿದ್ದಾರೆ;</para>
  <para style="q2" vid="PSA 10:11">ಇನ್ನೆಂದೂ ಕಾಣಲಾರರು,” ಎಂದು ತನಗೆ ತಾನೇ ಹೇಳಿಕೊಳ್ಳುತ್ತಾನೆ.<verse eid="PSA 10:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 10:12"/>ಯೆಹೋವ ದೇವರೇ, ಎದ್ದೇಳಿರಿ! ದೇವರೇ, ನಿಮ್ಮ ಕೈ ಎತ್ತಿರಿ.</para>
  <para style="q2" vid="PSA 10:12">ನಿಸ್ಸಹಾಯಕರನ್ನು ಮರೆಯಬೇಡಿರಿ.<verse eid="PSA 10:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 10:13"/>ದುಷ್ಟರು ದೇವರನ್ನು ಅಲಕ್ಷ್ಯ ಮಾಡುವುದು ಏಕೆ?</para>
  <para style="q2" vid="PSA 10:13">“ದೇವರು ನನ್ನನ್ನು ಲೆಕ್ಕ ಕೇಳುವುದಿಲ್ಲ,” ಎಂದು</para>
  <para style="q2" vid="PSA 10:13">ಅವನು ತನಗೆ ತಾನೇ ಹೇಳಿಕೊಳ್ಳುವುದು ಏಕೆ?<verse eid="PSA 10:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 10:14"/>ದೇವರೇ, ನೀವಾದರೋ ಬಾಧೆಪಡುವವರ ಕಷ್ಟಗಳನ್ನು ನೋಡಿದ್ದೀರಿ;</para>
  <para style="q2" vid="PSA 10:14">ಅವರ ಸಂಕಟವನ್ನು ಪರಿಗಣಿಸಿ, ನೀವೇ ನೋಡಿಕೊಳ್ಳಿರಿ.</para>
  <para style="q1" vid="PSA 10:14">ಗತಿಯಿಲ್ಲದವರು ತಮ್ಮನ್ನು ನಿಮಗೇ ಒಪ್ಪಿಸಿಕೊಡುತ್ತಾರೆ;</para>
  <para style="q2" vid="PSA 10:14">ನೀವೇ ದಿಕ್ಕಿಲ್ಲದವರಿಗೆ ಸಹಾಯ ಮಾಡುವವರು.<verse eid="PSA 10:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 10:15"/>ದುಷ್ಟನ ಭುಜಬಲವನ್ನು ಮುರಿದುಬಿಡಿರಿ;</para>
  <para style="q2" vid="PSA 10:15">ಕೆಟ್ಟದ್ದನ್ನು ಮಾಡುವವರಿಗೆ ಅವರ ಕೆಟ್ಟತನಕ್ಕೆ ಲೆಕ್ಕ ಕೇಳಿರಿ;</para>
  <para style="q2" vid="PSA 10:15">ಇಲ್ಲದಿದ್ದರೆ ನೀವು ಅವನನ್ನು ಲೆಕ್ಕ ಕೇಳುವುದಿಲ್ಲ ಅಂದುಕೊಳ್ಳುವನು.<verse eid="PSA 10:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 10:16"/>ಯೆಹೋವ ದೇವರು ಯುಗಯುಗಾಂತರಗಳಿಗೂ ಅರಸರಾಗಿದ್ದಾರೆ;</para>
  <para style="q2" vid="PSA 10:16">ರಾಷ್ಟ್ರಗಳು ಅವರ ದೇಶದೊಳಗಿಂದ ಹೊರಹಾಕಲಾಯಿತು.<verse eid="PSA 10:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 10:17"/>ಯೆಹೋವ ದೇವರೇ, ನೀವು ಬಾಧೆಪಡುವವರ ಬಯಕೆಯನ್ನು ಆಲಿಸುತ್ತೀರಿ;</para>
  <para style="q2" vid="PSA 10:17">ಅವರನ್ನು ಪ್ರೋತ್ಸಾಹಿಸಿ, ಅವರ ಕೂಗನ್ನು ಲಾಲಿಸುತ್ತೀರಿ.<verse eid="PSA 10:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 10:18"/>ಅನಾಥರಿಗೂ, ಕುಗ್ಗಿದವರಿಗೂ ನ್ಯಾಯವನ್ನು ನಡಿಸಿಕೊಡಿರಿ.</para>
  <para style="q2" vid="PSA 10:18">ಹೀಗಾದರೆ ಕೇವಲ ಮಣ್ಣಿನ ಮಾನವರಿಂದ</para>
  <para style="q2" vid="PSA 10:18">ಅವರಿಗೆ ಇನ್ನೆಂದಿಗೂ ಭಯ ಉಂಟಾಗುವುದಿಲ್ಲ.<verse eid="PSA 10:18"/></para>
  <chapter eid="PSA 10"/>
  <chapter number="11" style="c" sid="PSA 11"/>
  <para style="cl">ಕೀರ್ತನೆ 11</para>
  <para style="d">ಸಂಗೀತ ನಿರ್ದೇಶಕನಿಗಾಗಿರುವ ಕೀರ್ತನೆ. ದಾವೀದನ ಕೀರ್ತನೆ.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 11:1"/>ಯೆಹೋವ ದೇವರಲ್ಲಿ ನಾನು ಆಶ್ರಯಿಸಿದ್ದೇನೆ.</para>
  <para style="q2" vid="PSA 11:1">ಹಾಗಾದರೆ, “ಒಂದು ಪಕ್ಷಿಯಂತೆ ನಿನ್ನ ಪರ್ವತಕ್ಕೆ ಹಾರಿ ಹೋಗು,”</para>
  <para style="q2" vid="PSA 11:1">ಎಂದು ನೀವು ನನಗೆ ಹೇಗೆ ಹೇಳುವಿರಿ?<verse eid="PSA 11:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 11:2"/>“ಇಗೋ, ದುಷ್ಟರು ತಮ್ಮ ಬಿಲ್ಲು ಬಗ್ಗಿಸಿ;</para>
  <para style="q2" vid="PSA 11:2">ಬಾಣವನ್ನು ಬಿಲ್ಲಿಗೆ ಹೂಡಿ,</para>
  <para style="q2" vid="PSA 11:2">ಯಥಾರ್ಥ ಹೃದಯವುಳ್ಳವರ ಮೇಲೆ ಗುಪ್ತವಾಗಿ ಎಸೆಯುವುದಕ್ಕೆ ಸಿದ್ಧಮಾಡಿದ್ದಾರೆ.<verse eid="PSA 11:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 11:3"/>ಅಸ್ತಿವಾರಗಳೇ ಕೆಡವುತ್ತಿರಲು,</para>
  <para style="q2" vid="PSA 11:3">ನೀತಿವಂತನು ಏನು ಮಾಡಲು ಸಾಧ್ಯ?”<verse eid="PSA 11:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 11:4"/>ಯೆಹೋವ ದೇವರು ತಮ್ಮ ಪರಿಶುದ್ಧ ಮಂದಿರದಲ್ಲಿ ಇದ್ದಾರೆ;</para>
  <para style="q2" vid="PSA 11:4">ಯೆಹೋವ ದೇವರು ತಮ್ಮ ಪರಲೋಕ ಸಿಂಹಾಸನದಲ್ಲಿ ಇದ್ದಾರೆ.</para>
  <para style="q1" vid="PSA 11:4">ಅವರು ಭೂಮಿಯಲ್ಲಿ ಪ್ರತಿಯೊಬ್ಬರನ್ನು ಗಮನಿಸುತ್ತಾರೆ;</para>
  <para style="q2" vid="PSA 11:4">ಅವರ ಕಣ್ಣುಗಳು ಮಾನವರೆಲ್ಲರನ್ನು ಪರಿಶೋಧಿಸುತ್ತವೆ.<verse eid="PSA 11:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 11:5"/>ಯೆಹೋವ ದೇವರು ನೀತಿವಂತನನ್ನು ಪರೀಕ್ಷಿಸುತ್ತಾರೆ,</para>
  <para style="q2" vid="PSA 11:5">ಆದರೆ ಅವರು ದುಷ್ಟರನ್ನೂ ಹಿಂಸಾತ್ಮಕರನ್ನೂ ವಿರೋಧಿಸುತ್ತಾರೆ.<verse eid="PSA 11:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 11:6"/>ಅವರು ದುಷ್ಟರ ಮೇಲೆ ಬೆಂಕಿಯನ್ನೂ</para>
  <para style="q2" vid="PSA 11:6">ಗಂಧಕವನ್ನೂ ಉರಿಗಾಳಿಯನ್ನೂ ಸುರಿಸಲಿ;</para>
  <para style="q2" vid="PSA 11:6">ಇವೇ ದುಷ್ಟರ ಪಾಲಾಗಿರಲಿ.<verse eid="PSA 11:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 11:7"/>ಏಕೆಂದರೆ ಯೆಹೋವ ದೇವರು ನೀತಿಯುಳ್ಳವರು.</para>
  <para style="q2" vid="PSA 11:7">ಅವರು ನ್ಯಾಯವನ್ನು ಪ್ರೀತಿಸುತ್ತಾರೆ;</para>
  <para style="q2" vid="PSA 11:7">ಯಥಾರ್ಥರು ಅವರ ಮುಖವನ್ನು ದೃಷ್ಟಿಸುವರು.<verse eid="PSA 11:7"/></para>
  <chapter eid="PSA 11"/>
  <chapter number="12" style="c" sid="PSA 12"/>
  <para style="cl">ಕೀರ್ತನೆ 12</para>
  <para style="d">ಸಂಗೀತ ನಿರ್ದೇಶಕನಿಗಾಗಿರುವ ಕೀರ್ತನೆ. <char style="tl">ಶೆಮಿನಿಥ್</char> ಸ್ವರದೊಂದಿಗೆ ಹಾಡತಕ್ಕದ್ದು. ದಾವೀದನ ಕೀರ್ತನೆ.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 12:1"/>ಯೆಹೋವ ದೇವರೇ, ರಕ್ಷಿಸಿರಿ, ಏಕೆಂದರೆ ದೇವಭಕ್ತರು ಮುಗಿದು ಹೋಗುತ್ತಿದ್ದಾರೆ;</para>
  <para style="q2" vid="PSA 12:1">ಜನರಲ್ಲಿ ನಂಬಿಗಸ್ತರು ಇಲ್ಲದೆ ಹೋಗುತ್ತಿದ್ದಾರೆ.<verse eid="PSA 12:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 12:2"/>ಪ್ರತಿಯೊಬ್ಬರು ತಮ್ಮ ನೆರೆಯವರ ಸಂಗಡ ಸುಳ್ಳಾಡುತ್ತಾರೆ;</para>
  <para style="q2" vid="PSA 12:2">ಅವರು ತಮ್ಮ ತುಟಿಯಿಂದ ಹೊಗಳಿ,</para>
  <para style="q2" vid="PSA 12:2">ಹೃದಯದಲ್ಲಿ ವಂಚನೆಯನ್ನು ಮಾತನಾಡುತ್ತಾರೆ.<verse eid="PSA 12:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 12:3"/>ಹೊಗಳಿಕೆಯ ಎಲ್ಲಾ ತುಟಿಗಳನ್ನೂ</para>
  <para style="q2" vid="PSA 12:3">ಗರ್ವ ಮಾತನಾಡುವ ಎಲ್ಲಾ ನಾಲಿಗೆಯನ್ನೂ ಯೆಹೋವ ದೇವರು ಮೌನವಾಗಿರಿಸಲಿ.<verse eid="PSA 12:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 12:4"/>ಅವರು ಹೀಗೆನ್ನುತ್ತಾರೆ, “ನಾವು ನಮ್ಮ ನಾಲಿಗೆಯಿಂದ ಜಯಿಸುವೆವು;</para>
  <para style="q2" vid="PSA 12:4">ನಮ್ಮ ತುಟಿಗಳೇ ನಮಗೆ ಸಂರಕ್ಷಣೆ</para>
  <para style="q2" vid="PSA 12:4">ನಮ್ಮ ಮೇಲೆ ಒಡೆಯನು ಯಾರು?”<verse eid="PSA 12:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 12:5"/>“ಬಡವರು ಹಿಂಸೆಗೆ ಒಳಗಾಗಿರುವುದರಿಂದಲೂ ಗತಿಯಿಲ್ಲದವರು</para>
  <para style="q2" vid="PSA 12:5">ನರಳಾಡುವುದರಿಂದಲೂ ನಾನು ಈಗಲೇ ಏಳುವೆನು,” ಎಂದು ಯೆಹೋವ ದೇವರು ಹೇಳುತ್ತಾರೆ.</para>
  <para style="q2" vid="PSA 12:5">“ಪೀಡಿಸುವವರಿಂದ ನಾನು ಬಡವರನ್ನು ಕಾಪಾಡುವೆನು.”<verse eid="PSA 12:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 12:6"/>ಯೆಹೋವ ದೇವರ ವಾಕ್ಯಗಳು ದೋಷವಿಲ್ಲದ್ದು.</para>
  <para style="q2" vid="PSA 12:6">ಅವು ಮಣ್ಣಿನ ಕುಲುಮೆಯಲ್ಲಿ ಶುದ್ಧೀಕರಿಸಿದ ಬೆಳ್ಳಿಯಂತೆಯೂ</para>
  <para style="q2" vid="PSA 12:6">ಏಳು ಸಾರಿ ಪುಟಕ್ಕೆ ಹಾಕಿದ ಬಂಗಾರದಂತೆಯೂ ಇವೆ.<verse eid="PSA 12:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 12:7"/>ಯೆಹೋವ ದೇವರೇ, ನೀವು ಗತಿಯಿಲ್ಲದವರನ್ನು</para>
  <para style="q2" vid="PSA 12:7">ದುಷ್ಟರಿಂದ ಯಾವಾಗಲೂ ಕಾಪಾಡಿ ಸಂರಕ್ಷಿಸುತ್ತೀರಿ,<verse eid="PSA 12:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 12:8"/>ಮನುಷ್ಯರು ಅಸಹ್ಯವಾದದ್ದನ್ನು ಗೌರವಿಸುವಾಗ,</para>
  <para style="q2" vid="PSA 12:8">ಆ ದುಷ್ಟರು ಎಲ್ಲಾ ಕಡೆಗಳಲ್ಲಿಯೂ ಸ್ವತಂತ್ರವಾಗಿ ಅಲೆದಾಡುತ್ತಿರುವರು.<verse eid="PSA 12:8"/></para>
  <chapter eid="PSA 12"/>
  <chapter number="13" style="c" sid="PSA 13"/>
  <para style="cl">ಕೀರ್ತನೆ 13</para>
  <para style="d">ಸಂಗೀತ ನಿರ್ದೇಶಕನಿಗಾಗಿರುವ ಕೀರ್ತನೆ. ದಾವೀದನ ಕೀರ್ತನೆ.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 13:1"/>ಯೆಹೋವ ದೇವರೇ, ಎಷ್ಟರವರೆಗೆ ನನ್ನನ್ನು ಮರೆಯುವಿರಿ? ಎಂದೆಂದಿಗೂ ನನ್ನನ್ನು ಮರೆಯುವಿರೋ?</para>
  <para style="q2" vid="PSA 13:1">ಎಷ್ಟರವರೆಗೆ ನಿಮ್ಮ ಮುಖವನ್ನು ನನ್ನಿಂದ ಮರೆಮಾಡುವಿರಿ?<verse eid="PSA 13:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 13:2"/>ಇನ್ನೆಷ್ಟರವರೆಗೆ ನನ್ನ ಆಲೋಚನೆಗಳೊಂದಿಗೆ ನಾನು ಹೋರಾಡುತ್ತಿರಬೇಕು?</para>
  <para style="q2" vid="PSA 13:2">ದಿನನಿತ್ಯವು ನಾನು ನನ್ನ ಹೃದಯದಲ್ಲಿ ನೊಂದಿರಬೇಕೆ?</para>
  <para style="q2" vid="PSA 13:2">ಇನ್ನೆಷ್ಟರವರೆಗೆ ನನ್ನ ಶತ್ರುವು ನನ್ನ ಮೇಲೆ ಜಯ ಹೊಂದಿರಬೇಕು?<verse eid="PSA 13:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 13:3"/>ನನ್ನ ದೇವರಾದ ಯೆಹೋವ ದೇವರೇ, ನನ್ನನ್ನು ನೋಡಿ ನನಗೆ ಸದುತ್ತರ ಕೊಡಿರಿ.</para>
  <para style="q2" vid="PSA 13:3">ನನಗೆ ಮರಣ ನಿದ್ರೆ ಉಂಟಾಗದಂತೆ ನನ್ನ ಕಣ್ಣುಗಳನ್ನು ಬೆಳಗಿಸಿರಿ.<verse eid="PSA 13:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 13:4"/>“ನಾನು ಅವನನ್ನು ಸೋಲಿಸಿದ್ದೇನೆ,” ಎಂದು ನನ್ನ ಶತ್ರು ಹೇಳದಿರಲಿ,</para>
  <para style="q2" vid="PSA 13:4">ನಾನು ಬೀಳುವಾಗ ನನ್ನ ಶತ್ರುಗಳು ಆನಂದಿಸದಿರಲಿ.<verse eid="PSA 13:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 13:5"/>ನಾನಾದರೋ ನಿಮ್ಮ ಒಡಂಬಡಿಕೆಯ ಪ್ರೀತಿಯಲ್ಲಿ ಭರವಸೆ ಇಟ್ಟಿದ್ದೇನೆ.</para>
  <para style="q2" vid="PSA 13:5">ನಿಮ್ಮ ರಕ್ಷಣೆಯಲ್ಲಿ ನನ್ನ ಹೃದಯವು ಉಲ್ಲಾಸಪಡುವುದು.<verse eid="PSA 13:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 13:6"/>ನಾನು ಯೆಹೋವ ದೇವರಿಗೆ ಸ್ತುತಿ ಹಾಡುವೆನು,</para>
  <para style="q2" vid="PSA 13:6">ಏಕೆಂದರೆ ಅವರು ನನಗೆ ಒಳ್ಳೆಯವರಾಗಿದ್ದಾರೆ.<verse eid="PSA 13:6"/></para>
  <chapter eid="PSA 13"/>
  <chapter number="14" style="c" sid="PSA 14"/>
  <para style="cl">ಕೀರ್ತನೆ 14</para>
  <para style="d">ಸಂಗೀತ ನಿರ್ದೇಶಕನಿಗಾಗಿರುವ ಕೀರ್ತನೆ. ದಾವೀದನ ಕೀರ್ತನೆ.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 14:1"/>“ದೇವರು ಇಲ್ಲಾ,” ಎಂದು</para>
  <para style="q2" vid="PSA 14:1">ಮೂರ್ಖರು ತಮ್ಮ ಹೃದಯದಲ್ಲಿ ಹೇಳಿಕೊಳ್ಳುತ್ತಾರೆ.</para>
  <para style="q1" vid="PSA 14:1">ಅವರು ಕೆಟ್ಟು ಹೋಗಿ, ಅಸಹ್ಯ ಕೃತ್ಯಗಳನ್ನು ಮಾಡುತ್ತಾರೆ;</para>
  <para style="q2" vid="PSA 14:1">ಒಳ್ಳೆಯದನ್ನು ಮಾಡುವವರು ಯಾರೂ ಇಲ್ಲ.<verse eid="PSA 14:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 14:2"/>ದೇವರನ್ನು ಹುಡುಕುವ</para>
  <para style="q2" vid="PSA 14:2">ಜ್ಞಾನಿಗಳು ಇದ್ದಾರೋ ಎಂದು ನೋಡುವುದಕ್ಕೆ</para>
  <para style="q1" vid="PSA 14:2">ಯೆಹೋವ ದೇವರು ಸ್ವರ್ಗದಿಂದ,</para>
  <para style="q2" vid="PSA 14:2">ಮನುಷ್ಯರ ಮೇಲೆ ದೃಷ್ಟಿಸಿದರು.<verse eid="PSA 14:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 14:3"/>ಎಲ್ಲರೂ ದಾರಿತಪ್ಪಿ ಹೋಗಿದ್ದಾರೆ, ಎಲ್ಲರೂ ಕೆಟ್ಟು ಹೋಗಿದ್ದಾರೆ;</para>
  <para style="q2" vid="PSA 14:3">ಒಳ್ಳೆಯದನ್ನು ಮಾಡುವವರು ಯಾರೂ ಇಲ್ಲ,</para>
  <para style="q2" vid="PSA 14:3">ಒಬ್ಬರಾದರೂ ಇಲ್ಲ.<verse eid="PSA 14:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 14:4"/>ದುಷ್ಟತ್ವವನ್ನು ನಡೆಸುವವರಿಗೆ ಏನೂ ತಿಳಿಯುವುದಿಲ್ಲವೋ?</para>
  <para style="b" vid="PSA 14:4"/>
  <para style="q1" vid="PSA 14:4">ಅವರು ನನ್ನ ಜನರನ್ನು ರೊಟ್ಟಿಯಂತೆ ತಿಂದು ಬಿಡುತ್ತಾರೆಯೋ?</para>
  <para style="q2" vid="PSA 14:4">ಆದರೆ ಅವರು ಯೆಹೋವ ದೇವರಿಗೆ ಎಂದೂ ಮೊರೆಯಿಡುವುದಿಲ್ಲ.<verse eid="PSA 14:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 14:5"/>ದೇವರು ನೀತಿವಂತರ ಸಹವಾಸದಲ್ಲಿ ಇರುವುದರಿಂದ,</para>
  <para style="q2" vid="PSA 14:5">ದುಷ್ಟತ್ವವನ್ನು ನಡೆಸುವವರು ಅತ್ಯಂತ ಭಯಭ್ರಾಂತರಾಗುವರು.<verse eid="PSA 14:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 14:6"/>ದುಷ್ಟತ್ವ ನಡೆಸುವವರೇ, ನೀವು ಬಡವರ ಯೋಜನೆಗಳನ್ನು ನಿರಾಶೆಗೊಳಿಸುತ್ತೀರಿ,</para>
  <para style="q2" vid="PSA 14:6">ಆದರೆ ಯೆಹೋವ ದೇವರೇ ಅವರ ಆಶ್ರಯವಾಗಿದ್ದಾರೆ.<verse eid="PSA 14:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 14:7"/>ಓ, ಚೀಯೋನಿನಿಂದ ಇಸ್ರಾಯೇಲರಿಗೆ ರಕ್ಷಣೆಯು ಬಂದರೆ ಎಷ್ಟೋ ಒಳ್ಳೆಯದು!</para>
  <para style="q2" vid="PSA 14:7">ಯೆಹೋವ ದೇವರು ತಮ್ಮ ಜನರನ್ನು ಸೆರೆಯಿಂದ ತಿರುಗಿ ಬರಮಾಡುವಾಗ,</para>
  <para style="q2" vid="PSA 14:7">ಯಾಕೋಬ್ಯರು ಉಲ್ಲಾಸಗೊಳ್ಳುವರು. ಇಸ್ರಾಯೇಲರು ಸಂತೋಷಿಸುವರು.<verse eid="PSA 14:7"/></para>
  <chapter eid="PSA 14"/>
  <chapter number="15" style="c" sid="PSA 15"/>
  <para style="cl">ಕೀರ್ತನೆ 15</para>
  <para style="d">ದಾವೀದನ ಕೀರ್ತನೆ.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 15:1"/>ಯೆಹೋವ ದೇವರೇ, ನಿಮ್ಮ ಪರಿಶುದ್ಧ ಗುಡಾರದಲ್ಲಿ ವಾಸಿಸುವವರು ಯಾರು?</para>
  <para style="q2" vid="PSA 15:1">ನಿಮ್ಮ ಪರಿಶುದ್ಧ ಪರ್ವತದಲ್ಲಿ ಬಾಳುವವರು ಯಾರು?<verse eid="PSA 15:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 15:2"/>ದೋಷವಿಲ್ಲದವರಾಗಿ ಜೀವಿಸಿ,</para>
  <para style="q2" vid="PSA 15:2">ನೀತಿಯನ್ನು ನಡೆಸಿ,</para>
  <para style="q2" vid="PSA 15:2">ತಮ್ಮ ಹೃದಯದಿಂದ ಸತ್ಯವನ್ನಾಡುವವರೇ;<verse eid="PSA 15:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 15:3"/>ಅವರ ನಾಲಿಗೆಯು ಚಾಡಿ ಹೇಳುವುದಿಲ್ಲ,</para>
  <para style="q2" vid="PSA 15:3">ತಮ್ಮ ನೆರೆಯವರಿಗೆ ಕೇಡುಮಾಡುವುದಿಲ್ಲ,</para>
  <para style="q2" vid="PSA 15:3">ಇತರರನ್ನು ನಿಂದಿಸುವುದೂ ಇಲ್ಲ;<verse eid="PSA 15:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 15:4"/>ಅವರು ದುಷ್ಟರ ಸಹವಾಸ ಇಲ್ಲದವರೂ</para>
  <para style="q2" vid="PSA 15:4">ಯೆಹೋವ ದೇವರಲ್ಲಿ ಭಯಭಕ್ತಿಯುಳ್ಳವರನ್ನು ಸನ್ಮಾನಿಸುವವರೂ</para>
  <para style="q1" vid="PSA 15:4">ನಷ್ಟವಾದರೂ ಕೊಟ್ಟ ಮಾತನ್ನು ತಪ್ಪದೇ,</para>
  <para style="q2" vid="PSA 15:4">ತಮ್ಮ ಮನಸ್ಸನ್ನು ಬದಲಾಯಿಸಿಕೊಳ್ಳದವರೂ ಆಗಿರಬೇಕು.<verse eid="PSA 15:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 15:5"/>ಅವರು ಬಡವರಿಗೆ ಸಾಲ ಕೊಟ್ಟು ಬಡ್ಡಿಕೇಳದವರೂ;</para>
  <para style="q2" vid="PSA 15:5">ನಿರಪರಾಧಿಯ ಕೇಡಿಗಾಗಿ ಲಂಚ ತೆಗೆದುಕೊಳ್ಳದವರೂ ಆಗಿರಬೇಕು.</para>
  <para style="b" vid="PSA 15:5"/>
  <para style="q1" vid="PSA 15:5">ಈ ರೀತಿಯಾಗಿ ಬಾಳುವವರು</para>
  <para style="q2" vid="PSA 15:5">ಎಂದಿಗೂ ಕದಲುವುದಿಲ್ಲ.<verse eid="PSA 15:5"/></para>
  <chapter eid="PSA 15"/>
  <chapter number="16" style="c" sid="PSA 16"/>
  <para style="cl">ಕೀರ್ತನೆ 16</para>
  <para style="d">
    <char style="tl">ಮಿಕತಾಮ</char> ಗೀತೆ. ದಾವೀದನ ಕೀರ್ತನೆ.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 16:1"/>ನನ್ನ ದೇವರೇ, ನನ್ನನ್ನು ಕಾಪಾಡು,</para>
  <para style="q2" vid="PSA 16:1">ಏಕೆಂದರೆ ನಿಮ್ಮಲ್ಲಿ ಆಶ್ರಯಪಡೆದಿದ್ದೇನೆ.<verse eid="PSA 16:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 16:2"/>ನಾನು ಯೆಹೋವ ದೇವರಿಗೆ, “ನೀವೇ ನನ್ನ ಕರ್ತ;</para>
  <para style="q2" vid="PSA 16:2">ನಿಮ್ಮನ್ನು ಬಿಟ್ಟು ನನಗಿಲ್ಲ ಒಳಿತು,” ಎಂದು ಹೇಳಿದೆನು.<verse eid="PSA 16:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 16:3"/>ಭೂಲೋಕದಲ್ಲಿರುವ ದೇವಜನರ ಕುರಿತು,</para>
  <para style="q2" vid="PSA 16:3">“ಇವರೇ ನನಗೆ ಶ್ರೇಷ್ಠರು. ಇವರಲ್ಲಿಯೇ ನನ್ನ ಎಲ್ಲಾ ಆನಂದವು,” ಎಂದು ಹೇಳುವೆನು.<verse eid="PSA 16:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 16:4"/>ಇತರ ದೇವರುಗಳನ್ನು ಅವಲಂಬಿಸಿರುವವರಿಗೆ ವ್ಯಥೆಗಳು ಹೆಚ್ಚೆಚ್ಚಾಗುವವು.</para>
  <para style="q2" vid="PSA 16:4">ಅವರಂತೆ ರಕ್ತ ಬಲಿಗಳನ್ನು ನಾನು ಅರ್ಪಿಸುವುದಿಲ್ಲ.</para>
  <para style="q2" vid="PSA 16:4">ಅವರ ಹೆಸರುಗಳನ್ನೂ ನನ್ನ ತುಟಿಗಳಲ್ಲಿ ಉಚ್ಚರಿಸುವುದಿಲ್ಲ.<verse eid="PSA 16:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 16:5"/>ಯೆಹೋವ ದೇವರೇ, ನೀವೇ ನನ್ನ ಪಾಲೂ, ನನ್ನ ಪಾತ್ರೆಯೂ ಆಗಿದ್ದೀರಿ;</para>
  <para style="q2" vid="PSA 16:5">ನನ್ನ ಸ್ವಾಸ್ತ್ಯವನ್ನು ಸುರಕ್ಷಿತವಾಗಿ ಇಡುವವರು ನೀವೇ.<verse eid="PSA 16:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 16:6"/>ನನ್ನ ಪಾಲಿಗೆ ಬಂದ ಮೇರೆಯ ಸ್ಥಳವೂ ಸುಂದರವಾದದ್ದು;</para>
  <para style="q2" vid="PSA 16:6">ನಿಶ್ಚಯವಾಗಿಯೂ, ನನಗೆ ದೊರೆತ ಸ್ವತ್ತು ಆನಂದಕರವಾದದ್ದು.<verse eid="PSA 16:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 16:7"/>ನನಗೆ ಸಮಾಲೋಚನೆ ನೀಡುತ್ತಿರುವ ಯೆಹೋವ ದೇವರನ್ನು ನಾನು ಸ್ತುತಿಸುತ್ತಿರುವೆನು;</para>
  <para style="q2" vid="PSA 16:7">ರಾತ್ರಿಯಲ್ಲಿಯೂ ನನ್ನ ಹೃದಯವು ನನಗೆ ಬೋಧಿಸುತ್ತದೆ.<verse eid="PSA 16:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 16:8"/>ನಾನು ಯೆಹೋವ ದೇವರನ್ನು ಯಾವಾಗಲೂ ನನ್ನೆದುರಿನಲ್ಲಿಯೇ ಇಟ್ಟುಕೊಂಡಿದ್ದೇನೆ.</para>
  <para style="q2" vid="PSA 16:8">ಅವರು ನನ್ನ ಬಲಗಡೆಯಲ್ಲಿ ಇರುವುದರಿಂದ ನಾನು ಎಂದಿಗೂ ಕದಲೆನು.<verse eid="PSA 16:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 16:9"/>ಆದ್ದರಿಂದ ನನ್ನ ಹೃದಯ ಹರ್ಷಿಸುವುದು, ನನ್ನ ನಾಲಿಗೆ ಉಲ್ಲಾಸಗೊಳ್ಳುವುದು;</para>
  <para style="q2" vid="PSA 16:9">ನನ್ನ ಶರೀರವು ಸಹ ಸುರಕ್ಷಿತವಾಗಿ ವಿಶ್ರಮಿಸುವುದು.<verse eid="PSA 16:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 16:10"/>ಏಕೆಂದರೆ ನೀವು ನನ್ನ ಪ್ರಾಣವನ್ನು ಪಾತಾಳದಲ್ಲಿ ಬಿಟ್ಟುಬಿಡುವುದಿಲ್ಲ;</para>
  <para style="q2" vid="PSA 16:10">ನಿಮ್ಮ ನಂಬಿಗಸ್ತನನ್ನು ಕೊಳೆಯುವ ಅವಸ್ಥೆಗೆ ತರುವುದಿಲ್ಲ.<verse eid="PSA 16:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 16:11"/>ಜೀವಮಾರ್ಗವನ್ನು ನನಗೆ ತಿಳಿಯಪಡಿಸುವಿರಿ.</para>
  <para style="q2" vid="PSA 16:11">ನಿಮ್ಮ ಸನ್ನಿಧಿಯಲ್ಲಿ ಪರಿಪೂರ್ಣ ಸಂತೋಷವಿದೆ;</para>
  <para style="q2" vid="PSA 16:11">ನಿಮ್ಮ ಬಲಗಡೆಯಲ್ಲಿ ನಿತ್ಯಾನಂದವೂ ಇರುತ್ತದೆ.<verse eid="PSA 16:11"/></para>
  <chapter eid="PSA 16"/>
  <chapter number="17" style="c" sid="PSA 17"/>
  <para style="cl">ಕೀರ್ತನೆ 17</para>
  <para style="d">ದಾವೀದನ ಪ್ರಾರ್ಥನೆ.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 17:1"/>ಯೆಹೋವ ದೇವರೇ, ನನ್ನ ಬೇಡಿಕೆ ನ್ಯಾಯವಾದದ್ದು,</para>
  <para style="q2" vid="PSA 17:1">ನನ್ನ ಮೊರೆಗೆ ಕಿವಿಗೊಡಿರಿ.</para>
  <para style="q1" vid="PSA 17:1">ನನ್ನ ಪ್ರಾರ್ಥನೆಯನ್ನು ಕೇಳಿರಿ,</para>
  <para style="q2" vid="PSA 17:1">ಅದು ಕಪಟ ತುಟಿಗಳಿಂದ ಬಂದದ್ದಲ್ಲ.<verse eid="PSA 17:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 17:2"/>ನನ್ನ ನ್ಯಾಯವು ನಿಮ್ಮಿಂದಲೇ ಬರಲಿ,</para>
  <para style="q2" vid="PSA 17:2">ನಿಮ್ಮ ಕಣ್ಣುಗಳು ಸರಿಯಾದವುಗಳನ್ನೇ ನೋಡುತ್ತವೆ.<verse eid="PSA 17:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 17:3"/>ನೀವು ನನ್ನ ಹೃದಯವನ್ನು ಶೋಧಿಸಿದರೂ,</para>
  <para style="q2" vid="PSA 17:3">ನೀವು ರಾತ್ರಿಯಲ್ಲಿ ನನ್ನನ್ನು ಪರೀಕ್ಷಿಸಿ ವಿಚಾರಿಸಿದರೂ,</para>
  <para style="q1" vid="PSA 17:3">ನಾನು ಕೆಟ್ಟಯೋಜನೆ ಮಾಡಿಕೊಳ್ಳಲಿಲ್ಲವೆಂದು ನೀವು ಕಂಡುಕೊಳ್ಳುವಿರಿ;</para>
  <para style="q2" vid="PSA 17:3">ನನ್ನ ಬಾಯಿಯೂ ಅತಿಕ್ರಮಿಸುವುದಿಲ್ಲವೆಂದು ನಾನು ತೀರ್ಮಾನಿಸಿಕೊಂಡಿದ್ದೇನೆ.<verse eid="PSA 17:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 17:4"/>ಮನುಷ್ಯರು ನನಗೆ ಲಂಚ ನೀಡಲು ಪ್ರಯತ್ನಿಸಿದರೂ,</para>
  <para style="q2" vid="PSA 17:4">ನಿಮ್ಮ ತುಟಿಗಳ ಆಜ್ಞಾನುಸಾರ</para>
  <para style="q2" vid="PSA 17:4">ನಾನು ಹಿಂಸಕರ ಮಾರ್ಗಗಳಿಂದ ನನ್ನನ್ನು ದೂರವಾಗಿಟ್ಟುಕೊಂಡಿದ್ದೇನೆ.<verse eid="PSA 17:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 17:5"/>ನನ್ನ ಹೆಜ್ಜೆಗಳು ಜಾರದ ಹಾಗೆ ನನ್ನ ನಡೆಗಳನ್ನು</para>
  <para style="q2" vid="PSA 17:5">ನಿಮ್ಮ ದಾರಿಯಲ್ಲಿ ಸ್ಥಿರಪಡಿಸಿಕೊಂಡಿದ್ದೇನೆ.<verse eid="PSA 17:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 17:6"/>ನನ್ನ ದೇವರೇ, ನೀವು ನನಗೆ ಉತ್ತರ ಕೊಡುವುದರಿಂದ ನಾನು ನಿಮ್ಮನ್ನು ಬೇಡಿಕೊಳ್ಳುತ್ತೇನೆ;</para>
  <para style="q2" vid="PSA 17:6">ನೀವು ನಿಮ್ಮ ಕಿವಿಯನ್ನು ನನ್ನ ಕಡೆ ತಿರುಗಿಸಿ, ನನ್ನ ಪ್ರಾರ್ಥನೆಯನ್ನು ಆಲಿಸಿರಿ.<verse eid="PSA 17:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 17:7"/>ನಿಮ್ಮ ಒಡಂಬಡಿಕೆಯ ಪ್ರೀತಿಯ ಅದ್ಭುತವನ್ನು ನನಗೆ ತೋರಿಸಿರಿ.</para>
  <para style="q2" vid="PSA 17:7">ತಮ್ಮ ವೈರಿಗಳಿಂದ ಓಡಿಬಂದು ನಿಮ್ಮಲ್ಲಿ ಆಶ್ರಯ ಪಡೆಯುವವರಿಗೆ</para>
  <para style="q2" vid="PSA 17:7">ಭುಜಬಲದಿಂದ ರಕ್ಷಿಸುವವರು ನೀವೇ.<verse eid="PSA 17:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 17:8"/>ನಿಮ್ಮ ಕಣ್ಣುಗುಡ್ಡೆಯ ಹಾಗೆ ನನ್ನನ್ನು ಕಾಪಾಡಿರಿ,</para>
  <para style="q2" vid="PSA 17:8">ನಿಮ್ಮ ರೆಕ್ಕೆಗಳ ನೆರಳಿನಲ್ಲಿ ನನ್ನನ್ನು ಮರೆಮಾಡಿರಿ.<verse eid="PSA 17:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 17:9"/>ನನ್ನನ್ನು ಬಾಧಿಸುವ ದುಷ್ಟರಿಂದಲೂ,</para>
  <para style="q2" vid="PSA 17:9">ನನ್ನನ್ನು ಸುತ್ತಿಕೊಳ್ಳುವ ನನ್ನ ಪ್ರಾಣಾಂತಕ ಶತ್ರುಗಳಿಂದಲೂ ತಪ್ಪಿಸಿ.<verse eid="PSA 17:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 17:10"/>ಅವರು ತಮ್ಮ ಸೊಕ್ಕಿನ ಹೃದಯಗಳನ್ನು ಮುಚ್ಚಿಕೊಂಡಿದ್ದಾರೆ,</para>
  <para style="q2" vid="PSA 17:10">ತಮ್ಮ ಬಾಯಿಂದ ಅವರು ಗರ್ವವನ್ನು ಮಾತನಾಡುತ್ತಾರೆ.<verse eid="PSA 17:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 17:11"/>ನನ್ನನ್ನು ಬೀಳಿಸುವಂತೆ, ಅವರು ಈಗ ನನ್ನನ್ನು ಸುತ್ತಿಕೊಂಡಿದ್ದಾರೆ,</para>
  <para style="q2" vid="PSA 17:11">ನನ್ನನ್ನು ನೆಲಕ್ಕೆ ಹಾಕಬೇಕೆಂದು ಅವರ ಕಣ್ಣುಗಳು ಕಾದಿವೆ.<verse eid="PSA 17:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 17:12"/>ಅವರು ತಮ್ಮ ಬೇಟೆಯ ಹಸಿವೆಯಿಂದಿರುವ ಸಿಂಹದ ಹಾಗೆಯೂ,</para>
  <para style="q2" vid="PSA 17:12">ಗುಪ್ತಸ್ಥಳಗಳಲ್ಲಿ ಹೊಂಚಿ ಕುಳಿತಿರುವ ಭೀಕರ ಸಿಂಹದ ಹಾಗೆಯೂ ಇದ್ದಾರೆ.<verse eid="PSA 17:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 17:13"/>ಯೆಹೋವ ದೇವರೇ, ಎದ್ದು ಅವರನ್ನು ಎದುರಿಸಿ ಕೆಳಗೆ ಕೆಡವಿಬಿಡಿರಿ;</para>
  <para style="q2" vid="PSA 17:13">ನಿಮ್ಮ ಖಡ್ಗದ ಮೂಲಕ ನನ್ನನ್ನು ದುಷ್ಟರಿಂದ ಕಾಪಾಡಿರಿ.<verse eid="PSA 17:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 17:14"/>ಯೆಹೋವ ದೇವರೇ, ಈ ಲೋಕಜೀವನದಲ್ಲಿಯಷ್ಟೇ ಪ್ರತಿಫಲವೆಂದು ತಿಳಿಯುವ ಜನರಿಂದ,</para>
  <para style="q2" vid="PSA 17:14">ನನ್ನನ್ನು ನಿಮ್ಮ ಹಸ್ತದ ಮೂಲಕ ರಕ್ಷಿಸಿ ಕಾಪಾಡಿರಿ.</para>
  <para style="q1" vid="PSA 17:14">ಅಂಥ ಜನರಿಗಾಗಿ ನೀವು ಸಂಗ್ರಹಿಸಿ ಇಟ್ಟಿರುವುದು ಅವರ ಹೊಟ್ಟೆ ತುಂಬಲಿ;</para>
  <para style="q2" vid="PSA 17:14">ಅವರ ಮಕ್ಕಳು ಅದರಿಂದ ಸಮೃದ್ಧಿ ಹೊಂದಲಿ,</para>
  <para style="q2" vid="PSA 17:14">ಅವರ ಚಿಕ್ಕಮಕ್ಕಳಿಗೂ ಉಳಿದದ್ದು ಸಿಕ್ಕಲಿ.<verse eid="PSA 17:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 17:15"/>ನಾನಾದರೋ ನೀತಿಯಲ್ಲಿ ನಿಮ್ಮ ಮುಖವನ್ನು ನೋಡುವೆನು.</para>
  <para style="q2" vid="PSA 17:15">ನಾನು ಎಚ್ಚೆತ್ತಾಗ ನಿಮ್ಮ ಹೋಲಿಕೆಯನ್ನೇ ಕಂಡು ತೃಪ್ತನಾಗುವೆನು.<verse eid="PSA 17:15"/></para>
  <chapter eid="PSA 17"/>
  <chapter number="18" style="c" sid="PSA 18"/>
  <para style="cl">ಕೀರ್ತನೆ 18</para>
  <para style="d">ಸಂಗೀತ ನಿರ್ದೇಶಕನಿಗಾಗಿರುವ ಕೀರ್ತನೆ. ಯೆಹೋವ ದೇವರ ಸೇವಕನಾದ ದಾವೀದನು ಎಲ್ಲಾ ಶತ್ರುಗಳಿಂದಲೂ ಸೌಲನ ಕೈಯಿಂದಲೂ ತಪ್ಪಿಸಿಕೊಂಡಾಗ ಯೆಹೋವ ದೇವರಿಗೆ ಈ ಪದ್ಯವನ್ನು ಹಾಡಿದ್ದು. ದಾವೀದನು ಹೀಗೆ ಹೇಳಿದನು:</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 18:1"/>ನನ್ನ ಬಲವಾಗಿರುವ ಯೆಹೋವ ದೇವರೇ, ನಾನು ನಿಮ್ಮನ್ನು ಪ್ರೀತಿಸುತ್ತೇನೆ.<verse eid="PSA 18:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 18:2"/>ಯೆಹೋವ ದೇವರು ನನ್ನ ಬಂಡೆಯೂ ನನ್ನ ಕೋಟೆಯೂ ನನ್ನ ವಿಮೋಚಕರೂ ಆಗಿದ್ದಾರೆ;</para>
  <para style="q2" vid="PSA 18:2">ನನ್ನ ಬಂಡೆಯಾದ ದೇವರಲ್ಲಿ, ನಾನು ಭರವಸವಿಡುವೆನು</para>
  <para style="q2" vid="PSA 18:2">ಅವರು ನನ್ನ ಗುರಾಣಿ<note caller="+" style="f"><char style="fr" closed="false">18:2 </char><char style="ft" closed="false">ಅಥವಾ </char><char style="fqa" closed="false">ನನ್ನ ಕರ್ತ</char></note> ಮತ್ತು ನನ್ನ ರಕ್ಷಣೆಯ ಕೊಂಬು,<note caller="+" style="f"><char style="fr" closed="false">18:2 </char><char style="fq" closed="false">ಕೊಂಬು </char><char style="ft" closed="false">ಇದು ಶಕ್ತಿಯನ್ನು ಸೂಚಿಸುತ್ತದೆ.</char></note> ನನ್ನ ಉನ್ನತವಾದ ದುರ್ಗ ಆಗಿದ್ದಾರೆ.<verse eid="PSA 18:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 18:3"/>ಸ್ತುತಿ ಪಾತ್ರರಾಗಿರುವ ಯೆಹೋವ ದೇವರನ್ನು ನಾನು ಮೊರೆಯಿಟ್ಟದ್ದರಿಂದ,</para>
  <para style="q2" vid="PSA 18:3">ಅವರು ನನ್ನ ಶತ್ರುಗಳಿಂದ ನನ್ನನ್ನು ಕಾಪಾಡಿದ್ದಾರೆ.<verse eid="PSA 18:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 18:4"/>ಮರಣದ ಪಾಶಗಳು ನನ್ನನ್ನು ಸುತ್ತಿಕೊಂಡವು;</para>
  <para style="q2" vid="PSA 18:4">ವಿನಾಶಪ್ರವಾಹಗಳು ನನ್ನ ಮೇಲೆ ಹರಿದವು.<verse eid="PSA 18:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 18:5"/>ಪಾತಾಳದ ಪಾಶಗಳು ನನ್ನನ್ನು ಸುತ್ತಿಕೊಂಡವು;</para>
  <para style="q2" vid="PSA 18:5">ಮರಣದ ಬಲೆಗಳು ನನ್ನನ್ನು ಎದುರಿಸಿದವು.<verse eid="PSA 18:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 18:6"/>ನನ್ನ ಇಕ್ಕಟ್ಟಿನಲ್ಲಿ ಯೆಹೋವ ದೇವರನ್ನು ಬೇಡಿದೆನು;</para>
  <para style="q2" vid="PSA 18:6">ನನ್ನ ದೇವರಿಗೆ ಮೊರೆಯಿಟ್ಟೆನು;</para>
  <para style="q1" vid="PSA 18:6">ಅವರು ತಮ್ಮ ಮಂದಿರದೊಳಗಿಂದ ನನ್ನ ಧ್ವನಿಯನ್ನು ಕೇಳಿದರು;</para>
  <para style="q2" vid="PSA 18:6">ನನ್ನ ಮೊರೆಯು ಅವರ ಸನ್ನಿಧಿ ಸೇರಿ ಅವರ ಕಿವಿಗೆ ಬಿತ್ತು.<verse eid="PSA 18:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 18:7"/>ದೇವರು ಬೇಸರಗೊಂಡಿದ್ದರಿಂದ</para>
  <para style="q2" vid="PSA 18:7">ಭೂಮಿಯು ನಡುಗಿ ಕದಲಿದವು;</para>
  <para style="q2" vid="PSA 18:7">ಪರ್ವತಗಳ ಅಸ್ತಿವಾರಗಳು ಸಹ ಕದಲಿದವು.<verse eid="PSA 18:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 18:8"/>ಮೂಗಿನಿಂದ ಹೊಗೆ ಬಂದಂತೆಯೂ</para>
  <para style="q2" vid="PSA 18:8">ಬಾಯಿಯೊಳಗಿಂದ ದಹಿಸುವ ಅಗ್ನಿ ಹೊರಟಂತೆಯೂ;</para>
  <para style="q2" vid="PSA 18:8">ಕೆಂಡಗಳು ಅದರಿಂದ ಜ್ವಾಲಿಸಿದಂತೆಯೂ ಇರಲು,<verse eid="PSA 18:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 18:9"/>ದೇವರು ಆಕಾಶಗಳನ್ನು ಬಾಗಿಸಿ ಕೆಳಗಿಳಿದು ಬಂದರು;</para>
  <para style="q2" vid="PSA 18:9">ಅವರ ಪಾದಗಳ ಕೆಳಗೆ ಕಾರ್ಮೋಡಗಳಿದ್ದವು.<verse eid="PSA 18:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 18:10"/>ಅವರು ಕೆರೂಬಿಯ<note caller="+" style="f"><char style="fr" closed="false">18:10 </char><char style="fq" closed="false">ಕೆರೂಬಿ </char><char style="ft" closed="false">ಒಂದು ವಿಧವಾದ </char><char style="fqa" closed="false">ದೇವದೂತರು</char></note> ಮೇಲೆ ಕೂತು ಹಾರಿದರು,</para>
  <para style="q2" vid="PSA 18:10">ಗಾಳಿಯ ರೆಕ್ಕೆಗಳ ಮೇಲೆ ಕಾಣಿಸಿಕೊಂಡರು.<verse eid="PSA 18:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 18:11"/>ಅವರು ಕತ್ತಲನ್ನು ತಮ್ಮ ಹೊದಿಕೆಯನ್ನಾಗಿಯೂ</para>
  <para style="q2" vid="PSA 18:11">ಮಳೆ ತರುವ ಆಕಾಶದ ಕಾರ್ಮೋಡಗಳನ್ನು</para>
  <para style="q2" vid="PSA 18:11">ತಮ್ಮ ಸುತ್ತಲಿನ ಪರದೆಯನ್ನಾಗಿಯೂ ಮಾಡಿಕೊಂಡರು.<verse eid="PSA 18:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 18:12"/>ಅವರ ಸನ್ನಿಧಿಯ ಪ್ರಕಾಶದಿಂದ ಮೋಡಗಳು,</para>
  <para style="q2" vid="PSA 18:12">ಕಲ್ಮಳೆ ಹಾಗೂ ಗುಡುಗು ಮಿಂಚುಗಳು ಹೊರಹೊಮ್ಮಿದವು.<verse eid="PSA 18:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 18:13"/>ಯೆಹೋವ ದೇವರು ಆಕಾಶಗಳಲ್ಲಿ ಗುಡುಗಿದರು;</para>
  <para style="q2" vid="PSA 18:13">ಮಹೋನ್ನತ ದೇವರ ಧ್ವನಿಯು ಕಲ್ಮಳೆ ಹಾಗೂ ಮಿಂಚುಗಳಿಂದ<note caller="+" style="f"><char style="fr" closed="false">18:13 </char><char style="ft" closed="false">ಕೆಲವು ಪ್ರತಿಗಳಲ್ಲಿ </char><char style="fqa" closed="false">ಕಲ್ಮಳೆ ಹಾಗೂ ಮಿಂಚುಗಳಿಂದ </char><char style="ft" closed="false">ಎಂದು ಈ ವಾಕ್ಯದಲ್ಲಿ ಇಲ್ಲ.</char></note> ಪ್ರತಿಧ್ವನಿಸಿತು.<verse eid="PSA 18:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 18:14"/>ಅವರು ತಮ್ಮ ಬಾಣಗಳನ್ನು ಎಸೆದು ವೈರಿಗಳನ್ನು ಚದರಿಸಿದರು;</para>
  <para style="q2" vid="PSA 18:14">ಸಿಡಿಲಿನಿಂದ ವೈರಿಗಳನ್ನೆಲ್ಲ ಅಟ್ಟಿಸಿಬಿಟ್ಟರು.<verse eid="PSA 18:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 18:15"/>ಯೆಹೋವ ದೇವರೇ, ನಿಮ್ಮ ಗದರಿಕೆಯಿಂದಲೂ,</para>
  <para style="q2" vid="PSA 18:15">ನಿಮ್ಮ ಮೂಗಿನ ಶ್ವಾಸದ ಗಾಳಿಯಿಂದಲೂ</para>
  <para style="q1" vid="PSA 18:15">ಸಮುದ್ರದ ತಳವು ಕಾಣಿಸಿದವು,</para>
  <para style="q2" vid="PSA 18:15">ಭೂಲೋಕದ ಅಸ್ತಿವಾರಗಳು ಬಯಲಾದವು.<verse eid="PSA 18:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 18:16"/>ಅವರು ಮೇಲಿನಿಂದ ಕೈಚಾಚಿ ನನ್ನನ್ನು ಹಿಡಿದು</para>
  <para style="q2" vid="PSA 18:16">ಅಗಾಧವಾದ ಜಲರಾಶಿಗಳಿಂದ ಹೊರಗೆಳೆದರು.<verse eid="PSA 18:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 18:17"/>ಅವರು ನನಗಿಂತ ಶಕ್ತಿಶಾಲಿಯಾದ ಶತ್ರುಗಳಿಂದ,</para>
  <para style="q2" vid="PSA 18:17">ದ್ವೇಷಿಸುತ್ತಿದ್ದ ವೈರಿಗಳಿಂದ ನನ್ನನ್ನು ಬಿಡಿಸಿ ರಕ್ಷಿಸಿದರು.<verse eid="PSA 18:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 18:18"/>ನನ್ನ ಆಪತ್ತಿನ ದಿನದಲ್ಲಿ ನನ್ನನ್ನು ಆ ಶತ್ರುಗಳು ದಾಳಿಮಾಡಿದರು;</para>
  <para style="q2" vid="PSA 18:18">ಆದರೆ ಯೆಹೋವ ದೇವರು ನನಗೆ ಆಧಾರವಾಗಿದ್ದರು.<verse eid="PSA 18:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 18:19"/>ದೇವರು ನನ್ನನ್ನು ಹೊರಗೆ ವಿಶಾಲ ಸ್ಥಳಕ್ಕೆ ತಂದರು;</para>
  <para style="q2" vid="PSA 18:19">ನನ್ನಲ್ಲಿ ಸಂತೋಷಪಟ್ಟದ್ದರಿಂದ ನನ್ನನ್ನು ಕಾಪಾಡಿದರು.<verse eid="PSA 18:19"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 18:20"/>ಯೆಹೋವ ದೇವರು ನನ್ನ ನೀತಿಯ ಪ್ರಕಾರ ನನ್ನೊಂದಿಗೆ ವ್ಯವಹರಿಸಿದರು;</para>
  <para style="q2" vid="PSA 18:20">ನನ್ನ ಕೈಗಳ ಶುದ್ಧತ್ವದ ಪ್ರಕಾರ ನನಗೆ ಪ್ರತಿಫಲಕೊಟ್ಟರು.<verse eid="PSA 18:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 18:21"/>ಏಕೆಂದರೆ ನಾನು ಯೆಹೋವ ದೇವರ ಮಾರ್ಗಗಳನ್ನು ಕೈಗೊಂಡೆನು;</para>
  <para style="q2" vid="PSA 18:21">ನನ್ನ ದೇವರನ್ನು ಬಿಟ್ಟುಹೋಗುವ ದುಷ್ಟತ್ವವನ್ನು ನಾನು ಮಾಡಲಿಲ್ಲ.<verse eid="PSA 18:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 18:22"/>ದೇವರ ಆಜ್ಞೆಗಳೆಲ್ಲಾ ನನ್ನ ಮುಂದೆ ಇಟ್ಟುಕೊಂಡೆನು;</para>
  <para style="q2" vid="PSA 18:22">ಅವರ ತೀರ್ಪುಗಳಿಂದ ನಾನು ತೊಲಗಿಹೋಗಲಿಲ್ಲ.<verse eid="PSA 18:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 18:23"/>ನಾನು ಅವರ ದೃಷ್ಟಿಯಲ್ಲಿ ನಿರ್ದೋಷಿಯು</para>
  <para style="q2" vid="PSA 18:23">ನಾನು ಪಾಪದಿಂದ ನನ್ನನ್ನು ಕಾಪಾಡಿಕೊಂಡೆನು.<verse eid="PSA 18:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 18:24"/>ಆದ್ದರಿಂದ ಯೆಹೋವ ದೇವರು ನನ್ನ ನೀತಿಯ ಪ್ರಕಾರವೂ</para>
  <para style="q2" vid="PSA 18:24">ಅವರ ದೃಷ್ಟಿಯಲ್ಲಿ ನನ್ನ ಕೈಗಳ ಶುದ್ಧತ್ವದ ಪ್ರಕಾರವೂ ನನಗೆ ಪ್ರತಿಫಲಕೊಟ್ಟರು.<verse eid="PSA 18:24"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 18:25"/>ದಯವಂತರಿಗೆ ನೀವು ನಿಮ್ಮನ್ನು ದಯವಂತರಾಗಿ ತೋರಿಸುತ್ತೀರಿ.</para>
  <para style="q2" vid="PSA 18:25">ನಿರ್ದೋಷಿಗೆ ನೀವು ನಿರ್ದೋಷಿಯಾಗಿ ತೋರಿಸುತ್ತೀರಿ.<verse eid="PSA 18:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 18:26"/>ಶುದ್ಧರಿಗೆ ನೀವು ಶುದ್ಧರಾಗಿ ತೋರಿಸುತ್ತೀರಿ.</para>
  <para style="q2" vid="PSA 18:26">ವಕ್ರ ವ್ಯಕ್ತಿಗೆ ನಿಮ್ಮ ಬುದ್ಧಿವಂತಿಕೆಯನ್ನು ತೋರಿಸುತ್ತೀರಿ.<verse eid="PSA 18:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 18:27"/>ದೀನರನ್ನು ರಕ್ಷಿಸುತ್ತೀರಿ,</para>
  <para style="q2" vid="PSA 18:27">ಆದರೆ ನೀವು ಗರ್ವಿಷ್ಠರ ಕಣ್ಣುಗಳನ್ನು ತಗ್ಗಿಸುತ್ತೀರಿ.<verse eid="PSA 18:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 18:28"/>ಯೆಹೋವ ದೇವರೇ, ನೀವು ನನ್ನ ದೀಪವನ್ನು ಬೆಳಗಿಸಿರಿ.</para>
  <para style="q2" vid="PSA 18:28">ನನ್ನ ದೇವರು ನನ್ನ ಕತ್ತಲೆಯನ್ನು ಬೆಳಕನ್ನಾಗಿ ಮಾರ್ಪಡಿಸುವರು.<verse eid="PSA 18:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="PSA 18:29"/>ನಿಮ್ಮ ಸಹಾಯದಿಂದ ವೈರಿಸೇನೆಯ ವಿರುದ್ಧ ಹೋಗುವೆನು,</para>
  <para style="q2" vid="PSA 18:29">ನನ್ನ ದೇವರೊಂದಿಗೆ ಕೋಟೆಗೋಡೆಯನ್ನೂ ಹಾರುವೆನು.<verse eid="PSA 18:29"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="30" style="v" sid="PSA 18:30"/>ದೇವರ ಮಾರ್ಗವು ಪರಿಪೂರ್ಣವಾದದ್ದು,</para>
  <para style="q2" vid="PSA 18:30">ಯೆಹೋವ ದೇವರ ವಾಕ್ಯವು ದೋಷವಿಲ್ಲದ್ದು;</para>
  <para style="q2" vid="PSA 18:30">ತಮ್ಮಲ್ಲಿ ಆಶ್ರಯ ಹೊಂದಿದ ಎಲ್ಲರಿಗೂ ಅವರು ಗುರಾಣಿಯಾಗಿದ್ದಾರೆ.<verse eid="PSA 18:30"/></para>
  <para style="q1">
    <verse number="31" style="v" sid="PSA 18:31"/>ಏಕೆಂದರೆ ಯೆಹೋವ ದೇವರಲ್ಲದೆ ಬೇರೆ ದೇವರು ಯಾರು?</para>
  <para style="q2" vid="PSA 18:31">ಮತ್ತು ನಮ್ಮ ದೇವರನ್ನು ಹೊರತುಪಡಿಸಿ ರಕ್ಷಕ<note caller="+" style="f"><char style="fr" closed="false">18:31 </char><char style="fq" closed="false">ರಕ್ಷಕ </char><char style="ft" closed="false">ಹೀಬ್ರೂ ಭಾಷೆಯಲ್ಲಿ </char><char style="fqa" closed="false">ಬಂಡೆ</char></note> ಯಾರು?<verse eid="PSA 18:31"/></para>
  <para style="q1">
    <verse number="32" style="v" sid="PSA 18:32"/>ಬಲದಿಂದ ನನಗೆ ಆಯುಧವನ್ನು ಧರಿಸುವಂತೆ ಮಾಡಿ,</para>
  <para style="q2" vid="PSA 18:32">ನನ್ನ ಮಾರ್ಗವನ್ನು ಸುರಕ್ಷಿತಗೊಳಿಸುವ ದೇವರು ಅವರೇ.<verse eid="PSA 18:32"/></para>
  <para style="q1">
    <verse number="33" style="v" sid="PSA 18:33"/>ನನ್ನ ಕಾಲುಗಳನ್ನು ಜಿಂಕೆಗಳ ಕಾಲುಗಳಂತೆ ಚುರುಕು ಮಾಡಿ,</para>
  <para style="q2" vid="PSA 18:33">ಅವರು ನನ್ನನ್ನು ಉನ್ನತ ಸ್ಥಳಗಳ ಮೇಲೆ ನಿಲ್ಲಿಸುತ್ತಾರೆ.<verse eid="PSA 18:33"/></para>
  <para style="q1">
    <verse number="34" style="v" sid="PSA 18:34"/>ಅವರು ಯುದ್ಧಕ್ಕಾಗಿ ನನ್ನ ಕೈಗಳಿಗೆ ತರಬೇತುಕೊಟ್ಟು,</para>
  <para style="q2" vid="PSA 18:34">ನನ್ನ ಭುಜದಿಂದ ಕಂಚಿನ ಬಿಲ್ಲನ್ನು ಬಗ್ಗಿಸುವಂತೆ ಮಾಡುತ್ತಾರೆ.<verse eid="PSA 18:34"/></para>
  <para style="q1">
    <verse number="35" style="v" sid="PSA 18:35"/>ನಿಮ್ಮ ರಕ್ಷಣೆಯ ಸಹಾಯವನ್ನು ನನಗೆ ಗುರಾಣಿಯನ್ನಾಗಿ ಮಾಡಿದ್ದೀರಿ.</para>
  <para style="q2" vid="PSA 18:35">ನಿಮ್ಮ ಬಲಗೈ ನನಗೆ ಆಧಾರವಾಗಿದೆ;</para>
  <para style="q2" vid="PSA 18:35">ನಿಮ್ಮ ಸಹಾಯವು ನನ್ನನ್ನು ಘನವಂತನನ್ನಾಗಿ ಮಾಡಿದೆ.<verse eid="PSA 18:35"/></para>
  <para style="q1">
    <verse number="36" style="v" sid="PSA 18:36"/>ನೀವು ನನ್ನ ಕಾಲಡಿಗಳಿಗೆ ವಿಶಾಲಸ್ಥಳ ಒದಗಿಸಿದ್ದೀರಿ,</para>
  <para style="q2" vid="PSA 18:36">ಆದುದರಿಂದ ನನ್ನ ಹಿಮ್ಮಡಿಗಳು ಜಾರುವುದಿಲ್ಲ.<verse eid="PSA 18:36"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="37" style="v" sid="PSA 18:37"/>ನನ್ನ ಶತ್ರುಗಳನ್ನು ಹಿಂದಟ್ಟಿ ಹಿಡಿದಿದ್ದೇನೆ;</para>
  <para style="q2" vid="PSA 18:37">ಅವರನ್ನು ಸಂಹರಿಸಿಬಿಡುವವರೆಗೂ ನಾನು ಹಿಂದಿರುಗಲಿಲ್ಲ.<verse eid="PSA 18:37"/></para>
  <para style="q1">
    <verse number="38" style="v" sid="PSA 18:38"/>ಏಳಲಾರದಂತೆ ಅವರನ್ನು ತುಳಿದುಬಿಟ್ಟೆನು;</para>
  <para style="q2" vid="PSA 18:38">ಅವರು ನನ್ನ ಪಾದಗಳ ಕೆಳಗೆ ಬಿದ್ದರು.<verse eid="PSA 18:38"/></para>
  <para style="q1">
    <verse number="39" style="v" sid="PSA 18:39"/>ನೀವು ಯುದ್ಧಕ್ಕಾಗಿ ನನಗೆ ಬಲವನ್ನು</para>
  <para style="q2" vid="PSA 18:39">ಆಯುಧವನ್ನಾಗಿ ನೀಡಿ, ನನ್ನ ಎದುರಾಳಿಗಳನ್ನು ನನಗೆ ಅಧೀನ ಮಾಡಿದ್ದೀರಿ.<verse eid="PSA 18:39"/></para>
  <para style="q1">
    <verse number="40" style="v" sid="PSA 18:40"/>ನನ್ನ ಶತ್ರುಗಳು ನನಗೆ ಬೆನ್ನುಮಾಡಿ ಓಡಿಹೋಗುವಂತೆ ಮಾಡಿದಿರಿ;</para>
  <para style="q2" vid="PSA 18:40">ನಾನು ನನ್ನ ವೈರಿಗಳನ್ನು ಸಂಹರಿಸಿದೆನು.<verse eid="PSA 18:40"/></para>
  <para style="q1">
    <verse number="41" style="v" sid="PSA 18:41"/>ಅವರು ಸಹಾಯಕ್ಕಾಗಿ ಮೊರೆಯಿಟ್ಟರು,</para>
  <para style="q2" vid="PSA 18:41">ಆದರೆ ರಕ್ಷಿಸುವವರು ಯಾರೂ ಇರಲಿಲ್ಲ</para>
  <para style="q1" vid="PSA 18:41">ಯೆಹೋವ ದೇವರಿಗೂ ಮೊರೆಯಿಟ್ಟರು,</para>
  <para style="q2" vid="PSA 18:41">ಆದರೆ ಅವರೂ ಉತ್ತರ ಕೊಡಲಿಲ್ಲ.<verse eid="PSA 18:41"/></para>
  <para style="q1">
    <verse number="42" style="v" sid="PSA 18:42"/>ಅವರನ್ನು ಗಾಳಿಯಿಂದ ಬಡಿಸಿಕೊಂಡು ಹೋಗುವ ಧೂಳಿನಂತೆ ಪುಡಿಪುಡಿ ಮಾಡಿದೆನು;</para>
  <para style="q2" vid="PSA 18:42">ಬೀದಿಯಲ್ಲಿನ ಕೆಸರು ಎಂಬಂತೆ ತುಳಿದು ಎಸೆದುಬಿಟ್ಟೆನು.<verse eid="PSA 18:42"/></para>
  <para style="q1">
    <verse number="43" style="v" sid="PSA 18:43"/>ನೀವು ನನ್ನ ಜನರ ಒಳಕಲಹದಿಂದ ನನ್ನನ್ನು ತಪ್ಪಿಸಿದ್ದೀರಿ;</para>
  <para style="q2" vid="PSA 18:43">ನನ್ನನ್ನು ಜನಾಂಗಗಳಿಗೆ ನಾಯಕನನ್ನಾಗಿ ಮಾಡಿರುವಿರಿ.</para>
  <para style="q1" vid="PSA 18:43">ನಾನು ಅರಿಯದ ಜನರು ನನಗೆ ವಿಧೇಯರಾಗುವರು.<verse eid="PSA 18:43"/></para>
  <para style="q2">
    <verse number="44" style="v" sid="PSA 18:44"/>ವಿದೇಶಿಯರು ನನಗೆ ಅಧೀನರಾದರು;</para>
  <para style="q2" vid="PSA 18:44">ನನ್ನ ಸುದ್ದಿ ಕೇಳಿದ ಕೂಡಲೇ ನನಗೆ ವಿಧೇಯರಾಗುವರು.<verse eid="PSA 18:44"/></para>
  <para style="q1">
    <verse number="45" style="v" sid="PSA 18:45"/>ಅವರು ಭಯಗೊಳ್ಳುವರು;</para>
  <para style="q2" vid="PSA 18:45">ನಡುಗುತ್ತಾ ತಮ್ಮ ಕೋಟೆಗಳಿಂದ ಹೊರಬರುವರು.<verse eid="PSA 18:45"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="46" style="v" sid="PSA 18:46"/>ಯೆಹೋವ ದೇವರು ಜೀವಿಸುವ ದೇವರು! ನನ್ನ ಆಶ್ರಯವಾಗಿರುವ ದೇವರಿಗೆ ಸ್ತೋತ್ರವಾಗಲಿ.</para>
  <para style="q2" vid="PSA 18:46">ನನ್ನ ರಕ್ಷಕರಾದ ದೇವರು ಮಹಿಮೆ ಹೊಂದಲಿ.<verse eid="PSA 18:46"/></para>
  <para style="q1">
    <verse number="47" style="v" sid="PSA 18:47"/>ದೇವರೇ ನನಗೋಸ್ಕರ ಮುಯ್ಯಿಗೆ ಮುಯ್ಯಿ ತೀರಿಸುವವರೂ</para>
  <para style="q2" vid="PSA 18:47">ಜನರನ್ನು ನನಗೆ ಅಧೀನಪಡಿಸುವವರೂ ಆಗಿದ್ದಾರೆ.<verse eid="PSA 18:47"/></para>
  <para style="q2">
    <verse number="48" style="v" sid="PSA 18:48"/>ದೇವರು ನನ್ನ ಶತ್ರುಗಳಿಂದ ನನ್ನನ್ನು ಬಿಡಿಸುತ್ತಾರೆ;</para>
  <para style="q1" vid="PSA 18:48">ನೀವು ನನ್ನ ಎದುರಾಳಿಗಳಿಂದ ನನ್ನನ್ನು ತಪ್ಪಿಸಿ ಗೌರವಿಸುತ್ತೀರಿ,</para>
  <para style="q2" vid="PSA 18:48">ಬಲಾತ್ಕಾರ ಮಾಡುವವನಿಂದ ನನ್ನನ್ನು ರಕ್ಷಿಸುತ್ತೀರಿ.<verse eid="PSA 18:48"/></para>
  <para style="q1">
    <verse number="49" style="v" sid="PSA 18:49"/>ಆದ್ದರಿಂದ ಯೆಹೋವ ದೇವರೇ, ನಾನು ಜನಾಂಗಗಳಲ್ಲಿ ನಿಮ್ಮನ್ನು ಕೊಂಡಾಡುವೆನು,</para>
  <para style="q2" vid="PSA 18:49">ನಿಮ್ಮನ್ನು ಕೊಂಡಾಡಿ ನಿಮ್ಮ ಹೆಸರನ್ನು ಕೀರ್ತಿಸುವೆನು.<verse eid="PSA 18:49"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="50" style="v" sid="PSA 18:50"/>ದೇವರು ತಮ್ಮ ಅರಸನಿಗೆ ವಿಶೇಷ ರಕ್ಷಣೆಯನ್ನು ಕೊಡುವರು;</para>
  <para style="q2" vid="PSA 18:50">ತಮ್ಮ ಅಭಿಷಿಕ್ತನಿಗೂ ದಾವೀದನಿಗೂ ಅವನ ಸಂತತಿಯವರಿಗೂ</para>
  <para style="q2" vid="PSA 18:50">ಒಡಂಬಡಿಕೆಯ ಪ್ರೀತಿಯನ್ನು ಯುಗಯುಗಕ್ಕೂ ಅನುಗ್ರಹಿಸುವರು.<verse eid="PSA 18:50"/></para>
  <chapter eid="PSA 18"/>
  <chapter number="19" style="c" sid="PSA 19"/>
  <para style="cl">ಕೀರ್ತನೆ 19</para>
  <para style="d">ಸಂಗೀತ ನಿರ್ದೇಶಕನಿಗಾಗಿರುವ ಕೀರ್ತನೆ. ದಾವೀದನ ಕೀರ್ತನೆ.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 19:1"/>ಆಕಾಶವು ದೇವರ ಮಹಿಮೆಯನ್ನು ಸಾರುತ್ತದೆ;</para>
  <para style="q2" vid="PSA 19:1">ಅಂತರಿಕ್ಷವು ಅವರ ಕೈಕೆಲಸವನ್ನು ಘೋಷಿಸುತ್ತದೆ.<verse eid="PSA 19:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 19:2"/>ಹಗಲೆಲ್ಲಾ ಅವು ಮಾತನಾಡುತ್ತವೆ;</para>
  <para style="q2" vid="PSA 19:2">ರಾತ್ರಿಯೆಲ್ಲಾ ಅವು ಅರಿವನ್ನು ಪ್ರಕಟಿಸುತ್ತವೆ.<verse eid="PSA 19:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 19:3"/>ಅವುಗಳಿಗೆ ಮಾತೂ ಇಲ್ಲ, ಪದವೂ ಇಲ್ಲ,</para>
  <para style="q2" vid="PSA 19:3">ಅವುಗಳ ಸ್ವರವು ಕೇಳುವುದೂ ಇಲ್ಲ.<verse eid="PSA 19:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 19:4"/>ಅವುಗಳ ಧ್ವನಿ ಭೂಲೋಕವೆಲ್ಲಾ ಹರಡಿವೆ;</para>
  <para style="q2" vid="PSA 19:4">ಅವುಗಳ ಮಾತುಗಳೋ ಲೋಕದ ಕಟ್ಟಕಡೆಯವರೆಗೂ ಹೋಗುತ್ತವೆ;</para>
  <para style="q1" vid="PSA 19:4">ಆಕಾಶದಲ್ಲಿ ದೇವರು ಸೂರ್ಯನಿಗೆ ಗುಡಾರ ಹಾಕಿದ್ದಾರೆ.<verse eid="PSA 19:4"/></para>
  <para style="q2">
    <verse number="5" style="v" sid="PSA 19:5"/>ಸೂರ್ಯನು ಮದುಮಗನಂತೆ ತನ್ನ ಕೊಠಡಿಯಿಂದ ಹೊರಟುಬಂದು,</para>
  <para style="q2" vid="PSA 19:5">ಪಂದ್ಯಕ್ಕೆ ಹರ್ಷದಿಂದ ಓಡುವ ಪರಾಕ್ರಮಶಾಲಿಯಂತೆ ಇದ್ದಾನೆ.<verse eid="PSA 19:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 19:6"/>ಆಕಾಶದ ಒಂದು ಕಡೆಯಿಂದ ಉದಯಿಸಿ</para>
  <para style="q2" vid="PSA 19:6">ಮತ್ತೊಂದು ಕಡೆಯವರೆಗೆ ಹೊರಟು ಪ್ರಯಾಣಿಸುತ್ತಾನೆ;</para>
  <para style="q2" vid="PSA 19:6">ಅದರ ಬಿಸಿಲಿಗೆ ಮರೆಯಾದದ್ದು ಒಂದೂ ಇಲ್ಲ.<verse eid="PSA 19:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 19:7"/>ಯೆಹೋವ ದೇವರ ನಿಯಮವು ಸಂಪೂರ್ಣವಾಗಿದ್ದು,</para>
  <para style="q2" vid="PSA 19:7">ಪ್ರಾಣಕ್ಕೆ ಜೀವಕರವಾಗಿದೆ;</para>
  <para style="q1" vid="PSA 19:7">ಯೆಹೋವ ದೇವರ ಶಾಸನಗಳು ವಿಶ್ವಾಸಪಾತ್ರವಾಗಿದ್ದು,</para>
  <para style="q2" vid="PSA 19:7">ಮುಗ್ಧನನ್ನು ಜ್ಞಾನಿಗಳನ್ನಾಗಿ ಮಾಡುತ್ತವೆ.<verse eid="PSA 19:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 19:8"/>ಯೆಹೋವ ದೇವರ ಸೂತ್ರಗಳು ನೀತಿಯುಳ್ಳವುಗಳಾಗಿದ್ದು</para>
  <para style="q2" vid="PSA 19:8">ಅವು ಹೃದಯಕ್ಕೆ ಆನಂದಕರವಾಗಿವೆ;</para>
  <para style="q1" vid="PSA 19:8">ಯೆಹೋವ ದೇವರ ಆಜ್ಞೆಗಳು ಸ್ಪಷ್ಟವಾಗಿದ್ದು,</para>
  <para style="q2" vid="PSA 19:8">ಕಣ್ಣುಗಳಿಗೆ ಪ್ರಕಾಶಕರವಾಗಿವೆ.<verse eid="PSA 19:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 19:9"/>ಯೆಹೋವ ದೇವರ ಭಯವು ಶುದ್ಧವಾಗಿದ್ದು,</para>
  <para style="q2" vid="PSA 19:9">ಎಂದೆಂದಿಗೂ ಶಾಶ್ವತವಾಗಿದೆ.</para>
  <para style="q1" vid="PSA 19:9">ಯೆಹೋವ ದೇವರ ತೀರ್ಪುಗಳು ಸತ್ಯವಾಗಿದ್ದು,</para>
  <para style="q2" vid="PSA 19:9">ಅವೆಲ್ಲವೂ ನೀತಿಯುಳ್ಳದ್ದಾಗಿವೆ.<verse eid="PSA 19:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 19:10"/>ಅವು ಬಂಗಾರಕ್ಕಿಂತಲೂ,</para>
  <para style="q2" vid="PSA 19:10">ಅಪರಂಜಿಗಿಂತಲೂ ಅಮೂಲ್ಯವಾಗಿವೆ;</para>
  <para style="q1" vid="PSA 19:10">ಅವು ಜೇನಿಗಿಂತಲೂ,</para>
  <para style="q2" vid="PSA 19:10">ಅಪ್ಪಟ ಜೇನುತುಪ್ಪಕ್ಕಿಂತಲೂ ಸಿಹಿಯಾಗಿವೆ.<verse eid="PSA 19:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 19:11"/>ನಿಮ್ಮ ಸೇವಕನು ಅವುಗಳಿಂದ ಎಚ್ಚರಿಕೆ ಪಡೆಯುತ್ತಾನೆ;</para>
  <para style="q2" vid="PSA 19:11">ಅವುಗಳನ್ನು ಕೈಗೊಳ್ಳುವುದರಲ್ಲಿ ದೊಡ್ಡ ಪ್ರತಿಫಲವುಂಟು.<verse eid="PSA 19:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 19:12"/>ತಮ್ಮ ತಪ್ಪುಗಳನ್ನು ತಿಳಿದುಕೊಳ್ಳಲು ಯಾರಿಗೆ ಸಾಧ್ಯ?</para>
  <para style="q2" vid="PSA 19:12">ನನ್ನ ಗುಪ್ತ ಪಾಪಗಳನ್ನು ಕ್ಷಮಿಸು.<verse eid="PSA 19:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 19:13"/>ಬೇಕುಬೇಕೆಂದು ಪಾಪಮಾಡದಂತೆ ನಿಮ್ಮ ಸೇವಕನನ್ನು ಕಾಪಾಡು;</para>
  <para style="q2" vid="PSA 19:13">ಅಂಥ ಪಾಪಗಳು ನನ್ನ ಮೇಲೆ ಆಳಿಕೆ ಮಾಡದಿರಲಿ.</para>
  <para style="q1" vid="PSA 19:13">ಆಗ ನಾನು ತಪ್ಪಿಲ್ಲದವನಾಗಿ,</para>
  <para style="q2" vid="PSA 19:13">ಮಹಾಪರಾಧದಿಂದ ಬಿಡುಗಡೆಯಾಗಿರುವೆನು.<verse eid="PSA 19:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 19:14"/>ಯೆಹೋವ ದೇವರೇ, ನನ್ನ ಬಂಡೆಯೇ, ನನ್ನ ವಿಮೋಚಕರೇ,</para>
  <para style="q2" vid="PSA 19:14">ನನ್ನ ಬಾಯಿಯ ಮಾತುಗಳೂ ನನ್ನ ಹೃದಯದ ಧ್ಯಾನವೂ</para>
  <para style="q2" vid="PSA 19:14">ನಿಮ್ಮ ದೃಷ್ಟಿಯಲ್ಲಿ ಮೆಚ್ಚಿಕೆಯಾಗಿರಲಿ.<verse eid="PSA 19:14"/></para>
  <chapter eid="PSA 19"/>
  <chapter number="20" style="c" sid="PSA 20"/>
  <para style="cl">ಕೀರ್ತನೆ 20</para>
  <para style="d">ಸಂಗೀತ ನಿರ್ದೇಶಕನಿಗಾಗಿರುವ ಕೀರ್ತನೆ. ದಾವೀದನ ಕೀರ್ತನೆ.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 20:1"/>ಯೆಹೋವ ದೇವರು ಇಕ್ಕಟ್ಟಿನಲ್ಲಿ ನಿಮಗೆ ಉತ್ತರವನ್ನು ನೀಡಲಿ;</para>
  <para style="q2" vid="PSA 20:1">ಯಾಕೋಬನ ದೇವರ ಹೆಸರು ನಿಮ್ಮನ್ನು ಕಾಪಾಡಲಿ.<verse eid="PSA 20:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 20:2"/>ದೇವರು ಪರಿಶುದ್ಧ ಸ್ಥಳದೊಳಗಿಂದ ನಿಮಗೆ ಸಹಾಯ ಕಳುಹಿಸಲಿ;</para>
  <para style="q2" vid="PSA 20:2">ಅವರು ಚೀಯೋನಿನಿಂದ ನಿಮಗೆ ಆಧಾರ ನೀಡಲಿ.<verse eid="PSA 20:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 20:3"/>ನಿಮ್ಮ ಯಜ್ಞಾರ್ಪಣೆಗಳನ್ನೆಲ್ಲಾ ಜ್ಞಾಪಕಮಾಡಿಕೊಂಡು,</para>
  <para style="q2" vid="PSA 20:3">ನಿಮ್ಮ ದಹನಬಲಿಗಳನ್ನು ಸ್ವೀಕರಿಸಲಿ.<verse eid="PSA 20:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 20:4"/>ದೇವರು ನಿಮ್ಮ ಹೃದಯದ ಬಯಕೆಯನ್ನು ನಿಮಗೆ ದಯಪಾಲಿಸಲಿ;</para>
  <para style="q2" vid="PSA 20:4">ನಿಮ್ಮ ಎಲ್ಲಾ ಯೋಜನೆಗಳಲ್ಲಿಯೂ ಯಶಸ್ಸನ್ನು ನೀಡಲಿ.<verse eid="PSA 20:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 20:5"/>ನಾವು ದೇವರ ಜಯದಲ್ಲಿ ಆನಂದ ಘೋಷಮಾಡಿ,</para>
  <para style="q2" vid="PSA 20:5">ನಮ್ಮ ದೇವರ ಹೆಸರಿನಲ್ಲಿಯೇ ನಾವು ನಮ್ಮ ಧ್ವಜಗಳನ್ನು ಎತ್ತುವೆವು.</para>
  <para style="b" vid="PSA 20:5"/>
  <para style="q1" vid="PSA 20:5">ಯೆಹೋವ ದೇವರು ನಿಮ್ಮ ಬಿನ್ನಹಗಳನ್ನೆಲ್ಲಾ ಪೂರೈಸಲಿ.<verse eid="PSA 20:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 20:6"/>ಈಗ ನಾನು ಇದನ್ನು ಬಲ್ಲೆನು:</para>
  <para style="q2" vid="PSA 20:6">ಯೆಹೋವ ದೇವರು ತಮ್ಮ ಅಭಿಷಿಕ್ತನಿಗೆ ಜಯ ನೀಡುವರು.</para>
  <para style="q1" vid="PSA 20:6">ತಮ್ಮ ಜಯದ ಬಲಗೈಯ ಶಕ್ತಿಯಿಂದಲೂ</para>
  <para style="q2" vid="PSA 20:6">ತಮ್ಮ ಪರಿಶುದ್ಧ ಪರಲೋಕದಿಂದಲೂ ಅವನಿಗೆ ಉತ್ತರಕೊಡುವರು.<verse eid="PSA 20:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 20:7"/>ಕೆಲವರು ರಥಗಳಲ್ಲಿಯೂ ಕೆಲವರು ಕುದುರೆಗಳಲ್ಲಿಯೂ ಭರವಸೆಯಿಡುತ್ತಾರೆ;</para>
  <para style="q2" vid="PSA 20:7">ನಾವಾದರೋ ನಮ್ಮ ಯೆಹೋವ ದೇವರ ಹೆಸರಿನಲ್ಲಿ ಭರವಸೆಯನ್ನಿಡುತ್ತೇವೆ.<verse eid="PSA 20:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 20:8"/>ಅವರು ಬಗ್ಗಿ ಬೀಳುತ್ತಾರೆ,</para>
  <para style="q2" vid="PSA 20:8">ನಾವಾದರೋ ಎದ್ದು ಸ್ಥಿರವಾಗಿ ನಿಲ್ಲುವೆವು.<verse eid="PSA 20:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 20:9"/>ಯೆಹೋವ ದೇವರೇ, ಅರಸನಿಗೆ ಜಯಕೊಡಿರಿ!</para>
  <para style="q2" vid="PSA 20:9">ನಾವು ಕರೆಯುವಾಗ ನಮಗೆ ಉತ್ತರಕೊಡಿರಿ!<verse eid="PSA 20:9"/></para>
  <chapter eid="PSA 20"/>
  <chapter number="21" style="c" sid="PSA 21"/>
  <para style="cl">ಕೀರ್ತನೆ 21</para>
  <para style="d">ಸಂಗೀತ ನಿರ್ದೇಶಕನಿಗಾಗಿರುವ ಕೀರ್ತನೆ. ದಾವೀದನ ಕೀರ್ತನೆ.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 21:1"/>ಯೆಹೋವ ದೇವರೇ, ನಿಮ್ಮ ಬಲದಲ್ಲಿ ಅರಸನು ಆನಂದಿಸುತ್ತಾನೆ;</para>
  <para style="q2" vid="PSA 21:1">ನೀವು ಆತನಿಗೆ ಕೊಡುವ ಜಯಗಳಲ್ಲಿ ಎಷ್ಟೋ ಅಧಿಕವಾಗಿ ಉಲ್ಲಾಸಪಡುತ್ತಾನೆ!<verse eid="PSA 21:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 21:2"/>ಅರಸನ ಹೃದಯದ ಆಶೆಯನ್ನು ನೀವು ಈಡೇರಿಸಿದ್ದೀರಿ;</para>
  <para style="q2" vid="PSA 21:2">ಆತನ ತುಟಿಗಳ ಬಿನ್ನಹವನ್ನು ಹಿಂದಿಟ್ಟುಕೊಳ್ಳಲಿಲ್ಲ.<verse eid="PSA 21:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 21:3"/>ನೀವು ಉತ್ತಮ ಆಶೀರ್ವಾದಗಳಿಂದ ಅರಸನನ್ನು ಸ್ವಾಗತಿಸಿದ್ದೀರಿ;</para>
  <para style="q2" vid="PSA 21:3">ಚೊಕ್ಕ ಬಂಗಾರದ ಕಿರೀಟವನ್ನು ಆತನ ತಲೆಯ ಮೇಲಿಟ್ಟಿದ್ದೀರಿ.<verse eid="PSA 21:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 21:4"/>ಜೀವವನ್ನು ಅರಸನು ನಿಮ್ಮಿಂದ ಬೇಡಲು,</para>
  <para style="q2" vid="PSA 21:4">ನೀವು ಆತನಿಗೆ ಯುಗಯುಗಾಂತರಗಳಿಗೂ ದೀರ್ಘಾಯುಷ್ಯವನ್ನು ಕೊಟ್ಟಿದ್ದೀರಿ.<verse eid="PSA 21:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 21:5"/>ನೀವು ಕೊಟ್ಟ ಜಯಗಳ ಮೂಲಕ ಅರಸನ ಪ್ರಭಾವ ಹೆಚ್ಚಾಗಿದೆ;</para>
  <para style="q2" vid="PSA 21:5">ಗೌರವವನ್ನೂ ಘನತೆಯನ್ನೂ ಆತನ ಮೇಲೆ ಇಟ್ಟಿರುತ್ತೀರಿ.<verse eid="PSA 21:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 21:6"/>ನೀವು ನಿಶ್ಚಯವಾಗಿ ಅರಸನಿಗೆ ನಿತ್ಯ ಆಶೀರ್ವಾದ ದಯಪಾಲಿಸಿದ್ದೀರಿ;</para>
  <para style="q2" vid="PSA 21:6">ನಿಮ್ಮ ಸನ್ನಿಧಿಯಲ್ಲಿ ಆತನು ಅಧಿಕ ಆನಂದಪಡುವಂತೆ ಮಾಡಿದ್ದೀರಿ.<verse eid="PSA 21:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 21:7"/>ಏಕೆಂದರೆ ಅರಸನು ಯೆಹೋವ ದೇವರಲ್ಲಿ ಭರವಸೆ ಇಡುತ್ತಾನೆ;</para>
  <para style="q2" vid="PSA 21:7">ಮಹೋನ್ನತರ ಒಡಂಬಡಿಕೆಯ ಪ್ರೀತಿಯಿಂದ</para>
  <para style="q2" vid="PSA 21:7">ಅರಸನು ಕದಲದೆ ಇರುವನು.<verse eid="PSA 21:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 21:8"/>ನಿಮ್ಮ ಹಸ್ತವು ನಿಮ್ಮ ಶತ್ರುಗಳನ್ನೆಲ್ಲಾ ವಶಪಡಿಸಿಕೊಳ್ಳುವುದು.</para>
  <para style="q2" vid="PSA 21:8">ನಿಮ್ಮ ಬಲಗೈ ನಿಮ್ಮ ವೈರಿಗಳನ್ನು ಸಿಕ್ಕಿಸುವುದು.<verse eid="PSA 21:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 21:9"/>ನೀವು ಬರುವ ಕಾಲದಲ್ಲಿ</para>
  <para style="q2" vid="PSA 21:9">ಅವರನ್ನು ಅಗ್ನಿಕುಂಡದಂತೆ ದಹಿಸಿಬಿಡುವಿರಿ.</para>
  <para style="q1" vid="PSA 21:9">ಯೆಹೋವ ದೇವರು ತಮ್ಮ ಬೇಸರದಿಂದ ಅವರನ್ನು ದಂಡಿಸಿಬಿಡುವರು;</para>
  <para style="q2" vid="PSA 21:9">ಬೆಂಕಿಯು ಅವರನ್ನು ಭಸ್ಮ ಮಾಡುವುದು.<verse eid="PSA 21:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 21:10"/>ಅವರ ವಂಶವನ್ನು ಭೂಲೋಕದೊಳಗಿಂದಲೂ</para>
  <para style="q2" vid="PSA 21:10">ಅವರ ಸಂತತಿಯನ್ನು ಮಾನವರೊಳಗಿಂದಲೂ ಉಳಿಯದಿರಲಿ.<verse eid="PSA 21:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 21:11"/>ಅವರು ನಿಮಗೆ ವಿರೋಧವಾಗಿ ಕೇಡನ್ನು ಯತ್ನಿಸಿದರು,</para>
  <para style="q2" vid="PSA 21:11">ಅವರು ಕುಯುಕ್ತಿಯನ್ನು ಕಲ್ಪಿಸಿದರೂ ಅದು ಕೈಗೂಡದಿರಲಿ.<verse eid="PSA 21:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 21:12"/>ನಿಮ್ಮ ಬಿಲ್ಲನ್ನು ಅವರಿಗೆ ವಿರೋಧವಾಗಿ ಎತ್ತುವಾಗ</para>
  <para style="q2" vid="PSA 21:12">ಅವರು ನಿಮಗೆ ಬೆನ್ನುಮಾಡಿ ಓಡಿಹೋಗಲಿ.<verse eid="PSA 21:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 21:13"/>ಯೆಹೋವ ದೇವರೇ, ನಿಮ್ಮ ಬಲದಲ್ಲಿ ಉನ್ನತರಾಗಿದ್ದೀರಿ,</para>
  <para style="q2" vid="PSA 21:13">ನಾವು ನಿಮ್ಮ ಪರಾಕ್ರಮವನ್ನು ಹಾಡಿ ಕೀರ್ತಿಸುವೆವು.<verse eid="PSA 21:13"/></para>
  <chapter eid="PSA 21"/>
  <chapter number="22" style="c" sid="PSA 22"/>
  <para style="cl">ಕೀರ್ತನೆ 22</para>
  <para style="d">ಸಂಗೀತ ನಿರ್ದೇಶಕನಿಗಾಗಿರುವ ಕೀರ್ತನೆ. “ಉದಯದ ಜಿಂಕೆ” ಎಂಬ ರಾಗದ ಮೇಲೆ ಹಾಡತಕ್ಕದ್ದು; ದಾವೀದನ ಕೀರ್ತನೆ.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 22:1"/>ನನ್ನ ದೇವರೇ, ನನ್ನ ದೇವರೇ, ಏಕೆ ನನ್ನನ್ನು ಕೈಬಿಟ್ಟಿದ್ದೀರಿ?</para>
  <para style="q2" vid="PSA 22:1">ನನ್ನನ್ನು ರಕ್ಷಿಸದೆ ಏಕೆ ದೂರವಾಗಿದ್ದೀರಿ?</para>
  <para style="q2" vid="PSA 22:1">ನನ್ನ ನರಳುವಿಕೆಯ ಮೊರೆಗೆ ಉತ್ತರ ಕೊಡದೆ ಏಕೆ ದೂರವಾಗಿದ್ದೀರಿ?<verse eid="PSA 22:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 22:2"/>ಓ ನನ್ನ ದೇವರೇ, ಹಗಲಿನಲ್ಲಿ ಕರೆಯುತ್ತೇನೆ, ಆದರೆ ನೀವು ಉತ್ತರ ಕೊಡುವುದಿಲ್ಲ;</para>
  <para style="q2" vid="PSA 22:2">ರಾತ್ರಿಯಲ್ಲಿಯೂ ನನಗೆ ವಿಶ್ರಾಂತಿ ಇರುವುದಿಲ್ಲ.<verse eid="PSA 22:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 22:3"/>ನೀವು ಪರಿಶುದ್ಧರು;</para>
  <para style="q2" vid="PSA 22:3">ನೀವು ಇಸ್ರಾಯೇಲರ ಸ್ತೋತ್ರ ಸಿಂಹಾಸನದಲ್ಲಿರುವಿರಿ.<verse eid="PSA 22:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 22:4"/>ನಿಮ್ಮಲ್ಲಿಯೇ ನಮ್ಮ ಪಿತೃಗಳು ಭರವಸೆಯಿಟ್ಟರು;</para>
  <para style="q2" vid="PSA 22:4">ಅವರು ಭರವಸೆಯಿಟ್ಟಿದ್ದರಿಂದ ನೀವು ಅವರನ್ನು ವಿಮೋಚಿಸಿದಿರಿ.<verse eid="PSA 22:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 22:5"/>ಅವರು ನಿಮಗೆ ಮೊರೆಯಿಟ್ಟದ್ದರಿಂದ ನೀವು ಅವರನ್ನು ರಕ್ಷಿಸಿದಿರಿ;</para>
  <para style="q2" vid="PSA 22:5">ನಿಮ್ಮಲ್ಲಿ ಭರವಸೆಯಿಟ್ಟಿದ್ದರಿಂದ ಅವರು ಅಪಮಾನಕ್ಕೆ ಗುರಿಯಾಗಲಿಲ್ಲ.<verse eid="PSA 22:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 22:6"/>ಆದರೆ ನಾನು ಹುಳದಂಥವನೇ ಹೊರತು ಮನುಷ್ಯನಲ್ಲ;</para>
  <para style="q2" vid="PSA 22:6">ನಾನು ಮನುಷ್ಯರಿಂದ ನಿಂದೆ ಹಾಗು ತಿರಸ್ಕಾರಕ್ಕೆ ಗುರಿಯಾಗಿದ್ದೇನೆ.<verse eid="PSA 22:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 22:7"/>ನನ್ನನ್ನು ನೋಡುವವರೆಲ್ಲರೂ ನನ್ನನ್ನು ಗೇಲಿಮಾಡುತ್ತಾರೆ.</para>
  <para style="q2" vid="PSA 22:7">ಅವರು ತಲೆ ಆಡಿಸುತ್ತಾ ಹೀಗೆ ಅವಮಾನಪಡಿಸುತ್ತಾರೆ:<verse eid="PSA 22:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 22:8"/>“ಆತನು ಯೆಹೋವ ದೇವರ ಮೇಲೆ ಭರವಸೆಯಿಟ್ಟಿದ್ದಾನಲ್ಲಾ,</para>
  <para style="q2" vid="PSA 22:8">ಯೆಹೋವ ದೇವರೇ ಆತನನ್ನು ಕಾಪಾಡಲಿ.</para>
  <para style="q1" vid="PSA 22:8">ಯೆಹೋವ ದೇವರು ಆತನಲ್ಲಿ ಹರ್ಷಿಸುವುದಾದರೆ,</para>
  <para style="q2" vid="PSA 22:8">ಅವರೇ ಆತನನ್ನು ಬಿಡಿಸಲಿ.”<verse eid="PSA 22:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 22:9"/>ತಾಯಿಯ ಗರ್ಭದೊಳಗಿಂದ ನನ್ನನ್ನು ಹೊರತಂದವರು ನೀವು;</para>
  <para style="q2" vid="PSA 22:9">ನನ್ನ ತಾಯಿಯ ಎದೆಯಲ್ಲಿ ಇದ್ದಾಗಲೇ ನಾನು ನಿಮ್ಮಲ್ಲಿ ಭರವಸೆಯಿಡುವಂತೆ ಮಾಡಿದಿರಿ.<verse eid="PSA 22:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 22:10"/>ಹುಟ್ಟಿದಂದಿನಿಂದಲೇ ನೀವೇ ನನಗೆ ಆಧಾರ</para>
  <para style="q2" vid="PSA 22:10">ನನ್ನ ತಾಯಿಯ ಗರ್ಭದಿಂದಲೇ ನೀವು ನನ್ನ ದೇವರು.<verse eid="PSA 22:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 22:11"/>ನನ್ನಿಂದ ದೂರವಾಗಿರಬೇಡಿರಿ,</para>
  <para style="q2" vid="PSA 22:11">ಏಕೆಂದರೆ ಇಕ್ಕಟ್ಟು ಸಮೀಪವಾಗಿದೆ,</para>
  <para style="q2" vid="PSA 22:11">ಸಹಾಯಕರು ನನಗೆ ಯಾರೂ ಇಲ್ಲ.<verse eid="PSA 22:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 22:12"/>ಬಹಳ ಹೋರಿಗಳು ನನ್ನನ್ನು ಸುತ್ತಿಕೊಂಡಿವೆ;</para>
  <para style="q2" vid="PSA 22:12">ಬಾಷಾನಿನ ಬಲವಾದ ಹೋರಿಗಳು ನನ್ನನ್ನು ಮುತ್ತಿಕೊಂಡಿವೆ.<verse eid="PSA 22:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 22:13"/>ಹರಿದು ಬಿಡುವ ಗರ್ಜಿಸುವ ಸಿಂಹದ ಹಾಗೆ</para>
  <para style="q2" vid="PSA 22:13">ನನ್ನ ಮೇಲೆ ತಮ್ಮ ಬಾಯಿತೆರೆದಿದ್ದಾರೆ.<verse eid="PSA 22:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 22:14"/>ನಾನು ಚೆಲ್ಲಿದ ನೀರಿನಂತಿದ್ದೇನೆ,</para>
  <para style="q2" vid="PSA 22:14">ನನ್ನ ಎಲುಬುಗಳೆಲ್ಲಾ ಕೀಲು ತಪ್ಪಿ ಹೋಗಿದೆ.</para>
  <para style="q1" vid="PSA 22:14">ನನ್ನ ಹೃದಯವು ಮೇಣದ ಹಾಗೆ</para>
  <para style="q2" vid="PSA 22:14">ನನ್ನೊಳಗೆ ಕರಗಿಹೋಗಿದೆ.<verse eid="PSA 22:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 22:15"/>ನನ್ನ ಬಾಯಿ ಬೋಕಿಯ ಹಾಗೆ ಒಣಗಿಹೋಗಿದೆ,</para>
  <para style="q2" vid="PSA 22:15">ನನ್ನ ನಾಲಿಗೆ ಅಂಗಳಕ್ಕೆ ಹತ್ತಿದೆ,</para>
  <para style="q2" vid="PSA 22:15">ನೀವು ನನ್ನನ್ನು ಮಣ್ಣಿಗೆ ಸೇರಿಸುವಿರಿ.<verse eid="PSA 22:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 22:16"/>ನಾಯಿಗಳು ನನ್ನನ್ನು ಸುತ್ತಿಕೊಂಡಿವೆ;</para>
  <para style="q2" vid="PSA 22:16">ದುರ್ಮಾರ್ಗಿಗಳ ಗುಂಪು ನನ್ನನ್ನು ಮುತ್ತಿಕೊಂಡಿದೆ;</para>
  <para style="q2" vid="PSA 22:16">ಅವರು ನನ್ನ ಕೈಗಳನ್ನೂ ಕಾಲುಗಳನ್ನೂ ತಿವಿದಿದ್ದಾರೆ.<verse eid="PSA 22:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 22:17"/>ನನ್ನ ಎಲುಬುಗಳನ್ನೆಲ್ಲಾ ಎಣಿಸುವಂತಾಗಿದೆ;</para>
  <para style="q2" vid="PSA 22:17">ಅವರು ನನ್ನನ್ನು ಕಂಡು ಹಿಗ್ಗುತ್ತಾರೆ.<verse eid="PSA 22:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 22:18"/>ನನ್ನ ಬಟ್ಟೆಯನ್ನು ಅವರು ತಮ್ಮೊಳಗೆ ಪಾಲು ಮಾಡಿಕೊಳ್ಳುತ್ತಾರೆ;</para>
  <para style="q2" vid="PSA 22:18">ನನ್ನ ಅಂಗಿಗೋಸ್ಕರ ಚೀಟು ಹಾಕುತ್ತಾರೆ.<verse eid="PSA 22:18"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 22:19"/>ಆದರೆ ಯೆಹೋವ ದೇವರೇ, ನೀವು ನನ್ನಿಂದ ದೂರವಾಗಿರಬೇಡಿರಿ;</para>
  <para style="q2" vid="PSA 22:19">ನೀವು ನನ್ನ ಬಲವಾಗಿದ್ದೀರಿ, ನನ್ನ ಸಹಾಯಕ್ಕೆ ಬೇಗ ಬನ್ನಿರಿ.<verse eid="PSA 22:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 22:20"/>ನನ್ನ ಪ್ರಾಣವನ್ನು ಖಡ್ಗದಿಂದಲೂ</para>
  <para style="q2" vid="PSA 22:20">ನನ್ನ ಅಮೂಲ್ಯ ಜೀವವನ್ನು ನಾಯಿಗಳ ಬಲದಿಂದಲೂ ಬಿಡಿಸಿರಿ.<verse eid="PSA 22:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 22:21"/>ಸಿಂಹಗಳ ಬಾಯಿಂದ ನನ್ನನ್ನು ರಕ್ಷಿಸಿರಿ;</para>
  <para style="q2" vid="PSA 22:21">ಕಾಡುಕೋಣಗಳ ಕೊಂಬುಗಳಿಂದ ನನ್ನನ್ನು ತಪ್ಪಿಸಿರಿ.<verse eid="PSA 22:21"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 22:22"/>ನಾನು ನಿಮ್ಮ ಹೆಸರನ್ನು ನನ್ನ ಸಹೋದರರಿಗೆ ಸಾರುವೆನು;</para>
  <para style="q2" vid="PSA 22:22">ಸಭಾ ಮಧ್ಯದಲ್ಲಿ ನಿಮ್ಮನ್ನು ಸ್ತುತಿಸುವೆನು.<verse eid="PSA 22:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 22:23"/>ಯೆಹೋವ ದೇವರಿಗೆ ಭಯಪಡುವವರೇ, ಅವರನ್ನು ಸ್ತುತಿಸಿರಿ;</para>
  <para style="q2" vid="PSA 22:23">ಯಾಕೋಬನ ಎಲ್ಲಾ ಸಂತತಿಯವರೇ, ಅವರನ್ನು ಕೊಂಡಾಡಿರಿ;</para>
  <para style="q2" vid="PSA 22:23">ಇಸ್ರಾಯೇಲರ ಎಲ್ಲಾ ಸಂತತಿಯವರೇ, ಅವರಲ್ಲಿ ಭಯಭಕ್ತಿಯುಳ್ಳವರಾಗಿರಿ.<verse eid="PSA 22:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 22:24"/>ಏಕೆಂದರೆ ಸಂಕಟಪಡುವವನ ಸಂಕಟವನ್ನು</para>
  <para style="q2" vid="PSA 22:24">ಅವರು ತಿರಸ್ಕರಿಸಲಿಲ್ಲ, ಅಸಹ್ಯಪಡಲಿಲ್ಲ;</para>
  <para style="q1" vid="PSA 22:24">ತಮ್ಮ ಮುಖವನ್ನು ಅವನಿಂದ ಮರೆಮಾಡಲಿಲ್ಲ;</para>
  <para style="q2" vid="PSA 22:24">ಆದರೆ ಆತನು ಮೊರೆ ಇಡಲು, ಅವರು ಕೇಳಿದರು.<verse eid="PSA 22:24"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 22:25"/>ಮಹಾಸಭೆಯಲ್ಲಿ ನಿಮ್ಮನ್ನು ಕುರಿತು ನನ್ನ ಸ್ತೋತ್ರವು ನಿಮ್ಮಿಂದ ಬರುವುದು;</para>
  <para style="q2" vid="PSA 22:25">ನನ್ನ ಹರಕೆಗಳನ್ನು ನಿಮಗೆ ಭಯಪಡುವವರ ಮುಂದೆ ಸಲ್ಲಿಸುವೆನು.<verse eid="PSA 22:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 22:26"/>ದೀನರು ಉಂಡು ತೃಪ್ತರಾಗುವರು;</para>
  <para style="q2" vid="PSA 22:26">ಯೆಹೋವ ದೇವರನ್ನು ಹುಡುಕುವವರು ಅವರನ್ನು ಸ್ತುತಿಸುವರು;</para>
  <para style="q2" vid="PSA 22:26">ಅಂಥವರ ಹೃದಯವು ಎಂದೆಂದಿಗೂ ಚೈತನ್ಯ ಹೊಂದಲಿ.<verse eid="PSA 22:26"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 22:27"/>ಲೋಕದಲ್ಲಿರುವ ಎಲ್ಲರೂ ಎಚ್ಚರವಾಗಿ</para>
  <para style="q2" vid="PSA 22:27">ಯೆಹೋವ ದೇವರ ಕಡೆಗೆ ತಿರುಗಿಕೊಳ್ಳುವರು;</para>
  <para style="q1" vid="PSA 22:27">ಜನಾಂಗಗಳ ಕುಟುಂಬಗಳೆಲ್ಲಾ</para>
  <para style="q2" vid="PSA 22:27">ದೇವರ ಮುಂದೆ ಅಡ್ಡಬೀಳುವವು.<verse eid="PSA 22:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 22:28"/>ಏಕೆಂದರೆ ರಾಜ್ಯವು ಯೆಹೋವ ದೇವರದೇ;</para>
  <para style="q2" vid="PSA 22:28">ಜನಾಂಗಗಳನ್ನು ಆಳುವವರು ಅವರೇ.<verse eid="PSA 22:28"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="29" style="v" sid="PSA 22:29"/>ಭೂಮಿಯ ಶ್ರೀಮಂತರೆಲ್ಲರು ಉಂಡು ಆರಾಧಿಸುವರು;</para>
  <para style="q2" vid="PSA 22:29">ತಮ್ಮ ಪ್ರಾಣವನ್ನು ಬದುಕಿಸಲಾರದೆ</para>
  <para style="q2" vid="PSA 22:29">ಧೂಳಿನಲ್ಲಿ ಇಳಿಯುವವರೆಲ್ಲರು ಅವರ ಮುಂದೆ ಅಡ್ಡಬೀಳುವರು.<verse eid="PSA 22:29"/></para>
  <para style="q1">
    <verse number="30" style="v" sid="PSA 22:30"/>ಸಂತಾನವು ದೇವರನ್ನು ಸೇವಿಸುವುದು;</para>
  <para style="q2" vid="PSA 22:30">ಮುಂದಿನ ಸಂತತಿಗಳಿಗೆ ಯೆಹೋವ ದೇವರ ಬಗ್ಗೆ ಹೇಳಲಾಗುವುದು.<verse eid="PSA 22:30"/></para>
  <para style="q1">
    <verse number="31" style="v" sid="PSA 22:31"/>ಆ ಸಂತತಿಯವರು ದೇವರ ನೀತಿಯನ್ನು ಇನ್ನೂ ಜನಿಸದ</para>
  <para style="q2" vid="PSA 22:31">ಜನಾಂಗಕ್ಕೆ ಸಾರಿ ತಿಳಿಸುವರು, ಏಕೆಂದರೆ</para>
  <para style="q2" vid="PSA 22:31">ಇದನ್ನೆಲ್ಲ ಮಾಡಿದವರು ದೇವರೇ!<verse eid="PSA 22:31"/></para>
  <chapter eid="PSA 22"/>
  <chapter number="23" style="c" sid="PSA 23"/>
  <para style="cl">ಕೀರ್ತನೆ 23</para>
  <para style="d">ದಾವೀದನ ಕೀರ್ತನೆ.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 23:1"/>ಯೆಹೋವ ದೇವರು ನನ್ನ ಕುರುಬ ಆಗಿದ್ದಾರೆ, ನನಗೆ ಕೊರತೆಯೇ ಇಲ್ಲ.<verse eid="PSA 23:1"/></para>
  <para style="q2">
    <verse number="2" style="v" sid="PSA 23:2"/>ಅವರು ಹಸಿರುಗಾವಲುಗಳಲ್ಲಿ ನನ್ನನ್ನು ವಿಶ್ರಮಿಸುವಂತೆ ಮಾಡುತ್ತಾರೆ;</para>
  <para style="q1" vid="PSA 23:2">ಪ್ರಶಾಂತ ಜಲರಾಶಿಯ ಬಳಿಗೆ ನನ್ನನ್ನು ನಡೆಸುತ್ತಾರೆ.<verse eid="PSA 23:2"/></para>
  <para style="q2">
    <verse number="3" style="v" sid="PSA 23:3"/>ಅವರು ನನ್ನ ಪ್ರಾಣವನ್ನು ಚೈತನ್ಯಗೊಳಿಸುತ್ತಾರೆ.</para>
  <para style="q1" vid="PSA 23:3">ತಮ್ಮ ಹೆಸರಿನ ನಿಮಿತ್ತ</para>
  <para style="q2" vid="PSA 23:3">ನನ್ನನ್ನು ನೀತಿ ಮಾರ್ಗದಲ್ಲಿ ನಡೆಸುತ್ತಾರೆ.<verse eid="PSA 23:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 23:4"/>ನಾನು ಕಾರ್ಗತ್ತಲಿನ<note caller="+" style="f"><char style="fr" closed="false">23:4 </char><char style="ft" closed="false">ಅಥವಾ </char><char style="fqa" closed="false">ಮರಣದ ನೆರಳಿನಲ್ಲಿ</char></note></para>
  <para style="q2" vid="PSA 23:4">ಕಣಿವೆಯಲ್ಲಿ ನಡೆಯುವಾಗಲೂ,</para>
  <para style="q1" vid="PSA 23:4">ನೀವು ನನ್ನೊಂದಿಗಿರುವುದರಿಂದ</para>
  <para style="q2" vid="PSA 23:4">ನಾನು ಕೇಡಿಗೆ ಹೆದರೆನು;</para>
  <para style="q1" vid="PSA 23:4">ನಿಮ್ಮ ದೊಣ್ಣೆಯೂ ನಿಮ್ಮ ಕೋಲೂ</para>
  <para style="q2" vid="PSA 23:4">ನನ್ನನ್ನು ಸಂತೈಸುತ್ತವೆ.<verse eid="PSA 23:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 23:5"/>ನೀವು ನನ್ನ ವೈರಿಗಳ ಮುಂದೆಯೇ</para>
  <para style="q2" vid="PSA 23:5">ನನಗೊಂದು ಔತಣವನ್ನು ಸಿದ್ಧಮಾಡುತ್ತೀರಿ.</para>
  <para style="q1" vid="PSA 23:5">ನೀವು ನನ್ನ ತಲೆಗೆ ತೈಲವನ್ನು ಅಭಿಷೇಕಿಸುತ್ತೀರಿ.</para>
  <para style="q2" vid="PSA 23:5">ನನ್ನ ಪಾತ್ರೆಯು ತುಂಬಿ ಹೊರಸೂಸುತ್ತದೆ.<verse eid="PSA 23:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 23:6"/>ನಿಶ್ಚಯವಾಗಿ ಶುಭವೂ ಪ್ರೀತಿಯೂ</para>
  <para style="q2" vid="PSA 23:6">ನನ್ನ ಜೀವಮಾನವೆಲ್ಲಾ ನನ್ನನ್ನು ಹಿಂಬಾಲಿಸುತ್ತವೆ;</para>
  <para style="q1" vid="PSA 23:6">ನಾನು ಯೆಹೋವ ದೇವರ ಮನೆಯಲ್ಲಿ</para>
  <para style="q2" vid="PSA 23:6">ಸದಾಕಾಲವೂ ವಾಸಿಸುವೆನು.<verse eid="PSA 23:6"/></para>
  <chapter eid="PSA 23"/>
  <chapter number="24" style="c" sid="PSA 24"/>
  <para style="cl">ಕೀರ್ತನೆ 24</para>
  <para style="d">ದಾವೀದನ ಕೀರ್ತನೆ.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 24:1"/>ಭೂಮಿಯೂ ಅದರಲ್ಲಿರುವ ಸಮಸ್ತವೂ ಯೆಹೋವ ದೇವರದ್ದೇ;</para>
  <para style="q2" vid="PSA 24:1">ಲೋಕವೂ ಅದರ ನಿವಾಸಿಗಳೂ ಅವರಿಗೇ ಸೇರಿದ್ದು.<verse eid="PSA 24:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 24:2"/>ಏಕೆಂದರೆ ಅವರು ಸಮುದ್ರಗಳ ಮೇಲೆ ಅದನ್ನು ಸ್ಥಾಪಿಸಿ</para>
  <para style="q2" vid="PSA 24:2">ಪ್ರವಾಹಗಳ ಮೇಲೆ ಅದನ್ನು ಸ್ಥಿರಪಡಿಸಿದ್ದಾರೆ.<verse eid="PSA 24:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 24:3"/>ಯೆಹೋವ ದೇವರ ಪರ್ವತವನ್ನು ಹತ್ತುವವನು ಯಾರು?</para>
  <para style="q2" vid="PSA 24:3">ಅವರ ಪರಿಶುದ್ಧ ಸ್ಥಳದಲ್ಲಿ ನಿಲ್ಲುವವನು ಯಾರು?<verse eid="PSA 24:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 24:4"/>ಶುದ್ಧಹಸ್ತಗಳೂ ನಿರ್ಮಲವಾದ ಹೃದಯವೂ ಉಳ್ಳವನಾಗಿದ್ದು;</para>
  <para style="q2" vid="PSA 24:4">ವಂಚನೆಯಿಂದ ಮುಕ್ತನಾಗಿ,</para>
  <para style="q2" vid="PSA 24:4">ಮೋಸದಿಂದ ಆಣೆ ಇಡದೆಯೂ ಇರುವವನೇ.<verse eid="PSA 24:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 24:5"/>ಇಂಥವರೇ ಯೆಹೋವ ದೇವರಿಂದ ಆಶೀರ್ವಾದವನ್ನು ಹೊಂದುವರು.</para>
  <para style="q2" vid="PSA 24:5">ತಮ್ಮ ರಕ್ಷಕ ಆಗಿರುವ ದೇವರಿಂದಲೇ ನಿರ್ದೋಷಿಯಾಗುವರು.<verse eid="PSA 24:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 24:6"/>ಇಂಥವರೇ ದೇವರನ್ನು ಹುಡುಕುವ ಸಂತತಿಯು;</para>
  <para style="q2" vid="PSA 24:6">ಯಾಕೋಬನ ದೇವರೇ, ನಿಮ್ಮನ್ನು ಹುಡುಕುವವರು ಇಂಥವರೇ.<verse eid="PSA 24:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 24:7"/>ದ್ವಾರಗಳೇ ತಲೆ ಎತ್ತಿ ನೋಡಿರಿ,</para>
  <para style="q2" vid="PSA 24:7">ಪುರಾತನ ದ್ವಾರಗಳೇ, ತೆರೆದುಕೊಳ್ಳಿರಿ;</para>
  <para style="q2" vid="PSA 24:7">ಮಹಿಮೆಯ ಅರಸ ಒಳಗೆ ಬರಲಿದ್ದಾರೆ.<verse eid="PSA 24:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 24:8"/>ಈ ಮಹಿಮೆಯ ಅರಸ ಯಾರು?</para>
  <para style="q2" vid="PSA 24:8">ಬಲವೂ ಪರಾಕ್ರಮವೂ ಉಳ್ಳ ಯೆಹೋವ ದೇವರೇ ಆಗಿರುತ್ತಾರೆ.</para>
  <para style="q2" vid="PSA 24:8">ಯೆಹೋವ ದೇವರು ಯುದ್ಧದಲ್ಲಿ ಪರಾಕ್ರಮವುಳ್ಳವರು ಆಗಿರುತ್ತಾರೆ.<verse eid="PSA 24:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 24:9"/>ದ್ವಾರಗಳೇ, ತಲೆ ಎತ್ತಿ ನೋಡಿರಿ,</para>
  <para style="q2" vid="PSA 24:9">ಪುರಾತನ ದ್ವಾರಗಳೇ, ತೆರೆದುಕೊಳ್ಳಿರಿ;</para>
  <para style="q2" vid="PSA 24:9">ಮಹಿಮೆಯ ಅರಸ ಒಳಗೆ ಬರಲಿದ್ದಾರೆ.<verse eid="PSA 24:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 24:10"/>ಮಹಿಮೆಯ ಅರಸ ಯಾರು?</para>
  <para style="q2" vid="PSA 24:10">ಸೇನಾಧೀಶ್ವರ ಯೆಹೋವ ದೇವರೇ ಆಗಿರುತ್ತಾರೆ.</para>
  <para style="q2" vid="PSA 24:10">ಇವರೇ ಮಹಿಮೆಯ ಅರಸರು.<verse eid="PSA 24:10"/></para>
  <chapter eid="PSA 24"/>
  <chapter number="25" style="c" sid="PSA 25"/>
  <para style="cl">ಕೀರ್ತನೆ 25<note caller="+" style="f"><char style="fr" closed="false">25:0 </char><char style="ft" closed="false">ಹೀಬ್ರೂ ಅಕ್ಷರ ಕ್ರಮಾನುಸಾರವಾದ ಪ್ರಾರ್ಥನೆ.</char></note></para>
  <para style="d">ದಾವೀದನ ಕೀರ್ತನೆ.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 25:1"/>ಯೆಹೋವ ದೇವರೇ,</para>
  <para style="q2" vid="PSA 25:1">ನಿಮ್ಮಲ್ಲಿ ಭರವಸೆಯಿಟ್ಟಿದ್ದೇನೆ.<verse eid="PSA 25:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 25:2"/>ನನ್ನ ದೇವರೇ, ನಾನು ನಿಮ್ಮಲ್ಲಿ ಭರವಸೆಯಿಟ್ಟಿದ್ದೇನೆ;</para>
  <para style="q2" vid="PSA 25:2">ನಾನು ನಾಚಿಕೆಪಡದಂತೆ ಮಾಡಿರಿ;</para>
  <para style="q2" vid="PSA 25:2">ನನ್ನ ಶತ್ರುಗಳು ನನ್ನ ಮೇಲೆ ಜಯೋತ್ಸಾಹ ಮಾಡದಿರಲಿ.<verse eid="PSA 25:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 25:3"/>ನಿಮ್ಮನ್ನು ನಿರೀಕ್ಷಿಸುವವರಲ್ಲಿ</para>
  <para style="q2" vid="PSA 25:3">ಯಾರೂ ನಾಚಿಕೆಪಡದಿರಲಿ;</para>
  <para style="q1" vid="PSA 25:3">ನಿಷ್ಕಾರಣವಾಗಿ ವಂಚನೆ</para>
  <para style="q2" vid="PSA 25:3">ಮಾಡುವವರು ನಾಚಿಕೆಪಡಲಿ.<verse eid="PSA 25:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 25:4"/>ಯೆಹೋವ ದೇವರೇ, ನಿಮ್ಮ ಮಾರ್ಗಗಳನ್ನು ನನಗೆ ತೋರಿಸಿರಿ;</para>
  <para style="q2" vid="PSA 25:4">ನಿಮ್ಮ ದಾರಿಗಳನ್ನು ನನಗೆ ಕಲಿಸಿರಿ.<verse eid="PSA 25:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 25:5"/>ನಿಮ್ಮ ಸತ್ಯದಲ್ಲಿ ಮಾರ್ಗದರ್ಶನ ನೀಡಿ ನನಗೆ ಬೋಧಿಸಿರಿ;</para>
  <para style="q2" vid="PSA 25:5">ಏಕೆಂದರೆ ನೀವು ನನ್ನ ರಕ್ಷಕ ಆಗಿರುವ ದೇವರಾಗಿದ್ದೀರಿ;</para>
  <para style="q2" vid="PSA 25:5">ನಿಮ್ಮನ್ನು ನಾನು ದಿನವೆಲ್ಲಾ ನಿರೀಕ್ಷಿಸುತ್ತಿದ್ದೇನೆ.<verse eid="PSA 25:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 25:6"/>ಯೆಹೋವ ದೇವರೇ, ಆದಿಯಿಂದಿರುವ ನಿಮ್ಮ ಅನುಕಂಪವನ್ನೂ ನಿಮ್ಮ ಪ್ರೀತಿಯನ್ನೂ,</para>
  <para style="q2" vid="PSA 25:6">ಕರುಣೆಯನ್ನೂ ಜ್ಞಾಪಕಮಾಡಿಕೊಳ್ಳಿರಿ.<verse eid="PSA 25:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 25:7"/>ಯೆಹೋವ ದೇವರೇ, ನನ್ನ ಯೌವನದ ಪಾಪಗಳನ್ನೂ,</para>
  <para style="q2" vid="PSA 25:7">ನನ್ನ ತಿರುಗಿ ಬೀಳುವಿಕೆಗಳನ್ನೂ ಜ್ಞಾಪಕ ಮಾಡಿಕೊಳ್ಳಬೇಡಿರಿ.</para>
  <para style="q1" vid="PSA 25:7">ನೀವು ಒಳ್ಳೆಯವರಾಗಿರುವುದರಿಂದ ನಿಮ್ಮ ಪ್ರೀತಿಯ ಪ್ರಕಾರ</para>
  <para style="q2" vid="PSA 25:7">ನನ್ನನ್ನು ಜ್ಞಾಪಕಮಾಡಿಕೊಳ್ಳಿರಿ.<verse eid="PSA 25:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 25:8"/>ಯೆಹೋವ ದೇವರು ಒಳ್ಳೆಯವರೂ ನ್ಯಾಯವುಳ್ಳವರೂ ಆಗಿದ್ದಾರೆ;</para>
  <para style="q2" vid="PSA 25:8">ಆದ್ದರಿಂದ ಅವರು ಪಾಪಿಗಳಿಗೆ ತಮ್ಮ ಮಾರ್ಗಗಳನ್ನು ಬೋಧಿಸುತ್ತಾರೆ.<verse eid="PSA 25:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 25:9"/>ದೀನರನ್ನು ನ್ಯಾಯ ಮಾರ್ಗದಲ್ಲಿ ನಡೆಸಿ,</para>
  <para style="q2" vid="PSA 25:9">ದೀನರಿಗೆ ತಮ್ಮ ಮಾರ್ಗವನ್ನು ಬೋಧಿಸುತ್ತಾರೆ.<verse eid="PSA 25:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 25:10"/>ಯೆಹೋವ ದೇವರ ಒಡಂಬಡಿಕೆಯನ್ನು</para>
  <para style="q2" vid="PSA 25:10">ಕೈಗೊಳ್ಳುವವರಿಗೆ ಅವರ ದಾರಿಯೆಲ್ಲವು ಪ್ರೀತಿ, ಸತ್ಯದಿಂದ ತುಂಬಿರುತ್ತವೆ.<verse eid="PSA 25:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 25:11"/>ನನ್ನ ಅನ್ಯಾಯವು ಬಹು ಘೋರವಾಗಿದ್ದರೂ ನಿಮ್ಮ ಹೆಸರಿನ ನಿಮಿತ್ತ ಯೆಹೋವ ದೇವರೇ</para>
  <para style="q2" vid="PSA 25:11">ನನ್ನನ್ನು ಮನ್ನಿಸಿರಿ.<verse eid="PSA 25:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 25:12"/>ಯಾವನು ಯೆಹೋವ ದೇವರಿಗೆ ಭಯಪಡುವನೋ,</para>
  <para style="q2" vid="PSA 25:12">ಅಂಥವನಿಗೆ ಅವರು ಆಯ್ದುಕೊಳ್ಳತಕ್ಕ ಮಾರ್ಗವನ್ನು ಬೋಧಿಸುವರು.<verse eid="PSA 25:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 25:13"/>ಅಂಥವರು ಜೀವಮಾನವೆಲ್ಲಾ ಸಫಲರಾಗಿರುವರು.</para>
  <para style="q2" vid="PSA 25:13">ಅಂಥವರ ಸಂತಾನವು ದೇಶವನ್ನು ಸ್ವಾಧೀನ ಮಾಡಿಕೊಳ್ಳುವುದು.<verse eid="PSA 25:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 25:14"/>ಯೆಹೋವ ದೇವರ ರಹಸ್ಯವು ಅವರಿಗೆ ಭಯಪಡುವವರೊಂದಿಗೆ ಇರುವುದು;</para>
  <para style="q2" vid="PSA 25:14">ತಮ್ಮ ಒಡಂಬಡಿಕೆಯನ್ನು ಅವರು ಅಂಥವರಿಗೇ ತಿಳಿಸುವರು.<verse eid="PSA 25:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 25:15"/>ನನ್ನ ಕಣ್ಣುಗಳು ಯಾವಾಗಲೂ ಯೆಹೋವ ದೇವರ ಕಡೆಗೆ ಇರುತ್ತವೆ;</para>
  <para style="q2" vid="PSA 25:15">ಏಕೆಂದರೆ ಅವರೇ ನನ್ನ ಪಾದಗಳನ್ನು ಬಲೆಯಿಂದ ಬಿಡಿಸುವವರು.<verse eid="PSA 25:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 25:16"/>ನೀವು ನನ್ನ ಕಡೆಗೆ ತಿರುಗಿ ನನ್ನನ್ನು ಕರುಣಿಸಿರಿ;</para>
  <para style="q2" vid="PSA 25:16">ನಾನು ಒಬ್ಬಂಟಿಗನಾಗಿಯೂ ಬಾಧೆಪಡುವವನಾಗಿಯೂ ಇದ್ದೇನೆ.<verse eid="PSA 25:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 25:17"/>ನನ್ನ ಹೃದಯದ ಕಷ್ಟಗಳನ್ನು ಪರಿಹರಿಸಿರಿ;</para>
  <para style="q2" vid="PSA 25:17">ನೀವು ನನ್ನ ಸಂಕಟಗಳಿಂದ ನನ್ನನ್ನು ಬಿಡಿಸಿರಿ.<verse eid="PSA 25:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 25:18"/>ನನ್ನ ಬಾಧೆಯನ್ನೂ ವ್ಯಥೆಯನ್ನೂ ನೋಡಿರಿ;</para>
  <para style="q2" vid="PSA 25:18">ನನ್ನ ಪಾಪಗಳನ್ನೆಲ್ಲಾ ತೆಗೆದುಹಾಕಿರಿ.<verse eid="PSA 25:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 25:19"/>ನನ್ನ ಶತ್ರುಗಳನ್ನು ನೋಡಿರಿ, ಅವರು ಹೆಚ್ಚಾಗಿದ್ದಾರೆ;</para>
  <para style="q2" vid="PSA 25:19">ತೀವ್ರ ಹಗೆಯಿಂದ ಅವರು ನನ್ನನ್ನು ದ್ವೇಷಿಸುತ್ತಾರೆ.<verse eid="PSA 25:19"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 25:20"/>ನನ್ನ ಪ್ರಾಣವನ್ನು ಕಾಪಾಡಿ, ನನ್ನನ್ನು ಬಿಡಿಸಿರಿ;</para>
  <para style="q2" vid="PSA 25:20">ನಾನು ನಾಚಿಕೆಪಡದಂತೆ ಮಾಡಿರಿ,</para>
  <para style="q2" vid="PSA 25:20">ಏಕೆಂದರೆ ನಾನು ನಿಮ್ಮಲ್ಲಿ ಆಶ್ರಯಪಡೆದಿದ್ದೇನೆ.<verse eid="PSA 25:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 25:21"/>ಯಥಾರ್ಥತೆಯೂ ನಿಷ್ಕಪಟವೂ ನನ್ನನ್ನು ಕಾಯಲಿ,</para>
  <para style="q2" vid="PSA 25:21">ಏಕೆಂದರೆ ನನ್ನ ನಿರೀಕ್ಷೆಯು ನಿಮ್ಮ ಮೇಲೆ ಇದೆ.<verse eid="PSA 25:21"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 25:22"/>ದೇವರೇ, ಇಸ್ರಾಯೇಲರನ್ನು</para>
  <para style="q2" vid="PSA 25:22">ಅವರ ಎಲ್ಲಾ ಇಕ್ಕಟ್ಟುಗಳೊಳಗಿಂದ ವಿಮೋಚಿಸಿರಿ.<verse eid="PSA 25:22"/></para>
  <chapter eid="PSA 25"/>
  <chapter number="26" style="c" sid="PSA 26"/>
  <para style="cl">ಕೀರ್ತನೆ 26</para>
  <para style="d">ದಾವೀದನ ಕೀರ್ತನೆ.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 26:1"/>ಯೆಹೋವ ದೇವರೇ, ನನ್ನನ್ನು ನಿರ್ದೋಷನನ್ನಾಗಿ ನಿರ್ಣಯಿಸಿರಿ,</para>
  <para style="q2" vid="PSA 26:1">ನಾನು ದೋಷವಿಲ್ಲದ ಜೀವನ ನಡೆಸಿದ್ದೇನೆ;</para>
  <para style="q1" vid="PSA 26:1">ನಾನು ಯೆಹೋವ ದೇವರಲ್ಲಿ ಕದಲದೆ</para>
  <para style="q2" vid="PSA 26:1">ಭರವಸೆ ಇಟ್ಟಿದ್ದೇನೆ.<verse eid="PSA 26:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 26:2"/>ಯೆಹೋವ ದೇವರೇ, ನನ್ನನ್ನು ಶೋಧಿಸಿ, ಪರೀಕ್ಷಿಸಿರಿ;</para>
  <para style="q2" vid="PSA 26:2">ನನ್ನ ಅಂತರಿಂದ್ರಿಯಗಳನ್ನೂ ನನ್ನ ಹೃದಯವನ್ನೂ ಶೋಧಿಸಿರಿ.<verse eid="PSA 26:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 26:3"/>ನಿಮ್ಮ ಒಡಂಬಡಿಕೆಯ ಪ್ರೀತಿಯು ಯಾವಾಗಲೂ ನನ್ನ ಮನಸ್ಸು ತುಂಬ ಇದೆ;</para>
  <para style="q2" vid="PSA 26:3">ನಿಮ್ಮ ನಂಬಿಗಸ್ತಿಕೆಯಲ್ಲಿ ನಾನು ಬಾಳುತ್ತಿದ್ದೇನೆ.<verse eid="PSA 26:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 26:4"/>ಮೋಸಗಾರರ ಸಂಗಡ ನಾನು ಕುಳಿತುಕೊಳ್ಳಲಿಲ್ಲ;</para>
  <para style="q2" vid="PSA 26:4">ವಂಚಕರ ಸಂಗಡ ನಾನು ಹೋಗುವುದಿಲ್ಲ.<verse eid="PSA 26:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 26:5"/>ದುರ್ಮಾರ್ಗಿಗಳ ಸಭೆಯನ್ನು ದ್ವೇಷಿಸಿದ್ದೇನೆ;</para>
  <para style="q2" vid="PSA 26:5">ದುಷ್ಟರ ಸಂಗಡ ಕುಳಿತುಕೊಳ್ಳುವುದಿಲ್ಲ.<verse eid="PSA 26:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 26:6"/>ನನ್ನ ಕೈಗಳನ್ನು ನಿರ್ಮಲವಾಗಿ ತೊಳೆದುಕೊಂಡು,</para>
  <para style="q2" vid="PSA 26:6">ಯೆಹೋವ ದೇವರೇ, ನಿಮ್ಮ ಬಲಿಪೀಠವನ್ನು ಸುತ್ತುತ್ತಾ,<verse eid="PSA 26:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 26:7"/>ಸ್ತೋತ್ರ ಧ್ವನಿಯೆತ್ತಿ ಸಾರುತ್ತಾ</para>
  <para style="q2" vid="PSA 26:7">ನಿಮ್ಮ ಅದ್ಭುತಗಳನ್ನೆಲ್ಲಾ ತಿಳಿಸುವೆನು.<verse eid="PSA 26:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 26:8"/>ಯೆಹೋವ ದೇವರೇ, ನೀವು ವಾಸಿಸುವ ಆಲಯವನ್ನೂ,</para>
  <para style="q2" vid="PSA 26:8">ನಿಮ್ಮ ಮಹಿಮೆಯ ನಿವಾಸವನ್ನೂ ಪ್ರೀತಿಸುತ್ತೇನೆ.<verse eid="PSA 26:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 26:9"/>ಪಾಪಿಗಳ ಸಂಗಡ ನನ್ನ ಪ್ರಾಣವನ್ನೂ,</para>
  <para style="q2" vid="PSA 26:9">ರಕ್ತಸುರಿಸುವವರ ಸಂಗಡ ನನ್ನ ಜೀವವನ್ನೂ ತೆಗೆಯಬೇಡಿರಿ.<verse eid="PSA 26:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 26:10"/>ಅವರ ಕೈಗಳಲ್ಲಿ ಕೇಡು ಇದೆ;</para>
  <para style="q2" vid="PSA 26:10">ಅವರ ಬಲಗೈ ಲಂಚಗಳಿಂದ ತುಂಬಿದೆ.<verse eid="PSA 26:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 26:11"/>ನಾನಾದರೋ ನನ್ನ ಯಥಾರ್ಥತೆಯಲ್ಲಿ ನಡೆಯುತ್ತೇನೆ;</para>
  <para style="q2" vid="PSA 26:11">ನನ್ನನ್ನು ವಿಮೋಚಿಸಿರಿ; ನನಗೆ ಕರುಣೆಯುಳ್ಳವರಾಗಿರಿ.<verse eid="PSA 26:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 26:12"/>ನನ್ನ ಪಾದವು ಸಮ ನೆಲದಲ್ಲಿ ನಿಂತಿದೆ;</para>
  <para style="q2" vid="PSA 26:12">ನಾನು ಮಹಾಸಭೆಯಲ್ಲಿ ಯೆಹೋವ ದೇವರನ್ನು ಸ್ತುತಿಸುವೆನು.<verse eid="PSA 26:12"/></para>
  <chapter eid="PSA 26"/>
  <chapter number="27" style="c" sid="PSA 27"/>
  <para style="cl">ಕೀರ್ತನೆ 27</para>
  <para style="d">ದಾವೀದನ ಕೀರ್ತನೆ.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 27:1"/>ಯೆಹೋವ ದೇವರು ನನ್ನ ಬೆಳಕೂ ನನ್ನ ರಕ್ಷಣೆಯೂ ಆಗಿದ್ದಾರೆ.</para>
  <para style="q2" vid="PSA 27:1">ನಾನು ಯಾರಿಗೂ ಭಯಪಡೆನು?</para>
  <para style="q1" vid="PSA 27:1">ಯೆಹೋವ ದೇವರು ನನ್ನ ಜೀವದ ಭದ್ರಾಶ್ರಯವಾಗಿದ್ದಾರೆ.</para>
  <para style="q2" vid="PSA 27:1">ನಾನು ಯಾರಿಗೂ ಹೆದರೆನು?<verse eid="PSA 27:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 27:2"/>ದುಷ್ಟರು ನನ್ನನ್ನು ಬೀಳಿಸಬೇಕೆಂದು</para>
  <para style="q2" vid="PSA 27:2">ನನಗೆ ವಿರೋಧವಾಗಿ ಸಮೀಪಿಸುವಾಗ,</para>
  <para style="q1" vid="PSA 27:2">ನನ್ನ ವೈರಿಗಳು</para>
  <para style="q2" vid="PSA 27:2">ತಾವೇ ಎಡವಿಬಿದ್ದರು.<verse eid="PSA 27:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 27:3"/>ನನಗೆ ವಿರೋಧವಾಗಿ ಇಳಿದರೂ</para>
  <para style="q2" vid="PSA 27:3">ನನ್ನ ಹೃದಯವು ಭಯಪಡದು;</para>
  <para style="q1" vid="PSA 27:3">ನನ್ನ ಮೇಲೆ ಯುದ್ಧ ಸೈನ್ಯವು ನಡೆದರೂ</para>
  <para style="q2" vid="PSA 27:3">ನಾನು ಭರವಸೆಯಿಂದಿರುವೆನು.<verse eid="PSA 27:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 27:4"/>ಯೆಹೋವ ದೇವರ ಮನೆಯಲ್ಲಿ ನಾನು ಜೀವಮಾನವೆಲ್ಲಾ ವಾಸಮಾಡುತ್ತಾ,</para>
  <para style="q2" vid="PSA 27:4">ಅದರ ದಯೆಯನ್ನು ನೋಡುತ್ತಾ</para>
  <para style="q1" vid="PSA 27:4">ಅವರ ಮಂದಿರದಲ್ಲಿ ಅವರನ್ನೇ ಧ್ಯಾನಿಸುತ್ತಾ</para>
  <para style="q2" vid="PSA 27:4">ಇರಬೇಕೆಂಬ ಒಂದೇ ವರವನ್ನು</para>
  <para style="q1" vid="PSA 27:4">ಯೆಹೋವ ದೇವರಿಂದ ಕೇಳಿಕೊಂಡು</para>
  <para style="q2" vid="PSA 27:4">ಅದನ್ನೇ ಹುಡುಕುತ್ತಿರುವೆನು.<verse eid="PSA 27:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 27:5"/>ಕೇಡಿನ ಸಮಯದಲ್ಲಿ ಯೆಹೋವ ದೇವರು ನನ್ನನ್ನು</para>
  <para style="q2" vid="PSA 27:5">ತಮ್ಮ ಗುಡಾರದಲ್ಲಿ ಬಚ್ಚಿಡುವರು.</para>
  <para style="q1" vid="PSA 27:5">ತಮ್ಮ ಪರಿಶುದ್ಧ ಗುಡಾರದಲ್ಲಿ ನನ್ನನ್ನು ಮರೆಮಾಡುವರು.</para>
  <para style="q2" vid="PSA 27:5">ಎತ್ತರವಾದ ಬಂಡೆಯ ಮೇಲೆ ನನ್ನನ್ನು ನಿಲ್ಲಿಸುವರು.<verse eid="PSA 27:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 27:6"/>ಈಗ ನನ್ನ ತಲೆಯು ನನ್ನ ಸುತ್ತಲಿರುವ</para>
  <para style="q2" vid="PSA 27:6">ನನ್ನ ಶತ್ರುಗಳ ಮೇಲೆ ಎತ್ತಲಾಗಿರುವುದು,</para>
  <para style="q1" vid="PSA 27:6">ಆದ್ದರಿಂದ ದೇವರ ಗುಡಾರದಲ್ಲಿ ಉತ್ಸಾಹದಿಂದ ಬಲಿಗಳನ್ನು ಅರ್ಪಿಸುವೆನು;</para>
  <para style="q2" vid="PSA 27:6">ಯೆಹೋವ ದೇವರಿಗೆ ಹಾಡಿ ಕೊಂಡಾಡುವೆನು.<verse eid="PSA 27:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 27:7"/>ಯೆಹೋವ ದೇವರೇ, ನಾನು ಕೂಗುವ ಸ್ವರವನ್ನು ಕೇಳಿರಿ;</para>
  <para style="q2" vid="PSA 27:7">ನನ್ನನ್ನು ಕರುಣಿಸಿ ಉತ್ತರವನ್ನು ಕೊಡಿರಿ.<verse eid="PSA 27:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 27:8"/>ನಿಮ್ಮ ಬಗ್ಗೆ ನನ್ನ ಹೃದಯವು ಹೀಗೆ ಹೇಳುತ್ತದೆ: “ದೇವರ ಮುಖವನ್ನು ಹುಡುಕು,”</para>
  <para style="q2" vid="PSA 27:8">ಆದ್ದರಿಂದ ಯೆಹೋವ ದೇವರೇ, ನಿಮ್ಮ ಮುಖವನ್ನೇ ಹುಡುಕುತ್ತಿರುವೆನು.<verse eid="PSA 27:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 27:9"/>ನಿಮ್ಮ ಮುಖವನ್ನು ನನಗೆ ಮರೆಮಾಡಬೇಡಿರಿ;</para>
  <para style="q2" vid="PSA 27:9">ನಿಮ್ಮ ಸೇವಕನಾದ ನನ್ನನ್ನು ತಳ್ಳಬೇಡಿರಿ;</para>
  <para style="q2" vid="PSA 27:9">ನೀವೇ ನನಗೆ ಸಹಾಯಕರಾಗಿದ್ದೀರಿ;</para>
  <para style="q1" vid="PSA 27:9">ನನ್ನ ರಕ್ಷಕ ಆಗಿರುವ ದೇವರೇ, ನನ್ನನ್ನು ತ್ಯಜಿಸಬೇಡಿರಿ.</para>
  <para style="q2" vid="PSA 27:9">ನನ್ನನ್ನು ಬಿಟ್ಟುಬಿಡಬೇಡಿರಿ.<verse eid="PSA 27:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 27:10"/>ನನ್ನ ತಂದೆತಾಯಂದಿರು ನನ್ನನ್ನು ಬಿಟ್ಟುಬಿಟ್ಟರೂ,</para>
  <para style="q2" vid="PSA 27:10">ಯೆಹೋವ ದೇವರು ನನ್ನನ್ನು ಸೇರಿಸಿಕೊಳ್ಳುವರು.<verse eid="PSA 27:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 27:11"/>ಯೆಹೋವ ದೇವರೇ, ನಿಮ್ಮ ಮಾರ್ಗವನ್ನು ನನಗೆ ಬೋಧಿಸಿರಿ;</para>
  <para style="q2" vid="PSA 27:11">ನನ್ನ ವಿರೋಧಿಗಳ ನಿಮಿತ್ತ</para>
  <para style="q2" vid="PSA 27:11">ಸಮಹಾದಿಯಲ್ಲಿ ನನ್ನನ್ನು ನಡೆಸಿರಿ.<verse eid="PSA 27:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 27:12"/>ನನ್ನ ವೈರಿಗಳ ವಶಕ್ಕೆ ನನ್ನನ್ನು ಕೊಡಬೇಡಿರಿ;</para>
  <para style="q2" vid="PSA 27:12">ಸುಳ್ಳುಸಾಕ್ಷಿಗಳೂ ಕ್ರೂರ ನಿಂದಕರೂ</para>
  <para style="q2" vid="PSA 27:12">ನನಗೆ ವಿರೋಧವಾಗಿ ಎದ್ದಿದ್ದಾರೆ.<verse eid="PSA 27:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 27:13"/>ಇದೊಂದು ನನ್ನ ಭರವಸೆಯಾಗಿರುವುದು:</para>
  <para style="q2" vid="PSA 27:13">ನಾನಂತೂ ಯೆಹೋವ ದೇವರ ಒಳಿತನ್ನು</para>
  <para style="q2" vid="PSA 27:13">ಜೀವಿತರ ದೇಶದಲ್ಲಿ ಕಾಣುವೆನು.<verse eid="PSA 27:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 27:14"/>ಯೆಹೋವ ದೇವರಿಗಾಗಿ ಕಾದಿರು, ಧೈರ್ಯವಾಗಿರು;</para>
  <para style="q2" vid="PSA 27:14">ಅವರು ನಿನ್ನ ಹೃದಯವನ್ನು ದೃಢಪಡಿಸುವರು;</para>
  <para style="q2" vid="PSA 27:14">ಯೆಹೋವ ದೇವರಿಗಾಗಿ ಕಾದಿರು.<verse eid="PSA 27:14"/></para>
  <chapter eid="PSA 27"/>
  <chapter number="28" style="c" sid="PSA 28"/>
  <para style="cl">ಕೀರ್ತನೆ 28</para>
  <para style="d">ದಾವೀದನ ಕೀರ್ತನೆ.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 28:1"/>ಯೆಹೋವ ದೇವರೇ,</para>
  <para style="q2" vid="PSA 28:1">ನೀವು ನನಗೆ ಸಂರಕ್ಷಿಸುವ ಬಂಡೆಯಾಗಿದ್ದೀರಿ.</para>
  <para style="q2" vid="PSA 28:1">ನಿಮ್ಮನ್ನು ಬೇಡಿಕೊಳ್ಳುತ್ತಿದ್ದೇನೆ,</para>
  <para style="q1" vid="PSA 28:1">ಮೌನವಾಗಿರಬೇಡಿರಿ; ನೀವು ಸುಮ್ಮನಿದ್ದರೆ</para>
  <para style="q2" vid="PSA 28:1">ನಾನು ಸಮಾಧಿಯಲ್ಲಿದ್ದವನಿಗೆ ಸಮಾನನಾಗುವೆನು.<verse eid="PSA 28:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 28:2"/>ನಾನು ನಿಮಗೆ ಮೊರೆಯಿಡುವಾಗ,</para>
  <para style="q2" vid="PSA 28:2">ನನ್ನ ಕೈಗಳನ್ನು ನಿಮ್ಮ ಮಹಾಪರಿಶುದ್ಧ</para>
  <para style="q1" vid="PSA 28:2">ಸ್ಥಳದ ಕಡೆಗೆ ಎತ್ತುವಾಗ</para>
  <para style="q2" vid="PSA 28:2">ನನ್ನ ವಿಜ್ಞಾಪನೆಯನ್ನು ಲಾಲಿಸಿರಿ.<verse eid="PSA 28:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 28:3"/>ದುಷ್ಟರ ಸಂಗಡವೂ ಅಪರಾಧ ಮಾಡುವವರ</para>
  <para style="q2" vid="PSA 28:3">ಸಂಗಡವೂ ನನ್ನನ್ನು ಎಳೆಯಬೇಡಿರಿ;</para>
  <para style="q1" vid="PSA 28:3">ಅವರು ತಮ್ಮ ನೆರೆಯವರೊಂದಿಗೆ ಸಮಾಧಾನವಾಗಿ ಮಾತನಾಡುತ್ತಾರೆ;</para>
  <para style="q2" vid="PSA 28:3">ಆದರೆ ಕೇಡು ಅವರ ಹೃದಯದಲ್ಲಿ ಇದೆ.<verse eid="PSA 28:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 28:4"/>ಅವರ ಕೃತ್ಯಗಳ ಪ್ರಕಾರವಾಗಿಯೂ,</para>
  <para style="q2" vid="PSA 28:4">ಅವರ ಕೆಟ್ಟತನಗಳ ಪ್ರಕಾರವಾಗಿಯೂ ಅವರಿಗೆ ಪ್ರತಿಫಲಕೊಡಿರಿ;</para>
  <para style="q1" vid="PSA 28:4">ಅವರ ಕೈಕೃತ್ಯಗಳ ಪ್ರಕಾರವಾಗಿ ಅವರಿಗೆ ಕೊಡಿರಿ,</para>
  <para style="q2" vid="PSA 28:4">ಅರ್ಹತೆಗೆ ತಕ್ಕಂತೆಯೇ ಅವರಿಗೆ ಬರಮಾಡಿರಿ.<verse eid="PSA 28:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 28:5"/>ಅವರು ಯೆಹೋವ ದೇವರ ಕೃತ್ಯಗಳನ್ನೂ,</para>
  <para style="q2" vid="PSA 28:5">ಅವರ ಕೈಗಳ ಕೆಲಸವನ್ನೂ ಲಕ್ಷಿಸುವುದಿಲ್ಲ;</para>
  <para style="q1" vid="PSA 28:5">ಆದ್ದರಿಂದ ದೇವರು ಅವರನ್ನು</para>
  <para style="q2" vid="PSA 28:5">ವೃದ್ಧಿಗೊಳಿಸದೆ ದಂಡಿಸುವರು.<verse eid="PSA 28:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 28:6"/>ಯೆಹೋವ ದೇವರಿಗೆ ಸ್ತುತಿಯುಂಟಾಗಲಿ;</para>
  <para style="q2" vid="PSA 28:6">ಕರುಣೆಗಾಗಿ ನನ್ನ ಮೊರೆಯನ್ನು ಅವರು ಕೇಳಿದ್ದಾರೆ.<verse eid="PSA 28:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 28:7"/>ಯೆಹೋವ ದೇವರು ನನ್ನ ಬಲವೂ, ನನ್ನ ಗುರಾಣಿಯೂ ಆಗಿದ್ದಾರೆ;</para>
  <para style="q2" vid="PSA 28:7">ನನ್ನ ಹೃದಯವು ಅವರಲ್ಲಿ ಭರವಸೆ ಇಟ್ಟದ್ದರಿಂದ ನಾನು ಸಹಾಯ ಹೊಂದಿದೆನು;</para>
  <para style="q1" vid="PSA 28:7">ನನ್ನ ಹೃದಯವು ಬಹಳವಾಗಿ ಉತ್ಸಾಹಪಡುವುದು;</para>
  <para style="q2" vid="PSA 28:7">ನನ್ನ ಕೀರ್ತನೆಯಿಂದ ಅವರನ್ನು ಕೊಂಡಾಡುವೆನು.<verse eid="PSA 28:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 28:8"/>ಯೆಹೋವ ದೇವರು ತಮ್ಮ ಜನರಿಗೆ ಬಲವಾಗಿದ್ದಾರೆ;</para>
  <para style="q2" vid="PSA 28:8">ತಮ್ಮ ಅಭಿಷಿಕ್ತನಿಗೆ ರಕ್ಷಣೆಯ ಕೋಟೆ ಆಗಿದ್ದಾರೆ.<verse eid="PSA 28:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 28:9"/>ನಿಮ್ಮ ಜನರನ್ನು ರಕ್ಷಿಸಿರಿ; ನಿಮ್ಮ ವಾರಸುದಾರರನ್ನು ಆಶೀರ್ವದಿಸಿರಿ;</para>
  <para style="q2" vid="PSA 28:9">ನೀವು ಅವರ ಕುರುಬ ಆಗಿದ್ದು; ಅವರನ್ನು ಯಾವಾಗಲೂ ಮುನ್ನಡೆಸಿರಿ.<verse eid="PSA 28:9"/></para>
  <chapter eid="PSA 28"/>
  <chapter number="29" style="c" sid="PSA 29"/>
  <para style="cl">ಕೀರ್ತನೆ 29</para>
  <para style="d">ದಾವೀದನ ಕೀರ್ತನೆ.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 29:1"/>ದೇವದೂತರೇ, ಬಲವು ಯೆಹೋವ ದೇವರದೇ,</para>
  <para style="q2" vid="PSA 29:1">ಮಹಿಮೆ ಯೆಹೋವ ದೇವರದೇ ಎಂದು ಹೇಳಿ ಕೊಂಡಾಡಿರಿ.<verse eid="PSA 29:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 29:2"/>ಯೆಹೋವ ದೇವರ ನಾಮಕ್ಕೆ ಸಲ್ಲತಕ್ಕ ಘನವನ್ನು ಸಲ್ಲಿಸಿರಿ;</para>
  <para style="q2" vid="PSA 29:2">ಪರಿಶುದ್ಧತ್ವವೆಂಬ ವಸ್ತ್ರದೊಡನೆ ಯೆಹೋವ ದೇವರನ್ನು ಆರಾಧಿಸಿರಿ.<verse eid="PSA 29:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 29:3"/>ಯೆಹೋವ ದೇವರ ಧ್ವನಿಯು ಜಲರಾಶಿಗಳ ಮೇಲೆ ಇದೆ;</para>
  <para style="q2" vid="PSA 29:3">ಮಹಿಮೆಯ ದೇವರು ಇದ್ದಾರೆ;</para>
  <para style="q2" vid="PSA 29:3">ಯೆಹೋವ ದೇವರು ಮಹಾಸಾಗರಗಳ ಮೇಲೆ ಇದ್ದಾರೆ.<verse eid="PSA 29:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 29:4"/>ಯೆಹೋವ ದೇವರ ಧ್ವನಿಯು ಶಕ್ತಿಯುಳ್ಳದ್ದು;</para>
  <para style="q2" vid="PSA 29:4">ಯೆಹೋವ ದೇವರ ಧ್ವನಿಯು ವೈಭವವುಳ್ಳದ್ದು.<verse eid="PSA 29:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 29:5"/>ಯೆಹೋವ ದೇವರ ಧ್ವನಿಯು ದೇವದಾರು ವೃಕ್ಷಗಳನ್ನು ಮುರಿಯುತ್ತದೆ;</para>
  <para style="q2" vid="PSA 29:5">ಯೆಹೋವ ದೇವರು ಲೆಬನೋನಿನ ದೇವದಾರು ವೃಕ್ಷಗಳನ್ನು ಮುರಿಯುತ್ತಾರೆ.<verse eid="PSA 29:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 29:6"/>ಲೆಬನೋನ್ ಪರ್ವತವು ಕರುವಿನ ಹಾಗೆಯೂ</para>
  <para style="q2" vid="PSA 29:6">ಸಿರ್ಯೋನ್ ಬೆಟ್ಟವು ಎಳೆಯ ಕಾಡುಕೋಣದ ಹಾಗೆಯೂ ಹಾರಾಡುವಂತೆ ಮಾಡುತ್ತಾರೆ.<verse eid="PSA 29:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 29:7"/>ಯೆಹೋವ ದೇವರ ಧ್ವನಿಯು</para>
  <para style="q2" vid="PSA 29:7">ಸಿಡಿಲಿನ ಮಿಂಚಿನಂತೆ ಅಪ್ಪಳಿಸುತ್ತದೆ.<verse eid="PSA 29:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 29:8"/>ಯೆಹೋವ ದೇವರ ಶಬ್ದವು ಮರುಭೂಮಿಯನ್ನು ನಡುಗಿಸುತ್ತದೆ;</para>
  <para style="q2" vid="PSA 29:8">ಯೆಹೋವ ದೇವರು ಕಾದೇಶ್ ಮರುಭೂಮಿಯನ್ನು ನಡುಗಿಸುತ್ತಾರೆ.<verse eid="PSA 29:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 29:9"/>ಯೆಹೋವ ದೇವರ ಧ್ವನಿಯು ಜಿಂಕೆಗಳು ಈಯುವಂತೆ ಮಾಡಿ</para>
  <para style="q2" vid="PSA 29:9">ಅಡವಿಗಳನ್ನು ಬಯಲು ಮಾಡುತ್ತದೆ;</para>
  <para style="q1" vid="PSA 29:9">ದೇವರ ಮಂದಿರದಲ್ಲಿ ಪ್ರತಿಯೊಬ್ಬರೂ “ಮಹಿಮೆ!” ಎಂದು ಘೋಷಿಸುತ್ತಾರೆ.<verse eid="PSA 29:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 29:10"/>ಯೆಹೋವ ದೇವರು ಪ್ರಳಯದ ಮೇಲೆ ಕುಳಿತುಕೊಳ್ಳುತ್ತಾರೆ;</para>
  <para style="q2" vid="PSA 29:10">ಯುಗಯುಗಕ್ಕೂ ಯೆಹೋವ ದೇವರು ಅರಸರಾಗಿ ಕುಳಿತುಕೊಂಡಿದ್ದಾರೆ.<verse eid="PSA 29:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 29:11"/>ಯೆಹೋವ ದೇವರು ತಮ್ಮ ಜನರಿಗೆ ಬಲವನ್ನು ಕೊಡುವರು;</para>
  <para style="q2" vid="PSA 29:11">ಯೆಹೋವ ದೇವರು ತಮ್ಮ ಜನರನ್ನು ಸಮಾಧಾನದಿಂದ ಆಶೀರ್ವದಿಸುವರು.<verse eid="PSA 29:11"/></para>
  <chapter eid="PSA 29"/>
  <chapter number="30" style="c" sid="PSA 30"/>
  <para style="cl">ಕೀರ್ತನೆ 30</para>
  <para style="d">ದೇವಾಲಯದ ಸಮರ್ಪಣೆಗಾಗಿ ದಾವೀದನು ಸಂಯೋಜಿಸಿದ ಹಾಡು. ದಾವೀದನ ಕೀರ್ತನೆ.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 30:1"/>ಯೆಹೋವ ದೇವರೇ, ನಿಮ್ಮನ್ನು ಕೊಂಡಾಡುವೆನು;</para>
  <para style="q2" vid="PSA 30:1">ನೀವು ನನ್ನ ಶತ್ರುಗಳು ನನ್ನ ವಿಷಯದಲ್ಲಿ ಸಂತೋಷಪಡದಂತೆ ಮಾಡಿದ್ದೀರಿ.</para>
  <para style="q2" vid="PSA 30:1">ನನ್ನನ್ನು ಮೇಲಕ್ಕೆ ಎತ್ತಿದ್ದೀರಿ.<verse eid="PSA 30:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 30:2"/>ನನ್ನ ದೇವರಾದ ಯೆಹೋವ ದೇವರೇ, ಸಹಾಯಕ್ಕಾಗಿ ನಿಮಗೆ ಮೊರೆಯಿಡಲು,</para>
  <para style="q2" vid="PSA 30:2">ನನ್ನನ್ನು ಸ್ವಸ್ಥಮಾಡಿದ್ದೀರಿ.<verse eid="PSA 30:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 30:3"/>ಯೆಹೋವ ದೇವರೇ, ನನ್ನ ಪ್ರಾಣವನ್ನು ಪಾತಾಳದೊಳಗಿಂದ ಎತ್ತಿದ್ದೀರಿ;</para>
  <para style="q2" vid="PSA 30:3">ನಾನು ಸಮಾಧಿ ಸೇರದ ಹಾಗೆ ನನ್ನನ್ನು ಬದುಕಿಸಿದ್ದೀರಿ.<verse eid="PSA 30:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 30:4"/>ಯೆಹೋವ ದೇವರ ವಿಶ್ವಾಸಿಗಳೇ ಅವರನ್ನು ಕೊಂಡಾಡಿರಿ;</para>
  <para style="q2" vid="PSA 30:4">ಅವರ ಪರಿಶುದ್ಧ ನಾಮವನ್ನು ಕೊಂಡಾಡಿರಿ.<verse eid="PSA 30:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 30:5"/>ಅವರ ಕೋಪವು ಕ್ಷಣಮಾತ್ರವೇ;</para>
  <para style="q2" vid="PSA 30:5">ಆದರೆ ಅವರ ದಯೆಯು ಜೀವಮಾನವೆಲ್ಲಾ ಇರುತ್ತದೆ;</para>
  <para style="q1" vid="PSA 30:5">ರಾತ್ರಿಯಲ್ಲಿ ದುಃಖ ಬಂದಿದ್ದರೂ;</para>
  <para style="q2" vid="PSA 30:5">ಬೆಳಿಗ್ಗೆ ಆನಂದವು ಬರುವುದು.<verse eid="PSA 30:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 30:6"/>ನಾನು ಸುರಕ್ಷಿತನಾಗಿದ್ದಾಗ,</para>
  <para style="q2" vid="PSA 30:6">“ನಾನೆಂದೂ ಕದಲುವುದಿಲ್ಲ,” ಎಂದು ಹೇಳಿಕೊಂಡೆನು.<verse eid="PSA 30:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 30:7"/>ಯೆಹೋವ ದೇವರೇ, ನಿಮ್ಮ ದಯೆಯಿಂದ</para>
  <para style="q2" vid="PSA 30:7">ನನ್ನ ರಾಜ ಬೆಟ್ಟವು ಸ್ಥಿರವಾಗಿ ನಿಲ್ಲುವಂತೆ ಮಾಡಿದ್ದೀರಿ</para>
  <para style="q1" vid="PSA 30:7">ಆದರೆ ನೀವು ನಿಮ್ಮ ಮುಖವನ್ನು ಮರೆಮಾಡಲು</para>
  <para style="q2" vid="PSA 30:7">ನಾನು ಕಳವಳಗೊಂಡೆನು.<verse eid="PSA 30:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 30:8"/>ಯೆಹೋವ ದೇವರೇ, ನಾನು ನಿಮಗೆ ಮೊರೆಯಿಟ್ಟೆನು;</para>
  <para style="q2" vid="PSA 30:8">ಕರುಣೆಗಾಗಿ ಯೆಹೋವ ಕರ್ತ ಆಗಿರುವವರಿಗೆ ಬಿನ್ನವಿಸಿದೆನು.<verse eid="PSA 30:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 30:9"/>ನಾನು ಸಮಾಧಿಯಲ್ಲಿ ಇಳಿದು ಹೋಗಿ ನಾಶವಾದರೆ,</para>
  <para style="q2" vid="PSA 30:9">ಅದರಿಂದ ನಿಮಗೆ ಆಗುವ ಲಾಭವೇನು?</para>
  <para style="q1" vid="PSA 30:9">ಧೂಳು ನಿಮ್ಮನ್ನು ಸ್ತುತಿಸುವುದೋ?</para>
  <para style="q2" vid="PSA 30:9">ಅದು ನಿಮ್ಮ ನಂಬಿಗಸ್ತಿಕೆಯನ್ನು ಪ್ರಕಟಿಸುವುದೋ?<verse eid="PSA 30:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 30:10"/>ಯೆಹೋವ ದೇವರೇ, ಲಾಲಿಸು; ನನ್ನನ್ನು ಕರುಣಿಸಿರಿ;</para>
  <para style="q2" vid="PSA 30:10">ಯೆಹೋವ ದೇವರೇ, ನನಗೆ ಸಹಾಯಕರಾಗಿರಿ.<verse eid="PSA 30:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 30:11"/>ನೀವು ನನ್ನ ಗೋಳಾಟವನ್ನು ಕುಣಿದಾಟಕ್ಕೆ ತಿರುಗಿಸಿದ್ದೀರಿ;</para>
  <para style="q2" vid="PSA 30:11">ನೀವು ನನ್ನ ಗೋಣಿತಟ್ಟನ್ನು ತೆಗೆದುಹಾಕಿ ಹರ್ಷವಸ್ತ್ರವನ್ನು ನನಗೆ ಧರಿಸಿದ್ದೀರಿ.<verse eid="PSA 30:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 30:12"/>ಆದ್ದರಿಂದ ನನ್ನ ಹೃದಯವು ಮೌನವಿರದೆ ನಿಮ್ಮನ್ನು ಯುಗಯುಗಕ್ಕೂ ಕೊಂಡಾಡುತ್ತಿರುವುದು.</para>
  <para style="q2" vid="PSA 30:12">ನನ್ನ ದೇವರಾದ ಯೆಹೋವ ದೇವರೇ, ನಾನು ನಿಮ್ಮನ್ನು ಸದಾಕಾಲವೂ ಸ್ತುತಿಸುವೆನು.<verse eid="PSA 30:12"/></para>
  <chapter eid="PSA 30"/>
  <chapter number="31" style="c" sid="PSA 31"/>
  <para style="cl">ಕೀರ್ತನೆ 31</para>
  <para style="d">ಸಂಗೀತ ನಿರ್ದೇಶಕನಿಗಾಗಿರುವ ಕೀರ್ತನೆ. ದಾವೀದನ ಕೀರ್ತನೆ.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 31:1"/>ಯೆಹೋವ ದೇವರೇ, ನಿಮ್ಮನ್ನೇ ಆಶ್ರಯಿಸಿಕೊಂಡಿದ್ದೇನೆ;</para>
  <para style="q2" vid="PSA 31:1">ನಾನು ಎಂದಿಗೂ ನಾಚಿಕೆಪಡದಂತೆ ಮಾಡಿರಿ;</para>
  <para style="q2" vid="PSA 31:1">ನಿಮ್ಮ ನೀತಿಯಲ್ಲಿ ನನ್ನನ್ನು ವಿಮೋಚಿಸಿರಿ.<verse eid="PSA 31:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 31:2"/>ನಿಮ್ಮ ಕಿವಿಯನ್ನು ನನ್ನ ಕಡೆಗೆ ತಿರುಗಿಸಿರಿ;</para>
  <para style="q2" vid="PSA 31:2">ಬೇಗ ಬಂದು ನನ್ನನ್ನು ಬಿಡಿಸಿರಿ;</para>
  <para style="q1" vid="PSA 31:2">ನನ್ನನ್ನು ರಕ್ಷಿಸುವುದಕ್ಕೆ ನನ್ನ ಆಶ್ರಯದ ಬಂಡೆಯೂ,</para>
  <para style="q2" vid="PSA 31:2">ಬಲವಾದ ಕೋಟೆಯೂ ಆಗಿರಿ.<verse eid="PSA 31:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 31:3"/>ನನ್ನ ಬಂಡೆಯೂ ನನ್ನ ಕೋಟೆಯೂ ನೀವೇ;</para>
  <para style="q2" vid="PSA 31:3">ನಿಮ್ಮ ಹೆಸರಿನ ನಿಮಿತ್ತ ನನ್ನನ್ನು ನಡೆಸಿರಿ; ನನಗೆ ಮಾರ್ಗದರ್ಶಕರಾಗಿರಿ.<verse eid="PSA 31:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 31:4"/>ವೈರಿಯು ಗುಪ್ತವಾಗಿ ಒಡ್ಡಿದ ಬಲೆಯೊಳಗಿಂದ ನನ್ನನ್ನು ಹೊರಗೆ ಎಳೆಯಿರಿ;</para>
  <para style="q2" vid="PSA 31:4">ನೀವೇ ನನಗೆ ಆಶ್ರಯ.<verse eid="PSA 31:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 31:5"/>ನಿಮ್ಮ ಕೈಗೆ ನನ್ನ ಆತ್ಮವನ್ನು ಒಪ್ಪಿಸಿದ್ದೇನೆ;</para>
  <para style="q2" vid="PSA 31:5">ನಂಬಿಗಸ್ತದ ದೇವರಾದ ನನ್ನ ಯೆಹೋವ ದೇವರೇ, ನೀವು ನನ್ನನ್ನು ವಿಮೋಚಿಸಿದ್ದೀರಿ.<verse eid="PSA 31:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 31:6"/>ದೇವರಲ್ಲದವುಗಳನ್ನು ಅನುಸರಿಸುವವರಿಂದ ನಾನು ಪ್ರತ್ಯೇಕವಾಗಿದ್ದೇನೆ;</para>
  <para style="q2" vid="PSA 31:6">ನಾನು ಯೆಹೋವ ದೇವರಲ್ಲಿಯೇ ಭರವಸೆ ಇಟ್ಟಿದ್ದೇನೆ.<verse eid="PSA 31:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 31:7"/>ನಿಮ್ಮ ಒಡಂಬಡಿಕೆಯ ಪ್ರೀತಿಯಲ್ಲಿ ಉಲ್ಲಾಸಿಸಿ ಸಂತೋಷ ಪಡುವೆನು;</para>
  <para style="q2" vid="PSA 31:7">ಏಕೆಂದರೆ ನೀವು ನನ್ನ ಕಷ್ಟಗಳನ್ನು ಲಕ್ಷ್ಯಕ್ಕೆ ತಂದು,</para>
  <para style="q2" vid="PSA 31:7">ನನ್ನ ಪ್ರಾಣದ ಸಂಕಟಗಳನ್ನು ಅರಿತಿದ್ದೀರಿ.<verse eid="PSA 31:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 31:8"/>ಶತ್ರುವಿನ ಕೈಯಲ್ಲಿ ನನ್ನನ್ನು ಒಪ್ಪಿಸಿ ಬಿಡಲಿಲ್ಲ;</para>
  <para style="q2" vid="PSA 31:8">ನನ್ನ ಪಾದಗಳನ್ನು ವಿಶಾಲವಾದ ಸ್ಥಳದಲ್ಲಿ ನಿಲ್ಲಿಸಿದ್ದೀರಿ.<verse eid="PSA 31:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 31:9"/>ಯೆಹೋವ ದೇವರೇ, ನನ್ನನ್ನು ಕರುಣಿಸಿರಿ, ನಾನು ಇಕ್ಕಟ್ಟಿನಲ್ಲಿದ್ದೇನೆ;</para>
  <para style="q2" vid="PSA 31:9">ನನ್ನ ಕಣ್ಣೂ ನನ್ನ ಪ್ರಾಣವೂ</para>
  <para style="q2" vid="PSA 31:9">ನನ್ನ ದೇಹವೂ ದುಃಖದಿಂದ ಕ್ಷೀಣವಾಗಿವೆ.<verse eid="PSA 31:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 31:10"/>ನನ್ನ ಜೀವವು ಚಿಂತೆಯಿಂದಲೂ,</para>
  <para style="q2" vid="PSA 31:10">ನನ್ನ ವರ್ಷಗಳು ನಿಟ್ಟುಸಿರಿನಿಂದಲೂ ಕಳೆದುಹೋಗಿವೆ;</para>
  <para style="q1" vid="PSA 31:10">ನನ್ನ ಅಪರಾಧದಿಂದ ನನ್ನ ಶಕ್ತಿಯು ಕುಂದಿಹೋಗಿದೆ;</para>
  <para style="q2" vid="PSA 31:10">ನನ್ನ ಎಲುಬುಗಳು ಕ್ಷೀಣವಾಗಿವೆ.<verse eid="PSA 31:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 31:11"/>ನನ್ನ ವೈರಿಗಳೆಲ್ಲರ ನಿಮಿತ್ತವಾಗಿ</para>
  <para style="q2" vid="PSA 31:11">ನನ್ನ ನೆರೆಯವರಿಗೆ ನಾನು ನಿಂದೆಯೂ,</para>
  <para style="q1" vid="PSA 31:11">ಮಿತ್ರರಿಗೆ ಹೆದರಿಕೆಯೂ ಆಗಿದ್ದೇನೆ;</para>
  <para style="q2" vid="PSA 31:11">ದಾರಿಯಲ್ಲಿ ನನ್ನನ್ನು ಕಂಡವರು ನನ್ನನ್ನು ಬಿಟ್ಟು ಓಡಿಹೋಗುತ್ತಾರೆ.<verse eid="PSA 31:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 31:12"/>ನಾನು ಸತ್ತುಹೋದವರಂತೆ ಎಲ್ಲರು ನನ್ನನ್ನು ಮರೆತುಬಿಟ್ಟಿದ್ದಾರೆ;</para>
  <para style="q2" vid="PSA 31:12">ನಾನು ಒಡೆದ ಮಡಕೆಯಂತೆ ಇದ್ದೇನೆ.<verse eid="PSA 31:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 31:13"/>ಅನೇಕರು ಹೀಗೆ ಪಿಸುಗುಟ್ಟುವುದನ್ನು ಕೇಳಿದ್ದೇನೆ.</para>
  <para style="q2" vid="PSA 31:13">ಸುತ್ತಲೂ ಅಂಜಿಕೆ ಇದೆ;</para>
  <para style="q1" vid="PSA 31:13">ಅನೇಕರು ನನ್ನ ಪ್ರಾಣವನ್ನು ತೆಗೆಯಬೇಕೆಂದು</para>
  <para style="q2" vid="PSA 31:13">ಒಳಸಂಚು ಮಾಡುತ್ತಿದ್ದಾರೆ.<verse eid="PSA 31:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 31:14"/>ಯೆಹೋವ ದೇವರೇ, ನಾನು ನಿಮ್ಮಲ್ಲಿ ಭರವಸೆ ಇಟ್ಟಿದ್ದೇನೆ;</para>
  <para style="q2" vid="PSA 31:14">“ನನ್ನ ದೇವರು ನೀವೇ,” ಎಂದು ಹೇಳಿಕೊಂಡಿದ್ದೇನೆ.<verse eid="PSA 31:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 31:15"/>ನನ್ನ ಸಮಯವು ನಿಮ್ಮ ಕೈಯಲ್ಲಿ ಇವೆ;</para>
  <para style="q2" vid="PSA 31:15">ನನ್ನ ಶತ್ರುಗಳ ಕೈಯಿಂದಲೂ</para>
  <para style="q2" vid="PSA 31:15">ಹಿಂಸೆಪಡಿಸುವವರಿಂದಲೂ ನನ್ನನ್ನು ಬಿಡಿಸಿರಿ.<verse eid="PSA 31:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 31:16"/>ನಿಮ್ಮ ಮುಖವು ನಿಮ್ಮ ಸೇವಕನ ಮೇಲೆ ಪ್ರಕಾಶಿಸಲಿ;</para>
  <para style="q2" vid="PSA 31:16">ನಿಮ್ಮ ಒಡಂಬಡಿಕೆಯ ಪ್ರೀತಿಯಿಂದ ನನ್ನನ್ನು ರಕ್ಷಿಸಿರಿ.<verse eid="PSA 31:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 31:17"/>ಯೆಹೋವ ದೇವರೇ, ನಾನು ನಾಚಿಕೆಪಡದಂತೆ ಮಾಡಿರಿ;</para>
  <para style="q2" vid="PSA 31:17">ನಾನು ನಿಮಗೆ ಮೊರೆಯಿಟ್ಟಿದ್ದೇನೆ;</para>
  <para style="q1" vid="PSA 31:17">ದುಷ್ಟರು ನಾಚಿಕೆಪಡಲಿ;</para>
  <para style="q2" vid="PSA 31:17">ಅವರು ಸಮಾಧಿ ಸೇರಲಿ.<verse eid="PSA 31:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 31:18"/>ನೀತಿವಂತರ ಮೇಲೆ ಗರ್ವದಿಂದಲೂ ತಿರಸ್ಕಾರದಿಂದಲೂ,</para>
  <para style="q2" vid="PSA 31:18">ಕಠಿಣವಾಗಿಯೂ ಮಾತನಾಡುವ</para>
  <para style="q2" vid="PSA 31:18">ಸುಳ್ಳಿನ ತುಟಿಗಳು ಮೌನವಾಗಲಿ.<verse eid="PSA 31:18"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 31:19"/>ನಿಮ್ಮ ಒಳ್ಳೆಯತನವು ಎಷ್ಟೋ ಸಮೃದ್ಧ;</para>
  <para style="q2" vid="PSA 31:19">ನೀವು ನಿಮಗೆ ಭಯಪಡುವವರಿಗೋಸ್ಕರ ಆ ಒಳ್ಳೆಯತನವನ್ನಿಟ್ಟಿದ್ದೀರಿ,</para>
  <para style="q1" vid="PSA 31:19">ನಿಮ್ಮನ್ನು ಆಶ್ರಯಿಸಿಕೊಳ್ಳುವವರಿಗೆ</para>
  <para style="q2" vid="PSA 31:19">ನೀವು ನಿಮ್ಮ ಒಳ್ಳೆಯತನವನ್ನು ಎಲ್ಲರ ಮುಂದೆ ದಯಪಾಲಿಸಿದ್ದೀರಿ.<verse eid="PSA 31:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 31:20"/>ಮನುಷ್ಯರ ಒಳಸಂಚುಗಳಿಂದ ಹಾನಿ ಉಂಟಾಗದಂತೆ</para>
  <para style="q2" vid="PSA 31:20">ನೀವು ಅವರನ್ನು ನಿಮ್ಮ ಸಾನಿಧ್ಯದಲ್ಲಿಯೇ ಮರೆಮಾಡುತ್ತೀರಿ;</para>
  <para style="q1" vid="PSA 31:20">ವಿವಾದಿಸುವ ನಾಲಿಗೆಗಳಿಂದ ಕೇಡಾಗದಂತೆ</para>
  <para style="q2" vid="PSA 31:20">ಅವರನ್ನು ನಿಮ್ಮ ನಿವಾಸದಲ್ಲಿ ಅಡಗಿಸುತ್ತೀರಿ.<verse eid="PSA 31:20"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 31:21"/>ಯೆಹೋವ ದೇವರಿಗೆ ಸ್ತುತಿಯುಂಟಾಗಲಿ;</para>
  <para style="q2" vid="PSA 31:21">ಮುತ್ತಿಗೆ ಹಾಕಲಾದ ನಗರದಲ್ಲಿದ್ದ ನನಗೆ</para>
  <para style="q2" vid="PSA 31:21">ದೇವರು ಆಶ್ಚರ್ಯಕರವಾದ ಒಡಂಬಡಿಕೆಯ ಪ್ರೀತಿಯನ್ನು ತೋರಿಸಿದ್ದಾರೆ.<verse eid="PSA 31:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 31:22"/>“ನಾನು ನಿಮ್ಮ ಕಣ್ಣುಗಳ ಎದುರಿನಿಂದ ತೆಗೆದು ಹಾಕಲಾಗಿದ್ದೇನೆ” ಎಂದು</para>
  <para style="q2" vid="PSA 31:22">ನನ್ನ ಗಾಬರಿಯಲ್ಲಿ ಹೇಳಿದೆನು;</para>
  <para style="q1" vid="PSA 31:22">ಆದರೂ ನಾನು ಸಹಾಯಕ್ಕಾಗಿ ನಿಮಗೆ ಮೊರೆಯಿಡಲು</para>
  <para style="q2" vid="PSA 31:22">ನೀವು ಕರುಣೆಗಾಗಿ ಕೂಗಿದ್ದನ್ನು ಕೇಳಿದ್ದೀರಿ.<verse eid="PSA 31:22"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 31:23"/>ಭಕ್ತರೇ, ಯೆಹೋವ ದೇವರನ್ನು ಪ್ರೀತಿಸಿರಿ;</para>
  <para style="q2" vid="PSA 31:23">ಯೆಹೋವ ದೇವರು ನಂಬಿಗಸ್ತರನ್ನು ಕಾಯುತ್ತಾರೆ;</para>
  <para style="q2" vid="PSA 31:23">ಅಹಂಕಾರಿಗೆ ಮುಯ್ಯಿಗೆ ಮುಯ್ಯಿ ತೀರಿಸುತ್ತಾರೆ.<verse eid="PSA 31:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 31:24"/>ಯೆಹೋವ ದೇವರಲ್ಲಿ ನಿರೀಕ್ಷಿಸುವವರೆಲ್ಲರೂ ದೃಢವಾಗಿರಿ;</para>
  <para style="q2" vid="PSA 31:24">ನಿಮ್ಮ ಹೃದಯವು ಧೈರ್ಯದಿಂದ ಇರಲಿ.<verse eid="PSA 31:24"/></para>
  <chapter eid="PSA 31"/>
  <chapter number="32" style="c" sid="PSA 32"/>
  <para style="cl">ಕೀರ್ತನೆ 32</para>
  <para style="d">ದಾವೀದನ ಕೀರ್ತನೆ. <char style="tl">ಮಾಸ್ಕಿಲ</char><note caller="+" style="f"><char style="fr" closed="false">32:0 </char><char style="fq" closed="false">ಮಾಸ್ಕಿಲ </char><char style="ft" closed="false">ಬಹುಶಃ </char><char style="fqa" closed="false">ಸಾಹಿತ್ಯಿಕ </char><char style="ft" closed="false">ಅಥವಾ </char><char style="fqa" closed="false">ಸಂಗೀತ ಪದ</char></note> ಪದ್ಯ.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 32:1"/>ಯಾರ ಉಲ್ಲಂಘನೆಗಳು ಕ್ಷಮಿಸಲಾಗಿವೆಯೋ,</para>
  <para style="q2" vid="PSA 32:1">ಯಾರ ಪಾಪಗಳು ಮುಚ್ಚಲಾಗಿವೆಯೋ</para>
  <para style="q2" vid="PSA 32:1">ಅವರೇ ಧನ್ಯರು.<verse eid="PSA 32:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 32:2"/>ಯೆಹೋವ ದೇವರು ಯಾರ ಅನ್ಯಾಯವನ್ನು ಎಣಿಸುವುದಿಲ್ಲವೋ,</para>
  <para style="q2" vid="PSA 32:2">ಯಾರ ಆತ್ಮದಲ್ಲಿ ವಂಚನೆ ಇರುವುದಿಲ್ಲವೋ</para>
  <para style="q2" vid="PSA 32:2">ಆ ಮನುಷ್ಯನು ಧನ್ಯನು.<verse eid="PSA 32:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 32:3"/>ನಾನು ನನ್ನ ಪಾಪವನ್ನು ಅರಿಕೆ ಮಾಡದೆ ಇದ್ದಾಗ,</para>
  <para style="q2" vid="PSA 32:3">ದಿನವೆಲ್ಲಾ ನರಳುವುದರಿಂದ</para>
  <para style="q2" vid="PSA 32:3">ನನ್ನ ಎಲುಬುಗಳು ಸವೆದು ಹೋದವು.<verse eid="PSA 32:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 32:4"/>ದೇವರೇ, ರಾತ್ರಿ ಹಗಲು</para>
  <para style="q2" vid="PSA 32:4">ನಿಮ್ಮ ಕೈ ನನ್ನ ಮೇಲೆ ಭಾರವಾಗಿತ್ತು;</para>
  <para style="q1" vid="PSA 32:4">ನನ್ನ ಬಲವು ಬೇಸಿಗೆಯ ಬಿಸಿಲಿನಲ್ಲಿ</para>
  <para style="q2" vid="PSA 32:4">ಕುಂದಿಹೋಗುವಂತೆ ಆಯಿತು.<verse eid="PSA 32:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 32:5"/>ನನ್ನ ಪಾಪವನ್ನು ನಿಮಗೆ ತಿಳಿಸಿ,</para>
  <para style="q2" vid="PSA 32:5">ನನ್ನ ಅನ್ಯಾಯವನ್ನು ಮರೆಮಾಡದೆ,</para>
  <para style="q1" vid="PSA 32:5">“ನನ್ನ ಉಲ್ಲಂಘನೆಗಳನ್ನು ಯೆಹೋವ ದೇವರಿಗೆ</para>
  <para style="q2" vid="PSA 32:5">ಅರಿಕೆ ಮಾಡುವೆನು,” ಎಂದು ಹೇಳಿದೆನು;</para>
  <para style="q1" vid="PSA 32:5">ಆಗ, ನೀವು</para>
  <para style="q2" vid="PSA 32:5">ನನ್ನ ಪಾಪದ ಅಪರಾಧವನ್ನು ಪರಿಹರಿಸಿದಿರಿ.<verse eid="PSA 32:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 32:6"/>ಆದುದರಿಂದ ಭಕ್ತರೆಲ್ಲರು ನೀವು</para>
  <para style="q2" vid="PSA 32:6">ಸಿಕ್ಕುವ ಕಾಲದಲ್ಲಿ ನಿಮಗೆ ಪ್ರಾರ್ಥನೆ ಮಾಡಲಿ;</para>
  <para style="q1" vid="PSA 32:6">ನಿಶ್ಚಯವಾಗಿ ನೀರಿನ ಮಹಾಪ್ರವಾಹಗಳು</para>
  <para style="q2" vid="PSA 32:6">ಅವರ ಸಮೀಪಕ್ಕೆ ಬರುವುದಿಲ್ಲ.<verse eid="PSA 32:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 32:7"/>ನೀವು ನನಗೆ ಮರೆಮಾಡುವ ಸ್ಥಳವಾಗಿರುವಿರಿ;</para>
  <para style="q2" vid="PSA 32:7">ಇಕ್ಕಟ್ಟಿನಿಂದ ನನ್ನನ್ನು ಕಾಯುತ್ತೀರಿ;</para>
  <para style="q2" vid="PSA 32:7">ವಿಮೋಚನಾ ಧ್ವನಿಗಳಿಂದ ನೀವು ನನ್ನನ್ನು ಸುತ್ತುವರಿಯುತ್ತೀರಿ.<verse eid="PSA 32:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 32:8"/>ಯೆಹೋವ ದೇವರು ಹೇಳುವುದೇನೆಂದರೆ: ನಾನು ನಿನಗೆ ಬುದ್ಧಿ ಹೇಳಿ,</para>
  <para style="q2" vid="PSA 32:8">ನೀನು ಹೋಗತಕ್ಕ ಮಾರ್ಗವನ್ನು ನಿನಗೆ ಬೋಧಿಸುವೆನು;</para>
  <para style="q2" vid="PSA 32:8">ನನ್ನ ಮೆಚ್ಚುಗೆಯಿಂದ ನಿನ್ನನ್ನು ನಡೆಸುವೆನು.<verse eid="PSA 32:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 32:9"/>ವಿವೇಕವಿಲ್ಲದ ಕುದುರೆಯ ಹಾಗೆಯೂ,</para>
  <para style="q2" vid="PSA 32:9">ಹೇಸರಗತ್ತೆಯ ಹಾಗೆಯೂ ಇರಬೇಡಿರಿ;</para>
  <para style="q1" vid="PSA 32:9">ಬಾರಿನಿಂದಲೂ, ಕಡಿವಾಣದಿಂದಲೂ ಅವುಗಳನ್ನು ನಿಯಂತ್ರಿಸಬೇಕು,</para>
  <para style="q2" vid="PSA 32:9">ಇಲ್ಲದಿದ್ದರೆ ಅವು ನಿಮ್ಮ ಅಧೀನಕ್ಕೆ ಬರುವುದಿಲ್ಲ.<verse eid="PSA 32:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 32:10"/>ದುಷ್ಟರಿಗೆ ವ್ಯಥೆಗಳು ಬಹಳ;</para>
  <para style="q2" vid="PSA 32:10">ಆದರೆ ಯೆಹೋವ ದೇವರಲ್ಲಿ ಭರವಸವಿಡುವವನನ್ನು</para>
  <para style="q2" vid="PSA 32:10">ಅದರ ಒಂಡಬಡಿಕೆಯ ಪ್ರೀತಿಯು ಸುತ್ತುವರಿಯುವುದು.<verse eid="PSA 32:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 32:11"/>ನೀತಿವಂತರೇ, ಯೆಹೋವ ದೇವರಲ್ಲಿ ಸಂತೋಷಿಸಿರಿ, ಉಲ್ಲಾಸಪಡಿರಿ;</para>
  <para style="q2" vid="PSA 32:11">ಯಥಾರ್ಥ ಹೃದಯ ಉಳ್ಳವರೇ, ಜಯಗೀತೆ ಹಾಡಿರಿ.<verse eid="PSA 32:11"/></para>
  <chapter eid="PSA 32"/>
  <chapter number="33" style="c" sid="PSA 33"/>
  <para style="cl">ಕೀರ್ತನೆ 33</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 33:1"/>ನೀತಿವಂತರೇ, ಯೆಹೋವ ದೇವರಿಗಾಗಿ ಸಂತೋಷದಿಂದ ಹಾಡಿರಿ;</para>
  <para style="q2" vid="PSA 33:1">ಯಥಾರ್ಥರು ಅವರನ್ನು ಕೊಂಡಾಡುವುದು ಯೋಗ್ಯವಾಗಿದೆ.<verse eid="PSA 33:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 33:2"/>ಯೆಹೋವ ದೇವರನ್ನು ಕಿನ್ನರಿಯಿಂದ ಕೊಂಡಾಡಿರಿ;</para>
  <para style="q2" vid="PSA 33:2">ಹತ್ತು ತಂತಿಗಳ ವೀಣೆಯಿಂದ ಅವರನ್ನು ಕೀರ್ತಿಸಿರಿ.<verse eid="PSA 33:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 33:3"/>ದೇವರಿಗೆ ಹೊಸಹಾಡನ್ನು ಹಾಡಿರಿ.</para>
  <para style="q2" vid="PSA 33:3">ದೊಡ್ಡ ಶಬ್ದದಿಂದ ಇಂಪಾಗಿ ಹಾಡಿರಿ.<verse eid="PSA 33:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 33:4"/>ಏಕೆಂದರೆ ಯೆಹೋವ ದೇವರ ವಾಕ್ಯವು ಯಥಾರ್ಥವೂ ಸತ್ಯವೂ ಆಗಿರುತ್ತವೆ.</para>
  <para style="q2" vid="PSA 33:4">ಅವರ ಮಾಡುವ ಎಲ್ಲಾ ಕೆಲಸಗಳಲ್ಲಿಯೂ ನಂಬಿಗಸ್ತರಾಗಿರುತ್ತಾರೆ.<verse eid="PSA 33:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 33:5"/>ಅವರು ನೀತಿಯನ್ನೂ, ನ್ಯಾಯವನ್ನೂ ಪ್ರೀತಿಸುತ್ತಾರೆ;</para>
  <para style="q2" vid="PSA 33:5">ಭೂಲೋಕವೆಲ್ಲಾ ಯೆಹೋವ ದೇವರ ಒಡಂಬಡಿಕೆಯ ಪ್ರೀತಿಯಿಂದ ತುಂಬಿದೆ.<verse eid="PSA 33:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 33:6"/>ಯೆಹೋವ ದೇವರ ವಾಕ್ಯದಿಂದ ಆಕಾಶವೂ,</para>
  <para style="q2" vid="PSA 33:6">ಅವರ ಬಾಯಿಯ ಉಸಿರಿನಿಂದ ನಕ್ಷತ್ರ ಮಂಡಲವೂ ಉಂಟಾದವು.<verse eid="PSA 33:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 33:7"/>ಅವರು ಸಮುದ್ರದ ನೀರನ್ನು ಒಟ್ಟುಗೂಡಿಸುತ್ತಾರೆ;</para>
  <para style="q2" vid="PSA 33:7">ಅವರು ಅಗಾಧವನ್ನು ಉಗ್ರಾಣಗಳಲ್ಲಿ ಇಡುತ್ತಾರೆ.<verse eid="PSA 33:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 33:8"/>ಭೂಲೋಕವೆಲ್ಲಾ ಯೆಹೋವ ದೇವರಿಗೆ ಭಯಪಡಲಿ;</para>
  <para style="q2" vid="PSA 33:8">ಭೂಲೋಕ ನಿವಾಸಿಗಳೆಲ್ಲರೂ ಅವರಿಗೆ ಭಯಭಕ್ತಿಯಿಂದಿರಲಿ.<verse eid="PSA 33:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 33:9"/>ಏಕೆಂದರೆ ಅವರು ಹೇಳಿದ ಮಾತ್ರಕ್ಕೆ ಸಮಸ್ತವೂ ಸೃಷ್ಟಿಯಾಯಿತು;</para>
  <para style="q2" vid="PSA 33:9">ಅವರು ಆಜ್ಞಾಪಿಸಲು ಭೂಲೋಕವು ಸ್ಥಿರವಾಯಿತು.<verse eid="PSA 33:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 33:10"/>ಯೆಹೋವ ದೇವರು ಜನಾಂಗಗಳ ಆಲೋಚನೆಯನ್ನು ವ್ಯರ್ಥ ಮಾಡುವರು;</para>
  <para style="q2" vid="PSA 33:10">ಜನರ ದುರುದ್ದೇಶಗಳನ್ನು ನಿಷ್ಪಲ ಮಾಡುತ್ತಾರೆ.<verse eid="PSA 33:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 33:11"/>ಆದರೆ ಯೆಹೋವ ದೇವರ ಆಲೋಚನೆಗಳು ಎಂದೆಂದಿಗೂ</para>
  <para style="q2" vid="PSA 33:11">ಅವರ ಹೃದಯದ ಉದ್ದೇಶಗಳು ತಲತಲಾಂತರಕ್ಕೂ ನಿಲ್ಲುತ್ತವೆ.<verse eid="PSA 33:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 33:12"/>ಯೆಹೋವ ದೇವರು ಯಾರ ದೇವರಾಗಿದ್ದಾರೋ, ಅಂಥ ಭಾಗ್ಯವಂತರು.</para>
  <para style="q2" vid="PSA 33:12">ದೇವರು ತಮಗಾಗಿ ಆಯ್ದುಕೊಂಡ ಜನರೂ ಭಾಗ್ಯವಂತರು.<verse eid="PSA 33:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 33:13"/>ಪರಲೋಕದಿಂದ ಯೆಹೋವ ದೇವರು ದೃಷ್ಟಿಸಿ,</para>
  <para style="q2" vid="PSA 33:13">ಮಾನವರೆಲ್ಲರನ್ನೂ ನೋಡುತ್ತಾರೆ.<verse eid="PSA 33:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 33:14"/>ತಮ್ಮ ನಿವಾಸ ಸ್ಥಳದಿಂದ</para>
  <para style="q2" vid="PSA 33:14">ಭೂನಿವಾಸಿಗಳೆಲ್ಲರ ಮೇಲೆ ಕಣ್ಣಿಡುತ್ತಾರೆ.<verse eid="PSA 33:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 33:15"/>ಎಲ್ಲರ ಹೃದಯಗಳನ್ನು ರೂಪಿಸುವವರು ದೇವರೇ,</para>
  <para style="q2" vid="PSA 33:15">ಜನರು ಮಾಡುವ ಕೆಲಸಗಳನ್ನೆಲ್ಲಾ ಗಮನಿಸುವವರೂ ಅವರೇ.<verse eid="PSA 33:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 33:16"/>ಅಧಿಕ ಸೈನ್ಯದಿಂದ ಅರಸನು ಜಯಹೊಂದುವುದಿಲ್ಲ;</para>
  <para style="q2" vid="PSA 33:16">ಪರಾಕ್ರಮಶಾಲಿಯು ಅಧಿಕ ಶಕ್ತಿಯಿಂದ ಬಿಡುಗಡೆಯಾಗುವುದಿಲ್ಲ.<verse eid="PSA 33:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 33:17"/>ಬಿಡುಗಡೆಗೆ ಕುದುರೆಯ ಬಲ ವ್ಯರ್ಥವಾಗಿದೆ;</para>
  <para style="q2" vid="PSA 33:17">ಅದಕ್ಕೆ ಮಹಾಶಕ್ತಿ ಇದ್ದರೂ ಅದು ರಕ್ಷಿಸಲಾರದು.<verse eid="PSA 33:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 33:18"/>ಯೆಹೋವ ದೇವರ ಕಣ್ಣು ತಮಗೆ ಭಯಪಡುವವರ ಮೇಲಿರುತ್ತದೆ,</para>
  <para style="q2" vid="PSA 33:18">ಅವರ ಒಡಂಬಡಿಕೆಯ ಪ್ರೀತಿಯನ್ನು ಎದುರು ನೋಡುವವರ ಮೇಲೆಯೂ ಇರುತ್ತೆ.<verse eid="PSA 33:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 33:19"/>ಇದರಿಂದ ದೇವರು ಅವರ ಪ್ರಾಣವನ್ನು ಮರಣದಿಂದ ಬಿಡಿಸಿ,</para>
  <para style="q2" vid="PSA 33:19">ಬರಗಾಲದಲ್ಲಿ ಅವರ ಜೀವವನ್ನು ಕಾಪಾಡುತ್ತಾರೆ.<verse eid="PSA 33:19"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 33:20"/>ನಮ್ಮ ಪ್ರಾಣವು ಯೆಹೋವ ದೇವರಿಗಾಗಿ ಕಾದಿದೆ;</para>
  <para style="q2" vid="PSA 33:20">ನಮ್ಮ ಸಹಾಯವೂ ನಮ್ಮ ಗುರಾಣಿಯೂ ಅವರೇ.<verse eid="PSA 33:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 33:21"/>ದೇವರಲ್ಲಿ ನಮ್ಮ ಹೃದಯವು ಸಂತೋಷಿಸುತ್ತದೆ;</para>
  <para style="q2" vid="PSA 33:21">ನಾವು ಅವರ ಪರಿಶುದ್ಧ ಹೆಸರಿನಲ್ಲಿ ಭರವಸೆ ಇಟ್ಟಿದ್ದೇವೆ.<verse eid="PSA 33:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 33:22"/>ನಾವು ನಿಮ್ಮನ್ನು ನಿರೀಕ್ಷಿಸುವ ಪ್ರಕಾರ, ಯೆಹೋವ ದೇವರೇ,</para>
  <para style="q2" vid="PSA 33:22">ನಿಮ್ಮ ಒಡಂಬಡಿಕೆಯ ಪ್ರೀತಿಯು ನಮ್ಮ ಮೇಲೆ ಇರಲಿ.<verse eid="PSA 33:22"/></para>
  <chapter eid="PSA 33"/>
  <chapter number="34" style="c" sid="PSA 34"/>
  <para style="cl">ಕೀರ್ತನೆ 34<note caller="+" style="f"><char style="fr" closed="false">34:0 </char><char style="ft" closed="false">ಹೀಬ್ರೂ ಅಕ್ಷರ ಕ್ರಮಾನುಸಾರವಾದ ಪ್ರಾರ್ಥನೆ.</char></note></para>
  <para style="d">ದಾವೀದನು ಅಬೀಮೆಲೆಕನ ಎದುರಿನಲ್ಲಿ ಹುಚ್ಚನಂತೆ ತೋರ್ಪಡಿಸಿಕೊಂಡು ಅವನ ಬಳಿಯಿಂದ ಹೊರಕ್ಕೆ ಕಳುಹಿಸಿ ರಚಿಸಿದ ಕೀರ್ತನೆ.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 34:1"/>ನಾನು ಎಲ್ಲಾ ಕಾಲಗಳಲ್ಲಿ ಯೆಹೋವ ದೇವರನ್ನು ಸ್ತುತಿಸುವೆನು;</para>
  <para style="q2" vid="PSA 34:1">ಅವರ ಸ್ತೋತ್ರವು ಯಾವಾಗಲೂ ನನ್ನ ಬಾಯಲ್ಲಿ ಇರುವುದು.<verse eid="PSA 34:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 34:2"/>ಯೆಹೋವ ದೇವರಲ್ಲಿ ನನ್ನ ಪ್ರಾಣವು ಹಿಗ್ಗುವುದು;</para>
  <para style="q2" vid="PSA 34:2">ಇದನ್ನು ದೀನರು ಕೇಳಿ ಸಂತೋಷಪಡುವರು.<verse eid="PSA 34:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 34:3"/>ನನ್ನ ಸಂಗಡ ಯೆಹೋವ ದೇವರನ್ನು ಮಹಿಮೆಪಡಿಸಿರಿ;</para>
  <para style="q2" vid="PSA 34:3">ನಾವು ಒಟ್ಟಾಗಿ ಅವರ ಹೆಸರನ್ನು ಘನಪಡಿಸೋಣ.<verse eid="PSA 34:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 34:4"/>ನಾನು ಯೆಹೋವ ದೇವರನ್ನು ಹುಡುಕಿದೆನು; ಆಗ ಅವರು ನನಗೆ ಉತ್ತರಕೊಟ್ಟು,</para>
  <para style="q2" vid="PSA 34:4">ಸಕಲ ಭೀತಿಗಳಿಂದ ನನ್ನನ್ನು ಬಿಡಿಸಿದರು.<verse eid="PSA 34:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 34:5"/>ದೇವರನ್ನು ದೃಷ್ಟಿಸಿದವರು ಪ್ರಕಾಶ ಹೊಂದಿದರು;</para>
  <para style="q2" vid="PSA 34:5">ಅಂಥವರ ಮುಖಗಳು ನಾಚಿಕೆಯಿಂದ ಕುಂದಿಹೋಗುವುದಿಲ್ಲ.<verse eid="PSA 34:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 34:6"/>ಬಡವನಾದ ನಾನು ಕರೆಯಲು ಯೆಹೋವ ದೇವರು ಕೇಳಿ</para>
  <para style="q2" vid="PSA 34:6">ನನ್ನ ಎಲ್ಲಾ ಇಕ್ಕಟ್ಟುಗಳೊಳಗಿಂದ ನನ್ನನ್ನು ರಕ್ಷಿಸಿದರು.<verse eid="PSA 34:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 34:7"/>ದೇವರಿಗೆ ಭಯಪಡುವವರ ಸುತ್ತಲೂ ಯೆಹೋವ ದೇವರ ದೂತನು ಇಳಿದುಕೊಂಡು</para>
  <para style="q2" vid="PSA 34:7">ಅವರನ್ನು ಕಾಪಾಡುತ್ತಾನೆ.<verse eid="PSA 34:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 34:8"/>ಯೆಹೋವ ದೇವರು ಒಳ್ಳೆಯವರೆಂದು ರುಚಿಸಿ ನೋಡಿರಿ;</para>
  <para style="q2" vid="PSA 34:8">ಅವರನ್ನು ಆಶ್ರಯಿಸುವ ಮನುಷ್ಯನು ಭಾಗ್ಯವಂತನು.<verse eid="PSA 34:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 34:9"/>ದೇವರ ಭಕ್ತರೇ, ನೀವು ಯೆಹೋವ ದೇವರಿಗೆ ಭಯಪಡಿರಿ;</para>
  <para style="q2" vid="PSA 34:9">ಏಕೆಂದರೆ ದೇವಭಕ್ತಿಯುಳ್ಳವರಿಗೆ ಯಾವ ಕೊರತೆಯೂ ಇಲ್ಲ.<verse eid="PSA 34:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 34:10"/>ಸಿಂಹಗಳು ಹಸಿದು ಬಳಲಬಹುದು,</para>
  <para style="q2" vid="PSA 34:10">ಆದರೆ ಯೆಹೋವ ದೇವರನ್ನು ಹುಡುಕುವವರಿಗೆ ಯಾವ ಒಳ್ಳೆಯದರ ಕೊರತೆಯೂ ಇರುವುದಿಲ್ಲ.<verse eid="PSA 34:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 34:11"/>ಮಕ್ಕಳೇ, ನೀವು ಬಂದು ನನ್ನ ಮಾತನ್ನು ಕೇಳಿರಿ;</para>
  <para style="q2" vid="PSA 34:11">ನಾನು ಯೆಹೋವ ದೇವರ ಬಗ್ಗೆ ಭಯವನ್ನು ನಿಮಗೆ ಕಲಿಸುವೆನು.<verse eid="PSA 34:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 34:12"/>ನಿಮ್ಮಲ್ಲಿ ಜೀವನವನ್ನು ಪ್ರೀತಿಸುವವನು</para>
  <para style="q2" vid="PSA 34:12">ಮತ್ತು ಬಹಳ ದಿನಗಳವರೆಗೆ ಬದುಕಬೇಕೆ?<verse eid="PSA 34:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 34:13"/>ನೀನು ಕೇಡಿನಿಂದ ನಿನ್ನ ನಾಲಿಗೆಯನ್ನು,</para>
  <para style="q2" vid="PSA 34:13">ಮೋಸವನ್ನು ನುಡಿಯದ ಹಾಗೆ ನಿನ್ನ ತುಟಿಗಳನ್ನೂ ನಿಯಂತ್ರಿಸಿಕೋ.<verse eid="PSA 34:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 34:14"/>ಕೇಡಿನಿಂದ ತೊಲಗಿ ಒಳ್ಳೆಯದನ್ನು ಮಾಡು;</para>
  <para style="q2" vid="PSA 34:14">ಸಮಾಧಾನವನ್ನು ಹುಡುಕಿ ಅದನ್ನು ಹಿಂಬಾಲಿಸು.<verse eid="PSA 34:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 34:15"/>ನೀತಿವಂತರ ಮೇಲೆ ಯೆಹೋವ ದೇವರು ದೃಷ್ಟಿ ಇಡುತ್ತಾರೆ,</para>
  <para style="q2" vid="PSA 34:15">ಅವರು ಮೊರೆಯಿಡುವಾಗ ದೇವರು ಕಿವಿಗೊಡುತ್ತಾರೆ.<verse eid="PSA 34:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 34:16"/>ಆದರೆ ಕೆಟ್ಟದ್ದನ್ನು ಮಾಡುವವರಿಗೆ ಯೆಹೋವ ದೇವರು ವಿಮುಖರಾಗಿದ್ದಾರೆ,</para>
  <para style="q2" vid="PSA 34:16">ಅಂಥವರ ಹೆಸರನ್ನು ಭೂಮಿಯೊಳಗಿಂದ ತೆಗೆದುಹಾಕುವರು.<verse eid="PSA 34:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 34:17"/>ನೀತಿವಂತರ ಕೂಗನ್ನು ಯೆಹೋವ ದೇವರು ಕೇಳಿ,</para>
  <para style="q2" vid="PSA 34:17">ಅವರನ್ನು ಎಲ್ಲಾ ಇಕ್ಕಟ್ಟುಗಳೊಳಗಿಂದ ಬಿಡಿಸುತ್ತಾರೆ.<verse eid="PSA 34:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 34:18"/>ಮುರಿದ ಹೃದಯದವರಿಗೆ ಯೆಹೋವ ದೇವರು ಸಮೀಪವಾಗಿದ್ದಾರೆ;</para>
  <para style="q2" vid="PSA 34:18">ಜಜ್ಜಿದ ಆತ್ಮವುಳ್ಳವರನ್ನು ರಕ್ಷಿಸುತ್ತಾರೆ.<verse eid="PSA 34:18"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 34:19"/>ನೀತಿವಂತನಿಗೆ ತೊಂದರೆಗಳು ಬಹಳವಾಗಿವೆ;</para>
  <para style="q2" vid="PSA 34:19">ಆದರೆ ಅವೆಲ್ಲವುಗಳಿಂದ ಯೆಹೋವ ದೇವರು ಅವನನ್ನು ಬಿಡಿಸುತ್ತಾರೆ.<verse eid="PSA 34:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 34:20"/>ಅವರು ಅವನ ಎಲುಬುಗಳನ್ನೆಲ್ಲಾ ಕಾಪಾಡುತ್ತಾರೆ;</para>
  <para style="q2" vid="PSA 34:20">ಅವುಗಳಲ್ಲಿ ಒಂದಾದರೂ ಮುರಿದು ಹೋಗುವುದಿಲ್ಲ.<verse eid="PSA 34:20"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 34:21"/>ಕೇಡು ದುಷ್ಟನನ್ನೇ ಕೊಲ್ಲುವುದು;</para>
  <para style="q2" vid="PSA 34:21">ನೀತಿವಂತನನ್ನು ದ್ವೇಷಿಸುವವರು ಶಿಕ್ಷೆಗೆ ಒಳಗಾಗುವರು.<verse eid="PSA 34:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 34:22"/>ಯೆಹೋವ ದೇವರು ತಮ್ಮ ಸೇವಕರ ಪ್ರಾಣವನ್ನು ವಿಮೋಚಿಸುತ್ತಾರೆ;</para>
  <para style="q2" vid="PSA 34:22">ದೇವರನ್ನು ಆಶ್ರಯಿಸುವವರು ಯಾರೂ ಶಿಕ್ಷೆಗೆ ಒಳಗಾಗುವುದಿಲ್ಲ.<verse eid="PSA 34:22"/></para>
  <chapter eid="PSA 34"/>
  <chapter number="35" style="c" sid="PSA 35"/>
  <para style="cl">ಕೀರ್ತನೆ 35</para>
  <para style="d">ದಾವೀದನ ಕೀರ್ತನೆ.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 35:1"/>ಯೆಹೋವ ದೇವರೇ, ನನ್ನ ಸಂಗಡ ವ್ಯಾಜ್ಯ ಮಾಡುವವರ ಸಂಗಡ ವ್ಯಾಜ್ಯ ಮಾಡಿರಿ;</para>
  <para style="q2" vid="PSA 35:1">ನನಗೆ ವಿರೋಧವಾಗಿ ಯುದ್ಧ ಮಾಡುವವರ ಸಂಗಡ ಯುದ್ಧಮಾಡಿರಿ.<verse eid="PSA 35:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 35:2"/>ಗುರಾಣಿಯನ್ನೂ ಖಡ್ಗವನ್ನೂ ಹಿಡಿದುಕೊಂಡು</para>
  <para style="q2" vid="PSA 35:2">ನನ್ನ ಸಹಾಯಕ್ಕೆ ಎದ್ದು ಬನ್ನಿರಿ.<verse eid="PSA 35:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 35:3"/>ಬರ್ಜಿಯನ್ನೂ ಭಲ್ಲೆಯನ್ನೂ ಹಿಡಿದು</para>
  <para style="q2" vid="PSA 35:3">ನನ್ನನ್ನು ಹಿಂಸಿಸುವವರಿಗೆ ಎದುರಾಗಿ ಅಡ್ಡಗಟ್ಟಿರಿ.</para>
  <para style="q1" vid="PSA 35:3">“ನಾನೇ ನಿಮ್ಮ ರಕ್ಷಣೆ” ಎಂದು</para>
  <para style="q2" vid="PSA 35:3">ನನಗೆ ಹೇಳಿರಿ.<verse eid="PSA 35:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 35:4"/>ನನ್ನ ಪ್ರಾಣವನ್ನು ಹುಡುಕುವವರು</para>
  <para style="q2" vid="PSA 35:4">ನಾಚಿಕೆಪಟ್ಟು ಅವಮಾನ ಹೊಂದಲಿ;</para>
  <para style="q1" vid="PSA 35:4">ನನಗೆ ಕೇಡನ್ನು ಕಲ್ಪಿಸುವವರು</para>
  <para style="q2" vid="PSA 35:4">ಹಿಂದಿರುಗಿ ಲಜ್ಜೆಪಡಲಿ.<verse eid="PSA 35:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 35:5"/>ಅವರು ಗಾಳಿಗೆ ಹಾರುವ ಹೊಟ್ಟಿನ ಹಾಗೆ ಆಗಲಿ;</para>
  <para style="q2" vid="PSA 35:5">ಯೆಹೋವ ದೇವರ ದೂತನು ಅವರನ್ನು ಹಿಂದಟ್ಟಲಿ.<verse eid="PSA 35:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 35:6"/>ಅಂಥವರ ಮಾರ್ಗವು ಕತ್ತಲೆಯೂ ಜಾರುವಿಕೆಯೂ ಆಗಿರಲಿ;</para>
  <para style="q2" vid="PSA 35:6">ಯೆಹೋವ ದೇವರ ದೂತನು ಅವರನ್ನು ಹಿಂದಟ್ಟಲಿ.<verse eid="PSA 35:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 35:7"/>ಏಕೆಂದರೆ ಕಾರಣವಿಲ್ಲದೆ ತಮ್ಮ ಬಲೆಯನ್ನು ನನಗೆ ಒಡ್ಡಿದ್ದಾರೆ;</para>
  <para style="q2" vid="PSA 35:7">ಕಾರಣವಿಲ್ಲದೆ ನನಗೆ ಗುಂಡಿಯನ್ನು ಅಗೆದಿದ್ದಾರೆ.<verse eid="PSA 35:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 35:8"/>ನಾಶವು ಅವರಿಗೆ ಅನಿರೀಕ್ಷಿತವಾಗಿ ಬರಲಿ;</para>
  <para style="q2" vid="PSA 35:8">ಅವರು ಅಡಗಿಸಿಟ್ಟ ಬಲೆಯು ಅವರನ್ನೇ ಹಿಡಿಯಲಿ;</para>
  <para style="q2" vid="PSA 35:8">ವಿನಾಶನಕ್ಕಾಗಿ ಅವರು ಗುಂಡಿಯಲ್ಲಿ ಬೀಳಲಿ.<verse eid="PSA 35:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 35:9"/>ಆಗ ನನ್ನ ಪ್ರಾಣವು ಯೆಹೋವ ದೇವರಲ್ಲಿ ಉಲ್ಲಾಸಗೊಂಡು,</para>
  <para style="q2" vid="PSA 35:9">ದೇವರ ರಕ್ಷಣೆಯಲ್ಲಿ ಸಂತೋಷಿಸುವುದು.<verse eid="PSA 35:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 35:10"/>ಯೆಹೋವ ದೇವರೇ, “ನಿಮ್ಮ ಹಾಗೆ ಯಾರು ಇದ್ದಾರೆ?</para>
  <para style="q2" vid="PSA 35:10">ಬಡವನನ್ನು ಅವನಿಗಿಂತ ಬಲಿಷ್ಠನಿಂದ ಕಾಪಾಡುತ್ತೀರಿ ದರಿದ್ರನನ್ನೂ,</para>
  <para style="q1" vid="PSA 35:10">ಕೊರತೆಯುಳ್ಳವನನ್ನೂ ಸುಲಿದುಕೊಳ್ಳುವವನಿಂದ ಬಿಡಿಸುತ್ತೀರಿ,”</para>
  <para style="q2" vid="PSA 35:10">ಎಂದು ನನ್ನ ಪೂರ್ಣ ಪ್ರಾಣವೇ ಹೇಳುವುದು.<verse eid="PSA 35:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 35:11"/>ಸುಳ್ಳುಸಾಕ್ಷಿಗಳು ನನಗೆ ಎದುರಾಗಿ ಎದ್ದು,</para>
  <para style="q2" vid="PSA 35:11">ನಾನು ತಿಳಿಯದವುಗಳ ಬಗ್ಗೆ ಪ್ರಶ್ನೆ ಮಾಡುತ್ತಾರೆ.<verse eid="PSA 35:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 35:12"/>ನನ್ನ ಉಪಕಾರಕ್ಕೆ ಬದಲಾಗಿ ನನಗೆ ಕೇಡನ್ನು ಮಾಡಿ</para>
  <para style="q2" vid="PSA 35:12">ನನ್ನನ್ನು ದುಃಖದಲ್ಲಿರುವವರಂತೆ ಬಿಟ್ಟುಬಿಟ್ಟಿದ್ದರೆ<verse eid="PSA 35:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 35:13"/>ನಾನಾದರೋ ಅವರು ಅಸ್ವಸ್ಥರಾದಾಗ ಗೋಣಿತಟ್ಟು ಹೊದ್ದುಕೊಂಡು</para>
  <para style="q2" vid="PSA 35:13">ಉಪವಾಸದಿಂದ ತಗ್ಗಿಸಿಕೊಂಡೆನು;</para>
  <para style="q1" vid="PSA 35:13">ನನ್ನ ಪ್ರಾರ್ಥನೆಗಳಿಗೆ ಉತ್ತರ ದೊರೆಯಲಿಲ್ಲ.<verse eid="PSA 35:13"/></para>
  <para style="q2">
    <verse number="14" style="v" sid="PSA 35:14"/>ಆದುದರಿಂದ ಸ್ವಸ್ಥರಾದವನು ನನಗೆ ಸ್ನೇಹಿತನೂ</para>
  <para style="q2" vid="PSA 35:14">ಇಲ್ಲವೆ ಸಹೋದರನೂ ಎಂದು ಭಾವಿಸಿಕೊಂಡು,</para>
  <para style="q1" vid="PSA 35:14">ನನ್ನ ತಾಯಿಗಾಗಿ ದುಃಖಪಡುವವನ ಹಾಗೆ</para>
  <para style="q2" vid="PSA 35:14">ಭಾರವುಳ್ಳವನಾಗಿ ತಲೆಬಾಗಿ ಅಳುತ್ತಿದ್ದೆನು.<verse eid="PSA 35:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 35:15"/>ಆದರೆ ನಾನು ಎಡವಿದಾಗ ಅವರು ಸಂತೋಷಿಸುತ್ತಾ ಕೂಡಿಕೊಂಡರು;</para>
  <para style="q2" vid="PSA 35:15">ಹೌದು, ದೂಷಕರು ನನಗೆ ತಿಳಿಯದೆ ನನ್ನ ವಿರೋಧವಾಗಿ ಕೂಡಿಕೊಂಡರು.</para>
  <para style="q2" vid="PSA 35:15">ಅವರು ನನ್ನನ್ನು ದೂಷಿಸುವುದನ್ನು ನಿಲ್ಲಿಸಲೇ ಇಲ್ಲ.<verse eid="PSA 35:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 35:16"/>ಔತಣಗಳಲ್ಲಿ ಗೇಲಿಮಾಡುವ ಕಪಟಿಗಳಂತೆ</para>
  <para style="q2" vid="PSA 35:16">ಅವರು ನನ್ನ ಮೇಲೆ ಹಲ್ಲುಗಳನ್ನು ಕಡಿಯುತ್ತಾರೆ.<verse eid="PSA 35:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 35:17"/>ಯೆಹೋವ ದೇವರೇ, ಎಷ್ಟರವರೆಗೆ ನೀವು ಸುಮ್ಮನೆ ನೋಡುತ್ತಾ ಇರುವಿರಿ?</para>
  <para style="q2" vid="PSA 35:17">ಅವರ ಅಪಾಯಗಳಿಂದ ನನ್ನ ಪ್ರಾಣವನ್ನು ಬಿಡಿಸಿರಿ.</para>
  <para style="q2" vid="PSA 35:17">ಆ ಸಿಂಹಗಳಿಂದ ನನ್ನ ಅಮೂಲ್ಯ ಪ್ರಾಣವನ್ನೂ ತಪ್ಪಿಸಿರಿ.<verse eid="PSA 35:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 35:18"/>ಆಗ ನಾನು ದೊಡ್ಡ ಸಭೆಗಳಲ್ಲಿ ನಿಮ್ಮನ್ನು ಕೊಂಡಾಡುವೆನು;</para>
  <para style="q2" vid="PSA 35:18">ಬಹುಜನರಲ್ಲಿ ನಿಮ್ಮನ್ನು ಸ್ತುತಿಸುವೆನು.<verse eid="PSA 35:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 35:19"/>ನಿಷ್ಕಾರಣವಾಗಿರುವ ನನ್ನ ಶತ್ರುಗಳು</para>
  <para style="q2" vid="PSA 35:19">ನನ್ನ ಮೇಲೆ ಸುಳ್ಳಾಗಿ ಸಂತೋಷಪಡದೆ ಇರಲಿ;</para>
  <para style="q1" vid="PSA 35:19">ನನ್ನನ್ನು ಕಾರಣವಿಲ್ಲದೆ ದ್ವೇಷಿಸುವವರು</para>
  <para style="q2" vid="PSA 35:19">ಕಣ್ಣು ಸನ್ನೆ ಮಾಡದೆ ಇರಲಿ.<verse eid="PSA 35:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 35:20"/>ಅವರು ಅಸಮಾಧಾನವಾಗಿ ಮಾತನಾಡಿ</para>
  <para style="q2" vid="PSA 35:20">ದೇಶದಲ್ಲಿರುವ ಶಾಂತರಾಗಿ ಬಾಳುವವರ ಮೇಲೆ ಮೋಸದ</para>
  <para style="q2" vid="PSA 35:20">ವಿಷಯಗಳನ್ನು ಕಲ್ಪಿಸುತ್ತಾರೆ.<verse eid="PSA 35:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 35:21"/>ಹೌದು, ಅವರು ತಮ್ಮ ಬಾಯನ್ನು ತೆರೆದು ನನಗೆ ವಿರೋಧವಾಗಿ, “ಆಹಾ, ಆಹಾ,</para>
  <para style="q2" vid="PSA 35:21">ನಾವು ಕಣ್ಣಾರೆ ಕಂಡೆವು,” ಎನ್ನುತ್ತಾರೆ.<verse eid="PSA 35:21"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 35:22"/>ಯೆಹೋವ ದೇವರೇ, ನೀವು ಇದನ್ನು ನೋಡಿದ್ದೀರಿ; ಯೆಹೋವ ದೇವರೇ, ಮೌನವಾಗಿರಬೇಡಿರಿ;</para>
  <para style="q2" vid="PSA 35:22">ನನಗೆ ದೂರವಾಗಿರಲೂ ಬೇಡಿರಿ.<verse eid="PSA 35:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 35:23"/>ನನ್ನ ದೇವರೇ, ನನ್ನ ಯೆಹೋವ ದೇವರೇ,</para>
  <para style="q2" vid="PSA 35:23">ನನ್ನ ನ್ಯಾಯವನ್ನು ನಿರ್ಣಯಿಸಿರಿ, ನನ್ನ ವ್ಯಾಜ್ಯದ ಪರವಾಗಿ ಎದ್ದೇಳಿರಿ.<verse eid="PSA 35:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 35:24"/>ಯೆಹೋವ ದೇವರೇ, ನನ್ನ ದೇವರೇ, ನಿಮ್ಮ ನೀತಿಯ ಪ್ರಕಾರ ನನಗೆ ನ್ಯಾಯತೀರಿಸಿರಿ;</para>
  <para style="q2" vid="PSA 35:24">ಅವರು ನನ್ನ ವಿರುದ್ಧ ಸಂತೋಷಪಡದೆ ಇರಲಿ.<verse eid="PSA 35:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 35:25"/>ಅವರು ತಮ್ಮ ಹೃದಯದಲ್ಲಿ, “ಆಹಾ, ನಮ್ಮ ಇಷ್ಟವೇ ನೆರವೇರಿತು,” ಎಂದು ಹೇಳದಿರಲಿ;</para>
  <para style="q2" vid="PSA 35:25">“ಅವನನ್ನು ನುಂಗಿಬಿಟ್ಟೆವು,” ಎಂದೂ ಅವರು ಹೇಳದೇ ಇರಲಿ.<verse eid="PSA 35:25"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 35:26"/>ನನ್ನ ಕೇಡಿನಲ್ಲಿ ಸಂತೋಷಪಡುವವರು ನಾಚಿಕೊಂಡು ಒಟ್ಟಿಗೆ ಕಳವಳಗೊಳ್ಳಲಿ;</para>
  <para style="q2" vid="PSA 35:26">ನನಗೆ ವಿರೋಧವಾಗಿ ತಮ್ಮನ್ನು</para>
  <para style="q1" vid="PSA 35:26">ಹೆಚ್ಚಿಸಿಕೊಳ್ಳುವವರು ನಾಚಿಕೆಯನ್ನೂ</para>
  <para style="q2" vid="PSA 35:26">ಅವಮಾನವನ್ನೂ ಹೊಂದಲಿ.<verse eid="PSA 35:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 35:27"/>ನನ್ನ ನೀತಿಯಲ್ಲಿ ಸಂತೋಷಪಡುವವರು</para>
  <para style="q2" vid="PSA 35:27">ಉತ್ಸಾಹಧ್ವನಿ ಮಾಡಿ, ಆನಂದಪಡಲಿ;</para>
  <para style="q1" vid="PSA 35:27">“ಹೌದು, ತಮ್ಮ ಸೇವಕನ ಅಭಿವೃದ್ಧಿಯಲ್ಲಿ ಸಂತೋಷಪಡುವ</para>
  <para style="q2" vid="PSA 35:27">ಯೆಹೋವ ದೇವರು ಮಹಿಮೆಪಡಲಿ,” ಎಂದು ಅವರು ಯಾವಾಗಲೂ ಹೇಳಲಿ.<verse eid="PSA 35:27"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 35:28"/>ಆಗ ನನ್ನ ನಾಲಿಗೆಯು ನಿಮ್ಮ ನೀತಿಯನ್ನೂ</para>
  <para style="q2" vid="PSA 35:28">ದಿನವೆಲ್ಲಾ ನಿಮ್ಮ ಸ್ತೋತ್ರವನ್ನೂ ವರ್ಣಿಸುವುದು.<verse eid="PSA 35:28"/></para>
  <chapter eid="PSA 35"/>
  <chapter number="36" style="c" sid="PSA 36"/>
  <para style="cl">ಕೀರ್ತನೆ 36</para>
  <para style="d">ಸಂಗೀತ ನಿರ್ದೇಶಕನಿಗಾಗಿರುವ ಕೀರ್ತನೆ. ಯೆಹೋವ ದೇವರ ಸೇವಕನಾದ ದಾವೀದನ ಕೀರ್ತನೆ.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 36:1"/>ನನ್ನ ಹೃದಯದಲ್ಲಿ ದೇವರಿಂದ ಬಂದ ಸಂದೇಶವು</para>
  <para style="q2" vid="PSA 36:1">ದುಷ್ಟರ ಪಾಪದ ಬಗ್ಗೆ ಹೀಗಿರುತ್ತದೆ:</para>
  <para style="q1" vid="PSA 36:1">ಅವರ ದೃಷ್ಟಿಯಲ್ಲಿ</para>
  <para style="q2" vid="PSA 36:1">ದೇವರ ಭಯವೇ ಇಲ್ಲ.<verse eid="PSA 36:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 36:2"/>ತಮ್ಮ ಪಾಪವನ್ನು ಹಗೆ ಮಾಡದೆ ಅಥವಾ ಪಾಪವನ್ನು ತಾವು ಕಂಡುಕೊಳ್ಳಲಾರದಷ್ಟು</para>
  <para style="q2" vid="PSA 36:2">ಅವರು ತಮ್ಮ ದೃಷ್ಟಿಯಲ್ಲಿ ತಮ್ಮನ್ನು ತಾವೇ ಹೊಗಳಿಕೊಳ್ಳುತ್ತಾರೆ.<verse eid="PSA 36:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 36:3"/>ಅವರ ಬಾಯಿಯ ಮಾತುಗಳು ಅಕ್ರಮವೂ ಮೋಸವೂ ಆಗಿರುತ್ತವೆ;</para>
  <para style="q2" vid="PSA 36:3">ಬುದ್ಧಿಯಿಂದ ನಡೆಯುವುದನ್ನೂ ಒಳ್ಳೆಯದನ್ನು ಮಾಡುವುದನ್ನೂ ಅವರು ಬಿಟ್ಟಿದ್ದಾರೆ.<verse eid="PSA 36:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 36:4"/>ಕುಯುಕ್ತಿಯನ್ನು ತಮ್ಮ ಹಾಸಿಗೆಯ ಮೇಲೆ ಕಲ್ಪಿಸುತ್ತಾರೆ;</para>
  <para style="q2" vid="PSA 36:4">ಪಾಪದ ಮಾರ್ಗಕ್ಕೆ ತಮ್ಮನ್ನು ಅರ್ಪಿಸಿಕೊಳ್ಳುತ್ತಾರೆ;</para>
  <para style="q2" vid="PSA 36:4">ಅವರು ಕೆಟ್ಟದ್ದಕ್ಕೆ ಅಸಹ್ಯಪಡುವುದಿಲ್ಲ.<verse eid="PSA 36:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 36:5"/>ಯೆಹೋವ ದೇವರೇ, ನಿಮ್ಮ ಒಡಂಬಡಿಕೆಯ ಪ್ರೀತಿಯು ಆಕಾಶವನ್ನು ಮುಟ್ಟುತ್ತದೆ;</para>
  <para style="q2" vid="PSA 36:5">ನಿಮ್ಮ ನಂಬಿಗಸ್ತಿಕೆಯು ಮೇಘಗಳವರೆಗೆ ಮುಟ್ಟಿದೆ.<verse eid="PSA 36:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 36:6"/>ನಿಮ್ಮ ನೀತಿಯು ದೊಡ್ಡ ಪರ್ವತಗಳ ಹಾಗಿದೆ;</para>
  <para style="q2" vid="PSA 36:6">ನಿಮ್ಮ ನ್ಯಾಯತೀರ್ಪುಗಳು ಮಹಾ ಅಗಾಧವೇ.</para>
  <para style="q2" vid="PSA 36:6">ಯೆಹೋವ ದೇವರೇ, ನೀವು ಮನುಷ್ಯರನ್ನೂ ಮೃಗಗಳನ್ನೂ ಸಂರಕ್ಷಿಸುತ್ತೀರಿ.<verse eid="PSA 36:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 36:7"/>ದೇವರೇ, ನಿಮ್ಮ ಒಡಂಬಡಿಕೆಯ ಪ್ರೀತಿಯು ಎಷ್ಟೋ ಅಮೂಲ್ಯವಾದದ್ದು!</para>
  <para style="q2" vid="PSA 36:7">ಮನುಷ್ಯರು ನಿಮ್ಮ ರೆಕ್ಕೆಗಳ ನೆರಳಿನಲ್ಲಿ ಆಶ್ರಯಪಡೆಯುತ್ತಾರೆ.<verse eid="PSA 36:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 36:8"/>ನಿಮ್ಮ ಆಲಯದ ಸಮೃದ್ಧಿಯಿಂದ ಅವರು ಸಂತೃಪ್ತಿ ಹೊಂದುವರು;</para>
  <para style="q2" vid="PSA 36:8">ನಿಮ್ಮ ಹರ್ಷ ನದಿಯಿಂದ ಅವರಿಗೆ ಕುಡಿಯಲು ಕೊಡುವಿರಿ.<verse eid="PSA 36:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 36:9"/>ಏಕೆಂದರೆ ನಿಮ್ಮ ಬಳಿಯಲ್ಲಿ ಜೀವದ ಬುಗ್ಗೆ ಉಂಟು;</para>
  <para style="q2" vid="PSA 36:9">ನಿಮ್ಮ ಬೆಳಕಿನಲ್ಲಿ ನಾವು ಬೆಳಕನ್ನು ಕಾಣುವೆವು.<verse eid="PSA 36:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 36:10"/>ನಿಮ್ಮನ್ನು ತಿಳಿದವರಿಗೆ ನಿಮ್ಮ ಪ್ರೀತಿಯು ಮುಂದುವರೆಯಲಿ</para>
  <para style="q2" vid="PSA 36:10">ಯಥಾರ್ಥ ಹೃದಯದವರಿಗೆ ನಿಮ್ಮ ನೀತಿಯೂ ನೆಲೆಯಾಗಲಿ.<verse eid="PSA 36:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 36:11"/>ಗರ್ವಿಷ್ಠರ ಪಾದ ನನಗೆ ವಿರೋಧವಾಗಿ ಬಾರದೇ ಇರಲಿ;</para>
  <para style="q2" vid="PSA 36:11">ದುಷ್ಟರ ಕೈ ನನ್ನನ್ನು ತೆಗೆದು ಹಾಕದಿರಲಿ.<verse eid="PSA 36:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 36:12"/>ಕೇಡು ಮಾಡುವವರು ಬಿದ್ದಿದ್ದಾರೆ.</para>
  <para style="q2" vid="PSA 36:12">ಅವರು ಏಳಲಾರದೆ ಕೆಳಗೆ ಬಿದ್ದಿದ್ದಾರೆ.<verse eid="PSA 36:12"/></para>
  <chapter eid="PSA 36"/>
  <chapter number="37" style="c" sid="PSA 37"/>
  <para style="cl">ಕೀರ್ತನೆ 37<note caller="+" style="f"><char style="fr" closed="false">37:0 </char><char style="ft" closed="false">ಹೀಬ್ರೂ ಅಕ್ಷರ ಕ್ರಮಾನುಸಾರವಾದ ಪ್ರಾರ್ಥನೆ.</char></note></para>
  <para style="d">ದಾವೀದನ ಕೀರ್ತನೆ.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 37:1"/>ಕೆಟ್ಟವರನ್ನು ನೋಡಿ ಕೋಪಿಸಿಕೊಳ್ಳಬೇಡ.</para>
  <para style="q2" vid="PSA 37:1">ಇಲ್ಲವೆ ಅಕ್ರಮ ಮಾಡುವವರ ಬಗ್ಗೆ ಹೊಟ್ಟೆಕಿಚ್ಚುಪಡಬೇಡ.<verse eid="PSA 37:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 37:2"/>ಏಕೆಂದರೆ, ಅವರು ಹುಲ್ಲಿನ ಹಾಗೆ ಬೇಗ ಒಣಗಿ ಹೋಗುವರು.</para>
  <para style="q2" vid="PSA 37:2">ಹಸಿರಾದ ಸೊಪ್ಪಿನ ಹಾಗೆ ಬಾಡಿಹೋಗುವರು.<verse eid="PSA 37:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 37:3"/>ಯೆಹೋವ ದೇವರಲ್ಲಿ ಭರವಸೆ ಇಟ್ಟು ಒಳ್ಳೆಯದನ್ನು ಮಾಡು;</para>
  <para style="q2" vid="PSA 37:3">ಆಗ ದೇಶದಲ್ಲಿ ವಾಸಮಾಡಿ ಹಸಿರುಗಾವಲನ್ನು ಅನುಭವಿಸುವಿ.<verse eid="PSA 37:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 37:4"/>ಯೆಹೋವ ದೇವರಲ್ಲಿ ಆನಂದವಾಗಿರು;</para>
  <para style="q2" vid="PSA 37:4">ಆಗ ಅವರು ನಿನ್ನ ಹೃದಯದ ಅಪೇಕ್ಷೆಗಳನ್ನು ಈಡೇರಿಸುವರು.<verse eid="PSA 37:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 37:5"/>ನಿನ್ನ ಮಾರ್ಗವನ್ನು ಯೆಹೋವ ದೇವರಿಗೆ ಒಪ್ಪಿಸು;</para>
  <para style="q2" vid="PSA 37:5">ಅವರಲ್ಲಿ ಭರವಸೆ ಇಡು; ಅವರು ನಿನಗೆ ಇದನ್ನು ಮಾಡುವರು:<verse eid="PSA 37:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 37:6"/>ಅವರು ನಿನ್ನ ನೀತಿಯನ್ನು ಉದಯದ ಬೆಳಕಿನ ಹಾಗೆ ಮಾಡುವರು,</para>
  <para style="q2" vid="PSA 37:6">ಅವರು ನಿನ್ನ ನ್ಯಾಯವನ್ನು ಮಧ್ಯಾಹ್ನದ ಸೂರ್ಯನ ಹಾಗೆ ಹೊಳೆಯುವಂತೆ ಮಾಡುವರು.<verse eid="PSA 37:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 37:7"/>ಯೆಹೋವ ದೇವರ ಮುಂದೆ ಶಾಂತನಾಗಿರು;</para>
  <para style="q2" vid="PSA 37:7">ಮೌನವಾಗಿದ್ದು ಅವರಿಗಾಗಿ ಎದುರು ನೋಡು;</para>
  <para style="q1" vid="PSA 37:7">ತಮ್ಮ ಮಾರ್ಗದಲ್ಲಿ ಸಫಲವಾಗುವವರನ್ನು ಕಂಡು ಸಿಡುಕಬೇಡ.</para>
  <para style="q2" vid="PSA 37:7">ಕುಯುಕ್ತಿಗಳನ್ನು ನಡೆಸುವ ಮನುಷ್ಯರನ್ನು ಕಂಡು ಕೋಪ ಮಾಡಿಕೊಳ್ಳಬೇಡ.<verse eid="PSA 37:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 37:8"/>ಕೋಪವನ್ನು ಅಡಗಿಸು ಮತ್ತು ರೋಷವನ್ನು ಬಿಡು.</para>
  <para style="q2" vid="PSA 37:8">ಸಿಡುಕಬೇಡ, ಅದು ಕೆಟ್ಟತನಕ್ಕೆ ನಡೆಸುತ್ತದೆ.<verse eid="PSA 37:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 37:9"/>ಏಕೆಂದರೆ, ದುರ್ಮಾರ್ಗಿಗಳು ನಾಶವಾಗುವರು;</para>
  <para style="q2" vid="PSA 37:9">ಯೆಹೋವ ದೇವರನ್ನು ನಿರೀಕ್ಷಿಸುವವರೇ ಭೂಮಿಯನ್ನು ಸ್ವಾಧೀನಮಾಡಿಕೊಳ್ಳುವರು.<verse eid="PSA 37:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 37:10"/>ಇನ್ನು ಸ್ವಲ್ಪ ಸಮಯದಲ್ಲಿ ದುಷ್ಟನು ಕಾಣದೆ ಹೋಗುವನು.</para>
  <para style="q2" vid="PSA 37:10">ಅವನನ್ನು ಹುಡುಕಿದರೂ ಸಿಕ್ಕುವುದೇ ಇಲ್ಲ.<verse eid="PSA 37:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 37:11"/>ಆದರೆ ಸಾತ್ವಿಕರು ಭೂಮಿಯನ್ನು ಸ್ವಾಧೀನಮಾಡಿಕೊಳ್ಳುವರು.</para>
  <para style="q2" vid="PSA 37:11">ದೀನರು ಬಹಳ ಸಮಾಧಾನವನ್ನೂ ಸಮೃದ್ಧಿಯನ್ನು ಅನುಭವಿಸುವರು.<verse eid="PSA 37:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 37:12"/>ದುಷ್ಟನು ನೀತಿವಂತನಿಗಾಗಿ ಒಳಸಂಚು ಮಾಡುತ್ತಾನೆ,</para>
  <para style="q2" vid="PSA 37:12">ಆದರೆ ಅವನನ್ನು ಕಂಡು ಹಲ್ಲು ಕಡಿಯುತ್ತಾನೆ.<verse eid="PSA 37:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 37:13"/>ದುಷ್ಟನ ದಿವಸ ಬರುತ್ತದೆಂದು ತಿಳಿದು</para>
  <para style="q2" vid="PSA 37:13">ಯೆಹೋವ ದೇವರು ನಗುತ್ತಾರೆ.<verse eid="PSA 37:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 37:14"/>ದುಷ್ಟರು ಬಡವನನ್ನೂ ದೀನನನ್ನೂ ಬೀಳಿಸಬೇಕೆಂದು</para>
  <para style="q2" vid="PSA 37:14">ಖಡ್ಗವನ್ನು ಹಿರಿದಿದ್ದಾರೆ,</para>
  <para style="q1" vid="PSA 37:14">ಸನ್ಮಾರ್ಗದವರನ್ನು ಕೊಲ್ಲುವುದಕ್ಕೂ</para>
  <para style="q2" vid="PSA 37:14">ತಮ್ಮ ಬಿಲ್ಲುಗಳನ್ನು ಬಗ್ಗಿಸಿದ್ದಾರೆ.<verse eid="PSA 37:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 37:15"/>ಆದರೆ ಅವರ ಖಡ್ಗ ಅವರ ಹೃದಯದಲ್ಲಿ ಇರಿದು ಬಿಡುವುದು;</para>
  <para style="q2" vid="PSA 37:15">ಅವರ ಬಿಲ್ಲುಗಳು ಮುರಿದುಹೋಗುವವು.<verse eid="PSA 37:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 37:16"/>ದುಷ್ಟರ ಐಶ್ವರ್ಯಕ್ಕಿಂತ</para>
  <para style="q2" vid="PSA 37:16">ನೀತಿವಂತರ ಅಲ್ಪವೇ ಲೇಸು.<verse eid="PSA 37:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 37:17"/>ಏಕೆಂದರೆ ದುಷ್ಟರ ತೋಳುಗಳು ಮುರಿದುಹೋಗುವವು,</para>
  <para style="q2" vid="PSA 37:17">ಆದರೆ ನೀತಿವಂತರನ್ನು ಯೆಹೋವ ದೇವರು ಉದ್ಧಾರ ಮಾಡುವರು.<verse eid="PSA 37:17"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 37:18"/>ನಿರ್ದೋಷಿಗಳು ತಮ್ಮ ದಿವಸಗಳನ್ನು ಯೆಹೋವ ದೇವರ ಪರಾಮರಿಕೆಯಲ್ಲಿ ಕಳೆಯುವರು.</para>
  <para style="q2" vid="PSA 37:18">ನಿರಪರಾಧಿಯ ಬಾಧ್ಯತೆಯು ಯುಗಯುಗಕ್ಕೂ ಇರುವುದು.<verse eid="PSA 37:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 37:19"/>ಆಪತ್ಕಾಲದಲ್ಲಿ ಅವರು ಕುಂದುವುದಿಲ್ಲ;</para>
  <para style="q2" vid="PSA 37:19">ಕ್ಷಾಮದ ದಿವಸಗಳಲ್ಲಿ ಸಮೃದ್ಧಿಯನ್ನು ಅನುಭವಿಸುವರು.<verse eid="PSA 37:19"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 37:20"/>ಆದರೆ ದುಷ್ಟರು ನಾಶವಾಗುವರು;</para>
  <para style="q2" vid="PSA 37:20">ಯೆಹೋವ ದೇವರ ಶತ್ರುಗಳು ಗದ್ದೆಯ ಹೂಗಳಂತೆ ಬಾಡಿಹೋಗುವರು;</para>
  <para style="q2" vid="PSA 37:20">ಹೊಗೆಯಂತೆ ಮಾಯವಾಗುವರು.<verse eid="PSA 37:20"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 37:21"/>ದುಷ್ಟನು ಸಾಲ ಮಾಡಿ ಹಿಂದಿರುಗಿ ಕೊಡದೆ ಹೋಗುವನು.</para>
  <para style="q2" vid="PSA 37:21">ಆದರೆ ನೀತಿವಂತನು ಧಾರಾಳವಾಗಿ ಕೊಡುತ್ತಾನೆ.<verse eid="PSA 37:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 37:22"/>ಯೆಹೋವ ದೇವರು ಆಶೀರ್ವದಿಸುವವರು,</para>
  <para style="q2" vid="PSA 37:22">ಭೂಮಿಯನ್ನು ಸ್ವಾಧೀನಪಡಿಸಿಕೊಳ್ಳುವರು;</para>
  <para style="q2" vid="PSA 37:22">ಆದರೆ ದೇವರ ಶಾಪಕ್ಕೆ ಗುರಿಯಾಗುವವರು ನಾಶವಾಗುವರು.<verse eid="PSA 37:22"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 37:23"/>ಯೆಹೋವ ದೇವರಲ್ಲಿ ಯಾರು ಹರ್ಷಿಸುತ್ತಾರೋ</para>
  <para style="q2" vid="PSA 37:23">ಅವರ ಹೆಜ್ಜೆಗಳನ್ನು ಸ್ಥಿರಪಡಿಸುವರು.<verse eid="PSA 37:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 37:24"/>ಅವನು ಎಡವಿದರೂ ಬಿದ್ದುಹೋಗುವುದಿಲ್ಲ.</para>
  <para style="q2" vid="PSA 37:24">ಏಕೆಂದರೆ ಯೆಹೋವ ದೇವರು ತಾವೇ ತಮ್ಮ ಕೈಯಿಂದ ಅವನನ್ನು ಎತ್ತಿಹಿಡಿಯುವರು.<verse eid="PSA 37:24"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 37:25"/>ನಾನು ಬಾಲಕನಾಗಿದ್ದೆನು, ಈಗ ಮುದುಕನಾಗಿದ್ದೇನೆ;</para>
  <para style="q2" vid="PSA 37:25">ಆದರೆ ನೀತಿವಂತನು ಕೈಬಿಟ್ಟಿರುವುದನ್ನಾಗಲಿ</para>
  <para style="q2" vid="PSA 37:25">ಅವನ ಸಂತತಿಯು ರೊಟ್ಟಿಗಾಗಿ ಭಿಕ್ಷೆ ಬೇಡುವುದನ್ನಾಗಲಿ ಎಂದೂ ನಾನು ನೋಡಲಿಲ್ಲ.<verse eid="PSA 37:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 37:26"/>ಅವರು ಯಾವಾಗಲೂ ಧಾರಾಳವಾಗಿ ಸಾಲ ಕೊಡುತ್ತಾರೆ;</para>
  <para style="q2" vid="PSA 37:26">ನೀತಿವಂತನ ಸಂತತಿಯವರು ಆಶೀರ್ವಾದ ಹೊಂದುವರು.<verse eid="PSA 37:26"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 37:27"/>ಕೇಡಿನಿಂದ ತೊಲಗಿ ಒಳ್ಳೆಯದನ್ನು ಮಾಡು,</para>
  <para style="q2" vid="PSA 37:27">ಆಗ ಯುಗಯುಗಕ್ಕೂ ನಾಡಿನಲ್ಲಿ ವಾಸಮಾಡುವೆ.<verse eid="PSA 37:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 37:28"/>ಏಕೆಂದರೆ ಯೆಹೋವ ದೇವರು ನ್ಯಾಯವನ್ನು ಪ್ರೀತಿಸುತ್ತಾರೆ;</para>
  <para style="q2" vid="PSA 37:28">ತಮ್ಮ ನಂಬಿಗಸ್ತ ಜನರನ್ನು ತೊರೆದುಬಿಡರು.</para>
  <para style="b" vid="PSA 37:28"/>
  <para style="q1" vid="PSA 37:28">ನೀತಿವಂತರು ಸದಾಕಾಲಕವೂ ಸುರಕ್ಷಿತರಾಗಿರುವರು;</para>
  <para style="q2" vid="PSA 37:28">ಆದರೆ ದುಷ್ಟರ ಸಂತತಿಯು ಅಳಿದುಹೋಗುವುದು.<verse eid="PSA 37:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="PSA 37:29"/>ನೀತಿವಂತರು ಭೂಮಿಯನ್ನು ಸ್ವಾಧೀನಮಾಡಿಕೊಂಡು</para>
  <para style="q2" vid="PSA 37:29">ಎಂದೆಂದಿಗೂ ಅದರಲ್ಲಿ ವಾಸವಾಗಿರುವರು.<verse eid="PSA 37:29"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="30" style="v" sid="PSA 37:30"/>ನೀತಿವಂತನ ಬಾಯಿ ಜ್ಞಾನವನ್ನು ನುಡಿಯುವುದು;</para>
  <para style="q2" vid="PSA 37:30">ಅವನ ನಾಲಿಗೆ ನ್ಯಾಯವನ್ನು ಮಾತನಾಡುವುದು.<verse eid="PSA 37:30"/></para>
  <para style="q1">
    <verse number="31" style="v" sid="PSA 37:31"/>ಅವನ ದೇವರ ನಿಯಮವೂ ಅವನ ಹೃದಯದಲ್ಲಿ ಇದೆ;</para>
  <para style="q2" vid="PSA 37:31">ಅವನ ಹೆಜ್ಜೆ ಕದಲುವುದಿಲ್ಲ.<verse eid="PSA 37:31"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="32" style="v" sid="PSA 37:32"/>ದುಷ್ಟನು ನೀತಿವಂತನಿಗಾಗಿ ಒಳಸಂಚು ಮಾಡುತ್ತಾನೆ;</para>
  <para style="q2" vid="PSA 37:32">ಅವನನ್ನು ಕೊಲ್ಲಲು ಹುಡುಕುತ್ತಾನೆ.<verse eid="PSA 37:32"/></para>
  <para style="q1">
    <verse number="33" style="v" sid="PSA 37:33"/>ಆದರೆ ಯೆಹೋವ ದೇವರು ಅವನನ್ನು ದುಷ್ಟನ ಕೈಯಲ್ಲಿ ಬಿಡುವುದಿಲ್ಲ;</para>
  <para style="q2" vid="PSA 37:33">ನ್ಯಾಯ ವಿಚಾರಣೆಯಲ್ಲಿ ನೀತಿವಂತನನ್ನು ಅಪರಾಧಿಯೆಂದು ತೀರ್ಪು ಕೊಡುವುದಿಲ್ಲ.<verse eid="PSA 37:33"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="34" style="v" sid="PSA 37:34"/>ಯೆಹೋವ ದೇವರನ್ನು ನಿರೀಕ್ಷಿಸು;</para>
  <para style="q2" vid="PSA 37:34">ಅವರ ಮಾರ್ಗದಲ್ಲಿ ನಡೆ;</para>
  <para style="q1" vid="PSA 37:34">ಆಗ ಭೂಮಿಯನ್ನು ಸ್ವಾಧೀನ ಮಾಡಿಕೊಳ್ಳುವಂತೆ ನಿನ್ನನ್ನು ಅವರು ಉನ್ನತಕ್ಕೆ ತರುವರು;</para>
  <para style="q2" vid="PSA 37:34">ದುಷ್ಟರ ವಿನಾಶವನ್ನು ನೀವು ಕಾಣುವಿರಿ.<verse eid="PSA 37:34"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="35" style="v" sid="PSA 37:35"/>ದುಷ್ಟರು ದೊಡ್ಡ ಅಧಿಕಾರದಲ್ಲಿರುವುದನ್ನು ನಾನು ಕಂಡೆನು;</para>
  <para style="q2" vid="PSA 37:35">ಅವರು ಹಸಿರಾಗಿ ವಿಸ್ತರಿಸಿಕೊಂಡ ಮರದ ಹಾಗೆ ಇದ್ದರು.<verse eid="PSA 37:35"/></para>
  <para style="q1">
    <verse number="36" style="v" sid="PSA 37:36"/>ಆದರೆ ಅವರು ಅಳಿದೇ ಹೋದರು;</para>
  <para style="q2" vid="PSA 37:36">ಅವರನ್ನು ಹುಡುಕಿದೆನು; ಆದರೆ ಅವರು ಸಿಕ್ಕಲಿಲ್ಲ.<verse eid="PSA 37:36"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="37" style="v" sid="PSA 37:37"/>ನಿರ್ದೋಷಿಯನ್ನು ಗಮನಿಸು;</para>
  <para style="q2" vid="PSA 37:37">ಯಥಾರ್ಥನನ್ನು ನೋಡು;</para>
  <para style="q2" vid="PSA 37:37">ಸಮಾಧಾನ ಹುಡುಕುವವರಿಗೆ ಒಳ್ಳೆಯ ಭವಿಷ್ಯವಿದೆ.<verse eid="PSA 37:37"/></para>
  <para style="q1">
    <verse number="38" style="v" sid="PSA 37:38"/>ಆದರೆ ದ್ರೋಹಿಗಳೆಲ್ಲರೂ ನಾಶವಾಗುವರು;</para>
  <para style="q2" vid="PSA 37:38">ದುಷ್ಟರಿಗೆ ಒಳ್ಳೆಯ ಭವಿಷ್ಯವಿಲ್ಲ.<verse eid="PSA 37:38"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="39" style="v" sid="PSA 37:39"/>ನೀತಿವಂತರ ರಕ್ಷಣೆಯು ಯೆಹೋವ ದೇವರಿಂದಲೇ;</para>
  <para style="q2" vid="PSA 37:39">ಇಕ್ಕಟ್ಟಿನ ಕಾಲದಲ್ಲಿ ದೇವರೇ ಅವರ ಕೋಟೆ.<verse eid="PSA 37:39"/></para>
  <para style="q1">
    <verse number="40" style="v" sid="PSA 37:40"/>ಯೆಹೋವ ದೇವರು ಅವರಿಗೆ ಸಹಾಯಮಾಡಿ ಅವರನ್ನು ಬಿಡಿಸುವರು.</para>
  <para style="q2" vid="PSA 37:40">ದುಷ್ಟರಿಂದ ಅವರನ್ನು ತಪ್ಪಿಸಿ ಬಿಡಿಸುವರು.</para>
  <para style="q2" vid="PSA 37:40">ಏಕೆಂದರೆ ಅವರು ದೇವರಲ್ಲಿ ಆಶ್ರಯ ಪಡೆದಿದ್ದಾರೆ.<verse eid="PSA 37:40"/></para>
  <chapter eid="PSA 37"/>
  <chapter number="38" style="c" sid="PSA 38"/>
  <para style="cl">ಕೀರ್ತನೆ 38</para>
  <para style="d">ದಾವೀದನ ಕೀರ್ತನೆ. ದುರವಸ್ಥೆಯಲ್ಲಿರುವ ಭಕ್ತನ ದೇವರ ಸಹಾಯದ ಬೇಡಿಕೆ.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 38:1"/>ಯೆಹೋವ ದೇವರೇ, ನೀವು ಬೇಸರದಿಂದ ನನ್ನನ್ನು ಗದರಿಸಬೇಡಿರಿ;</para>
  <para style="q2" vid="PSA 38:1">ಮನನೊಂದು ನನ್ನನ್ನು ಶಿಕ್ಷಿಸಬೇಡಿರಿ.<verse eid="PSA 38:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 38:2"/>ಏಕೆಂದರೆ, ನಿಮ್ಮ ಬಾಣಗಳು ನನ್ನಲ್ಲಿ ನಾಟಿವೆ.</para>
  <para style="q2" vid="PSA 38:2">ನಿಮ್ಮ ಶಿಕ್ಷಾ ಹಸ್ತವು ನನ್ನ ಮೇಲೆ ಭಾರವಾಗಿದೆ.<verse eid="PSA 38:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 38:3"/>ನಿಮ್ಮ ಬೇಸರದ ನಿಮಿತ್ತ ನನ್ನ ಶರೀರದಲ್ಲಿ ಸ್ವಸ್ಥತೆ ಏನೂ ಇಲ್ಲ;</para>
  <para style="q2" vid="PSA 38:3">ನನ್ನ ಪಾಪದ ನಿಮಿತ್ತ ನನ್ನ ಎಲುಬುಗಳಲ್ಲಿ ಕ್ಷೇಮವೇ ಇಲ್ಲ.<verse eid="PSA 38:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 38:4"/>ಏಕೆಂದರೆ, ನನ್ನ ಅಕ್ರಮಗಳು ನನ್ನ ತಲೆಯ ಮೇಲೆ ಏರಿ ಹೋಗಿವೆ;</para>
  <para style="q2" vid="PSA 38:4">ದೋಷ ಭಾವನೆಯ ಹೊರೆಯು ನನಗೆ ಬಹುಭಾರವಾಗಿವೆ.<verse eid="PSA 38:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 38:5"/>ನನ್ನ ಮೂರ್ಖತನದ ನಿಮಿತ್ತ ನನಗಾದ ಗಾಯಗಳು</para>
  <para style="q2" vid="PSA 38:5">ದುರ್ವಾಸನೆಯಿಂದ ಕೀವು ತುಂಬಿವೆ.<verse eid="PSA 38:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 38:6"/>ನಾನು ಬಹಳವಾಗಿ ಬಾಗಿ ಕುಗ್ಗಿದ್ದೇನೆ.</para>
  <para style="q2" vid="PSA 38:6">ದಿನವೆಲ್ಲಾ ದುಃಖದಿಂದ ನಾನು ಅಲೆಯುತ್ತಿದ್ದೇನೆ.<verse eid="PSA 38:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 38:7"/>ನನ್ನ ಸೊಂಟ ಬಹು ಬೇನೆಯಿಂದ ತುಂಬಿದೆ.</para>
  <para style="q2" vid="PSA 38:7">ನನ್ನ ದೇಹದಲ್ಲಿ ಕ್ಷೇಮವೇ ಇಲ್ಲ.<verse eid="PSA 38:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 38:8"/>ಬಲಹೀನನಾಗಿದ್ದೇನೆ, ಬಹಳ ಜಜ್ಜಿ ಹೋಗಿದ್ದೇನೆ;</para>
  <para style="q2" vid="PSA 38:8">ನನ್ನ ಹೃದಯದ ವೇದನೆಯಿಂದ ನರಳುತ್ತಾ ಇದ್ದೇನೆ.<verse eid="PSA 38:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 38:9"/>ಯೆಹೋವ ದೇವರೇ, ನಿಮಗೆ ನನ್ನ ಅಪೇಕ್ಷೆಗಳೆಲ್ಲಾ ಗೊತ್ತೇ ಇದೆ;</para>
  <para style="q2" vid="PSA 38:9">ನನ್ನ ನಿಟ್ಟುಸಿರು ನಿಮಗೆ ಮರೆಯಾದದ್ದಲ್ಲ.<verse eid="PSA 38:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 38:10"/>ನನ್ನ ಹೃದಯ ಬಡಿದುಕೊಳ್ಳುತ್ತದೆ. ನನ್ನ ಶಕ್ತಿಯು ನನ್ನನ್ನು ಬಿಟ್ಟುಹೋಗಿದೆ;</para>
  <para style="q2" vid="PSA 38:10">ನನ್ನ ಕಣ್ಣುಗಳ ಬೆಳಕು ಸಹ ಹೋಗಿಬಿಟ್ಟಿದೆ.<verse eid="PSA 38:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 38:11"/>ನನ್ನ ಪ್ರಿಯರೂ, ನನ್ನ ಸ್ನೇಹಿತರೂ ನನ್ನ ಬಾಧೆಗೆ ಓರೆಯಾಗಿ ನಿಲ್ಲುತ್ತಾರೆ;</para>
  <para style="q2" vid="PSA 38:11">ನನ್ನ ನೆರೆಯವರು ದೂರದಲ್ಲಿ ನಿಂತಿದ್ದಾರೆ.<verse eid="PSA 38:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 38:12"/>ನನ್ನ ಪ್ರಾಣವನ್ನು ಹುಡುಕುವವರು ಬಲೆ ಒಡ್ಡುತ್ತಾರೆ;</para>
  <para style="q2" vid="PSA 38:12">ನನ್ನ ಕೇಡನ್ನು ಹುಡುಕುವವರು ಕೇಡಿನ ಮಾತುಗಳನ್ನಾಡುತ್ತಾರೆ;</para>
  <para style="q2" vid="PSA 38:12">ದಿನವೆಲ್ಲಾ ಮೋಸಗಳನ್ನು ಆಲೋಚಿಸುತ್ತಾರೆ.<verse eid="PSA 38:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 38:13"/>ಆದರೆ ನಾನು ಕಿವುಡನ ಹಾಗೆ ಕೇಳಿಸಿಕೊಳ್ಳುವುದಿಲ್ಲ;</para>
  <para style="q2" vid="PSA 38:13">ತನ್ನ ಬಾಯಿ ತೆರೆಯದ ಮೂಕನ ಹಾಗಿದ್ದೇನೆ.<verse eid="PSA 38:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 38:14"/>ನಾನು ಕಿವಿ ಕೇಳಿಸದವನಂತೆ ಇದ್ದೇನೆ.</para>
  <para style="q2" vid="PSA 38:14">ನಾನು ಪ್ರತ್ಯುತ್ತರ ಕೊಡಲಾರದಂತೆಯೂ ಇದ್ದೇನೆ.<verse eid="PSA 38:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 38:15"/>ಯೆಹೋವ ದೇವರೇ, ನಿಮ್ಮನ್ನೇ ಎದುರು ನೋಡುತ್ತೇನೆ;</para>
  <para style="q2" vid="PSA 38:15">ನನ್ನ ದೇವರಾದ ಯೆಹೋವ ದೇವರೇ, ನೀವು ಉತ್ತರ ಕೊಡುವಿರಿ.<verse eid="PSA 38:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 38:16"/>ಏಕೆಂದರೆ ನಾನು, “ಅವರು ನನಗೋಸ್ಕರ ಸಂತೋಷಪಡದೆ ಇರಲಿ</para>
  <para style="q2" vid="PSA 38:16">ನನ್ನ ಪಾದ ಜಾರುವಾಗ ಅವರು ನನಗೆ ವಿರೋಧವಾಗಿ</para>
  <para style="q2" vid="PSA 38:16">ತಮ್ಮನ್ನು ಹೆಚ್ಚಿಸಿಕೊಳ್ಳದಿರಲಿ,” ಎಂದುಕೊಂಡೆನು.<verse eid="PSA 38:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 38:17"/>ನಾನು ಎಡವಿ ಬೀಳಲಿದ್ದೇನೆ;</para>
  <para style="q2" vid="PSA 38:17">ನನ್ನ ನೋವು ಯಾವಾಗಲೂ ನನ್ನ ಮುಂದೆ ಇದೆ.<verse eid="PSA 38:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 38:18"/>ನನ್ನ ಅಕ್ರಮವನ್ನು ಅರಿಕೆ ಮಾಡುವೆನು;</para>
  <para style="q2" vid="PSA 38:18">ನನ್ನ ಪಾಪಕ್ಕೋಸ್ಕರ ದುಃಖಪಡುವೆನು.<verse eid="PSA 38:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 38:19"/>ನನ್ನ ಶತ್ರುಗಳು ಬಲಗೊಂಡಿದ್ದಾರೆ.</para>
  <para style="q2" vid="PSA 38:19">ನನ್ನನ್ನು ವಿನಾಕಾರಣವಾಗಿ ದ್ವೇಷಿಸುವವರು ಹೆಚ್ಚಿದ್ದಾರೆ.<verse eid="PSA 38:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 38:20"/>ನನ್ನ ಶತ್ರುಗಳು ಒಳ್ಳೆಯದಕ್ಕೆ ಬದಲಾಗಿ</para>
  <para style="q2" vid="PSA 38:20">ಕೇಡನ್ನು ಸಲ್ಲಿಸುತ್ತಿದ್ದಾರೆ.</para>
  <para style="q2" vid="PSA 38:20">ನಾನು ಒಳ್ಳೆಯದನ್ನು ಹಿಂದಟ್ಟುವ ಕಾರಣ ನನ್ನನ್ನು ಎದುರಿಸುತ್ತಾರೆ.<verse eid="PSA 38:20"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 38:21"/>ಯೆಹೋವ ದೇವರೇ, ನನ್ನನ್ನು ಬಿಡಬೇಡಿರಿ;</para>
  <para style="q2" vid="PSA 38:21">ನನ್ನ ದೇವರೇ, ನನಗೆ ದೂರವಾಗಿರಬೇಡಿರಿ.<verse eid="PSA 38:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 38:22"/>ನನ್ನ ರಕ್ಷಕ ಆಗಿರುವ ಯೆಹೋವ ದೇವರೇ,</para>
  <para style="q2" vid="PSA 38:22">ನನ್ನ ಸಹಾಯಕ್ಕೆ ಬೇಗ ಬನ್ನಿರಿ.<verse eid="PSA 38:22"/></para>
  <chapter eid="PSA 38"/>
  <chapter number="39" style="c" sid="PSA 39"/>
  <para style="cl">ಕೀರ್ತನೆ 39</para>
  <para style="d">ಸಂಗೀತ ನಿರ್ದೇಶಕನಿಗಾಗಿರುವ ಕೀರ್ತನೆ. ಯೆದೂತೂನನಿಗಾಗಿ, ದಾವೀದನ ಕೀರ್ತನೆ.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 39:1"/>“ನನ್ನ ನಾಲಿಗೆಯಿಂದ ಪಾಪಮಾಡದಂತೆ ಜಾಗರೂಕನಾಗಿರುವೆನು,</para>
  <para style="q2" vid="PSA 39:1">ನನ್ನ ಮಾರ್ಗಗಳನ್ನು ಕಾಪಾಡಿಕೊಳ್ಳುವೆನು.</para>
  <para style="q1" vid="PSA 39:1">ದುಷ್ಟರು ನನ್ನ ಮುಂದೆ ಇರುವಾಗ</para>
  <para style="q2" vid="PSA 39:1">ನನ್ನ ಬಾಯಿಗೆ ಕಡಿವಾಣ ಹಾಕಿಕೊಳ್ಳುವೆನು,”</para>
  <para style="q2" vid="PSA 39:1">ಎಂದು ತೀರ್ಮಾನಿಸಿಕೊಂಡೆನು.<verse eid="PSA 39:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 39:2"/>ಆದ್ದರಿಂದ ನಾನು ಮೌನವಾಗಿದ್ದೆನು.</para>
  <para style="q2" vid="PSA 39:2">ಒಳ್ಳೆಯದನ್ನು ಸಹ ನಾನು ಆಡದೆ ಸುಮ್ಮನಿದ್ದೆನು.</para>
  <para style="q1" vid="PSA 39:2">ಆದರೆ ನನ್ನ ವ್ಯಥೆಯು ಅಧಿಕವಾಯಿತು.<verse eid="PSA 39:2"/></para>
  <para style="q2">
    <verse number="3" style="v" sid="PSA 39:3"/>ನನ್ನ ಹೃದಯವು ಸಂತಾಪದಿಂದ ಕಾವೇರಿತು.</para>
  <para style="q1" vid="PSA 39:3">ನಾನು ಧ್ಯಾನವು ಬೆಂಕಿಯಂತೆ ಉರಿಯಿತು.</para>
  <para style="q2" vid="PSA 39:3">ಕೊನೆಗೆ ನಾನು ಬಾಯಿಬಿಟ್ಟು ಮಾತನಾಡಿದೆನು:<verse eid="PSA 39:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 39:4"/>“ಯೆಹೋವ ದೇವರೇ, ನಾನು ಎಷ್ಟು ಅಸ್ಥಿರನೆಂದು ತಿಳಿಯುವ ಹಾಗೆ</para>
  <para style="q2" vid="PSA 39:4">ನನ್ನ ಜೀವನದ ಅಂತ್ಯವ ನನಗೆ ತೋರಿಸಿಕೊಡಿರಿ,</para>
  <para style="q2" vid="PSA 39:4">ನನ್ನ ದಿನಗಳು ಕೊಂಚವೆಂಬುದನ್ನೂ ನನಗೆ ತಿಳಿಸಿರಿ.<verse eid="PSA 39:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 39:5"/>ಇಗೋ, ನನ್ನ ದಿವಸಗಳನ್ನು ಅಂಗೈ ಅಗಲದಷ್ಟು ಮಾಡಿದ್ದೀರಿ.</para>
  <para style="q2" vid="PSA 39:5">ನನ್ನ ಆಯುಷ್ಯವು ನಿಮ್ಮ ಮುಂದೆ ಏನೂ ಇಲ್ಲದ ಹಾಗಿದೆ;</para>
  <para style="q1" vid="PSA 39:5">ಪ್ರತಿ ಮನುಷ್ಯನ ಜೀವನ</para>
  <para style="q2" vid="PSA 39:5">ಬರೀ ಉಸಿರೇ.<verse eid="PSA 39:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 39:6"/>“ನಿಶ್ಚಯವಾಗಿ ಮನುಷ್ಯನು ಮಾಯಾರೂಪದಿಂದ ನಡೆದಾಡುತ್ತಾನೆ;</para>
  <para style="q2" vid="PSA 39:6">ಅವನು ಸಡಗರದಿಂದ ಐಶ್ವರ್ಯವನ್ನು ರಾಶಿಯಾಗಿ ಕೂಡಿಸಿಕೊಳ್ಳುತ್ತಾನೆ;</para>
  <para style="q2" vid="PSA 39:6">ಆದರೆ ಅದನ್ನು ಅನುಭವಿಸುವವರು ಯಾರೋ ಅರಿಯನು.<verse eid="PSA 39:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 39:7"/>“ಹೀಗಿರಲಾಗಿ ಯೆಹೋವ ದೇವರೇ, ನಾನು ನಿರೀಕ್ಷಿಸುವುದೇನು?</para>
  <para style="q2" vid="PSA 39:7">ನನ್ನ ನಿರೀಕ್ಷೆ ನಿಮ್ಮಲ್ಲಿ ಇದೆ.<verse eid="PSA 39:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 39:8"/>ನನ್ನ ಎಲ್ಲಾ ಉಲ್ಲಂಘನೆಗಳಿಂದ ನನ್ನನ್ನು ಬಿಡಿಸಿರಿ;</para>
  <para style="q2" vid="PSA 39:8">ಬುದ್ಧಿಹೀನನ ನಿಂದೆಗೆ ನನ್ನನ್ನು ಪರಿಹಾಸ್ಯ ಮಾಡಬೇಡಿರಿ.<verse eid="PSA 39:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 39:9"/>ನಾನು ಮೌನವಾದೆನು, ಬಾಯಿ ತೆರೆಯಲಿಲ್ಲ;</para>
  <para style="q2" vid="PSA 39:9">ಇದನ್ನು ಮಾಡಿದವರು ನೀವೇ.<verse eid="PSA 39:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 39:10"/>ನಿಮ್ಮ ಪೆಟ್ಟನ್ನು ನನ್ನಿಂದ ತೊಲಗಿಸಿರಿ;</para>
  <para style="q2" vid="PSA 39:10">ನಿಮ್ಮ ಕೈಯ ಹೊಡೆತದಿಂದ ನಾನು ಕುಗ್ಗಿ ಹೋಗಿದ್ದೇನೆ.<verse eid="PSA 39:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 39:11"/>ಪಾಪದ ನಿಮಿತ್ತ ನೀವು ಮನುಷ್ಯನನ್ನು ಗದರಿಸಿ ಶಿಕ್ಷಿಸುವಾಗ</para>
  <para style="q2" vid="PSA 39:11">ಅವನ ಐಶ್ವರ್ಯವು ನುಸಿ ಹಿಡಿದಂತೆ ಹಾಳಾಗಿ ಹೋಗುತ್ತದೆ.</para>
  <para style="q2" vid="PSA 39:11">ನಿಶ್ಚಯವಾಗಿ ಪ್ರತಿ ಮನುಷ್ಯನು ಬರೀ ಉಸಿರೇ.<verse eid="PSA 39:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 39:12"/>“ಯೆಹೋವ ದೇವರೇ, ನನ್ನ ಪ್ರಾರ್ಥನೆಯನ್ನು ಕೇಳಿರಿ;</para>
  <para style="q2" vid="PSA 39:12">ನನ್ನ ಮೊರೆಗೆ ಕಿವಿಗೊಡಿರಿ;</para>
  <para style="q2" vid="PSA 39:12">ನನ್ನ ಕಣ್ಣೀರನ್ನು ನೋಡಿರಿ ಮೌನವಾಗಿರಬೇಡಿರಿ;</para>
  <para style="q1" vid="PSA 39:12">ಏಕೆಂದರೆ, ನಾನು ನನ್ನ ಪಿತೃಗಳೆಲ್ಲರ ಹಾಗೆ ನಿಮ್ಮ ಸಂಗಡ ಪರದೇಶಸ್ಥನಂತೆ ವಾಸಿಸುತ್ತೇನೆ;</para>
  <para style="q2" vid="PSA 39:12">ನಾನೂ ಪ್ರವಾಸಿಯಾಗಿದ್ದೇನೆ.<verse eid="PSA 39:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 39:13"/>ನಾನು ಹೊರಟುಹೋಗಿ ಇಲ್ಲವಾಗುವ ಮೊದಲು ನಾನು ಪುನಃ ಸಂತೋಷಿಸುವಂತೆ</para>
  <para style="q2" vid="PSA 39:13">ನಿಮ್ಮ ಕೋಪದ ದೃಷ್ಟಿಯನ್ನು ಬೇರೆ ಕಡೆ ತಿರುಗಿಸಿರಿ.”<verse eid="PSA 39:13"/></para>
  <chapter eid="PSA 39"/>
  <chapter number="40" style="c" sid="PSA 40"/>
  <para style="cl">ಕೀರ್ತನೆ 40</para>
  <para style="d">ಸಂಗೀತ ನಿರ್ದೇಶಕನಿಗಾಗಿರುವ ಕೀರ್ತನೆ. ದಾವೀದನ ಕೀರ್ತನೆ.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 40:1"/>ನಾನು ಯೆಹೋವ ದೇವರಿಗಾಗಿ ತಾಳ್ಮೆಯಿಂದ ಕಾದಿದ್ದೆನು;</para>
  <para style="q2" vid="PSA 40:1">ಅವರು ನನ್ನ ಕಡೆಗೆ ತಿರುಗಿ, ನನ್ನ ಮೊರೆಯನ್ನು ಕೇಳಿದರು.<verse eid="PSA 40:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 40:2"/>ನನ್ನನ್ನು ಜಾರುವ ಗುಂಡಿಯೊಳಗಿಂದ ಎತ್ತಿದರು.</para>
  <para style="q2" vid="PSA 40:2">ಕೆಸರಿನ ಮಣ್ಣಿನಿಂದ ಎಬ್ಬಿಸಿದರು.</para>
  <para style="q1" vid="PSA 40:2">ನನ್ನ ಪಾದಗಳನ್ನು ಬಂಡೆಯ ಮೇಲೆ ನಿಲ್ಲಿಸಿ,</para>
  <para style="q2" vid="PSA 40:2">ನನ್ನ ಹೆಜ್ಜೆಗಳನ್ನು ಸ್ಥಿರಪಡಿಸಿದರು.<verse eid="PSA 40:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 40:3"/>ನನ್ನ ಬಾಯಲ್ಲಿ ನೂತನ ಹಾಡನ್ನು ಹುಟ್ಟಿಸಿದ್ದಾರೆ,</para>
  <para style="q2" vid="PSA 40:3">ಆ ಹಾಡು ನಮ್ಮ ದೇವರ ಸ್ತೋತ್ರವೇ.</para>
  <para style="q1" vid="PSA 40:3">ಅನೇಕರು ಇದನ್ನು ಕಂಡು,</para>
  <para style="q2" vid="PSA 40:3">ಭಯಪಟ್ಟು ಯೆಹೋವ ದೇವರಲ್ಲಿ ಭರವಸೆ ಇಡುವರು.<verse eid="PSA 40:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 40:4"/>ಯೆಹೋವ ದೇವರನ್ನು ತನ್ನ ಭರವಸೆಯಾಗಿ ಮಾಡಿಕೊಂಡು</para>
  <para style="q2" vid="PSA 40:4">ಅಹಂಕಾರಿಗಳನ್ನು ಗೌರವಿಸದೆಯೂ</para>
  <para style="q1" vid="PSA 40:4">ಇಲ್ಲವೆ ಸುಳ್ಳಿನ ಕಡೆಗೆ ತಿರುಗಿಕೊಳ್ಳದೆಯೂ</para>
  <para style="q2" vid="PSA 40:4">ಇರುವ ಮನುಷ್ಯನು ಧನ್ಯನು.<verse eid="PSA 40:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 40:5"/>ನನ್ನ ದೇವರಾದ ಯೆಹೋವ ದೇವರೇ,</para>
  <para style="q2" vid="PSA 40:5">ನೀವು ಮಾಡಿದ ನಿಮ್ಮ ಅದ್ಭುತಕಾರ್ಯಗಳು ಎಷ್ಟೋ!</para>
  <para style="q2" vid="PSA 40:5">ನಮ್ಮ ಕಡೆ ನಿಮಗಿರುವ ಯೋಜನೆಗಳೂ ಬಹಳ,</para>
  <para style="q1" vid="PSA 40:5">ನಿಮಗೆ ಸರಿಸಾಟಿ ಯಾರೂ ಇಲ್ಲ.</para>
  <para style="q2" vid="PSA 40:5">ನಿಮ್ಮ ಕೃತ್ಯಗಳನ್ನು ನಾನು ತಿಳಿಸಿ ಹೇಳಬೇಕಾದರೆ,</para>
  <para style="q2" vid="PSA 40:5">ಅವು ಎಣಿಸಲು ಅಸಾಧ್ಯ.<verse eid="PSA 40:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 40:6"/>ಯಜ್ಞ ಮತ್ತು ಅರ್ಪಣೆಯನ್ನು ನೀವು ಇಷ್ಟಪಡಲಿಲ್ಲ.</para>
  <para style="q2" vid="PSA 40:6">ಆದರೆ ನೀವು ನನ್ನ ಕಿವಿಗಳನ್ನು ತೆರೆದಿರುವಿರಿ.</para>
  <para style="q2" vid="PSA 40:6">ದಹನಬಲಿಗಳನ್ನೂ ಪಾಪ ಪರಿಹಾರದ ಬಲಿಗಳನ್ನೂ ನೀವು ಬಯಸಲಿಲ್ಲ.<verse eid="PSA 40:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 40:7"/>ಆಗ ನಾನು, “ಇಗೋ, ನಾನು ಇದ್ದೇನೆ, ನಾನು ಬಂದಿದ್ದೇನೆ.</para>
  <para style="q2" vid="PSA 40:7">ಪುಸ್ತಕದ ಸುರುಳಿಯಲ್ಲಿ ನನ್ನನ್ನು ಕುರಿತು ಬರೆದಿದೆ.<verse eid="PSA 40:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 40:8"/>ನನ್ನ ದೇವರೇ, ನಿಮ್ಮ ಚಿತ್ತವನ್ನು ಮಾಡಲು ಬಯಸುತ್ತೇನೆ;</para>
  <para style="q2" vid="PSA 40:8">ನಿಮ್ಮ ನಿಯಮವು ನನ್ನ ಅಂತರಂಗದಲ್ಲಿ ಇದೆ.”<verse eid="PSA 40:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 40:9"/>ನಾನು ನಿಮ್ಮ ನೀತಿಯನ್ನು ದೊಡ್ಡ ಸಭೆಯಲ್ಲಿ ಸಾರಿದೆನು;</para>
  <para style="q2" vid="PSA 40:9">ಇಗೋ, ನಾನು ನನ್ನ ತುಟಿಗಳಿಂದ ಸಾರದೆ ಇರಲಿಲ್ಲವೆಂದು</para>
  <para style="q2" vid="PSA 40:9">ನೀವೇ ತಿಳಿದಿದ್ದೀರಿ.<verse eid="PSA 40:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 40:10"/>ನಾನು ನಿಮ್ಮ ನೀತಿಯನ್ನು ನನ್ನ ಹೃದಯದಲ್ಲಿ ಅಡಗಿಸಿಟ್ಟುಕೊಳ್ಳಲಿಲ್ಲ.</para>
  <para style="q2" vid="PSA 40:10">ನಿಮ್ಮ ನಂಬಿಗಸ್ತಿಕೆಯನ್ನೂ ನಿಮ್ಮ ರಕ್ಷಣೆಯನ್ನೂ</para>
  <para style="q1" vid="PSA 40:10">ನಿಮ್ಮ ಪ್ರೀತಿಯನ್ನೂ ಸತ್ಯವನ್ನೂ ದೊಡ್ಡ ಸಭೆಯಲ್ಲಿ</para>
  <para style="q2" vid="PSA 40:10">ನಾನು ಮರೆಮಾಡದೆ ಸಾರಿದೆನು.<verse eid="PSA 40:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 40:11"/>ಯೆಹೋವ ದೇವರೇ, ನಿಮ್ಮ ಕರುಣೆಯನ್ನು ನನ್ನಿಂದ ಹಿಂತೆಗೆಯಬೇಡಿರಿ;</para>
  <para style="q2" vid="PSA 40:11">ನಿಮ್ಮ ಪ್ರೀತಿಯೂ ನಿಮ್ಮ ಸತ್ಯವೂ ಯಾವಾಗಲೂ ನನ್ನನ್ನು ಕಾಯಲಿ.<verse eid="PSA 40:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 40:12"/>ಲೆಕ್ಕವಿಲ್ಲದಷ್ಟು ಕೇಡುಗಳು ನನ್ನನ್ನು ಸುತ್ತಿಕೊಂಡಿವೆ.</para>
  <para style="q2" vid="PSA 40:12">ನಾನು ಏನೂ ನೋಡಲಾರದಷ್ಟು ನನ್ನ ಪಾಪಗಳು ನನ್ನನ್ನು ಹಿಂದಟ್ಟಿ ಹಿಡಿದಿವೆ;</para>
  <para style="q1" vid="PSA 40:12">ನನ್ನ ಪಾಪಗಳು ತಲೆಯ ಕೂದಲುಗಳಿಗಿಂತ ಹೆಚ್ಚಾಗಿವೆ,</para>
  <para style="q2" vid="PSA 40:12">ಆದ್ದರಿಂದ ನನ್ನ ಹೃದಯವು ಕುಂದಿಹೋಗಿದೆ.<verse eid="PSA 40:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 40:13"/>ಯೆಹೋವ ದೇವರೇ, ನನ್ನನ್ನು ಬಿಡಿಸುವುದಕ್ಕೆ ತ್ವರೆಮಾಡಿರಿ.</para>
  <para style="q2" vid="PSA 40:13">ಯೆಹೋವ ದೇವರೇ, ನನಗೆ ಸಹಾಯಮಾಡಲು ಬೇಗನೆ ಬನ್ನಿರಿ.<verse eid="PSA 40:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 40:14"/>ನನ್ನ ಪ್ರಾಣ ತೆಗೆಯಲು ಯತ್ನಿಸುವವರೆಲ್ಲರು</para>
  <para style="q2" vid="PSA 40:14">ನಾಚಿಕೆಪಟ್ಟು ಗಲಿಬಿಲಿಯಾಗಲಿ.</para>
  <para style="q1" vid="PSA 40:14">ನನ್ನ ಕೇಡಿನಲ್ಲಿ ಸಂತೋಷಪಡುವವರೆಲ್ಲರೂ</para>
  <para style="q2" vid="PSA 40:14">ಹಿಂಜರಿದು ಅವಮಾನ ಹೊಂದಲಿ.<verse eid="PSA 40:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 40:15"/>“ಆಹಾ! ಆಹಾ!” ಎಂದು ನನ್ನನ್ನು ಹಾಸ್ಯಮಾಡುವವರು</para>
  <para style="q2" vid="PSA 40:15">ತಮ್ಮ ನಾಚಿಕೆಯಿಂದಲೇ ವಿಸ್ಮಯಗೊಳ್ಳಲಿ.<verse eid="PSA 40:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 40:16"/>ಆದರೆ, ನಿಮ್ಮನ್ನು ಹುಡುಕುವವರೆಲ್ಲರೂ</para>
  <para style="q2" vid="PSA 40:16">ನಿಮ್ಮಲ್ಲಿ ಹರ್ಷಾನಂದಗೊಳ್ಳಲಿ;</para>
  <para style="q1" vid="PSA 40:16">ನಿಮ್ಮ ರಕ್ಷಣೆಯನ್ನು ಪ್ರೀತಿಸುವವರು,</para>
  <para style="q2" vid="PSA 40:16">“ಯೆಹೋವ ದೇವರು ಮಹೋನ್ನತರು,” ಎಂದು ಯಾವಾಗಲೂ ಹೇಳಲಿ.<verse eid="PSA 40:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 40:17"/>ನಾನು ಬಡವನೂ ಅಗತ್ಯದಲ್ಲಿರುವವನೂ ಆಗಿದ್ದೇನೆ;</para>
  <para style="q2" vid="PSA 40:17">ಆದರೂ ಯೆಹೋವ ದೇವರು ನನ್ನ ಹಿತಚಿಂತಕರಾಗಿದ್ದಾರೆ.</para>
  <para style="q1" vid="PSA 40:17">ನನ್ನ ದೇವರೇ ನೀವೇ ನನ್ನ ಸಹಾಯವೂ ನನ್ನ ವಿಮೋಚಕರೂ ಆಗಿದ್ದೀರಿ,</para>
  <para style="q2" vid="PSA 40:17">ನೀವು ತಡಮಾಡಬೇಡಿರಿ.<verse eid="PSA 40:17"/></para>
  <chapter eid="PSA 40"/>
  <chapter number="41" style="c" sid="PSA 41"/>
  <para style="cl">ಕೀರ್ತನೆ 41</para>
  <para style="d">ಸಂಗೀತ ನಿರ್ದೇಶಕನಿಗಾಗಿರುವ ಕೀರ್ತನೆ. ದಾವೀದನ ಕೀರ್ತನೆ.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 41:1"/>ಬಡವರನ್ನು ಪರಾಮರಿಸುವವರು ಧನ್ಯರು;</para>
  <para style="q2" vid="PSA 41:1">ಕೇಡಿನ ಸಮಯದಲ್ಲಿ ಯೆಹೋವ ದೇವರು ಅವರನ್ನು ತಪ್ಪಿಸುವರು.<verse eid="PSA 41:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 41:2"/>ಯೆಹೋವ ದೇವರು ಅವರನ್ನು ಕಾಪಾಡಿ ಸುರಕ್ಷಿತವಾಗಿಡುವರು;</para>
  <para style="q2" vid="PSA 41:2">ಅವರು ಭೂಮಿಯಲ್ಲಿ ಧನ್ಯರಾಗಿರುವರು;</para>
  <para style="q2" vid="PSA 41:2">ದೇವರು ಅವರ ಶತ್ರುಗಳ ಇಚ್ಛೆಗೆ ಅವರನ್ನು ಒಪ್ಪಿಸಿಕೊಡರು.<verse eid="PSA 41:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 41:3"/>ಬಡವರನ್ನು ಪರಾಮರಿಸುವವರನ್ನು ಯೆಹೋವ ದೇವರು ವ್ಯಾಧಿಯ ಮಂಚದಲ್ಲಿ ಬಲಪಡಿಸುವರು;</para>
  <para style="q2" vid="PSA 41:3">ಅವರ ಅಸ್ವಸ್ಥತೆಯನ್ನು ಯೆಹೋವ ದೇವರು ಹೋಗಲಾಡಿಸಿ ಮರುಸ್ಥಾಪಿಸುವರು.<verse eid="PSA 41:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 41:4"/>“ಯೆಹೋವ ದೇವರೇ, ನನಗೆ ಕರುಣೆ ತೋರಿಸಿ ನನ್ನನ್ನು ಸ್ವಸ್ಥಮಾಡಿರಿ,</para>
  <para style="q2" vid="PSA 41:4">ಏಕೆಂದರೆ ನಿಮಗೆ ವಿರೋಧವಾಗಿ ಪಾಪಮಾಡಿದ್ದೇನೆ,”</para>
  <para style="q2" vid="PSA 41:4">ಎಂದು ನಾನು ಹೇಳಿ ಬೇಡುವೆನು.<verse eid="PSA 41:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 41:5"/>“ಅವನು ಸತ್ತು ಅವನ ಹೆಸರು ನಾಶವಾಗುವುದು ಯಾವಾಗ?”</para>
  <para style="q2" vid="PSA 41:5">ಎಂದು ನನ್ನ ಶತ್ರುಗಳು ನನ್ನ ಕೇಡನ್ನು ಬಯಸಿ ಮಾತನಾಡುತ್ತಾರೆ.<verse eid="PSA 41:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 41:6"/>ನನ್ನನ್ನು ನೋಡುವುದಕ್ಕೆ ಅವರಲ್ಲಿ ಒಬ್ಬನು ಬಂದರೆ, ಕಪಟವಾಗಿ ಮಾತನಾಡುತ್ತಾನೆ.</para>
  <para style="q2" vid="PSA 41:6">ಅವನ ಹೃದಯ ಕೇಡನ್ನು ಕೂಡಿಟ್ಟುಕೊಳ್ಳುತ್ತಿದೆ.</para>
  <para style="q2" vid="PSA 41:6">ಅವನು ಹೊರಗೆ ಹೋದ ಮೇಲೆ ಕೇಡನ್ನು ಹಬ್ಬಿಸುತ್ತಾನೆ.<verse eid="PSA 41:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 41:7"/>ನನ್ನ ಶತ್ರುಗಳೆಲ್ಲರೂ ಸೇರಿ ನನ್ನ ಮೇಲೆ ಪಿಸುಗುಟ್ಟುತ್ತಾರೆ;</para>
  <para style="q2" vid="PSA 41:7">ನನಗೆ ವಿರೋಧವಾಗಿ ಕೇಡನ್ನು ಕಲ್ಪಿಸುತ್ತಾರೆ.<verse eid="PSA 41:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 41:8"/>“ಕೆಟ್ಟ ರೋಗವು ಅವನನ್ನು ಹಿಡಿದಿದೆ,</para>
  <para style="q2" vid="PSA 41:8">ಈಗ ಅವನು ಹಾಸಿಗೆ ಹಿಡಿದಿದ್ದಾನೆ ಎಂದಿಗೂ ಏಳುವುದಿಲ್ಲ,”</para>
  <para style="q2" vid="PSA 41:8">ಎಂದು ಹೇಳಿಕೊಳ್ಳುತ್ತಾರೆ.<verse eid="PSA 41:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 41:9"/>ನನ್ನ ರೊಟ್ಟಿಯನ್ನು ತಿಂದವನೂ</para>
  <para style="q2" vid="PSA 41:9">ನಾನು ನಂಬಿದ್ದವನೂ</para>
  <para style="q1" vid="PSA 41:9">ಆಗಿರುವ ನನ್ನ ಆಪ್ತ ಸ್ನೇಹಿತನು ಸಹ</para>
  <para style="q2" vid="PSA 41:9">ನನಗೆ ವಿರೋಧವಾಗಿ ತನ್ನ ಕಾಲನ್ನು ಎತ್ತಿದ್ದಾನೆ.<verse eid="PSA 41:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 41:10"/>ಆದರೆ ಯೆಹೋವ ದೇವರೇ, ನೀವು ನನ್ನನ್ನು ಕರುಣಿಸಿ ನಾನು ಏಳುವಂತೆ ಮಾಡಿರಿ.</para>
  <para style="q2" vid="PSA 41:10">ನಾನು ಅವರಿಗೆ ಮುಯ್ಯಿಗೆ ಮುಯ್ಯಿತೀರಿಸುವೆನು.<verse eid="PSA 41:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 41:11"/>ನನ್ನ ಶತ್ರು ನನ್ನ ಮೇಲೆ ಜಯ ಹೊಂದದೆ ಇರುವುದರಿಂದಲೇ,</para>
  <para style="q2" vid="PSA 41:11">ನೀವು ನನ್ನನ್ನು ಮೆಚ್ಚಿದ್ದೀರಿ ಎಂದು ನಾನು ತಿಳಿದುಕೊಳ್ಳುವೆ.<verse eid="PSA 41:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 41:12"/>ಆದರೆ ನೀವು ನನ್ನ ಪ್ರಾಮಾಣಿಕತೆಯ ಕಾರಣ ನನ್ನನ್ನು ಎತ್ತಿ ಹಿಡಿದಿರುವಿರಿ;</para>
  <para style="q2" vid="PSA 41:12">ನೀವು ನನ್ನನ್ನು ನಿತ್ಯವಾಗಿ ನಿಮ್ಮ ಸಮ್ಮುಖದಲ್ಲಿ ಇರಿಸುವಿರಿ.<verse eid="PSA 41:12"/></para>
  <para style="b"/>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 41:13"/>ಇಸ್ರಾಯೇಲರ ದೇವರಾಗಿರುವ ಯೆಹೋವ ದೇವರಿಗೆ,</para>
  <para style="q2" vid="PSA 41:13">ಯುಗಯುಗಕ್ಕೂ ಸ್ತುತಿಯಾಗಲಿ.</para>
  <para style="qc" vid="PSA 41:13">ಆಮೆನ್, ಆಮೆನ್.<verse eid="PSA 41:13"/></para>
  <chapter eid="PSA 41"/>
  <chapter number="42" style="c" sid="PSA 42"/>
  <para style="ms">ಭಾಗ 2</para>
  <para style="mr">ಕೀರ್ತನೆಗಳು <ref loc="PSA 42-72">42–72</ref></para>
  <para style="cl">ಕೀರ್ತನೆ 42</para>
  <para style="d">ಸಂಗೀತ ನಿರ್ದೇಶಕನಿಗಾಗಿರುವ ಕೀರ್ತನೆ. ಕೋರಹೀಯರ ಮಕ್ಕಳ <char style="tl">ಮಾಸ್ಕಿಲ</char><note caller="+" style="f"><char style="fr" closed="false">42:0 </char><char style="fq" closed="false">ಮಾಸ್ಕಿಲ </char><char style="ft" closed="false">ಬಹುಶಃ </char><char style="fqa" closed="false">ಸಾಹಿತ್ಯಿಕ </char><char style="ft" closed="false">ಅಥವಾ </char><char style="fqa" closed="false">ಸಂಗೀತ ಪದ</char></note> ಪದ್ಯ.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 42:1"/>ದೇವರೇ, ಜಿಂಕೆಯು ನೀರಿನ ತೊರೆಗಳನ್ನು ಹೇಗೆ ಬಯಸುವುದೋ,</para>
  <para style="q2" vid="PSA 42:1">ಹಾಗೆಯೇ ನನ್ನ ಪ್ರಾಣವು ನಿಮ್ಮನ್ನು ಬಯಸುತ್ತದೆ.<verse eid="PSA 42:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 42:2"/>ದೇವರಿಗೋಸ್ಕರ ಹೌದು ಜೀವವುಳ್ಳ ದೇವರಿಗೋಸ್ಕರ ನನ್ನ ಪ್ರಾಣವು ದಾಹಗೊಳ್ಳುತ್ತದೆ.</para>
  <para style="q2" vid="PSA 42:2">ನಾನು ಯಾವಾಗ ಹೋಗಿ ದೇವರ ಮುಂದೆ ಕಾಣಿಸಿಕೊಳ್ಳಲಿ?<verse eid="PSA 42:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 42:3"/>“ನಿನ್ನ ದೇವರು ಎಲ್ಲಿ?” ಎಂದು ಜನರು,</para>
  <para style="q2" vid="PSA 42:3">ದಿನವೆಲ್ಲಾ ನನ್ನನ್ನು ಕೇಳುವುದರಿಂದ</para>
  <para style="q2" vid="PSA 42:3">ಹಗಲುರಾತ್ರಿ ನನ್ನ ಕಣ್ಣೀರೇ ನನಗೆ ಆಹಾರವಾಗಿದೆ.<verse eid="PSA 42:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 42:4"/>ಜನಸಮೂಹದೊಂದಿಗೆ ನಾನು ಉತ್ಸಾಹದಿಂದಲೂ ಸ್ತೋತ್ರದಿಂದಲೂ</para>
  <para style="q2" vid="PSA 42:4">ಹಬ್ಬವನ್ನಾಚರಿಸಲು ದೇವರ ಆಲಯಕ್ಕೆ ಹೋಗಿದ್ದನ್ನು ನೆನಪಿಸಿಕೊಳ್ಳುತ್ತಾ</para>
  <para style="q2" vid="PSA 42:4">ನನ್ನೊಳಗೆ ನಾನೇ ಹಂಬಲಿಸುತ್ತಿರುವೆನು.<verse eid="PSA 42:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 42:5"/>ನನ್ನ ಪ್ರಾಣವೇ, ನೀನು ಏಕೆ ಕುಗ್ಗಿ ಹೋಗಿದ್ದೀ?</para>
  <para style="q2" vid="PSA 42:5">ನನ್ನಲ್ಲಿ ನೀನು ಏಕೆ ವ್ಯಥೆಪಡುತ್ತೀ?</para>
  <para style="q1" vid="PSA 42:5">ದೇವರನ್ನು ನಿರೀಕ್ಷಿಸು; ಅವರೇ ನನ್ನ ರಕ್ಷಕರೂ ದೇವರೂ ಆಗಿದ್ದಾರೆ.</para>
  <para style="q2" vid="PSA 42:5">ಹೌದು, ನಾನು</para>
  <para style="q2" vid="PSA 42:5">ದೇವರನ್ನೇ ಕೊಂಡಾಡುತ್ತಿರುವೆನು.<verse eid="PSA 42:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 42:6"/>ನನ್ನ ದೇವರೇ, ನನ್ನ ಪ್ರಾಣವು ನನ್ನಲ್ಲಿ ಕುಗ್ಗಿಹೋಗಿದೆ;</para>
  <para style="q2" vid="PSA 42:6">ಆದ್ದರಿಂದ ಯೊರ್ದನ್ ನಾಡಿನಿಂದಲೂ</para>
  <para style="q1" vid="PSA 42:6">ಹೆರ್ಮೋನ್ ಬೆಟ್ಟಗಳಿಂದಲೂ</para>
  <para style="q2" vid="PSA 42:6">ಮಿಸಾರ್ ಬೆಟ್ಟದಿಂದಲೂ ನಿಮ್ಮನ್ನು ಜ್ಞಾಪಕಮಾಡಿಕೊಳ್ಳುತ್ತೇನೆ.<verse eid="PSA 42:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 42:7"/>ನಿಮ್ಮ ಜಲಪಾತಗಳ ಶಬ್ದವು</para>
  <para style="q2" vid="PSA 42:7">ಒಂದು ಪ್ರವಾಹವು ಮತ್ತೊಂದು ಪ್ರವಾಹಕ್ಕೆ ಕರೆಯುವಂತಿದೆ.</para>
  <para style="q1" vid="PSA 42:7">ಅದರಂತೆಯೇ ನಿಮ್ಮ ಎಲ್ಲಾ ಅಲೆಗಳೂ ತೆರೆಗಳೂ</para>
  <para style="q2" vid="PSA 42:7">ನನ್ನ ಮೇಲೆ ಹಾದು ಹೋದಂತಿವೆ.<verse eid="PSA 42:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 42:8"/>ಆದರೂ ಹಗಲಿನಲ್ಲಿ ಯೆಹೋವ ದೇವರು ತಮ್ಮ ಪ್ರೀತಿಯನ್ನು ಆಜ್ಞಾಪಿಸುವರು.</para>
  <para style="q2" vid="PSA 42:8">ರಾತ್ರಿಯಲ್ಲಿ ದೇವರ ಹಾಡನ್ನು ಹಾಡುವೆನು.</para>
  <para style="q2" vid="PSA 42:8">ನನ್ನ ಜೀವವಾಗಿರುವ ದೇವರಿಗೆ ನಾನು ಪ್ರಾರ್ಥನೆ ಮಾಡುವೆನು.<verse eid="PSA 42:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 42:9"/>“ದೇವರೇ, ಏಕೆ ನನ್ನನ್ನು ಮರೆತುಬಿಟ್ಟಿದ್ದೀರಿ?</para>
  <para style="q2" vid="PSA 42:9">ಏಕೆ ನಾನು ಶತ್ರುವಿನ ಬಾಧೆಪೀಡಿತನಾಗಿ</para>
  <para style="q1" vid="PSA 42:9">ದುಃಖದಲ್ಲಿ ಸಾಗಬೇಕು?” ಎಂದು</para>
  <para style="q2" vid="PSA 42:9">ನನ್ನ ಶರಣನಾದ ದೇವರಿಗೆ ಮೊರೆಯಿಡುವೆನು.<verse eid="PSA 42:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 42:10"/>“ನಿನ್ನ ದೇವರು ಎಲ್ಲಿ?”</para>
  <para style="q2" vid="PSA 42:10">ಎಂದು ದಿನವೆಲ್ಲಾ ನನಗೆ ಹೇಳಿ</para>
  <para style="q1" vid="PSA 42:10">ನನ್ನ ವೈರಿಗಳು ಅಪಹಾಸ್ಯ ಮಾಡುವುದರಿಂದ</para>
  <para style="q2" vid="PSA 42:10">ನನ್ನ ಎಲಬುಗಳೆಲ್ಲಾ ಮುರಿದುಹೊದಂತೆ ಇವೆ.<verse eid="PSA 42:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 42:11"/>ನನ್ನ ಪ್ರಾಣವೇ, ನೀನು ಏಕೆ ಕುಗ್ಗಿ ಹೋಗಿದ್ದೀ?</para>
  <para style="q2" vid="PSA 42:11">ನನ್ನಲ್ಲಿ ನೀನು ಏಕೆ ವ್ಯಥೆಪಡುತ್ತೀ?</para>
  <para style="q1" vid="PSA 42:11">ದೇವರನ್ನು ನಿರೀಕ್ಷಿಸು; ಅವರೇ ನನ್ನ ರಕ್ಷಕರೂ ದೇವರೂ ಆಗಿದ್ದಾರೆ.</para>
  <para style="q2" vid="PSA 42:11">ಹೌದು, ನಾನು</para>
  <para style="q2" vid="PSA 42:11">ದೇವರನ್ನೇ ಕೊಂಡಾಡುತ್ತಿರುವೆನು.<verse eid="PSA 42:11"/></para>
  <chapter eid="PSA 42"/>
  <chapter number="43" style="c" sid="PSA 43"/>
  <para style="cl">ಕೀರ್ತನೆ 43</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 43:1"/>ದೇವರೇ, ನನ್ನನ್ನು ನಿರ್ದೋಷಿ ಎಂದು ನಿರ್ಣಯಿಸಿರಿ,</para>
  <para style="q2" vid="PSA 43:1">ಭಕ್ತಿಹೀನ ಜನತೆಯ ವಿರೋಧವಾಗಿ</para>
  <para style="q2" vid="PSA 43:1">ನನ್ನ ನ್ಯಾಯವನ್ನು ವಾದಿಸಿರಿ.</para>
  <para style="q1" vid="PSA 43:1">ಮೋಸವೂ ಅನ್ಯಾಯವೂ ಉಳ್ಳ ಮನುಷ್ಯನಿಂದ</para>
  <para style="q2" vid="PSA 43:1">ನನ್ನನ್ನು ತಪ್ಪಿಸಿರಿ.<verse eid="PSA 43:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 43:2"/>ನೀವು ನನ್ನ ದೇವರು, ನನ್ನ ಬಲವಾದ ಕೋಟೆಯು;</para>
  <para style="q2" vid="PSA 43:2">ನೀವು ಏಕೆ ನನ್ನನ್ನು ತಳ್ಳಿಬಿಟ್ಟಿದ್ದೀರಿ?</para>
  <para style="q1" vid="PSA 43:2">ಏಕೆ ನಾನು ಶತ್ರುವಿನ ಬಾಧೆಯಿಂದ</para>
  <para style="q2" vid="PSA 43:2">ದುಃಖದಲ್ಲಿ ನಡೆದುಕೊಳ್ಳಬೇಕು?<verse eid="PSA 43:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 43:3"/>ನಿಮ್ಮ ಬೆಳಕನ್ನೂ ನಿಮ್ಮ ಸತ್ಯವನ್ನೂ ಕಳುಹಿಸಿರಿ;</para>
  <para style="q2" vid="PSA 43:3">ಅವು ನನ್ನನ್ನು ನೀವು ವಾಸಿಸುವ</para>
  <para style="q1" vid="PSA 43:3">ನಿಮ್ಮ ಪರಿಶುದ್ಧ ಪರ್ವತಕ್ಕೆ</para>
  <para style="q2" vid="PSA 43:3">ನನ್ನನ್ನು ಬರಮಾಡಲಿ.<verse eid="PSA 43:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 43:4"/>ದೇವರೇ, ನನ್ನ ದೇವರೇ, ಆಗ ನಿಮ್ಮ ಬಲಿಪೀಠದ ಬಳಿಗೆ ಬರುವೆನು.</para>
  <para style="q2" vid="PSA 43:4">ನನ್ನ ಸಂತೋಷವೂ ಹರ್ಷವೂ</para>
  <para style="q1" vid="PSA 43:4">ಆಗಿರುವ ನಿಮ್ಮ ಬಳಿಗೂ ಬಂದು,</para>
  <para style="q2" vid="PSA 43:4">ಕಿನ್ನರಿಯಿಂದ ನಿಮ್ಮನ್ನು ಕೊಂಡಾಡುವೆನು.<verse eid="PSA 43:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 43:5"/>ನನ್ನ ಪ್ರಾಣವೇ, ನೀನು ಏಕೆ ಕುಗ್ಗಿ ಹೋಗಿದ್ದೀ?</para>
  <para style="q2" vid="PSA 43:5">ನನ್ನಲ್ಲಿ ನೀನು ಏಕೆ ವ್ಯಥೆಪಡುತ್ತೀ?</para>
  <para style="q1" vid="PSA 43:5">ದೇವರನ್ನು ನಿರೀಕ್ಷಿಸು; ಅವರೇ ನನ್ನ ರಕ್ಷಕರೂ ದೇವರೂ ಆಗಿದ್ದಾರೆ.</para>
  <para style="q2" vid="PSA 43:5">ಹೌದು, ನಾನು</para>
  <para style="q2" vid="PSA 43:5">ದೇವರನ್ನೇ ಕೊಂಡಾಡುತ್ತಿರುವೆನು.<verse eid="PSA 43:5"/></para>
  <chapter eid="PSA 43"/>
  <chapter number="44" style="c" sid="PSA 44"/>
  <para style="cl">ಕೀರ್ತನೆ 44</para>
  <para style="d">ಸಂಗೀತ ನಿರ್ದೇಶಕನಿಗಾಗಿರುವ ಕೀರ್ತನೆ. ಕೋರಹೀಯರ ಮಕ್ಕಳ <char style="tl">ಮಾಸ್ಕಿಲ</char><note caller="+" style="f"><char style="fr" closed="false">44:0 </char><char style="fq" closed="false">ಮಾಸ್ಕಿಲ </char><char style="ft" closed="false">ಬಹುಶಃ </char><char style="fqa" closed="false">ಸಾಹಿತ್ಯಿಕ </char><char style="ft" closed="false">ಅಥವಾ </char><char style="fqa" closed="false">ಸಂಗೀತ ಪದ</char></note> ಪದ್ಯ.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 44:1"/>ದೇವರೇ, ನಾವು ನಮ್ಮ ಕಿವಿಯಾರೆ ಕೇಳಿದ್ದೇವೆ;</para>
  <para style="q2" vid="PSA 44:1">ನೀವು ಪೂರ್ವಕಾಲದಲ್ಲಿ ನಮ್ಮ ಪಿತೃಗಳ</para>
  <para style="q1" vid="PSA 44:1">ದಿವಸಗಳಲ್ಲಿ ಮಾಡಿದ ಕಾರ್ಯವನ್ನು</para>
  <para style="q2" vid="PSA 44:1">ನಮಗೆ ಅವರು ವಿವರಿಸಿದ್ದಾರೆ.<verse eid="PSA 44:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 44:2"/>ನೀವು ನಿಮ್ಮ ಕೈಯಿಂದ ಜನಾಂಗಗಳನ್ನು ಹೊರಡಿಸಿ,</para>
  <para style="q2" vid="PSA 44:2">ನಮ್ಮ ಪಿತೃಗಳನ್ನು ನೆಲೆಗೊಳಿಸಿದಿರಿ;</para>
  <para style="q1" vid="PSA 44:2">ನೀವು ವೈರಿಗಳನ್ನು ತೆಗೆದುಹಾಕಿ,</para>
  <para style="q2" vid="PSA 44:2">ನಮ್ಮ ಪಿತೃಗಳಿಗೆ ಸಮೃದ್ಧಿಯನ್ನುಂಟು ಮಾಡಿದಿರಿ.<verse eid="PSA 44:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 44:3"/>ನಮ್ಮ ಪಿತೃಗಳು ತಮ್ಮ ಖಡ್ಗದಿಂದ ದೇಶವನ್ನು ಸ್ವಾಧೀನಪಡಿಸಿಕೊಳ್ಳಲಿಲ್ಲ;</para>
  <para style="q2" vid="PSA 44:3">ಅವರ ತೋಳು ಅವರಿಗೆ ಜಯ ತರಲಿಲ್ಲ;</para>
  <para style="q1" vid="PSA 44:3">ಆದರೆ ನಿಮ್ಮ ಬಲಗೈಯೂ ನಿಮ್ಮ ತೋಳೂ ನಿಮ್ಮ ಮುಖದ ಪ್ರಕಾಶವೇ ಅವರಿಗೆ ಜಯವನ್ನು ತಂದಿತು.</para>
  <para style="q2" vid="PSA 44:3">ಏಕೆಂದರೆ ಅವರನ್ನು ನೀವು ಪ್ರೀತಿಸಿದಿರಿ.<verse eid="PSA 44:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 44:4"/>ನೀವೇ ನನ್ನ ಅರಸರೂ ದೇವರೂ ಆಗಿದ್ದೀರಿ.</para>
  <para style="q2" vid="PSA 44:4">ಯಾಕೋಬಿಗೆ ಜಯವನ್ನು ಆಜ್ಞಾಪಿಸುವ ದೇವರಾಗಿದ್ದೀರಿ.<verse eid="PSA 44:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 44:5"/>ನಿಮ್ಮಿಂದ ನಮ್ಮ ವೈರಿಗಳನ್ನು ದಬ್ಬುವೆವು;</para>
  <para style="q2" vid="PSA 44:5">ನಿಮ್ಮ ಹೆಸರಿನಲ್ಲಿ ನಮ್ಮ ಎದುರಾಳಿಗಳನ್ನು ತುಳಿಯುವೆವು.<verse eid="PSA 44:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 44:6"/>ನಾನು ನನ್ನ ಬಿಲ್ಲಿನಲ್ಲಿ ಭರವಸೆ ಇಡುವುದಿಲ್ಲ;</para>
  <para style="q2" vid="PSA 44:6">ನನ್ನ ಖಡ್ಗವು ನನಗೆ ಜಯ ತರುವುದಿಲ್ಲ.<verse eid="PSA 44:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 44:7"/>ಆದರೆ ನೀವು ನಮ್ಮ ವೈರಿಗಳ ಮೇಲೆ ನಮಗೆ ಜಯವನ್ನು ಕೊಟ್ಟಿದ್ದೀರಿ.</para>
  <para style="q2" vid="PSA 44:7">ನೀವು ನಮ್ಮನ್ನು ದ್ವೇಷಿಸುವವರನ್ನು ನಾಚಿಕೆಪಡಿಸಿದಿರಿ.<verse eid="PSA 44:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 44:8"/>ದೇವರಲ್ಲಿ ದಿನವೆಲ್ಲಾ ನಾವು ಹಿಗ್ಗುತ್ತಿದ್ದೇವೆ;</para>
  <para style="q2" vid="PSA 44:8">ನಿಮ್ಮ ಹೆಸರನ್ನು ಯುಗಯುಗಕ್ಕೂ ಕೊಂಡಾಡುವೆವು.<verse eid="PSA 44:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 44:9"/>ಆದರೆ ಈಗ ನೀವು ನಮ್ಮನ್ನು ತಳ್ಳಿಬಿಟ್ಟದ್ದರಿಂದ ನಾವು ಕುಗ್ಗಿಹೋಗಿದ್ದೇವೆ.</para>
  <para style="q2" vid="PSA 44:9">ನಮ್ಮ ಸೈನ್ಯಗಳ ಸಂಗಡ ನೀವು ಹೊರಡಲಿಲ್ಲ.<verse eid="PSA 44:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 44:10"/>ವೈರಿಯ ಮುಂದೆ ನಾವು ಓಡಿಹೋಗುವಂತೆ ಮಾಡಿದ್ದೀರಿ.</para>
  <para style="q2" vid="PSA 44:10">ನಮ್ಮ ವೈರಿಗಳು ನಮ್ಮ ಸೊತ್ತನ್ನು ಕೊಳ್ಳೆ ಹೊಡೆಯುತ್ತಾರೆ.<verse eid="PSA 44:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 44:11"/>ಕಡಿಯತಕ್ಕ ಕುರಿಗಳಂತೆ ನಮ್ಮನ್ನು ಅವರಿಗೆ ಒಪ್ಪಿಸಿದ್ದೀರಿ;</para>
  <para style="q2" vid="PSA 44:11">ಜನಾಂಗಗಳಲ್ಲಿ ನಮ್ಮನ್ನು ಚದರಿಸಿದ್ದೀರಿ.<verse eid="PSA 44:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 44:12"/>ನಿಮ್ಮ ಜನರನ್ನು ನೀವು ಕ್ರಯವಿಲ್ಲದೆ ಮಾರಿಬಿಟ್ಟಂತಿದೆ.</para>
  <para style="q2" vid="PSA 44:12">ಆ ಮಾರಾಟದಿಂದ ಲಾಭ ಏನೂ ಇಲ್ಲದಂತಿದೆ.<verse eid="PSA 44:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 44:13"/>ನಮ್ಮ ನೆರೆಯವರಿಗೆ ನಾವು ನಿಂದೆಯಾಗಿದ್ದೇವೆ.</para>
  <para style="q2" vid="PSA 44:13">ನಮ್ಮ ಸುತ್ತಲಿರುವವರಿಗೆ ಗೇಲಿಯಾಗಿಯೂ ಹಾಸ್ಯವೂ ಆಗಿದ್ದೇವೆ.<verse eid="PSA 44:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 44:14"/>ನಮ್ಮನ್ನು ಇತರ ದೇಶಗಳವರ ಗಾದೆಗೆ ಆಸ್ಪದ ಮಾಡಿರುವಿರಿ;</para>
  <para style="q2" vid="PSA 44:14">ಅವರು ನಮ್ಮನ್ನು ಪರಿಹಾಸ್ಯದ ವಿಷಯವನ್ನಾಗಿ ಮಾಡಿಕೊಂಡಿದ್ದಾರೆ.<verse eid="PSA 44:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 44:15"/>ನಿಂದಕನ ಮತ್ತು ದೂಷಕನ ಮಾತುಗಳಿಗೂ</para>
  <para style="q2" vid="PSA 44:15">ಮುಯ್ಯಿಗೆ ಮುಯ್ಯಿ ತೀರಿಸುವ ಶತ್ರುವಿನ ನಿಮಿತ್ತವೂ,<verse eid="PSA 44:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 44:16"/>ಸದಾ ನನ್ನ ಅವಮಾನವು ನನ್ನ ಮುಂದೆ ಇದೆ;</para>
  <para style="q2" vid="PSA 44:16">ನನ್ನ ಮುಖವು ನಾಚಿಕೆಯಿಂದ ಮುಚ್ಚಿದೆ.<verse eid="PSA 44:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 44:17"/>ಇದೆಲ್ಲಾ ನಮ್ಮ ಮೇಲೆ ಬಂತು;</para>
  <para style="q2" vid="PSA 44:17">ಆದರೆ ನಾವು ನಿಮ್ಮನ್ನು ಮರೆತುಬಿಡಲಿಲ್ಲ;</para>
  <para style="q2" vid="PSA 44:17">ನಿಮ್ಮ ಒಡಂಬಡಿಕೆಯನ್ನು ಬಿಡಲಿಲ್ಲ.<verse eid="PSA 44:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 44:18"/>ನಮ್ಮ ಹೃದಯವು ಹಿಂದಿರುಗಲಿಲ್ಲ;</para>
  <para style="q2" vid="PSA 44:18">ನಮ್ಮ ಹೆಜ್ಜೆಗಳು ನಿಮ್ಮ ಹಾದಿಯಿಂದ ತೊಲಗಲಿಲ್ಲ.<verse eid="PSA 44:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 44:19"/>ಆದರೂ ನರಿಗಳ ವಾಸಸ್ಥಳದಂತೆ ನಮ್ಮ ದೇಶವಿದೆ.</para>
  <para style="q2" vid="PSA 44:19">ಕಾರ್ಗತ್ತಲಿನ ನೆರಳು ನಮ್ಮನ್ನು ಮುಚ್ಚಿಬಿಟ್ಟಂತಿದೆ.<verse eid="PSA 44:19"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 44:20"/>ನಾವು ನಮ್ಮ ದೇವರ ಹೆಸರನ್ನು ಮರೆತು</para>
  <para style="q2" vid="PSA 44:20">ಅನ್ಯ ದೇವರಿಗೆ ನಮ್ಮ ಕೈಗಳನ್ನು ಚಾಚಿದ್ದರೆ,<verse eid="PSA 44:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 44:21"/>ದೇವರೇ ಹೃದಯದ ರಹಸ್ಯಗಳನ್ನು ತಿಳಿದಿರುವ ನಿಮಗೆ</para>
  <para style="q2" vid="PSA 44:21">ಅವೆಲ್ಲವೂ ಮರೆಯಾಗಿರುತ್ತಿರಲಿಲ್ಲ.<verse eid="PSA 44:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 44:22"/>ಹೌದು, ನಿಮಗೋಸ್ಕರ ನಾವು ದಿನವೆಲ್ಲಾ ಮರಣಕ್ಕೆ ಗುರಿಯಾಗಿದ್ದೇವೆ.</para>
  <para style="q2" vid="PSA 44:22">ವಧಿಸಲಿಕ್ಕಾಗಿರುವ ಕುರಿಗಳಂತೆ ಜನರು ನಮ್ಮನ್ನು ಎಣಿಸಿದ್ದಾರೆ.<verse eid="PSA 44:22"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 44:23"/>ಯೆಹೋವ ದೇವರೇ, ಏಳಿರಿ, ಹೌದು ಎದ್ದೇಳಿರಿ</para>
  <para style="q2" vid="PSA 44:23">ಸದಾಕಾಲಕ್ಕೆ ನಮ್ಮನ್ನು ತಳ್ಳಿಬಿಡಬೇಡಿರಿ.<verse eid="PSA 44:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 44:24"/>ಏಕೆ ನಿಮ್ಮ ಮುಖವನ್ನು ಮರೆಮಾಡಿಕೊಂಡಿದ್ದೀರಿ?</para>
  <para style="q2" vid="PSA 44:24">ನಮ್ಮ ಸಂಕಟ ಬಾಧೆಗಳನ್ನು ಮರೆತುಬಿಡುವಿರಾ?<verse eid="PSA 44:24"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 44:25"/>ನಮ್ಮ ಪ್ರಾಣವು ಮಣ್ಣು ಪಾಲಾದಂತಿದೆ.</para>
  <para style="q2" vid="PSA 44:25">ನಮ್ಮ ಶರೀರವು ನೆಲ ಪಾಲಾದಂತಿದೆ.<verse eid="PSA 44:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 44:26"/>ನಮಗೆ ಸಹಾಯಕರಾಗಿ ಏಳಿರಿ;</para>
  <para style="q2" vid="PSA 44:26">ನಿಮ್ಮ ಒಡಂಬಡಿಕೆಯ ಪ್ರೀತಿಗಾಗಿ ನಮ್ಮನ್ನು ವಿಮೋಚಿಸಿರಿ.<verse eid="PSA 44:26"/></para>
  <chapter eid="PSA 44"/>
  <chapter number="45" style="c" sid="PSA 45"/>
  <para style="cl">ಕೀರ್ತನೆ 45</para>
  <para style="d">ಸಂಗೀತ ನಿರ್ದೇಶಕನಿಗಾಗಿರುವ ಕೀರ್ತನೆ. “ಲಿಲಿಹೂಗಳು” ರಾಗವನ್ನು ಆಧರಿಸಿದೆ. ಕೋರಹೀಯನ ಪುತ್ರರ ಸಂಯೋಜನೆ. ಒಂದು <char style="tl">ಮಸ್ಕಿಲ್.</char> ಒಂದು ಮದುವೆಯ ಹಾಡು.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 45:1"/>ನನ್ನ ಹೃದಯವು ಸೊಗಸಾದ ವಿಷಯದಿಂದ ಮಿಡಿಯುತ್ತಿದೆ.</para>
  <para style="q2" vid="PSA 45:1">ಮಹಾರಾಜನನ್ನು ಕುರಿತು ನಾನು ರಚಿಸುವೆನು ಗೀತಾಂಜಲಿ.</para>
  <para style="q2" vid="PSA 45:1">ನನ್ನ ನಾಲಿಗೆಯು ನಿಪುಣ ಬರಹಗಾರನ ಲೇಖನಿಯಂತೆ ಸಿದ್ಧವಾಗಿದೆ.<verse eid="PSA 45:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 45:2"/>ನೀವು ಎಲ್ಲಾ ಮನುಷ್ಯರಿಗಿಂತ ಅತಿ ಸುಂದರರಾಗಿದ್ದೀರಿ.</para>
  <para style="q2" vid="PSA 45:2">ನಿಮ್ಮ ತುಟಿಗಳಲ್ಲಿ ಕೃಪೆಯ ಅಭಿಷೇಕವಿದೆ;</para>
  <para style="q2" vid="PSA 45:2">ಆದ್ದರಿಂದ ದೇವರು ಎಂದೆಂದಿಗೂ ನಿಮ್ಮನ್ನು ಆಶೀರ್ವದಿಸಿದ್ದಾರೆ.<verse eid="PSA 45:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 45:3"/>ಪರಾಕ್ರಮಶಾಲಿಯೇ, ನಿಮ್ಮ ಖಡ್ಗವನ್ನು ಸೊಂಟಕ್ಕೆ ಬಿಗಿದುಕೊಳ್ಳಿರಿ.</para>
  <para style="q2" vid="PSA 45:3">ನಿಮ್ಮ ಮಹಿಮೆಯನ್ನೂ ಘನತೆಯನ್ನೂ ಧರಿಸಿಕೊಳ್ಳಿರಿ.<verse eid="PSA 45:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 45:4"/>ನೀವು ಸತ್ಯತೆ ದೀನತ್ವ ಹಾಗು</para>
  <para style="q2" vid="PSA 45:4">ನೀತಿಗೋಸ್ಕರ ನಿಮ್ಮ ಘನತೆಯಿಂದ ಜಯದ ಸವಾರಿ ಮಾಡಿರಿ.</para>
  <para style="q2" vid="PSA 45:4">ನಿಮ್ಮ ಬಲಗೈ ಮಹಾಕೃತ್ಯಗಳನ್ನು ಪ್ರಕಾಶಪಡಿಸಲಿ.<verse eid="PSA 45:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 45:5"/>ನಿಮ್ಮ ಹದವಾದ ಬಾಣಗಳು ರಾಜದ್ರೋಹಿಗಳನ್ನು ಇರಿಯಲಿ.</para>
  <para style="q2" vid="PSA 45:5">ಜನಾಂಗಗಳು ನಿಮ್ಮ ಪಾದಕ್ಕೆ ಬೀಳಲಿ.<verse eid="PSA 45:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 45:6"/>ದೇವರೇ, ನಿಮ್ಮ ಸಿಂಹಾಸನವು ಯುಗಯುಗಾಂತರಗಳಲ್ಲಿಯೂ ಇರುವುದು;</para>
  <para style="q2" vid="PSA 45:6">ನ್ಯಾಯದಂಡವೇ ನಿಮ್ಮ ರಾಜದಂಡವಾಗಿದೆ.<verse eid="PSA 45:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 45:7"/>ನೀವು ನೀತಿಯನ್ನು ಪ್ರೀತಿಸುತ್ತೀರಿ, ಅನೀತಿಯನ್ನು ದ್ವೇಷಿಸುತ್ತೀರಿ.</para>
  <para style="q2" vid="PSA 45:7">ಆದ್ದರಿಂದ ದೇವರೇ, ನಿಮ್ಮ ದೇವರು, ನಿಮ್ಮ ಸಂಗಡಿಗರಿಗಿಂತ</para>
  <para style="q2" vid="PSA 45:7">ನಿಮ್ಮನ್ನು ಉನ್ನತಗೊಳಿಸಿ ಆನಂದ ತೈಲದಿಂದ ಅಭಿಷೇಕಿಸಿದ್ದಾರೆ.<verse eid="PSA 45:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 45:8"/>ನಿಮ್ಮ ವಸ್ತ್ರಗಳೆಲ್ಲಾ ರಸಗಂಧವೂ</para>
  <para style="q2" vid="PSA 45:8">ಅಗರೂ ಚಂದನ ಇವುಗಳ ಸುವಾಸನೆ ಬೀರುತ್ತದೆ.</para>
  <para style="q2" vid="PSA 45:8">ದಂತದ ಅರಮನೆಯೊಳಗಿಂದ ಉನ್ನತ ವಾದ್ಯಗಳು ನಿಮ್ಮನ್ನು ಆನಂದಗೊಳಿಸುವುದು.<verse eid="PSA 45:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 45:9"/>ರಾಜ ಪುತ್ರಿಯರು ನಿಮ್ಮ ಗೌರವ ಸ್ತ್ರೀಯರಲ್ಲಿ ಇದ್ದಾರೆ.</para>
  <para style="q2" vid="PSA 45:9">ನಿಮ್ಮ ಬಲಗಡೆ ರಾಣಿಯು ಓಫೀರ್ ಬಂಗಾರವನ್ನು ಧರಿಸಿದ್ದಾಳೆ.<verse eid="PSA 45:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 45:10"/>ಕೇಳು ಮಗಳೇ, ಇದನ್ನು ಆಲೋಚಿಸಿ, ಕಿವಿಗೊಡು.</para>
  <para style="q2" vid="PSA 45:10">ನಿಮ್ಮ ಜನರನ್ನೂ, ನಿಮ್ಮ ತಂದೆಯ ಮನೆಯನ್ನೂ ಮರೆತುಬಿಡು.<verse eid="PSA 45:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 45:11"/>ನಿನ್ನ ಸೌಂದರ್ಯವನ್ನು ಮಹಾರಾಜರು ಮೆಚ್ಚಲಿ,</para>
  <para style="q2" vid="PSA 45:11">ಅವರೇ ನಿನ್ನ ಒಡೆಯ ಅವರನ್ನು ಗೌರವಿಸು.<verse eid="PSA 45:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 45:12"/>ಟೈರಿನ ಮಗಳು ಕಾಣಿಕೆಯೊಂದಿಗೆ ಬರುವಳು;</para>
  <para style="q2" vid="PSA 45:12">ಐಶ್ವರ್ಯವಂತರು ನಿನ್ನನ್ನು ವರಿಸಲು ಹುಡುಕಿ ಬರುವರು.<verse eid="PSA 45:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 45:13"/>ಅರಸನ ಮಗಳು ತನ್ನ ಅಂತಃಪುರದಲ್ಲಿ ಪೂರ್ಣ ವೈಭವದಿಂದ ಇದ್ದಾಳೆ.</para>
  <para style="q2" vid="PSA 45:13">ಅವಳ ವಸ್ತ್ರವು ಚಿನ್ನದಿಂದ ನೇಯ್ದಿದೆ.<verse eid="PSA 45:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 45:14"/>ಕಸೂತಿ ಉಡುಪುಗಳಲ್ಲಿ ಮಹಾರಾಜರ ಬಳಿಗೆ ಆಕೆಯು ಹೊರಡುತ್ತಾಳೆ,</para>
  <para style="q2" vid="PSA 45:14">ಅವಳ ಸಂಗಡ ಸಖಿಯರಾದ</para>
  <para style="q2" vid="PSA 45:14">ಕನ್ಯೆಯರು ಸಹ ಹೊರಡುವರು.<verse eid="PSA 45:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 45:15"/>ಸಂತೋಷದಿಂದಲೂ ಉಲ್ಲಾಸದಿಂದಲೂ ಅವರು ಆಕೆಯನ್ನು ತರುತ್ತಿದ್ದಾರೆ.</para>
  <para style="q2" vid="PSA 45:15">ಹೀಗೆ ಅವರು ರಾಜಭವನದೊಳಗೆ ಪ್ರವೇಶಿಸುವರು.<verse eid="PSA 45:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 45:16"/>ನಿಮ್ಮ ಪಿತೃಗಳ ಸ್ಥಳಗಳನ್ನು ನಿಮ್ಮ ಮಕ್ಕಳು ತೆಗೆದುಕೊಳ್ಳುವರು.</para>
  <para style="q2" vid="PSA 45:16">ಮಹಾರಾಜರು ಅವರನ್ನು ಭೂಮಿಯ ದೇಶದಲ್ಲೆಲ್ಲಾ ರಾಜಪುತ್ರರಾಗಿ ಇರಿಸುವರು.<verse eid="PSA 45:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 45:17"/>ತಲತಲಾಂತರವೂ ನಿಮ್ಮ ಹೆಸರನ್ನು ನಾನು ಸ್ಮರಿಸುವಂತೆ ಮಾಡುವೆನು.</para>
  <para style="q2" vid="PSA 45:17">ಆದ್ದರಿಂದ ಜನರು ಯುಗಯುಗಾಂತರವೂ ನಿಮ್ಮನ್ನು ಹೊಗಳುವರು.<verse eid="PSA 45:17"/></para>
  <chapter eid="PSA 45"/>
  <chapter number="46" style="c" sid="PSA 46"/>
  <para style="cl">ಕೀರ್ತನೆ 46</para>
  <para style="d">ಸಂಗೀತ ನಿರ್ದೇಶಕನಿಗಾಗಿರುವ ಕೀರ್ತನೆ. ಕೋರಹೀಯನ ಪುತ್ರರ ಸಂಯೋಜನೆ. <char style="tl">ಅಲಾಮೊತ್</char> ರಾಗವನ್ನು ಆಧಾರಿಸಿದ ಒಂದು ಗೀತೆ.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 46:1"/>ದೇವರು ನಮ್ಮ ಆಶ್ರಯವೂ ಬಲವೂ ಆಗಿದ್ದಾರೆ;</para>
  <para style="q2" vid="PSA 46:1">ಇಕ್ಕಟ್ಟಿನಲ್ಲಿ ವಿಶೇಷ ಸಹಾಯಕರಾಗಿದ್ದಾರೆ.<verse eid="PSA 46:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 46:2"/>ಆದ್ದರಿಂದ ಭೂಮಿಯು ಕಂಪಿಸಿದರೂ</para>
  <para style="q2" vid="PSA 46:2">ಬೆಟ್ಟಗಳು ಸಮುದ್ರದಲ್ಲಿ ಮುಳುಗಿದರೂ,<verse eid="PSA 46:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 46:3"/>ಅದರ ಸಮುದ್ರವು ಘೋಷಿಸಿ ನೊರೆಕಾರಿದರೂ,</para>
  <para style="q2" vid="PSA 46:3">ಉಬ್ಬರದಿಂದ ಬೆಟ್ಟಗಳು ಅಲ್ಲಾಡಿದರೂ ನಾವು ಭಯಪಡೆವು.<verse eid="PSA 46:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 46:4"/>ಒಂದು ನದಿ ಇದೆ; ಅದರ ಕಾಲುವೆಗಳು ದೇವರು ವಾಸಿಸುವ</para>
  <para style="q2" vid="PSA 46:4">ಮಹೋನ್ನತ ಪರಿಶುದ್ಧ ಸ್ಥಳವನ್ನೂ ಸಂತೋಷಪಡಿಸುತ್ತವೆ.<verse eid="PSA 46:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 46:5"/>ದೇವರು ಅದರ ಮಧ್ಯದಲ್ಲಿ ಇದ್ದಾರೆ, ಅದು ಕದಲದು;</para>
  <para style="q2" vid="PSA 46:5">ದೇವರು ಉದಯಕಾಲದಲ್ಲಿ ಅದಕ್ಕೆ ಸಹಾಯ ಮಾಡುವರು.<verse eid="PSA 46:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 46:6"/>ರಾಷ್ಟ್ರಗಳು ಕೋಲಾಹಲದಲ್ಲಿವೆ ರಾಜ್ಯಗಳು ಬೀಳುತ್ತವೆ.</para>
  <para style="q2" vid="PSA 46:6">ದೇವರು ತಮ್ಮ ಧ್ವನಿಯನ್ನೆತ್ತಲು ಭೂಮಿಯು ಕರಗುತ್ತದೆ.<verse eid="PSA 46:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 46:7"/>ಸೇನಾಧೀಶ್ವರ ಯೆಹೋವ ದೇವರು ನಮ್ಮ ಸಂಗಡ ಇದ್ದಾರೆ.</para>
  <para style="q2" vid="PSA 46:7">ಯಾಕೋಬನ ದೇವರು ನಮಗೆ ಭದ್ರಕೋಟೆಯಾಗಿದ್ದಾರೆ.<verse eid="PSA 46:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 46:8"/>ಬನ್ನಿರಿ, ಯೆಹೋವ ದೇವರ ಕಾರ್ಯಗಳನ್ನು ನೋಡಿರಿ.</para>
  <para style="q2" vid="PSA 46:8">ಅವರು ಭೂಮಿಯಲ್ಲಿ ಎಂಥಾ ಅತಿಶಯಗಳನ್ನು ಉಂಟುಮಾಡಿದ್ದಾರೆ.<verse eid="PSA 46:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 46:9"/>ದೇವರು ಯುದ್ಧಗಳನ್ನು ಭೂಮಿಯ</para>
  <para style="q2" vid="PSA 46:9">ಅಂತ್ಯದವರೆಗೆ ನಿಲ್ಲಿಸುತ್ತಾರೆ.</para>
  <para style="q1" vid="PSA 46:9">ಬಿಲ್ಲನ್ನೂ ಭಲ್ಲೆಯನ್ನೂ ಮುರಿದು ಹಾಕಿದ್ದಾರೆ.</para>
  <para style="q2" vid="PSA 46:9">ರಥಗಳನ್ನು ಬೆಂಕಿಯಿಂದ ಸುಡುತ್ತಾರೆ.<verse eid="PSA 46:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 46:10"/>“ಶಾಂತವಾಗಿರಿ, ನಾನೇ ದೇವರಾಗಿದ್ದೇನೆಂದು ತಿಳಿದುಕೊಳ್ಳಿರಿ;</para>
  <para style="q2" vid="PSA 46:10">ಜನಾಂಗಗಳಲ್ಲಿ ಉನ್ನತನಾಗಿರುವೆನು;</para>
  <para style="q2" vid="PSA 46:10">ಭೂಮಿಯಲ್ಲಿ ಉನ್ನತನಾಗಿರುವೆನು,” ಎಂದು ಯೆಹೋವ ದೇವರು ಹೇಳುತ್ತಾರೆ.<verse eid="PSA 46:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 46:11"/>ಸೇನಾಧೀಶ್ವರ ಯೆಹೋವ ದೇವರು ನಮ್ಮ ಸಂಗಡ ಇದ್ದಾರೆ;</para>
  <para style="q2" vid="PSA 46:11">ಯಾಕೋಬನ ದೇವರು ನಮಗೆ ಭದ್ರಕೋಟೆಯಾಗಿದ್ದಾರೆ.<verse eid="PSA 46:11"/></para>
  <chapter eid="PSA 46"/>
  <chapter number="47" style="c" sid="PSA 47"/>
  <para style="cl">ಕೀರ್ತನೆ 47</para>
  <para style="d">ಸಂಗೀತ ನಿರ್ದೇಶಕನಿಗಾಗಿರುವ ಕೀರ್ತನೆ. ಕೋರಹೀಯರ ಗೀತೆ.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 47:1"/>ಎಲ್ಲಾ ಜನರೇ, ಕೈ ತಟ್ಟಿರಿ;</para>
  <para style="q2" vid="PSA 47:1">ಜಯಾರ್ಭಟದಿಂದ ದೇವರಿಗೆ ಧ್ವನಿಗೈಯಿರಿ.<verse eid="PSA 47:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 47:2"/>ಏಕೆಂದರೆ ಮಹೋನ್ನತರಾದ ಯೆಹೋವ ದೇವರು ಭಯಭಕ್ತಿಗೆ ಪಾತ್ರರೂ</para>
  <para style="q2" vid="PSA 47:2">ಭೂಮಿಯ ಮೇಲೆಲ್ಲಾ ಮಹಾರಾಜರೂ ಆಗಿದ್ದಾರೆ.<verse eid="PSA 47:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 47:3"/>ಜನರನ್ನು ನಮ್ಮ ಕೆಳಗೆ ತಂದಿದ್ದಾರೆ.</para>
  <para style="q2" vid="PSA 47:3">ಜನಾಂಗಗಳನ್ನು ನಮಗೆ ಅಧೀನಮಾಡಿದ್ದಾರೆ.<verse eid="PSA 47:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 47:4"/>ಅವರು ಪ್ರೀತಿಸುವ ಯಾಕೋಬಿನ ಘನತೆಯಾಗಿರುವ</para>
  <para style="q2" vid="PSA 47:4">ನಮ್ಮ ಬಾಧ್ಯತೆಯನ್ನು ನಮಗಾಗಿ ಆಯ್ದುಕೊಂಡಿದ್ದಾರೆ.<verse eid="PSA 47:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 47:5"/>ದೇವರು ಜಯಘೋಷದಿಂದ ಉನ್ನತರಾಗಿದ್ದಾರೆ.</para>
  <para style="q2" vid="PSA 47:5">ಯೆಹೋವ ದೇವರು ತುತೂರಿಯ ಧ್ವನಿಯೊಡನೆ ಸಾಗಿದ್ದಾರೆ.<verse eid="PSA 47:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 47:6"/>ದೇವರಿಗೆ ಸ್ತುತಿಯನ್ನು ಹಾಡಿರಿ, ಸ್ತುತಿಯನ್ನು ಹಾಡಿರಿ;</para>
  <para style="q2" vid="PSA 47:6">ನಮ್ಮ ರಾಜರಿಗೆ ಸ್ತುತಿಯನ್ನು ಹಾಡಿರಿ, ಸ್ತುತಿಯನ್ನು ಹಾಡಿರಿ.<verse eid="PSA 47:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 47:7"/>ಏಕೆಂದರೆ, ದೇವರು ಭೂಮಿಗೆಲ್ಲಾ ಮಹಾರಾಜರು.</para>
  <para style="q2" vid="PSA 47:7">ದೇವರನ್ನು ಸ್ತೋತ್ರದ ಕೀರ್ತನೆಯಿಂದ ಕೀರ್ತಿಸಿರಿ.<verse eid="PSA 47:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 47:8"/>ದೇವರು ಜನಾಂಗಗಳನ್ನು ಆಳುತ್ತಾರೆ.</para>
  <para style="q2" vid="PSA 47:8">ದೇವರು ತಮ್ಮ ಪರಿಶುದ್ಧ ಸಿಂಹಾಸನದಲ್ಲಿ ಕೂತಿದ್ದಾರೆ.<verse eid="PSA 47:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 47:9"/>ರಾಷ್ಟ್ರಗಳ ಅಧಿಪತಿಗಳು</para>
  <para style="q2" vid="PSA 47:9">ಅಬ್ರಹಾಮನ ದೇವರ ಜನರಾಗಿ ಕೂಡಿಬಂದಿದ್ದಾರೆ.</para>
  <para style="q1" vid="PSA 47:9">ಏಕೆಂದರೆ, ಭೂಮಿಯ ರಾಜರೆಲ್ಲರೂ ದೇವರಿಗೆ ಸೇರಿದವರು.</para>
  <para style="q2" vid="PSA 47:9">ದೇವರು ಬಹಳವಾಗಿ ಘನ ಹೊಂದಿದ್ದಾರೆ.<verse eid="PSA 47:9"/></para>
  <chapter eid="PSA 47"/>
  <chapter number="48" style="c" sid="PSA 48"/>
  <para style="cl">ಕೀರ್ತನೆ 48</para>
  <para style="d">ಒಂದು ಗೀತೆ. ಕೋರಹೀಯನ ಪುತ್ರರು ಸಂಯೋಜಿಸಿರುವ ಒಂದು ಕೀರ್ತನೆ.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 48:1"/>ಯೆಹೋವ ದೇವರು ಮಹೋನ್ನತರೂ ನಮ್ಮ ದೇವರು ತಮ್ಮ ಪರಿಶುದ್ಧ ಪರ್ವತ ಪಟ್ಟಣದಲ್ಲಿ</para>
  <para style="q2" vid="PSA 48:1">ಬಹಳವಾಗಿ ಸ್ತುತಿಗೆ ಪಾತ್ರರಾಗಿದ್ದಾರೆ.<verse eid="PSA 48:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 48:2"/>ಉತ್ತರ ದಿಕ್ಕಿನಲ್ಲಿರುವ</para>
  <para style="q2" vid="PSA 48:2">ಮಹಾರಾಜರ ಪಟ್ಟಣವಾದ</para>
  <para style="q1" vid="PSA 48:2">ಚೀಯೋನ್ ಪರ್ವತವು ಸುಂದರವಾಗಿ ಚಾಪೋನಿನ ಶಿಖರದಂತೆ</para>
  <para style="q2" vid="PSA 48:2">ಇಡೀ ಭೂಮಿಗೆ ಸಂತೋಷಕರವಾದದ್ದಾಗಿದೆ.<verse eid="PSA 48:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 48:3"/>ದೇವರು ಅದರ ಅರಮನೆಗಳಲ್ಲಿ ವಾಸಿಸುತ್ತಾರೆ.</para>
  <para style="q2" vid="PSA 48:3">ದೇವರು ತಾವೇ ಅದರ ಭದ್ರಕೋಟೆಯಾಗಿದ್ದಾರೆ.<verse eid="PSA 48:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 48:4"/>ಏಕೆಂದರೆ, ಇಗೋ, ಅರಸರು ಕೂಡಿಬಂದರು.</para>
  <para style="q2" vid="PSA 48:4">ಅವರು ಒಟ್ಟಾಗಿ ದಾಳಿಮಾಡಲು ಬಂದರು.<verse eid="PSA 48:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 48:5"/>ಅವರು ಪಟ್ಟಣವನ್ನು ಕಂಡು, ಬೆರಗಾದರು.</para>
  <para style="q2" vid="PSA 48:5">ಅವರು ಭಯಪಟ್ಟು ಓಡಿಹೋದರು.<verse eid="PSA 48:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 48:6"/>ಅಲ್ಲಿ ನಡುಕವವೂ ಹೆರುವವಳ ಹಾಗೆ</para>
  <para style="q2" vid="PSA 48:6">ನೋವೂ ಅವರನ್ನು ಹಿಡಿಯಿತು.<verse eid="PSA 48:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 48:7"/>ಪೂರ್ವದಿಕ್ಕಿನ ಗಾಳಿಯಿಂದ ತಾರ್ಷೀಷ್</para>
  <para style="q2" vid="PSA 48:7">ಹಡಗುಗಳನ್ನು ನೀವು ಒಡೆಯುತ್ತೀರಲ್ಲಾ.<verse eid="PSA 48:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 48:8"/>ನಾವು ಹೇಗೆ ಕೇಳಿದೆವೋ</para>
  <para style="q2" vid="PSA 48:8">ಹಾಗೆಯೇ ಕಣ್ಣಾರೆ ಕಂಡೆವು,</para>
  <para style="q1" vid="PSA 48:8">ಸೇನಾಧೀಶ್ವರ ಯೆಹೋವ ದೇವರ ಪಟ್ಟಣವಾಗಿರುವ,</para>
  <para style="q2" vid="PSA 48:8">ನಮ್ಮ ದೇವರ ಪಟ್ಟಣದಲ್ಲಿ ಇದನ್ನು ಕಂಡೆವು:</para>
  <para style="q1" vid="PSA 48:8">ದೇವರು ಪಟ್ಟಣವನ್ನು</para>
  <para style="q2" vid="PSA 48:8">ಎಂದೆಂದಿಗೂ ಸ್ಥಿರಪಡಿಸುವರು.<verse eid="PSA 48:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 48:9"/>ದೇವರೇ, ನಿಮ್ಮ ಒಡಂಬಡಿಕೆಯ ಪ್ರೀತಿಯನ್ನು</para>
  <para style="q2" vid="PSA 48:9">ನಿಮ್ಮ ಮಂದಿರದಲ್ಲಿ ನಾವು ಸ್ಮರಿಸುತ್ತೇವೆ.<verse eid="PSA 48:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 48:10"/>ದೇವರೇ, ನಿಮ್ಮ ಹೆಸರಿಗೆ ತಕ್ಕಂತೆಯೇ</para>
  <para style="q2" vid="PSA 48:10">ನಿಮ್ಮ ಸ್ತೋತ್ರವು ಭೂಮಿಯ ಕಟ್ಟಕಡೆಯವರೆಗೂ ಇದೆ;</para>
  <para style="q2" vid="PSA 48:10">ನಿಮ್ಮ ಬಲಗೈ ನೀತಿಯಿಂದ ತುಂಬಿದೆ.<verse eid="PSA 48:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 48:11"/>ನಿಮ್ಮ ನ್ಯಾಯ ನಿರ್ಣಯಗಳ ನಿಮಿತ್ತ</para>
  <para style="q2" vid="PSA 48:11">ಚೀಯೋನ್ ಪರ್ವತವು ಸಂತೋಷಪಡಲಿ;</para>
  <para style="q2" vid="PSA 48:11">ಯೆಹೂದ ಪುತ್ರಿಯರು ಉಲ್ಲಾಸಪಡಲಿ.<verse eid="PSA 48:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 48:12"/>ಚೀಯೋನನ್ನು ಸುತ್ತಿ ಅದರ ಸುತ್ತಲೂ ತಿರುಗಾಡಿ</para>
  <para style="q2" vid="PSA 48:12">ಅದರ ಗೋಪುರಗಳನ್ನು ಎಣಿಸಿರಿ.<verse eid="PSA 48:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 48:13"/>ಮುಂದಿನ ತಲಾಂತರಕ್ಕೆ ತಿಳಿಸುವುದಕ್ಕೋಸ್ಕರ</para>
  <para style="q2" vid="PSA 48:13">ಅದರ ಗೋಪುರಗಳನ್ನು</para>
  <para style="q1" vid="PSA 48:13">ಕಣ್ಣಿಟ್ಟು ನೋಡಿರಿ,</para>
  <para style="q2" vid="PSA 48:13">ಅದರ ಅರಮನೆಗಳನ್ನು ಲಕ್ಷಿಸಿರಿ.<verse eid="PSA 48:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 48:14"/>ಏಕೆಂದರೆ, ಈ ದೇವರು ಯುಗಯುಗಾಂತರಗಳಿಗೂ ನಮ್ಮ ದೇವರಾಗಿದ್ದಾರೆ;</para>
  <para style="q2" vid="PSA 48:14">ಅವರು ಅಂತ್ಯದವರೆಗೂ ನಮ್ಮ ಮಾರ್ಗದರ್ಶಿಯಾಗಿರುವರು.<verse eid="PSA 48:14"/></para>
  <chapter eid="PSA 48"/>
  <chapter number="49" style="c" sid="PSA 49"/>
  <para style="cl">ಕೀರ್ತನೆ 49</para>
  <para style="d">ಸಂಗೀತ ನಿರ್ದೇಶಕನಿಗಾಗಿರುವ ಕೀರ್ತನೆ. ಕೋರಹೀಯನ ಪುತ್ರರು ಸಂಯೋಜಿಸಿರುವ ಒಂದು ಕೀರ್ತನೆ.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 49:1"/>ಎಲ್ಲಾ ಜನರೇ, ಇದನ್ನು ಕೇಳಿರಿ;</para>
  <para style="q2" vid="PSA 49:1">ಭೂಲೋಕದ ನಿವಾಸಿಗಳೇ,<verse eid="PSA 49:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 49:2"/>ಸಾಮಾನ್ಯರೇ, ಉನ್ನತರೇ, ಐಶ್ವರ್ಯವಂತರೇ,</para>
  <para style="q2" vid="PSA 49:2">ಬಡವರೇ ಎಲ್ಲರೂ ಕಿವಿಗೊಡಿರಿ.<verse eid="PSA 49:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 49:3"/>ನನ್ನ ಬಾಯಿ ಜ್ಞಾನವನ್ನು ನುಡಿಯುವುದು,</para>
  <para style="q2" vid="PSA 49:3">ನನ್ನ ಹೃದಯದ ಧ್ಯಾನವು ವಿವೇಕವಾಗಿರುವುದು.<verse eid="PSA 49:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 49:4"/>ಸಾಮ್ಯಕ್ಕೆ ನನ್ನ ಕಿವಿಗೊಟ್ಟು</para>
  <para style="q2" vid="PSA 49:4">ಒಗಟನ್ನು ಕಿನ್ನರಿಯಿಂದ ಬಿಚ್ಚುವೆನು.<verse eid="PSA 49:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 49:5"/>ಕೇಡಿನ ದಿವಸಗಳಲ್ಲಿ ನನಗೆ ಒಳಸಂಚು ಮಾಡುವವರ</para>
  <para style="q2" vid="PSA 49:5">ಅಕ್ರಮವು ನನ್ನನ್ನು ಸುತ್ತಿಕೊಳ್ಳುವಾಗ ನಾನು ಏಕೆ ಭಯಪಡಬೇಕು?<verse eid="PSA 49:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 49:6"/>ಅವರು ತಮ್ಮ ಸಂಪತ್ತಿನಲ್ಲಿ ಭರವಸೆಯಿಟ್ಟು,</para>
  <para style="q2" vid="PSA 49:6">ತಮ್ಮ ಅಧಿಕ ಐಶ್ವರ್ಯಗಳಲ್ಲಿ ಜಂಭಪಡುವರು.<verse eid="PSA 49:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 49:7"/>ಯಾರೂ ಇನ್ನೊಬ್ಬರ ಜೀವವನ್ನು ವಿಮೋಚಿಸಲಾರರು;</para>
  <para style="q2" vid="PSA 49:7">ಅಥವಾ ಇತರರಿಗಾಗಿ ಯಾರೂ ದೇವರಿಗೆ ಈಡು ಕೊಡಲಾರರು.<verse eid="PSA 49:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 49:8"/>ಆತ್ಮದ ವಿಮೋಚನೆಯು ಬಹು ಬೆಲೆಯುಳ್ಳದ್ದು,</para>
  <para style="q2" vid="PSA 49:8">ಅದಕ್ಕೆ ಸಾಕಷ್ಟು ಬೆಲೆಯನ್ನು ಕಟ್ಟಲು ಯಾರಿಗೂ ಸಾಧ್ಯವಿಲ್ಲ.<verse eid="PSA 49:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 49:9"/>ಮನುಷ್ಯರು ಮರಣ ನಾಶವನ್ನು ಕಾಣದೆ,</para>
  <para style="q2" vid="PSA 49:9">ಶಾಶ್ವತವಾಗಿ ಬದುಕುವಂತೆ ಮಾಡಲು ಯಾರಿಗೂ ಸಾಧ್ಯವಿಲ್ಲ.<verse eid="PSA 49:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 49:10"/>ಏಕೆಂದರೆ, ಜ್ಞಾನಿಗಳು ಸಾಯುವುದನ್ನು ಕಾಣುತ್ತೇವೆ.</para>
  <para style="q2" vid="PSA 49:10">ಹಾಗೆಯೇ ಮೂರ್ಖರೂ ಜ್ಞಾನಹೀನರೂ ಸಹ ನಾಶವಾಗುತ್ತಾರೆ.</para>
  <para style="q2" vid="PSA 49:10">ಅವರ ಆಸ್ತಿಯನ್ನು ಇತರರು ಪಡೆಯುತ್ತಾರೆ.<verse eid="PSA 49:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 49:11"/>ಜಮೀನುಗಳಿಗೆ ತಮ್ಮ ಹೆಸರುಗಳನ್ನು ಇಟ್ಟುಕೊಳ್ಳುತ್ತಾರೆ.</para>
  <para style="q2" vid="PSA 49:11">ಆದರೂ ಸಮಾಧಿಯೇ ಅವರಿಗೆ ಶಾಶ್ವತಮಂದಿರವು.</para>
  <para style="q2" vid="PSA 49:11">ಅದೇ ಅವರ ತಲತಲಾಂತರಕ್ಕೂ ನಿವಾಸಸ್ಥಾನ.<verse eid="PSA 49:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 49:12"/>ಮನುಷ್ಯನು ಎಷ್ಟು ಆಸ್ತಿ ಗೌರವ ಸಂಪಾದಿಸಿದ್ದರೂ,</para>
  <para style="q2" vid="PSA 49:12">ಮಡಿದು ಹೋಗುವ ಪಶುಗಳಿಗೆ ಸಮಾನವಾಗಿದ್ದಾನೆ.<verse eid="PSA 49:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 49:13"/>ತಮ್ಮಲ್ಲಿಯೇ ಭರವಸೆ ಇಟ್ಟುಕೊಳ್ಳುವವರಿಗೂ ಇದೇ ಗತಿ.</para>
  <para style="q2" vid="PSA 49:13">ಅಂಥವರ ಮಾತುಗಳನ್ನು ಒಪ್ಪಿ ಅನುಸರಿಸುವವರ ಗತಿಯೂ ಇದೆ.<verse eid="PSA 49:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 49:14"/>ಅವರು ಕುರಿಗಳಂತೆ ಸಾಯಲು ನೇಮಕವಾಗಿದ್ದಾರೆ.</para>
  <para style="q2" vid="PSA 49:14">ಮರಣವೇ ಅವರ ಕುರುಬ;</para>
  <para style="q1" vid="PSA 49:14">ಅವರ ವೈಭವ ನಿವಾಸದಿಂದ ದೂರ ಸಮಾಧಿಯಲ್ಲಿರುವುದು</para>
  <para style="q2" vid="PSA 49:14">ಅವರ ರೂಪ ಕ್ಷಯವಾಗುವುದು.</para>
  <para style="q2" vid="PSA 49:14">ಆದರೆ ಯಥಾರ್ಥರು ಬೆಳಿಗ್ಗೆ ಅವರನ್ನು ಬಿಟ್ಟು ಸಾಗುತ್ತಿರುವರು.<verse eid="PSA 49:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 49:15"/>ಆದರೆ ದೇವರು ನನ್ನ ಪ್ರಾಣವನ್ನು ಮರಣದಿಂದ ವಿಮೋಚನೆ ಮಾಡುವರು.</para>
  <para style="q2" vid="PSA 49:15">ದೇವರು ನನ್ನನ್ನು ತಮಗಾಗಿ ಅಂಗೀಕರಿಸುವರು.<verse eid="PSA 49:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 49:16"/>ಒಬ್ಬನು ಐಶ್ವರ್ಯವಂತನಾದರೆ</para>
  <para style="q2" vid="PSA 49:16">ಮತ್ತು ಅವನ ಮನೆಯ ಘನತೆ ದೊಡ್ಡದಾದರೆ ಕಳವಳ ಪಡಬೇಡ.<verse eid="PSA 49:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 49:17"/>ಅವನು ಸಾಯುವಾಗ ಏನೂ ತೆಗೆದುಕೊಂಡು ಹೋಗಲಾರನಷ್ಟೆ;</para>
  <para style="q2" vid="PSA 49:17">ಅವನ ವೈಭವವು ಅವನೊಡನೆ ಹೋಗುವುದಿಲ್ಲ.<verse eid="PSA 49:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 49:18"/>ಸಿರಿ ಬಂದಾಗ ಜನರ ಹೊಗಳಿಕೆ ತಪ್ಪದು ಎಂಬಂತೆ ಅವನು ಜೀವಮಾನದಲ್ಲಿ ಆತ್ಮಸ್ತುತಿಯಿಂದಲೂ,</para>
  <para style="q2" vid="PSA 49:18">ಜನಸ್ತುತಿಯಿಂದಲೂ ಕೂಡಿದವನಾದರೂ<verse eid="PSA 49:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 49:19"/>ಅವನು ತನ್ನ ಪೂರ್ವಿಕರ ಬಳಿಗೆ ಹೋಗುವನು;</para>
  <para style="q2" vid="PSA 49:19">ಅವರು ಸದಾಕಾಲಕ್ಕೂ ಜೀವ ಬೆಳಕನ್ನು ಕಾಣುವುದಿಲ್ಲ.<verse eid="PSA 49:19"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 49:20"/>ಮನುಷ್ಯನು ಎಷ್ಟು ಘನತೆಯಲ್ಲಿದ್ದು ವಿವೇಕವಿಲ್ಲದವರಾದರೆ</para>
  <para style="q2" vid="PSA 49:20">ಮಡಿದು ಹೋಗುವ ಪಶುಗಳಿಗೆ ಸಮಾನವಾಗಿದ್ದಾನೆ.<verse eid="PSA 49:20"/></para>
  <chapter eid="PSA 49"/>
  <chapter number="50" style="c" sid="PSA 50"/>
  <para style="cl">ಕೀರ್ತನೆ 50</para>
  <para style="d">ಆಸಾಫನ ಕೀರ್ತನೆ.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 50:1"/>ದೇವಾಧಿ ದೇವರಾದ ಯೆಹೋವ ದೇವರು ತಾವೇ ಮಾತನಾಡುತ್ತಿದ್ದಾರೆ,</para>
  <para style="q2" vid="PSA 50:1">ಸೂರ್ಯೋದಯದಿಂದ ಅಸ್ತಮಾನದವರೆಗೂ</para>
  <para style="q2" vid="PSA 50:1">ಇರುವ ಭೂಲೋಕದವರು ಕರೆಯುತ್ತಿದ್ದಾರೆ.<verse eid="PSA 50:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 50:2"/>ಪರಿಪೂರ್ಣ ಸೌಂದರ್ಯದ ಚೀಯೋನಿನಿಂದ</para>
  <para style="q2" vid="PSA 50:2">ದೇವರು ಪ್ರಕಾಶಿಸುತ್ತಿದ್ದಾರೆ.<verse eid="PSA 50:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 50:3"/>ನಮ್ಮ ದೇವರು ಬರುತ್ತಾರೆ,</para>
  <para style="q2" vid="PSA 50:3">ಎಷ್ಟು ಮಾತ್ರವೂ ಮೌನವಾಗಿರುವುದಿಲ್ಲ.</para>
  <para style="q1" vid="PSA 50:3">ಬೆಂಕಿಯು ಅವರ ಮುಂದೆ ಪ್ರಜ್ವಲಿಸುವುದು;</para>
  <para style="q2" vid="PSA 50:3">ಅವರ ಸುತ್ತಲೂ ದೊಡ್ಡ ಬಿರುಗಾಳಿಯು ಬೀಸುವುದು.<verse eid="PSA 50:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 50:4"/>ತಮ್ಮ ಜನರಿಗೆ ನ್ಯಾಯತೀರಿಸುವುದಕ್ಕೆ ಭೂಮಿ ಆಕಾಶಗಳನ್ನೂ</para>
  <para style="q2" vid="PSA 50:4">ಹೀಗೆಂದು ಕರೆಯುತ್ತಿದ್ದಾರೆ:<verse eid="PSA 50:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 50:5"/>“ಯಜ್ಞದಿಂದ ನನ್ನ ಸಂಗಡ ಒಡಂಬಡಿಕೆ ಮಾಡಿಕೊಂಡ</para>
  <para style="q2" vid="PSA 50:5">ನನ್ನ ಭಕ್ತರನ್ನು ನನ್ನ ಬಳಿಗೆ ಒಟ್ಟುಗೂಡಿಸಿರಿ.”<verse eid="PSA 50:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 50:6"/>ಮತ್ತು ದೇವರು ನ್ಯಾಯಾಧಿಪತಿಯಾಗಿದ್ದಾರೆ.</para>
  <para style="q2" vid="PSA 50:6">ಆಕಾಶಗಳು ದೇವರ ನೀತಿಯನ್ನು ಪ್ರಕಟಿಸುತ್ತವೆ.<verse eid="PSA 50:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 50:7"/>“ನನ್ನ ಜನರೇ, ಕೇಳಿರಿ, ನಾನು ಮಾತನಾಡುತ್ತಿದ್ದೇನೆ,</para>
  <para style="q2" vid="PSA 50:7">ಇಸ್ರಾಯೇಲೇ, ನಿಮಗೆ ವಿರೋಧವಾಗಿ ಹೀಗೆಂದು ನಾನು ಸಾಕ್ಷಿ ಕೊಡುವೆನು:</para>
  <para style="q2" vid="PSA 50:7">ನಾನು ದೇವರು, ಹೌದು ನಿಮ್ಮ ದೇವರು ನಾನೇ.<verse eid="PSA 50:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 50:8"/>ನಿಮ್ಮ ಯಜ್ಞಗಳ ವಿರೋಧವಾಗಿ ನಾನು ತಪ್ಪು ಹೊರಿಸುತ್ತಾಯಿಲ್ಲ,</para>
  <para style="q2" vid="PSA 50:8">ಅಥವಾ ನನ್ನ ಮುಂದೆ ಯಾವಾಗಲೂ ಇರುವ ದಹನಬಲಿಗಳ</para>
  <para style="q2" vid="PSA 50:8">ವಿರೋಧವಾಗಿಯೂ ನಾನು ತಪ್ಪು ಹೊರಿಸುತ್ತಾಯಿಲ್ಲ.<verse eid="PSA 50:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 50:9"/>ನಿಮ್ಮ ಮನೆಯಿಂದ ಹೋರಿಯಾಗಲಿ</para>
  <para style="q2" vid="PSA 50:9">ಕೊಟ್ಟಿಗೆಯಿಂದ ಹೋತಗಳಾಗಲಿ ನನಗೆ ಅವಶ್ಯವಿಲ್ಲ.<verse eid="PSA 50:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 50:10"/>ಏಕೆಂದರೆ ಅಡವಿಯ ಮೃಗಗಳೆಲ್ಲವೂ ನನ್ನವೇ.</para>
  <para style="q2" vid="PSA 50:10">ಸಾವಿರ ಬೆಟ್ಟಗಳಲ್ಲಿರುವ ಪಶುಗಳೂ ಸಹ ನನ್ನವೇ.<verse eid="PSA 50:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 50:11"/>ಬೆಟ್ಟಗಳ ಪಕ್ಷಿಗಳನ್ನೆಲ್ಲಾ ನಾನು ಬಲ್ಲೆನು;</para>
  <para style="q2" vid="PSA 50:11">ಬಯಲಿನ ಮೃಗಗಳು ನನ್ನವುಗಳಾಗಿವೆ.<verse eid="PSA 50:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 50:12"/>ನನಗೆ ಹಸಿವಾದರೆ ನಿಮಗೆ ಹೇಳಬೇಕಾಗಿಲ್ಲ,</para>
  <para style="q2" vid="PSA 50:12">ಏಕೆಂದರೆ ಭೂಲೋಕವೂ ಅದರಲ್ಲಿರುವುದೆಲ್ಲವೂ ನನ್ನವೇ.<verse eid="PSA 50:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 50:13"/>ಹೋರಿಗಳ ಮಾಂಸವನ್ನು ನಾನು ಭುಜಿಸುವುದಿಲ್ಲ.</para>
  <para style="q2" vid="PSA 50:13">ಹೋತಗಳ ರಕ್ತವನ್ನು ನಾನು ಕುಡಿಯುವುದಿಲ್ಲ.<verse eid="PSA 50:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 50:14"/>“ದೇವರಾಗಿರುವ ನನಗೆ ಸ್ತೋತ್ರವನ್ನು ಬಲಿಯಾಗಿ ಅರ್ಪಿಸಿರಿ.</para>
  <para style="q2" vid="PSA 50:14">ಮಹೋನ್ನತನಾಗಿರುವ ನನಗೆ ಹರಕೆಗಳನ್ನು ಸಲ್ಲಿಸಿರಿ.<verse eid="PSA 50:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 50:15"/>ಇಕ್ಕಟ್ಟಿನ ದಿವಸದಲ್ಲಿ ನನ್ನನ್ನು ಕರೆಯಿರಿ,</para>
  <para style="q2" vid="PSA 50:15">ನಾನು ನಿಮ್ಮನ್ನು ಬಿಡಿಸುವೆನು, ನೀವು ನನ್ನನ್ನು ಘನಪಡಿಸುವಿರಿ.”<verse eid="PSA 50:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="PSA 50:16"/>ಆದರೆ ದುಷ್ಟನಿಗೆ ದೇವರು ಹೇಳುವುದೇನೆಂದರೆ:</para>
  <para style="q1" vid="PSA 50:16">“ನನ್ನ ನಿಯಮಗಳನ್ನು ಪಠಿಸುವುದಕ್ಕೆ ಹಕ್ಕು ನಿಮಗೆ ಏನಿದೆ?</para>
  <para style="q2" vid="PSA 50:16">ಇಲ್ಲವೆ ನನ್ನ ಒಡಂಬಡಿಕೆಯನ್ನು ನಿಮ್ಮ ಬಾಯಲ್ಲಿ ಉಚ್ಛರಿಸುವುದೇಕೆ?<verse eid="PSA 50:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 50:17"/>ನೀನು ನನ್ನ ಶಿಕ್ಷಣವನ್ನು ದ್ವೇಷಿಸಿ, ನನ್ನ ವಾಕ್ಯಗಳನ್ನು</para>
  <para style="q2" vid="PSA 50:17">ನಿಮ್ಮ ಹಿಂದೆ ಬಿಸಾಡಿಬಿಟ್ಟೀರಲ್ಲಾ.<verse eid="PSA 50:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 50:18"/>ಕಳ್ಳನನ್ನು ಕಂಡರೆ ಅವನೊಂದಿಗೆ ಸೇರಿಕೊಳ್ಳುತ್ತೀರಿ.</para>
  <para style="q2" vid="PSA 50:18">ವ್ಯಭಿಚಾರಿಗಳ ಸಂಗಡ ನಿಮಗೆ ಪಾಲು ಇದೆ.<verse eid="PSA 50:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 50:19"/>ನೀವು ನಿಮ್ಮ ಬಾಯನ್ನು ಕೇಡಿಗೆ ಉಪಯೋಗಿಸುತ್ತೀರಿ.</para>
  <para style="q2" vid="PSA 50:19">ನಿಮ್ಮ ನಾಲಿಗೆಯು ಮೋಸವನ್ನು ಜೋಡಿಸುತ್ತದೆ.<verse eid="PSA 50:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 50:20"/>ನೀವು ಕುಳಿತುಕೊಂಡು ನಿಮ್ಮ ಸಹೋದರರಿಗೆ ವಿರೋಧವಾಗಿ ಸುಳ್ಳಾಡುತ್ತೀರಿ.</para>
  <para style="q2" vid="PSA 50:20">ನಿಮ್ಮ ಒಡಹುಟ್ಟಿದವರ ಮೇಲೆ ಚಾಡಿ ಹೇಳುತ್ತೀರಿ.<verse eid="PSA 50:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 50:21"/>ಇವುಗಳನ್ನೆಲ್ಲಾ ನೀವು ಮಾಡಿದ್ದೀರಿ,</para>
  <para style="q2" vid="PSA 50:21">ಆದರೂ ನಾನು ಮೌನವಾಗಿದ್ದೆನು.</para>
  <para style="q1" vid="PSA 50:21">ಆದ್ದರಿಂದ ನಾನೂ ಸಹ ನಿಮ್ಮ ಹಾಗೆ ಒಬ್ಬನೆಂದು ನೀವು ನೆನಸಿಕೊಂಡಿದ್ದೀರಿ.</para>
  <para style="q2" vid="PSA 50:21">ಆದರೆ ಈಗ ನಾನು ನಿಮ್ಮನ್ನು ಗದರಿಸಿ ನಿಮ್ಮ ಕಣ್ಣು ಮುಂದೆಯೇ</para>
  <para style="q2" vid="PSA 50:21">ನಿಮ್ಮ ಅಪರಾಧ ಪ್ರಕಟಿಸುವೆನು.<verse eid="PSA 50:21"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 50:22"/>“ದೇವರನ್ನು ಮರೆತು ಬಿಡುವವರೇ, ಇದನ್ನು ನಿಮ್ಮ ಮನಸ್ಸಿಗೆ ತಂದುಕೊಳ್ಳಿರಿ.</para>
  <para style="q2" vid="PSA 50:22">ಇಲ್ಲವಾದರೆ ಎಚ್ಚರಿಕೆಯಾಗಿರಿ.</para>
  <para style="q2" vid="PSA 50:22">ನನ್ನ ಕೈಯಿಂದ ಬಿಡಿಸುವವರು ಯಾರೂ ಇರುವುದಿಲ್ಲವೆಂಬುದನ್ನು ಗ್ರಹಿಸಿಕೊಳ್ಳಿರಿ.<verse eid="PSA 50:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 50:23"/>ಯಾರು ಧನ್ಯವಾದದ ಬಲಿಯನ್ನು ಅರ್ಪಿಸುವರೋ ಅವರೇ ನನ್ನನ್ನು ಘನಪಡಿಸುವರು.</para>
  <para style="q2" vid="PSA 50:23">ತಮ್ಮ ನಡವಳಿಕೆಯನ್ನು ಕ್ರಮಪಡಿಸಿಕೊಳ್ಳುವವರಿಗೆ ನನ್ನ ರಕ್ಷಣೆಯನ್ನು ತೋರಿಸುವೆನು.”<verse eid="PSA 50:23"/></para>
  <chapter eid="PSA 50"/>
  <chapter number="51" style="c" sid="PSA 51"/>
  <para style="cl">ಕೀರ್ತನೆ 51</para>
  <para style="d">ಸಂಗೀತ ನಿರ್ದೇಶಕನಿಗಾಗಿರುವ ಕೀರ್ತನೆ. ದಾವೀದನ ಕೀರ್ತನೆ. ದಾವೀದನು ಬತ್ಷೆಬೆಳ ಸಂಗಡ ಪಾಪಮಾಡಿದ ಮೇಲೆ, ಪ್ರವಾದಿಯಾದ ನಾತಾನನು ಅವನ ಹತ್ತಿರ ಬಂದಾಗ ರಚಿಸಿದ ಕೀರ್ತನೆ.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 51:1"/>ದೇವರೇ, ನಿಮ್ಮ ಒಡಂಬಡಿಕೆಯ ಪ್ರೀತಿಗೆ ಅನುಸಾರವಾಗಿ</para>
  <para style="q2" vid="PSA 51:1">ನನ್ನನ್ನು ಕರುಣಿಸಿರಿ.</para>
  <para style="q1" vid="PSA 51:1">ನಿಮ್ಮ ಮಹಾ ಅನುಕಂಪಕ್ಕೆ ಅನುಸಾರವಾಗಿ</para>
  <para style="q2" vid="PSA 51:1">ನನ್ನ ಅತಿಕ್ರಮಗಳನ್ನು ಅಳಿಸಿಬಿಡಿರಿ.<verse eid="PSA 51:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 51:2"/>ನನ್ನ ಎಲ್ಲಾ ಅಪರಾಧಗಳಿಂದ ನನ್ನನ್ನು ತೊಳೆದುಬಿಡಿರಿ;</para>
  <para style="q2" vid="PSA 51:2">ನನ್ನ ಪಾಪದಿಂದ ನನ್ನನ್ನು ಶುದ್ಧಮಾಡಿರಿ.<verse eid="PSA 51:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 51:3"/>ನನ್ನ ಅತಿಕ್ರಮಗಳನ್ನು ನಾನೇ ತಿಳಿದಿದ್ದೇನೆ,</para>
  <para style="q2" vid="PSA 51:3">ನನ್ನ ಪಾಪವು ಯಾವಾಗಲೂ ನನ್ನ ಕಣ್ಮುಂದೆಯೇ ಇದೆ.<verse eid="PSA 51:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 51:4"/>ನಿಮಗೇ ನಿಮಗೊಬ್ಬರಿಗೆ ಮಾತ್ರ ವಿರೋಧವಾಗಿ ನಾನು ಪಾಪಮಾಡಿ,</para>
  <para style="q2" vid="PSA 51:4">ನಿಮ್ಮ ದೃಷ್ಟಿಯಲ್ಲಿ ಕೆಟ್ಟದ್ದಾಗಿರುವುದ್ದನ್ನೇ ಮಾಡಿದ್ದೇನೆ.</para>
  <para style="q1" vid="PSA 51:4">ಹೀಗೆ ನೀವು ನ್ಯಾಯತೀರಿಸುವಾಗ ನೀತಿವಂತರಾಗಿಯೂ</para>
  <para style="q2" vid="PSA 51:4">ನೀವು ತೀರ್ಪು ನಿರ್ಣಯಿಸುವಾಗ ನ್ಯಾಯವಂತರಾಗಿಯೂ ಇರುವಿರಿ.<verse eid="PSA 51:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 51:5"/>ಹುಟ್ಟಿದಂದಿನಿಂದಲೇ ನಾನು ಪಾಪಿ.</para>
  <para style="q2" vid="PSA 51:5">ನನ್ನ ತಾಯಿ ನನ್ನನ್ನು ಗರ್ಭಧರಿಸಿದಾಗಲೇ ನಾನು ಪಾಪಿಯೇ.<verse eid="PSA 51:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 51:6"/>ಆದರೂ ಅಂತರಂಗದಲ್ಲಿ ನೀವು ಯಥಾರ್ಥವನ್ನು ಬಯಸುತ್ತೀರಿ.</para>
  <para style="q2" vid="PSA 51:6">ನೀವು ಹೃದಯದ ಆಂತರ್ಯದಲ್ಲಿ ನನಗೆ ಜ್ಞಾನವನ್ನು ಬೋಧಿಸಿದ್ದೀರಿ.<verse eid="PSA 51:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 51:7"/>ಹಿಸ್ಸೋಪಿನಿಂದ ನನ್ನನ್ನು ಶುಚಿಮಾಡಿರಿ, ಆಗ ನಾನು ಶುದ್ಧನಾಗುವೆನು.</para>
  <para style="q2" vid="PSA 51:7">ನನ್ನನ್ನು ತೊಳೆಯಿರಿ, ಆಗ ಹಿಮಕ್ಕಿಂತ ಬೆಳ್ಳಗಾಗುವೆನು.<verse eid="PSA 51:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 51:8"/>ನಾನು ಆನಂದವನ್ನೂ ಹರ್ಷವನ್ನೂ ಕೇಳುವಂತೆ ಮಾಡಿರಿ;</para>
  <para style="q2" vid="PSA 51:8">ನೀವು ಜಜ್ಜಿದ ಎಲುಬುಗಳು ಆನಂದಪಡಲಿ.<verse eid="PSA 51:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 51:9"/>ನನ್ನ ಪಾಪಗಳಿಗೆ ನಿಮ್ಮ ಮುಖವನ್ನು ಮರೆಮಾಡಿಕೊಳ್ಳಿರಿ;</para>
  <para style="q2" vid="PSA 51:9">ನನ್ನ ಅಧರ್ಮಗಳನ್ನೆಲ್ಲಾ ಅಳಿಸಿಬಿಡಿರಿ.<verse eid="PSA 51:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 51:10"/>ಓ ದೇವರೇ, ಶುದ್ಧ ಹೃದಯವನ್ನು ನನ್ನಲ್ಲಿ ಸೃಷ್ಟಿಮಾಡಿರಿ,</para>
  <para style="q2" vid="PSA 51:10">ಸ್ಥಿರವಾದ ಆತ್ಮವನ್ನು ನನ್ನಲ್ಲಿ ನವೀಕರಿಸಿರಿ.<verse eid="PSA 51:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 51:11"/>ನಿಮ್ಮ ಸನ್ನಿಧಿಯಿಂದ ನನ್ನನ್ನು ಹೊರ ದೂಡಬೇಡಿರಿ;</para>
  <para style="q2" vid="PSA 51:11">ನಿಮ್ಮ ಪರಿಶುದ್ಧಾತ್ಮರನ್ನು ನನ್ನಿಂದ ತೆಗೆಯಬೇಡಿರಿ.<verse eid="PSA 51:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 51:12"/>ನಿಮ್ಮ ರಕ್ಷಣೆಯ ಆನಂದವನ್ನು ನನಗೆ ಪುನಃ ಸ್ಥಾಪಿಸಿರಿ;</para>
  <para style="q2" vid="PSA 51:12">ನನಗೆ ಸಿದ್ಧ ಆತ್ಮವನ್ನು ನೀಡಿ, ನನ್ನನ್ನು ಬೆಂಬಲಿಸಿರಿ.<verse eid="PSA 51:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 51:13"/>ಆಗ ನಾನು ಅತಿಕ್ರಮಿಸಿದವರಿಗೆ ನಿಮ್ಮ ಮಾರ್ಗಗಳನ್ನು ಬೋಧಿಸುವೆನು;</para>
  <para style="q2" vid="PSA 51:13">ಮತ್ತು ಪಾಪಿಗಳು ನಿಮ್ಮ ಕಡೆಗೆ ತಿರುಗಿಕೊಳ್ಳುವರು.<verse eid="PSA 51:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 51:14"/>ದೇವರೇ, ನನ್ನ ರಕ್ಷಣೆಯ ದೇವರೇ,</para>
  <para style="q2" vid="PSA 51:14">ರಕ್ತಾಪರಾಧದಿಂದ ನನ್ನನ್ನು ಬಿಡಿಸಿರಿ,</para>
  <para style="q2" vid="PSA 51:14">ನನ್ನ ನಾಲಿಗೆಯು ನಿಮ್ಮ ನೀತಿಯನ್ನು ಹಾಡುವುದು.<verse eid="PSA 51:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 51:15"/>ಕರ್ತಾ, ನನ್ನ ತುಟಿಗಳನ್ನು ತೆರೆಯಿರಿ.</para>
  <para style="q2" vid="PSA 51:15">ಆಗ ನನ್ನ ಬಾಯಿ ನಿಮ್ಮ ಸ್ತೋತ್ರವನ್ನು ಪ್ರಸಿದ್ಧಿ ಮಾಡುವುದು.<verse eid="PSA 51:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 51:16"/>ಯಜ್ಞವನ್ನು ನೀವು ಇಷ್ಟಪಡುವುದಿಲ್ಲ, ಇಲ್ಲವಾದರೆ ನಾನು ಅದನ್ನು ತರುತ್ತಿದ್ದೆನು.</para>
  <para style="q2" vid="PSA 51:16">ದಹನಬಲಿಗಳಲ್ಲಿ ನೀವು ಸಂತೋಷಪಡುವುದಿಲ್ಲ.<verse eid="PSA 51:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 51:17"/>ಓ ದೇವರೇ, ನಿಮಗೆ ಇಷ್ಟವಾದ ಯಜ್ಞಗಳು ಮುರಿದ ಆತ್ಮವೇ.</para>
  <para style="q2" vid="PSA 51:17">ಮುರಿದಂಥ, ಜಜ್ಜಿದಂಥ ಹೃದಯವನ್ನು</para>
  <para style="q2" vid="PSA 51:17">ದೇವರು ತಿರಸ್ಕರಿಸುವುದಿಲ್ಲ.<verse eid="PSA 51:17"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 51:18"/>ನಿಮ್ಮ ಮೆಚ್ಚುಗೆಯಿಂದ ಚೀಯೋನಿಗೆ ಸಮೃದ್ಧಿಯನ್ನು ನೀಡಿರಿ,</para>
  <para style="q2" vid="PSA 51:18">ಯೆರೂಸಲೇಮಿನ ಗೋಡೆಗಳನ್ನು ಕಟ್ಟಿರಿ.<verse eid="PSA 51:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 51:19"/>ಆಗ ನೀತಿಯ ಯಜ್ಞಗಳಲ್ಲಿಯೂ</para>
  <para style="q2" vid="PSA 51:19">ಸಂಪೂರ್ಣ ದಹನಬಲಿಗಳಲ್ಲಿಯೂ, ನೀವು ಸಂತೋಷಪಡುವಿರಿ;</para>
  <para style="q2" vid="PSA 51:19">ಆಗ ನಿಮ್ಮ ಬಲಿಪೀಠದ ಮೇಲೆ ಹೋರಿಗಳನ್ನು ಅರ್ಪಿಸಲಾಗುವುದು.<verse eid="PSA 51:19"/></para>
  <chapter eid="PSA 51"/>
  <chapter number="52" style="c" sid="PSA 52"/>
  <para style="cl">ಕೀರ್ತನೆ 52</para>
  <para style="d">ಸಂಗೀತ ನಿರ್ದೇಶಕನಿಗಾಗಿರುವ ಕೀರ್ತನೆ. ದಾವೀದನು ಅಹೀಮೆಲೆಕನ ಮನೆಗೆ ಬಂದ ವರ್ತಮಾನವನ್ನು ಎದೋಮ್ಯನಾದ ದೋಯೇಗನು ಸೌಲನಿಗೆ ತಿಳಿಸಿದಾಗ, <char style="tl">ಮಸ್ಕೀಲ್</char> ರಾಗದಲ್ಲಿ ದಾವೀದನು ರಚಿಸಿದ ಪದ್ಯ.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 52:1"/>ಬಲಿಷ್ಠನೇ, ನೀನು ಕೆಟ್ಟತನದಲ್ಲಿ ಹೆಚ್ಚಳ ಪಡುವುದೇಕೆ?</para>
  <para style="q2" vid="PSA 52:1">ದೇವರ ದೃಷ್ಟಿಯಲ್ಲಿ ಅಪಕೀರ್ತಿಯಾದವನೇ,</para>
  <para style="q2" vid="PSA 52:1">ದೇವರ ಅನಂತ ಕೃಪೆಯು ಯಾವಾಗಲೂ ಇರುವದು.<verse eid="PSA 52:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 52:2"/>ಮೋಸ ಮಾಡುವವನೇ,</para>
  <para style="q2" vid="PSA 52:2">ಹದವಾದ ಕ್ಷೌರ ಕತ್ತಿಯ ಹಾಗೆ</para>
  <para style="q2" vid="PSA 52:2">ನಿನ್ನ ನಾಲಿಗೆಯು ಕೇಡನ್ನು ಕಲ್ಪಿಸುತ್ತದೆ.<verse eid="PSA 52:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 52:3"/>ಒಳ್ಳೆಯದಕ್ಕಿಂತ ಕೆಟ್ಟದ್ದನ್ನೇ ನೀನು ಪ್ರೀತಿಸುತ್ತಿ.</para>
  <para style="q2" vid="PSA 52:3">ಸತ್ಯವನಾಡುವುದಕ್ಕಿಂತ ಸುಳ್ಳನ್ನೇ ನೀನು ಮಾತನಾಡುತ್ತಿ.<verse eid="PSA 52:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 52:4"/>ಮೋಸದ ನಾಲಿಗೆಯೇ,</para>
  <para style="q2" vid="PSA 52:4">ನಿನಗೆ ಹಾನಿಕರವಾದ ಮಾತುಗಳೇ ಇಷ್ಟ.<verse eid="PSA 52:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 52:5"/>ಆದ್ದರಿಂದ ದೇವರು ನಿಶ್ಚಯವಾಗಿ ನಿನ್ನನ್ನು ನಿತ್ಯ ನಾಶಕ್ಕೆ ತರುವರು.</para>
  <para style="q2" vid="PSA 52:5">ದೇವರು ನಿನ್ನನ್ನು ನಿನ್ನ ವಾಸಸ್ಥಳದಿಂದ ಕಿತ್ತುಹಾಕುವರು.</para>
  <para style="q2" vid="PSA 52:5">ಜೀವಿತರ ದೇಶದೊಳಗಿಂದ ನಿನ್ನನ್ನು ಬೇರುಸಹಿತ ಕೀಳುವರು.<verse eid="PSA 52:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 52:6"/>ನೀತಿವಂತರು ಇದನ್ನು ಕಂಡು ಭಯಪಡುವರು.</para>
  <para style="q2" vid="PSA 52:6">ಅವರು ನಿನ್ನ ಬಗ್ಗೆ ನಗಾಡಿ ಹೀಗನ್ನುವರು,<verse eid="PSA 52:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 52:7"/>“ಇಗೋ, ದೇವರನ್ನು ತನ್ನ ಬಲವನ್ನಾಗಿ ಮಾಡಿಕೊಳ್ಳದೆ,</para>
  <para style="q2" vid="PSA 52:7">ತನ್ನ ಅಧಿಕ ಐಶ್ವರ್ಯದಲ್ಲಿ ಭರವಸವಿಟ್ಟು</para>
  <para style="q1" vid="PSA 52:7">ತನ್ನ ಕೆಟ್ಟತನದಲ್ಲಿ ಬಲಗೊಂಡು ಇತರರನ್ನು ನಾಶಮಾಡಿದ</para>
  <para style="q2" vid="PSA 52:7">ಮನುಷ್ಯನು ಇವನೇ!”<verse eid="PSA 52:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 52:8"/>ನಾನಾದರೋ ದೇವರ ಆಲಯದಲ್ಲಿರುವ</para>
  <para style="q2" vid="PSA 52:8">ಅಭಿವರ್ದಿಸುವ ಓಲಿವ್ ಮರದ ಹಾಗೆ ಇರುವೆನು.</para>
  <para style="q1" vid="PSA 52:8">ದೇವರ ಒಡಂಬಡಿಕೆಯ ಪ್ರೀತಿಯಲ್ಲಿ</para>
  <para style="q2" vid="PSA 52:8">ಯುಗಯುಗಾಂತರವೂ ಭರವಸವಿಟ್ಟಿರುವೆನು.<verse eid="PSA 52:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 52:9"/>ದೇವರೇ ನಿಮ್ಮ ಉಪಕಾರಕ್ಕಾಗಿ ಯಾವಾಗಲೂ</para>
  <para style="q2" vid="PSA 52:9">ನಿಮ್ಮ ಭಕ್ತರ ಮುಂದೆ ನಿಮ್ಮನ್ನು ಸ್ತುತಿಸುತ್ತಿರುವೆನು.</para>
  <para style="q1" vid="PSA 52:9">ನಿಮ್ಮ ಹೆಸರು ಒಳ್ಳೆಯದು.</para>
  <para style="q2" vid="PSA 52:9">ಆದುದರಿಂದ ನಿಮ್ಮ ಹೆಸರನ್ನೇ ನಿರೀಕ್ಷಿಸಿಕೊಂಡಿರುವೆನು.<verse eid="PSA 52:9"/></para>
  <chapter eid="PSA 52"/>
  <chapter number="53" style="c" sid="PSA 53"/>
  <para style="cl">ಕೀರ್ತನೆ 53</para>
  <para style="d">ಸಂಗೀತ ನಿರ್ದೇಶಕನಿಗಾಗಿರುವ ಕೀರ್ತನೆ. <char style="tl">ಮಹಲಾತ್</char> ಎಂಬ ರಾಗದ ಪ್ರಕಾರ ಹಾಡತಕ್ಕದ್ದು. <char style="tl">ಮಸ್ಕೀಲ್</char> ರಾಗದಲ್ಲಿ ರಚಿಸಿದ ದಾವೀದನ ಕೀರ್ತನೆ.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 53:1"/>“ದೇವರು ಇಲ್ಲಾ,” ಎಂದು</para>
  <para style="q2" vid="PSA 53:1">ಮೂರ್ಖರು ತಮ್ಮ ಹೃದಯದಲ್ಲಿ ಹೇಳಿಕೊಳ್ಳುತ್ತಾರೆ.</para>
  <para style="q1" vid="PSA 53:1">ಅವರು ಕೆಟ್ಟು ಹೋದವರು ಅವರ ಮಾರ್ಗಗಳು ಅಸಹ್ಯಕರ.</para>
  <para style="q2" vid="PSA 53:1">ಅವರಲ್ಲಿ ಒಳ್ಳೆಯದನ್ನು ಮಾಡುವವರು ಒಬ್ಬರೂ ಇಲ್ಲ.<verse eid="PSA 53:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 53:2"/>ದೇವರನ್ನು ಹುಡುಕುವ</para>
  <para style="q2" vid="PSA 53:2">ಜ್ಞಾನಿಗಳು ಇದ್ದಾರೋ</para>
  <para style="q1" vid="PSA 53:2">ಎಂದು ನೋಡುವುದಕ್ಕೆ</para>
  <para style="q2" vid="PSA 53:2">ದೇವರು ಸ್ವರ್ಗದಿಂದ ಮನುಷ್ಯರ ಮೇಲೆ ದೃಷ್ಟಿಸಿದರು.<verse eid="PSA 53:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 53:3"/>ಒಳ್ಳೆಯದನ್ನು ಮಾಡುವವರು ಯಾರೂ ಇಲ್ಲ,</para>
  <para style="q2" vid="PSA 53:3">ಒಬ್ಬರಾದರೂ ಇಲ್ಲ.</para>
  <para style="q2" vid="PSA 53:3">ಎಲ್ಲರೂ ದಾರಿತಪ್ಪಿ ಹೋಗಿದ್ದಾರೆ, ಎಲ್ಲರೂ ಕೆಟ್ಟು ಹೋಗಿದ್ದರು.<verse eid="PSA 53:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 53:4"/>ದುಷ್ಟತ್ವವನ್ನು ನಡೆಸುವವರಿಗೆ ಏನೂ ತಿಳಿಯುವುದಿಲ್ಲವೋ?</para>
  <para style="b" vid="PSA 53:4"/>
  <para style="q1" vid="PSA 53:4">ಅವರು ನನ್ನ ಜನರನ್ನು ರೊಟ್ಟಿಯಂತೆ ತಿಂದು ಬಿಡುತ್ತಾರೆಯೋ?</para>
  <para style="q2" vid="PSA 53:4">ಅವರು ದೇವರನ್ನು ಸ್ಮರಿಸುವುದೇ ಇಲ್ಲ.<verse eid="PSA 53:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 53:5"/>ಭಯವಿಲ್ಲದಿರುವಲ್ಲಿ ಅವರು ಭಯಭ್ರಾಂತರಾದರು;</para>
  <para style="q2" vid="PSA 53:5">ಏಕೆಂದರೆ ನಿಮಗೆ ವಿರೋಧವಾಗಿ ದಂಡು ಇಳಿಸುವವರನ್ನು</para>
  <para style="q1" vid="PSA 53:5">ದೇವರು ಚದರಿಸಿಬಿಟ್ಟಿದ್ದಾರೆ. ನೀವು ಅವರನ್ನು ನಾಚಿಕೆಪಡಿಸಿದ್ದೀರಿ.</para>
  <para style="q2" vid="PSA 53:5">ಏಕೆಂದರೆ ದೇವರು ಅವರನ್ನು ತಿರಸ್ಕರಿಸಿದ್ದಾರೆ.<verse eid="PSA 53:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 53:6"/>ಓ, ಚೀಯೋನಿನಿಂದ ಇಸ್ರಾಯೇಲರಿಗೆ ರಕ್ಷಣೆಯು ಬಂದರೆ ಎಷ್ಟೋ ಒಳ್ಳೆಯದು!</para>
  <para style="q2" vid="PSA 53:6">ದೇವರು ತಮ್ಮ ಜನರನ್ನು ಸೆರೆಯಿಂದ ತಿರುಗಿ ಬರಮಾಡುವಾಗ</para>
  <para style="q2" vid="PSA 53:6">ಯಾಕೋಬ್ಯರು ಉಲ್ಲಾಸಗೊಳ್ಳುವರು. ಇಸ್ರಾಯೇಲರು ಸಂತೋಷಿಸುವರು.<verse eid="PSA 53:6"/></para>
  <chapter eid="PSA 53"/>
  <chapter number="54" style="c" sid="PSA 54"/>
  <para style="cl">ಕೀರ್ತನೆ 54</para>
  <para style="d">ಸಂಗೀತ ನಿರ್ದೇಶಕನಿಗಾಗಿರುವ ಕೀರ್ತನೆ. ತಂತಿವಾದ್ಯದೊಡನೆ ಹಾಡತಕ್ಕದ್ದು. ಜಿಫೆಂಬ ಸ್ಥಳದವರು ಸೌಲನ ಬಳಿಗೆ ಬಂದು ದಾವೀದನು ತಮ್ಮಲ್ಲೇ ಅಡಗಿಕೊಂಡಿದ್ದಾನೆಂದು ತಿಳಿಸಿದಾಗ, <char style="tl">ಮಸ್ಕಿಲ್</char> ರಾಗದಲ್ಲಿ ದಾವೀದನು ರಚಿಸಿದ ಕೀರ್ತನೆ.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 54:1"/>ದೇವರೇ, ನಿಮ್ಮ ಹೆಸರಿನಿಂದ ನನ್ನನ್ನು ರಕ್ಷಿಸಿರಿ.</para>
  <para style="q2" vid="PSA 54:1">ನಿಮ್ಮ ಬಲದಿಂದ ನನಗೆ ನ್ಯಾಯತೀರಿಸಿರಿ.<verse eid="PSA 54:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 54:2"/>ದೇವರೇ, ನನ್ನ ಪ್ರಾರ್ಥನೆಯನ್ನು ಕೇಳಿರಿ.</para>
  <para style="q2" vid="PSA 54:2">ನನ್ನ ಬಾಯಿಯ ಮಾತಿಗೆ ಕಿವಿಕೊಡಿರಿ.<verse eid="PSA 54:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 54:3"/>ಗರ್ವಿಗಳು ನನಗೆ ವಿರೋಧವಾಗಿ ಎದ್ದಿದ್ದಾರೆ.</para>
  <para style="q2" vid="PSA 54:3">ಕ್ರೂರಿಗಳು ನನ್ನ ಪ್ರಾಣವನ್ನು ತೆಗೆಯಬೇಕೆಂದಿದ್ದಾರೆ.</para>
  <para style="q2" vid="PSA 54:3">ಅವರು ದೇವರನ್ನು ಲಕ್ಷಿಸುವದೇ ಇಲ್ಲ.<verse eid="PSA 54:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 54:4"/>ನಿಜವಾಗಿಯೂ ದೇವರು ನನ್ನ ಸಹಾಯಕರು.</para>
  <para style="q2" vid="PSA 54:4">ಯೆಹೋವ ದೇವರು ನನ್ನ ಪ್ರಾಣವನ್ನು ಕಾಪಾಡುವವರು.<verse eid="PSA 54:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 54:5"/>ನನ್ನ ಕೆಡುಕನ್ನು ಬಯಸುವವರು ಕೇಡನ್ನು ಅನುಭವಿಸಲಿ.</para>
  <para style="q2" vid="PSA 54:5">ನಿಮ್ಮ ನಂಬಿಗಸ್ತಿಕೆಯಿಂದ ನೀವು ಅವರನ್ನು ದಂಡಿಸಿರಿ.<verse eid="PSA 54:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 54:6"/>ನಾನು ನಿಮಗೆ ಸ್ವಂತ ಇಚ್ಛೆಯಿಂದ ಬಲಿಯನ್ನು ಅರ್ಪಿಸುವೆನು.</para>
  <para style="q2" vid="PSA 54:6">ಯೆಹೋವ ದೇವರೇ, ನಿಮ್ಮ ಒಳ್ಳೆಯ ಹೆಸರನ್ನು ಕೊಂಡಾಡುವೆನು.<verse eid="PSA 54:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 54:7"/>ಏಕೆಂದರೆ ಎಲ್ಲಾ ಇಕ್ಕಟ್ಟಿನಿಂದ ನನ್ನನ್ನು ಬಿಡಿಸಿದ ದೇವರು ನೀವೇ.</para>
  <para style="q2" vid="PSA 54:7">ನನ್ನ ವೈರಿಗಳ ಮೇಲೆ ಜಯ ಸಾಧಿಸಿದ್ದನ್ನು ನಾನು ನೋಡುವೆನು.<verse eid="PSA 54:7"/></para>
  <chapter eid="PSA 54"/>
  <chapter number="55" style="c" sid="PSA 55"/>
  <para style="cl">ಕೀರ್ತನೆ 55</para>
  <para style="d">ಸಂಗೀತ ನಿರ್ದೇಶಕನಿಗಾಗಿರುವ ಕೀರ್ತನೆ. ತಂತಿವಾದ್ಯದೊಡನೆ ಹಾಡತಕ್ಕದ್ದು. <char style="tl">ಮಸ್ಕಿಲ್</char> ರಾಗದಲ್ಲಿ ದಾವೀದನು ರಚಿಸಿದ ಕೀರ್ತನೆ.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 55:1"/>ದೇವರೇ, ನನ್ನ ಪ್ರಾರ್ಥನೆಗೆ ಕಿವಿಗೊಡಿರಿ,</para>
  <para style="q2" vid="PSA 55:1">ನನ್ನ ವಿಜ್ಞಾಪನೆಗೆ ನಿಮ್ಮನ್ನು ಮರೆಮಾಡಿಕೊಳ್ಳಬೇಡಿರಿ.<verse eid="PSA 55:1"/></para>
  <para style="q2">
    <verse number="2" style="v" sid="PSA 55:2"/>ನನ್ನನ್ನು ಆಲೈಸಿರಿ, ನನಗೆ ಉತ್ತರಕೊಡಿರಿ.</para>
  <para style="q1" vid="PSA 55:2">ನಾನು ನನ್ನ ಚಿಂತೆಯಿಂದ ದುಃಖಿಸುತ್ತಾ ಬೇಸರವಾಗಿದ್ದೇನೆ.<verse eid="PSA 55:2"/></para>
  <para style="q2">
    <verse number="3" style="v" sid="PSA 55:3"/>ಶತ್ರುವಿನ ಗರ್ಜನೆಯಿಂದಲೂ</para>
  <para style="q2" vid="PSA 55:3">ದುಷ್ಟರ ಬೆದರಿಕೆಯಿಂದಲೂ ನರಳುತ್ತೇನೆ.</para>
  <para style="q1" vid="PSA 55:3">ಏಕೆಂದರೆ ಅವರು ಅಪರಾಧವನ್ನು ನನ್ನ ಮೇಲೆ ಬರಮಾಡಿ,</para>
  <para style="q2" vid="PSA 55:3">ಕೋಪದಿಂದ ನನ್ನನ್ನು ಹಗೆ ಮಾಡುತ್ತಾರೆ.<verse eid="PSA 55:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 55:4"/>ನನ್ನ ಹೃದಯವು ನನ್ನ ಅಂತರಂಗದಲ್ಲಿ ನೊಂದುಕೊಳ್ಳುತ್ತದೆ.</para>
  <para style="q2" vid="PSA 55:4">ಮರಣದ ಬೆದರಿಕೆಗಳು ನನ್ನ ಮೇಲೆ ಬಿದ್ದಿವೆ.<verse eid="PSA 55:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 55:5"/>ಭಯವೂ ನಡುಗೂ ನನಗೆ ಬಂದಿವೆ;</para>
  <para style="q2" vid="PSA 55:5">ಭೀತಿಯು ನನ್ನನ್ನು ಮುಚ್ಚಿದೆ.<verse eid="PSA 55:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 55:6"/>“ಓ, ಪಾರಿವಾಳದಂತೆ ನನಗೆ ರೆಕ್ಕೆಗಳು ಇರುತ್ತಿದ್ದರೆ,</para>
  <para style="q2" vid="PSA 55:6">ಹಾರಿಹೋಗಿ ವಿಶ್ರಾಂತಿಯನ್ನು ತೆಗೆದುಕೊಳ್ಳುತ್ತಿದ್ದೆ.<verse eid="PSA 55:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 55:7"/>ನಾನು ದೂರ ಹಾರಿಹೋಗಿ</para>
  <para style="q2" vid="PSA 55:7">ಮರುಭೂಮಿಯಲ್ಲಿ ವಾಸಿಸುತ್ತಿದ್ದೆ.<verse eid="PSA 55:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 55:8"/>ಚಂಡಮಾರುತದಿಂದಲೂ ಬಿರುಗಾಳಿಯಿಂದಲೂ</para>
  <para style="q2" vid="PSA 55:8">ತಪ್ಪಿಸಿಕೊಳ್ಳುತ್ತಿದ್ದೆ,” ಎಂದುಕೊಂಡೆನು.<verse eid="PSA 55:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 55:9"/>ಯೆಹೋವ ದೇವರೇ, ದುಷ್ಟರನ್ನು ಕಳವಳಗೊಳಿಸಿರಿ, ಅವರ ಮಾತುಗಳನ್ನು ನಿಲ್ಲಿಸಿಬಿಡಿರಿ.</para>
  <para style="q2" vid="PSA 55:9">ಬಲಾತ್ಕಾರವನ್ನೂ ವಿವಾದವನ್ನೂ ಪಟ್ಟಣದಲ್ಲಿ ನಾನು ಕಾಣುತ್ತಿದ್ದೇನೆ.<verse eid="PSA 55:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 55:10"/>ಅವರು ಹಗಲಿರುಳು ಪಟ್ಟಣದ ಗೋಡೆಗಳನ್ನು ಸುತ್ತುತ್ತಾರೆ.</para>
  <para style="q2" vid="PSA 55:10">ಕೇಡು ಅನಾಚಾರಗಳು ಅದರ ಮಧ್ಯದಲ್ಲಿ ಇವೆ.<verse eid="PSA 55:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 55:11"/>ನಾಶಕರ ಶಕ್ತಿಗಳು ನಗರ ಮಧ್ಯದಲ್ಲಿ ಇವೆ.</para>
  <para style="q2" vid="PSA 55:11">ಬೀದಿಗಳೊಳಗಿಂದ ಬೆದರಿಕೆಯೂ ವಂಚನೆಯೂ ತೊಲಗುವುದಿಲ್ಲ.<verse eid="PSA 55:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 55:12"/>ನನ್ನನ್ನು ನಿಂದಿಸುವವನು ಶತ್ರುವಲ್ಲ,</para>
  <para style="q2" vid="PSA 55:12">ಶತ್ರುವಾದರೆ ತಾಳಿಕೊಳ್ಳುತ್ತಿದ್ದೆ.</para>
  <para style="q1" vid="PSA 55:12">ನನಗೆ ವಿರೋಧವಾಗಿರುವವನು ನನ್ನ ವೈರಿಯಾಗಿದ್ದರೆ,</para>
  <para style="q2" vid="PSA 55:12">ಅವನಿಂದ ಅಡಗಿಕೊಳ್ಳುತ್ತಿದ್ದೆನು.<verse eid="PSA 55:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 55:13"/>ಆದರೆ ನನ್ನ ಜೊತೆಗಾರನೂ ನನ್ನ ಆಪ್ತನೂ,</para>
  <para style="q2" vid="PSA 55:13">ನನಗೆ ಸಮನಾದವನೇ ವಿರೋಧವಾಗಿದ್ದಾನೆ.<verse eid="PSA 55:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 55:14"/>ದೇವರ ಆಲಯಕ್ಕೆ ಆರಾಧಕರ</para>
  <para style="q2" vid="PSA 55:14">ಗುಂಪಿನೊಂದಿಗೆ ನಾವಿಬ್ಬರೂ</para>
  <para style="q1" vid="PSA 55:14">ನಡೆದು ಹೋಗುವಾಗ</para>
  <para style="q2" vid="PSA 55:14">ಮಧುರ ಅನ್ಯೋನ್ಯತೆಯನ್ನು ಅನುಭವಿಸಿದೆವು.<verse eid="PSA 55:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 55:15"/>ಮರಣ ನನ್ನ ವೈರಿಗಳನ್ನು ತಟ್ಟನೆ ಹಿಡಿಯಲಿ.</para>
  <para style="q2" vid="PSA 55:15">ಜೀವಸಹಿತ ಪಾತಾಳಕ್ಕೆ ಅವರು ಇಳಿಯಲಿ,</para>
  <para style="q2" vid="PSA 55:15">ಅವರ ಮನೆಯಲ್ಲಿ ದುಷ್ಟತನವು ಇದೆ.<verse eid="PSA 55:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 55:16"/>ಆದರೆ ನಾನು ದೇವರನ್ನು ಕರೆಯುವೆನು.</para>
  <para style="q2" vid="PSA 55:16">ಯೆಹೋವ ದೇವರು ನನ್ನನ್ನು ರಕ್ಷಿಸುವರು.<verse eid="PSA 55:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 55:17"/>ಸಂಜೆ, ಮುಂಜಾನೆ, ಮಧ್ಯಾಹ್ನಗಳಲ್ಲಿ</para>
  <para style="q2" vid="PSA 55:17">ಹಂಬಲಿಸಿ ಮೊರೆಯಿಡುವೆನು.</para>
  <para style="q2" vid="PSA 55:17">ದೇವರು ನನ್ನ ಧ್ವನಿಯನ್ನು ಕೇಳುವರು.<verse eid="PSA 55:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 55:18"/>ಅನೇಕರು ನನ್ನನ್ನು ವಿರೋಧಿಸಿದರೂ</para>
  <para style="q2" vid="PSA 55:18">ನನಗೆ ವಿರೋಧವಾಗಿ ಆಗುವ ಯುದ್ಧಗಳಲ್ಲಿ</para>
  <para style="q2" vid="PSA 55:18">ದೇವರು ನನ್ನನ್ನು ಯಾವುದೇ ಹಾನಿಯಾಗದಂತೆ ವಿಮೋಚಿಸುವರು.<verse eid="PSA 55:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 55:19"/>ಆದಿಯಿಂದ ಸಿಂಹಾಸನಾರೂಢರಾಗಿರುವ ದೇವರು,</para>
  <para style="q2" vid="PSA 55:19">ಅವರ ಮೊರೆಯನ್ನು ಕೇಳಿ ಅವರನ್ನು ತಗ್ಗಿಸುವರು,</para>
  <para style="q1" vid="PSA 55:19">ಏಕೆಂದರೆ, ಅವರು ದೇವರಿಗೆ ಭಯಪಡುವುದಿಲ್ಲ.</para>
  <para style="q2" vid="PSA 55:19">ದೇವರು ಬದಲಾಗುವುದಿಲ್ಲ.<verse eid="PSA 55:19"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 55:20"/>ನನ್ನ ಜೊತೆಗಾರನು ತನ್ನ ಸ್ನೇಹಿತನ ಮೇಲೆ ದಾಳಿಮಾಡಿದ್ದಾನೆ.</para>
  <para style="q2" vid="PSA 55:20">ತಾನು ಮಾಡಿದ ಒಡಂಬಡಿಕೆಯನ್ನು ಭಂಗಪಡಿಸಿದ್ದಾನೆ.<verse eid="PSA 55:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 55:21"/>ಅವನ ಬಾಯಿಯ ಮಾತುಗಳು ಬೆಣ್ಣೆಗಿಂತ ನುಣ್ಣಗಾಗಿವೆ;</para>
  <para style="q2" vid="PSA 55:21">ಆದರೆ ಅವನ ಹೃದಯದಲ್ಲಿ ಕಾಳಗವಿದೆ;</para>
  <para style="q1" vid="PSA 55:21">ಅವನ ಮಾತುಗಳು ಎಣ್ಣೆಗಿಂತ ನಯವಾಗಿವೆ;</para>
  <para style="q2" vid="PSA 55:21">ಆದರೆ ಅವು ಬಿಚ್ಚುಗತ್ತಿಗಳಾಗಿವೆ.<verse eid="PSA 55:21"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 55:22"/>ಯೆಹೋವ ದೇವರ ಮೇಲೆ ನಿಮ್ಮ ಭಾರವನ್ನು ಹಾಕಿರಿ.</para>
  <para style="q2" vid="PSA 55:22">ಅವರು ನಿಮಗೆ ಆಧಾರವಾಗಿರುವರು.</para>
  <para style="q1" vid="PSA 55:22">ದೇವರು ಎಂದೆಂದಿಗೂ</para>
  <para style="q2" vid="PSA 55:22">ನೀತಿವಂತನನ್ನು ಕದಲಗೊಡಿಸುವುದಿಲ್ಲ.<verse eid="PSA 55:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 55:23"/>ಆದರೆ ದೇವರೇ, ದುಷ್ಟರನ್ನು ನಾಶದ</para>
  <para style="q2" vid="PSA 55:23">ಕುಣಿಯಲ್ಲಿ ಇಳಿಯ ಮಾಡುವಿರಿ.</para>
  <para style="q1" vid="PSA 55:23">ಕೊಲೆಪಾತಕರೂ ಮೋಸಗಾರರೂ</para>
  <para style="q2" vid="PSA 55:23">ತಮ್ಮ ಆಯುಷ್ಕಾಲದಲ್ಲಿ ಅರ್ಧವನ್ನೂ ಜೀವಿಸುವುದಿಲ್ಲ.</para>
  <para style="b" vid="PSA 55:23"/>
  <para style="q1" vid="PSA 55:23">ನಾನಾದರೋ ನಿಮ್ಮಲ್ಲಿ ಭರವಸವಿಡುತ್ತೇನೆ.<verse eid="PSA 55:23"/></para>
  <chapter eid="PSA 55"/>
  <chapter number="56" style="c" sid="PSA 56"/>
  <para style="cl">ಕೀರ್ತನೆ 56</para>
  <para style="d">ಸಂಗೀತ ನಿರ್ದೇಶಕನಿಗಾಗಿರುವ ಕೀರ್ತನೆ. “ದೂರದ ಓಕ್ ಮರದ ಮೇಲೆ ಪಾರಿವಾಳ ಕುಳಿತಿದೆ” ಎಂಬ ರಾಗವನ್ನು ಆಧರಿಸಿದೆ. ದಾವೀದನ <char style="tl">ಮಿಕ್ಟಮ್</char> ಹಾಡಿನ ಸಂಯೋಜನೆ. ದಾವೀದನ ಗತ್ ಎಂಬ ಊರಲ್ಲಿ ಫಿಲಿಷ್ಟಿಯರ ಕೈವಶವಾದಾಗ ರಚಿಸಿದ ಕಾವ್ಯ.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 56:1"/>ದೇವರೇ ಕರುಣಿಸು,</para>
  <para style="q2" vid="PSA 56:1">ಏಕೆಂದರೆ ಮನುಷ್ಯರು ನನ್ನನ್ನು ಬೆನ್ನಟ್ಟುತ್ತಿದ್ದಾರೆ.</para>
  <para style="q2" vid="PSA 56:1">ದಿನವೆಲ್ಲಾ ವಿರೋಧಿಸುತ್ತಾ ನನ್ನನ್ನು ಬಾಧಿಸುತ್ತಿದ್ದಾರೆ.<verse eid="PSA 56:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 56:2"/>ನನ್ನ ವಿರೋಧಿಗಳು ದಿನವೆಲ್ಲಾ ನನ್ನನ್ನು ಬೆನ್ನಟ್ಟುತ್ತಿದ್ದಾರೆ.</para>
  <para style="q2" vid="PSA 56:2">ಗರ್ವದಿಂದ ನನಗೆ ವಿರೋಧವಾಗಿ ಯುದ್ಧ ಮಾಡುತ್ತಿದ್ದಾರೆ.<verse eid="PSA 56:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 56:3"/>ನಾನು ಭಯಪಡುವ ಸಮಯದಲ್ಲಿ ನಿಮ್ಮಲ್ಲಿ ಭರವಸೆ ಇಡುವೆನು.<verse eid="PSA 56:3"/></para>
  <para style="q2">
    <verse number="4" style="v" sid="PSA 56:4"/>ದೇವರ ಮಾತುಗಳಲ್ಲಿ ನಾನು ಹೆಮ್ಮೆಪಡುವೆನು.</para>
  <para style="q1" vid="PSA 56:4">ದೇವರಲ್ಲಿಯೇ ಭರವಸೆ ಇಡುವೆನು, ನಾನು ಭಯಪಡುವುದಿಲ್ಲ.</para>
  <para style="q2" vid="PSA 56:4">ಸಾಯುವ ಮನುಷ್ಯನು ನನಗೇನು ಮಾಡಬಲ್ಲ?<verse eid="PSA 56:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 56:5"/>ಶತ್ರುಗಳು ನನ್ನ ಮಾತುಗಳನ್ನು ಸದಾ ಅಪಾರ್ಥ ಮಾಡಿಕೊಳ್ಳುತ್ತಾರೆ.</para>
  <para style="q2" vid="PSA 56:5">ನನಗೆ ವಿರೋಧವಾಗಿರುವ ಅವರ ಆಲೋಚನೆಗಳೆಲ್ಲಾ ಕೇಡಿಗಾಗಿವೆ.<verse eid="PSA 56:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 56:6"/>ಅವರು ಕೂಡಿಕೊಂಡು ಹೊಂಚುಹಾಕುತ್ತಾರೆ.</para>
  <para style="q2" vid="PSA 56:6">ನನ್ನ ಪ್ರಾಣ ತೆಗೆಯಲು ಕುತೂಹಲದಿಂದ</para>
  <para style="q2" vid="PSA 56:6">ನನ್ನ ಹೆಜ್ಜೆಗಳನ್ನು ಗುರುತಿಸುತ್ತಾರೆ.<verse eid="PSA 56:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 56:7"/>ಅಪರಾಧದಿಂದ ಅವರು ತಪ್ಪಿಸಿಕೊಂಡಾರೋ?</para>
  <para style="q2" vid="PSA 56:7">ದೇವರೇ ಜನರನ್ನು ಕಠಿಣವಾಗಿ ದಂಡಿಸಿರಿ.<verse eid="PSA 56:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 56:8"/>ನನ್ನ ಗೋಳಾಟವನ್ನು ಎಣಿಕೆ ಮಾಡಿರಿ,</para>
  <para style="q2" vid="PSA 56:8">ನಿಮ್ಮ ಸುರುಳಿಯಲ್ಲಿ ನನ್ನ ಕಣ್ಣೀರ ಲೆಕ್ಕಮಾಡಿರಿ,</para>
  <para style="q2" vid="PSA 56:8">ಅವು ನಿಮ್ಮ ಗ್ರಂಥದಲ್ಲಿ ಬರೆದಿದೆಯಲ್ಲವೇ?<verse eid="PSA 56:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 56:9"/>ನಾನು ನಿಮಗೆ ಮೊರೆಯಿಟ್ಟಾಗ,</para>
  <para style="q2" vid="PSA 56:9">ನನ್ನ ಶತ್ರುಗಳು ಹಿಂದಿರುಗುವರು.</para>
  <para style="q2" vid="PSA 56:9">ಇದರಿಂದ ದೇವರು ನನಗಿದ್ದಾರೆ ಎಂಬುದನ್ನು ತಿಳಿದುಕೊಳ್ಳುವೆನು.<verse eid="PSA 56:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 56:10"/>ನಾನು ದೇವರಲ್ಲಿಯೂ ದೇವರ ವಾಕ್ಯದಲ್ಲಿಯೂ ಹೆಮ್ಮೆಪಡುವೆನು.</para>
  <para style="q2" vid="PSA 56:10">ಹೌದು, ದೇವರಲ್ಲಿಯೂ ಯೆಹೋವ ದೇವರ ವಾಕ್ಯದಲ್ಲಿಯೂ ಹೆಮ್ಮೆಪಡುವೆನು.<verse eid="PSA 56:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 56:11"/>ನಾನು ದೇವರಲ್ಲಿ ಭರವಸೆಯಿಡುವೆನು. ನಾನು ಭಯಪಡುವುದಿಲ್ಲ.</para>
  <para style="q2" vid="PSA 56:11">ಮಾನವನು ನನಗೇನು ಮಾಡುವನು?<verse eid="PSA 56:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 56:12"/>ನನ್ನ ದೇವರೇ ನಾನು ನಿಮಗೆ ಸಲ್ಲಿಸಿದ ಹರಕೆಗಳಿಗೆ ಅಧೀನವಾಗಿದ್ದೇನೆ.</para>
  <para style="q2" vid="PSA 56:12">ನಾನು ಉಪಕಾರ ಸ್ತುತಿಯ ಕಾಣಿಕೆಗಳನ್ನು ನಿಮಗೆ ಸಲ್ಲಿಸುವೆನು.<verse eid="PSA 56:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 56:13"/>ಏಕೆಂದರೆ ನೀವು ನನ್ನ ಪ್ರಾಣವನ್ನು ಮರಣದಿಂದ ಬಿಡಿಸಿದ್ದೀರಿ.</para>
  <para style="q2" vid="PSA 56:13">ನಾನು ಜೀವದ ಬೆಳಕಿನಲ್ಲಿ</para>
  <para style="q1" vid="PSA 56:13">ನಿಮ್ಮ ಮುಂದೆ ನಡೆದುಕೊಳ್ಳುವ</para>
  <para style="q2" vid="PSA 56:13">ಹಾಗೆ ನೀವು ನನ್ನ ಪಾದಗಳನ್ನು ಎಡವದಂತೆ ಕಾಪಾಡಿದ್ದೀರಿ.<verse eid="PSA 56:13"/></para>
  <chapter eid="PSA 56"/>
  <chapter number="57" style="c" sid="PSA 57"/>
  <para style="cl">ಕೀರ್ತನೆ 57</para>
  <para style="d">ಸಂಗೀತ ನಿರ್ದೇಶಕನಿಗಾಗಿರುವ ಕೀರ್ತನೆ. ಅಲ್ತಷ್ಖೇತೆಂಬ ರಾಗವನ್ನು ಆಧರಿಸಿದೆ. ದಾವೀದನ <char style="tl">ಮಿಕ್ಟಮ್</char> ಹಾಡಿನ ಸಂಯೋಜನೆ. ದಾವೀದನು ಸೌಲನ ಭಯದಿಂದ ಓಡಿಹೋಗಿ ಗುಹೆಯಲ್ಲಿ ಅಡಗಿಕೊಂಡಿದ್ದಾಗ ರಚಿಸಿದ ಕಾವ್ಯ.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 57:1"/>ದೇವರೇ ನನ್ನನ್ನು ಕರುಣಿಸಿರಿ, ನನ್ನನ್ನು ಕರುಣಿಸಿರಿ.</para>
  <para style="q2" vid="PSA 57:1">ನನ್ನ ಪ್ರಾಣವು ನಿಮ್ಮನ್ನು ಆಶ್ರಯಿಸಿಕೊಂಡಿದೆ;</para>
  <para style="q1" vid="PSA 57:1">ಆಪತ್ತುಗಳು ದಾಟುವವರೆಗೂ</para>
  <para style="q2" vid="PSA 57:1">ನಿಮ್ಮ ರೆಕ್ಕೆಗಳ ನೆರಳನ್ನೇ ನಾನು ಆಶ್ರಯಿಸಿಕೊಳ್ಳುತ್ತೇನೆ.<verse eid="PSA 57:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 57:2"/>ಮಹೋನ್ನತನಾದ ದೇವರಿಗೆ, ಮೊರೆಯಿಡುತ್ತೇನೆ.</para>
  <para style="q2" vid="PSA 57:2">ನನಗಾಗಿ ಕಾರ್ಯಗಳಿಗೆ ನ್ಯಾಯ ನೀಡುವ ದೇವರಿಗೆ ಮೊರೆಯಿಡುತ್ತೇನೆ.<verse eid="PSA 57:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 57:3"/>ದೇವರು ಪರಲೋಕದಿಂದ ಸಹಾಯ ಕಳುಹಿಸಿ,</para>
  <para style="q2" vid="PSA 57:3">ನನ್ನನ್ನು ನಿಂದಿಸುವವರನ್ನು ದಂಡಿಸಿ, ನನ್ನನ್ನು ರಕ್ಷಿಸುವರು.</para>
  <para style="q2" vid="PSA 57:3">ದೇವರು ತಮ್ಮ ಒಡಂಬಡಿಕೆಯ ಪ್ರೀತಿಯನ್ನೂ ತಮ್ಮ ಸತ್ಯವನ್ನೂ ಕಳುಹಿಸುವರು.<verse eid="PSA 57:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 57:4"/>ನಾನು ಸಿಂಹಗಳಂಥವರ ಮಧ್ಯದಲ್ಲಿದ್ದೇನೆ.</para>
  <para style="q2" vid="PSA 57:4">ಕ್ರೂರಮೃಗಗಳಂಥವರ ಮಧ್ಯದಲ್ಲಿ ಒತ್ತಾಯವಾಗಿ ವಾಸಮಾಡುತ್ತಿದ್ದೇನೆ.</para>
  <para style="q1" vid="PSA 57:4">ಅವರ ಹಲ್ಲು, ಭಲ್ಲೆ, ಬಾಣಗಳೂ</para>
  <para style="q2" vid="PSA 57:4">ಅವರ ನಾಲಿಗೆ ಹದವಾದ ಖಡ್ಗವೂ ಆಗಿವೆ.<verse eid="PSA 57:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 57:5"/>ಓ, ದೇವರೇ, ಆಕಾಶಗಳ ಮೇಲೆ ನಿಮ್ಮ ಘನವು ಮೆರೆಯಲಿ.</para>
  <para style="q2" vid="PSA 57:5">ಭೂಮಿಯ ಮೇಲೆಲ್ಲಾ ನಿಮ್ಮ ಮಹಿಮೆಯು ಹರಡಲಿ.<verse eid="PSA 57:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 57:6"/>ಶತ್ರುಗಳು ನನ್ನ ಕಾಲುಗಳಿಗೆ ಬಲೆಯೊಡ್ಡಿದ್ದಾರೆ.</para>
  <para style="q2" vid="PSA 57:6">ನನ್ನ ಪ್ರಾಣವು ಕುಗ್ಗಿಹೋಗಿದೆ.</para>
  <para style="q1" vid="PSA 57:6">ನನ್ನ ದಾರಿಯಲ್ಲಿ ಕುಣಿಯನ್ನು ಅಗೆದಿದ್ದಾರೆ.</para>
  <para style="q2" vid="PSA 57:6">ಅದರಲ್ಲಿ ತಾವೇ ಬಿದ್ದುಹೋದರು.<verse eid="PSA 57:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 57:7"/>ದೇವರೇ, ನನ್ನ ಹೃದಯವು ಸ್ಥಿರವಾಗಿದೆ.</para>
  <para style="q2" vid="PSA 57:7">ಹೌದು, ನನ್ನ ಹೃದಯವು ಸ್ಥಿರವಾಗಿದೆ.</para>
  <para style="q2" vid="PSA 57:7">ನಾನು ಸಂಗೀತದೊಡನೆ ಹಾಡುವೆನು.<verse eid="PSA 57:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 57:8"/>ಎಚ್ಚರವಾಗು, ನನ್ನ ಪ್ರಾಣವೇ,</para>
  <para style="q2" vid="PSA 57:8">ವೀಣೆಯೇ, ಕಿನ್ನರಿಯೇ ಎಚ್ಚರವಾಗಿರಿ,</para>
  <para style="q2" vid="PSA 57:8">ನಾನು ಉದಯಕಾಲವನ್ನು ಎಚ್ಚರಗೊಳಿಸುವೆನು.<verse eid="PSA 57:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 57:9"/>ಯೆಹೋವ ದೇವರೇ, ಜನಾಂಗಗಳಲ್ಲಿ ನಾನು ನಿಮ್ಮನ್ನು ಕೊಂಡಾಡುವೆನು.</para>
  <para style="q2" vid="PSA 57:9">ಜನರ ಮಧ್ಯದಲ್ಲಿ ನಿಮ್ಮನ್ನು ಹಾಡಿ ಕೊಂಡಾಡುವೆನು.<verse eid="PSA 57:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 57:10"/>ಆಕಾಶಕ್ಕಿಂತ ನಿಮ್ಮ ಪ್ರೀತಿ ದೊಡ್ಡದು.</para>
  <para style="q2" vid="PSA 57:10">ಮೇಘವನ್ನು ನಿಲುಕುವಷ್ಟು ನಿಮ್ಮ ಸತ್ಯವು ಉನ್ನತವಾಗಿವೆ.<verse eid="PSA 57:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 57:11"/>ಓ, ದೇವರೇ, ಆಕಾಶಗಳ ಮೇಲೆ ನಿಮ್ಮ ಘನವು ಮೆರೆಯಲಿ.</para>
  <para style="q2" vid="PSA 57:11">ಭೂಮಿಯ ಮೇಲೆಲ್ಲಾ ನಿಮ್ಮ ಮಹಿಮೆಯು ಹರಡಲಿ.<verse eid="PSA 57:11"/></para>
  <chapter eid="PSA 57"/>
  <chapter number="58" style="c" sid="PSA 58"/>
  <para style="cl">ಕೀರ್ತನೆ 58</para>
  <para style="d">ಸಂಗೀತ ನಿರ್ದೇಶಕನಿಗಾಗಿರುವ ಕೀರ್ತನೆ. ಅಲ್ತಷ್ಖೇತೆಂಬ ರಾಗವನ್ನು ಆಧರಿಸಿದೆ. ದಾವೀದನ <char style="tl">ಮಿಕ್ಟಮ್</char> ಹಾಡಿನ ಸಂಯೋಜನೆ. ದಾವೀದನ ಕೀರ್ತನೆ.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 58:1"/>ಜನನಾಯಕರೇ, ನೀವು ನ್ಯಾಯವಾಗಿ ತೀರ್ಪನ್ನು ನುಡಿಯುತ್ತೀರೋ?</para>
  <para style="q2" vid="PSA 58:1">ಜನರಲ್ಲಿ ನೀವು ಯಥಾರ್ಥವಾಗಿ ನ್ಯಾಯತೀರಿಸುವಿರೋ?<verse eid="PSA 58:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 58:2"/>ಇಲ್ಲಾ, ನಿಮ್ಮ ಹೃದಯದಲ್ಲಿ ದುಷ್ಟತನವನ್ನು ಕಲ್ಪಿಸುತ್ತೀರಲ್ಲಾ,</para>
  <para style="q2" vid="PSA 58:2">ದೇಶದಲ್ಲಿ ನಿಮ್ಮ ಕೈಗಳಿಂದ ಹಿಂಸಾಚಾರವನ್ನು ತೂಗುತ್ತೀರಲ್ಲಾ.<verse eid="PSA 58:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 58:3"/>ದುಷ್ಟರು ಗರ್ಭದಿಂದಲೇ ದಾರಿತಪ್ಪುತ್ತಾರೆ.</para>
  <para style="q2" vid="PSA 58:3">ಹುಟ್ಟಿದಂದಿನಿಂದಲೇ ಸುಳ್ಳಾಡುವವರಾಗಿ ತಪ್ಪಿಹೋಗುತ್ತಾರೆ.<verse eid="PSA 58:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 58:4"/>ಹಾವಿನ ವಿಷದ ಹಾಗೆ ಅವರಲ್ಲಿ ವಿಷ ಇದೆ.</para>
  <para style="q2" vid="PSA 58:4">ಘಟಸರ್ಪದ ಹಾಗೆ ಮಂದವಾಗಿದ್ದಾರೆ.<verse eid="PSA 58:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 58:5"/>ಚಮತ್ಕಾರದಿಂದ ಆಕರ್ಷಿಸಿ,</para>
  <para style="q2" vid="PSA 58:5">ಕೌಶಲ್ಯದಿಂದ ನುಡಿಸುವ ಹಾವಾಡಿಗನ ನಾದವನ್ನು ಕೇಳದ ಹಾವಿನಂತೆ ಇದ್ದಾರೆ.<verse eid="PSA 58:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 58:6"/>ಓ, ದೇವರೇ, ಅವರ ಹಲ್ಲುಗಳು ಮುರಿದು ಬೀಳಲಿ.</para>
  <para style="q2" vid="PSA 58:6">ಯೆಹೋವ ದೇವರೇ, ಪ್ರಾಯದ ಸಿಂಹಗಳಂತಿರುವ ಅವರ ಕೋರೆಹಲ್ಲುಗಳು ನಾಶವಾಗಲಿ.<verse eid="PSA 58:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 58:7"/>ಅವರು ನೀರಿನಂತೆ ಕರಗಿಹೋಗಲಿ.</para>
  <para style="q2" vid="PSA 58:7">ಅವರು ತಮ್ಮ ಬಾಣಗಳನ್ನು ಗುರಿಯಿಡುವಾಗ ಡೊಂಕಾಗಿ ಹೋಗಲಿ.<verse eid="PSA 58:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 58:8"/>ಕರಗುವ ಗೊಂಡೆ ಹುಳದಂತೆ ಅವರು ನಾಶವಾಗಲಿ.</para>
  <para style="q2" vid="PSA 58:8">ದಿನತುಂಬದೆ ಹುಟ್ಟಿದ ಶಿಶುವಿನಂತೆ ಅವರು ಸೂರ್ಯನನ್ನು ಕಾಣದಿರಲಿ.<verse eid="PSA 58:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 58:9"/>ಗಡಿಗೆಗಳು ಮುಳ್ಳಿನ ಬೆಂಕಿಯ ಶಾಖವನ್ನು ಇನ್ನೂ</para>
  <para style="q2" vid="PSA 58:9">ಹಸಿಯಾಗಿ ಇಲ್ಲವೆ ಒಣಗಿರುವಾಗಲೇ, ಬಿರುಗಾಳಿ ಹಾರಿಸಿಬಿಡುವಂತೆ ಅವರಿಗೆ ಆಗಲಿ.<verse eid="PSA 58:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 58:10"/>ನೀತಿವಂತರು ದುಷ್ಟರಿಗಾಗುವ ಪ್ರತಿದಂಡನೆಯನ್ನು ಕಂಡು ಹಿಗ್ಗಿ</para>
  <para style="q2" vid="PSA 58:10">ತಮ್ಮ ಪಾದಗಳನ್ನು ದುಷ್ಟನ ರಕ್ತದ ಮೇಲಿಡಲಿ.<verse eid="PSA 58:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 58:11"/>ಆಗ ಜನರು ಹೀಗೆ ಹೇಳಿಕೊಳ್ಳುವರು,</para>
  <para style="q2" vid="PSA 58:11">“ನಿಶ್ಚಯವಾಗಿ ನೀತಿವಂತನಿಗೆ ಫಲವಿದೆ.</para>
  <para style="q2" vid="PSA 58:11">ನಿಶ್ಚಯವಾಗಿ ಭೂಮಿಯಲ್ಲಿ ನ್ಯಾಯತೀರಿಸುವ ದೇವರು ಇದ್ದಾರೆ.”<verse eid="PSA 58:11"/></para>
  <chapter eid="PSA 58"/>
  <chapter number="59" style="c" sid="PSA 59"/>
  <para style="cl">ಕೀರ್ತನೆ 59</para>
  <para style="d">ಸಂಗೀತ ನಿರ್ದೇಶಕನಿಗಾಗಿರುವ ಕೀರ್ತನೆ. ಅಲ್ತಷ್ಖೇತೆಂಬ ರಾಗವನ್ನು ಆಧರಿಸಿದೆ. ದಾವೀದನ <char style="tl">ಮಿಕ್ಟಮ್</char> ಹಾಡಿನ ಸಂಯೋಜನೆ. ಸೌಲನು ಕಳುಹಿಸಿದವರು ದಾವೀದನ ಜೀವ ತೆಗೆಯಬೇಕೆಂದು ಅವನ ಮನೆಯ ಸುತ್ತಲೂ ಒಳಸಂಚುಮಾಡಿದಾಗ ಅವನು ರಚಿಸಿದ ಕಾವ್ಯ.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 59:1"/>ದೇವರೇ, ನನ್ನ ಶತ್ರುಗಳಿಂದ ನನ್ನನ್ನು ಬಿಡಿಸಿರಿ.</para>
  <para style="q2" vid="PSA 59:1">ನನಗೆ ವಿರೋಧವಾಗಿ ಎದ್ದವರಿಂದ ನನ್ನನ್ನು ರಕ್ಷಿಸಿರಿ<verse eid="PSA 59:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 59:2"/>ಕೆಡುಕನ್ನು ಮಾಡುವವರಿಂದ ನನ್ನನ್ನು ಬಿಡಿಸಿರಿ.</para>
  <para style="q2" vid="PSA 59:2">ಕೊಲೆಪಾತಕರಿಂದ ನನ್ನನ್ನು ರಕ್ಷಿಸಿರಿ.<verse eid="PSA 59:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 59:3"/>ಇಗೋ, ನನ್ನ ಪ್ರಾಣಕ್ಕೆ ಅವರು ಒಳಸಂಚುಮಾಡುತ್ತಾರೆ.</para>
  <para style="q2" vid="PSA 59:3">ಕ್ರೂರರು ನನಗೆ ವಿರೋಧವಾಗಿ ಕೂಡಿಕೊಳ್ಳುತ್ತಾರೆ.</para>
  <para style="q2" vid="PSA 59:3">ಯೆಹೋವ ದೇವರೇ, ನನ್ನಲ್ಲಿ ಅಪರಾಧವಿಲ್ಲ, ನಾನು ಯಾವ ತಪ್ಪೂ ಮಾಡಿಲ್ಲ.<verse eid="PSA 59:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 59:4"/>ನನ್ನಲ್ಲಿ ತಪ್ಪು ಇಲ್ಲದಿದ್ದರೂ ಅವರು ಹಾನಿಮಾಡಲು ಸಿದ್ಧರಾಗಿದ್ದಾರೆ.</para>
  <para style="q2" vid="PSA 59:4">ನನ್ನ ಅವಸ್ಥೆಯನ್ನು ನೋಡಿರಿ, ನನಗೆ ಸಹಾಯ ಮಾಡುವುದಕ್ಕೆ ಸಿದ್ಧರಾಗಿರಿ.<verse eid="PSA 59:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 59:5"/>ಸರ್ವಶಕ್ತರಾದ ಯೆಹೋವ ದೇವರೇ,</para>
  <para style="q2" vid="PSA 59:5">ಇಸ್ರಾಯೇಲರ ದೇವರೇ,</para>
  <para style="q1" vid="PSA 59:5">ನೀವು ಎಲ್ಲಾ ಜನಾಂಗಗಳನ್ನು ನ್ಯಾಯತೀರಿಸುವುದಕ್ಕೆ ಎಚ್ಚರವಾಗಿರಿ.</para>
  <para style="q2" vid="PSA 59:5">ದುಷ್ಟ ಅಪರಾಧಿಗಳಲ್ಲಿ ಯಾರಿಗೂ ದಯೆಸಿಗದಿರಲಿ.<verse eid="PSA 59:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 59:6"/>ಅವರು ಸಂಜೆಗೆ ಹಿಂದಿರುಗುವರು.</para>
  <para style="q2" vid="PSA 59:6">ನಾಯಿಯ ಹಾಗೆ ಬೊಗಳುವರು.</para>
  <para style="q2" vid="PSA 59:6">ಪಟ್ಟಣವನ್ನು ಸುತ್ತುವರು.<verse eid="PSA 59:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 59:7"/>ಇಗೋ, ತಮ್ಮ ಬಾಯಿಂದ ಬೊಗಳುತ್ತಾರೆ.</para>
  <para style="q2" vid="PSA 59:7">ಅವರ ತುಟಿಗಳಲ್ಲಿ ಖಡ್ಗಗಳು ಇವೆ.</para>
  <para style="q2" vid="PSA 59:7">ಅವರು, “ನಮ್ಮನ್ನು ಕೇಳುವವರು ಯಾರು?” ಎಂದು ಅಂದುಕೊಳ್ಳುತ್ತಾರೆ.<verse eid="PSA 59:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 59:8"/>ಆದರೆ ಯೆಹೋವ ದೇವರೇ, ನೀವು ಅವರನ್ನು ನೋಡಿ ನಗುವಿರಿ.</para>
  <para style="q2" vid="PSA 59:8">ಇತರ ಜನಾಂಗವೆಲ್ಲ ಅಪಹಾಸ್ಯಕ್ಕಿಡಾಗಲಿ.<verse eid="PSA 59:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 59:9"/>ದೇವರೇ, ನನ್ನ ಬಲವೇ, ನಿಮಗಾಗಿ ಕಾದುಕೊಂಡಿರುವೆನು.</para>
  <para style="q2" vid="PSA 59:9">ನನ್ನ ದೇವರೇ, ನೀವು ನನ್ನ ಕೋಟೆಯಾಗಿರುವಿರಿ.<verse eid="PSA 59:9"/></para>
  <para style="q2">
    <verse number="10" style="v" sid="PSA 59:10"/>ದೇವರು ಪ್ರಸನ್ನರಾಗಿ ನನ್ನ ಮುಂದೆ ಹೋಗುವರು.</para>
  <para style="b" vid="PSA 59:10"/>
  <para style="q1" vid="PSA 59:10">ದೇವರು ನನ್ನ ನಿಂದಕರ</para>
  <para style="q2" vid="PSA 59:10">ಮೇಲೆ ಜಯಿಸುವಂತೆ ಮಾಡುವರು.<verse eid="PSA 59:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 59:11"/>ನಮ್ಮ ಗುರಾಣಿಯಾಗಿರುವ ಯೆಹೋವ ದೇವರೇ,</para>
  <para style="q2" vid="PSA 59:11">ನನ್ನ ಜನರು ಮರೆಯದ ಹಾಗೆ</para>
  <para style="q1" vid="PSA 59:11">ಅವರು ಉಳಿದಿರಲಿ.</para>
  <para style="q2" vid="PSA 59:11">ನಿಮ್ಮ ಪರಾಕ್ರಮದಿಂದ ಅವರನ್ನು ದಂಡಿಸಿರಿ.<verse eid="PSA 59:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 59:12"/>ಅವರ ಬಾಯಿಯ ಪಾಪಕ್ಕೂ,</para>
  <para style="q2" vid="PSA 59:12">ಅವರ ತುಟಿಗಳ ಮಾತಿಗೂ,</para>
  <para style="q2" vid="PSA 59:12">ಅವರು ನುಡಿಯುವ ಶಾಪಕ್ಕೂ</para>
  <para style="q1" vid="PSA 59:12">ಅವರ ಗರ್ವವೇ ಅವರನ್ನು ಹಿಡಿಯಲಿ.<verse eid="PSA 59:12"/></para>
  <para style="q2">
    <verse number="13" style="v" sid="PSA 59:13"/>ಅವರು ದಂಡನೆಗೆ ತುತ್ತಾಗಲಿ.</para>
  <para style="q2" vid="PSA 59:13">ಅವರು ನಿರ್ನಾಮವಾಗಿಬಿಡಲಿ.</para>
  <para style="q1" vid="PSA 59:13">ಆಗ ಯಾಕೋಬರನ್ನು ಆಳುವವರು</para>
  <para style="q2" vid="PSA 59:13">ದೇವರೇ ಎಂಬುದು ಇಡೀ ಲೋಕಕ್ಕೇ ಗೊತ್ತಾಗಲಿ.<verse eid="PSA 59:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 59:14"/>ಅವರು ಸಂಜೆಗೆ ಹಿಂದಿರುಗುವರು.</para>
  <para style="q2" vid="PSA 59:14">ನಾಯಿಯ ಹಾಗೆ ಬೊಗಳುವರು.</para>
  <para style="q2" vid="PSA 59:14">ಪಟ್ಟಣವನ್ನು ಸುತ್ತುವರು.<verse eid="PSA 59:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 59:15"/>ಅವರು ಆಹಾರಕ್ಕಾಗಿ ಅಲೆದಾಡುವರು.</para>
  <para style="q2" vid="PSA 59:15">ತೃಪ್ತಿಯಾಗದಿದ್ದರೆ ಗೊಣಗುಟ್ಟುವರು.<verse eid="PSA 59:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 59:16"/>ಆದರೆ ನಾನು ನಿಮ್ಮ ಬಲವನ್ನು ಕುರಿತು ಹಾಡುವೆನು.</para>
  <para style="q2" vid="PSA 59:16">ಹೌದು, ಮುಂಜಾನೆ ನಿಮ್ಮ ಪ್ರೀತಿಯ ಕುರಿತು ಹಾಡುವೆನು.</para>
  <para style="q1" vid="PSA 59:16">ಏಕೆಂದರೆ ನೀವು ನನಗೆ ಭದ್ರಕೋಟೆಯೂ,</para>
  <para style="q2" vid="PSA 59:16">ನನ್ನ ಇಕ್ಕಟ್ಟಿನಲ್ಲಿ ಆಶ್ರಯವಾಗಿಯೂ ಇದ್ದೀರಿ.<verse eid="PSA 59:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 59:17"/>ನನ್ನ ಬಲವಾಗಿರುವವರೇ, ನಿಮ್ಮನ್ನು ಕೊಂಡಾಡುವೆನು.</para>
  <para style="q2" vid="PSA 59:17">ಏಕೆಂದರೆ ದೇವರೇ, ನೀವು ನನ್ನ ಭದ್ರಕೋಟೆ ಆಗಿದ್ದೀರಿ.</para>
  <para style="q2" vid="PSA 59:17">ನೀವು ನಾನು ಭರವಸೆ ಇಡುವ ಕರುಣೆಯುಳ್ಳ ದೇವರೂ ಆಗಿದ್ದೀರಿ.<verse eid="PSA 59:17"/></para>
  <chapter eid="PSA 59"/>
  <chapter number="60" style="c" sid="PSA 60"/>
  <para style="cl">ಕೀರ್ತನೆ 60</para>
  <para style="d">ಸಂಗೀತ ನಿರ್ದೇಶಕನಿಗಾಗಿರುವ ಕೀರ್ತನೆ. ಷೂಷನ್ ಎದೂತೆಂಬ ರಾಗವನ್ನು ಆಧರಿಸಿದೆ. ದಾವೀದನ <char style="tl">ಮಿಕ್ಟಮ್</char> ಹಾಡಿನ ಸಂಯೋಜನೆ. ಪರಾಜಿತರು ದೈವೋತ್ತರವನ್ನು ಆಧಾರಮಾಡಿಕೊಂಡು ಪ್ರಾರ್ಥಿಸುವುದು. ಯೋವಾಬನು ಉಪ್ಪಿನ ತಗ್ಗಿನಲ್ಲಿ ಹನ್ನೆರಡು ಸಾವಿರ ಎದೋಮ್ಯರನ್ನು ಹೊಡೆದಾಗ ದಾವೀದನು ರಚಿಸಿದ ಕೀರ್ತನೆ.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 60:1"/>ದೇವರೇ, ನನ್ನನ್ನು ಕೈಬಿಟ್ಟಿದ್ದೀರಾ? ನನ್ನನ್ನು ಚದರಿಸಿದ್ದೀರಾ?</para>
  <para style="q2" vid="PSA 60:1">ನಮ್ಮ ಕಡೆಗೆ ಬೇಸರಗೊಂಡರೂ ನಮ್ಮನ್ನು ಪುನಃ ಸ್ಥಾಪಿಸಿರಿ.<verse eid="PSA 60:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 60:2"/>ದೇಶವು ಕಂಪನಗೊಂಡು ಒಡೆದುಹೋಗಿದೆ.</para>
  <para style="q2" vid="PSA 60:2">ಅದರ ಬಿರುಕುಗಳನ್ನು ಸ್ವಸ್ಥಮಾಡಿರಿ, ಅದು ನಡುಗುತ್ತಿದೆ.<verse eid="PSA 60:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 60:3"/>ನಿಮ್ಮ ಜನರಿಗೆ ಕಠಿಣ ಕಾಲಗಳನ್ನು ನೀವು ತೋರಿಸಿದ್ದೀರಿ.</para>
  <para style="q2" vid="PSA 60:3">ನಾವು ಭ್ರಮಣಗೊಳಿಸುವ ದ್ರಾಕ್ಷಾರಸವನ್ನು ಕುಡಿದವರಂತೆ ಆದೆವು.<verse eid="PSA 60:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 60:4"/>ನಿಮ್ಮ ಭಕ್ತರಿಗೆ ಧ್ವಜವನ್ನು ನಿಲ್ಲಿಸಿದ್ದೀರಿ.</para>
  <para style="q2" vid="PSA 60:4">ಶತ್ರುಗಳ ಬಿಲ್ಲಿನ ವಿರುದ್ಧ ಹಾರಿಸಬಹುದಾದ ಧ್ವಜವನ್ನೇ ನೀಡಿದ್ದೀರಿ.<verse eid="PSA 60:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 60:5"/>ನೀವು ಪ್ರೀತಿಸುವವರು ಬಿಡುಗಡೆಯಾಗುವಂತೆ</para>
  <para style="q2" vid="PSA 60:5">ನಿಮ್ಮ ಬಲಗೈಯಿಂದ ರಕ್ಷಿಸಿ ನಮಗೆ ಸಹಾಯಮಾಡಿರಿ.<verse eid="PSA 60:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 60:6"/>ದೇವರು ತಮ್ಮ ಪರಿಶುದ್ಧ ಸ್ಥಳದಿಂದ ಹೀಗೆ ನುಡಿದಿದ್ದಾರೆ:</para>
  <para style="q2" vid="PSA 60:6">“ನಾನು ಜಯದಿಂದ ಶೆಕೆಮ್ ಪ್ರದೇಶವನ್ನು ಹಂಚುವೆನು.</para>
  <para style="q2" vid="PSA 60:6">ಸುಕ್ಕೋತಿನ ತಗ್ಗನ್ನು ಅಳತೆ ಮಾಡುವೆನು.<verse eid="PSA 60:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 60:7"/>ಗಿಲ್ಯಾದ್ ನನ್ನದು; ಮನಸ್ಸೆ ನನ್ನದು,</para>
  <para style="q2" vid="PSA 60:7">ಎಫ್ರಾಯೀಮ್ ನನ್ನ ಶಿರಸ್ತ್ರಾಣ,</para>
  <para style="q2" vid="PSA 60:7">ಯೆಹೂದವು ನನ್ನ ರಾಜದಂಡ.<verse eid="PSA 60:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 60:8"/>ಮೋವಾಬ್ ನನ್ನ ಸ್ನಾನ ಪಾತ್ರೆಯು,</para>
  <para style="q2" vid="PSA 60:8">ಎದೋಮ್ ನನ್ನ ಕೆರಗಳ ಸ್ಥಳ.</para>
  <para style="q2" vid="PSA 60:8">ಫಿಲಿಷ್ಟಿಯರ ಮೇಲೆ ಜಯೋತ್ಸಾಹ ಮಾಡುವೆನು.”<verse eid="PSA 60:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 60:9"/>ಕೋಟೆಯ ಪಟ್ಟಣಕ್ಕೆ ನನ್ನನ್ನು ಕರೆತರುವವರು ಯಾರು?</para>
  <para style="q2" vid="PSA 60:9">ಎದೋಮಿಗೆ ನನ್ನನ್ನು ನಡೆಸುವವರು ಯಾರು?<verse eid="PSA 60:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 60:10"/>ದೇವರೇ, ಈಗ ನೀವು</para>
  <para style="q2" vid="PSA 60:10">ನಮ್ಮ ಸೈನ್ಯಗಳ ಸಂಗಡ ಹೊರಡುವುದಿಲ್ಲವೋ ನಮ್ಮನ್ನು ಕೈಬಿಟ್ಟಿದ್ದೀರೋ?<verse eid="PSA 60:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 60:11"/>ವೈರಿಗಳ ವಿರೋಧ ನಮಗೆ ಸಹಾಯಮಾಡಿರಿ.</para>
  <para style="q2" vid="PSA 60:11">ಮನುಷ್ಯರ ಸಹಾಯವು ವ್ಯರ್ಥ.<verse eid="PSA 60:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 60:12"/>ದೇವರಿಂದ ನಾವು ಜಯ ಹೊಂದುವೆವು.</para>
  <para style="q2" vid="PSA 60:12">ದೇವರೇ ನಮ್ಮ ವೈರಿಗಳನ್ನು ತುಳಿದುಬಿಡುವರು.<verse eid="PSA 60:12"/></para>
  <chapter eid="PSA 60"/>
  <chapter number="61" style="c" sid="PSA 61"/>
  <para style="cl">ಕೀರ್ತನೆ 61</para>
  <para style="d">ಸಂಗೀತ ನಿರ್ದೇಶಕನಿಗಾಗಿರುವ ಕೀರ್ತನೆ. ತಂತಿವಾದ್ಯದೊಡನೆ ಹಾಡತಕ್ಕದ್ದು. ದಾವೀದನ ಕೀರ್ತನೆ.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 61:1"/>ದೇವರೇ, ನನ್ನ ಮೊರೆಯನ್ನು ಕೇಳಿರಿ.</para>
  <para style="q2" vid="PSA 61:1">ನನ್ನ ಪ್ರಾರ್ಥನೆಯನ್ನು ಆಲಿಸಿರಿ.<verse eid="PSA 61:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 61:2"/>ನನ್ನ ಹೃದಯವು ಕುಂದಿ ಹೋಗಿರಲಾಗಿ</para>
  <para style="q2" vid="PSA 61:2">ಭೂಮಿಯ ಅಂತ್ಯದಿಂದ ನಿಮಗೆ ಮೊರೆಯಿಡುತ್ತಿರುವೆನು.</para>
  <para style="q2" vid="PSA 61:2">ನನಗಿಂತ ಎತ್ತರವಾದ ಬಂಡೆಗೆ ನನ್ನನ್ನು ನಡೆಸಿರಿ.<verse eid="PSA 61:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 61:3"/>ನೀವೇ ನನಗೆ ಆಶ್ರಯವಾಗಿದ್ದೀರಿ.</para>
  <para style="q2" vid="PSA 61:3">ಶತ್ರುವಿಗೆ ಎದುರಾಗಿ ಬಲವಾದ ಬುರುಜಾಗಿದ್ದೀರಿ.<verse eid="PSA 61:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 61:4"/>ನಿಮ್ಮ ಗುಡಾರದಲ್ಲಿ ನಿತ್ಯವಾಗಿ ನಿವಾಸಿಸಲು ಹಾರೈಸುತ್ತಿದ್ದೇನೆ.</para>
  <para style="q2" vid="PSA 61:4">ನಿಮ್ಮ ರೆಕ್ಕೆಗಳ ಮರೆಯನ್ನು ಆಶ್ರಯಿಸಿಕೊಳ್ಳುವೆನು.<verse eid="PSA 61:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 61:5"/>ದೇವರೇ, ನೀವು ನನ್ನ ಹರಕೆಗಳನ್ನು ಕೇಳಿದ್ದೀರಿ.</para>
  <para style="q2" vid="PSA 61:5">ನಿಮ್ಮ ಹೆಸರಿಗೆ ಭಯಪಡುವವರಿಗೆ ಕೊಡುವ ಸೊತ್ತನ್ನು ನನಗೂ ಕೊಟ್ಟಿದ್ದೀರಿ.<verse eid="PSA 61:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 61:6"/>ಅರಸನ ಜೀವನದ ದಿನಗಳನ್ನು ಹೆಚ್ಚಿಸಿರಿ.</para>
  <para style="q2" vid="PSA 61:6">ಆತನ ವರ್ಷಗಳನ್ನು ತಲತಲಾಂತರಗಳವರೆಗೆ ವೃದ್ಧಿಪಡಿಸಿರಿ.<verse eid="PSA 61:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 61:7"/>ಆತನು ಎಂದೆಂದಿಗೂ ದೇವರ ಮುಂದೆ ಆಳಿಕೆಮಾಡಲಿ.</para>
  <para style="q2" vid="PSA 61:7">ಆತನನ್ನು ಕಾಯುವ ಹಾಗೆ ನಿಮ್ಮ ಪ್ರೀತಿ, ಸತ್ಯವನ್ನು ನೇಮಿಸಿರಿ.<verse eid="PSA 61:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 61:8"/>ಆಗ ನಾನು ನನ್ನ ಹರಕೆಗಳನ್ನು ದಿನದಿನವೂ ಸಲ್ಲಿಸುವೆನು.</para>
  <para style="q2" vid="PSA 61:8">ನಿಮ್ಮ ಹೆಸರನ್ನು ನಾನು ಎಂದೆಂದಿಗೂ ಕೀರ್ತಿಸುವೆನು.<verse eid="PSA 61:8"/></para>
  <chapter eid="PSA 61"/>
  <chapter number="62" style="c" sid="PSA 62"/>
  <para style="cl">ಕೀರ್ತನೆ 62</para>
  <para style="d">ಸಂಗೀತ ನಿರ್ದೇಶಕನಿಗಾಗಿರುವ ಕೀರ್ತನೆ. ಯೆದುತೂನನ ರೀತಿಯಲ್ಲಿ ಹಾಡತಕ್ಕದ್ದು; ದಾವೀದನ ಕೀರ್ತನೆ.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 62:1"/>ದೇವರಲ್ಲಿಯೇ ನನ್ನ ಪ್ರಾಣಕ್ಕೆ ಶಾಂತಿ,</para>
  <para style="q2" vid="PSA 62:1">ನನ್ನ ರಕ್ಷಣೆಯು ದೇವರಿಂದಲೇ.<verse eid="PSA 62:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 62:2"/>ದೇವರು ಮಾತ್ರವೇ ನನ್ನ ಬಂಡೆಯೂ ನನ್ನ ರಕ್ಷಣೆಯೂ,</para>
  <para style="q2" vid="PSA 62:2">ನನ್ನ ಕೋಟೆಯೂ ಆಗಿದ್ದಾರೆ. ನಾನೆಂದಿಗೂ ಕದಲೆನು.<verse eid="PSA 62:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 62:3"/>ಹಾನಿಮಾಡುವವರೇ, ಎಷ್ಟರವರೆಗೆ ನೀವು ದಾಳಿಮಾಡುವಿರಿ.</para>
  <para style="q2" vid="PSA 62:3">ಬಾಗುವ ಗೋಡೆಯಂತೆಯೂ,</para>
  <para style="q2" vid="PSA 62:3">ಅಲ್ಲಾಡುವ ಬೇಲಿಯಂತೆಯೂ ನನ್ನನ್ನು ಕೆಡವಲು ಯತ್ನಿಸುವಿರಾ?<verse eid="PSA 62:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 62:4"/>ಅವರು ನನ್ನನ್ನು ಉನ್ನತ ಸ್ಥಾನದಿಂದ ದಬ್ಬುವುದಕ್ಕೆ ಆಲೋಚಿಸುತ್ತಿದ್ದಾರೆ.</para>
  <para style="q2" vid="PSA 62:4">ಅವರು ಸುಳ್ಳನ್ನು ಇಷ್ಟಪಡುತ್ತಾರೆ;</para>
  <para style="q2" vid="PSA 62:4">ತಮ್ಮ ಬಾಯಿಂದ ಆಶೀರ್ವದಿಸಿ, ಹೃದಯದಲ್ಲಿ ಶಪಿಸುತ್ತಾರೆ.<verse eid="PSA 62:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 62:5"/>ಹೌದು, ದೇವರಲ್ಲಿಯೇ ನನ್ನ ಪ್ರಾಣಕ್ಕೆ ಶಾಂತಿ.</para>
  <para style="q2" vid="PSA 62:5">ನನ್ನ ನಿರೀಕ್ಷೆಯು ದೇವರಿಂದಲೇ.<verse eid="PSA 62:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 62:6"/>ದೇವರೇ ನನ್ನ ಬಂಡೆಯೂ ನನ್ನ ರಕ್ಷಣೆಯೂ,</para>
  <para style="q2" vid="PSA 62:6">ನನ್ನ ಕೋಟೆಯೂ ಆಗಿದ್ದಾರೆ. ನಾನೆಂದಿಗೂ ಕದಲೆನು.<verse eid="PSA 62:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 62:7"/>ದೇವರು ನನ್ನ ರಕ್ಷಣೆಗೂ ನನ್ನ ಗೌರವಕ್ಕೂ ಆಧಾರವಾಗಿದ್ದಾರೆ.</para>
  <para style="q2" vid="PSA 62:7">ದೇವರು ನನ್ನ ಬಲವಾದ ಬಂಡೆಯೂ ನನ್ನ ಆಶ್ರಯವೂ ಆಗಿದ್ದಾರೆ.<verse eid="PSA 62:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 62:8"/>ಜನರೇ, ಎಲ್ಲಾ ಕಾಲದಲ್ಲಿಯೂ ದೇವರಲ್ಲಿ ಭರವಸೆ ಇಡಿರಿ.</para>
  <para style="q2" vid="PSA 62:8">ನಿಮ್ಮ ಹೃದಯವನ್ನು ದೇವರ ಮುಂದೆ ಒಯ್ಯಿರಿ.</para>
  <para style="q2" vid="PSA 62:8">ದೇವರು ನಮಗೆ ಆಶ್ರಯವಾಗಿದ್ದಾರೆ.<verse eid="PSA 62:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 62:9"/>ಸಾಮಾನ್ಯ ಜನರು ಬರೀ ಉಸಿರೇ,</para>
  <para style="q2" vid="PSA 62:9">ಉನ್ನತ ಜನರು ಬರೀ ಸುಳ್ಳೇ.</para>
  <para style="q1" vid="PSA 62:9">ತಕ್ಕಡಿಯಲ್ಲಿ ತೂಗಿದರೆ ಅವರೇನೂ ಇಲ್ಲ,</para>
  <para style="q2" vid="PSA 62:9">ಎಲ್ಲರೂ ಬರೀ ಉಸಿರೇ.<verse eid="PSA 62:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 62:10"/>ಅನ್ಯಾಯದ ಸುಲಿಗೆಯಲ್ಲಿ</para>
  <para style="q2" vid="PSA 62:10">ಭರವಸೆ ಇಡಬೇಡಿರಿ.</para>
  <para style="q1" vid="PSA 62:10">ಸೂರೆಮಾಡಿದ್ದರಲ್ಲಿ ಗರ್ವಪಡಬೇಡಿರಿ.</para>
  <para style="q2" vid="PSA 62:10">ಆಸ್ತಿಯು ಹೆಚ್ಚಾದರೆ ಅದರ ಮೇಲೆ ಮನಸ್ಸಿಡಬೇಡಿರಿ.<verse eid="PSA 62:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 62:11"/>ಒಂದು ಸಾರಿ ದೇವರು ಮಾತನಾಡಿದ್ದಾರೆ.</para>
  <para style="q2" vid="PSA 62:11">ನಾನು ಎರಡು ಸಾರಿ ಇದನ್ನು ಹೀಗೆಂದು ಕೇಳಿದ್ದೇನೆ:</para>
  <para style="q1" vid="PSA 62:11">“ದೇವರೇ, ಶಕ್ತಿಯು ನಿಮಗೇ ಸೇರಿದೆ.<verse eid="PSA 62:11"/></para>
  <para style="q2">
    <verse number="12" style="v" sid="PSA 62:12"/>ಯೆಹೋವ ದೇವರೇ, ನಿಮ್ಮಲ್ಲಿ ಒಡಂಬಡಿಕೆಯ ಪ್ರೀತಿ ಇದೆ.</para>
  <para style="q1" vid="PSA 62:12">ನೀವು ಪ್ರತಿ ಮನುಷ್ಯನಿಗೂ</para>
  <para style="q2" vid="PSA 62:12">ಅವನ ಕೃತ್ಯಕ್ಕೆ ತಕ್ಕ ಪ್ರತಿಫಲ ಕೊಡುತ್ತೀರಿ.”<verse eid="PSA 62:12"/></para>
  <chapter eid="PSA 62"/>
  <chapter number="63" style="c" sid="PSA 63"/>
  <para style="cl">ಕೀರ್ತನೆ 63</para>
  <para style="d">ದಾವೀದನು ಯೆಹೂದ ಸೀಮೆಯ ಅರಣ್ಯದಲ್ಲಿದ್ದಾಗ ರಚಿಸಿದ ಕೀರ್ತನೆ.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 63:1"/>ದೇವರೇ, ನನ್ನ ದೇವರು ನೀವೇ,</para>
  <para style="q2" vid="PSA 63:1">ನಿಮ್ಮನ್ನು ಕುತೂಹಲದಿಂದ ಹುಡುಕುತ್ತಿದ್ದೇನೆ.</para>
  <para style="q1" vid="PSA 63:1">ನಾನು ನಿಮಗಾಗಿ ದಾಹಗೊಂಡಿದ್ದೇನೆ.</para>
  <para style="q2" vid="PSA 63:1">ನೀರಿಲ್ಲದೆ ಭೂಮಿಯಲ್ಲಿದ್ದವನು ಹೇಗೆ ನೀರಿಗಾಗಿ ಹಾತೊರೆವಂತೆ</para>
  <para style="q1" vid="PSA 63:1">ನನ್ನ ಇಡೀ ಸರ್ವಸ್ವವೂ ನಿಮಗಾಗಿ ದಾಹಗೊಂಡಿರುತ್ತದೆ.</para>
  <para style="q2" vid="PSA 63:1">ನಾನು ನಿಮ್ಮನ್ನೇ ಅಪೇಕ್ಷಿಸುತ್ತಿದ್ದೇನೆ.<verse eid="PSA 63:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 63:2"/>ನಾನು ನಿಮ್ಮ ಶಕ್ತಿಯನ್ನೂ ನಿಮ್ಮ ಮಹಿಮೆಯನ್ನೂ ಪರಿಶುದ್ಧ ಸ್ಥಳದಲ್ಲಿ ಕಂಡಿದ್ದೇನೆ.</para>
  <para style="q2" vid="PSA 63:2">ಹೌದು, ನಾನು ನಿಮ್ಮನ್ನೇ ದೃಷ್ಟಿಸಿದ್ದೇನೆ.<verse eid="PSA 63:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 63:3"/>ನಿಮ್ಮ ಪ್ರೀತಿಯು ಜೀವಕ್ಕಿಂತ ಶ್ರೇಷ್ಠವಾದದ್ದು.</para>
  <para style="q2" vid="PSA 63:3">ನನ್ನ ತುಟಿ ನಿಮ್ಮನ್ನು ಮಹಿಮೆಪಡಿಸುವುದು.<verse eid="PSA 63:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 63:4"/>ನಾನು ಜೀವಿಸುವ ಕಾಲವೆಲ್ಲಾ ನಿಮ್ಮನ್ನೇ ಸ್ತುತಿಸುವೆನು.</para>
  <para style="q2" vid="PSA 63:4">ನಿಮ್ಮ ಹೆಸರಿನಲ್ಲಿ ನಾನು ನನ್ನ ಕೈ ಮುಗಿಯುವೆನು.<verse eid="PSA 63:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 63:5"/>ಮೃಷ್ಟ ಭೋಜನದಿಂದಲೋ ಎಂಬಂತೆ ನಾನು ನಿಮ್ಮಲ್ಲಿ ಸಂತೃಪ್ತನಾಗಿದ್ದೇನೆ.</para>
  <para style="q2" vid="PSA 63:5">ಉತ್ಸಾಹದ ತುಟಿಗಳಿಂದ ನನ್ನ ಬಾಯಿಯು ನಿಮ್ಮನ್ನು ಸ್ತುತಿಸುವುದು.<verse eid="PSA 63:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 63:6"/>ನನ್ನ ಹಾಸಿಗೆಯ ಮೇಲೆ ನಿಮ್ಮನ್ನು ಸ್ಮರಿಸುವಾಗ</para>
  <para style="q2" vid="PSA 63:6">ರಾತ್ರಿಯ ಜಾವಗಳಲ್ಲಿ ನಿಮ್ಮನ್ನು ಧ್ಯಾನಿಸುತ್ತಿರುವೆನು.<verse eid="PSA 63:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 63:7"/>ಏಕೆಂದರೆ ನೀವೇ ನನಗೆ ಸಹಾಯಕರಾಗಿದ್ದೀರಿ.</para>
  <para style="q2" vid="PSA 63:7">ನಿಮ್ಮ ರೆಕ್ಕೆಗಳ ನೆರಳಿನಲ್ಲಿ ಹಾಡುತ್ತಿರುವೆನು.<verse eid="PSA 63:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 63:8"/>ನನ್ನ ಪ್ರಾಣವು ನಿಮ್ಮನ್ನು ಆತುಕೊಂಡಿದೆ.</para>
  <para style="q2" vid="PSA 63:8">ನಿಮ್ಮ ಬಲಗೈ ನನಗೆ ಬೆಂಬಲವಾಗಿದೆ.<verse eid="PSA 63:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 63:9"/>ನನ್ನ ಪ್ರಾಣಕ್ಕೆ ಕೇಡು ಬಯಸುವವರು ತಾವೇ ನಾಶವಾಗುವರು</para>
  <para style="q2" vid="PSA 63:9">ಅವರು ಭೂಮಿಯ ಆಳಕ್ಕೆ ಹೋಗುವರು.<verse eid="PSA 63:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 63:10"/>ಖಡ್ಗದಿಂದ ಅವರು ಬೀಳುವರು.</para>
  <para style="q2" vid="PSA 63:10">ನರಿಗಳಿಗೆ ಆಹಾರವಾಗುವರು.<verse eid="PSA 63:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 63:11"/>ಆದರೆ ಅರಸನು ದೇವರಲ್ಲಿ ಸಂತೋಷಿಸುವನು.</para>
  <para style="q2" vid="PSA 63:11">ದೇವರ ಪ್ರತಿಜ್ಞೆ ಹೊಂದಿದವರು ದೇವರನ್ನು ಮಹಿಮೆಪಡಿಸುವರು.</para>
  <para style="q2" vid="PSA 63:11">ಆದರೆ ಸುಳ್ಳಾಡುವವರ ಬಾಯಿ ಮುಚ್ಚಿಹೋಗುವುದು.<verse eid="PSA 63:11"/></para>
  <chapter eid="PSA 63"/>
  <chapter number="64" style="c" sid="PSA 64"/>
  <para style="cl">ಕೀರ್ತನೆ 64</para>
  <para style="d">ಸಂಗೀತ ನಿರ್ದೇಶಕನಿಗಾಗಿರುವ ಕೀರ್ತನೆ. ದಾವೀದನ ಕೀರ್ತನೆ.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 64:1"/>ದೇವರೇ, ನನ್ನ ದೂರುಗಳನ್ನು ನಿಮ್ಮ ಮುಂದಿಡುವಾಗ ನನ್ನ ಬಿನ್ನಹವನ್ನು ಕೇಳಿರಿ.</para>
  <para style="q2" vid="PSA 64:1">ಶತ್ರುವಿನ ಹೆದರಿಕೆಯಿಂದ ನನ್ನ ಜೀವವನ್ನು ಕಾಪಾಡಿರಿ.<verse eid="PSA 64:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 64:2"/>ದುರ್ಮಾರ್ಗಿಗಳ ಗುಪ್ತ ಆಲೋಚನೆಗಳಿಗೂ,</para>
  <para style="q2" vid="PSA 64:2">ದುಷ್ಟರ ಒಳಸಂಚಿಗೂ ನನ್ನನ್ನು ಮರೆಮಾಡಿರಿ.<verse eid="PSA 64:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 64:3"/>ಅವರು ತಮ್ಮ ನಾಲಿಗೆಯನ್ನು</para>
  <para style="q2" vid="PSA 64:3">ಖಡ್ಗದಂತೆ ಮಸೆಯುತ್ತಾರೆ.<verse eid="PSA 64:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 64:4"/>ನಿರ್ದೋಷಿಯ ಕಡೆಗೆ ಕಹಿಮಾತುಗಳನ್ನು ಬಾಣದಂತೆ ಗುರಿಯಿಟ್ಟಿದ್ದಾರೆ.</para>
  <para style="q2" vid="PSA 64:4">ಅಂಜದೆ ಫಕ್ಕನೆ ಅವನ ಕಡೆಗೆ ಎಸೆಯುತ್ತಾರೆ.<verse eid="PSA 64:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 64:5"/>ತಮ್ಮೊಳಗೆ ಕೇಡನ್ನು ಪ್ರೋತ್ಸಾಹ ಮಾಡುತ್ತಾರೆ.</para>
  <para style="q2" vid="PSA 64:5">ರಹಸ್ಯವಾಗಿ ಬಲೆಗಳನ್ನು ಒಡ್ಡುವುದಕ್ಕೆ ಮಾತನಾಡುತ್ತಾ,</para>
  <para style="q2" vid="PSA 64:5">“ನಮ್ಮನ್ನು ಕಾಣುವವರು ಯಾರು?” ಎಂದುಕೊಳ್ಳುತ್ತಾರೆ.<verse eid="PSA 64:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 64:6"/>ಅವರು ಅನ್ಯಾಯಗಳನ್ನು ಕಲ್ಪಿಸಿ,</para>
  <para style="q2" vid="PSA 64:6">“ನಾವು ಒಳ್ಳೇ ಉಪಾಯವನ್ನು ಮಾಡಿದ್ದೇವೆ,” ಅಂದುಕೊಳ್ಳುತ್ತಾರೆ.</para>
  <para style="q2" vid="PSA 64:6">ನಿಶ್ಚಯವಾಗಿ ಮಾನವರ ಆಂತರ್ಯವೂ ಹೃದಯವೂ ಕುಯುಕ್ತಿಯಿಂದ ಕೂಡಿದೆ.<verse eid="PSA 64:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 64:7"/>ಆದರೆ ದೇವರು ಅವರ ಬಾಣದಿಂದಲೇ,</para>
  <para style="q2" vid="PSA 64:7">ಫಕ್ಕನೆ ಅವರಿಗೆ ಗಾಯಗಳಾಗುವಂತೆ ಅನುಮತಿಸುವರು.<verse eid="PSA 64:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 64:8"/>ಹೀಗೆ ಅವರು ತಮ್ಮ ನಾಲಿಗೆಯಿಂದ ತಾವೇ ಎಡವಿ</para>
  <para style="q2" vid="PSA 64:8">ಬೀಳುವಂತೆ ಮಾಡಿಕೊಳ್ಳುವರು.</para>
  <para style="q2" vid="PSA 64:8">ಅವರನ್ನು ಕಾಣುವವರೆಲ್ಲರೂ ತಲೆಯಾಡಿಸಿ ಅಣಕಿಸುವರು.<verse eid="PSA 64:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 64:9"/>ಎಲ್ಲಾ ಮನುಷ್ಯರೂ ಭಯಪಟ್ಟು</para>
  <para style="q2" vid="PSA 64:9">ದೇವರ ಕಾರ್ಯಗಳನ್ನು ಸಾರುವರು.</para>
  <para style="q2" vid="PSA 64:9">ದೇವರು ಮಾಡಿದವುಗಳನ್ನು ಆಲೋಚಿಸಿಕೊಳ್ಳುವರು.<verse eid="PSA 64:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 64:10"/>ನೀತಿವಂತರು ಯೆಹೋವ ದೇವರಲ್ಲಿ ಆನಂದಪಟ್ಟು</para>
  <para style="q2" vid="PSA 64:10">ದೇವರನ್ನೇ ಆಶ್ರಯಿಸಿಕೊಳ್ಳುವರು.</para>
  <para style="q2" vid="PSA 64:10">ಸರಳ ಹೃದಯದವರೆಲ್ಲರೂ ದೇವರನ್ನು ಮಹಿಮೆಪಡಿಸುವರು.<verse eid="PSA 64:10"/></para>
  <chapter eid="PSA 64"/>
  <chapter number="65" style="c" sid="PSA 65"/>
  <para style="cl">ಕೀರ್ತನೆ 65</para>
  <para style="d">ಸಂಗೀತ ನಿರ್ದೇಶಕನಿಗಾಗಿರುವ ಕೀರ್ತನೆ. ದಾವೀದನ ಕೀರ್ತನೆ. ಒಂದು ಗೀತೆ.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 65:1"/>ದೇವರೇ, ಚೀಯೋನಿನಲ್ಲಿ ನಿಮಗೋಸ್ಕರ ಸ್ತೋತ್ರವು ಕಾದಿದೆ.</para>
  <para style="q2" vid="PSA 65:1">ನಿಮಗೆ ನಮ್ಮ ಹರಕೆಗಳನ್ನು ಪೂರೈಸುವೆವು.<verse eid="PSA 65:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 65:2"/>ಪ್ರಾರ್ಥನೆಯನ್ನು ಕೇಳುವವರೇ,</para>
  <para style="q2" vid="PSA 65:2">ಎಲ್ಲಾ ಜನರು ನಿಮ್ಮ ಬಳಿಗೆ ಬರುವರು.<verse eid="PSA 65:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 65:3"/>ನಾವು ನಮ್ಮ ಪಾಪಗಳಿಂದ ತುಂಬಿಹೋಗಿರುವಾಗ</para>
  <para style="q2" vid="PSA 65:3">ನೀವೇ ನಮ್ಮ ದ್ರೋಹಗಳಿಗಾಗಿ ದೋಷಪರಿಹಾರಕರು.<verse eid="PSA 65:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 65:4"/>ನೀವು ಆಯ್ದುಕೊಂಡು ನಿಮ್ಮ ಬಳಿಗೆ ಬರಮಾಡಿಕೊಳ್ಳುವವನು ಧನ್ಯನು.</para>
  <para style="q2" vid="PSA 65:4">ಏಕೆಂದರೆ ನಿಮ್ಮ ಅಂಗಳಗಳಲ್ಲಿ ಅವನು ವಾಸವಾಗಿರುವನು.</para>
  <para style="q1" vid="PSA 65:4">ನಿಮ್ಮ ಪರಿಶುದ್ಧ ಮಂದಿರವಾದ</para>
  <para style="q2" vid="PSA 65:4">ನಿಮ್ಮ ಆಲಯದ ಒಳ್ಳೆಯ ಸಂಗತಿಗಳಿಂದ ನಮಗೆ ತೃಪ್ತಿಯಾಗಲಿ.<verse eid="PSA 65:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 65:5"/>ಅತಿಶಯ ಹಾಗು ನೀತಿಯ ಕೃತ್ಯಗಳನ್ನು ನಡೆಸಿ,</para>
  <para style="q2" vid="PSA 65:5">ನೀವು ನಮಗೆ ಉತ್ತರ ಕೊಡುವಿರಿ.</para>
  <para style="q1" vid="PSA 65:5">ನಮ್ಮ ರಕ್ಷಣೆಯ ದೇವರೇ, ಭೂಮಿಯಲ್ಲಿರುವವರಿಗೂ,</para>
  <para style="q2" vid="PSA 65:5">ಸಮುದ್ರದ ಆಚೆ ದೂರವಾಗಿರುವವರಿಗೂ ನೀವು ಭರವಸೆಯಾಗಿದ್ದೀರಿ.<verse eid="PSA 65:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 65:6"/>ಬೆಟ್ಟಗಳನ್ನು ನಿಮ್ಮ ಶಕ್ತಿಯಿಂದ ರೂಪಿಸಿದವರು ನೀವೇ.</para>
  <para style="q2" vid="PSA 65:6">ಜಲದಿಂದ ನಡು ಕಟ್ಟಿಕೊಂಡಿರುವವರೂ ನೀವೇ.<verse eid="PSA 65:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 65:7"/>ಸಮುದ್ರಗಳ ಘೋಷವನ್ನೂ,</para>
  <para style="q2" vid="PSA 65:7">ಅವುಗಳ ತೆರೆಗಳ ಘೋಷವನ್ನೂ,</para>
  <para style="q2" vid="PSA 65:7">ಪ್ರಜೆಗಳ ಕೋಲಾಹಲವನ್ನೂ ಶಮನಗೊಳಿಸುವವರು ನೀವೇ.<verse eid="PSA 65:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 65:8"/>ಇಡೀ ಭೂಮಿಯಲ್ಲಿರುವವರು ನಿಮ್ಮ ಅದ್ಭುತಕಾರ್ಯಗಳಿಗೆ ಅತಿಶಯಗೊಂಡಿದ್ದಾರೆ.</para>
  <para style="q2" vid="PSA 65:8">ಉದಯಾಸ್ತಮಾನಗಳಲ್ಲಿ ಇರುವವರನ್ನು</para>
  <para style="q2" vid="PSA 65:8">ಉತ್ಸಾಹ ಧ್ವನಿಗೈಯುವಂತೆ ಮಾಡುತ್ತೀರಿ.<verse eid="PSA 65:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 65:9"/>ಭೂಮಿಯನ್ನು ಸಂಧಿಸಿ, ಅದಕ್ಕೆ ಮಳೆಬರುವಂತೆ,</para>
  <para style="q2" vid="PSA 65:9">ಅದನ್ನು ಫಲವತ್ತಾಗಿ ಮಾಡುತ್ತೀರಿ.</para>
  <para style="q1" vid="PSA 65:9">ದೇವರ ನದಿಯು ನೀರಿನಿಂದ ತುಂಬಿದೆ.</para>
  <para style="q2" vid="PSA 65:9">ಹೀಗೆ ಭೂಮಿಯನ್ನು ಸಿದ್ಧಮಾಡಿ,</para>
  <para style="q2" vid="PSA 65:9">ಜನರಿಗೆ ನೀವು ಧಾನ್ಯವನ್ನು ಒದಗಿಸುತ್ತೀರಿ.<verse eid="PSA 65:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 65:10"/>ನೇಗಿಲ ಸಾಲುಗಳನ್ನು ಸಮಮಾಡುತ್ತೀರಿ.</para>
  <para style="q2" vid="PSA 65:10">ಸುರಿಯುವ ಮಳೆಯಿಂದ ಅದನ್ನು ಮೃದು ಮಾಡುತ್ತೀರಿ, ಅದರ ಮೊಳಕೆಯನ್ನು ಆಶೀರ್ವದಿಸುತ್ತೀರಿ.<verse eid="PSA 65:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 65:11"/>ವರ್ಷಕ್ಕೆ ನಿಮ್ಮ ಉದಾರತೆಯ ಕಿರೀಟವನ್ನು ಇಡುತ್ತೀರಿ.</para>
  <para style="q2" vid="PSA 65:11">ನಿಮ್ಮ ಹಾದಿಗಳು ಸಮೃದ್ಧಿಯಿಂದ ತುಂಬಿ ಪ್ರವಾಹಿಸುತ್ತಿದೆ.<verse eid="PSA 65:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 65:12"/>ಮರುಭೂಮಿಯ ಹುಲ್ಲುಗಾವಲಲ್ಲಿ ವೃಷ್ಟಿಯಾಗಿದೆ.</para>
  <para style="q2" vid="PSA 65:12">ಗುಡ್ಡಗಳು ಉಲ್ಲಾಸವನ್ನು ಧರಿಸಿಕೊಂಡಿವೆ.<verse eid="PSA 65:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 65:13"/>ಹುಲ್ಲುಗಾವಲುಗಳು ಮಂದೆಗಳಿಂದ ಹೊದಿಕೆಯಾಗಿವೆ.</para>
  <para style="q2" vid="PSA 65:13">ಕಣಿವೆಗಳು ಸಹ ಧಾನ್ಯದಿಂದ ಮುಚ್ಚಿರುತ್ತವೆ.</para>
  <para style="q2" vid="PSA 65:13">ಅವು ಉತ್ಸಾಹಗೊಂಡು ಹಾಡುತ್ತವೆ.<verse eid="PSA 65:13"/></para>
  <chapter eid="PSA 65"/>
  <chapter number="66" style="c" sid="PSA 66"/>
  <para style="cl">ಕೀರ್ತನೆ 66</para>
  <para style="d">ಸಂಗೀತ ನಿರ್ದೇಶಕನಿಗಾಗಿರುವ ಕೀರ್ತನೆ. ಒಂದು ಗೀತೆ. ಒಂದು ಕೀರ್ತನೆ.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 66:1"/>ಸಮಸ್ತ ದೇಶಗಳೇ, ದೇವರಿಗೆ ಉತ್ಸಾಹಧ್ವನಿ ಮಾಡಿರಿ.<verse eid="PSA 66:1"/></para>
  <para style="q2">
    <verse number="2" style="v" sid="PSA 66:2"/>ದೇವರ ಹೆಸರಿನ ಮಹಿಮೆಯನ್ನು ಕೊಂಡಾಡಿರಿ.</para>
  <para style="q2" vid="PSA 66:2">ದೇವರ ಸ್ತೋತ್ರವನ್ನು ಘನವುಳ್ಳದ್ದಾಗಿ ಮಾಡಿರಿ.<verse eid="PSA 66:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 66:3"/>ನೀವು ದೇವರಿಗೆ, “ನಿಮ್ಮ ಕೃತ್ಯಗಳು ಅತಿಶಯವಾದವುಗಳಾಗಿವೆ.</para>
  <para style="q2" vid="PSA 66:3">ನಿಮ್ಮ ಶತ್ರುಗಳು ನಿಮ್ಮೆದುರಿನಲ್ಲಿ ಮುದುರಿ ಬೀಳುವಷ್ಟು</para>
  <para style="q2" vid="PSA 66:3">ನಿಮ್ಮ ಶಕ್ತಿ ದೊಡ್ಡದಾಗಿದೆ.<verse eid="PSA 66:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 66:4"/>ಭೂಮಿಯೆಲ್ಲಾ ನಿಮ್ಮನ್ನು ಆರಾಧಿಸುವುದು.</para>
  <para style="q2" vid="PSA 66:4">ನಿಮ್ಮನ್ನು ಕೀರ್ತಿಸುತ್ತಾ</para>
  <para style="q2" vid="PSA 66:4">ಲೋಕವು ನಿಮ್ಮ ನಾಮವನ್ನು ಕೀರ್ತಿಸುತ್ತಿರುವುದು,” ಎಂದು ಹೇಳಿರಿ.<verse eid="PSA 66:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 66:5"/>ಬನ್ನಿರಿ, ದೇವರ ಕಾರ್ಯಗಳನ್ನು ನೋಡಿರಿ.</para>
  <para style="q2" vid="PSA 66:5">ಮಾನವರ ಪರವಾಗಿ ಮಾಡಿರುವ ದೇವರ ಕಾರ್ಯಗಳು ಅತಿಶಯವಾಗಿವೆ.<verse eid="PSA 66:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 66:6"/>ದೇವರು ಸಮುದ್ರವನ್ನು ಒಣ ಭೂಮಿಯನ್ನಾಗಿ ಮಾಡಿದರು.</para>
  <para style="q2" vid="PSA 66:6">ಜನರು ಕಾಲಿನಿಂದ ನದಿಯನ್ನು ದಾಟಿದರು.</para>
  <para style="q2" vid="PSA 66:6">ಬನ್ನಿರಿ, ದೇವರಲ್ಲಿ ಆನಂದಿಸೋಣ.<verse eid="PSA 66:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 66:7"/>ದೇವರು ತಮ್ಮ ಶಕ್ತಿಯಿಂದ ಎಂದೆಂದಿಗೂ ಆಳುವವರಾಗಿದ್ದಾರೆ.</para>
  <para style="q2" vid="PSA 66:7">ದೇವರ ಕಣ್ಣುಗಳು ಜನಾಂಗಗಳನ್ನು ದೃಷ್ಟಿಸುತ್ತವೆ;</para>
  <para style="q2" vid="PSA 66:7">ದೇವರಿಗೆ ವಿರೋಧವಾಗಿ ದಂಗೆಕೋರರು ಏಳದಿರಲಿ.<verse eid="PSA 66:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 66:8"/>ಸಮಸ್ತ ಜನರೇ, ನೀವು ನಮ್ಮ ದೇವರನ್ನು ಸ್ತುತಿಸಿರಿ.</para>
  <para style="q2" vid="PSA 66:8">ದೇವರನ್ನು ಸ್ತುತಿಸುವ ಶಬ್ದವು ಕೇಳಿಸಲಿ.<verse eid="PSA 66:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 66:9"/>ದೇವರು ನಮ್ಮ ಜೀವನವನ್ನು ಕಾಪಾಡಿ,</para>
  <para style="q2" vid="PSA 66:9">ನಮ್ಮ ಕಾಲು ಎಡವದಂತೆ ಮಾಡಿದ್ದಾರೆ.<verse eid="PSA 66:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 66:10"/>ದೇವರೇ, ನೀವು ನಮ್ಮನ್ನು ಪರಿಶೋಧಿಸಿದ್ದೀರಿ.</para>
  <para style="q2" vid="PSA 66:10">ಬೆಳ್ಳಿಯನ್ನು ಪುಟಕ್ಕೆ ಹಾಕುವ ಪ್ರಕಾರ ನಮ್ಮನ್ನು ಶುದ್ಧೀಕರಿಸಿದ್ದೀರಿ.<verse eid="PSA 66:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 66:11"/>ನೀವು ಬಲೆಯೊಳಗೆ ನಮ್ಮನ್ನು ಸಿಕ್ಕಿಸಿದ್ದೀರಿ.</para>
  <para style="q2" vid="PSA 66:11">ನಮ್ಮ ಬೆನ್ನಿನ ಮೇಲೆ ಭಾರವನ್ನು ಹೊರಿಸಿದ್ದೀರಿ.<verse eid="PSA 66:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 66:12"/>ಮನುಷ್ಯರು ನಮ್ಮ ತಲೆ ಮೇಲೆ ಸವಾರಿ ಮಾಡುವಂತೆ ಮಾಡಿದ್ದೀರಿ.</para>
  <para style="q2" vid="PSA 66:12">ನಾವು ಬೆಂಕಿಯನ್ನೂ ನೀರನ್ನೂ ದಾಟುವಂತೆ ಮಾಡಿದ್ದೀರಿ.</para>
  <para style="q2" vid="PSA 66:12">ಆದರೆ ನೀವು ನಮ್ಮನ್ನು ಸಮೃದ್ಧಿಯ ಸ್ಥಳದೊಳಗೆ ಬರಮಾಡಿದ್ದೀರಿ.<verse eid="PSA 66:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 66:13"/>ನಾನು ದಹನಬಲಿಯೊಂದಿಗೆ</para>
  <para style="q2" vid="PSA 66:13">ನಿಮ್ಮ ಆಲಯಕ್ಕೆ ಬರುವೆನು.<verse eid="PSA 66:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 66:14"/>ನನ್ನ ಇಕ್ಕಟ್ಟಿನಲ್ಲಿ ತುಟಿ ಬಿಚ್ಚಿ ನನ್ನ ಬಾಯಿಂದ ನುಡಿದ</para>
  <para style="q2" vid="PSA 66:14">ನನ್ನ ಹರಕೆಗಳನ್ನು ನಾನು ನಿಮಗೆ ಸಲ್ಲಿಸುವೆನು.<verse eid="PSA 66:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 66:15"/>ಕೊಬ್ಬಿದ ದಹನಬಲಿಗಳನ್ನು</para>
  <para style="q2" vid="PSA 66:15">ಕಾಣಿಕೆಯಾಗಿ ಟಗರುಗಳನ್ನು;</para>
  <para style="q2" vid="PSA 66:15">ಹೋತ ಹೋರಿಗಳ ಯಜ್ಞವನ್ನು ಅರ್ಪಿಸುವೆನು.<verse eid="PSA 66:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 66:16"/>ಸಮಸ್ತ ದೇವಭಕ್ತರೇ, ಬಂದು ಕೇಳಿರಿ.</para>
  <para style="q2" vid="PSA 66:16">ದೇವರು ನನಗೆ ಮಾಡಿದ್ದನ್ನು ನಾನು ನಿಮಗೆ ತಿಳಿಸುವೆನು.<verse eid="PSA 66:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 66:17"/>ನನ್ನ ದೇವರಿಗೆ ಮೊರೆಯಿಟ್ಟೆನು,</para>
  <para style="q2" vid="PSA 66:17">ನನ್ನ ನಾಲಿಗೆಯಲ್ಲಿ ದೇವರ ಸ್ತೋತ್ರವಿತ್ತು.<verse eid="PSA 66:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 66:18"/>ಪಾಪವನ್ನು ನಾನು ನನ್ನ ಹೃದಯದಲ್ಲಿ ಬೆಳೆಸಿಕೊಂಡಿದ್ದರೆ,</para>
  <para style="q2" vid="PSA 66:18">ಯೆಹೋವ ದೇವರು ನನ್ನ ಪ್ರಾರ್ಥನೆಯನ್ನು ಕೇಳುತ್ತಿರಲಿಲ್ಲ.<verse eid="PSA 66:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 66:19"/>ಆದರೆ ಈಗ ನಿಜವಾಗಿ ನನ್ನ ಪ್ರಾರ್ಥನೆಯನ್ನು</para>
  <para style="q2" vid="PSA 66:19">ದೇವರು ಕೇಳಿದ್ದಾರೆ.<verse eid="PSA 66:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 66:20"/>ನನ್ನ ಪ್ರಾರ್ಥನೆಯನ್ನು ತಿರಸ್ಕರಿಸದ ದೇವರಿಗೆ ಸ್ತೋತ್ರವಾಗಲಿ.</para>
  <para style="q2" vid="PSA 66:20">ತಮ್ಮ ಪ್ರೀತಿಯನ್ನು ನನ್ನಿಂದ ತೊಲಗಿಸದೆ ಇರುವೆ.</para>
  <para style="q2" vid="PSA 66:20">ದೇವರಿಗೆ ಸ್ತೋತ್ರವಾಗಲಿ.<verse eid="PSA 66:20"/></para>
  <chapter eid="PSA 66"/>
  <chapter number="67" style="c" sid="PSA 67"/>
  <para style="cl">ಕೀರ್ತನೆ 67</para>
  <para style="d">ಸಂಗೀತ ನಿರ್ದೇಶಕನಿಗಾಗಿರುವ ಕೀರ್ತನೆ. ತಂತಿವಾದ್ಯದೊಡನೆ ಹಾಡತಕ್ಕ ಕೀರ್ತನೆ, ಒಂದು ಗೀತೆ.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 67:1"/>ದೇವರು ನಮ್ಮ ಮೇಲೆ ಕರುಣೆಯಿಟ್ಟು, ನಮ್ಮನ್ನು ಆಶೀರ್ವದಿಸಲಿ.</para>
  <para style="q2" vid="PSA 67:1">ದೇವರು ತಮ್ಮ ಮುಖವನ್ನು ನಮ್ಮ ಮೇಲೆ ಪ್ರಕಾಶಿಸಮಾಡಲಿ.<verse eid="PSA 67:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 67:2"/>ಆಗ ದೇವರೇ, ನಿಮ್ಮ ಮಾರ್ಗಗಳು ಭೂಮಿಯಲ್ಲಿ ಗೊತ್ತಾಗುವುದು.</para>
  <para style="q2" vid="PSA 67:2">ನಿಮ್ಮ ರಕ್ಷಣೆಯು ಎಲ್ಲಾ ಜನಾಂಗಗಳಲ್ಲಿ ಪ್ರಸಿದ್ಧವಾಗುವುದು.<verse eid="PSA 67:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 67:3"/>ದೇವರೇ, ಜನರು ನಿಮ್ಮನ್ನು ಕೊಂಡಾಡಲಿ,</para>
  <para style="q2" vid="PSA 67:3">ಸರ್ವ ಜನಾಂಗಗಳು ನಿಮ್ಮನ್ನು ಸ್ತುತಿಸಲಿ.<verse eid="PSA 67:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 67:4"/>ಜನಾಂಗಗಳು ಸಂತೋಷಪಟ್ಟು ಉತ್ಸಾಹದಿಂದ ಹಾಡಲಿ.</para>
  <para style="q2" vid="PSA 67:4">ಏಕೆಂದರೆ ನೀವು ಜನರನ್ನು ನೀತಿಯಿಂದ ನ್ಯಾಯತೀರಿಸಿ,</para>
  <para style="q2" vid="PSA 67:4">ಜನಾಂಗಗಳನ್ನು ಭೂಮಿಯಲ್ಲಿ ಪರಿಪಾಲಿಸುತ್ತೀರಿ.<verse eid="PSA 67:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 67:5"/>ದೇವರೇ, ಜನರು ನಿಮ್ಮನ್ನು ಕೊಂಡಾಡಲಿ.</para>
  <para style="q2" vid="PSA 67:5">ಸರ್ವ ಜನಾಂಗಗಳು ನಿಮ್ಮನ್ನು ಸ್ತುತಿಸಲಿ.<verse eid="PSA 67:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 67:6"/>ಭೂಮಿಯು ತನ್ನ ಬೆಳೆಯನ್ನು ಕೊಡುವುದು.</para>
  <para style="q2" vid="PSA 67:6">ದೇವರೇ, ಹೌದು, ನಮ್ಮ ದೇವರೇ ನಮ್ಮನ್ನು ಆಶೀರ್ವದಿಸುವರು.<verse eid="PSA 67:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 67:7"/>ದೇವರು ನಮ್ಮನ್ನು ಆಶೀರ್ವದಿಸುವರು.</para>
  <para style="q2" vid="PSA 67:7">ಭೂಮಿಯಲ್ಲಿರುವ ಎಲ್ಲರೂ ದೇವರಲ್ಲಿ ಭಯಭಕ್ತಿಯುಳ್ಳವರಾಗಿರುವರು.<verse eid="PSA 67:7"/></para>
  <chapter eid="PSA 67"/>
  <chapter number="68" style="c" sid="PSA 68"/>
  <para style="cl">ಕೀರ್ತನೆ 68</para>
  <para style="d">ಸಂಗೀತ ನಿರ್ದೇಶಕನಿಗಾಗಿರುವ ಕೀರ್ತನೆ. ದಾವೀದನ ಕೀರ್ತನೆ. ಒಂದು ಗೀತೆ.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 68:1"/>ದೇವರು ಕ್ರಿಯಾಶೀಲರಾಗಲಿ. ಅವರ ಶತ್ರುಗಳು ಚದರಿಹೋಗಲಿ.</para>
  <para style="q2" vid="PSA 68:1">ದೇವರನ್ನು ವಿರೋಧಿಸುವವರು ಅವರ ಸಮ್ಮುಖದಿಂದ ಓಡಿಹೋಗಲಿ.<verse eid="PSA 68:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 68:2"/>ಗಾಳಿಯಿಂದ ಹೊಗೆ ಹಾರಿಹೋಗುವಂತೆ ಅವರು ಹಾರಿಹೋಗಲಿ.</para>
  <para style="q2" vid="PSA 68:2">ಮೇಣವು ಬೆಂಕಿಯ ಮುಂದೆ ಕರಗುವಂತೆ,</para>
  <para style="q2" vid="PSA 68:2">ದುಷ್ಟರು ದೇವರ ಮುಂದೆ ನಾಶವಾಗಲಿ.<verse eid="PSA 68:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 68:3"/>ಆದರೆ ನೀತಿವಂತರು ಸಂತೋಷಿಸಲಿ.</para>
  <para style="q2" vid="PSA 68:3">ದೇವರ ಮುಂದೆ ಉಲ್ಲಾಸಪಡಲಿ.</para>
  <para style="q2" vid="PSA 68:3">ಹೌದು, ಅವರು ಹರ್ಷಾನಂದರಾಗಲಿ.<verse eid="PSA 68:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 68:4"/>ದೇವರಿಗೆ ಹಾಡಿರಿ, ದೇವರ ಹೆಸರಿಗೆ ಸ್ತುತಿಗಳನ್ನು ಹಾಡಿರಿ.</para>
  <para style="q2" vid="PSA 68:4">ಮೇಘಾರೂಢರಾಗಿರುವ ದೇವರನ್ನು ಕೊಂಡಾಡಿರಿ.</para>
  <para style="q2" vid="PSA 68:4">ಅವರ ಹೆಸರು ಯೆಹೋವ ದೇವರು, ಅವರ ಮುಂದೆ ಉಲ್ಲಾಸಪಡಿರಿ.<verse eid="PSA 68:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 68:5"/>ದೇವರು ತಮ್ಮ ಪರಿಶುದ್ಧ ಸ್ಥಳದಲ್ಲಿ ದಿಕ್ಕಿಲ್ಲದವರಿಗೆ ತಂದೆ,</para>
  <para style="q2" vid="PSA 68:5">ವಿಧವೆಯರಿಗೆ ರಕ್ಷಕರಾಗಿದ್ದಾರೆ.<verse eid="PSA 68:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 68:6"/>ದೇವರು ಒಂಟಿಗರನ್ನು ಕುಟುಂಬಸ್ತರನ್ನಾಗಿ ಮಾಡುತ್ತಾರೆ.</para>
  <para style="q2" vid="PSA 68:6">ಸೆರೆಯವರನ್ನು ಹರ್ಷಗೊಳಿಸಿ ಬಿಡುಗಡೆ ಮಾಡುತ್ತಾರೆ.</para>
  <para style="q2" vid="PSA 68:6">ಆದರೆ ಎದುರು ಬೀಳುವವರು ಒಣಭೂಮಿಯಲ್ಲಿ ವಾಸಿಸುತ್ತಾರೆ.<verse eid="PSA 68:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 68:7"/>ದೇವರೇ, ನೀವು ನಿಮ್ಮ ಜನರ ಮುಂದೆ ಹೊರಟು</para>
  <para style="q2" vid="PSA 68:7">ಕಾಡಿನಲ್ಲಿ ನಡೆದಾಗ,<verse eid="PSA 68:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 68:8"/>ಭೂಮಿಯು ಕದಲಿತು, ಆಕಾಶಗಳು ಸಹ ನಿಮ್ಮ ಮುಂದೆ ಮಳೆಗರೆದವು.</para>
  <para style="q2" vid="PSA 68:8">ಇಸ್ರಾಯೇಲರ ದೇವರ ಮುಂದೆ, ಹೌದು,</para>
  <para style="q2" vid="PSA 68:8">ದೇವರ ಮುಂದೆಯೇ ಸೀನಾಯಿ ಸಹ ಕದಲಿತು.<verse eid="PSA 68:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 68:9"/>ದೇವರೇ, ನೀವು ಹೇರಳವಾಗಿ ಮಳೆಯನ್ನು ಸುರಿಸಿ,</para>
  <para style="q2" vid="PSA 68:9">ದಣಿದ ನಿಮ್ಮ ಬಾಧ್ಯತೆಯನ್ನು ನೀವು ಉತ್ಸಾಹಪಡಿಸಿದಿರಿ.<verse eid="PSA 68:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 68:10"/>ನಿಮ್ಮ ಪ್ರಜೆಗಳು ಅದರಲ್ಲಿ ವಾಸಮಾಡಿದರು.</para>
  <para style="q2" vid="PSA 68:10">ದೇವರೇ, ನಿಮ್ಮ ಒಳ್ಳೆಯತನದಿಂದ ಬಡವರಿಗೋಸ್ಕರ ಒದಗಿಸಿದ್ದೀರಿ.<verse eid="PSA 68:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 68:11"/>ಯೆಹೋವ ದೇವರು ವಾಕ್ಯವನ್ನು ಕೊಟ್ಟರು.</para>
  <para style="q2" vid="PSA 68:11">ಆ ವಾಕ್ಯವನ್ನು ಹೀಗೆಂದು ಪ್ರಕಟಿಸಿದ ಮಹಿಳೆಯರ ಗುಂಪು ದೊಡ್ಡದಾಗಿತ್ತು:<verse eid="PSA 68:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 68:12"/>“ಸೈನ್ಯದೊಡನೆ ಅರಸರು ಓಡಿಹೋದರು.</para>
  <para style="q2" vid="PSA 68:12">ಪಾಳೆಯದಲ್ಲಿರುವ ಮಹಿಳೆಯರು ಕೊಳ್ಳೆಯನ್ನು ಹಂಚಿಕೊಳ್ಳುವರು.<verse eid="PSA 68:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 68:13"/>ನೀವು ಪಾಳೆಯದ ಬೆಂಕಿಯ<note caller="+" style="f"><char style="fr" closed="false">68:13 </char><char style="fq" closed="false">ಪಾಳೆಯದ ಬೆಂಕಿಯ </char><char style="ft" closed="false">ಕೆಲವು ಪ್ರತಿಗಳಲ್ಲಿ </char><char style="fqa" closed="false">ಕುರಿಹಟ್ಟಿ</char></note> ಬಳಿ ಮಲಗಿದರೂ,</para>
  <para style="q2" vid="PSA 68:13">ಪಾರಿವಾಳದ ರೆಕ್ಕೆಗಳು ಬೆಳ್ಳಿಯಿಂದಲೂ,</para>
  <para style="q2" vid="PSA 68:13">ಅದರ ಗರಿಗಳು ಬಂಗಾರದಿಂದಲೂ ಹೊಳೆಯುವಂತಿರುವಿರಿ.”<verse eid="PSA 68:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 68:14"/>ಸರ್ವಶಕ್ತರಾದ ದೇವರು ಅರಸರನ್ನು ಅಲ್ಲಿ ಚದರಿಸಿದಾಗ</para>
  <para style="q2" vid="PSA 68:14">ಸಲ್ಮೋನಿನಲ್ಲಿ ಬಿಳೀ ಹಿಮ ಬಿದ್ದಂತಿತ್ತು.<verse eid="PSA 68:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 68:15"/>ಬಾಷಾನ್ ಬೆಟ್ಟವು ದೇವರ ಬೆಟ್ಟದಂತೆ ಇದೆ;</para>
  <para style="q2" vid="PSA 68:15">ಬಾಷಾನ್ ಬೆಟ್ಟವು ಉನ್ನತ ಬೆಟ್ಟವಾಗಿದೆ.<verse eid="PSA 68:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 68:16"/>ಉನ್ನತ ಬೆಟ್ಟಗಳೇ, ಏಕೆ ಕುಣಿಯುತ್ತೀರಿ?</para>
  <para style="q2" vid="PSA 68:16">ದೇವರು ನಿವಾಸಕ್ಕಾಗಿ ಅಪೇಕ್ಷಿಸುವ ಬೆಟ್ಟವು ಇದೇ ಹೌದು,</para>
  <para style="q2" vid="PSA 68:16">ಯೆಹೋವ ದೇವರು ಅದರಲ್ಲಿ ಸದಾಕಾಲವೂ ವಾಸಿಸುವರು.<verse eid="PSA 68:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 68:17"/>ದೇವರಿಗೆ ಸಹಸ್ರಾರು ಮಾತ್ರವಲ್ಲ ಲಕ್ಷಾಂತರ ರಥಗಳು ಇವೆ.</para>
  <para style="q2" vid="PSA 68:17">ಕರ್ತ ಆಗಿರುವ ಯೆಹೋವ ದೇವರು ಅವುಗಳ ಸಮೇತವಾಗಿ</para>
  <para style="q2" vid="PSA 68:17">ಸೀನಾಯಿ ಬೆಟ್ಟದಲ್ಲಿದ್ದ ಹಾಗೆ ಪವಿತ್ರಾಲಯದಲ್ಲಿದ್ದಾರೆ.<verse eid="PSA 68:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 68:18"/>ನೀವು ಅನೇಕ ಸೆರೆಯವರ ಹಿಡಿದುಕೊಂಡು ಉನ್ನತಕ್ಕೆ ಹೋದಾಗ,</para>
  <para style="q2" vid="PSA 68:18">ಯೆಹೋವ ದೇವರು ತಿರುಗಿಬೀಳುವವರ ಮಧ್ಯದಲ್ಲಿ ಸಹ ನಿವಾಸಿಸುವಂತೆ</para>
  <para style="q2" vid="PSA 68:18">ಆ ತಿರುಗಿಬಿದ್ದ ಮನುಷ್ಯರಿಂದ ದಾನಗಳನ್ನು ಅಂಗೀಕರಿಸಿದ್ದೀರಿ.<verse eid="PSA 68:18"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 68:19"/>ಪ್ರತಿದಿನವೂ ನಮ್ಮ ಭಾರವನ್ನು ಹೊರುವ ಕರ್ತದೇವರಿಗೆ ಸ್ತೋತ್ರ.</para>
  <para style="q2" vid="PSA 68:19">ನಮ್ಮನ್ನು ರಕ್ಷಿಸುವ ದೇವರು ಸ್ತುತಿಹೊಂದಲಿ.<verse eid="PSA 68:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 68:20"/>ನಮ್ಮ ದೇವರು ರಕ್ಷಣೆಯ ದೇವರಾಗಿದ್ದಾರೆ.</para>
  <para style="q2" vid="PSA 68:20">ಸಾರ್ವಭೌಮ ಯೆಹೋವ ದೇವರು ಮರಣದಿಂದ ಬಿಡುಗಡೆ ಮಾಡುತ್ತಾರೆ.<verse eid="PSA 68:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 68:21"/>ದೇವರು ತಮ್ಮ ಶತ್ರುಗಳ ತಲೆಯನ್ನೂ,</para>
  <para style="q2" vid="PSA 68:21">ತನ್ನ ಅಪರಾಧಗಳಲ್ಲಿ ಇನ್ನೂ ಮುಂದುವರಿಯುವವರ ಕೂದಲುಳ್ಳ ಮಂಡೆಯನ್ನೂ ಗಾಯಮಾಡುವರು.<verse eid="PSA 68:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 68:22"/>ಯೆಹೋವ ದೇವರು ಹೀಗೆ ಹೇಳುತ್ತಾರೆ,</para>
  <para style="q2" vid="PSA 68:22">“ಬಾಷಾನಿನಿಂದ ಅವರನ್ನು ತಿರುಗಿ ಬರಮಾಡುವೆನು;</para>
  <para style="q2" vid="PSA 68:22">ಸಮುದ್ರದ ಅಗಾಧಗಳಿಂದ ಜನರನ್ನು ತಿರುಗಿ ಬರಮಾಡುವೆನು.<verse eid="PSA 68:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 68:23"/>ಆಗ ನಿಮ್ಮ ಪಾದಗಳು ನಿಮ್ಮ ವೈರಿಗಳ ರಕ್ತದ ಮೇಲಿರಲಿ.</para>
  <para style="q2" vid="PSA 68:23">ನಾಯಿಗಳು ಅದನ್ನು ನೆಕ್ಕಲಿ.”<verse eid="PSA 68:23"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 68:24"/>ದೇವರೇ, ನಿಮ್ಮ ಮೆರವಣಿಗೆಯು ಪ್ರಕಟವಾಗಿದೆ.</para>
  <para style="q2" vid="PSA 68:24">ನನ್ನ ಅರಸರಾಗಿರುವ ದೇವರ ಮೆರವಣಿಗೆಯು ಪರಿಶುದ್ಧ ಸ್ಥಳವನ್ನು ಪ್ರವೇಶಿಸುವುದು.<verse eid="PSA 68:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 68:25"/>ಹಾಡುವವರು ಮುಂದಾಗಿಯೂ, ಬಾರಿಸುವವರು ಹಿಂದಾಗಿಯೂ,</para>
  <para style="q2" vid="PSA 68:25">ದಮ್ಮಡಿ ಬಡಿಯುವ ಕನ್ಯೆಯರು ಮಧ್ಯದಲ್ಲಿಯೂ ಹಿಂಬಾಲಿಸುವರು.<verse eid="PSA 68:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 68:26"/>ಮಹಾಸಭೆಯಲ್ಲಿ ದೇವರನ್ನು ಸ್ತುತಿಸಿರಿ.</para>
  <para style="q2" vid="PSA 68:26">ಇಸ್ರಾಯೇಲರ ಸಮೂಹದವರಲ್ಲಿ ಯೆಹೋವ ದೇವರನ್ನು ಸ್ತುತಿಸಿರಿ.<verse eid="PSA 68:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 68:27"/>ಬೆನ್ಯಾಮೀನನ ಚಿಕ್ಕ ಗೋತ್ರವು ಅವರನ್ನು ನಡೆಸುವುದು.</para>
  <para style="q2" vid="PSA 68:27">ಯೆಹೂದದ ಪ್ರಧಾನರೂ,</para>
  <para style="q2" vid="PSA 68:27">ಜೆಬುಲೂನನ ಪ್ರಧಾನರೂ ನಫ್ತಾಲಿಯ ಪ್ರಧಾನರೂ ಅಲ್ಲಿ ಇದ್ದಾರೆ.<verse eid="PSA 68:27"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 68:28"/>ದೇವರೇ, ನಿಮ್ಮ ಶಕ್ತಿಯನ್ನು ಪ್ರಕಟಿಸಿರಿ, ಮೊದಲು ಮಾಡಿದಂತೆಯೇ</para>
  <para style="q2" vid="PSA 68:28">ಈಗಲೂ ನಿಮ್ಮ ಸಾಮರ್ಥ್ಯವನ್ನು ಪ್ರದರ್ಶಿಸಿರಿ.<verse eid="PSA 68:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="PSA 68:29"/>ಯೆರೂಸಲೇಮಿನ ನಿಮ್ಮ ಮಂದಿರದ ನಿಮಿತ್ತ</para>
  <para style="q2" vid="PSA 68:29">ಅರಸರು ನಿಮಗೆ ಕಾಣಿಕೆಗಳನ್ನು ಸಮರ್ಪಿಸಲಿ.<verse eid="PSA 68:29"/></para>
  <para style="q1">
    <verse number="30" style="v" sid="PSA 68:30"/>ಆಪು ಹುಲ್ಲಿನ ಮಧ್ಯದಲ್ಲಿರುವ ಕಾಡುಮೃಗಗಳ ಹಾಗೆಯೂ</para>
  <para style="q2" vid="PSA 68:30">ಕರುಗಳ ಮಧ್ಯದಲ್ಲಿರುವ ಹೋರಿಗಳ ಹಾಗೆಯೂ ಇರುವ ಜನಾಂಗವನ್ನು ಗದರಿಸಿರಿ.</para>
  <para style="q1" vid="PSA 68:30">ಮೃಗದಂಥವರು ತಗ್ಗಿಸಿಕೊಂಡು ಬೆಳ್ಳಿ ಗಟ್ಟಿಗಳನ್ನು ನಿಮಗೆ ತರಲಿ.</para>
  <para style="q2" vid="PSA 68:30">ಆದರೆ ಯುದ್ಧದಲ್ಲಿ ಆನಂದಿಸುವ ರಾಷ್ಟ್ರಗಳನ್ನು ಚದರಿಸಿರಿ.<verse eid="PSA 68:30"/></para>
  <para style="q1">
    <verse number="31" style="v" sid="PSA 68:31"/>ಈಜಿಪ್ಟಿನಿಂದ ರಾಯಭಾರಿಗಳು ಬರುವರು.</para>
  <para style="q2" vid="PSA 68:31">ಕೂಷ್ ದೇಶದವರು ತಾವಾಗಿಯೇ ಬಂದು ದೇವರಿಗೆ ಅಧೀನವಾಗುವರು.<verse eid="PSA 68:31"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="32" style="v" sid="PSA 68:32"/>ಭೂಮಿಯ ರಾಜ್ಯಗಳೇ, ದೇವರಿಗೆ ಹಾಡಿರಿ.</para>
  <para style="q2" vid="PSA 68:32">ಯೆಹೋವ ದೇವರನ್ನು ಕೀರ್ತಿಸಿರಿ.<verse eid="PSA 68:32"/></para>
  <para style="q1">
    <verse number="33" style="v" sid="PSA 68:33"/>ಪೂರ್ವದ ಆಕಾಶಗಳಲ್ಲಿ ಸವಾರಿ ಮಾಡುವ ದೇವರಿಗೆ ಹಾಡಿರಿ.</para>
  <para style="q2" vid="PSA 68:33">ದೇವರ ಸ್ವರವು ಗುಡುಗಿನಂತೆ ಇರುವುದು.<verse eid="PSA 68:33"/></para>
  <para style="q1">
    <verse number="34" style="v" sid="PSA 68:34"/>ದೇವರ ಶಕ್ತಿಯನ್ನು ಘೋಷಿಸಿರಿ.</para>
  <para style="q2" vid="PSA 68:34">ಇಸ್ರಾಯೇಲರ ಮೇಲೆ ಅವರ ಪ್ರಭಾವವಿರುತ್ತದೆ.</para>
  <para style="q2" vid="PSA 68:34">ಮೇಘಗಳಲ್ಲಿ ಅವರ ಶಕ್ತಿಯು ಇರುತ್ತದೆ.<verse eid="PSA 68:34"/></para>
  <para style="q1">
    <verse number="35" style="v" sid="PSA 68:35"/>ದೇವರೇ, ನಿಮ್ಮ ಪರಿಶುದ್ಧ ಸ್ಥಳದಲ್ಲಿ ನೀವು ಅತಿಶಯವಾಗಿದ್ದೀರಿ.</para>
  <para style="q2" vid="PSA 68:35">ಇಸ್ರಾಯೇಲರ ದೇವರೇ ಜನರಿಗೆ ಬಲವನ್ನೂ ಶಕ್ತಿಯನ್ನೂ ಕೊಡುವರು.</para>
  <para style="b" vid="PSA 68:35"/>
  <para style="q1" vid="PSA 68:35">ದೇವರಿಗೆ ಸ್ತುತಿಯಾಗಲಿ.<verse eid="PSA 68:35"/></para>
  <chapter eid="PSA 68"/>
  <chapter number="69" style="c" sid="PSA 69"/>
  <para style="cl">ಕೀರ್ತನೆ 69</para>
  <para style="d">ಸಂಗೀತ ನಿರ್ದೇಶಕನಿಗಾಗಿರುವ ಕೀರ್ತನೆ. “ಲಿಲಿಹೂಗಳು” ರಾಗವನ್ನು ಆಧರಿಸಿದೆ. ದಾವೀದನ ಕೀರ್ತನೆ.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 69:1"/>ದೇವರೇ, ನನ್ನನ್ನು ರಕ್ಷಿಸಿರಿ.</para>
  <para style="q2" vid="PSA 69:1">ಏಕೆಂದರೆ, ಪ್ರವಾಹ ಕುತ್ತಿಗೆಯ ವರೆಗೆ ಬಂದಿದೆ.<verse eid="PSA 69:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 69:2"/>ನೆಲವಿಲ್ಲದಿರುವ ಆಳವಾದ ಕೆಸರಿನಲ್ಲಿ</para>
  <para style="q2" vid="PSA 69:2">ನಾನು ಮುಳುಗುತ್ತಿದ್ದೇನೆ.</para>
  <para style="q1" vid="PSA 69:2">ಪ್ರವಾಹಗಳು ನನ್ನ ಮೇಲೆ ಹಾದುಹೋಗುವ</para>
  <para style="q2" vid="PSA 69:2">ನೀರಿನ ಅಗಾಧಕ್ಕೆ ನಾನು ಬಂದಿದ್ದೇನೆ.<verse eid="PSA 69:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 69:3"/>ನಾನು ಮೊರೆಯಿಟ್ಟು ದಣಿದಿದ್ದೇನೆ.</para>
  <para style="q2" vid="PSA 69:3">ನನ್ನ ಗಂಟಲು ಒಣಗಿದೆ.</para>
  <para style="q1" vid="PSA 69:3">ನಾನು ದೇವರನ್ನು ಎದುರು ನೋಡುವುದರಿಂದ</para>
  <para style="q2" vid="PSA 69:3">ನನ್ನ ಕಣ್ಣು ಕ್ಷೀಣವಾಗಿವೆ.<verse eid="PSA 69:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 69:4"/>ಕಾರಣವಿಲ್ಲದೆ ನನ್ನನ್ನು ದ್ವೇಷಿಸುವವರು</para>
  <para style="q2" vid="PSA 69:4">ನನ್ನ ತಲೆಗೂದಲುಗಳಿಗಿಂತ ಹೆಚ್ಚಾಗಿದ್ದಾರೆ.</para>
  <para style="q1" vid="PSA 69:4">ನನ್ನನ್ನು ನಾಶಮಾಡ ಬಯಸುವವರೂ</para>
  <para style="q2" vid="PSA 69:4">ಕಾರಣವಿಲ್ಲದೆ ನನಗೆ ಶತ್ರುಗಳಾಗಿದ್ದಾರೆ.</para>
  <para style="q1" vid="PSA 69:4">ನಾನು ಅಪಹರಿಸದಿದ್ದರೂ</para>
  <para style="q2" vid="PSA 69:4">ದಂಡ ಕೊಡಬೇಕಾಯಿತು.<verse eid="PSA 69:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 69:5"/>ದೇವರೇ, ನೀವು ನನ್ನ ಮೂರ್ಖತನವನ್ನು ತಿಳಿದಿದ್ದೀರಿ.</para>
  <para style="q2" vid="PSA 69:5">ನನ್ನ ಅಪರಾಧಗಳು ನಿಮಗೆ ಮರೆಯಾಗಿಲ್ಲ.<verse eid="PSA 69:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 69:6"/>ಸೇನಾಧೀಶ್ವರ ಯೆಹೋವ ದೇವರೇ,</para>
  <para style="q2" vid="PSA 69:6">ನಿಮ್ಮನ್ನು ನಂಬಿದವರಿಗೆ</para>
  <para style="q2" vid="PSA 69:6">ನನ್ನಿಂದ ನಿರಾಶೆಯಾಗದಿರಲಿ;</para>
  <para style="q1" vid="PSA 69:6">ಇಸ್ರಾಯೇಲರ ದೇವರೇ,</para>
  <para style="q2" vid="PSA 69:6">ನಿಮ್ನನ್ನು ಹುಡುಕುವವರು</para>
  <para style="q2" vid="PSA 69:6">ನನ್ನಿಂದ ಅಪಮಾನಕ್ಕೆ ಗುರಿಯಾಗದಿರಲಿ.<verse eid="PSA 69:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 69:7"/>ನಾನು ನಿಮ್ಮ ನಿಮಿತ್ತ ನಿಂದೆಗೆ ಒಳಗಾಗಿದ್ದೇನೆ.</para>
  <para style="q2" vid="PSA 69:7">ಅವಮಾನವು ನನ್ನ ಮುಖವನ್ನು ಮುಚ್ಚಿದೆ.<verse eid="PSA 69:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 69:8"/>ನನ್ನ ಸಹೋದರರಿಗೆ ಅನ್ಯನಾಗಿದ್ದೇನೆ.</para>
  <para style="q2" vid="PSA 69:8">ನನ್ನ ಒಡಹುಟ್ಟಿದವರಿಗೇ ಪರಕೀಯನಾಗಿದ್ದೇನೆ.<verse eid="PSA 69:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 69:9"/>ಏಕೆಂದರೆ ನಿಮ್ಮ ಆಲಯದ ಮೇಲಿನ ಆಸಕ್ತಿಯು ಬೆಂಕಿಯಂತೆ ನನ್ನನ್ನು ದಹಿಸಿಬಿಟ್ಟಿದೆ.</para>
  <para style="q2" vid="PSA 69:9">ನಿಮ್ಮನ್ನು ನಿಂದಿಸುವವರ ನಿಂದೆಗಳು ನನ್ನ ಮೇಲೆ ಬಿದ್ದಿವೆ.<verse eid="PSA 69:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 69:10"/>ನಾನು ಅತ್ತು ಉಪವಾಸ ಮಾಡಿದಾಗ</para>
  <para style="q2" vid="PSA 69:10">ನಿಂದೆಗೆ ಒಳಗಾಗಬೇಕಾಯಿತು.<verse eid="PSA 69:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 69:11"/>ಗೋಣಿತಟ್ಟನ್ನು ನನ್ನ ಉಡುಪಾಗಿ ಮಾಡಿಕೊಂಡಿದ್ದೇನೆ.</para>
  <para style="q2" vid="PSA 69:11">ಇದರಿಂದ ನಾನು ಅವರಿಗೆ ಗಾದೆಯ ಮಾತಾದೆನು.<verse eid="PSA 69:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 69:12"/>ಊರುಬಾಗಿಲಲ್ಲಿ ಕೂತುಕೊಳ್ಳುವವರು ಪರಿಹಾಸ್ಯ ಮಾಡುತ್ತಾರೆ.</para>
  <para style="q2" vid="PSA 69:12">ನಾನು ಮದ್ಯಪಾನಿಗಳಿಗೆ ಗಾಯನ ವಿಷಯವಾಗಿದ್ದೇನೆ.<verse eid="PSA 69:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 69:13"/>ಯೆಹೋವ ದೇವರೇ, ನಾನಾದರೋ ನಿಮಗೆ ಮೊರೆಯಿಟ್ಟಿದ್ದೇನೆ.</para>
  <para style="q2" vid="PSA 69:13">ಇದು ನಿಮ್ಮ ಮೆಚ್ಚಿಕೆಯ ಸಕಾಲ.</para>
  <para style="q1" vid="PSA 69:13">ಓ ದೇವರೇ, ನಿಮ್ಮ ಮಹಾಪ್ರೀತಿಯಿಂದ</para>
  <para style="q2" vid="PSA 69:13">ನನಗೆ ನಿಮ್ಮ ನಿಶ್ಚಯ ರಕ್ಷಣೆಯನ್ನು ದಯಪಾಲಿಸಿರಿ.<verse eid="PSA 69:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 69:14"/>ನನ್ನನ್ನು ಕೆಸರಿನೊಳಗಿಂದ ಬಿಡಿಸಿರಿ.</para>
  <para style="q2" vid="PSA 69:14">ನಾನು ಮುಳುಗದೆ ಇರಲಿ.</para>
  <para style="q1" vid="PSA 69:14">ನನ್ನನ್ನು ದ್ವೇಷಿಸಿಸುವವರಿಂದಲೂ</para>
  <para style="q2" vid="PSA 69:14">ನೀರಿನ ಅಗಾಧದಿಂದಲೂ ನನಗೆ ಬಿಡುಗಡೆ ಆಗಲಿ.<verse eid="PSA 69:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 69:15"/>ನೀರಿನ ಪ್ರವಾಹವು ನನ್ನ ಮೇಲೆ ಹಾದುಹೋಗದೆ ಇರಲಿ.</para>
  <para style="q2" vid="PSA 69:15">ಅಗಾಧವು ನನ್ನನ್ನು ನುಂಗದೆ ಇರಲಿ.</para>
  <para style="q2" vid="PSA 69:15">ಕುಣಿಯು ನನ್ನ ಮೇಲೆ ತನ್ನ ಬಾಯನ್ನು ಮುಚ್ಚದೆ ಇರಲಿ.<verse eid="PSA 69:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 69:16"/>ಯೆಹೋವ ದೇವರೇ, ನಿಮ್ಮ ಪ್ರೀತಿಯ ಒಳ್ಳೆಯತನದಿಂದ ನನಗೆ ಉತ್ತರಕೊಡಿರಿ.</para>
  <para style="q2" vid="PSA 69:16">ನಿಮ್ಮ ಮಹಾ ಕರುಣೆಯಿಂದ ನನ್ನ ಕಡೆಗೆ ತಿರುಗಿರಿ.<verse eid="PSA 69:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 69:17"/>ನಿಮ್ಮ ಮುಖವನ್ನು ನಿಮ್ಮ ಸೇವಕನಿಗೆ ಮರೆಮಾಡಬೇಡಿರಿ.</para>
  <para style="q2" vid="PSA 69:17">ನಾನು ಇಕ್ಕಟ್ಟಿನಲ್ಲಿದ್ದೇನೆ. ಬೇಗ ನನಗೆ ಉತ್ತರಕೊಡಿರಿ.<verse eid="PSA 69:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 69:18"/>ನನಗೆ ಸಮೀಪವಾಗಿ ನನ್ನನ್ನು ಕಾಪಾಡಿರಿ.</para>
  <para style="q2" vid="PSA 69:18">ನನ್ನ ಶತ್ರುಗಳ ನಿಮಿತ್ತ ನನ್ನನ್ನು ಬಿಡಿಸಿರಿ.<verse eid="PSA 69:18"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 69:19"/>ನೀವು ನನಗಿರುವ ನಿಂದೆ, ನಾಚಿಕೆ ಹಾಗೂ ನನ್ನ ಅವಮಾನವನ್ನೂ ತಿಳಿದಿದ್ದೀರಿ.</para>
  <para style="q2" vid="PSA 69:19">ನನ್ನ ವೈರಿಗಳೆಲ್ಲರು ನಿಮ್ಮ ಮುಂದೆ ಇದ್ದಾರೆ.<verse eid="PSA 69:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 69:20"/>ನಿಂದೆಯು ನನ್ನ ಹೃದಯವನ್ನು ಮುರಿದಿದೆ.</para>
  <para style="q2" vid="PSA 69:20">ನನ್ನನ್ನು ನಿಸ್ಸಹಾಯಕನನ್ನಾಗಿ ಮಾಡಿದೆ.</para>
  <para style="q1" vid="PSA 69:20">ಅನುತಾಪಕ್ಕೋಸ್ಕರ ಕೆಲವರನ್ನು ನಿರೀಕ್ಷಿಸಿದೆನು, ಆದರೆ ಒಬ್ಬರೂ ಇರಲಿಲ್ಲ.</para>
  <para style="q2" vid="PSA 69:20">ಸಂತೈಸುವವರಿಗೋಸ್ಕರ ಸಹ ಎದುರು ನೋಡಿದೆನು, ಆದರೆ ಯಾರೂ ಸಿಕ್ಕಲಿಲ್ಲ.<verse eid="PSA 69:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 69:21"/>ನನ್ನ ಆಹಾರಕ್ಕಾಗಿ ಕಹಿಯಾದದ್ದನ್ನು ಕೊಟ್ಟರು.</para>
  <para style="q2" vid="PSA 69:21">ನನ್ನ ದಾಹಕ್ಕಾಗಿ ನನಗೆ ಹುಳಿರಸವನ್ನು ಕುಡಿಯಲು ಕೊಟ್ಟರು.<verse eid="PSA 69:21"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 69:22"/>ಅವರ ಊಟವೇ ಅವರಿಗೆ ಉರುಲಾಗಲಿ.</para>
  <para style="q2" vid="PSA 69:22">ಸುಖವಾಗಿರುವವರಿಗೆ ಅದು ಬೋನಾಗಲಿ.<verse eid="PSA 69:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 69:23"/>ಅವರ ಕಣ್ಣುಗಳು ಕಾಣದ ಹಾಗೆ ಕತ್ತಲಾಗಲಿ.</para>
  <para style="q2" vid="PSA 69:23">ಮತ್ತು ಅವರ ಬೆನ್ನು ಎಂದೆಂದಿಗೂ ಬಗ್ಗಿ ಹೋಗಲಿ<verse eid="PSA 69:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 69:24"/>ಅವರು ಕೋಪಕ್ಕೆ ಗುರಿಯಾಗಲಿ.</para>
  <para style="q2" vid="PSA 69:24">ಅವರು ಬೇಸರಕ್ಕೆ ತುತ್ತಾಗಲಿ.<verse eid="PSA 69:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 69:25"/>ಅವರ ವಾಸಸ್ಥಾನವು ಹಾಳಾಗಲಿ;</para>
  <para style="q2" vid="PSA 69:25">ಅವರ ಗುಡಾರಗಳಲ್ಲಿ ನಿವಾಸಿಯು ಇಲ್ಲದೆ ಹೋಗಲಿ.<verse eid="PSA 69:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 69:26"/>ನೀವು ಗಾಯಮಾಡಿದ ನನ್ನನ್ನು ಹಿಂಸಿಸುತ್ತಾರೆ.</para>
  <para style="q2" vid="PSA 69:26">ನೀವು ನೋಯಿಸಿದ ನನ್ನನ್ನು ಕುರಿತು ಚುಚ್ಚಿಮಾತನಾಡಿಕೊಳ್ಳುತ್ತಾರೆ.<verse eid="PSA 69:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 69:27"/>ಅಪರಾಧದ ಮೇಲೆ ಅಪರಾಧವು ಅವರ ಮೇಲೆ ಬರಲಿ.</para>
  <para style="q2" vid="PSA 69:27">ಅವರು ನಿಮ್ಮ ರಕ್ಷಣೆಯಲ್ಲಿ ಸೇರದೆ ಇರಲಿ.<verse eid="PSA 69:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 69:28"/>ಜೀವಪುಸ್ತಕದೊಳಗಿಂದ ಅವರ ಹೆಸರು ಅಳಿದು ಹೋಗಲಿ.</para>
  <para style="q2" vid="PSA 69:28">ನೀತಿವಂತರ ಸಂಗಡ ಅವರ ಹೆಸರು ಬರೆಯದೆ ಇರಲಿ.<verse eid="PSA 69:28"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="29" style="v" sid="PSA 69:29"/>ದೇವರೇ, ನಾನು ನೊಂದು ವ್ಯಥೆಗೊಂಡಿದ್ದೇನೆ.</para>
  <para style="q2" vid="PSA 69:29">ನಿಮ್ಮ ರಕ್ಷಣೆಯು ನನ್ನನ್ನು ಕಾಪಾಡಲಿ.<verse eid="PSA 69:29"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="30" style="v" sid="PSA 69:30"/>ನಾನು ದೇವರ ಹೆಸರನ್ನು ಹಾಡಿ ಸ್ತುತಿಸುವೆನು.</para>
  <para style="q2" vid="PSA 69:30">ಸ್ತೋತ್ರದಿಂದ ದೇವರನ್ನು ಸ್ತುತಿಸುವೆನು.<verse eid="PSA 69:30"/></para>
  <para style="q1">
    <verse number="31" style="v" sid="PSA 69:31"/>ಅದು ಯೆಹೋವ ದೇವರಿಗೆ ಎಳೆಯ ಎತ್ತು ಯಜ್ಞಗಳಿಗಿಂತ,</para>
  <para style="q2" vid="PSA 69:31">ಕೊಂಬೂ ಗೊರಸುಗಳುಳ್ಳ ಹೋರಿಗಳಿಗಿಂತ ಮೆಚ್ಚಿಕೆಯಾಗಿರುವುದು.<verse eid="PSA 69:31"/></para>
  <para style="q1">
    <verse number="32" style="v" sid="PSA 69:32"/>ಇದನ್ನು ದೀನರು ಕಂಡು ಸಂತೋಷಪಡುವರು.</para>
  <para style="q2" vid="PSA 69:32">ದೇವರನ್ನು ಹುಡುಕುವವರೇ, ನಿಮ್ಮ ಹೃದಯವು ಚೈತನ್ಯಗೊಳ್ಳಲಿ.<verse eid="PSA 69:32"/></para>
  <para style="q1">
    <verse number="33" style="v" sid="PSA 69:33"/>ಯೆಹೋವ ದೇವರು ಬಡವರ ಮೊರೆಗೆ ಕಿವಿಗೊಡುತ್ತಾರೆ.</para>
  <para style="q2" vid="PSA 69:33">ಸೆರೆಯಲ್ಲಿರುವ ತಮ್ಮ ಜನರನ್ನು ತಿರಸ್ಕರಿಸುವುದಿಲ್ಲ.<verse eid="PSA 69:33"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="34" style="v" sid="PSA 69:34"/>ಆಕಾಶವೂ ಭೂಮಿಯೂ ಸಮುದ್ರಗಳೂ,</para>
  <para style="q2" vid="PSA 69:34">ಅವುಗಳಲ್ಲಿ ಸಂಚರಿಸುವುದೆಲ್ಲವೂ ದೇವರನ್ನು ಸ್ತುತಿಸಲಿ.<verse eid="PSA 69:34"/></para>
  <para style="q1">
    <verse number="35" style="v" sid="PSA 69:35"/>ದೇವರು ಚೀಯೋನನ್ನು ರಕ್ಷಿಸುವರು.</para>
  <para style="q2" vid="PSA 69:35">ದೇವರು ಯೆಹೂದದ ಪಟ್ಟಣಗಳನ್ನು ಕಟ್ಟುವರು.</para>
  <para style="q1" vid="PSA 69:35">ಜನರು ಅಲ್ಲಿ ವಾಸಮಾಡಿ, ಅದನ್ನು ಸ್ವಾಧೀನಮಾಡಿಕೊಳ್ಳುವರು.<verse eid="PSA 69:35"/></para>
  <para style="q2">
    <verse number="36" style="v" sid="PSA 69:36"/>ದೇವರ ಸೇವಕರ ಸಂತತಿಯು ಅದನ್ನು ಬಾಧ್ಯವಾಗಿ ಹೊಂದುವುದು.</para>
  <para style="q2" vid="PSA 69:36">ದೇವರ ಹೆಸರನ್ನು ಪ್ರೀತಿಸುವವರು ಅದರಲ್ಲಿ ವಾಸಮಾಡುವರು.<verse eid="PSA 69:36"/></para>
  <chapter eid="PSA 69"/>
  <chapter number="70" style="c" sid="PSA 70"/>
  <para style="cl">ಕೀರ್ತನೆ 70</para>
  <para style="d">ಸಂಗೀತ ನಿರ್ದೇಶಕನಿಗಾಗಿರುವ ಕೀರ್ತನೆ. ದಾವೀದನ ಕೀರ್ತನೆ. ಬೇಡಿಕೆ.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 70:1"/>ದೇವರೇ, ನನ್ನನ್ನು ಬಿಡಿಸುವುದಕ್ಕೆ ತ್ವರೆಮಾಡಿರಿ;</para>
  <para style="q2" vid="PSA 70:1">ಯೆಹೋವ ದೇವರೇ, ನನಗೆ ಸಹಾಯಮಾಡಲು ಬೇಗನೆ ಬನ್ನಿರಿ.<verse eid="PSA 70:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 70:2"/>ನನ್ನ ಪ್ರಾಣ ತೆಗೆಯಲು ಯತ್ನಿಸುವವರೆಲ್ಲರು</para>
  <para style="q2" vid="PSA 70:2">ನಾಚಿಕೆಪಟ್ಟು ಗಲಿಬಿಲಿಯಾಗಲಿ.</para>
  <para style="q1" vid="PSA 70:2">ನನ್ನ ಕೇಡಿನಲ್ಲಿ ಸಂತೋಷಪಡುವವರೆಲ್ಲರೂ</para>
  <para style="q2" vid="PSA 70:2">ಹಿಂಜರಿದು ಅವಮಾನ ಹೊಂದಲಿ.<verse eid="PSA 70:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 70:3"/>“ಆಹಾ! ಆಹಾ!” ಎಂದು ನನ್ನನ್ನು ಹಾಸ್ಯಮಾಡುವವರು</para>
  <para style="q2" vid="PSA 70:3">ತಮ್ಮ ನಾಚಿಕೆಯ ಫಲಕ್ಕಾಗಿ ಬೆಂಗೊಟ್ಟು ಓಡಲಿ.<verse eid="PSA 70:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 70:4"/>ಆದರೆ, ನಿಮ್ಮನ್ನು ಹುಡುಕುವವರೆಲ್ಲರೂ</para>
  <para style="q2" vid="PSA 70:4">ನಿಮ್ಮಲ್ಲಿ ಹರ್ಷಾನಂದಗೊಳ್ಳಲಿ.</para>
  <para style="q1" vid="PSA 70:4">ನಿಮ್ಮ ರಕ್ಷಣೆಯನ್ನು ಪ್ರೀತಿಸುವವರು,</para>
  <para style="q2" vid="PSA 70:4">“ದೇವರು ಮಹೋನ್ನತರು,”</para>
  <para style="q2" vid="PSA 70:4">ಎಂದು ಯಾವಾಗಲೂ ಹೇಳಲಿ.<verse eid="PSA 70:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 70:5"/>ಆದರೆ ನಾನು ಬಡವನೂ ಅಗತ್ಯದಲ್ಲಿರುವವನೂ ಆಗಿದ್ದೇನೆ.</para>
  <para style="q2" vid="PSA 70:5">ದೇವರೇ, ಬೇಗನೆ ನನ್ನ ಬಳಿಗೆ ಬನ್ನಿರಿ.</para>
  <para style="q1" vid="PSA 70:5">ನನ್ನ ಸಹಾಯವೂ ನನ್ನನ್ನು ಬಿಡಿಸುವವರೂ ನೀವೇ,</para>
  <para style="q2" vid="PSA 70:5">ಯೆಹೋವ ದೇವರೇ, ತಡಮಾಡದೆ ಬನ್ನಿರಿ.<verse eid="PSA 70:5"/></para>
  <chapter eid="PSA 70"/>
  <chapter number="71" style="c" sid="PSA 71"/>
  <para style="cl">ಕೀರ್ತನೆ 71</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 71:1"/>ಯೆಹೋವ ದೇವರೇ, ನಿಮ್ಮಲ್ಲಿಯೇ ನಾನು ನನ್ನ ಭರವಸೆಯನ್ನಿಟ್ಟಿದ್ದೇನೆ.</para>
  <para style="q2" vid="PSA 71:1">ನನಗೆ ಎಂದೂ ಆಶಾಭಂಗವಾಗದಿರಲಿ.<verse eid="PSA 71:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 71:2"/>ನಿಮ್ಮ ನೀತಿಯಿಂದ ನನ್ನನ್ನು ಬಿಡಿಸಿ, ನನ್ನನ್ನು ಪಾರುಮಾಡಿರಿ.</para>
  <para style="q2" vid="PSA 71:2">ನಿಮ್ಮ ಕಿವಿಯನ್ನು ನನ್ನ ಕಡೆಗೆ ತಿರುಗಿಸಿ, ನನ್ನನ್ನು ರಕ್ಷಿಸಿರಿ.<verse eid="PSA 71:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 71:3"/>ನಾನು ಯಾವಾಗಲೂ ಆಶ್ರಯಿಸಿಕೊಳ್ಳುವ ಬಂಡೆಯಾಗಿರಿ.</para>
  <para style="q2" vid="PSA 71:3">ನನ್ನನ್ನು ರಕ್ಷಿಸುವುದಕ್ಕೆ ಆಜ್ಞಾಪಿಸಿರಿ.</para>
  <para style="q1" vid="PSA 71:3">ನನ್ನ ಬಂಡೆಯೂ</para>
  <para style="q2" vid="PSA 71:3">ನನ್ನ ಕೋಟೆಯೂ ನೀವೇ ಆಗಿದ್ದೀರಿ.<verse eid="PSA 71:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 71:4"/>ನನ್ನ ದೇವರೇ, ದುಷ್ಟನ ಕೈಗೂ</para>
  <para style="q2" vid="PSA 71:4">ಅನ್ಯಾಯ ಮಾಡುವವನ ಮತ್ತು ಕ್ರೂರನ ಕೈಗೂ ನನ್ನನ್ನು ಸಿಕ್ಕಿಸದಿರಿ.<verse eid="PSA 71:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 71:5"/>ಸಾರ್ವಭೌಮ ಯೆಹೋವ ದೇವರೇ, ನೀವು ನನ್ನ ನಿರೀಕ್ಷೆ ಆಗಿದ್ದೀರಿ.</para>
  <para style="q2" vid="PSA 71:5">ನನ್ನ ಯೌವನದಿಂದ ನನ್ನ ಭರವಸೆಯೂ ಆಗಿದ್ದೀರಿ.<verse eid="PSA 71:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 71:6"/>ಹುಟ್ಟಿನಿಂದ ನೀವೇ ನನ್ನ ಭರವಸೆ.</para>
  <para style="q2" vid="PSA 71:6">ತಾಯಿಯ ಗರ್ಭದಿಂದ ನೀವೇ ನನ್ನನ್ನು ಹೊರಗೆ ತಂದಿದ್ದೀರಿ.</para>
  <para style="q2" vid="PSA 71:6">ನಾನು ಯಾವಾಗಲೂ ನಿಮ್ಮನ್ನು ಸ್ತುತಿಸುತ್ತಿರುವೆನು.<verse eid="PSA 71:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 71:7"/>ಅನೇಕರು ನನ್ನ ಸ್ಥಿತಿಯನ್ನು ಕಂಡು ಆಶ್ಚರ್ಯ ಪಡುತ್ತಾರೆ.</para>
  <para style="q2" vid="PSA 71:7">ಆದರೆ ನೀವು ನನ್ನ ಬಲವಾದ ಆಶ್ರಯವಾಗಿದ್ದೀರಿ.<verse eid="PSA 71:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 71:8"/>ನನ್ನ ಬಾಯಿ ನಿಮ್ಮ ಸ್ತೋತ್ರದಿಂದ ತುಂಬಿರಲಿ.</para>
  <para style="q2" vid="PSA 71:8">ನಾನು ದಿನವೆಲ್ಲಾ ನಿಮ್ಮ ವೈಭವವನ್ನೇ ಸಾರುತ್ತಿರುವೆ.<verse eid="PSA 71:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 71:9"/>ನನ್ನ ಮುಪ್ಪಿನ ಕಾಲದಲ್ಲಿ ನನ್ನನ್ನು ತಳ್ಳಿಬಿಡಬೇಡಿರಿ.</para>
  <para style="q2" vid="PSA 71:9">ನನ್ನ ಶಕ್ತಿಯು ಕುಂದುತ್ತಿರುವಾಗ ನನ್ನನ್ನು ಕೈಬಿಡಬೇಡಿರಿ.<verse eid="PSA 71:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 71:10"/>ನನ್ನ ಶತ್ರುಗಳು ನನಗೆ ವಿರೋಧವಾಗಿ ಮಾತನಾಡುತ್ತಾರೆ;</para>
  <para style="q2" vid="PSA 71:10">ನನ್ನ ಪ್ರಾಣಕ್ಕೆ ಒಳಸಂಚು ಮಾಡುವವರು ಕೂಡಿಕೊಂಡು ದುರಾಲೋಚನೆ ಮಾಡುತ್ತಾರೆ.<verse eid="PSA 71:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 71:11"/>ಅದೇನೆಂದರೆ, “ದೇವರು ಅವನನ್ನು ಕೈಬಿಟ್ಟಿದ್ದಾನೆ.</para>
  <para style="q2" vid="PSA 71:11">ಅವನನ್ನು ಬೆನ್ನಟ್ಟಿ ಹಿಡಿಯಿರಿ,</para>
  <para style="q2" vid="PSA 71:11">ಅವನನ್ನು ಬಿಡಿಸುವವರು ಯಾರೂ ಇಲ್ಲ,” ಎನ್ನುತ್ತಾರೆ.<verse eid="PSA 71:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 71:12"/>ದೇವರೇ, ನನ್ನಿಂದ ದೂರವಾಗಿರಬೇಡಿರಿ.</para>
  <para style="q2" vid="PSA 71:12">ದೇವರೇ, ಬೇಗ ಬಂದು ನನಗೆ ಸಹಾಯಮಾಡಿರಿ.<verse eid="PSA 71:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 71:13"/>ನನ್ನನ್ನು ಆರೋಪಿಸುವವರು,</para>
  <para style="q2" vid="PSA 71:13">ನಾಚಿಕೆಪಟ್ಟು ನಾಶವಾಗಲಿ.</para>
  <para style="q2" vid="PSA 71:13">ನನ್ನ ಕೇಡಿಗಾಗಿ ಹುಡುಕುವವರನ್ನು ನಿಂದಾಪಮಾನಗಳು ಕವಿಯಲಿ.<verse eid="PSA 71:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 71:14"/>ಆದರೆ ನಾನು ಎಂದೆಂದೂ ನಿಮ್ಮನ್ನು ನಿರೀಕ್ಷಿಸುತ್ತಾ,</para>
  <para style="q2" vid="PSA 71:14">ನಿಮ್ಮನ್ನು ಇನ್ನೂ ಹೆಚ್ಚೆಚ್ಚಾಗಿ ಸ್ತುತಿಸುವೆನು.<verse eid="PSA 71:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 71:15"/>ನನ್ನ ಬಾಯಿ ದಿನವೆಲ್ಲಾ ನಿಮ್ಮ ನೀತಿಯನ್ನೂ</para>
  <para style="q2" vid="PSA 71:15">ನಿಮ್ಮ ರಕ್ಷಣೆಯನ್ನೂ ಪ್ರಕಟಿಸುವುದು.</para>
  <para style="q2" vid="PSA 71:15">ಅವುಗಳನ್ನು ವಿವರಿಸಲು ನನಗೆ ತಿಳಿಯದು.<verse eid="PSA 71:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 71:16"/>ಸಾರ್ವಭೌಮ ಯೆಹೋವ ದೇವರೇ ನಾನು ನಿಮ್ಮ ಮಹಾಕೃತ್ಯಗಳನ್ನು ಸಾರುವೆನು.</para>
  <para style="q2" vid="PSA 71:16">ನಿಮ್ಮ ನೀತಿ ಕೃತ್ಯಗಳನ್ನು ಪ್ರಕಟಪಡಿಸುವೆನು.<verse eid="PSA 71:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 71:17"/>ದೇವರೇ, ನನ್ನ ಯೌವನದಿಂದ ನನಗೆ ನೀವು ಕಲಿಸಿದ್ದೀರಿ.</para>
  <para style="q2" vid="PSA 71:17">ಈವರೆಗೂ ನಿಮ್ಮ ಅದ್ಭುತಕಾರ್ಯಗಳನ್ನು ಘೋಷಿಸುತ್ತಿದ್ದೇನೆ.<verse eid="PSA 71:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 71:18"/>ದೇವರೇ, ನಾನು ಮುಪ್ಪಿನವನೂ, ನೆರೆಕೂದಲಿನವನೂ ಆದಾಗ</para>
  <para style="q2" vid="PSA 71:18">ಈ ಸಂತತಿಯವರಿಗೆ ನಿಮ್ಮ ಶಕ್ತಿಯನ್ನೂ,</para>
  <para style="q1" vid="PSA 71:18">ಮುಂದಿನ ಪೀಳಿಗೆಗೆ ನಿಮ್ಮ ಪರಾಕ್ರಮವನ್ನೂ ತಿಳಿಸುವವರೆಗೂ</para>
  <para style="q2" vid="PSA 71:18">ನನ್ನನ್ನು ಕೈಬಿಡಬೇಡಿರಿ.<verse eid="PSA 71:18"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 71:19"/>ದೇವರೇ, ನಿಮ್ಮ ನೀತಿಯು ಆಕಾಶವನ್ನು ಮುಟ್ಟುತ್ತದೆ.</para>
  <para style="q2" vid="PSA 71:19">ಮಹತ್ಕಾರ್ಯಗಳನ್ನು ಮಾಡಿದ ದೇವರೇ,</para>
  <para style="q2" vid="PSA 71:19">ನಿಮ್ಮ ಹಾಗೆ ಯಾರಿದ್ದಾರೆ?<verse eid="PSA 71:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 71:20"/>ಅನೇಕ ಕಠಿಣವಾದ ಇಕ್ಕಟ್ಟುಗಳನ್ನು</para>
  <para style="q2" vid="PSA 71:20">ನೋಡ ಮಾಡಿದ ನನ್ನನ್ನು</para>
  <para style="q2" vid="PSA 71:20">ನೀವು ತಿರುಗಿ ಬದುಕಿಸಿದ್ದೀರಿ.</para>
  <para style="q1" vid="PSA 71:20">ಭೂಮಿಯ ಅಧೋಭಾಗದಿಂದ</para>
  <para style="q2" vid="PSA 71:20">ಪುನಃ ನನ್ನನ್ನು ಮೇಲಕ್ಕೆ ಎತ್ತುವಿರಿ.<verse eid="PSA 71:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 71:21"/>ನೀವು ನನ್ನ ಗೌರವವನ್ನು ಹೆಚ್ಚಿಸಿ</para>
  <para style="q2" vid="PSA 71:21">ನನ್ನನ್ನು ಮತ್ತೊಮ್ಮೆ ಆದರಿಸಿರಿ.<verse eid="PSA 71:21"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 71:22"/>ನನ್ನ ದೇವರೇ, ನಾನು ನಿಮ್ಮನ್ನು ಸ್ತುತಿಸುವೆನು.</para>
  <para style="q2" vid="PSA 71:22">ನಿಮ್ಮ ನಂಬಿಗಸ್ತಿಕೆಗಾಗಿ ವೀಣೆಯಿಂದ ಕೊಂಡಾಡುವೆನು.</para>
  <para style="q1" vid="PSA 71:22">ಇಸ್ರಾಯೇಲರ ಪರಿಶುದ್ಧರೇ,</para>
  <para style="q2" vid="PSA 71:22">ಕಿನ್ನರಿಯಿಂದ ನಿಮ್ಮನ್ನು ಸ್ತುತಿಸುವೆನು.<verse eid="PSA 71:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 71:23"/>ನೀವು ನನ್ನನ್ನು ಬಿಡಿಸಿದ್ದಕ್ಕಾಗಿ</para>
  <para style="q2" vid="PSA 71:23">ನನ್ನ ತುಟಿಗಳು ಆನಂದದಿಂದ</para>
  <para style="q2" vid="PSA 71:23">ಹಾಡಿ ಸ್ತುತಿಸುತ್ತವೆ.<verse eid="PSA 71:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 71:24"/>ನನ್ನ ನಾಲಿಗೆಯು ಸಹ ದಿನವೆಲ್ಲಾ</para>
  <para style="q2" vid="PSA 71:24">ನಿಮ್ಮ ನೀತಿಯನ್ನು ಮಾತನಾಡುವುದು,</para>
  <para style="q1" vid="PSA 71:24">ಏಕೆಂದರೆ ನನಗೆ ಕೇಡು ಬಗೆಯುವವರು</para>
  <para style="q2" vid="PSA 71:24">ನಾಚಿಕೊಂಡು ತಲೆ ತಗ್ಗಿಸಿದ್ದಾರೆ.<verse eid="PSA 71:24"/></para>
  <chapter eid="PSA 71"/>
  <chapter number="72" style="c" sid="PSA 72"/>
  <para style="cl">ಕೀರ್ತನೆ 72</para>
  <para style="d">ಸೊಲೊಮೋನನ ಕೀರ್ತನೆ.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 72:1"/>ದೇವರೇ, ನಿಮ್ಮ ನ್ಯಾಯವನ್ನು ಅರಸನಿಗೆ ಕಲಿಸಿಕೊಡಿರಿ.</para>
  <para style="q2" vid="PSA 72:1">ನಿಮ್ಮ ನೀತಿಯನ್ನು ರಾಜಕುಮಾರನಿಗೆ ಕಲಿಸಿಕೊಡಿರಿ.<verse eid="PSA 72:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 72:2"/>ಅರಸನು ನಿಮ್ಮ ಜನರಿಗೆ ನೀತಿಯಿಂದಲೂ</para>
  <para style="q2" vid="PSA 72:2">ನಿಮ್ಮ ಬಾಧೆಪಟ್ಟ ಪ್ರಜೆಗೆ ನ್ಯಾಯದಿಂದಲೂ ತೀರ್ಪುಮಾಡಲಿ.<verse eid="PSA 72:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 72:3"/>ಬೆಟ್ಟಗುಡ್ಡಗಳಿಂದ ಸಮೃದ್ಧಿಯೂ</para>
  <para style="q2" vid="PSA 72:3">ನೀತಿಯ ಫಲವೂ ಜನರಿಗೆ ಬರಲಿ.<verse eid="PSA 72:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 72:4"/>ಅರಸನು ಬಡವರ ನ್ಯಾಯ ಸ್ಥಾಪಿಸಲಿ.</para>
  <para style="q2" vid="PSA 72:4">ಅವನು ಅಗತ್ಯತೆಯಲ್ಲಿರುವವರ ಮಕ್ಕಳನ್ನು ರಕ್ಷಿಸಲಿ.</para>
  <para style="q2" vid="PSA 72:4">ದಬ್ಬಾಳಿಕೆ ಮಾಡುವವರನ್ನು ದಂಡಿಸಲಿ.<verse eid="PSA 72:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 72:5"/>ಸೂರ್ಯನೂ ಚಂದ್ರನೂ ಇರುವವರೆಗೆ</para>
  <para style="q2" vid="PSA 72:5">ತಲತಲಾಂತರಗಳು ಜನರು ಅರಸನಿಗೆ ಭಯಪಡಲಿ.<verse eid="PSA 72:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 72:6"/>ಕೊಯ್ದ ಹುಲ್ಲಿನ ಮೇಲೆ ಬೀಳುವ ಮಳೆಯ ಹಾಗೆಯೂ,</para>
  <para style="q2" vid="PSA 72:6">ಭೂಮಿಯನ್ನು ನೆನಸುತ್ತಾ ಸುರಿಯುವ ಮಳೆಗಳ ಹಾಗೆಯೂ ಅರಸನು ಇರಲಿ.<verse eid="PSA 72:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 72:7"/>ಅರಸನ ದಿವಸಗಳಲ್ಲಿ ನೀತಿವಂತರು ವೃದ್ಧಿ ಆಗಲಿ.</para>
  <para style="q2" vid="PSA 72:7">ಸಮೃದ್ಧಿಯಾದ ಸಮಾಧಾನವು ಚಂದ್ರನು ಇರುವವರೆಗೂ ಇರಲಿ.<verse eid="PSA 72:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 72:8"/>ಸಮುದ್ರದಿಂದ ಸಮುದ್ರದವರೆಗೂ</para>
  <para style="q2" vid="PSA 72:8">ನದಿಯಿಂದ ಭೂಮಿಯ ಕೊನೆಗಳವರೆಗೂ ಅರಸನು ಆಳಲಿ.<verse eid="PSA 72:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 72:9"/>ಅರಸನ ಮುಂದೆ ಮರುಭೂಮಿಯ ನಿವಾಸಿಗಳು ಎರಗಲಿ.</para>
  <para style="q2" vid="PSA 72:9">ಅರಸನ ಶತ್ರುಗಳು ಧೂಳನ್ನು ನೆಕ್ಕಲಿ.<verse eid="PSA 72:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 72:10"/>ತಾರ್ಷೀಷಿನ ಅರಸರೂ</para>
  <para style="q2" vid="PSA 72:10">ದ್ವೀಪಗಳ ಅರಸರೂ ಕಾಣಿಕೆಗಳನ್ನು ಅರಸನಿಗೆ ಸಲ್ಲಿಸಲಿ.</para>
  <para style="q1" vid="PSA 72:10">ಶೆಬ ಮತ್ತು ಸೆಬದ ಅರಸರು</para>
  <para style="q2" vid="PSA 72:10">ದಾನಗಳನ್ನು ತಂದೊಪ್ಪಿಸಲಿ.<verse eid="PSA 72:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 72:11"/>ಹೌದು, ಎಲ್ಲಾ ಅರಸರು ನಮ್ಮ ಅರಸನ ಮುಂದೆ ಅಡ್ಡಬೀಳಲಿ.</para>
  <para style="q2" vid="PSA 72:11">ಎಲ್ಲಾ ಜನಾಂಗಗಳು ಅರಸನಿಗೆ ಸೇವೆಸಲ್ಲಿಸಲಿ.<verse eid="PSA 72:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 72:12"/>ಏಕೆಂದರೆ ಅರಸನಿಗೆ ಮೊರೆಯಿಡುವ ಬಡವರನ್ನೂ</para>
  <para style="q2" vid="PSA 72:12">ಸಹಾಯಕನಿಲ್ಲದ ಬಾಧೆಪಡುವವರನ್ನೂ ಬಿಡಿಸುವನು.<verse eid="PSA 72:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 72:13"/>ದರಿದ್ರನನ್ನೂ, ಬಡವನನ್ನೂ ಕರುಣಿಸುವನು.</para>
  <para style="q2" vid="PSA 72:13">ಬಡವರ ಪ್ರಾಣಗಳನ್ನು ರಕ್ಷಿಸುವನು.<verse eid="PSA 72:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 72:14"/>ಮೋಸ ದಬ್ಬಾಳಿಕೆಯಿಂದ ಜನರನ್ನು ಬಿಡುಗಡೆ ಮಾಡುವನು.</para>
  <para style="q2" vid="PSA 72:14">ಜನರ ಜೀವವು ಆತನ ದೃಷ್ಟಿಯಲ್ಲಿ ಅಮೂಲ್ಯವಾಗಿರುವುದು.<verse eid="PSA 72:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 72:15"/>ಅರಸನು ಬಾಳಲಿ.</para>
  <para style="q2" vid="PSA 72:15">ಆತನಿಗೆ ಶೆಬದ ಚಿನ್ನವನ್ನು ಕೊಡಲಿ.</para>
  <para style="q1" vid="PSA 72:15">ಆತನಿಗೋಸ್ಕರ ಯಾವಾಗಲೂ ಪ್ರಾರ್ಥನೆ ಮಾಡಲಿ.</para>
  <para style="q2" vid="PSA 72:15">ಇಡೀ ದಿನ ಆತನಿಗೆ ಆಶೀರ್ವಾದಗಳು ಉಂಟಾಗಲಿ.<verse eid="PSA 72:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 72:16"/>ಧಾನ್ಯದ ಸಮೃದ್ಧಿಯು ದೇಶದಲ್ಲಿ</para>
  <para style="q2" vid="PSA 72:16">ಬೆಟ್ಟಗಳ ತುದಿಯವರೆಗೂ ಇರಲಿ;</para>
  <para style="q1" vid="PSA 72:16">ಅದರ ಫಲವು ಲೆಬನೋನಿನ ಹಾಗೆ ಸಮೃದ್ಧಿಯಾಗಲಿ;</para>
  <para style="q2" vid="PSA 72:16">ಪಟ್ಟಣದವರು ಭೂಮಿಯ ಸೊಪ್ಪಿನ ಹಾಗೆ ವೃದ್ಧಿ ಆಗಲಿ.<verse eid="PSA 72:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 72:17"/>ಅರಸನ ನಾಮವು ಎಂದೆಂದಿಗೂ ಇರಲಿ.</para>
  <para style="q2" vid="PSA 72:17">ಸೂರ್ಯನಿರುವವರೆಗೂ ಆತನ ಹೆಸರು ಇರಲಿ.</para>
  <para style="b" vid="PSA 72:17"/>
  <para style="q1" vid="PSA 72:17">ಮನುಷ್ಯರು ಅರಸನಲ್ಲಿ ಆಶೀರ್ವಾದ ಹೊಂದಲಿ.</para>
  <para style="q2" vid="PSA 72:17">ಎಲ್ಲಾ ಜನಾಂಗಗಳು ಆತನನ್ನು ಭಾಗ್ಯವಂತನೆಂದು ಕರೆಯಲಿ.<verse eid="PSA 72:17"/></para>
  <para style="b"/>
  <para style="b"/>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 72:18"/>ಅದ್ಭುತಗಳನ್ನು ಮಾಡುವುದರಲ್ಲಿ ಸರಿಸಾಟಿಯಿಲ್ಲದ</para>
  <para style="q2" vid="PSA 72:18">ಇಸ್ರಾಯೇಲರ ದೇವರಾಗಿರುವ ಯೆಹೋವ ದೇವರಿಗೆ ಸ್ತೋತ್ರವಾಗಲಿ.<verse eid="PSA 72:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 72:19"/>ದೇವರ ಘನವುಳ್ಳ ಹೆಸರಿಗೆ ಎಂದೆಂದಿಗೂ ಸ್ತೋತ್ರವಾಗಲಿ.</para>
  <para style="q2" vid="PSA 72:19">ದೇವರ ತೇಜಸ್ಸು ಭೂಮಿಯಲ್ಲೆಲ್ಲಾ ತುಂಬಲಿ.</para>
  <para style="qc" vid="PSA 72:19">ಆಮೆನ್, ಆಮೆನ್.<verse eid="PSA 72:19"/></para>
  <para style="b"/>
  <para style="b"/>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 72:20"/>ಇಷಯನ ಮಗ ದಾವೀದನ ಪ್ರಾರ್ಥನೆಗಳು ಇಲ್ಲಿಗೆ ಮುಕ್ತಾಯವಾಗುತ್ತವೆ.<verse eid="PSA 72:20"/></para>
  <chapter eid="PSA 72"/>
  <chapter number="73" style="c" sid="PSA 73"/>
  <para style="ms">ಭಾಗ 3</para>
  <para style="mr">ಕೀರ್ತನೆಗಳು <ref loc="PSA 73-89">73–89</ref></para>
  <para style="cl">ಕೀರ್ತನೆ 73</para>
  <para style="d">ಆಸಾಫನ ಕೀರ್ತನೆ.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 73:1"/>ದೇವರು ನಿಜವಾಗಿಯೂ ಇಸ್ರಾಯೇಲಿಗೂ</para>
  <para style="q2" vid="PSA 73:1">ಶುದ್ಧ ಹೃದಯದವರಿಗೂ ಒಳ್ಳೆಯವರು.<verse eid="PSA 73:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 73:2"/>ನನ್ನ ಪಾದಗಳು ಬಹಳಮಟ್ಟಿಗೆ ತಪ್ಪುವ ಹಾಗಿದ್ದವು.</para>
  <para style="q2" vid="PSA 73:2">ನನ್ನ ಹೆಜ್ಜೆಗಳು ಜಾರುವುದಕ್ಕೆ ಬಹು ಸಮೀಪವಾಗಿದ್ದವು.<verse eid="PSA 73:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 73:3"/>ಏಕೆಂದರೆ ನಾನು ದುಷ್ಟರ ಸೌಭಾಗ್ಯವನ್ನು ಕಂಡಾಗ</para>
  <para style="q2" vid="PSA 73:3">ಮೂರ್ಖರ ಮೇಲೆ ಹೊಟ್ಟೆಕಿಚ್ಚುಪಟ್ಟೆನು.<verse eid="PSA 73:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 73:4"/>ಏಕೆಂದರೆ ಅವರಿಗೆ ಹೋರಾಟಗಳು ಇಲ್ಲ.</para>
  <para style="q2" vid="PSA 73:4">ಅವರ ದೇಹವು ಆರೋಗ್ಯಕರ ಮತ್ತು ದೃಢವಾಗಿದೆ.<verse eid="PSA 73:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 73:5"/>ಇತರರ ಹಾಗೆ ಅವರಿಗೆ ಯಾವುದೇ ಹೊರೆ ಇಲ್ಲ</para>
  <para style="q2" vid="PSA 73:5">ಮಾನವರಿಗೆ ತಗುಲುವ ಯಾವುದೇ ವ್ಯಾಧಿಯೂ ಅವರಿಗೆ ತಗುಲುವುದಿಲ್ಲ.<verse eid="PSA 73:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 73:6"/>ಆದ್ದರಿಂದ ಗರ್ವವು ಕಂಠಮಾಲೆಯಂತೆ ಅವರನ್ನು ಸುತ್ತಿದೆ.</para>
  <para style="q2" vid="PSA 73:6">ದಬ್ಬಾಳಿಕೆ ಅವರನ್ನು ಬಟ್ಟೆಯ ಹಾಗೆ ಮುಚ್ಚುತ್ತಿದೆ.<verse eid="PSA 73:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 73:7"/>ಅವರ ಹೃದಯವು ಕೊಬ್ಬಿನಿಂದ ಉಬ್ಬಿಕೊಂಡಿರುತ್ತವೆ;</para>
  <para style="q2" vid="PSA 73:7">ಅವರ ದುಷ್ಕಲ್ಪನೆಗಳಿಗೆ ಮಿತಿಯೇ ಇಲ್ಲ.<verse eid="PSA 73:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 73:8"/>ಅವರು ಹಾಸ್ಯಮಾಡುವವರಾಗಿ ಕೇಡನ್ನೇ ಮಾತನಾಡುತ್ತಾರೆ</para>
  <para style="q2" vid="PSA 73:8">ದಬ್ಬಾಳಿಕೆ ಮಾಡಲು ಗರ್ವದಿಂದ ಅವರು ಬೆದರಿಕೆ ಹಾಕುತ್ತಾರೆ.<verse eid="PSA 73:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 73:9"/>ಪರಲೋಕಕ್ಕೆ ವಿರೋಧವಾಗಿ ತಮ್ಮ ಬಾಯನ್ನು ತೆರೆದಿದ್ದಾರೆ.</para>
  <para style="q2" vid="PSA 73:9">ಭೂಲೋಕದಲ್ಲೆಲ್ಲಾ ಅವರ ಮಾತು ಮುಂದುವರೆದಿದೆ.<verse eid="PSA 73:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 73:10"/>ಆದ್ದರಿಂದ ಜನರು ಅವರ ಕಡೆಗೆ ತಿರುಗುತ್ತಾರೆ.</para>
  <para style="q2" vid="PSA 73:10">ಜನರಿಗೆ ಅವರ ಮಾತು ಬಹಳವಾಗಿ ದೊರೆಯುತ್ತದೆ.<verse eid="PSA 73:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 73:11"/>ಅವರು, “ದೇವರಿಗೆ ಹೇಗೆ ಗೊತ್ತಾಗುವುದು?</para>
  <para style="q2" vid="PSA 73:11">ಮಹೋನ್ನತನಿಗೆ ಏನಾದರೂ ತಿಳಿಯಲು ಸಾಧ್ಯವೇ?” ಎನ್ನುತ್ತಾರೆ.<verse eid="PSA 73:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 73:12"/>ದುಷ್ಟರು ನಿಶ್ಚಿಂತರಾಗಿ,</para>
  <para style="q2" vid="PSA 73:12">ಐಶ್ವರ್ಯದಲ್ಲಿ ಇವರು ಹೆಚ್ಚುತ್ತಾರೆ.<verse eid="PSA 73:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 73:13"/>ನನ್ನ ಹೃದಯವನ್ನು ಶುದ್ಧ ಮಾಡಿಕೊಂಡಿದ್ದು ವ್ಯರ್ಥವೋ?</para>
  <para style="q2" vid="PSA 73:13">ನನ್ನ ಅಂಗೈಗಳನ್ನು ನಿರಪರಾಧದಲ್ಲಿ ತೊಳೆದಿದ್ದೂ ವ್ಯರ್ಥವೋ?<verse eid="PSA 73:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 73:14"/>ಏಕೆಂದರೆ ನಾನು ದಿನವೆಲ್ಲಾ ಬಾಧೆಪಡುತ್ತಿದ್ದೇನೆ.</para>
  <para style="q2" vid="PSA 73:14">ಪ್ರತಿ ಉದಯವೂ ನನಗೆ ಹೊಸ ಶಿಕ್ಷೆಯಾಗುತ್ತಿದೆ.<verse eid="PSA 73:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 73:15"/>ನಾನು ಈ ಪ್ರಕಾರ ಬಾಯಿತೆರೆದು ಮಾತಾಡಿದ್ದರೆ,</para>
  <para style="q2" vid="PSA 73:15">ನಿಮ್ಮ ಪ್ರಜೆಗೆ ದ್ರೋಹಿಯಾಗುತ್ತಿದ್ದೆನು.<verse eid="PSA 73:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 73:16"/>ಇದನ್ನೆಲ್ಲಾ ತಿಳಿದುಕೊಳ್ಳುವುದಕ್ಕೆ ನಾನು ಪ್ರಯತ್ನಿಸಿದಾಗ,</para>
  <para style="q2" vid="PSA 73:16">ಅದು ನನಗೆ ಬಹಳವಾಗಿ ಕಷ್ಟಕರವಾಗಿತ್ತು.<verse eid="PSA 73:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 73:17"/>ನಾನು ದೇವರ ಪರಿಶುದ್ಧ ಆಲಯಕ್ಕೆ ಬರುವವರೆಗೆ ನನಗೆ ಅರ್ಥವಾಗಲಿಲ್ಲ.</para>
  <para style="q2" vid="PSA 73:17">ಅನಂತರ ಅವರ ಅಂತ್ಯವನ್ನು ನನಗೆ ಅರ್ಥವಾಯಿತು.<verse eid="PSA 73:17"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 73:18"/>ನಿಶ್ಚಯವಾಗಿ ನೀವು ಜಾರುವ ಸ್ಥಳಗಳಲ್ಲಿ ಅವರನ್ನು ಬಿಟ್ಟಿದ್ದೀರಿ.</para>
  <para style="q2" vid="PSA 73:18">ಅವರನ್ನು ದಂಡಿಸಿಬಿಡು.<verse eid="PSA 73:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 73:19"/>ಕ್ಷಣಮಾತ್ರದಲ್ಲಿ ಅವರು ನಾಶವಾದರು.</para>
  <para style="q2" vid="PSA 73:19">ಅವರು ದಿಗಿಲುಬಿದ್ದು ಸಂಪೂರ್ಣವಾಗಿ ನಾಶವಾದರು.<verse eid="PSA 73:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 73:20"/>ಅವರು ನಿದ್ದೆಯಿಂದ ಎಚ್ಚರಗೊಂಡ ಕನಸಿನಂತೆ ಇರುತ್ತಾರೆ.</para>
  <para style="q2" vid="PSA 73:20">ಯೆಹೋವ ದೇವರೇ, ನಿಮ್ಮ ದೃಷ್ಟಿಯಲ್ಲಿ</para>
  <para style="q2" vid="PSA 73:20">ಅವರು ಅಲ್ಪರಾಗಿರಲಿ.<verse eid="PSA 73:20"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 73:21"/>ನನ್ನ ಹೃದಯವು ದುಃಖಗೊಂಡು,</para>
  <para style="q2" vid="PSA 73:21">ನನ್ನ ಆತ್ಮವು ಕಹಿಗೊಂಡಿತು.<verse eid="PSA 73:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 73:22"/>ಆಗ ನಾನು ಮೂರ್ಖನಾಗಿ ಏನೂ ತಿಳಿಯದೆ</para>
  <para style="q2" vid="PSA 73:22">ನಿಮ್ಮ ಮುಂದೆ ಪಶುವಿನಂತೆ ಇದ್ದೆನು.<verse eid="PSA 73:22"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 73:23"/>ಆದರೂ ನಾನು ನಿಮ್ಮ ಸಂಗಡ ಯಾವಾಗಲೂ ಇದ್ದೇನೆ.</para>
  <para style="q2" vid="PSA 73:23">ನೀವು ನನ್ನ ಬಲಗೈಯನ್ನು ಹಿಡಿದಿದ್ದೀರಿ.<verse eid="PSA 73:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 73:24"/>ನಿಮ್ಮ ಆಲೋಚನೆಯಂತೆ ನನ್ನನ್ನು ನಡೆಸಿ,</para>
  <para style="q2" vid="PSA 73:24">ತರುವಾಯ ಮಹಿಮೆಗೆ ನನ್ನನ್ನು ಸೇರಿಸುವಿರಿ.<verse eid="PSA 73:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 73:25"/>ಪರಲೋಕದಲ್ಲಿ ನನಗೆ ನೀವಲ್ಲದೆ ಮತ್ಯಾರಿದ್ದಾರೆ?</para>
  <para style="q2" vid="PSA 73:25">ಇಹಲೋಕದಲ್ಲಿ ನಿಮ್ಮನ್ನಲ್ಲದೆ ಇನ್ನಾರನ್ನೂ ನಾನು ಬಯಸುವುದಿಲ್ಲ.<verse eid="PSA 73:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 73:26"/>ನನ್ನ ತನುಮನಗಳು ಕುಂದುತ್ತವೆ;</para>
  <para style="q2" vid="PSA 73:26">ಆದರೆ ದೇವರು ಯುಗಯುಗಕ್ಕೂ ನನ್ನ ಹೃದಯದ ಬಲವೂ,</para>
  <para style="q2" vid="PSA 73:26">ನನ್ನ ಪಾಲೂ ಆಗಿದ್ದಾರೆ.<verse eid="PSA 73:26"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 73:27"/>ದೇವರೇ, ನಿಮ್ಮಿಂದ ದೂರವಾಗಿರುವವರು ನಾಶವಾಗುತ್ತಾರೆ;</para>
  <para style="q2" vid="PSA 73:27">ನಿಮ್ಮನ್ನು ಬಿಟ್ಟು ದ್ರೋಹ ಮಾಡುವವರೆಲ್ಲರೂ ದಂಡನೆಗೆ ಗುರಿಯಾಗುವರು.<verse eid="PSA 73:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 73:28"/>ನನಗಾದರೋ ದೇವರ ಸಮೀಪಕ್ಕೆ ಬರುವುದೇ ಒಳ್ಳೆಯದು.</para>
  <para style="q2" vid="PSA 73:28">ನಿಮ್ಮ ಕ್ರಿಯೆಗಳನ್ನೆಲ್ಲಾ ಸಾರುವುದಕ್ಕೆ</para>
  <para style="q2" vid="PSA 73:28">ಸಾರ್ವಭೌಮ ಯೆಹೋವ ದೇವರಲ್ಲಿ ನನ್ನ ಭರವಸೆಯನ್ನು ಇಟ್ಟಿದ್ದೇನೆ.<verse eid="PSA 73:28"/></para>
  <chapter eid="PSA 73"/>
  <chapter number="74" style="c" sid="PSA 74"/>
  <para style="cl">ಕೀರ್ತನೆ 74</para>
  <para style="d">ಆಸಾಫನ <char style="tl">ಮಾಸ್ಕಿಲ</char> ರಾಗದ ಕೀರ್ತನೆ.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 74:1"/>ದೇವರೇ, ಸದಾಕಾಲಕ್ಕೆ ನಮ್ಮನ್ನು ತಳ್ಳಿಬಿಟ್ಟದ್ದೇಕೆ?</para>
  <para style="q2" vid="PSA 74:1">ನಿಮ್ಮ ಮೇವಿನ ಕುರಿಮಂದೆಯ ವಿಷಯವಾಗಿ ಬೇಸರಗೊಳ್ಳುವುದು ಏಕೆ?<verse eid="PSA 74:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 74:2"/>ಪೂರ್ವಕಾಲದಲ್ಲಿ ನೀವು ಕೊಂಡುಕೊಂಡ ನಿಮ್ಮ ಜನರನ್ನೂ</para>
  <para style="q2" vid="PSA 74:2">ನೀವು ವಿಮೋಚಿಸಿದ ನಿಮ್ಮ ಬಾಧ್ಯತೆಯನ್ನೂ</para>
  <para style="q2" vid="PSA 74:2">ನೀವು ವಾಸಮಾಡಿದ ಚೀಯೋನ್ ಪರ್ವತವನ್ನೂ ಜ್ಞಾಪಕಮಾಡಿಕೊಳ್ಳಿರಿ.<verse eid="PSA 74:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 74:3"/>ನಿತ್ಯ ನಾಶವಾದ ಈ ಪ್ರದೇಶಗಳ ಕಡೆಗೂ</para>
  <para style="q2" vid="PSA 74:3">ಈ ಪರಿಶುದ್ಧ ನಿವಾಸವನ್ನು ವೈರಿಗಳು ಹಾಳುಮಾಡಿದ್ದರ</para>
  <para style="q2" vid="PSA 74:3">ಕಡೆಗೂ ನಿಮ್ಮ ಹೆಜ್ಜೆಗಳನ್ನು ತಿರುಗಿಸಿರಿ.<verse eid="PSA 74:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 74:4"/>ನಿಮ್ಮ ವೈರಿಗಳು ನೀವು ನಮ್ಮನ್ನು ಸಂಧಿಸಿದ ಸ್ಥಳದಲ್ಲಿ ಗರ್ಜಿಸುತ್ತಾರೆ.</para>
  <para style="q2" vid="PSA 74:4">ತಮ್ಮ ಗುರುತುಗಳನ್ನು ಆರಾಧನಾ ಚಿಹ್ನೆಗಳಾಗಿ ಇಟ್ಟಿದ್ದಾರೆ.<verse eid="PSA 74:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 74:5"/>ದಟ್ಟವಾದ ಮರಗಳ ಮಧ್ಯೆ ಕೊಡಲಿ ಎತ್ತುವವನ</para>
  <para style="q2" vid="PSA 74:5">ಹಾಗೆ ಆ ಜನರು ವರ್ತಿಸಿದ್ದಾರೆ.<verse eid="PSA 74:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 74:6"/>ಈಗ ಚಿತ್ರ ಕೆಲಸಗಳನ್ನು ತಕ್ಷಣ ಕೊಡಲಿಯಿಂದಲೂ</para>
  <para style="q2" vid="PSA 74:6">ಸುತ್ತಿಗೆಯಿಂದಲೂ ಅವರು ಹೊಡೆದು ಹಾಕುತ್ತಿದ್ದಾರೆ.<verse eid="PSA 74:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 74:7"/>ನಿಮ್ಮ ಪರಿಶುದ್ಧ ಸ್ಥಳಕ್ಕೆ ಬೆಂಕಿಹಚ್ಚಿದ್ದಾರೆ.</para>
  <para style="q2" vid="PSA 74:7">ನಿಮ್ಮ ಹೆಸರಿನ ನಿವಾಸವನ್ನು ಭೂಮಿಗೆ ಕೆಡವಿ ಅಪವಿತ್ರಗೊಳಿಸಿದ್ದಾರೆ.<verse eid="PSA 74:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 74:8"/>“ಅವುಗಳನ್ನು ಒಟ್ಟಾಗಿ ಕೆಡವಿಬಿಡೋಣ,”</para>
  <para style="q2" vid="PSA 74:8">ಎಂದು ತಮ್ಮ ಹೃದಯದಲ್ಲಿ ಹೇಳಿಕೊಳ್ಳುತ್ತಾರೆ.</para>
  <para style="q2" vid="PSA 74:8">ದೇಶದಲ್ಲಿರುವ ದೇವರ ಸಭಾಸ್ಥಾನಗಳನ್ನೆಲ್ಲಾ ಸುಟ್ಟುಬಿಟ್ಟಿದ್ದಾರೆ.<verse eid="PSA 74:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 74:9"/>ದೇವರಿಂದ ನಮಗೆ ಅದ್ಭುತವಾದ ಸಂಕೇತಗಳು ಕೊಟ್ಟಿರುವುದಿಲ್ಲ.</para>
  <para style="q2" vid="PSA 74:9">ಪ್ರವಾದಿಗಳು ನಮಗೆ ಉಳಿದಿರುವುದಿಲ್ಲ.</para>
  <para style="q2" vid="PSA 74:9">ಇದು ಎಷ್ಟು ಕಾಲ ಎಂದು ನಾವ್ಯಾರೂ ತಿಳಿದಿರುವುದಿಲ್ಲ.<verse eid="PSA 74:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 74:10"/>ದೇವರೇ, ವೈರಿಯು ನಿಂದಿಸುವುದು ಎಷ್ಟರವರೆಗೆ?</para>
  <para style="q2" vid="PSA 74:10">ಶತ್ರುವು ನಿಮ್ಮ ಹೆಸರನ್ನು ಎಂದೆಂದಿಗೂ ದೂಷಿಸುವನೋ?<verse eid="PSA 74:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 74:11"/>ಏಕೆ ನಿಮ್ಮ ಕೈಯನ್ನು, ನಿಮ್ಮ ಬಲಗೈಯನ್ನು ಸಹ ಹಿಂದೆಳೆಯುತ್ತೀರಿ?</para>
  <para style="q2" vid="PSA 74:11">ನಿಮ್ಮ ಎದೆಯೊಳಗಿಂದ ಅದನ್ನು ಹೊರಗೆ ತೆಗೆದು ಅವರನ್ನು ದಂಡಿಸಿರಿ.<verse eid="PSA 74:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 74:12"/>ದೇವರೇ, ನೀವು ಪೂರ್ವದಿಂದಲೂ ನನ್ನ ಅರಸರಾಗಿದ್ದೀರಿ.</para>
  <para style="q2" vid="PSA 74:12">ಭೂಲೋಕಕ್ಕೆ ರಕ್ಷಣೆಯನ್ನು ತರುವವರೂ ನೀವೇ ಆಗಿದ್ದೀರಿ.<verse eid="PSA 74:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 74:13"/>ನೀವು ನಿಮ್ಮ ಬಲದಿಂದ ಸಮುದ್ರವನ್ನು ವಿಭಾಗಿಸಿದ್ದೀರಿ.</para>
  <para style="q2" vid="PSA 74:13">ತಿಮಿಂಗಿಲಗಳ ತಲೆಗಳನ್ನು ನೀರಿನಲ್ಲಿ ಬಡಿಸಿದ್ದೀರಿ.<verse eid="PSA 74:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 74:14"/>ನೀವು ಲಿವ್ಯಾತಾನ ಮೃಗದ ತಲೆಗಳನ್ನು ಬಡೆದಿರಲು</para>
  <para style="q2" vid="PSA 74:14">ಅದನ್ನು ಮರುಭೂಮಿಯ ಜೀವಜಂತುಗಳಿಗೆ ಆಹಾರವಾಗಿ ಕೊಟ್ಟಿದ್ದೀರಿ.<verse eid="PSA 74:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 74:15"/>ನೀವು ಬುಗ್ಗೆಯನ್ನೂ, ಪ್ರವಾಹವನ್ನೂ ವಿಭಾಗ ಮಾಡಿದ್ದೀರಿ.</para>
  <para style="q2" vid="PSA 74:15">ನೀವು ಯಾವಾಗಲೂ ತುಂಬಿ ಹರಿಯುವ ನದಿಗಳನ್ನು ಒಣಗಿಸಿದ್ದೀರಿ.<verse eid="PSA 74:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 74:16"/>ಹಗಲು ನಿಮ್ಮದು, ರಾತ್ರಿಯು ಸಹ ನಿಮ್ಮದು.</para>
  <para style="q2" vid="PSA 74:16">ನೀವು ಸೂರ್ಯಚಂದ್ರನನ್ನೂ ಸ್ಥಾಪಿಸಿದ್ದೀರಿ.<verse eid="PSA 74:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 74:17"/>ನೀವು ಭೂಮಿಯ ಮೇರೆಗಳನ್ನೆಲ್ಲಾ ನಿರ್ಣಯಿಸಿದ್ದೀರಿ.</para>
  <para style="q2" vid="PSA 74:17">ಬೇಸಿಗೆ ಮತ್ತು ಚಳಿಗಾಲವನ್ನು ನೀವು ನಿರ್ಮಿಸಿದ್ದೀರಿ.<verse eid="PSA 74:17"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 74:18"/>ಮೂರ್ಖರು ನಿಮ್ಮ ನಾಮವನ್ನು ನಿಂದಿಸುತ್ತಾರೆ.</para>
  <para style="q2" vid="PSA 74:18">ಶತ್ರುಗಳು ನಿಮ್ಮನ್ನು ಹಾಸ್ಯಮಾಡುತ್ತಾರೆ.</para>
  <para style="q2" vid="PSA 74:18">ಯೆಹೋವ ದೇವರೇ, ಇದನ್ನು ಜ್ಞಾಪಕಮಾಡಿಕೊಳ್ಳಿರಿ.<verse eid="PSA 74:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 74:19"/>ನಿಮ್ಮ ಪಾರಿವಾಳದ ಪ್ರಾಣವನ್ನು ದುಷ್ಟಮೃಗಗಳಿಗೆ ಒಪ್ಪಿಸಕೊಡಬೇಡಿರಿ.</para>
  <para style="q2" vid="PSA 74:19">ನಿಮ್ಮ ದೀನರ ಮಂಡಳಿಯನ್ನು ಸದಾಕಾಲಕ್ಕೆ ಮರೆತುಬಿಡಬೇಡಿರಿ.<verse eid="PSA 74:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 74:20"/>ಒಡಂಬಡಿಕೆಗೆ ಗೌರವವನ್ನು ಕೊಡಿರಿ.</para>
  <para style="q2" vid="PSA 74:20">ಏಕೆಂದರೆ ಭೂಮಿಯ ಕತ್ತಲಿನ ಸ್ಥಳಗಳು ಕ್ರೂರತನದ ನಿವಾಸಗಳಿಂದ ತುಂಬಿ ಇವೆ.<verse eid="PSA 74:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 74:21"/>ಕುಗ್ಗಿದವನು ಅವಮಾನದಿಂದ ಹಿಂದಿರುಗದಿರಲಿ.</para>
  <para style="q2" vid="PSA 74:21">ದೀನನೂ, ಬಡವನೂ ನಿಮ್ಮ ಹೆಸರನ್ನು ಸ್ತುತಿಸಲಿ.<verse eid="PSA 74:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 74:22"/>ದೇವರೇ, ಏಳು; ನಿಮ್ಮ ನ್ಯಾಯವನ್ನು ವಾದಿಸಿರಿ.</para>
  <para style="q2" vid="PSA 74:22">ದಿನವೆಲ್ಲಾ ಮೂರ್ಖನು ನಿಮ್ಮನ್ನು ಹೇಗೆ ನಿಂದಿಸುತ್ತಾನೆಂದು ಜ್ಞಾಪಕಮಾಡಿಕೊಳ್ಳಿರಿ.<verse eid="PSA 74:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 74:23"/>ನಿಮ್ಮ ವೈರಿಗಳ ಗದ್ದಲವನ್ನೂ</para>
  <para style="q2" vid="PSA 74:23">ನಿಮ್ಮ ವಿರೋಧಿಗಳ ಆಕ್ರೋಶ ನಿರಂತರವಾಗಿ ಬೆಳೆಯುವ ಕಲಹವನ್ನೂ ಮರೆತುಬಿಡಬೇಡಿರಿ.<verse eid="PSA 74:23"/></para>
  <chapter eid="PSA 74"/>
  <chapter number="75" style="c" sid="PSA 75"/>
  <para style="cl">ಕೀರ್ತನೆ 75</para>
  <para style="d">ಸಂಗೀತ ನಿರ್ದೇಶಕನಿಗಾಗಿರುವ ಕೀರ್ತನೆ. ಅಲ್ತಷ್ಟೇತೆಂಬ ರಾಗ. ಆಸಾಫನ ಕೀರ್ತನೆ. ಒಂದು ಗೀತೆ.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 75:1"/>ನಿಮ್ಮನ್ನು ಕೊಂಡಾಡುತ್ತೇವೆ; ದೇವರೇ,</para>
  <para style="q2" vid="PSA 75:1">ನಿಮ್ಮನ್ನು ಕೊಂಡಾಡುತ್ತೇವೆ; ಏಕೆಂದರೆ ಜನರು ನಿಮ್ಮ ನಾಮವನ್ನು ಜಪಿಸಿ,</para>
  <para style="q2" vid="PSA 75:1">ನಿಮ್ಮ ಅದ್ಭುತಗಳನ್ನು ಕುರಿತು ಹೇಳುತ್ತಾರೆ.<verse eid="PSA 75:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 75:2"/>“ನಿಯಮಿತ ಸಮಯವನ್ನು ಆಯ್ದುಕೊಳ್ಳುವೆನು.</para>
  <para style="q2" vid="PSA 75:2">ನ್ಯಾಯಕ್ಕೆ ಸರಿಯಾಗಿ ನ್ಯಾಯತೀರಿಸುವೆನು,<verse eid="PSA 75:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 75:3"/>ಭೂಮಿಯೂ ಅದರ ನಿವಾಸಿಗಳೆಲ್ಲರೂ ಬೆರಗಾಗಿದ್ದಾರೆ.</para>
  <para style="q2" vid="PSA 75:3">ನಾನು ಅದರ ಸ್ತಂಭಗಳನ್ನು ನಿಲ್ಲಿಸಿದ್ದೇನೆ.<verse eid="PSA 75:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 75:4"/>‘ಅಹಂಕಾರದಿಂದ ವರ್ತಿಸಬೇಡಿರಿ,’ ಎಂದು ಅಹಂಕಾರಿಗೆ ಹೇಳುತ್ತೇನೆ.</para>
  <para style="q2" vid="PSA 75:4">‘ನಿಮ್ಮ ಕೊಂಬು ಎತ್ತಬೇಡಿರಿ,’ ಎಂದು ದುಷ್ಟರಿಗೆ ಹೇಳುವೆನು.<verse eid="PSA 75:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 75:5"/>ನಿಮ್ಮ ಕೊಂಬನ್ನು ಪರಲೋಕದ ಕಡೆಗೆ ಎತ್ತಬೇಡಿರಿ.</para>
  <para style="q2" vid="PSA 75:5">ಹಟಮಾರಿತನದಿಂದ ಮಾತನಾಡಬೇಡಿರಿ,” ಎಂದು ನೀವು ಹೇಳಿದ್ದೀರಿ.<verse eid="PSA 75:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 75:6"/>ಏಕೆಂದರೆ ಉದ್ಧಾರವು ಪೂರ್ವದಿಂದಲೂ</para>
  <para style="q2" vid="PSA 75:6">ಪಶ್ಚಿಮದಿಂದಲೂ ಅಲ್ಲ, ಇಲ್ಲವೆ ದಕ್ಷಿಣದ ಮರುಭೂಮಿಯಿಂದಲೂ ಬರುವುದಿಲ್ಲ.<verse eid="PSA 75:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 75:7"/>ಆದರೆ ದೇವರು ನ್ಯಾಯತೀರಿಸುವವರಾಗಿದ್ದಾರೆ.</para>
  <para style="q2" vid="PSA 75:7">ದೇವರು ಒಬ್ಬನನ್ನು ತಗ್ಗಿಸುತ್ತಾರೆ, ಒಬ್ಬನನ್ನು ಎತ್ತುತ್ತಾರೆ.<verse eid="PSA 75:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 75:8"/>ಯೆಹೋವ ದೇವರ ಕೈಯಲ್ಲಿ ಒಂದು ಪಾತ್ರೆಯು ಇದೆ.</para>
  <para style="q2" vid="PSA 75:8">ಔಷಧಿಮಿಶ್ರವಾಗಿ ಉಕ್ಕುವ ದ್ರಾಕ್ಷಾರಸದಿಂದ ತುಂಬಿ ಇದೆ.</para>
  <para style="q1" vid="PSA 75:8">ಅದನ್ನು ಅವರು ಹೊಯ್ಯುತ್ತಾರೆ.</para>
  <para style="q2" vid="PSA 75:8">ಅದರ ಮಡ್ಡಿಯನ್ನು ಸಹ ಭೂಮಿಯ ದುಷ್ಟರೆಲ್ಲರೂ ಹೀರಿಕೊಂಡು ಕುಡಿಯುವರು.<verse eid="PSA 75:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 75:9"/>ನಾನಾದರೋ ಸದಾ ವರ್ಣಿಸುವವನಾಗಿ</para>
  <para style="q2" vid="PSA 75:9">ಯಾಕೋಬ ವಂಶದವರ ದೇವರನ್ನು ಸಂಕೀರ್ತಿಸುವೆನು.<verse eid="PSA 75:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 75:10"/>ದುಷ್ಟರ ಕೊಂಬುಗಳನ್ನೆಲ್ಲಾ ಕಡಿದುಹೋಗುವುದು.</para>
  <para style="q2" vid="PSA 75:10">ಆದರೆ ನೀತಿವಂತನ ಕೊಂಬುಗಳು ಎತ್ತಲಾಗುವುದು.<verse eid="PSA 75:10"/></para>
  <chapter eid="PSA 75"/>
  <chapter number="76" style="c" sid="PSA 76"/>
  <para style="cl">ಕೀರ್ತನೆ 76</para>
  <para style="d">ಸಂಗೀತ ನಿರ್ದೇಶಕನಿಗಾಗಿರುವ ಕೀರ್ತನೆ. ತಂತಿವಾದ್ಯದೊಡನೆ ಹಾಡತಕ್ಕದ್ದು. ಆಸಾಫನ ಕೀರ್ತನೆ. ಒಂದು ಗೀತೆ.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 76:1"/>ಯೆಹೂದ ಪ್ರದೇಶದಲ್ಲಿ ದೇವರು ಸುಪ್ರಸಿದ್ಧರಾಗಿದ್ದಾರೆ.</para>
  <para style="q2" vid="PSA 76:1">ಇಸ್ರಾಯೇಲಿನಲ್ಲಿ ದೇವರ ಹೆಸರು ಪ್ರಖ್ಯಾತವಾಗಿದೆ.<verse eid="PSA 76:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 76:2"/>ಸಾಲೇಮಿನಲ್ಲಿ ದೇವರ ಗುಡಾರವೂ</para>
  <para style="q2" vid="PSA 76:2">ಚೀಯೋನಿನಲ್ಲಿ ಅವರ ವಾಸಸ್ಥಾನವೂ ಉಂಟು.<verse eid="PSA 76:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 76:3"/>ದೇವರು ಅಲ್ಲಿಯೇ ಬಿಲ್ಲಿನ ಉರಿಬಾಣಗಳನ್ನೂ</para>
  <para style="q2" vid="PSA 76:3">ಗುರಾಣಿಯನ್ನೂ ಖಡ್ಗವನ್ನೂ ಯುದ್ಧಾಯುಧಗಳನ್ನು ಮುರಿದುಬಿಟ್ಟರು.<verse eid="PSA 76:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 76:4"/>ನೀವು ಪ್ರಕಾಶಮಾನ ಬೆಳಕಿಗಿಂತ ಪ್ರಕಾಶಮಾನವಾಗಿರುತ್ತೀರಿ,</para>
  <para style="q2" vid="PSA 76:4">ನೈಸರ್ಗಿಕ ಸಂಪತ್ತು ತುಂಬಿದ ಪರ್ವತಗಳಿಗಿಂತ ಹೆಚ್ಚು ಶ್ರೇಷ್ಠ ಆಗಿದ್ದೀರಿ.<verse eid="PSA 76:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 76:5"/>ಧೀರಹೃದಯದವರು ಸುಲಿಗೆಯಾಗಿ,</para>
  <para style="q2" vid="PSA 76:5">ಅಂತಿಮ ನಿದ್ರೆ ಹೊಂದಿದ್ದಾರೆ.</para>
  <para style="q1" vid="PSA 76:5">ಪರಾಕ್ರಮಿಗಳಲ್ಲಿ ಒಬ್ಬನೂ</para>
  <para style="q2" vid="PSA 76:5">ತನ್ನ ಕೈಗಳನ್ನೆತ್ತಲು ಶಕ್ತನಲ್ಲ.<verse eid="PSA 76:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 76:6"/>ಯಾಕೋಬನ ದೇವರೇ, ನಿಮ್ಮ ಗದರಿಕೆಯಿಂದ ರಥವೂ</para>
  <para style="q2" vid="PSA 76:6">ಕುದುರೆಯೂ ಚಲನೆಯಿಲ್ಲದೆ ಬಿದ್ದಿವೆ.<verse eid="PSA 76:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 76:7"/>ನೀವು ಭಯಭಕ್ತಿಗೆ ಪಾತ್ರರು, ನೀವು ಒಂದು ಸಾರಿ ಬೇಸರಗೊಂಡರೆ,</para>
  <para style="q2" vid="PSA 76:7">ನಿಮ್ಮ ಮುಂದೆ ನಿಲ್ಲುವವನ್ಯಾರು?<verse eid="PSA 76:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 76:8"/>ಪರಲೋಕದಿಂದ ನ್ಯಾಯ ನಿರ್ಣಯವನ್ನು ಮಾಡಿದ್ದೀರಿ.</para>
  <para style="q2" vid="PSA 76:8">ದೇವರೇ, ನ್ಯಾಯತೀರಿಸುವುದಕ್ಕೂ<verse eid="PSA 76:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 76:9"/>ಭೂಮಿಯ ದೀನರೆಲ್ಲರನ್ನು ರಕ್ಷಿಸುವುದಕ್ಕೂ ನೀವು ಪ್ರಾರಂಭಿಸುವಾಗ</para>
  <para style="q2" vid="PSA 76:9">ಭೂಮಿಯು ಭಯಗೊಂಡು ಮೌನವಾಯಿತು.<verse eid="PSA 76:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 76:10"/>ಮನುಷ್ಯರ ವಿರುದ್ಧ ನಿಮ್ಮ ಕೋಪವು ನಿಮಗೆ ಘನವನ್ನು ತರುವುದು.</para>
  <para style="q2" vid="PSA 76:10">ಉಳಿದಿರುವವರು ಕೋಪಕ್ಕೆ ತುತ್ತಾಗುವುದಿಲ್ಲ.<verse eid="PSA 76:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 76:11"/>ನಿಮ್ಮ ದೇವರಾದ ಯೆಹೋವ ದೇವರಿಗೆ ಹರಕೆಮಾಡಿ ಸಲ್ಲಿಸಿರಿ.</para>
  <para style="q2" vid="PSA 76:11">ದೇವರ ಸುತ್ತಲಿರುವವರೆಲ್ಲರು</para>
  <para style="q2" vid="PSA 76:11">ಭಯಭಕ್ತಿಗೆ ಪಾತ್ರರಾದವರಿಗೆ ಕಾಣಿಕೆಗಳನ್ನು ತರಲಿ.<verse eid="PSA 76:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 76:12"/>ದೇವರು ಅಧಿಕಾರಿಗಳ ಗರ್ವವನ್ನು ಮುರಿಯುತ್ತಾರೆ.</para>
  <para style="q2" vid="PSA 76:12">ಭೂಲೋಕದ ಅರಸರು ದೇವರಿಗೆ ಭಯಪಡುತ್ತಾರೆ.<verse eid="PSA 76:12"/></para>
  <chapter eid="PSA 76"/>
  <chapter number="77" style="c" sid="PSA 77"/>
  <para style="cl">ಕೀರ್ತನೆ 77</para>
  <para style="d">ಸಂಗೀತ ನಿರ್ದೇಶಕನಿಗಾಗಿರುವ ಕೀರ್ತನೆ. ಯೆದುತೂನನ ರೀತಿಯಲ್ಲಿ ಹಾಡತಕ್ಕದ್ದು. ಆಸಾಫನ ಕೀರ್ತನೆ.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 77:1"/>ನನ್ನ ಸಹಾಯಕ್ಕಾಗಿ ದೇವರ ಕಡೆಗೆ ಕೂಗುತ್ತೇನೆ.</para>
  <para style="q2" vid="PSA 77:1">ಹೌದು, ನನ್ನ ಸ್ವರದಿಂದ ದೇವರ ಕಡೆಗೆ ಕೂಗುತ್ತೇನೆ, ನನಗೆ ದೇವರು ಕಿವಿಗೊಡುವರು.<verse eid="PSA 77:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 77:2"/>ನನ್ನ ಇಕ್ಕಟ್ಟಿನ ದಿವಸದಲ್ಲಿ ಯೆಹೋವ ದೇವರನ್ನು ಹುಡುಕಿದೆನು.</para>
  <para style="q2" vid="PSA 77:2">ನಾನು ರಾತ್ರಿಯೆಲ್ಲಾ ಬೇಸರವಿಲ್ಲದೆ ಕೈಚಾಚಿದೆ.</para>
  <para style="q2" vid="PSA 77:2">ನನ್ನ ಮನಸ್ಸಿಗೆ ಶಾಂತಿ ಇರಲಿಲ್ಲ.<verse eid="PSA 77:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 77:3"/>ನಾನು ವ್ಯಥೆಪಡುತ್ತಿರುವಾಗ, ದೇವರನ್ನು ಜ್ಞಾಪಕಮಾಡಿಕೊಂಡೆನು.</para>
  <para style="q2" vid="PSA 77:3">ನಾನು ಚಿಂತಿಸುವುದರಿಂದ ನನ್ನ ಆತ್ಮವು ಬಳಲಿ ಹೋಯಿತು.<verse eid="PSA 77:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 77:4"/>ನನ್ನ ಕಣ್ಣುಗಳನ್ನು ಮುಚ್ಚದಿರುವಾಗ,</para>
  <para style="q2" vid="PSA 77:4">ನಾನು ಮಾತನಾಡಲಾರದಂತೆ ಕಳವಳಪಟ್ಟೆನು.<verse eid="PSA 77:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 77:5"/>ಪೂರ್ವದ ದಿವಸಗಳನ್ನೂ</para>
  <para style="q2" vid="PSA 77:5">ಆದಿಕಾಲದ ವರ್ಷಗಳನ್ನೂ ಯೋಚಿಸಿದೆ.<verse eid="PSA 77:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 77:6"/>ನನ್ನ ಹಾಡನ್ನು ರಾತ್ರಿಯಲ್ಲಿ ಜ್ಞಾಪಕಮಾಡಿಕೊಂಡೆನು.</para>
  <para style="q2" vid="PSA 77:6">ನನ್ನ ಹೃದಯದಲ್ಲಿ ನಾನು ಧ್ಯಾನ ಮಾಡಿದೆ.</para>
  <para style="q2" vid="PSA 77:6">ನನ್ನ ಆತ್ಮದಲ್ಲಿ ಪ್ರಶ್ನೆ ಹೀಗೆ ಮೂಡುತ್ತಿತ್ತು:<verse eid="PSA 77:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 77:7"/>“ನಿರಂತರವಾಗಿ ಯೆಹೋವ ದೇವರು ತಳ್ಳಿಬಿಡುವರೋ?</para>
  <para style="q2" vid="PSA 77:7">ಇನ್ನೆಂದಿಗೂ ದಯೆತೋರದೆ ಇರುವರೋ?<verse eid="PSA 77:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 77:8"/>ದೇವರ ಒಡಂಬಡಿಕೆಯ ಪ್ರೀತಿಯು ಸದಾಕಾಲಕ್ಕೆ ನಿಂತು ಹೋಯಿತೋ?</para>
  <para style="q2" vid="PSA 77:8">ತಲತಲಾಂತರಕ್ಕೂ ವಾಗ್ದಾನ ಮುಗಿದು ಹೋಯಿತೋ?<verse eid="PSA 77:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 77:9"/>ದೇವರು ಕರುಣಿಸುವುದನ್ನು ಮರೆತು ಬಿಟ್ಟಿದ್ದಾರೋ?</para>
  <para style="q2" vid="PSA 77:9">ತಮ್ಮ ಅಂತಃಕರಣವನ್ನು ಬೇಸರದಿಂದ ತಡೆಹಿಡಿದಿದ್ದಾರೋ?”<verse eid="PSA 77:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 77:10"/>ನಂತರ ನಾನು ಯೋಚಿಸಿದ್ದೇನಂದರೆ, “ಹೀಗೆ ನೆನಸಿದ್ದು ನನ್ನ ಬಲಹೀನತೆಯೇ.</para>
  <para style="q2" vid="PSA 77:10">ಮಹೋನ್ನತ ದೇವರ ಬಲಗೈಯ ಪರಾಕ್ರಮದ ವರ್ಷಗಳನ್ನು ನಾನು ಸ್ಮರಿಸುವೆನು.<verse eid="PSA 77:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 77:11"/>ಯೆಹೋವ ದೇವರ ಕ್ರಿಯೆಗಳನ್ನು ಜ್ಞಾಪಕಮಾಡಿಕೊಳ್ಳುವೆನು.</para>
  <para style="q2" vid="PSA 77:11">ಹೌದು, ಆದಿಯಿಂದಲೂ ನೀವು ನಡೆಸಿದ ಅದ್ಭುತಗಳನ್ನು ನೆನಪುಮಾಡಿಕೊಳ್ಳುವೆನು.<verse eid="PSA 77:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 77:12"/>ನಿಮ್ಮ ಮಹಾಕಾರ್ಯಗಳನ್ನೆಲ್ಲಾ ಧ್ಯಾನಿಸುವೆನು,</para>
  <para style="q2" vid="PSA 77:12">ನಿಮ್ಮ ಕೃತ್ಯಗಳನ್ನು ಯೋಚಿಸುವೆನು.”<verse eid="PSA 77:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 77:13"/>ದೇವರೇ, ನಿಮ್ಮ ಮಾರ್ಗಗಳು ಪರಿಶುದ್ಧವಾದವುಗಳು.</para>
  <para style="q2" vid="PSA 77:13">ನಮ್ಮ ದೇವರ ಹಾಗೆ ಮಹಾ ದೇವರು ಯಾರು?<verse eid="PSA 77:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 77:14"/>ಅದ್ಭುತಗಳನ್ನು ಮಾಡುವ ದೇವರು ನೀವೇ.</para>
  <para style="q2" vid="PSA 77:14">ಜನರಲ್ಲಿ ನಿಮ್ಮ ಬಲವನ್ನು ತಿಳಿಯಮಾಡಿದ್ದೀರಿ.<verse eid="PSA 77:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 77:15"/>ಯಾಕೋಬನ ಮತ್ತು ಯೋಸೇಫನ ಸಂತತಿಯವರಾದ</para>
  <para style="q2" vid="PSA 77:15">ನಿಮ್ಮ ಜನರನ್ನು ನಿಮ್ಮ ಬಲವಾದ ತೋಳಿನಿಂದ ವಿಮೋಚಿಸಿದ್ದೀರಿ.<verse eid="PSA 77:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 77:16"/>ಜಲರಾಶಿಗಳು ನಿಮ್ಮನ್ನು ಕಂಡವು.</para>
  <para style="q2" vid="PSA 77:16">ದೇವರೇ, ಜಲರಾಶಿಗಳು ನಿಮ್ಮನ್ನು ಕಂಡು ಹೊರಳಾಡಿದವು.</para>
  <para style="q2" vid="PSA 77:16">ಅಗಾಧ ಸಾಗರಗಳು ಅಲ್ಲಕಲ್ಲೋಲವಾದವು.<verse eid="PSA 77:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 77:17"/>ಮೋಡಗಳು ನೀರನ್ನು ಸುರಿಸಿದವು.</para>
  <para style="q2" vid="PSA 77:17">ಆಕಾಶಗಳು ಗುಡುಗಿನಿಂದ ಶಬ್ದಮಾಡಿದವು.</para>
  <para style="q2" vid="PSA 77:17">ನಿಮ್ಮ ಬಾಣಗಳು ಹಿಂದೆಯೂ ಮುಂದೆಯೂ ಹಾರಿ ಬಂದವು.<verse eid="PSA 77:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 77:18"/>ನಿಮ್ಮ ಗುಡುಗಿನ ಶಬ್ದವು ಸುಂಟರಗಾಳಿಯಲ್ಲಿ ಕೇಳುತ್ತಿತ್ತು.</para>
  <para style="q2" vid="PSA 77:18">ಮಿಂಚುಗಳು ಜಗತ್ತನ್ನು ಬೆಳಗಿಸಿದವು.</para>
  <para style="q2" vid="PSA 77:18">ಭೂಮಿಯು ನಡುಗಿ ಕದಲಿತು.<verse eid="PSA 77:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 77:19"/>ನೀವು ಸಮುದ್ರದಲ್ಲಿ ಮಾರ್ಗಮಾಡಿದಿರಿ.</para>
  <para style="q2" vid="PSA 77:19">ಮಹಾಜಲರಾಶಿಗಳನ್ನು ದಾಟಿದಿರಿ.</para>
  <para style="q2" vid="PSA 77:19">ಆದರೂ ನಿಮ್ಮ ಹೆಜ್ಜೆಯ ಗುರುತು ಕಾಣಲಿಲ್ಲ.<verse eid="PSA 77:19"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 77:20"/>ಮೋಶೆ ಆರೋನರ ಕೈಯಿಂದ</para>
  <para style="q2" vid="PSA 77:20">ನಿಮ್ಮ ಜನರನ್ನು ಮಂದೆಯ ಹಾಗೆ ನಡೆಸಿದಿರಿ.<verse eid="PSA 77:20"/></para>
  <chapter eid="PSA 77"/>
  <chapter number="78" style="c" sid="PSA 78"/>
  <para style="cl">ಕೀರ್ತನೆ 78</para>
  <para style="d">ಆಸಾಫನ <char style="tl">ಮಸ್ಕೀಲ್</char> ಕೀರ್ತನೆ.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 78:1"/>ನನ್ನ ಜನರೇ, ನನ್ನ ಬೋಧನೆಗೆ ಕಿವಿಗೊಡಿರಿ;</para>
  <para style="q2" vid="PSA 78:1">ನನ್ನ ಬಾಯಿ ಮಾತುಗಳನ್ನು ಲಾಲಿಸಿರಿ.<verse eid="PSA 78:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 78:2"/>ನಾನು ಸಾಮ್ಯವನ್ನು ಹೇಳಲು ನನ್ನ ಬಾಯಿ ತೆರೆಯುವೆನು.</para>
  <para style="q2" vid="PSA 78:2">ಪೂರ್ವದಿಂದಿರುವ ಗುಪ್ತವಾದವುಗಳನ್ನು ನುಡಿಯುವೆನು.<verse eid="PSA 78:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 78:3"/>ಅವುಗಳನ್ನು ನಾವು ಕೇಳಿ ತಿಳಿದಿದ್ದೇವೆ.</para>
  <para style="q2" vid="PSA 78:3">ನಮ್ಮ ಪಿತೃಗಳು ನಮಗೆ ವಿವರಿಸಿದರು.<verse eid="PSA 78:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 78:4"/>ನಾವು ಸಹ ಯೆಹೋವ ದೇವರ ಸ್ತೋತ್ರಗಳನ್ನೂ ಅವರ ಶಕ್ತಿಯನ್ನೂ</para>
  <para style="q2" vid="PSA 78:4">ದೇವರು ಮಾಡಿದ ಅದ್ಭುತಗಳನ್ನೂ ನಮ್ಮ ಮಕ್ಕಳಿಗೆ ವಿವರಿಸುವೆವು.</para>
  <para style="q2" vid="PSA 78:4">ನಮ್ಮ ಮಕ್ಕಳು ಮುಂದಿನ ತಲೆಮಾರಿಗೆ ಮರೆಮಾಡದಿರುವರು.<verse eid="PSA 78:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 78:5"/>ಅವರು ಯಾಕೋಬ ವಂಶದಲ್ಲಿ ಶಾಸನಗಳನ್ನು ಸ್ಥಾಪಿಸಿ,</para>
  <para style="q2" vid="PSA 78:5">ಇಸ್ರಾಯೇಲಿನಲ್ಲಿ ನಿಯಮವನ್ನು ಇಟ್ಟು,</para>
  <para style="q1" vid="PSA 78:5">ಹಿರಿಯರಿಗೆ ಆಜ್ಞಾಪಿಸಿದ್ದೇನೆಂದರೆ,</para>
  <para style="q2" vid="PSA 78:5">ಅವುಗಳನ್ನು ನಿಮ್ಮ ಮಕ್ಕಳಿಗೆ ಹೇಳಿಕೊಡಿರಿ,<verse eid="PSA 78:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 78:6"/>ಇದರಿಂದ ಮುಂದಿನ ತಲೆಮಾರಿಗೆ ವಾಕ್ಯವು ಗೊತ್ತಾಗಿ,</para>
  <para style="q2" vid="PSA 78:6">ಅವರ ಮಕ್ಕಳು ಅವುಗಳನ್ನು ತಮ್ಮ ಮಕ್ಕಳು</para>
  <para style="q2" vid="PSA 78:6">ಮೊಮ್ಮಕ್ಕಳಿಗೆ ತಿಳಿಸುತ್ತಾ ಹೋಗುವರು.<verse eid="PSA 78:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 78:7"/>ಆಗ ಅವರು ದೇವರಲ್ಲಿ ತಮ್ಮ ಭರವಸೆ ಇಡುವರು.</para>
  <para style="q2" vid="PSA 78:7">ಮತ್ತು ದೇವರ ಕ್ರಿಯೆಗಳನ್ನು ಮರೆತು ಬಿಡದೆ</para>
  <para style="q2" vid="PSA 78:7">ದೇವರ ಆಜ್ಞೆಗಳನ್ನು ಕೈಗೊಂಡು ನಡೆಯುವರು.<verse eid="PSA 78:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 78:8"/>ಆಗ ಅವರು ತಮ್ಮ ಪಿತೃಗಳ ಹಾಗೆ ಹಟಮಾರಿ ಮತ್ತು ದಂಗೆಕೋರ ಸಂತತಿಯವರು ಆಗಿರುವುದಿಲ್ಲ,</para>
  <para style="q2" vid="PSA 78:8">ಅವರ ಹೃದಯವು ದೇವರಿಗೆ ಸತ್ಯವಾಗಿರಲಿಲ್ಲ,</para>
  <para style="q1" vid="PSA 78:8">ಅವರ ಆತ್ಮವು ದೇವರಲ್ಲಿ</para>
  <para style="q2" vid="PSA 78:8">ನಂಬಿಗಸ್ತಿಕೆಯಿಂದಲೂ ಇರಲಿಲ್ಲ.<verse eid="PSA 78:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 78:9"/>ಎಫ್ರಾಯೀಮನ ಮಕ್ಕಳು ಆಯುಧಗಳನ್ನು ಧರಿಸಿ, ಬಿಲ್ಲುಗಳನ್ನು ಹೊತ್ತುಕೊಂಡಿದ್ದರೂ</para>
  <para style="q2" vid="PSA 78:9">ಕಾಳಗದ ದಿವಸದಲ್ಲಿ ಹಿಂತಿರುಗಿಕೊಂಡರು.<verse eid="PSA 78:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 78:10"/>ಅವರು ದೇವರ ಒಡಂಬಡಿಕೆಯನ್ನು ಕೈಗೊಳ್ಳಲಿಲ್ಲ.</para>
  <para style="q2" vid="PSA 78:10">ದೇವರ ನಿಯಮದಲ್ಲಿ ನಡೆಯಲೊಲ್ಲದೆ ಇದ್ದರು.<verse eid="PSA 78:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 78:11"/>ದೇವರು ಅವರಿಗೆ ತೋರಿಸಿದ ಕೃತ್ಯಗಳನ್ನೂ</para>
  <para style="q2" vid="PSA 78:11">ದೇವರು ಮಾಡಿದ ಅದ್ಭುತಗಳನ್ನೂ ಮರೆತುಬಿಟ್ಟರು.<verse eid="PSA 78:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 78:12"/>ದೇವರು ಪಿತೃಗಳ ಮುಂದೆ ಈಜಿಪ್ಟ್ ದೇಶದಲ್ಲಿ,</para>
  <para style="q2" vid="PSA 78:12">ಚೋವನ್ ಬೈಲಿನಲ್ಲಿ ಅದ್ಭುತಗಳನ್ನು ಮಾಡಿದರು.<verse eid="PSA 78:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 78:13"/>ದೇವರು ಸಮುದ್ರವನ್ನು ವಿಭಾಗಿಸಿ ಅವರನ್ನು ದಾಟಿಸಿದರು.</para>
  <para style="q2" vid="PSA 78:13">ನೀರನ್ನು ಗೋಡೆಯಾಗಿ ನಿಲ್ಲಿಸಿದರು.<verse eid="PSA 78:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 78:14"/>ದೇವರು ಹಗಲಿನಲ್ಲಿ ಮೇಘದಿಂದಲೂ</para>
  <para style="q2" vid="PSA 78:14">ರಾತ್ರಿಯೆಲ್ಲಾ ಬೆಂಕಿಯ ಬೆಳಕಿನಿಂದ ಅವರನ್ನು ನಡೆಸಿದರು.<verse eid="PSA 78:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 78:15"/>ಮರುಭೂಮಿಯಲ್ಲಿ ದೇವರು ಬಂಡೆಗಳನ್ನು ಸೀಳಿ,</para>
  <para style="q2" vid="PSA 78:15">ಜನರಿಗೆ ಮಹಾ ಜಲಾಗಾಧಗಳ ಹಾಗೆ ನೀರನ್ನು ಕುಡಿಯಲು ಕೊಟ್ಟರು.<verse eid="PSA 78:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 78:16"/>ಬಂಡೆಯೊಳಗಿಂದ ಹೊಳೆಗಳನ್ನು ಹೊರಗೆ ತಂದು,</para>
  <para style="q2" vid="PSA 78:16">ನದಿಗಳನ್ನು ನೀರನ್ನು ಹರಿಯಮಾಡಿದರು.<verse eid="PSA 78:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 78:17"/>ಆದರೆ ಜನರು ಇನ್ನೂ ದೇವರಿಗೆ ವಿರೋಧವಾಗಿ ಪಾಪಮಾಡಿ,</para>
  <para style="q2" vid="PSA 78:17">ಮರುಭೂಮಿಯಲ್ಲಿ ಮಹೋನ್ನತರಿಗೆ ವಿರೋಧವಾಗಿ ಕೋಪವನ್ನೆಬ್ಬಿಸಿದರು.<verse eid="PSA 78:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 78:18"/>ದೇವರನ್ನು ತಮ್ಮ ಹೃದಯದಲ್ಲಿ ಬೇಕೆಂದು ಪರೀಕ್ಷಿಸಿ,</para>
  <para style="q2" vid="PSA 78:18">ತಮ್ಮ ದುರಾಶೆಗಳಿಗೋಸ್ಕರ ಆಹಾರವನ್ನು ಕೇಳಿದರು.<verse eid="PSA 78:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 78:19"/>ಹೌದು, ಅವರು ದೇವರಿಗೆ</para>
  <para style="q2" vid="PSA 78:19">ವಿರೋಧವಾಗಿ ಮಾತನಾಡಿ,</para>
  <para style="q2" vid="PSA 78:19">“ದೇವರು ಅರಣ್ಯದಲ್ಲಿ ಭೋಜನವನ್ನು ಸಿದ್ಧ ಮಾಡಬಲ್ಲನೋ?<verse eid="PSA 78:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 78:20"/>ಇಗೋ, ದೇವರು ಬಂಡೆಯನ್ನು ಹೊಡೆಯಲಾಗಿ,</para>
  <para style="q2" vid="PSA 78:20">ನೀರು ಚಿಮ್ಮಿ ಹೊರಟಿತು.</para>
  <para style="q2" vid="PSA 78:20">ಹಳ್ಳಗಳು ದಡಮೀರಿ ಹರಿದವು.</para>
  <para style="q1" vid="PSA 78:20">ಅರಣ್ಯದಲ್ಲಿ, ರೊಟ್ಟಿಯನ್ನು ಸಹ ಕೊಡಬಲ್ಲನೋ?</para>
  <para style="q2" vid="PSA 78:20">ತಮ್ಮ ಜನರಿಗೆ ಮಾಂಸವನ್ನು ಸಿದ್ಧಮಾಡುವನೋ?” ಎಂದರು.<verse eid="PSA 78:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 78:21"/>ಯೆಹೋವ ದೇವರು ಇದನ್ನು ಕೇಳಿ ಬೇಸರಗೊಂಡರು.</para>
  <para style="q2" vid="PSA 78:21">ಯಾಕೋಬ್ಯರಲ್ಲಿ ಬೆಂಕಿ ಹೊತ್ತಿತು.</para>
  <para style="q2" vid="PSA 78:21">ಇಸ್ರಾಯೇಲರು ದಂಡನೆಗೆ ಒಳಗಾದರು.<verse eid="PSA 78:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 78:22"/>ಏಕೆಂದರೆ ಅವರು ದೇವರಲ್ಲಿ ನಂಬಿಕೆ ಇಡಲಿಲ್ಲ.</para>
  <para style="q2" vid="PSA 78:22">ದೇವರ ರಕ್ಷಣೆಯಲ್ಲಿ ಭರವಸೆ ಇಡಲಿಲ್ಲ.<verse eid="PSA 78:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 78:23"/>ಆದರೆ ದೇವರು ಮೇಲಿರುವ ಮೇಘಗಳಿಗೆ ಆಜ್ಞಾಪಿಸಿ,</para>
  <para style="q2" vid="PSA 78:23">ಆಕಾಶದ ಕದಗಳನ್ನು ತೆರೆದರು.<verse eid="PSA 78:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 78:24"/>ಉಣ್ಣುವುದಕ್ಕೆ ಮನ್ನವನ್ನು ಜನರ ಮೇಲೆ ಸುರಿಸಿ,</para>
  <para style="q2" vid="PSA 78:24">ಪರಲೋಕದ ಧಾನ್ಯವನ್ನು ಅವರಿಗೆ ಕೊಟ್ಟರು.<verse eid="PSA 78:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 78:25"/>ದೇವದೂತರ ಆಹಾರವನ್ನು ಮಾನವರು ತಿಂದರು.</para>
  <para style="q2" vid="PSA 78:25">ದೇವರು ಅವರಿಗೆ ಬೇಕಾದಷ್ಟು ಕಳುಹಿಸಿದರು.<verse eid="PSA 78:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 78:26"/>ಮೂಡಣ ಗಾಳಿಯನ್ನು ಆಕಾಶದಲ್ಲಿ ಹುಟ್ಟಿಸಿ,</para>
  <para style="q2" vid="PSA 78:26">ತಮ್ಮ ಶಕ್ತಿಯಿಂದ ದಕ್ಷಿಣ ಗಾಳಿಯನ್ನು ಬರಮಾಡಿದರು.<verse eid="PSA 78:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 78:27"/>ಧೂಳಿನಂತೆ ಮಾಂಸವನ್ನು ಸುರಿಸಿದರು.</para>
  <para style="q2" vid="PSA 78:27">ಸಮುದ್ರದ ಮರಳಿನಂತೆ ಪಕ್ಷಿಗಳನ್ನೂ ಅವರ ಮೇಲೆ ಸುರಿಸಿದರು.<verse eid="PSA 78:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 78:28"/>ಅವರ ಮಧ್ಯದಲ್ಲಿಯೂ</para>
  <para style="q2" vid="PSA 78:28">ಅವರ ಗುಡಾರಗಳ ಸುತ್ತಲೂ ಸುರಿಸಿದರು.<verse eid="PSA 78:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="PSA 78:29"/>ಆಗ ಅವರು ತಿಂದು ಬಹಳ ತೃಪ್ತಿಗೊಂಡರು.</para>
  <para style="q2" vid="PSA 78:29">ಅವರು ಆಶಿಸಿದ್ದನ್ನು ದೇವರು ಕೊಟ್ಟರು.<verse eid="PSA 78:29"/></para>
  <para style="q1">
    <verse number="30" style="v" sid="PSA 78:30"/>ಅವರು ತಮ್ಮ ಆಶೆಯನ್ನು ಬಿಡದೆ,</para>
  <para style="q2" vid="PSA 78:30">ಅವರ ಊಟವು ಇನ್ನೂ ಅವರ ಬಾಯಿಯಲ್ಲಿ ಇರುವಾಗ,<verse eid="PSA 78:30"/></para>
  <para style="q1">
    <verse number="31" style="v" sid="PSA 78:31"/>ದೇವರ ಶಿಕ್ಷೆ ಅವರ ಮೇಲೆ ಬಿತ್ತು.</para>
  <para style="q2" vid="PSA 78:31">ಅವರಲ್ಲಿ ಕೊಬ್ಬಿದವರು ಸತ್ತರು.</para>
  <para style="q2" vid="PSA 78:31">ಇಸ್ರಾಯೇಲರ ಪ್ರಾಯಸ್ಥರು ಸಹ ಸತ್ತುಹೋದರು.<verse eid="PSA 78:31"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="32" style="v" sid="PSA 78:32"/>ಇದೆಲ್ಲಾ ಆದಾಗ್ಯೂ ಜನರು ಇನ್ನೂ ಪಾಪಮಾಡುತ್ತಿದ್ದರು.</para>
  <para style="q2" vid="PSA 78:32">ದೇವರ ಅದ್ಭುತಗಳನ್ನು ಕಂಡರೂ ನಂಬಲಿಲ್ಲ.<verse eid="PSA 78:32"/></para>
  <para style="q1">
    <verse number="33" style="v" sid="PSA 78:33"/>ಆಗ ದೇವರು ಅವರ ದಿವಸಗಳನ್ನು ವ್ಯರ್ಥವಾಗಿಯೂ</para>
  <para style="q2" vid="PSA 78:33">ಅವರ ವರ್ಷಗಳನ್ನು ಕಳವಳದಲ್ಲಿಯೂ ಕಳೆಯ ಹೋಗಲು ಅನುಮತಿಸಿದರು.<verse eid="PSA 78:33"/></para>
  <para style="q1">
    <verse number="34" style="v" sid="PSA 78:34"/>ದೇವರು ಜನರನ್ನು ದಂಡಿಸುವಾಗೆಲ್ಲಾ ಅವರು ದೇವರನ್ನು ಹುಡುಕಿದರು.</para>
  <para style="q2" vid="PSA 78:34">ಆಸಕ್ತಿಯಿಂದ ದೇವರ ಕಡೆಗೆ ತಿರುಗಿಕೊಳ್ಳುತ್ತಿದ್ದರು.<verse eid="PSA 78:34"/></para>
  <para style="q1">
    <verse number="35" style="v" sid="PSA 78:35"/>ದೇವರು ತಮ್ಮ ಬಂಡೆ ಎಂದೂ ಮಹೋನ್ನತರಾದ ದೇವರು</para>
  <para style="q2" vid="PSA 78:35">ತಮ್ಮ ವಿಮೋಚಕರೆಂದೂ ಜ್ಞಾಪಕ ಮಾಡಿಕೊಳ್ಳುತ್ತಿದ್ದರು.<verse eid="PSA 78:35"/></para>
  <para style="q1">
    <verse number="36" style="v" sid="PSA 78:36"/>ಆದರೂ ಅವರು ತಮ್ಮ ಬಾಯಿಗಳಿಂದ ದೇವರಿಗೆ ಮುಖಸ್ತುತಿ ಮಾಡಿ,</para>
  <para style="q2" vid="PSA 78:36">ತಮ್ಮ ನಾಲಿಗೆಯಿಂದ ದೇವರನ್ನು ಸುಳ್ಳಾಗಿ ಹೋಗಳುತ್ತಿದ್ದರು.<verse eid="PSA 78:36"/></para>
  <para style="q1">
    <verse number="37" style="v" sid="PSA 78:37"/>ಅವರ ಹೃದಯವು ದೇವರ ಸಂಗಡ ಸ್ಥಿರವಾಗಿರಲಿಲ್ಲ.</para>
  <para style="q2" vid="PSA 78:37">ಅವರು ದೇವರ ಒಡಂಬಡಿಕೆಯಲ್ಲಿ ನಂಬಿಗಸ್ತರಾಗಿರಲಿಲ್ಲ.<verse eid="PSA 78:37"/></para>
  <para style="q1">
    <verse number="38" style="v" sid="PSA 78:38"/>ಆದಾಗ್ಯೂ ದೇವರು ಅವರನ್ನು ಕರುಣಿಸಿ,</para>
  <para style="q2" vid="PSA 78:38">ಅವರ ಅಕ್ರಮವನ್ನು ಕ್ಷಮಿಸಿ,</para>
  <para style="q2" vid="PSA 78:38">ನಾಶಮಾಡದೆ ಬಿಟ್ಟುಬಿಟ್ಟರು.</para>
  <para style="q1" vid="PSA 78:38">ಹೌದು, ಅನೇಕ ಸಾರಿ ದೇವರು ಕೋಪಿಸಿಕೊಳ್ಳದಿದ್ದರು,</para>
  <para style="q2" vid="PSA 78:38">ತಮ್ಮ ಬೇಸರವನ್ನು ದೇವರು ಪ್ರಯೋಗಿಸಲಿಲ್ಲ.<verse eid="PSA 78:38"/></para>
  <para style="q1">
    <verse number="39" style="v" sid="PSA 78:39"/>ಜನರು ಬರೀ ಮಾಂಸ ಮಾತ್ರದವರೂ</para>
  <para style="q2" vid="PSA 78:39">ತಿರುಗಿಕೊಳ್ಳದೆ ಹೋಗುವ ಗಾಳಿಯೂ ಆಗಿದ್ದಾರೆಂದು ದೇವರು ಜ್ಞಾಪಕಮಾಡಿಕೊಂಡರು.<verse eid="PSA 78:39"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="40" style="v" sid="PSA 78:40"/>ಎಷ್ಟೋ ಸಾರಿ ಜನರು ಮರುಭೂಮಿಯಲ್ಲಿ ದೇವರಿಗೆ ಬೇಸರಮಾಡಿದರು.</para>
  <para style="q2" vid="PSA 78:40">ಕಾಡಿನಲ್ಲಿ ದೇವರನ್ನು ದುಃಖಪಡಿಸಿದರು.<verse eid="PSA 78:40"/></para>
  <para style="q1">
    <verse number="41" style="v" sid="PSA 78:41"/>ಅವರು ತಿರುಗಿಬಿದ್ದು ದೇವರನ್ನು ಪರೀಕ್ಷಿಸಿದರು.</para>
  <para style="q2" vid="PSA 78:41">ಇಸ್ರಾಯೇಲರ ಪರಿಶುದ್ಧರಿಗೆ ಬೇಸರಗೊಳಿಸಿದರು.<verse eid="PSA 78:41"/></para>
  <para style="q1">
    <verse number="42" style="v" sid="PSA 78:42"/>ದೇವರು ಅವರನ್ನು</para>
  <para style="q2" vid="PSA 78:42">ವೈರಿಯಿಂದ ವಿಮೋಚಿಸಿದ್ದನ್ನೂ ತಾವು ತೋರಿಸಿದ ಶಕ್ತಿಯನ್ನೂ ಅವರು ಸ್ಮರಿಸಲಿಲ್ಲ.<verse eid="PSA 78:42"/></para>
  <para style="q1">
    <verse number="43" style="v" sid="PSA 78:43"/>ಈಜಿಪ್ಟಿನಲ್ಲಿ ಆದ ಸೂಚಕಕಾರ್ಯಗಳನ್ನೂ,</para>
  <para style="q2" vid="PSA 78:43">ಚೋವನ್ ಬಯಲಿನಲ್ಲಿ ನಡೆಸಿದ ಅದ್ಭುತಗಳನ್ನು</para>
  <para style="q2" vid="PSA 78:43">ಮಾಡಿದ ದಿವಸವನ್ನೂ ಅವರು ಜ್ಞಾಪಕ ಮಾಡಿಕೊಳ್ಳಲಿಲ್ಲ.<verse eid="PSA 78:43"/></para>
  <para style="q1">
    <verse number="44" style="v" sid="PSA 78:44"/>ಅವರು ಕುಡಿಯಲಾರದ ಹಾಗೆ ಅವರ ನದಿಗಳು ರಕ್ತವಾದವು.</para>
  <para style="q2" vid="PSA 78:44">ಅವರ ಹೊಳೆಗಳು ಸಹ ರಕ್ತವಾಗಿ ಮಾರ್ಪಟ್ಟವು.<verse eid="PSA 78:44"/></para>
  <para style="q1">
    <verse number="45" style="v" sid="PSA 78:45"/>ಅವರಲ್ಲಿ ವಿವಿಧ ಹುಳುಗಳು ಬಂದವು.</para>
  <para style="q2" vid="PSA 78:45">ಅವು ಅವರನ್ನು ಹಾನಿಮಾಡಿದವು. ಕಪ್ಪೆಗಳು ಸಹ ಕಳುಹಿಸಲಾದವು.</para>
  <para style="q2" vid="PSA 78:45">ಅವು ಸಹ ಅವರನ್ನು ಹಾನಿಮಾಡಿದವು.<verse eid="PSA 78:45"/></para>
  <para style="q1">
    <verse number="46" style="v" sid="PSA 78:46"/>ಅವರ ಬೆಳೆಗಳು ಕಂಬಳಿ ಹುಳುಗಳಿಗೂ</para>
  <para style="q2" vid="PSA 78:46">ಅವರ ವ್ಯವಸಾಯ ಮಿಡತೆಗಳಿಗೂ ತುತ್ತಾದವು.<verse eid="PSA 78:46"/></para>
  <para style="q1">
    <verse number="47" style="v" sid="PSA 78:47"/>ಅವರ ದ್ರಾಕ್ಷಿಬಳ್ಳಿಗಳು ಕಲ್ಮಳೆಯಿಂದಲೂ</para>
  <para style="q2" vid="PSA 78:47">ಅವರ ಅತ್ತಿಮರಗಳು ಮಂಜಿನಿಂದಲೂ ನಾಶವಾದವು.<verse eid="PSA 78:47"/></para>
  <para style="q1">
    <verse number="48" style="v" sid="PSA 78:48"/>ಅವರ ದನಗಳು ಕಲ್ಮಳೆಗೂ</para>
  <para style="q2" vid="PSA 78:48">ಅವರ ಪಶುಗಳು ಸಿಡಿಲಿಗೂ ಒಳಪಟ್ಟವು.<verse eid="PSA 78:48"/></para>
  <para style="q1">
    <verse number="49" style="v" sid="PSA 78:49"/>ದೇವರು ನಾಶದ ದೇವದೂತರನ್ನು ಕಳುಹಿಸುತ್ತಾ</para>
  <para style="q2" vid="PSA 78:49">ತಮ್ಮ ಬೇಸರದಿಂದಲೂ ದುಃಖದಿಂದಲೂ</para>
  <para style="q2" vid="PSA 78:49">ಇಕ್ಕಟ್ಟುಗಳನ್ನೂ ಅವರ ಮೇಲೆ ಸುರಿಯಮಾಡಿದರು.<verse eid="PSA 78:49"/></para>
  <para style="q1">
    <verse number="50" style="v" sid="PSA 78:50"/>ತಮ್ಮ ಬೇಸರಕ್ಕೆ ದಾರಿಯನ್ನು ಮಾಡಿ,</para>
  <para style="q2" vid="PSA 78:50">ಅವರನ್ನು ಪೂರ್ಣವಾಗಿ ದಂಡಿಸಿದರು.</para>
  <para style="q2" vid="PSA 78:50">ಅವರ ಜೀವವನ್ನು ವ್ಯಾಧಿಗೆ ಒಪ್ಪಿಸಿಬಿಟ್ಟು,<verse eid="PSA 78:50"/></para>
  <para style="q1">
    <verse number="51" style="v" sid="PSA 78:51"/>ಈಜಿಪ್ಟಿನಲ್ಲಿ ಚೊಚ್ಚಲರೆಲ್ಲರನ್ನೂ,</para>
  <para style="q2" vid="PSA 78:51">ಹಾಮನ ಗುಡಾರಗಳಲ್ಲಿ ಪುರುಷತ್ವದ ಪ್ರಥಮ ಫಲವನ್ನೂ ದಂಡಿಸಿದರು.<verse eid="PSA 78:51"/></para>
  <para style="q1">
    <verse number="52" style="v" sid="PSA 78:52"/>ಆದರೆ ದೇವರು ಮಂದೆಯ ಹಾಗೆ ತಮ್ಮ ಜನರನ್ನು ಹೊರತಂದು,</para>
  <para style="q2" vid="PSA 78:52">ಕುರಿಗಳನ್ನು ನಡೆಸುವಂತೆ ಮರುಭೂಮಿಯಲ್ಲಿ ಅವರನ್ನು ನಡೆಸಿದರು.<verse eid="PSA 78:52"/></para>
  <para style="q1">
    <verse number="53" style="v" sid="PSA 78:53"/>ಜನರನ್ನು ಸುರಕ್ಷಿತವಾಗಿ ನಡೆಸಿದ ಕಾರಣ ಅವರು ಹೆದರಲಿಲ್ಲ.</para>
  <para style="q2" vid="PSA 78:53">ಆದರೆ ಸಮುದ್ರವು ಅವರ ಶತ್ರುಗಳನ್ನು ಮುಚ್ಚಿಬಿಟ್ಟಿತು.<verse eid="PSA 78:53"/></para>
  <para style="q1">
    <verse number="54" style="v" sid="PSA 78:54"/>ಹೀಗೆ ದೇವರು ತಮ್ಮ ಭುಜಬಲದಿಂದ ಪವಿತ್ರ ನಾಡಿನ ತಮ್ಮ ಮೇರೆಗೂ,</para>
  <para style="q2" vid="PSA 78:54">ಈ ಪರ್ವತ ನಾಡಿಗೂ ಅವರನ್ನು ಬರಮಾಡಿದರು.<verse eid="PSA 78:54"/></para>
  <para style="q1">
    <verse number="55" style="v" sid="PSA 78:55"/>ದೇವರು ಜನಾಂಗಗಳನ್ನು ಅವರ ಮುಂದೆ ಹೊರಗೆ ಹಾಕಿ,</para>
  <para style="q2" vid="PSA 78:55">ಅವರ ಬಾಧ್ಯತೆಯನ್ನು ಹಂಚಿ,</para>
  <para style="q2" vid="PSA 78:55">ಅವರ ಗುಡಾರಗಳಲ್ಲಿ ಇಸ್ರಾಯೇಲರನ್ನು ವಾಸಿಸುವಂತೆ ಮಾಡಿದರು.<verse eid="PSA 78:55"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="56" style="v" sid="PSA 78:56"/>ಆದರೆ ಜನರು ಮಹೋನ್ನತರಾದ ದೇವರನ್ನು</para>
  <para style="q2" vid="PSA 78:56">ಪರೀಕ್ಷಿಸಿ ವಿರೋಧಿಸಿದರು;</para>
  <para style="q2" vid="PSA 78:56">ದೇವರ ಶಾಸನಗಳನ್ನು ಅವರು ಕೈಗೊಳ್ಳಲಿಲ್ಲ.<verse eid="PSA 78:56"/></para>
  <para style="q1">
    <verse number="57" style="v" sid="PSA 78:57"/>ತಮ್ಮ ಪಿತೃಗಳ ಹಾಗೆ ಉಪಕಾರ ನೆನಸದೆ,</para>
  <para style="q2" vid="PSA 78:57">ಅಪನಂಬಿಗಸ್ತರಾಗಿ ಮೋಸದ ಬಿಲ್ಲಿನ ಹಾಗೆ ಓರೆಯಾದರು.<verse eid="PSA 78:57"/></para>
  <para style="q1">
    <verse number="58" style="v" sid="PSA 78:58"/>ತಮ್ಮ ಉನ್ನತ ಸ್ಥಳಗಳಿಂದ ದೇವರಿಗೆ ಬೇಸರಗೊಳಿಸಿದರು.</para>
  <para style="q2" vid="PSA 78:58">ತಮ್ಮ ಮೂರ್ತಿಗಳಿಂದ ದೇವರಿಗೆ ದುಃಖಪಡಿಸಿದರು.<verse eid="PSA 78:58"/></para>
  <para style="q1">
    <verse number="59" style="v" sid="PSA 78:59"/>ದೇವರು ಇದನ್ನು ಕಂಡಾಗ, ಬೇಸರಗೊಂಡು</para>
  <para style="q2" vid="PSA 78:59">ಇಸ್ರಾಯೇಲನ್ನು ಪರಿಪೂರ್ಣವಾಗಿ ತಿರಸ್ಕರಿಸಿಬಿಟ್ಟರು.<verse eid="PSA 78:59"/></para>
  <para style="q1">
    <verse number="60" style="v" sid="PSA 78:60"/>ದೇವರು ಸಿಲೋವಿನ ಗುಡಾರನ್ನೂ</para>
  <para style="q2" vid="PSA 78:60">ಜನರೊಳಗೆ ಹಾಕಿದ ಗುಡಾರವನ್ನೂ ತಳ್ಳಿಬಿಟ್ಟರು.<verse eid="PSA 78:60"/></para>
  <para style="q1">
    <verse number="61" style="v" sid="PSA 78:61"/>ತಮ್ಮ ಬಲದ ಮಂಜೂಷವನ್ನು ಸೆರೆಗೆ ಒಪ್ಪಿಸಿಬಿಟ್ಟರು.</para>
  <para style="q2" vid="PSA 78:61">ತಮ್ಮ ಮಹಿಮೆಯನ್ನು ವೈರಿಯ ಕೈಗೂ ಕೊಟ್ಟುಬಿಟ್ಟರು.<verse eid="PSA 78:61"/></para>
  <para style="q1">
    <verse number="62" style="v" sid="PSA 78:62"/>ದೇವರು ತಮ್ಮ ಜನರನ್ನು ಖಡ್ಗಕ್ಕೆ ಒಪ್ಪಿಸಿಕೊಟ್ಟರು.</para>
  <para style="q2" vid="PSA 78:62">ತಮ್ಮ ಸ್ವಾಸ್ಥತೆಗೆ ವಿರೋಧವಾಗಿದ್ದರು.<verse eid="PSA 78:62"/></para>
  <para style="q1">
    <verse number="63" style="v" sid="PSA 78:63"/>ಅವರ ಯುವಕರನ್ನು ಬೆಂಕಿಯು ದಹಿಸಿಬಿಟ್ಟಿತು.</para>
  <para style="q2" vid="PSA 78:63">ಅವರ ಕನ್ಯೆಯರು ವಿವಾಹ ಗೀತೆಗಳನ್ನು ಹಾಡಲಿಲ್ಲ.<verse eid="PSA 78:63"/></para>
  <para style="q1">
    <verse number="64" style="v" sid="PSA 78:64"/>ಅವರ ಯಾಜಕರು ಖಡ್ಗದಿಂದ ಸಂಹಾರವಾದರು.</para>
  <para style="q2" vid="PSA 78:64">ಅವರ ವಿಧವೆಯರು ಗೋಳಾಡಲಿಲ್ಲ.<verse eid="PSA 78:64"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="65" style="v" sid="PSA 78:65"/>ಆಗ ಯೆಹೋವ ದೇವರು ಪ್ರತಿಕ್ರಿಯೆಯನ್ನು ಪ್ರಕಟಿಸಿದರು.</para>
  <para style="q2" vid="PSA 78:65">ದ್ರಾಕ್ಷಾರಸದಿಂದ ಆರ್ಭಟಿಸುವ ಪರಾಕ್ರಮಶಾಲಿಯ ಹಾಗೆ ಸಂರಕ್ಷಿಸಲಾದರು.<verse eid="PSA 78:65"/></para>
  <para style="q1">
    <verse number="66" style="v" sid="PSA 78:66"/>ತಮ್ಮ ವೈರಿಗಳನ್ನು ದಂಡಿಸಿದರು.</para>
  <para style="q2" vid="PSA 78:66">ನಿತ್ಯನಿಂದೆಯೇ ಅವರ ಪಾಲಾಯಿತು.<verse eid="PSA 78:66"/></para>
  <para style="q1">
    <verse number="67" style="v" sid="PSA 78:67"/>ಆಗ ದೇವರು ಯೋಸೇಫನ ಗುಡಾರವನ್ನು ತಿರಸ್ಕರಿಸಿ,</para>
  <para style="q2" vid="PSA 78:67">ಎಫ್ರಾಯೀಮನ ಗೋತ್ರವನ್ನು ಆಯ್ದುಕೊಳ್ಳದೆ,<verse eid="PSA 78:67"/></para>
  <para style="q1">
    <verse number="68" style="v" sid="PSA 78:68"/>ಯೆಹೂದನ ಕುಲವನ್ನೂ,</para>
  <para style="q2" vid="PSA 78:68">ತಾನು ಪ್ರೀತಿಮಾಡಿದ ಚೀಯೋನ್ ಪರ್ವತವನ್ನೂ ಆಯ್ದುಕೊಂಡರು.<verse eid="PSA 78:68"/></para>
  <para style="q1">
    <verse number="69" style="v" sid="PSA 78:69"/>ಉನ್ನತವಾದವುಗಳಂತೆಯೂ, ಯುಗಯುಗಕ್ಕೂ ತಾವು ಅಸ್ತಿವಾರ ಹಾಕಿದ</para>
  <para style="q2" vid="PSA 78:69">ಭೂಮಿಯಂತೆಯೂ ತಮ್ಮ ಪರಿಶುದ್ಧ ಸ್ಥಳವನ್ನು ಕಟ್ಟಿದರು.<verse eid="PSA 78:69"/></para>
  <para style="q1">
    <verse number="70" style="v" sid="PSA 78:70"/>ತಮ್ಮ ಸೇವಕ ದಾವೀದನನ್ನು ಆಯ್ದುಕೊಂಡು,</para>
  <para style="q2" vid="PSA 78:70">ಕುರಿಹಟ್ಟಿಯಿಂದ ಅವನನ್ನು ತೆಗೆದುಕೊಂಡರು.<verse eid="PSA 78:70"/></para>
  <para style="q1">
    <verse number="71" style="v" sid="PSA 78:71"/>ತಮ್ಮ ಪ್ರಜೆಯಾದ ಯಾಕೋಬ್ಯರನ್ನೂ</para>
  <para style="q2" vid="PSA 78:71">ತಮ್ಮ ಬಾಧ್ಯತೆಯಾದ ಇಸ್ರಾಯೇಲರನ್ನೂ</para>
  <para style="q2" vid="PSA 78:71">ಮೇಯಿಸುವ ಕುರುಬನನ್ನಾಗಿ ದಾವೀದನನ್ನು ನೇಮಿಸಿದರು.<verse eid="PSA 78:71"/></para>
  <para style="q1">
    <verse number="72" style="v" sid="PSA 78:72"/>ದಾವೀದನು ತಮ್ಮ ಹೃದಯದ ಯಥಾರ್ಥತೆಯ ಪ್ರಕಾರ ಜನರನ್ನು ಪೋಷಿಸಿ</para>
  <para style="q2" vid="PSA 78:72">ತಮ್ಮ ಹಸ್ತ ಕೌಶಲ್ಯದಿಂದ ಅವರನ್ನು ನಡೆಸಿದನು.<verse eid="PSA 78:72"/></para>
  <chapter eid="PSA 78"/>
  <chapter number="79" style="c" sid="PSA 79"/>
  <para style="cl">ಕೀರ್ತನೆ 79</para>
  <para style="d">ಆಸಾಫನ ಕೀರ್ತನೆ.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 79:1"/>ದೇವರೇ, ಜನಾಂಗಗಳು ನಿಮ್ಮ ಬಾಧ್ಯತೆಗೆ ಬಂದು,</para>
  <para style="q2" vid="PSA 79:1">ನಿಮ್ಮ ಪರಿಶುದ್ಧ ಮಂದಿರವನ್ನು ಅಪವಿತ್ರ ಮಾಡಿ,</para>
  <para style="q2" vid="PSA 79:1">ಯೆರೂಸಲೇಮನ್ನು ಹಾಳು ದಿಬ್ಬಗಳಾಗಿ ಮಾಡಿದ್ದಾರೆ.<verse eid="PSA 79:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 79:2"/>ನಿಮ್ಮ ಸೇವಕರ ಹೆಣಗಳನ್ನು ಆಕಾಶದ ಪಕ್ಷಿಗಳಿಗೂ</para>
  <para style="q2" vid="PSA 79:2">ನಿಮ್ಮ ಭಕ್ತರ ಮಾಂಸವನ್ನು</para>
  <para style="q2" vid="PSA 79:2">ಭೂಮಿಯ ಮೃಗಗಳಿಗೂ ಆಹಾರವಾಗಿ ಕೊಟ್ಟಿದ್ದಾರೆ.<verse eid="PSA 79:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 79:3"/>ಅವರ ರಕ್ತವನ್ನು ಯೆರೂಸಲೇಮಿನ ಸುತ್ತಲೂ</para>
  <para style="q2" vid="PSA 79:3">ನೀರಿನ ಹಾಗೆ ಚೆಲ್ಲಿದ್ದಾರೆ.</para>
  <para style="q2" vid="PSA 79:3">ಅವರನ್ನು ಹೂಳಿಡುವವನೊಬ್ಬನೂ ಇಲ್ಲ.<verse eid="PSA 79:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 79:4"/>ನಾವು ನಮ್ಮ ನೆರೆಯವರಿಗೆ ನಿಂದೆಯೂ</para>
  <para style="q2" vid="PSA 79:4">ನಮ್ಮ ಸುತ್ತಲಿರುವವರಿಗೆ ಗೇಲಿಯೂ ಹಾಸ್ಯವೂ ಆಗಿದ್ದೇವೆ.<verse eid="PSA 79:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 79:5"/>ಯೆಹೋವ ದೇವರೇ ಎಷ್ಟರವರೆಗೆ ಕೋಪಗೊಂಡಿರುವಿರಿ? ಸತತವೂ ನೀವು ಕೋಪದಿಂದಿರುವಿರೋ?</para>
  <para style="q2" vid="PSA 79:5">ಎಷ್ಟರವರೆಗೆ ನಿಮ್ಮ ರೋಷವು ಬೆಂಕಿಯಂತೆ ಉರಿಯುವುದು?<verse eid="PSA 79:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 79:6"/>ನಿಮ್ಮನ್ನು ಸ್ವೀಕರಿಸದ ಜನಾಂಗಗಳ ಮೇಲೆಯೂ,</para>
  <para style="q2" vid="PSA 79:6">ನಿಮ್ಮ ಹೆಸರನ್ನು ಕರೆಯದ</para>
  <para style="q1" vid="PSA 79:6">ರಾಜ್ಯಗಳ ಮೇಲೆಯೂ</para>
  <para style="q2" vid="PSA 79:6">ನಿಮ್ಮ ಕೋಪವನ್ನು ಸುರಿಸಿಬಿಡಿರಿ.<verse eid="PSA 79:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 79:7"/>ಏಕೆಂದರೆ ಅವರು ಯಾಕೋಬರನ್ನು ನುಂಗಿಬಿಟ್ಟಿದ್ದಾರೆ.</para>
  <para style="q2" vid="PSA 79:7">ಅವರ ನಿವಾಸವನ್ನು ಹಾಳು ಮಾಡಿದ್ದಾರೆ.<verse eid="PSA 79:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 79:8"/>ಪೂರ್ವಿಕರ ಪಾಪಗಳನ್ನು ನಮಗೆ ವಿರೋಧವಾಗಿ ಜ್ಞಾಪಕ ಮಾಡಿಕೊಳ್ಳಬೇಡಿರಿ.</para>
  <para style="q2" vid="PSA 79:8">ನಿಮ್ಮ ಕರುಣೆಯು ಬೇಗ ನಮ್ಮನ್ನು ಎದುರುಗೊಳ್ಳಲಿ.</para>
  <para style="q2" vid="PSA 79:8">ನಾವು ಬಹಳವಾಗಿ ಕುಗ್ಗಿಹೋಗಿದ್ದೇವೆ.<verse eid="PSA 79:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 79:9"/>ನಮ್ಮ ರಕ್ಷಕರಾಗಿರುವವರೇ, ನಮ್ಮ ದೇವರೇ,</para>
  <para style="q2" vid="PSA 79:9">ನಿಮ್ಮ ಹೆಸರಿನ ಘನದ ನಿಮಿತ್ತ ನಮಗೆ ಸಹಾಯಮಾಡಿರಿ.</para>
  <para style="q1" vid="PSA 79:9">ನಿಮ್ಮ ಹೆಸರಿಗೆ ತಕ್ಕಂತೆ ನಮ್ಮನ್ನು ಬಿಡಿಸಿರಿ.</para>
  <para style="q2" vid="PSA 79:9">ನಮ್ಮ ಪಾಪಗಳನ್ನು ತೊಳೆದುಬಿಡಿರಿ.<verse eid="PSA 79:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 79:10"/>ಅವರ ದೇವರು ಎಲ್ಲಿ ಎಂದು</para>
  <para style="q2" vid="PSA 79:10">ಇತರ ಜನಾಂಗಗಳು ಏಕೆ ಹೇಳಬೇಕು?</para>
  <para style="b" vid="PSA 79:10"/>
  <para style="q1" vid="PSA 79:10">ಚೆಲ್ಲಿರುವ ನಿಮ್ಮ ಸೇವಕರ ರಕ್ತದ ಪ್ರತಿದಂಡನೆಯು</para>
  <para style="q2" vid="PSA 79:10">ನಮ್ಮ ಕಣ್ಣುಗಳ ಮುಂದೆ ಇತರ ಜನಾಂಗಗಳಲ್ಲಿ ಗೊತ್ತಾಗಲಿ.<verse eid="PSA 79:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 79:11"/>ಸೆರೆಯವರ ನಿಟ್ಟುಸಿರು ನಿಮ್ಮ ಮುಂದೆ ಬರಲಿ.</para>
  <para style="q2" vid="PSA 79:11">ನಿಮ್ಮ ಮಹಾಶಕ್ತಿಯ ಪ್ರಕಾರ ಸಾಯುವುದಕ್ಕಿರುವವರನ್ನು ಕಾಪಾಡಿರಿ.<verse eid="PSA 79:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 79:12"/>ಯೆಹೋವ ದೇವರೇ, ನಿಮ್ಮನ್ನು ನಿಂದಿಸಿದ ನಮ್ಮ ನೆರೆಯವರಿಗೆ</para>
  <para style="q2" vid="PSA 79:12">ಏಳರಷ್ಟು ಪ್ರತಿದಂಡನೆಯನ್ನು ಅವರ ಮಡಿಲಿಗೆ ಕೊಡಿರಿ.<verse eid="PSA 79:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 79:13"/>ಆಗ ನಿಮ್ಮ ಜನರೂ, ನಿಮ್ಮ ಹುಲ್ಲುಗಾವಲಿನ</para>
  <para style="q2" vid="PSA 79:13">ಕುರಿಗಳೂ ಆಗಿರುವ ನಾವು</para>
  <para style="q1" vid="PSA 79:13">ಎಂದೆಂದಿಗೂ ನಿಮ್ಮನ್ನು ಕೊಂಡಾಡಿ,</para>
  <para style="q2" vid="PSA 79:13">ತಲತಲಾಂತರಕ್ಕೂ ನಿಮ್ಮ ಸ್ತೋತ್ರವನ್ನು ಸಾರುವೆವು.<verse eid="PSA 79:13"/></para>
  <chapter eid="PSA 79"/>
  <chapter number="80" style="c" sid="PSA 80"/>
  <para style="cl">ಕೀರ್ತನೆ 80</para>
  <para style="d">ಸಂಗೀತ ನಿರ್ದೇಶಕನಿಗಾಗಿರುವ ಕೀರ್ತನೆ. “ಒಡಂಬಡಿಕೆಯ ಲಿಲಿಹೂಗಳು” ಎಂಬ ರಾಗ. ಆಸಾಫನ ಕೀರ್ತನೆ.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 80:1"/>ಮಂದೆಯಂತೆ ಯೋಸೇಫ್ಯರನ್ನು ನಡೆಸುವ</para>
  <para style="q2" vid="PSA 80:1">ಇಸ್ರಾಯೇಲರ ಕುರುಬ ಆಗಿರುವ ದೇವರೇ, ಕಿವಿಗೊಡಿರಿ.</para>
  <para style="q1" vid="PSA 80:1">ಕೆರೂಬಿಗಳ ಮಧ್ಯದಲ್ಲಿ</para>
  <para style="q2" vid="PSA 80:1">ಆಸೀನವಾಗಿರುವ ದೇವರೇ ಪ್ರಕಾಶಿಸಿರಿ.<verse eid="PSA 80:1"/></para>
  <para style="q2">
    <verse number="2" style="v" sid="PSA 80:2"/>ಎಫ್ರಾಯೀಮ್, ಬೆನ್ಯಾಮೀನ್, ಮನಸ್ಸೆಯರ ಮುಂದೆ</para>
  <para style="q1" vid="PSA 80:2">ನಿಮ್ಮ ಪರಾಕ್ರಮವನ್ನು ತೋರಿಸಲು</para>
  <para style="q2" vid="PSA 80:2">ಬಂದು ನಮ್ಮನ್ನು ರಕ್ಷಿಸಿರಿ.<verse eid="PSA 80:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 80:3"/>ದೇವರೇ, ನಮ್ಮನ್ನು ಪುನಃ ಸ್ಥಾಪಿಸಿರಿ.</para>
  <para style="q2" vid="PSA 80:3">ನಿಮ್ಮ ಮುಖ ನಮ್ಮ ಮೇಲೆ ಪ್ರಕಾಶಿಸುವಂತೆ ಮಾಡಿರಿ.</para>
  <para style="q2" vid="PSA 80:3">ಆಗ ನಾವು ರಕ್ಷಣೆ ಹೊಂದುವೆವು.<verse eid="PSA 80:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 80:4"/>ಸರ್ವಶಕ್ತ ದೇವರಾಗಿರುವ ಯೆಹೋವ ದೇವರೇ,</para>
  <para style="q2" vid="PSA 80:4">ಎಷ್ಟರವರೆಗೆ ನಿಮ್ಮ ಜನರ ಪ್ರಾರ್ಥನೆಗೆ</para>
  <para style="q2" vid="PSA 80:4">ವಿರೋಧವಾಗಿ ಬೇಸರಗೊಳ್ಳುವಿರಿ?<verse eid="PSA 80:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 80:5"/>ರೋದನವೇ ನಮ್ಮ ಅನ್ನವಾಗುವಂತೆಯೂ</para>
  <para style="q2" vid="PSA 80:5">ಅಶ್ರುಧಾರೆಯೇ ಪಾನವಾಗುವಂತೆಯೂ ಅನುಮತಿಸಿದ್ದೀರಿ.<verse eid="PSA 80:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 80:6"/>ನಮ್ಮ ನೆರೆಯವರ ವಿವಾದಕ್ಕೆ ನಮ್ಮನ್ನು ಗುರಿಮಾಡಿದ್ದೀರಿ.</para>
  <para style="q2" vid="PSA 80:6">ನಮ್ಮ ಶತ್ರುಗಳು ನಮ್ಮನ್ನು ಅಪಹಾಸ್ಯ ಮಾಡುತ್ತಾರೆ.<verse eid="PSA 80:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 80:7"/>ಸರ್ವಶಕ್ತರಾದ ದೇವರೇ, ನೀವು ನಮ್ಮನ್ನು ಪುನಃ ಸ್ಥಾಪಿಸಿರಿ.</para>
  <para style="q2" vid="PSA 80:7">ನಿಮ್ಮ ಮುಖ ನಮ್ಮ ಮೇಲೆ ಪ್ರಕಾಶಿಸುವಂತೆ ಮಾಡಿರಿ.</para>
  <para style="q2" vid="PSA 80:7">ಆಗ ನಾವು ರಕ್ಷಣೆ ಹೊಂದುವೆವು.<verse eid="PSA 80:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 80:8"/>ನೀವು ದ್ರಾಕ್ಷಾಲತೆಯನ್ನು ಈಜಿಪ್ಟಿನಿಂದ ತಂದು,</para>
  <para style="q2" vid="PSA 80:8">ಜನಾಂಗಗಳನ್ನು ಹೊರಡಿಸಿ ಅದನ್ನು ನೆಟ್ಟಿದ್ದೀರಿ.<verse eid="PSA 80:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 80:9"/>ಅದಕ್ಕಾಗಿ ಸ್ಥಳ ಸಿದ್ಧಮಾಡಿದಿರಿ.</para>
  <para style="q2" vid="PSA 80:9">ಆಗ ಅದು ಬೇರೂರಿ ದೇಶವನ್ನು ತುಂಬಿತು.<verse eid="PSA 80:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 80:10"/>ಅದರ ನೆರಳಿನಿಂದ ಬೆಟ್ಟಗಳೂ</para>
  <para style="q2" vid="PSA 80:10">ಅದರ ಕೊಂಬೆಗಳಿಂದ ದೇವದಾರುಗಳೂ ಮುಚ್ಚಲಾದವು.<verse eid="PSA 80:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 80:11"/>ಅದು ತನ್ನ ರೆಂಬೆಗಳನ್ನು ಸಮುದ್ರದವರೆಗೂ,</para>
  <para style="q2" vid="PSA 80:11">ತನ್ನ ಬಳ್ಳಿಗಳನ್ನು ನದಿಯವರೆಗೂ ಹರಡಿಸಿತು.<verse eid="PSA 80:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 80:12"/>ಮಾರ್ಗದಲ್ಲಿ ಹಾದುಹೋಗುವವರೆಲ್ಲರು ಅದನ್ನು ಕೀಳುವ ಹಾಗೆ</para>
  <para style="q2" vid="PSA 80:12">ಏಕೆ ಅದರ ಬೇಲಿಗಳನ್ನು ನೀವು ಮುರಿದುಬಿಟ್ಟಿದ್ದೀರಿ?<verse eid="PSA 80:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 80:13"/>ಅಡವಿಯಿಂದ ಬಂದ ಹಂದಿಗಳು ಅದನ್ನು ಹಾಳು ಮಾಡುತ್ತವೆ;</para>
  <para style="q2" vid="PSA 80:13">ಕಾಡಿನ ಮೃಗಗಳು ಅದನ್ನು ತಿಂದು ಹಾಕುತ್ತವೆ.<verse eid="PSA 80:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 80:14"/>ಸೇನಾಧೀಶ್ವರ ದೇವರೇ, ನಿಮ್ಮ ದರ್ಶನವಾಗಲಿ.</para>
  <para style="q2" vid="PSA 80:14">ನೀವು ಪರಲೋಕದಿಂದ ಕಟಾಕ್ಷಿಸಿರಿ.</para>
  <para style="q1" vid="PSA 80:14">ಈ ದ್ರಾಕ್ಷಾಲತೆಯನ್ನು ಪರಾಮರಿಸಿರಿ.<verse eid="PSA 80:14"/></para>
  <para style="q2">
    <verse number="15" style="v" sid="PSA 80:15"/>ನಿಮ್ಮ ಬಲಗೈ ನೆಟ್ಟ ಸಸಿಯನ್ನೂ</para>
  <para style="q2" vid="PSA 80:15">ನೀವು ನಿಮಗೆ ಬೆಳಸಿಕೊಂಡ ಬಳ್ಳಿಯನ್ನೂ<note caller="+" style="f"><char style="fr" closed="false">80:15 </char><char style="fq" closed="false">ಬಳ್ಳಿಯನ್ನೂ </char><char style="ft" closed="false">ಇನ್ನೊಂದು ಅರ್ಥದಲ್ಲಿ </char><char style="fqa" closed="false">ಮಗನು</char></note> ಪರಾಮರಿಸಿರಿ.<verse eid="PSA 80:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 80:16"/>ನಿಮ್ಮ ದ್ರಾಕ್ಷಿಬಳ್ಳಿ ಕಡಿದು ಬೆಂಕಿಯಿಂದ ಸುಡಲಾಗಿದೆ.</para>
  <para style="q2" vid="PSA 80:16">ನೀವು ಖಂಡಿಸಲು ನಿಮ್ಮ ಜನರು ಬಾಧಿತರಾಗಿ ಹೋಗುವರು.<verse eid="PSA 80:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 80:17"/>ನಿಮ್ಮ ಬಲಗಡೆಯಲ್ಲಿರುವಾತನ ಮೇಲೆ ನಿಮ್ಮ ಹಸ್ತವಿರಲಿ.</para>
  <para style="q2" vid="PSA 80:17">ನಿಮಗಾಗಿ ಆ ನರಪುತ್ರನನ್ನು ಎಬ್ಬಿಸಿದ್ದೀರಿ.<verse eid="PSA 80:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 80:18"/>ಆಗ ನಾವು ನಿಮ್ಮಿಂದ ತೊಲಗುವುದಿಲ್ಲ.</para>
  <para style="q2" vid="PSA 80:18">ನಮ್ಮನ್ನು ಉಜ್ಜೀವಿಸಿರಿ, ಆಗ ನಿಮ್ಮ ಹೆಸರನ್ನು ಕರೆಯುವೆವು.<verse eid="PSA 80:18"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 80:19"/>ಸರ್ವಶಕ್ತರಾದ ದೇವರೇ, ನೀವು ನಮ್ಮನ್ನು ಪುನಃ ಸ್ಥಾಪಿಸಿರಿ.</para>
  <para style="q2" vid="PSA 80:19">ನಿಮ್ಮ ಮುಖ ನಮ್ಮ ಮೇಲೆ ಪ್ರಕಾಶಿಸುವಂತೆ ಮಾಡಿರಿ.</para>
  <para style="q2" vid="PSA 80:19">ಆಗ ನಾವು ರಕ್ಷಣೆ ಹೊಂದುವೆವು.<verse eid="PSA 80:19"/></para>
  <chapter eid="PSA 80"/>
  <chapter number="81" style="c" sid="PSA 81"/>
  <para style="cl">ಕೀರ್ತನೆ 81</para>
  <para style="d">ಸಂಗೀತ ನಿರ್ದೇಶಕನಿಗಾಗಿರುವ ಕೀರ್ತನೆ; <char style="tl">ಗಿತ್ತೀ</char> ರಾಗದಿಂದ ಹಾಡತಕ್ಕದ್ದು. ಆಸಾಫನ ಕೀರ್ತನೆ.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 81:1"/>ನಮ್ಮ ಬಲವಾಗಿರುವ ದೇವರಿಗೆ ಗಟ್ಟಿಯಾದ ಧ್ವನಿಯಿಂದ ಹಾಡಿರಿ;</para>
  <para style="q2" vid="PSA 81:1">ಯಾಕೋಬನ ದೇವರಿಗೆ ಜಯಧ್ವನಿ ಗೈಯಿರಿ.<verse eid="PSA 81:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 81:2"/>ವಾದ್ಯ ಪ್ರಾರಂಭಿಸಿರಿ; ದಮ್ಮಡಿಯನ್ನೂ,</para>
  <para style="q2" vid="PSA 81:2">ರಮ್ಯವಾದ ಕಿನ್ನರಿಯನ್ನೂ ವೀಣೆಯ ಸಂಗಡ ಬಾರಿಸಿರಿ.<verse eid="PSA 81:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 81:3"/>ಅಮಾವಾಸ್ಯೆಯಲ್ಲಿಯೂ ಉತ್ಸವ ದಿವಸವಾಗಿರುವ ಪೂರ್ಣಿಮೆಯಲ್ಲಿಯೂ</para>
  <para style="q2" vid="PSA 81:3">ಕೊಂಬನ್ನು ಊದಿರಿ.<verse eid="PSA 81:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 81:4"/>ಏಕೆಂದರೆ ಇದು ಇಸ್ರಾಯೇಲಿಗೆ ಕಟ್ಟಳೆ.</para>
  <para style="q2" vid="PSA 81:4">ಯಾಕೋಬನ ದೇವರ ನ್ಯಾಯ ಪ್ರಮಾಣವೇ.<verse eid="PSA 81:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 81:5"/>ದೇವರು ಈಜಿಪ್ಟಿಗೆ ವಿರೋಧವಾಗಿ ಹೊರಟಾಗ,</para>
  <para style="q2" vid="PSA 81:5">ಅದನ್ನು ಯೋಸೇಫನಲ್ಲಿ ಸಾಕ್ಷಿಯಾಗಿ ನೇಮಿಸಿದನು.</para>
  <para style="b" vid="PSA 81:5"/>
  <para style="q1" vid="PSA 81:5">ನಾವು ತಿಳಿಯದ ಭಾಷೆಯನ್ನು ಕೇಳಿದಾಗ:<verse eid="PSA 81:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 81:6"/>“ಅವರ ಹೆಗಲ ಮೇಲಿಂದ ಭಾರವನ್ನು ತೆಗೆದುಹಾಕಿದೆನು,</para>
  <para style="q2" vid="PSA 81:6">ಬುಟ್ಟಿಗಳಿಂದ ಅವರ ಕೈಗಳು ಬಿಡುಗಡೆಯಾದವು.<verse eid="PSA 81:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 81:7"/>ಇಕ್ಕಟ್ಟಿನಲ್ಲಿ ನೀವು ಕರೆಮಾಡಿದಿರಿ, ಆಗ ನಾನು ನಿಮ್ಮನ್ನು ವಿಮೋಚಿಸಿದೆನು.</para>
  <para style="q2" vid="PSA 81:7">ಗುಡುಗಿನ ಮರೆಯಲ್ಲಿ ನಿನಗೆ ಉತ್ತರಕೊಟ್ಟೆನು.</para>
  <para style="q2" vid="PSA 81:7">ಮೆರೀಬಾ ನೀರಿನ ಹತ್ತಿರ ನಿಮ್ಮನ್ನು ಪರೀಕ್ಷಿಸಿದೆನು.<verse eid="PSA 81:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 81:8"/>ನನ್ನ ಜನರೇ ಕೇಳಿರಿ, ಇಸ್ರಾಯೇಲೇ,</para>
  <para style="q2" vid="PSA 81:8">ನೀನು ನನ್ನ ಮಾತನ್ನು ಕೇಳಬೇಕೆಂದು ನಿಮ್ಮನ್ನು ಎಚ್ಚರಿಸುತ್ತೇನೆ.<verse eid="PSA 81:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 81:9"/>ನಿಮ್ಮಲ್ಲಿ ಅನ್ಯದೇವರು ಇರಬಾರದು;</para>
  <para style="q2" vid="PSA 81:9">ಪರದೇವರಿಗೆ ಅಡ್ಡ ಬೀಳಬಾರದು.<verse eid="PSA 81:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 81:10"/>ಈಜಿಪ್ಟ್ ದೇಶದಿಂದ ನಿಮ್ಮನ್ನು ಹೊರಗೆ ತಂದ</para>
  <para style="q2" vid="PSA 81:10">ನಿಮ್ಮ ದೇವರಾದ ಯೆಹೋವ ದೇವರು ನಾನೇ;</para>
  <para style="q1" vid="PSA 81:10">ನಿಮ್ಮ ಬಾಯಿಯನ್ನು ಅಗಲವಾಗಿ ತೆರೆ, ಆಗ ಅದನ್ನು ತುಂಬಿಸುವೆನು.<verse eid="PSA 81:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 81:11"/>“ಆದರೆ ನನ್ನ ಜನರು ನನ್ನ ಮಾತನ್ನು ಕೇಳಲಿಲ್ಲ;</para>
  <para style="q2" vid="PSA 81:11">ಇಸ್ರಾಯೇಲು ನನಗೆ ಅಧೀನವಾಗಲಿಲ್ಲ.<verse eid="PSA 81:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 81:12"/>ಆದ್ದರಿಂದ ಅವರ ಹೃದಯದ ದುರಾಶೆಗೆ ಅವರನ್ನು ನಾನು ಒಪ್ಪಿಸಿದೆನು;</para>
  <para style="q2" vid="PSA 81:12">ಅವರು ತಮ್ಮ ಆಲೋಚನೆಗಳಂತೆ ನಡೆದುಕೊಂಡರು.<verse eid="PSA 81:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 81:13"/>“ಹಾ, ನನ್ನ ಜನರು ನನ್ನ ಮಾತನ್ನು ಕೇಳಿದರೆ ಒಳ್ಳೆದಾಗಿತ್ತು!</para>
  <para style="q2" vid="PSA 81:13">ಇಸ್ರಾಯೇಲು ನನ್ನ ಮಾರ್ಗದಲ್ಲಿ ನಡೆದುಕೊಂಡರೆ ಮೇಲಾಗುತ್ತಿತ್ತು,<verse eid="PSA 81:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 81:14"/>ತೀವ್ರವಾಗಿ ಅವರ ಶತ್ರುಗಳನ್ನು ಧೀನಪಡಿಸುವೆನು.</para>
  <para style="q2" vid="PSA 81:14">ಅವರ ವೈರಿಗಳ ಮೇಲೆ ನನ್ನ ಕೈಯನ್ನು ತಿರುಗಿಸುವೆನು.<verse eid="PSA 81:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 81:15"/>ಯೆಹೋವ ದೇವರನ್ನು ದ್ವೇಷಿಸುವವರು ತಮ್ಮನ್ನು ತಾವೇ ದೇವರಿಗೆ ಒಪ್ಪಿಸಿಕೊಡುವರು.</para>
  <para style="q2" vid="PSA 81:15">ಆದರೂ ಅವರಿಗೆ ಶಿಕ್ಷೆ ತಪ್ಪುವುದಿಲ್ಲ.<verse eid="PSA 81:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 81:16"/>ನಿಮಗಾದರೋ ಉತ್ತಮವಾದ ಗೋಧಿಯನ್ನು ಊಟಕ್ಕೆ ಕೊಟ್ಟು,</para>
  <para style="q2" vid="PSA 81:16">ಬಂಡೆಯೊಳಗಿನ ಜೇನಿನಿಂದ ನಿಮ್ಮನ್ನು ತೃಪ್ತಿಪಡಿಸುವೆನು.”<verse eid="PSA 81:16"/></para>
  <chapter eid="PSA 81"/>
  <chapter number="82" style="c" sid="PSA 82"/>
  <para style="cl">ಕೀರ್ತನೆ 82</para>
  <para style="d">ಆಸಾಫನ ಕೀರ್ತನೆ.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 82:1"/>ದೇವರು ಮಹಾಸಭೆಯಲ್ಲಿ ಅಧ್ಯಕ್ಷತೆವಹಿಸಿ,</para>
  <para style="q2" vid="PSA 82:1">ದೇವರುಗಳ ಮಧ್ಯದಲ್ಲಿ ನ್ಯಾಯತೀರಿಸುತ್ತಾರೆ.<verse eid="PSA 82:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 82:2"/>“ಎಷ್ಟರವರೆಗೆ ಅನ್ಯಾಯವಾಗಿ ತೀರ್ಪು ನೀಡುವಿರಿ.</para>
  <para style="q2" vid="PSA 82:2">ಎಲ್ಲಿಯತನಕ ದುಷ್ಟರಿಗೆ ಮುಖದಾಕ್ಷಿಣ್ಯ ಮಾಡುವಿರಿ?<verse eid="PSA 82:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 82:3"/>ದರಿದ್ರನನ್ನೂ ದಿಕ್ಕಿಲ್ಲದವನನ್ನೂ ಕಾಪಾಡಿರಿ.</para>
  <para style="q2" vid="PSA 82:3">ದೀನನಿಗೂ, ಬಡವನಿಗೂ ನ್ಯಾಯವನ್ನು ಕೊಡಿರಿ.<verse eid="PSA 82:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 82:4"/>ದರಿದ್ರನನ್ನೂ, ಬಡವನನ್ನೂ ತಪ್ಪಿಸಿರಿ.</para>
  <para style="q2" vid="PSA 82:4">ಅವರನ್ನು ದುಷ್ಟರ ಕೈಯೊಳಗಿಂದ ಬಿಡಿಸಿರಿ.<verse eid="PSA 82:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 82:5"/>“ದೇವರುಗಳು ಅರಿಯರು ಏನೂ, ಅವರು ಗ್ರಹಿಸುವುದಿಲ್ಲ ಏನೂ.</para>
  <para style="q2" vid="PSA 82:5">ಅವರು ಕತ್ತಲೆಯಲ್ಲಿ ನಡೆದುಕೊಳ್ಳುತ್ತಾರೆ.</para>
  <para style="q2" vid="PSA 82:5">ಭೂಮಿಯ ಅಸ್ತಿವಾರಗಳೆಲ್ಲಾ ಕದಲುತ್ತಿದೆ.<verse eid="PSA 82:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 82:6"/>“ನಾನು ಮುಂದುವರೆಸಿ ಅವರಿಗೆ ಹೇಳಿದ್ದು, ‘ನೀವು ದೇವರುಗಳು,</para>
  <para style="q2" vid="PSA 82:6">ನೀವೆಲ್ಲರು ಮಹೋನ್ನತ ದೇವರ ಮಕ್ಕಳು,’ ಎಂದು ಹೇಳಿದೆನು.<verse eid="PSA 82:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 82:7"/>ಆದರೂ ಕೇವಲ ಮನುಷ್ಯರ ಹಾಗೆ ನೀವು ಸಾಯುವಿರಿ.</para>
  <para style="q2" vid="PSA 82:7">ಇತರ ನಾಯಕರಂತೆಯೇ ಬಿದ್ದು ಹೋಗುವಿರಿ.”<verse eid="PSA 82:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 82:8"/>ದೇವರೇ, ಬನ್ನಿರಿ ಭೂಮಿಗೆ ನ್ಯಾಯತೀರಿಸಿರಿ.</para>
  <para style="q2" vid="PSA 82:8">ಏಕೆಂದರೆ ಜನಾಂಗಗಳೆಲ್ಲಾ ನಿಮಗೇ ಸೇರಿರುತ್ತವೆ.<verse eid="PSA 82:8"/></para>
  <chapter eid="PSA 82"/>
  <chapter number="83" style="c" sid="PSA 83"/>
  <para style="cl">ಕೀರ್ತನೆ 83</para>
  <para style="d">ಒಂದು ಗೀತೆ. ಆಸಾಫನ ಕೀರ್ತನೆ.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 83:1"/>ದೇವರೇ, ಮೌನವಾಗಿರಬೇಡಿರಿ.</para>
  <para style="q2" vid="PSA 83:1">ನಮ್ಮ ಕೂಗಿಗೆ ನಿಮ್ಮ ಪ್ರತಿಕ್ರಿಯೆ ನೀಡಿರಿ.</para>
  <para style="q2" vid="PSA 83:1">ದೇವರೇ, ಸುಮ್ಮನಿರಬೇಡಿರಿ.<verse eid="PSA 83:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 83:2"/>ಏಕೆಂದರೆ ಇಗೋ, ನಿಮ್ಮ ಶತ್ರುಗಳು ಘೋಷಿಸುತ್ತಾರೆ.</para>
  <para style="q2" vid="PSA 83:2">ನಿಮ್ಮ ವೈರಿಗಳು ತಲೆ ಎತ್ತುತ್ತಾರೆ.<verse eid="PSA 83:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 83:3"/>ನಿಮ್ಮ ಜನರಿಗೆ ವಿರೋಧವಾಗಿ ಉಪಾಯದ ಯುಕ್ತಿ ಕಲ್ಪಿಸುತ್ತಾರೆ.</para>
  <para style="q2" vid="PSA 83:3">ನೀವು ಅಡಗಿಸಿಟ್ಟವರಿಗೆ ವಿರೋಧವಾಗಿ ಆಲೋಚಿಸಿಕೊಳ್ಳುತ್ತಾರೆ.<verse eid="PSA 83:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 83:4"/>ಅವರು, “ಬನ್ನಿರಿ, ರಾಷ್ಟ್ರವಾಗಿರದ ಹಾಗೆ ನಾವು ಅವರನ್ನು ನಿರ್ಮೂಲ ಮಾಡೋಣ;</para>
  <para style="q2" vid="PSA 83:4">ಇಸ್ರಾಯೇಲರ ಹೆಸರು ಇನ್ನು ಜ್ಞಾಪಕಕ್ಕೆ ಬಾರದಿರಲಿ,” ಎನ್ನುತ್ತಾರೆ.<verse eid="PSA 83:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 83:5"/>ಅವರು ಏಕ ಮನಸ್ಕರಾಗಿ ಆಲೋಚನೆ ಮಾಡಿಕೊಂಡಿದ್ದಾರೆ.</para>
  <para style="q2" vid="PSA 83:5">ನಿಮಗೆ ವಿರೋಧವಾಗಿ ಒಡಂಬಟ್ಟಿದ್ದಾರೆ.<verse eid="PSA 83:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 83:6"/>ಎದೋಮ್ಯರ ಮತ್ತು ಇಷ್ಮಾಯೇಲ್ಯರ ಪಾಳೆಯದವರು</para>
  <para style="q2" vid="PSA 83:6">ಮೋವಾಬ್ಯರು, ಹಗ್ರೀಯರು,<verse eid="PSA 83:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 83:7"/>ಗೆಬಾಲ್ಯರು, ಅಮ್ಮೋನಿಯರು, ಅಮಾಲೇಕ್ಯರು,</para>
  <para style="q2" vid="PSA 83:7">ಟೈರಿನವರು, ಫಿಲಿಷ್ಟಿಯರು,<verse eid="PSA 83:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 83:8"/>ಅಸ್ಸೀರಿಯರು ಎಲ್ಲರೂ ಅವರಲ್ಲಿ ಕೂಡಿಕೊಂಡಿರುವರು;</para>
  <para style="q2" vid="PSA 83:8">ಅವರು ಲೋಟನ ಸಂತತಿಯವರಿಗೆ ಸಹಾಯಮಾಡಲು ಸಿದ್ಧರಾಗಿದ್ದಾರೆ.<verse eid="PSA 83:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 83:9"/>ಮಿದ್ಯಾನಿಗೂ ಸೀಸೆರನಿಗೂ ಯಾಬೀನನಿಗೂ</para>
  <para style="q2" vid="PSA 83:9">ಕೀಷೋನ್ ಹಳ್ಳದಲ್ಲಿ ಮಾಡಿದ ಹಾಗೆ ಅವರಿಗೆ ಮಾಡಿರಿ.<verse eid="PSA 83:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 83:10"/>ಅವರು ಎಂದೋರಿನಲ್ಲಿ ನಾಶವಾಗಿ</para>
  <para style="q2" vid="PSA 83:10">ಭೂಮಿಗೆ ಗೊಬ್ಬರವಾದರು.<verse eid="PSA 83:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 83:11"/>ಅವರನ್ನೂ, ಅವರ ಅಧಿಪತಿಗಳನ್ನೂ, ಓರೇಬ್ ಮತ್ತು ಜೇಬನ</para>
  <para style="q2" vid="PSA 83:11">ಹಾಗೆಯೂ ಅವರ ಪ್ರಮುಖರೆಲ್ಲರನ್ನು ಜೆಬಹ ಮತ್ತು ಚಲ್ಮುನ್ನರ ಹಾಗೆಯೂ ಮಾಡಿರಿ.<verse eid="PSA 83:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 83:12"/>ಅವರು, “ನಾವು ದೇವರ ಹುಲ್ಲುಗಾವಲು ಪ್ರದೇಶಗಳನ್ನು</para>
  <para style="q2" vid="PSA 83:12">ಸ್ವಾಧೀನ ಮಾಡಿಕೊಳ್ಳೋಣ,” ಅನ್ನುತ್ತಾರೆ.<verse eid="PSA 83:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 83:13"/>ನನ್ನ ದೇವರೇ, ಅವರನ್ನು ಚಕ್ರದ ಹಾಗೆಯೂ,</para>
  <para style="q2" vid="PSA 83:13">ಗಾಳಿಯ ಮುಂದಿರುವ ಕಸದ ಹಾಗೆಯೂ ಮಾಡು.<verse eid="PSA 83:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 83:14"/>ಅಡವಿ ಸುಡುವ ಬೆಂಕಿಯ ಹಾಗೆಯೂ,</para>
  <para style="q2" vid="PSA 83:14">ಬೆಟ್ಟಗಳನ್ನು ದಹಿಸುವ ಜ್ವಾಲೆಯ ಹಾಗೆಯೂ<verse eid="PSA 83:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 83:15"/>ನಿಮ್ಮ ಬಿರುಗಾಳಿಯಿಂದ ಅವರನ್ನು ಹಿಂಸಿಸಿ,</para>
  <para style="q2" vid="PSA 83:15">ನಿಮ್ಮ ಸುಳಿಗಾಳಿಯಿಂದ ಅವರನ್ನು ತಲ್ಲಣ ಪಡಿಸಿರಿ.<verse eid="PSA 83:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 83:16"/>ಯೆಹೋವ ದೇವರೇ, ನಿಮ್ಮ ನಾಮವನ್ನು ಅವರು ಹುಡುಕುವಂತೆ</para>
  <para style="q2" vid="PSA 83:16">ಅವರ ಮುಖಗಳನ್ನು ನಾಚಿಕೆಯಿಂದ ತುಂಬಿಸಿರಿ.<verse eid="PSA 83:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 83:17"/>ಅವರು ನಾಚಿಕೆಪಟ್ಟು ಕಳವಳಗೊಳ್ಳಲಿ.</para>
  <para style="q2" vid="PSA 83:17">ಹೌದು, ಅವರು ಲಜ್ಜೆಪಟ್ಟು ನಾಶವಾಗಲಿ.<verse eid="PSA 83:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 83:18"/>ಯೆಹೋವ ದೇವರು ಎಂಬ ಹೆಸರುಳ್ಳ ನೀವು ಮಾತ್ರವೇ</para>
  <para style="q2" vid="PSA 83:18">ಸಮಸ್ತ ಭೂಮಿಯ ಮೇಲೆ ಮಹೋನ್ನತರಾಗಿದ್ದೀರಿ ಎಂದು ಅವರು ತಿಳಿದುಕೊಳ್ಳಲಿ.<verse eid="PSA 83:18"/></para>
  <chapter eid="PSA 83"/>
  <chapter number="84" style="c" sid="PSA 84"/>
  <para style="cl">ಕೀರ್ತನೆ 84</para>
  <para style="d">ಸಂಗೀತ ನಿರ್ದೇಶಕನಿಗಾಗಿರುವ ಕೀರ್ತನೆ. <char style="tl">ಗಿತ್ತೀ</char> ರಾಗದಿಂದ ಹಾಡತಕ್ಕದ್ದು. ಕೋರಹೀಯರ ಕೀರ್ತನೆ.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 84:1"/>ಸೇನಾಧೀಶ್ವರ ಯೆಹೋವ ದೇವರೇ,</para>
  <para style="q2" vid="PSA 84:1">ನಿಮ್ಮ ನಿವಾಸಗಳು ಎಷ್ಟೋ ರಮ್ಯವಾಗಿವೆ!<verse eid="PSA 84:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 84:2"/>ಯೆಹೋವ ದೇವರ ಅಂಗಳಗಳಲ್ಲಿ ಸೇರಲು</para>
  <para style="q2" vid="PSA 84:2">ನನ್ನ ಪ್ರಾಣವು ಬಯಸಿ ಕುಂದುತ್ತದೆ.</para>
  <para style="q1" vid="PSA 84:2">ನನ್ನ ಹೃದಯವೂ, ನನ್ನ ಶರೀರವೂ</para>
  <para style="q2" vid="PSA 84:2">ಜೀವವುಳ್ಳ ದೇವರಿಗಾಗಿ ಕೂಗಿಕೊಳ್ಳುತ್ತದೆ.<verse eid="PSA 84:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 84:3"/>ಓ ಸೇನಾಧೀಶ್ವರ ಯೆಹೋವ ದೇವರೇ,</para>
  <para style="q2" vid="PSA 84:3">ನನ್ನ ಅರಸರಾಗಿರುವವರೇ, ನನ್ನ ದೇವರೇ,</para>
  <para style="q2" vid="PSA 84:3">ಗುಬ್ಬಿಯು ಮನೆಯನ್ನೂ,</para>
  <para style="q1" vid="PSA 84:3">ಬಾನಕ್ಕಿಯು ತನ್ನ ಮರಿಗಳನ್ನಿಡುವ ಗೂಡನ್ನೂ</para>
  <para style="q2" vid="PSA 84:3">ನಿಮ್ಮ ಬಲಿಪೀಠಗಳ ಬಳಿಯಲ್ಲಿ ದೊರಕಿತಲ್ಲಾ.<verse eid="PSA 84:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 84:4"/>ನಿಮ್ಮ ಆಲಯದಲ್ಲಿ ವಾಸವಾಗಿರುವವರು ಧನ್ಯರು;</para>
  <para style="q2" vid="PSA 84:4">ನಿಮ್ಮನ್ನು ಅವರು ಯಾವಾಗಲೂ ಸ್ತುತಿಸುವರು.<verse eid="PSA 84:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 84:5"/>ನಿಮ್ಮಲ್ಲಿ ಯಾರು ಬಲಹೊಂದಿರುವರೋ,</para>
  <para style="q2" vid="PSA 84:5">ಯಾರು ಯಾತ್ರಿಗಳಾಗಿದ್ದಾರೋ ಅವರು ಧನ್ಯರು.<verse eid="PSA 84:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 84:6"/>ಬಾಕಾ<note caller="+" style="f"><char style="fr" closed="false">84:6 </char><char style="fq" closed="false">ಬಾಕಾ </char><char style="ft" closed="false">ಇದು ಒಂದು ಬಗ್ಗೆ ಮರುಭೂಮಿಯಲ್ಲಿ ಬೆಳೆಯುವ ಗಿಡ ಮತ್ತು ಕೆಲವು ಪ್ರತಿಗಳಲ್ಲಿ </char><char style="fqa" closed="false">ಕಣ್ಣೀರು </char><char style="ft" closed="false">ಎಂದು ಅರ್ಥ</char></note> ತಗ್ಗನ್ನು ದಾಟುವಾಗ</para>
  <para style="q2" vid="PSA 84:6">ಅವರು ಅದನ್ನು ಬುಗ್ಗೆಯಾಗಿ ಮಾಡುತ್ತಾರೆ.</para>
  <para style="q2" vid="PSA 84:6">ಮುಂಗಾರು ಮಳೆಯು ಕೊಳಗಳನ್ನು ತುಂಬುತ್ತದೆ.<verse eid="PSA 84:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 84:7"/>ಅವರು ಬಲದಿಂದ ಬಲಕ್ಕೆ ಸಾಗಿ,</para>
  <para style="q2" vid="PSA 84:7">ಚೀಯೋನಿನಲ್ಲಿ ದೇವರ ಮುಂದೆ ಕಾಣಿಸಿಕೊಳ್ಳುತ್ತಾರೆ.<verse eid="PSA 84:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 84:8"/>ಸರ್ವಶಕ್ತರಾದ ಯೆಹೋವ ದೇವರೇ, ನನ್ನ ಪ್ರಾರ್ಥನೆಯನ್ನು ಕೇಳಿರಿ.</para>
  <para style="q2" vid="PSA 84:8">ಯಾಕೋಬನ ದೇವರೇ, ಕಿವಿಗೊಡಿರಿ.<verse eid="PSA 84:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 84:9"/>ನಮ್ಮ ಗುರಾಣಿಯಾಗಿರುವ ದೇವರೇ, ನೋಡಿರಿ.</para>
  <para style="q2" vid="PSA 84:9">ನಿಮ್ಮ ಅಭಿಷಿಕ್ತನ ಮುಖವನ್ನು ದೃಷ್ಟಿಸಿ ನೋಡಿರಿ.<verse eid="PSA 84:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 84:10"/>ಏಕೆಂದರೆ ನಿಮ್ಮ ಆಲಯದ ಅಂಗಳಗಳಲ್ಲಿ ಕಳೆದ ಒಂದು ದಿನವು</para>
  <para style="q2" vid="PSA 84:10">ಬೇರೆ ಸಹಸ್ರ ದಿನಗಳಿಗಿಂತ ಉತ್ತಮವಾಗಿದೆ.</para>
  <para style="q1" vid="PSA 84:10">ದುಷ್ಟರ ಗುಡಾರಗಳಲ್ಲಿ ವಾಸಿಸುವುದಕ್ಕಿಂತ</para>
  <para style="q2" vid="PSA 84:10">ನನ್ನ ದೇವರ ಆಲಯದ ಬಾಗಿಲು ಕಾಯುವವನಾಗಿರುವುದೇ ಲೇಸು.<verse eid="PSA 84:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 84:11"/>ಯೆಹೋವ ದೇವರು ಸೂರ್ಯನಂತೆ ಪ್ರಕಾಶಿಸುವವವರೂ ಗುರಾಣಿಯೂ ಆಗಿದ್ದಾರೆ.</para>
  <para style="q2" vid="PSA 84:11">ಯೆಹೋವ ದೇವರು ಕೃಪೆಯನ್ನೂ ಮಹಿಮೆಯನ್ನೂ ಕೊಡುತ್ತಾರೆ.</para>
  <para style="q1" vid="PSA 84:11">ನಿಷ್ಕಳಂಕವಾಗಿ ನಡೆದುಕೊಳ್ಳುವವರಿಗೆ</para>
  <para style="q2" vid="PSA 84:11">ಅವರು ಒಳ್ಳೆಯದನ್ನು ಮಾಡಲು ಹಿಂದೆಗೆಯುವುದಿಲ್ಲ.<verse eid="PSA 84:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 84:12"/>ಸೇನಾಧೀಶ್ವರ ಯೆಹೋವ ದೇವರೇ,</para>
  <para style="q2" vid="PSA 84:12">ನಿಮ್ಮಲ್ಲಿ ಭರವಸವಿಡುವವನೇ ಭಾಗ್ಯವಂತನು.<verse eid="PSA 84:12"/></para>
  <chapter eid="PSA 84"/>
  <chapter number="85" style="c" sid="PSA 85"/>
  <para style="cl">ಕೀರ್ತನೆ 85</para>
  <para style="d">ಸಂಗೀತ ನಿರ್ದೇಶಕನಿಗಾಗಿರುವ ಕೀರ್ತನೆ; ಕೋರಹೀಯರ ಕೀರ್ತನೆ.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 85:1"/>ಯೆಹೋವ ದೇವರೇ, ನಿಮ್ಮ ದೇಶವನ್ನು ನೀವು ದಯೆ ತೋರಿಸಿದ್ದೀರಿ.</para>
  <para style="q2" vid="PSA 85:1">ಯಾಕೋಬನ್ನು ಸೆರೆಯಿಂದ ಹಿಂದಕ್ಕೆ ಬರಮಾಡಿದ್ದೀರಿ.<verse eid="PSA 85:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 85:2"/>ನಿಮ್ಮ ಜನರ ಅಕ್ರಮವನ್ನು ಪರಿಹರಿಸಿದ್ದೀರಿ.</para>
  <para style="q2" vid="PSA 85:2">ಅವರ ಪಾಪವನ್ನೆಲ್ಲಾ ಮುಚ್ಚಿದ್ದೀರಿ.<verse eid="PSA 85:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 85:3"/>ನಿಮ್ಮ ಕೋಪವನ್ನೆಲ್ಲಾ ತೆಗೆದುಬಿಟ್ಟಿದ್ದೀರಿ.</para>
  <para style="q2" vid="PSA 85:3">ನಿಮ್ಮ ಬೇಸರದಿಂದ ತಿರುಗಿಕೊಂಡಿದ್ದೀರಿ.<verse eid="PSA 85:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 85:4"/>ನಮ್ಮ ರಕ್ಷಕ ಆಗಿರುವ ದೇವರೇ, ನಮ್ಮನ್ನು ಪುನಃ ಸ್ಥಾಪಿಸಿರಿ,</para>
  <para style="q2" vid="PSA 85:4">ನಮ್ಮ ಮೇಲಿರುವ ನಿಮ್ಮ ಅಸಂತೋಷವನ್ನು ತೊಲಗಿಸಿರಿ.<verse eid="PSA 85:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 85:5"/>ಎಂದೆಂದಿಗೂ ನಮ್ಮ ಮೇಲೆ ಖಂಡಿಸುವಿರೋ?</para>
  <para style="q2" vid="PSA 85:5">ತಲತಲಾಂತರಕ್ಕೂ ನಿಮ್ಮ ಬೇಸರ ಬೆಳೆಸುವಿರೋ?<verse eid="PSA 85:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 85:6"/>ನಿಮ್ಮ ಜನರು ನಿಮ್ಮಲ್ಲಿ ಸಂತೋಷಪಡುವಂತೆ</para>
  <para style="q2" vid="PSA 85:6">ನೀವು ತಿರುಗಿ ನಮ್ಮನ್ನು ಉಜ್ಜೀವಿಸುವುದಿಲ್ಲವೋ?<verse eid="PSA 85:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 85:7"/>ಯೆಹೋವ ದೇವರೇ, ನಿಮ್ಮ ಒಡಂಬಡಿಕೆಯ ಪ್ರೀತಿಯನ್ನು ನಮಗೆ ತೋರಿಸಿರಿ.</para>
  <para style="q2" vid="PSA 85:7">ನಿಮ್ಮ ರಕ್ಷಣೆಯನ್ನು ನಮಗೆ ಕೊಡಿರಿ.<verse eid="PSA 85:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 85:8"/>ಯೆಹೋವ ದೇವರು ಏನು ಹೇಳುತ್ತಾರೋ ಅದನ್ನು ನಾನು ಕೇಳುವೆನು.</para>
  <para style="q2" vid="PSA 85:8">ದೇವರು ತಮ್ಮ ಜನರಿಗೂ ತಮ್ಮ ಭಕ್ತರಿಗೂ ಸಮಾಧಾನವನ್ನು ವಾಗ್ದಾನಮಾಡುವರು.</para>
  <para style="q2" vid="PSA 85:8">ಆದರೆ ಅವರ ಜನರು ಇನ್ನು ಬುದ್ಧಿಹೀನತೆಗೆ ತಿರುಗಿಕೊಳ್ಳದೆ ಇರಲಿ.<verse eid="PSA 85:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 85:9"/>ನಿಶ್ಚಯವಾಗಿ ಮಹಿಮೆಯು ನಮ್ಮ ದೇಶದಲ್ಲಿ ವಾಸವಾಗಿರುವ ಹಾಗೆ,</para>
  <para style="q2" vid="PSA 85:9">ದೇವರಿಗೆ ಭಯಪಡುವವರಿಗೆ ದೇವರ ರಕ್ಷಣೆಯು ಸಮೀಪವಾಗಿದೆ.<verse eid="PSA 85:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 85:10"/>ಪ್ರೀತಿಯೂ ಸತ್ಯತೆಯೂ ಸಂಧಿಸಿಕೊಳ್ಳುತ್ತವೆ.</para>
  <para style="q2" vid="PSA 85:10">ನೀತಿಯೂ ಸಮಾಧಾನವೂ ಮುದ್ದಿಟ್ಟುಕೊಳ್ಳುತ್ತವೆ.<verse eid="PSA 85:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 85:11"/>ಸತ್ಯವು ಭೂಮಿಯಿಂದ ಮೊಳೆಯುವುದು.</para>
  <para style="q2" vid="PSA 85:11">ನೀತಿಯು ಆಕಾಶದಿಂದ ಕೆಳಗೆ ದೃಷ್ಟಿಸುವುದು.<verse eid="PSA 85:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 85:12"/>ಯೆಹೋವ ದೇವರು ಒಳ್ಳೆಯದನ್ನು ಕೊಡುವರು.</para>
  <para style="q2" vid="PSA 85:12">ನಮ್ಮ ಭೂಮಿಯು ತನ್ನ ಸುಗ್ಗಿಯನ್ನು ಕೊಡುವುದು.<verse eid="PSA 85:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 85:13"/>ನೀತಿಯು ದೇವರ ಮುಂದೆ ನಡೆದುಕೊಂಡು ಹೋಗಿ,</para>
  <para style="q2" vid="PSA 85:13">ದೇವರಿಗೆ ಮಾರ್ಗ ಸಿದ್ಧಪಡಿಸುವುದು.<verse eid="PSA 85:13"/></para>
  <chapter eid="PSA 85"/>
  <chapter number="86" style="c" sid="PSA 86"/>
  <para style="cl">ಕೀರ್ತನೆ 86</para>
  <para style="d">ದಾವೀದನ ಪ್ರಾರ್ಥನೆ.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 86:1"/>ಯೆಹೋವ ದೇವರೇ, ನನಗೆ ಉತ್ತರಕೊಡಿರಿ.</para>
  <para style="q2" vid="PSA 86:1">ನಾನು ದೀನನೂ ಅಗತ್ಯತೆಯಲ್ಲಿ ಇರುವವನೂ ಆಗಿದ್ದೇನೆ.<verse eid="PSA 86:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 86:2"/>ನನ್ನ ಪ್ರಾಣವನ್ನು ಕಾಪಾಡಿರಿ, ನಾನು ನಿಮ್ಮ ಭಕ್ತ,</para>
  <para style="q2" vid="PSA 86:2">ನೀವು ನನ್ನ ದೇವರು.</para>
  <para style="q1" vid="PSA 86:2">ನಿಮ್ಮಲ್ಲಿ ಭರವಸವಿಟ್ಟಿರುವ ನಿಮ್ಮ ಸೇವಕನನ್ನು ರಕ್ಷಿಸಿರಿ. <verse eid="PSA 86:2"/><verse number="3" style="v" sid="PSA 86:3"/>ಯೆಹೋವ ದೇವರೇ, ನನ್ನನ್ನು ಕರುಣಿಸಿರಿ.</para>
  <para style="q2" vid="PSA 86:3">ನಿಮಗೆ ದಿನವೆಲ್ಲಾ ಮೊರೆಯಿಡುತ್ತೇನೆ.<verse eid="PSA 86:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 86:4"/>ನಿಮ್ಮ ಸೇವಕನ ಪ್ರಾಣವನ್ನು ಸಂತೋಷಪಡಿಸಿರಿ.</para>
  <para style="q2" vid="PSA 86:4">ಯೆಹೋವ ದೇವರೇ, ನಿಮ್ಮಲ್ಲೇ ನನ್ನ ಪ್ರಾಣವನ್ನು ಇಟ್ಟಿದ್ದೇನೆ.<verse eid="PSA 86:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 86:5"/>ಯೆಹೋವ ದೇವರೇ, ನೀವು ಒಳ್ಳೆಯವರೂ ಕ್ಷಮಿಸುವುದಕ್ಕೆ ಸಿದ್ಧರೂ ಆಗಿದ್ದೀರಿ.</para>
  <para style="q2" vid="PSA 86:5">ನಿಮ್ಮನ್ನು ಬೇಡುವವರೆಲ್ಲರಿಗೆ ಪ್ರೀತಿಯಲ್ಲಿ ಸಮೃದ್ಧಿವಂತರೂ ಆಗಿರುವಿರಿ.<verse eid="PSA 86:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 86:6"/>ಯೆಹೋವ ದೇವರೇ, ನನ್ನ ಪ್ರಾರ್ಥನೆಗೆ ಕಿವಿಗೊಡಿರಿ.</para>
  <para style="q2" vid="PSA 86:6">ನನ್ನ ವಿಜ್ಞಾಪನೆಗಳ ಸ್ವರವನ್ನು ಆಲೈಸಿರಿ.<verse eid="PSA 86:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 86:7"/>ನನ್ನ ಇಕ್ಕಟ್ಟಿನ ದಿವಸದಲ್ಲಿ ನಿಮ್ಮನ್ನು ಕರೆಯುವೆನು.</para>
  <para style="q2" vid="PSA 86:7">ನೀವು ನನಗೆ ಉತ್ತರ ಕೊಡುವಿರಿ.<verse eid="PSA 86:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 86:8"/>ಯೆಹೋವ ದೇವರೇ, ದೇವರುಗಳಲ್ಲಿ ನಿಮ್ಮ ಹಾಗೆ ಯಾರೂ ಇಲ್ಲ.</para>
  <para style="q2" vid="PSA 86:8">ನಿಮ್ಮ ಕೆಲಸಗಳ ಹಾಗೆ ಒಂದೂ ಇಲ್ಲ.<verse eid="PSA 86:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 86:9"/>ಯೆಹೋವ ದೇವರೇ, ನೀವು ಉಂಟುಮಾಡಿದ ಜನಾಂಗದವರೆಲ್ಲರೂ ಬಂದು</para>
  <para style="q2" vid="PSA 86:9">ನಿಮ್ಮ ಮುಂದೆ ಅಡ್ಡಬಿದ್ದು,</para>
  <para style="q2" vid="PSA 86:9">ನಿಮ್ಮ ಹೆಸರಿಗೆ ಮಹಿಮೆ ಸಲ್ಲಿಸುವರು.<verse eid="PSA 86:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 86:10"/>ನೀವು ದೊಡ್ಡವರೂ ಅದ್ಭುತಗಳನ್ನು ಮಾಡುವವರೂ ಆಗಿದ್ದೀರಿ.</para>
  <para style="q2" vid="PSA 86:10">ನೀವೊಬ್ಬರೇ ದೇವರು.<verse eid="PSA 86:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 86:11"/>ಯೆಹೋವ ದೇವರೇ, ನಿಮ್ಮ ಮಾರ್ಗವನ್ನು ನನಗೆ ಬೋಧಿಸಿರಿ.</para>
  <para style="q2" vid="PSA 86:11">ಆಗ, ನಿಮ್ಮ ಸತ್ಯದಲ್ಲಿ ನಡೆದುಕೊಳ್ಳುವೆನು;</para>
  <para style="q1" vid="PSA 86:11">ನಿಮ್ಮ ಹೆಸರಿಗೆ ಭಯಪಡುವಂತೆ</para>
  <para style="q2" vid="PSA 86:11">ನನಗೆ ವಿಭಾಗವಿಲ್ಲದೆ ಹೃದಯವನ್ನು ದಯಪಾಲಿಸಿರಿ.<verse eid="PSA 86:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 86:12"/>ನನ್ನ ದೇವರಾದ ಯೆಹೋವ ದೇವರೇ, ನನ್ನ ಪೂರ್ಣಹೃದಯದಿಂದ ನಿಮ್ಮನ್ನು ಕೊಂಡಾಡುವೆನು.</para>
  <para style="q2" vid="PSA 86:12">ನಿಮ್ಮ ಹೆಸರನ್ನು ಯುಗಯುಗಕ್ಕೂ ಘನಪಡಿಸುವೆನು.<verse eid="PSA 86:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 86:13"/>ನಿಮ್ಮ ಪ್ರೀತಿಯು ನನ್ನ ಮೇಲೆ ಅಗಾಧವಾಗಿದೆ.</para>
  <para style="q2" vid="PSA 86:13">ಕೆಳಗಿನ ಪಾತಾಳದೊಳಗಿಂದ</para>
  <para style="q2" vid="PSA 86:13">ನನ್ನ ಪ್ರಾಣವನ್ನು ಬಿಡಿಸಿದ್ದೀರಿ.<verse eid="PSA 86:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 86:14"/>ದೇವರೇ, ಅಹಂಕಾರಿಗಳು ನನಗೆ ವಿರೋಧವಾಗಿ ಎದ್ದಿದ್ದಾರೆ.</para>
  <para style="q2" vid="PSA 86:14">ಬಲಾತ್ಕಾರಿಗಳ ಗುಂಪು ನನ್ನ ಪ್ರಾಣವನ್ನು ಹುಡುಕುತ್ತದೆ.</para>
  <para style="q2" vid="PSA 86:14">ಅವರು ನಿಮ್ಮನ್ನು ಗೌರವಿಸುವವರಲ್ಲ.<verse eid="PSA 86:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 86:15"/>ಆದರೆ ನೀವು ಯೆಹೋವ ದೇವರೇ, ಅನುಕಂಪವೂ ದಯೆಯೂ ಉಳ್ಳ ದೇವರು</para>
  <para style="q2" vid="PSA 86:15">ಮತ್ತು ದೀರ್ಘಶಾಂತರೂ ಪ್ರೀತಿಯಲ್ಲಿ ಸಮೃದ್ಧಿವಂತನೂ ಸತ್ಯತೆಯುಳ್ಳವರೂ ಆಗಿದ್ದೀರಿ.<verse eid="PSA 86:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 86:16"/>ನನ್ನ ಕಡೆಗೆ ತಿರುಗಿಕೊಂಡು ನನ್ನನ್ನು ಕರುಣಿಸಿರಿ.</para>
  <para style="q2" vid="PSA 86:16">ನಿಮ್ಮ ಸೇವಕನಿಗೆ ನಿಮ್ಮ ಬಲವನ್ನು ತೋರಿಸಿರಿ.</para>
  <para style="q2" vid="PSA 86:16">ನನ್ನ ತಾಯಿ ನಿನ್ನ ಸೇವೆಮಾಡಿದಂತೆ ನಾನು ಸಹ ಸೇವೆಮಾಡುವುದರಿಂದ ನನ್ನನ್ನು ರಕ್ಷಿಸಿರಿ.<verse eid="PSA 86:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 86:17"/>ನನಗಾಗಿ ನಿಮ್ಮ ಉಪಕಾರದ ಗುರುತೊಂದನ್ನು ತೋರಿಸಿರಿ.</para>
  <para style="q2" vid="PSA 86:17">ಆಗ ನನ್ನ ವೈರಿಗಳು ಅದನ್ನು ಕಂಡು ನಾಚಿಕೆಪಡುವರು.</para>
  <para style="q2" vid="PSA 86:17">ಏಕೆಂದರೆ ಯೆಹೋವ ದೇವರೇ, ನೀವು ನನಗೆ ಸಹಾಯಮಾಡಿ ನನ್ನನ್ನು ಆದರಿಸಿದ್ದೀರಿ.<verse eid="PSA 86:17"/></para>
  <chapter eid="PSA 86"/>
  <chapter number="87" style="c" sid="PSA 87"/>
  <para style="cl">ಕೀರ್ತನೆ 87</para>
  <para style="d">ಕೋರಹೀಯರ ಕೀರ್ತನೆ. ಒಂದು ಗೀತೆ.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 87:1"/>ಯೆಹೋವ ದೇವರು ತಮ್ಮ ಪಟ್ಟಣದ ಅಸ್ತಿವಾರವನ್ನು</para>
  <para style="q2" vid="PSA 87:1">ಪರಿಶುದ್ಧ ಪರ್ವತದಲ್ಲಿ ಸ್ಥಾಪಿಸಿದ್ದಾರೆ.<verse eid="PSA 87:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 87:2"/>ದೇವರು ಚೀಯೋನಿನ ದ್ವಾರಗಳನ್ನು</para>
  <para style="q2" vid="PSA 87:2">ಯಾಕೋಬನ ಎಲ್ಲಾ ನಿವಾಸಗಳಿಗಿಂತ ಹೆಚ್ಚಾಗಿ ಪ್ರೀತಿ ಮಾಡುತ್ತಾರೆ.<verse eid="PSA 87:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 87:3"/>ದೇವರ ಪಟ್ಟಣವೇ,</para>
  <para style="q2" vid="PSA 87:3">ನಿನ್ನ ವಿಷಯವಾದ ಮಹಿಮೆಯು ಏನೆಂದರೆ,<verse eid="PSA 87:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 87:4"/>“ರಾಹಬ್,<note caller="+" style="f"><char style="fr" closed="false">87:4 </char><char style="ft" closed="false">ಈಜಿಪ್ಟ್ ಕಾವ್ಯಾತ್ಮಕ ಹೆಸರು</char></note> ಬಾಬೆಲ್ ದೇಶಗಳವರನ್ನು,</para>
  <para style="q2" vid="PSA 87:4">ನನ್ನನ್ನು ಬಲ್ಲವರಲ್ಲಿ ಎಣಿಸುವೆನು.</para>
  <para style="q1" vid="PSA 87:4">ಇಗೋ, ಫಿಲಿಷ್ಟಿಯ, ಟೈರ್, ಕೂಷ್ ಜನಾಂಗಗಳು,</para>
  <para style="q2" vid="PSA 87:4">‘ಚೀಯೋನಿನಲ್ಲೇ ಹುಟ್ಟಿದವು.’ ”<verse eid="PSA 87:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 87:5"/>ಚೀಯೋನಿನ ವಿಷಯವಾಗಿ,</para>
  <para style="q2" vid="PSA 87:5">“ಸಕಲ ಜನಾಂಗದವರೂ ಚೀಯೋನಿನಲ್ಲಿ ಹುಟ್ಟಿದರು.</para>
  <para style="q2" vid="PSA 87:5">ಮಹೋನ್ನತರೇ ಅದನ್ನು ಸ್ಥಿರಪಡಿಸುವರು,” ಎಂದು ಹೇಳುವರು.<verse eid="PSA 87:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 87:6"/>ಯೆಹೋವ ದೇವರು ಜನಾಂಗಗಳ ಗ್ರಂಥದಲ್ಲಿ ಬರೆಯುವಾಗ,</para>
  <para style="q2" vid="PSA 87:6">“ಚೀಯೋನಿನಲ್ಲಿ ಇವನು ಹುಟ್ಟಿದನು,” ಎಂದು ಬರೆಯುವರು.<verse eid="PSA 87:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 87:7"/>“ನನ್ನ ಎಲ್ಲಾ ಬುಗ್ಗೆಗಳು ನಿಮ್ಮಲ್ಲಿಯೇ ಇವೆ,”</para>
  <para style="q2" vid="PSA 87:7">ಎಂದು ಸಂಗೀತಕಾರರು ಹಾಡುವರು.<verse eid="PSA 87:7"/></para>
  <chapter eid="PSA 87"/>
  <chapter number="88" style="c" sid="PSA 88"/>
  <para style="cl">ಕೀರ್ತನೆ 88</para>
  <para style="d">ದುಃಖದಲ್ಲಿ ಮುಳುಗಿರುವವನ ಮೊರೆ; ಕೋರಹೀಯರ ಕೀರ್ತನೆ; ಸಂಗೀತ ನಿರ್ದೇಶಕನಿಗಾಗಿರುವ ಕೀರ್ತನೆ; <char style="tl">ಮಹಲಾತ್</char> ಎಂಬ ರಾಗದ ಪ್ರಕಾರ ಹಾಡತಕ್ಕದ್ದು. <char style="tl">ಮಸ್ಕೀಲ್</char> ರಾಗದಲ್ಲಿ ಜೇರಹ ಕುಲದವನಾದ ಹೇಮಾನನ ಪದ್ಯ.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 88:1"/>ನನ್ನನ್ನು ರಕ್ಷಿಸುವ ದೇವರಾದ ಯೆಹೋವ ದೇವರೇ,</para>
  <para style="q2" vid="PSA 88:1">ಹಗಲಿರುಳು ನಿಮ್ಮ ಮುಂದೆ ಮೊರೆಯಿಡುತ್ತೇನೆ.<verse eid="PSA 88:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 88:2"/>ನನ್ನ ಪ್ರಾರ್ಥನೆಯು ನಿಮ್ಮ ಮುಂದೆ ಬರಲಿ.</para>
  <para style="q2" vid="PSA 88:2">ನನ್ನ ಮೊರೆಗೆ ನಿಮ್ಮ ಕಿವಿಕೊಡಿರಿ.<verse eid="PSA 88:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 88:3"/>ನನ್ನ ಪ್ರಾಣವು ಕಷ್ಟದಿಂದ ತುಂಬಿದೆ;</para>
  <para style="q2" vid="PSA 88:3">ನನ್ನ ಜೀವವು ಸಮಾಧಿಯ ಸಮೀಪಕ್ಕೆ ಎಳೆಯುತ್ತದೆ.<verse eid="PSA 88:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 88:4"/>ಸಮಾಧಿ ಸೇರುವವರ ಸಂಗಡ ಎಣಿಸಲಾಗಿದ್ದೇನೆ;</para>
  <para style="q2" vid="PSA 88:4">ನಾನು ಬಲವಿಲ್ಲದ ಪುರುಷನ ಹಾಗಿದ್ದೇನೆ.<verse eid="PSA 88:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 88:5"/>ಹತರಾದವರು ಸಮಾಧಿಯಲ್ಲಿ ಮಲಗಿದಂತೆ</para>
  <para style="q2" vid="PSA 88:5">ನಾನೂ ಸತ್ತವರೊಂದಿಗೆ ಸೇರಿರುತ್ತೇನೆ.</para>
  <para style="q1" vid="PSA 88:5">ಅವರನ್ನು ನೀನೆಂದೂ ಜ್ಞಾಪಿಸಿಕೊಳ್ಳುವುದಿಲ್ಲ.</para>
  <para style="q2" vid="PSA 88:5">ನಿಮ್ಮ ಪರಿಪಾಲನೆಯಿಂದ ದೂರವಾಗಿದ್ದಾರೆ.<verse eid="PSA 88:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 88:6"/>ಅಧೋಲೋಕದಲ್ಲಿಯೂ ಗಾಡಾಂಧಕಾರದಲ್ಲಿಯೂ</para>
  <para style="q2" vid="PSA 88:6">ಅಗಾಧಗಳಲ್ಲಿಯೂ ನನ್ನನ್ನು ಇಟ್ಟಿದ್ದೀರಿ.<verse eid="PSA 88:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 88:7"/>ನಿಮ್ಮ ಬೇಸರವು ನನ್ನ ಮೇಲೆ ಭಾರವಾಗಿದೆ.</para>
  <para style="q2" vid="PSA 88:7">ನಿಮ್ಮ ಅಲೆಗಳಿಂದೆಲ್ಲಾ ನನ್ನನ್ನು ಮುಳುಗಿಸಿದ್ದೀರಿ.<verse eid="PSA 88:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 88:8"/>ನನ್ನ ಪರಿಚಿತರನ್ನು ನನ್ನಿಂದ ದೂರಮಾಡಿದ್ದೀರಿ.</para>
  <para style="q2" vid="PSA 88:8">ನಾನು ಅವರಿಗೆ ಬೇಡವಾಗಿದ್ದೇನೆ.</para>
  <para style="q1" vid="PSA 88:8">ನಾನು ಬಂಧಿತನಾಗಿದ್ದೇನೆ, ಹೊರಗೆ ಬರಲಾರೆನು.<verse eid="PSA 88:8"/></para>
  <para style="q2">
    <verse number="9" style="v" sid="PSA 88:9"/>ಬಾಧೆಯ ದೆಸೆಯಿಂದ ನನ್ನ ಕಣ್ಣು ಮಂದವಾಗಿ ಹೋಗಿದೆ.</para>
  <para style="b" vid="PSA 88:9"/>
  <para style="q1" vid="PSA 88:9">ಯೆಹೋವ ದೇವರೇ, ದಿನವೆಲ್ಲಾ ನಿಮ್ಮನ್ನು ಕರೆಯುತ್ತೇನೆ.</para>
  <para style="q2" vid="PSA 88:9">ನಾನು ನಿಮ್ಮ ಕಡೆಗೆ ನನ್ನ ಕೈಗಳನ್ನು ಚಾಚುತ್ತೇನೆ.<verse eid="PSA 88:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 88:10"/>ಸತ್ತವರಿಗೆ ಅದ್ಭುತಗಳನ್ನು ತೋರಿಸುವಿರೋ?</para>
  <para style="q2" vid="PSA 88:10">ಸತ್ತವರು ಎದ್ದು ನಿಮ್ಮನ್ನು ಕೊಂಡಾಡುವರೋ?<verse eid="PSA 88:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 88:11"/>ಸಮಾಧಿಯಲ್ಲಿ ನಿಮ್ಮ ಪ್ರೀತಿ ಸಾರಲಾಗುವುದೇ?</para>
  <para style="q2" vid="PSA 88:11">ನಾಶನ ಸ್ಥಳದಲ್ಲಿ ನಿಮ್ಮ ನಂಬಿಗಸ್ತಿಕೆಯು ಹೇಳಲಾಗುವುದೋ?<verse eid="PSA 88:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 88:12"/>ಕತ್ತಲೆಯಲ್ಲಿ ನಿಮ್ಮ ಅದ್ಭುತಗಳೂ ಮರೆತುಹೋಗಿರುವ ದೇಶದಲ್ಲಿ</para>
  <para style="q2" vid="PSA 88:12">ನಿಮ್ಮ ನೀತಿಯೂ ತಿಳಿಯಲಾಗುವುದೋ?<verse eid="PSA 88:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 88:13"/>ಆದರೆ ನಾನು ಯೆಹೋವ ದೇವರೇ, ನಿಮ್ಮ ಕಡೆಗೆ ಮೊರೆಯಿಡುತ್ತೇನೆ.</para>
  <para style="q2" vid="PSA 88:13">ಉದಯಕಾಲದಲ್ಲಿ ನನ್ನ ಪ್ರಾರ್ಥನೆಯು ನಿಮ್ಮನ್ನು ಎದುರುಗೊಳ್ಳುವುದು.<verse eid="PSA 88:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 88:14"/>ಯೆಹೋವ ದೇವರೇ, ನೀವೇಕೆ ನನ್ನನ್ನು ತಳ್ಳಿಬಿಟ್ಟಿದ್ದೀರಿ.</para>
  <para style="q2" vid="PSA 88:14">ನನಗೆ ನಿಮ್ಮ ಮುಖ ಮರೆಮಾಡುತ್ತೀರಿ?<verse eid="PSA 88:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 88:15"/>ಬಾಲ್ಯದಿಂದಲೂ ನಾನು ಬಾಧಿತನು ಸಾಯುವುದಕ್ಕೆ ಸಿದ್ಧನೂ ಆಗಿದ್ದೇನೆ.</para>
  <para style="q2" vid="PSA 88:15">ನಿಮ್ಮ ದಂಡನೆಯನ್ನು ನಾನು ತಾಳುತ್ತಾ ಭ್ರಮೆಗೊಳ್ಳುತ್ತೇನೆ.<verse eid="PSA 88:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 88:16"/>ನನ್ನ ಮೇಲೆ ನಿಮ್ಮ ಬೇಸರವು ಆವರಿಸಿದೆ.</para>
  <para style="q2" vid="PSA 88:16">ನಿಮ್ಮ ದಂಡನೆಗಳು ನನ್ನನ್ನು ಬಾಧಿಸಿರುತ್ತವೆ.<verse eid="PSA 88:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 88:17"/>ಪ್ರವಾಹಗಳ ಹಾಗೆ ಅವು ಬಂದು ನನ್ನನ್ನು ದಿನವೆಲ್ಲಾ ಸುತ್ತಿಕೊಳ್ಳುತ್ತವೆ;</para>
  <para style="q2" vid="PSA 88:17">ಅವು ಸಂಪೂರ್ಣವಾಗಿ ನನ್ನನ್ನು ಮುತ್ತಿಕೊಳ್ಳುತ್ತವೆ.<verse eid="PSA 88:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 88:18"/>ನನ್ನ ಆಪ್ತಮಿತ್ರರನ್ನು ದೂರ ಮಾಡಿದಿರಿ.</para>
  <para style="q2" vid="PSA 88:18">ಅಂಧಕಾರವೇ ನನ್ನ ಪರಿಚಯವು.<verse eid="PSA 88:18"/></para>
  <chapter eid="PSA 88"/>
  <chapter number="89" style="c" sid="PSA 89"/>
  <para style="cl">ಕೀರ್ತನೆ 89</para>
  <para style="d">
    <char style="tl">ಮಾಸ್ಕಿಲ</char> ರಾಗದಿಂದ ಹಾಡತಕ್ಕದ್ದು. ಜೇರಹ ಕುಲದವನಾದ ಏತಾನನ ಪದ್ಯ.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 89:1"/>ಯೆಹೋವ ದೇವರ ಮಹಾ ಪ್ರೀತಿಯನ್ನು ಯುಗಯುಗಕ್ಕೂ ಹಾಡುವೆನು.</para>
  <para style="q2" vid="PSA 89:1">ತಲತಲಾಂತರಕ್ಕೂ ನಿಮ್ಮ ನಂಬಿಗಸ್ತಿಕೆಯನ್ನು</para>
  <para style="q2" vid="PSA 89:1">ನನ್ನ ಬಾಯಿ ತಿಳಿಯಪಡಿಸುವುದು.<verse eid="PSA 89:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 89:2"/>ಎಂದೆಂದಿಗೂ ನಿಮ್ಮ ಪ್ರೀತಿಯನ್ನು ಸಾರುವೆನು.</para>
  <para style="q2" vid="PSA 89:2">ಪರಲೋಕದಲ್ಲಿ ನಿಮ್ಮ ನಂಬಿಗಸ್ತಿಕೆಯನ್ನು ಸ್ಥಿರಪಡಿಸಿದ್ದೀರಿ ಎಂದು ಘೋಷಿಸುವೆನು.<verse eid="PSA 89:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 89:3"/>ನೀವು ಹೇಳಿದ್ದೇನಂದರೆ, “ನಾನು ಆಯ್ದುಕೊಂಡವನ ಸಂಗಡ ನಾನು ಒಡಂಬಡಿಕೆ ಮಾಡಿಕೊಂಡಿದ್ದೇನೆ.</para>
  <para style="q2" vid="PSA 89:3">ನಾನು ನನ್ನ ಸೇವಕನಾದ ದಾವೀದನಿಗೆ ಪ್ರಮಾಣ ಮಾಡಿದ್ದೇನೆ.<verse eid="PSA 89:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 89:4"/>‘ಎಂದೆಂದಿಗೂ ನಿಮ್ಮ ಸಂತತಿಯನ್ನು ಸ್ಥಿರಪಡಿಸುವೆನು</para>
  <para style="q2" vid="PSA 89:4">ತಲತಲಾಂತರಕ್ಕೂ ನಿಮ್ಮ ಸಿಂಹಾಸನವನ್ನು ಕಟ್ಟುವೆನು.’ ”<verse eid="PSA 89:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 89:5"/>ಯೆಹೋವ ದೇವರೇ, ಆಕಾಶಗಳು ನಿಮ್ಮ ಅದ್ಭುತಗಳನ್ನೂ</para>
  <para style="q2" vid="PSA 89:5">ಪರಿಶುದ್ಧರ ಸಭೆಯಲ್ಲಿ ನಿಮ್ಮ ನಂಬಿಗಸ್ತಿಕೆಯನ್ನೂ ಕೊಂಡಾಡುವುವು.<verse eid="PSA 89:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 89:6"/>ಪ್ರಪಂಚದಲ್ಲಿ ಯೆಹೋವ ದೇವರಿಗೆ ಸಮಾನನಾದವನು ಯಾರು?</para>
  <para style="q2" vid="PSA 89:6">ಪರಲೋಕ ಜೀವಿಗಳಲ್ಲಿ ಯೆಹೋವ ದೇವರಿಗೆ ಸಮಾನನಾದವನು ಯಾರು?<verse eid="PSA 89:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 89:7"/>ಅವರು ಪರಿಶುದ್ಧರ ಸಭೆಯಲ್ಲಿ ಭಯಭಕ್ತಿಗೆ ಪಾತ್ರರಾದ ದೇವರು.</para>
  <para style="q2" vid="PSA 89:7">ತಮ್ಮ ಎಲ್ಲಾ ಪರಿವಾರದವರಿಗಿಂತ ಅವರು ಅತಿಶಯವಾದವರು.<verse eid="PSA 89:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 89:8"/>ಸೇನಾಧೀಶ್ವರ ಯೆಹೋವ ದೇವರೇ, ನಿಮ್ಮ ಹಾಗೆ ಶಕ್ತರು ಯಾರು ಇದ್ದಾರೆ?</para>
  <para style="q2" vid="PSA 89:8">ಯೆಹೋವ ದೇವರೇ, ನೀವು ಶಕ್ತರು, ನಿಮ್ಮ ನಂಬಿಗಸ್ತಿಕೆಯು ನಿಮ್ಮನ್ನು ಸುತ್ತುವರಿದಿದೆ.<verse eid="PSA 89:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 89:9"/>ನೀವು ಸಮುದ್ರದ ಏರುವಿಕೆಯನ್ನು ಆಳುತ್ತೀರಿ.</para>
  <para style="q2" vid="PSA 89:9">ಅದರ ತೆರೆಗಳು ಏಳುವಾಗ ಅವುಗಳನ್ನು ಸುಮ್ಮನಿರಿಸುತ್ತೀರಿ.<verse eid="PSA 89:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 89:10"/>ಹತನಾದವನಂತೆ ನೀವು ರಹಬನ್ನು ಜಯಿಸಿದ್ದೀರಿ.</para>
  <para style="q2" vid="PSA 89:10">ನಿಮ್ಮ ಭುಜಬಲದಿಂದ ನಿಮ್ಮ ಶತ್ರುಗಳನ್ನು ಚದರಿಸಿದ್ದೀರಿ.<verse eid="PSA 89:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 89:11"/>ಆಕಾಶಗಳು ನಿಮ್ಮವು, ಭೂಮಿಯು ಸಹ ನಿಮ್ಮದು.</para>
  <para style="q2" vid="PSA 89:11">ಲೋಕವನ್ನೂ ಅದರಲ್ಲಿರುವುದೆಲ್ಲವನ್ನೂ ನೀವು ಉಂಟುಮಾಡಿದ್ದೀರಿ.<verse eid="PSA 89:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 89:12"/>ಉತ್ತರವನ್ನೂ ದಕ್ಷಿಣವನ್ನೂ ನೀವೇ ನಿರ್ಮಿಸಿದ್ದೀರಿ.</para>
  <para style="q2" vid="PSA 89:12">ತಾಬೋರೂ, ಹೆರ್ಮೋನೂ ನಿಮ್ಮ ಹೆಸರಿನಲ್ಲಿ ಉತ್ಸಾಹ ಧ್ವನಿಗೈಯುತ್ತವೆ.<verse eid="PSA 89:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 89:13"/>ನಿಮ್ಮ ಭುಜವು ಶಕ್ತಿಯುತವಾದದ್ದು.</para>
  <para style="q2" vid="PSA 89:13">ನಿಮ್ಮ ಕೈ ಬಲವುಳ್ಳದ್ದು; ನಿಮ್ಮ ಬಲಗೈ ಉನ್ನತವಾದದ್ದು.<verse eid="PSA 89:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 89:14"/>ನೀತಿಯೂ, ನ್ಯಾಯವೂ ನಿಮ್ಮ ಸಿಂಹಾಸನದ ಅಸ್ತಿವಾರವಾಗಿವೆ.</para>
  <para style="q2" vid="PSA 89:14">ಪ್ರೀತಿಯೂ, ಸತ್ಯತೆಯೂ ನಿಮ್ಮ ಮುಂದೆ ಹೋಗುತ್ತವೆ.<verse eid="PSA 89:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 89:15"/>ನಿಮ್ಮ ಉತ್ಸಾಹ ಧ್ವನಿಯನ್ನು ಕೇಳಿದ ಜನರು ಧನ್ಯರು.</para>
  <para style="q2" vid="PSA 89:15">ಯೆಹೋವ ದೇವರೇ, ನಿಮ್ಮ ಸನ್ನಿಧಿಯ ಬೆಳಕಿನಲ್ಲಿ ನಡೆಯುವವರು ಧನ್ಯರು.<verse eid="PSA 89:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 89:16"/>ನಿಮ್ಮ ಹೆಸರಿನಿಂದ ದಿನವೆಲ್ಲಾ ಉಲ್ಲಾಸಪಟ್ಟು,</para>
  <para style="q2" vid="PSA 89:16">ನಿಮ್ಮ ನೀತಿಯಲ್ಲಿ ಅವರು ಉನ್ನತಕ್ಕೇರುವರು.<verse eid="PSA 89:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 89:17"/>ಏಕೆಂದರೆ ಅವರ ಬಲವೂ ಮಹಿಮೆಯೂ ನೀವೇ.</para>
  <para style="q2" vid="PSA 89:17">ನಿಮ್ಮ ಮೆಚ್ಚುಗೆಯಿಂದ ನಮ್ಮ ಬಲವೆಂಬ ಕೊಂಬು ಉನ್ನತವಾಗುವುದು.<verse eid="PSA 89:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 89:18"/>ನಮ್ಮ ಗುರಾಣಿಯು ಯೆಹೋವ ದೇವರದೇ.</para>
  <para style="q2" vid="PSA 89:18">ನಮ್ಮ ಅರಸರು ಇಸ್ರಾಯೇಲರ ಪರಿಶುದ್ಧರಾಗಿರುವರು.<verse eid="PSA 89:18"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 89:19"/>ಆ ಕಾಲದಲ್ಲಿ ನೀವು ದರ್ಶನದಲ್ಲಿ</para>
  <para style="q2" vid="PSA 89:19">ನಿಮ್ಮ ಭಕ್ತರಿಗೆ ಹೇಳಿದ್ದೇನೆಂದರೆ:</para>
  <para style="q1" vid="PSA 89:19">“ಒಬ್ಬ ಶೂರನಿಗೆ ನಾನು ಬಲವನ್ನು ಅನುಗ್ರಹಿಸಿದ್ದೇನೆ.</para>
  <para style="q2" vid="PSA 89:19">ಪ್ರಜೆಗಳಲ್ಲಿ ಒಬ್ಬ ಯೌವನಸ್ಥನನ್ನು ಆರಿಸಿ ಉನ್ನತ ಸ್ಥಾನದಲ್ಲಿಟ್ಟಿದ್ದೇನೆ.<verse eid="PSA 89:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 89:20"/>ನನ್ನ ಸೇವಕನಾದ ದಾವೀದನನ್ನು ಕಂಡು,</para>
  <para style="q2" vid="PSA 89:20">ನನ್ನ ಪರಿಶುದ್ಧ ಎಣ್ಣೆಯಿಂದ ಅವನನ್ನು ಅಭಿಷೇಕಿಸಿದ್ದೇನೆ.<verse eid="PSA 89:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 89:21"/>ನನ್ನ ಕೈ ಅವನನ್ನು ಪರಿಪಾಲಿಸುವುದು;</para>
  <para style="q2" vid="PSA 89:21">ನನ್ನ ಭುಜವು ಅವನನ್ನು ಬಲಪಡಿಸುವುದು.<verse eid="PSA 89:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 89:22"/>ಶತ್ರುವು ಅವನನ್ನು ಜಯಿಸಲಾರನು.</para>
  <para style="q2" vid="PSA 89:22">ಯಾವ ದುಷ್ಟನೂ ಅವನನ್ನು ಹಿಂಸೆಪಡಿಸನು.<verse eid="PSA 89:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 89:23"/>ಅವನ ಮುಂದೆ ಅವನ ವೈರಿಗಳನ್ನು ಓಡಿಸಿಬಿಡುವೆನು;</para>
  <para style="q2" vid="PSA 89:23">ಅವನ ವಿರೋಧಿಗಳನ್ನು ದಂಡಿಸುವೆನು.<verse eid="PSA 89:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 89:24"/>ನನ್ನ ನಂಬಿಗಸ್ತಿಕೆಯೂ ಪ್ರೀತಿಯೂ ಅವನ ಸಂಗಡ ಇರುವುವು.</para>
  <para style="q2" vid="PSA 89:24">ನನ್ನ ಹೆಸರಿನಲ್ಲಿ ಅವನ ಬಲವೆಂಬ ಕೊಂಬು ಉನ್ನತವಾಗುವುದು.<verse eid="PSA 89:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 89:25"/>ಸಮುದ್ರ ಹಾಗು ನದಿಗಳ ಮೇಲೆ</para>
  <para style="q2" vid="PSA 89:25">ಅವನ ಬಲಗೈಯನ್ನೂ ಇರಿಸುವೆನು.<verse eid="PSA 89:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 89:26"/>ಅವನು, ‘ನೀವು ನನ್ನ ತಂದೆಯೂ</para>
  <para style="q2" vid="PSA 89:26">ನನ್ನ ದೇವರೂ ನನ್ನ ರಕ್ಷಣೆಯ ಬಂಡೆಯೂ ಆಗಿದ್ದೀರಿ’ ಎಂದು ನನಗೆ ಮೊರೆಯಿಡುವನು.<verse eid="PSA 89:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 89:27"/>ನಾನು ಆತನನ್ನು ನನ್ನ ಚೊಚ್ಚಲ ಮಗನನ್ನಾಗಿಯೂ</para>
  <para style="q2" vid="PSA 89:27">ಭೂಮಿಯ ಅರಸರಿಗಿಂತ ಉನ್ನತನನ್ನಾಗಿಯೂ ಮಾಡಿಕೊಳ್ಳುವೆನು.<verse eid="PSA 89:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 89:28"/>ಎಂದೆಂದಿಗೂ ಆತನಿಗೋಸ್ಕರ ನನ್ನ ಪ್ರೀತಿಯನ್ನು ಕಾದಿಡುವೆನು.</para>
  <para style="q2" vid="PSA 89:28">ನನ್ನ ಒಡಂಬಡಿಕೆಯು ಆತನೊಂದಿಗೆ ದೃಢವಾಗಿರುವುದು.<verse eid="PSA 89:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="PSA 89:29"/>ಆತನ ಸಂತತಿಯನ್ನು ಸಹ ಎಂದೆಂದಿಗೂ</para>
  <para style="q2" vid="PSA 89:29">ಆತನ ಸಿಂಹಾಸನವನ್ನು ಆಕಾಶ ಇರುವವರೆಗೂ ಮಾಡುವೆನು.<verse eid="PSA 89:29"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="30" style="v" sid="PSA 89:30"/>“ಆತನ ಸಂತತಿಯು ನನ್ನ ನಿಯಮವನ್ನು ಬಿಟ್ಟು,</para>
  <para style="q2" vid="PSA 89:30">ನನ್ನ ಶಾಸನಗಳನ್ನು ಅನುಸರಿಸಿ ನಡೆಯದೆ,<verse eid="PSA 89:30"/></para>
  <para style="q1">
    <verse number="31" style="v" sid="PSA 89:31"/>ಅವರು ನನ್ನ ತೀರ್ಪುಗಳನ್ನು ಮುರಿದು,</para>
  <para style="q2" vid="PSA 89:31">ನನ್ನ ಆಜ್ಞೆಗಳನ್ನು ಕೈಗೊಳ್ಳದೆ ಹೋದರೆ,<verse eid="PSA 89:31"/></para>
  <para style="q1">
    <verse number="32" style="v" sid="PSA 89:32"/>ಕೋಲಿನಿಂದ ಅವರ ದ್ರೋಹವನ್ನೂ</para>
  <para style="q2" vid="PSA 89:32">ಪೆಟ್ಟುಗಳಿಂದ ಅವರ ಅಕ್ರಮವನ್ನೂ ದಂಡಿಸುವೆನು.<verse eid="PSA 89:32"/></para>
  <para style="q1">
    <verse number="33" style="v" sid="PSA 89:33"/>ಆದರೂ ನನ್ನ ಪ್ರೀತಿ, ಕರುಣೆಯನ್ನು ಆತನಿಂದ ಸಂಪೂರ್ಣವಾಗಿ ತೊಲಗಿಸೆನು.</para>
  <para style="q2" vid="PSA 89:33">ಇಲ್ಲವೆ ನನ್ನ ನಂಬಿಗಸ್ತಿಕೆಯಿಂದ ನಾನು ಜಾರಿಹೋಗೆನು.<verse eid="PSA 89:33"/></para>
  <para style="q1">
    <verse number="34" style="v" sid="PSA 89:34"/>ನನ್ನ ಒಡಂಬಡಿಕೆಯನ್ನು ನಾನು ಮುರಿಯೆನು.</para>
  <para style="q2" vid="PSA 89:34">ಇಲ್ಲವೆ ನನ್ನ ತುಟಿಗಳಿಂದ ಹೊರಟದ್ದನ್ನು ಬದಲಾಯಿಸೆನು.<verse eid="PSA 89:34"/></para>
  <para style="q1">
    <verse number="35" style="v" sid="PSA 89:35"/>ಒಂದೇ ಸಾರಿ ನನ್ನ ಪರಿಶುದ್ಧತ್ವದಿಂದ ಆಣೆಯಿಟ್ಟು ಹೇಳಿದ್ದೇನೆ.</para>
  <para style="q2" vid="PSA 89:35">ದಾವೀದನಿಗೆ ಸುಳ್ಳಾಡೆನು.<verse eid="PSA 89:35"/></para>
  <para style="q1">
    <verse number="36" style="v" sid="PSA 89:36"/>ಆತನ ಸಂತತಿಯು ಯುಗಯುಗಕ್ಕೂ ಇರುವುದು.</para>
  <para style="q2" vid="PSA 89:36">ಆತನ ಸಿಂಹಾಸನವು ನನ್ನ ಮುಂದೆ ಸೂರ್ಯನ ಹಾಗೆಯೂ ಇರುವುದು.<verse eid="PSA 89:36"/></para>
  <para style="q1">
    <verse number="37" style="v" sid="PSA 89:37"/>ಚಂದ್ರನ ಹಾಗೆ ಅದು ಯುಗಯುಗಕ್ಕೂ ಸ್ಥಿರವಾಗಿರುವುದು;</para>
  <para style="q2" vid="PSA 89:37">ಆಕಾಶದಲ್ಲಿರುವ ಸಾಕ್ಷಿಯ ಹಾಗೆ ನಂಬಿಗಸ್ತಿಕೆಯುಳ್ಳದ್ದಾಗಿರುವುದು.”<verse eid="PSA 89:37"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="38" style="v" sid="PSA 89:38"/>ಆದರೆ ನೀವು ತಿರಸ್ಕರಿಸಿ ಬಿಟ್ಟುಬಿಟ್ಟ,</para>
  <para style="q2" vid="PSA 89:38">ನಿಮ್ಮ ಅಭಿಷಿಕ್ತನಿಗೆ ವಿರೋಧವಾಗಿ ಬೇಸರವಾದಿರಿ.<verse eid="PSA 89:38"/></para>
  <para style="q1">
    <verse number="39" style="v" sid="PSA 89:39"/>ನಿಮ್ಮ ಸೇವಕನೊಂದಿಗೆ ಮಾಡಿಕೊಂಡ ಒಡಂಬಡಿಕೆಯನ್ನು ಅಸಡ್ಡೆಮಾಡಿ,</para>
  <para style="q2" vid="PSA 89:39">ಅವನ ಕಿರೀಟವನ್ನು ಮಣ್ಣುಪಾಲು ಮಾಡಿದ್ದೀರಿ.<verse eid="PSA 89:39"/></para>
  <para style="q1">
    <verse number="40" style="v" sid="PSA 89:40"/>ಅವನ ಗೋಡೆಗಳನ್ನೆಲ್ಲಾ ಮುರಿದು,</para>
  <para style="q2" vid="PSA 89:40">ಅವನ ಕೋಟೆಗಳನ್ನು ಹಾಳುಮಾಡಲು ಅನುಮತಿಸಿದ್ದೀರಿ.<verse eid="PSA 89:40"/></para>
  <para style="q1">
    <verse number="41" style="v" sid="PSA 89:41"/>ದಾರಿಯಲ್ಲಿ ಹೋಗುವವರು ಅವನನ್ನು ಕೊಳ್ಳೆ ಹೊಡೆಯುತ್ತಾರೆ.</para>
  <para style="q2" vid="PSA 89:41">ತನ್ನ ನೆರೆಯವರಿಗೆ ಅವನು ನಿಂದೆಯಾಗಿದ್ದಾನೆ.<verse eid="PSA 89:41"/></para>
  <para style="q1">
    <verse number="42" style="v" sid="PSA 89:42"/>ಅವನ ವೈರಿಗಳ ಬಲಗೈ ಉನ್ನತವಾಗಿದೆ.</para>
  <para style="q2" vid="PSA 89:42">ಅವನ ವೈರಿಗಳೆಲ್ಲಾ ಆನಂದಿಸುತ್ತಿದ್ದಾರೆ.<verse eid="PSA 89:42"/></para>
  <para style="q1">
    <verse number="43" style="v" sid="PSA 89:43"/>ಅವನ ಖಡ್ಗದ ಮೊನೆ ಮೊಂಡಾಗಿದೆ.</para>
  <para style="q2" vid="PSA 89:43">ಯುದ್ಧದಲ್ಲಿ ನೀವು ಅವನನ್ನು ನಿಲ್ಲುವಂತೆ ಮಾಡಲಿಲ್ಲ.<verse eid="PSA 89:43"/></para>
  <para style="q1">
    <verse number="44" style="v" sid="PSA 89:44"/>ಅವನ ಪ್ರಭೆ ಮುಗಿದು ಹೋಗಿದೆ.</para>
  <para style="q2" vid="PSA 89:44">ಅವನ ಸಿಂಹಾಸನ ಉರುಳಿಬಿಟ್ಟಿದೆ.<verse eid="PSA 89:44"/></para>
  <para style="q1">
    <verse number="45" style="v" sid="PSA 89:45"/>ಅವನ ಯೌವನದ ದಿವಸಗಳು ಕಡಿಮೆಯಾಗಿದೆ.</para>
  <para style="q2" vid="PSA 89:45">ನಾಚಿಕೆ ಎಂಬ ವಸ್ತ್ರ ಅವನನ್ನು ಮುಚ್ಚಲು ನೀವು ಅನುಮತಿಸಿದ್ದೀರಿ.<verse eid="PSA 89:45"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="46" style="v" sid="PSA 89:46"/>ಯೆಹೋವ ದೇವರೇ, ಇನ್ನೂ ಎಷ್ಟರವರೆಗೆ? ಸದಾಕಾಲಕ್ಕೆ ನೀವು ಅಡಗಿಕೊಳ್ಳುವಿರಾ?</para>
  <para style="q2" vid="PSA 89:46">ನಿಮ್ಮ ಬೇಸರವು ಬೆಂಕಿಯ ಹಾಗೆ ಉರಿಯುವುದು ಎಷ್ಟರವರೆಗೆ?<verse eid="PSA 89:46"/></para>
  <para style="q1">
    <verse number="47" style="v" sid="PSA 89:47"/>ನನ್ನ ಆಯುಸ್ಸು ಎಷ್ಟು ಕಡಿಮೆ ಎಂದು ಜ್ಞಾಪಕಮಾಡಿಕೊಳ್ಳಿರಿ.</para>
  <para style="q2" vid="PSA 89:47">ನಿರ್ಮಿಸಿದ ಎಲ್ಲಾ ಮನುಷ್ಯರೂ ವ್ಯರ್ಥವಾಗಿದ್ದಾರೆ.<verse eid="PSA 89:47"/></para>
  <para style="q1">
    <verse number="48" style="v" sid="PSA 89:48"/>ಮರಣವನ್ನು ಕಾಣದೆ ಬದುಕುವಂಥವರು ಯಾರು?</para>
  <para style="q2" vid="PSA 89:48">ಸಮಾಧಿಯ ಶಕ್ತಿಯಿಂದ ಪ್ರಾಣವನ್ನು ತಪ್ಪಿಸಿಕೊಳ್ಳುವಂಥವರು ಯಾರು?<verse eid="PSA 89:48"/></para>
  <para style="q1">
    <verse number="49" style="v" sid="PSA 89:49"/>ಯೆಹೋವ ದೇವರೇ, ನಿಮ್ಮ ಸತ್ಯದಲ್ಲಿ ನೀವು ದಾವೀದನಿಗೆ ಆಣೆಯಿಟ್ಟೆ.</para>
  <para style="q2" vid="PSA 89:49">ನಿಮ್ಮ ಮೊದಲಿನ ಮಹಾ ಪ್ರೀತಿ ಎಲ್ಲಿ?<verse eid="PSA 89:49"/></para>
  <para style="q1">
    <verse number="50" style="v" sid="PSA 89:50"/>ಯೆಹೋವ ದೇವರೇ, ನಿಮ್ಮ ಸೇವಕನು ನಿಂದೆ ಹೊಂದಿರುವದನ್ನು ನೆನಸಿಕೊಳ್ಳಿರಿ.</para>
  <para style="q2" vid="PSA 89:50">ಎಲ್ಲಾ ರಾಷ್ಟ್ರಗಳ ಅಪಹಾಸ್ಯವನ್ನು ನಾನು ಹೇಗೆ</para>
  <para style="q2" vid="PSA 89:50">ಸಹಿಸಿದೆನೆಂಬುದನ್ನು ಜ್ಞಾಪಕಮಾಡಿಕೊಳ್ಳಿರಿ.<verse eid="PSA 89:50"/></para>
  <para style="q1">
    <verse number="51" style="v" sid="PSA 89:51"/>ಯೆಹೋವ ದೇವರೇ, ನಿಮ್ಮ ಶತ್ರುಗಳು ನಿಂದಿಸುತ್ತಿದ್ದಾರೆ.</para>
  <para style="q2" vid="PSA 89:51">ನಿಮ್ಮ ಅಭಿಷಿಕ್ತನ ಹೆಜ್ಜೆ ಹೆಜ್ಜೆಗೂ ನಿಂದಿಸುತ್ತಾರಲ್ಲಾ?<verse eid="PSA 89:51"/></para>
  <para style="b"/>
  <para style="b"/>
  <para style="q1">
    <verse number="52" style="v" sid="PSA 89:52"/>ಯೆಹೋವ ದೇವರಿಗೆ ಯುಗಯುಗಕ್ಕೂ ಸ್ತುತಿಯಾಗಲಿ.</para>
  <para style="qc" vid="PSA 89:52">ಆಮೆನ್, ಆಮೆನ್.<verse eid="PSA 89:52"/></para>
  <chapter eid="PSA 89"/>
  <chapter number="90" style="c" sid="PSA 90"/>
  <para style="ms">ಭಾಗ 4</para>
  <para style="mr">ಕೀರ್ತನೆಗಳು <ref loc="PSA 90-106">90–106</ref></para>
  <para style="cl">ಕೀರ್ತನೆ 90</para>
  <para style="d">ದೇವರ ಮನುಷ್ಯನಾದ ಮೋಶೆಯ ಪ್ರಾರ್ಥನೆ.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 90:1"/>ಯೆಹೋವ ದೇವರೇ, ತಲತಲಾಂತರಗಳಲ್ಲಿ</para>
  <para style="q2" vid="PSA 90:1">ನೀವು ನಮ್ಮ ವಾಸಸ್ಥಾನವಾಗಿದ್ದೀರಿ.<verse eid="PSA 90:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 90:2"/>ಬೆಟ್ಟಗಳು ಹುಟ್ಟುವುದಕ್ಕಿಂತ ಮುಂಚೆಯೂ</para>
  <para style="q2" vid="PSA 90:2">ನೀವು ಲೋಕವನ್ನೂ ನಿರ್ಮಿಸುವುದಕ್ಕಿಂತ</para>
  <para style="q2" vid="PSA 90:2">ಮುಂಚೆಯೂ ಯುಗಯುಗಾಂತರಕ್ಕೂ ನೀವು ದೇವರಾಗಿದ್ದೀರಿ.<verse eid="PSA 90:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 90:3"/>ನೀವು ಮನುಷ್ಯರನ್ನು ಪುನಃ ಮಣ್ಣಿಗೆ ಸೇರಿಸುತ್ತೀರಿ.</para>
  <para style="q2" vid="PSA 90:3">“ಮನುಷ್ಯ ಪುತ್ರರೇ<note caller="+" style="f"><char style="fr" closed="false">90:3 </char><char style="fq" closed="false">ಮನುಷ್ಯ ಪುತ್ರರೇ </char><char style="ft" closed="false">ಅಂದರೆ </char><char style="fqa" closed="false">ಮಣ್ಣಿನ ಮಕ್ಕಳೇ</char></note>, ಮಣ್ಣಿಗೆ ಮರಳಿರಿ,” ಎಂದು ಹೇಳುತ್ತೀರಿ.<verse eid="PSA 90:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 90:4"/>ಸಾವಿರ ವರ್ಷಗಳು ನಿಮ್ಮ ದೃಷ್ಟಿಗೆ</para>
  <para style="q2" vid="PSA 90:4">ಕಳೆದುಹೋದ ಒಂದು ದಿವಸದ ಹಾಗೆಯೂ</para>
  <para style="q2" vid="PSA 90:4">ರಾತ್ರಿ ಜಾವದ ಹಾಗೆಯೂ ಇವೆ.<verse eid="PSA 90:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 90:5"/>ನೀವು ಜನರನ್ನು ಮರಣ ನಿದ್ರೆಯ ಪ್ರವಾಹದಂತೆ ಹೋಗಲು ಅನುಮತಿಸುತ್ತೀರಿ.</para>
  <para style="q2" vid="PSA 90:5">ಅವರು ಬೆಳಿಗ್ಗೆ ಬೆಳೆಯುವ ಹುಲ್ಲಿನ ಹಾಗೆ ಇದ್ದಾರೆ.<verse eid="PSA 90:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 90:6"/>ಅದು ಬೆಳಿಗ್ಗೆ ಅರಳಿ ಬೆಳೆಯುತ್ತದೆ.</para>
  <para style="q2" vid="PSA 90:6">ಸಂಜೆಯಲ್ಲಿ ಒಣಗಿ ಬಿದ್ದು ಹೋಗುತ್ತದೆ.<verse eid="PSA 90:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 90:7"/>ನಾವು ನಿಮ್ಮ ಬೇಸರದಿಂದ ಬಾಧಿತರಾಗಿದ್ದೇವೆ.</para>
  <para style="q2" vid="PSA 90:7">ನಿಮ್ಮ ಖಂಡನೆಯಿಂದ ತಲ್ಲಣಿಸುತ್ತೇವೆ.<verse eid="PSA 90:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 90:8"/>ನಮ್ಮ ಅಕ್ರಮಗಳನ್ನು ನಿಮ್ಮ ಮುಂದೆ ಇಟ್ಟಿದ್ದೀರಿ.</para>
  <para style="q2" vid="PSA 90:8">ನಾವು ಮುಚ್ಚಿಟ್ಟುಕೊಂಡಿರುವ ಪಾಪಗಳು ನಿಮ್ಮ ಸನ್ನಿಧಿಯಲ್ಲಿವೆ.<verse eid="PSA 90:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 90:9"/>ನಮ್ಮ ದಿವಸಗಳೆಲ್ಲಾ ನಿಮ್ಮ ಖಂಡನೆಯಿಂದಲೇ ದಾಟಿಹೋದವು.</para>
  <para style="q2" vid="PSA 90:9">ನಮ್ಮ ವರ್ಷಗಳನ್ನು ನಿಟ್ಟುಸಿರಿನಲ್ಲಿ ಕಳೆಯುತ್ತಿದ್ದೇವೆ.<verse eid="PSA 90:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 90:10"/>ನಮ್ಮ ಜೀವನದ ದಿನಗಳು ಎಪ್ಪತ್ತು ವರ್ಷ,</para>
  <para style="q2" vid="PSA 90:10">ಬಲದಿಂದಿದ್ದರೆ ಎಂಬತ್ತು ವರ್ಷ.</para>
  <para style="q1" vid="PSA 90:10">ಆದಾಗ್ಯೂ ಅವುಗಳ ಉತ್ತಮ ವರ್ಷಗಳು ಕಷ್ಟವೂ ಪ್ರಯಾಸವೂ ಆಗಿವೆ.</para>
  <para style="q2" vid="PSA 90:10">ನಮ್ಮ ದಿನಗಳು ಬೇಗ ತೀರಿಹೋಗುತ್ತವೆ. ನಾವು ಹಾರಿಹೋಗುತ್ತೇವೆ.<verse eid="PSA 90:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 90:11"/>ನಿಮ್ಮ ಕೋಪದ ಶಕ್ತಿಯನ್ನು ತಿಳಿದವರ‍್ಯಾರು?</para>
  <para style="q2" vid="PSA 90:11">ನಿಮ್ಮ ಮೇಲಿನ ಭಯಭಕ್ತಿಗೆ ಕಾರಣವಾಗಿರುವ ನಿಮ್ಮ ಖಂಡನೆಯನ್ನು ಗ್ರಹಿಸುವವರ‍್ಯಾರು?<verse eid="PSA 90:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 90:12"/>ನಾವು ಜ್ಞಾನವುಳ್ಳ ಹೃದಯವನ್ನು ಹೊಂದುವ ಹಾಗೆ,</para>
  <para style="q2" vid="PSA 90:12">ನಮ್ಮ ದಿನಗಳನ್ನು ಲೆಕ್ಕಿಸುವುದಕ್ಕೆ ನಮಗೆ ಕಲಿಸಿಕೊಡಿರಿ.<verse eid="PSA 90:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 90:13"/>ಯೆಹೋವ ದೇವರೇ, ಮನಸ್ಸು ಮಾರ್ಪಡಿಸಿಕೊಳ್ಳಿರಿ. ನೀವು ಎಷ್ಟರವರೆಗೆ ಬೇಸರಗೊಳ್ಳುವಿರಿ?</para>
  <para style="q2" vid="PSA 90:13">ನಿಮ್ಮ ಸೇವಕರ ವಿಷಯದಲ್ಲಿ ಅನುಕಂಪ ತೋರಿಸಿರಿ.<verse eid="PSA 90:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 90:14"/>ಬೆಳಿಗ್ಗೆ ನಿಮ್ಮ ಒಡಂಬಡಿಕೆಯ ಪ್ರೀತಿಯಿಂದ ನಮ್ಮನ್ನು ತೃಪ್ತಿಪಡಿಸಿರಿ.</para>
  <para style="q2" vid="PSA 90:14">ಆಗ ನಮ್ಮ ದಿನಗಳೆಲ್ಲಾ ಉತ್ಸಾಹ ಧ್ವನಿಗೈದು ನಿಮ್ಮಲ್ಲಿ ಸಂತೋಷಪಡುವೆವು.<verse eid="PSA 90:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 90:15"/>ನೀವು ನಮ್ಮನ್ನು ಬಾಧಿಸಿದಷ್ಟು ಕಾಲ ಹರ್ಷಗೊಳಿಸಿರಿ.</para>
  <para style="q2" vid="PSA 90:15">ನಾವು ತೊಂದರೆಯನ್ನು ನೋಡಿದಷ್ಟು ವರ್ಷಗಳು ನಮ್ಮನ್ನು ಸಂತೋಷಪಡಿಸಿರಿ.<verse eid="PSA 90:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 90:16"/>ನಿಮ್ಮ ಸೇವಕರಿಗೆ ನಿಮ್ಮ ಕೃತ್ಯಗಳನ್ನು ಪ್ರಕಟಿಸಿರಿ.</para>
  <para style="q2" vid="PSA 90:16">ಅವರ ಮಕ್ಕಳಿಗೆ ನಿಮ್ಮ ಪ್ರಭೆಯೂ ತೋರಿ ಬರಲಿ.<verse eid="PSA 90:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 90:17"/>ನಮ್ಮ ದೇವರಾದ ಯೆಹೋವ ದೇವರ ಮೆಚ್ಚುಗೆಯು ನಮ್ಮ ಮೇಲೆ ಇರಲಿ.</para>
  <para style="q2" vid="PSA 90:17">ನಮ್ಮ ಕೈಗಳ ಕೆಲಸವನ್ನು ಸ್ಥಿರಪಡಿಸಿರಿ.</para>
  <para style="q2" vid="PSA 90:17">ಹೌದು, ನಮ್ಮ ಕೈಗಳ ಕೆಲಸವನ್ನು ಸ್ಥಾಪಿಸಿರಿ.<verse eid="PSA 90:17"/></para>
  <chapter eid="PSA 90"/>
  <chapter number="91" style="c" sid="PSA 91"/>
  <para style="cl">ಕೀರ್ತನೆ 91</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 91:1"/>ಮಹೋನ್ನತ ದೇವರ ಆಶ್ರಯದಲ್ಲಿ ವಾಸಿಸುವವರು</para>
  <para style="q2" vid="PSA 91:1">ಸರ್ವಶಕ್ತರ ನೆರಳಿನಲ್ಲಿ ವಿಶ್ರಮಿಸುವರು.<verse eid="PSA 91:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 91:2"/>“ನನ್ನ ಆಶ್ರಯವೂ, ನನ್ನ ಕೋಟೆಯೂ,</para>
  <para style="q2" vid="PSA 91:2">ನಾನು ಭರವಸೆ ಇಡುವ ನನ್ನ ದೇವರೂ ಎಂದು ನಾನು ಯೆಹೋವ ದೇವರಿಗೆ ಹೇಳುವೆನು.”<verse eid="PSA 91:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 91:3"/>ನಿಶ್ಚಯವಾಗಿ ದೇವರು ನಿಮ್ಮನ್ನು</para>
  <para style="q2" vid="PSA 91:3">ಬೇಡನ ಉರುಲಿನಿಂದ ರಕ್ಷಿಸುವರು.</para>
  <para style="q2" vid="PSA 91:3">ಮರಣಾಂತಿಕವಾದ ಸಾಂಕ್ರಾಮಿಕ ರೋಗದಿಂದಲೂ ಬಿಡಿಸುವರು.<verse eid="PSA 91:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 91:4"/>ತಮ್ಮ ರೆಕ್ಕೆಗಳಿಂದ ನಿಮ್ಮನ್ನು ಹೊದಿಸುವರು.</para>
  <para style="q2" vid="PSA 91:4">ದೇವರ ರೆಕ್ಕೆಗಳ ಕೆಳಗೆ ಆಶ್ರಯಿಸಿಕೊಳ್ಳುವಿರಿ.</para>
  <para style="q2" vid="PSA 91:4">ದೇವರ ಸತ್ಯತೆಯು ನಿಮ್ಮ ಖೇಡ್ಯವೂ ಕೋಟೆಯೂ ಆಗಿರುವುದು.<verse eid="PSA 91:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 91:5"/>ರಾತ್ರಿಯ ಭಯಂಕರತೆಗೆ ನೀನು ಅಂಜಬೇಕಾಗಿಲ್ಲ,</para>
  <para style="q2" vid="PSA 91:5">ಹಗಲಿನಲ್ಲಿ ಹಾರುವ ಬಾಣಕ್ಕೂ ಹೆದರಬೇಕಾಗಿರುವುದಿಲ್ಲ.<verse eid="PSA 91:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 91:6"/>ಅಂಧಕಾರದಲ್ಲಿ ಬೆನ್ನಟ್ಟಿ ಬರುವ ವಿಪತ್ತಿಗೆ ಕಳವಳಪಡದಿರುವೆ.</para>
  <para style="q2" vid="PSA 91:6">ಮಧ್ಯಾಹ್ನದಲ್ಲಿ ಹಾಳುಮಾಡುವ ವ್ಯಾಧಿಗೂ ನೀನು ಭಯಪಡದಿರುವೆ.<verse eid="PSA 91:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 91:7"/>ನಿಮ್ಮ ಪಕ್ಕದಲ್ಲಿ ಸಾವಿರ ಜನರು ಬಿದ್ದರೂ</para>
  <para style="q2" vid="PSA 91:7">ನಿಮ್ಮ ಬಲಗಡೆಯಲ್ಲಿ ಹತ್ತು ಸಾವಿರ ಜನರು ಬಿದ್ದಾಗ್ಯೂ,</para>
  <para style="q2" vid="PSA 91:7">ನಿಮ್ಮ ಸಮೀಪಕ್ಕೆ ಅದು ಬರುವುದಿಲ್ಲ.<verse eid="PSA 91:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 91:8"/>ನಿನ್ನ ಕಣ್ಣುಗಳಿಂದ ಮಾತ್ರ ನೀನು ಗಮನಿಸುವೆ.</para>
  <para style="q2" vid="PSA 91:8">ದುಷ್ಟರಿಗೆ ಪ್ರತಿದಂಡನೆ ಆಗುವುದನ್ನು ಸಹ ನೀನು ಕಾಣುವೆ.<verse eid="PSA 91:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 91:9"/>“ಮಹೋನ್ನತ ದೇವರು ನಮ್ಮ ಆಶ್ರಯ,” ಎಂದು ಹೇಳುವದಾದರೆ,</para>
  <para style="q2" vid="PSA 91:9">ಯೆಹೋವ ದೇವರು ನಿಮ್ಮ ನಿವಾಸವಾಗಿ ಮಾಡಿಕೊಂಡರೆ,<verse eid="PSA 91:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 91:10"/>ಯಾವ ಕೇಡೂ ನಿಮ್ಮನ್ನು ಮುಟ್ಟದು,</para>
  <para style="q2" vid="PSA 91:10">ಯಾವ ವಿಪತ್ತು ನಿಮ್ಮನ್ನು ಸಮೀಪಿಸುವುದಿಲ್ಲ.<verse eid="PSA 91:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 91:11"/>ಏಕೆಂದರೆ ನಿನ್ನ ಎಲ್ಲಾ ಮಾರ್ಗಗಳಲ್ಲಿ ನಿನ್ನನ್ನು ಕಾಪಾಡುವುದಕ್ಕೆ</para>
  <para style="q2" vid="PSA 91:11">ದೇವರು ತಮ್ಮ ದೂತರಿಗೆ ನಿನ್ನ ವಿಷಯವಾಗಿ ಆಜ್ಞಾಪಿಸುವರು.<verse eid="PSA 91:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 91:12"/>ನಿಮ್ಮ ಪಾದಗಳು ಕಲ್ಲಿಗೆ ತಗಲದಂತೆ</para>
  <para style="q2" vid="PSA 91:12">ದೇವದೂತರು ನಿನ್ನನ್ನು ತಮ್ಮ ಕೈಗಳಲ್ಲಿ ಎತ್ತಿಕೊಳ್ಳುವರು.<verse eid="PSA 91:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 91:13"/>ಸಿಂಹದ ಮೇಲೆಯೂ ಸರ್ಪದ ಮೇಲೆಯೂ ನಡೆಯುವೆ.</para>
  <para style="q2" vid="PSA 91:13">ಪ್ರಾಯದ ಸಿಂಹವನ್ನೂ ಘಟಸರ್ಪವನ್ನೂ ತುಳಿದುಬಿಡುವೆ.<verse eid="PSA 91:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 91:14"/>“ಆತನು ನನ್ನನ್ನು ಪ್ರೀತಿಸುವುದರಿಂದ ಆತನನ್ನು ಸಂರಕ್ಷಿಸುವೆನು.</para>
  <para style="q2" vid="PSA 91:14">ಆತನು ನನ್ನ ನಾಮವನ್ನು ಸ್ವೀಕರಿಸಿದ್ದರಿಂದ ಆತನನ್ನು ಕಾಪಾಡುವೆನು.<verse eid="PSA 91:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 91:15"/>ಆತನು ನನ್ನನ್ನು ಕರೆಯುವನು ನಾನು ಆತನಿಗೆ ಉತ್ತರಕೊಡುವೆನು.</para>
  <para style="q2" vid="PSA 91:15">ಇಕ್ಕಟ್ಟಿನಲ್ಲಿ ನಾನು ಆತನ ಸಂಗಡ ಇದ್ದು,</para>
  <para style="q2" vid="PSA 91:15">ಆತನನ್ನು ಘನಪಡಿಸುವೆನು.<verse eid="PSA 91:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 91:16"/>ದೀರ್ಘಾಯುಷ್ಯದಿಂದ ಆತನನ್ನು ತೃಪ್ತಿಪಡಿಸಿ,</para>
  <para style="q2" vid="PSA 91:16">ನನ್ನ ರಕ್ಷಣೆಯನ್ನು ಆತನಿಗೆ ತೋರಿಸುವೆನು,”</para>
  <para style="q2" vid="PSA 91:16">ಎಂದು ಯೆಹೋವ ದೇವರು ಹೇಳುತ್ತಾರೆ.<verse eid="PSA 91:16"/></para>
  <chapter eid="PSA 91"/>
  <chapter number="92" style="c" sid="PSA 92"/>
  <para style="cl">ಕೀರ್ತನೆ 92</para>
  <para style="d">ಕೀರ್ತನೆ. ಸಬ್ಬತ್<note caller="+" style="f"><char style="fr" closed="false">92:0 </char><char style="fq" closed="false">ಸಬ್ಬತ್ </char><char style="ft" closed="false">ಅಂದರೆ </char><char style="fqa" closed="false">ವಿಶ್ರಾಂತಿ ದಿನ</char></note> ದಿನದ ಗೀತೆ.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 92:1"/>ಯೆಹೋವ ದೇವರೇ, ನಿಮ್ಮನ್ನು ಕೊಂಡಾಡುವುದು ಒಳ್ಳೆಯದು.</para>
  <para style="q2" vid="PSA 92:1">ಮಹೋನ್ನತರೇ, ನಿಮ್ಮ ಹೆಸರನ್ನು ಕೀರ್ತಿಸುವುದು ಒಳ್ಳೆಯದು.<verse eid="PSA 92:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 92:2"/>ಬೆಳಿಗ್ಗೆ ನಿಮ್ಮ ಪ್ರೀತಿ ಕರುಣೆಯನ್ನೂ</para>
  <para style="q2" vid="PSA 92:2">ಪ್ರತಿ ರಾತ್ರಿ ನಿಮ್ಮ ನಂಬಿಕೆಯನ್ನೂ ಸಾರುವುದು ಒಳ್ಳೆಯದು.<verse eid="PSA 92:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 92:3"/>ಹತ್ತು ತಂತಿವಾದ್ಯದಿಂದಲೂ ವೀಣೆಯಿಂದಲೂ</para>
  <para style="q2" vid="PSA 92:3">ಕಿನ್ನರಿಯ ಘನಸ್ವರದಿಂದಲೂ ಬಾರಿಸುವುದು ಒಳ್ಳೆಯದು.<verse eid="PSA 92:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 92:4"/>ಯೆಹೋವ ದೇವರೇ, ನಿಮ್ಮ ಕ್ರಿಯೆಯಿಂದ ನನ್ನನ್ನು ಸಂತೋಷಪಡಿಸಿದ್ದೀರಿ.</para>
  <para style="q2" vid="PSA 92:4">ನಿಮ್ಮ ಕೈಕೆಲಸಗಳಲ್ಲಿ ಜಯಧ್ವನಿಗೈಯುತ್ತೇನೆ.<verse eid="PSA 92:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 92:5"/>ಯೆಹೋವ ದೇವರೇ, ನಿಮ್ಮ ಕೃತ್ಯಗಳು ಎಷ್ಟೋ ಮಹತ್ತಾದದ್ದು.</para>
  <para style="q2" vid="PSA 92:5">ನಿಮ್ಮ ಯೋಚನೆಗಳು ಬಹು ಆಳವಾಗಿವೆ.<verse eid="PSA 92:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 92:6"/>ಇದನ್ನು ಬುದ್ಧಿಹೀನ ಮನುಷ್ಯನು ತಿಳಿದುಕೊಳ್ಳನು.</para>
  <para style="q2" vid="PSA 92:6">ಮೂರ್ಖನು ಇದನ್ನು ಗ್ರಹಿಸನು.<verse eid="PSA 92:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 92:7"/>ದುಷ್ಟರು ಹುಲ್ಲಿನ ಹಾಗೆ ಚಿಗುರಿದರೂ</para>
  <para style="q2" vid="PSA 92:7">ಅಕ್ರಮ ಮಾಡುವವರೆಲ್ಲರು ವೃದ್ಧಿ ಆದರೂ</para>
  <para style="q2" vid="PSA 92:7">ಅವರು ನಿತ್ಯ ದಂಡನೆಗೆ ಗುರಿಯಾಗುವರು.<verse eid="PSA 92:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 92:8"/>ಯೆಹೋವ ದೇವರೇ, ನೀವಾದರೋ ಎಂದೆಂದಿಗೂ ಉನ್ನತರಾಗಿದ್ದೀರಿ.<verse eid="PSA 92:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 92:9"/>ನಿಜವಾಗಿಯೂ ನಿಮ್ಮ ಶತ್ರುಗಳು ಯೆಹೋವ ದೇವರೇ,</para>
  <para style="q2" vid="PSA 92:9">ನಿಮ್ಮ ಶತ್ರುಗಳು ನಾಶವಾಗುವರು.</para>
  <para style="q2" vid="PSA 92:9">ಕೇಡು ಮಾಡುವವರೆಲ್ಲರು ಚದರಿಹೋಗುವರು.<verse eid="PSA 92:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 92:10"/>ಆದರೆ ನೀವು ನನ್ನ ಬಲವನ್ನು ಕಾಡುಕೋಣದ ಕೊಂಬಿನ ಹಾಗೆ ಬಲಪಡಿಸುವಿರಿ.</para>
  <para style="q2" vid="PSA 92:10">ನಾನು ನೂತನ ತೈಲದಿಂದ ಅಭಿಷಿಕ್ತನಾಗುವೆನು.<verse eid="PSA 92:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 92:11"/>ನನ್ನ ಕಣ್ಣು ನನ್ನ ವಿರೋಧಿಗಳ ಸೋಲನ್ನು ದೃಷ್ಟಿಸುವುದು.</para>
  <para style="q2" vid="PSA 92:11">ನನಗೆ ವಿರೋಧವಾಗಿ ಏಳುವ ದುರ್ಮಾರ್ಗಿಗಳ ವಿಪತ್ತನ್ನು ಕುರಿತು ನಾನು ಕೇಳಿಸಿಕೊಳ್ಳುವೆ.<verse eid="PSA 92:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 92:12"/>ನೀತಿವಂತರು ಖರ್ಜೂರ ಮರದ ಹಾಗೆ ವೃದ್ಧಿಯಾಗುವರು.</para>
  <para style="q2" vid="PSA 92:12">ಅವರು ಲೆಬನೋನಿನಲ್ಲಿರುವ ದೇವದಾರಿನ ಹಾಗೆ ಬೆಳೆಯುವರು.<verse eid="PSA 92:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 92:13"/>ಅವರು ಯೆಹೋವ ದೇವರ ಆಲಯದಲ್ಲಿ ನೆಟ್ಟ ಸಸಿಗಳಂತಿರುವರು.</para>
  <para style="q2" vid="PSA 92:13">ನಮ್ಮ ದೇವರ ಅಂಗಳಗಳಲ್ಲಿ ಅವರು ವೃದ್ಧಿ ಆಗುವರು.<verse eid="PSA 92:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 92:14"/>ಮುದಿಪ್ರಾಯದಲ್ಲಿಯೂ ಫಲ ಕೊಡುವರು.</para>
  <para style="q2" vid="PSA 92:14">ಅವರು ಹಸಿರಾಗಿ ಶೋಭಿಸುವರು.<verse eid="PSA 92:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 92:15"/>“ಯೆಹೋವ ದೇವರು ಯಥಾರ್ಥವಂತರೂ</para>
  <para style="q2" vid="PSA 92:15">ನನ್ನ ಬಂಡೆಯೂ ಆಗಿದ್ದಾರೆ. ಅವರಲ್ಲಿ ಅನೀತಿ ಇರುವುದಿಲ್ಲ,”</para>
  <para style="q2" vid="PSA 92:15">ಎಂದು ನೀತಿವಂತರು ಘೋಷಿಸುವರು.<verse eid="PSA 92:15"/></para>
  <chapter eid="PSA 92"/>
  <chapter number="93" style="c" sid="PSA 93"/>
  <para style="cl">ಕೀರ್ತನೆ 93</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 93:1"/>ಯೆಹೋವ ದೇವರು ಆಳಿಕೆ ಮಾಡುತ್ತಿದ್ದಾರೆ. ಘನತೆಯನ್ನು ಹೊದ್ದುಕೊಂಡಿದ್ದಾರೆ.</para>
  <para style="q2" vid="PSA 93:1">ಬಲದಿಂದ ತಮ್ಮ ನಡುವನ್ನು ಕಟ್ಟಿಕೊಂಡಿದ್ದಾರೆ.</para>
  <para style="q2" vid="PSA 93:1">ಆದುದರಿಂದ ಲೋಕವು ಸಹ ಸ್ಥಿರವಾಗಿದೆ, ಕದಲುವುದಿಲ್ಲ.<verse eid="PSA 93:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 93:2"/>ದೇವರೇ, ನಿಮ್ಮ ಸಿಂಹಾಸನವು ಪೂರ್ವಕಾಲದಿಂದ ಸ್ಥಿರವಾಗಿದೆ.</para>
  <para style="q2" vid="PSA 93:2">ಯುಗಯುಗದಿಂದ ನೀವು ಇದ್ದೀರಿ.<verse eid="PSA 93:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 93:3"/>ಯೆಹೋವ ದೇವರೇ, ಸಮುದ್ರಗಳಲ್ಲಿ ಪ್ರವಾಹಗಳು ಮೊರೆಯುತ್ತಿವೆ.</para>
  <para style="q2" vid="PSA 93:3">ಸಮುದ್ರಗಳು ತಮ್ಮ ಧ್ವನಿಯನ್ನು ಎತ್ತಿವೆ.</para>
  <para style="q2" vid="PSA 93:3">ಸಮುದ್ರಗಳು ತಮ್ಮ ಅಲೆಗಳ ಘೋಷವನ್ನು ಎತ್ತಿವೆ.<verse eid="PSA 93:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 93:4"/>ಮಹಾಸಾಗರದ ಶಬ್ದಕ್ಕಿಂತಲೂ,</para>
  <para style="q2" vid="PSA 93:4">ಸಮುದ್ರದ ಬಲವಾದ ಅಲೆಗಳಿಗಿಂತಲೂ</para>
  <para style="q2" vid="PSA 93:4">ಉನ್ನತದಲ್ಲಿರುವ ಯೆಹೋವ ದೇವರು ಬಲಿಷ್ಠರಾಗಿದ್ದಾರೆ.<verse eid="PSA 93:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 93:5"/>ದೇವರೇ, ನಿಮ್ಮ ಶಾಸನಗಳು ಬಹಳ ನಿಶ್ಚಯವಾದವುಗಳು.</para>
  <para style="q2" vid="PSA 93:5">ಯೆಹೋವ ದೇವರೇ, ಪರಿಶುದ್ಧತೆಯು ಸದಾಕಾಲ</para>
  <para style="q2" vid="PSA 93:5">ನಿಮ್ಮ ಆಲಯವನ್ನು ಅಲಂಕರಿಸುತ್ತದೆ.<verse eid="PSA 93:5"/></para>
  <chapter eid="PSA 93"/>
  <chapter number="94" style="c" sid="PSA 94"/>
  <para style="cl">ಕೀರ್ತನೆ 94</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 94:1"/>ಯೆಹೋವ ದೇವರೇ, ನೀವು ಪ್ರತೀಕಾರ ಸಲ್ಲಿಸುವ ದೇವರಾಗಿದ್ದೀರಿ.</para>
  <para style="q2" vid="PSA 94:1">ಮುಯ್ಯಿ ತೀರಿಸುವವರು ನೀವೇ;</para>
  <para style="q2" vid="PSA 94:1">ದೇವರೇ, ನ್ಯಾಯ ತೀರಿಸುವಂತೆ ನಿಮ್ಮನ್ನು ಪ್ರಕಟಿಸಿಕೊಳ್ಳಿರಿ.<verse eid="PSA 94:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 94:2"/>ಭೂಲೋಕದ ನ್ಯಾಯಾಧಿಪತಿಯೇ,</para>
  <para style="q2" vid="PSA 94:2">ಗರ್ವಿಷ್ಠರಿಗೆ ತಕ್ಕ ಪ್ರತೀಕಾರವನ್ನು ಸಲ್ಲಿಸ ಬನ್ನಿರಿ.<verse eid="PSA 94:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 94:3"/>ಯೆಹೋವ ದೇವರೇ, ಎಲ್ಲಿಯವರೆಗೆ?</para>
  <para style="q2" vid="PSA 94:3">ದುಷ್ಟರು ಎಷ್ಟರವರೆಗೆ ಹಿಗ್ಗುತ್ತಿರಬೇಕು?<verse eid="PSA 94:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 94:4"/>ಕೆಡುಕರು ಉಬ್ಬಿಕೊಂಡು ಮಾತನಾಡುತ್ತಾರೆ.</para>
  <para style="q2" vid="PSA 94:4">ಕೇಡು ಮಾಡುವವರೆಲ್ಲರೂ ಕೊಚ್ಚಿಕೊಳ್ಳುತ್ತಾರೆ.<verse eid="PSA 94:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 94:5"/>ಯೆಹೋವ ದೇವರೇ, ನಿಮ್ಮ ಜನರನ್ನು ಅವರು ಕುಗ್ಗಿಸುತ್ತಾರೆ.</para>
  <para style="q2" vid="PSA 94:5">ನಿಮ್ಮ ಬಾಧ್ಯತೆಯನ್ನು ಬಾಧಿಸುತ್ತಾರೆ.<verse eid="PSA 94:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 94:6"/>ವಿಧವೆಯನ್ನೂ ಪರದೇಶಸ್ಥನನ್ನೂ ಅವರು ಹತ್ಯಮಾಡುತ್ತಾರೆ.</para>
  <para style="q2" vid="PSA 94:6">ದಿಕ್ಕಿಲ್ಲದವರನ್ನು ಹತಮಾಡುತ್ತಾರೆ.<verse eid="PSA 94:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 94:7"/>“ಯೆಹೋವ ದೇವರು ನೋಡುವುದಿಲ್ಲ,</para>
  <para style="q2" vid="PSA 94:7">ಯಾಕೋಬನ ದೇವರು ಗ್ರಹಿಸುವುದಿಲ್ಲ,”</para>
  <para style="q2" vid="PSA 94:7">ಎಂದು ಅವರು ಹೇಳುತ್ತಾರೆ.<verse eid="PSA 94:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 94:8"/>ಜನರಲ್ಲಿ ಬುದ್ಧಿಹೀನರೇ, ನೀವು ಗ್ರಹಿಸಿರಿ.</para>
  <para style="q2" vid="PSA 94:8">ಮೂರ್ಖರೇ, ಯಾವಾಗ ಬುದ್ಧಿವಂತರಾಗುವಿರಿ?<verse eid="PSA 94:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 94:9"/>ಕಿವಿಯನ್ನು ನಿರ್ಮಿಸಿದ ದೇವರು ಕೇಳದಿರುವರೇ?</para>
  <para style="q2" vid="PSA 94:9">ಕಣ್ಣನ್ನು ರೂಪಿಸಿದವರು ನೋಡುವುದಿಲ್ಲವೇ?<verse eid="PSA 94:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 94:10"/>ರಾಷ್ಟ್ರಗಳಿಗೆ ಶಿಕ್ಷಣ ಕೊಡುವ ದೇವರು ಶಿಕ್ಷಿಸುವುದಿಲ್ಲವೋ?</para>
  <para style="q2" vid="PSA 94:10">ಮಾನವನಿಗೆ ಕಲಿಸುವ ದೇವರಲ್ಲಿ ಜ್ಞಾನದ ಕೊರತೆಯಿದೆಯೋ?<verse eid="PSA 94:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 94:11"/>ಮನುಷ್ಯನ ಯೋಚನೆಗಳು ವ್ಯರ್ಥವಾದವುಗಳೆಂದು</para>
  <para style="q2" vid="PSA 94:11">ಯೆಹೋವ ದೇವರು ತಿಳಿದುಕೊಳ್ಳುತ್ತಾರೆ.<verse eid="PSA 94:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 94:12"/>ಯೆಹೋವ ದೇವರೇ, ನೀವು ಯಾರನ್ನು ಶಿಕ್ಷಿಸುವಿರೋ ಅಂಥವರು ಧನ್ಯರು.</para>
  <para style="q2" vid="PSA 94:12">ನಿಮ್ಮ ನಿಯಮದಿಂದ ಯಾರಿಗೆ ಕಲಿಸಿಕೊಡುವಿರೋ ಅವರು ಧನ್ಯರು.<verse eid="PSA 94:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 94:13"/>ದುಷ್ಟನಿಗಾಗಿ ಕುಣಿಯು ಅಗಿಯುವವರೆಗೆ</para>
  <para style="q2" vid="PSA 94:13">ಅಂಥವನಿಗೆ ವಿಶ್ರಾಂತಿಯನ್ನು ಕೊಡುವಿರಿ.<verse eid="PSA 94:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 94:14"/>ಯೆಹೋವ ದೇವರು ತಮ್ಮ ಜನರನ್ನು ತಿರಸ್ಕರಿಸುವುದಿಲ್ಲ.</para>
  <para style="q2" vid="PSA 94:14">ದೇವರು ತಮ್ಮ ಬಾಧ್ಯತೆಯಾಗಿರುವವರನ್ನು ಎಂದೂ ಮರೆಯುವುದಿಲ್ಲ.<verse eid="PSA 94:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 94:15"/>ನ್ಯಾಯ ನಿಯಮವು ನೀತಿಯ ಮೇಲೆ ಅವಲಂಬಿಸಿರುವುದು;</para>
  <para style="q2" vid="PSA 94:15">ಯಥಾರ್ಥ ಹೃದಯದವರೆಲ್ಲರೂ ಅದನ್ನು ಹಿಂಬಾಲಿಸುವರು.<verse eid="PSA 94:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 94:16"/>ನನಗೋಸ್ಕರ ದುರ್ಮಾರ್ಗಿಗಳಿಗೆ ವಿರೋಧವಾಗಿ ಏಳುವವನ್ಯಾರು?</para>
  <para style="q2" vid="PSA 94:16">ಅಪರಾಧ ಮಾಡುವವರಿಗೆ ವಿರೋಧವಾಗಿ ನನಗೋಸ್ಕರ ನಿಂತು ಕೊಳ್ಳುವವನ್ಯಾರು?<verse eid="PSA 94:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 94:17"/>ಯೆಹೋವ ದೇವರು ನನಗೆ ಸಹಾಯ ಕೊಡದಿದ್ದರೆ,</para>
  <para style="q2" vid="PSA 94:17">ನಾನು ಬೇಗನೇ ಮರಣದ ಮೌನದಲ್ಲಿ ವಾಸಿಸುತ್ತಿದ್ದೆನು.<verse eid="PSA 94:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 94:18"/>“ನನ್ನ ಕಾಲು ಜಾರುತ್ತಿದೆ,” ಎಂದು ನಾನು ಹೇಳುತ್ತಿರುವಾಗಲೇ,</para>
  <para style="q2" vid="PSA 94:18">ಯೆಹೋವ ದೇವರೇ, ನಿಮ್ಮ ಪ್ರೀತಿಯು ನನ್ನನ್ನು ಎತ್ತಿ ಹಿಡಿಯಿತು.<verse eid="PSA 94:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 94:19"/>ನನ್ನ ಚಿಂತೆಗಳು ನನ್ನೊಳಗೆ ಹೆಚ್ಚುತ್ತಿರುವಾಗ,</para>
  <para style="q2" vid="PSA 94:19">ನಿಮ್ಮ ಸಂತೈಸುವಿಕೆಯು ನನ್ನ ಮನಸ್ಸನ್ನು ಆನಂದಪಡಿಸುತ್ತದೆ.<verse eid="PSA 94:19"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 94:20"/>ತೀರ್ಪುಗಳಿಂದ ಕೇಡನ್ನು ಕಲ್ಪಿಸುವ ಅಪರಾಧದ ನ್ಯಾಯಾಸನವು</para>
  <para style="q2" vid="PSA 94:20">ನಿಮ್ಮ ಸಂಗಡ ಅನ್ಯೋನ್ಯವಾಗಿರುವುದೋ?<verse eid="PSA 94:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 94:21"/>ನೀತಿವಂತನ ವಿರೋಧವಾಗಿ ಅವರು ಕೂಡಿಕೊಳ್ಳುತ್ತಾರೆ;</para>
  <para style="q2" vid="PSA 94:21">ಅವರ ನಿರಪರಾಧಿಗಳನ್ನು ಮರಣಕ್ಕೆ ಒಪ್ಪಿಸುತ್ತಾರೆ.<verse eid="PSA 94:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 94:22"/>ಆದರೆ ಯೆಹೋವ ದೇವರು ನನಗೆ ದುರ್ಗವೂ,</para>
  <para style="q2" vid="PSA 94:22">ನನ್ನ ದೇವರೂ, ನನ್ನ ಆಶ್ರಯದ ಬಂಡೆಯೂ ಆಗಿದ್ದಾರೆ.<verse eid="PSA 94:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 94:23"/>ವೈರಿಯ ಅಪರಾಧವು ಅವರ ಮೇಲೆಯೇ ತಿರುಗಿ ಬೀಳಲಿ;</para>
  <para style="q2" vid="PSA 94:23">ಅವರ ಕೇಡಿನಲ್ಲಿ ಅವರನ್ನು ಸಂಹರಿಸುವನು;</para>
  <para style="q2" vid="PSA 94:23">ನಮ್ಮ ದೇವರಾದ ಯೆಹೋವ ದೇವರು ಅವರನ್ನು ಸಂಹರಿಸಿ ಬಿಡುವನು.<verse eid="PSA 94:23"/></para>
  <chapter eid="PSA 94"/>
  <chapter number="95" style="c" sid="PSA 95"/>
  <para style="cl">ಕೀರ್ತನೆ 95</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 95:1"/>ಬನ್ನಿರಿ, ಯೆಹೋವ ದೇವರಿಗೆ ಉತ್ಸಾಹ ಗೀತೆಯನ್ನು ಹಾಡೋಣ;</para>
  <para style="q2" vid="PSA 95:1">ನಮ್ಮ ರಕ್ಷಣೆಯ ಬಂಡೆಯಾಗಿರುವ ದೇವರಿಗೆ ಜಯಧ್ವನಿ ಮಾಡೋಣ.<verse eid="PSA 95:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 95:2"/>ಧನ್ಯವಾದದೊಡನೆ ಅವರ ಸನ್ನಿಧಿಯಲ್ಲಿ ಮುಂದೆ ಬಂದು</para>
  <para style="q2" vid="PSA 95:2">ಕೀರ್ತನೆಗಳಿಂದ ಅವರಿಗೆ ಜಯಧ್ವನಿ ಮಾಡೋಣ.<verse eid="PSA 95:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 95:3"/>ಯೆಹೋವ ದೇವರು ಮಹಾ ದೇವರು,</para>
  <para style="q2" vid="PSA 95:3">ಎಲ್ಲಾ ದೇವರುಗಳ ಮೇಲೆ ಮಹಾರಾಜರೂ ಆಗಿದ್ದಾರೆ.<verse eid="PSA 95:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 95:4"/>ಅವರ ಕೈಯಲ್ಲಿ ಭೂಮಿಯ ಆಳವಾದ ಸ್ಥಳಗಳು ಇವೆ;</para>
  <para style="q2" vid="PSA 95:4">ಬೆಟ್ಟಗಳ ಬಲವು ಅವರದೇ.<verse eid="PSA 95:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 95:5"/>ಸಮುದ್ರವು ಅವರಿಗೆ ಸೇರಿದ್ದು; ಅವರು ಅದನ್ನು ಸೃಷ್ಟಿಸಿದರು;</para>
  <para style="q2" vid="PSA 95:5">ಅವರ ಕೈಗಳು ಒಣ ಭೂಮಿಯನ್ನು ರೂಪಿಸಿದವು.<verse eid="PSA 95:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 95:6"/>ಬನ್ನಿರಿ, ಆರಾಧಿಸೋಣ;</para>
  <para style="q2" vid="PSA 95:6">ನಮ್ಮನ್ನು ಸೃಷ್ಟಿಸಿದ ಯೆಹೋವ ದೇವರ ಮುಂದೆ ಮೊಣಕಾಲು ಊರೋಣ.<verse eid="PSA 95:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 95:7"/>ಅವರು ನಮ್ಮ ದೇವರು;</para>
  <para style="q2" vid="PSA 95:7">ನಾವು ಅವರ ಹುಲ್ಲುಗಾವಲಿನ ಪ್ರಜೆಗಳಾಗಿದ್ದೇವೆ,</para>
  <para style="q2" vid="PSA 95:7">ನಾವು ಅವರು ಪರಿಪಾಲಿಸುವ ಮಂದೆಯೂ ಆಗಿದ್ದೇವೆ.</para>
  <para style="b" vid="PSA 95:7"/>
  <para style="q1" vid="PSA 95:7">ನೀವು ಈ ಹೊತ್ತು ಅವರ ಸ್ವರಕ್ಕೆ ಕಿವಿಗೊಟ್ಟರೆ ಎಷ್ಟೋ ಒಳ್ಳೆಯದು.<verse eid="PSA 95:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 95:8"/>“ನೀವು ಮೆರೀಬದಲ್ಲಿ<note caller="+" style="f"><char style="fr" closed="false">95:8 </char><char style="fq" closed="false">ಮೆರೀಬ </char><char style="ft" closed="false">ಅಂದರೆ </char><char style="fqa" closed="false">ಜಗಳ </char><char style="ft" closed="false">ಎಂದು ಅರ್ಥ. ನೋಡಿರಿ <char style="xt"><ref loc="EXO 17:7">ವಿಮೋ 17:7</ref>; <ref loc="NUM 17:7">ಅರಣ್ಯ 17:7</ref></char></char></note> ಮಾಡಿದಂತೆ,</para>
  <para style="q2" vid="PSA 95:8">ಹೌದು, ಅಂದು ನೀವು ಮರುಭೂಮಿಯ ಮಸ್ಸಾ<note caller="+" style="f"><char style="fr" closed="false">95:8 </char><char style="fq" closed="false">ಮಸ್ಸಾ </char><char style="ft" closed="false">ಅಂದರೆ </char><char style="fqa" closed="false">ಪರೀಕ್ಷೆ</char><char style="ft" closed="false">. ನೋಡಿರಿ <char style="xt"><ref loc="EXO 17:7">ವಿಮೋ 17:7</ref>; <ref loc="NUM 17:7">ಅರಣ್ಯ 17:7</ref></char></char></note> ಎಂಬ ಸ್ಥಳದಲ್ಲಿ ಮಾಡಿದಂತೆ, ನಿಮ್ಮ ಹೃದಯವನ್ನು ಕಠಿಣಪಡಿಸಬೇಡಿರಿ.<verse eid="PSA 95:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 95:9"/>ನಾನು ಮಾಡಿದ್ದನ್ನು ಕಂಡಿದ್ದರೂ,</para>
  <para style="q2" vid="PSA 95:9">ಅಲ್ಲಿ ನಿಮ್ಮ ಪಿತೃಗಳು ನನ್ನನ್ನು ಶೋಧಿಸಿ, ನನ್ನನ್ನು ಪರೀಕ್ಷಿಸಿದರು.<verse eid="PSA 95:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 95:10"/>ನಾಲ್ವತ್ತು ವರ್ಷ ಆ ಸಂತತಿಗೆ ಬೇಸರಗೊಂಡು,</para>
  <para style="q2" vid="PSA 95:10">‘ಇವರು ತಮ್ಮ ಹೃದಯದಲ್ಲಿ ತಪ್ಪಿಹೋಗುವ ಜನರಾಗಿದ್ದಾರೆ,</para>
  <para style="q2" vid="PSA 95:10">ನನ್ನ ಮಾರ್ಗಗಳನ್ನು ಇವರು ಅರಿಯರು,’ ಎಂದೆನು.<verse eid="PSA 95:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 95:11"/>ಆದ್ದರಿಂದ, ‘ಅವರು ನನ್ನ ವಿಶ್ರಾಂತಿಯಲ್ಲಿ ಸೇರುವುದೇ ಇಲ್ಲ,’ ” ಎಂದು</para>
  <para style="q2" vid="PSA 95:11">ನಾನು ಅಸಂತೋಷದಿಂದ ಆಣೆ ಇಟ್ಟುಕೊಂಡೆನು.<verse eid="PSA 95:11"/></para>
  <chapter eid="PSA 95"/>
  <chapter number="96" style="c" sid="PSA 96"/>
  <para style="cl">ಕೀರ್ತನೆ 96</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 96:1"/>ಯೆಹೋವ ದೇವರಿಗೆ ಹೊಸಹಾಡನ್ನು ಹಾಡಿರಿ;</para>
  <para style="q2" vid="PSA 96:1">ಸಮಸ್ತ ಭೂನಿವಾಸಿಗಳೇ, ಯೆಹೋವ ದೇವರಿಗೆ ಹಾಡಿರಿ.<verse eid="PSA 96:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 96:2"/>ಯೆಹೋವ ದೇವರಿಗೆ ಹಾಡಿರಿ, ಅವರ ನಾಮವನ್ನು ಸ್ತುತಿಸಿರಿ;</para>
  <para style="q2" vid="PSA 96:2">ಅವರ ರಕ್ಷಣೆಯನ್ನು ದಿನಂಪ್ರತಿ ಸಾರಿ ಹೇಳಿರಿ.<verse eid="PSA 96:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 96:3"/>ಜನಾಂಗಗಳಲ್ಲಿ ಅವರ ಘನತೆಯನ್ನೂ,</para>
  <para style="q2" vid="PSA 96:3">ಎಲ್ಲಾ ಜನಾಂಗಗಳಲ್ಲಿ ಅವರ ಅದ್ಭುತಗಳನ್ನೂ ವಿವರಿಸಿರಿ.<verse eid="PSA 96:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 96:4"/>ಯೆಹೋವ ದೇವರು ಮಹೋನ್ನತರಾಗಿದ್ದಾರೆ, ಬಹು ಸ್ತುತಿಗೆ ಪಾತ್ರರೂ ಆಗಿದ್ದಾರೆ;</para>
  <para style="q2" vid="PSA 96:4">ಅವರು ಎಲ್ಲಾ ದೇವರುಗಳಿಗಿಂತ ಬಹುಭಯಭಕ್ತಿಗೆ ಪಾತ್ರರಾಗಿದ್ದಾರೆ.<verse eid="PSA 96:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 96:5"/>ಏಕೆಂದರೆ ಜನಾಂಗಗಳ ದೇವರುಗಳೆಲ್ಲಾ ವಿಗ್ರಹಗಳಾಗಿವೆ;</para>
  <para style="q2" vid="PSA 96:5">ಆದರೆ ಯೆಹೋವ ದೇವರು ಆಕಾಶಮಂಡಲವನ್ನು ನಿರ್ಮಿಸಿದವರು.<verse eid="PSA 96:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 96:6"/>ಘನತೆಯೂ, ಪ್ರಭೆಯೂ ಅವರ ಮುಂದೆ ಇವೆ;</para>
  <para style="q2" vid="PSA 96:6">ಬಲವೂ, ಸೌಂದರ್ಯವೂ ಅವರ ಪರಿಶುದ್ಧ ಸ್ಥಳದಲ್ಲಿ ಇವೆ.<verse eid="PSA 96:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 96:7"/>ಜನಾಂಗದ ಕುಟುಂಬಗಳೇ, ಯೆಹೋವ ದೇವರ ಮುಂದೆ ನೀವು ಮಹಿಮೆಯನ್ನೂ</para>
  <para style="q2" vid="PSA 96:7">ಬಲವನ್ನೂ ಅರ್ಪಿಸಿರಿ.<verse eid="PSA 96:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 96:8"/>ಯೆಹೋವ ದೇವರ ಹೆಸರಿಗೆ ಸಲ್ಲತಕ್ಕ ಗೌರವವನ್ನು ಸಲ್ಲಿಸಿರಿ;</para>
  <para style="q2" vid="PSA 96:8">ಕಾಣಿಕೆಯನ್ನು ತೆಗೆದುಕೊಂಡು ಅವರ ಅಂಗಳಗಳಿಗೆ ಬನ್ನಿರಿ.<verse eid="PSA 96:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 96:9"/>ಪರಿಶುದ್ಧತೆ ಎಂಬ ಭೂಷಣದೊಡನೆ ಯೆಹೋವ ದೇವರನ್ನು ಆರಾಧಿಸಿರಿ;</para>
  <para style="q2" vid="PSA 96:9">ಸಮಸ್ತ ಭೂನಿವಾಸಿಗಳೇ, ಅವರ ಮುಂದೆ ಭಯಪಡಿರಿ.<verse eid="PSA 96:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 96:10"/>“ಯೆಹೋವ ದೇವರು ಆಳಿಕೆ ಮಾಡುತ್ತಾರೆ;</para>
  <para style="q2" vid="PSA 96:10">ಆದ್ದರಿಂದ ಲೋಕವು ಸ್ಥಿರವಾಗಿರುವುದು, ಕದಲುವುದಿಲ್ಲ;</para>
  <para style="q2" vid="PSA 96:10">ಅವರು ಜನರಿಗೆ ನೀತಿಯಲ್ಲಿ ನ್ಯಾಯತೀರಿಸುತ್ತಾರೆ,” ಎಂದು ಎಲ್ಲಾ ಜನಾಂಗಗಳಲ್ಲಿ ಹೇಳಿರಿ.<verse eid="PSA 96:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 96:11"/>ಆಕಾಶವು ಸಂತೋಷಿಸಲಿ; ಭೂಮಿಯು ಉಲ್ಲಾಸಪಡಲಿ;</para>
  <para style="q2" vid="PSA 96:11">ಸಮುದ್ರವೂ, ಅದರಲ್ಲಿರುವುದೆಲ್ಲವೂ ಘೋಷಿಸಲಿ.<verse eid="PSA 96:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 96:12"/>ಹೊಲಗಳೂ, ಅವುಗಳಲ್ಲಿರುವ ಸಮಸ್ತವೂ ಉತ್ಸಾಹಪಡಲಿ;</para>
  <para style="q2" vid="PSA 96:12">ಆಗ ಅಡವಿಯ ಮರಗಳೆಲ್ಲಾ ಯೆಹೋವ ದೇವರ ಮುಂದೆಯೇ ಉತ್ಸಾಹಧ್ವನಿ ಮಾಡಲಿ.<verse eid="PSA 96:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 96:13"/>ಸಮಸ್ತ ಸೃಷ್ಟಿಯು ಯೆಹೋವ ದೇವರ ಸನ್ನಿಧಿಯಲ್ಲಿ ಹಾಡಲಿ,</para>
  <para style="q2" vid="PSA 96:13">ಏಕೆಂದರೆ ಅವರು ಲೋಕಕ್ಕೆ ನೀತಿಯಿಂದಲೂ;</para>
  <para style="q1" vid="PSA 96:13">ಜನರಿಗೆ ತಮ್ಮ ಸತ್ಯದಿಂದಲೂ</para>
  <para style="q2" vid="PSA 96:13">ನ್ಯಾಯತೀರಿಸಲು ಬರುತ್ತಾರೆ.<verse eid="PSA 96:13"/></para>
  <chapter eid="PSA 96"/>
  <chapter number="97" style="c" sid="PSA 97"/>
  <para style="cl">ಕೀರ್ತನೆ 97</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 97:1"/>ಯೆಹೋವ ದೇವರು ಆಳಿಕೆ ಮಾಡುತ್ತಾರೆ; ಭೂಮಿಯು ಉಲ್ಲಾಸಪಡಲಿ;</para>
  <para style="q2" vid="PSA 97:1">ದ್ವೀಪಗಳ ಸಮೂಹವು ಸಂತೋಷಪಡಲಿ.<verse eid="PSA 97:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 97:2"/>ಮೇಘಗಳೂ, ಕಾರ್ಗತ್ತಲೂ ಅವರ ಸುತ್ತಲು ಇವೆ;</para>
  <para style="q2" vid="PSA 97:2">ನೀತಿಯೂ, ನ್ಯಾಯವೂ ಅವರ ಸಿಂಹಾಸನದ ಅಸ್ತಿವಾರವಾಗಿದೆ.<verse eid="PSA 97:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 97:3"/>ಬೆಂಕಿಯು ಅವರ ಮುಂದೆ ಹೋಗಿ</para>
  <para style="q2" vid="PSA 97:3">ಅವರ ವೈರಿಗಳನ್ನು ಸುತ್ತಲೂ ದಹಿಸುವುದು.<verse eid="PSA 97:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 97:4"/>ಅವರ ಮಿಂಚುಗಳು ಲೋಕವನ್ನು ಬೆಳಗಿಸುತ್ತವೆ;</para>
  <para style="q2" vid="PSA 97:4">ಭೂಮಿಯು ಕಂಡು ನಡುಗುತ್ತದೆ.<verse eid="PSA 97:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 97:5"/>ಯೆಹೋವ ದೇವರ ಸನ್ನಿಧಿಯಲ್ಲಿ ಬೆಟ್ಟಗಳು ಕರಗುತ್ತವೆ,</para>
  <para style="q2" vid="PSA 97:5">ಸಮಸ್ತ ಭೂಮಿಯು ಮೇಣದ ಹಾಗೆ ಕರಗುತ್ತವೆ.<verse eid="PSA 97:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 97:6"/>ಆಕಾಶವು ಅವರ ನೀತಿಯನ್ನು ತಿಳಿಸುತ್ತದೆ;</para>
  <para style="q2" vid="PSA 97:6">ಎಲ್ಲಾ ಜನಗಳು ಅವರ ಮಹಿಮೆಯನ್ನು ಕಾಣುತ್ತಾರೆ.<verse eid="PSA 97:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 97:7"/>ವಿಗ್ರಹಗಳನ್ನು ಪೂಜಿಸಿ,</para>
  <para style="q2" vid="PSA 97:7">ವಿಗ್ರಹಗಳಲ್ಲಿ ಹೆಮ್ಮೆ ಪಡುವವರೆಲ್ಲರು ನಾಚಿಕೆಪಡಲಿ;</para>
  <para style="q2" vid="PSA 97:7">ಎಲ್ಲಾ ದೇವರುಗಳೇ, ಯೆಹೋವ ದೇವರನ್ನು ಆರಾಧಿಸಿರಿ!<verse eid="PSA 97:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 97:8"/>ಯೆಹೋವ ದೇವರೇ, ನಿಮ್ಮ ನ್ಯಾಯಗಳನ್ನು</para>
  <para style="q2" vid="PSA 97:8">ಚೀಯೋನ್ ಪಟ್ಟಣವು ಕೇಳಿ ಸಂತೋಷಿಸಿತು;</para>
  <para style="q2" vid="PSA 97:8">ಯೆಹೂದದ ಪುತ್ರಿಯರು<note caller="+" style="f"><char style="fr" closed="false">97:8 </char><char style="fq" closed="false">ಯೆಹೂದದ ಪುತ್ರಿಯರು </char><char style="ft" closed="false">ಅಂದರೆ, </char><char style="fqa" closed="false">ಚೀಯೋನಿನ ಸುತ್ತಲಿನ ಹಳ್ಳಿಗಳು</char></note> ಸಹ ಉಲ್ಲಾಸಿಸುತ್ತಾರೆ.<verse eid="PSA 97:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 97:9"/>ಏಕೆಂದರೆ ಯೆಹೋವ ದೇವರೇ, ನೀವು ಸಮಸ್ತ ಭೂಮಿಯ ಮೇಲೆ ಮಹೋನ್ನತರಾಗಿದ್ದೀರಿ;</para>
  <para style="q2" vid="PSA 97:9">ಎಲ್ಲಾ ದೇವರುಗಳ ಮೇಲೆ ನೀವು ಅತ್ಯಂತ ಮಹೋನ್ನತರಾಗಿದ್ದೀರಿ.<verse eid="PSA 97:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 97:10"/>ಯೆಹೋವ ದೇವರನ್ನು ಪ್ರೀತಿಸುವವರು ಕೆಟ್ಟದ್ದನ್ನು ಹಗೆ ಮಾಡುವರು;</para>
  <para style="q2" vid="PSA 97:10">ದೇವರು ತಮ್ಮ ಭಕ್ತರ ಪ್ರಾಣಗಳನ್ನು ಕಾಪಾಡಿ,</para>
  <para style="q2" vid="PSA 97:10">ದುಷ್ಟರ ಕೈಯೊಳಗಿಂದ ಅವರನ್ನು ಬಿಡಿಸುವರು.<verse eid="PSA 97:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 97:11"/>ನೀತಿವಂತನಿಗೋಸ್ಕರ ಬೆಳಕೂ,</para>
  <para style="q2" vid="PSA 97:11">ಯಥಾರ್ಥ ಹೃದಯದವರಿಗೋಸ್ಕರ ಅವರ ಹೃದಯದಲ್ಲಿ ಆನಂದವೂ ಇರುವುದು.<verse eid="PSA 97:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 97:12"/>ನೀತಿವಂತರೇ, ಯೆಹೋವ ದೇವರಲ್ಲಿ ಸಂತೋಷಿಸಿರಿ;</para>
  <para style="q2" vid="PSA 97:12">ದೇವರ ಪರಿಶುದ್ಧ ನಾಮವನ್ನು ಕೊಂಡಾಡಿರಿ.<verse eid="PSA 97:12"/></para>
  <chapter eid="PSA 97"/>
  <chapter number="98" style="c" sid="PSA 98"/>
  <para style="cl">ಕೀರ್ತನೆ 98</para>
  <para style="d">ಒಂದು ಕೀರ್ತನೆ.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 98:1"/>ಯೆಹೋವ ದೇವರಿಗೆ ಹೊಸಹಾಡನ್ನು ಹಾಡಿರಿ;</para>
  <para style="q2" vid="PSA 98:1">ಏಕೆಂದರೆ ಅವರು ಅದ್ಭುತಗಳನ್ನು ಮಾಡಿದ್ದಾರೆ;</para>
  <para style="q1" vid="PSA 98:1">ಅವರ ಬಲಗೈಯೂ, ಅವರ ಪರಿಶುದ್ಧ ಭುಜವು</para>
  <para style="q2" vid="PSA 98:1">ಅವರಿಗೆ ಜಯವನ್ನು ತಂದಿವೆ.<verse eid="PSA 98:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 98:2"/>ಯೆಹೋವ ದೇವರು ತಮ್ಮ ರಕ್ಷಣೆಯನ್ನು ತಿಳಿಯಪಡಿಸಿದ್ದಾರೆ;</para>
  <para style="q2" vid="PSA 98:2">ರಾಷ್ಟ್ರಗಳಿಗೆ ತಮ್ಮ ನೀತಿಯನ್ನು ಪ್ರಕಟಪಡಿಸಿದ್ದಾರೆ.<verse eid="PSA 98:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 98:3"/>ಇಸ್ರಾಯೇಲರ ಕಡೆಗೆ ತಮ್ಮ ಪ್ರೀತಿಯನ್ನೂ, ತಮ್ಮ ಸತ್ಯತೆಯನ್ನೂ</para>
  <para style="q2" vid="PSA 98:3">ಜ್ಞಾಪಕ ಮಾಡಿಕೊಂಡಿದ್ದಾರೆ;</para>
  <para style="q1" vid="PSA 98:3">ಭೂಮಿಯ ಅಂತ್ಯಗಳಲ್ಲೆವೂ</para>
  <para style="q2" vid="PSA 98:3">ನಮ್ಮ ದೇವರ ರಕ್ಷಣೆಯನ್ನು ನೋಡಿವೆ.<verse eid="PSA 98:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 98:4"/>ಸಮಸ್ತ ಭೂನಿವಾಸಿಗಳೇ, ಯೆಹೋವ ದೇವರಿಗೆ ಆನಂದಘೋಷ ಮಾಡಿರಿ.</para>
  <para style="q2" vid="PSA 98:4">ಉತ್ಸಾಹಧ್ವನಿ ಮಾಡಿ ಸಂಗೀತದಿಂದ ಸ್ತುತಿಹಾಡಿರಿ.<verse eid="PSA 98:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 98:5"/>ಯೆಹೋವ ದೇವರಿಗೆ ಕಿನ್ನರಿಯಿಂದ ಗಾನಮಾಡಿರಿ.</para>
  <para style="q2" vid="PSA 98:5">ಕಿನ್ನರಿಯಿಂದಲೂ, ಕೀರ್ತನೆಯ ಶಬ್ದದಿಂದಲೂ ಹಾಡಿರಿ.<verse eid="PSA 98:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 98:6"/>ತುತೂರಿಗಳಿಂದಲೂ, ಹೌದು, ಟಗರಿನ ಕೊಂಬಿನಿಂದಲೂ</para>
  <para style="q2" vid="PSA 98:6">ಯೆಹೋವ ರಾಜರ ಮುಂದೆ ಆನಂದಘೋಷ ಮಾಡಿರಿ.<verse eid="PSA 98:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 98:7"/>ಸಮುದ್ರವೂ, ಅದರಲ್ಲಿರುವುದೆಲ್ಲವೂ, ಲೋಕವೂ,</para>
  <para style="q2" vid="PSA 98:7">ಅದರ ನಿವಾಸಿಗಳೂ ಪ್ರತಿಧ್ವನಿಸಲಿ.<verse eid="PSA 98:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 98:8"/>ನದಿಗಳು ಚಪ್ಪಾಳೆ ತಟ್ಟಲಿ.</para>
  <para style="q2" vid="PSA 98:8">ಬೆಟ್ಟಗಳು ಒಟ್ಟುಗೂಡಿ ಆನಂದ ಕೀರ್ತನೆ ಹಾಡಲಿ.<verse eid="PSA 98:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 98:9"/>ಅವು ಯೆಹೋವ ದೇವರ ಮುಂದೆ ಹಾಡಲಿ, ಏಕೆಂದರೆ ಅವರು ಭೂಮಿಗೆ</para>
  <para style="q2" vid="PSA 98:9">ನ್ಯಾಯತೀರಿಸಲು ಬರುತ್ತಾರೆ.</para>
  <para style="q1" vid="PSA 98:9">ಅವರು ಲೋಕಕ್ಕೆ ನೀತಿಗನುಸಾರವಾಗಿಯೂ</para>
  <para style="q2" vid="PSA 98:9">ಜನರಿಗೆ ನ್ಯಾಯಾನುಸಾರವಾಗಿಯೂ ತೀರ್ಪು ನೀಡುವರು.<verse eid="PSA 98:9"/></para>
  <chapter eid="PSA 98"/>
  <chapter number="99" style="c" sid="PSA 99"/>
  <para style="cl">ಕೀರ್ತನೆ 99</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 99:1"/>ಯೆಹೋವ ದೇವರು ಆಳಿಕೆ ಮಾಡುತ್ತಾರೆ.</para>
  <para style="q2" vid="PSA 99:1">ರಾಷ್ಟ್ರಗಳು ನಡುಗಲಿ.</para>
  <para style="q1" vid="PSA 99:1">ಅವರು ಕೆರೂಬಿಗಳ ಮಧ್ಯದಲ್ಲಿ ಕೂತಿದ್ದಾರೆ.</para>
  <para style="q2" vid="PSA 99:1">ಭೂಮಿಯು ಕದಲಲಿ.<verse eid="PSA 99:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 99:2"/>ಯೆಹೋವ ದೇವರು ಚೀಯೋನಿನಲ್ಲಿ ಮಹೋನ್ನತರಾಗಿದ್ದಾರೆ.</para>
  <para style="q2" vid="PSA 99:2">ಎಲ್ಲಾ ಜನಗಳ ಮೇಲೆ ಉನ್ನತರಾಗಿದ್ದಾರೆ.<verse eid="PSA 99:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 99:3"/>ನಿಮ್ಮ ಅತಿಶಯವಾದ ಹೆಸರನ್ನು ಜನರು ಕೊಂಡಾಡಲಿ.</para>
  <para style="q2" vid="PSA 99:3">ದೇವರು ಪರಿಶುದ್ಧರು.<verse eid="PSA 99:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 99:4"/>ನ್ಯಾಯ ಪ್ರಿಯ ರಾಜರೇ,</para>
  <para style="q2" vid="PSA 99:4">ನೀವು ನೀತಿಯನ್ನು ಸ್ಥಿರಪಡಿಸುತ್ತೀರಿ.</para>
  <para style="q1" vid="PSA 99:4">ನ್ಯಾಯವನ್ನೂ ನೀತಿಯನ್ನೂ</para>
  <para style="q2" vid="PSA 99:4">ಯಾಕೋಬ್ಯರಲ್ಲಿ ನೀವು ಮನದಟ್ಟಾಗಿಸಿರುವಿರಿ.<verse eid="PSA 99:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 99:5"/>ನಮ್ಮ ದೇವರಾದ ಯೆಹೋವ ದೇವರನ್ನು ಮಹಿಮೆಪಡಿಸಿರಿ.</para>
  <para style="q2" vid="PSA 99:5">ಅವರ ಪಾದಪೀಠದಲ್ಲಿ ಆರಾಧಿಸಿರಿ.</para>
  <para style="q2" vid="PSA 99:5">ಏಕೆಂದರೆ ಅವರು ಪರಿಶುದ್ಧರಾಗಿದ್ದಾರೆ.<verse eid="PSA 99:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 99:6"/>ಯೆಹೋವ ದೇವರ ಯಾಜಕರಲ್ಲಿ ಮೋಶೆಯೂ ಆರೋನನೂ ಇದ್ದಾರೆ.</para>
  <para style="q2" vid="PSA 99:6">ದೇವರ ಹೆಸರೆತ್ತಿ ಕರೆದವರಲ್ಲಿ ಸಮುಯೇಲನೂ ಸಹ ಒಬ್ಬನು.</para>
  <para style="q1" vid="PSA 99:6">ಇವರೆಲ್ಲರೂ ಯೆಹೋವ ದೇವರನ್ನು ಕರೆದರು.</para>
  <para style="q2" vid="PSA 99:6">ದೇವರು ಅವರಿಗೆ ಉತ್ತರಕೊಟ್ಟರು.<verse eid="PSA 99:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 99:7"/>ಮೇಘಸ್ತಂಭದಿಂದ ಅವರ ಸಂಗಡ ಮಾತನಾಡಿದರು.</para>
  <para style="q2" vid="PSA 99:7">ದೇವರು ಅವರಿಗೆ ಕೊಟ್ಟ ಶಾಸನಗಳನ್ನೂ ತೀರ್ಪುಗಳನ್ನೂ ಅವರು ಕೈಗೊಂಡರು.<verse eid="PSA 99:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 99:8"/>ನಮ್ಮ ದೇವರಾದ ಯೆಹೋವ ದೇವರೇ,</para>
  <para style="q2" vid="PSA 99:8">ನೀವು ಅವರಿಗೆ ಉತ್ತರಕೊಟ್ಟಿದ್ದೀರಿ.</para>
  <para style="q1" vid="PSA 99:8">ನೀವು ದುಷ್ಕೃತ್ಯಗಳಿಗಾಗಿ ಇಸ್ರಾಯೇಲರನ್ನು ದಂಡಿಸಿದರೂ</para>
  <para style="q2" vid="PSA 99:8">ಅವರನ್ನು ಕ್ಷಮಿಸುವ ದೇವರಾಗಿದ್ದೀರಿ.<verse eid="PSA 99:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 99:9"/>ನಮ್ಮ ದೇವರಾದ ಯೆಹೋವ ದೇವರನ್ನು ಮಹಿಮೆಪಡಿಸಿರಿ.</para>
  <para style="q2" vid="PSA 99:9">ದೇವರ ಪರಿಶುದ್ಧ ಪರ್ವತದಲ್ಲಿ ಆರಾಧಿಸಿರಿ.</para>
  <para style="q2" vid="PSA 99:9">ನಮ್ಮ ದೇವರಾದ ಯೆಹೋವ ದೇವರು ಪರಿಶುದ್ಧರು.<verse eid="PSA 99:9"/></para>
  <chapter eid="PSA 99"/>
  <chapter number="100" style="c" sid="PSA 100"/>
  <para style="cl">ಕೀರ್ತನೆ 100</para>
  <para style="d">ಕೀರ್ತನೆ. ಕೃತಜ್ಞತೆಯ ಗೀತೆ.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 100:1"/>ಸಮಸ್ತ ಭೂಮಿಯೇ, ಯೆಹೋವ ದೇವರಿಗೆ ಜಯಧ್ವನಿ ಮಾಡಿರಿ.<verse eid="PSA 100:1"/></para>
  <para style="q2">
    <verse number="2" style="v" sid="PSA 100:2"/>ಸಂತೋಷದಿಂದ ಯೆಹೋವ ದೇವರನ್ನು ಆರಾಧಿಸಿರಿ;</para>
  <para style="q2" vid="PSA 100:2">ಆನಂದದಿಂದ ಹಾಡುತ್ತಾ ಅವರ ಮುಂದೆ ಬನ್ನಿರಿ.<verse eid="PSA 100:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 100:3"/>ಯೆಹೋವ ದೇವರೇ ದೇವರೆಂದು ತಿಳುಕೊಳ್ಳಿರಿ;</para>
  <para style="q2" vid="PSA 100:3">ಅವರೇ ನಮ್ಮನ್ನು ಉಂಟುಮಾಡಿದ್ದಾರೆ;</para>
  <para style="q2" vid="PSA 100:3">ನಾವು ಅವರ ಜನರೂ, ಅವರು ಮೇಯಿಸುವ ಕುರಿ ಮಂದೆಯೂ ಆಗಿದ್ದೇವೆ.<verse eid="PSA 100:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 100:4"/>ಕೃತಜ್ಞತೆಯಿಂದ ಅವರ ಬಾಗಿಲುಗಳಿಗೂ,</para>
  <para style="q2" vid="PSA 100:4">ಕೃತಜ್ಞತಾ ಸ್ತೋತ್ರದಿಂದ ಅವರ ಅಂಗಳಗಳಿಗೂ ಬನ್ನಿರಿ;</para>
  <para style="q2" vid="PSA 100:4">ಅವರನ್ನು ಕೊಂಡಾಡಿರಿ, ಅವರ ಹೆಸರನ್ನು ಸ್ತುತಿಸಿರಿ.<verse eid="PSA 100:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 100:5"/>ಯೆಹೋವ ದೇವರು ಒಳ್ಳೆಯವರು, ಅವರ ಕರುಣೆಯು ಯುಗಯುಗಕ್ಕೂ ಇರುವುದು.</para>
  <para style="q2" vid="PSA 100:5">ಅವರ ಸತ್ಯತೆಯು ತಲತಲಾಂತರಕ್ಕೂ ಮುಂದುವರಿಯುವುದು.<verse eid="PSA 100:5"/></para>
  <chapter eid="PSA 100"/>
  <chapter number="101" style="c" sid="PSA 101"/>
  <para style="cl">ಕೀರ್ತನೆ 101</para>
  <para style="d">ದಾವೀದನ ಕೀರ್ತನೆ.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 101:1"/>ನಿಮ್ಮ ಪ್ರೀತಿ ನೀತಿಗಳನ್ನು ಕುರಿತು ಹಾಡುವೆನು;</para>
  <para style="q2" vid="PSA 101:1">ಯೆಹೋವ ದೇವರೇ, ನಿಮ್ಮನ್ನು ಸ್ತುತಿಸುವೆನು.<verse eid="PSA 101:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 101:2"/>ದೋಷರಹಿತ ಮಾರ್ಗದಲ್ಲಿ ನಡೆಯಲು ಜಾಗರೂಕನಾಗಿರುವೆನು;</para>
  <para style="q2" vid="PSA 101:2">ನೀವು ಯಾವಾಗ ನನ್ನ ಬಳಿಗೆ ಬರುವಿರಿ?</para>
  <para style="b" vid="PSA 101:2"/>
  <para style="q1" vid="PSA 101:2">ನಾನು ನಿರ್ದೋಷ ಹೃದಯದಿಂದ</para>
  <para style="q2" vid="PSA 101:2">ನನ್ನ ಮನೆಯೊಳಗೆ ನಡೆದುಕೊಳ್ಳುವೆನು.<verse eid="PSA 101:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 101:3"/>ನಾನು ಕೆಟ್ಟ ಕಾರ್ಯವನ್ನು</para>
  <para style="q2" vid="PSA 101:3">ನನ್ನ ಕಣ್ಣುಗಳ ಮುಂದೆ ಒಪ್ಪಿಗೆಯಿಂದ ನೋಡುವುದಿಲ್ಲ.</para>
  <para style="b" vid="PSA 101:3"/>
  <para style="q1" vid="PSA 101:3">ಅವಿಶ್ವಾಸಿಗಳು ಮಾಡುವುದನ್ನು ದ್ವೇಷಿಸುವೆನು;</para>
  <para style="q2" vid="PSA 101:3">ಅದರಲ್ಲಿ ನಾನು ಭಾಗವಹಿಸುವುದಿಲ್ಲ.<verse eid="PSA 101:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 101:4"/>ಮೂರ್ಖಜನರು ನನ್ನಿಂದ ದೂರವಿರುವರು;</para>
  <para style="q2" vid="PSA 101:4">ದುಷ್ಟತನವನ್ನು ಅರಿಯದಿರುವೆನು.<verse eid="PSA 101:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 101:5"/>ಮರೆಯಾಗಿ ನೆರೆಯವನ ಮೇಲೆ</para>
  <para style="q2" vid="PSA 101:5">ಚಾಡಿ ಹೇಳುವವನನ್ನು ಸುಮ್ಮನಿರಿಸುವೆನು;</para>
  <para style="q1" vid="PSA 101:5">ಗರ್ವದ ಕಣ್ಣೂ, ಅಹಂಕಾರದ ಹೃದಯವೂ</para>
  <para style="q2" vid="PSA 101:5">ಉಳ್ಳವನನ್ನು ಸಹಿಸಲಾರೆನು.<verse eid="PSA 101:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 101:6"/>ದೇಶದಲ್ಲಿರುವ ನಂಬಿಗಸ್ತರನ್ನು ಆರಿಸಿಕೊಳ್ಳುವೆನು;</para>
  <para style="q2" vid="PSA 101:6">ಅವರೇ ನನ್ನ ಸನ್ನಿಧಿಯಲ್ಲಿ ವಾಸಿಸಬೇಕು;</para>
  <para style="q1" vid="PSA 101:6">ನಿಷ್ಕಳಂಕವಾಗಿ ನಡೆಯುವವರೇ</para>
  <para style="q2" vid="PSA 101:6">ನನ್ನ ಸೇವೆಯಲ್ಲಿರಬೇಕು.<verse eid="PSA 101:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 101:7"/>ಮೋಸ ಮಾಡುವವನು ನನ್ನ ಮನೆಯೊಳಗೆ ವಾಸಮಾಡನು;</para>
  <para style="q2" vid="PSA 101:7">ಸುಳ್ಳಾಡುವವನು ನನ್ನ ಕಣ್ಣುಗಳ ಮುಂದೆ ನಿಂತುಕೊಳ್ಳನು.<verse eid="PSA 101:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 101:8"/>ದುಷ್ಟತನ ಮಾಡುವವರೆಲ್ಲರನ್ನು</para>
  <para style="q2" vid="PSA 101:8">ಪ್ರತಿ ಮುಂಜಾನೆ ನಿಲ್ಲಿಸಿಬಿಡುವೆನು;</para>
  <para style="q1" vid="PSA 101:8">ಯೆಹೋವ ದೇವರ ಪಟ್ಟಣದೊಳಗಿಂದ</para>
  <para style="q2" vid="PSA 101:8">ಪ್ರತಿಯೊಬ್ಬ ದುಷ್ಟನನ್ನು ಹೊರಗೆ ಹಾಕುವೆನು.<verse eid="PSA 101:8"/></para>
  <chapter eid="PSA 101"/>
  <chapter number="102" style="c" sid="PSA 102"/>
  <para style="cl">ಕೀರ್ತನೆ 102</para>
  <para style="d">ದುಃಖಿತನಾಗಿ ಯೆಹೋವ ದೇವರ ಮುಂದೆ ತನ್ನ ಚಿಂತೆಗಳನ್ನು ಹೇಳಿಕೊಳ್ಳುವ ಬಾಧಿತನ ಪ್ರಾರ್ಥನೆ.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 102:1"/>ಯೆಹೋವ ದೇವರೇ, ನನ್ನ ಪ್ರಾರ್ಥನೆಯನ್ನು ಕೇಳಿರಿ;</para>
  <para style="q2" vid="PSA 102:1">ನನ್ನ ಮೊರೆಯು ನಿಮಗೆ ಮುಟ್ಟಲಿ.<verse eid="PSA 102:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 102:2"/>ನನಗೆ ಇಕ್ಕಟ್ಟು ಇರುವ ದಿವಸದಲ್ಲಿ</para>
  <para style="q2" vid="PSA 102:2">ನಿಮ್ಮ ಮುಖವನ್ನು ನನಗೆ ಮರೆಮಾಡಬೇಡಿರಿ, ಸಹಾಯಮಾಡಿರಿ;</para>
  <para style="q1" vid="PSA 102:2">ನಾನು ಕರೆಯುವಾಗ ನನ್ನ ಕಡೆಗೆ ತಿರುಗಿರಿ,</para>
  <para style="q2" vid="PSA 102:2">ಬೇಗನೇ ನನಗೆ ಉತ್ತರಕೊಡಿರಿ.<verse eid="PSA 102:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 102:3"/>ನನ್ನ ದಿವಸಗಳು ಹೊಗೆಯಂತೆ ಕಳೆದುಹೋಗುತ್ತವೆ;</para>
  <para style="q2" vid="PSA 102:3">ನನ್ನ ಎಲುಬುಗಳು ಬೂದಿ ಮುಚ್ಚಿದ ಕೆಂಡದಂತೆ ಸುಟ್ಟುಹೋಗಿವೆ.<verse eid="PSA 102:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 102:4"/>ನನ್ನ ಹೃದಯವು ಬಾಡಿಹೋಗಿ ಹುಲ್ಲಿನ ಹಾಗೆ ಒಣಗಿಹೋಗಿದೆ;</para>
  <para style="q2" vid="PSA 102:4">ನಾನು ಊಟಮಾಡುವುದಕ್ಕೆ ಸಹ ಮರೆತುಬಿಡುತ್ತೇನೆ.<verse eid="PSA 102:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 102:5"/>ನಾನು ನನ್ನ ನಿಟ್ಟುಸಿರಿನಿಂದ ಮೊರೆಯಿಡುತ್ತಿದ್ದೇನೆ.</para>
  <para style="q2" vid="PSA 102:5">ನನ್ನಲ್ಲಿ ಎಲುಬು ತೊಗಲು ಮಾತ್ರ ಉಳಿದಿರುತ್ತವೆ.<verse eid="PSA 102:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 102:6"/>ನಾನು ಅರಣ್ಯದ ಗೂಬೆಗೆ ಸಮಾನನಾಗಿದ್ದೇನೆ;</para>
  <para style="q2" vid="PSA 102:6">ನಾನು ಹಾಳೂರಿನ ಗೂಬೆಯ ಹಾಗಿದ್ದೇನೆ.<verse eid="PSA 102:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 102:7"/>ನಿದ್ರೆಯಿಲ್ಲದೆ ಬಳಲುತ್ತಿದ್ದೇನೆ;</para>
  <para style="q2" vid="PSA 102:7">ಮಾಳಿಗೆಯ ಮೇಲಿರುವ ಒಂಟಿಯಾದ ಪಕ್ಷಿಯ ಹಾಗಿದ್ದೇನೆ.<verse eid="PSA 102:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 102:8"/>ದಿನವೆಲ್ಲಾ ನನ್ನ ಶತ್ರುಗಳು ನನ್ನನ್ನು ನಿಂದಿಸುತ್ತಾರೆ;</para>
  <para style="q2" vid="PSA 102:8">ನನ್ನ ಮೇಲೆ ಕೋಪಿಸಿಕೊಳ್ಳುವವರೆಲ್ಲರು ನನಗೆ ವಿರೋಧವಾಗಿ ಶಪಿಸುತ್ತಾರೆ.<verse eid="PSA 102:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 102:9"/>ನಿಮ್ಮ ದುಃಖ ಬೇಸರದ ನಿಮಿತ್ತ, ಬೂದಿಯನ್ನು ರೊಟ್ಟಿಯಂತೆ ತಿಂದಿದ್ದೇನೆ;</para>
  <para style="q2" vid="PSA 102:9">ನನ್ನ ಪಾನವನ್ನು ಕಣ್ಣೀರಿನಿಂದ ಬೆರೆಸಿದ್ದೇನೆ.<verse eid="PSA 102:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 102:10"/>ಇದಕ್ಕೆ ಕಾರಣ ನೀವು ಗಮನ ಕೊಡದಿರುವುದೇ.</para>
  <para style="q2" vid="PSA 102:10">ನೀವು ನನಗೆ ಲಕ್ಷ್ಯಕೊಡುತ್ತಾಯಿಲ್ಲ.<verse eid="PSA 102:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 102:11"/>ನನ್ನ ದಿವಸಗಳು ಸಾಯಂಕಾಲದ ನೆರಳಿನ ಹಾಗಿವೆ;</para>
  <para style="q2" vid="PSA 102:11">ನಾನು ಹುಲ್ಲಿನ ಹಾಗೆ ಒಣಗುತಿದ್ದೇನೆ.<verse eid="PSA 102:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 102:12"/>ಆದರೆ ನೀವು ಯೆಹೋವ ದೇವರೇ, ಎಂದೆಂದಿಗೂ ಇರುತ್ತೀರಿ;</para>
  <para style="q2" vid="PSA 102:12">ನಿಮ್ಮ ಪ್ರಸಿದ್ಧ ಕಾರ್ಯಗಳು ತಲತಲಾಂತರಕ್ಕೂ ಇರುತ್ತವೆ.<verse eid="PSA 102:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 102:13"/>ನೀವು ಎದ್ದು ಚೀಯೋನನ್ನು ಕನಿಕರಿಸುವಿರಿ;</para>
  <para style="q2" vid="PSA 102:13">ಅದನ್ನು ಕರುಣಿಸುವ ಕಾಲ ಇದೇ;</para>
  <para style="q2" vid="PSA 102:13">ಹೌದು, ನೀವು ನಿರ್ಣಯಿಸಿದ ಸಮಯವು ಬಂದಿದೆ.<verse eid="PSA 102:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 102:14"/>ಅದು ಕಲ್ಲು ಕುಪ್ಪೆಯಾಗಿ ಹೋಗಿದ್ದರೂ, ನಿಮ್ಮ ಸೇವಕರಿಗೆ ಅತಿ ಪ್ರಿಯವಾಗಿದೆ;</para>
  <para style="q2" vid="PSA 102:14">ಅದರ ಧೂಳಿಗೆ ಅವರು ಮರಗುತ್ತಾರೆ.<verse eid="PSA 102:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 102:15"/>ಜನಾಂಗಗಳು ಯೆಹೋವ ದೇವರ ಹೆಸರಿಗೂ,</para>
  <para style="q2" vid="PSA 102:15">ಭೂರಾಜರೆಲ್ಲರೂ ನಿಮ್ಮ ಮಹಿಮೆಗೂ ಭಯಪಡುವರು.<verse eid="PSA 102:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 102:16"/>ಏಕೆಂದರೆ ಯೆಹೋವ ದೇವರು ಚೀಯೋನನ್ನು ಮರಳಿ ಕಟ್ಟುವರು;</para>
  <para style="q2" vid="PSA 102:16">ಅವರು ತಮ್ಮ ಮಹಿಮೆಯಲ್ಲಿ ಕಾಣಿಸಿಕೊಳ್ಳುವರು.<verse eid="PSA 102:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 102:17"/>ಅವರು ದಿಕ್ಕಿಲ್ಲದವರ ಪ್ರಾರ್ಥನೆಗೆ ಕಿವಿಗೊಡುತ್ತಾರೆ;</para>
  <para style="q2" vid="PSA 102:17">ದೇವರು ಅವರ ಪ್ರಾರ್ಥನೆಯನ್ನು ತಿರಸ್ಕರಿಸುವುದಿಲ್ಲ.<verse eid="PSA 102:17"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 102:18"/>ಇದು ಮುಂದಿನ ಸಂತತಿಗೋಸ್ಕರ ಲಿಖಿತವಾಗಿರಲಿ;</para>
  <para style="q2" vid="PSA 102:18">ಹುಟ್ಟಲಿಕ್ಕಿರುವ ಜನರು ಯೆಹೋವ ದೇವರನ್ನು ಸ್ತುತಿಸಲಿ.<verse eid="PSA 102:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 102:19"/>ಯೆಹೋವ ದೇವರು ಉನ್ನತವಾದ ಪವಿತ್ರ ಸ್ಥಾನದಿಂದ ಕೆಳಕ್ಕೆ ನೋಡಿದ್ದಾರೆ;</para>
  <para style="q2" vid="PSA 102:19">ಅವರು ಪರಲೋಕದಿಂದ ಭೂಮಿಯನ್ನು ದೃಷ್ಟಿಸಿದ್ದಾರೆ.<verse eid="PSA 102:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 102:20"/>ಅವರು ಸೆರೆಯವರ ಗೋಳಾಟವನ್ನು ಕೇಳಿ,</para>
  <para style="q2" vid="PSA 102:20">ಮರಣದಂಡನೆಗೆ ಪಾತ್ರನಾದವರನ್ನು ಬಿಡಿಸುವರು,<verse eid="PSA 102:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 102:21"/>ಬಿಡುಗಡೆಯಾದವರು ಚೀಯೋನಿನಲ್ಲಿ ಯೆಹೋವ ದೇವರ ನಾಮವನ್ನು ಸಾರುವಂತೆಯೂ,</para>
  <para style="q2" vid="PSA 102:21">ಯೆರೂಸಲೇಮಿನಲ್ಲಿ ತಮ್ಮ ಸ್ತೋತ್ರವನ್ನು ಪ್ರಕಟಿಸುವಂತೆಯೂ ಮಾಡಿದ್ದಾರೆ.<verse eid="PSA 102:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 102:22"/>ಜನಾಂಗಗಳೂ, ರಾಜ್ಯಗಳೂ ಕೂಡಿಬಂದು</para>
  <para style="q2" vid="PSA 102:22">ಇವರೊಡನೆ ಯೆಹೋವ ದೇವರನ್ನು ಸೇವಿಸುತ್ತವೆ, ಎಂದು ಹೇಳಲಾಗುವುದು.<verse eid="PSA 102:22"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 102:23"/>ದೇವರು ನನ್ನ ಜೀವಮಾನದ ಬಲವನ್ನು ಕುಂದಿಸಿದ್ದಾರೆ,</para>
  <para style="q2" vid="PSA 102:23">ನನ್ನ ದಿನಗಳನ್ನೂ ಕಡಿಮೆ ಮಾಡಿದ್ದಾರೆ.<verse eid="PSA 102:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 102:24"/>ಆದ್ದರಿಂದ ನಾನು, “ನನ್ನ ದೇವರೇ,</para>
  <para style="q1" vid="PSA 102:24">ನನ್ನ ಆಯುಷ್ಯದ ಮಧ್ಯದಲ್ಲಿ ನನ್ನನ್ನು ತೆಗೆದುಕೊಳ್ಳಬೇಡಿರಿ;</para>
  <para style="q2" vid="PSA 102:24">ನಿಮ್ಮ ವರ್ಷಗಳು ತಲತಲಾಂತರಗಳಿಗೂ ಇವೆ.<verse eid="PSA 102:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 102:25"/>ಆದಿಯಲ್ಲಿ ನೀವು ಭೂಮಿಗೆ ಅಸ್ತಿವಾರವನ್ನು ಹಾಕಿದ್ದೀರಿ;</para>
  <para style="q2" vid="PSA 102:25">ಆಕಾಶಗಳು ನಿಮ್ಮ ಕೈಕೆಲಸಗಳಾಗಿವೆ.<verse eid="PSA 102:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 102:26"/>ಅವು ನಾಶವಾಗುವುವು; ಆದರೆ ನೀವು ಸದಾಕಾಲವೂ ಜೀವಿಸುತ್ತೀರಿ.</para>
  <para style="q2" vid="PSA 102:26">ಅವುಗಳೆಲ್ಲಾ ವಸ್ತ್ರದ ಹಾಗೆ ಹಳೆಯದಾಗುವುದು;</para>
  <para style="q1" vid="PSA 102:26">ಅಂಗಿಯ ಹಾಗೆ ಅವುಗಳನ್ನು ಬದಲಾಯಿಸುವಿರಿ;</para>
  <para style="q2" vid="PSA 102:26">ಅವು ತೆಗೆದುಹಾಕಲಾಗುವುದು.<verse eid="PSA 102:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 102:27"/>ಆದರೆ ನೀವು ಏಕರೀತಿಯಾಗಿದ್ದೀರಿ.</para>
  <para style="q2" vid="PSA 102:27">ನಿಮ್ಮ ವರ್ಷಗಳು ಮುಗಿದುಹೋಗುವುದಿಲ್ಲ.<verse eid="PSA 102:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 102:28"/>ನಿಮ್ಮ ಸೇವಕರ ಮಕ್ಕಳು ನಿಮ್ಮ ಸನ್ನಿಧಿಯಲ್ಲಿ ಬದುಕುವರು;</para>
  <para style="q2" vid="PSA 102:28">ಅವರ ಸಂತತಿಯು ನಿಮ್ಮ ಮುಂದೆ ನೆಲೆಯಾಗಿರುವುದು.”<verse eid="PSA 102:28"/></para>
  <chapter eid="PSA 102"/>
  <chapter number="103" style="c" sid="PSA 103"/>
  <para style="cl">ಕೀರ್ತನೆ 103</para>
  <para style="d">ದಾವೀದನ ಕೀರ್ತನೆ.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 103:1"/>ನನ್ನ ಮನವೇ, ಯೆಹೋವ ದೇವರನ್ನು ಕೊಂಡಾಡು;</para>
  <para style="q2" vid="PSA 103:1">ನನ್ನ ಅಂತರಾತ್ಮವೇ ಅವರ ಪರಿಶುದ್ಧ ನಾಮವನ್ನು ಸ್ತುತಿಸು.<verse eid="PSA 103:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 103:2"/>ನನ್ನ ಮನವೇ, ಯೆಹೋವ ದೇವರನ್ನು ಕೊಂಡಾಡು;</para>
  <para style="q2" vid="PSA 103:2">ಅವರ ಉಪಕಾರಗಳಲ್ಲಿ ಒಂದನ್ನೂ ಮರೆತುಬಿಡಬೇಡ.<verse eid="PSA 103:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 103:3"/>ದೇವರು ನಿಮ್ಮ ಪಾಪಗಳನ್ನೆಲ್ಲಾ ಕ್ಷಮಿಸುತ್ತಾರೆ.</para>
  <para style="q2" vid="PSA 103:3">ನಿಮ್ಮ ರೋಗಗಳನ್ನೆಲ್ಲಾ ವಾಸಿಮಾಡುತ್ತಾರೆ.<verse eid="PSA 103:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 103:4"/>ದೇವರು ನಿಮ್ಮ ಜೀವವನ್ನು ಪಾತಾಳದಿಂದ ವಿಮೋಚಿಸುವರು;</para>
  <para style="q2" vid="PSA 103:4">ಪ್ರೀತಿ ಅನುಕಂಪವನ್ನು ನಿನಗೆ ಕಿರೀಟವಾಗಿ ಶೃಂಗರಿಸುವರು.<verse eid="PSA 103:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 103:5"/>ನಿಮ್ಮ ಯೌವನವು ಹದ್ದಿನ ಹಾಗೆ ನವೀಕರಿಸುವಂತೆ ಮಾಡುವರು.</para>
  <para style="q2" vid="PSA 103:5">ಅವರು ನಿಮ್ಮ ಆಶೆಗಳನ್ನು ಒಳ್ಳೆಯವುಗಳಿಂದ ತೃಪ್ತಿಪಡಿಸುವರು.<verse eid="PSA 103:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 103:6"/>ಯೆಹೋವ ದೇವರು ಕುಗ್ಗಿದವರೆಲ್ಲರಿಗೂ ನೀತಿಯನ್ನೂ,</para>
  <para style="q2" vid="PSA 103:6">ನ್ಯಾಯವನ್ನೂ ಕಾರ್ಯರೂಪಕ್ಕೆ ತರುವರು.<verse eid="PSA 103:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 103:7"/>ಅವರು ತಮ್ಮ ಮಾರ್ಗಗಳನ್ನು ಮೋಶೆಗೂ,</para>
  <para style="q2" vid="PSA 103:7">ತಮ್ಮ ಕ್ರಿಯೆಗಳನ್ನು ಇಸ್ರಾಯೇಲರಿಗೂ ಪ್ರಕಟಿಸಿದರು:<verse eid="PSA 103:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 103:8"/>ಯೆಹೋವ ದೇವರು, ಅನುಕಂಪವೂ ದಯೆಯೂ</para>
  <para style="q2" vid="PSA 103:8">ದೀರ್ಘಶಾಂತಿಯೂ ಪೂರ್ಣ ಪ್ರೀತಿಯೂ ಉಳ್ಳವರಾಗಿದ್ದಾರೆ.<verse eid="PSA 103:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 103:9"/>ಅವರು ಯಾವಾಗಲೂ ತಪ್ಪುಹುಡುಕುವವರಲ್ಲ;</para>
  <para style="q2" vid="PSA 103:9">ದೇವರು ತಮ್ಮ ಕೋಪವನ್ನು ಎಂದೆಂದಿಗೂ ಕೂಡಿಟ್ಟುಕೊಳ್ಳುವವರು ಅಲ್ಲ;<verse eid="PSA 103:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 103:10"/>ದೇವರು ನಮ್ಮ ಪಾಪಗಳಿಗೆ ಸರಿಯಾಗಿ ನಮ್ಮನ್ನು ಶಿಕ್ಷಿಸಲಿಲ್ಲ;</para>
  <para style="q2" vid="PSA 103:10">ನಮ್ಮ ಅಧರ್ಮಗಳ ಪ್ರಕಾರ ನಮಗೆ ಮುಯ್ಯಿತೀರಿಸಲಿಲ್ಲ.<verse eid="PSA 103:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 103:11"/>ಏಕೆಂದರೆ, ಭೂಮಿಯ ಮೇಲೆ ಆಕಾಶವು ಎಷ್ಟು ಉನ್ನತವೋ,</para>
  <para style="q2" vid="PSA 103:11">ದೇವರ ಪ್ರೀತಿಯು ತಮಗೆ ಭಯಪಡುವವರ ಮೇಲೆ ಅಷ್ಟು ಮಹೋನ್ನತವಾಗಿದೆ;<verse eid="PSA 103:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 103:12"/>ಪೂರ್ವಕ್ಕೂ ಪಶ್ಚಿಮಕ್ಕೂ ಎಷ್ಟು ದೂರವೋ,</para>
  <para style="q2" vid="PSA 103:12">ಅವರು ನಮ್ಮ ಅತಿಕ್ರಮಗಳನ್ನು ನಮ್ಮಿಂದ ಅಷ್ಟು ದೂರ ಮಾಡಿದ್ದಾರೆ.<verse eid="PSA 103:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 103:13"/>ಒಬ್ಬ ತಂದೆಯು ತಮ್ಮ ಮಕ್ಕಳ ಮೇಲೆ ಅನುಕಂಪಗೊಳ್ಳುವಂತೆ,</para>
  <para style="q2" vid="PSA 103:13">ಯೆಹೋವ ದೇವರು ತಮಗೆ ಭಯಪಡುವವರ ಮೇಲೆ ಅನುಕಂಪ ತೋರಿಸುವವರಾಗಿದ್ದಾರೆ.<verse eid="PSA 103:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 103:14"/>ದೇವರು ನಮ್ಮ ಪ್ರಕೃತಿಯನ್ನು ಬಲ್ಲವರಾಗಿದ್ದಾರೆ;</para>
  <para style="q2" vid="PSA 103:14">ನಾವು ಧೂಳಾಗಿದ್ದೇವೆಂದು ಅವರು ನೆನಪುಮಾಡಿ ಕೊಳ್ಳುತ್ತಾರೆ.<verse eid="PSA 103:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 103:15"/>ಮನುಷ್ಯನ ಆಯುಷ್ಕಾಲವು ಹುಲ್ಲಿನಂತಿದೆ,</para>
  <para style="q2" vid="PSA 103:15">ಅವನು ಹೊಲದ ಹೂವಿನ ಹಾಗೆಯೇ ಶೋಭಿಸುತ್ತಾನೆ;<verse eid="PSA 103:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 103:16"/>ಗಾಳಿಯು ಅದರ ಮೇಲೆ ಬೀಸುತ್ತಲೇ ಹೂವು ಇಲ್ಲದೆ ಹೋಗುತ್ತದೆ;</para>
  <para style="q2" vid="PSA 103:16">ಅದು ಇದ್ದ ಸ್ಥಳವನ್ನು ಪುನಃ ಕಾಣುವುದಿಲ್ಲ.<verse eid="PSA 103:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 103:17"/>ಆದರೆ ಯೆಹೋವ ದೇವರ ಪ್ರೀತಿಯು</para>
  <para style="q2" vid="PSA 103:17">ಅವರಿಗೆ ಭಯಪಡುವವರ ಮೇಲೆ ಯುಗಯುಗಾಂತರಕ್ಕೂ ಇರುವುದು,</para>
  <para style="q2" vid="PSA 103:17">ಅವರ ನೀತಿಯು ಮಕ್ಕಳ ಮಕ್ಕಳಿಗೂ ನೆಲೆಸಿರುವುದು.<verse eid="PSA 103:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 103:18"/>ದೇವರ ಒಡಂಬಡಿಕೆಯನ್ನು ಕೈಕೊಂಡು, ಅವರ ಸೂತ್ರಗಳನ್ನು ಪಾಲಿಸಲು</para>
  <para style="q2" vid="PSA 103:18">ನೆನಸುವವರಿಗೂ ಅವರ ನೀತಿಯು ನೆಲೆಸಿರುವುದು.<verse eid="PSA 103:18"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 103:19"/>ಯೆಹೋವ ದೇವರು ಪರಲೋಕದಲ್ಲಿ ತಮ್ಮ ಸಿಂಹಾಸನವನ್ನು ಸ್ಥಾಪಿಸಿದ್ದಾರೆ,</para>
  <para style="q2" vid="PSA 103:19">ಅವರ ಸಾಮ್ರಾಜ್ಯದ ಆಳಿಕೆಯು ಎಲ್ಲರ ಮೇಲೆ ಇರುವುದು.<verse eid="PSA 103:19"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 103:20"/>ದೇವರ ದೂತರೇ, ಅವರ ಮಾತನ್ನು ಕೇಳಿ,</para>
  <para style="q2" vid="PSA 103:20">ಅವರಿಗೆ ವಿಧೇಯರಾಗುವ ಪರಾಕ್ರಮಿಗಳೇ,</para>
  <para style="q2" vid="PSA 103:20">ಯೆಹೋವ ದೇವರನ್ನು ಸ್ತುತಿಸಿರಿ.<verse eid="PSA 103:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 103:21"/>ದೇವರ ಇಷ್ಟವನ್ನು ನಡೆಸುವ ಸೇವಕರೇ,</para>
  <para style="q2" vid="PSA 103:21">ಅವರ ಎಲ್ಲಾ ಸೈನ್ಯಗಳೇ, ಯೆಹೋವ ದೇವರನ್ನು ಸ್ತುತಿಸಿರಿ.<verse eid="PSA 103:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 103:22"/>ದೇವರ ಆಳಿಕೆಯ ಎಲ್ಲಾ ಕಡೆಗಳಲ್ಲಿಯೂ ಇರುವುದು.</para>
  <para style="q2" vid="PSA 103:22">ಅವರ ಎಲ್ಲಾ ಸೃಷ್ಟಿಗಳೇ, ಯೆಹೋವ ದೇವರನ್ನು ಸ್ತುತಿಸಿರಿ.</para>
  <para style="b" vid="PSA 103:22"/>
  <para style="q1" vid="PSA 103:22">ನನ್ನ ಮನವೇ, ಯೆಹೋವ ದೇವರನ್ನು ಕೊಂಡಾಡು.<verse eid="PSA 103:22"/></para>
  <chapter eid="PSA 103"/>
  <chapter number="104" style="c" sid="PSA 104"/>
  <para style="cl">ಕೀರ್ತನೆ 104</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 104:1"/>ನನ್ನ ಮನವೇ, ಯೆಹೋವ ದೇವರನ್ನು ಸ್ತುತಿಸು.</para>
  <para style="b" vid="PSA 104:1"/>
  <para style="q1" vid="PSA 104:1">ನನ್ನ ದೇವರಾದ ಯೆಹೋವ ದೇವರೇ, ನೀವು ಬಹಳ ದೊಡ್ಡವರಾಗಿದ್ದೀರಿ; ಘನತೆಯಿಂದಲೂ,</para>
  <para style="q2" vid="PSA 104:1">ಪ್ರಭಾವದಿಂದಲೂ ಭೂಷಿತನಾಗಿರುವೆ.<verse eid="PSA 104:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 104:2"/>ದೇವರು ವಸ್ತ್ರದ ಹಾಗೆ ಬೆಳಕನ್ನು ಧರಿಸಿಕೊಳ್ಳುತ್ತಾರೆ,</para>
  <para style="q2" vid="PSA 104:2">ಆಕಾಶವನ್ನು ಗುಡಾರದ ಹಾಗೆ ಹರಡಿಸಿದ್ದಾರೆ.<verse eid="PSA 104:2"/></para>
  <para style="q2">
    <verse number="3" style="v" sid="PSA 104:3"/>ದೇವರು ನೀರಿನ ಮೇಲೆ ತನ್ನ ಉಪ್ಪರಿಗೆಗಳ ತೊಲೆಗಳನ್ನು ಇರಿಸುತ್ತಾರೆ.</para>
  <para style="q1" vid="PSA 104:3">ಮೋಡಗಳನ್ನು ತಮ್ಮ ರಥವಾಗಿ ಮಾಡುತ್ತಾರೆ.</para>
  <para style="q2" vid="PSA 104:3">ಗಾಳಿಯ ರೆಕ್ಕೆಗಳ ಮೇಲೆ ಸವಾರಿ ಮಾಡುತ್ತಾರೆ.<verse eid="PSA 104:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 104:4"/>ಅವರು ಗಾಳಿಗಳನ್ನು ತಮ್ಮ ದೂತರಾಗಿ ಮಾಡಿದ್ದಾರೆ,</para>
  <para style="q2" vid="PSA 104:4">ಅಗ್ನಿ ಜ್ವಾಲೆಯನ್ನು ತಮ್ಮ ಸೇವಕರಾಗಿಯೂ ಮಾಡಿಕೊಂಡಿದ್ದಾರೆ.<verse eid="PSA 104:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 104:5"/>ಯುಗಯುಗಾಂತರಗಳಿಗೂ ಅದು ಕದಲದ ಹಾಗೆ,</para>
  <para style="q2" vid="PSA 104:5">ದೇವರು ಭೂಮಿಯನ್ನು ಅದರ ಅಸ್ತಿವಾರಗಳ ಮೇಲೆ ಸ್ಥಾಪಿಸಿದ್ದಾರೆ.<verse eid="PSA 104:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 104:6"/>ಜಲಗಾಧವು ವಸ್ತ್ರದ ಹಾಗೆ ಅದನ್ನು ಮುಚ್ಚಿದೆ;</para>
  <para style="q2" vid="PSA 104:6">ಬೆಟ್ಟಗಳ ಮೇಲೆ ಜಲರಾಶಿಗಳು ನಿಂತವು.<verse eid="PSA 104:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 104:7"/>ನಿಮ್ಮ ಗದರಿಕೆಯಿಂದ ಜಲರಾಶಿ ಓಡಿ ಹೋದವು;</para>
  <para style="q2" vid="PSA 104:7">ನಿಮ್ಮ ಗುಡುಗಿನ ಶಬ್ದದಿಂದ ಅವು ಓಡಿ ಹೋದವು.<verse eid="PSA 104:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 104:8"/>ಜಲರಾಶಿಗಳು ಬೆಟ್ಟಗಳಿಗೆ ಏರಿ,</para>
  <para style="q2" vid="PSA 104:8">ತಗ್ಗುಗಳಿಗೆ ಇಳಿದು,</para>
  <para style="q2" vid="PSA 104:8">ನೀವು ಅವುಗಳಿಗೆ ಸ್ಥಾಪಿಸಿದ ಸ್ಥಳಕ್ಕೆ ಹೋದವು.<verse eid="PSA 104:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 104:9"/>ಅವು ದಾಟದ ಹಾಗೆಯೂ,</para>
  <para style="q2" vid="PSA 104:9">ಭೂಮಿಯನ್ನು ಮುಚ್ಚುವುದಕ್ಕೆ ತಿರುಗಿ ಬಾರದ ಹಾಗೆಯೂ ನೀವು ಮೇರೆಯನ್ನು ಇಟ್ಟಿದ್ದೀರಿ.<verse eid="PSA 104:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 104:10"/>ಬುಗ್ಗೆಗಳನ್ನು ಹಳ್ಳಗಳಿಗೆ ಕಳುಹಿಸುತ್ತೀರಿ.</para>
  <para style="q2" vid="PSA 104:10">ಅವು ಬೆಟ್ಟಗಳ ನಡುವೆ ಹರಿಯುತ್ತವೆ.<verse eid="PSA 104:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 104:11"/>ಅವು ಕಾಡಿನ ಮೃಗಗಳಿಗೆಲ್ಲಾ ನೀರು ಕುಡಿಸುತ್ತವೆ;</para>
  <para style="q2" vid="PSA 104:11">ಕಾಡುಕತ್ತೆಗಳು ತಮ್ಮ ದಾಹವನ್ನು ತೀರಿಸಿಕೊಳ್ಳುತ್ತವೆ.<verse eid="PSA 104:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 104:12"/>ಆಕಾಶದ ಪಕ್ಷಿಗಳು, ಅವುಗಳ ಹತ್ತಿರ ವಾಸವಾಗಿದ್ದು,</para>
  <para style="q2" vid="PSA 104:12">ಕೊಂಬೆಗಳ ಮಧ್ಯದಲ್ಲಿಂದ ಹಾಡುತ್ತವೆ.<verse eid="PSA 104:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 104:13"/>ದೇವರು ಬೆಟ್ಟಗಳಿಗೆ ತಮ್ಮ ಉಪ್ಪರಿಗೆಗಳೊಳಗಿಂದ ನೀರು ಹಾಕುತ್ತಾರೆ.</para>
  <para style="q2" vid="PSA 104:13">ಅವರ ಕೆಲಸಗಳ ಫಲದಿಂದ ಭೂಮಿಯು ತೃಪ್ತಿಯಾಗುತ್ತದೆ.<verse eid="PSA 104:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 104:14"/>ದೇವರು ಪಶುಗಳಿಗೋಸ್ಕರ ಹುಲ್ಲನ್ನೂ,</para>
  <para style="q2" vid="PSA 104:14">ಮನುಷ್ಯನ ವ್ಯವಸಾಯಕ್ಕೋಸ್ಕರ ಪಲ್ಯಗಳನ್ನೂ ಮೊಳೆಸುತ್ತಾರೆ.</para>
  <para style="q2" vid="PSA 104:14">ಹೀಗೆ ಭೂಮಿಯೊಳಗಿಂದ ಆಹಾರವನ್ನು ಬರಮಾಡುತ್ತಾರೆ.<verse eid="PSA 104:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 104:15"/>ದ್ರಾಕ್ಷಾರಸವು ಮನುಷ್ಯ ಹೃದಯವನ್ನು ಸಂತೋಷಪಡಿಸುತ್ತದೆ;</para>
  <para style="q2" vid="PSA 104:15">ಎಣ್ಣೆಯು ಮಾನವನ ಮುಖವನ್ನು ಪ್ರಕಾಶಿಸುವಂತೆ ಮಾಡುತ್ತದೆ;</para>
  <para style="q2" vid="PSA 104:15">ರೊಟ್ಟಿಯು ಮನುಷ್ಯನ ಪ್ರಾಣಕ್ಕೆ ಆಧಾರವಾಗುತ್ತದೆ.<verse eid="PSA 104:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 104:16"/>ಯೆಹೋವ ದೇವರು ನೆಟ್ಟ ಮರಗಳಾದ ಲೆಬನೋನಿನ</para>
  <para style="q2" vid="PSA 104:16">ದೇವದಾರು ವೃಕ್ಷಗಳಿಗೆ ಬೇಕಾದಷ್ಟು ಜಲವಿರುತ್ತದೆ.<verse eid="PSA 104:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 104:17"/>ಅಲ್ಲಿ ಹಕ್ಕಿಗಳು ಗೂಡು ಕಟ್ಟುತ್ತವೆ;</para>
  <para style="q2" vid="PSA 104:17">ತುರಾಯಿ ಗಿಡಗಳಲ್ಲಿ ಬಕಪಕ್ಷಿಗಳು ವಾಸಿಸುತ್ತವೆ.<verse eid="PSA 104:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 104:18"/>ಎತ್ತರವಾದ ಬೆಟ್ಟಗಳು ಕಾಡುಮೇಕೆಗಳಿಗೆ,</para>
  <para style="q2" vid="PSA 104:18">ಬೆಟ್ಟದ ಮೊಲಗಳಿಗೆ ಬಂಡೆಗಳು ಆಶ್ರಯವಾಗಿವೆ.<verse eid="PSA 104:18"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 104:19"/>ದೇವರೇ, ಕಾಲಗಳ ಸೂಚನೆಗಾಗಿ ಚಂದ್ರನನ್ನು ಸೃಷ್ಟಿಸಿದ್ದೀರಿ,</para>
  <para style="q2" vid="PSA 104:19">ಸೂರ್ಯನು ತನ್ನ ಅಸ್ತಮಾನವನ್ನು ತಿಳಿದಿದ್ದಾನೆ.<verse eid="PSA 104:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 104:20"/>ನೀವು ಕತ್ತಲನ್ನು ಬರಮಾಡುತ್ತೀರಿ, ಆಗ ರಾತ್ರಿಯಾಗುತ್ತದೆ;</para>
  <para style="q2" vid="PSA 104:20">ಅದರಲ್ಲಿ ಅಡವಿಯ ಮೃಗಗಳೆಲ್ಲಾ ಸಂಚರಿಸುತ್ತವೆ.<verse eid="PSA 104:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 104:21"/>ಸಿಂಹದ ಮರಿಗಳು ಬೇಟೆಗೋಸ್ಕರವೂ,</para>
  <para style="q2" vid="PSA 104:21">ದೇವರಿಂದ ತಮ್ಮ ಆಹಾರವನ್ನು ಹುಡುಕುವುದಕ್ಕೋಸ್ಕರವೂ ಗರ್ಜಿಸುತ್ತವೆ.<verse eid="PSA 104:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 104:22"/>ಸೂರ್ಯೋದಯವಾಗಲು ಅವು ಕೂಡಿಬಂದು</para>
  <para style="q2" vid="PSA 104:22">ತಮ್ಮ ಗವಿಗಳಲ್ಲಿ ಮಲಗಿಕೊಳ್ಳುತ್ತವೆ.<verse eid="PSA 104:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 104:23"/>ಮನುಷ್ಯನು ತನ್ನ ಕೆಲಸಕ್ಕೆ ಹೊರಟುಹೋಗಿ</para>
  <para style="q2" vid="PSA 104:23">ಸಾಯಂಕಾಲದವರೆಗೆ ದುಡಿಯುತ್ತಾನೆ.<verse eid="PSA 104:23"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 104:24"/>ಯೆಹೋವ ದೇವರೇ, ನಿಮ್ಮ ಕೆಲಸಗಳು ಎಷ್ಟೋ ಇವೆ!</para>
  <para style="q2" vid="PSA 104:24">ಅವುಗಳನ್ನೆಲ್ಲಾ ಜ್ಞಾನದಿಂದ ಉಂಟುಮಾಡಿದ್ದೀರಿ,</para>
  <para style="q2" vid="PSA 104:24">ಭೂಮಿಯು ನಿಮ್ಮ ಸಂಪತ್ತಿನಿಂದ ತುಂಬಿದೆ.<verse eid="PSA 104:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 104:25"/>ದೊಡ್ಡದೂ, ವಿಶಾಲವಾದದ್ದೂ ಆದ ಸಮುದ್ರವಿದೆ;</para>
  <para style="q2" vid="PSA 104:25">ಅದರಲ್ಲಿ ಲೆಕ್ಕವಿಲ್ಲದಷ್ಟು ಜೀವಜಂತುಗಳೂ,</para>
  <para style="q2" vid="PSA 104:25">ಸಣ್ಣ ದೊಡ್ಡ ಜಲಚರಗಳೂ ಇವೆ.<verse eid="PSA 104:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 104:26"/>ಅದರಲ್ಲಿ ಹಡಗುಗಳು ಹೋಗುತ್ತವೆ;</para>
  <para style="q2" vid="PSA 104:26">ಅದರಲ್ಲಿ ಆಡುವುದಕ್ಕೆ ನೀವು ರೂಪಿಸಿದ ಲಿವ್ಯಾತಾನ ತಿಮಿಂಗಲವು ಇದೆ.<verse eid="PSA 104:26"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 104:27"/>ದೇವರೇ, ನೀವು ಅವುಗಳ ಆಹಾರವನ್ನು ತಕ್ಕ ಕಾಲದಲ್ಲಿ ಕೊಡುವ ಹಾಗೆ,</para>
  <para style="q2" vid="PSA 104:27">ಅವುಗಳೆಲ್ಲಾ ನಿಮ್ಮನ್ನು ಕಾದುಕೊಂಡಿರುತ್ತವೆ.<verse eid="PSA 104:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 104:28"/>ನೀವು ಅವುಗಳಿಗೆ ಕೊಡಲು</para>
  <para style="q2" vid="PSA 104:28">ಅವು ಕೂಡಿ ಬರುತ್ತವೆ;</para>
  <para style="q1" vid="PSA 104:28">ನೀವು ನಿಮ್ಮ ಕೈ ತೆರೆಯಲು,</para>
  <para style="q2" vid="PSA 104:28">ಒಳ್ಳೆಯವುಗಳಿಂದ ತೃಪ್ತಿ ಹೊಂದುತ್ತವೆ.<verse eid="PSA 104:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="PSA 104:29"/>ನೀವು ನಿಮ್ಮ ಮುಖವನ್ನು ಮರೆಮಾಡಲು,</para>
  <para style="q2" vid="PSA 104:29">ಅವು ಹೆದರುತ್ತವೆ.</para>
  <para style="q1" vid="PSA 104:29">ನೀವು ಅವುಗಳ ಶ್ವಾಸವನ್ನು ತೆಗೆದುಬಿಡಲು,</para>
  <para style="q2" vid="PSA 104:29">ಸತ್ತು ಹೋಗಿ, ಮಣ್ಣುಪಾಲಾಗುತ್ತವೆ.<verse eid="PSA 104:29"/></para>
  <para style="q1">
    <verse number="30" style="v" sid="PSA 104:30"/>ನೀವು ನಿಮ್ಮ ಶ್ವಾಸವನ್ನು ಕಳುಹಿಸಲು,</para>
  <para style="q2" vid="PSA 104:30">ಜೀವಜಂತುಗಳು ಹುಟ್ಟುತ್ತವೆ;</para>
  <para style="q2" vid="PSA 104:30">ಹೀಗೆ ನೀವು ಭೂಮಿಯನ್ನು ನೂತನಗೊಳಿಸುತ್ತೀರಿ.<verse eid="PSA 104:30"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="31" style="v" sid="PSA 104:31"/>ಯೆಹೋವ ದೇವರ ಮಹಿಮೆಯು ಯುಗಯುಗಕ್ಕೂ ಇರಲಿ;</para>
  <para style="q2" vid="PSA 104:31">ಯೆಹೋವ ದೇವರು ತಮ್ಮ ಕೆಲಸಗಳಲ್ಲಿ ಸಂತೋಷಪಡಲಿ.<verse eid="PSA 104:31"/></para>
  <para style="q1">
    <verse number="32" style="v" sid="PSA 104:32"/>ಅವರು ಭೂಮಿಯನ್ನು ದೃಷ್ಟಿಸಲು, ಅದು ನಡುಗುತ್ತದೆ;</para>
  <para style="q2" vid="PSA 104:32">ಬೆಟ್ಟಗಳನ್ನು ಮುಟ್ಟಲು, ಅವು ಹೊಗೆ ಹಾಯುತ್ತವೆ.<verse eid="PSA 104:32"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="33" style="v" sid="PSA 104:33"/>ನಾನು ಜೀವಿತ ಕಾಲವೆಲ್ಲಾ ಯೆಹೋವ ದೇವರಿಗೆ ಹಾಡುತ್ತಿರುವೆನು.</para>
  <para style="q2" vid="PSA 104:33">ನಾನು ಬದುಕಿರುವವರೆಗೆ ದೇವರನ್ನು ಸ್ತುತಿಸುತ್ತಿರುವೆನು.<verse eid="PSA 104:33"/></para>
  <para style="q1">
    <verse number="34" style="v" sid="PSA 104:34"/>ದೇವರ ವಿಷಯವಾದ ನನ್ನ ಧ್ಯಾನವು ಮಧುರವಾಗಿರುವುದು;</para>
  <para style="q2" vid="PSA 104:34">ನಾನು ಯೆಹೋವ ದೇವರಲ್ಲಿ ಸಂತೋಷ ಪಡುವೆನು.<verse eid="PSA 104:34"/></para>
  <para style="q1">
    <verse number="35" style="v" sid="PSA 104:35"/>ಪಾಪಿಗಳು ಭೂಮಿಯೊಳಗಿಂದ ಮುಗಿದು ಹೋಗಲಿ;</para>
  <para style="q2" vid="PSA 104:35">ದುಷ್ಟರು ಇಲ್ಲದೆ ಹೋಗಲಿ.</para>
  <para style="b" vid="PSA 104:35"/>
  <para style="q1" vid="PSA 104:35">ನನ್ನ ಮನವೇ, ಯೆಹೋವ ದೇವರನ್ನು ಸ್ತುತಿಸು.</para>
  <para style="b" vid="PSA 104:35"/>
  <para style="q1" vid="PSA 104:35">ಯೆಹೋವ ದೇವರಿಗೆ ಸ್ತೋತ್ರವಾಗಲಿ.<verse eid="PSA 104:35"/></para>
  <chapter eid="PSA 104"/>
  <chapter number="105" style="c" sid="PSA 105"/>
  <para style="cl">ಕೀರ್ತನೆ 105</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 105:1"/>ಯೆಹೋವ ದೇವರಿಗೆ ಉಪಕಾರಸ್ತುತಿ ಮಾಡಿರಿ, ಅವರ ಹೆಸರನ್ನು ಸಾರಿ ಹೇಳಿರಿ;</para>
  <para style="q2" vid="PSA 105:1">ಜನರಲ್ಲಿ ದೇವರ ಕ್ರಿಯೆಗಳನ್ನು ತಿಳಿಯಪಡಿಸಿರಿ.<verse eid="PSA 105:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 105:2"/>ದೇವರಿಗೆ ಹಾಡಿರಿ, ದೇವರಿಗೆ ಕೀರ್ತನೆ ಹಾಡಿರಿ;</para>
  <para style="q2" vid="PSA 105:2">ದೇವರ ಅದ್ಭುತ ಕ್ರಿಯೆಗಳ ವಿಷಯವಾಗಿ ಮಾತನಾಡಿರಿ.<verse eid="PSA 105:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 105:3"/>ದೇವರ ಪರಿಶುದ್ಧ ನಾಮವನ್ನು ಹೊಗಳಿರಿ;</para>
  <para style="q2" vid="PSA 105:3">ಯೆಹೋವ ದೇವರನ್ನು ಹುಡುಕುವವರ ಹೃದಯವು ಸಂತೋಷಿಸಲಿ.<verse eid="PSA 105:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 105:4"/>ಯೆಹೋವ ದೇವರನ್ನೂ, ಅವರ ಬಲವನ್ನೂ ಆಶ್ರಯಿಸಿರಿ,</para>
  <para style="q2" vid="PSA 105:4">ಅವರ ಮುಖವನ್ನು ಯಾವಾಗಲೂ ಹುಡುಕಿರಿ.<verse eid="PSA 105:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 105:5"/>ದೇವರು ಮಾಡಿದ ಆಶ್ಚರ್ಯಕಾರ್ಯಗಳನ್ನೂ, ಅವರ ಅದ್ಭುತಗಳನ್ನೂ,</para>
  <para style="q2" vid="PSA 105:5">ಅವರ ಬಾಯಿಂದ ಹೊರಟ ನ್ಯಾಯ ನಿರ್ಣಯಗಳನ್ನೂ ಜ್ಞಾಪಕಮಾಡಿಕೊಳ್ಳಿರಿ.<verse eid="PSA 105:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 105:6"/>ದೇವರ ಸೇವಕನಾದ ಅಬ್ರಹಾಮನ ಸಂತತಿಯೇ,</para>
  <para style="q2" vid="PSA 105:6">ಅವರು ಆಯ್ದುಕೊಂಡ ಯಾಕೋಬನ ಮಕ್ಕಳೇ,<verse eid="PSA 105:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 105:7"/>ಅವರೇ ನಮ್ಮ ದೇವರಾದ ಯೆಹೋವ ಆಗಿದ್ದಾರೆ.</para>
  <para style="q2" vid="PSA 105:7">ಅವರ ನ್ಯಾಯಗಳು ಸಮಸ್ತ ಭೂಮಿಯಲ್ಲಿ ಇವೆ.<verse eid="PSA 105:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 105:8"/>ದೇವರು ತಮ್ಮ ಒಡಂಬಡಿಕೆಯನ್ನೂ,</para>
  <para style="q2" vid="PSA 105:8">ಸಾವಿರ ತಲಾಂತರಗಳಿಗೆ ಆಜ್ಞಾಪಿಸಿದ ತಮ್ಮ ಮಾತನ್ನೂ,<verse eid="PSA 105:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 105:9"/>ಅಬ್ರಹಾಮನ ಸಂಗಡ ಮಾಡಿದ ಒಡಂಬಡಿಕೆಯನ್ನೂ,</para>
  <para style="q2" vid="PSA 105:9">ಇಸಾಕನಿಗೆ ಇಟ್ಟ ಆಣೆಯನ್ನೂ ಯುಗಯುಗಕ್ಕೂ ಜ್ಞಾಪಕ ಮಾಡಿಕೊಂಡಿದ್ದಾರೆ.<verse eid="PSA 105:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 105:10"/>ದೇವರು ಅದನ್ನು ಯಾಕೋಬನಿಗೆ ತೀರ್ಪನ್ನಾಗಿ ದೃಢಪಡಿಸಿದರು;</para>
  <para style="q2" vid="PSA 105:10">ಅವರು ಇಸ್ರಾಯೇಲರಿಗೆ ನಿತ್ಯ ಒಡಂಬಡಿಕೆಯಾಗಿ ಸ್ಥಾಪಿಸಿ ಹೇಳಿದ್ದೇನೆಂದರೆ:<verse eid="PSA 105:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 105:11"/>“ನಾನು ನಿಮಗೆ ಕಾನಾನ್ ದೇಶವನ್ನು</para>
  <para style="q2" vid="PSA 105:11">ನಿಮ್ಮ ಬಾಧ್ಯತೆಯ ಪಾಲಾಗಿ ಕೊಡುವೆನು.”<verse eid="PSA 105:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 105:12"/>ಆಗ ಅವರು ಅಲ್ಪಸಂಖ್ಯಾತರೂ,</para>
  <para style="q2" vid="PSA 105:12">ಬಹು ಸ್ವಲ್ಪ ಮಂದಿಯಾಗಿಯೂ, ಪರದೇಶಸ್ಥರಾಗಿಯೂ ನಾಡಿನಲ್ಲಿ ಇದ್ದರು.<verse eid="PSA 105:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 105:13"/>ಅವರು ಜನಾಂಗದಿಂದ ಜನಾಂಗಕ್ಕೂ</para>
  <para style="q2" vid="PSA 105:13">ಒಂದು ರಾಜ್ಯದಿಂದ ಬೇರೊಂದು ರಾಜ್ಯಕ್ಕೂ ಹೋಗುತ್ತಿದ್ದರು.<verse eid="PSA 105:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 105:14"/>ಜನರು ಅವರಿಗೆ ಕೇಡು ಮಾಡದಂತೆ ದೇವರು ತಡೆದರು.</para>
  <para style="q2" vid="PSA 105:14">ಹೌದು, ಅವರಿಗೋಸ್ಕರ ದೇವರು ಅರಸರನ್ನು ಗದರಿಸಿ ಹೀಗೆ ಹೇಳಿದರು:<verse eid="PSA 105:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 105:15"/>“ನನ್ನ ಅಭಿಷಿಕ್ತರನ್ನು ಮುಟ್ಟಬೇಡಿರಿ,</para>
  <para style="q2" vid="PSA 105:15">ನನ್ನ ಪ್ರವಾದಿಗಳಿಗೆ ಕೇಡು ಮಾಡಬೇಡಿರಿ.”<verse eid="PSA 105:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 105:16"/>ದೇವರು ಕ್ಷಾಮವನ್ನು ದೇಶದಲ್ಲಿ ಅನುಮತಿಸಿದರು.</para>
  <para style="q2" vid="PSA 105:16">ಆಹಾರದ ಒದಗುವಿಕೆಯನ್ನು ಸ್ವಲ್ಪಕಾಲ ನಿಲ್ಲಿಸಿದ್ದರು.<verse eid="PSA 105:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 105:17"/>ಆಗ ದೇವರು ಅವರ ಮುಂದೆ ಒಬ್ಬ ಮನುಷ್ಯನನ್ನು ಕಳುಹಿಸಿದರು.</para>
  <para style="q2" vid="PSA 105:17">ಅವನೇ ದಾಸನಾಗಿ ಮಾರಲಾದ ಯೋಸೇಫನು.<verse eid="PSA 105:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 105:18"/>ಸಂಕೋಲೆಗಳಿಂದ ಅವನ ಕಾಲನ್ನು ನೋಯಿಸಿದರು;</para>
  <para style="q2" vid="PSA 105:18">ಅವನನ್ನು ಕಬ್ಬಿಣದ ಬೇಡಿಗಳಲ್ಲಿ ಇರಿಸಿದರು.<verse eid="PSA 105:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 105:19"/>ಯೆಹೋವ ದೇವರ ಮುಂತಿಳಿಸಿದ ವಾಕ್ಯವು ನೆರವೇರುವವರೆಗೆ</para>
  <para style="q2" vid="PSA 105:19">ಅವನು ದೇವರ ಮಾತಿನಿಂದ ಪರಿಶೋಧಿತನಾದನು.<verse eid="PSA 105:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 105:20"/>ಅರಸನು ಅವನನ್ನು ಕರೆದು ಸೆರೆಯಿಂದ ಬಿಡಿಸಿದನು.</para>
  <para style="q2" vid="PSA 105:20">ಹೌದು, ಜನಗಳ ಅಧಿಪತಿಯಿಂದ ಅವನು ಬಿಡುಗಡೆಯಾದನು.<verse eid="PSA 105:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 105:21"/>ಅರಸನು ಅವನನ್ನು ತನ್ನ ಮನೆಗೆ ಯಜಮಾನನಾಗಿಯೂ,</para>
  <para style="q2" vid="PSA 105:21">ತನ್ನ ಎಲ್ಲಾ ಆಸ್ತಿಯ ಮೇಲೆ ಅಧಿಪತಿಯಾಗಿಯೂ,<verse eid="PSA 105:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 105:22"/>ತನ್ನ ಪ್ರಧಾನರಿಗೆ ತನ್ನ ಇಷ್ಟ ಪ್ರಕಾರ ಶಿಕ್ಷಣ ಕೊಡುವುದಕ್ಕೂ,</para>
  <para style="q2" vid="PSA 105:22">ತನ್ನ ಜ್ಞಾನವನ್ನು ಮಂತ್ರಿಗಳಿಗೆ ಬೋಧಿಸುವುದಕ್ಕೂ ಯೋಸೇಫನನ್ನು ನೇಮಿಸಿದನು.<verse eid="PSA 105:22"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 105:23"/>ಅನಂತರ ಇಸ್ರಾಯೇಲನು ಈಜಿಪ್ಟಿಗೆ ಬಂದನು;</para>
  <para style="q2" vid="PSA 105:23">ಯಾಕೋಬನು ಹಾಮನ ದೇಶದಲ್ಲಿ ಪರದೇಶಸ್ಥನಾಗಿದ್ದನು.<verse eid="PSA 105:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 105:24"/>ದೇವರು ತಮ್ಮ ಜನರನ್ನು ಬಹಳ ಅಭಿವೃದ್ಧಿಗೊಳಿಸಿ,</para>
  <para style="q2" vid="PSA 105:24">ಅವರನ್ನು ವೈರಿಗಳಿಗಿಂತ ಬಲಿಷ್ಟರನ್ನಾಗಿ ಮಾಡಿದರು.<verse eid="PSA 105:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 105:25"/>ತಮ್ಮ ಜನರನ್ನು ದ್ವೇಷಿಸುವಂತೆಯೂ,</para>
  <para style="q2" vid="PSA 105:25">ತಮ್ಮ ಸೇವಕರನ್ನು ಕುಯುಕ್ತಿಯಿಂದ ನಡೆಸುವಂತೆಯೂ ದೇವರು ಅವರ ಹೃದಯವನ್ನು ಮಾರ್ಪಡಿಸಿದನು.<verse eid="PSA 105:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 105:26"/>ದೇವರು ತಮ್ಮ ಸೇವಕ ಮೋಶೆಯನ್ನೂ,</para>
  <para style="q2" vid="PSA 105:26">ಆಯ್ದುಕೊಂಡ ಆರೋನನನ್ನೂ ಕಳುಹಿಸಿದರು.<verse eid="PSA 105:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 105:27"/>ಇವರು ದೇವರ ಸೂಚಕಕಾರ್ಯಗಳನ್ನೂ,</para>
  <para style="q2" vid="PSA 105:27">ಹಾಮನ ದೇಶದಲ್ಲಿ ಅದ್ಭುತಗಳನ್ನೂ ಅವರೊಳಗೆ ತೋರಿಸಿದರು.<verse eid="PSA 105:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 105:28"/>ದೇವರು ಕತ್ತಲೆಯನ್ನು ಕಳುಹಿಸಿ, ದೇಶವನ್ನೆಲ್ಲಾ ಕತ್ತಲು ಮಾಡಿದರು.</para>
  <para style="q2" vid="PSA 105:28">ದೇವರ ಮಾತಿಗೆ ಈಜಿಪ್ಟನವರು ವಿರೋಧವಾಗಿ ತಿರುಗಿ ಬಿದ್ದರಲ್ಲವೇ?<verse eid="PSA 105:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="PSA 105:29"/>ದೇವರು ಅವರ ನೀರನ್ನು ರಕ್ತವಾಗಿ ಮಾರ್ಪಡಿಸಿದರು.</para>
  <para style="q2" vid="PSA 105:29">ಅವರ ಮೀನುಗಳನ್ನು ನಾಶಮಾಡಿದರು.<verse eid="PSA 105:29"/></para>
  <para style="q1">
    <verse number="30" style="v" sid="PSA 105:30"/>ಅವರ ದೇಶವು ಕಪ್ಪೆಗಳಿಂದ ತುಂಬಿಕೊಂಡಿತು;</para>
  <para style="q2" vid="PSA 105:30">ಅವರ ಅರಸುಗಳ ಕೊಠಡಿಗಳಲ್ಲಿ ಸಹ ಅವು ನುಗ್ಗಿದವು.<verse eid="PSA 105:30"/></para>
  <para style="q1">
    <verse number="31" style="v" sid="PSA 105:31"/>ದೇವರು ಆಜ್ಞಾಪಿಸಲು ನೊಣದ ಗುಂಪುಗಳೂ,</para>
  <para style="q2" vid="PSA 105:31">ಅವರ ಮೇರೆಗಳಲ್ಲೆಲ್ಲಾ ಹೇನುಗಳೂ ಬಂದವು.<verse eid="PSA 105:31"/></para>
  <para style="q1">
    <verse number="32" style="v" sid="PSA 105:32"/>ದೇವರು ಕಲ್ಮಳೆಯನ್ನೂ, ಅಗ್ನಿ ಜ್ವಾಲೆಗಳನ್ನೂ</para>
  <para style="q2" vid="PSA 105:32">ಅವರ ದೇಶದಲ್ಲಿ ಬರಮಾಡಿದರು.<verse eid="PSA 105:32"/></para>
  <para style="q1">
    <verse number="33" style="v" sid="PSA 105:33"/>ಅವರ ದ್ರಾಕ್ಷಿಯ ಬಳ್ಳಿ, ಅಂಜೂರದ ಗಿಡಗಳು ಹಾಗೂ</para>
  <para style="q2" vid="PSA 105:33">ಅವರ ಮೇರೆಗಳ ಮರಗಳು ಮುರಿದು ಬಿದ್ದವು.<verse eid="PSA 105:33"/></para>
  <para style="q1">
    <verse number="34" style="v" sid="PSA 105:34"/>ದೇವರು ಆಜ್ಞಾಪಿಸಲು ಮಿಡತೆಗಳೂ,</para>
  <para style="q2" vid="PSA 105:34">ಲೆಕ್ಕವಿಲ್ಲದ ಕಂಬಳಿ ಹುಳುಗಳೂ ಬಂದವು.<verse eid="PSA 105:34"/></para>
  <para style="q1">
    <verse number="35" style="v" sid="PSA 105:35"/>ಅವು ಈಜಿಪ್ಟ್ ದೇಶದಲ್ಲಿ ಎಲ್ಲಾ ಸಸ್ಯಗಳನ್ನು ತಿಂದುಬಿಟ್ಟವು;</para>
  <para style="q2" vid="PSA 105:35">ಅವರ ಭೂಮಿಯ ಫಲಗಳನ್ನು ಸಹ ತಿಂದುಬಿಟ್ಟವು.<verse eid="PSA 105:35"/></para>
  <para style="q1">
    <verse number="36" style="v" sid="PSA 105:36"/>ಅವರ ದೇಶದಲ್ಲಿಯ ಎಲ್ಲಾ ಚೊಚ್ಚಲ ಮಕ್ಕಳೂ</para>
  <para style="q2" vid="PSA 105:36">ಅವರ ಎಲ್ಲಾ ಪ್ರಮುಖರೂ ದೇವರ ಬಾಧೆಗೆ ಒಳಗಾದರು.<verse eid="PSA 105:36"/></para>
  <para style="q1">
    <verse number="37" style="v" sid="PSA 105:37"/>ದೇವರು ಬೆಳ್ಳಿ ಬಂಗಾರಗಳ ಸಂಗಡ ಇಸ್ರಾಯೇಲರನ್ನು ಹೊರಗೆ ಬರಮಾಡಿದರು.</para>
  <para style="q2" vid="PSA 105:37">ಅವರ ಗೋತ್ರಗಳಲ್ಲಿ ಬಲಹೀನನಾದ ಒಬ್ಬನೂ ಇರಲಿಲ್ಲ.<verse eid="PSA 105:37"/></para>
  <para style="q1">
    <verse number="38" style="v" sid="PSA 105:38"/>ಅವರೆಲ್ಲರೂ ಹೊರಗೆ ಹೋಗುವಾಗ ಈಜಿಪ್ಟ್ ದೇಶವು ಸಂತೋಷಿಸಿತು;</para>
  <para style="q2" vid="PSA 105:38">ಏಕೆಂದರೆ ಈಜಿಪ್ಟಿನವರಿಗೆ ಅವರನ್ನು ಕುರಿತು ಹೆದರಿಕೆ ಇತ್ತು.<verse eid="PSA 105:38"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="39" style="v" sid="PSA 105:39"/>ದೇವರು ಇಸ್ರಾಯೇಲರ ನೆರಳಿಗೋಸ್ಕರ ಮೇಘವನ್ನೂ,</para>
  <para style="q2" vid="PSA 105:39">ರಾತ್ರಿಯಲ್ಲಿ ಬೆಳಕಿಗೋಸ್ಕರ ಬೆಂಕಿಯನ್ನೂ ಏರ್ಪಡಿಸಿದರು.<verse eid="PSA 105:39"/></para>
  <para style="q1">
    <verse number="40" style="v" sid="PSA 105:40"/>ಅವರು ಕೇಳಿದಾಗ ದೇವರು ಲಾವಕ್ಕಿಗಳನ್ನು ಬರಮಾಡಿ,</para>
  <para style="q2" vid="PSA 105:40">ಪರಲೋಕದ ಆಹಾರದಿಂದ ಅವರನ್ನು ತೃಪ್ತಿಪಡಿಸಿದರು.<verse eid="PSA 105:40"/></para>
  <para style="q1">
    <verse number="41" style="v" sid="PSA 105:41"/>ದೇವರು ಬಂಡೆಯನ್ನು ತೆರೆಯಲು ನೀರು ಹೊರಟಿತು;</para>
  <para style="q2" vid="PSA 105:41">ಅದು ಮರುಭೂಮಿಯಲ್ಲಿ ನದಿಯಾಗಿ ಹರಿಯಿತು.<verse eid="PSA 105:41"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="42" style="v" sid="PSA 105:42"/>ಹೀಗೆ ದೇವರು ತಮ್ಮ ಪರಿಶುದ್ಧ ವಾಗ್ದಾನವನ್ನೂ,</para>
  <para style="q2" vid="PSA 105:42">ತಮ್ಮ ಸೇವಕನಾದ ಅಬ್ರಹಾಮನನ್ನೂ ಜ್ಞಾಪಕಮಾಡಿಕೊಂಡರು.<verse eid="PSA 105:42"/></para>
  <para style="q1">
    <verse number="43" style="v" sid="PSA 105:43"/>ದೇವರು ತಮ್ಮ ಜನರನ್ನು ಆನಂದದಿಂದಲೂ,</para>
  <para style="q2" vid="PSA 105:43">ತಾವು ಆಯ್ದುಕೊಂಡವರನ್ನು ಉತ್ಸಾಹದಿಂದಲೂ ಹೊರತಂದರು.<verse eid="PSA 105:43"/></para>
  <para style="q1">
    <verse number="44" style="v" sid="PSA 105:44"/>ದೇವರು ಜನಾಂಗಗಳ ದೇಶಗಳನ್ನು ಅವರಿಗೆ ಕೊಟ್ಟರು.</para>
  <para style="q2" vid="PSA 105:44">ಇಸ್ರಾಯೇಲರು ಇತರರ ಕಷ್ಟಾರ್ಜಿತವನ್ನು ತಮಗಾಗಿ ಸ್ವಾಧೀನಮಾಡಿಕೊಂಡರು.<verse eid="PSA 105:44"/></para>
  <para style="q1">
    <verse number="45" style="v" sid="PSA 105:45"/>ದೇವರ ಸೂತ್ರಗಳನ್ನು ಕೈಗೊಂಡು,</para>
  <para style="q2" vid="PSA 105:45">ಅವರ ನಿಯಮಗಳನ್ನು ಇಸ್ರಾಯೇಲರು ಕಾಯಬೇಕೆಂಬ ಉದ್ದೇಶದಿಂದಲೇ ಹೀಗೆಲ್ಲಾ ಆಯಿತು.</para>
  <para style="b" vid="PSA 105:45"/>
  <para style="q1" vid="PSA 105:45">ಯೆಹೋವ ದೇವರನ್ನು ಸ್ತುತಿಸಿರಿ.<verse eid="PSA 105:45"/></para>
  <chapter eid="PSA 105"/>
  <chapter number="106" style="c" sid="PSA 106"/>
  <para style="cl">ಕೀರ್ತನೆ 106</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 106:1"/>ಯೆಹೋವ ದೇವರನ್ನು ಸ್ತುತಿಸಿರಿ.</para>
  <para style="b" vid="PSA 106:1"/>
  <para style="q1" vid="PSA 106:1">ಯೆಹೋವ ದೇವರಿಗೆ ಉಪಕಾರಸ್ತುತಿ ಮಾಡಿರಿ; ಅವರು ಒಳ್ಳೆಯವರು.</para>
  <para style="q2" vid="PSA 106:1">ಅವರ ಪ್ರೀತಿ ಶಾಶ್ವತವಾಗಿರುವುದು.<verse eid="PSA 106:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 106:2"/>ಯೆಹೋವ ದೇವರ ಪರಾಕ್ರಮ ಕ್ರಿಯೆಗಳನ್ನು ಪ್ರಕಟಿಸಿರಿ,</para>
  <para style="q2" vid="PSA 106:2">ದೇವರನ್ನು ತಕ್ಕಂತೆ ಸ್ತುತಿಸುವವರು ಯಾರಿಗೆ ಸಾಧ್ಯ?<verse eid="PSA 106:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 106:3"/>ನ್ಯಾಯವನ್ನು ಕಾಪಾಡಿಕೊಂಡು ಯಾವಾಗಲೂ</para>
  <para style="q2" vid="PSA 106:3">ಸರಿಯಾದವುಗಳನ್ನು ಪಾಲಿಸುವವರು ಧನ್ಯರು.<verse eid="PSA 106:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 106:4"/>ದೇವರೇ, ನಿಮ್ಮ ಜನರ ಮೇಲಿರುವ ಮೆಚ್ಚುಗೆಯಿಂದ ನನ್ನನ್ನು ಜ್ಞಾಪಕಮಾಡಿಕೊಳ್ಳಿರಿ,</para>
  <para style="q2" vid="PSA 106:4">ನಿಮ್ಮ ರಕ್ಷಣೆಯಿಂದ ನನ್ನನ್ನು ದರ್ಶಿಸಿರಿ.<verse eid="PSA 106:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 106:5"/>ಯೆಹೋವ ದೇವರೇ, ನಾನು ನೀವು ಆಯ್ದುಕೊಂಡವರ ಸುಖವನ್ನು ಕಂಡು,</para>
  <para style="q2" vid="PSA 106:5">ನಿಮ್ಮ ಜನರ ಸಂತೋಷದೊಂದಿಗೆ ಸಂತೋಷಿಸಿ,</para>
  <para style="q2" vid="PSA 106:5">ನಿಮ್ಮ ಸ್ವಕೀಯರ ಸಂಗಡ ಹೊಗಳಿಕೊಳ್ಳುವೆನು.<verse eid="PSA 106:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 106:6"/>ನಮ್ಮ ಪಿತೃಗಳಂತೆ ನಾವು ಕೂಡಾ ಪಾಪಮಾಡಿದ್ದೇವೆ;</para>
  <para style="q2" vid="PSA 106:6">ಅಕ್ರಮ ಮಾಡಿದ್ದೇವೆ; ದುಷ್ಟಕೃತ್ಯಗಳನ್ನು ನಡೆಸಿದ್ದೇವೆ.<verse eid="PSA 106:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 106:7"/>ನಮ್ಮ ಪಿತೃಗಳು ಈಜಿಪ್ಟಿನಲ್ಲಿ</para>
  <para style="q2" vid="PSA 106:7">ನಿಮ್ಮ ಅದ್ಭುತಗಳಿಗೆ ಲಕ್ಷಕೊಡದೆ,</para>
  <para style="q1" vid="PSA 106:7">ನಿಮ್ಮ ಕರುಣಾತಿಶಯವನ್ನು ನೆನಸದೆ,</para>
  <para style="q2" vid="PSA 106:7">ಸಮುದ್ರದ ಬಳಿಯಲ್ಲಿ ಅಂದರೆ ಕೆಂಪುಸಮುದ್ರದ ಹತ್ತಿರ ತಿರುಗಿಬಿದ್ದರು.<verse eid="PSA 106:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 106:8"/>ಆದರೂ ದೇವರು ತಮ್ಮ ಮಹಾಶಕ್ತಿಯನ್ನು ಅವರಿಗೆ ತಿಳಿಯಮಾಡುವ ಹಾಗೆ,</para>
  <para style="q2" vid="PSA 106:8">ತಮ್ಮ ಹೆಸರಿನ ನಿಮಿತ್ತ ಅವರನ್ನು ರಕ್ಷಿಸಿದರು.<verse eid="PSA 106:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 106:9"/>ದೇವರು ಕೆಂಪು ಸಮುದ್ರವನ್ನು ಗದರಿಸಲು, ಅದು ಒಣಗಿ ಹೋಯಿತು;</para>
  <para style="q2" vid="PSA 106:9">ಹೀಗೆ ಮರುಭೂಮಿಯಲ್ಲಿ ನಡೆದು ಹೋದಂತೆ ಜಲಾಗಾಧದಲ್ಲಿ ಇಸ್ರಾಯೇಲರನ್ನು ನಡೆಸಿದರು.<verse eid="PSA 106:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 106:10"/>ವೈರಿಯ ಕೈಯೊಳಗಿಂದ ಅವರನ್ನು ರಕ್ಷಿಸಿದರು,</para>
  <para style="q2" vid="PSA 106:10">ಶತ್ರುವಿನ ಕೈಯಿಂದ ಅವರನ್ನು ಬಿಡುಗಡೆ ಮಾಡಿದರು.<verse eid="PSA 106:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 106:11"/>ಪ್ರವಾಹಗಳು ಅವರ ವೈರಿಗಳನ್ನು ಮುಚ್ಚಿಬಿಟ್ಟವು,</para>
  <para style="q2" vid="PSA 106:11">ವೈರಿಗಳಲ್ಲಿ ಒಬ್ಬನೂ ಉಳಿಯಲಿಲ್ಲ.<verse eid="PSA 106:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 106:12"/>ಆಗ ಅವರು ದೇವರ ಮಾತುಗಳನ್ನು ನಂಬಿ,</para>
  <para style="q2" vid="PSA 106:12">ದೇವರಿಗೆ ಸ್ತೋತ್ರವನ್ನು ಹಾಡಿದರು.<verse eid="PSA 106:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 106:13"/>ಆದರೆ ಬೇಗನೇ ದೇವರು ಮಾಡಿದ ಕೆಲಸಗಳನ್ನು ಮರೆತುಬಿಟ್ಟು,</para>
  <para style="q2" vid="PSA 106:13">ದೇವರ ಸಂಕಲ್ಪಕ್ಕೆ ಅವರು ಕಾದುಕೊಳ್ಳದೆ ಹೋದರು.<verse eid="PSA 106:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 106:14"/>ಮರುಭೂಮಿಯಲ್ಲಿ ದುರಾಶೆಯಿಂದ ಆಶಿಸಿ,</para>
  <para style="q2" vid="PSA 106:14">ಹಾಳು ಪ್ರದೇಶದಲ್ಲಿ ದೇವರನ್ನು ಪರೀಕ್ಷಿಸಿದರು.<verse eid="PSA 106:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 106:15"/>ಆಗ ದೇವರು ಅವರ ಬೇಡಿಕೆಯಂತೆಯೇ ಅವರಿಗೆ ಕೊಟ್ಟುಬಿಟ್ಟರು;</para>
  <para style="q2" vid="PSA 106:15">ಆದರೆ ಅವರ ದೇಹಕ್ಕೆ ಭೀಕರ ರೋಗವನ್ನು ಸಹ ಅನುಮತಿಸಿದರು.<verse eid="PSA 106:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 106:16"/>ಇಸ್ರಾಯೇಲರು ಪಾಳೆಯದಲ್ಲಿ ಮೋಶೆಯ ಮೇಲೆಯೂ,</para>
  <para style="q2" vid="PSA 106:16">ಯೆಹೋವ ದೇವರಿಗೆ ಪ್ರತಿಷ್ಠಿತನಾದ ಆರೋನನ ಮೇಲೆಯೂ ಹೊಟ್ಟೆಕಿಚ್ಚುಪಟ್ಟರು.<verse eid="PSA 106:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 106:17"/>ಆಗ ಭೂಮಿಯು ಬಾಯಿತೆರೆದು ದಾತಾನನನ್ನು ನುಂಗಿ,</para>
  <para style="q2" vid="PSA 106:17">ಅಬೀರಾಮನ ಗುಂಪನ್ನು ಮುಚ್ಚಿಬಿಟ್ಟಿತು.<verse eid="PSA 106:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 106:18"/>ಬೆಂಕಿಯು ಅವರ ಗುಂಪಿನಲ್ಲಿ ಉರಿದು,</para>
  <para style="q2" vid="PSA 106:18">ಜ್ವಾಲೆಯು ದುಷ್ಟರನ್ನು ಸುಟ್ಟಿತು.<verse eid="PSA 106:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 106:19"/>ಅವರು ಹೋರೇಬಿನಲ್ಲಿ ಎರಕದ ಕರುವನ್ನು ಮಾಡಿ,</para>
  <para style="q2" vid="PSA 106:19">ಆ ವಿಗ್ರಹಕ್ಕೆ ಅಡ್ಡಬಿದ್ದರು.<verse eid="PSA 106:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 106:20"/>ಹೀಗೆ ಅವರು ತಮ್ಮ ಮಹಿಮೆಯುಳ್ಳ ದೇವರನ್ನು</para>
  <para style="q2" vid="PSA 106:20">ಹುಲ್ಲು ತಿನ್ನುವ ಎತ್ತಿನ ರೂಪಕ್ಕೆ ಬದಲಾಯಿಸಿದರು.<verse eid="PSA 106:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 106:21"/>ಅವರು ತಮ್ಮನ್ನು ರಕ್ಷಿಸಿದ ದೇವರನ್ನು ಬೇಗ ಮರೆತುಬಿಟ್ಟರು.</para>
  <para style="q2" vid="PSA 106:21">ಹೌದು, ಈಜಿಪ್ಟ್ ದೇಶದಲ್ಲಿ ಮಹತ್ಕಾರ್ಯಗಳನ್ನೂ,<verse eid="PSA 106:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 106:22"/>ಹಾಮ ದೇಶದಲ್ಲಿ ಅದ್ಭುತಗಳನ್ನೂ,</para>
  <para style="q2" vid="PSA 106:22">ಕೆಂಪುಸಮುದ್ರದ ಬಳಿಯಲ್ಲಿ ಅತಿಶಯವಾದವುಗಳನ್ನೂ ಮಾಡಿದ ದೇವರನ್ನು ಮರೆತುಬಿಟ್ಟರು.<verse eid="PSA 106:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 106:23"/>ಆದ್ದರಿಂದ ದೇವರು ಅವರಿಗೆ ಪೂರ್ಣದಂಡನೆ ಕೊಡುವುದಾಗಿ ಹೇಳಿದರು.</para>
  <para style="q2" vid="PSA 106:23">ಆದರೆ ಅವರು ಆಯ್ದುಕೊಂಡ ಮೋಶೆಯು,</para>
  <para style="q1" vid="PSA 106:23">ದೇವರ ಕಠಿಣ ತೀರ್ಮಾನವನ್ನು ಶಾಂತಪಡಿಸಲು ಆಪತ್ತಿನಲ್ಲಿ</para>
  <para style="q2" vid="PSA 106:23">ದೇವರ ಮುಂದೆ ಮಧ್ಯಸ್ಥನಾಗಿ ನಿಂತುಕೊಂಡನು.<verse eid="PSA 106:23"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 106:24"/>ಹೌದು, ಇಸ್ರಾಯೇಲರು ಮನೋಹರವಾದ ದೇಶವನ್ನು ಹೀನೈಸಿ,</para>
  <para style="q2" vid="PSA 106:24">ದೇವರ ಮಾತನ್ನು ನಂಬದೆ ಹೋದರು.<verse eid="PSA 106:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 106:25"/>ತಮ್ಮ ಗುಡಾರಗಳಲ್ಲಿ ಗೊಣಗುಟ್ಟಿ</para>
  <para style="q2" vid="PSA 106:25">ಯೆಹೋವ ದೇವರ ಮಾತನ್ನು ಹೇಳದೆ ಹೋದರು.<verse eid="PSA 106:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 106:26"/>ಆದ್ದರಿಂದ ದೇವರು ಅವರನ್ನು ಮರುಭೂಮಿಯಲ್ಲಿ ಬೀಳುವಂತೆಯೂ,</para>
  <para style="q1" vid="PSA 106:26">ಅವರ ಸಂತತಿಯರು ದೇಶಗಳಲ್ಲಿ ಚದರಿಸುವಂತೆಯೂ<verse eid="PSA 106:26"/></para>
  <para style="q2">
    <verse number="27" style="v" sid="PSA 106:27"/>ತಮ್ಮ ಕೈಯನ್ನು ಎತ್ತಿ ಅವರಿಗೆ ಪ್ರಮಾಣ ಮಾಡಬೇಕಾಯಿತು.<verse eid="PSA 106:27"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 106:28"/>ಇಸ್ರಾಯೇಲರು ಬಾಳ್ ಪೆಯೋರನ ದೇವತೆಗೆ ತಮ್ಮನ್ನು ಒಪ್ಪಿಸಿಕೊಟ್ಟರು;</para>
  <para style="q2" vid="PSA 106:28">ಜೀವವಿಲ್ಲದ ದೇವರುಗಳಿಗೆ ಅರ್ಪಿಸಿದ ಯಜ್ಞಗಳನ್ನು ತಿಂದರು.<verse eid="PSA 106:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="PSA 106:29"/>ತಮ್ಮ ಕ್ರಿಯೆಗಳಿಂದ ದೇವರನ್ನು ಅಸಂತೋಷಪಡಿಸಿದರು.</para>
  <para style="q2" vid="PSA 106:29">ಆದ್ದರಿಂದ ವ್ಯಾಧಿಯು ಅವರಲ್ಲಿ ಹಬ್ಬಿತು.<verse eid="PSA 106:29"/></para>
  <para style="q1">
    <verse number="30" style="v" sid="PSA 106:30"/>ಆಗ ಫೀನೆಹಾಸನು ಎದ್ದು ಬಂದು ದಂಡಿಸಿದ್ದರಿಂದ</para>
  <para style="q2" vid="PSA 106:30">ವ್ಯಾಧಿ ನಿಂತುಹೋಯಿತು.<verse eid="PSA 106:30"/></para>
  <para style="q1">
    <verse number="31" style="v" sid="PSA 106:31"/>ಇದು ತಲತಲಾಂತರಕ್ಕೂ, ಯುಗಯುಗಕ್ಕೂ</para>
  <para style="q2" vid="PSA 106:31">ಫೀನೆಹಾಸನಿಗೆ ನೀತಿ ಎಂದು ಎಣಿಸಲಾಯಿತು.<verse eid="PSA 106:31"/></para>
  <para style="q1">
    <verse number="32" style="v" sid="PSA 106:32"/>ಮೆರೀಬಾದ<note caller="+" style="f"><char style="fr" closed="false">106:32 </char><char style="fq" closed="false">ಮೆರೀಬಾದ </char><char style="ft" closed="false">ಅಂದರೆ </char><char style="fqa" closed="false">ಜಗಳ </char><char style="ft" closed="false">ಎಂದು ಅರ್ಥ. ನೋಡಿರಿ <char style="xt"><ref loc="EXO 17:7">ವಿಮೋ 17:7</ref></char></char></note> ನೀರಿನ ಬಳಿಯಲ್ಲಿ ಆತನಿಗೆ ಕೋಪವನ್ನೆಬ್ಬಿಸಿದರು.</para>
  <para style="q2" vid="PSA 106:32">ಅಲ್ಲಿ ಅವರ ನಿಮಿತ್ತ ಮೋಶೆಗೆ ಕೇಡು ಬಂತು.<verse eid="PSA 106:32"/></para>
  <para style="q1">
    <verse number="33" style="v" sid="PSA 106:33"/>ಏಕೆಂದರೆ ಇಸ್ರಾಯೇಲರು ದೇವರ ಆತ್ಮನಿಗೆ ತಿರುಗಿ ಬಿದ್ದದ್ದರಿಂದ,</para>
  <para style="q2" vid="PSA 106:33">ಮೋಶೆ ದುಡುಕಿ ಮಾತನಾಡಿದನು.<verse eid="PSA 106:33"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="34" style="v" sid="PSA 106:34"/>ಯೆಹೋವ ದೇವರು ಅವರಿಗೆ ಆಜ್ಞಾಪಿಸಿದ ಜನಗಳನ್ನು</para>
  <para style="q2" vid="PSA 106:34">ಅವರು ದಂಡಿಸದೆ ಹೋದರು.<verse eid="PSA 106:34"/></para>
  <para style="q1">
    <verse number="35" style="v" sid="PSA 106:35"/>ಆದರೆ ಇತರ ಜನಾಂಗಗಳ ಸಂಗಡ ಕೂಡಿಕೊಂಡು,</para>
  <para style="q2" vid="PSA 106:35">ಅವರ ಪದ್ಧತಿಗಳನ್ನು ಕಲಿತುಕೊಂಡರು.<verse eid="PSA 106:35"/></para>
  <para style="q1">
    <verse number="36" style="v" sid="PSA 106:36"/>ಅವರ ವಿಗ್ರಹಗಳಿಗೆ ಆರಾಧನೆ ಮಾಡಿದರು;</para>
  <para style="q2" vid="PSA 106:36">ಅವು ಅವರಿಗೆ ಉರುಲಿನಂತಾದವು.<verse eid="PSA 106:36"/></para>
  <para style="q1">
    <verse number="37" style="v" sid="PSA 106:37"/>ತಮ್ಮ ಗಂಡು ಮಕ್ಕಳನ್ನೂ,</para>
  <para style="q2" vid="PSA 106:37">ಹೆಣ್ಣು ಮಕ್ಕಳನ್ನೂ ಸುಳ್ಳು ದೇವರುಗಳಿಗೆ ಬಲಿಕೊಟ್ಟರು.<verse eid="PSA 106:37"/></para>
  <para style="q1">
    <verse number="38" style="v" sid="PSA 106:38"/>ಇದಲ್ಲದೆ ತಮ್ಮ ಗಂಡು ಹೆಣ್ಣು ಮಕ್ಕಳ</para>
  <para style="q2" vid="PSA 106:38">ನಿರಪರಾಧದ ರಕ್ತವನ್ನು ಚೆಲ್ಲಿ,</para>
  <para style="q1" vid="PSA 106:38">ಕಾನಾನಿನ ವಿಗ್ರಹಗಳಿಗೆ ಅರ್ಪಿಸಿ,</para>
  <para style="q2" vid="PSA 106:38">ದೇಶವನ್ನು ರಕ್ತದಿಂದ ಅಶುದ್ಧ ಮಾಡಿದರು.<verse eid="PSA 106:38"/></para>
  <para style="q1">
    <verse number="39" style="v" sid="PSA 106:39"/>ಹೀಗೆ ತಮ್ಮ ದುಷ್ಕೃತ್ಯಗಳಿಂದ ತಮ್ಮನ್ನು ಅಪವಿತ್ರ ಮಾಡಿಕೊಂಡು,</para>
  <para style="q2" vid="PSA 106:39">ತಮ್ಮ ಕ್ರಿಯೆಗಳಿಂದ ದುರಾಚಾರಿಗಳಾದರು.<verse eid="PSA 106:39"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="40" style="v" sid="PSA 106:40"/>ಆಗ ಯೆಹೋವ ದೇವರು ತಮ್ಮ ಜನರ ಮೇಲೆ ಬಹು ಬೇಸರಗೊಂಡರು.</para>
  <para style="q2" vid="PSA 106:40">ದೇವರು ತಮ್ಮ ವಾರಸುದಾರರಾದ ಇಸ್ರಾಯೇಲರ ಮೇಲೆ ಅಸಂತೋಷಗೊಂಡು,<verse eid="PSA 106:40"/></para>
  <para style="q1">
    <verse number="41" style="v" sid="PSA 106:41"/>ಅವರನ್ನು ಇತರ ಜನಾಂಗಗಳ ಕೈಗೆ ಒಪ್ಪಿಸಿಕೊಟ್ಟರು.</para>
  <para style="q2" vid="PSA 106:41">ಹೀಗೆ ಅವರ ವೈರಿಗಳು ಅವರನ್ನು ಆಳಿದರು.<verse eid="PSA 106:41"/></para>
  <para style="q1">
    <verse number="42" style="v" sid="PSA 106:42"/>ಅವರ ಶತ್ರುಗಳು ಅವರನ್ನು ಬಾಧೆಪಡಿಸಿದರು;</para>
  <para style="q2" vid="PSA 106:42">ಅವರ ಕೈಕೆಳಗೆ ಅವರು ಅಧೀನರಾದರು.<verse eid="PSA 106:42"/></para>
  <para style="q1">
    <verse number="43" style="v" sid="PSA 106:43"/>ಅನೇಕ ಸಾರಿ ದೇವರು ಇಸ್ರಾಯೇಲರನ್ನು ಬಿಡಿಸಿದರು,</para>
  <para style="q2" vid="PSA 106:43">ಆದರೆ ಅವರು ತಿರುಗಿಬೀಳುತ್ತಲೇ ಇದ್ದರು;</para>
  <para style="q2" vid="PSA 106:43">ತಮ್ಮ ಅಕ್ರಮದಿಂದಲೇ ಅವರು ಕುಗ್ಗಿಹೋದರು;<verse eid="PSA 106:43"/></para>
  <para style="q1">
    <verse number="44" style="v" sid="PSA 106:44"/>ಆದರೂ ಅವರ ಕೂಗನ್ನು ದೇವರು ಕೇಳಿದಾಗ ಇಕ್ಕಟ್ಟಿನಲ್ಲಿದ್ದ</para>
  <para style="q2" vid="PSA 106:44">ಅವರ ಮೇಲೆ ಲಕ್ಷ್ಯವಿಟ್ಟು,<verse eid="PSA 106:44"/></para>
  <para style="q1">
    <verse number="45" style="v" sid="PSA 106:45"/>ಅವರಿಗಾಗಿ ತಮ್ಮ ಒಡಂಬಡಿಕೆಯನ್ನು ಜ್ಞಾಪಕಮಾಡಿಕೊಂಡು,</para>
  <para style="q2" vid="PSA 106:45">ತಮ್ಮ ಅತಿಶಯವಾದ ಪ್ರೀತಿಯ ಪ್ರಕಾರ,<verse eid="PSA 106:45"/></para>
  <para style="q1">
    <verse number="46" style="v" sid="PSA 106:46"/>ಅವರನ್ನು ಸೆರೆಹಿಡಿದವರ</para>
  <para style="q2" vid="PSA 106:46">ಕರುಣೆ ತೋರುವಂತೆ ಮಾಡಿದರು.<verse eid="PSA 106:46"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="47" style="v" sid="PSA 106:47"/>ನಮ್ಮ ದೇವರಾದ ಯೆಹೋವ ದೇವರೇ,</para>
  <para style="q2" vid="PSA 106:47">ನಾವು ನಿಮ್ಮ ಪರಿಶುದ್ಧ ಹೆಸರಿಗೆ ಉಪಕಾರಸ್ತುತಿ ಮಾಡಿ,</para>
  <para style="q1" vid="PSA 106:47">ನಿಮ್ಮ ಸ್ತೋತ್ರದಲ್ಲಿ ಜಯಘೋಷ ಮಾಡುವ ಹಾಗೆ,</para>
  <para style="q2" vid="PSA 106:47">ನಮ್ಮನ್ನು ರಕ್ಷಿಸಿರಿ.<verse eid="PSA 106:47"/></para>
  <para style="b"/>
  <para style="b"/>
  <para style="q1">
    <verse number="48" style="v" sid="PSA 106:48"/>ಇಸ್ರಾಯೇಲ್ ದೇವರಾದ ಯೆಹೋವ ದೇವರಿಗೆ</para>
  <para style="q2" vid="PSA 106:48">ಯುಗಯುಗಕ್ಕೂ ಸ್ತುತಿಯುಂಟಾಗಲಿ.</para>
  <para style="b" vid="PSA 106:48"/>
  <para style="q1" vid="PSA 106:48">ಜನರೆಲ್ಲರೂ, “ಆಮೆನ್!” ಎಂದು ಹೇಳಲಿ.</para>
  <para style="b" vid="PSA 106:48"/>
  <para style="q1" vid="PSA 106:48">ನೀವು ಯೆಹೋವ ದೇವರನ್ನು ಸ್ತುತಿಸಿರಿ.<verse eid="PSA 106:48"/></para>
  <chapter eid="PSA 106"/>
  <chapter number="107" style="c" sid="PSA 107"/>
  <para style="ms">ಭಾಗ-5</para>
  <para style="mr">ಕೀರ್ತನೆಗಳು <ref loc="PSA 107-150">107–150</ref></para>
  <para style="cl">ಕೀರ್ತನೆ 107</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 107:1"/>ಯೆಹೋವ ದೇವರನ್ನು ಕೊಂಡಾಡಿರಿ, ಅವರು ಒಳ್ಳೆಯವರು;</para>
  <para style="q2" vid="PSA 107:1">ಅವರ ಪ್ರೀತಿಯು ಯುಗಯುಗಕ್ಕೂ ಇರುವುದು.<verse eid="PSA 107:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 107:2"/>ಯೆಹೋವ ದೇವರು ವಿಮೋಚಿಸಿದವರು ಹಾಗೆ ಹೇಳಲಿ;</para>
  <para style="q2" vid="PSA 107:2">ವೈರಿಯ ಕೈಯಿಂದ ಬಿಡುಗಡೆಯಾದವರು ಆ ಕಥೆಯನ್ನು ಹೇಳಲಿ<verse eid="PSA 107:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 107:3"/>ಪೂರ್ವ, ಪಶ್ಚಿಮ, ಉತ್ತರ, ದಕ್ಷಿಣ</para>
  <para style="q2" vid="PSA 107:3">ದೇಶಗಳಿಂದ ಕೂಡಿಸಿದವರು ಸಹ ಹಾಗೆ ಹೇಳಲಿ.<verse eid="PSA 107:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 107:4"/>ಮರುಭೂಮಿಯಲ್ಲಿಯೂ, ಹಾದಿ ಇಲ್ಲದ ಕಾಡಿನಲ್ಲಿಯೂ ಅಲೆದು,</para>
  <para style="q2" vid="PSA 107:4">ವಾಸಿಸುವುದಕ್ಕೆ ಪಟ್ಟಣವನ್ನು ಕಂಡುಕೊಳ್ಳದೆ ಹೋದರು.<verse eid="PSA 107:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 107:5"/>ಹಸಿದು, ದಾಹಗೊಂಡು</para>
  <para style="q2" vid="PSA 107:5">ಅವರ ಪ್ರಾಣವು ಕುಗ್ಗಿಹೋಯಿತು.<verse eid="PSA 107:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 107:6"/>ಆಗ ಅವರು ಇಕ್ಕಟ್ಟಿನಲ್ಲಿ ಯೆಹೋವ ದೇವರಿಗೆ ಮೊರೆ ಇಟ್ಟರು;</para>
  <para style="q2" vid="PSA 107:6">ದೇವರು ಅವರ ಸಂಕಟಗಳೊಳಗಿಂದ ಅವರನ್ನು ಬಿಡಿಸಿದರು.<verse eid="PSA 107:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 107:7"/>ಜನರು ವಾಸಿಸುವ ಪಟ್ಟಣಕ್ಕೆ ಹೋಗುವಹಾಗೆ,</para>
  <para style="q2" vid="PSA 107:7">ಜನರನ್ನು ಸರಿಯಾದ ಹಾದಿಯಲ್ಲಿ ನಡೆಸಿದರು.<verse eid="PSA 107:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 107:8"/>ಅವರು ಯೆಹೋವ ದೇವರನ್ನು ಒಡಂಬಡಿಕೆಯ ಪ್ರೀತಿಗೋಸ್ಕರ ಉಪಕಾರಮಾಡಲಿ,</para>
  <para style="q2" vid="PSA 107:8">ಮಾನವರಿಗೆ ದೇವರು ಮಾಡುವ ಅದ್ಭುತಗಳಿಗೋಸ್ಕರವೂ ಕೊಂಡಾಡಲಿ.<verse eid="PSA 107:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 107:9"/>ದೇವರು ದಾಹಪಟ್ಟ ಪ್ರಾಣವನ್ನು ತೃಪ್ತಿಪಡಿಸಿ,</para>
  <para style="q2" vid="PSA 107:9">ಹಸಿದ ಪ್ರಾಣವನ್ನು ಒಳ್ಳೆಯದರಿಂದ ತುಂಬಿಸಿದ್ದಾರೆ.<verse eid="PSA 107:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 107:10"/>ಕೆಲವರು ಕತ್ತಲಲ್ಲಿ ಮತ್ತು ಮರಣದ ನೆರಳಿನಲ್ಲಿ ಕುಳಿತರು, ಕೆಲವರು ಸಂಕಟದಲ್ಲಿಯೂ,</para>
  <para style="q2" vid="PSA 107:10">ಕಬ್ಬಿಣದ ಬೇಡಿಗಳಲ್ಲಿ ಬಂಧಿತರಾಗಿ ಸೆರೆಬಿದ್ದವರು ಕೆಲವರು.<verse eid="PSA 107:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 107:11"/>ಅವರು ದೇವರ ಮಾತುಗಳನ್ನು ಎದುರಿಸಿ,</para>
  <para style="q2" vid="PSA 107:11">ಮಹೋನ್ನತರ ಯೋಜನೆಯ ಬಗ್ಗೆ ಹೀನೈಯಿಸಿದ್ದರಿಂದ ಅವರಿಗೆ ಹಾಗಾಯಿತು.<verse eid="PSA 107:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 107:12"/>ದೇವರು ಅವರ ಹೃದಯವನ್ನು</para>
  <para style="q2" vid="PSA 107:12">ಕಷ್ಟದಿಂದ ತಗ್ಗಿಸಿದಾಗ ಸಹಾಯಕನಿಲ್ಲದೆ ಕೆಳಗೆ ಬಿದ್ದರು.<verse eid="PSA 107:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 107:13"/>ಆಗ ಅವರು ಇಕ್ಕಟ್ಟಿನಲ್ಲಿ ಯೆಹೋವ ದೇವರಿಗೆ ಮೊರೆ ಇಟ್ಟರು;</para>
  <para style="q2" vid="PSA 107:13">ದೇವರು ಅವರ ಸಂಕಟಗಳೊಳಗಿಂದ ಅವರನ್ನು ರಕ್ಷಿಸಿದರು.<verse eid="PSA 107:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 107:14"/>ಕತ್ತಲೆಯೊಳಗಿಂದಲೂ, ಮರಣದ ನೆರಳಿನಿಂದಲೂ ದೇವರು</para>
  <para style="q2" vid="PSA 107:14">ಅವರನ್ನು ಹೊರಗೆ ತಂದು ಅವರ ಬಂಧನಗಳನ್ನು ಮುರಿದುಬಿಟ್ಟರು.<verse eid="PSA 107:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 107:15"/>ಅವರು ಯೆಹೋವ ದೇವರನ್ನು ಒಡಂಬಡಿಕೆಯ ಪ್ರೀತಿಗೋಸ್ಕರವೂ,</para>
  <para style="q2" vid="PSA 107:15">ದೇವರು ಮಾನವರಿಗೆ ಮಾಡುವ ಅದ್ಭುತಗಳಿಗೋಸ್ಕರವೂ ಕೊಂಡಾಡಲಿ.<verse eid="PSA 107:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 107:16"/>ದೇವರು ಕಂಚಿನ ಕದಗಳನ್ನು ಮುರಿದು</para>
  <para style="q2" vid="PSA 107:16">ಕಬ್ಬಿಣದ ಅಗುಳಿಗಳನ್ನು ಕಡಿದುಬಿಟ್ಟಿದ್ದಾರೆ.<verse eid="PSA 107:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 107:17"/>ಮೂಢರು ತಮ್ಮ ದ್ರೋಹದಿಂದಲೂ ಕೆಲವರು</para>
  <para style="q2" vid="PSA 107:17">ತಮ್ಮ ಅಕ್ರಮಗಳಿಂದಲೂ ಶ್ರಮೆ ಪಡುತ್ತಾರೆ.<verse eid="PSA 107:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 107:18"/>ಅವರ ಪ್ರಾಣವು ಎಲ್ಲಾ ಆಹಾರಕ್ಕೂ ಅಸಹ್ಯಪಡುವಷ್ಟು ಅಸ್ವಸ್ಥರಾಗುತ್ತಾರೆ.</para>
  <para style="q2" vid="PSA 107:18">ಅವರು ಮರಣದ ಬಾಗಿಲುಗಳಿಗೆ ಸಮೀಪಿಸುತ್ತಾರೆ.<verse eid="PSA 107:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 107:19"/>ಆಗ ಅವರು ಸಹ ಇಕ್ಕಟ್ಟಿನಲ್ಲಿ ಅವರು ಯೆಹೋವ ದೇವರಿಗೆ ಕೂಗಿದರು;</para>
  <para style="q2" vid="PSA 107:19">ದೇವರು ಅವರ ಸಂಕಟಗಳೊಳಗಿಂದ ಅವರನ್ನು ರಕ್ಷಿಸಿದರು.<verse eid="PSA 107:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 107:20"/>ದೇವರು ತಮ್ಮ ವಾಕ್ಯವನ್ನು ಕಳುಹಿಸಿ, ಅವರನ್ನು ಸ್ವಸ್ಥಮಾಡಿದರು;</para>
  <para style="q2" vid="PSA 107:20">ನಾಶನದಿಂದಲೂ ಅವರನ್ನು ತಪ್ಪಿಸಿದರು.<verse eid="PSA 107:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 107:21"/>ಅವರು ಯೆಹೋವ ದೇವರನ್ನು ಒಡಂಬಡಿಕೆಯ ಕುಂದದ ಪ್ರೀತಿಗೋಸ್ಕರವೂ,</para>
  <para style="q2" vid="PSA 107:21">ಅವರು ಮಾನವರಿಗೆ ಮಾಡುವ ಅದ್ಭುತಗಳಿಗೋಸ್ಕರವೂ ಕೊಂಡಾಡಲಿ.<verse eid="PSA 107:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 107:22"/>ಧನ್ಯವಾದ ಬಲಿಗಳನ್ನು ಅರ್ಪಿಸಿ,</para>
  <para style="q2" vid="PSA 107:22">ದೇವರ ಕೆಲಸಗಳನ್ನು ಉತ್ಸಾಹದಿಂದ ಸಾರಲಿ.<verse eid="PSA 107:22"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 107:23"/>ಕೆಲವರು ಹಡಗುಗಳಲ್ಲಿ ಸಮುದ್ರಕ್ಕೆ ಇಳಿದು ಹೋಗುತ್ತಾರೆ.</para>
  <para style="q2" vid="PSA 107:23">ಅವರು ಜಲರಾಶಿಯಲ್ಲಿ ವ್ಯಾಪಾರ ಮಾಡುವವರು,<verse eid="PSA 107:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 107:24"/>ಯೆಹೋವ ದೇವರ ಕೆಲಸಗಳನ್ನೂ,</para>
  <para style="q2" vid="PSA 107:24">ಅಗಾಧ ಜಲದಲ್ಲಿ ದೇವರ ಅದ್ಭುತಗಳನ್ನೂ ಕಾಣುತ್ತಾರೆ.<verse eid="PSA 107:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 107:25"/>ದೇವರು ಆಜ್ಞಾಪಿಸಿ ಬಿರುಗಾಳಿಯನ್ನು ಎಬ್ಬಿಸಿದರು;</para>
  <para style="q2" vid="PSA 107:25">ಅದು ಅದರ ತೆರೆಗಳನ್ನು ಎಬ್ಬಿಸಿತು.<verse eid="PSA 107:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 107:26"/>ಅವರು ಆಕಾಶದವರೆಗೆ ಏರುತ್ತಾರೆ, ತಿರುಗಿ ಅಗಾಧಗಳವರೆಗೆ ಇಳಿಯುತ್ತಾರೆ;</para>
  <para style="q2" vid="PSA 107:26">ಅಪಾಯದಲ್ಲಿ ಅವರ ಪ್ರಾಣವು ಕಳವಳದಿಂದ ಕರಗಿ ಹೋಗುತ್ತದೆ.<verse eid="PSA 107:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 107:27"/>ಅವರು ಅತ್ತಿತ್ತ ತೂಗಾಡಿ ಕುಡುಕರಂತೆ ಓಲಾಡುತ್ತಿದ್ದರು.</para>
  <para style="q2" vid="PSA 107:27">ಅವರ ಜ್ಞಾನವೆಲ್ಲಾ ಮುಗಿದು ಹೋಯಿತು.<verse eid="PSA 107:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 107:28"/>ಆಗ ಅವರು ಸಹ ಇಕ್ಕಟ್ಟಿನಲ್ಲಿ ಯೆಹೋವ ದೇವರಿಗೆ ಮೊರೆಯಿಟ್ಟರು;</para>
  <para style="q2" vid="PSA 107:28">ದೇವರು ಅವರ ಸಂಕಟಗಳೊಳಗಿಂದ ಅವರನ್ನು ಹೊರಗೆ ಬರಮಾಡಿದನು.<verse eid="PSA 107:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="PSA 107:29"/>ದೇವರು ಬಿರುಗಾಳಿಯನ್ನು ಶಾಂತ ಮಾಡಿದರು.</para>
  <para style="q2" vid="PSA 107:29">ಅದರ ತೆರೆಗಳು ನಿಂತುಹೋದವು.<verse eid="PSA 107:29"/></para>
  <para style="q1">
    <verse number="30" style="v" sid="PSA 107:30"/>ಅವು ಶಾಂತವಾದಾಗ ಜನರು ಸಂತೋಷಪಟ್ಟರು.</para>
  <para style="q2" vid="PSA 107:30">ಹೀಗೆ ಅವರು ಅಪೇಕ್ಷಿಸಿದ ಬಂದರಿಗೆ ದೇವರು ಅವರನ್ನು ನಡೆಸಿದರು.<verse eid="PSA 107:30"/></para>
  <para style="q1">
    <verse number="31" style="v" sid="PSA 107:31"/>ಅವರು ಯೆಹೋವ ದೇವರನ್ನು ಒಡಂಬಡಿಕೆಯ ಪ್ರೀತಿಗೋಸ್ಕರವೂ,</para>
  <para style="q2" vid="PSA 107:31">ಅವರು ಮಾನವರಿಗೆ ಮಾಡುವ ಅದ್ಭುತಗಳಿಗೋಸ್ಕರವೂ ಕೊಂಡಾಡಲಿ.<verse eid="PSA 107:31"/></para>
  <para style="q1">
    <verse number="32" style="v" sid="PSA 107:32"/>ಜನರ ಸಭೆಯಲ್ಲಿ ದೇವರನ್ನು ಕೊಂಡಾಡಲಿ,</para>
  <para style="q2" vid="PSA 107:32">ಹಿರಿಯರ ಸಭೆಯಲ್ಲಿ ದೇವರನ್ನು ಸ್ತುತಿಸಲಿ.<verse eid="PSA 107:32"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="33" style="v" sid="PSA 107:33"/>ದೇವರು ನದಿಗಳನ್ನು ಮರುಭೂಮಿಯಾಗಿ ಮಾರ್ಪಡಿಸಿದರು,</para>
  <para style="q2" vid="PSA 107:33">ನೀರಿನ ಬುಗ್ಗೆಗಳನ್ನು ದಾಹಗೊಂಡ ಭೂಮಿಯಂತೆ ಮಾಡಿದರು.<verse eid="PSA 107:33"/></para>
  <para style="q1">
    <verse number="34" style="v" sid="PSA 107:34"/>ದೇವರು ಫಲವುಳ್ಳ ಭೂಮಿಯನ್ನು ಬಂಜರಾಗುವಂತೆ ಮಾಡಿದರು.</para>
  <para style="q2" vid="PSA 107:34">ಇದಕ್ಕೆಲ್ಲ ಕಾರಣ ಅದರ ನಿವಾಸಿಗಳ ಕೆಟ್ಟತನವೇ ಆಗಿತ್ತು.<verse eid="PSA 107:34"/></para>
  <para style="q1">
    <verse number="35" style="v" sid="PSA 107:35"/>ದೇವರು ಮರುಭೂಮಿಯನ್ನು ನೀರಿನ ಕೆರೆಯಾಗಿಯೂ,</para>
  <para style="q2" vid="PSA 107:35">ಒಣ ಭೂಮಿಯನ್ನು ನೀರಿನ ಬುಗ್ಗೆಗಳಾಗಿಯೂ ಮಾರ್ಪಡಿಸಿದರು.<verse eid="PSA 107:35"/></para>
  <para style="q1">
    <verse number="36" style="v" sid="PSA 107:36"/>ಆದರೆ ದೇವರು ಹಸಿದವರನ್ನು ಒಳ್ಳೆಯ ನಾಡಿಗೆ ನಡೆಸಿದರು;</para>
  <para style="q2" vid="PSA 107:36">ಆ ಜನರು ವಾಸಿಸುವ ಪಟ್ಟಣವನ್ನು ಸ್ಥಾಪಿಸಿದರು.<verse eid="PSA 107:36"/></para>
  <para style="q1">
    <verse number="37" style="v" sid="PSA 107:37"/>ಅವರು ಹೊಲಗಳನ್ನು ಬಿತ್ತಿ, ದ್ರಾಕ್ಷಿಯ ಬಳ್ಳಿಗಳನ್ನು ನೆಟ್ಟರು;</para>
  <para style="q2" vid="PSA 107:37">ಅವು ಹುಟ್ಟುವಳಿಯ ಫಲವನ್ನು ಕೊಡುವವು.<verse eid="PSA 107:37"/></para>
  <para style="q1">
    <verse number="38" style="v" sid="PSA 107:38"/>ದೇವರು ಅವರನ್ನು ಆಶೀರ್ವದಿಸಿದ್ದರಿಂದ, ಅವರು ಬಹಳವಾಗಿ ಹೆಚ್ಚಿದರು;</para>
  <para style="q2" vid="PSA 107:38">ದೇವರು ದನಗಳು ಕಡಿಮೆಯಾಗುವಂತೆ ಮಾಡಲಿಲ್ಲ.<verse eid="PSA 107:38"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="39" style="v" sid="PSA 107:39"/>ಆದರೆ ಜನರು ಸಂಖ್ಯೆಯಲ್ಲಿ ಕಡಿಮೆಯಾಗಿ</para>
  <para style="q2" vid="PSA 107:39">ಚಿಂತೆ ಸಂಕಟದಿಂದ ಕುಗ್ಗಿಹೋದರು.<verse eid="PSA 107:39"/></para>
  <para style="q1">
    <verse number="40" style="v" sid="PSA 107:40"/>ದೇವರು ಅಧಿಪತಿಗಳಿಗೆ ಶಿಸ್ತನ್ನು ನೀಡಿ,</para>
  <para style="q2" vid="PSA 107:40">ಅವರನ್ನು ದಾರಿಯಿಲ್ಲದ ಕಾಡಿನಲ್ಲಿ ಅಲೆಯುವಂತೆ ಮಾಡಿದರು.<verse eid="PSA 107:40"/></para>
  <para style="q1">
    <verse number="41" style="v" sid="PSA 107:41"/>ಆದರೂ ದೇವರು ಬಡವನನ್ನು ಸಂಕಟದಿಂದ ಉನ್ನತಕ್ಕೇರಿಸಿ,</para>
  <para style="q2" vid="PSA 107:41">ಅವನ ಕುಟುಂಬಗಳನ್ನು ಮಂದೆಯ ಹಾಗೆ ಮಾಡಿದರು.<verse eid="PSA 107:41"/></para>
  <para style="q1">
    <verse number="42" style="v" sid="PSA 107:42"/>ನೀತಿವಂತರು ನೋಡಿ ಸಂತೋಷಪಡುವರು;</para>
  <para style="q2" vid="PSA 107:42">ಆದರೆ ಎಲ್ಲಾ ಅಕ್ರಮಗಾರರು ಬಾಯಿ ಮುಚ್ಚಿಕೊಳ್ಳುವರು.<verse eid="PSA 107:42"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="43" style="v" sid="PSA 107:43"/>ಜ್ಞಾನಿಗಳು ಇವುಗಳನ್ನು ಗಮನಿಸಲಿ,</para>
  <para style="q2" vid="PSA 107:43">ಯೆಹೋವ ದೇವರ ಪ್ರೀತಿಕೃತ್ಯಗಳನ್ನು ಗ್ರಹಿಸಿಕೊಳ್ಳಲಿ.<verse eid="PSA 107:43"/></para>
  <chapter eid="PSA 107"/>
  <chapter number="108" style="c" sid="PSA 108"/>
  <para style="cl">ಕೀರ್ತನೆ 108</para>
  <para style="d">ಒಂದು ಗೀತೆ. ದಾವೀದನ ಕೀರ್ತನೆ.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 108:1"/>ದೇವರೇ, ನನ್ನ ಹೃದಯವು ಸ್ಥಿರವಾಗಿದೆ;</para>
  <para style="q2" vid="PSA 108:1">ನಾನು ಮನಃಪೂರ್ವಕವಾಗಿ ಹಾಡುತ್ತಾ, ನಿಮ್ಮ ಕೀರ್ತನೆಯನ್ನು ಮಾಡುವೆನು.<verse eid="PSA 108:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 108:2"/>ವೀಣೆಯೇ, ಕಿನ್ನರಿಯೇ ಎಚ್ಚರವಾಗಿರಿ,</para>
  <para style="q2" vid="PSA 108:2">ನಾನು ಉದಯವನ್ನು ಎಚ್ಚರಗೊಳಿಸುವೆನು.<verse eid="PSA 108:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 108:3"/>ಯೆಹೋವ ದೇವರೇ, ಜನಾಂಗಗಳಲ್ಲಿ ನಾನು ನಿಮ್ಮನ್ನು ಕೊಂಡಾಡುವೆನು.</para>
  <para style="q2" vid="PSA 108:3">ಜನರ ಮಧ್ಯದಲ್ಲಿ ನಿಮ್ಮನ್ನು ಹಾಡಿ ಕೊಂಡಾಡುವೆನು.<verse eid="PSA 108:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 108:4"/>ಆಕಾಶಕ್ಕಿಂತ ನಿಮ್ಮ ಪ್ರೀತಿ ದೊಡ್ಡದು.</para>
  <para style="q2" vid="PSA 108:4">ಮೇಘವನ್ನು ನಿಲುಕುವಷ್ಟು ನಿಮ್ಮ ಸತ್ಯವು ಉನ್ನತವಾಗಿವೆ.<verse eid="PSA 108:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 108:5"/>ಓ, ದೇವರೇ, ಆಕಾಶಗಳ ಮೇಲೆ ನಿಮ್ಮ ಘನವು ಮೆರೆಯಲಿ.</para>
  <para style="q2" vid="PSA 108:5">ಭೂಮಿಯ ಮೇಲೆಲ್ಲಾ ನಿಮ್ಮ ಮಹಿಮೆಯು ಹರಡಲಿ.<verse eid="PSA 108:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 108:6"/>ನೀವು ಪ್ರೀತಿಸುವವರು ಬಿಡುಗಡೆಯಾಗುವಂತೆ</para>
  <para style="q2" vid="PSA 108:6">ನಿಮ್ಮ ಬಲಗೈಯಿಂದ ರಕ್ಷಿಸಿ ನಮಗೆ ಸಹಾಯಮಾಡಿರಿ.<verse eid="PSA 108:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 108:7"/>ದೇವರು ತಮ್ಮ ಪರಿಶುದ್ಧ ಸ್ಥಳದಿಂದ ಹೀಗೆ ನುಡಿದಿದ್ದಾರೆ:</para>
  <para style="q2" vid="PSA 108:7">“ನಾನು ಜಯದಿಂದ ಶೆಕೆಮ್ ಪ್ರದೇಶವನ್ನು ಹಂಚುವೆನು.</para>
  <para style="q2" vid="PSA 108:7">ಸುಕ್ಕೋತಿನ ತಗ್ಗನ್ನು ಅಳತೆ ಮಾಡುವೆನು.<verse eid="PSA 108:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 108:8"/>ಗಿಲ್ಯಾದ್ ನನ್ನದು; ಮನಸ್ಸೆ ನನ್ನದು,</para>
  <para style="q2" vid="PSA 108:8">ಎಫ್ರಾಯೀಮ್ ನನ್ನ ಶಿರಸ್ತ್ರಾಣ,</para>
  <para style="q2" vid="PSA 108:8">ಯೆಹೂದವು ನನ್ನ ರಾಜದಂಡ.<verse eid="PSA 108:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 108:9"/>ಮೋವಾಬ್ ನನ್ನ ಸ್ನಾನ ಪಾತ್ರೆಯು,</para>
  <para style="q2" vid="PSA 108:9">ಎದೋಮ್ ನನ್ನ ಕೆರಗಳ ಸ್ಥಳ.</para>
  <para style="q2" vid="PSA 108:9">ಫಿಲಿಷ್ಟಿಯರ ಮೇಲೆ ಜಯೋತ್ಸಾಹ ಮಾಡುವೆನು.”<verse eid="PSA 108:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 108:10"/>ಕೋಟೆಯ ಪಟ್ಟಣಕ್ಕೆ ನನ್ನನ್ನು ಕರೆತರುವವರು ಯಾರು?</para>
  <para style="q2" vid="PSA 108:10">ಎದೋಮಿಗೆ ನನ್ನನ್ನು ನಡೆಸುವವರು ಯಾರು?<verse eid="PSA 108:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 108:11"/>ದೇವರೇ, ಈಗ ನೀವು</para>
  <para style="q2" vid="PSA 108:11">ನಮ್ಮ ಸೈನ್ಯಗಳ ಸಂಗಡ ಹೊರಡುವುದಿಲ್ಲವೋ ನಮ್ಮನ್ನು ಕೈಬಿಟ್ಟಿದ್ದೀರೋ?<verse eid="PSA 108:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 108:12"/>ವೈರಿಗಳ ವಿರೋಧ ನಮಗೆ ಸಹಾಯಮಾಡಿರಿ.</para>
  <para style="q2" vid="PSA 108:12">ಮನುಷ್ಯರ ಸಹಾಯವು ವ್ಯರ್ಥ.<verse eid="PSA 108:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 108:13"/>ದೇವರಿಂದ ನಾವು ಜಯ ಹೊಂದುವೆವು.</para>
  <para style="q2" vid="PSA 108:13">ದೇವರೇ ನಮ್ಮ ವೈರಿಗಳನ್ನು ತುಳಿದುಬಿಡುವರು.<verse eid="PSA 108:13"/></para>
  <chapter eid="PSA 108"/>
  <chapter number="109" style="c" sid="PSA 109"/>
  <para style="cl">ಕೀರ್ತನೆ 109</para>
  <para style="d">ಸಂಗೀತ ನಿರ್ದೇಶಕನಿಗಾಗಿರುವ ಕೀರ್ತನೆ. ದಾವೀದನ ಕೀರ್ತನೆ.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 109:1"/>ನಾನು ಸ್ತುತಿಸುವ ದೇವರೇ,</para>
  <para style="q2" vid="PSA 109:1">ನೀವು ಮೌನವಾಗಿರಬೇಡಿರಿ.<verse eid="PSA 109:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 109:2"/>ದುಷ್ಟರೂ, ವಂಚಕರೂ ತಮ್ಮ ಬಾಯಿಯನ್ನು</para>
  <para style="q2" vid="PSA 109:2">ನನಗೆ ವಿರೋಧವಾಗಿ ತೆರೆದಿದ್ದಾರೆ;</para>
  <para style="q2" vid="PSA 109:2">ಸುಳ್ಳಿನ ನಾಲಿಗೆಯಿಂದ ನನಗೆ ವಿರೋಧವಾಗಿ ಮಾತಾಡಿದ್ದಾರೆ.<verse eid="PSA 109:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 109:3"/>ದ್ವೇಷ ಮಾತುಗಳಿಂದ ನನ್ನನ್ನು ಸುತ್ತಿಕೊಂಡಿದ್ದಾರೆ,</para>
  <para style="q2" vid="PSA 109:3">ನನಗೆ ವಿರೋಧವಾಗಿ ಕಾರಣವಿಲ್ಲದೆ ಯುದ್ಧ ಮಾಡುತ್ತಿದ್ದಾರೆ.<verse eid="PSA 109:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 109:4"/>ನನ್ನ ಸ್ನೇಹಕ್ಕೆ ಬದಲಾಗಿ ನನ್ನ ಮೇಲೆ ದೂರು ಹೇಳುತ್ತಾರೆ;</para>
  <para style="q2" vid="PSA 109:4">ಆದರೆ ನಾನು ಪ್ರಾರ್ಥನೆಯ ಮನುಷ್ಯನು.<verse eid="PSA 109:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 109:5"/>ನನಗೆ ಉಪಕಾರಕ್ಕೆ ಬದಲಾಗಿ ಕೇಡನ್ನು ಮಾಡುತ್ತಿದ್ದಾರೆ,</para>
  <para style="q2" vid="PSA 109:5">ನನ್ನ ಸ್ನೇಹಕ್ಕೆ ಬದಲಾಗಿ ನನ್ನ ಮೇಲೆ ದೂರು ಹೇಳುತ್ತಾರೆ.<verse eid="PSA 109:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 109:6"/>ದುಷ್ಟನು ನನ್ನ ವೈರಿಯ ಮೇಲೆ ನೇಮಕವಾಗಲಿ;</para>
  <para style="q2" vid="PSA 109:6">ಸೈತಾನನು ಅವನ ಬಲಗಡೆಯಲ್ಲಿ ನಿಂತುಕೊಳ್ಳಲಿ.<verse eid="PSA 109:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 109:7"/>ಅವನಿಗೆ ನ್ಯಾಯತೀರಿಸುವಾಗ ಅಪರಾಧಿಯೆಂದು ತೀರ್ಪು ಹೊಂದಲಿ;</para>
  <para style="q2" vid="PSA 109:7">ಅವನ ಪ್ರಾರ್ಥನೆಯೇ ಅವನನ್ನು ಖಂಡಿಸಲಿ.<verse eid="PSA 109:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 109:8"/>ಅವನ ದಿವಸಗಳು ಸ್ವಲ್ಪವಾಗಿರಲಿ;</para>
  <para style="q2" vid="PSA 109:8">ಅವನ ಹುದ್ದೆಯನ್ನು ಇನ್ನೊಬ್ಬನು ತೆಗೆದುಕೊಳ್ಳಲಿ.<verse eid="PSA 109:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 109:9"/>ಅವನ ಮಕ್ಕಳು ದಿಕ್ಕಿಲ್ಲದವರಾಗಲಿ,</para>
  <para style="q2" vid="PSA 109:9">ಅವನ ಹೆಂಡತಿ ವಿಧವೆಯೂ ಆಗಲಿ.<verse eid="PSA 109:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 109:10"/>ಅವನ ಮಕ್ಕಳು ಅಲೆದು ಅಲೆದು ಭಿಕ್ಷೆಬೇಡಲಿ,</para>
  <para style="q2" vid="PSA 109:10">ತಮ್ಮ ಹಾಳು ಮನೆಯಿಂದ ಹೊರಟು ಹೋಗಲಿ.<verse eid="PSA 109:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 109:11"/>ಸಾಲಗಾರರು ಅವನಿಗೆ ಇರುವುದನ್ನೆಲ್ಲಾ ದೋಚಿಕೊಳ್ಳಲಿ;</para>
  <para style="q2" vid="PSA 109:11">ಪರರು ಅವನ ಕಷ್ಟಾರ್ಜಿತವನ್ನು ಸುಲಿದುಕೊಳ್ಳಲಿ.<verse eid="PSA 109:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 109:12"/>ಅವನಿಗೆ ದಯೆ ತೋರಿಸುವವನು ಯಾವನೂ ಇಲ್ಲದೆ ಇರಲಿ;</para>
  <para style="q2" vid="PSA 109:12">ದಿಕ್ಕಿಲ್ಲದ ಅವನ ಮಕ್ಕಳನ್ನು ಯಾವನೂ ಕನಿಕರಿಸದಿರಲಿ.<verse eid="PSA 109:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 109:13"/>ಅವನ ಸಂತಾನವು ಮುಗಿದು ಹೋಗಲಿ;</para>
  <para style="q2" vid="PSA 109:13">ಎರಡನೆಯ ತಲಾಂತರದಲ್ಲಿ ಅವರ ಹೆಸರು ಅಳಿದು ಹೋಗಲಿ.<verse eid="PSA 109:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 109:14"/>ಅವನ ಪಿತೃಗಳ ಅಕ್ರಮವು ಯೆಹೋವ ದೇವರ ಮುಂದೆ ಜ್ಞಾಪಕವಾಗಲಿ;</para>
  <para style="q2" vid="PSA 109:14">ಅವನ ತಾಯಿಯ ಪಾಪವು ಅಳಿದು ಹೋಗದಿರಲಿ.<verse eid="PSA 109:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 109:15"/>ಅವು ಯಾವಾಗಲೂ ಯೆಹೋವ ದೇವರ ಮುಂದೆ ಇರಲಿ;</para>
  <para style="q2" vid="PSA 109:15">ದೇವರು ಅವರ ನೆನಪನ್ನು ಭೂಮಿಯೊಳಗಿಂದ ತೆಗೆದುಬಿಡಲಿ.<verse eid="PSA 109:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 109:16"/>ಏಕೆಂದರೆ ಅವನು ಯಾರಿಗೂ ದಯೆ ತೋರಿಸಲಿಲ್ಲ.</para>
  <para style="q2" vid="PSA 109:16">ಬಡವನನ್ನೂ, ದೀನನನ್ನೂ,</para>
  <para style="q2" vid="PSA 109:16">ಮನಗುಂದಿದವನನ್ನೂ ಹಿಂಸಿಸಿ ಸಾಯಿಸಬೇಕೆಂದು ಯತ್ನಿಸಿದನು.<verse eid="PSA 109:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 109:17"/>ಅವನು ಶಾಪಕೊಡಲು ಇಷ್ಟಪಟ್ಟನು;</para>
  <para style="q2" vid="PSA 109:17">ಅದೇ ಅವನಿಗೆ ಬರಲಿ;</para>
  <para style="q1" vid="PSA 109:17">ಅವನು ಆಶೀರ್ವಾದವನ್ನು ಮೆಚ್ಚಲಿಲ್ಲ;</para>
  <para style="q2" vid="PSA 109:17">ಅದು ಅವನಿಗೆ ದೂರವಾಗಿರಲಿ.<verse eid="PSA 109:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 109:18"/>ಅವನು ತನ್ನ ವಸ್ತ್ರದಂತೆ ಶಾಪವನ್ನು ಹೊದ್ದುಕೊಂಡನು;</para>
  <para style="q2" vid="PSA 109:18">ಅದು ನೀರಿನಂತೆ ಅವನ ಅಂತರಂಗದಲ್ಲಿಯೂ,</para>
  <para style="q2" vid="PSA 109:18">ಎಣ್ಣೆಯಂತೆ ಅವನ ಎಲುಬುಗಳಲ್ಲಿಯೂ ಸೇರಿತು.<verse eid="PSA 109:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 109:19"/>ಶಾಪವು ಅವನಿಗೆ ತೊಟ್ಟುಕೊಂಡ ಅಂಗಿಯ ಹಾಗೆಯೂ,</para>
  <para style="q2" vid="PSA 109:19">ಯಾವಾಗಲೂ ಸೊಂಟಕ್ಕೆ ಕಟ್ಟುವ ನಡುಕಟ್ಟಿನ ಹಾಗೆಯೂ ಇರಲಿ.<verse eid="PSA 109:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 109:20"/>ಇದು ನನಗೆ ವಿರೋಧವಾಗಿ ಕೇಡು ಮಾತಾಡುವ</para>
  <para style="q2" vid="PSA 109:20">ನನ್ನ ಎದುರಾಳಿಗಳಿಗೆ ಯೆಹೋವ ದೇವರಿಂದ ಪ್ರತಿಫಲವಾಗಿರಲಿ.<verse eid="PSA 109:20"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 109:21"/>ಆದರೆ ಸಾರ್ವಭೌಮ ಯೆಹೋವ ದೇವರೇ,</para>
  <para style="q2" vid="PSA 109:21">ನಿಮ್ಮ ಹೆಸರಿಗೋಸ್ಕರ ನನಗೆ ಸಹಾಯಮಾಡಿರಿ.</para>
  <para style="q2" vid="PSA 109:21">ನಿಮ್ಮ ಪ್ರೀತಿಯ ಒಳ್ಳೆಯತನದಿಂದ ನನ್ನನ್ನು ಬಿಡಿಸಿರಿ.<verse eid="PSA 109:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 109:22"/>ಏಕೆಂದರೆ ನಾನು ಬಡವನೂ ಅಗತ್ಯತೆಯಲ್ಲಿ ಇರುವವನೂ ಆಗಿದ್ದೇನೆ;</para>
  <para style="q2" vid="PSA 109:22">ನನ್ನ ಹೃದಯವು ನನ್ನ ಅಂತರಂಗದಲ್ಲಿ ಗಾಯಗೊಂಡಿದೆ.<verse eid="PSA 109:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 109:23"/>ನಾನು ಇಳಿಯುವ ನೆರಳಿನ ಹಾಗೆ ಆಗಿದ್ದೇನೆ;</para>
  <para style="q2" vid="PSA 109:23">ಮಿಡತೆಯ ಹಾಗೆ ಹಾರಾಡುತ್ತಿದ್ದೇನೆ.<verse eid="PSA 109:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 109:24"/>ನನ್ನ ಮೊಣಕಾಲುಗಳು ಉಪವಾಸದಿಂದ ಬಲಹೀನವಾಗಿವೆ;</para>
  <para style="q2" vid="PSA 109:24">ನನ್ನ ದೇಹಕ್ಕೆ ಸಾರವಿಲ್ಲದೆ ಹೋಯಿತು.<verse eid="PSA 109:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 109:25"/>ನಾನು ನನ್ನ ದೂರುಗಾರರಿಗೆ ನಿಂದೆಯಾಗಿದ್ದೇನೆ;</para>
  <para style="q2" vid="PSA 109:25">ಅವರು ನನ್ನನ್ನು ಕಂಡು ತಮ್ಮ ತಲೆಗಳನ್ನು ಅಲ್ಲಾಡಿಸುತ್ತಾರೆ.<verse eid="PSA 109:25"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 109:26"/>ನನ್ನ ದೇವರಾದ ಯೆಹೋವ ದೇವರೇ, ನನಗೆ ಸಹಾಯಮಾಡಿರಿ;</para>
  <para style="q2" vid="PSA 109:26">ನಿಮ್ಮ ಒಡಂಬಡಿಕೆಯ ಪ್ರೀತಿಯ ಪ್ರಕಾರ ನನ್ನನ್ನು ರಕ್ಷಿಸಿರಿ.<verse eid="PSA 109:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 109:27"/>ಇದು ನಿಮ್ಮ ಕೈ ಕೆಲಸ ಎಂದು ಅವರಿಗೆ ಗೊತ್ತಾಗಲಿ,</para>
  <para style="q2" vid="PSA 109:27">ಇದು ನಿನ್ನಿಂದಲೇ ಆಯಿತೆಂದು ಅವರು ತಿಳಿದುಕೊಳ್ಳಲಿ.<verse eid="PSA 109:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 109:28"/>ಅವರು ಶಪಿಸಲಿ, ಆದರೆ ನೀವು ಆಶೀರ್ವದಿಸಿರಿ.</para>
  <para style="q2" vid="PSA 109:28">ನನಗೆ ಹಾನಿಮಾಡುವವರು ನಾಚಿಕೆಪಡಲಿ;</para>
  <para style="q2" vid="PSA 109:28">ಆದರೆ ನಿಮ್ಮ ಸೇವಕನಾದ ನಾನು ಸಂತೋಷಿಸಲಿ.<verse eid="PSA 109:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="PSA 109:29"/>ನನ್ನ ಎದುರಾಳಿಗಳು ಅವಮಾನವನ್ನು ಹೊದ್ದುಕೊಳ್ಳಲಿ,</para>
  <para style="q2" vid="PSA 109:29">ತಮ್ಮ ನಾಚಿಕೆಯನ್ನು ಹೊದಿಕೆಯಂತೆ ತೊಟ್ಟುಕೊಳ್ಳಲಿ.<verse eid="PSA 109:29"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="30" style="v" sid="PSA 109:30"/>ನಾನು ಯೆಹೋವ ದೇವರನ್ನು ನನ್ನ ಬಾಯಿಯಿಂದ ಬಹಳವಾಗಿ ಕೊಂಡಾಡುವೆನು;</para>
  <para style="q2" vid="PSA 109:30">ಅನೇಕರ ಮಧ್ಯದಲ್ಲಿ ದೇವರನ್ನು ಸ್ತುತಿಸುವೆನು.<verse eid="PSA 109:30"/></para>
  <para style="q1">
    <verse number="31" style="v" sid="PSA 109:31"/>ದೇವರು ಬಡವನ ಬಲಗಡೆಯಲ್ಲಿ ನಿಂತು,</para>
  <para style="q2" vid="PSA 109:31">ಅವನ ಪ್ರಾಣವನ್ನು ಖಂಡಿಸುವವರಿಂದ ಅವನನ್ನು ರಕ್ಷಿಸುವರು.<verse eid="PSA 109:31"/></para>
  <chapter eid="PSA 109"/>
  <chapter number="110" style="c" sid="PSA 110"/>
  <para style="cl">ಕೀರ್ತನೆ 110</para>
  <para style="d">ದಾವೀದನ ಕೀರ್ತನೆ.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 110:1"/>ಯೆಹೋವ ದೇವರು ನನ್ನ ಕರ್ತ ಆಗಿರುವವರಿಗೆ ಹೇಳಿದ್ದೇನೆಂದರೆ:</para>
  <para style="b" vid="PSA 110:1"/>
  <para style="q1" vid="PSA 110:1">“ನಾನು ನಿನ್ನ ವಿರೋಧಿಗಳನ್ನು</para>
  <para style="q2" vid="PSA 110:1">ನಿನ್ನ ಪಾದಗಳ ಪೀಠವಾಗಿ ಮಾಡುವವರೆಗೂ</para>
  <para style="q2" vid="PSA 110:1">ನನ್ನ ಬಲಗಡೆಯಲ್ಲಿ ಕುಳಿತುಕೊಂಡಿರಿ.”<verse eid="PSA 110:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 110:2"/>ನಿಮ್ಮ ಬಲವಾದ ರಾಜದಂಡವನ್ನು ಯೆಹೋವ ದೇವರು ಚೀಯೋನಿನ ಹೊರಗೂ ವಿಸ್ತರಿಸುವರು.</para>
  <para style="q2" vid="PSA 110:2">“ನಿಮ್ಮ ಶತ್ರುಗಳ ಮಧ್ಯದಲ್ಲಿ ದೊರೆತನ ಮಾಡಿರಿ,”</para>
  <para style="q2" vid="PSA 110:2">ಎಂದು ಅವರು ನಿಮಗೆ ಹೇಳುವರು.<verse eid="PSA 110:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 110:3"/>ನೀವು ನಿಮ್ಮ ಸೈನ್ಯವನ್ನು</para>
  <para style="q2" vid="PSA 110:3">ಒಟ್ಟುಗೂಡಿಸುವ ದಿನದಲ್ಲಿ</para>
  <para style="q1" vid="PSA 110:3">ನಿಮ್ಮ ಪ್ರಜೆಗಳು ಸಂತೋಷದಿಂದ ತಾವಾಗಿಯೇ ಸೇರಿಕೊಳ್ಳುವರು.</para>
  <para style="q2" vid="PSA 110:3">ಮುಂಜಾನೆಯ ಉದರದಿಂದ ಬರುವ ಇಬ್ಬನಿಯಂತೆ</para>
  <para style="q2" vid="PSA 110:3">ನಿಮ್ಮ ಯೋಧರು ನಿಮ್ಮ ಕಡೆ ಇಳಿದು ಬರುವರು.<verse eid="PSA 110:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 110:4"/>“ನೀವು ಸದಾಕಾಲವೂ ಮೆಲ್ಕಿಜೆದೇಕನ</para>
  <para style="q2" vid="PSA 110:4">ಕ್ರಮದ ಯಾಜಕರಾಗಿದ್ದೀರಿ,”</para>
  <para style="q1" vid="PSA 110:4">ಎಂದು ಯೆಹೋವ ದೇವರು ಆಣೆಯಿಟ್ಟು ಹೇಳಿದ್ದಾರೆ.</para>
  <para style="q2" vid="PSA 110:4">ಅವರು ತಮ್ಮ ಮನಸ್ಸನ್ನು ಬದಲಾಯಿಸರು.<verse eid="PSA 110:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 110:5"/>ಯೆಹೋವ ದೇವರು ನಿಮ್ಮ ಬಲಗಡೆಯಲ್ಲಿದ್ದಾರೆ;</para>
  <para style="q2" vid="PSA 110:5">ಅವರು ತಮ್ಮ ತೀರ್ಪಿನ ದಿನದಲ್ಲಿ ಅರಸರನ್ನು ದಂಡಿಸುವರು.<verse eid="PSA 110:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 110:6"/>ದೇವರು ಜನಾಂಗಗಳನ್ನು ನ್ಯಾಯತೀರಿಸುವಾಗ,</para>
  <para style="q2" vid="PSA 110:6">ವಿಸ್ತಾರವಾದ ರಣರಂಗದಲ್ಲಿ ಶತ್ರುಗಳನ್ನು ದಂಡಿಸಿ ಅವರಿಗೆ ಮರಣದಂಡನೆ ವಿಧಿಸುವರು.<verse eid="PSA 110:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 110:7"/>ಕರ್ತ ಆಗಿರುವವರು ದಾರಿಯುದ್ದಕ್ಕೂ ಹಳ್ಳದಿಂದ ನೀರು ಕುಡಿಯುತ್ತಾ,</para>
  <para style="q2" vid="PSA 110:7">ಜಯದ ಮಾರ್ಗದಲ್ಲಿ ತಲೆಯೆತ್ತಿ ನಡೆದುಹೋಗುವರು.<verse eid="PSA 110:7"/></para>
  <chapter eid="PSA 110"/>
  <chapter number="111" style="c" sid="PSA 111"/>
  <para style="cl">ಕೀರ್ತನೆ 111<note caller="+" style="f"><char style="fr" closed="false">111 </char><char style="ft" closed="false">ಈ ಕೀರ್ತನೆ, ಹೀಬ್ರೂ ಅಕ್ಷರ ಕ್ರಮಾನುಸಾರವಾದ ಪ್ರಾರ್ಥನೆ.</char></note></para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 111:1"/>ಯೆಹೋವ ದೇವರನ್ನು ಸ್ತುತಿಸಿರಿ.</para>
  <para style="b" vid="PSA 111:1"/>
  <para style="q1" vid="PSA 111:1">ನಾನು ಯೆಹೋವ ದೇವರನ್ನು ಪೂರ್ಣಹೃದಯದಿಂದ</para>
  <para style="q2" vid="PSA 111:1">ಯಥಾರ್ಥರ ಕೂಟದಲ್ಲಿಯೂ, ಸಭೆಯಲ್ಲಿಯೂ ಕೊಂಡಾಡುವೆನು.<verse eid="PSA 111:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 111:2"/>ಯೆಹೋವ ದೇವರ ಕೆಲಸಗಳು ದೊಡ್ಡವು;</para>
  <para style="q2" vid="PSA 111:2">ಅವುಗಳಲ್ಲಿ ಸಂತೋಷ ಪಡುವವರೆಲ್ಲರು ಅವುಗಳನ್ನೇ ಧ್ಯಾನಿಸುತ್ತಾರೆ.<verse eid="PSA 111:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 111:3"/>ದೇವರ ಕೆಲಸವು ಘನತೆಯೂ, ಮಹಿಮೆಯೂ ಉಳ್ಳದ್ದು;</para>
  <para style="q2" vid="PSA 111:3">ದೇವರ ನೀತಿಯು ಎಂದೆಂದಿಗೂ ನಿಲ್ಲುವುದು.<verse eid="PSA 111:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 111:4"/>ದೇವರು ತಮ್ಮ ಅದ್ಭುತಗಳ ಜ್ಞಾಪಕವನ್ನು ಉಳಿದಿರುವಂತೆ ಮಾಡಿದ್ದಾರೆ;</para>
  <para style="q2" vid="PSA 111:4">ಯೆಹೋವ ದೇವರು ಕೃಪೆಯೂ, ಅನುಕಂಪವೂ ಉಳ್ಳವರು.<verse eid="PSA 111:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 111:5"/>ಅವರು ತಮಗೆ ಭಯಪಡುವವರಿಗೆ ಆಹಾರ ಕೊಟ್ಟಿದ್ದಾರೆ;</para>
  <para style="q2" vid="PSA 111:5">ಯುಗಯುಗಕ್ಕೂ ತಮ್ಮ ಒಡಂಬಡಿಕೆಯನ್ನು ಜ್ಞಾಪಕಮಾಡಿಕೊಳ್ಳುವರು.<verse eid="PSA 111:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 111:6"/>ಜನಾಂಗಗಳ ಬಾಧ್ಯತೆಯನ್ನು ಅವರಿಗೆ ಕೊಡುವ ಹಾಗೆ</para>
  <para style="q2" vid="PSA 111:6">ದೇವರು ಶಕ್ತಿಯ ಕ್ರಿಯೆಗಳನ್ನು ತಮ್ಮ ಜನರಿಗೆ ತಿಳಿಸಿದ್ದಾರೆ.<verse eid="PSA 111:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 111:7"/>ದೇವರ ಕೈಕೆಲಸಗಳು ಸತ್ಯವೂ, ನ್ಯಾಯವೂ ಆಗಿವೆ;</para>
  <para style="q2" vid="PSA 111:7">ಅವರ ಸೂತ್ರಗಳೆಲ್ಲಾ ವಿಶ್ವಾಸಕ್ಕೆ ಯೋಗ್ಯವಾದವುಗಳು.<verse eid="PSA 111:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 111:8"/>ಅವು ಯುಗಯುಗಾಂತರಗಳಿಗೂ ನೆಲೆಯಾಗಿ ನಿಲ್ಲುತ್ತವೆ;</para>
  <para style="q2" vid="PSA 111:8">ಅವು ಸತ್ಯದಲ್ಲಿಯೂ, ಯಥಾರ್ಥತೆಯಲ್ಲಿಯೂ ಒಳಗೊಂಡಿರುತ್ತದೆ.<verse eid="PSA 111:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 111:9"/>ದೇವರು ತಮ್ಮ ಜನರಿಗೆ ವಿಮೋಚನೆಯನ್ನು ಕಳುಹಿಸಿದರು;</para>
  <para style="q2" vid="PSA 111:9">ಯುಗಯುಗಕ್ಕೂ ತಮ್ಮ ಒಡಂಬಡಿಕೆಯನ್ನು ಸ್ಥಾಪಿಸಿದ್ದಾರೆ;</para>
  <para style="q2" vid="PSA 111:9">ದೇವರ ಹೆಸರು ಪರಿಶುದ್ಧರು, ಅತಿಶಯರು ಎಂಬುದು.<verse eid="PSA 111:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 111:10"/>ಯೆಹೋವ ದೇವರ ಭಯವು ಜ್ಞಾನದ ಮೂಲವು;</para>
  <para style="q2" vid="PSA 111:10">ಅವರ ಸೂತ್ರಗಳನ್ನು ಕೈಗೊಳ್ಳುವವರಿಗೆ ಒಳ್ಳೆಯ ತಿಳುವಳಿಕೆ ಉಂಟಾಗುವುದು;</para>
  <para style="q2" vid="PSA 111:10">ನಿತ್ಯ ಸ್ತೋತ್ರವು ದೇವರಿಗೆ ಸಲ್ಲಲಿ.<verse eid="PSA 111:10"/></para>
  <chapter eid="PSA 111"/>
  <chapter number="112" style="c" sid="PSA 112"/>
  <para style="cl">ಕೀರ್ತನೆ 112<note caller="+" style="f"><char style="fr" closed="false">112 </char><char style="ft" closed="false">ಈ ಕೀರ್ತನೆ, ಹೀಬ್ರೂ ಅಕ್ಷರ ಕ್ರಮಾನುಸಾರವಾದ ಪ್ರಾರ್ಥನೆ.</char></note></para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 112:1"/>ಯೆಹೋವ ದೇವರನ್ನು ಸ್ತುತಿಸಿರಿ.</para>
  <para style="b" vid="PSA 112:1"/>
  <para style="q1" vid="PSA 112:1">ಯೆಹೋವ ದೇವರಿಗೆ ಭಯಪಟ್ಟು ಅವರ ಆಜ್ಞೆಗಳಲ್ಲಿ ಬಹಳವಾಗಿ</para>
  <para style="q2" vid="PSA 112:1">ಸಂತೋಷಿಸುವವರು ಧನ್ಯರು.<verse eid="PSA 112:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 112:2"/>ಅವರ ಸಂತತಿಯು ಭೂಮಿಯಲ್ಲಿ ಪರಾಕ್ರಮಶಾಲಿಯಾಗಿರುವುದು;</para>
  <para style="q2" vid="PSA 112:2">ಯಥಾರ್ಥರ ಸಂತತಿಯು ಆಶೀರ್ವಾದ ಹೊಂದುವುದು.<verse eid="PSA 112:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 112:3"/>ಧನವೂ, ಐಶ್ವರ್ಯವೂ ಅವರ ಮನೆಯಲ್ಲಿ ಇರುವುದು;</para>
  <para style="q2" vid="PSA 112:3">ಅವರ ನೀತಿಯು ಶಾಶ್ವತವಾಗಿ ಉಳಿಯುವುದು.<verse eid="PSA 112:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 112:4"/>ಯಥಾರ್ಥರಿಗೆ ಕತ್ತಲಲ್ಲಿ ಬೆಳಕು ಮೂಡುವುದು;</para>
  <para style="q2" vid="PSA 112:4">ಅವರು ಕೃಪೆಯೂ, ಅನುಕಂಪವೂ, ನೀತಿಯೂ ಉಳ್ಳವವರಾಗಿರುವರು.<verse eid="PSA 112:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 112:5"/>ದಯೆತೋರಿಸಿ ಸಾಲಕೊಡುವವರಿಗೆ, ಒಳ್ಳೆಯದಾಗುವುದು;</para>
  <para style="q2" vid="PSA 112:5">ಅವರು ತಮ್ಮ ಕಾರ್ಯಗಳನ್ನು ನ್ಯಾಯದಿಂದ ನಡೆಸುವರು.<verse eid="PSA 112:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 112:6"/>ನಿಶ್ಚಯವಾಗಿ ನೀತಿವಂತರು ಎಂದೆಂದಿಗೂ ಕದಲರು;</para>
  <para style="q2" vid="PSA 112:6">ನೀತಿವಂತರು ನಿತ್ಯವಾಗಿ ಜ್ಞಾಪಕದಲ್ಲಿ ಇರುವರು.<verse eid="PSA 112:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 112:7"/>ಅವರಿಗೆ ಅಶುಭದ ಸುದ್ದಿಯ ಭಯ ಇರುವುದಿಲ್ಲ;</para>
  <para style="q2" vid="PSA 112:7">ಅವರ ಹೃದಯವು ಯೆಹೋವ ದೇವರಲ್ಲಿ ಭರವಸವಿಟ್ಟು ಸ್ಥಿರವಾಗಿರುವುದು.<verse eid="PSA 112:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 112:8"/>ಅವರ ಹೃದಯವು ಸುರಕ್ಷಿತವಾಗಿರುವುದು.</para>
  <para style="q2" vid="PSA 112:8">ಅವರು ತಮ್ಮ ವೈರಿಗಳಿಗಾಗುವ ಶಿಕ್ಷೆಯನ್ನು ನೋಡುವರು, ಭಯಪಡರು.<verse eid="PSA 112:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 112:9"/>ಅವರು ಬಡವರಿಗೆ ದಾನಗಳನ್ನು ಧಾರಾಳವಾಗಿ ಹಂಚಿಡುವರು;</para>
  <para style="q2" vid="PSA 112:9">ಅವರ ನೀತಿಯು ಸದಾಕಾಲವೂ ನೆಲೆಯಾಗಿ ಇರುವುದು;</para>
  <para style="q2" vid="PSA 112:9">ಅವನ ಬಲವು ಘನದಿಂದ ಉನ್ನತವಾಗುವುದು.<verse eid="PSA 112:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 112:10"/>ದುಷ್ಟರು ಇದನ್ನು ಕಂಡು ವ್ಯಥೆ ಪಡುವರು;</para>
  <para style="q2" vid="PSA 112:10">ಅವರು ತಮ್ಮ ಹಲ್ಲು ಕಡಿದು ಮರೆಯಾಗಿ ಹೋಗುವರು;</para>
  <para style="q2" vid="PSA 112:10">ದುಷ್ಟರ ಆಶೆಯು ನಾಶವಾಗುವುದು.<verse eid="PSA 112:10"/></para>
  <chapter eid="PSA 112"/>
  <chapter number="113" style="c" sid="PSA 113"/>
  <para style="cl">ಕೀರ್ತನೆ 113</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 113:1"/>ಯೆಹೋವ ದೇವರನ್ನು ಸ್ತುತಿಸಿರಿ.</para>
  <para style="b" vid="PSA 113:1"/>
  <para style="q1" vid="PSA 113:1">ಯೆಹೋವ ದೇವರ ಸೇವಕರೇ,</para>
  <para style="q2" vid="PSA 113:1">ಯೆಹೋವ ದೇವರ ಹೆಸರನ್ನು ಸ್ತುತಿಸಿರಿ.<verse eid="PSA 113:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 113:2"/>ಇಂದಿನಿಂದ ಯುಗಯುಗಕ್ಕೂ</para>
  <para style="q2" vid="PSA 113:2">ಯೆಹೋವ ದೇವರ ಹೆಸರಿಗೆ ಸ್ತುತಿಯುಂಟಾಗಲಿ.<verse eid="PSA 113:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 113:3"/>ಸೂರ್ಯೋದಯದಿಂದ ಅದರ ಅಸ್ತಮಾನದವರೆಗೂ</para>
  <para style="q2" vid="PSA 113:3">ಯೆಹೋವ ದೇವರ ಹೆಸರು ಸ್ತುತಿಹೊಂದತಕ್ಕದ್ದು.<verse eid="PSA 113:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 113:4"/>ಯೆಹೋವ ದೇವರು ಎಲ್ಲಾ ಜನಾಂಗಗಳ ಮೇಲೆ ಉನ್ನತವಾದವರು;</para>
  <para style="q2" vid="PSA 113:4">ಅವರ ಮಹಿಮೆಯು ಆಕಾಶಗಳ ಮೇಲೆ ಮೆರೆಯುತ್ತದೆ.<verse eid="PSA 113:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 113:5"/>ನಮ್ಮ ದೇವರಾದ ಯೆಹೋವ ದೇವರ ಹಾಗೆ ಯಾರು ಇದ್ದಾರೆ?</para>
  <para style="q2" vid="PSA 113:5">ಉನ್ನತಲೋಕದಲ್ಲಿ ಅವರು ವಾಸಿಸುತ್ತಾರೆ.<verse eid="PSA 113:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 113:6"/>ಆಕಾಶವನ್ನೂ, ಭೂಮಿಯನ್ನೂ</para>
  <para style="q2" vid="PSA 113:6">ತಗ್ಗಿಸಿಕೊಂಡು ನೋಡುತ್ತಾರೆ.<verse eid="PSA 113:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 113:7"/>ಧೂಳಿನೊಳಗಿಂದ ದರಿದ್ರರನ್ನು ಎಬ್ಬಿಸುತ್ತಾರೆ,</para>
  <para style="q2" vid="PSA 113:7">ತಿಪ್ಪೆಯೊಳಗಿಂದ ಬಡವರನ್ನು ಎತ್ತುತ್ತಾರೆ.<verse eid="PSA 113:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 113:8"/>ದೇವರು ಅವರನ್ನು ಅಧಿಪತಿಗಳ ಸಂಗಡ ಇರುವಂತೆ ಮಾಡುತ್ತಾರೆ.</para>
  <para style="q2" vid="PSA 113:8">ತಮ್ಮ ಜನರ ಅಧಿಪತಿಗಳ ಸಂಗಡ ಕೂರಿಸುತ್ತಾರೆ.<verse eid="PSA 113:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 113:9"/>ಬಂಜೆಯಾದವಳನ್ನು ಮಕ್ಕಳ ಸೌಭಾಗ್ಯದಲ್ಲಿ ಸಂತೋಷಿಸಿ,</para>
  <para style="q2" vid="PSA 113:9">ಮನೆಯಲ್ಲಿ ನಿವಾಸಿಸುವಂತೆ ಮಾಡುತ್ತಾರೆ.</para>
  <para style="b" vid="PSA 113:9"/>
  <para style="q1" vid="PSA 113:9">ಯೆಹೋವ ದೇವರನ್ನು ಸ್ತುತಿಸಿರಿ.<verse eid="PSA 113:9"/></para>
  <chapter eid="PSA 113"/>
  <chapter number="114" style="c" sid="PSA 114"/>
  <para style="cl">ಕೀರ್ತನೆ 114</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 114:1"/>ಇಸ್ರಾಯೇಲರು ಈಜಿಪ್ಟಿನೊಳಗಿಂದಲೂ,</para>
  <para style="q2" vid="PSA 114:1">ಯಾಕೋಬನ ಮನೆತನವು ಅನ್ಯಭಾಷೆಯುಳ್ಳ ಜನರೊಳಗಿಂದಲೂ ಹೊರಟುಬಂದಾಗ,<verse eid="PSA 114:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 114:2"/>ಯೆಹೂದವು ದೇವರ ಪರಿಶುದ್ಧ ಸ್ಥಳವಾಯಿತು,</para>
  <para style="q2" vid="PSA 114:2">ಇಸ್ರಾಯೇಲು ದೇವರ ರಾಜ್ಯವಾಯಿತು.<verse eid="PSA 114:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 114:3"/>ಸಮುದ್ರವು ನೋಡಿ ಓಡಿಹೋಯಿತು;</para>
  <para style="q2" vid="PSA 114:3">ಯೊರ್ದನ್ ನದಿ ಹಿಂದಿರುಗಿತು.<verse eid="PSA 114:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 114:4"/>ಬೆಟ್ಟಗಳು ಟಗರುಗಳಂತೆ ಓಡಿತು,</para>
  <para style="q2" vid="PSA 114:4">ಗುಡ್ಡಗಳು ಕುರಿಮರಿಗಳಂತೆಯೂ ಓಡಾಡಿದವು.<verse eid="PSA 114:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 114:5"/>ಸಮುದ್ರವೇ, ನಿನಗೆ ಏನಾಯಿತು? ಏಕೆ ಓಡಿ ಹೋಗುತ್ತೀ?</para>
  <para style="q2" vid="PSA 114:5">ಯೊರ್ದನ್ ನದಿಯೇ, ಏಕೆ ಹಿಂದಿರುಗುತ್ತೀ?<verse eid="PSA 114:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 114:6"/>ಬೆಟ್ಟಗಳೇ, ಟಗರುಗಳ ಹಾಗೆಯೂ; ಚಿಕ್ಕಗುಡ್ಡಗಳೇ,</para>
  <para style="q2" vid="PSA 114:6">ನೀವು ಕುರಿಮರಿಗಳ ಹಾಗೆಯೂ ಹಾರಾಡುವುದೇಕೆ?<verse eid="PSA 114:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 114:7"/>ಯೆಹೋವ ದೇವರ ಸನ್ನಿಧಿಯಲ್ಲಿಯೂ,</para>
  <para style="q2" vid="PSA 114:7">ಯಾಕೋಬಿನ ದೇವರ ಮುಂದೆಯೂ ಭೂಮಿಯೇ ನಡುಗು.<verse eid="PSA 114:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 114:8"/>ದೇವರು ಬಂಡೆಯನ್ನು ನೀರಿನ ಕೆರೆಯಾಗಿಯೂ,</para>
  <para style="q2" vid="PSA 114:8">ಕಗ್ಗಲ್ಲನ್ನು ನೀರಿನ ಬುಗ್ಗೆಯಾಗಿ ಮಾರ್ಪಡಿಸುತ್ತಾರೆ.<verse eid="PSA 114:8"/></para>
  <chapter eid="PSA 114"/>
  <chapter number="115" style="c" sid="PSA 115"/>
  <para style="cl">ಕೀರ್ತನೆ 115</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 115:1"/>ನಮಗಲ್ಲ ಯೆಹೋವ ದೇವರೇ, ನಮಗಲ್ಲ,</para>
  <para style="q2" vid="PSA 115:1">ನಿಮ್ಮ ಹೆಸರಿಗೆ ಮಾತ್ರ ಮಹಿಮೆ,</para>
  <para style="q2" vid="PSA 115:1">ನಿಮ್ಮ ಪ್ರೀತಿ ಮತ್ತು ಸತ್ಯತೆಯ ನಿಮಿತ್ತ ನಿಮಗೆ ಮಹಿಮೆಯಾಗಲಿ.<verse eid="PSA 115:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 115:2"/>“ಅವರ ದೇವರು ಎಲ್ಲಿ?” ಎಂದು</para>
  <para style="q2" vid="PSA 115:2">ಜನಾಂಗಗಳು ಏಕೆ ಹೇಳಬೇಕು?<verse eid="PSA 115:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 115:3"/>ನಮ್ಮ ದೇವರು ಪರಲೋಕದಲ್ಲಿದ್ದಾರೆ;</para>
  <para style="q2" vid="PSA 115:3">ಅವರು ಇಚ್ಛಿಸುವುದನ್ನೆಲ್ಲಾ ಮಾಡುತ್ತಾರೆ.<verse eid="PSA 115:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 115:4"/>ಜನರ ವಿಗ್ರಹಗಳು ಬೆಳ್ಳಿ, ಬಂಗಾರದವುಗಳು,</para>
  <para style="q2" vid="PSA 115:4">ಅವು ಮನುಷ್ಯರ ಕೈಯಿಂದ ಮಾಡಲಾಗಿವೆ.<verse eid="PSA 115:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 115:5"/>ಅವುಗಳಿಗೆ ಬಾಯಿಯಿದೆ, ಮಾತನಾಡುವುದಿಲ್ಲ;</para>
  <para style="q2" vid="PSA 115:5">ಕಣ್ಣುಗಳಿವೆ, ಕಾಣುವುದಿಲ್ಲ.<verse eid="PSA 115:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 115:6"/>ಕಿವಿಗಳಿವೆ, ಕೇಳಿಸಿಕೊಳ್ಳುವುದಿಲ್ಲ;</para>
  <para style="q2" vid="PSA 115:6">ಮೂಗು ಉಂಟು, ಮೂಸುವದಿಲ್ಲ.<verse eid="PSA 115:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 115:7"/>ಕೈಗಳುಂಟು, ಮುಟ್ಟುವುದಿಲ್ಲ;</para>
  <para style="q2" vid="PSA 115:7">ಕಾಲುಗಳುಂಟು, ನಡೆಯುವುದಿಲ್ಲ;</para>
  <para style="q2" vid="PSA 115:7">ಅವರ ಗಂಟಲಿನಿಂದ ಧ್ವನಿ ಉಚ್ಚರಿಸಲು ಸಾಧ್ಯವಿಲ್ಲ.<verse eid="PSA 115:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 115:8"/>ಅವುಗಳನ್ನು ಮಾಡುವವರು ಅವುಗಳಂತೆಯೇ ಇದ್ದಾರೆ;</para>
  <para style="q2" vid="PSA 115:8">ಅವುಗಳಲ್ಲಿ ಭರವಸವಿಡುವವರು ಅವುಗಳಂತಾಗುವರು.<verse eid="PSA 115:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 115:9"/>ಇಸ್ರಾಯೇಲರ ಮನೆಯವರೇ, ಯೆಹೋವ ದೇವರಲ್ಲಿ ಭರವಸೆ ಇಡಿರಿ;</para>
  <para style="q2" vid="PSA 115:9">ಅವರೇ ನಿಮ್ಮ ಸಹಾಯವೂ, ಗುರಾಣಿಯೂ ಆಗಿದ್ದಾರೆ.<verse eid="PSA 115:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 115:10"/>ಆರೋನನ ಮನೆಯವರೇ, ಯೆಹೋವ ದೇವರಲ್ಲಿ ಭರವಸೆ ಇಡಿರಿ;</para>
  <para style="q2" vid="PSA 115:10">ಅವರೇ ನಿಮ್ಮ ಸಹಾಯವೂ, ಗುರಾಣಿಯೂ ಆಗಿದ್ದಾರೆ.<verse eid="PSA 115:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 115:11"/>ಯೆಹೋವ ದೇವರಿಗೆ ಭಯಪಡುವವರೇ, ನೀವು ಯೆಹೋವ ದೇವರಲ್ಲಿಯೇ ಭರವಸೆ ಇಡಿರಿ;</para>
  <para style="q2" vid="PSA 115:11">ಅವರೇ ನಿಮ್ಮ ಸಹಾಯವೂ ಗುರಾಣಿಯೂ ಆಗಿದ್ದಾರೆ.<verse eid="PSA 115:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 115:12"/>ಯೆಹೋವ ದೇವರು ನಮ್ಮನ್ನು ಜ್ಞಾಪಕ ಮಾಡಿಕೊಂಡಿದ್ದಾರೆ, ಅವರು ನಮ್ಮನ್ನು ಆಶೀರ್ವದಿಸುವರು;</para>
  <para style="q2" vid="PSA 115:12">ಇಸ್ರಾಯೇಲರ ಮನೆಯನ್ನು ಆಶೀರ್ವದಿಸುವರು;</para>
  <para style="q2" vid="PSA 115:12">ಆರೋನನ ಮನೆಯನ್ನು ಆಶೀರ್ವದಿಸುವರು.<verse eid="PSA 115:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 115:13"/>ಯೆಹೋವ ದೇವರಿಗೆ ಭಯ ಪಡುವವರಾದ ಹಿರಿಯರನ್ನೂ</para>
  <para style="q2" vid="PSA 115:13">ಕಿರಿಯರನ್ನೂ ಬೇಧವಿಲ್ಲದೇ ಆಶೀರ್ವದಿಸುವರು.<verse eid="PSA 115:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 115:14"/>ಯೆಹೋವ ದೇವರು ನಿಮ್ಮನ್ನು ಅಭಿವೃದ್ಧಿಪಡಿಸುವರು</para>
  <para style="q2" vid="PSA 115:14">ನಿಮ್ಮ ಮಕ್ಕಳನ್ನೂ ಅಭಿವೃದ್ಧಿ ಮಾಡುವರು.<verse eid="PSA 115:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 115:15"/>ಆಕಾಶವನ್ನೂ ಭೂಮಿಯನ್ನೂ ಸೃಷ್ಟಿಸಿದ ಯೆಹೋವ ದೇವರಿಂದ</para>
  <para style="q2" vid="PSA 115:15">ನೀವು ಆಶೀರ್ವಾದ ಹೊಂದಿದವರು.<verse eid="PSA 115:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 115:16"/>ಉನ್ನತ ಆಕಾಶಗಳು ಯೆಹೋವ ದೇವರದೇ,</para>
  <para style="q2" vid="PSA 115:16">ಆದರೆ ಅವರು ಭೂಮಿಯನ್ನು ಮಾನವರಿಗೆ ಕೊಟ್ಟಿದ್ದಾರೆ.<verse eid="PSA 115:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 115:17"/>ಸತ್ತವರೂ ಮೌನಲೋಕವನ್ನು ಇಳಿದವರೆಲ್ಲರೂ</para>
  <para style="q2" vid="PSA 115:17">ಯೆಹೋವ ದೇವರನ್ನು ಸ್ತುತಿಸುವುದಿಲ್ಲ.<verse eid="PSA 115:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 115:18"/>ಆದರೆ ನಾವು ಈಗಲೂ</para>
  <para style="q2" vid="PSA 115:18">ಯುಗಯುಗಕ್ಕೂ ಯೆಹೋವ ದೇವರನ್ನು ಸ್ತುತಿಸುವೆವು.</para>
  <para style="b" vid="PSA 115:18"/>
  <para style="q1" vid="PSA 115:18">ಯೆಹೋವ ದೇವರನ್ನು ಸ್ತುತಿಸಿರಿ.<verse eid="PSA 115:18"/></para>
  <chapter eid="PSA 115"/>
  <chapter number="116" style="c" sid="PSA 116"/>
  <para style="cl">ಕೀರ್ತನೆ 116</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 116:1"/>ನಾನು ಯೆಹೋವ ದೇವರನ್ನು ಪ್ರೀತಿಸುತ್ತೇನೆ;</para>
  <para style="q2" vid="PSA 116:1">ಏಕೆಂದರೆ ಅವರು ನನ್ನನ್ನು ಕರುಣಿಸಬೇಕೆಂಬ ನನ್ನ ವಿನಂತಿಯನ್ನೂ ಕೇಳಿದ್ದಾರೆ.<verse eid="PSA 116:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 116:2"/>ಅವರು ನನ್ನ ಸ್ವರಕ್ಕೆ ಕಿವಿಗೊಟ್ಟಿದ್ದರಿಂದ</para>
  <para style="q2" vid="PSA 116:2">ನನ್ನ ಜೀವಮಾನಕಾಲವೆಲ್ಲಾ ಅವರನ್ನು ಬೇಡುವೆನು.<verse eid="PSA 116:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 116:3"/>ಮರಣದ ಪಾಶಗಳು ನನ್ನನ್ನು ಆವರಿಸಿಕೊಂಡವು;</para>
  <para style="q2" vid="PSA 116:3">ನರಕದ ಬಾಧೆಗಳು ನನ್ನ ಮೇಲೆ ಬಂದವು;</para>
  <para style="q2" vid="PSA 116:3">ಇಕ್ಕಟ್ಟೂ ದುಃಖವೂ ನನ್ನನ್ನು ಹಿಡಿದವು.<verse eid="PSA 116:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 116:4"/>ಆಗ ನಾನು, “ಓ ಯೆಹೋವ ದೇವರೇ, ನನ್ನನ್ನು ರಕ್ಷಿಸಿರಿ,”</para>
  <para style="q2" vid="PSA 116:4">ಎಂದು ಯೆಹೋವ ದೇವರ ಹೆಸರಿನಲ್ಲಿ ಬೇಡಿದೆನು.<verse eid="PSA 116:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 116:5"/>ಯೆಹೋವ ದೇವರು ಕೃಪೆಯೂ ನೀತಿಯೂ ಉಳ್ಳವರು</para>
  <para style="q2" vid="PSA 116:5">ನಮ್ಮ ದೇವರು ಅನುಕಂಪ ಭರಿತರು.<verse eid="PSA 116:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 116:6"/>ಯೆಹೋವ ದೇವರು ಸರಳ ಹೃದಯದವರನ್ನು ಕಾಪಾಡುತ್ತಾರೆ;</para>
  <para style="q2" vid="PSA 116:6">ನಾನು ಕೊರತೆಯಲ್ಲಿದ್ದಾಗ, ಅವರು ನನ್ನನ್ನು ರಕ್ಷಿಸಿದರು.<verse eid="PSA 116:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 116:7"/>ನನ್ನ ಮನವೇ, ನೀನು ವಿಶ್ರಾಂತಿಯಿಂದಿರು;</para>
  <para style="q2" vid="PSA 116:7">ಏಕೆಂದರೆ ಯೆಹೋವ ದೇವರು ನಿನಗೆ ಉಪಕಾರಿಯಾಗಿದ್ದಾರೆ.<verse eid="PSA 116:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 116:8"/>ಏಕೆಂದರೆ ಯೆಹೋವ ದೇವರೇ, ನೀವು ನನ್ನನ್ನು ಮರಣಕ್ಕೂ,</para>
  <para style="q2" vid="PSA 116:8">ನನ್ನ ಕಣ್ಣುಗಳನ್ನು ಕಣ್ಣೀರಿಗೂ,</para>
  <para style="q2" vid="PSA 116:8">ನನ್ನ ಪಾದಗಳನ್ನು ಬೀಳದಂತೆಯೂ ತಪ್ಪಿಸಿದ್ದೀರಿ.<verse eid="PSA 116:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 116:9"/>ಆದ್ದರಿಂದ ಜೀವಿತರ ಲೋಕದಲ್ಲಿ</para>
  <para style="q2" vid="PSA 116:9">ಯೆಹೋವ ದೇವರ ಮುಂದೆ ನಡೆದುಕೊಳ್ಳುವೆನು.<verse eid="PSA 116:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 116:10"/>“ನಾನು ಬಹಳ ಕುಗ್ಗಿ ಹೋಗಿದ್ದೇನೆ,”</para>
  <para style="q2" vid="PSA 116:10">ಎಂದು ನಾನು ದೇವರಲ್ಲಿ ಭರವಸೆ ಇಟ್ಟಾಗ ಹೇಳಿದೆ.<verse eid="PSA 116:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 116:11"/>“ಮನುಷ್ಯರೆಲ್ಲರು ಸುಳ್ಳುಗಾರರು,”</para>
  <para style="q2" vid="PSA 116:11">ಎಂದು ನಾನು ನಿರಾಶೆಯಿಂದ ಹೇಳಿದ್ದೆನು.<verse eid="PSA 116:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 116:12"/>ದೇವರು ನನಗೆ ಮಾಡಿದ ಎಲ್ಲಾ ಉಪಕಾರಗಳಿಗೆ ಬದಲಾಗಿ</para>
  <para style="q2" vid="PSA 116:12">ನಾನು ಯೆಹೋವ ದೇವರಿಗೆ ಏನು ಮಾಡಲಿ?<verse eid="PSA 116:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 116:13"/>ನಾನು ರಕ್ಷಣೆಯ ಪಾತ್ರೆಯನ್ನು ತೆಗೆದುಕೊಂಡು,</para>
  <para style="q2" vid="PSA 116:13">ಯೆಹೋವ ದೇವರ ಹೆಸರನ್ನು ಕರೆಯುವೆನು.<verse eid="PSA 116:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 116:14"/>ನಾನು ಹೊತ್ತ ಹರಕೆಗಳನ್ನು</para>
  <para style="q2" vid="PSA 116:14">ದೇವಜನರೆಲ್ಲರ ಮುಂದೆಯೇ ದೇವರಿಗೆ ಸಲ್ಲಿಸುವೆನು.<verse eid="PSA 116:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 116:15"/>ದೇವರ ಭಕ್ತರ ಮರಣವು</para>
  <para style="q2" vid="PSA 116:15">ಯೆಹೋವ ದೇವರ ದೃಷ್ಟಿಯಲ್ಲಿ ಅಮೂಲ್ಯವಾಗಿದೆ.<verse eid="PSA 116:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 116:16"/>ಯೆಹೋವ ದೇವರೇ, ನಿಜವಾಗಿ ನಾನು ನಿಮ್ಮ ಸೇವಕನು;</para>
  <para style="q2" vid="PSA 116:16">ಹೌದು, ನನ್ನ ತಾಯಿ ನಿಮಗೆ ಸೇವೆಮಾಡಿದಂತೆ ನಾನು ಸಹ ನಿಮ್ಮ ಸೇವಕನು;</para>
  <para style="q2" vid="PSA 116:16">ನೀವು ನನ್ನ ಬಂಧನಗಳಿಂದ ನನ್ನನ್ನು ಬಿಡಿಸಿದ್ದೀರಿ.<verse eid="PSA 116:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 116:17"/>ನಾನು ನಿಮಗೆ ಕೃತಜ್ಞತೆಯ ಬಲಿಯನ್ನು ಅರ್ಪಿಸುವೆನು;</para>
  <para style="q2" vid="PSA 116:17">ಯೆಹೋವ ದೇವರ ಹೆಸರನ್ನು ಕರೆಯುವೆನು.<verse eid="PSA 116:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 116:18"/>ಯೆರೂಸಲೇಮೇ, ನನ್ನ ಹರಕೆಗಳನ್ನು</para>
  <para style="q2" vid="PSA 116:18">ದೇವಜನರೆಲ್ಲರ ಮುಂದೆಯೇ ಸಲ್ಲಿಸುವೆನು,<verse eid="PSA 116:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 116:19"/>ಯೆಹೋವ ದೇವರ ಆಲಯದ ಅಂಗಳಗಳಲ್ಲಿ</para>
  <para style="q2" vid="PSA 116:19">ಯೆರೂಸಲೇಮ ಮಧ್ಯದಲ್ಲಿಯೇ ಯೆಹೋವ ದೇವರಿಗೆ ಸಲ್ಲಿಸುವೆನು.</para>
  <para style="b" vid="PSA 116:19"/>
  <para style="q1" vid="PSA 116:19">ಯೆಹೋವ ದೇವರನ್ನು ಸ್ತುತಿಸಿರಿ.<verse eid="PSA 116:19"/></para>
  <chapter eid="PSA 116"/>
  <chapter number="117" style="c" sid="PSA 117"/>
  <para style="cl">ಕೀರ್ತನೆ 117</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 117:1"/>ಎಲ್ಲಾ ದೇಶಗಳೇ, ಯೆಹೋವ ದೇವರನ್ನು ಸ್ತುತಿಸಿರಿ;</para>
  <para style="q2" vid="PSA 117:1">ಸಮಸ್ತ ಜನರೇ, ಯೆಹೋವ ದೇವರನ್ನು ಸ್ತುತಿಸಿರಿ.<verse eid="PSA 117:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 117:2"/>ದೇವರ ಪ್ರೀತಿಯು ನಮ್ಮ ಮೇಲೆ ಅಪಾರವಾಗಿದೆ;</para>
  <para style="q2" vid="PSA 117:2">ಯೆಹೋವ ದೇವರ ಸತ್ಯತೆಯು ಯುಗಯುಗಕ್ಕೂ ಇರುತ್ತದೆ.</para>
  <para style="b" vid="PSA 117:2"/>
  <para style="q1" vid="PSA 117:2">ಯೆಹೋವ ದೇವರನ್ನು ಸ್ತುತಿಸಿರಿ.<verse eid="PSA 117:2"/></para>
  <chapter eid="PSA 117"/>
  <chapter number="118" style="c" sid="PSA 118"/>
  <para style="cl">ಕೀರ್ತನೆ 118</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 118:1"/>ಯೆಹೋವ ದೇವರಿಗೆ ಉಪಕಾರಸ್ತುತಿ ಮಾಡಿರಿ; ಅವರು ಒಳ್ಳೆಯವರು.</para>
  <para style="q2" vid="PSA 118:1">ಅವರ ಪ್ರೀತಿ ಶಾಶ್ವತವಾಗಿರುವುದು.<verse eid="PSA 118:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 118:2"/>“ದೇವರ ಪ್ರೀತಿಯು ಯುಗಯುಗಕ್ಕೂ ಇದೆ,”</para>
  <para style="q2" vid="PSA 118:2">ಎಂದು ಇಸ್ರಾಯೇಲ್ ಹೇಳಲಿ.<verse eid="PSA 118:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 118:3"/>“ದೇವರ ಪ್ರೀತಿಯು ಸದಾಕಾಲವೂ ಇರುವುದು,”</para>
  <para style="q2" vid="PSA 118:3">ಎಂದು ಆರೋನನ ಮನೆಯವರು ಹೇಳಲಿ.<verse eid="PSA 118:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 118:4"/>“ದೇವರ ಪ್ರೀತಿಯು ಸದಾಕಾಲವೂ ಇರುವುದು,”</para>
  <para style="q2" vid="PSA 118:4">ಎಂದು ಯೆಹೋವ ದೇವರಿಗೆ ಭಯಪಡುವವರು ಹೇಳಲಿ.<verse eid="PSA 118:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 118:5"/>ಇಕ್ಕಟ್ಟಿನೊಳಗಿಂದ ಯೆಹೋವ ದೇವರಿಗೆ ಕೂಗಿದೆನು;</para>
  <para style="q2" vid="PSA 118:5">ಯೆಹೋವ ದೇವರು ಉತ್ತರಕೊಟ್ಟು, ನನ್ನನ್ನು ವಿಶಾಲವಾದ ಸ್ಥಳಕ್ಕೆ ತಂದರು.<verse eid="PSA 118:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 118:6"/>ಯೆಹೋವ ದೇವರು ನನ್ನ ಪರವಾಗಿದ್ದಾರೆ, ನಾನು ಭಯಪಡೆನು.</para>
  <para style="q2" vid="PSA 118:6">ಮನುಷ್ಯನು ನನಗೆ ಏನು ಮಾಡಬಲ್ಲನು?<verse eid="PSA 118:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 118:7"/>ಯೆಹೋವ ದೇವರು ನನ್ನೊಂದಿಗಿದ್ದಾರೆ, ಅವರು ನನಗೆ ಸಹಾಯಕರು;</para>
  <para style="q2" vid="PSA 118:7">ನಾನು ವೈರಿಗಳ ಮೇಲೆ ಜಯ ಸಾಧಿಸುವೆನು.<verse eid="PSA 118:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 118:8"/>ಮನುಷ್ಯರಲ್ಲಿ ಭರವಸೆ ಇಡುವುದಕ್ಕಿಂತ</para>
  <para style="q2" vid="PSA 118:8">ಯೆಹೋವ ದೇವರಲ್ಲಿ ಆಶ್ರಯ ಪಡೆಯುವುದು ಒಳ್ಳೆಯದು.<verse eid="PSA 118:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 118:9"/>ಅಧಿಪತಿಗಳಲ್ಲಿ ಭರವಸೆ ಇಡುವುದಕ್ಕಿಂತ</para>
  <para style="q2" vid="PSA 118:9">ಯೆಹೋವ ದೇವರ ಆಶ್ರಯ ಪಡೆಯುವುದು ಒಳ್ಳೆಯದು.<verse eid="PSA 118:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 118:10"/>ಎಲ್ಲಾ ರಾಷ್ಟ್ರದವರು ನನ್ನನ್ನು ಸುತ್ತಿಕೊಂಡರು;</para>
  <para style="q2" vid="PSA 118:10">ಆದರೆ ನಾನು ಯೆಹೋವ ದೇವರ ಹೆಸರಿನಲ್ಲಿ ಅವರನ್ನು ದಂಡಿಸುವೆನು.<verse eid="PSA 118:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 118:11"/>ಅವರು ನನ್ನನ್ನು ಎಲ್ಲಾ ದಿಕ್ಕುಗಳಿಂದ ಸುತ್ತಿಕೊಂಡರು;</para>
  <para style="q2" vid="PSA 118:11">ಯೆಹೋವ ದೇವರ ಹೆಸರಿನಲ್ಲಿ ಅವರನ್ನು ಸೋಲಿಸುವೆನು.<verse eid="PSA 118:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 118:12"/>ಜೇನುನೊಣಗಳ ಹಾಗೆ ನನ್ನನ್ನು ಸುತ್ತಿಕೊಂಡರೂ,</para>
  <para style="q2" vid="PSA 118:12">ಅವರು ಮುಳ್ಳಿನ ಬೆಂಕಿಯ ಹಾಗೆ ಕ್ಷಣಮಾತ್ರದಲ್ಲಿ ಇಲ್ಲವಾಗಿ ಹೋದರು;</para>
  <para style="q2" vid="PSA 118:12">ಯೆಹೋವ ದೇವರ ಹೆಸರಿನಲ್ಲಿ ನಾನು ಅವರನ್ನು ಸೋಲಿಸುವೆನು.<verse eid="PSA 118:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 118:13"/>ನಾನು ಬೀಳುವ ಹಾಗೆ ವೈರಿಯು ನನ್ನನ್ನು ನೂಕಿದನು;</para>
  <para style="q2" vid="PSA 118:13">ಆದರೆ ಯೆಹೋವ ದೇವರು ನನಗೆ ಸಹಾಯ ಮಾಡಿದರು.<verse eid="PSA 118:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 118:14"/>ನನ್ನ ಬಲವೂ, ಬೆಂಬಲವೂ ಯೆಹೋವ ದೇವರೇ;</para>
  <para style="q2" vid="PSA 118:14">ಅವರೇ ನನಗೆ ರಕ್ಷಣೆಯಾದರು.<verse eid="PSA 118:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 118:15"/>ಜಯಘೋಷವೂ ಹರ್ಷಧ್ವನಿಯೂ</para>
  <para style="q2" vid="PSA 118:15">ನೀತಿವಂತರ ಗುಡಾರಗಳಲ್ಲಿ ಪ್ರತಿಧ್ವನಿಸುತ್ತಿರುವುದು;</para>
  <para style="q1" vid="PSA 118:15">ಯೆಹೋವ ದೇವರ ಬಲಗೈ ಪರಾಕ್ರಮವನ್ನು ನಡೆಸಿದೆ.<verse eid="PSA 118:15"/></para>
  <para style="q2">
    <verse number="16" style="v" sid="PSA 118:16"/>ಯೆಹೋವ ದೇವರ ಬಲಗೈ ಎತ್ತರವಾಗಿ ಎತ್ತಲಾಗಿದೆ;</para>
  <para style="q2" vid="PSA 118:16">ಯೆಹೋವ ದೇವರ ಬಲಗೈ ಪರಾಕ್ರಮವನ್ನು ನಡೆಸಿದೆ.<verse eid="PSA 118:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 118:17"/>ನಾನು ಸಾಯದೆ ಬದುಕಿರುವೆನು,</para>
  <para style="q2" vid="PSA 118:17">ಯೆಹೋವ ದೇವರು ಮಾಡಿದ್ದನ್ನು ಸಾರುವೆನು.<verse eid="PSA 118:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 118:18"/>ಏಕೆಂದರೆ ಯೆಹೋವ ದೇವರು ನನ್ನನ್ನು ಕಠಿಣವಾಗಿ ಶಿಕ್ಷಿಸಿದರು;</para>
  <para style="q2" vid="PSA 118:18">ಆದರೆ ಮರಣಕ್ಕೆ ನನ್ನನ್ನು ಒಪ್ಪಿಸಲಿಲ್ಲ.<verse eid="PSA 118:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 118:19"/>ನೀತಿಯ ಬಾಗಿಲುಗಳನ್ನು ನನಗೆ ತೆರೆಯಿರಿ;</para>
  <para style="q2" vid="PSA 118:19">ಅವುಗಳೊಳಗೆ ಪ್ರವೇಶಿಸಿ ಯೆಹೋವ ದೇವರಿಗೆ ಧನ್ಯವಾದ ಸಲ್ಲಿಸು.<verse eid="PSA 118:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 118:20"/>ಇದೇ ಯೆಹೋವ ದೇವರ ಬಾಗಿಲು;</para>
  <para style="q2" vid="PSA 118:20">ನೀತಿವಂತರು ಇದರಲ್ಲಿ ಪ್ರವೇಶಿಸುವರು.<verse eid="PSA 118:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 118:21"/>ನಿಮಗೆ ಕೃತಜ್ಞತಾವಂದನೆ ಸಲ್ಲಿಸುವೆನು;</para>
  <para style="q2" vid="PSA 118:21">ಏಕೆಂದರೆ ನನಗೆ ನೀವು ಉತ್ತರಕೊಟ್ಟು, ನನಗೆ ರಕ್ಷಣೆಯಾದಿರಿ.<verse eid="PSA 118:21"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 118:22"/>ಮನೆ ಕಟ್ಟುವವರು ತಿರಸ್ಕರಿಸಿದ ಕಲ್ಲೇ</para>
  <para style="q2" vid="PSA 118:22">ಮುಖ್ಯವಾದ ಮೂಲೆಗಲ್ಲಾಯಿತು.<verse eid="PSA 118:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 118:23"/>ಇದು ಯೆಹೋವ ದೇವರಿಂದಲೇ ಉಂಟಾಯಿತು;</para>
  <para style="q2" vid="PSA 118:23">ಇದು ನಮ್ಮ ಕಣ್ಣುಗಳಿಗೆ ಆಶ್ಚರ್ಯವಾಯಿತು.<verse eid="PSA 118:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 118:24"/>ಯೆಹೋವ ದೇವರು ಮಾಡಿದ ದಿನವು ಇದೇ;</para>
  <para style="q2" vid="PSA 118:24">ಇದರಲ್ಲಿ ನಾವು ಉಲ್ಲಾಸಿಸಿ ಸಂತೋಷಪಡೋಣ.<verse eid="PSA 118:24"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 118:25"/>ಯೆಹೋವ ದೇವರೇ ನಮ್ಮನ್ನು ರಕ್ಷಿಸಿರಿ,</para>
  <para style="q2" vid="PSA 118:25">ಯೆಹೋವ ದೇವರೇ ನಮಗೆ ಜಯಕೊಡಿರಿ.<verse eid="PSA 118:25"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 118:26"/>ಯೆಹೋವ ದೇವರ ಹೆಸರಿನಲ್ಲಿ ಬರುವವನು ಧನ್ಯನು;</para>
  <para style="q2" vid="PSA 118:26">ಯೆಹೋವ ದೇವರ ಆಲಯದೊಳಗಿಂದ ನಾವು ನಿಮ್ಮನ್ನು ಆಶೀರ್ವದಿಸುವೆವು.<verse eid="PSA 118:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 118:27"/>ಯೆಹೋವ ದೇವರು ದೇವರಾಗಿದ್ದಾನೆ;</para>
  <para style="q2" vid="PSA 118:27">ನಮ್ಮ ಮೇಲೆ ಅವರ ಬೆಳಕನ್ನು ಪ್ರಕಾಶಿಸುವಂತೆ ಮಾಡಿದ್ದಾರೆ.</para>
  <para style="q1" vid="PSA 118:27">ಕೊಂಬೆಗಳನ್ನು ಕೈಯಲ್ಲಿ ಹಿಡಿದುಕೊಂಡು</para>
  <para style="q2" vid="PSA 118:27">ಬಲಿಪೀಠದ ಕೊಂಬುಗಳವರೆಗೆ ಮೆರವಣಿಗೆಯಾಗಿ ಬನ್ನಿರಿ.<verse eid="PSA 118:27"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 118:28"/>ನೀವು ನನ್ನ ದೇವರಾಗಿದ್ದೀರಿ, ನಿಮಗೆ ಉಪಕಾರ ಸಲ್ಲಿಸುವೆನು;</para>
  <para style="q2" vid="PSA 118:28">ನೀವು ನನ್ನ ದೇವರು; ನಿಮ್ಮನ್ನು ನಾನು ಉನ್ನತಪಡಿಸುವೆನು.<verse eid="PSA 118:28"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="29" style="v" sid="PSA 118:29"/>ಯೆಹೋವ ದೇವರಿಗೆ ಕೃತಜ್ಞತಾ ಸ್ತುತಿಮಾಡಿರಿ; ಅವರು ಒಳ್ಳೆಯವರು;</para>
  <para style="q2" vid="PSA 118:29">ಅವರ ಪ್ರೀತಿ ಶಾಶ್ವತವಾಗಿರುವುದು.<verse eid="PSA 118:29"/></para>
  <chapter eid="PSA 118"/>
  <chapter number="119" style="c" sid="PSA 119"/>
  <para style="cl">ಕೀರ್ತನೆ 119<note caller="+" style="f"><char style="fr" closed="false">119:0 </char><char style="ft" closed="false">ದೇವರ ವಾಕ್ಯವನ್ನು ವರ್ಣಿಸುವ ಹಿಬ್ರಿಯ ಅಕ್ಷರ ಕ್ರಮಾನುಸಾರವಾದ ಕೀರ್ತನೆ.</char></note></para>
  <para style="qa">א ಆಲೆಫ್</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 119:1"/>ಯೆಹೋವ ದೇವರ ನಿಯಮಕ್ಕೆ ಅನುಸಾರವಾಗಿದ್ದು,</para>
  <para style="q2" vid="PSA 119:1">ದೋಷರಹಿತ ಮಾರ್ಗದಲ್ಲಿ ನಡೆದುಕೊಳ್ಳುವವರೂ ಧನ್ಯರು.<verse eid="PSA 119:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 119:2"/>ಸಂಪೂರ್ಣ ಹೃದಯದಿಂದ ದೇವರನ್ನು ಹುಡುಕುತ್ತಾ</para>
  <para style="q2" vid="PSA 119:2">ಅವರ ಶಾಸನಗಳನ್ನು ಕೈಗೊಳ್ಳುವವರೂ ಧನ್ಯರು<verse eid="PSA 119:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 119:3"/>ಅಂಥವರು ಅನ್ಯಾಯವನ್ನು ಮಾಡದೆ,</para>
  <para style="q2" vid="PSA 119:3">ದೇವರ ಮಾರ್ಗಗಳಲ್ಲಿ ನಡೆದುಕೊಳ್ಳುವರು.<verse eid="PSA 119:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 119:4"/>ದೇವರೇ, ನಿಮ್ಮ ಸೂತ್ರಗಳನ್ನು ಪೂರ್ಣವಾಗಿ ಕೈಗೊಳ್ಳಬೇಕೆಂದು</para>
  <para style="q2" vid="PSA 119:4">ನೀವು ಆಜ್ಞಾಪಿಸಿದ್ದೀರಿ.<verse eid="PSA 119:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 119:5"/>ನಿಮ್ಮ ತೀರ್ಪುಗಳನ್ನು ಪಾಲಿಸುವುದರಲ್ಲಿ</para>
  <para style="q2" vid="PSA 119:5">ನನ್ನ ಮಾರ್ಗಗಳು ಸ್ಥಿರವಾಗಿರಲಿ!<verse eid="PSA 119:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 119:6"/>ನಿಮ್ಮ ಎಲ್ಲಾ ಅಪ್ಪಣೆಗಳನ್ನು ಪರಿಗಣಿಸುವಾಗ</para>
  <para style="q2" vid="PSA 119:6">ನಾನು ನಾಚಿಕೆಗೆ ಗುರಿಯಾಗುವುದಿಲ್ಲ.<verse eid="PSA 119:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 119:7"/>ನಾನು ನಿಮ್ಮ ನೀತಿಯುಳ್ಳ ನಿಯಮಗಳನ್ನು ಕಲಿಯುತ್ತಿರುವಾಗೆಲ್ಲಾ,</para>
  <para style="q2" vid="PSA 119:7">ಯಥಾರ್ಥ ಹೃದಯದಿಂದ ನಿಮ್ಮನ್ನು ಕೊಂಡಾಡುವೆನು.<verse eid="PSA 119:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 119:8"/>ನಾನು ನಿಮ್ಮ ತೀರ್ಪುಗಳನ್ನು ಪಾಲಿಸುವೆನು;</para>
  <para style="q2" vid="PSA 119:8">ನನ್ನನ್ನು ಸಂಪೂರ್ಣವಾಗಿ ಕೈಬಿಡಬೇಡಿರಿ.<verse eid="PSA 119:8"/></para>
  <para style="qa">ב ಬೇತ್</para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 119:9"/>ಯೌವನಸ್ಥನು ಯಾವುದರಿಂದ ತನ್ನ ನಡತೆಯನ್ನು ಶುದ್ಧವಾಗಿಟ್ಟುಕೊಳ್ಳುವನು?</para>
  <para style="q2" vid="PSA 119:9">ನಿಮ್ಮ ವಾಕ್ಯದ ಪ್ರಕಾರ ಜೀವಿಸುವುದರಿಂದಲೇ.<verse eid="PSA 119:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 119:10"/>ನನ್ನ ಪೂರ್ಣಹೃದಯದಿಂದ ನಿಮ್ಮನ್ನು ಹುಡುಕಿದ್ದೇನೆ;</para>
  <para style="q2" vid="PSA 119:10">ನಿಮ್ಮ ಆಜ್ಞೆಗಳಿಂದ ನಾನು ತಪ್ಪಿಹೋಗದಂತೆ ಮಾಡಿರಿ.<verse eid="PSA 119:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 119:11"/>ನಿಮಗೆ ವಿರೋಧವಾಗಿ ಪಾಪಮಾಡದ ಹಾಗೆ</para>
  <para style="q2" vid="PSA 119:11">ನನ್ನ ಹೃದಯದಲ್ಲಿ ನಿಮ್ಮ ವಾಕ್ಯವನ್ನು ಬಚ್ಚಿಟ್ಟುಕೊಂಡಿದ್ದೇನೆ.<verse eid="PSA 119:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 119:12"/>ಯೆಹೋವ ದೇವರೇ, ನಿಮಗೆ ಸ್ತುತಿಯುಂಟಾಗಲಿ;</para>
  <para style="q2" vid="PSA 119:12">ನಿಮ್ಮ ತೀರ್ಪುಗಳನ್ನು ನನಗೆ ಕಲಿಸಿಕೊಡಿರಿ.<verse eid="PSA 119:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 119:13"/>ನಿಮ್ಮ ಬಾಯಿಂದ ಬರುವ ನಿಯಮಗಳನ್ನೆಲ್ಲಾ</para>
  <para style="q2" vid="PSA 119:13">ನನ್ನ ತುಟಿಗಳಿಂದ ನಾನು ವರ್ಣಿಸಿದ್ದೇನೆ.<verse eid="PSA 119:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 119:14"/>ಮಹಾ ಸಂಪತ್ತಿನಲ್ಲಿ ಒಬ್ಬ ವ್ಯಕ್ತಿ ಆನಂದಿಸುವ ಹಾಗೆ</para>
  <para style="q2" vid="PSA 119:14">ನಾನು ನಿಮ್ಮ ಶಾಸನಗಳನ್ನು ಅನುಸರಿಸುವುದರಲ್ಲಿ ಆನಂದಿಸುವೆನು.<verse eid="PSA 119:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 119:15"/>ನಿಮ್ಮ ಸೂತ್ರಗಳನ್ನು ಧ್ಯಾನಮಾಡಿ,</para>
  <para style="q2" vid="PSA 119:15">ನಿಮ್ಮ ಮಾರ್ಗಗಳನ್ನು ದೃಷ್ಟಿಸುವೆನು.<verse eid="PSA 119:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 119:16"/>ನಿಮ್ಮ ತೀರ್ಪುಗಳಲ್ಲಿ ಉಲ್ಲಾಸಗೊಂಡು,</para>
  <para style="q2" vid="PSA 119:16">ನಿಮ್ಮ ವಾಕ್ಯವನ್ನು ತಿರಸ್ಕರಿಸದಿರುವೆನು.<verse eid="PSA 119:16"/></para>
  <para style="qa">ג ಗಿಮೆಲ್</para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 119:17"/>ನಾನು ಜೀವದಿಂದಿದ್ದು ನಿಮ್ಮ ವಾಕ್ಯವನ್ನು ಕೈಗೊಳ್ಳುವಂತೆ</para>
  <para style="q2" vid="PSA 119:17">ನಿಮ್ಮ ಸೇವಕನ ಮೇಲೆ ದಯೆಯಿಡಿರಿ.<verse eid="PSA 119:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 119:18"/>ನಿಮ್ಮ ನಿಯಮದೊಳಗಿನ ಅದ್ಭುತಗಳನ್ನು ಕಾಣುವಂತೆ</para>
  <para style="q2" vid="PSA 119:18">ನನ್ನ ಕಣ್ಣುಗಳನ್ನು ತೆರೆಯಿರಿ.<verse eid="PSA 119:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 119:19"/>ಈ ಭೂಮಿಯಲ್ಲಿ ನಾನೊಬ್ಬ ಪ್ರವಾಸಿಯಾಗಿದ್ದೇನೆ;</para>
  <para style="q2" vid="PSA 119:19">ನಿಮ್ಮ ಆಜ್ಞೆಗಳನ್ನು ನನಗೆ ಮರೆಮಾಡಬೇಡಿರಿ.<verse eid="PSA 119:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 119:20"/>ನಿಮ್ಮ ನಿಯಮಗಳನ್ನು ಯಾವಾಗಲೂ ಹಂಬಲಿಸುತ್ತಿರುವುದರಿಂದ,</para>
  <para style="q2" vid="PSA 119:20">ನನ್ನ ಪ್ರಾಣವು ಕರಗಿಹೋಗುತ್ತಿದೆ.<verse eid="PSA 119:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 119:21"/>ನಿಮ್ಮ ಆಜ್ಞೆಗಳನ್ನು ಅನುಸರಿಸದೆ ತಪ್ಪಿಹೋಗುವ ಶಾಪಗ್ರಸ್ತರಾದ</para>
  <para style="q2" vid="PSA 119:21">ಗರ್ವಿಷ್ಠರನ್ನು ನೀವು ಗದರಿಸುತ್ತೀರಿ.<verse eid="PSA 119:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 119:22"/>ನಾನು ನಿಮ್ಮ ಶಾಸನಗಳನ್ನು ಕೈಗೊಂಡ ಕಾರಣ,</para>
  <para style="q2" vid="PSA 119:22">ಗರ್ವಿಷ್ಠರ ನಿಂದೆಯನ್ನೂ, ತಿರಸ್ಕಾರವನ್ನೂ ನನ್ನಿಂದ ತೊಲಗಿಸಿರಿ.<verse eid="PSA 119:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 119:23"/>ಅಧಿಕಾರಿಗಳು ನನಗೆ ವಿರೋಧವಾಗಿ ಕುಳಿತುಕೊಂಡು ಮಾತನಾಡಿಕೊಂಡರೂ,</para>
  <para style="q2" vid="PSA 119:23">ನಿಮ್ಮ ಸೇವಕನು ನಿಮ್ಮ ತೀರ್ಪುಗಳನ್ನೇ ಧ್ಯಾನಿಸುತ್ತಿರುವೆನು.<verse eid="PSA 119:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 119:24"/>ನಿಮ್ಮ ಶಾಸನಗಳು ನನಗೆ ಉಲ್ಲಾಸಕರವಾಗಿವೆ;</para>
  <para style="q2" vid="PSA 119:24">ಅವೇ ನನ್ನ ಸಮಾಲೋಚಕರು.<verse eid="PSA 119:24"/></para>
  <para style="qa">ד ದಾಲಿತ್</para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 119:25"/>ನಾನು ಧೂಳಿನಲ್ಲಿ ಬಿದ್ದಿದ್ದೇನೆ;</para>
  <para style="q2" vid="PSA 119:25">ನಿಮ್ಮ ವಾಕ್ಯದ ಪ್ರಕಾರ ನನ್ನನ್ನು ಉಜ್ಜೀವಿಸಿರಿ.<verse eid="PSA 119:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 119:26"/>ನಾನು ನನ್ನ ಮಾರ್ಗಗಳನ್ನು ಲೆಕ್ಕ ಒಪ್ಪಿಸಲು,</para>
  <para style="q2" vid="PSA 119:26">ನೀವು ನನಗೆ ಸದುತ್ತರವನ್ನು ಕೊಟ್ಟಿರುವಿರಿ;</para>
  <para style="q2" vid="PSA 119:26">ನಿಮ್ಮ ತೀರ್ಪುಗಳನ್ನು ನನಗೆ ಕಲಿಸಿಕೊಡಿರಿ.<verse eid="PSA 119:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 119:27"/>ನಿಮ್ಮ ಸೂತ್ರಗಳ ಮಾರ್ಗವನ್ನು ನಾನು ಅರ್ಥಮಾಡಿಕೊಳ್ಳಲು ಸಹಾಯಿಸಿರಿ,</para>
  <para style="q2" vid="PSA 119:27">ಆಗ ನಿಮ್ಮ ಅದ್ಭುತಕಾರ್ಯಗಳನ್ನು ಧ್ಯಾನ ಮಾಡುವೆನು.<verse eid="PSA 119:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 119:28"/>ನನ್ನ ಪ್ರಾಣವು ದುಃಖದಿಂದ ಬಲಹೀನವಾಗಿದೆ;</para>
  <para style="q2" vid="PSA 119:28">ನಿಮ್ಮ ವಾಕ್ಯದಿಂದ ನನ್ನನ್ನು ಬಲಪಡಿಸಿರಿ.<verse eid="PSA 119:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="PSA 119:29"/>ವಂಚನೆಯುಳ್ಳ ಮಾರ್ಗದಿಂದ ನನ್ನನ್ನು ಕಾಪಾಡಿರಿ;</para>
  <para style="q2" vid="PSA 119:29">ನನಗೆ ಕೃಪೆ ನೀಡಿ ನಿಮ್ಮ ನಿಯಮವನ್ನು ನನಗೆ ಬೋಧನೆ ಮಾಡಿರಿ.<verse eid="PSA 119:29"/></para>
  <para style="q1">
    <verse number="30" style="v" sid="PSA 119:30"/>ನಂಬಿಗಸ್ತಿಕೆಯ ಮಾರ್ಗವನ್ನು ಆರಿಸಿಕೊಂಡಿದ್ದೇನೆ;</para>
  <para style="q2" vid="PSA 119:30">ನಾನು ನಿಮ್ಮ ನಿಯಮಗಳ ಮೇಲೆ ನನ್ನ ಹೃದಯವನ್ನಿಟ್ಟುಕೊಂಡಿದ್ದೇನೆ.<verse eid="PSA 119:30"/></para>
  <para style="q1">
    <verse number="31" style="v" sid="PSA 119:31"/>ಯೆಹೋವ ದೇವರೇ, ನಾನು ನಿಮ್ಮ ಶಾಸನಗಳನ್ನು ಬಿಗಿಯಾಗಿಟ್ಟುಕೊಂಡಿದ್ದೇನೆ;</para>
  <para style="q2" vid="PSA 119:31">ನನ್ನನ್ನು ನಾಚಿಕೆಗೆ ಗುರಿಪಡಿಸಬೇಡಿರಿ.<verse eid="PSA 119:31"/></para>
  <para style="q1">
    <verse number="32" style="v" sid="PSA 119:32"/>ನಿಮ್ಮ ಆಜ್ಞೆಗಳ ಮಾರ್ಗದಲ್ಲಿ ಓಡುವೆನು,</para>
  <para style="q2" vid="PSA 119:32">ಏಕೆಂದರೆ ನೀವು ನನ್ನ ವಿವೇಕವನ್ನು ವಿಸ್ತಾರ ಮಾಡಿದ್ದೀರಿ.<verse eid="PSA 119:32"/></para>
  <para style="qa">ה ಹೇ</para>
  <para style="q1">
    <verse number="33" style="v" sid="PSA 119:33"/>ಯೆಹೋವ ದೇವರೇ, ನಿಮ್ಮ ತೀರ್ಪುಗಳ ವಿವರವನ್ನು ನನಗೆ ಬೋಧಿಸಿರಿ;</para>
  <para style="q2" vid="PSA 119:33">ಆಗ ನಾನು ಅವುಗಳನ್ನು ಅಂತ್ಯದವರೆಗೂ ಹಿಂಬಾಲಿಸುವೆನು.<verse eid="PSA 119:33"/></para>
  <para style="q1">
    <verse number="34" style="v" sid="PSA 119:34"/>ನಿಮ್ಮ ನಿಯಮವನ್ನು ಹಿಂಬಾಲಿಸಿ,</para>
  <para style="q2" vid="PSA 119:34">ಅದನ್ನು ಪೂರ್ಣಹೃದಯದಿಂದ ಕೈಕೊಳ್ಳಲು ನನಗೆ ವಿವೇಚನೆಯನ್ನು ನೀಡಿರಿ.<verse eid="PSA 119:34"/></para>
  <para style="q1">
    <verse number="35" style="v" sid="PSA 119:35"/>ನಿಮ್ಮ ಆಜ್ಞೆಗಳ ಮಾರ್ಗದಲ್ಲಿ ನನ್ನನ್ನು ನಡೆಸಿರಿ,</para>
  <para style="q2" vid="PSA 119:35">ಏಕೆಂದರೆ ನಾನು ಅದರಲ್ಲಿ ಆನಂದಿಸುತ್ತೇನೆ.<verse eid="PSA 119:35"/></para>
  <para style="q1">
    <verse number="36" style="v" sid="PSA 119:36"/>ಸ್ವಾರ್ಥದ ಲಾಭಗಳ ಕಡೆಗಲ್ಲ,</para>
  <para style="q2" vid="PSA 119:36">ಆದರೆ ನಿಮ್ಮ ಶಾಸನಗಳ ಕಡೆಗೆ ನನ್ನ ಹೃದಯವನ್ನು ತಿರುಗಿಸಿರಿ.<verse eid="PSA 119:36"/></para>
  <para style="q1">
    <verse number="37" style="v" sid="PSA 119:37"/>ವ್ಯರ್ಥವಾದವುಗಳಿಂದ ನನ್ನ ಕಣ್ಣುಗಳನ್ನು ತಿರುಗಿಸಿ,</para>
  <para style="q2" vid="PSA 119:37">ನಿಮ್ಮ ವಾಕ್ಯದ ಅನುಸಾರವಾಗಿ ನನ್ನ ಜೀವವನ್ನು ಕಾಪಾಡಿರಿ.<verse eid="PSA 119:37"/></para>
  <para style="q1">
    <verse number="38" style="v" sid="PSA 119:38"/>ನಿಮಗೆ ಭಯಪಡುವವರಿಗಾಗಿ ನೀಡುವ ವಾಗ್ದಾನವನ್ನು</para>
  <para style="q2" vid="PSA 119:38">ನಿಮ್ಮ ಸೇವಕನಿಗೆ ನೆರವೇರಿಸಿರಿ.<verse eid="PSA 119:38"/></para>
  <para style="q1">
    <verse number="39" style="v" sid="PSA 119:39"/>ನಾನು ಭಯಪಡುವ ನನ್ನ ನಿಂದೆಯನ್ನು ನನ್ನಿಂದ ತೊಲಗಿಸಿರಿ,</para>
  <para style="q2" vid="PSA 119:39">ಏಕೆಂದರೆ ನಿಮ್ಮ ನಿಯಮಗಳು ಒಳ್ಳೆಯವುಗಳೇ.<verse eid="PSA 119:39"/></para>
  <para style="q1">
    <verse number="40" style="v" sid="PSA 119:40"/>ಇಗೋ ನಿಮ್ಮ ಸೂತ್ರಗಳಿಗಾಗಿ ನಾನು ಎಷ್ಟೋ ಹಂಬಲಿಸುತ್ತೇನೆ!</para>
  <para style="q2" vid="PSA 119:40">ನಿಮ್ಮ ನೀತಿಗನುಸಾರವಾಗಿ ನನ್ನ ಜೀವವನ್ನು ಕಾಪಾಡಿರಿ.<verse eid="PSA 119:40"/></para>
  <para style="qa">ו ವಾವ್</para>
  <para style="q1">
    <verse number="41" style="v" sid="PSA 119:41"/>ಯೆಹೋವ ದೇವರೇ, ನಿಮ್ಮ ಒಡಂಬಡಿಕೆಯ ಪ್ರೀತಿಯು ನನಗೆ ದೊರಕಲಿ,</para>
  <para style="q2" vid="PSA 119:41">ನಿಮ್ಮ ವಾಗ್ದಾನದ ರಕ್ಷಣೆಯು ನನಗೆ ಉಂಟಾಗಲಿ;<verse eid="PSA 119:41"/></para>
  <para style="q1">
    <verse number="42" style="v" sid="PSA 119:42"/>ಆಗ ನನ್ನನ್ನು ನಿಂದಿಸುವವನಿಗೆ ಉತ್ತರಕೊಡುವೆನು,</para>
  <para style="q2" vid="PSA 119:42">ಏಕೆಂದರೆ ನಾನು ನಿಮ್ಮ ವಾಕ್ಯದಲ್ಲಿ ಭರವಸೆಯಿಟ್ಟಿದ್ದೇನೆ.<verse eid="PSA 119:42"/></para>
  <para style="q1">
    <verse number="43" style="v" sid="PSA 119:43"/>ಸತ್ಯವಾಕ್ಯವನ್ನು ನನ್ನ ಬಾಯಿಂದ ತೆಗೆಯಬೇಡಿರಿ,</para>
  <para style="q2" vid="PSA 119:43">ಏಕೆಂದರೆ ನಿಮ್ಮ ನಿಯಮಗಳಲ್ಲಿ ನಾನು ನನ್ನ ನಿರೀಕ್ಷೆಯನ್ನಿಟ್ಟಿದ್ದೇನೆ.<verse eid="PSA 119:43"/></para>
  <para style="q1">
    <verse number="44" style="v" sid="PSA 119:44"/>ನಾನು ನಿಮ್ಮ ನಿಯಮವನ್ನು ಯಾವಾಗಲೂ</para>
  <para style="q2" vid="PSA 119:44">ಮತ್ತು ಎಂದೆಂದಿಗೂ ಪಾಲಿಸುವೆನು.<verse eid="PSA 119:44"/></para>
  <para style="q1">
    <verse number="45" style="v" sid="PSA 119:45"/>ನಿಮ್ಮ ಸೂತ್ರಗಳನ್ನು ನಾನು ಹುಡುಕುವುದರಿಂದ,</para>
  <para style="q2" vid="PSA 119:45">ನಾನು ಸ್ವತಂತ್ರವಾಗಿಯೇ ಜೀವಿಸುವೆನು.<verse eid="PSA 119:45"/></para>
  <para style="q1">
    <verse number="46" style="v" sid="PSA 119:46"/>ಅರಸರ ಮುಂದೆ ನಿಮ್ಮ ಶಾಸನಗಳನ್ನು ಮಾತಾಡುವೆನು,</para>
  <para style="q2" vid="PSA 119:46">ಅವುಗಳ ಬಗ್ಗೆ ನಾನೆಂದೂ ನಾಚಿಕೆಪಡುವುದಿಲ್ಲ.<verse eid="PSA 119:46"/></para>
  <para style="q1">
    <verse number="47" style="v" sid="PSA 119:47"/>ನಿಮ್ಮ ಆಜ್ಞೆಗಳನ್ನು ನಾನು ಪ್ರೀತಿಸುವುದರಿಂದ,</para>
  <para style="q2" vid="PSA 119:47">ನಾನು ಅವುಗಳಲ್ಲಿ ಆನಂದಿಸುವೆನು.<verse eid="PSA 119:47"/></para>
  <para style="q1">
    <verse number="48" style="v" sid="PSA 119:48"/>ನಾನು ಪ್ರೀತಿಸುವ ನಿಮ್ಮ ಆಜ್ಞೆಗಳ ಕಡೆಗೆ ನನ್ನ ಕೈಗಳನ್ನೆತ್ತಿ,</para>
  <para style="q2" vid="PSA 119:48">ನಿಮ್ಮ ತೀರ್ಪುಗಳನ್ನು ಧ್ಯಾನ ಮಾಡುವೆನು.<verse eid="PSA 119:48"/></para>
  <para style="qa">ז ಸಾಯಿನ್</para>
  <para style="q1">
    <verse number="49" style="v" sid="PSA 119:49"/>ನಿಮ್ಮ ಸೇವಕನಿಗೋಸ್ಕರ ನಿಮ್ಮ ವಾಕ್ಯವನ್ನು ನೀವು ಜ್ಞಾಪಕಮಾಡಿಕೊಳ್ಳಿರಿ,</para>
  <para style="q2" vid="PSA 119:49">ಏಕೆಂದರೆ ನೀವು ನನಗೆ ನಿರೀಕ್ಷೆಯನ್ನು ಕೊಟ್ಟಿದ್ದೀರಿ.<verse eid="PSA 119:49"/></para>
  <para style="q1">
    <verse number="50" style="v" sid="PSA 119:50"/>ನಿಮ್ಮ ವಾಗ್ದಾನವು ನನ್ನ ಜೀವದ ಸಂರಕ್ಷಣೆಯಾಗಿದೆ.</para>
  <para style="q2" vid="PSA 119:50">ಅವು ನನ್ನ ಸಂಕಷ್ಟಗಳಲ್ಲಿ ಆದರಣೆಯಾಗಿವೆ.<verse eid="PSA 119:50"/></para>
  <para style="q1">
    <verse number="51" style="v" sid="PSA 119:51"/>ಅಹಂಕಾರಿಗಳು ನನ್ನನ್ನು ಕರುಣಿಸದೆ ಹಾಸ್ಯ ಮಾಡಿದರೂ,</para>
  <para style="q2" vid="PSA 119:51">ನಾನು ನಿಮ್ಮ ನಿಯಮದಿಂದ ತೊಲಗುವುದಿಲ್ಲ.<verse eid="PSA 119:51"/></para>
  <para style="q1">
    <verse number="52" style="v" sid="PSA 119:52"/>ಯೆಹೋವ ದೇವರೇ, ನಿಮ್ಮ ಪುರಾತನ ನಿಯಮಗಳನ್ನು ನಾನು ನೆನಪು ಮಾಡಿಕೊಂಡು,</para>
  <para style="q2" vid="PSA 119:52">ಅವುಗಳಲ್ಲಿ ಆದರಣೆಯನ್ನು ಪಡೆದುಕೊಂಡಿದ್ದೇನೆ.<verse eid="PSA 119:52"/></para>
  <para style="q1">
    <verse number="53" style="v" sid="PSA 119:53"/>ನಿಮ್ಮ ನಿಯಮವನ್ನು ಬಿಟ್ಟುಬಿಡುವ ದುಷ್ಟರ ನಿಮಿತ್ತ,</para>
  <para style="q2" vid="PSA 119:53">ರೋಷವು ನನ್ನನ್ನು ಆವರಿಸಿಕೊಂಡಿದೆ.<verse eid="PSA 119:53"/></para>
  <para style="q1">
    <verse number="54" style="v" sid="PSA 119:54"/>ನನ್ನ ಪ್ರವಾಸದ ಮನೆಯಲ್ಲಿ</para>
  <para style="q2" vid="PSA 119:54">ನಿಮ್ಮ ತೀರ್ಪುಗಳು ನನಗೆ ಗಾನ ವಿಷಯವಾಗಿದೆ.<verse eid="PSA 119:54"/></para>
  <para style="q1">
    <verse number="55" style="v" sid="PSA 119:55"/>ಯೆಹೋವ ದೇವರೇ, ರಾತ್ರಿಯಲ್ಲಿ ನಿಮ್ಮ ನಾಮಸ್ಮರಣೆ ಮಾಡುವುದರಿಂದ,</para>
  <para style="q2" vid="PSA 119:55">ನಿಮ್ಮ ನಿಯಮವನ್ನು ಕೈಕೊಳ್ಳುತ್ತೇನೆ.<verse eid="PSA 119:55"/></para>
  <para style="q1">
    <verse number="56" style="v" sid="PSA 119:56"/>ನಾನು ನಿಮ್ಮ ಸೂತ್ರಗಳನ್ನು ಕೈಗೊಂಡಿದ್ದೇನೆ:</para>
  <para style="q2" vid="PSA 119:56">ಇದೇ ನನ್ನ ಜೀವನದ ಶೈಲಿಯಾಗಿದೆ.<verse eid="PSA 119:56"/></para>
  <para style="qa">ח ಕೇತ್</para>
  <para style="q1">
    <verse number="57" style="v" sid="PSA 119:57"/>ಯೆಹೋವ ದೇವರೇ, ನೀವೇ ನನ್ನ ಪಾಲು;</para>
  <para style="q2" vid="PSA 119:57">ನಿಮ್ಮ ವಾಕ್ಯಗಳನ್ನು ಪಾಲಿಸುವೆನೆಂದು ನಾನು ಪ್ರಮಾಣ ಮಾಡಿದ್ದೇನೆ.<verse eid="PSA 119:57"/></para>
  <para style="q1">
    <verse number="58" style="v" sid="PSA 119:58"/>ಪೂರ್ಣಹೃದಯದಿಂದ ನಾನು ನಿಮ್ಮ ಮುಖವನ್ನು ಹುಡುಕಿದ್ದೇನೆ;</para>
  <para style="q2" vid="PSA 119:58">ನಿಮ್ಮ ವಾಕ್ಯದ ಪ್ರಕಾರ ನನ್ನನ್ನು ಕರುಣಿಸಿರಿ.<verse eid="PSA 119:58"/></para>
  <para style="q1">
    <verse number="59" style="v" sid="PSA 119:59"/>ನಾನು ನನ್ನ ನಡತೆಯನ್ನು ಪರಿಶೋಧಿಸುತ್ತಾ</para>
  <para style="q2" vid="PSA 119:59">ನನ್ನ ಹೆಜ್ಜೆಗಳನ್ನು ನಿಮ್ಮ ಶಾಸನಗಳ ಕಡೆಗೆ ತಿರುಗಿಸಿದ್ದೇನೆ.<verse eid="PSA 119:59"/></para>
  <para style="q1">
    <verse number="60" style="v" sid="PSA 119:60"/>ನಿಮ್ಮ ಆಜ್ಞೆಗಳನ್ನು ಪಾಲಿಸಲು ನಾನು</para>
  <para style="q2" vid="PSA 119:60">ತಡಮಾಡದೆ ತ್ವರೆಪಟ್ಟಿದ್ದೇನೆ.<verse eid="PSA 119:60"/></para>
  <para style="q1">
    <verse number="61" style="v" sid="PSA 119:61"/>ದುಷ್ಟರ ಪಾಶಗಳು ನನ್ನನ್ನು ಸುತ್ತಿಕೊಂಡಿದ್ದರೂ,</para>
  <para style="q2" vid="PSA 119:61">ನಿಮ್ಮ ನಿಯಮವನ್ನು ನಾನು ಮರೆಯಲಿಲ್ಲ.<verse eid="PSA 119:61"/></para>
  <para style="q1">
    <verse number="62" style="v" sid="PSA 119:62"/>ನಿಮ್ಮ ನೀತಿಯುಳ್ಳ ನಿಯಮಗಳಿಗಾಗಿ</para>
  <para style="q2" vid="PSA 119:62">ನಿಮಗೆ ಕೃತಜ್ಞತೆ ಸಲ್ಲಿಸಲು ಮಧ್ಯರಾತ್ರಿಯಲ್ಲಿ ಏಳುವೆನು.<verse eid="PSA 119:62"/></para>
  <para style="q1">
    <verse number="63" style="v" sid="PSA 119:63"/>ನಿಮಗೆ ಭಯಪಡುವವರೆಲ್ಲರಿಗೂ,</para>
  <para style="q2" vid="PSA 119:63">ನಿಮ್ಮ ಸೂತ್ರಗಳನ್ನು ಹಿಂಬಾಲಿಸುವವರಿಗೂ ನಾನು ಮಿತ್ರನಾಗಿದ್ದೇನೆ.<verse eid="PSA 119:63"/></para>
  <para style="q1">
    <verse number="64" style="v" sid="PSA 119:64"/>ಯೆಹೋವ ದೇವರೇ, ಭೂಮಿಯು ನಿಮ್ಮ ಪ್ರೀತಿಯಿಂದ ತುಂಬಿದೆ;</para>
  <para style="q2" vid="PSA 119:64">ನಿಮ್ಮ ತೀರ್ಪುಗಳನ್ನು ನನಗೆ ಬೋಧಿಸಿರಿ.<verse eid="PSA 119:64"/></para>
  <para style="qa">ט ಟೇತ್</para>
  <para style="q1">
    <verse number="65" style="v" sid="PSA 119:65"/>ಯೆಹೋವ ದೇವರೇ, ನಿಮ್ಮ ವಾಕ್ಯದ ಪ್ರಕಾರ</para>
  <para style="q2" vid="PSA 119:65">ನಿಮ್ಮ ಸೇವಕನಿಗೆ ಒಳ್ಳೆಯದನ್ನು ಮಾಡಿರಿ.<verse eid="PSA 119:65"/></para>
  <para style="q1">
    <verse number="66" style="v" sid="PSA 119:66"/>ತಿಳುವಳಿಕೆಯನ್ನೂ ಒಳ್ಳೆಯ ವಿವೇಚನೆಯನ್ನೂ, ನನಗೆ ಕಲಿಸಿರಿ,</para>
  <para style="q2" vid="PSA 119:66">ಏಕೆಂದರೆ ನಿಮ್ಮ ಆಜ್ಞೆಗಳಲ್ಲಿ ಭರವಸೆ ಇಟ್ಟಿದ್ದೇನೆ.<verse eid="PSA 119:66"/></para>
  <para style="q1">
    <verse number="67" style="v" sid="PSA 119:67"/>ನಾನು ಬಾಧೆಪಡುವುದಕ್ಕಿಂತ ಮುಂಚೆ ದಾರಿತಪ್ಪಿಹೋಗುತ್ತಿದ್ದೆನು,</para>
  <para style="q2" vid="PSA 119:67">ಆದರೆ ಈಗ ನಿಮ್ಮ ವಾಕ್ಯವನ್ನು ಪಾಲಿಸುತ್ತಿದ್ದೇನೆ.<verse eid="PSA 119:67"/></para>
  <para style="q1">
    <verse number="68" style="v" sid="PSA 119:68"/>ನೀವು ಒಳ್ಳೆಯವರೂ, ಒಳ್ಳೆಯದನ್ನು ಮಾಡುವವರೂ ಆಗಿದ್ದೀರಿ;</para>
  <para style="q2" vid="PSA 119:68">ನಿಮ್ಮ ತೀರ್ಪುಗಳನ್ನು ನನಗೆ ಕಲಿಸಿರಿ.<verse eid="PSA 119:68"/></para>
  <para style="q1">
    <verse number="69" style="v" sid="PSA 119:69"/>ಅಹಂಕಾರಿಗಳು ನನಗೆ ವಿರೋಧವಾಗಿ ಸುಳ್ಳು ಕಲ್ಪಿಸಿದರು,</para>
  <para style="q2" vid="PSA 119:69">ನಾನಾದರೋ ಪೂರ್ಣಹೃದಯದಿಂದ ನಿಮ್ಮ ಸೂತ್ರಗಳನ್ನು ಕೈಗೊಳ್ಳುವೆನು.<verse eid="PSA 119:69"/></para>
  <para style="q1">
    <verse number="70" style="v" sid="PSA 119:70"/>ಅವರ ಹೃದಯವು ಕಠಿಣವೂ ಮಂದವೂ ಆಗಿದೆ,</para>
  <para style="q2" vid="PSA 119:70">ನಾನಾದರೋ ನಿಮ್ಮ ನಿಯಮದಲ್ಲಿ ಆನಂದಪಡುತ್ತೇನೆ.<verse eid="PSA 119:70"/></para>
  <para style="q1">
    <verse number="71" style="v" sid="PSA 119:71"/>ನಾನು ಶ್ರಮೆಪಟ್ಟದ್ದು ನನಗೆ ಒಳ್ಳೆಯದಾಯಿತು</para>
  <para style="q2" vid="PSA 119:71">ಅದರಿಂದ ನಿಮ್ಮ ತೀರ್ಪುಗಳನ್ನು ಕಲಿತೆನು.<verse eid="PSA 119:71"/></para>
  <para style="q1">
    <verse number="72" style="v" sid="PSA 119:72"/>ಸಾವಿರಾರು ಬೆಳ್ಳಿಬಂಗಾರ ನಾಣ್ಯಗಳಿಗಿಂತಲೂ</para>
  <para style="q2" vid="PSA 119:72">ನಿಮ್ಮ ಬಾಯಿಯ ನಿಯಮವು ನನಗೆ ಹೆಚ್ಚು ಅಮೂಲ್ಯವಾದದ್ದಾಗಿದೆ.<verse eid="PSA 119:72"/></para>
  <para style="qa">י ಯೋದ್</para>
  <para style="q1">
    <verse number="73" style="v" sid="PSA 119:73"/>ನಿಮ್ಮ ಕೈಗಳು ನನ್ನನ್ನು ನಿರ್ಮಿಸಿ ರೂಪಿಸಿದವು;</para>
  <para style="q2" vid="PSA 119:73">ನಿಮ್ಮ ಆಜ್ಞೆಗಳನ್ನು ಕಲಿತುಕೊಳ್ಳಲು ನನಗೆ ಅರಿವನ್ನು ನೀಡಿರಿ.<verse eid="PSA 119:73"/></para>
  <para style="q1">
    <verse number="74" style="v" sid="PSA 119:74"/>ನಿಮಗೆ ಭಯಪಡುವವರು ನನ್ನನ್ನು ನೋಡಿ ಆನಂದಿಸಲಿ,</para>
  <para style="q2" vid="PSA 119:74">ಏಕೆಂದರೆ ನಾನು ನಿಮ್ಮ ವಾಕ್ಯದಲ್ಲಿ ನಿರೀಕ್ಷಿಸಿಕೊಂಡಿದ್ದೇನೆ.<verse eid="PSA 119:74"/></para>
  <para style="q1">
    <verse number="75" style="v" sid="PSA 119:75"/>ಯೆಹೋವ ದೇವರೇ, ನಿಮ್ಮ ನಿಯಮಗಳು ನೀತಿಯುಳ್ಳವುಗಳು;</para>
  <para style="q2" vid="PSA 119:75">ನಿಮ್ಮ ನಂಬಿಗಸ್ತಿಕೆಯಿಂದಲೇ ನೀವು ನನ್ನನ್ನು ಕಷ್ಟಪಡಿಸಿದ್ದೀರಿ ಎಂದು ನನಗೆ ಗೊತ್ತಿದೆ.<verse eid="PSA 119:75"/></para>
  <para style="q1">
    <verse number="76" style="v" sid="PSA 119:76"/>ನೀವು ನಿಮ್ಮ ಸೇವಕನಿಗೆ ನೀಡಿದ ವಾಗ್ದಾನದ ಪ್ರಕಾರ,</para>
  <para style="q2" vid="PSA 119:76">ನಿಮ್ಮ ಒಡಂಬಡಿಕೆಯ ಪ್ರೀತಿಯು ನನಗೆ ಆದರಣೆಯಾಗಿರಲಿ.<verse eid="PSA 119:76"/></para>
  <para style="q1">
    <verse number="77" style="v" sid="PSA 119:77"/>ನಾನು ಜೀವಿಸುವಂತೆ ನಿಮ್ಮ ಅನುಕಂಪವು ನನಗೆ ಬರಲಿ,</para>
  <para style="q2" vid="PSA 119:77">ಏಕೆಂದರೆ ನಿಮ್ಮ ನಿಯಮವೇ ನನ್ನ ಆನಂದವಾಗಿದೆ.<verse eid="PSA 119:77"/></para>
  <para style="q1">
    <verse number="78" style="v" sid="PSA 119:78"/>ಅಹಂಕಾರಿಗಳು ಕಾರಣವಿಲ್ಲದೆ ನನಗೆ ಕೇಡು ಮಾಡಿದ್ದರಿಂದ ನಾಚಿಕೆಪಡಲಿ;</para>
  <para style="q2" vid="PSA 119:78">ಆದರೆ ನಾನು ನಿಮ್ಮ ಸೂತ್ರಗಳನ್ನು ಧ್ಯಾನಿಸುತ್ತಿರುವೆನು.<verse eid="PSA 119:78"/></para>
  <para style="q1">
    <verse number="79" style="v" sid="PSA 119:79"/>ನಿಮಗೆ ಭಯಪಡುವವರು ನನ್ನ ಬಳಿಗೆ ಬರಲಿ,</para>
  <para style="q2" vid="PSA 119:79">ನಿಮ್ಮ ಶಾಸನಗಳನ್ನು ಅರ್ಥಮಾಡಿಕೊಳ್ಳುವವರೂ ನನ್ನ ಬಳಿಗೆ ಬರಲಿ.<verse eid="PSA 119:79"/></para>
  <para style="q1">
    <verse number="80" style="v" sid="PSA 119:80"/>ನಿಷ್ಕಳಂಕ ಹೃದಯದಿಂದ ನಾನು ನಿಮ್ಮ ತೀರ್ಪುಗಳನ್ನು ಪಾಲಿಸುವೆನು,</para>
  <para style="q2" vid="PSA 119:80">ಅದರಿಂದ ನಾನು ನಾಚಿಕೆಗೆ ಗುರಿಯಾಗದಿರುವೆನು.<verse eid="PSA 119:80"/></para>
  <para style="qa">כ ಕಾಫ್</para>
  <para style="q1">
    <verse number="81" style="v" sid="PSA 119:81"/>ನನ್ನ ಪ್ರಾಣವು ನಿಮ್ಮ ರಕ್ಷಣೆಯ ಬಯಕೆಯಿಂದಲೇ ಕುಗ್ಗಿ ಹೋಗುತ್ತಿದೆ,</para>
  <para style="q2" vid="PSA 119:81">ಆದರೂ ನಾನು ನಿಮ್ಮ ವಾಕ್ಯದಲ್ಲಿ ನಿರೀಕ್ಷೆ ಇಟ್ಟಿದ್ದೇನೆ.<verse eid="PSA 119:81"/></para>
  <para style="q1">
    <verse number="82" style="v" sid="PSA 119:82"/>ನನ್ನ ಕಣ್ಣುಗಳು ನಿಮ್ಮ ವಾಗ್ದಾನಕ್ಕಾಗಿ ಕಾಯುತ್ತಾ ಮಂದವಾಗುತ್ತಿವೆ;</para>
  <para style="q2" vid="PSA 119:82">“ನೀವು ಯಾವಾಗ ನನಗೆ ಆದರಣೆ ನೀಡುವಿರಿ?” ಎಂದು ನಾನು ಕೇಳುತ್ತಿರುವೆನು.<verse eid="PSA 119:82"/></para>
  <para style="q1">
    <verse number="83" style="v" sid="PSA 119:83"/>ನಾನು ಹೊಗೆಯಲ್ಲಿರುವ ದ್ರಾಕ್ಷಾರಸದ ಚರ್ಮಚೀಲದಂತ್ತಿದ್ದರೂ,</para>
  <para style="q2" vid="PSA 119:83">ನಿಮ್ಮ ತೀರ್ಪುಗಳನ್ನು ನಾನು ಮರೆಯಲಿಲ್ಲ.<verse eid="PSA 119:83"/></para>
  <para style="q1">
    <verse number="84" style="v" sid="PSA 119:84"/>ಎಷ್ಟು ಕಾಲ ನಿಮ್ಮ ಸೇವಕನು ಕಾಯಬೇಕು?</para>
  <para style="q2" vid="PSA 119:84">ನನ್ನ ಹಿಂಸಕರಿಗೆ ಯಾವಾಗ ನೀವು ಶಿಕ್ಷಿಸುವಿರಿ?<verse eid="PSA 119:84"/></para>
  <para style="q1">
    <verse number="85" style="v" sid="PSA 119:85"/>ನಿಮ್ಮ ನಿಯಮಕ್ಕೆ ವಿರೋಧವಾಗಿ</para>
  <para style="q2" vid="PSA 119:85">ಅಹಂಕಾರಿಗಳು ನನಗೆ ಬಲೆಹಿಡಿಯಲು ಕುಣಿಗಳನ್ನು ಅಗೆದಿದ್ದಾರೆ.<verse eid="PSA 119:85"/></para>
  <para style="q1">
    <verse number="86" style="v" sid="PSA 119:86"/>ನಿಮ್ಮ ಆಜ್ಞೆಗಳೆಲ್ಲಾ ಭರವಸೆಗೆ ಯೋಗ್ಯವಾದವುಗಳೇ;</para>
  <para style="q2" vid="PSA 119:86">ಕಾರಣವಿಲ್ಲದೆ ಜನರು ನನ್ನನ್ನು ಹಿಂಸಿಸುವುದರಿಂದ ನನಗೆ ಸಹಾಯಮಾಡಿರಿ.<verse eid="PSA 119:86"/></para>
  <para style="q1">
    <verse number="87" style="v" sid="PSA 119:87"/>ಅವರು ನನ್ನನ್ನು ಬಹುಮಟ್ಟಿಗೆ ಭೂಮಿಯಿಂದ ಅಳಿಸಿಹಾಕಲು ನೋಡಿದರು,</para>
  <para style="q2" vid="PSA 119:87">ಆದರೆ ನಾನು ನಿಮ್ಮ ಸೂತ್ರಗಳನ್ನು ತಿರಸ್ಕರಿಸಲಿಲ್ಲ.<verse eid="PSA 119:87"/></para>
  <para style="q1">
    <verse number="88" style="v" sid="PSA 119:88"/>ನಿಮ್ಮ ಒಡಂಬಡಿಕೆಯ ಪ್ರೀತಿಯಿಂದ ನನ್ನ ಜೀವನವನ್ನು ಪರಿಪಾಲಿಸಿರಿ,</para>
  <para style="q2" vid="PSA 119:88">ಆಗ ನಿಮ್ಮ ಬಾಯಿಂದ ಹೊರಡುವ ಶಾಸನಗಳನ್ನು ಪಾಲಿಸುವೆನು.<verse eid="PSA 119:88"/></para>
  <para style="qa">ל ಲಾಮೆದ್</para>
  <para style="q1">
    <verse number="89" style="v" sid="PSA 119:89"/>ಯೆಹೋವ ದೇವರೇ, ನಿಮ್ಮ ವಾಕ್ಯವು ಶಾಶ್ವತವಾಗಿದೆ;</para>
  <para style="q2" vid="PSA 119:89">ಅದು ಪರಲೋಕದಲ್ಲಿ ಸ್ಥಿರವಾಗಿದೆ.<verse eid="PSA 119:89"/></para>
  <para style="q1">
    <verse number="90" style="v" sid="PSA 119:90"/>ನಿಮ್ಮ ನಂಬಿಗಸ್ತಿಕೆಯು ಎಲ್ಲಾ ತಲೆಮಾರಿಗೂ ಮುಂದುವರಿಯುವುದು;</para>
  <para style="q2" vid="PSA 119:90">ನೀವು ಸ್ಥಾಪಿಸಿದ ಭೂಮಿಯು ನೆಲೆಯಾಗಿರುವುದು.<verse eid="PSA 119:90"/></para>
  <para style="q1">
    <verse number="91" style="v" sid="PSA 119:91"/>ನಿಮ್ಮ ನಿಯಮಗಳು ಇಂದಿನವರೆಗೂ ನಿಂತಿರುತ್ತವೆ,</para>
  <para style="q2" vid="PSA 119:91">ಏಕೆಂದರೆ ಸೃಷ್ಟಿಗಳೆಲ್ಲವೂ ನಿಮ್ಮ ಸೇವೆಯನ್ನು ಮಾಡುತ್ತವೆ.<verse eid="PSA 119:91"/></para>
  <para style="q1">
    <verse number="92" style="v" sid="PSA 119:92"/>ನಿಮ್ಮ ನಿಯಮವು ನನಗೆ ಆನಂದವಾಗಿರದಿದ್ದರೆ,</para>
  <para style="q2" vid="PSA 119:92">ನನ್ನ ಕಷ್ಟದಲ್ಲಿ ನಾನು ನಾಶವಾಗುತ್ತಿದ್ದೆನು.<verse eid="PSA 119:92"/></para>
  <para style="q1">
    <verse number="93" style="v" sid="PSA 119:93"/>ನಿಮ್ಮ ಸೂತ್ರಗಳನ್ನು ನಾನು ಎಂದಿಗೂ ಮರೆಯುವುದಿಲ್ಲ,</para>
  <para style="q2" vid="PSA 119:93">ಏಕೆಂದರೆ ಅವುಗಳಿಂದ ನನ್ನ ಜೀವವನ್ನು ಪರಿಪಾಲಿಸಿದ್ದೀರಿ.<verse eid="PSA 119:93"/></para>
  <para style="q1">
    <verse number="94" style="v" sid="PSA 119:94"/>ನನ್ನನ್ನು ರಕ್ಷಿಸಿರಿ, ಏಕೆಂದರೆ ನಾನು ನಿಮ್ಮವನೇ;</para>
  <para style="q2" vid="PSA 119:94">ನಿಮ್ಮ ಸೂತ್ರಗಳನ್ನು ನಾನು ಹುಡುಕಿದ್ದೇನಲ್ಲಾ.<verse eid="PSA 119:94"/></para>
  <para style="q1">
    <verse number="95" style="v" sid="PSA 119:95"/>ದುಷ್ಟರು ನನ್ನನ್ನು ನಾಶಮಾಡುವುದಕ್ಕೆ ನನಗಾಗಿ ಕಾಯುತ್ತಿದ್ದಾರೆ,</para>
  <para style="q2" vid="PSA 119:95">ನಾನಾದರೋ ನಿಮ್ಮ ಶಾಸನಗಳನ್ನು ಆಲೋಚಿಸುತ್ತಿರುವೆನು.<verse eid="PSA 119:95"/></para>
  <para style="q1">
    <verse number="96" style="v" sid="PSA 119:96"/>ಸರ್ವ ಸಂಪೂರ್ಣತೆಗೂ ಒಂದು ಮಿತಿಯಿರುವುದನ್ನು ನಾನು ನೋಡಿದ್ದೇನೆ;</para>
  <para style="q2" vid="PSA 119:96">ಆದರೆ ನಿಮ್ಮ ಆಜ್ಞೆಗಳು ಮಿತಿಯಿಲ್ಲದವುಗಳಾಗಿವೆ.<verse eid="PSA 119:96"/></para>
  <para style="qa">מ ಮೆಮ್</para>
  <para style="q1">
    <verse number="97" style="v" sid="PSA 119:97"/>ನಿಮ್ಮ ನಿಯಮವನ್ನು ನಾನು ಎಷ್ಟೋ ಪ್ರೀತಿಮಾಡುತ್ತೇನೆ!</para>
  <para style="q2" vid="PSA 119:97">ದಿನವೆಲ್ಲಾ ಅದನ್ನೇ ಧ್ಯಾನಿಸುತ್ತೇನೆ.<verse eid="PSA 119:97"/></para>
  <para style="q1">
    <verse number="98" style="v" sid="PSA 119:98"/>ನಿಮ್ಮ ಆಜ್ಞೆಗಳು ಯಾವಾಗಲೂ ನನ್ನೊಂದಿಗೆ ಇರುವುದರಿಂದ ಅವು ನನ್ನನ್ನು</para>
  <para style="q2" vid="PSA 119:98">ನನ್ನ ಶತ್ರುಗಳಿಗಿಂತ ಜ್ಞಾನಿಯಾಗಿ ಮಾಡಿವೆ.<verse eid="PSA 119:98"/></para>
  <para style="q1">
    <verse number="99" style="v" sid="PSA 119:99"/>ನನ್ನ ಒಳನೋಟ ನನ್ನ ಬೋಧಕರೆಲ್ಲರಿಗಿಂತ ದೊಡ್ಡದಾಗಿದೆ.</para>
  <para style="q2" vid="PSA 119:99">ಏಕೆಂದರೆ ನಿಮ್ಮ ಶಾಸನಗಳು ನನ್ನ ಧ್ಯಾನವಾಗಿವೆ.<verse eid="PSA 119:99"/></para>
  <para style="q1">
    <verse number="100" style="v" sid="PSA 119:100"/>ನಿಮ್ಮ ಸೂತ್ರಗಳನ್ನು ಕೈಗೊಂಡಿರುವುದರಿಂದ</para>
  <para style="q2" vid="PSA 119:100">ನಾನು ಹಿರಿಯರಿಗಿಂತಲೂ ವಿವೇಕಿಯಾಗಿದ್ದೇನೆ.<verse eid="PSA 119:100"/></para>
  <para style="q1">
    <verse number="101" style="v" sid="PSA 119:101"/>ನಿಮ್ಮ ವಾಕ್ಯವನ್ನು ಅನುಸರಿಸಬೇಕೆಂದು,</para>
  <para style="q2" vid="PSA 119:101">ನಾನು ಪ್ರತಿಯೊಂದು ದುರ್ಮಾರ್ಗದಿಂದ ನನ್ನ ಹೆಜ್ಜೆಗಳನ್ನು ಹಿಂದೆಗೆದಿದ್ದೇನೆ.<verse eid="PSA 119:101"/></para>
  <para style="q1">
    <verse number="102" style="v" sid="PSA 119:102"/>ನಿಮ್ಮ ನಿಯಮಗಳಿಂದ ನಾನು ತಪ್ಪಿಹೋಗಲಿಲ್ಲ,</para>
  <para style="q2" vid="PSA 119:102">ಏಕೆಂದರೆ ನೀವೇ ನನಗೆ ಉಪದೇಶಿಸಿದ್ದೀರಿ.<verse eid="PSA 119:102"/></para>
  <para style="q1">
    <verse number="103" style="v" sid="PSA 119:103"/>ನಿಮ್ಮ ಮಾತುಗಳು ನನ್ನ ರುಚಿಗೆ ಎಷ್ಟೋ ಸಿಹಿಯಾಗಿವೆ!</para>
  <para style="q2" vid="PSA 119:103">ಅವು ನನ್ನ ಬಾಯಿಗೆ ಜೇನುತುಪ್ಪಕ್ಕಿಂತಲೂ ಸಿಹಿಯಾಗಿವೆ!<verse eid="PSA 119:103"/></para>
  <para style="q1">
    <verse number="104" style="v" sid="PSA 119:104"/>ನಾನು ನಿಮ್ಮ ಸೂತ್ರಗಳಿಂದ ತಿಳುವಳಿಕೆಯನ್ನು ಸಂಪಾದಿಸಿಕೊಂಡಿದ್ದೇನೆ;</para>
  <para style="q2" vid="PSA 119:104">ಆದ್ದರಿಂದ ಪ್ರತಿಯೊಂದು ದುರ್ಮಾರ್ಗವನ್ನೂ ದ್ವೇಷಿಸುತ್ತೇನೆ.<verse eid="PSA 119:104"/></para>
  <para style="qa">נ ನೂನ್</para>
  <para style="q1">
    <verse number="105" style="v" sid="PSA 119:105"/>ನಿಮ್ಮ ವಾಕ್ಯವು ನನ್ನ ಪಾದಕ್ಕೆ ದೀಪವೂ</para>
  <para style="q2" vid="PSA 119:105">ನನ್ನ ದಾರಿಗೆ ಬೆಳಕೂ ಆಗಿದೆ.<verse eid="PSA 119:105"/></para>
  <para style="q1">
    <verse number="106" style="v" sid="PSA 119:106"/>ನಿಮ್ಮ ನೀತಿಯ ನಿಯಮಗಳನ್ನು ಪಾಲಿಸುವೆನೆಂದು ನಾನು ಒಂದು ಶಪಥಮಾಡಿದ್ದೇನೆ;</para>
  <para style="q2" vid="PSA 119:106">ಅದನ್ನು ನಾನು ದೃಢಪಡಿಸುವೆನು.<verse eid="PSA 119:106"/></para>
  <para style="q1">
    <verse number="107" style="v" sid="PSA 119:107"/>ನಾನು ಬಹಳ ಕಷ್ಟ ಅನುಭವಿಸಿದ್ದೇನೆ;</para>
  <para style="q2" vid="PSA 119:107">ಯೆಹೋವ ದೇವರೇ, ನಿಮ್ಮ ವಾಕ್ಯದ ಅನುಸಾರವಾಗಿ ನನ್ನ ಜೀವನವನ್ನು ಕಾಪಾಡಿರಿ.<verse eid="PSA 119:107"/></para>
  <para style="q1">
    <verse number="108" style="v" sid="PSA 119:108"/>ಯೆಹೋವ ದೇವರೇ, ನನ್ನ ಬಾಯಿಂದ ಸಿದ್ಧಮನಸ್ಸಿನ ಸ್ತೋತ್ರಗಳನ್ನು ಸ್ವೀಕರಿಸಿರಿ,</para>
  <para style="q2" vid="PSA 119:108">ನಿಮ್ಮ ನಿಯಮಗಳನ್ನು ನನಗೆ ಬೋಧಿಸಿರಿ.<verse eid="PSA 119:108"/></para>
  <para style="q1">
    <verse number="109" style="v" sid="PSA 119:109"/>ನನ್ನ ಜೀವನ ಆಗಾಗ ಅಪಾಯದಲ್ಲಿದೆ,</para>
  <para style="q2" vid="PSA 119:109">ಆದಾಗ್ಯೂ ನಾನು ನಿಮ್ಮ ನಿಯಮವನ್ನು ಮರೆಯುವುದಿಲ್ಲ.<verse eid="PSA 119:109"/></para>
  <para style="q1">
    <verse number="110" style="v" sid="PSA 119:110"/>ದುಷ್ಟರು ನನಗೆ ಬಲೆಯೊಡ್ಡಿದ್ದಾರೆ;</para>
  <para style="q2" vid="PSA 119:110">ಆದರೂ ನಾನು ನಿಮ್ಮ ಸೂತ್ರಗಳನ್ನು ಬಿಟ್ಟು ತಪ್ಪಿಹೋಗಲಿಲ್ಲ.<verse eid="PSA 119:110"/></para>
  <para style="q1">
    <verse number="111" style="v" sid="PSA 119:111"/>ನಿಮ್ಮ ಶಾಸನಗಳನ್ನು ನಿತ್ಯ ಸೊತ್ತಾಗಿ ತೆಗೆದುಕೊಂಡಿದ್ದೇನೆ;</para>
  <para style="q2" vid="PSA 119:111">ಏಕೆಂದರೆ ಅವು ನನ್ನ ಹೃದಯಕ್ಕೆ ಉಲ್ಲಾಸಕರವಾಗಿದೆ.<verse eid="PSA 119:111"/></para>
  <para style="q1">
    <verse number="112" style="v" sid="PSA 119:112"/>ನಿಮ್ಮ ತೀರ್ಪುಗಳನ್ನು ಕಡೆವರೆಗೂ ಪಾಲಿಸುವುದಕ್ಕೆ</para>
  <para style="q2" vid="PSA 119:112">ನಾನು ನನ್ನ ಹೃದಯದಲ್ಲಿ ದೃಢಮಾಡಿಕೊಂಡಿದ್ದೇನೆ.<verse eid="PSA 119:112"/></para>
  <para style="qa">ס ಸಾಮೆಖ್</para>
  <para style="q1">
    <verse number="113" style="v" sid="PSA 119:113"/>ಎರಡು ಮನಸ್ಸುಳ್ಳವರನ್ನು ನಾನು ದ್ವೇಷಿಸುತ್ತೇನೆ,</para>
  <para style="q2" vid="PSA 119:113">ಆದರೂ ನಿಮ್ಮ ನಿಯಮವನ್ನು ನಾನು ಪ್ರೀತಿಸುತ್ತೇನೆ.<verse eid="PSA 119:113"/></para>
  <para style="q1">
    <verse number="114" style="v" sid="PSA 119:114"/>ನೀವೇ ನನ್ನ ಆಶ್ರಯವೂ, ಗುರಾಣಿಯೂ ಆಗಿದ್ದೀರಿ;</para>
  <para style="q2" vid="PSA 119:114">ನಾನು ನನ್ನ ನಿರೀಕ್ಷೆಯನ್ನು ನಿಮ್ಮ ವಾಕ್ಯದಲ್ಲಿ ಇಟ್ಟುಕೊಂಡಿದ್ದೇನೆ.<verse eid="PSA 119:114"/></para>
  <para style="q1">
    <verse number="115" style="v" sid="PSA 119:115"/>ನಿಯಮ ಮೀರುವವರೇ, ನನ್ನಿಂದ ತೊಲಗಿರಿ,</para>
  <para style="q2" vid="PSA 119:115">ನಾನು ನನ್ನ ದೇವರ ಆಜ್ಞೆಗಳನ್ನು ಪಾಲಿಸಲು ಬಿಡಿರಿ!<verse eid="PSA 119:115"/></para>
  <para style="q1">
    <verse number="116" style="v" sid="PSA 119:116"/>ನನ್ನ ದೇವರೇ, ನಿಮ್ಮ ವಾಕ್ಯದ ಪ್ರಕಾರ ನನ್ನನ್ನು ನೆಲೆಗೊಳಿಸಿರಿ, ಆಗ ನಾನು ಬದುಕುವೆನು;</para>
  <para style="q2" vid="PSA 119:116">ನನ್ನ ನಿರೀಕ್ಷೆ ಮುರಿದುಹೋಗದಿರಲಿ.<verse eid="PSA 119:116"/></para>
  <para style="q1">
    <verse number="117" style="v" sid="PSA 119:117"/>ನನ್ನನ್ನು ಎತ್ತಿ ಹಿಡಿಯಿರಿ, ಆಗ ನಾನು ಬಿಡುಗಡೆಯಾಗುವೆನು;</para>
  <para style="q2" vid="PSA 119:117">ನಿಮ್ಮ ತೀರ್ಪುಗಳಿಗೆ ಯಾವಾಗಲೂ ಗಮನಕೊಡುವೆನು.<verse eid="PSA 119:117"/></para>
  <para style="q1">
    <verse number="118" style="v" sid="PSA 119:118"/>ನಿಮ್ಮ ತೀರ್ಪುಗಳನ್ನು ಮೀರಿದವರನ್ನೆಲ್ಲಾ ನೀವು ತಿರಸ್ಕರಿಸುತ್ತೀರಿ,</para>
  <para style="q2" vid="PSA 119:118">ಏಕೆಂದರೆ ಅವರ ಕುಯುಕ್ತಿಯು ವ್ಯರ್ಥವಾಗುವುದು.<verse eid="PSA 119:118"/></para>
  <para style="q1">
    <verse number="119" style="v" sid="PSA 119:119"/>ಭೂಮಿಯಲ್ಲಿರುವ ದುಷ್ಟರೆಲ್ಲರನ್ನು ಕಸದ ಹಾಗೆ ತೆಗೆದು ಹಾಕುತ್ತೀರಿ;</para>
  <para style="q2" vid="PSA 119:119">ಆದ್ದರಿಂದ ನಾನು ನಿಮ್ಮ ಶಾಸನಗಳನ್ನು ಪ್ರೀತಿಸುತ್ತೇನೆ.<verse eid="PSA 119:119"/></para>
  <para style="q1">
    <verse number="120" style="v" sid="PSA 119:120"/>ನಿಮ್ಮ ಭಯದಿಂದ ನನ್ನ ಶರೀರವು ನಡುಗುತ್ತದೆ;</para>
  <para style="q2" vid="PSA 119:120">ನಿಮ್ಮ ನಿಯಮಗಳಿಗೆ ನಾನು ಭಯಭಕ್ತಿಯುಳ್ಳವನಾಗಿದ್ದೇನೆ.<verse eid="PSA 119:120"/></para>
  <para style="qa">ע ಆಯಿನ್</para>
  <para style="q1">
    <verse number="121" style="v" sid="PSA 119:121"/>ನಾನು ನೀತಿನ್ಯಾಯವನ್ನು ನಡೆಸಿದ್ದೇನೆ;</para>
  <para style="q2" vid="PSA 119:121">ನನ್ನ ಹಿಂಸಕರಿಗೆ ನನ್ನನ್ನು ಒಪ್ಪಿಸಬೇಡಿರಿ.<verse eid="PSA 119:121"/></para>
  <para style="q1">
    <verse number="122" style="v" sid="PSA 119:122"/>ನಿಮ್ಮ ಸೇವಕನ ಕ್ಷೇಮವನ್ನು ದೃಢಪಡಿಸಿರಿ;</para>
  <para style="q2" vid="PSA 119:122">ಅಹಂಕಾರಿಗಳು ನನ್ನನ್ನು ಬಾಧಿಸದಿರಲಿ.<verse eid="PSA 119:122"/></para>
  <para style="q1">
    <verse number="123" style="v" sid="PSA 119:123"/>ನಿಮ್ಮ ರಕ್ಷಣೆಯನ್ನೂ ನಿಮ್ಮ ನೀತಿಯ ವಾಗ್ದಾನವನ್ನೂ ಕಾಯುತ್ತಾ,</para>
  <para style="q2" vid="PSA 119:123">ನನ್ನ ಕಣ್ಣುಗಳು ಮಂದವಾದವು.<verse eid="PSA 119:123"/></para>
  <para style="q1">
    <verse number="124" style="v" sid="PSA 119:124"/>ನಿಮ್ಮ ಪ್ರೀತಿಗೆ ಅನುಸಾರವಾಗಿ ನಿಮ್ಮ ಸೇವಕನೊಂದಿಗೆ ವ್ಯವಹರಿಸಿ,</para>
  <para style="q2" vid="PSA 119:124">ನಿಮ್ಮ ತೀರ್ಪುಗಳನ್ನು ನನಗೆ ಬೋಧಿಸಿರಿ.<verse eid="PSA 119:124"/></para>
  <para style="q1">
    <verse number="125" style="v" sid="PSA 119:125"/>ನಾನು ನಿಮ್ಮ ಸೇವಕನು, ನಿಮ್ಮ ಶಾಸನಗಳನ್ನು ನಾನು ಅರ್ಥಮಾಡಿಕೊಳ್ಳುವಂತೆ</para>
  <para style="q2" vid="PSA 119:125">ನನಗೆ ವಿವೇಚನೆಯನ್ನು ಕೊಡಿರಿ.<verse eid="PSA 119:125"/></para>
  <para style="q1">
    <verse number="126" style="v" sid="PSA 119:126"/>ಯೆಹೋವ ದೇವರೇ, ಇದು ನೀವು ಕಾರ್ಯಸಾಧಿಸಲು ಸಮಯವಾಗಿದೆ,</para>
  <para style="q2" vid="PSA 119:126">ಏಕೆಂದರೆ ನಿಮ್ಮ ನಿಯಮವು ಉಲ್ಲಂಘಿಸಲಾಗಿದೆ.<verse eid="PSA 119:126"/></para>
  <para style="q1">
    <verse number="127" style="v" sid="PSA 119:127"/>ಆದ್ದರಿಂದ ನಾನು ನಿಮ್ಮ ಆಜ್ಞೆಗಳನ್ನು ಬಂಗಾರಕ್ಕಿಂತಲೂ ಹೌದು,</para>
  <para style="q2" vid="PSA 119:127">ಅಪರಂಜಿಗಿಂತಲೂ ಹೆಚ್ಚಾಗಿ ಪ್ರೀತಿಸುತ್ತೇನೆ,<verse eid="PSA 119:127"/></para>
  <para style="q1">
    <verse number="128" style="v" sid="PSA 119:128"/>ಅದರ ನಿಮಿತ್ತ ನಿಮ್ಮ ಸೂತ್ರಗಳೆಲ್ಲವೂ ಸರಿಯಾದವುಗಳೆಂದು ನಾನು ಅಂಗೀಕರಿಸುತ್ತೇನೆ,</para>
  <para style="q2" vid="PSA 119:128">ಪ್ರತಿಯೊಂದು ಮೋಸ ಮಾರ್ಗವನ್ನೂ ದ್ವೇಷಿಸುತ್ತೇನೆ.<verse eid="PSA 119:128"/></para>
  <para style="qa">פ ಪೆ</para>
  <para style="q1">
    <verse number="129" style="v" sid="PSA 119:129"/>ನಿಮ್ಮ ಶಾಸನಗಳು ಅದ್ಭುತವಾದವುಗಳೇ;</para>
  <para style="q2" vid="PSA 119:129">ಆದ್ದರಿಂದ ನಾನು ಅವುಗಳನ್ನು ಅನುಸರಿಸುತ್ತೇನೆ.<verse eid="PSA 119:129"/></para>
  <para style="q1">
    <verse number="130" style="v" sid="PSA 119:130"/>ನಿಮ್ಮ ವಾಕ್ಯಗಳನ್ನು ತೆರೆಯುವಾಗ, ಅದು ಬೆಳಕನ್ನು ಕೊಡುವುದು;</para>
  <para style="q2" vid="PSA 119:130">ಅದು ಮುಗ್ಧರಿಗೆ ಅರಿವನ್ನು ನೀಡುವುದು.<verse eid="PSA 119:130"/></para>
  <para style="q1">
    <verse number="131" style="v" sid="PSA 119:131"/>ನಿಮ್ಮ ಆಜ್ಞೆಗಳಿಗಾಗಿರುವ ಬಯಕೆಯು,</para>
  <para style="q2" vid="PSA 119:131">ನಾನು ಬಾಯಿತೆರೆದು ಹಂಬಲಿಸುವಂತೆ ಮಾಡುತ್ತದೆ.<verse eid="PSA 119:131"/></para>
  <para style="q1">
    <verse number="132" style="v" sid="PSA 119:132"/>ನಿಮ್ಮ ನಾಮವನ್ನು ಪ್ರೀತಿಸುವವರಿಗೆ ನೀವು ಯಾವಾಗಲೂ ಮಾಡುವಂತೆ,</para>
  <para style="q2" vid="PSA 119:132">ನೀವು ನನ್ನ ಕಡೆಗೆ ತಿರುಗಿಕೊಂಡು, ನನ್ನನ್ನು ಕರುಣಿಸಿರಿ.<verse eid="PSA 119:132"/></para>
  <para style="q1">
    <verse number="133" style="v" sid="PSA 119:133"/>ನನ್ನ ಹೆಜ್ಜೆಗಳನ್ನು ನಿಮ್ಮ ವಾಕ್ಯದ ಪ್ರಕಾರ ಮುನ್ನಡೆಸಿರಿ;</para>
  <para style="q2" vid="PSA 119:133">ಯಾವ ಪಾಪವಾದರೂ ನನ್ನನ್ನು ಆಳದಿರಲಿ.<verse eid="PSA 119:133"/></para>
  <para style="q1">
    <verse number="134" style="v" sid="PSA 119:134"/>ಜನರ ಬಲಾತ್ಕಾರದಿಂದ ನನ್ನನ್ನು ತಪ್ಪಿಸಿರಿ,</para>
  <para style="q2" vid="PSA 119:134">ಆಗ ನಿಮ್ಮ ಸೂತ್ರಗಳನ್ನು ನಾನು ಪಾಲಿಸುವೆನು.<verse eid="PSA 119:134"/></para>
  <para style="q1">
    <verse number="135" style="v" sid="PSA 119:135"/>ನಿಮ್ಮ ಮುಖವನ್ನು ನಿಮ್ಮ ಸೇವಕನ ಮೇಲೆ ಪ್ರಕಾಶಿಸಿರಿ</para>
  <para style="q2" vid="PSA 119:135">ಮತ್ತು ನಿಮ್ಮ ತೀರ್ಪುಗಳನ್ನು ನನಗೆ ಬೋಧಿಸಿರಿ.<verse eid="PSA 119:135"/></para>
  <para style="q1">
    <verse number="136" style="v" sid="PSA 119:136"/>ನಿಮ್ಮ ನಿಯಮವನ್ನು ಕೈಗೊಳ್ಳದೇ ಇರುವಾಗ</para>
  <para style="q2" vid="PSA 119:136">ನನ್ನ ಕಣ್ಣಿನಿಂದ ಕಣ್ಣೀರು ಧಾರೆಯಾಗಿ ಹರಿಯುತ್ತಿವೆ.<verse eid="PSA 119:136"/></para>
  <para style="qa">צ ಸಾದೆ</para>
  <para style="q1">
    <verse number="137" style="v" sid="PSA 119:137"/>ಯೆಹೋವ ದೇವರೇ, ನೀವು ನೀತಿವಂತರು,</para>
  <para style="q2" vid="PSA 119:137">ನಿಮ್ಮ ನಿಯಮಗಳು ಸರಿಯಾದವುಗಳೇ.<verse eid="PSA 119:137"/></para>
  <para style="q1">
    <verse number="138" style="v" sid="PSA 119:138"/>ನೀವು ಕೊಟ್ಟ ನಿಮ್ಮ ಶಾಸನಗಳು ನೀತಿಯುಳ್ಳವುಗಳು;</para>
  <para style="q2" vid="PSA 119:138">ಪೂರ್ಣ ಭರವಸೆಗೆ ಅವು ಯೋಗ್ಯವಾದವುಗಳು.<verse eid="PSA 119:138"/></para>
  <para style="q1">
    <verse number="139" style="v" sid="PSA 119:139"/>ನನ್ನ ವೈರಿಗಳು ನಿಮ್ಮ ಮಾತುಗಳನ್ನು ತಿರಸ್ಕರಿಸುವುದರಿಂದ,</para>
  <para style="q2" vid="PSA 119:139">ನನ್ನ ಆಸಕ್ತಿಯು ನನ್ನನ್ನು ದಹಿಸಿಬಿಟ್ಟಿದೆ.<verse eid="PSA 119:139"/></para>
  <para style="q1">
    <verse number="140" style="v" sid="PSA 119:140"/>ನಿಮ್ಮ ವಾಗ್ದಾನಗಳು ಬಹು ಪರಿಶೋಧಿತವಾಗಿವೆ,</para>
  <para style="q2" vid="PSA 119:140">ಆದ್ದರಿಂದ ನಿಮ್ಮ ಸೇವಕನು ಅವುಗಳನ್ನು ಪ್ರೀತಿಸುತ್ತಾನೆ.<verse eid="PSA 119:140"/></para>
  <para style="q1">
    <verse number="141" style="v" sid="PSA 119:141"/>ನಾನು ಅಲ್ಪನೂ, ತಿರಸ್ಕಾರ ಹೊಂದಿದವನು ಆಗಿದ್ದರೂ,</para>
  <para style="q2" vid="PSA 119:141">ನಿಮ್ಮ ಸೂತ್ರಗಳನ್ನು ನಾನು ಮರೆಯುವುದಿಲ್ಲ.<verse eid="PSA 119:141"/></para>
  <para style="q1">
    <verse number="142" style="v" sid="PSA 119:142"/>ನಿಮ್ಮ ನೀತಿಯು ನಿತ್ಯವಾದದ್ದು</para>
  <para style="q2" vid="PSA 119:142">ನಿಮ್ಮ ನಿಯಮವು ಸತ್ಯವಾದದ್ದು.<verse eid="PSA 119:142"/></para>
  <para style="q1">
    <verse number="143" style="v" sid="PSA 119:143"/>ಕಷ್ಟಸಂಕಟಗಳು ನನ್ನನ್ನು ಹಿಡಿದಿವೆ,</para>
  <para style="q2" vid="PSA 119:143">ಆದರೂ ನಿಮ್ಮ ಆಜ್ಞೆಗಳು ನನಗೆ ಆನಂದದಾಯಕವಾಗಿವೆ.<verse eid="PSA 119:143"/></para>
  <para style="q1">
    <verse number="144" style="v" sid="PSA 119:144"/>ನಿಮ್ಮ ಶಾಸನಗಳು ಯಾವಾಗಲೂ ನೀತಿಯುಕ್ತವಾಗಿವೆ;</para>
  <para style="q2" vid="PSA 119:144">ನಾನು ಬದುಕುವಂತೆ ನನಗೆ ವಿವೇಕವನ್ನು ಕೊಡಿರಿ.<verse eid="PSA 119:144"/></para>
  <para style="qa">ק ಖೋಫ್</para>
  <para style="q1">
    <verse number="145" style="v" sid="PSA 119:145"/>ಯೆಹೋವ ದೇವರೇ, ಪೂರ್ಣಹೃದಯದಿಂದ ನಾನು ಮೊರೆಯಿಟ್ಟಿದ್ದೇನೆ; ನನಗೆ ಸದುತ್ತರ ನೀಡಿರಿ;</para>
  <para style="q2" vid="PSA 119:145">ನಾನು ನಿಮ್ಮ ತೀರ್ಪುಗಳನ್ನು ಪಾಲಿಸುವೆನು.<verse eid="PSA 119:145"/></para>
  <para style="q1">
    <verse number="146" style="v" sid="PSA 119:146"/>ನಿಮಗೇ ಮೊರೆಯಿಟ್ಟಿದ್ದೇನೆ; ನನ್ನನ್ನು ರಕ್ಷಿಸಿರಿ</para>
  <para style="q2" vid="PSA 119:146">ನಾನು ನಿಮ್ಮ ಶಾಸನಗಳನ್ನು ಪಾಲಿಸುವೆನು.<verse eid="PSA 119:146"/></para>
  <para style="q1">
    <verse number="147" style="v" sid="PSA 119:147"/>ನಾನು ಸೂರ್ಯೋದಯಕ್ಕೆ ಮೊದಲು ಎದ್ದು ನಿಮಗೆ ಮೊರೆ ಇಟ್ಟಿದ್ದೇನೆ;</para>
  <para style="q2" vid="PSA 119:147">ನಾನು ನನ್ನ ನಿರೀಕ್ಷೆಯನ್ನು ನಿಮ್ಮ ವಾಕ್ಯದಲ್ಲಿ ಇಟ್ಟಿದ್ದೇನೆ.<verse eid="PSA 119:147"/></para>
  <para style="q1">
    <verse number="148" style="v" sid="PSA 119:148"/>ನಾನು ನಿಮ್ಮ ವಾಕ್ಯವನ್ನು ಧ್ಯಾನ ಮಾಡುವಂತೆ,</para>
  <para style="q2" vid="PSA 119:148">ರಾತ್ರಿಜಾವದಲ್ಲಿ ನನ್ನ ಕಣ್ಣುಗಳು ತೆರೆದಿರುತ್ತವೆ.<verse eid="PSA 119:148"/></para>
  <para style="q1">
    <verse number="149" style="v" sid="PSA 119:149"/>ಯೆಹೋವ ದೇವರೇ, ನಿಮ್ಮ ಒಡಂಬಡಿಕೆಯ ಪ್ರೀತಿಗೆ ಅನುಸಾರವಾಗಿ ನನ್ನ ಮೊರೆಯನ್ನು ಕೇಳಿರಿ;</para>
  <para style="q2" vid="PSA 119:149">ನಿಮ್ಮ ನಿಯಮಗಳ ಅನುಸಾರವಾಗಿ ನನ್ನ ಬದುಕನ್ನು ಕಾಪಾಡಿರಿ.<verse eid="PSA 119:149"/></para>
  <para style="q1">
    <verse number="150" style="v" sid="PSA 119:150"/>ದುಷ್ಟತನಕ್ಕೆ ಒಳಸಂಚು ಮಾಡುವವರು ನನಗೆ ಸಮೀಪವಾಗಿದ್ದಾರೆ;</para>
  <para style="q2" vid="PSA 119:150">ಆದರೆ ಅವರು ನಿಮ್ಮ ನಿಯಮಕ್ಕೆ ಅವರು ದೂರವಾಗಿದ್ದಾರೆ.<verse eid="PSA 119:150"/></para>
  <para style="q1">
    <verse number="151" style="v" sid="PSA 119:151"/>ಯೆಹೋವ ದೇವರೇ, ನೀವು ಸಮೀಪವಾಗಿದ್ದೀರಿ,</para>
  <para style="q2" vid="PSA 119:151">ನಿಮ್ಮ ಆಜ್ಞೆಗಳೆಲ್ಲಾ ಸತ್ಯವಾಗಿವೆ.<verse eid="PSA 119:151"/></para>
  <para style="q1">
    <verse number="152" style="v" sid="PSA 119:152"/>ನಿಮ್ಮ ಶಾಸನಗಳು ಸದಾಕಾಲಕ್ಕೂ ಇರುವಂತೆ ಅವುಗಳನ್ನು ಸ್ಥಾಪಿಸಿದ್ದೀರೆಂದು</para>
  <para style="q2" vid="PSA 119:152">ಬಹುಕಾಲದ ಹಿಂದೆಯೇ ನಾನು ಕಲಿತುಕೊಂಡಿದ್ದೇವೆ.<verse eid="PSA 119:152"/></para>
  <para style="qa">ר ರೇಷ್</para>
  <para style="q1">
    <verse number="153" style="v" sid="PSA 119:153"/>ನನ್ನ ಕಷ್ಟವನ್ನು ನೋಡಿ ನನ್ನನ್ನು ಬಿಡಿಸಿರಿ;</para>
  <para style="q2" vid="PSA 119:153">ಏಕೆಂದರೆ ನಿಮ್ಮ ನಿಯಮವನ್ನು ನಾನು ಮರೆತಿಲ್ಲ.<verse eid="PSA 119:153"/></para>
  <para style="q1">
    <verse number="154" style="v" sid="PSA 119:154"/>ನನ್ನ ಪರವಾಗಿ ವಾದಿಸಿ, ನನ್ನನ್ನು ವಿಮೋಚಿಸಿರಿ;</para>
  <para style="q2" vid="PSA 119:154">ನಿಮ್ಮ ವಾಗ್ದಾನದ ಪ್ರಕಾರ ನನ್ನ ಬದುಕನ್ನು ಕಾಪಾಡಿರಿ.<verse eid="PSA 119:154"/></para>
  <para style="q1">
    <verse number="155" style="v" sid="PSA 119:155"/>ದುಷ್ಟರಿಗೆ ರಕ್ಷಣೆಯು ದೂರವಾಗಿದೆ;</para>
  <para style="q2" vid="PSA 119:155">ಏಕೆಂದರೆ ಅವರು ನಿಮ್ಮ ತೀರ್ಪುಗಳನ್ನು ಹುಡುಕುವುದಿಲ್ಲ.<verse eid="PSA 119:155"/></para>
  <para style="q1">
    <verse number="156" style="v" sid="PSA 119:156"/>ಯೆಹೋವ ದೇವರೇ, ನಿಮ್ಮ ಅನುಕಂಪವು ಮಹತ್ತಾದವುಗಳು;</para>
  <para style="q2" vid="PSA 119:156">ನಿಮ್ಮ ನಿಯಮಗಳ ಪ್ರಕಾರ ನನ್ನ ಬದುಕನ್ನು ಕಾಪಾಡಿರಿ.<verse eid="PSA 119:156"/></para>
  <para style="q1">
    <verse number="157" style="v" sid="PSA 119:157"/>ನನ್ನನ್ನು ಹಿಂಸಿಸುವ ನನ್ನ ವೈರಿಗಳು ಅನೇಕರಾಗಿದ್ದಾರೆ,</para>
  <para style="q2" vid="PSA 119:157">ನಾನಾದರೋ ನಿಮ್ಮ ಶಾಸನಗಳನ್ನು ಬಿಟ್ಟುಬಿಡಲಿಲ್ಲ.<verse eid="PSA 119:157"/></para>
  <para style="q1">
    <verse number="158" style="v" sid="PSA 119:158"/>ನಾನು ಅಪನಂಬಿಗಸ್ತರನ್ನು ಕಂಡು ಅಸಹ್ಯಪಡುತ್ತೇನೆ,</para>
  <para style="q2" vid="PSA 119:158">ಅವರು ನಿಮ್ಮ ಮಾತನ್ನು ಅಂಗೀಕರಿಸುತ್ತಾಯಿಲ್ಲಾ.<verse eid="PSA 119:158"/></para>
  <para style="q1">
    <verse number="159" style="v" sid="PSA 119:159"/>ನಿಮ್ಮ ಸೂತ್ರಗಳನ್ನು ನಾನು ಎಷ್ಟು ಪ್ರೀತಿಸುತ್ತೇನೆ ನೋಡಿರಿ;</para>
  <para style="q2" vid="PSA 119:159">ಯೆಹೋವ ದೇವರೇ, ನಿಮ್ಮ ಒಡಂಬಡಿಕೆಯ ಪ್ರೀತಿಗೆ ಅನುಸಾರವಾಗಿ ನನ್ನ ಬದುಕನ್ನು ಕಾಪಾಡಿರಿ.<verse eid="PSA 119:159"/></para>
  <para style="q1">
    <verse number="160" style="v" sid="PSA 119:160"/>ನಿಮ್ಮ ಮಾತುಗಳೆಲ್ಲಾ ಸತ್ಯವಾದವುಗಳೇ;</para>
  <para style="q2" vid="PSA 119:160">ನಿಮ್ಮ ನೀತಿ ನಿಯಮಗಳೆಲ್ಲಾ ನಿತ್ಯವಾದವುಗಳೇ.<verse eid="PSA 119:160"/></para>
  <para style="qa">ש ಸೀನ್ ಮತ್ತು ಷೀನ್</para>
  <para style="q1">
    <verse number="161" style="v" sid="PSA 119:161"/>ಅಧಿಕಾರಿಗಳು ಕಾರಣವಿಲ್ಲದೆ ನನ್ನನ್ನು ಹಿಂಸಿಸುತ್ತಾರೆ,</para>
  <para style="q2" vid="PSA 119:161">ಆದರೆ ನನ್ನ ಹೃದಯವು ನಿಮ್ಮ ವಾಕ್ಯಗಳಿಗೆ ನಡುಗುತ್ತದೆ.<verse eid="PSA 119:161"/></para>
  <para style="q1">
    <verse number="162" style="v" sid="PSA 119:162"/>ದೊಡ್ಡ ಕೊಳ್ಳೆಯನ್ನು ಕಂಡುಹಿಡಿದವರಂತೆ</para>
  <para style="q2" vid="PSA 119:162">ನಾನು ನಿಮ್ಮ ವಾಗ್ದಾನದಲ್ಲಿ ಆನಂದಿಸುತ್ತೇನೆ.<verse eid="PSA 119:162"/></para>
  <para style="q1">
    <verse number="163" style="v" sid="PSA 119:163"/>ಸುಳ್ಳುತನವನ್ನು ನಾನು ದ್ವೇಷಿಸಿ ಅಸಹ್ಯಪಡುತ್ತೇನೆ</para>
  <para style="q2" vid="PSA 119:163">ಆದರೆ ನಾನು ನಿಮ್ಮ ನಿಯಮವನ್ನು ಪ್ರೀತಿಸುತ್ತೇನೆ.<verse eid="PSA 119:163"/></para>
  <para style="q1">
    <verse number="164" style="v" sid="PSA 119:164"/>ನಿಮ್ಮ ನೀತಿಯ ನಿಯಮಗಳ ನಿಮಿತ್ತ,</para>
  <para style="q2" vid="PSA 119:164">ನಾನು ದಿನಕ್ಕೆ ಏಳು ಸಾರಿ ನಿಮ್ಮನ್ನು ಸ್ತುತಿಸುತ್ತೇನೆ.<verse eid="PSA 119:164"/></para>
  <para style="q1">
    <verse number="165" style="v" sid="PSA 119:165"/>ನಿಮ್ಮ ನಿಯಮ ಪ್ರಿಯರಿಗೆ ಅಪಾರ ಸಮಾಧಾನವಿರುತ್ತದೆ,</para>
  <para style="q2" vid="PSA 119:165">ಅಂಥವರಿಗೆ ಆತಂಕವೇನೂ ಇರುವುದಿಲ್ಲ.<verse eid="PSA 119:165"/></para>
  <para style="q1">
    <verse number="166" style="v" sid="PSA 119:166"/>ಯೆಹೋವ ದೇವರೇ, ನಾನು ನಿಮ್ಮ ರಕ್ಷಣೆಗಾಗಿ ಕಾದುಕೊಂಡಿದ್ದೇನೆ;</para>
  <para style="q2" vid="PSA 119:166">ನಾನು ನಿಮ್ಮ ಆಜ್ಞೆಗಳನ್ನು ಹಿಂಬಾಲಿಸುತ್ತಿದ್ದೇನೆ.<verse eid="PSA 119:166"/></para>
  <para style="q1">
    <verse number="167" style="v" sid="PSA 119:167"/>ನಾನು ನಿಮ್ಮ ಶಾಸನಗಳನ್ನು ಅನುಸರಿಸುವದರಿಂದ,</para>
  <para style="q2" vid="PSA 119:167">ಅವುಗಳನ್ನು ಅತ್ಯಧಿಕವಾಗಿ ಪ್ರೀತಿಸುತ್ತೇನೆ.<verse eid="PSA 119:167"/></para>
  <para style="q1">
    <verse number="168" style="v" sid="PSA 119:168"/>ನಾನು ನಿಮ್ಮ ಸೂತ್ರಗಳನ್ನೂ ಶಾಸನಗಳನ್ನೂ ಪಾಲಿಸುತ್ತೇನೆ,</para>
  <para style="q2" vid="PSA 119:168">ಏಕೆಂದರೆ ನನ್ನ ಮಾರ್ಗಗಳೆಲ್ಲವೂ ನಿಮಗೆ ತಿಳಿದಿರುತ್ತವೆ.<verse eid="PSA 119:168"/></para>
  <para style="qa">ת ತಾವ್</para>
  <para style="q1">
    <verse number="169" style="v" sid="PSA 119:169"/>ಯೆಹೋವ ದೇವರೇ, ನನ್ನ ಮೊರೆ ನಿಮ್ಮ ಸನ್ನಿಧಿ ಸೇರಲಿ;</para>
  <para style="q2" vid="PSA 119:169">ನಿಮ್ಮ ವಾಕ್ಯದ ಪ್ರಕಾರ ನನಗೆ ಅರಿವನ್ನು ನೀಡಿರಿ.<verse eid="PSA 119:169"/></para>
  <para style="q1">
    <verse number="170" style="v" sid="PSA 119:170"/>ನನ್ನ ಬೇಡಿಕೆಯು ನಿಮ್ಮ ಸನ್ನಿಧಿ ಸೇರಲಿ;</para>
  <para style="q2" vid="PSA 119:170">ನಿಮ್ಮ ವಾಗ್ದಾನದ ಪ್ರಕಾರ ನನ್ನನ್ನು ಬಿಡಿಸಿರಿ.<verse eid="PSA 119:170"/></para>
  <para style="q1">
    <verse number="171" style="v" sid="PSA 119:171"/>ನೀವು ನಿಮ್ಮ ತೀರ್ಪುಗಳನ್ನು ನನಗೆ ಬೋಧಿಸಿದಾಗ,</para>
  <para style="q2" vid="PSA 119:171">ನನ್ನ ತುಟಿಗಳಿಂದ ಸ್ತೋತ್ರವು ಪ್ರವಾಹಿಸಲಿ.<verse eid="PSA 119:171"/></para>
  <para style="q1">
    <verse number="172" style="v" sid="PSA 119:172"/>ನಿಮ್ಮ ಆಜ್ಞೆಗಳೆಲ್ಲಾ ನೀತಿಯುಳ್ಳವುಗಳಾಗಿವೆ,</para>
  <para style="q2" vid="PSA 119:172">ಆದುದರಿಂದ ನನ್ನ ನಾಲಿಗೆಯು ನಿಮ್ಮ ವಾಕ್ಯವನ್ನು ಹಾಡಿ ಹರಸಲಿ.<verse eid="PSA 119:172"/></para>
  <para style="q1">
    <verse number="173" style="v" sid="PSA 119:173"/>ನಾನು ನಿಮ್ಮ ಸೂತ್ರಗಳನ್ನು ಆರಿಸಿಕೊಂಡಿರುವುದರಿಂದ,</para>
  <para style="q2" vid="PSA 119:173">ನಿಮ್ಮ ಕೈ ನನಗೆ ನೆರವಾಗಲಿ.<verse eid="PSA 119:173"/></para>
  <para style="q1">
    <verse number="174" style="v" sid="PSA 119:174"/>ಯೆಹೋವ ದೇವರೇ, ನಾನು ನಿಮ್ಮ ರಕ್ಷಣೆಗಾಗಿ ಬಯಸುತ್ತಿದ್ದೇನೆ,</para>
  <para style="q2" vid="PSA 119:174">ನಿಮ್ಮ ನಿಯಮವೇ ನನಗೆ ಆನಂದವಾಗಿದೆ.<verse eid="PSA 119:174"/></para>
  <para style="q1">
    <verse number="175" style="v" sid="PSA 119:175"/>ನಿಮ್ಮನ್ನು ಸ್ತುತಿಸಲು ನಾನು ಬದುಕಿರಲಿ;</para>
  <para style="q2" vid="PSA 119:175">ನಿಮ್ಮ ನಿಯಮಗಳು ನನ್ನನ್ನು ಕಾಪಾಡಲಿ.<verse eid="PSA 119:175"/></para>
  <para style="q1">
    <verse number="176" style="v" sid="PSA 119:176"/>ತಪ್ಪಿಹೋದ ಕುರಿಯಂತೆ ನಾನು ದಾರಿತಪ್ಪಿದ್ದೇನೆ.</para>
  <para style="q2" vid="PSA 119:176">ನಿಮ್ಮ ಸೇವಕನಾದ ನನ್ನನ್ನು ಬಂದು ಹುಡುಕಿರಿ,</para>
  <para style="q2" vid="PSA 119:176">ಏಕೆಂದರೆ ನಿಮ್ಮ ಆಜ್ಞೆಗಳನ್ನು ನಾನು ಮರೆಯುವುದಿಲ್ಲ.<verse eid="PSA 119:176"/></para>
  <chapter eid="PSA 119"/>
  <chapter number="120" style="c" sid="PSA 120"/>
  <para style="cl">ಕೀರ್ತನೆ 120</para>
  <para style="d">ಯಾತ್ರಾ ಗೀತೆ.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 120:1"/>ನನ್ನ ಇಕ್ಕಟ್ಟಿನಲ್ಲಿ ನಾನು ಯೆಹೋವ ದೇವರಿಗೆ ಕೂಗಿದೆನು;</para>
  <para style="q2" vid="PSA 120:1">ಅವರು ನನಗೆ ಉತ್ತರಕೊಟ್ಟರು.<verse eid="PSA 120:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 120:2"/>ಯೆಹೋವ ದೇವರೇ, ನನ್ನ ಪ್ರಾಣವನ್ನು</para>
  <para style="q2" vid="PSA 120:2">ಸುಳ್ಳು ತುಟಿಯಿಂದಲೂ,</para>
  <para style="q2" vid="PSA 120:2">ಮೋಸದ ನಾಲಿಗೆಯಿಂದಲೂ ಬಿಡಿಸಿರಿ.<verse eid="PSA 120:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 120:3"/>ಮೋಸದ ನಾಲಿಗೆಯೇ,</para>
  <para style="q2" vid="PSA 120:3">ದೇವರು ನಿನಗೆ ಏನು ಕೊಡಬೇಕು?</para>
  <para style="q2" vid="PSA 120:3">ಯಾವ ಹೆಚ್ಚಿನ ಶಿಕ್ಷೆಯನ್ನು ಒದಗಿಸಬೇಕು?<verse eid="PSA 120:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 120:4"/>ಪರಾಕ್ರಮಶಾಲಿಯ ಹದವಾದ ಬಾಣಗಳು</para>
  <para style="q2" vid="PSA 120:4">ಮತ್ತು ಜಾಲಿ ಮರದ ಕೆಂಡಗಳಿಂದ ನಿನಗೆ ಶಿಕ್ಷೆಯಾಗುವುದು.<verse eid="PSA 120:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 120:5"/>ಅಯ್ಯೋ, ನಾನು ಮೆಷೆಕಿನಲ್ಲಿ ತಂಗಬೇಕಲ್ಲಾ!</para>
  <para style="q2" vid="PSA 120:5">ಕೇದಾರಿನ ಗುಡಾರಗಳ ಬಳಿ ವಾಸಮಾಡುತ್ತೇನೆ.<verse eid="PSA 120:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 120:6"/>ನಾನು ಸಮಾಧಾನವನ್ನು ವಿರೋಧಿಸುವವರ</para>
  <para style="q2" vid="PSA 120:6">ಮಧ್ಯದಲ್ಲಿ ಬಹುಕಾಲ ಜೀವಿಸಬೇಕಾಯಿತು.<verse eid="PSA 120:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 120:7"/>ನಾನು ಶಾಂತಿ ಪ್ರಿಯನು;</para>
  <para style="q2" vid="PSA 120:7">ಆದರೆ ನಾನು ಮಾತಾಡಿದರೆ ಅವರು ಯುದ್ಧಕ್ಕೆ ಬರುತ್ತಾರೆ.<verse eid="PSA 120:7"/></para>
  <chapter eid="PSA 120"/>
  <chapter number="121" style="c" sid="PSA 121"/>
  <para style="cl">ಕೀರ್ತನೆ 121</para>
  <para style="d">ಯಾತ್ರಾ ಗೀತೆ.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 121:1"/>ನಾನು ಕಣ್ಣೆತ್ತಿ ಪರ್ವತಗಳ ಕಡೆಗೆ ನೋಡುತ್ತೇನೆ;</para>
  <para style="q2" vid="PSA 121:1">ನನ್ನ ಸಹಾಯವು ಎಲ್ಲಿಂದ ಬರುವುದು?<verse eid="PSA 121:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 121:2"/>ಆಕಾಶವನ್ನೂ ಭೂಮಿಯನ್ನೂ ಸೃಷ್ಟಿಸಿದ</para>
  <para style="q2" vid="PSA 121:2">ಯೆಹೋವ ದೇವರಿಂದಲೇ ನನ್ನ ಸಹಾಯವು ಬರುತ್ತದೆ.<verse eid="PSA 121:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 121:3"/>ದೇವರು ನಿಮ್ಮ ಪಾದಗಳನ್ನು ಕದಲಗೊಡಿಸುವುದಿಲ್ಲ;</para>
  <para style="q2" vid="PSA 121:3">ನಿಮ್ಮನ್ನು ಕಾಪಾಡುವ ದೇವರು ತೂಕಡಿಸುವುದೂ ಇಲ್ಲ.<verse eid="PSA 121:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 121:4"/>ಇಗೋ, ಇಸ್ರಾಯೇಲನ್ನು ಕಾಪಾಡುವ ದೇವರು</para>
  <para style="q2" vid="PSA 121:4">ತೂಕಡಿಸುವುದಿಲ್ಲ, ನಿದ್ರಿಸುವುದಿಲ್ಲ.<verse eid="PSA 121:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 121:5"/>ಯೆಹೋವ ದೇವರು ನಿಮ್ಮನ್ನು ಕಾಪಾಡುವವರಾಗಿದ್ದಾರೆ;</para>
  <para style="q2" vid="PSA 121:5">ಯೆಹೋವ ದೇವರು ನಿಮ್ಮ ಬಲಗಡೆಯಲ್ಲಿ ನೆರಳಿನಂತೆ ಇದ್ದಾರೆ.<verse eid="PSA 121:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 121:6"/>ಹಗಲಲ್ಲಿ ಸೂರ್ಯನೂ ನಿಮ್ಮನ್ನು ಹಾನಿಮಾಡುವುದಿಲ್ಲ.</para>
  <para style="q2" vid="PSA 121:6">ರಾತ್ರಿಯಲ್ಲಿ ಚಂದ್ರನೂ ನಿಮ್ಮನ್ನು ಬಾಧಿಸುವುದಿಲ್ಲ.<verse eid="PSA 121:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 121:7"/>ಯೆಹೋವ ದೇವರು ಎಲ್ಲಾ ಕೇಡಿನಿಂದ ನಿಮ್ಮನ್ನು ಕಾಪಾಡುವರು,</para>
  <para style="q2" vid="PSA 121:7">ನಿಮ್ಮ ಪ್ರಾಣವನ್ನೂ ಕಾಪಾಡುವರು.<verse eid="PSA 121:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 121:8"/>ಯೆಹೋವ ದೇವರು, ನೀವು ಹೋಗುವಾಗಲೂ ಬರುವಾಗಲೂ</para>
  <para style="q2" vid="PSA 121:8">ಇಂದಿಗೂ ಎಂದೆಂದಿಗೂ ನಿಮ್ಮನ್ನು ಕಾಪಾಡುವರು.<verse eid="PSA 121:8"/></para>
  <chapter eid="PSA 121"/>
  <chapter number="122" style="c" sid="PSA 122"/>
  <para style="cl">ಕೀರ್ತನೆ 122</para>
  <para style="d">ದಾವೀದನ ಯಾತ್ರಾ ಗೀತೆ.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 122:1"/>“ಯೆಹೋವ ದೇವರ ಆಲಯಕ್ಕೆ ಹೋಗೋಣ,”</para>
  <para style="q2" vid="PSA 122:1">ಎಂದು ಜನರು ನನ್ನನ್ನು ಕರೆದಾಗ,</para>
  <para style="q2" vid="PSA 122:1">ನನಗೆ ಸಂತೋಷವಾಯಿತು.<verse eid="PSA 122:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 122:2"/>ಯೆರೂಸಲೇಮೇ, ನಮ್ಮ ಪಾದಗಳು</para>
  <para style="q2" vid="PSA 122:2">ನಿನ್ನ ಬಾಗಿಲುಗಳಲ್ಲಿ ತಲುಪಿದೆ.<verse eid="PSA 122:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 122:3"/>ಯೆರೂಸಲೇಮು, ಗಂಭೀರವಾಗಿಯೂ</para>
  <para style="q2" vid="PSA 122:3">ಗಟ್ಟಿಯಾಗಿಯೂ ಕಟ್ಟಿರುವ ಪಟ್ಟಣವಾಗಿದೆ.<verse eid="PSA 122:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 122:4"/>ಅಲ್ಲಿಗೆ ಗೋತ್ರಗಳು,</para>
  <para style="q2" vid="PSA 122:4">ಯೆಹೋವ ದೇವರು</para>
  <para style="q1" vid="PSA 122:4">ಇಸ್ರಾಯೇಲಿಗೆ ಕೊಟ್ಟ ಕಟ್ಟಳೆಗಳ ಪ್ರಕಾರ</para>
  <para style="q2" vid="PSA 122:4">ಯೆಹೋವ ದೇವರ ಹೆಸರನ್ನು ಕೊಂಡಾಡುವುದಕ್ಕೆ ಗೋತ್ರಗಳು ಯಾತ್ರೆಯಾಗಿ ಬರುತ್ತಿದ್ದವು.<verse eid="PSA 122:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 122:5"/>ಏಕೆಂದರೆ ಅಲ್ಲಿ ನ್ಯಾಯ ನಿರ್ಣಯಕ್ಕೆ ಸಿಂಹಾಸನಗಳೂ,</para>
  <para style="q2" vid="PSA 122:5">ಅಂದರೆ, ದಾವೀದನ ಮನೆಯ ಸಿಂಹಾಸನಗಳೂ ಇರುತ್ತವೆ.<verse eid="PSA 122:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 122:6"/>ಯೆರೂಸಲೇಮಿನ ಸಮಾಧಾನಕ್ಕಾಗಿ ಪ್ರಾರ್ಥನೆಮಾಡಿರಿ.</para>
  <para style="q2" vid="PSA 122:6">“ಯೆರೂಸಲೇಮೇ, ನಿನ್ನನ್ನು ಪ್ರೀತಿಸುವವರಿಗೆ ಅಭಿವೃದ್ಧಿಯಾಗಲಿ.<verse eid="PSA 122:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 122:7"/>ನಿನ್ನ ಪ್ರಾಕಾರದಲ್ಲಿ ಸಮಾಧಾನವಿರಲಿ,</para>
  <para style="q2" vid="PSA 122:7">ನಿನ್ನ ಅರಮನೆಗಳಲ್ಲಿ ಅಭಿವೃದ್ಧಿಯೂ ಇರಲಿ.”<verse eid="PSA 122:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 122:8"/>ನನ್ನ ಸಹೋದರರ ನಿಮಿತ್ತವೂ ನನ್ನ ಸ್ನೇಹಿತರ ನಿಮಿತ್ತವೂ</para>
  <para style="q2" vid="PSA 122:8">“ನಿನ್ನಲ್ಲಿ ಸಮಾಧಾನವಿರಲಿ,” ಎಂದು ಈಗ ಹೇಳುತ್ತೇನೆ.<verse eid="PSA 122:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 122:9"/>ನಮ್ಮ ದೇವರಾದ ಯೆಹೋವ ದೇವರ ಆಲಯದ ನಿಮಿತ್ತ</para>
  <para style="q2" vid="PSA 122:9">ನಿನಗೆ ಸಮೃದ್ಧಿಯಾಗಲಿ ಎಂದು ಹಾರೈಸುತ್ತೇನೆ.<verse eid="PSA 122:9"/></para>
  <chapter eid="PSA 122"/>
  <chapter number="123" style="c" sid="PSA 123"/>
  <para style="cl">ಕೀರ್ತನೆ 123</para>
  <para style="d">ಯಾತ್ರಾ ಗೀತೆ.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 123:1"/>ಪರಲೋಕದಲ್ಲಿ ಸಿಂಹಾಸನರಾಗಿರುವವರೇ,</para>
  <para style="q2" vid="PSA 123:1">ನಿಮ್ಮ ಕಡೆಗೆ ನನ್ನ ಕಣ್ಣುಗಳನ್ನು ಎತ್ತಿದ್ದೇನೆ.<verse eid="PSA 123:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 123:2"/>ಇಗೋ, ದಾಸರ ಕಣ್ಣುಗಳು ತಮ್ಮ ಯಜಮಾನರ ಕೈಯನ್ನು ನೋಡುವ ಪ್ರಕಾರ,</para>
  <para style="q2" vid="PSA 123:2">ಮತ್ತು ದಾಸಿಯ ಕಣ್ಣುಗಳು ತನ್ನ ಯಜಮಾನಿಯ ಕೈಯನ್ನೂ ನೋಡುವ ಪ್ರಕಾರ,</para>
  <para style="q1" vid="PSA 123:2">ನಮ್ಮ ಕಣ್ಣುಗಳು ನಮ್ಮ ಯೆಹೋವ ದೇವರು,</para>
  <para style="q2" vid="PSA 123:2">ನಮ್ಮನ್ನು ಕರುಣಿಸುವವರೆಗೆ ನಿರೀಕ್ಷೆಯಿಂದ ನೋಡುತ್ತಿರುವುದು.<verse eid="PSA 123:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 123:3"/>ನಮ್ಮನ್ನು ಕರುಣಿಸು, ಯೆಹೋವ ದೇವರೇ, ನಮ್ಮನ್ನು ಕರುಣಿಸು;</para>
  <para style="q2" vid="PSA 123:3">ಏಕೆಂದರೆ ನಾವು ಬಹಳವಾಗಿ ತಿರಸ್ಕಾರವನ್ನು ಅನುಭವಿಸಿದ್ದೇವೆ.<verse eid="PSA 123:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 123:4"/>ನಾವು ಸುಖಭೋಗಿಗಳ ಗೇಲಿಯನ್ನೂ</para>
  <para style="q2" vid="PSA 123:4">ಗರ್ವಿಷ್ಠರಿಂದ ತಿರಸ್ಕಾರವನ್ನೂ ಅನುಭವಿಸಿದ್ದೇವೆ.<verse eid="PSA 123:4"/></para>
  <chapter eid="PSA 123"/>
  <chapter number="124" style="c" sid="PSA 124"/>
  <para style="cl">ಕೀರ್ತನೆ 124</para>
  <para style="d">ದಾವೀದನ ಯಾತ್ರಾ ಗೀತೆ.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 124:1"/>ಯೆಹೋವ ದೇವರು ನಮ್ಮ ಪರವಾಗಿ ಇರದಿದ್ದರೆ, ಏನಾಗುತ್ತಿತ್ತು</para>
  <para style="q2" vid="PSA 124:1">ಎಂದು ಇಸ್ರಾಯೇಲರೇ ಹೇಳಲಿ.<verse eid="PSA 124:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 124:2"/>ವೈರಿಗಳು ನಮಗೆ ವಿರೋಧವಾಗಿ ಎದ್ದಾಗ</para>
  <para style="q2" vid="PSA 124:2">ಯೆಹೋವ ದೇವರು ನಮ್ಮ ಪರವಾಗಿ ಇರದಿದ್ದರೆ,<verse eid="PSA 124:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 124:3"/>ಅವರು ನಮ್ಮ ಮೇಲೆ ರೋಷಗೊಂಡು</para>
  <para style="q2" vid="PSA 124:3">ನಮ್ಮನ್ನು ನಾಶಮಾಡಿಬಿಡುತ್ತಿದ್ದರು.<verse eid="PSA 124:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 124:4"/>ಆಗ ಪ್ರವಾಹವು ನಮ್ಮನ್ನು ಮುಳುಗಿಸುತ್ತಿತ್ತು;</para>
  <para style="q2" vid="PSA 124:4">ತೊರೆಯು ನಮ್ಮ ಪ್ರಾಣದ ಮೇಲೆ ಹರಿಯುತ್ತಿತ್ತು.<verse eid="PSA 124:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 124:5"/>ರಭಸ ಪ್ರವಾಹ ನಮ್ಮನ್ನು</para>
  <para style="q2" vid="PSA 124:5">ಕೊಚ್ಚಿಕೊಂಡು ಹೋಗಿಬಿಡುತ್ತಿತ್ತು.<verse eid="PSA 124:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 124:6"/>ಆದರೆ ನಮ್ಮನ್ನು ವೈರಿಗಳ ಹಲ್ಲುಗಳಿಗೆ ಬೇಟೆಯಾಗಿ ಕೊಡದೆ ಇದ್ದ</para>
  <para style="q2" vid="PSA 124:6">ಯೆಹೋವ ದೇವರಿಗೆ ಸ್ತೋತ್ರವಾಗಲಿ.<verse eid="PSA 124:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 124:7"/>ನಾವು ಬೇಟೆಗಾರರ ಬಲೆಯಿಂದ</para>
  <para style="q2" vid="PSA 124:7">ತಪ್ಪಿಸಿಕೊಂಡ ಪಕ್ಷಿಯಂತೆ ಇದ್ದೇವೆ.</para>
  <para style="q2" vid="PSA 124:7">ನಾವು ಹರಿದುಹೋದ ಬಲೆಯಿಂದ ತಪ್ಪಿಸಿಕೊಂಡೆವು.<verse eid="PSA 124:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 124:8"/>ನಮ್ಮ ಸಹಾಯವು ಆಕಾಶವನ್ನೂ,</para>
  <para style="q2" vid="PSA 124:8">ಭೂಮಿಯನ್ನೂ ಸೃಷ್ಟಿಸಿದ ಯೆಹೋವ ದೇವರ ಹೆಸರಿನಲ್ಲಿ ಒದಗಿ ಬಂತು.<verse eid="PSA 124:8"/></para>
  <chapter eid="PSA 124"/>
  <chapter number="125" style="c" sid="PSA 125"/>
  <para style="cl">ಕೀರ್ತನೆ 125</para>
  <para style="d">ಯಾತ್ರಾ ಗೀತೆ.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 125:1"/>ಯೆಹೋವ ದೇವರಲ್ಲಿ ಭರವಸವಿಡುವವರು ಚೀಯೋನ್ ಪರ್ವತದ ಹಾಗಿದ್ದಾರೆ;</para>
  <para style="q2" vid="PSA 125:1">ಆ ಪರ್ವತವು ಯುಗಯುಗಕ್ಕೂ ಕದಲದೆ ಇರುವುದು.<verse eid="PSA 125:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 125:2"/>ಯೆರೂಸಲೇಮಿನ ಸುತ್ತಲೂ ಬೆಟ್ಟಗಳಿರುವಂತೆ,</para>
  <para style="q2" vid="PSA 125:2">ಯೆಹೋವ ದೇವರು ಈಗಿನಿಂದ ಯುಗಯುಗಕ್ಕೂ</para>
  <para style="q2" vid="PSA 125:2">ತಮ್ಮ ಜನರ ಸುತ್ತಲೂ ಇದ್ದಾರೆ.<verse eid="PSA 125:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 125:3"/>ನೀತಿವಂತರು ತಮ್ಮ ಕೈಗಳನ್ನು</para>
  <para style="q2" vid="PSA 125:3">ಅನ್ಯಾಯಕ್ಕೆ ಚಾಚದ ಹಾಗೆ,</para>
  <para style="q1" vid="PSA 125:3">ದುಷ್ಟನ ಕೋಲು ನೀತಿವಂತರ</para>
  <para style="q2" vid="PSA 125:3">ಸ್ವಾಸ್ತ್ಯದ ಮೇಲೆ ನೆಲೆಯಾಗಿರುವುದಿಲ್ಲ.<verse eid="PSA 125:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 125:4"/>ಯೆಹೋವ ದೇವರೇ, ಒಳ್ಳೆಯವರಿಗೂ,</para>
  <para style="q2" vid="PSA 125:4">ಯಥಾರ್ಥ ಹೃದಯವುಳ್ಳವರಿಗೂ ಒಳ್ಳೆಯದನ್ನು ಮಾಡುತ್ತಾರೆ.<verse eid="PSA 125:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 125:5"/>ಆದರೆ ಡೊಂಕು ಮಾರ್ಗಗಳಲ್ಲಿ ತಿರುಗುವವರನ್ನು,</para>
  <para style="q2" vid="PSA 125:5">ದುಷ್ಟರ ಸಂಗಡ ದೇವರು ತೊಲಗಿಸಲಿ.</para>
  <para style="b" vid="PSA 125:5"/>
  <para style="q1" vid="PSA 125:5">ಇಸ್ರಾಯೇಲರ ಮೇಲೆ ಸಮಾಧಾನವಿರಲಿ.<verse eid="PSA 125:5"/></para>
  <chapter eid="PSA 125"/>
  <chapter number="126" style="c" sid="PSA 126"/>
  <para style="cl">ಕೀರ್ತನೆ 126</para>
  <para style="d">ಯಾತ್ರಾ ಗೀತೆ.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 126:1"/>ಯೆಹೋವ ದೇವರು ಚೀಯೋನನ್ನು ಸೆರೆಯಿಂದ ಬಿಡಿಸಿದಾಗ</para>
  <para style="q2" vid="PSA 126:1">ನಾವು ಕನಸು ಕಂಡವರ ಹಾಗಿದ್ದೆವು.<verse eid="PSA 126:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 126:2"/>ಆಗ ನಮ್ಮ ಬಾಯಿ ನಗೆಯಿಂದಲೂ,</para>
  <para style="q2" vid="PSA 126:2">ನಮ್ಮ ಬಾಯಿ ಉತ್ಸಾಹ ಧ್ವನಿಯಿಂದಲೂ ತುಂಬಿದ್ದವು;</para>
  <para style="q1" vid="PSA 126:2">ಆಗ ಜನಾಂಗಗಳು,</para>
  <para style="q2" vid="PSA 126:2">“ಯೆಹೋವ ದೇವರು ಇವರಿಗೆ ಮಹತ್ಕಾರ್ಯಗಳನ್ನು ಮಾಡಿದ್ದಾರೆ,” ಎಂದು ಹೇಳಿದರು.<verse eid="PSA 126:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 126:3"/>ಯೆಹೋವ ದೇವರು ನಮಗೆ ಮಹತ್ಕಾರ್ಯಗಳನ್ನು ಮಾಡಿದ್ದಾರೆ;</para>
  <para style="q2" vid="PSA 126:3">ಆದಕಾರಣ ಸಂತೋಷಿಸುತ್ತಾ ಇದ್ದೇವೆ.<verse eid="PSA 126:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 126:4"/>ಯೆಹೋವ ದೇವರೇ, ನೆಗೆವನಲ್ಲಿರುವ<note caller="+" style="f"><char style="fr" closed="false">126:4 </char><char style="fq" closed="false">ನೆಗೆವನಲ್ಲಿರುವ </char><char style="ft" closed="false">ಅಂದರೆ </char><char style="fqa" closed="false">ದೇಶದ ದಕ್ಷಿಣ ಪ್ರಾಂತ್ಯ</char></note> ಹೊಳೆಗಳ ಹಾಗೆ</para>
  <para style="q2" vid="PSA 126:4">ಉಳಿದಿರುವವರನ್ನು ಸಹ ಸೆರೆಯಿಂದ ತಿರುಗಿ ಬರಮಾಡಿರಿ.<verse eid="PSA 126:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 126:5"/>ಕಣ್ಣೀರಿನಿಂದ ಬಿತ್ತುವವರು,</para>
  <para style="q2" vid="PSA 126:5">ಆನಂದ ಗೀತದೊಡನೆ ಕೊಯ್ಯುವರು;<verse eid="PSA 126:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 126:6"/>ಬಿತ್ತಲು ಬೀಜವನ್ನು ಹೊತ್ತುಕೊಂಡು</para>
  <para style="q2" vid="PSA 126:6">ಅಳುತ್ತಾ ಹೋಗುವವರು,</para>
  <para style="q1" vid="PSA 126:6">ತಮ್ಮ ಸಿವುಡುಗಳನ್ನು ಹೊತ್ತುಕೊಂಡು</para>
  <para style="q2" vid="PSA 126:6">ಆನಂದ ಗೀತದೊಡನೆ ತಿರುಗಿ ಬರುವರು.<verse eid="PSA 126:6"/></para>
  <chapter eid="PSA 126"/>
  <chapter number="127" style="c" sid="PSA 127"/>
  <para style="cl">ಕೀರ್ತನೆ 127</para>
  <para style="d">ಸೊಲೊಮೋನನ ಯಾತ್ರಾ ಗೀತೆ.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 127:1"/>ಯೆಹೋವ ದೇವರು ಮನೆಯನ್ನು ಕಟ್ಟದೆ ಇದ್ದರೆ,</para>
  <para style="q2" vid="PSA 127:1">ಅದನ್ನು ಕಟ್ಟುವವರು ವ್ಯರ್ಥವಾಗಿ ಪ್ರಯಾಸಪಡುತ್ತಾರೆ;</para>
  <para style="q1" vid="PSA 127:1">ಯೆಹೋವ ದೇವರು ಪಟ್ಟಣವನ್ನು ಕಾಯದೆ ಇದ್ದರೆ,</para>
  <para style="q2" vid="PSA 127:1">ಅದನ್ನು ಕಾಯುವವರು ವ್ಯರ್ಥವಾಗಿ ಕಾಯುತ್ತಾರೆ.<verse eid="PSA 127:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 127:2"/>ನೀವು ಆಹಾರಕ್ಕಾಗಿ ಶ್ರಮೆಪಟ್ಟು,</para>
  <para style="q2" vid="PSA 127:2">ಬೆಳಿಗ್ಗೆ ಬೇಗ ಏಳುವುದೂ,</para>
  <para style="q1" vid="PSA 127:2">ರಾತ್ರಿ ತಡವಾಗಿ ಮಲಗುವುದೂ ವ್ಯರ್ಥವೇ,</para>
  <para style="q2" vid="PSA 127:2">ದೇವರು ತಮ್ಮನ್ನು ಪ್ರೀತಿಸುವವರಿಗೆ ನಿದ್ರೆಯಿಂದಿರುವಾಗಲೂ ಅವಶ್ಯಕತೆಗಳನ್ನು ಒದಗಿಸಿಕೊಡುತ್ತಾರೆ.<verse eid="PSA 127:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 127:3"/>ಮಕ್ಕಳು ಯೆಹೋವ ದೇವರು ಕೊಟ್ಟ ಸೊತ್ತು.</para>
  <para style="q2" vid="PSA 127:3">ಗರ್ಭಫಲವು ದೇವರ ಬಹುಮಾನ.<verse eid="PSA 127:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 127:4"/>ಯೌವನದಲ್ಲಿ ಹುಟ್ಟಿದ ಮಕ್ಕಳು,</para>
  <para style="q2" vid="PSA 127:4">ಯುದ್ಧವೀರನ ಕೈಯಲ್ಲಿಯ ಬಾಣಗಳಂತಿದ್ದಾರೆ.<verse eid="PSA 127:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 127:5"/>ಬಾಣಗಳನ್ನು ಬತ್ತಳಿಕೆಯಿಂದ</para>
  <para style="q2" vid="PSA 127:5">ತುಂಬಿಸಿಕೊಂಡಿರುವವರು ಧನ್ಯರು,</para>
  <para style="q1" vid="PSA 127:5">ಶತ್ರುಗಳ ಸಂಗಡ ನ್ಯಾಯಾಲಯದಲ್ಲಿ ವಾದಿಸುವಾಗ</para>
  <para style="q2" vid="PSA 127:5">ಅವರು ನಾಚಿಕೆಪಡರು.<verse eid="PSA 127:5"/></para>
  <chapter eid="PSA 127"/>
  <chapter number="128" style="c" sid="PSA 128"/>
  <para style="cl">ಕೀರ್ತನೆ 128</para>
  <para style="d">ಯಾತ್ರಾ ಗೀತೆ.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 128:1"/>ಯೆಹೋವ ದೇವರಿಗೆ ಭಯಪಟ್ಟು ಅವರ ಮಾರ್ಗಗಳಲ್ಲಿ</para>
  <para style="q2" vid="PSA 128:1">ನಡೆದುಕೊಳ್ಳುವ ಪ್ರತಿಯೊಬ್ಬನು ಧನ್ಯನು.<verse eid="PSA 128:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 128:2"/>ನಿನ್ನ ಕೈಗಳ ಕಷ್ಟಾರ್ಜಿತವನ್ನು ನೀನು ಊಟಮಾಡಿ</para>
  <para style="q2" vid="PSA 128:2">ಆಶೀರ್ವಾದವನ್ನೂ ಅಭಿವೃದ್ಧಿಯನ್ನೂ ಹೊಂದುವಿ.<verse eid="PSA 128:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 128:3"/>ನಿನ್ನ ಹೆಂಡತಿಯು ನಿನ್ನ ಮನೆಯಲ್ಲಿರುವ</para>
  <para style="q2" vid="PSA 128:3">ಫಲಭರಿತವಾದ ದ್ರಾಕ್ಷಿಬಳ್ಳಿಯ ಹಾಗೆ ಇರುವಳು.</para>
  <para style="q1" vid="PSA 128:3">ನಿನ್ನ ಮೇಜಿನ ಸುತ್ತಲಿರುವ ನಿನ್ನ ಮಕ್ಕಳು,</para>
  <para style="q2" vid="PSA 128:3">ಓಲಿವ್ ಮರಗಳ ಸಸಿಗಳ ಹಾಗೆ ಇರುವರು.<verse eid="PSA 128:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 128:4"/>ಯೆಹೋವ ದೇವರಿಗೆ ಭಯಪಡುವ ಮನುಷ್ಯನು</para>
  <para style="q2" vid="PSA 128:4">ಹೀಗೆಯೇ ಆಶೀರ್ವಾದ ಹೊಂದುವನು.<verse eid="PSA 128:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 128:5"/>ಯೆಹೋವ ದೇವರು ನಿನ್ನನ್ನು ಚೀಯೋನಿನೊಳಗಿಂದ</para>
  <para style="q2" vid="PSA 128:5">ನಿನ್ನ ಜೀವಮಾನವೆಲ್ಲಾ ಆಶೀರ್ವದಿಸಲಿ;</para>
  <para style="q2" vid="PSA 128:5">ನೀನು ಯೆರೂಸಲೇಮಿನ ಸಮೃದ್ಧಿಯನ್ನು ಕಾಣುವಿ.<verse eid="PSA 128:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 128:6"/>ನೀನು ಮಕ್ಕಳ ಮಕ್ಕಳನ್ನು ಕಾಣುವ ಬದುಕು ನಿನಗಿರಲಿ</para>
  <para style="q2" vid="PSA 128:6">ಇಸ್ರಾಯೇಲರ ಮೇಲೆ ಸಮಾಧಾನವಿರಲಿ.<verse eid="PSA 128:6"/></para>
  <chapter eid="PSA 128"/>
  <chapter number="129" style="c" sid="PSA 129"/>
  <para style="cl">ಕೀರ್ತನೆ 129</para>
  <para style="d">ಯಾತ್ರಾ ಗೀತೆ.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 129:1"/>“ನನ್ನ ಯೌವನದಿಂದ ನನ್ನನ್ನು ಶತ್ರುಗಳು ಬಹಳ ಬಾಧಿಸಿದ್ದಾರೆ,”</para>
  <para style="q2" vid="PSA 129:1">ಎಂದು ಇಸ್ರಾಯೇಲು ಹೇಳಲಿ.<verse eid="PSA 129:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 129:2"/>“ನನ್ನ ಯೌವನದಿಂದ ವೈರಿಗಳು ನನ್ನ ಮೇಲೆ ದಬ್ಬಾಳಿಕೆ ಮಾಡಿದರು;</para>
  <para style="q2" vid="PSA 129:2">ಆದರೆ ಅವರು ನನ್ನ ಮೇಲೆ ವಿಜಯ ಸಾಧಿಸಲಿಲ್ಲ.<verse eid="PSA 129:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 129:3"/>ಊಳುವವರು ನನ್ನ ಬೆನ್ನಿನ ಮೇಲೆ ಉತ್ತಿದರು,</para>
  <para style="q2" vid="PSA 129:3">ಉದ್ದವಾದ ಗಾಯಗೆರೆಗಳನ್ನು ಮಾಡಿದರು<verse eid="PSA 129:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 129:4"/>ಆದರೆ ಯೆಹೋವ ದೇವರು ನೀತಿವಂತರು;</para>
  <para style="q2" vid="PSA 129:4">ದುಷ್ಟರು ಹಾಕಿದ ಬಂಧಗಳನ್ನು ದೇವರು ಕಡಿದು, ನಮ್ಮನ್ನು ಬಿಡುಗಡೆ ಮಾಡಿದ್ದಾರೆ.”<verse eid="PSA 129:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 129:5"/>ಚೀಯೋನನ್ನು ದ್ವೇಷಿಸುವವರೆಲ್ಲರು</para>
  <para style="q2" vid="PSA 129:5">ನಾಚಿಕೆಪಟ್ಟು ಹಿಂದಿರುಗಲಿ.<verse eid="PSA 129:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 129:6"/>ಅವರು ಮಾಳಿಗೆ ಮೇಲಿನ ಹುಲ್ಲಿನಂತೆ ಆಗಲಿ.</para>
  <para style="q2" vid="PSA 129:6">ಅವು ಬೆಳೆಯುವುದಕ್ಕೆ ಮುಂಚೆ ಒಣಗಿ ಹೋಗುತ್ತದೆ.<verse eid="PSA 129:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 129:7"/>ಅದರಿಂದ ಕೊಯ್ಯುವವನು ತನ್ನ ಕೈ ತುಂಬಿಸಿಕೊಳ್ಳನು,</para>
  <para style="q2" vid="PSA 129:7">ಸಿವುಡು ಕಟ್ಟುವವನು ತನ್ನ ಉಡಿಯನ್ನೂ ತುಂಬಿಸಿಕೊಳ್ಳಲಾರನು.<verse eid="PSA 129:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 129:8"/>“ಯೆಹೋವ ದೇವರ ಆಶೀರ್ವಾದವು ನಿಮ್ಮ ಮೇಲೆ ಇರಲಿ;</para>
  <para style="q2" vid="PSA 129:8">ಯೆಹೋವ ದೇವರು ಹೆಸರಿನಲ್ಲಿ ನಿಮ್ಮನ್ನು ಆಶೀರ್ವದಿಸುತ್ತೇವೆ,”</para>
  <para style="q2" vid="PSA 129:8">ಎಂದು ಹಾದುಹೋಗುವವರು ಹೇಳದಿರಲಿ.<verse eid="PSA 129:8"/></para>
  <chapter eid="PSA 129"/>
  <chapter number="130" style="c" sid="PSA 130"/>
  <para style="cl">ಕೀರ್ತನೆ 130</para>
  <para style="d">ಯಾತ್ರಾ ಗೀತೆ.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 130:1"/>ಯೆಹೋವ ದೇವರೇ, ಅಂತರಾಳದಿಂದ ನಿಮಗೆ ಮೊರೆಯಿಡುತ್ತೇನೆ.<verse eid="PSA 130:1"/></para>
  <para style="q2">
    <verse number="2" style="v" sid="PSA 130:2"/>ಯೆಹೋವ ದೇವರೇ, ನನ್ನ ಧ್ವನಿಯನ್ನು ಕೇಳಿರಿ.</para>
  <para style="q1" vid="PSA 130:2">ನನ್ನ ಕೂಗಿಗೆ ಕರುಣೆ ತೋರಿಸಿ,</para>
  <para style="q2" vid="PSA 130:2">ನಿಮ್ಮ ಕಿವಿಗಳು ನನ್ನ ವಿಜ್ಞಾಪನೆಗಳನ್ನು ಆಲೈಸಲಿ.<verse eid="PSA 130:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 130:3"/>ಯೆಹೋವ ದೇವರೇ, ನೀವು ಪಾಪಗಳನ್ನು ಎಣಿಸಿದರೆ,</para>
  <para style="q2" vid="PSA 130:3">ನಿಮ್ಮ ಮುಂದೆ ಯಾರು ನಿಲ್ಲುವರು?<verse eid="PSA 130:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 130:4"/>ಆದರೆ ನಿಮ್ಮಲ್ಲಿ ಕ್ಷಮಾಪಣೆ ಉಂಟು.</para>
  <para style="q2" vid="PSA 130:4">ನಾವು ನಿಮ್ಮನ್ನು ಭಯಭಕ್ತಿಯಿಂದ ಸೇವೆಮಾಡುವಂತೆ ನಿಮ್ಮ ಕ್ಷಮಾಪಣೆಯಿದೆ.<verse eid="PSA 130:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 130:5"/>ಯೆಹೋವ ದೇವರನ್ನು ನಿರೀಕ್ಷಿಸುತ್ತೇನೆ, ನನ್ನ ಅಂತರಾಳವು ಸಹ ನಿರೀಕ್ಷಿಸುತ್ತದೆ;</para>
  <para style="q2" vid="PSA 130:5">ನಾನು ದೇವರ ವಾಕ್ಯದಲ್ಲಿ ನಿರೀಕ್ಷೆ ಇಟ್ಟಿದ್ದೇನೆ.<verse eid="PSA 130:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 130:6"/>ಉದಯಕ್ಕಾಗಿ ಕಾವಲುಗಾರ ಕಾದಿರುತ್ತಾರೆ.</para>
  <para style="q2" vid="PSA 130:6">ನಾನು ಆ ಕಾವಲುಗಾರರು ಕಾದಿರುವುದಕ್ಕಿಂತ ಹೆಚ್ಚಾಗಿಯೇ</para>
  <para style="q2" vid="PSA 130:6">ಯೆಹೋವ ದೇವರಿಗಾಗಿ ನಿರೀಕ್ಷಿಸುತ್ತಿದ್ದೇನೆ.<verse eid="PSA 130:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 130:7"/>ಇಸ್ರಾಯೇಲು ಯೆಹೋವ ದೇವರಲ್ಲಿ ನಿರೀಕ್ಷಿಸಲಿ,</para>
  <para style="q2" vid="PSA 130:7">ಏಕೆಂದರೆ ಯೆಹೋವ ದೇವರ ಬಳಿಯಲ್ಲಿ ಒಂಡಬಡಿಕೆಯ ಪ್ರೀತಿ ಇರುತ್ತದೆ,</para>
  <para style="q2" vid="PSA 130:7">ಸಂಪೂರ್ಣ ವಿಮೋಚನೆಯೂ ಇರುತ್ತದೆ.<verse eid="PSA 130:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 130:8"/>ದೇವರು ಇಸ್ರಾಯೇಲನ್ನು ಅವರ</para>
  <para style="q2" vid="PSA 130:8">ಎಲ್ಲಾ ಅಕ್ರಮಗಳಿಂದ ವಿಮೋಚಿಸುವರು.<verse eid="PSA 130:8"/></para>
  <chapter eid="PSA 130"/>
  <chapter number="131" style="c" sid="PSA 131"/>
  <para style="cl">ಕೀರ್ತನೆ 131</para>
  <para style="d">ದಾವೀದನ ಯಾತ್ರಾ ಗೀತೆ.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 131:1"/>ಯೆಹೋವ ದೇವರೇ, ನನ್ನ ಹೃದಯವು ಗರ್ವದ್ದಲ್ಲ,</para>
  <para style="q2" vid="PSA 131:1">ನನಗೆ ಸೊಕ್ಕಿನ ಕಣ್ಣಿಲ್ಲ</para>
  <para style="q1" vid="PSA 131:1">ದೊಡ್ಡ ವಿಷಯಗಳಲ್ಲಿಯೂ ನನಗೆ ನಿಲುಕಲಾರದವುಗಳಲ್ಲಿಯೂ</para>
  <para style="q2" vid="PSA 131:1">ನಾನು ಕೈ ಹಾಕುವುದಿಲ್ಲ.<verse eid="PSA 131:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 131:2"/>ಆದರೆ ಹಾಲುಬಿಡಿಸಿದ ಕೂಸು ತನ್ನ ತಾಯಿಯ ಮಡಿಲಲ್ಲಿರುವಂತೆ</para>
  <para style="q2" vid="PSA 131:2">ನನ್ನ ಪ್ರಾಣವನ್ನು ಸಮಾಧಾನ ಪಡಿಸಿದ್ದೇನೆ.</para>
  <para style="q2" vid="PSA 131:2">ನಾನು ತಾಯಿಯ ಮಡಿಲಲ್ಲಿರುವ ಕೂಸಿನಂತೆ ಸಂತೃಪ್ತಿಯಿಂದ ಇದ್ದೇನೆ.<verse eid="PSA 131:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 131:3"/>ಇಸ್ರಾಯೇಲೇ, ಯೆಹೋವ ದೇವರಲ್ಲಿ ನಿನ್ನ ನಿರೀಕ್ಷೆಯನ್ನಿಡು.</para>
  <para style="q2" vid="PSA 131:3">ಈಗಲೂ, ಎಂದೆಂದಿಗೂ ನಿರೀಕ್ಷೆಯಿಂದಿರು.<verse eid="PSA 131:3"/></para>
  <chapter eid="PSA 131"/>
  <chapter number="132" style="c" sid="PSA 132"/>
  <para style="cl">ಕೀರ್ತನೆ 132</para>
  <para style="d">ಯಾತ್ರಾ ಗೀತೆ.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 132:1"/>ಯೆಹೋವ ದೇವರೇ, ದಾವೀದನನ್ನೂ</para>
  <para style="q2" vid="PSA 132:1">ಅವನ ಎಲ್ಲಾ ಶ್ರಮೆಗಳನ್ನೂ ಜ್ಞಾಪಕಮಾಡಿಕೊಳ್ಳಿರಿ.<verse eid="PSA 132:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 132:2"/>ದಾವೀದನು ಯೆಹೋವ ದೇವರಿಗೆ ಆಣೆ ಇಟ್ಟು,</para>
  <para style="q2" vid="PSA 132:2">ಪರಾಕ್ರಮಿಯಾದ ಯಾಕೋಬನ ದೇವರಿಗೆ ಹೀಗೆಂದು ಪ್ರಮಾಣ ಮಾಡಿದನು:<verse eid="PSA 132:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 132:3"/>“ಯೆಹೋವ ದೇವರಿಗೆ ಒಂದು ಸ್ಥಳವನ್ನೂ,</para>
  <para style="q2" vid="PSA 132:3">ಯಾಕೋಬನ ದೇವರಿಗೆ ನಿವಾಸವನ್ನೂ ಕಟ್ಟುವವರೆಗೆ ನಿಶ್ಚಯವಾಗಿ,<verse eid="PSA 132:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 132:4"/>ನಾನು ನನ್ನ ಮನೆ ಸೇರೆನು;</para>
  <para style="q2" vid="PSA 132:4">ನನ್ನ ಮಂಚವನ್ನು ಏರೆನು.<verse eid="PSA 132:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 132:5"/>ನನ್ನ ಕಣ್ಣುಗಳಿಗೆ ನಿದ್ದೆಯನ್ನು ಕೊಡೆನು,</para>
  <para style="q2" vid="PSA 132:5">ನನ್ನ ರೆಪ್ಪೆಗಳಿಗೆ ತೂಕಡಿಕೆಯನ್ನೂ ಕೊಡೆನು.”<verse eid="PSA 132:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 132:6"/>ನಾವು ಎಫ್ರಾತದಲ್ಲಿ ಇದನ್ನು ಕೇಳಿದೆವು;</para>
  <para style="q2" vid="PSA 132:6">ಯಹಾರ್ ಅಡವಿಯ ಬಯಲುಗಳಲ್ಲಿ ಇದನ್ನು ಕಂಡು ಹೀಗೆಂದು ಕೇಳಿಸಿಕೊಂಡೆವು:<verse eid="PSA 132:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 132:7"/>“ಬನ್ನಿರಿ ನಾವು ದೇವರ ಮಂದಿರಕ್ಕೆ ಹೋಗಿ,</para>
  <para style="q2" vid="PSA 132:7">ಅವರ ಪಾದಪೀಠದಲ್ಲಿ ಆರಾಧಿಸೋಣ.<verse eid="PSA 132:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 132:8"/>‘ಯೆಹೋವ ದೇವರೇ, ಎದ್ದು ನಿಮ್ಮ ವಿಶ್ರಾಂತಿಯ ಸ್ಥಳಕ್ಕೆ ಬನ್ನಿರಿ;</para>
  <para style="q2" vid="PSA 132:8">ನೀವೂ, ನಿಮ್ಮ ಶಕ್ತಿಯುತ ಮಂಜೂಷವೂ ಬರಲಿ.<verse eid="PSA 132:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 132:9"/>ನಿಮ್ಮ ಯಾಜಕರು ನೀತಿಯೆಂಬ ವಸ್ತ್ರವನ್ನು ಧರಿಸಿಕೊಳ್ಳಲಿ;</para>
  <para style="q2" vid="PSA 132:9">ನಿಮ್ಮ ಭಕ್ತರು ಉತ್ಸಾಹಧ್ವನಿ ಮಾಡಲಿ.’ ”<verse eid="PSA 132:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 132:10"/>ನಿಮ್ಮ ಸೇವಕನಾದ ದಾವೀದನ ನಿಮಿತ್ತ,</para>
  <para style="q2" vid="PSA 132:10">ನಿಮ್ಮ ಅಭಿಷಿಕ್ತನನ್ನು ತಿರಸ್ಕರಿಸಬೇಡಿರಿ.<verse eid="PSA 132:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 132:11"/>ಯೆಹೋವ ದೇವರು ದಾವೀದನಿಗೆ ಸತ್ಯದ ಆಣೆ ಇಟ್ಟಿದ್ದಾರೆ;</para>
  <para style="q2" vid="PSA 132:11">ತಾವು ಹೀಗೆಂದು ಆಣೆಯಿಟ್ಟುಕೊಟ್ಟ ಮಾತನ್ನು ದೇವರು ಬದಲಿಸುವುದಿಲ್ಲ,</para>
  <para style="q1" vid="PSA 132:11">“ನಿನ್ನ ಸಂತತಿಯವನನ್ನೇ</para>
  <para style="q2" vid="PSA 132:11">ನಿನ್ನ ಸಿಂಹಾಸನದ ಮೇಲೆ ಕುಳ್ಳಿರಿಸುವೆನು.<verse eid="PSA 132:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 132:12"/>ನಿಮ್ಮ ಮಕ್ಕಳು ನನ್ನ ಶಾಸನಗಳನ್ನೂ</para>
  <para style="q2" vid="PSA 132:12">ನನ್ನ ಒಡಂಬಡಿಕೆಯನ್ನು ಸನ್ಮಾನಿಸಿ,</para>
  <para style="q1" vid="PSA 132:12">ಕೈಗೊಂಡರೆ, ಅವರ ಮಕ್ಕಳು ಸಹ</para>
  <para style="q2" vid="PSA 132:12">ಎಂದೆಂದಿಗೂ ನಿನ್ನ ಸಿಂಹಾಸನದಲ್ಲಿ ಕೂರುವರು.”<verse eid="PSA 132:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 132:13"/>ಏಕೆಂದರೆ, ಯೆಹೋವ ದೇವರು ಚೀಯೋನನ್ನು ಆಯ್ದುಕೊಂಡು</para>
  <para style="q2" vid="PSA 132:13">ಅದನ್ನು ತಮ್ಮ ವಾಸಕ್ಕಾಗಿ ಅಪೇಕ್ಷಿಸಿ ಹೀಗೆಂದಿದ್ದಾರೆ:<verse eid="PSA 132:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 132:14"/>“ಇದೇ ಎಂದೆಂದಿಗೂ ನನ್ನ ವಿಶ್ರಾಂತಿಯ ಸ್ಥಳವಾಗಿರುವುದು;</para>
  <para style="q2" vid="PSA 132:14">ಇಲ್ಲೇ ವಾಸಿಸುವೆನು; ಇದನ್ನು ನಾನು ಅಪೇಕ್ಷಿಸಿದ್ದೇನೆ;</para>
  <para style="q2" vid="PSA 132:14">ಇಲ್ಲಿಯೇ ಸಿಂಹಾಸನಾರೂಢನಾಗಿರುವೆನು.<verse eid="PSA 132:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 132:15"/>ಧಾರಾಳವಾಗಿ ದವಸಧಾನ್ಯಗಳಿರಲೆಂದು ನಾನು ಚೀಯೋನನ್ನು ಆಶೀರ್ವದಿಸುವೆನು;</para>
  <para style="q2" vid="PSA 132:15">ಇಲ್ಲಿ ವಾಸಿಸುವ ಬಡವರು ಉಂಡು ಸಂತೃಪ್ತಿಯಿಂದಿರುವರು.<verse eid="PSA 132:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 132:16"/>ಇಲ್ಲಿನ ಯಾಜಕರಿಗೆ ರಕ್ಷಣೆಯನ್ನು ಹೊದಿಸುವೆನು;</para>
  <para style="q2" vid="PSA 132:16">ಚೀಯೋನಿನ ನಂಬಿಗಸ್ತ ಸೇವಕರು ಉತ್ಸಾಹಧ್ವನಿಯಿಂದ ಹಾಡುವರು.<verse eid="PSA 132:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 132:17"/>“ಇಲ್ಲಿ ದಾವೀದನಿಗೆ ಬಲದಾಯಕ ಅರಸನನ್ನು ಚಿಗುರುವಂತೆ ಮಾಡುವೆನು;</para>
  <para style="q2" vid="PSA 132:17">ನನ್ನ ಅಭಿಷಿಕ್ತನಿಗೆ ದೀಪವನ್ನು ಸಿದ್ಧಮಾಡಿದ್ದೇನೆ.<verse eid="PSA 132:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 132:18"/>ಇಲ್ಲಿ ಆತನ ಶತ್ರುಗಳಿಗೆ ನಾಚಿಕೆಯ ವಸ್ತ್ರವನ್ನು ಹೊದಿಸುವೆನು;</para>
  <para style="q2" vid="PSA 132:18">ಆದರೆ ಆತನ ತೆರೆಯ ಮೇಲೆ ಕಿರೀಟವು ಶೋಭಿಸುವುದು.”<verse eid="PSA 132:18"/></para>
  <chapter eid="PSA 132"/>
  <chapter number="133" style="c" sid="PSA 133"/>
  <para style="cl">ಕೀರ್ತನೆ 133</para>
  <para style="d">ದಾವೀದನ ಯಾತ್ರಾ ಗೀತೆ.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 133:1"/>ಸಹೋದರರು ಒಂದಾಗಿ ಬಾಳುವುದು ಎಷ್ಟೋ ಒಳ್ಳೆಯದು!</para>
  <para style="q2" vid="PSA 133:1">ಎಷ್ಟೋ ರಮ್ಯವಾದದ್ದು!<verse eid="PSA 133:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 133:2"/>ಆ ಒಂದಾಗಿರುವಿಕೆಯು ತಲೆಯ ಮೇಲಿಂದ ಗಡ್ಡದ ಮೇಲೆ ಅಂದರೆ,</para>
  <para style="q2" vid="PSA 133:2">ಆರೋನನ ಗಡ್ಡದ ಮೇಲೆ ಇಳಿದು,</para>
  <para style="q1" vid="PSA 133:2">ಅವನ ವಸ್ತ್ರದ ಕೊರಳಪಟ್ಟಿಯವರೆಗೆ ಮೇಲೆ ಇಳಿಯುವ</para>
  <para style="q2" vid="PSA 133:2">ಅಮೂಲ್ಯ ತೈಲದ ಹಾಗೆ ಇರುತ್ತದೆ.<verse eid="PSA 133:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 133:3"/>ಆ ಒಂದಾಗಿರುವಿಕೆಯು ಹೆರ್ಮೋನ್ ಪರ್ವತದಿಂದ ಪ್ರಾರಂಭವಾಗಿ</para>
  <para style="q2" vid="PSA 133:3">ಚೀಯೋನ್ ಪರ್ವತಗಳ ಮೇಲೆ ಬೀಳುವ ಮಂಜಿನ ಹಾಗೆಯೂ ಇದೆ.</para>
  <para style="q1" vid="PSA 133:3">ಏಕೆಂದರೆ ಎಲ್ಲಿ ಒಂದಾಗಿರುವಿಕೆಯು ಇದೆಯೋ ಅಲ್ಲಿ ಯೆಹೋವ ದೇವರು ಆಶೀರ್ವಾದವನ್ನೂ,</para>
  <para style="q2" vid="PSA 133:3">ಯುಗಯುಗಾಂತರಕ್ಕೂ ಜೀವವನ್ನೂ ಅನುಗ್ರಹಿಸುತ್ತಾರೆ.<verse eid="PSA 133:3"/></para>
  <chapter eid="PSA 133"/>
  <chapter number="134" style="c" sid="PSA 134"/>
  <para style="cl">ಕೀರ್ತನೆ 134</para>
  <para style="d">ಯಾತ್ರಾ ಗೀತೆ.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 134:1"/>ಯೆಹೋವ ದೇವರ ಆಲಯದಲ್ಲಿ ಪ್ರತಿ ರಾತ್ರಿ ಸೇವೆ ಸಲ್ಲಿಸುವ</para>
  <para style="q2" vid="PSA 134:1">ಯೆಹೋವ ದೇವರ ಎಲ್ಲಾ ಸೇವಕರೇ, ಯೆಹೋವ ದೇವರನ್ನು ಸ್ತುತಿಸಿರಿ.<verse eid="PSA 134:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 134:2"/>ನಿಮ್ಮ ಕೈಗಳನ್ನು ಪರಿಶುದ್ಧ ಸ್ಥಳದಲ್ಲಿ ಎತ್ತಿ,</para>
  <para style="q2" vid="PSA 134:2">ಯೆಹೋವ ದೇವರನ್ನು ಸ್ತುತಿಸಿರಿ.<verse eid="PSA 134:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 134:3"/>ಆಕಾಶವನ್ನೂ, ಭೂಮಿಯನ್ನೂ ಉಂಟುಮಾಡಿದ ಯೆಹೋವ ದೇವರು,</para>
  <para style="q2" vid="PSA 134:3">ಚೀಯೋನಿನೊಳಗಿಂದ ನಿಮ್ಮನ್ನು ಆಶೀರ್ವದಿಸಲಿ.<verse eid="PSA 134:3"/></para>
  <chapter eid="PSA 134"/>
  <chapter number="135" style="c" sid="PSA 135"/>
  <para style="cl">ಕೀರ್ತನೆ 135</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 135:1"/>ಯೆಹೋವ ದೇವರನ್ನು ಸ್ತುತಿಸಿರಿ.</para>
  <para style="b" vid="PSA 135:1"/>
  <para style="q1" vid="PSA 135:1">ಯೆಹೋವ ದೇವರ ಹೆಸರನ್ನು ಸ್ತುತಿಸಿರಿ;</para>
  <para style="q2" vid="PSA 135:1">ಯೆಹೋವ ದೇವರ ಆಲಯದಲ್ಲಿಯೂ,<verse eid="PSA 135:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 135:2"/>ನಮ್ಮ ದೇವರ ಆಲಯದ</para>
  <para style="q2" vid="PSA 135:2">ಅಂಗಳಗಳಲ್ಲಿಯೂ ಸೇವೆ ಮಾಡುವ ಯೆಹೋವ ದೇವರ ಸೇವಕರೇ, ಸ್ತುತಿಸಿರಿ.<verse eid="PSA 135:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 135:3"/>ಯೆಹೋವ ದೇವರನ್ನು ಸ್ತುತಿಸಿರಿ, ಯೆಹೋವ ದೇವರು ಒಳ್ಳೆಯವರು;</para>
  <para style="q2" vid="PSA 135:3">ದೇವರ ಹೆಸರಿಗೆ ಸ್ತುತಿಗಳನ್ನು ಹಾಡಿರಿ, ಏಕೆಂದರೆ ಅದು ರಮ್ಯವಾದದ್ದು.<verse eid="PSA 135:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 135:4"/>ಯೆಹೋವ ದೇವರು ಯಾಕೋಬನನ್ನು ತಮಗೋಸ್ಕರ ಆಯ್ದುಕೊಂಡರು,</para>
  <para style="q2" vid="PSA 135:4">ಇಸ್ರಾಯೇಲನ್ನು ತಮ್ಮ ಶ್ರೇಷ್ಠ ಸಂಪತ್ತಾಗಿಯೂ ಆಯ್ದುಕೊಂಡಿದ್ದಾರೆ.<verse eid="PSA 135:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 135:5"/>ಯೆಹೋವ ದೇವರು ದೊಡ್ಡವರು;</para>
  <para style="q2" vid="PSA 135:5">ನಮ್ಮ ಯೆಹೋವ ದೇವರು ಎಲ್ಲಾ ದೇವರುಗಳಿಗಿಂತ ದೊಡ್ಡವರೆಂದು ನಾನು ತಿಳಿದಿದ್ದೇನೆ.<verse eid="PSA 135:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 135:6"/>ಯೆಹೋವ ದೇವರು ಆಕಾಶದಲ್ಲಿಯೂ,</para>
  <para style="q2" vid="PSA 135:6">ಭೂಮಿಯಲ್ಲಿಯೂ, ಸಮುದ್ರದಲ್ಲಿಯೂ,</para>
  <para style="q2" vid="PSA 135:6">ಎಲ್ಲಾ ಅಗಾಧಗಳಲ್ಲಿಯೂ ತಾವು ಅಪೇಕ್ಷಿಸುವುದನ್ನೆಲ್ಲಾ ಮಾಡುತ್ತಾರೆ.<verse eid="PSA 135:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 135:7"/>ಭೂಮಿಯ ಎಲ್ಲಕಡೆಗಳಿಂದ ಮೋಡಗಳನ್ನು ಏಳುವಂತೆ ಮಾಡುತ್ತಾರೆ.</para>
  <para style="q2" vid="PSA 135:7">ಮಳೆಯನ್ನೂ ಮಿಂಚನ್ನೂ ಕಳುಹಿಸುತ್ತಾರೆ.</para>
  <para style="q2" vid="PSA 135:7">ಗಾಳಿಯನ್ನು ತಮ್ಮ ಉಗ್ರಾಣಗಳಿಂದ ಬೀಸುವಂತೆ ಮಾಡುತ್ತಾರೆ.<verse eid="PSA 135:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 135:8"/>ದೇವರು ಈಜಿಪ್ಟ್ ಜನರನ್ನು ಮೊದಲುಗೊಂಡು ಪಶುಗಳವರೆಗೂ</para>
  <para style="q2" vid="PSA 135:8">ಚೊಚ್ಚಲುಗಳನ್ನೆಲ್ಲಾ ದಂಡಿಸಿದರು.<verse eid="PSA 135:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 135:9"/>ಈಜಿಪ್ಟೇ, ನಿಮ್ಮ ಮಧ್ಯದಲ್ಲಿ ಸೂಚಕಕಾರ್ಯಗಳನ್ನೂ,</para>
  <para style="q2" vid="PSA 135:9">ಅದ್ಭುತಕಾರ್ಯಗಳನ್ನೂ ದೇವರು ಫರೋಹನಿಗೂ,</para>
  <para style="q2" vid="PSA 135:9">ಅವನ ಸಕಲ ಸೇವಕರಿಗೂ ವಿರೋಧವಾಗಿ ಕಳುಹಿಸಿದನು.<verse eid="PSA 135:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 135:10"/>ದೇವರು ದೊಡ್ಡ ಜನಾಂಗಗಳನ್ನೂ,</para>
  <para style="q2" vid="PSA 135:10">ಬಲವಾದ ಅರಸರನ್ನೂ ದಂಡಿಸಿದರು.<verse eid="PSA 135:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 135:11"/>ಅಮೋರಿಯರ ಅರಸನಾದ ಸೀಹೋನನನ್ನು,</para>
  <para style="q2" vid="PSA 135:11">ಬಾಷಾನಿನ ಅರಸನಾದ ಓಗನನ್ನೂ,</para>
  <para style="q2" vid="PSA 135:11">ಕಾನಾನಿನ ಎಲ್ಲಾ ಅರಸರನ್ನೂ ದಂಡಿಸಿದರು.<verse eid="PSA 135:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 135:12"/>ದೇವರು ದೇಶವನ್ನು ಸೊತ್ತಾಗಿ</para>
  <para style="q2" vid="PSA 135:12">ತಮ್ಮ ಪ್ರಜೆಯಾದ ಇಸ್ರಾಯೇಲಿಗೆ ಕೊಟ್ಟರು.<verse eid="PSA 135:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 135:13"/>ಯೆಹೋವ ದೇವರೇ, ನಿಮ್ಮ ನಾಮವೂ,</para>
  <para style="q2" vid="PSA 135:13">ನಿಮ್ಮ ಪ್ರಭಾವವೂ ತಲತಲಾಂತರಕ್ಕೂ ಸ್ಮರಣೆಯಾಗಿರುವುದು.<verse eid="PSA 135:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 135:14"/>ಯೆಹೋವ ದೇವರು ತಮ್ಮ ಜನರಿಗೆ ನ್ಯಾಯವನ್ನು ಸ್ಥಾಪಿಸುವರು,</para>
  <para style="q2" vid="PSA 135:14">ತಮ್ಮ ಸೇವಕರ ಮೇಲೆ ಅನುಕಂಪವನ್ನೂ ತೋರಿಸುವರು.<verse eid="PSA 135:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 135:15"/>ವಿಗ್ರಹಗಳು ಬೆಳ್ಳಿ, ಬಂಗಾರದವುಗಳು,</para>
  <para style="q2" vid="PSA 135:15">ಅವು ಮನುಷ್ಯರ ಕೈಯಿಂದ ಮಾಡಲಾಗಿವೆ.<verse eid="PSA 135:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 135:16"/>ಅವುಗಳಿಗೆ ಬಾಯಿಯಿದೆ, ಮಾತನಾಡುವುದಿಲ್ಲ;</para>
  <para style="q2" vid="PSA 135:16">ಕಣ್ಣುಗಳಿವೆ, ಕಾಣುವುದಿಲ್ಲ.<verse eid="PSA 135:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 135:17"/>ಕಿವಿಗಳಿವೆ, ಕೇಳಿಸಿಕೊಳ್ಳುವುದಿಲ್ಲ;</para>
  <para style="q2" vid="PSA 135:17">ಅವುಗಳ ಬಾಯಲ್ಲಿ ಶ್ವಾಸ ಇಲ್ಲ.<verse eid="PSA 135:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 135:18"/>ಅವುಗಳನ್ನು ಮಾಡುವವರು ಅವುಗಳಂತೆಯೇ ಇದ್ದಾರೆ;</para>
  <para style="q2" vid="PSA 135:18">ಅವುಗಳಲ್ಲಿ ಭರವಸವಿಡುವವರು ಅವುಗಳಂತಾಗುವರು.<verse eid="PSA 135:18"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 135:19"/>ಇಸ್ರಾಯೇಲ್ ಮನೆತನದವರೇ, ಯೆಹೋವ ದೇವರನ್ನು ಕೊಂಡಾಡಿರಿ ಸ್ತುತಿಸಿರಿ;</para>
  <para style="q2" vid="PSA 135:19">ಆರೋನನ ಮನೆತನದವರೇ, ಯೆಹೋವ ದೇವರನ್ನು ಕೊಂಡಾಡಿರಿ ಸ್ತುತಿಸಿರಿ.<verse eid="PSA 135:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 135:20"/>ಲೇವಿಯ ಮನೆತನದವರೇ, ಯೆಹೋವ ದೇವರನ್ನು ಕೊಂಡಾಡಿರಿ ಸ್ತುತಿಸಿರಿ;</para>
  <para style="q2" vid="PSA 135:20">ದೇವರಲ್ಲಿ ಭಯಭಕ್ತಿಯುಳ್ಳವರೇ, ಯೆಹೋವ ದೇವರನ್ನು ಕೊಂಡಾಡಿರಿ ಸ್ತುತಿಸಿರಿ.<verse eid="PSA 135:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 135:21"/>ಯೆರೂಸಲೇಮಿನಲ್ಲಿ ವಾಸಿಸುವವ ಯೆಹೋವ ದೇವರನ್ನು ಕೊಂಡಾಡಿ ಸ್ತುತಿಸಿರಿ;</para>
  <para style="q2" vid="PSA 135:21">ಅವರ ಕೀರ್ತಿಯು ಚೀಯೋನಿನಿಂದ ಹೊರಗೂ ಹಬ್ಬಲಿ.</para>
  <para style="b" vid="PSA 135:21"/>
  <para style="q1" vid="PSA 135:21">ಯೆಹೋವ ದೇವರಿಗೆ ಸ್ತೋತ್ರ.<verse eid="PSA 135:21"/></para>
  <chapter eid="PSA 135"/>
  <chapter number="136" style="c" sid="PSA 136"/>
  <para style="cl">ಕೀರ್ತನೆ 136</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 136:1"/>ಯೆಹೋವ ದೇವರಿಗೆ ಉಪಕಾರ ಸಲ್ಲಿಸಿರಿ; ಅವರು ಒಳ್ಳೆಯವರು;</para>
  <para style="qr" vid="PSA 136:1">ದೇವರ ಪ್ರೀತಿಯು ಎಂದೆಂದಿಗೂ ಇರುವುದು.<verse eid="PSA 136:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 136:2"/>ದೇವಾಧಿ ದೇವರಿಗೆ ಕೃತಜ್ಞತಾಸ್ತುತಿ ಸಲ್ಲಿಸಿರಿ;</para>
  <para style="qr" vid="PSA 136:2">ದೇವರ ಪ್ರೀತಿಯು ಎಂದೆಂದಿಗೂ ಇರುವುದು.<verse eid="PSA 136:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 136:3"/>ಪ್ರಭುಗಳ ಪ್ರಭುವಿಗೆ ಕೃತಜ್ಞತಾಸ್ತುತಿ ಸಲ್ಲಿಸಿರಿ;</para>
  <para style="qr" vid="PSA 136:3">ದೇವರ ಪ್ರೀತಿಯು ಎಂದೆಂದಿಗೂ ಇರುವುದು.<verse eid="PSA 136:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 136:4"/>ಅವರೊಬ್ಬರೇ ಮಹಾ ಅದ್ಭುತಗಳನ್ನು ಮಾಡುತ್ತಾರೆ;</para>
  <para style="qr" vid="PSA 136:4">ದೇವರ ಪ್ರೀತಿಯು ಎಂದೆಂದಿಗೂ ಇರುವುದು.<verse eid="PSA 136:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 136:5"/>ತಮ್ಮ ಜ್ಞಾನದಿಂದ ಪರಲೋಕಗಳನ್ನು ನಿರ್ಮಿಸಿದರು;</para>
  <para style="qr" vid="PSA 136:5">ದೇವರ ಪ್ರೀತಿಯು ಎಂದೆಂದಿಗೂ ಇರುವುದು.<verse eid="PSA 136:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 136:6"/>ನೀರಿನ ಮೇಲೆ ಭೂಮಿಯನ್ನು ವಿಸ್ತರಿಸಿದರು;</para>
  <para style="qr" vid="PSA 136:6">ದೇವರ ಪ್ರೀತಿಯು ಎಂದೆಂದಿಗೂ ಇರುವುದು.<verse eid="PSA 136:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 136:7"/>ದೊಡ್ಡ ಬೆಳಕುಗಳನ್ನು ನಿರ್ಮಿಸಿದರು;</para>
  <para style="qr" vid="PSA 136:7">ದೇವರ ಪ್ರೀತಿಯು ಎಂದೆಂದಿಗೂ ಇರುವುದು.<verse eid="PSA 136:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 136:8"/>ಸೂರ್ಯನು ಹಗಲನ್ನಾಳುವಂತೆ ಮಾಡಿದರು;</para>
  <para style="qr" vid="PSA 136:8">ದೇವರ ಪ್ರೀತಿಯು ಎಂದೆಂದಿಗೂ ಇರುವುದು.<verse eid="PSA 136:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 136:9"/>ರಾತ್ರಿಯನ್ನಾಳಲು ಚಂದ್ರನನ್ನೂ, ನಕ್ಷತ್ರಗಳನ್ನೂ ಇಟ್ಟರು;</para>
  <para style="qr" vid="PSA 136:9">ದೇವರ ಪ್ರೀತಿಯು ಎಂದೆಂದಿಗೂ ಇರುವುದು.<verse eid="PSA 136:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 136:10"/>ಈಜಿಪ್ಟಿನವರ ಚೊಚ್ಚಲ ಮಕ್ಕಳನ್ನು ದಂಡಿಸಿದರು;</para>
  <para style="qr" vid="PSA 136:10">ದೇವರ ಪ್ರೀತಿಯು ಎಂದೆಂದಿಗೂ ಇರುವುದು.<verse eid="PSA 136:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 136:11"/>ಇಸ್ರಾಯೇಲರನ್ನು ಈಜಪ್ಟಿನಿಂದ ಹೊರಗೆ ಬರಮಾಡಿದವರನ್ನು ಕೊಂಡಾಡಿರಿ;</para>
  <para style="qr" vid="PSA 136:11">ದೇವರ ಪ್ರೀತಿಯು ಎಂದೆಂದಿಗೂ ಇರುವುದು.<verse eid="PSA 136:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 136:12"/>ಬಲವಾದ ಕೈಯಿಂದಲೂ, ಚಾಚಿದ ತೋಳಿನಿಂದಲೂ ಅವರನ್ನು ಹೊರತಂದರು;</para>
  <para style="qr" vid="PSA 136:12">ದೇವರ ಪ್ರೀತಿಯು ಎಂದೆಂದಿಗೂ ಇರುವುದು.<verse eid="PSA 136:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 136:13"/>ಕೆಂಪು ಸಮುದ್ರವನ್ನು ವಿಭಾಗಿಸಿದರು;</para>
  <para style="qr" vid="PSA 136:13">ದೇವರ ಪ್ರೀತಿಯು ಎಂದೆಂದಿಗೂ ಇರುವುದು.<verse eid="PSA 136:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 136:14"/>ಇಸ್ರಾಯೇಲನ್ನು ಅದರ ನಡುವೆ ದಾಟಿಸಿದರು;</para>
  <para style="qr" vid="PSA 136:14">ದೇವರ ಪ್ರೀತಿಯು ಎಂದೆಂದಿಗೂ ಇರುವುದು.<verse eid="PSA 136:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 136:15"/>ಫರೋಹನನ್ನೂ, ಅವನ ಸೈನ್ಯವನ್ನೂ ಕೆಂಪು ಸಮುದ್ರದಲ್ಲಿ ಕೆಡವಿದರು;</para>
  <para style="qr" vid="PSA 136:15">ದೇವರ ಪ್ರೀತಿಯು ಎಂದೆಂದಿಗೂ ಇರುವುದು.<verse eid="PSA 136:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 136:16"/>ತಮ್ಮ ಜನರನ್ನು ಮರುಭೂಮಿಯಲ್ಲಿ ನಡೆಸಿದರು;</para>
  <para style="qr" vid="PSA 136:16">ದೇವರ ಪ್ರೀತಿಯು ಎಂದೆಂದಿಗೂ ಇರುವುದು.<verse eid="PSA 136:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 136:17"/>ದೊಡ್ಡ ಅರಸರನ್ನು ದಂಡಿಸಿದರು;</para>
  <para style="qr" vid="PSA 136:17">ದೇವರ ಪ್ರೀತಿಯು ಎಂದೆಂದಿಗೂ ಇರುವುದು.<verse eid="PSA 136:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 136:18"/>ಶ್ರೇಷ್ಠ ಅರಸರನ್ನು ಸಹ ದಂಡಿಸಿದರು;</para>
  <para style="qr" vid="PSA 136:18">ದೇವರ ಪ್ರೀತಿಯು ಎಂದೆಂದಿಗೂ ಇರುವುದು.<verse eid="PSA 136:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 136:19"/>ಅಮೋರಿಯರ ಅರಸನಾದ ಸೀಹೋನನು ದಂಡನೆಹೊಂದಿದನು;</para>
  <para style="qr" vid="PSA 136:19">ದೇವರ ಪ್ರೀತಿಯು ಎಂದೆಂದಿಗೂ ಇರುವುದು.<verse eid="PSA 136:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 136:20"/>ಬಾಷಾನಿನ ಅರಸನಾದ ಓಗನು ಸಂಹಾರವಾದ ಮತ್ತೊಬ್ಬನು;</para>
  <para style="qr" vid="PSA 136:20">ದೇವರ ಪ್ರೀತಿಯು ಎಂದೆಂದಿಗೂ ಇರುವುದು.<verse eid="PSA 136:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 136:21"/>ಅವರ ದೇಶವನ್ನು ಬಾಧ್ಯತೆಯಾಗಿ ದೇವರು ಕೊಟ್ಟರು;</para>
  <para style="qr" vid="PSA 136:21">ದೇವರ ಪ್ರೀತಿಯು ಎಂದೆಂದಿಗೂ ಇರುವುದು.<verse eid="PSA 136:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 136:22"/>ತಮ್ಮ ಸೇವಕ ಇಸ್ರಾಯೇಲನಿಗೆ ಅದು ಸೊತ್ತಾಯಿತು;</para>
  <para style="qr" vid="PSA 136:22">ದೇವರ ಪ್ರೀತಿಯು ಎಂದೆಂದಿಗೂ ಇರುವುದು.<verse eid="PSA 136:22"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 136:23"/>ನಾವು ಹೀನ ಸ್ಥಿತಿಯಲ್ಲಿದ್ದಾಗ ನಮ್ಮನ್ನು ನೆನಪಿಸಿಕೊಂಡರು;</para>
  <para style="qr" vid="PSA 136:23">ದೇವರ ಪ್ರೀತಿಯು ಎಂದೆಂದಿಗೂ ಇರುವುದು.<verse eid="PSA 136:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 136:24"/>ನಮ್ಮ ವೈರಿಗಳಿಂದ ನಮ್ಮನ್ನು ಬಿಡಿಸಿದರು;</para>
  <para style="qr" vid="PSA 136:24">ದೇವರ ಪ್ರೀತಿಯು ಎಂದೆಂದಿಗೂ ಇರುವುದು.<verse eid="PSA 136:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 136:25"/>ಸಕಲ ಜೀವಿಗಳಿಗೂ ಆಹಾರವನ್ನು ಕೊಡುತ್ತಾರೆ;</para>
  <para style="qr" vid="PSA 136:25">ದೇವರ ಪ್ರೀತಿಯು ಎಂದೆಂದಿಗೂ ಇರುವುದು.<verse eid="PSA 136:25"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 136:26"/>ಪರಲೋಕದ ದೇವರನ್ನು ಕೊಂಡಾಡಿರಿ;</para>
  <para style="qr" vid="PSA 136:26">ದೇವರ ಪ್ರೀತಿಯು ಎಂದೆಂದಿಗೂ ಇರುವುದು.<verse eid="PSA 136:26"/></para>
  <chapter eid="PSA 136"/>
  <chapter number="137" style="c" sid="PSA 137"/>
  <para style="cl">ಕೀರ್ತನೆ 137</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 137:1"/>ಬಾಬಿಲೋನಿನ ನದಿಗಳ ಹತ್ತಿರ ನಾವು ಕುಳಿತುಕೊಂಡು,</para>
  <para style="q2" vid="PSA 137:1">ಚೀಯೋನನ್ನು ಜ್ಞಾಪಕ ಮಾಡಿಕೊಂಡಾಗ ಅತ್ತೆವು.<verse eid="PSA 137:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 137:2"/>ಅದರ ನಡುವೆ ಇರುವ ನೀರವಂಜಿ ಮರಗಳ ಮೇಲೆ</para>
  <para style="q2" vid="PSA 137:2">ನಮ್ಮ ಕಿನ್ನರಿಗಳನ್ನು ತೂಗು ಹಾಕಿದೆವು.<verse eid="PSA 137:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 137:3"/>ಏಕೆಂದರೆ ಅಲ್ಲಿ ನಮ್ಮನ್ನು ಸೆರೆಹಿಡಿದು ಬಂಧಿಸಿದವರು,</para>
  <para style="q2" vid="PSA 137:3">ನಮಗೆ ಹಾಡನ್ನು ಹಾಡಲು ಹೇಳಿದ್ದರು;</para>
  <para style="q1" vid="PSA 137:3">ನಮ್ಮನ್ನು ಪೀಡಿಸುವವರು ವಿನೋದಕ್ಕಾಗಿ ಹಾಡನ್ನು ಕೇಳಲು ಬಯಸಿದ್ದರು;</para>
  <para style="q2" vid="PSA 137:3">“ಚೀಯೋನಿನ ಹಾಡುಗಳಲ್ಲಿ ಒಂದು ನಮಗೆ ಹಾಡಿರಿ,” ಎಂದರು.<verse eid="PSA 137:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 137:4"/>ಅನ್ಯದೇಶದಲ್ಲಿ ನಾವು</para>
  <para style="q2" vid="PSA 137:4">ಯೆಹೋವ ದೇವರ ಹಾಡುಗಳನ್ನು ಹಾಡುವುದು ಹೇಗೆ?<verse eid="PSA 137:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 137:5"/>ಯೆರೂಸಲೇಮೇ, ನಾನು ನಿನ್ನನ್ನು ಮರೆತುಬಿಟ್ಟರೆ,</para>
  <para style="q2" vid="PSA 137:5">ನನ್ನ ಬಲಗೈಯ ಕೌಶಲ್ಯ ಮರೆತು ಹೋಗಲಿ.<verse eid="PSA 137:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 137:6"/>ನಾನು ನಿನ್ನನ್ನು ಜ್ಞಾಪಕಮಾಡಿಕೊಳ್ಳದಿದ್ದರೆ,</para>
  <para style="q2" vid="PSA 137:6">ಯೆರೂಸಲೇಮನ್ನು ನನ್ನ ಎಲ್ಲಾ ಸಂತೋಷಕ್ಕಿಂತಲೂ ಹೆಚ್ಚಾಗಿಡದಿದ್ದರೆ,</para>
  <para style="q2" vid="PSA 137:6">ನನ್ನ ನಾಲಿಗೆಯು ಸೇದಿಹೋಗಲಿ.<verse eid="PSA 137:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 137:7"/>ಯೆರೂಸಲೇಮು ಬಿದ್ದುಹೋದ ದಿವಸದಲ್ಲಿ,</para>
  <para style="q2" vid="PSA 137:7">“ಹಾಳುಮಾಡಿರಿ, ಅದರ ಅಸ್ತಿವಾರದವರೆಗೆ ಹಾಳುಮಾಡಿರಿ,”</para>
  <para style="q1" vid="PSA 137:7">ಎಂದು ಹೇಳಿದ ಎದೋಮಿನವರನ್ನು</para>
  <para style="q2" vid="PSA 137:7">ಯೆಹೋವ ದೇವರೇ ಜ್ಞಾಪಕಮಾಡಿಕೊಳ್ಳಿರಿ.<verse eid="PSA 137:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 137:8"/>ಹಾಳಾಗಲಿಕ್ಕಿರುವ ಬಾಬಿಲೋನ್ ನಗರವೇ,</para>
  <para style="q2" vid="PSA 137:8">ನೀನು ನಮಗೆ ಮಾಡಿದ್ದಕ್ಕೆ ಪ್ರತೀಕಾರವನ್ನು</para>
  <para style="q2" vid="PSA 137:8">ನಿನಗೆ ಸಲ್ಲಿಸುವವನು ಧನ್ಯನು.<verse eid="PSA 137:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 137:9"/>ನಿಮ್ಮ ಚಿಕ್ಕ ಕೂಸುಗಳನ್ನು ಹಿಡಿದು,</para>
  <para style="q2" vid="PSA 137:9">ಬಂಡೆಗಳ ಮೇಲೆ ಅಪ್ಪಳಿಸಿ ಬಿಡುವವನು ಧನ್ಯನು.<verse eid="PSA 137:9"/></para>
  <chapter eid="PSA 137"/>
  <chapter number="138" style="c" sid="PSA 138"/>
  <para style="cl">ಕೀರ್ತನೆ 138</para>
  <para style="d">ದಾವೀದನ ಕೀರ್ತನೆ.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 138:1"/>ಯೆಹೋವ ದೇವರೇ, ನನ್ನ ಪೂರ್ಣಹೃದಯದಿಂದ ನಿಮ್ಮನ್ನು ಕೊಂಡಾಡುವೆನು;</para>
  <para style="q2" vid="PSA 138:1">ದೇವರುಗಳ ಮುಂದೆ ನಿಮ್ಮನ್ನು ಸ್ತುತಿಸುವೆನು.<verse eid="PSA 138:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 138:2"/>ನಿಮ್ಮ ಪರಿಶುದ್ಧ ಮಂದಿರದ ಕಡೆಗೆ ಅಡ್ಡಬಿದ್ದು,</para>
  <para style="q2" vid="PSA 138:2">ನಿಮ್ಮ ಒಡಂಬಡಿಕೆಯ ಪ್ರೀತಿ, ನಿಮ್ಮ ಸತ್ಯತೆಯ ನಿಮಿತ್ತ</para>
  <para style="q2" vid="PSA 138:2">ನಿಮ್ಮ ಹೆಸರನ್ನು ಕೊಂಡಾಡುವೆನು;</para>
  <para style="q1" vid="PSA 138:2">ನೀವು ನಿಮ್ಮ ವಾಕ್ಯವನ್ನು</para>
  <para style="q2" vid="PSA 138:2">ನಿಮ್ಮ ಹೆಸರಿಗಿಂತಲೂ ಮಿಗಿಲಾಗಿ ಘನಪಡಿಸಿದ್ದೀರಿ.<verse eid="PSA 138:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 138:3"/>ನಾನು ಕರೆದಾಗ ನೀವು ನನಗೆ ಉತ್ತರಕೊಟ್ಟಿರುವಿರಿ.</para>
  <para style="q2" vid="PSA 138:3">ನನ್ನ ಪ್ರಾಣಕ್ಕೆ ಬಲವನ್ನು ಕೊಟ್ಟು, ನನ್ನನ್ನು ಬಲಪಡಿಸಿದ್ದೀರಿ.<verse eid="PSA 138:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 138:4"/>ಯೆಹೋವ ದೇವರೇ, ನಿಮ್ಮ ತೀರ್ಪುಗಳನ್ನು</para>
  <para style="q2" vid="PSA 138:4">ಭೂಮಿಯ ಅರಸರೆಲ್ಲರೂ ಕೇಳುವಾಗ, ನಿಮ್ಮನ್ನು ಕೊಂಡಾಡಲಿ.<verse eid="PSA 138:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 138:5"/>ಹೌದು, ಅವರು ಯೆಹೋವ ದೇವರ ಮಾರ್ಗಗಳ</para>
  <para style="q2" vid="PSA 138:5">ಯೆಹೋವ ದೇವರ ಮಹಿಮೆಯು ಮಹೋನ್ನತವಾಗಿದೆ.<verse eid="PSA 138:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 138:6"/>ಯೆಹೋವ ದೇವರು ಉನ್ನತರಾಗಿದ್ದರೂ, ದೀನನನ್ನು ಗಮನಿಸುತ್ತಾರೆ;</para>
  <para style="q2" vid="PSA 138:6">ಆದರೆ ಗರ್ವಿಷ್ಠನನ್ನು ದೂರದಿಂದ ತಿಳಿದುಕೊಳ್ಳುತ್ತಾರೆ.<verse eid="PSA 138:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 138:7"/>ನಾನು ಕಷ್ಟದ ಮಧ್ಯದಲ್ಲಿ ನಡೆದಾಗ್ಯೂ,</para>
  <para style="q2" vid="PSA 138:7">ನೀವು ನನ್ನನ್ನು ಬದುಕಿಸಿ,</para>
  <para style="q1" vid="PSA 138:7">ನನ್ನ ಶತ್ರುಗಳ ಕೋಪಕ್ಕೆ ವಿರೋಧವಾಗಿ ನಿಮ್ಮ ಕೈಯನ್ನು ಚಾಚಿದ್ದೀರಿ;</para>
  <para style="q2" vid="PSA 138:7">ನಿಮ್ಮ ಬಲಗೈಯಿಂದ ನನ್ನನ್ನು ರಕ್ಷಿಸಿದ್ದೀರಿ.<verse eid="PSA 138:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 138:8"/>ಯೆಹೋವ ದೇವರು ನನ್ನ ನ್ಯಾಯವನ್ನು ಸಿದ್ಧಿಗೆ ತರುತ್ತಾರೆ;</para>
  <para style="q2" vid="PSA 138:8">ಯೆಹೋವ ದೇವರೇ, ನಿಮ್ಮ ಪ್ರೀತಿಯು ಎಂದೆಂದಿಗೂ ಇರುವುದು;</para>
  <para style="q2" vid="PSA 138:8">ನಿಮ್ಮ ಕೈಕೆಲಸಗಳನ್ನು ನೆರವೇರಿಸಿರಿ.<verse eid="PSA 138:8"/></para>
  <chapter eid="PSA 138"/>
  <chapter number="139" style="c" sid="PSA 139"/>
  <para style="cl">ಕೀರ್ತನೆ 139</para>
  <para style="d">ಸಂಗೀತ ನಿರ್ದೇಶಕನಿಗಾಗಿರುವ ಕೀರ್ತನೆ. ದಾವೀದನ ಕೀರ್ತನೆ.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 139:1"/>ಯೆಹೋವ ದೇವರೇ, ನೀವು ನನ್ನನ್ನು ಪರಿಶೋಧಿಸಿದ್ದೀರಿ;</para>
  <para style="q2" vid="PSA 139:1">ನನ್ನನ್ನು ತಿಳಿದುಕೊಂಡಿದ್ದೀರಿ.<verse eid="PSA 139:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 139:2"/>ನಾನು ಕುಳಿತಿರುವುದನ್ನೂ, ಏಳುವುದನ್ನೂ ನೀವು ತಿಳಿದುಕೊಂಡಿದ್ದೀರಿ;</para>
  <para style="q2" vid="PSA 139:2">ನನ್ನ ಆಲೋಚನೆಗಳನ್ನು ದೂರದಿಂದ ಗ್ರಹಿಸಿಕೊಂಡಿದ್ದೀರಿ.<verse eid="PSA 139:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 139:3"/>ನಾನು ನಡೆಯುವುದನ್ನೂ, ನಾನು ಮಲಗುವುದನ್ನೂ ನೀವು ವಿವೇಚಿಸಿದ್ದೀರಿ;</para>
  <para style="q2" vid="PSA 139:3">ನನ್ನ ಮಾರ್ಗಗಳೆಲ್ಲಾ ನಿಮಗೆ ಸುಪರಿಚಿತವಾಗಿವೆ.<verse eid="PSA 139:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 139:4"/>ನನ್ನ ನಾಲಿಗೆಯಲ್ಲಿ ಒಂದು ಮಾತು ಆರಂಭಿಸುವುದಕ್ಕಿಂತ ಮುಂಚೆಯೇ</para>
  <para style="q2" vid="PSA 139:4">ಯೆಹೋವ ದೇವರೇ, ಅದು ನಿಮಗೆ ಪೂರ್ಣವಾಗಿ ತಿಳಿದಿರುತ್ತದೆ.<verse eid="PSA 139:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 139:5"/>ನೀವು ನನ್ನ ಹಿಂದೆಯೂ, ಮುಂದೆಯೂ ಆವರಿಸಿಕೊಂಡು,</para>
  <para style="q2" vid="PSA 139:5">ನಿಮ್ಮ ಕೈಯನ್ನು ನನ್ನ ಮೇಲೆ ಇಟ್ಟಿದ್ದೀರಿ.<verse eid="PSA 139:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 139:6"/>ಇಂಥ ಅರಿವು ನನಗೆ ಅತ್ಯಂತ ವಿಸ್ಮಯವಾಗಿದೆ,</para>
  <para style="q2" vid="PSA 139:6">ಅದು ನನಗೆ ನಿಲುಕಲಾರದಷ್ಟು ಉನ್ನತವಾಗಿದೆ.<verse eid="PSA 139:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 139:7"/>ನಾನು ನಿಮ್ಮ ಆತ್ಮದಿಂದ ತಪ್ಪಿಸಿಕೊಂಡು ಎಲ್ಲಿಗೆ ಹೋಗಲಿ?</para>
  <para style="q2" vid="PSA 139:7">ನಿಮ್ಮ ಸನ್ನಿಧಿಯಿಂದ ತಪ್ಪಿಸಿಕೊಂಡು ನಾನು ಎಲ್ಲಿಗೆ ಹೊರಟು ಹೋಗಲಿ?<verse eid="PSA 139:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 139:8"/>ನಾನು ಆಕಾಶಕ್ಕೆ ಏರಿ ಹೋದರೆ, ನೀವು ಅಲ್ಲಿ ಇದ್ದೀರಿ;</para>
  <para style="q2" vid="PSA 139:8">ಪಾತಾಳಕ್ಕೆ ಹೋಗಿ ನಿದ್ರಿಸಿದರೂ ನೀವು ಅಲ್ಲಿಯೂ ಇದ್ದೀರಿ.<verse eid="PSA 139:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 139:9"/>ಉದಯದ ರೆಕ್ಕೆಗಳನ್ನು ತೆಗೆದುಕೊಂಡು,</para>
  <para style="q2" vid="PSA 139:9">ಸಮುದ್ರದ ಕಟ್ಟಕಡೆಯಲ್ಲಿ ವಾಸಮಾಡಿದರೆ,<verse eid="PSA 139:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 139:10"/>ಅಲ್ಲಿಯೂ ನಿಮ್ಮ ಕೈ ನನ್ನನ್ನು ನಡೆಸುವುದು,</para>
  <para style="q2" vid="PSA 139:10">ನಿಮ್ಮ ಬಲಗೈ ನನ್ನನ್ನು ಹಿಡಿದಿರುವುದು.<verse eid="PSA 139:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 139:11"/>“ಕತ್ತಲೆಯು ನನ್ನನ್ನು ಕವಿದುಕೊಳ್ಳಲಿ</para>
  <para style="q2" vid="PSA 139:11">ಮತ್ತು ಬೆಳಕು ನನ್ನ ಸುತ್ತಲೂ ಇರುಳಾಗಲಿ,”</para>
  <para style="q2" vid="PSA 139:11">ಎಂದು ನಾನು ಹೇಳಿದರೂ,<verse eid="PSA 139:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 139:12"/>ಕತ್ತಲು ನಿಮಗೆ ಕತ್ತಲಾಗಿರುವುದಿಲ್ಲ;</para>
  <para style="q2" vid="PSA 139:12">ರಾತ್ರಿಯು ಹಗಲಿನ ಹಾಗೆ ಪ್ರಕಾಶಿಸುವುದು,</para>
  <para style="q2" vid="PSA 139:12">ಏಕೆಂದರೆ ಕತ್ತಲು ನಿಮಗೆ ಬೆಳಕಿನಂತಿರುವುದು.<verse eid="PSA 139:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 139:13"/>ನನ್ನ ಅಂತರಾತ್ಮವನ್ನು ಉಂಟು ಮಾಡಿದವರು ನೀವೇ;</para>
  <para style="q2" vid="PSA 139:13">ನನ್ನ ತಾಯಿಯ ಗರ್ಭದಲ್ಲಿ ನನ್ನನ್ನು ರೂಪಿಸಿದವರು ನೀವೇ.<verse eid="PSA 139:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 139:14"/>ನೀವು ನನ್ನನ್ನು ವಿಚಿತ್ರವಾಗಿಯೂ ವಿಸ್ಮಯವಾಗಿಯೂ ಸೃಷ್ಟಿಸಿದ್ದರಿಂದ</para>
  <para style="q2" vid="PSA 139:14">ನಾನು ನಿಮ್ಮನ್ನು ಸ್ತುತಿಸುತ್ತೇನೆ;</para>
  <para style="q2" vid="PSA 139:14">ನಿಮ್ಮ ಕೃತ್ಯಗಳು ಆಶ್ಚರ್ಯಕರವಾಗಿವೆ ಎಂದು,</para>
  <para style="q2" vid="PSA 139:14">ನಾನು ಪೂರ್ಣವಾಗಿ ತಿಳಿದಿದ್ದೇನೆ.<verse eid="PSA 139:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 139:15"/>ನೀವು ನನ್ನನ್ನು ಮರೆಯಲ್ಲಿ ರೂಪಿಸಿದಾಗಲೂ,</para>
  <para style="q2" vid="PSA 139:15">ಭೂಗರ್ಭದಲ್ಲಿ ನನ್ನನ್ನು ರಚಿಸಿದಾಗಲೂ</para>
  <para style="q2" vid="PSA 139:15">ನನ್ನ ಅಸ್ಥಿಪಂಜರವು ನಿಮಗೆ ಮರೆಯಾಗಿರಲಿಲ್ಲ.<verse eid="PSA 139:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 139:16"/>ನಾನು ಇನ್ನೂ ಭ್ರೂಣವಾಗಿರುವಾಗಲೇ ನಿಮ್ಮ ಕಣ್ಣುಗಳು ನನ್ನನ್ನು ನೋಡಿದವು;</para>
  <para style="q2" vid="PSA 139:16">ನೀವು ನನಗೆ ಅನುಮತಿಸಿರುವ ಪ್ರಥಮ ದಿನದಿಂದ ಕೊನೆಯದಿನದವರೆಗೆ</para>
  <para style="q2" vid="PSA 139:16">ನನ್ನ ಎಲ್ಲಾ ದಿನಗಳೂ ನಿಮ್ಮ ಪುಸ್ತಕದಲ್ಲಿ ಬರೆಯಲಾಗಿವೆ.<verse eid="PSA 139:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 139:17"/>ದೇವರೇ, ನಿಮ್ಮ ಆಲೋಚನೆಗಳು ನನಗೆ ಎಷ್ಟೋ ಅಮೂಲ್ಯವಾಗಿವೆ!</para>
  <para style="q2" vid="PSA 139:17">ಅವುಗಳ ಎಣಿಕೆ ನನಗೆ ಎಷ್ಟೋ ಅಸಂಖ್ಯವಾಗಿವೆ!<verse eid="PSA 139:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 139:18"/>ನಾನು ಅವುಗಳನ್ನು ಎಣಿಸಿದರೆ,</para>
  <para style="q2" vid="PSA 139:18">ಅವು ಮರಳಿಗಿಂತಲೂ ಹೆಚ್ಚಾಗಿವೆ!</para>
  <para style="q2" vid="PSA 139:18">ನಾನು ಎಚ್ಚರವಾಗುವಾಗ, ನಿಶ್ಚಯವಾಗಿಯೂ ನಿಮ್ಮ ಸಂಗಡ ಇರುವೆನು.<verse eid="PSA 139:18"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 139:19"/>ದೇವರೇ, ಒಂದು ವೇಳೆ ನೀವು ದುಷ್ಟರೆಲ್ಲರನ್ನು</para>
  <para style="q2" vid="PSA 139:19">ದಂಡಿಸಿಬಿಟ್ಟರೆ ಎಷ್ಟೋ ಒಳ್ಳೆಯದಾಗಿರುವುದು!</para>
  <para style="q2" vid="PSA 139:19">ಕೊಲೆಪಾತಕರೇ, ನೀವು ನನ್ನಿಂದ ತೊಲಗಿ ಹೋದರೆ ಎಷ್ಟೋ ಹಿತ!<verse eid="PSA 139:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 139:20"/>ಅವರು ನಿಮಗೆ ವಿರೋಧವಾಗಿ ಮಾತಾಡುತ್ತಾರೆ;</para>
  <para style="q2" vid="PSA 139:20">ನಿಮ್ಮ ವೈರಿಗಳು ನಿಮ್ಮ ಹೆಸರನ್ನು ದುರುಪಯೋಗ ಮಾಡುತ್ತಾರೆ.<verse eid="PSA 139:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 139:21"/>ಯೆಹೋವ ದೇವರೇ, ನಿಮ್ಮನ್ನು ದ್ವೇಷಿಸುವವರನ್ನು ನಾನು ದ್ವೇಷಿಸದಿರುವೆನೋ?</para>
  <para style="q2" vid="PSA 139:21">ನಿಮಗೆ ವಿರೋಧವಾಗಿ ತಿರುಗಿ ಬಿದ್ದವರನ್ನು ನಾನು ಹೀನೈಸದಿರುವೆನೋ?<verse eid="PSA 139:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 139:22"/>ನಾನು ಪೂರ್ಣ ದ್ವೇಷದಿಂದ ಅವರನ್ನು ಹಗೆಮಾಡುತ್ತೇನೆ;</para>
  <para style="q2" vid="PSA 139:22">ನಾನು ಅವರನ್ನು ನನ್ನ ಶತ್ರುಗಳಂತೆ ಪರಿಗಣಿಸುತ್ತೇನೆ.<verse eid="PSA 139:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 139:23"/>ದೇವರೇ, ನನ್ನನ್ನು ಪರಿಶೋಧಿಸಿ, ನನ್ನ ಹೃದಯವನ್ನು ತಿಳಿದುಕೊಳ್ಳಿರಿ;</para>
  <para style="q2" vid="PSA 139:23">ನನ್ನನ್ನು ಪರೀಕ್ಷಿಸಿ, ನನ್ನ ಚಿಂತಾಲೋಚನೆಗಳನ್ನು ತಿಳಿದುಕೊಳ್ಳಿರಿ.<verse eid="PSA 139:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 139:24"/>ನನ್ನಲ್ಲಿ ಕೇಡಿನ ಮಾರ್ಗವಿದೆಯೋ ಎಂದು ನೋಡಿರಿ,</para>
  <para style="q2" vid="PSA 139:24">ನನ್ನನ್ನು ನಿತ್ಯ ಮಾರ್ಗದಲ್ಲಿ ನಡೆಸಿರಿ.<verse eid="PSA 139:24"/></para>
  <chapter eid="PSA 139"/>
  <chapter number="140" style="c" sid="PSA 140"/>
  <para style="cl">ಕೀರ್ತನೆ 140</para>
  <para style="d">ಸಂಗೀತ ನಿರ್ದೇಶಕನಿಗಾಗಿರುವ ಕೀರ್ತನೆ. ದಾವೀದನ ಕೀರ್ತನೆ.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 140:1"/>ಯೆಹೋವ ದೇವರೇ, ಕೆಡುಕರಿಂದ ನನ್ನನ್ನು ತಪ್ಪಿಸಿರಿ,</para>
  <para style="q2" vid="PSA 140:1">ಬಲಾತ್ಕಾರಿಗಳಿಂದ ನನ್ನನ್ನು ತಪ್ಪಿಸಿ ಕಾಪಾಡಿರಿ.<verse eid="PSA 140:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 140:2"/>ಅವರು ಹೃದಯದಲ್ಲಿ ಕೇಡನ್ನು ಕಲ್ಪಿಸುತ್ತಾರೆ;</para>
  <para style="q2" vid="PSA 140:2">ಅವರು ಪ್ರತಿದಿನ ಕಲಹವೆಬ್ಬಿಸುತ್ತಾರೆ.<verse eid="PSA 140:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 140:3"/>ತಮ್ಮ ನಾಲಿಗೆಗಳನ್ನು ಹಾವಿನ ಹಾಗೆ ಹದಮಾಡುತ್ತಾರೆ;</para>
  <para style="q2" vid="PSA 140:3">ಸರ್ಪಗಳ ವಿಷವು ಅವರ ತುಟಿಗಳ ಕೆಳಗಿದೆ.<verse eid="PSA 140:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 140:4"/>ಯೆಹೋವ ದೇವರೇ, ದುಷ್ಟರ ಕೈಗಳಿಂದ ನನ್ನನ್ನು ತಪ್ಪಿಸಿ ಕಾಯಿರಿ.</para>
  <para style="q2" vid="PSA 140:4">ಹಿಂಸಕರಿಂದ ನನ್ನನ್ನು ರಕ್ಷಿಸು,</para>
  <para style="q2" vid="PSA 140:4">ಅವರು ನನ್ನ ಮಾರ್ಗಗಳನ್ನು ಕೆಡಿಸುವುದಕ್ಕೆ ಉದ್ದೇಶಿಸುತ್ತಾರೆ.<verse eid="PSA 140:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 140:5"/>ಗರ್ವಿಷ್ಠರು ನನಗೆ ಉರುಲನ್ನೂ, ಪಾಶಗಳನ್ನೂ ರಹಸ್ಯವಾಗಿ ಇಟ್ಟಿದ್ದಾರೆ;</para>
  <para style="q2" vid="PSA 140:5">ಬಲೆಯನ್ನು ದಾರಿಯ ಅಂಚಿನಲ್ಲಿ ಹಾಸಿದ್ದಾರೆ;</para>
  <para style="q2" vid="PSA 140:5">ನನಗೆ ಬೋನಿಟ್ಟಿದ್ದಾರೆ.<verse eid="PSA 140:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 140:6"/>ನಾನು ಯೆಹೋವ ದೇವರಿಗೆ ಹೀಗೆ ಹೇಳಿದೆನು,</para>
  <para style="q2" vid="PSA 140:6">“ನೀವು ನನ್ನ ದೇವರಾಗಿದ್ದೀರಿ;</para>
  <para style="q2" vid="PSA 140:6">ಯೆಹೋವ ದೇವರೇ, ಕರುಣೆಗಾಗಿ ಬೇಡುವ ನನ್ನ ಮೊರೆಗೆ ಕಿವಿಗೊಡಿರಿ.<verse eid="PSA 140:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 140:7"/>ನನ್ನ ರಕ್ಷಣೆಯ ಬಲವಾಗಿರುವ ಸಾರ್ವಭೌಮ ಯೆಹೋವ ದೇವರೇ,</para>
  <para style="q2" vid="PSA 140:7">ನನ್ನ ತಲೆಯನ್ನು ಯುದ್ಧದ ದಿವಸದಲ್ಲಿ ಕಾಪಾಡುತ್ತೀರಿ.<verse eid="PSA 140:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 140:8"/>ಯೆಹೋವ ದೇವರೇ, ದುಷ್ಟರಿಗೆ ಅವರ ಇಷ್ಟಾರ್ಥವನ್ನು ಕೊಡಬೇಡಿರಿ;</para>
  <para style="q2" vid="PSA 140:8">ಅವರು ಉನ್ನತಕ್ಕೇರುವ ಹಾಗೆ ಅವರ ಯುಕ್ತಿಯನ್ನು ಪೂರೈಸಬೇಡಿರಿ.”<verse eid="PSA 140:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 140:9"/>ನನ್ನನ್ನು ಸುತ್ತಿಕೊಂಡಿರುವವರ ತುಟಿಗಳ ಕೇಡು,</para>
  <para style="q2" vid="PSA 140:9">ಅವರ ತಲೆಯ ಮೇಲೇ ಬರಲಿ.<verse eid="PSA 140:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 140:10"/>ಉರಿ ಕೆಂಡಗಳು ಅವರ ಮೇಲೆ ಬೀಳಲಿ;</para>
  <para style="q2" vid="PSA 140:10">ಬೆಂಕಿಯಲ್ಲಿಯೂ ಅವರು ಏಳಲಾರದ ಹಾಗೆ,</para>
  <para style="q2" vid="PSA 140:10">ಇತರರು ಅವರನ್ನು ಕುಣಿಯಲ್ಲಿ ಕೆಡವಲಿ.<verse eid="PSA 140:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 140:11"/>ಚಾಡಿಕೋರರು ದೇಶದಲ್ಲಿ ಉಳಿಯದಿರಲಿ;</para>
  <para style="q2" vid="PSA 140:11">ಬಲಾತ್ಕಾರಿಯನ್ನು ಕೇಡು ಬೇಟೆಯಾಡಿ ಕೆಡವಲಿ.<verse eid="PSA 140:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 140:12"/>ಯೆಹೋವ ದೇವರು ಬಡವನಿಗೆ ವ್ಯಾಜ್ಯವನ್ನು,</para>
  <para style="q2" vid="PSA 140:12">ಬಲಹೀನರಿಗೆ ನ್ಯಾಯವನ್ನೂ ತೀರಿಸುವರೆಂದೂ ನಾನು ಬಲ್ಲೆನು.<verse eid="PSA 140:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 140:13"/>ನಿಶ್ಚಯವಾಗಿ ನೀತಿವಂತರು ನಿಮ್ಮ ಹೆಸರಿಗೆ ಉಪಕಾರ ಸ್ತುತಿಯನ್ನು ಮಾಡುವರು;</para>
  <para style="q2" vid="PSA 140:13">ಯಥಾರ್ಥರು ನಿಮ್ಮ ಸನ್ನಿಧಿಯಲ್ಲಿ ಬಾಳುವರು.<verse eid="PSA 140:13"/></para>
  <chapter eid="PSA 140"/>
  <chapter number="141" style="c" sid="PSA 141"/>
  <para style="cl">ಕೀರ್ತನೆ 141</para>
  <para style="d">ದಾವೀದನ ಕೀರ್ತನೆ.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 141:1"/>ಯೆಹೋವ ದೇವರೇ, ನಿಮಗೆ ಮೊರೆಯಿಡುತ್ತೇನೆ, ನನ್ನ ಬಳಿಗೆ ಬರಲು ತ್ವರೆಪಡಿರಿ.</para>
  <para style="q2" vid="PSA 141:1">ನಾನು ನಿಮ್ಮನ್ನು ಕರೆಯುವಾಗ, ನನಗೆ ಕಿವಿಗೊಡಿರಿ.<verse eid="PSA 141:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 141:2"/>ನನ್ನ ಪ್ರಾರ್ಥನೆ ನಿಮ್ಮ ಮುಂದೆ ಧೂಪವಾಗಿರಲಿ,</para>
  <para style="q2" vid="PSA 141:2">ನಾನು ನಿಮ್ಮ ಕಡೆ ಕೈ ಎತ್ತುವುದು ಸಾಯಂಕಾಲದ ಬಲಿಯಂತೆ ನಿಮಗೆ ಸಮರ್ಪಕವಾಗಿರಲಿ.<verse eid="PSA 141:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 141:3"/>ಯೆಹೋವ ದೇವರೇ, ನನ್ನ ಬಾಯಿಗೆ ಕಾವಲಿಡಿರಿ;</para>
  <para style="q2" vid="PSA 141:3">ನನ್ನ ತುಟಿಗಳ ಕದವನ್ನು ಕಾಯಿರಿ;<verse eid="PSA 141:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 141:4"/>ಅಪರಾಧ ಮಾಡುವವರ ಸಂಗಡ ನಾನು ಸಹ ಸೇರಿಕೊಂಡು</para>
  <para style="q2" vid="PSA 141:4">ಕೆಟ್ಟ ಕಾರ್ಯಗಳನ್ನು ಮಾಡಲು</para>
  <para style="q1" vid="PSA 141:4">ನನ್ನ ಹೃದಯ ಸೆಳೆಯದಂತೆ ಕಾಪಾಡಿರಿ;</para>
  <para style="q2" vid="PSA 141:4">ಅವರ ಸವಿ ಊಟಗಳನ್ನು ನಾನು ಉಣ್ಣದಿರಲಿ.<verse eid="PSA 141:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 141:5"/>ನೀತಿವಂತರು ನನ್ನನ್ನು ಹೊಡೆಯಲಿ, ಅದು ನನಗೆ ಉಪಕಾರ.</para>
  <para style="q2" vid="PSA 141:5">ಅವರು ನನ್ನನ್ನು ಗದರಿಸಲಿ, ಅದು ನನ್ನ ತಲೆಗೆ ಅಭಿಷೇಕ;</para>
  <para style="q1" vid="PSA 141:5">ನನ್ನ ತಲೆ ಅದನ್ನು ಬೇಡವೆನ್ನದಿರಲಿ;</para>
  <para style="q2" vid="PSA 141:5">ಆದರೂ ನನ್ನ ಪ್ರಾರ್ಥನೆ ಯಾವಾಗಲೂ ದುಷ್ಟರ ಕಾರ್ಯಗಳಿಗೆ ವಿರೋಧವಾಗಿಯೇ ಇರುವುದು.<verse eid="PSA 141:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 141:6"/>ಅವರ ನ್ಯಾಯಾಧಿಪತಿಗಳು ಉನ್ನತ ಸ್ಥಳದಿಂದ ಕೆಳಬಿದ್ದಾಗ</para>
  <para style="q2" vid="PSA 141:6">ಅವರು ನನ್ನ ಮಾತು ಕೇಳುವರು.<verse eid="PSA 141:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 141:7"/>ಅವರು ಹೀಗೆ ಹೇಳುವರು, “ಒಬ್ಬನು ಹೊಲವನ್ನು ಉತ್ತು, ಹೆಂಟೆಗಳನ್ನು ಒಡೆದು</para>
  <para style="q2" vid="PSA 141:7">ಚದರಿಸುವ ಪ್ರಕಾರವೇ ನಮ್ಮ ಎಲುಬುಗಳು ಪಾತಾಳ ದ್ವಾರದಲ್ಲಿ ಎರಚಲಾಗುವುದು.”<verse eid="PSA 141:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 141:8"/>ಆದರೆ ಸಾರ್ವಭೌಮ ಯೆಹೋವ ದೇವರೇ, ನನ್ನ ಕಣ್ಣುಗಳು ನಿಮ್ಮ ಕಡೆ ಇವೆ;</para>
  <para style="q2" vid="PSA 141:8">ನಿಮ್ಮನ್ನು ಆಶ್ರಯಿಸಿಕೊಂಡಿದ್ದೇನೆ, ನನ್ನ ಪ್ರಾಣವನ್ನು ಮರಣಕ್ಕೆ ಒಪ್ಪಿಸಬೇಡಿರಿ.<verse eid="PSA 141:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 141:9"/>ಅವರು ನನಗೆ ಒಡ್ಡಿದ ಉರುಲಿನಿಂದಲೂ,</para>
  <para style="q2" vid="PSA 141:9">ಅಪರಾಧಗಳ ನೇಣುಗಳಿಂದಲೂ ನನ್ನನ್ನು ಕಾಪಾಡಿರಿ.<verse eid="PSA 141:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 141:10"/>ನಾನು ತಪ್ಪಿಸಿಕೊಂಡು ಸುರಕ್ಷಿತವಾಗಿ ಹೋಗುವಷ್ಟರಲ್ಲಿ</para>
  <para style="q2" vid="PSA 141:10">ದುಷ್ಟರು ತಮ್ಮ ಬಲೆಗಳಲ್ಲಿಯೇ ಬೀಳಲಿ.<verse eid="PSA 141:10"/></para>
  <chapter eid="PSA 141"/>
  <chapter number="142" style="c" sid="PSA 142"/>
  <para style="cl">ಕೀರ್ತನೆ 142</para>
  <para style="d">ದಾವೀದನ <char style="tl">ಮಾಸ್ಕಿಲ</char> ರಾಗದ ಪದ್ಯ. ಅವನು ಗುಹೆಯಲ್ಲಿ ಅಡಗಿಕೊಂಡಿದ್ದಾಗ ಮಾಡಿದ ಪ್ರಾರ್ಥನೆ.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 142:1"/>ನನ್ನ ಸ್ವರವೆತ್ತಿ ಯೆಹೋವ ದೇವರಿಗೆ ಮೊರೆಯಿಟ್ಟಿದ್ದೇನೆ;</para>
  <para style="q2" vid="PSA 142:1">ಸ್ವರವೆತ್ತಿ ನನ್ನ ಯೆಹೋವ ದೇವರಿಗೆ ವಿಜ್ಞಾಪನೆ ಮಾಡಿದ್ದೇನೆ.<verse eid="PSA 142:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 142:2"/>ದೇವರ ಮುಂದೆ ನನ್ನ ಚಿಂತೆಯನ್ನು ಹೊಯ್ದಿದ್ದೇನೆ;</para>
  <para style="q2" vid="PSA 142:2">ನನ್ನ ಇಕ್ಕಟ್ಟನ್ನು ದೇವರ ಮುಂದೆ ತಿಳಿಸಿದ್ದೇನೆ.<verse eid="PSA 142:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 142:3"/>ನನ್ನ ಆತ್ಮವು ನನ್ನಲ್ಲಿ ಕುಂದಿ ಹೋದಾಗ,</para>
  <para style="q2" vid="PSA 142:3">ದೇವರೇ ನೀವು ನನ್ನ ದಾರಿಯನ್ನು ಕಾಯುತ್ತೀರಿ;</para>
  <para style="q1" vid="PSA 142:3">ನಾನು ನಡೆಯುವ ದಾರಿಯಲ್ಲಿ ವೈರಿಗಳು ಗುಪ್ತವಾಗಿ</para>
  <para style="q2" vid="PSA 142:3">ನನಗೆ ಉರುಲನ್ನು ಒಡ್ಡಿದ್ದಾರೆ.<verse eid="PSA 142:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 142:4"/>ನೋಡಿರಿ ನನ್ನ ಬಲಗಡೆಯಲ್ಲಿ,</para>
  <para style="q2" vid="PSA 142:4">ನನ್ನ ಪರವಾಗಿ ಯಾರೂ ಇಲ್ಲ;</para>
  <para style="q1" vid="PSA 142:4">ಆಶ್ರಯವು ನನಗೆ ಇಲ್ಲ;</para>
  <para style="q2" vid="PSA 142:4">ನನಗಾಗಿ ಚಿಂತಿಸುವವರು ಯಾರೂ ಇಲ್ಲ.<verse eid="PSA 142:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 142:5"/>ಯೆಹೋವ ದೇವರೇ, ನಿಮಗೆ ಹೀಗೆಂದು ಮೊರೆಯಿಡುತ್ತೇನೆ:</para>
  <para style="q2" vid="PSA 142:5">“ನೀವು ನನ್ನ ಆಶ್ರಯವೂ,</para>
  <para style="q2" vid="PSA 142:5">ಜೀವಿತರ ದೇಶದಲ್ಲಿ ನನ್ನ ಪಾಲೂ ಆಗಿದ್ದೀರಿ.”<verse eid="PSA 142:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 142:6"/>ನನ್ನ ಕೂಗನ್ನು ಆಲೈಸಿರಿ,</para>
  <para style="q2" vid="PSA 142:6">ಏಕೆಂದರೆ ನಾನು ಬಹಳ ಕುಂದಿಹೋಗಿದ್ದೇನೆ;</para>
  <para style="q1" vid="PSA 142:6">ನನ್ನನ್ನು ಹಿಂಸಿಸುವವರಿಂದ ನನ್ನನ್ನು ಬಿಡಿಸಿರಿ,</para>
  <para style="q2" vid="PSA 142:6">ಏಕೆಂದರೆ ಅವರು ನನಗಿಂತ ಬಲಿಷ್ಠರಾಗಿದ್ದಾರೆ.<verse eid="PSA 142:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 142:7"/>ನಿಮ್ಮ ಹೆಸರನ್ನು ಕೊಂಡಾಡುವ</para>
  <para style="q2" vid="PSA 142:7">ಹಾಗೆ ನನ್ನ ಸೆರೆಯಿಂದ ನನ್ನನ್ನು ಬಿಡಿಸಿರಿ;</para>
  <para style="q1" vid="PSA 142:7">ಆಗ ನೀವು ನನಗೆ ಮಾಡಿದ ಉಪಕಾರವನ್ನು ಕಂಡು</para>
  <para style="q2" vid="PSA 142:7">ನೀತಿವಂತರು ನನ್ನ ಹತ್ತಿರ ಸೇರಿಬರುವರು.<verse eid="PSA 142:7"/></para>
  <chapter eid="PSA 142"/>
  <chapter number="143" style="c" sid="PSA 143"/>
  <para style="cl">ಕೀರ್ತನೆ 143</para>
  <para style="d">ದಾವೀದನ ಕೀರ್ತನೆ.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 143:1"/>ಯೆಹೋವ ದೇವರೇ, ನನ್ನ ಪ್ರಾರ್ಥನೆಯನ್ನು ಕೇಳಿರಿ;</para>
  <para style="q2" vid="PSA 143:1">ನನ್ನ ವಿಜ್ಞಾಪನೆಗಳಿಗೆ ಕಿವಿಗೊಡಿರಿ;</para>
  <para style="q1" vid="PSA 143:1">ನಿಮ್ಮ ನಂಬಿಗಸ್ತಿಕೆಯಲ್ಲಿಯೂ,</para>
  <para style="q2" vid="PSA 143:1">ನಿಮ್ಮ ನೀತಿಯಲ್ಲಿಯೂ ನನಗೆ ಉತ್ತರಕೊಡಿರಿ.<verse eid="PSA 143:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 143:2"/>ನಿಮ್ಮ ಸೇವಕನನ್ನು ನ್ಯಾಯವಿಚಾರಣೆಗೆ ಗುರಿಮಾಡಬೇಡಿರಿ,</para>
  <para style="q2" vid="PSA 143:2">ಏಕೆಂದರೆ ಜೀವಿಸುವರಲ್ಲಿ ಒಬ್ಬರೂ ನಿಮ್ಮ ಮುಂದೆ ನೀತಿವಂತರಲ್ಲ.<verse eid="PSA 143:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 143:3"/>ಏಕೆಂದರೆ ಶತ್ರುವು ನನ್ನನ್ನು ಬೆನ್ನಟ್ಟಿ,</para>
  <para style="q2" vid="PSA 143:3">ನಾನು ನೆಲಕಚ್ಚುವಂತೆ ಮಾಡಿದ್ದಾನೆ.</para>
  <para style="q1" vid="PSA 143:3">ಬಹುಕಾಲದ ಹಿಂದೆ ಸತ್ತವರ ಹಾಗೆ ನನ್ನನ್ನು</para>
  <para style="q2" vid="PSA 143:3">ಕತ್ತಲೆಯಲ್ಲಿ ವಾಸಿಸುವಂತೆ ಮಾಡಿದ್ದಾನೆ.<verse eid="PSA 143:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 143:4"/>ನನ್ನ ಆತ್ಮವು ನನ್ನಲ್ಲಿ ಕುಂದಿಹೋಗಿದೆ;</para>
  <para style="q2" vid="PSA 143:4">ನನ್ನೊಳಗೆ ನನ್ನ ಹೃದಯವು ಹಾಳಾಗಿದೆ.<verse eid="PSA 143:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 143:5"/>ಪೂರ್ವಕಾಲದ ದಿವಸಗಳನ್ನು ಜ್ಞಾಪಕಮಾಡಿಕೊಂಡು,</para>
  <para style="q2" vid="PSA 143:5">ನಿಮ್ಮ ಎಲ್ಲಾ ಕ್ರಿಯೆಗಳಲ್ಲಿ ಧ್ಯಾನಮಾಡಿ,</para>
  <para style="q2" vid="PSA 143:5">ನಿಮ್ಮ ಕೈಕೆಲಸವನ್ನು ಆಲೋಚಿಸುತ್ತೇನೆ.<verse eid="PSA 143:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 143:6"/>ನನ್ನ ಕೈಗಳನ್ನು ನಿಮ್ಮ ಕಡೆಗೆ ಚಾಚುತ್ತೇನೆ;</para>
  <para style="q2" vid="PSA 143:6">ನನ್ನ ಪ್ರಾಣವು ದಾಹಗೊಂಡ ಭೂಮಿಯ ಹಾಗೆ ನಿಮಗಾಗಿ ದಾಹಗೊಂಡಿದೆ.<verse eid="PSA 143:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 143:7"/>ಯೆಹೋವ ದೇವರೇ, ನನಗೆ ಬೇಗನೆ ಉತ್ತರಕೊಡಿರಿ;</para>
  <para style="q2" vid="PSA 143:7">ನನ್ನ ಪ್ರಾಣವು ಕುಂದಿಹೋಗಿದೆ;</para>
  <para style="q1" vid="PSA 143:7">ನಿಮ್ಮ ಮುಖವನ್ನು ನನಗೆ ಮರೆಮಾಡಬೇಡ;</para>
  <para style="q2" vid="PSA 143:7">ಇಲ್ಲವಾದರೆ ಸಮಾಧಿಯಲ್ಲಿ ಇಳಿಯುವವರಿಗೆ ಸಮಾನನಾಗಿಬಿಡುತ್ತೇನೆ.<verse eid="PSA 143:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 143:8"/>ಬೆಳಿಗ್ಗೆ ನಿಮ್ಮ ಒಡಂಬಡಿಕೆಯ ಪ್ರೀತಿಯು ನನಗೆ ವಾಕ್ಯವನ್ನು ತರಲಿ;</para>
  <para style="q2" vid="PSA 143:8">ಏಕೆಂದರೆ ನಿಮ್ಮಲ್ಲಿ ಭರವಸವಿಟ್ಟಿದ್ದೇನೆ;</para>
  <para style="q1" vid="PSA 143:8">ನಾನು ಹೋಗಬೇಕಾದ ಮಾರ್ಗವನ್ನು ನನಗೆ ತಿಳಿಯಪಡಿಸಿರಿ,</para>
  <para style="q2" vid="PSA 143:8">ಏಕೆಂದರೆ ನನ್ನ ಪ್ರಾಣವನ್ನು ನಿಮಗೇ ಒಪ್ಪಿಸಿದ್ದೇನೆ.<verse eid="PSA 143:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 143:9"/>ಯೆಹೋವ ದೇವರೇ, ನನ್ನ ಶತ್ರುಗಳಿಂದ ನನ್ನನ್ನು ಬಿಡಿಸಿರಿ;</para>
  <para style="q2" vid="PSA 143:9">ನಾನು ನಿಮ್ಮಲ್ಲಿ ಅಡಗಿಕೊಳ್ಳುವಂತೆ ನಿಮ್ಮ ಬಳಿಗೆ ಬಂದಿದ್ದೇನೆ.<verse eid="PSA 143:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 143:10"/>ನಿಮ್ಮ ಚಿತ್ತದಂತೆ ಮಾಡುವುದಕ್ಕೆ ನನಗೆ ಬೋಧಿಸಿರಿ,</para>
  <para style="q2" vid="PSA 143:10">ಏಕೆಂದರೆ ನೀವು ನನ್ನ ದೇವರು;</para>
  <para style="q1" vid="PSA 143:10">ನಿಮ್ಮ ಒಳ್ಳೆಯ ಆತ್ಮವು</para>
  <para style="q2" vid="PSA 143:10">ನನ್ನನ್ನು ಸಮಹಾದಿಯಲ್ಲಿ ನಡೆಸಲಿ.<verse eid="PSA 143:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 143:11"/>ಯೆಹೋವ ದೇವರೇ, ನಿಮ್ಮ ಹೆಸರಿನ ನಿಮಿತ್ತ ನನ್ನನ್ನು ಜೀವಿಸಮಾಡಿರಿ,</para>
  <para style="q2" vid="PSA 143:11">ನಿಮ್ಮ ನೀತಿಗನುಸಾರ ನನ್ನ ಪ್ರಾಣವನ್ನು ಇಕ್ಕಟ್ಟಿನೊಳಗಿಂದ ಬಿಡಿಸಿರಿ.<verse eid="PSA 143:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 143:12"/>ನಿಮ್ಮ ಒಂಡಬಡಿಕೆಯ ಪ್ರೀತಿಯಿಂದ ನನ್ನ ಶತ್ರುಗಳನ್ನು ಸುಮ್ಮನಿರಿಸುವೆನು,</para>
  <para style="q2" vid="PSA 143:12">ನನ್ನ ವೈರಿಗಳೆಲ್ಲರೂ ನಾಶವಾಗಲಿ,</para>
  <para style="q2" vid="PSA 143:12">ನಾನು ನಿಮ್ಮ ಸೇವಕನಾಗಿದ್ದೇನೆ.<verse eid="PSA 143:12"/></para>
  <chapter eid="PSA 143"/>
  <chapter number="144" style="c" sid="PSA 144"/>
  <para style="cl">ಕೀರ್ತನೆ 144</para>
  <para style="d">ದಾವೀದನ ಕೀರ್ತನೆ.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 144:1"/>ನನ್ನ ಬಲವಾಗಿರುವ ಯೆಹೋವ ದೇವರಿಗೆ ಸ್ತೋತ್ರವಾಗಲಿ.</para>
  <para style="q2" vid="PSA 144:1">ದೇವರು ನನ್ನ ಕೈಗಳಿಗೆ ಕಾಳಗವನ್ನು,</para>
  <para style="q2" vid="PSA 144:1">ನನ್ನ ಬೆರಳುಗಳಿಗೆ ಯುದ್ಧವಿದ್ಯೆಯನ್ನು ಕಲಿಸಿದ್ದಾರೆ.<verse eid="PSA 144:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 144:2"/>ಅವರು ನನ್ನನ್ನು ಪ್ರೀತಿಸುವ ದೇವರು,</para>
  <para style="q2" vid="PSA 144:2">ಅವರು ನನ್ನ ಕೋಟೆಯೂ, ನನ್ನ ಬಲವಾದ ಆಶ್ರಯವೂ,</para>
  <para style="q1" vid="PSA 144:2">ನನ್ನನ್ನು ತಪ್ಪಿಸುವವರೂ, ನನ್ನ ಭರವಸೆಯೂ, ನನ್ನ ಗುರಾಣಿಯೂ,</para>
  <para style="q2" vid="PSA 144:2">ಜನಾಂಗಗಳನ್ನು ನನಗೆ ವಶಮಾಡುವವರೂ ಆಗಿದ್ದಾರೆ.<verse eid="PSA 144:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 144:3"/>ಯೆಹೋವ ದೇವರೇ, ನೀವು ಮಾನವನನ್ನು ಲಕ್ಷವಿಡುವ ಹಾಗೆ ಅವನು ಎಷ್ಟರವನು?</para>
  <para style="q2" vid="PSA 144:3">ನೀವು ಅವನನ್ನು ನೆನಸುವ ಹಾಗೆ ಮಾನವನು ಎಷ್ಟರವನು?<verse eid="PSA 144:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 144:4"/>ಮನುಷ್ಯನು ಕೇವಲ ಉಸಿರಿನಂತಿದ್ದಾನೆ;</para>
  <para style="q2" vid="PSA 144:4">ಅವನ ದಿವಸಗಳು ಅಳಿದು ಹೋಗುವ ನೆರಳಿನ ಹಾಗಿವೆ.<verse eid="PSA 144:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 144:5"/>ಯೆಹೋವ ದೇವರೇ, ನಿಮ್ಮ ಆಕಾಶಗಳನ್ನು ಒಡೆದು ಇಳಿದು ಬನ್ನಿರಿ;</para>
  <para style="q2" vid="PSA 144:5">ಬೆಟ್ಟಗಳನ್ನು ಮುಟ್ಟಿರಿ, ಆಗ ಅವುಗಳಿಂದ ಹೊಗೆ ಹೊರಹೊಮ್ಮುವುದು.<verse eid="PSA 144:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 144:6"/>ಮಿಂಚಿನಿಂದ ವೈರಿಗಳನ್ನು ಚದರಿಸಿರಿ.</para>
  <para style="q2" vid="PSA 144:6">ನಿಮ್ಮ ಬಾಣಗಳನ್ನು ಎಸೆದು, ಅವರನ್ನು ದಂಡಿಸಿರಿ.<verse eid="PSA 144:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 144:7"/>ನಿಮ್ಮ ಕೈಯನ್ನು ಉನ್ನತದಿಂದ ಚಾಚಿ,</para>
  <para style="q2" vid="PSA 144:7">ಮಹಾ ಜಲದಿಂದಲೂ,</para>
  <para style="q1" vid="PSA 144:7">ಪರದೇಶದವರ ಕೈಯಿಂದಲೂ</para>
  <para style="q2" vid="PSA 144:7">ನನ್ನನ್ನು ತಪ್ಪಿಸಿರಿ, ನನ್ನನ್ನು ಬಿಡಿಸಿರಿ.<verse eid="PSA 144:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 144:8"/>ಅವರ ಬಾಯಿ ಸುಳ್ಳನ್ನು ನುಡಿಯುತ್ತಿದೆ,</para>
  <para style="q2" vid="PSA 144:8">ಅವರ ಬಲಗೈ ಮೋಸದ ಬಲಗೈ ಆಗಿದೆ.<verse eid="PSA 144:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 144:9"/>ಓ ದೇವರೇ, ನಾನು ಹೊಸಹಾಡನ್ನು ನಿಮಗೆ ಹಾಡುವೆನು;</para>
  <para style="q2" vid="PSA 144:9">ಹತ್ತು ತಂತಿಗಳ ವಾದ್ಯದಿಂದ ನಿಮ್ಮನ್ನು ಕೀರ್ತಿಸುವೆನು.<verse eid="PSA 144:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 144:10"/>ಅರಸರಿಗೆ ಜಯವನ್ನು ಕೊಡುವ ದೇವರೇ,</para>
  <para style="q2" vid="PSA 144:10">ನಿಮ್ಮ ಸೇವಕನಾದ ದಾವೀದನನ್ನೂ ಭಯಂಕರ ಖಡ್ಗದಿಂದ ಬಿಡಿಸಿದ್ದೀರಿ.<verse eid="PSA 144:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 144:11"/>ಪರದೇಶದವರ ಕೈಯಿಂದ ನನ್ನನ್ನು ತಪ್ಪಿಸಿರಿ, ನನ್ನನ್ನು ಬಿಡಿಸಿರಿ;</para>
  <para style="q1" vid="PSA 144:11">ಅವರ ಬಾಯಿ ವಂಚನೆಯನ್ನು ನುಡಿಯುತ್ತಿದೆ.</para>
  <para style="q2" vid="PSA 144:11">ಅವರ ಬಾಯಿ ಸುಳ್ಳನ್ನೇ ನುಡಿಯುತ್ತಿದೆ.<verse eid="PSA 144:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 144:12"/>ನಮ್ಮ ಗಂಡು ಮಕ್ಕಳು ಸಸಿಗಳ ಹಾಗೆ</para>
  <para style="q2" vid="PSA 144:12">ಯೌವನದಲ್ಲಿ ಉತ್ತಮವಾಗಿ ಬೆಳೆದವರಾಗಿರಲಿ;</para>
  <para style="q1" vid="PSA 144:12">ನಮ್ಮ ಹೆಣ್ಣುಮಕ್ಕಳು ಅರಮನೆಯ ಶೃಂಗಾರಕ್ಕಾಗಿ</para>
  <para style="q2" vid="PSA 144:12">ಕೆತ್ತಿದ ಸುಂದರ ಸ್ತಂಭಗಳ ಹಾಗಿರಲಿ.<verse eid="PSA 144:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 144:13"/>ನಮ್ಮ ಉಗ್ರಾಣಗಳು</para>
  <para style="q2" vid="PSA 144:13">ನಾನಾ ವಿಧವಾದ ಧಾನ್ಯಗಳನ್ನು ತುಂಬಿರಲಿ.</para>
  <para style="q1" vid="PSA 144:13">ನಮ್ಮ ಕುರಿಮಂದೆಗಳು ಸಹಸ್ರ ಸಹಸ್ರವಾಗಿ</para>
  <para style="q2" vid="PSA 144:13">ನಮ್ಮ ಹೊಲಗಳಲ್ಲಿ ಹತ್ತು ಸಹಸ್ರವಾಗಿ ಹೆಚ್ಚಲಿ.<verse eid="PSA 144:13"/></para>
  <para style="q2">
    <verse number="14" style="v" sid="PSA 144:14"/>ನಮ್ಮ ಎತ್ತುಗಳು ಪ್ರಯಾಸ ಪಡುವುದಕ್ಕೆ ಬಲವುಳ್ಳವುಗಳಾಗಲಿ;</para>
  <para style="q1" vid="PSA 144:14">ವೈರಿಗಳು ಒಳಗೆ ನುಗ್ಗುವುದಾಗಲಿ,</para>
  <para style="q2" vid="PSA 144:14">ನಮ್ಮವರನ್ನು ಸೆರೆ ಹಿಡಿಯುವುದಾಗಲಿ ಇರುವುದಿಲ್ಲ.</para>
  <para style="q2" vid="PSA 144:14">ನಮ್ಮ ಬೀದಿಗಳಲ್ಲಿ ಗೋಳಾಟವು ಇಲ್ಲದಿರಲಿ.<verse eid="PSA 144:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 144:15"/>ಹೀಗಿರುವ ಜನರು ಧನ್ಯರು;</para>
  <para style="q2" vid="PSA 144:15">ಯೆಹೋವ ದೇವರು ಯಾರಿಗೆ ದೇವರಾಗಿದ್ದಾರೋ, ಅವರು ಧನ್ಯರು.<verse eid="PSA 144:15"/></para>
  <chapter eid="PSA 144"/>
  <chapter number="145" style="c" sid="PSA 145"/>
  <para style="cl">ಕೀರ್ತನೆ 145<note caller="+" style="f"><char style="fr" closed="false">145 </char><char style="ft" closed="false">ಈ ಕೀರ್ತನೆ, ಹೀಬ್ರೂ ಅಕ್ಷರ ಕ್ರಮಾನುಸಾರವಾದ ಕೀರ್ತನೆ.</char></note></para>
  <para style="d">ದಾವೀದನ ಕೀರ್ತನೆ.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 145:1"/>ಅರಸರಾಗಿರುವ ನನ್ನ ದೇವರೇ, ನಿಮ್ಮನ್ನು ಘನಪಡಿಸುವೆನು;</para>
  <para style="q2" vid="PSA 145:1">ನಿಮ್ಮ ಹೆಸರನ್ನು ಎಂದೆಂದಿಗೂ ಸ್ತುತಿಸುವೆನು.<verse eid="PSA 145:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 145:2"/>ಪ್ರತಿದಿನ ನಿಮ್ಮನ್ನು ಸ್ತುತಿಸುವೆನು;</para>
  <para style="q2" vid="PSA 145:2">ಎಂದೆಂದಿಗೂ ಸ್ತುತಿಸುವೆನು.<verse eid="PSA 145:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 145:3"/>ಯೆಹೋವ ದೇವರು ಮಹೋನ್ನತರೂ, ಬಹುಸ್ತುತಿಪಾತ್ರರೂ ಆಗಿದ್ದಾರೆ.</para>
  <para style="q2" vid="PSA 145:3">ಅವರ ಮಹತ್ವವು ಅಗಮ್ಯವಾದದ್ದು.<verse eid="PSA 145:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 145:4"/>ದೇವರೇ ಒಂದು ತಲಾಂತರವು ಇನ್ನೊಂದು ತಲಾಂತರಕ್ಕೆ ನಿಮ್ಮ ಕೆಲಸಗಳನ್ನು ಪ್ರಕಟಿಸುತ್ತದೆ;</para>
  <para style="q2" vid="PSA 145:4">ಜನರು ನಿಮ್ಮ ಪರಾಕ್ರಮಗಳನ್ನು ತಿಳಿಸುತ್ತಾರೆ.<verse eid="PSA 145:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 145:5"/>ನಿಮ್ಮ ಘನತೆಯ ಪ್ರಭಾವದ ಮಹಿಮೆಗಳ ವಿಷಯವಾಗಿಯೂ</para>
  <para style="q2" vid="PSA 145:5">ನಿಮ್ಮ ಅದ್ಭುತಕಾರ್ಯಗಳ ವಿಷಯವಾಗಿಯೂ ನಾನು ಧ್ಯಾನಿಸುತ್ತಿರುವೆನು,<verse eid="PSA 145:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 145:6"/>ನಿಮ್ಮ ಅತಿಶಯ ಶಕ್ತಿಯ ವಿಷಯವಾಗಿ ಅವರು ಹೇಳುವರು;</para>
  <para style="q2" vid="PSA 145:6">ನಿಮ್ಮ ಮಹಾಕಾರ್ಯವನ್ನು ನಾನು ಸಾರುವೆನು.<verse eid="PSA 145:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 145:7"/>ನಿಮ್ಮ ಬಹು ಒಳ್ಳೆಯತನದ ಜ್ಞಾಪಕವನ್ನು ಅವರು ನುಡಿಯುವರು;</para>
  <para style="q2" vid="PSA 145:7">ನಿಮ್ಮ ನೀತಿಯ ನಿಮಿತ್ತ ಉತ್ಸಾಹಧ್ವನಿ ಮಾಡುವರು.<verse eid="PSA 145:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 145:8"/>ಯೆಹೋವ ದೇವರು ಕೃಪಾಳುವೂ, ಅನುಕಂಪವೂ,</para>
  <para style="q2" vid="PSA 145:8">ದೀರ್ಘಶಾಂತಿಯೂ, ಪ್ರೀತಿ ಪೂರ್ಣರೂ ಆಗಿದ್ದಾರೆ.<verse eid="PSA 145:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 145:9"/>ಯೆಹೋವ ದೇವರು ಸರ್ವರಿಗೂ ಒಳ್ಳೆಯವರು.</para>
  <para style="q2" vid="PSA 145:9">ಅವರ ಅನುಕಂಪವು ತಮ್ಮ ಎಲ್ಲಾ ಸೃಷ್ಟಿಗಳ ಮೇಲೆ ಇದೆ.<verse eid="PSA 145:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 145:10"/>ಯೆಹೋವ ದೇವರೇ, ನಿಮ್ಮ ನಂಬಿಗಸ್ತರು</para>
  <para style="q2" vid="PSA 145:10">ನಿಮ್ಮನ್ನು ಸ್ತುತಿಸುವರು.<verse eid="PSA 145:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 145:11"/>ನಿಮ್ಮ ರಾಜ್ಯದ ಮಹಿಮೆಯನ್ನು ಹೇಳುವರು;</para>
  <para style="q2" vid="PSA 145:11">ನಿಮ್ಮ ಪರಾಕ್ರಮವನ್ನು ನುಡಿಯುವರು.<verse eid="PSA 145:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 145:12"/>ಮಾನವರಿಗೆ ನಿಮ್ಮ ಪರಾಕ್ರಮ ಕ್ರಿಯೆಗಳನ್ನೂ,</para>
  <para style="q2" vid="PSA 145:12">ನಿಮ್ಮ ರಾಜ್ಯದ ಪ್ರಭೆಯ ಘನವನ್ನೂ ತಿಳಿಯಪಡಿಸುವರು.<verse eid="PSA 145:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 145:13"/>ನಿಮ್ಮ ರಾಜ್ಯವು ಶಾಶ್ವತವಾದ ರಾಜ್ಯವಾಗಿದೆ;</para>
  <para style="q2" vid="PSA 145:13">ನಿಮ್ಮ ಅಧಿಪತ್ಯವು ಎಲ್ಲಾ ತಲತಲಾಂತರಗಳಲ್ಲಿ ಇರುವುದು.</para>
  <para style="b" vid="PSA 145:13"/>
  <para style="q1" vid="PSA 145:13">ಯೆಹೋವ ದೇವರು ತಮ್ಮ ಎಲ್ಲಾ ಪ್ರತಿಜ್ಞೆಗಳಲ್ಲಿ ನಂಬಿಗಸ್ತರಾಗಿರುತ್ತಾರೆ.</para>
  <para style="q2" vid="PSA 145:13">ಎಲ್ಲಾ ಕಾರ್ಯಗಳಲ್ಲಿಯೂ ಅವರ ಅನುಗ್ರಹ ಉಳಿದಿದೆ.<verse eid="PSA 145:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 145:14"/>ಯೆಹೋವ ದೇವರು ಬೀಳುವವರೆಲ್ಲರನ್ನು ಉದ್ಧಾರ ಮಾಡುತ್ತಾರೆ.</para>
  <para style="q2" vid="PSA 145:14">ತಗ್ಗಿಸಿಕೊಳ್ಳುವವರೆಲ್ಲರನ್ನು ಎತ್ತುತ್ತಾರೆ.<verse eid="PSA 145:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 145:15"/>ದೇವರೇ, ಎಲ್ಲರ ಕಣ್ಣುಗಳು ನಿಮಗಾಗಿ ಕಾಯುತ್ತಿರುತ್ತವೆ.</para>
  <para style="q2" vid="PSA 145:15">ನೀವು ಅವರಿಗೆ ಆಹಾರವನ್ನು ತಕ್ಕ ಕಾಲದಲ್ಲಿ ಕೊಡುತ್ತೀರಿ.<verse eid="PSA 145:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 145:16"/>ನಿಮ್ಮ ಕೈದೆರೆದು</para>
  <para style="q2" vid="PSA 145:16">ಎಲ್ಲಾ ಜೀವಿಗಳ ಇಷ್ಟವನ್ನು ಪೂರೈಸುತ್ತೀರಿ.<verse eid="PSA 145:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 145:17"/>ಯೆಹೋವ ದೇವರು ತಮ್ಮ ಎಲ್ಲಾ ಮಾರ್ಗಗಳಲ್ಲಿ ನೀತಿವಂತರೂ</para>
  <para style="q2" vid="PSA 145:17">ತಮ್ಮ ಸೃಷ್ಟಿಗೆಲ್ಲಾ ಪ್ರೀತಿ ತೋರಿಸುವವರೂ ಆಗಿದ್ದಾರೆ.<verse eid="PSA 145:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 145:18"/>ಯೆಹೋವ ದೇವರನ್ನು ಕರೆಯುವವರು ಯಥಾರ್ಥವಾಗಿ ಕರೆಯುವುದಾದರೆ,</para>
  <para style="q2" vid="PSA 145:18">ಅವರು ಅವರಿಗೆ ಸಮೀಪವಾಗಿದ್ದಾರೆ.<verse eid="PSA 145:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 145:19"/>ತಮಗೆ ಭಯಪಡುವವರ ಇಷ್ಟವನ್ನು ನೆರವೇರಿಸುತ್ತಾರೆ.</para>
  <para style="q2" vid="PSA 145:19">ಅವರ ಮೊರೆಯನ್ನು ಕೇಳಿ, ಅವರನ್ನು ರಕ್ಷಿಸುತ್ತಾರೆ.<verse eid="PSA 145:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 145:20"/>ಯೆಹೋವ ದೇವರು, ತಮ್ಮನ್ನು ಪ್ರೀತಿಸುವವರೆಲ್ಲರನ್ನು ಕಾಪಾಡುತ್ತಾರೆ.</para>
  <para style="q2" vid="PSA 145:20">ಆದರೆ ದುಷ್ಟರೆಲ್ಲರನ್ನು ದಂಡಿಸುತ್ತಾರೆ.<verse eid="PSA 145:20"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 145:21"/>ನನ್ನ ಬಾಯಿ ಯೆಹೋವ ದೇವರ ಸ್ತೋತ್ರವನ್ನು ನುಡಿಯಲಿ;</para>
  <para style="q2" vid="PSA 145:21">ಸಮಸ್ತ ಜೀವಿಗಳು ಆತನ ಪರಿಶುದ್ಧವಾದ ಹೆಸರನ್ನು</para>
  <para style="q2" vid="PSA 145:21">ಯುಗಯುಗಾಂತರಗಳಿಗೂ ಸ್ತುತಿಸಲಿ.<verse eid="PSA 145:21"/></para>
  <chapter eid="PSA 145"/>
  <chapter number="146" style="c" sid="PSA 146"/>
  <para style="cl">ಕೀರ್ತನೆ 146</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 146:1"/>ಯೆಹೋವ ದೇವರನ್ನು ಸ್ತುತಿಸಿರಿ.</para>
  <para style="b" vid="PSA 146:1"/>
  <para style="q1" vid="PSA 146:1">ನನ್ನ ಪ್ರಾಣವೇ, ಯೆಹೋವ ದೇವರನ್ನು ಸ್ತುತಿಸು.<verse eid="PSA 146:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 146:2"/>ನಾನು ಬದುಕುವವರೆಗೂ ಯೆಹೋವ ದೇವರನ್ನು ಸ್ತುತಿಸುವೆನು;</para>
  <para style="q2" vid="PSA 146:2">ನಾನು ಇರುವವರೆಗೂ ನನ್ನ ದೇವರನ್ನು ಸ್ತುತಿಸುವೆನು.<verse eid="PSA 146:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 146:3"/>ಅಧಿಪತಿಗಳಲ್ಲಿಯೂ ರಕ್ಷಿಸಲಾಗದ</para>
  <para style="q2" vid="PSA 146:3">ಮಾನವರಲ್ಲಿಯೂ ಭರವಸವಿಡಬೇಡಿರಿ.<verse eid="PSA 146:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 146:4"/>ಅವರ ಶ್ವಾಸವು ಹೋಗಲು ಮಣ್ಣಿಗೆ ಸೇರುತ್ತಾರೆ,</para>
  <para style="q2" vid="PSA 146:4">ಅದೇ ದಿವಸದಲ್ಲಿ ಅವರ ಆಲೋಚನೆಗಳೆಲ್ಲಾ ನಾಶವಾಗುತ್ತವೆ.<verse eid="PSA 146:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 146:5"/>ಯಾಕೋಬನ ದೇವರನ್ನು ತಮ್ಮ ಸಹಾಯಕರಾಗಿ ಮಾಡಿಕೊಂಡವನು ಧನ್ಯನು;</para>
  <para style="q2" vid="PSA 146:5">ಅವನು ತನ್ನ ದೇವರಾದ ಯೆಹೋವ ದೇವರ ಮೇಲೆ ನಿರೀಕ್ಷೆ ಇಡುವನು.<verse eid="PSA 146:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 146:6"/>ಆಕಾಶವನ್ನೂ, ಭೂಮಿಯನ್ನೂ,</para>
  <para style="q2" vid="PSA 146:6">ಸಮುದ್ರವನ್ನೂ, ಅವುಗಳಲ್ಲಿರುವ ಎಲ್ಲವನ್ನೂ</para>
  <para style="q2" vid="PSA 146:6">ಉಂಟುಮಾಡಿದ ದೇವರೇ ಎಂದೆಂದಿಗೂ ನಂಬಿಗಸ್ತರು.<verse eid="PSA 146:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 146:7"/>ಅವರು ದಬ್ಬಾಳಿಕೆಯಾದ ನ್ಯಾಯತೀರಿಸುತ್ತಾರೆ,</para>
  <para style="q2" vid="PSA 146:7">ಹಸಿದವರಿಗೆ ಆಹಾರವನ್ನು ಕೊಡುತ್ತಾರೆ.</para>
  <para style="q1" vid="PSA 146:7">ಯೆಹೋವ ದೇವರು ಸೆರೆಯವರನ್ನು ಬಿಡಿಸುತ್ತಾರೆ.<verse eid="PSA 146:7"/></para>
  <para style="q2">
    <verse number="8" style="v" sid="PSA 146:8"/>ಯೆಹೋವ ದೇವರು ಕುರುಡರ ಕಣ್ಣುಗಳನ್ನು ತೆರೆಯುತ್ತಾರೆ.</para>
  <para style="q1" vid="PSA 146:8">ಅವರು ದೀನರನ್ನು ಎತ್ತುತ್ತಾರೆ.</para>
  <para style="q2" vid="PSA 146:8">ನೀತಿವಂತರನ್ನು ಪ್ರೀತಿಸುತ್ತಾರೆ.<verse eid="PSA 146:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 146:9"/>ಯೆಹೋವ ದೇವರು ಪರದೇಶಸ್ಥರನ್ನು ಕಾಪಾಡುತ್ತಾರೆ.</para>
  <para style="q2" vid="PSA 146:9">ದಿಕ್ಕಿಲ್ಲದವರನ್ನೂ, ವಿಧವೆಯರನ್ನೂ ಉದ್ಧರಿಸುತ್ತಾರೆ.</para>
  <para style="q2" vid="PSA 146:9">ಆದರೆ ದುಷ್ಟರ ಮಾರ್ಗವನ್ನು ಬೇಸರಪಡಿಸುತ್ತಾರೆ.<verse eid="PSA 146:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 146:10"/>ಚೀಯೋನೇ, ನಿಮ್ಮ ದೇವರಾದ ಯೆಹೋವ ದೇವರು ತಲತಲಾಂತರಕ್ಕೂ,</para>
  <para style="q2" vid="PSA 146:10">ಸರ್ವ ಸಂತತಿಗಳವರೆಗೂ ಆಳಿಕೆ ಮಾಡುತ್ತಾರೆ.</para>
  <para style="b" vid="PSA 146:10"/>
  <para style="q1" vid="PSA 146:10">ಯೆಹೋವ ದೇವರಿಗೆ ಸ್ತೋತ್ರ.<verse eid="PSA 146:10"/></para>
  <chapter eid="PSA 146"/>
  <chapter number="147" style="c" sid="PSA 147"/>
  <para style="cl">ಕೀರ್ತನೆ 147</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 147:1"/>ಯೆಹೋವ ದೇವರನ್ನು ಸ್ತುತಿಸಿರಿ.</para>
  <para style="b" vid="PSA 147:1"/>
  <para style="q1" vid="PSA 147:1">ಏಕೆಂದರೆ ನಮ್ಮ ದೇವರನ್ನು ಸ್ತುತಿಸುವುದು ಒಳ್ಳೆಯದು;</para>
  <para style="q2" vid="PSA 147:1">ದೇವರನ್ನು ಸ್ತುತಿಸುವುದು ರಮ್ಯವೂ, ಯೋಗ್ಯವೂ ಆಗಿದೆ.<verse eid="PSA 147:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 147:2"/>ಯೆಹೋವ ದೇವರು ಯೆರೂಸಲೇಮನ್ನು ಕಟ್ಟುತ್ತಾರೆ,</para>
  <para style="q2" vid="PSA 147:2">ಚದರಿಹೋದ ಇಸ್ರಾಯೇಲನ್ನು ಕೂಡಿಸುತ್ತಾರೆ.<verse eid="PSA 147:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 147:3"/>ದೇವರು ಮುರಿದ ಹೃದಯದವರನ್ನು ಸ್ವಸ್ಥಮಾಡಿ,</para>
  <para style="q2" vid="PSA 147:3">ಅವರ ಗಾಯಗಳನ್ನು ಕಟ್ಟುತ್ತಾರೆ.<verse eid="PSA 147:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 147:4"/>ದೇವರು ನಕ್ಷತ್ರಗಳ ಸಂಖ್ಯೆಯನ್ನು ನಿರ್ಧರಿಸುತ್ತಾರೆ;</para>
  <para style="q2" vid="PSA 147:4">ಅವೆಲ್ಲವುಗಳನ್ನು ಅವುಗಳ ಹೆಸರಿನಿಂದ ಕರೆಯುತ್ತಾರೆ.<verse eid="PSA 147:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 147:5"/>ನಮ್ಮ ಯೆಹೋವ ದೇವರು ದೊಡ್ಡವರು, ಬಹು ಶಕ್ತರು;</para>
  <para style="q2" vid="PSA 147:5">ಅವರ ವಿವೇಕಕ್ಕೆ ಎಣೆಯಿಲ್ಲ.<verse eid="PSA 147:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 147:6"/>ಯೆಹೋವ ದೇವರು ಸಾತ್ವಿಕರನ್ನು ಉದ್ಧರಿಸುತ್ತಾರೆ;</para>
  <para style="q2" vid="PSA 147:6">ದುಷ್ಟರನ್ನು ದಂಡಿಸುತ್ತಾರೆ.<verse eid="PSA 147:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 147:7"/>ಯೆಹೋವ ದೇವರಿಗೆ ಸ್ತೋತ್ರಗೀತೆ ಹಾಡಿರಿ,</para>
  <para style="q2" vid="PSA 147:7">ನಮ್ಮ ದೇವರನ್ನು ಕಿನ್ನರಿಯಿಂದ ಸ್ತುತಿಸಿರಿ.<verse eid="PSA 147:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 147:8"/>ದೇವರು ಆಕಾಶವನ್ನು ಮೋಡಗಳಿಂದ ಮುಚ್ಚುತ್ತಾರೆ;</para>
  <para style="q2" vid="PSA 147:8">ಭೂಮಿಗೆ ಮಳೆಯನ್ನು ಸುರಿಸುತ್ತಾರೆ;</para>
  <para style="q2" vid="PSA 147:8">ಬೆಟ್ಟಗಳಲ್ಲಿ ಹುಲ್ಲನ್ನು ಬೆಳೆಸುತ್ತಾರೆ.<verse eid="PSA 147:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 147:9"/>ದೇವರು ಪಶುಗಳಿಗೂ,</para>
  <para style="q2" vid="PSA 147:9">ಕೂಗುವ ಕಾಗೆ ಮರಿಗಳಿಗೂ ಆಹಾರ ಕೊಡುತ್ತಾರೆ.<verse eid="PSA 147:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 147:10"/>ಕುದುರೆಯ ಶಕ್ತಿಯಲ್ಲಿ ಅವರಿಗೆ ಇಷ್ಟವಿಲ್ಲ;</para>
  <para style="q2" vid="PSA 147:10">ಶೂರನ ಕಾಲ್ಬಲವನ್ನು ಮೆಚ್ಚುವುದಿಲ್ಲ.<verse eid="PSA 147:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 147:11"/>ಯೆಹೋವ ದೇವರು ತಮಗೆ ಭಯಪಡುವವರಲ್ಲಿ ಆನಂದಿಸುತ್ತಾರೆ,</para>
  <para style="q2" vid="PSA 147:11">ತಮ್ಮ ಒಡಂಬಡಿಕೆಯ ಪ್ರೀತಿಯನ್ನು ಎದುರು ನೋಡುವವರಲ್ಲಿ ಹರ್ಷಿಸುತ್ತಾರೆ.<verse eid="PSA 147:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 147:12"/>ಯೆರೂಸಲೇಮೇ, ಯೆಹೋವ ದೇವರನ್ನು ಸ್ತುತಿಸು;</para>
  <para style="q2" vid="PSA 147:12">ಚೀಯೋನೇ, ನಿಮ್ಮ ದೇವರನ್ನು ಸ್ತುತಿಸು.<verse eid="PSA 147:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 147:13"/>ನಿಮ್ಮ ಬಾಗಿಲುಗಳ ಅಗುಳಿಗಳನ್ನು ಬಲಗೊಳಿಸಿ,</para>
  <para style="q2" vid="PSA 147:13">ದೇವರು ನಿಮ್ಮ ಜನರನ್ನು ಆಶೀರ್ವದಿಸುತ್ತಾರೆ.<verse eid="PSA 147:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 147:14"/>ದೇವರು ನಿಮ್ಮ ಮೇರೆಗಳನ್ನು ಸಮಾಧಾನಪಡಿಸುತ್ತಾರೆ;</para>
  <para style="q2" vid="PSA 147:14">ಉತ್ತಮವಾದ ಗೋಧಿಯಿಂದ ನಿಮ್ಮನ್ನು ತೃಪ್ತಿಪಡಿಸುತ್ತಾರೆ.<verse eid="PSA 147:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 147:15"/>ಆಜ್ಞೆಯನ್ನು ಭೂಮಿಗೆ ಕಳುಹಿಸುತ್ತಾರೆ;</para>
  <para style="q2" vid="PSA 147:15">ದೇವರ ವಾಕ್ಯವು ಬಹು ತೀವ್ರವಾಗಿ ಓಡುತ್ತದೆ.<verse eid="PSA 147:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 147:16"/>ದೇವರು ಹಿಮವನ್ನು ಉಣ್ಣೆಯ ಹಾಗೆ ಹರಡುತ್ತಾರೆ;</para>
  <para style="q2" vid="PSA 147:16">ಮಂಜನ್ನು ಬೂದಿಯ ಹಾಗೆ ಚದರಿಸುತ್ತಾನೆ.<verse eid="PSA 147:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 147:17"/>ದೇವರು ನೀರುಗಡ್ಡೆಯನ್ನು ಕಲ್ಲು ಹರಳುಗಳಂತೆ ಸುರಿದು ಹಾಕುತ್ತಾರೆ;</para>
  <para style="q2" vid="PSA 147:17">ಅವರು ಕಳುಹಿಸುವ ಚಳಿಯ ಮುಂದೆ ಯಾರು ನಿಲ್ಲುವರು?<verse eid="PSA 147:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 147:18"/>ದೇವರು ತಮ್ಮ ವಾಕ್ಯವನ್ನು ಕಳುಹಿಸಿ ಅವುಗಳನ್ನು ಕರಗಿಸುತ್ತಾರೆ;</para>
  <para style="q2" vid="PSA 147:18">ದೇವರು ಗಾಳಿಯನ್ನು ಬೀಸುವಂತೆ ಮಾಡುತ್ತಾರೆ; ನೀರು ಹರಿಯುತ್ತದೆ.<verse eid="PSA 147:18"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 147:19"/>ದೇವರು ಯಾಕೋಬ್ಯರಿಗೆ ತಮ್ಮ ವಾಕ್ಯವನ್ನು ಪ್ರಕಟಿಸುತ್ತಾರೆ,</para>
  <para style="q2" vid="PSA 147:19">ಇಸ್ರಾಯೇಲರಿಗೆ ತಮ್ಮ ತೀರ್ಪುಗಳನ್ನೂ, ತನ್ನ ನ್ಯಾಯವಿಧಿಗಳನ್ನೂ ಪ್ರಕಟಿಸುತ್ತಾರೆ.<verse eid="PSA 147:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 147:20"/>ಬೇರೆ ಯಾವ ಜನಾಂಗಕ್ಕಾದರೂ ದೇವರು ಹೀಗೆ ಮಾಡಲಿಲ್ಲ;</para>
  <para style="q2" vid="PSA 147:20">ದೇವರ ನ್ಯಾಯವಿಧಿಗಳನ್ನು ಜನರು ತಿಳಿದುಕೊಳ್ಳುವುದಿಲ್ಲ.</para>
  <para style="b" vid="PSA 147:20"/>
  <para style="q1" vid="PSA 147:20">ಯೆಹೋವ ದೇವರನ್ನು ಸ್ತುತಿಸಿರಿ.<verse eid="PSA 147:20"/></para>
  <chapter eid="PSA 147"/>
  <chapter number="148" style="c" sid="PSA 148"/>
  <para style="cl">ಕೀರ್ತನೆ 148</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 148:1"/>ಯೆಹೋವ ದೇವರನ್ನು ಸ್ತುತಿಸಿರಿ.</para>
  <para style="b" vid="PSA 148:1"/>
  <para style="q1" vid="PSA 148:1">ಆಕಾಶ ಮಂಡಲದಿಂದ ಯೆಹೋವ ದೇವರಿಗೆ ಸ್ತುತಿ ಸಲ್ಲಲಿ!</para>
  <para style="q2" vid="PSA 148:1">ಮಹೋನ್ನತದ ದೇವರನ್ನು ಸ್ತುತಿಸಿರಿ.<verse eid="PSA 148:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 148:2"/>ದೇವರ ದೂತರುಗಳೇ, ದೇವರನ್ನು ಸ್ತುತಿಸಿರಿ;</para>
  <para style="q2" vid="PSA 148:2">ದೇವರ ಪರಲೋಕದ ಎಲ್ಲಾ ಸೈನ್ಯಗಳೇ, ದೇವರನ್ನು ಸ್ತುತಿಸಿರಿ.<verse eid="PSA 148:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 148:3"/>ಸೂರ್ಯ, ಚಂದ್ರರೇ, ದೇವರನ್ನು ಸ್ತುತಿಸಿರಿ;</para>
  <para style="q2" vid="PSA 148:3">ಬೆಳಕುಳ್ಳ ಎಲ್ಲಾ ನಕ್ಷತ್ರಗಳೇ, ದೇವರನ್ನು ಸ್ತುತಿಸಿರಿ.<verse eid="PSA 148:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 148:4"/>ಉನ್ನತ ಆಕಾಶಗಳೇ, ಆಕಾಶಗಳ ಮೇಲೆ ಇರುವ</para>
  <para style="q2" vid="PSA 148:4">ಜಲಸಮೂಹವೇ, ದೇವರನ್ನು ಸ್ತುತಿಸಿರಿ.<verse eid="PSA 148:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 148:5"/>ಯೆಹೋವ ದೇವರ ಹೆಸರನ್ನು ಅವು ಸ್ತುತಿಸಲಿ,</para>
  <para style="q2" vid="PSA 148:5">ಏಕೆಂದರೆ ದೇವರು ಆಜ್ಞಾಪಿಸಲು, ಅವು ನಿರ್ಮಿಸಲಾದವು.<verse eid="PSA 148:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 148:6"/>ಅವುಗಳನ್ನು ಯುಗ ಯುಗಗಳಿಗೂ ಸ್ಥಾಪಿಸಿದ್ದಾರೆ;</para>
  <para style="q2" vid="PSA 148:6">ದೇವರು ತೀರ್ಪನ್ನು ಕೊಟ್ಟಿದ್ದಾರೆ, ಅದು ಮೀರಿ ಹೋಗುವುದಿಲ್ಲ.<verse eid="PSA 148:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 148:7"/>ಭೂಮಿಯಿಂದ ಯೆಹೋವ ದೇವರನ್ನು ಸ್ತುತಿಸಿರಿ;</para>
  <para style="q2" vid="PSA 148:7">ಎಲ್ಲಾ ಅಗಾಧಗಳೇ,<verse eid="PSA 148:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 148:8"/>ಮಿಂಚೇ, ಕಲ್ಮಳೆಯೇ, ಹಿಮವೇ, ಹಬೆಯೇ,</para>
  <para style="q2" vid="PSA 148:8">ದೇವರ ಮಾತನ್ನು ಕೇಳುವ ಬಿರುಗಾಳಿಯೇ,<verse eid="PSA 148:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 148:9"/>ಬೆಟ್ಟಗಳೇ, ಎಲ್ಲಾ ಗುಡ್ಡಗಳೇ,</para>
  <para style="q2" vid="PSA 148:9">ಹಣ್ಣಿನ ಮರಗಳೇ, ಎಲ್ಲಾ ದೇವದಾರುಗಳೇ,<verse eid="PSA 148:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 148:10"/>ಕಾಡುಮೃಗಗಳೇ, ಎಲ್ಲಾ ಪಶುಗಳೇ,</para>
  <para style="q2" vid="PSA 148:10">ಹರಿದಾಡುವ ಜೀವಜಂತುಗಳೇ, ಹಾರುವ ಪಕ್ಷಿಗಳೇ,<verse eid="PSA 148:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 148:11"/>ಭೂರಾಜರೇ, ಎಲ್ಲಾ ಪ್ರಜೆಗಳೇ,</para>
  <para style="q2" vid="PSA 148:11">ಪ್ರಧಾನರೇ, ಭೂಮಿಯ ಎಲ್ಲಾ ನ್ಯಾಯಾಧಿಪತಿಗಳೇ,<verse eid="PSA 148:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 148:12"/>ಪ್ರಾಯಸ್ಥರೇ, ಕನ್ಯೆಯರೇ,</para>
  <para style="q2" vid="PSA 148:12">ಮಕ್ಕಳೇ, ವೃದ್ಧರೇ.<verse eid="PSA 148:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 148:13"/>ಯೆಹೋವ ದೇವರ ಹೆಸರನ್ನು ಸ್ತುತಿಸಿರಿ;</para>
  <para style="q2" vid="PSA 148:13">ಅವರ ಹೆಸರು ಮಾತ್ರ ಶ್ರೇಷ್ಠವಾಗಿದೆ;</para>
  <para style="q2" vid="PSA 148:13">ಅವರ ಮಹಿಮೆಯು ಭೂಮ್ಯಾಕಾಶಗಳನ್ನು ಆವರಿಸಿದೆ.<verse eid="PSA 148:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 148:14"/>ದೇವರು ತಮ್ಮ ಜನರ ಬಲವನ್ನು ಮೇಲಕ್ಕೆತ್ತಿದ್ದಾರೆ.</para>
  <para style="q2" vid="PSA 148:14">ದೇವರ ಇಸ್ರಾಯೇಲರೆಲ್ಲರೂ,</para>
  <para style="q2" vid="PSA 148:14">ಭಕ್ತರೆಲ್ಲರೂ, ದೇವರಿಗೆ ಸಮೀಪವಾದ ಜನರೂ ದೇವರನ್ನು ಕೊಂಡಾಡಿರಿ.</para>
  <para style="b" vid="PSA 148:14"/>
  <para style="q1" vid="PSA 148:14">ಯೆಹೋವ ದೇವರನ್ನು ಸ್ತುತಿಸಿರಿ.<verse eid="PSA 148:14"/></para>
  <chapter eid="PSA 148"/>
  <chapter number="149" style="c" sid="PSA 149"/>
  <para style="cl">ಕೀರ್ತನೆ 149</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 149:1"/>ಯೆಹೋವ ದೇವರನ್ನು ಸ್ತುತಿಸಿರಿ.</para>
  <para style="b" vid="PSA 149:1"/>
  <para style="q1" vid="PSA 149:1">ಯೆಹೋವ ದೇವರಿಗೆ ಹೊಸಹಾಡನ್ನು ಹಾಡಿರಿ,</para>
  <para style="q2" vid="PSA 149:1">ಭಕ್ತರ ಸಭೆಯಲ್ಲಿ ದೇವರ ಸ್ತೋತ್ರವನ್ನೂ ಹಾಡಿರಿ.<verse eid="PSA 149:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 149:2"/>ಇಸ್ರಾಯೇಲು ತನ್ನನ್ನು ಉಂಟುಮಾಡಿದ ದೇವರಲ್ಲಿ ಸಂತೋಷಿಸಲಿ;</para>
  <para style="q2" vid="PSA 149:2">ಚೀಯೋನಿನ ಜನರು ತಮ್ಮ ಅರಸರಲ್ಲಿ ಉಲ್ಲಾಸಿಸಲಿ.<verse eid="PSA 149:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 149:3"/>ದೇವರ ಹೆಸರನ್ನು ನರ್ತಿಸುತ್ತಾ ಸ್ತುತಿಸಲಿ;</para>
  <para style="q2" vid="PSA 149:3">ದಮ್ಮಡಿಯಿಂದಲೂ ಕಿನ್ನರಿಯಿಂದಲೂ ದೇವರನ್ನು ಕೀರ್ತಿಸಲಿ.<verse eid="PSA 149:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 149:4"/>ಏಕೆಂದರೆ ಯೆಹೋವ ದೇವರು ತಮ್ಮ ಜನರಲ್ಲಿ ಹರ್ಷಿಸುತ್ತಾರೆ.</para>
  <para style="q2" vid="PSA 149:4">ದೀನರನ್ನು ಜಯದ ಕಿರೀಟದಿಂದ ಅಲಂಕರಿಸುತ್ತಾರೆ.<verse eid="PSA 149:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 149:5"/>ಇಂಥಾ ಸನ್ಮಾನದಲ್ಲಿ ನಂಬಿಗಸ್ತರು ಸಂತೋಷಪಡಲಿ</para>
  <para style="q2" vid="PSA 149:5">ಹಾಸಿಗೆಯಲ್ಲಿರುವಾಗಲೂ ಆನಂದಗಾನ ಹಾಡಲಿ.<verse eid="PSA 149:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 149:6"/>ಉನ್ನತ ದೇವರ ಸ್ತೋತ್ರವು ಅವರ ಬಾಯಿಯಲ್ಲಿ ಇರಲಿ.</para>
  <para style="q2" vid="PSA 149:6">ಇಬ್ಬಾಯಿ ಖಡ್ಗ ಅವರ ಕೈಯಲ್ಲಿಯೂ ಇರಲಿ.<verse eid="PSA 149:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 149:7"/>ಜನಾಂಗಗಳಲ್ಲಿ ನ್ಯಾಯ ಪ್ರತೀಕಾರವಾಗಲಿ,</para>
  <para style="q2" vid="PSA 149:7">ಅಪರಾಧಿಗಳಿಗೆ ಶಿಕ್ಷೆಯಾಗಲಿ.<verse eid="PSA 149:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 149:8"/>ಅಪರಾಧದ ಅರಸರನ್ನು ಸಂಕೋಲೆಗಳಿಂದಲೂ,</para>
  <para style="q2" vid="PSA 149:8">ಪ್ರಮುಖರನ್ನು ಕಬ್ಬಿಣದ ಬೇಡಿಗಳಿಂದಲೂ ಬಂಧಿಸಲಿ.<verse eid="PSA 149:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 149:9"/>ಬರೆದಿರುವ ನ್ಯಾಯವಿಧಿಯು ಅವರಲ್ಲಿ ನೆರವೇರಲಿ,</para>
  <para style="q2" vid="PSA 149:9">ದೇವರ ಭಕ್ತರೆಲ್ಲರಿಗೆ ಈ ಗೌರವವಿರುತ್ತದೆ.</para>
  <para style="b" vid="PSA 149:9"/>
  <para style="q1" vid="PSA 149:9">ಯೆಹೋವ ದೇವರನ್ನು ಸ್ತುತಿಸಿರಿ.<verse eid="PSA 149:9"/></para>
  <chapter eid="PSA 149"/>
  <chapter number="150" style="c" sid="PSA 150"/>
  <para style="cl">ಕೀರ್ತನೆ 150</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 150:1"/>ಯೆಹೋವ ದೇವರಿಗೆ ಸ್ತೋತ್ರ!</para>
  <para style="b" vid="PSA 150:1"/>
  <para style="q1" vid="PSA 150:1">ದೇವರನ್ನು ಅವರ ಪರಿಶುದ್ಧಾಲಯದಲ್ಲಿ ಸ್ತುತಿಸಿರಿ;</para>
  <para style="q2" vid="PSA 150:1">ದೇವರ ಶಕ್ತಿದಾಯಕ ಆಕಾಶಮಂಡಲದಲ್ಲಿ ಅವರನ್ನು ಸ್ತುತಿಸಿರಿ.<verse eid="PSA 150:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 150:2"/>ದೇವರ ಮಹತ್ಕಾರ್ಯಗಳಿಗಾಗಿ ಅವರನ್ನು ಸ್ತುತಿಸಿರಿ;</para>
  <para style="q2" vid="PSA 150:2">ದೇವರ ಮಹಾಪ್ರಭಾವಗಳಿಗಾಗಿ ಅವರನ್ನು ಸ್ತುತಿಸಿರಿ.<verse eid="PSA 150:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 150:3"/>ತುತೂರಿಯ ಶಬ್ದದಿಂದ ದೇವರನ್ನು ಸ್ತುತಿಸಿರಿ,</para>
  <para style="q2" vid="PSA 150:3">ಕಿನ್ನರಿಯಿಂದಲೂ, ವೀಣೆಯಿಂದಲೂ, ಅವರನ್ನು ಸ್ತುತಿಸಿರಿ.<verse eid="PSA 150:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 150:4"/>ದಮ್ಮಡಿಯಿಂದಲೂ, ನಾಟ್ಯದಿಂದಲೂ ದೇವರನ್ನು ಸ್ತುತಿಸಿರಿ;</para>
  <para style="q2" vid="PSA 150:4">ತಂತಿವಾದ್ಯಗಳಿಂದಲೂ, ಕೊಳಲುಗಳಿಂದಲೂ ಅವರನ್ನು ಸ್ತುತಿಸಿರಿ.<verse eid="PSA 150:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 150:5"/>ತಾಳಗಳಿಂದ ದೇವರನ್ನು ಸ್ತುತಿಸಿರಿ;</para>
  <para style="q2" vid="PSA 150:5">ಪ್ರತಿಧ್ವನಿಸುವ ಝಲ್ಲರಿಗಳಿಂದಲೂ ಅವರನ್ನು ಸ್ತುತಿಸಿರಿ.<verse eid="PSA 150:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 150:6"/>ಶ್ವಾಸವುಳ್ಳದ್ದೆಲ್ಲಾ ಯೆಹೋವ ದೇವರನ್ನು ಸ್ತುತಿಸಲಿ.</para>
  <para style="b" vid="PSA 150:6"/>
  <para style="q1" vid="PSA 150:6">ಯೆಹೋವ ದೇವರಿಗೆ ಸ್ತೋತ್ರ!<verse eid="PSA 150:6"/></para>
  <chapter eid="PSA 150"/>
</usx>
