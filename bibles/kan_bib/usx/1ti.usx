<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="1TI" style="id">- Biblica® Open Kannada Contemporary Version</book>
  <para style="h">1 ತಿಮೊಥೆಯನಿಗೆ</para>
  <para style="toc1">ತಿಮೊಥೆಯನಿಗೆ ಪೌಲನು ಬರೆದ ಮೊದಲನೆಯ ಪತ್ರಿಕೆ</para>
  <para style="toc2">1 ತಿಮೊಥೆಯನಿಗೆ</para>
  <para style="toc3">1 ತಿಮೊಥೆ</para>
  <para style="mt1">ತಿಮೊಥೆಯನಿಗೆ</para>
  <para style="mt2">ಪೌಲನು ಬರೆದ ಮೊದಲನೆಯ ಪತ್ರಿಕೆ</para>
  <chapter number="1" style="c" sid="1TI 1"/>
  <para style="p">
    <verse number="1" style="v" sid="1TI 1:1"/>ಕ್ರಿಸ್ತ ಯೇಸುವಿನ ಅಪೊಸ್ತಲನಾದ ಪೌಲನು, ನಮಗೆ ರಕ್ಷಕ ಆಗಿರುವ ದೇವರ ಮತ್ತು ನಮ್ಮ ನಿರೀಕ್ಷೆಯಾಗಿರುವ ಕ್ರಿಸ್ತ ಯೇಸುವಿನ ಆಜ್ಞಾನುಸಾರ,<verse eid="1TI 1:1"/></para>
  <para style="b"/>
  <para style="p">
    <verse number="2" style="v" sid="1TI 1:2"/>ನಂಬಿಕೆಯಲ್ಲಿ ನನ್ನ ನಿಜ ಪುತ್ರನಾಗಿರುವ ತಿಮೊಥೆಯನಿಗೆ ಬರೆಯುವುದು:</para>
  <para style="b" vid="1TI 1:2"/>
  <para style="p" vid="1TI 1:2">ನಮ್ಮ ತಂದೆ ದೇವರಿಂದಲೂ, ನಮ್ಮ ಕರ್ತ ಆಗಿರುವ ಕ್ರಿಸ್ತ ಯೇಸುವಿನಿಂದಲೂ ನಿನಗೆ ಕೃಪೆಯೂ ಕರುಣೆಯೂ ಶಾಂತಿಯೂ ದೊರೆಯಲಿ.<verse eid="1TI 1:2"/></para>
  <para style="b"/>
  <para style="s1">ಸುಳ್ಳು ಬೋಧಕರನ್ನು ಎದುರಿಸಲು ಎಚ್ಚರಿಕೆ</para>
  <para style="p">
    <verse number="3" style="v" sid="1TI 1:3"/>ನಾನು ಮಕೆದೋನ್ಯಕ್ಕೆ ಹೋದಾಗ ನೀನು ಎಫೆಸದಲ್ಲಿ ಇದ್ದುಕೊಂಡು ಸುಳ್ಳು ಬೋಧನೆಯನ್ನು ಉಪದೇಶಿಸಬಾರದೆಂತಲೂ <verse eid="1TI 1:3"/><verse number="4" style="v" sid="1TI 1:4"/>ಕಟ್ಟುಕಥೆಗಳಿಗೂ ಕೊನೆಯಿಲ್ಲದ ವಂಶಾವಳಿಗಳಿಗೂ ಲಕ್ಷ್ಯ ಕೊಡಬಾರದೆಂತಲೂ ಕೆಲವರಿಗೆ ಆಜ್ಞಾಪಿಸಬೇಕೆಂದು ನಾನು ನಿನಗೆ ಖಂಡಿತವಾಗಿ ಹೇಳಿದಂತೆ ಈಗಲೂ ಹೇಳುತ್ತೇನೆ. ಅಂಥ ಕಥೆಗಳೂ ವಂಶಾವಳಿಗಳೂ ವಿವಾದಕ್ಕೆ ಆಸ್ಪದವಾಗಿವೆಯೇ ಹೊರತು ನಂಬಿಕೆಯಿಂದುಂಟಾಗುವ ದೇವರ ಕಾರ್ಯಭಾರವನ್ನು ವೃದ್ಧಿ ಮಾಡುವುದೇ ಇಲ್ಲ. <verse eid="1TI 1:4"/><verse number="5" style="v" sid="1TI 1:5"/>ಈ ಆಜ್ಞೆಯ ಗುರಿಯು ಪ್ರೀತಿಯೇ ಆಗಿರುತ್ತದೆ. ಶುದ್ಧ ಹೃದಯ, ಒಳ್ಳೆಯ ಮನಸ್ಸಾಕ್ಷಿ ಹಾಗೂ ನಿಷ್ಕಪಟವಾದ ನಂಬಿಕೆಯಿಂದ ಈ ಪ್ರೀತಿಯು ಹುಟ್ಟುತ್ತದೆ. <verse eid="1TI 1:5"/><verse number="6" style="v" sid="1TI 1:6"/>ಕೆಲವರು ಇವುಗಳನ್ನು ಬಿಟ್ಟುಬಿಟ್ಟು ವ್ಯರ್ಥವಾದ ಮಾತುಗಳಿಗೆ ತಿರುಗಿಕೊಂಡಿದ್ದಾರೆ. <verse eid="1TI 1:6"/><verse number="7" style="v" sid="1TI 1:7"/>ಅವರು ನಿಯಮದ ಬೋಧಕರಾಗಿರಲು ಬಯಸಿದರೂ ತಾವು ಹೇಳುವುದನ್ನಾಗಲಿ, ತಾವು ಸ್ಥಾಪಿಸುವುದನ್ನಾಗಲಿ ಏನೆಂದು ದೃಢನಿಶ್ಚಯವಿಲ್ಲದವರಾಗಿದ್ದಾರೆ.<verse eid="1TI 1:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="1TI 1:8"/>ಒಬ್ಬನು ನಿಯಮವನ್ನು ಸರಿಯಾಗಿ ಉಪಯೋಗಿಸುವುದಾದರೆ ಅದು ಒಳ್ಳೆಯದೆಂದು ನಾವು ಬಲ್ಲೆವು. <verse eid="1TI 1:8"/><verse number="9" style="v" sid="1TI 1:9"/>ನಿಯಮವು ನೀತಿವಂತರಿಗೋಸ್ಕರ ಅಲ್ಲ. ಬದಲಿಗೆ ಅದು ಅವಿಧೇಯರಿಗೆ, ಅಕ್ರಮಗಾರರಿಗೆ, ಭಕ್ತಿಹೀನರಿಗೆ, ಪಾಪಿಗಳಿಗೆ, ಅಶುದ್ಧರಿಗೆ, ಅಪವಿತ್ರರಿಗೆ, ತಂದೆತಾಯಿಗಳನ್ನು ಕೊಲ್ಲುವವರಿಗೆ, ಕೊಲೆಗಾರರಿಗೆ, <verse eid="1TI 1:9"/><verse number="10" style="v" sid="1TI 1:10"/>ಜಾರರಿಗೆ, ಸಲಿಂಗಕಾಮಿಗಳಿಗೆ, ನರಚೋರರಿಗೆ, ಸುಳ್ಳುಗಾರರಿಗೆ, ಸುಳ್ಳಾಣೆಯಿಡುವವರಿಗೆ, ಸ್ವಸ್ಥಬೋಧನೆಯನ್ನು ವಿರೋಧಿಸುವ ಬೇರೆ ಏನಾದರೂ ಇದ್ದರೆ ಮೋಶೆಯ ನಿಯಮವು ಇಂಥವವರಿಗಾಗಿ ಕೊಡಲಾಗಿದೆ ಎಂದು ನಮಗೆ ತಿಳಿದಿದೆ. <verse eid="1TI 1:10"/><verse number="11" style="v" sid="1TI 1:11"/>ಈ ಬೋಧನೆಯು ಭಾಗ್ಯವಂತರಾದ ದೇವರ ಮಹಿಮೆಯ ಸುವಾರ್ತೆಗೆ ಅನುರೂಪವಾಗಿದೆ. ಈ ಸುವಾರ್ತೆಯು ನನ್ನ ವಶಕ್ಕೆ ಕೊಡಲಾಗಿದೆ.<verse eid="1TI 1:11"/></para>
  <para style="s1">ಪೌಲನ ಮೇಲೆ ಕ್ರಿಸ್ತ ಯೇಸುವಿನ ಕೃಪೆ</para>
  <para style="p">
    <verse number="12" style="v" sid="1TI 1:12"/>ನನ್ನನ್ನು ಬಲಪಡಿಸುವ ನಮಗೆ ಕರ್ತ ಆಗಿರುವ ಕ್ರಿಸ್ತ ಯೇಸುವು ನನ್ನನ್ನು ನಂಬಿಗಸ್ತನೆಂದು ಎಣಿಸಿ ಸೇವೆಗೆ ನೇಮಿಸಿದ್ದಕ್ಕಾಗಿ ನಾನು ಅವರಿಗೆ ಕೃತಜ್ಞತೆಯನ್ನು ಸಲ್ಲಿಸುತ್ತೇನೆ. <verse eid="1TI 1:12"/><verse number="13" style="v" sid="1TI 1:13"/>ಮೊದಲು ದೇವದೂಷಕನೂ ಹಿಂಸಕನೂ ಅಪಮಾನ ಮಾಡುವವನೂ ಆಗಿದ್ದ ನಾನು ಅಜ್ಞಾನಿಯಾಗಿ ಅಪನಂಬಿಕೆಯಲ್ಲಿ ಹಾಗೆ ವರ್ತಿಸಿದ್ದರೂ ದೇವರು ನನಗೆ ಕರುಣೆತೋರಿದರು. <verse eid="1TI 1:13"/><verse number="14" style="v" sid="1TI 1:14"/>ಆದರೆ ನಮಗೆ ಕರ್ತ ಆಗಿರುವ ಕ್ರಿಸ್ತ ಯೇಸುವಿನ ಕೃಪೆಯು ನನಗೆ ಧಾರಾಳವಾಗಿ ಸುರಿಯಲಾಯಿತು. ಮಾತ್ರವಲ್ಲದೆ ವಿಶ್ವಾಸ ಪ್ರೀತಿಯೊಂದಿಗೆ ಅತ್ಯಧಿಕವಾಯಿತು.<verse eid="1TI 1:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="1TI 1:15"/>ಕ್ರಿಸ್ತ ಯೇಸು ಪಾಪಿಗಳನ್ನು ರಕ್ಷಿಸುವುದಕ್ಕೋಸ್ಕರ ಈ ಲೋಕಕ್ಕೆ ಬಂದರು, ಎಂಬ ವಾಕ್ಯವು ನಂಬತಕ್ಕದ್ದೂ ಪೂರ್ಣ ಅಂಗೀಕಾರಕ್ಕೆ ಯೋಗ್ಯವಾದದ್ದೂ ಆಗಿದೆ. ಆ ಪಾಪಿಗಳಲ್ಲಿ ನಾನೇ ಮುಖ್ಯನು. <verse eid="1TI 1:15"/><verse number="16" style="v" sid="1TI 1:16"/>ಆದರೂ ಇನ್ನು ಮುಂದೆ ನಿತ್ಯಜೀವಕ್ಕೆ ತಮ್ಮ ಮೇಲೆ ನಂಬಿಕೆಯಿಡುವವರಿಗೆ ದೃಷ್ಟಾಂತವಾಗಿರಬೇಕೆಂದು ಕ್ರಿಸ್ತ ಯೇಸು ಮುಖ್ಯ ಪಾಪಿಯಾದ ನನ್ನಲ್ಲಿ ತಮ್ಮ ಪೂರ್ಣ ಸಹನೆಯನ್ನು ತೋರ್ಪಡಿಸಿರುವುದಕ್ಕಾಗಿ ನನಗೆ ಕರುಣೆ ದೊರೆಯಿತು. <verse eid="1TI 1:16"/><verse number="17" style="v" sid="1TI 1:17"/>ನಿತ್ಯವಾದ ಅರಸರೂ ಅಮರರೂ ಅದೃಶ್ಯರೂ ಆಗಿರುವ ಜ್ಞಾನಿಯಾದ ಒಬ್ಬರೇ ದೇವರಿಗೆ ಯುಗಯುಗಾಂತರಗಳಲ್ಲಿಯೂ ಘನವೂ ಮಹಿಮೆಯೂ ಉಂಟಾಗಲಿ. ಆಮೆನ್.<verse eid="1TI 1:17"/></para>
  <para style="s1">ತಿಮೊಥೆಯನ ಜವಾಬ್ದಾರಿ</para>
  <para style="p">
    <verse number="18" style="v" sid="1TI 1:18"/>ಮಗನಾದ ತಿಮೊಥೆಯನೇ, ನಿನ್ನ ವಿಷಯವಾಗಿ ಮೊದಲು ಉಂಟಾದ ಪ್ರವಾದನೆಗಳ ಪ್ರಕಾರವೇ ನೀನು ಅವುಗಳಿಂದ ಒಳ್ಳೆಯ ಯುದ್ಧವನ್ನು ನಡಿಸಬೇಕೆಂದು ಈ ಆಜ್ಞೆಯನ್ನು ನಿನಗೆ ಒಪ್ಪಿಸುತ್ತೇನೆ. <verse eid="1TI 1:18"/><verse number="19" style="v" sid="1TI 1:19"/>ನಂಬಿಗಸ್ತನೂ ಒಳ್ಳೆಯ ಮನಸ್ಸಾಕ್ಷಿಯುಳ್ಳವನೂ ಆಗಿರು. ಕೆಲವರು ಈ ಒಳ್ಳೆಯ ಮನಸ್ಸಾಕ್ಷಿಯನ್ನು ತಳ್ಳಿಬಿಟ್ಟು ನಂಬಿಕೆಯ ಹಡಗನ್ನು ಒಡೆದವರ ಹಾಗೆ ಇದ್ದಾರೆ. <verse eid="1TI 1:19"/><verse number="20" style="v" sid="1TI 1:20"/>ಹುಮೆನಾಯನೂ ಅಲೆಕ್ಸಾಂಡರನೂ ಅಂಥವರಾಗಿದ್ದಾರೆ. ಇವರು ದೇವದೂಷಣೆ ಮಾಡಬಾರದೆಂಬುದನ್ನು ಕಲಿತುಕೊಳ್ಳುವಂತೆ ಇವರನ್ನು ನಾನು ಸೈತಾನನಿಗೆ ಒಪ್ಪಿಸಿಬಿಟ್ಟಿದ್ದೇನೆ.<verse eid="1TI 1:20"/></para>
  <chapter eid="1TI 1"/>
  <chapter number="2" style="c" sid="1TI 2"/>
  <para style="s1">ಆರಾಧನೆಯ ಕ್ರಮ</para>
  <para style="p">
    <verse number="1" style="v" sid="1TI 2:1"/>ಎಲ್ಲದಕ್ಕಿಂತ ಮೊದಲು ಮನುಷ್ಯರೆಲ್ಲರಿಗೋಸ್ಕರವೂ ಅರಸರುಗಳಿಗಾಗಿಯೂ ವಿಜ್ಞಾಪನೆಗಳನ್ನೂ ಪ್ರಾರ್ಥನೆಗಳನ್ನೂ ಬಿನ್ನಹಗಳನ್ನೂ ಕೃತಜ್ಞತಾಸ್ತುತಿಗಳನ್ನೂ ಮಾಡಬೇಕೆಂದು ಪ್ರಬೋಧಿಸುತ್ತೇನೆ. <verse eid="1TI 2:1"/><verse number="2" style="v" sid="1TI 2:2"/>ಹೀಗೆ ಮಾಡಿದರೆ ನಾವು ನೆಮ್ಮದಿ ಹಾಗೂ ಸಮಾಧಾನಗಳಿಂದ ಕೂಡಿದ ಜೀವನವನ್ನು ಪೂರ್ಣಭಕ್ತಿಯಿಂದಲೂ ಗೌರವದಿಂದಲೂ ನಡೆಸುವುದಕ್ಕಾಗುವುದು. <verse eid="1TI 2:2"/><verse number="3" style="v" sid="1TI 2:3"/>ಏಕೆಂದರೆ ಇದು ನಮ್ಮ ರಕ್ಷಕರಾದ ದೇವರ ಮುಂದೆ ಒಳ್ಳೆಯದಾಗಿಯೂ ಅಂಗೀಕರಿಸತಕ್ಕದ್ದಾಗಿಯೂ ಇದೆ. <verse eid="1TI 2:3"/><verse number="4" style="v" sid="1TI 2:4"/>ಎಲ್ಲಾ ಮನುಷ್ಯರೂ ರಕ್ಷಣೆಯನ್ನು ಹೊಂದಿ ಸತ್ಯದ ಜ್ಞಾನಕ್ಕೆ ಬರಬೇಕೆಂಬುದು ದೇವರ ಚಿತ್ತವಾಗಿದೆ. <verse eid="1TI 2:4"/><verse number="5" style="v" sid="1TI 2:5"/>ದೇವರು ಒಬ್ಬರೇ, ದೇವರಿಗೂ ಮನುಷ್ಯರಿಗೂ ಮಧ್ಯಸ್ಥ ಒಬ್ಬರೇ. ಅವರು ಮನುಷ್ಯರಾಗಿ ಬಂದ ಕ್ರಿಸ್ತ ಯೇಸುವೇ. <verse eid="1TI 2:5"/><verse number="6" style="v" sid="1TI 2:6"/>ಯೇಸು ಎಲ್ಲರಿಗೋಸ್ಕರ ವಿಮೋಚನೆಯ ಕ್ರಯವಾಗಿ ತಮ್ಮನ್ನು ತಾವೇ ಒಪ್ಪಿಸಿಕೊಟ್ಟರು. ಇದೇ ಸೂಕ್ತ ಸಮಯದಲ್ಲಿ ನೀಡಬೇಕಾದ ಸಾಕ್ಷಿಯಾಗಿದೆ. <verse eid="1TI 2:6"/><verse number="7" style="v" sid="1TI 2:7"/>ಇದಕ್ಕಾಗಿಯೇ ಸಂದೇಶ ಸಾರುವವನೂ ಅಪೊಸ್ತಲನೂ ಆಗಿರುವ ನಾನು ಯೆಹೂದ್ಯರಲ್ಲದವರಿಗೆ ನಂಬಿಗಸ್ತನಾದ ಸತ್ಯ ಬೋಧಕನಾಗಿ ನೇಮಕವಾದೆನು. ಇದು ಸುಳ್ಳಲ್ಲ, ಸತ್ಯವನ್ನೇ ಹೇಳುತ್ತೇನೆ.<verse eid="1TI 2:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="1TI 2:8"/>ಆದ್ದರಿಂದ ಪುರುಷರು ಎಲ್ಲಾ ಸ್ಥಳಗಳಲ್ಲಿ ಕೋಪವೂ ಸಂದೇಹವೂ ಇಲ್ಲದೆ ಶುದ್ಧವಾದ ಕೈಗಳನ್ನೆತ್ತಿ ಪ್ರಾರ್ಥಿಸಬೇಕೆಂದು ನಾನು ಅಪೇಕ್ಷಿಸುತ್ತೇನೆ. <verse eid="1TI 2:8"/><verse number="9" style="v" sid="1TI 2:9"/>ಹಾಗೆಯೇ ಸ್ತ್ರೀಯರು ಸಭ್ಯತೆ ಹಾಗೂ ಸ್ವಸ್ಥಬುದ್ಧಿಯುಳ್ಳವರಾಗಿದ್ದು ಗೌರವಕ್ಕೆ ತಕ್ಕ ಉಡುಪನ್ನುಟ್ಟುಕೊಳ್ಳಬೇಕೆಂದು ಅಪೇಕ್ಷಿಸುತ್ತೇನೆ. ಅವರು ಜಡೆ, ಚಿನ್ನ, ಮುತ್ತುಗಳು, ಬೆಲೆಯುಳ್ಳ ವಸ್ತ್ರ ಇವುಗಳಿಂದ ತಮ್ಮನ್ನು ಅಲಂಕರಿಸಿಕೊಳ್ಳದೆ, <verse eid="1TI 2:9"/><verse number="10" style="v" sid="1TI 2:10"/>ದೇವ ಭಕ್ತೆಯರೆನಿಸಿಕೊಳ್ಳುವ ಸ್ತ್ರೀಯರಿಗೆ ತಕ್ಕಂತೆ ಸತ್ಕ್ರಿಯೆಗಳಿಂದ ತಮ್ಮನ್ನು ಅಲಂಕರಿಸಿಕೊಳ್ಳಬೇಕು.<verse eid="1TI 2:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="1TI 2:11"/>ಸ್ತ್ರೀಯು<note caller="+" style="f"><char style="fr" closed="false">2:11 </char><char style="ft" closed="false">ಅಥವಾ </char><char style="fqa" closed="false">ಹೆಂಡತಿ</char></note> ಮೌನವಾಗಿದ್ದು ಎಲ್ಲಾ ಅಧೀನತೆಯನ್ನು ಕಲಿಯಬೇಕು. <verse eid="1TI 2:11"/><verse number="12" style="v" sid="1TI 2:12"/>ಆದರೆ ಉಪದೇಶ ಮಾಡುವುದಕ್ಕಾಗಲಿ, ಪುರುಷನ<note caller="+" style="f"><char style="fr" closed="false">2:12 </char><char style="ft" closed="false">ಅಥವಾ </char><char style="fqa" closed="false">ತನ್ನ ಗಂಡನ ಮೇಲೆ</char></note> ಮೇಲೆ ಅಧಿಕಾರ ನಡೆಸುವುದಕ್ಕಾಗಲಿ ಸ್ತ್ರೀಗೆ ನಾನು ಅಪ್ಪಣೆ ಕೊಡುವುದಿಲ್ಲ. ಆಕೆಯು ಮೌನವಾಗಿರಬೇಕು. <verse eid="1TI 2:12"/><verse number="13" style="v" sid="1TI 2:13"/>ಏಕೆಂದರೆ ಮೊದಲು ನಿರ್ಮಿತನಾದವನು ಆದಾಮನು, ಆಮೇಲೆ ಹವ್ವಳು. <verse eid="1TI 2:13"/><verse number="14" style="v" sid="1TI 2:14"/>ಆದಾಮನು ವಂಚನೆಗೊಳಗಾಗಲಿಲ್ಲ, ಸ್ತ್ರೀಯು ವಂಚನೆಗೊಳಗಾಗಿ ಅಪರಾಧಿಯಾದಳು. <verse eid="1TI 2:14"/><verse number="15" style="v" sid="1TI 2:15"/>ಆದರೂ ಸ್ತ್ರೀಯರು ಸ್ವಸ್ಥಬುದ್ಧಿಯಿಂದ ನಂಬಿಕೆ, ಪ್ರೀತಿ ಹಾಗೂ ಪರಿಶುದ್ಧತೆಯಲ್ಲಿ ನೆಲೆಗೊಂಡಿದ್ದರೆ ಅವರು ಮಗುವನ್ನು ಹೆರುವುದರ ಮೂಲಕ ರಕ್ಷಣೆಹೊಂದುವರು.<verse eid="1TI 2:15"/></para>
  <chapter eid="1TI 2"/>
  <chapter number="3" style="c" sid="1TI 3"/>
  <para style="s1">ಮೇಲ್ವಿಚಾರಕರೂ ಸಭಾಸೇವಕರೂ</para>
  <para style="p">
    <verse number="1" style="v" sid="1TI 3:1"/>ಸಭೆಯ ಮೇಲ್ವಿಚಾರಕನಾಗಲು ಬಯಸುವವನು ಒಳ್ಳೆಯ ಕೆಲಸವನ್ನು ಅಪೇಕ್ಷಿಸುವವನಾಗಿದ್ದಾನೆಂಬ ಮಾತು ನಂಬತಕ್ಕದ್ದಾಗಿದೆ. <verse eid="1TI 3:1"/><verse number="2" style="v" sid="1TI 3:2"/>ಸಭೆಯ ಮೇಲ್ವಿಚಾರಕನು ನಿಂದಾರಹಿತನಾಗಿ, ಏಕಪತ್ನಿಯುಳ್ಳವನೂ ಜಿತೇಂದ್ರಿಯನೂ ಸ್ವಸ್ಥಚಿತ್ತನೂ ಗೌರವಸ್ಥನೂ ಅತಿಥಿ ಸತ್ಕಾರ ಮಾಡುವವನೂ ಬೋಧಿಸುವುದರಲ್ಲಿ ಪ್ರವೀಣನೂ ಆಗಿರಬೇಕು. <verse eid="1TI 3:2"/><verse number="3" style="v" sid="1TI 3:3"/>ಅವನು ಮದ್ಯಪಾನ ಮಾಡುವವನಾಗಿರಬಾರದು, ಹೊಡೆದಾಡುವವನಾಗಿರಬಾರದು. ಆದರೆ ಸಾತ್ವಿಕನೂ ಕುತರ್ಕ ಮಾಡದವನೂ ಹಣದಾಶೆಯಿಲ್ಲದವನೂ ಆಗಿರಬೇಕು. <verse eid="1TI 3:3"/><verse number="4" style="v" sid="1TI 3:4"/>ಪೂರ್ಣ ಗೌರವದಿಂದ ತನ್ನ ಮಕ್ಕಳನ್ನು ಅಧೀನದಲ್ಲಿಟ್ಟುಕೊಂಡು ಸ್ವಂತ ಮನೆಯವರನ್ನು ಚೆನ್ನಾಗಿ ಆಳುವವನಾಗಿರಬೇಕು. <verse eid="1TI 3:4"/><verse number="5" style="v" sid="1TI 3:5"/>ಸ್ವಂತ ಮನೆಯವರನ್ನು ಆಳುವುದಕ್ಕೆ ತಿಳಿಯದವನು ದೇವರ ಸಭೆಯನ್ನು ಹೇಗೆ ಪರಾಮರಿಸುವನು? <verse eid="1TI 3:5"/><verse number="6" style="v" sid="1TI 3:6"/>ಅವನು ಹೊಸದಾಗಿ ವಿಶ್ವಾಸಕ್ಕೆ ಬಂದವನಾಗಿರಬಾರದು. ಅಂಥವನಾದರೆ ಉಬ್ಬಿಕೊಂಡು ಸೈತಾನನ ಶಿಕ್ಷಾವಿಧಿಗೆ ಬಲಿಬೀಳುವನು. <verse eid="1TI 3:6"/><verse number="7" style="v" sid="1TI 3:7"/>ಇದಲ್ಲದೆ ಅವನು ನಿಂದೆಗೆ ಗುರಿಯಾಗದವನೂ ಸೈತಾನನ ಉರುಲಿಗೆ ಸಿಕ್ಕಿ ಬೀಳದವನೂ ಆಗಿದ್ದಾನೆಂಬ ಒಳ್ಳೆಯ ಸಾಕ್ಷಿಯನ್ನು ಹೊಂದಿದವನಾಗಿರಬೇಕು.<verse eid="1TI 3:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="1TI 3:8"/>ಅದೇ ರೀತಿಯಾಗಿ ಸಭಾಸೇವಕರು ಗೌರವವುಳ್ಳವರಾಗಿರಬೇಕು. ಅವರು ಎರಡು ನಾಲಿಗೆಯುಳ್ಳವರಾಗಿರಬಾರದು. ಮದ್ಯಾಸಕ್ತರೂ ನೀಚಲಾಭವನ್ನು ಅಪೇಕ್ಷಿಸುವವರೂ ಆಗಿರದೆ <verse eid="1TI 3:8"/><verse number="9" style="v" sid="1TI 3:9"/>ನಂಬಿಕೆಯ ರಹಸ್ಯವನ್ನು ಶುದ್ಧಮನಸ್ಸಾಕ್ಷಿಯಿಂದ ಹಿಡಿದುಕೊಂಡವರಾಗಿರಬೇಕು. <verse eid="1TI 3:9"/><verse number="10" style="v" sid="1TI 3:10"/>ಇದಲ್ಲದೆ ಇವರು ಸಹ ಮೊದಲು ಪರೀಕ್ಷೆಗೊಳಪಡಬೇಕು. ಅವರು ನಿಂದಾರಹಿತರಾಗಿ ಕಂಡು ಬಂದರೆ ಸಭಾ ಹಿರಿಯರಾಗಿ ಸೇವೆಮಾಡಲಿ.<verse eid="1TI 3:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="1TI 3:11"/>ಹಾಗೆಯೇ ಅವರ ಹೆಂಡತಿಯರು ಗೌರವವುಳ್ಳವರಾಗಿರಬೇಕು. ಚಾಡಿ ಹೇಳದವರೂ ಸ್ವಸ್ಥ ಬುದ್ಧಿಯುಳ್ಳವರೂ ಎಲ್ಲಾ ವಿಷಯಗಳಲ್ಲಿ ನಂಬಿಗಸ್ತರೂ ಆಗಿರತಕ್ಕದ್ದು.<verse eid="1TI 3:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="1TI 3:12"/>ಸಭಾಸೇವಕರು ಏಕಪತ್ನಿಯುಳ್ಳವರೂ ತಮ್ಮ ಮಕ್ಕಳನ್ನೂ ಮನೆಯವರನ್ನೂ ಚೆನ್ನಾಗಿ ಆಳುವವರೂ ಆಗಿರಬೇಕು. <verse eid="1TI 3:12"/><verse number="13" style="v" sid="1TI 3:13"/>ಸಭಾ ಹಿರಿಯರಾಗಿ ಚೆನ್ನಾಗಿ ಸೇವೆ ಮಾಡಿದವರು ತಮಗೆ ಒಳ್ಳೆಯ ಸ್ಥಿತಿಯನ್ನೂ, ಕ್ರಿಸ್ತ ಯೇಸುವಿನಲ್ಲಿರುವ ವಿಶ್ವಾಸದಲ್ಲಿ ಬಹು ಧೈರ್ಯವನ್ನೂ ಸಂಪಾದಿಸಿಕೊಳ್ಳುತ್ತಾರೆ.<verse eid="1TI 3:13"/></para>
  <para style="s1">ಪೌಲನ ಸೂಚನೆಗಳಿಗೆ ಕಾರಣಗಳು</para>
  <para style="p">
    <verse number="14" style="v" sid="1TI 3:14"/>ನಾನು ನಿನ್ನ ಬಳಿಗೆ ಬೇಗನೆ ಬರುವೆನೆಂಬ ನಿರೀಕ್ಷೆಯಿಂದಲೇ ನಿನಗೆ ಈ ವಿಷಯಗಳನ್ನು ಬರೆದಿದ್ದೇನೆ. <verse eid="1TI 3:14"/><verse number="15" style="v" sid="1TI 3:15"/>ಒಂದು ವೇಳೆ ನಾನು ತಡ ಮಾಡಿದರೂ ಸತ್ಯಕ್ಕೆ ಸ್ತಂಭವೂ ಆಧಾರವೂ ಆಗಿರುವ ದೇವರ ಮನೆಯಲ್ಲಿ ಎಂದರೆ ಜೀವಸ್ವರೂಪರಾದ ದೇವರ ಸಭೆಯಲ್ಲಿ ನಡೆದುಕೊಳ್ಳಬೇಕಾದ ರೀತಿಯು ನಿನಗೆ ಗೊತ್ತಾಗಿರಬೇಕು. <verse eid="1TI 3:15"/><verse number="16" style="v" sid="1TI 3:16"/>ಎಲ್ಲಾ ಪ್ರಶ್ನೆಗಳಿಂದ ಹೆಚ್ಚಾಗಿ ದೈವ ಭಕ್ತಿಯ ರಹಸ್ಯವು ದೊಡ್ಡದಾದದ್ದು ಅದು ಯಾವುದೆಂದರೆ:</para>
  <para style="q1" vid="1TI 3:16">“ದೇವರು ಮನುಷ್ಯ ರೂಪದಲ್ಲಿ ಪ್ರತ್ಯಕ್ಷರಾದರು.</para>
  <para style="q2" vid="1TI 3:16">ಆತ್ಮದಲ್ಲಿ ರುಜುಪಡಿಸಲಾದರು.</para>
  <para style="q1" vid="1TI 3:16">ದೂತರಿಗೆ ಕಾಣಿಸಿಕೊಂಡರು,</para>
  <para style="q2" vid="1TI 3:16">ಯೆಹೂದ್ಯರಲ್ಲದವರಿಗೆ ಸಾರಲಾದರು,</para>
  <para style="q1" vid="1TI 3:16">ಲೋಕದಲ್ಲಿ ನಂಬಲಾದರು,</para>
  <para style="q2" vid="1TI 3:16">ಮಹಿಮೆಗೆ ಒಯ್ಯಲಾದರು!”<verse eid="1TI 3:16"/></para>
  <chapter eid="1TI 3"/>
  <chapter number="4" style="c" sid="1TI 4"/>
  <para style="p">
    <verse number="1" style="v" sid="1TI 4:1"/>ಮುಂಬರುವ ದಿನಗಳಲ್ಲಿ ಕೆಲವರು ವಂಚಿಸುವ ಆತ್ಮಗಳಿಗೂ ದೆವ್ವಗಳ ಬೋಧನೆಗಳಿಗೂ ಲಕ್ಷ್ಯಗೊಟ್ಟು ವಿಶ್ವಾಸದಲ್ಲಿ ಬಿದ್ದುಹೋಗುವರೆಂದು ಪವಿತ್ರಾತ್ಮ ದೇವರು ಸ್ಪಷ್ಟವಾಗಿ ಹೇಳುತ್ತಾರೆ. <verse eid="1TI 4:1"/><verse number="2" style="v" sid="1TI 4:2"/>ಅವರು ಕಪಟಿಗಳೂ ಸುಳ್ಳಾಡುವವರೂ ತಮ್ಮ ಮನಸ್ಸಾಕ್ಷಿಯ ಮೇಲೆ ಬರೆಯುಳ್ಳವರಾದರೂ ಆಗಿದ್ದು <verse eid="1TI 4:2"/><verse number="3" style="v" sid="1TI 4:3"/>ಮದುವೆಯಾಗಬಾರದೆಂತಲೂ ಯಾರು ನಂಬುವವರಾಗಿದ್ದು ಸತ್ಯವನ್ನು ತಿಳಿದುಕೊಂಡಿದ್ದಾರೋ ಅವರು ಕೃತಜ್ಞತಾಸ್ತುತಿ ಮಾಡಿ ತಿನ್ನುವುದಕ್ಕೋಸ್ಕರ ದೇವರು ಸೃಷ್ಟಿಸಿದ ಆಹಾರವನ್ನು ತಿನ್ನಬಾರದೆಂತಲೂ ಆಜ್ಞಾಪಿಸುತ್ತಾರೆ. <verse eid="1TI 4:3"/><verse number="4" style="v" sid="1TI 4:4"/>ದೇವರು ಸೃಷ್ಟಿಸಿದ್ದೆಲ್ಲವೂ ಒಳ್ಳೆಯದಾಗಿದೆ. ಕೃತಜ್ಞತೆ ಮಾಡಿ ಸ್ವೀಕರಿಸುವ ಯಾವುದನ್ನೂ ತಿರಸ್ಕರಿಸಬೇಕಾಗಿಲ್ಲ. <verse eid="1TI 4:4"/><verse number="5" style="v" sid="1TI 4:5"/>ಅದು ದೇವರ ವಾಕ್ಯದಿಂದಲೂ ಪ್ರಾರ್ಥನೆಯಿಂದಲೂ ಪವಿತ್ರವಾಗುತ್ತದೆ.<verse eid="1TI 4:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="1TI 4:6"/>ಈ ವಿಷಯಗಳನ್ನು ಸಹೋದರರಿಗೆ ತಿಳಿಸುವವನಾದರೆ ನೀನು ಅನುಸರಿಸುತ್ತಿರುವ ನಂಬಿಕೆಯ ಮತ್ತು ಸುಬೋಧನೆಯ ವಾಕ್ಯಗಳಲ್ಲಿ ಪೋಷಣೆ ಹೊಂದುವವನಾಗಿ ಕ್ರಿಸ್ತ ಯೇಸುವಿನ ಒಳ್ಳೆಯ ಸೇವಕನಾಗಿರುವೆ. <verse eid="1TI 4:6"/><verse number="7" style="v" sid="1TI 4:7"/>ಪ್ರಾಪಂಚಿಕ ಹಾಗೂ ಅಜ್ಜಿ ಕಥೆಗಳನ್ನು ನಿರಾಕರಿಸಿ ನೀನು ದೇವಭಕ್ತಿಯನ್ನು ಅಭ್ಯಾಸ ಮಾಡಿಕೋ. <verse eid="1TI 4:7"/><verse number="8" style="v" sid="1TI 4:8"/>ದೇಹ ಸಾಧನೆಯೂ ಸ್ವಲ್ಪಮಟ್ಟಿಗೆ ಲಾಭಕರವಾಗಿದೆ. ಭಕ್ತಿಯಾದರೋ ಎಲ್ಲಾ ವಿಧದಲ್ಲಿಯೂ ಲಾಭಕರವಾದದ್ದು. ಅದಕ್ಕೆ ಈಗಲೂ ಮುಂದೆಯೂ ಜೀವ ವಾಗ್ದಾನ ಉಂಟು. <verse eid="1TI 4:8"/><verse number="9" style="v" sid="1TI 4:9"/>ಈ ಮಾತು ನಂಬತಕ್ಕದ್ದೂ ಪೂರ್ಣ ಅಂಗೀಕಾರಕ್ಕೆ ಯೋಗ್ಯವಾದದ್ದೂ ಆಗಿದೆ. <verse eid="1TI 4:9"/><verse number="10" style="v" sid="1TI 4:10"/>ಇದಕ್ಕಾಗಿ ನಾವು ಕಷ್ಟಪಡುತ್ತೇವೆ ಮತ್ತು ಪ್ರಯಾಸ ಪಡುತ್ತೇವೆ. ಏಕೆಂದರೆ ಎಲ್ಲಾ ಮನುಷ್ಯರಿಗೆ ವಿಶೇಷವಾಗಿ ನಂಬುವವರಿಗೆ ರಕ್ಷಕ ಆಗಿರುವ ಜೀವಸ್ವರೂಪರಾದ ದೇವರನ್ನು ನಾವು ನಿರೀಕ್ಷಿಸಿದ್ದೇವೆ.<verse eid="1TI 4:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="1TI 4:11"/>ಈ ವಿಷಯಗಳನ್ನು ಆಜ್ಞಾಪಿಸಿ ಬೋಧಿಸು. <verse eid="1TI 4:11"/><verse number="12" style="v" sid="1TI 4:12"/>ನಿನ್ನ ಯೌವನವನ್ನೂ ಯಾರೂ ತಾತ್ಸಾರ ಮಾಡದಿರಲಿ. ಆದರೆ ನಂಬುವವರಿಗೆ ನುಡಿಯಲ್ಲಿ, ನಡೆಯಲ್ಲಿ, ಪ್ರೀತಿಯಲ್ಲಿ, ವಿಶ್ವಾಸದಲ್ಲಿ, ಶುದ್ಧತ್ವದಲ್ಲಿ ನೀನೇ ಆದರ್ಶನಾಗಿರು. <verse eid="1TI 4:12"/><verse number="13" style="v" sid="1TI 4:13"/>ನಾನು ಬರುವ ತನಕ ಓದುವುದರಲ್ಲಿಯೂ ಎಚ್ಚರಿಸುವುದರಲ್ಲಿಯೂ ಬೋಧಿಸುವುದರಲ್ಲಿಯೂ ಲಕ್ಷ್ಯಕೊಡು. <verse eid="1TI 4:13"/><verse number="14" style="v" sid="1TI 4:14"/>ನಿನ್ನಲ್ಲಿರುವ ವರವನ್ನು ಅಲಕ್ಷ್ಯ ಮಾಡಬೇಡ. ಅದು ಸಭೆಯ ಹಿರಿಯರು ಪ್ರವಾದನೆಯ ಮೂಲಕ ನಿನ್ನ ಮೇಲೆ ಹಸ್ತಗಳನ್ನಿಟ್ಟಾಗ ನಿನಗೆ ಕೊಡಲಾಯಿತಲ್ಲವೇ?<verse eid="1TI 4:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="1TI 4:15"/>ಈ ವಿಷಯಗಳನ್ನು ಧ್ಯಾನಿಸುವವನಾಗಿರು. ಇವುಗಳಲ್ಲಿಯೇ ನೆಲೆಗೊಂಡಿರು. ಹೀಗೆ ನಿನ್ನ ಪ್ರಗತಿಯು ಎಲ್ಲರಿಗೂ ಪ್ರಕಟವಾಗುವುದು. <verse eid="1TI 4:15"/><verse number="16" style="v" sid="1TI 4:16"/>ನಿನ್ನ ವಿಷಯದಲ್ಲಿಯೂ ಉಪದೇಶದ ವಿಷಯದಲ್ಲಿಯೂ ಎಚ್ಚರಿಕೆಯಾಗಿರು. ನೀನು ಇವುಗಳಲ್ಲಿಯೇ ನಿರತನಾಗಿರು. ಹೀಗೆ ಮಾಡುವುದರಿಂದ ನೀನು ನಿನ್ನನ್ನೂ ನಿನ್ನ ಉಪದೇಶ ಕೇಳುವವರನ್ನೂ ರಕ್ಷಿಸುವೆ.<verse eid="1TI 4:16"/></para>
  <chapter eid="1TI 4"/>
  <chapter number="5" style="c" sid="1TI 5"/>
  <para style="s1">ವಿಧವೆಯರ, ಹಿರಿಯರ, ಗುಲಾಮರ ಬಗ್ಗೆ ಸಲಹೆಗಳು</para>
  <para style="p">
    <verse number="1" style="v" sid="1TI 5:1"/>ವೃದ್ಧನನ್ನು ಗದರಿಸದೆ ತಂದೆಯಂತೆಯೂ ಯೌವನಸ್ಥರನ್ನು ಸಹೋದರರಂತೆಯೂ <verse eid="1TI 5:1"/><verse number="2" style="v" sid="1TI 5:2"/>ವೃದ್ಧ ಸ್ತ್ರೀಯರನ್ನು ತಾಯಿಯಂತೆಯೂ ಯೌವನ ಸ್ತ್ರೀಯರನ್ನು ಪೂರ್ಣ ಪವಿತ್ರತೆಯಿಂದ ಸಹೋದರಿಯರಂತೆಯೂ ಅವರವರಿಗೆ ಬುದ್ಧಿ ಹೇಳು.<verse eid="1TI 5:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="1TI 5:3"/>ನಿಜವಾಗಿಯೂ ಕಷ್ಟದಲ್ಲಿರುವ ವಿಧವೆಯರನ್ನು ಗುರುತಿಸಿ ಅವರಿಗೆ ಸಹಾಯಮಾಡು. <verse eid="1TI 5:3"/><verse number="4" style="v" sid="1TI 5:4"/>ಆದರೆ ಯಾವ ವಿಧವೆಗಾದರೂ ಮಕ್ಕಳಾಗಲಿ, ಮೊಮ್ಮಕ್ಕಳಾಗಲಿ ಇದ್ದರೆ ಅವರೇ ಮೊದಲು ತಮ್ಮ ಮನೆಯಲ್ಲಿ ಭಕ್ತಿಯಿಂದಿರುವುದಕ್ಕೂ ತಂದೆತಾಯಿಗಳಿಗೆ ಪ್ರತ್ಯುಪಕಾರ ಮಾಡುವುದಕ್ಕೂ ಕಲಿತುಕೊಳ್ಳಲಿ. ಇದು ದೇವರ ದೃಷ್ಟಿಯಲ್ಲಿ ಮೆಚ್ಚಿಕೆಯಾದದ್ದು. <verse eid="1TI 5:4"/><verse number="5" style="v" sid="1TI 5:5"/>ನಿಜವಾಗಿಯೂ ಕಷ್ಟದಲ್ಲಿರುವ ವಿಧವೆಯು ದೇವರ ಮೇಲೆ ನಿರೀಕ್ಷೆಯನ್ನಿಟ್ಟು ಹಗಲು ಇರುಳು ವಿಜ್ಞಾಪನೆಗಳಲ್ಲಿಯೂ ಪ್ರಾರ್ಥನೆಗಳಲ್ಲಿಯೂ ನೆಲೆಗೊಂಡಿರುವಳು. <verse eid="1TI 5:5"/><verse number="6" style="v" sid="1TI 5:6"/>ಆದರೆ ಭೋಗಿಯಾಗಿರುವ ವಿಧವೆಯು ಬದುಕಿರುವಾಗಲೂ ಸತ್ತವಳೇ. <verse eid="1TI 5:6"/><verse number="7" style="v" sid="1TI 5:7"/>ವಿಧವೆಯರು ನಿಂದೆಗೆ ಗುರಿಯಾಗದಂತೆ ಇವುಗಳನ್ನು ಆಜ್ಞಾಪಿಸು. <verse eid="1TI 5:7"/><verse number="8" style="v" sid="1TI 5:8"/>ಯಾವನಾದರೂ ಸ್ವಂತದವರನ್ನು ವಿಶೇಷವಾಗಿ ತನ್ನ ಮನೆಯವರನ್ನು ಸಂರಕ್ಷಿಸದೆ ಹೋದರೆ ಅವನು ನಂಬಿಕೆಯನ್ನು ಅಲ್ಲಗಳೆದವನೂ ಅವಿಶ್ವಾಸಿಗಿಂತ ನೀಚನೂ ಆಗಿದ್ದಾನೆ.<verse eid="1TI 5:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="1TI 5:9"/>ವಯಸ್ಸಿನಲ್ಲಿ ಅರವತ್ತಕ್ಕೆ ಕಡಿಮೆಯಿಲ್ಲದ ವಿಧವೆಯರನ್ನು ಮಾತ್ರ ವಿಧವೆಯರ ಪಟ್ಟಿಯಲ್ಲಿ ಸೇರಿಸು. ಅಂಥವಳು ಗಂಡನಿಗೆ ನಂಬಿಗಸ್ತಳಾಗಿದ್ದಿರಬೇಕು. <verse eid="1TI 5:9"/><verse number="10" style="v" sid="1TI 5:10"/>ಆಕೆಯು ಮಕ್ಕಳನ್ನು ಸಾಕಿದವಳೂ ಅತಿಥಿ ಸತ್ಕಾರ ಮಾಡಿದವಳೂ ಭಕ್ತರ ಪಾದಗಳನ್ನು ತೊಳೆದವಳೂ ಸಂಕಟದಲ್ಲಿದ್ದವರಿಗೆ ಸಹಾಯ ಮಾಡಿದವಳೂ ಆಗಿರಬೇಕು. ಹೀಗೆ ಪ್ರತಿಯೊಂದು ಸತ್ಕ್ರಿಯೆಗಳಿಗೆ ಹೆಸರಾದವಳೂ ಆಗಿರಬೇಕು.<verse eid="1TI 5:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="1TI 5:11"/>ಆದರೆ ಪ್ರಾಯದ ವಿಧವೆಯರನ್ನು ಪಟ್ಟಿಯಲ್ಲಿ ಸೇರಿಸಬೇಡ. ಏಕೆಂದರೆ ಅವರಲ್ಲಿ ದೈಹಿಕ ಅಪೇಕ್ಷೆಗಳು ಕ್ರಿಸ್ತ ಯೇಸುವಿನ ಮೇಲಿಟ್ಟ ಅವರ ಪ್ರತಿಷ್ಠೆಯನ್ನು ಸೋಲಿಸಿ, ಅವರು ಮದುವೆ ಮಾಡಿಕೊಳ್ಳುವಂತೆ ಮಾಡುವವು. <verse eid="1TI 5:11"/><verse number="12" style="v" sid="1TI 5:12"/>ಅಂಥವರು ತಮ್ಮ ಮೊದಲಿನ ನಂಬಿಕೆಯನ್ನು ಬಿಟ್ಟಿದ್ದರಿಂದ ತೀರ್ಪಿಗೆ ಗುರಿಯಾಗುವರು. <verse eid="1TI 5:12"/><verse number="13" style="v" sid="1TI 5:13"/>ಇದಲ್ಲದೆ ಅವರು ಮನೆಯಿಂದ ಮನೆಗೆ ತಿರುಗಾಡುತ್ತಾ ಸೋಮಾರಿತನವನ್ನು ಕಲಿಯುತ್ತಾರೆ. ಸೋಮಾರಿಗಳಾಗುವುದಷ್ಟೇ ಅಲ್ಲ, ಹರಟೆ ಮಾತನಾಡುವವರೂ ಇತರರ ಕೆಲಸದಲ್ಲಿ ತಲೆಹಾಕುವವರಾಗಿ ಆಡಬಾರದ ಮಾತುಗಳನ್ನಾಡುವವರೂ ಆಗುತ್ತಾರೆ. <verse eid="1TI 5:13"/><verse number="14" style="v" sid="1TI 5:14"/>ಆದ್ದರಿಂದ ಯೌವನಸ್ಥ ವಿಧವೆಯರು ಮದುವೆಮಾಡಿಕೊಂಡು, ಮಕ್ಕಳನ್ನು ಹೆತ್ತು, ಮನೆಯ ಕೆಲಸಮಾಡಿ, ವಿರೋಧಿಯ ನಿಂದೆಗೆ ಆಸ್ಪದ ಕೊಡಬಾರದೆಂಬುದೇ ನನ್ನ ಅಪೇಕ್ಷೆ. <verse eid="1TI 5:14"/><verse number="15" style="v" sid="1TI 5:15"/>ಈಗಾಗಲೇ ಕೆಲವರು ದಾರಿತಪ್ಪಿ ಸೈತಾನನನ್ನು ಹಿಂಬಾಲಿಸಿದ್ದಾರೆ.<verse eid="1TI 5:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="1TI 5:16"/>ವಿಶ್ವಾಸಿಯಾದ ಸ್ತ್ರೀಯ ಕುಟುಂಬದಲ್ಲಿ ವಿಧವೆಯರಿದ್ದರೆ, ಆಕೆ ಇಂಥವರನ್ನು ಸಂರಕ್ಷಿಸಲಿ. ಸಭೆಯು ದಿಕ್ಕಿಲ್ಲದ ವಿಧವೆಯರನ್ನು ಸಂರಕ್ಷಿಸಬೇಕಾಗಿರುವುದರಿಂದ ಆ ಭಾರವನ್ನು ಸಭೆಯ ಮೇಲೆ ಹಾಕಬಾರದು.<verse eid="1TI 5:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="1TI 5:17"/>ಸಭಾಕಾರ್ಯಗಳನ್ನು ಸರಿಯಾಗಿ ನಡೆಸುತ್ತಿರುವ ಹಿರಿಯರು, ವಿಶೇಷವಾಗಿ ವಾಕ್ಯದಲ್ಲಿಯೂ ಬೋಧನೆಯಲ್ಲಿಯೂ ಶ್ರಮಿಸುತ್ತಿರುವವರು ಇಮ್ಮಡಿಯಾದ ಗೌರವಕ್ಕೆ ಯೋಗ್ಯರೆಂದು ಎಣಿಸಬೇಕು. <verse eid="1TI 5:17"/><verse number="18" style="v" sid="1TI 5:18"/>ಏಕೆಂದರೆ, “ಕಣ ತುಳಿಯುವ ಎತ್ತಿನ ಬಾಯನ್ನು ಕಟ್ಟಬಾರದು!”<note caller="+" style="f"><char style="fr" closed="false">5:18 </char><char style="ft" closed="false"><char style="xt"><ref loc="DEU 25:4">ಧರ್ಮೋ 25:4</ref></char></char></note> ಎಂತಲೂ, “ಕೆಲಸದವನು ತನ್ನ ಕೂಲಿಗೆ ಯೋಗ್ಯನಾಗಿದ್ದಾನೆ!”<note caller="+" style="f"><char style="fr" closed="false">5:18 </char><char style="ft" closed="false"><char style="xt"><ref loc="LUK 10:7">ಲೂಕ 10:7</ref></char></char></note> ಎಂತಲೂ ಪವಿತ್ರ ವೇದದಲ್ಲಿ ಹೇಳಿದೆಯಲ್ಲಾ. <verse eid="1TI 5:18"/><verse number="19" style="v" sid="1TI 5:19"/>ಹಿರಿಯನ ಮೇಲೆ ಯಾರಾದರೂ ದೂರು ಹೇಳಿದರೆ, ಇಬ್ಬರ ಇಲ್ಲವೆ ಮೂವರ ಸಾಕ್ಷಿ ಇಲ್ಲದೆ ಅದನ್ನು ಅಂಗೀಕರಿಸಬೇಡ. <verse eid="1TI 5:19"/><verse number="20" style="v" sid="1TI 5:20"/>ಪಾಪಮಾಡುವ ಹಿರಿಯರನ್ನು ಎಲ್ಲರ ಮುಂದೆಯೇ ಗದರಿಸು. ಇದರಿಂದ ಇತರರಿಗೂ ಎಚ್ಚರಿಕೆಯಾಗುವುದು. <verse eid="1TI 5:20"/><verse number="21" style="v" sid="1TI 5:21"/>ನೀನು ವಿಚಾರಿಸುವುದಕ್ಕೆ ಮೊದಲೇ ತೀರ್ಮಾನಿಸದೆಯೂ ಪಕ್ಷಪಾತದಿಂದ ಏನೂ ಮಾಡದೆಯೂ ಇವುಗಳನ್ನು ಕೈಗೊಳ್ಳಬೇಕೆಂದು ದೇವರ ಮುಂದೆಯೂ ಕ್ರಿಸ್ತ ಯೇಸುವಿನ ಮುಂದೆಯೂ ಆಯ್ಕೆಯಾದ ದೂತರ ಮುಂದೆಯೂ ಖಂಡಿತವಾಗಿ ನಾನು ಹೇಳುತ್ತೇನೆ.<verse eid="1TI 5:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="1TI 5:22"/>ಅವಸರದಿಂದ ಯಾರ ಮೇಲೆಯೂ ಹಸ್ತವನ್ನಿಟ್ಟು, ಸಭಾ ಹಿರಿಯರನ್ನಾಗಿ ನೇಮಿಸಬೇಡ. ಇತರರ ಪಾಪಗಳಲ್ಲಿ ಪಾಲುಗಾರನಾಗಬೇಡ. ನಿನ್ನನ್ನು ಶುದ್ಧನಾಗಿ ಕಾಪಾಡಿಕೋ.<verse eid="1TI 5:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="1TI 5:23"/>ನೀರನ್ನು ಮಾತ್ರ ಕುಡಿಯದೆ ನಿನ್ನ ಹೊಟ್ಟೆಯ ನಿಮಿತ್ತವಾಗಿಯೂ ನಿನಗೆ ಆಗಾಗ್ಗೆ ಉಂಟಾಗುವ ಬಲಹೀನತೆಗಳಿಗಾಗಿಯೂ ಸ್ವಲ್ಪ ದ್ರಾಕ್ಷಾರಸವನ್ನು ಉಪಯೋಗಿಸು.<verse eid="1TI 5:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="1TI 5:24"/>ಕೆಲವರ ಪಾಪಗಳು ತೀರ್ಪಿಗೆ ಮುಂಚೆಯೇ ಬಹಿರಂಗವಾಗುತ್ತವೆ. ಇನ್ನು ಕೆಲವರ ಪಾಪಗಳು ಕ್ರಮೇಣವಾಗಿ ಕಂಡುಬರುತ್ತವೆ. <verse eid="1TI 5:24"/><verse number="25" style="v" sid="1TI 5:25"/>ಅದರಂತೆಯೇ ಕೆಲವರ ಒಳ್ಳೆಯ ಕ್ರಿಯೆಗಳು ಮುಂಚೆಯೇ ಪ್ರತ್ಯಕ್ಷವಾಗಿರುತ್ತವೆ. ಪ್ರತ್ಯಕ್ಷವಾಗದಿರುವ ಒಳ್ಳೆಯ ಕ್ರಿಯೆಗಳು ನಿರಂತರವಾಗಿ ಮರೆಯಾಗಿರಲಾರವು.<verse eid="1TI 5:25"/></para>
  <chapter eid="1TI 5"/>
  <chapter number="6" style="c" sid="1TI 6"/>
  <para style="p">
    <verse number="1" style="v" sid="1TI 6:1"/>ದೇವರ ನಾಮವೂ ನಮ್ಮ ಬೋಧನೆಯೂ ದೂಷಣೆಗೆ ಗುರಿಯಾಗದಂತೆ ದಾಸತ್ವದ ನೊಗ ಹೊತ್ತಿರುವವರು ತಮ್ಮ ಸ್ವಂತ ಯಜಮಾನರನ್ನು ಪೂರ್ಣ ಗೌರವಕ್ಕೆ ಯೋಗ್ಯರೆಂದೆಣಿಸಲಿ. <verse eid="1TI 6:1"/><verse number="2" style="v" sid="1TI 6:2"/>ವಿಶ್ವಾಸಿಗಳಾದ ಯಜಮಾನರಿರುವವರು ಆ ಯಜಮಾನರು ಸಹೋದರನಾಗಿರುವುದರಿಂದ ಅವರನ್ನು ತಾತ್ಸಾರ ಮಾಡದಿರಲಿ. ಏಕೆಂದರೆ ತಮ್ಮ ಸೇವೆಯಿಂದ ಲಾಭ ಹೊಂದುವವರು ವಿಶ್ವಾಸಿಗಳು ಮತ್ತು ತಮಗೆ ಪ್ರಿಯರಾಗಿದ್ದಾರೆ ಎಂದು ತಿಳಿದು ಅವರಿಗೆ ಉತ್ತಮ ಸೇವೆಮಾಡಲಿ. ಇವುಗಳನ್ನು ಅವರಿಗೆ ಬೋಧಿಸಿ ಎಚ್ಚರಿಸು.<verse eid="1TI 6:2"/></para>
  <para style="s1">ಸುಳ್ಳು ಬೋಧಕರು ಹಾಗೂ ಹಣದಾಶೆ</para>
  <para style="p">
    <verse number="3" style="v" sid="1TI 6:3"/>ಯಾವನಾದರೂ ಬೇರೆ ವಿಧವಾದ ಉಪದೇಶವನ್ನು ಮಾಡಿ, ನಮಗೆ ಕರ್ತ ಆಗಿರುವ ಯೇಸುಕ್ರಿಸ್ತರ ಶುದ್ಧವಾದ ಮಾತುಗಳಿಗೂ ಭಕ್ತಿಗೆ ಅನುಸಾರವಾದ ಬೋಧನೆಗೂ ಸಮ್ಮತಿಸದೆ ಹೋದರೆ, <verse eid="1TI 6:3"/><verse number="4" style="v" sid="1TI 6:4"/>ಅಂಥವರು ಅಹಂಕಾರಿಯೂ ವಿವೇಕರಹಿತನಾಗಿದ್ದಾರೆ. ಅವರು ಹೊಟ್ಟೆಕಿಚ್ಚು, ಜಗಳ, ದೂಷಣೆ, ದುಸ್ಸಂಶಯಪಡುವ ಭ್ರಾಂತರಾಗಿ ಸತ್ಯವನ್ನು ಬಿಟ್ಟು, ಕುತರ್ಕ ವಾಗ್ವಾದಗಳನ್ನು ಮಾಡುವವರಾಗಿದ್ದಾರೆ. <verse eid="1TI 6:4"/><verse number="5" style="v" sid="1TI 6:5"/>ಹೀಗೆ ಅನಾರೋಗ್ಯಕರವಾದ ವಿವಾದಗಳನ್ನೂ ಕೆಲವು ಮಾತುಗಳ ಕುರಿತಾಗಿರುವ ತರ್ಕಗಳನ್ನೂ ಸೃಷ್ಟಿಸುವ ಪ್ರಸಿದ್ಧರಾಗಿದ್ದಾರೆ. ಅಂಥವರು ದೇವಭಕ್ತಿಯನ್ನು ಆರ್ಥಿಕ ಲಾಭವನ್ನಾಗಿ ಭಾವಿಸುವವರಾಗಿದ್ದಾರೆ.<verse eid="1TI 6:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="1TI 6:6"/>ಸಂತೃಪ್ತಿಯೊಂದಿಗಿರುವ ದೇವಭಕ್ತಿಯೇ ದೊಡ್ಡ ಲಾಭವು. <verse eid="1TI 6:6"/><verse number="7" style="v" sid="1TI 6:7"/>ನಾವು ಲೋಕದೊಳಗೆ ಏನನ್ನೂ ತೆಗೆದುಕೊಂಡು ಬರಲಿಲ್ಲ. ಅದರೊಳಗಿಂದ ಏನೂ ತೆಗೆದುಕೊಂಡು ಹೋಗಲಾರೆವು. <verse eid="1TI 6:7"/><verse number="8" style="v" sid="1TI 6:8"/>ಆದರೆ ಅನ್ನವಸ್ತ್ರಗಳು ನಮಗಿರುವುದಾದರೆ, ನಾವು ಅದರಲ್ಲಿ ತೃಪ್ತರಾಗಿರೋಣ. <verse eid="1TI 6:8"/><verse number="9" style="v" sid="1TI 6:9"/>ಆದರೆ ಐಶ್ವರ್ಯವಂತರಾಗಬೇಕೆಂದು ಬಯಸುವವರು ಶೋಧನೆಯಲ್ಲಿಯೂ ಉರುಲಿನಲ್ಲಿಯೂ ಬಿದ್ದು ಅನೇಕ ಬುದ್ಧಿಹೀನವಾದ ಹಾಗೂ ಹಾನಿಕರವಾದ ಆಶೆಗಳಲ್ಲಿ ಬೀಳುತ್ತಾರೆ. ಇಂಥ ಆಶೆಗಳು ಮನುಷ್ಯರನ್ನು ಸಂಹಾರ ವಿನಾಶನಗಳಲ್ಲಿ ಮುಳುಗಿಸುತ್ತವೆ. <verse eid="1TI 6:9"/><verse number="10" style="v" sid="1TI 6:10"/>ಹಣದ ಪ್ರೀತಿಯು ಸಕಲ ವಿಧವಾದ ಕೆಟ್ಟತನಕ್ಕೆ ಬೇರಾಗಿದೆ. ಕೆಲವರು ಹಣಕ್ಕಾಗಿ ಆತುರಪಟ್ಟು ನಂಬಿಕೆಯಿಂದ ದೂರಹೋಗಿ ಅನೇಕ ದುಃಖಗಳಿಂದ ತಮ್ಮನ್ನು ತಿವಿಸಿಕೊಳ್ಳುತ್ತಾರೆ.<verse eid="1TI 6:10"/></para>
  <para style="s1">ತಿಮೊಥೆಗೆ ಪೌಲನ ಅಪ್ಪಣೆ</para>
  <para style="p">
    <verse number="11" style="v" sid="1TI 6:11"/>ದೇವರ ಮನುಷ್ಯನೇ, ನೀನಾದರೋ ಇವುಗಳಿಂದ ಓಡಿಹೋಗು. ನೀತಿ, ಭಕ್ತಿ, ನಂಬಿಕೆ, ಪ್ರೀತಿ, ತಾಳ್ಮೆ, ಸಾತ್ವಿಕತ್ವ ಇವುಗಳನ್ನು ಹಿಂಬಾಲಿಸು. <verse eid="1TI 6:11"/><verse number="12" style="v" sid="1TI 6:12"/>ವಿಶ್ವಾಸದ ಒಳ್ಳೆಯ ಹೋರಾಟವನ್ನು ಮಾಡು. ನಿತ್ಯಜೀವವನ್ನು ಹಿಡಿದುಕೋ; ಅದಕ್ಕಾಗಿಯೇ ದೇವರು ನಿನ್ನನ್ನು ಕರೆದಿದ್ದಾರೆ. ನೀನು ಅನೇಕ ಸಾಕ್ಷಿಗಳ ಮುಂದೆ ಒಳ್ಳೆಯ ಅರಿಕೆಯನ್ನು ಮಾಡಿದ್ದೀಯಲ್ಲಾ? <verse eid="1TI 6:12"/><verse number="13" style="v" sid="1TI 6:13"/>ಎಲ್ಲಕ್ಕೂ ಜೀವ ನೀಡುವ ದೇವರ ಮುಂದೆಯೂ ಪೊಂತ್ಯ ಪಿಲಾತನ ಮುಂದೆ ಒಳ್ಳೆಯ ಅರಿಕೆಯನ್ನು ಸಾಕ್ಷಿಯಾಗಿ ನೀಡಿದ ಕ್ರಿಸ್ತ ಯೇಸುವಿನ ಮುಂದೆಯೂ ನಾನು ನಿನಗೆ ಖಂಡಿತವಾಗಿ ಹೇಳವುದೇನೆಂದರೆ: <verse eid="1TI 6:13"/><verse number="14" style="v" sid="1TI 6:14"/>ನಮಗೆ ಕರ್ತ ಆಗಿರುವ ಯೇಸು ಕ್ರಿಸ್ತರು ಪ್ರತ್ಯಕ್ಷರಾಗುವ ತನಕ ಈ ಆಜ್ಞೆಯನ್ನು ನಿಷ್ಕಳಂಕವಾಗಿಯೂ ನಿಂದಾರಹಿತವಾಗಿಯೂ ನೀನು ಕಾಪಾಡಬೇಕು. <verse eid="1TI 6:14"/><verse number="15" style="v" sid="1TI 6:15"/>ರಾಜಾಧಿರಾಜನೂ ಕರ್ತರ ಕರ್ತನೂ ಭಾಗ್ಯವಂತರಾದ ಏಕಾಧಿಪತಿಯು ತಮ್ಮ ಸಮಯಗಳಲ್ಲೆ ಕ್ರಿಸ್ತ ಯೇಸುವನ್ನು ಪ್ರತ್ಯಕ್ಷಪಡಿಸುವರು. <verse eid="1TI 6:15"/><verse number="16" style="v" sid="1TI 6:16"/>ದೇವರೊಬ್ಬರೇ ಅಮರತ್ವವುಳ್ಳವರೂ ಯಾರೂ ಸಮೀಪಿಸಲಾರದ ಬೆಳಕಿನಲ್ಲಿ ವಾಸಿಸುವವರೂ ಆಗಿದ್ದಾರೆ. ಯಾವ ಮನುಷ್ಯನೂ ದೇವರನ್ನು ಕಾಣಲಿಲ್ಲ. ಯಾರೂ ಕಾಣಲಾರರು. ದೇವರಿಗೆ ಮಾನವೂ ಬಲವೂ ಸದಾಕಾಲಕ್ಕೂ ಇರಲಿ. ಆಮೆನ್.<verse eid="1TI 6:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="1TI 6:17"/>ಈ ಲೋಕದಲ್ಲಿ ಅಹಂಕಾರಿಗಳಾಗಿರದೆ, ಅಸ್ತಿರವಾದ ಐಶ್ವರ್ಯದ ಮೇಲೆ ನಿರೀಕ್ಷೆಯನ್ನಿಡದೆ ನಮ್ಮ ಸುಖಕ್ಕೋಸ್ಕರ ಎಲ್ಲವನ್ನೂ ಸಮೃದ್ಧಿಯಾಗಿ ದಯಪಾಲಿಸುವ ದೇವರ ಮೇಲೆ ನಿರೀಕ್ಷೆಯನ್ನಿಡಬೇಕೆಂದು ಐಶ್ವರ್ಯವಂತರಿಗೆ ಆಜ್ಞಾಪಿಸು. <verse eid="1TI 6:17"/><verse number="18" style="v" sid="1TI 6:18"/>ಅಂಥವರು ಒಳ್ಳೆಯದನ್ನು ಮಾಡುವವರೂ ಸತ್ಕಾರ್ಯಗಳಲ್ಲಿ ಐಶ್ವರ್ಯವಂತರೂ ಪಾಲು ಕೊಡುವುದರಲ್ಲಿ ಸಿದ್ಧರಾಗಿರುವವರೂ ಪರೋಪಕಾರ ಮಾಡುವವರೂ ಆಗಿರಬೇಕೆಂದು ಅವರನ್ನು ಪ್ರಬೋಧಿಸು. <verse eid="1TI 6:18"/><verse number="19" style="v" sid="1TI 6:19"/>ಹೀಗೆ ಮುಂದಿನ ಕಾಲಕ್ಕೆ ಯಥಾರ್ಥ ಜೀವವಾಗಿರುವ ನಿತ್ಯಜೀವವನ್ನು ಹಿಡಿದುಕೊಳ್ಳುವಂತೆ ತಮಗೋಸ್ಕರ ಸ್ಥಿರವಾದ ಅಸ್ತಿವಾರಕ್ಕಾಗಿ ನಿಕ್ಷೇಪಗಳನ್ನು ಕೂಡಿಸಿಟ್ಟುಕೊಳ್ಳಲಿ.<verse eid="1TI 6:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="1TI 6:20"/>ತಿಮೊಥೆಯನೇ, ನಿನ್ನ ವಶಕ್ಕೆ ಕೊಟ್ಟಿರುವುದನ್ನು ಕಾಪಾಡು. ದೇವಭಕ್ತಿಗೆ ಅನುಗುಣವಾಗದ ಹರಟೆ ಮಾತುಗಳಿಗೂ ಜ್ಞಾನದಿಂದ ವಿಚಾರಪಡಿಸುವ ಸುಳ್ಳು ತರ್ಕಗಳಿಗೂ ಒಳಪಡದಿರು. <verse eid="1TI 6:20"/><verse number="21" style="v" sid="1TI 6:21"/>ಕೆಲವರು ಇಂಥವುಗಳಿಗೆ ಒಳಪಟ್ಟು ನಂಬಿಕೆಯಿಂದ ಗುರಿತಪ್ಪಿ ಹೋಗಿದ್ದಾರೆ.</para>
  <para style="b" vid="1TI 6:21"/>
  <para style="b" vid="1TI 6:21"/>
  <para style="p" vid="1TI 6:21">ಕೃಪೆಯು ನಿಮ್ಮೊಂದಿಗಿರಲಿ.<verse eid="1TI 6:21"/></para>
  <chapter eid="1TI 6"/>
</usx>
