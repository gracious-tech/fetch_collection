<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="HAB" style="id">- Biblica® Open Kannada Contemporary Version</book>
  <para style="h">ಹಬಕ್ಕೂಕ</para>
  <para style="toc1">ಹಬಕ್ಕೂಕ</para>
  <para style="toc2">ಹಬಕ್ಕೂಕ</para>
  <para style="toc3">ಹಬ</para>
  <para style="mt1">ಹಬಕ್ಕೂಕ</para>
  <chapter number="1" style="c" sid="HAB 1"/>
  <para style="p">
    <verse number="1" style="v" sid="HAB 1:1"/>ಪ್ರವಾದಿಯಾದ ಹಬಕ್ಕೂಕನು ಹೊಂದಿದ ಪ್ರವಾದನೆಯು:<verse eid="HAB 1:1"/></para>
  <para style="b"/>
  <para style="s1">ಹಬಕ್ಕೂಕನ ದೂರು</para>
  <para style="q1">
    <verse number="2" style="v" sid="HAB 1:2"/>ಯೆಹೋವ ದೇವರೇ, ನಾನು ಎಷ್ಟು ಕಾಲ ಸಹಾಯಕ್ಕಾಗಿ ಮೊರೆಯಿಡಬೇಕು.</para>
  <para style="q2" vid="HAB 1:2">ನೀವು ನನ್ನ ಮೊರೆಗೆ ಎಷ್ಟು ಕಾಲ ಕಿವಿಗೊಡದಿರುವಿರಿ.</para>
  <para style="q1" vid="HAB 1:2">“ಹಿಂಸೆಯಾಗುತ್ತಿದೆ,” ಎಂದು ಕೂಗುತ್ತಿದ್ದೇನೆ,</para>
  <para style="q2" vid="HAB 1:2">ಆದರೂ ನೀವು ರಕ್ಷಿಸುವುದಿಲ್ಲ.<verse eid="HAB 1:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="HAB 1:3"/>ಅನ್ಯಾಯವನ್ನು ನಾನು ನೋಡುವಂತೆ ಏಕೆ ಮಾಡುತ್ತೀರಿ?</para>
  <para style="q2" vid="HAB 1:3">ತಪ್ಪನ್ನು ಏಕೆ ಸಹಿಸುತ್ತೀರಿ?</para>
  <para style="q1" vid="HAB 1:3">ನಾಶವೂ ಹಿಂಸೆಯೂ ನನ್ನ ಮುಂದೆ ಇವೆ.</para>
  <para style="q2" vid="HAB 1:3">ಹೋರಾಟವೂ ಒಡುಕೂ ಹೆಚ್ಚುತ್ತಲಿವೆ.<verse eid="HAB 1:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="HAB 1:4"/>ಆದ್ದರಿಂದ ದೈವನಿಯಮವು ಪಕ್ಕಕ್ಕೆ ಇಡಲಾಗಿದೆ.</para>
  <para style="q2" vid="HAB 1:4">ನ್ಯಾಯವು ಎಂದಿಗೂ ಸ್ಥಾಪಿತವಾಗುವುದಿಲ್ಲ.</para>
  <para style="q1" vid="HAB 1:4">ಏಕೆಂದರೆ ದುಷ್ಟರು ನೀತಿವಂತರನ್ನು ಸುತ್ತಿಕೊಂಡಿದ್ದಾರೆ.</para>
  <para style="q2" vid="HAB 1:4">ಆದ್ದರಿಂದ ತಪ್ಪಾಗಿ ನ್ಯಾಯತೀರ್ಪು ಹೊರಡುತ್ತದೆ.<verse eid="HAB 1:4"/></para>
  <para style="s1">ಯೆಹೋವ ದೇವರ ಉತ್ತರ</para>
  <para style="q1">
    <verse number="5" style="v" sid="HAB 1:5"/>“ಜನಾಂಗಗಳ ಕಡೆಗೆ ನೋಡಿ ಲಕ್ಷ್ಯಗೊಟ್ಟು</para>
  <para style="q2" vid="HAB 1:5">ಬಹಳವಾಗಿ ಆಶ್ಚರ್ಯಪಡಿರಿ.</para>
  <para style="q1" vid="HAB 1:5">ನಿಮ್ಮ ಜೀವಮಾನ ಕಾಲದಲ್ಲಿ ನಾನು ಒಂದು ಕಾರ್ಯವನ್ನು ಮಾಡಲಿದ್ದೇನೆ</para>
  <para style="q2" vid="HAB 1:5">ಆ ಕಾರ್ಯವನ್ನು ವಿವರಿಸಿ ಹೇಳಿದರೂ</para>
  <para style="q2" vid="HAB 1:5">ನೀವದನ್ನು ನಂಬುವುದಿಲ್ಲ.<verse eid="HAB 1:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="HAB 1:6"/>ನಾನು ಬಾಬಿಲೋನಿಯರನ್ನು ಎಬ್ಬಿಸುತ್ತೇನೆ.</para>
  <para style="q2" vid="HAB 1:6">ಅವರು ಉಗ್ರ ಮತ್ತು ಸಾಹಸಿ ಜನರು.</para>
  <para style="q1" vid="HAB 1:6">ತಮ್ಮದಲ್ಲದ ನಿವಾಸಗಳನ್ನು ವಶಮಾಡಿಕೊಳ್ಳುವುದಕ್ಕೆ</para>
  <para style="q2" vid="HAB 1:6">ವಿಶಾಲವಾದ ದೇಶದಲ್ಲಿ ಹಾದುಹೋಗುವರು.<verse eid="HAB 1:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="HAB 1:7"/>ಅವರು ಭಯಂಕರವಾದವರು ಮತ್ತು ಕ್ರೂರವಾದವರು.</para>
  <para style="q2" vid="HAB 1:7">ಅವರು ತಮಗೆ ತಾವೇ ಕಾನೂನಾಗಿದ್ದಾರೆ.</para>
  <para style="q2" vid="HAB 1:7">ತಮ್ಮನ್ನು ತಾವೇ ಗೌರವಿಸಿಕೊಳ್ಳುವವರೂ ಆಗಿದ್ದಾರೆ.<verse eid="HAB 1:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="HAB 1:8"/>ಅವರ ಕುದುರೆಗಳು ಚಿರತೆಗಳಿಗಿಂತ ವೇಗವಾಗಿಯೂ,</para>
  <para style="q2" vid="HAB 1:8">ಸಂಜೆಯ ತೋಳಗಳಿಗಿಂತ ಚುರುಕಾಗಿಯೂ ಇವೆ.</para>
  <para style="q1" vid="HAB 1:8">ಅವರ ಅಶ್ವಸೈನ್ಯ ಎರಗುವುದು.</para>
  <para style="q2" vid="HAB 1:8">ಅವರ ಕುದುರೆ ಸವಾರರು ದೂರದಿಂದ ಬರುವರು;</para>
  <para style="q1" vid="HAB 1:8">ನುಂಗುವುದಕ್ಕೆ ತ್ವರೆಪಡುವ ಹದ್ದಿನಂತೆ ಹಾರಿ ಬರುವರು.<verse eid="HAB 1:8"/></para>
  <para style="q2">
    <verse number="9" style="v" sid="HAB 1:9"/>ಅವರೆಲ್ಲರು ಹಿಂಸಿಸುವುದಕ್ಕೆ ಬರುವರು;</para>
  <para style="q1" vid="HAB 1:9">ಅವರ ಸಮೂಹ, ಮರುಭೂಮಿಯ ಗಾಳಿಯಂತೆಯೇ ಮುಂದೆ ಬರುವುದು;</para>
  <para style="q2" vid="HAB 1:9">ಸೆರೆಯವರನ್ನು ಮರಳಿನ ಹಾಗೆ ಕೂಡಿಸುವರು.<verse eid="HAB 1:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="HAB 1:10"/>ಅವರ ಅರಸನನ್ನು ಧಿಕ್ಕರಿಸುವರು;</para>
  <para style="q2" vid="HAB 1:10">ಪ್ರಧಾನರು ಅವರನ್ನು ಪರಿಹಾಸ್ಯ ಮಾಡುವರು;</para>
  <para style="q1" vid="HAB 1:10">ಕೋಟೆಗಳಿಗೆಲ್ಲಾ ಕುಚೋದ್ಯ ಮಾಡುವರು;</para>
  <para style="q2" vid="HAB 1:10">ಮಣ್ಣಿನ ದಿನ್ನೆಗಳನ್ನು ಮಾಡಿ, ಅವುಗಳನ್ನು ಹಿಡಿಯುವರು.<verse eid="HAB 1:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="HAB 1:11"/>ಬಿರುಗಾಳಿಯಂತೆ ಕೊಚ್ಚಿಕೊಳ್ಳುತ್ತಾ ಮುಂದೆ ಸಾಗುವರು.</para>
  <para style="q2" vid="HAB 1:11">ಅಪರಾಧಿ ಜನರವರು. ಅವರ ಸ್ವಂತ ಬಲ, ಅವರ ದೇವರು.”<verse eid="HAB 1:11"/></para>
  <para style="s1">ಹಬಕ್ಕೂಕನ ಎರಡನೆಯ ದೂರು</para>
  <para style="q1">
    <verse number="12" style="v" sid="HAB 1:12"/>ಯೆಹೋವ ದೇವರೇ, ನೀವು ಅನಾದಿಕಾಲದಿಂದ ಬಂದವರಲ್ಲವೇ?</para>
  <para style="q2" vid="HAB 1:12">ನನ್ನ ದೇವರೇ, ನನ್ನ ಪರಿಶುದ್ಧರೇ, ನೀನು ಎಂದಿಗೂ ಸಾಯುವುದಿಲ್ಲ.</para>
  <para style="q1" vid="HAB 1:12">ಯೆಹೋವ ದೇವರೇ, ನ್ಯಾಯತೀರ್ಪನ್ನು ಜಾರಿಗೊಳಿಸಲು ಅವರನ್ನು ನೇಮಿಸಿದ್ದೀರಿ.</para>
  <para style="q2" vid="HAB 1:12">ನನ್ನ ಬಂಡೆಯೇ, ನೀವು ಶಿಕ್ಷಿಸಲು ಅವರನ್ನು ನೇಮಕ ಮಾಡಿದ್ದೀರಿ.<verse eid="HAB 1:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="HAB 1:13"/>ನೀನು ಕೆಟ್ಟದ್ದನ್ನು ನೋಡದ ಹಾಗೆ ಶುದ್ಧ ಕಣ್ಣುಗಳುಳ್ಳವರು.</para>
  <para style="q2" vid="HAB 1:13">ನೀವು ಅನ್ಯಾಯವನ್ನು ದೃಷ್ಟಿಸಲಾರಿರಿ,</para>
  <para style="q1" vid="HAB 1:13">ವಂಚಿಸುವವರನ್ನು ಏಕೆ ಸಹಿಸಿಕೊಳ್ಳುತ್ತೀರಿ?</para>
  <para style="q2" vid="HAB 1:13">ದುಷ್ಟನು ತನಗಿಂತ ನೀತಿವಂತನನ್ನು</para>
  <para style="q2" vid="HAB 1:13">ನುಂಗಿ ಬಿಡುವ ವೇಳೆಯಲ್ಲಿ ಏಕೆ ಸುಮ್ಮನಿರುತ್ತೀರಿ?<verse eid="HAB 1:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="HAB 1:14"/>ಮನುಷ್ಯರನ್ನು ಸಮುದ್ರದ ಮೀನುಗಳಂತೆಯೂ,</para>
  <para style="q2" vid="HAB 1:14">ಆಳುವವನಿಲ್ಲದ ಕ್ರಿಮಿಗಳಂತೆಯೂ ಮಾಡಿರುತ್ತೀರಿ.<verse eid="HAB 1:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="HAB 1:15"/>ದುಷ್ಟ ವೈರಿಯು ಅವುಗಳನ್ನು ಗಾಳದಿಂದ ಎತ್ತಿ,</para>
  <para style="q2" vid="HAB 1:15">ತನ್ನ ಬಲೆಯಿಂದ ಅವುಗಳನ್ನು ಹಿಡಿದು,</para>
  <para style="q1" vid="HAB 1:15">ತನ್ನ ಜಾಲದಿಂದ ಅವುಗಳನ್ನು ಕೂಡಿಸಿಡುತ್ತಾನೆ.</para>
  <para style="q2" vid="HAB 1:15">ಅವನು ಹಿಗ್ಗುತ್ತಾನೆ, ಸಂತೋಷಪಡುತ್ತಾನೆ.<verse eid="HAB 1:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="HAB 1:16"/>ಆದ್ದರಿಂದ ತಮ್ಮ ಬಲೆಗೆ ಬಲಿ ಅರ್ಪಿಸಿ,</para>
  <para style="q2" vid="HAB 1:16">ತಮ್ಮ ಜಾಲಕ್ಕೆ ಧೂಪವನ್ನು ಸುಡುತ್ತಾರೆ.</para>
  <para style="q1" vid="HAB 1:16">ಏಕೆಂದರೆ ಇವುಗಳಿಂದ ಅವರ ಭೋಜನ ಪುಷ್ಟಿಯಾಗಿಯೂ,</para>
  <para style="q2" vid="HAB 1:16">ಅವರ ಆಹಾರ ರುಚಿಯುಳ್ಳದ್ದಾಗಿಯೂ ಇದೆ.<verse eid="HAB 1:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="HAB 1:17"/>ಹೀಗಿರುವುದರಿಂದ ನಿರಂತರವಾಗಿ ಅವರು ತಮ್ಮ ಬಲೆಯನ್ನು ಬರಿದುಮಾಡಿ,</para>
  <para style="q2" vid="HAB 1:17">ಕರುಣೆ ಇಲ್ಲದೆ ಜನಾಂಗಗಳನ್ನು ನಾಶ ಮಾಡುತ್ತಾ ಅವನು ಹೋಗಬೇಕೇ?<verse eid="HAB 1:17"/></para>
  <para style="b"/>
  <chapter eid="HAB 1"/>
  <chapter number="2" style="c" sid="HAB 2"/>
  <para style="q1">
    <verse number="1" style="v" sid="HAB 2:1"/>ನಾನು ಕಾವಲುಗಾರನಾಗಿ ನಿಲ್ಲುವೆನು.</para>
  <para style="q2" vid="HAB 2:1">ಕಾವಲು ಗೋಪುರವನ್ನೇ ಹತ್ತಿ ನಿಂತುಕೊಳ್ಳುವೆನು.</para>
  <para style="q1" vid="HAB 2:1">ಯೆಹೋವ ದೇವರು ನನಗೆ ಏನು ಹೇಳುವರೋ,</para>
  <para style="q2" vid="HAB 2:1">ಯಾವ ಉತ್ತರ ಕೊಡುವರೋ, ಎಂದು ಎದುರು ನೋಡುವೆನು.<verse eid="HAB 2:1"/></para>
  <para style="s1">ಯೆಹೋವ ದೇವರ ಉತ್ತರ</para>
  <para style="p">
    <verse number="2" style="v" sid="HAB 2:2"/>ಆಗ ಯೆಹೋವ ದೇವರು ನನಗೆ ಉತ್ತರಕೊಟ್ಟರು.</para>
  <para style="q1" vid="HAB 2:2">ಪ್ರಕಟನೆಯನ್ನು ಬರೆ.</para>
  <para style="q2" vid="HAB 2:2">ಅದನ್ನು ಓದುವವನು ಶೀಘ್ರವಾಗಿ ಓದುವಂತೆ,</para>
  <para style="q2" vid="HAB 2:2">ಅದನ್ನು ಹಲಗೆಗಳ ಮೇಲೆ ಕೆತ್ತು.<verse eid="HAB 2:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="HAB 2:3"/>ಏಕೆಂದರೆ ಪ್ರಕಟನೆಯು ಇನ್ನೂ ನೇಮಕವಾದ ಕಾಲಕ್ಕಾಗಿ ಎದುರು ನೋಡುವುದು.</para>
  <para style="q2" vid="HAB 2:3">ಅದು ಅಂತ್ಯದ ಬಗ್ಗೆ ಮಾತಾಡುವುದು.</para>
  <para style="q2" vid="HAB 2:3">ಅದು ಸುಳ್ಳಾಗದು. ಅದು ತಡವಾದರೂ,</para>
  <para style="q1" vid="HAB 2:3">ಅದಕ್ಕೆ ಕಾದುಕೊಂಡಿರು.</para>
  <para style="q2" vid="HAB 2:3">ಏಕೆಂದರೆ ಅದು ತಡಮಾಡದೆ</para>
  <para style="q2" vid="HAB 2:3">ನಿಶ್ಚಯವಾಗಿ ಬರುವುದು.<verse eid="HAB 2:3"/></para>
  <para style="b"/>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="HAB 2:4"/>ಇಗೋ, ಹೆಚ್ಚಿಸಿಕೊಂಡವನ ಆತ್ಮವು ತನ್ನಲ್ಲಿ ಯಥಾರ್ಥವಲ್ಲ.</para>
  <para style="q2" vid="HAB 2:4">ಆದರೆ ನೀತಿವಂತನು ತನ್ನ ನಂಬಿಕೆಯಿಂದಲೇ ಬದುಕುವನು.<verse eid="HAB 2:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="HAB 2:5"/>ಇದಲ್ಲದೆ ದ್ರಾಕ್ಷಾರಸವು ಮೋಸಕರ.</para>
  <para style="q2" vid="HAB 2:5">ಅವನು ಅಹಂಕಾರಿ, ಎಂದಿಗೂ ವಿಶ್ರಾಂತಿ ಹೊಂದನು.</para>
  <para style="q1" vid="HAB 2:5">ಪಾತಾಳದ ಹಾಗೆ ತನ್ನ ಆಶೆಯನ್ನು ದೊಡ್ಡದಾಗಿ ಮಾಡಿಕೊಳ್ಳುತ್ತಾನೆ.</para>
  <para style="q2" vid="HAB 2:5">ಮರಣದ ಹಾಗಿದ್ದಾನೆ, ತೃಪ್ತಿಯಾಗುವುದಿಲ್ಲ;</para>
  <para style="q1" vid="HAB 2:5">ಎಲ್ಲಾ ಜನಾಂಗಗಳನ್ನು ತನಗಾಗಿ ಕೂಡಿಸುತ್ತಾನೆ;</para>
  <para style="q2" vid="HAB 2:5">ಎಲ್ಲಾ ಜನರನ್ನು ತನ್ನ ಸೆರೆಯಾಳುಗಳಾಗಿ ಮಾಡಿಕೊಳ್ಳುತ್ತಾನೆ.<verse eid="HAB 2:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="HAB 2:6"/>ಅವರೆಲ್ಲರೂ ಅವನನ್ನು ಅಪಹಾಸ್ಯದ ಮಾತುಗಳಿಂದ ಅವಮಾನ ಮಾಡುವುದಿಲ್ಲವೋ?</para>
  <para style="q1" vid="HAB 2:6">ಕದ್ದುಕೊಂಡ ವಸ್ತುಗಳನ್ನು ರಾಶಿಯಾಗಿ ಕೂಡಿಸಿಟ್ಟುಕೊಳ್ಳುವವನಿಗೆ</para>
  <para style="q2" vid="HAB 2:6">ಅಕ್ರಮ ಮಾರ್ಗದಿಂದ ಐಶ್ವರ್ಯವಂತನಾಗಿರುವವನಿಗೆ ಕಷ್ಟ.</para>
  <para style="q2" vid="HAB 2:6">ಇದೆಷ್ಟರವರೆಗೆ ಮುಂದುವರಿಯಬೇಕು?<verse eid="HAB 2:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="HAB 2:7"/>ನಿನ್ನ ಸಾಲಗಾರರು ಕ್ಷಣಮಾತ್ರದಲ್ಲಿ ಏಳರೋ?</para>
  <para style="q2" vid="HAB 2:7">ಅವರು ಎಚ್ಚರಗೊಂಡು ನಿನಗೆ ಬೆದರಿಕೆ ಹಾಕುವರೋ?</para>
  <para style="q2" vid="HAB 2:7">ಆಗ ನೀನು ಅವರಿಗೆ ಸುಲಿಗೆಯಾಗುವೆ.<verse eid="HAB 2:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="HAB 2:8"/>ನೀನು ಅನೇಕ ಜನಾಂಗಗಳನ್ನು ಸೂರೆ ಮಾಡಿದ್ದರಿಂದ,</para>
  <para style="q2" vid="HAB 2:8">ಜನರಲ್ಲಿ ಉಳಿದವರೆಲ್ಲಾ ನಿನ್ನನ್ನು ಸೂರೆ ಮಾಡುವರು.</para>
  <para style="q1" vid="HAB 2:8">ಏಕೆಂದರೆ ನೀನು ಮಾನವರ ರಕ್ತ ಸುರಿಸಿದ್ದಿ.</para>
  <para style="q2" vid="HAB 2:8">ನಾಡುಗಳನ್ನು, ಪಟ್ಟಣಗಳನ್ನು, ಅವುಗಳಲ್ಲಿ ಇರುವುದೆಲ್ಲವನ್ನು ನಾಶಮಾಡಿದ್ದೀ.<verse eid="HAB 2:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="HAB 2:9"/>ಅನ್ಯಾಯದ ಲಾಭದಿಂದ ತನ್ನ ನಿವಾಸ ಕಟ್ಟಿಕೊಳ್ಳುವವನಿಗೂ,</para>
  <para style="q2" vid="HAB 2:9">ತನ್ನ ಗೂಡನ್ನು ಉನ್ನತದಲ್ಲಿಡುವವನಿಗೂ,</para>
  <para style="q2" vid="HAB 2:9">ನಾಶದ ಹಿಡಿತದಿಂದ ತಪ್ಪಿಸಿಕೊಳ್ಳಬಯಸುವವನಿಗೂ ಕಷ್ಟ!<verse eid="HAB 2:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="HAB 2:10"/>ನೀನು ಬಹು ಜನಾಂಗಗಳನ್ನು ನಿರ್ಮೂಲ ಮಾಡಿದ್ದು,</para>
  <para style="q2" vid="HAB 2:10">ನಿನ್ನ ಕುಲಕ್ಕೆ ಅವಮಾನವನ್ನೇ ಆಲೋಚಿಸಿಕೊಂಡ ಹಾಗಾಯಿತು.</para>
  <para style="q2" vid="HAB 2:10">ನಿನಗೆ ನೀನೇ ಕೆಡುಕು ಮಾಡಿಕೊಂಡಿದ್ದೀ.<verse eid="HAB 2:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="HAB 2:11"/>ಗೋಡೆಯೊಳಗಿಂದ ಕಲ್ಲು ಕೂಗುತ್ತದೆ.</para>
  <para style="q2" vid="HAB 2:11">ಮರದ ತೊಲೆ ಅದಕ್ಕೆ ಉತ್ತರ ಕೊಡುತ್ತದೆ.<verse eid="HAB 2:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="HAB 2:12"/>ಊರನ್ನು ನರಹತ್ಯದಿಂದ ಕಟ್ಟಿ, ಪಟ್ಟಣವನ್ನು</para>
  <para style="q2" vid="HAB 2:12">ಅನ್ಯಾಯದಿಂದ ಸ್ಥಾಪಿಸುವವನಿಗೆ ಕಷ್ಟ!<verse eid="HAB 2:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="HAB 2:13"/>ಜನರ ಶ್ರಮೆಯು ಬೆಂಕಿಗೆ ತುತ್ತಾಗುವುದು.</para>
  <para style="q2" vid="HAB 2:13">ಜನಾಂಗಗಳು ವ್ಯರ್ಥವಾಗಿ ದಣಿದುಕೊಳ್ಳುತ್ತವೆ.</para>
  <para style="q2" vid="HAB 2:13">ಇದು ಸೇನಾಧೀಶ್ವರ ಯೆಹೋವ ದೇವರ ಚಿತ್ತವಷ್ಟೆ.<verse eid="HAB 2:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="HAB 2:14"/>ಸಮುದ್ರವು ನೀರಿನಿಂದ ತುಂಬಿಕೊಂಡಿರುವಂತೆ,</para>
  <para style="q2" vid="HAB 2:14">ಯೆಹೋವ ದೇವರ ಮಹಿಮೆಯ ತಿಳುವಳಿಕೆಯು ಭೂಮಿಯಲ್ಲಿ ತುಂಬಿಕೊಂಡಿರುವುದು.<verse eid="HAB 2:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="HAB 2:15"/>ನಿನ್ನ ರೋಷವನ್ನು ಪಾನಕಕ್ಕೆ ಬೆರಸಿ, ನಿನ್ನ ನೆರೆಯವರಿಗೆ ಕುಡಿಸಿ,</para>
  <para style="q2" vid="HAB 2:15">ಅವರ ಬೆತ್ತಲೆತನವನ್ನು ನೋಡಬೇಕೆಂದು ಅವರನ್ನು ಅಮಲೇರಿಸಿದವನೇ,</para>
  <para style="q2" vid="HAB 2:15">ಅಯ್ಯೋ, ನಿನ್ನ ಗತಿಯನ್ನು ಏನು ಹೇಳಲಿ!<verse eid="HAB 2:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="HAB 2:16"/>ಮಹಿಮೆಯ ಬದಲಾಗಿ ನಾಚಿಕೆಯಿಂದ ನೀನು ತುಂಬಿರುವೆ.</para>
  <para style="q2" vid="HAB 2:16">ಈಗ ನಿನ್ನ ಸರದಿ, ಕುಡಿದು ಬೆತ್ತಲೆಯಾಗು.</para>
  <para style="q1" vid="HAB 2:16">ಯೆಹೋವ ದೇವರ ಬಲಗೈಯಲ್ಲಿನ ಪಾತ್ರೆ ನಿನ್ನ ಕಡೆಗೆ ತಿರುಗುವುದು.</para>
  <para style="q2" vid="HAB 2:16">ನಿನ್ನ ಘನತೆಯನ್ನು ಅವಮಾನವು ಮುಚ್ಚುವುದು.<verse eid="HAB 2:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="HAB 2:17"/>ಲೆಬನೋನಿನ ಮೇಲೆ ಮಾಡಿದ ಬಲಾತ್ಕಾರವು ನಿನ್ನನ್ನು ಚಕಿತಗೊಳಿಸುವುದು.</para>
  <para style="q2" vid="HAB 2:17">ಮೃಗಗಳ ನಾಶವು ನಿನ್ನನ್ನು ಹೆದರಿಸುವುದು.</para>
  <para style="q1" vid="HAB 2:17">ಏಕೆಂದರೆ ನೀನು ಮನುಷ್ಯರ ರಕ್ತ ಸುರಿಸಿದ್ದೀ;</para>
  <para style="q2" vid="HAB 2:17">ನೀನು ನಾಡುಗಳನ್ನು, ಪಟ್ಟಣಗಳನ್ನು, ಅವುಗಳಲ್ಲಿರುವ ಎಲ್ಲವುಗಳನ್ನು ನಾಶಮಾಡಿದ್ದೀ.<verse eid="HAB 2:17"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="18" style="v" sid="HAB 2:18"/>“ಮನುಷ್ಯನು ಕೆತ್ತಿ ರೂಪಿಸಿದ ವಿಗ್ರಹದಿಂದ ಪ್ರಯೋಜನವೇನು?</para>
  <para style="q2" vid="HAB 2:18">ಸುಳ್ಳನ್ನು ಬೋಧಿಸುವಂಥ ಪ್ರತಿಮೆಯ ಬೆಲೆಯೇನು?</para>
  <para style="q1" vid="HAB 2:18">ಅದನ್ನು ರೂಪಿಸಿದವನು, ತನ್ನ ಸ್ವಂತ ಸೃಷ್ಟಿಯನ್ನು ನಂಬುತ್ತಾನೆ.</para>
  <para style="q2" vid="HAB 2:18">ಮಾತನಾಡದಂಥ ಮೂರ್ತಿಗಳನ್ನು ಅವನು ಮಾಡುತ್ತಾನೆ.<verse eid="HAB 2:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="HAB 2:19"/>ಮರಕ್ಕೆ, ‘ಎಚ್ಚರವಾಗು!’ ಮೂಕವಾದ ಕಲ್ಲಿಗೆ, ‘ಎದ್ದೇಳು!’ ಎಂದು ಹೇಳುವವನಿಗೆ ಕಷ್ಟ!</para>
  <para style="q2" vid="HAB 2:19">ಅದು ಮಾರ್ಗದರ್ಶನ ನೀಡುವುದೇ?</para>
  <para style="q1" vid="HAB 2:19">ಅದು ಬಂಗಾರ, ಬೆಳ್ಳಿಯಿಂದ ಹೊದಿಸಿದ್ದಾರೆ.</para>
  <para style="q2" vid="HAB 2:19">ಆದರೆ ಅದರಲ್ಲಿ ಉಸಿರು ಎಷ್ಟು ಮಾತ್ರವೂ ಇಲ್ಲ.”<verse eid="HAB 2:19"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="20" style="v" sid="HAB 2:20"/>ಆದರೆ ಯೆಹೋವ ದೇವರು ತಮ್ಮ ಪರಿಶುದ್ಧ ಮಂದಿರದಲ್ಲಿ ಇದ್ದಾರೆ.</para>
  <para style="q2" vid="HAB 2:20">ಅವರ ಮುಂದೆ ಭೂಮಿಯೆಲ್ಲಾ ಮೌನವಾಗಿರಲಿ.<verse eid="HAB 2:20"/></para>
  <chapter eid="HAB 2"/>
  <chapter number="3" style="c" sid="HAB 3"/>
  <para style="s1">ಹಬಕ್ಕೂಕನ ಪ್ರಾರ್ಥನೆ</para>
  <para style="d">
    <verse number="1" style="v" sid="HAB 3:1"/>
    <char style="tl">ಶಿಗ್ಯೋನೋತ</char> ಸ್ವರದ ಮೇಲೆ ಪ್ರವಾದಿಯಾದ ಹಬಕ್ಕೂಕನ ಪ್ರಾರ್ಥನೆ.<verse eid="HAB 3:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="HAB 3:2"/>ಯೆಹೋವ ದೇವರೇ, ನಿಮ್ಮ ಕೀರ್ತಿಯನ್ನು ನಾನು ಕೇಳಿದ್ದೇನೆ,</para>
  <para style="q2" vid="HAB 3:2">ಯೆಹೋವ ದೇವರೇ, ನಿಮ್ಮ ಕಾರ್ಯಗಳಿಗಾಗಿ ನಿಮ್ಮ ಮುಂದೆ ಭಯಭಕ್ತಿಯಿಂದ ನಿಲ್ಲುತ್ತೇನೆ.</para>
  <para style="q1" vid="HAB 3:2">ನಮ್ಮ ದಿನಗಳಲ್ಲಿ ಅವುಗಳನ್ನು ಪುನಃ ಮಾಡಿರಿ.</para>
  <para style="q2" vid="HAB 3:2">ನಮ್ಮ ವರ್ಷಗಳ ಮಧ್ಯದಲ್ಲಿ ಅವುಗಳನ್ನು ತಿಳಿಸಿರಿ,</para>
  <para style="q2" vid="HAB 3:2">ನೀನು ರೋಷಗೊಂಡಿದ್ದರೂ ಕರುಣೆಯನ್ನು ಜ್ಞಾಪಕಮಾಡಿಕೊಳ್ಳಿರಿ.<verse eid="HAB 3:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="HAB 3:3"/>ದೇವರು, ತೇಮಾನಿನಿಂದಲೂ;</para>
  <para style="q2" vid="HAB 3:3">ಪರಿಶುದ್ಧರು, ಪಾರಾನ್ ಪರ್ವತದಿಂದಲೂ ಬಂದರು.</para>
  <para style="q1" vid="HAB 3:3">ಅವರ ಮಹಿಮೆ ಆಕಾಶಗಳನ್ನು ಮುಚ್ಚಿತು.</para>
  <para style="q2" vid="HAB 3:3">ಅವರ ಸ್ತೋತ್ರವು ಭೂಮಿಯನ್ನು ತುಂಬಿಸಿತು.<verse eid="HAB 3:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="HAB 3:4"/>ಅವರ ತೇಜಸ್ಸು ಸೂರ್ಯೋದಯದ ಹಾಗಿತ್ತು.</para>
  <para style="q2" vid="HAB 3:4">ಕಿರಣಗಳು ಅವರ ಹಸ್ತಗಳಿಂದ ಮಿಂಚಿದವು.</para>
  <para style="q2" vid="HAB 3:4">ಅದರಲ್ಲಿ ಅವರ ಬಲ ಅಡಗಿತ್ತು.<verse eid="HAB 3:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="HAB 3:5"/>ಅವರ ಮುಂದೆ ವ್ಯಾಧಿಯು ಹೋಯಿತು.</para>
  <para style="q2" vid="HAB 3:5">ವ್ಯಾಧಿಯು ಅವನ ಹೆಜ್ಜೆಗಳನ್ನು ಅನುಸರಿಸಿತು.<verse eid="HAB 3:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="HAB 3:6"/>ಅವರು ನಿಂತುಕೊಂಡು ಭೂಮಿಯನ್ನು ನಡುಗಿಸಿದರು.</para>
  <para style="q2" vid="HAB 3:6">ಅವರು ನೋಡಿ ಜನಾಂಗಗಳನ್ನು ನಡುಗುವಂತೆ ಮಾಡಿದರು.</para>
  <para style="q1" vid="HAB 3:6">ಪುರಾತನ ಪರ್ವತಗಳು ಸೀಳಿಹೋದವು.</para>
  <para style="q2" vid="HAB 3:6">ಹಳೆಯ ಕಾಲದ ಗುಡ್ಡಗಳು ಬಿದ್ದು ಹೋದವು.</para>
  <para style="q2" vid="HAB 3:6">ಅವರ ಮಾರ್ಗಗಳು ನಿತ್ಯವಾದವುಗಳೇ.<verse eid="HAB 3:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="HAB 3:7"/>ಕೂಷಾನಿನ ಡೇರೆಗಳು ಕಷ್ಟದಲ್ಲಿರುವುದನ್ನು ಕಂಡೆನು.</para>
  <para style="q2" vid="HAB 3:7">ಮಿದ್ಯಾನಿನ ನಿವಾಸಗಳು ವೇದನೆಯಿಂದ ನಡುಗಿದವು.<verse eid="HAB 3:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="HAB 3:8"/>ಯೆಹೋವ ದೇವರೇ, ನದಿಗಳ ಮೇಲೆ ರೌದ್ರಗೊಂಡಿರುವಿರೋ?</para>
  <para style="q2" vid="HAB 3:8">ಪ್ರವಾಹಗಳ ಮೇಲೆ ನಿಮ್ಮ ಕೋಪವಿತ್ತೋ?</para>
  <para style="q1" vid="HAB 3:8">ನೀವು ಕುದುರೆಗಳನ್ನು ಮತ್ತು ರಥಗಳನ್ನು ಮುನ್ನಡೆಸಿದಾಗ</para>
  <para style="q2" vid="HAB 3:8">ವಿಜಯಕ್ಕೆ ನೀವು ಸಮುದ್ರದ ಮೇಲೆ ಕೋಪಗೊಂಡಿದ್ದೀರಾ?<verse eid="HAB 3:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="HAB 3:9"/>ನಿನ್ನ ಬಿಲ್ಲನ್ನು ಹೊರ ತೆಗೆದಿ,</para>
  <para style="q2" vid="HAB 3:9">ಅನೇಕ ಬಾಣಗಳಿಗಾಗಿ ಕರೆ ಕೊಟ್ಟಿದ್ದಿ,</para>
  <para style="q1" vid="HAB 3:9">ಭೂಮಿಯನ್ನು ನದಿಗಳಿಂದ ಸೀಳಿಬಿಡುವೆ.<verse eid="HAB 3:9"/></para>
  <para style="q2">
    <verse number="10" style="v" sid="HAB 3:10"/>ಬೆಟ್ಟಗಳು ನಿನ್ನನ್ನು ಕಂಡು ನಡುಗಿದವು;</para>
  <para style="q1" vid="HAB 3:10">ಜಲಪ್ರವಾಹವು ಹಾದುಹೋಯಿತು;</para>
  <para style="q2" vid="HAB 3:10">ಸಾಗರವು ಗರ್ಜಿಸಿ;</para>
  <para style="q2" vid="HAB 3:10">ತನ್ನ ತೆರೆಗಳನ್ನು ಮೇಲಕ್ಕೆ ಎತ್ತುತ್ತದೆ.<verse eid="HAB 3:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="HAB 3:11"/>ನಿನ್ನ ಹಾರುವ ಬಾಣಗಳ ಬೆಳಗಿಗೂ,</para>
  <para style="q2" vid="HAB 3:11">ನಿನ್ನ ಮಿಂಚುವ ಈಟಿಯ ಹೊಳಪಿಗೂ</para>
  <para style="q2" vid="HAB 3:11">ಸೂರ್ಯ ಚಂದ್ರರು ಆಕಾಶದಲ್ಲಿ ಸ್ಥಿರವಾಗಿದ್ದಾರೆ.<verse eid="HAB 3:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="HAB 3:12"/>ನೀನು ಸಿಟ್ಟಿನಿಂದ ದೇಶದ ಮೇಲೆ ನಡೆದುಹೋಗಿ,</para>
  <para style="q2" vid="HAB 3:12">ಕೋಪದಿಂದ ಜನಾಂಗಗಳನ್ನು ತುಳಿದು ಹಾಕಿದ್ದೀಯೆ.<verse eid="HAB 3:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="HAB 3:13"/>ನಿನ್ನ ಜನರ ರಕ್ಷಣೆಗೋಸ್ಕರವೂ,</para>
  <para style="q2" vid="HAB 3:13">ನಿನ್ನ ಅಭಿಷಿಕ್ತನ ರಕ್ಷಣೆಗೋಸ್ಕರವೂ ಹೊರಗೆ ಹೊರಟು ಬಂದಿ.</para>
  <para style="q1" vid="HAB 3:13">ದುಷ್ಟ ದೇಶದ ನಾಯಕನನ್ನು ನೀನು ತುಳಿದುಬಿಟ್ಟಿ.</para>
  <para style="q2" vid="HAB 3:13">ತಲೆಯಿಂದ ಪಾದದವರೆಗೆ ಅವನನ್ನು ಬೆತ್ತಲೆ ಮಾಡಿದಿ.<verse eid="HAB 3:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="HAB 3:14"/>ನಮ್ಮನ್ನು ಚದುರಿಸಲು ಅವನ ಯುದ್ಧವೀರರು ಮುತ್ತಿಗೆ ಹಾಕಿದಾಗ,</para>
  <para style="q2" vid="HAB 3:14">ಅವನ ಸ್ವಂತ ಭರ್ಜಿಯಿಂದಲೇ ಅವನ ತಲೆಯನ್ನು ತಿವಿದಿ.</para>
  <para style="q1" vid="HAB 3:14">ಅವರು ಅಡಗಿಕೊಂಡಿರುವ ಬಡವರನ್ನು</para>
  <para style="q2" vid="HAB 3:14">ನುಂಗಲು ಬಂದವರೋ ಎಂಬಂತೆ ಬಂದಿದ್ದರಲ್ಲವೇ?<verse eid="HAB 3:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="HAB 3:15"/>ನೀನು ನಿನ್ನ ಕುದುರೆಗಳ ಸಂಗಡ ಸಮುದ್ರದಲ್ಲಿಯೂ,</para>
  <para style="q2" vid="HAB 3:15">ಮಹಾಜಲಗಳ ಸಮೂಹದಲ್ಲಿಯೂ ನಡೆದು ಹೋದೆ.<verse eid="HAB 3:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="HAB 3:16"/>ನಾನು ಕೇಳಿದಾಗ ನನ್ನ ಹೃದಯ ಬಡಿದುಕೊಂಡಿತು;</para>
  <para style="q2" vid="HAB 3:16">ಆ ಶಬ್ದಕ್ಕೆ ನನ್ನ ತುಟಿಗಳು ಕದಲಿದವು;</para>
  <para style="q1" vid="HAB 3:16">ನನ್ನ ಎಲುಬುಗಳು ಕ್ಷಯಗೊಂಡವು;</para>
  <para style="q2" vid="HAB 3:16">ನನ್ನ ಕಾಲುಗಳು ನಡುಗಿದವು;</para>
  <para style="q1" vid="HAB 3:16">ಆದರೂ ನಮ್ಮ ಮೇಲೆ ದಾಳಿಮಾಡುವ ಜನರ ಮೇಲೆ</para>
  <para style="q2" vid="HAB 3:16">ನಾಶನ ಬರುವುದನ್ನು ನೋಡಲು ತಾಳ್ಮೆಯಿಂದ ಕಾದಿರುವೆನು.<verse eid="HAB 3:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="HAB 3:17"/>ಅಂಜೂರದ ಗಿಡವು ಚಿಗುರದಿದ್ದರೂ,</para>
  <para style="q2" vid="HAB 3:17">ದ್ರಾಕ್ಷಾಲತೆಗಳಲ್ಲಿ ಹಣ್ಣು ಫಲಿಸದಿದ್ದರೂ,</para>
  <para style="q1" vid="HAB 3:17">ಎಣ್ಣೆಮರಗಳ ಉತ್ಪತ್ತಿಯು ಶೂನ್ಯವಾದರೂ,</para>
  <para style="q2" vid="HAB 3:17">ಹೊಲಗಳು ಆಹಾರ ಕೊಡದಿದ್ದರೂ,</para>
  <para style="q1" vid="HAB 3:17">ಕುರಿಹಟ್ಟಿಗಳು ಬರಿದಾಗಿ ಹೋದರೂ,</para>
  <para style="q2" vid="HAB 3:17">ಕೊಟ್ಟಿಗೆಗಳಲ್ಲಿ ದನಕರುಗಳು ಇಲ್ಲವಾದರೂ,<verse eid="HAB 3:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="HAB 3:18"/>ನಾನು ಯೆಹೋವ ದೇವರಲ್ಲಿ ಉಲ್ಲಾಸಿಸುವೆನು.</para>
  <para style="q2" vid="HAB 3:18">ನನ್ನ ರಕ್ಷಕರಾದ ದೇವರಲ್ಲಿ ಆನಂದಿಸುವೆನು.<verse eid="HAB 3:18"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="HAB 3:19"/>ಸಾರ್ವಭೌಮ ಯೆಹೋವ ದೇವರು ನನ್ನ ಬಲವು.</para>
  <para style="q2" vid="HAB 3:19">ಅವರು ನನ್ನ ಕಾಲುಗಳನ್ನು ಜಿಂಕೆಯ ಕಾಲುಗಳ ಹಾಗೆ ಮಾಡಿ,</para>
  <para style="q2" vid="HAB 3:19">ನನ್ನ, ಉನ್ನತ ಸ್ಥಳಗಳಲ್ಲಿ ನನ್ನನ್ನು ನಡೆಯುವಂತೆ ಮಾಡುತ್ತಾನೆ.</para>
  <para style="d" vid="HAB 3:19">ಪ್ರಧಾನಗಾಯಕನ ಕೀರ್ತನ ಸಂಗ್ರಹದಿಂದ ತೆಗೆದದ್ದು; ನನ್ನ ತಂತಿವಾದ್ಯದೊಡನೆ ಹಾಡತಕ್ಕದ್ದು.<verse eid="HAB 3:19"/></para>
  <chapter eid="HAB 3"/>
</usx>
