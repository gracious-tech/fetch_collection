<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="2CH" style="id">- Biblica® Open Kannada Contemporary Version</book>
  <para style="h">2 ಪೂರ್ವಕಾಲ ವೃತ್ತಾಂತ</para>
  <para style="toc1">ಪೂರ್ವಕಾಲ ವೃತ್ತಾಂತ ದ್ವಿತೀಯ ಭಾಗ</para>
  <para style="toc2">2 ಪೂರ್ವಕಾಲ ವೃತ್ತಾಂತ</para>
  <para style="toc3">2 ಪೂರ್ವ</para>
  <para style="mt1">ಪೂರ್ವಕಾಲ ವೃತ್ತಾಂತ</para>
  <para style="mt2">ದ್ವಿತೀಯ ಭಾಗ</para>
  <chapter number="1" style="c" sid="2CH 1"/>
  <para style="s1">ಸೊಲೊಮೋನನು ಜ್ಞಾನವನ್ನು ಕೇಳಿದ್ದು</para>
  <para style="p">
    <verse number="1" style="v" sid="2CH 1:1"/>ದಾವೀದನ ಮಗ ಸೊಲೊಮೋನನು ತನ್ನ ರಾಜ್ಯದಲ್ಲಿ ಬಲಗೊಂಡನು ಮತ್ತು ಅವನ ದೇವರಾದ ಯೆಹೋವ ದೇವರು ಅವನ ಸಂಗಡ ಇದ್ದು, ಅವನನ್ನು ಉನ್ನತನನ್ನಾಗಿ ಮಾಡಿದರು.<verse eid="2CH 1:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="2CH 1:2"/>ಆಗ ಸೊಲೊಮೋನನು ಸಮಸ್ತ ಇಸ್ರಾಯೇಲರ ಶತಾಧಿಪತಿಗಳೊಂದಿಗೂ, ಸಹಸ್ರಾಧಿಪತಿಗಳೊಂದಿಗೂ, ನ್ಯಾಯಾಧಿಪತಿಗಳೊಂದಿಗೂ, ಪ್ರಧಾನರಾದವರೊಂದಿಗೂ, ಸಮಸ್ತ ಇಸ್ರಾಯೇಲರ ಪಿತೃಗಳ ಶ್ರೇಷ್ಠರಾದ ಸಮಸ್ತ ಪ್ರಭುಗಳೊಂದಿಗೂ ಮಾತನಾಡಿದನು. <verse eid="2CH 1:2"/><verse number="3" style="v" sid="2CH 1:3"/>ಹೀಗೆ ಅವನೂ, ಅವನ ಸಂಗಡ ಸಮಸ್ತ ಸಮೂಹವೂ ಗಿಬ್ಯೋನಿನಲ್ಲಿರುವ ಉನ್ನತ ಸ್ಥಳಕ್ಕೆ ಹೋದರು. ಯೆಹೋವ ದೇವರ ಸೇವಕನಾದ ಮೋಶೆಯು ಮರುಭೂಮಿಯಲ್ಲಿ ಮಾಡಿದ ದೇವದರ್ಶನ ಗುಡಾರವು ಅಲ್ಲಿತ್ತು. <verse eid="2CH 1:3"/><verse number="4" style="v" sid="2CH 1:4"/>ಆದರೆ ದಾವೀದನು ಯೆಹೋವ ದೇವರ ಮಂಜೂಷವನ್ನು ಕಿರ್ಯತ್ ಯಾರೀಮಿನಿಂದ ತಾನು ಅದಕ್ಕೋಸ್ಕರ ಸಿದ್ಧಮಾಡಿದ ಸ್ಥಳಕ್ಕೆ ತೆಗೆದುಕೊಂಡು ಬಂದಿದ್ದನು. ಅವನು ಯೆರೂಸಲೇಮಿನಲ್ಲಿ ಅದಕ್ಕೋಸ್ಕರ ಗುಡಾರವನ್ನು ಹಾಕಿಸಿದ್ದನು. <verse eid="2CH 1:4"/><verse number="5" style="v" sid="2CH 1:5"/>ಆದರೆ ಊರಿಯನ ಮಗ, ಹೂರನ ಮೊಮ್ಮಗನಾದ ಬೆಚಲಯೇಲನು ಮಾಡಿದ ಕಂಚಿನ ಬಲಿಪೀಠವು ಗಿಬ್ಯೋನಿನಲ್ಲಿ ಯೆಹೋವ ದೇವರ ಗುಡಾರದ ಮುಂದೆ ಇತ್ತು. ಅಲ್ಲಿ ಸೊಲೊಮೋನನೂ, ಸಭೆಯೂ ದೇವರ ಇಚ್ಛೆಯನ್ನು ವಿಚಾರಿಸಿದರು. <verse eid="2CH 1:5"/><verse number="6" style="v" sid="2CH 1:6"/>ಆಗ ಸೊಲೊಮೋನನು ಸಭೆಯ ಗುಡಾರದ ಬಳಿಯಲ್ಲಿ ಯೆಹೋವ ದೇವರ ಮುಂದೆ ಇರುವ ಕಂಚಿನ ಪೀಠದ ಬಳಿಗೆ ಹೋಗಿ, ಅದರ ಮೇಲೆ ಸಹಸ್ರ ದಹನಬಲಿಗಳನ್ನು ಅರ್ಪಿಸಿದನು.<verse eid="2CH 1:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="2CH 1:7"/>ಅದೇ ರಾತ್ರಿಯಲ್ಲಿ ದೇವರು ಸೊಲೊಮೋನನಿಗೆ ಕಾಣಿಸಿಕೊಂಡು ಅವನಿಗೆ, “ನಾನು ನಿನಗೆ ಏನು ವರ ಕೊಡಬೇಕು? ಕೇಳಿಕೋ,” ಎಂದರು.<verse eid="2CH 1:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="2CH 1:8"/>ಅದಕ್ಕೆ ಸೊಲೊಮೋನನು ದೇವರಿಗೆ, “ನೀವು ನನ್ನ ತಂದೆ ದಾವೀದನಿಗೆ ಮಹಾಕರುಣೆಯನ್ನು ತೋರಿಸಿದ್ದೀರಿ, ಅವನಿಗೆ ಬದಲಾಗಿ ನಾನು ಆಳುವಂತೆ ಮಾಡಿದಿರಿ. <verse eid="2CH 1:8"/><verse number="9" style="v" sid="2CH 1:9"/>ಈಗ ಯೆಹೋವ ದೇವರೇ, ನೀವು ನನ್ನ ತಂದೆ ದಾವೀದನಿಗೆ ಮಾಡಿದ ವಾಗ್ದಾನವು ದೃಢವಾಗಲಿ. ಏಕೆಂದರೆ ಭೂಮಿಯ ಧೂಳಿನಷ್ಟು ಅಸಂಖ್ಯಾತ ಜನರ ಮೇಲೆ ನನ್ನನ್ನು ಅರಸನನ್ನಾಗಿ ಮಾಡಿದ್ದೀರಿ. <verse eid="2CH 1:9"/><verse number="10" style="v" sid="2CH 1:10"/>ನಾನು ಈ ಜನರನ್ನು ಪರಿಪಾಲಿಸುವುದಕ್ಕೆ ಜ್ಞಾನವನ್ನೂ, ತಿಳುವಳಿಕೆಯನ್ನೂ ಕೊಡಿರಿ. ಏಕೆಂದರೆ ಈ ನಿಮ್ಮ ಮಹಾಜನರ ನ್ಯಾಯತೀರಿಸುವುದಕ್ಕೆ ಸಾಮರ್ಥ್ಯವುಳ್ಳವರು ಯಾರು?” ಎಂದನು.<verse eid="2CH 1:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="2CH 1:11"/>ಆಗ ದೇವರು ಸೊಲೊಮೋನನಿಗೆ, “ಇದು ನಿನ್ನ ಹೃದಯದಲ್ಲಿ ಇದ್ದುದರಿಂದಲೂ ನೀನು ಐಶ್ವರ್ಯವನ್ನೂ, ಸ್ಥಿತಿಯನ್ನೂ, ಘನವನ್ನೂ, ನಿನ್ನ ಶತ್ರುಗಳ ಪ್ರಾಣವನ್ನೂ ಕೇಳದೆ ಮತ್ತು ಹೆಚ್ಚಾದ ದಿವಸಗಳನ್ನೂ ನೀನು ಕೇಳದೆ, ನಾನು ಯಾರ ಮೇಲೆ ನಿನ್ನನ್ನು ಅರಸನಾಗಿ ಮಾಡಿದೆನೋ, ಆ ನನ್ನ ಜನರಿಗೆ ನೀನು ನ್ಯಾಯತೀರಿಸುವ ಹಾಗೆ, ಜ್ಞಾನವನ್ನೂ, ತಿಳುವಳಿಕೆಯನ್ನೂ ನೀನು ಕೇಳಿದ್ದರಿಂದಲೂ; <verse eid="2CH 1:11"/><verse number="12" style="v" sid="2CH 1:12"/>ಜ್ಞಾನ ಮತ್ತು ತಿಳುವಳಿಕೆಯನ್ನು ನಿನಗೆ ಕೊಡುತ್ತೇನೆ. ಇದಲ್ಲದೆ ನಿನಗಿಂತ ಮುಂಚೆ ಇದ್ದ ಅರಸರಲ್ಲಿ ಯಾರಿಗೂ ಇಲ್ಲದಂಥ ಮತ್ತು ನಿನ್ನ ತರುವಾಯ ಯಾರಿಗೂ ಇರದಂಥ ಐಶ್ವರ್ಯವನ್ನೂ, ಆಸ್ತಿಯನ್ನೂ, ಘನವನ್ನೂ ಕೊಡುತ್ತೇನೆ,” ಎಂದರು.<verse eid="2CH 1:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="2CH 1:13"/>ತರುವಾಯ ಸೊಲೊಮೋನನು ಗಿಬ್ಯೋನಿನ ಉನ್ನತ ಸ್ಥಳದಲ್ಲಿದ್ದ ದೇವದರ್ಶನ ಗುಡಾರವನ್ನು ಬಿಟ್ಟು, ಯೆರೂಸಲೇಮಿಗೆ ಬಂದು, ಇಸ್ರಾಯೇಲನ್ನು ಆಳಿದನು.<verse eid="2CH 1:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="2CH 1:14"/>ಇದಲ್ಲದೆ ಸೊಲೊಮೋನನು ರಥಗಳನ್ನೂ, ರಾಹುತರನ್ನೂ ಕೂಡಿಸಿದನು. ಸಾವಿರದ ನಾನೂರು ರಥಗಳು, ಹನ್ನೆರಡು ಸಾವಿರ ಕುದುರೆಯ ರಾಹುತರು ಇದ್ದರು. ಇವುಗಳಲ್ಲಿ ಕೆಲವನ್ನು ಯೆರೂಸಲೇಮಿನಲ್ಲಿ ತನ್ನ ಬಳಿಯಲ್ಲಿಯೇ ಇರಿಸಿದನು, ಉಳಿದವುಗಳನ್ನು ರಥಗಳ ಪಟ್ಟಣಗಳಲ್ಲಿಯೂ ಇರಿಸಿದನು. <verse eid="2CH 1:14"/><verse number="15" style="v" sid="2CH 1:15"/>ಅರಸನ ಕಾಲದಲ್ಲಿ ಯೆರೂಸಲೇಮಿನಲ್ಲಿ ಬೆಳ್ಳಿಬಂಗಾರವನ್ನು ಕಲ್ಲುಗಳಂತೆಯೂ, ದೇವದಾರು ಮರಗಳನ್ನು ತಗ್ಗಿನಲ್ಲಿರುವ ಅತ್ತಿಮರಗಳಂತೆಯೂ ಪರಿಗಣಿಸಲಾಯಿತು. <verse eid="2CH 1:15"/><verse number="16" style="v" sid="2CH 1:16"/>ಇದಲ್ಲದೆ ಸೊಲೊಮೋನನಿಗೆ ಈಜಿಪ್ಟಿನಿಂದಲೂ ಕುವೆಯಿಂದಲೂ ಕುದುರೆಗಳು ಬರುತ್ತಿದ್ದವು. ಅರಸನ ವರ್ತಕರು ಅವುಗಳನ್ನು ಹಿಂಡುಹಿಂಡಾಗಿ ಕೊಂಡುಕೊಂಡು ಬರುತ್ತಿದ್ದರು <verse eid="2CH 1:16"/><verse number="17" style="v" sid="2CH 1:17"/>ಹಾಗೆಯೇ ಈಜಿಪ್ಟಿನಿಂದ ಆರುನೂರು ಬೆಳ್ಳಿ ನಾಣ್ಯಗಳ ಕ್ರಯಕ್ಕೆ ಒಂದು ರಥವನ್ನೂ ನೂರ ಐವತ್ತು ಬೆಳ್ಳಿ ನಾಣ್ಯಗಳ ಕ್ರಯಕ್ಕೆ ಒಂದು ಕುದುರೆಯನ್ನೂ ತರಿಸುತ್ತಿದ್ದರು. ಈ ಪ್ರಕಾರ ಹಿತ್ತಿಯರ ಮತ್ತು ಅರಾಮಿನ ಅರಸುಗಳೆಲ್ಲರು ಇವರ ಮುಖಾಂತರವಾಗಿಯೇ ತರಿಸುತ್ತಿದ್ದರು.<verse eid="2CH 1:17"/></para>
  <chapter eid="2CH 1"/>
  <chapter number="2" style="c" sid="2CH 2"/>
  <para style="s1">ದೇವಾಲಯವನ್ನು ಕಟ್ಟಿಸುವುದಕ್ಕೆ ವ್ಯವಸ್ಥೆ</para>
  <para style="p">
    <verse number="1" style="v" sid="2CH 2:1"/>ಯೆಹೋವ ದೇವರಿಗೋಸ್ಕರ ಒಂದು ಆಲಯವನ್ನೂ, ತನಗೋಸ್ಕರ ಒಂದು ಅರಮನೆಯನ್ನೂ ಕಟ್ಟಿಸಲು ಸೊಲೊಮೋನನು ಅಪ್ಪಣೆಕೊಟ್ಟನು. <verse eid="2CH 2:1"/><verse number="2" style="v" sid="2CH 2:2"/>ಅದಕ್ಕಾಗಿ 70,000 ಹೊರುವವರನ್ನೂ, 80,000 ಬೆಟ್ಟದಲ್ಲಿ ಕಡಿಯುವವರನ್ನೂ, ಇವರ ಮೇಲೆ ಕಾವಲಾಗಿರಲು 3,600 ಮಂದಿಯನ್ನೂ ಆಯ್ಕೆಮಾಡಿದನು.<verse eid="2CH 2:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="2CH 2:3"/>ಸೊಲೊಮೋನನು ಟೈರಿನ ಅರಸನಾದ ಹೀರಾಮನಿಗೆ,</para>
  <para style="pm" vid="2CH 2:3">“ನೀನು ನನ್ನ ತಂದೆ ದಾವೀದನಿಗೆ ವಾಸವಾಗಿರುವ ಅರಮನೆಯನ್ನು ಕಟ್ಟಿಸಲು, ದೇವದಾರು ಮರಗಳನ್ನು ಕಳುಹಿಸಿ, ಅವನಿಗೋಸ್ಕರ ಹೇಗೆ ಸಹಾಯ ಮಾಡಿದೆಯೋ, ಹಾಗೆಯೇ ನನಗೂ ಮಾಡು. <verse eid="2CH 2:3"/><verse number="4" style="v" sid="2CH 2:4"/>ನನ್ನ ದೇವರಾದ ಯೆಹೋವ ದೇವರಿಗೆ ಪ್ರತಿಷ್ಠೆ ಮಾಡುವುದಕ್ಕೂ, ದೇವಸನ್ನಿಧಿಗೆ ಪರಿಮಳ ಧೂಪವನ್ನು ಅರ್ಪಿಸುವ ನಿತ್ಯ ಸಮ್ಮುಖದ ರೊಟ್ಟಿಗೋಸ್ಕರವೂ, ಸಬ್ಬತ್ ದಿನಗಳಲ್ಲಿಯೂ, ಅಮಾವಾಸ್ಯೆಗಳಲ್ಲಿಯೂ, ಇಸ್ರಾಯೇಲರಿಗೆ ನಿರಂತರವಾಗಿರಲು ನೇಮಿಸಿದ ನಮ್ಮ ದೇವರಾದ ಯೆಹೋವ ದೇವರ ಹಬ್ಬಗಳಲ್ಲಿಯೂ, ಉದಯಕಾಲದ ಸಾಯಂಕಾಲದ ದಹನಬಲಿಗಳಿಗೋಸ್ಕರವೂ ನಮ್ಮ ದೇವರಾದ ಯೆಹೋವ ದೇವರ ನಾಮಕ್ಕೆ ಆಲಯವನ್ನು ಕಟ್ಟಿಸುತ್ತೇನೆ.<verse eid="2CH 2:4"/></para>
  <para style="pm">
    <verse number="5" style="v" sid="2CH 2:5"/>“ನಾನು ಕಟ್ಟಿಸುವ ಆಲಯವು ದೊಡ್ಡದು. ಏಕೆಂದರೆ ನಮ್ಮ ದೇವರು ಸಕಲ ದೇವರುಗಳಿಗಿಂತ ದೊಡ್ಡವರಾಗಿದ್ದಾರೆ. <verse eid="2CH 2:5"/><verse number="6" style="v" sid="2CH 2:6"/>ಆದರೆ ಅವರಿಗೋಸ್ಕರ ಆಲಯವನ್ನು ಕಟ್ಟಿಸಲು ಸಮರ್ಥನಾದವನು ಯಾರು? ಆಕಾಶವೂ ಉನ್ನತೋನ್ನತ ಆಕಾಶವೂ ಅವರಿಗೆ ಸಾಲದು. ಅವರ ಸನ್ನಿಧಿಯಲ್ಲಿ ಯಜ್ಞವನ್ನು ಅರ್ಪಿಸುವುದಕ್ಕೆ ಒಂದು ಆಲಯವನ್ನು ಕಟ್ಟಬಹುದೇ ಹೊರತು ಅವರಿಗೆ ಆಲಯವನ್ನು ಕಟ್ಟಿಸಲು ನಾನು ಎಷ್ಟರವನು?<verse eid="2CH 2:6"/></para>
  <para style="pm">
    <verse number="7" style="v" sid="2CH 2:7"/>“ಆದ್ದರಿಂದ ಬಂಗಾರದಲ್ಲಿಯೂ, ಬೆಳ್ಳಿಯಲ್ಲಿಯೂ, ಕಂಚಿನಲ್ಲಿಯೂ, ಕಬ್ಬಿಣದಲ್ಲಿಯೂ, ರಕ್ತವರ್ಣ, ಲೋಹಿತ ವರ್ಣ, ನೀಲ ವರ್ಣಗಳಲ್ಲಿಯೂ ಕೆಲಸವನ್ನು ಮಾಡಲು ಜ್ಞಾನವುಳ್ಳವನನ್ನು, ನನ್ನ ತಂದೆ ದಾವೀದನು ಸಿದ್ಧಮಾಡಿದ ಯೆಹೂದದಲ್ಲಿಯೂ, ಯೆರೂಸಲೇಮಿನಲ್ಲಿಯೂ, ನನ್ನ ಬಳಿಯಲ್ಲಿರುವ ಕುಶಲಕರ್ಮಿಗಳ ಸಂಗಡ ಕೆತ್ತಲು ತಿಳುವಳಿಕೆಯುಳ್ಳವನಾಗಿ ಇರುವವನನ್ನು ನನ್ನ ಬಳಿಗೆ ಕಳುಹಿಸು.<verse eid="2CH 2:7"/></para>
  <para style="pm">
    <verse number="8" style="v" sid="2CH 2:8"/>“ನೀನು ಇಲ್ಲಿಗೆ ದೇವದಾರು ಮರಗಳನ್ನೂ, ತುರಾಯಿ ಮರಗಳನ್ನೂ, ಸುಗಂಧದ ಮರಗಳನ್ನೂ ಲೆಬನೋನಿನಿಂದ ನನ್ನ ಬಳಿಗೆ ಕಳುಹಿಸು. ಲೆಬನೋನಿನಲ್ಲಿ ಮರಗಳನ್ನು ಕಡಿಯಲು ನಿನ್ನ ಸೇವಕರು ನಿಪುಣರಾಗಿದ್ದಾರೆ. ನನ್ನ ಸೇವಕರು ಅವರ ಸಂಗಡ ಇರುವರು. <verse eid="2CH 2:8"/><verse number="9" style="v" sid="2CH 2:9"/>ನನಗೆ ಮರಗಳನ್ನು ಬಹಳವಾಗಿ ಸಿದ್ಧಮಾಡುವುದಕ್ಕೆ ನಾನು ಕಟ್ಟಿಸುವ ಆಲಯವು ದೊಡ್ಡದಾಗಿಯೂ, ಅದ್ಭುತಕರವಾದದ್ದಾಗಿಯೂ ಇರಬೇಕು. <verse eid="2CH 2:9"/><verse number="10" style="v" sid="2CH 2:10"/>ಮರ ಕಡಿಯುವ ನಿನ್ನ ಸೇವಕರಿಗಾಗಿ, ಎರಡು ಸಾವಿರ ಟನ್ ಗೋಧಿಯನ್ನೂ, ಮೂರು ಸಾವಿರ ಟನ್ ಜವೆಗೋಧಿಯನ್ನೂ, ನಾಲ್ಕು ಲಕ್ಷ ನಲವತ್ತು ಸಾವಿರ ಲೀಟರ್ ದ್ರಾಕ್ಷಾರಸವನ್ನೂ, ನಾಲ್ಕು ಲಕ್ಷ ನಲವತ್ತು ಸಾವಿರ ಲೀಟರ್ ಎಣ್ಣೆಯನ್ನೂ ಕೊಡುವೆನು,” ಎಂದು ಹೇಳಿಸಿದನು.<verse eid="2CH 2:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="2CH 2:11"/>ಆಗ ಟೈರಿನ ಅರಸನಾದ ಹೀರಾಮನು ಉತ್ತರವನ್ನು ಬರೆದು ಸೊಲೊಮೋನನಿಗೆ ಕಳುಹಿಸಿದನು:</para>
  <para style="pm" vid="2CH 2:11">“ಯೆಹೋವ ದೇವರು ತಮ್ಮ ಜನರನ್ನು ಪ್ರೀತಿಮಾಡಿದ್ದರಿಂದ, ನಿನ್ನನ್ನು ಜನರ ಮೇಲೆ ಅರಸನನ್ನಾಗಿ ಮಾಡಿದ್ದಾರೆ,” ಎಂದು ಹೇಳಿದನು.<verse eid="2CH 2:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="2CH 2:12"/>ಇದಲ್ಲದೆ ಹೀರಾಮನು,</para>
  <para style="pm" vid="2CH 2:12">“ಯೆಹೋವ ದೇವರಿಗೋಸ್ಕರ ಆಲಯವನ್ನೂ ತನ್ನ ರಾಜ್ಯಕ್ಕೋಸ್ಕರ ಅರಮನೆಯನ್ನೂ ಕಟ್ಟಿಸುವುದಕ್ಕೆ ಅರಸನಾದ ದಾವೀದನಿಗೆ ಬುದ್ಧಿ ವಿವೇಚನೆಯುಳ್ಳ ಒಬ್ಬ ಮಗನನ್ನು ಕೊಟ್ಟಿದ್ದಾರೆ; ಆಕಾಶವನ್ನೂ ಭೂಮಿಯನ್ನೂ ಉಂಟುಮಾಡಿದ ಇಸ್ರಾಯೇಲಿನ ದೇವರಾದ ಯೆಹೋವ ದೇವರಿಗೆ ಸ್ತೋತ್ರವಾಗಲಿ.<verse eid="2CH 2:12"/></para>
  <para style="pm">
    <verse number="13" style="v" sid="2CH 2:13"/>“ಈಗ ನಾನು ಜ್ಞಾನಿಯೂ, ಕಲಾ ಪ್ರವೀಣನೂ ಆದ ಹೂರಾಮ ಅಬೀ ಎಂಬ ಒಬ್ಬನನ್ನು ಕಳುಹಿಸಿದ್ದೇನೆ. <verse eid="2CH 2:13"/><verse number="14" style="v" sid="2CH 2:14"/>ಅವನು ದಾನನ ಪುತ್ರಿಯರಲ್ಲಿರುವ ಒಬ್ಬಳ ಮಗನಾಗಿದ್ದಾನೆ. ಅವನ ತಂದೆ ಟೈರಿನವನು. ಅವನು ಬಂಗಾರ, ಬೆಳ್ಳಿ, ಕಂಚು, ಕಬ್ಬಿಣ, ಕಲ್ಲು, ಮರ, ಧೂಮ್ರವರ್ಣ, ನೀಲವರ್ಣ, ನಯವಾದ ನಾರಿನ ವಸ್ತ್ರ, ರಕ್ತವರ್ಣ ಇವುಗಳಲ್ಲಿ ಕೆಲಸವನ್ನು ಮಾಡುವುದಕ್ಕೂ ತರಬೇತಿಯನ್ನು ಹೊಂದಿದ್ದನು. ತನಗೆ ಒಪ್ಪಿಸಲಾಗುವ ಎಲ್ಲಾ ತರಹದ ಕೆತ್ತನೆಯ ಕೆಲಸಗಳನ್ನು ನಡೆಸುವುದಕ್ಕೂ ಇವನು ಸಮರ್ಥನು. ನಿನ್ನ ತಂದೆಯೂ ನನ್ನ ಒಡೆಯನಾದ ದಾವೀದನೂ ಗೊತ್ತುಮಾಡಿದ ಕಲಾಕುಶಲರೊಡನೆ ಇವನು ಕೆಲಸಮಾಡಲಿ.<verse eid="2CH 2:14"/></para>
  <para style="pm">
    <verse number="15" style="v" sid="2CH 2:15"/>“ಈಗ ನನ್ನ ಒಡೆಯನು ಹೇಳಿದ ಆ ಗೋಧಿಯನ್ನೂ, ಜವೆಗೋಧಿಯನ್ನೂ, ಎಣ್ಣೆಯನ್ನೂ, ದ್ರಾಕ್ಷಾರಸವನ್ನೂ ತನ್ನ ಸೇವಕರಿಗೆ ಕಳುಹಿಸಲಿ. <verse eid="2CH 2:15"/><verse number="16" style="v" sid="2CH 2:16"/>ಇದಲ್ಲದೆ ನಾವು ಲೆಬನೋನಿನಲ್ಲಿ ನಿನಗೆ ಬೇಕಾದಷ್ಟು ಮರಗಳನ್ನು ಕಡಿದು ತೆಪ್ಪಗಳಲ್ಲಿ ಸಮುದ್ರದ ಮಾರ್ಗವಾಗಿ ಯೊಪ್ಪಕ್ಕೆ ತೆಗೆದುಕೊಂಡು ಬರುತ್ತೇವೆ. ನೀನು ಅವುಗಳನ್ನು ಯೆರೂಸಲೇಮಿಗೆ ಒಯ್ಯಬಹುದು.”<verse eid="2CH 2:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="2CH 2:17"/>ಆಮೇಲೆ ಸೊಲೊಮೋನನು ತನ್ನ ತಂದೆ ದಾವೀದನು ಮಾಡಿಸಿದ ಜನಗಣತಿಯ ಆಧಾರದಿಂದ, ಇಸ್ರಾಯೇಲ್ ದೇಶದಲ್ಲಿದ್ದ ಪ್ರವಾಸಿಗಳಾಗಿದ್ದ ಇತರ ಜನರ ಜನಗಣತಿ ಮಾಡಿಸಿದ ನಂತರ, ಇತರ ಜನರ ಒಟ್ಟು ಸಂಖ್ಯೆ 1,53,600 ಮಂದಿ ಇದ್ದರು. <verse eid="2CH 2:17"/><verse number="18" style="v" sid="2CH 2:18"/>ಆಗ ಅವರಲ್ಲಿ 70,000 ಮಂದಿಯನ್ನು ಹೊರೆ ಹೊರುವುದಕ್ಕೂ, 80,000 ಮಂದಿಯನ್ನು ಬೆಟ್ಟದಲ್ಲಿ ಕಲ್ಲು ಕಡಿಯುವುದಕ್ಕೂ, 3,600 ಮಂದಿಯನ್ನು ಕೆಲಸದವರ ಮೇಲೆ ಕಾವಲಾಗಿರುವುದಕ್ಕೂ ಇರಿಸಿದನು.<verse eid="2CH 2:18"/></para>
  <chapter eid="2CH 2"/>
  <chapter number="3" style="c" sid="2CH 3"/>
  <para style="s1">ಸೊಲೊಮೋನನು ದೇವಾಲಯವನ್ನು ಕಟ್ಟಿಸಿದ್ದು</para>
  <para style="p">
    <verse number="1" style="v" sid="2CH 3:1"/>ಸೊಲೊಮೋನನು ಯೆರೂಸಲೇಮಿನಲ್ಲಿ ತನ್ನ ತಂದೆ ದಾವೀದನಿಗೆ ಯೆಹೋವ ದೇವರು ಕಾಣಿಸಿಕೊಂಡ ಸ್ಥಳವಾದ ಮೊರೀಯಾ ಬೆಟ್ಟದ ಮೇಲೆ, ದಾವೀದನು ಸಿದ್ಧಮಾಡಿದ ಸ್ಥಳವಾದ ಯೆಬೂಸಿಯನಾದ ಒರ್ನಾನನ ಕಣದಲ್ಲಿ ಯೆಹೋವ ದೇವರ ಆಲಯವನ್ನು ಕಟ್ಟಿಸಲು ಪ್ರಾರಂಭಿಸಿದನು. <verse eid="2CH 3:1"/><verse number="2" style="v" sid="2CH 3:2"/>ತನ್ನ ಆಳಿಕೆಯ ನಾಲ್ಕನೆಯ ವರ್ಷದ ಎರಡನೆಯ ತಿಂಗಳಿನ ಎರಡನೆಯ ದಿವಸದಲ್ಲಿ ಕಟ್ಟುವುದಕ್ಕೆ ಆರಂಭಿಸಿದನು.<verse eid="2CH 3:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="2CH 3:3"/>ದೇವರ ಆಲಯವನ್ನು ಕಟ್ಟುವುದಕ್ಕೆ ಸೊಲೊಮೋನನು ಹಾಕಿಸಿದ ಅಸ್ತಿವಾರಗಳು ಏನೆಂದರೆ ಮೊದಲಿನ ಅಳತೆಯ ಪ್ರಕಾರವಾಗಿ ಅದರ ಉದ್ದ ಸುಮಾರು 27 ಮೀಟರ್ ಮತ್ತು ಅದರ ಅಗಲ 9 ಮೀಟರ್; <verse eid="2CH 3:3"/><verse number="4" style="v" sid="2CH 3:4"/>ಮುಂದೆ ಇರುವ ದ್ವಾರಾಂಗಳ ಆಲಯದ ಅಗಲದ ಪ್ರಕಾರ ಸುಮಾರು 9 ಮೀಟರ್ ಉದ್ದವಾಗಿತ್ತು; 54 ಮೀಟರ್ ಎತ್ತರವಾಗಿತ್ತು.</para>
  <para style="p" vid="2CH 3:4">ಅವನು ಅದನ್ನು ಒಳಗಡೆ ಶುದ್ಧ ಬಂಗಾರದಿಂದ ಹೊದಿಸಿದನು. <verse eid="2CH 3:4"/><verse number="5" style="v" sid="2CH 3:5"/>ಅವನು ದೊಡ್ಡ ತುರಾಯಿ ಮರಗಳಿಂದ ಮುಚ್ಚಿದ ಕೋಣೆಯನ್ನು ಶುದ್ಧ ಬಂಗಾರದಿಂದ ಹೊದಿಸಿ, ಅದರ ಮೇಲೆ ಖರ್ಜೂರದ ಗಿಡಗಳನ್ನೂ, ಸರಪಣಿಗಳನ್ನೂ ಕೆತ್ತಿಸಿದನು. <verse eid="2CH 3:5"/><verse number="6" style="v" sid="2CH 3:6"/>ಇದಲ್ಲದೆ ಸೌಂದರ್ಯದ ನಿಮಿತ್ತವಾಗಿ ಅಮೂಲ್ಯವಾದ ರತ್ನಗಳಿಂದ ಆ ಆಲಯವನ್ನು ಮುಚ್ಚಿದನು. ಅದರ ಬಂಗಾರವು ಪರ್ವಯಿಮ್ ದೇಶದ್ದು. <verse eid="2CH 3:6"/><verse number="7" style="v" sid="2CH 3:7"/>ಆಲಯದ ತೊಲೆಗಳನ್ನೂ, ಸ್ತಂಭಗಳನ್ನೂ, ಗೋಡೆಗಳನ್ನೂ, ಬಾಗಿಲುಗಳನ್ನೂ, ಅವನು ಬಂಗಾರದಿಂದ ಹೊದಿಸಿ, ಗೋಡೆಗಳ ಮೇಲೆ ಕೆರೂಬಿಗಳನ್ನೂ ಕೆತ್ತಿಸಿದನು.<verse eid="2CH 3:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="2CH 3:8"/>ಅವನು ಮಹಾಪರಿಶುದ್ಧವಾದ ಸ್ಥಳವನ್ನು ಕಟ್ಟಿದನು. ಅದರ ಉದ್ದವು ಆಲಯದ ಅಗಲದ ಪ್ರಕಾರ 9 ಮೀಟರ್; ಅದರ ಅಗಲ 9 ಮೀಟರ್. ಅವನು ಅದನ್ನು 20,000 ಕಿಲೋಗ್ರಾಂ ಶುದ್ಧ ಬಂಗಾರದಿಂದ ಹೊದಿಸಿದನು. <verse eid="2CH 3:8"/><verse number="9" style="v" sid="2CH 3:9"/>ಅದರ ಮೊಳೆಗಳು ಐನೂರ ಎಪ್ಪತ್ತು ಕಿಲೋಗ್ರಾಂಗಳ ತೂಕ ಬಂಗಾರದ್ದಾಗಿತ್ತು. ಹಾಗೆಯೇ ಮೇಲಿನ ಕೊಠಡಿಗಳನ್ನು ಬಂಗಾರದಿಂದ ಹೊದಿಸಿದನು.<verse eid="2CH 3:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="2CH 3:10"/>ಮಹಾಪರಿಶುದ್ಧವಾದ ಸ್ಥಳದಲ್ಲಿ ಎರಡು ಕೆರೂಬಿಗಳನ್ನು ಮಾಡಿಸಿ, ಬಂಗಾರದಿಂದ ಅವುಗಳನ್ನು ಹೊದಿಸಿದನು. <verse eid="2CH 3:10"/><verse number="11" style="v" sid="2CH 3:11"/>ಕೆರೂಬಿಗಳ ರೆಕ್ಕೆಗಳು 9 ಮೀಟರ್ ಉದ್ದವಾಗಿದ್ದವು. ಒಂದು ರೆಕ್ಕೆಯು ಎರಡೂವರೆ ಮೀಟರ್ ಉದ್ದವಾಗಿದ್ದು, ಆಲಯದ ಗೋಡೆಯವರೆಗೆ ಮುಟ್ಟಿತ್ತು; ಮತ್ತೊಂದು ರೆಕ್ಕೆ ಎರಡೂವರೆ ಮೀಟರ್ ಉದ್ದವಾಗಿದ್ದು, ಇನ್ನೊಂದು ಕೆರೂಬಿಯ ರೆಕ್ಕೆಯವರೆಗೂ ಮುಟ್ಟಿತ್ತು. <verse eid="2CH 3:11"/><verse number="12" style="v" sid="2CH 3:12"/>ಹಾಗೆಯೇ ಮತ್ತೊಂದು ಕೆರೂಬಿಯ ರೆಕ್ಕೆಯು ಎರಡೂವರೆ ಮೀಟರ್ ಉದ್ದವಾಗಿದ್ದು, ಆಲಯದ ಗೋಡೆಯವರೆಗೆ ಮುಟ್ಟಿತ್ತು; ಇನ್ನೊಂದು ರೆಕ್ಕೆಯು ಎರಡೂವರೆ ಮೀಟರ್ ಉದ್ದವಾಗಿದ್ದು, ಬೇರೆ ಇರುವ ಕೆರೂಬಿಯ ರೆಕ್ಕೆಗೆ ಕೂಡಿಕೊಂಡಿತ್ತು. <verse eid="2CH 3:12"/><verse number="13" style="v" sid="2CH 3:13"/>ಈ ಕೆರೂಬಿಗಳ ರೆಕ್ಕೆಗಳು 9 ಮೀಟರ್ ಉದ್ದಕ್ಕೆ ಚಾಚಿಕೊಂಡವು. ಅವು ತಮ್ಮ ಕಾಲುಗಳ ಮೇಲೆ ನಿಂತವು. ಅವುಗಳ ಮುಖಗಳು ಒಳಗಡೆಯಾಗಿದ್ದವು.<verse eid="2CH 3:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="2CH 3:14"/>ಪರದೆಯನ್ನು ನೀಲಿ, ಧೂಮ್ರ, ರಕ್ತವರ್ಣದ ದಾರದಿಂದ ಮತ್ತು ನಯವಾದ ಹೊಸೆದ ನಾರಿನಿಂದ ಮಾಡಿಸಿ, ಅದರಲ್ಲಿ ಕೆರೂಬಿಗಳುಳ್ಳದ್ದನ್ನಾಗಿ ಮಾಡಿಸಿದನು.<verse eid="2CH 3:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="2CH 3:15"/>ಇದಲ್ಲದೆ ಅವನು ಕಟ್ಟಡದ ಪ್ರವೇಶದ್ವಾರದಲ್ಲಿ ಎರಡು ಸ್ತಂಭಗಳನ್ನು ನಿರ್ಮಿಸಿದನು, ಪ್ರತಿಯೊಂದೂ ಹದಿನೈದು ಮೀಟರ್ ಎಪ್ಪತ್ತೈದು ಸೆಂಟಿಮೀಟರ್ ಎತ್ತರ, ಪ್ರತಿಯೊಂದರ ಮೇಲೆಯೂ ನಿರ್ಮಿಸಲಾದ ಪ್ರತಿಯೊಂದು ತಲೆಗಳು ಎರಡೂವರೆ ಮೀಟರ್ ಉದ್ದವಿತ್ತು. <verse eid="2CH 3:15"/><verse number="16" style="v" sid="2CH 3:16"/>ಗರ್ಭಗುಡಿಯಲ್ಲಿ ಸರಪಣಿಗಳಂತೆ ಮಾಡಿ, ಸ್ತಂಭಗಳ ತುದಿಗಳ ಮೇಲೆ ಇಟ್ಟು, ನೂರು ದಾಳಿಂಬೆ ಹಣ್ಣುಗಳನ್ನು ಮಾಡಿ, ಸರಪಣಿಗಳ ಮೇಲೆ ಇರಿಸಿದನು. <verse eid="2CH 3:16"/><verse number="17" style="v" sid="2CH 3:17"/>ಆ ಸ್ತಂಭಗಳನ್ನು ಮಂದಿರದ ಮುಂಭಾಗದಲ್ಲಿ ಒಂದನ್ನು ಬಲಗಡೆಯಲ್ಲಿಯೂ, ಇನ್ನೊಂದನ್ನು ಎಡಗಡೆಯಲ್ಲಿಯೂ ನಿಲ್ಲಿಸಿದನು. ಬಲಗಡೆಯಲ್ಲಿ ನಿಲ್ಲಿಸಿದ ಸ್ತಂಭಕ್ಕೆ ಯಾಕೀನ್<note caller="+" style="f"><char style="fr" closed="false">3:17 </char><char style="fq" closed="false">ಯಾಕೀನ್ </char><char style="ft" closed="false">ಎಂದರೆ </char><char style="fqa" closed="false">ಅವನು ಸ್ಥಾಪಿಸುವನು</char></note> ಎಂದೂ, ಎಡಗಡೆಯ ಸ್ತಂಭಕ್ಕೆ ಬೋವಾಜ್<note caller="+" style="f"><char style="fr" closed="false">3:17 </char><char style="fq" closed="false">ಬೋವಾಜ್ </char><char style="ft" closed="false">ಎಂದರೆ </char><char style="fqa" closed="false">ಅವನಲ್ಲಿ ಶಕ್ತಿ ಇದೆ.</char></note> ಎಂದೂ ಹೆಸರಿಟ್ಟನು.<verse eid="2CH 3:17"/></para>
  <chapter eid="2CH 3"/>
  <chapter number="4" style="c" sid="2CH 4"/>
  <para style="s1">ದೇವಾಲಯದ ಸಲಕರಣೆಗಳು</para>
  <para style="p">
    <verse number="1" style="v" sid="2CH 4:1"/>ಇವುಗಳಲ್ಲದೆ, ಸೊಲೊಮೋನನು ಕಂಚಿನ ಬಲಿಪೀಠವನ್ನು ಮಾಡಿಸಿದನು; ಅದರ ಉದ್ದ ಒಂಬತ್ತು ಮೀಟರ್, ಅಗಲ ಒಂಬತ್ತು ಮೀಟರ್, ಎತ್ತರ ಸುಮಾರು ಐದು ಮೀಟರ್. <verse eid="2CH 4:1"/><verse number="2" style="v" sid="2CH 4:2"/>ಅನಂತರ ಅವನು ಸಮುದ್ರಪಾತ್ರೆ ಎಂದು ಕರೆಯಲಾಗುವ ಎರಕದ ದೊಡ್ಡ ಪಾತ್ರೆಯನ್ನು ಮಾಡಿಸಿದನು; ಅದು ಚಕ್ರಾಕಾರವಾಗಿ ಅಂಚಿನಿಂದ ಅಂಚಿಗೆ ಸುಮಾರು ನಾಲ್ಕು ಮೀಟರ್; ಅದರ ಎತ್ತರ ಸುಮಾರು ಎರಡು ಮೀಟರ್; ಸುತ್ತಳತೆ ಸುಮಾರು ಹದಿನಾಲ್ಕು ಮೀಟರಾಗಿತ್ತು; <verse eid="2CH 4:2"/><verse number="3" style="v" sid="2CH 4:3"/>ಅದರ ಅಂಚಿನ ಕೆಳಭಾಗದಲ್ಲಿ ಅದರ ಸುತ್ತಲೂ ಎತ್ತುಗಳ ರೂಪಗಳಿದ್ದವು; ಅವು ಒಂದೊಂದು ಮೀಟರಿಗೆ ಹತ್ತರಂತೆ, ಆ ಕೊಳದ ಪಾತ್ರೆಯ ಸುತ್ತಲೂ ಇದ್ದವು; ಇದು ಎರಕ ಹೊಯ್ಯುವಾಗ, ಎತ್ತುಗಳ ರೂಪಗಳು ಎರಡು ಸಾಲಾಗಿ ಎರಕ ಹೊಯ್ಸಿದನು.<verse eid="2CH 4:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="2CH 4:4"/>ಅದು ಹನ್ನೆರಡು ಎತ್ತುಗಳ ಮೇಲೆ ನಿಂತಿತ್ತು. ಮೂರು ಉತ್ತರಕ್ಕೂ, ಮೂರು ಪಶ್ಚಿಮಕ್ಕೂ, ಮೂರು ದಕ್ಷಿಣಕ್ಕೂ, ಮೂರು ಪೂರ್ವಕ್ಕೂ ಮುಖಮಾಡಿಕೊಂಡಿದ್ದವು. ಆ ಕೊಳವು ಅವುಗಳ ಮೇಲೆ ಇತ್ತು. ಅವುಗಳ ಹಿಂಭಾಗಗಳೆಲ್ಲಾ ಒಳಮುಖವಾಗಿದ್ದವು. <verse eid="2CH 4:4"/><verse number="5" style="v" sid="2CH 4:5"/>ಅದರ ದಪ್ಪವು ಅಂಗೈ ಅಗಲದಷ್ಟಾಗಿಯೂ, ಅದರ ಅಂಚು ಪಾತ್ರೆಯ ಅಂಚಿನ ಹಾಗೆಯೂ, ತಾವರೆ ಪುಷ್ಪದ ಹಾಗೆಯೂ ಇತ್ತು. ಅದು ಅರವತ್ತಾರು ಸಾವಿರ ಲೀಟರ್ ನೀರನ್ನು ಹಿಡಿಯುತ್ತಿತ್ತು.<verse eid="2CH 4:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="2CH 4:6"/>ಇದಲ್ಲದೆ ಹತ್ತು ತೊಟ್ಟಿಗಳನ್ನು ಮಾಡಿಸಿ, ಅವುಗಳಲ್ಲಿ ತೊಳೆಯುವ ನಿಮಿತ್ತವಾಗಿ ಬಲಗಡೆಯಲ್ಲಿ ಐದನ್ನೂ, ಎಡಗಡೆಯಲ್ಲಿ ಐದನ್ನೂ ಇರಿಸಿದನು. ದಹನಬಲಿಗೋಸ್ಕರ ಅರ್ಪಿಸುವವುಗಳನ್ನು ಅವುಗಳಲ್ಲಿ ತೊಳೆಯುತ್ತಿದ್ದರು. ಆದರೆ ಆ ಕೊಳವು ಯಾಜಕರು ತೊಳೆದುಕೊಳ್ಳುವುದಕ್ಕೆ ಇತ್ತು.<verse eid="2CH 4:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="2CH 4:7"/>ಅವುಗಳ ಮಾದರಿಯ ಪ್ರಕಾರವಾಗಿ ಹತ್ತು ಬಂಗಾರದ ದೀಪಸ್ತಂಭಗಳನ್ನು ಮಾಡಿಸಿ, ಮಂದಿರದಲ್ಲಿ ಬಲಗಡೆ ಐದನ್ನೂ, ಎಡಗಡೆ ಐದನ್ನೂ ಇರಿಸಿದನು.<verse eid="2CH 4:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="2CH 4:8"/>ಹಾಗೆಯೇ ಅವನು ಹತ್ತು ಮೇಜುಗಳನ್ನು ಮಾಡಿಸಿ, ಮಂದಿರದಲ್ಲಿ ಬಲಗಡೆ ಐದನ್ನೂ, ಎಡಗಡೆ ಐದನ್ನೂ ಇರಿಸಿದನು. ನೂರು ಬಂಗಾರದ ಬಟ್ಟಲುಗಳನ್ನು ಮಾಡಿಸಿದನು.<verse eid="2CH 4:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="2CH 4:9"/>ಯಾಜಕರ ಅಂಗಳವನ್ನೂ, ದೊಡ್ಡ ಅಂಗಳವನ್ನೂ, ಅಂಗಳಗಳಿಗೋಸ್ಕರ ಬಾಗಿಲುಗಳನ್ನೂ ಮಾಡಿಸಿ, ಆ ಬಾಗಿಲುಗಳನ್ನು ಕಂಚಿನಿಂದ ಹೊದಿಸಿದನು. <verse eid="2CH 4:9"/><verse number="10" style="v" sid="2CH 4:10"/>ಸಮುದ್ರ ಎಂದು ಕರೆಯಲಾದ ದೊಡ್ಡ ಪಾತ್ರೆಯನ್ನು ಬಲಗಡೆಯಲ್ಲಿ ಅಂದರೆ ಆಗ್ನೇಯ ದಿಕ್ಕಿನಲ್ಲಿ ಇರಿಸಿದನು.<verse eid="2CH 4:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="2CH 4:11"/>ಇದಲ್ಲದೆ ಹೂರಾಮನು<note caller="+" style="f"><char style="fr" closed="false">4:11 </char><char style="fq" closed="false">ಹೂರಾಮನು </char><char style="ft" closed="false">ಅಥವಾ </char><char style="fqa" closed="false">ಹೀರಾಮ</char></note> ಪಾತ್ರೆಗಳನ್ನೂ, ಸಲಿಕೆಗಳನ್ನೂ, ಬಟ್ಟಲುಗಳನ್ನೂ ಮಾಡಿದನು.</para>
  <para style="p" vid="2CH 4:11">ಯೆಹೋವ ದೇವರ ಆಲಯಕ್ಕೋಸ್ಕರ ಅರಸನಾದ ಸೊಲೊಮೋನನು ಒಪ್ಪಿಸಿದ ಎಲ್ಲಾ ಕೆಲಸಗಳನ್ನು ಹೂರಾಮನು ಮಾಡಿ ತೀರಿಸಿದನು:<verse eid="2CH 4:11"/></para>
  <para style="b"/>
  <para style="li1">
    <verse number="12" style="v" sid="2CH 4:12"/>ಅವು ಯಾವುವೆಂದರೆ, ಎರಡು ಸ್ತಂಭಗಳು,</para>
  <para style="li1" vid="2CH 4:12">ಆ ಸ್ತಂಭಗಳ ಮೇಲಿನ ಎರಡು ಕುಂಭಗಳು,</para>
  <para style="li1" vid="2CH 4:12">ಆ ಎರಡು ಕುಂಭಗಳನ್ನು ಮುಚ್ಚುವ ಎರಡು ಜಾಲರಿಗಳು.<verse eid="2CH 4:12"/></para>
  <para style="li1">
    <verse number="13" style="v" sid="2CH 4:13"/>ಎರಡು ಜಾಲರಿ ಸಾಮಾನುಗಳಿಗೆ ನಾನೂರು ದಾಳಿಂಬೆ ಹಣ್ಣುಗಳು, ಸ್ತಂಭಗಳ ಮೇಲೆ ಇರುವ ಎರಡು ಕುಂಭಗಳನ್ನು ಮುಚ್ಚುವಂತೆ ಒಂದು ಜಾಲರಿ ಸಲಕರಣೆಗಳಿಗೆ ಎರಡು ಸಾಲಿನ ದಾಳಿಂಬೆ ಹಣ್ಣುಗಳನ್ನು ಮಾಡಿದನು.<verse eid="2CH 4:13"/></para>
  <para style="li1">
    <verse number="14" style="v" sid="2CH 4:14"/>ಇದಲ್ಲದೆ ಅವನು ಪೀಠಗಳನ್ನು ಅವುಗಳ ಮೇಲಿರುವ ತೊಟ್ಟಿಗಳನ್ನು ಮಾಡಿದನು.<verse eid="2CH 4:14"/></para>
  <para style="li1">
    <verse number="15" style="v" sid="2CH 4:15"/>ಸಮುದ್ರಪಾತ್ರೆಯು ಅದರ ಕೆಳಗಿರುವ ಹನ್ನೆರಡು ಎತ್ತುಗಳು,<verse eid="2CH 4:15"/></para>
  <para style="li1">
    <verse number="16" style="v" sid="2CH 4:16"/>ಪಾತ್ರೆಗಳು, ಸಲಿಕೆಗಳು, ಮುಳ್ಳುಗಳು.</para>
  <para style="b" vid="2CH 4:16"/>
  <para style="p" vid="2CH 4:16">ಅವುಗಳ ಎಲ್ಲಾ ವಸ್ತುಗಳನ್ನೂ ಅರಸನಾದ ಸೊಲೊಮೋನನಿಗೆ ಅವನ ತಂದೆಯು ಹೇಳಿದಂತೆ ಹೂರಾಮ ಅಬೀ ಹೊಳೆಯುವ ಕಂಚಿನಿಂದ ಯೆಹೋವ ದೇವರ ಆಲಯಕ್ಕೋಸ್ಕರ ಮಾಡಿದನು. <verse eid="2CH 4:16"/><verse number="17" style="v" sid="2CH 4:17"/>ಯೊರ್ದನಿಗೆ ಸೇರಿದ ಬಯಲಾದ ಸುಕ್ಕೋತಿಗೂ ಚರೇದನಿಗೂ ನಡುವೆ ಇರುವ ಜೇಡಿಮಣ್ಣಿನ ಅಚ್ಚುಗಳಲ್ಲಿ ಅರಸನು ಅವುಗಳನ್ನು ಎರಕ ಹೊಯ್ಯಿಸಿದನು. <verse eid="2CH 4:17"/><verse number="18" style="v" sid="2CH 4:18"/>ಸೊಲೊಮೋನನು ಮಾಡಿಸಿದ ಈ ಸಲಕರಣೆಗಳೆಲ್ಲಾ ಬಹು ಹೆಚ್ಚಾಗಿದ್ದರಿಂದ ಆ ಕಂಚಿನ ತೂಕವು ಎಷ್ಟೆಂದು ನಿರ್ಧರಿಸಲಾಗಲಿಲ್ಲ.<verse eid="2CH 4:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="2CH 4:19"/>ಸೊಲೊಮೋನನು ದೇವರ ಆಲಯದ ಎಲ್ಲಾ ಸಲಕರಣೆಗಳನ್ನು ಮಾಡಿಸಿದನು. ಅವು ಯಾವುವೆಂದರೆ:</para>
  <para style="b" vid="2CH 4:19"/>
  <para style="li1" vid="2CH 4:19">ಬಂಗಾರದ ಧೂಪವೇದಿಯನ್ನು,</para>
  <para style="li1" vid="2CH 4:19">ಸಮ್ಮುಖದ ರೊಟ್ಟಿಗಳನ್ನು ಇಡುವುದಕ್ಕೆ ಮೇಜುಗಳನ್ನು,<verse eid="2CH 4:19"/></para>
  <para style="li1">
    <verse number="20" style="v" sid="2CH 4:20"/>ನಿಯಮದ ಪ್ರಕಾರ ಮಹಾಪರಿಶುದ್ಧ ಸ್ಥಳದ ಮುಂಭಾಗದಲ್ಲಿ ಶುದ್ಧ ಬಂಗಾರದ ದೀಪಸ್ತಂಭಗಳನ್ನೂ ಅವುಗಳ ದೀಪಗಳನ್ನೂ,<verse eid="2CH 4:20"/></para>
  <para style="li1">
    <verse number="21" style="v" sid="2CH 4:21"/>ಹೂವುಗಳನ್ನೂ, ದೀಪಗಳ ಚಿಮಟಿಗಳನ್ನೂ ಶುದ್ಧ ಬಂಗಾರದಿಂದ ಮಾಡಿಸಿದನು.<verse eid="2CH 4:21"/></para>
  <para style="li1">
    <verse number="22" style="v" sid="2CH 4:22"/>ಶುದ್ಧ ಬಂಗಾರದಿಂದ ಕತ್ತರಿಗಳು, ಬೋಗುಣಿಗಳು, ಅಗ್ನಿಪಾತ್ರೆಗಳು, ಅಗ್ಗಿಷ್ಟಿಗೆ ಇವುಗಳನ್ನು ಮಾಡಿಸಿದನು. ಇದಲ್ಲದೆ ಆಲಯದ ಪ್ರವೇಶ ದ್ವಾರವೂ, ಮಹಾಪರಿಶುದ್ಧ ಸ್ಥಳವಾದ ಗರ್ಭಗುಡಿಯ ಬಾಗಿಲುಗಳೂ, ಮಂದಿರದ ಮನೆ ಬಾಗಿಲುಗಳೂ ಬಂಗಾರದವುಗಳಾಗಿದ್ದವು.<verse eid="2CH 4:22"/></para>
  <para style="b"/>
  <chapter eid="2CH 4"/>
  <chapter number="5" style="c" sid="2CH 5"/>
  <para style="p">
    <verse number="1" style="v" sid="2CH 5:1"/>ಹೀಗೆಯೇ ಸೊಲೊಮೋನನು ಯೆಹೋವ ದೇವರ ಆಲಯಕ್ಕೋಸ್ಕರ ಮಾಡಿಸಿದ ಕೆಲಸವೆಲ್ಲಾ ಮುಗಿಯಿತು. ಆಗ ಸೊಲೊಮೋನನು ತನ್ನ ತಂದೆ ದಾವೀದನು ಪ್ರತಿಷ್ಠೆ ಮಾಡಿದ ಬೆಳ್ಳಿಯನ್ನೂ, ಬಂಗಾರವನ್ನೂ, ಎಲ್ಲಾ ಸಲಕರಣೆಗಳನ್ನೂ ದೇವರ ಆಲಯದ ಭಂಡಾರಕ್ಕೆ ಸೇರಿಸಿದನು.<verse eid="2CH 5:1"/></para>
  <para style="s1">ಮಂಜೂಷವನ್ನು ದೇವಾಲಯಕ್ಕೆ ತಂದದ್ದು</para>
  <para style="p">
    <verse number="2" style="v" sid="2CH 5:2"/>ಆಗ ಚೀಯೋನೆಂಬ ದಾವೀದನ ಪಟ್ಟಣದಿಂದ ಯೆಹೋವ ದೇವರ ಒಡಂಬಡಿಕೆಯ ಮಂಜೂಷವನ್ನು ತರುವ ನಿಮಿತ್ತ, ಸೊಲೊಮೋನನು ಇಸ್ರಾಯೇಲರಲ್ಲಿ ಶ್ರೇಷ್ಠರಾಗಿರುವ ಪಿತೃಗಳಾದ ಇಸ್ರಾಯೇಲಿನ ಹಿರಿಯರನ್ನೂ, ಗೋತ್ರಗಳ ಮುಖ್ಯಸ್ಥರನ್ನೂ ಯೆರೂಸಲೇಮಿನಲ್ಲಿ ತನ್ನ ಬಳಿಗೆ ಕೂಡಿಬರುವಂತೆ ಮಾಡಿದನು. <verse eid="2CH 5:2"/><verse number="3" style="v" sid="2CH 5:3"/>ಆದ್ದರಿಂದ ಏಳನೆಯ ತಿಂಗಳಿನ ಹಬ್ಬದಲ್ಲಿ ಇಸ್ರಾಯೇಲಿನ ಸಮಸ್ತ ಜನರು ಅರಸನ ಬಳಿಗೆ ಕೂಡಿಬಂದರು.<verse eid="2CH 5:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="2CH 5:4"/>ಇಸ್ರಾಯೇಲಿನ ಹಿರಿಯರೆಲ್ಲರೂ ಬಂದ ತರುವಾಯ, ಲೇವಿಯರು ಯೆಹೋವ ದೇವರ ಮಂಜೂಷವನ್ನು ಎತ್ತಿಕೊಂಡರು. <verse eid="2CH 5:4"/><verse number="5" style="v" sid="2CH 5:5"/>ಒಡಂಬಡಿಕೆಯ ಮಂಜೂಷವನ್ನೂ, ದೇವದರ್ಶನದ ಗುಡಾರವನ್ನೂ, ಗುಡಾರದಲ್ಲಿದ್ದ ಸಮಸ್ತ ಪರಿಶುದ್ಧವಾದ ಸಲಕರಣೆಗಳನ್ನೂ ತಂದರು. ಇವುಗಳನ್ನು ಯಾಜಕರಾದ ಲೇವಿಯರು ಹೊತ್ತುಕೊಂಡು ತಂದರು. <verse eid="2CH 5:5"/><verse number="6" style="v" sid="2CH 5:6"/>ಆಗ ಅರಸನಾದ ಸೊಲೊಮೋನನೂ ಅವನ ಬಳಿಯಲ್ಲಿ ಕೂಡಿದ ಇಸ್ರಾಯೇಲ್ ಜನರೆಲ್ಲರೂ ಮಂಜೂಷದ ಮುಂದೆ ನಿಂತು ಎಣಿಸಲಾಗದಷ್ಟು ಕುರಿಗಳನ್ನೂ, ಪಶುಗಳನ್ನೂ ಬಲಿಯಾಗಿ ಅರ್ಪಿಸಿದರು.<verse eid="2CH 5:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="2CH 5:7"/>ಯಾಜಕರು ಯೆಹೋವ ದೇವರ ಒಡಂಬಡಿಕೆಯ ಮಂಜೂಷವನ್ನು ಮಹಾಪರಿಶುದ್ಧ ಸ್ಥಳವಾದ ಗರ್ಭಗುಡಿಯಲ್ಲಿ ಕೆರೂಬಿಗಳ ರೆಕ್ಕೆಗಳ ಕೆಳಗಿದ್ದ ಅದರ ಸ್ಥಳದಲ್ಲಿ ಇಟ್ಟರು. <verse eid="2CH 5:7"/><verse number="8" style="v" sid="2CH 5:8"/>ಕೆರೂಬಿಗಳು ಮಂಜೂಷವಿದ್ದ ಸ್ಥಳದ ಮೇಲೆ ತಮ್ಮ ರೆಕ್ಕೆಗಳನ್ನು ಚಾಚಿಕೊಂಡಿದ್ದವು. ಹೀಗೆಯೇ ಕೆರೂಬಿಗಳು ಮಂಜೂಷವನ್ನೂ, ಅದರ ಕೋಲುಗಳನ್ನೂ ಮೇಲಿನಿಂದ ಮುಚ್ಚಿಕೊಂಡಿದ್ದವು. <verse eid="2CH 5:8"/><verse number="9" style="v" sid="2CH 5:9"/>ಆ ಕೋಲುಗಳು ಮಂಜೂಷಕ್ಕಿಂತಲೂ ಬಹಳ ಉದ್ದವಾಗಿದ್ದುದರಿಂದ ಅವುಗಳ ತುದಿಗಳು ಗರ್ಭಗುಡಿಯ ಮುಂಭಾಗದಲ್ಲಿರುವ ಪರಿಶುದ್ಧ ಸ್ಥಳದಲ್ಲಿ ನಿಂತವರಿಗೆ ಕಾಣಿಸುತ್ತಿದ್ದವು, ಆದರೆ ಅವು ಹೊರಗೆ ನಿಂತವರಿಗೆ ಕಾಣಿಸುತ್ತಿರಲಿಲ್ಲ. ಅವು ಇಂದಿನವರೆಗೂ ಅಲ್ಲಿಯೇ ಇವೆ. <verse eid="2CH 5:9"/><verse number="10" style="v" sid="2CH 5:10"/>ಇಸ್ರಾಯೇಲರು ಈಜಿಪ್ಟ್ ದೇಶದಿಂದ ಹೊರಬಂದ ನಂತರ, ಯೆಹೋವ ದೇವರು ಅವರ ಸಂಗಡ ಒಡಂಬಡಿಕೆ ಮಾಡಿದಾಗ ಮೋಶೆಯು ಹೋರೇಬ್ ಬೆಟ್ಟದ ಬಳಿಯಲ್ಲಿ ಮಂಜೂಷದೊಳಗೆ ಇಟ್ಟ ಕಲ್ಲಿನ ಎರಡು ಹಲಗೆಗಳ ಹೊರತು ಅದರಲ್ಲಿ ಮತ್ತೇನೂ ಇರಲಿಲ್ಲ.<verse eid="2CH 5:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="2CH 5:11"/>ಅಲ್ಲಿ ಇದ್ದ ಸಮಸ್ತ ಯಾಜಕರು ವರ್ಗವ್ಯತ್ಯಾಸವಿಲ್ಲದೆ ತಮ್ಮನ್ನು ಶುದ್ಧಪಡಿಸಿಕೊಂಡಿದ್ದರು. <verse eid="2CH 5:11"/><verse number="12" style="v" sid="2CH 5:12"/>ತಮ್ಮನ್ನು ಪ್ರತಿಷ್ಠಿಸಿಕೊಂಡಿದ್ದ ಯಾಜಕರು ಪರಿಶುದ್ಧ ಸ್ಥಳದಿಂದ ಹೊರಟಾಗ, ನಯವಾದ ನಾರು ಬಟ್ಟೆಗಳನ್ನು ಧರಿಸಿಕೊಂಡಿದ್ದ ಲೇವಿಯ ಗಾಯಕರಾದ ಆಸಾಫ್, ಹೇಮಾನ್, ಯೆದುತೂನ್ ಹಾಗೂ ಇವರ ಮಕ್ಕಳೂ ಸಹೋದರರೂ ತುತೂರಿಗಳನ್ನು ಊದತಕ್ಕ ನೂರಿಪ್ಪತ್ತು ಮಂದಿ ಯಾಜಕರೂ ಬಲಿಪೀಠದ ಪೂರ್ವದಿಕ್ಕಿನಲ್ಲಿ ನಿಂತುಕೊಂಡರು. <verse eid="2CH 5:12"/><verse number="13" style="v" sid="2CH 5:13"/>ತುತೂರಿ ಊದುವವರೂ, ಸಂಗೀತಗಾರರೂ ಯೆಹೋವ ದೇವರನ್ನು ಕೊಂಡಾಡುತ್ತಾ, ಹೊಗಳುತ್ತಾ ಧ್ವನಿ ಎತ್ತಿ ಸ್ತೋತ್ರ ಮಾಡುವಂತೆ ತುತೂರಿಗಳೂ, ತಾಳಗಳೂ ಮೊದಲಾದ ಗೀತ ವಾದ್ಯಗಳಿಂದ ಕೀರ್ತಿಸಿದರು:</para>
  <para style="q1" vid="2CH 5:13">“ಯೆಹೋವ ದೇವರು ಒಳ್ಳೆಯವರು,</para>
  <para style="q2" vid="2CH 5:13">ಅವರ ಕೃಪೆಯು ಯುಗಯುಗಕ್ಕೆ ಇರುವುದು,”</para>
  <para style="p" vid="2CH 5:13">ಎಂದು ಯೆಹೋವ ದೇವರನ್ನು ಹೊಗಳುತ್ತಿದ್ದ ಹಾಗೆ, ಯೆಹೋವ ದೇವರ ಆಲಯವು ಮೇಘದಿಂದ ತುಂಬಿತು. <verse eid="2CH 5:13"/><verse number="14" style="v" sid="2CH 5:14"/>ಯೆಹೋವ ದೇವರ ತೇಜಸ್ಸಿನಿಂದ ವ್ಯಾಪಿಸಿದ್ದ ಆ ಮೋಡವು ದೇವಾಲಯದಲ್ಲಿ ತುಂಬಿಕೊಂಡದ್ದರಿಂದ ಯಾಜಕರು ಅಲ್ಲಿ ನಿಂತು ಸೇವೆ ಮಾಡಲಾರದೆ ಹೋದರು.<verse eid="2CH 5:14"/></para>
  <chapter eid="2CH 5"/>
  <chapter number="6" style="c" sid="2CH 6"/>
  <para style="p">
    <verse number="1" style="v" sid="2CH 6:1"/>ಆಗ ಸೊಲೊಮೋನನು, “ಯೆಹೋವ ದೇವರೇ, ಕಾರ್ಗತ್ತಲಲ್ಲಿ ವಾಸಿಸುತ್ತೇನೆಂದು ಹೇಳಿದ್ದೀರಿ; <verse eid="2CH 6:1"/><verse number="2" style="v" sid="2CH 6:2"/>ಆದರೆ ನಾನು ನಿಮಗೋಸ್ಕರ ಭವ್ಯವಾದ ಮಂದಿರವನ್ನು ಕಟ್ಟಿಸಿದ್ದೇನೆ, ಅದು ನಿಮಗೆ ಶಾಶ್ವತವಾದ ವಾಸಸ್ಥಳವಾಗಿರಲಿ,” ಎಂದನು.<verse eid="2CH 6:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="2CH 6:3"/>ಅರಸನು ಜನರ ಕಡೆ ತಿರುಗಿಕೊಂಡು, ಎದ್ದುನಿಂತಿದ್ದ ಇಸ್ರಾಯೇಲ್ ಜನರನ್ನೆಲ್ಲಾ ಆಶೀರ್ವದಿಸಿದನು. <verse eid="2CH 6:3"/><verse number="4" style="v" sid="2CH 6:4"/>ನಂತರ ಅರಸನು ಹೀಗೆ ಹೇಳಿದನು:</para>
  <para style="pm" vid="2CH 6:4">“ಇಸ್ರಾಯೇಲಿನ ದೇವರಾದ ಯೆಹೋವ ದೇವರಿಗೆ ಸ್ತೋತ್ರವಾಗಲಿ. ಅವರು ನನ್ನ ತಂದೆಯಾದ ದಾವೀದನಿಗೆ ತಮ್ಮ ಬಾಯಿಂದ ವಾಗ್ದಾನ ಮಾಡಿದ್ದನ್ನು, ತಮ್ಮ ಕೈಗಳಿಂದಲೇ ನೆರವೇರಿಸಿದರು. <verse eid="2CH 6:4"/><verse number="5" style="v" sid="2CH 6:5"/>ದೇವರು ತಮ್ಮ ಬಾಯಿಂದ, ‘ನನ್ನ ಜನರಾದ ಇಸ್ರಾಯೇಲರನ್ನು ಈಜಿಪ್ಟ್ ದೇಶದಿಂದ ಬರಮಾಡಿದ ದಿನ ಮೊದಲುಗೊಂಡು, ನನ್ನ ನಾಮವು ಅದರಲ್ಲಿರುವ ಹಾಗೆ ಆಲಯವನ್ನು ಕಟ್ಟುವುದಕ್ಕೆ, ಇಸ್ರಾಯೇಲಿನ ಸಮಸ್ತ ಗೋತ್ರಗಳೊಳಗಿಂದ ಪಟ್ಟಣವನ್ನು ಆರಿಸಿಕೊಳ್ಳಲಿಲ್ಲ. ನನ್ನ ಜನರಾದ ಇಸ್ರಾಯೇಲರ ಮೇಲೆ ಆಳುವವನಾಗಿರಲು ನಾನು ಒಬ್ಬನನ್ನಾದರೂ ಆಯ್ದುಕೊಳ್ಳಲಿಲ್ಲ. <verse eid="2CH 6:5"/><verse number="6" style="v" sid="2CH 6:6"/>ಆದರೆ ನನ್ನ ಹೆಸರು ಅಲ್ಲಿ ಇರುವಂತೆ ಯೆರೂಸಲೇಮನ್ನೂ, ಇಸ್ರಾಯೇಲರನ್ನು ಆಳುವುದಕ್ಕೆ ನಾನು ದಾವೀದನನ್ನೂ ಆರಿಸಿಕೊಂಡಿದ್ದೇನೆ,’ ಎಂದು ಹೇಳಿದ್ದರು.<verse eid="2CH 6:6"/></para>
  <para style="pm">
    <verse number="7" style="v" sid="2CH 6:7"/>“ಆದಕಾರಣ ನನ್ನ ತಂದೆ ದಾವೀದನು ಇಸ್ರಾಯೇಲಿನ ದೇವರಾದ ಯೆಹೋವ ದೇವರ ಹೆಸರಿಗೋಸ್ಕರ ಆಲಯವನ್ನು ಕಟ್ಟಬೇಕೆಂದು ಮನಸ್ಸು ಮಾಡಿದಾಗ, <verse eid="2CH 6:7"/><verse number="8" style="v" sid="2CH 6:8"/>ಯೆಹೋವ ದೇವರು ಆತನಿಗೆ, ‘ನೀನು ನನ್ನ ಹೆಸರಿಗೋಸ್ಕರ ಒಂದು ಆಲಯವನ್ನು ಕಟ್ಟುವುದಕ್ಕೆ ಮನಸ್ಸು ಮಾಡಿದ್ದು ಒಳ್ಳೇದೇ ಸರಿ. <verse eid="2CH 6:8"/><verse number="9" style="v" sid="2CH 6:9"/>ಆದರೆ ನೀನು ಆಲಯವನ್ನು ಕಟ್ಟಬಾರದು. ನಿನ್ನಿಂದ ಹುಟ್ಟುವ ಮಗನೇ, ನನ್ನ ಹೆಸರಿಗೋಸ್ಕರ ಆಲಯವನ್ನು ಕಟ್ಟಬೇಕು,’ ಎಂದು ಹೇಳಿದರು.<verse eid="2CH 6:9"/></para>
  <para style="pm">
    <verse number="10" style="v" sid="2CH 6:10"/>“ಈಗ ಯೆಹೋವ ದೇವರು ತಾವು ಹೇಳಿದ ವಾಗ್ದಾನವನ್ನು ನೆರವೇರಿಸಿದ್ದಾರೆ. ನಾನು ನನ್ನ ತಂದೆಯಾದ ದಾವೀದನಿಗೆ ಬದಲಾಗಿ, ಯೆಹೋವ ದೇವರು ಮಾತುಕೊಟ್ಟ ಪ್ರಕಾರ ಇಸ್ರಾಯೇಲಿನ ಸಿಂಹಾಸನದ ಮೇಲೆ ಕುಳಿತುಕೊಂಡು, ಇಸ್ರಾಯೇಲಿನ ದೇವರಾದ ಯೆಹೋವ ದೇವರ ಹೆಸರಿಗೋಸ್ಕರ ಈ ಆಲಯವನ್ನು ಕಟ್ಟಿಸಿದ್ದೇನೆ. <verse eid="2CH 6:10"/><verse number="11" style="v" sid="2CH 6:11"/>ಯೆಹೋವ ದೇವರು ಇಸ್ರಾಯೇಲರ ಸಂಗಡ ಮಾಡಿದ ಒಡಂಬಡಿಕೆಯು ಇರುವ ಮಂಜೂಷವನ್ನು ಅದರಲ್ಲಿ ಇಟ್ಟಿದ್ದೇನೆ,” ಎಂದನು.<verse eid="2CH 6:11"/></para>
  <para style="s1">ಸೊಲೊಮೋನನ ಪ್ರಾರ್ಥನೆ</para>
  <para style="p">
    <verse number="12" style="v" sid="2CH 6:12"/>ಆಗ ಸೊಲೊಮೋನನು ಇಸ್ರಾಯೇಲಿನ ಸಮಸ್ತ ಸಮೂಹದವರ ಸಮ್ಮುಖದಲ್ಲಿ ಯೆಹೋವ ದೇವರ ಬಲಿಪೀಠದ ಮುಂದೆ ನಿಂತು, ಪ್ರಾರ್ಥನೆಗಾಗಿ ತನ್ನ ಕೈಗಳನ್ನು ಚಾಚಿದನು. <verse eid="2CH 6:12"/><verse number="13" style="v" sid="2CH 6:13"/>ಸೊಲೊಮೋನನು ಸುಮಾರು ಎರಡೂವರೆ ಮೀಟರ್ ಉದ್ದ, ಎರಡೂವರೆ ಮೀಟರ್ ಅಗಲ, ಒಂದೂವರೆ ಮೀಟರ್ ಎತ್ತರವಾಗಿರುವ ಒಂದು ಕಂಚಿನ ಪೀಠವನ್ನು ಮಾಡಿಸಿ, ಅಂಗಳದ ಮಧ್ಯದಲ್ಲಿಡಿಸಿದನು. ತಾನು ಅದರ ಮೇಲೆ ನಿಂತು ಇಸ್ರಾಯೇಲಿನ ಸಮಸ್ತ ಸಮೂಹದವರ ಸಮ್ಮುಖದಲ್ಲಿ ಮೊಣಕಾಲೂರಿ ಆಕಾಶದೆಡೆಗೆ ತನ್ನ ಕೈಗಳನ್ನು ಚಾಚಿ, <verse eid="2CH 6:13"/><verse number="14" style="v" sid="2CH 6:14"/>ಹೀಗೆ ಪ್ರಾರ್ಥಿಸಿದನು.</para>
  <para style="pm" vid="2CH 6:14">“ಇಸ್ರಾಯೇಲಿನ ದೇವರಾದ ಯೆಹೋವ ದೇವರೇ, ಆಕಾಶದಲ್ಲಾದರೂ, ಭೂಮಿಯಲ್ಲಾದರೂ ನಿಮ್ಮ ಹಾಗೆ ದೇವರು ಯಾರೂ ಇಲ್ಲ. ಸಂಪೂರ್ಣ ಹೃದಯದಿಂದ ನಿಮಗೆ ನಡೆದುಕೊಳ್ಳುವಂಥ ಸೇವಕರ ಬಗ್ಗೆ ನೀವು ನಿಮ್ಮ ಒಡಂಬಡಿಕೆಯನ್ನು ನೆರವೇರಿಸಿ ಕೃಪೆಯನ್ನು ತೋರಿಸಿದ್ದೀರಿ. <verse eid="2CH 6:14"/><verse number="15" style="v" sid="2CH 6:15"/>ನಿಮ್ಮ ಸೇವಕನಾದಂಥ ನನ್ನ ತಂದೆಯಾದ ದಾವೀದನಿಗೆ ಕೊಟ್ಟ ಮಾತನ್ನು ನೆರವೇರಿಸಿ, ನೀವು ನಿಮ್ಮ ಬಾಯಿಂದ ಹೇಳಿದ್ದನ್ನು ಇಂದು ಈಡೇರಿಸಿದ್ದೀರಿ.<verse eid="2CH 6:15"/></para>
  <para style="pm">
    <verse number="16" style="v" sid="2CH 6:16"/>“ಆದಕಾರಣ, ಈಗ ಇಸ್ರಾಯೇಲಿನ ದೇವರಾದ ಯೆಹೋವ ದೇವರೇ, ‘ನಿಮ್ಮ ಸಂತಾನದವರು, ನಿನ್ನಂತೆ ಜಾಗ್ರತೆಯಾಗಿದ್ದು, ನನ್ನ ನಿಯಮದ ಪ್ರಕಾರ ನಡೆದುಕೊಳ್ಳುವದಾದರೆ, ಅವರು ತಪ್ಪದೆ ಇಸ್ರಾಯೇಲಿನ ಸಿಂಹಾಸನದ ಮೇಲೆ ನನ್ನ ಸಮ್ಮುಖದಲ್ಲಿ ಕುಳಿತುಕೊಳ್ಳುವರು,’ ಎಂದು ನೀವು ನನ್ನ ತಂದೆಯಾದ ನಿಮ್ಮ ಸೇವಕನಾದ ದಾವೀದನಿಗೆ ವಾಗ್ದಾನ ಮಾಡಿದ್ದನ್ನು ನೆರವೇರಿಸಿರಿ. <verse eid="2CH 6:16"/><verse number="17" style="v" sid="2CH 6:17"/>ಈಗ ಇಸ್ರಾಯೇಲಿನ ದೇವರಾದ ಯೆಹೋವ ದೇವರೇ, ನಿಮ್ಮ ಸೇವಕನಾದ ದಾವೀದನಿಗೆ ಹೇಳಿದ ವಾಕ್ಯವು ನೆರವೇರಲಿ.<verse eid="2CH 6:17"/></para>
  <para style="pm">
    <verse number="18" style="v" sid="2CH 6:18"/>“ಆದರೆ ದೇವರು ನಿಜವಾಗಿ ಭೂಮಿಯ ಮೇಲೆ ಮನುಷ್ಯರ ಸಂಗಡ ವಾಸವಾಗಿರುವರೋ? ಇಗೋ, ಆಕಾಶವೂ, ಉನ್ನತೋನ್ನತ ಆಕಾಶವೂ ನಿಮಗೆ ಸಾಲದು. ಹಾಗಾದರೆ, ನಾನು ಕಟ್ಟಿಸಿದ ಈ ಆಲಯವು ನಿಮಗೆ ಸಾಲುವುದು ಹೇಗೆ? <verse eid="2CH 6:18"/><verse number="19" style="v" sid="2CH 6:19"/>ಆದರೂ ನನ್ನ ದೇವರಾದ ಯೆಹೋವ ದೇವರೇ, ನಿಮ್ಮ ಸೇವಕನ ಪ್ರಾರ್ಥನೆಗೂ, ಅವನ ವಿಜ್ಞಾಪನೆಗೂ ತಿರುಗಿಕೊಂಡು, ನಿಮ್ಮ ಸೇವಕನು ನಿಮ್ಮ ಮುಂದೆ ಪ್ರಾರ್ಥಿಸುವ ಪ್ರಾರ್ಥನೆಯ ಕೂಗನ್ನು ಕೇಳಿರಿ. <verse eid="2CH 6:19"/><verse number="20" style="v" sid="2CH 6:20"/>ನಿಮ್ಮ ಸೇವಕನು ಈ ಸ್ಥಳದಲ್ಲಿ ಮಾಡುವ ಪ್ರಾರ್ಥನೆಯನ್ನು ನೀವು ಕೇಳುವಂತೆ, ‘ಇಲ್ಲಿ ನನ್ನ ನಾಮಪ್ರಭಾವ ಇರುವುದು,’ ಎಂದು ನೀವು ಹೇಳಿದ ಈ ಆಲಯದ ಮೇಲೆ ರಾತ್ರಿ ಹಗಲೂ ನಿಮ್ಮ ಕಟಾಕ್ಷವಿರಲಿ. <verse eid="2CH 6:20"/><verse number="21" style="v" sid="2CH 6:21"/>ಇದಲ್ಲದೆ ನೀವು ನಿಮ್ಮ ಸೇವಕನ ಮತ್ತು ನಿಮ್ಮ ಜನರಾದ ಇಸ್ರಾಯೇಲರ ವಿಜ್ಞಾಪನೆಯನ್ನೂ ಕೇಳಿರಿ. ಅವರು ಈ ಸ್ಥಳದ ಕಡೆಗೆ ಪ್ರಾರ್ಥಿಸುವಾಗ, ನೀವು ವಾಸಮಾಡುವ ಸ್ಥಳವಾದ ಪರಲೋಕದಿಂದ ಕೇಳಿ, ಕ್ಷಮೆಯನ್ನು ದಯಪಾಲಿಸಿರಿ.<verse eid="2CH 6:21"/></para>
  <para style="pm">
    <verse number="22" style="v" sid="2CH 6:22"/>“ತನ್ನ ನೆರೆಯವನಿಗೆ ವಿರೋಧವಾಗಿ ತಪ್ಪುಮಾಡಿದವನೆಂಬ ಸಂಶಯಕ್ಕೆ ಗುರಿಯಾದ ಒಬ್ಬ ವ್ಯಕ್ತಿ, ತಾನು ನಿರ್ದೋಷಿಯೆಂದು ಪ್ರಮಾಣಮಾಡಬೇಕಾದಾಗ, ಅಂಥವನು ಈ ಆಲಯಕ್ಕೆ ಬಂದು, ನಿಮ್ಮ ಪೀಠದ ಮುಂದೆ ನಿಂತು ಪ್ರಮಾಣಮಾಡಿದರೆ, <verse eid="2CH 6:22"/><verse number="23" style="v" sid="2CH 6:23"/>ನೀವೇ ಆ ಅಪರಾಧಿಯನ್ನು ಖಂಡಿಸಿ ಅವನ ತಪ್ಪನ್ನು ಅವನ ತಲೆಯ ಮೇಲೆಯೇ ಹೊರಿಸಿರಿ; ಅವನು ಅಪರಾಧಿಯೆಂದು ತೋರಿಸಿಕೊಡಿರಿ. ನಿರ್ದೋಷಿಯಾಗಿದ್ದರೆ ಅವನ ನೀತಿಯ ಫಲವನ್ನು ಅನುಗ್ರಹಿಸಿ ಅವನು ನೀತಿವಂತನೆಂದು ತೋರಿಸಿಕೊಡುವ ಹಾಗೆ ಪರಲೋಕದಲ್ಲಿರುವ ನೀವು ಅದನ್ನು ಕೇಳಿ, ನಿಮ್ಮ ಸೇವಕರ ನ್ಯಾಯವನ್ನು ತೀರಿಸಿರಿ.<verse eid="2CH 6:23"/></para>
  <para style="pm">
    <verse number="24" style="v" sid="2CH 6:24"/>“ನಿಮ್ಮ ಜನರಾದ ಇಸ್ರಾಯೇಲರು ನಿಮಗೆ ವಿರೋಧವಾಗಿ ಪಾಪಮಾಡಿದ್ದರಿಂದ, ತಮ್ಮ ಶತ್ರುವಿನ ಮುಂದೆ ಪರಾಭವಗೊಂಡು, ನಿಮ್ಮ ಕಡೆಗೆ ತಿರುಗಿಕೊಂಡು, ನಿಮ್ಮ ನಾಮವನ್ನು ಕೊಂಡಾಡಿ, ಈ ಆಲಯಕ್ಕೆ ಬಂದು, ನಿಮ್ಮ ಸನ್ನಿಧಿಯಲ್ಲಿ ವಿಜ್ಞಾಪನೆಯನ್ನೂ ಪ್ರಾರ್ಥನೆಯನ್ನೂ ಮಾಡಿದರೆ, <verse eid="2CH 6:24"/><verse number="25" style="v" sid="2CH 6:25"/>ಆಗ ನೀವು ಪರಲೋಕದಿಂದ ಕೇಳಿ, ನಿಮ್ಮ ಜನರಾದ ಇಸ್ರಾಯೇಲರ ಪಾಪವನ್ನು ಮನ್ನಿಸಿ, ನೀವು ಅವರಿಗೂ ಅವರ ತಂದೆಗಳಿಗೂ ಕೊಟ್ಟ ದೇಶಕ್ಕೆ ಅವರನ್ನು ತಿರುಗಿ ಬರಮಾಡಿರಿ.<verse eid="2CH 6:25"/></para>
  <para style="pm">
    <verse number="26" style="v" sid="2CH 6:26"/>“ಅವರು ನಿಮಗೆ ವಿರೋಧವಾಗಿ ಪಾಪವನ್ನು ಮಾಡಿದ್ದರಿಂದ, ನೀವು ಆಕಾಶವನ್ನು ಮಳೆಗರೆಯದಂತೆ ಮುಚ್ಚಿ ಅವರನ್ನು ಕುಂದಿಸಿದಾಗ ಅವರು ತಮ್ಮ ಪಾಪವನ್ನು ಬಿಟ್ಟು ಈ ಸ್ಥಳದ ಕಡೆಗೆ ತಿರುಗಿಕೊಂಡು, ನಿಮ್ಮ ನಾಮವನ್ನು ಕೊಂಡಾಡಿ ಪ್ರಾರ್ಥಿಸಿದರೆ, <verse eid="2CH 6:26"/><verse number="27" style="v" sid="2CH 6:27"/>ಆಗ ನೀವು ಪರಲೋಕದಿಂದ ಕೇಳಿ, ನಿಮ್ಮ ಸೇವಕರಾದ ಇಸ್ರಾಯೇಲ್ ಜನರ ಪಾಪವನ್ನು ಮನ್ನಿಸಿ, ಅವರು ನಡೆಯಬೇಕಾದ ಸನ್ಮಾರ್ಗವನ್ನು ಅವರಿಗೆ ಕಲಿಸಿ, ನಿಮ್ಮ ಜನರಿಗೆ ಬಾಧ್ಯತೆಯಾಗಿ ಕೊಟ್ಟ ಭೂಮಿಯ ಮೇಲೆ ಮಳೆಯನ್ನು ಕೊಡಿರಿ.<verse eid="2CH 6:27"/></para>
  <para style="pm">
    <verse number="28" style="v" sid="2CH 6:28"/>“ದೇಶದಲ್ಲಿ ಬರಗಾಲ, ಘೋರವ್ಯಾಧಿ, ಉರಿಗಾಳಿ, ಬೆಳೆಗಳ ಮೇಲೆ ಮಿಡತೆ, ಕಂಬಳಿಹುಳು ಇವುಗಳು ಇದ್ದರೆ, ಅಥವಾ ಅವರ ಶತ್ರುಗಳು ತಮ್ಮ ಸ್ವದೇಶದ ಪಟ್ಟಣಗಳಲ್ಲಿ ಅವರನ್ನು ಹಿಂಸಿಸಿದರೂ, ಯಾವ ಬಾಧೆ ಯಾವ ಬೇನೆ ಇದ್ದರೂ, <verse eid="2CH 6:28"/><verse number="29" style="v" sid="2CH 6:29"/>ನಿಮ್ಮ ಜನರಾದ ಸಮಸ್ತ ಇಸ್ರಾಯೇಲಿನ ಯಾವ ಒಬ್ಬ ಮನುಷ್ಯನಾದರೂ ತಾನು ಅನುಭವಿಸುತ್ತಿರುವ ಉಪದ್ರವ ದುಃಖಗಳ ನಿಮಿತ್ತವಾಗಿ ಈ ಮಂದಿರದ ಕಡೆಗೆ ತನ್ನ ಕೈಗಳನ್ನು ಚಾಚಿ, ಯಾವ ಪ್ರಾರ್ಥನೆಯನ್ನಾದರೂ, ವಿಜ್ಞಾಪನೆಯನ್ನಾದರೂ ಮಾಡಿದರೆ, <verse eid="2CH 6:29"/><verse number="30" style="v" sid="2CH 6:30"/>ನೀವು ವಾಸಮಾಡುವ ಪರಲೋಕದಿಂದ ಕೇಳಿ ಮನ್ನಿಸಿ, ಮನುಷ್ಯನ ಹೃದಯವನ್ನು ತಿಳಿದಿರುವ ನೀವು ಪ್ರತಿ ಮನುಷ್ಯನಿಗೂ ಅವನವನ ಮಾರ್ಗದ ಪ್ರಕಾರ ಪ್ರತಿಫಲಕೊಡಿರಿ. ಏಕೆಂದರೆ ನೀವೊಬ್ಬರೇ ಸಮಸ್ತ ಜನರ ಹೃದಯಗಳನ್ನು ತಿಳಿದವರಾಗಿದ್ದೀರಿ. <verse eid="2CH 6:30"/><verse number="31" style="v" sid="2CH 6:31"/>ಆಗ ನೀವು ನಮ್ಮ ತಂದೆಗಳಿಗೆ ಕೊಟ್ಟ ದೇಶದಲ್ಲಿ ಅವರು ವಾಸಿಸುವ ಕಾಲದಲ್ಲೆಲ್ಲಾ ನಿಮ್ಮಲ್ಲಿ ಭಯಭಕ್ತಿಯುಳ್ಳವರಾಗಿ ನಿಮ್ಮ ಮಾರ್ಗಗಳಲ್ಲಿ ನಡೆಯುವರು.<verse eid="2CH 6:31"/></para>
  <para style="pm">
    <verse number="32" style="v" sid="2CH 6:32"/>“ನಿಮ್ಮ ಜನರಾದ ಇಸ್ರಾಯೇಲಿನವನಲ್ಲದೆ ನಿಮ್ಮ ಮಹಾನಾಮದ ನಿಮಿತ್ತ ದೂರದೇಶದಿಂದ ಬಂದ ಒಬ್ಬ ಪರದೇಶಿಯು, ನಿಮ್ಮ ಬಲವಾದ ಕೈ, ನಿಮ್ಮ ಚಾಚಿದ ತೋಳು ಇವುಗಳ ಕುರಿತು ಕೇಳಿ, ಅವರು ಈ ಆಲಯದ ಕಡೆಗೆ ಬಂದು ಪ್ರಾರ್ಥನೆಮಾಡಿದರೆ, <verse eid="2CH 6:32"/><verse number="33" style="v" sid="2CH 6:33"/>ನೀವು ವಾಸಮಾಡುವ ಪರಲೋಕದಿಂದ ಕೇಳಿ, ಪರದೇಶಿಯು ಕೇಳಿದ್ದೆಲ್ಲವನ್ನು ನೆರವೇರಿಸಿರಿ. ಆಗ ಭೂಲೋಕದ ಎಲ್ಲಾ ಜನರೂ ನಿಮ್ಮ ನಾಮವನ್ನು ತಿಳಿದು, ನಿಮ್ಮ ಜನರಾದ ಇಸ್ರಾಯೇಲರಂತೆ ನಿಮಗೆ ಭಯಭಕ್ತಿಯುಳ್ಳವರಾಗಿ, ನಾನು ಕಟ್ಟಿಸಿದ ಈ ಆಲಯವು ನಿಮ್ಮ ಹೆಸರಿನಿಂದ ಕರೆಯಲಾಗಿದೆ ಎಂದು ತಿಳಿದುಕೊಳ್ಳುವರು.<verse eid="2CH 6:33"/></para>
  <para style="pm">
    <verse number="34" style="v" sid="2CH 6:34"/>“ನೀವು ನಿಮ್ಮ ಜನರನ್ನು ತಮ್ಮ ಶತ್ರುಗಳ ಸಂಗಡ ಯುದ್ಧಮಾಡುವದಕ್ಕೆ ಎಲ್ಲಿಗಾದರೂ ಕಳುಹಿಸಿದಾಗ, ಅವರು ಅಲ್ಲಿಂದ ನೀವು ಆಯ್ದುಕೊಂಡ ಪಟ್ಟಣದ ಕಡೆಗೂ, ನಾನು ನಿಮ್ಮ ಹೆಸರಿಗಾಗಿ ಕಟ್ಟಿಸಿದ ಈ ಆಲಯದ ಕಡೆಗೂ ತಿರುಗಿಕೊಂಡು, ಅವರು ನಿಮಗೆ ಪ್ರಾರ್ಥನೆಮಾಡಿದರೆ, <verse eid="2CH 6:34"/><verse number="35" style="v" sid="2CH 6:35"/>ಆಗ ನೀವು ಪರಲೋಕದಿಂದ ಅವರ ಪ್ರಾರ್ಥನೆಯನ್ನೂ ವಿಜ್ಞಾಪನೆಯನ್ನೂ ಕೇಳಿ, ಅವರಿಗೆ ನ್ಯಾಯವನ್ನು ತೀರಿಸಿರಿ.<verse eid="2CH 6:35"/></para>
  <para style="pm">
    <verse number="36" style="v" sid="2CH 6:36"/>“ಪಾಪ ಮಾಡದವನು ಯಾವನೂ ಇಲ್ಲವಲ್ಲಾ. ಆದ್ದರಿಂದ ಅವರು ನಿಮಗೆ ವಿರೋಧವಾಗಿ ಪಾಪಮಾಡಲು, ನೀವು ಅವರ ಮೇಲೆ ಕೋಪಿಸಿಕೊಂಡು ದೂರವಾದರೂ, ಸಮೀಪವಾದರೂ ಶತ್ರುವಿನ ದೇಶಕ್ಕೆ ಅವರು ಸೆರೆಯಾಗಿ ಹೋಗುವಂತೆ ನೀವು ಅವರನ್ನು ಶತ್ರುವಿನ ಕೈಯಲ್ಲಿ ಒಪ್ಪಿಸಿದರೆ, <verse eid="2CH 6:36"/><verse number="37" style="v" sid="2CH 6:37"/>ಅವರು ಸೆರೆಯವರಾಗಿ ಬಿದ್ದುಕೊಂಡಿರುವ ದೇಶದಲ್ಲಿ ಮಾನಸಾಂತರಪಟ್ಟು, ‘ನಾವು ಪಾಪಮಾಡಿದ್ದೇವೆ, ತಪ್ಪುಮಾಡಿ ದುಷ್ಟರಾಗಿ ನಡೆದಿದ್ದೇವೆ,’ ಎಂದು ಅವರನ್ನು ಸೆರೆಯಾಗಿ ಒಯ್ಯುವವರ ದೇಶದಲ್ಲಿ ನಿಮಗೆ ಪ್ರಾರ್ಥನೆಮಾಡಿ, <verse eid="2CH 6:37"/><verse number="38" style="v" sid="2CH 6:38"/>ತಮ್ಮ ಪೂರ್ಣಹೃದಯದಿಂದಲೂ, ಪೂರ್ಣಪ್ರಾಣದಿಂದಲೂ ನಿಮ್ಮ ಕಡೆಗೆ ತಿರುಗಿಕೊಂಡು, ನೀವು ಅವರ ಪಿತೃಗಳಿಗೆ ಕೊಟ್ಟ ತಮ್ಮ ದೇಶದ ಕಡೆಗೂ, ನೀವು ಆಯ್ದುಕೊಂಡ ಪಟ್ಟಣದ ಕಡೆಗೂ ನಿಮ್ಮ ನಾಮಕ್ಕೋಸ್ಕರ ನಾನು ಕಟ್ಟಿಸಿದ ಈ ಆಲಯದ ಕಡೆಗೂ ತಿರುಗಿಕೊಂಡು, ಅವರು ನಿಮಗೆ ಪ್ರಾರ್ಥನೆಮಾಡಿದರೆ, <verse eid="2CH 6:38"/><verse number="39" style="v" sid="2CH 6:39"/>ಆಗ ನೀವು ವಾಸಮಾಡುವ ಪರಲೋಕದಿಂದ ಅವರ ಪ್ರಾರ್ಥನೆಯನ್ನೂ ವಿಜ್ಞಾಪನೆಯನ್ನೂ ಕೇಳಿ ಅವರ ನ್ಯಾಯವನ್ನು ತೀರಿಸಿರಿ, ನಿಮ್ಮ ಜನರು ನಿಮಗೆ ವಿರೋಧವಾಗಿ ಮಾಡಿದ ಪಾಪಗಳನ್ನು ಕ್ಷಮಿಸಿರಿ.<verse eid="2CH 6:39"/></para>
  <para style="pm">
    <verse number="40" style="v" sid="2CH 6:40"/>“ಈಗ ನನ್ನ ದೇವರೇ, ಈ ಸ್ಥಳದಲ್ಲಿ ಮಾಡಿದ ಪ್ರಾರ್ಥನೆಗೆ ನಿಮ್ಮ ಕಣ್ಣುಗಳು ತೆರೆದಿರಲಿ. ನಿಮ್ಮ ಕಿವಿಗಳು ಆಲಿಸುತ್ತಾ ಇರಲಿ.<verse eid="2CH 6:40"/></para>
  <para style="qm1">
    <verse number="41" style="v" sid="2CH 6:41"/>“ಈಗ ದೇವರಾದ ಯೆಹೋವ ದೇವರೇ, ಎದ್ದು ನಿಮ್ಮ ವಿಶ್ರಾಂತಿಯ ಸ್ಥಳಕ್ಕೆ ಬನ್ನಿರಿ;</para>
  <para style="qm2" vid="2CH 6:41">ನೀವೂ, ನಿಮ್ಮ ಶಕ್ತಿಯುತ ಮಂಜೂಷವೂ ಬರಲಿ.</para>
  <para style="qm1" vid="2CH 6:41">ಯೆಹೋವ ದೇವರೇ, ನಿಮ್ಮ ಯಾಜಕರು ರಕ್ಷಣೆಯೆಂಬ ವಸ್ತ್ರವನ್ನು ಧರಿಸಿಕೊಳ್ಳಲಿ.</para>
  <para style="qm2" vid="2CH 6:41">ನಿಮ್ಮ ಭಕ್ತರು ಒಳ್ಳೆಯದರಲ್ಲಿ ಸಂತೋಷಪಡಲಿ.<verse eid="2CH 6:41"/></para>
  <para style="qm1">
    <verse number="42" style="v" sid="2CH 6:42"/>ಯೆಹೋವ ದೇವರೇ, ನಿಮ್ಮ ಅಭಿಷಿಕ್ತನನ್ನು ತಿರಸ್ಕರಿಸಬೇಡಿರಿ.</para>
  <para style="qm2" vid="2CH 6:42">ನಿಮ್ಮ ಸೇವಕನಾದ ದಾವೀದನಿಗೆ ವಾಗ್ದಾನಮಾಡಿದ ಮಹಾ ಪ್ರೀತಿಯನ್ನು ನೆನಪುಮಾಡಿಕೊಳ್ಳಿರಿ,” ಎಂದು ಬೇಡಿಕೊಂಡನು.<verse eid="2CH 6:42"/></para>
  <chapter eid="2CH 6"/>
  <chapter number="7" style="c" sid="2CH 7"/>
  <para style="s1">ದೇವಾಲಯದ ಪ್ರತಿಷ್ಠಾಪನೆ</para>
  <para style="p">
    <verse number="1" style="v" sid="2CH 7:1"/>ಸೊಲೊಮೋನನು ತನ್ನ ಪ್ರಾರ್ಥನೆಯನ್ನು ಮುಗಿಸಿದ ಕೂಡಲೆ, ಬೆಂಕಿಯು ಆಕಾಶದಿಂದ ಇಳಿದು ದಹನಬಲಿಗಳನ್ನೆಲ್ಲಾ ದಹಿಸಿಬಿಟ್ಟಿತು. ಯೆಹೋವ ದೇವರ ಮಹಿಮೆಯು ಆಲಯವನ್ನು ತುಂಬಿತು. <verse eid="2CH 7:1"/><verse number="2" style="v" sid="2CH 7:2"/>ಯೆಹೋವ ದೇವರ ಮಹಿಮೆಯು ಆಲಯವನ್ನು ತುಂಬಿದ್ದರಿಂದ ಯಾಜಕರು ಆಲಯದಲ್ಲಿ ಹೋಗಲಾರದೆ ಇದ್ದರು. <verse eid="2CH 7:2"/><verse number="3" style="v" sid="2CH 7:3"/>ಇಸ್ರಾಯೇಲರೆಲ್ಲರೂ ಬೆಂಕಿಯು ಇಳಿದದ್ದನ್ನೂ, ಆಲಯದ ಮೇಲೆ ಇರುವ ಯೆಹೋವ ದೇವರ ಮಹಿಮೆಯನ್ನೂ ಕಂಡಾಗ, ಅವರು ನೆಲಕ್ಕೆ ತಮ್ಮ ಮುಖಗಳನ್ನು ಬಾಗಿ, ನೆಲಗಟ್ಟಿನ ಮೇಲೆ ಮೊಣಕಾಲೂರಿ ಆರಾಧಿಸುತ್ತಾ, ಯೆಹೋವ ದೇವರನ್ನು ಕೊಂಡಾಡಿ ಹೇಳಿದ್ದೇನೆಂದರೆ,</para>
  <para style="q1" vid="2CH 7:3">“ಯೆಹೋವ ದೇವರು ಒಳ್ಳೆಯವರು,</para>
  <para style="q2" vid="2CH 7:3">ಅವರ ಪ್ರೀತಿಯು ಯುಗಯುಗಕ್ಕೂ ಇರುವುದು.”<verse eid="2CH 7:3"/></para>
  <para style="m">
    <verse number="4" style="v" sid="2CH 7:4"/>ಆಗ ಅರಸನೂ, ಸಮಸ್ತ ಜನರೂ ಯೆಹೋವ ದೇವರ ಮುಂದೆ ಬಲಿಗಳನ್ನು ಅರ್ಪಿಸಿದರು. <verse eid="2CH 7:4"/><verse number="5" style="v" sid="2CH 7:5"/>ಅರಸನಾದ ಸೊಲೊಮೋನನು 22,000 ಹೋರಿಗಳನ್ನೂ, 1,20,000 ಕುರಿಗಳನ್ನೂ ಬಲಿಯಾಗಿ ಅರ್ಪಿಸಿದನು. ಹೀಗೆಯೇ ಅರಸನೂ, ಸಮಸ್ತ ಜನರೂ ದೇವರ ಆಲಯವನ್ನು ಪ್ರತಿಷ್ಠೆ ಮಾಡಿದರು. <verse eid="2CH 7:5"/><verse number="6" style="v" sid="2CH 7:6"/>ಯಾಜಕರು ತಮ್ಮ ತಮ್ಮ ಸೇವೆಯಲ್ಲಿ ನಿಂತರು. ಹಾಗೆಯೇ ಲೇವಿಯರು ಯೆಹೋವ ದೇವರ ಗೀತವಾದ್ಯಗಳನ್ನು ಹಿಡಿದುಕೊಂಡು ನಿಂತರು. ಅರಸನಾದ ದಾವೀದನು ಯೆಹೋವ ದೇವರನ್ನು ಕೊಂಡಾಡುವುದಕ್ಕೆ ಇವುಗಳನ್ನು ಮಾಡಿಸಿದ್ದನು. “ಯೆಹೋವ ದೇವರ ಪ್ರೀತಿಯು ಯುಗಯುಗಕ್ಕೂ ಇರುವುದು,” ಎಂಬುದಾಗಿ ಆ ವಾದ್ಯಗಳೊಡನೆ ಭಜಿಸುತ್ತಿದ್ದರು. ಯಾಜಕರು ಲೇವಿಯರ ಮುಂದೆ ನಿಂತು ತುತೂರಿಗಳನ್ನು ಊದುತ್ತಿದ್ದರು. ಸಮಸ್ತ ಇಸ್ರಾಯೇಲರೂ ನಿಂತಿದ್ದರು.<verse eid="2CH 7:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="2CH 7:7"/>ಸೊಲೊಮೋನನು ಮಾಡಿಸಿದ ಕಂಚಿನ ಬಲಿಪೀಠದ ಮೇಲೆ ದಹನಬಲಿಗಳನ್ನೂ, ಧಾನ್ಯ ಸಮರ್ಪಣೆಯ ಕೊಬ್ಬನ್ನೂ ಇಡುವುದಕ್ಕೆ ಸ್ಥಳ ಸಾಲದೆ ಇದ್ದುದರಿಂದ, ಸೊಲೊಮೋನನು ಯೆಹೋವ ದೇವರ ಆಲಯದ ಮುಂದಿರುವ ಮಧ್ಯದ ಅಂಗಳವನ್ನು ಪ್ರತಿಷ್ಠೆಮಾಡಿ, ಅಲ್ಲಿ ಅವನು ದಹನಬಲಿಗಳನ್ನೂ, ಸಮಾಧಾನದ ಬಲಿಗಳ ಕೊಬ್ಬನ್ನೂ ಅರ್ಪಿಸಿದನು.<verse eid="2CH 7:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="2CH 7:8"/>ಅದೇ ಕಾಲದಲ್ಲಿ ಸೊಲೊಮೋನನೂ, ಅವನ ಸಂಗಡ ಲೆಬೊ ಹಮಾತಿನ ಪ್ರದೇಶ ಮೊದಲುಗೊಂಡು ಈಜಿಪ್ಟಿನ ನದಿಯವರೆಗೆ ಇರುವ ಮಹಾ ಜನಾಂಗವಾಗಿ ಕೂಡಿಬಂದಿದ್ದ ಸಮಸ್ತ ಇಸ್ರಾಯೇಲರೂ ಅವನ ಸಂಗಡ ಏಳು ದಿವಸ ಹಬ್ಬವನ್ನು ಮಾಡಿದರು. <verse eid="2CH 7:8"/><verse number="9" style="v" sid="2CH 7:9"/>ಎಂಟನೆಯ ದಿನದಲ್ಲಿ ಪರಿಶುದ್ಧ ಸಮೂಹವನ್ನು ನಡೆಸಿದರು. ಏಕೆಂದರೆ ಏಳು ದಿವಸ ಬಲಿಪೀಠದ ಪ್ರತಿಷ್ಠೆಯನ್ನು ಮತ್ತು ಇನ್ನು ಏಳು ದಿವಸ ಹಬ್ಬವನ್ನು ಆಚರಿಸಿದರು. <verse eid="2CH 7:9"/><verse number="10" style="v" sid="2CH 7:10"/>ಏಳನೆಯ ತಿಂಗಳಿನ ಇಪ್ಪತ್ತಮೂರನೆಯ ದಿವಸದಲ್ಲಿ ಅವನು ಜನರಿಗೆ ಅವರವರ ಡೇರೆಗಳಿಗೆ ಹೋಗುವುದಕ್ಕೆ ಅಪ್ಪಣೆಕೊಡಲು, ಆಗ ಅವರು ಯೆಹೋವ ದೇವರು ದಾವೀದನಿಗೂ, ಸೊಲೊಮೋನನಿಗೂ, ತನ್ನ ಜನರಾದ ಇಸ್ರಾಯೇಲರಿಗೂ ಮಾಡಿದ ಉಪಕಾರದ ನಿಮಿತ್ತ ಅವರು ಹೃದಯದಲ್ಲಿ ಆನಂದಭರಿತರಾಗಿ ಸಂತೋಷಪಡುತ್ತಾ ಹೋದರು.<verse eid="2CH 7:10"/></para>
  <para style="s1">ಯೆಹೋವ ದೇವರು ಸೊಲೊಮೋನನಿಗೆ ಕಾಣಿಸಿಕೊಂಡದ್ದು</para>
  <para style="p">
    <verse number="11" style="v" sid="2CH 7:11"/>ಸೊಲೊಮೋನನು ಯೆಹೋವ ದೇವರ ಆಲಯವನ್ನೂ, ಅರಮನೆಯನ್ನೂ ಕಟ್ಟಿಸಿ ತೀರಿಸಿದನು. ಅವನು ಯೆಹೋವ ದೇವರ ಆಲಯದಲ್ಲಿಯೂ, ತನ್ನ ಅರಮನೆಯಲ್ಲಿಯೂ ಮಾಡಬೇಕಾದ ತನ್ನ ಮನಸ್ಸಿನಲ್ಲಿ ಇದ್ದ ಯೋಜನೆಯನ್ನು ಈಡೇರಿಸುವಲ್ಲಿ ಯಶಸ್ವಿಯಾದನು. <verse eid="2CH 7:11"/><verse number="12" style="v" sid="2CH 7:12"/>ಯೆಹೋವ ದೇವರು ರಾತ್ರಿಯಲ್ಲಿ ಸೊಲೊಮೋನನಿಗೆ ಪ್ರತ್ಯಕ್ಷರಾಗಿ ಅವನಿಗೆ,</para>
  <para style="pm" vid="2CH 7:12">“ನಾನು ನಿನ್ನ ಪ್ರಾರ್ಥನೆಯನ್ನು ಕೇಳಿ ಬಲಿಯನ್ನು ಅರ್ಪಿಸುವ ಆಲಯವಾಗಿ ನನಗೆ ಈ ಸ್ಥಳವನ್ನು ಆಯ್ದುಕೊಂಡಿದ್ದೇನೆ.<verse eid="2CH 7:12"/></para>
  <para style="pm">
    <verse number="13" style="v" sid="2CH 7:13"/>“ಮಳೆಯಿಲ್ಲದಂತೆ ನಾನು ಆಕಾಶವನ್ನು ಮುಚ್ಚಿದರೂ ದೇಶವನ್ನು ತಿಂದುಬಿಡಲು ಮಿಡತೆಗಳಿಗೆ ಆಜ್ಞಾಪಿಸಿದರೂ, ಇಲ್ಲವೆ ನನ್ನ ಜನರ ಮಧ್ಯದಲ್ಲಿ ಘೋರ ವ್ಯಾಧಿಯನ್ನು ಕಳುಹಿಸಿದರೂ, <verse eid="2CH 7:13"/><verse number="14" style="v" sid="2CH 7:14"/>ನನ್ನ ಹೆಸರಿನಿಂದ ಕರೆಯಲಾದ ನನ್ನ ಜನರು ತಮ್ಮನ್ನು ತಗ್ಗಿಸಿಕೊಂಡು ಪ್ರಾರ್ಥನೆಮಾಡಿ, ನನ್ನನ್ನು ಹುಡುಕಿ ತಮ್ಮ ದುರ್ಮಾರ್ಗಗಳಿಂದ ತಿರುಗಿದರೆ, ಆಗ ನಾನು ಪರಲೋಕದಿಂದ ಕೇಳಿ ಅವರ ಪಾಪವನ್ನು ಮನ್ನಿಸಿ, ಅವರ ದೇಶವನ್ನು ಗುಣ ಮಾಡುವೆನು. <verse eid="2CH 7:14"/><verse number="15" style="v" sid="2CH 7:15"/>ಈಗ ಈ ಸ್ಥಳದ ಪ್ರಾರ್ಥನೆಗೆ ನನ್ನ ಕಣ್ಣುಗಳು ತೆರೆದಿರುವುವು, ನನ್ನ ಕಿವಿಗಳು ಆಲೈಸುತ್ತಿರುವುವು. <verse eid="2CH 7:15"/><verse number="16" style="v" sid="2CH 7:16"/>ನನ್ನ ನಾಮವು ಯುಗಯುಗಾಂತರಕ್ಕೂ ಅಲ್ಲಿರುವ ಹಾಗೆ ಈ ಆಲಯವನ್ನು ಆಯ್ದುಕೊಂಡು ಪರಿಶುದ್ಧ ಮಾಡಿದ್ದೇನೆ. ನನ್ನ ಕಣ್ಣುಗಳೂ, ನನ್ನ ಹೃದಯವೂ ನಿತ್ಯವಾಗಿ ಅಲ್ಲಿರುವುವು.<verse eid="2CH 7:16"/></para>
  <para style="pm">
    <verse number="17" style="v" sid="2CH 7:17"/>“ನೀನು ನಿನ್ನ ತಂದೆಯಾದ ದಾವೀದನಂತೆ, ನಾನು ನಿನಗೆ ಆಜ್ಞಾಪಿಸಿದ ನನ್ನ ಕಟ್ಟಳೆಗಳನ್ನೂ ನ್ಯಾಯಗಳನ್ನೂ ನಿಷ್ಠೆಯಿಂದ ಕೈಗೊಂಡು ನಡೆದರೆ, <verse eid="2CH 7:17"/><verse number="18" style="v" sid="2CH 7:18"/>‘ಇಸ್ರಾಯೇಲಿನ ಸಿಂಹಾಸನದ ಮೇಲೆ ಕುಳಿತುಕೊಳ್ಳಲು ನಿನಗೆ ಉತ್ತರಾಧಿಕಾರಿಯ ಕೊರತೆಯಾಗುವುದಿಲ್ಲ,’ ಎಂದು ನಾನು ನಿನ್ನ ತಂದೆ ದಾವೀದನ ಸಂಗಡ ಮಾಡಿದ ಒಡಂಬಡಿಕೆಯ ಪ್ರಕಾರ ನಿನ್ನ ರಾಜ್ಯದ ಸಿಂಹಾಸನವನ್ನು ಸ್ಥಿರಪಡಿಸುತ್ತೇನೆ.<verse eid="2CH 7:18"/></para>
  <para style="pm">
    <verse number="19" style="v" sid="2CH 7:19"/>“ಆದರೆ ನೀವು, ನಾನು ನಿಮಗೆ ಕೊಟ್ಟಿರುವ ಆಜ್ಞೆಗಳನ್ನೂ ಕಟ್ಟಳೆಗಳನ್ನೂ ತೊರೆದುಬಿಟ್ಟು, ನನ್ನಿಂದ ದೂರಹೋಗಿ ಅನ್ಯದೇವರುಗಳನ್ನು ಸೇವಿಸಿ ಅವುಗಳಿಗೆ ಅಡ್ಡಬಿದ್ದರೆ, <verse eid="2CH 7:19"/><verse number="20" style="v" sid="2CH 7:20"/>ಆಗ ನಾನು ಇಸ್ರಾಯೇಲಿಗೆ ಕೊಟ್ಟ ನನ್ನ ದೇಶದೊಳಗಿಂದ ಅವರನ್ನು ಕಿತ್ತುಹಾಕಿ, ನನ್ನ ನಾಮಕ್ಕೋಸ್ಕರ ಪ್ರತಿಷ್ಠಿಸಿಕೊಂಡ ಈ ಆಲಯವನ್ನು ನಾನು ನಿರಾಕರಿಸುವೆನು. ಅದನ್ನು ಸಮಸ್ತ ಜನರಲ್ಲಿ ಗಾದೆಯಾಗಿಯೂ, ಅಪಹಾಸ್ಯಕ್ಕೆ ಆಸ್ಪದವಾಗುವಂತೆ ಮಾಡುವೆನು. <verse eid="2CH 7:20"/><verse number="21" style="v" sid="2CH 7:21"/>ಇದಲ್ಲದೆ ಉನ್ನತವಾಗಿರುವ ಈ ಆಲಯದ ಮಾರ್ಗವಾಗಿ ಹೋಗುವವರೆಲ್ಲರೂ ಅದಕ್ಕೆ ಆಶ್ಚರ್ಯಪಟ್ಟು, ‘ಯೆಹೋವ ದೇವರು, ಈ ದೇಶಕ್ಕೂ, ಈ ಆಲಯಕ್ಕೂ ಹೀಗೆ ಏಕೆ ಮಾಡಿದರು?’ ಎಂದು ಕೇಳುವರು. <verse eid="2CH 7:21"/><verse number="22" style="v" sid="2CH 7:22"/>ಅದಕ್ಕೆ ಜನರು, ‘ತಮ್ಮ ತಂದೆಗಳನ್ನು ಈಜಿಪ್ಟ್ ದೇಶದೊಳಗಿಂದ ಬರಮಾಡಿದ ತಮ್ಮ ದೇವರಾದ ಯೆಹೋವ ದೇವರನ್ನು ಬಿಟ್ಟು, ಅನ್ಯದೇವರುಗಳನ್ನು ಹಿಂಬಾಲಿಸಿ, ಅವುಗಳಿಗೆ ಅಡ್ಡಬಿದ್ದು ಸೇವಿಸಿದ್ದರಿಂದ, ಅವರು ಈ ಕೇಡನ್ನೆಲ್ಲಾ ಅವರ ಮೇಲೆ ಬರಮಾಡಿದ್ದಾರೆಂದು ಹೇಳುವರು,’ ” ಎಂದರು.<verse eid="2CH 7:22"/></para>
  <chapter eid="2CH 7"/>
  <chapter number="8" style="c" sid="2CH 8"/>
  <para style="s1">ಸೊಲೊಮೋನನ ಇತರ ಚಟುವಟಿಕೆಗಳು</para>
  <para style="p">
    <verse number="1" style="v" sid="2CH 8:1"/>ಸೊಲೊಮೋನನು ಇಪ್ಪತ್ತು ವರ್ಷಗಳಲ್ಲಿ ಯೆಹೋವ ದೇವರ ಆಲಯವನ್ನೂ, ತನ್ನ ಅರಮನೆಯನ್ನೂ ಕಟ್ಟಿಸಿ ತೀರಿಸಿದ ತರುವಾಯ, <verse eid="2CH 8:1"/><verse number="2" style="v" sid="2CH 8:2"/>ಹೀರಾಮನು ಸೊಲೊಮೋನನಿಗೆ ತಿರುಗಿ ಕೊಟ್ಟ ಪಟ್ಟಣಗಳನ್ನು ಸೊಲೊಮೋನನು ಕಟ್ಟಿಸಿ, ಇಸ್ರಾಯೇಲರನ್ನು ಅಲ್ಲಿ ನಿವಾಸವಾಗಿರುವಂತೆ ಮಾಡಿದನು. <verse eid="2CH 8:2"/><verse number="3" style="v" sid="2CH 8:3"/>ಸೊಲೊಮೋನನು ಹಮಾತ್ ಚೋಬವನ್ನು ವಶಪಡಿಸಿಕೊಂಡನು. <verse eid="2CH 8:3"/><verse number="4" style="v" sid="2CH 8:4"/>ಅವನು ಮರುಭೂಮಿಯಲ್ಲಿರುವ ತದ್ಮೋರ್ ಪಟ್ಟಣವನ್ನೂ, ಹಮಾತಿನಲ್ಲಿರುವ ಉಗ್ರಾಣದ ಪಟ್ಟಣಗಳನ್ನೂ ಕಟ್ಟಿಸಿದನು. <verse eid="2CH 8:4"/><verse number="5" style="v" sid="2CH 8:5"/>ಇವುಗಳಲ್ಲದೆ, ಮೇಲಿನ ಬೇತ್ ಹೋರೋನ್ ಮತ್ತು ಕೆಳಗಿನ ಬೇತ್ ಹೋರೋನ್ ಪಟ್ಟಣಗಳನ್ನು ಪುನಃ ನಿರ್ಮಿಸಿದನು. ಈ ಪಟ್ಟಣಗಳು ಬಲವಾದ ಗೋಡೆಗಳು, ಬಾಗಿಲುಗಳು ಮತ್ತು ಅಗುಳಿಗಳು ಉಳ್ಳ ಕೋಟೆ ಪಟ್ಟಣಗಳಾಗಿ ಸೊಲೊಮೋನನು ಕಟ್ಟಿಸಿದನು. <verse eid="2CH 8:5"/><verse number="6" style="v" sid="2CH 8:6"/>ಅಲ್ಲದೆ, ಬಾಲಾತ್ ಪಟ್ಟಣವನ್ನೂ, ಉಗ್ರಾಣದ ಪಟ್ಟಣಗಳನ್ನೂ, ತನ್ನ ರಾಹುತರಿಗೋಸ್ಕರ ಮತ್ತು ರಥಗಳಿಗೋಸ್ಕರ ಪಟ್ಟಣಗಳನ್ನೂ ಕಟ್ಟಿಸಿದನು. ಯೆರೂಸಲೇಮಿನಲ್ಲಿಯೂ ಲೆಬನೋನಿನಲ್ಲಿಯೂ ತನ್ನ ರಾಜ್ಯದ ಎಲ್ಲಾ ಪ್ರಾಂತಗಳಲ್ಲಿಯೂ ತನಗೆ ಇಷ್ಟವಾದವುಗಳನ್ನೆಲ್ಲಾ ಕಟ್ಟಿಸಿದನು.<verse eid="2CH 8:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="2CH 8:7"/>ಸೊಲೊಮೋನನು ಇಸ್ರಾಯೇಲರಲ್ಲದ ಅಮೋರಿಯರು, ಹಿತ್ತಿಯರು, ಪೆರಿಜೀಯರು, ಹಿವ್ವಿಯರು, ಯೆಬೂಸಿಯರು, ಇವರಲ್ಲಿ ಉಳಿದ ಸಮಸ್ತ ಜನರನ್ನೂ <verse eid="2CH 8:7"/><verse number="8" style="v" sid="2CH 8:8"/>ಇಸ್ರಾಯೇಲರು ಸಂಹರಿಸದೆ ಉಳಿಸಿದ್ದ ಅವರ ಮಕ್ಕಳನ್ನೂ ಸೊಲೊಮೋನನು ಇಂದಿನವರೆಗೂ ದಾಸತ್ವಕ್ಕಾಗಿ ನೇಮಿಸಿದನು. <verse eid="2CH 8:8"/><verse number="9" style="v" sid="2CH 8:9"/>ಆದರೆ ಸೊಲೊಮೋನನು ತನ್ನ ಕೆಲಸಕ್ಕಾಗಿ ಇಸ್ರಾಯೇಲರನ್ನು ದಾಸರಾಗಿ ಮಾಡಲಿಲ್ಲ. ಆದರೆ ಅವರು ಯುದ್ಧಭಟರಾಗಿಯೂ, ಅಧಿಪತಿಗಳಲ್ಲಿ ಪ್ರಧಾನರಾಗಿಯೂ, ತನ್ನ ರಥಗಳ ಮೇಲೆಯೂ, ರಾಹುತರ ಮೇಲೆಯೂ ಅಧಿಪತಿಗಳಾಗಿಯೂ ಇರುವಂತೆ ಮಾಡಿದನು. <verse eid="2CH 8:9"/><verse number="10" style="v" sid="2CH 8:10"/>ಇವರು ಅರಸನಾದ ಸೊಲೊಮೋನನ ಅಧಿಪತಿಗಳಲ್ಲಿ ಪ್ರಧಾನರಾಗಿದ್ದರು, ಇವರು ಇನ್ನೂರೈವತ್ತು ಮಂದಿ ಆಳುಗಳ ಮೇಲೆ ಅಧಿಕಾರಿಗಳಾಗಿದ್ದರು.<verse eid="2CH 8:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="2CH 8:11"/>ಸೊಲೊಮೋನನು, “ಯೆಹೋವ ದೇವರ ಒಡಂಬಡಿಕೆಯ ಮಂಜೂಷವಿದ್ದ ಸ್ಥಳಗಳು ಪರಿಶುದ್ಧವಾಗಿರುವುದರಿಂದ, ನನ್ನ ಹೆಂಡತಿಯು ಇಸ್ರಾಯೇಲಿನ ಅರಸನಾದ ದಾವೀದನ ಅರಮನೆಯಲ್ಲಿ ವಾಸವಾಗಿರಕೂಡದು,” ಎಂದು ಹೇಳಿ ಸೊಲೊಮೋನನು ಫರೋಹನ ಮಗಳನ್ನು ದಾವೀದನ ಪಟ್ಟಣದಲ್ಲಿರಿಸದೆ ತಾನು ಆಕೆಗೋಸ್ಕರ ಕಟ್ಟಿಸಿದ ಅರಮನೆಯಲ್ಲಿ ಅವಳನ್ನು ಇರಿಸಿದನು.<verse eid="2CH 8:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="2CH 8:12"/>ಆಗ ಸೊಲೊಮೋನನು ದ್ವಾರಾಂಗಳದ ಮುಂದೆ ತಾನು ಕಟ್ಟಿಸಿದ ಯೆಹೋವ ದೇವರ ಬಲಿಪೀಠದ ಮೇಲೆ ಯೆಹೋವ ದೇವರಿಗೆ ದಹನಬಲಿಗಳನ್ನು ಅರ್ಪಿಸಿದನು. <verse eid="2CH 8:12"/><verse number="13" style="v" sid="2CH 8:13"/>ದಿನಂಪ್ರತಿ ಮೋಶೆಯ ಆಜ್ಞೆಯ ಪ್ರಕಾರ ವಿಶ್ರಾಂತಿಯ ದಿನಗಳಲ್ಲಿಯೂ ಅಮಾವಾಸ್ಯೆಗಳಲ್ಲಯೂ ವರುಷಕ್ಕೆ ಮೂರು ಸಾರಿ ಪವಿತ್ರ ಹಬ್ಬಗಳಾದ ಹುಳಿಯಿಲ್ಲದ ರೊಟ್ಟಿಗಳ ಹಬ್ಬದಲ್ಲಿಯೂ ವಾರಗಳ ಹಬ್ಬದಲ್ಲಿಯೂ ಗುಡಾರಗಳ ಹಬ್ಬದಲ್ಲಿಯೂ ಬಲಿಗಳನ್ನು ಅರ್ಪಿಸಿದನು. <verse eid="2CH 8:13"/><verse number="14" style="v" sid="2CH 8:14"/>ಅವನು ತನ್ನ ತಂದೆಯಾದ ದಾವೀದನ ಕ್ರಮದ ಪ್ರಕಾರ, ಅವರ ಸೇವೆಗೆ ಯಾಜಕ ವರ್ಗಗಳವರನ್ನೂ ಪ್ರತಿ ದಿವಸಕ್ಕೆ ಬೇಕಾದ ಕಾರ್ಯದ ಪ್ರಕಾರ, ಯಾಜಕರ ಮುಂದೆ ಸ್ತುತಿಸುವುದಕ್ಕೂ, ಸೇವೆ ಮಾಡುವುದಕ್ಕೂ ತಮ್ಮ ವಿಚಾರಗಳಲ್ಲಿ ಲೇವಿಯರನ್ನೂ, ಸೇವೆಯ ಬಾಗಿಲಲ್ಲಿ ತಮ್ಮ ವರ್ಗಗಳ ಸರದಿಯ ಪ್ರಕಾರವಾಗಿ ದ್ವಾರಪಾಲಕರನ್ನೂ ನೇಮಿಸಿದನು. ಏಕೆಂದರೆ ದೇವರ ಮನುಷ್ಯನಾದ ದಾವೀದನು ಹಾಗೆಯೇ ನೇಮಿಸಿದ್ದನು. <verse eid="2CH 8:14"/><verse number="15" style="v" sid="2CH 8:15"/>ಅವರು ಯಾವ ಕಾರ್ಯದಲ್ಲಾದರೂ, ಬೊಕ್ಕಸಗಳಲ್ಲಾದರೂ ಅರಸನು ಯಾಜಕರಿಗೂ ಲೇವಿಯರಿಗೂ ಹೇಳಿದ ಆಜ್ಞೆಯನ್ನು ಮೀರಲಿಲ್ಲ.<verse eid="2CH 8:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="2CH 8:16"/>ಯೆಹೋವ ದೇವರ ಆಲಯದ ಅಸ್ತಿವಾರ ಹಾಕಿದ ದಿವಸದವರೆಗೂ ಅದನ್ನು ಕಟ್ಟಿಸಿ ತೀರಿಸುವವರೆಗೂ ಸೊಲೊಮೋನನ ಕೆಲಸವೆಲ್ಲಾ ಮುಗಿದು, ಯೆಹೋವ ದೇವರ ಆಲಯವು ಸಿದ್ಧವಾಯಿತು.<verse eid="2CH 8:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="2CH 8:17"/>ಆಗ ಸೊಲೊಮೋನನು ಎದೋಮ್ ದೇಶದ ಸಮುದ್ರತೀರದ ಬಳಿಯಲ್ಲಿರುವ ಎಚ್ಯೋನ್ ಗೆಬೆರ್, ಏಲೋತ್ ಎಂಬ ಊರುಗಳಿಗೆ ಹೊರಟುಹೋದನು. <verse eid="2CH 8:17"/><verse number="18" style="v" sid="2CH 8:18"/>ಹೀರಾಮನು ತನ್ನ ಸೇವಕರ ಮುಖಾಂತರ ಹಡಗುಗಳನ್ನೂ, ಸಮುದ್ರ ಪ್ರಯಾಣದಲ್ಲಿ ನಿಪುಣರಾದ ತನ್ನ ನಾವಿಕರನ್ನು ಅವನ ಬಳಿಗೆ ಕಳುಹಿಸಿದನು. ಅವರು ಸೊಲೊಮೋನನ ಸೇವಕರ ಸಂಗಡ ಓಫೀರಿಗೆ ಹೋಗಿ, ಅಲ್ಲಿಂದ ಅರಸನಾದ ಸೊಲೊಮೋನನಿಗೆ 15,000 ಕಿಲೋಗ್ರಾಂ ಬಂಗಾರವನ್ನು ತೆಗೆದುಕೊಂಡು ಬಂದರು.<verse eid="2CH 8:18"/></para>
  <chapter eid="2CH 8"/>
  <chapter number="9" style="c" sid="2CH 9"/>
  <para style="s1">ಶೆಬ ದೇಶದ ರಾಣಿ ಸೊಲೊಮೋನನನ್ನು ಸಂದರ್ಶಿಸಿದ್ದು</para>
  <para style="p">
    <verse number="1" style="v" sid="2CH 9:1"/>ಶೆಬದ ರಾಣಿಯು ಸೊಲೊಮೋನನ ಕೀರ್ತಿಯನ್ನು ಕೇಳಿದಾಗ, ಒಗಟುಗಳಿಂದ ಅವನನ್ನು ಪರೀಕ್ಷಿಸಲು ಬಂದಳು. ಅವಳು ಮಹಾ ಗುಂಪಿನ ಸಂಗಡ ಸುಗಂಧದ್ರವ್ಯಗಳನ್ನೂ, ಬಹಳಷ್ಟು ಬಂಗಾರವನ್ನೂ, ಅಮೂಲ್ಯವಾದ ರತ್ನಗಳನ್ನೂ ಹೊತ್ತುಕೊಂಡಿರುವ ಒಂಟೆಗಳ ಸಂಗಡ ಯೆರೂಸಲೇಮಿಗೆ ಬಂದಳು. ಅವಳು ಸೊಲೊಮೋನನ ಬಳಿಗೆ ಬಂದ ಮೇಲೆ, ತನ್ನ ಹೃದಯದಲ್ಲಿದ್ದ ಎಲ್ಲವನ್ನು ಕುರಿತು ಅವನ ಸಂಗಡ ಮಾತನಾಡಿದಳು. <verse eid="2CH 9:1"/><verse number="2" style="v" sid="2CH 9:2"/>ಆಗ ಸೊಲೊಮೋನನು ಅವಳ ಪ್ರಶ್ನೆಗಳಿಗೆಲ್ಲಾ ಉತ್ತರಿಸಿದನು, ಅವುಗಳಲ್ಲಿ ಅವನಿಗೆ ತಿಳಿಯದಂಥದ್ದು ಒಂದೂ ಇರಲಿಲ್ಲವಾದ್ದರಿಂದ ಎಲ್ಲವುಗಳಿಗೂ ಉತ್ತರಿಸಿದನು. <verse eid="2CH 9:2"/><verse number="3" style="v" sid="2CH 9:3"/>ಶೆಬದ ರಾಣಿಯು ಸೊಲೊಮೋನನ ಜ್ಞಾನವನ್ನೂ, ಅವನು ಕಟ್ಟಿಸಿದ ಅರಮನೆಯನ್ನೂ, <verse eid="2CH 9:3"/><verse number="4" style="v" sid="2CH 9:4"/>ಅವನ ಮೇಜಿನ ಭೋಜನವನ್ನೂ, ಅವನ ಅಧಿಪತಿಗಳು ಕುಳಿತಿರುವ ರೀತಿಯನ್ನೂ, ಅವನ ಸೇವಕರು ನಿಂತಿರುವುದನ್ನೂ, ಅವರ ವಸ್ತ್ರಗಳನ್ನೂ, ಅವನ ಪಾನದಾಯಕರನ್ನೂ ಅವರ ವಸ್ತ್ರಗಳನ್ನೂ, ಅವನು ಯೆಹೋವ ದೇವರ ಆಲಯದಲ್ಲಿ ಅರ್ಪಿಸಿದ ದಹನಬಲಿಗಳನ್ನೂ ಕಂಡಾಗ ಅವಳು ವಿಸ್ಮಯಗೊಂಡಳು.<verse eid="2CH 9:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="2CH 9:5"/>ಅವಳು ಅರಸನಿಗೆ, “ನಾನು ನನ್ನ ದೇಶದಲ್ಲಿ ನಿನ್ನ ಸಾಧನೆಗಳ ಕುರಿತೂ, ನಿನ್ನ ಜ್ಞಾನವನ್ನು ಕುರಿತೂ ಕೇಳಿದ ಮಾತು ಸತ್ಯ. <verse eid="2CH 9:5"/><verse number="6" style="v" sid="2CH 9:6"/>ಆದರೆ ನಾನು ಬಂದು ನನ್ನ ಕಣ್ಣುಗಳಿಂದ ನೋಡುವವರೆಗೂ ಜನರ ಮಾತುಗಳನ್ನು ನಂಬದೆ ಹೋದೆನು. ಜನರು ನನಗೆ ನಿನ್ನ ಮಹಾಜ್ಞಾನದಲ್ಲಿ ಅರ್ಧವನ್ನಾದರೂ ಹೇಳಲಿಲ್ಲ. ನಾನು ಕೇಳಿದ್ದಕ್ಕಿಂತ ನಿನ್ನ ಕೀರ್ತಿ ಎಷ್ಟೋ ಅಧಿಕವಾಗಿದೆ. <verse eid="2CH 9:6"/><verse number="7" style="v" sid="2CH 9:7"/>ನಿನ್ನ ಜನರು ಭಾಗ್ಯವಂತರು. ನಿನ್ನ ಮುಂದೆ ಯಾವಾಗಲೂ ನಿಂತು ನಿನ್ನ ಜ್ಞಾನವನ್ನು ಕೇಳುವ ಈ ನಿನ್ನ ಅಧಿಪತಿಗಳು ಭಾಗ್ಯವಂತರು. <verse eid="2CH 9:7"/><verse number="8" style="v" sid="2CH 9:8"/>ನಿನ್ನ ದೇವರಾದ ಯೆಹೋವ ದೇವರಿಗೋಸ್ಕರ ಅರಸನಾಗಿರುವಂತೆ ತಮ್ಮ ಸಿಂಹಾಸನದ ಮೇಲೆ ನಿನ್ನನ್ನು ಕುಳ್ಳಿರಿಸಿದ ನಿನ್ನಲ್ಲಿ ಹರ್ಷಗೊಂಡ ನಿನ್ನ ದೇವರಾದ ಯೆಹೋವ ದೇವರಿಗೆ ಸ್ತೋತ್ರವಾಗಲಿ. ನಿನ್ನ ದೇವರು ಇಸ್ರಾಯೇಲರನ್ನು ಪ್ರೀತಿಮಾಡಿದ್ದರಿಂದ ಅವರನ್ನು ಯುಗಯುಗಕ್ಕೂ ಸ್ಥಿರಗೊಳಿಸಬೇಕೆಂದಿದ್ದಾರೆ. ನ್ಯಾಯವನ್ನೂ, ನೀತಿಯನ್ನೂ ನಡೆಸಲು ಅವರು ನಿನ್ನನ್ನು ಅರಸನನ್ನಾಗಿ ಮಾಡಿದರು,” ಎಂದಳು.<verse eid="2CH 9:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="2CH 9:9"/>ಅವಳು ಅರಸನಿಗೆ ನಾಲ್ಕು ಸಾವಿರ ಕಿಲೋಗ್ರಾಂ ತೂಕ ಬಂಗಾರವನ್ನೂ, ಬಹು ಸಮೃದ್ಧಿಯಾದ ಸುಗಂಧದ್ರವ್ಯಗಳನ್ನೂ, ಅಮೂಲ್ಯವಾದ ರತ್ನಗಳನ್ನೂ ಕೊಟ್ಟಳು. ಶೆಬದ ರಾಣಿಯು ಅರಸನಾದ ಸೊಲೊಮೋನನಿಗೆ ಕೊಟ್ಟಂಥ ಸುಗಂಧದ್ರವ್ಯಗಳಿಗೆ ಬೇರೆ ಯಾವುದು ಸಮನವಾದದ್ದು ಇರಲಿಲ್ಲ.<verse eid="2CH 9:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="2CH 9:10"/>ಹೀರಾಮನ ಸೇವಕರೂ, ಸೊಲೊಮೋನನ ಸೇವಕರೂ ಓಫೀರಿನಿಂದ ಬಂಗಾರವನ್ನೂ, ಸುಗಂಧದ ಮರಗಳನ್ನೂ, ಅಮೂಲ್ಯವಾದ ರತ್ನಗಳನ್ನೂ ತಂದರು. <verse eid="2CH 9:10"/><verse number="11" style="v" sid="2CH 9:11"/>ಅರಸನು ಆ ಸುಗಂಧದ ಮರಗಳಿಂದ ಯೆಹೋವ ದೇವರ ಆಲಯಕ್ಕೋಸ್ಕರವೂ, ಅರಮನೆಗೋಸ್ಕರವೂ ಸೋಪಾನಗಳನ್ನು ಮಾಡಿಸಿದನು. ಇದಲ್ಲದೆ ಅವುಗಳಿಂದ ಹಾಡುವವರಿಗೋಸ್ಕರ ಕಿನ್ನರಿಗಳನ್ನೂ ವೀಣೆಗಳನ್ನೂ ಮಾಡಿಸಿದನು. ಯೆಹೂದ ದೇಶದಲ್ಲಿ ಹಿಂದೆಂದೂ ಇಂಥವುಗಳನ್ನು ಕಂಡಿರಲಿಲ್ಲ.<verse eid="2CH 9:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="2CH 9:12"/>ಅರಸನಾದ ಸೊಲೊಮೋನನು, ಶೆಬದ ರಾಣಿಯು ಅರಸನಿಗೆ ತಂದ ಕಾಣಿಕೆಗಳ ಪ್ರತಿಯಾಗಿ ಕೊಟ್ಟದ್ದಲ್ಲದೆ, ಅವಳು ಬಯಸಿ ಕೇಳಿದ್ದನ್ನೆಲ್ಲಾ ಅವಳಿಗೆ ಕೊಟ್ಟನು. ಅನಂತರ ಅವಳು ತನ್ನ ಸೇವಕರೊಡನೆ ತಿರುಗಿ ತಮ್ಮ ದೇಶಕ್ಕೆ ಹೋದಳು.<verse eid="2CH 9:12"/></para>
  <para style="s1">ಸೊಲೊಮೋನನ ವೈಭವ</para>
  <para style="p">
    <verse number="13" style="v" sid="2CH 9:13"/>ಸೊಲೊಮೋನನಿಗೆ ಪ್ರತಿ ವರುಷ ಸುಮಾರು ಇಪ್ಪತ್ತಮೂರು ಸಾವಿರ ಕಿಲ್ರೊಗ್ರಾಂ ಬಂಗಾರವು ದೊರಕುತ್ತಿತ್ತು. <verse eid="2CH 9:13"/><verse number="14" style="v" sid="2CH 9:14"/>ಇದಲ್ಲದೆ ಸೊಲೊಮೋನನಿಗೆ ವರ್ತಕರೂ ವ್ಯಾಪಾರಸ್ಥರೂ ಅರೇಬಿಯದ ಅರಸರೂ ದೇಶದ ಅಧಿಪತಿಗಳೂ ಸಹ ಬೆಳ್ಳಿಬಂಗಾರವನ್ನು ತರುತ್ತಿದ್ದರು.<verse eid="2CH 9:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="2CH 9:15"/>ಅರಸನಾದ ಸೊಲೊಮೋನನು ಬಂಗಾರದಿಂದ ಇನ್ನೂರು ಗುರಾಣಿಗಳನ್ನು ಮಾಡಿಸಿದನು. ಒಂದೊಂದು ಗುರಾಣಿ ಸುಮಾರು ಏಳು ಕಿಲೋಗ್ರಾಂ ತೂಕದ ಬಂಗಾರವಿತ್ತು. <verse eid="2CH 9:15"/><verse number="16" style="v" sid="2CH 9:16"/>ಹಾಗೆಯೇ ಬಂಗಾರದಿಂದ ಮುನ್ನೂರು ಸಣ್ಣ ಗುರಾಣಿಗಳನ್ನು ಮಾಡಿಸಿದನು. ಒಂದೊಂದು ಗುರಾಣಿಗೆ ಸುಮಾರು ಎರಡು ಕಿಲೋಗ್ರಾಂ ಬಂಗಾರ ಹಿಡಿಯಿತು. ಅರಸನು ಇವುಗಳನ್ನು ಲೆಬನೋನಿನ ಅಡವಿಯ ಮನೆಯಲ್ಲಿ ಇಟ್ಟನು.<verse eid="2CH 9:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="2CH 9:17"/>ಅರಸನು ದಂತದಿಂದ ದೊಡ್ಡ ಸಿಂಹಾಸನವನ್ನು ಮಾಡಿಸಿ, ಅದನ್ನು ಚೊಕ್ಕ ಬಂಗಾರದಿಂದ ಹೊದಿಸಿದನು. <verse eid="2CH 9:17"/><verse number="18" style="v" sid="2CH 9:18"/>ಈ ಸಿಂಹಾಸನಕ್ಕೆ ಆರು ಮೆಟ್ಟಲುಗಳಿದ್ದವು. ಸಿಂಹಾಸನಕ್ಕೆ ಬಂಗಾರದ ಪಾದ ಪೀಠ ಇತ್ತು. ಕುಳಿತುಕೊಳ್ಳುವ ಆಸನದ ಎರಡು ಕಡೆಗಳಲ್ಲಿ ಕೈಗಳಿದ್ದವು, ಆ ಕೈಗಳ ಬಳಿಯಲ್ಲಿ ಎರಡು ಸಿಂಹಗಳು ನಿಂತಿದ್ದವು. <verse eid="2CH 9:18"/><verse number="19" style="v" sid="2CH 9:19"/>ಹನ್ನೆರಡು ಸಿಂಹಗಳು ಆರು ಮೆಟ್ಟಲುಗಳ ಮೇಲೆ ಎರಡು ಕಡೆಗಳಲ್ಲಿ ನಿಂತಿದ್ದವು. ಯಾವ ರಾಜ್ಯದಲ್ಲಿಯೂ ಅಂಥದ್ದು ಇರಲಿಲ್ಲ. <verse eid="2CH 9:19"/><verse number="20" style="v" sid="2CH 9:20"/>ಇದಲ್ಲದೆ ಅರಸನಾದ ಸೊಲೊಮೋನನು ಕುಡಿಯುವ ಪಾತ್ರೆಗಳೆಲ್ಲಾ ಬಂಗಾರದವುಗಳಾಗಿದ್ದವು. ಲೆಬನೋನಿನ ಅಡವಿಯ ಅರಮನೆಯ ಎಲ್ಲಾ ಸಾಮಗ್ರಿಗಳು ಚೊಕ್ಕ ಬಂಗಾರದವುಗಳು. ಸೊಲೊಮೋನನ ದಿವಸಗಳಲ್ಲಿ ಬೆಳ್ಳಿಗೆ ಬೆಲೆಯೇ ಇರಲಿಲ್ಲ, ಆದುದರಿಂದ ಅವನಲ್ಲಿ ಬೆಳ್ಳಿಯ ವಸ್ತು ಒಂದಾದರೂ ಕಾಣಿಸಲಿಲ್ಲ. <verse eid="2CH 9:20"/><verse number="21" style="v" sid="2CH 9:21"/>ಅರಸನ ಹಡಗುಗಳು ಹೀರಾಮನ<note caller="+" style="f"><char style="fr" closed="false">9:21 </char><char style="fq" closed="false">ಹೀರಾಮ </char><char style="ft" closed="false">ಹೀಬ್ರೂ ಭಾಷೆಯಲ್ಲಿ </char><char style="fqa" closed="false">ಹೂರಾಮ</char></note> ಸೇವಕರ ಜೊತೆಯಲ್ಲಿ ತಾರ್ಷೀಷಿಗೆ ಹೋಗಿ ಮೂರು ವರ್ಷಕ್ಕೆ ಒಂದು ಸಾರಿ ಬಂಗಾರ, ಬೆಳ್ಳಿ, ದಂತ, ಕೋತಿ, ನವಿಲು ಇವುಗಳನ್ನೂ ತರುತ್ತಿದ್ದವು.<verse eid="2CH 9:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="2CH 9:22"/>ಹೀಗೆಯೇ ಅರಸನಾದ ಸೊಲೊಮೋನನು ಐಶ್ವರ್ಯದಲ್ಲಿಯೂ, ಜ್ಞಾನದಲ್ಲಿಯೂ ಭೂಲೋಕದ ಸಮಸ್ತ ಅರಸರಿಗಿಂತ ಮಿಗಿಲಾಗಿದ್ದನು. <verse eid="2CH 9:22"/><verse number="23" style="v" sid="2CH 9:23"/>ದೇವರು ಸೊಲೊಮೋನನ ಹೃದಯದಲ್ಲಿ ಕೊಟ್ಟಿದ್ದ ಜ್ಞಾನವನ್ನು ಕೇಳುವುದಕ್ಕಾಗಿ ಭೂಲೋಕದಲ್ಲಿರುವ ಸಮಸ್ತ ಅರಸರು ಅವನ ದರ್ಶನವನ್ನು ಬಯಸಿದರು. <verse eid="2CH 9:23"/><verse number="24" style="v" sid="2CH 9:24"/>ಅವರೆಲ್ಲರೂ ಕಾಣಿಕೆಯಾಗಿ ಬೆಳ್ಳಿಯ ಪಾತ್ರೆಗಳನ್ನೂ, ಬಂಗಾರದ ಪಾತ್ರೆಗಳನ್ನೂ, ವಸ್ತ್ರಗಳನ್ನೂ, ಆಯುಧಗಳನ್ನೂ, ಸುಗಂಧಗಳನ್ನೂ, ಕುದುರೆಗಳನ್ನೂ, ಹೇಸರಗತ್ತೆಗಳನ್ನೂ ವರುಷ ವರುಷವೂ ನೇಮಕವಾದ ಪ್ರಕಾರ ತರುತ್ತಿದ್ದರು.<verse eid="2CH 9:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="2CH 9:25"/>ಸೊಲೊಮೋನನಿಗೆ ನಾಲ್ಕು ಸಾವಿರ ಕುದುರೆ ಲಾಯಗಳು ಮತ್ತು ರಥಗಳು ಇದ್ದವು. ಇದಲ್ಲದೆ ಹನ್ನೆರಡು ಸಾವಿರ ರಾಹುತರಿದ್ದರು. ಅವರನ್ನು ರಥಗಳ ಪಟ್ಟಣಗಳಲ್ಲಿಯೂ ಅರಸನ ಬಳಿಯಲ್ಲಿ ಯೆರೂಸಲೇಮಿನಲ್ಲಿಯೂ ಇರಿಸಿದನು. <verse eid="2CH 9:25"/><verse number="26" style="v" sid="2CH 9:26"/>ಅವನು ಯೂಫ್ರೇಟೀಸ್ ನದಿ ಮೊದಲುಗೊಂಡು ಫಿಲಿಷ್ಟಿಯರ ದೇಶವನ್ನು ಹಿಡಿದು ಈಜಿಪ್ಟಿನ ಮೇರೆಯವರೆಗೆ ಇರುವ ಸಮಸ್ತ ಅರಸರ ಮೇಲೆ ಆಳುತ್ತಾ ಇದ್ದನು. <verse eid="2CH 9:26"/><verse number="27" style="v" sid="2CH 9:27"/>ಅರಸನ ಕಾಲದಲ್ಲಿ ಯೆರೂಸಲೇಮಿನಲ್ಲಿ ಬೆಳ್ಳಿಯನ್ನು ಕಲ್ಲುಗಳಂತೆಯೂ, ದೇವದಾರು ಮರಗಳನ್ನು ತಗ್ಗಿನಲ್ಲಿರುವ ಅತ್ತಿಮರಗಳಂತೆಯೂ ಪರಿಗಣಿಸಲಾಯಿತು. <verse eid="2CH 9:27"/><verse number="28" style="v" sid="2CH 9:28"/>ಇದಲ್ಲದೆ ಸೊಲೊಮೋನನಿಗೆ ಈಜಿಪ್ಟಿನಿಂದಲೂ ಸಮಸ್ತ ದೇಶಗಳಿಂದಲೂ ಕುದುರೆಗಳನ್ನು ತೆಗೆದುಕೊಂಡು ಬರುತ್ತಿದ್ದರು.<verse eid="2CH 9:28"/></para>
  <para style="s1">ಸೊಲೊಮೋನನ ಮರಣ</para>
  <para style="p">
    <verse number="29" style="v" sid="2CH 9:29"/>ಸೊಲೊಮೋನನ ಉಳಿದ ಕ್ರಿಯೆಗಳು, ಮೊದಲನೆಯವುಗಳೂ, ಕಡೆಯವುಗಳೂ ಪ್ರವಾದಿಯಾದ ನಾತಾನನ ಪುಸ್ತಕದಲ್ಲಿಯೂ, ಶೀಲೋವಿನವನಾದ ಅಹೀಯನ ಪ್ರವಾದನೆಯಲ್ಲಿಯೂ, ದರ್ಶಿಯಾದ ಇದ್ದೋವನು ನೆಬಾಟನ ಮಗನಾದ ಯಾರೊಬ್ಬಾಮನಿಗೆ ವಿರೋಧವಾಗಿ ಹೇಳಿದ ದರ್ಶನಗಳಲ್ಲಿಯೂ ಬರೆದಿರುತ್ತವೆ. <verse eid="2CH 9:29"/><verse number="30" style="v" sid="2CH 9:30"/>ಹೀಗೆ ಸೊಲೊಮೋನನು ಯೆರೂಸಲೇಮಿನಲ್ಲಿ ಸಮಸ್ತ ಇಸ್ರಾಯೇಲಿನ ಮೇಲೆ ನಾಲ್ವತ್ತು ವರ್ಷಗಳು ಆಳಿದನು. <verse eid="2CH 9:30"/><verse number="31" style="v" sid="2CH 9:31"/>ಸೊಲೊಮೋನನು ಮೃತನಾಗಿ ತನ್ನ ಪಿತೃಗಳ ಬಳಿಗೆ ಸೇರಿದನು. ಅವನ ಶವವನ್ನು ಅವನ ತಂದೆ ದಾವೀದನ ಪಟ್ಟಣದಲ್ಲಿ ಸಮಾಧಿಮಾಡಿದರು. ಅವನ ಮಗ ರೆಹಬ್ಬಾಮನು ಅವನಿಗೆ ಬದಲಾಗಿ ಅರಸನಾದನು.<verse eid="2CH 9:31"/></para>
  <chapter eid="2CH 9"/>
  <chapter number="10" style="c" sid="2CH 10"/>
  <para style="s1">ಇಸ್ರಾಯೇಲು ರೆಹಬ್ಬಾಮನ ವಿರೋಧವಾಗಿ ಎದ್ದದ್ದು</para>
  <para style="p">
    <verse number="1" style="v" sid="2CH 10:1"/>ರೆಹಬ್ಬಾಮನು ಶೆಕೆಮಿಗೆ ಹೋದನು; ಅವನನ್ನು ಅರಸನಾಗಿ ಮಾಡುವುದಕ್ಕೆ ಸಮಸ್ತ ಇಸ್ರಾಯೇಲರು ಶೆಕೆಮಿಗೆ ಬಂದರು. <verse eid="2CH 10:1"/><verse number="2" style="v" sid="2CH 10:2"/>ಅರಸನಾದ ಸೊಲೊಮೋನನ ಸಮ್ಮುಖದಿಂದ ಓಡಿಹೋಗಿ ಈಜಿಪ್ಟಿನಲ್ಲಿ ವಾಸವಾಗಿದ್ದ ನೆಬಾಟನ ಮಗ ಯಾರೊಬ್ಬಾಮನು ಇದನ್ನು ಕೇಳಿದಾಗ, ಅವನು ಈಜಿಪ್ಟಿನಿಂದ ತಿರುಗಿಬಂದನು. <verse eid="2CH 10:2"/><verse number="3" style="v" sid="2CH 10:3"/>ಆಗ ಯಾರೊಬ್ಬಾಮನೂ ಸಮಸ್ತ ಇಸ್ರಾಯೇಲರೂ ರೆಹಬ್ಬಾಮನ ಬಳಿಗೆ ಬಂದು ಅವನ ಸಂಗಡ ಮಾತನಾಡಿ, <verse eid="2CH 10:3"/><verse number="4" style="v" sid="2CH 10:4"/>“ನಿನ್ನ ತಂದೆಯು ನಮ್ಮ ನೊಗವನ್ನು ಭಾರವಾಗಿ ಮಾಡಿದನು. ಈಗ ನೀನು ನಿನ್ನ ತಂದೆಯ ಕಠಿಣವಾದ ಸೇವೆಯನ್ನೂ, ಅವನು ನಮ್ಮ ಮೇಲೆ ಹಾಕಿದ ಅವನ ಭಾರವಾದ ನೊಗವನ್ನೂ ಹಗುರಮಾಡಿದರೆ, ನಾವು ನಿನಗೆ ಸೇವೆಮಾಡುತ್ತೇವೆ,” ಎಂದರು.<verse eid="2CH 10:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="2CH 10:5"/>ಅದಕ್ಕೆ ರೆಹಬ್ಬಾಮನು ಅವರಿಗೆ, “ಮೂರು ದಿವಸಗಳಾದ ತರುವಾಯ ತಿರುಗಿ ನನ್ನ ಬಳಿಗೆ ಬನ್ನಿರಿ,” ಎಂದು ಹೇಳಿದ್ದರಿಂದ ಜನರು ಹೊರಟು ಹೋದರು.<verse eid="2CH 10:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="2CH 10:6"/>ಆಗ ಅರಸನಾದ ರೆಹಬ್ಬಾಮನು, ತನ್ನ ತಂದೆ ಸೊಲೊಮೋನನು ಬದುಕಿರುವಾಗ, ಮಂತ್ರಿಗಳಾಗಿದ್ದ ಹಿರಿಯರನ್ನು ಕೂಡಿಸಿ ಅವರಿಗೆ, “ನಾನು ಈ ಜನರಿಗೆ ಪ್ರತ್ಯುತ್ತರವನ್ನು ಕೊಡಲು ನಿಮ್ಮ ಆಲೋಚನೆಯೇನು?” ಎಂದು ಕೇಳಿದನು.<verse eid="2CH 10:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="2CH 10:7"/>ಅವರು ಅವನಿಗೆ, “ನೀನು ಈ ಜನರಿಗೆ ದಯವುಳ್ಳವನಾಗಿ ಅವರನ್ನು ಮೆಚ್ಚಿಸಿ, ಒಳ್ಳೆಯ ಮಾತುಗಳಿಂದ ಅವರಿಗೆ ಉತ್ತರವನ್ನು ಕೊಡು, ಆಗ ಅವರು ನಿರಂತರವಾಗಿ ನಿನ್ನ ಸೇವಕರಾಗಿರುವರು,” ಎಂದು ಹೇಳಿದರು.<verse eid="2CH 10:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="2CH 10:8"/>ಆದರೆ ರೆಹಬ್ಬಾಮನು, ಹಿರಿಯರು ತನಗೆ ಹೇಳಿದ ಆಲೋಚನೆಯನ್ನು ಬಿಟ್ಟು, ತನ್ನ ಸಂಗಡ ಬೆಳೆದು ತನ್ನ ಮುಂದೆ ನಿಂತಿರುವ ಯೌವನಸ್ಥರ ಆಲೋಚನೆಯನ್ನು ಕೇಳಿ, <verse eid="2CH 10:8"/><verse number="9" style="v" sid="2CH 10:9"/>ಅವನು ಅವರಿಗೆ, “ನಿನ್ನ ತಂದೆಯು ನಮ್ಮ ಮೇಲೆ ಹಾಕಿದ ನೊಗವನ್ನು ಹಗುರ ಮಾಡೆಂದು ನನಗೆ ಹೇಳಿದ ಈ ಜನರಿಗೆ ಉತ್ತರ ಕೊಡಲು ನಿಮ್ಮ ಆಲೋಚನೆ ಏನು?” ಎಂದು ಕೇಳಿದನು.<verse eid="2CH 10:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="2CH 10:10"/>ಆಗ ಅವನ ಸಂಗಡ ಬೆಳೆದ ಯೌವನಸ್ಥರು ಅವನಿಗೆ, “ನಿನ್ನ ತಂದೆಯು ನಮ್ಮ ನೊಗವನ್ನು ಭಾರಮಾಡಿದನು; ಆದರೆ ನೀನು ಅದನ್ನು ನಮಗೆ ಹಗುರ ಮಾಡೆಂದು ನಿನ್ನ ಸಂಗಡ ಮಾತನಾಡಿದ ಈ ಜನರಿಗೆ, ‘ನನ್ನ ಕಿರುಬೆರಳು ನನ್ನ ತಂದೆಯ ನಡುವಿಗಿಂತ ದಪ್ಪವಾಗಿರುವುದು. <verse eid="2CH 10:10"/><verse number="11" style="v" sid="2CH 10:11"/>ನನ್ನ ತಂದೆಯು ನಿಮ್ಮ ಮೇಲೆ ಭಾರವಾದ ನೊಗವನ್ನು ಹೊರಿಸಿದನು. ಆದರೆ ನಾನು ನಿಮ್ಮ ನೊಗವನ್ನು ಇನ್ನೂ ಹೆಚ್ಚು ಭಾರವಾಗಿ ಮಾಡುವೆನು. ನನ್ನ ತಂದೆಯು ನಿಮ್ಮನ್ನು ಬಾರುಕೋಲುಗಳಿಂದ ಹೊಡೆದದ್ದು ನಿಜ, ನಾನಾದರೋ ನಿಮ್ಮನ್ನು ಚೇಳು ಕೊರಡೆಗಳಿಂದ ಶಿಕ್ಷಿಸುವೆನು,’ ಎಂದು ನೀನು ಅವರಿಗೆ ಹೇಳು,” ಎಂದರು.<verse eid="2CH 10:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="2CH 10:12"/>ಆಗ, “ಮೂರನೆಯ ದಿವಸದಲ್ಲಿ ನನ್ನ ಬಳಿಗೆ ಬನ್ನಿರಿ” ಎಂದು ಅರಸನು ಹೇಳಿದ ಪ್ರಕಾರ ಮೂರನೆಯ ದಿವಸದಲ್ಲಿ ಯಾರೊಬ್ಬಾಮನೂ, ಸಮಸ್ತ ಜನರೂ ಅರಸನಾದ ರೆಹಬ್ಬಾಮನ ಬಳಿಗೆ ಬಂದರು. <verse eid="2CH 10:12"/><verse number="13" style="v" sid="2CH 10:13"/>ಆದರೆ ಅರಸನು ಜನರಿಗೆ ಕಠಿಣವಾದ ಉತ್ತರವನ್ನು ಕೊಟ್ಟು, ಹಿರಿಯರು ಅವನಿಗೆ ಕೊಟ್ಟ ಆಲೋಚನೆಯನ್ನು ನಿರಾಕರಿಸಿ, <verse eid="2CH 10:13"/><verse number="14" style="v" sid="2CH 10:14"/>ಯುವಕರ ಆಲೋಚನೆಯ ಪ್ರಕಾರ ಅವರ ಸಂಗಡ ಮಾತನಾಡಿ ಅವರಿಗೆ, “ನನ್ನ ತಂದೆಯು ನಿಮ್ಮ ನೊಗವನ್ನು ಭಾರವಾಗಿ ಮಾಡಿದನು. ನಾನು ಅದನ್ನು ಇನ್ನೂ ಹೆಚ್ಚು ಭಾರ ಮಾಡುತ್ತೇನೆ. ನನ್ನ ತಂದೆಯು ನಿಮ್ಮನ್ನು ಬಾರುಕೋಲುಗಳಿಂದ ಶಿಕ್ಷಿಸಿದನು; ಆದರೆ ನಾನು ಮುಳ್ಳು ಕೊರಡೆಗಳಿಂದ ಶಿಕ್ಷಿಸುವೆನು,” ಎಂದನು. <verse eid="2CH 10:14"/><verse number="15" style="v" sid="2CH 10:15"/>ಅರಸನು ಜನರ ಮಾತನ್ನು ಕೇಳದೆಹೋದದ್ದು ದೇವರಿಂದಲೇ. ಹೀಗೆ ಯೆಹೋವ ದೇವರು ಶೀಲೋವಿನವನಾದ ಅಹೀಯನ ಮುಖಾಂತರವಾಗಿ ನೆಬಾಟನ ಮಗನಾದ ಯಾರೊಬ್ಬಾಮನಿಗೆ ಹೇಳಿಸಿದ ಮಾತು ಈಡೇರುವುದಕ್ಕೆ ಕಾರಣವಾಯಿತು.<verse eid="2CH 10:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="2CH 10:16"/>ಅರಸನು ಅವರ ಮಾತನ್ನು ಕೇಳದೆ ಹೋದನೆಂದು ಸಮಸ್ತ ಇಸ್ರಾಯೇಲರು ತಿಳಿದಾಗ, ಜನರು ಅರಸನಿಗೆ ಉತ್ತರವಾಗಿ,</para>
  <para style="q1" vid="2CH 10:16">“ದಾವೀದನಲ್ಲಿ ನಮಗೆ ಭಾಗವೇನು?</para>
  <para style="q2" vid="2CH 10:16">ಇಷಯನ ಮಗನಲ್ಲಿ ನಮಗೆ ಬಾಧ್ಯತೆ ಏನು?</para>
  <para style="q1" vid="2CH 10:16">ಇಸ್ರಾಯೇಲರೇ, ನಿಮ್ಮ ಡೇರೆಗಳಿಗೆ ಹೋಗಿರಿ.</para>
  <para style="q2" vid="2CH 10:16">ದಾವೀದನೇ, ಈಗ ನಿನ್ನ ಕುಟುಂಬವನ್ನು ನೀನೇ ನೋಡಿಕೋ,”</para>
  <para style="m" vid="2CH 10:16">ಎಂದು ಹೇಳಿ ಇಸ್ರಾಯೇಲರೆಲ್ಲರು ತಮ್ಮ ತಮ್ಮ ಡೇರೆಗಳಿಗೆ ಹೋದರು. <verse eid="2CH 10:16"/><verse number="17" style="v" sid="2CH 10:17"/>ಆದರೆ ಯೆಹೂದದ ಪಟ್ಟಣಗಳಲ್ಲಿ ವಾಸವಾಗಿರುವ ಇಸ್ರಾಯೇಲರ ಮೇಲೆ ರೆಹಬ್ಬಾಮನು ಆಳಿದನು.<verse eid="2CH 10:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="2CH 10:18"/>ಆಗ ರೆಹಬ್ಬಾಮನು ದಾಸರ ಮೇಲ್ವಿಚಾರಕನಾದ ಅದೋನೀರಾಮನನ್ನು<note caller="+" style="f"><char style="fr" closed="false">10:18 </char><char style="fq" closed="false">ಅದೋನೀರಾಮ </char><char style="ft" closed="false">ಅಥವಾ </char><char style="fqa" closed="false">ಹದೋರಾಮ</char></note> ಕಳುಹಿಸಿದನು. ಆದರೆ ಇಸ್ರಾಯೇಲರು ಅವನ ಮೇಲೆ ಕಲ್ಲೆಸೆದು ಕೊಂದುಹಾಕಿದರು. ಆದ್ದರಿಂದ ಅರಸನಾದ ರೆಹಬ್ಬಾಮನು ಆತುರಪಟ್ಟು ತನ್ನ ರಥವನ್ನೇರಿ ಯೆರೂಸಲೇಮಿಗೆ ಓಡಿಹೋದನು. <verse eid="2CH 10:18"/><verse number="19" style="v" sid="2CH 10:19"/>ಹೀಗೆ ಇಂದಿನವರೆಗೂ ಇಸ್ರಾಯೇಲರು ದಾವೀದನ ಕುಟುಂಬದವರೊಡನೆ ವಿರೋಧವಾಗಿ ತಿರುಗಿಬೀಳುತ್ತಲೇ ಇದ್ದಾರೆ.<verse eid="2CH 10:19"/></para>
  <chapter eid="2CH 10"/>
  <chapter number="11" style="c" sid="2CH 11"/>
  <para style="p">
    <verse number="1" style="v" sid="2CH 11:1"/>ರೆಹಬ್ಬಾಮನು ಯೆರೂಸಲೇಮಿಗೆ ಬಂದ ತರುವಾಯ, ರಾಜ್ಯವನ್ನು ತಿರುಗಿ ಪಡೆಯುವ ಹಾಗೆ ಇಸ್ರಾಯೇಲಿಗೆ ವಿರೋಧವಾಗಿ ಯುದ್ಧಮಾಡಲು, ಯೆಹೂದ ಮತ್ತು ಬೆನ್ಯಾಮೀನವರ ಕುಟುಂಬಗಳಿಂದ 1,80,000 ಸಮರ್ಥ ಸೈನಿಕರನ್ನು ಆಯ್ದುಕೊಂಡು ಒಟ್ಟುಗೂಡಿಸಿದನು.<verse eid="2CH 11:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="2CH 11:2"/>ಆದರೆ ಯೆಹೋವ ದೇವರ ವಾಕ್ಯವು ದೇವರ ಮನುಷ್ಯನಾಗಿರುವ ಶೆಮಾಯನಿಗೆ ಉಂಟಾಗಿ, <verse eid="2CH 11:2"/><verse number="3" style="v" sid="2CH 11:3"/>“ನೀನು ಯೆಹೂದದ ಅರಸನಾದ ಸೊಲೊಮೋನನ ಮಗನಾಗಿರುವ ರೆಹಬ್ಬಾಮನಿಗೂ, ಯೆಹೂದ ಬೆನ್ಯಾಮೀನರಲ್ಲಿರುವ ಸಮಸ್ತ ಇಸ್ರಾಯೇಲರಿಗೂ ಹೇಳಬೇಕಾದದ್ದೇನೆಂದರೆ, <verse eid="2CH 11:3"/><verse number="4" style="v" sid="2CH 11:4"/>‘ನೀವು ನಿಮ್ಮ ಸಹೋದರರಿಗೆ ವಿರೋಧವಾಗಿ ಯುದ್ಧಮಾಡಲು ಹೋಗಬೇಡಿರಿ. ಪ್ರತಿ ಮನುಷ್ಯನು ತನ್ನ ಮನೆಗೆ ಹಿಂದಿರುಗಲಿ. ಏಕೆಂದರೆ ಈ ಕಾರ್ಯವು ತಮ್ಮಿಂದ ಉಂಟಾಯಿತೆಂದು ಯೆಹೋವ ದೇವರು ಹೇಳುತ್ತಾರೆ,’ ” ಎಂದನು. ಆದ್ದರಿಂದ ಅವರು ಯೆಹೋವ ದೇವರ ವಾಕ್ಯವನ್ನು ಕೇಳಿ, ಯಾರೊಬ್ಬಾಮನ ಮೇಲೆ ಹೋಗದೆ ಹಿಂದಿರುಗಿ ಹೋದರು.<verse eid="2CH 11:4"/></para>
  <para style="s1">ರೆಹಬ್ಬಾಮನು ಯೆಹೂದವನ್ನು ಬಲಪಡಿಸಿದ್ದು</para>
  <para style="p">
    <verse number="5" style="v" sid="2CH 11:5"/>ರೆಹಬ್ಬಾಮನು ಯೆರೂಸಲೇಮಿನಲ್ಲಿ ವಾಸಮಾಡಿ, ಯೆಹೂದದಲ್ಲಿ ಕೋಟೆಯುಳ್ಳ ಪಟ್ಟಣಗಳನ್ನು ಕಟ್ಟಿಸಿದನು. <verse eid="2CH 11:5"/><verse number="6" style="v" sid="2CH 11:6"/>ಅವನು ಬೇತ್ಲೆಹೇಮನ್ನೂ, ಏಟಾಮನ್ನೂ, ತೆಕೋವನ್ನೂ, <verse eid="2CH 11:6"/><verse number="7" style="v" sid="2CH 11:7"/>ಬೇತ್ ಚೂರ್ ಪಟ್ಯಣವನ್ನೂ, ಸೋಕೋನನ್ನೂ, ಅದುಲ್ಲಾಮನ್ನೂ, <verse eid="2CH 11:7"/><verse number="8" style="v" sid="2CH 11:8"/>ಗತ್ ಊರನ್ನೂ ಮಾರೇಷಾವನ್ನೂ ಜೀಫನ್ನೂ, <verse eid="2CH 11:8"/><verse number="9" style="v" sid="2CH 11:9"/>ಅದೋರೈಮನ್ನೂ, ಲಾಕೀಷನ್ನೂ, ಅಜೇಕವನ್ನೂ, <verse eid="2CH 11:9"/><verse number="10" style="v" sid="2CH 11:10"/>ಚೊರ್ಗವನ್ನೂ, ಅಯ್ಯಾಲೋನನ್ನೂ, ಹೆಬ್ರೋನನ್ನೂ ಕಟ್ಟಿಸಿದನು. ಇವು ಯೆಹೂದದಲ್ಲಿಯೂ, ಬೆನ್ಯಾಮೀನರಲ್ಲಿಯೂ ಕೋಟೆಯುಳ್ಳ ಪಟ್ಟಣಗಳಾಗಿವೆ. <verse eid="2CH 11:10"/><verse number="11" style="v" sid="2CH 11:11"/>ಇದಲ್ಲದೆ ಅವನು ಕೋಟೆಗಳನ್ನು ಬಲಪಡಿಸಿ, ಅವುಗಳಲ್ಲಿ ನಾಯಕರನ್ನೂ, ಆಹಾರ, ಎಣ್ಣೆ, ದ್ರಾಕ್ಷಾರಸ ಇರುವ ಉಗ್ರಾಣಗಳನ್ನೂ ಇಟ್ಟನು. <verse eid="2CH 11:11"/><verse number="12" style="v" sid="2CH 11:12"/>ಪ್ರತಿ ಪಟ್ಟಣದಲ್ಲಿ ಖೇಡ್ಯಗಳನ್ನೂ, ಈಟಿಗಳನ್ನೂ ಇಟ್ಟು ಯೆಹೂದ ಬೆನ್ಯಾಮೀನವರು ಅವನ ಕಡೆ ಇದ್ದುದರಿಂದ, ಅವುಗಳನ್ನು ಭದ್ರಪಡಿಸಿದನು.<verse eid="2CH 11:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="2CH 11:13"/>ಸಮಸ್ತ ಇಸ್ರಾಯೇಲಿನಲ್ಲಿದ್ದ ಯಾಜಕರೂ, ಲೇವಿಯರೂ ತಮ್ಮ ಸಮಸ್ತ ಪ್ರಾಂತಗಳಿಂದ ಅವನ ಬಳಿಗೆ ಪುನಃ ಬಂದರು. <verse eid="2CH 11:13"/><verse number="14" style="v" sid="2CH 11:14"/>ಲೇವಿಯರು ತಮ್ಮ ಹುಲ್ಲುಗಾವಲು ಮತ್ತು ಆಸ್ತಿಯನ್ನು ತ್ಯಜಿಸಿ ಯೆಹೂದ ಮತ್ತು ಯೆರೂಸಲೇಮಿಗೆ ಬಂದರು, ಏಕೆಂದರೆ ಯಾರೊಬ್ಬಾಮನೂ ಅವನ ಮಕ್ಕಳು ಯೆಹೋವ ದೇವರಿಗೆ ಯಾಜಕ ಸೇವೆ ಮಾಡದ ಹಾಗೆ ತಿರಸ್ಕರಿಸಿದನು. <verse eid="2CH 11:14"/><verse number="15" style="v" sid="2CH 11:15"/>ಉನ್ನತ ಸ್ಥಳಗಳಿಗೋಸ್ಕರವೂ ದೆವ್ವಗಳಿಗೋಸ್ಕರವೂ, ಯಾರೊಬ್ಬಾಮನು ಮಾಡಿದ ಕರುಗಳ ಮೂರ್ತಿಪೂಜೆಗಾಗಿ ತಾನೇ ಯಾಜಕರನ್ನು ನೇಮಿಸಿದ್ದರಿಂದ, <verse eid="2CH 11:15"/><verse number="16" style="v" sid="2CH 11:16"/>ಇಸ್ರಾಯೇಲಿನ ದೇವರಾದ ಯೆಹೋವ ದೇವರನ್ನು ಹುಡುಕುವ ಮನಸ್ಸು ಮಾಡಿದ ಇಸ್ರಾಯೇಲಿನ ಪ್ರತಿಯೊಂದು ಕುಲಗಳಿಂದ ಕೆಲವರು ತಮ್ಮ ಪೂರ್ವಜರ ದೇವರಾದ ಯೆಹೋವ ದೇವರಿಗೆ ಯಜ್ಞಗಳನ್ನು ಅರ್ಪಿಸಲು ಲೇವಿಯರನ್ನು ಹಿಂಬಾಲಿಸಿ ಯೆರೂಸಲೇಮಿಗೆ ಬಂದರು. <verse eid="2CH 11:16"/><verse number="17" style="v" sid="2CH 11:17"/>ಹೀಗೆ ಅವರು ಯೆಹೂದ ರಾಜ್ಯವನ್ನು ದೃಢಪಡಿಸಿ, ಸೊಲೊಮೋನನ ಮಗ ರೆಹಬ್ಬಾಮನನ್ನು ಮೂರು ವರ್ಷಗಳವರೆಗೂ ಬಲಪಡಿಸಿದರು. ಅವರು ಮೂರು ವರ್ಷಗಳವರೆಗೂ ದಾವೀದನ, ಸೊಲೊಮೋನನ ಮಾರ್ಗದಲ್ಲಿ ನಡೆದರು.<verse eid="2CH 11:17"/></para>
  <para style="s1">ರೆಹಬ್ಬಾಮನ ಕುಟುಂಬ</para>
  <para style="p">
    <verse number="18" style="v" sid="2CH 11:18"/>ರೆಹಬ್ಬಾಮನು ಮಹಲತ್ ಎಂಬಾಕೆಯನ್ನು ಮದುವೆಮಾಡಿಕೊಂಡನು. ಈ ಮಹಲತ್ ದಾವೀದನ ಮಗ ಯೆರೀಮೋತ್ ಹಾಗು ಅಬೀಹೈಲರ ಮಗಳು. ಈ ಅಬೀಹೈಲಳು ಇಷಯನ ಮೊಮ್ಮಗಳೂ, ಎಲೀಯಾಬನ ಮಗಳೂ ಆಗಿದ್ದಳು. <verse eid="2CH 11:18"/><verse number="19" style="v" sid="2CH 11:19"/>ಅಬೀಹಾಯಿಲಳು ಯೆಗೂಷ್, ಶೆಮರ್ಯ, ಜಹಾಮ್ ಎಂಬ ಮಕ್ಕಳನ್ನು ಅವನಿಗೆ ಹೆತ್ತಳು. <verse eid="2CH 11:19"/><verse number="20" style="v" sid="2CH 11:20"/>ಇವಳ ತರುವಾಯ ಅವನು ಅಬ್ಷಾಲೋಮನ ಮಗಳಾದ ಮಾಕ ಎಂಬವಳನ್ನು ಮದುವೆಮಾಡಿಕೊಂಡನು. ಇವಳು ಅವನಿಗೆ ಅಬೀಯನನ್ನೂ, ಅತ್ತೈಯನ್ನೂ, ಜೀಜನನ್ನೂ, ಶೆಲೋಮೀತನನ್ನೂ ಹೆತ್ತಳು. <verse eid="2CH 11:20"/><verse number="21" style="v" sid="2CH 11:21"/>ರೆಹಬ್ಬಾಮನಿಗೆ ಹದಿನೆಂಟು ಮಂದಿ ಹೆಂಡತಿಯರೂ, ಅರವತ್ತು ಮಂದಿ ಉಪಪತ್ನಿಯರೂ ಇದ್ದರು. ಅವನು ಇಪ್ಪತ್ತೆಂಟು ಮಂದಿ ಪುತ್ರರನ್ನೂ, ಅರವತ್ತು ಮಂದಿ ಪುತ್ರಿಯರನ್ನೂ ಪಡೆದನು. ಆದರೆ ಅವನು ತನ್ನ ಎಲ್ಲಾ ಹೆಂಡತಿಯರಿಗಿಂತಲೂ, ಉಪಪತ್ನಿಯರಿಗಿಂತಲೂ ಅಬ್ಷಾಲೋಮನ ಮಗಳಾದ ಮಾಕ ಎಂಬವಳನ್ನು ಹೆಚ್ಚಾಗಿ ಪ್ರೀತಿಮಾಡಿದನು.<verse eid="2CH 11:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="2CH 11:22"/>ರೆಹಬ್ಬಾಮನು ಮಾಕ ಎಂಬವಳ ಮಗನಾದ ಅಬೀಯನನ್ನು ಅವನ ಸಹೋದರರಲ್ಲಿ ಯುವರಾಜನನ್ನಾಗಿ ಮಾಡಿದನು. ಏಕೆಂದರೆ ಅವನನ್ನು ಅರಸನಾಗಿ ಮಾಡಲು ಮನಸ್ಸುಳ್ಳವನಾಗಿದ್ದನು. <verse eid="2CH 11:22"/><verse number="23" style="v" sid="2CH 11:23"/>ಇದಲ್ಲದೆ ಅವನು ವಿವೇಕವಾಗಿ ನಡೆದು ತನ್ನ ಎಲ್ಲಾ ಮಕ್ಕಳನ್ನು ಯೆಹೂದ ಬೆನ್ಯಾಮೀನಿನ ದೇಶಗಳಲ್ಲಿ ಇರುವ ಎಲ್ಲಾ ಬಲವಾದ ಪಟ್ಟಣಗಳಲ್ಲಿ ಚದರಿಸಿ, ಅವರಿಗೆ ಬಹಳ ದವಸಧಾನ್ಯಗಳನ್ನು ಕೊಟ್ಟನು. ಅವರಿಗೆ ಅನೇಕ ಹೆಂಡತಿಯರನ್ನು ಕೊಟ್ಟನು.<verse eid="2CH 11:23"/></para>
  <chapter eid="2CH 11"/>
  <chapter number="12" style="c" sid="2CH 12"/>
  <para style="s1">ಶೀಶಕನು ಯೆರೂಸಲೇಮಿಗೆ ಮುತ್ತಿಗೆ ಹಾಕಿದ್ದು</para>
  <para style="p">
    <verse number="1" style="v" sid="2CH 12:1"/>ರೆಹಬ್ಬಾಮನು ರಾಜ್ಯವನ್ನು ಸ್ಥಿರಮಾಡಿ ತನ್ನನ್ನು ಬಲಪಡಿಸಿಕೊಂಡಾಗ, ಅವನೂ, ಅವನ ಸಂಗಡ ಸಮಸ್ತ ಇಸ್ರಾಯೇಲರೂ ಯೆಹೋವ ದೇವರ ನಿಯಮವನ್ನು ಬಿಟ್ಟುಬಿಟ್ಟರು. <verse eid="2CH 12:1"/><verse number="2" style="v" sid="2CH 12:2"/>ಅವರು ಯೆಹೋವ ದೇವರಿಗೆ ವಿಶ್ವಾಸದ್ರೋಹಮಾಡಿದ್ದರಿಂದ, ರೆಹಬ್ಬಾಮನು ಅರಸನಾದ ಐದನೆಯ ವರ್ಷದಲ್ಲಿ ಈಜಿಪ್ಟ್ ಅರಸನಾದ ಶೀಶಕನು ಯೆರೂಸಲೇಮಿನ ಮೇಲೆ ದಾಳಿಮಾಡಿದನು. <verse eid="2CH 12:2"/><verse number="3" style="v" sid="2CH 12:3"/>ಅವನ ಸಂಗಡ ಸಾವಿರದ ಇನ್ನೂರು ರಥಗಳೂ, ಅರವತ್ತು ಸಾವಿರ ರಾಹುತರೂ ಇದ್ದರು. ಇದಲ್ಲದೆ ತನ್ನ ಸಂಗಡ ಈಜಿಪ್ಟಿನಿಂದ ಬಂದ ಲಿಬಿಯದವರೂ, ಸುಕ್ಕೀಯರೂ, ಕೂಷ್ಯರೂ ಲೆಕ್ಕವಿಲ್ಲದಷ್ಟು ಬಂದರು. <verse eid="2CH 12:3"/><verse number="4" style="v" sid="2CH 12:4"/>ಅವನು ಯೆಹೂದಕ್ಕೆ ಇದ್ದ ಕೋಟೆಯುಳ್ಳ ಪಟ್ಟಣಗಳನ್ನು ಹಿಡಿದು ಯೆರೂಸಲೇಮಿಗೆ ಬಂದನು.<verse eid="2CH 12:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="2CH 12:5"/>ಆಗ ಪ್ರವಾದಿಯಾದ ಶೆಮಾಯನು ರೆಹಬ್ಬಾಮನ ಬಳಿಗೂ, ಶೀಶಕನ ನಿಮಿತ್ತ ಯೆರೂಸಲೇಮಿನಲ್ಲಿ ಕೂಡಿಕೊಂಡ ಯೆಹೂದದ ಪ್ರಧಾನರ ಬಳಿಗೂ ಬಂದು ಅವರಿಗೆ, “ನೀವು ನನ್ನನ್ನು ಬಿಟ್ಟುಬಿಟ್ಟದ್ದರಿಂದ ನಾನು ನಿಮ್ಮನ್ನು ಶೀಶಕನ ಕೈಯಲ್ಲಿ ಕೊಟ್ಟುಬಿಟ್ಟೆನೆಂದು ಯೆಹೋವ ದೇವರು ನಿಮಗೆ ಹೇಳುತ್ತಾರೆ,” ಎಂದನು.<verse eid="2CH 12:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="2CH 12:6"/>ಆದ್ದರಿಂದ ಇಸ್ರಾಯೇಲಿನ ಪ್ರಧಾನರೂ, ಅರಸನೂ ತಮ್ಮನ್ನು ತಗ್ಗಿಸಿಕೊಂಡು, “ಯೆಹೋವ ದೇವರು ನೀತಿವಂತರು,” ಎಂದರು.<verse eid="2CH 12:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="2CH 12:7"/>ಅವರು ತಮ್ಮನ್ನು ತಗ್ಗಿಸಿಕೊಂಡದ್ದನ್ನು ಯೆಹೋವ ದೇವರು ನೋಡಿದಾಗ, ಯೆಹೋವ ದೇವರ ವಾಕ್ಯವು ಶೆಮಾಯನಿಗೆ ಉಂಟಾಗಿ, “ಅವರು ತಮ್ಮನ್ನು ತಗ್ಗಿಸಿಕೊಂಡದ್ದರಿಂದ ನಾನು ಅವರನ್ನು ನಾಶಮಾಡದೆ, ಅವರು ತಪ್ಪಿಸಿಕೊಳ್ಳುವಂತೆ ಮಾಡುವೆನು. ಶೀಶಕನ ಮುಖಾಂತರ ನನ್ನ ಕೋಪವನ್ನು ಯೆರೂಸಲೇಮಿನ ಮೇಲೆ ಸುರಿದುಬಿಡುವುದಿಲ್ಲ. <verse eid="2CH 12:7"/><verse number="8" style="v" sid="2CH 12:8"/>ಆದರೂ ಅವರು ನನ್ನ ಸೇವೆಗೂ, ದೇಶಗಳ ಅರಸರ ಸೇವೆಗೂ ಇರುವ ವ್ಯತ್ಯಾಸವನ್ನು ಇವರು ತಿಳಿಯುವ ಹಾಗೆ ಅವನಿಗೆ ಸೇವಕರಾಗುವರು,” ಎಂದು ಹೇಳಿದನು.<verse eid="2CH 12:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="2CH 12:9"/>ಈಜಿಪ್ಟಿನ ಅರಸನಾದ ಶೀಶಕನು ಯೆರೂಸಲೇಮಿನ ಮೇಲೆ ದಾಳಿಮಾಡಿ ಯೆಹೋವ ದೇವರ ಆಲಯ ಬೊಕ್ಕಸಗಳನ್ನೂ ಅರಮನೆಯ ಬೊಕ್ಕಸಗಳನ್ನೂ ದೋಚಿಕೊಂಡನು, ಇದಲ್ಲದೆ ಸೊಲೊಮೋನನು ಮಾಡಿಸಿದ ಬಂಗಾರದ ಗುರಾಣಿಗಳನ್ನು ಒಳಗೊಂಡಂತೆ ಅವನು ಸಮಸ್ತವನ್ನೂ ದೋಚಿಕೊಂಡು ಹೋದನು. <verse eid="2CH 12:9"/><verse number="10" style="v" sid="2CH 12:10"/>ಆದಕಾರಣ ಅರಸನಾದ ರೆಹಬ್ಬಾಮನು ಅವುಗಳಿಗೆ ಬದಲಾಗಿ ಕಂಚಿನ ಗುರಾಣಿಗಳನ್ನು ಮಾಡಿಸಿ, ಅವುಗಳನ್ನು ಅರಮನೆಯ ಪ್ರವೇಶದ್ವಾರದ ಕರ್ತವ್ಯದಲ್ಲಿದ್ದ ಕಾವಲುಗಾರರ ಅಧಿಪತಿಗಳ ಕೈಯಲ್ಲಿ ಒಪ್ಪಿಸಿದನು. <verse eid="2CH 12:10"/><verse number="11" style="v" sid="2CH 12:11"/>ಅರಸನು ಯೆಹೋವ ದೇವರ ಆಲಯಕ್ಕೆ ಹೋಗುವಾಗಲೆಲ್ಲಾ, ಕಾವಲುಗಾರರು ಅವುಗಳನ್ನು ಎತ್ತಿಕೊಂಡು ಬರುತ್ತಿದ್ದರು. ಅಲ್ಲಿಂದ ಹಿಂದಕ್ಕೆ ಬಂದ ನಂತರ ಕಾವಲಿನ ಚಾವಡಿಗೆ ತರುತ್ತಿದ್ದರು.<verse eid="2CH 12:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="2CH 12:12"/>ರೆಹಬ್ಬಾಮನು ತನ್ನನ್ನು ತಗ್ಗಿಸಿಕೊಂಡಾಗ, ಯೆಹೋವ ದೇವರ ಕೋಪವು ಅವನನ್ನು ಬಿಟ್ಟು ತಿರುಗಿತು. ಆತನು ಪೂರ್ಣವಾಗಿ ನಾಶಮಾಡಲಿಲ್ಲ. ಯೆಹೂದದಲ್ಲಿ ಸಹ ಕೆಲವು ಕಾರ್ಯಗಳು ಸುಲಕ್ಷಣಗಳು ಕಂಡುಬಂದವು.<verse eid="2CH 12:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="2CH 12:13"/>ಅರಸನಾದ ರೆಹಬ್ಬಾಮನು ಯೆರೂಸಲೇಮಿನಲ್ಲಿ ತನ್ನನ್ನು ಬಲಪಡಿಸಿಕೊಂಡು ರಾಜ್ಯವನ್ನು ಆಳಿದನು. ರೆಹಬ್ಬಾಮನು ಆಳಲು ಆರಂಭಿಸಿದಾಗ, ನಲವತ್ತೊಂದು ವರ್ಷದವನಾಗಿದ್ದು, ಅಲ್ಲಿ ಯೆಹೋವ ದೇವರು ತಮ್ಮ ಹೆಸರಿಗೋಸ್ಕರ ಇಸ್ರಾಯೇಲಿನ ಸಮಸ್ತ ಗೋತ್ರಗಳಲ್ಲಿ ಆಯ್ದುಕೊಂಡ ಪಟ್ಟಣವಾದ ಯೆರೂಸಲೇಮಿನಲ್ಲಿ ಹದಿನೇಳು ವರ್ಷ ಆಳಿದನು. ಅಮ್ಮೋನಿಯಳಾದ ಅವನ ತಾಯಿಯ ಹೆಸರು ನಯಮಾ. <verse eid="2CH 12:13"/><verse number="14" style="v" sid="2CH 12:14"/>ಅವನು ಯೆಹೋವ ದೇವರನ್ನು ಹುಡುಕಲು ತನ್ನ ಹೃದಯವನ್ನು ಸ್ಥಿರಪಡಿಸದೆ ಇದ್ದುದರಿಂದ, ಕೆಟ್ಟದ್ದನ್ನು ಮಾಡಿದನು.<verse eid="2CH 12:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="2CH 12:15"/>ರೆಹಬ್ಬಾಮನು ಅರಸನಾಗಿದ್ದಾಗ ತನ್ನ ಆಳ್ವಿಕೆಯ ಮೊದಲಿನಿಂದ ಕಡೆಯವರೆಗೆ ಮಾಡಿದ ಕಾರ್ಯಗಳು ಪ್ರವಾದಿಯಾದ ಶೆಮಾಯನ ಪುಸ್ತಕದಲ್ಲಿಯೂ, ವಂಶಾವಳಿಗಳನ್ನು ಕುರಿತು ಬರೆದ ದರ್ಶಿಯಾದ ಇದ್ದೋವನ ಪುಸ್ತಕದಲ್ಲಿಯೂ ಬರೆದಿರುತ್ತವೆ. ಇದಲ್ಲದೆ ರೆಹಬ್ಬಾಮನಿಗೂ, ಯಾರೊಬ್ಬಾಮನಿಗೂ ಯಾವಾಗಲೂ ಯುದ್ಧಗಳಾಗುತ್ತಿದ್ದವು. <verse eid="2CH 12:15"/><verse number="16" style="v" sid="2CH 12:16"/>ರೆಹಬ್ಬಾಮನು ಮೃತನಾಗಿ ತನ್ನ ಪಿತೃಗಳ ಬಳಿ ಸೇರಿದನು. ಅವನ ಶವವನ್ನು ದಾವೀದನ ಪಟ್ಟಣದಲ್ಲಿ ಸಮಾಧಿಮಾಡಿದರು. ಅವನ ಮಗ ಅಬೀಯನು ಅವನಿಗೆ ಬದಲಾಗಿ ಅರಸನಾದನು.<verse eid="2CH 12:16"/></para>
  <chapter eid="2CH 12"/>
  <chapter number="13" style="c" sid="2CH 13"/>
  <para style="s1">ಯೆಹೂದ್ಯರ ಅರಸನಾದ ಅಬೀಯನು</para>
  <para style="p">
    <verse number="1" style="v" sid="2CH 13:1"/>ಅರಸನಾದ ಯಾರೊಬ್ಬಾಮನ ಆಳಿಕೆಯ ಹದಿನೆಂಟನೆಯ ವರ್ಷದಲ್ಲಿ ಅಬೀಯನು ಯೆಹೂದದ ಅರಸನಾಗಿ, <verse eid="2CH 13:1"/><verse number="2" style="v" sid="2CH 13:2"/>ಯೆರೂಸಲೇಮಿನಲ್ಲಿ ಮೂರು ವರ್ಷ ಆಳಿದನು. ಅವನ ತಾಯಿಯ ಹೆಸರು ಮೀಕಾಯ, ಇವಳು ಗಿಬೆಯದ ಉರಿಯೇಲನ ಮಗಳು<note caller="+" style="f"><char style="fr" closed="false">13:2 </char><char style="ft" closed="false">ಅಥವಾ </char><char style="fqa" closed="false">ಮೊಮ್ಮಗಳು</char></note>.</para>
  <para style="p" vid="2CH 13:2">ಅಬೀಯನಿಗೂ, ಯಾರೊಬ್ಬಾಮನಿಗೂ ಯುದ್ಧ ಉಂಟಾಗಿತ್ತು. <verse eid="2CH 13:2"/><verse number="3" style="v" sid="2CH 13:3"/>ಆಗ ಅಬೀಯನು ಯುದ್ಧಭಟರಾದ ಪರಾಕ್ರಮಶಾಲಿಗಳ ಸೈನ್ಯವನ್ನು ಯುದ್ಧಕ್ಕೆ ಸಿದ್ಧಮಾಡಿದನು. ಆಯ್ಕೆಯಾದ ನಾಲ್ಕು ಲಕ್ಷ ಜನರಿದ್ದರು. ಯಾರೊಬ್ಬಾಮನು ಅವನಿಗೆ ಎದುರಾಗಿ ಎಂಟು ಲಕ್ಷಮಂದಿ ಆಯ್ಕೆಯಾದ ಪರಾಕ್ರಮಶಾಲಿಗಳನ್ನು ಯುದ್ಧಕ್ಕೆ ನಿಲ್ಲಿಸಿದನು.<verse eid="2CH 13:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="2CH 13:4"/>ಆಗ ಅಬೀಯನು ಎಫ್ರಾಯೀಮ್ ಬೆಟ್ಟದಲ್ಲಿರುವ ಚೆಮಾರಯಿಮ್ ಎಂಬ ಬೆಟ್ಟದ ಮೇಲೆ ನಿಂತು, “ಯಾರೊಬ್ಬಾಮನೇ, ಸಮಸ್ತ ಇಸ್ರಾಯೇಲರೇ, ನನ್ನ ಮಾತು ಕೇಳಿರಿ. <verse eid="2CH 13:4"/><verse number="5" style="v" sid="2CH 13:5"/>ಇಸ್ರಾಯೇಲಿನ ದೇವರಾದ ಯೆಹೋವ ದೇವರು ಇಸ್ರಾಯೇಲಿನ ಮೇಲೆ ರಾಜ್ಯವನ್ನು ಎಂದೆಂದಿಗೂ ದಾವೀದನಿಗೂ, ಅವನ ವಂಶದವರಿಗೂ ಉಪ್ಪಿನ ಒಡಂಬಡಿಕೆಯಿಂದ ಕೊಟ್ಟರೆಂದು ನಿಮಗೆ ಗೊತ್ತಿಲ್ಲವೋ. <verse eid="2CH 13:5"/><verse number="6" style="v" sid="2CH 13:6"/>ಆದರೆ ದಾವೀದನ ಮಗ ಸೊಲೊಮೋನನ ಸೇವಕನಾಗಿದ್ದ ನೆಬಾಟನ ಮಗ ಯಾರೊಬ್ಬಾಮನು ತನ್ನ ಯಜಮಾನನ ಮೇಲೆ ತಿರುಗಿಬಿದ್ದನು. <verse eid="2CH 13:6"/><verse number="7" style="v" sid="2CH 13:7"/>ಇದಲ್ಲದೆ ನಿಷ್ಪ್ರಯೋಜಕರಾದ ದುಷ್ಟರು ಅವನ ಬಳಿಗೆ ಕೂಡಿಬಂದು, ಸೊಲೊಮೋನನ ಮಗ ರೆಹಬ್ಬಾಮನು ಎಳೆಯ ಪ್ರಾಯದವನೂ, ನಿರ್ಣಯಿಸಲಾಗದವನೂ ಅವರನ್ನು ಎದುರಿಸಲು ಬಲವಿಲ್ಲದವನೂ ಆಗಿರುವುದರಿಂದ ಅವನಿಗೆ ವಿರೋಧವಾಗಿ ತಮ್ಮನ್ನು ಬಲಪಡಿಸಿಕೊಂಡರು.<verse eid="2CH 13:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="2CH 13:8"/>“ಈಗ ದಾವೀದನ ವಂಶಜರ ಕೈಯಲ್ಲಿರುವ ಯೆಹೋವ ದೇವರ ರಾಜ್ಯವನ್ನು ಎದುರಿಸುತ್ತೇವೆಂದು ನೀವು ಹೇಳಿಕೊಳ್ಳುತ್ತೀರಿ. ಇದಲ್ಲದೆ ನೀವು ಬಹು ಗುಂಪಾಗಿದ್ದೀರಿ. ಯಾರೊಬ್ಬಾಮನು ದೇವರುಗಳಾಗಿ ನಿಮಗೆ ಮಾಡಿದ ಬಂಗಾರದ ಕರುಗಳು ನಿಮ್ಮಲ್ಲಿ ಉಂಟು. <verse eid="2CH 13:8"/><verse number="9" style="v" sid="2CH 13:9"/>ನೀವು ಯೆಹೋವ ದೇವರ ಯಾಜಕರಾದ ಆರೋನನ ವಂಶದವರಾದ ಲೇವಿಯರನ್ನೂ ತಳ್ಳಿ ಹಾಕಿ, ಅನ್ಯದೇಶಗಳ ಜನರಂತೆ ನಿಮಗೆ ಯಾಜಕರನ್ನು ಮಾಡಿಕೊಳ್ಳಲಿಲ್ಲವೋ? ಯಾವನಾದರೂ ದನದ ಮರಿಯಾದ ಹೋರಿಯನ್ನೂ, ಏಳು ಟಗರುಗಳನ್ನೂ ತೆಗೆದುಕೊಂಡು ಬಂದು, ತನ್ನನ್ನು ಪ್ರತಿಷ್ಠೆ ಮಾಡಿದರೆ ಅವನು ದೇವರಲ್ಲದವುಗಳಿಗೆ ಯಾಜಕನಾಗಿರುವನಷ್ಟೇ.<verse eid="2CH 13:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="2CH 13:10"/>“ನಮಗಾದರೋ ಯೆಹೋವ ದೇವರು ದೇವರಾಗಿದ್ದಾರೆ. ನಾವು ಅವರನ್ನು ಬಿಡಲಿಲ್ಲ. ಇದಲ್ಲದೆ ಯೆಹೋವ ದೇವರಿಗೆ ಸೇವೆ ಮಾಡುವ ಯಾಜಕರು ಆರೋನನ ಮಕ್ಕಳು. ಲೇವಿಯರು ಅವರಿಗೆ ಕೆಲಸದಲ್ಲಿ ಸಹಾಯ ಮಾಡುತ್ತಿದ್ದರು. <verse eid="2CH 13:10"/><verse number="11" style="v" sid="2CH 13:11"/>ಅವರು ಪ್ರತಿ ಉದಯದಲ್ಲಿಯೂ, ಪ್ರತಿ ಸಾಯಂಕಾಲದಲ್ಲಿಯೂ ಯೆಹೋವ ದೇವರಿಗೆ ದಹನಬಲಿಗಳನ್ನೂ, ಸುಗಂಧ ಧೂಪವನ್ನೂ ಸುಡುತ್ತಾರೆ. ಇದಲ್ಲದೆ ಪರಿಶುದ್ಧ ಮೇಜಿನ ಮೇಲೆ ರೊಟ್ಟಿಗಳನ್ನು ಇಡುತ್ತಾ, ಪ್ರತಿ ಸಾಯಂಕಾಲದಲ್ಲಿ ಬಂಗಾರದ ದೀಪಸ್ತಂಭವನ್ನೂ, ಅದರ ದೀಪಗಳನ್ನೂ ಸಿದ್ಧಮಾಡಿ ಹಚ್ಚುತ್ತಾ ಇರುತ್ತಾರೆ. ನಾವು ನಮ್ಮ ದೇವರಾದ ಯೆಹೋವ ದೇವರ ಕಟ್ಟಳೆಯನ್ನು ಕೈಗೊಳ್ಳುತ್ತೇವೆ, ಆದರೆ ನೀವು ಅವರನ್ನು ಬಿಟ್ಟಿದ್ದೀರಿ. <verse eid="2CH 13:11"/><verse number="12" style="v" sid="2CH 13:12"/>ದೇವರು ತಾವೇ ಅಧಿಪತಿಯಾಗಿ ನಮ್ಮ ಸಂಗಡ ಇದ್ದಾರೆ. ಇದಲ್ಲದೆ ನಿಮಗೆ ವಿರೋಧವಾಗಿ ಜಯಧ್ವನಿ ಮಾಡುವ ತುತೂರಿಗಳನ್ನು ಹಿಡಿದುಕೊಂಡ ಅವರ ಯಾಜಕರು ನಮಗಿದ್ದಾರೆ. ಇಸ್ರಾಯೇಲರೇ, ನೀವು ನಿಮ್ಮ ಪಿತೃಗಳ ದೇವರಾದ ಯೆಹೋವ ದೇವರಿಗೆ ವಿರೋಧವಾಗಿ ಯುದ್ಧಮಾಡಬೇಡಿರಿ. ನೀವು ಜಯಹೊಂದುವುದಿಲ್ಲ,” ಎಂದನು.<verse eid="2CH 13:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="2CH 13:13"/>ಆದರೆ ಯಾರೊಬ್ಬಾಮನು ಅಡಗಿಕೊಂಡವರನ್ನು ಸುತ್ತಲೂ ಅವರ ಹಿಂದೆ ಬರಮಾಡಿದನು. ಆದ್ದರಿಂದ ಇಸ್ರಾಯೇಲರು ಯೆಹೂದದವರ ಮುಂದೆಯೂ, ಅವರ ಹಿಂದೆಯೂ ಬಂದರು. <verse eid="2CH 13:13"/><verse number="14" style="v" sid="2CH 13:14"/>ಯೆಹೂದದವರು ಹಿಂದಕ್ಕೆ ನೋಡಿದಾಗ, ಯುದ್ಧವು ಅವರ ಮುಂದೆಯೂ ಹಿಂದೆಯೂ ಇತ್ತು. ಆಗ ಯೆಹೋವ ದೇವರಿಗೆ ಅವರು ಮೊರೆಯಿಟ್ಟರು. ಯಾಜಕರು ತುತೂರಿಗಳನ್ನು ಊದಿದರು. <verse eid="2CH 13:14"/><verse number="15" style="v" sid="2CH 13:15"/>ಆಗ ಯೆಹೂದ್ಯರು ಆರ್ಭಟಿಸಿದರು. ಯೆಹೂದ್ಯರು ಆರ್ಭಟಿಸಿದಾಗ, ದೇವರು ಅಬೀಯನ ಮತ್ತು ಯೆಹೂದದವರ ಮುಂದೆ ಯಾರೊಬ್ಬಾಮನನ್ನೂ, ಸಮಸ್ತ ಇಸ್ರಾಯೇಲರನ್ನೂ ಅಪಜಯಗೊಳಿಸಿದರು. <verse eid="2CH 13:15"/><verse number="16" style="v" sid="2CH 13:16"/>ಇಸ್ರಾಯೇಲರು ಯೆಹೂದದವರ ಎದುರಿನಿಂದ ಓಡಿಹೋದರು. ಹೀಗೆ ದೇವರು ಇಸ್ರಾಯೇಲರನ್ನು ಯೆಹೂದದವರ ಕೈಯಲ್ಲಿ ಒಪ್ಪಿಸಿದರು. <verse eid="2CH 13:16"/><verse number="17" style="v" sid="2CH 13:17"/>ಅಬೀಯನೂ, ಅವನ ಜನರೂ ಅವರಲ್ಲಿ ಬಹಳ ಮಂದಿಯನ್ನು ಹತಮಾಡಿದರು. ಇಸ್ರಾಯೇಲರಲ್ಲಿ ಐದು ಲಕ್ಷಮಂದಿ ಬಲಶಾಲಿಗಳಾದ ಸೈನಿಕರು ಹತರಾದರು. <verse eid="2CH 13:17"/><verse number="18" style="v" sid="2CH 13:18"/>ಹೀಗೆ ಆ ಕಾಲದಲ್ಲಿ ಇಸ್ರಾಯೇಲರು ತಗ್ಗಿಹೋದರು. ಆದರೆ ಯೆಹೂದದವರು ತಮ್ಮ ಪಿತೃಗಳ ದೇವರಾದ ಯೆಹೋವ ದೇವರ ಮೇಲೆ ಆತುಕೊಂಡದ್ದರಿಂದ ಜಯ ಹೊಂದಿದರು.<verse eid="2CH 13:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="2CH 13:19"/>ಅಬೀಯನು ಯಾರೊಬ್ಬಾಮನನ್ನು ಹಿಂದಟ್ಟಿ ಅವನಿಂದ ಬೇತೇಲ್, ಯೆಷಾನಾ, ಎಫ್ರೋನ್ ಎಂಬ ಪಟ್ಟಣಗಳನ್ನೂ, ಅವುಗಳ ಗ್ರಾಮಗಳನ್ನೂ ವಶಪಡಿಸಿಕೊಂಡನು. <verse eid="2CH 13:19"/><verse number="20" style="v" sid="2CH 13:20"/>ಯಾರೊಬ್ಬಾಮನು ಅಬೀಯನ ಜೀವಮಾನದಲ್ಲಿ ತಿರುಗಿ ಬಲಗೊಳ್ಳಲಿಲ್ಲ. ಯೆಹೋವ ದೇವರ ಶಿಕ್ಷೆಯಿಂದ ಯಾರೊಬ್ಬಾಮನು ಸತ್ತನು.<verse eid="2CH 13:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="2CH 13:21"/>ಅಬೀಯನು ಪ್ರಬಲನಾದನು. ಅವನಿಗೆ ಹದಿನಾಲ್ಕು ಮಂದಿ ಹೆಂಡತಿಯರೂ, ಇಪ್ಪತ್ತೆರಡು ಮಂದಿ ಪುತ್ರರೂ, ಹದಿನಾರು ಮಂದಿ ಪುತ್ರಿಯರೂ ಇದ್ದರು.<verse eid="2CH 13:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="2CH 13:22"/>ಅಬೀಯನ ಮಿಕ್ಕಾದ ಕ್ರಿಯೆಗಳೂ, ಅವನ ನಡೆನುಡಿಗಳ ಮಾತುಗಳೂ ಪ್ರವಾದಿಯಾದ ಇದ್ದೋವನ ವರ್ತಮಾನಗಳಲ್ಲಿ ಬರೆದಿರುತ್ತವೆ.<verse eid="2CH 13:22"/></para>
  <chapter eid="2CH 13"/>
  <chapter number="14" style="c" sid="2CH 14"/>
  <para style="p">
    <verse number="1" style="v" sid="2CH 14:1"/>ಅಬೀಯನು ಮೃತನಾಗಿ ತನ್ನ ಪಿತೃಗಳ ಬಳಿಗೆ ಸೇರಿದನು, ಅವನ ಶವವನ್ನು ದಾವೀದನ ಪಟ್ಟಣದಲ್ಲಿ ಸಮಾಧಿಮಾಡಿದರು. ಅವನ ಮಗ ಆಸನು ಅವನಿಗೆ ಬದಲಾಗಿ ಅರಸನಾದನು, ಅವನ ದಿವಸಗಳಲ್ಲಿ ಹತ್ತು ವರ್ಷ ದೇಶವು ಶಾಂತವಾಗಿತ್ತು.<verse eid="2CH 14:1"/></para>
  <para style="s1">ಯೆಹೂದ್ಯರ ಅರಸನಾದ ಆಸನು</para>
  <para style="p">
    <verse number="2" style="v" sid="2CH 14:2"/>ಆಸನು ತನ್ನ ದೇವರಾದ ಯೆಹೋವ ದೇವರ ದೃಷ್ಟಿಯಲ್ಲಿ ಒಳ್ಳೆಯದನ್ನೂ, ಸರಿಯಾದದ್ದನ್ನೂ ಮಾಡಿದನು. <verse eid="2CH 14:2"/><verse number="3" style="v" sid="2CH 14:3"/>ಅವನು ಅನ್ಯದೇವರುಗಳ ಬಲಿಪೀಠಗಳನ್ನೂ, ಉನ್ನತ ಪೂಜಾಸ್ಥಳಗಳನ್ನೂ ತೆಗೆದುಹಾಕಿ, ವಿಗ್ರಹಗಳನ್ನು ಒಡೆದುಬಿಟ್ಟು, ಅವುಗಳ ಅಶೇರ ಸ್ತಂಭಗಳನ್ನು ಕಡಿದುಹಾಕಿದನು. <verse eid="2CH 14:3"/><verse number="4" style="v" sid="2CH 14:4"/>ತಮ್ಮ ಪಿತೃಗಳ ದೇವರಾದ ಯೆಹೋವ ದೇವರನ್ನು ಹುಡುಕಲೂ, ನಿಯಮವನ್ನೂ, ಆಜ್ಞೆಯನ್ನೂ ಕೈಗೊಳ್ಳಲು ಯೆಹೂದ್ಯರಿಗೆ ಆಜ್ಞಾಪಿಸಿದನು. <verse eid="2CH 14:4"/><verse number="5" style="v" sid="2CH 14:5"/>ಇದಲ್ಲದೆ ಅವನು ಉನ್ನತ ಪೂಜಾಸ್ಥಳಗಳನ್ನೂ, ವಿಗ್ರಹಗಳನ್ನೂ ಯೆಹೂದದ ಸಮಸ್ತ ಪಟ್ಟಣಗಳಿಂದ ತೆಗೆದುಹಾಕಿದನು. ರಾಜ್ಯವು ಶಾಂತವಾಗಿತ್ತು. <verse eid="2CH 14:5"/><verse number="6" style="v" sid="2CH 14:6"/>ಇದಲ್ಲದೆ ಅವನು ಯೆಹೂದದಲ್ಲಿ ಕೋಟೆಗಳುಳ್ಳ ಪಟ್ಟಣಗಳನ್ನು ಕಟ್ಟಿದನು. ಏಕೆಂದರೆ ದೇಶವು ಶಾಂತವಾಗಿತ್ತು. ಯೆಹೋವ ದೇವರು ಅವನಿಗೆ ವಿಶ್ರಾಂತಿ ಕೊಟ್ಟದ್ದರಿಂದ ಆ ವರ್ಷಗಳಲ್ಲಿ ಅವನಿಗೆ ಯುದ್ಧವಿರಲಿಲ್ಲ.<verse eid="2CH 14:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="2CH 14:7"/>ಅವನು ಯೆಹೂದದವರಿಗೆ, “ದೇಶವು ನಮ್ಮ ಮುಂದೆ ಇರುವಾಗ ಈ ಪಟ್ಟಣಗಳನ್ನು ಕಟ್ಟಿ, ಅವುಗಳ ಸುತ್ತಲೂ ಗೋಡೆಗಳನ್ನೂ, ಗೋಪುರಗಳನ್ನೂ, ಬಾಗಿಲುಗಳನ್ನೂ, ಅಗುಳಿಗಳನ್ನೂ ಮಾಡೋಣ. ಏಕೆಂದರೆ ನಾವು ನಮ್ಮ ದೇವರಾದ ಯೆಹೋವ ದೇವರನ್ನು ಹುಡುಕಿದೆವು. ನಾವು ಅವರನ್ನು ಹುಡುಕಿದ್ದರಿಂದ ಅವರು ಎಲ್ಲಾ ಕಡೆಯಲ್ಲಿಯೂ ನಮಗೆ ವಿಶ್ರಾಂತಿಯನ್ನು ಕೊಟ್ಟಿದ್ದಾರೆ,” ಎಂದನು. ಹಾಗೆಯೇ ಅವರು ಸೈನ್ಯವನ್ನು ಕಟ್ಟಿ ವೃದ್ಧಿಹೊಂದಿದರು.<verse eid="2CH 14:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="2CH 14:8"/>ಇದಲ್ಲದೆ ಆಸನಿಗೆ ದೊಡ್ಡ ಗುರಾಣಿಗಳನ್ನೂ, ಈಟಿಗಳನ್ನೂ ಹಿಡಿಯುವ ಸೈನ್ಯವಿತ್ತು. ಯೆಹೂದದವರು ಮೂರು ಲಕ್ಷ ಮಂದಿಯೂ, ಬೆನ್ಯಾಮೀನವರಲ್ಲಿ ಚಿಕ್ಕ ಗುರಾಣಿಗಳನ್ನು ಹಿಡಿಯುವ, ಬಿಲ್ಲುಗಳನ್ನು ಎಸೆಯುವ ಎರಡು ಲಕ್ಷದ ಎಂಬತ್ತು ಸಾವಿರ ಮಂದಿಯೂ ಇದ್ದರು. ಇವರೆಲ್ಲರು ಪರಾಕ್ರಮಶಾಲಿ ಯುದ್ಧವೀರರಾಗಿದ್ದರು.<verse eid="2CH 14:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="2CH 14:9"/>ಆದರೆ ಕೂಷ್ಯನಾದ ಜೆರಹನು ಅವರಿಗೆ ವಿರೋಧವಾಗಿ ಹೊರಟು, ಮಾರೇಷಾದ ಮಟ್ಟಿಗೂ ಬಂದನು. ಅವನ ಸಂಗಡ ಹತ್ತು ಲಕ್ಷ ಜನ ಯುದ್ಧವೀರರೂ, ಮುನ್ನೂರು ರಥಗಳೂ ಇದ್ದವು. <verse eid="2CH 14:9"/><verse number="10" style="v" sid="2CH 14:10"/>ಆಸನು ಅವನಿಗೆದುರಾಗಿ ಹೊರಟುಹೋದನು. ಮಾರೇಷಾದ ಬಳಿಯಲ್ಲಿ ಚೆಫಾತಾದ ತಗ್ಗಿನಲ್ಲಿ ವ್ಯೂಹ ಕಟ್ಟಿದರು.<verse eid="2CH 14:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="2CH 14:11"/>ಆಗ ಆಸನು ತನ್ನ ದೇವರಾದ ಯೆಹೋವ ದೇವರನ್ನು ಪ್ರಾರ್ಥಿಸಿ, “ಯೆಹೋವ ದೇವರೇ, ಅನೇಕರ ಮಧ್ಯದಲ್ಲಿ ಬಲಹೀನರಿಗೆ ಸಹಾಯ ಕೊಡುವುದು ನಿಮಗೆ ಏನೂ ಅಲ್ಲ. ನಮ್ಮ ದೇವರಾದ ಯೆಹೋವ ದೇವರೇ, ನಮಗೆ ಸಹಾಯಮಾಡಿರಿ. ಏಕೆಂದರೆ ನಾವು ನಿಮ್ಮ ಮೇಲೆ ಆತುಕೊಂಡಿದ್ದೇವೆ. ನಿಮ್ಮ ಹೆಸರಿನಲ್ಲಿ ನಾವು ಈ ಗುಂಪಿನ ಮೇಲೆ ಹೋಗುತ್ತೇವೆ. ಯೆಹೋವ ದೇವರೇ, ನೀವೇ ನಮ್ಮ ದೇವರು. ಮನುಷ್ಯನು ನಿಮ್ಮೆದುರಿನಲ್ಲಿ ಬಲಗೊಳ್ಳದಿರಲಿ,” ಎಂದನು.<verse eid="2CH 14:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="2CH 14:12"/>ಆಗ ಯೆಹೋವ ದೇವರು ಕೂಷ್ಯರನ್ನು ಆಸನ ಮುಂದೆಯೂ, ಯೆಹೂದದವರ ಮುಂದೆಯೂ ಸೋಲುವಂತೆ ಮಾಡಿದರು. ಆದ್ದರಿಂದ ಕೂಷ್ಯರು ಓಡಿಹೋದರು. <verse eid="2CH 14:12"/><verse number="13" style="v" sid="2CH 14:13"/>ಆಗ ಆಸನೂ, ಅವನ ಸಂಗಡ ಇದ್ದ ಜನರೂ ಅವರನ್ನು ಗೆರಾರಿನವರೆಗೂ ಹಿಂದಟ್ಟಿದರು. ಹೆಚ್ಚಿನ ಸಂಖ್ಯೆಯಲ್ಲಿ ಕೂಷ್ಯರು ಸೋತುಹೋದರು. ಅವರು ಯೆಹೋವ ದೇವರ ಮುಂದೆಯೂ, ಅವರ ಸೈನ್ಯದ ಮುಂದೆಯೂ ನಾಶವಾದರು. ಯೆಹೂದ್ಯರು ಬಹು ಕೊಳ್ಳೆಯನ್ನು ಒಯ್ದರು. <verse eid="2CH 14:13"/><verse number="14" style="v" sid="2CH 14:14"/>ಇದಲ್ಲದೆ ಅವರು ಗೆರಾರಿನ ಸುತ್ತಲಿರುವ ಸಮಸ್ತ ಪಟ್ಟಣಗಳನ್ನು ವಶಪಡಿಸಿಕೊಂಡರು. ಯೆಹೋವ ದೇವರ ಭಯವು ಅವರ ಮೇಲೆ ಇತ್ತು. ಆ ಪಟ್ಟಣಗಳಲ್ಲಿ ಬಹು ಕೊಳ್ಳೆ ಇದ್ದುದರಿಂದ, ಅವುಗಳನ್ನೆಲ್ಲಾ ವಶಪಡಿಸಿಕೊಂಡರು. <verse eid="2CH 14:14"/><verse number="15" style="v" sid="2CH 14:15"/>ಪಶುಗಳಿದ್ದ ಡೇರೆಗಳನ್ನೂ, ಕುರಿಗಳನ್ನೂ, ಒಂಟೆಗಳನ್ನೂ ಬಹಳವಾಗಿ ತೆಗೆದುಕೊಂಡು ಯೆರೂಸಲೇಮಿಗೆ ತಿರುಗಿ ಬಂದರು.<verse eid="2CH 14:15"/></para>
  <chapter eid="2CH 14"/>
  <chapter number="15" style="c" sid="2CH 15"/>
  <para style="s1">ಆಸನು ಭಕ್ತಿಸಂಜೀವನವನ್ನು ತಂದದ್ದು</para>
  <para style="p">
    <verse number="1" style="v" sid="2CH 15:1"/>ಆಗ ದೇವರ ಆತ್ಮವು ಓದೇದನ ಮಗನಾದ ಅಜರ್ಯನ ಮೇಲೆ ಬಂದದ್ದರಿಂದ, <verse eid="2CH 15:1"/><verse number="2" style="v" sid="2CH 15:2"/>ಅವನು ಆಸನನ್ನು ಎದುರುಗೊಳ್ಳಲು ಹೊರಟುಬಂದು, ಅವನಿಗೆ, “ಆಸನೇ, ಯೆಹೂದ ಮತ್ತು ಬೆನ್ಯಾಮೀನ್ ಗೋತ್ರದವರೇ, ನನ್ನ ಮಾತನ್ನು ಕೇಳಿರಿ. ನೀವು ಯೆಹೋವ ದೇವರ ಸಂಗಡ ಇರುವವರೆಗೂ, ಅವರು ನಿಮ್ಮ ಸಂಗಡ ಇರುವರು. ನೀವು ಅವರನ್ನು ಹುಡುಕಿದರೆ ಅವರು ನಿಮಗೆ ಸಿಕ್ಕುವರು. ಆದರೆ ನೀವು ಅವರನ್ನು ಬಿಟ್ಟುಬಿಟ್ಟರೆ ಅವರು ನಿಮ್ಮನ್ನು ಬಿಟ್ಟುಬಿಡುವರು <verse eid="2CH 15:2"/><verse number="3" style="v" sid="2CH 15:3"/>ಬಹುಕಾಲ ಇಸ್ರಾಯೇಲರು ನಿಜವಾದ ದೇವರಿಲ್ಲದೆ ಬೋಧಿಸುವ ಯಾಜಕನಿಲ್ಲದೆ, ನಿಯಮವಿಲ್ಲದೆ ಇದ್ದರು. <verse eid="2CH 15:3"/><verse number="4" style="v" sid="2CH 15:4"/>ಅವರು ತಮ್ಮ ಇಕ್ಕಟ್ಟಿನಲ್ಲಿ ಇಸ್ರಾಯೇಲಿನ ದೇವರಾದ ಯೆಹೋವ ದೇವರ ಕಡೆಗೆ ತಿರುಗಿ ಅವರನ್ನು ಹುಡುಕಿದಾಗ ಅವರಿಗೆ ದೇವರು ಸಿಕ್ಕಿದರು. <verse eid="2CH 15:4"/><verse number="5" style="v" sid="2CH 15:5"/>ಆ ಕಾಲಗಳಲ್ಲಿ ಹೊರಗೆ ಹೋಗುವವನಿಗೂ, ಒಳಗೆ ಬರುವವನಿಗೂ ಸಮಾಧಾನವಿಲ್ಲದೆ ಇತ್ತು. ದೇಶದ ನಿವಾಸಿಗಳು ಬಹಳವಾಗಿ ಹೆದರಿದ್ದರು. <verse eid="2CH 15:5"/><verse number="6" style="v" sid="2CH 15:6"/>ಜನಾಂಗವು ಜನಾಂಗದಿಂದಲೂ, ಪಟ್ಟಣವು ಪಟ್ಟಣದಿಂದಲೂ ನಾಶವಾಯಿತು. ದೇವರು ಸಕಲ ಇಕ್ಕಟ್ಟುಗಳಿಂದ ಅವರನ್ನು ತೊಂದರೆಪಡಿಸಿದರು. <verse eid="2CH 15:6"/><verse number="7" style="v" sid="2CH 15:7"/>ಆದ್ದರಿಂದ ನೀವು ಬಲಗೊಳ್ಳಿರಿ. ನಿಮ್ಮ ಕೈಗಳು ಬಲಹೀನವಾಗದೆ ಇರಲಿ. ನಿಮ್ಮ ಕೆಲಸಕ್ಕೆ ಪ್ರತಿಫಲ ಸಿಕ್ಕುವುದು,” ಎಂದನು.<verse eid="2CH 15:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="2CH 15:8"/>ಆಸನು ಆ ಮಾತುಗಳನ್ನೂ, ಪ್ರವಾದಿಯಾದ ಓದೇದನ ಮಗ ಅಜರ್ಯನ ಪ್ರವಾದನಾ ಮಾತುಗಳನ್ನೂ ಕೇಳಿದಾಗ, ಅವನು ಬಲಗೊಂಡು ಯೆಹೂದ ಬೆನ್ಯಾಮೀನಿನ ಸಮಸ್ತ ದೇಶದೊಳಗಿಂದಲೂ, ಎಫ್ರಾಯೀಮನ ಬೆಟ್ಟದಲ್ಲಿ ತಾನು ಹಿಡಿದ ಪಟ್ಟಣಗಳೊಳಗಿಂದಲೂ ಅಸಹ್ಯ ವಿಗ್ರಹಗಳನ್ನು ತೆಗೆದುಹಾಕಿ, ಯೆಹೋವ ದೇವರ ದ್ವಾರಾಂಗಳದ ಮುಂದೆ ಇದ್ದ ಯೆಹೋವ ದೇವರ ಬಲಿಪೀಠವನ್ನು ನೂತನಪಡಿಸಿದನು.<verse eid="2CH 15:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="2CH 15:9"/>ತರುವಾಯ ಆಸನು ಎಲ್ಲಾ ಯೆಹೂದ ಹಾಗೂ ಬೆನ್ಯಾಮೀನ್ ಕುಲಗಳವರನ್ನು ಬರಮಾಡಿದನು. ಯೆಹೂದ ದೇಶದಲ್ಲಿ ನೆಲೆಸಿದ್ದ ಎಫ್ರಾಯೀಮ್, ಮನಸ್ಸೆ ಹಾಗೂ ಸಿಮೆಯೋನ್ ಕುಲಗಳವರನ್ನು ಸಹ ಕರೆಸಿಕೊಂಡನು. ಅವನ ದೇವರಾದ ಯೆಹೋವ ದೇವರು ಅವನ ಸಂಗಡ ಇದ್ದಾರೆಂದು ಇವರು ಕಂಡಾಗ, ಇಸ್ರಾಯೇಲಿನೊಳಗಿಂದ ಅನೇಕರು ಅವನ ಕಡೆಗೆ ಬಂದಿದ್ದರು.<verse eid="2CH 15:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="2CH 15:10"/>ಹೀಗೆಯೇ ಆಸನ ಆಳಿಕೆಯ ಹದಿನೈದನೆಯ ವರ್ಷದ ಮೂರನೆಯ ತಿಂಗಳಿನಲ್ಲಿ ಅವರು ಯೆರೂಸಲೇಮಿನಲ್ಲಿ ಕೂಡಿಕೊಂಡರು. <verse eid="2CH 15:10"/><verse number="11" style="v" sid="2CH 15:11"/>ಅದೇ ಕಾಲದಲ್ಲಿ ತಾವು ತಂದ ಕೊಳ್ಳೆಯಿಂದ ಏಳು ನೂರು ಹೋರಿಗಳನ್ನೂ, ಏಳು ಸಾವಿರ ಕುರಿಗಳನ್ನೂ ಯೆಹೋವ ದೇವರಿಗೆ ಬಲಿ ಅರ್ಪಿಸಿದರು. <verse eid="2CH 15:11"/><verse number="12" style="v" sid="2CH 15:12"/>ತಮ್ಮ ಪಿತೃಗಳ ದೇವರಾದ ಯೆಹೋವ ದೇವರನ್ನು ತಮ್ಮ ಪೂರ್ಣಹೃದಯದಿಂದಲೂ, ತಮ್ಮ ಪೂರ್ಣಪ್ರಾಣದಿಂದಲೂ ಹುಡುಕಬೇಕೆಂದೂ <verse eid="2CH 15:12"/><verse number="13" style="v" sid="2CH 15:13"/>ಯಾವನಾದರೂ ಇಸ್ರಾಯೇಲಿನ ದೇವರಾದ ಯೆಹೋವ ದೇವರನ್ನು ಹುಡುಕದೆ ಹೋದರೆ; ಹಿರಿಯನಾದರೂ, ಕಿರಿಯನಾದರೂ, ಪುರುಷನಾದರೂ, ಸ್ತ್ರೀಯಾದರೂ ಸಾಯಬೇಕೆಂದು ಒಡಂಬಡಿಕೆ ಮಾಡಿಕೊಂಡರು. <verse eid="2CH 15:13"/><verse number="14" style="v" sid="2CH 15:14"/>ಮಹಾಶಬ್ದದಿಂದಲೂ, ಆರ್ಭಟದಿಂದಲೂ, ತುತೂರಿಗಳ ಶಬ್ದದಿಂದಲೂ, ಕೊಂಬುಗಳ ಶಬ್ದದಿಂದಲೂ ಯೆಹೋವ ದೇವರ ಮುಂದೆ ಆಣೆ ಇಟ್ಟರು. <verse eid="2CH 15:14"/><verse number="15" style="v" sid="2CH 15:15"/>ಯೆಹೂದದವರೆಲ್ಲರು ಪ್ರಮಾಣಕ್ಕೆ ಸಂತೋಷಪಟ್ಟರು. ಏಕೆಂದರೆ ಅವರು ತಮ್ಮ ಪೂರ್ಣಹೃದಯದಿಂದ ಆಣೆ ಇಟ್ಟು, ತಮ್ಮ ಪೂರ್ಣ ಇಷ್ಟಪೂರ್ವಕವಾಗಿ ದೇವರನ್ನು ಹುಡುಕಿದರು; ದೇವರು ಅವರಿಗೆ ಸಿಕ್ಕಿದರು. ಯೆಹೋವ ದೇವರು ಅವರಿಗೆ ಸುತ್ತಲೂ ವಿಶ್ರಾಂತಿಕೊಟ್ಟರು.<verse eid="2CH 15:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="2CH 15:16"/>ಅರಸನಾದ ಆಸನ ಅಜ್ಜಿ ಮಾಕ ಎಂಬವಳು ಅಶೇರ ದೇವತೆಯ ಒಂದು ಅಸಹ್ಯವಾದ ಮೂರ್ತಿಯನ್ನು ಮಾಡಿಸಿದ್ದರಿಂದ, ಅವಳನ್ನು ರಾಜಮಾತೆಯ ಸ್ಥಾನದಿಂದ ತೆಗೆದುಹಾಕಿದನು. ಇದಲ್ಲದೆ ಆಸನು ಆ ಮೂರ್ತಿಯನ್ನು ಕಡಿದು ಚೂರುಚೂರು ಮಾಡಿ, ಕಿದ್ರೋನ್ ಹಳ್ಳದ ಹತ್ತಿರ ಸುಟ್ಟುಬಿಟ್ಟನು. <verse eid="2CH 15:16"/><verse number="17" style="v" sid="2CH 15:17"/>ಇಸ್ರಾಯೇಲಿನೊಳಗಿಂದ ಪೂಜಾಸ್ಥಳಗಳನ್ನು ತೆಗೆದು ಹಾಕದಿದ್ದರೂ ಆಸನ ಹೃದಯವು ತನ್ನ ಜೀವಮಾನದಲ್ಲೆಲ್ಲಾ ಯೆಹೋವ ದೇವರಿಗೆ ಸಮರ್ಪಿತವಾಗಿತ್ತು. <verse eid="2CH 15:17"/><verse number="18" style="v" sid="2CH 15:18"/>ತಾನು ಮತ್ತು ತನ್ನ ತಂದೆಯೂ ಪ್ರತಿಷ್ಠಿಸಿದ ಬೆಳ್ಳಿಬಂಗಾರವನ್ನೂ ಸಲಕರಣೆಗಳನ್ನೂ ದೇವರ ಆಲಯಕ್ಕೆ ತಂದನು.<verse eid="2CH 15:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="2CH 15:19"/>ಆಸನ ಆಳ್ವಿಕೆಯಲ್ಲಿ ಮೂವತ್ತೈದನೆಯ ವರ್ಷದವರೆಗೂ ಯುದ್ಧವಿಲ್ಲದೆ ಇತ್ತು.<verse eid="2CH 15:19"/></para>
  <chapter eid="2CH 15"/>
  <chapter number="16" style="c" sid="2CH 16"/>
  <para style="s1">ಆಸನ ಕಡೆಯ ವರ್ಷಗಳು</para>
  <para style="p">
    <verse number="1" style="v" sid="2CH 16:1"/>ಆಸನ ಆಳ್ವಿಕೆಯ ಮೂವತ್ತಾರನೆಯ ವರ್ಷದಲ್ಲಿ ಇಸ್ರಾಯೇಲಿನ ಅರಸನಾದ ಬಾಷನು ಯೆಹೂದಕ್ಕೆ ವಿರೋಧವಾಗಿ ಬಂದು, ಯೆಹೂದದ ಅರಸನಾದ ಆಸನ ಬಳಿಗೆ ಒಳಗಾಗಲೀ, ಹೊರಗಾಗಲೀ ಯಾರೂ ಹೋಗದ ಹಾಗೆ ಸುತ್ತಲೂ ರಾಮ ಪಟ್ಟಣದ ಸುತ್ತಲೂ ಕೋಟೆಯನ್ನು ಕಟ್ಟಿಸಿದನು.<verse eid="2CH 16:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="2CH 16:2"/>ಆಗ ಆಸನು ಯೆಹೋವ ದೇವರ ಆಲಯದ ಮತ್ತು ತನ್ನ ಅರಮನೆಯ ಬೊಕ್ಕಸಗಳಿಂದ ಬೆಳ್ಳಿಬಂಗಾರವನ್ನು ತೆಗೆದು, ದಮಸ್ಕದಲ್ಲಿ ವಾಸವಾಗಿರುವ ಅರಾಮಿನ ಅರಸನಾದ ಬೆನ್ಹದದನಿಗೆ ಅವುಗಳನ್ನು ಕಳುಹಿಸಿ ಅವನಿಗೆ, <verse eid="2CH 16:2"/><verse number="3" style="v" sid="2CH 16:3"/>“ನನ್ನ ತಂದೆ ಮತ್ತು ನಿನ್ನ ತಂದೆಯ ನಡುವೆ ಇದ್ದಂತೆ ನನ್ನ ಮತ್ತು ನಿನ್ನ ನಡುವೆ ಒಡಂಬಡಿಕೆ ಉಂಟು. ಇಗೋ ನಾನು ಬೆಳ್ಳಿಬಂಗಾರವನ್ನು ನಿನಗೆ ಕಳುಹಿಸಿದ್ದೇನೆ. ಇಸ್ರಾಯೇಲಿನ ಅರಸನಾದ ಬಾಷನು ನನ್ನನ್ನು ಬಿಟ್ಟುಹೋಗುವಂತೆ, ನೀನು ಅವನ ಸಂಗಡ ಮಾಡಿದ ಒಡಂಬಡಿಕೆಯನ್ನು ಮುರಿಯಬೇಕು,” ಎಂದು ಹೇಳಿದನು.<verse eid="2CH 16:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="2CH 16:4"/>ಹಾಗೆಯೇ ಬೆನ್ಹದದನು ಅರಸನಾದ ಆಸನ ಮಾತನ್ನು ಕೇಳಿ, ಇಸ್ರಾಯೇಲಿನ ಪಟ್ಟಣಗಳಿಗೆ ವಿರೋಧವಾಗಿ ತನ್ನ ಸೈನ್ಯಾಧಿಪತಿಗಳನ್ನು ಕಳುಹಿಸಿದನು. ಅವರು ಇಯ್ಯೋನ್, ದಾನ್ ಆಬೇಲ್ಮಯಿಮ್<note caller="+" style="f"><char style="fr" closed="false">16:4 </char><char style="fq" closed="false">ಆಬೇಲ್ಮಯಿಮ್ </char><char style="ft" closed="false">ಅಥವಾ </char><char style="fqa" closed="false">ಆಬೇಲ್ ಬೇತ್‌ಮಾಕ</char></note>, ನಫ್ತಾಲ್ಯರ ಸಮಸ್ತ ಉಗ್ರಾಣಗಳ ಪಟ್ಟಣಗಳನ್ನು ವಶಪಡಿಸಿಕೊಂಡರು. <verse eid="2CH 16:4"/><verse number="5" style="v" sid="2CH 16:5"/>ಬಾಷನು ಇದನ್ನು ಕೇಳಿದಾಗ ರಾಮ ಪಟ್ಟಣದ ಸುತ್ತಲೂ ಕೋಟೆ ಕಟ್ಟಿಸುವುದನ್ನು ಬಿಟ್ಟು, ಅದರ ಎಲ್ಲಾ ಕೆಲಸಗಳನ್ನು ನಿಲ್ಲಿಸಿಬಿಟ್ಟನು. <verse eid="2CH 16:5"/><verse number="6" style="v" sid="2CH 16:6"/>ಆಗ ಅರಸನಾದ ಆಸನು ಯೆಹೂದದವರೆಲ್ಲರನ್ನು ಕರಕೊಂಡು ಹೋದನು. ಬಾಷನು ಕಟ್ಟಿಸುತ್ತಾ ಇದ್ದ ರಾಮ ಪಟ್ಟಣದ ಕಲ್ಲುಗಳನ್ನೂ, ಅದರ ತೊಲೆಗಳನ್ನೂ ತೆಗೆದುಕೊಂಡುಹೋಗಿ, ಅವುಗಳಿಂದ ಗಿಬೆಯ ಮತ್ತು ಮಿಚ್ಪೆ ಎಂಬ ನಗರಗಳನ್ನು ಕಟ್ಟಿಸಿದನು.<verse eid="2CH 16:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="2CH 16:7"/>ಅದೇ ಕಾಲದಲ್ಲಿ ದರ್ಶಿಯಾದ ಹನಾನೀಯು ಯೆಹೂದದ ಅರಸನಾದ ಆಸನ ಬಳಿಗೆ ಬಂದು ಅವನಿಗೆ, “ನೀನು ನಿನ್ನ ದೇವರಾದ ಯೆಹೋವ ದೇವರ ಮೇಲೆ ಆತುಕೊಳ್ಳದೆ, ಅರಾಮಿನ ಅರಸನ ಮೇಲೆ ಆತುಕೊಂಡದ್ದರಿಂದ, ಅರಾಮಿನ ಅರಸನ ಸೈನ್ಯವು ನಿಮ್ಮ ಕೈಯಿಂದ ತಪ್ಪಿಸಿಕೊಂಡಿತು. <verse eid="2CH 16:7"/><verse number="8" style="v" sid="2CH 16:8"/>ಕೂಷನವರೂ, ಲಿಬಿಯದವರೂ ಮಹಾ ಸೈನ್ಯವಲ್ಲವೋ? ಅವರ ಸಂಗಡ ಅನೇಕ ರಥಗಳೂ, ರಾಹುತರೂ ಇದ್ದರಲ್ಲವೇ? ಆಗ ನೀನು ಯೆಹೋವ ದೇವರನ್ನು ಆತುಕೊಂಡದ್ದರಿಂದ ದೇವರು ಅವರನ್ನು ನಿನ್ನ ಕೈಯಲ್ಲಿ ಒಪ್ಪಿಸಿದ್ದರು. <verse eid="2CH 16:8"/><verse number="9" style="v" sid="2CH 16:9"/>ಏಕೆಂದರೆ ಯೆಹೋವ ದೇವರಿಗೆ ಪೂರ್ಣವಾಗಿ ಸಮರ್ಪಿಸಿಕೊಂಡವರ ಹೃದಯವನ್ನು ಬಲಪಡಿಸುವುದಕ್ಕೆ ಅವರ ಕಣ್ಣುಗಳು ಭೂಲೋಕದ ಎಲ್ಲಾ ಕಡೆ ಇವೆ. ಆದರೆ ಈಗ ನೀನು ಬುದ್ಧಿಹೀನನಾಗಿ ನಡೆದುಕೊಂಡಿದ್ದೀಯೆ. ನಿಶ್ಚಯವಾಗಿ ಇಂದಿನಿಂದ ನಿನಗೆ ಯುದ್ಧಗಳು ಇದ್ದೇ ಇರುತ್ತವೆ,” ಎಂದನು.<verse eid="2CH 16:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="2CH 16:10"/>ಆಗ ಆಸನು ದರ್ಶಿಯ ಮೇಲೆ ಕೋಪಗೊಂಡು ಅವನನ್ನು ಸೆರೆಮನೆಯಲ್ಲಿ ಹಾಕಿಸಿದನು. ಇದರ ನಿಮಿತ್ತ ಅವನ ಮೇಲೆ ರೌದ್ರವುಳ್ಳವನಾಗಿದ್ದನು. ಇದಲ್ಲದೆ ಅದೇ ಕಾಲದಲ್ಲಿ ಆಸನು ಜನರಲ್ಲಿ ಕೆಲವರನ್ನು ಬಾಧಿಸಿದನು.<verse eid="2CH 16:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="2CH 16:11"/>ಆಸನ ಆಳ್ವಿಕೆಯ ಮೊದಲಿನಿಂದ ಕಡೆಯವರೆಗೆ ಮಾಡಿದ ಕಾರ್ಯಗಳು ಯೆಹೂದದ ಇಸ್ರಾಯೇಲಿನ ಅರಸರ ಪುಸ್ತಕದಲ್ಲಿ ಬರೆದಿರುತ್ತವೆ. <verse eid="2CH 16:11"/><verse number="12" style="v" sid="2CH 16:12"/>ಆದರೆ ಆಸನು ತನ್ನ ಆಳಿಕೆಯ ಮೂವತ್ತೊಂಬತ್ತನೆಯ ವರ್ಷದಲ್ಲಿ ಅವನ ಕಾಲುಗಳಿಗೆ ರೋಗ ತಗುಲಿತು. ಅವನ ರೋಗವು ಅತಿಘೋರವಾಯಿತು. ಆದರೆ ಅವನು ತನ್ನ ರೋಗದಲ್ಲಿ ಯೆಹೋವ ದೇವರನ್ನು ಹುಡುಕದೆ, ವೈದ್ಯರನ್ನು ಹುಡುಕಿದನು. <verse eid="2CH 16:12"/><verse number="13" style="v" sid="2CH 16:13"/>ಆಸನು ಮೃತನಾಗಿ ತನ್ನ ಪಿತೃಗಳ ಬಳಿ ಸೇರಿದನು. ತನ್ನ ಆಳಿಕೆಯ ನಾಲ್ವತ್ತೊಂದನೆಯ ವರ್ಷದಲ್ಲಿ ಮರಣಹೊಂದಿದನು. <verse eid="2CH 16:13"/><verse number="14" style="v" sid="2CH 16:14"/>ಅವನು ತನಗೋಸ್ಕರ ದಾವೀದನ ಪಟ್ಟಣದಲ್ಲಿ ಅಗಿಸಿದ ಅವನ ಸ್ವಂತ ಸಮಾಧಿಯಲ್ಲಿ ಅವನನ್ನು ಹೂಳಿಟ್ಟರು. ಅವರು ತೈಲಗಾರರ ವಿದ್ಯೆಯಿಂದ ಸಿದ್ಧಮಾಡಿದ ಸುಗಂಧಗಳಿಂದಲೂ, ನಾನಾ ವಿಧವಾದ ಪದಾರ್ಥಗಳಿಂದಲೂ ತುಂಬಿದ ಶವ ಪೆಟ್ಟಿಗೆಯಲ್ಲಿ ಅವನನ್ನು ಇಟ್ಟರು. ಅವನ ಗೌರವಕ್ಕಾಗಿ ಮಹಾ ಅಗ್ನಿಕುಂಡವನ್ನೇರ್ಪಡಿಸಿದರು.<verse eid="2CH 16:14"/></para>
  <chapter eid="2CH 16"/>
  <chapter number="17" style="c" sid="2CH 17"/>
  <para style="s1">ಯೆಹೂದ್ಯರ ಅರಸನಾದ ಯೆಹೋಷಾಫಾಟನು</para>
  <para style="p">
    <verse number="1" style="v" sid="2CH 17:1"/>ಆಸನ ಮಗ ಯೆಹೋಷಾಫಾಟನು ಅವನಿಗೆ ಬದಲಾಗಿ ಆಳಿದನು. ಅವನು ಇಸ್ರಾಯೇಲಿಗೆ ವಿರೋಧವಾಗಿ ತನ್ನನ್ನು ಬಲಪಡಿಸಿಕೊಂಡನು. <verse eid="2CH 17:1"/><verse number="2" style="v" sid="2CH 17:2"/>ಇದಲ್ಲದೆ ಅವನು ಯೆಹೂದದಲ್ಲಿ ಸಮಸ್ತ ಕೋಟೆಯುಳ್ಳ ಪಟ್ಟಣಗಳಲ್ಲಿ ಸೈನ್ಯವನ್ನು ಇಟ್ಟು, ಯೆಹೂದದಲ್ಲಿಟ್ಟ ಹಾಗೆ ತನ್ನ ತಂದೆಯಾದ ಆಸನು ತೆಗೆದುಕೊಂಡ ಎಫ್ರಾಯೀಮನ ಪಟ್ಟಣಗಳಲ್ಲಿ ಸೈನ್ಯಗಳನ್ನು ಇಟ್ಟನು.<verse eid="2CH 17:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="2CH 17:3"/>ಯೆಹೋಷಾಫಾಟನು ಬಾಳ್ ದೇವರುಗಳನ್ನು ಅನುಸರಿಸದೆ, ತನ್ನ ತಂದೆ ದಾವೀದನ ಮೊದಲಿನ ಮಾರ್ಗದಲ್ಲಿ ನಡೆದದ್ದರಿಂದ, ಯೆಹೋವ ದೇವರು ಅವನ ಸಂಗಡ ಇದ್ದರು. <verse eid="2CH 17:3"/><verse number="4" style="v" sid="2CH 17:4"/>ತನ್ನ ತಂದೆಯ ದೇವರನ್ನು ಹುಡುಕಿ, ಇಸ್ರಾಯೇಲಿನ ಕ್ರಿಯೆಗಳ ಪ್ರಕಾರ ನಡೆಯದೆ, ದೇವರ ಆಜ್ಞೆಗಳಲ್ಲಿ ನಡೆದನು. <verse eid="2CH 17:4"/><verse number="5" style="v" sid="2CH 17:5"/>ಆದ್ದರಿಂದ ಯೆಹೋವ ದೇವರು ರಾಜ್ಯವನ್ನು ಅವನ ಕೈಯಲ್ಲಿ ಸ್ಥಿರಪಡಿಸಿದರು. ಯೆಹೂದವೆಲ್ಲವೂ ಯೆಹೋಷಾಫಾಟನಿಗೆ ಕಾಣಿಕೆಯನ್ನು ಕೊಟ್ಟದ್ದರಿಂದ, ಅವನಿಗೆ ಐಶ್ವರ್ಯವೂ, ಘನತೆಯೂ ಅಧಿಕವಾಯಿತು. <verse eid="2CH 17:5"/><verse number="6" style="v" sid="2CH 17:6"/>ಅವನ ಹೃದಯವು ಯೆಹೋವ ದೇವರ ಮಾರ್ಗಗಳಲ್ಲಿ ಸಮರ್ಪಿತವಾಗಿತ್ತು. ಇದಲ್ಲದೆ ಅವನು ಯೆಹೂದದಲ್ಲಿದ್ದ ಉನ್ನತ ಪೂಜಾಸ್ಥಳಗಳನ್ನೂ, ಅಶೇರ ವಿಗ್ರಹ ಸ್ತಂಭಗಳನ್ನೂ ತೆಗೆದುಹಾಕಿದನು.<verse eid="2CH 17:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="2CH 17:7"/>ಅವನ ಆಳಿಕೆಯ ಮೂರನೆಯ ವರ್ಷದಲ್ಲಿ ಅವನು ತನ್ನ ಪ್ರಧಾನರಾದ ಬೆನ್ಹೈಲನನ್ನೂ, ಓಬದ್ಯನನ್ನೂ, ಜೆಕರ್ಯನನ್ನೂ, ನೆತನೆಯೇಲನನ್ನೂ, ಮೀಕಾಯನನ್ನೂ ಯೆಹೂದದ ಪಟ್ಟಣಗಳಲ್ಲಿ ಬೋಧಿಸಲು ಕರೆಕಳುಹಿಸಿದನು. <verse eid="2CH 17:7"/><verse number="8" style="v" sid="2CH 17:8"/>ಅವರ ಸಂಗಡ ಲೇವಿಯರಾದ ಶೆಮಾಯನನ್ನೂ, ನೆತನ್ಯನನ್ನೂ, ಜೆಬದ್ಯನನ್ನೂ, ಅಸಾಯೇಲನನ್ನೂ, ಶೆಮೀರಾಮೋತನನ್ನೂ, ಯೆಹೋನಾತಾನನನ್ನೂ, ಅದೋನೀಯನನ್ನೂ, ಟೋಬೀಯನನ್ನೂ, ಟೋಬದೋನಿಯನನ್ನೂ, ಇವರ ಸಂಗಡ ಯಾಜಕರಾದ ಎಲೀಷಾಮನನ್ನೂ, ಯೆಹೋರಾಮನನ್ನೂ ಕಳುಹಿಸಿದನು. <verse eid="2CH 17:8"/><verse number="9" style="v" sid="2CH 17:9"/>ಇವರು ಯೆಹೂದದಲ್ಲಿ ಬೋಧಿಸಿದರು. ಅವರ ಬಳಿಯಲ್ಲಿ ಯೆಹೋವ ದೇವರ ನಿಯಮದ ಗ್ರಂಥ ಇತ್ತು. ಯೆಹೂದದ ಸಮಸ್ತ ಪಟ್ಟಣಗಳನ್ನು ಸಂಚರಿಸಿ, ಜನರಿಗೆ ಬೋಧಿಸಿದರು.<verse eid="2CH 17:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="2CH 17:10"/>ಯೆಹೋವ ದೇವರ ಭಯವು ಯೆಹೂದದ ಸುತ್ತಲಿರುವ ದೇಶಗಳ ಸಮಸ್ತ ರಾಜ್ಯಗಳ ಮೇಲೆ ಇದ್ದುದರಿಂದ, ಅವರು ಯೆಹೋಷಾಫಾಟನ ಮೇಲೆ ಯುದ್ಧಮಾಡಲಿಲ್ಲ. <verse eid="2CH 17:10"/><verse number="11" style="v" sid="2CH 17:11"/>ಇದಲ್ಲದೆ ಫಿಲಿಷ್ಟಿಯರಲ್ಲಿ ಕೆಲವರು ಯೆಹೋಷಾಫಾಟನಿಗೆ ಕಾಣಿಕೆಗಳನ್ನೂ, ಕಪ್ಪದ ಹಣವನ್ನು ತಂದರು. ಅರಬಿಯ ದೇಶದವರು ತಮ್ಮ ಮಂದೆಗಳಿಂದ ಏಳು ಸಾವಿರದ ಏಳು ನೂರು ಟಗರುಗಳನ್ನೂ, ಏಳು ಸಾವಿರದ ಏಳು ನೂರು ಹೋತಗಳನ್ನೂ ತಂದರು.<verse eid="2CH 17:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="2CH 17:12"/>ಯೆಹೋಷಾಫಾಟನು ಬರಬರುತ್ತಾ ಬಹಳ ಅಭಿವೃದ್ಧಿಯಾಗಿ ಯೆಹೂದದಲ್ಲಿ ಅರಮನೆಗಳನ್ನೂ, ಉಗ್ರಾಣದ ಪಟ್ಟಣಗಳನ್ನೂ ಕಟ್ಟಿಸಿದನು. <verse eid="2CH 17:12"/><verse number="13" style="v" sid="2CH 17:13"/>ಇದಲ್ಲದೆ ಯೆಹೂದದ ಪಟ್ಟಣಗಳಲ್ಲಿ ದವಸ ಧಾನ್ಯಗಳ ದೊಡ್ಡ ಮಳಿಗೆಯನ್ನು ಕಟ್ಟಿದನು. ಪರಾಕ್ರಮಶಾಲಿಗಳಾದ ಯುದ್ಧವೀರರು ಯೆರೂಸಲೇಮಿನಲ್ಲಿದ್ದರು. <verse eid="2CH 17:13"/><verse number="14" style="v" sid="2CH 17:14"/>ತಮ್ಮ ಪಿತೃಗಳ ಮನೆಯ ಪ್ರಕಾರವಾಗಿರುವ ಅವರ ಲೆಕ್ಕವೇನೆಂದರೆ:</para>
  <para style="b" vid="2CH 17:14"/>
  <para style="li1" vid="2CH 17:14">ಯೆಹೂದದ 1,000 ಅಧಿಪತಿಗಳಲ್ಲಿ ಅದ್ನಾನು ಮುಖ್ಯಸ್ಥನಾಗಿದ್ದನು.</para>
  <para style="li2" vid="2CH 17:14">ಅವನ ಸಂಗಡ ಪರಾಕ್ರಮಶಾಲಿಗಳು 3,00,000 ಮಂದಿ ಇದ್ದರು.<verse eid="2CH 17:14"/></para>
  <para style="li2">
    <verse number="15" style="v" sid="2CH 17:15"/>ಅವನ ತರುವಾಯ ಅಧಿಪತಿಯಾದ ಯೆಹೋಹಾನಾನನು; ಅವನ ಸಂಗಡ 2,80,000 ಮಂದಿಯು.<verse eid="2CH 17:15"/></para>
  <para style="li2">
    <verse number="16" style="v" sid="2CH 17:16"/>ಇವನ ತರುವಾಯ ಯೆಹೋವ ದೇವರಿಗೆ ತನ್ನನ್ನು ಮನಃಪೂರ್ವಕವಾಗಿ ಒಪ್ಪಿಸಿದ ಜಿಕ್ರಿಯ ಮಗನಾದ ಅಮಸ್ಯನು; ಅವನ ಸಂಗಡ 2,00,000 ಮಂದಿ ಪರಾಕ್ರಮಶಾಲಿಗಳು.<verse eid="2CH 17:16"/></para>
  <para style="li1">
    <verse number="17" style="v" sid="2CH 17:17"/>ಬೆನ್ಯಾಮೀನ್ಯರಲ್ಲಿ</para>
  <para style="li2" vid="2CH 17:17">ಪರಾಕ್ರಮಶಾಲಿಯಾದ ಎಲ್ಯಾದ; ಇವನ ಸಂಗಡ ಬಿಲ್ಲನ್ನೂ, ಗುರಾಣಿಯನ್ನೂ ಧರಿಸಿಕೊಂಡಿರುವ 2,00,000 ಮಂದಿಯು.<verse eid="2CH 17:17"/></para>
  <para style="li2">
    <verse number="18" style="v" sid="2CH 17:18"/>ಇವನ ತರುವಾಯ ಯೆಹೋಜಾಬಾದನು; ಅವನ ಸಂಗಡ ಯುದ್ಧಕ್ಕೆ ಸಿದ್ಧವಾಗಿರುವ 1,80,000 ಮಂದಿಯು.<verse eid="2CH 17:18"/></para>
  <para style="b"/>
  <para style="m">
    <verse number="19" style="v" sid="2CH 17:19"/>ಅರಸನಿಂದ ಸಮಸ್ತ ಯೆಹೂದದಲ್ಲಿರುವ ಕೋಟೆಯುಳ್ಳ ಪಟ್ಟಣಗಳಲ್ಲಿ ಇದ್ದವರ ಹೊರತಾಗಿ, ಇವರು ಅರಸನ ಬಳಿಯಲ್ಲಿ ಸೇವೆಮಾಡುತ್ತಿದ್ದರು.<verse eid="2CH 17:19"/></para>
  <chapter eid="2CH 17"/>
  <chapter number="18" style="c" sid="2CH 18"/>
  <para style="s1">ಮೀಕಾಯನು ಅಹಾಬನ ವಿರುದ್ಧ ಪ್ರವಾದಿಸಿದ್ದು</para>
  <para style="p">
    <verse number="1" style="v" sid="2CH 18:1"/>ಯೆಹೋಷಾಫಾಟನಿಗೆ ಐಶ್ವರ್ಯವೂ, ಘನತೆಯೂ ಅಧಿಕವಾಗಿರುವಾಗ, ಅವನು ಅಹಾಬನ ಸಂಗಡ ಬಂಧುತ್ವ ಮಾಡಿದನು. <verse eid="2CH 18:1"/><verse number="2" style="v" sid="2CH 18:2"/>ಕೆಲವು ವರ್ಷಗಳ ತರುವಾಯ ಅವನು ಅಹಾಬನ ಬಳಿಗೆ ಸಮಾರ್ಯಕ್ಕೆ ಹೋದನು. ಆಗ ಅಹಾಬನು ಅವನಿಗೋಸ್ಕರವೂ, ಅವನ ಸಂಗಡ ಇದ್ದ ಜನರಿಗೋಸ್ಕರವೂ ಅನೇಕ ಕುರಿದನಗಳನ್ನೂ ವಧಿಸಿ ಔತಣವನ್ನೇರ್ಪಡಿಸಿ, ತನ್ನ ಸಂಗಡ ಯುದ್ಧಕ್ಕಾಗಿ ಗಿಲ್ಯಾದಿನ ರಾಮೋತಿಗೆ ಹೋಗಲು ಪ್ರೇರೇಪಿಸಿದನು. <verse eid="2CH 18:2"/><verse number="3" style="v" sid="2CH 18:3"/>ಇಸ್ರಾಯೇಲಿನ ಅರಸನಾದ ಅಹಾಬನು ಯೆಹೂದದ ಅರಸನಾದ ಯೆಹೋಷಾಫಾಟನಿಗೆ, “ನೀನು ಗಿಲ್ಯಾದಿನ ರಾಮೋತಿನ ಮೇಲೆ ಯುದ್ಧಮಾಡಲು ನನ್ನ ಸಂಗಡ ಬರುತ್ತೀಯಾ?” ಎಂದನು.</para>
  <para style="p" vid="2CH 18:3">ಅದಕ್ಕವನು, “ನಾನೂ ನೀನೂ, ನನ್ನ ಜನರೂ ನಿನ್ನ ಜನರೂ ಒಂದೇ ಅಲ್ಲವೇ? ನಾವು ಯುದ್ಧದಲ್ಲಿ ನಿನ್ನ ಸಂಗಡ ಇರುವೆವು,” ಎಂದನು. <verse eid="2CH 18:3"/><verse number="4" style="v" sid="2CH 18:4"/>ಆದರೆ ಯೆಹೋಷಾಫಾಟನು ಇಸ್ರಾಯೇಲಿನ ಅರಸನಿಗೆ, “ಈ ಹೊತ್ತು ಮೊದಲು ಯೆಹೋವ ದೇವರ ಆಲೋಚನೆಯನ್ನು ವಿಚಾರಿಸಿರಿ,” ಎಂದನು.<verse eid="2CH 18:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="2CH 18:5"/>ಆಗ ಇಸ್ರಾಯೇಲಿನ ಅರಸನು ನಾನೂರು ಮಂದಿ ಪ್ರವಾದಿಗಳನ್ನು ಕೂಡಿಸಿ ಅವರಿಗೆ, “ನಾನು ಗಿಲ್ಯಾದಿನ ರಾಮೋತಿನ ಮೇಲೆ ಯುದ್ಧಕ್ಕೆ ಹೋಗಬಹುದೋ, ಬೇಡವೋ?” ಎಂದು ಕೇಳಿದನು.</para>
  <para style="p" vid="2CH 18:5">ಅದಕ್ಕವರು, “ಹೋಗು, ದೇವರು ಅದನ್ನು ಅರಸನ ಕೈಯಲ್ಲಿ ಒಪ್ಪಿಸಿಕೊಡುವರು,” ಎಂದರು.<verse eid="2CH 18:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="2CH 18:6"/>ಆದರೆ ಯೆಹೋಷಾಫಾಟನು, “ಯೆಹೋವ ದೇವರ ಪ್ರವಾದಿಗಳಲ್ಲಿ ಇವರ ಹೊರತಾಗಿ ನಾವು ವಿಚಾರಿಸುವ ಹಾಗೆ ಬೇರೆ ಪ್ರವಾದಿ ಇಲ್ಲಿ ಇಲ್ಲವೋ?” ಎಂದು ಕೇಳಿದನು.<verse eid="2CH 18:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="2CH 18:7"/>ಆಗ ಇಸ್ರಾಯೇಲಿನ ಅರಸನು ಯೆಹೋಷಾಫಾಟನಿಗೆ, “ನಾವು ಯೆಹೋವ ದೇವರನ್ನು ವಿಚಾರಿಸುವ ಹಾಗೆ ಇಮ್ಲನ ಮಗ ಮೀಕಾಯನೆಂಬ ಇನ್ನೊಬ್ಬನಿದ್ದಾನೆ. ಆದರೆ ನಾನು ಅವನನ್ನು ದ್ವೇಷ ಮಾಡುತ್ತೇನೆ. ಏಕೆಂದರೆ ಅವನು ನನ್ನನ್ನು ಕುರಿತು ಒಳ್ಳೆಯದನ್ನಲ್ಲ ಯಾವಾಗಲೂ ಕೆಟ್ಟದ್ದನ್ನು ಪ್ರವಾದಿಸುತ್ತಾನೆ,” ಎಂದನು.</para>
  <para style="p" vid="2CH 18:7">ಅದಕ್ಕೆ ಯೆಹೋಷಾಫಾಟನು, “ಅರಸನು ಹಾಗೆ ಅನ್ನದಿರಲಿ,” ಎಂದನು.<verse eid="2CH 18:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="2CH 18:8"/>ಆಗ ಇಸ್ರಾಯೇಲಿನ ಅರಸನು ಒಬ್ಬ ಅಧಿಕಾರಿಯನ್ನು ಕರೆದು, “ಇಮ್ಲನ ಮಗನಾದ ಮೀಕಾಯನನ್ನು ಶೀಘ್ರವಾಗಿ ಕರೆದುಕೊಂಡು ಬಾ,” ಎಂದನು.<verse eid="2CH 18:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="2CH 18:9"/>ಇಸ್ರಾಯೇಲಿನ ಅರಸನೂ, ಯೆಹೂದದ ಅರಸನಾದ ಯೆಹೋಷಾಫಾಟನೂ ರಾಜವಸ್ತ್ರಗಳನ್ನು ಧರಿಸಿಕೊಂಡು, ಸಮಾರ್ಯದ ಬಾಗಿಲಿನ ಮುಂದೆ ಬಯಲಿನಲ್ಲಿ ತಮ್ಮ ತಮ್ಮ ಸಿಂಹಾಸನಗಳ ಮೇಲೆ ಕುಳಿತುಕೊಂಡಿದ್ದರು. ಸಕಲ ಪ್ರವಾದಿಗಳೂ ಅವರ ಮುಂದೆ ಪ್ರವಾದಿಸುತ್ತಿದ್ದರು. <verse eid="2CH 18:9"/><verse number="10" style="v" sid="2CH 18:10"/>ಆಗ ಕೆನಾನನ ಮಗನಾದ ಚಿದ್ಕೀಯನು, “ತನಗೆ ಕಬ್ಬಿಣದ ಕೊಂಬುಗಳನ್ನು ಮಾಡಿಕೊಂಡು, ‘ಇವುಗಳಿಂದ ನೀನು ಅರಾಮ್ಯರನ್ನು ನಿರ್ಮೂಲ ಮಾಡುವವರೆಗೂ ಇರಿದು ಹಾಕುವೆ,’ ಎಂದು ಯೆಹೋವ ದೇವರು ಹೇಳುತ್ತಾರೆ,” ಎಂದನು.<verse eid="2CH 18:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="2CH 18:11"/>ಸಮಸ್ತ ಪ್ರವಾದಿಗಳೂ ಹಾಗೆಯೇ ಪ್ರವಾದಿಸಿ, “ಗಿಲ್ಯಾದಿನ ರಾಮೋತಿಗೆ ಹೋಗಿ ಜಯ ಹೊಂದು. ಯೆಹೋವ ದೇವರು ಅದನ್ನು ಅರಸನ ಕೈಯಲ್ಲಿ ಒಪ್ಪಿಸಿಕೊಡುವರು,” ಎಂದರು.<verse eid="2CH 18:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="2CH 18:12"/>ಆದರೆ ಮೀಕಾಯನನ್ನು ಕರೆಯಲು ಹೋದ ದೂತನು ಅವನಿಗೆ, “ನೋಡು, ಎಲ್ಲ ಪ್ರವಾದಿಗಳು ಏಕಮನಸ್ಸಿನಿಂದ ಅರಸನಿಗೆ ಒಳ್ಳೆಯದನ್ನೇ ಪ್ರವಾದಿಸಿದ್ದಾರೆ. ನಿನ್ನ ಮಾತು ಅವರಲ್ಲಿ ಒಬ್ಬನ ಮಾತಿನ ಹಾಗೆಯೇ ಇರಲಿ; ಒಳ್ಳೆಯ ಮಾತು ಆಡು,” ಎಂದನು.<verse eid="2CH 18:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="2CH 18:13"/>ಅದಕ್ಕೆ ಮೀಕಾಯನು, “ಯೆಹೋವ ದೇವರ ಜೀವದಾಣೆ, ನನ್ನ ದೇವರು ಏನು ಹೇಳುವರೋ, ಅದನ್ನೇ ಮಾತನಾಡುವೆನು,” ಎಂದನು.<verse eid="2CH 18:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="2CH 18:14"/>ಅವನು ಅರಸನ ಬಳಿಗೆ ಬಂದಾಗ, ಅರಸನು ಅವನಿಗೆ, “ಮೀಕಾಯೆಹುವೇ, ನಾವು ಗಿಲ್ಯಾದಿನ ರಾಮೋತ್ ವಿರುದ್ಧವಾಗಿ ಯುದ್ಧಕ್ಕೆ ಹೋಗಬಹುದೋ ಅಥವಾ ಬೇಡವೋ?” ಎಂದನು.</para>
  <para style="p" vid="2CH 18:14">ಆಗ ಅವನು, “ಹೋಗಿ ಜಯ ಹೊಂದಿರಿ. ಅವರು ನಿಮ್ಮ ಕೈವಶರಾಗುವರು,” ಎಂದನು.<verse eid="2CH 18:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="2CH 18:15"/>ಆಗ ಅರಸನು ಅವನಿಗೆ, “ನೀನು ಯೆಹೋವ ದೇವರ ಹೆಸರಿನಲ್ಲಿ ಸತ್ಯವನ್ನಲ್ಲದೆ ಬೇರೊಂದು ನನಗೆ ಹೇಳಬಾರದೆಂದು ನಾನು ಎಷ್ಟು ಸಾರಿ ನಿನಗೆ ಆಣೆ ಇಡಬೇಕು?” ಎಂದನು.<verse eid="2CH 18:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="2CH 18:16"/>ಅದಕ್ಕೆ ಮೀಕಾಯನು, “ಇಸ್ರಾಯೇಲರೆಲ್ಲರು ಕುರುಬನಿಲ್ಲದ ಕುರಿಗಳಂತೆ ಬೆಟ್ಟಗಳ ಮೇಲೆ ಚದರಿಹೋದದ್ದನ್ನು ಕಂಡೆನು. ಆಗ ಯೆಹೋವ ದೇವರು, ‘ಇವರಿಗೆ ಯಜಮಾನನು ಇಲ್ಲ. ಪ್ರತಿ ಮನುಷ್ಯನು ತನ್ನ ತನ್ನ ಮನೆಗೆ ಸಮಾಧಾನವಾಗಿ ಹಿಂದಿರುಗಿ ಹೋಗಲಿ,’ ಎಂಬುದಾಗಿ ಹೇಳಿದರು,” ಎಂದನು.<verse eid="2CH 18:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="2CH 18:17"/>ಆಗ ಇಸ್ರಾಯೇಲಿನ ಅರಸನು ಯೆಹೋಷಾಫಾಟನಿಗೆ, “ಇವನು ನನ್ನನ್ನು ಕುರಿತು ಒಳ್ಳೆಯದನ್ನಲ್ಲ ಕೆಟ್ಟದ್ದನ್ನೇ ಪ್ರವಾದಿಸುವನೆಂದು ನಾನು ನಿನಗೆ ಹೇಳಲಿಲ್ಲವೇ?” ಎಂದನು.<verse eid="2CH 18:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="2CH 18:18"/>ಆಗ ಮೀಕಾಯನು, “ಆದ್ದರಿಂದ ಯೆಹೋವ ದೇವರ ವಾಕ್ಯವನ್ನು ಕೇಳು. ಯೆಹೋವ ದೇವರು ತಮ್ಮ ಸಿಂಹಾಸನದ ಮೇಲೆ ಕುಳಿತುಕೊಂಡಿರುವುದನ್ನೂ ಆಕಾಶದ ಸಮಸ್ತ ಸೈನ್ಯವು ಅವರ ಬಲಗಡೆ ಮತ್ತು ಎಡಗಡೆಯಲ್ಲಿ ನಿಂತಿರುವುದನ್ನೂ ನಾನು ಕಂಡೆನು. <verse eid="2CH 18:18"/><verse number="19" style="v" sid="2CH 18:19"/>ಆಗ ಯೆಹೋವ ದೇವರು, ‘ಇಸ್ರಾಯೇಲಿನ ಅರಸನಾದ ಅಹಾಬನು ಹೋಗಿ ಗಿಲ್ಯಾದಿನ ರಾಮೋತಿನಲ್ಲಿ ಬೀಳುವ ಹಾಗೆ ಅವನನ್ನು ಮರುಳುಗೊಳಿಸುವವನು ಯಾರು?’ ಎಂದರು.</para>
  <para style="p" vid="2CH 18:19">“ಒಬ್ಬನು ಒಂದು ವಿಧವಾಗಿಯೂ ಮತ್ತೊಬ್ಬನು ಇನ್ನೊಂದು ವಿಧವಾಗಿಯೂ ಹೇಳುತ್ತಿದ್ದರು. <verse eid="2CH 18:19"/><verse number="20" style="v" sid="2CH 18:20"/>ಕೊನೆಯಲ್ಲಿ, ಒಂದು ಆತ್ಮವು ಹೊರಟುಬಂದು ಯೆಹೋವ ದೇವರ ಮುಂದೆ ನಿಂತು, ‘ನಾನು ಅವನನ್ನು ಮರುಳುಗೊಳಿಸುತ್ತೇನೆ,’ ಎಂದಿತು.</para>
  <para style="p" vid="2CH 18:20">“ಆಗ ಯೆಹೋವ ದೇವರು, ‘ಅದು ಹೇಗೆ?’ ಎಂದರು.<verse eid="2CH 18:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="2CH 18:21"/>“ಅದಕ್ಕದು, ‘ನಾನು ಹೊರಟು ಅವನ ಎಲ್ಲಾ ಪ್ರವಾದಿಗಳ ಬಾಯಲ್ಲಿ ಸುಳ್ಳನ್ನಾಡುವ ಆತ್ಮವಾಗಿರುವೆನು,’ ಎಂದಿತು.</para>
  <para style="p" vid="2CH 18:21">“ಅದಕ್ಕೆ ಯೆಹೋವ ದೇವರು, ‘ನೀನು ಅವನನ್ನು ಮರುಳುಗೊಳಿಸುವೆ ಮತ್ತು ಜಯಿಸುವೆ, ಹೊರಟುಹೋಗಿ ಹಾಗೆ ಮಾಡು,’ ಎಂದರು.<verse eid="2CH 18:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="2CH 18:22"/>“ಆದ್ದರಿಂದ ಇಗೋ, ಯೆಹೋವ ದೇವರು ಈ ನಿನ್ನ ಪ್ರವಾದಿಗಳ ಬಾಯಿಯಲ್ಲಿ ಸುಳ್ಳನ್ನಾಡುವ ಆತ್ಮವನ್ನು ಇಟ್ಟಿದ್ದಾರೆ. ಇದಲ್ಲದೆ ಯೆಹೋವ ದೇವರು ನಿನ್ನನ್ನು ಕುರಿತು ಕೇಡನ್ನು ಹೇಳಿದ್ದಾರೆ,” ಎಂದನು.<verse eid="2CH 18:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="2CH 18:23"/>ಆಗ ಕೆನಾನನ ಮಗನಾದ ಚಿದ್ಕೀಯನು ಸಮೀಪಕ್ಕೆ ಬಂದು ಮೀಕಾಯನ ಕೆನ್ನೆಯ ಮೇಲೆ ಹೊಡೆದು, “ಯೆಹೋವ ದೇವರ ಆತ್ಮವು ನನ್ನನ್ನು ಬಿಟ್ಟು, ನಿನ್ನ ಸಂಗಡ ಮಾತನಾಡಲು ಯಾವ ಮಾರ್ಗವಾಗಿ ಬಂದಿತು?” ಎಂದನು.<verse eid="2CH 18:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="2CH 18:24"/>ಅದಕ್ಕೆ ಮೀಕಾಯನು, “ಇಗೋ, ನಿನ್ನನ್ನು ಬಚ್ಚಿಟ್ಟುಕೊಳ್ಳಲು ಒಳಕೊಠಡಿಗೆ ನೀನು ಹೋಗುವ ದಿವಸದಲ್ಲಿ ನೋಡುವೆ,” ಎಂದನು.<verse eid="2CH 18:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="2CH 18:25"/>ಆಗ ಇಸ್ರಾಯೇಲಿನ ಅರಸನು ಹೇಳಿದ್ದೇನೆಂದರೆ, “ನೀವು ಮೀಕಾಯನನ್ನು ಹಿಡಿದು ಪಟ್ಟಣದ ಅಧಿಪತಿಯಾದ ಆಮೋನನ ಬಳಿಗೂ, ಅರಸನ ಮಗನಾದ ಯೋವಾಷನ ಬಳಿಗೂ ತೆಗೆದುಕೊಂಡುಹೋಗಿ, <verse eid="2CH 18:25"/><verse number="26" style="v" sid="2CH 18:26"/>‘ನಾನು ಸಮಾಧಾನವಾಗಿ ತಿರುಗಿ ಬರುವವರೆಗೂ ನೀವು ಇವನನ್ನು ಸೆರೆಮನೆಯಲ್ಲಿಟ್ಟು, ಅವನಿಗೆ ರೊಟ್ಟಿ ಮತ್ತು ನೀರನ್ನು ಬಿಟ್ಟು ಮತ್ತೇನೂ ಕೊಡಬೇಡಿರೆಂದು ಅರಸನು ಹೇಳಿದ್ದಾನೆ’ ಎಂದು ತಿಳಿಸು,” ಎಂದನು.<verse eid="2CH 18:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="2CH 18:27"/>ಅದಕ್ಕೆ ಮೀಕಾಯನು, “ನೀನು ಸಮಾಧಾನದಿಂದ ನಿಜವಾಗಿ ಬಂದರೆ, ಯೆಹೋವ ದೇವರು ನನ್ನ ಮುಖಾಂತರ ಮಾತನಾಡಿಲ್ಲ, ಎಂದು ಹೇಳಿ; ಜನರೇ, ನೀವೆಲ್ಲರೂ ನನ್ನ ಮಾತನ್ನು ಗಮನದಲ್ಲಿಡಿರಿ!” ಎಂದು ಕೂಗಿ ಹೇಳಿದನು.<verse eid="2CH 18:27"/></para>
  <para style="s1">ರಾಮೋತ್ ಗಿಲ್ಯಾದಿನಲ್ಲಿ ಅಹಾಬನ ಮರಣ</para>
  <para style="p">
    <verse number="28" style="v" sid="2CH 18:28"/>ಹೀಗೆಯೇ ಇಸ್ರಾಯೇಲಿನ ಅರಸನೂ, ಯೆಹೂದದ ಅರಸನಾದ ಯೆಹೋಷಾಫಾಟನೂ ಗಿಲ್ಯಾದಿನ ರಾಮೋತಿಗೆ ಹೋದರು. <verse eid="2CH 18:28"/><verse number="29" style="v" sid="2CH 18:29"/>ಆಗ ಇಸ್ರಾಯೇಲಿನ ಅರಸನು ಯೆಹೋಷಾಫಾಟನಿಗೆ, “ನಾನು ವೇಷಹಾಕಿಕೊಂಡು ಯುದ್ಧದಲ್ಲಿ ಪ್ರವೇಶಿಸುವೆನು. ಆದರೆ ನೀನು ನಿನ್ನ ರಾಜವಸ್ತ್ರಗಳನ್ನು ಧರಿಸಿಕೊಂಡಿರು,” ಎಂದನು. ಹಾಗೆಯೇ ಇಸ್ರಾಯೇಲಿನ ಅರಸನು ವೇಷಹಾಕಿಕೊಂಡು ಯುದ್ಧಕ್ಕೆ ಹೋದನು.<verse eid="2CH 18:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="2CH 18:30"/>ಅರಾಮಿನ ಅರಸನು ತನ್ನ ರಥಗಳ ಮೇಲೆ ಅಧಿಕಾರವುಳ್ಳವರಿಗೆ, “ನೀವು ಶತ್ರುಗಳ ಸಾಧಾರಣ ಸೈನಿಕರನ್ನೂ ಅಧಿಪತಿಗಳನ್ನೂ ಬಿಟ್ಟು ಇಸ್ರಾಯೇಲಿನ ಅರಸನನ್ನು ಮಾತ್ರ ಗುರಿಯಾಗಿಸಿಕೊಂಡು ಯುದ್ಧಮಾಡಿರಿ,” ಎಂದು ಆಜ್ಞಾಪಿಸಿದನು. <verse eid="2CH 18:30"/><verse number="31" style="v" sid="2CH 18:31"/>ಆದ್ದರಿಂದ ರಥಗಳ ಅಧಿಪತಿಗಳು ಯೆಹೋಷಾಫಾಟನನ್ನು ಕಂಡಾಗ, “ಇವನೇ ಇಸ್ರಾಯೇಲಿನ ಅರಸನು,” ಎಂದು ಹೇಳಿ ಅವನ ಸಂಗಡ ಯುದ್ಧಮಾಡುವುದಕ್ಕೆ ತಿರುಗಿಕೊಂಡರು. ಆದರೆ ಯೆಹೋಷಾಫಾಟನು ಕೂಗಿಕೊಂಡನು. ಆಗ ಯೆಹೋವ ದೇವರು ಅವನಿಗೆ ಸಹಾಯಮಾಡಿ, ಶತ್ರುಗಳನ್ನು ಅವನ ಕಡೆಯಿಂದ ತೊಲಗಿಸಿದರು. <verse eid="2CH 18:31"/><verse number="32" style="v" sid="2CH 18:32"/>ಅವನು ಇಸ್ರಾಯೇಲಿನ ಅರಸನಲ್ಲವೆಂದು ರಥಗಳ ಅಧಿಪತಿಗಳಿಗೆ ಗೊತ್ತಾದಾಗ, ಅವರು ಅವನನ್ನು ಬಿಟ್ಟುಹೋದರು.<verse eid="2CH 18:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="2CH 18:33"/>ಆದರೆ ಅರಾಮ್ಯರ ಸೈನಿಕನೊಬ್ಬನು ಗುರಿ ಇಡದೆ ಬಿಲ್ಲಿಗೆ ಬಾಣವನ್ನೇರಿಸಿ ಹೊಡೆಯಲು, ಅದು ಇಸ್ರಾಯೇಲಿನ ಅರಸನಿಗೆ, ಅವನ ಕವಚದ ಸಂದಿನಲ್ಲಿ ಬಂದು ತಾಕಿತು. ಆದ್ದರಿಂದ ಅವನು ತನ್ನ ರಥ ನಡೆಸುವವನಿಗೆ, “ನೀನು ರಥವನ್ನು ತಿರುಗಿಸಿ ನನ್ನನ್ನು ಸೈನ್ಯದೊಳಗಿಂದ ಆಚೇಕಡೆಗೆ ತೆಗೆದುಕೊಂಡು ಹೋಗು, ನನಗೆ ದೊಡ್ಡ ಗಾಯವಾಗಿದೆ,” ಎಂದನು. <verse eid="2CH 18:33"/><verse number="34" style="v" sid="2CH 18:34"/>ಆ ದಿವಸವೆಲ್ಲಾ ಯುದ್ಧವು ಬಹು ಘೋರವಾದದ್ದರಿಂದ ಇಸ್ರಾಯೇಲಿನ ಅರಸನಾದ ಅಹಾಬನು ಸಾಯಂಕಾಲದವರೆಗೂ ಅರಾಮ್ಯರಿಗೆ ಎದುರಾಗಿ ರಥದಲ್ಲಿಯೇ ಆತುಕೊಂಡು ನಿಂತಿದ್ದನು, ಸೂರ್ಯನು ಅಸ್ತಮಿಸಿದಾಗ ಅವನು ಮರಣಹೊಂದಿದನು.<verse eid="2CH 18:34"/></para>
  <chapter eid="2CH 18"/>
  <chapter number="19" style="c" sid="2CH 19"/>
  <para style="p">
    <verse number="1" style="v" sid="2CH 19:1"/>ಯೆಹೂದದ ಅರಸನಾದ ಯೆಹೋಷಾಫಾಟನು ಸಮಾಧಾನವಾಗಿ ಯೆರೂಸಲೇಮಿನಲ್ಲಿರುವ ತನ್ನ ಅರಮನೆಗೆ ತಿರುಗಿಬಂದನು. <verse eid="2CH 19:1"/><verse number="2" style="v" sid="2CH 19:2"/>ಆಗ ಪ್ರವಾದಿ ಹನಾನೀಯ ಮಗ ಯೇಹುವು ಅವನನ್ನು ಎದುರುಗೊಂಡು, ಅರಸನಾದ ಯೆಹೋಷಾಫಾಟನಿಗೆ ಅವನು, “ದುಷ್ಟನಿಗೆ ಸಹಾಯ ಕೊಡುವವನಾಗಿ ಯೆಹೋವ ದೇವರನ್ನು ದ್ವೇಷಮಾಡುವವರನ್ನು ಪ್ರೀತಿಮಾಡಬಹುದೋ? ಆದಕಾರಣ ನಿನ್ನ ಮೇಲೆ ಯೆಹೋವ ದೇವರ ಸನ್ನಿಧಿಯಿಂದ ಕೋಪಾಗ್ನಿ ಇದೆ. <verse eid="2CH 19:2"/><verse number="3" style="v" sid="2CH 19:3"/>ಆದರೂ ನೀನು ದೇಶದಿಂದ ಅಶೇರ ಸ್ತಂಭಗಳನ್ನು ತೆಗೆದುಹಾಕಿ, ದೇವರನ್ನು ಹುಡುಕಲು ನಿನ್ನ ಹೃದಯವನ್ನು ಸಿದ್ಧಪಡಿಸಿದ್ದರಿಂದ, ನಿನ್ನಲ್ಲಿ ಉತ್ತಮವಾದ ಕಾರ್ಯಗಳು ತೋರಿಬಂದಿವೆ,” ಎಂದನು.<verse eid="2CH 19:3"/></para>
  <para style="s1">ಯೆಹೋಷಾಫಾಟನು ನ್ಯಾಯಾಧೀಶರನ್ನು ನೇಮಿಸಿದ್ದು</para>
  <para style="p">
    <verse number="4" style="v" sid="2CH 19:4"/>ಯೆಹೋಷಾಫಾಟನು ಯೆರೂಸಲೇಮಿನಲ್ಲಿ ವಾಸವಾಗಿದ್ದನು. ಅವನು ತಿರುಗಿ ಹೊರಟು ಬೇರ್ಷೆಬ ಮೊದಲುಗೊಂಡು ಎಫ್ರಾಯೀಮನ ಬೆಟ್ಟದ ಮಟ್ಟಿಗೂ ಜನರಲ್ಲಿ ಸಂಚರಿಸಿ, ತಮ್ಮ ಪಿತೃಗಳ ದೇವರಾದ ಯೆಹೋವ ದೇವರ ಕಡೆಗೆ ಅವರನ್ನು ತಿರುಗಿಸಿದನು. <verse eid="2CH 19:4"/><verse number="5" style="v" sid="2CH 19:5"/>ಇದಲ್ಲದೆ ಅವನು ದೇಶದೊಳಗೆ ಪಟ್ಟಣ ಪಟ್ಟಣದಲ್ಲಿ ಯೆಹೂದದ ಸಮಸ್ತ ಕೋಟೆಗಳುಳ್ಳ ಪಟ್ಟಣಗಳೊಳಗೆ ನ್ಯಾಯಾಧಿಪತಿಗಳಿಗೆ, <verse eid="2CH 19:5"/><verse number="6" style="v" sid="2CH 19:6"/>“ನೀವು ಮಾಡುವುದನ್ನು ನೋಡಿಕೊಳ್ಳಿರಿ. ನೀವು ಮನುಷ್ಯರಿಗೋಸ್ಕರವಲ್ಲ, ನ್ಯಾಯತೀರಿಸುವ ಕಾರ್ಯದಲ್ಲಿ ನಿಮ್ಮ ಸಂಗಡ ಇರುವ ಯೆಹೋವ ದೇವರಿಗೋಸ್ಕರ ನ್ಯಾಯ ತೀರಿಸುತ್ತೀರಿ. <verse eid="2CH 19:6"/><verse number="7" style="v" sid="2CH 19:7"/>ಆದಕಾರಣ ಯೆಹೋವ ದೇವರ ಭಯವು ನಿಮ್ಮ ಮೇಲೆ ಇರಲಿ. ನೀವು ಜಾಗ್ರತೆಯಾಗಿದ್ದು ನಡೆಯಿರಿ. ಏಕೆಂದರೆ ನಮ್ಮ ದೇವರಾದ ಯೆಹೋವ ದೇವರ ಬಳಿಯಲ್ಲಿ ಅನ್ಯಾಯವಾದರೂ, ಮುಖದಾಕ್ಷಿಣ್ಯವಾದರೂ, ಲಂಚ ತೆಗೆದುಕೊಳ್ಳುವುದಾದರೂ ಇಲ್ಲ,” ಎಂದನು.<verse eid="2CH 19:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="2CH 19:8"/>ಅವರು ಯೆರೂಸಲೇಮಿಗೆ ತಿರುಗಿ ಬಂದ ತರುವಾಯ ಯೆಹೋಷಾಫಾಟನು ಯೆಹೋವ ದೇವರ ನ್ಯಾಯತೀರ್ವಿಕೆಗೋಸ್ಕರವೂ, ವ್ಯಾಜ್ಯಗಳಿಗೋಸ್ಕರವೂ ಯೆರೂಸಲೇಮಿನೊಳಗೆ ಲೇವಿಯರಲ್ಲಿಯೂ, ಯಾಜಕರಲ್ಲಿಯೂ, ಇಸ್ರಾಯೇಲ್ ಗೋತ್ರಪ್ರಧಾನರಲ್ಲಿಯೂ ಕೆಲವರನ್ನು ನೇಮಿಸಿ ಅವರಿಗೆ, <verse eid="2CH 19:8"/><verse number="9" style="v" sid="2CH 19:9"/>“ನೀವು ಈ ಕಾರ್ಯವನ್ನು ಯೆಹೋವ ದೇವರ ಭಯದಿಂದಲೂ ನಂಬಿಕೆಯಿಂದಲೂ ಪೂರ್ಣಹೃದಯದಿಂದಲೂ ಮಾಡಬೇಕು. <verse eid="2CH 19:9"/><verse number="10" style="v" sid="2CH 19:10"/>ಇದಲ್ಲದೆ ಜೀವಹತ್ಯ, ನ್ಯಾಯಕ್ಕೂ, ಆಜ್ಞೆಗೂ, ನಿಯಮಗಳಿಗೂ, ನ್ಯಾಯತೀರ್ವಿಕೆಗಳಿಗೂ ತಮ್ಮ ಪಟ್ಟಣಗಳಲ್ಲಿ ವಾಸವಾಗಿರುವ ನಿಮ್ಮ ಸಹೋದರರಿಂದ ಯಾವ ಕಾರ್ಯವಾದರೂ ನಿಮ್ಮ ಮುಂದೆ ಬಂದರೆ, ರೌದ್ರವು ನಿಮ್ಮ ಮೇಲೆಯೂ, ನಿಮ್ಮ ಸಹೋದರರ ಮೇಲೆಯೂ ಬಾರದ ಹಾಗೆ ಯೆಹೋವ ದೇವರಿಗೆ ವಿರೋಧವಾಗಿ ಪಾಪಮಾಡದಂತೆ ನೀವು ಅವರನ್ನು ಎಚ್ಚರಿಸಬೇಕು. ಇದನ್ನು ಮಾಡಿರಿ. ಆಗ ನೀವು ಅಪರಾಧವಿಲ್ಲದವರಾಗಿರುವಿರಿ.<verse eid="2CH 19:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="2CH 19:11"/>“ಮುಖ್ಯಯಾಜಕನಾದ ಅಮರ್ಯನು ಯೆಹೋವ ದೇವರ ಸಮಸ್ತ ಕಾರ್ಯಗಳಲ್ಲಿಯೂ, ಯೆಹೂದದ ಮನೆಯ ನಾಯಕನಾಗಿರುವ ಇಷ್ಮಾಯೇಲನ ಮಗ ಜೆಬದ್ಯನು ಅರಸನ ಸಮಸ್ತ ಕಾರ್ಯಗಳಲ್ಲಿಯೂ ಇರುವರು. ಇದಲ್ಲದೆ ಲೇವಿಯರು ನಿಮ್ಮ ಮುಂದೆ ಅಧಿಕಾರಿಗಳಾಗಿರುವರು. ನೀವು ಬಲಗೊಂಡು ಕೆಲಸ ನಡೆಸಿರಿ. ಯೆಹೋವ ದೇವರು ಒಳ್ಳೆಯವರ ಸಂಗಡ ಇರುವರು,” ಎಂದನು.<verse eid="2CH 19:11"/></para>
  <chapter eid="2CH 19"/>
  <chapter number="20" style="c" sid="2CH 20"/>
  <para style="s1">ಯೆಹೋಷಾಫಾಟನು ಮೋವಾಬ್ಯರನ್ನು ಮತ್ತು ಅಮ್ಮೋನಿಯರನ್ನು ಸೋಲಿಸಿದ್ದು</para>
  <para style="p">
    <verse number="1" style="v" sid="2CH 20:1"/>ಇದರ ತರುವಾಯ ಮೋವಾಬ್ಯರೂ, ಅಮ್ಮೋನಿಯರೂ, ಮೆಗೂನ್ಯರೂ ಯೆಹೋಷಾಫಾಟನ ಮೇಲೆ ಯುದ್ಧಮಾಡಲು ಬಂದರು.<verse eid="2CH 20:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="2CH 20:2"/>ಆಗ ಕೆಲವರು ಬಂದು ಯೆಹೋಷಾಫಾಟನಿಗೆ, “ಅರಾಮಿನ ಈಚೆಯಲ್ಲಿರುವ ಲವಣ ಸಮುದ್ರದ ಆಚೆಯಿಂದ ನಿನಗೆ ವಿರೋಧವಾಗಿ ಮಹಾ ಸಮೂಹವೊಂದು ಬರುತ್ತದೆ. ಅವರು ಏನ್ಗೆದಿ ಎಂಬ ಹಜಜೋನ್ ತಾಮಾರಿನಲ್ಲಿ ಇದ್ದಾರೆ,” ಎಂದು ತಿಳಿಸಿದರು. <verse eid="2CH 20:2"/><verse number="3" style="v" sid="2CH 20:3"/>ಇದನ್ನು ಕೇಳಿ ಯೆಹೋಷಾಫಾಟನು ಭಯಪಟ್ಟು ಯೆಹೋವ ದೇವರನ್ನು ಹುಡುಕಲು ನಿರ್ಣಯಿಸಿಕೊಂಡು ಸಮಸ್ತ ಯೆಹೂದದಲ್ಲಿ ಉಪವಾಸ ಮಾಡಬೇಕೆಂದು ಸಾರಿದನು. <verse eid="2CH 20:3"/><verse number="4" style="v" sid="2CH 20:4"/>ಆದ್ದರಿಂದ ಯೆಹೂದದವರು ಯೆಹೋವ ದೇವರಿಂದ ಸಹಾಯವನ್ನು ಕೇಳಿಕೊಳ್ಳಲು ಸಮಸ್ತ ಯೆಹೂದದ ಪಟ್ಟಣಗಳಿಂದ ಕೂಡಿಬಂದರು.<verse eid="2CH 20:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="2CH 20:5"/>ಆಗ ಯೆಹೋಷಾಫಾಟನು ಹೊಸ ಅಂಗಳದ ಮುಂದೆ ಯೆಹೋವ ದೇವರ ಮಂದಿರದಲ್ಲಿರುವ ಯೆಹೂದದ ಯೆರೂಸಲೇಮಿನ ಜನಸಮೂಹದ ಮಧ್ಯದಲ್ಲಿ ನಿಂತು:<verse eid="2CH 20:5"/></para>
  <para style="pm">
    <verse number="6" style="v" sid="2CH 20:6"/>“ನಮ್ಮ ಪಿತೃಗಳ ದೇವರಾದ ಯೆಹೋವ ದೇವರೇ, ಪರಲೋಕದಲ್ಲಿರುವ ದೇವರು ನೀವಲ್ಲವೋ? ನೀವು ಜನಾಂಗಗಳ ಸಕಲ ರಾಜ್ಯಗಳ ಮೇಲೆ ಆಳುತ್ತೀರಲ್ಲವೋ? ಯಾವನೂ ನಿಮ್ಮನ್ನು ಎದುರಿಸಲಾಗದ ಹಾಗೆ ನಿಮ್ಮ ಕೈಯಲ್ಲಿ ಶಕ್ತಿಯೂ, ಪರಾಕ್ರಮವೂ ಇಲ್ಲವೋ? <verse eid="2CH 20:6"/><verse number="7" style="v" sid="2CH 20:7"/>ನೀವು ನಿಮ್ಮ ಜನವಾದ ಇಸ್ರಾಯೇಲಿನ ಎದುರಿನಿಂದ ಈ ದೇಶದ ನಿವಾಸಿಗಳನ್ನು ಓಡಿಸಿಬಿಟ್ಟು, ಅದನ್ನು ನಿಮ್ಮ ಸ್ನೇಹಿತನಾದ ಅಬ್ರಹಾಮನ ಸಂತತಿಗೆ ಎಂದೆಂದಿಗೂ ಕೊಟ್ಟ ನೀವು, ನಮ್ಮ ದೇವರಲ್ಲವೋ? <verse eid="2CH 20:7"/><verse number="8" style="v" sid="2CH 20:8"/>ಅವರು ಅದರಲ್ಲಿ ನಿವಾಸಮಾಡಿ, ಅದರಲ್ಲಿ ನಿಮ್ಮ ಹೆಸರಿಗೆ ಪರಿಶುದ್ಧವಾದ ಸ್ಥಳವನ್ನು ಕಟ್ಟಿಸಿ, <verse eid="2CH 20:8"/><verse number="9" style="v" sid="2CH 20:9"/>‘ನಿಮ್ಮ ಹೆಸರು ಈ ಆಲಯದಲ್ಲಿರುವುದರಿಂದ ಖಡ್ಗವೂ ನ್ಯಾಯತೀರಿಸುವ ಶಿಕ್ಷೆಯೂ, ಘೋರವ್ಯಾಧಿಯೂ ಬರವೇನಾದರೂ ನಮ್ಮ ಮೇಲೆ ಬಂದರೆ, ನಾವು ಈ ಆಲಯದ ಮುಂದೆಯೂ, ನಿಮ್ಮ ಸಮ್ಮುಖದಲ್ಲಿಯೂ ನಿಂತು, ನಮ್ಮ ಇಕ್ಕಟ್ಟಿನಲ್ಲಿ ನಿಮ್ಮನ್ನು ಕೂಗುವಾಗ, ನೀವು ಕೇಳಿ ರಕ್ಷಿಸುವಿರಿ,’ ಎಂದು ಹೇಳಲಿಲ್ಲವೇ?<verse eid="2CH 20:9"/></para>
  <para style="pm">
    <verse number="10" style="v" sid="2CH 20:10"/>“ಈಗ, ಅಮ್ಮೋನ್ ಮೋವಾಬ್, ಸೇಯೀರ್ ಬೆಟ್ಟದ ಜನರು, ಇಸ್ರಾಯೇಲರು ಈಜಿಪ್ಟ್ ದೇಶದೊಳಗಿಂದ ಹೊರಟು ಬರುವಾಗ, ಅವರ ಕಡೆಗೆ ಹೋಗಲು ನೀವು ಇವರಿಗೆ ಅಪ್ಪಣೆ ಕೊಡದೆ ಇದ್ದುದರಿಂದ, ಇವರು ಅವರನ್ನು ಬಿಟ್ಟು ತೊಲಗಿ ಅವರನ್ನು ನಾಶಮಾಡದೆ ಹೋದರು. <verse eid="2CH 20:10"/><verse number="11" style="v" sid="2CH 20:11"/>ಅವರು ಬಂದು, ನೀವು ನಮಗೆ ಸ್ವಾಧೀನಮಾಡಿಕೊಳ್ಳಲು ಕೊಟ್ಟ ನಿಮ್ಮ ಸ್ವಾಸ್ತ್ಯದೊಳಗಿಂದ ನಮ್ಮನ್ನು ಹೊರಡಿಸುವುದರಿಂದ ನಮಗೆ ಪ್ರತೀಕಾರ ಮಾಡುತ್ತಾರೆ. <verse eid="2CH 20:11"/><verse number="12" style="v" sid="2CH 20:12"/>ನಮ್ಮ ದೇವರೇ, ನೀವು ಅವರಿಗೆ ನ್ಯಾಯತೀರಿಸುವುದಿಲ್ಲವೋ? ನಮಗೆ ವಿರೋಧವಾಗಿ ಬರುವ ಈ ಮಹಾ ಗುಂಪನ್ನು ಎದುರಿಸಲು ನಮಗೆ ಶಕ್ತಿ ಇಲ್ಲ. ನಾವು ಏನು ಮಾಡಬೇಕೋ ತಿಳಿಯದು. ಆದರೆ ನಮ್ಮ ಕಣ್ಣುಗಳು ನಿಮ್ಮ ಮೇಲೆ ಇವೆ,” ಎಂದನು.<verse eid="2CH 20:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="2CH 20:13"/>ಹೀಗೆ ಯೆಹೂದದವರೆಲ್ಲರು ತಮ್ಮ ಹೆಂಡತಿಯರು, ಮಕ್ಕಳು, ಚಿಕ್ಕವರು ಸಹಿತವಾಗಿ ಯೆಹೋವ ದೇವರ ಮುಂದೆ ನಿಂತರು.<verse eid="2CH 20:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="2CH 20:14"/>ಆಗ ಜನಸಮೂಹದ ಮಧ್ಯದಲ್ಲಿ ಆಸಾಫನ ವಂಶದಲ್ಲಿ ಒಬ್ಬನಾದಂಥ ಲೇವಿಯನಾದ ಯಹಜಿಯೇಲನ ಮೇಲೆ ಯೆಹೋವ ದೇವರ ಆತ್ಮ ಬರಲು, ಇವನು ಮತ್ತನ್ಯನಿಗೆ ಹುಟ್ಟಿದ ಯೆಹೀಯೇಲನ ಮರಿಮಗ, ಬೆನಾಯನ ಮೊಮ್ಮಗ, ಹಾಗೂ ಜೆಕರ್ಯನ ಮಗ.<verse eid="2CH 20:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="2CH 20:15"/>ಆಗ ಯಹಜೀಯೇಲನು, “ಯೆಹೂದದ ಸಮಸ್ತರೇ, ಯೆರೂಸಲೇಮಿನ ನಿವಾಸಿಗಳೇ, ಅರಸನಾದ ಯೆಹೋಷಾಫಾಟನೇ, ಕೇಳಿರಿ. ಯೆಹೋವ ದೇವರು ನಿಮಗೆ ಹೀಗೆ ಹೇಳುತ್ತಾರೆ: ಈ ಮಹಾ ಗುಂಪಿನ ನಿಮಿತ್ತ ನೀವು ಭಯಪಡಬೇಡಿರಿ, ಹೆದರಬೇಡಿರಿ. ಏಕೆಂದರೆ ಯುದ್ಧವು ನಿಮ್ಮದಲ್ಲ, ದೇವರದೇ. <verse eid="2CH 20:15"/><verse number="16" style="v" sid="2CH 20:16"/>ನಾಳೆ ಬೆಳಿಗ್ಗೆ ನೀವು ಅವರ ವಿರೋಧವಾಗಿ ಹೋಗಿರಿ. ಅವರು ಚೀಚ್ ಎಂಬ ಕಣಿವೆಯಿಂದ ಬರುತ್ತಾರೆ. ಯೆರೂಯೇಲ್ ಮರುಭೂಮಿಯ ಮುಂಭಾಗದಲ್ಲಿರುವ ಹಳ್ಳದ ಅಂತ್ಯದಲ್ಲಿ ಅವರನ್ನು ಕಂಡುಕೊಳ್ಳುವಿರಿ. <verse eid="2CH 20:16"/><verse number="17" style="v" sid="2CH 20:17"/>ಇದರಲ್ಲಿ ನೀವು ಯುದ್ಧಮಾಡಲು ಅವಶ್ಯವಲ್ಲ. ನೀವು ನೆಲೆಯಾಗಿ ನಿಂತುಕೊಂಡು, ಯೆಹೋವ ದೇವರು ನಿಮಗೆ ಕೊಡುವ ಬಿಡುಗಡೆಯನ್ನು ನೋಡಿರಿ. ಯೆಹೂದದವರೇ, ಯೆರೂಸಲೇಮಿನವರೇ, ಭಯಪಡಬೇಡಿರಿ, ಹೆದರಬೇಡಿರಿ. ಮೂರನೇ ದಿವಸ ಅವರೆದುರಿಗೆ ಹೊರಟು ಹೋಗಿರಿ. ಯೆಹೋವ ದೇವರು ನಿಮ್ಮ ಸಂಗಡ ಇದ್ದಾರೆ,” ಎಂದನು.<verse eid="2CH 20:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="2CH 20:18"/>ಆಗ ಯೆಹೋಷಾಫಾಟನು ತನ್ನ ಮುಖವನ್ನು ನೆಲಕ್ಕೆ ಬಾಗಿಸಿದನು. ಯೆಹೂದದವರೆಲ್ಲರೂ, ಯೆರೂಸಲೇಮಿನ ನಿವಾಸಿಗಳೆಲ್ಲರೂ ಯೆಹೋವ ದೇವರ ಮುಂದೆ ಅಡ್ಡಬಿದ್ದು ಯೆಹೋವ ದೇವರನ್ನು ಆರಾಧಿಸಿದರು. <verse eid="2CH 20:18"/><verse number="19" style="v" sid="2CH 20:19"/>ಇದಲ್ಲದೆ ಕೊಹಾತ್ಯರ ಮಕ್ಕಳಲ್ಲಿಯೂ, ಕೋರಹೀಯರ ಮಕ್ಕಳಲ್ಲಿರುವ ಲೇವಿಯರು ಗಟ್ಟಿಯಾಗಿ ದೊಡ್ಡ ಶಬ್ದದಿಂದ ಇಸ್ರಾಯೇಲಿನ ದೇವರಾದ ಯೆಹೋವ ದೇವರನ್ನು ಸ್ತುತಿಸಲು ಎದ್ದು ನಿಂತರು.<verse eid="2CH 20:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="2CH 20:20"/>ಅವರು ಉದಯದಲ್ಲಿ ಎದ್ದು ತೆಕೋವದ ಮರುಭೂಮಿಗೆ ಹೊರಟರು. ಅವರು ಹೊರಟು ಹೋಗುತ್ತಿರುವಾಗ ಯೆಹೋಷಾಫಾಟನು ನಿಂತುಕೊಂಡು, “ಯೆಹೂದದವರೇ, ಯೆರೂಸಲೇಮಿನ ನಿವಾಸಿಗಳೇ, ನನ್ನ ಮಾತನ್ನು ಕೇಳಿರಿ. ನಿಮ್ಮ ದೇವರಾದ ಯೆಹೋವ ದೇವರನ್ನು ನಂಬಿ ಸ್ಥಿರವಾಗಿರಿ. ದೇವರ ಪ್ರವಾದಿಗಳನ್ನು ನಂಬಿರಿ, ಆಗ ಜಯ ಹೊಂದುವಿರಿ,” ಎಂದನು. <verse eid="2CH 20:20"/><verse number="21" style="v" sid="2CH 20:21"/>ಜನರ ಸಂಗಡ ಆಲೋಚನೆ ಮಾಡಿದ ತರುವಾಯ ಯೆಹೋಷಾಫಾಟನು, ಪರಿಶುದ್ಧತ್ವದ ವೈಭವದಿಂದ ಯೆಹೋವ ದೇವರಿಗೆ ಹಾಡುವಂತೆ ಸಂಗೀತಗಾರರನ್ನು ನೇಮಿಸಿದನು. ಅವರು ಸೈನ್ಯದ ಮುಂದೆ ಹೋಗುತ್ತಾ,</para>
  <para style="q1" vid="2CH 20:21">“ಯೆಹೋವ ದೇವರಿಗೆ ಕೃತಜ್ಞತಾ ಸ್ತುತಿಮಾಡಿರಿ.</para>
  <para style="q2" vid="2CH 20:21">ಅವರ ಪ್ರೀತಿಯು ಯುಗಯುಗಕ್ಕೂ ಇರುವುದು,”</para>
  <para style="m" vid="2CH 20:21">ಎಂದು ಹಾಡುವಂತೆ ನೇಮಿಸಿದನು.<verse eid="2CH 20:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="2CH 20:22"/>ಅವರು ಹಾಡುವುದಕ್ಕೂ, ಸ್ತುತಿಸುವುದಕ್ಕೂ ಆರಂಭಿಸಿದಾಗಲೇ ಯೆಹೋವ ದೇವರು ಯೆಹೂದದ ಮೇಲೆ ಬಂದ ಅಮ್ಮೋನ್, ಮೋವಾಬ್, ಸೇಯೀರ್ ಪರ್ವತಗಳ ಜನರನ್ನು ಸೋಲಿಸುವುದಕ್ಕೆ ಅವರಲ್ಲಿಯೇ ಹೊಂಚಿಕೊಳ್ಳುವವರನ್ನು ಇರಿಸಿದ್ದರು. <verse eid="2CH 20:22"/><verse number="23" style="v" sid="2CH 20:23"/>ಅಮ್ಮೋನಿಯರು, ಮೋವಾಬ್ಯರು ಸೇಯೀರ್ ಪರ್ವತದ ನಿವಾಸಿಗಳನ್ನು ಸಂಪೂರ್ಣವಾಗಿ ನಾಶಮಾಡಲು ನಿಂತರು. ಅವರು ಸೇಯೀರನ ನಿವಾಸಿಗಳನ್ನು ಪೂರ್ಣವಾಗಿ ವಧಿಸಿದ ತರುವಾಯ, ತಾವೇ ಒಬ್ಬರನ್ನೊಬ್ಬರು ಕೊಲ್ಲುವುದಕ್ಕೆ ಪ್ರಾರಂಭಿಸಿದರು.<verse eid="2CH 20:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="2CH 20:24"/>ಯೆಹೂದದವರು ಮರುಭೂಮಿಯಲ್ಲಿರುವ ಎತ್ತರದ ಸ್ಥಳಕ್ಕೆ ಬಂದು, ಅಲ್ಲಿನ ಗುಂಪನ್ನು ನೋಡಿದಾಗ, ಅವರಲ್ಲಿ ಒಬ್ಬನೂ ಉಳಿಯದ ಹಾಗೆ ಎಲ್ಲರೂ ನೆಲಕ್ಕೆ ಬಿದ್ದು ಹೆಣಗಳಾಗಿದ್ದರು. <verse eid="2CH 20:24"/><verse number="25" style="v" sid="2CH 20:25"/>ಯೆಹೋಷಾಫಾಟನೂ, ಅವನ ಜನರೂ ಅವರ ವಸ್ತ್ರಗಳನ್ನೂ, ವಸ್ತುಗಳನ್ನೂ ಕೊಳ್ಳೆಮಾಡಲು ಬಂದಾಗ, ಅವರು ಹೆಣಗಳ ಬಳಿಯಲ್ಲಿ ದ್ರವ್ಯವನ್ನೂ, ಆಭರಣಗಳನ್ನೂ ಬಹಳವಾಗಿ ಕಂಡುಕೊಂಡು, ತಾವು ಒಯ್ಯಲಿಕ್ಕಾಗದಷ್ಟು ಹೆಚ್ಚಾಗಿ ಸುಲಿದುಕೊಂಡರು. ಕೊಳ್ಳೆಯು ಅಷ್ಟು ಅಧಿಕವಾದುದರಿಂದ ಅದನ್ನು ಮೂರು ದಿವಸಗಳವರೆಗೂ ಸುಲಿದುಕೊಳ್ಳುತ್ತಾ ಇದ್ದರು. <verse eid="2CH 20:25"/><verse number="26" style="v" sid="2CH 20:26"/>ನಾಲ್ಕನೆಯ ದಿವಸದಲ್ಲಿ ಅವರು ಬೆರಾಕವೆಂಬ ತಗ್ಗಿನಲ್ಲಿ ಕೂಡಿಕೊಂಡರು. ಅಲ್ಲಿ ಯೆಹೋವ ದೇವರನ್ನು ಸ್ತುತಿಸಿದರು. ಆದಕಾರಣ ಇಂದಿನವರೆಗೂ ಆ ಸ್ಥಳಕ್ಕೆ ಬೆರಾಕ<note caller="+" style="f"><char style="fr" closed="false">20:26 </char><char style="fq" closed="false">ಬೆರಾಕ </char><char style="ft" closed="false">ಅಂದರೆ </char><char style="fqa" closed="false">ಸ್ತುತಿಸುವುದು</char></note> ತಗ್ಗು ಎಂದು ಕರೆಯುತ್ತಾರೆ.<verse eid="2CH 20:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="2CH 20:27"/>ಯೆಹೋವ ದೇವರು ಅವರ ಶತ್ರುಗಳ ಮೇಲೆ ಅವರು ಸಂತೋಷಪಡುವಂತೆ ಮಾಡಿದ್ದರಿಂದ, ಅವರು ಹರ್ಷಗೊಂಡು ಯೆರೂಸಲೇಮಿಗೆ ತಿರುಗಿ ಹೋಗುವುದಕ್ಕೆ ಯೆಹೂದ ಮತ್ತು ಯೆರೂಸಲೇಮಿನವರ ಮುಂಭಾಗದಲ್ಲಿ ಯೆಹೋಷಾಫಾಟನೂ ಹೊರಟು, <verse eid="2CH 20:27"/><verse number="28" style="v" sid="2CH 20:28"/>ಸ್ವರಮಂಡಲ, ಕಿನ್ನರಿ, ತುತೂರಿ ಇವುಗಳೊಡನೆ ಯೆರೂಸಲೇಮಿನಲ್ಲಿರುವ ಯೆಹೋವ ದೇವರ ಆಲಯಕ್ಕೆ ಬಂದರು.<verse eid="2CH 20:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="2CH 20:29"/>ಯೆಹೋವ ದೇವರು ಇಸ್ರಾಯೇಲರ ಶತ್ರುಗಳ ಮೇಲೆ ಯುದ್ಧ ಮಾಡಿದರೆಂದು ಜನರು ಕೇಳಿದಾಗ, ದೇವರ ಭಯವು ಆ ದೇಶದಲ್ಲಿ ಸಕಲ ರಾಜ್ಯಗಳ ಮೇಲೆ ಇತ್ತು. <verse eid="2CH 20:29"/><verse number="30" style="v" sid="2CH 20:30"/>ಹೀಗೆ ಯೆಹೋಷಾಫಾಟನ ರಾಜ್ಯವು ಶಾಂತವಾಗಿತ್ತು. ಅವನ ದೇವರು ಸುತ್ತಲೂ ಅವನಿಗೆ ವಿಶ್ರಾಂತಿಕೊಟ್ಟರು.<verse eid="2CH 20:30"/></para>
  <para style="s1">ಯೆಹೋಷಾಫಾಟನ ಆಳಿಕೆಯ ಸಮಾಪ್ತಿಯು</para>
  <para style="p">
    <verse number="31" style="v" sid="2CH 20:31"/>ಯೆಹೋಷಾಫಾಟನು ಯೆಹೂದ್ಯರ ಮೇಲೆ ಆಳಿದನು. ಅವನು ಅರಸನಾದಾಗ ಮೂವತ್ತೈದು ವರ್ಷದವನಾಗಿದ್ದನು. ಯೆರೂಸಲೇಮಿನಲ್ಲಿ ಇಪ್ಪತ್ತೈದು ವರ್ಷ ಆಳಿದನು. ಶಿಲ್ಹಿಯ ಮಗಳಾದ ಅಜೂಬಳೆಂಬಾಕೆಯು ಅವನ ತಾಯಿ. <verse eid="2CH 20:31"/><verse number="32" style="v" sid="2CH 20:32"/>ಅವನು ತನ್ನ ತಂದೆ ಆಸನ ಮಾರ್ಗಗಳಲ್ಲಿ ನಡೆದು, ಅದನ್ನು ಬಿಟ್ಟು ತೊಲಗದೇ, ಯೆಹೋವ ದೇವರ ದೃಷ್ಟಿಯಲ್ಲಿ ಸರಿಯಾದದ್ದನ್ನು ಮಾಡಿದನು. <verse eid="2CH 20:32"/><verse number="33" style="v" sid="2CH 20:33"/>ಆದರೂ ಪೂಜಾಸ್ಥಳಗಳನ್ನು ತೆಗೆದುಹಾಕಲಿಲ್ಲ. ಜನರು ಅವರ ಹೃದಯಗಳನ್ನು ತಮ್ಮ ಪಿತೃಗಳ ದೇವರ ಕಡೆಗೆ ಇನ್ನೂ ಸ್ಥಿರ ಮಾಡಿಕೊಂಡಿರಲಿಲ್ಲ.<verse eid="2CH 20:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="2CH 20:34"/>ಯೆಹೋಷಾಫಾಟನ ಇತರ ಕ್ರಿಯೆಗಳು, ಆರಂಭದಿಂದ ಅಂತ್ಯದವರೆಗೆ, ಇಸ್ರಾಯೇಲರ ಅರಸುಗಳ ಗ್ರಂಥದಲ್ಲಿ, ಅಂದರೆ, ಹನಾನೀಯ ಮಗನಾದ ಯೇಹುವಿನ ಗ್ರಂಥದಲ್ಲಿ ಬರೆದಿರುತ್ತವೆ.<verse eid="2CH 20:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="2CH 20:35"/>ಇದರ ತರುವಾಯ ಯೆಹೂದದ ಅರಸನಾದ ಯೆಹೋಷಾಫಾಟನು, ಬಹು ದುಷ್ಟನಾಗಿ ನಡೆದ ಇಸ್ರಾಯೇಲಿನ ಅರಸನಾದ ಅಹಜ್ಯನ ಸಂಗಡ ಒಪ್ಪಂದ ಮಾಡಿಕೊಂಡನು. <verse eid="2CH 20:35"/><verse number="36" style="v" sid="2CH 20:36"/>ಇದಲ್ಲದೆ ತಾರ್ಷೀಷಿಗೆ ಹೋಗುವುದಕ್ಕಾಗಿ ಹಡಗುಗಳನ್ನು ಮಾಡಿಸಲು, ಅವನ ಸಂಗಡ ಒಪ್ಪಂದ ಮಾಡಿಕೊಂಡು ಎಚ್ಯೋನ್ ಗೆಬೆರಿನಲ್ಲಿ ಹಡಗುಗಳನ್ನು ಮಾಡಿಸಿದರು. <verse eid="2CH 20:36"/><verse number="37" style="v" sid="2CH 20:37"/>ಆಗ ಮಾರೇಷಾ ಊರಿನ ದೋದವಾಹುವಿನ ಮಗನಾದ ಎಲೀಯೆಜೆರನು ಯೆಹೋಷಾಫಾಟನಿಗೆ ವಿರೋಧವಾಗಿ ಪ್ರವಾದಿಸಿ, “ನೀನು ಅಹಜ್ಯನ ಸಂಗಡ ಒಪ್ಪಂದ ಮಾಡಿಕೊಂಡಿದ್ದರಿಂದ, ಯೆಹೋವ ದೇವರು ನೀನು ಮಾಡಿದವುಗಳನ್ನು ನಾಶಮಾಡುವರು,” ಎಂದು ಹೇಳಿದನು. ಅದರಂತೆಯೇ, ಆ ಹಡಗುಗಳು ತಾರ್ಷೀಷಿಗೆ ಹೋಗದೆ ಒಡೆದುಹೋದವು.<verse eid="2CH 20:37"/></para>
  <chapter eid="2CH 20"/>
  <chapter number="21" style="c" sid="2CH 21"/>
  <para style="p">
    <verse number="1" style="v" sid="2CH 21:1"/>ಯೆಹೋಷಾಫಾಟನು ಮೃತನಾಗಿ ತನ್ನ ಪಿತೃಗಳ ಜೊತೆ ಸೇರಿದನು. ಅವನ ಶವವನ್ನು ದಾವೀದನ ಪಟ್ಟಣದೊಳಗೆ ಅವನ ಪೂರ್ವಜರ ಸ್ಮಶಾನಭೂಮಿಯಲ್ಲಿ ಸಮಾಧಿಮಾಡಿದರು. ಆಗ ಅವನಿಗೆ ಬದಲಾಗಿ ಅವನ ಮಗನಾದ ಯೆಹೋರಾಮನು ಅರಸನಾದನು. <verse eid="2CH 21:1"/><verse number="2" style="v" sid="2CH 21:2"/>ಇವನ ಸಹೋದರರಾಗಿರುವ ಯೆಹೋಷಾಫಾಟನ ಪುತ್ರರಾದ ಅಜರ್ಯನೂ, ಯೆಹೀಯೇಲನೂ, ಜೆಕರ್ಯನೂ, ಅಜರ್ಯನೂ, ಮೀಕಾಯೇಲನೂ, ಶೆಫಟ್ಯನೂ ಇದ್ದರು. ಇವರೆಲ್ಲರು ಯೆಹೂದ್ಯರ ಅರಸನಾದ ಯೆಹೋಷಾಫಾಟನ ಪುತ್ರರು. <verse eid="2CH 21:2"/><verse number="3" style="v" sid="2CH 21:3"/>ಅವರ ತಂದೆ ಯೆಹೂದದಲ್ಲಿ ಕೋಟೆಯುಳ್ಳ ಪಟ್ಟಣಗಳ ಸಂಗಡ ಬೆಳ್ಳಿಯನ್ನೂ, ಬಂಗಾರವನ್ನೂ, ಬೆಲೆಯುಳ್ಳ ವಸ್ತುಗಳನ್ನೂ ಅವರಿಗೆ ದಾನಗಳಾಗಿ ಕೊಟ್ಟನು. ಆದರೆ ಯೆಹೋರಾಮನು ಚೊಚ್ಚಲ ಮಗನಾದುದರಿಂದ ಅವನಿಗೆ ರಾಜ್ಯವನ್ನು ಕೊಟ್ಟನು.<verse eid="2CH 21:3"/></para>
  <para style="s1">ಯೆಹೂದ್ಯರ ಅರಸನಾದ ಯೆಹೋರಾಮನು</para>
  <para style="p">
    <verse number="4" style="v" sid="2CH 21:4"/>ಯೆಹೋರಾಮನು ತನ್ನ ತಂದೆಯ ರಾಜ್ಯಕ್ಕೆ ಬಂದ ತರುವಾಯ, ಅವನು ತನ್ನನ್ನು ಬಲಪಡಿಸಿಕೊಂಡು ತನ್ನ ಸಮಸ್ತ ಸಹೋದರರನ್ನೂ, ಇಸ್ರಾಯೇಲಿನ ಪ್ರಧಾನರಲ್ಲಿ ಕೆಲವರನ್ನೂ ಖಡ್ಗದಿಂದ ಕೊಂದುಹಾಕಿದನು. <verse eid="2CH 21:4"/><verse number="5" style="v" sid="2CH 21:5"/>ಯೆಹೋರಾಮನು ಆಳಲಾರಂಭಿಸಿದಾಗ ಮೂವತ್ತೆರಡು ವರ್ಷದವನಾಗಿದ್ದು, ಯೆರೂಸಲೇಮಿನಲ್ಲಿ ಎಂಟು ವರ್ಷ ಆಳಿದನು. <verse eid="2CH 21:5"/><verse number="6" style="v" sid="2CH 21:6"/>ಅಹಾಬನ ಮಗಳು ಅವನಿಗೆ ಹೆಂಡತಿಯಾಗಿದ್ದರಿಂದ ಅವನು ಅಹಾಬನ ಮನೆಯವರು ನಡೆದ ಹಾಗೆ ಇಸ್ರಾಯೇಲರ ಅರಸರ ಮಾರ್ಗವನ್ನು ಅನುಸರಿಸಿ ಯೆಹೋವ ದೇವರ ದೃಷ್ಟಿಯಲ್ಲಿ ಕೆಟ್ಟದ್ದನ್ನು ಮಾಡಿದನು. <verse eid="2CH 21:6"/><verse number="7" style="v" sid="2CH 21:7"/>ಆದರೆ ಯೆಹೋವ ದೇವರು ದಾವೀದನಿಗೆ, “ನಿನ್ನ ಮತ್ತು ನಿನ್ನ ಸಂತಾನದವರ ದೀಪವನ್ನು ಎಂದೂ ನಂದಿಸುವುದಿಲ್ಲ,” ಎಂದು ಪ್ರಮಾಣ ಮಾಡಿದ ಕಾರಣ, ದೇವರು ದಾವೀದನ ಮನೆತನದವರನ್ನು ನಾಶಮಾಡುವುದಕ್ಕೆ ಇಷ್ಟಪಡಲಿಲ್ಲ.<verse eid="2CH 21:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="2CH 21:8"/>ಯೆಹೋರಾಮನ ದಿನಗಳಲ್ಲಿ ಯೆಹೂದದ ಕೈಕೆಳಗಿದ್ದ ಎದೋಮ್ಯರು ತಿರುಗಿಬಿದ್ದು, ತಮ್ಮ ಅರಸನನ್ನು ತಾವೇ ನೇಮಿಸಿಕೊಂಡರು. <verse eid="2CH 21:8"/><verse number="9" style="v" sid="2CH 21:9"/>ಆಗ ಯೆಹೋರಾಮನು ತನ್ನ ಪ್ರಧಾನರ ಸಂಗಡ, ಎಲ್ಲಾ ರಥಬಲವನ್ನು ತೆಗೆದುಕೊಂಡುಹೋಗಿ, ರಾತ್ರಿಯಲ್ಲಿ ಎದ್ದು, ತನ್ನನ್ನೂ, ತನ್ನ ರಥಗಳ ಅಧಿಪತಿಗಳನ್ನೂ ಸುತ್ತುವರೆದಿದ್ದ ಎದೋಮ್ಯರನ್ನು ಸೋಲಿಸಿದನು. <verse eid="2CH 21:9"/><verse number="10" style="v" sid="2CH 21:10"/>ಯೆಹೂದ್ಯರಿಗೆ ವಿರೋಧವಾಗಿ ದಂಗೆಯೆದ್ದ ಎದೋಮ್ಯರು ಅಂದಿನಿಂದ ಇಂದಿನವರೆಗೂ ಸ್ವತಂತ್ರರಾಗಿದ್ದಾರೆ.</para>
  <para style="p" vid="2CH 21:10">ಅದೇ ಕಾಲದಲ್ಲಿ ಯೆಹೋರಾಮನು ತನ್ನ ಪಿತೃಗಳ ದೇವರಾದ ಯೆಹೋವ ದೇವರನ್ನು ಬಿಟ್ಟುಬಿಟ್ಟದ್ದರಿಂದ ಲಿಬ್ನದವರೂ ಅವನ ಕೈಯಿಂದ ತಪ್ಪಿಸಿಕೊಂಡು ಸ್ವತಂತ್ರರಾದರು. <verse eid="2CH 21:10"/><verse number="11" style="v" sid="2CH 21:11"/>ಅವನು ಯೆಹೂದದ ಪರ್ವತಗಳಲ್ಲಿ ಉನ್ನತ ಪೂಜಾಸ್ಥಳಗಳನ್ನು ಮಾಡಿ, ಯೆರೂಸಲೇಮಿನ ನಿವಾಸಿಗಳನ್ನು ವ್ಯಭಿಚಾರ ಮಾಡಲು ಪ್ರೇರೇಪಿಸಿ, ಹಾಗೆಯೇ ಮಾಡಲು ಯೆಹೂದದವರನ್ನು ಬಲವಂತ ಮಾಡಿದನು.<verse eid="2CH 21:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="2CH 21:12"/>ಆದಕಾರಣ ಪ್ರವಾದಿಯಾದ ಎಲೀಯನಿಂದ ಅವನಿಗೆ ಒಂದು ಪತ್ರವು ಬಂತು. ಅದರಲ್ಲಿ ಅವನು,</para>
  <para style="pm" vid="2CH 21:12">“ನಿನ್ನ ತಂದೆಯಾದ ದಾವೀದನ ದೇವರಾದ ಯೆಹೋವ ದೇವರು ಹೀಗೆ ಹೇಳುತ್ತಾರೆ: ‘ನೀನು ನಿನ್ನ ತಂದೆಯಾದ ಯೆಹೋಷಾಫಾಟನ ಮಾರ್ಗಗಳಲ್ಲಿಯೂ, ಯೆಹೂದದ ಅರಸನಾದ ಆಸನ ಮಾರ್ಗಗಳಲ್ಲಿಯೂ ನಡೆಯದೆ, <verse eid="2CH 21:12"/><verse number="13" style="v" sid="2CH 21:13"/>ಇಸ್ರಾಯೇಲಿನ ಅರಸುಗಳ ಮಾರ್ಗದಲ್ಲಿ ನಡೆದು, ಅಹಾಬನ ಮನೆಯವರು ದೇವದ್ರೋಹ ಮಾಡಿದಂತೆ, ಯೆಹೂದದವರನ್ನೂ, ಯೆರೂಸಲೇಮಿನ ನಿವಾಸಿಗಳನ್ನೂ ದ್ರೋಹ ಮಾಡಲು ಪ್ರೇರೇಪಿಸಿ, ನಿನಗಿಂತ ಉತ್ತಮರಾಗಿರುವ ನಿನ್ನ ತಂದೆಯ ಮನೆಯವರಾದ ನಿನ್ನ ಸಹೋದರರನ್ನು ಕೊಂದುಹಾಕಿದ್ದರಿಂದ, <verse eid="2CH 21:13"/><verse number="14" style="v" sid="2CH 21:14"/>ಯೆಹೋವ ದೇವರು ದೊಡ್ಡ ಬಾಧೆಯಿಂದ ನಿನ್ನ ಜನರನ್ನೂ, ನಿನ್ನ ಮಕ್ಕಳನ್ನೂ, ನಿನ್ನ ಹೆಂಡತಿಯರನ್ನೂ, ನಿನ್ನ ಸಮಸ್ತ ಸ್ಥಿತಿಯನ್ನೂ ಬಾಧಿಸುತ್ತಾರೆ. <verse eid="2CH 21:14"/><verse number="15" style="v" sid="2CH 21:15"/>ಇದಲ್ಲದೆ ದಿನದಿನಕ್ಕೆ ರೋಗ ಅನುಭವಿಸುವುದರಿಂದ ನಿನ್ನ ಕರುಳುಗಳು ಹೊರಕ್ಕೆ ಬರುವವರೆಗೆ ಕರುಳುಬೇನೆಯ ರೋಗದಿಂದ ನಿನಗೆ ಕಠಿಣರೋಗ ಬರುವುದು,’ ” ಎಂದು ಬರೆದಿದ್ದನು.<verse eid="2CH 21:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="2CH 21:16"/>ಇದಲ್ಲದೆ ಕೂಷ್ಯರ ಬಳಿಯಲ್ಲಿದ್ದ ಫಿಲಿಷ್ಟಿಯರ ಮತ್ತು ಅರಬಿಯರ ಮನಸ್ಸನ್ನು ಯೆಹೋರಾಮನಿಗೆ ವಿರೋಧವಾಗಿ ಯೆಹೋವ ದೇವರು ಎಬ್ಬಿಸಿದರು. <verse eid="2CH 21:16"/><verse number="17" style="v" sid="2CH 21:17"/>ಆಗ ಅವರು ಯೆಹೂದದ ಮೇಲೆ ಬಂದು ಅದರಲ್ಲಿ ನುಗ್ಗಿ, ಅರಸನ ಅರಮನೆಯಲ್ಲಿ ಸಿಕ್ಕಿದ ಸಮಸ್ತ ಸ್ಥಿತಿಯನ್ನೂ, ಅವನ ಪುತ್ರರನ್ನೂ, ಅವನ ಹೆಂಡತಿಯರನ್ನೂ ತೆಗೆದುಕೊಂಡು ಹೋದರು. ಆದ್ದರಿಂದ ಅವನ ಪುತ್ರರಲ್ಲಿ ಚಿಕ್ಕವನಾದ ಯೆಹೋವಾಹಾಜನ ಹೊರತು ಅವನಿಗೆ ಪುತ್ರರು ಯಾರೂ ಉಳಿಯಲಿಲ್ಲ.<verse eid="2CH 21:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="2CH 21:18"/>ಇದೆಲ್ಲದರ ತರುವಾಯ ಯೆಹೋವ ದೇವರು ಯೆಹೋರಾಮನ ಕರುಳುಗಳಲ್ಲಿ ವಾಸಿಯಾಗಲಾರದ ರೋಗದಿಂದ ಅವನನ್ನು ಬಾಧಿಸಿದರು. <verse eid="2CH 21:18"/><verse number="19" style="v" sid="2CH 21:19"/>ಎರಡು ವರ್ಷವಾದ ತರುವಾಯ, ಅವನ ರೋಗದಿಂದ ಅವನ ಕರುಳುಗಳು ಹೊರಕ್ಕೆ ಬಂದವು. ಹೀಗೆ ಅವನು ಕಡುಬೇನೆಯಿಂದ ಸತ್ತನು. ಅವನ ಜನರು ಅವನ ಪಿತೃಗಳಿಗೆ ಗೌರವಕ್ಕೋಸ್ಕರ ಅಗ್ನಿಕುಂಡ ಹಚ್ಚಲಿಲ್ಲ.<verse eid="2CH 21:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="2CH 21:20"/>ಯೆಹೋರಾಮ್ ಆಳಲಾರಂಭಿಸಿದಾಗ ಮೂವತ್ತೆರಡು ವರ್ಷದವನಾಗಿದ್ದು, ಯೆರೂಸಲೇಮಿನಲ್ಲಿ ಎಂಟು ವರ್ಷ ಆಳಿದನು. ಅವನು ಮರಣಹೊಂದಿದಾಗ ಯಾರೂ ಶೋಕಿಸಲಿಲ್ಲ ಆದರೂ ಅವರು ಅವನನ್ನು ದಾವೀದನ ಪಟ್ಟಣದಲ್ಲಿ ಸಮಾಧಿಮಾಡಿದರು. ಆದರೆ ಅರಸರ ಸಮಾಧಿಗಳಲ್ಲಿ ಅಲ್ಲ.<verse eid="2CH 21:20"/></para>
  <chapter eid="2CH 21"/>
  <chapter number="22" style="c" sid="2CH 22"/>
  <para style="s1">ಯೆಹೂದ್ಯರ ಅರಸನಾದ ಅಹಜ್ಯನು</para>
  <para style="p">
    <verse number="1" style="v" sid="2CH 22:1"/>ಯೆರೂಸಲೇಮಿನ ನಿವಾಸಿಗಳು ಯೆಹೋರಾಮನಿಗೆ ಬದಲಾಗಿ ಅವನ ಚಿಕ್ಕ ಮಗನಾದ ಅಹಜ್ಯನನ್ನು ಅರಸನಾಗಿ ಮಾಡಿದರು. ಏಕೆಂದರೆ ಪಾಳೆಯಕ್ಕೆ ಬಂದ ಅರಬಿಯರ ಗುಂಪು ಹಿರಿಯ ಮಕ್ಕಳನ್ನೆಲ್ಲಾ ಕೊಂದುಹಾಕಿದರು. ಹೀಗೆಯೇ ಯೆಹೋರಾಮನ ಮಗನಾದ ಅಹಜ್ಯನು ಯೆಹೂದದ ಅರಸನಾಗಿ ಆಳಲು ಆರಂಭಿಸಿದನು.<verse eid="2CH 22:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="2CH 22:2"/>ಅಹಜ್ಯನು ಆಳಲು ಆರಂಭಿಸಿದಾಗ ಇಪ್ಪತ್ತೆರಡು ವರ್ಷದವನಾಗಿದ್ದು, ಯೆರೂಸಲೇಮಿನಲ್ಲಿ ಒಂದು ವರ್ಷ ಆಳಿದನು. ಅವನ ತಾಯಿಯ ಹೆಸರು ಅತಲ್ಯಳು, ಈಕೆಯು ಒಮ್ರಿಯ ಮೊಮ್ಮಗಳು.<verse eid="2CH 22:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="2CH 22:3"/>ಅವನ ತಾಯಿಯ ದುರ್ಬೋಧನೆಯಿಂದ ಅವನು ದುಷ್ಟನಾಗಿ ಅಹಾಬನ ಮನೆಯವರ ಮಾರ್ಗಗಳಲ್ಲಿ ನಡೆದನು. <verse eid="2CH 22:3"/><verse number="4" style="v" sid="2CH 22:4"/>ಅವನು ಅಹಾಬನ ಕುಟುಂಬದಂತೆಯೇ ಯೆಹೋವ ದೇವರ ದೃಷ್ಟಿಯಲ್ಲಿ ಕೆಟ್ಟದ್ದನ್ನು ಮಾಡಿದನು, ಏಕೆಂದರೆ ಅವನ ತಂದೆಯ ಮರಣದ ನಂತರ ಅವರು ಅವನ ಸಲಹೆಗಾರರಾದರು. ಆದಕಾರಣ ಎಲ್ಲವೂ ನಾಶವಾಯಿತು. <verse eid="2CH 22:4"/><verse number="5" style="v" sid="2CH 22:5"/>ಅಹಜ್ಯನು ಇವರ ಯೋಚನೆಯ ಪ್ರಕಾರ ನಡೆದು, ಗಿಲ್ಯಾದಿನ ರಾಮೋತಿಗೆ ಅರಾಮಿನ ಅರಸನಾದ ಹಜಾಯೇಲನ ಮೇಲೆ ಯುದ್ಧಮಾಡಲು ಇಸ್ರಾಯೇಲಿನ ಅರಸನಾಗಿರುವ ಅಹಾಬನ ಮಗ ಯೋರಾಮನ ಸಂಗಡ ಹೋದನು. ಆದರೆ ಅರಾಮ್ಯರು ಯೋರಾಮನನ್ನು ಹೊಡೆದು ಗಾಯಗೊಳಿಸಿದರು. <verse eid="2CH 22:5"/><verse number="6" style="v" sid="2CH 22:6"/>ಆದ್ದರಿಂದ ಅವನು ಅರಾಮ್ಯ ದೇಶದ ಅರಸನಾದ ಹಜಾಯೇಲನ ಮೇಲೆ ಯುದ್ಧಮಾಡಿದಾಗ, ರಾಮೋತಿನಲ್ಲಿ ತನ್ನನ್ನು ಹೊಡೆದ ಗಾಯಗಳನ್ನು ಗುಣಪಡಿಸಿಕೊಳ್ಳುವುದಕ್ಕೆ ಇಜ್ರೆಯೇಲ್ ಪಟ್ಟಣಕ್ಕೆ ತಿರುಗಿಹೋದನು.</para>
  <para style="p" vid="2CH 22:6">ಆಗ ಅಹಾಬನ ಮಗ ಯೋರಾಮನು ಇಜ್ರೆಯೇಲಿನಲ್ಲಿ ಅಸ್ವಸ್ಥನಾಗಿದ್ದುದರಿಂದ ಯೆಹೂದದ ಅರಸನಾಗಿರುವ ಯೆಹೋರಾಮನ ಮಗ ಅಜರ್ಯನು<note caller="+" style="f"><char style="fr" closed="false">22:6 </char><char style="fq" closed="false">ಅಜರ್ಯ </char><char style="ft" closed="false">ಅಥವಾ </char><char style="fqa" closed="false">ಅಹಜ್ಯ</char></note> ಅವನನ್ನು ನೋಡಲು ಹೋದನು.<verse eid="2CH 22:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="2CH 22:7"/>ಯೋರಾಮನ ಬಳಿಗೆ ಅಹಜ್ಯನು ಬಂದಿದ್ದರಿಂದ ಅವನಿಗೆ ಉಂಟಾದ ನಷ್ಟವು ದೇವರಿಂದ ಆಯಿತು. ಹೇಗೆಂದರೆ, ಅಹಜ್ಯನು ಬಂದ ತರುವಾಯ ಯೆಹೋವ ದೇವರು ಅಹಾಬನ ಮನೆಯನ್ನು ಕಡಿದು ಬಿಡಲು ಅಭಿಷೇಕಿಸಿದ ನಿಂಷಿಯ ಮಗ ಯೇಹುವಿಗೆ ವಿರೋಧವಾಗಿ ಯೆಹೋರಾಮನ ಸಂಗಡ ಹೊರಟರು. <verse eid="2CH 22:7"/><verse number="8" style="v" sid="2CH 22:8"/>ಯೇಹುವು ಅಹಾಬನ ಮನೆಯ ಮೇಲೆ ನ್ಯಾಯ ತೀರಿಸುವಂತೆ ಅವನು ಯೆಹೂದ್ಯರ ಪ್ರಧಾನರನ್ನೂ, ಅಹಜ್ಯನನ್ನು ಸೇವಿಸುತ್ತಿರುವ ಅಹಜ್ಯನ ಸಹೋದರರ ಮಕ್ಕಳನ್ನೂ ಕಂಡುಹಿಡಿದು, ಅವರನ್ನು ಕೊಂದುಹಾಕಿದನು. <verse eid="2CH 22:8"/><verse number="9" style="v" sid="2CH 22:9"/>ಇದಲ್ಲದೆ ಯೇಹುವು ಅಹಜ್ಯನನ್ನು ಹುಡುಕಿದನು. ಅವನು ಸಮಾರ್ಯದಲ್ಲಿ ಬಚ್ಚಿಟ್ಟುಕೊಂಡದ್ದರಿಂದ ಅವನನ್ನು ಕಂಡುಹಿಡಿದು, ಯೇಹುವಿನ ಬಳಿಗೆ ಅವನನ್ನು ತೆಗೆದುಕೊಂಡು ಬಂದು, ಅವನನ್ನು ವಧಿಸಿದರು. “ಇವನು ಪೂರ್ಣಹೃದಯದಿಂದ ಯೆಹೋವ ದೇವರನ್ನು ಹುಡುಕಿದ ಯೆಹೋಷಾಫಾಟನ ಮಗನು,” ಎಂದು ಹೇಳಿ ಅವನನ್ನು ಸಮಾಧಿಮಾಡಿದರು. ಹೀಗೆ ರಾಜ್ಯದ ಅಧಿಕಾರವನ್ನು ವಹಿಸಿಕೊಳ್ಳುವದಕ್ಕೆ ಅಹಜ್ಯನ ಮನೆಯವರಲ್ಲಿ ಸಮರ್ಥರಾರೂ ಉಳಿಯಲಿಲ್ಲ.<verse eid="2CH 22:9"/></para>
  <para style="s1">ಅತಲ್ಯಳು ಮತ್ತು ಯೆಹೋಷಬತಳು</para>
  <para style="p">
    <verse number="10" style="v" sid="2CH 22:10"/>ಅಹಜ್ಯನ ತಾಯಿಯಾದ ಅತಲ್ಯಳು ತನ್ನ ಮಗನು ಸತ್ತು ಹೋದದ್ದನ್ನು ಕಂಡಾಗ, ಅವಳು ಎದ್ದು ಯೆಹೂದನ ಮನೆಯ ರಾಜಸಂತಾನದವರನ್ನೆಲ್ಲಾ ನಾಶಮಾಡಲು ಆರಂಭಿಸಿದಳು. <verse eid="2CH 22:10"/><verse number="11" style="v" sid="2CH 22:11"/>ಆದರೆ ಅರಸನಾದ ಯೆಹೋರಾಮನ ಮಗಳಾದ ಯೆಹೋಷಬತಳು, ಹತರಾಗುವುದಕ್ಕಿದ್ದ ಅರಸನ ಮಕ್ಕಳ ಮಧ್ಯದಿಂದ ಅಹಜ್ಯನ ಮಗನಾದ ಯೋವಾಷನನ್ನು ಕದ್ದುಕೊಂಡು ಹೋಗಿ ಅವನನ್ನೂ ಅವನ ದಾದಿಯನ್ನೂ ಮಲಗುವ ಕೋಣೆಯಲ್ಲಿ ಬಚ್ಚಿಟ್ಟಳು. ಹೀಗೆಯೇ ಅರಸನಾದ ಯೆಹೋರಾಮನ ಪುತ್ರಿಯರಾಗಿರುವ ಯಾಜಕನಾದ ಯೆಹೋಯಾದಾವನ ಹೆಂಡತಿಯಾಗಿರುವ ಅಹಜ್ಯನ ಸಹೋದರಿಯಾದ ಯೆಹೋಷಬತಳು, ಅತಲ್ಯಳು ಅವನನ್ನು ಕೊಲ್ಲದ ಹಾಗೆ ಬಚ್ಚಿಟ್ಟಳು. <verse eid="2CH 22:11"/><verse number="12" style="v" sid="2CH 22:12"/>ಹೀಗೆಯೇ ಇವನು ಅವರ ಸಂಗಡ ಆರು ವರ್ಷ ದೇವರ ಆಲಯದಲ್ಲಿ ಗುಪ್ತವಾಗಿದ್ದನು. ಈ ಆರು ವರ್ಷ ಅತಲ್ಯಳು ದೇಶವನ್ನು ಆಳುತ್ತಾ ಇದ್ದಳು.<verse eid="2CH 22:12"/></para>
  <chapter eid="2CH 22"/>
  <chapter number="23" style="c" sid="2CH 23"/>
  <para style="p">
    <verse number="1" style="v" sid="2CH 23:1"/>ಏಳನೆಯ ವರ್ಷದಲ್ಲಿ ಯೆಹೋಯಾದಾವನು ತನ್ನನ್ನು ಬಲಪಡಿಸಿಕೊಂಡು ಶತಾಧಿಪತಿಗಳಾಗಿರುವ ಯೆರೋಹಾಮನ ಮಗ ಅಜರ್ಯನನ್ನೂ, ಯೆಹೋಹಾನಾನನ ಮಗ ಇಷ್ಮಾಯೇಲನನ್ನೂ, ಓಬೇದನ ಮಗ ಅಜರ್ಯನನ್ನೂ, ಅದಾಯನ ಮಗ ಮಾಸೇಯನನ್ನೂ, ಜಿಕ್ರಿಯ ಮಗ ಎಲಿಷಾಫಾಟನನ್ನೂ ಕರೆದುಕೊಂಡು, ಅವರ ಸಂಗಡ ಒಡಂಬಡಿಕೆಯನ್ನು ಮಾಡಿದನು. <verse eid="2CH 23:1"/><verse number="2" style="v" sid="2CH 23:2"/>ಇವರು ಯೆಹೂದವನ್ನು ಸಂಚರಿಸಿ ಯೆಹೂದದ ಸಮಸ್ತ ಪಟ್ಟಣಗಳಿಂದ ಲೇವಿಯರನ್ನೂ, ಇಸ್ರಾಯೇಲಿನ ಕುಟುಂಬದಲ್ಲಿ ಮುಖ್ಯಸ್ಥರನ್ನೂ ಕೂಡಿಸಿಕೊಂಡು, ಯೆರೂಸಲೇಮಿಗೆ ಬಂದರು. <verse eid="2CH 23:2"/><verse number="3" style="v" sid="2CH 23:3"/>ಆಗ ಸಭೆಯವರೆಲ್ಲರು ದೇವರ ಆಲಯದಲ್ಲಿ ಅರಸನ ಸಂಗಡ ಒಡಂಬಡಿಕೆಯನ್ನು ಮಾಡಿದರು.</para>
  <para style="p" vid="2CH 23:3">ಯೆಹೋಯಾದನು ಅವರಿಗೆ, “ಇಗೋ, ರಾಜಪುತ್ರನು, ಯೆಹೋವ ದೇವರು ದಾವೀದನ ವಂಶದವರ ಬಗ್ಗೆ ಮಾಡಿದ ವಾಗ್ದಾನಕ್ಕೆ ಅನುಸಾರವಾಗಿ ಆಳತಕ್ಕವನು ಇವನೇ. <verse eid="2CH 23:3"/><verse number="4" style="v" sid="2CH 23:4"/>ಈಗ ನೀವು ಮಾಡಬೇಕಾದದ್ದೇನೆಂದರೆ, ಸಬ್ಬತ್<note caller="+" style="f"><char style="fr" closed="false">23:4 </char><char style="fq" closed="false">ಸಬ್ಬತ್ </char><char style="ft" closed="false">ಅಂದರೆ </char><char style="fqa" closed="false">ವಿಶ್ರಾಂತಿ ದಿನ</char></note> ದಿನದಲ್ಲಿ ಪ್ರವೇಶಿಸುವ ಯಾಜಕರೂ, ಲೇವಿಯರೂ ಆದ ನಿಮ್ಮಲ್ಲಿರುವ ಮೂರನೇ ಒಂದು ಭಾಗವು ದ್ವಾರಪಾಲಕರಾಗಿರಬೇಕು. <verse eid="2CH 23:4"/><verse number="5" style="v" sid="2CH 23:5"/>ಇನ್ನೊಂದು ಭಾಗವು ಅರಮನೆಯನ್ನೂ, ಮತ್ತೊಂದು ಭಾಗವು ಅಸ್ತಿವಾರದ ಬಾಗಿಲನ್ನೂ, ಇತರ ಸಮಸ್ತ ಜನರೂ ಯೆಹೋವ ದೇವರ ಆಲಯದ ಅಂಗಳದಲ್ಲಿಯೂ ಇರಬೇಕು. <verse eid="2CH 23:5"/><verse number="6" style="v" sid="2CH 23:6"/>ಆದರೆ ಯಾಜಕರೂ, ಲೇವಿಯರಲ್ಲಿ ಸೇವೆ ಮಾಡುವವರೂ ಅಲ್ಲದೆ ಬೇರೆ ಯಾರೂ ಯೆಹೋವ ದೇವರ ಆಲಯದಲ್ಲಿ ಪ್ರವೇಶಿಸಕೂಡದು. ಅವರು ಪ್ರತಿಷ್ಠಿತರಾದುದರಿಂದ ಒಳಗೆ ಪ್ರವೇಶಿಸಲಿ. ಆದರೆ ಸಮಸ್ತ ಜನರು ಯೆಹೋವ ದೇವರ ಆಜ್ಞಾನುಸಾರವಾಗಿ ಹೊರಗಿರಬೇಕು. <verse eid="2CH 23:6"/><verse number="7" style="v" sid="2CH 23:7"/>ಇದಲ್ಲದೆ ಲೇವಿಯರಲ್ಲಿ ಪ್ರತಿ ಮನುಷ್ಯನು ತನ್ನ ಕೈಯಲ್ಲಿ ಆಯುಧಗಳನ್ನು ಹಿಡಿದುಕೊಂಡು ಅರಸನ ಸುತ್ತಲೂ ಇರಬೇಕು. ಇವರ ಹೊರತು ಯಾವನಾದರೂ ಆಲಯದಲ್ಲಿ ಬಂದರೆ, ಅವನನ್ನು ಸಂಹರಿಸಬೇಕು. ಆದರೆ ಅರಸನು ಒಳಗೆ ಬರುವಾಗಲೂ, ಹೊರಗೆ ಹೋಗುವಾಗಲೂ ನೀವು ಅವನ ಜೊತೆಯಲ್ಲಿಯೇ ಇರಬೇಕು,” ಎಂದು ಹೇಳಿದನು.<verse eid="2CH 23:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="2CH 23:8"/>ಹೀಗೆಯೇ ಯಾಜಕನಾದ ಯೆಹೋಯಾದಾವನು ಆಜ್ಞಾಪಿಸಿದ ಪ್ರಕಾರ ಲೇವಿಯರೂ ಸಮಸ್ತ ಯೆಹೂದದವರೂ ಮಾಡಿದರು. ಪ್ರತಿ ಮನುಷ್ಯನು ಸಬ್ಬತ್ ದಿನದಲ್ಲಿ ಮನೆಗೆ ಹೋಗತಕ್ಕ ಮತ್ತು ಬರತಕ್ಕ ಸಿಪಾಯಿಗಳನ್ನು ಕೂಡಿಸಿಕೊಂಡನು. ಏಕೆಂದರೆ ಯಾಜಕನಾದ ಯೆಹೋಯಾದನು ಸೇವಾವಿಮುಕ್ತರಾದ ವರ್ಗದವರನ್ನು ಕಳುಹಿಸಿಬಿಡಲಿಲ್ಲ. <verse eid="2CH 23:8"/><verse number="9" style="v" sid="2CH 23:9"/>ಇದಲ್ಲದೆ ಯಾಜಕನಾದ ಯೆಹೋಯಾದನು ದೇವರ ಆಲಯದಲ್ಲಿದ್ದ ಅರಸನಾದ ದಾವೀದನ ಈಟಿಗಳನ್ನೂ, ದೊಡ್ಡ ಮತ್ತು ಸಣ್ಣ ಗುರಾಣಿಗಳನ್ನೂ ಶತಾಧಿಪತಿಗಳಾದವರಿಗೆ ಕೊಟ್ಟು, <verse eid="2CH 23:9"/><verse number="10" style="v" sid="2CH 23:10"/>ಆಯುಧಗಳನ್ನು ಕೈಯಲ್ಲಿ ಹಿಡಿದುಕೊಂಡಿದ್ದ ಸಮಸ್ತ ಜನರನ್ನೂ ಬಲಿಪೀಠದ ಬಳಿಯಲ್ಲಿಯೂ, ಆಲಯದ ಬಳಿಯಲ್ಲಿಯೂ, ಆಲಯದ ಬಲಗಡೆಯ ಮೊದಲುಗೊಂಡು ಆಲಯದ ಎಡಗಡೆಯವರೆಗೂ ಅರಸನ ಸುತ್ತಲೂ ಇರಿಸಿದನು.<verse eid="2CH 23:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="2CH 23:11"/>ಆಗ ಯೆಹೋಯಾದಾವನು ಅವನ ಮಕ್ಕಳೂ ರಾಜಪುತ್ರನನ್ನು ಹೊರಗೆ ಕರೆತಂದು, ಅವನ ತಲೆಯ ಮೇಲೆ ಕಿರೀಟವನ್ನಿಟ್ಟು, ಕೈಗೆ ದೇವರ ನಿಯಮ ಗ್ರಂಥವನ್ನು ಕೊಟ್ಟು, ಅವನನ್ನು ಅರಸನನ್ನಾಗಿ ಘೋಷಿಸಿ, ಅವನನ್ನು ಅಭಿಷೇಕಿಸಿದರು. ಕೂಡಲೆ ಜನರು, “ಅರಸನು ಚಿರಂಜೀವಿಯಾಗಿರಲಿ!” ಎಂದು ಹರಸಿದರು.<verse eid="2CH 23:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="2CH 23:12"/>ಆದರೆ ಅರಸನನ್ನು ಹರಸುತ್ತಾ, ಓಡುತ್ತಾ ಇದ್ದ ಜನರ ಶಬ್ದವನ್ನು ಅತಲ್ಯಳು ಕೇಳಿದಾಗ, ಅವಳು ಯೆಹೋವ ದೇವರ ಆಲಯದಲ್ಲಿ ಜನರ ಬಳಿಗೆ ಬಂದಳು. <verse eid="2CH 23:12"/><verse number="13" style="v" sid="2CH 23:13"/>ಅರಸನು ಪ್ರವೇಶಿಸುವ ಸ್ಥಳದಲ್ಲಿ ತನ್ನ ಸ್ತಂಭದ ಬಳಿಯಲ್ಲಿ ನಿಂತಿದ್ದನು. ಪ್ರಧಾನರೂ, ತುತೂರಿ ಊದುವವರೂ, ಅರಸನ ಬಳಿಯಲ್ಲಿ ನಿಂತಿದ್ದರು. ಇದಲ್ಲದೆ ದೇಶದ ಜನರೆಲ್ಲರೂ ಸಂತೋಷಪಟ್ಟು ತುತೂರಿಗಳನ್ನು ಊದುತ್ತಿದ್ದರು. ಹಾಗೆಯೇ ಹಾಡುಗಾರರು ಗೀತವಾದ್ಯಗಳನ್ನು ಹಿಡಿದು ಸ್ತುತಿಸುವವರೂ ಬೋಧಿಸುವವರೂ ಇದ್ದರು. ಇದನ್ನು ಕಂಡ ಕೂಡಲೆ ಅತಲ್ಯಳು ತನ್ನ ವಸ್ತ್ರಗಳನ್ನು ಹರಿದುಕೊಂಡು, “ದ್ರೋಹ, ದ್ರೋಹ,” ಎಂದು ಕೂಗಿದಳು.<verse eid="2CH 23:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="2CH 23:14"/>ಆಗ ಯಾಜಕನಾದ ಯೆಹೋಯಾದಾವನು ಸೈನ್ಯದ ಮೇಲೆ ಇರುವ ಶತಾಧಿಪತಿಗಳನ್ನು ಹೊರಗೆ ಕರೆತಂದು ಅವರಿಗೆ, “ಅವಳನ್ನು ಯೆಹೋವ ದೇವರ ಆಲಯದಲ್ಲಿ ಕೊಲ್ಲಬೇಡಿರಿ, ಎರಡು ಸಾಲು ಸಿಪಾಯಿಗಳು ಅವಳನ್ನು ನಡುವೆ ಸಾಗಿಸಿಕೊಂಡು ಹೋಗಿ ಹೊರಗೆ ತಳ್ಳಲಿ ಮತ್ತು ಅವಳನ್ನು ಹಿಂಬಾಲಿಸುವಂಥವರನ್ನು ಖಡ್ಗದಿಂದ ಕೊಂದುಹಾಕಿರಿ,” ಎಂದು ಆಜ್ಞಾಪಿಸಿದನು. <verse eid="2CH 23:14"/><verse number="15" style="v" sid="2CH 23:15"/>ಆಗ ಅವರು ಅವಳನ್ನು ಅಧೀನಕ್ಕೆ ತೆಗೆದುಕೊಂಡು, ಅರಮನೆಯ ಬಳಿಯಲ್ಲಿ ಕುದುರೆ ಬಾಗಿಲಿನ ಪ್ರವೇಶದಲ್ಲಿ ಬಂದಾಗ ಅಲ್ಲಿ ಅವಳನ್ನು ಕೊಂದುಹಾಕಿದರು.<verse eid="2CH 23:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="2CH 23:16"/>ಅನಂತರ ಯೆಹೋವ ದೇವರ ಜನರಾಗಿರುವಂತೆ ಯೆಹೋಯಾದಾವನು ತನಗೂ, ಸಮಸ್ತ ಜನರಿಗೂ, ಅರಸನಿಗೂ ಒಡಂಬಡಿಕೆ ಮಾಡಿಸಿದನು. <verse eid="2CH 23:16"/><verse number="17" style="v" sid="2CH 23:17"/>ಸಮಸ್ತ ಜನರು ಬಾಳನ ದೇವಸ್ಥಾನಕ್ಕೆ ಹೋಗಿ ಅದನ್ನು ಕೆಡವಿಹಾಕಿ, ಅದರ ಬಲಿಪೀಠಗಳನ್ನೂ ವಿಗ್ರಹಗಳನ್ನೂ ಒಡೆದುಬಿಟ್ಟು, ಬಲಿಪೀಠಗಳ ಮುಂದೆ ಬಾಳನ ಯಾಜಕನಾದ ಮತ್ತಾನನನ್ನು ಕೊಂದುಹಾಕಿದರು.<verse eid="2CH 23:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="2CH 23:18"/>ಆಗ ಯೆಹೋಯಾದಾವನು ಲೇವಿಯರಾದ ಯಾಜಕರ ಕೈಕೆಳಗೆ ಯೆಹೋವ ದೇವರ ಆಲಯದ ಪರಿಚಾರಕರನ್ನು ನೇಮಿಸಿದನು. ದಾವೀದನು ಆ ಯಾಜಕರನ್ನು ಯೆಹೋವ ದೇವರ ಆಲಯದ ಸೇವೆಗಾಗಿ ವರ್ಗವರ್ಗಗಳಾಗಿ ಬೇರ್ಪಡಿಸಿದ್ದನು. ದಾವೀದನಿಂದ ನೇಮಕವಾದ ಪ್ರಕಾರ ಸಂತೋಷದಿಂದ ಹಾಡುತ್ತಾ ಮೋಶೆಯ ನಿಯಮದಲ್ಲಿ ಬರೆದಿರುವಂತೆ ಯೆಹೋವ ದೇವರಿಗೆ ದಹನಬಲಿಗಳನ್ನು ಅರ್ಪಿಸುವುದು ಅವರ ಕರ್ತವ್ಯವಾಗಿತ್ತು. <verse eid="2CH 23:18"/><verse number="19" style="v" sid="2CH 23:19"/>ಯೆಹೋವ ದೇವರ ಆಲಯದಲ್ಲಿ ಯಾವ ಅಪವಿತ್ರವಾದದ್ದೂ ಒಳಗೆ ಪ್ರವೇಶಿಸದ ಹಾಗೆ ಬಾಗಿಲುಗಳ ಬಳಿಯಲ್ಲಿ ದ್ವಾರಪಾಲಕರನ್ನು ಇರಿಸಿದನು.<verse eid="2CH 23:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="2CH 23:20"/>ಅವನು ಶತಾಧಿಪತಿಗಳನ್ನೂ, ಗೌರವಸ್ಥರನ್ನೂ, ಜನರ ಅಧಿಪತಿಗಳನ್ನೂ, ದೇಶದ ಜನರೆಲ್ಲರನ್ನೂ ಕರೆದುಕೊಂಡು ಹೋಗಿ, ಅರಸನನ್ನು ಯೆಹೋವ ದೇವರ ಆಲಯದಿಂದ ಕರೆತಂದನು. ಅವರು ಹೆಬ್ಬಾಗಿಲಿನಿಂದ ಅರಮನೆಗೆ ಬಂದು, ಅರಸನನ್ನು ರಾಜಸಿಂಹಾಸನದ ಮೇಲೆ ಕುಳ್ಳಿರಿಸಿದರು. <verse eid="2CH 23:20"/><verse number="21" style="v" sid="2CH 23:21"/>ಅತಲ್ಯಳನ್ನು ಖಡ್ಗದಿಂದ ಕೊಂದುಹಾಕಿದ್ದರಿಂದ ದೇಶದ ಜನರೆಲ್ಲರೂ ಸಂತೋಷಪಟ್ಟರು, ಪಟ್ಟಣವು ಶಾಂತವಾಯಿತು.<verse eid="2CH 23:21"/></para>
  <chapter eid="2CH 23"/>
  <chapter number="24" style="c" sid="2CH 24"/>
  <para style="s1">ಯೋವಾಷನು ದೇವಾಲಯವನ್ನು ದುರಸ್ತು ಮಾಡಿಸಿದ್ದು</para>
  <para style="p">
    <verse number="1" style="v" sid="2CH 24:1"/>ಯೋವಾಷ್ ಅರಸನಾದಾಗ ಏಳು ವರ್ಷದವನಾಗಿದ್ದನು. ಯೆರೂಸಲೇಮಿನಲ್ಲಿ ನಾಲ್ವತ್ತು ವರ್ಷ ಆಳಿದನು, ಅವನ ತಾಯಿ ಬೇರ್ಷೆಬ ಊರಿನವಳಾದ ಚಿಬ್ಯಳೆಂಬವಳು. <verse eid="2CH 24:1"/><verse number="2" style="v" sid="2CH 24:2"/>ಯೋವಾಷನು ಯಾಜಕನಾದ ಯೆಹೋಯಾದನ ಸಮಸ್ತ ದಿವಸಗಳಲ್ಲಿ ಯೆಹೋವ ದೇವರ ಸಮ್ಮುಖದಲ್ಲಿ ಸರಿಯಾದದ್ದನ್ನು ಮಾಡಿದನು. <verse eid="2CH 24:2"/><verse number="3" style="v" sid="2CH 24:3"/>ಯೆಹೋಯಾದಾವನು ಯೋವಾಷನಿಗೆ ಇಬ್ಬರು ಮಹಿಳೆಯರನ್ನು ಮದುವೆಮಾಡಿಕೊಟ್ಟನು. ಅವನು ಪುತ್ರಪುತ್ರಿಯರನ್ನು ಪಡೆದನು.<verse eid="2CH 24:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="2CH 24:4"/>ಕ್ರಮೇಣ ಯೋವಾಷನು ಯೆಹೋವ ದೇವರ ಆಲಯವನ್ನು ದುರಸ್ತು ಮಾಡುವ ಮನಸ್ಸುಳ್ಳವನಾದನು. <verse eid="2CH 24:4"/><verse number="5" style="v" sid="2CH 24:5"/>ಆದ್ದರಿಂದ ಅವನು ಯಾಜಕರನ್ನೂ, ಲೇವಿಯರನ್ನೂ ಕೂಡಿಸಿಕೊಂಡು ಅವರಿಗೆ, “ನೀವು ಯೆಹೂದ ಪಟ್ಟಣಗಳಿಗೆ ಹೊರಟುಹೋಗಿ ವರ್ಷ ವರ್ಷಕ್ಕೆ ನಿಮ್ಮ ದೇವರ ಆಲಯವನ್ನು ದುರಸ್ತು ಮಾಡುವುದಕ್ಕೆ ಸಮಸ್ತ ಇಸ್ರಾಯೇಲರಿಂದ ಹಣವನ್ನು ಕೂಡಿಸಿರಿ ಮತ್ತು ಕೆಲಸವನ್ನು ಶೀಘ್ರವಾಗಿ ನಡೆಸಿರಿ,” ಎಂದನು. ಆದರೂ ಲೇವಿಯರು ಅವಸರ ಮಾಡದೆ ಇದ್ದರು.<verse eid="2CH 24:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="2CH 24:6"/>ಅರಸನು ಮುಖ್ಯಯಾಜಕನಾದ ಯೆಹೋಯಾದಾವನನ್ನು ಕರೆಕಳುಹಿಸಿ ಅವನಿಗೆ, “ಯೆಹೋವ ದೇವರ ಸೇವಕನಾದ ಮೋಶೆಯೂ, ಇಸ್ರಾಯೇಲಿನ ಸಭೆಯೂ ದೇವದರ್ಶನ ಗುಡಾರದ ನಿಮಿತ್ತ ಆಜ್ಞಾಪಿಸಿದ ಕಾಣಿಕೆಯನ್ನು ಯೆಹೂದದಿಂದಲೂ, ಯೆರೂಸಲೇಮಿನಿಂದಲೂ ಬರುವಂತೆ ಮಾಡಲು ನೀನು ಲೇವಿಯರನ್ನು ಏಕೆ ವಿಚಾರಿಸಲಿಲ್ಲ?” ಎಂದನು.<verse eid="2CH 24:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="2CH 24:7"/>ಆ ದುಷ್ಟ ಸ್ತ್ರೀಯಾದ ಅತಲ್ಯಳ ಪುತ್ರರು ಯೆಹೋವ ದೇವರ ಆಲಯವನ್ನು ಒಡೆದುಬಿಟ್ಟು, ಯೆಹೋವ ದೇವರ ಆಲಯಕ್ಕೆ ಪ್ರತಿಷ್ಠೆ ಮಾಡಿದವುಗಳನ್ನೆಲ್ಲಾ ಬಾಳನಿಗೆ ಕೊಟ್ಟುಬಿಟ್ಟಿದ್ದರು.<verse eid="2CH 24:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="2CH 24:8"/>ಅರಸನು ಹೇಳಿದ್ದರಿಂದ ಅವರು ಒಂದು ಪೆಟ್ಟಿಗೆಯನ್ನು ಮಾಡಿ, ಯೆಹೋವ ದೇವರ ಆಲಯದ ಬಾಗಿಲಿನ ಹೊರಗೆ ಇಟ್ಟರು. <verse eid="2CH 24:8"/><verse number="9" style="v" sid="2CH 24:9"/>ದೇವರ ಸೇವಕನಾದ ಮೋಶೆಯು ಮರುಭೂಮಿಯಲ್ಲಿ ಇಸ್ರಾಯೇಲರಿಗೆ ಆಜ್ಞಾಪಿಸಿದ ತೆರಿಗೆಯನ್ನು ಯೆಹೋವ ದೇವರಿಗೆ ತರಬೇಕೆಂದು ಯೆಹೂದದಲ್ಲಿಯೂ, ಯೆರೂಸಲೇಮಿನಲ್ಲಿಯೂ ಪ್ರಕಟಮಾಡಿದರು. <verse eid="2CH 24:9"/><verse number="10" style="v" sid="2CH 24:10"/>ಆಗ ಪ್ರಧಾನರೆಲ್ಲರೂ ಸಂತೋಷಪಟ್ಟು, ತೆರಿಗೆಯನ್ನು ತೆಗೆದುಕೊಂಡು ಬಂದು, ತುಂಬುವವರೆಗೆ ಪೆಟ್ಟಿಗೆಯೊಳಗೆ ಹಾಕಿದರು. <verse eid="2CH 24:10"/><verse number="11" style="v" sid="2CH 24:11"/>ಪೆಟ್ಟಿಗೆಯು ಲೇವಿಯರ ಕೈಯಿಂದ ಅರಸನ ಕಛೇರಿಗೆ ತಂದಾಗಲೆಲ್ಲಾ ಅದರಲ್ಲಿ ಬಹಳ ಹಣ ಕಾಣಿಸಿದ್ದರಿಂದ, ಅರಸನ ಕಾರ್ಯದರ್ಶಿಯೂ, ಮುಖ್ಯಯಾಜಕನ ಪರಿಚಾರಕನೂ ಬಂದು ಪೆಟ್ಟಿಗೆಯನ್ನು ಬರಿದುಮಾಡಿ, ತೆಗೆದುಕೊಂಡು ತಿರುಗಿ ಅದರ ಸ್ಥಳಕ್ಕೆ ಒಯ್ದಿಟ್ಟರು. ಹೀಗೆಯೇ ಅವರು ಪ್ರತಿದಿನ ಮಾಡಿ ಹಣವನ್ನು ಬಹಳ ಕೂಡಿಸಿದರು. <verse eid="2CH 24:11"/><verse number="12" style="v" sid="2CH 24:12"/>ಆಗ ಅರಸನೂ, ಯೆಹೋಯಾದಾವನೂ ಅದನ್ನು ಯೆಹೋವ ದೇವರ ಆಲಯದ ಸೇವೆಯ ಕಾರ್ಯವನ್ನು ಮಾಡುವವರಿಗೆ ಕೊಟ್ಟು ಅವರಿಂದ ಕೆಲಸ ಮಾಡಿಸಿದರು. ಯೆಹೋವ ದೇವರ ಆಲಯವನ್ನು ದುರಸ್ತಿಪಡಿಸುವ ನಿಮಿತ್ತ ಕಲ್ಲು ಕಡಿಯುವವರನ್ನೂ, ಬಡಗಿಯವರನ್ನೂ ಕೂಲಿಗೆ ಕರೆದುಕೊಂಡರು. ಯೆಹೋವ ದೇವರ ಆಲಯವನ್ನು ಭದ್ರ ಮಾಡುವ ನಿಮಿತ್ತ ಕಬ್ಬಿಣ, ಕಂಚಿನ ಕೆಲಸ ಮಾಡುವವರನ್ನು ಕೂಲಿಗೆ ಕರೆದುಕೊಂಡರು.<verse eid="2CH 24:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="2CH 24:13"/>ಹೀಗೆ ಕೆಲಸದವರು ಕೆಲಸವನ್ನು ನಡೆಸಿದ್ದರಿಂದ, ಕೆಲಸವು ಅವರ ಕೈಯಿಂದ ಪೂರ್ಣವಾಯಿತು. ಅವರು ಯೆಹೋವ ದೇವರ ಆಲಯವನ್ನು ಮೊದಲಿದ್ದ ಸ್ಥಿತಿಗೆ ಅದನ್ನು ತಂದು ಭದ್ರಪಡಿಸಿದರು. <verse eid="2CH 24:13"/><verse number="14" style="v" sid="2CH 24:14"/>ಕೆಲಸ ಮುಗಿಸಿದ ಮೇಲೆ, ಮಿಕ್ಕ ಅರಸನ ಮುಂದೆಯೂ ಯೆಹೋಯಾದಾವನ ಮುಂದೆಯೂ ತಂದರು. ಅದರಿಂದ ಯೆಹೋವ ದೇವರ ಆಲಯಕ್ಕೋಸ್ಕರ ಬಂಗಾರ ಬೆಳ್ಳಿ ಪಾತ್ರೆಗಳಾದ ಸೇವೆಯ ಪಾತ್ರೆಗಳು, ಅರ್ಪಣೆಯ ಪಾತ್ರೆಗಳು, ಸೌಟುಗಳು ಮಾಡಲಾಗಿದ್ದವು. ಯೆಹೋಯಾದಾವನ ಸಮಸ್ತ ದಿವಸಗಳಲ್ಲಿ ಯಾವಾಗಲೂ ಯೆಹೋವ ದೇವರ ಆಲಯದಲ್ಲಿ ದಹನಬಲಿಗಳನ್ನು ಅರ್ಪಿಸಿದರು.<verse eid="2CH 24:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="2CH 24:15"/>ಯೆಹೋಯಾದಾವನು ವೃದ್ಧನಾಗಿ ಮರಣಹೊಂದಿದನು. ಅವನು ಸಾಯುವಾಗ ನೂರಾಮೂವತ್ತು ವರ್ಷಗಳುಳ್ಳವನಾಗಿದ್ದನು. <verse eid="2CH 24:15"/><verse number="16" style="v" sid="2CH 24:16"/>ಅವನು ದೇವರಿಗೋಸ್ಕರವಾಗಿಯೂ, ಆತನ ಆಲಯಕ್ಕೋಸ್ಕರವಾಗಿಯೂ ಇಸ್ರಾಯೇಲಿನಲ್ಲಿ ಒಳ್ಳೆಯದನ್ನು ಮಾಡಿದ್ದರಿಂದ, ಅವರು ಅವನನ್ನು ದಾವೀದನ ಪಟ್ಟಣದಲ್ಲಿ ಅರಸರ ಬಳಿಯಲ್ಲಿ ಹೂಳಿಟ್ಟರು.<verse eid="2CH 24:16"/></para>
  <para style="s1">ಯೋವಾಷನ ದುಷ್ಟತನ</para>
  <para style="p">
    <verse number="17" style="v" sid="2CH 24:17"/>ಯೆಹೋಯಾದಾವನ ಮರಣದ ತರುವಾಯ ಯೆಹೂದದ ಪ್ರಧಾನರು ಬಂದು ಅರಸನಿಗೆ ಅಡ್ಡಬಿದ್ದರು. ಆಗ ಅರಸನು ಅವರ ಮಾತನ್ನು ಕೇಳಿದನು. <verse eid="2CH 24:17"/><verse number="18" style="v" sid="2CH 24:18"/>ಅವರು ತಮ್ಮ ಪಿತೃಗಳ ದೇವರಾದ ಯೆಹೋವ ದೇವರ ಆಲಯವನ್ನು ಬಿಟ್ಟು, ಅಶೇರ ಸ್ತಂಭಗಳನ್ನೂ, ವಿಗ್ರಹಗಳನ್ನೂ ಸೇವಿಸಿದರು. ಆದಕಾರಣ ಅವರ ಈ ಅಪರಾಧದ ನಿಮಿತ್ತ ಯೆಹೂದ ಮತ್ತು ಯೆರೂಸಲೇಮಿನ ಮೇಲೆ ದೇವರ ಕೋಪಾಗ್ನಿಯು ಬಂತು. <verse eid="2CH 24:18"/><verse number="19" style="v" sid="2CH 24:19"/>ಆದರೂ ಯೆಹೋವ ದೇವರು ತನ್ನ ಕಡೆಗೆ ಅವರನ್ನು ತಿರುಗಿಸುವುದಕ್ಕೆ ಪ್ರವಾದಿಗಳನ್ನು ಅವರ ಬಳಿಗೆ ಕಳುಹಿಸಿದನು. ಇವರು ಅವರಿಗೆ ಸಾಕ್ಷಿಗಾಗಿ ಮಾತನಾಡಿದರು. ಆದರೂ ಅವರು ಕಿವಿಗೊಡದೆ ಹೋದರು.<verse eid="2CH 24:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="2CH 24:20"/>ಆಗ ದೇವರ ಆತ್ಮ ಯಾಜಕ ಯೆಹೋಯಾದಾವನ ಮಗನಾದ ಜೆಕರ್ಯನ ಮೇಲೆ ಬಂದು, ಅವನು ಜನರ ಮುಂದೆ ನಿಂತು ಅವರಿಗೆ, “ನೀವು ವೃದ್ಧಿ ಹೊಂದಕೂಡದ ಹಾಗೆ ಯೆಹೋವ ದೇವರ ಆಜ್ಞೆಗಳನ್ನು ಮೀರುವುದೇನು? ನಿಮಗೆ ಶುಭವಾಗುವುದಿಲ್ಲ. ನೀವು ಯೆಹೋವ ದೇವರನ್ನು ಬಿಟ್ಟುಬಿಟ್ಟದ್ದರಿಂದ, ದೇವರು ಸಹ ನಿಮ್ಮನ್ನು ಬಿಟ್ಟುಬಿಟ್ಟಿದ್ದಾರೆ ಎಂದು ಯೆಹೋವ ದೇವರು ಹೇಳುತ್ತಾರೆ,” ಎಂದನು.<verse eid="2CH 24:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="2CH 24:21"/>ಆದ್ದರಿಂದ ಅವರು ಅವನಿಗೆ ವಿರೋಧವಾಗಿ ಒಳಸಂಚುಮಾಡಿ, ಯೆಹೋವ ದೇವರ ಆಲಯದ ಅಂಗಳದಲ್ಲಿ ಅರಸನ ಅಪ್ಪಣೆಯಂತೆ ಅವನನ್ನು ಕಲ್ಲೆಸೆದು ಕೊಂದರು. <verse eid="2CH 24:21"/><verse number="22" style="v" sid="2CH 24:22"/>ಹಾಗೆಯೇ ಅರಸನಾದ ಯೋವಾಷನು, ಇವನ ತಂದೆಯಾದ ಯೆಹೋಯಾದಾವನು ತನಗೆ ತೋರಿಸಿದ ದಯೆಯನ್ನು ಜ್ಞಾಪಕಮಾಡದೆ ಅವನ ಮಗನನ್ನು ಕೊಂದುಹಾಕಿದನು. ಜೆಕರ್ಯನು ಸಾಯುವಾಗ, “ಯೆಹೋವ ದೇವರು ನೋಡಿ ವಿಚಾರಿಸಲಿ,” ಎಂದು ಹೇಳಿದನು.<verse eid="2CH 24:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="2CH 24:23"/>ವರ್ಷಾಂತ್ಯದಲ್ಲಿ ಅರಾಮಿನ ಸೈನ್ಯದವರು ಅವನಿಗೆ ವಿರೋಧವಾಗಿ ಹೊರಟು, ಯೆಹೂದ ಮತ್ತು ಯೆರೂಸಲೇಮಿಗೆ ಬಂದು, ಜನರ ಪ್ರಧಾನರನ್ನು ಅವರೊಳಗಿಂದ ನಾಶಮಾಡಿ, ಅವರಿಂದ ತೆಗೆದುಕೊಂಡ ಕೊಳ್ಳೆಯನ್ನೆಲ್ಲಾ ದಮಸ್ಕದ ಅರಸನಿಗೆ ಕಳುಹಿಸಿದರು. <verse eid="2CH 24:23"/><verse number="24" style="v" sid="2CH 24:24"/>ಅವರು ತಮ್ಮ ಪಿತೃಗಳ ದೇವರಾದ ಯೆಹೋವ ದೇವರನ್ನು ಬಿಟ್ಟುಬಿಟ್ಟದ್ದರಿಂದ ಅರಾಮ್ಯರು ಚಿಕ್ಕ ಗುಂಪಿನ ಸೈನ್ಯದ ಸಂಗಡ ಬಂದಿದ್ದರೂ, ಯೆಹೋವ ದೇವರು ಅವರ ಮಹಾ ಸೈನ್ಯವನ್ನು ಶತ್ರುಗಳ ಕೈಯಲ್ಲಿ ಒಪ್ಪಿಸಿದನು. ಹೀಗೆಯೇ ಯೆಹೋವ ದೇವರು ಯೋವಾಷನಿಗೆ ವಿರೋಧವಾಗಿ ತೀರ್ಪು ಮಾಡಿದರು. <verse eid="2CH 24:24"/><verse number="25" style="v" sid="2CH 24:25"/>ಯೋವಾಷನು ತೀವ್ರ ಗಾಯಗೊಂಡು ಬಿದ್ದಿರುವಾಗ, ಅರಾಮೀಯರು ಅವನನ್ನು ಬಿಟ್ಟುಹೋದರು. ಅವರು ಹೋದ ತರುವಾಯ ಯಾಜಕನಾದ ಯೆಹೋಯಾದಾವನ ಮಕ್ಕಳ ರಕ್ತಾಪರಾಧದ ನಿಮಿತ್ತವಾಗಿ ಯೋವಾಷನ ಸ್ವಂತ ಸೇವಕರೇ ಅವನಿಗೆ ವಿರೋಧವಾಗಿ ಒಳಸಂಚುಮಾಡಿ, ಅವನ ಮಂಚದ ಮೇಲೆಯೇ ಅವನನ್ನು ಕೊಂದುಹಾಕಿದರು. ಅವರು ಯೋವಾಷನನ್ನು ದಾವೀದನ ಪಟ್ಟಣದಲ್ಲಿ ಸಮಾಧಿಮಾಡಿದರು. ಆದರೆ ಅರಸರ ಸಮಾಧಿಯಲ್ಲಿ ಅವನನ್ನು ಸಮಾಧಿಮಾಡಲಿಲ್ಲ.<verse eid="2CH 24:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="2CH 24:26"/>ಯೋವಾಷನಿಗೆ ವಿರೋಧವಾಗಿ ಒಳಸಂಚು ಮಾಡಿದವರು ಯಾರೆಂದರೆ, ಅಮ್ಮೋನ್ ದೇಶದ ಶಿಮೆಯಾತ್ ಎಂಬಾಕೆಯ ಮಗ ಜಾಬಾದ್<note caller="+" style="f"><char style="fr" closed="false">24:26 </char><char style="fq" closed="false">ಜಾಬಾದನು </char><char style="ft" closed="false">ಅಥವಾ </char><char style="fqa" closed="false">ಯೋಜಾಬಾದ್</char></note>; ಮೋವಾಬ್ ದೇಶದ ಶಿಮ್ರೀತ್ ಎಂಬಾಕೆಯ ಮಗ ಯೆಹೋಜಾಬಾದನು. <verse eid="2CH 24:26"/><verse number="27" style="v" sid="2CH 24:27"/>ಆದರೆ ಅವನ ಪುತ್ರನನ್ನು ಕುರಿತೂ, ಅವನ ವಿರುದ್ಧ ನುಡಿದ ಪ್ರವಾದನೆಯ ಕುರಿತೂ, ದೇವರ ಆಲಯ ದುರಸ್ತು ಮಾಡುವುದನ್ನು ಕುರಿತೂ, ಅರಸರ ಚರಿತ್ರೆಯ ಪುಸ್ತಕದಲ್ಲಿ ಬರೆದಿರುತ್ತವೆ. ಅವನ ಮಗ ಅಮಚ್ಯನು ಅವನಿಗೆ ಬದಲಾಗಿ ಅರಸನಾದನು.<verse eid="2CH 24:27"/></para>
  <chapter eid="2CH 24"/>
  <chapter number="25" style="c" sid="2CH 25"/>
  <para style="s1">ಅರಸನಾದ ಅಮಚ್ಯನು</para>
  <para style="p">
    <verse number="1" style="v" sid="2CH 25:1"/>ಅಮಚ್ಯನು ಆಳಲು ಆರಂಭಿಸಿದಾಗ ಇಪ್ಪತ್ತೈದು ವರ್ಷದವನಾಗಿದ್ದು, ಯೆರೂಸಲೇಮಿನಲ್ಲಿ ಇಪ್ಪತ್ತೊಂಬತ್ತು ವರ್ಷ ಆಳಿದನು. ಅವನ ತಾಯಿಯ ಹೆಸರು ಯೆಹೋವದ್ದಾನ್, ಅವಳು ಯೆರೂಸಲೇಮಿನವಳು. <verse eid="2CH 25:1"/><verse number="2" style="v" sid="2CH 25:2"/>ಅವನು ಯೆಹೋವ ದೇವರ ದೃಷ್ಟಿಯಲ್ಲಿ ಸರಿಯಾದದ್ದನ್ನೇ ಮಾಡಿದನು, ಆದರೆ ಪೂರ್ಣಹೃದಯದಿಂದಲ್ಲ. <verse eid="2CH 25:2"/><verse number="3" style="v" sid="2CH 25:3"/>ಅವನು ರಾಜ್ಯವನ್ನು ಸ್ಥಿರಪಡಿಸಿಕೊಂಡ ತರುವಾಯ, ಅರಸನಾಗಿದ್ದ ತನ್ನ ತಂದೆಯನ್ನು ಕೊಂದ ಸೇವಕರಿಗೆ ಮರಣದಂಡನೆಯನ್ನು ವಿಧಿಸಿದನು. <verse eid="2CH 25:3"/><verse number="4" style="v" sid="2CH 25:4"/>ಆದರೆ, “ಮಕ್ಕಳು ಮಾಡಿದ ಪಾಪಕ್ಕೆ ತಂದೆಗಾಗಲಿ, ತಂದೆಯ ಪಾಪಕ್ಕಾಗಿ ಮಕ್ಕಳಿಗಾಗಲಿ ಮರಣಶಿಕ್ಷೆಯಾಗಬಾರದು. ಪ್ರತಿಯೊಬ್ಬನೂ ತನ್ನ ಪಾಪದ ನಿಮಿತ್ತವೇ ಮರಣಶಿಕ್ಷೆಯನ್ನು ಹೊಂದಬೇಕು,”<note caller="+" style="f"><char style="fr" closed="false">25:4 </char><char style="ft" closed="false"><char style="xt"><ref loc="DEU 24:16">ಧರ್ಮೋ 24:16</ref></char></char></note> ಎಂದು ಯೆಹೋವ ದೇವರು ಆಜ್ಞಾಪಿಸಿದ ಮೋಶೆಯ ನಿಯಮ ಗ್ರಂಥದಲ್ಲಿ ಬರೆದಿರುವ ಪ್ರಕಾರ, ಅಮಚ್ಯನು ಕೊಲೆಗಾರರ ಮಕ್ಕಳನ್ನು ಕೊಂದುಹಾಕಲಿಲ್ಲ.<verse eid="2CH 25:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="2CH 25:5"/>ಇದಲ್ಲದೆ ಅಮಚ್ಯನು ಯೆಹೂದದವರನ್ನು ಕೂಡಿಸಿಕೊಂಡು, ಯೆಹೂದ ಬೆನ್ಯಾಮೀನ್ಯರೆಲ್ಲರಲ್ಲಿ ತಮ್ಮ ಪಿತೃಗಳ ಮನೆಗಳ ಪ್ರಕಾರ ಅವರನ್ನು ಸಾವಿರ ಜನರ ಮೇಲೆ ಅಧಿಪತಿಗಳಾಗಿಯೂ, ನೂರು ಜನರ ಮೇಲೆ ಅಧಿಪತಿಗಳಾಗಿಯೂ ಮಾಡಿದನು. ಅವನು ಇಪ್ಪತ್ತು ವರ್ಷ ಮೊದಲುಗೊಂಡು ಹೆಚ್ಚಿನ ಪ್ರಾಯವುಳ್ಳವರನ್ನು ಲೆಕ್ಕಿಸಿ ಆಯ್ದುಕೊಂಡನು. ಯುದ್ಧಕ್ಕೆ ಹೋಗತಕ್ಕಂಥ, ಈಟಿಯನ್ನೂ, ಖೇಡ್ಯವನ್ನೂ ಹಿಡಿದುಕೊಂಡಿರುವಂಥ, ಮೂರು ಲಕ್ಷ ಮಂದಿಯನ್ನು ಕೂಡಿಸಿದನು. <verse eid="2CH 25:5"/><verse number="6" style="v" sid="2CH 25:6"/>ಇದಲ್ಲದೆ ಇಸ್ರಾಯೇಲಿನವರಿಗೆ 3,400 ಕಿಲೋಗ್ರಾಂ ಬೆಳ್ಳಿಯನ್ನು ಕೊಟ್ಟು, ಪರಾಕ್ರಮಶಾಲಿಗಳಾದ ಒಂದು ಲಕ್ಷ ಮಂದಿಯನ್ನು ಕೂಲಿಗೆ ತೆಗೆದುಕೊಂಡನು.<verse eid="2CH 25:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="2CH 25:7"/>ಆಗ ದೇವರ ಮನುಷ್ಯನೊಬ್ಬನು ಅವನ ಬಳಿಗೆ ಬಂದು ಅವನಿಗೆ, “ಅರಸನೇ, ಇಸ್ರಾಯೇಲಿನ ಸೈನ್ಯವು ನಿನ್ನ ಸಂಗಡ ಹೋಗದಿರಲಿ. ಏಕೆಂದರೆ ಯೆಹೋವ ದೇವರು ಇಸ್ರಾಯೇಲರಾದ ಎಫ್ರಾಯೀಮನ ಸಮಸ್ತ ಜನರ ಸಂಗಡ ಇರುವುದಿಲ್ಲ. <verse eid="2CH 25:7"/><verse number="8" style="v" sid="2CH 25:8"/>ನೀವು ಹೋಗಿ ಯುದ್ಧದಲ್ಲಿ ಧೈರ್ಯದಿಂದ ಹೋರಾಡಿದರೂ ದೇವರು ಶತ್ರುವಿನ ಮುಂದೆ ನಿನ್ನನ್ನು ಸೋಲಿಸಿಬಿಡುವರು. ಏಕೆಂದರೆ ಸಹಾಯ ಕೊಡುವುದಕ್ಕೂ, ಬೀಳ ಮಾಡುವುದಕ್ಕೂ ದೇವರಿಗೆ ಶಕ್ತಿ ಉಂಟು,” ಎಂದನು.<verse eid="2CH 25:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="2CH 25:9"/>ಆಗ ಅಮಚ್ಯನು ದೇವರ ಮನುಷ್ಯನಿಗೆ, “ಆದರೆ ಇಸ್ರಾಯೇಲಿನ ದಂಡಿಗೆ ನಾನು ಕೊಟ್ಟ 3,400 ಕಿಲೋಗ್ರಾಂ ಬೆಳ್ಳಿಯನ್ನು ಏನು ಮಾಡಬೇಕು?” ಎಂದನು.</para>
  <para style="p" vid="2CH 25:9">ಅದಕ್ಕೆ ದೇವರ ಮನುಷ್ಯನು, “ಯೆಹೋವ ದೇವರು ಇದಕ್ಕಿಂತ ಅಧಿಕವಾಗಿಯೇ ನಿನಗೆ ಕೊಡಲು ಶಕ್ತರು,” ಎಂದನು.<verse eid="2CH 25:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="2CH 25:10"/>ಆಗ ಅಮಚ್ಯನು ಎಫ್ರಾಯೀಮಿನಿಂದ ತನ್ನ ಬಳಿಗೆ ಬಂದ ಸೈನಿಕರು ತಮ್ಮ ಸ್ಥಳಕ್ಕೆ ತಿರುಗಿ ಹೋಗುವಹಾಗೆ ಅವರನ್ನು ಕಳುಹಿಸಿಬಿಟ್ಟನು. ಆದಕಾರಣ ಅವರ ಕೋಪವು ಯೆಹೂದದ ಮೇಲೆ ಬಹಳವಾಗಿ ಉರಿಯಿತು. ಅವರು ಕೋಪಗೊಂಡವರಾಗಿ ತಮ್ಮ ಮನೆಗೆ ತಿರುಗಿದರು.<verse eid="2CH 25:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="2CH 25:11"/>ಅಮಚ್ಯನು ತನ್ನನ್ನು ಬಲಪಡಿಸಿ ತನ್ನ ಜನರನ್ನು ನಡೆಸಿಕೊಂಡು ಉಪ್ಪಿನ ತಗ್ಗಿಗೆ ಹೋಗಿ, ಅಲ್ಲಿ ಸೇಯೀರಿನ ಮಕ್ಕಳೊಳಗೆ ಹತ್ತು ಸಾವಿರ ಮಂದಿಯನ್ನು ಹೊಡೆದನು. <verse eid="2CH 25:11"/><verse number="12" style="v" sid="2CH 25:12"/>ಬದುಕಿದ್ದ ಬೇರೆ ಹತ್ತು ಸಾವಿರ ಮಂದಿಯನ್ನು ಯೆಹೂದ್ಯರು ಸೆರೆಯಾಗಿ ಒಯ್ದು, ಬಂಡೆಯ ಶಿಖರಕ್ಕೆ ಅವರನ್ನು ಕರೆದುಕೊಂಡು ಹೋಗಿ, ಅಲ್ಲಿಂದ ಅವರನ್ನು ದಬ್ಬಿ ಸಾಯಿಸಿದರು.<verse eid="2CH 25:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="2CH 25:13"/>ತಮ್ಮ ಸಂಗಡ ಯುದ್ಧಕ್ಕೆ ಬಾರದ ಹಾಗೆ ಅಮಚ್ಯನು ಹಿಂದಕ್ಕೆ ಕಳುಹಿಸಿದ ಗುಂಪಿನವರು ಯೆಹೂದದ ಪಟ್ಟಣಗಳ ಮೇಲೆ ದಾಳಿಮಾಡಿ, ಸಮಾರ್ಯ ಮೊದಲುಗೊಂಡು ಬೇತ್ ಹೋರೋನಿನ ಮಟ್ಟಿಗೂ ಮೂರು ಸಾವಿರ ಮಂದಿಯನ್ನು ಕೊಂದು, ಬಹು ಕೊಳ್ಳೆಯನ್ನು ತೆಗೆದುಕೊಂಡು ಹೋದರು.<verse eid="2CH 25:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="2CH 25:14"/>ಅಮಚ್ಯನು ಎದೋಮ್ಯರನ್ನು ಹೊಡೆದು ತಿರುಗಿ ಬಂದ ತರುವಾಯ, ಸೇಯೀರನ ಮಕ್ಕಳ ದೇವರುಗಳನ್ನು ತೆಗೆದುಕೊಂಡು ಬಂದು, ಅವು ತನಗೆ ದೇವರುಗಳಾಗಿರುವ ಹಾಗೆ ನಿಲ್ಲಿಸಿಕೊಂಡು, ಅವುಗಳ ಮುಂದೆ ಅಡ್ಡಬಿದ್ದು, ಅವುಗಳಿಗೆ ಧೂಪವನ್ನು ಸುಟ್ಟನು. <verse eid="2CH 25:14"/><verse number="15" style="v" sid="2CH 25:15"/>ಆದಕಾರಣ ಯೆಹೋವ ದೇವರ ಕೋಪವು ಅಮಚ್ಯನ ಮೇಲೆ ಬಂತು. ದೇವರು ಅವನ ಬಳಿಗೆ ಪ್ರವಾದಿಯನ್ನು ಕಳುಹಿಸಿದರು. ಪ್ರವಾದಿಯು ಅರಸನಿಗೆ, “ನಿನ್ನ ಕೈಯಿಂದ ತಮ್ಮ ಜನರನ್ನು ತಪ್ಪಿಸಲಾರದೆ ಹೋದ ದೇವರುಗಳನ್ನು ನೀನು ವಿಚಾರಿಸುವುದೇನು?” ಎಂದನು.<verse eid="2CH 25:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="2CH 25:16"/>ಪ್ರವಾದಿಯು ಅರಸನ ಸಂಗಡ ಮಾತನಾಡುತ್ತಿರುವಾಗಲೇ ಅರಸನು ಅವನಿಗೆ, “ಅರಸನ ಆಲೋಚನಾ ಮಂತ್ರಿಯನ್ನಾಗಿ ನಿನ್ನನ್ನು ನೇಮಿಸಿದವರು ಯಾರು? ಸುಮ್ಮನಿರು! ನೀನು ಏಕೆ ಮರಣಹೊಂದಬೇಕೆಂದಿರುವೆ?” ಎಂದನು.</para>
  <para style="p" vid="2CH 25:16">ಆಗ ಪ್ರವಾದಿಯು, “ನೀನು ನನ್ನ ಯೋಚನೆಯನ್ನು ಕೇಳದೆ ಇದನ್ನು ಮಾಡಿದ್ದರಿಂದ, ದೇವರು ನಿನ್ನನ್ನು ನಾಶಮಾಡಲು ತೀರ್ಮಾನಿಸಿದ್ದಾರೆಂದು ನಾನು ಬಲ್ಲೆನು,” ಎಂದನು.<verse eid="2CH 25:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="2CH 25:17"/>ಆಗ ಯೆಹೂದದ ಅರಸನಾದ ಅಮಚ್ಯನು ಆಲೋಚನೆ ಕೇಳಿ, ಯೇಹುವಿನ ಮೊಮ್ಮಗನೂ ಯೆಹೋವಾಹಾಜನ ಮಗನೂ ಇಸ್ರಾಯೇಲರ ಅರಸನಾದ ಯೋವಾಷನಿಗೆ, “ನಾವು ಒಬ್ಬರನ್ನೊಬ್ಬರು ಎದುರಿಸೋಣ ಬಾ,” ಎಂದು ದೂತರ ಮುಖಾಂತರ ಹೇಳಿ ಕಳುಹಿಸಿದನು.<verse eid="2CH 25:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="2CH 25:18"/>ಆಗ ಇಸ್ರಾಯೇಲಿನ ಅರಸನಾದ ಯೋವಾಷನು ಯೆಹೂದದ ಅರಸನಾಗಿರುವ ಅಮಚ್ಯನಿಗೆ, “ಲೆಬನೋನಿನಲ್ಲಿದ್ದ ಮುಳ್ಳುಗಿಡವು ಲೆಬನೋನಿನಲ್ಲಿರುವ ದೇವದಾರು ಮರಕ್ಕೆ, ‘ನನ್ನ ಮಗನಿಗೆ ಹೆಂಡತಿಯಾಗಿರಲು ನೀನು ನಿನ್ನ ಮಗಳನ್ನು ಕೊಡು,’ ಎಂದು ಹೇಳಿ ಕಳುಹಿಸಿತು. ಆದರೆ ಲೆಬನೋನಿನಲ್ಲಿದ್ದ ಅಡವಿಯ ಮೃಗವು ಹಾದು ಹೋಗುತ್ತಿರುವಾಗ, ಆ ಮುಳ್ಳುಗಿಡವನ್ನು ತುಳಿಯಿತು. <verse eid="2CH 25:18"/><verse number="19" style="v" sid="2CH 25:19"/>ನೀನು ಎದೋಮ್ಯರನ್ನು ಸೋಲಿಸಿ ಕೀರ್ತಿಯನ್ನು ಪಡೆದುಕೊಂಡೆನಲ್ಲಾ ಎಂದು ನಿನ್ನ ಹೃದಯವು ಗರ್ವಪಡದಿರಲಿ. ಈಗ ಮನೆಯಲ್ಲಿ ಸುಮ್ಮನೆ ಕೂತಿರು. ನೀನೂ, ನಿನ್ನ ಸಂಗಡ ಯೆಹೂದವೂ ಬಿದ್ದುಹೋಗುವಂತೆ ನಿನ್ನ ಕೇಡಿಗೆ ನೀನೇ ಕೈ ಹಾಕುವುದೇಕೆ?” ಎಂದನು.<verse eid="2CH 25:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="2CH 25:20"/>ಆದರೆ ಅಮಚ್ಯನು ಕೇಳದೆ ಹೋದನು. ಏಕೆಂದರೆ ಯೆಹೂದ್ಯರು ಎದೋಮ್ಯರ ದೇವರುಗಳನ್ನು ಹುಡುಕಿದ ನಿಮಿತ್ತ, ಅವರನ್ನು ಯೆಹೋವಾಷನ ಕೈಯಲ್ಲಿ ಒಪ್ಪಿಸುವಂತೆ ಇದು ದೇವರಿಂದ ಆಯಿತು. <verse eid="2CH 25:20"/><verse number="21" style="v" sid="2CH 25:21"/>ಹಾಗೆಯೇ ಇಸ್ರಾಯೇಲಿನ ಅರಸನಾದ ಯೋವಾಷನು ಯುದ್ಧಕ್ಕೆ ಹೊರಟನು. ಅವನೂ, ಯೆಹೂದದ ಅರಸನಾದ ಅಮಚ್ಯನೂ ಯೆಹೂದಕ್ಕೆ ಸೇರಿದ ಬೇತ್ ಷೆಮೆಷ್ ಊರಿನ ಬಳಿಯಲ್ಲಿ ಒಬ್ಬರನ್ನೊಬ್ಬರು ಎದುರಿಸಿದರು. <verse eid="2CH 25:21"/><verse number="22" style="v" sid="2CH 25:22"/>ಯೆಹೂದದವರು ಇಸ್ರಾಯೇಲರ ಮುಂದೆ ಸೋತುಹೋದದ್ದರಿಂದ ಅವರೆಲ್ಲರೂ ತಮ್ಮ ತಮ್ಮ ಮನೆಗಳಿಗೆ ಓಡಿಹೋದರು. <verse eid="2CH 25:22"/><verse number="23" style="v" sid="2CH 25:23"/>ಆಗ ಇಸ್ರಾಯೇಲಿನ ಅರಸನಾದ ಯೋವಾಷನು ಯೆಹೋವಾಹಾಜನ ಮೊಮ್ಮಗನೂ, ಯೆಹೋವಾಷನ ಮಗನೂ ಯೆಹೂದದ ಅರಸನೂ ಆದ ಅಮಚ್ಯನನ್ನು ಬೇತ್ ಷೆಮೆಷ್ ಊರಿನ ಬಳಿಯಲ್ಲಿ ವಶಪಡಿಸಿಕೊಂಡನು. ಅನಂತರ ಅವನನ್ನು ಯೆರೂಸಲೇಮಿಗೆ ತೆಗೆದುಕೊಂಡು, ಎಫ್ರಾಯೀಮಿನ ಬಾಗಿಲು ಮೊದಲುಗೊಂಡು, ಮೂಲೆಯ ಬಾಗಿಲವರೆಗೂ, 180 ಮೀಟರ್ ಉದ್ದದ ಯೆರೂಸಲೇಮಿನ ಗೋಡೆಯನ್ನು ಕೆಡವಿಬಿಟ್ಟನು. <verse eid="2CH 25:23"/><verse number="24" style="v" sid="2CH 25:24"/>ಅವನು ಓಬೇದ್ ಏದೋಮನ ಬಳಿಯಲ್ಲಿ ಯೆಹೋವ ದೇವರ ಆಲಯದಲ್ಲಿ ಸಿಕ್ಕಿದ ಸಕಲ ಬೆಳ್ಳಿಬಂಗಾರವನ್ನೂ, ಎಲ್ಲಾ ಸಲಕರಣೆಗಳನ್ನೂ, ಅರಮನೆಯ ಬೊಕ್ಕಸಗಳನ್ನೂ ಬಂಧಿತರಾದವರನ್ನೂ ತೆಗೆದುಕೊಂಡು ಸಮಾರ್ಯಕ್ಕೆ ಹಿಂದಿರುಗಿದನು.<verse eid="2CH 25:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="2CH 25:25"/>ಇಸ್ರಾಯೇಲಿನ ಅರಸನಾದ ಯೆಹೋವಾಹಾಜನ ಮಗನಾದ ಯೆಹೋವಾಷನ ಮರಣದ ತರುವಾಯ, ಯೆಹೂದದ ಅರಸನಾದ ಯೋವಾಷನ ಮಗನಾಗಿರುವ ಅಮಚ್ಯನು ಹದಿನೈದು ವರ್ಷ ಬದುಕಿದನು. <verse eid="2CH 25:25"/><verse number="26" style="v" sid="2CH 25:26"/>ಅಮಚ್ಯನ ಆಳ್ವಿಕೆಯ ಇತರ ಕ್ರಿಯೆಗಳನ್ನು, ಮೊದಲನೆಯದಿಂದ ಕಡೆಯವರೆಗೆ ಯೆಹೂದ ಇಸ್ರಾಯೇಲರ ಅರಸರ ಇತಿಹಾಸಗಳ ಪುಸ್ತಕದಲ್ಲಿ ಬರೆದಿರುತ್ತವೆ. <verse eid="2CH 25:26"/><verse number="27" style="v" sid="2CH 25:27"/>ಅಮಚ್ಯನು ಯೆಹೋವ ದೇವರ ಕಡೆಯಿಂದ ತೊಲಗಿಹೋದ ತರುವಾಯ, ಯೆರೂಸಲೇಮಿನವರು ಅವನ ವಿರೋಧವಾಗಿ ಒಳಸಂಚು ಮಾಡಿದ್ದರಿಂದ, ಅವನು ಲಾಕೀಷಿಗೆ ಓಡಿಹೋದನು. ಆದರೆ ಅವರು ಅವನ ಹಿಂದೆ ಲಾಕೀಷಿಗೆ ಜನರನ್ನು ಕಳುಹಿಸಿ, ಅಲ್ಲಿ ಅವನನ್ನು ಕೊಂದುಹಾಕಿದರು. <verse eid="2CH 25:27"/><verse number="28" style="v" sid="2CH 25:28"/>ಅವರು ಅವನ ಶವವನ್ನು ಕುದುರೆಗಳ ಮೇಲೆ ತೆಗೆದುಕೊಂಡು ಬಂದು, ಯೆಹೂದದ ಪಟ್ಟಣದಲ್ಲಿ<note caller="+" style="f"><char style="fr" closed="false">25:28 </char><char style="fq" closed="false">ಯೆಹೂದದ ಪಟ್ಟಣದಲ್ಲಿ </char><char style="ft" closed="false">ಕೆಲವು ಪ್ರತಿಗಳಲ್ಲಿ </char><char style="fqa" closed="false">ದಾವೀದನ ಪಟ್ಟಣದಲ್ಲಿ </char><char style="ft" closed="false">ನೋಡಿರಿ <char style="xt"><ref loc="2KI 14:20">2 ಅರಸು 14:20</ref></char></char></note> ಅವನ ಪಿತೃಗಳ ಬಳಿಯಲ್ಲಿ ಸಮಾಧಿಮಾಡಿದರು.<verse eid="2CH 25:28"/></para>
  <chapter eid="2CH 25"/>
  <chapter number="26" style="c" sid="2CH 26"/>
  <para style="s1">ಯೆಹೂದ್ಯ ಪ್ರಾಂತ್ಯದ ಅರಸನಾದ ಉಜ್ಜೀಯನು</para>
  <para style="p">
    <verse number="1" style="v" sid="2CH 26:1"/>ಆಗ ಯೆಹೂದ ಜನರೆಲ್ಲರು ಹದಿನಾರು ವರ್ಷದವನಾದ ಉಜ್ಜೀಯನನ್ನು ತೆಗೆದುಕೊಂಡು, ಅವನನ್ನು ಅವನ ತಂದೆ ಅಮಚ್ಯನಿಗೆ ಬದಲಾಗಿ ಅರಸನನ್ನಾಗಿ ಮಾಡಿದರು. <verse eid="2CH 26:1"/><verse number="2" style="v" sid="2CH 26:2"/>ಅರಸನು ತನ್ನ ಪಿತೃಗಳ ಜೊತೆ ಸೇರಿದ ತರುವಾಯ, ಉಜ್ಜೀಯನು ಏಲೋತ್ ಪಟ್ಟಣವನ್ನು ಕಟ್ಟಿಸಿ, ಅದನ್ನು ಯೆಹೂದಕ್ಕೆ ತಿರುಗಿ ಸೇರಿಸಿದನು.<verse eid="2CH 26:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="2CH 26:3"/>ಉಜ್ಜೀಯನು ಅರಸನಾದಾಗ, ಹದಿನಾರು ವರ್ಷದವನಾಗಿದ್ದು, ಯೆರೂಸಲೇಮಿನಲ್ಲಿ ಐವತ್ತೆರಡು ವರ್ಷ ಆಳಿದನು. ಅವನ ತಾಯಿಯ ಹೆಸರು ಯೆಕೊಲ್ಯಳು, ಅವಳು ಯೆರೂಸಲೇಮಿನವಳು. <verse eid="2CH 26:3"/><verse number="4" style="v" sid="2CH 26:4"/>ಅವನು ತನ್ನ ತಂದೆಯಾದ ಅಮಚ್ಯನಂತೆ ಯೆಹೋವ ದೇವರ ದೃಷ್ಟಿಯಲ್ಲಿ ಒಳ್ಳೆಯದನ್ನು ಮಾಡಿದನು. <verse eid="2CH 26:4"/><verse number="5" style="v" sid="2CH 26:5"/>ದೇವರ ದರ್ಶನಗಳಲ್ಲಿ ಗ್ರಹಿಕೆಯುಳ್ಳವನಾದ ಜೆಕರ್ಯನ ದಿವಸಗಳಲ್ಲಿ ಅವನು ದೇವರನ್ನು ಹುಡುಕಿದನು. ಯೆಹೋವ ದೇವರನ್ನು ಹುಡುಕುವ ದಿವಸಗಳ ಮಟ್ಟಿಗೂ, ದೇವರು ಅವನನ್ನು ಅಭಿವೃದ್ಧಿ ಪಡಿಸಿದರು.<verse eid="2CH 26:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="2CH 26:6"/>ಅವನು ಹೊರಟುಹೋಗಿ ಫಿಲಿಷ್ಟಿಯರ ಮೇಲೆ ಯುದ್ಧಮಾಡಿ, ಗತ್‌ನ ಗೋಡೆಯನ್ನೂ, ಯಬ್ನೆಯ ಗೋಡೆಯನ್ನೂ, ಅಷ್ಡೋದಿನ ಗೋಡೆಯನ್ನೂ ಕೆಡವಿಬಿಟ್ಟು, ಅಷ್ಡೋದಿನ ಮತ್ತು ಫಿಲಿಷ್ಟಿಯರ ಪ್ರಾಂತ್ಯಗಳಲ್ಲಿ ಪಟ್ಟಣಗಳನ್ನು ಕಟ್ಟಿಸಿದನು. <verse eid="2CH 26:6"/><verse number="7" style="v" sid="2CH 26:7"/>ಇದಲ್ಲದೆ ಫಿಲಿಷ್ಟಿಯರ ಮೇಲೆಯೂ, ಗುರ್ಬಾಳಿನಲ್ಲಿ ವಾಸವಾಗಿದ್ದ ಅರಬಿಯರ ಮೇಲೆಯೂ, ಮೆಗೂನ್ಯರ ಮೇಲೆಯೂ ಅವನು ಯುದ್ಧಮಾಡಿದಾಗ, ದೇವರು ಅವನಿಗೆ ಸಹಾಯ ಮಾಡಿದರು. <verse eid="2CH 26:7"/><verse number="8" style="v" sid="2CH 26:8"/>ಅಮ್ಮೋನ್ಯರು ಉಜ್ಜೀಯನಿಗೆ ಕಪ್ಪವನ್ನು ಕೊಟ್ಟರು. ಆದ್ದರಿಂದ ಅವನ ಹೆಸರು ಈಜಿಪ್ಟಿನ ಪ್ರದೇಶದವರೆಗೂ ಬಹಳವಾಗಿ ಹಬ್ಬಿತು. ಅವನು ಬಹಳವಾಗಿ ಬಲಪಡಿಸಿಕೊಂಡಿದ್ದನು.<verse eid="2CH 26:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="2CH 26:9"/>ಉಜ್ಜೀಯನು ಯೆರೂಸಲೇಮಿನಲ್ಲಿ ಮೂಲೆ ಬಾಗಿಲ ಬಳಿಯಲ್ಲಿಯೂ, ತಗ್ಗಿನ ಬಾಗಿಲ ಬಳಿಯಲ್ಲಿಯೂ, ಕೋಟೆಯ ಮೂಲೆಯಲ್ಲಿಯೂ ಬುರುಜುಗಳನ್ನು ಕಟ್ಟಿಸಿದನು. <verse eid="2CH 26:9"/><verse number="10" style="v" sid="2CH 26:10"/>ತಗ್ಗಿನ ದೇಶದಲ್ಲಿಯೂ, ಬಯಲು ದೇಶದಲ್ಲಿಯೂ ಅವನಿಗೆ ಬಹು ಪಶುಗಳಿದ್ದವು. ಆ ಅಡವಿಯಲ್ಲಿ ಬುರುಜುಗಳನ್ನು ಕಟ್ಟಿಸಿ ಅನೇಕ ಬಾವಿಗಳನ್ನು ತೋಡಿಸಿದನು. ಹಾಗೆಯೇ ಪರ್ವತಗಳಲ್ಲಿಯೂ, ಕರ್ಮೆಲಿನಲ್ಲಿಯೂ ಅವನಿಗೆ ಒಕ್ಕಲಿಗರೂ, ದ್ರಾಕ್ಷಿ ವ್ಯವಸಾಯದವರೂ ಇದ್ದರು. ಏಕೆಂದರೆ ಅವನು ವ್ಯವಸಾಯದಲ್ಲಿ ಇಷ್ಟವುಳ್ಳವನಾಗಿದ್ದನು.<verse eid="2CH 26:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="2CH 26:11"/>ಇದಲ್ಲದೆ ಲೇಖಕನಾದ ಯೆಹೀಯೇಲನ ಕೈಯಿಂದಲೂ, ಅಧಿಪತಿಯಾದ ಮಾಸೇಯನ ಕೈಯಿಂದ ಬರೆದಿರುವ ಲೆಕ್ಕದ ಪ್ರಕಾರ, ಗುಂಪುಗುಂಪಾಗಿ ಯುದ್ಧಕ್ಕೆ ಹೋಗುವ ಯುದ್ಧವೀರರ ಸೈನ್ಯವು ಉಜ್ಜೀಯನಿಗೆ ಇತ್ತು. ಆ ಸೈನ್ಯವು ಅರಸನ ಪ್ರಧಾನರಲ್ಲಿ ಒಬ್ಬನಾದ ಹನನ್ಯನ ಕೈಕೆಳಗೆ ಇತ್ತು. <verse eid="2CH 26:11"/><verse number="12" style="v" sid="2CH 26:12"/>ಪರಾಕ್ರಮಶಾಲಿಗಳಲ್ಲಿ ಕುಟುಂಬಗಳ ಮುಖ್ಯಸ್ಥರ ಲೆಕ್ಕವು 2,600 ಮಂದಿ. <verse eid="2CH 26:12"/><verse number="13" style="v" sid="2CH 26:13"/>ಅವರ ಕೈಕೆಳಗೆ ಅರಸನಿಗೆ ಸಹಾಯವಾಗಿ ಶತ್ರುವಿನ ಮೇಲೆ ಬಹಳ ಪರಾಕ್ರಮದಿಂದ ಯುದ್ಧಮಾಡುವ 3,07,500 ಮಂದಿಯುಳ್ಳ ಸೈನ್ಯವಿತ್ತು. <verse eid="2CH 26:13"/><verse number="14" style="v" sid="2CH 26:14"/>ಉಜ್ಜೀಯನು ಸಮಸ್ತ ದಂಡಿನಲ್ಲಿ ಅವರ ನಿಮಿತ್ತ ಗುರಾಣಿಗಳನ್ನೂ, ಈಟಿಗಳನ್ನೂ, ಶಿರಸ್ತ್ರಾಣಗಳನ್ನೂ, ಉಕ್ಕಿನ ಕವಚಗಳನ್ನೂ, ಬಿಲ್ಲುಗಳನ್ನೂ, ಕವಣೆಗಳನ್ನೂ ಸಿದ್ಧಮಾಡಿದನು. <verse eid="2CH 26:14"/><verse number="15" style="v" sid="2CH 26:15"/>ಇದಲ್ಲದೆ ಬಾಣಗಳನ್ನೂ, ದೊಡ್ಡ ಕಲ್ಲುಗಳನ್ನೂ ಎಸೆಯುವ ನಿಮಿತ್ತ ಬುರುಜುಗಳ ಮೇಲೆಯೂ, ಮಣ್ಣುದಿಬ್ಬಗಳ ಮೇಲೆಯೂ ಇರಲು, ಪ್ರವೀಣರಿಂದ ಮಾಡಿದ ಯಂತ್ರಗಳನ್ನೂ ಯೆರೂಸಲೇಮಿನಲ್ಲಿ ಮಾಡಿಸಿದನು. ಆದ್ದರಿಂದ ಅವನ ಹೆಸರು ಬಹಳ ದೂರದವರೆಗೆ ಪ್ರಸಿದ್ಧಿಯಾಯಿತು. ಬಹು ಬಲಿಷ್ಠನಾಗುವ ಪರ್ಯಂತರ ಅವನು ಬಹು ಆಶ್ಚರ್ಯಕರವಾಗಿ ಸಹಾಯ ಪಡೆಯುತ್ತಿದ್ದನು.<verse eid="2CH 26:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="2CH 26:16"/>ಆದರೆ ಅವನು ಬಲ ಹೊಂದಿದ ಮೇಲೆ ಅವನ ಗರ್ವವು ನಾಶಕ್ಕೆ ನಡೆಸಿತು. ಅವನು ಧೂಪಪೀಠದ ಮೇಲೆ ಧೂಪಸುಡುವುದಕ್ಕೂ, ಯೆಹೋವ ದೇವರ ಆಲಯದಲ್ಲಿ ಪ್ರವೇಶಿಸಿ ತನ್ನ ದೇವರಾದ ಯೆಹೋವ ದೇವರಿಗೆ ವಿರೋಧವಾಗಿ ಅಪರಾಧ ಮಾಡಿದನು. <verse eid="2CH 26:16"/><verse number="17" style="v" sid="2CH 26:17"/>ಆಗ ಯಾಜಕನಾದ ಅಜರ್ಯನೂ, ಅವನ ಸಂಗಡ ಯೆಹೋವ ದೇವರ ಪರಾಕ್ರಮವುಳ್ಳ ಯಾಜಕರಾದ ಎಂಬತ್ತು ಮಂದಿಯೂ ಅರಸನಾದ ಉಜ್ಜೀಯನ ಹಿಂದೆ ಪ್ರವೇಶಿಸಿ, <verse eid="2CH 26:17"/><verse number="18" style="v" sid="2CH 26:18"/>ಅವನನ್ನು ಎದುರಿಸಿ, “ಉಜ್ಜೀಯನೇ, ಯೆಹೋವ ದೇವರಿಗೆ ಧೂಪ ಸುಡುವುದು ಪ್ರತಿಷ್ಠಿತರಾದ ಯಾಜಕರಾದ ಆರೋನನ ಮಕ್ಕಳಿಗೆ ಸೇರಿದ್ದು. ನೀನು ಪರಿಶುದ್ಧ ಸ್ಥಳದಿಂದ ಹೊರಟು ಹೋಗು, ಅಪರಾಧ ಮಾಡಿದೆ. ದೇವರಾದ ಯೆಹೋವ ದೇವರಿಂದ ನಿನಗೆ ಗೌರವ ದೊರಕದು,” ಎಂದನು.<verse eid="2CH 26:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="2CH 26:19"/>ಆಗ ಉಜ್ಜೀಯನು ಕೋಪಿಸಿಕೊಂಡನು. ಧೂಪವನ್ನು ಸುಡಲು ಅವನ ಕೈಯಲ್ಲಿ ಧೂಪಾರತಿ ಇತ್ತು. ಆದರೆ ಅವನು ಯಾಜಕರ ಮೇಲೆ ಕೋಪ ಮಾಡುತ್ತಿರುವಾಗಲೇ, ಯೆಹೋವ ದೇವರ ಮಂದಿರದಲ್ಲಿರುವ ಧೂಪಪೀಠದ ಬಳಿಯಲ್ಲಿ ನಿಂತ ಯಾಜಕರ ಮುಂದೆ ಅವನ ಹಣೆಯಲ್ಲಿ ಕುಷ್ಠವು ಬಂದಿತು. <verse eid="2CH 26:19"/><verse number="20" style="v" sid="2CH 26:20"/>ಆಗ ಮುಖ್ಯಯಾಜಕನಾದ ಅಜರ್ಯನೂ, ಯಾಜಕರೆಲ್ಲರೂ ಅವನನ್ನು ದೃಷ್ಟಿಸಿ ನೋಡಿದಾಗ ಅವನ ಹಣೆಯಲ್ಲಿ ಕುಷ್ಠವು ಕಂಡುಬಂದದ್ದರಿಂದ ಅವರು ಅವನನ್ನು ಶೀಘ್ರವಾಗಿ ಅಲ್ಲಿಂದ ಹೊರಹಾಕಿದರು. ಯೆಹೋವ ದೇವರು ತನ್ನನ್ನು ಬಾಧಿಸಿದ್ದರಿಂದ ಅವನು ಸ್ವತಃ ಹೊರಗೆ ಹೋಗಲು ತ್ವರೆಪಟ್ಟನು.<verse eid="2CH 26:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="2CH 26:21"/>ಅರಸನಾದ ಉಜ್ಜೀಯನು ಮರಣದ ದಿವಸದವರೆಗೂ ಕುಷ್ಠರೋಗಿಯಾಗಿದ್ದು ಯೆಹೋವ ದೇವರ ಆಲಯದಿಂದ ಬಹಿಷ್ಕೃತನಾದನು. ಅವನು ಕುಷ್ಠರೋಗದ ನಿಮಿತ್ತ ಪ್ರತ್ಯೇಕವಾದ ಮನೆಯಲ್ಲಿ ವಾಸವಾಗಿದ್ದನು. ಅವನ ಮಗ ಯೋತಾಮನು ರಾಜಗೃಹಾಧಿಪತ್ಯವನ್ನು ಮತ್ತು ಪ್ರಜಾಪಾಲನೆಯನ್ನೂ ನೋಡಿಕೊಳ್ಳುತ್ತಿದ್ದನು.<verse eid="2CH 26:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="2CH 26:22"/>ಉಜ್ಜೀಯನ ಇತರ ಕ್ರಿಯೆಗಳನ್ನು, ಮೊದಲನೆಯದಿಂದ ಕಡೆಯವರೆಗೆ ಆಮೋಚನ ಮಗನಾದ ಯೆಶಾಯನೆಂಬ ಪ್ರವಾದಿಯು ಬರೆದನು. <verse eid="2CH 26:22"/><verse number="23" style="v" sid="2CH 26:23"/>ಉಜ್ಜೀಯನು ಮೃತನಾಗಿ ತನ್ನ ಪಿತೃಗಳ ಬಳಿಗೆ ಸೇರಿದನು. ಅವನು ಕುಷ್ಠರೋಗಿಯಾಗಿದ್ದರಿಂದ, ಅವರು ಅವನ ಶವವನ್ನು ರಾಜಕುಟುಂಬದ ಸ್ಮಶಾನ ಭೂಮಿಯ ಹತ್ತಿರದ ಹೊಲದಲ್ಲಿ ಸಮಾಧಿಮಾಡಿದರು. ಅವನಿಗೆ ಬದಲಾಗಿ ಅವನ ಮಗನಾದ ಯೋತಾಮನು ಅರಸನಾದನು.<verse eid="2CH 26:23"/></para>
  <chapter eid="2CH 26"/>
  <chapter number="27" style="c" sid="2CH 27"/>
  <para style="s1">ಯೆಹೂದ್ಯ ಪ್ರಾಂತ್ಯದ ಅರಸನಾದ ಯೋತಾಮನು</para>
  <para style="p">
    <verse number="1" style="v" sid="2CH 27:1"/>ಯೋತಾಮನು ಆಳಲು ಆರಂಭಿಸಿದಾಗ ಇಪ್ಪತ್ತೈದು ವರ್ಷದವನಾಗಿದ್ದು, ಯೆರೂಸಲೇಮಿನಲ್ಲಿ ಹದಿನಾರು ವರ್ಷ ಆಳಿದನು. ಚಾದೋಕನ ಮಗಳಾದ ಯೆರೂಷ ಅವನ ತಾಯಿ. <verse eid="2CH 27:1"/><verse number="2" style="v" sid="2CH 27:2"/>ಅವನು ತನ್ನ ತಂದೆಯಾದ ಉಜ್ಜೀಯನಂತೆ ಯೆಹೋವ ದೇವರ ದೃಷ್ಟಿಯಲ್ಲಿ ಒಳ್ಳೆಯದನ್ನು ಮಾಡಿದನು. ಆದರೆ ಅವನ ತಂದೆಯಂತೆ ಯೆಹೋವ ದೇವರ ಆಲಯದಲ್ಲಿ ಪ್ರವೇಶಿಸಲಿಲ್ಲ. ಆಗ ಜನರು ಇನ್ನೂ ಕೆಟ್ಟದ್ದನ್ನು ಮಾಡುತ್ತಾ ಇದ್ದರು. <verse eid="2CH 27:2"/><verse number="3" style="v" sid="2CH 27:3"/>ಅವನು ಯೆಹೋವ ದೇವರ ಆಲಯದ ಮೇಲಿನ ಬಾಗಿಲನ್ನು ಕಟ್ಟಿಸಿ, ಓಫೇಲ್ ಗೋಡೆಯನ್ನು ಎತ್ತರವಾಗಿ ಕಟ್ಟಿಸಿದನು. <verse eid="2CH 27:3"/><verse number="4" style="v" sid="2CH 27:4"/>ಇದಲ್ಲದೆ ಯೆಹೂದ ಪರ್ವತ ಪ್ರದೇಶದಲ್ಲಿ ಪಟ್ಟಣಗಳನ್ನೂ ಕಾಡುಗಳ ಪ್ರದೇಶದಲ್ಲಿ ಕೋಟೆಗಳನ್ನೂ ಬುರುಜುಗಳನ್ನೂ ಕಟ್ಟಿಸಿದನು.<verse eid="2CH 27:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="2CH 27:5"/>ಯೋತಾಮನು ಅಮ್ಮೋನ್ಯರ ಅರಸನ ಸಂಗಡ ಯುದ್ಧಮಾಡಿ ಅವನನ್ನು ಜಯಿಸಿದನು. ಆದ್ದರಿಂದ ಅಮ್ಮೋನಿಯರು ಅದೇ ವರ್ಷದಲ್ಲಿ 3,400 ಕಿಲೋಗ್ರಾಂ ಬೆಳ್ಳಿ, 1,600 ಮೆಟ್ರಿಕ್ ಟನ್ ಗೋಧಿ, 1,350 ಮೆಟ್ರಿಕ್ ಟನ್ ಜವೆಗೋಧಿಯನ್ನೂ ಅವನಿಗೆ ಕೊಟ್ಟರು. ಅಮ್ಮೋನಿಯರು ಎರಡನೆಯ ವರ್ಷದಲ್ಲಿಯೂ, ಮೂರನೆಯ ವರ್ಷದಲ್ಲಿಯೂ ಅದೇ ಪ್ರಕಾರ ಅವನಿಗೆ ಕೊಟ್ಟರು.<verse eid="2CH 27:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="2CH 27:6"/>ಹೀಗೆ ಯೋತಾಮನು ತನ್ನ ದೇವರಾದ ಯೆಹೋವ ದೇವರ ಮುಂದೆ ತನ್ನ ಮಾರ್ಗಗಳನ್ನು ಸರಿಪಡಿಸಿಕೊಂಡದ್ದರಿಂದ ಅವನು ಬಲಗೊಂಡನು.<verse eid="2CH 27:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="2CH 27:7"/>ಯೋತಾಮನ ಇತರ ಕ್ರಿಯೆಗಳೂ, ಅವನು ಮಾಡಿದ ಯುದ್ಧಗಳೂ, ಅವನ ಮಾರ್ಗಗಳೂ, ಅವು ಇಸ್ರಾಯೇಲರ ಮತ್ತು ಯೆಹೂದದ ಅರಸರ ಇತಿಹಾಸಗಳ ಪುಸ್ತಕದಲ್ಲಿ ಬರೆದಿರುತ್ತವೆ. <verse eid="2CH 27:7"/><verse number="8" style="v" sid="2CH 27:8"/>ಅವನು ಆಳಲು ಆರಂಭಿಸಿದಾಗ ಇಪ್ಪತ್ತೈದು ವರ್ಷದವನಾಗಿದ್ದು, ಯೆರೂಸಲೇಮಿನಲ್ಲಿ ಹದಿನಾರು ವರ್ಷ ಆಳಿದನು. <verse eid="2CH 27:8"/><verse number="9" style="v" sid="2CH 27:9"/>ಯೋತಾಮನು ಮೃತನಾಗಿ ತನ್ನ ಪಿತೃಗಳ ಬಳಿಗೆ ಸೇರಿದನು. ಅವನ ಶವವನ್ನು ದಾವೀದನ ಪಟ್ಟಣದಲ್ಲಿ ಸಮಾಧಿಮಾಡಿದರು. ಅವನ ಮಗ ಆಹಾಜನು ಅವನಿಗೆ ಬದಲಾಗಿ ಅರಸನಾದನು.<verse eid="2CH 27:9"/></para>
  <chapter eid="2CH 27"/>
  <chapter number="28" style="c" sid="2CH 28"/>
  <para style="s1">ಯೆಹೂದ್ಯ ಪ್ರಾಂತ್ಯದ ಅರಸನಾದ ಆಹಾಜನು</para>
  <para style="p">
    <verse number="1" style="v" sid="2CH 28:1"/>ಆಹಾಜನು ಆಳಲು ಆರಂಭಿಸಿದಾಗ ಇಪ್ಪತ್ತು ವರ್ಷದವನಾಗಿದ್ದು, ಯೆರೂಸಲೇಮಿನಲ್ಲಿ ಹದಿನಾರು ವರ್ಷ ಆಳಿದನು. ಆದರೆ ಅವನು ತನ್ನ ತಂದೆಯಾದ ದಾವೀದನ ಹಾಗೆ ನಡೆಯದೆ, ಯೆಹೋವ ದೇವರ ದೃಷ್ಟಿಯಲ್ಲಿ ಒಳ್ಳೆಯದನ್ನು ಮಾಡಲಿಲ್ಲ. <verse eid="2CH 28:1"/><verse number="2" style="v" sid="2CH 28:2"/>ಆಹಾಜನು ಇಸ್ರಾಯೇಲಿನ ಅರಸರ ಮಾರ್ಗದಲ್ಲಿ ನಡೆದು, ಆರಾಧಿಸುವುದಕ್ಕಾಗಿ ಬಾಳನ ಎರಕ ಹೊಯ್ದ ವಿಗ್ರಹಗಳನ್ನು ಮಾಡಿಸಿದನು. <verse eid="2CH 28:2"/><verse number="3" style="v" sid="2CH 28:3"/>ಇದಲ್ಲದೆ ಆಹಾಜನು ಬೆನ್ ಹಿನ್ನೋಮ್ ತಗ್ಗಿನಲ್ಲಿ ಧೂಪವನ್ನರ್ಪಿಸಿ, ಯೆಹೋವ ದೇವರು ಇಸ್ರಾಯೇಲರ ಎದುರಿನಿಂದ ಓಡಿಸಿಬಿಟ್ಟ ಇತರ ಜನಾಂಗಗಳ ಅಸಹ್ಯಕರವಾದ ಆಚಾರಗಳನ್ನು ಅನುಸರಿಸಿ ಅವನು ತನ್ನ ಮಗನನ್ನೇ ಬೆಂಕಿಯಲ್ಲಿ ಯಜ್ಞವಾಗಿ ಅರ್ಪಿಸಿದನು. <verse eid="2CH 28:3"/><verse number="4" style="v" sid="2CH 28:4"/>ಇದಲ್ಲದೆ ಅವನು ಪೂಜಾಸ್ಥಳಗಳ ಮೇಲೆಯೂ ಬೆಟ್ಟಗಳ ಮೇಲೆಯೂ ಎಲ್ಲಾ ಹಸಿರಾದ ಮರಗಳ ಕೆಳಗೂ ಬಲಿಗಳನ್ನೂ ಧೂಪವನ್ನೂ ಅರ್ಪಿಸಿದನು.<verse eid="2CH 28:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="2CH 28:5"/>ಆದ್ದರಿಂದ ಆಹಾಜನ ದೇವರಾದ ಯೆಹೋವ ದೇವರು ಅರಾಮಿನ ಅರಸನ ಕೈಯಲ್ಲಿ ಅವನನ್ನು ಒಪ್ಪಿಸಿದರು. ಅರಾಮ್ಯರು ಅವನನ್ನು ಹೊಡೆದು, ಅವರಲ್ಲಿ ಅನೇಕರನ್ನು ಸೆರೆಹಿಡಿದು, ದಮಸ್ಕಕ್ಕೆ ತೆಗೆದುಕೊಂಡು ಹೋದರು.</para>
  <para style="p" vid="2CH 28:5">ಇದಲ್ಲದೆ ಆಹಾಜನು ಇಸ್ರಾಯೇಲಿನ ಅರಸನ ಕೈವಶವಾಗಿ, ಅವನಿಂದಲೂ ಕಠಿಣವಾಗಿ ಸೋತು ಹೋದನು. <verse eid="2CH 28:5"/><verse number="6" style="v" sid="2CH 28:6"/>ಯೆಹೂದ್ಯರು ತಮ್ಮ ಪಿತೃಗಳ ದೇವರಾದ ಯೆಹೋವ ದೇವರನ್ನು ಬಿಟ್ಟುಬಿಟ್ಟದ್ದರಿಂದ, ರೆಮಲ್ಯನ ಮಗ ಪೆಕಹನು ಒಂದೇ ದಿವಸದೊಳಗೆ ಅವರಲ್ಲಿ ಲಕ್ಷದ ಇಪ್ಪತ್ತು ಸಾವಿರ ಮಂದಿಯನ್ನು ಕೊಂದುಹಾಕಿದನು. ಇವರೆಲ್ಲರು ಪರಾಕ್ರಮಶಾಲಿಗಳಾಗಿದ್ದರು. <verse eid="2CH 28:6"/><verse number="7" style="v" sid="2CH 28:7"/>ಇದಲ್ಲದೆ ಎಫ್ರಾಯೀಮ್ಯನಾಗಿರುವ ಪರಾಕ್ರಮಶಾಲಿಯಾದ ಜಿಕ್ರಿಯು ಅರಸನ ಮಗ ಮಾಸೇಯನನ್ನೂ, ಅರಮನೆಯ ನಾಯಕನಾದ ಅಜ್ರೀಕಾಮನನ್ನೂ, ಅರಸನಿಗೆ ಎರಡನೆಯವನಾದ ಎಲ್ಕಾನನನ್ನೂ ಕೊಂದುಹಾಕಿದನು. <verse eid="2CH 28:7"/><verse number="8" style="v" sid="2CH 28:8"/>ಇಸ್ರಾಯೇಲರು ತಮ್ಮ ಸಹೋದರರಲ್ಲಿ ಎರಡು ಲಕ್ಷಮಂದಿ ಸ್ತ್ರೀಯರನ್ನೂ, ಪುತ್ರಪುತ್ರಿಯರನ್ನೂ ಸೆರೆಯಾಗಿ ತೆಗೆದುಕೊಂಡು ಹೋದರು. ಅವರಿಂದ ಬಹು ಕೊಳ್ಳೆಯನ್ನೂ ತೆಗೆದುಕೊಂಡು ಸಮಾರ್ಯಕ್ಕೆ ಬಂದರು.<verse eid="2CH 28:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="2CH 28:9"/>ಯೆಹೋವ ದೇವರ ಪ್ರವಾದಿ ಒಬ್ಬನು ಅಲ್ಲಿ ಇದ್ದನು. ಅವನ ಹೆಸರು ಓದೇದನು. ಅವನು ಸಮಾರ್ಯಕ್ಕೆ ಬಂದ ಸೈನ್ಯಕ್ಕೆದುರಾಗಿ ಹೊರಟುಹೋಗಿ ಅವರಿಗೆ, “ನಿಮ್ಮ ಪಿತೃಗಳ ದೇವರಾದ ಯೆಹೋವ ದೇವರು ಯೆಹೂದದ ಮೇಲೆ ಕೋಪಗೊಂಡದ್ದರಿಂದ, ದೇವರು ಅವರನ್ನು ನಿಮ್ಮ ಕೈಯಲ್ಲಿ ಒಪ್ಪಿಸಿದ್ದಾರೆ. ನೀವು ಆಕಾಶಕ್ಕೆ ಮುಟ್ಟುವ ಉಗ್ರತೆಯಿಂದ ಅವರನ್ನು ಕೊಂದುಹಾಕಿದ್ದೀರಿ. <verse eid="2CH 28:9"/><verse number="10" style="v" sid="2CH 28:10"/>ಈಗ ನಿಮಗೆ ದಾಸರೂ, ದಾಸಿಯರೂ ಆಗಿರುವ ಹಾಗೆ ಯೆಹೂದದ ಮತ್ತು ಯೆರೂಸಲೇಮಿನ ಮಕ್ಕಳನ್ನು ನಿಮ್ಮ ವಶಮಾಡಬೇಕೆಂದು ಇದ್ದೀರಿ. ಆದರೆ ನಿಮ್ಮಲ್ಲಿಯೇ ನಿಮ್ಮ ದೇವರಾದ ಯೆಹೋವ ದೇವರಿಗೆ ವಿರೋಧವಾಗಿ ಅಪರಾಧಗಳು ಇಲ್ಲವೋ? <verse eid="2CH 28:10"/><verse number="11" style="v" sid="2CH 28:11"/>ಆದ್ದರಿಂದ ನೀವು ನನ್ನ ಮಾತು ಕೇಳಿ ನಿಮ್ಮ ನಿಮ್ಮ ಸಹೋದರರಲ್ಲಿ ನೀವು ಸೆರೆಯಾಗಿ ತೆಗೆದುಕೊಂಡ ಸೆರೆಯವರನ್ನು ಬಿಟ್ಟುಬಿಡಿರಿ. ಏಕೆಂದರೆ ಯೆಹೋವ ದೇವರ ಕೋಪಾಗ್ನಿಯು ನಿಮ್ಮ ಮೇಲೆ ಇರುವುದು,” ಎಂದನು.<verse eid="2CH 28:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="2CH 28:12"/>ಆಗ ಎಫ್ರಾಯೀಮ್ಯರಲ್ಲಿ ಮುಖಂಡರಾಗಿದ್ದ ಯೆಹೋಹಾನಾನನ ಮಗ ಅಜರ್ಯನೂ, ಮೆಷಿಲ್ಲೇಮೋತನ ಮಗ ಬೆರೆಕ್ಯನೂ, ಶಲ್ಲೂಮನ ಮಗ ಹಿಜ್ಕೀಯನೂ, ಹದ್ಲೈಯನ ಮಗ ಅಮಾಸನೂ ಯುದ್ಧದಿಂದ ಬಂದವರಿಗೆ ವಿರೋಧವಾಗಿ ಎದ್ದು <verse eid="2CH 28:12"/><verse number="13" style="v" sid="2CH 28:13"/>ಅವರಿಗೆ, “ನೀವು ಸೆರೆಯವರನ್ನು ಇಲ್ಲಿಗೆ ತರಬೇಡಿರಿ. ಏಕೆಂದರೆ ನಾವು ಯೆಹೋವ ದೇವರಿಗೆ ವಿರೋಧವಾಗಿ ಅಪರಾಧ ಮಾಡಿದ್ದೇವೆ. ನೀವು ನಮ್ಮ ಪಾಪಗಳನ್ನೂ, ನಮ್ಮ ಅಪರಾಧಗಳನ್ನೂ ಹೆಚ್ಚಿಸಬೇಕೆಂದಿದ್ದೀರಿ. ನಿಶ್ಚಯವಾಗಿ ನಮ್ಮ ಅಪರಾಧವು ದೊಡ್ಡದಾಗಿದೆ. ಇಸ್ರಾಯೇಲಿನ ಮೇಲೆ ಯೆಹೋವ ದೇವರ ಉಗ್ರಕೋಪವು ಉಂಟಾಯಿತು,” ಎಂದರು.<verse eid="2CH 28:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="2CH 28:14"/>ಆಗ ಸೈನ್ಯದವರು ಸೆರೆಯವರನ್ನೂ, ಕೊಳ್ಳೆಯನ್ನೂ ಪ್ರಧಾನರ ಮುಂದೆಯೂ, ಸಮಸ್ತ ಕೂಟದ ಮುಂದೆಯೂ ಬಿಟ್ಟುಬಿಟ್ಟರು. <verse eid="2CH 28:14"/><verse number="15" style="v" sid="2CH 28:15"/>ಆಗ ಎಫ್ರಾಯೀಮ್ಯರಲ್ಲಿ ಮುಖಂಡರಾಗಿದ್ದವರು ಎದ್ದು ಸೆರೆಯವರನ್ನು ತೆಗೆದುಕೊಂಡು, ಅವರಲ್ಲಿ ಬೆತ್ತಲೆಯಾದವರಿಗೆ ಕೊಳ್ಳೆಯ ವಸ್ತ್ರಗಳನ್ನು ಉಡಿಸಿ ತೊಡಿಸಿ, ಅವರಿಗೆ ಕೆರಗಳನ್ನು ಕೊಟ್ಟು ಉಣ್ಣುವುದಕ್ಕೂ, ಕುಡಿಯುವುದಕ್ಕೂ ಕೊಟ್ಟು, ಅವರ ತಲೆಗಳಿಗೆ ಎಣ್ಣೆಯನ್ನು ಹಚ್ಚಿ, ಅವರಲ್ಲಿ ಇರುವ ಬಲಹೀನರನ್ನು ಕತ್ತೆಗಳ ಮೇಲೆ ಏರಿಸಿ, ಯೆರಿಕೋವೆಂಬ ಖರ್ಜೂರದ ಪಟ್ಟಣಕ್ಕೆ ಅವರ ಸಹೋದರರ ಬಳಿಗೆ ತೆಗೆದುಕೊಂಡು ಬಂದರು. ಆಗ ಅವರು ಸಮಾರ್ಯಕ್ಕೆ ಹಿಂದಿರುಗಿದರು.<verse eid="2CH 28:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="2CH 28:16"/>ಅದೇ ಕಾಲದಲ್ಲಿ ಅರಸನಾದ ಆಹಾಜನು ಅಸ್ಸೀರಿಯದ ಅರಸರ ಬಳಿಗೆ ಕಳುಹಿಸಿ ಸಹಾಯ ಬೇಡಿಕೊಂಡನು. <verse eid="2CH 28:16"/><verse number="17" style="v" sid="2CH 28:17"/>ಏಕೆಂದರೆ ಎದೋಮ್ಯರು ತಿರುಗಿಬಂದು ಯೆಹೂದದವರನ್ನು ಸಂಹರಿಸಿ, ಕೆಲವರನ್ನು ಸೆರೆಯಾಗಿ ತೆಗೆದುಕೊಂಡು ಹೋದರು. <verse eid="2CH 28:17"/><verse number="18" style="v" sid="2CH 28:18"/>ಇದಲ್ಲದೆ ಫಿಲಿಷ್ಟಿಯರು ತಗ್ಗಿನ ದೇಶದ ಪಟ್ಟಣಗಳಲ್ಲಿಯೂ, ಯೆಹೂದದ ದಕ್ಷಿಣ ಪ್ರಾಂತದಲ್ಲಿಯೂ ನುಗ್ಗಿ, ಬೇತ್ ಷೆಮೆಷ್, ಅಯ್ಯಾಲೋನ್, ಗೆದೇರೋತ್, ಸೋಕೋ ಅದರ ಗ್ರಾಮಗಳನ್ನೂ, ತಿಮ್ನಾ ಅದರ ಗ್ರಾಮಗಳನ್ನೂ, ಗಿಮ್ಜೋ ಅದರ ಗ್ರಾಮಗಳನ್ನೂ ತೆಗೆದುಕೊಂಡು ಅಲ್ಲಿ ವಾಸವಾಗಿದ್ದರು. <verse eid="2CH 28:18"/><verse number="19" style="v" sid="2CH 28:19"/>ಇಸ್ರಾಯೇಲಿನ ಅರಸನಾದ ಆಹಾಜನ ನಿಮಿತ್ತ ಯೆಹೋವ ದೇವರು ಯೆಹೂದ್ಯ ಪ್ರಾಂತ್ಯವನ್ನು ತಗ್ಗಿಸಿದರು. ಏಕೆಂದರೆ ಅವನು ಯೆಹೂದ್ಯರನ್ನು ಅಧರ್ಮಕ್ಕೆ ಪ್ರಚೋದಿಸಿ, ಯೆಹೋವ ದೇವರಿಗೆ ಮಹಾ ದ್ರೋಹ ಮಾಡಿದನು. ಯೆಹೋವ ದೇವರಿಗೆ ಅತ್ಯಂತ ಅಪನಂಬಿಗಸ್ತನಾಗಿದ್ದನು. <verse eid="2CH 28:19"/><verse number="20" style="v" sid="2CH 28:20"/>ಆಗ ಅಸ್ಸೀರಿಯದ ಅರಸ ತಿಗ್ಲತ್ಪಿಲೆಸರನು ಅವನ ಬಳಿಗೆ ಬಂದು, ಅವನಿಗೆ ನೆರವಾಗುವುದಕ್ಕೆ ಬದಲಾಗಿ ಬಾಧೆಪಡಿಸಿದನು. <verse eid="2CH 28:20"/><verse number="21" style="v" sid="2CH 28:21"/>ಆಹಾಜನು ಯೆಹೋವ ದೇವರ ಆಲಯದಿಂದಲೂ, ಅರಮನೆಯಿಂದಲೂ, ಪ್ರಧಾನರಿಂದಲೂ ಆಸ್ತಿಯ ಒಂದು ಪಾಲನ್ನು ತೆಗೆದುಕೊಂಡು, ಅಸ್ಸೀರಿಯದ ಅರಸನಿಗೆ ಕಾಣಿಕೆಯಾಗಿ ಕೊಟ್ಟನು, ಆದರೂ ಅವನು ಆಹಾಜನಿಗೆ ಸಹಾಯ ಮಾಡಲಿಲ್ಲ.<verse eid="2CH 28:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="2CH 28:22"/>ಇದಲ್ಲದೆ ಈ ಅರಸನಾದ ಆಹಾಜನು ತನ್ನ ಇಕ್ಕಟ್ಟಿನ ಕಾಲದಲ್ಲಿ ಇನ್ನೂ ಅಧಿಕವಾಗಿ ಯೆಹೋವ ದೇವರಿಗೆ ಅಪನಂಬಿಗಸ್ತನಾದನು. <verse eid="2CH 28:22"/><verse number="23" style="v" sid="2CH 28:23"/>ಕೊನೆಗೆ ಆಹಾಜನು, “ಅರಾಮಿನ ಅರಸರ ದೇವರುಗಳು ಅವರಿಗೆ ಸಹಾಯ ಕೊಟ್ಟದ್ದರಿಂದ, ಅವು ನನಗೆ ಸಹ ಸಹಾಯ ಕೊಡುವ ಹಾಗೆ ನಾನು ಅವುಗಳಿಗೆ ಬಲಿಯನ್ನು ಅರ್ಪಿಸುತ್ತೇನೆ,” ಎಂದುಕೊಂಡು ತನ್ನನ್ನು ಸೋಲಿಸಿದ ದಮಸ್ಕದವರ ದೇವರುಗಳಿಗೆ ಬಲಿಗಳನ್ನು ಅರ್ಪಿಸಿದನು. ಆದರೆ ಆ ದೇವರುಗಳು ಅವನನ್ನೂ, ಸಮಸ್ತ ಇಸ್ರಾಯೇಲರನ್ನೂ ಬೀಳುವಂತೆ ಮಾಡಿದವು.<verse eid="2CH 28:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="2CH 28:24"/>ಇದಲ್ಲದೆ ಆಹಾಜನು ದೇವರ ಮನೆಯ ಸಲಕರಣೆಗಳನ್ನು ಕೂಡಿಸಿ, ದೇವರ ಆಲಯದ ಸಾಮಗ್ರಿಗಳನ್ನು ಚೂರುಚೂರು ಮಾಡಿ ಕತ್ತರಿಸಿ, ಯೆಹೋವ ದೇವರ ಮನೆಯ ಬಾಗಿಲುಗಳನ್ನು ಮುಚ್ಚಿಬಿಟ್ಟು, ಯೆರೂಸಲೇಮಿನ ಸಮಸ್ತ ಮೂಲೆಗಳಲ್ಲಿ ಬಲಿಪೀಠಗಳನ್ನು ಕಟ್ಟಿಸಿದನು. <verse eid="2CH 28:24"/><verse number="25" style="v" sid="2CH 28:25"/>ಯೆಹೂದದ ಸಮಸ್ತ ಪಟ್ಟಣಗಳಲ್ಲಿ ಅನ್ಯ ದೇವರುಗಳಿಗೆ ಧೂಪ ಸುಡುವುದಕ್ಕೆ ಎತ್ತರ ಸ್ಥಳಗಳನ್ನು ಕಟ್ಟಿಸಿ, ತನ್ನ ಪಿತೃಗಳ ದೇವರಾದ ಯೆಹೋವ ದೇವರಿಗೆ ಕೋಪವನ್ನೆಬ್ಬಿಸಿದನು.<verse eid="2CH 28:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="2CH 28:26"/>ಅವನ ಆಳ್ವಿಕೆಯಲ್ಲಿಯ ಇತರ ಕ್ರಿಯೆಗಳೂ, ಅವನ ಸಕಲ ಮಾರ್ಗಗಳೂ, ಮೊದಲನೆಯವುಗಳೂ, ಕಡೆಯವುಗಳೂ ಯೆಹೂದದ ಮತ್ತು ಇಸ್ರಾಯೇಲರ ಅರಸರ ಇತಿಹಾಸಗಳ ಪುಸ್ತಕದಲ್ಲಿ ಬರೆದಿರುತ್ತವೆ. <verse eid="2CH 28:26"/><verse number="27" style="v" sid="2CH 28:27"/>ಆಹಾಜನು ಮೃತನಾಗಿ ತನ್ನ ಪಿತೃಗಳ ಬಳಿಯಲ್ಲಿ ಸೇರಿದನು. ಆದರೆ ಅವನನ್ನು ಇಸ್ರಾಯೇಲಿನ ಅರಸರ ಸಮಾಧಿಯ ಸ್ಥಳದಲ್ಲಿ ಹೂಣಿಡದೆ ಯೆರೂಸಲೇಮ್ ಪಟ್ಟಣದಲ್ಲಿ ಸಮಾಧಿಮಾಡಿದರು. ಅವನಿಗೆ ಬದಲಾಗಿ ಅವನ ಮಗ ಹಿಜ್ಕೀಯನು ಅರಸನಾದನು.<verse eid="2CH 28:27"/></para>
  <chapter eid="2CH 28"/>
  <chapter number="29" style="c" sid="2CH 29"/>
  <para style="s1">ಹಿಜ್ಕೀಯನು ದೇವಾಲಯವನ್ನು ಪವಿತ್ರಪಡಿಸಿದ್ದು</para>
  <para style="p">
    <verse number="1" style="v" sid="2CH 29:1"/>ಹಿಜ್ಕೀಯನು ಅರಸನಾದಾಗ ಇಪ್ಪತ್ತೈದು ವರ್ಷದವನಾಗಿದ್ದು, ಯೆರೂಸಲೇಮಿನಲ್ಲಿ ಇಪ್ಪತ್ತೊಂಬತ್ತು ವರ್ಷ ಆಳಿದನು. ಅವನ ತಾಯಿಯ ಹೆಸರು ಅಬೀಯಾ. ಅವಳು ಜೆಕರ್ಯನ ಮಗಳಾಗಿದ್ದಳು. <verse eid="2CH 29:1"/><verse number="2" style="v" sid="2CH 29:2"/>ಅವನು ತನ್ನ ತಂದೆ ದಾವೀದನು ಮಾಡಿದ ಪ್ರಕಾರ ಯೆಹೋವ ದೇವರ ದೃಷ್ಟಿಯಲ್ಲಿ ಒಳ್ಳೆಯದನ್ನು ಮಾಡಿದನು.<verse eid="2CH 29:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="2CH 29:3"/>ಹಿಜ್ಕೀಯನು ತನ್ನ ಆಳ್ವಿಕೆಯ ಮೊದಲನೆಯ ವರ್ಷದ ಮೊದಲನೆಯ ತಿಂಗಳಲ್ಲಿ ಯೆಹೋವ ದೇವರ ಆಲಯದ ಬಾಗಿಲುಗಳನ್ನು ತೆರೆದು, ಅವುಗಳನ್ನು ಭದ್ರಪಡಿಸಿದನು. <verse eid="2CH 29:3"/><verse number="4" style="v" sid="2CH 29:4"/>ಇದಲ್ಲದೆ ಹಿಜ್ಕೀಯನು ಯಾಜಕರನ್ನೂ, ಲೇವಿಯರನ್ನೂ ಕರೆಕಳುಹಿಸಿ, ಅವರನ್ನು ಪೂರ್ವದಿಕ್ಕಿನ ಅಂಗಣದಲ್ಲಿ ಕೂಡಿಸಿಕೊಂಡು, ಅವರಿಗೆ ಹೇಳಿದ್ದೇನೆಂದರೆ, <verse eid="2CH 29:4"/><verse number="5" style="v" sid="2CH 29:5"/>“ಲೇವಿಯರೇ, ನನ್ನ ಮಾತನ್ನು ಕೇಳಿರಿ. ನೀವು ನಿಮ್ಮನ್ನು ಪ್ರತಿಷ್ಠೆ ಮಾಡಿಕೊಂಡು, ನಿಮ್ಮ ಪಿತೃಗಳ ದೇವರಾದ ಯೆಹೋವ ದೇವರ ಆಲಯವನ್ನು ಪ್ರತಿಷ್ಠೆಮಾಡಿ, ಅದರ ಮೈಲಿಗೆಯನ್ನು ಪರಿಶುದ್ಧ ಸ್ಥಾನದಿಂದ ತೆಗೆದುಹಾಕಿರಿ. <verse eid="2CH 29:5"/><verse number="6" style="v" sid="2CH 29:6"/>ಏಕೆಂದರೆ ನಮ್ಮ ಪಿತೃಗಳು ಅಪನಂಬಿಗಸ್ತರಾಗಿ, ನಮ್ಮ ದೇವರಾದ ಯೆಹೋವ ದೇವರ ದೃಷ್ಟಿಗೆ ಕೆಟ್ಟದ್ದನ್ನು ಮಾಡಿ, ಅವರನ್ನು ಬಿಟ್ಟುಬಿಟ್ಟರು. ಇದಲ್ಲದೆ ಅವರು ಯೆಹೋವ ದೇವರ ನಿವಾಸ ಸ್ಥಾನದ ಕಡೆಯಿಂದ ತಮ್ಮ ಮುಖಗಳನ್ನು ತಿರುಗಿಸಿ, ತಮ್ಮ ಬೆನ್ನುಗಳನ್ನು ತೋರಿಸಿದ್ದಾರೆ. <verse eid="2CH 29:6"/><verse number="7" style="v" sid="2CH 29:7"/>ಇದಲ್ಲದೆ ಅವರು ದ್ವಾರಾಂಗಳದ ಬಾಗಿಲುಗಳನ್ನು ಮುಚ್ಚಿ, ದೀಪಗಳನ್ನು ಆರಿಸಿ, ಇಸ್ರಾಯೇಲಿನ ದೇವರಿಗೆ ಪರಿಶುದ್ಧ ಸ್ಥಾನದಲ್ಲಿ ಧೂಪವನ್ನು ಸುಡದೆ, ದಹನಬಲಿಗಳನ್ನು ಅರ್ಪಿಸದೆ ಹೋದರು. <verse eid="2CH 29:7"/><verse number="8" style="v" sid="2CH 29:8"/>ಆದ್ದರಿಂದ ಯೆಹೂದ ಮತ್ತು ಯೆರೂಸಲೇಮಿನವರ ಮೇಲೆ ಯೆಹೋವ ದೇವರು ಕೋಪಗೊಂಡು, ಅವುಗಳನ್ನು ಭಯಭೀತಿಗೂ, ಅಪಹಾಸ್ಯಗಳಿಗೂ ಆಸ್ಪದ ಮಾಡಿದ್ದಾರೆ. ಇದಕ್ಕೆ ನೀವೇ ಸಾಕ್ಷಿಗಳು. <verse eid="2CH 29:8"/><verse number="9" style="v" sid="2CH 29:9"/>ಇದಕ್ಕೋಸ್ಕರ ನಮ್ಮ ಪಿತೃಗಳು ಖಡ್ಗದಿಂದ ಬಿದ್ದಿದ್ದಾರೆ. ನಮ್ಮ ಪುತ್ರ ಪುತ್ರಿಯರೂ, ನಮ್ಮ ಹೆಂಡತಿಯರೂ ಸೆರೆಯಲ್ಲಿದ್ದಾರೆ. <verse eid="2CH 29:9"/><verse number="10" style="v" sid="2CH 29:10"/>ಈಗ ಇಸ್ರಾಯೇಲಿನ ದೇವರಾದ ಯೆಹೋವ ದೇವರ ಉಗ್ರಕೋಪವು ನಮ್ಮನ್ನು ಬಿಟ್ಟುಹೋಗುವ ಹಾಗೆ, ನಾನು ಅವರ ಸಂಗಡ ಒಡಂಬಡಿಕೆಯನ್ನು ಮಾಡಲು ಮನಸ್ಸುಳ್ಳವನಾಗಿದ್ದೇನೆ. <verse eid="2CH 29:10"/><verse number="11" style="v" sid="2CH 29:11"/>ನನ್ನ ಮಕ್ಕಳೇ, ಉದಾಸೀನರಾಗಿರಬೇಡಿರಿ. ಏಕೆಂದರೆ ತಮ್ಮ ಸಮ್ಮುಖದಲ್ಲಿ ನಿಲ್ಲುವುದಕ್ಕೂ, ತಮ್ಮನ್ನು ಸೇವಿಸುವುದಕ್ಕೂ, ತಮಗೆ ಸೇವಕರಾಗಿರುವುದಕ್ಕೂ, ತಮಗೆ ಧೂಪವನ್ನು ಸುಡುವುದಕ್ಕೂ ಯೆಹೋವ ದೇವರು ನಿಮ್ಮನ್ನು ಆಯ್ದುಕೊಂಡಿದ್ದಾರೆ,” ಎಂದನು.<verse eid="2CH 29:11"/></para>
  <para style="b"/>
  <para style="li4">
    <verse number="12" style="v" sid="2CH 29:12"/>ಆಗ ಲೇವಿಯರು ಸೇವೆಗಾಗಿ ಮುಂದೆ ಬಂದರು:</para>
  <para style="b" vid="2CH 29:12"/>
  <para style="li1" vid="2CH 29:12">ಕೊಹಾತ್ಯರಲ್ಲಿ</para>
  <para style="li2" vid="2CH 29:12">ಅಮಾಸೈಯನ ಮಗ ಮಹತ್, ಅಜರ್ಯನ ಮಗ ಯೋಯೇಲ್,</para>
  <para style="li1" vid="2CH 29:12">ಮೆರಾರೀಯರಲ್ಲಿ</para>
  <para style="li2" vid="2CH 29:12">ಅಬ್ದೀಯನ ಮಗ ಕೀಷ್, ಯೆಹಲ್ಲೆಲೇಲನ ಮಗ ಅಜರ್ಯ,</para>
  <para style="li1" vid="2CH 29:12">ಗೇರ್ಷೋನ್ಯರಲ್ಲಿ</para>
  <para style="li2" vid="2CH 29:12">ಜಿಮ್ಮನ ಮಗ ಯೋವಾಹ, ಯೋವಾಹನ ಮಗ ಏದೆನ್,<verse eid="2CH 29:12"/></para>
  <para style="li1">
    <verse number="13" style="v" sid="2CH 29:13"/>ಎಲೀಚಾಫಾನ್ಯರಲ್ಲಿ</para>
  <para style="li2" vid="2CH 29:13">ಶಿಮ್ರೀ, ಯೆಹೀಯೇಲ್,</para>
  <para style="li1" vid="2CH 29:13">ಆಸಾಫ್ಯರಲ್ಲಿ</para>
  <para style="li2" vid="2CH 29:13">ಜೆಕರ್ಯ, ಮತ್ತನ್ಯ,<verse eid="2CH 29:13"/></para>
  <para style="li1">
    <verse number="14" style="v" sid="2CH 29:14"/>ಹೇಮಾನ್ಯರಲ್ಲಿ</para>
  <para style="li2" vid="2CH 29:14">ಯೆಹೀಯೇಲ್, ಶಿಮ್ಮಿ;</para>
  <para style="li1" vid="2CH 29:14">ಯೆದುತೂನ್ಯರಲ್ಲಿ</para>
  <para style="li2" vid="2CH 29:14">ಶೆಮಾಯ ಹಾಗೂ ಉಜ್ಜೀಯೇಲ್.<verse eid="2CH 29:14"/></para>
  <para style="b"/>
  <para style="p">
    <verse number="15" style="v" sid="2CH 29:15"/>ಇವರು ಅರಸನ ಆಜ್ಞಾಧಾರಕರಾಗಿ ಯೆಹೋವ ದೇವರ ವಾಕ್ಯವನ್ನು ಅನುಸರಿಸಿ, ತಮ್ಮ ಸಹೋದರರನ್ನು ಕೂಡಿಸಿ, ತಮ್ಮನ್ನು ಪ್ರತಿಷ್ಠೆ ಮಾಡಿಕೊಂಡು, ಯೆಹೋವ ದೇವರ ಆಲಯವನ್ನು ಶುಚಿಮಾಡಲು ಬಂದರು. <verse eid="2CH 29:15"/><verse number="16" style="v" sid="2CH 29:16"/>ಯಾಜಕರು ಯೆಹೋವ ದೇವರ ಆಲಯವನ್ನು ಶುದ್ಧಿಮಾಡಲು ಅದರ ಒಳಭಾಗವನ್ನು ಪ್ರವೇಶಿಸಿ, ಯೆಹೋವ ದೇವರ ಮಂದಿರದಲ್ಲಿ ಕಂಡ ಮೈಲಿಗೆಯನ್ನು ಯೆಹೋವ ದೇವರ ಆಲಯದ ಅಂಗಳದೊಳಗೆ ತಂದರು. ಆಗ ಲೇವಿಯರು ಅದನ್ನು ತೆಗೆದುಕೊಂಡು, ಕಿದ್ರೋನ್ ಹಳ್ಳದಲ್ಲಿ ಹಾಕಲು ಹೊರಗೆ ಒಯ್ದರು. <verse eid="2CH 29:16"/><verse number="17" style="v" sid="2CH 29:17"/>ಅವರು ಮೊದಲನೆಯ ತಿಂಗಳಿನ ಮೊದಲನೆಯ ದಿವಸದಲ್ಲಿ ಪ್ರತಿಷ್ಠೆ ಮಾಡಲು ಆರಂಭಿಸಿ, ಆ ತಿಂಗಳ ಎಂಟನೆಯ ದಿವಸದಲ್ಲಿ ಯೆಹೋವ ದೇವರ ದ್ವಾರಾಂಗಳದವರೆಗೂ ಬಂದರು. ಹೀಗೆಯೇ ಎಂಟು ದಿವಸಗಳಲ್ಲಿ ಯೆಹೋವ ದೇವರ ಆಲಯವನ್ನು ಪ್ರತಿಷ್ಠೆಮಾಡಿ, ಅದನ್ನು ಮೊದಲನೆಯ ತಿಂಗಳಿನ ಹದಿನಾರನೆಯ ದಿವಸದಲ್ಲಿ ಮುಗಿಸಿದರು.<verse eid="2CH 29:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="2CH 29:18"/>ಆಗ ಅವರು ಅರಸನಾದ ಹಿಜ್ಕೀಯನ ಬಳಿಗೆ ಬಂದು ಅವನಿಗೆ, “ಯೆಹೋವ ದೇವರ ಆಲಯವನ್ನೆಲ್ಲಾ, ದಹನಬಲಿಪೀಠವನ್ನೂ, ನೈವೇದ್ಯ ರೊಟ್ಟಿಗಳನ್ನಿಡತಕ್ಕ ಮೇಜನ್ನು, ಅದರ ಎಲ್ಲಾ ಪಾತ್ರೆಗಳನ್ನೂ ಶುದ್ಧಿಮಾಡಿದೆವು. <verse eid="2CH 29:18"/><verse number="19" style="v" sid="2CH 29:19"/>ಇದಲ್ಲದೆ ಅರಸನಾದ ಆಹಾಜನು ಆಳಿದಾಗ, ದೇವದ್ರೋಹಿಯಾಗಿ ಬಿಸಾಡಿದ ಎಲ್ಲಾ ಸಲಕರಣೆಗಳನ್ನು ಪುನಃ ತಂದು ಪ್ರತಿಷ್ಠೆ ಮಾಡಿದೆವು. ಅವು ಯೆಹೋವ ದೇವರ ಬಲಿಪೀಠದ ಮುಂದೆ ಇವೆ,” ಎಂದು ಹೇಳಿದರು.<verse eid="2CH 29:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="2CH 29:20"/>ಆಗ ಅರಸನಾದ ಹಿಜ್ಕೀಯನು ಉದಯದಲ್ಲಿ ಎದ್ದು, ಪಟ್ಟಣದ ಪ್ರಧಾನರನ್ನು ಕೂಡಿಸಿ, ಯೆಹೋವ ದೇವರ ಆಲಯಕ್ಕೆ ಹೋದನು. <verse eid="2CH 29:20"/><verse number="21" style="v" sid="2CH 29:21"/>ಅವರು ರಾಜ್ಯಕ್ಕೋಸ್ಕರವೂ, ಪರಿಶುದ್ಧ ಸ್ಥಾನಕ್ಕೋಸ್ಕರವೂ, ಯೆಹೂದಕ್ಕೋಸ್ಕರವೂ ದೋಷಪರಿಹಾರದ ಬಲಿಯಾಗಿ ಏಳು ಹೋರಿಗಳನ್ನೂ, ಏಳು ಟಗರುಗಳನ್ನೂ, ಏಳು ಕುರಿಮರಿಗಳನ್ನೂ, ಏಳು ಮೇಕೆಗಳನ್ನೂ ತಂದರು. ಆಗ ಅರಸನು ಯಾಜಕರಾದ ಆರೋನನ ಸಂತಾನದವರಿಗೆ ಯೆಹೋವ ದೇವರ ಬಲಿಪೀಠದ ಮೇಲೆ ಅವುಗಳನ್ನು ಅರ್ಪಿಸಲು ಹೇಳಿದನು. <verse eid="2CH 29:21"/><verse number="22" style="v" sid="2CH 29:22"/>ಹೋರಿಗಳನ್ನು ವಧಿಸಿದ ಮೇಲೆ ಯಾಜಕರು ಅವುಗಳ ರಕ್ತವನ್ನು ತೆಗೆದುಕೊಂಡು, ಪೀಠದ ಮೇಲೆ ಚಿಮುಕಿಸಿದರು. ಟಗರುಗಳನ್ನು ವಧಿಸಿ ರಕ್ತವನ್ನು ಚಿಮುಕಿಸಿದರು. ಕುರಿಮರಿಗಳನ್ನು ತೆಗೆದುಕೊಂಡು ಬಲಿಪೀಠದ ಮೇಲೆ ಅವುಗಳನ್ನು ವಧಿಸಿ, ರಕ್ತವನ್ನು ತೆಗೆದುಕೊಂಡು, ಬಲಿಪೀಠದ ಮೇಲೆ ಚಿಮುಕಿಸಿದರು. <verse eid="2CH 29:22"/><verse number="23" style="v" sid="2CH 29:23"/>ಅರಸನ ಮುಂದೆಯೂ, ಸಭೆಯ ಮುಂದೆಯೂ ದೋಷಪರಿಹಾರದ ಬಲಿಗಾಗಿ ತಂದ ಹೋತಗಳನ್ನು ಹತ್ತಿರ ತೆಗೆದುಕೊಂಡು ಬಂದು, ತಮ್ಮ ಕೈಗಳನ್ನು ಅವುಗಳ ಮೇಲೆ ಇಟ್ಟರು. <verse eid="2CH 29:23"/><verse number="24" style="v" sid="2CH 29:24"/>ಆಗ ಸಮಸ್ತ ಇಸ್ರಾಯೇಲರಿಗೋಸ್ಕರ ಪ್ರಾಯಶ್ಚಿತ್ತವಾಗಿ ಯಾಜಕರು ಅವುಗಳನ್ನು ವಧಿಸಿ, ಬಲಿಪೀಠದ ಮೇಲೆ ಅವುಗಳ ರಕ್ತದಿಂದ ಪಾಪ ನಿವಾರಣೆ ಮಾಡಿದರು. ದಹನಬಲಿಯೂ, ದೋಷಪರಿಹಾರದ ಬಲಿಯೂ ಸಮಸ್ತ ಇಸ್ರಾಯೇಲಿಗೋಸ್ಕರ ಆಗಬೇಕೆಂದು ಅರಸನು ಆಜ್ಞಾಪಿಸಿದನು.<verse eid="2CH 29:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="2CH 29:25"/>ಇದಲ್ಲದೆ ಅವನು ತಾಳಗಳನ್ನೂ, ವೀಣೆಗಳನ್ನೂ, ಕಿನ್ನರಿಗಳನ್ನೂ ಹಿಡಿದ ಲೇವಿಯರನ್ನು ದಾವೀದನೂ, ಅರಸನ ದರ್ಶಿಯಾದ ಗಾದನೂ, ಪ್ರವಾದಿಯಾದ ನಾತಾನನೂ ಇವರ ಆಜ್ಞೆಯ ಪ್ರಕಾರ, ಯೆಹೋವ ದೇವರ ಆಲಯದಲ್ಲಿ ನಿಲ್ಲಿಸಿದನು. ಏಕೆಂದರೆ ಯೆಹೋವ ದೇವರ ಆಜ್ಞೆಯು ಅವನ ಪ್ರವಾದಿಗಳ ಮುಖಾಂತರ ಹೀಗೆ ಇತ್ತು. <verse eid="2CH 29:25"/><verse number="26" style="v" sid="2CH 29:26"/>ಲೇವಿಯರು ದಾವೀದನ ವಾದ್ಯಗಳನ್ನೂ ಯಾಜಕರು ತುತೂರಿಗಳನ್ನೂ ಹಿಡಿದು ನಿಂತಿದ್ದರು.<verse eid="2CH 29:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="2CH 29:27"/>ಹಿಜ್ಕೀಯನು ಬಲಿಪೀಠದ ಮೇಲೆ ದಹನಬಲಿಯನ್ನು ಅರ್ಪಿಸಲು ಹೇಳಿದನು. ದಹನಬಲಿಯನ್ನು ಅರ್ಪಿಸಲು ಆರಂಭಿಸಿದಾಗ ತುತೂರಿಗಳಿಂದಲೂ, ಇಸ್ರಾಯೇಲಿನ ಅರಸನಾದ ದಾವೀದನ ವಾದ್ಯಗಳಿಂದಲೂ ಯೆಹೋವ ದೇವರ ಹಾಡು ಆರಂಭವಾಯಿತು. <verse eid="2CH 29:27"/><verse number="28" style="v" sid="2CH 29:28"/>ಆಗ ಸಭೆಯವರೆಲ್ಲರೂ ಆರಾಧಿಸಿದರು. ದಹನಬಲಿ ಅರ್ಪಿಸಿ ತೀರಿಸುವ ತನಕ ಹಾಡುಗಾರರು ಹಾಡಿದರು. ತುತೂರಿ ಊದುವವರು ಊದಿದರು.<verse eid="2CH 29:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="2CH 29:29"/>ಅವರು ಅರ್ಪಿಸುವುದು ತೀರಿಸಿದಾಗ ಅರಸನೂ, ಅವನ ಸಂಗಡ ಇದ್ದವರೆಲ್ಲರೂ ಮೊಣಕಾಲೂರಿ ಆರಾಧಿಸಿದರು. <verse eid="2CH 29:29"/><verse number="30" style="v" sid="2CH 29:30"/>ಇದಲ್ಲದೆ ಅರಸನಾದ ಹಿಜ್ಕೀಯನೂ, ಪ್ರಧಾನರೂ ದಾವೀದನ ಮಾತುಗಳಿಂದಲೂ, ಆಸಾಫನ ಕೀರ್ತನೆಗಳಿಂದಲೂ ಯೆಹೋವ ದೇವರನ್ನು ಸ್ತುತಿಸಬೇಕೆಂದು ಲೇವಿಯರಿಗೆ ಹೇಳಿದರು. ಆಗ ಅವರು ಸಂತೋಷವಾಗಿ ಸ್ತುತಿಸಿ ಮೊಣಕಾಲೂರಿಕೊಂಡು ಆರಾಧಿಸಿದರು.<verse eid="2CH 29:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="2CH 29:31"/>ಹಿಜ್ಕೀಯನು ಅವರಿಗೆ ಉತ್ತರಕೊಟ್ಟು, “ಈಗ ನೀವು ನಿಮ್ಮನ್ನು ಯೆಹೋವ ದೇವರಿಗೆ ಪ್ರತಿಷ್ಠೆ ಮಾಡಿದ್ದರಿಂದ, ಸಮೀಪಕ್ಕೆ ಬಂದು ಬಲಿಗಳನ್ನೂ, ಸ್ತೋತ್ರ ಅರ್ಪಣೆಗಳನ್ನೂ ಯೆಹೋವ ದೇವರ ಆಲಯಕ್ಕೆ ತೆಗೆದುಕೊಂಡು ಬನ್ನಿರಿ,” ಎಂದನು. ಆಗ ಸಭೆಯವರು ಬಲಿಗಳನ್ನೂ, ಸ್ತೋತ್ರದ ಅರ್ಪಣೆಗಳನ್ನೂ ಮತ್ತು ಇಷ್ಟಪೂರ್ವಕ ಮನಸ್ಸುಳ್ಳವರು ದಹನಬಲಿಗಳನ್ನೂ ತಂದರು.<verse eid="2CH 29:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="2CH 29:32"/>ಸಭೆಯು ತಂದ ದಹನಬಲಿಗಳ ಲೆಕ್ಕವೇನೆಂದರೆ: ಎಪ್ಪತ್ತು ಹೋರಿಗಳು, ನೂರು ಟಗರುಗಳು, ಇನ್ನೂರು ಕುರಿಮರಿಗಳು. ಇವೆಲ್ಲಾ ಯೆಹೋವ ದೇವರಿಗೆ ಅರ್ಪಿಸಿದ ದಹನಬಲಿಗಳಾಗಿದ್ದವು. <verse eid="2CH 29:32"/><verse number="33" style="v" sid="2CH 29:33"/>ಪ್ರತಿಷ್ಠೆ ಮಾಡಲಾದವುಗಳು ಆರುನೂರು ಹೋರಿಗಳೂ ಮೂರು ಸಾವಿರ ಕುರಿಗಳೂ ಮೇಕೆಗಳೂ ಇದ್ದವು. <verse eid="2CH 29:33"/><verse number="34" style="v" sid="2CH 29:34"/>ಆದರೆ ಯಾಜಕರು ಸ್ವಲ್ಪ ಜನರಾಗಿದ್ದು, ದಹನಬಲಿಗಳನ್ನೆಲ್ಲಾ ಸುಲಿಯಲಾರದೆ ಇದ್ದುದರಿಂದ, ಕೆಲಸವು ತೀರುವವರೆಗೂ, ಮಿಕ್ಕ ಯಾಜಕರು ತಮ್ಮನ್ನು ಪರಿಶುದ್ಧಮಾಡಿಕೊಳ್ಳುವವರೆಗೂ ಲೇವಿಯರಾದ ಅವರ ಸಹೋದರರು ಅವರಿಗೆ ಸಹಾಯ ಮಾಡುತ್ತಿದ್ದರು. ಏಕೆಂದರೆ ಯಾಜಕರಿಗಿಂತ ತಮ್ಮನ್ನು ಪರಿಶುದ್ಧ ಮಾಡಿಕೊಳ್ಳುವುದರಲ್ಲಿ ಲೇವಿಯರು ಯಥಾರ್ಥ ಹೃದಯವುಳ್ಳವರಾಗಿದ್ದರು. <verse eid="2CH 29:34"/><verse number="35" style="v" sid="2CH 29:35"/>ಇದಲ್ಲದೆ ದಹನಬಲಿಗಳೂ, ಸಮಾಧಾನದ ಬಲಿಗಳ ಕೊಬ್ಬೂ, ದಹನಬಲಿಗೆ ಬೇಕಾದ ಪಾನದ ಅರ್ಪಣೆಗಳೂ ಬಹಳವಾಗಿದ್ದವು.</para>
  <para style="p" vid="2CH 29:35">ಹೀಗೆ ಯೆಹೋವ ದೇವರ ಆಲಯದ ಸೇವೆಯು ಸಿದ್ಧವಾಯಿತು. <verse eid="2CH 29:35"/><verse number="36" style="v" sid="2CH 29:36"/>ಆಗ ದೇವರು ತಮ್ಮ ಜನರನ್ನು ಸಿದ್ಧಮಾಡಿದ್ದರಿಂದ ಹಿಜ್ಕೀಯನೂ, ಜನರೆಲ್ಲರೂ ಸಂತೋಷಪಟ್ಟರು. ಏಕೆಂದರೆ ಈ ಕಾರ್ಯವು ತ್ವರೆಯಾಗಿ ನಡೆಯಿತು.<verse eid="2CH 29:36"/></para>
  <chapter eid="2CH 29"/>
  <chapter number="30" style="c" sid="2CH 30"/>
  <para style="s1">ಹಿಜ್ಕೀಯನು ಪಸ್ಕಹಬ್ಬವನ್ನು ಆಚರಿಸಿದ್ದು</para>
  <para style="p">
    <verse number="1" style="v" sid="2CH 30:1"/>ಆಗ ಅವರು ಇಸ್ರಾಯೇಲಿನ ದೇವರಾದ ಯೆಹೋವ ದೇವರ ಪಸ್ಕವನ್ನು ಆಚರಿಸಲು ಯೆರೂಸಲೇಮಿನಲ್ಲಿ ಯೆಹೋವ ದೇವರ ಆಲಯಕ್ಕೆ ಬರುವಂತೆ ಹಿಜ್ಕೀಯನು ಸಮಸ್ತ ಇಸ್ರಾಯೇಲಿಗೂ ಯೆಹೂದಕ್ಕೂ ಹೇಳಿ ಕಳುಹಿಸಿ ಎಫ್ರಾಯೀಮ್ಯರಿಗೂ ಮನಸ್ಸೆಯವರಿಗೂ ಪತ್ರಗಳನ್ನು ಬರೆದನು. <verse eid="2CH 30:1"/><verse number="2" style="v" sid="2CH 30:2"/>ಯೆರೂಸಲೇಮಿನಲ್ಲಿರುವ ಅರಸನೂ ಅವನ ಪ್ರಧಾನರೂ ಸಮಸ್ತ ಸಭೆಯೂ ಎರಡನೆಯ ತಿಂಗಳಲ್ಲಿ ಪಸ್ಕವನ್ನು ಆಚರಿಸಲು ತೀರ್ಮಾನಿಸಿಕೊಂಡರು. <verse eid="2CH 30:2"/><verse number="3" style="v" sid="2CH 30:3"/>ಯಾಜಕರು ತಮ್ಮನ್ನು ತಕ್ಕ ಹಾಗೆ ಪ್ರತಿಷ್ಠೆ ಮಾಡಿಕೊಂಡಿರಲಿಲ್ಲ. ಜನರು ಯೆರೂಸಲೇಮಿನಲ್ಲಿ ಇನ್ನೂ ಕೂಡಿರಲಿಲ್ಲವಾದುದರಿಂದ ಆ ಕಾಲದಲ್ಲಿ ಪಸ್ಕಹಬ್ಬವನ್ನು ಆಚರಿಸಲಾರದೆ ಇದ್ದರು. <verse eid="2CH 30:3"/><verse number="4" style="v" sid="2CH 30:4"/>ಈ ಕಾರ್ಯವು ಅರಸನಿಗೂ ಸಮಸ್ತ ಜನರಿಗೂ ಸ್ಪಷ್ಟವಾಯಿತು. <verse eid="2CH 30:4"/><verse number="5" style="v" sid="2CH 30:5"/>ಆದ್ದರಿಂದ ಅವರು ಯೆರೂಸಲೇಮಿನಲ್ಲಿ ಇಸ್ರಾಯೇಲಿನ ದೇವರಾದ ಯೆಹೋವ ದೇವರಿಗೆ ಪಸ್ಕವನ್ನು ಆಚರಿಸಲು ಬರಬೇಕೆಂದು ಬೇರ್ಷೆಬ ಮೊದಲುಗೊಂಡು ದಾನಿನವರೆಗೂ ಸಮಸ್ತ ಇಸ್ರಾಯೇಲಿನಲ್ಲಿ ಕೂಗಿ ಸಾರಲು ನಿರ್ಣಯಿಸಿದರು. ಯೆಹೋವ ದೇವರ ನಿಯಮದ ಪ್ರಕಾರ ಅವರು ಬಹುಕಾಲದಿಂದ ಪಸ್ಕವನ್ನು ಆಚರಿಸಿರಲಿಲ್ಲ.<verse eid="2CH 30:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="2CH 30:6"/>ಅದೇ ಪ್ರಕಾರ ಓಟಗಾರರು ಅರಸನ ಕೈಯಿಂದಲೂ ಅವನ ಪ್ರಧಾನರ ಕೈಯಿಂದಲೂ ಪತ್ರಗಳನ್ನು ತೆಗೆದುಕೊಂಡು, ಅರಸನ ಅಪ್ಪಣೆಯ ಪ್ರಕಾರ ಸಮಸ್ತ ಇಸ್ರಾಯೇಲ್ ಮತ್ತು ಯೆಹೂದ ದೇಶಗಳಿಗೆ ಹೋಗಿ,</para>
  <para style="pm" vid="2CH 30:6">“ಇಸ್ರಾಯೇಲರೇ, ಅಬ್ರಹಾಮನ, ಇಸಾಕನ, ಇಸ್ರಾಯೇಲಿನ ದೇವರಾದ ಯೆಹೋವ ದೇವರ ಕಡೆಗೆ ತಿರುಗಿರಿ. ಆಗ ಅವರು ಅಸ್ಸೀರಿಯದ ಅರಸರ ಕೈಗೆ ತಪ್ಪಿಸಿಕೊಂಡ ನಿಮ್ಮ ಉಳಿದವರ ಕಡೆಗೆ ತಿರುಗುವರು. <verse eid="2CH 30:6"/><verse number="7" style="v" sid="2CH 30:7"/>ನಿಮ್ಮ ತಂದೆಗಳೂ ಸಹೋದರರೂ ನಡೆದಂತೆ ನೀವೂ ನಡೆಯಬೇಡಿರಿ. ಅವರು ತಮ್ಮ ಪಿತೃಗಳ ದೇವರಾದ ಯೆಹೋವ ದೇವರಿಗೆ ವಿರೋಧವಾಗಿ ದ್ರೋಹಿಗಳಾದದರಿಂದ ಆತನು ಅವರನ್ನು ನಾಶನಕ್ಕೆ ಒಪ್ಪಿಸಿದನು. ಅದಕ್ಕೆ ನೀವೇ ಸಾಕ್ಷಿಗಳು. <verse eid="2CH 30:7"/><verse number="8" style="v" sid="2CH 30:8"/>ಆದ್ದರಿಂದ ನಿಮ್ಮ ಪಿತೃಗಳ ಹಾಗೆ ನಿಮ್ಮನ್ನು ಕಠಿಣಪಡಿಸಿಕೊಳ್ಳಬೇಡಿರಿ. ಯೆಹೋವ ದೇವರಿಗೆ ಅಧೀನರಾಗಿ ಅವರು ಯುಗಯುಗಕ್ಕೂ ಪ್ರತಿಷ್ಠೆ ಮಾಡಿದ ಪರಿಶುದ್ಧ ಸ್ಥಾನದಲ್ಲಿ ಪ್ರವೇಶಿಸಿದ ನಿಮ್ಮ ದೇವರಾದ ಯೆಹೋವ ದೇವರನ್ನು ಸೇವಿಸಿರಿ. ಆಗ ದೇವರು ತಮ್ಮ ಕೋಪವನ್ನು ಬಿಟ್ಟು ನಿಮ್ಮ ಕಡೆಗೆ ತಿರುಗುವರು. <verse eid="2CH 30:8"/><verse number="9" style="v" sid="2CH 30:9"/>ನೀವು ಯೆಹೋವ ದೇವರ ಕಡೆಗೆ ತಿರುಗಿ ಈ ದೇಶಕ್ಕೆ ಬರುವಂತೆ ತಮ್ಮನ್ನು ಸೆರೆಯಾಗಿ ಒಯ್ದವರ ಸಮ್ಮುಖದಲ್ಲಿ ಅನುಕಂಪವನ್ನು ಹೊಂದುವರು. ಏಕೆಂದರೆ ನಿಮ್ಮ ದೇವರಾದ ಯೆಹೋವ ದೇವರು ಕೃಪೆಯೂ ಅನುಕಂಪವೂ ಉಳ್ಳವರಾಗಿದ್ದಾರೆ. ನೀವು ಅವರ ಕಡೆಗೆ ತಿರುಗಿದರೆ, ಅವರು ನಿಮ್ಮ ಕಡೆಯಿಂದ ತಮ್ಮ ಮುಖವನ್ನು ತಿರುಗಿಸುವುದಿಲ್ಲ,” ಎಂದು ಹೇಳಿದರು.<verse eid="2CH 30:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="2CH 30:10"/>ಹೀಗೆಯೇ ಓಟಗಾರರು ಎಫ್ರಾಯೀಮನ, ಮನಸ್ಸೆಯ ದೇಶದಲ್ಲಿ ಜೆಬುಲೂನ್ ಪರ್ಯಂತರ ಸಂಚರಿಸಿ, ಪಟ್ಟಣ ಪಟ್ಟಣವನ್ನು ಹಾದುಹೋದರು. ಆದರೆ ಜನರು ಇವರನ್ನು ನೋಡಿ ನಕ್ಕು ಗೇಲಿ ಮಾಡಿದರು. <verse eid="2CH 30:10"/><verse number="11" style="v" sid="2CH 30:11"/>ಆದರೂ ಆಶೇರ್, ಮನಸ್ಸೆ, ಜೆಬುಲೂನ್, ಇವರಲ್ಲಿ ಕೆಲವರು ತಮ್ಮನ್ನು ತಗ್ಗಿಸಿಕೊಂಡು ಯೆರೂಸಲೇಮಿಗೆ ಬಂದರು. <verse eid="2CH 30:11"/><verse number="12" style="v" sid="2CH 30:12"/>ಇದಲ್ಲದೆ ಯೆಹೋವ ದೇವರ ವಾಕ್ಯದಿಂದ ಉಂಟಾದ ಅರಸನ ಪ್ರಧಾನರ ಆಜ್ಞೆಯನ್ನು ಕೈಗೊಳ್ಳಲು ಅವರಿಗೆ ಒಂದೇ ಹೃದಯವನ್ನು ಕೊಡಲು ದೇವರ ಕೈ ಯೆಹೂದದವರ ಮೇಲೆ ಇತ್ತು.<verse eid="2CH 30:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="2CH 30:13"/>ಎರಡನೆಯ ತಿಂಗಳಲ್ಲಿ ಹುಳಿಯಿಲ್ಲದ ರೊಟ್ಟಿಗಳ ಹಬ್ಬವನ್ನು ಆಚರಿಸುವುದಕ್ಕೆ ಯೆರೂಸಲೇಮಿನಲ್ಲಿ ಬಹಳ ಜನರು ಕೂಡಿಕೊಂಡು ಮಹಾ ದೊಡ್ಡ ಸಮೂಹವಾಯಿತು. <verse eid="2CH 30:13"/><verse number="14" style="v" sid="2CH 30:14"/>ಆಗ ಅವರು ಎದ್ದು ಯೆರೂಸಲೇಮಿನಲ್ಲಿದ್ದ ಬಲಿಪೀಠಗಳನ್ನು ಮತ್ತು ಧೂಪಪೀಠಗಳನ್ನು ತೆಗೆದುಹಾಕಿದರು. ಆ ಧೂಪಪೀಠಗಳನ್ನೆಲ್ಲಾ ತೆಗೆದುಕೊಂಡುಹೋಗಿ ಕಿದ್ರೋನ್ ಹಳ್ಳದಲ್ಲಿ ಹಾಕಿದರು.<verse eid="2CH 30:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="2CH 30:15"/>ಎರಡನೆಯ ತಿಂಗಳ ಹದಿನಾಲ್ಕನೆಯ ದಿವಸದಲ್ಲಿ ಪಸ್ಕದ ಕುರಿಮರಿಯನ್ನು ವಧಿಸಿದರು. ಯಾಜಕರೂ, ಲೇವಿಯರೂ ನಾಚಿಕೆಪಟ್ಟು ತಮ್ಮನ್ನು ಪ್ರತಿಷ್ಠೆ ಮಾಡಿಕೊಂಡು, ಯೆಹೋವ ದೇವರ ಆಲಯದೊಳಗೆ ದಹನಬಲಿಗಳನ್ನು ತಂದರು. <verse eid="2CH 30:15"/><verse number="16" style="v" sid="2CH 30:16"/>ಇದಲ್ಲದೆ ಅವರು ದೇವರ ಮನುಷ್ಯನಾದ ಮೋಶೆಯ ನಿಯಮದ ಹಾಗೆ ತಮ್ಮ ಪದ್ಧತಿಯ ಪ್ರಕಾರ ತಮ್ಮ ತಮ್ಮ ಸ್ಥಳದಲ್ಲಿ ನಿಂತು, ಯಾಜಕರು, ಲೇವಿಯರ ಕೈಯಿಂದ ರಕ್ತವನ್ನು ತೆಗೆದುಕೊಂಡು ಚಿಮುಕಿಸಿದರು. <verse eid="2CH 30:16"/><verse number="17" style="v" sid="2CH 30:17"/>ಜನರಲ್ಲಿ ಅನೇಕರು ಅಪರಿಶುದ್ಧರಾಗಿದ್ದರು. ಆದ್ದರಿಂದ ಲೇವಿಯರು ಅಶುದ್ಧರಾದ ಎಲ್ಲರ ನಿಮಿತ್ತ ಅವರನ್ನು ಯೆಹೋವ ದೇವರಿಗೆ ಪ್ರತಿಷ್ಠೆ ಮಾಡುವ ಹಾಗೆ ಪಸ್ಕದ ಬಲಿಗಳನ್ನು ವಧಿಸುವುದಕ್ಕೆ ಇದ್ದರು. <verse eid="2CH 30:17"/><verse number="18" style="v" sid="2CH 30:18"/>ಎಫ್ರಾಯೀಮ್, ಮನಸ್ಸೆ, ಇಸ್ಸಾಕಾರ್, ಜೆಬುಲೂನ್ ಇವರಲ್ಲಿ ಅನೇಕರು ತಮ್ಮನ್ನು ಶುದ್ಧಮಾಡಿಕೊಳ್ಳದೆ ಮೋಶೆಯ ನಿಯಮಕ್ಕೆ ವಿರುದ್ಧ ರೀತಿಯಿಂದ ಪಸ್ಕದ ಭೋಜನವನ್ನು ಮಾಡಿದರು. ಆದರೆ ಹಿಜ್ಕೀಯನು ಅವರಿಗೋಸ್ಕರ ಪ್ರಾರ್ಥಿಸಿ, “ಯಾವನಾದರೂ ಪರಿಶುದ್ಧ ಸ್ಥಾನದ ಶುದ್ಧಿಯ ಪ್ರಕಾರ ಶುಚಿಯಾಗದೆ ಇದ್ದರೂ, <verse eid="2CH 30:18"/><verse number="19" style="v" sid="2CH 30:19"/>ಯೆಹೋವ ದೇವರೇ, ತಮ್ಮ ಪಿತೃಗಳ ದೇವರಾದ ನಿಮ್ಮನ್ನು ಹುಡುಕಬೇಕೆಂದು ಮನಸ್ಸು ಮಾಡುವವರಿಗೆಲ್ಲ ಕ್ಷಮೆಯನ್ನು ಅನುಗ್ರಹಿಸಿರಿ,” ಎಂದು ವಿಜ್ಞಾಪನೆ ಮಾಡಿದನು. <verse eid="2CH 30:19"/><verse number="20" style="v" sid="2CH 30:20"/>ಯೆಹೋವ ದೇವರು ಹಿಜ್ಕೀಯನ ಮಾತನ್ನು ಕೇಳಿ, ಜನರನ್ನು ಸ್ವಸ್ಥಮಾಡಿದರು.<verse eid="2CH 30:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="2CH 30:21"/>ಆದ್ದರಿಂದ ಯೆರೂಸಲೇಮಿನಲ್ಲಿದ್ದ ಇಸ್ರಾಯೇಲರು ಹುಳಿಯಿಲ್ಲದ ರೊಟ್ಟಿಗಳ ಹಬ್ಬವನ್ನು ಏಳು ದಿವಸ ಸಂತೋಷದಿಂದ ಆಚರಿಸಿದರು. ಲೇವಿಯರೂ ಯಾಜಕರೂ ಯೆಹೋವ ದೇವರಿಗೆ ಸಮರ್ಪಿತವಾದ ಮಹಾ ಶಬ್ದದ ವಾದ್ಯಗಳಿಂದ ಯೆಹೋವ ದೇವರಿಗೆ ಹಾಡಿ ಪ್ರತಿದಿನವೂ ಯೆಹೋವ ದೇವರನ್ನು ಸ್ತುತಿಸಿದರು.<verse eid="2CH 30:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="2CH 30:22"/>ಹಿಜ್ಕೀಯನು ಯೆಹೋವ ದೇವರ ಕಾರ್ಯಗಳಲ್ಲಿ ಒಳ್ಳೆಯ ತಿಳುವಳಿಕೆಯನ್ನು ಹೊಂದಿದ್ದ ಸಮಸ್ತ ಲೇವಿಯರೊಡನೆ ಉತ್ತೇಜನದ ಮಾತುಗಳಿಂದ ಮಾತನಾಡಿದನು. ಅವರು ಹಬ್ಬವನ್ನು ಏಳು ದಿನಗಳವರೆಗೂ ಸಮಾಧಾನದ ಬಲಿಗಳನ್ನು ಅರ್ಪಿಸುತ್ತಾ, ತಮ್ಮ ಪಿತೃಗಳ ದೇವರಾದ ಯೆಹೋವ ದೇವರನ್ನು ಸ್ತುತಿಸುತ್ತಾ, ಔತಣಮಾಡಿ ಆಚರಿಸಿದರು.<verse eid="2CH 30:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="2CH 30:23"/>ಅಲ್ಲದೆ ಕೂಟವೆಲ್ಲಾ ಇನ್ನೂ ಏಳು ದಿವಸಗಳ ಕಾಲ ಹಬ್ಬವನ್ನು ಆಚರಿಸಬೇಕೆಂದು ತಿರ್ಮಾನಿಸಿ ಇನ್ನೂ ಏಳು ದಿನಗಳ ಕಾಲ ಬಹಳ ಸಂತೋಷದಿಂದ ಹಬ್ಬವನ್ನು ಆಚರಿಸಿದರು. <verse eid="2CH 30:23"/><verse number="24" style="v" sid="2CH 30:24"/>ಯೆಹೂದದ ಅರಸನಾದ ಹಿಜ್ಕೀಯನು ಸಭೆಗೆ 1,000 ಹೋರಿಗಳನ್ನೂ 7,000 ಕುರಿಗಳನ್ನೂ ಕೊಟ್ಟನು. ಇದಲ್ಲದೆ ಪ್ರಧಾನರು ಕೂಟಕ್ಕೆ 1,000 ಹೋರಿಗಳನ್ನೂ 10,000 ಕುರಿಗಳನ್ನೂ ಕೊಟ್ಟರು. ಯಾಜಕರಲ್ಲಿ ಅನೇಕರು ತಮ್ಮನ್ನು ಪ್ರತಿಷ್ಠೆ ಮಾಡಿಕೊಂಡರು. <verse eid="2CH 30:24"/><verse number="25" style="v" sid="2CH 30:25"/>ಯೆಹೂದದ ಸಮೂಹದವರೆಲ್ಲರೂ ಯಾಜಕರೂ, ಲೇವಿಯರೂ, ಇಸ್ರಾಯೇಲಿನಿಂದ ಬಂದ ಸಮಸ್ತ ಜನರೂ, ಇಸ್ರಾಯೇಲಿನ ದೇಶದಿಂದ ಬಂದ ಪರದೇಶಿಗಳೂ, ಯೆಹೂದದಲ್ಲಿ ವಾಸವಾಗಿರುವವರೂ ಸಂತೋಷಪಟ್ಟರು. <verse eid="2CH 30:25"/><verse number="26" style="v" sid="2CH 30:26"/>ಹೀಗೆಯೇ ಯೆರೂಸಲೇಮಿನಲ್ಲಿ ಮಹಾ ಸಂತೋಷ ಉಂಟಾಗಿತ್ತು. ಇಸ್ರಾಯೇಲಿನ ಅರಸನಾದ ದಾವೀದನ ಮಗ ಸೊಲೊಮೋನನ ಕಾಲದಿಂದ ಯೆರೂಸಲೇಮಿನಲ್ಲಿ ಅಂಥಾ ಆಚರಣೆಯು ನಡೆದಿರಲಿಲ್ಲ. <verse eid="2CH 30:26"/><verse number="27" style="v" sid="2CH 30:27"/>ಆಗ ಯಾಜಕರೂ ಲೇವಿಯರೂ ಎದ್ದು ಜನರನ್ನು ಆಶೀರ್ವದಿಸಿದರು. ದೇವರು ಅವರ ಪ್ರಾರ್ಥನೆಯನ್ನು ಕೇಳಿದರು. ಅವರ ಪ್ರಾರ್ಥನೆಯು ದೇವರ ಪರಿಶುದ್ಧ ನಿವಾಸ ಸ್ಥಾನವಾದ ಪರಲೋಕಕ್ಕೆ ತಲುಪಿತು.<verse eid="2CH 30:27"/></para>
  <chapter eid="2CH 30"/>
  <chapter number="31" style="c" sid="2CH 31"/>
  <para style="p">
    <verse number="1" style="v" sid="2CH 31:1"/>ಇದಾದನಂತರ ಅಲ್ಲಿ ಇರುವವರಾದ ಸಮಸ್ತ ಇಸ್ರಾಯೇಲರು ಯೆಹೂದ ಪಟ್ಟಣಗಳಿಗೆ ಹೊರಟುಹೋಗಿ, ವಿಗ್ರಹಗಳನ್ನು ಮುರಿದು, ಅಶೇರ ಸ್ತಂಭಗಳನ್ನು ಕಡಿದು, ಸಮಸ್ತ ಯೆಹೂದ, ಬೆನ್ಯಾಮೀನ್, ಎಫ್ರಾಯೀಮ್, ಮನಸ್ಸೆ ದೇಶಗಳಲ್ಲಿ ಯಾವುದನ್ನೂ ಉಳಿಸಲಿಲ್ಲ, ಉನ್ನತ ಪೂಜಾಸ್ಥಳಗಳನ್ನು ಮತ್ತು ಬಲಿಪೀಠಗಳನ್ನು ಕೆಡವಿಹಾಕಿದರು. ಆಗ ಇಸ್ರಾಯೇಲರೆಲ್ಲರು ತಮ್ಮ ತಮ್ಮ ಆಸ್ತಿಪಾಸ್ತಿಯಿರುವ ಪಟ್ಟಣಗಳಿಗೆ ತಿರುಗಿ ಹೋದರು.<verse eid="2CH 31:1"/></para>
  <para style="s1">ಆರಾಧಿಸುವುದಕ್ಕೆ ವ್ಯವಸ್ಥೆ</para>
  <para style="p">
    <verse number="2" style="v" sid="2CH 31:2"/>ಹಿಜ್ಕೀಯನು ಅವನವನ ಸೇವೆಯ ಪ್ರಕಾರ ಯಾಜಕರ, ಲೇವಿಯರ ಸರತಿಗಳನ್ನು ನೇಮಿಸಿದನು. ದಹನಬಲಿಗಳನ್ನೂ ಮತ್ತು ಸಮಾಧಾನದ ಬಲಿಗಳನ್ನೂ ಅರ್ಪಿಸುವುದಕ್ಕೂ, ಸೇವಿಸುವುದಕ್ಕೂ ಯೆಹೋವ ದೇವರ ಪಾಳೆಯದ ಬಾಗಿಲುಗಳಲ್ಲಿ ಸ್ತೋತ್ರ ಮಾಡುವುದಕ್ಕೂ, ಕೊಂಡಾಡುವುದಕ್ಕೂ ಯಾಜಕರನ್ನೂ, ಲೇವಿಯರನ್ನೂ ನೇಮಿಸಿದನು. <verse eid="2CH 31:2"/><verse number="3" style="v" sid="2CH 31:3"/>ಅವನು ಯೆಹೋವ ದೇವರ ನಿಯಮದಲ್ಲಿ ಬರೆದ ಪ್ರಕಾರ ಉದಯಕಾಲದ ಸಾಯಂಕಾಲದ ದಹನಬಲಿಗಳಿಗೋಸ್ಕರವೂ ವಿಶ್ರಾಂತಿಯ ದಿನಗಳಲ್ಲಿಯೂ ಅಮಾವಾಸ್ಯೆಗಳಲ್ಲಿಯೂ ನೇಮಿಸಿದ ಹಬ್ಬಗಳಲ್ಲಿಯೂ ಬೇಕಾದ ದಹನಬಲಿಗಳಿಗೋಸ್ಕರವೂ ಅರಸನ ಆಸ್ತಿಯಿಂದಲೇ ಅವನ ಭಾಗವನ್ನು ನೇಮಿಸಿದನು. <verse eid="2CH 31:3"/><verse number="4" style="v" sid="2CH 31:4"/>ಯಾಜಕರೂ ಲೇವಿಯರೂ ಯೆಹೋವ ದೇವರ ನಿಯಮದಲ್ಲಿ ಆಸಕ್ತರಾಗಿರುವುದಕ್ಕಾಗಿ ಅವರಿಗೆ ತಕ್ಕ ಭಾಗವನ್ನು ಕೊಡಬೇಕೆಂದು ಯೆರೂಸಲೇಮಿನಲ್ಲಿ ಜನರಿಗೆ ಅವನು ಆಜ್ಞಾಪಿಸಿದನು. <verse eid="2CH 31:4"/><verse number="5" style="v" sid="2CH 31:5"/>ಈ ಆಜ್ಞೆ ಹೊರಗೆ ಬಂದಾಗಲೇ ಇಸ್ರಾಯೇಲರು ಧಾನ್ಯ, ದ್ರಾಕ್ಷಾರಸ, ಎಣ್ಣೆ, ಜೇನು, ಹೊಲಗಳ ಹುಟ್ಟುವಳಿ, ಇವುಗಳ ಮೊದಲನೆಯ ಪಾಲನ್ನು ಬಹಳವಾಗಿ ಒಳಗೆ ತಂದರು. ಹಾಗೆಯೇ ಸಮಸ್ತ ವಸ್ತುಗಳಲ್ಲಿ ದಶಮಾಂಶದ ಪಾಲನ್ನು ಬಹಳವಾಗಿ ತಂದರು. <verse eid="2CH 31:5"/><verse number="6" style="v" sid="2CH 31:6"/>ಇದಲ್ಲದೆ ಯೆಹೂದ ಪಟ್ಟಣಗಳಲ್ಲಿ ನಿವಾಸವಾಗಿರುವ ಇಸ್ರಾಯೇಲರು ಯೆಹೂದ್ಯರು ದನಗಳಲ್ಲಿಯೂ ಕುರಿಗಳಲ್ಲಿಯೂ ದಶಮಾಂಶ ತಂದರು. ತಮ್ಮ ದೇವರಾದ ಯೆಹೋವ ದೇವರಿಗೆ ಪರಿಶುದ್ಧ ಮಾಡಿದ ಪರಿಶುದ್ಧ ವಸ್ತುಗಳಲ್ಲಿ ದಶಮಾಂಶದ ಪಾಲು ತಂದು, ರಾಶಿರಾಶಿಯಾಗಿ ಇಟ್ಟರು. <verse eid="2CH 31:6"/><verse number="7" style="v" sid="2CH 31:7"/>ಮೂರನೆಯ ತಿಂಗಳಲ್ಲಿ ರಾಶಿ ಮಾಡುವುದನ್ನು ಆರಂಭಿಸಿ, ಏಳನೆಯ ತಿಂಗಳಲ್ಲಿ ತೀರಿಸಿದರು. <verse eid="2CH 31:7"/><verse number="8" style="v" sid="2CH 31:8"/>ಹಿಜ್ಕೀಯನೂ ಪ್ರಧಾನರೂ ಬಂದು ರಾಶಿಗಳನ್ನು ನೋಡಿದಾಗ, ಅವರು ಯೆಹೋವ ದೇವರನ್ನೂ ಸ್ತುತಿಸಿದರು, ಅವರ ಜನರಾದ ಇಸ್ರಾಯೇಲರನ್ನೂ ಆಶೀರ್ವದಿಸಿದರು.<verse eid="2CH 31:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="2CH 31:9"/>ಆಗ ಹಿಜ್ಕೀಯನು ರಾಶಿಗಳನ್ನು ಕುರಿತು ಯಾಜಕರನ್ನೂ, ಲೇವಿಯರನ್ನೂ ವಿಚಾರಿಸಿದನು. <verse eid="2CH 31:9"/><verse number="10" style="v" sid="2CH 31:10"/>ಚಾದೋಕ್ ಸಂತಾನದ ಮುಖ್ಯಯಾಜಕ ಅಜರ್ಯನು, “ಜನರು ದೇವರಾದ ಯೆಹೋವ ದೇವರಿಗೆ ಕಾಣಿಕೆಯಾಗಿ ಪ್ರತ್ಯೇಕಿಸತಕ್ಕದ್ದನ್ನು ಅವರ ಆಲಯಕ್ಕೆ ತಂದಂದಿನಿಂದ ಯೆಹೋವ ದೇವರು ತಮ್ಮ ಪ್ರಜೆಗೆ ಸಮೃದ್ಧಿಯನ್ನು ಅನುಗ್ರಹಿಸಿದ್ದಾರೆ. ನಾವು ಉಂಡು ತೃಪ್ತರಾಗಿ, ಇನ್ನೂ ಇಷ್ಟು ದೊಡ್ಡ ರಾಶಿಯನ್ನು ಉಳಿಸಿಕೊಂಡಿರುತ್ತೇವೆ,” ಎಂದನು.<verse eid="2CH 31:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="2CH 31:11"/>ಬಳಿಕ ಹಿಜ್ಕೀಯನು ಯೆಹೋವ ದೇವರ ಆಲಯದಲ್ಲಿ ಕೊಠಡಿಗಳನ್ನು ಸಿದ್ಧಮಾಡಲು ಆಜ್ಞಾಪಿಸಿದನು. <verse eid="2CH 31:11"/><verse number="12" style="v" sid="2CH 31:12"/>ಅವು ಸಿದ್ಧವಾದ ಮೇಲೆ ಜನರು ಕಾಣಿಕೆಗಳನ್ನು ತಮ್ಮ ಆದಾಯದ ದಶಮಾಂಶವನ್ನು ಹಾಗು ದೇವರಿಗೆ ಮುಡುಪಾಗಿ ಇಟ್ಟಿದ್ದನ್ನು ನಿರ್ವಂಚನೆಯಿಂದ ತಂದು, ಅವುಗಳಲ್ಲಿ ಹಾಕುತ್ತಿದ್ದರು. ಈ ಎಲ್ಲಾ ಉಗ್ರಾಣಗಳ ಮೇಲ್ವಿಚಾರಣೆಯಲ್ಲಿ ಲೇವಿಯನಾದ ಕೋನನ್ಯನು ಮುಖ್ಯಸ್ಥನಾಗಿದ್ದನು. ಅವನ ತಮ್ಮ ಶಿಮ್ಮಿಯು ದ್ವಿತೀಯ ಸ್ಥಾನದವನಾಗಿದ್ದನು. <verse eid="2CH 31:12"/><verse number="13" style="v" sid="2CH 31:13"/>ಅರಸನಾದ ಹಿಜ್ಕೀಯನು ನೇಮಿಸಿದ ಪ್ರಕಾರ, ಯೆಹೀಯೇಲ್, ಅಜಜ್ಯ, ನಹತ್, ಅಸಾಯೇಲ್, ಯೆರೀಮೋತ್, ಯೋಜಾಬಾದ್, ಎಲೀಯೇಲ್, ಇಸ್ಮಕ್ಯ, ಮಹತ್, ಬೆನಾಯ, ಇವರು ಕೋನನ್ಯನ ಸಹೋದರನಾದ ಶಿಮ್ಮಿಯ ಕೈಕೆಳಗೆ ಆಡಳಿತಗಾರರಾಗಿದ್ದರು. ಅಜರ್ಯನು ದೇವರ ಆಲಯದ ಅಧಿಪತಿಯಾಗಿದ್ದನು.<verse eid="2CH 31:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="2CH 31:14"/>ಲೇವಿಯನಾಗಿರುವ ಇಮ್ನನ ಮಗ ಕೋರೆಯು ಎಂಬ ಪೂರ್ವದಿಕ್ಕಿನಲ್ಲಿರುವ ದ್ವಾರಪಾಲಕನು ಯೆಹೋವ ದೇವರ ಕಾಣಿಕೆಗಳನ್ನೂ, ಮಹಾಪರಿಶುದ್ಧವಾದವುಗಳನ್ನೂ ಪಾಲು ಹಂಚುವುದಕ್ಕೆ ದೇವರಿಗೆ ಉಚಿತಾರ್ಥವಾಗಿ ಅರ್ಪಿಸಿದ ಕಾಣಿಕೆಗಳ ಮೇಲ್ವಿಚಾರಕನಾಗಿದ್ದನು. <verse eid="2CH 31:14"/><verse number="15" style="v" sid="2CH 31:15"/>ಇವನ ತರುವಾಯ ಯಾಜಕರ ಪಟ್ಟಣಗಳಲ್ಲಿ ತಮ್ಮ ಸಹೋದರರಿಗೆ ನಂಬಿಗಸ್ತಿಕೆಯಿಂದ ಸರತಿ ಸರತಿಯಾಗಿ ಹಿರಿಯರು ಕಿರಿಯರು ಎಂಬ ವ್ಯತ್ಯಾಸಮಾಡದೆ ಪಾಲು ಹಂಚುವುದಕ್ಕೆ ಏದೆನನೂ, ಮಿನ್ಯಾಮೀನನೂ, ಯೇಷೂವನ ಶೆಮಾಯನೂ, ಅಮರ್ಯನೂ, ಶೆಕನ್ಯನೂ ಇದ್ದರು.<verse eid="2CH 31:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="2CH 31:16"/>ವಂಶಾವಳಿಯ ದಾಖಲೆಯ ಪ್ರಕಾರ ಮೂರು ವರ್ಷ ಪ್ರಾಯ ಮೊದಲ್ಗೊಂಡು ಮೇಲಿರುವ ಗಂಡು ಮಕ್ಕಳು ಹೊರತಾಗಿ ಯೆಹೋವ ದೇವರ ಆಲಯದಲ್ಲಿ ಪ್ರವೇಶಿಸುವವರೆಲ್ಲರಿಗೆ ಅವರ ಕೆಲಸಗಳಲ್ಲಿ ಅವರ ಸರತಿಗಳ ಪ್ರಕಾರ ಅವರ ಸೇವೆಗೆ ಅವರವರ ದಿನದ ಭಾಗವನ್ನು ಕೊಡುವುದಕ್ಕೂ, <verse eid="2CH 31:16"/><verse number="17" style="v" sid="2CH 31:17"/>ಹಾಗೆಯೇ ಇಪ್ಪತ್ತು ವರ್ಷ ಪ್ರಾಯ ಮೊದಲ್ಗೊಂಡು ವಂಶಾವಳಿಯ ದಾಖಲೆಯ ಪ್ರಕಾರ ಅವರವರ ಕೆಲಸಗಳಲ್ಲಿಯೂ, ಅವರವರ ಸರತಿಗಳಲ್ಲಿಯೂ ಇರುವ ಯಾಜಕರಿಗೂ, ಲೇವಿಯರಿಗೂ ಅವರ ಸಮಸ್ತ ಕೂಟದಲ್ಲಿ ವಂಶಾವಳಿಯ ದಾಖಲೆಯ ಪ್ರಕಾರ <verse eid="2CH 31:17"/><verse number="18" style="v" sid="2CH 31:18"/>ಅವರ ಹೆಂಡತಿಯರಿಗೂ ಚಿಕ್ಕವರಿಗೂ ಪುತ್ರಪುತ್ರಿಯರಿಗೂ ಪಾಲು ಕೊಡುವುದಕ್ಕೂ ಇದ್ದರು. ಏಕೆಂದರೆ ಅವರು ತಮ್ಮ ಉದ್ಯೋಗದಲ್ಲಿ ತಮ್ಮನ್ನೇ ತಾವು ಪರಿಶುದ್ಧಗೊಳಿಸುವಲ್ಲಿ ನಂಬಿಗಸ್ತರಾಗಿದ್ದರು.<verse eid="2CH 31:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="2CH 31:19"/>ಯಾಜಕರಲ್ಲಿ ಸಮಸ್ತ ಗಂಡಸರಿಗೂ, ಲೇವಿಯರಲ್ಲಿ ಲಿಖಿತರಾದ ಸಮಸ್ತರಿಗೂ ಪಾಲನ್ನು ಕೊಡುವುದಕ್ಕೆ ತಮ್ಮ ಪಟ್ಟಣಗಳ ವಲಯಗಳಲ್ಲಿರುವ ಯಾಜಕರಾದ ಆರೋನನ ವಂಶಾವಳಿಯ ದಾಖಲೆಯ ಪ್ರಕಾರ ಮನುಷ್ಯರು ಪ್ರತಿ ಪಟ್ಟಣದಲ್ಲಿ ಇದ್ದರು.<verse eid="2CH 31:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="2CH 31:20"/>ಹೀಗೆಯೇ ಹಿಜ್ಕೀಯನು ಸಮಸ್ತ ಯೆಹೂದದಲ್ಲಿ ತನ್ನ ದೇವರಾದ ಯೆಹೋವ ದೇವರ ಸಮ್ಮುಖದಲ್ಲಿ ಉತ್ತಮವಾದದ್ದನ್ನೂ, ಸರಿಯಾದದ್ದನ್ನೂ, ಸತ್ಯವಾದದ್ದನ್ನೂ ನಡೆಸಿದನು. <verse eid="2CH 31:20"/><verse number="21" style="v" sid="2CH 31:21"/>ಇದಲ್ಲದೆ ದೇವರ ಆಲಯದ ಸೇವೆಯಲ್ಲಿಯೂ, ಮೋಶೆಯ ನಿಯಮದಲ್ಲಿಯೂ, ದೇವರ ಆಜ್ಞೆಗಳಲ್ಲಿಯೂ ಅವನು ತನ್ನ ದೇವರನ್ನು ಹುಡುಕಲು ಆರಂಭಿಸಿದ ಸಮಸ್ತ ಕಾರ್ಯಗಳನ್ನು ತನ್ನ ಪೂರ್ಣಹೃದಯದಿಂದ ಮಾಡಿ, ಅವನು ಅಭಿವೃದ್ಧಿ ಹೊಂದಿದನು.<verse eid="2CH 31:21"/></para>
  <chapter eid="2CH 31"/>
  <chapter number="32" style="c" sid="2CH 32"/>
  <para style="s1">ಸನ್ಹೇರೀಬನು ಯೆರೂಸಲೇಮನ್ನು ಭಯಪಡಿಸಿದ್ದು</para>
  <para style="p">
    <verse number="1" style="v" sid="2CH 32:1"/>ಹಿಜ್ಕೀಯನು ಇಷ್ಟು ನಂಬಿಗಸ್ತಿಕೆಯಿಂದ ಎಲ್ಲವನ್ನೂ ಮಾಡಿದ ತರುವಾಯ, ಅಸ್ಸೀರಿಯದ ಅರಸನಾದ ಸನ್ಹೇರೀಬನು ಬಂದು, ಯೆಹೂದದಲ್ಲಿ ಪ್ರವೇಶಿಸಿ ಕೋಟೆಯುಳ್ಳ ಪಟ್ಟಣಗಳ ಬಳಿಯಲ್ಲಿ ದಂಡಿಳಿಸಿ, ಅವುಗಳನ್ನು ತನಗಾಗಿ ಜಯಿಸಬೇಕೆಂದು ಮುತ್ತಿಗೆಹಾಕಿದನು. <verse eid="2CH 32:1"/><verse number="2" style="v" sid="2CH 32:2"/>ಸನ್ಹೇರೀಬನು ಬಂದದ್ದನ್ನೂ, ಅವನು ಯೆರೂಸಲೇಮಿನ ಮೇಲೆ ಯುದ್ಧಮಾಡಲು ನಿಶ್ಚಯಿಸಿದ್ದನ್ನೂ ಹಿಜ್ಕೀಯನು ಕಂಡಾಗ, <verse eid="2CH 32:2"/><verse number="3" style="v" sid="2CH 32:3"/>ಅವನು ಪಟ್ಟಣದ ಹೊರಗಿರುವ ನೀರಿನ ಬುಗ್ಗೆಗಳನ್ನು ಮುಚ್ಚಿಸುವುದಕ್ಕೆ ತನ್ನ ಪ್ರಧಾನರ ಮತ್ತು ತನ್ನ ಪರಾಕ್ರಮಶಾಲಿಗಳ ಸಂಗಡ ಯೋಚಿಸಿಕೊಂಡನು. ಅವರು ಅವನಿಗೆ ಸಹಾಯ ಕೊಟ್ಟರು. <verse eid="2CH 32:3"/><verse number="4" style="v" sid="2CH 32:4"/>ಆದ್ದರಿಂದ ಅನೇಕ ಜನರು ಕೂಡಿಕೊಂಡು, “ನೀರು ಬುಗ್ಗೆಗಳನ್ನೂ, ದೇಶದ ಮಧ್ಯದಲ್ಲಿ ಹರಿಯುವ ಹಳ್ಳವನ್ನೂ ಮುಚ್ಚಿಬಿಟ್ಟು, ಅಸ್ಸೀರಿಯದ ಅರಸರು ಬಂದು ಬಹಳ ನೀರು ದೊರಕಿಸಿಕೊಳ್ಳುವುದು ಏಕೆ?” ಎಂದರು. <verse eid="2CH 32:4"/><verse number="5" style="v" sid="2CH 32:5"/>ಇದಲ್ಲದೆ ಅವನು ತನ್ನನ್ನು ಬಲಪಡಿಸಿಕೊಂಡು, ಬಿದ್ದುಹೋಗಿದ್ದ ಗೋಡೆಯನ್ನೆಲ್ಲಾ ಕಟ್ಟಿಸಿ, ಗೋಪುರಗಳ ಪರ್ಯಂತರ ಅದನ್ನು ಎತ್ತರಮಾಡಿ, ಅದರ ಹೊರಭಾಗದಲ್ಲಿ ಮತ್ತೊಂದು ಗೋಡೆಯನ್ನು ಕಟ್ಟಿಸಿ, ದಾವೀದನ ಪಟ್ಟಣದಲ್ಲಿರುವ ಮಿಲ್ಲೋವನ್ನು ದುರಸ್ತಿ ಮಾಡಿ ಈಟಿಗಳನ್ನೂ, ಗುರಾಣಿಗಳನ್ನೂ ಬಹಳವಾಗಿ ಮಾಡಿಸಿದನು.<verse eid="2CH 32:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="2CH 32:6"/>ಜನರ ಮೇಲೆ ಯುದ್ಧದ ಸೈನ್ಯಗಳ ಅಧಿಪತಿಗಳನ್ನು ಇರಿಸಿ, ಪಟ್ಟಣದ ಬಾಗಿಲ ಬೀದಿಯಲ್ಲಿ ತನ್ನ ಬಳಿಗೆ ಅವರನ್ನು ಕೂಡಿಸಿಕೊಂಡು, ಈ ಮಾತುಗಳಿಂದ ಅವರನ್ನು ಪ್ರೋತ್ಸಾಹಿಸಿದರು: <verse eid="2CH 32:6"/><verse number="7" style="v" sid="2CH 32:7"/>“ಬಲಗೊಳ್ಳಿರಿ, ಧೈರ್ಯವಾಗಿರಿ, ಅಸ್ಸೀರಿಯದ ಅರಸನ ನಿಮಿತ್ತವೂ, ಅವನ ಸಂಗಡ ಕೂಡಿರುವ ಮಹಾ ಗುಂಪಿನ ನಿಮಿತ್ತವೂ ಭಯಪಡಬೇಡಿರಿ, ನಿರಾಶರಾಗಬೇಡಿರಿ. ಏಕೆಂದರೆ ಅವನ ಸಂಗಡ ಇರುವವರಿಗಿಂತ ಮಿಗಿಲಾದದ್ದು ನಮ್ಮ ಸಂಗಡ ಇದೆ. <verse eid="2CH 32:7"/><verse number="8" style="v" sid="2CH 32:8"/>ನಮಗಾದರೋ ಸಹಾಯ ಮಾಡುವುದಕ್ಕೂ, ನಮ್ಮ ಯುದ್ಧಗಳನ್ನು ನಡಿಸುವುದಕ್ಕೂ ನಮ್ಮ ದೇವರಾದ ಯೆಹೋವ ದೇವರು ತಾವೇ ಇದ್ದಾರೆ,” ಎಂದು ಹೇಳಿದನು. ಆದ್ದರಿಂದ ಜನರು ಯೆಹೂದದ ಅರಸನಾದ ಹಿಜ್ಕೀಯನ ಮಾತುಗಳಲ್ಲಿ ಭರವಸೆಯುಳ್ಳವರಾದರು.<verse eid="2CH 32:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="2CH 32:9"/>ಇದರ ತರುವಾಯ ಅಸ್ಸೀರಿಯದ ಅರಸನಾದ ಸನ್ಹೇರೀಬನೂ, ಅವನ ಸಂಗಡ ಕೂಡಿರುವ ಅವನ ಸಮಸ್ತ ಬಲವೂ ಲಾಕೀಷನ್ನು ಮುತ್ತಿಗೆ ಹಾಕಿದಾಗ, ಅವನು ಯೆರೂಸಲೇಮಿನಲ್ಲಿರುವ ಯೆಹೂದದ ಅರಸನಾದ ಹಿಜ್ಕೀಯನ ಬಳಿಗೂ, ಯೆರೂಸಲೇಮಿನಲ್ಲಿರುವ ಸಮಸ್ತ ಯೆಹೂದದವರ ಬಳಿಗೂ ತನ್ನ ಸೇವಕರನ್ನು ಕಳುಹಿಸಿದನು.<verse eid="2CH 32:9"/></para>
  <para style="pm">
    <verse number="10" style="v" sid="2CH 32:10"/>“ಅಸ್ಸೀರಿಯದ ಅರಸನಾದ ಸನ್ಹೇರೀಬನು ಹೀಗೆ ಹೇಳುತ್ತಾನೆ: ನೀವು ಯಾವುದರ ಮೇಲೆ ಭರವಸೆಯಿಟ್ಟು ಮುತ್ತಿಗೆಗೆ ಗುರಿಯಾಗಲಿರುವ ಯೆರೂಸಲೇಮಿನಲ್ಲಿ ಉಳಿದಿರುವಿರಿ? <verse eid="2CH 32:10"/><verse number="11" style="v" sid="2CH 32:11"/>‘ನಮ್ಮ ದೇವರಾದ ಯೆಹೋವ ದೇವರು ಅಸ್ಸೀರಿಯದ ಅರಸನ ಕೈಯಿಂದ ನಮ್ಮನ್ನು ಬಿಡಿಸುವರು,’ ಎಂದು ಹಿಜ್ಕೀಯನು ಹೇಳಿ, ನಿಮ್ಮನ್ನು ಹಸಿವೆ ಮತ್ತು ದಾಹದಿಂದ ಸಾಯಿಸುವುದಕ್ಕೆ ಒಪ್ಪಿಸಿಕೊಡಲು ಪ್ರೇರೇಪಿಸುತ್ತಾನಲ್ಲವೇ? <verse eid="2CH 32:11"/><verse number="12" style="v" sid="2CH 32:12"/>ಈ ಹಿಜ್ಕೀಯನು ಅವನ ಪೂಜಾಸ್ಥಳಗಳನ್ನೂ, ಬಲಿಪೀಠಗಳನ್ನೂ ತೆಗೆದುಹಾಕಿ ಯೆಹೂದ್ಯರಿಗೆ ಮತ್ತು ಯೆರೂಸಲೇಮಿನವರಿಗೆ, ‘ನೀವು ಒಂದೇ ಬಲಿಪೀಠದ ಮುಂದೆ ಅಡ್ಡಬಿದ್ದು, ಅದರ ಮೇಲೆ ಧೂಪವನ್ನರ್ಪಿಸಬೇಕು,’ ಎಂದು ಹೇಳಿದ್ದಾನಲ್ಲವೇ?<verse eid="2CH 32:12"/></para>
  <para style="pm">
    <verse number="13" style="v" sid="2CH 32:13"/>“ನಾನೂ, ನನ್ನ ಪಿತೃಗಳು ದೇಶಗಳ ಜನರಿಗೆ ಮಾಡಿದ್ದನ್ನು ನೀವು ತಿಳಿಯಲಿಲ್ಲವೋ? ಆ ದೇಶಗಳ ಜನಾಂಗಗಳ ದೇವರುಗಳು ಆ ದೇಶಗಳನ್ನು ನನ್ನ ಕೈಯೊಳಗಿಂದ ಹೇಗಾದರೂ ಬಿಡಿಸಲು ಸಾಮರ್ಥ್ಯವಿತ್ತೋ? <verse eid="2CH 32:13"/><verse number="14" style="v" sid="2CH 32:14"/>ನನ್ನ ಪಿತೃಗಳು ನಿರ್ಮೂಲ ಮಾಡಿದ ಆ ಜನಾಂಗಗಳ ಸಮಸ್ತ ದೇವರುಗಳಲ್ಲಿ ನನ್ನ ಕೈಯಿಂದ ತನ್ನ ಜನರನ್ನು ಬಿಡಿಸಲು ಸಾಮರ್ಥ್ಯವುಳ್ಳದ್ದು ಯಾವುದು? ಹಾಗಾದರೆ ನಿಮ್ಮ ದೇವರು ನಿಮ್ಮನ್ನು ನನ್ನ ಕೈಗೆ ಸಿಗದಂತೆ ತಪ್ಪಿಸಿ ಕಾಪಾಡುವನೋ? <verse eid="2CH 32:14"/><verse number="15" style="v" sid="2CH 32:15"/>ಆದ್ದರಿಂದ ಹಿಜ್ಕೀಯನು ನಿಮ್ಮನ್ನು ವಂಚಿಸಿ ನಿಮ್ಮನ್ನು ದಾರಿತಪ್ಪಿಸಲು ಬಿಡಬೇಡಿರಿ. ಅವನ ಮಾತು ನಂಬಬೇಡಿರಿ. ನನ್ನ ಕೈಯೊಳಗಿಂದಲೂ, ನನ್ನ ಪಿತೃಗಳ ಕೈಯೊಳಗಿಂದಲೂ ತಮ್ಮ ಜನರನ್ನು ಬಿಡಿಸಲು ಸಕಲ ಜನಾಂಗ, ರಾಜ್ಯಗಳ ದೇವರುಗಳಲ್ಲಿ ಸಾಮರ್ಥ್ಯವುಳ್ಳ ದೇವರು ಒಂದೂ ಇಲ್ಲ. ನನ್ನ ಕೈಯಿಂದ ನಿಮ್ಮನ್ನು ಬಿಡಿಸಲು ನಿಮ್ಮ ದೇವರು ಎಷ್ಟರವನು? ಅನ್ನುತ್ತಾನೆ,” ಎಂದು ಹೇಳಿದರು.<verse eid="2CH 32:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="2CH 32:16"/>ಹೀಗೆ ಅವನ ಸೇವಕರು ಇನ್ನೂ ದೇವರಾದ ಯೆಹೋವ ದೇವರಿಗೆ ವಿರೋಧವಾಗಿಯೂ, ಅವರ ಸೇವಕನಾದ ಹಿಜ್ಕೀಯನಿಗೆ ವಿರೋಧವಾಗಿಯೂ ಮಾತನಾಡಿದರು. <verse eid="2CH 32:16"/><verse number="17" style="v" sid="2CH 32:17"/>ಇದಲ್ಲದೆ ಅವನು ಇಸ್ರಾಯೇಲಿನ ದೇವರಾದ ಯೆಹೋವ ದೇವರನ್ನು ನಿಂದಿಸುವುದಕ್ಕೂ, ಅವರಿಗೆ ವಿರೋಧವಾಗಿ ಮಾತನಾಡುವುದಕ್ಕೂ ಪತ್ರಗಳನ್ನು ಬರೆದನು. ಅದರಲ್ಲಿ, “ಇತರ ದೇಶಗಳ ಜನಾಂಗಗಳ ದೇವರುಗಳು, ತಮ್ಮ ಜನರನ್ನು ನನ್ನ ಕೈಯೊಳಗಿಂದ ಹೇಗೆ ಬಿಡಿಸಲಿಲ್ಲವೋ, ಹಾಗೆಯೇ ಹಿಜ್ಕೀಯನ ದೇವರು ತನ್ನ ಜನರನ್ನು ನನ್ನ ಕೈಯೊಳಗಿಂದ ಬಿಡಿಸನು,” ಎಂದು ಬರೆದಿತ್ತು. <verse eid="2CH 32:17"/><verse number="18" style="v" sid="2CH 32:18"/>ಇದಲ್ಲದೆ ಅವರು ಪಟ್ಟಣವನ್ನು ಹಿಡಿಯುವ ಹಾಗೆ ಗೋಡೆಯ ಮೇಲೆ ಇರುವ ಯೆರೂಸಲೇಮಿನಲ್ಲಿರುವ ಜನರನ್ನು ಭಯಪಡಿಸುವುದಕ್ಕೂ, ಯೆಹೂದ್ಯರ ಭಾಷೆಯಾದ ಹಿಬ್ರಿಯದಲ್ಲಿ ದೊಡ್ಡ ಶಬ್ದದಿಂದ ಅವರನ್ನು ಕೂಗಿದರು. <verse eid="2CH 32:18"/><verse number="19" style="v" sid="2CH 32:19"/>ಮನುಷ್ಯರ ಕೈಕೆಲಸವಾದ ಭೂಮಿಯ ಜನರ ದೇವರುಗಳಿಗೆ ವಿರೋಧವಾಗಿ ಮಾತನಾಡಿದ ಹಾಗೆ, ಯೆರೂಸಲೇಮಿನ ದೇವರಿಗೆ ವಿರೋಧವಾಗಿ ಮಾತನಾಡಿದರು.<verse eid="2CH 32:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="2CH 32:20"/>ಇದರ ನಿಮಿತ್ತ ಅರಸನಾದ ಹಿಜ್ಕೀಯನೂ, ಆಮೋಚನ ಮಗನಾದ ಪ್ರವಾದಿಯಾದ ಯೆಶಾಯನೂ ಪ್ರಾರ್ಥನೆಮಾಡಿ ಪರಲೋಕಕ್ಕೆ ಕೂಗಿದರು. <verse eid="2CH 32:20"/><verse number="21" style="v" sid="2CH 32:21"/>ಆಗ ಯೆಹೋವ ದೇವರು ತಮ್ಮ ದೂತನನ್ನು ಕಳುಹಿಸಿದರು. ಅವನು ಅಸ್ಸೀರಿಯದ ಅರಸನ ದಂಡಿನಲ್ಲಿರುವ ಸಮಸ್ತ ಪರಾಕ್ರಮಶಾಲಿಗಳನ್ನೂ, ನಾಯಕರನ್ನೂ, ಅಧಿಪತಿಗಳನ್ನೂ ನಿರ್ಮೂಲ ಮಾಡಿದನು. ಹೀಗೆ ಇವನು ನಾಚಿಕೆಯಿಂದ ತನ್ನ ದೇಶಕ್ಕೆ ಹಿಂದಿರುಗಿದನು. ಅವನು ತನ್ನ ದೇವರ ಆಲಯದಲ್ಲಿ ಪ್ರವೇಶಿಸಿದಾಗ, ಅವನ ಹೊಟ್ಟೆಯಲ್ಲಿ ಹುಟ್ಟಿದವರು ಅವನನ್ನು ಖಡ್ಗದಿಂದ ಕೊಂದುಹಾಕಿದರು.<verse eid="2CH 32:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="2CH 32:22"/>ಹೀಗೆ ಯೆಹೋವ ದೇವರು ಹಿಜ್ಕೀಯನನ್ನೂ, ಯೆರೂಸಲೇಮಿನ ನಿವಾಸಿಗಳನ್ನೂ, ಅಸ್ಸೀರಿಯದ ಅರಸನಾದ ಸನ್ಹೇರೀಬನ ಕೈಯೊಳಗಿಂದಲೂ, ಸಮಸ್ತರ ಕೈಯೊಳಗಿಂದಲೂ ರಕ್ಷಿಸಿ, ಸಮಸ್ತ ಕಡೆಯಿಂದ ಅವರನ್ನು ನಡೆಸಿದರು. <verse eid="2CH 32:22"/><verse number="23" style="v" sid="2CH 32:23"/>ಅನೇಕರು ಯೆರೂಸಲೇಮಿನಲ್ಲಿರುವ ಯೆಹೋವ ದೇವರಿಗೆ ಅರ್ಪಣೆಗಳನ್ನೂ, ಯೆಹೂದದ ಅರಸನಾದ ಹಿಜ್ಕೀಯನಿಗೆ ಕಾಣಿಕೆಗಳನ್ನೂ ತಂದರು. ಅಂದಿನಿಂದ ಅವನು ಸಮಸ್ತ ಜನಾಂಗಗಳ ಮುಂದೆ ಉನ್ನತವಾಗಿದ್ದನು.<verse eid="2CH 32:23"/></para>
  <para style="s1">ಹಿಜ್ಕೀಯನ ಗರ್ವ, ಜಯ ಹಾಗೂ ಮರಣ</para>
  <para style="p">
    <verse number="24" style="v" sid="2CH 32:24"/>ಆ ದಿವಸಗಳಲ್ಲಿ ಹಿಜ್ಕೀಯನು ರೋಗದಿಂದ ಮರಣಾವಸ್ಥೆಯಲ್ಲಿದ್ದನು. ಆಗ ಅವನು ಯೆಹೋವ ದೇವರನ್ನು ಪ್ರಾರ್ಥಿಸಲು, ದೇವರು ಅವನ ಸಂಗಡ ಮಾತನಾಡಿ ಅವನಿಗೆ ಒಂದು ಅದ್ಭುತವಾದ ಗುರುತನ್ನು ಕೊಟ್ಟರು. <verse eid="2CH 32:24"/><verse number="25" style="v" sid="2CH 32:25"/>ಆದರೆ ಹಿಜ್ಕೀಯನು ತನಗೆ ಆದ ಉಪಕಾರಕ್ಕೆ ತಕ್ಕಂತೆ ನಡೆಯದೆ ಹೋದನು. ಏಕೆಂದರೆ ಅವನ ಹೃದಯವು ಅಹಂಕಾರದಿಂದ ತುಂಬಿತ್ತು. ಆದ್ದರಿಂದ ಅವನ ಮೇಲೆಯೂ, ಯೆಹೂದ ಮತ್ತು ಯೆರೂಸಲೇಮಿನ ಮೇಲೆಯೂ ಯೆಹೋವ ದೇವರ ರೌದ್ರ ಉಂಟಾಯಿತು. <verse eid="2CH 32:25"/><verse number="26" style="v" sid="2CH 32:26"/>ಅನಂತರ ಹಿಜ್ಕೀಯನೂ, ಯೆರೂಸಲೇಮಿನ ನಿವಾಸಿಗಳೂ ತಮ್ಮ ಹೃದಯದ ಗರ್ವದ ವಿಷಯದಲ್ಲಿ ತಮ್ಮನ್ನು ತಾವು ತಗ್ಗಿಸಿಕೊಂಡದ್ದರಿಂದ, ಹಿಜ್ಕೀಯನ ದಿವಸಗಳಲ್ಲಿ ಯೆಹೋವ ದೇವರ ರೌದ್ರವು ಅವರ ಮೇಲೆ ಬರಲಿಲ್ಲ.<verse eid="2CH 32:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="2CH 32:27"/>ಹಿಜ್ಕೀಯನಿಗೆ ಅತ್ಯಧಿಕವಾದ ಐಶ್ವರ್ಯವೂ, ಘನವೂ ಇದ್ದುದರಿಂದ, ಅವನು ಬೆಳ್ಳಿಗೋಸ್ಕರವೂ, ಬಂಗಾರಕ್ಕೋಸ್ಕರವೂ, ರತ್ನಗಳಿಗೋಸ್ಕರವೂ, ಸುಗಂಧ ದ್ರವ್ಯಗಳಿಗೋಸ್ಕರವೂ, ಗುರಾಣಿಗಳಿಗೋಸ್ಕರವೂ, ಎಲ್ಲಾ ವಿಧದ ಮನೋಹರವಾದ ಆಭರಣಗಳಿಗೋಸ್ಕರವೂ ತನಗೆ ಉಗ್ರಾಣಗಳನ್ನು ಮಾಡಿಸಿದನು. <verse eid="2CH 32:27"/><verse number="28" style="v" sid="2CH 32:28"/>ಇದಲ್ಲದೆ ಧಾನ್ಯ, ದ್ರಾಕ್ಷಾರಸ, ಎಣ್ಣೆ ಇವುಗಳನ್ನು ಸಂಗ್ರಹಿಸುವುದಕ್ಕಾಗಿ ಉಗ್ರಾಣಗಳನ್ನೂ, ಸಕಲ ವಿಧವಾದ ಪಶುಗಳ ನಿಮಿತ್ತವಾಗಿ ಕೊಟ್ಟಿಗೆಗಳನ್ನೂ, ಕುರಿಮಂದೆಯ ನಿಮಿತ್ತವಾಗಿ ಹಟ್ಟಿಗಳನ್ನೂ ಮಾಡಿದನು. <verse eid="2CH 32:28"/><verse number="29" style="v" sid="2CH 32:29"/>ಇದಲ್ಲದೆ ತನಗೆ ಪಟ್ಟಣಗಳನ್ನೂ, ದನಕುರಿಗಳ ದೊಡ್ಡ ಹಿಂಡುಗಳನ್ನೂ ಬಹಳವಾಗಿ ಮಾಡಿಕೊಂಡನು. ಏಕೆಂದರೆ ದೇವರು ಅವನಿಗೆ ಬಹು ಹೆಚ್ಚಾಗಿ ಸಂಪತ್ತನ್ನು ಕೊಟ್ಟರು.<verse eid="2CH 32:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="2CH 32:30"/>ಈ ಹಿಜ್ಕೀಯನು ಗೀಹೋನೆಂಬ ಮೇಲಿನ ಕಾಲುವೆಯನ್ನು ಮುಚ್ಚಿಬಿಟ್ಟು, ಅದನ್ನು ದಾವೀದನ ಪಟ್ಟಣದಲ್ಲಿ ಪಶ್ಚಿಮ ದಿಕ್ಕಿಗೆ ಕಾಲುವೆಯಾಗಿ ಬರಮಾಡಿದನು. ಹೀಗೆಯೇ ಹಿಜ್ಕೀಯನು ತನ್ನ ಸಮಸ್ತ ಕ್ರಿಯೆಗಳಲ್ಲಿ ವೃದ್ಧಿಹೊಂದಿದನು. <verse eid="2CH 32:30"/><verse number="31" style="v" sid="2CH 32:31"/>ಆದರೆ ದೇಶದಲ್ಲಿ ಅದ್ಭುತಕ್ಕೋಸ್ಕರ ವಿಚಾರಣೆ ಮಾಡಲು ಬಾಬಿಲೋನಿನ ಅಧಿಪತಿಗಳಿಂದ ತನ್ನ ಬಳಿಗೆ ಕಳುಹಿಸಲಾದ ರಾಯಭಾರಿಗಳ ಕಾರ್ಯದಲ್ಲಿ ಅವನು ತನ್ನ ಹೃದಯದಲ್ಲಿ ಇರುವ ಪ್ರತಿಯೊಂದನ್ನೂ ತಿಳಿದುಕೊಳ್ಳುವದಕ್ಕಾಗಿಯೂ ಪರಿಶೋಧಿಸುವುದಕ್ಕಾಗಿಯೂ ದೇವರು ಅವನನ್ನು ಕೈಬಿಟ್ಟರು.<verse eid="2CH 32:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="2CH 32:32"/>ಹಿಜ್ಕೀಯನ ಇತರ ಕಾರ್ಯಗಳೂ ಅವನ ಭಕ್ತಿಕಾರ್ಯಗಳೂ ಆಮೋಚನ ಮಗ ಪ್ರವಾದಿಯಾದ ಯೆಶಾಯನ ದರ್ಶನದ ಪುಸ್ತಕದಲ್ಲಿ ಮತ್ತು ಯೆಹೂದ ಇಸ್ರಾಯೇಲ್ ಅರಸರ ಇತಿಹಾಸಗಳ ಪುಸ್ತಕದಲ್ಲಿ ಬರೆದಿರುತ್ತವೆ. <verse eid="2CH 32:32"/><verse number="33" style="v" sid="2CH 32:33"/>ಹಿಜ್ಕೀಯನು ತನ್ನ ಪಿತೃಗಳ ಬಳಿಗೆ ಸೇರಿದನು. ಅವರು ದಾವೀದನ ಮಕ್ಕಳ ಸಮಾಧಿಗಳಲ್ಲಿರುವ ಶ್ರೇಷ್ಠವಾದುದರಲ್ಲಿ ಅವನನ್ನು ಹೂಳಿಟ್ಟರು. ಅವನ ಮರಣದಲ್ಲಿ ಸಮಸ್ತ ಯೆಹೂದದವರೂ, ಯೆರೂಸಲೇಮಿನ ನಿವಾಸಿಗಳೂ ಅವನನ್ನು ಘನಪಡಿಸಿದರು. ಅವನ ಮಗ ಮನಸ್ಸೆಯು ಅವನಿಗೆ ಬದಲಾಗಿ ಅರಸನಾದನು.<verse eid="2CH 32:33"/></para>
  <chapter eid="2CH 32"/>
  <chapter number="33" style="c" sid="2CH 33"/>
  <para style="s1">ಯೆಹೂದ್ಯರ ಅರಸನಾದ ಮನಸ್ಸೆಯು</para>
  <para style="p">
    <verse number="1" style="v" sid="2CH 33:1"/>ಮನಸ್ಸೆಯು ಅರಸನಾದಾಗ ಹನ್ನೆರಡು ವರ್ಷದವನಾಗಿದ್ದನು. ಅವನು ಐವತ್ತೈದು ವರ್ಷ ಯೆರೂಸಲೇಮಿನಲ್ಲಿ ಆಳಿದನು. <verse eid="2CH 33:1"/><verse number="2" style="v" sid="2CH 33:2"/>ಆದರೆ ಯೆಹೋವ ದೇವರು ಇಸ್ರಾಯೇಲರ ಮುಂದೆ ಹೊರಡಿಸಿಬಿಟ್ಟ ಜನಾಂಗಗಳ ಅಸಹ್ಯವಾದವುಗಳನ್ನು ಅವನು ಅನುಸರಿಸಿ ಯೆಹೋವ ದೇವರ ದೃಷ್ಟಿಯಲ್ಲಿ ಕೆಟ್ಟದ್ದನ್ನು ಮಾಡಿದನು. <verse eid="2CH 33:2"/><verse number="3" style="v" sid="2CH 33:3"/>ಅವನು ತನ್ನ ತಂದೆಯಾದ ಹಿಜ್ಕೀಯನು ನಾಶಮಾಡಿದ ಉನ್ನತ ಪೂಜಾಸ್ಥಳಗಳನ್ನು ಮತ್ತೆ ಸ್ಥಾಪಿಸಿ, ಬಾಳನಿಗೆ ಬಲಿಪೀಠಗಳನ್ನು ಕಟ್ಟಿಸಿ, ಅಶೇರ ವಿಗ್ರಹಸ್ತಂಭಗಳನ್ನು ನಿಲ್ಲಿಸಿ, ಸಮಸ್ತ ನಕ್ಷತ್ರಮಂಡಲಕ್ಕೆ ಅಡ್ಡಬಿದ್ದು ಅವುಗಳನ್ನು ಪೂಜಿಸಿದನು. <verse eid="2CH 33:3"/><verse number="4" style="v" sid="2CH 33:4"/>ಇದಲ್ಲದೆ ಯೆರೂಸಲೇಮಿನಲ್ಲಿ, “ನನ್ನ ಹೆಸರು ಯುಗಯುಗಕ್ಕೂ ಇರುವುದು,” ಎಂದು ಯೆಹೋವ ದೇವರು ಯಾವುದನ್ನು ಕುರಿತು ಹೇಳಿದ್ದರೋ, ಆ ಆಲಯದಲ್ಲಿ ಅವನು ಬಹಳ ಬಲಿಪೀಠಗಳನ್ನು ಕಟ್ಟಿಸಿದನು. <verse eid="2CH 33:4"/><verse number="5" style="v" sid="2CH 33:5"/>ಯೆಹೋವ ದೇವರ ಆಲಯದ ಎರಡು ಅಂಗಳಗಳಲ್ಲಿ ಆಕಾಶದ ಸಮಸ್ತ ನಕ್ಷತ್ರಮಂಡಲಕ್ಕಾಗಿ ಬಲಿಪೀಠಗಳನ್ನು ಕಟ್ಟಿಸಿದನು. <verse eid="2CH 33:5"/><verse number="6" style="v" sid="2CH 33:6"/>ಇದಲ್ಲದೆ ಮನಸ್ಸೆಯು ಬೆನ್ ಹಿನ್ನೋಮ್ ತಗ್ಗಿನಲ್ಲಿ ತನ್ನ ಮಕ್ಕಳನ್ನು ಬಲಿಯಾಗಿ ಅರ್ಪಿಸಿದನು. ಮೇಘ ಮಂತ್ರಗಳನ್ನೂ, ಸರ್ಪಮಂತ್ರಗಳನ್ನೂ ಮಾಟವನ್ನೂ ಮಾಡಿದನು. ಕಣಿಹೇಳುವವರನ್ನೂ, ಮಾಂತ್ರಿಕರನ್ನೂ ವಿಚಾರಿಸಿದನು. ಯೆಹೋವ ದೇವರ ದೃಷ್ಟಿಯಲ್ಲಿ ಅತ್ಯಂತ ಕೆಟ್ಟತನವನ್ನು ಮಾಡಿ ಅವರಿಗೆ ಕೋಪವನ್ನು ಎಬ್ಬಿಸಿದನು.<verse eid="2CH 33:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="2CH 33:7"/>ಮನಸ್ಸೆಯು ತಾನು ಮಾಡಿದ ವಿಗ್ರಹವನ್ನು ದೇವರ ಆಲಯದಲ್ಲಿ ಇಟ್ಟನು. ಆ ಆಲಯದ ಬಗ್ಗೆ ದೇವರು ದಾವೀದನಿಗೂ ಅವನ ಮಗನಾದ ಸೊಲೊಮೋನನಿಗೂ ಹೇಳಿದ್ದೇನೆಂದರೆ, “ನಾನು ಈ ಆಲಯದಲ್ಲಿ ಮತ್ತು ಇಸ್ರಾಯೇಲಿನ ಸಕಲ ಗೋತ್ರಗಳಲ್ಲಿ ನಾನು ಆಯ್ದುಕೊಂಡ ಯೆರೂಸಲೇಮಿನಲ್ಲಿ ನನ್ನ ನಾಮವನ್ನು ಶಾಶ್ವತವಾಗಿ ಸ್ಥಾಪಿಸುತ್ತೇನೆ. <verse eid="2CH 33:7"/><verse number="8" style="v" sid="2CH 33:8"/>ನಾನು ಮೋಶೆಯ ಮುಖಾಂತರ ಆಜ್ಞಾಪಿಸಿದ ಎಲ್ಲಾ ಅಪ್ಪಣೆಗಳನ್ನೂ, ಕಾನೂನುಗಳನ್ನೂ, ವಿಧಿಗಳನ್ನೂ ಕೈಗೊಂಡು ನಡೆಯುವುದರಲ್ಲಿ ಅವರು ಜಾಗರೂಕರಾಗಿದ್ದರೆ, ನಾನು ಅವರ ಪಿತೃಗಳಿಗೆ ನೇಮಕ ಮಾಡಿದ ದೇಶವನ್ನು ಪುನಃ ಇಸ್ರಾಯೇಲರು ಬಿಟ್ಟುಹೋಗುವಂತೆ ಮಾಡುವುದಿಲ್ಲ,” ಎಂದು ಹೇಳಿದ್ದರು. <verse eid="2CH 33:8"/><verse number="9" style="v" sid="2CH 33:9"/>ಆದರೆ ಯೆಹೂದದವರೂ ಯೆರೂಸಲೇಮಿನ ನಿವಾಸಿಗಳೂ ಇಸ್ರಾಯೇಲರ ಮುಂದೆಯೇ ಯೆಹೋವ ದೇವರಿಂದ ನಾಶಹೊಂದಿದ ಇತರ ಜನಾಂಗಗಳಿಗಿಂತ ಅಧಿಕವಾಗಿ ಕೆಟ್ಟದ್ದನ್ನು ಮಾಡಲು ಮನಸ್ಸೆಯು ಅವರನ್ನು ಪ್ರೇರೇಪಿಸಿದನು.<verse eid="2CH 33:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="2CH 33:10"/>ಯೆಹೋವ ದೇವರು ಮನಸ್ಸೆಯೊಂದಿಗೂ, ಅವನ ಜನರೊಂದಿಗೂ ಮಾತನಾಡಿದರು. ಆದರೆ ಅವರು ಲಕ್ಷಿಸಲಿಲ್ಲ. <verse eid="2CH 33:10"/><verse number="11" style="v" sid="2CH 33:11"/>ಆದಕಾರಣ ಯೆಹೋವ ದೇವರು ಅಸ್ಸೀರಿಯದ ಅರಸನ ಸೈನ್ಯದ ಅಧಿಪತಿಗಳನ್ನೂ ಅವನ ಮೇಲೆ ಬರಮಾಡಿದರು. ಆ ಅಧಿಪತಿಗಳು ಮನಸ್ಸೆಯ ಮೂಗಿಗೆ ಕೊಂಡಿಗಳನ್ನು ಹಾಕಿ, ಅವನಿಗೆ ಕಂಚಿನ ಸಂಕೋಲೆಗಳಿಂದ ಬಂಧಿಸಿ, ಅವನನ್ನು ಬಾಬಿಲೋನಿಗೆ ಒಯ್ದರು. <verse eid="2CH 33:11"/><verse number="12" style="v" sid="2CH 33:12"/>ಮನಸ್ಸೆಯು ಬಾಧೆಯಲ್ಲಿರುವಾಗ ತನ್ನ ದೇವರಾದ ಯೆಹೋವ ದೇವರನ್ನು ಬೇಡಿಕೊಂಡನು ಮತ್ತು ತನ್ನ ಪಿತೃಗಳ ದೇವರ ಮುಂದೆ ತನ್ನನ್ನು ಬಹಳವಾಗಿ ತಗ್ಗಿಸಿಕೊಂಡು ಪ್ರಾರ್ಥನೆಮಾಡಿದನು. <verse eid="2CH 33:12"/><verse number="13" style="v" sid="2CH 33:13"/>ಆಗ ಯೆಹೋವ ದೇವರು ಕನಿಕರಪಟ್ಟು, ಅವನ ಬಿನ್ನಹವನ್ನು ಕೇಳಿ, ಯೆರೂಸಲೇಮಿಗೆ ತನ್ನ ರಾಜ್ಯಕ್ಕೆ ಅವನನ್ನು ತಿರುಗಿ ಬರಮಾಡಿದರು. ಆಗ ಯೆಹೋವ ದೇವರೇ ದೇವರೆಂದು ಮನಸ್ಸೆಯು ತಿಳಿದುಕೊಂಡನು.<verse eid="2CH 33:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="2CH 33:14"/>ಇದಾದ ತರುವಾಯ ಮನಸ್ಸೆಯು ದಾವೀದನ ಪಟ್ಟಣದ ಹೊರಭಾಗದಲ್ಲಿ ಗೀಹೋನಿನ ಪಶ್ಚಿಮ ಕಡೆಯ ತಗ್ಗಿನಲ್ಲಿ ಮೀನು ಬಾಗಿಲ ದ್ವಾರದವರೆಗಿರುವ ತಗ್ಗಿನಲ್ಲಿ ಓಫೇಲ್ ಗುಡ್ಡದ ಸುತ್ತಲೂ ಗೋಡೆಯನ್ನು ಕಟ್ಟಿಸಿ, ಅದನ್ನು ಬಹಳ ಎತ್ತರಮಾಡಿ, ಯೆಹೂದದ ಸಮಸ್ತ ಕೋಟೆಯುಳ್ಳ ಪಟ್ಟಣಗಳಲ್ಲಿ ಸೈನ್ಯದ ಅಧಿಪತಿಗಳನ್ನು ಇಟ್ಟನು.<verse eid="2CH 33:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="2CH 33:15"/>ಅವನು ಅನ್ಯದೇವರುಗಳನ್ನೂ, ಯೆಹೋವ ದೇವರ ಆಲಯದಲ್ಲಿರುವ ವಿಗ್ರಹವನ್ನೂ ಯೆಹೋವ ದೇವರ ಆಲಯದ ಪರ್ವತದಲ್ಲಿಯೂ, ಯೆರೂಸಲೇಮಿನಲ್ಲಿಯೂ ತಾನು ಕಟ್ಟಿಸಿದ ಸಮಸ್ತ ಬಲಿಪೀಠಗಳನ್ನೂ ತೆಗೆದುಹಾಕಿ, ಅವುಗಳನ್ನು ಪಟ್ಟಣದ ಹೊರಗೆ ಬಿಸಾಡಿ ಬಿಟ್ಟನು. <verse eid="2CH 33:15"/><verse number="16" style="v" sid="2CH 33:16"/>ಅವನು ಯೆಹೋವ ದೇವರ ಬಲಿಪೀಠವನ್ನು ಕಟ್ಟಿಸಿ, ಅದರ ಮೇಲೆ ಸಮಾಧಾನದ ಬಲಿಗಳನ್ನೂ, ಸ್ತೋತ್ರದ ಬಲಿಗಳನ್ನೂ ಅರ್ಪಿಸಿ, ಇಸ್ರಾಯೇಲಿನ ದೇವರಾದ ಯೆಹೋವ ದೇವರನ್ನು ಸೇವಿಸಲು ಯೆಹೂದದವರಿಗೆ ಆಜ್ಞಾಪಿಸಿದನು. <verse eid="2CH 33:16"/><verse number="17" style="v" sid="2CH 33:17"/>ಜನರು ತಮ್ಮ ದೇವರಾದ ಯೆಹೋವ ದೇವರಿಗೆ ಮಾತ್ರ ಬಲಿಯನ್ನರ್ಪಿಸುವಾಗ, ಇನ್ನೂ ಉನ್ನತ ಸ್ಥಳಗಳಲ್ಲಿಯೇ ಬಲಿಯನ್ನು ಅರ್ಪಿಸುತ್ತಾ ಇದ್ದರು.<verse eid="2CH 33:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="2CH 33:18"/>ಮನಸ್ಸೆಯ ಇತರ ಕ್ರಿಯೆಗಳೂ, ಅವನು ತನ್ನ ದೇವರಿಗೆ ಮಾಡಿದ ಪ್ರಾರ್ಥನೆಯೂ, ಇಸ್ರಾಯೇಲಿನ ದೇವರಾದ ಯೆಹೋವ ದೇವರ ನಾಮದಲ್ಲಿ ಅವನ ಸಂಗಡ ಮಾತನಾಡಿದ ಪ್ರವಾದಿಗಳ ಮಾತುಗಳೂ, ಇಸ್ರಾಯೇಲಿನ ಅರಸರ ಇತಿಹಾಸಗಳ ಪುಸ್ತಕದಲ್ಲಿ ಬರೆದಿರುತ್ತವೆ. <verse eid="2CH 33:18"/><verse number="19" style="v" sid="2CH 33:19"/>ಇದಲ್ಲದೆ ಅವನ ಪ್ರಾರ್ಥನೆಯೂ, ಅವನು ದೇವರಿಗೆ ಭಿನ್ನವಿಸಿದ್ದೂ, ಅವನ ಸಮಸ್ತ ಪಾಪವೂ, ಅವನ ಅಪನಂಬಿಕೆಯೂ, ಅವನು ತಗ್ಗಿಸಿಕೊಳ್ಳುವುದಕ್ಕಿಂತ ಮುಂಚೆ ಕಟ್ಟಿಸಿದ ಉನ್ನತ ಸ್ಥಳಗಳನ್ನೂ, ನಿಲ್ಲಿಸಿದ ಅಶೇರ ಸ್ತಂಭಗಳೂ, ಕೆತ್ತಿಸಿದ ವಿಗ್ರಹಗಳೂ, ಸ್ಥಾಪಿಸಿದ ಸ್ಥಳಗಳೂ ಪ್ರವಾದಿಗಳ ದಾಖಲೆಗಳಲ್ಲಿ ಬರೆದಿರುತ್ತವೆ. <verse eid="2CH 33:19"/><verse number="20" style="v" sid="2CH 33:20"/>ಮನಸ್ಸೆಯು ಮೃತನಾಗಿ ತನ್ನ ಪಿತೃಗಳ ಬಳಿಗೆ ಸೇರಿದನು. ಅವನನ್ನು ಅವನ ಅರಮನೆಯಲ್ಲಿ ಹೂಳಿಟ್ಟರು. ಅವನ ಮಗ ಆಮೋನನು ಅವನಿಗೆ ಬದಲಾಗಿ ಅರಸನಾದನು.<verse eid="2CH 33:20"/></para>
  <para style="s1">ಯೆಹೂದ ಪ್ರಾಂತದ ಅರಸನಾದ ಆಮೋನನು</para>
  <para style="p">
    <verse number="21" style="v" sid="2CH 33:21"/>ಆಮೋನನು ಅರಸನಾದಾಗ ಇಪ್ಪತ್ತೆರಡು ವರ್ಷದವನಾಗಿದ್ದನು, ಅವನು ಯೆರೂಸಲೇಮಿನಲ್ಲಿ ಎರಡು ವರ್ಷ ಆಳಿದನು. <verse eid="2CH 33:21"/><verse number="22" style="v" sid="2CH 33:22"/>ಆದರೆ ಅವನು ತನ್ನ ತಂದೆ ಮನಸ್ಸೆಯು ಮಾಡಿದ ಹಾಗೆ ಯೆಹೋವ ದೇವರ ದೃಷ್ಟಿಯಲ್ಲಿ ಕೆಟ್ಟದ್ದನ್ನೇ ಮಾಡಿದನು. ಆಮೋನನು ತನ್ನ ತಂದೆ ಮನಸ್ಸೆಯು ಮಾಡಿದ ಕೆತ್ತಿದ ವಿಗ್ರಹಗಳಿಗೆ ಬಲಿಗಳನ್ನು ಅರ್ಪಿಸಿ ಅವುಗಳನ್ನು ಪೂಜಿಸಿದನು. <verse eid="2CH 33:22"/><verse number="23" style="v" sid="2CH 33:23"/>ಆಮೋನನು ತನ್ನ ತಂದೆ ಮನಸ್ಸೆಯು ತನ್ನನ್ನು ತಗ್ಗಿಸಿಕೊಂಡ ಹಾಗೆ, ಯೆಹೋವ ದೇವರ ಮುಂದೆ ತನ್ನನ್ನು ತಗ್ಗಿಸಿಕೊಳ್ಳಲಿಲ್ಲ. ಆದರೆ ಆಮೋನನು ಅಧಿಕವಾಗಿ ಅಪರಾಧ ಮಾಡಿದನು.<verse eid="2CH 33:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="2CH 33:24"/>ಆದ್ದರಿಂದ ಆಮೋನನ ಸೇವಕರು ಅವನ ವಿರುದ್ಧ ಒಳಸಂಚುಮಾಡಿ, ಅವನ ಅರಮನೆಯಲ್ಲಿಯೇ ಅವನನ್ನು ಕೊಂದುಹಾಕಿದರು. <verse eid="2CH 33:24"/><verse number="25" style="v" sid="2CH 33:25"/>ಆದರೆ ದೇಶದ ಜನರು ಅರಸನಾದ ಆಮೋನನ ವಿರುದ್ಧ ಒಳಸಂಚು ಮಾಡಿದವರನ್ನೆಲ್ಲಾ ಕೊಂದುಹಾಕಿ, ದೇಶದ ಜನರು ಅವನ ಮಗ ಯೋಷೀಯನನ್ನು ಅವನಿಗೆ ಬದಲಾಗಿ ಅರಸನನ್ನಾಗಿ ಮಾಡಿದರು.<verse eid="2CH 33:25"/></para>
  <chapter eid="2CH 33"/>
  <chapter number="34" style="c" sid="2CH 34"/>
  <para style="s1">ಯೋಷೀಯನ ಪುನಃಸ್ಥಾಪನೆ</para>
  <para style="p">
    <verse number="1" style="v" sid="2CH 34:1"/>ಯೋಷೀಯನು ಅರಸನಾದಾಗ ಎಂಟು ವರ್ಷದವನಾಗಿದ್ದನು, ಅವನು ಮೂವತ್ತೊಂದು ವರ್ಷ ಯೆರೂಸಲೇಮಿನಲ್ಲಿ ಆಳಿದನು. <verse eid="2CH 34:1"/><verse number="2" style="v" sid="2CH 34:2"/>ಅವನು ಯೆಹೋವ ದೇವರ ದೃಷ್ಟಿಗೆ ಒಳ್ಳೆಯದನ್ನು ಮಾಡಿ, ಎಡಕ್ಕಾಗಲಿ ಬಲಕ್ಕಾಗಲಿ ತಿರುಗದೆ ತನ್ನ ಪೂರ್ವಜನಾದ ದಾವೀದನ ಮಾರ್ಗಗಳಲ್ಲಿಯೇ ನಡೆದನು.<verse eid="2CH 34:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="2CH 34:3"/>ಅವನು ಇನ್ನೂ ಬಾಲಕನಾಗಿರುವಾಗ, ತನ್ನ ಆಳ್ವಿಕೆಯ ಎಂಟನೆಯ ವರ್ಷದಲ್ಲಿ ತನ್ನ ಪೂರ್ವಜನಾದ ದಾವೀದನ ದೇವರನ್ನು ಹುಡುಕಲು ಆರಂಭಿಸಿದನು. ಅವನ ಆಳ್ವಿಕೆಯ ಹನ್ನೆರಡನೆಯ ವರ್ಷದಲ್ಲಿ ಉನ್ನತ ಪೂಜಾಸ್ಥಳಗಳನ್ನೂ, ಅಶೇರ ಸ್ತಂಭಗಳನ್ನೂ, ಕೆತ್ತಿದ ವಿಗ್ರಹಗಳನ್ನೂ ತೆಗೆದುಹಾಕಿ, ಯೆಹೂದ ಮತ್ತು ಯೆರೂಸಲೇಮನ್ನು ಶುಚಿಮಾಡಲು ಆರಂಭಿಸಿದನು. <verse eid="2CH 34:3"/><verse number="4" style="v" sid="2CH 34:4"/>ಅವರು ಬಾಳನ ಬಲಿಪೀಠಗಳನ್ನು ಅವನ ಸಮ್ಮುಖದಿಂದ ಕೆಡವಿಹಾಕಿದರು. ಅವುಗಳ ಮೇಲಿರುವ ಸೂರ್ಯ ಸ್ತಂಭಗಳನ್ನು ಕಡಿದುಹಾಕಿ; ಅಶೇರ ಸ್ತಂಭಗಳನ್ನೂ, ಕೆತ್ತಿದ ವಿಗ್ರಹಗಳನ್ನೂ, ಎರಕ ಹೊಯ್ದ ವಿಗ್ರಹಗಳನ್ನೂ ಒಡೆದುಬಿಟ್ಟು ಪುಡಿಪುಡಿಮಾಡಿ, ಅವುಗಳಿಗೆ ಬಲಿ ಅರ್ಪಿಸಿದವರ ಸಮಾಧಿಗಳ ಮೇಲೆ ಚಿಲ್ಲಿಸಿ, <verse eid="2CH 34:4"/><verse number="5" style="v" sid="2CH 34:5"/>ಪೂಜಾರಿಗಳ ಎಲುಬುಗಳನ್ನು ಅವರ ಬಲಿಪೀಠಗಳ ಮೇಲೆ ಸುಟ್ಟುಬಿಟ್ಟು; ಯೆಹೂದ ಪ್ರಾಂತ್ಯವನ್ನೂ, ಯೆರೂಸಲೇಮ ಪಟ್ಟಣವನ್ನೂ ಶುಚಿಮಾಡಿದರು. <verse eid="2CH 34:5"/><verse number="6" style="v" sid="2CH 34:6"/>ಹೀಗೆಯೇ ಅವರು ತಮ್ಮ ಗುದ್ದಲಿಗಳಿಂದ ಮನಸ್ಸೆ, ಎಫ್ರಾಯೀಮ್, ಸಿಮೆಯೋನ್, ನಫ್ತಾಲಿ ಪ್ರಾಂತ್ಯಗಳ ಪಟ್ಟಣಗಳ ಸುತ್ತಲೂ ಶುಚಿಮಾಡಿದರು. <verse eid="2CH 34:6"/><verse number="7" style="v" sid="2CH 34:7"/>ಅವನು ಬಲಿಪೀಠಗಳನ್ನೂ, ಅಶೇರ ಸ್ತಂಭಗಳನ್ನೂ ಕೆಡವಿಹಾಕಿ, ಕೆತ್ತಿದ ವಿಗ್ರಹಗಳನ್ನು ಕುಟ್ಟಿ ಪುಡಿಪುಡಿಮಾಡಿ, ಇಸ್ರಾಯೇಲ್ ದೇಶದಲ್ಲೆಲ್ಲಿಯೂ ಇರುವ ಸಮಸ್ತ ವಿಗ್ರಹಗಳನ್ನು ಕೆಡವಿದ ತರುವಾಯ ಯೆರೂಸಲೇಮಿಗೆ ಹಿಂದಿರುಗಿದನು.<verse eid="2CH 34:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="2CH 34:8"/>ಯೋಷೀಯನ ಆಳ್ವಿಕೆಯ ಹದಿನೆಂಟನೆಯ ವರ್ಷದಲ್ಲಿ, ಅವನು ದೇಶವನ್ನೂ, ಆಲಯವನ್ನೂ ಶುಚಿ ಮಾಡಿದ ತರುವಾಯ ತನ್ನ ದೇವರಾದ ಯೆಹೋವ ದೇವರ ಆಲಯವನ್ನು ದುರಸ್ತಿ ಮಾಡುವುದಕ್ಕೆ ಅಚಲ್ಯನ ಮಗನಾದ ಶಾಫಾನನನ್ನೂ, ಪಟ್ಟಣದ ಅಧಿಪತಿಯಾದ ಮಾಸೇಯನನ್ನೂ, ರಾಜಲೇಖಕನಾಗಿದ್ದ ಯೋವಾಹಾಜನ ಮಗನಾದ ಯೋವಾಹನನ್ನೂ ಕಳುಹಿಸಿದನು.<verse eid="2CH 34:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="2CH 34:9"/>ಇವರು ದ್ವಾರಪಾಲಕರಾದ ಲೇವಿಯರು ಮನಸ್ಸೆ, ಎಫ್ರಾಯೀಮ್ ಜನರಿಂದಲೂ, ಇಸ್ರಾಯೇಲಿನ ಉಳಿದವರಿಂದಲೂ, ಯೆಹೂದ ಬೆನ್ಯಾಮೀನರಿಂದಲೂ ಯೆರೂಸಲೇಮಿನ ಎಲ್ಲಾ ನಿವಾಸಿಗಳಿಂದಲೂ ಕೂಡಿಸಿದ ಹಣವನ್ನು ತೆಗೆದುಕೊಂಡು ದೇವರ ಆಲಯಕ್ಕೆ ತಂದು ಮಹಾಯಾಜಕನಾದ ಹಿಲ್ಕೀಯನಿಗೆ ಕೊಟ್ಟರು. <verse eid="2CH 34:9"/><verse number="10" style="v" sid="2CH 34:10"/>ಯೆಹೋವ ದೇವರ ಆಲಯದ ಕೆಲಸಕ್ಕೆ ನೇಮಕಗೊಂಡ ಮೇಲ್ವಿಚಾರಕರ ಕೈಯಲ್ಲಿ ಅದನ್ನು ಒಪ್ಪಿಸಿದರು. ಇವರು ಯೆಹೋವ ದೇವರ ಆಲಯವನ್ನು ಭದ್ರಮಾಡಿ, ದುರಸ್ತಿ ಮಾಡುವವರಿಗೆ ಅದನ್ನು ಕೊಟ್ಟರು. <verse eid="2CH 34:10"/><verse number="11" style="v" sid="2CH 34:11"/>ಕೆತ್ತಿದ ಕಲ್ಲುಗಳನ್ನೂ, ತೊಲೆಗಳಿಗೋಸ್ಕರ ಮರಗಳನ್ನೂ, ಯೆಹೂದದ ಅರಸರ ಅಲಕ್ಷ್ಯದಿಂದ ಹಾಳಾಗಿದ್ದ ಕಟ್ಟಡಗಳಿಗೆ ಹಲಿಗೆಗಳನ್ನು ಕೊಂಡುಕೊಳ್ಳಲೂ, ಬಡಗಿಯರಿಗೂ, ಕಲ್ಲುಕೆಲಸದವರಿಗೂ ಆ ಹಣವನ್ನು ಕೊಟ್ಟರು.<verse eid="2CH 34:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="2CH 34:12"/>ಈ ಮನುಷ್ಯರು ಕೆಲಸವನ್ನು ನಂಬಿಕೆಯಿಂದ ಮಾಡಿದರು. ಅವರ ವಿಚಾರಣೆಯ ಮೇಲ್ವಿಚಾರಕರು ಯಾರೆಂದರೆ ಮೆರಾರೀಯ ಪುತ್ರರಲ್ಲಿ ಲೇವಿಯರಾದ ಯಹಾತನೂ, ಓಬದ್ಯನೂ; ಕೊಹಾತ್ಯರ ಮಕ್ಕಳಲ್ಲಿ ಜೆಕರ್ಯನೂ, ಮೆಷುಲ್ಲಾಮನೂ; ಗೀತವಾದ್ಯಗಳಲ್ಲಿ ಬುದ್ಧಿಯುಳ್ಳವರಾದ ಲೇವಿಯರೆಲ್ಲರೂ ಅದನ್ನು ನಡೆಸುತ್ತಾ ಇದ್ದರು. <verse eid="2CH 34:12"/><verse number="13" style="v" sid="2CH 34:13"/>ಇದಲ್ಲದೆ ಕಾರ್ಮಿಕರ ಮೇಲೆಯೂ, ಬೇರೆ ಬೇರೆ ಸೇವೆಯ ಕೆಲಸವನ್ನು ಮಾಡುವವರ ಮೇಲೆಯೂ ಅವರು ಮೇಲ್ವಿಚಾರಕರಾಗಿದ್ದರು. ಲೇವಿಯರಲ್ಲಿ ಕೆಲವರು ಕಾರ್ಯದರ್ಶಿಗಳೂ, ಬರಹಗಾರರೂ, ದ್ವಾರಪಾಲಕರೂ ಆಗಿದ್ದರು.<verse eid="2CH 34:13"/></para>
  <para style="s1">ದೇವರ ನಿಯಮದ ಗ್ರಂಥವನ್ನು ಕಂಡುಕೊಂಡದ್ದು</para>
  <para style="p">
    <verse number="14" style="v" sid="2CH 34:14"/>ಯೆಹೋವ ದೇವರ ಆಲಯಕ್ಕೆ ತಂದ ಹಣವನ್ನು ಅವರು ಹೊರಗೆ ತೆಗೆದುಕೊಂಡು ಬರುವಾಗ, ಯಾಜಕನಾದ ಹಿಲ್ಕೀಯನು ಮೋಶೆಯ ಕೈಯಿಂದಾದ ಯೆಹೋವ ದೇವರ ನಿಯಮದ ಗ್ರಂಥವನ್ನು ಕಂಡುಕೊಂಡನು. <verse eid="2CH 34:14"/><verse number="15" style="v" sid="2CH 34:15"/>ಆಗ ಹಿಲ್ಕೀಯನು ಉತ್ತರಕೊಟ್ಟು ಕಾರ್ಯದರ್ಶಿಯಾದ ಶಾಫಾನನಿಗೆ, “ಯೆಹೋವ ದೇವರ ಆಲಯದಲ್ಲಿ ನಿಯಮ ಗ್ರಂಥವು ನನಗೆ ಸಿಕ್ಕಿತು,” ಎಂದು ಹೇಳಿದನು. ಹಿಲ್ಕೀಯನು ಆ ಗ್ರಂಥವನ್ನು ಶಾಫಾನನಿಗೆ ಒಪ್ಪಿಸಿದನು.<verse eid="2CH 34:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="2CH 34:16"/>ಶಾಫಾನನು ಆ ಗ್ರಂಥವನ್ನು ಅರಸನ ಬಳಿಗೆ ತೆಗೆದುಕೊಂಡುಹೋಗಿ, ಅರಸನಿಗೆ ಈ ಮಾತನ್ನು ತಿರುಗಿ ಹೇಳಿದನು. “ನಿನ್ನ ಸೇವಕರ ಕೈಗೆ ಒಪ್ಪಿಸಿದ್ದನ್ನೆಲ್ಲಾ ಅವರು ಮಾಡುತ್ತಿದ್ದಾರೆ. <verse eid="2CH 34:16"/><verse number="17" style="v" sid="2CH 34:17"/>ಇದಲ್ಲದೆ ಅವರು ಯೆಹೋವ ದೇವರ ಆಲಯದಲ್ಲಿ ದೊರಕಿದ ಹಣವನ್ನು ತೆಗೆದು ಮೇಲ್ವಿಚಾರಕರ ಕೈಯಲ್ಲಿ ಮತ್ತು ಕೆಲಸದವರ ಕೈಯಲ್ಲಿ ಒಪ್ಪಿಸಿದ್ದಾರೆ. <verse eid="2CH 34:17"/><verse number="18" style="v" sid="2CH 34:18"/>ಕಾರ್ಯದರ್ಶಿಯಾದ ಶಾಫಾನನು ಅರಸನಿಗೆ ಯಾಜಕನಾದ ಹಿಲ್ಕೀಯನು ನನಗೆ ಗ್ರಂಥವನ್ನು ಕೊಟ್ಟಿದ್ದಾನೆ,” ಎಂದು ತಿಳಿಸಿದನು. ಆಗ ಶಾಫಾನನು ಅದನ್ನು ಅರಸನ ಮುಂದೆ ಓದಿದನು.<verse eid="2CH 34:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="2CH 34:19"/>ಅರಸನು ದೇವರ ನಿಯಮದ ವಾಕ್ಯಗಳನ್ನು ಕೇಳಿದಾಗ, ತನ್ನ ವಸ್ತ್ರಗಳನ್ನು ಹರಿದುಕೊಂಡನು. <verse eid="2CH 34:19"/><verse number="20" style="v" sid="2CH 34:20"/>ಹಿಲ್ಕೀಯನಿಗೂ, ಶಾಫಾನನ ಮಗನಾದ ಅಹೀಕಾಮನಿಗೂ, ಮೀಕನ ಮಗನಾದ ಅಬ್ದೋನನಿಗೂ, ಕಾರ್ಯದರ್ಶಿಯಾದ ಶಾಫಾನನಿಗೂ, ಅರಸನ ಸೇವಕನಾದ ಅಸಾಯನಿಗೂ ಆಜ್ಞಾಪಿಸಿ, <verse eid="2CH 34:20"/><verse number="21" style="v" sid="2CH 34:21"/>“ನೀವು ಹೋಗಿ ಸಿಕ್ಕಿದ ಈ ಗ್ರಂಥದ ವಾಕ್ಯಗಳ ಕುರಿತು ನನಗೋಸ್ಕರವೂ, ಇಸ್ರಾಯೇಲ್ ಮತ್ತು ಯೆಹೂದದಲ್ಲಿ ಉಳಿದವರಿಗೋಸ್ಕರವೂ ಯೆಹೋವ ದೇವರ ಬಳಿಯಲ್ಲಿ ವಿಚಾರಿಸಿರಿ. ಏಕೆಂದರೆ ನಮ್ಮನ್ನು ಕುರಿತು ಬರೆದಿರುವ ಎಲ್ಲವನ್ನೂ ಕೈಗೊಂಡು ನಡೆಯಲು ನಮ್ಮ ಪಿತೃಗಳು ಈ ಗ್ರಂಥದ ಮಾತುಗಳನ್ನು ಕೇಳದೆ ಹೋದುದರಿಂದ, ನಮ್ಮ ಮೇಲೆ ಸುರಿದ ಯೆಹೋವ ದೇವರ ಕೋಪವು ದೊಡ್ಡದಾಗಿದೆ,” ಎಂದು ಹೇಳಿದನು.<verse eid="2CH 34:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="2CH 34:22"/>ಆಗ ಹಿಲ್ಕೀಯನೂ ಅರಸನ ಜನರೂ ಹಸ್ರನ ಮಗನೂ ತೊಕ್ಹತನ ಮಗನೂ ಪ್ರವಾದಿನಿ ಹುಲ್ದಳ ಬಳಿಗೆ ಹೋಗಿ ವಿಚಾರಿಸಿದರು. ಆಕೆಯು ರಾಜವಸ್ತ್ರಗಳ ಮೇಲ್ವಿಚಾರಕನೂ ಆದ ಶಲ್ಲೂಮನ ಹೆಂಡತಿ, ಅವಳು ಯೆರೂಸಲೇಮಿನೊಳಗೆ ಹೊಸದಾದ ನಿರ್ಮಿತ ಭಾಗದಲ್ಲಿ ವಾಸವಾಗಿದ್ದಳು.<verse eid="2CH 34:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="2CH 34:23"/>ಹುಲ್ದಳು ಅವರಿಗೆ, “ನಿಮ್ಮನ್ನು ನನ್ನ ಬಳಿಗೆ ಕಳುಹಿಸಿದವನಿಗೆ ನೀವು ಇಸ್ರಾಯೇಲ್ ದೇವರಾದ ಯೆಹೋವ ದೇವರ ಮಾತುಗಳನ್ನು ತಿಳಿಸಿರಿ: <verse eid="2CH 34:23"/><verse number="24" style="v" sid="2CH 34:24"/>‘ನಾನು ಈ ಸ್ಥಳದ ಮೇಲೆಯೂ ಅದರ ನಿವಾಸಿಗಳ ಮೇಲೆಯೂ ಕೇಡನ್ನೂ, ಯೆಹೂದದ ಅರಸನ ಮುಂದೆ ಅವರು ಓದಿದ ಗ್ರಂಥದಲ್ಲಿ ಬರೆದಿರುವ ಎಲ್ಲಾ ಶಾಪಗಳನ್ನೂ ಬರಮಾಡುವೆನು. <verse eid="2CH 34:24"/><verse number="25" style="v" sid="2CH 34:25"/>ಏಕೆಂದರೆ ಅವರು ನನ್ನನ್ನು ಬಿಟ್ಟುಬಿಟ್ಟು, ತಮ್ಮ ಸಮಸ್ತ ಕ್ರಿಯೆಗಳಿಂದ ನನಗೆ ಕೋಪವನ್ನು ಎಬ್ಬಿಸುವಂತೆ ಇತರ ದೇವರುಗಳಿಗೆ ಧೂಪವನ್ನು ಸುಟ್ಟಿದ್ದಾರೆ. ಆದ್ದರಿಂದ ನನ್ನ ಕೋಪವು ಈ ಸ್ಥಳದ ಮೇಲೆ ಸುರಿಯುವುದು, ಅದು ಆರಿಹೋಗುವುದಿಲ್ಲ.’ <verse eid="2CH 34:25"/><verse number="26" style="v" sid="2CH 34:26"/>ಆದರೆ ಯೆಹೋವ ದೇವರನ್ನು ವಿಚಾರಿಸಲು ನಿಮ್ಮನ್ನು ಕಳುಹಿಸಿದ ಯೆಹೂದದ ಅರಸನಿಗೆ ನೀವು ಹೇಳಬೇಕಾದದ್ದು ಇದೇ, ‘ನೀವು ಕೇಳಿದ ಮಾತುಗಳನ್ನು ಕುರಿತು ಇಸ್ರಾಯೇಲಿನ ದೇವರಾದ ಯೆಹೋವ ದೇವರು ಹೇಳುವುದೇನೆಂದರೆ, <verse eid="2CH 34:26"/><verse number="27" style="v" sid="2CH 34:27"/>ಈ ಸ್ಥಳಕ್ಕೆ ವಿರೋಧವಾಗಿಯೂ ಅದರ ನಿವಾಸಿಗಳ ವಿರೋಧವಾಗಿಯೂ ದೇವರು ಹೇಳಿದ ಮಾತುಗಳನ್ನು ನೀನು ಕೇಳಿದಾಗ, ನಿನ್ನ ಹೃದಯವು ಮೃದುವಾಗಿ, ನಿನ್ನನ್ನು ನನ್ನ ಮುಂದೆ ತಗ್ಗಿಸಿಕೊಂಡೆ. ನಿನ್ನ ವಸ್ತ್ರಗಳನ್ನು ಹರಿದುಕೊಂಡು ನನ್ನ ಸಮ್ಮುಖದಲ್ಲಿ ಕಣ್ಣೀರು ಸುರಿಸಿದ್ದರಿಂದ, ನಾನು ನಿನ್ನ ಮೊರೆಯನ್ನು ಕೇಳಿದೆನು, <verse eid="2CH 34:27"/><verse number="28" style="v" sid="2CH 34:28"/>ಆದ್ದರಿಂದ ನಾನು ನಿನ್ನನ್ನು ನಿನ್ನ ಪಿತೃಗಳ ಬಳಿಯಲ್ಲಿ ಸೇರಿಸಿಕೊಳ್ಳುವೆನು. ನೀನು ಸಮಾಧಾನದಿಂದ ನಿನ್ನ ಸಮಾಧಿಗೆ ಸೇರುವೆ. ನಾನು ಈ ಸ್ಥಳದ ಮೇಲೆಯೂ ಅದರ ನಿವಾಸಿಗಳ ಮೇಲೆಯೂ ಬರಮಾಡುವ ಕೇಡನ್ನು ನಿನ್ನ ಕಣ್ಣುಗಳು ಕಾಣುವುದಿಲ್ಲ,’ ಎಂದು ಯೆಹೋವ ದೇವರು ಹೇಳುತ್ತಾರೆ,” ಎಂದಳು.</para>
  <para style="p" vid="2CH 34:28">ಅವರು ಹೋಗಿ ಈ ಉತ್ತರವನ್ನು ಅರಸನಿಗೆ ತಿಳಿಸಿದರು.<verse eid="2CH 34:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="2CH 34:29"/>ಅನಂತರ ಅರಸನಾದ ಯೋಷೀಯನು ಯೆಹೂದದ, ಯೆರೂಸಲೇಮಿನ ಹಿರಿಯರೆಲ್ಲರನ್ನು ಕರೆಕಳುಹಿಸಿ ತನ್ನ ಬಳಿಯಲ್ಲಿ ಒಟ್ಟಾಗಿ ಕೂಡಿಸಿದನು. <verse eid="2CH 34:29"/><verse number="30" style="v" sid="2CH 34:30"/>ಆಗ ಅರಸನೂ ಅವನ ಸಂಗಡ ಯೆಹೂದದ ಜನರೂ, ಯೆರೂಸಲೇಮಿನ ನಿವಾಸಿಗಳೂ ಯಾಜಕರೂ ಲೇವಿಯರೂ ಹಿರಿಕಿರಿಯರಾದ ಸಮಸ್ತ ಜನರೂ ಯೆಹೋವ ದೇವರ ಆಲಯಕ್ಕೆ ಹೋದರು. ಅರಸನು ಯೆಹೋವ ದೇವರ ಆಲಯದಲ್ಲಿ ದೊರಕಿದ ಒಡಂಬಡಿಕೆಯ ಗ್ರಂಥದ ಮಾತುಗಳನ್ನೆಲ್ಲಾ ಅವರು ಕೇಳುವಂತೆ ಓದಿದನು. <verse eid="2CH 34:30"/><verse number="31" style="v" sid="2CH 34:31"/>ಅರಸನು ತನ್ನ ಸ್ತಂಭದಲ್ಲಿ ನಿಂತುಕೊಂಡು ಯೆಹೋವ ದೇವರನ್ನು ಹಿಂಬಾಲಿಸುವುದಕ್ಕೂ, ದೇವರ ಆಜ್ಞೆಗಳನ್ನೂ, ದೇವರ ಸಾಕ್ಷಿಗಳನ್ನೂ, ಕಟ್ಟಳೆಗಳನ್ನೂ ಪೂರ್ಣಹೃದಯದಿಂದಲೂ ಪೂರ್ಣಪ್ರಾಣದಿಂದಲೂ ಕೈಗೊಳ್ಳುವುದಕ್ಕೂ, ಈ ಗ್ರಂಥದಲ್ಲಿ ಬರೆದಿರುವ ಒಡಂಬಡಿಕೆಯ ವಾಕ್ಯಗಳನ್ನು ನೆರವೇರಿಸುವುದಕ್ಕೂ ಯೆಹೋವ ದೇವರ ಮುಂದೆ ಒಡಂಬಡಿಕೆಯನ್ನು ಮಾಡಿದನು.<verse eid="2CH 34:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="2CH 34:32"/>ಇದಲ್ಲದೆ ಅವನು ಯೆರೂಸಲೇಮಿನಲ್ಲಿಯೂ, ಬೆನ್ಯಾಮೀನಿನಲ್ಲಿಯೂ ಪ್ರತಿಯೊಬ್ಬರನ್ನು ಅದಕ್ಕೆ ಒಪ್ಪುವಂತೆ ಮಾಡಿದನು. ಹಾಗೆಯೇ ಯೆರೂಸಲೇಮಿನ ನಿವಾಸಿಗಳು ತಮ್ಮ ಪಿತೃಗಳ ದೇವರ ಒಡಂಬಡಿಕೆಯ ಪ್ರಕಾರ ಮಾಡಿದರು.<verse eid="2CH 34:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="2CH 34:33"/>ಹೀಗೆ ಯೋಷೀಯನು ಇಸ್ರಾಯೇಲರಿಗೆ ಇದ್ದ ಎಲ್ಲಾ ದೇಶಗಳೊಳಗಿಂದ ಸಮಸ್ತ ಅಸಹ್ಯಗಳನ್ನು ತೆಗೆದುಹಾಕಿ, ಇಸ್ರಾಯೇಲಿನಲ್ಲಿ ಸಿಕ್ಕಿದವರೆಲ್ಲರೂ ತಮ್ಮ ದೇವರಾದ ಯೆಹೋವ ದೇವರನ್ನು ಸೇವಿಸುವ ಹಾಗೆ ಮಾಡಿದನು. ಅವನ ದಿವಸಗಳೆಲ್ಲಾ ಅವರು ತಮ್ಮ ಪಿತೃಗಳ ದೇವರಾದ ಯೆಹೋವ ದೇವರನ್ನು ಹಿಂಬಾಲಿಸುವುದನ್ನು ಬಿಡದೆ ಇದ್ದರು.<verse eid="2CH 34:33"/></para>
  <chapter eid="2CH 34"/>
  <chapter number="35" style="c" sid="2CH 35"/>
  <para style="s1">ಯೋಷೀಯನು ಪಸ್ಕಹಬ್ಬವನ್ನು ಆಚರಿಸಿದ್ದು</para>
  <para style="p">
    <verse number="1" style="v" sid="2CH 35:1"/>ಯೋಷೀಯನು ಯೆರೂಸಲೇಮಿನಲ್ಲಿ ಯೆಹೋವ ದೇವರಿಗೆ ಪಸ್ಕವನ್ನು ಆಚರಿಸಿದನು. ಮೊದಲನೆಯ ತಿಂಗಳ ಹದಿನಾಲ್ಕನೆಯ ದಿವಸದಲ್ಲಿ ಪಸ್ಕದ ಕುರಿಮರಿಯನ್ನು ವಧಿಸಿದರು. <verse eid="2CH 35:1"/><verse number="2" style="v" sid="2CH 35:2"/>ಆಗ ಅವನು ಯಾಜಕರನ್ನು ಅವರವರ ಕೆಲಸಗಳಲ್ಲಿ ನಿಲ್ಲಿಸಿ; ಯೆಹೋವ ದೇವರ ಆಲಯದ ಸೇವೆ ಮಾಡುವುದಕ್ಕೆ ಅವರನ್ನು ಪ್ರೋತ್ಸಾಹಿಸಿದನು. <verse eid="2CH 35:2"/><verse number="3" style="v" sid="2CH 35:3"/>“ಸಮಸ್ತ ಇಸ್ರಾಯೇಲರಿಗೆ ಬೋಧಿಸಿದ ಮತ್ತು ಯೆಹೋವ ದೇವರಿಗೆ ಪ್ರತಿಷ್ಠಿತರಾದ ಲೇವಿಯರಿಗೆ ಪರಿಶುದ್ಧವಾದ ಮಂಜೂಷವು ನಿಮ್ಮ ಭುಜಗಳ ಮೇಲೆ ಭಾರವೆಂದೆಣಿಸದೇ, ನೀವು ಅದನ್ನು ಇಸ್ರಾಯೇಲಿನ ಅರಸನಾಗಿರುವ ದಾವೀದನ ಮಗ ಸೊಲೊಮೋನನು ಕಟ್ಟಿಸಿದ ಆಲಯದಲ್ಲಿ ಇರಿಸಿ, ನಿಮ್ಮ ದೇವರಾದ ಯೆಹೋವ ದೇವರನ್ನೂ, ದೇವಜನರಾದ ಇಸ್ರಾಯೇಲರನ್ನೂ ಸೇವಿಸಿರಿ. <verse eid="2CH 35:3"/><verse number="4" style="v" sid="2CH 35:4"/>ಇದಲ್ಲದೆ ಇಸ್ರಾಯೇಲಿನ ಅರಸನಾದ ದಾವೀದನ ಮತ್ತು ಅವನ ಮಗನಾದ ಸೊಲೊಮೋನನ ಬರಹದ ಪ್ರಕಾರವಾಗಿಯೂ, ನಿಮ್ಮ ಗೋತ್ರ ವರ್ಗಗಳ ಪ್ರಕಾರವಾಗಿಯೂ ಸಿದ್ಧಮಾಡಿಕೊಳ್ಳಿರಿ.<verse eid="2CH 35:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="2CH 35:5"/>“ಇದರ ಹೊರತಾಗಿ, ಪವಿತ್ರ ಸ್ಥಳಗಳು ಸಾಮಾನ್ಯ ಜನರ ಭಾಗಗಳಿಗೆ ಅನುಗುಣವಾಗಿ ನಿಲ್ಲಬೇಕು, ಲೇವಿಯರು ಕೂಡ ಕುಲಗಳ ಭಾಗಗಳಿಗೆ ಅನುಗುಣವಾಗಿ ನಿಲ್ಲಬೇಕು. <verse eid="2CH 35:5"/><verse number="6" style="v" sid="2CH 35:6"/>ಪಸ್ಕದ ಕುರಿಮರಿಯನ್ನು ವಧಿಸಿ ನಿಮ್ಮನ್ನು ಪ್ರತಿಷ್ಠೆ ಮಾಡಿಕೊಂಡು, ಯೆಹೋವ ದೇವರು ಮೋಶೆಯ ಮುಖಾಂತರವಾಗಿ ಹೇಳಿದ ವಾಕ್ಯದ ಪ್ರಕಾರ ನಿಮ್ಮ ಸಹೋದರರು ಮಾಡುವ ಹಾಗೆ ಅವರನ್ನು ಸಿದ್ಧಮಾಡಿರಿ,” ಎಂದನು.<verse eid="2CH 35:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="2CH 35:7"/>ಆಗ ಯೋಷೀಯನು ಸಿದ್ಧವಾಗಿದ್ದ ಸಮಸ್ತ ಸಾಮಾನ್ಯ ಜನರಿಗೆ ಪಸ್ಕದ ಆಡುಮರಿಗೋಸ್ಕರ ಮಂದೆಯಿಂದ ಮೂವತ್ತು ಸಾವಿರ ಕುರಿಮರಿಗಳನ್ನೂ, ಮೇಕೆಯ ಮರಿಗಳನ್ನೂ ಕೊಟ್ಟನು. ಇದಲ್ಲದೆ ಮೂರು ಸಾವಿರ ಎತ್ತುಗಳನ್ನೂ ಕೊಟ್ಟನು. ಇವೆಲ್ಲಾ ಅರಸನ ಸ್ವಂತ ಸೊತ್ತಿನಿಂದಲೇ ಕೊಟ್ಟನು.<verse eid="2CH 35:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="2CH 35:8"/>ಹಾಗೆಯೇ ಅವನ ಪ್ರಧಾನರು ಜನರಿಗೂ, ಯಾಜಕರಿಗೂ, ಲೇವಿಯರಿಗೂ ಮನಃಪೂರ್ವಕವಾಗಿ ಕೊಟ್ಟರು. ದೇವರ ಆಲಯದ ನಾಯಕರಾದ ಹಿಲ್ಕೀಯನೂ, ಜೆಕರ್ಯನೂ, ಯೆಹೀಯೇಲನೂ ಪಸ್ಕದ ಬಲಿಗೋಸ್ಕರ ಎರಡು ಸಾವಿರದ ಆರುನೂರು ಪಸ್ಕದ ಬಲಿಗಳನ್ನೂ, ಮುನ್ನೂರು ಎತ್ತುಗಳನ್ನೂ ಯಾಜಕರಿಗೆ ಕೊಟ್ಟರು. <verse eid="2CH 35:8"/><verse number="9" style="v" sid="2CH 35:9"/>ಇದಲ್ಲದೆ ಲೇವಿಯರಲ್ಲಿ ಪ್ರಧಾನರಾದ ಕೋನನ್ಯನೂ, ಅವನ ಸಹೋದರನಾದ ಶೆಮಾಯನೂ, ನೆತನೆಯೇಲನೂ, ಹಷಬ್ಯನೂ, ಯೆಹಿಯೇಲನೂ, ಯೋಜಾಬಾದನೂ ಪಸ್ಕದ ಬಲಿಗಳ ನಿಮಿತ್ತವಾಗಿ ಐದು ಸಾವಿರ ಪಸ್ಕದ ಬಲಿಗಳನ್ನೂ, ಐನೂರು ಎತ್ತುಗಳನ್ನೂ ಲೇವಿಯರಿಗೆ ಕೊಟ್ಟರು.<verse eid="2CH 35:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="2CH 35:10"/>ಹೀಗೆ ಅರಸನ ಆಜ್ಞೆಯ ಪ್ರಕಾರ ಸೇವೆಯನ್ನು ಸಿದ್ಧಮಾಡಲಾಯಿತು. ಯಾಜಕರು ತಮ್ಮ ತಮ್ಮ ಸ್ಥಳಗಳಲ್ಲಿಯೂ, ಲೇವಿಯರು ತಮ್ಮ ತಮ್ಮ ಸರತಿಗಳಲ್ಲಿಯೂ ನಿಂತಿದ್ದರು. <verse eid="2CH 35:10"/><verse number="11" style="v" sid="2CH 35:11"/>ಲೇವಿಯರು ಪಸ್ಕದ ಕುರಿಮರಿಯನ್ನು ವಧಿಸಿದ ತರುವಾಯ, ಯಾಜಕರು ಅವರ ಕೈಯಿಂದ ರಕ್ತವನ್ನು ತೆಗೆದುಕೊಂಡು ಚಿಮುಕಿಸಿದರು. ಆದರೆ ಲೇವಿಯರು ಚರ್ಮವನ್ನು ಸುಲಿದರು, <verse eid="2CH 35:11"/><verse number="12" style="v" sid="2CH 35:12"/>ಮೋಶೆಯ ಗ್ರಂಥದಲ್ಲಿ ಬರೆದಿರುವಂತೆ, ಜನರ ವಂಶಗಳ ಮನೆಗಳ ಪ್ರಕಾರ, ಯೆಹೋವ ದೇವರಿಗೆ ಅರ್ಪಿಸಲು ಅವರು ಕೊಡುವ ಹಾಗೆ ದಹನಬಲಿಗಳನ್ನು ತೆಗೆದು ಇಟ್ಟರು. ಹಾಗೆಯೇ ಎತ್ತುಗಳನ್ನು ತೆಗೆದಿಟ್ಟರು. <verse eid="2CH 35:12"/><verse number="13" style="v" sid="2CH 35:13"/>ಹೀಗೆ ಕಟ್ಟಳೆಯ ಪ್ರಕಾರ ಪಸ್ಕದ ಮಾಂಸವನ್ನು ಬೆಂಕಿಯಿಂದ ಸುಟ್ಟರು. ಆದರೆ ಪರಿಶುದ್ಧವಾದವುಗಳನ್ನು ಗಡಿಗೆಗಳಲ್ಲಿಯೂ, ತಪ್ಪಲೆಗಳಲ್ಲಿಯೂ, ಕೊಪ್ಪರಿಗೆಗಳಲ್ಲಿಯೂ ಬೇಯಿಸಿ, ಶೀಘ್ರವಾಗಿ ಜನರೆಲ್ಲರಿಗೆ ಕಳುಹಿಸಿದರು. <verse eid="2CH 35:13"/><verse number="14" style="v" sid="2CH 35:14"/>ತರುವಾಯ ತಮಗೋಸ್ಕರ, ಯಾಜಕರಿಗೋಸ್ಕರ ಭೋಜನವನ್ನು ಸಿದ್ಧಮಾಡಿದರು. ಏಕೆಂದರೆ ಆರೋನನ ಮಕ್ಕಳಾದ ಯಾಜಕರು ರಾತ್ರಿಯ ಪರ್ಯಂತರ ದಹನಬಲಿಗಳನ್ನೂ, ಕೊಬ್ಬನ್ನೂ ಅರ್ಪಿಸುವುದರಲ್ಲಿದ್ದರು. ಆದ್ದರಿಂದ ಲೇವಿಯರು ತಮಗೋಸ್ಕರವೂ, ಆರೋನನ ಮಕ್ಕಳಾದ ಯಾಜಕರಿಗೋಸ್ಕರವೂ ಭೋಜನವನ್ನು ಸಿದ್ಧಮಾಡಿದರು.<verse eid="2CH 35:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="2CH 35:15"/>ದಾವೀದನೂ, ಆಸಾಫನೂ, ಹೇಮಾನನೂ, ಅರಸನ ಪ್ರವಾದಿಯಾದ ಯೆದುತೂನನೂ ಇವರ ಆಜ್ಞೆಯ ಪ್ರಕಾರ ಆಸಾಫನ ಮಕ್ಕಳಾದ ಹಾಡುಗಾರರು ತಮ್ಮ ಸ್ಥಳದಲ್ಲಿದ್ದರು. ದ್ವಾರಪಾಲಕರು ಬಾಗಿಲಲ್ಲಿ ಇದ್ದರು. ಅವರು ತಮ್ಮ ಸೇವೆಯನ್ನು ಬಿಡಲು ಆಗದೆ ಇತ್ತು. ಏಕೆಂದರೆ ಅವರ ಸಹೋದರರಾದ ಲೇವಿಯರಿಗೋಸ್ಕರ ಭೋಜನವನ್ನು ಸಿದ್ಧಮಾಡುತ್ತಿದ್ದರು.<verse eid="2CH 35:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="2CH 35:16"/>ಹೀಗೆಯೇ ಅರಸನಾದ ಯೋಷೀಯನ ಆಜ್ಞೆಯ ಪ್ರಕಾರ ಪಸ್ಕವನ್ನು ಆಚರಿಸುವುದಕ್ಕೂ, ಯೆಹೋವ ದೇವರ ಬಲಿಪೀಠದ ಮೇಲೆ ದಹನಬಲಿಗಳನ್ನು ಅರ್ಪಿಸುವುದಕ್ಕೂ, ಅದೇ ಸಮಯದಲ್ಲಿ ಯೆಹೋವ ದೇವರ ಸೇವೆಯು ಸಿದ್ಧವಾಯಿತು. <verse eid="2CH 35:16"/><verse number="17" style="v" sid="2CH 35:17"/>ಸಿದ್ಧವಾಗಿದ್ದ ಇಸ್ರಾಯೇಲರು ಆ ಕಾಲದಲ್ಲಿ ಪಸ್ಕವನ್ನು ಹುಳಿಯಿಲ್ಲದ ರೊಟ್ಟಿಗಳ ಹಬ್ಬವನ್ನೂ ಏಳು ದಿವಸ ಆಚರಿಸಿದರು. <verse eid="2CH 35:17"/><verse number="18" style="v" sid="2CH 35:18"/>ಪ್ರವಾದಿಯಾದ ಸಮುಯೇಲನ ದಿವಸಗಳು ಮೊದಲುಗೊಂಡು ಇಸ್ರಾಯೇಲಿನಲ್ಲಿ ಇಂಥಾ ಪಸ್ಕವನ್ನು ಆಚರಿಸಿರಲಿಲ್ಲ. ಇಸ್ರಾಯೇಲಿನ ಸಮಸ್ತ ಅರಸರಲ್ಲಿ ಯೋಷೀಯನೂ, ಯಾಜಕರೂ, ಲೇವಿಯರೂ, ಸಿದ್ಧವಾಗಿದ್ದ ಯೆಹೂದ ಹಾಗೂ ಇಸ್ರಾಯೇಲರೆಲ್ಲರೂ, ಯೆರೂಸಲೇಮಿನ ನಿವಾಸಿಗಳೂ ಆಚರಿಸಿದ ಪಸ್ಕದ ಹಾಗೆ ಯಾರೂ ಆಚರಿಸಲಿಲ್ಲ. <verse eid="2CH 35:18"/><verse number="19" style="v" sid="2CH 35:19"/>ಯೋಷೀಯನ ಆಳ್ವಿಕೆಯ ಹದಿನೆಂಟನೆಯ ವರ್ಷದಲ್ಲಿ ಈ ಪಸ್ಕಹಬ್ಬವನ್ನು ಆಚರಿಸಲಾಯಿತು.<verse eid="2CH 35:19"/></para>
  <para style="s1">ಯೋಷೀಯನ ಮರಣ</para>
  <para style="p">
    <verse number="20" style="v" sid="2CH 35:20"/>ಯೋಷೀಯನು ಮಹಾ ದೇವಾಲಯದ ವಿಷಯದಲ್ಲಿ ಈ ಎಲ್ಲಾ ವ್ಯವಸ್ಥೆಯನ್ನು ಮಾಡಿದ ನಂತರ, ಈಜಿಪ್ಟಿನ ಅರಸ ನೆಕೋ ಎಂಬವನು ಯುದ್ಧಮಾಡುವುದಕ್ಕಾಗಿ ಯೂಫ್ರೇಟೀಸ್ ನದಿಯ ತೀರದಲ್ಲಿದ್ದ ಕರ್ಕೆಮೀಷಿಗೆ ಬಂದನು. ಯೋಷೀಯನು ಅವನನ್ನು ಯುದ್ಧದಲ್ಲಿ ಎದುರಿಸಲು ಹೋದನು. <verse eid="2CH 35:20"/><verse number="21" style="v" sid="2CH 35:21"/>ಆದರೆ ಇವನು ಯೋಷೀಯನ ಬಳಿಗೆ ಸೇವಕರನ್ನು ಕಳುಹಿಸಿ, “ಯೆಹೂದದ ಅರಸನೇ, ನನಗೆ ನೀನು ಏನು? ಈ ಹೊತ್ತು ನಿನ್ನ ಮೇಲೆ ಅಲ್ಲ. ನಾನು ಯುದ್ಧಮಾಡುವ ವೈರಿಯ ಮೇಲೆಯೇ ದಾಳಿಮಾಡುತ್ತೇನೆ. ತ್ವರೆಮಾಡು ಎಂದು ದೇವರು ನನಗೆ ಹೇಳಿದ್ದಾರೆ. ನನ್ನ ಸಂಗಡ ಇರುವ ದೇವರು ನಿನ್ನನ್ನು ನಾಶಮಾಡದ ಹಾಗೆ ನೀನು ದೇವರ ಮುಂದೆ ಸುಮ್ಮನಿರು.”<verse eid="2CH 35:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="2CH 35:22"/>ಆದಾಗ್ಯೂ ಯೋಷೀಯನು ತನ್ನ ಮುಖವನ್ನು ಅವನ ಕಡೆಯಿಂದ ತಿರುಗಿಸದೆ, ಅವನ ಸಂಗಡ ಯುದ್ಧಮಾಡಲು ತನ್ನ ವೇಷ ಮರೆಸಿಕೊಂಡು ಹೋದನು. ಯೋಷೀಯನು ದೇವರ ಬಾಯಿಂದ ಬಂದ ನೆಕೋ ಎಂಬವನ ಮಾತುಗಳನ್ನು ಕೇಳದೆ ಮೆಗಿದ್ದೋ ತಗ್ಗಿನಲ್ಲಿ ಯುದ್ಧಮಾಡಲು ಬಂದನು.<verse eid="2CH 35:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="2CH 35:23"/>ಆಗ ಬಿಲ್ಲುಗಾರರು ಅರಸನಾದ ಯೋಷೀಯನ ಮೇಲೆ ಬಾಣವನ್ನು ಎಸೆದರು. ಅರಸನು ತನ್ನ ಸೇವಕರಿಗೆ, “ನನ್ನನ್ನು ಆಚೆಗೆ ಒಯ್ಯಿರಿ, ಏಕೆಂದರೆ ಬಹು ಗಾಯಪಟ್ಟಿದ್ದೇನೆ,” ಎಂದನು. <verse eid="2CH 35:23"/><verse number="24" style="v" sid="2CH 35:24"/>ಆದ್ದರಿಂದ ಅವನ ಸೇವಕರು ಆ ರಥದೊಳಗಿಂದ ಅವನನ್ನು ತೆಗೆದುಕೊಂಡು, ಅವನಿಗಿದ್ದ ಎರಡನೆಯ ರಥದಲ್ಲಿ ಅವನನ್ನು ಇರಿಸಿ ಯೆರೂಸಲೇಮಿಗೆ ತಂದರು. ಅವನು ಅಲ್ಲಿ ಮರಣ ಹೊಂದಲು, ಅವನ ಶವವನ್ನು ಅವನ ಪಿತೃಗಳ ಸ್ಮಶಾನದಲ್ಲಿ ಸಮಾಧಿಮಾಡಿದರು. ಸಮಸ್ತ ಯೆಹೂದ ಮತ್ತು ಯೆರೂಸಲೇಮಿನವರು ಯೋಷೀಯನಿಗೋಸ್ಕರ ದುಃಖಪಟ್ಟರು.<verse eid="2CH 35:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="2CH 35:25"/>ಯೆರೆಮೀಯನು ಯೋಷೀಯನಿಗೋಸ್ಕರ ದುಃಖ ಗೀತವನ್ನು ಬರೆದನು. ಹಾಡುಗಾರರೂ, ಹಾಡುಗಾರ್ತಿಯರೂ ಯೋಷೀಯನನ್ನು ಇದುವರೆಗೂ ತಮ್ಮ ಗೋಳಾಟ ಪದ್ಯಗಳಲ್ಲಿ ಸ್ಮರಿಸಿಕೊಳ್ಳುತ್ತಾರೆ. ಇದು ಇಸ್ರಾಯೇಲಿನಲ್ಲಿ ಸಂಪ್ರದಾಯವಾಯಿತು ಮತ್ತು ಈ ಗೀತೆಗಳು ಪ್ರಲಾಪಗಳಲ್ಲಿ ಬರೆದಿರುತ್ತವೆ.<verse eid="2CH 35:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="2CH 35:26"/>ಯೋಷೀಯನ ಮಿಕ್ಕಾದ ಕ್ರಿಯೆಗಳು ಯೆಹೋವ ದೇವರ ನಿಯಮದಲ್ಲಿ ಬರೆದಿರುವ ಪ್ರಕಾರ, ಅವನು ಮಾಡಿದ ಭಕ್ತಿಕಾರ್ಯಗಳೂ, <verse eid="2CH 35:26"/><verse number="27" style="v" sid="2CH 35:27"/>ಅವನ ಕ್ರಿಯೆಗಳೂ, ಮೊದಲನೆಯವುಗಳೂ, ಕಡೆಯವುಗಳೂ ಇಸ್ರಾಯೇಲ್ ಯೆಹೂದದ ಅರಸರ ಪುಸ್ತಕದಲ್ಲಿ ಬರೆದಿರುತ್ತವೆ.<verse eid="2CH 35:27"/></para>
  <chapter eid="2CH 35"/>
  <chapter number="36" style="c" sid="2CH 36"/>
  <para style="nb">
    <verse number="1" style="v" sid="2CH 36:1"/>ಆಗ ದೇಶದ ಜನರು ಯೋಷೀಯನ ಮಗನಾದ ಯೆಹೋವಾಹಾಜನನ್ನು ತೆಗೆದುಕೊಂಡು ಯೆರೂಸಲೇಮಿನಲ್ಲಿ ಅವನ ತಂದೆಗೆ ಬದಲಾಗಿ ಅರಸನನ್ನಾಗಿ ಮಾಡಿದರು.<verse eid="2CH 36:1"/></para>
  <para style="s1">ಯೆಹೂದ್ಯ ಪ್ರಾಂತ್ಯದ ಅರಸನಾದ ಯೆಹೋವಾಹಾಜನು</para>
  <para style="p">
    <verse number="2" style="v" sid="2CH 36:2"/>ಯೆಹೋವಾಹಾಜನು ಅರಸನಾದಾಗ ಇಪ್ಪತ್ತಮೂರು ವರ್ಷದವನಾಗಿದ್ದು, ಅವನು ಯೆರೂಸಲೇಮಿನಲ್ಲಿ ಮೂರು ತಿಂಗಳು ಆಳಿದನು. <verse eid="2CH 36:2"/><verse number="3" style="v" sid="2CH 36:3"/>ಈಜಿಪ್ಟ್ ಅರಸನು ಯೆರೂಸಲೇಮಿನಲ್ಲಿ ಅವನನ್ನು ಸಿಂಹಾಸನದಿಂದ ತೆಗೆದುಹಾಕಿ, ಯೆಹೂದ್ಯರು ಅವನಿಗೆ ಮೂರು ಸಾವಿರದ ನಾಲ್ಕುನೂರು ಕಿಲೋಗ್ರಾಂ ಬೆಳ್ಳಿಯನ್ನೂ, ಮೂವತ್ತ ನಾಲ್ಕು ಕಿಲೋಗ್ರಾಂ ಬಂಗಾರವನ್ನೂ ದಂಡ ತೆರುವಂತೆ ಮಾಡಿದನು. <verse eid="2CH 36:3"/><verse number="4" style="v" sid="2CH 36:4"/>ಇದಲ್ಲದೆ ಈಜಿಪ್ಟ್ ಅರಸನು ಯೆಹೋವಾಹಾಜನ ಸಹೋದರನಾದ ಎಲ್ಯಾಕೀಮನನ್ನು ಯೆಹೂದದ ಮತ್ತು ಯೆರೂಸಲೇಮಿನ ಮೇಲೆ ಅರಸನನ್ನಾಗಿ ಮಾಡಿ, ಅವನಿಗೆ ಯೆಹೋಯಾಕೀಮನೆಂಬ ಹೆಸರನ್ನಿಟ್ಟನು. ನೆಕೋವನು ಎಲ್ಯಾಕೀಮನ ಸಹೋದರನಾದ ಯೆಹೋವಾಹಾಜನನ್ನು ತೆಗೆದುಕೊಂಡು ಈಜಿಪ್ಟಿಗೆ ಒಯ್ದನು.<verse eid="2CH 36:4"/></para>
  <para style="s1">ಯೆಹೂದ್ಯರ ಅರಸನಾದ ಯೆಹೋಯಾಕೀಮನು</para>
  <para style="p">
    <verse number="5" style="v" sid="2CH 36:5"/>ಯೆಹೋಯಾಕೀಮನು ಅರಸನಾದಾಗ ಇಪ್ಪತ್ತೈದು ವರ್ಷದವನಾಗಿದ್ದು, ಅವನು ಯೆರೂಸಲೇಮಿನಲ್ಲಿ ಹನ್ನೊಂದು ವರ್ಷ ಆಳಿದನು. ಆದರೆ ತನ್ನ ದೇವರಾದ ಯೆಹೋವ ದೇವರ ದೃಷ್ಟಿಯಲ್ಲಿ ಕೆಟ್ಟದ್ದನ್ನು ಮಾಡಿದನು. <verse eid="2CH 36:5"/><verse number="6" style="v" sid="2CH 36:6"/>ಬಾಬಿಲೋನಿನ ಅರಸನಾದ ನೆಬೂಕದ್ನೆಚ್ಚರನು ಅವನ ಮೇಲೆ ಬಂದು ಬಾಬಿಲೋನಿಗೆ ಒಯ್ಯುವುದಕ್ಕಾಗಿ ಅವನಿಗೆ ಕಂಚಿನ ಸಂಕೋಲೆಗಳನ್ನು ಹಾಕಿಸಿದನು. <verse eid="2CH 36:6"/><verse number="7" style="v" sid="2CH 36:7"/>ಇದಲ್ಲದೆ ನೆಬೂಕದ್ನೆಚ್ಚರನು ಯೆಹೋವ ದೇವರ ಆಲಯದ ಪಾತ್ರೆಗಳಲ್ಲಿ ಕೆಲವನ್ನು ಬಾಬಿಲೋನಿಗೆ ತೆಗೆದುಕೊಂಡುಹೋಗಿ, ಬಾಬಿಲೋನಿನಲ್ಲಿರುವ ತನ್ನ ಮಂದಿರದಲ್ಲಿ ಇರಿಸಿದನು.<verse eid="2CH 36:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="2CH 36:8"/>ಯೆಹೋಯಾಕೀಮನ ಇತರ ಕ್ರಿಯೆಗಳೂ, ಅವನು ಮಾಡಿದ ಅಸಹ್ಯಗಳೂ, ಅವನಲ್ಲಿ ಕಂಡುಕೊಂಡದ್ದೂ, ಇಸ್ರಾಯೇಲ್ ಯೆಹೂದದ ಅರಸರ ಇತಿಹಾಸಗಳ ಪುಸ್ತಕದಲ್ಲಿ ಬರೆದಿರುತ್ತವೆ. ಅವನಿಗೆ ಬದಲಾಗಿ ಅವನ ಮಗ ಯೆಹೋಯಾಖೀನನು ಅರಸನಾದನು.<verse eid="2CH 36:8"/></para>
  <para style="s1">ಯೆಹೂದ್ಯರ ಅರಸನಾದ ಯೆಹೋಯಾಕೀನನು</para>
  <para style="p">
    <verse number="9" style="v" sid="2CH 36:9"/>ಯೆಹೋಯಾಖೀನನು ಅರಸನಾದಾಗ ಹದಿನೆಂಟು ವರ್ಷದವನಾಗಿದ್ದು, ಯೆರೂಸಲೇಮಿನಲ್ಲಿ ಮೂರು ತಿಂಗಳು ಹತ್ತು ದಿವಸ ಆಳಿದನು. ಅವನು ಯೆಹೋವ ದೇವರ ದೃಷ್ಟಿಯಲ್ಲಿ ಕೆಟ್ಟದ್ದನ್ನು ಮಾಡಿದನು. <verse eid="2CH 36:9"/><verse number="10" style="v" sid="2CH 36:10"/>ಆದರೆ ಒಂದು ವರ್ಷವು ತೀರಿದ ಮೇಲೆ ಅರಸನಾದ ನೆಬೂಕದ್ನೆಚ್ಚರನು ಜನರನ್ನು ಕಳುಹಿಸಿ, ಅವನನ್ನೂ ಮತ್ತು ಯೆಹೋವ ದೇವರ ಆಲಯದ ಬೆಲೆಯುಳ್ಳ ಪಾತ್ರೆಗಳನ್ನೂ ಬಾಬಿಲೋನಿಗೆ ತೆಗೆದುಕೊಂಡು ಬರಮಾಡಿ, ಅವನ ಸಹೋದರನಾದ<note caller="+" style="f"><char style="fr" closed="false">36:10 </char><char style="ft" closed="false">ಹೀಬ್ರೂ ಭಾಷೆಯಲ್ಲಿ </char><char style="fqa" closed="false">ಸಂಬಂಧಿ </char><char style="ft" closed="false">ಎಂದು ಅರ್ಥ</char></note> ಚಿದ್ಕೀಯನನ್ನು ಯೆಹೂದ ಮತ್ತು ಯೆರೂಸಲೇಮಿನ ಮೇಲೆ ಅರಸನನ್ನಾಗಿ ಮಾಡಿದನು.<verse eid="2CH 36:10"/></para>
  <para style="s1">ಯೆಹೂದ್ಯ ಪ್ರಾಂತ್ಯದ ಅರಸನಾದ ಚಿದ್ಕೀಯನು</para>
  <para style="p">
    <verse number="11" style="v" sid="2CH 36:11"/>ಚಿದ್ಕೀಯನು ಅರಸನಾದಾಗ ಇಪ್ಪತ್ತೊಂದು ವರ್ಷದವನಾಗಿದ್ದು, ಅವನು ಯೆರೂಸಲೇಮಿನಲ್ಲಿ ಹನ್ನೊಂದು ವರ್ಷ ಆಳಿದನು. <verse eid="2CH 36:11"/><verse number="12" style="v" sid="2CH 36:12"/>ಅವನು ತನ್ನ ದೇವರಾದ ಯೆಹೋವ ದೇವರ ದೃಷ್ಟಿಯಲ್ಲಿ ಕೆಟ್ಟದ್ದನ್ನು ಮಾಡಿ, ಯೆಹೋವ ದೇವರು ಹೇಳಿದ ಮಾತುಗಳಂತೆ ಪ್ರವಾದಿಯಾದ ಯೆರೆಮೀಯನ ಮುಂದೆ ತನ್ನನ್ನು ತಗ್ಗಿಸಿಕೊಳ್ಳದೆ ಇದ್ದನು. <verse eid="2CH 36:12"/><verse number="13" style="v" sid="2CH 36:13"/>ಇದಲ್ಲದೆ ಅವನು ದೇವರ ಮೇಲೆ ಆಣೆ ಇಡುವಂತೆ ಮಾಡಿದ ಅರಸನಾದ ನೆಬೂಕದ್ನೆಚ್ಚರನಿಗೆ ತಿರುಗಿಬಿದ್ದನು. ಹೇಗೆಂದರೆ ಅವನು ಇಸ್ರಾಯೇಲಿನ ಯೆಹೋವ ದೇವರ ಕಡೆಗೆ ತಿರುಗದೆ, ಹಟಮಾರಿಯಾಗಿ ತನ್ನ ಹೃದಯವನ್ನು ಕಠಿಣ ಮಾಡಿಕೊಂಡನು. <verse eid="2CH 36:13"/><verse number="14" style="v" sid="2CH 36:14"/>ಯಾಜಕರಲ್ಲಿರುವ ಎಲ್ಲಾ ಪ್ರಧಾನರೂ, ಜನರೂ ಜನಾಂಗಗಳ ಅಸಹ್ಯಗಳನ್ನು ಹಿಂಬಾಲಿಸಿ ಬಹಳವಾಗಿ ಅಪನಂಬಿಗಸ್ತರಾಗಿ, ಯೆಹೋವ ದೇವರು ಯೆರೂಸಲೇಮಿನಲ್ಲಿ ಪರಿಶುದ್ಧ ಮಾಡಿದ ಆತನ ಆಲಯವನ್ನು ಹೊಲೆ ಮಾಡಿದರು.<verse eid="2CH 36:14"/></para>
  <para style="s1">ಯೆರೂಸಲೇಮಿನ ಬೀಳುವಿಕೆ</para>
  <para style="p">
    <verse number="15" style="v" sid="2CH 36:15"/>ಅವರ ಪಿತೃಗಳ ದೇವರಾದ ಯೆಹೋವ ದೇವರು ತಮ್ಮ ಸೇವಕರನ್ನು ಅವನ ಬಳಿಗೆ ಪುನಃ ಕಳುಹಿಸಿದರು. ತಮ್ಮ ಜನರ ಮೇಲೆಯೂ, ತಮ್ಮ ನಿವಾಸ ಸ್ಥಾನದ ಮೇಲೆಯೂ ಅವರು ಕನಿಕರಪಟ್ಟರು. <verse eid="2CH 36:15"/><verse number="16" style="v" sid="2CH 36:16"/>ಆದರೆ ಯೆಹೋವ ದೇವರ ಕೋಪವು ತಮ್ಮ ಜನರಿಗೆ ವಿರೋಧವಾಗಿ ಏಳುವವರೆಗೂ, ಅಂದರೆ ಪರಿಹಾರವಾಗದಷ್ಟೂ ಅವರು ದೇವರ ಸೇವಕರನ್ನು ಅಪಹಾಸ್ಯಮಾಡಿ, ದೇವರ ವಾಕ್ಯಗಳನ್ನು ತಿರಸ್ಕರಿಸಿ, ದೇವರ ಪ್ರವಾದಿಗಳಿಗೆ ಅಪಹಾಸ್ಯ ಮಾಡಿದರು. <verse eid="2CH 36:16"/><verse number="17" style="v" sid="2CH 36:17"/>ಆದ್ದರಿಂದ ದೇವರು ಅವರ ಮೇಲೆ ಕಸ್ದೀಯರ ಅರಸನನ್ನು ಬರಮಾಡಿದರು. ಅವನು ಅವರ ಪರಿಶುದ್ಧ ಸ್ಥಾನವಾದ ಆಲಯದಲ್ಲಿ ಅವರ ಪ್ರಾಯಸ್ಥರನ್ನು ಖಡ್ಗದಿಂದ ಕೊಂದುಹಾಕಿದನು. ಪ್ರಾಯಸ್ಥನ ಮೇಲಾದರೂ, ಕನ್ಯಾಸ್ತ್ರೀಯ ಮೇಲಾದರೂ, ಅತಿವೃದ್ಧನ ಮೇಲಾದರೂ ಕನಿಕರಪಡಲಿಲ್ಲ. ದೇವರು ಸಮಸ್ತ ಜನರನ್ನು ನೆಬೂಕದ್ನೆಚ್ಚರನ ಕೈಯಲ್ಲಿ ಒಪ್ಪಿಸಿದರು. <verse eid="2CH 36:17"/><verse number="18" style="v" sid="2CH 36:18"/>ಇದಲ್ಲದೆ ದೊಡ್ಡವೂ, ಸಣ್ಣವೂ ಆದ ಯೆಹೋವ ದೇವರ ಆಲಯದ ಎಲ್ಲಾ ಸಲಕರಣೆಗಳು ಆಲಯದ ಬೊಕ್ಕಸಗಳು, ಅರಸನ ಬೊಕ್ಕಸಗಳು, ಅವನ ಪ್ರಧಾನರ ಬೊಕ್ಕಸಗಳು ಇವುಗಳನ್ನೆಲ್ಲಾ ಬಾಬಿಲೋನಿಗೆ ತರಿಸಿದನು. <verse eid="2CH 36:18"/><verse number="19" style="v" sid="2CH 36:19"/>ಅವರು ದೇವರ ಆಲಯವನ್ನು ಸುಟ್ಟುಬಿಟ್ಟು, ಯೆರೂಸಲೇಮಿನ ಗೋಡೆಯನ್ನು ಕೆಡವಿಹಾಕಿ, ಅದರ ಅರಮನೆಗಳನ್ನು ಸುಟ್ಟುಬಿಟ್ಟು, ಅದರ ಬೆಲೆಯುಳ್ಳ ಸಲಕರಣೆಗಳನ್ನೆಲ್ಲಾ ನಾಶಮಾಡಿದರು.<verse eid="2CH 36:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="2CH 36:20"/>ಇದಲ್ಲದೆ ಖಡ್ಗದಿಂದ ತಪ್ಪಿಸಿಕೊಂಡವರನ್ನು ಅವನು ಬಾಬಿಲೋನಿಗೆ ಸೆರೆಹಿಡಿದು ಕರೆದುಕೊಂಡು ಹೋದನು. ಅವರು ಅಲ್ಲಿ ಪಾರಸಿಯ ಸಾಮ್ರಾಜ್ಯ ಸ್ಥಾಪಿತವಾಗುವವರೆಗೆ ಅವರು ಅವನಿಗೂ ಅವನ ಮಕ್ಕಳಿಗೂ ಸೇವಕರಾಗಿದ್ದರು. <verse eid="2CH 36:20"/><verse number="21" style="v" sid="2CH 36:21"/>ಹೀಗೆ ಯೆರೆಮೀಯನ ಮುಖಾಂತರವಾಗಿ ಹೇಳಿಸಿದ ಯೆಹೋವ ದೇವರ ವಾಕ್ಯವು ನೆರವೇರಿತು. ದೇಶವು ಅದರ ಸಬ್ಬತ್ ದಿನಗಳನ್ನು ಅನುಭವಿಸುವುದಕ್ಕೆ ಮಾರ್ಗವಾಯಿತು. ಅದು ಎಪ್ಪತ್ತು ವರ್ಷ ಹಾಳುಬಿದ್ದು, ಆ ಕಾಲಾವಧಿಯಲ್ಲಿ ವಿಶ್ರಾಂತಿಯನ್ನು ಅನುಭವಿಸುತ್ತಾ ಇತ್ತು.<verse eid="2CH 36:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="2CH 36:22"/>ಆದರೆ ಪಾರಸಿಯ ಅರಸ ಕೋರೆಷನ ಮೊದಲನೆಯ ವರ್ಷದಲ್ಲಿ ಯೆಹೋವ ದೇವರು ಯೆರೆಮೀಯನ ಮುಂಖಾತರ ಹೇಳಿದ ವಾಕ್ಯವು ಈಡೇರುವ ಹಾಗೆ ಯೆಹೋವ ದೇವರು ಪಾರಸಿಯ ಅರಸ ಕೋರೆಷನ ಆತ್ಮವನ್ನು ಪ್ರೇರೇಪಿಸಿದ್ದರಿಂದ, ಅವನು ತನ್ನ ಸಮಸ್ತ ರಾಜ್ಯದಲ್ಲಿ ಡಂಗುರದಿಂದಲೂ, ಪತ್ರಗಳಿಂದಲೂ ಸಾರಿ ಹೇಳಿದ್ದೇನೆಂದರೆ,<verse eid="2CH 36:22"/></para>
  <para style="pmo">
    <verse number="23" style="v" sid="2CH 36:23"/>“ಪಾರಸಿಯ ಅರಸ ಕೋರೆಷನು ಹೀಗೆ ಹೇಳುತ್ತಾನೆ:</para>
  <para style="pm" vid="2CH 36:23">“ ‘ಪರಲೋಕದ ದೇವರಾದ ಯೆಹೋವ ದೇವರು ಭೂಲೋಕದ ರಾಜ್ಯಗಳನ್ನೆಲ್ಲಾ ನನಗೆ ಕೊಟ್ಟಿದ್ದಾರೆ ಮತ್ತು ಅವರು ಯೆಹೂದ ದೇಶದ ಯೆರೂಸಲೇಮಿನಲ್ಲಿ ತಮಗೆ ಆಲಯವನ್ನು ಕಟ್ಟಿಸಲು ನನಗೆ ಆಜ್ಞಾಪಿಸಿದ್ದಾರೆ. ನಿಮ್ಮಲ್ಲಿ ಯಾರು ಅವರ ಪ್ರಜೆಗಳಾಗಿರುತ್ತೀರೋ, ಅಂಥವರು ಸ್ವಂತನಾಡಿಗೆ ಹೋಗಬಹುದು. ದೇವರಾದ ಯೆಹೋವ ದೇವರು ಅವರ ಸಂಗಡ ಇರಲಿ!’ ” ಎಂದನು.<verse eid="2CH 36:23"/></para>
  <chapter eid="2CH 36"/>
</usx>
