<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="PHM" style="id">- Biblica® Open Kannada Contemporary Version</book>
  <para style="h">ಫಿಲೆಮೋನನಿಗೆ</para>
  <para style="toc1">ಫಿಲೆಮೋನನಿಗೆ ಪೌಲನು ಬರೆದ ಪತ್ರಿಕೆ</para>
  <para style="toc2">ಫಿಲೆಮೋನನಿಗೆ</para>
  <para style="toc3">ಫಿಲೆ</para>
  <para style="mt1">ಫಿಲೆಮೋನನಿಗೆ</para>
  <para style="mt2">ಪೌಲನು ಬರೆದ ಪತ್ರಿಕೆ</para>
  <chapter number="1" style="c" sid="PHM 1"/>
  <para style="p">
    <verse number="1" style="v" sid="PHM 1:1"/>ಸುವಾರ್ತೆಯನ್ನು ಸಾರಿದ್ದರಿಂದ ಕ್ರಿಸ್ತ ಯೇಸುವಿನ ಸೆರೆಯಾಳಾಗಿರುವ ಪೌಲನೂ ನಮ್ಮ ಸಹೋದರನಾದ ತಿಮೊಥೆಯನೂ,</para>
  <para style="b" vid="PHM 1:1"/>
  <para style="p" vid="PHM 1:1">ನಮಗೆ ಪ್ರಿಯನೂ ಜೊತೆಗೆಲಸದವನೂ ಆಗಿರುವ ಫಿಲೆಮೋನನಿಗೂ <verse eid="PHM 1:1"/><verse number="2" style="v" sid="PHM 1:2"/>ಸಹೋದರಿ ಅಪ್ಫಿಯಳಿಗೂ ನಮ್ಮ ಸಹ ಸೈನಿಕನಾದ ಅರ್ಖಿಪ್ಪನಿಗೂ ನಿಮ್ಮ ಮನೆಯಲ್ಲಿ ಸೇರುವ ಸಭೆಯವರಿಗೂ ಬರೆಯುವುದೇನೆಂದರೆ:<verse eid="PHM 1:2"/></para>
  <para style="b"/>
  <para style="p">
    <verse number="3" style="v" sid="PHM 1:3"/>ನಮ್ಮ ತಂದೆಯಾದ ದೇವರಿಂದಲೂ ನಮ್ಮ ಕರ್ತ ಆಗಿರುವ ಯೇಸು ಕ್ರಿಸ್ತರಿಂದಲೂ ನಿಮಗೆ ಕೃಪೆಯೂ ಶಾಂತಿಯೂ ಇರಲಿ.<verse eid="PHM 1:3"/></para>
  <para style="b"/>
  <para style="s1">ಕೃತಜ್ಞತಾ ಪ್ರಾರ್ಥನೆ</para>
  <para style="p">
    <verse number="4" style="v" sid="PHM 1:4"/>ನನ್ನ ಪ್ರಾರ್ಥನೆಗಳಲ್ಲಿ ನಿನ್ನನ್ನು ಜ್ಞಾಪಕಮಾಡಿಕೊಂಡು ನನ್ನ ದೇವರಿಗೆ ಯಾವಾಗಲೂ ಕೃತಜ್ಞತೆಯನ್ನು ಸಲ್ಲಿಸುತ್ತೇನೆ. <verse eid="PHM 1:4"/><verse number="5" style="v" sid="PHM 1:5"/>ಏಕೆಂದರೆ, ನಮ್ಮ ಕರ್ತ ಆಗಿರುವ ಯೇಸುವಿನಲ್ಲಿ ನಿನಗಿರುವ ವಿಶ್ವಾಸವನ್ನೂ ಪರಿಶುದ್ಧರೆಲ್ಲರಿಗಾಗಿ ನಿನಗಿರುವ ಪ್ರೀತಿಯನ್ನೂ ಕುರಿತು ನಾನು ಕೇಳಿದ್ದೇನೆ. <verse eid="PHM 1:5"/><verse number="6" style="v" sid="PHM 1:6"/>ನಿನ್ನ ವಿಶ್ವಾಸದಲ್ಲಿ ಅನ್ಯೋನ್ಯತೆಯು ನಿನ್ನ ಎಲ್ಲಾ ಒಳ್ಳೆಯದರ ಆಳವಾದ ತಿಳುವಳಿಕೆಯನ್ನು ಕ್ರಿಸ್ತ ಯೇಸುವಿಗಾಗಿ ಪರಿಣಾಮಗೊಳಿಸಿ ಹಂಚುವಂತೆ ನಾನು ಪ್ರಾರ್ಥಿಸುತ್ತೇನೆ. <verse eid="PHM 1:6"/><verse number="7" style="v" sid="PHM 1:7"/>ಸಹೋದರನೇ, ನಿನ್ನ ಮೂಲಕ ದೇವಜನರ ಹೃದಯಗಳಿಗೆ ಉತ್ತೇಜನವಾದ್ದರಿಂದ, ನಿನ್ನ ಪ್ರೀತಿಯ ನಿಮಿತ್ತ ನನಗೆ ಬಹಳ ಆನಂದವೂ ಆದರಣೆಯೂ ಉಂಟಾದವು.<verse eid="PHM 1:7"/></para>
  <para style="s1">ಓನೇಸಿಮನಿಗಾಗಿ ಪೌಲನ ಬೇಡಿಕೆ</para>
  <para style="p">
    <verse number="8" style="v" sid="PHM 1:8"/>ಆದಕಾರಣ, ನಾನು ಈಗ ನಿನಗೆ ಏನು ಮಾಡಬೇಕೆಂದು ಆಜ್ಞಾಪಿಸುವುದಕ್ಕೆ ಕ್ರಿಸ್ತ ಯೇಸುವಿನಲ್ಲಿ ನನಗೆ ಬಹು ಧೈರ್ಯವಿದ್ದರೂ <verse eid="PHM 1:8"/><verse number="9" style="v" sid="PHM 1:9"/>ಹಾಗೆ ಆಜ್ಞಾಪಿಸದೆ, ಈಗ ಕ್ರಿಸ್ತ ಯೇಸುವಿನ ಸೆರೆಯಾಳೂ ಮುದುಕನೂ ಆಗಿರುವ ಪೌಲನೆಂಬ ನಾನು ಪ್ರೀತಿಯ ನಿಮಿತ್ತವೇ ನಿನ್ನನ್ನು ಬೇಡಿಕೊಳ್ಳುತ್ತೇನೆ. <verse eid="PHM 1:9"/><verse number="10" style="v" sid="PHM 1:10"/>ನಾನು ಬಂಧಿಯಾಗಿರುವಾಗ ನನ್ನ ಮಗನಂತೆ ಬಂದ ಓನೇಸಿಮನ<note caller="+" style="f"><char style="fr" closed="false">1:10 </char><char style="fq" closed="false">ಓನೇಸಿಮ </char><char style="ft" closed="false">ಅಂದರೆ, </char><char style="fqa" closed="false">ಪ್ರಯೋಜಕನು</char></note> ವಿಷಯದಲ್ಲಿ ನಿನ್ನನ್ನು ಕೇಳಿಕೊಳ್ಳುತ್ತೇನೆ. ಏಕೆಂದರೆ ನಾನು ಸೆರೆಯಲ್ಲಿದ್ದಾಗ ಅವನು ನನಗೆ ಆತ್ಮಿಕ ಮಗನಾದನು. <verse eid="PHM 1:10"/><verse number="11" style="v" sid="PHM 1:11"/>ಅವನು ಮೊದಲು ನಿನಗೆ ಅಪ್ರಯೋಜಕನಾಗಿದ್ದನು. ಈಗ ನಿನಗೂ ನನಗೂ ಪ್ರಯೋಜಕನಾಗಿದ್ದಾನೆ.<verse eid="PHM 1:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="PHM 1:12"/>ನನಗೆ ಪ್ರಾಣವಾಗಿರುವ ಅವನನ್ನು ನಿನ್ನ ಬಳಿಗೆ ಹಿಂದಕ್ಕೆ ನಾನು ಕಳುಹಿಸಿ ಕೊಡುತ್ತಿದ್ದೇನೆ. <verse eid="PHM 1:12"/><verse number="13" style="v" sid="PHM 1:13"/>ಸುವಾರ್ತೆಯ ನಿಮಿತ್ತ ಸೆರೆಯಲ್ಲಿರುವ ನನಗೆ ಉಪಚಾರ ಮಾಡುವಂತೆ ನಿನಗೆ ಬದಲಾಗಿ ಓನೇಸಿಮನನನ್ನು ನನ್ನ ಬಳಿಯಲ್ಲೇ ಉಳಿಸಿಕೊಳ್ಳಲು ಅಪೇಕ್ಷಿಸಿದ್ದೆನು. <verse eid="PHM 1:13"/><verse number="14" style="v" sid="PHM 1:14"/>ಆದರೆ ನಿನ್ನ ಉಪಚಾರವು ಬಲಾತ್ಕಾರದಿಂದಾಗದೆ, ಮನಃಪೂರ್ವಕವಾಗಿಯೇ ಇರಬೇಕೆಂದು ಯೋಚಿಸಿ, ನಿನ್ನ ಸಮ್ಮತಿಯಿಲ್ಲದೆ ಏನು ಮಾಡುವುದಕ್ಕೂ ನನಗೆ ಇಷ್ಟವಿಲ್ಲ. <verse eid="PHM 1:14"/><verse number="15" style="v" sid="PHM 1:15"/>ಓನೇಸಿಮನು ಸ್ವಲ್ಪಕಾಲ ನಿನ್ನಿಂದ ಅಗಲಿದ್ದು ಬಹುಶಃ ನೀನು ಅವನನ್ನು ನಿರಂತರವಾಗಿ ಸೇರಿಸಿಕೊಳ್ಳುವುದಕ್ಕಾಗಿಯೇ! <verse eid="PHM 1:15"/><verse number="16" style="v" sid="PHM 1:16"/>ಇನ್ನು ಮೇಲೆ ಅವನು ದಾಸನಾಗದೆ, ದಾಸನಿಗಿಂತ ಮೇಲಾಗಿ ಪ್ರಿಯ ಸಹೋದರನಂತಾಗಬೇಕು. ಅವನು ವಿಶೇಷವಾಗಿ ನನಗೆ ಬಹು ಪ್ರಿಯನಾಗಿದ್ದಾನೆ. ಆದರೂ ಓನೇಸಿಮನು ನಿನಗೆ ಮಾನವ ರೀತಿಯಲ್ಲಿಯೂ ಕರ್ತ ಯೇಸುವಿನಲ್ಲಿಯೂ ಒಬ್ಬ ಸಹೋದರನಾಗಿ ಇನ್ನು ಎಷ್ಟೋ ಪ್ರಿಯನಾಗಿರಬೇಕಲ್ಲವೇ.<verse eid="PHM 1:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="PHM 1:17"/>ಆದಕಾರಣ ನಾನು ನಿನಗೆ ಅನ್ಯೋನ್ಯತೆವುಳ್ಳವನೆಂದು ನೀನು ಎಣಿಸುವುದಾದರೆ ನನ್ನನ್ನು ಸ್ವೀಕರಿಸಿಕೊಳ್ಳುವ ಪ್ರಕಾರವೇ ಅವನನ್ನು ಸ್ವೀಕರಿಸು. <verse eid="PHM 1:17"/><verse number="18" style="v" sid="PHM 1:18"/>ಅವನು ನಿನಗೆ ಏನಾದರೂ ತಪ್ಪು ಮಾಡಿದ್ದರೆ ಅಥವಾ ಅವನು ಸಾಲವೇನಾದರೂ ತೀರಿಸಬೇಕಾಗಿದ್ದರೆ, ಅದನ್ನು ನನ್ನ ಲೆಕ್ಕಕ್ಕೆ ಹಾಕು. <verse eid="PHM 1:18"/><verse number="19" style="v" sid="PHM 1:19"/>ನಾನೇ ಕೊಟ್ಟು ತೀರಿಸುತ್ತೇನೆಂದು ಪೌಲನೆಂಬ ನಾನು ನನ್ನ ಸ್ವಂತ ಕೈಯಲ್ಲಿ ಬರೆದಿದ್ದೇನೆ. ನಿನ್ನ ಆತ್ಮದ ವಿಷಯದಲ್ಲಿ ನೀನು ನಿನ್ನ ಪ್ರಾಣವನ್ನೇ ನನಗೆ ಸಾಲಗಾರನಾಗಿದ್ದೀ ಎಂದು ನಾನು ಬೇರೆ ಹೇಳಬೇಕಾಗಿಲ್ಲ. <verse eid="PHM 1:19"/><verse number="20" style="v" sid="PHM 1:20"/>ಸಹೋದರನೇ ಹೌದು, ಕರ್ತ ಯೇಸುವಿನಲ್ಲಿ ನಿನ್ನಿಂದ ನನಗೆ ಈ ಸಹಾಯಮಾಡು; ಅದು ಕ್ರಿಸ್ತ ಯೇಸುವಿನಲ್ಲಿ ನನ್ನ ಹೃದಯವನ್ನು ಉತ್ತೇಜನಗೊಳಿಸಲಿ. <verse eid="PHM 1:20"/><verse number="21" style="v" sid="PHM 1:21"/>ನಿನ್ನ ವಿಧೇಯತೆಯಲ್ಲಿ ಭರವಸೆಯುಳ್ಳವನಾಗಿ ನಾನು ನಿನಗೆ ಬರೆದಿದ್ದೇನೆ. ನಾನು ಹೇಳಿದ್ದಕ್ಕಿಂತಲೂ ಹೆಚ್ಚಾಗಿಯೇ ನೀನು ಮಾಡುವೆಯೆಂದು ನನಗೆ ಗೊತ್ತಿದೆ.<verse eid="PHM 1:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="PHM 1:22"/>ಇದಲ್ಲದೆ: ನಿಮ್ಮ ಪ್ರಾರ್ಥನೆಯ ದೆಸೆಯಿಂದ ನಾನು ಪುನಃ ನಿಮ್ಮ ಬಳಿಗೆ ಬರುತ್ತೇನೆಂದು ನನಗೆ ನಿರೀಕ್ಷೆ ಇರುವುದು. ಆದಕಾರಣ ನನಗಾಗಿ ಒಂದು ಅತಿಥಿ ಕೊಠಡಿಯನ್ನು ಸಿದ್ಧಮಾಡು.<verse eid="PHM 1:22"/></para>
  <para style="b"/>
  <para style="b"/>
  <para style="p">
    <verse number="23" style="v" sid="PHM 1:23"/>ಕ್ರಿಸ್ತ ಯೇಸುವಿಗಾಗಿ ನನ್ನ ಜೊತೆ ಸೆರೆಯಾಳಾಗಿರುವ ಎಪಫ್ರನು ನಿನಗೆ ವಂದನೆ ತಿಳಿಸುತ್ತಾನೆ.<verse eid="PHM 1:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="PHM 1:24"/>ನನ್ನ ಜೊತೆಕೆಲಸದವರಾದ ಮಾರ್ಕ, ಅರಿಸ್ತಾರ್ಕ, ದೇಮ ಹಾಗೂ ಲೂಕ ನಿನ್ನನ್ನು ವಂದಿಸುತ್ತಾರೆ.<verse eid="PHM 1:24"/></para>
  <para style="b"/>
  <para style="p">
    <verse number="25" style="v" sid="PHM 1:25"/>ನಮ್ಮ ಕರ್ತ ಆಗಿರುವ ಯೇಸುಕ್ರಿಸ್ತರ ಕೃಪೆಯು ನಿಮ್ಮ ಆತ್ಮದೊಂದಿಗೆ ಇರಲಿ.<verse eid="PHM 1:25"/></para>
  <chapter eid="PHM 1"/>
</usx>
