<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="RUT" style="id">- Biblica® Open Kannada Contemporary Version</book>
  <para style="h">ರೂತಳು</para>
  <para style="toc1">ರೂತಳು</para>
  <para style="toc2">ರೂತಳು</para>
  <para style="toc3">ರೂತಳು</para>
  <para style="mt1">ರೂತಳು</para>
  <chapter number="1" style="c" sid="RUT 1"/>
  <para style="s1">ನೊವೊಮಿ ತನ್ನ ಗಂಡ ಮತ್ತು ಮಕ್ಕಳನ್ನು ಕಳೆದುಕೊಂಡದ್ದು</para>
  <para style="p">
    <verse number="1" style="v" sid="RUT 1:1"/>ನ್ಯಾಯಸ್ಥಾಪಕರು ಆಳುತ್ತಿದ್ದ ಆ ದಿನಗಳಲ್ಲಿ ಇಸ್ರಾಯೇಲ್ ದೇಶದೊಳಗೆ ಬರ ಉಂಟಾಗಿದ್ದಾಗ, ಯೆಹೂದದ ಬೇತ್ಲೆಹೇಮಿನವನಾದ ಒಬ್ಬ ಮನುಷ್ಯನು ತನ್ನ ಹೆಂಡತಿ ಮತ್ತು ತನ್ನ ಇಬ್ಬರು ಪುತ್ರರೊಂದಿಗೆ ಮೋವಾಬ್ ದೇಶದಲ್ಲಿ ಸ್ವಲ್ಪ ಕಾಲ ವಾಸಮಾಡಬೇಕೆಂದು ಹೋದನು. <verse eid="RUT 1:1"/><verse number="2" style="v" sid="RUT 1:2"/>ಆ ಮನುಷ್ಯನ ಹೆಸರು ಎಲೀಮೆಲೆಕನು. ಅವನ ಹೆಂಡತಿಯ ಹೆಸರು ನೊವೊಮಿ. ಅವನ ಪುತ್ರರಲ್ಲಿ ಒಬ್ಬನ ಹೆಸರು ಮಹ್ಲೋನನು, ಮತ್ತೊಬ್ಬನ ಹೆಸರು ಕಿಲ್ಯೋನನು. ಯೆಹೂದ ದೇಶಕ್ಕೆ ಸೇರಿದ ಎಫ್ರಾತದಲ್ಲಿರುವ ಬೇತ್ಲೆಹೇಮಿನವರಾದ ಇವರು ಬಂದು ಮೋವಾಬ್ ದೇಶದಲ್ಲಿ ವಾಸವಾಗಿದ್ದರು.<verse eid="RUT 1:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="RUT 1:3"/>ಆದರೆ ನೊವೊಮಿಯ ಗಂಡನಾದ ಎಲೀಮೆಲೆಕನು ಸತ್ತುಹೋದನು. ಆಕೆಯೂ ಆಕೆಯ ಇಬ್ಬರು ಪುತ್ರರೂ ಉಳಿದರು. <verse eid="RUT 1:3"/><verse number="4" style="v" sid="RUT 1:4"/>ಇವರು ಒರ್ಫಾ, ರೂತ್ ಎಂಬ ಹೆಸರುಗಳುಳ್ಳ ಇಬ್ಬರು ಮೋವಾಬ್ ದೇಶದ ಸ್ತ್ರೀಯರನ್ನು ಮದುವೆಮಾಡಿಕೊಂಡು ಸುಮಾರು ಹತ್ತು ವರುಷ ಅಲ್ಲಿ ವಾಸವಾಗಿದ್ದರು. <verse eid="RUT 1:4"/><verse number="5" style="v" sid="RUT 1:5"/>ಅಲ್ಲಿಯೇ ಮಹ್ಲೋನ ಮತ್ತು ಕಿಲ್ಯೋನ ಇಬ್ಬರೂ ಸತ್ತುಹೋದರು. ಆ ಸ್ತ್ರೀಯು ತನ್ನ ಇಬ್ಬರು ಪುತ್ರರನ್ನೂ ತನ್ನ ಗಂಡನನ್ನೂ ಕಳೆದುಕೊಂಡು ಒಬ್ಬಳೇ ಉಳಿದಳು.<verse eid="RUT 1:5"/></para>
  <para style="s1">ಬೇತ್ಲೆಹೇಮಿಗೆ ನೊವೊಮಿ ಮತ್ತು ರೂತಳ ಪುನರಾಗಮನ</para>
  <para style="p">
    <verse number="6" style="v" sid="RUT 1:6"/>ಯೆಹೋವ ದೇವರು ತಮ್ಮ ಜನರಿಗೆ ರೊಟ್ಟಿಯನ್ನು ಕೊಡುವ ಹಾಗೆ ಅವರನ್ನು ದರ್ಶಿಸಿದರೆಂದು ಅವಳು ಮೋವಾಬ್ ದೇಶದಲ್ಲಿ ಕೇಳಿದ್ದರಿಂದ ಅವಳು ತನ್ನ ಸೊಸೆಯರ ಸಂಗಡ ಮೋವಾಬ್ ದೇಶದಿಂದ ಸ್ವದೇಶಕ್ಕೆ ಹೋಗಬೇಕೆಂದು ನಿರ್ಧರಿಸಿದಳು. <verse eid="RUT 1:6"/><verse number="7" style="v" sid="RUT 1:7"/>ಆಕೆಯು ಇಬ್ಬರು ಸೊಸೆಯರೊಡನೆ ತಾನಿದ್ದ ಸ್ಥಳದಿಂದ ಯೆಹೂದ ದೇಶಕ್ಕೆ ಹೋಗಬೇಕೆಂದು ಹೊರಟಳು.<verse eid="RUT 1:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="RUT 1:8"/>ನೊವೊಮಿಯು ತನ್ನ ಇಬ್ಬರು ಸೊಸೆಯರಿಗೆ, “ನೀವು ನಿಮ್ಮ ನಿಮ್ಮ ತಾಯಿಯ ಮನೆಗೆ ತಿರುಗಿ ಹೋಗಿರಿ. ನೀವು ಮರಣ ಹೊಂದಿದ ಪತಿಯರಿಗೂ ನನಗೂ ದಯೆ ತೋರಿಸಿದ ಹಾಗೆಯೇ ಯೆಹೋವ ದೇವರು ನಿಮಗೆ ದಯೆ ತೋರಲಿ. <verse eid="RUT 1:8"/><verse number="9" style="v" sid="RUT 1:9"/>ನೀವು ಮದುವೆಯಾಗಿ ನಿಮ್ಮ ಗಂಡನ ಮನೆಯಲ್ಲಿ ವಿಶ್ರಾಂತಿ ಹೊಂದುವಂತೆ, ಯೆಹೋವ ದೇವರು ಆಶೀರ್ವದಿಸಲಿ,” ಎಂದು ಹೇಳಿದಳು.</para>
  <para style="p" vid="RUT 1:9">ನಂತರ ನೊವೊಮಿಯು ಅವರಿಗೆ ಮುದ್ದಿಟ್ಟಳು. <verse eid="RUT 1:9"/><verse number="10" style="v" sid="RUT 1:10"/>ಆಗ ಅವರು ಗಟ್ಟಿಯಾಗಿ ಅತ್ತು ಆಕೆಗೆ, “ನಿಶ್ಚಯವಾಗಿ ನಿಮ್ಮ ಜನರ ಬಳಿಗೆ ನಿಮ್ಮ ಸಂಗಡ ತಿರುಗಿ ಬರುತ್ತೇವೆ,” ಎಂದರು.<verse eid="RUT 1:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="RUT 1:11"/>ಅದಕ್ಕೆ ನೊವೊಮಿಯು, “ಬೇಡ ನನ್ನ ಮಕ್ಕಳೇ, ನೀವು ಹಿಂತಿರುಗಿ ಹೋಗಿರಿ. ನನ್ನ ಸಂಗಡ ಏಕೆ ಬರುತ್ತೀರಿ? ನಿಮಗೆ ಗಂಡಂದಿರಾಗುವ ಹಾಗೆ ಇನ್ನು ಮುಂದೆ ನನ್ನ ಗರ್ಭದಲ್ಲಿ ನನಗೆ ಪುತ್ರರಾಗುವರೋ? <verse eid="RUT 1:11"/><verse number="12" style="v" sid="RUT 1:12"/>ನನ್ನ ಮಕ್ಕಳೇ, ನೀವು ನಿಮ್ಮ ಮನೆಗೆ ಹಿಂದಿರುಗಿ ಹೋಗಿರಿ. ಏಕೆಂದರೆ ನಾನು ಪುನಃ ಮದುವೆಮಾಡಿಕೊಳ್ಳುವ ಪ್ರಾಯ ನನಗೆ ದಾಟಿಹೋಗಿದೆ. ಒಂದು ವೇಳೆ, ನಾನು ಸಂತಾನವಾಗುವ ನಿರೀಕ್ಷೆಯಿಂದ ಈ ಹೊತ್ತೇ ಮದುವೆಯಾಗಿ ಮಕ್ಕಳನ್ನು ಹೆತ್ತರೂ, <verse eid="RUT 1:12"/><verse number="13" style="v" sid="RUT 1:13"/>ಅವರು ದೊಡ್ಡವರಾಗುವವರೆಗೂ ಕಾದು ಕೊಳ್ಳುವಿರೋ? ಗಂಡನಿಲ್ಲದೆ ನೀವು ತಾಳಿಕೊಂಡಿರುವಿರೋ? ಇಲ್ಲ, ನನ್ನ ಮಕ್ಕಳೇ; ಯೆಹೋವ ದೇವರ ಹಸ್ತವು ನನಗೆ ವಿರೋಧವಾಗಿದೆ. ಆದ್ದರಿಂದ ನಿಮಗಿಂತ ನನಗೆ ಬಹು ದುಃಖವಾಗಿದೆ,” ಎಂದಳು.<verse eid="RUT 1:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="RUT 1:14"/>ಆಗ ಅವರು ತಿರುಗಿ ಗಟ್ಟಿಯಾದ ಸ್ವರದಿಂದ ಅತ್ತರು. ಒರ್ಫಾ ತನ್ನ ಅತ್ತೆಯನ್ನು ಮುದ್ದಿಟ್ಟು ಹೊರಟು ಹೋದಳು; ಆದರೆ ರೂತಳು ಅತ್ತೆಯನ್ನು ಅಂಟಿಕೊಂಡಳು.<verse eid="RUT 1:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="RUT 1:15"/>ಆಗ ನೊವೊಮಿ, “ಇಗೋ, ನಿನ್ನ ಓರಗಿತ್ತಿಯು ತನ್ನ ಜನರ ಬಳಿಗೂ ತನ್ನ ದೇವರುಗಳ ಬಳಿಗೂ ತಿರುಗಿ ಹೋದಳು. ನೀನೂ ನಿನ್ನ ಓರಗಿತ್ತಿಯ ಹಿಂದೆ ಹೋಗು,” ಎಂದಳು.<verse eid="RUT 1:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="RUT 1:16"/>ಅದಕ್ಕೆ ರೂತಳು, “ನಿಮ್ಮನ್ನು ಬಿಟ್ಟು ಹಿಂದಿರುಗಬೇಕೆಂದು ನನ್ನನ್ನು ಒತ್ತಾಯಮಾಡಬೇಡಿರಿ. ಏಕೆಂದರೆ ನೀವು ಎಲ್ಲಿ ಹೋಗುವಿರೋ ನಾನು ಅಲ್ಲಿಗೇ ಬರುವೆನು. ನೀವು ಎಲ್ಲಿ ಇಳುಕೊಳ್ಳುವಿರೋ ನಾನು ಅಲ್ಲಿ ಇಳುಕೊಳ್ಳುವೆನು. ನಿಮ್ಮ ಜನರೇ ನನ್ನ ಜನರು; ನಿಮ್ಮ ದೇವರೇ ನನ್ನ ದೇವರು. <verse eid="RUT 1:16"/><verse number="17" style="v" sid="RUT 1:17"/>ನೀವು ಎಲ್ಲಿ ಸಾಯುತ್ತೀರೋ ಅಲ್ಲಿಯೇ ನಾನು ಸಾಯುವೆನು. ಅಲ್ಲಿಯೇ ನನಗೆ ಸಮಾಧಿಯಾಗಲಿ. ಮರಣದಿಂದಲ್ಲದೆ ನಾನು ನಿಮ್ಮನ್ನು ಅಗಲಿದರೆ ಯೆಹೋವ ದೇವರು ನನಗೆ ಬೇಕಾದದ್ದನ್ನು ಮಾಡಲಿ,” ಎಂದಳು. <verse eid="RUT 1:17"/><verse number="18" style="v" sid="RUT 1:18"/>ರೂತಳು ತನ್ನ ಸಂಗಡ ಬರಲು ದೃಢವಾದ ಮನಸ್ಸು ಮಾಡಿಕೊಂಡಿದ್ದಾಳೆಂದು ನೊವೊಮಿ ತಿಳಿದು ಸುಮ್ಮನಾದಳು.<verse eid="RUT 1:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="RUT 1:19"/>ಹಾಗೆಯೇ ಇಬ್ಬರೂ ಬೇತ್ಲೆಹೇಮಿನವರೆಗೂ ನಡೆದುಹೋದರು. ಅವರು ಬೇತ್ಲೆಹೇಮಿನಲ್ಲಿ ಪ್ರವೇಶಿಸುವಾಗ ಆ ಪಟ್ಟಣದವರಲ್ಲಿ ಕುತೂಹಲ ಮೂಡಿಸಿತು. ಅವರು, “ಇವಳು ನೊವೊಮಿಯೋ?” ಎಂದರು.<verse eid="RUT 1:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="RUT 1:20"/>ಆಗ ಆಕೆಯು ಅವರಿಗೆ, “ನನ್ನನ್ನು ‘ನೊವೊಮಿ’<note caller="+" style="f"><char style="fr" closed="false">1:20 </char><char style="fq" closed="false">ನೊವೊಮಿ </char><char style="ft" closed="false">ಎಂದರೆ </char><char style="fqa" closed="false">ರಮಣೀಯ</char></note> ಎಂದು ಕರೆಯಬೇಡಿರಿ. ಮಾರಾ<note caller="+" style="f"><char style="fr" closed="false">1:20 </char><char style="fq" closed="false">ಮಾರಾ </char><char style="ft" closed="false">ಎಂದರೆ </char><char style="fqa" closed="false">ಕಹಿ</char></note> ಎಂದು ಕರೆಯಿರಿ ಏಕೆಂದರೆ ಸರ್ವಶಕ್ತರು ನನ್ನನ್ನು ಬಹು ದುಃಖದಿಂದ ನಡೆಸಿದರು. <verse eid="RUT 1:20"/><verse number="21" style="v" sid="RUT 1:21"/>ನಾನು ಪರಿಪೂರ್ಣಳಾಗಿ ಹೊರಟುಹೋದೆನು. ಯೆಹೋವ ದೇವರು ನನ್ನನ್ನು ಏನೂ ಇಲ್ಲದೆ ಬರಮಾಡಿದ್ದಾರೆ. ಯೆಹೋವ ದೇವರು ನನಗೆ ವಿರೋಧವಾಗಿ ಸಾಕ್ಷಿಕೊಟ್ಟು, ಸರ್ವಶಕ್ತರಾದ ದೇವರು ನನಗೆ ವಿರೋಧವಾಗಿ ನನ್ನನ್ನು ಬಾಧಿಸಿರುವುದರಿಂದ ನೀವು ನನ್ನನ್ನು ನೊವೊಮಿ ಎಂದು ಕರೆಯುವುದು ಸರಿಯೇ?” ಎಂದಳು.<verse eid="RUT 1:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="RUT 1:22"/>ಹೀಗೆ ನೊವೊಮಿ ಮೋವಾಬ್ ದೇಶಸ್ಥಳಾದ ರೂತಳೆಂಬ ತನ್ನ ಸೊಸೆಯ ಸಂಗಡ ಮೋವಾಬ್ ದೇಶದಿಂದ ತಿರುಗಿಬಂದಳು. ಅವರು ಜವೆಗೋಧಿಯ ಸುಗ್ಗಿಯ ಕಾಲ ಪ್ರಾರಂಭವಾದಾಗ ಬೇತ್ಲೆಹೇಮಿಗೆ ತಲುಪಿದರು.<verse eid="RUT 1:22"/></para>
  <chapter eid="RUT 1"/>
  <chapter number="2" style="c" sid="RUT 2"/>
  <para style="s1">ರೂತಳು ಬೋವಜನನ್ನು ಸಂಧಿಸಿದ್ದು</para>
  <para style="p">
    <verse number="1" style="v" sid="RUT 2:1"/>ನೊವೊಮಿಯ ಗಂಡ ಎಲೀಮೆಲೆಕನ ಗೋತ್ರದಲ್ಲಿ ಬೋವಜ ಎಂಬ ಹೆಸರುಳ್ಳ ಪ್ರಬಲ ಮತ್ತು ಧನವಂತನಾಗಿರುವ ಬಂಧುವಿದ್ದನು.<verse eid="RUT 2:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="RUT 2:2"/>ಮೋವಾಬ್ಯಳಾದ ರೂತಳು ನೊವೊಮಿಗೆ, “ನಾನು ಹೊಲಕ್ಕೆ ಹೋಗಿ ಯಾರ ದಯೆಯು ನನಗೆ ಆಗುವುದೋ ಅವನ ಹೊಲದಲ್ಲಿ ಹಕ್ಕಲ ತೆನೆಗಳನ್ನು ಕೂಡಿಸಿ ಕೊಳ್ಳುವೆನು,” ಎಂದಳು.</para>
  <para style="p" vid="RUT 2:2">ನೊವೊಮಿ, “ಹೋಗಿ ಬಾ, ಮಗಳೇ,” ಎಂದಳು. <verse eid="RUT 2:2"/><verse number="3" style="v" sid="RUT 2:3"/>ರೂತಳು ಹೊಲದಲ್ಲಿ ಕೊಯ್ಯುವವರ ಹಿಂದೆ ಹೋಗಿ ತೆನೆಗಳನ್ನು ಆಯ್ದುಕೊಳ್ಳುತ್ತಿದ್ದಳು. ಆ ಹೊಲದ ಭಾಗ ಎಲೀಮೆಲೆಕನ ಕುಲದವನಾದ ಬೋವಜನದಾಗಿತ್ತು.<verse eid="RUT 2:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="RUT 2:4"/>ಬೋವಜನು ಬೇತ್ಲೆಹೇಮಿನಿಂದ ಬಂದು ಕೊಯ್ಯುವವರಿಗೆ, “ಯೆಹೋವ ದೇವರು ನಿಮ್ಮ ಸಂಗಡ ಇರಲಿ,” ಎಂದನು.</para>
  <para style="p" vid="RUT 2:4">ಅದಕ್ಕೆ ಅವರು, “ಯೆಹೋವ ದೇವರು ನಿನ್ನನ್ನು ಆಶೀರ್ವದಿಸಲಿ,” ಎಂದರು.<verse eid="RUT 2:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="RUT 2:5"/>ಬೋವಜನು ಕೊಯ್ಯುವವರ ಮೇಲೆ ಮೇಲ್ವಿಚಾರಕನಾಗಿದ್ದ ತನ್ನ ಸೇವಕನಿಗೆ, “ಈ ಯುವತಿ ಯಾರು?” ಎಂದನು.<verse eid="RUT 2:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="RUT 2:6"/>ಅದಕ್ಕೆ ಆ ಮೇಲ್ವಿಚಾರಕನು, “ಇವಳು ಮೋವಾಬ್ ಸೀಮೆಯಿಂದ ನೊವೊಮಿಯ ಸಂಗಡ ಹಿಂದಿರುಗಿ ಬಂದ ಮೋವಾಬಿನ ಯುವತಿ. <verse eid="RUT 2:6"/><verse number="7" style="v" sid="RUT 2:7"/>ಇವಳು, ‘ಕೊಯ್ಯುವವರ ಹಿಂದೆ ಹೋಗಿ ಸಿವುಡುಗಳ ನಡುವೆ ನಾನು ಹಕ್ಕಲಾರಿಸಿಕೊಳ್ಳುವುದಕ್ಕೆ ಅಪ್ಪಣೆಯಾಗಬೇಕು’ ಎಂದು ಕೇಳಿಕೊಂಡಳು. ಸ್ವಲ್ಪ ಸಮಯ ನೆರಳಿನಲ್ಲಿ ವಿಶ್ರಮಿಸಿಕೊಂಡು, ಬೆಳಗಿನಿಂದ ಈವರೆಗೂ ಇಲ್ಲಿಯೇ ಇದ್ದಾಳೆ,” ಎಂದನು.<verse eid="RUT 2:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="RUT 2:8"/>ಆಗ ಬೋವಜನು ರೂತಳಿಗೆ, “ನನ್ನ ಮಗಳೇ, ನನ್ನ ಮಾತನ್ನು ಕೇಳು. ನೀನು ಹಕ್ಕಲಾದುಕೊಳ್ಳಲು ಬೇರೆಯವರ ಹೊಲಕ್ಕೆ ಹೋಗದೆ, ಈ ಸ್ಥಳವನ್ನು ಬಿಟ್ಟು ಹೊರಡದೆ, ಇಲ್ಲಿಯೇ ನನ್ನ ದಾಸಿಗಳ ಜೊತೆಯಲ್ಲಿಯೇ ಇರು. <verse eid="RUT 2:8"/><verse number="9" style="v" sid="RUT 2:9"/>ನಿನ್ನ ಕಣ್ಣುಗಳು ಅವರು ಕೊಯ್ಯುವ ಹೊಲದ ಮೇಲೆ ಇರಲಿ. ಅವರ ಹಿಂದೆಯೇ ಹೋಗು, ಯಾರೂ ನಿನ್ನನ್ನು ಮುಟ್ಟದಹಾಗೆ ಅವರಿಗೆ ಆಜ್ಞಾಪಿಸಿದ್ದೇನೆ. ನಿನಗೆ ದಾಹವಾದರೆ ನೀನು ಪಾತ್ರೆಗಳ ಬಳಿಗೆ ಹೋಗಿ ನನ್ನ ಸೇವಕರು ಸೇದಿಟ್ಟ ನೀರನ್ನು ಕುಡಿ,” ಎಂದನು.<verse eid="RUT 2:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="RUT 2:10"/>ಆಗ ಅವಳು ಅವನಿಗೆ ಸಾಷ್ಟಾಂಗಬಿದ್ದು ವಂದಿಸಿ ಅವನಿಗೆ, “ಪರದೇಶಿಯಾದ ನನ್ನನ್ನು ಕಂಡು ನನ್ನ ಮೇಲೆ ನಿಮ್ಮ ದಯೆಯನ್ನು ತೋರಿಸಿದ್ದು ಏಕೆ?” ಎಂದಳು.<verse eid="RUT 2:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="RUT 2:11"/>ಆಗ ಬೋವಜನು ಅವಳಿಗೆ ಉತ್ತರವಾಗಿ, “ನಿನ್ನ ಗಂಡನು ಸತ್ತ ತರುವಾಯ ನೀನು ನಿನ್ನ ಅತ್ತೆಗೋಸ್ಕರ ಮಾಡಿದ್ದೆಲ್ಲವೂ ನೀನು ನಿನ್ನ ತಂದೆತಾಯಿಗಳನ್ನೂ ನೀನು ಹುಟ್ಟಿದ ದೇಶವನ್ನೂ ಬಿಟ್ಟು ನೀನು ಎಂದಿಗೂ ಅರಿಯದ ಜನರ ಬಳಿಗೆ ಬಂದದ್ದೂ ನನಗೆ ಚೆನ್ನಾಗಿ ತಿಳಿದಿದೆ. <verse eid="RUT 2:11"/><verse number="12" style="v" sid="RUT 2:12"/>ನೀನು ಮಾಡಿದ್ದಕ್ಕೆ ಯೆಹೋವ ದೇವರು ನಿನಗೆ ಬದಲು ಕೊಡಲಿ. ಇಸ್ರಾಯೇಲ್ ದೇವರಾದ ಯೆಹೋವ ದೇವರ ರೆಕ್ಕೆಗಳ ಕೆಳಗೆ ಆಶ್ರಯಿಸಿಕೊಳ್ಳಲು ಬಂದ ನಿನಗೆ ಅವರಿಂದ ದೊಡ್ಡ ಪ್ರತಿಫಲ ಅನುಗ್ರಹಿಸಲಿ,” ಎಂದನು.<verse eid="RUT 2:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="RUT 2:13"/>ಅದಕ್ಕೆ ಅವಳು, “ನನ್ನ ಒಡೆಯನೇ, ನನಗೆ ನಿಮ್ಮ ದೃಷ್ಟಿಯಲ್ಲಿ ಉಪಕಾರವಾಗಲಿ. ಏಕೆಂದರೆ ನಾನು ನಿಮ್ಮ ದಾಸಿಯರಲ್ಲಿ ಒಬ್ಬಳಂತೆ ನಿಲ್ಲುವುದಕ್ಕೂ ಯೋಗ್ಯಳಲ್ಲ ಆದರೂ ದಯೆಯಿಂದ ಮಾತನಾಡಿಸಿದಿರಿ” ಎಂದಳು.<verse eid="RUT 2:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="RUT 2:14"/>ಊಟದ ವೇಳೆಯಲ್ಲಿ ಬೋವಜನು ಅವಳಿಗೆ, “ಇಲ್ಲಿ ಹತ್ತಿರ ಬಂದು ರೊಟ್ಟಿ ತಿಂದು ತುತ್ತನ್ನು ಹುಳಿರಸದಲ್ಲಿ ಅದ್ದಿ ತಿನ್ನು,” ಎಂದನು.</para>
  <para style="p" vid="RUT 2:14">ಅವಳು ಕೊಯ್ಯುವವರ ಬಳಿಯಲ್ಲಿ ಕುಳಿತಳು. ಆಗ ಅವನು ಅವಳಿಗೆ ಹುರಿದ ತೆನೆಯನ್ನು ಕೊಟ್ಟನು. ಅವಳು ತಿಂದು ತೃಪ್ತಿಪಟ್ಟು, ಇನ್ನೂ ಉಳಿಸಿಕೊಂಡಳು. <verse eid="RUT 2:14"/><verse number="15" style="v" sid="RUT 2:15"/>ಅವಳು ಹಕ್ಕಲಾದುಕೊಳ್ಳಲು ಏಳುವಾಗ ಬೋವಜನು ತನ್ನ ಸೇವಕರಿಗೆ ಆಜ್ಞಾಪಿಸಿ, “ಇವಳು ಕೊಯ್ದ ಸಿವುಡುಗಳ ಮಧ್ಯದಲ್ಲಿ ಹಕ್ಕಲಾದುಕೊಳ್ಳಲಿ. ನೀವು ಅವಳನ್ನು ಬೈಯಬೇಡಿರಿ. <verse eid="RUT 2:15"/><verse number="16" style="v" sid="RUT 2:16"/>ಅವಳು ಹಕ್ಕಲಾದುಕೊಳ್ಳುವ ಹಾಗೆ ನೀವು ಅವಳಿಗೋಸ್ಕರ ಸಿವುಡುಗಳಲ್ಲಿ ಕೆಲವನ್ನು ಕೆಳಗೆ ಹಾಕಿರಿ. ಅವಳನ್ನು ಗದರಿಸಬೇಡಿರಿ,” ಎಂದನು.<verse eid="RUT 2:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="RUT 2:17"/>ಹಾಗೆಯೇ ಅವಳು ಸಾಯಂಕಾಲದವರೆಗೂ ಹೊಲದಲ್ಲಿ ಹಕ್ಕಲಾದುಕೊಂಡಳು. ಅವಳು ಹಕ್ಕಲಾದುಕೊಂಡದ್ದನ್ನು ಬಡಿದಾಗ ಅದು ಹೆಚ್ಚು ಕಡಿಮೆ ಮೂವತ್ತು ಕಿಲೋಗ್ರಾಂ ಜವೆಗೋಧಿಯಾಗಿತ್ತು. <verse eid="RUT 2:17"/><verse number="18" style="v" sid="RUT 2:18"/>ಅವಳು ಅದನ್ನು ತೆಗೆದುಕೊಂಡು ಪಟ್ಟಣಕ್ಕೆ ಬಂದಳು. ಅವಳು ಹಕ್ಕಲಾದುಕೊಂಡಿದ್ದನ್ನು ಅವಳ ಅತ್ತೆಯು ಕಂಡಳು. ರೂತಳು ತೃಪ್ತಿಯಾದ ಮೇಲೆ ಉಳಿಸಿ ತಂದದ್ದನ್ನು ಅವಳಿಗೆ ಕೊಟ್ಟಳು.<verse eid="RUT 2:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="RUT 2:19"/>ಆಗ ರೂತಳ ಅತ್ತೆಯು ಆಕೆಗೆ, “ನೀನು ಈ ಹೊತ್ತು ಎಲ್ಲಿ ಹಕ್ಕಲಾದುಕೊಂಡೆ? ಎಲ್ಲಿ ಕೆಲಸಮಾಡಿದೆ? ನಿನ್ನನ್ನು ಪರಾಮರಿಸಿದವನಿಗೆ ಆಶೀರ್ವಾದವಾಗಲಿ,” ಎಂದಳು.</para>
  <para style="p" vid="RUT 2:19">ಅದಕ್ಕವಳು ತಾನು ಯಾರ ಹತ್ತಿರ ಕೆಲಸಮಾಡಿದಳೋ ಅದನ್ನು ತನ್ನ ಅತ್ತೆಗೆ ತಿಳಿಸಿ, “ನಾನು ಈ ಹೊತ್ತು ಕೆಲಸ ಮಾಡಿದವನ ಹೆಸರು ಬೋವಜ,” ಎಂದು ಹೇಳಿದಳು.<verse eid="RUT 2:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="RUT 2:20"/>ನೊವೊಮಿ ತನ್ನ ಸೊಸೆಗೆ, “ಜೀವಂತ ಇರುವವರಿಗೂ ಸತ್ತವರಿಗೂ ದಯೆ ತೋರಿಸುತ್ತಿರುವ ಯೆಹೋವ ದೇವರಿಂದ ಅವನಿಗೆ ಆಶೀರ್ವಾದವಾಗಲಿ,” ಎಂದಳು. ಅನಂತರ ನೊವೊಮಿ ಅವಳಿಗೆ, “ಆ ಮನುಷ್ಯನು ನಮ್ಮ ಬಂಧುವೂ ವಿಮೋಚಿಸತಕ್ಕ<note caller="+" style="f"><char style="fr" closed="false">2:20 </char><char style="fq" closed="false">ವಿಮೋಚಿಸತಕ್ಕ </char><char style="ft" closed="false">ಅಂದರೆ </char><char style="fqa" closed="false">ತೀವ್ರ ತೊಂದರೆಯಲ್ಲಿರುವ ಸಂಬಂಧಿಯನ್ನು ರಕ್ಷಿಸುವ ಬಾಧ್ಯತೆ</char></note> ನಮ್ಮ ಬಾಧ್ಯರಲ್ಲಿ ಒಬ್ಬನಾಗಿಯೂ ಇದ್ದಾನೆ,” ಎಂದಳು.<verse eid="RUT 2:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="RUT 2:21"/>ಅದಕ್ಕೆ ಮೋವಾಬ್ಯಳಾದ ರೂತಳು, “ಅವನು, ‘ನನ್ನ ಪೈರೆಲ್ಲಾ ಕೊಯ್ದು ತೀರುವವರೆಗೂ, ನೀನು ನನ್ನ ಕೆಲಸದವರ ಸಂಗಡ ಕೂಡಿಕೊಂಡಿರು’ ಎಂದು ನನಗೆ ಹೇಳಿದನು,” ಎಂದಳು.<verse eid="RUT 2:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="RUT 2:22"/>ಆಗ ನೊವೊಮಿಯು ತನ್ನ ಸೊಸೆಯಾದ ರೂತಳಿಗೆ, “ನನ್ನ ಮಗಳೇ, ಮತ್ತೊಂದು ಹೊಲದಲ್ಲಿ ಮನುಷ್ಯರು ನಿನ್ನನ್ನು ಕಂಡುಕೊಳ್ಳದ ಹಾಗೆ ನೀನು ಅವನ ದಾಸಿಗಳ ಸಂಗಡ ಹೊರಟುಹೋಗುವುದು ಒಳ್ಳೆಯದು,” ಎಂದಳು.<verse eid="RUT 2:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="RUT 2:23"/>ಹೀಗೆ ಅವಳು ತನ್ನ ಅತ್ತೆಯ ಮನೆಯಲ್ಲಿ ವಾಸವಾಗಿದ್ದು ಹಾಗೆಯೇ ಜವೆಗೋಧಿಯ ಸುಗ್ಗಿಯು ತೀರುವವರೆಗೆ ಹಕ್ಕಲಾದುಕೊಳ್ಳುವುದಕ್ಕೋಸ್ಕರ ಬೋವಜನ ದಾಸಿಗಳ ಸಂಗಡ ಕೂಡಿಕೊಂಡು ಹೋಗುತ್ತಿದ್ದಳು.<verse eid="RUT 2:23"/></para>
  <chapter eid="RUT 2"/>
  <chapter number="3" style="c" sid="RUT 3"/>
  <para style="s1">ರಾಶಿಮಾಡುವ ಕಣದಲ್ಲಿ ರೂತ್ ಹಾಗೂ ಬೋವಜ</para>
  <para style="p">
    <verse number="1" style="v" sid="RUT 3:1"/>ಒಂದು ದಿನ ರೂತಳ ಅತ್ತೆ ನೊವೊಮಿಯು ಅವಳಿಗೆ, “ನನ್ನ ಮಗಳೇ, ನೀನು ಮತ್ತೆ ಗೃಹಿಣಿಯಾಗಿ ಸುಖದಿಂದ ಬಾಳುವಂತೆ, ನಾನು ನಿನಗೆ ವಿಶ್ರಾಂತಿ ಸ್ಥಳ ಏರ್ಪಾಟು ಮಾಡುವುದು ನನ್ನ ಕರ್ತವ್ಯವಲ್ಲವೇ? <verse eid="RUT 3:1"/><verse number="2" style="v" sid="RUT 3:2"/>ಈಗ ನೀನು ಯಾರ ದಾಸಿಯರ ಸಂಗಡ ಇದ್ದೀಯೋ, ಆ ಬೋವಜನು ನಮ್ಮ ಬಂಧುವಾಗಿದ್ದಾನೆ. ಇಗೋ, ಅವನು ರಾತ್ರಿಯಲ್ಲಿ ಕಣದಲ್ಲಿ ಜವೆಗೋಧಿಯನ್ನು ತೂರುವನು. <verse eid="RUT 3:2"/><verse number="3" style="v" sid="RUT 3:3"/>ನೀನು ಸ್ನಾನಮಾಡಿ ಎಣ್ಣೆ ಹಚ್ಚಿಕೊಂಡು ನಿನ್ನ ಒಳ್ಳೆಯ ವಸ್ತ್ರಗಳನ್ನು ಧರಿಸಿಕೊಂಡು ಆ ಕಣಕ್ಕೆ ಹೋಗು. ಆದರೆ ಆ ಮನುಷ್ಯನು ತಿಂದು ಕುಡಿದು ತೀರಿಸುವವರೆಗೂ ಅವನಿಗೆ ನೀನು ಅಲ್ಲಿರುವದು ಅವನಿಗೆ ತಿಳಿಯದಿರಲಿ. <verse eid="RUT 3:3"/><verse number="4" style="v" sid="RUT 3:4"/>ಅವನು ಮಲಗಿಕೊಂಡಾಗ ಅವನು ಮಲಗಿರುವ ಸ್ಥಳವನ್ನು ನೀನು ತಿಳಿದುಕೊಂಡು ಹೋಗಿ ಅವನ ಪಾದಗಳ ಮೇಲಿನ ಹೊದಿಕೆಯನ್ನು ತೆಗೆದು ಮಲಗಿಕೋ. ಆಗ ನೀನು ಮಾಡಬೇಕಾದದ್ದೇನೆಂದು ಅವನು ನಿನಗೆ ತಿಳಿಸುವನು,” ಎಂದಳು.<verse eid="RUT 3:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="RUT 3:5"/>ಅದಕ್ಕೆ ರೂತಳು, “ನೀವು ನನಗೆ ಹೇಳಿದ್ದನ್ನೆಲ್ಲಾ ಮಾಡುವೆನು,” ಎಂದಳು. <verse eid="RUT 3:5"/><verse number="6" style="v" sid="RUT 3:6"/>ಅವಳು ಆ ಕಣಕ್ಕೆ ಹೋಗಿ ತನ್ನ ಅತ್ತೆ ತನಗೆ ಆಜ್ಞಾಪಿಸಿದ ಪ್ರಕಾರವೇ ಮಾಡಿದಳು.<verse eid="RUT 3:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="RUT 3:7"/>ಬೋವಜನು ತಿಂದು ಕುಡಿದು ಸಂತುಷ್ಟನಾಗಿದ್ದನು. ಅವನು ಕಾಳಿನ ರಾಶಿಯ ಕೊನೆಯಲ್ಲಿ ಬಂದು ಮಲಗಿಕೊಂಡನು. ಆಗ ರೂತಳು ಮೆಲ್ಲಗೆ ಬಂದು ಅವನ ಪಾದಗಳ ಮೇಲಿದ್ದ ಹೊದಿಕೆಯನ್ನು ತೆಗೆದು ಮಲಗಿಕೊಂಡಳು. <verse eid="RUT 3:7"/><verse number="8" style="v" sid="RUT 3:8"/>ಆದರೆ ಮಧ್ಯರಾತ್ರಿಯಲ್ಲಿ ಬೋವಜನು ಹೆದರಿ ತಿರುಗಿ ನೋಡಿದಾಗ ಇಗೋ, ಒಬ್ಬ ಸ್ತ್ರೀ ತನ್ನ ಕಾಲುಗಳ ಬಳಿಯಲ್ಲಿ ಮಲಗಿರುವುದನ್ನು ಕಂಡನು.<verse eid="RUT 3:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="RUT 3:9"/>ಆಗ ಅವನು, “ನೀನು ಯಾರು?” ಎಂದನು.</para>
  <para style="p" vid="RUT 3:9">ಅದಕ್ಕವಳು, “ನಾನು ನಿಮ್ಮ ದಾಸಿಯಾದ ರೂತಳು. ನೀವು ನಿಮ್ಮ ಹೊದಿಕೆಯ ಅಂಚನ್ನು ನನ್ನ ಮೇಲೆ ಹಾಕಿರಿ. ಏಕೆಂದರೆ ನೀವು ನನ್ನನ್ನು ವಿಮೋಚಿಸತಕ್ಕ ಹತ್ತಿರ ಸಂಬಂಧಿಕನು,” ಎಂದಳು.<verse eid="RUT 3:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="RUT 3:10"/>ಅದಕ್ಕೆ ಅವನು, “ನನ್ನ ಮಗಳೇ, ಯೆಹೋವ ದೇವರಿಂದ ನಿನಗೆ ಆಶೀರ್ವಾದವಾಗಲಿ, ಬಡವರೂ ಐಶ್ವರ್ಯವಂತರೂ ಆದ ಯೌವನಸ್ಥರ ಹಿಂದೆ ನೀನು ಹೋಗದೆ ಇದ್ದುದರಿಂದ ಮೊದಲು ತೋರಿಸಿದ್ದಕ್ಕಿಂತ ಕಡೆಯಲ್ಲಿ ನೀನು ತೋರಿಸಿದ ದಯೆಯು ಹೆಚ್ಚಾಗಿದೆ. <verse eid="RUT 3:10"/><verse number="11" style="v" sid="RUT 3:11"/>ಈಗ ನನ್ನ ಮಗಳೇ, ನೀನು ಭಯಪಡಬೇಡ. ನಿನಗೆ ಬೇಕಾಗಿರುವುದನ್ನು ನಿನಗೆ ಮಾಡುವೆನು. ನೀನು ಗುಣವತಿಯಾದ ಸ್ತ್ರೀ ಎಂದು ಪಟ್ಟಣದಲ್ಲಿರುವ ನನ್ನ ಜನರೆಲ್ಲರೂ ಬಲ್ಲರು. <verse eid="RUT 3:11"/><verse number="12" style="v" sid="RUT 3:12"/>ಈಗ ನಾನು ನಿನ್ನ ವಿಮೋಚಿಸತಕ್ಕ ಸಮೀಪ ಬಂಧುವಾಗಿದ್ದೇನೆ ಎಂಬುದು ನಿಜವೇ. ಆದರೆ ನನಗಿಂತಲೂ ಸಮೀಪಸ್ಥನಾದ ಬಂಧುವು ಒಬ್ಬನಿದ್ದಾನೆ. <verse eid="RUT 3:12"/><verse number="13" style="v" sid="RUT 3:13"/>ಈ ರಾತ್ರಿಯಲ್ಲಿ ಇಲ್ಲಿರು. ನಾಳೆ ಬೆಳಿಗ್ಗೆ ಅವನು ನಿನಗೆ ವಿಮೋಚಕ ಬಂಧುವಿನ ಕರ್ತವ್ಯ ಮಾಡಿದರೆ ಒಳ್ಳೆಯದು. ಅವನು ನಿನಗೆ ವಿಮೋಚಕ ಬಂಧುವಿನ ಕರ್ತವ್ಯ ಮಾಡಲು ಮನಸ್ಸಿಲ್ಲದಿದ್ದರೆ ಯೆಹೋವ ದೇವರ ಜೀವದಾಣೆ, ನಾನೇ ಅದನ್ನು ಮಾಡುವೆನು. ಉದಯಕಾಲದವರೆಗೂ ಇಲ್ಲಿಯೇ ಮಲಗಿರು,” ಎಂದನು.<verse eid="RUT 3:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="RUT 3:14"/>ಅವಳು ಹಾಗೆಯೇ ಉದಯಕಾಲದವರೆಗೂ ಅವನ ಪಾದಗಳ ಬಳಿಯಲ್ಲಿ ಮಲಗಿದ್ದು ಯಾರಿಗೂ ಗೊತ್ತಾಗಬಾರದೆಂದು ಹೊತ್ತಿಗೆ ಮುಂಚೆ ಎದ್ದಳು. ಅವನು, “ಒಬ್ಬ ಸ್ತ್ರೀ ಕಣದಲ್ಲಿ ಬಂದಳೆಂದು ಯಾರಿಗೂ ತಿಳಿಯದಿರಲಿ,” ಎಂದನು.<verse eid="RUT 3:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="RUT 3:15"/>ಅವನು, “ನಿನ್ನ ಮೇಲ್ಹೊದಿಕೆಯನ್ನು ಹಿಡಿ,” ಎಂದನು. ಅವಳು ಅದನ್ನು ಹಿಡಿದಾಗ ಅವನು ಅದರಲ್ಲಿ ಸುಮಾರು ಇಪ್ಪತ್ತೈದು ಕಿಲೋಗ್ರಾಂ ಜವೆಗೋಧಿಯನ್ನು ಅಳೆದು ಹಾಕಿ ಆಕೆಯ ಮೇಲೆ ಹೊರಿಸಿದನು. ಅವಳು ಅದನ್ನು ಹೊತ್ತುಕೊಂಡು ಪಟ್ಟಣಕ್ಕೆ ಬಂದಳು.<verse eid="RUT 3:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="RUT 3:16"/>ಅವಳು ತನ್ನ ಅತ್ತೆಯ ಬಳಿಗೆ ಬಂದಾಗ ಅವಳ ಅತ್ತೆಯು, “ನನ್ನ ಮಗಳೇ, ಏನು ನಡೆಯಿತು?” ಎಂದಳು.</para>
  <para style="p" vid="RUT 3:16">ಆಗ ಅವಳು ಆ ಮನುಷ್ಯನು ತನಗೆ ಮಾಡಿದ್ದನ್ನೆಲ್ಲಾ ಅವಳಿಗೆ ತಿಳಿಸಿದಳು. <verse eid="RUT 3:16"/><verse number="17" style="v" sid="RUT 3:17"/>“ ‘ನೀನು ನಿನ್ನ ಅತ್ತೆಯ ಬಳಿಗೆ ಬರೀ ಕೈಯಾಗಿ ಹೋಗಬಾರದು’ ಎಂದು ಅವನು ಸುಮಾರು ಇಪ್ಪತ್ತೈದು ಕಿಲೋಗ್ರಾಂ ಜವೆಗೋಧಿಯನ್ನು ನನಗೆ ಕೊಟ್ಟನು,” ಎಂದಳು.<verse eid="RUT 3:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="RUT 3:18"/>ಅದಕ್ಕೆ ನೊವೊಮಿ, “ನನ್ನ ಮಗಳೇ, ಈ ಕಾರ್ಯ ಏನಾಗುವುದೋ, ಎಂದು ನೀನು ತಿಳಿಯುವವರೆಗೂ ಸುಮ್ಮನೆ ಇರು. ಆ ಮನುಷ್ಯನು ಈ ಹೊತ್ತು ಈ ಕಾರ್ಯವನ್ನು ತೀರಿಸುವವರೆಗೂ ವಿಶ್ರಾಂತಿಯಲ್ಲಿ ಇರಲಾರನು,” ಎಂದಳು.<verse eid="RUT 3:18"/></para>
  <chapter eid="RUT 3"/>
  <chapter number="4" style="c" sid="RUT 4"/>
  <para style="s1">ಬೋವಜನು ರೂತಳನ್ನು ಮದುವೆಯಾದದ್ದು</para>
  <para style="p">
    <verse number="1" style="v" sid="RUT 4:1"/>ಬೋವಜನು ಪಟ್ಟಣದ ಬಾಗಿಲ ಬಳಿ ಹೋಗಿ ಕುಳಿತುಕೊಂಡನು. ಆಗ ಬೋವಜನು ಹೇಳಿದ್ದ ಆ ವಿಮೋಚಕ ಬಂಧುವು ಹಾದುಹೋಗುತ್ತಿದ್ದನು. ಬೋವಜನು ಅವನಿಗೆ, “ನನ್ನ ಸ್ನೇಹಿತನೇ, ಈ ಕಡೆಗೆ ಬಂದು ಇಲ್ಲಿ ಕುಳಿತುಕೋ,” ಎಂದನು. ಅವನು ಬಂದು ಕುಳಿತುಕೊಂಡನು.<verse eid="RUT 4:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="RUT 4:2"/>ಆಗ ಬೋವಜನು ಪಟ್ಟಣದ ಹಿರಿಯರಲ್ಲಿ ಹತ್ತು ಮಂದಿಯನ್ನು ಕರೆದು ಅವರಿಗೆ, “ಇಲ್ಲಿ ಕುಳಿತುಕೊಳ್ಳಿರಿ,” ಎಂದನು. ಅವರು ಕುಳಿತರು. <verse eid="RUT 4:2"/><verse number="3" style="v" sid="RUT 4:3"/>ಆಗ ಬೋವಜನು ಆ ವಿಮೋಚಕ ಬಂಧುವಿಗೆ ಹೇಳಿದ್ದೇನೆಂದರೆ, “ಮೋವಾಬ್ ಸೀಮೆಯಿಂದ ತಿರುಗಿ ಬಂದ ನೊವೊಮಿಯು ನಮ್ಮ ಸಹೋದರನಾದ ಎಲೀಮೆಲೆಕನಿಗೆ ಇದ್ದ ಹೊಲದ ಪಾಲನ್ನು ಮಾರಿಬಿಡಬೇಕೆಂದಿರುತ್ತಾಳೆ. <verse eid="RUT 4:3"/><verse number="4" style="v" sid="RUT 4:4"/>ನಿವಾಸಿಗಳ ಮುಂದೆಯೂ ನನ್ನ ಜನರಾದ ಹಿರಿಯರ ಮುಂದೆಯೂ ಅದನ್ನು ಕೊಂಡು ಬಿಡಿಸಿಕೊಂಡರೆ ಬಿಡಿಸಿಕೋ. ಬಿಡಿಸಿಕೊಳ್ಳದಿದ್ದರೆ ನಾನು ತಿಳಿದುಕೊಳ್ಳುವ ಹಾಗೆ ನನಗೆ ಹೇಳು. ಏಕೆಂದರೆ ನೀನೂ ನಿನ್ನ ತರುವಾಯ ನಾನೂ ಅಲ್ಲದೆ ಬಿಡಿಸಿಕೊಳ್ಳುವವನು ಯಾರೂ ಇಲ್ಲ,” ಎಂದು ಹೇಳಿದನು.</para>
  <para style="p" vid="RUT 4:4">ಅದಕ್ಕೆ ಅವನು, “ನಾನು ಬಿಡಿಸಿಕೊಳ್ಳುವೆನು,” ಎಂದನು.<verse eid="RUT 4:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="RUT 4:5"/>ಆಗ ಬೋವಜನು, “ನೀನು ನೊವೊಮಿಯಿಂದ ಆ ಹೊಲವನ್ನು ಕೊಂಡುಕೊಳ್ಳುವ ದಿವಸದಲ್ಲಿ ಸತ್ತವನ ಬಾಧ್ಯತೆಯಲ್ಲಿ ಅವನ ಹೆಸರನ್ನು ಸ್ಥಿರಮಾಡುವ ಹಾಗೆ ಅವನ ಹೆಂಡತಿಯಾಗಿದ್ದ ಮೋವಾಬ್ಯಳಾದ ರೂತಳನ್ನು ತೆಗೆದುಕೊಳ್ಳಬೇಕು,” ಎಂದನು.<verse eid="RUT 4:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="RUT 4:6"/>ಅದಕ್ಕೆ ಆ ಬಂಧುವು, “ನಾನು ನನ್ನ ಬಾಧ್ಯತೆಯನ್ನು ನಷ್ಟಪಡಿಸಿಕೊಳ್ಳದ ಹಾಗೆ ಅದನ್ನು ಬಿಡಿಸಿಕೊಳ್ಳಲಾರೆನು. ನಾನು ಬಿಡಿಸಿಕೊಳ್ಳತಕ್ಕದ್ದನ್ನು ನೀನು ಬಿಡಿಸಿಕೋ; ಏಕೆಂದರೆ ನಾನು ಬಿಡಿಸಿಕೊಳ್ಳಲಾರೆನು,” ಎಂದನು.<verse eid="RUT 4:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="RUT 4:7"/>ಬಿಡಿಸಿಕೊಳ್ಳುವುದರಲ್ಲಿಯೂ ಬದಲು ಮಾಡುವುದರಲ್ಲಿಯೂ ಸಕಲ ಕಾರ್ಯಗಳೂ ದೃಢವಾಗುವ ಹಾಗೆ ಇಸ್ರಾಯೇಲಿನಲ್ಲಿ ಒಂದು ವಾಡಿಕೆಯಿತ್ತು. ಅದು ಕೊಡುವವನು ಕೊಳ್ಳುವವನಿಗೆ ತನ್ನ ಕೆರವನ್ನು ತೆಗೆದು ತನ್ನ ನೆರೆಯವನಿಗೆ ಕೊಡುತ್ತಿದ್ದನು. ಇದು ಇಸ್ರಾಯೇಲಿನಲ್ಲಿ ವ್ಯವಹಾರವನ್ನು ಕಾನೂನು ಬದ್ಧಗೊಳಿಸುವ ವಿಧಾನವಾಗಿತ್ತು.<verse eid="RUT 4:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="RUT 4:8"/>ಹಾಗೆಯೇ ಆ ಬಂಧುವು ಬೋವಜನಿಗೆ, “ನೀನೇ ನಿನಗೋಸ್ಕರ ಅದನ್ನು ಕೊಂಡುಕೋ,” ಎಂದು ತನ್ನ ಕೆರವನ್ನು ತೆಗೆದುಹಾಕಿದನು.<verse eid="RUT 4:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="RUT 4:9"/>ಆಗ ಬೋವಜನು ಹಿರಿಯರಿಗೂ ಸಮಸ್ತ ಜನರಿಗೂ, “ನಾನು ಎಲೀಮೆಲೆಕನಿಗೆ ಇದ್ದ ಎಲ್ಲವನ್ನೂ ಕಿಲ್ಯೋನನಿಗೂ ಮಹ್ಲೋನನಿಗೂ ಇದ್ದ ಎಲ್ಲವನ್ನೂ ನೊವೊಮಿಯ ಕೈಯಿಂದ ಕೊಂಡುಕೊಂಡೆನು ಎಂಬುದಕ್ಕೆ ಈ ದಿನ ನೀವು ಸಾಕ್ಷಿಗಳಾಗಿದ್ದೀರಿ. <verse eid="RUT 4:9"/><verse number="10" style="v" sid="RUT 4:10"/>ಇದಲ್ಲದೆ ಸತ್ತವನ ಹೆಸರನ್ನು ಸ್ಥಿರಮಾಡಲು ನಾನು ಮಹ್ಲೋನನ ಹೆಂಡತಿಯಾಗಿದ್ದ ಮೋವಾಬ್ಯಳಾದ ರೂತಳನ್ನು ನನಗೆ ಹೆಂಡತಿಯಾಗಿ ಸ್ವೀಕರಿಸಿದ್ದೇನೆ. ಇದರಿಂದ ಹೊಲದ ಖಾತೆಯು ಗತಿಸಿದ ಮಹ್ಲೋನನ ಹೆಸರಿನಲ್ಲಿಯೇ ಉಳಿಯುವುದು. ಅವನ ಹೆಸರೂ ಅವನ ವಂಶವೂ ಊರಲ್ಲಿಯೇ ನೆಲೆಯಾಗಿರುವುದು. ಇದಕ್ಕೆ ಈ ದಿನ ನೀವು ಸಾಕ್ಷಿಗಳಾಗಿದ್ದೀರಿ,” ಎಂದನು.<verse eid="RUT 4:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="RUT 4:11"/>ಆಗ ಊರುಬಾಗಿಲಲ್ಲಿ ಕೂಡಿದ್ದ ಸಮಸ್ತ ಜನರೂ ಹಿರಿಯರೂ, “ನಾವು ಸಾಕ್ಷಿಗಳೇ, ನಿನ್ನ ಮನೆಯಲ್ಲಿ ಬಂದ ಸ್ತ್ರೀಯನ್ನು ಯೆಹೋವ ದೇವರು ಇಸ್ರಾಯೇಲ್ ಮನೆಯನ್ನು ಕಟ್ಟಿದ ಇಬ್ಬರಾದ ರಾಹೇಲಳ ಹಾಗೆಯೂ ಲೇಯಳ ಹಾಗೆಯೂ ಮಾಡಲಿ. ಎಫ್ರಾತದಲ್ಲಿ ಧನವಂತನಾಗಿರು, ಬೇತ್ಲೆಹೇಮಿನಲ್ಲಿ ಘನವಂತನಾಗಿರು. <verse eid="RUT 4:11"/><verse number="12" style="v" sid="RUT 4:12"/>ಈ ಹುಡುಗಿಯಿಂದ ಯೆಹೋವ ದೇವರು ನಿನಗೆ ಕೊಡುವ ಸಂತಾನದಿಂದ ನಿನ್ನ ಮನೆಯು ತಾಮಾರಳು ಯೆಹೂದನಿಗೆ ಹೆತ್ತ ಪೆರೆಚನ ಮನೆಯ ಹಾಗೆಯೇ ಆಗಲಿ,” ಎಂದರು.<verse eid="RUT 4:12"/></para>
  <para style="s1">ನೊವೊಮಿ ಒಬ್ಬ ಮಗನನ್ನು ಪಡೆದದ್ದು</para>
  <para style="p">
    <verse number="13" style="v" sid="RUT 4:13"/>ಬೋವಜನು ರೂತಳನ್ನು ಮದುವೆಯಾದನು. ಅವಳು ಅವನಿಗೆ ಹೆಂಡತಿಯಾದಳು. ಅವನು ಅವಳೊಂದಿಗೆ ಬಾಳಿದಾಗ, ರೂತಳು ಯೆಹೋವ ದೇವರ ಅನುಗ್ರಹದಿಂದ ಗರ್ಭಿಣಿಯಾಗಿ ಒಬ್ಬ ಮಗನನ್ನು ಹೆತ್ತಳು. <verse eid="RUT 4:13"/><verse number="14" style="v" sid="RUT 4:14"/>ಆಗ ಸ್ತ್ರೀಯರು ನೊವೊಮಿಗೆ, “ಇಸ್ರಾಯೇಲಿನಲ್ಲಿ ವಿಮೋಚಿಸತಕ್ಕ ಬಾಧ್ಯಸ್ಥನನ್ನು ನಿನಗೆ ಅನುಗ್ರಹಿಸಿದ ಯೆಹೋವ ದೇವರಿಗೆ ಸ್ತೋತ್ರವಾಗಲಿ. ಈ ಮಗನು ಪ್ರಖ್ಯಾತನಾಗಲಿ. <verse eid="RUT 4:14"/><verse number="15" style="v" sid="RUT 4:15"/>ಅವನು ನಿನಗೆ ಪ್ರಾಣವನ್ನು ಪುನರುಜ್ಜೀವಿಸುವವನಾಗಿಯೂ ನಿನ್ನ ವೃದ್ಧ ವಯಸ್ಸಿನಲ್ಲಿ ಸಂರಕ್ಷಿಸುವವನಾಗಿಯೂ ಇರುವನು. ಏಕೆಂದರೆ ನಿನ್ನನ್ನು ಪ್ರೀತಿ ಮಾಡುವ ಏಳುಮಂದಿ ಮಕ್ಕಳಿಗಿಂತ ನಿನಗೆ ಉತ್ತಮಳಾಗಿರುವ ನಿನ್ನ ಸೊಸೆಯು ಅವನನ್ನು ಹೆತ್ತಳು,” ಎಂದರು.<verse eid="RUT 4:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="RUT 4:16"/>ನೊವೊಮಿಯು ಆ ಮಗುವನ್ನು ಎತ್ತಿ ತನ್ನ ಉಡಿಲಲ್ಲಿ ಇಟ್ಟುಕೊಂಡು ಅದಕ್ಕೆ ದಾದಿಯಾದಳು. <verse eid="RUT 4:16"/><verse number="17" style="v" sid="RUT 4:17"/>ಆಗ ನೆರೆಹೊರೆಯ ಸ್ತ್ರೀಯರು ನೊವೊಮಿಗೆ, “ಒಬ್ಬ ಮಗನು ಹುಟ್ಟಿದ್ದಾನೆ,” ಎಂದು ಹೇಳಿ ಅವನಿಗೆ ಓಬೇದನೆಂದು ಹೆಸರಿಟ್ಟರು. ಇವನೇ ದಾವೀದನ ತಂದೆಯಾದ ಇಷಯನಿಗೆ ತಂದೆಯಾದವನು.<verse eid="RUT 4:17"/></para>
  <para style="s1">ದಾವೀದನ ವಂಶಾವಳಿ</para>
  <para style="li4">
    <verse number="18" style="v" sid="RUT 4:18"/>ಪೆರೆಚನ ಸಂತತಿಯ ವಿವರ:</para>
  <para style="b" vid="RUT 4:18"/>
  <para style="li1" vid="RUT 4:18">ಪೆರೆಚನು ಹೆಚ್ರೋನನ ತಂದೆಯಾಗಿದ್ದನು;<verse eid="RUT 4:18"/></para>
  <para style="li1">
    <verse number="19" style="v" sid="RUT 4:19"/>ಹೆಚ್ರೋನನು ರಾಮನ ತಂದೆಯಾಗಿದ್ದನು;</para>
  <para style="li1" vid="RUT 4:19">ರಾಮನು ಅಮ್ಮೀನಾದಾಬನ ತಂದೆಯಾಗಿದ್ದನು;<verse eid="RUT 4:19"/></para>
  <para style="li1">
    <verse number="20" style="v" sid="RUT 4:20"/>ಅಮ್ಮೀನಾದಾಬನು ನಹಶೋನನ ತಂದೆಯಾಗಿದ್ದನು;</para>
  <para style="li1" vid="RUT 4:20">ನಹಶೋನನು ಸಲ್ಮೋನನ ತಂದೆಯಾಗಿದ್ದನು;<verse eid="RUT 4:20"/></para>
  <para style="li1">
    <verse number="21" style="v" sid="RUT 4:21"/>ಸಲ್ಮೋನನು ಬೋವಜನ ತಂದೆಯಾಗಿದ್ದನು;</para>
  <para style="li1" vid="RUT 4:21">ಬೋವಜನು ಓಬೇದನ ತಂದೆಯಾಗಿದ್ದನು;<verse eid="RUT 4:21"/></para>
  <para style="li1">
    <verse number="22" style="v" sid="RUT 4:22"/>ಓಬೇದನು ಇಷಯನ ತಂದೆಯಾಗಿದ್ದನು;</para>
  <para style="li1" vid="RUT 4:22">ಇಷಯನು ದಾವೀದನ ತಂದೆಯಾಗಿದ್ದನು.<verse eid="RUT 4:22"/></para>
  <chapter eid="RUT 4"/>
</usx>
