<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="ECC" style="id">- Biblica® Open Kannada Contemporary Version</book>
  <para style="h">ಪ್ರಸಂಗಿ</para>
  <para style="toc1">ಪ್ರಸಂಗಿ</para>
  <para style="toc2">ಪ್ರಸಂಗಿ</para>
  <para style="toc3">ಪ್ರಸಂಗಿ</para>
  <para style="mt1">ಪ್ರಸಂಗಿ</para>
  <chapter number="1" style="c" sid="ECC 1"/>
  <para style="s1">ಸಮಸ್ತವೂ ವ್ಯರ್ಥ</para>
  <para style="p">
    <verse number="1" style="v" sid="ECC 1:1"/>ದಾವೀದನ ಮಗನೂ ಯೆರೂಸಲೇಮಿನ ಅರಸನೂ ಆದ ಪ್ರಸಂಗಿಯ ಮಾತುಗಳು:<verse eid="ECC 1:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="ECC 1:2"/>“ವ್ಯರ್ಥಗಳಲ್ಲಿ ವ್ಯರ್ಥ! ವ್ಯರ್ಥಗಳಲ್ಲಿ ವ್ಯರ್ಥ!”</para>
  <para style="q2" vid="ECC 1:2">ಎಂದು ಪ್ರಸಂಗಿ ಹೇಳುತ್ತಾನೆ.</para>
  <para style="q1" vid="ECC 1:2">“ಸಮಸ್ತವೂ ವ್ಯರ್ಥ!</para>
  <para style="q2" vid="ECC 1:2">ಎಲ್ಲವೂ ವ್ಯರ್ಥ.”<verse eid="ECC 1:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="ECC 1:3"/>ಸೂರ್ಯನ ಕೆಳಗೆ ಮನುಷ್ಯನು ಪಡುವ</para>
  <para style="q2" vid="ECC 1:3">ಎಲ್ಲಾ ಪ್ರಯಾಸಗಳಿಂದ ಅವನಿಗೆ ಲಾಭವೇನು?<verse eid="ECC 1:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="ECC 1:4"/>ಸಂತತಿಗಳು ಬರುತ್ತವೆ, ಸಂತತಿಗಳು ಹೋಗುತ್ತವೆ;</para>
  <para style="q2" vid="ECC 1:4">ಆದರೆ ಭೂಮಿಯು ಶಾಶ್ವತವಾಗಿ ಉಳಿಯುತ್ತದೆ.<verse eid="ECC 1:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="ECC 1:5"/>ಸೂರ್ಯನು ಉದಯಿಸುತ್ತಾನೆ, ಸೂರ್ಯನು ಮುಳುಗುತ್ತಾನೆ.</para>
  <para style="q2" vid="ECC 1:5">ತಾನು ಉದಯಿಸುವ ಸ್ಥಳಕ್ಕೆ ಆತುರದಿಂದ ಹಿಂದಿರುಗುತ್ತಾನೆ.<verse eid="ECC 1:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="ECC 1:6"/>ಗಾಳಿಯು ದಕ್ಷಿಣದ ಕಡೆಗೆ ಬೀಸುತ್ತದೆ.</para>
  <para style="q2" vid="ECC 1:6">ಉತ್ತರದ ಕಡೆಗೆ ತಿರುಗುತ್ತದೆ.</para>
  <para style="q1" vid="ECC 1:6">ಸುತ್ತುತ್ತಾ, ಸುತ್ತುತ್ತಾ ಹೋಗುತ್ತದೆ.</para>
  <para style="q2" vid="ECC 1:6">ಆ ಗಾಳಿಯು ತನ್ನ ಸುತ್ತಳತೆಗಳ ಪ್ರಕಾರ ಹಿಂದಿರುಗುತ್ತದೆ.<verse eid="ECC 1:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="ECC 1:7"/>ನದಿಗಳೆಲ್ಲಾ ಸಮುದ್ರಕ್ಕೆ ಹರಿದು ಹೋಗುತ್ತವೆ.</para>
  <para style="q2" vid="ECC 1:7">ಆದರೂ ಸಮುದ್ರವು ತುಂಬುವುದಿಲ್ಲ.</para>
  <para style="q1" vid="ECC 1:7">ನದಿಗಳು ಎಲ್ಲಿಂದ ಬಂದಿವೆಯೋ,</para>
  <para style="q2" vid="ECC 1:7">ಆ ಸ್ಥಳಕ್ಕೆ ಅವು ಹಿಂದಿರುಗುತ್ತವೆ.<verse eid="ECC 1:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="ECC 1:8"/>ಎಲ್ಲಾ ಕಾರ್ಯಗಳು ಪ್ರಯಾಸದಿಂದ ತುಂಬಿವೆ.</para>
  <para style="q2" vid="ECC 1:8">ಇದನ್ನು ಮನುಷ್ಯನು ವಿವರಿಸಲಾರನು.</para>
  <para style="q1" vid="ECC 1:8">ನೋಡುವುದರಿಂದ ಕಣ್ಣು ತೃಪ್ತಿಗೊಳ್ಳದು,</para>
  <para style="q2" vid="ECC 1:8">ಕೇಳುವುದರಿಂದ ಕಿವಿಯು ದಣಿಯದು.<verse eid="ECC 1:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="ECC 1:9"/>ಇದ್ದದ್ದೇ ಇರುವುದು,</para>
  <para style="q2" vid="ECC 1:9">ನಡೆದದ್ದೇ ನಡೆಯುವುದು.</para>
  <para style="q2" vid="ECC 1:9">ಸೂರ್ಯನ ಕೆಳಗೆ ಹೊಸದಾದದ್ದು ಯಾವದೂ ಇಲ್ಲ.<verse eid="ECC 1:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="ECC 1:10"/>“ನೋಡು, ಇದು ಹೊಸದು,” ಎಂದು</para>
  <para style="q2" vid="ECC 1:10">ಯಾವ ವಿಷಯವಾಗಿ ಹೇಳಬಹುದೋ?</para>
  <para style="q1" vid="ECC 1:10">ಅದು ನಮಗಿಂತ ಮುಂಚೆ ಇದ್ದದ್ದು,</para>
  <para style="q2" vid="ECC 1:10">ಪುರಾತನ ಕಾಲದಿಂದ ಇದ್ದದ್ದೇ.<verse eid="ECC 1:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="ECC 1:11"/>ಹಿಂದಿನ ಕಾಲದ ಜನರ ಜ್ಞಾಪಕವು ಈಗಿನವರಿಗಿಲ್ಲ.</para>
  <para style="q2" vid="ECC 1:11">ಮುಂದಿನ ಕಾಲದಲ್ಲಿ ಬರುವವರ ಜ್ಞಾಪಕವು</para>
  <para style="q1" vid="ECC 1:11">ಅವುಗಳ ಮುಂದಿನ ಕಾಲದ</para>
  <para style="q2" vid="ECC 1:11">ಜನರಿಗೆ ಇರುವುದಿಲ್ಲ.<verse eid="ECC 1:11"/></para>
  <para style="s1">ಜ್ಞಾನವು ವ್ಯರ್ಥವಾದದ್ದು</para>
  <para style="p">
    <verse number="12" style="v" sid="ECC 1:12"/>ಪ್ರಸಂಗಿಯಾದ ನಾನು ಯೆರೂಸಲೇಮಿನಲ್ಲಿ ಇಸ್ರಾಯೇಲರ ಮೇಲೆ ಅರಸನಾಗಿದ್ದೆ. <verse eid="ECC 1:12"/><verse number="13" style="v" sid="ECC 1:13"/>ಆಕಾಶದ ಕೆಳಗೆ ನಡೆಯುವ ಕೆಲಸಗಳನ್ನೆಲ್ಲಾ ಜ್ಞಾನದಿಂದ ವಿಚಾರಿಸಿ, ವಿಮರ್ಶಿಸುವುದಕ್ಕೆ ನಾನು ನನ್ನ ಮನಸ್ಸು ಮಾಡಿದೆ. ದೇವರು ಮಾನವರ ಮೇಲೆ ಈ ಕಷ್ಟಕರವಾದ ಪ್ರಯಾಸವನ್ನು ಹೊರಿಸಿದ್ದಾರೆ. <verse eid="ECC 1:13"/><verse number="14" style="v" sid="ECC 1:14"/>ಸೂರ್ಯನ ಕೆಳಗೆ ನಡೆಯುವ ಎಲ್ಲಾ ಕೆಲಸಗಳನ್ನು ನಾನು ನೋಡಿದ್ದೇನೆ. ಗಾಳಿಯನ್ನು ಹಿಂದಟ್ಟುವಂತೆ ಎಲ್ಲವೂ ವ್ಯರ್ಥ.<verse eid="ECC 1:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="ECC 1:15"/>ವಕ್ರವಾದದ್ದನ್ನು ಸರಿಮಾಡುವುದಕ್ಕೆ ಆಗುವುದಿಲ್ಲ.</para>
  <para style="q2" vid="ECC 1:15">ಇಲ್ಲದ್ದನ್ನು ಲೆಕ್ಕಿಸುವುದು ಅಸಾಧ್ಯ.<verse eid="ECC 1:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="ECC 1:16"/>ನನ್ನಷ್ಟಕ್ಕೆ ನಾನೇ ಹೀಗೆಂದುಕೊಂಡೆನು, “ನೋಡು, ಯೆರೂಸಲೇಮಿನಲ್ಲಿ ನನಗಿಂತ ಮೊದಲು ಆಳಿದವರಿಗಿಂತ ನಾನು ಹೆಚ್ಚು ಜ್ಞಾನವನ್ನು ಸಂಪಾದಿಸಿದ್ದೇನೆ. ಹೌದು, ಜ್ಞಾನದ ಹಾಗೂ ತಿಳುವಳಿಕೆಯ ಅನುಭವ ನನಗಿದೆ.” <verse eid="ECC 1:16"/><verse number="17" style="v" sid="ECC 1:17"/>ಆಗ ಜ್ಞಾನವನ್ನೂ ಮನಗುಂದುವಿಕೆಯನ್ನೂ ಬುದ್ಧಿಹೀನತೆಯನ್ನೂ ತಿಳಿದುಕೊಳ್ಳುವಂತೆ ನಾನು ಮನಸ್ಸಿಟ್ಟೆನು, ಅದರ ಜೊತೆಗೆ ಇದು ಸಹ ಗಾಳಿಯನ್ನು ಬೆನ್ನಟ್ಟಿದಂತೆ, ಎಂದು ನಾನು ಅರಿತುಕೊಂಡೆನು.<verse eid="ECC 1:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="ECC 1:18"/>ಏಕೆಂದರೆ ಬಹು ಜ್ಞಾನವಿದ್ದಲ್ಲಿ ಬಹು ಸಂಕಟ,</para>
  <para style="q2" vid="ECC 1:18">ಹೆಚ್ಚು ತಿಳುವಳಿಕೆ ಇದ್ದಲ್ಲಿ ಹೆಚ್ಚು ವ್ಯಥೆ ಇದೆ.<verse eid="ECC 1:18"/></para>
  <chapter eid="ECC 1"/>
  <chapter number="2" style="c" sid="ECC 2"/>
  <para style="s1">ಸುಖಭೋಗಗಳು ವ್ಯರ್ಥವಾದವುಗಳು</para>
  <para style="p">
    <verse number="1" style="v" sid="ECC 2:1"/>“ಈಗ ಬಾ, ಯಾವುದು ಒಳ್ಳೆಯದು ಎಂಬುದನ್ನು ಸುಖಭೋಗಗಳಿಂದ ನಿನ್ನನ್ನು ಪರೀಕ್ಷಿಸುವೆನು,” ಎಂದು ನನ್ನ ಮನಸ್ಸಿನಲ್ಲಿ ಹೇಳಿಕೊಂಡೆ. ಆದರೆ ಅದೂ ಕೂಡ ವ್ಯರ್ಥವಾದದ್ದೆಂದು ರುಜುವಾತಾಯಿತು. <verse eid="ECC 2:1"/><verse number="2" style="v" sid="ECC 2:2"/>“ನಗುವುದು ಮೂರ್ಖತನ, ಸುಖಭೋಗ ಏನನ್ನು ಸಾಧಿಸುತ್ತದೆ,” ಎಂದು ಹೇಳಿಕೊಂಡೆ. <verse eid="ECC 2:2"/><verse number="3" style="v" sid="ECC 2:3"/>ಆಕಾಶದ ಕೆಳಗೆ ಮನುಷ್ಯರು ಅಲ್ಪಾಯುಷ್ಯದಲ್ಲಿ ಏನು ಮಾಡುವುದು ಹಿತ ಎಂದು ನಾನು ತಿಳಿದುಕೊಳ್ಳಲು ಬಯಸಿದೆ. ನನ್ನ ಮನಸ್ಸು ಇನ್ನೂ ಜ್ಞಾನದಿಂದಿರುವಾಗಲೇ ದ್ರಾಕ್ಷಾರಸದಿಂದ ಸಂತೋಷ ಪಡೋಣ, ಮೂರ್ಖತನವನ್ನು ಅಪ್ಪಿಕೊಳ್ಳೋಣ ಎಂದುಕೊಂಡೆ.<verse eid="ECC 2:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="ECC 2:4"/>ನಾನು ಮಹಾ ಯೋಜನೆಗಳನ್ನು ನಡೆಸಿದೆನು: ನಾನು ನನಗಾಗಿ ಮನೆಗಳನ್ನು ಕಟ್ಟಿಸಿಕೊಂಡೆನು. ನಾನು ದ್ರಾಕ್ಷಿತೋಟಗಳನ್ನು ನೆಟ್ಟೆನು. <verse eid="ECC 2:4"/><verse number="5" style="v" sid="ECC 2:5"/>ನಾನು ಉದ್ಯಾನವನಗಳನ್ನೂ, ತೋಟಗಳನ್ನೂ ಮಾಡಿಕೊಂಡು, ಅವುಗಳಲ್ಲಿ ಸಕಲ ವಿಧವಾದ ಹಣ್ಣಿನ ವೃಕ್ಷಗಳನ್ನು ನೆಟ್ಟೆನು. <verse eid="ECC 2:5"/><verse number="6" style="v" sid="ECC 2:6"/>ಬೆಳೆಯುವ ಗಿಡಗಳ ತೋಪುಗಳಿಗೆ ನೀರು ಹಾಯಿಸುವುದಕ್ಕೆ ನಾನು ಜಲಾಶಯಗಳನ್ನು ಮಾಡಿಕೊಂಡೆನು. <verse eid="ECC 2:6"/><verse number="7" style="v" sid="ECC 2:7"/>ನನಗೆ ದಾಸ, ದಾಸಿಯರನ್ನು ಕೊಂಡುಕೊಂಡೆನು. ನನ್ನ ಮನೆಯಲ್ಲಿ ಜನಿಸಿದ ಇತರ ಗುಲಾಮರು ಸಹ ಇದ್ದರು. ನನಗಿಂತ ಮುಂಚೆ ಯೆರೂಸಲೇಮಿನಲ್ಲಿ, ಇದ್ದವರೆಲ್ಲರಿಗಿಂತಲೂ ಹೆಚ್ಚಾಗಿ ಬಹಳ ಸಂಪತ್ತು ಉಳ್ಳವನಾಗಿ ಹೆಚ್ಚು ದನಕುರಿಗಳ ಮಂದೆಗಳನ್ನು ಹೊಂದಿದೆನು. <verse eid="ECC 2:7"/><verse number="8" style="v" sid="ECC 2:8"/>ನಾನು ಬೆಳ್ಳಿಬಂಗಾರಗಳನ್ನು, ಅರಸರ ಮತ್ತು ಪ್ರಾಂತಗಳ ವಿಶೇಷ ಸಂಪತ್ತನ್ನು ಸಂಗ್ರಹಿಸಿಕೊಂಡೆನು. ಗಾಯಕ, ಗಾಯಕಿಯರನ್ನು ಮತ್ತು ಮನುಷ್ಯರಿಗೆ ಭೋಗವಿಲಾಸಕ್ಕಾಗಿ ಅನೇಕ ಉಪಪತ್ನಿಯರನ್ನು ಸಂಪಾದಿಸಿಕೊಂಡೆನು. <verse eid="ECC 2:8"/><verse number="9" style="v" sid="ECC 2:9"/>ಹೀಗೆ ಯೆರೂಸಲೇಮಿನಲ್ಲಿ ನನಗಿಂತ ಮುಂಚೆ ಇದ್ದ ಎಲ್ಲರಿಗಿಂತಲೂ ನಾನು ಹೆಚ್ಚು ಅಭಿವೃದ್ಧಿಹೊಂದಿ, ಶ್ರೀಮಂತನಾದೆನು. ಇದೆಲ್ಲದರಲ್ಲಿ ನನ್ನ ಜ್ಞಾನವು ನನ್ನಲ್ಲಿ ನೆಲೆಯಾಗಿತ್ತು.<verse eid="ECC 2:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="ECC 2:10"/>ನನ್ನ ಕಣ್ಣು ಬಯಸಿದ್ದೆಲ್ಲವನ್ನು ಅದರಿಂದ ಹಿಂತೆಗೆಯಲಿಲ್ಲ,</para>
  <para style="q2" vid="ECC 2:10">ಯಾವ ಸಂತೋಷಕ್ಕಾಗಿಯೂ ನನ್ನ ಹೃದಯವನ್ನು ನಾನು ತಡೆಯಲಿಲ್ಲ.</para>
  <para style="q1" vid="ECC 2:10">ನನ್ನ ಎಲ್ಲಾ ಪ್ರಯಾಸದಲ್ಲಿ ನನ್ನ ಹೃದಯವು ಸಂತೋಷಿಸಿತು.</para>
  <para style="q2" vid="ECC 2:10">ಇದು ನನ್ನ ಎಲ್ಲಾ ಪ್ರಯಾಸದಿಂದ ನನಗೆ ಬಂದ ಬಹುಮಾನ.<verse eid="ECC 2:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="ECC 2:11"/>ನನ್ನ ಕೈಗಳು ನಡೆಸಿದವುಗಳೆಲ್ಲವನ್ನೂ</para>
  <para style="q2" vid="ECC 2:11">ನಾನು ಸಾಧಿಸಲು ಪ್ರಯಾಸಪಟ್ಟದ್ದನ್ನೂ ಪರಿಶೀಲಿಸಿ ನೋಡಿದೆ.</para>
  <para style="q1" vid="ECC 2:11">ಗಾಳಿಯನ್ನು ಬೆನ್ನಟ್ಟಿದಂತೆ ಎಲ್ಲವೂ ವ್ಯರ್ಥವಾಗಿತ್ತು.</para>
  <para style="q2" vid="ECC 2:11">ಸೂರ್ಯನ ಕೆಳಗೆ ಯಾವುದೂ ಲಾಭಕರವಾಗಿ ಕಾಣಲಿಲ್ಲ.<verse eid="ECC 2:11"/></para>
  <para style="s1">ಜ್ಞಾನವೂ ಮೂಢತನವೂ ವ್ಯರ್ಥ</para>
  <para style="q1">
    <verse number="12" style="v" sid="ECC 2:12"/>ಅನಂತರ ಜ್ಞಾನವನ್ನೂ ಮನಗುಂದುವಿಕೆಯನ್ನೂ ಮೂಡತೆಯನ್ನೂ</para>
  <para style="q2" vid="ECC 2:12">ಮತ್ತೆ ಯೋಚಿಸುವುದಕ್ಕೆ ನಾನು ತಿರುಗಿಕೊಂಡೆನು.</para>
  <para style="q1" vid="ECC 2:12">ಈಗಾಗಲೇ ಮಾಡಿದ್ದನ್ನು ಬಿಟ್ಟು, ಅರಸನ ತರುವಾಯ</para>
  <para style="q2" vid="ECC 2:12">ಬರುವವನು ಹೊಸದಾಗಿ ಏನು ಮಾಡಬಲ್ಲನು?<verse eid="ECC 2:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="ECC 2:13"/>ಆಗ ಬೆಳಕು ಕತ್ತಲೆಗಿಂತ ಶ್ರೇಷ್ಠವಾಗಿರುವಂತೆ,</para>
  <para style="q2" vid="ECC 2:13">ಜ್ಞಾನವು ಮೂಢತನಕ್ಕಿಂತ ಶ್ರೇಷ್ಠವಾಗಿದೆ ಎಂದು ನಾನು ಕಂಡೆನು.<verse eid="ECC 2:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="ECC 2:14"/>ಜ್ಞಾನಿಯ ಕಣ್ಣು ಅವನ ತಲೆಯಲ್ಲಿರುತ್ತದೆ.</para>
  <para style="q2" vid="ECC 2:14">ಆದರೆ ಮೂಢನು ಕತ್ತಲೆಯಲ್ಲಿ ನಡೆಯುತ್ತಾನೆ.</para>
  <para style="q1" vid="ECC 2:14">ಇವರಿಬ್ಬರಿಗೂ ಒಂದೇ ಗತಿಯು ಸಂಭವಿಸುವುದೆಂದೂ</para>
  <para style="q2" vid="ECC 2:14">ನಾನು ಗ್ರಹಿಸಿಕೊಂಡೆನು.<verse eid="ECC 2:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="ECC 2:15"/>ಆಗ ನಾನು ನನ್ನ ಮನಸ್ಸಿನಲ್ಲಿ,</para>
  <para style="q1" vid="ECC 2:15">“ಮೂಢನಿಗೆ ಸಂಭವಿಸುವ ಗತಿಯೂ ನನಗೂ ಸಂಭವಿಸುತ್ತದೆ.</para>
  <para style="q2" vid="ECC 2:15">ನಾನು ಜ್ಞಾನಿಯಾಗುವುದರಿಂದ ಲಾಭವೇನು?”</para>
  <para style="q2" vid="ECC 2:15">“ಇದು ಸಹ ವ್ಯರ್ಥವೇ,” ಎಂದುಕೊಂಡೆನು.<verse eid="ECC 2:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="ECC 2:16"/>ಮೂಢನನ್ನು ಹೇಗೋ ಹಾಗೆಯೇ ಜ್ಞಾನಿಯನ್ನೂ</para>
  <para style="q2" vid="ECC 2:16">ಜನರು ಬಹಳ ದಿನಗಳವರೆಗೆ ಜ್ಞಾಪಕಮಾಡಿಕೊಳ್ಳುವುದಿಲ್ಲ.</para>
  <para style="q2" vid="ECC 2:16">ಇವರಿಬ್ಬರನ್ನೂ ಮರೆತುಹೋದ ದಿನಗಳು ಈಗಾಗಲೇ ಬಂದಿವೆ.</para>
  <para style="q1" vid="ECC 2:16">ಮೂಢನಂತೆ ಜ್ಞಾನಿಯೂ ಸಹ ಸಾಯಲೇಬೇಕು.<verse eid="ECC 2:16"/></para>
  <para style="s1">ಶ್ರಮೆಯೂ ವ್ಯರ್ಥ</para>
  <para style="p">
    <verse number="17" style="v" sid="ECC 2:17"/>ಸೂರ್ಯನ ಕೆಳಗೆ ನಡೆಯುವ ಕಾರ್ಯವು ನನಗೆ ದುಃಖಕರವಾಗಿ ತೋರಿತು. ಆದಕಾರಣ ನಾನು ನನ್ನ ಜೀವನವನ್ನು ಹಗೆ ಮಾಡಿದೆನು. ಗಾಳಿಯನ್ನು ಬೆನ್ನಟ್ಟುವಂತೆ ಎಲ್ಲವೂ ವ್ಯರ್ಥವಾಗಿದೆ. <verse eid="ECC 2:17"/><verse number="18" style="v" sid="ECC 2:18"/>ನನ್ನ ತರುವಾಯ ಬರುವ ಮನುಷ್ಯನಿಗೆ ನಾನು ಇದನ್ನೆಲ್ಲಾ ಬಿಟ್ಟುಬಿಡಬೇಕಾದ್ದರಿಂದ ಸೂರ್ಯನ ಕೆಳಗೆ ಪಟ್ಟ ನನ್ನ ಎಲ್ಲಾ ಪ್ರಯಾಸವನ್ನು ನಾನು ಹಗೆ ಮಾಡಿದೆನು. <verse eid="ECC 2:18"/><verse number="19" style="v" sid="ECC 2:19"/>ನನ್ನ ನಂತರ ಬರುವವನು ಜ್ಞಾನಿಯೋ ಮೂಢನೋ ಯಾರಿಗೆ ಗೊತ್ತು? ಆದರೂ ನಾನು ಪಟ್ಟ ಎಲ್ಲಾ ಪ್ರಯಾಸದ ಮೇಲೆಯೂ ಸೂರ್ಯನ ಕೆಳಗೆ ನಾನು ತೋರ್ಪಡಿಸಿಕೊಂಡದರ ಮೇಲೆಯೂ ಅವನು ಆಳುವನು. ಇದು ವ್ಯರ್ಥವೇ. <verse eid="ECC 2:19"/><verse number="20" style="v" sid="ECC 2:20"/>ಆದ್ದರಿಂದ ಸೂರ್ಯನ ಕೆಳಗೆ ಪ್ರಯಾಸಪಟ್ಟ ಎಲ್ಲಾ ಪ್ರಯಾಸದ ವಿಷಯವಾಗಿ, ನನ್ನ ಹೃದಯವು ನಿರಾಶೆಗೊಳ್ಳಲು ಪ್ರಾರಂಭಿಸಿತು. <verse eid="ECC 2:20"/><verse number="21" style="v" sid="ECC 2:21"/>ಒಬ್ಬ ಮನುಷ್ಯನು ಜ್ಞಾನದಲ್ಲಿಯೂ ತಿಳುವಳಿಕೆಯಲ್ಲಿಯೂ ಕೌಶಲಯುತವಾಗಿಯೂ ತನ್ನ ಕೆಲಸ ಮಾಡಬಹುದು. ಅನಂತರ ತನಗಿರುವುದೆಲ್ಲವನ್ನು ಪ್ರಯಾಸಪಡದೆ ಇದ್ದ ಮನುಷ್ಯನಿಗೆ ಪಾಲಾಗಿ ಅವನು ಬಿಟ್ಟುಬಿಡಬೇಕಾಗುತ್ತದೆ. ಇದೂ ವ್ಯರ್ಥವೂ ದೊಡ್ಡ ವ್ಯಸನವೂ ಆಗಿವೆ. <verse eid="ECC 2:21"/><verse number="22" style="v" sid="ECC 2:22"/>ಸೂರ್ಯನ ಕೆಳಗೆ ತಾನು ಪ್ರಯಾಸಪಟ್ಟ ತನ್ನ ಹೃದಯದ ಆಯಾಸಕ್ಕಾಗಿಯೂ ತನ್ನ ಎಲ್ಲಾ ಪ್ರಯಾಸಕ್ಕಾಗಿಯೂ ಮನುಷ್ಯನಿಗೆ ಏನು ಸಿಕ್ಕುತ್ತದೆ? <verse eid="ECC 2:22"/><verse number="23" style="v" sid="ECC 2:23"/>ಅವನ ದಿನಗಳೆಲ್ಲಾ ವ್ಯಸನವೇ. ಅವನ ಪ್ರಯಾಸವು ದುಃಖವೇ. ರಾತ್ರಿಯಲ್ಲಿಯೂ ಅವನ ಮನಸ್ಸಿಗೆ ವಿಶ್ರಾಂತಿಯಿಲ್ಲ. ಇದೂ ಕೂಡ ವ್ಯರ್ಥವೇ.<verse eid="ECC 2:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="ECC 2:24"/>ಒಬ್ಬ ವ್ಯಕ್ತಿ ತನ್ನ ಪ್ರಯಾಸದಲ್ಲಿ ತೃಪ್ತಿಹೊಂದುವಂತೆ ತಿಂದು ಕುಡಿಯುವುದಕ್ಕಿಂತ ಶ್ರೇಷ್ಠವಾದದ್ದು ಮನುಷ್ಯನಿಗೆ ಯಾವುದೂ ಇಲ್ಲ. ಇದೂ ಕೂಡ ದೇವರ ಕೈಯಿಂದಲೇ ಆಗುತ್ತದೆ ಎಂದು ನಾನು ಕಂಡೆನು. <verse eid="ECC 2:24"/><verse number="25" style="v" sid="ECC 2:25"/>ದೇವರಿಲ್ಲದೆ ಯಾರಿಗೆ ಊಟ ದೊರಕಿತು? ದೇವರಿಲ್ಲದೆ ಯಾರು ಸುಖಾನುಭವ ಹೊಂದುವರು? <verse eid="ECC 2:25"/><verse number="26" style="v" sid="ECC 2:26"/>ಏಕೆಂದರೆ ದೇವರು ಮೆಚ್ಚಿದವರಿಗೆ ಅವರು ಜ್ಞಾನವನ್ನೂ ತಿಳುವಳಿಕೆಯನ್ನೂ ಆನಂದವನ್ನೂ ದಯಪಾಲಿಸುತ್ತಾರೆ. ಆದರೆ ದೇವರು ತಮಗೆ ಮೆಚ್ಚುಗೆಯಾದವನಿಗೆ ಕೊಡತಕ್ಕ ಐಶ್ವರ್ಯವನ್ನು ಕೂಡಿಸಿಡುವ ಪ್ರಯಾಸವನ್ನು ಮಾತ್ರ ಪಾಪಿಗೆ ಕೊಡುತ್ತಾರೆ. ಏಕೆಂದರೆ ಇದು ಸಹ ಗಾಳಿಯನ್ನು ಹಿಡಿಯಲು ಬೆನ್ನಟ್ಟಿದಂತೆ ವ್ಯರ್ಥ.<verse eid="ECC 2:26"/></para>
  <chapter eid="ECC 2"/>
  <chapter number="3" style="c" sid="ECC 3"/>
  <para style="s1">ಪ್ರತಿಯೊಂದು ಕಾರ್ಯಕ್ಕೆ ಸಮಯ</para>
  <para style="q1">
    <verse number="1" style="v" sid="ECC 3:1"/>ಪ್ರತಿಯೊಂದಕ್ಕೂ ಒಂದೊಂದು ಸಮಯವಿದೆ.</para>
  <para style="q2" vid="ECC 3:1">ಆಕಾಶದ ಕೆಳಗೆ ಪ್ರತಿಯೊಂದು ಕಾರ್ಯಕ್ಕೂ ಒಂದು ಕಾಲವಿದೆ.<verse eid="ECC 3:1"/></para>
  <para style="b"/>
  <para style="q2">
    <verse number="2" style="v" sid="ECC 3:2"/>ಹುಟ್ಟುವುದಕ್ಕೆ ಒಂದು ಸಮಯ, ಸಾಯುವುದಕ್ಕೆ ಒಂದು ಸಮಯ.</para>
  <para style="q2" vid="ECC 3:2">ನೆಡುವುದಕ್ಕೆ ಒಂದು ಸಮಯ, ನೆಟ್ಟದ್ದನ್ನು ಕಿತ್ತು ಹಾಕುವುದಕ್ಕೆ ಒಂದು ಸಮಯ.<verse eid="ECC 3:2"/></para>
  <para style="q2">
    <verse number="3" style="v" sid="ECC 3:3"/>ಕೊಲ್ಲುವುದಕ್ಕೆ ಒಂದು ಸಮಯ, ಸ್ವಸ್ಥ ಮಾಡುವುದಕ್ಕೆ ಒಂದು ಸಮಯ,</para>
  <para style="q2" vid="ECC 3:3">ಕೆಡವಿಬಿಡುವುದಕ್ಕೆ ಒಂದು ಸಮಯ, ಕಟ್ಟುವುದಕ್ಕೆ ಒಂದು ಸಮಯ.<verse eid="ECC 3:3"/></para>
  <para style="q2">
    <verse number="4" style="v" sid="ECC 3:4"/>ಅಳುವುದಕ್ಕೆ ಒಂದು ಸಮಯ, ನಗುವುದಕ್ಕೆ ಒಂದು ಸಮಯ.</para>
  <para style="q2" vid="ECC 3:4">ಗೋಳಾಡುವುದಕ್ಕೆ ಒಂದು ಸಮಯ, ಕುಣಿದಾಡುವುದಕ್ಕೆ ಒಂದು ಸಮಯ.<verse eid="ECC 3:4"/></para>
  <para style="q2">
    <verse number="5" style="v" sid="ECC 3:5"/>ಕಲ್ಲುಗಳನ್ನು ಎಸೆಯುವುದಕ್ಕೆ ಒಂದು ಸಮಯ, ಕಲ್ಲುಗಳನ್ನು ಕೂಡಿಸುವುದಕ್ಕೆ ಒಂದು ಸಮಯ.</para>
  <para style="q2" vid="ECC 3:5">ಅಪ್ಪಿಕೊಳ್ಳುವುದಕ್ಕೆ ಒಂದು ಸಮಯ, ತಡೆದಿರುವುದಕ್ಕೂ ಒಂದು ಸಮಯ.<verse eid="ECC 3:5"/></para>
  <para style="q2">
    <verse number="6" style="v" sid="ECC 3:6"/>ಗಳಿಸುವುದಕ್ಕೆ ಒಂದು ಸಮಯ, ಕಳೆದುಕೊಳ್ಳುವುದಕ್ಕೆ ಒಂದು ಸಮಯ.</para>
  <para style="q2" vid="ECC 3:6">ಕಾಪಾಡುವುದಕ್ಕೆ ಒಂದು ಸಮಯ, ಬಿಸಾಡುವುದಕ್ಕೆ ಒಂದು ಸಮಯ.<verse eid="ECC 3:6"/></para>
  <para style="q2">
    <verse number="7" style="v" sid="ECC 3:7"/>ಹರಿಯುವುದಕ್ಕೆ ಒಂದು ಸಮಯ, ಹೊಲಿಯುವುದಕ್ಕೆ ಒಂದು ಸಮಯ.</para>
  <para style="q2" vid="ECC 3:7">ಸುಮ್ಮನೆ ಇರುವುದಕ್ಕೆ ಒಂದು ಸಮಯ, ಮಾತಾಡುವುದಕ್ಕೆ ಒಂದು ಸಮಯ.<verse eid="ECC 3:7"/></para>
  <para style="q2">
    <verse number="8" style="v" sid="ECC 3:8"/>ಪ್ರೀತಿಸುವುದಕ್ಕೆ ಒಂದು ಸಮಯ, ದ್ವೇಷಿಸುವುದಕ್ಕೆ ಒಂದು ಸಮಯ.</para>
  <para style="q2" vid="ECC 3:8">ಯುದ್ಧದ ಸಮಯ, ಸಮಾಧಾನದ ಸಮಯ, ಹೀಗೆ ಒಂದೊಂದಕ್ಕೂ ತಕ್ಕ ಸಮಯವಿದೆ.<verse eid="ECC 3:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="ECC 3:9"/>ಹಾಗಾದರೆ, ಪ್ರಯಾಸ ಪಡುವುದರಲ್ಲಿ ದುಡಿಯುವವನಿಗೆ ಲಾಭವೇನಿದೆ? <verse eid="ECC 3:9"/><verse number="10" style="v" sid="ECC 3:10"/>ದೇವರು ಮಾನವ ಜನಾಂಗದ ಮೇಲೆ ಹೊರಿಸಿರುವ ಭಾರವನ್ನು ನಾನು ನೋಡಿದ್ದೇನೆ. <verse eid="ECC 3:10"/><verse number="11" style="v" sid="ECC 3:11"/>ದೇವರು ಪ್ರತಿಯೊಂದನ್ನು ತಮ್ಮ ಸೂಕ್ತ ಸಮಯದಲ್ಲಿ ಸುಂದರವಾಗಿ ನಿರ್ಮಿಸಿದ್ದಾರೆ. ಜನರ ಹೃದಯದಲ್ಲಿ ನಿತ್ಯತೆಯನ್ನು ದೇವರೇ ಇಟ್ಟಿದ್ದಾರೆ. ಆದರೂ ಆದಿಯಿಂದ ಅಂತ್ಯದವರೆಗೂ ದೇವರು ಏನು ಮಾಡಿದ್ದಾರೆಂದು ಯಾರಿಗೂ ಗ್ರಹಿಸಲು ಸಾಧ್ಯವಿಲ್ಲ. <verse eid="ECC 3:11"/><verse number="12" style="v" sid="ECC 3:12"/>ಜನರು ತಮ್ಮ ಜೀವಮಾನದಲ್ಲಿ ಸಂತೋಷವಾಗಿದ್ದು ಒಳ್ಳೆಯದನ್ನು ಮಾಡುವುದಕ್ಕಿಂತ ಉತ್ತಮವಾದದ್ದೇನೂ ಇಲ್ಲವೆಂದು ನಾನು ಬಲ್ಲೆನು. <verse eid="ECC 3:12"/><verse number="13" style="v" sid="ECC 3:13"/>ಇದಲ್ಲದೆ ಪ್ರತಿಯೊಬ್ಬನು ಅನ್ನಪಾನಗಳನ್ನು ಸೇವಿಸಿ, ತನ್ನ ಎಲ್ಲಾ ಪ್ರಯಾಸಗಳಲ್ಲಿ ಸುಖವನ್ನು ಅನುಭವಿಸುವುದು ದೇವರ ದಾನದಿಂದಲೇ. <verse eid="ECC 3:13"/><verse number="14" style="v" sid="ECC 3:14"/>ದೇವರು ಮಾಡುವ ಕಾರ್ಯವೆಲ್ಲವೂ ಶಾಶ್ವತವಾಗಿರುವುದೆಂದು ನಾನು ಬಲ್ಲೆನು; ಅದಕ್ಕೆ ಯಾವುದನ್ನೂ ಕೂಡಿಸಲಾಗದು ಮತ್ತು ಯಾವುದನ್ನೂ ತೆಗೆಯಲಾಗದು. ತಮ್ಮ ಸನ್ನಿಧಿಯಲ್ಲಿ ಮನುಷ್ಯರು ಭಯಭಕ್ತಿಯಿಂದ ಜೀವಿಸಬೇಕೆಂದು ದೇವರು ಇದನ್ನು ಮಾಡಿದ್ದಾರೆ.<verse eid="ECC 3:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="ECC 3:15"/>ಇರುವಂಥದ್ದು ಈಗಾಗಲೇ ಇತ್ತು,</para>
  <para style="q2" vid="ECC 3:15">ಬರುವಂಥದ್ದು ಆಗಲೇ ಇದೆ.</para>
  <para style="q2" vid="ECC 3:15">ಗತಿಸಿಹೋದದ್ದನ್ನು ದೇವರು ಪುನಃಸ್ಥಾಪಿಸುವರು.<verse eid="ECC 3:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="ECC 3:16"/>ಇದಕ್ಕಿಂತಲೂ ಬೇರೆಯಾದದ್ದನ್ನು ಸೂರ್ಯನ ಕೆಳಗೆ ನೋಡಿದೆನು:</para>
  <para style="q1" vid="ECC 3:16">ನ್ಯಾಯತೀರ್ಪಿನ ಸ್ಥಳದಲ್ಲಿ ದುಷ್ಕೃತ್ಯ ಇತ್ತು.</para>
  <para style="q2" vid="ECC 3:16">ನೀತಿಯ ಸ್ಥಾನದಲ್ಲಿಯೂ ದುಷ್ಟತ್ವ ಇತ್ತು.<verse eid="ECC 3:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="ECC 3:17"/>ನಾನು ನನ್ನ ಹೃದಯದಲ್ಲಿ ಹೀಗೆ ಅಂದುಕೊಂಡೆನು,</para>
  <para style="q1" vid="ECC 3:17">“ನೀತಿವಂತರನ್ನೂ ದುಷ್ಟರನ್ನೂ</para>
  <para style="q2" vid="ECC 3:17">ದೇವರು ನ್ಯಾಯತೀರಿಸುವನು.</para>
  <para style="q1" vid="ECC 3:17">ಏಕೆಂದರೆ ಪ್ರತಿಯೊಂದು ಉದ್ದೇಶಕ್ಕೂ,</para>
  <para style="q2" vid="ECC 3:17">ಪ್ರತಿಯೊಂದು ಕೆಲಸಕ್ಕೂ ಪರೀಕ್ಷೆಯ ಸಮಯವಿದೆ.”<verse eid="ECC 3:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="ECC 3:18"/>ಮತ್ತೆ ನನ್ನ ಮನಸ್ಸಿನಲ್ಲಿ ಯೋಚಿಸಿದೆ, “ಮನುಷ್ಯರು ಮೃಗಗಳಂತೆ ಇದ್ದಾರೆಂದು ತಿಳಿದುಕೊಳ್ಳಲು ದೇವರು ಅವರನ್ನು ಪರೀಕ್ಷಿಸುತ್ತಾರೆ. <verse eid="ECC 3:18"/><verse number="19" style="v" sid="ECC 3:19"/>ಏಕೆಂದರೆ ಮೃಗಗಳಿಗೆ ಸಂಭವಿಸುವುದು ಮನುಷ್ಯರಿಗೂ ಸಂಭವಿಸುತ್ತದೆ. ಇಬ್ಬರಿಗೂ ಒಂದೇ ಸಂಗತಿ ಸಂಭವಿಸುತ್ತದೆ. ಒಂದು ಹೇಗೆ ಸಾಯುತ್ತದೋ ಹಾಗೆ ಇನ್ನೊಂದೂ ಸಾಯುತ್ತದೆ. ಎಲ್ಲಕ್ಕೂ ಒಂದೇ ಪ್ರಾಣ ಇದೆ. ಆ ರೀತಿಯಲ್ಲಿ ಮೃಗಕ್ಕಿಂತ ಮನುಷ್ಯನಿಗೆ ಹೆಚ್ಚು ಶ್ರೇಷ್ಠತೆ ಇಲ್ಲ. ಎಲ್ಲವೂ ವ್ಯರ್ಥ. <verse eid="ECC 3:19"/><verse number="20" style="v" sid="ECC 3:20"/>ಎಲ್ಲವೂ ಒಂದೇ ಸ್ಥಳಕ್ಕೆ ಹೋಗುತ್ತವೆ. ಎಲ್ಲವೂ ಮಣ್ಣಿನಿಂದ ಆದವು. ಎಲ್ಲವೂ ಮಣ್ಣಿಗೆ ಸೇರುತ್ತವೆ. <verse eid="ECC 3:20"/><verse number="21" style="v" sid="ECC 3:21"/>ಮನುಷ್ಯನ ಆತ್ಮವು ಮೇಲಕ್ಕೆ ಹೋಗುತ್ತದೆ ಎಂದೂ ಮೃಗದ ಪ್ರಾಣವು ಭೂಮಿಯ ಕೆಳಗೆ ಹೋಗುತ್ತದೆಂದೂ ಯಾರು ತಿಳಿದಾರು?”<verse eid="ECC 3:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="ECC 3:22"/>ಆದಕಾರಣ ಮನುಷ್ಯನು ತನ್ನ ಕೆಲಸ ಕಾರ್ಯಗಳಲ್ಲಿ ಆನಂದಿಸುವುದಕ್ಕಿಂತ ಉತ್ತಮವಾದದ್ದು ಯಾವುದೂ ಇಲ್ಲವೆಂದು ನಾನು ನೋಡಿದೆನು. ಏಕೆಂದರೆ ಇದೇ ಅವನ ಪಾಲು. ಆದ್ದರಿಂದ ತನ್ನ ಜೀವಮಾನದ ನಂತರ ಸಂಭವಿಸುವುದನ್ನು ನೋಡುವುದಕ್ಕೆ ಮನುಷ್ಯನನ್ನು ಯಾರು ಪುನಃ ಬರಮಾಡುವರು?<verse eid="ECC 3:22"/></para>
  <chapter eid="ECC 3"/>
  <chapter number="4" style="c" sid="ECC 4"/>
  <para style="s1">ದಬ್ಬಾಳಿಕೆ, ಶ್ರಮೆ, ವೈರತ್ವ</para>
  <para style="p">
    <verse number="1" style="v" sid="ECC 4:1"/>ಪುನಃ ನಾನು ಸೂರ್ಯನ ಕೆಳಗೆ ನಡೆಯುತ್ತಿರುವ ದಬ್ಬಾಳಿಕೆಯನ್ನೆಲ್ಲಾ ನೋಡಿದೆನು:</para>
  <para style="q1" vid="ECC 4:1">ಹಿಂಸೆಗೊಂಡವರ ಕಣ್ಣೀರನ್ನೂ,</para>
  <para style="q2" vid="ECC 4:1">ಅವರನ್ನು ಸಂತೈಸುವವರು ಯಾರೂ ಇಲ್ಲದಿರುವುದನ್ನೂ ನೋಡಿದೆನು.</para>
  <para style="q1" vid="ECC 4:1">ಅಧಿಕಾರವು ಅವರ ದಬ್ಬಾಳಿಕೆಗಾರರ ಬಳಿಯಲ್ಲಿತ್ತು.</para>
  <para style="q2" vid="ECC 4:1">ಆದರೆ ಅವರನ್ನು ಸಂತೈಸುವವರು ಒಬ್ಬರೂ ಇಲ್ಲ.<verse eid="ECC 4:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="ECC 4:2"/>ಆದಕಾರಣ ನಾನು ಇದನ್ನು ನೋಡಿ</para>
  <para style="q2" vid="ECC 4:2">ಜೀವದಿಂದ ಇರುವವರಿಗಿಂತ,</para>
  <para style="q1" vid="ECC 4:2">ಮೃತಪಟ್ಟವರೇ ಮೇಲು</para>
  <para style="q2" vid="ECC 4:2">ಎಂದು ನಾನು ತೀರ್ಮಾನಿಸಿದೆ.<verse eid="ECC 4:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="ECC 4:3"/>ಆದರೆ ಇವರಿಬ್ಬರಿಗಿಂತಲೂ</para>
  <para style="q2" vid="ECC 4:3">ಇನ್ನೂ ಹುಟ್ಟದೇ,</para>
  <para style="q1" vid="ECC 4:3">ಸೂರ್ಯನ ಕೆಳಗೆ ನಡೆಯುವ</para>
  <para style="q2" vid="ECC 4:3">ಕೆಟ್ಟ ಕೃತ್ಯವನ್ನು ನೋಡದಿರುವವನೇ ಶ್ರೇಷ್ಠನು.<verse eid="ECC 4:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="ECC 4:4"/>ಮನುಷ್ಯನು ಪಡುವ ಎಲ್ಲಾ ಪ್ರಯಾಸವನ್ನೂ ಸಾಧಿಸುವ ಎಲ್ಲಾ ಕಾರ್ಯಗಳನ್ನೂ ನೋಡಿದಾಗ ಇವು ಪರಸ್ಪರ ಮತ್ಸರಕ್ಕೆ ಕಾರಣವೆಂದು ನಾನು ತಿಳಿದುಕೊಂಡೆನು. ಇದು ಕೂಡ ಗಾಳಿಯನ್ನು ಬೆನ್ನಟ್ಟಿದ ಹಾಗೆ ವ್ಯರ್ಥವೇ.<verse eid="ECC 4:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="ECC 4:5"/>ಸುಮ್ಮನೇ ಕೈಕಟ್ಟಿ ಕುಳಿತುಕೊಂಡು ಬುದ್ಧಿಹೀನರು,</para>
  <para style="q2" vid="ECC 4:5">ತಮ್ಮನ್ನು ತಾವೇ ಹಾಳುಮಾಡಿಕೊಳ್ಳುತ್ತಾರೆ.<verse eid="ECC 4:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="ECC 4:6"/>ಗಾಳಿಯನ್ನು ಹಿಡಿಯಲು ಬೆನ್ನಟ್ಟಿದಂತೆ</para>
  <para style="q2" vid="ECC 4:6">ಪ್ರಯಾಸದಿಂದ ತುಂಬಿದ ಎರಡು ಕೈಗಳಿಂದ ಮಾಡಿದ ಕೆಲಸಕ್ಕಿಂತ</para>
  <para style="q2" vid="ECC 4:6">ನೆಮ್ಮದಿಯಿಂದ ಒಂದು ಕೈಯಿಂದ ಮಾಡಿದ ಕೆಲಸವೇ ಲೇಸು.<verse eid="ECC 4:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="ECC 4:7"/>ಆಗ ಮತ್ತೆ ನಾನು ಸೂರ್ಯನ ಕೆಳಗೆ ವ್ಯರ್ಥವಾದದ್ಡನ್ನು ಕಂಡೆನು:<verse eid="ECC 4:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="ECC 4:8"/>ಜೊತೆಗಾರನಿಲ್ಲದೆ ಒಬ್ಬಂಟಿಗನಾದ ಒಬ್ಬ ಮನುಷ್ಯನಿದ್ದನು.</para>
  <para style="q2" vid="ECC 4:8">ಅವನಿಗೆ ಮಗನಾಗಲಿ, ಸಹೋದರನಾಗಲಿ ಇರಲಿಲ್ಲ.</para>
  <para style="q1" vid="ECC 4:8">ಆದರೂ ಅವನ ಪ್ರಯಾಸಕ್ಕೆ ಕೊನೆಯಿಲ್ಲ.</para>
  <para style="q2" vid="ECC 4:8">ತನ್ನ ಸಂಪತ್ತಿನಿಂದ ಅವನ ಕಣ್ಣು ತೃಪ್ತಿ ಹೊಂದಿರಲಿಲ್ಲ.</para>
  <para style="q1" vid="ECC 4:8">ಅವನು, “ನಾನು ಸುಖಸಂತೋಷವನ್ನು ತೊರೆದು,</para>
  <para style="q2" vid="ECC 4:8">ಯಾರಿಗೋಸ್ಕರ ಕಷ್ಟಪಡುತ್ತಲೇ ಇದ್ದೇನೆ?” ಎಂದುಕೊಂಡನು.</para>
  <para style="q1" vid="ECC 4:8">ಇದು ಕೂಡ ವ್ಯರ್ಥವೇ,</para>
  <para style="q2" vid="ECC 4:8">ಪ್ರಯಾಸದ ಕೆಲಸವೇ ಸರಿ.<verse eid="ECC 4:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="ECC 4:9"/>ಒಬ್ಬನಿಗಿಂತ ಇಬ್ಬರು ಲೇಸು,</para>
  <para style="q2" vid="ECC 4:9">ಏಕೆಂದರೆ ಅವರ ಪ್ರಯಾಸಕ್ಕೆ ಒಳ್ಳೆಯ ಪ್ರತಿಫಲವಿದೆ:<verse eid="ECC 4:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="ECC 4:10"/>ಒಬ್ಬನು ಬಿದ್ದರೆ ಇನ್ನೊಬ್ಬನು ಎತ್ತುವನು.</para>
  <para style="q2" vid="ECC 4:10">ಆದರೆ ಅವನು ಒಬ್ಬೊಂಟಿಗನಾಗಿ ಬಿದ್ದರೆ</para>
  <para style="q1" vid="ECC 4:10">ಅವನ ಗತಿ ದುರ್ಗತಿಯೇ</para>
  <para style="q2" vid="ECC 4:10">ಏಕೆಂದರೆ ಅವನಿಗೆ ಸಹಾಯ ಮಾಡುವುದಕ್ಕೆ ಯಾರೂ ಇರುವುದಿಲ್ಲ.<verse eid="ECC 4:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="ECC 4:11"/>ಇಬ್ಬರು ಜೊತೆಯಲ್ಲಿ ಮಲಗಿಕೊಂಡರೆ ಅವರಿಗೆ ಬೆಚ್ಚಗಾಗುತ್ತದೆ.</para>
  <para style="q2" vid="ECC 4:11">ಆದರೆ ಒಬ್ಬನಷ್ಟೆ ಹೇಗೆ ಬೆಚ್ಚಗಿರುತ್ತಾನೆ?<verse eid="ECC 4:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="ECC 4:12"/>ಒಬ್ಬಂಟಿಗನ ಮೇಲೆ ಜಯ ಸಾಧಿಸಲು,</para>
  <para style="q2" vid="ECC 4:12">ಇಬ್ಬರು ಎದುರಾಗಿ ನಿಲ್ಲಬಹುದು.</para>
  <para style="q1" vid="ECC 4:12">ಆದರೆ ಮೂರು ಹುರಿಯ ಹಗ್ಗವು ಬೇಗನೆ ಕಿತ್ತು ಹೋಗುವುದಿಲ್ಲ.<verse eid="ECC 4:12"/></para>
  <para style="s1">ಅಭಿವೃದ್ಧಿ ಸಹ ವ್ಯರ್ಥ</para>
  <para style="p">
    <verse number="13" style="v" sid="ECC 4:13"/>ಬುದ್ಧಿಯ ಹೇಳಿಕೆಗೆ ಕಿವಿಗೊಡದ ಮೂಢ ಮುದಿ ಅರಸನಿಗಿಂತ ಬಡವನಾದರೂ ಜ್ಞಾನಿಯಾದ ಒಬ್ಬ ಯುವಕನೇ ಮೇಲು. <verse eid="ECC 4:13"/><verse number="14" style="v" sid="ECC 4:14"/>ಆ ಯುವಕನು ಸೆರೆಮನೆಯಿಂದ ರಾಜ್ಯವನ್ನಾಳುವುದಕ್ಕಾಗಿ ಬಂದಿರಬಹುದು ಅಥವಾ ತನ್ನ ರಾಜ್ಯದಲ್ಲಿ ಬಡ ಪ್ರಜೆಯಾಗಿ ಹುಟ್ಟಿರಬಹುದು. <verse eid="ECC 4:14"/><verse number="15" style="v" sid="ECC 4:15"/>ಸೂರ್ಯನ ಕೆಳಗೆ ಜೀವಿಸಿ ನಡೆದಾಡಿದವರೆಲ್ಲರೂ ಅರಸನ ಪ್ರತಿಯಾಗಿ ಯುವಕನನ್ನು ಹಿಂಬಾಲಿಸಿದ್ದನ್ನೂ ನಾನು ನೋಡಿದೆನು. <verse eid="ECC 4:15"/><verse number="16" style="v" sid="ECC 4:16"/>ಇವನ ಆಧಿಪತ್ಯಕ್ಕೆ ಒಳಪಟ್ಟ ಜನರ ಸಂಖ್ಯೆಯು ಅಪಾರ. ಆದರೆ ಯುವಕನ ಆಳ್ವಿಕೆಯ ಮುಂಚೆ ಇದ್ದವರು ಮತ್ತು ತರುವಾಯ ಬಂದವರು ಇವನನ್ನು ಮೆಚ್ಚಲಿಲ್ಲ. ಇದು ಸಹ ಗಾಳಿಯನ್ನು ಬೆನ್ನಟ್ಟಿದಂತೆ ವ್ಯರ್ಥವೇ.<verse eid="ECC 4:16"/></para>
  <chapter eid="ECC 4"/>
  <chapter number="5" style="c" sid="ECC 5"/>
  <para style="s1">ದೇವರನ್ನು ಗೌರವಿಸಿ, ಅವರಿಗೆ ಭಯಪಡು</para>
  <para style="p">
    <verse number="1" style="v" sid="ECC 5:1"/>ದೇವರ ಆಲಯಕ್ಕೆ ಹೋಗುವಾಗ ನಿನ್ನ ಹೆಜ್ಜೆಯನ್ನು ಗಮನಿಸು. ಮೂರ್ಖರು ಅರ್ಪಿಸುವ ಯಜ್ಞಕ್ಕಿಂತ, ದೇವರ ಸಮೀಪವಾಗಿದ್ದು ಅವರಿಗೆ ಕಿವಿಗೊಟ್ಟು ಆಲಿಸುವುದು ಲೇಸು. ತಾವು ತಪ್ಪು ಮಾಡುತ್ತಿದ್ದಾರೆಂದು ಮೂಢರಿಗೆ ತಿಳಿಯುವುದಿಲ್ಲ.<verse eid="ECC 5:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="ECC 5:2"/>ನೀನು ದುಡುಕಿ ಮಾತನಾಡಬೇಡ,</para>
  <para style="q2" vid="ECC 5:2">ದೇವರ ಮುಂದೆ ಮಾತನಾಡಲು</para>
  <para style="q2" vid="ECC 5:2">ನಿನ್ನ ಹೃದಯವು ಆತುರಪಡದೇ ಇರಲಿ.</para>
  <para style="q1" vid="ECC 5:2">ದೇವರು ಪರಲೋಕದಲ್ಲಿದ್ದಾರೆ.</para>
  <para style="q2" vid="ECC 5:2">ನೀನಾದರೋ ಭೂಮಿಯ ಮೇಲೆ ಇರುವೆ,</para>
  <para style="q2" vid="ECC 5:2">ಆದಕಾರಣ ನಿನ್ನ ಮಾತುಗಳು ಕೊಂಚವಾಗಿರಲಿ.<verse eid="ECC 5:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="ECC 5:3"/>ಬಹಳ ಚಿಂತೆ ಇದ್ದಾಗಲೂ ಕನಸು ಬರುತ್ತದೆ.</para>
  <para style="q2" vid="ECC 5:3">ಮೂಢನು ಮಾತಾಡಿದರೆ ಸಾಕು, ಬಹು ಮಾತುಗಳು ಬರುತ್ತವೆ.<verse eid="ECC 5:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="ECC 5:4"/>ದೇವರಿಗೆ ನೀನು ಹರಕೆಯನ್ನು ಮಾಡಿದರೆ, ಅದನ್ನು ತೀರಿಸಲು ತಡಮಾಡಬೇಡ. ದೇವರು ಮೂಢರನ್ನು ಮೆಚ್ಚುವುದಿಲ್ಲ. ನೀನು ಹರಕೆ ಮಾಡಿದ್ದನ್ನು ತೀರಿಸು. <verse eid="ECC 5:4"/><verse number="5" style="v" sid="ECC 5:5"/>ಹರಕೆಮಾಡಿ ತೀರಿಸದೆ ಇರುವುದಕ್ಕಿಂತ, ಹರಕೆ ಮಾಡದೆ ಇರುವುದು ಒಳ್ಳೆಯದು. <verse eid="ECC 5:5"/><verse number="6" style="v" sid="ECC 5:6"/>ನಿನ್ನ ಬಾಯಿ ನಿನ್ನನ್ನು ಪಾಪಕ್ಕೆ ನಡೆಸದಂತೆ ನೋಡಿಕೋ. “ನಾನು ಹರಕೆ ಮಾಡಿದ್ದು ತಪ್ಪು,” ಎಂದು ದೂತನ ಮುಂದೆ ಹೇಳಬೇಡ. ಇದರಿಂದ ದೇವರು ನಿನ್ನ ಮಾತಿಗೆ ಮೆಚ್ಚದೆ, ನಿನ್ನನ್ನು ಏಕೆ ದಂಡಿಸಬೇಕು? <verse eid="ECC 5:6"/><verse number="7" style="v" sid="ECC 5:7"/>ಬಹು ಕನಸುಗಳೂ ಬಹು ಮಾತುಗಳೂ ವ್ಯರ್ಥವಾದವುಗಳು. ಆದ್ದರಿಂದ ನೀನು ದೇವರಿಗೆ ಭಯಪಡು.<verse eid="ECC 5:7"/></para>
  <para style="s1">ಐಶ್ವರ್ಯವು ವ್ಯರ್ಥ</para>
  <para style="p">
    <verse number="8" style="v" sid="ECC 5:8"/>ದೇಶದಲ್ಲಿ ಬಡವರ ಹಿಂಸೆಯನ್ನೂ ನೀತಿನ್ಯಾಯ ನಿರಾಕರಿಸಿದ್ದನ್ನೂ ನೀನು ನೋಡಿದರೆ, ಆಶ್ಚರ್ಯಪಡಬೇಡ. ಏಕೆಂದರೆ ಒಬ್ಬ ಅಧಿಕಾರಿಯ ಮೇಲೆ ಇನ್ನೊಬ್ಬನಿದ್ದಾನೆ. ಅವರಿಬ್ಬರ ಮೇಲೆ ಮತ್ತೊಬ್ಬ ಉನ್ನತ ಅಧಿಕಾರಿಗಳು ಇದ್ದಾರೆ. <verse eid="ECC 5:8"/><verse number="9" style="v" sid="ECC 5:9"/>ಭೂಮಿಯಿಂದ ಲಾಭವು ಎಲ್ಲರಿಗೂ ಇದೆ. ಹೊಲಗದ್ದೆಗಳಿಂದ ಅರಸನಿಗೂ ಲಾಭವಿದೆ.<verse eid="ECC 5:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="ECC 5:10"/>ಹಣವನ್ನು ಪ್ರೀತಿಸುವವರಿಗೆ ಎಷ್ಟು ಹಣ ಇದ್ದರೂ ಸಾಕಾಗದು.</para>
  <para style="q2" vid="ECC 5:10">ಆಸ್ತಿಯನ್ನು ಪ್ರೀತಿಸುವವನು ತನ್ನ ಆದಾಯದಿಂದ ತೃಪ್ತಿಗೊಳ್ಳುವುದಿಲ್ಲ.</para>
  <para style="q2" vid="ECC 5:10">ಇದೂ ಸಹ ವ್ಯರ್ಥವೇ.<verse eid="ECC 5:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="ECC 5:11"/>ಸೊತ್ತು ಹೆಚ್ಚಿದರೆ,</para>
  <para style="q2" vid="ECC 5:11">ಅದನ್ನು ಅನುಭವಿಸುವವರು ಹೆಚ್ಚಾಗುವರು.</para>
  <para style="q1" vid="ECC 5:11">ಯಜಮಾನರು ಅದನ್ನು ತಮ್ಮ ಕಣ್ಣಿಂದ ನೋಡುವುದೇ ಅವರಿಗಾಗುವ ಲಾಭ,</para>
  <para style="q2" vid="ECC 5:11">ಬೇರೆ ಯಾವ ಪ್ರಯೋಜನವಿದೆ?<verse eid="ECC 5:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="ECC 5:12"/>ಪ್ರಯಾಸ ಪಡುವವನು ಸ್ವಲ್ಪ ತಿಂದರೂ</para>
  <para style="q2" vid="ECC 5:12">ಹೆಚ್ಚು ತಿಂದರೂ ಅವನು ಹಾಯಾಗಿ ನಿದ್ರಿಸುತ್ತಾನೆ.</para>
  <para style="q1" vid="ECC 5:12">ಆದರೆ ಐಶ್ವರ್ಯವಂತನ ಸಮೃದ್ಧಿಯು</para>
  <para style="q2" vid="ECC 5:12">ಅವನನ್ನು ನಿದ್ರೆ ಮಾಡಗೊಡಿಸದು.<verse eid="ECC 5:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="ECC 5:13"/>ಸೂರ್ಯನ ಕೆಳಗೆ ವ್ಯಸನಕರವಾದ ಕೇಡನ್ನು ನಾನು ನೋಡಿದೆ. ಅದು ಯಾವುದೆಂದರೆ:</para>
  <para style="q1" vid="ECC 5:13">ಸಂಗ್ರಹಿಸಿದ ಆಸ್ತಿ ಯಜಮಾನನಿಗೆ ಹಾನಿ.<verse eid="ECC 5:13"/></para>
  <para style="q2">
    <verse number="14" style="v" sid="ECC 5:14"/>ಅದು ಹೇಗೆಂದರೆ, ಅನಾಹುತದಿಂದ ಆಸ್ತಿ ಕಳೆದುಹೋಗುತ್ತದೆ.</para>
  <para style="q1" vid="ECC 5:14">ಅವನಿಗೆ ಮಗನಿದ್ದರೆ,</para>
  <para style="q2" vid="ECC 5:14">ಅವನಿಗೆ ಏನೂ ಇರುವುದಿಲ್ಲ.<verse eid="ECC 5:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="ECC 5:15"/>ತಾಯಿಯ ಗರ್ಭದಿಂದ ಅವನು ಹೇಗೆ ಬರಿಗೈಯಲ್ಲಿ ಬಂದನೋ,</para>
  <para style="q2" vid="ECC 5:15">ಹಾಗೆ ಬರಿಗೈಯಲ್ಲಿ ಗತಿಸಿ ಹೋಗುವನು.</para>
  <para style="q1" vid="ECC 5:15">ಅವನು ಪ್ರಯಾಸ ಪಟ್ಟದ್ದಕ್ಕಾಗಿ ಯಾವುದನ್ನು</para>
  <para style="q2" vid="ECC 5:15">ತೆಗೆದುಕೊಂಡು ಹೋಗುವುದಿಲ್ಲ.<verse eid="ECC 5:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="ECC 5:16"/>ಇದು ಕೂಡ ವ್ಯಸನಕರವಾದ ಕೇಡು:</para>
  <para style="q1" vid="ECC 5:16">ಮನುಷ್ಯನು ಹೇಗೆ ಬಂದನೋ,</para>
  <para style="q2" vid="ECC 5:16">ಹಾಗೆಯೇ ಹೋಗುವನು.</para>
  <para style="q2" vid="ECC 5:16">ಗಾಳಿಗಾಗಿ ಪ್ರಯಾಸಪಟ್ಟವನಿಗೆ ಲಾಭವೇನಿದೆ?<verse eid="ECC 5:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="ECC 5:17"/>ತನ್ನ ಜೀವಮಾನವೆಲ್ಲಾ ಅವನು ಕತ್ತಲೆಯಲ್ಲಿ ಕಳೆಯುತ್ತಾನೆ.</para>
  <para style="q2" vid="ECC 5:17">ಅವನಿಗೆ ವ್ಯಾಧಿಯೊಂದಿಗೆ ಬಹಳ ವ್ಯಥೆಯೂ ಕ್ರೋಧವೂ ಇರುತ್ತದೆ.<verse eid="ECC 5:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="ECC 5:18"/>ದೇವರು ಮನುಷ್ಯನಿಗೆ ಕೊಟ್ಟದ್ದನ್ನು ಸೂರ್ಯನ ಕೆಳಗೆ ಅವನು ಕೈಗೊಂಡ ಪ್ರಯಾಸದ ಸುಖವನ್ನು ಅನುಭವಿಸಿ, ತಿಂದು, ಕುಡಿಯುವುದು ತೃಪ್ತಿಕರವಾದದ್ದೂ ಆಗಿದೆ, ಎಂದು ಒಂದು ಒಳ್ಳೆಯದನ್ನು ಕಂಡುಕೊಂಡೆನು. ಏಕೆಂದರೆ ಇದು ಮನುಷ್ಯನ ಪಾಲು. <verse eid="ECC 5:18"/><verse number="19" style="v" sid="ECC 5:19"/>ಮನುಷ್ಯನಿಗೆ ದೇವರು ಆಸ್ತಿಪಾಸ್ತಿಗಳನ್ನು ದಯಪಾಲಿಸಿ, ಅವುಗಳನ್ನು ಅನುಭವಿಸುವುದಕ್ಕೆ ಸಾಮರ್ಥ್ಯ ಕೊಟ್ಟಿದ್ದರೆ, ಅವನು ತನ್ನ ಪಾಲನ್ನು ತೆಗೆದುಕೊಂಡು, ತನ್ನ ಪ್ರಯಾಸದಲ್ಲಿ ಆನಂದಿಸುವುದೂ ದೇವರ ದಾನದಿಂದಲೇ. <verse eid="ECC 5:19"/><verse number="20" style="v" sid="ECC 5:20"/>ಇಂಥವನು ತನ್ನ ಜೀವಮಾನದ ದಿನಗಳನ್ನು ಗಣನೆಗೆ ತಂದುಕೊಳ್ಳನು. ಏಕೆಂದರೆ ಇವನು ತನ್ನ ಹೃದಯಾನಂದದಲ್ಲಿ ಮಗ್ನನಾಗಿರುವಂತೆ ದೇವರು ಮಾಡಿದ್ದಾರೆ.<verse eid="ECC 5:20"/></para>
  <chapter eid="ECC 5"/>
  <chapter number="6" style="c" sid="ECC 6"/>
  <para style="p">
    <verse number="1" style="v" sid="ECC 6:1"/>ಸೂರ್ಯನ ಕೆಳಗೆ ಇರುವ ಇನ್ನೊಂದು ಕೇಡನ್ನು ಕಂಡೆನು, ಅದು ಮನುಷ್ಯರ ಮೇಲೆ ಬಹು ಭಾರವಾಗಿದೆ. <verse eid="ECC 6:1"/><verse number="2" style="v" sid="ECC 6:2"/>ಅದೇನೆಂದರೆ, ಮನುಷ್ಯನು ಹೃದಯದಲ್ಲಿ ಬಯಸಿದ್ದನ್ನು ಕೊರತೆಯಾಗದಂತೆ ದೇವರು ಅವನಿಗೆ ಧನ, ಐಶ್ವರ್ಯ, ಸನ್ಮಾನವನ್ನು ಕೊಡುತ್ತಾರೆ. ಆದರೆ ಅದನ್ನು ಅನುಭವಿಸುವಂತೆ ದೇವರು ಸಾಮರ್ಥ್ಯವನ್ನು ಕೊಡುವುದಿಲ್ಲ. ಆದುದರಿಂದ ಪರರು ಅದನ್ನು ಅನುಭವಿಸುತ್ತಾರೆ. ಇದು ವ್ಯರ್ಥವೂ ವ್ಯಸನಕರವಾದ ಕೇಡು.<verse eid="ECC 6:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="ECC 6:3"/>ಒಬ್ಬ ಮನುಷ್ಯನಿಗೆ ನೂರು ಮಕ್ಕಳಿರಬಹುದು ಮತ್ತು ಅವನು ಬಹಳ ವರ್ಷ ಬದುಕಿರಬಹುದು. ಅವನು ತನ್ನ ಐಶ್ವರ್ಯವನ್ನು ಅನುಭವಿಸದೆ, ಸರಿಯಾದ ಶವಸಂಸ್ಕಾರ ಇಲ್ಲದೆ ಹೋದರೆ ಅವನಿಗಿಂತಲೂ ಮೃತ ಸ್ಧಿತಿಯಲ್ಲಿ ಹುಟ್ಟಿರುವ ಕೂಸೇ ಮೇಲು ಎಂದುಕೊಂಡೆ. <verse eid="ECC 6:3"/><verse number="4" style="v" sid="ECC 6:4"/>ಆ ಕೂಸು ವ್ಯರ್ಥವಾಗಿ ಬಂದು ಕತ್ತಲೆಯಲ್ಲಿ ಹೊರಟು ಹೋಗುತ್ತದೆ. ಅದರ ಹೆಸರು ಅಂಧಕಾರದಿಂದ ಕವಿದಿರುವುದು. <verse eid="ECC 6:4"/><verse number="5" style="v" sid="ECC 6:5"/>ಇದಲ್ಲದೆ ಅದು ಸೂರ್ಯನನ್ನು ನೋಡಲಿಲ್ಲ, ಯಾವುದನ್ನು ಅರಿತಿರಲಿಲ್ಲ. ಆದರೂ ಅದು ಆ ಮನುಷ್ಯನಿಗಿಂತ ಹೆಚ್ಚು ವಿಶ್ರಾಂತಿ ಹೊಂದಿದೆ. <verse eid="ECC 6:5"/><verse number="6" style="v" sid="ECC 6:6"/>ಒಂದು ವೇಳೆ ಎರಡು ಸಾವಿರ ವರ್ಷಗಳು ಆ ಮನುಷ್ಯನು ಬದುಕಿದರೂ ಅವನು ತನ್ನ ಐಶ್ವರ್ಯವನ್ನು ಅನುಭವಿಸದಿದ್ದರೆ ಏನು ಪ್ರಯೋಜನ? ಎಲ್ಲರೂ ಒಂದೇ ಸ್ಥಳಕ್ಕೆ ಹೋಗುತ್ತಾರಲ್ಲವೇ?<verse eid="ECC 6:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="ECC 6:7"/>ಪ್ರತಿಯೊಬ್ಬನ ಪ್ರಯಾಸ ಅವನ ಹೊಟ್ಟೆಗಾಗಿಯೇ,</para>
  <para style="q2" vid="ECC 6:7">ಆದರೆ ಅವನ ಹಸಿವು ತೃಪ್ತಿಹೊಂದುವುದಿಲ್ಲ.<verse eid="ECC 6:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="ECC 6:8"/>ಬುದ್ಧಿಹೀನನಿಗಿಂತ ಜ್ಞಾನಿಗೆ ಹೆಚ್ಚು ಲಾಭ ಏನಿದೆ?</para>
  <para style="q1" vid="ECC 6:8">ಇತರರ ಮುಂದೆ ಹೇಗೆ ವರ್ತಿಸಬೇಕು ಎಂದು</para>
  <para style="q2" vid="ECC 6:8">ತಿಳಿದುಕೊಳ್ಳುವುದರಿಂದ ಬಡವರಿಗೇನು ಲಾಭ?<verse eid="ECC 6:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="ECC 6:9"/>ಹೆಚ್ಚು ಅಪೇಕ್ಷಿಸಿ ಅಲೆದಾಡುವುದಕ್ಕಿಂತ</para>
  <para style="q2" vid="ECC 6:9">ಕಣ್ಣೆದುರಿಗೆ ಇರುವುದನ್ನು ಅನುಭವಿಸುವುದು ಉತ್ತಮ.</para>
  <para style="q1" vid="ECC 6:9">ಗಾಳಿಯನ್ನು ಬೆನ್ನಟ್ಟಿದಂತೆ</para>
  <para style="q2" vid="ECC 6:9">ಇದೂ ಕೂಡ ವ್ಯರ್ಥವೇ.<verse eid="ECC 6:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="ECC 6:10"/>ಜಗತ್ತಿನಲ್ಲಿ ಇರುವ ಎಲ್ಲದಕ್ಕೂ ಈಗಾಗಲೇ ಹೆಸರನ್ನು ಇಡಲಾಗಿದೆ.</para>
  <para style="q2" vid="ECC 6:10">ಮನುಷ್ಯನು ಯಾರು ಎಂದೂ ಗೊತ್ತಾಗಿದೆ.</para>
  <para style="q1" vid="ECC 6:10">ತನಗಿಂತ ಬಲಿಷ್ಟನೊಂದಿಗೆ</para>
  <para style="q2" vid="ECC 6:10">ಯಾರೂ ಹೋರಾಡುವುದಿಲ್ಲ.<verse eid="ECC 6:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="ECC 6:11"/>ಮಾತು ಹೆಚ್ಚಿದಷ್ಟೂ,</para>
  <para style="q2" vid="ECC 6:11">ಕಡಿಮೆ ಅರ್ಥೈಸುತ್ತವೆ,</para>
  <para style="q2" vid="ECC 6:11">ಅದರಿಂದ ಯಾರಿಗೆ ಏನು ಲಾಭ?<verse eid="ECC 6:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="ECC 6:12"/>ನೆರಳಿನಂತೆ ವ್ಯರ್ಥವಾಗಿ ಕಳೆದುಹೋಗುವ ಮನುಷ್ಯನ ಜೀವಮಾನದ ಎಲ್ಲಾ ದಿವಸಗಳಲ್ಲಿ ಅವನಿಗೆ ಯಾವುದು ಒಳ್ಳೆಯದೆಂದು ಯಾರಿಗೆ ಗೊತ್ತು? ಅವನು ಹೊರಟುಹೋದ ಮೇಲೆ ಸೂರ್ಯನ ಕೆಳಗೆ ಏನಾಗುತ್ತದೆಂದು ಅವನಿಗೆ ಯಾರು ಹೇಳಬಲ್ಲರು?<verse eid="ECC 6:12"/></para>
  <chapter eid="ECC 6"/>
  <chapter number="7" style="c" sid="ECC 7"/>
  <para style="s1">ಜ್ಞಾನ</para>
  <para style="q1">
    <verse number="1" style="v" sid="ECC 7:1"/>ಅಮೂಲ್ಯವಾದ ಸುಗಂಧ ತೈಲಕ್ಕಿಂತ ಒಳ್ಳೆಯ ಹೆಸರು ಉತ್ತಮ.</para>
  <para style="q2" vid="ECC 7:1">ಒಬ್ಬನ ಜನ್ಮ ದಿನಕ್ಕಿಂತ ಮರಣದ ದಿನವೇ ಮೇಲು.<verse eid="ECC 7:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="ECC 7:2"/>ಔತಣದ ಮನೆಗೆ ಹೋಗುವುದಕ್ಕಿಂತ,</para>
  <para style="q2" vid="ECC 7:2">ಶೋಕದ ಮನೆಗೆ ಹೋಗುವುದು ಲೇಸು.</para>
  <para style="q1" vid="ECC 7:2">ಏಕೆಂದರೆ ಎಲ್ಲಾ ಮನುಷ್ಯರ ಅಂತ್ಯವು ಸಾವಾಗಿದೆ.</para>
  <para style="q2" vid="ECC 7:2">ಇದರಿಂದ ಜೀವಂತರು ಇದನ್ನು ತಮ್ಮ ಹೃದಯದಲ್ಲಿ ಸ್ಮರಿಸಿಕೊಳ್ಳುವರು.<verse eid="ECC 7:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="ECC 7:3"/>ನಗೆಗಿಂತ ದುಃಖವು ವಾಸಿ,</para>
  <para style="q2" vid="ECC 7:3">ಏಕೆಂದರೆ ಮುಖದಲ್ಲಿ ದುಃಖ ಹೃದಯಕ್ಕೆ ಸುಖ.<verse eid="ECC 7:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="ECC 7:4"/>ಜ್ಞಾನಿಗಳ ಹೃದಯವು ಶೋಕದ ಮನೆಯಲ್ಲಿರುವುದು,</para>
  <para style="q2" vid="ECC 7:4">ಆದರೆ ಮೂಢರ ಹೃದಯವು ಉಲ್ಲಾಸದ ಮನೆಯಲ್ಲಿರುವುದು.<verse eid="ECC 7:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="ECC 7:5"/>ಮೂಢರ ಹಾಡನ್ನು ಕೇಳುವುದಕ್ಕಿಂತ,</para>
  <para style="q2" vid="ECC 7:5">ಜ್ಞಾನಿಗಳ ಗದರಿಕೆಯನ್ನು ಕೇಳುವುದು ಲೇಸು.<verse eid="ECC 7:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="ECC 7:6"/>ಗಡಿಗೆಯ ಕೆಳಗೆ ಉರಿಯುವ ಮುಳ್ಳುಕಡ್ಡಿ ಚಟಚಟನೆಯ ಶಬ್ದ ಹೇಗೋ,</para>
  <para style="q2" vid="ECC 7:6">ಮೂಢನ ನಗುವು ಹಾಗೆಯೇ ಇರುವುದು.</para>
  <para style="q2" vid="ECC 7:6">ಇದು ಕೂಡ ವ್ಯರ್ಥವೇ.<verse eid="ECC 7:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="ECC 7:7"/>ದಬ್ಬಾಳಿಕೆ ಜ್ಞಾನಿಯನ್ನು ಮೂರ್ಖನನ್ನಾಗಿ ಮಾಡುತ್ತದೆ.</para>
  <para style="q2" vid="ECC 7:7">ಲಂಚವು ಹೃದಯವನ್ನು ಕೆಡಿಸುತ್ತದೆ.<verse eid="ECC 7:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="ECC 7:8"/>ಪ್ರಾರಂಭಕ್ಕಿಂತ ಅದರ ಅಂತ್ಯವೇ ಲೇಸು.</para>
  <para style="q2" vid="ECC 7:8">ಗರ್ವಿಷ್ಠನಿಗಿಂತ ತಾಳ್ಮೆಯುಳ್ಳವನೇ ಉತ್ತಮ.<verse eid="ECC 7:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="ECC 7:9"/>ನೀನು ಕೋಪಿಸಿಕೊಳ್ಳುವುದಕ್ಕೆ ಆತುರಪಡದಿರು,</para>
  <para style="q2" vid="ECC 7:9">ಏಕೆಂದರೆ ಕೋಪವು ಮೂಢರ ಎದೆಯಲ್ಲಿ ನೆಲೆಗೊಳ್ಳುತ್ತದೆ.<verse eid="ECC 7:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="ECC 7:10"/>“ಹಿಂದಿನ ಕಾಲ ಈಗಿನ ಕಾಲಕ್ಕಿಂತ ಮೇಲಾಗಿರುವುದಕ್ಕೆ ಕಾರಣ ಏನು?” ಎಂದು ನೀನು ಕೇಳಬೇಡ.</para>
  <para style="q2" vid="ECC 7:10">ಇದು ಬುದ್ಧಿವಂತರು ಕೇಳುವ ಪ್ರಶ್ನೆಯಲ್ಲ.<verse eid="ECC 7:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="ECC 7:11"/>ಜ್ಞಾನವು ಆಸ್ತಿಯ ಹಾಗೆ ಒಳ್ಳೆಯದು;</para>
  <para style="q2" vid="ECC 7:11">ಅದರಿಂದ ಜೀವಂತರೆಲ್ಲರಿಗೂ ಲಾಭಕರ.<verse eid="ECC 7:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="ECC 7:12"/>ಧನವು ಹೇಗೋ</para>
  <para style="q2" vid="ECC 7:12">ಹಾಗೆ ಜ್ಞಾನವು ಆಶ್ರಯ.</para>
  <para style="q1" vid="ECC 7:12">ಆದರೆ ಜ್ಞಾನದ ಶ್ರೇಷ್ಠತೆ ಏನೆಂದರೆ,</para>
  <para style="q2" vid="ECC 7:12">ಅದು ಜ್ಞಾನಿಗೆ ಜೀವದಾಯಕ.<verse eid="ECC 7:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="ECC 7:13"/>ದೇವರ ಸೃಷ್ಟಿಕಾರ್ಯವನ್ನು ಯೋಚಿಸು:</para>
  <para style="q1" vid="ECC 7:13">ದೇವರು ಮಾಡಿದ್ದನ್ನು,</para>
  <para style="q2" vid="ECC 7:13">ಪುನಃ ಸರಿಪಡಿಸಲು ಯಾರಿಗೆ ಸಾಧ್ಯ?<verse eid="ECC 7:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="ECC 7:14"/>ಸುಖ ದಿನದಲ್ಲಿ ಸಂತೋಷವಾಗಿರು.</para>
  <para style="q2" vid="ECC 7:14">ಆದರೆ ದುಃಖ ದಿನದಲ್ಲಿ ಇದನ್ನು ಯೋಚಿಸು:</para>
  <para style="q1" vid="ECC 7:14">ದೇವರು ಇವುಗಳನ್ನು ಒಂದರ ಮೇಲೊಂದನ್ನು ಬರಮಾಡುತ್ತಾರೆ.</para>
  <para style="q2" vid="ECC 7:14">ಹೀಗೆ ಮನುಷ್ಯನು ತನ್ನ ಆಯುಸ್ಸನ್ನು ಕಳೆದ ಮೇಲೆ ಭವಿಷ್ಯವನ್ನು ಗ್ರಹಿಸಲಾರನು.<verse eid="ECC 7:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="ECC 7:15"/>ನನ್ನ ವ್ಯರ್ಥದ ದಿನಗಳಲ್ಲಿ ಇವೆರಡು ವಿಷಯಗಳನ್ನು ನೋಡಿದ್ದೇನೆ:</para>
  <para style="q1" vid="ECC 7:15">ನೀತಿವಂತನು ತನ್ನ ನೀತಿಯಲ್ಲಿ ಗತಿಸಿಹೋಗುತ್ತಾನೆ.</para>
  <para style="q2" vid="ECC 7:15">ದುಷ್ಟನು ತನ್ನ ದುಷ್ಟತನದಲ್ಲಿ, ಇಡೀ ಜೀವಮಾನವನ್ನು ಕಳೆಯುತ್ತಾನೆ.<verse eid="ECC 7:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="ECC 7:16"/>ನೀನು ಅತಿಯಾಗಿ ನೀತಿವಂತನಾಗಿರಬೇಡ.</para>
  <para style="q2" vid="ECC 7:16">ಅತಿಯಾಗಿ ನಿನ್ನನ್ನು ಜ್ಞಾನಿಯನ್ನಾಗಿಯೂ ಮಾಡಿಕೊಳ್ಳಬೇಡ.</para>
  <para style="q2" vid="ECC 7:16">ನಿನ್ನನ್ನು ನೀನೇ ಏಕೆ ನಾಶಪಡಿಸಿಕೊಳ್ಳುವೆ?<verse eid="ECC 7:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="ECC 7:17"/>ನೀನು ದುಷ್ಟತನದಲ್ಲಿ ಸಾಗಬೇಡ,</para>
  <para style="q2" vid="ECC 7:17">ಮೂರ್ಖತನದಲ್ಲಿಯೂ ಮುಂದುವರಿಯಬೇಡ.</para>
  <para style="q2" vid="ECC 7:17">ನಿನ್ನ ಸಮಯಕ್ಕಿಂತ ಮೊದಲು ನೀನು ಏಕೆ ಸಾಯುವೆ?<verse eid="ECC 7:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="ECC 7:18"/>ನೀನು ಇವುಗಳನ್ನು ಗ್ರಹಿಸಿಕೊಳ್ಳುವುದು ಒಳ್ಳೆಯದು.</para>
  <para style="q2" vid="ECC 7:18">ಹೌದು, ಇವುಗಳನ್ನು ಮರೆಯಬೇಡ.</para>
  <para style="q2" vid="ECC 7:18">ಏಕೆಂದರೆ ದೇವರಿಗೆ ಭಯಪಡುವವನು ಇವೆಲ್ಲವುಗಳಿಂದ ಪಾರಾಗುವನು.<verse eid="ECC 7:18"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="ECC 7:19"/>ಪಟ್ಟಣದ ಹತ್ತು ಮಂದಿ ಅಧಿಕಾರಿಗಳ ಸ್ಥಿರತೆಗಿಂತ,</para>
  <para style="q2" vid="ECC 7:19">ಜ್ಞಾನವು ಜ್ಞಾನಿಯನ್ನು ಹೆಚ್ಚಾಗಿ ಸ್ಥಿರಪಡಿಸುತ್ತದೆ.<verse eid="ECC 7:19"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="20" style="v" sid="ECC 7:20"/>ಪಾಪಮಾಡದೆ ಒಳ್ಳೆಯದನ್ನೇ ನಡೆಸುವ ನೀತಿವಂತನು,</para>
  <para style="q2" vid="ECC 7:20">ಭೂಮಿಯ ಮೇಲೆ ಒಬ್ಬನೂ ಇಲ್ಲ.<verse eid="ECC 7:20"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="21" style="v" sid="ECC 7:21"/>ಜನರು ಆಡಿದ ಎಲ್ಲಾ ಮಾತುಗಳನ್ನು ನೀನು ಲಕ್ಷಿಸಬೇಡ,</para>
  <para style="q2" vid="ECC 7:21">ನಿನ್ನ ಕೆಲಸದವರೂ ನಿನ್ನನ್ನು ಶಪಿಸಬಹುದು.<verse eid="ECC 7:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="ECC 7:22"/>ನೀನು ಸಹ ಅನೇಕ ವೇಳೆ ಇತರರನ್ನು ಶಪಿಸಿದ್ದೀ,</para>
  <para style="q2" vid="ECC 7:22">ಇದು ನಿನ್ನ ಹೃದಯಕ್ಕೆ ತಿಳಿದಿದೆ.<verse eid="ECC 7:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="ECC 7:23"/>ಇದೆಲ್ಲವನ್ನು ನಾನು ಜ್ಞಾನದಿಂದ ಪರೀಕ್ಷಿಸಿದ್ದೇನೆ,</para>
  <para style="q1" vid="ECC 7:23">“ನಾನು ಜ್ಞಾನಿಯಾಗಿರಲು ತೀರ್ಮಾನಿಸುತ್ತೇನೆ,” ಎಂದುಕೊಂಡೆನು.</para>
  <para style="q2" vid="ECC 7:23">ಆದರೆ ಅದು ನನ್ನಿಂದ ದೂರವಾಯಿತು.<verse eid="ECC 7:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="ECC 7:24"/>ದೂರದಲ್ಲಿರುವುದನ್ನೂ, ಅಗಾಧದಲ್ಲಿರುವುದನ್ನೂ</para>
  <para style="q2" vid="ECC 7:24">ಯಾರು ಕಂಡುಕೊಂಡಾರು?<verse eid="ECC 7:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="ECC 7:25"/>ಜ್ಞಾನದ ಮೂಲ ತತ್ವವನ್ನೂ,</para>
  <para style="q2" vid="ECC 7:25">ದುಷ್ಟತನದ ಮೂಢತನವನ್ನೂ,</para>
  <para style="q1" vid="ECC 7:25">ಮೂಢತ್ವದ ಹುಚ್ಚುತನವನ್ನೂ</para>
  <para style="q2" vid="ECC 7:25">ಪರೀಕ್ಷಿಸಿ ತಿಳಿದುಕೊಳ್ಳುವಂತೆ ಮನಸ್ಸುಮಾಡಿದೆನು.<verse eid="ECC 7:25"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="26" style="v" sid="ECC 7:26"/>ಕೆಟ್ಟ ಹೆಂಗಸಿನ ಹೃದಯವು ಬೋನೂ ಬಲೆಯೂ ಆಗಿರುತ್ತದೆ.</para>
  <para style="q2" vid="ECC 7:26">ಅವಳ ಕೈ ಸಂಕೋಲೆ ಆಗಿರುತ್ತದೆ.</para>
  <para style="q1" vid="ECC 7:26">ಇದು ಮರಣಕ್ಕಿಂತಲೂ ಕಠೋರವಾದದ್ದು ಎಂದು ನಾನು ಕಂಡಿದ್ದೇನೆ.</para>
  <para style="q2" vid="ECC 7:26">ದೇವರನ್ನು ಮೆಚ್ಚಿಸುವವನು,</para>
  <para style="q1" vid="ECC 7:26">ಅವಳಿಂದ ತಪ್ಪಿಸಿಕೊಳ್ಳುವನು.</para>
  <para style="q2" vid="ECC 7:26">ಆದರೆ ಪಾಪಿಯು ಅವಳ ಕೈಗೆ ಸಿಕ್ಕಿಬೀಳುವನು.<verse eid="ECC 7:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="ECC 7:27"/>“ನೋಡು, ನಾನಿದನ್ನು ಹುಡುಕಿ ಕಂಡುಕೊಂಡಿದ್ದೇನೆ,” ಎಂದು ಪ್ರಸಂಗಿಯು ಹೇಳುತ್ತಿದ್ದಾನೆ:</para>
  <para style="q1" vid="ECC 7:27">ನಾನು ಒಂದರ ನಂತರ ಮತ್ತೊಂದನ್ನು ಕೂಡಿಸಿ, ಸಂಶೋಧನೆಗಳನ್ನು ನಡೆಸಿದೆ;<verse eid="ECC 7:27"/></para>
  <para style="q2">
    <verse number="28" style="v" sid="ECC 7:28"/>ನಾನು ಹುಡುಕಿ ನೋಡಿದರೂ</para>
  <para style="q2" vid="ECC 7:28">ನನಗೆ ಇದುವರೆಗೆ ಉತ್ತರ ಸಿಕ್ಕಲಿಲ್ಲ.</para>
  <para style="q1" vid="ECC 7:28">ನಾನು ಸಾವಿರ ಪುರುಷರಲ್ಲಿ ಒಬ್ಬ ಸತ್ಯವಂತನನ್ನು ಕಂಡೆನು.</para>
  <para style="q2" vid="ECC 7:28">ಆದರೆ ಸಾವಿರ ಸ್ತ್ರೀಯರಲ್ಲಿ ಒಬ್ಬ ಸತ್ಯವಂತಳನ್ನು ಕಂಡುಕೊಳ್ಳಲಿಲ್ಲ.<verse eid="ECC 7:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="ECC 7:29"/>ಇದನ್ನು ಮಾತ್ರ ನಾನು ಕಂಡುಕೊಂಡಿದ್ದೇನೆ:</para>
  <para style="q2" vid="ECC 7:29">ದೇವರು ಮನುಷ್ಯರನ್ನು ಸತ್ಯವಂತರನ್ನಾಗಿ ಸೃಷ್ಟಿಸಿದರು.</para>
  <para style="q2" vid="ECC 7:29">ಮನುಷ್ಯರಾದರೋ ಅನೇಕ ಸ್ವಾರ್ಥ ಯೋಜನೆಗಳನ್ನು ಮಾಡಿಕೊಂಡಿದ್ದಾರೆ.<verse eid="ECC 7:29"/></para>
  <para style="b"/>
  <chapter eid="ECC 7"/>
  <chapter number="8" style="c" sid="ECC 8"/>
  <para style="q1">
    <verse number="1" style="v" sid="ECC 8:1"/>ಜ್ಞಾನಿಯ ಹಾಗೆ ಇರುವವರು ಯಾರು?</para>
  <para style="q2" vid="ECC 8:1">ಈ ಸಂಗತಿಗಳ ಅರ್ಥವನ್ನು ವಿವರಿಸಬಲ್ಲವರು ಯಾರು?</para>
  <para style="q1" vid="ECC 8:1">ಒಬ್ಬ ಮನುಷ್ಯನ ಜ್ಞಾನವು ಅವನ ಮುಖವನ್ನು ಬೆಳಗಿಸುತ್ತದೆ</para>
  <para style="q2" vid="ECC 8:1">ಜ್ಞಾನವು ಕಠಿಣ ಮುಖಭಾವವನ್ನು ಸಹ ಬದಲಾಯಿಸುತ್ತದೆ.<verse eid="ECC 8:1"/></para>
  <para style="s1">ಅರಸನ ಆಜ್ಞೆ ಪಾಲಿಸು</para>
  <para style="p">
    <verse number="2" style="v" sid="ECC 8:2"/>ನೀವು ದೇವರ ಮುಂದೆ ಪ್ರಮಾಣ ಮಾಡಿದ್ದರಿಂದ, ಅರಸನ ಆಜ್ಞೆಯನ್ನು ಕೈಕೊಳ್ಳಿರಿ ಎಂದು ಹೇಳುತ್ತೇನೆ. <verse eid="ECC 8:2"/><verse number="3" style="v" sid="ECC 8:3"/>ಅರಸನನ್ನು ಬಿಟ್ಟುಹೋಗುವುದಕ್ಕೆ ಆತುರ ಪಡಬೇಡಿರಿ. ಅರಸನು ತನಗೆ ಇಷ್ಟಬಂದದ್ದನ್ನೆಲ್ಲಾ ಮಾಡುತ್ತಾನೆ. ನೀವು ಕೆಟ್ಟ ಕಾರ್ಯಕ್ಕಾಗಿ ನಿಲ್ಲಬೇಡಿರಿ. <verse eid="ECC 8:3"/><verse number="4" style="v" sid="ECC 8:4"/>ಅರಸನ ಮಾತುಗಳೇ ಸರ್ವೋನ್ನತವಾದುದರಿಂದ, “ನೀನು ಮಾಡುವುದೇನು?” ಎಂದು ಅವನಿಗೆ ಪ್ರಶ್ನಿಸುವವರಾರು?<verse eid="ECC 8:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="ECC 8:5"/>ಅರಸನ ಆಜ್ಞೆಯನ್ನು ಪಾಲಿಸುವವನಿಗೆ ಕೇಡು ಸಂಭವಿಸುವುದಿಲ್ಲ,</para>
  <para style="q2" vid="ECC 8:5">ಜ್ಞಾನಿಯ ಹೃದಯವು ಸರಿಯಾದ ಕಾಲ ಕ್ರಮವನ್ನು ತಿಳಿದುಕೊಳ್ಳುತ್ತದೆ.<verse eid="ECC 8:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="ECC 8:6"/>ಮನುಷ್ಯನಿಗೆ ಕಷ್ಟಸಂಕಟವು ಭಾರವಾಗಿದ್ದರೂ</para>
  <para style="q2" vid="ECC 8:6">ಪ್ರತಿಯೊಂದು ಕಾರ್ಯಕ್ಕೂ ಸರಿಯಾದ ಕಾಲ ಮತ್ತು ಕ್ರಮ ಇರುತ್ತದೆ.<verse eid="ECC 8:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="ECC 8:7"/>ಏಕೆಂದರೆ ಮುಂದೆ ಆಗುವುದೇನೆಂದು ಯಾರಿಗೂ ತಿಳಿಯದು.</para>
  <para style="q2" vid="ECC 8:7">ಮುಂದೆ ಏನಾಗುವುದೆಂದು ಮನುಷ್ಯನಿಗೆ ತಿಳಿಸುವವರು ಯಾರು ಇಲ್ಲ.<verse eid="ECC 8:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="ECC 8:8"/>ನಮ್ಮ ಆತ್ಮವನ್ನು ತಡೆಯುವ ಶಕ್ತಿ ಯಾರಿಗೂ ಇಲ್ಲ.</para>
  <para style="q2" vid="ECC 8:8">ಹಾಗೆಯೇ ಸಾಯುವ ಸಮಯವನ್ನು ತಡೆಯುವ ಶಕ್ತಿಯು ಸಹ ಯಾರಿಗೂ ಇಲ್ಲ.</para>
  <para style="q1" vid="ECC 8:8">ಯುದ್ಧ ಸಮಯದಲ್ಲಿ ಹೇಗೆ ವಿರಾಮ ಇರುವುದಿಲ್ಲವೋ,</para>
  <para style="q2" vid="ECC 8:8">ಹಾಗೆಯೇ ದುಷ್ಟನಿಗೆ ದುಷ್ಟತ್ವದಿಂದ ಬಿಡುಗಡೆಯೇ ಇಲ್ಲ.<verse eid="ECC 8:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="ECC 8:9"/>ನಾನು ಇದನ್ನೆಲ್ಲಾ ನೋಡಿ, ಸೂರ್ಯನ ಕೆಳಗೆ ಮಾಡುವ ಪ್ರತಿಯೊಂದು ಕೆಲಸಕ್ಕೂ ನನ್ನ ಹೃದಯವನ್ನು ಪ್ರಯೋಗಿಸಿದ್ದೇನೆ. ಒಬ್ಬ ಮನುಷ್ಯನು ಇನ್ನೊಬ್ಬನ ಮೇಲೆ ತನ್ನ ಹಾನಿಗಾಗಿ ಅಧಿಕಾರ ನಡೆಸುವ ಕಾಲವೂ ಇದೆ. <verse eid="ECC 8:9"/><verse number="10" style="v" sid="ECC 8:10"/>ಇದಲ್ಲದೆ ದುರ್ಜನರು ಸತ್ತು ಸಮಾಧಿಯಾಗುವುದನ್ನೂ ನಾನು ನೋಡಿದ್ದೇನೆ. ಆದರೆ ಜನರು ಪರಿಶುದ್ಧ ಸ್ಥಳಕ್ಕೆ ಹೋಗಿ ಬಂದ ಆ ದುಷ್ಟರನ್ನು ಅವರಿದ್ದ ಪಟ್ಟಣದಲ್ಲಿ ಹೊಗಳುತ್ತಾರೆ<note caller="+" style="f"><char style="fr" closed="false">8:10 </char><char style="fq" closed="false">ಹೊಗಳುತ್ತಾರೆ </char><char style="ft" closed="false">ಪಟ್ಟಣದಲ್ಲಿ ಅವರ </char><char style="fqa" closed="false">ಜ್ಞಾಪಕವೇ </char><char style="ft" closed="false">ಇಲ್ಲವಾಯಿತು</char></note>. ಇದೂ ಸಹ ನಿರರ್ಥಕವಾದದ್ದು.<verse eid="ECC 8:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="ECC 8:11"/>ಏಕೆಂದರೆ ದುಷ್ಟ ಕೆಲಸಕ್ಕೆ ದಂಡನೆಯು ಕೂಡಲೇ ಆಗದಿರುವುದರಿಂದ ಮನುಷ್ಯರ ಹೃದಯವು ಅವರನ್ನು ಕೆಟ್ಟದ್ದು ಮಾಡುವ ಯುಕ್ತಿಯಲ್ಲಿಯೇ ತುಂಬಿರುವುದು. <verse eid="ECC 8:11"/><verse number="12" style="v" sid="ECC 8:12"/>ಪಾಪಿಯು ನೂರು ಸಾರಿ ಕೆಟ್ಟದ್ದನ್ನು ಮಾಡಿ, ಬಹುಕಾಲ ಬದುಕಿದರೂ ದೇವರಿಗೆ ಹೆದರಿ ದೈವಭಕ್ತಿಯುಳ್ಳವರಿಗೆ ಒಳ್ಳೆಯದಾಗುವುದೆಂದು ನಾನು ಬಲ್ಲೆನು. <verse eid="ECC 8:12"/><verse number="13" style="v" sid="ECC 8:13"/>ದುಷ್ಟರು ದೇವರಿಗೆ ಭಯಪಡುವುದಿಲ್ಲ. ಆದ್ದರಿಂದ ಅವರಿಗೆ ಒಳ್ಳೆಯದಾಗುವುದಿಲ್ಲ. ನೆರಳಿನ ಹಾಗಿರುವ ದುಷ್ಟರ ದಿನಗಳು ಹೆಚ್ಚುವುದಿಲ್ಲ.<verse eid="ECC 8:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="ECC 8:14"/>ಭೂಮಿಯ ಮೇಲೆ ನಡೆಯುವ ಇನ್ನೊಂದು ವ್ಯರ್ಥ ಕಾರ್ಯವಿದು: ದುಷ್ಟರಿಗೆ ಆಗಬೇಕಾದ ಶಿಕ್ಷೆಯನ್ನು ನೀತಿವಂತರು ಅನುಭವಿಸುತ್ತಾರೆ. ನೀತಿವಂತರಿಗೆ ಆಗಬೇಕಾದ ಪ್ರತಿಫಲವನ್ನು ದುಷ್ಟರು ಅನುಭವಿಸುತ್ತಾರೆ. ಇದು ಸಹ ವ್ಯರ್ಥವೆಂದು ನಾನು ಹೇಳುತ್ತೇನೆ. <verse eid="ECC 8:14"/><verse number="15" style="v" sid="ECC 8:15"/>ಆದುದರಿಂದ ನಾನು ಸಂತೋಷವನ್ನು ಮೆಚ್ಚಿದೆನು. ಏಕೆಂದರೆ ಮನುಷ್ಯನಿಗೆ ಸೂರ್ಯನ ಕೆಳಗೆ ಕುಡಿಯುವುದೂ ತಿನ್ನುವುದೂ ಸಂತೋಷಪಡುವುದೇ ಹೊರತು ಬೇರೇನೂ ಒಳ್ಳೆಯದಿಲ್ಲ. ಸೂರ್ಯನ ಕೆಳಗೆ ದೇವರು ಮನುಷ್ಯನಿಗೆ ಕೊಡುವ ಜೀವನದ ದಿವಸಗಳಲ್ಲಿ ಅವನು ಪಡುವ ಕಷ್ಟಕ್ಕೆ ಸುಖಾನುಭವವು ಅವನಿಗೆ ಸೇರಿರುತ್ತದೆ.<verse eid="ECC 8:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="ECC 8:16"/>ಜ್ಞಾನವನ್ನು ತಿಳಿದುಕೊಳ್ಳುವುದಕ್ಕೂ ಭೂಮಿಯ ಮೇಲೆ ಮಾಡುವ ಪರಿಶ್ರಮವನ್ನು ನೋಡುವುದಕ್ಕೂ ನಾನು ನನ್ನ ಹೃದಯವನ್ನು ಪ್ರಯೋಗಿಸಿದೆನು. ಜನರು ರಾತ್ರಿ ಹಗಲು ತಮ್ಮ ಕಣ್ಣುಗಳಿಗೆ ನಿದ್ರೆ ಹಚ್ಚಗೊಡದವರೂ ಇದ್ದಾರೆ. <verse eid="ECC 8:16"/><verse number="17" style="v" sid="ECC 8:17"/>ತರುವಾಯ ದೇವರ ಮಾಡುವ ಎಲ್ಲಾ ಕೆಲಸಗಳನ್ನು ನಾನು ನೋಡಿದೆನು. ಅದೇನೆಂದರೆ, ಸೂರ್ಯನ ಕೆಳಗೆ ಮಾಡುವ ದೇವರ ಕೆಲಸಗಳನ್ನು ಮನುಷ್ಯನು ಗ್ರಹಿಸಲಾರನು. ಮನುಷ್ಯನು ಅದನ್ನು ಹುಡುಕುವುದಕ್ಕೆ ಎಷ್ಟು ಕಷ್ಟಪಟ್ಟರೂ ಅದನ್ನು ಕಂಡುಕೊಳ್ಳಲಾರನು. ಹೌದು, ಜ್ಞಾನಿಯು ಸಹ ದೇವರು ಮಾಡುವುದನ್ನು ತಿಳಿದುಕೊಳ್ಳಲು ಯೋಚಿಸಿದರೂ ಅವನು ಅದನ್ನು ಕಂಡುಕೊಳ್ಳಲಾರನು.<verse eid="ECC 8:17"/></para>
  <chapter eid="ECC 8"/>
  <chapter number="9" style="c" sid="ECC 9"/>
  <para style="s1">ಎಲ್ಲರ ಅಂತ್ಯಸ್ಥಿತಿಯೂ ಒಂದೇ</para>
  <para style="p">
    <verse number="1" style="v" sid="ECC 9:1"/>ನಾನು ಇವೆಲ್ಲವುಗಳ ಮೇಲೆ ಅಭ್ಯಾಸ ಮಾಡಿ ಈ ತೀರ್ಮಾನಕ್ಕೆ ಬಂದೆನು. ಅದೇನೆಂದರೆ, ನೀತಿವಂತರ ಮತ್ತು ಜ್ಞಾನಿಗಳ ಕೆಲಸಗಳು ದೇವರ ಕೈಯಲ್ಲಿವೆ. ಆದರೆ ಅವರಿಗೆ ಪ್ರೀತಿ ಕಾದಿದೆಯೋ ಅಥವಾ ದ್ವೇಷ ಕಾದಿದೆಯೋ ಎಂದು ಯಾರಿಗೂ ಗೊತ್ತಿಲ್ಲ. <verse eid="ECC 9:1"/><verse number="2" style="v" sid="ECC 9:2"/>ಎಲ್ಲವೂ ಎಲ್ಲರಿಗೂ ಒಂದೇ ಬಗೆಯಾಗಿ ಸಂಭವಿಸುವುದು. ನೀತಿವಂತನಿಗೂ ದುಷ್ಟನಿಗೂ ಒಳ್ಳೆಯವನಿಗೂ ಕೆಟ್ಟವನಿಗೂ ಶುದ್ಧನಿಗೂ ಅಶುದ್ಧನಿಗೂ ಮತ್ತು ಯಜ್ಞ ಅರ್ಪಿಸುವವನಿಗೂ ಅರ್ಪಿಸದವನಿಗೂ ಒಂದೇ ಗತಿಯಾಗುವುದು.</para>
  <para style="q1" vid="ECC 9:2">ಒಳ್ಳೆಯವನಿಗೆ ಹೇಗೋ</para>
  <para style="q2" vid="ECC 9:2">ಹಾಗೆಯೇ ಪಾಪಿಗೂ ಇರುವುದು.</para>
  <para style="q1" vid="ECC 9:2">ಆಣೆಯಿಡುವವನಿಗೆ ಹೇಗೋ ಹಾಗೆಯೇ,</para>
  <para style="q2" vid="ECC 9:2">ಆಣೆಯಿಡಲು ಭಯಪಡುವವನಿಗೂ ಇರುವುದು.<verse eid="ECC 9:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="ECC 9:3"/>ಸೂರ್ಯನ ಕೆಳಗೆ ಮಾಡುವ ಎಲ್ಲಾ ಸಂಗತಿಗಳಲ್ಲಿಯೂ ಇದೂ ಒಂದು ವ್ಯಸನವು. ಎಲ್ಲರಿಗೂ ಒಂದೇ ಗತಿ ಇದೆ. ಹೌದು, ಮನುಷ್ಯರ ಹೃದಯದಲ್ಲಿ ಕೆಟ್ಟತನ ತುಂಬಿವೆ. ಅವರು ಬದುಕಿರುವ ತನಕ ಅವರ ಹೃದಯಗಳಲ್ಲಿ ಹುಚ್ಚುತನವಿದೆ. ಅನಂತರ ಅವರು ಸಾಯುತ್ತಾರೆ. <verse eid="ECC 9:3"/><verse number="4" style="v" sid="ECC 9:4"/>ಜೀವಂತರ ಗುಂಪಿಗೆ ಸೇರಿಕೊಂಡವನಿಗೆ ನಿರೀಕ್ಷೆ ಇರುವುದು. ಸತ್ತ ಸಿಂಹಕ್ಕಿಂತ ಬದುಕಿರುವ ನಾಯಿಯೇ ಉತ್ತಮ.<verse eid="ECC 9:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="ECC 9:5"/>ಬದುಕಿರುವವರು ತಾವು ಸಾಯುತ್ತೇವೆಂದು ತಿಳಿದಿದ್ದಾರೆ,</para>
  <para style="q2" vid="ECC 9:5">ಆದರೆ ಸತ್ತವರಿಗೆ ಏನೂ ತಿಳಿಯದು;</para>
  <para style="q1" vid="ECC 9:5">ಅವರಿಗೆ ಇನ್ನು ಮೇಲೆ ಪ್ರತಿಫಲ ಇಲ್ಲ.</para>
  <para style="q2" vid="ECC 9:5">ಅವರ ಹೆಸರನ್ನು ಸಹ ಜನರು ಮರೆತುಬಿಡುತ್ತಾರೆ.<verse eid="ECC 9:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="ECC 9:6"/>ಅವರ ಪ್ರೀತಿಯೂ ಅವರ ದ್ವೇಷವೂ</para>
  <para style="q2" vid="ECC 9:6">ಅವರ ಅಸೂಯೆ ಕೂಡ, ಅವರು ಸತ್ತಾಗಲೇ ಅಳಿದುಹೋಗುತ್ತವೆ.</para>
  <para style="q1" vid="ECC 9:6">ಸೂರ್ಯನ ಕೆಳಗೆ ನಡೆಯುವ ಯಾವ ಸಂಗತಿಗಳಲ್ಲಿಯೂ</para>
  <para style="q2" vid="ECC 9:6">ಸತ್ತವರಿಗೆ ಇನ್ನೆಂದಿಗೂ ಪಾಲು ಇಲ್ಲ.<verse eid="ECC 9:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="ECC 9:7"/>ನೀನು ಹೋಗಿ ನಿನ್ನ ಆಹಾರವನ್ನು ಸಂತೋಷದಿಂದ ತಿಂದು ಹರ್ಷ ಹೃದಯದಿಂದ ನಿನ್ನ ದ್ರಾಕ್ಷಾರಸವನ್ನು ಕುಡಿ. ಏಕೆಂದರೆ ನಿನ್ನ ಕೆಲಸಗಳನ್ನು ದೇವರು ಈಗಾಗಲೇ ಮೆಚ್ಚಿಕೊಂಡಿದ್ದಾರೆ. <verse eid="ECC 9:7"/><verse number="8" style="v" sid="ECC 9:8"/>ನಿನ್ನ ವಸ್ತ್ರಗಳು ಯಾವಾಗಲೂ ಬಿಳುಪಾಗಿರಲಿ, ನಿನ್ನ ತಲೆಗೆ ಯಾವಾಗಲೂ ಎಣ್ಣೆ ಹಚ್ಚಿರಲಿ. <verse eid="ECC 9:8"/><verse number="9" style="v" sid="ECC 9:9"/>ಈ ನಿರರ್ಥಕವಾದ ಎಲ್ಲಾ ದಿನಗಳಲ್ಲಿ ಸೂರ್ಯನ ಕೆಳಗೆ ದೇವರು ನಿನಗೆ ಕೊಟ್ಟ ಜೀವನದ ಎಲ್ಲಾ ದಿನಗಳಲ್ಲಿ, ನೀನು ಪ್ರೀತಿಸುವ ನಿನ್ನ ಹೆಂಡತಿಯೊಡನೆ ಆನಂದದಿಂದ ವಾಸಿಸು. ಸೂರ್ಯನ ಕೆಳಗೆ ನೀನು ಪಡುವ ನಿನ್ನ ಜೀವನದ ಕಷ್ಟದಲ್ಲಿ ಇದೇ ನಿನ್ನ ಪಾಲಾಗಿದೆ. <verse eid="ECC 9:9"/><verse number="10" style="v" sid="ECC 9:10"/>ನಿನ್ನ ಕೈಗೆ ಸಿಕ್ಕಿದ ಕೆಲಸವನ್ನೆಲ್ಲಾ ನಿನ್ನ ಪೂರ್ಣ ಶಕ್ತಿಯಿಂದ ಮಾಡು. ಏಕೆಂದರೆ ನೀನು ಹೋಗಲಿರುವ ಸಮಾಧಿಯಲ್ಲಿ, ಕೆಲಸವೂ ಯೋಜನೆಯೂ ತಿಳುವಳಿಕೆಯೂ ಜ್ಞಾನವೂ ಇರುವುದಿಲ್ಲ.<verse eid="ECC 9:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="ECC 9:11"/>ನಾನು ಮತ್ತೆ ಸೂರ್ಯನ ಕೆಳಗೆ ನೋಡಿದ್ದೇನೆಂದರೆ,</para>
  <para style="q1" vid="ECC 9:11">ವೇಗಿಗಳಿಗೆ ಓಟವೂ</para>
  <para style="q2" vid="ECC 9:11">ಪರಾಕ್ರಮಶಾಲಿಗಳಿಗೆ ಯುದ್ಧವೂ</para>
  <para style="q1" vid="ECC 9:11">ಜ್ಞಾನಿಗಳಿಗೆ ಆಹಾರವೂ</para>
  <para style="q2" vid="ECC 9:11">ವಿವೇಕಿಗಳಿಗೆ ಐಶ್ವರ್ಯವೂ</para>
  <para style="q2" vid="ECC 9:11">ಪ್ರವೀಣರಿಗೆ ದಯೆಯೂ ಸಿಗುವುದು ಎಂಬ ನಿಶ್ಚಯ ಇಲ್ಲ.</para>
  <para style="q1" vid="ECC 9:11">ಏಕೆಂದರೆ ಕಾಲವೂ ಅವಕಾಶವೂ ಅವರೆಲ್ಲರಿಗೆ ಒಳಪಟ್ಟಿರುತ್ತವೆ.<verse eid="ECC 9:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="ECC 9:12"/>ಇದಲ್ಲದೆ, ಅವರವರ ಸಮಯ ಯಾವಾಗ ಬರುತ್ತದೆ ಎಂದು ಯಾರಿಗೂ ತಿಳಿಯದು.</para>
  <para style="q1" vid="ECC 9:12">ಕ್ರೂರ ಬಲೆಯಿಂದ ಹಿಡಿಯುವ ಮೀನಿನಂತೆಯೂ</para>
  <para style="q2" vid="ECC 9:12">ಉರುಲಿನಲ್ಲಿ ಸಿಕ್ಕುವ ಪಕ್ಷಿಗಳಂತೆಯೂ</para>
  <para style="q1" vid="ECC 9:12">ಕೇಡಿನ ಕಾಲವು ತಟ್ಟನೆ ಬೀಳುವಾಗ</para>
  <para style="q2" vid="ECC 9:12">ಜನರು ಸಿಕ್ಕಿಕೊಳ್ಳುತ್ತಾರೆ.<verse eid="ECC 9:12"/></para>
  <para style="s1">ದಡ್ಡತನಕ್ಕಿಂತ ಜ್ಞಾನ ವಾಸಿ</para>
  <para style="p">
    <verse number="13" style="v" sid="ECC 9:13"/>ಸೂರ್ಯನ ಕೆಳಗೆ ನಾನು ಜ್ಞಾನವನ್ನು ಈ ವಿಧವಾಗಿ ನೋಡಿದ್ದೇನೆ. ಇದು ನನ್ನ ದೃಷ್ಟಿಗೆ ದೊಡ್ಡದಾಗಿ ಕಾಣಿಸಿತು. <verse eid="ECC 9:13"/><verse number="14" style="v" sid="ECC 9:14"/>ಒಂದು ಕಾಲದಲ್ಲಿ ಒಂದು ಸಣ್ಣ ನಗರವಿತ್ತು, ಅದರಲ್ಲಿ ಕೆಲವೇ ಜನರಿದ್ದರು. ಆಗ ಅಲ್ಲಿ ಒಬ್ಬ ಮಹಾ ಅರಸನು ಬಂದು ಅದನ್ನು ಮುತ್ತಿಗೆ ಹಾಕಿ, ಅದಕ್ಕೆ ಎದುರಾಗಿ ದೊಡ್ಡ ಕೊತ್ತಲುಗಳನ್ನು ಕಟ್ಟಿಸಿದನು. <verse eid="ECC 9:14"/><verse number="15" style="v" sid="ECC 9:15"/>ಆಗ ಅದರಲ್ಲಿ ಒಬ್ಬ ಜ್ಞಾನಿಯಾದ ಬಡ ಮನುಷ್ಯನು ಬಂದು, ತನ್ನ ಜ್ಞಾನದಿಂದ ಆ ಪಟ್ಟಣವನ್ನು ರಕ್ಷಿಸಿದನು. ಆದರೂ ಆ ಬಡ ಮನುಷ್ಯನನ್ನು ಯಾರೂ ಜ್ಞಾಪಕ ಮಾಡಿಕೊಳ್ಳಲಿಲ್ಲ. <verse eid="ECC 9:15"/><verse number="16" style="v" sid="ECC 9:16"/>ಇದನ್ನು ನೋಡಿ ನಾನು, “ಬಲಕ್ಕಿಂತ ಜ್ಞಾನವು ಉತ್ತಮ; ಆದರೆ ಜನರು ಬಡವನ ಜ್ಞಾನವನ್ನು ತಿರಸ್ಕಾರ ಮಾಡುತ್ತಾರೆ, ಅವನ ಮಾತುಗಳನ್ನು ಯಾರೂ ಲಕ್ಷಿಸುವುದಿಲ್ಲ,” ಎಂದುಕೊಂಡೆನು.<verse eid="ECC 9:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="ECC 9:17"/>ಹುಚ್ಚರನ್ನು ಆಳುವವನ ಕೂಗಾಟಕ್ಕಿಂತಲೂ</para>
  <para style="q2" vid="ECC 9:17">ಜ್ಞಾನಿಯ ಸಮಾಧಾನದ ಮಾತಿಗೆ ಮಹತ್ವ ಇದೆ.<verse eid="ECC 9:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="ECC 9:18"/>ಯುದ್ಧದ ಆಯುಧಗಳಿಗಿಂತಲೂ ಜ್ಞಾನವು ಲೇಸು.</para>
  <para style="q2" vid="ECC 9:18">ಆದರೆ ಒಬ್ಬ ಪಾಪಿಯು ಬಹು ಶುಭವನ್ನು ಹಾಳುಮಾಡುವನು.<verse eid="ECC 9:18"/></para>
  <para style="b"/>
  <chapter eid="ECC 9"/>
  <chapter number="10" style="c" sid="ECC 10"/>
  <para style="q1">
    <verse number="1" style="v" sid="ECC 10:1"/>ಸತ್ತ ನೊಣಗಳು ಸುಗಂಧ ತೈಲವನ್ನು ದುರ್ವಾಸನೆಗೆ ಒಳಪಡಿಸುತ್ತದೆ.</para>
  <para style="q2" vid="ECC 10:1">ಹಾಗೆಯೇ ಸ್ವಲ್ಪ ಮೂಢತನವು ಜ್ಞಾನ ಮಾನಗಳನ್ನು ಕೆಡಿಸಿಬಿಡುತ್ತದೆ.<verse eid="ECC 10:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="ECC 10:2"/>ಜ್ಞಾನಿಯ ಹೃದಯವು ಬಲಗಡೆ ಸಾಗಿದರೆ,</para>
  <para style="q2" vid="ECC 10:2">ಮೂರ್ಖನ ಹೃದಯವು ಎಡಗಡೆ ಸಾಗುವುದು.<verse eid="ECC 10:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="ECC 10:3"/>ಮೂರ್ಖನು ಮಾರ್ಗದಲ್ಲಿ ನಡೆಯುವಾಗಲೂ,</para>
  <para style="q2" vid="ECC 10:3">ತಾನು ಅರಿವಿಲ್ಲದ ಮೂರ್ಖನೆಂದು</para>
  <para style="q2" vid="ECC 10:3">ಪ್ರತಿಯೊಬ್ಬರಿಗೂ ಪ್ರಕಟಿಸುತ್ತಾನೆ.<verse eid="ECC 10:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="ECC 10:4"/>ಅಧಿಕಾರಿಯು ನಿನಗೆ ವಿರುದ್ಧವಾಗಿ ಸಿಟ್ಟುಗೊಂಡರೆ,</para>
  <para style="q2" vid="ECC 10:4">ನಿನ್ನ ಉದ್ಯೋಗವನ್ನು ಬಿಟ್ಟುಬಿಡಬೇಡ.</para>
  <para style="q2" vid="ECC 10:4">ಏಕೆಂದರೆ ತಾಳ್ಮೆಯು ದೊಡ್ಡ ಅಪರಾಧಗಳನ್ನು ಶಾಂತಪಡಿಸುತ್ತದೆ.<verse eid="ECC 10:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="ECC 10:5"/>ಮತ್ತೊಂದು ವ್ಯಸನವನ್ನು ನಾನು ಸೂರ್ಯನ ಕೆಳಗೆ ನೋಡಿದ್ದೇನೆ.</para>
  <para style="q2" vid="ECC 10:5">ಅದು ಆಳುವವರಿಂದ ಬರುವ ತಪ್ಪಿನಿಂದಾದದ್ದು.<verse eid="ECC 10:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="ECC 10:6"/>ಅದು ಯಾವುದೆಂದರೆ, ಮೂರ್ಖರನ್ನು ಉನ್ನತ ಪದವಿಗೆ ನೇಮಿಸುವುದು.</para>
  <para style="q2" vid="ECC 10:6">ಘನವಂತರನ್ನು ಕೆಳಗಿನ ಸ್ಥಳದಲ್ಲಿ ಕೂತುಕೊಳ್ಳುವಂತೆ ಮಾಡುವುದು.<verse eid="ECC 10:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="ECC 10:7"/>ಕುದುರೆಗಳ ಮೇಲೆ ಸವಾರಿ ಮಾಡುವ ಸೇವಕರನ್ನೂ</para>
  <para style="q2" vid="ECC 10:7">ಅಧಿಕಾರಿಗಳು ಸೇವಕರ ಹಾಗೆ ನಡೆದುಕೊಂಡು ಹೋಗುವುದನ್ನೂ ನಾನು ನೋಡಿದ್ದೇನೆ.<verse eid="ECC 10:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="ECC 10:8"/>ಗುಂಡಿಯನ್ನು ಅಗೆಯುವವನೇ ಅದರಲ್ಲಿ ಬೀಳುವನು.</para>
  <para style="q2" vid="ECC 10:8">ಗೋಡೆಯನ್ನು ಒಡೆಯುವವನನ್ನು ಹಾವು ಕಡಿಯುವುದು.<verse eid="ECC 10:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="ECC 10:9"/>ಗಣಿಯಿಂದ ಬಂಡೆಗಳನ್ನು ಸೀಳುವವನು ಗಾಯಗೊಳ್ಳುವನು.</para>
  <para style="q2" vid="ECC 10:9">ಮರಕಡಿಯುವವನು ಅದರಿಂದಲೇ ಅಪಾಯಕ್ಕೊಳಗಾಗುವನು.<verse eid="ECC 10:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="ECC 10:10"/>ಮೊಂಡುಕೊಡಲಿಯ ಬಾಯನ್ನು ಮೊನೆಮಾಡದಿದ್ದರೆ,</para>
  <para style="q2" vid="ECC 10:10">ಹೆಚ್ಚು ಬಲವನ್ನು ಪ್ರಯೋಗಿಸಬೇಕಾಗುವುದು,</para>
  <para style="q2" vid="ECC 10:10">ಆದರೆ ಜ್ಞಾನವೇ ಯಶಸ್ಸನ್ನು ತರುತ್ತದೆ.<verse eid="ECC 10:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="ECC 10:11"/>ಹಾವಾಡಿಸುವುದರೊಳಗೆ ಹಾವು ಕಚ್ಚಿದರೆ,</para>
  <para style="q2" vid="ECC 10:11">ಹಾವಾಡಿಗನಿಗೆ ಏನು ಪ್ರಯೋಜನ?<verse eid="ECC 10:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="ECC 10:12"/>ಜ್ಞಾನಿಯ ಮಾತುಗಳು ಹಿತಕರ.</para>
  <para style="q2" vid="ECC 10:12">ಆದರೆ ಬುದ್ಧಿಹೀನನ ಮಾತುಗಳು ಅವನಿಗೆ ವಿನಾಶಕರ.<verse eid="ECC 10:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="ECC 10:13"/>ಅವನ ಮಾತುಗಳು ಆರಂಭದಲ್ಲಿ ಮೂಢತನವಾಗಿರುವುದು.</para>
  <para style="q2" vid="ECC 10:13">ಅವನ ಮಾತಿನ ಅಂತ್ಯವು ಹುಚ್ಚುತನವಾಗಿರುವುದು.<verse eid="ECC 10:13"/></para>
  <para style="q2">
    <verse number="14" style="v" sid="ECC 10:14"/>ಮೂಢನು ಮಾತುಗಳನ್ನು ಹೆಚ್ಚಿಸುತ್ತಾನೆ.</para>
  <para style="b" vid="ECC 10:14"/>
  <para style="q1" vid="ECC 10:14">ಆದರೂ ಅವನು ಭವಿಷ್ಯ ಏನೆಂದು ತಿಳಿಯನು.</para>
  <para style="q2" vid="ECC 10:14">ಅವನ ತರುವಾಯ ಆಗುವುದನ್ನೂ ಅವನಿಗೆ ತಿಳಿಸುವವರು ಇಲ್ಲ.<verse eid="ECC 10:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="ECC 10:15"/>ಮೂಢರ ಕಷ್ಟವು ಅವರನ್ನು ದಣಿಸುತ್ತದೆ.</para>
  <para style="q2" vid="ECC 10:15">ನಗರಕ್ಕೆ ಹೇಗೆ ಹೋಗಬೇಕೆಂದು ಸಹ ಅವನಿಗೆ ತಿಳಿಯದು.<verse eid="ECC 10:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="ECC 10:16"/>ಬಾಲಕನಾಗಿದ್ದವನು ದೇಶಕ್ಕೆ ಅರಸನಾಗಿದ್ದರೆ,</para>
  <para style="q2" vid="ECC 10:16">ನಾಯಕರೆಲ್ಲರು ಬೆಳಿಗ್ಗೆಯೇ ಔತಣಕ್ಕೆ ಕೂತುಕೊಂಡರೆ ಅಯ್ಯೋ ಕಷ್ಟ!<verse eid="ECC 10:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="ECC 10:17"/>ಶ್ರೇಷ್ಠ ಹಿನ್ನೆಲೆಯವನು ದೇಶಕ್ಕೆ ಅರಸನಾದರೆ,</para>
  <para style="q2" vid="ECC 10:17">ರಾಜಕುಮಾರರು ಕುಡುಕರಾಗುವುದಕ್ಕೆ ಬದಲು,</para>
  <para style="q2" vid="ECC 10:17">ಸರಿಯಾದ ಸಮಯದಲ್ಲಿ ಶಕ್ತಿಗಾಗಿ ಊಟ ಮಾಡಿದರೆ ಅದು ದೇಶಕ್ಕೆ ಆಶೀರ್ವಾದ.<verse eid="ECC 10:17"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="18" style="v" sid="ECC 10:18"/>ಸೋಮಾರಿತನದಿಂದ ಮನೆ ಕುಸಿಯುತ್ತದೆ.</para>
  <para style="q2" vid="ECC 10:18">ಜೋಲುಗೈಯಿಂದ ಮನೆ ಸೋರುತ್ತದೆ.<verse eid="ECC 10:18"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="ECC 10:19"/>ವಿನೋದಕ್ಕಾಗಿ ಔತಣ ಮಾಡುತ್ತಾರೆ,</para>
  <para style="q2" vid="ECC 10:19">ಆನಂದಕ್ಕಾಗಿ ದ್ರಾಕ್ಷಾರಸ ಕುಡಿಯುತ್ತಾರೆ;</para>
  <para style="q2" vid="ECC 10:19">ಎಲ್ಲವನ್ನೂ ಒದಗಿಸಿಕೊಡುವುದಕ್ಕಾಗಿ ಹಣವು.<verse eid="ECC 10:19"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="20" style="v" sid="ECC 10:20"/>ನಿನ್ನ ಆಲೋಚನೆಯಲ್ಲಿಯೂ ಅರಸನನ್ನು ನಿಂದಿಸಬೇಡ.</para>
  <para style="q2" vid="ECC 10:20">ನೀನು ಮಲಗುವ ಕೋಣೆಯಲ್ಲಿ ಐಶ್ವರ್ಯವಂತರನ್ನು ಶಪಿಸಬೇಡ.</para>
  <para style="q1" vid="ECC 10:20">ಏಕೆಂದರೆ ಆಕಾಶದ ಪಕ್ಷಿಗಳು ನಿನ್ನ ಮಾತನ್ನು ತೆಗೆದುಕೊಂಡು ಹೋಗಬಹುದು.</para>
  <para style="q2" vid="ECC 10:20">ಹಾರುವ ಪಕ್ಷಿ ನಿನ್ನ ಸುದ್ದಿಯನ್ನು ತಿಳಿಸಬಹುದು.<verse eid="ECC 10:20"/></para>
  <chapter eid="ECC 10"/>
  <chapter number="11" style="c" sid="ECC 11"/>
  <para style="s1">ನೀರಿನ ಮೇಲೆ ರೊಟ್ಟಿ</para>
  <para style="q1">
    <verse number="1" style="v" sid="ECC 11:1"/>ನಿನ್ನ ಆಹಾರ ಧಾನ್ಯವನ್ನು ಹೊರನಾಡಿನ ವ್ಯಾಪಾರಕ್ಕೆ ಕಳುಹಿಸು.</para>
  <para style="q2" vid="ECC 11:1">ಬಹಳ ದಿನಗಳ ಮೇಲೆ ಅದರಿಂದ ನಿನಗೆ ಲಾಭ ಸಿಗುವುದು.<verse eid="ECC 11:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="ECC 11:2"/>ನಿನ್ನ ಹಣವನ್ನು ಏಳೆಂಟು ಮಂದಿಗೆ ವೆಚ್ಚಮಾಡು.</para>
  <para style="q2" vid="ECC 11:2">ಏಕೆಂದರೆ ಭೂಮಿಯ ಮೇಲೆ ಮುಂದೆ ಯಾವ ವಿಪತ್ತು ಬರುವುದೋ ನಿನಗೆ ತಿಳಿಯದು.<verse eid="ECC 11:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="ECC 11:3"/>ಮೋಡಗಳು ಮಳೆಯಿಂದ ತುಂಬಿದ್ದರೆ,</para>
  <para style="q2" vid="ECC 11:3">ಅವು ಭೂಮಿಯ ಮೇಲೆ ಸುರಿದುಬಿಡುತ್ತವೆ.</para>
  <para style="q1" vid="ECC 11:3">ಮರವು ಉತ್ತರ ಇಲ್ಲವೆ ದಕ್ಷಿಣಕ್ಕೆ ಬಿದ್ದರೆ,</para>
  <para style="q2" vid="ECC 11:3">ಆ ಮರವು ಬಿದ್ದ ಸ್ಥಳದಲ್ಲಿಯೇ ಇರುವುದು.<verse eid="ECC 11:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="ECC 11:4"/>ಯಾವನು ಗಾಳಿಗಾಗಿ ಕಾದಿರುವನೋ, ಅವನು ಬೀಜ ಬಿತ್ತುವುದಿಲ್ಲ.</para>
  <para style="q2" vid="ECC 11:4">ಮೋಡಗಳನ್ನು ಗಮನಿಸುತ್ತಿರುವವನು ಸಹ ಪೈರು ಕೊಯ್ಯುವುದಿಲ್ಲ.<verse eid="ECC 11:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="ECC 11:5"/>ಗಾಳಿಯ ಚಲನೆಯನ್ನಾಗಲಿ</para>
  <para style="q2" vid="ECC 11:5">ಗರ್ಭಿಣಿಯ ಭ್ರೂಣದ ಬೆಳವಣಿಗೆಯನ್ನಾಗಲಿ ನೀನು ಹೇಗೆ ಗ್ರಹಿಸಲಾರೆಯೋ,</para>
  <para style="q1" vid="ECC 11:5">ಹಾಗೆಯೇ, ಸರ್ವ ಸೃಷ್ಟಿಕರ್ತ ಆಗಿರುವ</para>
  <para style="q2" vid="ECC 11:5">ದೇವರ ಕೆಲಸವನ್ನು ನೀನು ಗ್ರಹಿಸಲಾರೆ.<verse eid="ECC 11:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="ECC 11:6"/>ಬೆಳಿಗ್ಗೆ ನಿನ್ನ ಬೀಜವನ್ನು ಬಿತ್ತು.</para>
  <para style="q2" vid="ECC 11:6">ಸಾಯಂಕಾಲದವರೆಗೂ ನಿನ್ನ ಕೈಗೆ ಬಿಡುವು ಕೊಡಬೇಡ.</para>
  <para style="q1" vid="ECC 11:6">ಏಕೆಂದರೆ ಇದು ಸಫಲವೋ ಅದು ಸಫಲವೋ ನಿನಗೆ ತಿಳಿಯದು.</para>
  <para style="q2" vid="ECC 11:6">ಎರಡೂ ಒಳ್ಳೆಯ ಬೆಳೆಯನ್ನು ಕೊಡಲು ಸಾಧ್ಯವಿದೆ.<verse eid="ECC 11:6"/></para>
  <para style="s1">ಸೃಷ್ಟಿಕರ್ತ ದೇವರನ್ನು ಸ್ಮರಿಸು</para>
  <para style="q1">
    <verse number="7" style="v" sid="ECC 11:7"/>ಬೆಳಕು ಹಿತಕರ.</para>
  <para style="q2" vid="ECC 11:7">ಸೂರ್ಯನ ಕಾಂತಿ ಕಣ್ಣುಗಳಿಗೆ ಮೆಚ್ಚಿಕೆ.<verse eid="ECC 11:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="ECC 11:8"/>ಒಬ್ಬನು ಅನೇಕ ವರ್ಷಗಳು ಬದುಕಿ,</para>
  <para style="q2" vid="ECC 11:8">ಅವುಗಳಲ್ಲೆಲ್ಲಾ ಸಂತೋಷಪಟ್ಟರೂ</para>
  <para style="q1" vid="ECC 11:8">ಕತ್ತಲೆಯ ದಿನಗಳನ್ನು ನೆನಪಿಸಿಕೊಳ್ಳಲಿ,</para>
  <para style="q2" vid="ECC 11:8">ಏಕೆಂದರೆ ಅಂಥ ದಿನಗಳು ಬಹಳ.</para>
  <para style="q2" vid="ECC 11:8">ಮುಂದಾಗುವುದೆಲ್ಲವೂ ವ್ಯರ್ಥವೇ.<verse eid="ECC 11:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="ECC 11:9"/>ಯುವಕನೇ, ನಿನ್ನ ಯೌವನದಲ್ಲಿ ಸಂತೋಷಪಡು.</para>
  <para style="q2" vid="ECC 11:9">ಯೌವನದ ದಿನಗಳಲ್ಲಿ ನಿನ್ನ ಹೃದಯವು ನಿನ್ನನ್ನು ಆನಂದಪಡಿಸಲಿ.</para>
  <para style="q1" vid="ECC 11:9">ನೀನು ನಿನ್ನ ಮನಸ್ಸಿಗೆ ಬಂದಂತೆಯೂ</para>
  <para style="q2" vid="ECC 11:9">ನಿನ್ನ ಕಣ್ಣಿನ ನೋಟದಂತೆಯೂ ನಡೆ.</para>
  <para style="q1" vid="ECC 11:9">ಆದರೆ ಈ ಎಲ್ಲಾ ಸಂಗತಿಗಳಿಗಾಗಿ</para>
  <para style="q2" vid="ECC 11:9">ದೇವರು ನಿನ್ನನ್ನು ನ್ಯಾಯವಿಚಾರಿಸುವರು ಎಂದು ತಿಳಿದುಕೋ.<verse eid="ECC 11:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="ECC 11:10"/>ಆದ್ದರಿಂದ ನಿನ್ನ ಹೃದಯದಿಂದ ಚಿಂತೆಯನ್ನು ತೆಗೆದುಹಾಕು.</para>
  <para style="q2" vid="ECC 11:10">ನಿನ್ನ ಶರೀರದಿಂದ ಕೆಟ್ಟದ್ದನ್ನು ದೂರಮಾಡು.</para>
  <para style="q2" vid="ECC 11:10">ಯೌವನವೂ ಅದರ ಚೈತನ್ಯವೂ ಅಲ್ಪಕಾಲವೇ.<verse eid="ECC 11:10"/></para>
  <para style="b"/>
  <chapter eid="ECC 11"/>
  <chapter number="12" style="c" sid="ECC 12"/>
  <para style="q1">
    <verse number="1" style="v" sid="ECC 12:1"/>ಕಷ್ಟದ ದಿನಗಳು ಬರುವುದಕ್ಕೆ ಮೊದಲು,</para>
  <para style="q2" vid="ECC 12:1">“ಇವುಗಳಲ್ಲಿ ನನಗೆ ಸಂತೋಷವಿಲ್ಲ,”</para>
  <para style="q1" vid="ECC 12:1">ಎಂದು ನೀನು ಹೇಳುವ ವರ್ಷಗಳು</para>
  <para style="q2" vid="ECC 12:1">ಸಮೀಪಿಸುವುದಕ್ಕೆ ಮೊದಲು,</para>
  <para style="q2" vid="ECC 12:1">ನಿನ್ನ ಯೌವನದ ದಿನಗಳಲ್ಲಿ ಸೃಷ್ಟಿಕರ್ತ ದೇವರನ್ನು ಸ್ಮರಿಸು.<verse eid="ECC 12:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="ECC 12:2"/>ಸೂರ್ಯ ಚಂದ್ರ</para>
  <para style="q2" vid="ECC 12:2">ನಕ್ಷತ್ರಗಳೂ ನಿನಗೆ ಮೊಬ್ಬಾಗಿ,</para>
  <para style="q2" vid="ECC 12:2">ಮಳೆಯ ಮೋಡಗಳು ಮತ್ತೆ ಬರುವುದಕ್ಕಿಂತ ಮೊದಲು ದೇವರನ್ನು ಸ್ಮರಿಸು.<verse eid="ECC 12:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="ECC 12:3"/>ಆ ದಿನದಲ್ಲಿ ಮನೆ ಕಾಯುವವರು ನಡುಗುವರು.</para>
  <para style="q2" vid="ECC 12:3">ಬಲವಾದ ಮನುಷ್ಯರು ಸಹ ತಾವಾಗಿಯೇ ಬಗ್ಗುವರು.</para>
  <para style="q1" vid="ECC 12:3">ಅರೆಯುವವರು ಕೆಲವರೇ ಉಳಿದಿರುವುದರಿಂದ ಸುಮ್ಮನಿರುವರು.</para>
  <para style="q2" vid="ECC 12:3">ಕಿಟಕಿಗಳಿಂದ ಹೊರಗೆ ನೋಡುವವರು ಮಂಕಾಗುವರು.<verse eid="ECC 12:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="ECC 12:4"/>ಬೀದಿ ಬಾಗಿಲುಗಳು ಮುಚ್ಚಿರುವುವು,</para>
  <para style="q2" vid="ECC 12:4">ಅರೆಯುವ ಶಬ್ದವು ಕಡಿಮೆಯಾಗುವುದು;</para>
  <para style="q1" vid="ECC 12:4">ಪಕ್ಷಿಯ ಶಬ್ದವಾದಾಗ ಎದ್ದೇಳುವುದು ತಡವಾಗುವುದು.</para>
  <para style="q2" vid="ECC 12:4">ಮುಂಜಾನೆಯ ಗಾನಸ್ವರ ಮಂದವಾಗುವುದು.<verse eid="ECC 12:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="ECC 12:5"/>ಎತ್ತರವನ್ನು ಕಂಡು ಹೆದರಿಕೆಯಾಗುವುದು.</para>
  <para style="q2" vid="ECC 12:5">ದಾರಿಯ ಅಪಾಯಗಳ ಬಗ್ಗೆ ಅಂಜಿಕೆಯಾಗುವುದು.</para>
  <para style="q1" vid="ECC 12:5">ಬಾದಾಮಿಯ ಮರದಂತೆ ಹೂವು ಬಿಡುವುದು.</para>
  <para style="q2" vid="ECC 12:5">ಮಿಡತೆಯು ಸಹ ಭಾರಾವಾಗಿರುವುದು.</para>
  <para style="q2" vid="ECC 12:5">ಆಸೆ ಕುಂದಿಹೋಗುವುದು.</para>
  <para style="q1" vid="ECC 12:5">ಈ ರೀತಿಯಾಗಿ ಮನುಷ್ಯನು ತನ್ನ ನಿತ್ಯ ಗೃಹಕ್ಕೆ ಹೊರಟು ಹೋಗುವರು.</para>
  <para style="q2" vid="ECC 12:5">ಗೋಳಾಡುವವರು ಬೀದಿಯಲ್ಲಿ ತಿರುಗಾಡುವರು.<verse eid="ECC 12:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="ECC 12:6"/>ಬೆಳ್ಳಿಯಂತ ಸರ ಕಿತ್ತುಹೋಗುವುದು,</para>
  <para style="q2" vid="ECC 12:6">ಬಂಗಾರದಂತ ಬಟ್ಟಲು ಜಜ್ಜಿ ಹೋಗುವುದು.</para>
  <para style="q1" vid="ECC 12:6">ಮಣ್ಣಿನ ಮಡಕೆಯು ಬುಗ್ಗೆಯ ಹತ್ತಿರ ಒಡೆದು ಹೋಗುವುದು.</para>
  <para style="q2" vid="ECC 12:6">ಬಾವಿಯ ರಾಟೆ ಮುರಿಯುವುದು.<verse eid="ECC 12:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="ECC 12:7"/>ಆಮೇಲೆ ಮಣ್ಣಿನ ದೇಹ ಅದು ಇದ್ದ ಹಾಗೆಯೇ ಭೂಮಿಗೆ ಸೇರುವುದು.</para>
  <para style="q2" vid="ECC 12:7">ಆತ್ಮವು ಅದನ್ನು ಕೊಟ್ಟ ದೇವರ ಬಳಿಗೆ ಹಿಂದಿರುಗುವುದು.<verse eid="ECC 12:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="ECC 12:8"/>“ವ್ಯರ್ಥ, ವ್ಯರ್ಥವೇ!</para>
  <para style="q2" vid="ECC 12:8">ಎಲ್ಲವೂ ವ್ಯರ್ಥವೇ!” ಎಂದು ಪ್ರಸಂಗಿ ಹೇಳುತ್ತಾನೆ.<verse eid="ECC 12:8"/></para>
  <para style="s1">ಕೊನೆಯ ಮಾತುಗಳು</para>
  <para style="p">
    <verse number="9" style="v" sid="ECC 12:9"/>ಇದಲ್ಲದೆ ಜ್ಞಾನವಂತ ಪ್ರಸಂಗಿಯು ಇನ್ನೂ ಜನರಿಗೆ ತಿಳುವಳಿಕೆಯನ್ನು ಬೋಧಿಸುತ್ತಾ ಬಂದನು. ಅನೇಕ ಜ್ಞಾನೋಕ್ತಿಗಳನ್ನು ಅವನು ಪರೀಕ್ಷಿಸಿ, ವಿಚಾರಿಸಿ ಕ್ರಮಪಡಿಸಿದನು. <verse eid="ECC 12:9"/><verse number="10" style="v" sid="ECC 12:10"/>ಪ್ರಸಂಗಿಯು ಸೂಕ್ತ ವಾಕ್ಯಗಳನ್ನು ಹುಡುಕಿ ಕಂಡುಹಿಡಿದನು. ಹಾಗೆ ಬರೆದವುಗಳು ಯಥಾರ್ಥ ಮತ್ತು ಸತ್ಯವಾದ ಮಾತುಗಳು.<verse eid="ECC 12:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="ECC 12:11"/>ಜ್ಞಾನಿಗಳ ಮಾತುಗಳು ಮುಳ್ಳುಗೋಲುಗಳ ಹಾಗಿರುತ್ತವೆ. ಅವರು ಸಂಗ್ರಹಿಸಿದ ವಚನಗಳು ಒಬ್ಬ ಆತ್ಮಿಕ ಕುರುಬನಿಂದ ನೆಟ್ಟ ಮೊಳೆಗಳ ಹಾಗೆ ಕೊಡಲಾಗಿವೆ. <verse eid="ECC 12:11"/><verse number="12" style="v" sid="ECC 12:12"/>ನನ್ನ ಮಗುವೇ, ಇವುಗಳನ್ನಲ್ಲದೇ, ನೀನು ಎಚ್ಚರಿಕೆಯಿಂದ ಇರಬೇಕಾದ ವಿಷಯಗಳು ಇನ್ನೂ ಇವೆ.</para>
  <para style="p" vid="ECC 12:12">ಬಹಳ ಪುಸ್ತಕಗಳ ರಚನೆಗೆ ಅಂತ್ಯವಿಲ್ಲ. ಅತಿಯಾದ ಅಭ್ಯಾಸವು ದೇಹಕ್ಕೆ ಆಯಾಸ.<verse eid="ECC 12:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="ECC 12:13"/>ಈಗ ನಾವು ಎಲ್ಲಾ ವಿಷಯವನ್ನೂ</para>
  <para style="q2" vid="ECC 12:13">ಕೇಳಿ ಮುಗಿಯಿತು.</para>
  <para style="q1" vid="ECC 12:13">ದೇವರಿಗೆ ಭಯಪಡು ಮತ್ತು ದೇವರ ಆಜ್ಞೆಗಳನ್ನು ಪಾಲಿಸು.</para>
  <para style="q2" vid="ECC 12:13">ಇದೇ ಮನುಷ್ಯನ ಪ್ರಮುಖ ಕರ್ತವ್ಯ.<verse eid="ECC 12:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="ECC 12:14"/>ಏಕೆಂದರೆ ಒಳ್ಳೆಯದಾಗಿರಲಿ, ಕೆಟ್ಟದ್ದಾಗಿರಲಿ,</para>
  <para style="q2" vid="ECC 12:14">ದೇವರು ಆ ಎಲ್ಲಾ ಕಾರ್ಯಗಳನ್ನೂ</para>
  <para style="q2" vid="ECC 12:14">ಪ್ರತಿಯೊಂದು ರಹಸ್ಯವನ್ನೂ ನ್ಯಾಯವಿಚಾರಣೆಗೆ ತರುವರು.<verse eid="ECC 12:14"/></para>
  <chapter eid="ECC 12"/>
</usx>
