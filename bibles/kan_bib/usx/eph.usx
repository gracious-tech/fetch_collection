<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="EPH" style="id">- Biblica® Open Kannada Contemporary Version</book>
  <para style="h">ಎಫೆಸದವರಿಗೆ</para>
  <para style="toc1">ಎಫೆಸದವರಿಗೆ ಪೌಲನು ಬರೆದ ಪತ್ರಿಕೆ</para>
  <para style="toc2">ಎಫೆಸದವರಿಗೆ</para>
  <para style="toc3">ಎಫೆಸ</para>
  <para style="mt1">ಎಫೆಸದವರಿಗೆ</para>
  <para style="mt2">ಪೌಲನು ಬರೆದ ಪತ್ರಿಕೆ</para>
  <chapter number="1" style="c" sid="EPH 1"/>
  <para style="p">
    <verse number="1" style="v" sid="EPH 1:1"/>ದೇವರ ಚಿತ್ತಾನುಸಾರವಾಗಿ ಕ್ರಿಸ್ತ ಯೇಸುವಿನ ಅಪೊಸ್ತಲನಾದ ಪೌಲನು,</para>
  <para style="b" vid="EPH 1:1"/>
  <para style="p" vid="EPH 1:1">ಎಫೆಸದಲ್ಲಿರುವ ಭಕ್ತರಿಗೂ ಕ್ರಿಸ್ತ ಯೇಸುವಿನಲ್ಲಿ ನಂಬಿಗಸ್ತರಿಗೂ ಬರೆಯುತ್ತಿರುವುದು:<verse eid="EPH 1:1"/></para>
  <para style="b"/>
  <para style="p">
    <verse number="2" style="v" sid="EPH 1:2"/>ನಮ್ಮ ತಂದೆಯಾದ ದೇವರಿಂದಲೂ ಕರ್ತ ಆಗಿರುವ ಯೇಸು ಕ್ರಿಸ್ತರಿಂದಲೂ ನಿಮಗೆ ಕೃಪೆಯೂ ಶಾಂತಿಯೂ ಆಗಲಿ.<verse eid="EPH 1:2"/></para>
  <para style="b"/>
  <para style="s1">ಕ್ರಿಸ್ತನಿಂದ ಆತ್ಮಿಕ ಆಶೀರ್ವಾದಗಳು</para>
  <para style="p">
    <verse number="3" style="v" sid="EPH 1:3"/>ನಮ್ಮ ಕರ್ತ ಆಗಿರುವ ಯೇಸುಕ್ರಿಸ್ತರ ದೇವರೂ ತಂದೆಯೂ ಆಗಿರುವವರಿಗೆ ಸ್ತೋತ್ರ, ದೇವರು ಕ್ರಿಸ್ತನಲ್ಲಿ ಪರಲೋಕದ ಎಲ್ಲಾ ಆತ್ಮಿಕ ಆಶೀರ್ವಾದಗಳಿಂದ ನಮ್ಮನ್ನು ಆಶೀರ್ವದಿಸಿದ್ದಾರೆ. <verse eid="EPH 1:3"/><verse number="4" style="v" sid="EPH 1:4"/>ನಾವು ಪ್ರೀತಿಯಲ್ಲಿದ್ದು ಅವರ ಮುಂದೆ ಪರಿಶುದ್ಧರೂ ನಿರ್ದೋಷಿಗಳೂ ಆಗಿರಬೇಕೆಂದು ಅವರು ಲೋಕದ ಅಸ್ತಿವಾರಕ್ಕೆ ಮುಂಚೆ ನಮ್ಮನ್ನು ಕ್ರಿಸ್ತನಲ್ಲಿ ಆರಿಸಿಕೊಂಡರು. <verse eid="EPH 1:4"/><verse number="5" style="v" sid="EPH 1:5"/>ದೇವರು ತಮ್ಮ ಚಿತ್ತದ ಸಂತೋಷಕ್ಕನುಸಾರವಾಗಿ ಕ್ರಿಸ್ತ ಯೇಸುವಿನ ಮೂಲಕ ನಮ್ಮನ್ನು ತಮಗೋಸ್ಕರ ತಮ್ಮ ಪುತ್ರರಾಗಿ ಸ್ವೀಕಾರ ಮಾಡುವಂತೆ ಮೊದಲೇ ನೇಮಿಸಿದರು. <verse eid="EPH 1:5"/><verse number="6" style="v" sid="EPH 1:6"/>ತಮ್ಮ ಕೃಪಾ ಮಹಿಮೆಯ ಸ್ತುತಿಗಾಗಿಯೇ ಇವುಗಳನ್ನು ದೇವರು ತಾವು ಪ್ರೀತಿಸುವ ಕ್ರಿಸ್ತನಲ್ಲಿ ನಮಗೆ ಉಚಿತವಾಗಿ ದಯಪಾಲಿಸಿದ್ದಾರೆ. <verse eid="EPH 1:6"/><verse number="7" style="v" sid="EPH 1:7"/>ದೇವರ ಕೃಪಾ ಐಶ್ವರ್ಯಕ್ಕೆ ಅನುಸಾರವಾಗಿ ಕ್ರಿಸ್ತನಲ್ಲಿ ನಮಗೆ ಅವರ ರಕ್ತದ ಮೂಲಕ ಪಾಪಗಳ ಕ್ಷಮಾಪಣೆಯಾಗಿ ವಿಮೋಚನೆಯಾಯಿತು. <verse eid="EPH 1:7"/><verse number="8" style="v" sid="EPH 1:8"/>ದೇವರು ಆ ಕೃಪೆಯನ್ನು ನಮ್ಮಲ್ಲಿ ಸಮೃದ್ಧಿಯಾಗಿ ಸುರಿಸಿದ್ದಾರೆ. ಎಲ್ಲಾ ಜ್ಞಾನ ವಿವೇಕಗಳೊಂದಿಗೆ <verse eid="EPH 1:8"/><verse number="9" style="v" sid="EPH 1:9"/>ದೇವರು ಕ್ರಿಸ್ತನಲ್ಲಿ ಉದ್ದೇಶಮಾಡಿಕೊಂಡ ತಮ್ಮ ಚಿತ್ತದ ರಹಸ್ಯವನ್ನು ಸಂತೋಷದಿಂದ ನಮಗೆ ಪ್ರಕಟಿಸಿದರು, <verse eid="EPH 1:9"/><verse number="10" style="v" sid="EPH 1:10"/>ಆ ರಹಸ್ಯವೋ ಭೂಪರಲೋಕಗಳಲ್ಲಿರುವ ಸಮಸ್ತವನ್ನೂ ಕಾಲವು ಪರಿಪೂರ್ಣಗೊಂಡಾಗ ಕ್ರಿಸ್ತನಲ್ಲಿ ಒಂದುಗೂಡಿಸುವುದಾಗಿದೆ.<verse eid="EPH 1:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="EPH 1:11"/>ದೇವರ ಚಿತ್ತಾನುಸಾರವಾಗಿ ಎಲ್ಲಾ ಕಾರ್ಯಗಳನ್ನು ನಡೆಸುವ ಅವರ ಉದ್ದೇಶದ ಪ್ರಕಾರ ಕ್ರಿಸ್ತನಲ್ಲಿ ನಮ್ಮನ್ನು ಮೊದಲೇ ಆರಿಸಿಕೊಂಡರು. <verse eid="EPH 1:11"/><verse number="12" style="v" sid="EPH 1:12"/>ಇದರಿಂದ ಕ್ರಿಸ್ತನಲ್ಲಿ ಮೊದಲು ನಿರೀಕ್ಷೆಯುಳ್ಳವರಾದ ನಾವು ಅವರ ಮಹಿಮೆಯ ಸ್ತುತಿಯಾಗಿರುವಂತೆ ನೇಮಿಸಿದರು. <verse eid="EPH 1:12"/><verse number="13" style="v" sid="EPH 1:13"/>ನೀವು ಸಹ ನಿಮ್ಮ ರಕ್ಷಣೆಯ ಸುವಾರ್ತೆಯ ಸತ್ಯವಾಕ್ಯವನ್ನು ಕೇಳಿದ ಮೇಲೆ ಕ್ರಿಸ್ತನಲ್ಲಿ ನಂಬಿಕೆಯಿಟ್ಟು ವಾಗ್ದಾನದ ಪವಿತ್ರಾತ್ಮರಿಂದ ಮುದ್ರೆಹೊಂದಿದ್ದೀರಿ. <verse eid="EPH 1:13"/><verse number="14" style="v" sid="EPH 1:14"/>ದೇವರಿಗೆ ಸೇರಿದವರಾದ ನಾವು ವಿಮೋಚನೆಯಾಗುವ ತನಕ ನಮ್ಮ ಸ್ವರ್ಗೀಯ ವಾರಸುತನವನ್ನು ಹೊಂದುವೆವು ಎಂಬುವುದಕ್ಕೆ ಈ ಪವಿತ್ರಾತ್ಮ ದೇವರೇ ನಮಗೆ ಹೊಣೆಯಾಗಿದ್ದಾರೆ. ದೇವರ ಮಹಿಮೆಯ ನಿಮಿತ್ಯವಾಗಿ ನಾವು ಅವರನ್ನು ಸ್ತುತಿಸೋಣ.<verse eid="EPH 1:14"/></para>
  <para style="s1">ಕೃತಜ್ಞತೆ ಮತ್ತು ಪ್ರಾರ್ಥನೆ</para>
  <para style="p">
    <verse number="15" style="v" sid="EPH 1:15"/>ಈ ಕಾರಣದಿಂದ ನಾನು ಸಹ ಕರ್ತ ಯೇಸುವಿನಲ್ಲಿರುವ ನಿಮ್ಮ ನಂಬಿಕೆ ಹಾಗೂ ಪರಿಶುದ್ಧರೆಲ್ಲರಿಗಾಗಿರುವ ಪ್ರೀತಿಯನ್ನು ಕುರಿತು ಕೇಳಿ, <verse eid="EPH 1:15"/><verse number="16" style="v" sid="EPH 1:16"/>ನನ್ನ ಪ್ರಾರ್ಥನೆಗಳಲ್ಲಿ ನಿಮಗಾಗಿ ವಿಜ್ಞಾಪಿಸಿ, ನಿಮ್ಮ ನಿಮಿತ್ತವಾಗಿ ಎಡಬಿಡದೆ ಸ್ತೋತ್ರ ಮಾಡುತ್ತೇನೆ. <verse eid="EPH 1:16"/><verse number="17" style="v" sid="EPH 1:17"/>ನಮ್ಮ ಕರ್ತ ಯೇಸುಕ್ರಿಸ್ತರ ದೇವರೂ ಮಹಿಮೆಯ ತಂದೆಯಾದವರನ್ನು ನೀವು ಪೂರ್ಣವಾಗಿ ತಿಳಿದುಕೊಳ್ಳುವಂತೆ ಜ್ಞಾನದ ಮತ್ತು ಪ್ರಕಟಣೆಯ ಆತ್ಮವನ್ನು ನಿಮಗೆ ಅನುಗ್ರಹಿಸಲಿ ಎಂದು ನಿಮಗಾಗಿ ಯಾವಾಗಲೂ ಪ್ರಾರ್ಥನೆ ಮಾಡುವವನಾಗಿದ್ದೇನೆ. <verse eid="EPH 1:17"/><verse number="18" style="v" sid="EPH 1:18"/>ದೇವರು ನಿಮ್ಮ ಮನೋನೇತ್ರಗಳನ್ನು ಬೆಳಗಿಸಲಿ ಎಂದು ಬೇಡಿಕೊಳ್ಳುತ್ತಿದ್ದೇನೆ. ಆಗ ಮಾತ್ರವೇ ನೀವು ದೇವರ ಕರೆಯ ನಿರೀಕ್ಷೆಯನ್ನೂ, ಪರಿಶುದ್ಧರಲ್ಲಿ ಅವರಿಗಿರುವ ವಾರಸುತನದ ಮಹಿಮೆಯನ್ನೂ ನೀವು ತಿಳಿದುಕೊಳ್ಳುವಿರಿ. <verse eid="EPH 1:18"/><verse number="19" style="v" sid="EPH 1:19"/>ಮಾತ್ರವಲ್ಲದೆ ನಂಬುವವರಾದ ನಮಗಾಗಿರುವ ಹೋಲಿಸಲಾಗದ ದೇವರ ಮಹಾಶಕ್ತಿಯನ್ನೂ ನೀವು ತಿಳಿಯುವಂತೆ ಪ್ರಾರ್ಥನೆ ಮಾಡುವವನಾಗಿದ್ದೇನೆ. <verse eid="EPH 1:19"/><verse number="20" style="v" sid="EPH 1:20"/>ಈ ಮಹಾಶಕ್ತಿಯನ್ನು ದೇವರು ಕ್ರಿಸ್ತನನ್ನು ಸತ್ತವರೊಳಗಿಂದ ಎಬ್ಬಿಸಿ, <verse eid="EPH 1:20"/><verse number="21" style="v" sid="EPH 1:21"/>ಸಕಲ ರಾಜತ್ವ, ಅಧಿಕಾರ, ಶಕ್ತಿ, ಪ್ರಭುತ್ವಗಳ ಮೇಲೆಯೂ ಈ ಲೋಕದಲ್ಲಿ ಮಾತ್ರವಲ್ಲದೆ ಬರುವ ಲೋಕದಲ್ಲಿಯೂ ಸಹ, ಹೆಸರುಗೊಂಡವರೆಲ್ಲರ ಮೇಲೆಯೂ ಎಷ್ಟೋ ಹೆಚ್ಚಾಗಿ ಪರಲೋಕದಲ್ಲಿ ಕ್ರಿಸ್ತರನ್ನು ತಮ್ಮ ಬಲಗಡೆಯಲ್ಲಿ ಕೂರಿಸಿಕೊಂಡರು. <verse eid="EPH 1:21"/><verse number="22" style="v" sid="EPH 1:22"/>ದೇವರು ಸಮಸ್ತವನ್ನೂ ಕ್ರಿಸ್ತನ ಪಾದಗಳ ಕೆಳಗೆ ಅಧೀನಮಾಡಿ, ಅವರನ್ನು ಎಲ್ಲದರ ಮೇಲೆ ಶಿರಸ್ಸಾಗಿರಲು ಸಭೆಗೋಸ್ಕರ ನೇಮಿಸಿದ್ದಾರೆ. <verse eid="EPH 1:22"/><verse number="23" style="v" sid="EPH 1:23"/>ಎಲ್ಲವನ್ನು ಎಲ್ಲಾ ವಿಧದಲ್ಲಿಯೂ ತುಂಬಿಸುವ ದೇವರಿಂದ ಕ್ರಿಸ್ತನ ದೇಹವಾಗಿರುವ ಸಭೆಯು ಪರಿಪೂರ್ಣ ಉಳ್ಳದ್ದಾಗಿದೆ.<verse eid="EPH 1:23"/></para>
  <chapter eid="EPH 1"/>
  <chapter number="2" style="c" sid="EPH 2"/>
  <para style="s1">ಕ್ರಿಸ್ತನಲ್ಲಿ ಜೀವಂತವಾಗಿರುವುದು</para>
  <para style="p">
    <verse number="1" style="v" sid="EPH 2:1"/>ನೀವು ನಿಮ್ಮ ಅಪರಾಧಗಳ ಮತ್ತು ಪಾಪಗಳ ದೆಸೆಯಿಂದ ಹಿಂದೊಮ್ಮೆ ಸತ್ತವರಾಗಿದ್ದೀರಿ. <verse eid="EPH 2:1"/><verse number="2" style="v" sid="EPH 2:2"/>ನೀವು, ಹಿಂದೆ ಇಹಲೋಕದ ಮಾರ್ಗಕ್ಕೆ ಅನುಸಾರವಾಗಿ ನಡೆದುಕೊಂಡು, ವಾಯುಮಂಡಲದ ಅಧಿಪತಿಯ ಆತ್ಮನಿಗನುಸಾರವಾಗಿದ್ದೀರಿ. ಆ ದುರಾತ್ಮವು ಈಗ ಅವಿಧೇಯತೆಯ ಮಕ್ಕಳಲ್ಲಿ ಕಾರ್ಯಮಾಡುತ್ತಿದೆ. <verse eid="EPH 2:2"/><verse number="3" style="v" sid="EPH 2:3"/>ಹಿಂದೊಮ್ಮೆ ನಾವೆಲ್ಲರೂ ಅವರೊಂದಿಗೆ ನಮ್ಮ ದೇಹದ ಆಶೆಗಳ ಪ್ರಕಾರ ಜೀವಿಸುತ್ತಿದ್ದಾಗ ಮನಸ್ಸಿನ ಹಾಗೂ ಶರೀರದ ಆಶೆಗಳನ್ನು ನೆರವೇರಿಸುತ್ತಾ ನಡೆದು, ಉಳಿದವರಂತೆ ಸ್ವಾಭಾವಿಕವಾಗಿ ದೇವರ ಕೋಪಕ್ಕೆ ಗುರಿಯಾದವರಾಗಿದ್ದೆವು. <verse eid="EPH 2:3"/><verse number="4" style="v" sid="EPH 2:4"/>ಆದರೆ ಕರುಣೆಯಲ್ಲಿ ಐಶ್ವರ್ಯವಂತರಾದ ದೇವರು ನಮ್ಮನ್ನು ಅಪಾರವಾಗಿ ಪ್ರೀತಿಸಿದರು. <verse eid="EPH 2:4"/><verse number="5" style="v" sid="EPH 2:5"/>ಹೇಗೆದಂರೆ, ಅಪರಾಧಗಳಲ್ಲಿ ಸತ್ತವರಾಗಿದ್ದರೂ ನಮ್ಮನ್ನು ಕ್ರಿಸ್ತನೊಂದಿಗೆ ಬದುಕಿಸಿದರು. ಹೀಗೆ ನೀವು ದೇವರ ಕೃಪೆಯಿಂದಲೇ ರಕ್ಷಣೆ ಹೊಂದಿದ್ದೀರಿ. <verse eid="EPH 2:5"/><verse number="6" style="v" sid="EPH 2:6"/>ಕ್ರಿಸ್ತ ಯೇಸುವಿನೊಂದಿಗೆ ದೇವರು ನಮ್ಮನ್ನು ಎಬ್ಬಿಸಿ ಪರಲೋಕದ ಉನ್ನತ ಸ್ಥಳಗಳಲ್ಲಿ ಕ್ರಿಸ್ತನೊಂದಿಗೇ ನಮ್ಮನ್ನು ಕೂತುಕೊಳ್ಳುವಂತೆ ಮಾಡಿದ್ದಾರೆ. <verse eid="EPH 2:6"/><verse number="7" style="v" sid="EPH 2:7"/>ಮುಂದಣ ಯುಗಗಳಲ್ಲಿ ಕ್ರಿಸ್ತ ಯೇಸುವಿನ ದಯೆಯ ಮೂಲಕ ದೇವರು ತಮ್ಮ ಮಿತಿಯಿಲ್ಲದ ಕೃಪೆಯನ್ನು ನಮಗೆ ತೋರಿಸಬೇಕೆಂದಿದ್ದಾರೆ. <verse eid="EPH 2:7"/><verse number="8" style="v" sid="EPH 2:8"/>ನಂಬಿಕೆಯ ಮೂಲಕ ಕೃಪೆಯಿಂದಲೇ ನೀವು ರಕ್ಷಣೆ ಹೊಂದಿದ್ದೀರಿ. ಈ ರಕ್ಷಣೆಯು ನಿಮ್ಮಿಂದ ಉಂಟಾದದ್ದಲ್ಲ, ಇದು ದೇವರ ದಾನವೇ. <verse eid="EPH 2:8"/><verse number="9" style="v" sid="EPH 2:9"/>ಯಾರಾದರೂ ಹೆಮ್ಮೆ ಪಡುವಂತೆ ಈ ರಕ್ಷಣೆಯು ಪುಣ್ಯಕ್ರಿಯೆಗಳಿಂದ ಉಂಟಾದದ್ದೂ ಅಲ್ಲ. <verse eid="EPH 2:9"/><verse number="10" style="v" sid="EPH 2:10"/>ನಾವು ಕ್ರಿಸ್ತ ಯೇಸುವಿನಲ್ಲಿ ಸತ್ಕ್ರಿಯೆಗಳನ್ನು ಮಾಡುವುದಕ್ಕಾಗಿಯೇ ಸೃಷ್ಟಿಸಲಾದ ದೇವರ ಕಲಾಕೃತಿಯಾಗಿದ್ದೇವೆ. ಸತ್ಕ್ರಿಯೆಗಳನ್ನು ಮಾಡುತ್ತಾ ಬಾಳಬೇಕೆಂದು ದೇವರು ನಮ್ಮನ್ನು ಮುಂಚಿತವಾಗಿ ನೇಮಿಸಿದ್ದಾರೆ.<verse eid="EPH 2:10"/></para>
  <para style="s1">ಕ್ರಿಸ್ತನಲ್ಲಿ ಒಂದಾಗಿರುವುದು</para>
  <para style="p">
    <verse number="11" style="v" sid="EPH 2:11"/>ಆದಕಾರಣ ಸುನ್ನತಿಮಾಡಿಸಿಕೊಂಡಿದ್ದೇವೆ ಎಂದು ತಮ್ಮ ಬಗ್ಗೆ ಹೇಳಿಕೊಂಡವರು, ಹುಟ್ಟಿದಂದಿನಿಂದ ಯೆಹೂದ್ಯರಲ್ಲದವರಾದ ನಿಮಗೆ ಸುನ್ನತಿಮಾಡಿಸಿಕೊಳ್ಳದವರು ಎಂದು ಹೇಳಿದ್ದನು ನೆನಪುಮಾಡಿಕೊಳ್ಳಿ. ಈ ಸುನ್ನತಿಯು ಮನುಷ್ಯರಿಂದಾದದ್ದಷ್ಟೇ. <verse eid="EPH 2:11"/><verse number="12" style="v" sid="EPH 2:12"/>ಇದಲ್ಲದೆ ನೀವು ಆಗ ಕ್ರಿಸ್ತನಿಲ್ಲದವರೂ ಇಸ್ರಾಯೇಲಿನ ಪೌರತ್ವದಿಂದ ಪ್ರತ್ಯೇಕಿಸಲಾದವರೂ ಒಡಂಬಡಿಕೆಯ ವಾಗ್ದಾನಕ್ಕೆ ವಿದೇಶಿಯವರೂ ಲೋಕದಲ್ಲಿ ದೇವರೊಂದಿಗೆ ಯಾವ ಸಂಬಂಧವಿಲ್ಲದೆ ನಿರೀಕ್ಷೆಯಿಲ್ಲದವರೂ ಆಗಿದ್ದೀರೆಂದು ಜ್ಞಾಪಕಮಾಡಿಕೊಳ್ಳಿರಿ. <verse eid="EPH 2:12"/><verse number="13" style="v" sid="EPH 2:13"/>ಮೊದಲು ಕ್ರಿಸ್ತ ಯೇಸುವಿಗೆ ದೂರವಾಗಿದ್ದ ನೀವು ಈಗ ಕ್ರಿಸ್ತನ ರಕ್ತದ<note caller="+" style="f"><char style="fr" closed="false">2:13 </char><char style="ft" closed="false">ಅಥವಾ </char><char style="fqa" closed="false">ಶಿಲುಬೆಯ ಮರಣದಿಂದ</char></note> ಮೂಲಕ ಹತ್ತಿರವಾಗಿದ್ದೀರಿ.<verse eid="EPH 2:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="EPH 2:14"/>ಕ್ರಿಸ್ತ ಯೇಸು ತಾವೇ ನಮ್ಮ ಸಮಾಧಾನವಾಗಿದ್ದು, ಎರಡು ಗುಂಪಿನವರನ್ನು ಒಂದು ಮಾಡಿ, ಅಗಲಿಸಿದ ವೈರತ್ವದ ಅಡ್ಡಗೋಡೆಯನ್ನು ತಮ್ಮ ಶರೀರದ ಮೂಲಕ ಕೆಡವಿಹಾಕಿದರು. <verse eid="EPH 2:14"/><verse number="15" style="v" sid="EPH 2:15"/>ಹೀಗೆ ಕ್ರಿಸ್ತ ಯೇಸು ತಮ್ಮ ದೇಹವನ್ನು ಶಿಲುಬೆಯಲ್ಲಿ ಸಮರ್ಪಿಸಿದ್ದರಿಂದ ನಿಯಮದ ಆಜ್ಞೆಗಳುಳ್ಳ ಶಾಸನಗಳನ್ನು ರದ್ದುಗೊಳಿಸಿದರು. ಈ ರೀತಿಯಾಗಿ ಇವೆರಡೂ ಗುಂಪಿನವರಿಂದ ಒಬ್ಬ ನೂತನ ಮಾನವತ್ವವನ್ನು ತಮ್ಮಲ್ಲಿ ಸೃಷ್ಟಿಸಿ ಸಮಾಧಾನವನ್ನು ಉಂಟುಮಾಡಿದರು. <verse eid="EPH 2:15"/><verse number="16" style="v" sid="EPH 2:16"/>ಶಿಲುಬೆಯ ಮರಣದ ಮೂಲಕ ಇವೆರಡೂ ಗುಂಪಿನವರಿಂದ ಒಂದೇ ದೇಹದವರನ್ನಾಗಿ ಮಾಡಿ ದೇವರೊಂದಿಗೆ ಸಂಧಾನಪಡಿಸಿ, ಇದ್ದ ವೈರತ್ವವನ್ನು ಇಲ್ಲದಂತೆ ಮಾಡಿದರು. <verse eid="EPH 2:16"/><verse number="17" style="v" sid="EPH 2:17"/>ಇದಲ್ಲದೆ ಕ್ರಿಸ್ತ ಯೇಸುವು ಬಂದು ದೂರವಾಗಿದ್ದ ನಿಮಗೂ ಸಮೀಪವಾಗಿದ್ದ ನಮಗೂ ಸಮಾಧಾನವನ್ನು ಸಾರಿದರು. <verse eid="EPH 2:17"/><verse number="18" style="v" sid="EPH 2:18"/>ಏಕೆಂದರೆ ಕ್ರಿಸ್ತ ಯೇಸುವಿನ ಮೂಲಕ ನಾವೂ ನೀವೂ ಪವಿತ್ರಾತ್ಮ ದೇವರಿಂದ ತಂದೆಯ ಬಳಿಗೆ ಪ್ರವೇಶಿಸುವುದಕ್ಕೆ ಮಾರ್ಗವಾಯಿತು.<verse eid="EPH 2:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="EPH 2:19"/>ಹೀಗಿರಲಾಗಿ, ನೀವು ಇನ್ನು ಮೇಲೆ ಪರಕೀಯರೂ ಪರದೇಶದವರೂ ಆಗಿರದೆ ದೇವಜನರೊಂದಿಗೆ ಜೊತೆ ನಾಗರಿಕರೂ ದೇವರ ಮನೆಯವರೂ ಆಗಿದ್ದೀರಿ. <verse eid="EPH 2:19"/><verse number="20" style="v" sid="EPH 2:20"/>ಕ್ರಿಸ್ತ ಯೇಸು ಎಂಬ ಮುಖ್ಯ ಮೂಲೆಗಲ್ಲಿನೊಂದಿಗೆ ಅಪೊಸ್ತಲರು ಹಾಗೂ ಪ್ರವಾದಿಗಳೆಂಬ ಅಸ್ತಿವಾರದ ಮೇಲೆ ನೀವು ಕಟ್ಟಲಾಗಿದ್ದೀರಿ. <verse eid="EPH 2:20"/><verse number="21" style="v" sid="EPH 2:21"/>ಕ್ರಿಸ್ತನಲ್ಲಿ ಕಟ್ಟಡವೆಲ್ಲವೂ ಒಂದಾಗಿ ವೃದ್ಧಿಯಾಗುತ್ತಾ ಕರ್ತನಲ್ಲಿ ಪರಿಶುದ್ಧ ದೇವಾಲಯವಾಗುತ್ತದೆ. <verse eid="EPH 2:21"/><verse number="22" style="v" sid="EPH 2:22"/>ನೀವೂ ಸಹ ಆತ್ಮನ ಮೂಲಕ ಕ್ರಿಸ್ತನಲ್ಲಿ ದೇವರಿಗೆ ನಿವಾಸಸ್ಥಾನವಾಗುವಂತೆ ಒಟ್ಟಾಗಿ ನಿರ್ಮಿತರಾಗುತ್ತಿದ್ದೀರಿ.<verse eid="EPH 2:22"/></para>
  <chapter eid="EPH 2"/>
  <chapter number="3" style="c" sid="EPH 3"/>
  <para style="s1">ಪೌಲನು ಯೆಹೂದ್ಯರಲ್ಲದವರ ಅಪೊಸ್ತಲನು</para>
  <para style="p">
    <verse number="1" style="v" sid="EPH 3:1"/>ಈ ಕಾರಣದಿಂದ ಯೆಹೂದ್ಯರಲ್ಲದವರಾಗಿರುವ ನಿಮ್ಮ ನಿಮಿತ್ತ ಕ್ರಿಸ್ತ ಯೇಸುವಿನ ಸೆರೆಯಾಳಾಗಿರುವ ಪೌಲನೆಂಬ ನಾನು ಹೇಳುವುದೇನೆಂದರೆ:<verse eid="EPH 3:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="EPH 3:2"/>ನಿಮಗೋಸ್ಕರವಾಗಿ ನನಗೆ ಕೊಡಲಾದ ದೇವರ ಕೃಪೆಯ ಕಾರ್ಯಭಾರವನ್ನು ನೀವು ಕೇಳಿದ್ದೀರಿ, <verse eid="EPH 3:2"/><verse number="3" style="v" sid="EPH 3:3"/>ಅವರು ರಹಸ್ಯವನ್ನು ಪ್ರಕಟನೆಯಿಂದ ನನಗೆ ತಿಳಿಸಿದರೆಂದು ನಾನು ನಿಮಗೆ ಮೊದಲೇ ಸಂಕ್ಷೇಪವಾಗಿ ಬರೆದಿದ್ದೇನೆ. <verse eid="EPH 3:3"/><verse number="4" style="v" sid="EPH 3:4"/>ಅದನ್ನು ನೀವು ಓದಿದರೆ ಕ್ರಿಸ್ತನ ರಹಸ್ಯದ ಕುರಿತಾಗಿ ನನಗಿರುವ ಒಳನೋಟವನ್ನು ನೀವೇ ಅರ್ಥಮಾಡಿಕೊಳ್ಳುವಿರಿ. <verse eid="EPH 3:4"/><verse number="5" style="v" sid="EPH 3:5"/>ಈ ರಹಸ್ಯವು ದೇವರ ಪರಿಶುದ್ಧ ಅಪೊಸ್ತಲರಿಗೂ ಪ್ರವಾದಿಗಳಿಗೂ ದೇವರಾತ್ಮರ ಮೂಲಕ ಈಗ ಪ್ರಕಟಿಸಿದಂತೆ, ಬೇರೆ ತಲೆಮಾರುಗಳಲ್ಲಿದ್ದ ಜನರಿಗೆ ತಿಳಿಸಿರಲಿಲ್ಲ. <verse eid="EPH 3:5"/><verse number="6" style="v" sid="EPH 3:6"/>ಸುವಾರ್ತೆಯ ಮೂಲಕ ಯೆಹೂದ್ಯರಲ್ಲದವರೂ ಸಹ ಇಸ್ರಾಯೇಲರೊಂದಿಗೆ ವಾರಸುದಾರರೂ ಒಂದೇ ದೇಹದ ಅವಯವಗಳೂ ಕ್ರಿಸ್ತ ಯೇಸುವಿನಲ್ಲಿ ದೇವರ ವಾಗ್ದಾನದ ಸಹಪಾಲುಗಾರರೂ ಆಗಿರಬೇಕೆಂಬುದೇ ಈ ರಹಸ್ಯ.<verse eid="EPH 3:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="EPH 3:7"/>ದೇವರ ಶಕ್ತಿಯ ಕ್ರಿಯೆಯಿಂದ ನನಗೆ ಕೊಡಲಾದ ಅವರ ದೇವ ಕೃಪಾದಾನಕ್ಕೆ ಅನುಸಾರವಾಗಿ ನಾನು ಈ ಸುವಾರ್ತೆಗೆ ಸೇವಕನಾದೆನು. <verse eid="EPH 3:7"/><verse number="8" style="v" sid="EPH 3:8"/>ನಾನು ಕರ್ತನ ಜನರೆಲ್ಲರಲ್ಲಿಯೂ ಅತ್ಯಲ್ಪನಾಗಿದ್ದೇನೆ. ಹಾಗಿದ್ದರೂ, ನನಗೆ ಈ ಕೃಪೆ ಕೊಡಲಾಯಿತು: ಏಕೆಂದರೆ, ನಾನು ಕ್ರಿಸ್ತನ ಅಪರಿಮಿತವಾದ ಐಶ್ವರ್ಯವನ್ನು ಯೆಹೂದ್ಯರಲ್ಲದವರಿಗೆ ಸಾರುವಂತೆಯೂ <verse eid="EPH 3:8"/><verse number="9" style="v" sid="EPH 3:9"/>ಸಮಸ್ತವನ್ನೂ ಸೃಷ್ಟಿಸಿದ ದೇವರಲ್ಲಿ ಲೋಕಾದಿಯಿಂದ ಮರೆಯಾಗಿದ್ದ ಕಾರ್ಯಭಾರದ ರಹಸ್ಯವು ಏನೆಂಬುದನ್ನು ಎಲ್ಲರಿಗೂ ಸ್ಪಷ್ಟಪಡಿಸುವುದಕ್ಕಾಗಿಯೂ ಆಗಿರುತ್ತದೆ. <verse eid="EPH 3:9"/><verse number="10" style="v" sid="EPH 3:10"/>ಬಹು ಪ್ರಕಾರದ ದೇವರ ಜ್ಞಾನವು ಪರಲೋಕದಲ್ಲಿ ರಾಜತ್ವಗಳಿಗೂ ಅಧಿಕಾರಗಳಿಗೂ ಈಗ ಸಭೆಯ ಮೂಲಕ ಗೊತ್ತಾಗಬೇಕೆಂಬುದೇ ದೇವರ ಉದ್ದೇಶ. <verse eid="EPH 3:10"/><verse number="11" style="v" sid="EPH 3:11"/>ಹೀಗೆ ದೇವರು ತಮ್ಮ ನಿತ್ಯ ಉದ್ದೇಶದ ಪ್ರಕಾರ ಇದನ್ನು ನಮ್ಮ ಕರ್ತ ಆಗಿರುವ ಕ್ರಿಸ್ತ ಯೇಸುವಿನಲ್ಲಿ ನೆರವೇರಿಸಿದರು. <verse eid="EPH 3:11"/><verse number="12" style="v" sid="EPH 3:12"/>ಕ್ರಿಸ್ತನಲ್ಲಿಯೂ ಕ್ರಿಸ್ತನ ಮೇಲೆ ನಂಬಿಕೆಯನ್ನಿಡುವುದರ ಮೂಲಕವೂ ನಾವು ಸ್ವಾತಂತ್ರ್ಯದಿಂದಲೂ ಭರವಸೆಯಿಂದಲೂ ದೇವರನ್ನು ಸಮೀಪಿಸಲು ಈಗ ಸಾಧ್ಯ. <verse eid="EPH 3:12"/><verse number="13" style="v" sid="EPH 3:13"/>ಆದ್ದರಿಂದ, ನಿಮಗಾಗಿ ನನಗುಂಟಾದ ಸಂಕಟಗಳು ನಿಮಗೆ ಮಹಿಮೆಯಾಗಿರುವುದರಿಂದ, ನೀವು ಧೈರ್ಯಗೆಡಬಾರದೆಂದು ನಾನು ನಿಮ್ಮನ್ನು ಕೇಳಿಕೊಳ್ಳುತ್ತೇನೆ.<verse eid="EPH 3:13"/></para>
  <para style="s1">ಎಫೆಸದವರಿಗಾಗಿ ಪ್ರಾರ್ಥನೆ</para>
  <para style="p">
    <verse number="14-15" style="v" sid="EPH 3:14-15"/>ಈ ಕಾರಣದಿಂದ, ಪರಲೋಕ ಭೂಲೋಕದಲ್ಲಿರುವ ಪ್ರತಿ ಕುಟುಂಬವೂ ಹೆಸರು ಪಡೆದಿರಲು ಕಾರಣವಾಗಿರುವ ತಂದೆಯ ಮುಂದೆ ನಾನು ಮೊಣಕಾಲೂರುತ್ತೇನೆ: <verse eid="EPH 3:14-15"/><verse number="16" style="v" sid="EPH 3:16"/>ದೇವರು ತಮ್ಮ ಮಹಿಮೆಯ ಐಶ್ವರ್ಯಕ್ಕನುಸಾರವಾಗಿ ತಮ್ಮ ಆತ್ಮನ ಮೂಲಕ ನಿಮ್ಮನ್ನು ಆಂತರ್ಯದಲ್ಲಿ ಶಕ್ತಿಯಿಂದ ಬಲಪಡಿಸಲಿ ಎಂದು ಪ್ರಾರ್ಥಿಸುತ್ತೇನೆ. <verse eid="EPH 3:16"/><verse number="17" style="v" sid="EPH 3:17"/>ನಂಬಿಕೆಯ ಮೂಲಕ ಕ್ರಿಸ್ತನು ನಿಮ್ಮ ಹೃದಯಗಳಲ್ಲಿ ವಾಸಿಸಲಿ. ನೀವು ಪ್ರೀತಿಯಲ್ಲಿ ಬೇರೂರಿ ನೆಲೆಗೊಂಡು ನಿಂತು <verse eid="EPH 3:17"/><verse number="18" style="v" sid="EPH 3:18"/>ದೇವರ ಪರಿಶುದ್ಧರೆಲ್ಲರೊಂದಿಗೆ ಅದರ ಅಗಲ, ಉದ್ದ, ಆಳ ಮತ್ತು ಎತ್ತರವನ್ನು ಪೂರ್ಣವಾಗಿ ಕ್ರಿಸ್ತನ ಪ್ರೀತಿಯನ್ನು ಅರಿಯುವುದಕ್ಕೆ ಶಕ್ತರಾಗಲಿ. <verse eid="EPH 3:18"/><verse number="19" style="v" sid="EPH 3:19"/>ಮತ್ತು ತಿಳುವಳಿಕೆಗೆ ಅಪಾರವಾದ ಕ್ರಿಸ್ತನ ಪ್ರೀತಿಯನ್ನು ನೀವು ತಿಳಿದುಕೊಂಡು ದೇವರ ಸರ್ವಸಂಪೂರ್ಣತೆಯಿಂದ ತುಂಬಿದವರಾಗಲಿ ಎಂದು ಅವರನ್ನು ಬೇಡಿಕೊಳ್ಳುತ್ತೇನೆ.<verse eid="EPH 3:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="EPH 3:20"/>ನಮ್ಮಲ್ಲಿ ಕಾರ್ಯಸಾಧಿಸುವ ತಮ್ಮ ಶಕ್ತಿಯ ಪ್ರಕಾರ ನಾವು ಬೇಡುವುದಕ್ಕಿಂತಲೂ ಯೋಚಿಸುವುದಕ್ಕಿಂತಲೂ ಅತ್ಯಧಿಕವಾಗಿಯೇ ಎಲ್ಲವನ್ನೂ ಮಾಡಲು ಶಕ್ತರಾದ ದೇವರಿಗೆ <verse eid="EPH 3:20"/><verse number="21" style="v" sid="EPH 3:21"/>ಸಭೆಯಲ್ಲಿ ಕ್ರಿಸ್ತ ಯೇಸುವಿನ ಮೂಲಕ ತಲತಲಾಂತರಕ್ಕೂ ಯುಗಯುಗಾಂತರಕ್ಕೂ ಮಹಿಮೆ ಉಂಟಾಗಲಿ. ಆಮೆನ್.<verse eid="EPH 3:21"/></para>
  <chapter eid="EPH 3"/>
  <chapter number="4" style="c" sid="EPH 4"/>
  <para style="s1">ಕ್ರಿಸ್ತನ ದೇಹದಲ್ಲಿ ಐಕ್ಯತೆ</para>
  <para style="p">
    <verse number="1" style="v" sid="EPH 4:1"/>ಆದ್ದರಿಂದ ನೀವು ಸ್ವೀಕರಿಸಿದ ನಿಮ್ಮ ಕರೆಯುವಿಕೆಗೆ ಯೋಗ್ಯರಾಗಿ ಬಾಳಬೇಕೆಂದು ಕರ್ತನ ಸೆರೆಯಾಳಾದ ನಾನು ನಿಮ್ಮನ್ನು ಪ್ರಬೋಧಿಸುತ್ತೇನೆ. <verse eid="EPH 4:1"/><verse number="2" style="v" sid="EPH 4:2"/>ನೀವು ಸಂಪೂರ್ಣ ದೀನತ್ವದಿಂದಲೂ ಸಾತ್ವಿಕತ್ವಗಳಿಂದಲೂ ದೀರ್ಘಶಾಂತಿಯಿಂದಲೂ ಒಬ್ಬರನ್ನೊಬ್ಬರು ಪ್ರೀತಿಯಿಂದ ಸಹಿಸಿಕೊಳ್ಳಿರಿ. <verse eid="EPH 4:2"/><verse number="3" style="v" sid="EPH 4:3"/>ಸಮಾಧಾನದ ಬಂಧನದಲ್ಲಿದ್ದವರಾಗಿ, ಪವಿತ್ರಾತ್ಮ ದೇವರಿಂದ ಉಂಟಾಗುವ ಐಕ್ಯತೆಯನ್ನು ಕಾಪಾಡಿಕೊಳ್ಳಲು ಆಸಕ್ತರಾಗಿರಿ. <verse eid="EPH 4:3"/><verse number="4" style="v" sid="EPH 4:4"/>ಒಂದೇ ನಿರೀಕ್ಷೆಗೆ ನೀವು ಕರೆಹೊಂದಿದಂತೆಯೇ ದೇಹವು ಒಂದೇ, ಪವಿತ್ರಾತ್ಮರು ಒಬ್ಬರೇ, <verse eid="EPH 4:4"/><verse number="5" style="v" sid="EPH 4:5"/>ಕರ್ತ ಆಗಿರುವವರು ಒಬ್ಬರೇ, ಒಂದೇ ವಿಶ್ವಾಸ, ದೀಕ್ಷಾಸ್ನಾನವೂ ಒಂದೇ, <verse eid="EPH 4:5"/><verse number="6" style="v" sid="EPH 4:6"/>ಎಲ್ಲರಿಗೂ ತಂದೆಯಾಗಿರುವ ದೇವರು ಒಬ್ಬರೇ; ಅವರೇ ಎಲ್ಲರ ಮೇಲಿರುವರೂ ಎಲ್ಲರ ಮೂಲಕ ಕಾರ್ಯನಡಿಸುವವರೂ ಎಲ್ಲರಲ್ಲಿ ವಾಸಿಸುವವರೂ ಆಗಿದ್ದಾರೆ.<verse eid="EPH 4:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="EPH 4:7"/>ನಮ್ಮಲ್ಲಿ ಪ್ರತಿಯೊಬ್ಬನಿಗೂ ಕ್ರಿಸ್ತ ಯೇಸುವು ನೀಡಿದ ಅಳತೆಗೆ ಅನುಸಾರವಾಗಿ ವರವನ್ನು ಕೊಡಲಾಗಿದೆ. <verse eid="EPH 4:7"/><verse number="8" style="v" sid="EPH 4:8"/>ಆದ್ದರಿಂದ ಪವಿತ್ರ ವೇದದಲ್ಲಿ ಹೀಗೆ ಹೇಳಲಾಗಿದೆ:</para>
  <para style="q1" vid="EPH 4:8">“ಅವರು ಉನ್ನತಸ್ಥಾನಕ್ಕೆ ಏರಿಹೋದಾಗ,</para>
  <para style="q2" vid="EPH 4:8">ಸೆರೆಯಾಳಾಗಿದ್ದ ಅನೇಕರನ್ನು ಕೊಂಡೊಯ್ದು</para>
  <para style="q2" vid="EPH 4:8">ತಮ್ಮ ಜನರಿಗೆ ವರದಾನಗಳನ್ನು ಕೊಟ್ಟರು!”<note caller="+" style="f"><char style="fr" closed="false">4:8 </char><char style="ft" closed="false"><char style="xt"><ref loc="PSA 68:18">ಕೀರ್ತನೆ 68:18</ref></char></char></note><verse eid="EPH 4:8"/></para>
  <para style="m">
    <verse number="9" style="v" sid="EPH 4:9"/>“ಅವರು ಏರಿ ಹೋದರೆಂದು,” ಹೇಳಿದ್ದರ ಅರ್ಥವೇನು? ಭೂಮಿಯ ಭೂಗರ್ಭಕ್ಕೂ ಇಳಿದಿದ್ದರು ಎಂದೂ ಹೇಳಿದ ಹಾಗಾಯಿತಲ್ಲವೇ? <verse eid="EPH 4:9"/><verse number="10" style="v" sid="EPH 4:10"/>ಇಳಿದು ಬಂದ ಅವರೇ ಮೇಲಣ ಎಲ್ಲಾ ಆಕಾಶಗಳಿಗಿಂತ ಉನ್ನತವಾಗಿ ಏರಿಹೋಗಿ, ಇಡೀ ವಿಶ್ವವನ್ನೇ ತುಂಬಿಕೊಳ್ಳುವುದಕ್ಕಾಗಿ ಮೇಲೆ ಏರಿ ಹೋಗಿದ್ದಾರೆ. <verse eid="EPH 4:10"/><verse number="11" style="v" sid="EPH 4:11"/>ಕ್ರಿಸ್ತನು ಕೆಲವರನ್ನು ಅಪೊಸ್ತಲರನ್ನಾಗಿಯೂ ಕೆಲವರನ್ನು ಪ್ರವಾದಿಗಳನ್ನಾಗಿಯೂ ಕೆಲವರನ್ನು ಸುವಾರ್ತಿಕರನ್ನಾಗಿಯೂ ಕೆಲವರನ್ನು ಸಭಾಪಾಲಕರನ್ನಾಗಿಯೂ ಕೆಲವರನ್ನು ಉಪದೇಶಿಗಳನ್ನಾಗಿಯೂ ಸಭೆಗೆ ಕೊಟ್ಟರು. <verse eid="EPH 4:11"/><verse number="12" style="v" sid="EPH 4:12"/>ಕ್ರಿಸ್ತನ ದೇಹವನ್ನು ಕಟ್ಟುವುದಕ್ಕಾಗಿಯೂ ದೇವಜನರನ್ನು ಸೇವಾ ಕೆಲಸಕ್ಕಾಗಿ ಪರಿಣಿತರನ್ನಾಗಿ ಮಾಡುವುದಕ್ಕಾಗಿಯೂ ಕ್ರಿಸ್ತನು ಅವರನ್ನು ಕೊಟ್ಟ ಉದ್ದೇಶವಾಗಿತ್ತು. <verse eid="EPH 4:12"/><verse number="13" style="v" sid="EPH 4:13"/>ನಾವೆಲ್ಲರೂ ಕ್ರಿಸ್ತನ ಪರಿಪೂರ್ಣತೆಯ ಬೆಳವಣಿಗೆಯಲ್ಲಿ ವಿಶ್ವಾಸದಲ್ಲಿಯೂ ದೇವಪುತ್ರನ ತಿಳುವಳಿಕೆಯಲ್ಲಿ ಒಂದು ಮನಸ್ಸುಳ್ಳವರಾಗಿ ಪರಿಪಕ್ವತೆಯನ್ನು ಹೊಂದುವುದೇ ಆ ಉದ್ದೇಶವಾಗಿತ್ತು.<verse eid="EPH 4:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="EPH 4:14"/>ಆಗ, ನಾವು ಚಿಕ್ಕಮಕ್ಕಳಂತೆ ಇರುವುದಿಲ್ಲ: ಮನುಷ್ಯರ ವಿವಿಧ ಬೋಧನೆಗಳಿಂದ ಗಾಳಿಯಿಂದ ತೂರಾಡಿಕೊಳ್ಳುವಂತಾಗುವುದಿಲ್ಲ. ಮನುಷ್ಯರ ಕುಯುಕ್ತಿಗೆ, ತಂತ್ರಕ್ಕೆ, ಒಳಸಂಚಿಗೆ ಒಳಗಾಗುವುದಿಲ್ಲ. ಅವರ ಪ್ರತಿಯೊಂದು ಬೋಧನೆಯ ಗಾಳಿಯಿಂದಲೂ ತೂರಾಡಿಕೊಂಡು ಅತ್ತಿತ್ತ ಅಲೆದಾಡುವ ಚಿಕ್ಕಮಕ್ಕಳಂತೆ ಇರಬಾರದು. <verse eid="EPH 4:14"/><verse number="15" style="v" sid="EPH 4:15"/>ಆದರೆ ಪ್ರೀತಿಯಲ್ಲಿ ಸತ್ಯವನ್ನು ಮಾತನಾಡುತ್ತಾ, ನಾವು ಎಲ್ಲಾ ವಿಷಯಗಳಲ್ಲಿಯೂ ಕ್ರಿಸ್ತನ ದೇಹದ ಪರಿಪಕ್ವತೆಯೆಡೆಗೆ ಅವರ ಶಿರಸತ್ವದಲ್ಲಿ ಬೆಳೆಯೋಣ. <verse eid="EPH 4:15"/><verse number="16" style="v" sid="EPH 4:16"/>ಹೀಗೆ ದೇಹವೆಲ್ಲಾ ಕ್ರಿಸ್ತನ ಮುಖಾಂತರ ಪ್ರತಿ ಕೀಲಿನಿಂದ ಬಿಗಿಯಾಗಿ ಜೋಡಣೆಹೊಂದಿ, ಪ್ರತಿ ಅಂಗವೂ ತನ್ನ ಕೆಲಸವನ್ನು ಸೂಕ್ತವಾಗಿ ಮಾಡುವಂತೆ ಪ್ರೀತಿಯಲ್ಲಿ ಬೆಳೆದು ಕ್ಷೇಮಾಭಿವೃದ್ಧಿ ಹೊಂದುತ್ತದೆ.<verse eid="EPH 4:16"/></para>
  <para style="s1">ಬೆಳಕಿನ ಮಕ್ಕಳಾಗಿ ಜೀವಿಸುವುದು</para>
  <para style="p">
    <verse number="17" style="v" sid="EPH 4:17"/>ಆದ್ದರಿಂದ, ಯೆಹೂದ್ಯರಲ್ಲದವರು ವ್ಯರ್ಥ ಆಲೋಚನೆಯುಳ್ಳವರಾಗಿ ಬಾಳುವ ರೀತಿಯಲ್ಲಿ ನೀವು ಇನ್ನು ಮೇಲೆ ಬಾಳದಂತೆ, ಕರ್ತನಲ್ಲಿ ನಾನು ನಿಮಗೆ ಸಾಕ್ಷಿಕೊಟ್ಟು ಹೇಳುತ್ತೇನೆ. <verse eid="EPH 4:17"/><verse number="18" style="v" sid="EPH 4:18"/>ಅವರು ತಮ್ಮ ಹೃದಯ ಕಠಿಣತ್ವದ ಅಜ್ಞಾನದಿಂದ ತಮ್ಮ ಕತ್ತಲು ಕವಿದ ತಿಳುವಳಿಕೆಯಲ್ಲಿ, ದೇವರ ಜೀವದಿಂದ ತಮ್ಮನ್ನು ಪ್ರತ್ಯೇಕಿಸಿಕೊಂಡವರಾಗಿದ್ದಾರೆ. <verse eid="EPH 4:18"/><verse number="19" style="v" sid="EPH 4:19"/>ಅವರು ಸರ್ವ ಸೂಕ್ಷ್ಮತೆಯನ್ನು ಕಳೆದುಕೊಂಡು, ತಮ್ಮನ್ನು ಕಾಮುಕತನಕ್ಕೆ ಒಪ್ಪಿಸಿಕೊಟ್ಟು, ಎಲ್ಲಾ ಅಶುದ್ಧತ್ವವನ್ನು ಅತ್ಯಾಶೆಯಿಂದ ನಡೆಸುವವರಾಗಿದ್ದಾರೆ.<verse eid="EPH 4:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="EPH 4:20"/>ನೀವಾದರೋ ಕ್ರಿಸ್ತನನ್ನು ಆ ರೀತಿಯಾಗಿ ಅರಿತುಕೊಳ್ಳಲಿಲ್ಲ. <verse eid="EPH 4:20"/><verse number="21" style="v" sid="EPH 4:21"/>ನೀವು ಕ್ರಿಸ್ತನ ಬಗ್ಗೆ ಕೇಳಿ ಬೋಧನೆಯನ್ನು ಪಡೆದಾಗ, ಅದು ಯೇಸುವಿನಲ್ಲಿರುವ ಸತ್ಯಕ್ಕೆ ಅನುಸಾರವಾಗಿತ್ತು. <verse eid="EPH 4:21"/><verse number="22" style="v" sid="EPH 4:22"/>ನಿಮಗೆ ಉಪದೇಶಿಸಿದಂತೆ, ನೀವು ನಿಮ್ಮ ಹಿಂದಿನ ನಡತೆಯ ಪ್ರಕಾರ ಮೋಸಕರವಾದ ಆಶೆಗಳ ಅನುಸಾರವಾಗಿರುವ ಹಳೆಯ ಸ್ವಭಾವವನ್ನು ತೆಗೆದುಹಾಕಬೇಕು. <verse eid="EPH 4:22"/><verse number="23" style="v" sid="EPH 4:23"/>ಹೀಗೆ ನೀವು ನಿಮ್ಮ ಮನೋಭಾವನೆಯನ್ನು ನವೀಕರಿಸಿಕೊಂಡು; <verse eid="EPH 4:23"/><verse number="24" style="v" sid="EPH 4:24"/>ಸತ್ಯವಾದ ನೀತಿಯಲ್ಲಿಯೂ ಪರಿಶುದ್ಧತೆಯಲ್ಲಿಯೂ ದೇವರ ಹೋಲಿಕೆಯ ಪ್ರಕಾರವಾಗಿರಲು ಸೃಷ್ಟಿಸಲಾದ ಹೊಸ ಸ್ವಭಾವವನ್ನು ಧರಿಸಿಕೊಳ್ಳಿರಿ.<verse eid="EPH 4:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="EPH 4:25"/>ಆದಕಾರಣ ಸುಳ್ಳಾಡುವುದನ್ನು ಬಿಟ್ಟುಬಿಟ್ಟು ಪ್ರತಿಯೊಬ್ಬನು ತನ್ನ ನೆರೆಯವನ ಸಂಗಡ ಸತ್ಯವನ್ನೇ ಆಡಲಿ. ಏಕೆಂದರೆ ನಾವೆಲ್ಲರೂ ಒಂದೇ ದೇಹದ ಅಂಗಗಳು. <verse eid="EPH 4:25"/><verse number="26" style="v" sid="EPH 4:26"/>“ಕೋಪ ಮಾಡಬೇಕಾಗಿ ಬಂದರೂ ಪಾಪಮಾಡಬೇಡಿರಿ,”<note caller="+" style="f"><char style="fr" closed="false">4:26 </char><char style="ft" closed="false"><char style="xt"><ref loc="PSA 4:4">ಕೀರ್ತನೆ 4:4</ref></char></char></note> ಸೂರ್ಯನು ಮುಳುಗುವುದಕ್ಕಿಂತ ಮುಂಚೆ ನಿಮ್ಮ ಕೋಪವು ಇಳಿಯಲಿ. <verse eid="EPH 4:26"/><verse number="27" style="v" sid="EPH 4:27"/>ಹೀಗೆ ನೀವು ಸೈತಾನನಿಗೆ ಅವಕಾಶಕೊಡಬೇಡಿರಿ. <verse eid="EPH 4:27"/><verse number="28" style="v" sid="EPH 4:28"/>ಕಳ್ಳತನ ಮಾಡುವವನು ಇನ್ನು ಮೇಲೆ ಕಳ್ಳತನ ಮಾಡದೆ, ಕೈಯಿಂದ ಯಾವುದಾದರೊಂದು ಒಳ್ಳೆಯ ಉದ್ಯೋಗವನ್ನು ಮಾಡಿ ದುಡಿಯಲಿ. ಆಗ ಕೊರತೆಯಲ್ಲಿರುವವನಿಗೆ ಕೊಡುವುದಕ್ಕೆ ಅವನಿಂದಾಗುವುದು.<verse eid="EPH 4:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="EPH 4:29"/>ನಿಮ್ಮ ಬಾಯೊಳಗಿಂದ ಯಾವ ಕೆಟ್ಟಮಾತೂ ಹೊರಡದಿರಲಿ. ಕೇಳುವವರಿಗೆ ಆತ್ಮಿಕ ಹಿತವನ್ನುಂಟು ಮಾಡಿ, ಇತರರಿಗೆ ಅವಶ್ಯವಿರುವ ಮಾತುಗಳನ್ನು ಮಾತ್ರ ಆಡಿರಿ. <verse eid="EPH 4:29"/><verse number="30" style="v" sid="EPH 4:30"/>ದೇವರ ಪವಿತ್ರಾತ್ಮರನ್ನು ದುಃಖ ಪಡಿಸಬೇಡಿರಿ. ಆ ಆತ್ಮನಲ್ಲಿಯೇ ವಿಮೋಚನೆಯ ದಿನಕ್ಕಾಗಿ ಮುದ್ರೆ ಹೊಂದಿದ್ದೀರಲ್ಲಾ. <verse eid="EPH 4:30"/><verse number="31" style="v" sid="EPH 4:31"/>ಎಲ್ಲಾ ಕಹಿತನ, ಕೋಪ, ಕ್ರೋಧ, ಕಲಹ, ದೂಷಣೆ ಇವುಗಳನ್ನೂ ಎಲ್ಲಾ ದುಷ್ಟತನವನ್ನೂ ನಿಮ್ಮಿಂದ ದೂರಮಾಡಿರಿ. <verse eid="EPH 4:31"/><verse number="32" style="v" sid="EPH 4:32"/>ನೀವು ದಯೆಯುಳ್ಳವರೂ ಮೃದು ಹೃದಯುಳ್ಳವರೂ ಆಗಿದ್ದು, ದೇವರು ಕ್ರಿಸ್ತನಲ್ಲಿ ನಿಮ್ಮನ್ನು ಕ್ಷಮಿಸಿದಂತೆಯೇ ನೀವು ಸಹ ಒಬ್ಬರೊನ್ನಬ್ಬರನ್ನು ಕ್ಷಮಿಸಿರಿ.<verse eid="EPH 4:32"/></para>
  <chapter eid="EPH 4"/>
  <chapter number="5" style="c" sid="EPH 5"/>
  <para style="nb">
    <verse number="1" style="v" sid="EPH 5:1"/>ಆದ್ದರಿಂದ ನೀವು ದೇವರ ಪ್ರಿಯರಾದ ಮಕ್ಕಳಂತೆ ದೇವರ ಮಾದರಿಯನ್ನು ಅನುಸರಿಸಿ ಬಾಳಿರಿ. <verse eid="EPH 5:1"/><verse number="2" style="v" sid="EPH 5:2"/>ಕ್ರಿಸ್ತ ಯೇಸು ನಮ್ಮನ್ನು ಪ್ರೀತಿಸಿ ನಮಗೋಸ್ಕರ ತಮ್ಮನ್ನೇ ದೇವರಿಗೆ ಸುಗಂಧ ಕಾಣಿಕೆಯಾಗಿಯೂ ಯಜ್ಞವಾಗಿಯೂ ಸಮರ್ಪಿಸಿಕೊಂಡ ಪ್ರಕಾರ ನೀವೂ ಸಹ ಪ್ರೀತಿಯಿಂದ ಬಾಳಿರಿ.<verse eid="EPH 5:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="EPH 5:3"/>ಆದರೆ ನಿಮ್ಮೊಳಗೆ ಅನೈತಿಕತೆಯಾಗಲಿ, ಯಾವ ಅಶುದ್ಧತ್ವವಾಗಲಿ, ಇಲ್ಲವೆ ಲೋಭವಾಗಲಿ ಇರಲೇಬಾರದು. ಇವು ದೇವರ ಪರಿಶುದ್ಧರಿಗೆ ಯೋಗ್ಯವಲ್ಲ. <verse eid="EPH 5:3"/><verse number="4" style="v" sid="EPH 5:4"/>ಅಶ್ಲೀಲತೆ, ಬುದ್ಧಿಹೀನ ಮಾತು, ಅಸಭ್ಯ ಹರಟೆ ಇವು ಬೇಡ, ಇವು ಅಯುಕ್ತವಾಗಿವೆ, ಪ್ರತಿಯಾಗಿ ದೇವರಿಗೆ ಕೃತಜ್ಞತಾ ಸ್ತುತಿಮಾಡಿರಿ. <verse eid="EPH 5:4"/><verse number="5" style="v" sid="EPH 5:5"/>ಏಕೆಂದರೆ ಯಾವ ಜಾರನಾಗಲಿ, ಅಶುದ್ಧನಾಗಲಿ, ದೇವರಲ್ಲದವುಗಳನ್ನು ಪೂಜಿಸುವ ಲೋಭಿಯಾಗಲಿ ಕ್ರಿಸ್ತನ ಮತ್ತು ದೇವರ ರಾಜ್ಯದಲ್ಲಿ ಹಕ್ಕುಬಾಧ್ಯತೆಯನ್ನು ಹೊಂದುವುದಿಲ್ಲವೆಂಬುದು ನಿಮಗೆ ಮನದಟ್ಟಾಗಿರಲಿ. <verse eid="EPH 5:5"/><verse number="6" style="v" sid="EPH 5:6"/>ಪ್ರಯೋಜನವಿಲ್ಲದ ಮಾತುಗಳಿಂದ ಯಾರೂ ನಿಮ್ಮನ್ನು ವಂಚಿಸದಿರಲಿ. ಏಕೆಂದರೆ ಇಂಥವುಗಳ ದೆಸೆಯಿಂದ ದೇವರ ಕೋಪಾಗ್ನಿಯು ಅವರಿಗೆ ಅವಿಧೇಯರಾದ ಮಕ್ಕಳ ಮೇಲೆ ಬರುತ್ತದೆ. <verse eid="EPH 5:6"/><verse number="7" style="v" sid="EPH 5:7"/>ಆದ್ದರಿಂದ ನೀವು ಅವರೊಂದಿಗೆ ಪಾಲುಗಾರರಾಗಿರಬೇಡಿರಿ.<verse eid="EPH 5:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="EPH 5:8"/>ನೀವು ಹಿಂದೊಮ್ಮೆ ಕತ್ತಲೆಯಾಗಿದ್ದಿರಿ. ಆದರೆ ಈಗ ನೀವು ಕರ್ತನಲ್ಲಿ ಬೆಳಕಾಗಿದ್ದೀರಿ. ಬೆಳಕಿನ ಮಕ್ಕಳಾಗಿ ಬಾಳಿರಿ. <verse eid="EPH 5:8"/><verse number="9" style="v" sid="EPH 5:9"/>ಬೆಳಕಿನ ಫಲವು ಎಲ್ಲಾ ಒಳ್ಳೆಯತನದಲ್ಲಿಯೂ ನೀತಿಯಲ್ಲಿಯೂ ಸತ್ಯದಲ್ಲಿಯೂ ಇರುತ್ತದೆ. <verse eid="EPH 5:9"/><verse number="10" style="v" sid="EPH 5:10"/>ಕರ್ತನಿಗೆ ಮೆಚ್ಚಿಗೆಯಾದದ್ದು ಏನೆಂಬುದನ್ನು ಪರಿಶೋಧಿಸಿರಿ. <verse eid="EPH 5:10"/><verse number="11" style="v" sid="EPH 5:11"/>ನಿಷ್ಪ್ರಯೋಜಕವಾದ ಕತ್ತಲೆಯ ಕಾರ್ಯಗಳೊಂದಿಗೆ ಪಾಲುಗಾರರಾಗಿರದೆ ಅವುಗಳನ್ನು ಬೆಳಕಿಗೆ ತನ್ನಿರಿ. <verse eid="EPH 5:11"/><verse number="12" style="v" sid="EPH 5:12"/>ಆ ಅವಿಧೇಯರು ಗುಟ್ಟಾಗಿ ಮಾಡುವ ಕೃತ್ಯಗಳನ್ನು ಹೇಳುವುದಕ್ಕೂ ಅವಮಾನಕರವಾಗಿವೆ. <verse eid="EPH 5:12"/><verse number="13" style="v" sid="EPH 5:13"/>ಆದರೆ, ಬಹಿರಂಗವಾದವುಗಳೆಲ್ಲವೂ ಬೆಳಕಿನಿಂದ ಪ್ರಕಟವಾಗುತ್ತವೆ. ಎಲ್ಲವನ್ನೂ ಪ್ರಕಾಶಪಡಿಸುವಂಥದ್ದು ಬೆಳಕೇ. <verse eid="EPH 5:13"/><verse number="14" style="v" sid="EPH 5:14"/>ಆದ್ದರಿಂದ ಹೀಗೆ ಹೇಳಲಾಗಿದೆ:</para>
  <para style="q1" vid="EPH 5:14">“ನಿದ್ರೆ ಮಾಡುವವನೇ,</para>
  <para style="q2" vid="EPH 5:14">ಎಚ್ಚರವಾಗು, ಸತ್ತವರಿಂದ ಎದ್ದೇಳು,</para>
  <para style="q2" vid="EPH 5:14">ಕ್ರಿಸ್ತನು ನಿನ್ನ ಮೇಲೆ ಪ್ರಕಾಶಿಸುವನು.”<verse eid="EPH 5:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="EPH 5:15"/>ಆದಕಾರಣ ನೀವು ಹೇಗೆ ಜೀವಿಸಬೇಕೆಂದು ಜಾಗರೂಕರಾಗಿರಿ. ಅಜ್ಞಾನಿಗಳಂತಿರದೆ, ಜಾಣರಾಗಿ ಜೀವಿಸಿರಿ. <verse eid="EPH 5:15"/><verse number="16" style="v" sid="EPH 5:16"/>ಈ ದಿನಗಳು ಕೆಟ್ಟವುಗಳಾಗಿರುವುದರಿಂದ, ಸರ್ವ ಸದಾವಕಾಶಗಳನ್ನೂ ಸದ್ವಿನಿಯೋಗಿಸಿಕೊಳ್ಳಿರಿ. <verse eid="EPH 5:16"/><verse number="17" style="v" sid="EPH 5:17"/>ಆದಕಾರಣ ಬುದ್ಧಿಹೀನರಾಗಿರದೆ ಕರ್ತನ ಚಿತ್ತವೇನೆಂಬುದನ್ನು ತಿಳಿದವರಾಗಿರಿ. <verse eid="EPH 5:17"/><verse number="18" style="v" sid="EPH 5:18"/>ಮದ್ಯಪಾನ ಮಾಡಿ ಮತ್ತರಾಗಬೇಡಿರಿ. ಅದು ದುಷ್ಟತನಕ್ಕೆ ಎಡೆಮಾಡುತ್ತದೆ. ಆದರೆ ಪವಿತ್ರಾತ್ಮರಿಂದ ತುಂಬಿದವರಾಗಿದ್ದು,<note caller="+" style="f"><char style="fr" closed="false">5:18 </char><char style="ft" closed="false">ಅಥವಾ </char><char style="fqa" closed="false">ನಿಯಂತ್ರಣಕ್ಕೆ ಒಳಗಾಗಿರಿ</char></note> <verse eid="EPH 5:18"/><verse number="19" style="v" sid="EPH 5:19"/>ಕೀರ್ತನೆಗಳಿಂದಲೂ ಸಂಗೀತಗಳಿಂದಲೂ ಆತ್ಮನಿಂದಾದ ಹಾಡುಗಳಿಂದಲೂ ಪರಸ್ಪರ ಮಾತನಾಡಿಕೊಳ್ಳುತ್ತಾ ನಿಮ್ಮ ಹೃದಯಾಂತರಾಳದಿಂದ ಕರ್ತನಿಗೆ ಹಾಡಿ ಹರಸಿರಿ. <verse eid="EPH 5:19"/><verse number="20" style="v" sid="EPH 5:20"/>ನಮ್ಮ ಕರ್ತ ಆಗಿರುವ ಯೇಸುಕ್ರಿಸ್ತರ ಹೆಸರಿನಲ್ಲಿ ತಂದೆಯಾದ ದೇವರಿಗೆ, ಯಾವಾಗಲೂ ಎಲ್ಲಾ ಕಾರ್ಯಗಳಿಗೋಸ್ಕರ ಕೃತಜ್ಞತೆಯನ್ನು ಸಲ್ಲಿಸಿರಿ.<verse eid="EPH 5:20"/></para>
  <para style="s1">ವಿಶ್ವಾಸಿಗಳ ಕುಟುಂಬಕ್ಕೆ ಬುದ್ಧಿವಾದಗಳು</para>
  <para style="p">
    <verse number="21" style="v" sid="EPH 5:21"/>ಇದಲ್ಲದೆ ಕ್ರಿಸ್ತನ ಭಯಭಕ್ತಿಯಲ್ಲಿ ಒಬ್ಬರಿಗೊಬ್ಬರು ಅಧೀನರಾಗಿ ನಡೆದುಕೊಳ್ಳಿರಿ.<verse eid="EPH 5:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="EPH 5:22"/>ಹೆಂಡತಿಯರೇ, ನೀವು ಕರ್ತನಿಗೆ ಹೇಗೋ ಹಾಗೆಯೇ ನಿಮ್ಮ ನಿಮ್ಮ ಗಂಡಂದಿರಿಗೆ ಅಧೀನರಾಗಿರಿ. <verse eid="EPH 5:22"/><verse number="23" style="v" sid="EPH 5:23"/>ಏಕೆಂದರೆ, ಕ್ರಿಸ್ತ ಯೇಸು ಸಭೆಗೆ ಶಿರಸ್ಸಾಗಿರುವ ಪ್ರಕಾರ ಗಂಡನು ಹೆಂಡತಿಗೆ ಶಿರಸ್ಸಾಗಿದ್ದಾನೆ. ಕ್ರಿಸ್ತ ಯೇಸು ತಮ್ಮ ಸಭೆ ಎಂಬ ದೇಹಕ್ಕೆ ರಕ್ಷಕರಾಗಿದ್ದಾರೆ. <verse eid="EPH 5:23"/><verse number="24" style="v" sid="EPH 5:24"/>ಸಭೆಯು ಕ್ರಿಸ್ತನಿಗೆ ಹೇಗೆ ಅಧೀನವಾಗಿದೆಯೋ ಹಾಗೆಯೇ ಸ್ತ್ರೀಯರು ತಮ್ಮ ತಮ್ಮ ಗಂಡಂದಿರಿಗೆ ಎಲ್ಲಾ ವಿಷಯಗಳಲ್ಲಿ ಅಧೀನರಾಗಿರಬೇಕು.<verse eid="EPH 5:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="EPH 5:25"/>ಗಂಡಂದಿರೇ, ಕ್ರಿಸ್ತ ಯೇಸು ಸಭೆಯನ್ನು ಪ್ರೀತಿಸಿ, ಅದಕ್ಕಾಗಿ ತಮ್ಮನ್ನು ತಾವೇ ಒಪ್ಪಿಸಿಕೊಟ್ಟಂತೆಯೇ ನೀವು ನಿಮ್ಮ ನಿಮ್ಮ ಹೆಂಡತಿಯರನ್ನು ಪ್ರೀತಿಸಿರಿ. <verse eid="EPH 5:25"/><verse number="26" style="v" sid="EPH 5:26"/>ಕ್ರಿಸ್ತ ಯೇಸು ತಮ್ಮ ಸಭೆಯನ್ನು ವಾಕ್ಯದ ನೀರಿನ ಸ್ನಾನದಿಂದ ಪವಿತ್ರಗೊಳಿಸಿ, ಶುದ್ಧಮಾಡಿ, <verse eid="EPH 5:26"/><verse number="27" style="v" sid="EPH 5:27"/>ಅದನ್ನು ಕಳಂಕ, ಸುಕ್ಕು ಇಂಥದ್ದು ಯಾವುದೂ ಇಲ್ಲದೆ ಪರಿಶುದ್ಧವೂ ದೋಷವಿಲ್ಲದ್ದೂ ಆಗಿರುವ ಮಹಿಮೆಯುಳ್ಳ ಸಭೆಯನ್ನಾಗಿ ತಮ್ಮ ಮುಂದೆ ನಿಲ್ಲಿಸಿಕೊಳ್ಳಬೇಕೆಂದು ತಮ್ಮನ್ನೇ ಒಪ್ಪಿಸಿಕೊಟ್ಟರು. <verse eid="EPH 5:27"/><verse number="28" style="v" sid="EPH 5:28"/>ಗಂಡಂದಿರು ಸಹ ಸ್ವಂತ ಶರೀರವನ್ನು ಪ್ರೀತಿಸಿಕೊಳ್ಳುವಂತೆಯೇ ತಮ್ಮ ಹೆಂಡತಿಯರನ್ನು ಪ್ರೀತಿಸಬೇಕು. ತನ್ನ ಹೆಂಡತಿಯನ್ನು ಪ್ರೀತಿಸುವವನು ತನ್ನನ್ನೇ ಪ್ರೀತಿಸುತ್ತಾನೆ. <verse eid="EPH 5:28"/><verse number="29" style="v" sid="EPH 5:29"/>ಏಕೆಂದರೆ, ಯಾರೂ ಸ್ವಂತ ಶರೀರವನ್ನು ಎಂದೂ ದ್ವೇಷಿಸುವುದಿಲ್ಲ, ಬದಲಿಗೆ ತಮ್ಮ ಶರೀರವನ್ನು ಪೋಷಿಸಿ ಸಂರಕ್ಷಿಸುತ್ತಾರೆ. ಅದೇ ಪ್ರಕಾರ ಕರ್ತ ಯೇಸು ಸಭೆಯನ್ನು ಪೋಷಿಸಿ, ಸಂರಕ್ಷಿಸುವವರಾಗಿದ್ದಾರೆ. <verse eid="EPH 5:29"/><verse number="30" style="v" sid="EPH 5:30"/>ನಾವು ಕ್ರಿಸ್ತ ಯೇಸುವಿನ ದೇಹದ ಅಂಗಗಳಾಗಿದ್ದೇವೆ. <verse eid="EPH 5:30"/><verse number="31" style="v" sid="EPH 5:31"/>“ಇದರ ನಿಮಿತ್ತದಿಂದ ಪುರುಷನು ತಂದೆತಾಯಿಗಳನ್ನು ಬಿಟ್ಟು ತನ್ನ ಹೆಂಡತಿಯನ್ನು ಸೇರಿಕೊಳ್ಳುವನು, ಅವರಿಬ್ಬರೂ ಒಂದೇ ಶರೀರವಾಗಿರುವರು.”<note caller="+" style="f"><char style="fr" closed="false">5:31 </char><char style="ft" closed="false"><char style="xt"><ref loc="GEN 2:24">ಆದಿ 2:24</ref></char></char></note> <verse eid="EPH 5:31"/><verse number="32" style="v" sid="EPH 5:32"/>ಈ ರಹಸ್ಯವು ಮಹತ್ತಾದದ್ದು. ಆದರೆ ನಾನು ಕ್ರಿಸ್ತನ ಹಾಗೂ ಸಭೆಯ ವಿಷಯವಾಗಿ ಮಾತನಾಡುತ್ತಿದ್ದೇನೆ. <verse eid="EPH 5:32"/><verse number="33" style="v" sid="EPH 5:33"/>ಆದರೂ ನಿಮ್ಮಲ್ಲಿ ಪ್ರತಿಯೊಬ್ಬನೂ ತನ್ನನ್ನು ಪ್ರೀತಿಸುವಂತೆಯೇ ತನ್ನ ಹೆಂಡತಿಯನ್ನೂ ಪ್ರೀತಿಸಬೇಕು. ಹೆಂಡತಿಯು ತನ್ನ ಗಂಡನನ್ನು ಗೌರವಿಸುವವಳಾಗಿರಬೇಕು.<verse eid="EPH 5:33"/></para>
  <chapter eid="EPH 5"/>
  <chapter number="6" style="c" sid="EPH 6"/>
  <para style="p">
    <verse number="1" style="v" sid="EPH 6:1"/>ಮಕ್ಕಳೇ, ನೀವು ಕರ್ತನಲ್ಲಿ ನಿಮ್ಮ ತಂದೆತಾಯಿಗಳಿಗೆ ವಿಧೇಯರಾಗಿರಿ, ಇದು ಸೂಕ್ತವಾದದ್ದು. <verse eid="EPH 6:1"/><verse number="2" style="v" sid="EPH 6:2"/>“ನಿನ್ನ ತಂದೆತಾಯಿಗಳನ್ನು ಸನ್ಮಾನಿಸಬೇಕು,” ಎಂಬುದು ವಾಗ್ದಾನ ಸಹಿತವಾದ ಮೊದಲನೆಯ ಆಜ್ಞೆಯಾಗಿದೆ. <verse eid="EPH 6:2"/><verse number="3" style="v" sid="EPH 6:3"/>“ಸನ್ಮಾನಿಸಿದರೆ ನಿನಗೆ ಶುಭವಾಗುವುದು. ನೀನು ಭೂಮಿಯ ಮೇಲೆ ಬಹುಕಾಲ ಬದುಕುವೆ.”<note caller="+" style="f"><char style="fr" closed="false">6:3 </char><char style="ft" closed="false"><char style="xt"><ref loc="DEU 5:16">ಧರ್ಮೋ 5:16</ref></char></char></note><verse eid="EPH 6:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="EPH 6:4"/>ತಂದೆಗಳೇ, ನಿಮ್ಮ ಮಕ್ಕಳನ್ನು ಸಿಟ್ಟಿಗೆಬ್ಬಿಸಬೇಡಿರಿ; ಕರ್ತನ ಶಿಸ್ತಿನಲ್ಲಿಯೂ ಉಪದೇಶದಲ್ಲಿಯೂ ಮಕ್ಕಳನ್ನು ಬೆಳೆಸಿರಿ.<verse eid="EPH 6:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="EPH 6:5"/>ಸೇವಕರೇ, ಭಯಭಕ್ತಿಯಿಂದಲೂ ಸರಳ ಹೃದಯದಿಂದ ಕ್ರಿಸ್ತನಿಗೆ ವಿಧೇಯರಾಗುವ ಪ್ರಕಾರ ಲೌಕಿಕವಾಗಿ ನಿಮ್ಮ ಯಜಮಾನನಾಗಿರುವವರಿಗೆ ವಿಧೇಯರಾಗಿರಿ. <verse eid="EPH 6:5"/><verse number="6" style="v" sid="EPH 6:6"/>ಯಜಮಾನರನ್ನು ಮೆಚ್ಚಿಸುವವರಂತೆ ಕಣ್ಣಿಗೆ ಕಾಣುವಾಗ ಮಾತ್ರ ಅವರಿಗೆ ಸೇವೆಮಾಡದೆ, ಕ್ರಿಸ್ತನ ದಾಸರಿಗೆ ತಕ್ಕಂತೆ ಮನಃಪೂರ್ವಕವಾಗಿ ದೇವರ ಚಿತ್ತವನ್ನು ನೆರವೇರಿಸಿರಿ. <verse eid="EPH 6:6"/><verse number="7" style="v" sid="EPH 6:7"/>ನೀವು ಮನುಷ್ಯರಿಗೋಸ್ಕರವಲ್ಲ, ಕರ್ತನಿಗೋಸ್ಕರವೇ ಸೇವೆ ಮಾಡುವಂತೆ, ಪೂರ್ಣಮನಸ್ಸಿನಿಂದ ಸೇವೆಮಾಡಿರಿ. <verse eid="EPH 6:7"/><verse number="8" style="v" sid="EPH 6:8"/>ದಾಸನಾಗಲಿ, ಸ್ವತಂತ್ರನಾಗಲಿ ತಾನು ಯಾವ ಸತ್ಕಾರ್ಯವನ್ನು ಮಾಡುತ್ತಾನೋ ಅದರ ಪ್ರತಿಫಲವನ್ನು ಕರ್ತ ಯೇಸುವಿನಿಂದ ಹೊಂದುವನೆಂದು ನೀವು ತಿಳಿದಿದ್ದೀರಿ.<verse eid="EPH 6:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="EPH 6:9"/>ಯಜಮಾನರೇ, ನೀವು ಸಹ ನಿಮ್ಮ ಸೇವಕರೊಡನೆ ಅದೇ ರೀತಿಯಾಗಿ ನಡೆದುಕೊಳ್ಳಿರಿ. ಪರಲೋಕದಲ್ಲಿ ನಿಮಗೆ ಯಜಮಾನನಿದ್ದಾನೆಂತಲೂ ಆತನಲ್ಲಿ ಪಕ್ಷಪಾತವಿಲ್ಲವೆಂತಲೂ ತಿಳಿದು ಅವರನ್ನು ಬೆದರಿಸುವುದನ್ನು ಬಿಟ್ಟುಬಿಡಿರಿ.<verse eid="EPH 6:9"/></para>
  <para style="s1">ದೇವರು ಕೊಡುವ ಸರ್ವಾಯುಧಗಳು</para>
  <para style="p">
    <verse number="10" style="v" sid="EPH 6:10"/>ಕೊನೆಯದಾಗಿ, ಕರ್ತನಲ್ಲಿಯೂ ಅವರ ಪರಾಕ್ರಮ ಶಕ್ತಿಯಲ್ಲಿಯೂ ಬಲಗೊಳ್ಳಿರಿ. <verse eid="EPH 6:10"/><verse number="11" style="v" sid="EPH 6:11"/>ನೀವು ಪಿಶಾಚನ ತಂತ್ರಗಳನ್ನು ಎದುರಿಸಿ ನಿಲ್ಲುವುದಕ್ಕೆ ಶಕ್ತರಾಗುವಂತೆ ದೇವರ ಸರ್ವಾಯುಧಗಳನ್ನು ಧರಿಸಿಕೊಳ್ಳಿರಿ. <verse eid="EPH 6:11"/><verse number="12" style="v" sid="EPH 6:12"/>ಏಕೆಂದರೆ, ನಾವು ಹೋರಾಡುವುದು ನರಮಾನವರೊಂದಿಗಲ್ಲ, ರಾಜತ್ವಗಳ ಮೇಲೆಯೂ ಅಧಿಕಾರಿಗಳ ಮೇಲೆಯೂ ಈ ಲೋಕದ ಅಂಧಕಾರದ ಅಧಿಪತಿಗಳ ಮೇಲೆಯೂ ಆಕಾಶಮಂಡಲದಲ್ಲಿರುವ ದುರಾತ್ಮಗಳ ಸೇನೆಗಳ ಮೇಲೆಯೂ ಆಗಿದೆ. <verse eid="EPH 6:12"/><verse number="13" style="v" sid="EPH 6:13"/>ಆದುದರಿಂದ ವೈರಿಯು ದಾಳಿಮಾಡುವ ದಿನವು ಬರುವಾಗ ನೀವು ಅವನನ್ನು ಎದುರಿಸಿ ನಿಲ್ಲುವಂತೆಯು, ಎಲ್ಲವನ್ನು ಜಯಿಸಿ ಮುಗಿಸಿದ ಮೇಲೆ ನಿಲ್ಲಲು ಶಕ್ತರಾಗುವಂತೆ, ದೇವರ ಸರ್ವಾಯುಧಗಳನ್ನು ಧರಿಸಿಕೊಳ್ಳಿರಿ. <verse eid="EPH 6:13"/><verse number="14" style="v" sid="EPH 6:14"/>ಸತ್ಯವೆಂಬ ನಡುಕಟ್ಟನ್ನು ಕಟ್ಟಿಕೊಂಡು, ನೀತಿಯೆಂಬ ಕವಚವನ್ನು ಧರಿಸಿಕೊಳ್ಳಿರಿ. <verse eid="EPH 6:14"/><verse number="15" style="v" sid="EPH 6:15"/>ಸಮಾಧಾನದ ಸುವಾರ್ತೆಯ ಸಿದ್ಧತೆಯೆಂಬ ಪಾದರಕ್ಷೆಗಳನ್ನು ಮೆಟ್ಟಿಕೊಂಡು ನಿಲ್ಲಿರಿ. <verse eid="EPH 6:15"/><verse number="16" style="v" sid="EPH 6:16"/>ಇವೆಲ್ಲವುಗಳೊಂದಿಗೆ ವಿಶ್ವಾಸವೆಂಬ ಗುರಾಣಿಯನ್ನು ಹಿಡಿದುಕೊಳ್ಳಿರಿ. ಈ ಗುರಾಣಿಯಿಂದಲೇ, ನೀವು ಕೆಡುಕನ ಅಗ್ನಿಬಾಣಗಳನ್ನೆಲ್ಲಾ ನಂದಿಸುವುದಕ್ಕೆ ಶಕ್ತರಾಗುವಿರಿ. <verse eid="EPH 6:16"/><verse number="17" style="v" sid="EPH 6:17"/>ಇದಲ್ಲದೆ ರಕ್ಷಣೆಯೆಂಬ ಶಿರಸ್ತ್ರಾಣವನ್ನು ಧರಿಸಿಕೊಳ್ಳಿರಿ. ದೇವರ ವಾಕ್ಯವೆಂಬ ಪವಿತ್ರಾತ್ಮರ ಖಡ್ಗವನ್ನು ಎತ್ತಿ ಹಿಡಿಯಿರಿ.<verse eid="EPH 6:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="EPH 6:18"/>ನೀವು ಪವಿತ್ರಾತ್ಮ ದೇವರಲ್ಲಿ ಎಲ್ಲಾ ಸಮಯಗಳಲ್ಲಿಯೂ ಸಕಲ ವಿಧವಾದ ಪ್ರಾರ್ಥನೆಯಿಂದಲೂ ವಿಜ್ಞಾಪನೆಯಿಂದಲೂ ಪ್ರಾರ್ಥಿಸಿರಿ. ಇದರಲ್ಲಿ ಪೂರ್ಣ ಸ್ಥಿರಚಿತ್ತರಾಗಿದ್ದು ಕರ್ತನ ಜನರೆಲ್ಲರಿಗಾಗಿ ಪ್ರಾರ್ಥನೆ ಮಾಡುತ್ತಾ ಎಚ್ಚರವಾಗಿರಿ. <verse eid="EPH 6:18"/><verse number="19" style="v" sid="EPH 6:19"/>ನಾನು ಬಾಯಿ ತೆರೆಯುವಾಗ ಸುವಾರ್ತೆಯ ರಹಸ್ಯವನ್ನು ಧೈರ್ಯವಾಗಿ ತಿಳಿಯಪಡಿಸುವುದಕ್ಕೆ ಮಾತನ್ನು ನನಗೆ ದಯಪಾಲಿಸಬೇಕೆಂದು ಪ್ರಾರ್ಥಿಸಿರಿ. <verse eid="EPH 6:19"/><verse number="20" style="v" sid="EPH 6:20"/>ಏಕೆಂದರೆ ಆ ಸುವಾರ್ತೆಗಾಗಿಯೇ ಸೆರೆಯಲ್ಲಿರುವ ರಾಯಭಾರಿಯಾದ ನಾನು ಅದನ್ನು ಸಾರುವುದರಲ್ಲಿ ಧೈರ್ಯವಾಗಿ ಮಾತನಾಡುವ ಹಂಗಿನಲ್ಲಿದ್ದೇನೆ.<verse eid="EPH 6:20"/></para>
  <para style="b"/>
  <para style="s1">ಅಂತಿಮ ವಂದನೆಗಳು</para>
  <para style="p">
    <verse number="21" style="v" sid="EPH 6:21"/>ನನ್ನ ವಿಷಯವಾಗಿಯೂ ನಾನು ಮಾಡುತ್ತಿರುವುದರ ವಿಷಯವಾಗಿಯೂ ಪ್ರಿಯ ಸಹೋದರನೂ ಕರ್ತನಲ್ಲಿ ನಂಬಿಗಸ್ತನಾದ ಸೇವಕನೂ ಆಗಿರುವ ತುಖಿಕನು ನಿಮಗೆ ಎಲ್ಲವನ್ನೂ ತಿಳಿಸುವನು. <verse eid="EPH 6:21"/><verse number="22" style="v" sid="EPH 6:22"/>ನೀವು ನಮ್ಮ ಸಮಾಚಾರವನ್ನು ತಿಳಿದುಕೊಳ್ಳುವಂತೆಯೂ ಅವನು ನಿಮ್ಮ ಹೃದಯಗಳನ್ನು ಉತ್ತೇಜಿಸುವಂತೆಯೂ ಅವನನ್ನು ನಿಮ್ಮ ಬಳಿಗೆ ಕಳುಹಿಸಿದ್ದೇನೆ.<verse eid="EPH 6:22"/></para>
  <para style="b"/>
  <para style="p">
    <verse number="23" style="v" sid="EPH 6:23"/>ತಂದೆಯಾದ ದೇವರಿಂದಲೂ ಕರ್ತ ಆಗಿರುವ ಯೇಸು ಕ್ರಿಸ್ತರಿಂದಲೂ ಶಾಂತಿಯೂ ಮತ್ತು ನಂಬಿಕೆಯಿಂದ ಕೂಡಿದ ಪ್ರೀತಿಯೂ ಸಹೋದರರಿಗೆ ಇರಲಿ.<verse eid="EPH 6:23"/></para>
  <para style="b"/>
  <para style="p">
    <verse number="24" style="v" sid="EPH 6:24"/>ನಮ್ಮ ಕರ್ತ ಆಗಿರುವ ಯೇಸು ಕ್ರಿಸ್ತರನ್ನು ಅಳಿದು ಹೋಗದ ಪ್ರೀತಿಯಿಂದ ಪ್ರೀತಿಸುವವರೆಲ್ಲರ ಮೇಲೆ ಕೃಪೆಯಿರಲಿ.<verse eid="EPH 6:24"/></para>
  <chapter eid="EPH 6"/>
</usx>
