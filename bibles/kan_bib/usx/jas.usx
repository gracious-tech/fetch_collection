<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="JAS" style="id">- Biblica® Open Kannada Contemporary Version</book>
  <para style="h">ಯಾಕೋಬನು</para>
  <para style="toc1">ಯಾಕೋಬನು ಬರೆದ ಪತ್ರಿಕೆ</para>
  <para style="toc2">ಯಾಕೋಬನು</para>
  <para style="toc3">ಯಾಕೋಬ</para>
  <para style="mt1">ಯಾಕೋಬನು</para>
  <para style="mt2">ಬರೆದ ಪತ್ರಿಕೆ</para>
  <chapter number="1" style="c" sid="JAS 1"/>
  <para style="p">
    <verse number="1" style="v" sid="JAS 1:1"/>ದೇವರಿಗೂ ಕರ್ತ ಆಗಿರುವ ಯೇಸು ಕ್ರಿಸ್ತರಿಗೂ ದಾಸನಾಗಿರುವ ಯಾಕೋಬನು,</para>
  <para style="b" vid="JAS 1:1"/>
  <para style="p" vid="JAS 1:1">ವಿವಿಧ ದೇಶಗಳಲ್ಲಿ ಚದರಿರುವ ಇಸ್ರಾಯೇಲರ ಹನ್ನೆರಡು ಗೋತ್ರದವರಿಗೆ ಬರೆಯುವುದು:</para>
  <para style="b" vid="JAS 1:1"/>
  <para style="p" vid="JAS 1:1">ನಿಮಗೆ ಶುಭವಾಗಲಿ.<verse eid="JAS 1:1"/></para>
  <para style="b"/>
  <para style="s1">ಕಷ್ಟಗಳು ಮತ್ತು ಶೋಧನೆಗಳು</para>
  <para style="p">
    <verse number="2" style="v" sid="JAS 1:2"/>ನನ್ನ ಪ್ರಿಯರೇ, ನಿಮ್ಮ ನಂಬಿಕೆಯು ವಿವಿಧ ಕಷ್ಟಗಳಿಗೆ ಗುರಿಯಾಗುವಾಗ ಅವುಗಳನ್ನು ಸಂತೋಷದಿಂದ ಎಣಿಸಿಕೊಳ್ಳಿರಿ. <verse eid="JAS 1:2"/><verse number="3" style="v" sid="JAS 1:3"/>ನಿಮ್ಮ ನಂಬಿಕೆಯ ಪರೀಕ್ಷೆಯು ದೃಢ ನಿಷ್ಠೆಯನ್ನು ಉಂಟುಮಾಡುತ್ತದೆ ಎಂದು ತಿಳಿದಿದ್ದೀರಿ. <verse eid="JAS 1:3"/><verse number="4" style="v" sid="JAS 1:4"/>ಆ ದೃಢ ನಿಷ್ಠೆಯು ನಿಮ್ಮಲ್ಲಿ ಪೂರ್ಣ ಕ್ರಿಯೆಯನ್ನು ಉಂಟುಮಾಡಿದಾಗ, ಆಗ ನೀವು ಪರಿಪಕ್ವತೆಗೆ ಬಂದವರೂ ಪರಿಪೂರ್ಣರೂ ಯಾವ ಕೊರತೆಯೂ ಇಲ್ಲದವರೂ ಆಗಿರುವಿರಿ. <verse eid="JAS 1:4"/><verse number="5" style="v" sid="JAS 1:5"/>ನಿಮ್ಮಲ್ಲಿ ಯಾರಿಗಾದರೂ ಜ್ಞಾನ ಕಡಿಮೆಯಾಗಿದ್ದರೆ, ಅವರು ದೇವರನ್ನು ಕೇಳಿಕೊಳ್ಳಲಿ, ಅದು ಅವರಿಗೆ ದೊರಕುವುದು. ದೇವರು ತಪ್ಪು ಕಂಡುಹಿಡಿಯದೆ ಎಲ್ಲರಿಗೂ ಉದಾರಮನಸ್ಸಿನಿಂದ ಕೊಡುವರು. <verse eid="JAS 1:5"/><verse number="6" style="v" sid="JAS 1:6"/>ನೀವು ಕೇಳಿಕೊಂಡಾಗ ಸ್ವಲ್ಪವೂ ಸಂದೇಹ ಪಡದೆ ನಂಬಿಕೆಯಿಂದ ಕೇಳಿಕೊಳ್ಳಿರಿ. ಏಕೆಂದರೆ ಸಂದೇಹ ಪಡುವವನು ಬಿರುಗಾಳಿಯ ಬಡಿತಕ್ಕೆ ಒಳಗಾದ ಸಮುದ್ರದ ತೆರೆಯಂತೆ ಅಲೆದಾಡುತ್ತಿರುವನು. <verse eid="JAS 1:6"/><verse number="7" style="v" sid="JAS 1:7"/>ಅಂಥವನು ತಾನು ಕರ್ತ ದೇವರಿಂದ ಏನಾದರೂ ಹೊಂದುವೆನೆಂದು ನಿರೀಕ್ಷಿಸದೆ ಇರಲಿ. <verse eid="JAS 1:7"/><verse number="8" style="v" sid="JAS 1:8"/>ಅಂತಹ ವ್ಯಕ್ತಿ ಎರಡು ಮನಸ್ಸುಳ್ಳವನೂ ತನ್ನ ಮಾರ್ಗಗಳಲ್ಲೆಲ್ಲಾ ಚಂಚಲನೂ ಆಗಿದ್ದಾನೆ.<verse eid="JAS 1:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="JAS 1:9"/>ಹೀನಸ್ಥಿತಿಯಲ್ಲಿರುವ ಸಹೋದರನು ತಾನು ಉನ್ನತಸ್ಥಿತಿಗೆ ಬಂದೆನೆಂದು ಅಭಿಮಾನಪಡಲಿ. <verse eid="JAS 1:9"/><verse number="10" style="v" sid="JAS 1:10"/>ಐಶ್ವರ್ಯವಂತನಾದ ಸಹೋದರನು, ತಾನು ದೀನಸ್ಥಿತಿಗೆ ಬಂದೆನೆಂದು ಅಭಿಮಾನಪಡಲಿ. ಆದರೆ ಐಶ್ವರ್ಯವಂತನು ಕಾಡು ಹೂವಿನಂತೆ ಮರೆಯಾಗುವನು. <verse eid="JAS 1:10"/><verse number="11" style="v" sid="JAS 1:11"/>ಸೂರ್ಯನು ಉದಯಿಸಿದ ತರುವಾಯ ಉಷ್ಣತೆಯಿಂದ ಗಿಡ ಬಾಡಲು, ಅದರ ಹೂವು ಉದುರಿ ಅದರ ರೂಪದ ಸೊಗಸು ನಾಶವಾಗುವುದಷ್ಟೆ. ಹೀಗೆಯೇ ಐಶ್ವರ್ಯವಂತನು ತನ್ನ ದಾರಿಗಳಲ್ಲಿ ಬಾಡಿಹೋಗುವನು.<verse eid="JAS 1:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="JAS 1:12"/>ಕಷ್ಟಗಳನ್ನು ಸಹಿಸಿಕೊಳ್ಳುವವನು ಧನ್ಯನು. ಅವನು ಪರಿಶೋಧಿತನಾದ ಮೇಲೆ ಕರ್ತದೇವರು ತಮ್ಮನ್ನು ಪ್ರೀತಿಸುವವರಿಗೆ ವಾಗ್ದಾನಮಾಡಿದ ಜೀವದ ಕಿರೀಟವನ್ನು ಹೊಂದುವನು.<verse eid="JAS 1:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="JAS 1:13"/>ಯಾರಿಗಾದರೂ ಶೋಧನೆ ಬಂದಾಗ, “ದೇವರು ನನ್ನನ್ನು ಶೋಧಿಸುತ್ತಿದ್ದಾರೆ ಎಂದು ಹೇಳಬಾರದು,” ಏಕೆಂದರೆ ದೇವರು ಕೆಟ್ಟದ್ದರಿಂದ ಶೋಧಿಸಲಾರರು. ಅವರು ಯಾರನ್ನೂ ಶೋಧಿಸುವುದೂ ಇಲ್ಲ. <verse eid="JAS 1:13"/><verse number="14" style="v" sid="JAS 1:14"/>ಆದರೆ ಪ್ರತಿಯೊಬ್ಬನು ತನ್ನ ಸ್ವಂತ ದುರಾಶೆಯಿಂದ ಆಕರ್ಷಿಸಿ ಮರುಳುಗೊಂಡವನಾಗಿ ಶೋಧನೆಗೆ ಒಳಗಾಗುವನು. <verse eid="JAS 1:14"/><verse number="15" style="v" sid="JAS 1:15"/>ಆಮೇಲೆ ದುರಾಶೆಯು ಗರ್ಭಧರಿಸಿ ಪಾಪವನ್ನು ಹೆರುತ್ತದೆ. ಪಾಪವು ಸಂಪೂರ್ಣವಾದ ಮೇಲೆ ಮರಣವನ್ನು ಹೆರುತ್ತದೆ.<verse eid="JAS 1:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="JAS 1:16"/>ನನ್ನ ಪ್ರಿಯ ಸಹೋದರರೇ, ಮೋಸಹೋಗಬೇಡಿರಿ. <verse eid="JAS 1:16"/><verse number="17" style="v" sid="JAS 1:17"/>ಎಲ್ಲಾ ಉತ್ತಮ ಮತ್ತು ಪೂರ್ಣವಾದ ವರಗಳೂ ಮೇಲಿನಿಂದ ಬಂದವುಗಳೇ, ಅವು ಪರಲೋಕದ ಬೆಳಕಿನ ತಂದೆಯಿಂದ ಇಳಿದು ಬರುತ್ತವೆ. ಆ ತಂದೆಯು ಬದಲಾಗುವ ನೆರಳಿನಂತೆ ಬದಲಾಗುವವರಲ್ಲ. <verse eid="JAS 1:17"/><verse number="18" style="v" sid="JAS 1:18"/>ತಂದೆಯು ತಮ್ಮ ಚಿತ್ತದ ಪ್ರಕಾರ ಸತ್ಯವಾಕ್ಯದಿಂದ ನಮ್ಮನ್ನು ಹುಟ್ಟಿಸಲಾಗಿ ನಾವು ಅವರ ಸರ್ವ ಸೃಷ್ಟಿಗಳಲ್ಲಿ ಪ್ರಥಮ ಫಲವಾದೆವು.<verse eid="JAS 1:18"/></para>
  <para style="s1">ದೇವರ ವಾಕ್ಯವನ್ನು ಕೇಳಿ ಅದರಂತೆ ನಡೆಯುವುದು</para>
  <para style="p">
    <verse number="19" style="v" sid="JAS 1:19"/>ನನ್ನ ಪ್ರಿಯರೇ ಇದನ್ನು ತಿಳಿಯಿರಿ, ಪ್ರತಿಯೊಬ್ಬನು ಕಿವಿಗೊಡುವುದರಲ್ಲಿ ತೀವ್ರವಾಗಿಯೂ ಮಾತನಾಡುವುದರಲ್ಲಿ ಮತ್ತು ಕೋಪಿಸುವುದರಲ್ಲಿ ನಿಧಾನವಾಗಿಯೂ ಇರಲಿ. <verse eid="JAS 1:19"/><verse number="20" style="v" sid="JAS 1:20"/>ಏಕೆಂದರೆ ಮನುಷ್ಯನ ಕೋಪವು ದೇವರು ಬಯಸುವ ನೀತಿಯ ಜೀವನವನ್ನು ತರುವುದಿಲ್ಲ. <verse eid="JAS 1:20"/><verse number="21" style="v" sid="JAS 1:21"/>ಆದಕಾರಣ ಎಲ್ಲಾ ಮಾಲಿನ್ಯವನ್ನೂ ಉಳಿದಿರುವ ದುಷ್ಟತನವನ್ನೂ ತೆಗೆದುಹಾಕಿ, ನಿಮ್ಮೊಳಗೆ ಬೇರೂರಿರುವ ವಾಕ್ಯವನ್ನು ನಮ್ರತೆಯಿಂದ ಸ್ವೀಕರಿಸಿರಿ. ಅದು ನಿಮ್ಮ ಆತ್ಮಗಳನ್ನು ರಕ್ಷಿಸುವುದಕ್ಕೆ ಸಾಮರ್ಥ್ಯವುಳ್ಳದ್ದಾಗಿದೆ.<verse eid="JAS 1:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="JAS 1:22"/>ನೀವು ವಾಕ್ಯದ ಪ್ರಕಾರ ನಡೆಯುವವರಾಗಿರಿ, ಅದನ್ನು ಕೇಳುವವರು ಮಾತ್ರವೇ ಆಗಿದ್ದು ನಿಮ್ಮನ್ನು ನೀವೇ ಮೋಸಗೊಳಿಸಿಕೊಳ್ಳಬೇಡಿರಿ. <verse eid="JAS 1:22"/><verse number="23" style="v" sid="JAS 1:23"/>ಯಾವನಾದರೂ ವಾಕ್ಯವನ್ನು ಕೇಳುವವನಾಗಿದ್ದು ಅದರ ಪ್ರಕಾರ ನಡೆಯದಿದ್ದರೆ ಅವನು ಕನ್ನಡಿಯಲ್ಲಿ ತನ್ನ ಮುಖವನ್ನು ನೋಡಿಕೊಂಡ ಮನುಷ್ಯನಂತಿರುವನು. <verse eid="JAS 1:23"/><verse number="24" style="v" sid="JAS 1:24"/>ಏಕೆಂದರೆ ಇವನು ತನ್ನನ್ನು ಕನ್ನಡಿಯಲ್ಲಿ ನೋಡಿಕೊಂಡು ಹೋಗಿದ್ದರೂ ತಾನು ಹೀಗಿದ್ದೇನೆಂಬುದನ್ನು ಆ ಕ್ಷಣವೇ ಮರೆತುಬಿಡುವನು. <verse eid="JAS 1:24"/><verse number="25" style="v" sid="JAS 1:25"/>ಆದರೆ ಸ್ವಾತಂತ್ರ್ಯವನ್ನುಂಟುಮಾಡುವ ಪರಿಪೂರ್ಣವಾದ ನಿಯಮವನ್ನು ಲಕ್ಷ್ಯವಿಟ್ಟು ನೋಡುತ್ತಲೇ ಇರುವವನು, ಆ ವಾಕ್ಯವನ್ನು ಕೇಳಿದರೂ ಮರೆತು ಹೋಗದೆ ಅದರಂತೆ ನಡೆಯುವವನಾದ್ದರಿಂದ ಅವನು ಧನ್ಯನಾಗುವನು.<verse eid="JAS 1:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="JAS 1:26"/>ನಿಮ್ಮಲ್ಲಿ ಭಕ್ತನೆಂದೆಣಿಸಿಕೊಳ್ಳುವ ಯಾವನಾದರೂ ತನ್ನ ನಾಲಿಗೆಗೆ ಕಡಿವಾಣವನ್ನು ಹಾಕದೆ ತನ್ನ ಹೃದಯವನ್ನು ಮೋಸಗೊಳಿಸುವವನಾದರೆ ಅವನ ಭಕ್ತಿ ನಿಷ್ಪ್ರಯೋಜಕವಾಗಿದೆ. <verse eid="JAS 1:26"/><verse number="27" style="v" sid="JAS 1:27"/>ದಿಕ್ಕಿಲ್ಲದವರನ್ನೂ ವಿಧವೆಯರನ್ನೂ ಅವರ ಸಂಕಟದಲ್ಲಿ ಪರಾಮರಿಸಿ, ತನಗೆ ಪ್ರಪಂಚದ ದೋಷವು ಹತ್ತದಂತೆ ನೋಡಿಕೊಂಡಿರುವುದೇ ತಂದೆ ದೇವರ ಸನ್ನಿಧಾನದಲ್ಲಿ ಶುದ್ಧವೂ ನಿರ್ದೋಷವೂ ಆಗಿರುವ ಭಕ್ತಿ.<verse eid="JAS 1:27"/></para>
  <chapter eid="JAS 1"/>
  <chapter number="2" style="c" sid="JAS 2"/>
  <para style="s1">ಪಕ್ಷಪಾತವನ್ನು ಕುರಿತದ್ದು</para>
  <para style="p">
    <verse number="1" style="v" sid="JAS 2:1"/>ನನ್ನ ಪ್ರಿಯರೇ, ಮಹಿಮೆಯುಳ್ಳ ನಮ್ಮ ಕರ್ತ ಆಗಿರುವ ಯೇಸು ಕ್ರಿಸ್ತರಲ್ಲಿ ವಿಶ್ವಾಸಿಗಳಾಗಿರುವ ನೀವು ಪಕ್ಷಪಾತಿಗಳಾಗಿರಬಾರದು. <verse eid="JAS 2:1"/><verse number="2" style="v" sid="JAS 2:2"/>ಹೇಗೆಂದರೆ ಒಬ್ಬ ಮನುಷ್ಯನು ಚಿನ್ನದ ಉಂಗುರವನ್ನೂ ಅಂದವಾದ ವಸ್ತ್ರವನ್ನೂ ಹಾಕಿಕೊಂಡು ನಿಮ್ಮ ಸಭೆಯೊಳಗೆ ಬರಲು ಮತ್ತು ಒಬ್ಬ ಬಡ ಮನುಷ್ಯನು ಹರಕು ಬಟ್ಟೆ ಹಾಕಿಕೊಂಡು ಬರಲು <verse eid="JAS 2:2"/><verse number="3" style="v" sid="JAS 2:3"/>ನೀವು ಹೊಳೆಯುವ ವಸ್ತ್ರಗಳನ್ನು ಧರಿಸಿಕೊಂಡಿರುವವನನ್ನು ಗೌರವಿಸಿ ಆ ವ್ಯಕ್ತಿಗೆ, “ನೀವು ಇಲ್ಲಿಯ ಗೌರವ ಪೀಠದಲ್ಲಿ ಕುಳಿತುಕೊಳ್ಳಿರಿ,” ಎಂತಲೂ ಆ ಬಡವನಿಗೆ, “ನೀನು ಅಲ್ಲಿ ನಿಂತುಕೋ ಇಲ್ಲವೆ ಇಲ್ಲಿ ನನ್ನ ಕಾಲ್ಮಣೆಯ ಬಳಿ ಕುಳಿತುಕೋ,” ಎಂತಲೂ ಹೇಳಿದರೆ, <verse eid="JAS 2:3"/><verse number="4" style="v" sid="JAS 2:4"/>ನೀವು ಪಕ್ಷಪಾತಿಗಳಾಗಿ ಕೆಟ್ಟ ಆಲೋಚನೆಗಳ ನ್ಯಾಯಾಧಿಪತಿಗಳಾಗಿರುತ್ತೀರಲ್ಲವೇ?<verse eid="JAS 2:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="JAS 2:5"/>ನನ್ನ ಪ್ರಿಯರೇ, ಕೇಳಿರಿ, ದೇವರು ಈ ಲೋಕದ ಬಡವರನ್ನು ನಂಬಿಕೆಯಲ್ಲಿ ಐಶ್ವರ್ಯವಂತರನ್ನಾಗಿಯೂ ತಮ್ಮನ್ನು ಪ್ರೀತಿಸುವವರಿಗೆ ತಾವು ವಾಗ್ದಾನಮಾಡಿದ ರಾಜ್ಯಕ್ಕೆ ಬಾಧ್ಯರನ್ನಾಗಿಯೂ ಇರಬೇಕೆಂದು ಆರಿಸಿಕೊಳ್ಳಲಿಲ್ಲವೇ? <verse eid="JAS 2:5"/><verse number="6" style="v" sid="JAS 2:6"/>ನೀವಾದರೋ ಬಡವರನ್ನು ಅವಮಾನ ಪಡಿಸಿದ್ದೀರಿ. ನಿಮ್ಮನ್ನು ಬಾಧಿಸಿ ನ್ಯಾಯಸ್ಥಾನಗಳ ಮುಂದೆ ಎಳೆದುಕೊಂಡು ಹೋಗುವವರು ಐಶ್ವರ್ಯವಂತರಲ್ಲವೋ? <verse eid="JAS 2:6"/><verse number="7" style="v" sid="JAS 2:7"/>ನೀವು ಕರೆಸಿಕೊಳ್ಳುವ ಆ ಯೋಗ್ಯವಾದ ನಾಮವನ್ನು ದೂಷಿಸುವವರು ಅವರಲ್ಲವೇ?<verse eid="JAS 2:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="JAS 2:8"/>“ನಿನ್ನ ನೆರೆಯವನನ್ನು ನಿನ್ನಂತೆಯೇ ಪ್ರೀತಿಸಬೇಕು!”<note caller="+" style="f"><char style="fr" closed="false">2:8 </char><char style="ft" closed="false"><char style="xt"><ref loc="LEV 19:18">ಯಾಜಕ 19:18</ref></char></char></note> ಎಂದು ಪವಿತ್ರ ವೇದದಲ್ಲಿ ಬರೆದಿದೆ. ಈ ರಾಜಾಜ್ಞೆಯನ್ನು ನೆರವೇರಿಸುವವರಾದರೆ ನೀವು ಉತ್ತಮವಾದದ್ದನ್ನು ಮಾಡುವವರಾಗಿರುವಿರಿ. <verse eid="JAS 2:8"/><verse number="9" style="v" sid="JAS 2:9"/>ನೀವು ಪಕ್ಷಪಾತಿಗಳಾಗಿದ್ದರೆ ಪಾಪಮಾಡುವವರಾಗಿದ್ದೀರಿ. ಮಾತ್ರವಲ್ಲದೆ ಮೋಶೆಯ ನಿಯಮದ ಪ್ರಕಾರ ಅಪರಾಧಿಗಳೆಂದು ನಿರ್ಣಯ ಹೊಂದುತ್ತೀರಿ. <verse eid="JAS 2:9"/><verse number="10" style="v" sid="JAS 2:10"/>ಏಕೆಂದರೆ ಯಾವನಾದರೂ ಇಡೀ ಮೋಶೆಯ ನಿಯಮದಲ್ಲಿ ಒಂದೇ ಒಂದನ್ನು ಕೈಕೊಂಡು ನಡೆಯದೇ ಹೋದರೆ, ಅವನು ಇಡೀ ನಿಯಮವನ್ನೇ ಕೈಕೊಳ್ಳದ ಅಪರಾಧಿಯಾಗುತ್ತಾನೆ. <verse eid="JAS 2:10"/><verse number="11" style="v" sid="JAS 2:11"/>ಏಕೆಂದರೆ, “ವ್ಯಭಿಚಾರ ಮಾಡಬಾರದು,”<note caller="+" style="f"><char style="fr" closed="false">2:11 </char><char style="ft" closed="false"><char style="xt"><ref loc="EXO 20:14">ವಿಮೋ 20:14</ref>; <ref loc="DEU 5:18">ಧರ್ಮೋ 5:18</ref></char></char></note> ಎಂದು ಹೇಳಿದ ದೇವರೇ, “ನರಹತ್ಯೆ ಮಾಡಬಾರದು,”<note caller="+" style="f"><char style="fr" closed="false">2:11 </char><char style="ft" closed="false"><char style="xt"><ref loc="EXO 20:13">ವಿಮೋ 20:13</ref>; <ref loc="DEU 5:17">ಧರ್ಮೋ 5:17</ref></char></char></note> ಎಂತಲೂ ಹೇಳಿದರು. ಆದಕಾರಣ ನೀನು ವ್ಯಭಿಚಾರ ಮಾಡದೆ ಇದ್ದರೂ ನರಹತ್ಯೆ ಮಾಡಿದರೆ ನಿಯಮವನ್ನು ಮೀರಿದವನಾದೆ.<verse eid="JAS 2:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="JAS 2:12"/>ಸ್ವಾತಂತ್ರ್ಯವನ್ನು ಉಂಟುಮಾಡುವ ನಿಯಮದಿಂದ ನಾವು ತೀರ್ಪುಹೊಂದುವೆವು ಎಂದು ತಿಳಿದು, ನಮ್ಮ ಮಾತುಗಳೂ ಕೃತ್ಯಗಳೂ ಅದಕ್ಕೆ ಅನುಸಾರವಾಗಿರಲಿ. <verse eid="JAS 2:12"/><verse number="13" style="v" sid="JAS 2:13"/>ಕರುಣೆ ತೋರಿಸದೆ ಇರುವವರಿಗೆ ಕರುಣೆಯಿಲ್ಲದ ನ್ಯಾಯತೀರ್ಪಾಗುವುದು. ಕರುಣೆವುಳ್ಳವರೋ ನ್ಯಾಯತೀರ್ಪಿನ ಮೇಲೆಯೇ ವಿಜಯವನ್ನು ಸಾಧಿಸುವರು.<verse eid="JAS 2:13"/></para>
  <para style="s1">ನಂಬಿಕೆಯೂ ಸತ್ಕಾರ್ಯವೂ</para>
  <para style="p">
    <verse number="14" style="v" sid="JAS 2:14"/>ನನ್ನ ಪ್ರಿಯರೇ, ಒಬ್ಬನು ತನಗೆ ನಂಬಿಕೆಯುಂಟೆಂದು ಹೇಳಿಕೊಂಡು ಕ್ರಿಯೆಗಳಿಲ್ಲದವನಾಗಿದ್ದರೆ ಪ್ರಯೋಜನವೇನು? ಅಂಥ ನಂಬಿಕೆಯು ಅವನನ್ನು ರಕ್ಷಿಸುವುದೋ? <verse eid="JAS 2:14"/><verse number="15" style="v" sid="JAS 2:15"/>ಒಬ್ಬ ಸಹೋದರನಿಗೆ ಇಲ್ಲವೆ ಒಬ್ಬ ಸಹೋದರಿಗೆ ಬಟ್ಟೆಯೂ ದಿನದ ಆಹಾರವೂ ಇಲ್ಲದಿರುವಾಗ, <verse eid="JAS 2:15"/><verse number="16" style="v" sid="JAS 2:16"/>ನಿಮ್ಮಲ್ಲಿ ಒಬ್ಬನು ಅವನಿಗೆ ದೇಹಕ್ಕೆ ಬೇಕಾದವುಗಳನ್ನು ಕೊಡದೆ, “ಸಮಾಧಾನದಿಂದ ಹೋಗಿರಿ, ಚಳಿ ಕಾಯಿಸಿಕೊಳ್ಳಿರಿ, ಹೊಟ್ಟೆ ತುಂಬಿಸಿಕೊಳ್ಳಿರಿ,” ಎಂದು ಹೇಳಿದರೆ ಪ್ರಯೋಜನವೇನು? <verse eid="JAS 2:16"/><verse number="17" style="v" sid="JAS 2:17"/>ಅದರಂತೆಯೇ, ಕ್ರಿಯೆಗಳಿಲ್ಲದ ನಂಬಿಕೆಯು, ಕ್ರಿಯೆಗಳು ಇಲ್ಲದಿರುವುದರಿಂದ ಸತ್ತ ನಂಬಿಕೆಯಾಗಿರುತ್ತದೆ.<verse eid="JAS 2:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="JAS 2:18"/>ಆದರೆ ಒಬ್ಬ ಮನುಷ್ಯನು, “ನಿನ್ನಲ್ಲಿ ನಂಬಿಕೆಯಿದೆ, ನನ್ನಲ್ಲಿ ಕ್ರಿಯೆಗಳಿವೆ,” ಎಂದು ವಾದಿಸಬಹುದು.</para>
  <para style="p" vid="JAS 2:18">ಅಂಥವನಿಗೆ, “ನೀನು ಕ್ರಿಯೆಗಳಿಲ್ಲದೆ ನಿನ್ನ ನಂಬಿಕೆಯನ್ನು ನನಗೆ ರುಜುಪಡಿಸು. ನಾನು ನನ್ನ ಕ್ರಿಯೆಗಳ ಮುಖಾಂತರ ನನ್ನ ನಂಬಿಕೆಯನ್ನು ನಿನಗೆ ರುಜುಪಡಿಸುತ್ತೇನೆ,” ಎಂದು ಹೇಳಬಹುದು. <verse eid="JAS 2:18"/><verse number="19" style="v" sid="JAS 2:19"/>ದೇವರು ಒಬ್ಬರೇ ಎಂದು ನೀನು ನಂಬುತ್ತೀ, ಅದು ಒಳ್ಳೆಯದು, ದೆವ್ವಗಳು ಕೂಡ ಹಾಗೆಯೇ ನಂಬಿ ನಡುಗುತ್ತವೆ.<verse eid="JAS 2:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="JAS 2:20"/>ಮೂರ್ಖನೇ, ಕ್ರಿಯೆಗಳಿಲ್ಲದ ನಂಬಿಕೆಯು ಸತ್ತದ್ದೆಂದು<note caller="+" style="f"><char style="fr" closed="false">2:20 </char><char style="ft" closed="false">ಕೆಲವು ಪ್ರತಿಗಳಲ್ಲಿ </char><char style="fqa" closed="false">ವ್ಯರ್ಥವಾದದ್ದೆಂದು </char><char style="ft" closed="false">ಇದೆ.</char></note> ತಿಳಿದುಕೊಳ್ಳಲು ನಿನಗೆ ಪ್ರಮಾಣಗಳು ಬೇಕೋ? <verse eid="JAS 2:20"/><verse number="21" style="v" sid="JAS 2:21"/>ನಮ್ಮ ಪಿತೃವಾದ ಅಬ್ರಹಾಮನು ತನ್ನ ಮಗನಾದ ಇಸಾಕನನ್ನು ಬಲಿಪೀಠದ ಮೇಲೆ ಅರ್ಪಿಸಿದಾಗ ನೀತಿನಿರ್ಣಯವನ್ನು ಹೊಂದಿದ್ದು ಕ್ರಿಯೆಗಳಿಂದಲ್ಲವೇ? <verse eid="JAS 2:21"/><verse number="22" style="v" sid="JAS 2:22"/>ಅಬ್ರಹಾಮನ ನಂಬಿಕೆಯೂ ಕ್ರಿಯೆಗಳೂ ಒಂದಾಗಿ ಕಾರ್ಯ ಸಾಧಿಸಿದವು. ಹೀಗೆ ಅವನು ಮಾಡಿದ ಕ್ರಿಯೆಗಳಿಂದಲೇ ಅವನ ನಂಬಿಕೆಯು ಸಂಪೂರ್ಣಗೊಂಡಿತು ಎಂದು ನೋಡುತ್ತೇವೆ. <verse eid="JAS 2:22"/><verse number="23" style="v" sid="JAS 2:23"/>ಹೀಗೆ, “ಅಬ್ರಹಾಮನು ದೇವರನ್ನು ನಂಬಿದನು. ಆ ನಂಬಿಕೆಯು ಅವನ ಲೆಕ್ಕಕ್ಕೆ ನೀತಿ ಎಂದು ಎಣಿಸಲಾಯಿತು,”<note caller="+" style="f"><char style="fr" closed="false">2:23 </char><char style="ft" closed="false"><char style="xt"><ref loc="GEN 15:6">ಆದಿ 15:6</ref></char></char></note> ಎಂಬ ಪವಿತ್ರ ವೇದದ ವಾಕ್ಯವು ನೆರವೇರಿತು. ಅಬ್ರಹಾಮನು ದೇವರ ಸ್ನೇಹಿತನೆಂದು ಎಣಿಸಿಕೊಂಡನು. <verse eid="JAS 2:23"/><verse number="24" style="v" sid="JAS 2:24"/>ಹೀಗೆ ಮನುಷ್ಯನು ನಂಬಿಕೆಯಿಂದ ಮಾತ್ರವಲ್ಲ ಕ್ರಿಯೆಗಳಿಂದಲೂ ನೀತಿವಂತನೆಂದು ನಿರ್ಣಯ ಹೊಂದುತ್ತಾನೆ ಎಂದು ನೀವು ನೋಡುತ್ತೀರಿ.<verse eid="JAS 2:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="JAS 2:25"/>ಅದೇ ರೀತಿಯಾಗಿ ರಹಾಬಳೆಂಬ ವೇಶ್ಯೆಯು ಸಹ ಗೂಢಚಾರರನ್ನು ಸೇರಿಸಿಕೊಂಡು, ಅವರನ್ನು ಬೇರೆ ದಾರಿಯಿಂದ ಕಳುಹಿಸಿದ ಕ್ರಿಯೆಗಳಿಂದಲೇ ಆಕೆಯು ನೀತಿನಿರ್ಣಯವನ್ನು ಹೊಂದಿದಳಲ್ಲವೇ? <verse eid="JAS 2:25"/><verse number="26" style="v" sid="JAS 2:26"/>ಆತ್ಮವಿಲ್ಲದ ದೇಹವು ಸತ್ತದ್ದಾಗಿರುವ ಪ್ರಕಾರವೇ, ಕ್ರಿಯೆಗಳಿಲ್ಲದ ನಂಬಿಕೆಯೂ ಸತ್ತದ್ದಾಗಿರುತ್ತದೆ.<verse eid="JAS 2:26"/></para>
  <chapter eid="JAS 2"/>
  <chapter number="3" style="c" sid="JAS 3"/>
  <para style="s1">ನಾಲಿಗೆಯನ್ನು ಬಿಗಿ ಹಿಡಿಯುವುದು ಅವಶ್ಯ</para>
  <para style="p">
    <verse number="1" style="v" sid="JAS 3:1"/>ನನ್ನ ಪ್ರಿಯರೇ, ಬೋಧಕರಾದ ನಮಗೆ ದೊಡ್ಡ ದಂಡನೆಯಾಗುವುದೆಂದು ತಿಳಿದುಕೊಂಡು ಬಹುಮಂದಿ ಬೋಧಕರಾಗಬೇಡಿರಿ. <verse eid="JAS 3:1"/><verse number="2" style="v" sid="JAS 3:2"/>ಏಕೆಂದರೆ ಅನೇಕ ವಿಷಯಗಳಲ್ಲಿ ನಾವೆಲ್ಲರೂ ತಪ್ಪುವುದುಂಟು. ಒಬ್ಬನು ಮಾತಿನಲ್ಲಿ ತಪ್ಪದಿದ್ದರೆ, ಅವನು ಪರಿಪೂರ್ಣನೂ ತನ್ನ ಇಡೀ ದೇಹವನ್ನೇ ಸ್ವಾಧೀನದಲ್ಲಿಟ್ಟುಕೊಳ್ಳುವುದಕ್ಕೆ ಸಮರ್ಥನೂ ಆಗಿದ್ದಾನೆ.<verse eid="JAS 3:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="JAS 3:3"/>ಕುದುರೆಗಳು ನಮಗೆ ವಿಧೇಯವಾಗುವ ಹಾಗೆ ಅವುಗಳ ಬಾಯಿಗೆ ಕಡಿವಾಣ ಹಾಕುತ್ತೇವಲ್ಲಾ, ಆಗ ಅವುಗಳ ದೇಹವನ್ನೆಲ್ಲಾ ತಿರುಗಿಸುವುದಕ್ಕೆ ಆಗುತ್ತದೆ. <verse eid="JAS 3:3"/><verse number="4" style="v" sid="JAS 3:4"/>ಹಡಗುಗಳ ಉದಾಹರಣೆಯೂ ಅದರಂತೆ ಇದೆ. ಅವು ಬಹು ದೊಡ್ಡವಾಗಿದ್ದರೂ ಬಲವಾದ ಗಾಳಿಯಿಂದ ಬಡಿಸಿಕೊಂಡು ಹೋಗುತ್ತವೆ. ಆದರೂ ಬಹು ಸಣ್ಣ ಚುಕ್ಕಾಣಿಯಿಂದ ಅವುಗಳನ್ನು ನಡೆಸುವವನು ತನ್ನ ಮನಸ್ಸಿಗೆ ಬಂದ ಕಡೆಗೆ ಅವುಗಳನ್ನು ತಿರುಗಿಸುತ್ತಾನೆ. <verse eid="JAS 3:4"/><verse number="5" style="v" sid="JAS 3:5"/>ಹಾಗೆಯೇ ನಾಲಿಗೆಯು ಕೂಡ ಚಿಕ್ಕ ಅಂಗವಾಗಿದ್ದರೂ ದೊಡ್ಡ ಕಾರ್ಯಗಳನ್ನು ಕೊಚ್ಚಿಕೊಳ್ಳುತ್ತದೆ. ಒಂದು ಸಣ್ಣ ಬೆಂಕಿ ಕಿಡಿಯು ದೊಡ್ಡಕಾಡನ್ನೇ ಸುಟ್ಟುಬಿಡುತ್ತದೆ ನೋಡಿರಿ. <verse eid="JAS 3:5"/><verse number="6" style="v" sid="JAS 3:6"/>ನಮ್ಮ ದೇಹದ ಅಂಗಗಳಲ್ಲಿ ನಾಲಿಗೆಯು ಸಹ ಬೆಂಕಿಯೂ ದುಷ್ಟ ಲೋಕವೂ ಆಗಿದೆ. ಹೀಗೆ ನಾಲಿಗೆಯು ನಮ್ಮ ಅಂಗಗಳಲ್ಲಿ ಇದ್ದು, ಇಡೀ ದೇಹವನ್ನೆಲ್ಲಾ ಮಲಿನಗೊಳಿಸುತ್ತದೆ. ಅದು ನರಕದ ಬೆಂಕಿಯಿಂದ ಹೊತ್ತಿಕೊಂಡು, ಮಾನವರ ಇಡೀ ಜೀವನಕ್ಕೆ ಬೆಂಕಿ ಹಚ್ಚುವದಾಗಿದೆ.<verse eid="JAS 3:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="JAS 3:7"/>ಸಕಲ ವಿಧವಾದ ಮೃಗ, ಪಕ್ಷಿ, ಸರ್ಪ, ಜಲಚರಗಳನ್ನು ಮಾನವರು ಹತೋಟಿಗೆ ತರುತ್ತಾರೆ ಮತ್ತು ತಂದಿದ್ದಾರೆ. <verse eid="JAS 3:7"/><verse number="8" style="v" sid="JAS 3:8"/>ಆದರೆ ನಾಲಿಗೆಯನ್ನು ಯಾವ ಮಾನವನೂ ಹತೋಟಿಗೆ ತರಲಾರನು. ಅದು ಸ್ವಾಧೀನವಾಗದ ಕೆಡುಕಾಗಿದೆ. ಮರಣಕರವಾದ ವಿಷದಿಂದ ತುಂಬಿಕೊಂಡಿದೆ.<verse eid="JAS 3:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="JAS 3:9"/>ಅದೇ ನಾಲಿಗೆಯಿಂದ ನಮ್ಮ ತಂದೆಯಾದ ಕರ್ತದೇವರನ್ನು ಕೊಂಡಾಡುತ್ತೇವೆ, ಅದರಿಂದಲೇ ದೇವರ ಹೋಲಿಕೆಗೆ ಸರಿಯಾಗಿ ಸೃಷ್ಟಿಸಲಾದ ಮನುಷ್ಯರನ್ನು ನಾವು ಶಪಿಸುತ್ತೇವೆ. <verse eid="JAS 3:9"/><verse number="10" style="v" sid="JAS 3:10"/>ಅದೇ ಬಾಯಿಂದ ಸ್ತುತಿ ಮತ್ತು ಶಾಪ ಬರುತ್ತವೆ. ನನ್ನ ಪ್ರಿಯರೇ, ಇವುಗಳು ಹೀಗಿರಬಾರದು. <verse eid="JAS 3:10"/><verse number="11" style="v" sid="JAS 3:11"/>ಒಂದೇ ಬುಗ್ಗೆಯಿಂದ ಸಿಹಿನೀರನ್ನೂ ಉಪ್ಪುನೀರನ್ನೂ ಒಂದೇ ಸ್ಥಳದಿಂದ ಹೊರಡಿಸುವುದುಂಟೇ? <verse eid="JAS 3:11"/><verse number="12" style="v" sid="JAS 3:12"/>ನನ್ನ ಪ್ರಿಯರೇ, ಅಂಜೂರದ ಮರವು ಎಣ್ಣೇಮರದ ಕಾಯನ್ನು ಬಿಡುವುದೋ? ದ್ರಾಕ್ಷೇ ಬಳ್ಳಿಯಲ್ಲಿ ಅಂಜೂರದ ಹಣ್ಣಾಗುವದೋ? ಉಪ್ಪುನೀರಿನ ಬುಗ್ಗೆಯು ಸಿಹಿನೀರನ್ನು ಕೊಡಲು ಎಂದಿಗೂ ಸಾಧ್ಯವಿಲ್ಲ.<verse eid="JAS 3:12"/></para>
  <para style="s1">ನಿಜವಾದ ಜ್ಞಾನದ ಲಕ್ಷಣಗಳು</para>
  <para style="p">
    <verse number="13" style="v" sid="JAS 3:13"/>ನಿಮ್ಮಲ್ಲಿ ಜ್ಞಾನಿಯೂ ಬುದ್ಧಿವಂತನೂ ಯಾರು? ಅಂಥವನು ಜ್ಞಾನದಿಂದ ಬರುವ ದೀನತ್ವದಲ್ಲಿ ತನ್ನ ಕ್ರಿಯೆಗಳನ್ನು ಒಳ್ಳೆಯ ಜೀವನದಿಂದ ತೋರಿಸಲಿ. <verse eid="JAS 3:13"/><verse number="14" style="v" sid="JAS 3:14"/>ನಿಮ್ಮ ಹೃದಯದೊಳಗೆ ಕಹಿಯಾದ ಹಗೆತನವನ್ನೂ ಸ್ವಾರ್ಥ ಉದ್ದೇಶವನ್ನು ಕೂಡಿಟ್ಟು ಕೊಂಡಿರುವಲ್ಲಿ, ನೀವು ಜ್ಞಾನದ ಕುರಿತು ಹೊಗಳಿಕೊಳ್ಳಬೇಡಿರಿ ಮತ್ತು ಸತ್ಯವನ್ನು ನಿರಾಕರಿಸಬೇಡಿರಿ. <verse eid="JAS 3:14"/><verse number="15" style="v" sid="JAS 3:15"/>ಅಂಥ ಜ್ಞಾನವು ದೈವಿಕ ಜ್ಞಾನವಲ್ಲ. ಅದು ಭೂಸಂಬಂಧವಾದದ್ದು. ಅದು ಆತ್ಮಿಕವಾದದ್ದಲ್ಲ. ಅದು ದೆವ್ವಗಳಿಗೆ ಸಂಬಂಧಪಟ್ಟದ್ದು. <verse eid="JAS 3:15"/><verse number="16" style="v" sid="JAS 3:16"/>ಏಕೆಂದರೆ ನಿಮ್ಮಲ್ಲಿ ಹೊಟ್ಟೆಕಿಚ್ಚೂ ಸ್ವಾರ್ಥ ಉದ್ದೇಶವೂ ಇರುವಲ್ಲಿ ಗಲಿಬಿಲಿಯೂ ಸಕಲ ವಿಧವಾದ ಕೆಟ್ಟ ಅಭ್ಯಾಸವೂ ಇರುತ್ತವೆ.<verse eid="JAS 3:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="JAS 3:17"/>ಆದರೆ ಸ್ವರ್ಗೀಯ ಜ್ಞಾನವು ಮೊದಲು ನಿರ್ಮಲವಾದದ್ದು, ಆಮೇಲೆ ಸಮಾಧಾನಕರವಾದದ್ದು, ವಿನಯವುಳ್ಳದ್ದು, ಅಧೀನವಾದದ್ದು, ಕರುಣೆಯಿಂದ ತುಂಬಿದ್ದು ಒಳ್ಳೆಯ ಫಲವನ್ನು ಕೊಡುವಂಥದ್ದು ಆಗಿದೆ. ಅದರಲ್ಲಿ ಪಕ್ಷಪಾತವೂ ಕಪಟವೂ ಇಲ್ಲ. <verse eid="JAS 3:17"/><verse number="18" style="v" sid="JAS 3:18"/>ಸಮಾಧಾನ ಪಡಿಸುವವರು ಸಮಾಧಾನವೆಂಬ ಬೀಜವನ್ನು ಬಿತ್ತಿ ನೀತಿಯೆಂಬ ಫಲವನ್ನು ಕೊಯ್ಯುತ್ತಾರೆ.<verse eid="JAS 3:18"/></para>
  <chapter eid="JAS 3"/>
  <chapter number="4" style="c" sid="JAS 4"/>
  <para style="s1">ದೇವರಿಗೆ ಅಧೀನರಾಗಿರಿ</para>
  <para style="p">
    <verse number="1" style="v" sid="JAS 4:1"/>ನಿಮ್ಮಲ್ಲಿ ಯುದ್ಧಗಳೂ ಕಾದಾಟಗಳೂ ಬರಲು ಕಾರಣಗಳೇನು? ನಿಮ್ಮಲ್ಲಿ ಹೋರಾಡುವ ದುರಾಶೆಗಳಿಂದ ಅಲ್ಲವೇ? <verse eid="JAS 4:1"/><verse number="2" style="v" sid="JAS 4:2"/>ನೀವು ಬಯಸಿದರೂ ಪಡೆಯದೆ ಇದ್ದುದರಿಂದ ನೀವು ಕೊಲ್ಲುತ್ತೀರಿ. ದುರಾಶೆಯಿಂದ ಅಪೇಕ್ಷಿಸುತ್ತೀರಿ, ಆದರೆ ಪಡೆಯಲಾರಿರಿ. ನೀವು ಕಾದಾಡುತ್ತೀರಿ ಮತ್ತು ಯುದ್ಧ ಮಾಡುತ್ತೀರಿ, ಆದರೂ ನೀವು ದೇವರನ್ನು ಬೇಡಿಕೊಳ್ಳದ ಕಾರಣ ನಿಮಗೇನೂ ದೊರೆಯಲಿಲ್ಲ. <verse eid="JAS 4:2"/><verse number="3" style="v" sid="JAS 4:3"/>ನೀವು ಬೇಡಿದರೂ ಬೇಡಿದ್ದನ್ನು ಪಡೆದುಕೊಳ್ಳುವುದಿಲ್ಲ. ಏಕೆಂದರೆ, ನಿಮ್ಮ ಭೋಗಗಳಿಗಾಗಿ ಉಪಯೋಗಿಸಬೇಕೆಂದು ದುರುದ್ದೇಶಕ್ಕಾಗಿ ಬೇಡಿಕೊಳ್ಳುವುದರಿಂದ ನಿಮಗೆ ದೊರೆಯುವುದಿಲ್ಲ.<verse eid="JAS 4:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="JAS 4:4"/>ವ್ಯಭಿಚಾರಿಗಳೇ, ಇಹಲೋಕ ಸ್ನೇಹವು ದೇವರೊಂದಿಗಿರುವ ಶತ್ರುತ್ವ ಎಂದು ನಿಮಗೆ ತಿಳಿಯದೋ? ಲೋಕಕ್ಕೆ ಸ್ನೇಹಿತನಾಗಿರಬೇಕೆಂಬುವವನು ದೇವರಿಗೆ ಶತ್ರುವಾಗಿದ್ದಾನೆ. <verse eid="JAS 4:4"/><verse number="5" style="v" sid="JAS 4:5"/>ಅಥವಾ ದೇವರು ನಮ್ಮಲ್ಲಿ ವಾಸವಾಗಿರಲು ನಮಗೆ ಕೊಟ್ಟಿರುವ ಪವಿತ್ರಾತ್ಮ ದೇವರು, ನಾವು ಅವರಿಗೆ ಮಾತ್ರ ಸೇರಿದವರಾಗಿರಬೇಕೆಂದು ಬಲವಾದ ಬಯಕೆ ಉಳ್ಳವರಾಗಿದ್ದಾರೆಂದು ಪವಿತ್ರ ವೇದವು ವ್ಯರ್ಥವಾಗಿ ಹೇಳುತ್ತದೆ ಎಂದು ನೀವು ಭಾವಿಸುತ್ತೀರೋ? <verse eid="JAS 4:5"/><verse number="6" style="v" sid="JAS 4:6"/>ಆದರೆ ದೇವರು ನಮಗೆ ಹೆಚ್ಚಾದ ಕೃಪೆಯನ್ನು ಕೊಡುತ್ತಾರೆ. ಆದ್ದರಿಂದ ಈ ಕಾರಣಕ್ಕಾಗಿ, ಪವಿತ್ರ ವೇದವು:</para>
  <para style="q1" vid="JAS 4:6">“ದೇವರು ಅಹಂಕಾರಿಗಳನ್ನು ಎದುರಿಸುತ್ತಾರೆ.</para>
  <para style="q2" vid="JAS 4:6">ದೀನರಿಗಾದರೋ ಕೃಪೆಯನ್ನು ಕೊಡುತ್ತಾರೆ,”<note caller="+" style="f"><char style="fr" closed="false">4:6 </char><char style="ft" closed="false"><char style="xt"><ref loc="PRO 3:34">ಜ್ಞಾನೋಕ್ತಿ 3:34</ref></char></char></note></para>
  <para style="m" vid="JAS 4:6">ಎಂದು ಹೇಳುತ್ತದೆ.<verse eid="JAS 4:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="JAS 4:7"/>ಹೀಗಿರಲಾಗಿ ದೇವರಿಗೆ ಅಧೀನವಾಗಿರಿ. ಸೈತಾನನನ್ನು ಎದುರಿಸಿರಿ, ಆಗ ಅವನು ನಿಮ್ಮನ್ನು ಬಿಟ್ಟು ಓಡಿಹೋಗುವನು. <verse eid="JAS 4:7"/><verse number="8" style="v" sid="JAS 4:8"/>ದೇವರ ಸಮೀಪಕ್ಕೆ ಬನ್ನಿರಿ. ಆಗ ನಿಮ್ಮ ಸಮೀಪಕ್ಕೆ ದೇವರು ಬರುವರು. ಪಾಪಿಗಳೇ, ನಿಮ್ಮ ಕೈಗಳನ್ನು ಶುಚಿಮಾಡಿಕೊಳ್ಳಿರಿ. ಎರಡು ಮನಸ್ಸುಳ್ಳವರೇ, ನಿಮ್ಮ ಹೃದಯಗಳನ್ನು ನಿರ್ಮಲ ಮಾಡಿಕೊಳ್ಳಿರಿ. <verse eid="JAS 4:8"/><verse number="9" style="v" sid="JAS 4:9"/>ದುಃಖಿಸಿರಿ, ಗೋಳಾಡಿರಿ, ಕಣ್ಣೀರಿಡಿರಿ, ನಿಮ್ಮ ನಗೆಯು ದುಃಖಕ್ಕೂ ನಿಮ್ಮ ಸಂತೋಷವು ವ್ಯಥೆಗೂ ತಿರುಗಿಕೊಳ್ಳಲಿ. <verse eid="JAS 4:9"/><verse number="10" style="v" sid="JAS 4:10"/>ಕರ್ತದೇವರ ಮುಂದೆ ನಿಮ್ಮನ್ನು ತಗ್ಗಿಸಿಕೊಳ್ಳಿರಿ. ಆಗ ಅವರು ನಿಮ್ಮನ್ನು ಮೇಲಕ್ಕೆತ್ತುವರು.<verse eid="JAS 4:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="JAS 4:11"/>ಪ್ರಿಯರೇ, ಒಬ್ಬರ ವಿಷಯದಲ್ಲಿ ಒಬ್ಬರು ಕೆಟ್ಟದ್ದನ್ನು ಮಾತನಾಡಬೇಡಿರಿ. ಯಾವನಾದರೂ ತನ್ನ ಸಹೋದರನ ವಿಷಯದಲ್ಲಿ ಕೆಟ್ಟದ್ದಾಗಿ ಮಾತನಾಡಿದರೆ ಅಥವಾ ತೀರ್ಪುಮಾಡಿದರೆ ಅವನು ದೇವರ ನಿಯಮದ ವಿಷಯದಲ್ಲಿ ಕೆಟ್ಟದ್ದಾಗಿ ಮಾತನಾಡಿ, ನಿಯಮವನ್ನೇ ತೀರ್ಪುಮಾಡಿದ ಹಾಗಾಗುವುದು. ಆದರೆ ನೀನು ದೇವರ ನಿಯಮವನ್ನೇ ತೀರ್ಪುಮಾಡಿದರೆ ನೀನು ಅನುಸರಿಸುವವನಾಗಿರದೆ ನ್ಯಾಯಾಧಿಪತಿಯೆನಿಸಿಕೊಳ್ಳುವಿ. <verse eid="JAS 4:11"/><verse number="12" style="v" sid="JAS 4:12"/>ನಿಯಮವನ್ನು ಕೊಟ್ಟವರೂ ನ್ಯಾಯಾಧಿಪತಿಯೂ ದೇವರೊಬ್ಬರೇ ಆಗಿರುತ್ತಾರೆ. ಅವರು ಉಳಿಸುವುದಕ್ಕೂ ನಾಶಮಾಡುವುದಕ್ಕೂ ಶಕ್ತರಾಗಿದ್ದಾರೆ. ಹೀಗಿರುವಾಗ ನೆರೆಯವನ ವಿಷಯದಲ್ಲಿ ತೀರ್ಪುಮಾಡುವುದಕ್ಕೆ ನೀನು ಯಾರು?<verse eid="JAS 4:12"/></para>
  <para style="s1">ನಾಳೆಯನ್ನು ಕುರಿತು ಕೊಚ್ಚಿಕೊಳ್ಳುವುದು</para>
  <para style="p">
    <verse number="13" style="v" sid="JAS 4:13"/>“ಈ ಹೊತ್ತು ಇಲ್ಲವೆ ನಾಳೆ ನಾವು ಇಂಥ ಪಟ್ಟಣಕ್ಕೆ ಹೋಗಿ ಅಲ್ಲಿ ಒಂದು ವರ್ಷವಿದ್ದು, ವ್ಯಾಪಾರವನ್ನು ಮಾಡಿ ಲಾಭವನ್ನು ಸಂಪಾದಿಸುತ್ತೇವೆ,” ಎನ್ನುವವರೇ ಕೇಳಿರಿ. <verse eid="JAS 4:13"/><verse number="14" style="v" sid="JAS 4:14"/>ನಾಳೆ ಏನಾಗುವುದೋ ನಿಮಗೆ ತಿಳಿಯದು. ನಿಮ್ಮ ಜೀವಮಾನವು ಎಂಥದ್ದು? ಅದು ಸ್ವಲ್ಪ ಹೊತ್ತು ಕಾಣಿಸಿಕೊಂಡು ಆಮೇಲೆ ಕಾಣದೆ ಹೋಗುವ ಹಬೆಯಂತಿದೆ. <verse eid="JAS 4:14"/><verse number="15" style="v" sid="JAS 4:15"/>ಆದ್ದರಿಂದ, “ಕರ್ತದೇವರ ಚಿತ್ತವಾದರೆ ನಾವು ಬದುಕಿ ಈ ಕೆಲಸವನ್ನಾಗಲಿ, ಆ ಕೆಲಸವನ್ನಾಗಲಿ ಮಾಡುವೆವು!” ಎಂದು ನೀವು ಹೇಳುವುದೇ ಸರಿ. <verse eid="JAS 4:15"/><verse number="16" style="v" sid="JAS 4:16"/>ಆದರೆ ನೀವು ನಿಮ್ಮ ಹೊಗಳಿಕೆಯ ಯೋಜನೆಗಳಲ್ಲಿ ಹೆಮ್ಮೆಪಡುತ್ತೀರಿ. ಅಂಥಾ ಅಹಂಭಾವವೆಲ್ಲಾ ಕೆಟ್ಟದ್ದೆ. <verse eid="JAS 4:16"/><verse number="17" style="v" sid="JAS 4:17"/>ಹೀಗಿರುವುದರಿಂದ ಒಳ್ಳೆಯದನ್ನು ಮಾಡಬೇಕೆಂದು ತಿಳಿದು ಅದನ್ನು ಮಾಡದೆ ಇರುವವನಿಗೆ ಅದು ಪಾಪವಾಗಿದೆ.<verse eid="JAS 4:17"/></para>
  <chapter eid="JAS 4"/>
  <chapter number="5" style="c" sid="JAS 5"/>
  <para style="s1">ಐಶ್ವರ್ಯವಂತರನ್ನು ಖಂಡಿಸುವುದು</para>
  <para style="p">
    <verse number="1" style="v" sid="JAS 5:1"/>ಧನಿಕರೇ, ನಿಮಗೆ ಬರುವ ಸಂಕಟಗಳಿಗಾಗಿ ಕಣ್ಣೀರಿಡಿರಿ, ಗೋಳಾಡಿರಿ. <verse eid="JAS 5:1"/><verse number="2" style="v" sid="JAS 5:2"/>ನಿಮ್ಮ ಐಶ್ವರ್ಯವು ನಾಶವಾಗಿದೆ. ನಿಮ್ಮ ಬಟ್ಟೆಗಳಿಗೆ ನುಸಿಹಿಡಿದಿದೆ. <verse eid="JAS 5:2"/><verse number="3" style="v" sid="JAS 5:3"/>ನಿಮ್ಮ ಚಿನ್ನ ಬೆಳ್ಳಿಗಳು ತುಕ್ಕು ಹಿಡಿದಿವೆ. ಅವುಗಳ ತುಕ್ಕು ನಿಮಗೆ ವಿರೋಧವಾಗಿ ಸಾಕ್ಷಿಯಾಗಿದ್ದು ಬೆಂಕಿಯಂತೆ ನಿಮ್ಮ ಮಾಂಸವನ್ನು ತಿಂದುಬಿಡುವುದು. ಕಡೇ ದಿನಗಳಿಗಾಗಿ ಸಂಪತ್ತನ್ನು ಕೂಡಿಸಿ ಇಟ್ಟುಕೊಂಡಿದ್ದೀರಿ. <verse eid="JAS 5:3"/><verse number="4" style="v" sid="JAS 5:4"/>ಇಗೋ ನಿಮ್ಮ ಹೊಲಗಳನ್ನು ಕೊಯಿದವರ ಕೂಲಿಯನ್ನು ನೀವು ಅನ್ಯಾಯವಾಗಿ ಹಿಡಿದುಕೊಂಡಿದ್ದೀರಿ. ಆ ಕೂಲಿ ಕೂಗಿಕೊಳ್ಳುತ್ತದೆ. ಕೊಯಿದವರ ಕೂಗು ಸೈನ್ಯಗಳ ಅಧಿಪತಿ ಆಗಿರುವ ಕರ್ತದೇವರ ಕಿವಿಗಳಲ್ಲಿ ಬಿದ್ದಿದೆ. <verse eid="JAS 5:4"/><verse number="5" style="v" sid="JAS 5:5"/>ಭೂಲೋಕದಲ್ಲಿ ನೀವು ಭೋಗಿಗಳಾಗಿ ಮನಸ್ಸಿಗೆ ಬಂದಂತೆ ಜೀವಿಸಿದ್ದೀರಿ. ವಧೆಯ ದಿವಸಕ್ಕಾಗಿಯೋ ಎಂಬಂತೆ ನಿಮ್ಮ ಹೃದಯಗಳನ್ನು ಪೋಷಿಸಿಕೊಂಡಿದ್ದೀರಿ. <verse eid="JAS 5:5"/><verse number="6" style="v" sid="JAS 5:6"/>ನಿಮ್ಮನ್ನು ವಿರೋಧ ಮಾಡದ ನಿರ್ದೋಷಿಗೆ ದಂಡನೆಯನ್ನು ವಿಧಿಸಿ, ಕೊಂದುಹಾಕಿದ್ದೀರಿ.<verse eid="JAS 5:6"/></para>
  <para style="s1">ತಾಳ್ಮೆಯ ಅವಶ್ಯಕತೆ</para>
  <para style="p">
    <verse number="7" style="v" sid="JAS 5:7"/>ಪ್ರಿಯರೇ, ಕರ್ತ ಯೇಸು ಬರುವ ತನಕ ದೀರ್ಘಶಾಂತಿಯಿಂದಿರಿ. ವ್ಯವಸಾಯಗಾರನನ್ನು ನೋಡಿರಿ. ಅವನು ಭೂಮಿಯ ಅಮೂಲ್ಯವಾದ ಫಲಕ್ಕಾಗಿ ಕಾದಿದ್ದು ಮುಂಗಾರು ಹಿಂಗಾರು ಮಳೆಗಳು ಬರುವ ತನಕ ದೀರ್ಘಶಾಂತಿಯಿಂದಿರುವನು. <verse eid="JAS 5:7"/><verse number="8" style="v" sid="JAS 5:8"/>ನೀವೂ ದೀರ್ಘಶಾಂತಿಯಿಂದಿರಿ. ನಿಮ್ಮ ಹೃದಯಗಳನ್ನು ದೃಢಪಡಿಸಿಕೊಳ್ಳಿರಿ. ಏಕೆಂದರೆ ಕರ್ತ ಯೇಸುವಿನ ಪುನರಾಗಮನ ಹತ್ತಿರವಾಯಿತು. <verse eid="JAS 5:8"/><verse number="9" style="v" sid="JAS 5:9"/>ಪ್ರಿಯರೇ, ನೀವು ಒಬ್ಬರ ಮೇಲೊಬ್ಬರು ಗೊಣಗುಟ್ಟಬೇಡಿರಿ. ನ್ಯಾಯವಿಚಾರಣೆಗೆ ಗುರಿಯಾದೀರಿ. ಅಗೋ, ನ್ಯಾಯಾಧಿಪತಿಯು ಬಾಗಿಲಿನ ಮುಂದೆಯೇ ನಿಂತಿದ್ದಾರೆ.<verse eid="JAS 5:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="JAS 5:10"/>ನನ್ನ ಪ್ರಿಯರೇ, ಕರ್ತದೇವರ ಹೆಸರಿನಲ್ಲಿ ಮಾತನಾಡಿದ ಪ್ರವಾದಿಗಳನ್ನೇ ಬಾಧೆಯನ್ನು ತಾಳ್ಮೆಯಿಂದ ಸಹಿಸಿಕೊಳ್ಳುವ ವಿಷಯವಾಗಿ ಆದರ್ಶವಾಗಿ ಇಟ್ಟುಕೊಳ್ಳಿರಿ. <verse eid="JAS 5:10"/><verse number="11" style="v" sid="JAS 5:11"/>ಇಗೋ, ತಾಳಿದವನು ಬಾಳಿಯಾನು ಎಂದು ಹೇಳುತ್ತೇವಲ್ಲವೇ? ನೀವು ಯೋಬನಲ್ಲಿದ್ದ ತಾಳ್ಮೆಯ ವಿಷಯವಾಗಿ ಕೇಳಿ, ಕರ್ತದೇವರು ಅವನಿಗೆ ಅಂತ್ಯದಲ್ಲಿ ಮಾಡಿದ್ದನ್ನು ತಿಳಿದು, ಕರ್ತದೇವರು ಬಹಳ ಒಳ್ಳೆಯವರೂ ದಯಾಳುವೂ ಆಗಿದ್ದಾರೆಂದು ತಿಳಿದಿದ್ದೀರಷ್ಟೆ.<verse eid="JAS 5:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="JAS 5:12"/>ಮುಖ್ಯವಾಗಿ ನನ್ನ ಪ್ರಿಯರೇ, ಆಕಾಶದ ಮೇಲಾಗಲಿ, ಭೂಮಿಯ ಮೇಲಾಗಲಿ, ಇನ್ನಾವುದರ ಮೇಲಾಗಲಿ ಆಣೆ ಇಡಬೇಡಿರಿ. ಹೌದೆಂದು ಹೇಳಬೇಕಾದರೆ “ಹೌದು” ಎನ್ನಿರಿ. ಇಲ್ಲವಾದರೆ “ಇಲ್ಲ” ಎನ್ನಿರಿ. ಹೀಗಾದರೆ ನೀವು ನ್ಯಾಯವಿಚಾರಣೆಗೆ ಗುರಿಯಾಗುವುದಿಲ್ಲ.<verse eid="JAS 5:12"/></para>
  <para style="s1">ಪ್ರಾರ್ಥನೆಯ ಶಕ್ತಿ</para>
  <para style="p">
    <verse number="13" style="v" sid="JAS 5:13"/>ನಿಮ್ಮಲ್ಲಿ ಯಾವನಾದರೂ ಬಾಧೆಪಡುವವನು ಇದ್ದಾನೋ? ಅವನು ಪ್ರಾರ್ಥಿಸಲಿ. ನಿಮ್ಮಲ್ಲಿ ಯಾವನಾದರೂ ಸಂತೋಷ ಪಡುವವನಿದ್ದಾನೋ? ಅವನು ಕೀರ್ತನೆಗಳನ್ನು ಹಾಡಲಿ. <verse eid="JAS 5:13"/><verse number="14" style="v" sid="JAS 5:14"/>ನಿಮ್ಮಲ್ಲಿ ಯಾವನಾದರೂ ಅಸ್ವಸ್ಥನಾಗಿರುವವನು ಇದ್ದಾನೋ? ಅವನು ಸಭೆಯ ಹಿರಿಯನನ್ನು ಕರೆಕಳುಹಿಸಲಿ. ಅವರು ಕರ್ತ ಯೇಸುವಿನ ಹೆಸರಿನಿಂದ ಎಣ್ಣೆ ಹಚ್ಚಿ ಅವನಿಗೋಸ್ಕರ ಪ್ರಾರ್ಥಿಸಲಿ. <verse eid="JAS 5:14"/><verse number="15" style="v" sid="JAS 5:15"/>ನಂಬಿಕೆಯಿಂದ ಮಾಡಿದ ಪ್ರಾರ್ಥನೆಯು ರೋಗಿಯನ್ನು ಗುಣಪಡಿಸುತ್ತದೆ. ಕರ್ತ ಯೇಸು ಅವನನ್ನು ಎಬ್ಬಿಸುವರು. ಪಾಪಗಳನ್ನು ಮಾಡಿದವನಾಗಿದ್ದರೆ ಅವನು ಕ್ಷಮೆಯನ್ನು ಪಡೆಯುತ್ತಾನೆ. <verse eid="JAS 5:15"/><verse number="16" style="v" sid="JAS 5:16"/>ನೀವು ಸ್ವಸ್ಥವಾಗಬೇಕಾದರೆ, ನಿಮ್ಮ ಪಾಪಗಳನ್ನು ಒಬ್ಬರಿಗೊಬ್ಬರು, ಅರಿಕೆಮಾಡಿ, ಒಬ್ಬರಿಗೋಸ್ಕರ ಒಬ್ಬರು ಪ್ರಾರ್ಥಿಸಿರಿ. ನೀತಿವಂತನ ಪ್ರಾರ್ಥನೆಯು ಶಕ್ತಿಯುತವೂ ಪರಿಣಾಮಕಾರಿಯೂ ಆಗಿರುತ್ತದೆ.<verse eid="JAS 5:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="JAS 5:17"/>ಎಲೀಯನು ನಮ್ಮಂಥ ಮಾನವ ಸ್ವಭಾವವುಳ್ಳವನಾಗಿದ್ದನು. ಅವನು ಮಳೆ ಬರಬಾರದೆಂದು ಆಸಕ್ತಿಯಿಂದ ಪ್ರಾರ್ಥಿಸಲು, ಮೂರು ವರ್ಷ ಆರು ತಿಂಗಳವರೆಗೂ ಭೂಮಿಯ ಮೇಲೆ ಮಳೆ ಬೀಳಲಿಲ್ಲ. <verse eid="JAS 5:17"/><verse number="18" style="v" sid="JAS 5:18"/>ತಿರುಗಿ ಅವನು ಪ್ರಾರ್ಥನೆಮಾಡಲು ಆಕಾಶವು ಮಳೆಗರೆಯಿತು, ಭೂಮಿಯು ಫಲಿಸಿತು.<verse eid="JAS 5:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="JAS 5:19"/>ಪ್ರಿಯರೇ, ನಿಮ್ಮಲ್ಲಿ ಯಾವನಾದರೂ ಸತ್ಯದಿಂದ ತಪ್ಪಿಹೋಗಿರಲಾಗಿ ಮತ್ತೊಬ್ಬನು ಅವನನ್ನು ಯಥಾಸ್ಥಾನಕ್ಕೆ ತಂದರೆ, <verse eid="JAS 5:19"/><verse number="20" style="v" sid="JAS 5:20"/>ಅವನು ಆ ಪಾಪ ಮಾಡಿದವನನ್ನು ತಪ್ಪಾದ ಮಾರ್ಗದಿಂದ ತಿರುಗಿಸಿದ್ದಲ್ಲದೆ, ಅವನ ಆತ್ಮವನ್ನು ಮರಣದಿಂದಲೂ ತಪ್ಪಿಸಿ, ಬಹು ಪಾಪಗಳನ್ನು ಮುಚ್ಚಿದವನಾದನೆಂದು ತಿಳಿದುಕೊಳ್ಳಲಿ.<verse eid="JAS 5:20"/></para>
  <chapter eid="JAS 5"/>
</usx>
