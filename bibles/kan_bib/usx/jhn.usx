<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="JHN" style="id">- Biblica® Open Kannada Contemporary Version</book>
  <para style="h">ಯೋಹಾನ</para>
  <para style="toc1">ಯೋಹಾನನು ಬರೆದ ಸುವಾರ್ತೆ</para>
  <para style="toc2">ಯೋಹಾನ</para>
  <para style="toc3">ಯೋಹಾನ</para>
  <para style="mt1">ಯೋಹಾನನು</para>
  <para style="mt2">ಬರೆದ ಸುವಾರ್ತೆ</para>
  <chapter number="1" style="c" sid="JHN 1"/>
  <para style="s1">ವಾಕ್ಯವು ದೇಹಧಾರಿಯಾದದ್ದು</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 1:1"/>ಆದಿಯಲ್ಲಿ ವಾಕ್ಯವಿತ್ತು, ಆ ವಾಕ್ಯವು ದೇವರ ಬಳಿಯಲ್ಲಿತ್ತು, ಆ ವಾಕ್ಯವು ದೇವರಾಗಿತ್ತು. <verse eid="JHN 1:1"/><verse number="2" style="v" sid="JHN 1:2"/>ಆ ವಾಕ್ಯವೆಂಬುವವರು ಆದಿಯಲ್ಲಿ ದೇವರ ಬಳಿಯಲ್ಲಿದ್ದರು. <verse eid="JHN 1:2"/><verse number="3" style="v" sid="JHN 1:3"/>ಆ ವಾಕ್ಯವೆಂಬುವವರ ಮೂಲಕವಾಗಿಯೇ ಸಮಸ್ತವೂ ಸೃಷ್ಟಿಯಾಯಿತು. ಸೃಷ್ಟಿಯಾದವುಗಳಲ್ಲಿ ಯಾವುದೂ ಅವರಿಲ್ಲದೆ ಸೃಷ್ಟಿಯಾಗಲಿಲ್ಲ. <verse eid="JHN 1:3"/><verse number="4" style="v" sid="JHN 1:4"/>ಅವರಲ್ಲಿ ಜೀವವಿತ್ತು. ಆ ಜೀವವು ಮಾನವರಿಗೆ ಬೆಳಕಾಗಿತ್ತು. <verse eid="JHN 1:4"/><verse number="5" style="v" sid="JHN 1:5"/>ಆ ಬೆಳಕು ಕತ್ತಲಲ್ಲಿ ಪ್ರಕಾಶಿಸುತ್ತದೆ. ಕತ್ತಲೆಯು ಆ ಬೆಳಕನ್ನು ಅಡಗಿಸಲಿಲ್ಲ.<verse eid="JHN 1:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="JHN 1:6"/>ದೇವರು ಕಳುಹಿಸಿದ ಒಬ್ಬ ಮನುಷ್ಯನಿದ್ದನು. ಅವನ ಹೆಸರು ಯೋಹಾನನು. <verse eid="JHN 1:6"/><verse number="7" style="v" sid="JHN 1:7"/>ತನ್ನ ಮೂಲಕ ಎಲ್ಲರು ವಿಶ್ವಾಸವಿಡುವಂತೆ ಅವನು ಆ ಬೆಳಕಿನ ವಿಷಯದಲ್ಲಿ ಸಾಕ್ಷಿ ಕೊಡಲು ಯೋಹಾನನು ಸಾಕ್ಷಿಯಾಗಿ ಬಂದನು. <verse eid="JHN 1:7"/><verse number="8" style="v" sid="JHN 1:8"/>ಅವನೇ ಆ ಬೆಳಕಾಗಿರಲಿಲ್ಲ. ಆ ಬೆಳಕಿನ ವಿಷಯದಲ್ಲಿ ಸಾಕ್ಷಿಯಾಗಿ ಬಂದನಷ್ಟೇ.<verse eid="JHN 1:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="JHN 1:9"/>ನಿಜ ಬೆಳಕು ಲೋಕಕ್ಕೆ ಬರುವುದಾಗಿತ್ತು. ಆ ಬೆಳಕೇ ಪ್ರತಿ ಮಾನವನಿಗೂ ಬೆಳಕನ್ನು ನೀಡುವುದಾಗಿತ್ತು. <verse eid="JHN 1:9"/><verse number="10" style="v" sid="JHN 1:10"/>ಆ ವಾಕ್ಯವೆಂಬುವವರು ಲೋಕದಲ್ಲಿದ್ದರು ಮತ್ತು ಲೋಕವು ಅವರ ಮೂಲಕ ಉಂಟಾಯಿತು. ಆದರೂ ಲೋಕವು ಅವರ ಗುರುತು ಹಿಡಿಯಲಿಲ್ಲ. <verse eid="JHN 1:10"/><verse number="11" style="v" sid="JHN 1:11"/>ಅವರು ತಮ್ಮ ಸ್ವಜನರ ಬಳಿಗೆ ಬಂದರು. ಆದರೆ ಸ್ವಜನರೇ ಅವರನ್ನು ಸ್ವೀಕರಿಸಲಿಲ್ಲ. <verse eid="JHN 1:11"/><verse number="12" style="v" sid="JHN 1:12"/>ಆದರೂ ಯಾರಾರು ಅವರನ್ನು ಸ್ವೀಕರಿಸಿದರೋ, ಅಂದರೆ ಅವರ ಹೆಸರಿನಲ್ಲಿ ವಿಶ್ವಾಸವಿಟ್ಟರೋ ಅವರೆಲ್ಲರಿಗೆ ದೇವರ ಮಕ್ಕಳಾಗುವ ಅಧಿಕಾರವನ್ನು ಕೊಟ್ಟರು. <verse eid="JHN 1:12"/><verse number="13" style="v" sid="JHN 1:13"/>ಇವರು ರಕ್ತಸಂಬಂಧದಿಂದಾಗಲಿ, ದೈಹಿಕ ಇಚ್ಛೆಯಿಂದಾಗಲಿ, ಪುರುಷನ ಇಚ್ಛೆಯಿಂದಾಗಲಿ ಹುಟ್ಟಿದವರಲ್ಲ, ದೇವರಿಂದಲೇ ಹುಟ್ಟಿದವರು.<verse eid="JHN 1:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="JHN 1:14"/>ವಾಕ್ಯವೆಂಬುವವರು ದೇಹಧಾರಿಯಾಗಿ ನಮ್ಮ ಮಧ್ಯದಲ್ಲಿ ವಾಸಿಸಿದರು. ನಾವು ಅವರ ಮಹಿಮೆಯನ್ನು ಕಂಡೆವು. ಆ ಮಹಿಮೆಯು ತಂದೆಯಿಂದ ಬಂದ ಏಕೈಕ ಪುತ್ರ ಆಗಿರುವವರಿಗೆ ಇರತಕ್ಕ ಮಹಿಮೆ. ಆ ವಾಕ್ಯವೆಂಬುವವರು ಕೃಪೆಯಿಂದಲೂ ಸತ್ಯದಿಂದಲೂ ತುಂಬಿದವರಾಗಿದ್ದರು.<verse eid="JHN 1:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="JHN 1:15"/>“ಅವರನ್ನು ಕುರಿತು ಯೋಹಾನನು ಸಾಕ್ಷಿ ಕೊಡುತ್ತಾ, ‘ನನ್ನ ಬಳಿಕ ಬರುವವರು ನನಗಿಂತ ಮೊದಲೇ ಇದ್ದುದರಿಂದ ಅವರು ನನಗಿಂತಲೂ ಶ್ರೇಷ್ಠರು’ ಎಂದು ನಾನು ಹೇಳಿದವರು ಇವರೇ,” ಎಂದು ಘೋಷಿಸಿದನು. <verse eid="JHN 1:15"/><verse number="16" style="v" sid="JHN 1:16"/>ಅವರ ಪರಿಪೂರ್ಣತೆಯಿಂದ ನಾವೆಲ್ಲರೂ ಕೃಪೆಯ ಮೇಲೆ ಕೃಪೆಯನ್ನು ಪಡೆದೆವು. <verse eid="JHN 1:16"/><verse number="17" style="v" sid="JHN 1:17"/>ಏಕೆಂದರೆ ನಿಯಮವು ಮೋಶೆಯ ಮೂಲಕ ಕೊಡಲಾಯಿತು. ಕೃಪೆಯೂ ಸತ್ಯವೂ ಕ್ರಿಸ್ತ ಯೇಸುವಿನ ಮೂಲಕ ಬಂದವು. <verse eid="JHN 1:17"/><verse number="18" style="v" sid="JHN 1:18"/>ದೇವರನ್ನು ಯಾರೂ ಎಂದೂ ಕಂಡಿಲ್ಲ; ತಂದೆ ದೇವರ ಹೃದಯಕ್ಕೆ ಹತ್ತಿರವಾಗಿರುವ ಏಕೈಕ ಪುತ್ರ ಆಗಿರುವವರೂ ಸ್ವತಃ ದೇವರೂ ಆಗಿರುವವರೂ ತಂದೆಯನ್ನು ಪ್ರಕಟಪಡಿಸಿದ್ದಾರೆ.<verse eid="JHN 1:18"/></para>
  <para style="s1">ಸ್ನಾನಿಕ ಯೋಹಾನನು ತಾನು ಕ್ರಿಸ್ತ ಅಲ್ಲ ಎಂದು ಪ್ರಕಟಿಸುವುದು</para>
  <para style="p">
    <verse number="19" style="v" sid="JHN 1:19"/>ಯೆರೂಸಲೇಮಿನ ಯೆಹೂದ್ಯ ನಾಯಕರು, ಯಾಜಕರನ್ನು ಮತ್ತು ಲೇವಿಯರನ್ನು ಯೋಹಾನನ ಬಳಿಗೆ ಕಳುಹಿಸಿ, “ನೀನು ಯಾರು?” ಎಂದು ಕೇಳಿದರು. <verse eid="JHN 1:19"/><verse number="20" style="v" sid="JHN 1:20"/>ಅದಕ್ಕೆ ಯೋಹಾನನು, “ನಾನು ಕ್ರಿಸ್ತನಲ್ಲ” ಎಂದು ಅರಿಕೆಮಾಡಿ ಸಾಕ್ಷಿಕೊಟ್ಟನು.<verse eid="JHN 1:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="JHN 1:21"/>ಅದಕ್ಕೆ ಅವರು, “ಹಾಗಾದರೆ ನೀನು ಎಲೀಯನೋ?” ಎಂದು ಕೇಳಿದರು.</para>
  <para style="p" vid="JHN 1:21">ಅದಕ್ಕೆ ಅವನು, “ನಾನು ಎಲೀಯನಲ್ಲ.”</para>
  <para style="p" vid="JHN 1:21">“ನೀನು ಆ ಪ್ರವಾದಿಯೋ?” ಎಂದು ಕೇಳಿದರು.</para>
  <para style="p" vid="JHN 1:21">ಅದಕ್ಕೆ ಅವನು, “ಅಲ್ಲ” ಎಂದನು.<verse eid="JHN 1:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 1:22"/>ಅವರು, “ನೀನು ಯಾರು? ನಮ್ಮನ್ನು ಕಳುಹಿಸಿದವರಿಗೆ ನಾವು ಉತ್ತರ ಕೊಡುವಂತೆ ನಿನ್ನ ವಿಷಯವಾಗಿ ನೀನು ಏನು ಹೇಳುತ್ತೀ?” ಎಂದು ಕೇಳಿದರು.<verse eid="JHN 1:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="JHN 1:23"/>ಅದಕ್ಕೆ ಯೋಹಾನನು, “ಪ್ರವಾದಿ ಯೆಶಾಯನು ಹೇಳಿದಂತೆ, ‘ಕರ್ತದೇವರ ಮಾರ್ಗವನ್ನು ಸಿದ್ಧಮಾಡಿರಿ,’ ಎಂದು ಅರಣ್ಯದಲ್ಲಿ ಕೂಗುವ ಸ್ವರವೇ ನಾನು,<note caller="+" style="f"><char style="fr" closed="false">1:23 </char><char style="ft" closed="false"><char style="xt"><ref loc="ISA 40:3">ಯೆಶಾಯ 40:3</ref></char></char></note>” ಎಂದು ಹೇಳಿದನು.<verse eid="JHN 1:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="JHN 1:24"/>ಬಂದಿದ್ದವರು ಫರಿಸಾಯರ ಕಡೆಯವರಾಗಿದ್ದರು. <verse eid="JHN 1:24"/><verse number="25" style="v" sid="JHN 1:25"/>ಅವರು ಯೋಹಾನನಿಗೆ, “ನೀನು ಕ್ರಿಸ್ತ ಇಲ್ಲವೆ ಎಲೀಯನಾಗಲಿ, ಆ ಪ್ರವಾದಿಯಾಗಲಿ ಆಗಿರದಿದ್ದರೆ ನೀನು ದೀಕ್ಷಾಸ್ನಾನ ಕೊಡುವುದೇಕೆ?” ಎಂದು ಪ್ರಶ್ನಿಸಿದರು.<verse eid="JHN 1:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="JHN 1:26"/>ಅದಕ್ಕೆ ಯೋಹಾನನು, “ನಾನು ನೀರಿನಿಂದ ದೀಕ್ಷಾಸ್ನಾನ ಮಾಡಿಸುತ್ತೇನೆ. ಆದರೆ ನೀವು ಅರಿಯದ ಒಬ್ಬ ವ್ಯಕ್ತಿ ನಿಮ್ಮ ನಡುವೆ ಇದ್ದಾರೆ. <verse eid="JHN 1:26"/><verse number="27" style="v" sid="JHN 1:27"/>ಅವರೇ ನನ್ನ ಬಳಿಕ ಬರುವವರು. ಅವರ ಪಾದರಕ್ಷೆಗಳ ದಾರವನ್ನು ಬಿಚ್ಚುವುದಕ್ಕೂ<note caller="+" style="f"><char style="fr" closed="false">1:27 </char><char style="ft" closed="false">ಆ ಕಾಲದಲ್ಲಿ ಈ ಕೆಲಸವನ್ನು ಗುಲಾಮರು ಮಾಡುತ್ತಿದ್ದರು</char></note> ನಾನು ಯೋಗ್ಯನಲ್ಲ,” ಎಂದು ಉತ್ತರಕೊಟ್ಟನು.<verse eid="JHN 1:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="JHN 1:28"/>ಇದೆಲ್ಲಾ ಯೋಹಾನನು ದೀಕ್ಷಾಸ್ನಾನ ಮಾಡಿಸುತ್ತಿದ್ದ ಯೊರ್ದನ್ ನದಿಯ ಆಚೆಕಡೆಯಲ್ಲಿರುವ ಬೇಥಾನ್ಯದಲ್ಲಿ ನಡೆಯಿತು.<verse eid="JHN 1:28"/></para>
  <para style="s1">ಯೋಹಾನನು ಕ್ರಿಸ್ತ ಯೇಸುವಿನ ಬಗ್ಗೆ ಸಾಕ್ಷಿ ಹೇಳಿದ್ದು</para>
  <para style="p">
    <verse number="29" style="v" sid="JHN 1:29"/>ಮರುದಿನ ಯೇಸು ತನ್ನ ಕಡೆಗೆ ಬರುತ್ತಿರುವುದನ್ನು ಯೋಹಾನನು ಕಂಡು, “ಇಗೋ, ಲೋಕದ ಪಾಪವನ್ನು ತೆಗೆದುಹಾಕುವ ದೇವರ ಕುರಿಮರಿ, <verse eid="JHN 1:29"/><verse number="30" style="v" sid="JHN 1:30"/>‘ನನ್ನ ತರುವಾಯ ಬರುವವರು ನನಗಿಂತ ಮೊದಲೇ ಇದ್ದುದರಿಂದ ಅವರು ನನಗಿಂತಲೂ ಶ್ರೇಷ್ಠರು,’ ಎಂದು ನಾನು ಹೇಳಿದವರು ಇವರೇ. <verse eid="JHN 1:30"/><verse number="31" style="v" sid="JHN 1:31"/>ನನಗೂ ಇವರ ಗುರುತಿರಲಿಲ್ಲ. ಆದರೆ ಇವರನ್ನು ಇಸ್ರಾಯೇಲರಿಗೆ ಪ್ರಕಟಪಡಿಸುವುದಕ್ಕೊಸ್ಕರ ನಾನು ನೀರಿನಲ್ಲಿ ದೀಕ್ಷಾಸ್ನಾನ ಮಾಡಿಸುತ್ತಾ ಬಂದೆನು,” ಎಂದು ಹೇಳಿದನು.<verse eid="JHN 1:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="JHN 1:32"/>ಯೋಹಾನನು ಸಾಕ್ಷಿಕೊಟ್ಟು, “ಪವಿತ್ರಾತ್ಮರು ಪರಲೋಕದಿಂದ ಪಾರಿವಾಳದಂತೆ ಇಳಿದುಬಂದು ಯೇಸುವಿನ ಮೇಲೆ ನೆಲೆಗೊಂಡಿರುವುದನ್ನು ನಾನು ಕಂಡೆನು. <verse eid="JHN 1:32"/><verse number="33" style="v" sid="JHN 1:33"/>ನನಗೂ ಅವರ ಗುರುತಿರಲಿಲ್ಲ. ಆದರೆ ನೀರಿನಲ್ಲಿ ದೀಕ್ಷಾಸ್ನಾನ ಮಾಡಿಸಲು ನನ್ನನ್ನು ಕಳುಹಿಸಿದವರು, ‘ಯಾರ ಮೇಲೆ ಪವಿತ್ರಾತ್ಮರು ಇಳಿದುಬಂದು ನೆಲೆಸುವುದನ್ನು ನೀನು ನೋಡುವಿಯೋ ಅವರೇ ಪವಿತ್ರಾತ್ಮರಿಂದ ದೀಕ್ಷಾಸ್ನಾನ ಮಾಡಿಸುವವರು,’ ಎಂದು ತಿಳಿಸಿದರು. <verse eid="JHN 1:33"/><verse number="34" style="v" sid="JHN 1:34"/>ಈಗ ನಾನು ಕಂಡು, ಇವರೇ ದೇವರ ಪುತ್ರರು<note caller="+" style="f"><char style="fr" closed="false">1:34 </char><char style="ft" closed="false">ಕೆಲವು ಪ್ರತಿಗಳಲ್ಲಿ ದೇವರಿಂದ ಆಯ್ಕೆಯಾದವನು ಎಂದಿದೆ.</char></note> ಎಂದು ಸಾಕ್ಷಿ ನೀಡುತ್ತಿದ್ದೇನೆ,” ಎಂದು ಹೇಳಿದನು.<verse eid="JHN 1:34"/></para>
  <para style="s1">ಯೇಸುವಿನ ಪ್ರಥಮ ಶಿಷ್ಯರು</para>
  <para style="p">
    <verse number="35" style="v" sid="JHN 1:35"/>ಮರುದಿನ ಯೋಹಾನನು ಪುನಃ ತನ್ನ ಶಿಷ್ಯರಲ್ಲಿ ಇಬ್ಬರೊಂದಿಗೆ ನಿಂತುಕೊಂಡಿದ್ದನು. <verse eid="JHN 1:35"/><verse number="36" style="v" sid="JHN 1:36"/>ಆಗ ಯೇಸು ಹೋಗುತ್ತಿರುವುದನ್ನು ಕಂಡು ಅವನು, “ಇಗೋ, ದೇವರ ಕುರಿಮರಿ,” ಎಂದು ಹೇಳಿದನು.<verse eid="JHN 1:36"/></para>
  <para style="p">
    <verse number="37" style="v" sid="JHN 1:37"/>ಆ ಇಬ್ಬರು ಶಿಷ್ಯರು ಅವನು ಹೇಳಿದ್ದನ್ನು ಕೇಳಿ ಯೇಸುವನ್ನು ಹಿಂಬಾಲಿಸಿದರು. <verse eid="JHN 1:37"/><verse number="38" style="v" sid="JHN 1:38"/>ಯೇಸು ಹಿಂತಿರುಗಿ ತನ್ನನ್ನು ಹಿಂಬಾಲಿಸುತ್ತಿದ್ದ ಅವರನ್ನು ನೋಡಿ, “ನಿಮಗೆ ಏನು ಬೇಕು?” ಎಂದು ಕೇಳಲು,</para>
  <para style="p" vid="JHN 1:38">ಅವರು, “ಬೋಧಕರೇ, ನೀವು ವಾಸಿಸುವುದು ಎಲ್ಲಿ?” ಎಂದು ಕೇಳಿದರು.<verse eid="JHN 1:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="JHN 1:39"/>ಯೇಸು ಅವರಿಗೆ, “ಬಂದು ನೋಡಿರಿ,” ಎಂದು ಹೇಳಲು,</para>
  <para style="p" vid="JHN 1:39">ಅವರು ಹೋಗಿ ಯೇಸು ವಾಸಿಸುತ್ತಿದ್ದ ಸ್ಥಳವನ್ನು ಕಂಡು ಆ ದಿವಸ ಅವರ ಸಂಗಡ ಇದ್ದರು. ಆಗ ಸಂಜೆ ಸುಮಾರು ನಾಲ್ಕು ಗಂಟೆಯಾಗಿತ್ತು.<verse eid="JHN 1:39"/></para>
  <para style="p">
    <verse number="40" style="v" sid="JHN 1:40"/>ಯೋಹಾನನ ಮಾತನ್ನು ಕೇಳಿ ಯೇಸುವನ್ನು ಹಿಂಬಾಲಿಸಿದ ಇಬ್ಬರಲ್ಲಿ ಸೀಮೋನ್ ಪೇತ್ರನ ಸಹೋದರ ಅಂದ್ರೆಯನು ಒಬ್ಬನಾಗಿದ್ದನು. <verse eid="JHN 1:40"/><verse number="41" style="v" sid="JHN 1:41"/>ಅಂದ್ರೆಯನು ಮೊದಲು ತನ್ನ ಸಹೋದರ ಸೀಮೋನನನ್ನು ಕಂಡು, “ನಾವು ಮೆಸ್ಸೀಯ ಆಗಿರುವವರನ್ನು ಕಂಡೆವು,” ಎಂದು ಹೇಳಿ, <verse eid="JHN 1:41"/><verse number="42" style="v" sid="JHN 1:42"/>ಅವನನ್ನು ಯೇಸುವಿನ ಬಳಿಗೆ ಕರೆತಂದನು. “ಮೆಸ್ಸೀಯ” ಎಂದರೆ ಕ್ರಿಸ್ತ ಎಂದು ಅರ್ಥ.</para>
  <para style="p" vid="JHN 1:42">ಯೇಸು ಅವನನ್ನು ನೋಡಿ, “ನೀನು ಯೋಹಾನನ ಮಗ ಸೀಮೋನನು. ನಿನ್ನನ್ನು ‘ಕೇಫ’ ಎಂದು ಕರೆಯುವರು,” ಎಂದು ಹೇಳಿದರು. “ಕೇಫ” ಎಂದರೆ ಪೇತ್ರ ಇಲ್ಲವೆ ಬಂಡೆ ಎಂದರ್ಥ.<verse eid="JHN 1:42"/></para>
  <para style="s1">ಯೇಸು ಫಿಲಿಪ್ಪನನ್ನು ಮತ್ತು ನತಾನಯೇಲನನ್ನು ಕರೆದದ್ದು</para>
  <para style="p">
    <verse number="43" style="v" sid="JHN 1:43"/>ಯೇಸು ಮರುದಿನ ಗಲಿಲಾಯಕ್ಕೆ ಹೋಗಬೇಕೆಂದಿದ್ದಾಗ, ಅವರು ಫಿಲಿಪ್ಪನನ್ನು ಕಂಡು, “ನನ್ನನ್ನು ಹಿಂಬಾಲಿಸು,” ಎಂದರು.<verse eid="JHN 1:43"/></para>
  <para style="p">
    <verse number="44" style="v" sid="JHN 1:44"/>ಫಿಲಿಪ್ಪನು, ಅಂದ್ರೆಯ ಮತ್ತು ಪೇತ್ರನ ಪಟ್ಟಣವಾದ ಬೇತ್ಸಾಯಿದಕ್ಕೆ ಸೇರಿದವನು. <verse eid="JHN 1:44"/><verse number="45" style="v" sid="JHN 1:45"/>ಫಿಲಿಪ್ಪನು ನತಾನಯೇಲನನ್ನು ಕಂಡು, “ಮೋಶೆಯ ನಿಯಮದಲ್ಲಿ ಸೂಚಿಸಿದವರೂ ಪ್ರವಾದಿಗಳೂ ಯಾರನ್ನು ಕುರಿತು ಬರೆದಿದ್ದಾರೋ ಅವರು ನಮಗೆ ಸಿಕ್ಕಿದ್ದಾರೆ. ಅವರೇ ಯೋಸೇಫನ ಪುತ್ರರಾಗಿರುವ ನಜರೇತಿನ ಯೇಸು,” ಎಂದನು.<verse eid="JHN 1:45"/></para>
  <para style="p">
    <verse number="46" style="v" sid="JHN 1:46"/>“ಏನು? ನಜರೇತಿನಿಂದ ಒಳ್ಳೆಯದೇನಾದರೂ ಬರಲು ಸಾಧ್ಯವೋ?” ಎಂದು ನತಾನಯೇಲನು ಕೇಳಲು,</para>
  <para style="p" vid="JHN 1:46">“ಬಂದು ನೋಡು,” ಎಂದು ಫಿಲಿಪ್ಪನು ಹೇಳಿದನು.<verse eid="JHN 1:46"/></para>
  <para style="p">
    <verse number="47" style="v" sid="JHN 1:47"/>ನತಾನಯೇಲನು ತಮ್ಮ ಬಳಿಗೆ ಬರುವುದನ್ನು ಯೇಸು ಕಂಡು ಅವನ ವಿಷಯವಾಗಿ, “ಇವನು ನಿಜವಾದ ಇಸ್ರಾಯೇಲನು, ಇವನಲ್ಲಿ ಕಪಟವಿಲ್ಲ,” ಎಂದು ಹೇಳಿದರು.<verse eid="JHN 1:47"/></para>
  <para style="p">
    <verse number="48" style="v" sid="JHN 1:48"/>ಅದಕ್ಕೆ ನತಾನಯೇಲನು, “ನೀವು ನನ್ನನ್ನು ಹೇಗೆ ಬಲ್ಲಿರಿ?” ಎಂದು ಕೇಳಲು,</para>
  <para style="p" vid="JHN 1:48">ಯೇಸು ಅವನಿಗೆ, “ಫಿಲಿಪ್ಪನು ನಿನ್ನನ್ನು ಕರೆಯುವುದಕ್ಕಿಂತ ಮುಂಚೆಯೇ ನೀನು ಅಂಜೂರದ ಮರದ ಕೆಳಗಿರುವುದನ್ನು ನಾನು ಕಂಡೆನು,” ಎಂದು ಉತ್ತರಿಸಿದರು.<verse eid="JHN 1:48"/></para>
  <para style="p">
    <verse number="49" style="v" sid="JHN 1:49"/>ಅದಕ್ಕೆ ನತಾನಯೇಲನು, “ಗುರುವೇ, ನೀವು ದೇವಪುತ್ರ; ಇಸ್ರಾಯೇಲಿನ ಅರಸ ನೀವೇ,” ಎಂದನು.<verse eid="JHN 1:49"/></para>
  <para style="p">
    <verse number="50" style="v" sid="JHN 1:50"/>ಯೇಸು ಅವನಿಗೆ, “ನಿನ್ನನ್ನು ಅಂಜೂರದ ಮರದ ಕೆಳಗೆ ಕಂಡಿದ್ದೆ ಎಂದು ನಾನು ಹೇಳಿದ್ದಕ್ಕೆ ನೀನು ನಂಬುತ್ತೀಯೋ? ನೀನು ಇವುಗಳಿಗಿಂತಲೂ ಮಹಾಕಾರ್ಯಗಳನ್ನು ಕಾಣುವೆ,” ಎಂದು ಉತ್ತರಿಸಿದರು. <verse eid="JHN 1:50"/><verse number="51" style="v" sid="JHN 1:51"/>ಯೇಸು ಅವನಿಗೆ, “ನಾನು ನಿಮಗೆ ನಿಜವಾಗಿ ಹೇಳುವುದೇನೆಂದರೆ, ನೀವು ಪರಲೋಕವು ತೆರೆದಿರುವುದನ್ನೂ ದೇವದೂತರು ಮನುಷ್ಯಪುತ್ರನಾದ ನನ್ನ ಮುಖಾಂತರ ಇಳಿಯುತ್ತಾ ಏರುತ್ತಾ ಇರುವುದನ್ನೂ ಕಾಣುವಿರಿ,”<note caller="+" style="f"><char style="fr" closed="false">1:51 </char><char style="ft" closed="false"><char style="xt"><ref loc="GEN 28:12">ಆದಿ 28:12</ref></char></char></note> ಎಂದು ಹೇಳಿದರು.<verse eid="JHN 1:51"/></para>
  <chapter eid="JHN 1"/>
  <chapter number="2" style="c" sid="JHN 2"/>
  <para style="s1">ಯೇಸು ನೀರನ್ನು ದ್ರಾಕ್ಷಾರಸವನ್ನಾಗಿ ಮಾರ್ಪಡಿಸಿದ್ದು</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 2:1"/>ಮೂರನೆಯ ದಿನದಲ್ಲಿ ಗಲಿಲಾಯದ ಕಾನಾ ಎಂಬ ಊರಿನಲ್ಲಿ ಒಂದು ಮದುವೆ ನಡೆಯಿತು. ಯೇಸುವಿನ ತಾಯಿ ಅಲ್ಲಿ ಇದ್ದಳು. <verse eid="JHN 2:1"/><verse number="2" style="v" sid="JHN 2:2"/>ಯೇಸು ಮತ್ತು ಅವರ ಶಿಷ್ಯರು ಮದುವೆಗೆ ಆಮಂತ್ರಿತರಾಗಿದ್ದರು. <verse eid="JHN 2:2"/><verse number="3" style="v" sid="JHN 2:3"/>ಅಲ್ಲಿ ದ್ರಾಕ್ಷಾರಸವು ಮುಗಿದು ಹೋದಾಗ, ಯೇಸುವಿನ ತಾಯಿ, “ಅವರಲ್ಲಿ ದ್ರಾಕ್ಷಾರಸ ಮುಗಿದು ಹೋಗಿದೆ,” ಎಂದು ಯೇಸುವಿಗೆ ತಿಳಿಸಿದಳು.<verse eid="JHN 2:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="JHN 2:4"/>ಯೇಸು ಆಕೆಗೆ, “ಅಮ್ಮಾ,<note caller="+" style="f"><char style="fr" closed="false">2:4 </char><char style="ft" closed="false">ಗ್ರೀಕ್ ಭಾಷೆಯಲ್ಲಿ </char><char style="fqa" closed="false">ಸ್ತ್ರೀ</char></note> ನಾನು ನಿಮಗೆ ಏನು ಮಾಡಲು ಬಯಸುತ್ತೀರಿ? ನನ್ನ ಸಮಯವು ಇನ್ನೂ ಬಂದಿಲ್ಲ,” ಎಂದು ಹೇಳಿದರು.<verse eid="JHN 2:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="JHN 2:5"/>ಯೇಸುವಿನ ತಾಯಿಯು ಸೇವಕರಿಗೆ, “ಆತನು ನಿಮಗೆ ಹೇಳಿದಂತೆ ಮಾಡಿರಿ,” ಎಂದು ಹೇಳಿದಳು.<verse eid="JHN 2:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="JHN 2:6"/>ಯೆಹೂದ್ಯರ ಶುದ್ಧಾಚಾರದ ಪ್ರಕಾರ ಅಲ್ಲಿ ಕಲ್ಲಿನ ಆರು ಬಾನೆಗಳು ಇದ್ದವು. ಪ್ರತಿಯೊಂದು ಬಾನೆಯೂ ಎರಡು ಇಲ್ಲವೆ ಮೂರು ಕೊಡದ ಅಳತೆಯುಳ್ಳದ್ದಾಗಿತ್ತು.<note caller="+" style="f"><char style="fr" closed="false">2:6 </char><char style="ft" closed="false">ಸುಮಾರು 75 ಲೀಟರಿಂದ 115 ಲೀಟರ್</char></note><verse eid="JHN 2:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="JHN 2:7"/>ಯೇಸು ಸೇವಕರಿಗೆ, “ಆ ಬಾನೆಗಳಲ್ಲಿ ನೀರು ತುಂಬಿರಿ,” ಎಂದರು. ಅವರು ಅವುಗಳನ್ನು ಕಂಠದವರೆಗೆ ತುಂಬಿದರು.<verse eid="JHN 2:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="JHN 2:8"/>ಅನಂತರ ಯೇಸು ಅವರಿಗೆ, “ಈಗ ಇದನ್ನು ತೆಗೆದುಕೊಂಡು ಔತಣದ ಮೇಲ್ವಿಚಾರಕನಿಗೆ ಕೊಡಿರಿ,” ಎಂದರು.</para>
  <para style="p" vid="JHN 2:8">ಸೇವಕರು ತೆಗೆದುಕೊಂಡು ಹೋದರು. <verse eid="JHN 2:8"/><verse number="9" style="v" sid="JHN 2:9"/>ಔತಣದ ಮೇಲ್ವಿಚಾರಕನು ದ್ರಾಕ್ಷಾರಸವಾಗಿದ್ದ ನೀರನ್ನು ರುಚಿನೋಡಿದಾಗ, ಅದು ಎಲ್ಲಿಂದ ಬಂತೆಂದು ಅವನಿಗೆ ತಿಳಿದಿರಲಿಲ್ಲ. ಆದರೆ ನೀರನ್ನು ತಂದ ಸೇವಕರಿಗೆ ತಿಳಿದಿತ್ತು. ಔತಣದ ಮೇಲ್ವಿಚಾರಕನು ಮದುಮಗನನ್ನು ಕರೆದು, <verse eid="JHN 2:9"/><verse number="10" style="v" sid="JHN 2:10"/>“ಪ್ರತಿಯೊಬ್ಬನು ಉತ್ತಮ ದ್ರಾಕ್ಷಾರಸವನ್ನು ಮೊದಲು ತಂದಿಟ್ಟು ಜನರು ತುಂಬಾ ಕುಡಿದ ಮೇಲೆ ಸಾಧಾರಣವಾದದ್ದನ್ನು ಕೊಡುತ್ತಾರೆ, ನೀನಾದರೋ ಉತ್ತಮ ದ್ರಾಕ್ಷಾರಸವನ್ನು ಇನ್ನೂ ಇಟ್ಟುಕೊಂಡಿರುವೆ,” ಎಂದನು.<verse eid="JHN 2:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="JHN 2:11"/>ಯೇಸು ಗಲಿಲಾಯದ ಕಾನಾದಲ್ಲಿ ಮಾಡಿದ ಸೂಚಕಕಾರ್ಯಗಳಲ್ಲಿ ಇದು ಮೊದಲನೆಯದಾಗಿತ್ತು. ಹೀಗೆ ಯೇಸು ತಮ್ಮ ಮಹಿಮೆಯನ್ನು ತೋರ್ಪಡಿಸಿದರು. ಯೇಸುವಿನ ಶಿಷ್ಯರು ಅವರಲ್ಲಿ ನಂಬಿಕೆಯಿಟ್ಟರು.<verse eid="JHN 2:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 2:12"/>ಇದಾದ ಮೇಲೆ ಯೇಸು ತಮ್ಮ ತಾಯಿ, ಸಹೋದರರು ಮತ್ತು ಶಿಷ್ಯರೊಡನೆ ಕಪೆರ್ನೌಮಿಗೆ ಹೋದರು. ಅಲ್ಲಿ ಅವರು ಕೆಲವು ದಿವಸ ಇದ್ದರು.<verse eid="JHN 2:12"/></para>
  <para style="s1">ಯೇಸು ದೇವಾಲಯವನ್ನು ಶುದ್ಧಗೊಳಿಸಿದ್ದು</para>
  <para style="p">
    <verse number="13" style="v" sid="JHN 2:13"/>ಯೆಹೂದ್ಯರ ಪಸ್ಕಹಬ್ಬವು<note caller="+" style="f"><char style="fr" closed="false">2:13 </char><char style="ft" closed="false">ಈಜಿಪ್ಟ್‌ನಲ್ಲಿದ್ದ ಇಸ್ರಾಯೇಲರ ಬಿಡುಗಡೆಯನ್ನು ಸ್ಮರಿಸುವ ಹಬ್ಬ</char></note> ಹತ್ತಿರವಾದಾಗ ಯೇಸು ಯೆರೂಸಲೇಮಿಗೆ ಹೋದರು. <verse eid="JHN 2:13"/><verse number="14" style="v" sid="JHN 2:14"/>ಅವರು ದೇವಾಲಯದ ಅಂಗಳದಲ್ಲಿ ದನ, ಕುರಿ ಹಾಗೂ ಪಾರಿವಾಳಗಳನ್ನು ಮಾರುವವರೂ ಹಣ ಬದಲಾಯಿಸುವವರೂ ಕುಳಿತಿರುವುದನ್ನು ಕಂಡರು. <verse eid="JHN 2:14"/><verse number="15" style="v" sid="JHN 2:15"/>ಯೇಸು ಹಗ್ಗಗಳಿಂದ ಕೊರಡೆ ಮಾಡಿ ಕುರಿ, ದನ ಸಹಿತ ಎಲ್ಲರನ್ನೂ ದೇವಾಲಯದ ಹೊರಕ್ಕೆ ಅಟ್ಟಿ, ಹಣ ಬದಲಾಯಿಸುವವರ ನಾಣ್ಯಗಳನ್ನು ಮತ್ತು ಮೇಜುಗಳನ್ನು ಕೆಡವಿದರು. <verse eid="JHN 2:15"/><verse number="16" style="v" sid="JHN 2:16"/>ಯೇಸು ಪಾರಿವಾಳ ಮಾರುವವರಿಗೆ, “ಇವುಗಳನ್ನು ತೆಗೆದುಕೊಂಡು ಹೋಗಿರಿ, ನನ್ನ ತಂದೆಯ ಮನೆಯನ್ನು ವ್ಯಾಪಾರದ ಮನೆಯನ್ನಾಗಿ ಮಾಡಬೇಡಿರಿ,” ಎಂದರು. <verse eid="JHN 2:16"/><verse number="17" style="v" sid="JHN 2:17"/>ಯೇಸುವಿನ ಶಿಷ್ಯರು, “ನಿನ್ನ ಆಲಯದ ಮೇಲಿನ ಆಸಕ್ತಿಯು ನನ್ನನ್ನು ಬೆಂಕಿಯಂತೆ ದಹಿಸುತ್ತದೆ,”<note caller="+" style="f"><char style="fr" closed="false">2:17 </char><char style="ft" closed="false"><char style="xt"><ref loc="PSA 69:9">ಕೀರ್ತನೆ 69:9</ref></char></char></note> ಎಂದು ಪವಿತ್ರ ವೇದದಲ್ಲಿ ಬರೆದಿರುವುದನ್ನು ಜ್ಞಾಪಕಮಾಡಿಕೊಂಡರು.<verse eid="JHN 2:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="JHN 2:18"/>ಆಗ ಯೆಹೂದ್ಯರು ಯೇಸುವಿಗೆ, “ಇವುಗಳನ್ನು ಮಾಡುವ ಅಧಿಕಾರ ನಿನಗಿದೆ ಎಂಬುದಕ್ಕೆ ಯಾವ ಸೂಚಕಕಾರ್ಯವನ್ನು ತೋರಿಸುತ್ತೀ?” ಎಂದು ಕೇಳಿದರು.<verse eid="JHN 2:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="JHN 2:19"/>ಅದಕ್ಕೆ ಯೇಸು ಅವರಿಗೆ, “ಈ ದೇವಾಲಯವನ್ನು ಕೆಡವಿರಿ. ನಾನು ಮೂರು ದಿನಗಳಲ್ಲಿ ಅದನ್ನು ಎಬ್ಬಿಸುವೆನು,” ಎಂದು ಉತ್ತರಕೊಟ್ಟರು.<verse eid="JHN 2:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="JHN 2:20"/>ಅದಕ್ಕೆ ಯೆಹೂದ್ಯರು, “ಈ ದೇವಾಲಯವನ್ನು ಕಟ್ಟುವುದಕ್ಕೆ ನಲವತ್ತಾರು ವರ್ಷಗಳಾದವು. ನೀನು ಮೂರು ದಿನಗಳಲ್ಲಿ ಅದನ್ನು ಎಬ್ಬಿಸುವೆಯೋ?” ಎಂದರು. <verse eid="JHN 2:20"/><verse number="21" style="v" sid="JHN 2:21"/>ಆದರೆ ಯೇಸು ತಮ್ಮ ದೇಹವೆಂಬ ಆಲಯವನ್ನು ಕುರಿತು ಹೇಳಿದ್ದರು. <verse eid="JHN 2:21"/><verse number="22" style="v" sid="JHN 2:22"/>ಆದ್ದರಿಂದ ಯೇಸು ಸತ್ತವರೊಳಗಿಂದ ಜೀವಂತವಾಗಿ ಎದ್ದಾಗ, ಅವರ ಶಿಷ್ಯರು ಅವರು ಹೇಳಿದ ಈ ಮಾತನ್ನು ನೆನಪು ಮಾಡಿಕೊಂಡು ಪವಿತ್ರ ವೇದವನ್ನೂ ಯೇಸು ತಮಗೆ ಹೇಳಿದ ಮಾತನ್ನೂ ನಂಬಿದರು.<verse eid="JHN 2:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="JHN 2:23"/>ಯೇಸು ಪಸ್ಕಹಬ್ಬದಂದು ಯೆರೂಸಲೇಮಿನಲ್ಲಿದ್ದಾಗ ಮಾಡಿದ ಸೂಚಕಕಾರ್ಯಗಳನ್ನು ಅನೇಕರು ಕಂಡು ಅವರ ಹೆಸರಿನಲ್ಲಿ ನಂಬಿಕೆ ಇಟ್ಟರು.<note caller="+" style="f"><char style="fr" closed="false">2:23 </char><char style="ft" closed="false">ಕೆಲವು ಪ್ರತಿಗಳಲ್ಲಿ </char><char style="fqa" closed="false">ಆತನಲ್ಲಿ </char><char style="ft" closed="false">ಎಂದಿದೆ.</char></note> <verse eid="JHN 2:23"/><verse number="24" style="v" sid="JHN 2:24"/>ಆದರೆ ಯೇಸು ಎಲ್ಲರನ್ನೂ ಅರಿತವರಾದ್ದರಿಂದ ತಮ್ಮನ್ನು ಒಪ್ಪಿಸಿಕೊಡಲಿಲ್ಲ. <verse eid="JHN 2:24"/><verse number="25" style="v" sid="JHN 2:25"/>ಯೇಸು ಮನುಷ್ಯರ ಅಂತರಂಗವನ್ನು ತಿಳಿದವರಾದ ಕಾರಣ ಯಾರೂ ಯಾವ ಮನುಷ್ಯನ ವಿಷಯದಲ್ಲಿಯೂ ಅವರಿಗೆ ಸಾಕ್ಷಿ ಕೊಡಬೇಕಾದ ಅವಶ್ಯವಿರಲಿಲ್ಲ.<verse eid="JHN 2:25"/></para>
  <chapter eid="JHN 2"/>
  <chapter number="3" style="c" sid="JHN 3"/>
  <para style="s1">ಯೇಸುವೂ ನಿಕೊದೇಮನೂ</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 3:1"/>ಯೆಹೂದ್ಯರ ಆಡಳಿತ ಮಂಡಳಿಯ ಸದಸ್ಯನೂ ಫರಿಸಾಯನೂ ಆದ ನಿಕೊದೇಮನೆಂಬ ಮನುಷ್ಯನಿದ್ದನು. <verse eid="JHN 3:1"/><verse number="2" style="v" sid="JHN 3:2"/>ಇವನು ಒಂದು ರಾತ್ರಿ ಯೇಸುವಿನ ಬಳಿಗೆ ಬಂದು, “ಗುರುವೇ, ನೀವು ದೇವರ ಬಳಿಯಿಂದ ಬಂದ ಬೋಧಕರೆಂದು ನಾವು ಬಲ್ಲೆವು. ಏಕೆಂದರೆ ದೇವರು ಒಬ್ಬನ ಸಂಗಡ ಇಲ್ಲದಿದ್ದರೆ ನೀವು ಮಾಡುವ ಸೂಚಕಕಾರ್ಯಗಳನ್ನು ಯಾವ ಮನುಷ್ಯನೂ ಮಾಡಲಾರನು,” ಎಂದನು.<verse eid="JHN 3:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="JHN 3:3"/>ಯೇಸು ಅವನಿಗೆ, “ಒಬ್ಬನು ಮತ್ತೊಮ್ಮೆ ಹುಟ್ಟದಿದ್ದರೆ<note caller="+" style="f"><char style="fr" closed="false">3:3 </char><char style="ft" closed="false">ಗ್ರೀಕ್ ಭಾಷೆಯಲ್ಲಿ </char><char style="fqa" closed="false">ಮೇಲಿನಿಂದ </char><char style="ft" closed="false">ಎಂದಿದೆ.</char></note> ಅವನು ದೇವರ ರಾಜ್ಯವನ್ನು ಕಾಣಲಾರನು, ಎಂದು ನಾನು ನಿನಗೆ ನಿಜನಿಜವಾಗಿ ಹೇಳುತ್ತೇನೆ.”<verse eid="JHN 3:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="JHN 3:4"/>ನಿಕೊದೇಮನು ಯೇಸುವಿಗೆ, “ಒಬ್ಬನು ವಯಸ್ಸಾದ ಮೇಲೆ ಮತ್ತೆ ಹುಟ್ಟುವುದು ಹೇಗೆ? ಅವನು ತನ್ನ ತಾಯಿಯ ಗರ್ಭದಲ್ಲಿ ಎರಡನೆಯ ಸಾರಿ ಪ್ರವೇಶಿಸಿ ಹುಟ್ಟುವುದಾದೀತೇ?” ಎಂದು ಕೇಳಿದನು.<verse eid="JHN 3:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="JHN 3:5"/>ಯೇಸು ಅವನಿಗೆ, “ಯಾರು ನೀರಿನಿಂದಲೂ ಆತ್ಮದಿಂದಲೂ ಹುಟ್ಟುವದಿಲ್ಲವೋ ಅವನು ದೇವರ ರಾಜ್ಯದೊಳಗೆ ಪ್ರವೇಶಿಸಲಾರನು, ಎಂದು ನಾನು ನಿನಗೆ ನಿಜನಿಜವಾಗಿ ಹೇಳುತ್ತೇನೆ. <verse eid="JHN 3:5"/><verse number="6" style="v" sid="JHN 3:6"/>ಮಾಂಸದಿಂದ ಹುಟ್ಟಿದ್ದು ಮಾಂಸವೇ, ದೇವರಾತ್ಮದಿಂದ ಹುಟ್ಟಿದವರು ಆತ್ಮವೇ. <verse eid="JHN 3:6"/><verse number="7" style="v" sid="JHN 3:7"/>‘ನೀವು ಮತ್ತೆ ಹುಟ್ಟಬೇಕಾಗಿದೆ,’ ಎಂದು ನಾನು ನಿನಗೆ ಹೇಳಿದ್ದರಿಂದ ಆಶ್ಚರ್ಯಪಡಬೇಡ. <verse eid="JHN 3:7"/><verse number="8" style="v" sid="JHN 3:8"/>ಗಾಳಿಯು ಅದರ ಇಷ್ಟ ಬಂದ ಕಡೆ ಬೀಸುತ್ತದೆ. ನೀನು ಅದರ ಶಬ್ದವನ್ನು ಕೇಳುತ್ತೀ, ಆದರೆ ಅದು ಎಲ್ಲಿಂದ ಬರುತ್ತದೋ ಎಲ್ಲಿಗೆ ಹೋಗುತ್ತದೋ ನಿನಗೆ ತಿಳಿಯದು. ಅದರಂತೆಯೇ ಆತ್ಮದಿಂದ ಹುಟ್ಟಿದ ಪ್ರತಿಯೊಬ್ಬರೂ ಹೀಗೇ ಇದ್ದಾರೆ,” ಎಂದು ಉತ್ತರಕೊಟ್ಟರು.<verse eid="JHN 3:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="JHN 3:9"/>ನಿಕೊದೇಮನು ಯೇಸುವಿಗೆ, “ಇದೆಲ್ಲಾ ಹೇಗೆ ಸಾಧ್ಯ?” ಎಂದು ಕೇಳಿದನು.<verse eid="JHN 3:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="JHN 3:10"/>ಯೇಸು ಅವನಿಗೆ, “ಇಸ್ರಾಯೇಲರಿಗೆ ಬೋಧಕನಾಗಿರುವ ನಿನಗೆ ಇವುಗಳು ತಿಳಿಯುವುದಿಲ್ಲವೋ? <verse eid="JHN 3:10"/><verse number="11" style="v" sid="JHN 3:11"/>ನಾನು ನಿನಗೆ ನಿಜನಿಜವಾಗಿ ಹೇಳುತ್ತೇನೆ, ನಾವು ತಿಳಿದಿರುವುದನ್ನು ಮಾತನಾಡುತ್ತೇವೆ ಮತ್ತು ಕಂಡಿದ್ದಕ್ಕೆ ಸಾಕ್ಷಿ ನೀಡುತ್ತೇವೆ. ನೀವಾದರೋ ನಮ್ಮ ಸಾಕ್ಷಿಯನ್ನು ಸ್ವೀಕರಿಸುವುದಿಲ್ಲ. <verse eid="JHN 3:11"/><verse number="12" style="v" sid="JHN 3:12"/>ನಾನು ಭೂಲೋಕದ ಕಾರ್ಯಗಳನ್ನು ನಿಮಗೆ ಹೇಳುವಾಗಲೇ ನೀವು ನಂಬುವುದಿಲ್ಲ, ಪರಲೋಕದ ಕಾರ್ಯಗಳನ್ನು ಕುರಿತು ನಿಮಗೆ ಹೇಳಿದರೆ ಹೇಗೆ ನಂಬುವಿರಿ? <verse eid="JHN 3:12"/><verse number="13" style="v" sid="JHN 3:13"/>ಪರಲೋಕದಿಂದ ಇಳಿದು ಬಂದ ಮನುಷ್ಯಪುತ್ರನಾದ ನನ್ನನ್ನು ಹೊರತು ಯಾರೂ ಪರಲೋಕಕ್ಕೆ ಏರಿ ಹೋದವರಿಲ್ಲ.<note caller="+" style="f"><char style="fr" closed="false">3:13 </char><char style="ft" closed="false">ಕೆಲವು ಹಸ್ತಪ್ರತಿಗಳಲ್ಲಿ </char><char style="fqa" closed="false">ಪರಲೋಕದಲ್ಲಿರುವ ಮನುಷ್ಯಪುತ್ರ </char><char style="ft" closed="false">ಎಂದು ಬರೆಯಲಾಗಿದೆ</char></note> <verse eid="JHN 3:13"/><verse number="14" style="v" sid="JHN 3:14"/>ಇದಲ್ಲದೆ ಮೋಶೆಯು ಅರಣ್ಯದಲ್ಲಿ ಸರ್ಪವನ್ನು ಮೇಲೆ ಎತ್ತಿದ ಹಾಗೆಯೇ ಮನುಷ್ಯಪುತ್ರನಾದ ನನ್ನನ್ನು ಸಹ ಮೇಲಕ್ಕೆ ಏರಿಸಬೇಕು. <verse eid="JHN 3:14"/><verse number="15" style="v" sid="JHN 3:15"/>ಹೀಗೆ ಮನುಷ್ಯಪುತ್ರನಾದ ನನ್ನನ್ನು ನಂಬುವ ಪ್ರತಿಯೊಬ್ಬರೂ ನಿತ್ಯಜೀವವನ್ನು ಪಡೆಯುವರು.”<verse eid="JHN 3:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 3:16"/>ದೇವರು ಲೋಕದ ಮೇಲೆ ಎಷ್ಟೋ ಪ್ರೀತಿಯನ್ನಿಟ್ಟು ತಮ್ಮ ಏಕೈಕ ಪುತ್ರ ಆಗಿರುವ ಕ್ರಿಸ್ತ ಯೇಸುವನ್ನು ಕೊಟ್ಟರು. ಅದಕ್ಕಾಗಿಯೇ ಅವರನ್ನು ನಂಬುವ ಪ್ರತಿಯೊಬ್ಬರೂ ನಾಶವಾಗದೆ ಎಲ್ಲರೂ ನಿತ್ಯಜೀವವನ್ನು ಪಡೆಯಬೇಕು. <verse eid="JHN 3:16"/><verse number="17" style="v" sid="JHN 3:17"/>ದೇವರು ಲೋಕಕ್ಕೆ ತೀರ್ಪು ಮಾಡುವುದಕ್ಕಾಗಿ ಅಲ್ಲ, ತಮ್ಮ ಪುತ್ರನ ಮುಖಾಂತರ ಲೋಕದ ಜನರನ್ನು ರಕ್ಷಿಸುವುದಕ್ಕಾಗಿಯೇ ಅವರನ್ನು ಲೋಕಕ್ಕೆ ಕಳುಹಿಸಿದರು. <verse eid="JHN 3:17"/><verse number="18" style="v" sid="JHN 3:18"/>ಮಗನನ್ನು ನಂಬುವವನಿಗೆ ತೀರ್ಪು ಆಗುವುದಿಲ್ಲ. ನಂಬದವನಿಗೆ ಆಗಲೇ ತೀರ್ಪಾಯಿತು. ಏಕೆಂದರೆ ಅವನು ದೇವರ ಒಬ್ಬನೇ ಪುತ್ರನ ಹೆಸರಿನ ಮೇಲೆ ನಂಬಿಕೆ ಇಡಲಿಲ್ಲ. <verse eid="JHN 3:18"/><verse number="19" style="v" sid="JHN 3:19"/>ಆ ತೀರ್ಪು ಏನೆಂದರೆ: ಬೆಳಕು ಲೋಕಕ್ಕೆ ಬಂದಿದ್ದರೂ ಮನುಷ್ಯರ ಕೃತ್ಯಗಳು ಕೆಟ್ಟವುಗಳಾಗಿರುವುದರಿಂದ ಅವರು ಬೆಳಕಿಗಿಂತ ಕತ್ತಲೆಯನ್ನೇ ಪ್ರೀತಿ ಮಾಡಿದರು. <verse eid="JHN 3:19"/><verse number="20" style="v" sid="JHN 3:20"/>ಕೇಡನ್ನು ಮಾಡುವವರು ಬೆಳಕನ್ನು ದ್ವೇಷಿಸುತ್ತಾರೆ ಮತ್ತು ಬೆಳಕಿಗೆ ಬರುವುದಿಲ್ಲ. ಏಕೆಂದರೆ ಅವರು ಮಾಡಿರುವ ಕೆಟ್ಟ ಕಾರ್ಯಗಳನ್ನೆಲ್ಲಾ ಬೆಳಕು ತೋರಿಸುತ್ತದೆ. <verse eid="JHN 3:20"/><verse number="21" style="v" sid="JHN 3:21"/>ಆದರೆ ಸತ್ಯವನ್ನು ಅನುಸರಿಸುವವರು ನಡೆದಿರುವ ತಮ್ಮ ಕೃತ್ಯಗಳು ದೇವರಿಂದ ಆದವುಗಳೆಂದು ಪ್ರಕಟಿಸುವಂತೆ ಬೆಳಕಿಗೆ ಬರುತ್ತಾರೆ.<verse eid="JHN 3:21"/></para>
  <para style="s1">ಯೇಸುವಿನ ಬಗ್ಗೆ ಸ್ನಾನಿಕ ಯೋಹಾನನ ಸಾಕ್ಷಿ</para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 3:22"/>ಇವುಗಳಾದ ಮೇಲೆ ಯೇಸುವೂ ಅವರ ಶಿಷ್ಯರೂ ಯೂದಾಯ ಪ್ರಾಂತಕ್ಕೆ ಬಂದರು. ಅಲ್ಲಿ ಯೇಸು ಅವರೊಂದಿಗೆ ಇದ್ದು ದೀಕ್ಷಾಸ್ನಾನ ಮಾಡಿಸುತ್ತಿದ್ದರು. <verse eid="JHN 3:22"/><verse number="23" style="v" sid="JHN 3:23"/>ಇದಲ್ಲದೆ ಯೋಹಾನನು ಸಹ ಸಲೀಮ್ ಎಂಬ ಊರಿನ ಸಮೀಪದಲ್ಲಿದ್ದ ಐನೋನ್ ಎಂಬ ಸ್ಥಳದಲ್ಲಿ ದೀಕ್ಷಾಸ್ನಾನ ಮಾಡಿಸುತ್ತಿದ್ದನು. ಏಕೆಂದರೆ ಅಲ್ಲಿ ಬಹಳ ನೀರು ಇತ್ತು. ಜನರು ಬಂದು ದೀಕ್ಷಾಸ್ನಾನ ಮಾಡಿಸಿಕೊಳ್ಳುತ್ತಿದ್ದರು. <verse eid="JHN 3:23"/><verse number="24" style="v" sid="JHN 3:24"/>ಆಗ ಯೋಹಾನನು ಇನ್ನೂ ಸೆರೆಯಲ್ಲಿ ಬಂಧಿತನಾಗಿರಲಿಲ್ಲ. <verse eid="JHN 3:24"/><verse number="25" style="v" sid="JHN 3:25"/>ಯೋಹಾನನ ಶಿಷ್ಯರಿಗೂ ಒಬ್ಬ ಯೆಹೂದ್ಯನಿಗೂ ಶುದ್ಧಾಚಾರವನ್ನು ಕುರಿತು ವಿವಾದ ಉಂಟಾಯಿತು. <verse eid="JHN 3:25"/><verse number="26" style="v" sid="JHN 3:26"/>ಅವರು ಯೋಹಾನನ ಬಳಿಗೆ ಬಂದು ಅವನಿಗೆ, “ಗುರುವೇ, ಯೊರ್ದನ್ ನದಿಯ ಆಚೆದಡದಲ್ಲಿ ನಿನ್ನೊಡನೆ ಇದ್ದ ಒಬ್ಬರ ಬಗ್ಗೆ ನೀನು ಸಾಕ್ಷಿ ಕೊಟ್ಟೆಯಲ್ಲಾ. ಇಗೋ, ಅವರು ದೀಕ್ಷಾಸ್ನಾನ ಮಾಡಿಸುತ್ತಿದ್ದಾರೆ ಮತ್ತು ಎಲ್ಲರೂ ಅವರ ಬಳಿಗೆ ಹೋಗುತ್ತಿದ್ದಾರೆ,” ಎಂದರು.<verse eid="JHN 3:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="JHN 3:27"/>ಅದಕ್ಕೆ ಯೋಹಾನನು, “ಪರಲೋಕದಿಂದ ಒಬ್ಬ ಮನುಷ್ಯನಿಗೆ ದಯಪಾಲಿಸದ ಹೊರತು ಅವನು ಯಾವುದನ್ನೂ ಹೊಂದಲಾರನು. <verse eid="JHN 3:27"/><verse number="28" style="v" sid="JHN 3:28"/>‘ನಾನು ಕ್ರಿಸ್ತನಲ್ಲ, ಆದರೆ ಅವರ ಮುಂದೂತನೆಂದು,’ ಹೇಳಿದ್ದಕ್ಕೆ ನೀವೇ ಸಾಕ್ಷಿ. <verse eid="JHN 3:28"/><verse number="29" style="v" sid="JHN 3:29"/>ಮದುಮಗಳು ಮದುಮಗನಿಗೆ ಸೇರಿದವಳು. ಆದರೂ ಮದುಮಗನ ಸ್ನೇಹಿತನು ನಿಂತುಕೊಂಡು ಆತನ ಮಾತಿಗೆ ಕಿವಿಗೊಟ್ಟು, ಮದುಮಗನ ಸ್ವರ ಕೇಳಿ ಸಂತೋಷಪಡುತ್ತಾನೆ. ಆದಕಾರಣ ಈ ನನ್ನ ಸಂತೋಷವು ಪರಿಪೂರ್ಣವಾಯಿತು. <verse eid="JHN 3:29"/><verse number="30" style="v" sid="JHN 3:30"/>ಆತನು ಹೆಚ್ಚಾಗಬೇಕು ನಾನು ಕಡಿಮೆಯಾಗಬೇಕು.<verse eid="JHN 3:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="JHN 3:31"/>“ಮೇಲಿನಿಂದ ಬರುವವರೇ ಎಲ್ಲರಿಗಿಂತಲೂ ಮೇಲಾದವರು, ಭೂಲೋಕದವನಾದರೋ ಭೂಮಿಗೆ ಸೇರಿದವನಾಗಿದ್ದು ಭೂಸಂಬಂಧವಾದವುಗಳನ್ನು ಮಾತನಾಡುತ್ತಾನೆ; ಪರಲೋಕದಿಂದ ಬರುವವರು ಎಲ್ಲವುಗಳಿಗಿಂತಲೂ ಮೇಲಾದವರು. <verse eid="JHN 3:31"/><verse number="32" style="v" sid="JHN 3:32"/>ಅವರು ಯಾವುದನ್ನು ಕಂಡು ಕೇಳಿದರೋ ಅದಕ್ಕೆ ಸಾಕ್ಷಿಕೊಡುತ್ತಾರೆ. ಆದರೆ ಅವರ ಸಾಕ್ಷಿಯನ್ನು ಯಾರೂ ಸ್ವೀಕರಿಸುವುದಿಲ್ಲ. <verse eid="JHN 3:32"/><verse number="33" style="v" sid="JHN 3:33"/>ಅವರ ಸಾಕ್ಷಿಯನ್ನು ಸ್ವೀಕರಿಸಿದವರು ದೇವರು ಸತ್ಯವಂತರೆಂದು ಮುದ್ರೆ ಹಾಕಿದ್ದಾರೆ. <verse eid="JHN 3:33"/><verse number="34" style="v" sid="JHN 3:34"/>ದೇವರು ಕಳುಹಿಸಿದವರಾದರೋ ದೇವರ ಮಾತುಗಳನ್ನೇ ಆಡುತ್ತಾರೆ. ಏಕೆಂದರೆ ದೇವರು ಅವರಿಗೆ ಆತ್ಮವನ್ನು ಮಿತಿಯಿಲ್ಲದೆ ಕೊಟ್ಟಿದ್ದಾರೆ. <verse eid="JHN 3:34"/><verse number="35" style="v" sid="JHN 3:35"/>ತಂದೆಯು ಪುತ್ರನನ್ನು ಪ್ರೀತಿಸಿ ಎಲ್ಲವನ್ನೂ ಅವರ ಕೈಯಲ್ಲಿ ಕೊಟ್ಟಿದ್ದಾರೆ. <verse eid="JHN 3:35"/><verse number="36" style="v" sid="JHN 3:36"/>ಯಾರು ದೇವಪುತ್ರ ಆಗಿರುವವರನ್ನು ನಂಬುವರೋ ಅವರು ನಿತ್ಯಜೀವ ಪಡೆದಿರುತ್ತಾರೆ. ದೇವಪುತ್ರ ಆಗಿರುವವರನ್ನು ನಂಬದವರು ನಿತ್ಯಜೀವವನ್ನು ಕಾಣುವುದಿಲ್ಲ. ಆದರೆ ದೇವರ ಕೋಪಾಗ್ನಿಯು ಅವರ ಮೇಲೆ ನೆಲೆಗೊಂಡಿರುವುದು,” ಎಂದು ಹೇಳಿದನು.<verse eid="JHN 3:36"/></para>
  <chapter eid="JHN 3"/>
  <chapter number="4" style="c" sid="JHN 4"/>
  <para style="s1">ಯೇಸು ಸಮಾರ್ಯದ ಸ್ತ್ರೀಯೊಂದಿಗೆ ಮಾತನಾಡಿದ್ದು</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 4:1"/>ಫರಿಸಾಯರಲ್ಲಿ ಯೋಹಾನನಿಗಿಂತಲೂ ಯೇಸು ಹೆಚ್ಚಿನ ಶಿಷ್ಯರನ್ನು ಹೊಂದಿದ್ದಾರೆ ಮತ್ತು ದೀಕ್ಷಾಸ್ನಾನ ಮಾಡಿಸುತ್ತಾರೆ ಎಂಬುವುದನ್ನು ಫರಿಸಾಯರು ಕೇಳಿಸಿಕೊಂಡರು. <verse eid="JHN 4:1"/><verse number="2" style="v" sid="JHN 4:2"/>ಆದರೆ ಯೇಸು ತಾವೇ ದೀಕ್ಷಾಸ್ನಾನ ಮಾಡಿಸುತ್ತಿರಲಿಲ್ಲ. ಅವರ ಶಿಷ್ಯರು ಮಾಡಿಸುತ್ತಿದ್ದರು. <verse eid="JHN 4:2"/><verse number="3" style="v" sid="JHN 4:3"/>ಫರಿಸಾಯರು ಕೇಳಿಸಿಕೊಂಡದ್ದನ್ನು ಯೇಸು ತಿಳಿದಾಗ, ಯೇಸು ಯೂದಾಯವನ್ನು ಬಿಟ್ಟು ಗಲಿಲಾಯಕ್ಕೆ ತಿರುಗಿ ಹೊರಟು ಹೋದರು.<verse eid="JHN 4:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="JHN 4:4"/>ಯೇಸು ಸಮಾರ್ಯದ ಮಾರ್ಗವಾಗಿ ಹೋಗಬೇಕಾಗಿತ್ತು. <verse eid="JHN 4:4"/><verse number="5" style="v" sid="JHN 4:5"/>ಯಾಕೋಬನು ತನ್ನ ಮಗನಾದ ಯೋಸೇಫನಿಗೆ ಕೊಟ್ಟ ಭೂಮಿಯ ಸಮೀಪದಲ್ಲಿರುವ ಸುಖರೆಂಬ ಸಮಾರ್ಯದ ಪಟ್ಟಣಕ್ಕೆ ಯೇಸು ಬಂದರು. <verse eid="JHN 4:5"/><verse number="6" style="v" sid="JHN 4:6"/>ಅಲ್ಲಿ ಯಾಕೋಬನ ಬಾವಿ ಇತ್ತು. ಯೇಸು ಪ್ರಯಾಣಮಾಡಿದ್ದರಿಂದ ಆಯಾಸಗೊಂಡವರಾಗಿ ಆ ಬಾವಿಯ ಬಳಿಯಲ್ಲಿ ಕುಳಿತುಕೊಂಡರು. ಆಗ ಹೆಚ್ಚು ಕಡಿಮೆ ಮಧ್ಯಾಹ್ನವಾಗಿತ್ತು.<verse eid="JHN 4:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="JHN 4:7"/>ಆಗ ಸಮಾರ್ಯದವಳಾದ ಒಬ್ಬ ಸ್ತ್ರೀಯು ನೀರು ಸೇದುವುದಕ್ಕಾಗಿ ಬಂದಳು. ಯೇಸು ಆಕೆಗೆ, “ನನಗೆ ಕುಡಿಯುವುದಕ್ಕೆ ನೀರು ಕೊಡು,” ಎಂದರು. <verse eid="JHN 4:7"/><verse number="8" style="v" sid="JHN 4:8"/>ಯೇಸುವಿನ ಶಿಷ್ಯರು ಆಹಾರವನ್ನು ಕೊಂಡುಕೊಳ್ಳಲು ಪಟ್ಟಣದೊಳಕ್ಕೆ ಹೋಗಿದ್ದರು.<verse eid="JHN 4:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="JHN 4:9"/>ಆದ್ದರಿಂದ ಆ ಸಮಾರ್ಯ ಸ್ತ್ರೀಯು ಯೇಸುವಿಗೆ, “ನೀನು ಯೆಹೂದ್ಯನಾಗಿದ್ದು ಸಮಾರ್ಯದ ಸ್ತ್ರೀಯಾದ ನನ್ನಿಂದ ಕುಡಿಯುವುದಕ್ಕೆ ನೀರು ಕೊಡು ಎಂದು ಕೇಳುವುದು ಹೇಗೆ,” ಎಂದಳು. ಏಕೆಂದರೆ ಯೆಹೂದ್ಯರಿಗೂ ಸಮಾರ್ಯದವರಿಗೂ ಒಡನಾಟ ಇರಲಿಲ್ಲ.<note caller="+" style="f"><char style="fr" closed="false">4:9 </char><char style="fq" closed="false">ಒಡನಾಟ ಇರಲಿಲ್ಲ </char><char style="ft" closed="false">ಅಂದರೆ </char><char style="fqa" closed="false">ಸಮಾರ್ಯದವರು ಬಳಸುತ್ತಿದ್ದ ಪಾತ್ರೆಗಳನ್ನು ಯೆಹೂದ್ಯರು ಬಳಸುತ್ತಿರಲಿಲ್ಲ</char></note><verse eid="JHN 4:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="JHN 4:10"/>ಯೇಸು ಆಕೆಗೆ, “ದೇವರ ವರವನ್ನೂ, ‘ಕುಡಿಯುವುದಕ್ಕೆ ನೀರು ಕೊಡು,’ ಎಂದು ಕೇಳುವ ನಾನು ಯಾರೆಂಬುದನ್ನೂ ನೀನು ತಿಳಿದಿದ್ದರೆ ನೀನೇ ನನ್ನಿಂದ ನೀರನ್ನು ಕೇಳುತ್ತಿದ್ದೆ. ನಾನು ನಿನಗೆ ಜೀವಜಲವನ್ನು ಕೊಡುತ್ತಿದ್ದೆನು,” ಎಂದು ಹೇಳಿದರು.<verse eid="JHN 4:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="JHN 4:11"/>ಅದಕ್ಕೆ ಆ ಸ್ತ್ರೀಯು, “ಅಯ್ಯಾ, ನೀರು ಸೇದುವುದಕ್ಕೆ ನಿಮ್ಮ ಹತ್ತಿರ ಏನೂ ಇಲ್ಲವಲ್ಲಾ, ಬಾವಿಯೋ ಆಳವಾಗಿದೆ. ಹೀಗಿರುವಲ್ಲಿ ಜೀವಜಲವು ನಿನಗೆ ಎಲ್ಲಿಂದ ಬಂದೀತು? <verse eid="JHN 4:11"/><verse number="12" style="v" sid="JHN 4:12"/>ಯಾಕೋಬನ ಮಕ್ಕಳು ಮತ್ತು ಪಶುಗಳು ಈ ಬಾವಿಯ ನೀರನ್ನು ಕುಡಿದರು. ಅದನ್ನು ನಮಗೆ ಕೊಟ್ಟ ನಮ್ಮ ತಂದೆ ಯಾಕೋಬನಿಗಿಂತ ನೀನು ದೊಡ್ಡವನೋ?” ಎಂದಳು.<verse eid="JHN 4:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="JHN 4:13"/>ಯೇಸು ಆಕೆಗೆ, “ಈ ನೀರನ್ನು ಕುಡಿಯುವ ಪ್ರತಿಯೊಬ್ಬರಿಗೆ ಪುನಃ ದಾಹವಾಗುವುದು. <verse eid="JHN 4:13"/><verse number="14" style="v" sid="JHN 4:14"/>ಆದರೆ ನಾನು ಕೊಡುವ ನೀರನ್ನು ಕುಡಿಯುವವರಿಗೆ ಎಂದೆಂದಿಗೂ ದಾಹವಾಗದು. ನಾನು ಅವರಿಗೆ ಕೊಡುವ ನೀರು ಅವರಲ್ಲಿ ನಿತ್ಯಜೀವಕ್ಕೆ ಉಕ್ಕುವ ನೀರಿನ ಬುಗ್ಗೆಯಾಗಿರುವುದು,” ಎಂದರು.<verse eid="JHN 4:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="JHN 4:15"/>ಅದಕ್ಕೆ ಆ ಸ್ತ್ರೀಯು, “ಅಯ್ಯಾ, ಆ ನೀರನ್ನೇ ನನಗೆ ಕೊಡು. ಆಗ ನನಗೆ ದಾಹವಾಗುವುದಿಲ್ಲ. ಇನ್ನು ಮುಂದೆ ನಾನು ನೀರು ಸೇದುವುದಕ್ಕೆ ಇಲ್ಲಿಗೆ ಬರುವ ಅವಶ್ಯವಿರುವುದಿಲ್ಲ,” ಎಂದಳು.<verse eid="JHN 4:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 4:16"/>ಯೇಸು ಆಕೆಗೆ, “ಹೋಗಿ ನಿನ್ನ ಗಂಡನನ್ನು ಕರೆದುಕೊಂಡು ಬಾ,” ಎಂದರು.<verse eid="JHN 4:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="JHN 4:17"/>ಅದಕ್ಕೆ ಆ ಸ್ತ್ರೀಯು, “ನನಗೆ ಗಂಡನಿಲ್ಲ,” ಎಂದಳು.</para>
  <para style="p" vid="JHN 4:17">ಯೇಸು ಆಕೆಗೆ, “ನನಗೆ ಗಂಡನಿಲ್ಲ, ಎಂದು ನೀನು ಹೇಳಿದ್ದು ಸರಿಯೇ. <verse eid="JHN 4:17"/><verse number="18" style="v" sid="JHN 4:18"/>ನಿನಗೆ ಐದು ಮಂದಿ ಗಂಡಂದಿರು ಇದ್ದರು. ಈಗ ನಿನಗಿರುವವನು ನಿನ್ನ ಗಂಡನಲ್ಲ, ನೀನು ಹೇಳಿದ್ದು ಸರಿಯೇ,” ಎಂದರು.<verse eid="JHN 4:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="JHN 4:19"/>ಆಗ ಆ ಸ್ತ್ರೀಯು ಯೇಸುವಿಗೆ, “ಅಯ್ಯಾ, ನೀವು ಒಬ್ಬ ಪ್ರವಾದಿಯೆಂದು ನನಗೆ ಕಾಣುತ್ತದೆ. <verse eid="JHN 4:19"/><verse number="20" style="v" sid="JHN 4:20"/>ನಮ್ಮ ಪಿತೃಗಳು ಈ ಬೆಟ್ಟದ ಮೇಲೆ ದೇವರನ್ನು ಆರಾಧಿಸಿದರು. ಆದರೆ, ‘ಆರಾಧಿಸತಕ್ಕ ಸ್ಥಳವು ಯೆರೂಸಲೇಮಿನಲ್ಲಿಯೇ’ ಎಂದು ಯೆಹೂದ್ಯರಾದ ನೀವು ಹೇಳುತ್ತೀರಲ್ಲಾ,” ಎಂದಳು.<verse eid="JHN 4:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="JHN 4:21"/>ಯೇಸು ಆಕೆಗೆ, “ಅಮ್ಮಾ, ನನ್ನನ್ನು ನಂಬು, ಈ ಬೆಟ್ಟದಲ್ಲಿಯಾಗಲಿ ಯೆರೂಸಲೇಮಿನಲ್ಲಾಗಲಿ ನೀವು ತಂದೆಯನ್ನು ಆರಾಧಿಸದೆ ಇರುವ ಕಾಲ ಬರುತ್ತದೆ. <verse eid="JHN 4:21"/><verse number="22" style="v" sid="JHN 4:22"/>ನೀವು ಸಮಾರ್ಯದವರು ಅರಿಯದೆ ಇರುವುದನ್ನು ಆರಾಧಿಸುತ್ತೀರಿ. ನಾವು ಅರಿತಿರುವುದನ್ನೇ ಆರಾಧಿಸುವವರು. ಏಕೆಂದರೆ ರಕ್ಷಣೆಯು ಯೆಹೂದ್ಯರಿಂದಲೇ. <verse eid="JHN 4:22"/><verse number="23" style="v" sid="JHN 4:23"/>ಆದರೆ ನಿಜವಾದ ಆರಾಧಕರು ತಂದೆಯನ್ನು ಆತ್ಮದಿಂದಲೂ ಸತ್ಯದಿಂದಲೂ ಆರಾಧಿಸುವ ಕಾಲ ಬರುತ್ತದೆ; ಅದು ಈಗಲೇ ಬಂದಿದೆ. ಏಕೆಂದರೆ ತಂದೆಯು ನಿಜವಾಗಿಯೂ ಈ ರೀತಿ ಆರಾಧಿಸುವವರನ್ನೇ ಹುಡುಕುತ್ತಾರೆ. <verse eid="JHN 4:23"/><verse number="24" style="v" sid="JHN 4:24"/>ದೇವರು ಆತ್ಮರಾಗಿದ್ದಾರೆ. ಅವರನ್ನು ಆರಾಧಿಸುವವರು ಆತ್ಮದಿಂದಲೂ ಸತ್ಯದಿಂದಲೂ ಆರಾಧಿಸಬೇಕು,” ಎಂದರು.<verse eid="JHN 4:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 4:25"/>ಆ ಸ್ತ್ರೀಯು ಯೇಸುವಿಗೆ, “ಕ್ರಿಸ್ತ ಎಂದು ಕರೆಯಲಾಗುವ ಮೆಸ್ಸೀಯ ಬರುತ್ತಾರೆಂದು ನಾನು ಬಲ್ಲೆನು. ಅವರು ಬಂದಾಗ ನಮಗೆ ಎಲ್ಲವನ್ನೂ ತಿಳಿಸುವರು,” ಎಂದಳು.<verse eid="JHN 4:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="JHN 4:26"/>ಯೇಸು ಆಕೆಗೆ, “ನಿನ್ನೊಂದಿಗೆ ಮಾತನಾಡುವ ನಾನೇ ಆತನು!” ಎಂದರು.<verse eid="JHN 4:26"/></para>
  <para style="s1">ಶಿಷ್ಯರು ಯೇಸುವಿನ ಹತ್ತಿರ ತಿರುಗಿ ಬಂದದ್ದು</para>
  <para style="p">
    <verse number="27" style="v" sid="JHN 4:27"/>ಅಷ್ಟರೊಳಗೆ ಅವರ ಶಿಷ್ಯರು ಬಂದು ಯೇಸು ಆ ಸ್ತ್ರೀಯೊಂದಿಗೆ ಮಾತನಾಡುತ್ತಿರುವುದನ್ನು ಕಂಡು ಆಶ್ಚರ್ಯಪಟ್ಟರು. ಆದರೂ, “ನಿಮಗೆ ಏನು ಬೇಕು? ಆಕೆಯೊಂದಿಗೆ ಏಕೆ ಮಾತನಾಡುತ್ತಿರುವಿರಿ?” ಎಂದು ಒಬ್ಬನಾದರೂ ಕೇಳಲಿಲ್ಲ.<verse eid="JHN 4:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="JHN 4:28"/>ಆ ಸ್ತ್ರೀಯು ತನ್ನ ನೀರಿನ ಕೊಡವನ್ನು ಅಲ್ಲಿಯೇ ಬಿಟ್ಟು ಪಟ್ಟಣದೊಳಕ್ಕೆ ಹೊರಟುಹೋಗಿ ಜನರಿಗೆ, <verse eid="JHN 4:28"/><verse number="29" style="v" sid="JHN 4:29"/>“ಬನ್ನಿರಿ, ನಾನು ಮಾಡಿದವುಗಳನ್ನೆಲ್ಲಾ ನನಗೆ ತಿಳಿಸಿದ ವ್ಯಕ್ತಿಯನ್ನು ಕಾಣಿರಿ, ಬರತಕ್ಕ ಕ್ರಿಸ್ತ ಇವರೇ ಆಗಿರಬಹುದು?” ಎಂದಳು. <verse eid="JHN 4:29"/><verse number="30" style="v" sid="JHN 4:30"/>ಆಗ ಅವರು ಪಟ್ಟಣದಿಂದ ಯೇಸುವಿನ ಬಳಿಗೆ ಬಂದರು.<verse eid="JHN 4:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="JHN 4:31"/>ಆ ಸಮಯದಲ್ಲಿ ಶಿಷ್ಯರು, “ಗುರುವೇ ಊಟಮಾಡಿರಿ,” ಎಂದು ಯೇಸುವನ್ನು ಕೇಳಿಕೊಂಡರು.<verse eid="JHN 4:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="JHN 4:32"/>ಆದರೆ ಯೇಸು ಅವರಿಗೆ, “ನಿಮಗೆ ತಿಳಿಯದಿರುವ ಆಹಾರವು ನನ್ನಲ್ಲಿದೆ,” ಎಂದರು.<verse eid="JHN 4:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="JHN 4:33"/>ಶಿಷ್ಯರು, “ಯಾರಾದರೂ ಅವರಿಗೆ ಏನಾದರೂ ತಿನ್ನುವುದಕ್ಕೆ ತಂದು ಕೊಟ್ಟರೋ?” ಎಂದು ಒಬ್ಬರಿಗೊಬ್ಬರು ಮಾತನಾಡಿಕೊಂಡರು.<verse eid="JHN 4:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="JHN 4:34"/>ಯೇಸು ಅವರಿಗೆ, “ನನ್ನನ್ನು ಕಳುಹಿಸಿದ ತಂದೆಯ ಚಿತ್ತವನ್ನು ಮಾಡಿ ಅವರ ಕೆಲಸವನ್ನು ಪೂರೈಸುವುದೇ ನನ್ನ ಆಹಾರ. <verse eid="JHN 4:34"/><verse number="35" style="v" sid="JHN 4:35"/>ನೀವು, ‘ಇನ್ನೂ ನಾಲ್ಕು ತಿಂಗಳುಗಳಾದ ಮೇಲೆ ಸುಗ್ಗಿಯು ಬರುತ್ತದೆ’ ಎಂದು ಹೇಳುವುದಿಲ್ಲವೇ? ಮತ್ತು ಇಗೋ, ನಿಮ್ಮ ಕಣ್ಣೆತ್ತಿ ಹೊಲಗಳನ್ನು ನೋಡಿರಿ. ಏಕೆಂದರೆ ಅವು ಈಗಾಗಲೇ ಸುಗ್ಗಿಗೆ ಸಿದ್ಧವಾಗಿವೆ. <verse eid="JHN 4:35"/><verse number="36" style="v" sid="JHN 4:36"/>ಕೊಯ್ಯುವವನು ಕೂಲಿಯನ್ನು ಪಡೆದು ನಿತ್ಯಜೀವಕ್ಕಾಗಿ ಫಲವನ್ನು ಕೂಡಿಸಿಕೊಳ್ಳುತ್ತಾನೆ; ಹೀಗೆ ಬಿತ್ತುವವನೂ ಕೊಯ್ಯುವವನೂ ಒಟ್ಟಿಗೆ ಸಂತೋಷಿಸುವರು. <verse eid="JHN 4:36"/><verse number="37" style="v" sid="JHN 4:37"/>‘ಬಿತ್ತುವವನೊಬ್ಬನು, ಕೊಯ್ಯುವವನು ಬೇರೊಬ್ಬನು,’ ಎಂದು ಹೇಳುವ ಮಾತು ಇದರಲ್ಲಿ ಸತ್ಯವಾಗಿದೆ. <verse eid="JHN 4:37"/><verse number="38" style="v" sid="JHN 4:38"/>ನೀವು ಪ್ರಯಾಸ ಪಡದಂಥದ್ದನ್ನು ಕೊಯ್ಯುವುದಕ್ಕೆ ನಾನು ನಿಮ್ಮನ್ನು ಕಳುಹಿಸಿದೆನು. ಇತರರು ಪ್ರಯಾಸಪಟ್ಟರು. ನೀವು ಅವರ ಪ್ರಯಾಸದ ಫಲವನ್ನು ಪಡೆದಿದ್ದೀರಿ,” ಎಂದರು.<verse eid="JHN 4:38"/></para>
  <para style="s1">ಸಮಾರ್ಯದವರು ಅನೇಕರು ನಂಬಿದ್ದು</para>
  <para style="p">
    <verse number="39" style="v" sid="JHN 4:39"/>ಆಗ, “ನಾನು ಮಾಡಿದ್ದೆಲ್ಲವನ್ನು ಆತನು ನನಗೆ ತಿಳಿಸಿದನು” ಎಂದು ಸಾಕ್ಷಿಕೊಟ್ಟ ಆ ಸ್ತ್ರೀಯ ಮಾತಿನಿಂದ ಆ ಪಟ್ಟಣದ ಅನೇಕ ಸಮಾರ್ಯದವರು ಯೇಸುವಿನಲ್ಲಿ ನಂಬಿಕೆ ಇಟ್ಟರು. <verse eid="JHN 4:39"/><verse number="40" style="v" sid="JHN 4:40"/>ಆ ಸಮಾರ್ಯದವರು ಯೇಸುವಿನ ಬಳಿಗೆ ಬಂದು ತಮ್ಮೊಂದಿಗೆ ಇರಬೇಕೆಂದು ಅವರನ್ನು ಬೇಡಿಕೊಂಡರು. ಹೀಗೆ ಯೇಸು ಎರಡು ದಿವಸ ಅಲ್ಲಿಯೇ ಉಳಿದರು. <verse eid="JHN 4:40"/><verse number="41" style="v" sid="JHN 4:41"/>ಇನ್ನೂ ಹೆಚ್ಚು ಜನರು ಯೇಸುವಿನ ವಾಕ್ಯದ ದೆಸೆಯಿಂದ ನಂಬಿದರು.<verse eid="JHN 4:41"/></para>
  <para style="p">
    <verse number="42" style="v" sid="JHN 4:42"/>ಜನರು ಆ ಸ್ತ್ರೀಗೆ, “ನಾವು ಇನ್ನು ಮುಂದೆ ನಂಬುವುದು ನಿನ್ನ ಮಾತಿನಿಂದಲ್ಲ. ಏಕೆಂದರೆ ನಾವೇ ಸ್ವತಃ ಕೇಳಿದ್ದೇವೆ. ಈತನು ನಿಜವಾಗಿಯೂ ಲೋಕ ರಕ್ಷಕನೆಂದು ತಿಳಿದಿದ್ದೇವೆ,” ಎಂದರು.<verse eid="JHN 4:42"/></para>
  <para style="s1">ಅಧಿಕಾರಿಯ ಮಗನನ್ನು ಯೇಸು ಗುಣಪಡಿಸಿದ್ದು</para>
  <para style="p">
    <verse number="43" style="v" sid="JHN 4:43"/>ಎರಡು ದಿವಸಗಳಾದ ಮೇಲೆ ಯೇಸು ಅಲ್ಲಿಂದ ಹೊರಟು ಗಲಿಲಾಯಕ್ಕೆ ಹೋದರು. <verse eid="JHN 4:43"/><verse number="44" style="v" sid="JHN 4:44"/>ಪ್ರವಾದಿಗೆ ತನ್ನ ಸ್ವದೇಶದಲ್ಲಿ ಮರ್ಯಾದೆ ಇಲ್ಲವೆಂದು ಯೇಸು ತಾವೇ ಹೇಳಿದ್ದರು. <verse eid="JHN 4:44"/><verse number="45" style="v" sid="JHN 4:45"/>ಯೇಸು ಗಲಿಲಾಯವನ್ನು ತಲುಪಿದಾಗ ಗಲಿಲಾಯದವರು ಅವರನ್ನು ಸ್ವಾಗತಿಸಿದರು. ಪಸ್ಕಹಬ್ಬದ ಸಮಯದಲ್ಲಿ ಯೇಸು ಯೆರೂಸಲೇಮಿನಲ್ಲಿ ಮಾಡಿದವುಗಳನ್ನೆಲ್ಲಾ ಕಂಡಿದ್ದರು.<verse eid="JHN 4:45"/></para>
  <para style="p">
    <verse number="46" style="v" sid="JHN 4:46"/>ಯೇಸು ತಾನು ನೀರನ್ನು ದ್ರಾಕ್ಷಾರಸವನ್ನಾಗಿ ಮಾಡಿದ ಗಲಿಲಾಯದ ಕಾನಾ ಊರಿಗೆ ತಿರುಗಿ ಬಂದರು. ಆಗ ಕಪೆರ್ನೌಮಿನಲ್ಲಿದ್ದ ಒಬ್ಬ ಅಧಿಕಾರಿಯ ಮಗನು ಅಸ್ವಸ್ಥನಾಗಿದ್ದನು. <verse eid="JHN 4:46"/><verse number="47" style="v" sid="JHN 4:47"/>ಯೇಸು ಯೂದಾಯದಿಂದ ಗಲಿಲಾಯಕ್ಕೆ ಬಂದಿರುವುದನ್ನು ಅವನು ಕೇಳಿದಾಗ ಅವರ ಬಳಿಗೆ ಹೋಗಿ, ಯೇಸು ಬಂದು ತನ್ನ ಮಗನನ್ನು ಸ್ವಸ್ಥಪಡಿಸಬೇಕೆಂದು ಬೇಡಿಕೊಂಡನು. ಏಕೆಂದರೆ ಅವನ ಮಗನು ಸಾಯುವ ಸ್ಥಿತಿಯಲ್ಲಿದ್ದನು.<verse eid="JHN 4:47"/></para>
  <para style="p">
    <verse number="48" style="v" sid="JHN 4:48"/>ಯೇಸು ಅವನಿಗೆ, “ನೀವು ಸೂಚಕಕಾರ್ಯಗಳನ್ನೂ ಅದ್ಭುತಕಾರ್ಯಗಳನ್ನೂ ಕಾಣದ ಹೊರತು ನಂಬುವುದೇ ಇಲ್ಲ,” ಎಂದರು.<verse eid="JHN 4:48"/></para>
  <para style="p">
    <verse number="49" style="v" sid="JHN 4:49"/>ಆಗ ಆ ಅಧಿಕಾರಿಯು ಯೇಸುವಿಗೆ, “ಅಯ್ಯಾ, ನನ್ನ ಮಗನು ಸಾಯುವ ಮೊದಲೇ ಬನ್ನಿರಿ,” ಎಂದನು.<verse eid="JHN 4:49"/></para>
  <para style="p">
    <verse number="50" style="v" sid="JHN 4:50"/>ಯೇಸು ಅವನಿಗೆ, “ಹೋಗು, ನಿನ್ನ ಮಗನು ಬದುಕುವನು,” ಎಂದರು.</para>
  <para style="p" vid="JHN 4:50">ಆ ಮನುಷ್ಯನು ಯೇಸು ತನಗೆ ಹೇಳಿದ ಮಾತನ್ನು ನಂಬಿ ಹೊರಟುಹೋದನು. <verse eid="JHN 4:50"/><verse number="51" style="v" sid="JHN 4:51"/>ಹೀಗೆ ಅವನು ಇಳಿದು ಹೋಗುತ್ತಿರುವಾಗಲೇ ಸೇವಕರು ಅವನನ್ನು ಸಂಧಿಸಿ, ಅವನ ಮಗನು ಬದುಕಿರುವುದಾಗಿ ಅವನಿಗೆ ಹೇಳಿದರು. <verse eid="JHN 4:51"/><verse number="52" style="v" sid="JHN 4:52"/>ಅವನು, “ಯಾವ ಸಮಯದಲ್ಲಿ ಮಗನು ಚೇತರಿಸಿಕೊಂಡನು?” ಎಂದು ಅವರನ್ನು ವಿಚಾರಿಸಿದಾಗ ಅವರು, “ನಿನ್ನೆ ಮಧ್ಯಾಹ್ನ ಒಂದು ಗಂಟೆಗೆ ಜ್ವರವು ಬಿಟ್ಟಿತು,” ಎಂದು ಸೇವಕರು ಅವನಿಗೆ ಹೇಳಿದರು.<verse eid="JHN 4:52"/></para>
  <para style="p">
    <verse number="53" style="v" sid="JHN 4:53"/>ಹೀಗೆ, “ನಿನ್ನ ಮಗನು ಬದುಕುವನು” ಎಂದು ಯೇಸು ತನಗೆ ಹೇಳಿದ ಸಮಯದಯಲ್ಲಿಯೇ ಅದು ಆಯಿತೆಂದು ತಂದೆಯು ತಿಳಿದುಕೊಂಡು, ಅವನೂ ಅವನ ಮನೆಯವರೆಲ್ಲರೂ ಯೇಸುವನ್ನು ನಂಬಿದರು.<verse eid="JHN 4:53"/></para>
  <para style="p">
    <verse number="54" style="v" sid="JHN 4:54"/>ಇದು ಯೇಸು ಯೂದಾಯದಿಂದ ಗಲಿಲಾಯಕ್ಕೆ ಬಂದ ಮೇಲೆ ಮಾಡಿದ ಎರಡನೆಯ ಸೂಚಕಕಾರ್ಯ.<verse eid="JHN 4:54"/></para>
  <chapter eid="JHN 4"/>
  <chapter number="5" style="c" sid="JHN 5"/>
  <para style="s1">ಮೂವತ್ತೆಂಟು ವರ್ಷದ ರೋಗಿಯ ಸ್ವಸ್ಥತೆ</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 5:1"/>ಇದಾದ ಮೇಲೆ ಯೆಹೂದ್ಯರ ಹಬ್ಬವೊಂದು ಬಂತು. ಆದ್ದರಿಂದ, ಯೇಸು ಯೆರೂಸಲೇಮಿಗೆ ಹೋದರು. <verse eid="JHN 5:1"/><verse number="2" style="v" sid="JHN 5:2"/>ಯೆರೂಸಲೇಮಿನಲ್ಲಿ “ಕುರಿಬಾಗಿಲು” ಎಂಬ ಸ್ಥಳದ ಬಳಿ ಒಂದು ಕೊಳವಿದೆ. ಇದನ್ನು ಹೀಬ್ರೂ ಭಾಷೆಯಲ್ಲಿ ಬೇತ್ಸಥಾ<note caller="+" style="f"><char style="fr" closed="false">5:2 </char><char style="ft" closed="false">ಅರಾಮಿಕ್ ಭಾಷೆಯಲ್ಲಿ </char><char style="fqa" closed="false">ಕರುಣಾಭವನ </char><char style="ft" closed="false">ಎಂದು ಅರ್ಥ</char></note> ಎಂದು ಕರೆಯುತ್ತಾರೆ. ಅದಕ್ಕೆ ಐದು ಮಂಟಪಗಳಿದ್ದವು. <verse eid="JHN 5:2"/><verse number="3" style="v" sid="JHN 5:3"/>ಅವುಗಳಲ್ಲಿ ಅಸ್ವಸ್ಥರೂ ಕುರುಡರೂ ಕುಂಟರೂ ಪಾರ್ಶ್ವವಾಯು ಪೀಡಿತರೂ ಆಗಿದ್ದವರ ದೊಡ್ಡ ಸಮೂಹವೇ ಬಿದ್ದುಕೊಂಡು, <char style="it">ನೀರು ಉಕ್ಕುವುದನ್ನೇ ಕಾದು ನೋಡುತ್ತಿದ್ದರು.</char> <verse eid="JHN 5:3"/><verse number="4" style="v" sid="JHN 5:4"/><char style="it">ಏಕೆಂದರೆ ಕೆಲವೊಮ್ಮೆ ದೇವದೂತನು ಇಳಿದುಬಂದು ನೀರನ್ನು ಕಲಕುತ್ತಿದ್ದನು. ನೀರು ಕಲಕಿದೊಡನೆ ಮೊದಲು ಯಾರು ನೀರಿನೊಳಗೆ ಹೆಜ್ಜೆಯಿಡುತ್ತಿದ್ದರೋ ಅವರಿಗೆ ಯಾವ ರೋಗವಿದ್ದರೂ ಅದು ಗುಣವಾಗುತ್ತಿತ್ತು.</char><note caller="+" style="f"><char style="fr" closed="false">5:4 </char><char style="ft" closed="false">ಕೆಲವು ಮೂಲ ಹಸ್ತಪ್ರತಿಗಳಲ್ಲಿ ಈ ವಾಕ್ಯ ಸೇರ್ಪಡೆಯಾಗಿರುವುದಿಲ್ಲ.</char></note> <verse eid="JHN 5:4"/><verse number="5" style="v" sid="JHN 5:5"/>ಆಗ ಮೂವತ್ತೆಂಟು ವರ್ಷದಿಂದ ರೋಗಿಯಾಗಿದ್ದ ಒಬ್ಬ ಮನುಷ್ಯನು ಅಲ್ಲಿ ಇದ್ದನು. <verse eid="JHN 5:5"/><verse number="6" style="v" sid="JHN 5:6"/>ಅವನು ಬಿದ್ದುಕೊಂಡಿರುವುದನ್ನು ಯೇಸು ಕಂಡು ಅವನು ಈಗಾಗಲೇ ಬಹುಕಾಲದಿಂದ ಆ ಸ್ಥಿತಿಯಲ್ಲಿದ್ದಾನೆಂದು ತಿಳಿದು ಅವನಿಗೆ, “ನಿನಗೆ ಗುಣಹೊಂದಲು ಮನಸ್ಸಿದೆಯೋ?” ಎಂದು ಕೇಳಿದರು.<verse eid="JHN 5:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="JHN 5:7"/>ಅದಕ್ಕೆ ಆ ರೋಗಿಯು ಯೇಸುವಿಗೆ, “ಸ್ವಾಮಿ, ನೀರು ಉಕ್ಕುವಾಗ ನನ್ನನ್ನು ಕೊಳದೊಳಗೆ ಇಳಿಸುವುದಕ್ಕೆ ನನಗೆ ಯಾರೂ ಇಲ್ಲ. ಆದರೆ ನಾನು ಹೋಗುತ್ತಿರುವಾಗಲೇ ನನಗಿಂತ ಮುಂದಾಗಿ ಮತ್ತೊಬ್ಬನು ಹೋಗುತ್ತಾನೆ,” ಎಂದನು.<verse eid="JHN 5:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="JHN 5:8"/>ಯೇಸು ಅವನಿಗೆ, “ಎದ್ದು ನಿನ್ನ ಹಾಸಿಗೆಯನ್ನು ತೆಗೆದುಕೊಂಡು ನಡೆ,” ಎಂದರು. <verse eid="JHN 5:8"/><verse number="9" style="v" sid="JHN 5:9"/>ಕೂಡಲೇ ಆ ಮನುಷ್ಯನು ಸ್ವಸ್ಥನಾಗಿ ತನ್ನ ಹಾಸಿಗೆಯನ್ನು ತೆಗೆದುಕೊಂಡು ನಡೆದನು.</para>
  <para style="p" vid="JHN 5:9">ಆ ದಿನವು ಸಬ್ಬತ್ ದಿನವಾಗಿತ್ತು. <verse eid="JHN 5:9"/><verse number="10" style="v" sid="JHN 5:10"/>ಆದ್ದರಿಂದ ಯೆಹೂದ್ಯರು ಸ್ವಸ್ಥನಾದವನಿಗೆ, “ಇದು ಸಬ್ಬತ್ ದಿನ ನೀನು ಹಾಸಿಗೆಯನ್ನು ಹೊತ್ತುಕೊಂಡು ನಡೆಯುವುದಕ್ಕೆ ನಿಷೇಧವಿದೆ,” ಎಂದರು.<verse eid="JHN 5:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="JHN 5:11"/>ಆದರೆ ಅವನು ಅವರಿಗೆ, “ನನ್ನನ್ನು ಸ್ವಸ್ಥಪಡಿಸಿದವರೇ, ‘ನಿನ್ನ ಹಾಸಿಗೆಯನ್ನು ಎತ್ತಿಕೊಂಡು ನಡೆ’ ಎಂದು ನನಗೆ ಹೇಳಿದ್ದಾರೆ,” ಎಂದನು.<verse eid="JHN 5:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 5:12"/>ಅದಕ್ಕೆ ಯೆಹೂದ್ಯರು ಅವನಿಗೆ, “ ‘ಅದನ್ನು ಎತ್ತಿಕೊಂಡು ನಡೆ,’ ಎಂದು ನಿನಗೆ ಹೇಳಿದ ಮನುಷ್ಯನು ಯಾರು?” ಎಂದು ಕೇಳಿದರು.<verse eid="JHN 5:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="JHN 5:13"/>ಆದರೆ ಆ ವ್ಯಕ್ತಿ ಯಾರೆಂದು ಸ್ವಸ್ಥನಾದವನಿಗೆ ತಿಳಿದಿರಲಿಲ್ಲ. ಏಕೆಂದರೆ ಆ ಸ್ಥಳದಲ್ಲಿ ಜನಸಮೂಹವು ಇದ್ದುದರಿಂದ ಯೇಸು ಅಲ್ಲಿಂದ ಮರೆಯಾಗಿಬಿಟ್ಟಿದ್ದರು.<verse eid="JHN 5:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="JHN 5:14"/>ತರುವಾಯ ಯೇಸು ಅವನನ್ನು ದೇವಾಲಯದಲ್ಲಿ ಕಂಡು ಅವನಿಗೆ, “ಇಗೋ, ನೀನು ಸ್ವಸ್ಥನಾಗಿರುವೆ, ಹೆಚ್ಚಿನ ಕೇಡು ಬಾರದಂತೆ ಇನ್ನು ಮೇಲೆ ಪಾಪ ಮಾಡಬೇಡ,” ಎಂದರು. <verse eid="JHN 5:14"/><verse number="15" style="v" sid="JHN 5:15"/>ಆಗ ಅವನು ಹೊರಟುಹೋಗಿ ತನ್ನನ್ನು ಸ್ವಸ್ಥಪಡಿಸಿದವರು ಯೇಸುವೇ ಎಂದು ಯೆಹೂದ್ಯರಿಗೆ ತಿಳಿಸಿದನು.<verse eid="JHN 5:15"/></para>
  <para style="s1">ದೇವಪುತ್ರ ಆಗಿರುವವರ ಮೂಲಕ ಜೀವ</para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 5:16"/>ಯೇಸು ಇವುಗಳನ್ನು ಸಬ್ಬತ್ ದಿನದಲ್ಲಿ ಮಾಡಿದ ಕಾರಣ ಯೆಹೂದ್ಯರು ಯೇಸುವನ್ನು ಹಿಂಸಿಸತೊಡಗಿದರು. <verse eid="JHN 5:16"/><verse number="17" style="v" sid="JHN 5:17"/>ಯೇಸು ಅವರಿಗೆ, “ನನ್ನ ತಂದೆ ಯಾವಾಗಲೂ ಕೆಲಸ ಮಾಡುತ್ತಾರೆ. ನಾನೂ ಕೆಲಸ ಮಾಡುತ್ತೇನೆ,” ಎಂದರು. <verse eid="JHN 5:17"/><verse number="18" style="v" sid="JHN 5:18"/>ಯೇಸು ಸಬ್ಬತ್ ದಿನವನ್ನು ಮುರಿದದ್ದು ಅಲ್ಲದೆ ದೇವರನ್ನು ತಮ್ಮ ಸ್ವಂತ ತಂದೆ ಎಂದು ಹೇಳಿ ತಮ್ಮನ್ನು ದೇವರಿಗೆ ಸಮಾನ ಮಾಡಿಕೊಂಡ ಕಾರಣ ಯೆಹೂದ್ಯರು ಯೇಸುವನ್ನು ಕೊಲ್ಲುವುದಕ್ಕೆ ಇನ್ನಷ್ಟು ಪ್ರಯತ್ನಮಾಡಿದರು.<verse eid="JHN 5:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="JHN 5:19"/>ಯೇಸು ಅವರಿಗೆ, “ನಾನು ನಿಮಗೆ ನಿಜನಿಜವಾಗಿ ಹೇಳುತ್ತೇನೆ, ತಂದೆಯು ಮಾಡುವುದನ್ನು ಕಂಡು ಪುತ್ರನು ಮಾಡುತ್ತಾನೆ ಹೊರತು ಪುತ್ರನು ತನ್ನಷ್ಟಕ್ಕೆ ತಾನೇ ಏನೂ ಮಾಡಲಾರನು. ಏಕೆಂದರೆ ತಂದೆ ಯಾವುದನ್ನೆಲ್ಲಾ ಮಾಡುವರೋ ಹಾಗೆಯೇ ಪುತ್ರನೂ ಮಾಡುವನು. <verse eid="JHN 5:19"/><verse number="20" style="v" sid="JHN 5:20"/>ತಂದೆ ಪುತ್ರನನ್ನು ಪ್ರೀತಿಸಿ ತಾನು ಮಾಡುವುದನ್ನೆಲ್ಲಾ ಪುತ್ರನಿಗೆ ತೋರಿಸುತ್ತಾರೆ. ನೀವು ಆಶ್ಚರ್ಯಪಡುವಂತೆ ಇವುಗಳಿಗಿಂತ ಮಹತ್ತಾದ ಕೆಲಸಗಳನ್ನು ಪುತ್ರನಿಗೆ ತೋರಿಸುವರು. <verse eid="JHN 5:20"/><verse number="21" style="v" sid="JHN 5:21"/>ತಂದೆ ಸತ್ತವರನ್ನು ಎಬ್ಬಿಸಿ ಬದುಕಿಸುವಂತೆಯೇ ಪುತ್ರನೂ ತನಗಿಷ್ಟ ಬಂದವರನ್ನು ಬದುಕಿಸುತ್ತಾರೆ. <verse eid="JHN 5:21"/><verse number="22" style="v" sid="JHN 5:22"/>ತಂದೆ ಯಾರಿಗೂ ತೀರ್ಪು ಮಾಡುವುದಿಲ್ಲ. ಆದರೆ ತೀರ್ಪು ಮಾಡುವುದನ್ನೆಲ್ಲಾ ಪುತ್ರನಿಗೆ ಒಪ್ಪಿಸಿದ್ದಾರೆ. <verse eid="JHN 5:22"/><verse number="23" style="v" sid="JHN 5:23"/>ಎಲ್ಲರೂ ತಂದೆಯನ್ನು ಸನ್ಮಾನಿಸುವಂತೆಯೇ ಪುತ್ರನನ್ನೂ ಸನ್ಮಾನಿಸಬೇಕು. ಪುತ್ರನನ್ನು ಸನ್ಮಾನಿಸದವನು ಆತನನ್ನು ಕಳುಹಿಸಿದ ತಂದೆಯನ್ನೂ ಸನ್ಮಾನಿಸುವುದಿಲ್ಲ.<verse eid="JHN 5:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="JHN 5:24"/>“ನಾನು ನಿಮಗೆ ನಿಜನಿಜವಾಗಿ ಹೇಳುತ್ತೇನೆ, ನನ್ನ ವಾಕ್ಯವನ್ನು ಕೇಳಿ ನನ್ನನ್ನು ಕಳುಹಿಸಿದ ತಂದೆಯನ್ನು ನಂಬುವವರು ನಿತ್ಯಜೀವವನ್ನು ಹೊಂದಿದ್ದಾರೆ. ಅವರು ನ್ಯಾಯತೀರ್ಪಿಗೆ ಗುರಿಯಾಗುವುದಿಲ್ಲ, ಮರಣದಿಂದ ಪಾರಾಗಿ ಜೀವವನ್ನು ಹೊಂದಿದ್ದಾರೆ. <verse eid="JHN 5:24"/><verse number="25" style="v" sid="JHN 5:25"/>ನಾನು ನಿಮಗೆ ನಿಜನಿಜವಾಗಿ ಹೇಳುತ್ತೇನೆ, ಸತ್ತವರು ದೇವಪುತ್ರನ ಸ್ವರವನ್ನು ಕೇಳುವ ಕಾಲ ಬರುತ್ತದೆ. ಈಗಾಗಲೇ ಬಂದಿದೆ. ಈ ಸ್ವರವನ್ನು ಕೇಳುವವರು ಬದುಕುವರು. <verse eid="JHN 5:25"/><verse number="26" style="v" sid="JHN 5:26"/>ತಂದೆಯು ಸ್ವತಃ ಜೀವವುಳ್ಳವರಾಗಿರುವಂತೆಯೇ ಪುತ್ರನೂ ಸಹ ಸ್ವತಃ ಜೀವವುಳ್ಳವನಾಗಿರುವಂತೆ ಅನುಗ್ರಹ ಮಾಡಿದ್ದಾರೆ. <verse eid="JHN 5:26"/><verse number="27" style="v" sid="JHN 5:27"/>ನಾನು ಮನುಷ್ಯಪುತ್ರನಾಗಿರುವುದರಿಂದ ನ್ಯಾಯತೀರಿಸುವ ಅಧಿಕಾರವನ್ನು ತಂದೆ ನನಗೆ ಕೊಟ್ಟಿದ್ದಾರೆ.<verse eid="JHN 5:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="JHN 5:28"/>“ಇದಕ್ಕೆ ಆಶ್ಚರ್ಯಪಡಬೇಡಿರಿ, ಆಗ ಸಮಾಧಿಗಳಲ್ಲಿ ಇರುವವರೆಲ್ಲರೂ ನನ್ನ ಸ್ವರವನ್ನು ಕೇಳಿ ಹೊರಗೆ ಬರುವ ಒಂದುಕಾಲ ಬರುತ್ತದೆ. <verse eid="JHN 5:28"/><verse number="29" style="v" sid="JHN 5:29"/>ಒಳ್ಳೆಯದನ್ನು ಮಾಡಿದವರು ಜೀವಕ್ಕಾಗಿ ಪುನರುತ್ಥಾನವನ್ನೂ ಕೆಟ್ಟದ್ದನ್ನು ಮಾಡಿದವರು ನ್ಯಾಯತೀರ್ಪಿಗಾಗಿ ಪುನರುತ್ಥಾನವನ್ನೂ ಹೊಂದುವರು. <verse eid="JHN 5:29"/><verse number="30" style="v" sid="JHN 5:30"/>ನನ್ನಷ್ಟಕ್ಕೆ ನಾನೇ ಏನೂ ಮಾಡಲಾರೆನು. ನಾನು ಕೇಳಿರುವಂತೆಯೇ ತೀರ್ಪು ಮಾಡುತ್ತೇನೆ. ನನ್ನ ತೀರ್ಪು ನ್ಯಾಯವಾದದ್ದು. ಏಕೆಂದರೆ ನಾನು ನನ್ನ ಚಿತ್ತವನ್ನಲ್ಲ, ನನ್ನನ್ನು ಕಳುಹಿಸಿದ ತಂದೆಯ ಚಿತ್ತವನ್ನೇ ನೆರವೇರಿಸಲು ಅಪೇಕ್ಷಿಸುತ್ತೇನೆ.<verse eid="JHN 5:30"/></para>
  <para style="s1">ಯೇಸುವನ್ನು ಕುರಿತು ಸಾಕ್ಷಿ</para>
  <para style="p">
    <verse number="31" style="v" sid="JHN 5:31"/>“ನನ್ನನ್ನು ಕುರಿತು ನಾನೇ ಸಾಕ್ಷಿಹೇಳಿಕೊಂಡರೆ ನನ್ನ ಸಾಕ್ಷಿಯು ಸತ್ಯವಾದದ್ದಲ್ಲ. <verse eid="JHN 5:31"/><verse number="32" style="v" sid="JHN 5:32"/>ನನ್ನನ್ನು ಕುರಿತು ಸಾಕ್ಷಿಕೊಡುವವರು ಬೇರೊಬ್ಬರಿದ್ದಾರೆ. ಅವರು ನನ್ನ ವಿಷಯದಲ್ಲಿ ಕೊಡುವ ಸಾಕ್ಷಿಯೇ ಸತ್ಯವಾದುದೆಂದು ನಾನು ಬಲ್ಲೆನು.<verse eid="JHN 5:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="JHN 5:33"/>“ನೀವು ಯೋಹಾನನ ಬಳಿಗೆ ದೂತರನ್ನು ಕಳುಹಿಸಿದಿರಿ. ಅವನು ಸತ್ಯಕ್ಕೆ ಸಾಕ್ಷಿಕೊಟ್ಟನು. <verse eid="JHN 5:33"/><verse number="34" style="v" sid="JHN 5:34"/>ನಾನಾದರೋ ಮಾನವರ ಸಾಕ್ಷಿಯನ್ನು ಸ್ವೀಕರಿಸುವುದಿಲ್ಲ. ಆದರೆ ನೀವು ರಕ್ಷಣೆ ಹೊಂದುವಂತೆ ನಾನು ಇವುಗಳನ್ನು ಹೇಳುತ್ತೇನೆ. <verse eid="JHN 5:34"/><verse number="35" style="v" sid="JHN 5:35"/>ಯೋಹಾನನು ಉರಿದು ಪ್ರಕಾಶಿಸುವ ದೀಪವಾಗಿದ್ದನು. ನೀವು ಸ್ವಲ್ಪಕಾಲ ಅವನ ಬೆಳಕಿನಲ್ಲಿ ಅತ್ಯಾನಂದಪಡಲು ನೀವು ಇಚ್ಚಿಸಿದಿರಿ.<verse eid="JHN 5:35"/></para>
  <para style="p">
    <verse number="36" style="v" sid="JHN 5:36"/>“ಆದರೆ ನನಗೆ ಯೋಹಾನನಿಗಿಂತಲೂ ಮಹಾ ಸಾಕ್ಷಿ ಉಂಟು. ಹೇಗೆಂದರೆ, ತಂದೆ ನನಗೆ ಮಾಡಿ ಮುಗಿಸಲು ಕೊಟ್ಟ ಕೆಲಸಗಳು, ಅಂದರೆ, ನಾನು ಮಾಡುತ್ತಿರುವ ಈ ಕೆಲಸಗಳೇ, ತಂದೆ ನನ್ನನ್ನು ಕಳಿಹಿಸಿದ್ದಾರೆಂದು ನನ್ನನ್ನು ಕುರಿತು ಸಾಕ್ಷಿ ಕೊಡುತ್ತವೆ. <verse eid="JHN 5:36"/><verse number="37" style="v" sid="JHN 5:37"/>ನನ್ನನ್ನು ಕಳುಹಿಸಿದ ತಂದೆ ತಾವೇ ನನ್ನನ್ನು ಕುರಿತು ಸಾಕ್ಷಿ ಹೇಳಿದ್ದಾರೆ. ನೀವು ಎಂದೂ ಅವರ ಸ್ವರವನ್ನು ಕೇಳಲಿಲ್ಲ, ಅವರ ರೂಪವನ್ನು ಕಾಣಲಿಲ್ಲ. <verse eid="JHN 5:37"/><verse number="38" style="v" sid="JHN 5:38"/>ಅವರ ವಾಕ್ಯವು ನಿಮ್ಮಲ್ಲಿ ನೆಲೆಗೊಂಡಿಲ್ಲ. ಏಕೆಂದರೆ ಅವರು ಕಳುಹಿಸಿದವನನ್ನು ನೀವು ನಂಬುವುದಿಲ್ಲ. <verse eid="JHN 5:38"/><verse number="39" style="v" sid="JHN 5:39"/>ನೀವು ಪವಿತ್ರ ವೇದದಲ್ಲಿ ನಿತ್ಯಜೀವ ದೊರೆಯುತ್ತದೆ ಎಂದು ನೆನಸಿ, ಅವುಗಳನ್ನು ಪರಿಶೋಧಿಸುತ್ತೀದ್ದಿರಿ. ಆ ಪವಿತ್ರ ವೇದವೇ ನನ್ನ ವಿಷಯವಾಗಿ ಸಾಕ್ಷಿಕೊಡುತ್ತದೆ. <verse eid="JHN 5:39"/><verse number="40" style="v" sid="JHN 5:40"/>ಆದರೂ ನೀವು ಜೀವವನ್ನು ಹೊಂದುವುದಕ್ಕಾಗಿ ನನ್ನ ಬಳಿಗೆ ಬರುವುದಕ್ಕೆ ನಿಮಗೆ ಇಷ್ಟವಿಲ್ಲ.<verse eid="JHN 5:40"/></para>
  <para style="p">
    <verse number="41" style="v" sid="JHN 5:41"/>“ನಾನು ಮನುಷ್ಯರಿಂದ ಮಹಿಮೆಯನ್ನು ಸ್ವೀಕರಿಸುವುದಿಲ್ಲ. <verse eid="JHN 5:41"/><verse number="42" style="v" sid="JHN 5:42"/>ಆದರೆ ನಿಮ್ಮನ್ನು ಬಲ್ಲೆನು. ನಿಮ್ಮ ಹೃದಯದಲ್ಲಿ ದೇವರ ಪ್ರೀತಿ ಇಲ್ಲ. <verse eid="JHN 5:42"/><verse number="43" style="v" sid="JHN 5:43"/>ನಾನು ನನ್ನ ತಂದೆಯ ಹೆಸರಿನಲ್ಲಿ ಬಂದಿದ್ದೇನೆ. ನೀವು ನನ್ನನ್ನು ಸ್ವೀಕರಿಸುವುದಿಲ್ಲ. ಮತ್ತೊಬ್ಬನು ತನ್ನ ಸ್ವಂತ ಹೆಸರಿನಲ್ಲಿ ಬಂದರೆ ನೀವು ಅಂಥವನನ್ನು ಸ್ವೀಕರಿಸುತ್ತೀರಿ. <verse eid="JHN 5:43"/><verse number="44" style="v" sid="JHN 5:44"/>ಒಬ್ಬರೇ ದೇವರಿಂದ ಬರುವ ಮಹಿಮೆಯನ್ನು ಹುಡುಕದೆ ಒಬ್ಬರಿಂದೊಬ್ಬರಿಗೆ ಬರುವ ಮಹಿಮೆಯನ್ನು ಸ್ವೀಕರಿಸುವ ನಿಮಗೆ ನಂಬಲು ಹೇಗೆ ಸಾಧ್ಯ?<verse eid="JHN 5:44"/></para>
  <para style="p">
    <verse number="45" style="v" sid="JHN 5:45"/>“ತಂದೆಯ ಮುಂದೆ ನಿಮ್ಮ ಮೇಲೆ ನಾನು ದೂರು ಹೇಳುತ್ತಿರುವೆನೆಂದು ನೀವು ನೆನಸಬೇಡಿರಿ. ನಿಮ್ಮ ಮೇಲೆ ದೂರು ಹೇಳುವವನು ಒಬ್ಬನಿದ್ದಾನೆ; ನೀವು ನಿರೀಕ್ಷೆಯಿಟ್ಟಿರುವ ಮೋಶೆಯೇ. <verse eid="JHN 5:45"/><verse number="46" style="v" sid="JHN 5:46"/>ನೀವು ಮೋಶೆಯನ್ನು ನಂಬಿದ್ದರೆ ನನ್ನನ್ನೂ ನಂಬುತ್ತಿದ್ದಿರಿ. ಏಕೆಂದರೆ ಅವನು ನನ್ನನ್ನು ಕುರಿತು ಬರೆದಿದ್ದಾನೆ. <verse eid="JHN 5:46"/><verse number="47" style="v" sid="JHN 5:47"/>ಅವನು ಪವಿತ್ರ ವೇದಗಳಲ್ಲಿ ಬರೆದದ್ದನ್ನು ನೀವು ನಂಬದಿದ್ದರೆ ನನ್ನ ಮಾತುಗಳನ್ನು ಹೇಗೆ ನಂಬುವಿರಿ?” ಎಂದರು.<verse eid="JHN 5:47"/></para>
  <chapter eid="JHN 5"/>
  <chapter number="6" style="c" sid="JHN 6"/>
  <para style="s1">ಯೇಸು ಐದು ಸಾವಿರ ಜನರಿಗೆ ಆಹಾರ ಕೊಟ್ಟದ್ದು</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 6:1"/>ಇವುಗಳಾದ ಮೇಲೆ ಯೇಸು ತಿಬೇರಿಯದ ಗಲಿಲಾಯ ಸರೋವರದ ಆಚೆಗೆ ಹೋದರು. <verse eid="JHN 6:1"/><verse number="2" style="v" sid="JHN 6:2"/>ಯೇಸು ರೋಗಿಗಳಲ್ಲಿ ನಡೆಸಿದ ಸೂಚಕಕಾರ್ಯಗಳನ್ನು ನೋಡಿದ್ದರಿಂದ ಜನರ ದೊಡ್ಡ ಗುಂಪು ಯೇಸುವನ್ನು ಹಿಂಬಾಲಿಸಿತು. <verse eid="JHN 6:2"/><verse number="3" style="v" sid="JHN 6:3"/>ಯೇಸು ಬೆಟ್ಟವನ್ನೇರಿ ಅಲ್ಲಿ ತಮ್ಮ ಶಿಷ್ಯರೊಂದಿಗೆ ಕುಳಿತುಕೊಂಡರು. <verse eid="JHN 6:3"/><verse number="4" style="v" sid="JHN 6:4"/>ಆಗ ಯೆಹೂದ್ಯರ ಪಸ್ಕಹಬ್ಬವು ಹತ್ತಿರವಾಗಿತ್ತು.<verse eid="JHN 6:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="JHN 6:5"/>ಯೇಸು ಕಣ್ಣೆತ್ತಿ ನೋಡಿ ಮತ್ತು ಜನರ ದೊಡ್ಡ ಗುಂಪು ಅವರ ಕಡೆಗೆ ಬರುವುದನ್ನು ಕಂಡು ಫಿಲಿಪ್ಪನಿಗೆ, “ಇವರು ಊಟ ಮಾಡಲು ನಾವು ರೊಟ್ಟಿಯನ್ನು ಎಲ್ಲಿಂದ ಕೊಂಡುಕೊಳ್ಳೋಣ?” ಎಂದರು. <verse eid="JHN 6:5"/><verse number="6" style="v" sid="JHN 6:6"/>ಅವನನ್ನು ಪರೀಕ್ಷಿಸುವುದಕ್ಕಾಗಿ ಯೇಸು ಇದನ್ನು ಹೇಳಿದರು. ಏಕೆಂದರೆ ತಾನು ಮಾಡಲಿರುವುದು ಏನೆಂದು ಯೇಸುವಿಗೆ ತಿಳಿದಿತ್ತು.<verse eid="JHN 6:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="JHN 6:7"/>ಫಿಲಿಪ್ಪನು ಯೇಸುವಿಗೆ, “ಇವರಲ್ಲಿ ಪ್ರತಿಯೊಬ್ಬನು ಸ್ವಲ್ಪ ಸ್ವಲ್ಪ ತಿಂದರೂ ಆರು ತಿಂಗಳ ಕೂಲಿಯಷ್ಟು<note caller="+" style="f"><char style="fr" closed="false">6:7 </char><char style="ft" closed="false">ಗ್ರೀಕ್ ಭಾಷೆಯಲ್ಲಿ </char><char style="fqa" closed="false">200 ದಿನಾರಿ</char></note> ರೊಟ್ಟಿಗಳೂ ಅವರಿಗೆ ಸಾಲುವುದಿಲ್ಲ,” ಎಂದನು.<verse eid="JHN 6:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="JHN 6:8"/>ಆಗ ಯೇಸುವಿನ ಶಿಷ್ಯರಲ್ಲಿ ಒಬ್ಬನಾಗಿರುವ ಸೀಮೋನ್ ಪೇತ್ರನ ಸಹೋದರನಾದ ಅಂದ್ರೆಯನು <verse eid="JHN 6:8"/><verse number="9" style="v" sid="JHN 6:9"/>ಯೇಸುವಿಗೆ, “ಇಲ್ಲಿ ಒಬ್ಬ ಹುಡುಗನ ಬಳಿ ಐದು ಜವೆಗೋಧಿಯ ರೊಟ್ಟಿಗಳೂ ಎರಡು ಮೀನುಗಳೂ ಇವೆ. ಆದರೆ ಅಷ್ಟೊಂದು ಜನರಿಗೆ ಇವು ಹೇಗೆ ಸಾಕಾಗುತ್ತವೆ?” ಎಂದನು.<verse eid="JHN 6:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="JHN 6:10"/>ಯೇಸು, “ಜನರನ್ನು ಊಟಕ್ಕೆ ಕುಳಿತುಕೊಳ್ಳಲು ಹೇಳಿರಿ,” ಎಂದರು. ಆ ಸ್ಥಳದಲ್ಲಿ ಬಹಳ ಹುಲ್ಲು ಇದ್ದುದರಿಂದ ಜನರೆಲ್ಲರೂ ಕುಳಿತುಕೊಂಡರು, ಗಂಡಸರೇ ಐದು ಸಾವಿರ ಮಂದಿ ಇದ್ದರು. <verse eid="JHN 6:10"/><verse number="11" style="v" sid="JHN 6:11"/>ಆಮೇಲೆ ಯೇಸು ರೊಟ್ಟಿಗಳನ್ನು ತೆಗೆದುಕೊಂಡು ದೇವರಿಗೆ ಕೃತಜ್ಞತೆಯನ್ನು ಸಲ್ಲಿಸಿ, ಕುಳಿತಿದ್ದವರಿಗೆ ಬೇಕಾದಷ್ಟು ಹಂಚಿದರು. ಅದೇ ರೀತಿಯಲ್ಲಿ ಮೀನುಗಳನ್ನು ಅವರಿಗೆ ಹಂಚಿದರು.<verse eid="JHN 6:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 6:12"/>ಅವರೆಲ್ಲರೂ ತಿಂದು ತೃಪ್ತಿಯಾದ ಮೇಲೆ ಯೇಸು ತಮ್ಮ ಶಿಷ್ಯರಿಗೆ, “ಏನೂ ನಷ್ಟವಾಗದಂತೆ ಉಳಿದ ತುಂಡುಗಳನ್ನು ಕೂಡಿಸಿರಿ,” ಎಂದರು. <verse eid="JHN 6:12"/><verse number="13" style="v" sid="JHN 6:13"/>ಅದರಂತೆ ಅವರು ಐದು ಜವೆಗೋಧಿಯ ರೊಟ್ಟಿಗಳಲ್ಲಿ ತಿಂದವರಿಂದ ಉಳಿದ ತುಂಡುಗಳನ್ನು ಕೂಡಿಸಿ, ಹನ್ನೆರಡು ಬುಟ್ಟಿಗಳಲ್ಲಿ ತುಂಬಿದರು.<verse eid="JHN 6:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="JHN 6:14"/>ಆ ಜನರು ಯೇಸು ಮಾಡಿದ ಸೂಚಕಕಾರ್ಯವನ್ನು ಕಂಡು, “ಸತ್ಯವಾಗಿಯೂ ಲೋಕಕ್ಕೆ ಬರಬೇಕಾಗಿದ್ದ ಪ್ರವಾದಿಯು ಇವರೇ,” ಎಂದರು. <verse eid="JHN 6:14"/><verse number="15" style="v" sid="JHN 6:15"/>ಅವರು ಬಂದು ತನ್ನನ್ನು ಹಿಡಿದುಕೊಂಡುಹೋಗಿ ಅರಸನನ್ನಾಗಿ ಮಾಡಬೇಕೆಂದಿದ್ದಾರೆಂದು ಯೇಸು ತಿಳಿದು ತಾವೊಬ್ಬರೇ ಪುನಃ ಬೆಟ್ಟದ ಕಡೆಗೆ ಹೋದರು.<verse eid="JHN 6:15"/></para>
  <para style="s1">ಯೇಸು ನೀರಿನ ಮೇಲೆ ನಡೆದದ್ದು</para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 6:16"/>ಸಂಜೆಯಾದಾಗ ಯೇಸುವಿನ ಶಿಷ್ಯರು ಸರೋವರಕ್ಕೆ ಹೋಗಿ, <verse eid="JHN 6:16"/><verse number="17" style="v" sid="JHN 6:17"/>ದೋಣಿಯನ್ನು ಹತ್ತಿ ಸರೋವರ ಮಾರ್ಗವಾಗಿ ಕಪೆರ್ನೌಮಿಗೆ ಸಾಗಿದರು. ಆಗಲೇ ಕತ್ತಲಾಗಿತ್ತು. ಯೇಸು ಅವರ ಬಳಿಗೆ ಇನ್ನೂ ಬಂದಿರಲಿಲ್ಲ. <verse eid="JHN 6:17"/><verse number="18" style="v" sid="JHN 6:18"/>ಆಗ ರಭಸವಾದ ಗಾಳಿಯು ಬೀಸಿದ್ದರಿಂದ ಸರೋವರವು ಅಲ್ಲೋಲಕಲ್ಲೋಲವಾಯಿತು. <verse eid="JHN 6:18"/><verse number="19" style="v" sid="JHN 6:19"/>ಅವರು ದೋಣಿಯನ್ನು ನಡೆಸುತ್ತಾ ಸುಮಾರು ಐದಾರು ಕಿಲೋಮೀಟರಿನಷ್ಟು ದೂರ ಹೋದ ಮೇಲೆ ಯೇಸು ಸರೋವರದ ಮೇಲೆ ನಡೆದು ದೋಣಿಯ ಕಡೆಗೆ ಸಮೀಪಿಸುತ್ತಿರುವುದನ್ನು ಅವರು ಕಂಡು, ಭಯಪಟ್ಟರು. <verse eid="JHN 6:19"/><verse number="20" style="v" sid="JHN 6:20"/>ಆದರೆ ಯೇಸು ಅವರಿಗೆ, “ನಾನೇ, ಭಯಪಡಬೇಡಿರಿ,” ಎಂದರು. <verse eid="JHN 6:20"/><verse number="21" style="v" sid="JHN 6:21"/>ಆಗ ಶಿಷ್ಯರು ಯೇಸುವನ್ನು ದೋಣಿಯಲ್ಲಿ ಸೇರಿಸಿಕೊಳ್ಳಬೇಕೆಂದಿದ್ದರು. ಅಷ್ಟರಲ್ಲಿ ದೋಣಿಯು ಅವರು ಹೋಗಬೇಕಾಗಿದ್ದ ದಡಕ್ಕೆ ಸೇರಿತು.<verse eid="JHN 6:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 6:22"/>ಮರುದಿನ ಅಲ್ಲಿ ಒಂದೇ ದೋಣಿಯ ಹೊರತು ಬೇರೆ ಇರಲಿಲ್ಲವೆಂದೂ ಯೇಸುವಿನ ಶಿಷ್ಯರು ಮಾತ್ರ ಆ ದೋಣಿಯಲ್ಲಿ ಹೋದರೆಂದೂ ಯೇಸು ತಮ್ಮ ಶಿಷ್ಯರ ಸಂಗಡ ದೋಣಿಯಲ್ಲಿ ಹೋಗಲಿಲ್ಲವೆಂದೂ ಸರೋವರದ ಆಚೆಯಲ್ಲಿ ನಿಂತಿದ್ದ ಜನರು ಅರಿತುಕೊಂಡರು. <verse eid="JHN 6:22"/><verse number="23" style="v" sid="JHN 6:23"/>ಬೇರೆ ದೋಣಿಗಳು ತಿಬೇರಿಯದಿಂದ ಹೊರಟು, ಕರ್ತ ಯೇಸು ಕೃತಜ್ಞತೆ ಸಲ್ಲಿಸಿ ಜನರಿಗೆ ರೊಟ್ಟಿಯನ್ನು ಊಟಮಾಡಿಸಿದ ಸ್ಥಳದ ಸಮೀಪಕ್ಕೆ ಬಂದವು. <verse eid="JHN 6:23"/><verse number="24" style="v" sid="JHN 6:24"/>ಆಗ ಯೇಸು ಮತ್ತು ಅವರ ಶಿಷ್ಯರು ಅಲ್ಲಿ ಇಲ್ಲದಿರುವುದನ್ನು ಜನರು ನೋಡಿ, ದೋಣಿಗಳಲ್ಲಿ ಹತ್ತಿ ಯೇಸುವನ್ನು ಹುಡುಕುತ್ತಾ ಕಪೆರ್ನೌಮಿಗೆ ಬಂದರು.<verse eid="JHN 6:24"/></para>
  <para style="s1">ಯೇಸುವೇ ಜೀವದ ರೊಟ್ಟಿ</para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 6:25"/>ಜನರು ಯೇಸುವನ್ನು ಸರೋವರದ ಆಚೆ ಕಡೆಯಲ್ಲಿ ಕಂಡು ಅವರಿಗೆ, “ಗುರುವೇ, ನೀವು ಇಲ್ಲಿಗೆ ಬಂದದ್ದು ಯಾವಾಗ?” ಎಂದರು.<verse eid="JHN 6:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="JHN 6:26"/>ಯೇಸು ಅವರಿಗೆ, “ನಾನು ನಿಮಗೆ ನಿಜನಿಜವಾಗಿ ಹೇಳುತ್ತೇನೆ, ನೀವು ನನ್ನನ್ನು ಹುಡುಕುವುದು ಸೂಚಕಕಾರ್ಯಗಳನ್ನು ನೋಡಿದ್ದರಿಂದಲ್ಲ, ರೊಟ್ಟಿಗಳನ್ನು ತಿಂದು ತೃಪ್ತಿ ಹೊಂದಿದ್ದರಿಂದಲೇ. <verse eid="JHN 6:26"/><verse number="27" style="v" sid="JHN 6:27"/>ನಾಶವಾಗುವ ಆಹಾರಕ್ಕಾಗಿ ದುಡಿಯಬೇಡಿರಿ, ನೀವು ನಿತ್ಯಜೀವಕ್ಕೆ ಉಳಿಯುವ ಆಹಾರಕ್ಕಾಗಿಯೇ ದುಡಿಯಿರಿ. ಅದನ್ನು ಮನುಷ್ಯಪುತ್ರನಾದ ನಾನು ನಿಮಗೆ ಕೊಡುವೆನು. ಇದಕ್ಕಾಗಿ ತಂದೆ ದೇವರು ಮೆಚ್ಚುಗೆಯ ಮುದ್ರೆಯನ್ನು ನನ್ನ ಮೇಲೆ ಹಾಕಿದ್ದಾರೆ,” ಎಂದರು.<verse eid="JHN 6:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="JHN 6:28"/>ಆಗ ಅವರು ಯೇಸುವಿಗೆ, “ನಾವು ದೇವರ ಕಾರ್ಯವನ್ನು ಮಾಡಬೇಕಾದರೆ ಏನು ಮಾಡಬೇಕು?” ಎಂದು ಕೇಳಿದ್ದಕ್ಕೆ,<verse eid="JHN 6:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="JHN 6:29"/>ಯೇಸು ಅವರಿಗೆ, “ದೇವರು ಕಳುಹಿಸಿದ ನನ್ನನ್ನು ನೀವು ನಂಬುವುದೇ ದೇವರು ಮೆಚ್ಚುವ ಕಾರ್ಯ,” ಎಂದರು.<verse eid="JHN 6:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="JHN 6:30"/>ಅದಕ್ಕೆ ಅವರು ಯೇಸುವಿಗೆ, “ಹಾಗಾದರೆ ನಾವು ನೋಡಿ ನಿಮ್ಮನ್ನು ನಂಬುವಂತೆ ಯಾವ ಸೂಚಕಕಾರ್ಯವನ್ನು ಮಾಡುತ್ತೀರಿ? <verse eid="JHN 6:30"/><verse number="31" style="v" sid="JHN 6:31"/>‘ಅವರಿಗೆ ಪರಲೋಕದಿಂದ ರೊಟ್ಟಿ ಕೊಡಲಾಯಿತು’<note caller="+" style="f"><char style="fr" closed="false">6:31 </char><char style="ft" closed="false"><char style="xt"><ref loc="EXO 16:4">ವಿಮೋ 16:4</ref>; <ref loc="PSA 78:24">ಕೀರ್ತನೆ 78:24</ref>,<ref loc="PSA 78:25">25</ref>; <ref loc="NEH 9:15">ನೆಹೆ 9:15</ref></char></char></note> ಎಂದು ಪವಿತ್ರ ವೇದದಲ್ಲಿ ಬರೆದಿರುವ ಪ್ರಕಾರ ನಮ್ಮ ಪಿತೃಗಳು ಅರಣ್ಯದಲ್ಲಿ ಮನ್ನಾ ಎಂಬ ಆಹಾರವನ್ನು ತಿಂದರು,” ಎಂದು ಕೇಳಿದರು.<verse eid="JHN 6:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="JHN 6:32"/>ಯೇಸು ಅವರಿಗೆ, “ನಾನು ನಿಮಗೆ ನಿಜನಿಜವಾಗಿ ಹೇಳುತ್ತೇನೆ, ನಿಮಗೆ ಪರಲೋಕದಿಂದ ರೊಟ್ಟಿಯನ್ನು ಮೋಶೆ ಕೊಡಲಿಲ್ಲ. ನನ್ನ ತಂದೆಯೇ ನಿಮಗೆ ನಿಜವಾದ ರೊಟ್ಟಿಯನ್ನು ಪರಲೋಕದಿಂದಲೇ ಕೊಡುತ್ತಾರೆ. <verse eid="JHN 6:32"/><verse number="33" style="v" sid="JHN 6:33"/>ಪರಲೋಕದಿಂದ ಇಳಿದುಬಂದು ಲೋಕಕ್ಕೆ ಜೀವವನ್ನು ಕೊಡುವ ದೇವರ ರೊಟ್ಟಿಯು ನಾನೇ,” ಎಂದರು.<verse eid="JHN 6:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="JHN 6:34"/>ಅದಕ್ಕವರು ಯೇಸುವಿಗೆ, “ಸ್ವಾಮೀ, ಈ ರೊಟ್ಟಿಯನ್ನೇ ನಮಗೆ ಯಾವಾಗಲೂ ಕೊಡು,” ಎಂದರು.<verse eid="JHN 6:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="JHN 6:35"/>ಯೇಸು ಅವರಿಗೆ, “ನಾನೇ ಜೀವದ ರೊಟ್ಟಿ. ನನ್ನ ಬಳಿಗೆ ಬರುವವರಿಗೆ ಎಂದಿಗೂ ಹಸಿವೆಯಾಗುವುದಿಲ್ಲ; ನನ್ನನ್ನು ನಂಬುವವರಿಗೆ ಎಂದಿಗೂ ದಾಹವಾಗುವುದಿಲ್ಲ. <verse eid="JHN 6:35"/><verse number="36" style="v" sid="JHN 6:36"/>ಆದರೆ, ‘ನೀವು ನನ್ನನ್ನು ಕಂಡಿದ್ದರೂ ನಂಬಲಿಲ್ಲ,’ ಎಂದು ನಾನು ನಿಮಗೆ ಹೇಳಿದೆನು. <verse eid="JHN 6:36"/><verse number="37" style="v" sid="JHN 6:37"/>ತಂದೆಯು ನನಗೆಂದು ಕೊಟ್ಟಿರುವ ಪ್ರತಿಯೊಬ್ಬರೂ ನನ್ನ ಬಳಿಗೆ ಬರುವರು. ನನ್ನ ಬಳಿಗೆ ಬರುವವರನ್ನು ನಾನು ಎಂದಿಗೂ ತಳ್ಳಿಬಿಡುವುದೇ ಇಲ್ಲ. <verse eid="JHN 6:37"/><verse number="38" style="v" sid="JHN 6:38"/>ನಾನು ನನ್ನ ಚಿತ್ತವನ್ನು ಮಾಡುವುದಕ್ಕಲ್ಲ. ನನ್ನನ್ನು ಕಳುಹಿಸಿದ ತಂದೆಯ ಚಿತ್ತವನ್ನೇ ಮಾಡುವುದಕ್ಕೆ ಪರಲೋಕದಿಂದ ಬಂದೆನು. <verse eid="JHN 6:38"/><verse number="39" style="v" sid="JHN 6:39"/>ನನ್ನನ್ನು ಕಳುಹಿಸಿಕೊಟ್ಟ ತಂದೆಯ ಚಿತ್ತವೇನೆಂದರೆ: ಅವರು ನನಗೆ ಕೊಟ್ಟವರಲ್ಲಿ ನಾನು ಯಾರನ್ನೂ ಕಳೆದುಕೊಳ್ಳದೆ ಕಡೆಯ ದಿನದಲ್ಲಿ ಅವರನ್ನು ಎಬ್ಬಿಸುವುದೇ. <verse eid="JHN 6:39"/><verse number="40" style="v" sid="JHN 6:40"/>ನನ್ನ ತಂದೆಯ ಚಿತ್ತವೇನೆಂದರೆ ನನ್ನನ್ನು ನೋಡಿ ನನ್ನಲ್ಲಿ ವಿಶ್ವಾಸವಿಡುವ ಪ್ರತಿಯೊಬ್ಬರೂ ನಿತ್ಯಜೀವವನ್ನು ಪಡೆಯುವುದೇ; ನಾನು ಅವರನ್ನು ಕಡೆಯ ದಿನದಲ್ಲಿ ಎಬ್ಬಿಸುವೆನು,” ಎಂದು ಹೇಳಿದರು.<verse eid="JHN 6:40"/></para>
  <para style="p">
    <verse number="41" style="v" sid="JHN 6:41"/>“ಪರಲೋಕದಿಂದ ಇಳಿದು ಬಂದ ರೊಟ್ಟಿ ನಾನೇ,” ಎಂದು ಯೇಸು ಹೇಳಿದ್ದಕ್ಕೆ ಯೆಹೂದ್ಯರು ಯೇಸುವಿನ ವಿಷಯವಾಗಿ ಗೊಣಗುಟ್ಟಿ, <verse eid="JHN 6:41"/><verse number="42" style="v" sid="JHN 6:42"/>“ಈತನು ಯೋಸೇಫನ ಪುತ್ರ ಯೇಸು ಅಲ್ಲವೇ? ಈತನ ತಂದೆತಾಯಿ ನಮಗೆ ಗೊತ್ತಿಲ್ಲವೇ? ಹಾಗಾದರೆ, ‘ನಾನು ಪರಲೋಕದಿಂದ ಬಂದೆನು,’ ಎಂದು ಈತನು ಹೇಳುವುದು ಹೇಗೆ?” ಎಂದರು.<verse eid="JHN 6:42"/></para>
  <para style="p">
    <verse number="43" style="v" sid="JHN 6:43"/>ಯೇಸು ಅವರಿಗೆ, “ನಿಮ್ಮನಿಮ್ಮೊಳಗೆ ಗೊಣಗುಟ್ಟಬೇಡಿರಿ. <verse eid="JHN 6:43"/><verse number="44" style="v" sid="JHN 6:44"/>ನನ್ನನ್ನು ಕಳುಹಿಸಿದ ತಂದೆ ಸೆಳೆಯದ ಹೊರತು, ಯಾರೂ ನನ್ನ ಬಳಿಗೆ ಬರಲಾರರು. ನಾನು ಅವರನ್ನು ಕಡೆಯ ದಿನದಲ್ಲಿ ಎಬ್ಬಿಸುವೆನು. <verse eid="JHN 6:44"/><verse number="45" style="v" sid="JHN 6:45"/>‘ಅವರೆಲ್ಲರೂ ದೇವರಿಂದಲೇ ಬೋಧನೆ ಪಡೆಯುವರು,’<note caller="+" style="f"><char style="fr" closed="false">6:45 </char><char style="ft" closed="false"><char style="xt"><ref loc="ISA 54:13">ಯೆಶಾಯ 54:13</ref></char></char></note> ಎಂದು ಪ್ರವಾದಿಗಳ ಗ್ರಂಥದಲ್ಲಿ ಬರೆದಿದೆ. ತಂದೆಯಿಂದ ಕೇಳಿ ಕಲಿತ ಪ್ರತಿಯೊಬ್ಬರೂ ನನ್ನ ಬಳಿಗೆ ಬರುತ್ತಾರೆ. <verse eid="JHN 6:45"/><verse number="46" style="v" sid="JHN 6:46"/>ದೇವರಿಂದ ಬಂದಿರುವ ನಾನೇ ತಂದೆಯನ್ನು ನೋಡಿದ್ದೇನೆ, ಬೇರೆ ಯಾರೂ ತಂದೆಯನ್ನು ನೋಡಲಿಲ್ಲ. <verse eid="JHN 6:46"/><verse number="47" style="v" sid="JHN 6:47"/>ನಾನು ನಿಮಗೆ ನಿಜನಿಜವಾಗಿ ಹೇಳುತ್ತೇನೆ, ನನ್ನನ್ನು ನಂಬುವವರು ನಿತ್ಯಜೀವವನ್ನು ಹೊಂದಿದ್ದಾರೆ. <verse eid="JHN 6:47"/><verse number="48" style="v" sid="JHN 6:48"/>ನಾನೇ ಜೀವದ ರೊಟ್ಟಿ. <verse eid="JHN 6:48"/><verse number="49" style="v" sid="JHN 6:49"/>ನಿಮ್ಮ ಪಿತೃಗಳು ಅರಣ್ಯದಲ್ಲಿ ‘ಮನ್ನಾ’ ತಿಂದರೂ ಸತ್ತುಹೋದರು. <verse eid="JHN 6:49"/><verse number="50" style="v" sid="JHN 6:50"/>ಯಾರು ತಿಂದರೂ ಸಾಯದೇ ಇರುವಂತೆ ಪರಲೋಕದಿಂದ ಇಳಿದು ಬಂದ ಜೀವದ ರೊಟ್ಟಿ ಇದೇ. <verse eid="JHN 6:50"/><verse number="51" style="v" sid="JHN 6:51"/>ನಾನೇ ಪರಲೋಕದಿಂದ ಬಂದ ಜೀವದ ರೊಟ್ಟಿ. ಈ ರೊಟ್ಟಿಯನ್ನು ಯಾರು ತಿನ್ನುವರೋ ಅವರು ಸದಾಕಾಲವೂ ಬದುಕುವರು. ಲೋಕದ ಜೀವಕ್ಕಾಗಿ ನಾನು ಕೊಡುವ ರೊಟ್ಟಿಯು ನನ್ನ ಮಾಂಸವೇ,” ಎಂದರು.<verse eid="JHN 6:51"/></para>
  <para style="p">
    <verse number="52" style="v" sid="JHN 6:52"/>ಆದ್ದರಿಂದ ಯೆಹೂದ್ಯರು ಒಬ್ಬರಿಗೊಬ್ಬರು ಚರ್ಚೆಮಾಡುತ್ತಾ, “ಈ ಮನುಷ್ಯನು ತನ್ನ ಮಾಂಸವನ್ನು ತಿನ್ನುವುದಕ್ಕೆ ನಮಗೆ ಹೇಗೆ ಕೊಡುತ್ತಾನೆ?” ಎಂದರು.<verse eid="JHN 6:52"/></para>
  <para style="p">
    <verse number="53" style="v" sid="JHN 6:53"/>ಯೇಸು ಅವರಿಗೆ, “ನಿಮಗೆ ನಿಜನಿಜವಾಗಿ ಹೇಳುತ್ತೇನೆ, ನೀವು ಮನುಷ್ಯಪುತ್ರನಾದ ನನ್ನ ಮಾಂಸವನ್ನು ತಿಂದು ನನ್ನ ರಕ್ತವನ್ನು ಕುಡಿಯದೆ ಹೋದರೆ, ನಿಮ್ಮಲ್ಲಿ ಜೀವವಿರುವುದಿಲ್ಲ. <verse eid="JHN 6:53"/><verse number="54" style="v" sid="JHN 6:54"/>ಯಾರು ನನ್ನ ಮಾಂಸವನ್ನು ತಿಂದು ನನ್ನ ರಕ್ತವನ್ನು ಕುಡಿಯುತ್ತಾರೋ ಅವರು ನಿತ್ಯಜೀವವನ್ನು ಹೊಂದಿದ್ದಾರೆ, ನಾನು ಅವರನ್ನು ಕಡೆಯ ದಿನದಲ್ಲಿ ಎಬ್ಬಿಸುವೆನು. <verse eid="JHN 6:54"/><verse number="55" style="v" sid="JHN 6:55"/>ನನ್ನ ಮಾಂಸವು ನಿಜವಾದ ಆಹಾರವೂ ನನ್ನ ರಕ್ತವು ನಿಜವಾದ ಪಾನವೂ ಆಗಿದೆ. <verse eid="JHN 6:55"/><verse number="56" style="v" sid="JHN 6:56"/>ಯಾರು ನನ್ನ ಮಾಂಸವನ್ನು ತಿಂದು ನನ್ನ ರಕ್ತವನ್ನು ಕುಡಿಯುತ್ತಾರೋ ಅವರು ನನ್ನಲ್ಲಿ ನೆಲೆಸಿರುತ್ತಾರೆ. ನಾನು ಅವರಲ್ಲಿ ನೆಲೆಸಿರುತ್ತೇನೆ. <verse eid="JHN 6:56"/><verse number="57" style="v" sid="JHN 6:57"/>ಜೀವವುಳ್ಳ ತಂದೆಯು ನನ್ನನ್ನು ಕಳುಹಿಸಿದ್ದಾರೆ. ನಾನು ತಂದೆಯ ನಿಮಿತ್ತವಾಗಿ ಜೀವಿಸುವಂತೆಯೇ ನನ್ನನ್ನು ತಿನ್ನುವವರು ನನ್ನ ನಿಮಿತ್ತವಾಗಿಯೇ ಜೀವಿಸುವರು. <verse eid="JHN 6:57"/><verse number="58" style="v" sid="JHN 6:58"/>ಪರಲೋಕದಿಂದ ಬಂದ ರೊಟ್ಟಿಯು ಇದೇ. ನಿಮ್ಮ ಪಿತೃಗಳು ‘ಮನ್ನಾ’ ತಿಂದರೂ ಸತ್ತರು. ಇದು ಹಾಗಲ್ಲ, ಈ ರೊಟ್ಟಿಯನ್ನು ತಿನ್ನುವವರು ಸದಾಕಾಲಕ್ಕೂ ಜೀವಿಸುವರು,” ಎಂದರು. <verse eid="JHN 6:58"/><verse number="59" style="v" sid="JHN 6:59"/>ಕಪೆರ್ನೌಮಿನ ಸಭಾಮಂದಿರದಲ್ಲಿ ಬೋಧಿಸುತ್ತಿರುವಾಗ ಯೇಸು ಈ ಮಾತುಗಳನ್ನು ಹೇಳಿದರು.<verse eid="JHN 6:59"/></para>
  <para style="s1">ಅನೇಕ ಶಿಷ್ಯರು ಯೇಸುವನ್ನು ಬಿಟ್ಟುಹೋದದ್ದು</para>
  <para style="p">
    <verse number="60" style="v" sid="JHN 6:60"/>ಯೇಸುವಿನ ಶಿಷ್ಯರಲ್ಲಿ ಅನೇಕರು ಈ ಮಾತುಗಳನ್ನು ಕೇಳಿ, “ಇದು ಕಠಿಣವಾದ ಮಾತು. ಇದನ್ನು ಯಾರು ಪಾಲಿಸುವರು?” ಎಂದರು.<verse eid="JHN 6:60"/></para>
  <para style="p">
    <verse number="61" style="v" sid="JHN 6:61"/>ತಮ್ಮ ಶಿಷ್ಯರು ಇದನ್ನು ಕುರಿತು ಗೊಣಗುಟ್ಟುತ್ತಾರೆಂದು ಯೇಸು ತಮ್ಮಲ್ಲಿ ತಿಳಿದುಕೊಂಡು ಅವರಿಗೆ, “ಇದು ನಿಮಗೆ ಬೇಸರವಾಯಿತೋ? <verse eid="JHN 6:61"/><verse number="62" style="v" sid="JHN 6:62"/>ಹಾಗಾದರೆ ಮನುಷ್ಯಪುತ್ರನಾದ ನಾನು ಮೊದಲಿದ್ದ ಕಡೆಗೆ ಏರಿ ಹೋಗುವುದನ್ನು ನೀವು ನೋಡುವುದಾದರೆ ಏನನ್ನುವಿರಿ? <verse eid="JHN 6:62"/><verse number="63" style="v" sid="JHN 6:63"/>ಬದುಕಿಸುವುದು ದೇವರ ಆತ್ಮವೇ, ನರಮಾಂಸವಾದರೋ ಯಾವುದಕ್ಕೂ ಪ್ರಯೋಜನವಾಗುವುದಿಲ್ಲ. ನಾನು ನಿಮಗೆ ನುಡಿದ ಮಾತುಗಳೇ ದೇವರಾತ್ಮವೂ ಜೀವವೂ ಆಗಿರುತ್ತವೆ. <verse eid="JHN 6:63"/><verse number="64" style="v" sid="JHN 6:64"/>ಆದರೆ ನಂಬದ ಕೆಲವರು ನಿಮ್ಮಲ್ಲಿ ಇದ್ದಾರೆ,” ಎಂದರು. ನಂಬದವರು ಯಾರೆಂದೂ ತನ್ನನ್ನು ಹಿಡಿದುಕೊಡುವವನು ಯಾರೆಂದೂ ಯೇಸು ಮೊದಲಿನಿಂದಲೂ ತಿಳಿದಿದ್ದರು. <verse eid="JHN 6:64"/><verse number="65" style="v" sid="JHN 6:65"/>ಯೇಸು ಮುಂದುವರಿಸಿ ಹೇಳಿದ್ದೇನೆಂದರೆ, “ಯಾರನ್ನಾದರೂ ನನ್ನ ತಂದೆಯು ನನಗೆ ಕೊಟ್ಟರಷ್ಟೇ ಅವರು ನನ್ನ ಬಳಿಗೆ ಬರಲು ಸಾಧ್ಯ, ಎಂದು ನಾನು ನಿಮಗೆ ಹೇಳಿದ್ದು ಇದಕ್ಕಾಗಿಯೇ.”<verse eid="JHN 6:65"/></para>
  <para style="p">
    <verse number="66" style="v" sid="JHN 6:66"/>ಅಂದಿನಿಂದ ಯೇಸುವಿನ ಶಿಷ್ಯರಲ್ಲಿ ಅನೇಕರು ಹಿಂದಕ್ಕೆ ಹೊರಟು ಹೋದರು ಮತ್ತು ಯೇಸುವಿನ ಸಂಗಡ ಸಂಚಾರ ಮಾಡಲಿಲ್ಲ.<verse eid="JHN 6:66"/></para>
  <para style="p">
    <verse number="67" style="v" sid="JHN 6:67"/>ಆದಕಾರಣ ಯೇಸು ಹನ್ನೆರಡು ಮಂದಿ ಶಿಷ್ಯರಿಗೆ, “ನೀವು ಸಹ ಹೋಗಬೇಕೆಂದು ಇದ್ದೀರಾ?” ಎಂದು ಕೇಳಲು,<verse eid="JHN 6:67"/></para>
  <para style="p">
    <verse number="68" style="v" sid="JHN 6:68"/>ಸೀಮೋನ್ ಪೇತ್ರನು ಯೇಸುವಿಗೆ, “ಸ್ವಾಮೀ, ನಾವು ಯಾರ ಬಳಿಗೆ ಹೋಗೋಣ? ನಿಮ್ಮಲ್ಲಿಯೇ ನಿತ್ಯಜೀವದ ವಾಕ್ಯಗಳಿವೆ. <verse eid="JHN 6:68"/><verse number="69" style="v" sid="JHN 6:69"/>ನೀವು ದೇವರ ಪರಿಶುದ್ಧರು ಎಂದು ನಾವು ನಂಬಿ ತಿಳಿದಿದ್ದೇವೆ,” ಎಂದನು.<verse eid="JHN 6:69"/></para>
  <para style="p">
    <verse number="70" style="v" sid="JHN 6:70"/>ಅದಕ್ಕೆ ಯೇಸು ಅವರಿಗೆ, “ಹನ್ನೆರಡು ಮಂದಿಯಾದ ನಿಮ್ಮನ್ನು ನಾನು ಆರಿಸಿಕೊಂಡೆನಲ್ಲವೇ? ಆದರೆ ನಿಮ್ಮಲ್ಲಿಯೂ ಒಬ್ಬನು ಪಿಶಾಚನಾಗಿದ್ದಾನೆ,” ಎಂದರು. <verse eid="JHN 6:70"/><verse number="71" style="v" sid="JHN 6:71"/>ಸೀಮೋನನ ಮಗ ಇಸ್ಕರಿಯೋತ ಯೂದನ ವಿಷಯವಾಗಿ ಯೇಸು ಹೀಗೆ ಹೇಳಿದರು. ಏಕೆಂದರೆ ಹನ್ನೆರಡು ಮಂದಿಯಲ್ಲಿ ಒಬ್ಬನಾಗಿದ್ದ ಇವನೇ ಯೇಸುವನ್ನು ಹಿಡಿದು ಕೊಡುವುದಕ್ಕಿದ್ದನು.<verse eid="JHN 6:71"/></para>
  <chapter eid="JHN 6"/>
  <chapter number="7" style="c" sid="JHN 7"/>
  <para style="s1">ಯೇಸು ದೇವದರ್ಶನ ಗುಡಾರದ ಹಬ್ಬಕ್ಕೆ ಹೋದದ್ದು</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 7:1"/>ಇವುಗಳಾದ ಮೇಲೆ ಯೇಸು ಗಲಿಲಾಯದ ಪ್ರಾಂತದಲ್ಲಿ ಸಂಚಾರ ಮಾಡಿದರು. ಯೆಹೂದ್ಯರು ಯೇಸುವನ್ನು ಕೊಲ್ಲುವುದಕ್ಕೆ ಹುಡುಕುತ್ತಿದ್ದುದರಿಂದ ಯೂದಾಯದಲ್ಲಿ ಸಂಚರಿಸಲು ಅವರು ಇಷ್ಟಪಡಲಿಲ್ಲ. <verse eid="JHN 7:1"/><verse number="2" style="v" sid="JHN 7:2"/>ಆಗ ಯೆಹೂದ್ಯರ ಗುಡಾರಗಳ ಹಬ್ಬವು ಹತ್ತಿರವಾಗಿತ್ತು. <verse eid="JHN 7:2"/><verse number="3" style="v" sid="JHN 7:3"/>ಆದ್ದರಿಂದ ಯೇಸುವಿನ ಸಹೋದರರು, “ನೀನು ಮಾಡುವ ಕ್ರಿಯೆಗಳನ್ನು ನಿನ್ನ ಶಿಷ್ಯರು ಸಹ ನೋಡುವಂತೆ ಇಲ್ಲಿಂದ ಹೊರಟು ಯೂದಾಯಕ್ಕೆ ಹೋಗು. <verse eid="JHN 7:3"/><verse number="4" style="v" sid="JHN 7:4"/>ಏಕೆಂದರೆ ಪ್ರಖ್ಯಾತನಾಗಲು ಬಯಸುವ ಯಾರೂ ರಹಸ್ಯವಾಗಿ ಯಾವುದನ್ನೂ ಮಾಡುವುದಿಲ್ಲ. ನೀನು ಇವುಗಳನ್ನು ಮಾಡುವುದಾದರೆ, ಲೋಕಕ್ಕೆ ನಿನ್ನನ್ನು ನೀನೇ ತೋರ್ಪಡಿಸಿಕೋ,” ಎಂದು ಯೇಸುವಿಗೆ ಹೇಳಿದರು. <verse eid="JHN 7:4"/><verse number="5" style="v" sid="JHN 7:5"/>ಏಕೆಂದರೆ ಯೇಸುವಿನ ಸಹೋದರರು ಸಹ ಅವರನ್ನು ನಂಬಲಿಲ್ಲ.<verse eid="JHN 7:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="JHN 7:6"/>ಅದಕ್ಕೆ ಯೇಸು ಅವರಿಗೆ, “ನನ್ನ ಸಮಯವು ಇನ್ನೂ ಬಂದಿಲ್ಲ. ನಿಮ್ಮ ಸಮಯವು ಯಾವಾಗಲೂ ಸಿದ್ಧವಾಗಿದೆ. <verse eid="JHN 7:6"/><verse number="7" style="v" sid="JHN 7:7"/>ಲೋಕವು ನಿಮ್ಮನ್ನು ದ್ವೇಷಿಸಲಾರದು. ಲೋಕದ ಕ್ರಿಯೆಗಳು ಕೆಟ್ಟವುಗಳಾಗಿವೆ ಎಂದು ಅದರ ವಿಷಯದಲ್ಲಿ ನಾನು ಸಾಕ್ಷಿ ಹೇಳುವುದರಿಂದ, ಅದು ನನ್ನನ್ನು ದ್ವೇಷಿಸುತ್ತದೆ. <verse eid="JHN 7:7"/><verse number="8" style="v" sid="JHN 7:8"/>ನೀವು ಈ ಹಬ್ಬಕ್ಕೆ ಹೋಗಿರಿ. ನಾನು ಈ ಹಬ್ಬಕ್ಕೆ ಹೋಗುವುದಿಲ್ಲ. ಏಕೆಂದರೆ ನನ್ನ ಸಮಯವು ಇನ್ನೂ ಪೂರ್ಣವಾಗಿ ಬರಲಿಲ್ಲ,” ಎಂದರು. <verse eid="JHN 7:8"/><verse number="9" style="v" sid="JHN 7:9"/>ಯೇಸು ಈ ಮಾತುಗಳನ್ನು ಅವರಿಗೆ ಹೇಳಿದ ಮೇಲೆ ಗಲಿಲಾಯದಲ್ಲಿಯೇ ಉಳಿದರು.<verse eid="JHN 7:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="JHN 7:10"/>ಆದರೆ ಯೇಸುವಿನ ಸಹೋದರರು ಹಬ್ಬಕ್ಕೆ ಹೋದರು. ಯೇಸು ಸಹ ಬಹಿರಂಗವಾಗಿ ಹೋಗದೆ ರಹಸ್ಯವಾಗಿ ಅಲ್ಲಿಗೆ ಹೋದರು. <verse eid="JHN 7:10"/><verse number="11" style="v" sid="JHN 7:11"/>ಯೆಹೂದ್ಯರು ಆ ಹಬ್ಬದಲ್ಲಿ, “ಆ ಮನುಷ್ಯನು ಎಲ್ಲಿ?” ಎಂದು ಹುಡುಕುತ್ತಿದ್ದರು.<verse eid="JHN 7:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 7:12"/>ಜನರ ಗುಂಪುಗಳಲ್ಲಿ ಯೇಸುವಿನ ವಿಷಯವಾಗಿ ಬಹಳ ಗೊಣಗುಟ್ಟುವಿಕೆ ಇತ್ತು. ಏಕೆಂದರೆ ಕೆಲವರು, “ಆತ ಒಳ್ಳೆಯ ಮನುಷ್ಯ,” ಎಂದರು.</para>
  <para style="p" vid="JHN 7:12">ಬೇರೆ ಕೆಲವರು, “ಇಲ್ಲ ಆತ ಜನರಿಗೆ ಮೋಸಮಾಡುತ್ತಾನೆ,” ಎಂದರು. <verse eid="JHN 7:12"/><verse number="13" style="v" sid="JHN 7:13"/>ಆದರೂ ಯೆಹೂದ್ಯರ ಭಯದ ನಿಮಿತ್ತ ಯೇಸುವಿನ ವಿಷಯದಲ್ಲಿ ಯಾರೂ ಬಹಿರಂಗವಾಗಿ ಮಾತನಾಡಲಿಲ್ಲ.<verse eid="JHN 7:13"/></para>
  <para style="s1">ಯೇಸು ದೇವಾಲಯದಲ್ಲಿ ಬೋಧಿಸಿದ್ದು</para>
  <para style="p">
    <verse number="14" style="v" sid="JHN 7:14"/>ಯೇಸು ಆ ಹಬ್ಬದ ಮಧ್ಯದಲ್ಲಿ ದೇವಾಲಯಕ್ಕೆ ಹೋಗಿ ಬೋಧಿಸಿದರು. <verse eid="JHN 7:14"/><verse number="15" style="v" sid="JHN 7:15"/>ಯೆಹೂದ್ಯರು ಆಶ್ಚರ್ಯಪಟ್ಟು, “ಏನನ್ನೂ ಕಲಿಯದಿರುವ ಈ ಮನುಷ್ಯನಿಗೆ ಇಷ್ಟೆಲ್ಲಾ ಜ್ಞಾನ ತಿಳಿದಿರುವುದು ಹೇಗೆ?” ಎಂದರು.<verse eid="JHN 7:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 7:16"/>ಅದಕ್ಕೆ ಯೇಸು ಅವರಿಗೆ, “ನನ್ನ ಬೋಧನೆಯು ನನ್ನದಲ್ಲ, ನನ್ನನ್ನು ಕಳುಹಿಸಿದ ತಂದೆಯದೇ ಆಗಿದೆ. <verse eid="JHN 7:16"/><verse number="17" style="v" sid="JHN 7:17"/>ಯಾರಾದರೂ ದೇವರ ಚಿತ್ತವನ್ನು ಮಾಡಬಯಸುವುದಾದರೆ ಈ ಬೋಧನೆಯು ದೇವರದೋ ಅಥವಾ ನನ್ನಷ್ಟಕ್ಕೆ ನಾನೇ ಮಾತನಾಡುತ್ತೇನೋ ಎಂಬುದು ಅವರಿಗೆ ತಿಳಿಯುವುದು. <verse eid="JHN 7:17"/><verse number="18" style="v" sid="JHN 7:18"/>ತಮ್ಮಷ್ಟಕ್ಕೆ ತಾವೇ ಮಾತನಾಡುವವರು ತಮ್ಮ ಸ್ವಂತ ಮಹಿಮೆಯನ್ನು ಹುಡುಕುತ್ತಾರೆ. ಆದರೆ ತನ್ನನ್ನು ಕಳುಹಿಸಿದ ತಂದೆಯ ಮಹಿಮೆಯನ್ನು ಹುಡುಕುವ ಮನುಷ್ಯನು ಸತ್ಯವಂತನು; ಆತನಲ್ಲಿ ಅನೀತಿಯಿಲ್ಲ. <verse eid="JHN 7:18"/><verse number="19" style="v" sid="JHN 7:19"/>ಮೋಶೆಯು ನಿಮಗೆ ನಿಯಮವನ್ನು ಕೊಡಲಿಲ್ಲವೇ? ಆದರೂ ನಿಮ್ಮಲ್ಲಿ ಯಾರೂ ಆ ನಿಯಮದಂತೆ ನಡೆಯುವುದಿಲ್ಲ. ನೀವು ನನ್ನನ್ನು ಕೊಲ್ಲಲು ಹುಡುಕುವುದೇಕೆ?” ಎಂದು ಕೇಳಿದರು.<verse eid="JHN 7:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="JHN 7:20"/>ಅದಕ್ಕೆ ಜನರು, “ನಿನಗೆ ದೆವ್ವ ಹಿಡಿದಿದೆ. ನಿನ್ನನ್ನು ಕೊಲ್ಲುವುದಕ್ಕೆ ಹುಡುಕುವವರು ಯಾರು?” ಎಂದರು.<verse eid="JHN 7:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="JHN 7:21"/>ಯೇಸು ಅವರಿಗೆ, “ನಾನು ಒಂದು ಕ್ರಿಯೆಯನ್ನು ಮಾಡಿದೆನು. ಅದಕ್ಕೆ ನೀವೆಲ್ಲರೂ ಆಶ್ವರ್ಯಪಡುತ್ತೀರಿ. <verse eid="JHN 7:21"/><verse number="22" style="v" sid="JHN 7:22"/>ಮೋಶೆ ನಿಮಗೆ ಸುನ್ನತಿಯನ್ನು ಇದಕ್ಕಾಗಿಯೇ ಕೊಟ್ಟನು. ಅದು ಮೋಶೆಯಿಂದಾಗಿರದೆ ನಿಮ್ಮ ಪಿತೃಗಳಿಂದಾದದ್ದು. ಆದರೆ ನೀವು ಸಬ್ಬತ್ ದಿನದಲ್ಲಿಯೂ ಸುನ್ನತಿ ಮಾಡುತ್ತೀರಿ. <verse eid="JHN 7:22"/><verse number="23" style="v" sid="JHN 7:23"/>ಮೋಶೆಯ ನಿಯಮವನ್ನು ಉಲ್ಲಂಘಿಸದೆ ನೀವು ಸಬ್ಬತ್ ದಿನದಲ್ಲಿ ಒಬ್ಬನಿಗೆ ಸುನ್ನತಿಯನ್ನು ಮಾಡುವುದಾದರೆ ನಾನು ಒಬ್ಬ ಮನುಷ್ಯನನ್ನು ಸಬ್ಬತ್ ದಿನದಲ್ಲಿ ಸಂಪೂರ್ಣವಾಗಿ ಸ್ವಸ್ಥಮಾಡಿದ್ದಕ್ಕೆ ನನ್ನ ಮೇಲೆ ನೀವು ಏಕೆ ಕೋಪಗೊಳ್ಳುತ್ತೀರಿ? <verse eid="JHN 7:23"/><verse number="24" style="v" sid="JHN 7:24"/>ತೋರಿಕೆಗೆ ಅನುಸಾರವಾಗಿ ತೀರ್ಪುಮಾಡಬೇಡಿರಿ. ಆದರೆ ನೀತಿಯ ತೀರ್ಪನ್ನು ಮಾಡಿರಿ,” ಎಂದರು.<verse eid="JHN 7:24"/></para>
  <para style="s1">ಕ್ರಿಸ್ತ ಯೇಸು ಯಾರು?</para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 7:25"/>ಆಮೇಲೆ ಯೆರೂಸಲೇಮಿನ ಕೆಲವರು, “ಅವರು ಕೊಲ್ಲಬೇಕೆಂದು ಹುಡುಕುವುದು ಈತನನ್ನೇ ಅಲ್ಲವೇ? <verse eid="JHN 7:25"/><verse number="26" style="v" sid="JHN 7:26"/>ಇಗೋ, ಈತನು ಬಹಿರಂಗವಾಗಿ ಮಾತನಾಡುತ್ತಿದ್ದಾನೆ. ಆದರೆ ಅವರು ಈತನಿಗೆ ಏನೂ ಹೇಳುವುದಿಲ್ಲ. ಬಹುಶಃ ಈತನೇ ನಿಜವಾದ ಕ್ರಿಸ್ತ ಎಂದು ಅಧಿಕಾರಿಗಳು ತಿಳಿದುಕೊಂಡಿದ್ದಾರೋ? <verse eid="JHN 7:26"/><verse number="27" style="v" sid="JHN 7:27"/>ಆದರೆ ಈತನು ಎಲ್ಲಿಂದ ಬಂದವನೆಂದು ನಾವು ಬಲ್ಲೆವು. ಆದರೂ ಕ್ರಿಸ್ತನು ಬಂದಾಗ ಆತನು ಎಲ್ಲಿಂದ ಬಂದವನೆಂದು ಯಾರಿಗೂ ತಿಳಿಯದು,” ಎಂದರು.<verse eid="JHN 7:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="JHN 7:28"/>ದೇವಾಲಯದಲ್ಲಿ ಬೋಧಿಸುತ್ತಿದ್ದ ಯೇಸು, “ನೀವು ನನ್ನನ್ನು ಬಲ್ಲಿರಿ, ನಾನು ಎಲ್ಲಿಂದ ಬಂದವನೆಂದೂ ನೀವು ಬಲ್ಲಿರಿ. ನಾನು ನನ್ನಷ್ಟಕ್ಕೆ ನಾನೇ ಬಂದವನಲ್ಲ. ನನ್ನನ್ನು ಕಳುಹಿಸಿದ ತಂದೆಯು ಸತ್ಯವಂತರು. ತಂದೆಯನ್ನು ನೀವು ಅರಿತವರಲ್ಲ. <verse eid="JHN 7:28"/><verse number="29" style="v" sid="JHN 7:29"/>ನಾನಾದರೋ ಅವರನ್ನು ಅರಿತಿದ್ದೇನೆ. ಏಕೆಂದರೆ ನಾನು ಅವರ ಕಡೆಯಿಂದ ಬಂದವನು. ಅವರೇ ನನ್ನನ್ನು ಕಳುಹಿಸಿಕೊಟ್ಟಿದ್ದಾರೆ,” ಎಂದು ಗಟ್ಟಿಯಾಗಿ ಕೂಗಿ ಹೇಳಿದರು.<verse eid="JHN 7:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="JHN 7:30"/>ಆಗ ಅವರು ಯೇಸುವನ್ನು ಬಂಧಿಸಲು ಪ್ರಯತ್ನಿಸಿದರು. ಆದರೆ ಅವರ ಸಮಯ ಇನ್ನೂ ಬಾರದೆ ಇದ್ದುದರಿಂದ ಅವರ ಮೇಲೆ ಯಾರೂ ಕೈಹಾಕಲಿಲ್ಲ. <verse eid="JHN 7:30"/><verse number="31" style="v" sid="JHN 7:31"/>ಜನರಲ್ಲಿ ಅನೇಕರು ಯೇಸುವನ್ನು ನಂಬಿ, “ಕ್ರಿಸ್ತನು ಬಂದಾಗ ಈತನು ಮಾಡಿದ್ದಕ್ಕಿಂತ ಹೆಚ್ಚು ಸೂಚಕಕಾರ್ಯಗಳನ್ನು ಮಾಡುವನೋ?” ಎಂದರು.<verse eid="JHN 7:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="JHN 7:32"/>ಯೇಸುವಿನ ವಿಷಯವಾಗಿ ಜನರು ತಮ್ಮತಮ್ಮೊಳಗೆ ಮಾತನಾಡುವುದನ್ನು ಫರಿಸಾಯರು ಕೇಳಿದರು. ಫರಿಸಾಯರು ಮತ್ತು ಮುಖ್ಯಯಾಜಕರು ಯೇಸುವನ್ನು ಬಂಧಿಸಲು ಕಾವಲುಗಾರರನ್ನು ಕಳುಹಿಸಿದರು.<verse eid="JHN 7:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="JHN 7:33"/>ಯೇಸು ಅವರಿಗೆ, “ಇನ್ನು ಸ್ವಲ್ಪಕಾಲ ನಾನು ನಿಮ್ಮೊಂದಿಗಿದ್ದು ಅನಂತರ ನನ್ನನ್ನು ಕಳುಹಿಸಿದ ತಂದೆಯ ಬಳಿಗೆ ಹೋಗುತ್ತೇನೆ. <verse eid="JHN 7:33"/><verse number="34" style="v" sid="JHN 7:34"/>ನೀವು ನನ್ನನ್ನು ಹುಡುಕುವಿರಿ. ಆದರೆ ನನ್ನನ್ನು ಕಾಣುವುದಿಲ್ಲ; ನಾನಿರುವಲ್ಲಿಗೆ ನೀವು ಬರಲಾರಿರಿ,” ಎಂದರು.<verse eid="JHN 7:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="JHN 7:35"/>ಆಗ ಯೆಹೂದಿ ನಾಯಕರು, “ನಾವು ಈತನನ್ನು ಕಾಣದ ಹಾಗೆ ಈತ ಎಲ್ಲಿಗೆ ಹೋಗಲಿದ್ದಾನೆ? ಗ್ರೀಕರ ನಡುವೆ ಚದರಿ ಹೋದವರ ಬಳಿಗೆ ಹೋಗಿ ಗ್ರೀಕರಿಗೆ ಬೋಧಿಸುವನೋ? <verse eid="JHN 7:35"/><verse number="36" style="v" sid="JHN 7:36"/>ಈತನು, ‘ನೀವು ನನ್ನನ್ನು ಹುಡುಕುವಿರಿ, ಆದರೆ ನನ್ನನ್ನು ಕಾಣುವುದಿಲ್ಲ ಮತ್ತು ನಾನಿರುವಲ್ಲಿಗೆ ನೀವು ಬರಲಾರಿರಿ,’ ಎಂದು ಹೇಳಿದ ಮಾತು ಏನಾಗಿರಬಹುದು?” ಎಂದು ತಮ್ಮೊಳಗೆ ಮಾತನಾಡಿಕೊಂಡರು.<verse eid="JHN 7:36"/></para>
  <para style="p">
    <verse number="37" style="v" sid="JHN 7:37"/>ಹಬ್ಬದ ಆ ಮಹಾದಿವಸವಾದ ಕಡೆಯ ದಿನದಲ್ಲಿ ಯೇಸು ನಿಂತುಕೊಂಡು, “ಯಾರಿಗಾದರೂ ಬಾಯಾರಿಕೆಯಾಗಿದ್ದರೆ ಅವರು ನನ್ನ ಬಳಿಗೆ ಬಂದು ಕುಡಿಯಲಿ. <verse eid="JHN 7:37"/><verse number="38" style="v" sid="JHN 7:38"/>ಪವಿತ್ರ ವೇದವು ಹೇಳಿದ ಪ್ರಕಾರ ನನ್ನಲ್ಲಿ ನಂಬಿಕೆಯಿಡುವವರ ಅಂತರಂಗದಿಂದ ಜೀವಜಲದ ಹೊಳೆಗಳು ಹರಿಯುವವು,” ಎಂದು ಕೂಗಿ ಹೇಳಿದರು. <verse eid="JHN 7:38"/><verse number="39" style="v" sid="JHN 7:39"/>ಆದರೆ ಯೇಸು ತಮ್ಮಲ್ಲಿ ನಂಬಿಕೆಯಿಡುವವರು ಹೊಂದಲಿರುವ ಪವಿತ್ರಾತ್ಮರನ್ನು ಕುರಿತು ಹೀಗೆ ಹೇಳಿದರು. ಯೇಸು ಇನ್ನೂ ಮಹಿಮೆ ಹೊಂದಿರಲಿಲ್ಲ. ಈ ಕಾರಣದಿಂದ ಪವಿತ್ರ ಆತ್ಮ ಇನ್ನೂ ಬಂದಿರಲಿಲ್ಲ.<verse eid="JHN 7:39"/></para>
  <para style="p">
    <verse number="40" style="v" sid="JHN 7:40"/>ಆದ್ದರಿಂದ ಜನರಲ್ಲಿ ಕೆಲವರು ಈ ಮಾತನ್ನು ಕೇಳಿದಾಗ, “ಈತನು ನಿಜವಾಗಿಯೂ ಪ್ರವಾದಿಯಾಗಿದ್ದಾನೆ,” ಎಂದರು.<verse eid="JHN 7:40"/></para>
  <para style="p">
    <verse number="41" style="v" sid="JHN 7:41"/>ಬೇರೆಯವರು, “ಈತನೇ ಕ್ರಿಸ್ತನು,” ಎಂದರು.</para>
  <para style="p" vid="JHN 7:41">ಆದರೆ ಇನ್ನೂ ಕೆಲವರು, “ಕ್ರಿಸ್ತನು ಗಲಿಲಾಯದಿಂದ ಬರುವುದು ಹೇಗೆ? <verse eid="JHN 7:41"/><verse number="42" style="v" sid="JHN 7:42"/>‘ಕ್ರಿಸ್ತನು ದಾವೀದನ ಸಂತಾನದಿಂದಲೂ ದಾವೀದನಿದ್ದ ಬೇತ್ಲೆಹೇಮೆಂಬ ಊರಿನಿಂದಲೂ ಬರುವನು,’ ಎಂದು ಪವಿತ್ರ ವೇದವು ಹೇಳುತ್ತದಲ್ಲವೇ?” ಎಂದರು. <verse eid="JHN 7:42"/><verse number="43" style="v" sid="JHN 7:43"/>ಹೀಗೆ ಯೇಸುವಿನ ನಿಮಿತ್ತವಾಗಿ ಜನರಲ್ಲಿ ಭೇದ ಉಂಟಾಯಿತು. <verse eid="JHN 7:43"/><verse number="44" style="v" sid="JHN 7:44"/>ಅವರಲ್ಲಿ ಕೆಲವರು ಯೇಸುವನ್ನು ಬಂಧಿಸಬೇಕೆಂದಿದ್ದರು. ಆದರೆ ಯಾರೂ ಯೇಸುವಿನ ಮೇಲೆ ಕೈಹಾಕಲಿಲ್ಲ.<verse eid="JHN 7:44"/></para>
  <para style="s1">ಯೆಹೂದ್ಯ ಅಧಿಕಾರಿಗಳ ಅವಿಶ್ವಾಸ</para>
  <para style="p">
    <verse number="45" style="v" sid="JHN 7:45"/>ಬಳಿಕ ಕಾವಲುಗಾರರು, ಮುಖ್ಯಯಾಜಕರ ಹಾಗೂ ಫರಿಸಾಯರ ಬಳಿಗೆ ಬಂದಾಗ ಅವರು, “ನೀವು ಏಕೆ ಆತನನ್ನು ಹಿಡಿದು ತರಲಿಲ್ಲ?” ಎಂದು ಕೇಳಿದರು.<verse eid="JHN 7:45"/></para>
  <para style="p">
    <verse number="46" style="v" sid="JHN 7:46"/>ಅದಕ್ಕೆ ಕಾವಲುಗಾರರು, “ಯಾವ ಮನುಷ್ಯನೂ ಎಂದೂ ಈತನು ಮಾತನಾಡುವಂತೆ ಮಾತನಾಡಿದ್ದಿಲ್ಲ,” ಎಂದರು.<verse eid="JHN 7:46"/></para>
  <para style="p">
    <verse number="47" style="v" sid="JHN 7:47"/>ಆಗ ಫರಿಸಾಯರು ಅವರಿಗೆ, “ನೀವು ಸಹ ಮರುಳಾದೀರಾ? <verse eid="JHN 7:47"/><verse number="48" style="v" sid="JHN 7:48"/>ಅಧಿಕಾರಿಗಳಲ್ಲಿಯೂ ಫರಿಸಾಯರಲ್ಲಿಯೂ ಯಾರಾದರೂ ಯೇಸುವನ್ನು ನಂಬಿದ್ದುಂಟೇ? <verse eid="JHN 7:48"/><verse number="49" style="v" sid="JHN 7:49"/>ಆದರೆ ಮೋಶೆಯ ನಿಯಮವನ್ನು ಅರಿಯದ ಈ ಜನರು ಶಾಪಗ್ರಸ್ತರೇ,”<note caller="+" style="f"><char style="fr" closed="false">7:49 </char><char style="ft" closed="false"><char style="xt"><ref loc="DEU 27:26">ಧರ್ಮೋ 27:26</ref></char></char></note> ಎಂದು ಹೇಳಿದರು.<verse eid="JHN 7:49"/></para>
  <para style="p">
    <verse number="50" style="v" sid="JHN 7:50"/>ಯೇಸುವಿನ ಬಳಿಗೆ ಒಮ್ಮೆ ಬಂದಿದ್ದ ನಿಕೊದೇಮನು ಅವರಲ್ಲಿ ಒಬ್ಬನಾಗಿದ್ದನು. ಅವನು ಅವರಿಗೆ, <verse eid="JHN 7:50"/><verse number="51" style="v" sid="JHN 7:51"/>“ಒಬ್ಬ ಮನುಷ್ಯನನ್ನು ಮೊದಲು ವಿಚಾರಿಸಿ, ಅವನು ಮಾಡುವುದೇನೆಂದು ತಿಳಿದುಕೊಳ್ಳದೆ ನಮ್ಮ ನಿಯಮವು ಅವನಿಗೆ ತೀರ್ಪುಮಾಡುವುದುಂಟೇ?” ಎಂದನು.<verse eid="JHN 7:51"/></para>
  <para style="p">
    <verse number="52" style="v" sid="JHN 7:52"/>ಅವರು ಅವನಿಗೆ, “ನೀನು ಸಹ ಗಲಿಲಾಯದವನೋ? ಗಲಿಲಾಯದಿಂದ ಒಬ್ಬ ಪ್ರವಾದಿಯೂ ಏಳುವುದಿಲ್ಲ, ನೀನೇ ಪರಿಶೋಧಿಸಿ ನೋಡು,” ಎಂದರು.<verse eid="JHN 7:52"/></para>
  <para style="p">
    <verse number="53" style="v" sid="JHN 7:53"/>
    <char style="it">ಬಳಿಕ ಎಲ್ಲರೂ ತಮ್ಮ ತಮ್ಮ ಮನೆಗೆ ಹೋದರು.</char><verse eid="JHN 7:53"/></para>
  <chapter eid="JHN 7"/>
  <chapter number="8" style="c" sid="JHN 8"/>
  <para style="nb">
    <verse number="1" style="v" sid="JHN 8:1"/>
    <char style="it">ಯೇಸುವಾದರೋ ಓಲಿವ್ ಮರಗಳ ಗುಡ್ಡಕ್ಕೆ ಹೋದರು.</char><verse eid="JHN 8:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="JHN 8:2"/>
    <char style="it">ಬೆಳಿಗ್ಗೆ ಯೇಸು ತಿರುಗಿ ದೇವಾಲಯಕ್ಕೆ ಬಂದಾಗ ಎಲ್ಲಾ ಜನರು ಅವರ ಬಳಿಗೆ ಬಂದರು. ಯೇಸು ಕುಳಿತುಕೊಂಡು ಅವರಿಗೆ ಬೋಧಿಸಿದರು.</char> <verse eid="JHN 8:2"/><verse number="3" style="v" sid="JHN 8:3"/><char style="it">ಆಗ ವ್ಯಭಿಚಾರದಲ್ಲಿ ಸಿಕ್ಕಿದ ಒಬ್ಬ ಸ್ತ್ರೀಯನ್ನು ನಿಯಮ ಬೋಧಕರು ಮತ್ತು ಫರಿಸಾಯರು ಹಿಡಿದು ಯೇಸುವಿನ ಬಳಿಗೆ ತಂದು ಆಕೆಯನ್ನು ನಡುವೆ ನಿಲ್ಲಿಸಿದರು.</char> <verse eid="JHN 8:3"/><verse number="4" style="v" sid="JHN 8:4"/><char style="it">ಅವರು ಯೇಸುವಿಗೆ, “ಬೋಧಕರೇ, ಈ ಸ್ತ್ರೀ ವ್ಯಭಿಚಾರ ಮಾಡುವಾಗಲೇ ಸಿಕ್ಕಿಬಿದ್ದಳು.</char> <verse eid="JHN 8:4"/><verse number="5" style="v" sid="JHN 8:5"/><char style="it">ಇಂಥವರನ್ನು ಕಲ್ಲೆಸೆದು ಕೊಲ್ಲಬೇಕೆಂದು ಮೋಶೆಯು ನಿಯಮದಲ್ಲಿ ನಮಗೆ ಆಜ್ಞಾಪಿಸಿದ್ದಾನೆ. ಆದ್ದರಿಂದ ನೀವು ಏನು ಹೇಳುತ್ತೀರಿ?” ಎಂದು ಕೇಳಿದರು.</char> <verse eid="JHN 8:5"/><verse number="6" style="v" sid="JHN 8:6"/><char style="it">ಅವರು ಯೇಸುವನ್ನು ಮಾತಿನಲ್ಲಿ ಸಿಕ್ಕಿಸಿ ತಪ್ಪು ಹೊರಿಸಬೇಕೆಂದೇ ಹೀಗೆ ಕೇಳಿದರು.</char></para>
  <para style="p" vid="JHN 8:6">
    <char style="it">ಆದರೆ ಯೇಸು ಬಗ್ಗಿಕೊಂಡು ಬೆರಳಿನಿಂದ ನೆಲದ ಮೇಲೆ ಬರೆಯುತ್ತಾ ಇದ್ದರು.</char> <verse eid="JHN 8:6"/><verse number="7" style="v" sid="JHN 8:7"/><char style="it">ಅವರು ಬಿಡದೆ ಪ್ರಶ್ನೆಗಳನ್ನು ಕೇಳುತ್ತಿರಲು ಯೇಸು ನೆಟ್ಟಗೆ ಕುಳಿತುಕೊಂಡು, “ನಿಮ್ಮಲ್ಲಿ ಪಾಪವಿಲ್ಲದವನು ಯಾರಿದ್ದಾನೋ ಅವನೇ ಮೊದಲು ಇವಳ ಮೇಲೆ ಕಲ್ಲು ಎಸೆಯಲಿ,” ಎಂದು ಅವರಿಗೆ ಹೇಳಿದರು.</char> <verse eid="JHN 8:7"/><verse number="8" style="v" sid="JHN 8:8"/><char style="it">ತಿರುಗಿ ಯೇಸು ಬಗ್ಗಿಕೊಂಡು ನೆಲದ ಮೇಲೆ ಬರೆಯತೊಡಗಿದರು.</char><verse eid="JHN 8:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="JHN 8:9"/>
    <char style="it">ಅದನ್ನು ಅವರು ಕೇಳಿ ಹಿರಿಯರು ಮೊದಲುಗೊಂಡು ಕಿರಿಯರವರೆಗೂ ಒಬ್ಬೊಬ್ಬರಾಗಿ ಹೊರಟು ಹೋದರು; ಆಗ ಯೇಸು ಒಬ್ಬರೇ ಉಳಿದರು. ಆ ಸ್ತ್ರೀಯು ಅಲ್ಲಿಯೇ ನಿಂತಿದ್ದಳು.</char> <verse eid="JHN 8:9"/><verse number="10" style="v" sid="JHN 8:10"/><char style="it">ಯೇಸು ನೆಟ್ಟಗೆ ಕುಳಿತುಕೊಂಡು ಆಕೆಗೆ, “ಅಮ್ಮಾ ಅವರು ಎಲ್ಲಿದ್ದಾರೆ? ನಿನಗೆ ಯಾರೂ ಶಿಕ್ಷೆ ವಿಧಿಸಲಿಲ್ಲವೋ?” ಎಂದರು.</char><verse eid="JHN 8:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="JHN 8:11"/>
    <char style="it">ಅದಕ್ಕೆ ಆಕೆಯು, “ಸ್ವಾಮಿ, ಯಾರೂ ಶಿಕ್ಷೆ ವಿಧಿಸಲಿಲ್ಲ,” ಎಂದಳು.</char></para>
  <para style="p" vid="JHN 8:11">
    <char style="it">ಯೇಸು ಆಕೆಗೆ, “ನಾನೂ ನಿನಗೆ ಶಿಕ್ಷೆ ವಿಧಿಸುವುದಿಲ್ಲ, ಹೋಗು; ಇನ್ನು ಮೇಲೆ ಪಾಪ ಮಾಡಬೇಡ,” ಎಂದರು.</char>
    <note caller="+" style="f">
      <char style="fr" closed="false">8:11 </char>
      <char style="ft" closed="false">ಕೆಲವು ಮೂಲ ಪ್ರತಿಗಳಲ್ಲಿ <char style="xt"><ref loc="JHN 7:53-8:11">ಯೋಹಾನ 7:53–8:11</ref></char> ವಾಕ್ಯ ಸೇರ್ಪಡೆಯಾಗಿರುವುದಿಲ್ಲ.</char>
    </note><verse eid="JHN 8:11"/></para>
  <para style="s1">ಯೇಸುವಿನ ಕುರಿತಾಗಿ ತಂದೆಯ ಸಾಕ್ಷಿ</para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 8:12"/>ಯೇಸು ಪುನಃ ಜನರೊಂದಿಗೆ ಮಾತನಾಡುತ್ತಾ, “ನಾನೇ ಲೋಕದ ಬೆಳಕಾಗಿದ್ದೇನೆ. ನನ್ನನ್ನು ಹಿಂಬಾಲಿಸುವವರು ಎಂದಿಗೂ ಕತ್ತಲೆಯಲ್ಲಿ ನಡೆಯುವುದಿಲ್ಲ. ಅವರು ಜೀವದ ಬೆಳಕನ್ನು ಹೊಂದಿರುವರು,” ಎಂದು ಹೇಳಿದರು.<verse eid="JHN 8:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="JHN 8:13"/>ಫರಿಸಾಯರು ಯೇಸುವಿಗೆ, “ನಿನ್ನ ವಿಷಯವಾಗಿ ನೀನೇ ಸಾಕ್ಷಿ ನೀಡುತ್ತಿರುವೆ, ನಿನ್ನ ಸಾಕ್ಷಿಯು ಸತ್ಯವಾದುದ್ದಲ್ಲ,” ಎಂದು ಹೇಳಿದರು.<verse eid="JHN 8:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="JHN 8:14"/>ಯೇಸು ಅವರಿಗೆ, “ನಾನೇ ನನ್ನ ವಿಷಯವಾಗಿ ನಾನು ಸಾಕ್ಷಿ ನೀಡಿದರೂ ನನ್ನ ಸಾಕ್ಷಿ ಸತ್ಯವಾದದ್ದು. ಏಕೆಂದರೆ ನಾನು ಎಲ್ಲಿಂದ ಬಂದೆ ಮತ್ತು ಎಲ್ಲಿಗೆ ಹೋಗುತ್ತೇನೆಂದು ನನಗೆ ತಿಳಿದಿದೆ. ಆದರೆ ನಾನು ಎಲ್ಲಿಂದ ಬಂದೆ ಇಲ್ಲವೆ ಎಲ್ಲಿಗೆ ಹೋಗುತ್ತೇನೋ ನಿಮಗೆ ತಿಳಿಯದು. <verse eid="JHN 8:14"/><verse number="15" style="v" sid="JHN 8:15"/>ನೀವು ಮಾನವ ರೀತಿಯಲ್ಲಿ ತೀರ್ಪು ಮಾಡುತ್ತೀರಿ. ನಾನು ಯಾರಿಗೂ ತೀರ್ಪು ಮಾಡುವುದಿಲ್ಲ. <verse eid="JHN 8:15"/><verse number="16" style="v" sid="JHN 8:16"/>ನಾನು ತೀರ್ಪು ಮಾಡಿದರೂ ನನ್ನ ತೀರ್ಪು ಸತ್ಯವಾದದ್ದೇ. ಏಕೆಂದರೆ ನಾನು ಒಂಟಿಗನಲ್ಲ. ನಾನೂ ನನ್ನನ್ನು ಕಳುಹಿಸಿದ ತಂದೆಯೂ ಇದ್ದೇವೆ. <verse eid="JHN 8:16"/><verse number="17" style="v" sid="JHN 8:17"/>‘ಇಬ್ಬರ ಸಾಕ್ಷಿಯು ಸತ್ಯವಾದದ್ದು’ ಎಂದು ನಿಮ್ಮ ನಿಯಮದಲ್ಲಿಯೇ ಬರೆದಿದೆ. <verse eid="JHN 8:17"/><verse number="18" style="v" sid="JHN 8:18"/>ನನ್ನ ವಿಷಯವಾಗಿ ಸಾಕ್ಷಿ ನೀಡುವವನು ನಾನೇ ಮತ್ತು ನನ್ನನ್ನು ಕಳುಹಿಸಿದ ತಂದೆಯೂ ನನ್ನ ವಿಷಯವಾಗಿ ಸಾಕ್ಷಿ ನೀಡುತ್ತಾರೆ,” ಎಂದರು.<verse eid="JHN 8:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="JHN 8:19"/>ಆಗ ಅವರು, “ನಿನ್ನ ತಂದೆ ಎಲ್ಲಿ?” ಎಂದರು.</para>
  <para style="p" vid="JHN 8:19">ಅದಕ್ಕೆ ಯೇಸು ಅವರಿಗೆ, “ನೀವು ನನ್ನನ್ನಾಗಲಿ ನನ್ನ ತಂದೆಯನ್ನಾಗಲಿ ತಿಳಿದಿಲ್ಲ, ನೀವು ನನ್ನನ್ನು ತಿಳಿದಿದ್ದರೆ ನನ್ನ ತಂದೆಯನ್ನು ಸಹ ತಿಳಿಯುತ್ತಿದ್ದೀರಿ,” ಎಂದು ಉತ್ತರಕೊಟ್ಟರು. <verse eid="JHN 8:19"/><verse number="20" style="v" sid="JHN 8:20"/>ಯೇಸು ದೇವಾಲಯದ ಕಾಣಿಕೆ ಪೆಟ್ಟಿಗೆಗಳನ್ನಿಟ್ಟ ಸ್ಥಳದಲ್ಲಿ ಬೋಧಿಸುತ್ತಿದ್ದಾಗ ಈ ಮಾತುಗಳನ್ನು ಹೇಳಿದರು. ಆದರೆ ಯೇಸುವಿನ ಸಮಯ ಇನ್ನೂ ಬಾರದಿದ್ದ ಕಾರಣ ಯಾರೂ ಅವರನ್ನು ಬಂಧಿಸಲಿಲ್ಲ.<verse eid="JHN 8:20"/></para>
  <para style="s1">ಯೇಸು ಯಾರೆಂದು ವಿವಾದ</para>
  <para style="p">
    <verse number="21" style="v" sid="JHN 8:21"/>ಯೇಸು ತಿರುಗಿ ಅವರಿಗೆ, “ನಾನು ಹೊರಟುಹೋಗುತ್ತೇನೆ. ನೀವು ನನ್ನನ್ನು ಹುಡುಕುವಿರಿ ಮತ್ತು ನಿಮ್ಮ ಪಾಪದಲ್ಲೇ ನೀವು ಸಾಯುವಿರಿ. ನಾನು ಹೋಗುವಲ್ಲಿಗೆ ನೀವು ಬರಲಾರಿರಿ,” ಎಂದರು.<verse eid="JHN 8:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 8:22"/>ಅದಕ್ಕೆ ಯೆಹೂದ್ಯರು, “ಈತನು ಆತ್ಮಹತ್ಯೆ ಮಾಡಿಕೊಳ್ಳಬೇಕೆಂದಿದ್ದಾನೋ? ಏಕೆಂದರೆ, ‘ನಾನು ಹೋಗುವಲ್ಲಿಗೆ ನೀವು ಬರಲಾರಿರಿ,’ ಎಂದು ಹೇಳುತ್ತಾನಲ್ಲಾ?” ಎಂದರು.<verse eid="JHN 8:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="JHN 8:23"/>ಯೇಸು ಅವರಿಗೆ, “ನೀವು ಕೆಳಗಿನವರು, ನಾನು ಮೇಲಿನವನು. ನೀವು ಈ ಲೋಕದವರು, ನಾನು ಈ ಲೋಕದವನಲ್ಲ. <verse eid="JHN 8:23"/><verse number="24" style="v" sid="JHN 8:24"/>ಆದ್ದರಿಂದ, ‘ನೀವು ನಿಮ್ಮ ಪಾಪಗಳಲ್ಲಿಯೇ ಸಾಯುವಿರಿ,’ ಎಂದು ನಾನು ನಿಮಗೆ ಹೇಳಿದೆನು. ಏಕೆಂದರೆ ನೀವು ನನ್ನನ್ನು ನಂಬದೆ ಹೋದರೆ ನೀವು ನಿಮ್ಮ ಪಾಪಗಳಲ್ಲಿಯೇ ಸಾಯುವಿರಿ,” ಎಂದು ಹೇಳಿದರು.<verse eid="JHN 8:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 8:25"/>ಅವರು ಯೇಸುವಿಗೆ, “ನೀನು ಯಾರು?” ಎಂದರು.</para>
  <para style="p" vid="JHN 8:25">ಅದಕ್ಕೆ ಯೇಸು ಅವರಿಗೆ, “ಮೊದಲಿನಿಂದ ನಾನು ನಿಮಗೆ ಹೇಳಿದಂತವನೇ. <verse eid="JHN 8:25"/><verse number="26" style="v" sid="JHN 8:26"/>ನಿಮ್ಮ ವಿಷಯವಾಗಿ ಮಾತನಾಡುವುದಕ್ಕೂ ತೀರ್ಪುಮಾಡುವುದಕ್ಕೂ ನನಗೆ ಅನೇಕ ವಿಷಯಗಳಿವೆ. ಆದರೆ ನನ್ನನ್ನು ಕಳುಹಿಸಿದ ತಂದೆಯು ಸತ್ಯವಂತರು. ನಾನು ಅವರಿಂದ ಕೇಳಿದವುಗಳನ್ನು ಮಾತ್ರವೇ ಲೋಕಕ್ಕೆ ಹೇಳುತ್ತೇನೆ,” ಎಂದರು.<verse eid="JHN 8:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="JHN 8:27"/>ಯೇಸು ತಂದೆಯ ವಿಷಯವಾಗಿ ಅವರೊಂದಿಗೆ ಮಾತನಾಡಿದರೆಂದು ಅವರು ತಿಳಿಯಲಿಲ್ಲ. <verse eid="JHN 8:27"/><verse number="28" style="v" sid="JHN 8:28"/>ಯೇಸು ಅವರಿಗೆ, “ಮನುಷ್ಯಪುತ್ರನಾದ ನನ್ನನ್ನು ನೀವು ಮೇಲಕ್ಕೇರಿಸಿದಾಗ ‘ನಾನೇ ಆತನು’ ಎಂದು ನಿಮಗೆ ತಿಳಿಯುವುದು. ನನ್ನಷ್ಟಕ್ಕೆ ನಾನೇ ಏನೂ ಮಾಡದೆ ನನ್ನ ತಂದೆಯು ನನಗೆ ಬೋಧಿಸಿದಂತೆ ನಾನು ಈ ಸಂಗತಿಗಳನ್ನು ಮಾತನಾಡುತ್ತೇನೆ ಎಂದೂ ನೀವು ತಿಳಿದುಕೊಳ್ಳುವಿರಿ. <verse eid="JHN 8:28"/><verse number="29" style="v" sid="JHN 8:29"/>ನನ್ನನ್ನು ಕಳುಹಿಸಿದ ತಂದೆ ನನ್ನ ಸಂಗಡ ಇದ್ದಾರೆ. ಅವರು ನನ್ನನ್ನು ಒಬ್ಬಂಟಿಗನನ್ನಾಗಿ ಬಿಡಲಿಲ್ಲ, ಏಕೆಂದರೆ ಅವರಿಗೆ ಮೆಚ್ಚಿದವುಗಳನ್ನೇ ನಾನು ಯಾವಾಗಲೂ ಮಾಡುತ್ತೇನೆ,” ಎಂದರು. <verse eid="JHN 8:29"/><verse number="30" style="v" sid="JHN 8:30"/>ಯೇಸು ಈ ಮಾತುಗಳನ್ನು ಹೇಳುತ್ತಿದ್ದಾಗಲೇ ಅನೇಕರು ಅವರಲ್ಲಿ ನಂಬಿಕೆಯಿಟ್ಟರು.<verse eid="JHN 8:30"/></para>
  <para style="s1">ಅಬ್ರಹಾಮನ ಮಕ್ಕಳು</para>
  <para style="p">
    <verse number="31" style="v" sid="JHN 8:31"/>ಯೇಸು ತಮ್ಮನ್ನು ನಂಬಿದ್ದ ಯೆಹೂದ್ಯರಿಗೆ ಹೇಳಿದ್ದೇನೆಂದರೆ, “ನೀವು ನನ್ನ ವಾಕ್ಯದಲ್ಲಿ ನೆಲೆಗೊಂಡಿದ್ದರೆ ನಿಜವಾಗಿಯೂ ನೀವು ನನ್ನ ಶಿಷ್ಯರಾಗುವಿರಿ. <verse eid="JHN 8:31"/><verse number="32" style="v" sid="JHN 8:32"/>ಇದಲ್ಲದೆ ನೀವು ಸತ್ಯವನ್ನು ತಿಳಿದುಕೊಳ್ಳುವಿರಿ; ಸತ್ಯವು ನಿಮ್ಮನ್ನು ಸ್ವತಂತ್ರರಾಗಿ ಮಾಡುವುದು,” ಎಂದು ಹೇಳಿದರು.<verse eid="JHN 8:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="JHN 8:33"/>ಅದಕ್ಕೆ ಅವರು ಯೇಸುವಿಗೆ, “ನಾವು ಅಬ್ರಹಾಮನ ಸಂತತಿಯವರು, ನಾವು ಯಾರಿಗೂ ಎಂದೂ ಗುಲಾಮರಾಗಿರಲಿಲ್ಲ. ನೀವು ಸ್ವತಂತ್ರರಾಗುವಿರಿ ಎಂದು ನೀನು ಹೇಳುವುದು ಹೇಗೆ?” ಎಂದು ಕೇಳಿದರು.<verse eid="JHN 8:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="JHN 8:34"/>ಅದಕ್ಕೆ ಯೇಸು ಉತ್ತರವಾಗಿ, “ನಾನು ನಿಮಗೆ ನಿಜನಿಜವಾಗಿ ಹೇಳುತ್ತೇನೆ, ಪಾಪ ಮಾಡುವವರು ಪಾಪಕ್ಕೆ ಗುಲಾಮರಾಗಿದ್ದಾರೆ. <verse eid="JHN 8:34"/><verse number="35" style="v" sid="JHN 8:35"/>ಗುಲಾಮರು ಕುಟುಂಬದಲ್ಲಿ ಶಾಶ್ವತವಾಗಿ ಇರುವುದಿಲ್ಲ. ಆದರೆ ಪುತ್ರನು ಶಾಶ್ವತವಾಗಿ ಇರುತ್ತಾನೆ. <verse eid="JHN 8:35"/><verse number="36" style="v" sid="JHN 8:36"/>ಆದ್ದರಿಂದ ದೇವಪುತ್ರನು ನಿಮ್ಮನ್ನು ಬಿಡುಗಡೆ ಮಾಡಿದರೆ, ನಿಜವಾಗಿ ನೀವು ಬಿಡುಗಡೆಯಾಗುವಿರಿ. <verse eid="JHN 8:36"/><verse number="37" style="v" sid="JHN 8:37"/>ನೀವು ಅಬ್ರಹಾಮನ ಸಂತತಿಯವರೆಂದು ನಾನು ಬಲ್ಲೆನು. ಆದರೆ ನಿಮ್ಮಲ್ಲಿ ನನ್ನ ವಾಕ್ಯಕ್ಕೆ ಸ್ಥಳವಿಲ್ಲದ ಕಾರಣ ನೀವು ನನ್ನನ್ನು ಕೊಲ್ಲಲು ಹುಡುಕುತ್ತೀರಿ. <verse eid="JHN 8:37"/><verse number="38" style="v" sid="JHN 8:38"/>ನಾನು ತಂದೆಯ ಬಳಿಯಲ್ಲಿ ಕಂಡದ್ದನ್ನೇ ಮಾತನಾಡುತ್ತೇನೆ. ನೀವಾದರೋ ನಿಮ್ಮ ತಂದೆಯಿಂದ ಕೇಳಿದ್ದನ್ನು ಮಾಡುತ್ತೀರಿ,” ಎಂದರು.<verse eid="JHN 8:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="JHN 8:39"/>ಯೆಹೂದ್ಯರು ಯೇಸುವಿಗೆ, “ಅಬ್ರಹಾಮನು ನಮ್ಮ ತಂದೆ,” ಎಂದರು.</para>
  <para style="p" vid="JHN 8:39">ಅದಕ್ಕೆ ಯೇಸು ಅವರಿಗೆ, “ನೀವು ಅಬ್ರಹಾಮನ ಮಕ್ಕಳಾಗಿದ್ದರೆ ಅಬ್ರಹಾಮನು ಮಾಡಿದ ಕ್ರಿಯೆಗಳನ್ನೇ ಮಾಡುತ್ತಿದ್ದಿರಿ. <verse eid="JHN 8:39"/><verse number="40" style="v" sid="JHN 8:40"/>ಆದರೆ ದೇವರಿಂದ ಕೇಳಿದ ಸತ್ಯವನ್ನು ನಿಮಗೆ ಹೇಳಿದ ನನ್ನನ್ನು ಈಗ ಕೊಲ್ಲಲು ಪ್ರಯತ್ನಿಸುತ್ತೀರಿ. ಇಂತಹ ಕ್ರಿಯೆಗಳನ್ನು ಅಬ್ರಹಾಮನು ಮಾಡಲಿಲ್ಲ. <verse eid="JHN 8:40"/><verse number="41" style="v" sid="JHN 8:41"/>ನೀವು ನಿಮ್ಮ ತಂದೆಯ ಕ್ರಿಯೆಗಳನ್ನು ಮಾಡುತ್ತೀರಿ,” ಎಂದರು.</para>
  <para style="p" vid="JHN 8:41">ಅದಕ್ಕವರು, “ನಾವು ಅನೈತಿಕತೆಯಿಂದ ಹುಟ್ಟಿದವರಲ್ಲ. ನಮಗೆ ದೇವರೇ ತಂದೆ,” ಎಂದು ಪ್ರತಿಭಟಿಸಿದರು.<verse eid="JHN 8:41"/></para>
  <para style="p">
    <verse number="42" style="v" sid="JHN 8:42"/>ಯೇಸು ಅವರಿಗೆ, “ದೇವರು ನಿಮ್ಮ ತಂದೆಯಾಗಿದ್ದರೆ ನೀವು ನನ್ನನ್ನು ಪ್ರೀತಿಸುತ್ತಿದ್ದಿರಿ. ಏಕೆಂದರೆ ನಾನು ದೇವರಿಂದ ಹೊರಟು ಬಂದಿದ್ದೇನೆ. ನಾನು ನನ್ನಷ್ಟಕ್ಕೆ ಬರಲಿಲ್ಲ. ಆದರೆ ದೇವರೇ ನನ್ನನ್ನು ಕಳುಹಿಸಿದ್ದು. <verse eid="JHN 8:42"/><verse number="43" style="v" sid="JHN 8:43"/>ನೀವು ನನ್ನ ಮಾತನ್ನು ಅರ್ಥಮಾಡಿಕೊಳ್ಳದಿರುವುದು ಯಾಕೆ? ನಾನು ಹೇಳುವುದನ್ನು ನೀವು ಕೇಳದೇ ಇರುವುದೇ ಇದಕ್ಕೆ ಕಾರಣ. <verse eid="JHN 8:43"/><verse number="44" style="v" sid="JHN 8:44"/>ನೀವು ನಿಮ್ಮ ತಂದೆಯಾದ ಪಿಶಾಚನಿಗೆ ಸೇರಿದವರಾಗಿದ್ದೀರಿ. ನಿಮ್ಮ ತಂದೆಯ ಆಶೆಗಳನ್ನೇ ನೀವು ಮಾಡಬಯಸುತ್ತೀರಿ. ಅವನು ಆದಿಯಿಂದಲೂ ಕೊಲೆಗಾರನಾಗಿದ್ದು ಸತ್ಯದಲ್ಲಿ ನಿಲ್ಲಲಿಲ್ಲ. ಏಕೆಂದರೆ ಅವನಲ್ಲಿ ಸತ್ಯವೇ ಇಲ್ಲ. ಅವನು ಸುಳ್ಳಾಡುವಾಗ ತನ್ನ ಸ್ವಭಾವಾನುಸಾರವಾಗಿ ಆಡುತ್ತಾನೆ. ಅವನು ಸುಳ್ಳುಗಾರನೂ ಸುಳ್ಳಿನ ತಂದೆಯೂ ಆಗಿದ್ದಾನೆ. <verse eid="JHN 8:44"/><verse number="45" style="v" sid="JHN 8:45"/>ಆದರೆ ನಾನು ಸತ್ಯವನ್ನು ಹೇಳುವವನಾದ್ದರಿಂದ ನೀವು ನನ್ನನ್ನು ನಂಬುವುದಿಲ್ಲ. <verse eid="JHN 8:45"/><verse number="46" style="v" sid="JHN 8:46"/>ನನ್ನಲ್ಲಿ ಪಾಪವಿದೆಯೆಂದು ರುಜುವಾತು ಪಡಿಸುವವರು ನಿಮ್ಮಲ್ಲಿ ಯಾರಿದ್ದಾರೆ? ನಾನು ಸತ್ಯವನ್ನೇ ಹೇಳುವುದಾದರೆ ನೀವು ನನ್ನನ್ನು ಏಕೆ ನಂಬುವುದಿಲ್ಲ? <verse eid="JHN 8:46"/><verse number="47" style="v" sid="JHN 8:47"/>ದೇವರಿಗೆ ಸೇರಿದವನು ದೇವರ ವಾಕ್ಯಕ್ಕೆ ಕಿವಿಗೊಡುತ್ತಾನೆ. ನೀವು ದೇವರಿಗೆ ಸೇರಿದವರಲ್ಲ. ಆದ್ದರಿಂದ ನೀವು ಕಿವಿಗೊಡುವುದಿಲ್ಲ,” ಎಂದು ಹೇಳಿದರು.<verse eid="JHN 8:47"/></para>
  <para style="s1">ತನ್ನ ಕುರಿತಾಗಿ ಯೇಸುವಿನ ಹಕ್ಕು</para>
  <para style="p">
    <verse number="48" style="v" sid="JHN 8:48"/>ಅದಕ್ಕೆ ಯೆಹೂದಿ ನಾಯಕರು ಯೇಸುವಿಗೆ, “ನೀನು ಸಮಾರ್ಯದವನು ಮತ್ತು ನಿನಗೆ ದೆವ್ವ ಹಿಡಿದಿದೆ ಎಂದು ನಾವು ಹೇಳುವುದು ಸರಿಯಲ್ಲವೇ?” ಎಂದು ಕೇಳಿದರು.<verse eid="JHN 8:48"/></para>
  <para style="p">
    <verse number="49" style="v" sid="JHN 8:49"/>ಅದಕ್ಕೆ ಯೇಸು, “ನನಗೆ ದೆವ್ವ ಹಿಡಿದಿಲ್ಲ. ಆದರೆ ನನ್ನ ತಂದೆಯನ್ನು ಸನ್ಮಾನಿಸುತ್ತೇನೆ. ನೀವು ನನ್ನನ್ನು ಅವಮಾನಪಡಿಸುತ್ತೀರಿ. <verse eid="JHN 8:49"/><verse number="50" style="v" sid="JHN 8:50"/>ನಾನು ನನ್ನ ಮಹಿಮೆಯನ್ನು ಹುಡುಕುವುದಿಲ್ಲ. ನನಗೆ ಮಹಿಮೆಯನ್ನು ಹುಡುಕುವವರು ಒಬ್ಬರಿದ್ದಾರೆ ಅವರೇ ನ್ಯಾಯತೀರಿಸುವವರು. <verse eid="JHN 8:50"/><verse number="51" style="v" sid="JHN 8:51"/>ನಾನು ನಿಮಗೆ ನಿಜನಿಜವಾಗಿ ಹೇಳುತ್ತೇನೆ, ಯಾರು ನನ್ನ ಮಾತನ್ನು ಪಾಲಿಸುತ್ತಾರೋ ಅವರು ಎಂದೆಂದಿಗೂ ಮರಣವನ್ನು ಕಾಣುವುದಿಲ್ಲ,” ಎಂದರು.<verse eid="JHN 8:51"/></para>
  <para style="p">
    <verse number="52" style="v" sid="JHN 8:52"/>ಆಗ ಯೆಹೂದಿ ನಾಯಕರು ಯೇಸುವಿಗೆ, “ನಿನಗೆ ದೆವ್ವ ಹಿಡಿದಿದೆ ಎಂದು ನಮಗೆ ಈಗ ತಿಳಿಯಿತು. ಅಬ್ರಹಾಮನು ಮತ್ತು ಪ್ರವಾದಿಗಳು ಸತ್ತರು. ಆದರೆ, ‘ಯಾರಾದರೂ ನನ್ನ ಮಾತನ್ನು ಪಾಲಿಸಿದರೆ ಅವರು ಎಂದೆಂದಿಗೂ ಮರಣ ಹೊಂದುವುದಿಲ್ಲ,’ ಎಂದು ನೀನು ಹೇಳುತ್ತೀಯಲ್ಲಾ? <verse eid="JHN 8:52"/><verse number="53" style="v" sid="JHN 8:53"/>ಸತ್ತು ಹೋದ ನಮ್ಮ ತಂದೆ ಅಬ್ರಹಾಮನಿಗಿಂತಲೂ ನೀನು ದೊಡ್ಡವನೋ? ಪ್ರವಾದಿಗಳೂ ಸತ್ತುಹೋದರು. ನೀನು ನಿನ್ನನ್ನು ಯಾರನ್ನಾಗಿ ಮಾಡಿಕೊಂಡಿರುವೆ?” ಎಂದು ಕೇಳಿದರು.<verse eid="JHN 8:53"/></para>
  <para style="p">
    <verse number="54" style="v" sid="JHN 8:54"/>ಯೇಸು, “ನನ್ನನ್ನು ನಾನೇ ಮಹಿಮೆಪಡಿಸಿಕೊಂಡರೆ ನನ್ನ ಮಹಿಮೆಯು ಏನೂ ಅಲ್ಲ. ನೀವು ಯಾರನ್ನು, ‘ಅವರೇ ನಮ್ಮ ದೇವರು’ ಎಂದು ಹೇಳುತ್ತೀರೋ ಆ ನನ್ನ ತಂದೆಯೇ ನನ್ನನ್ನು ಮಹಿಮೆ ಪಡಿಸುವವರು. <verse eid="JHN 8:54"/><verse number="55" style="v" sid="JHN 8:55"/>ನೀವು ಅವರನ್ನು ಅರಿತುಕೊಂಡಿಲ್ಲ; ಆದರೆ ನಾನು ಅವರನ್ನು ಅರಿತಿದ್ದೇನೆ. ನಾನು ಅವರನ್ನು ಅರಿಯಲಿಲ್ಲವೆಂದು ಹೇಳಿದರೆ ನಿಮ್ಮ ಹಾಗೆ ನಾನೂ ಸುಳ್ಳುಗಾರನಾಗುವೆನು. ಆದರೆ ನಾನು ಅವರನ್ನು ಅರಿತಿದ್ದೇನೆ. ಅವರ ಮಾತನ್ನು ಪಾಲಿಸುತ್ತೇನೆ. <verse eid="JHN 8:55"/><verse number="56" style="v" sid="JHN 8:56"/>ನಿಮ್ಮ ತಂದೆ ಅಬ್ರಹಾಮನು ನನ್ನ ದಿನವನ್ನು ಕಾಣುವನೆಂದು ಆನಂದಿಸಿದನು ಮತ್ತು ಅದನ್ನು ಕಂಡು ಉಲ್ಲಾಸಪಟ್ಟನು,” ಎಂದು ಹೇಳಿದರು.<verse eid="JHN 8:56"/></para>
  <para style="p">
    <verse number="57" style="v" sid="JHN 8:57"/>ಆಗ ಯೆಹೂದಿ ನಾಯಕರು ಯೇಸುವಿಗೆ, “ನಿನಗೆ ಇನ್ನೂ ಐವತ್ತು ವರ್ಷವಾಗಿಲ್ಲ, ನೀನು ಅಬ್ರಹಾಮನನ್ನು ಕಂಡಿದ್ದೀಯಾ?” ಎಂದರು.<verse eid="JHN 8:57"/></para>
  <para style="p">
    <verse number="58" style="v" sid="JHN 8:58"/>ಯೇಸು ಅವರಿಗೆ, “ನಾನು ನಿಮಗೆ ನಿಜನಿಜವಾಗಿ ಹೇಳುತ್ತೇನೆ, ಅಬ್ರಹಾಮನು ಹುಟ್ಟುವುದಕ್ಕಿಂತ ಮುಂಚೆಯೇ ನಾನು ಇದ್ದೇನೆ,” ಎಂದರು. <verse eid="JHN 8:58"/><verse number="59" style="v" sid="JHN 8:59"/>ಆಗ ಅವರು ಯೇಸುವಿನ ಮೇಲೆ ಎಸೆಯಲು ಕಲ್ಲುಗಳನ್ನು ಎತ್ತಿಕೊಂಡರು. ಆದರೆ ಯೇಸು ಅಡಗಿಕೊಂಡು ದೇವಾಲಯದೊಳಗಿಂದ ಹೊರಟು ಹೋದರು.<verse eid="JHN 8:59"/></para>
  <chapter eid="JHN 8"/>
  <chapter number="9" style="c" sid="JHN 9"/>
  <para style="s1">ಯೇಸು ಸಬ್ಬತ್ ದಿನದಲ್ಲಿ ಹುಟ್ಟು ಕುರುಡನಿಗೆ ಕಣ್ಣು ಕೊಟ್ಟದ್ದು</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 9:1"/>ಯೇಸು ನಡೆದು ಹೋಗುತ್ತಿದ್ದಾಗ, ಹುಟ್ಟುಕುರುಡನಾಗಿದ್ದ ಒಬ್ಬ ಮನುಷ್ಯನನ್ನು ಕಂಡರು. <verse eid="JHN 9:1"/><verse number="2" style="v" sid="JHN 9:2"/>ಯೇಸುವಿನ ಶಿಷ್ಯರು, “ಬೋಧಕರೇ, ಇವನು ಕುರುಡನಾಗಿ ಹುಟ್ಟಿರುವುದಕ್ಕೆ ಯಾರು ಪಾಪಮಾಡಿದರು? ಈ ಮನುಷ್ಯನ ಪಾಪದಿಂದಲೋ ಇವನ ತಂದೆತಾಯಿಗಳ ಪಾಪದಿಂದಲೋ?” ಎಂದು ಅವರನ್ನು ಕೇಳಿದರು.<verse eid="JHN 9:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="JHN 9:3"/>ಯೇಸು, “ಈ ಮನುಷ್ಯನಾಗಲಿ ಇವನ ತಂದೆತಾಯಿಗಳಾಗಲಿ ಪಾಪಮಾಡಲಿಲ್ಲ. ಆದರೆ ದೇವರ ಕ್ರಿಯೆಗಳು ಇವನಲ್ಲಿ ವ್ಯಕ್ತವಾಗುವಂತೆ ಹೀಗಾಯಿತು. <verse eid="JHN 9:3"/><verse number="4" style="v" sid="JHN 9:4"/>ನನ್ನನ್ನು ಕಳುಹಿಸಿದ ತಂದೆಯ ಕೆಲಸಗಳನ್ನು ಹಗಲಿರುವಾಗಲೇ ನಾವು ಮಾಡಬೇಕು. ರಾತ್ರಿ ಬಂದಾಗ ಯಾರಿಗೂ ಕೆಲಸ ಮಾಡಲಾಗದು. <verse eid="JHN 9:4"/><verse number="5" style="v" sid="JHN 9:5"/>ನಾನು ಈ ಲೋಕದಲ್ಲಿರುವಾಗ ಲೋಕದ ಬೆಳಕಾಗಿದ್ದೇನೆ,” ಎಂದರು.<verse eid="JHN 9:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="JHN 9:6"/>ಯೇಸು ಹೀಗೆ ಹೇಳಿ ನೆಲದ ಮೇಲೆ ಉಗುಳಿ ಆ ಉಗುಳಿನಿಂದ ಮಣ್ಣಿನ ಲೇಪಮಾಡಿ ಆ ಲೇಪವನ್ನು ಅವನ ಕಣ್ಣುಗಳಿಗೆ ಹಚ್ಚಿದರು. <verse eid="JHN 9:6"/><verse number="7" style="v" sid="JHN 9:7"/>ಅವನಿಗೆ, “ಹೋಗು, ಸಿಲೋವ ಕೊಳದಲ್ಲಿ ತೊಳೆದುಕೋ,” ಎಂದರು. ಸಿಲೋವ ಎಂದರೆ, “ಕಳುಹಿಸಲಾದವನು” ಎಂದರ್ಥ. ಕುರುಡನು ಹೋಗಿ ಕಣ್ಣು ತೊಳೆದುಕೊಂಡು ದೃಷ್ಟಿಹೊಂದಿದವನಾಗಿ ಬಂದನು.<verse eid="JHN 9:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="JHN 9:8"/>ಆಗ ನೆರೆಯವರು ಮತ್ತು ಮೊದಲು ಭಿಕ್ಷುಕನಾಗಿದ್ದಾಗ ಅವನನ್ನು ಕಂಡವರು, “ಕುಳಿತುಕೊಂಡು ಭಿಕ್ಷೆ ಬೇಡುತ್ತಿದ್ದವನು ಇವನೇ ಅಲ್ಲವೇ?” ಎಂದರು. <verse eid="JHN 9:8"/><verse number="9" style="v" sid="JHN 9:9"/>ಕೆಲವರು, “ಹೌದು, ಇವನೇ,” ಎಂದರು.</para>
  <para style="p" vid="JHN 9:9">ಇನ್ನೂ ಬೇರೆಯವರು, “ಇಲ್ಲಾ, ಇವನು ಅವನ ಹಾಗೆ ಇದ್ದಾನೆ,” ಎಂದರು.</para>
  <para style="p" vid="JHN 9:9">ಅವನಾದರೋ, “ನಾನೇ ಅವನು,” ಎಂದು ಹೇಳಿದನು.<verse eid="JHN 9:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="JHN 9:10"/>ಕೆಲವರು ಅವನಿಗೆ, “ಹಾಗಾದರೆ ನಿನಗೆ ದೃಷ್ಟಿ ಹೇಗೆ ಬಂತು?” ಎಂದು ಕೇಳಲು,<verse eid="JHN 9:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="JHN 9:11"/>ಅವನು, “ಯೇಸು ಎಂಬ ಹೆಸರುಳ್ಳ ಮನುಷ್ಯನು ಮಣ್ಣಿನ ಲೇಪಮಾಡಿ ನನ್ನ ಕಣ್ಣಿಗೆ ಹಚ್ಚಿ ನನಗೆ, ‘ಸಿಲೋವ ಕೊಳಕ್ಕೆ ಹೋಗಿ ತೊಳೆದುಕೋ,’ ಎಂದನು. ಅದರಂತೆ ನಾನು ಹೋಗಿ ತೊಳೆದುಕೊಂಡೆನು, ನನಗೆ ದೃಷ್ಟಿ ಬಂತು,” ಎಂದನು.<verse eid="JHN 9:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 9:12"/>ಅವರು ಅವನಿಗೆ, “ಆತನು ಎಲ್ಲಿದ್ದಾನೆ?” ಎಂದು ಕೇಳಲು,</para>
  <para style="p" vid="JHN 9:12">ಅವನು, “ನನಗೆ ಗೊತ್ತಿಲ್ಲ,” ಎಂದನು.<verse eid="JHN 9:12"/></para>
  <para style="s1">ಸೂಚಕಕಾರ್ಯವನ್ನು ಕುರಿತು ಫರಿಸಾಯರು ಪರಿಶೋಧಿಸಿದ್ದು</para>
  <para style="p">
    <verse number="13" style="v" sid="JHN 9:13"/>ಜನರು ಮೊದಲು ಕುರುಡನಾಗಿದ್ದವನನ್ನು ಫರಿಸಾಯರ ಬಳಿಗೆ ಕರೆದುಕೊಂಡು ಬಂದರು. <verse eid="JHN 9:13"/><verse number="14" style="v" sid="JHN 9:14"/>ಯೇಸು ಮಣ್ಣಿನ ಲೇಪಮಾಡಿ ಅವನಿಗೆ ದೃಷ್ಟಿಕೊಟ್ಟ ದಿನವು ಯೆಹೂದ್ಯರ ಸಬ್ಬತ್ ದಿನವಾಗಿತ್ತು. <verse eid="JHN 9:14"/><verse number="15" style="v" sid="JHN 9:15"/>ಆದ್ದರಿಂದ ಫರಿಸಾಯರು ಅವನಿಗೆ, ಹೇಗೆ ದೃಷ್ಟಿ ಬಂತು ಎಂದು ತಿರುಗಿ ಅವನನ್ನು ಕೇಳಲು, ಅವನು ಅವರಿಗೆ, “ಯೇಸು ಮಣ್ಣಿನ ಲೇಪವನ್ನು ನನ್ನ ಕಣ್ಣುಗಳ ಮೇಲಿಡಲು ನಾನು ತೊಳೆದುಕೊಂಡೆನು. ಈಗ ನೋಡುತ್ತೇನೆ,” ಎಂದನು.<verse eid="JHN 9:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 9:16"/>ಫರಿಸಾಯರಲ್ಲಿ ಕೆಲವರು, “ಹೀಗೆ ಮಾಡಿದವನು ದೇವರಿಂದ ಬಂದವನಲ್ಲ. ಏಕೆಂದರೆ ಆತನು ಯೆಹೂದ್ಯರ ಸಬ್ಬತ್ ದಿನವನ್ನು ಕೈಗೊಳ್ಳುವುದಿಲ್ಲ,” ಎಂದರು.</para>
  <para style="p" vid="JHN 9:16">ಬೇರೆ ಕೆಲವರು, “ಹಾಗಾದರೆ ಪಾಪಿಯಾದ ಮನುಷ್ಯನು ಇಂಥ ಸೂಚಕಕಾರ್ಯಗಳನ್ನು ಮಾಡುವುದು ಹೇಗೆ?” ಎಂದರು. ಹೀಗೆ ಅವರಲ್ಲಿ ಭೇದ ಉಂಟಾಯಿತು.<verse eid="JHN 9:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="JHN 9:17"/>ಅವರು ತಿರುಗಿ, “ಆತನು ನಿನಗೆ ದೃಷ್ಟಿಕೊಟ್ಟದ್ದರಿಂದ ಆತನ ವಿಷಯವಾಗಿ ನೀನು ಏನು ಹೇಳುತ್ತೀ?” ಎಂದಾಗ,</para>
  <para style="p" vid="JHN 9:17">ಅವನು, “ಅವರು ಒಬ್ಬ ಪ್ರವಾದಿ,” ಎಂದನು.<verse eid="JHN 9:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="JHN 9:18"/>ದೃಷ್ಟಿಹೊಂದಿದವನ ತಂದೆತಾಯಿಗಳನ್ನು ಕರೆಯುವವರೆಗೆ ಯೆಹೂದ್ಯರು ಅವನ ವಿಷಯವಾಗಿ, ಅವನು ಕುರುಡನಾಗಿದ್ದು ದೃಷ್ಟಿಹೊಂದಿದನೆಂದು ನಂಬಲಿಲ್ಲ. <verse eid="JHN 9:18"/><verse number="19" style="v" sid="JHN 9:19"/>ಅವರು, “ಕುರುಡನಾಗಿ ಹುಟ್ಟಿದನೆಂದು ನೀವು ಹೇಳುವ ನಿಮ್ಮ ಮಗನು ಇವನೋ? ಹಾಗಾದರೆ ಈಗ ಇವನಿಗೆ ಕಣ್ಣು ಕಾಣುವುದು ಹೇಗೆ?” ಎಂದು ಅವರನ್ನು ಕೇಳಿದರು.<verse eid="JHN 9:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="JHN 9:20"/>ಅವನ ತಂದೆತಾಯಿಗಳು ಅವರಿಗೆ, “ಇವನು ನಮ್ಮ ಮಗನೆಂದೂ ಇವನು ಕುರುಡನಾಗಿ ಹುಟ್ಟಿದನೆಂದೂ ನಾವು ಬಲ್ಲೆವು. <verse eid="JHN 9:20"/><verse number="21" style="v" sid="JHN 9:21"/>ಆದರೆ ಇವನಿಗೆ ಈಗ ಕಣ್ಣು ಕಾಣುವುದು ಹೇಗೆಂದು ನಮಗೆ ಗೊತ್ತಿಲ್ಲ. ಯಾರು ಇವನ ಕಣ್ಣುಗಳನ್ನು ತೆರೆದರೆಂದೂ ನಮಗೆ ಗೊತ್ತಿಲ್ಲ, ಇವನನ್ನೇ ಕೇಳಿರಿ; ಇವನು ಪ್ರಾಯದವನಾಗಿದ್ದಾನೆ. ಇವನೇ ತನ್ನ ವಿಷಯವಾಗಿ ಮಾತನಾಡುವನು,” ಎಂದು ಹೇಳಿದರು. <verse eid="JHN 9:21"/><verse number="22" style="v" sid="JHN 9:22"/>ಅವನ ತಂದೆತಾಯಿಗಳು ಯೆಹೂದ್ಯ ನಾಯಕರಿಗೆ ಭಯಪಟ್ಟಿದ್ದರಿಂದ ಹೀಗೆ ಹೇಳಿದರು. ಏಕೆಂದರೆ ಯಾರಾದರೂ ಯೇಸುವನ್ನು ಕ್ರಿಸ್ತನೆಂದು ಒಪ್ಪಿಕೊಂಡರೆ, ಅವರನ್ನು ಸಭಾಮಂದಿರದಿಂದ ಬಹಿಷ್ಕರಿಸಬೇಕೆಂದು ಯೆಹೂದ್ಯ ನಾಯಕರು ಈ ಮೊದಲೇ ಗೊತ್ತುಮಾಡಿದ್ದರು. <verse eid="JHN 9:22"/><verse number="23" style="v" sid="JHN 9:23"/>ಆದ್ದರಿಂದ ಅವನ ತಂದೆತಾಯಿಗಳು, “ಇವನು ಪ್ರಾಯದವನಾಗಿದ್ದಾನೆ, ಇವನನ್ನೇ ಕೇಳಿ,” ಎಂದು ಹೇಳಿದರು.<verse eid="JHN 9:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="JHN 9:24"/>ಅವರು ಕುರುಡನಾಗಿದ್ದವನನ್ನು ಮತ್ತೊಮ್ಮೆ ಕರೆದು ಅವನಿಗೆ, “ದೇವರಿಗೆ ಮಹಿಮೆಯನ್ನು ಸಲ್ಲಿಸು, ಆ ಮನುಷ್ಯ ಪಾಪಿ ಎಂದು ನಾವು ಬಲ್ಲೆವು,” ಎಂದರು.<verse eid="JHN 9:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 9:25"/>ಅದಕ್ಕೆ ಅವನು, “ಅವರು ಪಾಪಿಯೋ ಏನೋ ನನಗೆ ಗೊತ್ತಿಲ್ಲ. ಒಂದು ಮಾತ್ರ ಬಲ್ಲೆ, ನಾನು ಕುರುಡನಾಗಿದ್ದೆನು; ಈಗ ನನಗೆ ಕಾಣುತ್ತದೆ,” ಎಂದು ಉತ್ತರಕೊಟ್ಟನು.<verse eid="JHN 9:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="JHN 9:26"/>ಆದ್ದರಿಂದ ಅವರು ಅವನಿಗೆ, “ಆತನು ನಿನಗೆ ಏನು ಮಾಡಿದನು? ಆತನು ನಿನ್ನ ಕಣ್ಣುಗಳನ್ನು ಹೇಗೆ ತೆರೆದನು?” ಎಂದು ಕೇಳಿದ್ದಕ್ಕೆ,<verse eid="JHN 9:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="JHN 9:27"/>ಅವನು ಉತ್ತರವಾಗಿ, “ನಾನು ನಿಮಗೆ ಆಗಲೇ ಹೇಳಿದ್ದೇನಲ್ಲಾ. ಆದರೆ ನೀವು ಕೇಳಲಿಲ್ಲ, ನೀವು ತಿರುಗಿ ಏಕೆ ಕೇಳುತ್ತೀರಿ? ನೀವು ಸಹ ಅವರ ಶಿಷ್ಯರಾಗುವುದಕ್ಕೆ ಬಯಸುತ್ತೀರೋ?” ಎಂದನು.<verse eid="JHN 9:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="JHN 9:28"/>ಆಗ ಅವರು ಅವನನ್ನು ದೂಷಿಸಿ, “ನೀನು ಆತನ ಶಿಷ್ಯನು. ಆದರೆ ನಾವು ಮೋಶೆಯ ಶಿಷ್ಯರು. <verse eid="JHN 9:28"/><verse number="29" style="v" sid="JHN 9:29"/>ಮೋಶೆಯ ಮೂಲಕ ದೇವರು ಮಾತನಾಡಿದನೆಂದು ನಾವು ಬಲ್ಲೆವು. ಆದರೆ ಈತನು ಎಲ್ಲಿಂದ ಬಂದನೋ ನಮಗೆ ಗೊತ್ತಿಲ್ಲ,” ಎಂದರು.<verse eid="JHN 9:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="JHN 9:30"/>ಅದಕ್ಕೆ ಅವನು ಅವರಿಗೆ, “ಏನಾಶ್ಚರ್ಯ! ಅವರು ನನ್ನ ಕಣ್ಣುಗಳನ್ನು ತೆರೆದರೂ ಅವರು ಎಲ್ಲಿಂದ ಬಂದವನೆಂದು ನಿಮಗೆ ತಿಳಿಯದೆ ಇರುವುದು. <verse eid="JHN 9:30"/><verse number="31" style="v" sid="JHN 9:31"/>ದೇವರು ಪಾಪಿಗಳಿಗೆ ಕಿವಿಗೊಡುವುದಿಲ್ಲ; ಆದರೆ ಯಾರು ದೇವರಿಗೆ ಭಯಪಡುವವರಾಗಿದ್ದು ಅವರ ಚಿತ್ತದಂತೆ ನಡೆಯುತ್ತಾರೋ, ಅಂಥವರಿಗೆ ಕಿವಿಗೊಡುತ್ತಾರೆಂದು ನಾವು ಬಲ್ಲೆವು. <verse eid="JHN 9:31"/><verse number="32" style="v" sid="JHN 9:32"/>ಹುಟ್ಟುಕುರುಡನಾಗಿದ್ದ ಒಬ್ಬ ಮನುಷ್ಯನ ಕಣ್ಣುಗಳನ್ನು ಯಾರಾದರೂ ತೆರೆದಿದ್ದನ್ನು ಎಂದಿಗೂ ಒಬ್ಬರೂ ಕೇಳಿಲ್ಲ. <verse eid="JHN 9:32"/><verse number="33" style="v" sid="JHN 9:33"/>ಅವರು ದೇವರಿಂದ ಬಂದವರಲ್ಲದಿದ್ದರೆ ಅವರಿಂದ ಏನೂ ಮಾಡಲಾಗುತ್ತಿರಲಿಲ್ಲ,” ಎಂದನು.<verse eid="JHN 9:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="JHN 9:34"/>ಅದಕ್ಕೆ ಅವರು, “ನೀನು ಪಾಪದಲ್ಲಿಯೇ ಪೂರ್ಣವಾಗಿ ಹುಟ್ಟಿದವನು. ನೀನು ನಮಗೆ ಬೋಧಿಸುತ್ತೀಯಾ?” ಎಂದು ಹೇಳಿ ಅವನನ್ನು ಹೊರಗೆ ಹಾಕಿದರು.<verse eid="JHN 9:34"/></para>
  <para style="s1">ಆತ್ಮಿಕ ಕುರುಡುತನ</para>
  <para style="p">
    <verse number="35" style="v" sid="JHN 9:35"/>ಯೆಹೂದಿ ನಾಯಕರು ಅವನನ್ನು ಸಭಾಮಂದಿರದಿಂದ ಹೊರಗೆ ಹಾಕಿದ್ದನ್ನು ಯೇಸು ಕೇಳಿ, ಅವನನ್ನು ಕಂಡು, “ನೀನು ಮನುಷ್ಯಪುತ್ರನನ್ನು ನಂಬುತ್ತೀಯಾ?” ಎಂದರು.<verse eid="JHN 9:35"/></para>
  <para style="p">
    <verse number="36" style="v" sid="JHN 9:36"/>ಅದಕ್ಕೆ ಅವನು, “ಸ್ವಾಮೀ, ನಾನು ಅವರನ್ನು ನಂಬುವಂತೆ ಅವರು ಯಾರೆಂದು ತಿಳಿಸಿರಿ,” ಎಂದನು.<verse eid="JHN 9:36"/></para>
  <para style="p">
    <verse number="37" style="v" sid="JHN 9:37"/>ಯೇಸು ಅವನಿಗೆ, “ನೀನು ಆತನನ್ನು ಕಂಡಿದ್ದೀ ಮತ್ತು ನಿನ್ನ ಸಂಗಡ ಮಾತನಾಡುತ್ತಿರುವ ನಾನೇ ಆತನು,” ಎಂದು ಹೇಳಿದರು.<verse eid="JHN 9:37"/></para>
  <para style="p">
    <verse number="38" style="v" sid="JHN 9:38"/>ಆಗ ಅವನು, “ಸ್ವಾಮೀ, ನಾನು ನಂಬುತ್ತೇನೆ,” ಎಂದು ಹೇಳಿ ಯೇಸುವಿಗೆ ಅಡ್ಡಬಿದ್ದನು.<verse eid="JHN 9:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="JHN 9:39"/>ಯೇಸು, “ಕುರುಡರು ನೋಡುವಂತೆಯೂ ನೋಡುವವರು ಕುರುಡರಾಗುವಂತೆಯೂ ನಾನು ನ್ಯಾಯತೀರ್ಪು ಮಾಡುವುದಕ್ಕಾಗಿ ಈ ಲೋಕಕ್ಕೆ ಬಂದಿದ್ದೇನೆ,” ಎಂದರು.<verse eid="JHN 9:39"/></para>
  <para style="p">
    <verse number="40" style="v" sid="JHN 9:40"/>ಯೇಸುವಿನೊಂದಿಗಿದ್ದ ಫರಿಸಾಯರಲ್ಲಿ ಕೆಲವರು ಈ ಮಾತುಗಳನ್ನು ಕೇಳಿ, “ನಾವು ಸಹ ಕುರುಡರೋ?” ಎಂದು ಯೇಸುವನ್ನು ಪ್ರಶ್ನಿಸಿದರು.<verse eid="JHN 9:40"/></para>
  <para style="p">
    <verse number="41" style="v" sid="JHN 9:41"/>ಅದಕ್ಕೆ ಯೇಸು ಅವರಿಗೆ, “ನೀವು ಕುರುಡರಾಗಿದ್ದರೆ ನಿಮಗೆ ಪಾಪವು ಇರುತ್ತಿರಲಿಲ್ಲ. ಆದರೆ, ‘ನಮಗೆ ಕಾಣುತ್ತದೆ,’ ಎಂದು ನೀವು ಹೇಳುವುದರಿಂದ ನಿಮ್ಮ ಪಾಪವು ನಿಮಗೆ ಉಳಿದಿದೆ,” ಎಂದರು.<verse eid="JHN 9:41"/></para>
  <chapter eid="JHN 9"/>
  <chapter number="10" style="c" sid="JHN 10"/>
  <para style="s1">ಒಳ್ಳೆಯ ಕುರುಬ ಮತ್ತು ಆತನ ಕುರಿ</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 10:1"/>“ನಾನು ನಿಮಗೆ ನಿಜನಿಜವಾಗಿ ಹೇಳುತ್ತೇನೆ, ಬಾಗಿಲಿನಿಂದ ಕುರಿಹಟ್ಟಿಯೊಳಗೆ ಬಾರದೆ ಬೇರೆ ಎಲ್ಲಿಂದಾದರೂ ಒಳಗೆ ಬರುವವನು ಕಳ್ಳನೂ ದರೋಡೆಕೋರನೂ ಆಗಿದ್ದಾನೆ. <verse eid="JHN 10:1"/><verse number="2" style="v" sid="JHN 10:2"/>ಆದರೆ ಬಾಗಿಲಿನ ಮೂಲಕ ಪ್ರವೇಶಿಸುವವನೇ ಆ ಕುರಿಗಳ ಕುರುಬನು. <verse eid="JHN 10:2"/><verse number="3" style="v" sid="JHN 10:3"/>ಬಾಗಿಲು ಕಾಯುವವನು ಅವನಿಗೆ ಬಾಗಿಲನ್ನು ತೆರೆಯುತ್ತಾನೆ. ಕುರಿಗಳು ಅವನ ಸ್ವರವನ್ನು ಕೇಳುತ್ತವೆ. ಅವನು ತನ್ನ ಸ್ವಂತ ಕುರಿಗಳನ್ನು ಹೆಸರು ಹೇಳಿ ಕರೆದು ಅವುಗಳನ್ನು ಹೊರಗೆ ಬಿಡುತ್ತಾನೆ. <verse eid="JHN 10:3"/><verse number="4" style="v" sid="JHN 10:4"/>ಅವನು ತನ್ನ ಕುರಿಗಳನ್ನೆಲ್ಲಾ ಹೊರಗೆ ಬಿಟ್ಟ ಮೇಲೆ ಅವುಗಳ ಮುಂದೆ ಹೋಗುತ್ತಾನೆ. ಕುರಿಗಳು ಅವನ ಸ್ವರವನ್ನು ತಿಳಿದಿರುವುದರಿಂದ ಅವನನ್ನು ಹಿಂಬಾಲಿಸುತ್ತವೆ. <verse eid="JHN 10:4"/><verse number="5" style="v" sid="JHN 10:5"/>ಆದರೆ ಅವು ಅಪರಿಚಿತನನ್ನು ಹಿಂಬಾಲಿಸದೇ ಅವನ ಬಳಿಯಿಂದ ಓಡಿಹೋಗುವವು. ಏಕೆಂದರೆ ಅವು ಅಪರಿಚಿತನ ಸ್ವರವನ್ನು ಗುರುತಿಸುವುದಿಲ್ಲ,” ಎಂದರು. <verse eid="JHN 10:5"/><verse number="6" style="v" sid="JHN 10:6"/>ಯೇಸು ಈ ಸಾಮ್ಯವನ್ನು ಅವರಿಗೆ ಹೇಳಿದರು. ಆದರೂ ಯೇಸು ಅವರ ಸಂಗಡ ಮಾತನಾಡಿದ ವಿಷಯಗಳು ಏನಾಗಿದ್ದವು ಎಂದು ಫರಿಸಾಯರು ಗ್ರಹಿಸಲಿಲ್ಲ.<verse eid="JHN 10:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="JHN 10:7"/>ಯೇಸು ತಿರುಗಿ ಅವರಿಗೆ, “ನಾನು ನಿಮಗೆ ನಿಜನಿಜವಾಗಿ ಹೇಳುತ್ತೇನೆ, ಕುರಿಗಳಿಗೆ ನಾನೇ ಬಾಗಿಲಾಗಿದ್ದೇನೆ. <verse eid="JHN 10:7"/><verse number="8" style="v" sid="JHN 10:8"/>ನನಗಿಂತ ಮೊದಲು ಬಂದವರೆಲ್ಲರು ಕಳ್ಳರೂ ದರೋಡೆಕೋರರೂ ಆಗಿದ್ದಾರೆ. ಆದರೆ ಕುರಿಗಳು ಅವರಿಗೆ ಕಿವಿಗೊಡಲಿಲ್ಲ. <verse eid="JHN 10:8"/><verse number="9" style="v" sid="JHN 10:9"/>ನಾನೇ ಬಾಗಿಲು; ನನ್ನ ಮೂಲಕವಾಗಿ ಯಾರು ಪ್ರವೇಶಿಸುವರೋ ಅವರೇ ಸುರಕ್ಷಿತವಾಗಿರುವರು. ಇದಲ್ಲದೆ ಅವರು ಒಳಗೆ ಹೋಗುವರು, ಹೊರಗೆ ಬರುವರು ಮತ್ತು ಮೇವನ್ನು ಕಂಡುಕೊಳ್ಳುವರು. <verse eid="JHN 10:9"/><verse number="10" style="v" sid="JHN 10:10"/>ಕಳ್ಳನು ಕದಿಯಲು, ಕೊಯ್ಯಲು ಮತ್ತು ನಾಶಮಾಡಲು ಮಾತ್ರ ಬರುತ್ತಾನೆ. ನಾನಾದರೋ ಅವುಗಳಿಗೆ ಜೀವವು ಇರಬೇಕೆಂತಲೂ ಅದು ಸಮೃದ್ಧಿಯಾಗಿರಬೇಕೆಂತಲೂ ಬಂದೆನು.<verse eid="JHN 10:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="JHN 10:11"/>“ನಾನೇ ಒಳ್ಳೆಯ ಕುರುಬನು. ಒಳ್ಳೆಯ ಕುರುಬನು ಕುರಿಗಳಿಗೋಸ್ಕರ ತನ್ನ ಪ್ರಾಣವನ್ನು ಕೊಡುತ್ತಾನೆ. <verse eid="JHN 10:11"/><verse number="12" style="v" sid="JHN 10:12"/>ಕೂಲಿಯಾಳು ಕುರಿಗಳ ಕುರುಬನಲ್ಲ; ಅವನು ತೋಳ ಬರುವುದನ್ನು ಕಂಡು ಕುರಿಗಳನ್ನು ಬಿಟ್ಟು ಓಡಿಹೋಗುತ್ತಾನೆ. ಆಗ ತೋಳವು ಕುರಿಗಳನ್ನು ಹಿಡಿದುಕೊಂಡು ಹಿಂಡನ್ನು ಚದರಿಸುತ್ತದೆ. <verse eid="JHN 10:12"/><verse number="13" style="v" sid="JHN 10:13"/>ಅವನು ಕೇವಲ ಕೂಲಿಯಾಳು ಆಗಿರುವುದರಿಂದ ಅವನಿಗೆ ಕುರಿಗಳ ಚಿಂತೆಯಿಲ್ಲ.<verse eid="JHN 10:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="JHN 10:14"/>“ನಾನೇ ಒಳ್ಳೆಯ ಕುರುಬನು. ನನ್ನ ಕುರಿಗಳನ್ನು ನಾನು ತಿಳಿದಿದ್ದೇನೆ. ನನ್ನ ಕುರಿಗಳು ನನ್ನನ್ನು ತಿಳಿದಿವೆ. <verse eid="JHN 10:14"/><verse number="15" style="v" sid="JHN 10:15"/>ತಂದೆಯು ನನ್ನನ್ನು ತಿಳಿದಿರುವಂತೆ ನಾನು ತಂದೆಯನ್ನು ತಿಳಿದಿರುತ್ತೇನೆ; ನಾನು ಕುರಿಗಳಿಗೋಸ್ಕರ ನನ್ನ ಪ್ರಾಣವನ್ನೇ ಕೊಡುತ್ತೇನೆ. <verse eid="JHN 10:15"/><verse number="16" style="v" sid="JHN 10:16"/>ಈ ಹಿಂಡಿಗೆ ಸೇರದ ಬೇರೆ ಕುರಿಗಳು ನನಗಿವೆ. ಅವುಗಳನ್ನೂ ಸಹ ನಾನು ತರಬೇಕಾಗಿದೆ. ಅವು ನನ್ನ ಸ್ವರಕ್ಕೆ ಕಿವಿಗೊಡುತ್ತವೆ. ಆಗ ಒಂದೇ ಹಿಂಡೂ ಒಬ್ಬನೇ ಕುರುಬನೂ ಆಗಿರುವುದು. <verse eid="JHN 10:16"/><verse number="17" style="v" sid="JHN 10:17"/>ಮರಳಿ ಪಡೆಯುವಂತೆ ನನ್ನ ಪ್ರಾಣವನ್ನು ನಾನು ಕೊಡುವುದರಿಂದ ನನ್ನ ತಂದೆಯು ನನ್ನನ್ನು ಪ್ರೀತಿಸುತ್ತಾರೆ. <verse eid="JHN 10:17"/><verse number="18" style="v" sid="JHN 10:18"/>ಯಾರೂ ನನ್ನ ಪ್ರಾಣವನ್ನು ನನ್ನಿಂದ ತೆಗೆಯುವುದಿಲ್ಲ. ಆದರೆ ನನ್ನಷ್ಟಕ್ಕೆ ನಾನೇ ಅದನ್ನು ಕೊಡುವೆನು. ನಾನು ಅದನ್ನು ಕೊಡುವುದಕ್ಕೆ ನನಗೆ ಅಧಿಕಾರವಿದೆ. ಅದನ್ನು ಪುನಃ ತೆಗೆದುಕೊಳ್ಳುವುದಕ್ಕೂ ನನಗೆ ಅಧಿಕಾರವಿದೆ. ಈ ಆಜ್ಞೆಯನ್ನು ನಾನು ನನ್ನ ತಂದೆಯಿಂದ ಪಡೆದಿದ್ದೇನೆ,” ಎಂದರು.<verse eid="JHN 10:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="JHN 10:19"/>ಈ ಮಾತುಗಳ ದೆಸೆಯಿಂದ ಯೆಹೂದ್ಯರ ಮಧ್ಯದಲ್ಲಿ ಮತ್ತೆ ಭೇದ ಉಂಟಾಯಿತು. <verse eid="JHN 10:19"/><verse number="20" style="v" sid="JHN 10:20"/>ಅವರಲ್ಲಿ ಅನೇಕರು, “ಆತನಿಗೆ ದೆವ್ವ ಹಿಡಿದಿದೆ. ಆತನು ಹುಚ್ಚನಾಗಿದ್ದಾನೆ, ನೀವು ಏಕೆ ಆತನಿಗೆ ಕಿವಿಗೊಡುತ್ತೀರಿ?” ಎಂದರು.<verse eid="JHN 10:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="JHN 10:21"/>ಇನ್ನು ಕೆಲವರು, “ಇವು ದೆವ್ವ ಹಿಡಿದವನ ಮಾತುಗಳಲ್ಲ. ದೆವ್ವವು ಕುರುಡನ ಕಣ್ಣುಗಳನ್ನು ತೆರೆಯಲು ಸಾಧ್ಯವೇ?” ಎಂದರು.<verse eid="JHN 10:21"/></para>
  <para style="s1">ಯೆಹೂದ್ಯರ ಅವಿಶ್ವಾಸ</para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 10:22"/>ಆಗ ಯೆರೂಸಲೇಮಿನಲ್ಲಿ ದೇವಾಲಯದ ಪ್ರತಿಷ್ಠೆಯ ಹಬ್ಬವಿತ್ತು.<note caller="+" style="f"><char style="fr" closed="false">10:22 </char><char style="ft" closed="false">ಹೀಬ್ರೂ ಭಾಷೆಯಲ್ಲಿ </char><char style="fqa" closed="false">ಹನುಕ್ಕಾ ಹಬ್ಬ</char></note> ಅದು ಚಳಿಗಾಲವಾಗಿತ್ತು. <verse eid="JHN 10:22"/><verse number="23" style="v" sid="JHN 10:23"/>ಯೇಸು ದೇವಾಲಯದೊಳಗೆ ಸೊಲೊಮೋನನ ಮಂಟಪದಲ್ಲಿ ತಿರುಗಾಡುತ್ತಿದ್ದರು. <verse eid="JHN 10:23"/><verse number="24" style="v" sid="JHN 10:24"/>ಆಗ ಯೆಹೂದ್ಯರು ಯೇಸುವನ್ನು ಸುತ್ತುವರೆದು, “ಇನ್ನೆಷ್ಟು ಕಾಲ ನಮ್ಮನ್ನು ಸಂಶಯದಲ್ಲಿರಿಸುವೆ? ನೀನು ಕ್ರಿಸ್ತನಾಗಿದ್ದರೆ ನಮಗೆ ಸ್ಪಷ್ಟವಾಗಿ ಹೇಳು,” ಎಂದರು.<verse eid="JHN 10:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 10:25"/>ಯೇಸು ಅವರಿಗೆ, “ನಾನು ನಿಮಗೆ ಹೇಳಿದೆನು. ಆದರೆ ನೀವು ನಂಬುತ್ತಾ ಇಲ್ಲ. ನನ್ನ ತಂದೆಯ ಹೆಸರಿನಲ್ಲಿ ನಾನು ಮಾಡುವ ಕ್ರಿಯೆಗಳೇ ನನ್ನ ವಿಷಯವಾಗಿ ಸಾಕ್ಷಿ ಕೊಡುತ್ತವೆ. <verse eid="JHN 10:25"/><verse number="26" style="v" sid="JHN 10:26"/>ನೀವು ನನ್ನ ಕುರಿಗಳಲ್ಲ, ಆದ್ದರಿಂದಲೇ ನೀವು ನಂಬುವುದಿಲ್ಲ. <verse eid="JHN 10:26"/><verse number="27" style="v" sid="JHN 10:27"/>ನನ್ನ ಕುರಿಗಳು ನನ್ನ ಸ್ವರಕ್ಕೆ ಕಿವಿಗೊಡುತ್ತವೆ. ನಾನು ಅವುಗಳನ್ನು ಬಲ್ಲೆನು. ಅವು ನನ್ನನ್ನು ಹಿಂಬಾಲಿಸುತ್ತವೆ. <verse eid="JHN 10:27"/><verse number="28" style="v" sid="JHN 10:28"/>ನಾನು ಅವುಗಳಿಗೆ ನಿತ್ಯಜೀವವನ್ನು ಕೊಡುತ್ತೇನೆ. ಅವು ಎಂದೆಂದಿಗೂ ನಾಶವಾಗುವುದಿಲ್ಲ. ಅವುಗಳನ್ನು ಯಾರೂ ನನ್ನ ಕೈಯಿಂದ ಕಸಿದುಕೊಳ್ಳಲಾರರು. <verse eid="JHN 10:28"/><verse number="29" style="v" sid="JHN 10:29"/>ಅವುಗಳನ್ನು ನನಗೆ ಕೊಟ್ಟ ನನ್ನ ತಂದೆ ಎಲ್ಲರಿಗಿಂತಲೂ ಮಹೋನ್ನತರು. ನನ್ನ ತಂದೆಯ ಕೈಯಿಂದ ಅವುಗಳನ್ನು ಯಾರೂ ಕಸಿದುಕೊಳ್ಳಲಾರರು. <verse eid="JHN 10:29"/><verse number="30" style="v" sid="JHN 10:30"/>ನಾನು ಮತ್ತು ನನ್ನ ತಂದೆ ಒಂದೇ ಆಗಿದ್ದೇವೆ,” ಎಂದು ಉತ್ತರಕೊಟ್ಟರು.<verse eid="JHN 10:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="JHN 10:31"/>ಆಗ ಯೆಹೂದಿ ನಾಯಕರು ಪುನಃ ಯೇಸುವಿನ ಮೇಲೆ ಕಲ್ಲೆಸೆಯಲು ಕಲ್ಲುಗಳನ್ನು ಎತ್ತಿಕೊಂಡರು. <verse eid="JHN 10:31"/><verse number="32" style="v" sid="JHN 10:32"/>ಅದಕ್ಕೆ ಯೇಸು ಅವರಿಗೆ, “ನನ್ನ ತಂದೆಯಿಂದ ಅನೇಕ ಒಳ್ಳೆಯ ಕಾರ್ಯಗಳನ್ನು ನಾನು ನಿಮಗೆ ತೋರಿಸಿದ್ದೇನೆ. ಅವುಗಳಲ್ಲಿ ಯಾವ ಕಾರ್ಯಕ್ಕಾಗಿ ನೀವು ನನ್ನ ಮೇಲೆ ಕಲ್ಲೆಸೆಯಬೇಕೆಂದಿದ್ದೀರಿ?” ಎಂದು ಕೇಳಿದರು.<verse eid="JHN 10:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="JHN 10:33"/>ಅದಕ್ಕೆ ಯೆಹೂದ್ಯರು ಯೇಸುವಿಗೆ, “ಒಳ್ಳೆಯ ಕಾರ್ಯಗಳಿಗಾಗಿಯಲ್ಲ. ನೀನು ಮನುಷ್ಯನಾಗಿದ್ದು ನಿನ್ನನ್ನೇ ದೇವರನ್ನಾಗಿ ಮಾಡಿಕೊಂಡದ್ದಕ್ಕೂ ದೇವದೂಷಣೆ ಮಾಡುತ್ತಿರುವದಕ್ಕೂ ನಾವು ನಿನ್ನ ಮೇಲೆ ಕಲ್ಲೆಸೆಯುತ್ತೇವೆ,” ಎಂದು ಉತ್ತರಕೊಟ್ಟರು.<verse eid="JHN 10:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="JHN 10:34"/>ಅದಕ್ಕೆ ಯೇಸು, “ ‘ನೀವು ದೇವರುಗಳು,’ ಎಂದು ದೇವರೇ ಹೇಳಿರುವುದಾಗಿ ನಿಮ್ಮ ನಿಯಮದಲ್ಲಿ ಬರೆದಿಲ್ಲವೋ?<note caller="+" style="f"><char style="fr" closed="false">10:34 </char><char style="ft" closed="false"><char style="xt"><ref loc="PSA 82:6">ಕೀರ್ತನೆ 82:6</ref></char></char></note> <verse eid="JHN 10:34"/><verse number="35" style="v" sid="JHN 10:35"/>ದೇವರ ವಾಕ್ಯವನ್ನು ಪಡೆದವರು ದೇವರುಗಳೇ ಎಂದು ಆತನು ಕರೆದಿರುವುದಾದರೆ, ಪವಿತ್ರ ವೇದವು ಸುಳ್ಳಾಗಲಾರದು. <verse eid="JHN 10:35"/><verse number="36" style="v" sid="JHN 10:36"/>ಹೀಗಿರುವಾಗ ತಂದೆಯು ಪ್ರತಿಷ್ಠಿಸಿ ನನ್ನನ್ನು ಲೋಕಕ್ಕೆ ಕಳುಹಿಸಿಕೊಟ್ಟಿರುವ ನಾನು, ‘ದೇವರ ಪುತ್ರನಾಗಿದ್ದೇನೆ,’ ಎಂದು ಹೇಳಿದ್ದಕ್ಕೆ, ‘ನೀನು ದೇವದೂಷಣೆ ಮಾಡುತ್ತೀ,’ ಎಂದು ನೀವು ನನಗೆ ಹೇಳುತ್ತೀರಲ್ಲಾ? <verse eid="JHN 10:36"/><verse number="37" style="v" sid="JHN 10:37"/>ನನ್ನ ತಂದೆಯ ಕಾರ್ಯಗಳನ್ನು ನಾನು ಮಾಡದಿದ್ದರೆ ನನ್ನನ್ನು ನಂಬಬೇಡಿರಿ. <verse eid="JHN 10:37"/><verse number="38" style="v" sid="JHN 10:38"/>ನಾನು ಮಾಡಿದ್ದರಿಂದ ನೀವು ನನ್ನನ್ನು ನಂಬದಿದ್ದರೂ ಈ ಕಾರ್ಯಗಳನ್ನಾದರೂ ನಂಬಿರಿ. ಆಗ ತಂದೆಯು ನನ್ನಲ್ಲಿಯೂ ನಾನು ತಂದೆಯಲ್ಲಿಯೂ ಇರುವುದು ನಿಮಗೆ ಗೊತ್ತಾಗುವುದು ಹಾಗೂ ಮನದಟ್ಟಾಗುವುದು,” ಎಂದರು. <verse eid="JHN 10:38"/><verse number="39" style="v" sid="JHN 10:39"/>ತಿರುಗಿ ಅವರು ಯೇಸುವನ್ನು ಬಂಧಿಸಲು ಪ್ರಯತ್ನಿಸಿದರು. ಆದರೆ ಯೇಸು ಅವರ ಕೈಯಿಂದ ತಪ್ಪಿಸಿಕೊಂಡು ಹೋದರು.<verse eid="JHN 10:39"/></para>
  <para style="p">
    <verse number="40" style="v" sid="JHN 10:40"/>ಆಮೇಲೆ ಯೇಸು ಯೊರ್ದನ್ ನದಿಯನ್ನು ದಾಟಿ ಯೋಹಾನನು ಮೊದಲು ದೀಕ್ಷಾಸ್ನಾನ ಮಾಡಿಸುತ್ತಿದ್ದ ಸ್ಥಳಕ್ಕೆ ಬಂದು, ಅಲ್ಲಿಯೇ ವಾಸಮಾಡಿದರು. <verse eid="JHN 10:40"/><verse number="41" style="v" sid="JHN 10:41"/>ಆಗ ಅನೇಕರು ಯೇಸುವಿನ ಬಳಿಗೆ ಬಂದು, “ಯೋಹಾನನು ಯಾವುದೇ ಸೂಚಕಕಾರ್ಯವನ್ನು ಮಾಡಲಿಲ್ಲ. ಆದರೆ ಇವರ ವಿಷಯವಾಗಿ ಯೋಹಾನನು ಹೇಳಿದ್ದೆಲ್ಲವೂ ಸತ್ಯವಾಗಿದೆ,” ಎಂದರು. <verse eid="JHN 10:41"/><verse number="42" style="v" sid="JHN 10:42"/>ಅಲ್ಲಿ ಅನೇಕರು ಯೇಸುವಿನಲ್ಲಿ ನಂಬಿಕೆ ಇಟ್ಟರು.<verse eid="JHN 10:42"/></para>
  <chapter eid="JHN 10"/>
  <chapter number="11" style="c" sid="JHN 11"/>
  <para style="s1">ಲಾಜರನ ಮರಣ</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 11:1"/>ಮರಿಯಳ ಮತ್ತು ಆಕೆಯ ಸಹೋದರಿಯಾದ ಮಾರ್ಥಳ ಊರಾದ ಬೇಥಾನ್ಯದಲ್ಲಿ ಲಾಜರನೆಂಬವನೊಬ್ಬನು ಅಸ್ವಸ್ಥನಾಗಿದ್ದನು. <verse eid="JHN 11:1"/><verse number="2" style="v" sid="JHN 11:2"/>ಯೇಸುಸ್ವಾಮಿಯ ಪಾದಗಳಿಗೆ ತೈಲವನ್ನು ಹಚ್ಚಿ ತನ್ನ ತಲೆಕೂದಲಿನಿಂದ ಅವರ ಪಾದಗಳನ್ನು ಒರಸಿದ ಮರಿಯಳ ಸಹೋದರನಾದ ಲಾಜರನೇ ಅಸ್ವಸ್ಥನಾಗಿದ್ದನು. <verse eid="JHN 11:2"/><verse number="3" style="v" sid="JHN 11:3"/>ಆದ್ದರಿಂದ ಅವನ ಸಹೋದರಿಯರು, “ಸ್ವಾಮೀ, ಇಗೋ, ನೀವು ಪ್ರೀತಿಸುವವನು ಅಸ್ವಸ್ಥನಾಗಿದ್ದಾನೆ,” ಎಂದು ಯೇಸುವಿಗೆ ಹೇಳಿ ಕಳುಹಿಸಿದರು.<verse eid="JHN 11:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="JHN 11:4"/>ಯೇಸು ಅದನ್ನು ಕೇಳಿ, “ಈ ಕಾಯಿಲೆಯು ಮರಣಕ್ಕಾಗಿಯಲ್ಲ. ದೇವರ ಮಹಿಮೆಗಾಗಿಯೇ ಬಂದದ್ದು. ಇದರಿಂದ ದೇವರ ಪುತ್ರನಿಗೆ ಮಹಿಮೆಯಾಗುವುದು,” ಎಂದು ಹೇಳಿದರು. <verse eid="JHN 11:4"/><verse number="5" style="v" sid="JHN 11:5"/>ಮಾರ್ಥಳನ್ನು ಅವಳ ಸಹೋದರಿಯನ್ನು ಮತ್ತು ಲಾಜರನನ್ನು ಯೇಸು ಪ್ರೀತಿಸುತ್ತಿದ್ದರು. <verse eid="JHN 11:5"/><verse number="6" style="v" sid="JHN 11:6"/>ಅವನು ಅಸ್ವಸ್ಥನಾಗಿದ್ದಾನೆಂದು ಯೇಸು ಕೇಳಿದ ಮೇಲೆಯೂ ಎರಡು ದಿವಸ ತಾನಿದ್ದ ಸ್ಥಳದಲ್ಲೇ ಉಳಿದುಕೊಂಡರು. <verse eid="JHN 11:6"/><verse number="7" style="v" sid="JHN 11:7"/>ತರುವಾಯ ಯೇಸು ತಮ್ಮ ಶಿಷ್ಯರಿಗೆ, “ನಾವು ತಿರುಗಿ ಯೂದಾಯಕ್ಕೆ ಹೋಗೋಣ,” ಎಂದರು.<verse eid="JHN 11:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="JHN 11:8"/>ಯೇಸುವಿನ ಶಿಷ್ಯರು ಅವರಿಗೆ, “ಬೋಧಕರೇ, ಈಗ ಯೆಹೂದ್ಯರು ನಿಮ್ಮ ಮೇಲೆ ಕಲ್ಲೆಸೆಯಬೇಕೆಂದು ಹುಡುಕುತ್ತಿದ್ದಾರೆ. ತಿರುಗಿ ನೀವು ಅಲ್ಲಿಗೆ ಹೋಗಬೇಕೆಂದಿರುವಿರಾ?” ಎಂದರು.<verse eid="JHN 11:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="JHN 11:9"/>ಯೇಸು, “ಹಗಲಿಗೆ ಹನ್ನೆರಡು ತಾಸುಗಳು ಇವೆಯಲ್ಲವೇ? ಯಾರಾದರೂ ಹಗಲಿನಲ್ಲಿ ನಡೆದರೆ ಎಡವುದಿಲ್ಲ ಏಕೆಂದರೆ ಈ ಲೋಕದ ಬೆಳಕು ಅವರಿಗೆ ಕಾಣಿಸುತ್ತದೆ. <verse eid="JHN 11:9"/><verse number="10" style="v" sid="JHN 11:10"/>ಯಾರಾದರೂ ರಾತ್ರಿಯಲ್ಲಿ ನಡೆದರೆ ತಮ್ಮಲ್ಲಿ ಬೆಳಕಿಲ್ಲದಿರುವುದರಿಂದ ಅವರು ಎಡವುತ್ತಾರೆ,” ಎಂದು ಉತ್ತರಕೊಟ್ಟರು.<verse eid="JHN 11:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="JHN 11:11"/>ಇದನ್ನು ಹೇಳಿದ ತರುವಾಯ ಯೇಸು ಅವರಿಗೆ, “ನಮ್ಮ ಸ್ನೇಹಿತ ಲಾಜರನು ನಿದ್ರೆ ಮಾಡುತ್ತಿದ್ದಾನೆ. ಆದರೆ ನಾನು ಹೋಗಿ ಅವನನ್ನು ಎಬ್ಬಿಸಬೇಕು,” ಎಂದರು.<verse eid="JHN 11:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 11:12"/>ಯೇಸುವಿನ ಶಿಷ್ಯರು, “ಸ್ವಾಮೀ, ಅವನು ನಿದ್ರೆಮಾಡುತ್ತಿದ್ದರೆ ಸ್ವಸ್ಥನಾಗುವನು,” ಎಂದರು. <verse eid="JHN 11:12"/><verse number="13" style="v" sid="JHN 11:13"/>ಯೇಸು ಅವನ ಮರಣವನ್ನು ಕುರಿತು ಹೇಳಿದ್ದರು. ಆದರೆ ಶಿಷ್ಯರು ನಿದ್ರೆಯ ವಿಶ್ರಾಂತಿಯನ್ನು ಕುರಿತು ಯೇಸು ಹೇಳಿದರೆಂದು ಯೋಚಿಸಿದರು.<verse eid="JHN 11:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="JHN 11:14"/>ಆಗ ಯೇಸು ಸ್ಪಷ್ಟವಾಗಿ ಅವರಿಗೆ, “ಲಾಜರನು ಸತ್ತುಹೋಗಿದ್ದಾನೆ. <verse eid="JHN 11:14"/><verse number="15" style="v" sid="JHN 11:15"/>ಆದರೆ ನಾನು ಅಲ್ಲಿ ಇಲ್ಲದೆ ಹೋದದ್ದು ನಿಮ್ಮ ನಿಮಿತ್ತವಾಗಿ ಸಂತೋಷಪಡುತ್ತೇನೆ, ಯಾಕೆಂದರೆ ನಿಮಗೆ ನನ್ನಲ್ಲಿ ನಂಬಿಕೆ ಬರುವಂತೆ ಇದೆಲ್ಲಾ ನಡೆದಿದೆ. ಆದರೆ ಅವನ ಬಳಿಗೆ ಹೋಗೋಣ,” ಎಂದು ಹೇಳಿದರು.<verse eid="JHN 11:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 11:16"/>ದಿದುಮನೆಂಬ ತೋಮನು<note caller="+" style="f"><char style="fr" closed="false">11:16 </char><char style="ft" closed="false">ಅರಾಮಿಕ್ ಭಾಷೆಯಲ್ಲಿ </char><char style="fq" closed="false">ತೋಮನು </char><char style="ft" closed="false">ಮತ್ತು ಗ್ರೀಕ್ ಭಾಷೆಯಲ್ಲಿ </char><char style="fqa" closed="false">ದಿದುಮ </char><char style="ft" closed="false">ಇವುಗಳ ಅರ್ಥ ಅವಳಿ</char></note> ತನ್ನ ಜೊತೆ ಶಿಷ್ಯರಿಗೆ, “ನಾವು ಸಹ ಗುರುವಿನೊಂದಿಗೆ ಸಾಯುವುದಕ್ಕೆ ಹೋಗೋಣ,” ಎಂದನು.<verse eid="JHN 11:16"/></para>
  <para style="s1">ಮಾರ್ಥ, ಮರಿಯಳನ್ನು ಯೇಸು ಸಂತೈಸಿದ್ದು</para>
  <para style="p">
    <verse number="17" style="v" sid="JHN 11:17"/>ಯೇಸು ಬಂದಾಗ ಲಾಜರನನ್ನು ಸಮಾಧಿಯಲ್ಲಿಟ್ಟು ಆಗಲೇ ನಾಲ್ಕು ದಿವಸಗಳಾಗಿದ್ದವೆಂದು ತಿಳಿಯಿತು. <verse eid="JHN 11:17"/><verse number="18" style="v" sid="JHN 11:18"/>ಬೇಥಾನ್ಯವು ಯೆರೂಸಲೇಮಿನಿಂದ ಸುಮಾರು ಮೂರು ಕಿಲೋಮೀಟರಿನಷ್ಟು ದೂರವಿತ್ತು. <verse eid="JHN 11:18"/><verse number="19" style="v" sid="JHN 11:19"/>ಯೆಹೂದ್ಯರಲ್ಲಿ ಅನೇಕರು ಮಾರ್ಥಳನ್ನು ಮತ್ತು ಮರಿಯಳನ್ನು ಅವರ ಸಹೋದರನ ವಿಷಯವಾಗಿ ಸಂತೈಸುವುದಕ್ಕೆ ಬಂದಿದ್ದರು. <verse eid="JHN 11:19"/><verse number="20" style="v" sid="JHN 11:20"/>ಯೇಸು ಬರುತ್ತಿದ್ದಾರೆಂದು ಮಾರ್ಥಳು ಕೇಳಿದಾಗ ಅವರನ್ನು ಎದುರುಗೊಳ್ಳಲು ಹೋದಳು. ಆದರೆ ಮರಿಯಳು ಮನೆಯಲ್ಲಿಯೇ ಕುಳಿತುಕೊಂಡಿದ್ದಳು.<verse eid="JHN 11:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="JHN 11:21"/>ಆಗ ಮಾರ್ಥಳು ಯೇಸುವಿಗೆ, “ಸ್ವಾಮೀ, ನೀವು ಇಲ್ಲಿ ಇದ್ದಿದ್ದರೆ ನನ್ನ ಸಹೋದರನು ಸಾಯುತ್ತಿರಲಿಲ್ಲ. <verse eid="JHN 11:21"/><verse number="22" style="v" sid="JHN 11:22"/>ಆದರೆ ಈಗಲೂ ನೀವು ದೇವರನ್ನು ಏನು ಕೇಳಿಕೊಂಡರೂ ದೇವರು ಅದನ್ನು ನಿಮಗೆ ಕೊಡುವರೆಂದು ನಾನು ಬಲ್ಲೆನು,” ಎಂದಳು.<verse eid="JHN 11:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="JHN 11:23"/>ಯೇಸು ಆಕೆಗೆ, “ನಿನ್ನ ಸಹೋದರನು ಪುನಃ ಜೀವಂತನಾಗಿ ಎದ್ದೇಳುವನು,” ಎಂದು ಹೇಳಿದರು.<verse eid="JHN 11:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="JHN 11:24"/>ಮಾರ್ಥಳು ಯೇಸುವಿಗೆ, “ಕಡೆಯ ದಿನದಲ್ಲಿ ಪುನರುತ್ಥಾನವಾಗುವಾಗ ಅವನು ಪುನಃ ಎದ್ದು ಬರುವನೆಂದು ನಾನು ಬಲ್ಲೆನು,” ಎಂದು ಹೇಳಿದಳು.<verse eid="JHN 11:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 11:25"/>ಯೇಸು ಆಕೆಗೆ, “ನಾನೇ ಪುನರುತ್ಥಾನವೂ ಜೀವವೂ ಆಗಿದ್ದೇನೆ. ನನ್ನಲ್ಲಿ ನಂಬಿಕೆ ಇಡುವವರು ಸತ್ತರೂ ಬದುಕುವರು. <verse eid="JHN 11:25"/><verse number="26" style="v" sid="JHN 11:26"/>ಜೀವಿಸುವ ಪ್ರತಿಯೊಬ್ಬರೂ ನನ್ನಲ್ಲಿ ನಂಬಿಕೆಯಿಟ್ಟರೆ, ಅವರು ಎಂದಿಗೂ ಸಾಯುವುದಿಲ್ಲ. ಇದನ್ನು ನೀನು ನಂಬುತ್ತೀಯಾ?” ಎಂದು ಕೇಳಿದ್ದಕ್ಕೆ,<verse eid="JHN 11:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="JHN 11:27"/>ಆಕೆಯು ಯೇಸುವಿಗೆ, “ಹೌದು, ಸ್ವಾಮೀ, ಲೋಕಕ್ಕೆ ಬರಬೇಕಾಗಿದ್ದ ದೇವರ ಪುತ್ರನಾದ ಕ್ರಿಸ್ತನು ನೀವೇ ಎಂದು ನಾನು ನಂಬಿದ್ದೇನೆ,” ಎಂದಳು.<verse eid="JHN 11:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="JHN 11:28"/>ಇದನ್ನು ಹೇಳಿ ಆಕೆಯು ಹೊರಟುಹೋಗಿ ತನ್ನ ಸಹೋದರಿ ಮರಿಯಳನ್ನು ರಹಸ್ಯವಾಗಿ ಕರೆದು, “ಬೋಧಕರು ಇಲ್ಲಿದ್ದಾರೆ, ನಿನ್ನನ್ನು ಕರೆಯುತ್ತಾರೆ,” ಎಂದಳು. <verse eid="JHN 11:28"/><verse number="29" style="v" sid="JHN 11:29"/>ಆಕೆಯು ಇದನ್ನು ಕೇಳಿದಾಗ ತಟ್ಟನೆ ಎದ್ದು ಯೇಸುವಿನ ಬಳಿಗೆ ಹೋದಳು. <verse eid="JHN 11:29"/><verse number="30" style="v" sid="JHN 11:30"/>ಯೇಸು ಇನ್ನೂ ಊರೊಳಕ್ಕೆ ಬಾರದೆ ಮಾರ್ಥಳು ಅವರನ್ನು ಸಂಧಿಸಿದ ಸ್ಥಳದಲ್ಲಿಯೇ ಇದ್ದರು. <verse eid="JHN 11:30"/><verse number="31" style="v" sid="JHN 11:31"/>ಮರಿಯಳೊಂದಿಗೆ ಮನೆಯಲ್ಲಿ ಆಕೆಯ ಜೊತೆಗಿದ್ದು ಆಕೆಯನ್ನು ಸಂತೈಸುತ್ತಿದ್ದ ಯೆಹೂದ್ಯರು ಆಕೆಯು ತಟ್ಟನೆ ಎದ್ದು ಹೊರಗೆ ಹೋಗುತ್ತಿರುವುದನ್ನು ಕಂಡು, ಆಕೆಯು ಅಳುವುದಕ್ಕಾಗಿ ಸಮಾಧಿಯ ಬಳಿಗೆ ಹೋಗುತ್ತಿದ್ದಾಳೆಂದು ಭಾವಿಸಿ ಆಕೆಯನ್ನು ಹಿಂಬಾಲಿಸಿದರು.<verse eid="JHN 11:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="JHN 11:32"/>ಯೇಸು ಇದ್ದ ಸ್ಥಳಕ್ಕೆ ಮರಿಯಳೂ ಬಂದು ಅವರನ್ನು ಕಂಡು ಅವರ ಪಾದಗಳಿಗೆ ಬಿದ್ದು, “ಸ್ವಾಮೀ, ನೀವು ಇಲ್ಲಿ ಇದ್ದಿದ್ದರೆ ನನ್ನ ಸಹೋದರನು ಸಾಯುತ್ತಿರಲಿಲ್ಲ,” ಎಂದು ಹೇಳಿದಳು.<verse eid="JHN 11:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="JHN 11:33"/>ಆಕೆಯು ಅಳುವುದನ್ನು ಮತ್ತು ಆಕೆಯೊಂದಿಗೆ ಬಂದ ಯೆಹೂದ್ಯರು ಅಳುವುದನ್ನು ಯೇಸು ಕಂಡಾಗ ಆತ್ಮದಲ್ಲಿ ನೊಂದುಕೊಂಡು ಕಳವಳಗೊಂಡವರಾಗಿ, <verse eid="JHN 11:33"/><verse number="34" style="v" sid="JHN 11:34"/>“ಅವನನ್ನು ಎಲ್ಲಿ ಸಮಾಧಿಮಾಡಿದ್ದೀರಿ?” ಎಂದು ಕೇಳಿದರು.</para>
  <para style="p" vid="JHN 11:34">ಅವರು ಯೇಸುವಿಗೆ, “ಸ್ವಾಮೀ, ಬಂದು ನೋಡಿರಿ,” ಎಂದರು.<verse eid="JHN 11:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="JHN 11:35"/>ಯೇಸು ಕಣ್ಣೀರಿಟ್ಟರು.<verse eid="JHN 11:35"/></para>
  <para style="p">
    <verse number="36" style="v" sid="JHN 11:36"/>ಆಗ ಯೆಹೂದ್ಯರು, “ನೋಡಿರಿ, ಈತನಿಗೆ ಲಾಜರನ ಮೇಲೆ ಎಷ್ಟು ಪ್ರೀತಿ,” ಎಂದರು.<verse eid="JHN 11:36"/></para>
  <para style="p">
    <verse number="37" style="v" sid="JHN 11:37"/>ಅವರಲ್ಲಿ ಕೆಲವರು, “ಆ ಕುರುಡನ ಕಣ್ಣುಗಳನ್ನು ತೆರೆದ ಈತನು ಲಾಜರನನ್ನೂ ಸಾಯದಂತೆ ಮಾಡಬಾರದಿತ್ತೆ?” ಎಂದರು.<verse eid="JHN 11:37"/></para>
  <para style="s1">ಯೇಸು ಲಾಜರನನ್ನು ಮರಣದಿಂದ ಎಬ್ಬಿಸಿದ್ದು</para>
  <para style="p">
    <verse number="38" style="v" sid="JHN 11:38"/>ಯೇಸು ತಿರುಗಿ ತಮ್ಮಲ್ಲಿ ನೊಂದುಕೊಳ್ಳುತ್ತಾ ಸಮಾಧಿಗೆ ಬಂದರು. ಅದು ಗವಿಯಾಗಿತ್ತು; ಒಂದು ಕಲ್ಲು ಅದರ ಬಾಗಿಲಿಗೆ ಮುಚ್ಚಲಾಗಿತ್ತು. <verse eid="JHN 11:38"/><verse number="39" style="v" sid="JHN 11:39"/>ಯೇಸು, “ಆ ಕಲ್ಲನ್ನು ತೆಗೆದುಹಾಕಿರಿ,” ಎಂದರು.</para>
  <para style="p" vid="JHN 11:39">ಅದಕ್ಕೆ ಸತ್ತವನ ಸಹೋದರಿ ಮಾರ್ಥಳು ಯೇಸುವಿಗೆ, “ಸ್ವಾಮೀ, ಈಗ ದುರ್ವಾಸನೆ ಇರುವುದು. ಅವನು ಸತ್ತು ನಾಲ್ಕು ದಿನಗಳಾಗಿವೆ,” ಎಂದಳು.<verse eid="JHN 11:39"/></para>
  <para style="p">
    <verse number="40" style="v" sid="JHN 11:40"/>ಯೇಸು ಆಕೆಗೆ, “ನೀನು ನಂಬಿದರೆ ದೇವರ ಮಹಿಮೆಯನ್ನು ಕಾಣುವೆ ಎಂದು ನಾನು ನಿನಗೆ ಹೇಳಲಿಲ್ಲವೇ?” ಎಂದರು.<verse eid="JHN 11:40"/></para>
  <para style="p">
    <verse number="41" style="v" sid="JHN 11:41"/>ಆಗ ಕೆಲವರು ಕಲ್ಲನ್ನು ತೆಗೆದುಹಾಕಿದರು. ಯೇಸು ಕಣ್ಣೆತ್ತಿ ಮೇಲೆ ನೋಡಿ, “ತಂದೆಯೇ, ನೀವು ನನಗೆ ಕಿವಿಗೊಟ್ಟಿದ್ದಕ್ಕಾಗಿ ನಿಮಗೆ ಕೃತಜ್ಞತೆಯನ್ನು ಸಲ್ಲಿಸುತ್ತೇನೆ. <verse eid="JHN 11:41"/><verse number="42" style="v" sid="JHN 11:42"/>ನೀವು ನನಗೆ ಯಾವಾಗಲೂ ಕಿವಿಗೊಡುತ್ತೀರಿ ಎಂದು ನಾನು ಬಲ್ಲೆನು. ಆದರೆ ನನ್ನ ಸುತ್ತಲೂ ನಿಂತಿರುವ ಈ ಜನರು, ನೀವೇ ನನ್ನನ್ನು ಕಳುಹಿಸಿದ್ದೀರಿ ಎಂದು ನಂಬುವಂತೆ ನಾನು ಇದನ್ನು ಹೇಳಿದೆನು,” ಎಂದರು.<verse eid="JHN 11:42"/></para>
  <para style="p">
    <verse number="43" style="v" sid="JHN 11:43"/>ಯೇಸು ಹೀಗೆ ಹೇಳಿದ ಮೇಲೆ, “ಲಾಜರನೇ, ಹೊರಗೆ ಬಾ,” ಎಂದು ಗಟ್ಟಿಯಾದ ಸ್ವರದಿಂದ ಕೂಗಿದರು. <verse eid="JHN 11:43"/><verse number="44" style="v" sid="JHN 11:44"/>ಆಗ ಸತ್ತಿದ್ದವನು ಹೊರಗೆ ಬಂದನು. ಅವನ ಕೈಕಾಲುಗಳು ಶವವಸ್ತ್ರದಿಂದ ಕಟ್ಟಿದ್ದವು, ಮುಖಕ್ಕೆ ವಸ್ತ್ರ ಸುತ್ತಲಾಗಿತ್ತು.</para>
  <para style="p" vid="JHN 11:44">ಯೇಸು ಅಲ್ಲಿದ್ದವರಿಗೆ, “ಕಟ್ಟುಗಳನ್ನು ಬಿಚ್ಚಿ ಅವನನ್ನು ಹೋಗಲು ಬಿಡಿ,” ಎಂದು ಹೇಳಿದರು.<verse eid="JHN 11:44"/></para>
  <para style="s1">ಯೇಸುವನ್ನು ಕೊಲ್ಲಬೇಕೆಂಬ ಆಲೋಚನೆ</para>
  <para style="p">
    <verse number="45" style="v" sid="JHN 11:45"/>ಆದ್ದರಿಂದ ಮರಿಯಳ ಬಳಿಗೆ ಬಂದಿದ್ದ ಯೆಹೂದ್ಯರಲ್ಲಿ ಅನೇಕರು ಯೇಸುವಿನ ಕಾರ್ಯಗಳನ್ನು ಕಂಡು ಅವರಲ್ಲಿ ನಂಬಿಕೆಯಿಟ್ಟರು. <verse eid="JHN 11:45"/><verse number="46" style="v" sid="JHN 11:46"/>ಆದರೆ ಕೆಲವರು ಫರಿಸಾಯರ ಬಳಿಗೆ ಹೋಗಿ ಯೇಸು ಮಾಡಿದ ಕೃತ್ಯಗಳನ್ನು ಅವರಿಗೆ ಹೇಳಿದರು. <verse eid="JHN 11:46"/><verse number="47" style="v" sid="JHN 11:47"/>ಆಗ ಮುಖ್ಯಯಾಜಕರೂ ಫರಿಸಾಯರೂ ಆಲೋಚನಾ ಸಭೆಯನ್ನು ಕೂಡಿಸಿ,</para>
  <para style="p" vid="JHN 11:47">“ಈತನು ಅನೇಕ ಸೂಚಕಕಾರ್ಯಗಳನ್ನು ಮಾಡುತ್ತಾನಲ್ಲಾ, ನಾವು ಏನು ಮಾಡೋಣ? <verse eid="JHN 11:47"/><verse number="48" style="v" sid="JHN 11:48"/>ನಾವು ಈತನನ್ನು ಹಾಗೆಯೇ ಬಿಟ್ಟರೆ ಎಲ್ಲರೂ ಆತನನ್ನೇ ನಂಬುವರು. ರೋಮನ್ನರು ಬಂದು ನಮ್ಮ ದೇವಾಲಯವನ್ನೂ ರಾಷ್ಟ್ರವನ್ನೂ ನಾಶಮಾಡುವರು,” ಎಂದರು.<verse eid="JHN 11:48"/></para>
  <para style="p">
    <verse number="49" style="v" sid="JHN 11:49"/>ಅವರಲ್ಲಿ ಆ ವರ್ಷದ ಮಹಾಯಾಜಕನಾದ ಕಾಯಫನೆಂಬವನು ಅವರಿಗೆ, “ನಿಮಗೆ ಏನೂ ತಿಳಿಯುವುದಿಲ್ಲ. <verse eid="JHN 11:49"/><verse number="50" style="v" sid="JHN 11:50"/>ಇಡೀ ರಾಷ್ಟ್ರವೇ ನಾಶವಾಗುವುದಕ್ಕಿಂತ ಒಬ್ಬ ಮನುಷ್ಯನು ಜನರಿಗೋಸ್ಕರ ಸಾಯುವುದು ನಿಮಗೆ ಹಿತವೆಂದು ನೀವು ಎಣಿಸುವುದೇ ಇಲ್ಲ,” ಎಂದನು.<verse eid="JHN 11:50"/></para>
  <para style="p">
    <verse number="51" style="v" sid="JHN 11:51"/>ಇದನ್ನು ಅವನು ತಾನಾಗಿಯೇ ಹೇಳಲಿಲ್ಲ. ಅವನು ಆ ವರ್ಷದಲ್ಲಿ ಮಹಾಯಾಜಕನಾಗಿದ್ದುದರಿಂದ ಯೇಸು ಆ ರಾಷ್ಟ್ರಕ್ಕಾಗಿ ಮಾತ್ರವಲ್ಲದೆ <verse eid="JHN 11:51"/><verse number="52" style="v" sid="JHN 11:52"/>ಚದುರಿರುವ ದೇವರ ಮಕ್ಕಳನ್ನು ಒಂದಾಗಿ ಕೂಡಿಸುವುದಕ್ಕಾಗಿಯೂ ಯೇಸು ಸಾಯಬೇಕಾಗಿದೆ ಎಂದು ಅವನು ಪ್ರವಾದಿಸಿದನು. <verse eid="JHN 11:52"/><verse number="53" style="v" sid="JHN 11:53"/>ಅವರು ಆ ದಿನದಿಂದ ಯೇಸುವನ್ನು ಕೊಲ್ಲಬೇಕೆಂಬ ಒಳಸಂಚು ಮಾಡಿಕೊಂಡರು.<verse eid="JHN 11:53"/></para>
  <para style="p">
    <verse number="54" style="v" sid="JHN 11:54"/>ಹೀಗಿರುವುದರಿಂದ ಯೇಸು ಯೆಹೂದ್ಯರ ಮಧ್ಯದಲ್ಲಿ ಬಹಿರಂಗವಾಗಿ ತಿರುಗಾಡಲಿಲ್ಲ. ಆದರೆ ಅವರು ಅಲ್ಲಿಂದ ಅರಣ್ಯಕ್ಕೆ ಸಮೀಪದಲ್ಲಿದ್ದ ಎಫ್ರಾಯೀಮ್ ಎಂಬ ಊರಿಗೆ ಹೋಗಿ ಅಲ್ಲಿ ತಮ್ಮ ಶಿಷ್ಯರ ಸಂಗಡ ವಾಸಮಾಡಿದರು.<verse eid="JHN 11:54"/></para>
  <para style="p">
    <verse number="55" style="v" sid="JHN 11:55"/>ಆಗ ಯೆಹೂದ್ಯರ ಪಸ್ಕಹಬ್ಬವು ಹತ್ತಿರವಾಗಿತ್ತು. ಅನೇಕರು ತಮ್ಮನ್ನು ಶುದ್ಧಿ ಮಾಡಿಕೊಳ್ಳುವುದಕ್ಕಾಗಿ ಪಸ್ಕಕ್ಕೆ ಮುಂಚೆ ಹಳ್ಳಿಗಳಿಂದ ಯೆರೂಸಲೇಮಿಗೆ ಹೋದರು. <verse eid="JHN 11:55"/><verse number="56" style="v" sid="JHN 11:56"/>ಅವರು ಯೇಸುವನ್ನು ಹುಡುಕುತ್ತಾ ದೇವಾಲಯದಲ್ಲಿ ನಿಂತುಕೊಂಡು, “ಆತನು ಹಬ್ಬಕ್ಕೆ ಬರುತ್ತಾನೋ ಇಲ್ಲವೋ? ನಿಮಗೆ ಹೇಗೆ ಕಾಣುತ್ತದೆ,” ಎಂದು ತಮ್ಮತಮ್ಮೊಳಗೆ ಮಾತನಾಡಿಕೊಂಡರು. <verse eid="JHN 11:56"/><verse number="57" style="v" sid="JHN 11:57"/>ಆಗ ಮುಖ್ಯಯಾಜಕರೂ ಫರಿಸಾಯರೂ ಯೇಸುವನ್ನು ಬಂಧಿಸುವಂತೆ ಆತನ ಸುಳಿವು ಯಾರಿಗಾದರೂ ತಿಳಿದಿದ್ದರೆ ಅವರು ತಮಗೆ ತಿಳಿಸಬೇಕೆಂದು ಅಪ್ಪಣೆ ಕೊಟ್ಟಿದ್ದರು.<verse eid="JHN 11:57"/></para>
  <chapter eid="JHN 11"/>
  <chapter number="12" style="c" sid="JHN 12"/>
  <para style="s1">ಪರಿಮಳ ತೈಲವನ್ನು ಯೇಸುವಿನ ಪಾದಕ್ಕೆ ಸುರಿದದ್ದು</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 12:1"/>ಪಸ್ಕಹಬ್ಬಕ್ಕೆ ಆರು ದಿನಗಳ ಮುಂಚೆ ಯೇಸು ಬೇಥಾನ್ಯಕ್ಕೆ ಬಂದರು. ಅಲ್ಲಿಯೇ ಯೇಸು ಮರಣದಿಂದ ಎಬ್ಬಿಸಿದ ಲಾಜರನು ಇದ್ದನು. <verse eid="JHN 12:1"/><verse number="2" style="v" sid="JHN 12:2"/>ಅಲ್ಲಿ ಅವರು ಯೇಸುವಿಗಾಗಿ ಔತಣವನ್ನು ಏರ್ಪಡಿಸಿದ್ದರು. ಮಾರ್ಥಳು ಬಡಿಸುತ್ತಿದ್ದಳು. ಯೇಸುವಿನೊಂದಿಗೆ ಊಟಕ್ಕೆ ಕುಳಿತವರಲ್ಲಿ ಲಾಜರನೂ ಒಬ್ಬನಾಗಿದ್ದನು. <verse eid="JHN 12:2"/><verse number="3" style="v" sid="JHN 12:3"/>ಆಗ ಮರಿಯಳು ಬಹು ಬೆಲೆಯುಳ್ಳ ಅಚ್ಚ ಜಟಾಮಾಂಸಿ ಮೂಲಿಕೆಯ ತೈಲವನ್ನು ಸುಮಾರು ಅರ್ಧ ಲೀಟರಿನಷ್ಟು ತಂದು ಯೇಸುವಿನ ಪಾದಕ್ಕೆ ಸುರಿದು ತನ್ನ ತಲೆಯ ಕೂದಲಿನಿಂದ ಅವರ ಪಾದಗಳನ್ನು ಒರೆಸಿದಳು. ಆ ತೈಲದ ಪರಿಮಳವು ಮನೆಯಲ್ಲೆಲ್ಲಾ ತುಂಬಿಕೊಂಡಿತು.<verse eid="JHN 12:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="JHN 12:4"/>ಆಗ ಯೇಸುವಿನ ಶಿಷ್ಯರಲ್ಲಿ ಒಬ್ಬನಾಗಿದ್ದ ಹಾಗೂ ಅವರನ್ನು ಹಿಡಿದುಕೊಡುವುದಕ್ಕಿದ್ದ ಯೂದ ಇಸ್ಕರಿಯೋತನು, <verse eid="JHN 12:4"/><verse number="5" style="v" sid="JHN 12:5"/>“ಈ ತೈಲವನ್ನು ಏಕೆ ಮುನ್ನೂರು ಬೆಳ್ಳಿ ನಾಣ್ಯಗಳನ್ನು<note caller="+" style="f"><char style="fr" closed="false">12:5 </char><char style="ft" closed="false">ಗ್ರೀಕ್ ಭಾಷೆಯಲ್ಲಿ ದಿನಾರ್. ಒಂದು ದಿನಾರಿಯು ಒಂದು ದಿನದ ಕೂಲಿಗೆ ಸಮವಾಗಿತ್ತು</char></note> ಮಾರಿ ಬಡವರಿಗೆ ಕೊಡಲಿಲ್ಲ?” ಎಂದನು. <verse eid="JHN 12:5"/><verse number="6" style="v" sid="JHN 12:6"/>ಅವನು ಬಡವರ ಹಿತಚಿಂತನೆಯಿಂದ ಹೀಗೆ ಹೇಳಲಿಲ್ಲ. ಆದರೆ ಅವನು ಕಳ್ಳನಾಗಿದ್ದು, ಹಣದ ಚೀಲವನ್ನು ಇಟ್ಟುಕೊಂಡು ಅದರಲ್ಲಿ ಹಾಕಿದ್ದನ್ನು ಕದ್ದುಕೊಳ್ಳುತ್ತಿದ್ದನು. ಆದ್ದರಿಂದಲೇ ಇದನ್ನು ಹೇಳಿದನು.<verse eid="JHN 12:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="JHN 12:7"/>ಆಗ ಯೇಸು, “ಮರಿಯಳನ್ನು ಬಿಟ್ಟುಬಿಡಿರಿ, ನನ್ನನ್ನು ಹೂಣಿಡುವ ದಿವಸಕ್ಕಾಗಿ ಈಕೆಯು ಇದನ್ನು ಇಟ್ಟುಕೊಳ್ಳಲಿ. <verse eid="JHN 12:7"/><verse number="8" style="v" sid="JHN 12:8"/>ಏಕೆಂದರೆ ಬಡವರು ಯಾವಾಗಲೂ ನಿಮ್ಮ ಬಳಿಯಲ್ಲಿ ಇರುತ್ತಾರೆ.<note caller="+" style="f"><char style="fr" closed="false">12:8 </char><char style="ft" closed="false"><char style="xt"><ref loc="DEU 15:11">ಧರ್ಮೋ 15:11</ref></char></char></note> ಆದರೆ ನಾನು ಯಾವಾಗಲೂ ನಿಮ್ಮ ಬಳಿಯಲ್ಲಿ ಇರುವುದಿಲ್ಲ,” ಎಂದರು.<verse eid="JHN 12:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="JHN 12:9"/>ಯೇಸು ಅಲ್ಲಿರುವುದನ್ನು ಯೆಹೂದ್ಯರ ದೊಡ್ಡ ಗುಂಪು ತಿಳಿದು, ಅವರನ್ನು ಮಾತ್ರವಲ್ಲ, ಯೇಸು ಮರಣದಿಂದ ಎಬ್ಬಿಸಿದ ಲಾಜರನನ್ನೂ ಕಾಣಲು ಬಂದಿದ್ದರು. <verse eid="JHN 12:9"/><verse number="10" style="v" sid="JHN 12:10"/>ಮುಖ್ಯಯಾಜಕರು ಲಾಜರನನ್ನು ಸಹ ಕೊಲ್ಲಬೇಕೆಂದು ಆಲೋಚಿಸಿದರು. <verse eid="JHN 12:10"/><verse number="11" style="v" sid="JHN 12:11"/>ಏಕೆಂದರೆ ಅವನ ದೆಸೆಯಿಂದ ಯೆಹೂದ್ಯರಲ್ಲಿ ಅನೇಕರು ಯೇಸುವಿನ ಕಡೆಗೆ ಹೋಗಿ ನಂಬಿಕೆ ಇಟ್ಟಿದ್ದರು.<verse eid="JHN 12:11"/></para>
  <para style="s1">ಯೇಸು ಯೆರೂಸಲೇಮಿಗೆ ಅರಸನಂತೆ ಪ್ರವೇಶಮಾಡಿದ್ದು</para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 12:12"/>ಮರುದಿನ ಹಬ್ಬಕ್ಕೆ ಬಂದ ದೊಡ್ಡ ಗುಂಪು ಯೇಸು ಯೆರೂಸಲೇಮಿಗೆ ಬರುತ್ತಿದ್ದಾರೆಂಬ ಸುದ್ದಿ ಕೇಳಿ, <verse eid="JHN 12:12"/><verse number="13" style="v" sid="JHN 12:13"/>ಖರ್ಜೂರದ ಗರಿಗಳನ್ನು ತೆಗೆದುಕೊಂಡು ಅವರನ್ನು ಎದುರುಗೊಳ್ಳಲು ಹೊರಗೆ ಬಂದು,</para>
  <para style="q1" vid="JHN 12:13">“ಹೊಸನ್ನ!<note caller="+" style="f"><char style="fr" closed="false">12:13 </char><char style="ft" closed="false">ಹೀಬ್ರೂ ಭಾಷೆಯಲ್ಲಿ ಇದರ ಅರ್ಥ </char><char style="fqa" closed="false">ರಕ್ಷಿಸು</char></note>”</para>
  <para style="b" vid="JHN 12:13"/>
  <para style="q1" vid="JHN 12:13">“ಕರ್ತನ ಹೆಸರಿನಲ್ಲಿ ಬರುವವನಿಗೆ ಆಶೀರ್ವಾದ!<note caller="+" style="f"><char style="fr" closed="false">12:13 </char><char style="ft" closed="false"><char style="xt"><ref loc="PSA 118:25">ಕೀರ್ತನೆ 118:25</ref>,<ref loc="PSA 118:26">26</ref></char></char></note>”</para>
  <para style="b" vid="JHN 12:13"/>
  <para style="q1" vid="JHN 12:13">“ಇಸ್ರಾಯೇಲಿನ ಅರಸನಿಗೆ ಶುಭವಾಗಲಿ!”</para>
  <para style="m" vid="JHN 12:13">ಎಂದು ಕೂಗಿದರು. <verse eid="JHN 12:13"/><verse number="14" style="v" sid="JHN 12:14"/>ಯೇಸು ಕತ್ತೆಮರಿಯನ್ನು ಕಂಡು ಅದರ ಮೇಲೆ ಕುಳಿತುಕೊಂಡರು. ಪವಿತ್ರ ವೇದದಲ್ಲಿ ಬರೆದಿರುವಂತೆ:<verse eid="JHN 12:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="JHN 12:15"/>“ಚೀಯೋನ್ ಪುತ್ರಿಯೇ, ಭಯಪಡಬೇಡ,</para>
  <para style="q2" vid="JHN 12:15">ಇಗೋ, ನಿನ್ನ ಅರಸ</para>
  <para style="q2" vid="JHN 12:15">ಕತ್ತೆಮರಿಯ ಮೇಲೆ ಕೂತುಕೊಂಡು ಬರುತ್ತಾರೆ,”<note caller="+" style="f"><char style="fr" closed="false">12:15 </char><char style="ft" closed="false"><char style="xt"><ref loc="ZEC 9:9">ಜೆಕರ್ಯ 9:9</ref></char></char></note></para>
  <para style="m" vid="JHN 12:15">ಎಂಬ ಮಾತು ನೆರವೇರಿತು.<verse eid="JHN 12:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 12:16"/>ಇವುಗಳನ್ನು ಯೇಸುವಿನ ಶಿಷ್ಯರು ಮೊದಲು ತಿಳಿದಿರಲಿಲ್ಲ. ಆದರೆ ಯೇಸು ಮಹಿಮೆ ಹೊಂದಿದಾಗ ಪವಿತ್ರ ವೇದದಲ್ಲಿ ಅವರ ವಿಷಯವಾಗಿ ಬರೆದಿರುವಂತೆಯೇ, ಇವುಗಳನ್ನು ಜನರು ಅವರಿಗೆ ಮಾಡಿದರೆಂದು ಗ್ರಹಿಸಿದರು.<verse eid="JHN 12:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="JHN 12:17"/>ಯೇಸು ಲಾಜರನನ್ನು ಸಮಾಧಿಯೊಳಗಿಂದ ಕರೆದು ಅವನನ್ನು ಸತ್ತವರೊಳಗಿಂದ ಜೀವಂತವಾಗಿ ಎಬ್ಬಿಸಿದಾಗ ಅವರ ಸಂಗಡ ಇದ್ದ ಜನರೇ ಈ ವಿಷಯವನ್ನು ಸಾರುತ್ತಿದ್ದರು. <verse eid="JHN 12:17"/><verse number="18" style="v" sid="JHN 12:18"/>ಯೇಸು ಈ ಸೂಚಕಕಾರ್ಯವನ್ನು ಮಾಡಿದರೆಂದು ಅನೇಕ ಜನರು ಕೇಳಿದ್ದರಿಂದ ಅವರು ಸಹ ಯೇಸುವನ್ನು ಸಂಧಿಸಲು ಬಂದರು. <verse eid="JHN 12:18"/><verse number="19" style="v" sid="JHN 12:19"/>ಆದ್ದರಿಂದ ಫರಿಸಾಯರು ತಮ್ಮತಮ್ಮೊಳಗೆ, “ನೋಡಿದಿರಾ, ನಮಗೆ ಏನೂ ಪ್ರಯೋಜನವಾಗಲಿಲ್ಲ. ಲೋಕವೇ ಆತನ ಹಿಂದೆ ಹೋಗುತ್ತಿದೆ!” ಎಂದು ಮಾತನಾಡಿಕೊಂಡರು.<verse eid="JHN 12:19"/></para>
  <para style="s1">ಯೇಸು ತಮ್ಮ ಮರಣವನ್ನು ಮುಂತಿಳಿಸಿದ್ದು</para>
  <para style="p">
    <verse number="20" style="v" sid="JHN 12:20"/>ಹಬ್ಬದ ಆರಾಧನೆಗೆ ಗ್ರೀಕರಲ್ಲಿ ಕೆಲವರು ಬಂದಿದ್ದರು. <verse eid="JHN 12:20"/><verse number="21" style="v" sid="JHN 12:21"/>ಇವರು ಗಲಿಲಾಯದ ಬೇತ್ಸಾಯಿದವನಾದ ಫಿಲಿಪ್ಪನ ಬಳಿಗೆ ಬಂದು, “ಅಯ್ಯಾ, ನಾವು ಯೇಸುವನ್ನು ನೋಡಬೇಕೆಂದಿದ್ದೇವೆ,” ಎಂದರು. <verse eid="JHN 12:21"/><verse number="22" style="v" sid="JHN 12:22"/>ಫಿಲಿಪ್ಪನು ಬಂದು ಅಂದ್ರೆಯನಿಗೆ ಹೇಳಿದನು. ಅಂದ್ರೆಯನೂ ಫಿಲಿಪ್ಪನೂ ಬಂದು ಯೇಸುವಿಗೆ ತಿಳಿಸಿದರು.<verse eid="JHN 12:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="JHN 12:23"/>ಯೇಸು ಅವರಿಗೆ, “ಮನುಷ್ಯಪುತ್ರನು ಮಹಿಮೆಪಡುವ ಸಮಯ ಬಂದಿದೆ. <verse eid="JHN 12:23"/><verse number="24" style="v" sid="JHN 12:24"/>ನಾನು ನಿಮಗೆ ನಿಜನಿಜವಾಗಿ ಹೇಳುತ್ತೇನೆ, ಗೋಧಿಯ ಕಾಳು ಭೂಮಿಯಲ್ಲಿ ಬಿದ್ದು ಸಾಯದಿದ್ದರೆ ಒಂಟಿಯಾಗಿ ಉಳಿಯುವುದು, ಆದರೆ ಅದು ಸತ್ತರೆ ಬಹಳ ಫಲಕೊಡುವುದು. <verse eid="JHN 12:24"/><verse number="25" style="v" sid="JHN 12:25"/>ತಮ್ಮ ಪ್ರಾಣವನ್ನು ಪ್ರೀತಿಸುವವರು ಅದನ್ನು ಕಳೆದುಕೊಳ್ಳುವರು. ಈ ಲೋಕದಲ್ಲಿ ತಮ್ಮ ಪ್ರಾಣವನ್ನು ದ್ವೇಷಿಸುವವರು ನಿತ್ಯಜೀವಕ್ಕಾಗಿ ಅದನ್ನು ಕಾಪಾಡಿಕೊಳ್ಳುವರು. <verse eid="JHN 12:25"/><verse number="26" style="v" sid="JHN 12:26"/>ನನ್ನ ಸೇವೆ ಮಾಡಬೇಕೆಂದಿರುವವರು ನನ್ನನ್ನು ಹಿಂಬಾಲಿಸಲಿ. ಆಗ ನಾನಿರುವಲ್ಲಿಯೇ ನನ್ನ ಸೇವಕರೂ ಇರುವರು. ನನ್ನ ಸೇವೆ ಮಾಡುವವರನ್ನು ನನ್ನ ತಂದೆಯು ಸನ್ಮಾನಿಸುವರು.<verse eid="JHN 12:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="JHN 12:27"/>“ಈಗ ನನ್ನ ಪ್ರಾಣವು ತತ್ತರಿಸುತ್ತದೆ. ನಾನೇನು ಹೇಳಲಿ? ‘ತಂದೆಯೇ, ಈ ಗಳಿಗೆಯಿಂದ ನನ್ನನ್ನು ತಪ್ಪಿಸಿರಿ’ ಎಂದು ಹೇಳಲೋ? ಇಲ್ಲ. ನಾನು ಈ ಗಳಿಗೆಗಾಗಿಯೇ ಬಂದಿದ್ದೇನಲ್ಲಾ? <verse eid="JHN 12:27"/><verse number="28" style="v" sid="JHN 12:28"/>ತಂದೆಯೇ, ನಿಮ್ಮ ಹೆಸರನ್ನು ಮಹಿಮೆ ಪಡಿಸಿಕೊಳ್ಳಿರಿ,” ಎಂದರು.</para>
  <para style="p" vid="JHN 12:28">ಆಗ, “ಹೌದು, ನಾನು ಮಹಿಮೆಪಡಿಸಿದ್ದೇನೆ, ಪುನಃ ಮಹಿಮೆ ಪಡಿಸುವೆನು,” ಎಂಬ ಸ್ವರವು ಪರಲೋಕದಿಂದ ಕೇಳಿಸಿತು. <verse eid="JHN 12:28"/><verse number="29" style="v" sid="JHN 12:29"/>ಆಗ ಅಲ್ಲಿ ನಿಂತಿದ್ದ ಜನರು ಅದನ್ನು ಕೇಳಿ, “ಗುಡುಗಿತು,” ಎಂದರು. ಬೇರೆಯವರು, “ದೇವದೂತನೊಬ್ಬನು ಈತನ ಸಂಗಡ ಮಾತನಾಡಿದನು,” ಎಂದರು.<verse eid="JHN 12:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="JHN 12:30"/>ಯೇಸು, “ಈ ಸ್ವರವು ನನಗಾಗಿ ಅಲ್ಲ, ನಿಮಗಾಗಿಯೇ ಬಂದಿದೆ. <verse eid="JHN 12:30"/><verse number="31" style="v" sid="JHN 12:31"/>ಈಗ ಈ ಲೋಕಕ್ಕೆ ನ್ಯಾಯತೀರ್ಪು ಆಗುತ್ತದೆ. ಇಹಲೋಕದ ಅಧಿಪತಿಯನ್ನು ಈಗ ಹೊರಗೆ ಹಾಕಲಾಗುವುದು. <verse eid="JHN 12:31"/><verse number="32" style="v" sid="JHN 12:32"/>ಆದರೆ ನನ್ನನ್ನು ಭೂಮಿಯಿಂದ ಮೇಲೇರಿಸಿದಾಗ<note caller="+" style="f"><char style="fr" closed="false">12:32 </char><char style="ft" closed="false">ಗ್ರೀಕ್ ಭಾಷೆಯಲ್ಲಿ </char><char style="fqa" closed="false">ಉನ್ನತ ಪಡಿಸುವುದು </char><char style="ft" closed="false">ಎಂದರ್ಥ.</char></note> ಎಲ್ಲರನ್ನೂ ನನ್ನ ಬಳಿಗೆ ಸೆಳೆದುಕೊಳ್ಳುತ್ತೇನೆ,” ಎಂದರು. <verse eid="JHN 12:32"/><verse number="33" style="v" sid="JHN 12:33"/>ತಾವು ಎಂಥಾ ಮರಣದಿಂದ ಸಾಯಬೇಕಾಗಿದೆ ಎಂದು ಸೂಚಿಸಿ ಇದನ್ನು ಹೇಳಿದರು.<verse eid="JHN 12:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="JHN 12:34"/>ಜನರು ಯೇಸುವಿಗೆ, “ಕ್ರಿಸ್ತ ಸದಾಕಾಲವೂ ಇರುತ್ತಾರೆ ಎಂದು ನಾವು ಮೋಶೆಯ ನಿಯಮದಿಂದ ಕೇಳಿದ್ದೇವೆ. ಹಾಗಾದರೆ ಮನುಷ್ಯಪುತ್ರನು ಮೇಲೇರಿಸಬೇಕಾಗಿದೆ ಎಂದು ನೀನು ಹೇಳುವುದು ಹೇಗೆ? ಈ ಮನುಷ್ಯಪುತ್ರನು ಯಾರು?” ಎಂದು ಕೇಳಿದರು.<verse eid="JHN 12:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="JHN 12:35"/>ಆಗ ಯೇಸು ಅವರಿಗೆ, “ಇನ್ನು ಸ್ವಲ್ಪ ಕಾಲವೇ ಬೆಳಕು ನಿಮ್ಮ ನಡುವೆ ಇರುತ್ತದೆ. ಕತ್ತಲು ನಿಮ್ಮನ್ನು ಕವಿಯುವುದಕ್ಕೆ ಮುಂಚೆ, ನಿಮಗೆ ಬೆಳಕಿರುವಾಗಲೇ ನಡೆಯಿರಿ. ಕತ್ತಲಿನಲ್ಲಿ ನಡೆಯುವವನು ತಾನು ಎಲ್ಲಿಗೆ ಹೋಗುತ್ತಾನೆಂದು ತಿಳಿಯದು. <verse eid="JHN 12:35"/><verse number="36" style="v" sid="JHN 12:36"/>ನೀವು ಬೆಳಕಿನ ಪುತ್ರರಾಗುವಂತೆ ನಿಮಗೆ ಬೆಳಕು ಇರುವಾಗಲೇ ಬೆಳಕನ್ನು ನಂಬಿರಿ,” ಎಂದರು. ಯೇಸು ಇವುಗಳನ್ನು ಹೇಳಿ, ಅವರಿಂದ ಹೊರಟುಹೋಗಿ ಅಡಗಿಕೊಂಡರು.<verse eid="JHN 12:36"/></para>
  <para style="s1">ಯೆಹೂದ್ಯರ ಅಪನಂಬಿಕೆ</para>
  <para style="p">
    <verse number="37" style="v" sid="JHN 12:37"/>ಯೇಸು ಅನೇಕ ಸೂಚಕಕಾರ್ಯಗಳನ್ನು ಅವರ ಎದುರಿನಲ್ಲಿ ಮಾಡಿದರೂ ಜನರು ಅವರನ್ನು ನಂಬಲಿಲ್ಲ. <verse eid="JHN 12:37"/><verse number="38" style="v" sid="JHN 12:38"/>ಇದರಿಂದ,</para>
  <para style="q1" vid="JHN 12:38">“ಸ್ವಾಮೀ, ನಮ್ಮ ಸುದ್ದಿಯನ್ನು ಯಾರು ನಂಬಿದರು?</para>
  <para style="q2" vid="JHN 12:38">ಕರ್ತ ಆಗಿರುವವರ ಬಾಹುವು ಯಾರಿಗೆ ಪ್ರಕಟವಾಯಿತು?”<note caller="+" style="f"><char style="fr" closed="false">12:38 </char><char style="ft" closed="false"><char style="xt"><ref loc="ISA 53:1">ಯೆಶಾಯ 53:1</ref></char></char></note></para>
  <para style="m" vid="JHN 12:38">ಎಂದು ಪ್ರವಾದಿ ಯೆಶಾಯನು ನುಡಿದದ್ದು ನೆರವೇರಿತು.<verse eid="JHN 12:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="JHN 12:39"/>ಅವರು ನಂಬಲಾರದೆ ಹೋದದ್ದರಿಂದ ಯೆಶಾಯನು ಮತ್ತೊಂದು ಕಡೆ ಹೇಳಿದ್ದೇನೆಂದರೆ:<verse eid="JHN 12:39"/></para>
  <para style="q1">
    <verse number="40" style="v" sid="JHN 12:40"/>“ಅವರು ಕಣ್ಣಿನಿಂದ ಕಾಣದೆ,</para>
  <para style="q2" vid="JHN 12:40">ಹೃದಯದಿಂದ ಗ್ರಹಿಸದೆ ಮತ್ತು</para>
  <para style="q1" vid="JHN 12:40">ತಿರುಗಿಕೊಂಡು ನನ್ನಿಂದ ಸ್ವಸ್ಥತೆಯನ್ನು ಹೊಂದದೆ ಇರುವಂತೆ ದೇವರು</para>
  <para style="q2" vid="JHN 12:40">ಅವರ ಕಣ್ಣುಗಳನ್ನು ಕುರುಡುಮಾಡಿ</para>
  <para style="q2" vid="JHN 12:40">ಅವರ ಹೃದಯವನ್ನು ಕಠಿಣ ಮಾಡಿದರು.”<note caller="+" style="f"><char style="fr" closed="false">12:40 </char><char style="ft" closed="false"><char style="xt"><ref loc="ISA 6:10">ಯೆಶಾಯ 6:10</ref></char></char></note><verse eid="JHN 12:40"/></para>
  <para style="m">
    <verse number="41" style="v" sid="JHN 12:41"/>ಯೆಶಾಯನು ಯೇಸುವಿನ ಮಹಿಮೆಯನ್ನು ಕಂಡಿದ್ದರಿಂದ ಅವರ ವಿಷಯವಾಗಿ ಇವುಗಳನ್ನು ಹೇಳಿದನು.<verse eid="JHN 12:41"/></para>
  <para style="p">
    <verse number="42" style="v" sid="JHN 12:42"/>ಆದರೂ ಅಧಿಕಾರಿಗಳಲ್ಲಿ ಅನೇಕರು ಆ ಸಮಯದಲ್ಲಿ ಯೇಸುವನ್ನು ನಂಬಿದರು. ಆದರೆ ಫರಿಸಾಯರ ನಿಮಿತ್ತ ತಾವು ಸಭಾಮಂದಿರದಿಂದ ಬಹಿಷ್ಕಾರ ಆಗಬಾರದೆಂದು ಅವರು ತಮ್ಮ ನಂಬಿಕೆಯನ್ನು ಬಹಿರಂಗವಾಗಿ ಅರಿಕೆ ಮಾಡಲಿಲ್ಲ. <verse eid="JHN 12:42"/><verse number="43" style="v" sid="JHN 12:43"/>ಅವರು ದೇವರಿಂದ ಬರುವ ಹೊಗಳಿಕೆಗಿಂತ ಮನುಷ್ಯರ ಹೊಗಳಿಕೆಯನ್ನೇ ಹೆಚ್ಚಾಗಿ ಪ್ರೀತಿಸಿದರು.<verse eid="JHN 12:43"/></para>
  <para style="p">
    <verse number="44" style="v" sid="JHN 12:44"/>ಯೇಸು, ಕೂಗಿ ಹೇಳಿದ್ದೇನೆಂದರೆ, “ನನ್ನನ್ನು ನಂಬುವವರು ನನ್ನಲ್ಲಿ ಅಲ್ಲ, ನನ್ನನ್ನು ಕಳುಹಿಸಿಕೊಟ್ಟ ತಂದೆಯಲ್ಲಿಯೇ ವಿಶ್ವಾಸವಿಡುತ್ತಾರೆ. <verse eid="JHN 12:44"/><verse number="45" style="v" sid="JHN 12:45"/>ನನ್ನನ್ನು ನೋಡುವವರು ನನ್ನನ್ನು ಕಳುಹಿಸಿದ ತಂದೆಯನ್ನೇ ಕಾಣುತ್ತಾರೆ. <verse eid="JHN 12:45"/><verse number="46" style="v" sid="JHN 12:46"/>ನನ್ನಲ್ಲಿ ನಂಬಿಕೆಯಿಡುವವರು ಕತ್ತಲೆಯಲ್ಲಿ ಉಳಿಯಬಾರದೆಂದು ನಾನು ಬೆಳಕಾಗಿ ಲೋಕಕ್ಕೆ ಬಂದಿದ್ದೇನೆ.<verse eid="JHN 12:46"/></para>
  <para style="p">
    <verse number="47" style="v" sid="JHN 12:47"/>“ಯಾರು ನನ್ನ ಮಾತುಗಳನ್ನು ಕೇಳಿಯೂ ಅವುಗಳನ್ನು ಕೈಕೊಂಡು ನಡೆಯದೆ ಹೋದರೆ ನಾನು ಅವರಿಗೆ ಈಗ ತೀರ್ಪು ಮಾಡುವುದಿಲ್ಲ. ಏಕೆಂದರೆ ಲೋಕಕ್ಕೆ ತೀರ್ಪು ಮಾಡುವುದಕ್ಕಾಗಿ ಅಲ್ಲ, ಲೋಕವನ್ನು ರಕ್ಷಿಸುವುದಕ್ಕಾಗಿಯೇ ನಾನು ಬಂದಿದ್ದೇನೆ. <verse eid="JHN 12:47"/><verse number="48" style="v" sid="JHN 12:48"/>ನನ್ನನ್ನು ತಿರಸ್ಕರಿಸಿ ನನ್ನ ಮಾತುಗಳನ್ನು ಸ್ವೀಕರಿಸದವರಿಗೆ ತೀರ್ಪು ಮಾಡುವಂಥದ್ದು ಒಂದು ಇದೆ. ಅದು ನಾನು ಮಾತನಾಡಿದ ವಾಕ್ಯವೇ, ಅದೇ ಕಡೇ ದಿನದಲ್ಲಿ ಅವರಿಗೆ ತೀರ್ಪು ಮಾಡುವುದು. <verse eid="JHN 12:48"/><verse number="49" style="v" sid="JHN 12:49"/>ಏಕೆಂದರೆ ನನ್ನಷ್ಟಕ್ಕೆ ನಾನೇ ಮಾತನಾಡಲಿಲ್ಲ. ಆದರೆ ನಾನು ಏನು ಹೇಳಬೇಕು ಮತ್ತು ನಾನು ಏನು ಮಾತನಾಡಬೇಕು ಎಂದು ನನ್ನನ್ನು ಕಳುಹಿಸಿದ ತಂದೆಯೇ ನನಗೆ ಆಜ್ಞೆ ಕೊಟ್ಟಿದ್ದಾರೆ. <verse eid="JHN 12:49"/><verse number="50" style="v" sid="JHN 12:50"/>ಅವರ ಆಜ್ಞೆಯು ನಿತ್ಯಜೀವಕ್ಕೆ ಮಾರ್ಗವಾಗಿದೆ ಎಂದು ನಾನು ಬಲ್ಲೆನು. ಆದ್ದರಿಂದ, ತಂದೆಯು ನನಗೆ ಹೇಳಿದಂತೆಯೇ ಮಾತನಾಡುತ್ತೇನೆ,” ಎಂದು ಹೇಳಿದರು.<verse eid="JHN 12:50"/></para>
  <chapter eid="JHN 12"/>
  <chapter number="13" style="c" sid="JHN 13"/>
  <para style="s1">ಯೇಸು ತಮ್ಮ ಶಿಷ್ಯರ ಪಾದಗಳನ್ನು ತೊಳೆದದ್ದು</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 13:1"/>ಅಂದು ಪಸ್ಕಹಬ್ಬದ ಹಿಂದಿನ ದಿನವಾಗಿತ್ತು. ಯೇಸು ತಾವು ಈ ಲೋಕವನ್ನು ಬಿಟ್ಟು ತಂದೆಯ ಬಳಿಗೆ ಹೋಗಬೇಕಾದ ಸಮಯ ಬಂತೆಂದು ತಿಳಿದು, ಈ ಲೋಕದಲ್ಲಿದ್ದ ತಮ್ಮವರನ್ನು ಪ್ರೀತಿಸುತ್ತಿದ್ದ ಆ ಪ್ರೀತಿಯ ಪರಿಪೂರ್ಣತೆಯನ್ನು ಈಗ ತೋರಿಸಲಿದ್ದರು.<verse eid="JHN 13:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="JHN 13:2"/>ಸಾಯಂಕಾಲ ಊಟದ ಸಮಯದಲ್ಲಿ ಯೇಸುವನ್ನು ಹಿಡಿದುಕೊಡಬೇಕೆಂಬ ಯೋಚನೆಯನ್ನು, ಸೈತಾನನು ಸೀಮೋನನ ಮಗನಾದ ಇಸ್ಕರಿಯೋತ ಯೂದನ ಹೃದಯದಲ್ಲಿ ಹಾಕಿದ್ದನು. <verse eid="JHN 13:2"/><verse number="3" style="v" sid="JHN 13:3"/>ತಂದೆಯು ತನ್ನ ಕೈಯಲ್ಲಿ ಎಲ್ಲವನ್ನೂ ಕೊಟ್ಟಿದ್ದಾರೆಂದೂ ತಾನು ದೇವರ ಬಳಿಯಿಂದ ಬಂದು ಮರಳಿ ದೇವರ ಬಳಿಗೆ ಹೋಗುತ್ತೇನೆಂದೂ ಯೇಸುವಿಗೆ ತಿಳಿದಿತ್ತು. <verse eid="JHN 13:3"/><verse number="4" style="v" sid="JHN 13:4"/>ಯೇಸು ಊಟದಿಂದೆದ್ದು ತಮ್ಮ ಮೇಲು ಹೊದಿಕೆಯನ್ನು ತೆಗೆದಿಟ್ಟು ಅಂಗವಸ್ತ್ರವನ್ನು ತೆಗೆದುಕೊಂಡು ಸೊಂಟಕ್ಕೆ ಕಟ್ಟಿಕೊಂಡರು. <verse eid="JHN 13:4"/><verse number="5" style="v" sid="JHN 13:5"/>ಅನಂತರ ಅವರು ಬೋಗುಣಿಯಲ್ಲಿ ನೀರು ಹಾಕಿಕೊಂಡು ಶಿಷ್ಯರ ಪಾದಗಳನ್ನು ತೊಳೆಯುವುದಕ್ಕೂ ತಾವು ಸೊಂಟಕ್ಕೆ ಕಟ್ಟಿಕೊಂಡ ಅಂಗವಸ್ತ್ರದಿಂದ ಪಾದಗಳನ್ನು ಒರೆಸುವುದಕ್ಕೂ ಪ್ರಾರಂಭಿಸಿದರು.<verse eid="JHN 13:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="JHN 13:6"/>ಯೇಸು ಸೀಮೋನ ಪೇತ್ರನ ಬಳಿಗೆ ಬಂದಾಗ ಅವನು ಯೇಸುವಿಗೆ, “ಸ್ವಾಮೀ, ನೀವು ನನ್ನ ಪಾದಗಳನ್ನು ತೊಳೆಯುತ್ತೀರೋ?” ಎಂದು ಕೇಳಿದನು.<verse eid="JHN 13:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="JHN 13:7"/>ಯೇಸು ಅವನಿಗೆ, “ನಾನು ಮಾಡುವುದು ಏನೆಂದು ಈಗ ನಿನಗೆ ಅರ್ಥವಾಗುವುದಿಲ್ಲ. ಆದರೆ ಇನ್ನು ಮುಂದೆ ನಿನಗೆ ಅರ್ಥವಾಗುವುದು,” ಎಂದರು.<verse eid="JHN 13:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="JHN 13:8"/>ಪೇತ್ರನು ಯೇಸುವಿಗೆ, “ನೀವು ನನ್ನ ಪಾದಗಳನ್ನು ಎಂದಿಗೂ ತೊಳೆಯಬಾರದು,” ಎಂದನು.</para>
  <para style="p" vid="JHN 13:8">ಯೇಸು ಅವನಿಗೆ, “ನಾನು ನಿನ್ನ ಪಾದಗಳನ್ನು ತೊಳೆಯದಿದ್ದರೆ ನನ್ನೊಂದಿಗೆ ನಿನಗೆ ಪಾಲು ಇಲ್ಲ,” ಎಂದು ಹೇಳಿದರು.<verse eid="JHN 13:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="JHN 13:9"/>ಅದಕ್ಕೆ ಸೀಮೋನ ಪೇತ್ರನು ಯೇಸುವಿಗೆ, “ಸ್ವಾಮೀ, ನನ್ನ ಪಾದಗಳನ್ನು ಮಾತ್ರವಲ್ಲದೆ, ನನ್ನ ಕೈಗಳನ್ನು ಮತ್ತು ತಲೆಯನ್ನು ಸಹ ತೊಳೆ,” ಎಂದನು.<verse eid="JHN 13:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="JHN 13:10"/>ಯೇಸು ಅವನಿಗೆ, “ಸ್ನಾನಮಾಡಿಕೊಂಡವರು ತಮ್ಮ ಪಾದಗಳನ್ನು ಮಾತ್ರ ತೊಳೆದುಕೊಂಡರೆ ಸಾಕು. ಅವರು ಸಂಪೂರ್ಣವಾಗಿ ಶುದ್ಧರಾಗಿದ್ದಾರೆ. ನೀವು ಸಹ ಶುದ್ಧರಾಗಿದ್ದೀರಿ. ನಿಮ್ಮಲ್ಲಿ ಎಲ್ಲರೂ ಶುದ್ಧರಲ್ಲ,” ಎಂದರು. <verse eid="JHN 13:10"/><verse number="11" style="v" sid="JHN 13:11"/>ತನ್ನನ್ನು ಹಿಡಿದುಕೊಡುವವನು ಯಾರೆಂದು ಯೇಸು ತಿಳಿದಿದ್ದರಿಂದ, “ನಿಮ್ಮಲ್ಲಿ ಎಲ್ಲರೂ ಶುದ್ಧರಲ್ಲ,” ಎಂದು ಹೇಳಿದರು.<verse eid="JHN 13:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 13:12"/>ಯೇಸು ಅವರ ಪಾದಗಳನ್ನು ತೊಳೆದ ಮೇಲೆ ತಮ್ಮ ಮೇಲು ಹೊದಿಕೆಯನ್ನು ಧರಿಸಿ, ತಮ್ಮ ಸ್ಥಳದಲ್ಲಿ ಕುಳಿತುಕೊಂಡು ಅವರಿಗೆ, “ನಾನು ನಿಮಗೆ ಮಾಡಿದ್ದು ಏನೆಂದು ಅರ್ಥವಾಯಿತೋ? <verse eid="JHN 13:12"/><verse number="13" style="v" sid="JHN 13:13"/>ನೀವು ನನ್ನನ್ನು ‘ಬೋಧಕರೇ’ ಮತ್ತು ‘ಕರ್ತಾ’ ಎಂದು ಕರೆಯುತ್ತೀರಿ. ನೀವು ಹೇಳುವುದು ಸರಿ. ಹೌದು, ನಾನು ಅಂಥವನೇ ಆಗಿದ್ದೇನೆ. <verse eid="JHN 13:13"/><verse number="14" style="v" sid="JHN 13:14"/>ಹಾಗಾದರೆ ನಿಮ್ಮ ಕರ್ತನೂ ಬೋಧಕನೂ ಆಗಿರುವ ನಾನೇ ನಿಮ್ಮ ಪಾದಗಳನ್ನು ತೊಳೆದಿರುವಾಗ ನೀವು ಸಹ ಒಬ್ಬರ ಪಾದಗಳನ್ನೊಬ್ಬರು ತೊಳೆಯಬೇಕು. <verse eid="JHN 13:14"/><verse number="15" style="v" sid="JHN 13:15"/>ನಾನು ನಿಮಗೆ ಮಾಡಿದಂತೆಯೇ ನೀವು ಸಹ ಮಾಡಬೇಕೆಂದು ನಾನು ನಿಮಗೆ ಮಾದರಿಯನ್ನು ಕೊಟ್ಟಿದ್ದೇನೆ. <verse eid="JHN 13:15"/><verse number="16" style="v" sid="JHN 13:16"/>ನಾನು ನಿಮಗೆ ನಿಜನಿಜವಾಗಿ ಹೇಳುತ್ತೇನೆ, ತನ್ನ ಧಣಿಗಿಂತ ಆಳು ದೊಡ್ಡವನಲ್ಲ, ಹಾಗೆಯೇ ಕಳುಹಿಸಲಾದವನು ಅವನನ್ನು ಕಳುಹಿಸಿದವನಿಗಿಂತ ದೊಡ್ಡವನಲ್ಲ. <verse eid="JHN 13:16"/><verse number="17" style="v" sid="JHN 13:17"/>ನೀವು ಇವುಗಳನ್ನು ತಿಳಿದುಕೊಂಡು ಇದರಂತೆ ಮಾಡಿದರೆ ನೀವು ಧನ್ಯರು.<verse eid="JHN 13:17"/></para>
  <para style="s1">ಯೇಸು ತನ್ನನ್ನು ಹಿಡಿದುಕೊಡುವುದನ್ನು ಮುಂತಿಳಿಸಿದ್ದು</para>
  <para style="p">
    <verse number="18" style="v" sid="JHN 13:18"/>“ನಾನು ನಿಮ್ಮೆಲ್ಲರನ್ನು ಕುರಿತು ಮಾತನಾಡುತ್ತಿಲ್ಲ. ನಾನು ಆರಿಸಿಕೊಂಡವರನ್ನು ನಾನು ಬಲ್ಲೆನು. ಆದರೆ ‘ನನ್ನ ಸಂಗಡ ರೊಟ್ಟಿಯನ್ನು ತಿಂದವನೇ,<note caller="+" style="f"><char style="fr" closed="false">13:18 </char><char style="ft" closed="false">ಗ್ರೀಕ್ ಭಾಷೆಯಲ್ಲಿ, </char><char style="fqa" closed="false">ತನ್ನ ಹಿಮ್ಮಡಿಯನ್ನು ಎತ್ತಿದ್ದಾನೆ </char><char style="ft" closed="false">ಎಂದಿದೆ</char></note> ನನಗೆ ದ್ರೋಹ ಬಗೆದನು,’<note caller="+" style="f"><char style="fr" closed="false">13:18 </char><char style="ft" closed="false"><char style="xt"><ref loc="PSA 41:9">ಕೀರ್ತನೆ 41:9</ref></char></char></note> ಎಂಬ ಪವಿತ್ರ ವಾಕ್ಯವು ನೆರವೇರಬೇಕಾಗಿದೆ.<verse eid="JHN 13:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="JHN 13:19"/>“ಅದು ಆಗುವುದು, ‘ನಾನೇ ಆತನು’ ಎಂದು ನೀವು ನಂಬುವಂತೆ ಅದು ಸಂಭವಿಸುವುದಕ್ಕಿಂತ ಮುಂಚೆ ಈಗಲೇ ನಿಮಗೆ ಹೇಳುತ್ತಿದ್ದೇನೆ. <verse eid="JHN 13:19"/><verse number="20" style="v" sid="JHN 13:20"/>ನಾನು ನಿಮಗೆ ನಿಜನಿಜವಾಗಿ ಹೇಳುತ್ತೇನೆ, ನನ್ನನ್ನು ಕಳುಹಿಸಿದ ತಂದೆಯನ್ನು ಸ್ವೀಕರಿಸುವವನು ನನ್ನನ್ನು ಸ್ವೀಕರಿಸುತ್ತಾನೆ; ನನ್ನನ್ನು ಸ್ವೀಕರಿಸುವವನು ನನ್ನನ್ನು ಕಳುಹಿಸಿದ ತಂದೆಯನ್ನೇ ಸ್ವೀಕರಿಸುತ್ತಾನೆ.”<verse eid="JHN 13:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="JHN 13:21"/>ಯೇಸು ಇವುಗಳನ್ನು ಹೇಳುತ್ತಾ ಆತ್ಮದಲ್ಲಿ ನೊಂದುಕೊಂಡವರಾಗಿ, “ನಾನು ನಿಮಗೆ ನಿಜನಿಜವಾಗಿ ಹೇಳುತ್ತೇನೆ, ನಿಮ್ಮಲ್ಲಿ ಒಬ್ಬನು ನನಗೆ ದ್ರೋಹ ಬಗೆಯುವನು,” ಎಂದು ಸ್ವಷ್ಟವಾಗಿ ಹೇಳಿದರು.<verse eid="JHN 13:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 13:22"/>ಆಗ ಶಿಷ್ಯರು ಗಲಿಬಿಲಿಗೊಂಡು, “ಯೇಸು ಯಾರನ್ನು ಕುರಿತು ಹೇಳಿದರು?” ಎಂದು ಒಬ್ಬರನ್ನೊಬ್ಬರು ನೋಡುವವರಾದರು. <verse eid="JHN 13:22"/><verse number="23" style="v" sid="JHN 13:23"/>ಶಿಷ್ಯರಲ್ಲಿ ಯೇಸು ಪ್ರೀತಿಸಿದ ಒಬ್ಬನು ಅವರ ಎದೆಗೆ ಒರಗಿಕೊಂಡಿದ್ದನು. <verse eid="JHN 13:23"/><verse number="24" style="v" sid="JHN 13:24"/>ಸೀಮೋನ ಪೇತ್ರನು ಅವನಿಗೆ ಸನ್ನೆಮಾಡಿ, “ಅವರು ಯಾರ ವಿಷಯವಾಗಿ ಮಾತನಾಡಿದರು ಕೇಳು,” ಎಂದು ಹೇಳಿದನು.<verse eid="JHN 13:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 13:25"/>ಅವನು ಯೇಸುವಿನ ಎದೆಗೆ ಒರಗಿಕೊಂಡವನಾಗಿ, “ಸ್ವಾಮೀ, ಅವನು ಯಾರು?” ಎಂದು ಯೇಸುವನ್ನು ಕೇಳಿದನು.<verse eid="JHN 13:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="JHN 13:26"/>ಅದಕ್ಕೆ ಯೇಸು, “ನಾನು ರೊಟ್ಟಿಯ ತುಂಡನ್ನು ಅದ್ದಿ ಯಾವನಿಗೆ ಕೊಡುತ್ತೇನೋ ಅವನೇ,” ಎಂದರು. ತರುವಾಯ, ಆ ರೊಟ್ಟಿಯ ತುಂಡನ್ನು ಅದ್ದಿ ಸೀಮೋನನ ಮಗನಾದ ಯೂದ ಇಸ್ಕರಿಯೋತನಿಗೆ ಕೊಟ್ಟರು. <verse eid="JHN 13:26"/><verse number="27" style="v" sid="JHN 13:27"/>ಅವನು ರೊಟ್ಟಿಯ ತುಂಡನ್ನು ತೆಗೆದುಕೊಂಡು ತಿಂದನು. ಅನಂತರ ಸೈತಾನನು ಅವನೊಳಗೆ ಪ್ರವೇಶಿಸಿದನು.</para>
  <para style="p" vid="JHN 13:27">ಆಗ ಯೇಸು ಅವನಿಗೆ, “ನೀನು ಮಾಡುವುದನ್ನು ಬೇಗನೆ ಮಾಡು,” ಎಂದು ಹೇಳಿದರು. <verse eid="JHN 13:27"/><verse number="28" style="v" sid="JHN 13:28"/>ಆದರೆ ಯೇಸು ಅವನಿಗೆ ಇದನ್ನು ಏಕೆ ಹೇಳಿದರೆಂದು ಕುಳಿತವರಲ್ಲಿ ಯಾರಿಗೂ ಗೊತ್ತಾಗಲಿಲ್ಲ. <verse eid="JHN 13:28"/><verse number="29" style="v" sid="JHN 13:29"/>ಏಕೆಂದರೆ ಯೂದನು ಹಣದ ಚೀಲವನ್ನು ಇಟ್ಟುಕೊಂಡಿದ್ದರಿಂದ ಯೇಸು ಅವನಿಗೆ, ಹಬ್ಬಕ್ಕೆ ನಮಗೆ ಅವಶ್ಯವಾದವುಗಳನ್ನು ಕೊಂಡುಕೋ, ಎಂದೋ ಬಡವರಿಗೆ ಏನಾದರೂ ಕೊಡು ಎಂದೋ ಯೇಸು ಅವನಿಗೆ ಹೇಳಿದರೆಂದು ಅವರಲ್ಲಿ ಕೆಲವರು ಭಾವಿಸಿದರು. <verse eid="JHN 13:29"/><verse number="30" style="v" sid="JHN 13:30"/>ಯೂದನು ಆ ರೊಟ್ಟಿಯ ತುಂಡನ್ನು ತೆಗೆದುಕೊಂಡ ಕೂಡಲೇ ಹೊರಗೆ ಹೋದನು. ಆಗ ರಾತ್ರಿಯಾಗಿತ್ತು.<verse eid="JHN 13:30"/></para>
  <para style="s1">ಪೇತ್ರನು ತಮ್ಮನ್ನು ಅಲ್ಲಗಳೆಯುವುದನ್ನು ಯೇಸು ಮುಂತಿಳಿಸಿದ್ದು</para>
  <para style="p">
    <verse number="31" style="v" sid="JHN 13:31"/>ಅವನು ಹೊರಟುಹೋದ ಮೇಲೆ ಯೇಸು, “ಈಗ ಮನುಷ್ಯಪುತ್ರನಾದ ನಾನು ಮಹಿಮೆ ಹೊಂದಲಿದ್ದೇನೆ. ದೇವರೂ ನನ್ನಲ್ಲಿ ಮಹಿಮೆ ಹೊಂದುವರು. <verse eid="JHN 13:31"/><verse number="32" style="v" sid="JHN 13:32"/>ದೇವರು ಮನುಷ್ಯಪುತ್ರನಾದ ನನ್ನಲ್ಲಿ ಮಹಿಮೆ ಪಟ್ಟರೆ, ದೇವರು ಸಹ ಮನುಷ್ಯಪುತ್ರನಾದ ನನ್ನನ್ನು ತಮ್ಮಲ್ಲಿ ಮಹಿಮೆಪಡಿಸುವರು ಮತ್ತು ತಕ್ಷಣವೇ ಮಹಿಮೆಪಡಿಸುವರು.<verse eid="JHN 13:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="JHN 13:33"/>“ನನ್ನ ಮಕ್ಕಳೇ, ಇನ್ನು ಸ್ವಲ್ಪ ಕಾಲವೇ ನಾನು ನಿಮ್ಮೊಡನೆ ಇರುತ್ತೇನೆ. ‘ನೀವು ನನ್ನನ್ನು ಹುಡುಕುವಿರಿ, ನಾನು ಹೋಗುವಲ್ಲಿಗೆ ನೀವು ಬರಲಾರಿರಿ’ ಎಂದು ನಾನು ಯೆಹೂದಿ ನಾಯಕರಿಗೆ ಹೇಳಿದಂತೆಯೇ ನಿಮಗೂ ಈಗ ಹೇಳುತ್ತೇನೆ.<verse eid="JHN 13:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="JHN 13:34"/>“ನಾನು ನಿಮಗೊಂದು ಹೊಸ ಆಜ್ಞೆಯನ್ನು ಕೊಡುತ್ತೇನೆ: ನೀವು ಒಬ್ಬರನ್ನೊಬ್ಬರು ಪ್ರೀತಿಸಬೇಕು. ನಾನು ನಿಮ್ಮನ್ನು ಪ್ರೀತಿಸಿದ ಹಾಗೆಯೇ ನೀವೂ ಒಬ್ಬರನ್ನೊಬ್ಬರು ಪ್ರೀತಿಸಬೇಕು. <verse eid="JHN 13:34"/><verse number="35" style="v" sid="JHN 13:35"/>ನಿಮಗೆ ಪರಸ್ಪರ ಪ್ರೀತಿಯಿದ್ದರೆ, ಎಲ್ಲರೂ ನಿಮ್ಮನ್ನು ನನ್ನ ಶಿಷ್ಯರೆಂದು ತಿಳಿದುಕೊಳ್ಳುವರು,” ಎಂದು ಹೇಳಿದರು.<verse eid="JHN 13:35"/></para>
  <para style="p">
    <verse number="36" style="v" sid="JHN 13:36"/>ಸೀಮೋನ ಪೇತ್ರನು ಯೇಸುವಿಗೆ, “ಸ್ವಾಮೀ, ನೀವು ಎಲ್ಲಿಗೆ ಹೋಗುತ್ತೀರಿ?” ಎಂದು ಕೇಳಿದ್ದಕ್ಕೆ,</para>
  <para style="p" vid="JHN 13:36">ಯೇಸು ಅವನಿಗೆ, “ನಾನು ಹೋಗುವ ಕಡೆಗೆ ಈಗ ನೀನು ನನ್ನನ್ನು ಹಿಂಬಾಲಿಸಲಾರೆ, ನಂತರ ಹಿಂಬಾಲಿಸುವೆ,” ಎಂದರು.<verse eid="JHN 13:36"/></para>
  <para style="p">
    <verse number="37" style="v" sid="JHN 13:37"/>ಪೇತ್ರನು ಯೇಸುವಿಗೆ, “ಕರ್ತದೇವರೇ, ನಾನು ಈಗ ನಿಮ್ಮನ್ನು ಏಕೆ ಹಿಂಬಾಲಿಸಲಾರೆನು? ನಿಮಗಾಗಿ ನನ್ನ ಪ್ರಾಣವನ್ನೇ ಕೊಡುವೆನು,” ಎಂದನು.<verse eid="JHN 13:37"/></para>
  <para style="p">
    <verse number="38" style="v" sid="JHN 13:38"/>ಯೇಸು ಅವನಿಗೆ, “ನೀನು ನನಗಾಗಿ ನಿನ್ನ ಪ್ರಾಣವನ್ನೇ ಕೊಡುವೆಯೋ? ನಾನು ನಿನಗೆ ನಿಜನಿಜವಾಗಿ ಹೇಳುತ್ತೇನೆ, ನೀನು ನನ್ನನ್ನು ಮೂರು ಸಾರಿ ನಿರಾಕರಿಸುವ ತನಕ ಹುಂಜ ಕೂಗುವುದೇ ಇಲ್ಲ,” ಎಂದರು.<verse eid="JHN 13:38"/></para>
  <chapter eid="JHN 13"/>
  <chapter number="14" style="c" sid="JHN 14"/>
  <para style="s1">ಯೇಸುಸ್ವಾಮಿಯ ಆದರಣೆಯ ಮಾತುಗಳು</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 14:1"/>“ನಿಮ್ಮ ಹೃದಯವು ಕಳವಳಗೊಳ್ಳದಿರಲಿ, ನೀವು ದೇವರನ್ನು ನಂಬಿರಿ; ನನ್ನನ್ನೂ ನಂಬಿರಿ. <verse eid="JHN 14:1"/><verse number="2" style="v" sid="JHN 14:2"/>ನನ್ನ ತಂದೆಯ ಮನೆಯಲ್ಲಿ ಅನೇಕ ವಾಸಸ್ಥಾನಗಳಿವೆ. ಇಲ್ಲದಿದ್ದರೆ ನಾನು ನಿಮಗೆ ಹೇಳುತ್ತಿದ್ದೆನು. ನಾನು ನಿಮಗಾಗಿ ಸ್ಥಳವನ್ನು ಸಿದ್ಧಮಾಡುವುದಕ್ಕೆ ಹೋಗುತ್ತೇನಲ್ಲಾ. <verse eid="JHN 14:2"/><verse number="3" style="v" sid="JHN 14:3"/>ನಾನು ಹೋಗಿ ನಿಮಗಾಗಿ ಸ್ಥಳವನ್ನು ಸಿದ್ಧಮಾಡಿದ ಮೇಲೆ ಪುನಃ ಬಂದು ನಿಮ್ಮನ್ನು ನನ್ನ ಬಳಿಗೆ ಸೇರಿಸಿಕೊಳ್ಳುವೆನು. ಆಗ ನಾನಿರುವಲ್ಲಿ ನೀವು ಸಹ ಇರುವಿರಿ. <verse eid="JHN 14:3"/><verse number="4" style="v" sid="JHN 14:4"/>ನಾನು ಹೋಗುವ ಸ್ಥಳದ ಮಾರ್ಗವು ನಿಮಗೆ ತಿಳಿದಿದೆ,” ಎಂದರು.<verse eid="JHN 14:4"/></para>
  <para style="s1">ತಂದೆಯನ್ನು ಸೇರುವುದಕ್ಕೆ ಯೇಸುವೇ ಮಾರ್ಗ</para>
  <para style="p">
    <verse number="5" style="v" sid="JHN 14:5"/>ಆಗ ತೋಮನು ಯೇಸುವಿಗೆ, “ಸ್ವಾಮೀ, ನೀವು ಎಲ್ಲಿಗೆ ಹೋಗುತ್ತೀರೋ ನಮಗೆ ತಿಳಿಯದು. ಆದ್ದರಿಂದ ನಮಗೆ ಮಾರ್ಗವು ಹೇಗೆ ತಿಳಿದೀತು?” ಎಂದನು.<verse eid="JHN 14:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="JHN 14:6"/>ಯೇಸು ಅವನಿಗೆ, “ನಾನೇ ಮಾರ್ಗವೂ ಸತ್ಯವೂ ಜೀವವೂ ಆಗಿದ್ದೇನೆ. ನನ್ನ ಮೂಲಕವಾಗಿ ಹೊರತು ಯಾರೂ ತಂದೆಯ ಬಳಿಗೆ ಬರಲಾರರು. <verse eid="JHN 14:6"/><verse number="7" style="v" sid="JHN 14:7"/>ನೀವು ನನ್ನನ್ನು ತಿಳಿದಿದ್ದರೆ ನನ್ನ ತಂದೆಯನ್ನು ಸಹ ತಿಳಿಯುತ್ತಿದ್ದೀರಿ. ಈಗಿನಿಂದ ನೀವು ತಂದೆಯನ್ನು ತಿಳಿದಿದ್ದೀರಿ ಮತ್ತು ಅವರನ್ನು ಕಂಡಿದ್ದೀರಿ,” ಎಂದು ಹೇಳಿದರು.<verse eid="JHN 14:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="JHN 14:8"/>ಅದಕ್ಕೆ ಫಿಲಿಪ್ಪನು, “ಸ್ವಾಮೀ, ತಂದೆಯನ್ನು ನಮಗೆ ತೋರಿಸಿರಿ, ನಮಗೆ ಅಷ್ಟೇ ಸಾಕು,” ಎಂದನು.<verse eid="JHN 14:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="JHN 14:9"/>ಯೇಸು ಅವನಿಗೆ, “ಫಿಲಿಪ್ಪನೇ, ನಾನು ಇಷ್ಟುಕಾಲ ನಿಮ್ಮೊಂದಿಗೆ ಇದ್ದರೂ ನೀನು ನನ್ನನ್ನು ತಿಳಿಯಲಿಲ್ಲ. ನನ್ನನ್ನು ನೋಡಿದವನು ತಂದೆಯನ್ನು ನೋಡಿದ್ದಾನೆ. ಹಾಗಾದರೆ, ‘ತಂದೆಯನ್ನು ನಮಗೆ ತೋರಿಸಿರಿ’ ಎಂದು ನೀನು ಕೇಳುವುದು ಹೇಗೆ? <verse eid="JHN 14:9"/><verse number="10" style="v" sid="JHN 14:10"/>ನಾನು ತಂದೆಯಲ್ಲಿ ಇದ್ದೇನೆ ಮತ್ತು ತಂದೆಯು ನನ್ನಲ್ಲಿ ಇದ್ದಾರೆ ಎಂದು ನೀನು ನಂಬುವುದಿಲ್ಲವೇ? ನಾನು ನಿಮಗೆ ಹೇಳುವ ಮಾತುಗಳನ್ನು ನನ್ನಷ್ಟಕ್ಕೆ ನಾನೇ ಮಾತನಾಡುವುದಿಲ್ಲ; ನನ್ನಲ್ಲಿರುವ ತಂದೆಯೇ ತಮ್ಮ ಕ್ರಿಯೆಗಳನ್ನು ಮಾಡುತ್ತಾರೆ. <verse eid="JHN 14:10"/><verse number="11" style="v" sid="JHN 14:11"/>ನಾನು ತಂದೆಯಲ್ಲಿಯೂ ತಂದೆಯು ನನ್ನಲ್ಲಿಯೂ ಇದ್ದಾರೆಂದು ಹೇಳುವಾಗ ನೀವು ನನ್ನನ್ನು ನಂಬಿರಿ, ಇಲ್ಲದಿದ್ದರೆ ಆ ಕ್ರಿಯೆಗಳನ್ನಾದರೂ ನೀವು ನಂಬಿರಿ. <verse eid="JHN 14:11"/><verse number="12" style="v" sid="JHN 14:12"/>ನಾನು ನಿಮಗೆ ನಿಜನಿಜವಾಗಿ ಹೇಳುತ್ತೇನೆ, ನನ್ನನ್ನು ನಂಬುವವರು ನಾನು ಮಾಡುವ ಕ್ರಿಯೆಗಳನ್ನು ತಾವು ಸಹ ಮಾಡುವರು. ಇವುಗಳಿಗಿಂತ ಮಹತ್ತಾದವುಗಳನ್ನು ಅವರು ಮಾಡುವರು. ಏಕೆಂದರೆ ನಾನು ನನ್ನ ತಂದೆಯ ಬಳಿಗೆ ಹೋಗುತ್ತೇನೆ. <verse eid="JHN 14:12"/><verse number="13" style="v" sid="JHN 14:13"/>ನನ್ನ ಹೆಸರಿನಲ್ಲಿ ನೀವು ಏನೇನು ಕೇಳಿಕೊಳ್ಳುವಿರೋ ಅದನ್ನು ನಾನು ಮಾಡುವೆನು. ಹೀಗೆ ತಂದೆಗೆ ಪುತ್ರನಲ್ಲಿ ಮಹಿಮೆ ಉಂಟಾಗುವುದು. <verse eid="JHN 14:13"/><verse number="14" style="v" sid="JHN 14:14"/>ನೀವು ನನ್ನ ಹೆಸರಿನಲ್ಲಿ ನನ್ನನ್ನು ಏನಾದರೂ ಕೇಳಿಕೊಂಡರೆ ನಾನು ಅದನ್ನು ಮಾಡುವೆನು.<verse eid="JHN 14:14"/></para>
  <para style="s1">ಪರಿಶುದ್ಧಾತ್ಮರನ್ನು ಕುರಿತು ಯೇಸು ವಾಗ್ದಾನ ಮಾಡಿದ್ದು</para>
  <para style="p">
    <verse number="15" style="v" sid="JHN 14:15"/>“ನೀವು ನನ್ನನ್ನು ಪ್ರೀತಿಸುವವರಾದರೆ ನನ್ನ ಆಜ್ಞೆಗಳನ್ನು ಅನುಸರಿಸುವಿರಿ. <verse eid="JHN 14:15"/><verse number="16" style="v" sid="JHN 14:16"/>ನಾನು ತಂದೆಯನ್ನು ಕೇಳಿಕೊಳ್ಳುವೆನು. ಆಗ ತಂದೆ ನಿಮಗೆ ಬೇರೊಬ್ಬ ಸಹಾಯಕರನ್ನು ಸದಾಕಾಲವೂ ನಿಮ್ಮೊಂದಿಗೆ ಇರುವುದಕ್ಕೆ ಕೊಡುವರು. <verse eid="JHN 14:16"/><verse number="17" style="v" sid="JHN 14:17"/>ಅವರೇ ಸತ್ಯದ ಆತ್ಮರಾಗಿದ್ದಾರೆ. ಲೋಕವು ಅವರನ್ನು ನೋಡದೆಯೂ ತಿಳಿಯದೆಯೂ ಇರುವುದರಿಂದ ಸತ್ಯದ ಆತ್ಮರಾಗಿರುವ ಅವರನ್ನು ಸ್ವೀಕರಿಸಲಾರದು. ನೀವು ಅವರನ್ನು ಬಲ್ಲಿರಿ. ಏಕೆಂದರೆ ಅವರು ನಿಮ್ಮೊಂದಿಗಿರುವರು ಮತ್ತು ನಿಮ್ಮೊಳಗೂ ನೆಲೆಸಿರುವರು. <verse eid="JHN 14:17"/><verse number="18" style="v" sid="JHN 14:18"/>ನಾನು ನಿಮ್ಮನ್ನು ಅನಾಥರನ್ನಾಗಿ ಬಿಡುವುದಿಲ್ಲ. ನಿಮ್ಮ ಬಳಿಗೆ ನಾನು ಬರುತ್ತೇನೆ. <verse eid="JHN 14:18"/><verse number="19" style="v" sid="JHN 14:19"/>ಇನ್ನು ಸ್ವಲ್ಪ ಕಾಲವಾದ ಮೇಲೆ ಲೋಕವು ನನ್ನನ್ನು ಕಾಣುವುದಿಲ್ಲ. ಆದರೆ ನೀವು ನನ್ನನ್ನು ಕಾಣುವಿರಿ. ಏಕೆಂದರೆ ನಾನು ಜೀವಿಸುವುದರಿಂದ ನೀವು ಸಹ ಜೀವಿಸುವಿರಿ. <verse eid="JHN 14:19"/><verse number="20" style="v" sid="JHN 14:20"/>ನಾನು ನನ್ನ ತಂದೆಯಲ್ಲಿಯೂ ನೀವು ನನ್ನಲ್ಲಿಯೂ ನಾನು ನಿಮ್ಮಲ್ಲಿಯೂ ಇರುವುದನ್ನು ನೀವು ಆ ದಿನದಲ್ಲಿ ತಿಳಿದುಕೊಳ್ಳುವಿರಿ. <verse eid="JHN 14:20"/><verse number="21" style="v" sid="JHN 14:21"/>ನನ್ನ ಆಜ್ಞೆಗಳನ್ನು ಹೊಂದಿ ಅವುಗಳನ್ನು ಕೈಗೊಳ್ಳುವವರೇ ನನ್ನನ್ನು ಪ್ರೀತಿಸುವವರು. ನನ್ನನ್ನು ಪ್ರೀತಿಸುವವನು ತನ್ನ ತಂದೆಗೆ ಪ್ರಿಯನಾಗಿರುವನು. ನಾನು ಅವನನ್ನು ಪ್ರೀತಿಸಿ ಅವನಿಗೆ ನನ್ನನ್ನು ಪ್ರಕಟಿಸಿಕೊಳ್ಳುವೆನು,” ಎಂದು ಹೇಳಿದರು.<verse eid="JHN 14:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 14:22"/>ಇಸ್ಕರಿಯೋತ ಅಲ್ಲದ ಮತ್ತೊಬ್ಬ ಯೂದನು, “ಸ್ವಾಮೀ, ನೀವು ಲೋಕಕ್ಕೆ ಪ್ರಕಟವಾಗದೆ ನಮಗೆ ಮಾತ್ರ ಪ್ರಕಟವಾಗುವುದು ಏಕೆ?” ಎಂದು ಕೇಳಿದನು.<verse eid="JHN 14:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="JHN 14:23"/>ಯೇಸು ಅವನಿಗೆ, “ಯಾವನಾದರೂ ನನ್ನನ್ನು ಪ್ರೀತಿಸುವುದಾದರೆ ಅವನು ನನ್ನ ವಾಕ್ಯವನ್ನು ಕೈಗೊಳ್ಳುವನು. ನನ್ನ ತಂದೆಯು ಅವನನ್ನು ಪ್ರೀತಿಸುವರು. ಇದಲ್ಲದೆ ನಾವು ಅವನ ಬಳಿಗೆ ಬಂದು ಅವನೊಂದಿಗೆ ನಿವಾಸಮಾಡಿಕೊಳ್ಳುವೆವು. <verse eid="JHN 14:23"/><verse number="24" style="v" sid="JHN 14:24"/>ನನ್ನನ್ನು ಪ್ರೀತಿಸದವನು ನನ್ನ ವಾಕ್ಯಗಳನ್ನು ಕೈಗೊಳ್ಳುವುದಿಲ್ಲ. ನೀವು ಕೇಳಿದ ವಾಕ್ಯವು ನನ್ನ ವಾಕ್ಯಗಳಲ್ಲ. ಅವು ನನ್ನನ್ನು ಕಳುಹಿಸಿದ ನನ್ನ ತಂದೆಯ ವಾಕ್ಯಗಳಾಗಿವೆ.<verse eid="JHN 14:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 14:25"/>“ನಾನು ಇನ್ನೂ ನಿಮ್ಮೊಡನೆ ಇರುವಾಗಲೇ ಈ ಸಂಗತಿಗಳನ್ನು ನಿಮಗೆ ಹೇಳಿದ್ದೇನೆ. <verse eid="JHN 14:25"/><verse number="26" style="v" sid="JHN 14:26"/>ತಂದೆಯು ನನ್ನ ಹೆಸರಿನಲ್ಲಿ ಕಳುಹಿಸಿಕೊಡುವ ಸಹಾಯಕ ‘ಪವಿತ್ರಾತ್ಮರು’ ಎಲ್ಲವನ್ನೂ ನಿಮಗೆ ಬೋಧಿಸಿ ನಾನು ನಿಮಗೆ ಹೇಳಿದ್ದನ್ನೆಲ್ಲಾ ನಿಮ್ಮ ನೆನಪಿಗೆ ತರುವರು. <verse eid="JHN 14:26"/><verse number="27" style="v" sid="JHN 14:27"/>ನಾನು ಸಮಾಧಾನವನ್ನು ನಿಮಗೆ ಬಿಟ್ಟು ಹೋಗುತ್ತೇನೆ. ನನ್ನ ಸಮಾಧಾನವನ್ನು ನಾನು ನಿಮಗೆ ಕೊಡುತ್ತೇನೆ. ಲೋಕವು ಕೊಡುವಂತೆ ನಾನು ನಿಮಗೆ ಕೊಡುವುದಿಲ್ಲ. ನಿಮ್ಮ ಹೃದಯವು ಕಳವಳಗೊಳ್ಳದಿರಲಿ, ಅಂಜದಿರಲಿ.<verse eid="JHN 14:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="JHN 14:28"/>“ ‘ನಾನು ಹೋಗಿ ತಿರುಗಿ ನಿಮ್ಮ ಬಳಿಗೆ ಬರುತ್ತೇನೆ,’ ಎಂದು ನಾನು ನಿಮಗೆ ಹೇಳಿದ್ದನ್ನು ಕೇಳಿದ್ದೀರಿ. ನೀವು ನನ್ನನ್ನು ಪ್ರೀತಿಸುವವರಾಗಿದ್ದರೆ ತಂದೆಯ ಬಳಿಗೆ ಹೋಗುತ್ತೇನೆಂದು ಹೇಳಿದ್ದಕ್ಕೆ ಸಂತೋಷ ಪಡುತ್ತಿದ್ದಿರಿ. ಏಕೆಂದರೆ ತಂದೆಯು ನನಗಿಂತಲೂ ದೊಡ್ಡವರು. <verse eid="JHN 14:28"/><verse number="29" style="v" sid="JHN 14:29"/>ಅದು ನಡೆಯುವಾಗ ನೀವು ನಂಬುವಂತೆ ಇದೆಲ್ಲಾ ನಡೆಯುವುದಕ್ಕಿಂತ ಮುಂಚೆಯೇ ಈಗ ನಾನು ನಿಮಗೆ ಹೇಳಿದ್ದೇನೆ. <verse eid="JHN 14:29"/><verse number="30" style="v" sid="JHN 14:30"/>ಇನ್ನು ಮೇಲೆ ನಾನು ನಿಮ್ಮೊಂದಿಗೆ ಹೆಚ್ಚು ವಿಷಯಗಳನ್ನು ಮಾತನಾಡುವುದಿಲ್ಲ. ಏಕೆಂದರೆ ಇಹಲೋಕದ ಅಧಿಪತಿಯು ಬರಲಿದ್ದಾನೆ. ನನ್ನಲ್ಲಿ ಅವನಿಗೆ ಸೇರಿದ್ದು ಒಂದೂ ಇರುವುದಿಲ್ಲ. <verse eid="JHN 14:30"/><verse number="31" style="v" sid="JHN 14:31"/>ಆದರೆ ನಾನು ತಂದೆಯನ್ನು ಪ್ರೀತಿಸುತ್ತೇನೆಂದು ಲೋಕವು ತಿಳಿಯುವಂತೆ ತಂದೆ ನನಗೆ ಆಜ್ಞಾಪಿಸಿದಂತೆಯೇ ನಾನು ಮಾಡುತ್ತೇನೆ.</para>
  <para style="p" vid="JHN 14:31">“ಏಳಿರಿ, ನಾವು ಇಲ್ಲಿಂದ ಹೋಗೋಣ,” ಎಂದರು.<verse eid="JHN 14:31"/></para>
  <chapter eid="JHN 14"/>
  <chapter number="15" style="c" sid="JHN 15"/>
  <para style="s1">ದ್ರಾಕ್ಷಿಯ ಬಳ್ಳಿ ಮತ್ತು ಕವಲುಬಳ್ಳಿಗಳು</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 15:1"/>“ನಾನೇ ನಿಜವಾದ ದ್ರಾಕ್ಷಿಯ ಬಳ್ಳಿ, ನನ್ನ ತಂದೆಯೇ ತೋಟಗಾರರು. <verse eid="JHN 15:1"/><verse number="2" style="v" sid="JHN 15:2"/>ನನ್ನಲ್ಲಿದ್ದು ಫಲವನ್ನು ಕೊಡದ ಪ್ರತಿಯೊಂದು ಕವಲುಬಳ್ಳಿಯನ್ನು ತಂದೆ ಮೇಲಕ್ಕೆ ಎತ್ತಿಡುವರು. ಆದರೆ ಫಲಕೊಡುವ ಪ್ರತಿಯೊಂದು ಕವಲುಬಳ್ಳಿಯು ಹೆಚ್ಚು ಫಲಕೊಡುವಂತೆ ಅದನ್ನು ಕತ್ತರಿಸಿ ಶುದ್ಧ ಮಾಡುತ್ತಾರೆ. <verse eid="JHN 15:2"/><verse number="3" style="v" sid="JHN 15:3"/>ನಾನು ನಿಮಗೆ ಹೇಳಿದ ವಾಕ್ಯದ ದೆಸೆಯಿಂದ ನೀವು ಈಗ ಶುದ್ಧರಾಗಿದ್ದೀರಿ. <verse eid="JHN 15:3"/><verse number="4" style="v" sid="JHN 15:4"/>ನಾನು ನಿಮ್ಮಲ್ಲಿ ನೆಲೆಗೊಂಡಿರುವ ಹಾಗೇ ನನ್ನಲ್ಲಿ ನೆಲೆಗೊಂಡಿರಿ. ಕವಲುಬಳ್ಳಿಯು ದ್ರಾಕ್ಷಿಯ ಬಳ್ಳಿಯಲ್ಲಿ ನೆಲೆಗೊಂಡಿರದಿದ್ದರೆ ಹೇಗೆ ತನ್ನಷ್ಟಕ್ಕೆ ತಾನೇ ಫಲ ಕೊಡಲಾರದೋ ಹಾಗೆಯೇ ನೀವೂ ನನ್ನಲ್ಲಿ ನೆಲೆಗೊಂಡಿರದಿದ್ದರೆ ಫಲಕೊಡಲಾರಿರಿ.<verse eid="JHN 15:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="JHN 15:5"/>“ನಾನೇ ದ್ರಾಕ್ಷಿಯ ಬಳ್ಳಿ, ನೀವು ಕವಲುಬಳ್ಳಿಗಳು. ನೀವು ನನ್ನಲ್ಲಿ ಮತ್ತು ನಾನು ನಿಮ್ಮಲ್ಲಿ ನೆಲೆಗೊಂಡಿದ್ದರೆ ನೀವು ಬಹಳ ಫಲಕೊಡುವಿರಿ. ಏಕೆಂದರೆ ನೀವು ನನ್ನನ್ನು ಬಿಟ್ಟು ಏನೂ ಮಾಡಲಾರಿರಿ. <verse eid="JHN 15:5"/><verse number="6" style="v" sid="JHN 15:6"/>ನೀವು ನನ್ನಲ್ಲಿ ನೆಲೆಗೊಂಡಿರದಿದ್ದರೆ ನೀವು ಎಸೆಯಲಾದ ಕವಲುಬಳ್ಳಿಯಂತೆ ಒಣಗಿ ಹೋಗುವಿರಿ. ಜನರು ಅವುಗಳನ್ನು ಕೂಡಿಸಿ ಬೆಂಕಿಯೊಳಗೆ ಹಾಕುವರು ಮತ್ತು ಅವುಗಳನ್ನು ಸುಟ್ಟುಹಾಕಲಾಗುವುದು. <verse eid="JHN 15:6"/><verse number="7" style="v" sid="JHN 15:7"/>ನೀವು ನನ್ನಲ್ಲಿಯೂ ನನ್ನ ವಾಕ್ಯಗಳು ನಿಮ್ಮಲ್ಲಿಯೂ ನೆಲೆಗೊಂಡಿದ್ದರೆ ನೀವು ಬಯಸುವ ಯಾವುದನ್ನಾದರೂ ಬೇಡಿಕೊಳ್ಳಿರಿ. ಅದು ನಿಮ್ಮದಾಗುವುದು. <verse eid="JHN 15:7"/><verse number="8" style="v" sid="JHN 15:8"/>ನೀವು ಬಹಳ ಫಲಕೊಡುವುದರಿಂದಲೇ ನನ್ನ ಶಿಷ್ಯರಾಗಿರುವಿರಿ, ಇದರಿಂದ ನನ್ನ ತಂದೆಗೆ ಮಹಿಮೆಯಾಗುವುದು.<verse eid="JHN 15:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="JHN 15:9"/>“ತಂದೆಯು ನನ್ನನ್ನು ಪ್ರೀತಿಸಿದ ಹಾಗೆಯೇ ನಾನೂ ನಿಮ್ಮನ್ನು ಪ್ರೀತಿಸಿದ್ದೇನೆ. ಈಗ ನೀವು ನನ್ನ ಪ್ರೀತಿಯಲ್ಲಿ ನೆಲೆಗೊಂಡಿರಿ. <verse eid="JHN 15:9"/><verse number="10" style="v" sid="JHN 15:10"/>ನಾನು ನನ್ನ ತಂದೆಯ ಆಜ್ಞೆಗಳನ್ನು ಪಾಲಿಸಿ ಅವರ ಪ್ರೀತಿಯಲ್ಲಿ ನೆಲೆಗೊಂಡಿರುವಂತೆಯೇ ನೀವು ನನ್ನ ಆಜ್ಞೆಗಳನ್ನು ಪಾಲಿಸಿ ನಡೆದರೆ ನನ್ನ ಪ್ರೀತಿಯಲ್ಲಿ ನೆಲೆಗೊಳ್ಳುವಿರಿ. <verse eid="JHN 15:10"/><verse number="11" style="v" sid="JHN 15:11"/>ನನ್ನ ಆನಂದವು ನಿಮ್ಮಲ್ಲಿ ಇರುವಂತೆಯೂ ಆ ನಿಮ್ಮ ಆನಂದವು ಪರಿಪೂರ್ಣವಾಗುವಂತೆಯೂ ನಾನು ಇವುಗಳನ್ನು ನಿಮಗೆ ಹೇಳಿದ್ದೇನೆ. <verse eid="JHN 15:11"/><verse number="12" style="v" sid="JHN 15:12"/>ನಾನು ನಿಮ್ಮನ್ನು ಪ್ರೀತಿಸಿದ ಹಾಗೆಯೇ ನೀವು ಒಬ್ಬರನ್ನೊಬ್ಬರು ಪ್ರೀತಿಸಬೇಕೆಂಬುದು ನನ್ನ ಆಜ್ಞೆಯಾಗಿದೆ. <verse eid="JHN 15:12"/><verse number="13" style="v" sid="JHN 15:13"/>ಒಬ್ಬನು ತನ್ನ ಸ್ನೇಹಿತರಿಗಾಗಿ ತನ್ನ ಪ್ರಾಣವನ್ನೇ ಕೊಡುವ ಪ್ರೀತಿಗಿಂತ ಮಹತ್ತಾದದ್ದು ಯಾರಲ್ಲೂ ಇಲ್ಲ. <verse eid="JHN 15:13"/><verse number="14" style="v" sid="JHN 15:14"/>ನಾನು ನಿಮಗೆ ಆಜ್ಞಾಪಿಸಿದ್ದನ್ನು ಪಾಲಿಸಿದರೆ ನೀವು ನನ್ನ ಸ್ನೇಹಿತರು. <verse eid="JHN 15:14"/><verse number="15" style="v" sid="JHN 15:15"/>ಇನ್ನು ಮೇಲೆ ನಾನು ನಿಮ್ಮನ್ನು ಆಳುಗಳೆಂದು ಕರೆಯುವುದಿಲ್ಲ. ಏಕೆಂದರೆ ತನ್ನ ಧಣಿಯು ಮಾಡುವಂಥದ್ದು ಆಳಿಗೆ ತಿಳಿಯುವುದಿಲ್ಲ. ಆದರೆ ನಾನು ನಿಮ್ಮನ್ನು ಸ್ನೇಹಿತರೆಂದು ಕರೆದಿದ್ದೇನೆ. ಏಕೆಂದರೆ ನನ್ನ ತಂದೆಯಿಂದ ಕೇಳಿದ್ದನ್ನೆಲ್ಲಾ ನಾನು ನಿಮಗೆ ತಿಳಿಯಪಡಿಸಿದ್ದೇನೆ. <verse eid="JHN 15:15"/><verse number="16" style="v" sid="JHN 15:16"/>ನೀವು ನನ್ನನ್ನು ಆರಿಸಿಕೊಳ್ಳಲಿಲ್ಲ. ನಾನೇ ನಿಮ್ಮನ್ನು ಆರಿಸಿಕೊಂಡಿದ್ದೇನೆ. ನೀವು ಹೋಗಿ ಫಲಕೊಡುವಂತೆಯೂ ನಿಮ್ಮ ಫಲವು ಸ್ಥಿರವಾಗಿರುವಂತೆಯೂ ನಾನು ನಿಮ್ಮನ್ನು ನೇಮಿಸಿದ್ದೇನೆ. ಹೀಗೆ ನೀವು ನನ್ನ ಹೆಸರಿನಲ್ಲಿ ತಂದೆಯನ್ನು ಏನು ಕೇಳಿಕೊಂಡರೂ ಅವರು ನಿಮಗೆ ಕೊಡುವರು. <verse eid="JHN 15:16"/><verse number="17" style="v" sid="JHN 15:17"/>ನೀವು ಒಬ್ಬರನ್ನೊಬ್ಬರು ಪ್ರೀತಿಸಬೇಕೆಂಬುದೇ ನಾನು ನಿಮಗೆ ಕೊಡುವ ಆಜ್ಞೆಯಾಗಿದೆ.<verse eid="JHN 15:17"/></para>
  <para style="s1">ಲೋಕವು ಶಿಷ್ಯರನ್ನು ದ್ವೇಷಿಸುತ್ತದೆ</para>
  <para style="p">
    <verse number="18" style="v" sid="JHN 15:18"/>“ಲೋಕವು ನಿಮ್ಮನ್ನು ದ್ವೇಷಿಸಿದರೆ ನಿಮಗಿಂತ ಮೊದಲು ಅದು ನನ್ನನ್ನು ದ್ವೇಷಿಸಿತು ಎಂದು ನೀವು ತಿಳಿಯಿರಿ. <verse eid="JHN 15:18"/><verse number="19" style="v" sid="JHN 15:19"/>ನೀವು ಲೋಕದವರಾಗಿದ್ದರೆ ಲೋಕವು ನಿಮ್ಮನ್ನು ಪ್ರೀತಿಸುತ್ತಿತ್ತು. ಆದರೆ ನೀವು ಲೋಕದವರಲ್ಲದೆ ಇರುವುದರಿಂದಲೂ ನಾನು ಲೋಕದೊಳಗಿಂದ ನಿಮ್ಮನ್ನು ಆರಿಸಿಕೊಂಡದ್ದರಿಂದಲೂ ಲೋಕವು ನಿಮ್ಮನ್ನು ದ್ವೇಷಿಸುತ್ತದೆ. <verse eid="JHN 15:19"/><verse number="20" style="v" sid="JHN 15:20"/>‘ಧಣಿಗಿಂತ ಆಳು ದೊಡ್ಡವನಲ್ಲ,’<note caller="+" style="f"><char style="fr" closed="false">15:20 </char><char style="ft" closed="false"><char style="xt"><ref loc="JHN 13:16">ಯೋಹಾನ 13:16</ref></char></char></note> ಎಂದು ನಾನು ನಿಮಗೆ ಹೇಳಿದ ಮಾತನ್ನು ನೆನಪಿಗೆ ತಂದುಕೊಳ್ಳಿರಿ. ಅವರು ನನ್ನನ್ನು ಹಿಂಸಿಸಿದರೆ ನಿಮ್ಮನ್ನು ಸಹ ಹಿಂಸೆಪಡಿಸುವರು. ಅವರು ನನ್ನ ಮಾತನ್ನು ಅನುಸರಿಸಿದರೆ ನಿಮ್ಮ ಮಾತನ್ನು ಸಹ ಅನುಸರಿಸುವರು. <verse eid="JHN 15:20"/><verse number="21" style="v" sid="JHN 15:21"/>ಆದರೆ ಅವರು ನನ್ನನ್ನು ಕಳುಹಿಸಿದ ತಂದೆಯನ್ನು ತಿಳಿಯದಿರುವುದರಿಂದಲೇ ನನ್ನ ಹೆಸರಿನ ನಿಮಿತ್ತ ಇವುಗಳನ್ನೆಲ್ಲಾ ನಿಮಗೆ ಮಾಡುವರು. <verse eid="JHN 15:21"/><verse number="22" style="v" sid="JHN 15:22"/>ನಾನು ಬಂದು ಅವರೊಂದಿಗೆ ಮಾತನಾಡದಿದ್ದರೆ ಅವರಿಗೆ ಪಾಪವು ಇರುತ್ತಿರಲಿಲ್ಲ. ಆದರೆ ಈಗ ಅವರ ಪಾಪದ ವಿಷಯವಾಗಿ ಅವರಿಗೆ ನೆಪವಿಲ್ಲ. <verse eid="JHN 15:22"/><verse number="23" style="v" sid="JHN 15:23"/>ನನ್ನನ್ನು ದ್ವೇಷಿಸುವವರು ನನ್ನ ತಂದೆಯನ್ನು ಸಹ ದ್ವೇಷಿಸುತ್ತಾರೆ. <verse eid="JHN 15:23"/><verse number="24" style="v" sid="JHN 15:24"/>ಬೇರೆ ಯಾರೂ ಮಾಡದ ಕ್ರಿಯೆಗಳನ್ನು ನಾನು ಅವರ ನಡುವೆ ಮಾಡದೆ ಹೋಗಿದ್ದರೆ ಅವರಿಗೆ ಪಾಪವು ಇರುತ್ತಿರಲಿಲ್ಲ. ಆದರೆ ಈಗ ಅವರು ನನ್ನ ಕ್ರಿಯೆಗಳನ್ನು ಕಂಡೂ ನನ್ನನ್ನೂ ನನ್ನ ತಂದೆಯನ್ನೂ ದ್ವೇಷಮಾಡಿದ್ದಾರೆ. <verse eid="JHN 15:24"/><verse number="25" style="v" sid="JHN 15:25"/>ಆದರೆ, ‘ಅವರು ನನ್ನನ್ನು ನಿಷ್ಕಾರಣವಾಗಿ ದ್ವೇಷಮಾಡಿದರು,’ ಎಂದು ಅವರ ನಿಯಮದಲ್ಲಿ ಬರೆದಿರುವ ಮಾತು ನೆರವೇರುವಂತೆ ಹೀಗಾಯಿತು.<note caller="+" style="f"><char style="fr" closed="false">15:25 </char><char style="ft" closed="false"><char style="xt"><ref loc="PSA 35:19">ಕೀರ್ತನೆ 35:19</ref>; <ref loc="PSA 69:4">69:4</ref></char></char></note><verse eid="JHN 15:25"/></para>
  <para style="s1">ಪವಿತ್ರಾತ್ಮ ದೇವರ ಕಾರ್ಯ</para>
  <para style="p">
    <verse number="26" style="v" sid="JHN 15:26"/>“ಆದರೂ ತಂದೆಯ ಬಳಿಯಿಂದ ನಾನು ನಿಮಗೆ ಕಳುಹಿಸಿಕೊಡುವ ಆ ಸಹಾಯಕರೊಬ್ಬರು ನಿಮ್ಮ ಬಳಿಗೆ ಬರುವರು. ಆಗ ತಂದೆಯಿಂದ ಬರುವ ಆ ಸತ್ಯದ ಆತ್ಮವಾಗಿರುವವರೇ ನನ್ನ ವಿಷಯವಾಗಿ ಸಾಕ್ಷಿಕೊಡುವರು. <verse eid="JHN 15:26"/><verse number="27" style="v" sid="JHN 15:27"/>ನೀವು ಪ್ರಾರಂಭದಿಂದಲೂ ನನ್ನ ಸಂಗಡ ಇದ್ದುದರಿಂದ ನೀವು ಸಹ ನನಗೆ ಸಾಕ್ಷಿಗಳಾಗಿದ್ದೀರಿ.<verse eid="JHN 15:27"/></para>
  <chapter eid="JHN 15"/>
  <chapter number="16" style="c" sid="JHN 16"/>
  <para style="p">
    <verse number="1" style="v" sid="JHN 16:1"/>“ನೀವು ನಂಬಿಕೆಯಲ್ಲಿ ಎಡವಿಬಿದ್ದು ಹೋಗಬಾರದೆಂದು ನಾನು ಇವುಗಳನ್ನು ಹೇಳಿದ್ದೇನೆ. <verse eid="JHN 16:1"/><verse number="2" style="v" sid="JHN 16:2"/>ಜನರು ನಿಮ್ಮನ್ನು ಸಭಾಮಂದಿರದಿಂದ ಹೊರಗೆ ಹಾಕುವರು. ಆದರೆ ನಿಮ್ಮನ್ನು ಕೊಲ್ಲುವವರು ದೇವರಿಗೆ ಸೇವೆ ಸಲ್ಲಿಸುತ್ತಾರೆಂದು ಭಾವಿಸುವ ಸಮಯ ಬರುತ್ತದೆ. <verse eid="JHN 16:2"/><verse number="3" style="v" sid="JHN 16:3"/>ಅವರು ತಂದೆಯನ್ನಾಗಲಿ ನನ್ನನ್ನಾಗಲಿ ತಿಳಿಯದ ಕಾರಣ ಇವೆಲ್ಲವುಗಳನ್ನು ಮಾಡುವರು. <verse eid="JHN 16:3"/><verse number="4" style="v" sid="JHN 16:4"/>ಆದರೆ ಅವರ ಸಮಯ ಬಂದಾಗ ಇವುಗಳನ್ನು ನಾನು ನಿಮ್ಮೊಂದಿಗೆ ಮಾತನಾಡಿದ್ದೇನೆಂದು ನೀವು ಜ್ಞಾಪಕ ಮಾಡಿಕೊಳ್ಳುವಂತೆ ಮುಂಚಿತವಾಗಿಯೇ ನಿಮಗೆ ಹೇಳಿದ್ದೇನೆ. ನಾನು ನಿಮ್ಮ ಸಂಗಡ ಇದ್ದುದರಿಂದ ಇವುಗಳನ್ನು ಪ್ರಾರಂಭದಲ್ಲೇ ನಿಮಗೆ ಹೇಳಲಿಲ್ಲ. <verse eid="JHN 16:4"/><verse number="5" style="v" sid="JHN 16:5"/>ಈಗ ನನ್ನನ್ನು ಕಳುಹಿಸಿದ ತಂದೆಯ ಬಳಿಗೆ ನಾನು ಹೋಗುತ್ತೇನೆ. ನಿಮ್ಮಲ್ಲಿ ಯಾರೂ, ‘ನೀವು ಎಲ್ಲಿಗೆ ಹೋಗುತ್ತೀರಿ?’ ಎಂದು ನನ್ನನ್ನು ಕೇಳಲಿಲ್ಲ. <verse eid="JHN 16:5"/><verse number="6" style="v" sid="JHN 16:6"/>ಆದರೆ ಇವುಗಳನ್ನು ನಾನು ನಿಮಗೆ ಹೇಳಿದ್ದರಿಂದ ನಿಮ್ಮ ಹೃದಯವು ದುಃಖಭರಿತವಾಗಿದೆ. <verse eid="JHN 16:6"/><verse number="7" style="v" sid="JHN 16:7"/>ಆದರೂ ನಾನು ನಿಮಗೆ ಸತ್ಯವನ್ನು ಹೇಳುತ್ತೇನೆ, ನಾನು ಹೋಗುವುದು ನಿಮ್ಮ ಹಿತಕ್ಕಾಗಿಯೇ. ನಾನು ಹೋಗದಿದ್ದರೆ ಸಹಾಯಕರು ನಿಮ್ಮ ಬಳಿಗೆ ಬರುವುದಿಲ್ಲ. ನಾನು ಹೋದರೆ ಅವರನ್ನು ನಿಮ್ಮ ಬಳಿಗೆ ಕಳುಹಿಸುವೆನು. <verse eid="JHN 16:7"/><verse number="8" style="v" sid="JHN 16:8"/>ಆ ಸಹಾಯಕರು ಬಂದಾಗ ಪಾಪ, ನೀತಿ ಮತ್ತು ನ್ಯಾಯತೀರ್ಪಿನ ವಿಷಯಗಳಲ್ಲಿ ಲೋಕದವರಿಗೆ ಮನವರಿಕೆಯನ್ನು ಮಾಡುವರು. <verse eid="JHN 16:8"/><verse number="9" style="v" sid="JHN 16:9"/>ಜನರು ನನ್ನನ್ನು ನಂಬದೆ ಇರುವ ಕಾರಣದಿಂದ, ಪಾಪದ ವಿಷಯವಾಗಿಯೂ <verse eid="JHN 16:9"/><verse number="10" style="v" sid="JHN 16:10"/>ನಾನು ನನ್ನ ತಂದೆಯ ಬಳಿಗೆ ಹೋಗುವುದರಿಂದ ನೀವು ನನ್ನನ್ನು ಎಂದಿಗೂ ನೋಡದ ಕಾರಣದಿಂದ, ನೀತಿಯ ವಿಷಯವಾಗಿಯೂ <verse eid="JHN 16:10"/><verse number="11" style="v" sid="JHN 16:11"/>ಇಹಲೋಕಾಧಿಪತಿಗೆ ನ್ಯಾಯತೀರ್ಪಾದ ಕಾರಣದಿಂದ ನ್ಯಾಯತೀರ್ಪಿನ ವಿಷಯವಾಗಿಯೂ ಮನವರಿಕೆ ಮಾಡುವರು.<verse eid="JHN 16:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 16:12"/>“ನಾನು ನಿಮಗೆ ಹೇಳಬೇಕಾದ ವಿಷಯಗಳು ಇನ್ನೂ ಬಹಳ ಇವೆ. ಆದರೆ ನೀವು ಈಗ ಅವುಗಳನ್ನು ತಾಳಿಕೊಳ್ಳಲಾರಿರಿ. <verse eid="JHN 16:12"/><verse number="13" style="v" sid="JHN 16:13"/>ಆದರೆ ಸತ್ಯದ ಆತ್ಮ ಬಂದಾಗ ಅವರು ನಿಮ್ಮನ್ನು ಎಲ್ಲಾ ಸತ್ಯದೊಳಗೆ ನಡೆಸುವರು. ಅವರು ತಮ್ಮಷ್ಟಕ್ಕೆ ತಾವೇ ಮಾತನಾಡದೆ ತಾವು ಕೇಳಿದವುಗಳನ್ನೇ ಮಾತನಾಡುವರು. ಮುಂದೆ ನಡೆಯಲಿರುವ ವಿಷಯಗಳನ್ನು ಅವರು ನಿಮಗೆ ಪ್ರಕಟಿಸುವರು. <verse eid="JHN 16:13"/><verse number="14" style="v" sid="JHN 16:14"/>ಅವರು ನನ್ನನ್ನು ಮಹಿಮೆಪಡಿಸುವರು. ಏಕೆಂದರೆ ಅವರು ನನ್ನದರೊಳಗಿಂದ ತೆಗೆದುಕೊಂಡು ನಿಮಗೆ ಪ್ರಕಟಿಸುವರು. <verse eid="JHN 16:14"/><verse number="15" style="v" sid="JHN 16:15"/>ತಂದೆಗೆ ಇರುವುದೆಲ್ಲವೂ ನನ್ನದೆ. ಆದ್ದರಿಂದಲೇ, ‘ಪವಿತ್ರಾತ್ಮ ದೇವರು ನನ್ನದರೊಳಗಿಂದ ತೆಗೆದುಕೊಂಡು ನಿಮಗೆ ಪ್ರಕಟಿಸುವರು,’ ಎಂದು ನಾನು ಹೇಳಿದೆನು.”<verse eid="JHN 16:15"/></para>
  <para style="s1">ಶಿಷ್ಯರ ದುಃಖವು ಆನಂದವಾಗಿ ಮಾರ್ಪಡುವುದು</para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 16:16"/>“ಸ್ವಲ್ಪ ಕಾಲವಾದ ಮೇಲೆ ನೀವು ನನ್ನನ್ನು ಕಾಣುವುದಿಲ್ಲ. ಅನಂತರ ಸ್ವಲ್ಪ ಕಾಲವಾದ ಮೇಲೆ ನೀವು ಪುನಃ ನನ್ನನ್ನು ಕಾಣುವಿರಿ,” ಎಂದರು.<verse eid="JHN 16:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="JHN 16:17"/>ಆಗ ಅವರ ಶಿಷ್ಯರಲ್ಲಿ ಕೆಲವರು, “ಇವರು ನಮಗೆ ಹೇಳುವುದೇನು? ‘ಸ್ವಲ್ಪಕಾಲ ನೀವು ನನ್ನನ್ನು ಕಾಣುವುದಿಲ್ಲ ಮತ್ತು ಸ್ವಲ್ಪ ಕಾಲವಾದ ಮೇಲೆ ನೀವು ಪುನಃ ನನ್ನನ್ನು ಕಾಣುವಿರಿ ಏಕೆಂದರೆ ನಾನು ತಂದೆಯ ಬಳಿಗೆ ಹೋಗುತ್ತೇನೆ,’ ಎನ್ನುತ್ತಾರಲ್ಲಾ? <verse eid="JHN 16:17"/><verse number="18" style="v" sid="JHN 16:18"/>ಇವರು ಹೇಳುವುದರ ಅರ್ಥವೇನು? ‘ಸ್ವಲ್ಪಕಾಲ’ ಎಂದು ಹೇಳುತ್ತಾರಲ್ಲ? ಇವರು ಏನು ಮಾತನಾಡುತ್ತಾರೋ ನಮಗೆ ತಿಳಿಯದು,” ಎಂದು ತಮ್ಮತಮ್ಮೊಳಗೆ ಮಾತನಾಡಿಕೊಳ್ಳುತ್ತಿದ್ದರು.<verse eid="JHN 16:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="JHN 16:19"/>ಶಿಷ್ಯರು ತಮ್ಮ ಬಗ್ಗೆ ಪ್ರಶ್ನಿಸಬಯಸುತ್ತಿದ್ದಾರೆಂದು ತಿಳಿದು ಯೇಸು, “ಸ್ವಲ್ಪ ಕಾಲವಾದ ಮೇಲೆ ನೀವು ನನ್ನನ್ನು ಕಾಣುವುದಿಲ್ಲ, ‘ಸ್ವಲ್ಪ ಕಾಲವಾದ ಮೇಲೆ ನೀವು ಪುನಃ ನನ್ನನ್ನು ಕಾಣುವಿರಿ ಎಂದು ನಾನು ನಿಮಗೆ ಹೇಳಿದ್ದರ ಕುರಿತಾಗಿ ನೀವು ಒಬ್ಬರಿಗೊಬ್ಬರು ವಿಚಾರಿಸಿಕೊಳ್ಳುತ್ತೀರೋ?’ <verse eid="JHN 16:19"/><verse number="20" style="v" sid="JHN 16:20"/>ನಾನು ನಿಮಗೆ ನಿಜನಿಜವಾಗಿ ಹೇಳುತ್ತೇನೆ, ನೀವು ಅತ್ತು ಗೋಳಾಡುವಿರಿ. ಆದರೆ ಲೋಕವು ಸಂತೋಷಿಸುವುದು; ನೀವು ದುಃಖಿಸುವಿರಿ ಆದರೆ ನಿಮ್ಮ ದುಃಖವು ಆನಂದವಾಗಿ ಮಾರ್ಪಡುವುದು. <verse eid="JHN 16:20"/><verse number="21" style="v" sid="JHN 16:21"/>ಒಬ್ಬ ಸ್ತ್ರೀಗೆ ಪ್ರಸವ ಗಳಿಗೆ ಬಂದಾಗ ದುಃಖವಿರುವುದು. ಆದರೆ ಆಕೆಯು ಮಗುವನ್ನು ಹೆತ್ತಾಗ ಈ ಲೋಕದೊಳಗೆ ಒಂದು ಮಗು ಹುಟ್ಟಿತೆಂದು ಆನಂದದಿಂದ ಆ ವೇದನೆಯನ್ನು ಆಕೆಯು ಇನ್ನು ನೆನಪಿಗೆ ತಂದುಕೊಳ್ಳುವುದಿಲ್ಲ. <verse eid="JHN 16:21"/><verse number="22" style="v" sid="JHN 16:22"/>ಈಗ ನಿಮಗೆ ನಿಜವಾಗಿಯೂ ದುಃಖವಿದೆ. ಆದರೆ ನಾನು ನಿಮ್ಮನ್ನು ತಿರುಗಿ ಕಾಣುವೆನು; ಆಗ ನಿಮ್ಮ ಹೃದಯವು ಉಲ್ಲಾಸಿಸುವುದು. ನಿಮ್ಮ ಆನಂದವನ್ನು ನಿಮ್ಮಿಂದ ಯಾರೂ ತೆಗೆಯುವುದಿಲ್ಲ. <verse eid="JHN 16:22"/><verse number="23" style="v" sid="JHN 16:23"/>ಆ ದಿನದಲ್ಲಿ ನೀವು ನನ್ನನ್ನು ಏನೂ ಪ್ರಶ್ನಿಸುವುದಿಲ್ಲ. ನಾನು ನಿಮಗೆ ನಿಜನಿಜವಾಗಿ ಹೇಳುತ್ತೇನೆ, ನೀವು ನನ್ನ ಹೆಸರಿನಲ್ಲಿ ತಂದೆಯನ್ನು ಏನು ಕೇಳಿಕೊಂಡರೂ ಅವರು ನಿಮಗೆ ಕೊಡುವರು. <verse eid="JHN 16:23"/><verse number="24" style="v" sid="JHN 16:24"/>ನೀವು ಇದುವರೆಗೆ ನನ್ನ ಹೆಸರಿನಲ್ಲಿ ಏನೂ ಕೇಳಿಕೊಳ್ಳಲಿಲ್ಲ. ಕೇಳಿರಿ, ನೀವು ಪಡೆದುಕೊಳ್ಳುವಿರಿ. ಆಗ ನಿಮ್ಮ ಆನಂದವು ಪರಿಪೂರ್ಣವಾಗಿರುವುದು.<verse eid="JHN 16:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 16:25"/>“ಇವುಗಳನ್ನು ನಾನು ಸೂಚಕವಾಗಿ ನಿಮ್ಮೊಡನೆ ಮಾತನಾಡಿದ್ದೇನೆ. ನಾನು ಇನ್ನು ಸಾಮ್ಯಗಳಿಂದ ಮಾತನಾಡದೆ ತಂದೆಯ ವಿಷಯವಾಗಿ ನಿಮಗೆ ಸ್ಪಷ್ಟವಾಗಿ ಪ್ರಕಟಿಸುವ ಗಳಿಗೆಯು ಬರುತ್ತದೆ. <verse eid="JHN 16:25"/><verse number="26" style="v" sid="JHN 16:26"/>ಆ ದಿವಸದಲ್ಲಿ ನೀವು ನನ್ನ ಹೆಸರಿನಲ್ಲಿ ಕೇಳಿಕೊಳ್ಳುವಿರಿ. ನಿಮ್ಮ ವಿಷಯವಾಗಿ ತಂದೆಯನ್ನು ಕೇಳಿಕೊಳ್ಳುವೆನೆಂದು ನಾನು ನಿಮಗೆ ಹೇಳುವುದಿಲ್ಲ. <verse eid="JHN 16:26"/><verse number="27" style="v" sid="JHN 16:27"/>ಏಕೆಂದರೆ ನೀವು ನನ್ನನ್ನು ಪ್ರೀತಿಸಿ ನಾನು ದೇವರಿಂದ ಹೊರಟು ಬಂದವನೆಂದು ನಂಬಿದ್ದರಿಂದ ತಂದೆಯು ತಾವೇ ನಿಮ್ಮನ್ನು ಪ್ರೀತಿಸುತ್ತಾರೆ. <verse eid="JHN 16:27"/><verse number="28" style="v" sid="JHN 16:28"/>ನಾನು ತಂದೆಯಿಂದ ಹೊರಟು ಈ ಲೋಕಕ್ಕೆ ಬಂದಿದ್ದೇನೆ. ತಿರುಗಿ ಈ ಲೋಕವನ್ನು ಬಿಟ್ಟು ತಂದೆಯ ಬಳಿಗೆ ಹೋಗುತ್ತಿದ್ದೇನೆ,” ಎಂದರು.<verse eid="JHN 16:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="JHN 16:29"/>ಆಗ ಶಿಷ್ಯರು ಯೇಸುವಿಗೆ, “ಇಗೋ, ಈಗ ನೀವು ಸಾಮ್ಯಗಳಿಂದ ಮಾತನಾಡದೆ ಸ್ಪಷ್ಟವಾಗಿಯೇ ಮಾತನಾಡುತ್ತಿದ್ದೀರಿ. <verse eid="JHN 16:29"/><verse number="30" style="v" sid="JHN 16:30"/>ನೀವು ಎಲ್ಲಾ ತಿಳಿದವರೆಂದೂ ಯಾರೂ ನಿಮ್ಮನ್ನು ಪ್ರಶ್ನಿಸುವುದು ಅಗತ್ಯವಿಲ್ಲವೆಂದು ಈಗ ನಮಗೆ ತಿಳಿಯಿತು. ಆದ್ದರಿಂದ ನೀವು ದೇವರಿಂದ ಹೊರಟು ಬಂದವರೆಂದು ನಾವು ನಂಬುತ್ತೇವೆ,” ಎಂದರು.<verse eid="JHN 16:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="JHN 16:31"/>ಅದಕ್ಕೆ ಯೇಸು ಅವರಿಗೆ, “ಈಗ ನೀವು ನಂಬುತ್ತೀರೋ?” <verse eid="JHN 16:31"/><verse number="32" style="v" sid="JHN 16:32"/>ಇಗೋ, ನಿಮ್ಮಲ್ಲಿ ಪ್ರತಿಯೊಬ್ಬನು ನಿಮ್ಮ ನಿಮ್ಮ ಮನೆಗೆ ಚದುರಿಹೋಗಿ ನನ್ನನ್ನು ಒಬ್ಬಂಟಿಗನನ್ನಾಗಿ ಬಿಡುವ ಗಳಿಗೆ ಬರುತ್ತದೆ. ಹೌದು, ಈಗಲೇ ಬಂದಿದೆ. ಆದರೂ ನಾನು ಒಬ್ಬಂಟಿಗನಲ್ಲ. ಏಕೆಂದರೆ ತಂದೆ ನನ್ನ ಸಂಗಡ ಇದ್ದಾರೆ.<verse eid="JHN 16:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="JHN 16:33"/>“ನನ್ನಲ್ಲಿ ನಿಮಗೆ ಸಮಾಧಾನ ಇರುವಂತೆ ಇವುಗಳನ್ನು ನಾನು ನಿಮ್ಮೊಂದಿಗೆ ಮಾತನಾಡಿದ್ದೇನೆ. ಲೋಕದಲ್ಲಿ ನಿಮಗೆ ಸಂಕಟವಿರುವದು. ಆದರೆ ಧೈರ್ಯವಾಗಿರಿ, ನಾನು ಲೋಕವನ್ನು ಜಯಿಸಿದ್ದೇನೆ,” ಎಂದರು.<verse eid="JHN 16:33"/></para>
  <chapter eid="JHN 16"/>
  <chapter number="17" style="c" sid="JHN 17"/>
  <para style="s1">ಯೇಸು ಮಹಿಮೆಗಾಗಿ ಪ್ರಾರ್ಥಿಸಿದ್ದು</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 17:1"/>ಯೇಸು ಇಷ್ಟೆಲ್ಲಾ ಮಾತನಾಡಿ ಆಕಾಶದ ಕಡೆಗೆ ಕಣ್ಣೆತ್ತಿ ನೋಡಿ,</para>
  <para style="pm" vid="JHN 17:1">“ತಂದೆಯೇ, ಸಮಯ ಬಂದಿದೆ. ನಿಮ್ಮ ಪುತ್ರನು ನಿಮ್ಮನ್ನು ಮಹಿಮೆಪಡಿಸುವುದಕ್ಕಾಗುವಂತೆ ಆತನನ್ನು ಮಹಿಮೆಪಡಿಸಿರಿ. <verse eid="JHN 17:1"/><verse number="2" style="v" sid="JHN 17:2"/>ನೀವು ಎಲ್ಲರಿಗೂ ನಿತ್ಯಜೀವವನ್ನು ಕೊಡಬೇಕೆಂದು ಆತನಿಗೆ ಎಲ್ಲಾ ಮನುಷ್ಯರ ಮೇಲೆ ಅಧಿಕಾರವನ್ನು ಕೊಟ್ಟಿರುವಿರಿ. <verse eid="JHN 17:2"/><verse number="3" style="v" sid="JHN 17:3"/>ಏಕೈಕ ಸತ್ಯ ದೇವರಾಗಿರುವ ನಿಮ್ಮನ್ನೂ ನೀವು ಕಳುಹಿಸಿಕೊಟ್ಟ ಯೇಸು ಕ್ರಿಸ್ತನನ್ನೂ ತಿಳಿಯುವುದೇ ನಿತ್ಯಜೀವ. <verse eid="JHN 17:3"/><verse number="4" style="v" sid="JHN 17:4"/>ಮಾಡಬೇಕೆಂದು ನೀವು ನನಗೆ ಕೊಟ್ಟ ಕೆಲಸವನ್ನು ನಾನು ನೆರವೇರಿಸಿ ಭೂಮಿಯ ಮೇಲೆ ನಾನು ನಿಮ್ಮನ್ನು ಮಹಿಮೆಪಡಿಸಿದ್ದೇನೆ. <verse eid="JHN 17:4"/><verse number="5" style="v" sid="JHN 17:5"/>ತಂದೆಯೇ, ಲೋಕವು ಉಂಟಾಗುವದಕ್ಕಿಂತ ಮುಂಚೆ ನಿಮ್ಮೊಡನೆ ನನಗಿದ್ದ ಮಹಿಮೆಯಿಂದ ಈಗ ನೀವು ನನ್ನನ್ನು ಮಹಿಮೆಪಡಿಸಿರಿ.<verse eid="JHN 17:5"/></para>
  <para style="s1">ಯೇಸು ಶಿಷ್ಯರಿಗಾಗಿ ಪ್ರಾರ್ಥಿಸಿದ್ದು</para>
  <para style="pm">
    <verse number="6" style="v" sid="JHN 17:6"/>“ಲೋಕದೊಳಗಿಂದ ನೀವು ನನಗೆ ಕೊಟ್ಟ ಈ ನನ್ನ ಶಿಷ್ಯರಿಗೆ ನಾನು ನಿಮ್ಮ ಹೆಸರನ್ನು ಪ್ರಕಟಪಡಿಸಿದ್ದೇನೆ. ಇವರು ನಿಮ್ಮವರಾಗಿದ್ದರು. ನೀವು ಇವರನ್ನು ನನಗೆ ಕೊಟ್ಟಿದ್ದೀರಿ. ಇವರು ನಿಮ್ಮ ವಾಕ್ಯವನ್ನು ಕೈಗೊಂಡಿದ್ದಾರೆ. <verse eid="JHN 17:6"/><verse number="7" style="v" sid="JHN 17:7"/>ನೀವು ನನಗೆ ಕೊಟ್ಟಿದ್ದೆಲ್ಲವೂ ನಿಮ್ಮಿಂದಲೇ ಬಂದಿವೆ ಎಂದು ಈಗ ಇವರು ತಿಳಿದುಕೊಂಡಿದ್ದಾರೆ. <verse eid="JHN 17:7"/><verse number="8" style="v" sid="JHN 17:8"/>ಏಕೆಂದರೆ ನೀವು ನನಗೆ ಕೊಟ್ಟ ಮಾತುಗಳನ್ನು ನಾನು ಇವರಿಗೆ ಕೊಟ್ಟಿದ್ದೇನೆ, ಇವರು ಅಂಗೀಕರಿಸಿದ್ದಾರೆ ಮತ್ತು ನಾನು ನಿಮ್ಮ ಬಳಿಯಿಂದ ಬಂದವನೆಂದು ಇವರು ನಿಶ್ಚಯವಾಗಿ ತಿಳಿದು, ನೀವೇ ನನ್ನನ್ನು ಕಳುಹಿಸಿದ್ದೀರಿ, ಎಂದು ನಂಬಿದ್ದಾರೆ. <verse eid="JHN 17:8"/><verse number="9" style="v" sid="JHN 17:9"/>ನಾನು ಇವರಿಗಾಗಿಯೇ ಬೇಡಿಕೊಳ್ಳುತ್ತೇನೆ. ನೀವು ನನಗೆ ಕೊಟ್ಟವರಿಗಾಗಿಯೇ ಹೊರತು ನಾನು ಲೋಕಕ್ಕಾಗಿ ಬೇಡಿಕೊಳ್ಳುವುದಿಲ್ಲ. ಏಕೆಂದರೆ ಇವರು ನಿಮ್ಮವರು. <verse eid="JHN 17:9"/><verse number="10" style="v" sid="JHN 17:10"/>ನನ್ನದೆಲ್ಲವೂ ನಿಮ್ಮದೇ. ನಿಮ್ಮದೆಲ್ಲವೂ ನನ್ನದೇ. ಇವರಿಂದ ನನಗೆ ಮಹಿಮೆ ಉಂಟಾಗಿದೆ. <verse eid="JHN 17:10"/><verse number="11" style="v" sid="JHN 17:11"/>ಇನ್ನು ಮೇಲೆ ನಾನು ಲೋಕದಲ್ಲಿ ಇರುವುದಿಲ್ಲ. ಇವರಾದರೋ ಲೋಕದಲ್ಲಿರುತ್ತಾರೆ. ನಾನು ನಿಮ್ಮ ಬಳಿಗೆ ಬರುತ್ತೇನೆ. ಪರಿಶುದ್ಧ ತಂದೆಯೇ, ನಾವು ಒಂದಾಗಿರುವಂತೆಯೇ ಇವರೂ ಒಂದಾಗಿರಬೇಕೆಂದು ನೀವು ನನಗೆ ಕೊಟ್ಟ ನಿಮ್ಮ ಹೆಸರಿನ ಶಕ್ತಿಯಿಂದ ಇವರನ್ನು ಕಾಪಾಡಿರಿ. <verse eid="JHN 17:11"/><verse number="12" style="v" sid="JHN 17:12"/>ನಾನು ಇವರೊಡನೆ ಇದ್ದಾಗ ನೀವು ನನಗೆ ಕೊಟ್ಟ ನಿಮ್ಮ ಹೆಸರಿನಲ್ಲಿ ಇವರನ್ನು ಕಾಪಾಡಿ ಸಂರಕ್ಷಿಸಿದೆನು. ಪವಿತ್ರ ವಾಕ್ಯವು ನೆರವೇರುವಂತೆ ಆ ನಾಶದ ಮಗನೇ ಹೊರತು ಇವರಲ್ಲಿ ಒಬ್ಬನೂ ನಾಶವಾಗಲಿಲ್ಲ.<verse eid="JHN 17:12"/></para>
  <para style="pm">
    <verse number="13" style="v" sid="JHN 17:13"/>“ಈಗ ನಾನು ನಿಮ್ಮ ಬಳಿಗೆ ಬರುತ್ತೇನೆ. ನನ್ನ ಆನಂದವು ಅವರಲ್ಲಿ ಪರಿಪೂರ್ಣವಾಗುವಂತೆ ನಾನು ಲೋಕದಲ್ಲಿ ಇದ್ದು ಇವೆಲ್ಲವನ್ನು ಮಾತನಾಡುತ್ತೇನೆ. <verse eid="JHN 17:13"/><verse number="14" style="v" sid="JHN 17:14"/>ನಾನು ನಿಮ್ಮ ವಾಕ್ಯವನ್ನು ಇವರಿಗೆ ಕೊಟ್ಟಿದ್ದೇನೆ. ಇವರು ನನ್ನಂತೆ ಲೋಕದವರಲ್ಲದ ಕಾರಣ ಲೋಕವು ಇವರನ್ನು ದ್ವೇಷಿಸುತ್ತದೆ. <verse eid="JHN 17:14"/><verse number="15" style="v" sid="JHN 17:15"/>ನೀವು ಇವರನ್ನು ಲೋಕದಿಂದ ತೆಗೆಯಬೇಕೆಂದು ಬೇಡಿಕೊಳ್ಳದೆ ಇವರನ್ನು ಕೆಡುಕನಿಂದ<note caller="+" style="f"><char style="fr" closed="false">17:15 </char><char style="fq" closed="false">ಕೆಡುಕನಿಂದ </char><char style="ft" closed="false">ಇದರ ಅರ್ಥ </char><char style="fqa" closed="false">ಸೈತಾನನಿಂದ</char></note> ಕಾಪಾಡಬೇಕೆಂದು ನಾನು ಬೇಡಿಕೊಳ್ಳುತ್ತೇನೆ. <verse eid="JHN 17:15"/><verse number="16" style="v" sid="JHN 17:16"/>ನಾನು ಲೋಕದವನಲ್ಲದೆ ಇರುವಂತೆ ಇವರೂ ಲೋಕದವರಲ್ಲ. <verse eid="JHN 17:16"/><verse number="17" style="v" sid="JHN 17:17"/>ನೀವು ಸತ್ಯದಿಂದ ಇವರನ್ನು ಸಮರ್ಪಿಸಿರಿ. ನಿಮ್ಮ ವಾಕ್ಯವೇ ಸತ್ಯವು. <verse eid="JHN 17:17"/><verse number="18" style="v" sid="JHN 17:18"/>ನೀವು ನನ್ನನ್ನು ಲೋಕಕ್ಕೆ ಕಳುಹಿಸಿದಂತೆಯೇ ನಾನು ಸಹ ಇವರನ್ನು ಲೋಕಕ್ಕೆ ಕಳುಹಿಸಿದ್ದೇನೆ. <verse eid="JHN 17:18"/><verse number="19" style="v" sid="JHN 17:19"/>ಇವರು ನಿಜವಾಗಿಯೂ ಸಮರ್ಪಿತರಾಗಬೇಕೆಂದು ನನ್ನನ್ನು ನಾನೇ ಇವರಿಗೋಸ್ಕರ ಸಮರ್ಪಿಸಿಕೊಳ್ಳುತ್ತೇನೆ.<verse eid="JHN 17:19"/></para>
  <para style="s1">ಯೇಸು ಎಲ್ಲಾ ವಿಶ್ವಾಸಿಗಳಿಗಾಗಿ ಪ್ರಾರ್ಥಿಸಿದ್ದು</para>
  <para style="pm">
    <verse number="20" style="v" sid="JHN 17:20"/>“ಆದರೆ ಇವರಿಗಾಗಿ ಮಾತ್ರವಲ್ಲದೆ ಇವರ ವಾಕ್ಯದಿಂದ ನನ್ನಲ್ಲಿ ನಂಬುವವರಿಗಾಗಿಯೂ ಬೇಡಿಕೊಳ್ಳುತ್ತೇನೆ. <verse eid="JHN 17:20"/><verse number="21" style="v" sid="JHN 17:21"/>ತಂದೆಯೇ, ನೀವು ನನ್ನನ್ನು ಕಳುಹಿಸಿದ್ದೀರಿ ಎಂದು ಲೋಕವು ನಂಬುವುದಕ್ಕಾಗಿ ಅವರೆಲ್ಲರೂ ಒಂದಾಗಿರಬೇಕೆಂತಲೂ ತಂದೆಯೇ, ನೀವು ನನ್ನಲ್ಲಿಯೂ ನಾನು ನಿಮ್ಮಲ್ಲಿಯೂ ಇರುವ ಹಾಗೆಯೇ ಅವರು ಸಹ ನಮ್ಮಲ್ಲಿ ಒಂದಾಗಿರಬೇಕೆಂತಲೂ ಬೇಡಿಕೊಳ್ಳುತ್ತೇನೆ. <verse eid="JHN 17:21"/><verse number="22" style="v" sid="JHN 17:22"/>ನಾವು ಒಂದಾಗಿರುವ ಹಾಗೆಯೇ ಇವರೂ ಒಂದಾಗಿರುವಂತೆ ನೀವು ನನಗೆ ಕೊಟ್ಟ ಮಹಿಮೆಯನ್ನು ನಾನು ಇವರಿಗೆ ಕೊಟ್ಟಿದ್ದೇನೆ. <verse eid="JHN 17:22"/><verse number="23" style="v" sid="JHN 17:23"/>ಹೀಗೆ ನಾನು ಇವರಲ್ಲಿಯೂ ನೀವು ನನ್ನಲ್ಲಿಯೂ ಇರುವಂತೆ ಇವರೂ ಐಕ್ಯತೆಯಲ್ಲಿ ಪರಿಪೂರ್ಣವಾಗಿರಲಿ. ಆಗ ನೀವು ನನ್ನನ್ನು ಕಳುಹಿಸಿದ್ದೀರಿ ಎಂದೂ ನನ್ನನ್ನು ಪ್ರೀತಿಸಿದಂತೆ ಇವರನ್ನು ನೀವು ಪ್ರೀತಿಸಿದ್ದೀರಿ ಎಂದೂ ಲೋಕವು ತಿಳಿದುಕೊಳ್ಳುವುದು.<verse eid="JHN 17:23"/></para>
  <para style="pm">
    <verse number="24" style="v" sid="JHN 17:24"/>“ತಂದೆಯೇ, ನೀವು ನನಗೆ ಕೊಟ್ಟವರು ನಾನಿರುವಲ್ಲಿಯೇ ನನ್ನೊಂದಿಗೆ ಇದ್ದುಕೊಂಡು ಜಗದುತ್ಪತ್ತಿಗೆ ಮುಂಚೆ ನೀವು ನನ್ನನ್ನು ಪ್ರೀತಿಸಿ ನನಗೆ ಕೊಟ್ಟಿರುವ ಮಹಿಮೆಯನ್ನು ಇವರು ಕಾಣಬೇಕೆಂದು ನಾನು ಅಪೇಕ್ಷಿಸುತ್ತೇನೆ.<verse eid="JHN 17:24"/></para>
  <para style="pm">
    <verse number="25" style="v" sid="JHN 17:25"/>“ನೀತಿಯುಳ್ಳ ತಂದೆಯೇ, ಲೋಕವು ನಿಜವಾಗಿಯೂ ನಿಮ್ಮನ್ನು ತಿಳಿಯಲಿಲ್ಲ. ಆದರೆ ನಾನು ನಿಮ್ಮನ್ನು ತಿಳಿದಿದ್ದೇನೆ ಮತ್ತು ನೀವೇ ನನ್ನನ್ನು ಕಳುಹಿಸಿದ್ದೀರಿ ಎಂದು ಇವರು ತಿಳಿದಿದ್ದಾರೆ. <verse eid="JHN 17:25"/><verse number="26" style="v" sid="JHN 17:26"/>ನೀವು ನನ್ನನ್ನು ಪ್ರೀತಿಸಿದಂಥ ಪ್ರೀತಿಯು ಇವರಲ್ಲಿ ಇರಬೇಕೆಂತಲೂ ನಾನು ಅವರಲ್ಲಿ ಇರುವಂತೆಯೂ ನಾನು ಅವರಿಗೆ ನಿಮ್ಮ ಹೆಸರನ್ನು ತಿಳಿಸಿದ್ದೇನೆ, ಇನ್ನೂ ತಿಳಿಸುವೆನು,” ಎಂದರು.<verse eid="JHN 17:26"/></para>
  <chapter eid="JHN 17"/>
  <chapter number="18" style="c" sid="JHN 18"/>
  <para style="s1">ಯೇಸುವಿನ ಬಂಧನ</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 18:1"/>ಯೇಸು ಪ್ರಾರ್ಥನೆಯನ್ನು ಮುಗಿಸಿದ ಮೇಲೆ ತಮ್ಮ ಶಿಷ್ಯರೊಂದಿಗೆ ಕೆದ್ರೋನ್ ಹಳ್ಳದ ಆಚೆಗೆ ಹೋದರು. ಮತ್ತೊಂದು ಕಡೆ ಇರುವ ತೋಟದೊಳಗೆ ಯೇಸು ಮತ್ತು ಅವರ ಶಿಷ್ಯರು ಪ್ರವೇಶಿಸಿದರು.<verse eid="JHN 18:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="JHN 18:2"/>ಅವರನ್ನು ಹಿಡಿದುಕೊಡಲಿದ್ದ ಯೂದನಿಗೂ ಆ ಸ್ಥಳವು ಗೊತ್ತಿತ್ತು. ಏಕೆಂದರೆ ಅನೇಕ ಸಾರಿ ಯೇಸು ತಮ್ಮ ಶಿಷ್ಯರೊಂದಿಗೆ ಅಲ್ಲಿ ಸೇರುತ್ತಿದ್ದರು. <verse eid="JHN 18:2"/><verse number="3" style="v" sid="JHN 18:3"/>ಯೂದನು ಸೈನಿಕರ ತಂಡವನ್ನೂ ಮುಖ್ಯಯಾಜಕರಿಂದ ಮತ್ತು ಫರಿಸಾಯರಿಂದ ಕಾವಲಾಳುಗಳನ್ನೂ ಕರೆದುಕೊಂಡು ತೋಟಕ್ಕೆ ಬಂದನು. ಸೈನಿಕರು ಮತ್ತು ಕಾವಲಾಳುಗಳು ದೀಪಗಳನ್ನು, ಪಂಜುಗಳನ್ನು ಮತ್ತು ಆಯುಧಗಳನ್ನು ಹಿಡಿದುಕೊಂಡಿದ್ದರು.<verse eid="JHN 18:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="JHN 18:4"/>ಆಗ ಯೇಸು ತಮಗೆ ಸಂಭವಿಸುವುದನ್ನೆಲ್ಲಾ ತಿಳಿದುಕೊಂಡು ಮುಂದಕ್ಕೆ ಹೋಗಿ ಅವರಿಗೆ, “ನೀವು ಯಾರನ್ನು ಹುಡುಕುತ್ತೀರಿ?” ಎಂದು ಕೇಳಲು,<verse eid="JHN 18:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="JHN 18:5"/>ಅವರು ಯೇಸುವಿಗೆ, “ನಜರೇತಿನ ಯೇಸುವನ್ನು,” ಎಂದರು.</para>
  <para style="p" vid="JHN 18:5">ಅದಕ್ಕೆ ಯೇಸು ಅವರಿಗೆ, “ನಾನೇ ಆತನು,” ಎಂದರು. ಅವರನ್ನು ಹಿಡಿದುಕೊಡಲಿದ್ದ ಯೂದನು ಸಹ ಅವರೊಂದಿಗೆ ನಿಂತಿದ್ದನು. <verse eid="JHN 18:5"/><verse number="6" style="v" sid="JHN 18:6"/>ಯೇಸು ಅವರಿಗೆ, “ನಾನೇ ಆತನು,” ಎಂದು ಹೇಳಿದಾಗ ಅವರು ಹಿಂದಕ್ಕೆ ಸರಿದು ನೆಲಕ್ಕೆ ಬಿದ್ದರು.<verse eid="JHN 18:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="JHN 18:7"/>ಆಗ ಯೇಸು ಅವರಿಗೆ ತಿರುಗಿ, “ನೀವು, ಯಾರನ್ನು ಹುಡುಕುತ್ತೀರಿ?” ಎಂದು ಕೇಳಲು,</para>
  <para style="p" vid="JHN 18:7">ಅವರು, “ನಜರೇತಿನ ಯೇಸುವನ್ನು,” ಎಂದರು.<verse eid="JHN 18:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="JHN 18:8"/>ಅದಕ್ಕೆ ಯೇಸು, “ನಾನೇ ಆತನು ಎಂದು ನಿಮಗೆ ಹೇಳಿದೆನಲ್ಲಾ, ನೀವು ನನ್ನನ್ನೇ ಹುಡುಕುವುದಾದರೆ ಇವರನ್ನು ಬಿಟ್ಟುಬಿಡಿರಿ,” ಎಂದರು. <verse eid="JHN 18:8"/><verse number="9" style="v" sid="JHN 18:9"/>ಹೀಗೆ, “ನೀನು ನನಗೆ ಕೊಟ್ಟವರಲ್ಲಿ ಯಾರನ್ನೂ ನಾನು ಕಳೆದುಕೊಳ್ಳಲಿಲ್ಲ,”<note caller="+" style="f"><char style="fr" closed="false">18:9 </char><char style="ft" closed="false"><char style="xt"><ref loc="JHN 6:39">ಯೋಹಾನ 6:39</ref></char></char></note> ಎಂದು ತಾವೇ ಹೇಳಿದ ಮಾತು ನೆರವೇರಿತು.<verse eid="JHN 18:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="JHN 18:10"/>ಆಗ ಸೀಮೋನ ಪೇತ್ರನು ತನ್ನಲ್ಲಿದ್ದ ಕತ್ತಿಯನ್ನು ತೆಗೆದು ಮಹಾಯಾಜಕನ ಆಳನ್ನು ಹೊಡೆದು ಅವನ ಬಲಗಿವಿಯನ್ನು ಕತ್ತರಿಸಿದನು. ಆ ಸೇವಕನ ಹೆಸರು ಮಲ್ಕ.<verse eid="JHN 18:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="JHN 18:11"/>ಆಗ ಯೇಸು ಪೇತ್ರನಿಗೆ, “ನಿನ್ನ ಕತ್ತಿಯನ್ನು ಒರೆಯಲ್ಲಿ ಹಾಕು! ನನ್ನ ತಂದೆಯು ನನಗೆ ಕೊಟ್ಟ ಪಾತ್ರೆಯಿಂದ ನಾನು ಕುಡಿಯಬಾರದೋ?” ಎಂದು ಹೇಳಿದರು.<verse eid="JHN 18:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 18:12"/>ತರುವಾಯ ಸೈನಿಕರೂ ಸೈನ್ಯಾಧಿಕಾರಿಯೂ ಯೆಹೂದ್ಯರ ಕಾವಲಾಳುಗಳೂ ಯೇಸುವನ್ನು ಹಿಡಿದು ಕಟ್ಟಿದರು. <verse eid="JHN 18:12"/><verse number="13" style="v" sid="JHN 18:13"/>ಅವರನ್ನು ಮೊದಲು ಅನ್ನನ ಬಳಿಗೆ ಕರೆದುಕೊಂಡು ಹೋದರು. ಅವನು ಆ ವರ್ಷದ ಮಹಾಯಾಜಕನಾಗಿದ್ದ ಕಾಯಫನ ಮಾವನಾಗಿದ್ದನು. <verse eid="JHN 18:13"/><verse number="14" style="v" sid="JHN 18:14"/>“ಜನರಿಗೋಸ್ಕರ ಒಬ್ಬ ಮನುಷ್ಯನು ಸಾಯುವುದು ಹಿತ,” ಎಂದು ಯೆಹೂದ್ಯರಿಗೆ ಸಲಹೆ ಕೊಟ್ಟ ಕಾಯಫನು ಇವನೇ.<verse eid="JHN 18:14"/></para>
  <para style="s1">ಪೇತ್ರನು ಮೊದಲನೆಯ ಸಾರಿ ಅಲ್ಲಗಳೆದದ್ದು</para>
  <para style="p">
    <verse number="15" style="v" sid="JHN 18:15"/>ಸೀಮೋನ ಪೇತ್ರನು ಮತ್ತು ಇನ್ನೊಬ್ಬ ಶಿಷ್ಯನು ಯೇಸುವನ್ನು ಹಿಂಬಾಲಿಸಿದರು. ಆ ಶಿಷ್ಯನು ಮಹಾಯಾಜಕನಿಗೆ ಪರಿಚಯವಿದ್ದುದರಿಂದ ಯೇಸುವಿನ ಸಂಗಡ ಮಹಾಯಾಜಕನ ಅಂಗಳದೊಳಗೆ ಹೋದನು. <verse eid="JHN 18:15"/><verse number="16" style="v" sid="JHN 18:16"/>ಆದರೆ ಪೇತ್ರನು ಬಾಗಿಲಿನ ಬಳಿಯಲ್ಲಿ ಹೊರಗೆ ನಿಂತಿದ್ದನು. ಮಹಾಯಾಜಕನಿಗೆ ಪರಿಚಯವಿದ್ದ ಆ ಇನ್ನೊಬ್ಬ ಶಿಷ್ಯನು ಹೊರಗೆ ಬಂದು ದ್ವಾರಪಾಲಕಿಗೆ ಹೇಳಿ ಪೇತ್ರನನ್ನು ಒಳಗೆ ಕರೆದುಕೊಂಡು ಬಂದನು.<verse eid="JHN 18:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="JHN 18:17"/>ಆಗ ದ್ವಾರಪಾಲಕಿಯು ಪೇತ್ರನಿಗೆ, “ನೀನು ಸಹ ಯೇಸುವಿನ ಶಿಷ್ಯರಲ್ಲಿ ಒಬ್ಬನಲ್ಲವೇ?” ಎಂದು ಕೇಳಲು,</para>
  <para style="p" vid="JHN 18:17">ಅದಕ್ಕವನು, “ನಾನಲ್ಲ,” ಎಂದನು.<verse eid="JHN 18:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="JHN 18:18"/>ಆಗ ಚಳಿಯಿದ್ದುದರಿಂದ ಸೇವಕರೂ ಕಾವಲುಗಾರರೂ ಬೆಂಕಿಮಾಡಿ ಚಳಿ ಕಾಯಿಸಿಕೊಳ್ಳುತ್ತಿದ್ದರು. ಪೇತ್ರನೂ ಅವರೊಂದಿಗೆ ನಿಂತು ಚಳಿ ಕಾಯಿಸಿಕೊಳ್ಳುತ್ತಿದ್ದನು.<verse eid="JHN 18:18"/></para>
  <para style="s1">ಮಹಾಯಾಜಕನು ಯೇಸುವನ್ನು ಪ್ರಶ್ನಿಸಿದ್ದು</para>
  <para style="p">
    <verse number="19" style="v" sid="JHN 18:19"/>ಆಗ ಮಹಾಯಾಜಕನು ಯೇಸುವನ್ನು ಅವರ ಶಿಷ್ಯರ ವಿಷಯವಾಗಿಯೂ ಅವರ ಬೋಧನೆಯ ವಿಷಯವಾಗಿಯೂ ಪ್ರಶ್ನಿಸಿದನು.<verse eid="JHN 18:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="JHN 18:20"/>ಯೇಸು ಅವನಿಗೆ, “ನಾನು ಬಹಿರಂಗವಾಗಿ ಲೋಕದ ಮುಂದೆ ಮಾತನಾಡಿದ್ದೇನೆ. ಯೆಹೂದ್ಯರೆಲ್ಲರು ಕೂಡಿಬರುವ ಸಭಾಮಂದಿರದಲ್ಲಿಯೂ ದೇವಾಲಯದಲ್ಲಿಯೂ ನಾನು ಯಾವಾಗಲೂ ಉಪದೇಶಿಸುತ್ತಿದ್ದೆನು. ನಾನು ಮುಚ್ಚುಮರೆಯಾಗಿ ಏನೂ ಮಾತನಾಡಲಿಲ್ಲ. <verse eid="JHN 18:20"/><verse number="21" style="v" sid="JHN 18:21"/>ನೀನು ನನ್ನನ್ನು ಪ್ರಶ್ನಿಸುವುದೇಕೆ? ನಾನು ಅವರಿಗೆ ಏನು ಮಾತನಾಡಿದ್ದೇನೆಂದು ಕೇಳಿದವರನ್ನೇ ಪ್ರಶ್ನಿಸು, ನಾನು ಹೇಳಿದ್ದನ್ನು ಅವರು ತಿಳಿದಿದ್ದಾರೆ,” ಎಂದರು.<verse eid="JHN 18:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 18:22"/>ಯೇಸು ಇವುಗಳನ್ನು ಹೇಳಿದಾಗ, ಹತ್ತಿರ ನಿಂತಿದ್ದ ಕಾವಲಾಳುಗಳಲ್ಲಿ ಒಬ್ಬನು ಯೇಸುವಿನ ಕೆನ್ನೆಗೆ ಹೊಡೆದು, “ನೀನು ಮಹಾಯಾಜಕನಿಗೆ ಹೀಗೆ ಉತ್ತರ ಕೊಡುತ್ತೀಯೋ?” ಎಂದನು.<verse eid="JHN 18:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="JHN 18:23"/>ಯೇಸು ಅವನಿಗೆ, “ನಾನು ಕೆಟ್ಟದ್ದನ್ನು ಮಾತನಾಡಿದ್ದರೆ ಕೆಟ್ಟದ್ದರ ವಿಷಯವಾಗಿ ಸಾಕ್ಷಿಕೊಡು; ಒಳ್ಳೆಯದನ್ನು ಮಾತನಾಡಿದ್ದರೆ ನೀನು ನನ್ನನ್ನು ಹೊಡೆಯುವುದೇಕೆ?” ಎಂದರು. <verse eid="JHN 18:23"/><verse number="24" style="v" sid="JHN 18:24"/>ಆಗ ಅನ್ನನು ಯೇಸುವನ್ನು ಕಟ್ಟಿಸಿ ಮಹಾಯಾಜಕನಾದ ಕಾಯಫನ ಬಳಿಗೆ ಕಳುಹಿಸಿದನು.<verse eid="JHN 18:24"/></para>
  <para style="s1">ಪೇತ್ರನು ಎರಡನೆಯ ಮತ್ತು ಮೂರನೆಯ ಸಾರಿ ಅಲ್ಲಗಳೆದದ್ದು</para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 18:25"/>ಇತ್ತ ಸೀಮೋನ ಪೇತ್ರನು ಚಳಿಕಾಯಿಸಿಕೊಳ್ಳುತ್ತಾ ನಿಂತಿರುವಾಗ, ಒಬ್ಬನು ಅವನಿಗೆ, “ನೀನು ಸಹ ಆತನ ಶಿಷ್ಯನಲ್ಲವೇ?” ಎಂದು ಕೇಳಿದರು.</para>
  <para style="p" vid="JHN 18:25">ಅದಕ್ಕೆ ಅವನು ಅದನ್ನು ನಿರಾಕರಿಸಿ, “ನಾನಲ್ಲ,” ಎಂದನು.<verse eid="JHN 18:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="JHN 18:26"/>ಮಹಾಯಾಜಕನ ಸೇವಕರಲ್ಲಿ ಕಿವಿ ಕತ್ತರಿಸಿದವನ ಬಂಧುವಾಗಿದ್ದ ಒಬ್ಬನು ಪೇತ್ರನಿಗೆ, “ನಾನು ನಿನ್ನನ್ನು ತೋಟದಲ್ಲಿ ಆತನ ಸಂಗಡ ಕಾಣಲಿಲ್ಲವೋ?” ಎಂದು ಕೇಳಿದ್ದಕ್ಕೆ, <verse eid="JHN 18:26"/><verse number="27" style="v" sid="JHN 18:27"/>ಪೇತ್ರನು ತಿರುಗಿ ನಿರಾಕರಿಸಿದನು. ಆಗ ಕೂಡಲೇ ಹುಂಜ ಕೂಗತೊಡಗಿತು.<verse eid="JHN 18:27"/></para>
  <para style="s1">ಯೇಸುವನ್ನು ಪಿಲಾತನ ಮುಂದೆ ನಿಲ್ಲಿಸಿದ್ದು</para>
  <para style="p">
    <verse number="28" style="v" sid="JHN 18:28"/>ಆಮೇಲೆ ಅವರು ಯೇಸುವನ್ನು ಕಾಯಫನ ಬಳಿಯಿಂದ ರೋಮನ್ ರಾಜ್ಯಪಾಲನ ನಿವಾಸಕ್ಕೆ ಸಾಗಿಸಿಕೊಂಡು ಹೋದರು. ಆಗ ಮುಂಜಾನೆಯಾಗಿತ್ತು. ತಾವು ಅಶುದ್ಧವಾಗದಂತೆ ಪಸ್ಕದ ಊಟಮಾಡುವುದಕ್ಕೆ ಅಡ್ಡಿಯಾದೀತೆಂದು ಅವರು ರಾಜ್ಯಪಾಲನ ನಿವಾಸದ ಒಳಗೆ ಹೋಗಲಿಲ್ಲ. <verse eid="JHN 18:28"/><verse number="29" style="v" sid="JHN 18:29"/>ಆಗ ಪಿಲಾತನೇ ಹೊರಗೆ ಅವರ ಬಳಿಗೆ ಬಂದು, “ನೀವು ಈತನ ಮೇಲೆ ಏನು ದೂರು ತಂದಿದ್ದೀರಿ?” ಎಂದು ಕೇಳಿದ್ದಕ್ಕೆ,<verse eid="JHN 18:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="JHN 18:30"/>ಯೆಹೂದಿ ನಾಯಕರು, “ಈತನು ದುಷ್ಕರ್ಮಿಯಲ್ಲದಿದ್ದರೆ ನಾವು ಈತನನ್ನು ನಿನಗೆ ಒಪ್ಪಿಸಿಕೊಡುತ್ತಿರಲಿಲ್ಲ,” ಎಂದು ಹೇಳಿದರು.<verse eid="JHN 18:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="JHN 18:31"/>ಆಗ ಪಿಲಾತನು ಅವರಿಗೆ, “ನೀವೇ ಆತನನ್ನು ತೆಗೆದುಕೊಂಡುಹೋಗಿ ನಿಮ್ಮ ನಿಯಮದ ಪ್ರಕಾರ ಆತನಿಗೆ ತೀರ್ಪು ಮಾಡಿರಿ,” ಎಂದನು. ಅದಕ್ಕೆ ಯೆಹೂದ್ಯರು ಅವನಿಗೆ,</para>
  <para style="p" vid="JHN 18:31">“ಮರಣದಂಡನೆ ವಿಧಿಸುವ ಅಧಿಕಾರ ನಮಗೆ ಇಲ್ಲ,” ಎಂದು ಹೇಳಿದರು. <verse eid="JHN 18:31"/><verse number="32" style="v" sid="JHN 18:32"/>ಹೀಗೆ ಯೇಸು ತಾನು ಎಂಥಾ ಮರಣದಿಂದ ಸಾಯಲಿದ್ದೇನೆಂಬುದನ್ನು ಸೂಚಿಸಿ ಹೇಳಿದ ಮಾತು ನೆರವೇರಿತು.<note caller="+" style="f"><char style="fr" closed="false">18:32 </char><char style="ft" closed="false">ನೋಡಿರಿ <char style="xt"><ref loc="JHN 8:28">ಯೋಹಾನ 8:28</ref></char></char></note><verse eid="JHN 18:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="JHN 18:33"/>ಆದ್ದರಿಂದ ಪಿಲಾತನು ತಿರುಗಿ ತನ್ನ ನಿವಾಸದೊಳಗೆ ಪ್ರವೇಶಿಸಿ ಯೇಸುವನ್ನು ಕರೆದು ಅವರಿಗೆ, “ನೀನು ಯೆಹೂದ್ಯರ ಅರಸನೋ?” ಎಂದು ಕೇಳಿದನು.<verse eid="JHN 18:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="JHN 18:34"/>ಅದಕ್ಕೆ ಯೇಸು ಅವನಿಗೆ, “ನಿನ್ನಷ್ಟಕ್ಕೆ ನೀನೇ ಇದನ್ನು ಹೇಳುತ್ತೀಯೋ ಇಲ್ಲವೆ ಬೇರೆಯವರು ನನ್ನನ್ನು ಕುರಿತು ನಿನಗೆ ಹೇಳಿದ್ದಾರೋ?” ಎಂದರು.<verse eid="JHN 18:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="JHN 18:35"/>ಪಿಲಾತನು, “ನಾನೇನು ಯೆಹೂದ್ಯನೋ? ನಿನ್ನ ಜನಾಂಗವೂ ಮುಖ್ಯಯಾಜಕರೂ ನಿನ್ನನ್ನು ನನಗೆ ಒಪ್ಪಿಸಿದ್ದಾರೆ. ನೀನು ಏನು ಮಾಡಿದ್ದೀಯಾ?” ಎಂದು ಕೇಳಿದನು.<verse eid="JHN 18:35"/></para>
  <para style="p">
    <verse number="36" style="v" sid="JHN 18:36"/>ಯೇಸು, “ನನ್ನ ರಾಜ್ಯವು ಈ ಲೋಕದ್ದಲ್ಲ, ನನ್ನ ರಾಜ್ಯವು ಈ ಲೋಕದ್ದಾಗಿದ್ದರೆ ನನ್ನನ್ನು ಯೆಹೂದ್ಯರಿಗೆ ಒಪ್ಪಿಸದಂತೆ ನನ್ನ ಸೇವಕರು ಹೋರಾಡುತ್ತಿದ್ದರು; ಆದರೆ ಈಗ ನನ್ನ ರಾಜ್ಯವು ಇಲ್ಲಿಯದಲ್ಲ,” ಎಂದು ಉತ್ತರಕೊಟ್ಟರು.<verse eid="JHN 18:36"/></para>
  <para style="p">
    <verse number="37" style="v" sid="JHN 18:37"/>ಪಿಲಾತನು ಯೇಸುವಿಗೆ, “ನೀನು ಅರಸನೋ?” ಎಂದು ಕೇಳಲು,</para>
  <para style="p" vid="JHN 18:37">ಯೇಸು, “ನಾನು ಅರಸನೆಂದು ನೀನೇ ಹೇಳುತ್ತೀ. ನಾನು ಸತ್ಯಕ್ಕೆ ಸಾಕ್ಷಿ ಕೊಡುವುದಕ್ಕಾಗಿ ಹುಟ್ಟಿ, ಇದಕ್ಕಾಗಿಯೇ ಲೋಕಕ್ಕೆ ಬಂದೆನು; ಸತ್ಯಕ್ಕೆ ಸೇರಿದ ಎಲ್ಲರೂ ನನ್ನ ಸ್ವರವನ್ನು ಕೇಳುತ್ತಾರೆ,” ಎಂದರು.<verse eid="JHN 18:37"/></para>
  <para style="p">
    <verse number="38" style="v" sid="JHN 18:38"/>ಪಿಲಾತನು ಯೇಸುವಿಗೆ, “ಸತ್ಯ ಎಂದರೇನು?” ಎಂದನು. ಅವನು ಇದನ್ನು ಕೇಳಿದ ಮೇಲೆ ತಿರುಗಿ ಯೆಹೂದ್ಯರ ಬಳಿಗೆ ಹೋಗಿ ಅವರಿಗೆ, “ನಾನು ಈತನಲ್ಲಿ ಯಾವ ಅಪರಾಧವನ್ನೂ ಕಾಣಲಿಲ್ಲ. <verse eid="JHN 18:38"/><verse number="39" style="v" sid="JHN 18:39"/>ಆದರೆ ಪಸ್ಕಹಬ್ಬದಲ್ಲಿ ನಾನು ನಿಮಗೆ ಒಬ್ಬನನ್ನು ಬಿಟ್ಟುಕೊಡುವ ಪದ್ಧತಿಯಿದೆಯಷ್ಟೆ; ಆದಕಾರಣ ನಾನು ಯೆಹೂದ್ಯರ ಅರಸನನ್ನು ಬಿಟ್ಟುಕೊಡುವುದು ನಿಮಗೆ ಇಷ್ಟವೋ?” ಎಂದು ಕೇಳಿದನು.<verse eid="JHN 18:39"/></para>
  <para style="p">
    <verse number="40" style="v" sid="JHN 18:40"/>ಅದಕ್ಕೆ ಅವರೆಲ್ಲರೂ ತಿರುಗಿ, “ಇವನು ಬೇಡ, ನಮಗೆ ಬರಬ್ಬನನ್ನು ಬಿಟ್ಟುಕೊಡು,” ಎಂದು ಕೂಗಿಕೊಂಡರು. ಆ ಬರಬ್ಬನು ದರೋಡೆಕೋರನಾಗಿದ್ದನು.<verse eid="JHN 18:40"/></para>
  <chapter eid="JHN 18"/>
  <chapter number="19" style="c" sid="JHN 19"/>
  <para style="s1">ಯೇಸುವನ್ನು ಶಿಲುಬೆಗೆ ಹಾಕಿಸುವ ತೀರ್ಪು</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 19:1"/>ಆಗ ಪಿಲಾತನು ಯೇಸುವನ್ನು ತೆಗೆದುಕೊಂಡು ಕೊರಡೆಯಿಂದ ಹೊಡೆಸಿದನು. <verse eid="JHN 19:1"/><verse number="2" style="v" sid="JHN 19:2"/>ಸೈನಿಕರು ಮುಳ್ಳಿನ ಕಿರೀಟವನ್ನು ಹೆಣೆದು ಅವರ ತಲೆಯ ಮೇಲಿಟ್ಟು ಕೆನ್ನೇರಳೆ ಬಣ್ಣದ ನಿಲುವಂಗಿಯನ್ನು ತೊಡಿಸಿ, <verse eid="JHN 19:2"/><verse number="3" style="v" sid="JHN 19:3"/>“ಯೆಹೂದ್ಯರ ಅರಸನೇ, ನಮಸ್ಕಾರ!” ಎಂದು ಹೇಳಿ ಯೇಸುವಿನ ಕೆನ್ನೆಗೆ ಹೊಡೆದರು.<verse eid="JHN 19:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="JHN 19:4"/>ಆಗ ಪಿಲಾತನು ತಿರುಗಿ ಹೊರಗೆ ಹೋಗಿ ಯೆಹೂದ್ಯರ ಗುಂಪಿಗೆ, “ಇಗೋ, ನಾನು ಆತನಲ್ಲಿ ಯಾವ ಅಪರಾಧವನ್ನೂ ಕಾಣಲಿಲ್ಲವೆಂದು ನೀವು ತಿಳಿದುಕೊಳ್ಳುವಂತೆ ಆತನನ್ನು ನಿಮ್ಮ ಬಳಿಗೆ ತರುತ್ತೇನೆ,” ಎಂದನು. <verse eid="JHN 19:4"/><verse number="5" style="v" sid="JHN 19:5"/>ಯೇಸು ಮುಳ್ಳಿನ ಕಿರೀಟವನ್ನು ಮತ್ತು ಕೆನ್ನೇರಳೆ ಬಣ್ಣದ ನಿಲುವಂಗಿಯನ್ನು ಧರಿಸಿಕೊಂಡವರಾಗಿ ಹೊರಗೆ ಬಂದರು. ಪಿಲಾತನು ಅವರಿಗೆ, “ಇಗೋ, ಆ ಮನುಷ್ಯನು ಇವನೇ!” ಎಂದನು.<verse eid="JHN 19:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="JHN 19:6"/>ಮುಖ್ಯಯಾಜಕರೂ ಕಾವಲಾಳುಗಳೂ ಯೇಸುವನ್ನು ನೋಡಿದಾಗ, “ಶಿಲುಬೆಗೆ ಹಾಕಿಸು, ಶಿಲುಬೆಗೆ ಹಾಕಿಸು!” ಎಂದು ಕೂಗಿದರು.</para>
  <para style="p" vid="JHN 19:6">ಅದಕ್ಕೆ ಪಿಲಾತನು ಅವರಿಗೆ, “ನೀವೇ ಆತನನ್ನು ತೆಗೆದುಕೊಂಡುಹೋಗಿ ಶಿಲುಬೆಗೆ ಹಾಕಿರಿ. ಏಕೆಂದರೆ ನನಗೆ ಆತನಲ್ಲಿ ಯಾವ ಅಪರಾಧವೂ ಕಾಣಲಿಲ್ಲ,” ಎಂದನು.<verse eid="JHN 19:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="JHN 19:7"/>ಯೆಹೂದ್ಯ ನಾಯಕರು ಅವನಿಗೆ, “ನಮಗೆ ಒಂದು ನಿಯಮವಿದೆ, ಆ ನಿಯಮದ ಪ್ರಕಾರ ಅವನು ಸಾಯಲೇಬೇಕು. ಏಕೆಂದರೆ ಅವನು ತನ್ನನ್ನು ದೇವರ ಪುತ್ರನನ್ನಾಗಿ ಮಾಡಿಕೊಂಡಿದ್ದಾನೆ,” ಎಂದರು.<verse eid="JHN 19:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="JHN 19:8"/>ಪಿಲಾತನು ಈ ಮಾತನ್ನು ಕೇಳಿದಾಗ ಬಹಳವಾಗಿ ಭಯಪಟ್ಟನು. <verse eid="JHN 19:8"/><verse number="9" style="v" sid="JHN 19:9"/>ತಿರುಗಿ ತನ್ನ ನಿವಾಸದೊಳಗೆ ಹೋಗಿ, “ನೀನು ಎಲ್ಲಿಂದ ಬಂದವನು?” ಎಂದು ಯೇಸುವನ್ನು ಕೇಳಿದನು. ಆದರೆ ಯೇಸು ಅವನಿಗೆ ಉತ್ತರ ಕೊಡಲಿಲ್ಲ. <verse eid="JHN 19:9"/><verse number="10" style="v" sid="JHN 19:10"/>ಆಗ ಪಿಲಾತನು ಯೇಸುವಿಗೆ, “ನೀನು ನನ್ನೊಡನೆ ಮಾತನಾಡುವುದಿಲ್ಲವೋ? ನಿನ್ನನ್ನು ಬಿಡಿಸುವುದಕ್ಕೂ ನಿನ್ನನ್ನು ಶಿಲುಬೆಗೆ ಹಾಕಿಸುವುದಕ್ಕೂ ನನಗೆ ಅಧಿಕಾರವು ಉಂಟೆಂದು ನಿನಗೆ ತಿಳಿಯದೋ?” ಎಂದು ಕೇಳಿದನು.<verse eid="JHN 19:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="JHN 19:11"/>ಅದಕ್ಕೆ ಯೇಸು, “ಪರಲೋಕದಿಂದ ನಿನಗೆ ಕೊಟ್ಟ ಹೊರತು ನನ್ನ ಮೇಲೆ ನಿನಗೆ ಯಾವ ಅಧಿಕಾರವೂ ಇರುತ್ತಿರಲಿಲ್ಲ. ಆದಕಾರಣ ನನ್ನನ್ನು ನಿನಗೆ ಒಪ್ಪಿಸಿದವನಿಗೆ ಹೆಚ್ಚಿನ ಪಾಪವಿದೆ,” ಎಂದು ಉತ್ತರಕೊಟ್ಟರು.<verse eid="JHN 19:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 19:12"/>ಇದನ್ನು ಕೇಳಿದಾಗಿಂದ ಪಿಲಾತನು ಯೇಸುವನ್ನು ಬಿಡಿಸಲು ಪ್ರಯತ್ನಿಸಿದನು. ಆದರೆ ಯೆಹೂದ್ಯ ನಾಯಕರು, “ನೀನು ಈ ಮನುಷ್ಯನನ್ನು ಬಿಡುಗಡೆ ಮಾಡಿದರೆ, ನೀನು ಕೈಸರನ ಮಿತ್ರನಲ್ಲ. ತನ್ನನ್ನು ತಾನೇ ಅರಸನನ್ನಾಗಿ ಮಾಡಿಕೊಳ್ಳುವವನು, ಕೈಸರನಿಗೆ ವಿರೋಧವಾಗಿ ಮಾತನಾಡುವವನಾಗಿದ್ದಾನೆ,” ಎಂದು ಕೂಗಿ ಹೇಳಿದರು.<verse eid="JHN 19:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="JHN 19:13"/>ಪಿಲಾತನು ಆ ಮಾತುಗಳನ್ನು ಕೇಳಿ ಯೇಸುವನ್ನು ಹೊರಗೆ ಕರೆದುಕೊಂಡು ಬಂದನು. ಹೀಬ್ರೂ ಭಾಷೆಯಲ್ಲಿ “ಗಬ್ಬಥಾ” ಎಂದು ಕರೆಯಲಾದ “ಕಲ್ಲು ಹಾಸಿದ ಕಟ್ಟೆ” ಎಂಬ ಕಟ್ಟೆಯ ಮೇಲಿದ್ದ ನ್ಯಾಯಾಸನದ ಮೇಲೆ ಕುಳಿತುಕೊಂಡನು. <verse eid="JHN 19:13"/><verse number="14" style="v" sid="JHN 19:14"/>ಅದು ಪಸ್ಕಹಬ್ಬಕ್ಕೆ ಸಿದ್ಧಮಾಡುವ ದಿನದ ಸುಮಾರು ಮಧ್ಯಾಹ್ನ ಹನ್ನೆರಡು ಗಂಟೆಯಾಗಿತ್ತು.</para>
  <para style="p" vid="JHN 19:14">ಪಿಲಾತನು ಯೆಹೂದ್ಯರಿಗೆ, “ಇಗೋ, ನಿಮ್ಮ ಅರಸನು,” ಎಂದನು.<verse eid="JHN 19:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="JHN 19:15"/>ಆದರೆ ಅವರು, “ಆತನನ್ನು ಕೊಲ್ಲಿಸು ಕೊಲ್ಲಿಸು! ಆತನನ್ನು ಶಿಲುಬೆಗೆ ಹಾಕು!” ಎಂದು ಕೂಗಿದರು.</para>
  <para style="p" vid="JHN 19:15">ಅದಕ್ಕೆ ಪಿಲಾತನು ಅವರಿಗೆ, “ನಿಮ್ಮ ಅರಸನನ್ನು ಶಿಲುಬೆಗೆ ಹಾಕಬೇಕೆ?” ಎಂದು ಕೇಳಿದನು.</para>
  <para style="p" vid="JHN 19:15">ಆಗ ಮುಖ್ಯಯಾಜಕರು, “ಕೈಸರನೇ<note caller="+" style="f"><char style="fr" closed="false">19:15 </char><char style="ft" closed="false">ಕೈಸರನು ರೋಮಾ ಚಕ್ರವರ್ತಿಯಾಗಿದ್ದನು</char></note> ಹೊರತು ನಮಗೆ ಬೇರೆ ಅರಸನಿಲ್ಲ,” ಎಂದು ಉತ್ತರಕೊಟ್ಟರು.<verse eid="JHN 19:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 19:16"/>ಆಗ ಪಿಲಾತನು ಯೇಸುವನ್ನು ಶಿಲುಬೆಗೆ ಹಾಕಿಸುವುದಕ್ಕಾಗಿ ಅವರಿಗೆ ಒಪ್ಪಿಸಿದನು. ಅವರು ಯೇಸುವನ್ನು ತಮ್ಮ ವಶಕ್ಕೆ ತೆಗೆದುಕೊಂಡು ಹೋದರು.<verse eid="JHN 19:16"/></para>
  <para style="s1">ಯೇಸುವನ್ನು ಶಿಲುಬೆಗೆ ಹಾಕಿದ್ದು</para>
  <para style="p">
    <verse number="17" style="v" sid="JHN 19:17"/>ಯೇಸು ತಮ್ಮ ಶಿಲುಬೆಯನ್ನು ತಾವೇ ಹೊತ್ತುಕೊಂಡು “ತಲೆಬುರುಡೆಯ ಸ್ಥಳ”<note caller="+" style="f"><char style="fr" closed="false">19:17 </char><char style="ft" closed="false">ಲ್ಯಾಟಿನ್ ಭಾಷೆಯಲ್ಲಿ </char><char style="fqa" closed="false">ಕಲ್ವರಿ</char></note> ಎಂಬ ಸ್ಥಳಕ್ಕೆ ಹೋದರು. ಅದು ಅರಮಾಯ ಭಾಷೆಯಲ್ಲಿ “ಗೊಲ್ಗೊಥಾ” ಎಂದು ಅರ್ಥ. <verse eid="JHN 19:17"/><verse number="18" style="v" sid="JHN 19:18"/>ಅಲ್ಲಿ ಯೇಸುವನ್ನೂ ಅವರ ಜೊತೆಯಲ್ಲಿ ಇನ್ನಿಬ್ಬರನ್ನೂ ಶಿಲುಬೆಗೆ ಹಾಕಿದರು. ಅವರಲ್ಲಿ ಒಬ್ಬನನ್ನು ಯೇಸುವಿನ ಬಲಗಡೆಗೂ ಮತ್ತೊಬ್ಬನನ್ನು ಅವರ ಎಡಗಡೆಗೂ ಇಟ್ಟರು.<verse eid="JHN 19:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="JHN 19:19"/>ಪಿಲಾತನು ಒಂದು ಫಲಕದ ಮೇಲೆ ಶಿರೋನಾಮವನ್ನು ಬರೆಸಿ, ಅದನ್ನು ಶಿಲುಬೆಯ ಮೇಲಿಟ್ಟಿದ್ದನು. ಅದೇನಂದರೆ:</para>
  <para style="pc" vid="JHN 19:19">
    <char style="sc">ಯೆಹೂದ್ಯರ ಅರಸನಾದ ನಜರೇತಿನ ಯೇಸು.</char><verse eid="JHN 19:19"/></para>
  <para style="m">
    <verse number="20" style="v" sid="JHN 19:20"/>ಈ ಫಲಕವನ್ನು ಯೆಹೂದ್ಯರಲ್ಲಿ ಅನೇಕರು ಓದಿದರು. ಏಕೆಂದರೆ ಯೇಸುವನ್ನು ಶಿಲುಬೆಗೇರಿಸಿದ ಆ ಸ್ಥಳವು ಪಟ್ಟಣಕ್ಕೆ ಸಮೀಪವಾಗಿತ್ತು. ಇದು ಹೀಬ್ರೂ, ಲ್ಯಾಟಿನ್ ಮತ್ತು ಗ್ರೀಕ್ ಭಾಷೆಗಳಲ್ಲಿ ಬರೆಯಲಾಗಿತ್ತು. <verse eid="JHN 19:20"/><verse number="21" style="v" sid="JHN 19:21"/>ಯೆಹೂದ್ಯರ ಮುಖ್ಯಯಾಜಕರು ಪಿಲಾತನಿಗೆ, “ಯೆಹೂದ್ಯರ ಅರಸನೆಂದು ಬರೆಯಬೇಡ, ‘ತಾನು ಯೆಹೂದ್ಯರ ಅರಸನು ಎಂದು ಹೇಳಿಕೊಂಡವನು’ ಎಂದು ಬರೆ,” ಎಂದರು.<verse eid="JHN 19:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 19:22"/>ಪಿಲಾತನು, “ನಾನು ಬರೆದದ್ದು ಬರೆದಾಯಿತು,” ಎಂದು ಉತ್ತರಕೊಟ್ಟನು.<verse eid="JHN 19:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="JHN 19:23"/>ಸೈನಿಕರು ಯೇಸುವನ್ನು ಶಿಲುಬೆಗೆ ಹಾಕಿದ ಮೇಲೆ ಅವರ ವಸ್ತ್ರಗಳನ್ನು ತೆಗೆದು ಪ್ರತಿಯೊಬ್ಬ ಸೈನಿಕನಿಗೆ ಒಂದೊಂದು ಭಾಗದಂತೆ ನಾಲ್ಕು ಭಾಗಗಳನ್ನಾಗಿ ಹಂಚಿಕೊಂಡರು. ಅವರ ಒಳ ಅಂಗಿಯನ್ನು ಸಹ ತೆಗೆದುಕೊಂಡರು. ಆ ಒಳ ಅಂಗಿಯು ಹೊಲಿಗೆ ಇಲ್ಲದೆ ಮೇಲಿನಿಂದ ಕೆಳಗಿನವರೆಗೆ ಹೆಣೆದದ್ದಾಗಿತ್ತು.<verse eid="JHN 19:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="JHN 19:24"/>ಆದ್ದರಿಂದ ಅವರು, “ನಾವು ಅದನ್ನು ಹರಿಯುವುದು ಬೇಡ. ಆದರೆ ಅದು ಯಾರಿಗಾಗುವುದೋ ಎಂದು ನೋಡುವುದಕ್ಕಾಗಿ ಚೀಟು ಹಾಕಿಕೊಳ್ಳೋಣ,” ಎಂದು ತಮ್ಮತಮ್ಮೊಳಗೆ ಮಾತನಾಡಿಕೊಂಡರು. ಹೀಗೆ,</para>
  <para style="q1" vid="JHN 19:24">“ನನ್ನ ಬಟ್ಟೆಯನ್ನು ಅವರು ತಮ್ಮೊಳಗೆ ಪಾಲುಮಾಡಿಕೊಂಡರು.</para>
  <para style="q2" vid="JHN 19:24">ನನ್ನ ಒಳ ಅಂಗಿಗಾಗಿ ಚೀಟುಹಾಕಿದರು,”<note caller="+" style="f"><char style="fr" closed="false">19:24 </char><char style="ft" closed="false"><char style="xt"><ref loc="PSA 22:18">ಕೀರ್ತನೆ 22:18</ref></char></char></note></para>
  <para style="m" vid="JHN 19:24">ಎಂಬ ಪವಿತ್ರ ವೇದದ ವಾಕ್ಯವು ನೆರವೇರುವಂತೆ, ಸೈನಿಕರು ಚೀಟುಹಾಕಿ ಪಾಲುಮಾಡಿಕೊಂಡರು.<verse eid="JHN 19:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 19:25"/>ಯೇಸುವಿನ ಶಿಲುಬೆಯ ಬಳಿಯಲ್ಲಿ ಅವರ ತಾಯಿಯೂ ಅವರ ತಾಯಿಯ ಸಹೋದರಿಯೂ ಕ್ಲೋಪನ ಹೆಂಡತಿಯಾದ ಮರಿಯಳೂ ಮಗ್ದಲದ ಮರಿಯಳೂ ನಿಂತಿದ್ದರು. <verse eid="JHN 19:25"/><verse number="26" style="v" sid="JHN 19:26"/>ಯೇಸು ತಮ್ಮ ತಾಯಿಯೂ ತಾವು ಪ್ರೀತಿಸಿದ ಶಿಷ್ಯನೂ ಹತ್ತಿರದಲ್ಲಿ ನಿಂತಿರುವುದನ್ನು ಕಂಡು ತಮ್ಮ ತಾಯಿಗೆ, “ಅಮ್ಮಾ, ಇಗೋ, ನಿನ್ನ ಮಗನು,” ಎಂದರು. <verse eid="JHN 19:26"/><verse number="27" style="v" sid="JHN 19:27"/>ಆಮೇಲೆ ಯೇಸು ಆ ಶಿಷ್ಯನಿಗೆ, “ಇಗೋ, ನಿನ್ನ ತಾಯಿಯು,” ಎಂದರು. ಆ ಸಮಯದಿಂದ ಆ ಶಿಷ್ಯನು ಆಕೆಯನ್ನು ತನ್ನ ಸ್ವಂತ ಮನೆಯಲ್ಲಿ ಇರಿಸಿಕೊಂಡನು.<verse eid="JHN 19:27"/></para>
  <para style="s1">ಯೇಸುವಿನ ಮರಣ</para>
  <para style="p">
    <verse number="28" style="v" sid="JHN 19:28"/>ಇದಾದ ಮೇಲೆ ಯೇಸು ಈಗ ಎಲ್ಲವೂ ಪೂರ್ತಿಯಾಗಿದೆಯೆಂದು ತಿಳಿದು, ಪವಿತ್ರ ವೇದದ ವಾಕ್ಯವು ನೆರವೇರುವಂತೆ, “ನನಗೆ ನೀರಡಿಕೆಯಾಗಿದೆ” ಎಂದರು. <verse eid="JHN 19:28"/><verse number="29" style="v" sid="JHN 19:29"/>ಆಗ ಅಲ್ಲಿ ಹುಳಿರಸ ತುಂಬಿದ ಪಾತ್ರೆಯಿತ್ತು. ಅವರು ಹೀರುವ ಪದಾರ್ಥವನ್ನು ಹುಳಿರಸದಲ್ಲಿ ಅದ್ದಿ ಹಿಸ್ಸೋಪ್ ಗಿಡದ ಕೋಲಿಗೆ ಸಿಕ್ಕಿಸಿ ಯೇಸುವಿನ ಬಾಯಿಗೆ ಇಟ್ಟರು. <verse eid="JHN 19:29"/><verse number="30" style="v" sid="JHN 19:30"/>ಯೇಸು ಆ ಹುಳಿರಸವನ್ನು ತೆಗೆದುಕೊಂಡ ಮೇಲೆ, “ತೀರಿತು” ಎಂದು ಹೇಳಿ ತಲೆಬಾಗಿ ತಮ್ಮ ಆತ್ಮವನ್ನು ಒಪ್ಪಿಸಿಕೊಟ್ಟರು.<verse eid="JHN 19:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="JHN 19:31"/>ಅದು ಪಸ್ಕಹಬ್ಬದ ಸಿದ್ಧತೆಯ ದಿನವಾಗಿತ್ತು. ಮರುದಿನ ವಿಶೇಷ ಸಬ್ಬತ್ ದಿನದಲ್ಲಿ ದೇಹಗಳು ಶಿಲುಬೆಯ ಮೇಲೆ ಇರಬಾರದೆಂದು ಅವರ ಕಾಲುಗಳನ್ನು ಮುರಿದು ಅವರನ್ನು ತೆಗೆದುಬಿಡಬೇಕೆಂದು ಯೆಹೂದ್ಯ ನಾಯಕರು ಪಿಲಾತನನ್ನು ಕೇಳಿಕೊಂಡರು. <verse eid="JHN 19:31"/><verse number="32" style="v" sid="JHN 19:32"/>ಅದರಂತೆ ಸೈನಿಕರು ಬಂದು ಯೇಸುವಿನ ಜೊತೆಯಲ್ಲಿ ಶಿಲುಬೆಗೇರಿಸಲಾಗಿದ್ದ ಮೊದಲನೆಯವನ ಕಾಲುಗಳನ್ನೂ ಮತ್ತೊಬ್ಬನ ಕಾಲುಗಳನ್ನೂ ಮುರಿದರು. <verse eid="JHN 19:32"/><verse number="33" style="v" sid="JHN 19:33"/>ಆದರೆ ಅವರು ಯೇಸುವಿನ ಬಳಿಗೆ ಬಂದಾಗ ಯೇಸು ಆಗಲೇ ಸತ್ತಿರುವುದನ್ನು ಕಂಡು ಅವರ ಕಾಲುಗಳನ್ನು ಮುರಿಯಲಿಲ್ಲ. <verse eid="JHN 19:33"/><verse number="34" style="v" sid="JHN 19:34"/>ಆದರೆ ಸೈನಿಕರಲ್ಲಿ ಒಬ್ಬನು ಈಟಿಯಿಂದ ಯೇಸುವಿನ ಪಕ್ಕೆಯನ್ನು ತಿವಿದನು. ಕೂಡಲೇ ರಕ್ತವೂ ನೀರೂ ಹೊರಗೆ ಬಂದವು. <verse eid="JHN 19:34"/><verse number="35" style="v" sid="JHN 19:35"/>ಇದನ್ನು ಕಣ್ಣಾರೆ ಕಂಡವನೇ ಸಾಕ್ಷಿ ಕೊಟ್ಟಿದ್ದಾನೆ. ಅವನ ಸಾಕ್ಷಿಯು ಸತ್ಯವಾದದ್ದು, ನೀವು ಸಹ ನಂಬುವಂತೆ ತಾನು ಹೇಳಿರುವುದು ಸತ್ಯವೆಂದು ಅವನು ಬಲ್ಲನು. <verse eid="JHN 19:35"/><verse number="36" style="v" sid="JHN 19:36"/>ಏಕೆಂದರೆ, “ಯೇಸುವಿನ ಎಲುಬುಗಳಲ್ಲಿ ಒಂದನ್ನಾದರೂ ಮುರಿಯಬಾರದು,”<note caller="+" style="f"><char style="fr" closed="false">19:36 </char><char style="ft" closed="false"><char style="xt"><ref loc="EXO 12:46">ವಿಮೋ 12:46</ref>; <ref loc="NUM 9:12">ಅರಣ್ಯ 9:12</ref>; <ref loc="PSA 34:20">ಕೀರ್ತನೆ 34:20</ref></char></char></note> ಎಂಬ ಪವಿತ್ರ ವೇದದ ವಾಕ್ಯವು ನೆರವೇರುವಂತೆಯೇ ಇವೆಲ್ಲಾ ಸಂಭವಿಸಿದವು. <verse eid="JHN 19:36"/><verse number="37" style="v" sid="JHN 19:37"/>ಮತ್ತೊಂದು ಪವಿತ್ರ ವೇದದ ವಾಕ್ಯವು, “ತಾವು ಇರಿದವನನ್ನು ಅವರು ನೋಡುವರು,”<note caller="+" style="f"><char style="fr" closed="false">19:37 </char><char style="ft" closed="false"><char style="xt"><ref loc="ZEC 12:10">ಜೆಕರ್ಯ 12:10</ref></char></char></note> ಎಂದು ಹೇಳುತ್ತದೆ.<verse eid="JHN 19:37"/></para>
  <para style="s1">ಯೇಸುವನ್ನು ಸಮಾಧಿಯಲ್ಲಿ ಇಟ್ಟಿದ್ದು</para>
  <para style="p">
    <verse number="38" style="v" sid="JHN 19:38"/>ತರುವಾಯ ಯೆಹೂದ್ಯರ ಭಯದ ನಿಮಿತ್ತದಿಂದ ಗುಪ್ತವಾಗಿ ಯೇಸುವಿನ ಶಿಷ್ಯನಾಗಿದ್ದ ಅರಿಮಥಾಯದ ಯೋಸೇಫನು ಯೇಸುವಿನ ದೇಹವನ್ನು ತೆಗೆದುಕೊಂಡು ಹೋಗುವುದಕ್ಕೆ ಪಿಲಾತನನ್ನು ಕೇಳಿಕೊಂಡನು. ಆಗ ಪಿಲಾತನು ಅಪ್ಪಣೆಕೊಡಲು ಅವನು ಬಂದು ಯೇಸುವಿನ ದೇಹವನ್ನು ತೆಗೆದುಕೊಂಡು ಹೋದನು. <verse eid="JHN 19:38"/><verse number="39" style="v" sid="JHN 19:39"/>ಇದಲ್ಲದೆ ಮೊದಲು ಒಂದು ಸಾರಿ ರಾತ್ರಿಯಲ್ಲಿ ಯೇಸುವಿನ ಬಳಿಗೆ ಬಂದಿದ್ದ ನಿಕೊದೇಮನು ಸಹ ರಕ್ತಬೋಳ, ಅಗರುಗಳನ್ನು,<note caller="+" style="f"><char style="fr" closed="false">19:39 </char><char style="ft" closed="false">ಇದು ಸುವಾಸನೆಯುಳ್ಳ </char><char style="fqa" closed="false">ಗಿಡದ ತೊಗಟೆ</char></note> ಸುಗಂಧದ್ರವ್ಯ ಬೆರೆಸಿದ ಮಿಶ್ರಣವನ್ನು, ಮೂವತ್ತು ಕಿಲೋಗ್ರಾಮಿನಷ್ಟು ತೆಗೆದುಕೊಂಡು ಅಲ್ಲಿಗೆ ಬಂದನು. <verse eid="JHN 19:39"/><verse number="40" style="v" sid="JHN 19:40"/>ಆಗ ಅವರು ಯೇಸುವಿನ ದೇಹವನ್ನು ತೆಗೆದುಕೊಂಡು ಯೆಹೂದ್ಯರಲ್ಲಿ ಹೂಳುವ ಪದ್ಧತಿಯ ಪ್ರಕಾರ ಅದನ್ನು ಸುಗಂಧದ್ರವ್ಯಗಳೊಂದಿಗೆ ನಾರುಬಟ್ಟೆಗಳಲ್ಲಿ ಸುತ್ತಿದರು. <verse eid="JHN 19:40"/><verse number="41" style="v" sid="JHN 19:41"/>ಯೇಸು ಶಿಲುಬೆಗೇರಿಸಿದ ಸ್ಥಳದಲ್ಲಿ ಒಂದು ತೋಟವಿತ್ತು. ಆ ತೋಟದಲ್ಲಿ ಯಾರನ್ನೂ ಇಡದೆ ಇದ್ದ ಒಂದು ಹೊಸ ಸಮಾಧಿಯಿತ್ತು. <verse eid="JHN 19:41"/><verse number="42" style="v" sid="JHN 19:42"/>ಆ ದಿನವು ಯೆಹೂದ್ಯರ ಸಿದ್ಧತೆಯ ದಿನವಾದದ್ದರಿಂದಲೂ ಸಮಾಧಿಯು ಸಮೀಪವಾಗಿದ್ದುದರಿಂದಲೂ ಅವರು ಯೇಸುವನ್ನು ಅಲ್ಲಿಯೇ ಸಮಾಧಿಮಾಡಿದರು.<verse eid="JHN 19:42"/></para>
  <chapter eid="JHN 19"/>
  <chapter number="20" style="c" sid="JHN 20"/>
  <para style="s1">ಖಾಲಿಯಾದ ಸಮಾಧಿ</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 20:1"/>ವಾರದ ಮೊದಲನೆಯ ದಿನದಲ್ಲಿ ಮುಂಜಾನೆ ಇನ್ನೂ ಕತ್ತಲಿರುವಾಗಲೇ ಮಗ್ದಲದ ಮರಿಯಳು ಸಮಾಧಿಯ ಬಳಿಗೆ ಬಂದು ಸಮಾಧಿಯಿಂದ ಬಂಡೆ ತೆಗೆದು ಹಾಕಿರುವುದನ್ನು ಕಂಡಳು. <verse eid="JHN 20:1"/><verse number="2" style="v" sid="JHN 20:2"/>ಆಗ ಆಕೆಯು ಸೀಮೋನ ಪೇತ್ರನ ಬಳಿಗೂ ಯೇಸು ಪ್ರೀತಿಸಿದ ಇನ್ನೊಬ್ಬ ಶಿಷ್ಯನ ಬಳಿಗೂ ಓಡಿಬಂದು ಅವರಿಗೆ, “ಕರ್ತನನ್ನು ಅವರು ಸಮಾಧಿಯೊಳಗಿಂದ ತೆಗೆದುಕೊಂಡು ಹೋಗಿದ್ದಾರೆ, ಅವರು ಕರ್ತನನ್ನು ಎಲ್ಲಿ ಇಟ್ಟಿದ್ದಾರೋ ನಮಗೆ ಗೊತ್ತಿಲ್ಲ,” ಎಂದು ಹೇಳಿದಳು.<verse eid="JHN 20:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="JHN 20:3"/>ಆಗ ಪೇತ್ರನೂ ಇನ್ನೊಬ್ಬ ಶಿಷ್ಯನೂ ಸಮಾಧಿಯ ಕಡೆಗೆ ಹೊರಟರು. <verse eid="JHN 20:3"/><verse number="4" style="v" sid="JHN 20:4"/>ಅವರಿಬ್ಬರೂ ಜೊತೆಯಾಗಿ ಓಡಿದರು. ಆ ಇನ್ನೊಬ್ಬ ಶಿಷ್ಯನು ಪೇತ್ರನಿಗಿಂತ ಮುಂದೆ ಓಡಿ ಮೊದಲು ಸಮಾಧಿಗೆ ಬಂದನು. <verse eid="JHN 20:4"/><verse number="5" style="v" sid="JHN 20:5"/>ಅವನು ಬಗ್ಗಿ ನೋಡಿದಾಗ ನಾರುಬಟ್ಟೆಗಳು ಬಿದ್ದಿರುವುದನ್ನು ಕಂಡನು. ಆದರೂ ಅವನು ಒಳಗೆ ಪ್ರವೇಶಿಸಲಿಲ್ಲ. <verse eid="JHN 20:5"/><verse number="6" style="v" sid="JHN 20:6"/>ಆಗ ಸೀಮೋನ ಪೇತ್ರನು ಸಹ ಅವನ ಹಿಂದೆ ಬಂದು ನೇರವಾಗಿ ಸಮಾಧಿಯೊಳಕ್ಕೆ ಪ್ರವೇಶಿಸಿ, ನಾರುಬಟ್ಟೆಗಳು ಬಿದ್ದಿರುವುದನ್ನೂ <verse eid="JHN 20:6"/><verse number="7" style="v" sid="JHN 20:7"/>ಯೇಸುವಿನ ತಲೆಗೆ ಸುತ್ತಿದ ವಸ್ತ್ರವು ನಾರುಬಟ್ಟೆಗಳೊಂದಿಗೆ ಇರದೆ ಮಡಚಿ ಪ್ರತ್ಯೇಕವಾಗಿ ಇಟ್ಟಿರುವುದನ್ನು ಕಂಡನು. <verse eid="JHN 20:7"/><verse number="8" style="v" sid="JHN 20:8"/>ಆಗ ಮೊದಲು ಸಮಾಧಿಗೆ ಬಂದಿದ್ದ ಆ ಇನ್ನೊಬ್ಬ ಶಿಷ್ಯನು ಸಹ ಪ್ರವೇಶಿಸಿ, ಕಂಡು ನಂಬಿದನು. <verse eid="JHN 20:8"/><verse number="9" style="v" sid="JHN 20:9"/>ಯೇಸು ಸತ್ತವರೊಳಗಿಂದ ಪುನಃ ಎದ್ದು ಬರಬೇಕು ಎಂಬ ಪವಿತ್ರ ವೇದದ ವಾಕ್ಯವು ಅವರಿಗೆ ಇನ್ನೂ ತಿಳಿದಿರಲಿಲ್ಲ. <verse eid="JHN 20:9"/><verse number="10" style="v" sid="JHN 20:10"/>ತರುವಾಯ ಆ ಶಿಷ್ಯರು ಉಳಿದವರ ಬಳಿಗೆ ಹೊರಟು ಹೋದರು.<verse eid="JHN 20:10"/></para>
  <para style="s1">ಮಗ್ದಲದ ಮರಿಯಳಿಗೆ ಯೇಸುವಿನ ದರ್ಶನ</para>
  <para style="p">
    <verse number="11" style="v" sid="JHN 20:11"/>ಆದರೆ ಮರಿಯಳು ಸಮಾಧಿಯ ಹೊರಗೆ ಅಳುತ್ತಾ ನಿಂತಿದ್ದಳು. ಆಕೆಯು ಅಳುತ್ತಾ ಸಮಾಧಿಯೊಳಗೆ ಬಗ್ಗಿ ನೋಡಿದಾಗ, <verse eid="JHN 20:11"/><verse number="12" style="v" sid="JHN 20:12"/>ಯೇಸುವಿನ ದೇಹವನ್ನು ಇಟ್ಟಿದ್ದ ಸ್ಥಳದಲ್ಲಿ ಬಿಳಿವಸ್ತ್ರಗಳನ್ನು ಧರಿಸಿದ್ದ ಇಬ್ಬರು ದೂತರು, ಒಬ್ಬನು ಯೇಸುವಿನ ತಲೆಯ ಕಡೆಗೂ ಮತ್ತೊಬ್ಬನು ಅವರ ಪಾದಗಳಿದ್ದ ಕಡೆಗೂ ಕುಳಿತಿರುವುದನ್ನು ಕಂಡಳು.<verse eid="JHN 20:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="JHN 20:13"/>ಅವರು ಆಕೆಗೆ, “ಅಮ್ಮಾ, ನೀನು ಏಕೆ ಅಳುತ್ತಿರುವೆ?” ಎಂದು ಕೇಳಲು, ಆಕೆಯು ಅವರಿಗೆ,</para>
  <para style="p" vid="JHN 20:13">“ನನ್ನ ಕರ್ತನನ್ನು ಅವರು ತೆಗೆದುಕೊಂಡು ಹೋಗಿದ್ದಾರೆ. ಕರ್ತನನ್ನು ಅವರು ಎಲ್ಲಿ ಇಟ್ಟಿದ್ದಾರೋ ನನಗೆ ಗೊತ್ತಿಲ್ಲ,” ಎಂದಳು. <verse eid="JHN 20:13"/><verse number="14" style="v" sid="JHN 20:14"/>ಆಕೆಯು ಹೀಗೆ ಹೇಳಿ ಹಿಂದಕ್ಕೆ ತಿರುಗಿದಾಗ ಯೇಸು ನಿಂತಿರುವುದನ್ನು ಕಂಡಳು. ಆದರೆ ಅವರು ಯೇಸುವೇ ಎಂದು ಆಕೆಗೆ ತಿಳಿಯಲಿಲ್ಲ.<verse eid="JHN 20:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="JHN 20:15"/>ಯೇಸು ಆಕೆಗೆ, “ಅಮ್ಮಾ, ನೀನು ಏಕೆ ಅಳುತ್ತಿರುವೆ? ಯಾರನ್ನು ಹುಡುಕುತ್ತಿರುವೆ?” ಎಂದು ಕೇಳಲು,</para>
  <para style="p" vid="JHN 20:15">ಆಕೆಯು ಅವರು ತೋಟಗಾರನೆಂದು ನೆನಸಿ ಅವರಿಗೆ, “ಅಯ್ಯಾ, ನೀನು ಅವರನ್ನು ತೆಗೆದುಕೊಂಡು ಹೋಗಿದ್ದರೆ ಎಲ್ಲಿ ಇಟ್ಟಿದ್ದೀ ಎಂದು ನನಗೆ ಹೇಳು; ನಾನು ಅವರನ್ನು ತೆಗೆದುಕೊಂಡು ಹೋಗುತ್ತೇನೆ,” ಎಂದಳು.<verse eid="JHN 20:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 20:16"/>ಯೇಸು ಆಕೆಗೆ, “ಮರಿಯಳೇ,” ಎಂದು ಹೇಳಲು,</para>
  <para style="p" vid="JHN 20:16">ಆಕೆಯು ತಿರುಗಿಕೊಂಡು ಹೀಬ್ರೂ ಭಾಷೆಯಲ್ಲಿ ಅವರಿಗೆ, <char style="tl">“ರಬ್ಬೂನಿ!”</char> ಎಂದಳು. ಹಾಗೆಂದರೆ “ಬೋಧಕನೇ” ಎಂದರ್ಥ.<verse eid="JHN 20:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="JHN 20:17"/>ಯೇಸು ಆಕೆಗೆ, “ನನ್ನನ್ನು ಹಿಡಿಯಬೇಡ, ಏಕೆಂದರೆ ನಾನು ಇನ್ನೂ ತಂದೆಯ ಬಳಿಗೆ ಹೋಗಲಿಲ್ಲ. ಆದರೆ ನೀನು ನನ್ನ ಸಹೋದರರ ಬಳಿಗೆ ಹೋಗಿ ಅವರಿಗೆ, ‘ನನ್ನ ತಂದೆಯೂ ನಿಮ್ಮ ತಂದೆಯೂ ನನ್ನ ದೇವರೂ ನಿಮ್ಮ ದೇವರೂ ಆಗಿರುವ ತಂದೆಯ ಬಳಿಗೆ ನಾನು ಹೋಗುತ್ತೇನೆ’ ಎಂದು ತಿಳಿಸು,” ಎಂದರು.<verse eid="JHN 20:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="JHN 20:18"/>ಆಗ ಮಗ್ದಲದ ಮರಿಯಳು ಬಂದು, “ನಾನು ಕರ್ತನನ್ನು ಕಂಡಿದ್ದೇನೆ,” ಎಂದು ಹೇಳಿ, ಅವರು ತನಗೆ ಈ ಸಂಗತಿಗಳನ್ನು ಹೇಳಿದರೆಂದು ಶಿಷ್ಯರಿಗೆ ತಿಳಿಸಿದಳು.<verse eid="JHN 20:18"/></para>
  <para style="s1">ಯೇಸು ತಮ್ಮ ಶಿಷ್ಯರಿಗೆ ದರ್ಶನಕೊಟ್ಟದ್ದು</para>
  <para style="p">
    <verse number="19" style="v" sid="JHN 20:19"/>ಅದೇ ಭಾನುವಾರದ ಸಾಯಂಕಾಲದಲ್ಲಿ ಯೆಹೂದ್ಯರ ಭಯದಿಂದ ಶಿಷ್ಯರು ಕೂಡಿದ್ದ ಮನೆಯ ಬಾಗಿಲುಗಳು ಮುಚ್ಚಿದ್ದವು. ಆಗ ಯೇಸು ಬಂದು ಅವರ ಮಧ್ಯೆ ನಿಂತು, “ನಿಮಗೆ ಸಮಾಧಾನವಾಗಲಿ!” ಎಂದು ಅವರಿಗೆ ಹೇಳಿದರು. <verse eid="JHN 20:19"/><verse number="20" style="v" sid="JHN 20:20"/>ಇದನ್ನು ಹೇಳಿದ ಮೇಲೆ ತಮ್ಮ ಕೈಗಳನ್ನೂ ಪಕ್ಕೆಯನ್ನೂ ಅವರಿಗೆ ತೋರಿಸಿದರು. ಆಗ ಶಿಷ್ಯರು ಕರ್ತನನ್ನು ಕಂಡು ಸಂತೋಷಪಟ್ಟರು.<verse eid="JHN 20:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="JHN 20:21"/>ಯೇಸು ತಿರುಗಿ ಅವರಿಗೆ, “ನಿಮಗೆ ಸಮಾಧಾನವಾಗಲಿ, ತಂದೆಯು ನನ್ನನ್ನು ಕಳುಹಿಸಿದಂತೆಯೇ ನಾನು ನಿಮ್ಮನ್ನು ಕಳುಹಿಸಿಕೊಡುತ್ತೇನೆ,” ಎಂದರು. <verse eid="JHN 20:21"/><verse number="22" style="v" sid="JHN 20:22"/>ಯೇಸು ಇದನ್ನು ಹೇಳಿ ಅವರ ಮೇಲೆ ಉಸಿರೂದಿ ಅವರಿಗೆ, “ನೀವು ಪವಿತ್ರಾತ್ಮರನ್ನು ಪಡೆದುಕೊಳ್ಳಿರಿ. <verse eid="JHN 20:22"/><verse number="23" style="v" sid="JHN 20:23"/>ನೀವು ಯಾರ ಪಾಪಗಳನ್ನು ಕ್ಷಮಿಸುತ್ತೀರೋ ಅವು ಅವರಿಗೆ ಕ್ಷಮಿಸಲಾಗುವುದು ಮತ್ತು ಯಾರ ಪಾಪಗಳನ್ನು ನೀವು ಉಳಿಸುತ್ತೀರೋ ಅವು ಅವರಿಗೆ ಉಳಿಸಲಾಗುವುದು,” ಎಂದು ಹೇಳಿದರು.<verse eid="JHN 20:23"/></para>
  <para style="s1">ಯೇಸು ತೋಮನಿಗೆ ದರ್ಶನಕೊಟ್ಟದ್ದು</para>
  <para style="p">
    <verse number="24" style="v" sid="JHN 20:24"/>ಆದರೆ ಯೇಸು ಬಂದಾಗ ಹನ್ನೆರಡು ಮಂದಿಯಲ್ಲಿ ಒಬ್ಬನಾದ ದಿದುಮನು ಎನಿಸಿಕೊಂಡ ತೋಮನು<note caller="+" style="f"><char style="fr" closed="false">20:24 </char><char style="ft" closed="false">ಅರಾಮಿಕ್ ಭಾಷೆಯಲ್ಲಿ </char><char style="fq" closed="false">ತೋಮನು </char><char style="ft" closed="false">ಮತ್ತು ಗ್ರೀಕ್ ಭಾಷೆಯಲ್ಲಿ </char><char style="fq" closed="false">ದಿದುಮ </char><char style="ft" closed="false">ಇವುಗಳ ಅರ್ಥ ಅವಳಿ</char></note> ಅವರ ಸಂಗಡ ಇರಲಿಲ್ಲ. <verse eid="JHN 20:24"/><verse number="25" style="v" sid="JHN 20:25"/>ಉಳಿದ ಶಿಷ್ಯರು ಅವನಿಗೆ, “ನಾವು ಕರ್ತನನ್ನು ಕಂಡಿದ್ದೇವೆ,” ಎಂದು ಹೇಳಿದರು.</para>
  <para style="p" vid="JHN 20:25">ಆದರೆ ಅವನು ಅವರಿಗೆ, “ನಾನು ಅವರ ಕೈಗಳಲ್ಲಿ ಮೊಳೆಗಳ ಗುರುತನ್ನು ಕಂಡು, ಅದರಲ್ಲಿ ನನ್ನ ಬೆರಳನ್ನು ಇಟ್ಟು ಅವರ ಪಕ್ಕೆಯಲ್ಲಿ ನನ್ನ ಕೈಯನ್ನು ಹಾಕಿದ ಹೊರತು ನಂಬುವುದೇ ಇಲ್ಲ,” ಎಂದು ಹೇಳಿದನು.<verse eid="JHN 20:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="JHN 20:26"/>ಎಂಟು ದಿವಸಗಳಾದ ಮೇಲೆ ಯೇಸುವಿನ ಶಿಷ್ಯರು ಪುನಃ ಮನೆಯ ಒಳಗಿದ್ದಾಗ ತೋಮನೂ ಅವರ ಸಂಗಡ ಇದ್ದನು. ಆಗ ಬಾಗಿಲುಗಳು ಮುಚ್ಚಿರಲಾಗಿ ಯೇಸು ಬಂದು ಮಧ್ಯದಲ್ಲಿ ನಿಂತು, “ನಿಮಗೆ ಸಮಾಧಾನವಾಗಲಿ!” ಎಂದರು. <verse eid="JHN 20:26"/><verse number="27" style="v" sid="JHN 20:27"/>ಆಮೇಲೆ ಯೇಸು ತೋಮನಿಗೆ, “ನಿನ್ನ ಬೆರಳನ್ನು ಇಲ್ಲಿ ಇಡು. ನನ್ನ ಕೈಗಳನ್ನು ನೋಡು, ನಿನ್ನ ಕೈಚಾಚಿ ನನ್ನ ಪಕ್ಕೆಯಲ್ಲಿ ಇಡು. ನಂಬದವನಾಗಿರಬೇಡ, ನಂಬುವವನಾಗಿರು,” ಎಂದರು.<verse eid="JHN 20:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="JHN 20:28"/>ಆಗ ತೋಮನು, “ನನ್ನ ಕರ್ತ, ನನ್ನ ದೇವರೇ!” ಎಂದನು.<verse eid="JHN 20:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="JHN 20:29"/>ಯೇಸು ಅವನಿಗೆ, “ನೀನು ನನ್ನನ್ನು ಕಂಡಿದ್ದರಿಂದ ನಂಬಿದ್ದೀಯಾ? ಕಾಣದೆ ನಂಬಿದವರು ಧನ್ಯರು,” ಎಂದರು.<verse eid="JHN 20:29"/></para>
  <para style="s1">ಯೋಹಾನನು ಬರೆದ ಸುವಾರ್ತೆಯ ಉದ್ದೇಶ</para>
  <para style="p">
    <verse number="30" style="v" sid="JHN 20:30"/>ಯೇಸು ಇನ್ನು ಬೇರೆ ಎಷ್ಟೋ ಸೂಚಕಕಾರ್ಯಗಳನ್ನು ಶಿಷ್ಯರ ಮುಂದೆ ಮಾಡಿದರು. ಅವುಗಳು ಈ ಪುಸ್ತಕದಲ್ಲಿ ಬರೆದಿಲ್ಲ. <verse eid="JHN 20:30"/><verse number="31" style="v" sid="JHN 20:31"/>ಆದರೆ ಯೇಸುವೇ ದೇವಪುತ್ರನಾದ ಕ್ರಿಸ್ತನೆಂದು ನೀವು ನಂಬುವಂತೆಯೂ ನಂಬಿ ಅವರ ಹೆಸರಿನ ಮೂಲಕ ನಿತ್ಯಜೀವವನ್ನು ಪಡೆದುಕೊಳ್ಳುವಂತೆಯೂ ಇವುಗಳು ಬರೆಯಲಾಗಿದೆ.<verse eid="JHN 20:31"/></para>
  <chapter eid="JHN 20"/>
  <chapter number="21" style="c" sid="JHN 21"/>
  <para style="s1">ಯೇಸು ಮತ್ತು ಅದ್ಭುತಕರವಾದ ಮೀನು ಹಿಡಿಯುವಿಕೆ</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 21:1"/>ಇವುಗಳಾದ ಮೇಲೆ ಯೇಸು ಗಲಿಲಾಯ<note caller="+" style="f"><char style="fr" closed="false">21:1 </char><char style="ft" closed="false">ಗಲಿಲಾಯದ ಇನ್ನೊಂದು ಹೆಸರು </char><char style="fqa" closed="false">ತಿಬೇರಿ</char></note> ಸರೋವರದ ಬಳಿಯಲ್ಲಿ ಶಿಷ್ಯರಿಗೆ ತಮ್ಮನ್ನು ಪುನಃ ತೋರಿಸಿಕೊಂಡರು. ಅವರು ಈ ರೀತಿಯಾಗಿ ಕಾಣಿಸಿಕೊಂಡರು: <verse eid="JHN 21:1"/><verse number="2" style="v" sid="JHN 21:2"/>ಸೀಮೋನ ಪೇತ್ರನೂ ದಿದುಮನೆಂಬ ತೋಮನೂ ಗಲಿಲಾಯದ ಕಾನಾ ಊರಿನ ನತಾನಯೇಲನೂ ಜೆಬೆದಾಯನ ಮಕ್ಕಳೂ ಅವರ ಶಿಷ್ಯರಲ್ಲಿ ಇನ್ನಿಬ್ಬರೂ ಒಟ್ಟಾಗಿ ಕೂಡಿದ್ದರು. <verse eid="JHN 21:2"/><verse number="3" style="v" sid="JHN 21:3"/>ಆಗ ಸೀಮೋನ ಪೇತ್ರನು ಅವರಿಗೆ, “ನಾನು ಮೀನು ಹಿಡಿಯಲು ಹೋಗುತ್ತೇನೆ,” ಎಂದು ಹೇಳಲು ಅವರು ಅವನಿಗೆ, “ನಾವು ಸಹ ನಿನ್ನ ಸಂಗಡ ಬರುತ್ತೇವೆ,” ಎಂದರು. ಅವರು ಹೊರಟು ದೋಣಿಯನ್ನು ಹತ್ತಿದರು. ಆದರೆ ಆ ರಾತ್ರಿ ಅವರಿಗೆ ಏನೂ ಸಿಗಲಿಲ್ಲ.<verse eid="JHN 21:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="JHN 21:4"/>ಬೆಳಗಾಗುವಷ್ಟರಲ್ಲಿ ಯೇಸು ತೀರದಲ್ಲಿ ನಿಂತಿದ್ದರು. ಆದರೆ ಅವರೇ ಯೇಸು ಎಂದು ಶಿಷ್ಯರಿಗೆ ತಿಳಿಯಲಿಲ್ಲ.<verse eid="JHN 21:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="JHN 21:5"/>ಆಗ ಯೇಸು ಅವರಿಗೆ, “ಮಕ್ಕಳೇ, ನಿಮ್ಮ ಬಳಿಯಲ್ಲಿ ಮೀನುಗಳಿವೆಯೋ?” ಎಂದು ಕೇಳಲು,</para>
  <para style="p" vid="JHN 21:5">ಅವರು ಯೇಸುವಿಗೆ, “ಇಲ್ಲ,” ಎಂದು ಉತ್ತರಕೊಟ್ಟರು.<verse eid="JHN 21:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="JHN 21:6"/>ಯೇಸು ಶಿಷ್ಯರಿಗೆ, “ದೋಣಿಯ ಬಲಗಡೆಯಲ್ಲಿ ಬಲೆ ಬೀಸಿರಿ; ನಿಮಗೆ ಮೀನು ಸಿಗುತ್ತವೆ,” ಎಂದರು. ಅವರು ಬಲೆ ಬೀಸಿದಾಗ ಮೀನುಗಳ ರಾಶಿ ಬಲೆಗೆ ಬಿದ್ದದರ ದೆಸೆಯಿಂದ ಅವರಿಗೆ ಎಳೆಯುವುದಕ್ಕೆ ಆಗದೆ ಹೋಯಿತು.<verse eid="JHN 21:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="JHN 21:7"/>ಯೇಸು ಪ್ರೀತಿಸಿದ ಆ ಶಿಷ್ಯನು ಪೇತ್ರನಿಗೆ, “ಆತನು ಕರ್ತನೇ,” ಎಂದನು. ಅದನ್ನು ಕೇಳಿ ಸೀಮೋನ ಪೇತ್ರನು ತಾನು ತೆಗೆದುಬಿಟ್ಟಿದ್ದ ತನ್ನ ಮೇಲಂಗಿಯನ್ನು ಸುತ್ತಿಕೊಂಡು ಸಮುದ್ರದೊಳಗೆ ಧುಮುಕಿದನು. <verse eid="JHN 21:7"/><verse number="8" style="v" sid="JHN 21:8"/>ಉಳಿದ ಶಿಷ್ಯರು ಮೀನುಗಳಿದ್ದ ಬಲೆಯನ್ನು ಎಳೆಯುತ್ತಾ ಆ ದೋಣಿಯಲ್ಲಿ ಬಂದರು. ಏಕೆಂದರೆ ಅವರು ದಡದಿಂದ ಹೆಚ್ಚು ದೂರವಿರಲಿಲ್ಲ. ಸುಮಾರು ತೊಂಬತ್ತು ಮೀಟರ್ ದೂರವಿತ್ತು. <verse eid="JHN 21:8"/><verse number="9" style="v" sid="JHN 21:9"/>ಅವರು ದಡವನ್ನು ಸೇರಿದಾಗ, ಕೆಂಡಗಳನ್ನೂ ಅವುಗಳ ಮೇಲೆ ಇಟ್ಟಿದ್ದ ಮೀನುಗಳನ್ನೂ ರೊಟ್ಟಿಯನ್ನೂ ಕಂಡರು.<verse eid="JHN 21:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="JHN 21:10"/>ಯೇಸು ಅವರಿಗೆ, “ನೀವು ಈಗ ಹಿಡಿದ ಮೀನುಗಳಲ್ಲಿ ಕೆಲವನ್ನು ತನ್ನಿರಿ,” ಎಂದರು. <verse eid="JHN 21:10"/><verse number="11" style="v" sid="JHN 21:11"/>ಸೀಮೋನ ಪೇತ್ರನು ಹೋಗಿ ನೂರೈವತ್ತಮೂರು ದೊಡ್ಡ ಮೀನುಗಳಿಂದ ತುಂಬಿದ ಬಲೆಯನ್ನು ದಡಕ್ಕೆ ಎಳೆದನು. ಅಷ್ಟು ಮೀನುಗಳಿದ್ದರೂ ಬಲೆಯು ಹರಿದಿರಲಿಲ್ಲ. <verse eid="JHN 21:11"/><verse number="12" style="v" sid="JHN 21:12"/>ಯೇಸು ಅವರಿಗೆ, “ಬಂದು ಉಪಹಾರ ಮಾಡಿರಿ,” ಎಂದರು; ಅವರು ಸ್ವಾಮಿಯವರೆಂದು ತಿಳಿದಿದ್ದರಿಂದ, “ನೀನು ಯಾರು?” ಎಂದು ಅವರನ್ನು ಕೇಳಲು ಶಿಷ್ಯರಲ್ಲಿ ಒಬ್ಬರಿಗೂ ಧೈರ್ಯವಿರಲಿಲ್ಲ. <verse eid="JHN 21:12"/><verse number="13" style="v" sid="JHN 21:13"/>ಆಗ ಯೇಸು ಬಂದು ರೊಟ್ಟಿಯನ್ನು ತೆಗೆದುಕೊಂಡು ಅವರಿಗೆ ಕೊಟ್ಟರು. ಹಾಗೆಯೇ ಮೀನನ್ನೂ ಕೊಟ್ಟರು. <verse eid="JHN 21:13"/><verse number="14" style="v" sid="JHN 21:14"/>ಯೇಸು ಸತ್ತವರೊಳಗಿಂದ ಎದ್ದ ಮೇಲೆ ತಮ್ಮ ಶಿಷ್ಯರಿಗೆ ಕಾಣಿಸಿಕೊಂಡದ್ದು ಇದು ಮೂರನೆಯ ಸಾರಿ.<verse eid="JHN 21:14"/></para>
  <para style="s1">ಯೇಸು ಪೇತ್ರನನ್ನು ಪುನಃಸ್ಥಾಪಿಸಿದ್ದು</para>
  <para style="p">
    <verse number="15" style="v" sid="JHN 21:15"/>ಅವರು ಉಪಹಾರ ಮಾಡಿದ ಮೇಲೆ ಯೇಸು ಸೀಮೋನ ಪೇತ್ರನಿಗೆ, “ಯೋಹಾನನ ಮಗ ಸೀಮೋನನೇ, ನೀನು ಇವರಿಗಿಂತ ನನ್ನನ್ನು ಹೆಚ್ಚಾಗಿ ಪ್ರೀತಿಸುತ್ತೀಯೋ?” ಎಂದು ಕೇಳಲು,</para>
  <para style="p" vid="JHN 21:15">ಅವನು ಯೇಸುವಿಗೆ, “ಹೌದು, ಕರ್ತನೇ, ನಾನು ನಿನ್ನ ಮೇಲೆ ಮಮತೆ ಇಟ್ಟಿದ್ದೇನೆಂದು ನೀನೇ ಬಲ್ಲೆ,” ಎಂದನು.</para>
  <para style="p" vid="JHN 21:15">ಅದಕ್ಕೆ ಯೇಸು ಅವನಿಗೆ, “ನನ್ನ ಕುರಿಮರಿಗಳನ್ನು ಮೇಯಿಸು,” ಎಂದು ಹೇಳಿದರು.<verse eid="JHN 21:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 21:16"/>ಯೇಸು ತಿರುಗಿ ಎರಡನೆಯ ಸಾರಿ ಅವನಿಗೆ, “ಯೋಹಾನನ ಮಗ ಸೀಮೋನನೇ, ನೀನು ನನ್ನನ್ನು ಪ್ರೀತಿಸುತ್ತೀಯೋ?” ಎಂದು ಕೇಳಲು,</para>
  <para style="p" vid="JHN 21:16">ಪೇತ್ರನು ಯೇಸುವಿಗೆ, “ಹೌದು ಕರ್ತನೇ, ನಾನು ನಿಮ್ಮ ಮೇಲೆ ಮಮತೆ ಇಟ್ಟಿದ್ದೇನೆಂದು ನೀವೇ ಬಲ್ಲಿರಿ,” ಎಂದನು.</para>
  <para style="p" vid="JHN 21:16">ಅದಕ್ಕೆ ಯೇಸು ಅವನಿಗೆ, “ನನ್ನ ಕುರಿಗಳನ್ನು ರಕ್ಷಿಸು,” ಎಂದು ಹೇಳಿದರು.<verse eid="JHN 21:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="JHN 21:17"/>ಯೇಸು ಮೂರನೆಯ ಸಾರಿ ಪೇತ್ರನಿಗೆ, “ಯೋಹಾನನ ಮಗನಾದ ಸೀಮೋನನೇ, ನೀನು ನನ್ನ ಮೇಲೆ ಮಮತೆ ಇಟ್ಟಿದ್ದೀಯೋ?” ಎಂದು ಕೇಳಿದರು.</para>
  <para style="p" vid="JHN 21:17">ಯೇಸು ಮೂರನೆಯ ಸಾರಿ, “ನೀನು ನನ್ನ ಮೇಲೆ ಮಮತೆ ಇಟ್ಟಿದ್ದೀಯೋ?” ಎಂದು ತನ್ನನ್ನು ಕೇಳಿದ್ದಕ್ಕೆ ಪೇತ್ರನು ದುಃಖಪಟ್ಟು, “ಕರ್ತನೇ, ನಿಮಗೆ ಎಲ್ಲವೂ ತಿಳಿದಿದೆ. ನಾನು ನಿಮ್ಮ ಮೇಲೆ ಎಷ್ಟು ಮಮತೆ ಇಟ್ಟಿದ್ದೇನೆಂದು ನಿಮಗೆ ತಿಳಿದಿದೆ,” ಎಂದನು.</para>
  <para style="p" vid="JHN 21:17">ಆಗ ಯೇಸು ಪೇತ್ರನಿಗೆ, “ನನ್ನ ಕುರಿಗಳನ್ನು ಮೇಯಿಸು,” ಎಂದರು. <verse eid="JHN 21:17"/><verse number="18" style="v" sid="JHN 21:18"/>ನಾನು ನಿನಗೆ ನಿಜನಿಜವಾಗಿ ಹೇಳುತ್ತೇನೆ, “ನೀನು ಯುವಕನಾಗಿದ್ದಾಗ ನೀನೇ ನಿನ್ನ ಉಡುಪನ್ನು ಧರಿಸಿಕೊಂಡು ಇಷ್ಟ ಬಂದ ಕಡೆಗೆ ತಿರುಗಾಡುತ್ತಿದ್ದೆ. ಆದರೆ ನೀನು ವೃದ್ಧನಾದಾಗ ನಿನ್ನ ಕೈಗಳನ್ನು ಚಾಚುವೆ, ಆಗ ಮತ್ತೊಬ್ಬನು ನಿನ್ನ ನಡುವನ್ನು ಕಟ್ಟಿ ನಿನಗೆ ಇಷ್ಟವಿಲ್ಲದ ಕಡೆಗೆ ನಿನ್ನನ್ನು ಹೊತ್ತುಕೊಂಡು ಹೋಗುವನು,” ಎಂದರು. <verse eid="JHN 21:18"/><verse number="19" style="v" sid="JHN 21:19"/>ಅವನು ಎಂಥ ಮರಣದಿಂದ ದೇವರನ್ನು ಮಹಿಮೆ ಪಡಿಸುವನು ಎಂಬುದನ್ನು ಸೂಚಿಸಿ ಯೇಸು ಇದನ್ನು ಹೇಳಿದರು. ಅವರು ಇದನ್ನು ಹೇಳಿ ಪೇತ್ರನಿಗೆ, “ನನ್ನನ್ನು ಹಿಂಬಾಲಿಸು,” ಎಂದರು.<verse eid="JHN 21:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="JHN 21:20"/>ಪೇತ್ರನು ತಿರುಗಿ ಕಂಡಾಗ ಯೇಸುವನ್ನು ಪ್ರೀತಿಸಿದಂಥ ಶಿಷ್ಯನು ಅವರ ಹಿಂದೆ ಬರುವುದನ್ನು ಕಂಡನು. ಯೇಸುವಿನ ಎದೆಗೆ ಒರಗಿಕೊಂಡು, “ಕರ್ತನೇ, ನಿನ್ನನ್ನು ಹಿಡಿದುಕೊಡುವವನು ಯಾರು?” ಎಂದು ಕೇಳಿದಂಥವನು ಇವನೇ. <verse eid="JHN 21:20"/><verse number="21" style="v" sid="JHN 21:21"/>ಇವನನ್ನು ಪೇತ್ರನು ಕಂಡು ಯೇಸುವಿಗೆ, “ಕರ್ತನೇ, ಇವನ ವಿಷಯವೇನು?” ಎಂದನು.<verse eid="JHN 21:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 21:22"/>ಯೇಸು ಅವನಿಗೆ, “ನಾನು ಬರುವ ತನಕ ಅವನು ಉಳಿದಿರಬೇಕೆಂಬುದು ನನಗೆ ಮನಸ್ಸಿದ್ದರೆ ಅದು ನಿನಗೇನು? ನೀನು ನನ್ನನ್ನು ಹಿಂಬಾಲಿಸು,” ಎಂದರು. <verse eid="JHN 21:22"/><verse number="23" style="v" sid="JHN 21:23"/>ಆದ್ದರಿಂದ ಆ ಶಿಷ್ಯನು ಸಾಯುವುದಿಲ್ಲವೆಂಬ ಮಾತು ಸಹೋದರರಲ್ಲಿ ಹಬ್ಬಿತು. ಆದರೂ ಅವನು ಸಾಯುವುದಿಲ್ಲವೆಂದು ಯೇಸು ಅವನಿಗೆ ಹೇಳಲಿಲ್ಲ. “ನಾನು ಬರುವ ತನಕ ಅವನು ಉಳಿದಿರಬೇಕೆಂಬುದು ನನಗೆ ಮನಸ್ಸಿದ್ದರೆ ಅದು ನಿನಗೇನು?” ಎಂದು ಮಾತ್ರ ಹೇಳಿದರು.<verse eid="JHN 21:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="JHN 21:24"/>ಇವುಗಳ ವಿಷಯವಾಗಿ ಸಾಕ್ಷಿಕೊಟ್ಟು, ಇವುಗಳನ್ನು ಬರೆದ ಶಿಷ್ಯನು ಅವನೇ, ಅವನ ಸಾಕ್ಷಿಯು ಸತ್ಯವೆಂದು ನಾವು ಬಲ್ಲೆವು.<verse eid="JHN 21:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 21:25"/>ಇದಲ್ಲದೆ ಯೇಸು ಮಾಡಿದ ಬೇರೆ ಅನೇಕ ಸಂಗತಿಗಳು ಸಹ ಇವೆ. ಅವುಗಳನ್ನು ಒಂದೊಂದಾಗಿ ಬರೆಯುವುದಾದರೆ, ಬರೆಯಬೇಕಾದ ಪುಸ್ತಕಗಳನ್ನು ಲೋಕವೇ ಸಾಕಾಗುವುದಿಲ್ಲ ಎಂದು ನಾನು ನೆನಸುತ್ತೇನೆ.<verse eid="JHN 21:25"/></para>
  <chapter eid="JHN 21"/>
</usx>
