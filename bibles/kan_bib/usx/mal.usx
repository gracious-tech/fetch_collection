<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="MAL" style="id">- Biblica® Open Kannada Contemporary Version</book>
  <para style="h">ಮಲಾಕಿ</para>
  <para style="toc1">ಮಲಾಕಿ</para>
  <para style="toc2">ಮಲಾಕಿ</para>
  <para style="toc3">ಮಲಾಕಿ</para>
  <para style="mt1">ಮಲಾಕಿ</para>
  <chapter number="1" style="c" sid="MAL 1"/>
  <para style="p">
    <verse number="1" style="v" sid="MAL 1:1"/>ಒಂದು ಪ್ರವಾದನೆ: ಇಸ್ರಾಯೇಲಿಗೆ ಮಲಾಕಿಯನ<note caller="+" style="f"><char style="fr" closed="false">1:1 </char><char style="fq" closed="false">ಮಲಾಕಿಯನ </char><char style="ft" closed="false">ಅಂದರೆ </char><char style="fqa" closed="false">ನನ್ನ ದೂತರು</char></note> ಮುಖಾಂತರ ಬಂದ ಯೆಹೋವ ದೇವರ ವಾಕ್ಯ:<verse eid="MAL 1:1"/></para>
  <para style="s1">ಯಾಕೋಬನನ್ನು ಪ್ರೀತಿಸಿ, ಏಸಾವನನ್ನು ದ್ವೇಷ ಮಾಡಿದ್ದು</para>
  <para style="p">
    <verse number="2" style="v" sid="MAL 1:2"/>“ನಾನು ನಿಮ್ಮನ್ನು ಪ್ರೀತಿ ಮಾಡಿದೆನು” ಎಂದು ಯೆಹೋವ ದೇವರು ಹೇಳುತ್ತಾರೆ.</para>
  <para style="p" vid="MAL 1:2">“ನೀವಾದರೋ, ‘ಯಾವುದರಲ್ಲಿ ನೀವು ನಮ್ಮನ್ನು ಪ್ರೀತಿ ಮಾಡಿದ್ದೀರಿ?’ ಎಂದು ಕೇಳುತ್ತೀರಿ.</para>
  <para style="p" vid="MAL 1:2">“ಏಸಾವನು ಯಾಕೋಬನಿಗೆ ಅಣ್ಣನಲ್ಲವೋ? ಆದರೂ ನಾನು ಯಾಕೋಬನನ್ನು ಪ್ರೀತಿ ಮಾಡಿದೆನು. ಎಂದು ಯೆಹೋವ ದೇವರು ಅನ್ನುತ್ತಾರೆ. <verse eid="MAL 1:2"/><verse number="3" style="v" sid="MAL 1:3"/>ಏಸಾವನನ್ನು ದ್ವೇಷ ಮಾಡಿದೆನು. ಅವನ ಬೆಟ್ಟಗಳನ್ನು ಹಾಳು ಮಾಡಿ, ಅವನ ಸೊತ್ತನ್ನು ಅಡವಿಯ ನರಿಗಳಿಗೆ ಕೊಟ್ಟೆನು.”<verse eid="MAL 1:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="MAL 1:4"/>ಎದೋಮ್ಯರು, “ನಾವು ಬಡಕಲಾದೆವು, ಆದರೆ ನಾವು ಮತ್ತೆ ಹಾಳಾದ ಸ್ಥಳಗಳನ್ನು ಕಟ್ಟುವೆವು,” ಎಂದು ಹೇಳಬಹುದು.</para>
  <para style="p" vid="MAL 1:4">ಸೇನಾಧೀಶ್ವರ ಯೆಹೋವ ದೇವರು ಹೀಗೆ ಹೇಳುತ್ತಾರೆ, “ಅವರು ಕಟ್ಟಬಹುದು, ಆದರೆ ನಾನು ಕೆಡವಿಬಿಡುವೆನು. ಜನರು ಅವರನ್ನು ದುಷ್ಟತನದ ನಾಡೆಂದೂ, ಯೆಹೋವ ದೇವರು ಎಂದೆಂದಿಗೂ ಸಿಟ್ಟು ಮಾಡುವ ಜನವೆಂದೂ ಕರೆಯುವರು. <verse eid="MAL 1:4"/><verse number="5" style="v" sid="MAL 1:5"/>ನಿಮ್ಮ ಕಣ್ಣುಗಳಿಂದ ನೋಡಿ, ‘ಇಸ್ರಾಯೇಲಿನ ಮೇರೆ ಆಚೆಗೂ ಯೆಹೋವ ದೇವರು ಮಹೋನ್ನತರು!’ ಎಂದು ನೀವು ಹೇಳುವಿರಿ.”<verse eid="MAL 1:5"/></para>
  <para style="s1">ಅಶುದ್ಧವಾದ ಯಜ್ಞಗಳು</para>
  <para style="p">
    <verse number="6" style="v" sid="MAL 1:6"/>“ಮಗನು ತಂದೆಯನ್ನೂ, ದಾಸನು ಯಜಮಾನನನ್ನೂ ಸನ್ಮಾನಿಸುತ್ತಾನೆ. ಹಾಗಾದರೆ ನಾನು ತಂದೆಯಾಗಿದ್ದರೆ ನನ್ನ ಸನ್ಮಾನವೆಲ್ಲಿ? ನಾನು ಯಜಮಾನನಾಗಿದ್ದರೆ ನನಗೆ ತೋರಿಸುವ ಭಯಭಕ್ತಿಯೆಲ್ಲಿ?”</para>
  <para style="p" vid="MAL 1:6">“ನನ್ನ ಹೆಸರನ್ನು ಅಸಡ್ಡೆ ಮಾಡುವ ಯಾಜಕರು ನೀವೇ ಎಂದು ಸೇನಾಧೀಶ್ವರ ಯೆಹೋವ ದೇವರು ಹೇಳುತ್ತಾರೆ.</para>
  <para style="p" vid="MAL 1:6">“ಆದರೆ ನೀವು, ‘ನಿಮ್ಮ ಹೆಸರನ್ನು ಯಾವುದರಲ್ಲಿ ನಾವು ಅಸಡ್ಡೆ ಮಾಡಿದ್ದೇವೆ?’ ಎಂದು ಕೇಳುತ್ತೀರಿ.”<verse eid="MAL 1:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="MAL 1:7"/>“ನನ್ನ ಬಲಿಪೀಠದ ಮೇಲೆ ಅಪವಿತ್ರವಾದ ರೊಟ್ಟಿಯನ್ನು ಅರ್ಪಿಸುತ್ತೀರಿ.</para>
  <para style="p" vid="MAL 1:7">“ ‘ಯಾವುದರಲ್ಲಿ ನಿಮ್ಮನ್ನು ನಾವು ಅಪವಿತ್ರ ಮಾಡಿದ್ದೇವೆ?’ ಎಂದು ಕೇಳುತ್ತೀರಿ.”</para>
  <para style="p" vid="MAL 1:7">ಯೆಹೋವ ದೇವರ ಮೇಜು ಹೀನವಾದದ್ದೆಂದು ನೀವು ಹೇಳುವುದರಿಂದಲೇ! <verse eid="MAL 1:7"/><verse number="8" style="v" sid="MAL 1:8"/>ಇದಲ್ಲದೆ, ಕುರುಡಾದ ಪಶುಗಳನ್ನು ಬಲಿಗಾಗಿ ಅರ್ಪಿಸಿದರೆ, ಅದು ದೋಷವಲ್ಲವೋ? ಕುಂಟಾದ ಮತ್ತು ರೋಗವುಳ್ಳ ಪಶುಗಳನ್ನು ಅರ್ಪಿಸಿದರೆ, ಅದು ಕೆಟ್ಟದ್ದಲ್ಲವೋ? “ಅದನ್ನು ನಿನ್ನ ರಾಜ್ಯಪಾಲನಿಗೆ ಅರ್ಪಿಸು, ಅವನು ನಿನ್ನನ್ನು ಮೆಚ್ಚುವನೋ? ನಿಮ್ಮನ್ನು ಸ್ವೀಕಾರ ಮಾಡುವನೋ?” ಎಂದು ಸೇನಾಧೀಶ್ವರ ಯೆಹೋವ ದೇವರು ಹೇಳುತ್ತಾರೆ.<verse eid="MAL 1:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="MAL 1:9"/>“ಈಗ ದೇವರು ನಮ್ಮನ್ನು ಕನಿಕರಿಸುವ ಹಾಗೆ ಆತನನ್ನು ಬೇಡಿಕೊಳ್ಳಿರಿ. ನಿಮ್ಮ ಕೈಗಳಿಂದ ಅಂಥ ಅರ್ಪಣೆಯನ್ನು ಅವರು ಸ್ವೀಕರಿಸುವರೋ?” ಎಂದು ಸೇನಾಧೀಶ್ವರ ಯೆಹೋವ ದೇವರು ಹೇಳುತ್ತಾರೆ.<verse eid="MAL 1:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="MAL 1:10"/>“ನನ್ನ ಬಲಿಪೀಠದ ಮೇಲೆ ವ್ಯರ್ಥವಾಗಿ ಬೆಂಕಿ ಹಚ್ಚುವುದಕ್ಕಿಂತ, ಬಾಗಿಲು ಮುಚ್ಚುವುದು ಒಳ್ಳೆಯದು. ನಿಮ್ಮಲ್ಲಿ ನನಗೆ ಇಷ್ಟವಿಲ್ಲ ಮತ್ತು ನಿಮ್ಮ ಕೈಯಿಂದ ನಾನು ಕಾಣಿಕೆಯನ್ನು ಅಂಗೀಕರಿಸುವುದಿಲ್ಲ. <verse eid="MAL 1:10"/><verse number="11" style="v" sid="MAL 1:11"/>ಸೂರ್ಯೋದಯವು ಮೊದಲುಗೊಂಡು ಅಸ್ತಮಾನದವರೆಗೂ, ನನ್ನ ಹೆಸರು ಎಲ್ಲಾ ಜನಾಂಗಗಳಲ್ಲಿ ಘನವಾಗಿರುವುದು. ಪ್ರತಿಯೊಂದು ಸ್ಥಳದಲ್ಲಿಯೂ ನನ್ನ ಹೆಸರಿಗೆ ಧೂಪವೂ, ಶುದ್ಧ ಕಾಣಿಕೆಯೂ ಅರ್ಪಿಸಲಾಗುವುದು. ಏಕೆಂದರೆ ನನ್ನ ಹೆಸರು ಇತರ ಜನಾಂಗಗಳಲ್ಲಿ ಘನವಾಗಿರುವುದು,” ಎಂದು ಸೇನಾಧೀಶ್ವರ ಯೆಹೋವ ದೇವರು ಹೇಳುತ್ತಾರೆ.<verse eid="MAL 1:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="MAL 1:12"/>“ಆದರೆ ನೀವು ಯೆಹೋವ ದೇವರ ಮೇಜು ಅಶುದ್ಧ, ‘ಅದರ ಫಲವೂ, ಅದರ ಆಹಾರವೂ ಅಸಹ್ಯ,’ ಎಂದು ಹೇಳಿ ಅದನ್ನು ಅಪವಿತ್ರ ಮಾಡಿದ್ದೀರಿ. <verse eid="MAL 1:12"/><verse number="13" style="v" sid="MAL 1:13"/>ಇದಲ್ಲದೆ ನೀವು, ‘ಎಂಥಾ ಭಾರ,’ ಎಂದು ಹೇಳಿ, ನೀವು ಅದನ್ನು ತಿರಸ್ಕಾರದಿಂದ ಊದಿಬಿಟ್ಟಿರಿ,” ಎಂದು ಸೇನಾಧೀಶ್ವರ ಯೆಹೋವ ದೇವರು ಹೇಳುತ್ತಾರೆ.</para>
  <para style="p" vid="MAL 1:13">“ಗಾಯವಾದದ್ದನ್ನೂ, ಕುಂಟಾದ ರೋಗವುಳ್ಳ ಪಶುವನ್ನೂ ನನಗೆ ಬಲಿಯಾಗಿ ಅರ್ಪಿಸುತ್ತೀರಿ. ನಾನು ಇದನ್ನು ನಿಮ್ಮ ಕೈಯಿಂದ ಅಂಗೀಕರಿಸಬಹುದೋ?” ಎಂದು ಯೆಹೋವ ದೇವರು ಹೇಳುತ್ತಾರೆ. <verse eid="MAL 1:13"/><verse number="14" style="v" sid="MAL 1:14"/>“ಆದರೆ ತನ್ನ ಮಂದೆಯಲ್ಲಿ ದೋಷವಿಲ್ಲದ ಗಂಡು ಪಶು ಇರಲಾಗಿ ಅದನ್ನು ಅರ್ಪಿಸಲು ಪ್ರಮಾಣಮಾಡಿ, ಯೆಹೋವ ದೇವರಿಗೆ ದೋಷವುಳ್ಳದ್ದನ್ನು ಅರ್ಪಿಸುವ ಮೋಸಗಾರನಿಗೆ ಶಾಪ, ಏಕೆಂದರೆ ನಾನು ಮಹಾ ಅರಸನು, ನನ್ನ ಹೆಸರು ಇತರ ಜನಾಂಗಗಳಲ್ಲಿ ಭಯಭಕ್ತಿಯುಳ್ಳದ್ದಾಗಿರಬೇಕು,” ಎಂದು ಸೇನಾಧೀಶ್ವರ ಯೆಹೋವ ದೇವರು ಹೇಳುತ್ತಾರೆ.<verse eid="MAL 1:14"/></para>
  <chapter eid="MAL 1"/>
  <chapter number="2" style="c" sid="MAL 2"/>
  <para style="s1">ಯಾಜಕರಿಗೆ ಎಚ್ಚರಿಕೆ</para>
  <para style="p">
    <verse number="1" style="v" sid="MAL 2:1"/>“ಈಗ ಯಾಜಕರೇ, ಈ ಎಚ್ಚರಿಕೆ ನಿಮಗಾಗಿ ಇದೆ. <verse eid="MAL 2:1"/><verse number="2" style="v" sid="MAL 2:2"/>ಸೇನಾಧೀಶ್ವರ ಯೆಹೋವ ದೇವರು ಹೇಳುವುದೇನೆಂದರೆ,” ನೀವು ಕಿವಿಗೊಡದೆ ನನ್ನ ಹೆಸರಿಗೆ ಮಹಿಮೆಯನ್ನು ಸಲ್ಲಿಸಲು ನಿಮ್ಮ ಹೃದಯಗಳನ್ನು ದೃಢಪಡಿಸಿಕೊಳ್ಳದೆ ಹೋದರೆ, “ನಿಮ್ಮ ಮೇಲೆ ಶಾಪವನ್ನು ಕಳುಹಿಸುವೆನು. ನಿಮ್ಮ ಆಶೀರ್ವಾದಗಳನ್ನು ಶಪಿಸುವೆನು. ಹೌದು, ಅವುಗಳನ್ನು ಆಗಲೇ ಶಪಿಸಿದ್ದಾಯಿತು, ಏಕೆಂದರೆ ನೀವು ನನ್ನನ್ನು ಘನಪಡಿಸಲು ನಿಮ್ಮ ಹೃದಯಗಳನ್ನು ದೃಢಪಡಿಸಿಕೊಳ್ಳಲಿಲ್ಲ.<verse eid="MAL 2:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="MAL 2:3"/>“ಇಗೋ, ನಾನು ನಿಮ್ಮ ಸಂತತಿಯನ್ನು ಗದರಿಸುವೆನು. ನಿಮ್ಮ ಮುಖಗಳ ಮೇಲೆ, ನಿಮ್ಮ ಹಬ್ಬ ಬಲಿಗಳ ಸಗಣಿ ಬಳಿಯುವೆನು. ಅದರೊಂದಿಗೆ ನೀವು ಒಯ್ಯಲಾಗುವಿರಿ. <verse eid="MAL 2:3"/><verse number="4" style="v" sid="MAL 2:4"/>ನಾನು ಲೇವಿಯೊಂದಿಗೆ ಮಾಡಿಕೊಂಡ ಒಡಂಬಡಿಕೆಯು ಮುಂದುವರಿಯುತ್ತದೆ. ಈ ಎಚ್ಚರಿಕೆಯನ್ನು ನಿಮಗೆ ಕಳುಹಿಸಿದ್ದೇನೆಂದು ತಿಳಿದುಕೊಳ್ಳಿರಿ,” ಎಂದು ಸೇನಾಧೀಶ್ವರ ಯೆಹೋವ ದೇವರು ಹೇಳುತ್ತಾರೆ. <verse eid="MAL 2:4"/><verse number="5" style="v" sid="MAL 2:5"/>“ನಮ್ಮ ಒಡಂಬಡಿಕೆಯು ಜೀವದ ಹಾಗೂ ಶಾಂತಿಯ ಒಡಂಬಡಿಕೆಯಾಗಿತ್ತು. ಅವುಗಳನ್ನು ನಾನೇ ಅವನಿಗೆ ಕೊಟ್ಟೆನು. ಅವನು ನನಗೆ ಭಯಪಟ್ಟು, ನನ್ನ ಹೆಸರನ್ನು ಘನಪಡಿಸಿದನು. <verse eid="MAL 2:5"/><verse number="6" style="v" sid="MAL 2:6"/>ಸತ್ಯ ಬೋಧನೆಯು ಅವನ ಬಾಯಲ್ಲಿ ಇತ್ತು. ಸುಳ್ಳು ಅವನ ತುಟಿಗಳಲ್ಲಿ ಸಿಕ್ಕಲಿಲ್ಲ. ಅವನು ಸಮಾಧಾನದಿಂದಲೂ, ನ್ಯಾಯದಿಂದಲೂ ನನ್ನ ಸಂಗಡ ನಡೆದುಕೊಂಡು, ಅನೇಕರನ್ನು ಪಾಪದ ಕಡೆಯಿಂದ ತಿರುಗಿಸಿದನು.<verse eid="MAL 2:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="MAL 2:7"/>“ಯಾಜಕನ ತುಟಿಗಳು ತಿಳುವಳಿಕೆಯನ್ನು ಕಾಪಾಡ ತಕ್ಕದ್ದು. ದೈವ ಬೋಧನೆಯನ್ನು ಅವನ ಬಾಯಲ್ಲಿ ಹುಡುಕತಕ್ಕದ್ದು, ಏಕೆಂದರೆ ಅವನು ಸೇನಾಧೀಶ್ವರ ಯೆಹೋವ ದೇವರ ದೂತನು. <verse eid="MAL 2:7"/><verse number="8" style="v" sid="MAL 2:8"/>ಆದರೆ ನೀವು ಮಾರ್ಗವನ್ನು ಬಿಟ್ಟುಹೋಗಿದ್ದೀರಿ. ನಿಮ್ಮ ಉಪದೇಶದಿಂದ ಅನೇಕರನ್ನು ಎಡವುವಂತೆ ಮಾಡಿದ್ದೀರಿ. ಲೇವಿಯರೊಂದಿಗಿನ ಒಡಂಬಡಿಕೆಯನ್ನು ಭಂಗಪಡಿಸಿದ್ದೀರಿ” ಎಂದು ಸೇನಾಧೀಶ್ವರ ಯೆಹೋವ ದೇವರು ಹೇಳುತ್ತಾರೆ. <verse eid="MAL 2:8"/><verse number="9" style="v" sid="MAL 2:9"/>“ಆದ್ದರಿಂದ ನೀವು ನನ್ನ ಮಾರ್ಗಗಳನ್ನು ಕೈಗೊಳ್ಳದೆ, ನನ್ನ ನಿಯಮವನ್ನು ಬೋಧಿಸುವಾಗ ಮುಖದಾಕ್ಷಿಣ್ಯ ಮಾಡಿದ ಪ್ರಕಾರವೇ, ನಾನು ನಿಮ್ಮನ್ನು ಜನರೆಲ್ಲರ ಮುಂದೆ ಅಸಡ್ಡೆಯಾದವರನ್ನಾಗಿಯೂ, ನೀಚರನ್ನಾಗಿಯೂ ಮಾಡುವೆನು.”<verse eid="MAL 2:9"/></para>
  <para style="s1">ವಿಚ್ಛೇದನದ ಮೂಲಕ ಒಡಂಬಡಿಕೆಯನ್ನು ಮುರಿಯುವುದು</para>
  <para style="p">
    <verse number="10" style="v" sid="MAL 2:10"/>ನಮ್ಮೆಲ್ಲರಿಗೆ ಒಬ್ಬನೇ ತಂದೆಯಲ್ಲವೋ? ನಮ್ಮನ್ನು ಒಬ್ಬರೇ ದೇವರು ಸೃಷ್ಟಿಸಿದರಲ್ಲವೋ? ಏಕೆ ಪ್ರತಿಯೊಬ್ಬನು ತನ್ನ ಸಹೋದರನಿಗೆ ವಿರೋಧವಾಗಿ ವಂಚನೆಯಾಗಿ ನಡೆದು, ನಮ್ಮ ತಂದೆಗಳ ಒಡಂಬಡಿಕೆಯನ್ನು ಮುರಿಯುವುದೇಕೆ?<verse eid="MAL 2:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="MAL 2:11"/>ಯೆಹೂದವು ವಂಚನೆಯಾಗಿ ನಡೆದುಕೊಂಡಿದೆ. ಇಸ್ರಾಯೇಲಿನಲ್ಲಿಯೂ, ಯೆರೂಸಲೇಮಿನಲ್ಲಿಯೂ ಅಸಹ್ಯವಾದದ್ದನ್ನು ಮಾಡಿದೆ, ಏಕೆಂದರೆ ಯೆಹೂದವು ಯೆಹೋವ ದೇವರು ಪ್ರೀತಿಮಾಡಿದ ಪರಿಶುದ್ಧ ಆಲಯವನ್ನು ಅಪವಿತ್ರ ಮಾಡಿ, ಅನ್ಯದೇವತೆಗಳನ್ನು ಆರಾಧಿಸುವ ಮಹಿಳೆಯರನ್ನು ಮದುವೆ ಮಾಡಿಕೊಂಡಿದೆ. <verse eid="MAL 2:11"/><verse number="12" style="v" sid="MAL 2:12"/>ಇದನ್ನು ಮಾಡುವ ಮನುಷ್ಯನನ್ನು ಅವನು ಯಾರೇ ಆಗಲಿ, ಅವನು ಯೆಹೋವ ದೇವರಿಗೆ ಕಾಣಿಕೆ ಅರ್ಪಿಸಲು ತಂದರೂ ಸಹ, ಯಾಕೋಬನ ಗುಡಾರಗಳೊಳಗಿಂದ ಸೇನಾಧೀಶ್ವರ ಯೆಹೋವ ದೇವರು ತೆಗೆದು ಹಾಕಲಿ.<verse eid="MAL 2:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="MAL 2:13"/>ನೀವು ಇನ್ನೊಂದನ್ನು ಮಾಡಿದ್ದೀರಿ. ಯೆಹೋವ ದೇವರ ಬಲಿಪೀಠಗಳನ್ನು ಕಣ್ಣೀರಿನಿಂದ ತುಂಬಿಸಿದ್ದೀರಿ. ಆದ್ದರಿಂದ ಆತನು ಕಾಣಿಕೆಯನ್ನು ಇನ್ನು ಮೇಲೆ ಲಕ್ಷಿಸದೆ, ಅದನ್ನು ನಿಮ್ಮ ಕೈಯಿಂದ ಮೆಚ್ಚಿಕೆಯಾಗಿ ಅಂಗೀಕರಿಸುವುದಿಲ್ಲವಾದ್ದರಿಂದ ನೀವು ಅಳುತ್ತೀರಿ, ಗೋಳಾಡುತ್ತೀರಿ. <verse eid="MAL 2:13"/><verse number="14" style="v" sid="MAL 2:14"/>ಆದರೂ ಯೆಹೋವ ದೇವರು ನಿನಗೂ, ನಿನ್ನ ಯೌವನದ ಹೆಂಡತಿಗೂ ಸಾಕ್ಷಿಯಾಗಿದ್ದರು. ಆದರೂ ನಿನ್ನ ಜೊತೆಯವಳೂ, ನಿನ್ನ ಒಡಂಬಡಿಕೆಯ ಹೆಂಡತಿಯೂ ಆಗಿದ್ದವಳಿಗೆ ನೀನು ಅಪನಂಬಿಗಸ್ತನಾಗಿದ್ದೀ.<verse eid="MAL 2:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="MAL 2:15"/>ನಿನ್ನನ್ನು ಸೃಷ್ಟಿಸಿದವನು ಒಬ್ಬನೇ ಅಲ್ಲವೇ? ನೀವು ದೇಹ ಮತ್ತು ಆತ್ಮದಲ್ಲಿ ಅವರಿಗೆ ಸೇರಿದವರು. ಮತ್ತು ಒಬ್ಬರೇ ದೇವರಾಗಿರುವ ದೇವರು ಏನು ಹುಡುಕುತ್ತಾರೆ? ದೈವಿಕ ಸಂತಾನ. ಆದ್ದರಿಂದ ನೀವು ಜಾಗರೂಕರಾಗಿರಿ ಮತ್ತು ನಿಮ್ಮ ಯೌವನದ ಹೆಂಡತಿಗೆ ವಿಶ್ವಾಸದ್ರೋಹ ಮಾಡಬೇಡಿ.<verse eid="MAL 2:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="MAL 2:16"/>“ವಿವಾಹ ವಿಚ್ಛೇದನವನ್ನು ನಾನು ಹಗೆಮಾಡುತ್ತೇನೆ,” ಎಂದು ಇಸ್ರಾಯೇಲಿನ ದೇವರಾದ ಯೆಹೋವ ದೇವರು ಹೇಳುತ್ತಾನೆ. “ತನ್ನ ಹೆಂಡತಿಗೆ ನಂಬಿಕೆದ್ರೋಹ ಬಗೆದು, ದೌರ್ಜನ್ಯ ತೋರುವವನನ್ನು ನಾನು ಹಗೆಮಾಡುತ್ತೇನೆ,” ಎಂದು ಸರ್ವಶಕ್ತರಾದ ದೇವರು ಹೇಳುತ್ತಾರೆ.</para>
  <para style="p" vid="MAL 2:16">ಆದ್ದರಿಂದ ನೀವು ವಂಚನೆಯುಳ್ಳವರಾಗಿ ನಡೆಯದ ಹಾಗೆ ನಿಮ್ಮ ಆತ್ಮದಲ್ಲಿ ಎಚ್ಚರಿಕೆಯಾಗಿರಿ.<verse eid="MAL 2:16"/></para>
  <para style="s1">ಅನ್ಯಾಯ ಮಾಡುವ ಮೂಲಕ ಒಡಂಬಡಿಕೆಯನ್ನು ಮುರಿಯುವುದು</para>
  <para style="p">
    <verse number="17" style="v" sid="MAL 2:17"/>“ನಿಮ್ಮ ಮಾತುಗಳಿಂದ ಯೆಹೋವ ದೇವರಿಗೆ ಬೇಸರ ಮಾಡಿದ್ದೀರಿ.</para>
  <para style="p" vid="MAL 2:17">“ಆದರೂ, ನಾವು ಯಾವುದರಲ್ಲಿ ಆತನಿಗೆ ಬೇಸರ ಮಾಡಿದ್ದೇವೆ?” ಎಂದು ಕೇಳುತ್ತೀರಿ.</para>
  <para style="p" vid="MAL 2:17">“ಕೆಟ್ಟದ್ದನ್ನು ಮಾಡುವವರೆಲ್ಲರು, ಯೆಹೋವ ದೇವರ ದೃಷ್ಟಿಯಲ್ಲಿ ಒಳ್ಳೆಯವರು, ಅವರಲ್ಲಿ ಆತನು ಮೆಚ್ಚುತ್ತಾನೆ ಎಂದೂ, ನ್ಯಾಯದ ದೇವರು ಎಲ್ಲಿ? ಎಂದೂ ನೀವು ಹೇಳುವುದರಿಂದಲೇ.”<verse eid="MAL 2:17"/></para>
  <chapter eid="MAL 2"/>
  <chapter number="3" style="c" sid="MAL 3"/>
  <para style="p">
    <verse number="1" style="v" sid="MAL 3:1"/>“ಇಗೋ, ನಾನು ನನ್ನ ದೂತನನ್ನು ಕಳುಹಿಸುತ್ತೇನೆ. ಅವನು ನನ್ನ ಮುಂದೆ ಮಾರ್ಗವನ್ನು ಸಿದ್ಧಮಾಡುವನು. ನೀವು ಹುಡುಕುವ ಕರ್ತರು ಫಕ್ಕನೆ ತಮ್ಮ ಆಲಯಕ್ಕೆ ಬರುವರು. ನೀವು ಇಷ್ಟಪಡುವ ಒಡಂಬಡಿಕೆಯ ದೂತನೇ, ಇಗೋ, ಬರುತ್ತಾನೆ,” ಎಂದು ಸೇನಾಧೀಶ್ವರ ಯೆಹೋವ ದೇವರು ಹೇಳುತ್ತಾರೆ.<verse eid="MAL 3:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="MAL 3:2"/>ಆದರೆ ಅವರ ಆಗಮನದ ದಿವಸದಲ್ಲಿ ಯಾರು ತಾಳುವರು? ಅವರು ಪ್ರತ್ಯಕ್ಷವಾಗುವಾಗ ಯಾರು ನಿಲ್ಲುವರು? ಏಕೆಂದರೆ ಅವರು ಅಕ್ಕಸಾಲಿಗನ ಪರಿಶೋಧಿಸುವ ಬೆಂಕಿಯ ಹಾಗೆಯೂ, ಅಗಸನ ಸಾಬೂನಿನ ಹಾಗೆಯೂ ಇದ್ದಾರೆ. <verse eid="MAL 3:2"/><verse number="3" style="v" sid="MAL 3:3"/>ದೇವರು ಬೆಳ್ಳಿಯನ್ನು ಪರಿಶೋಧಿಸಿ ಶುದ್ಧೀಕರಿಸುವ ಅಕ್ಕಸಾಲಿಗನಂತೆ ಕುಳಿತುಕೊಂಡು ಲೇವಿಯರನ್ನು ಶುದ್ಧಮಾಡುವರು. ಬಂಗಾರದ ಹಾಗೆಯೂ, ಬೆಳ್ಳಿಯ ಹಾಗೆಯೂ ಶುದ್ಧಮಾಡುವರು. ಆಗ ಅವರು ಯೆಹೋವ ದೇವರಿಗೆ ನೀತಿಯ ಕಾಣಿಕೆಯನ್ನು ಅರ್ಪಿಸುವರು. <verse eid="MAL 3:3"/><verse number="4" style="v" sid="MAL 3:4"/>ಯೆಹೂದದ ಮತ್ತು ಯೆರೂಸಲೇಮಿನ ಕಾಣಿಕೆಯು ಪೂರ್ವದಿನಗಳಲ್ಲಿ ಪುರಾತನ ಕಾಲದಲ್ಲಿ ಇದ್ದಂತೆ ಯೆಹೋವ ದೇವರಿಗೆ ಮೆಚ್ಚಿಕೆಯಾಗಿರುವುದು.<verse eid="MAL 3:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="MAL 3:5"/>“ನಾನು ನ್ಯಾಯತೀರಿಸುವದಕ್ಕೆ ನಿಮ್ಮ ಬಳಿಗೆ ಬರುತ್ತೇನೆ. ಆಗ ಮಾಟಗಾರರಿಗೆ, ವ್ಯಭಿಚಾರರಿಗೆ, ಸುಳ್ಳು ಹೇಳುವವರಿಗೆ, ಕೂಲಿಹಿಡಿದು ಕಾರ್ಮಿಕರನ್ನು ಮೋಸಗೊಳಿಸುವವರಿಗೆ, ವಿಧವೆಯರನ್ನು ಮತ್ತು ಅನಾಥರನ್ನು ಬಾಧಿಸುವವರಿಗೆ, ಪ್ರವಾಸಿಗಳಿಗೆ ಅನ್ಯಾಯ ಮಾಡುವವರಿಗೆ, ಮತ್ತು ನನಗೆ ಭಯಪಡದಿರುವವರಿಗೂ ನ್ಯಾಯತೀರಿಸಿ, ಶೀಘ್ರಸಾಕ್ಷಿಯಾಗಿರುವೆನು,” ಎಂದು ಸೇನಾಧೀಶ್ವರ ಯೆಹೋವ ದೇವರು ಹೇಳುತ್ತಾರೆ.<verse eid="MAL 3:5"/></para>
  <para style="s1">ದಶಮಾಂಶಗಳನ್ನು ತಡೆಹಿಡಿಯುವ ಮೂಲಕ ಒಡಂಬಡಿಕೆಯನ್ನು ಮುರಿಯುವುದು</para>
  <para style="p">
    <verse number="6" style="v" sid="MAL 3:6"/>“ನಾನು ಯೆಹೋವ ದೇವರು. ನಾನು ಬದಲಾಗುವುದಿಲ್ಲ. ಆದ್ದರಿಂದ ನೀವು ಯಾಕೋಬಿನ ವಂಶಜರೇ, ನಾಶವಾಗುವುದಿಲ್ಲ. <verse eid="MAL 3:6"/><verse number="7" style="v" sid="MAL 3:7"/>ನಿಮ್ಮ ತಂದೆಗಳ ದಿವಸಗಳಿಂದಲೇ ನನ್ನ ನಿಯಮಗಳನ್ನು ಬಿಟ್ಟುಹೋಗಿದ್ದೀರಿ. ಅವುಗಳನ್ನು ಅನುಸರಿಸಲಿಲ್ಲ. ನನ್ನ ಬಳಿಗೆ ತಿರುಗಿಕೊಳ್ಳಿರಿ. ಆಗ ನಾನು ನಿಮ್ಮ ಬಳಿಗೆ ತಿರುಗಿಕೊಳ್ಳುವೆನು,” ಎಂದು ಸೇನಾಧೀಶ್ವರ ಯೆಹೋವ ದೇವರು ಹೇಳುತ್ತಾರೆ.</para>
  <para style="p" vid="MAL 3:7">“ಆದರೆ ನೀವು, ‘ಯಾವುದರಲ್ಲಿ ತಿರುಗಿಕೊಳ್ಳೋಣ?’ ಎಂದು ಹೇಳುತ್ತೀರಿ.<verse eid="MAL 3:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="MAL 3:8"/>“ಮನುಷ್ಯನು ದೇವರಿಂದ ಕದ್ದುಕೊಳ್ಳಲು ಸಾಧ್ಯವೇ? ಆದರೂ ನೀವು ನನ್ನಿಂದ ಕಳ್ಳತನ ಮಾಡಿದ್ದೀರಿ.</para>
  <para style="p" vid="MAL 3:8">“ಆದರೆ ನೀವು, ‘ಯಾವುದರಲ್ಲಿ ನಿನ್ನದನ್ನು ಕಳ್ಳತನ ಮಾಡಿದ್ದೇವೆ?’ ಎಂದು ಕೇಳುತ್ತೀರಿ.</para>
  <para style="p" vid="MAL 3:8">“ದಶಮಭಾಗ ಮತ್ತು ಅರ್ಪಣೆಗಳಲ್ಲಿಯೇ! <verse eid="MAL 3:8"/><verse number="9" style="v" sid="MAL 3:9"/>ಇದರಿಂದ ಶಾಪವು ನಿಮಗಾಯಿತು, ಏಕೆಂದರೆ ನೀವು, ಈ ಸಮಸ್ತ ಜನಾಂಗವೇ ನನ್ನಲ್ಲಿ ಕಳ್ಳತನ ಮಾಡುತ್ತಿದ್ದಿರಿ. <verse eid="MAL 3:9"/><verse number="10" style="v" sid="MAL 3:10"/>ನನ್ನ ಆಲಯದಲ್ಲಿ ಆಹಾರ ಇರುವಂತೆ ಹತ್ತನೆಯ ಪಾಲುಗಳನ್ನೆಲ್ಲಾ ಬೊಕ್ಕಸಕ್ಕೆ ತನ್ನಿರಿ. ನಾನು ನಿಮಗೆ ಪರಲೋಕದ ಮಹಾದ್ವಾರಗಳನ್ನು ತೆರೆದು, ಸ್ಥಳ ಹಿಡಿಸಲಾರದಷ್ಟು ನಿಮಗೆ ಆಶೀರ್ವಾದವನ್ನು ಸುರಿಸದಿರುವೆನೋ, ಇಲ್ಲವೋ ಎಂಬುದನ್ನು ನೀವು ಈಗ ನನ್ನನ್ನು ಪರೀಕ್ಷಿಸಿ ನೋಡಿರಿ?” ಎಂದು ಸೇನಾಧೀಶ್ವರ ಯೆಹೋವ ದೇವರು ಹೇಳುತ್ತಾರೆ. <verse eid="MAL 3:10"/><verse number="11" style="v" sid="MAL 3:11"/>“ನಿಮ್ಮ ಬೆಳೆಯನ್ನು ತಿಂದು ಬಿಡದಂತೆ ಕ್ರಿಮಿಕೀಟಗಳನ್ನು ತಡೆಯುವೆನು. ನಿಮ್ಮ ದ್ರಾಕ್ಷಿ ತೋಟಗಳಲ್ಲಿಂದ ದ್ರಾಕ್ಷಿಹಣ್ಣುಗಳನ್ನು ಉದುರಿಸಿ ಬಿಡುವುದಿಲ್ಲ,” ಎಂದು ಸೇನಾಧೀಶ್ವರ ಯೆಹೋವ ದೇವರು ಹೇಳುತ್ತಾರೆ. <verse eid="MAL 3:11"/><verse number="12" style="v" sid="MAL 3:12"/>“ಆಗ ಜನಾಂಗಗಳೆಲ್ಲಾ ನಿಮ್ಮನ್ನು ಧನ್ಯರು ಎಂದು ಕರೆಯುವರು. ಏಕೆಂದರೆ ನೀವು ರಮ್ಯವಾದ ದೇಶವಾಗುವಿರಿ,” ಎಂದು ಸೇನಾಧೀಶ್ವರ ಯೆಹೋವ ದೇವರು ಹೇಳುತ್ತಾರೆ.<verse eid="MAL 3:12"/></para>
  <para style="s1">ಇಸ್ರಾಯೇಲ್ ದೇವರ ವಿರುದ್ಧ ಅಹಂಕಾರದಿಂದ ಮಾತನಾಡಿದರು</para>
  <para style="p">
    <verse number="13" style="v" sid="MAL 3:13"/>“ನೀವು ನನಗೆ ವಿರೋಧವಾಗಿ ಅಹಂಕಾರದಿಂದ ಮಾತುಗಳನ್ನಾಡಿದಿರಿ,” ಎಂದು ಯೆಹೋವ ದೇವರು ಹೇಳುತ್ತಾರೆ.</para>
  <para style="p" vid="MAL 3:13">“ಆದರೂ ನೀವು, ‘ನಿನಗೆ ವಿರೋಧವಾಗಿ ನಾವು ಏನು ಮಾತಾಡಿದ್ದೇವೆ?’ ಎನ್ನುತ್ತೀರಿ.”<verse eid="MAL 3:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="MAL 3:14"/>“ನೀವು, ‘ದೇವರನ್ನು ಸೇವಿಸುವುದು ವ್ಯರ್ಥ, ನಾವು ಆತನ ನಿಯಮಗಳನ್ನು ಕೈಗೊಂಡು ಸೇನಾಧೀಶ್ವರ ಯೆಹೋವ ದೇವರ ಮುಂದೆ ದುಃಖಪಡುವುದರಿಂದ ಏನು ಪ್ರಯೋಜನವೆಂದೂ, <verse eid="MAL 3:14"/><verse number="15" style="v" sid="MAL 3:15"/>ಈಗ ನಾವು ಗರ್ವಿಷ್ಠರನ್ನು ಭಾಗ್ಯವಂತರೆಂದನ್ನುತ್ತೇವೆ. ದುಷ್ಟರು ಅಭಿವೃದ್ಧಿಯಾಗುತ್ತಿದ್ದಾರೆ. ದೇವರಿಗೆ ಸವಾಲು ಹಾಕಿದವರು ತಪ್ಪಿಸಿಕೊಂಡಿದ್ದಾರೆ’ ಎಂದು ಹೇಳಿದ್ದೀರಿ.”<verse eid="MAL 3:15"/></para>
  <para style="s1">ಅಲ್ಪಸ್ವಲ್ಪ ಉಳಿದ ನಿಷ್ಠಾವಂತರು</para>
  <para style="p">
    <verse number="16" style="v" sid="MAL 3:16"/>ಆಗ ಯೆಹೋವ ದೇವರಿಗೆ ಭಯಪಡುವವರು, ಒಬ್ಬರ ಸಂಗಡಲೊಬ್ಬರು ಮಾತಾಡಿಕೊಂಡರು. ಯೆಹೋವ ದೇವರು ಕಿವಿಗೊಟ್ಟು ಅದನ್ನು ಕೇಳಿದರು. ಇದಲ್ಲದೆ ಯೆಹೋವ ದೇವರಿಗೆ ಭಯಪಟ್ಟು, ಅವರ ನಾಮವನ್ನು ಗೌರವಿಸುವವರ ಬಗ್ಗೆ ಅವರು ತಮ್ಮ ಮುಂದೆ ಇದ್ದ ಜ್ಞಾಪಕ ಪುಸ್ತಕದಲ್ಲಿ ಬರೆಸಿದರು.<verse eid="MAL 3:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="MAL 3:17"/>“ನಾನು ನನ್ನ ಅಮೂಲ್ಯ ಸೊತ್ತನ್ನು ಸೇರಿಸಿಕೊಳ್ಳುವ ಆ ದಿವಸದಲ್ಲಿ ಅವರು ನನ್ನವರಾಗಿರುವರು. ಒಬ್ಬನು ತನಗೆ ಸೇವೆ ಮಾಡುವ ತನ್ನ ಮಗನನ್ನು ಕನಿಕರಿಸುವ ಪ್ರಕಾರ, ಅವರನ್ನು ಕನಿಕರಿಸುವೆನು,” ಎಂದು ಸೇನಾಧೀಶ್ವರ ಯೆಹೋವ ದೇವರು ಹೇಳುತ್ತಾರೆ. <verse eid="MAL 3:17"/><verse number="18" style="v" sid="MAL 3:18"/>ಆಗ ನೀವು ನೀತಿವಂತನಿಗೂ, ದುಷ್ಟನಿಗೂ, ದೇವರ ಸೇವೆ ಮಾಡುವವನಿಗೂ, ಮಾಡದವನಿಗೂ ಇರುವ ವ್ಯತ್ಯಾಸವನ್ನು ಪುನಃ ನೋಡುವಿರಿ.<verse eid="MAL 3:18"/></para>
  <chapter eid="MAL 3"/>
  <chapter number="4" style="c" sid="MAL 4"/>
  <para style="s1">ನ್ಯಾಯತೀರ್ಪು ಮತ್ತು ಒಡಂಬಡಿಕೆಯ ನವೀಕರಣ</para>
  <para style="p">
    <verse number="1" style="v" sid="MAL 4:1"/>“ಖಂಡಿತವಾಗಿ ಆ ದಿನ ಬರುತ್ತದೆ, ಅದು ಒಲೆಯಂತೆ ಉರಿಯುತ್ತದೆ. ಆಗ ಗರ್ವಿಷ್ಠರೆಲ್ಲರೂ ಕೆಟ್ಟದ್ದನ್ನು ಮಾಡುವವರೆಲ್ಲರೂ ಹುಲ್ಲಿನಂತಿರುವರು. ಬರುವ ಆ ದಿನವು ಅವರನ್ನು ಸುಟ್ಟುಬಿಡುವುದು. ಬೇರನ್ನಾದರೂ, ಕೊಂಬೆಯನ್ನಾದರೂ ಅವರಿಗೆ ಬಿಡದು,” ಎಂದು ಸೇನಾಧೀಶ್ವರ ಯೆಹೋವ ದೇವರು ಹೇಳುತ್ತಾರೆ. <verse eid="MAL 4:1"/><verse number="2" style="v" sid="MAL 4:2"/>ಆದರೆ ನನ್ನ ನಾಮದಲ್ಲಿ ಭಯಭಕ್ತಿಯಿಟ್ಟಿರುವ ನಿಮಗೆ, ನೀತಿ ಸೂರ್ಯನು ತಮ್ಮ ಕಿರಣಗಳಿಂದ ಸ್ವಸ್ಥತೆಯನ್ನುಂಟು ಮಾಡುವವನಾಗಿ ಉದಯಿಸುವನು. ನೀವು ಹೊರಟು ಕೊಟ್ಟಿಗೆಯಿಂದ ಹೊರಬಂದ ಕರುಗಳ ಹಾಗೆ ಕುಣಿದಾಡುವಿರಿ. <verse eid="MAL 4:2"/><verse number="3" style="v" sid="MAL 4:3"/>ಆಗ ದುಷ್ಟರನ್ನು ತುಳಿದುಬಿಡುವಿರಿ. ಏಕೆಂದರೆ ನಾನು ಕಾರ್ಯಸಾಧಿಸುವ ದಿವಸದಲ್ಲಿ ಅವರು ನಿಮ್ಮ ಪಾದಗಳ ಕೆಳಗೆ ಬೂದಿಯಾಗಿರುವರೆಂದು ಎಂದು ಸೇನಾಧೀಶ್ವರ ಯೆಹೋವ ದೇವರು ಹೇಳುತ್ತಾರೆ.<verse eid="MAL 4:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="MAL 4:4"/>“ನನ್ನ ಸೇವಕನಾದ ಮೋಶೆಯ ನಿಯಮವನ್ನು ನಾನು ಅವನಿಗೆ ಹೋರೇಬಿನಲ್ಲಿ ಸಮಸ್ತ ಇಸ್ರಾಯೇಲಿಗೋಸ್ಕರ ಆಜ್ಞಾಪಿಸಿದ್ದನ್ನೂ ವಿಧಿ ನಿಯಮಗಳನ್ನೂ ಜ್ಞಾಪಕಮಾಡಿಕೊಳ್ಳಿರಿ.<verse eid="MAL 4:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="MAL 4:5"/>“ಇಗೋ, ಯೆಹೋವ ದೇವರ ಮಹಾ ಭಯಂಕರವಾದ ದಿವಸವು ಬರುವುದಕ್ಕಿಂತ ಮುಂಚೆ ನಿಮಗೆ ಪ್ರವಾದಿಯಾದ ಎಲೀಯನನ್ನು ಕಳುಹಿಸುವೆನು. <verse eid="MAL 4:5"/><verse number="6" style="v" sid="MAL 4:6"/>ನಾನು ಬಂದು ಭೂಮಿಯನ್ನು ಶಾಪದಿಂದ ಹೊಡೆಯದ ಹಾಗೆ ಅವನು ತಂದೆಯರ ಹೃದಯವನ್ನು ಮಕ್ಕಳ ಕಡೆಗೂ ಮಕ್ಕಳ ಹೃದಯವನ್ನು ತಮ್ಮ ತಂದೆಯರ ಕಡೆಗೂ ತಿರುಗಿಸುವನು.”<verse eid="MAL 4:6"/></para>
  <chapter eid="MAL 4"/>
</usx>
