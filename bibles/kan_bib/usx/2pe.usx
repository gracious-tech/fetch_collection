<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="2PE" style="id">- Biblica® Open Kannada Contemporary Version</book>
  <para style="h">2 ಪೇತ್ರನು</para>
  <para style="toc1">ಪೇತ್ರನು ಬರೆದ ಎರಡನೆಯ ಪತ್ರಿಕೆ</para>
  <para style="toc2">2 ಪೇತ್ರನು</para>
  <para style="toc3">2 ಪೇತ್ರ</para>
  <para style="mt1">ಪೇತ್ರನು</para>
  <para style="mt2">ಬರೆದ ಎರಡನೆಯ ಪತ್ರಿಕೆ</para>
  <chapter number="1" style="c" sid="2PE 1"/>
  <para style="p">
    <verse number="1" style="v" sid="2PE 1:1"/>ಕ್ರಿಸ್ತ ಯೇಸುವಿನ ದಾಸನೂ ಅಪೊಸ್ತಲನೂ ಆಗಿರುವ ಸೀಮೋನ ಪೇತ್ರನು,</para>
  <para style="b" vid="2PE 1:1"/>
  <para style="p" vid="2PE 1:1">ನಮ್ಮ ದೇವರ ಮತ್ತು ರಕ್ಷಕ ಆಗಿರುವ ಕ್ರಿಸ್ತ ಯೇಸುವಿನ ನೀತಿಯ ಮೂಲಕ ನಮ್ಮಂತೆಯೇ ಅಮೂಲ್ಯವಾದ ನಂಬಿಕೆಯನ್ನು ಹೊಂದಿದವರಿಗೆ ಬರೆಯುವುದು:<verse eid="2PE 1:1"/></para>
  <para style="b"/>
  <para style="p">
    <verse number="2" style="v" sid="2PE 1:2"/>ದೇವರ ವಿಷಯವಾಗಿಯೂ ನಮ್ಮ ಕರ್ತ ಆಗಿರುವ ಯೇಸುಕ್ರಿಸ್ತರ ವಿಷಯವಾಗಿಯೂ ಇರುವ ತಿಳುವಳಿಕೆಯ ಮೂಲಕ ನಿಮಗೆ ಕೃಪೆಯೂ ಶಾಂತಿಯೂ ಹೆಚ್ಚೆಚ್ಚಾಗಿ ದೊರೆಯಲಿ.<verse eid="2PE 1:2"/></para>
  <para style="b"/>
  <para style="s1">ಕರೆಯುವಿಕೆಯ ಮತ್ತು ಆಯ್ಕೆಯ ನಿಶ್ಚಯ</para>
  <para style="p">
    <verse number="3" style="v" sid="2PE 1:3"/>ದೇವರು ತಮ್ಮ ಸ್ವಂತ ಮಹಿಮೆಗಾಗಿಯೂ ಸದ್ಗುಣಕ್ಕಾಗಿಯೂ ನಮ್ಮನ್ನು ಕರೆದಿದ್ದಾರೆ. ಏಕೆಂದರೆ, ದೇವರ ತಿಳುವಳಿಕೆಯ ಮೂಲಕವಾಗಿ ಜೀವಕ್ಕೂ, ಭಕ್ತಿಗೂ ಬೇಕಾದದ್ದೆಲ್ಲವುಗಳನ್ನು ದೇವರ ಶಕ್ತಿಯು ನಮಗೆ ಕೊಡಲಾಗಿದೆ. <verse eid="2PE 1:3"/><verse number="4" style="v" sid="2PE 1:4"/>ನೀವು ಲೋಕದಲ್ಲಿ ದುರಾಶೆಯಿಂದುಂಟಾದ ಕೆಟ್ಟತನಕ್ಕೆ ತಪ್ಪಿಸಿಕೊಂಡು ದೈವಸ್ವಭಾವದಲ್ಲಿ ಪಾಲನ್ನು ಹೊಂದುವವರಾಗಬೇಕೆಂದು ಅತ್ಯಂತ ಮಹತ್ವವುಳ್ಳ ಅಮೂಲ್ಯವಾದ ವಾಗ್ದಾನಗಳನ್ನು ದೇವರು ನಮಗೆ ದಯಪಾಲಿಸಿದ್ದಾರೆ.<verse eid="2PE 1:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="2PE 1:5"/>ಈ ಕಾರಣದಿಂದಲೇ ನೀವು ಪೂರ್ಣಜಾಗ್ರತೆಯಿಂದ ನಿಮಗಿರುವ ನಂಬಿಕೆಗೆ ಸದ್ಗುಣವನ್ನೂ ಸದ್ಗುಣಕ್ಕೆ ಜ್ಞಾನವನ್ನೂ <verse eid="2PE 1:5"/><verse number="6" style="v" sid="2PE 1:6"/>ಜ್ಞಾನಕ್ಕೆ ಸ್ವಯಂ ನಿಯಂತ್ರಣವನ್ನೂ ಸ್ವಯಂ ನಿಯಂತ್ರಣಕ್ಕೆ ತಾಳ್ಮೆಯನ್ನೂ <verse eid="2PE 1:6"/><verse number="7" style="v" sid="2PE 1:7"/>ತಾಳ್ಮೆಗೆ ಭಕ್ತಿಯನ್ನೂ ಭಕ್ತಿಗೆ ಸೋದರ ಸ್ನೇಹವನ್ನೂ ಸೋದರ ಸ್ನೇಹಕ್ಕೆ ಪ್ರೀತಿಯನ್ನೂ ಕೂಡಿಸಿರಿ. <verse eid="2PE 1:7"/><verse number="8" style="v" sid="2PE 1:8"/>ಈ ಗುಣಗಳು ನಿಮ್ಮಲ್ಲಿದ್ದು ಹೆಚ್ಚುತ್ತಾ ಬಂದರೆ, ನಮ್ಮ ಕರ್ತ ಆಗಿರುವ ಯೇಸು ಕ್ರಿಸ್ತರನ್ನು ಅರಿತುಕೊಳ್ಳುವುದರಲ್ಲಿ ನೀವು ನಿಷ್ಪ್ರಯೋಜಕರೂ ನಿಷ್ಫಲರೂ ಆಗದಂತೆ ಮಾಡುತ್ತವೆ. <verse eid="2PE 1:8"/><verse number="9" style="v" sid="2PE 1:9"/>ಆದರೆ ಈ ಗುಣಗಳಿಲ್ಲದವನು ಕುರುಡನಾಗಿದ್ದಾನೆ. ಅವನು ದೂರದೃಷ್ಟಿಯಿಲ್ಲದವನಾಗಿದ್ದು ತನ್ನ ಹಿಂದಿನ ಪಾಪಗಳಿಂದ ಶುದ್ಧನಾದದ್ದನ್ನು ಮರೆತು ಬಿಟ್ಟಿದ್ದಾನೆ.<verse eid="2PE 1:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="2PE 1:10"/>ಆದ್ದರಿಂದ ಪ್ರಿಯರೇ, ನಿಮ್ಮ ಕರೆಯುವಿಕೆಯನ್ನೂ ಆಯ್ಕೆಯನ್ನೂ ದೃಢಪಡಿಸಿಕೊಳ್ಳಲು ಸರ್ವ ಪ್ರಯತ್ನವನ್ನು ಮಾಡಿರಿ. ಏಕೆಂದರೆ ಇವುಗಳನ್ನು ನೀವು ಮಾಡಿದರೆ ಎಂದಿಗೂ ಪಾಪದಲ್ಲಿ ಬಿದ್ದುಹೋಗುವುದಿಲ್ಲ. <verse eid="2PE 1:10"/><verse number="11" style="v" sid="2PE 1:11"/>ನಮಗೆ ಕರ್ತ ಹಾಗೂ ರಕ್ಷಕ ಆಗಿರುವ ಕ್ರಿಸ್ತ ಯೇಸುವು ತಮ್ಮ ನಿತ್ಯ ರಾಜ್ಯದಲ್ಲಿ ಪ್ರವೇಶಿಸುವ ಭಾಗ್ಯವನ್ನು ನಿಮಗೆ ಧಾರಾಳವಾಗಿ ಅನುಗ್ರಹಿಸುವರು.<verse eid="2PE 1:11"/></para>
  <para style="s1">ದೇವರ ವಾಕ್ಯದ ಪ್ರವಾದನೆ</para>
  <para style="p">
    <verse number="12" style="v" sid="2PE 1:12"/>ಆದ್ದರಿಂದ ನೀವು ಈ ಸಂಗತಿಗಳನ್ನು ತಿಳಿದವರಾಗಿ ಈಗಿನ ಸತ್ಯದಲ್ಲಿ ಸ್ಥಿರವಾಗಿದ್ದರೂ ಇವುಗಳನ್ನು ಯಾವಾಗಲೂ ನಿಮ್ಮ ನೆನಪಿಗೆ ತರಲು ನಾನು ಬಯಸುತ್ತೇನೆ. <verse eid="2PE 1:12"/><verse number="13" style="v" sid="2PE 1:13"/>ನಾನು ನನ್ನ ದೇಹವೆಂಬ ಗುಡಾರದಲ್ಲಿ ಬಾಳುವ ತನಕ ನಿಮ್ಮ ನೆನಪಿಗೆ ತರುವುದು ಯುಕ್ತವೆಂದೆಣಿಸಿದ್ದೇನೆ. <verse eid="2PE 1:13"/><verse number="14" style="v" sid="2PE 1:14"/>ನಮಗೆ ಕರ್ತ ಆಗಿರುವ ಯೇಸು ಕ್ರಿಸ್ತರು ನನಗೆ ಸ್ಪಷ್ಟ ಪಡಿಸಿದ ಪ್ರಕಾರ, ಈ ನನ್ನ ದೇಹವೆಂಬ ಗುಡಾರವನ್ನು ತೆಗೆದುಹಾಕುವ ಕಾಲ ಬೇಗನೆ ಬರುತ್ತದೆಂದು ನಾನು ಬಲ್ಲೆನು. <verse eid="2PE 1:14"/><verse number="15" style="v" sid="2PE 1:15"/>ಆದರೂ ನೀವು ನನ್ನ ಮರಣಾನಂತರ ಇವುಗಳನ್ನು ಯಾವಾಗಲೂ ನೆನಪಿಟ್ಟುಕೊಳ್ಳುವಂತೆ ನನ್ನಿಂದಾದಷ್ಟು ಪ್ರಯಾಸಪಡುವೆನು.<verse eid="2PE 1:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="2PE 1:16"/>ನಮಗೆ ಕರ್ತ ಆಗಿರುವ ಯೇಸುಕ್ರಿಸ್ತರ ಶಕ್ತಿಯ ಬಗ್ಗೆಯೂ ಅವರ ಪುನರಾಗಮನದ ಬಗ್ಗೆಯೂ ನಿಮಗೆ ತಿಳಿಯಪಡಿಸಿದ್ದರಲ್ಲಿ ಕುತಂತ್ರವಾಗಿ ಕಲ್ಪಿಸಿದ ಕಥೆಗಳನ್ನು ನಾವು ಅನುಸರಿಸಲಿಲ್ಲ. ಆದರೆ ನಾವೇ ಕ್ರಿಸ್ತ ಯೇಸುವಿನ ಮಹತ್ತನ್ನು ಕಣ್ಣಾರೆ ಕಂಡವರಾಗಿ ತಿಳಿಯಪಡಿಸಿದೆವು. <verse eid="2PE 1:16"/><verse number="17" style="v" sid="2PE 1:17"/>ಏಕೆಂದರೆ, “ಈತನು ಪ್ರಿಯನಾಗಿರುವ ನನ್ನ ಮಗನು, ಈತನನ್ನು ನಾನು ಮೆಚ್ಚಿದ್ದೇನೆ,”<note caller="+" style="f"><char style="fr" closed="false">1:17 </char><char style="ft" closed="false"><char style="xt"><ref loc="MAT 17:5">ಮತ್ತಾಯ 17:5</ref>; <ref loc="MRK 9:7">ಮಾರ್ಕ 9:7</ref>; <ref loc="LUK 9:35">ಲೂಕ 9:35</ref></char></char></note> ಎಂಬ ಧ್ವನಿಯು ಮಹೋನ್ನತ ಮಹಿಮೆಯಿಂದ ಅವರಿಗೆ ಉಂಟಾದದ್ದರಲ್ಲಿ ಅವರು ತಂದೆ ದೇವರಿಂದ ಗೌರವವನ್ನೂ ಮಹಿಮೆಯನ್ನೂ ಹೊಂದಿದರಲ್ಲವೇ. <verse eid="2PE 1:17"/><verse number="18" style="v" sid="2PE 1:18"/>ನಾವು ಪರಿಶುದ್ಧ ಪರ್ವತದ ಮೇಲೆ ಕ್ರಿಸ್ತ ಯೇಸುವಿನ ಸಂಗಡ ಇದ್ದಾಗ ಪರಲೋಕದಿಂದ ಬಂದ ಆ ಧ್ವನಿಯನ್ನು ನಾವೇ ಕೇಳಿದೆವು.<verse eid="2PE 1:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="2PE 1:19"/>ಮಾತ್ರವಲ್ಲದೆ ನಮಗೆ ಬಹು ನಿಶ್ಚಯವಾದ ಪ್ರವಾದನೆಯ ವಾಕ್ಯಗಳಿವೆ. ಉದಯ ನಕ್ಷತ್ರವಾಗಿರುವ ಕ್ರಿಸ್ತ ಯೇಸು ನಿಮ್ಮ ಹೃದಯಗಳಲ್ಲಿ ಉದಯಿಸುವಾಗ ಕತ್ತಲೆಯಾದ ಸ್ಥಳದಲ್ಲಿ ಪ್ರಕಾಶಿಸುವ ದೀಪದಂತೆ ಎಣಿಸಿ, ನೀವು ಆ ಪ್ರವಾದನಾ ವಾಕ್ಯಗಳಿಗೆ ಲಕ್ಷ್ಯಕೊಡುವುದು ಒಳ್ಳೆಯದು. <verse eid="2PE 1:19"/><verse number="20" style="v" sid="2PE 1:20"/>ಪವಿತ್ರ ವೇದದ ಯಾವ ಪ್ರವಾದನೆಯೂ ಕೇವಲ ಪ್ರವಾದಿಗಳಿಂದ ಸ್ವಂತವಾಗಿ ವಿವರಿಸತಕ್ಕದ್ದಲ್ಲ ಎಂಬುದನ್ನು ಮೊದಲು ತಿಳಿದುಕೊಳ್ಳಿರಿ. <verse eid="2PE 1:20"/><verse number="21" style="v" sid="2PE 1:21"/>ಯಾವ ಪ್ರವಾದನೆಯೂ ಎಂದೂ ಮನುಷ್ಯನ ಚಿತ್ತದಿಂದ ಬರಲಿಲ್ಲ, ಆದರೆ ಪ್ರವಾದಿಗಳು ಪವಿತ್ರಾತ್ಮ ಪ್ರೇರಿತರಾಗಿ ದೇವರಿಂದ ಪಡೆದುಕೊಂಡಿದ್ದನ್ನೇ ಮಾತನಾಡಿದರು.<verse eid="2PE 1:21"/></para>
  <chapter eid="2PE 1"/>
  <chapter number="2" style="c" sid="2PE 2"/>
  <para style="s1">ಸುಳ್ಳು ಬೋಧಕರು ಮತ್ತು ಅವರ ನಾಶನವು</para>
  <para style="p">
    <verse number="1" style="v" sid="2PE 2:1"/>ಆದರೆ ಆ ಕಾಲದಲ್ಲಿ ಸುಳ್ಳು ಪ್ರವಾದಿಗಳು ಸಹ ಜನರಲ್ಲಿ ಕಾಣಿಸಿಕೊಂಡರು. ಅದೇ ಪ್ರಕಾರ ನಿಮ್ಮಲ್ಲಿಯೂ ಈಗ ಸುಳ್ಳು ಬೋಧಕರು ಕಾಣಿಸಿಕೊಳ್ಳುವರು. ಅಂಥವರು ಹಾನಿಕರವಾದ ಸುಳ್ಳು ಬೋಧನೆಗಳನ್ನು ರಹಸ್ಯವಾಗಿ ಸಭೆಯೊಳಗೆ ತರುವರು. ತಮ್ಮನ್ನು ಕೊಂಡುಕೊಂಡ ಸಾರ್ವಭೌಮ ಕರ್ತ ಆಗಿರುವವರನ್ನೇ ಅಲ್ಲಗಳೆಯುವರು. ಹೀಗೆ ಅವರು ತಮ್ಮ ಮೇಲೆ ವಿನಾಶವನ್ನು ತಾವೇ ಬರಮಾಡಿಕೊಳ್ಳುವರು. <verse eid="2PE 2:1"/><verse number="2" style="v" sid="2PE 2:2"/>ಆ ಸುಳ್ಳು ಬೋಧಕರ ಅಸಹ್ಯ ಕೃತ್ಯಗಳನ್ನು ಅನೇಕರು ಅನುಸರಿಸುವರು. ಅವರ ನಿಮಿತ್ತ ಸತ್ಯಮಾರ್ಗಕ್ಕೆ ದೂಷಣೆ ಉಂಟಾಗುವುದು. <verse eid="2PE 2:2"/><verse number="3" style="v" sid="2PE 2:3"/>ಅವರು ದ್ರವ್ಯಾಶೆಯುಳ್ಳವರಾಗಿ ಕಲ್ಪನೆಯ ಮಾತುಗಳನ್ನು ಹೇಳುತ್ತಾ ನಿಮ್ಮಿಂದ ಲಾಭವನ್ನು ಸಂಪಾದಿಸಬೇಕೆಂದಿರುವರು. ಅಂಥವರಿಗೆ ಬಹುಕಾಲದ ಹಿಂದೆಯೇ ದೇವರ ತೀರ್ಪು ಸಿದ್ಧಪಡಿಸಲಾಗಿದೆ. ಅವರಿಗಾಗುವ ವಿನಾಶವು ತೂಕಡಿಸುವುದಿಲ್ಲ.<verse eid="2PE 2:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="2PE 2:4"/>ದೇವದೂತರು ಪಾಪಮಾಡಿದಾಗ ದೇವರು ಅವರನ್ನು ಸುಮ್ಮನೆ ಬಿಡದೆ ನರಕಕ್ಕೆ ದೊಬ್ಬಿ ನ್ಯಾಯತೀರ್ಪನ್ನು ಹೊಂದುವುದಕ್ಕೆ ಬಂಧಿಸಿ, ಕತ್ತಲೆಯ ಸಂಕೋಲೆಗಳಿಗೆ ಒಪ್ಪಿಸಿದರು. <verse eid="2PE 2:4"/><verse number="5" style="v" sid="2PE 2:5"/>ದೇವರು ಪುರಾತನ ಜಗತ್ತನ್ನು ಸುಮ್ಮನೆ ಬಿಡದೆ ಭಕ್ತಿಹೀನರ ಲೋಕದ ಮೇಲೆ ಜಲಪ್ರಳಯವನ್ನು ಬರಮಾಡಿದರು. ಆದರೆ ನೀತಿಯನ್ನು ಸಾರುತ್ತಿದ್ದ ನೋಹನನ್ನು ಮತ್ತು ಅವನೊಂದಿಗಿದ್ದ ಇತರ ಏಳು ಜನರನ್ನು ಮಾತ್ರ ರಕ್ಷಿಸಿದರು. <verse eid="2PE 2:5"/><verse number="6" style="v" sid="2PE 2:6"/>ದೇವರು ಸೊದೋಮ ಗೊಮೋರ ಪಟ್ಟಣಗಳನ್ನು ಬೂದಿಮಾಡಿ ಇನ್ನು ಮೇಲೆ ಭಕ್ತಿಹೀನರಾಗಿ ಬದುಕುವವರ ಗತಿಗೆ ದೃಷ್ಟಾಂತವಾಗಿ ಅವುಗಳಿಗೆ ದಂಡನೆಯನ್ನು ವಿಧಿಸಿದರು. <verse eid="2PE 2:6"/><verse number="7" style="v" sid="2PE 2:7"/>ದೇವರು ಆ ದುಷ್ಟರ ನಡತೆಗೆ ವೇದನೆಗೊಂಡಿದ್ದ ನೀತಿವಂತನಾದ ಲೋಟನನ್ನು ಕಾಪಾಡಿದರು. <verse eid="2PE 2:7"/><verse number="8" style="v" sid="2PE 2:8"/>ಏಕೆಂದರೆ ಆ ನೀತಿವಂತನು ಅವರ ಮಧ್ಯದಲ್ಲಿ ಇದ್ದುಕೊಂಡು ಅವರ ಅನ್ಯಾಯಕೃತ್ಯಗಳನ್ನು ನೋಡುತ್ತಾ, ಕೇಳುತ್ತಾ, ಅವುಗಳ ನಿಮಿತ್ತ ದಿನೇ ದಿನೇ ತನ್ನ ನೀತಿಯುಳ್ಳ ಆತ್ಮದಲ್ಲಿ ವೇದನೆಗೊಂಡನು. <verse eid="2PE 2:8"/><verse number="9" style="v" sid="2PE 2:9"/>ಕರ್ತದೇವರು ಭಕ್ತರನ್ನು ಸಂಕಟದೊಳಗಿಂದ ತಪ್ಪಿಸುವುದಕ್ಕೂ ಅನೀತಿವಂತರನ್ನು ಶಿಕ್ಷಿಸುವುದಕ್ಕಾಗಿ ನ್ಯಾಯತೀರ್ಪಿನ ದಿನದ ತನಕ ಇಡುವುದಕ್ಕೂ ಬಲ್ಲವರಾಗಿದ್ದಾರೆ. <verse eid="2PE 2:9"/><verse number="10" style="v" sid="2PE 2:10"/>ಆದರೆ ಮುಖ್ಯವಾಗಿ ತುಚ್ಛವಾದ ದೈಹಿಕ ವ್ಯಾಮೋಹಗಳಿಗೆ ಶರೀರಾನುಸಾರ ನಡೆದು ಪ್ರಭುತ್ವವನ್ನು ತಿರಸ್ಕಾರ ಮಾಡುವವರನ್ನು ಹೀಗೆ ಶಿಕ್ಷಿಸುವರು.</para>
  <para style="p" vid="2PE 2:10">ಇವರು ಯಾರಿಗೂ ಹೆದರದೆ ಸ್ವೇಚ್ಛಾಪರರಾಗಿದ್ದಾರೆ. ದುರಹಂಕಾರದಿಂದ ಸ್ವರ್ಗೀಯ ಜೀವಿಗಳನ್ನು ದೂಷಿಸುತ್ತಾರೆ. <verse eid="2PE 2:10"/><verse number="11" style="v" sid="2PE 2:11"/>ಆದರೂ ದೇವದೂತರು ಬಲದಲ್ಲಿಯೂ ಮಹತ್ತಿನಲ್ಲಿಯೂ ಶ್ರೇಷ್ಠರಾಗಿದ್ದರೂ ಸ್ವರ್ಗೀಯ ಜೀವಿಗಳ ವಿರೋಧವಾಗಿ ಕರ್ತದೇವರ ಮುಂದೆ ಇವರು ನ್ಯಾಯತೀರ್ಪನ್ನು ತರುವುದಿಲ್ಲ. <verse eid="2PE 2:11"/><verse number="12" style="v" sid="2PE 2:12"/>ಆದರೆ ಬೇಟೆಗಾಗಿ ಹುಟ್ಟಿರುವ ವಿವೇಕಹೀನ ಮೃಗಗಳಂತಿರುವ ಈ ದುರ್ಬೋಧಕರು ತಮಗೆ ತಿಳಿಯದವುಗಳ ವಿಷಯವಾಗಿ ದೂಷಣೆ ಮಾಡುವವರಾಗಿದ್ದಾರೆ. ಇವರು ತಮ್ಮ ಕೆಟ್ಟತನದಿಂದ ಮೃಗಗಳಂತೆ ಸಂಪೂರ್ಣ ನಾಶವಾಗುವರು.<verse eid="2PE 2:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="2PE 2:13"/>ತಮ್ಮ ದುರ್ನೀತಿಗೆ ಸರಿಯಾದ ದುಷ್ಫಲವನ್ನು ಹೊಂದುವರು. ದುಂದುಗಾರಿಕೆಯನ್ನು ಹಗಲಲ್ಲಿ ಕಳೆಯುವುದೇ ಸುಖವೆಂದೆಣಿಸುತ್ತಾರೆ. ಇವರು ನಿಮ್ಮ ಸಂಗಡ ಸೇರಿ ಔತಣ ಮಾಡುತ್ತಿರುವಾಗ ವಂಚಕರಾಗಿದ್ದು ಕಳಂಕಕ್ಕೂ, ನಿಂದೆಗೂ ಕಾರಣರಾಗಿದ್ದಾರೆ. <verse eid="2PE 2:13"/><verse number="14" style="v" sid="2PE 2:14"/>ಇವರು ಕಾಮುಕದಿಂದ ತುಂಬಿದ ಕಣ್ಣು ಮತ್ತು ಪಾಪವನ್ನು ಬಿಡಲೊಲ್ಲದ ಚಪಲಚಿತ್ತರೂ ಮರುಳುಗೊಳಿಸುವವರೂ ಲೋಭಗಳಲ್ಲಿ ತೇರ್ಗಡೆ ಹೊಂದಿದ ಹೃದಯವುಳ್ಳವರೂ ಶಾಪದ ಮಕ್ಕಳೂ ಆಗಿದ್ದಾರೆ. <verse eid="2PE 2:14"/><verse number="15" style="v" sid="2PE 2:15"/>ಇವರು ನೇರವಾದ ಮಾರ್ಗವನ್ನು ಬಿಟ್ಟು ಬೆಯೋರನ ಮಗನಾದ ಬಿಳಾಮನ ಮಾರ್ಗವನ್ನು ಹಿಡಿದು ತಪ್ಪಿಹೋಗಿದ್ದಾರೆ. ಈ ಬಿಳಾಮನು ಅನೀತಿಯಿಂದ ದೊರಕುವ ಸಂಬಳವನ್ನು ಪ್ರೀತಿಸಿದನು. <verse eid="2PE 2:15"/><verse number="16" style="v" sid="2PE 2:16"/>ಆದರೆ ಅವನ ದುಷ್ಟತನಕ್ಕೆ ಖಂಡನೆಯಾಯಿತು. ಮೂಕ ಕತ್ತೆಯು<note caller="+" style="f"><char style="fr" closed="false">2:16 </char><char style="ft" closed="false">ನೋಡಿರಿ, <char style="xt"><ref loc="NUM 22:28-35">ಅರಣ್ಯ 22:28-35</ref></char></char></note> ಮನುಷ್ಯ ಸ್ವರದಿಂದ ಮಾತನಾಡಿ ಆ ಪ್ರವಾದಿಯ ಹುಚ್ಚುತನಕ್ಕೆ ಅಡ್ಡಿಮಾಡಿತು.<verse eid="2PE 2:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="2PE 2:17"/>ಈ ಸುಳ್ಳು ಬೋಧಕರು ನೀರಿಲ್ಲದ ಬಾವಿಗಳೂ ಬಿರುಗಾಳಿಯಿಂದ ಬಡಿಸಿಕೊಂಡು ಹಾರಿಹೋಗುವ ಮೇಘಗಳೂ ಆಗಿದ್ದಾರೆ. ಇಂಥವರ ಪಾಲಿಗೆ ಕಾರ್ಗತ್ತಲು ಇಟ್ಟಿರುವುದು. <verse eid="2PE 2:17"/><verse number="18" style="v" sid="2PE 2:18"/>ತಪ್ಪಾದ ಮಾರ್ಗದಲ್ಲಿ ಬಾಳುವವರಿಂದ ತಪ್ಪಿಸಿಕೊಂಡವರನ್ನು ಇವರು ಹುರುಳಿಲ್ಲದ ದೊಡ್ಡ ದೊಡ್ಡ ಮಾತುಗಳನ್ನಾಡಿ ಶರೀರದ ದುರಾಶೆಗಳನ್ನು ಹುಟ್ಟಿಸಿ ಅವರನ್ನು ಮರುಳುಗೊಳಿಸುತ್ತಾರೆ. <verse eid="2PE 2:18"/><verse number="19" style="v" sid="2PE 2:19"/>ಇಂಥವರು ಸ್ವಾತಂತ್ರ್ಯಕೊಡುತ್ತೇವೆಂದು ಅವರಿಗೆ ವಾಗ್ದಾನ ಮಾಡುತ್ತಾರೆ. ಆದರೆ ತಾವೇ ಕೆಟ್ಟತನದ ದಾಸತ್ವದೊಳಗಿದ್ದಾರೆ. ಒಬ್ಬನು ಯಾವುದಕ್ಕೆ ಸೋತು ಹೋಗಿರುವನೋ, ಅವನು ಅದರ ದಾಸತ್ವದೊಳಗಿರುವನಷ್ಟೆ. <verse eid="2PE 2:19"/><verse number="20" style="v" sid="2PE 2:20"/>ನಮಗೆ ಕರ್ತ ಹಾಗೂ ರಕ್ಷಕ ಆಗಿರುವ ಕ್ರಿಸ್ತ ಯೇಸುವಿನ ವಿಷಯವಾದ ಜ್ಞಾನಹೊಂದಿ ಲೋಕದ ಮಾಲಿನ್ಯಗಳನ್ನು ತಪ್ಪಿಸಿಕೊಂಡವರು ತಿರುಗಿ ಅವುಗಳಲ್ಲಿ ಸಿಕ್ಕಿಕೊಂಡು ಸೋತುಹೋದರೆ ಅವನ ಅಂತ್ಯಸ್ಥಿತಿಯು ಮೊದಲಿಗಿಂತ ಕೆಟ್ಟದ್ದಾಗಿರುವುದು. <verse eid="2PE 2:20"/><verse number="21" style="v" sid="2PE 2:21"/>ಅವರು ನೀತಿಮಾರ್ಗವನ್ನು ತಿಳಿದುಕೊಂಡ ಮೇಲೆ ತಮಗೆ ಕೊಡಲಾದ ಪವಿತ್ರ ಆಜ್ಞೆಯಿಂದ ತೊಲಗಿ ಹೋಗುವುದಕ್ಕಿಂತ ಆ ಮಾರ್ಗವನ್ನು ತಿಳಿಯದೆ ಇದ್ದಿದ್ದರೆ ಮೇಲಾಗಿತ್ತು. <verse eid="2PE 2:21"/><verse number="22" style="v" sid="2PE 2:22"/>“ನಾಯಿ ತಾನು ಕಕ್ಕಿದ್ದನ್ನು ನೆಕ್ಕಲು ತಿರುಗಿಕೊಂಡಿತು ಮತ್ತು ತೊಳೆದ ಹಂದಿ ಕೆಸರಿನಲ್ಲಿ ಹೊರಳಾಡಲು ತಿರುಗಿಕೊಂಡಿತು!”<note caller="+" style="f"><char style="fr" closed="false">2:22 </char><char style="ft" closed="false"><char style="xt"><ref loc="PRO 26:11">ಜ್ಞಾನೋಕ್ತಿ 26:11</ref></char></char></note> ಎಂಬ ನಿಜವಾದ ಗಾದೆ ಅವರಿಗೆ ಸರಿಯಾಗಿ ಅನ್ವಯಿಸುತ್ತದೆ.<verse eid="2PE 2:22"/></para>
  <chapter eid="2PE 2"/>
  <chapter number="3" style="c" sid="2PE 3"/>
  <para style="s1">ಕರ್ತ ಯೇಸುವಿನ ದಿನವು</para>
  <para style="p">
    <verse number="1" style="v" sid="2PE 3:1"/>ಪ್ರಿಯರೇ, ನಿಮಗೀಗ ಬರೆಯುವುದು ಎರಡನೆಯ ಪತ್ರ. ಈ ಎರಡು ಪತ್ರಗಳಲ್ಲಿಯೂ ನಿಮ್ಮ ನೆನಪಿಗೆ ತಂದು ನಿಮ್ಮ ನಿರ್ಮಲವಾದ ಮನಸ್ಸನ್ನು ಉತ್ತೇಜಿಸಿದ್ದೇನೆ. <verse eid="2PE 3:1"/><verse number="2" style="v" sid="2PE 3:2"/>ಪರಿಶುದ್ಧ ಪ್ರವಾದಿಗಳು ಪೂರ್ವದಲ್ಲಿ ಹೇಳಿದ ಮಾತುಗಳನ್ನೂ ನಮಗೆ ಕರ್ತ ಹಾಗೂ ರಕ್ಷಕ ಆಗಿರುವವರು ನಿಮ್ಮ ಅಪೊಸ್ತಲರ ಮೂಲಕ ಕೊಟ್ಟ ಅಪ್ಪಣೆಯನ್ನೂ ನೀವು ನೆನಪಿನಲ್ಲಿ ಇಟ್ಟುಕೊಳ್ಳಬೇಕು ಎಂದು ಬಯಸುತ್ತೇನೆ.<verse eid="2PE 3:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="2PE 3:3"/>ಕಡೇ ದಿವಸಗಳಲ್ಲಿ ತಮ್ಮ ದುರಾಶೆಗಳ ಪ್ರಕಾರ ನಡೆಯುವ ಕುಚೋದ್ಯಗಾರರು ಬಂದು, <verse eid="2PE 3:3"/><verse number="4" style="v" sid="2PE 3:4"/>“ಆತನ ಪ್ರತ್ಯಕ್ಷತೆಯ ವಿಷಯವಾದ ವಾಗ್ದಾನವು ಏನಾಯಿತು? ಪಿತೃಗಳು ನಿದ್ರೆಹೊಂದಿದಂದಿನಿಂದ ಸಮಸ್ತವೂ ಸೃಷ್ಟಿ ಮೊದಲುಗೊಂಡು ಹಾಗೆಯೇ ಇರುತ್ತದಲ್ಲಾ?” ಎಂದು ಕುಚೋದ್ಯದಿಂದ ಕೇಳುವರೆಂದು ನೀವು ಮೊದಲು ತಿಳಿದುಕೊಳ್ಳಬೇಕು. <verse eid="2PE 3:4"/><verse number="5" style="v" sid="2PE 3:5"/>ಆದರೆ ಪೂರ್ವಕಾಲದಲ್ಲಿ ದೇವರ ವಾಕ್ಯದಿಂದ ಆಕಾಶವು ಅಸ್ತಿತ್ವಕ್ಕೆ ಬಂದಿತು ಎಂತಲೂ ಜಲದಿಂದ ಜಲದ ಮೂಲಕ ಭೂಮಿಯು ಉಂಟಾಯಿತೆಂಬುದನ್ನು ಅವರು ಬೇಕೆಂತಲೇ ಮರೆತುಬಿಡುತ್ತಾರೆ. <verse eid="2PE 3:5"/><verse number="6" style="v" sid="2PE 3:6"/>ಈ ಜಲದಿಂದ ಆ ಸಮಯದಲ್ಲಿ ಜಗತ್ತು ಪ್ರಳಯದಲ್ಲಿ ನಾಶವಾಯಿತು. <verse eid="2PE 3:6"/><verse number="7" style="v" sid="2PE 3:7"/>ಆದರೆ ಈಗಿನ ಆಕಾಶವೂ ಭೂಮಿಯೂ ಅದೇ ವಾಕ್ಯದಿಂದ ಬೆಂಕಿಗಾಗಿ ಕಾದಿರಿಸಲಾಗಿವೆ. ಅವು ನ್ಯಾಯತೀರ್ಪಿಗಾಗಿ ಮತ್ತು ಭಕ್ತಿಹೀನರ ನಾಶನಕ್ಕಾಗಿ ಇಡಲಾಗಿವೆ.<verse eid="2PE 3:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="2PE 3:8"/>ಆದರೆ ಪ್ರಿಯರೇ, ಕರ್ತದೇವರ ಎಣಿಕೆಯಲ್ಲಿ ಒಂದು ದಿನವು ಸಾವಿರ ವರ್ಷಗಳಂತೆಯೂ ಸಾವಿರ ವರ್ಷಗಳು ಒಂದು ದಿನದಂತೆಯೂ ಇವೆ ಎಂಬುದನ್ನು ಮಾತ್ರ ಮರೆಯಬೇಡಿರಿ. <verse eid="2PE 3:8"/><verse number="9" style="v" sid="2PE 3:9"/>ಕರ್ತದೇವರು ತಮ್ಮ ವಾಗ್ದಾನದ ವಿಷಯವಾಗಿ ತಡಮಾಡುತ್ತಾರೆಂಬದಾಗಿ ಕೆಲವರು ಎಣಿಸುವ ಪ್ರಕಾರ ಅವರು ತಡಮಾಡುವವರಲ್ಲ. ಆದರೆ ಯಾವನಾದರೂ ನಾಶವಾಗುವುದರಲ್ಲಿ ಅವರು ಇಷ್ಟಪಡದೆ ಎಲ್ಲರೂ ಪಶ್ಚಾತ್ತಾಪಡಬೇಕೆಂದು ಅಪೇಕ್ಷಿಸುವವರಾಗಿದ್ದು ನಮ್ಮ ಕಡೆಗೆ ದೀರ್ಘಶಾಂತರಾಗಿದ್ದಾರೆ.<verse eid="2PE 3:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="2PE 3:10"/>ಆದರೂ ಕರ್ತ ಯೇಸುವಿನ ದಿನವು ರಾತ್ರಿಯಲ್ಲಿ ಕಳ್ಳನು ಬರುವಂತೆ ಬರುತ್ತದೆ. ಆ ದಿನದಲ್ಲಿ ಆಕಾಶಗಳು ಮಹಾಘೋಷದಿಂದ ಇಲ್ಲದೆ ಹೋಗುವವು. ಅತಿ ಉಷ್ಣದಿಂದ ಪಂಚಭೂತಗಳು ಉರಿದು ಲಯವಾಗಿ ಹೋಗುವವು. ಭೂಮಿಯೂ ಅದರಲ್ಲಿರುವ ಕೆಲಸಗಳೂ ಸುಟ್ಟು ಹೋಗುವವು.<verse eid="2PE 3:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="2PE 3:11"/>ಇವೆಲ್ಲವುಗಳು ಹೀಗೆ ಲಯವಾಗಿ ಹೋಗುವುದರಿಂದ ನೀವು ಎಷ್ಟೋ ಪರಿಶುದ್ಧವಾದ ನಡವಳಿಕೆಯೂ ಭಕ್ತಿಯೂ ಉಳ್ಳವರಾಗಿರಬೇಕು. <verse eid="2PE 3:11"/><verse number="12" style="v" sid="2PE 3:12"/>ದೇವರ ದಿನದ ಪ್ರತ್ಯಕ್ಷತೆಯನ್ನು ಎದುರುನೋಡುತ್ತಾ ಆತುರಪಡುವ ಆ ದಿನದಲ್ಲಿ ಆಕಾಶಗಳು ಬೆಂಕಿಹತ್ತಿ ಲಯವಾಗಿ ಹೋಗುವವು. ಅತಿ ಉಷ್ಣದಿಂದ ಪಂಚಭೂತಗಳು ಉರಿದು ಕರಗಿ ಹೋಗುವವಲ್ಲವೇ? <verse eid="2PE 3:12"/><verse number="13" style="v" sid="2PE 3:13"/>ಆದರೂ ನಾವು ದೇವರ ವಾಗ್ದಾನದ ಪ್ರಕಾರ ನೂತನ ಆಕಾಶಗಳನ್ನೂ ನೂತನ ಭೂಮಿಯನ್ನೂ ಎದುರುನೋಡುತ್ತಾ ಇದ್ದೇವೆ. ಅವುಗಳಲ್ಲಿ ನೀತಿಯು ವಾಸವಾಗಿರುವುದು.<verse eid="2PE 3:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="2PE 3:14"/>ಆದಕಾರಣ ಪ್ರಿಯ ಸ್ನೇಹಿತರೇ, ನೀವು ಇಂಥವುಗಳನ್ನು ಎದುರು ನೋಡುವವರಾಗಿರುವುದರಿಂದ ಸಮಾಧಾನದಲ್ಲಿದ್ದು ನಿರ್ಮಲರಾಗಿಯೂ ನಿರ್ದೋಷಿಗಳಾಗಿಯೂ ಅವರಿಗೆ ಕಾಣಿಸಿಕೊಳ್ಳುವಂತೆ ಜಾಗ್ರತೆಯುಳ್ಳವರಾಗಿರಿ. <verse eid="2PE 3:14"/><verse number="15" style="v" sid="2PE 3:15"/>ನಮ್ಮ ಕರ್ತದೇವರ ದೀರ್ಘಶಾಂತಿಯು ನಮ್ಮ ರಕ್ಷಣೆಯ ಕಾರಣಕ್ಕಾಗಿ ಇದೆ ಎಂದು ಎಣಿಸಿಕೊಳ್ಳಿರಿ. ನಮ್ಮ ಪ್ರಿಯ ಸಹೋದರನಾದ ಪೌಲನು ಸಹ ತನಗೆ ಅನುಗ್ರಹಿಸಿರುವ ಜ್ಞಾನದ ಪ್ರಕಾರ ನಿಮಗೆ ಬರೆದಿದ್ದಾನೆ. <verse eid="2PE 3:15"/><verse number="16" style="v" sid="2PE 3:16"/>ಅವನು ತನ್ನ ಎಲ್ಲಾ ಪತ್ರಿಕೆಗಳಲ್ಲಿಯೂ ಈ ವಿಷಯಗಳನ್ನು ಕುರಿತು ಹೇಳಿದ್ದಾನೆ. ಆ ಪತ್ರಗಳಲ್ಲಿರುವ ಕೆಲವು ವಿಷಯಗಳು ತಿಳಿಯುವುದಕ್ಕೆ ಕಷ್ಟವಾಗಿವೆ. ಪವಿತ್ರ ವೇದದ ಮಿಕ್ಕಾದ ಭಾಗಗಳಿಗೆ ಸಹ ತಪ್ಪಾದ ಅರ್ಥಮಾಡಿಕೊಂಡ ಹಾಗೆಯೇ ವಿದ್ಯಾಹೀನರೂ ಚಪಲಚಿತ್ತರೂ ಇವುಗಳಿಗೂ ತಪ್ಪಾದ ಅರ್ಥಮಾಡಿಕೊಂಡು ತಮಗೆ ನಾಶವನ್ನುಂಟುಮಾಡಿಕೊಳ್ಳುತ್ತಾರೆ.<verse eid="2PE 3:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="2PE 3:17"/>ಆದಕಾರಣ ಪ್ರಿಯರೇ, ನೀವು ಈ ಸಂಗತಿಗಳನ್ನು ಮುಂದಾಗಿ ತಿಳಿದುಕೊಂಡಿರುವುದರಿಂದ ನಿಯಮರಹಿತರ ಸೆಳೆಯುವಿಕೆಗೆ ಮರುಳಾಗಿ ನಿಮ್ಮ ಸ್ಥಿರತೆಯಿಂದ ಬಿದ್ದುಹೋಗದಂತೆ ಎಚ್ಚರಿಕೆಯಿಂದಿರಿ. <verse eid="2PE 3:17"/><verse number="18" style="v" sid="2PE 3:18"/>ನೀವು ಕೃಪೆಯಲ್ಲಿ ಬೆಳೆಯಿರಿ ಮತ್ತು ನಮಗೆ ಕರ್ತ ಹಾಗೂ ರಕ್ಷಕ ಆಗಿರುವ ಕ್ರಿಸ್ತ ಯೇಸುವಿನ ವಿಷಯವಾದ ಜ್ಞಾನದಲ್ಲಿಯೂ ಬೆಳೆಯಿರಿ.</para>
  <para style="b" vid="2PE 3:18"/>
  <para style="b" vid="2PE 3:18"/>
  <para style="p" vid="2PE 3:18">ಅವರಿಗೆ ಈಗಲೂ ಸರ್ವಕಾಲವೂ ಮಹಿಮೆ ಇರಲಿ! ಆಮೆನ್.<verse eid="2PE 3:18"/></para>
  <chapter eid="2PE 3"/>
</usx>
