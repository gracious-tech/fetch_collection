<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="3JN" style="id">- Biblica® Open Kannada Contemporary Version</book>
  <para style="h">3 ಯೋಹಾನನು</para>
  <para style="toc1">ಯೋಹಾನನು ಬರೆದ ಮೂರನೆಯ ಪತ್ರಿಕೆ</para>
  <para style="toc2">3 ಯೋಹಾನನು</para>
  <para style="toc3">3 ಯೋಹಾನ</para>
  <para style="mt1">ಯೋಹಾನನು</para>
  <para style="mt2">ಬರೆದ ಮೂರನೆಯ ಪತ್ರಿಕೆ</para>
  <chapter number="1" style="c" sid="3JN 1"/>
  <para style="p">
    <verse number="1" style="v" sid="3JN 1:1"/>ಹಿರಿಯನು,</para>
  <para style="b" vid="3JN 1:1"/>
  <para style="p" vid="3JN 1:1">ಸತ್ಯದಲ್ಲಿ ಬಹಳವಾಗಿ ಪ್ರೀತಿಸುವ ಗಾಯನಿಗೆ ಬರೆಯುವುದು:<verse eid="3JN 1:1"/></para>
  <para style="b"/>
  <para style="b"/>
  <para style="p">
    <verse number="2" style="v" sid="3JN 1:2"/>ಪ್ರಿಯ ಸ್ನೇಹಿತನೇ, ನಿನ್ನ ಆತ್ಮವು ಅಭಿವೃದ್ಧಿ ಹೊಂದಿರುವ ಪ್ರಕಾರವೇ, ಎಲ್ಲಾ ವಿಷಯಗಳಲ್ಲಿಯೂ ನೀನು ಆರೋಗ್ಯವೂ ಅಭಿವೃದ್ಧಿಯೂ ಹೊಂದಿರಬೇಕೆಂದು ನಾನು ಪ್ರಾರ್ಥಿಸುತ್ತೇನೆ. <verse eid="3JN 1:2"/><verse number="3" style="v" sid="3JN 1:3"/>ನಿನ್ನಲ್ಲಿ ಸತ್ಯಕ್ಕಾಗಿರುವ ನಂಬಿಗಸ್ತಿಕೆಯ ಕುರಿತು ಸಹೋದರರು ಬಂದು ಸಾಕ್ಷೀಕರಿಸಿದ್ದರಿಂದ ನಾನು ಬಹಳವಾಗಿ ಸಂತೋಷಪಟ್ಟೆನು. <verse eid="3JN 1:3"/><verse number="4" style="v" sid="3JN 1:4"/>ನನ್ನ ಮಕ್ಕಳು ಸತ್ಯವನ್ನು ಅನುಸರಿಸಿ ಬಾಳುತ್ತಿದ್ದಾರೆಂದು ಕೇಳುವುದಕ್ಕಿಂತ ಹೆಚ್ಚಾದ ಸಂತೋಷವು ನನಗಿಲ್ಲ.<verse eid="3JN 1:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="3JN 1:5"/>ಪ್ರಿಯ ಸ್ನೇಹಿತನೇ, ಸಹೋದರರಿಗೂ ಪರಿಚಯವಿಲ್ಲದವರಿಗೂ ನೀನು ಮಾಡುವುದನ್ನೆಲ್ಲಾ ನಂಬಿಗಸ್ತನಾಗಿ ಮಾಡುತ್ತೀ. <verse eid="3JN 1:5"/><verse number="6" style="v" sid="3JN 1:6"/>ಅವರು ಸಭೆಯ ಮುಂದೆ ನಿನ್ನ ಪ್ರೀತಿಗೆ ಸಾಕ್ಷಿ ಹೇಳಿದರು. ಅವರನ್ನು ನೀನು ದೇವರು ಮೆಚ್ಚುವ ರೀತಿಯಲ್ಲಿ ಸಾಗಕಳುಹಿಸಿದರೆ ನೀನು ಒಳ್ಳೆಯದನ್ನು ಮಾಡುತ್ತೀ. <verse eid="3JN 1:6"/><verse number="7" style="v" sid="3JN 1:7"/>ಏಕೆಂದರೆ ಅವರು ಕ್ರಿಸ್ತ ಯೇಸುವಿನ ಹೆಸರಿನ ನಿಮಿತ್ತವಾಗಿ ಹೊರಟು ಹೋಗಿದ್ದಾರೆ. ಅವಿಶ್ವಾಸಿಗಳಿಂದ ಏನೂ ತೆಗೆದುಕೊಳ್ಳುವವರಲ್ಲ. <verse eid="3JN 1:7"/><verse number="8" style="v" sid="3JN 1:8"/>ಆದ್ದರಿಂದ ನಾವು ಸತ್ಯಕ್ಕೆ ಸಹಕಾರಿಗಳಾಗುವಂತೆ ಅಂಥವರನ್ನು ಉಪಚರಿಸಬೇಕು.<verse eid="3JN 1:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="3JN 1:9"/>ಸಭೆಗೆ ನಾನು ಬರೆದಿದ್ದೆನು. ಆದರೆ ಸಭೆಯವರಲ್ಲಿ ಪ್ರಮುಖನಾಗಬೇಕೆಂದಿರುವ ದಿಯೊತ್ರೇಫನು ನಮ್ಮನ್ನು ಅಂಗೀಕರಿಸುವುದಿಲ್ಲ. <verse eid="3JN 1:9"/><verse number="10" style="v" sid="3JN 1:10"/>ಆದಕಾರಣ ನಾನು ಬಂದಾಗ ನಮ್ಮನ್ನು ದೂಷಿಸಿ ನಮ್ಮ ವಿಷಯದಲ್ಲಿ ಕೆಟ್ಟ ಕೆಟ್ಟ ಮಾತುಗಳನ್ನಾಡುವ ಅವನ ಕೃತ್ಯಗಳನ್ನು ಜ್ಞಾಪಕ ಮಾಡುವೆನು. ಅವನು ಇದರಲ್ಲಿ ತೃಪ್ತನಾಗದೆ, ಸಹೋದರರನ್ನು ತಾನೂ ಸೇರಿಸಿಕೊಳ್ಳದೆ, ಸೇರಿಸಿಕೊಳ್ಳಬೇಕೆಂದಿರುವವರಿಗೆ ಅಡ್ಡಿ ಮಾಡುತ್ತಾ, ಅವರನ್ನು ಸಭೆಯೊಳಗಿಂದ ಬಹಿಷ್ಕರಿಸುತ್ತಿದ್ದಾನೆ.<verse eid="3JN 1:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="3JN 1:11"/>ಪ್ರಿಯ ಸ್ನೇಹಿತನೇ, ನೀನು ಕೆಟ್ಟದ್ದನ್ನು ಅನುಸರಿಸದೆ ಒಳ್ಳೆಯದನ್ನು ಅನುಸರಿಸು. ಒಳ್ಳೆಯದನ್ನು ಮಾಡುವವನು ದೇವರಿಗೆ ಸೇರಿದವನಾಗಿದ್ದಾನೆ, ಕೆಟ್ಟದ್ದನ್ನು ಮಾಡುವವನು ದೇವರನ್ನು ಕಂಡವನಲ್ಲ. <verse eid="3JN 1:11"/><verse number="12" style="v" sid="3JN 1:12"/>ದೇಮೇತ್ರಿಯನನ್ನು ಕುರಿತಾಗಿ ಎಲ್ಲರೂ ಒಳ್ಳೆಯದನ್ನೇ ಮಾತನಾಡುತ್ತಾರೆ. ಅಷ್ಟೇ ಅಲ್ಲದೆ ಸತ್ಯವೇ ಅವನ ಪರವಾಗಿ ಸಾಕ್ಷಿಕೊಡುತ್ತದೆ. ನಮ್ಮ ಸಾಕ್ಷಿ ಸತ್ಯವಾದದ್ದೆಂದು ನೀವು ಬಲ್ಲಿರಿ.<verse eid="3JN 1:12"/></para>
  <para style="b"/>
  <para style="b"/>
  <para style="p">
    <verse number="13" style="v" sid="3JN 1:13"/>ನಾನು ಬರೆಯತಕ್ಕ ಅನೇಕ ವಿಷಯಗಳಿವೆ. ಆದರೆ ಮಸಿ ಮತ್ತು ಲೇಖನಿಗಳಿಂದ ಬರೆಯುವುದಕ್ಕೆ ನನಗಿಷ್ಟವಿಲ್ಲ. <verse eid="3JN 1:13"/><verse number="14" style="v" sid="3JN 1:14"/>ಬೇಗನೆ ನಿನ್ನನ್ನು ನೋಡುವೆನೆಂದು ನಿರೀಕ್ಷಿಸುತ್ತೇನೆ. ಆಗ ಮುಖಾಮುಖಿಯಾಗಿ ನಾವು ಮಾತನಾಡುವೆವು.<verse eid="3JN 1:14"/></para>
  <para style="b"/>
  <para style="p">
    <verse number="15" style="v" sid="3JN 1:15"/>ನಿನಗೆ ಶಾಂತಿ ಇರಲಿ.</para>
  <para style="b" vid="3JN 1:15"/>
  <para style="p" vid="3JN 1:15">ನಮ್ಮ ಸ್ನೇಹಿತರು ನಿನಗೆ ವಂದನೆ ಹೇಳುತ್ತಾರೆ. ಸ್ನೇಹಿತರನ್ನು ಹೆಸರು ಹೆಸರಾಗಿ ವಂದಿಸು.<verse eid="3JN 1:15"/></para>
  <chapter eid="3JN 1"/>
</usx>
