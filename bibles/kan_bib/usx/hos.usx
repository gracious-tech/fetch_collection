<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="HOS" style="id">- Biblica® Open Kannada Contemporary Version</book>
  <para style="h">ಹೋಶೇಯ</para>
  <para style="toc1">ಹೋಶೇಯ</para>
  <para style="toc2">ಹೋಶೇಯ</para>
  <para style="toc3">ಹೋಶೇ</para>
  <para style="mt1">ಹೋಶೇಯ</para>
  <chapter number="1" style="c" sid="HOS 1"/>
  <para style="p">
    <verse number="1" style="v" sid="HOS 1:1"/>ಯೆಹೂದದ ಅರಸರಾದ ಉಜ್ಜೀಯ, ಯೋತಾಮ, ಆಹಾಜ, ಹಿಜ್ಕೀಯ ಇವರ ದಿನಗಳಲ್ಲಿಯೂ ಇಸ್ರಾಯೇಲಿನ ಅರಸನೂ ಯೋವಾಷನ ಮಗನೂ ಆದ ಯಾರೊಬ್ಬಾಮನ ದಿನಗಳಲ್ಲಿಯೂ ಬೆಯೇರಿಯನ ಮಗ ಹೋಶೇಯನಿಗೆ ಯೆಹೋವ ದೇವರ ವಾಕ್ಯವು ಬಂದಿತು.<verse eid="HOS 1:1"/></para>
  <para style="b"/>
  <para style="s1">ಹೋಶೇಯನ ಹೆಂಡತಿ ಮತ್ತು ಮಕ್ಕಳು</para>
  <para style="p">
    <verse number="2" style="v" sid="HOS 1:2"/>ಯೆಹೋವ ದೇವರು ಹೋಶೇಯನೊಂದಿಗೆ ಮಾತನಾಡಲು ಪ್ರಾರಂಭಿಸಿದಾಗ, ಯೆಹೋವ ದೇವರು ಹೋಶೇಯನಿಗೆ, “ನೀನು ಹೋಗಿ ವ್ಯಭಿಚಾರಿಣಿಯೊಬ್ಬಳನ್ನು ಮದುವೆ ಮಾಡಿಕೋ ಮತ್ತು ಆಕೆಗೆ ವ್ಯಭಿಚಾರದಿಂದಾಗುವ ಮಕ್ಕಳನ್ನು ಸೇರಿಸಿಕೋ. ಏಕೆಂದರೆ ಈ ದೇಶವು ನನ್ನನ್ನು ತೊರೆದುಬಿಟ್ಟು, ವ್ಯಭಿಚಾರಿಣಿಯಾದ ಹೆಂಡತಿಯಂತೆ ಯೆಹೋವ ದೇವರಿಗೆ ದ್ರೋಹ ಬಗೆದಿದೆ,” ಎಂದು ಹೇಳಿದರು. <verse eid="HOS 1:2"/><verse number="3" style="v" sid="HOS 1:3"/>ಆಗ ಅವನು ಹೋಗಿ ದಿಬ್ಲಯಿಮನ ಮಗಳಾದ ಗೋಮೆರಳನ್ನು ಮದುವೆಯಾದನು. ಅವಳು ಗರ್ಭಿಣಿಯಾಗಿ ಅವನಿಗೆ ಒಬ್ಬ ಮಗನನ್ನು ಹೆತ್ತಳು.<verse eid="HOS 1:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="HOS 1:4"/>ಆಗ ಯೆಹೋವ ದೇವರು ಹೋಶೇಯನಿಗೆ, “ಈ ಮಗುವಿಗೆ ಇಜ್ರೆಯೇಲ್ ಎಂದು ಹೆಸರಿಡು. ಏಕೆಂದರೆ ಶೀಘ್ರದಲ್ಲಿಯೇ ನಾನು ಇಜ್ರೆಯೇಲ್ ಕಣಿವೆಯಲ್ಲಿ ರಕ್ತವನ್ನು ಸುರಿಸಿದ ಯೇಹುವಿನ ಮನೆತನದವರ ಮೇಲೆ ಮುಯ್ಯಿತೀರಿಸಿಕೊಳ್ಳುವೆನು. ಇಸ್ರಾಯೇಲ್ ರಾಜ್ಯವನ್ನು ಅಂತ್ಯಗೊಳಿಸುವೆನು. <verse eid="HOS 1:4"/><verse number="5" style="v" sid="HOS 1:5"/>ಆ ದಿನದಲ್ಲಿ, ನಾನು ಇಸ್ರಾಯೇಲಿನ ಬಿಲ್ಲು ಶಕ್ತಿಯನ್ನು ಇಜ್ರೆಯೇಲ್ ಕಣಿವೆಯಲ್ಲಿ ಮುರಿದು ಹಾಕುವೆನು,” ಎಂದು ಹೇಳಿದರು.<verse eid="HOS 1:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="HOS 1:6"/>ಗೋಮೆರಳು ಪುನಃ ಗರ್ಭಿಣಿಯಾಗಿ ಹೆಣ್ಣು ಮಗುವನ್ನು ಹೆತ್ತಳು. ಆಗ ಯೆಹೋವ ದೇವರು ಹೋಶೇಯನಿಗೆ, “ಅವಳನ್ನು ‘ಲೋರುಹಾಮಾ<note caller="+" style="f"><char style="fr" closed="false">1:6 </char><char style="fq" closed="false">ಲೋರುಹಾಮಾ </char><char style="ft" closed="false">ಇದರ ಅರ್ಥ </char><char style="fqa" closed="false">ಅಪ್ರೀಯ</char></note>’ ಎಂಬ ಹೆಸರಿನಿಂದ ಕರೆ. ಏಕೆಂದರೆ ನಾನು ಇನ್ನು ಮೇಲೆ ಇಸ್ರಾಯೇಲಿನ ಮನೆತನದವರಿಗೆ ಪ್ರೀತಿ ತೋರಿಸುವುದೇ ಇಲ್ಲ, ಅವರನ್ನು ಯಾವ ರೀತಿಯೂ ಕ್ಷಮಿಸುವದಿಲ್ಲ. <verse eid="HOS 1:6"/><verse number="7" style="v" sid="HOS 1:7"/>ಆದರೆ ನಾನು ಯೆಹೂದದ ಮನೆತನದವರನ್ನು ಪ್ರೀತಿಸಿ ಅವರನ್ನು ಬಿಲ್ಲುಬಾಣ, ಖಡ್ಗ, ಕಾಳಗ, ಕುದುರೆ ರಾಹುತರು ಇವುಗಳಿಂದಲ್ಲ, ಅವರನ್ನು ಅವರ ದೇವರಾದ ನಾನೇ ಯೆಹೋವ ದೇವರೇ ರಕ್ಷಿಸುವೆನು,” ಎಂದು ಹೇಳಿದರು.<verse eid="HOS 1:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="HOS 1:8"/>ಗೋಮೆರಳು ಲೋರುಹಾಮಾಳನ್ನು ಎದೆಹಾಲಿನ ಸೇವನೆಯಿಂದ ಬಿಡಿಸಿದ ಮೇಲೆ ಪುನಃ ಗರ್ಭಿಣಿಯಾಗಿ ಒಬ್ಬ ಮಗನನ್ನು ಹೆತ್ತಳು. <verse eid="HOS 1:8"/><verse number="9" style="v" sid="HOS 1:9"/>ಆಗ ಯೆಹೋವ ದೇವರು, “ ‘ಅವನ ಹೆಸರನ್ನು ಲೋ ಅಮ್ಮಿ<note caller="+" style="f"><char style="fr" closed="false">1:9 </char><char style="fq" closed="false">ಲೋ ಅಮ್ಮಿ </char><char style="ft" closed="false">ಇದರ ಅರ್ಥ </char><char style="fqa" closed="false">ನನ್ನ ಜನರಲ್ಲ</char></note> ಎಂದು ಕರೆ. ಏಕೆಂದರೆ ನೀವು ನನ್ನ ಜನರಲ್ಲ, ನಾನು ನಿಮ್ಮ ದೇವರಾಗಿರುವುದಿಲ್ಲ,’ ಎಂದು ಹೇಳಿದರು.<verse eid="HOS 1:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="HOS 1:10"/>“ಆದರೂ ಇಸ್ರಾಯೇಲ್ ಜನರು ಅಳೆಯುವುದಕ್ಕೂ ಎಣಿಸುವುದಕ್ಕೂ ಅಸಾಧ್ಯವಾದ ಕಡಲತೀರದ ಮರಳಿನಂತಾಗುವರು. ದೇವರು ಯಾವ ಸ್ಥಳದಲ್ಲಿ ಅವರನ್ನು, ‘ನೀವು ನನ್ನ ಜನರಲ್ಲ’ ಎಂದಿದ್ದಾರೋ ಆ ಸ್ಥಳದಲ್ಲಿಯೇ, ‘ನೀವು ಜೀವಸ್ವರೂಪಿಯಾದ ದೇವರ ಮಕ್ಕಳು’ ಎನಿಸಿಕೊಳ್ಳುವ ದಿನ ಬರುವುದು. <verse eid="HOS 1:10"/><verse number="11" style="v" sid="HOS 1:11"/>ಆಗ ಯೆಹೂದದ ಜನರು ಮತ್ತು ಇಸ್ರಾಯೇಲ್ ಜನರು ಒಟ್ಟುಗೂಡಿಕೊಂಡು ತಮಗೆ ಒಬ್ಬ ನಾಯಕನನ್ನು ನೇಮಕ ಮಾಡಿಕೊಂಡು, ದೇಶದೊಳಗಿಂದ ಹೊರಗೆ ಬರುವರು. ಏಕೆಂದರೆ ಇಜ್ರೆಯೇಲಿನ ಆ ದಿನವು ಮಹಾದಿನವಾಗಿರುವುದು.<verse eid="HOS 1:11"/></para>
  <chapter eid="HOS 1"/>
  <chapter number="2" style="c" sid="HOS 2"/>
  <para style="p">
    <verse number="1" style="v" sid="HOS 2:1"/>“ನಿನ್ನ ಸಹೋದರರಿಗೆ, ‘ನನ್ನ ಜನರೇ’ ಎಂದೂ ನಿಮ್ಮ ಸಹೋದರಿಯರಿಗೆ, ‘ನನ್ನ ಪ್ರಿಯರೇ’ ಎಂದೂ ಹೇಳಿರಿ.<verse eid="HOS 2:1"/></para>
  <para style="s1">ಇಸ್ರಾಯೇಲಿನ ದಂಡನೆ ಹಾಗೂ ಪುನಃಸ್ಥಾಪನೆ</para>
  <para style="q1">
    <verse number="2" style="v" sid="HOS 2:2"/>“ನಿಮ್ಮ ತಾಯಿಯ ಸಂಗಡ ವಾದಮಾಡಿರಿ, ಅವಳೊಂದಿಗೆ ವಾದಮಾಡಿರಿ,</para>
  <para style="q2" vid="HOS 2:2">ಏಕೆಂದರೆ ಅವಳು ನನ್ನ ಹೆಂಡತಿಯಲ್ಲ,</para>
  <para style="q2" vid="HOS 2:2">ಮತ್ತು ನಾನು ಅವಳ ಗಂಡನಲ್ಲ.</para>
  <para style="q1" vid="HOS 2:2">ಅವಳು ತನ್ನ ವ್ಯಭಿಚಾರದ ನೋಟವನ್ನು</para>
  <para style="q2" vid="HOS 2:2">ಮತ್ತು ತನ್ನ ಸ್ತನಗಳ ಮಧ್ಯದಿಂದ ಅಪನಂಬಿಗಸ್ತಿಕೆಯನ್ನು ತ್ಯಜಿಸಲಿ.<verse eid="HOS 2:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="HOS 2:3"/>ಇಲ್ಲದಿದ್ದರೆ ನಾನು ಅವಳ ಬಟ್ಟೆಯನ್ನು ತೆಗೆದು,</para>
  <para style="q2" vid="HOS 2:3">ಅವಳು ಹುಟ್ಟಿದ ದಿವಸದಲ್ಲಿದ್ದ ಹಾಗೆ ಅವಳನ್ನು ಬೆತ್ತಲೆ ಮಾಡುತ್ತೇನೆ.</para>
  <para style="q1" vid="HOS 2:3">ಅವಳನ್ನು ಮರುಭೂಮಿಯಂತೆ ಮಾಡಿ,</para>
  <para style="q2" vid="HOS 2:3">ಅವಳನ್ನು ಒಣಗಿದ ಭೂಮಿಯಂತೆ ಇಟ್ಟು,</para>
  <para style="q2" vid="HOS 2:3">ದಾಹದಿಂದ ಅವಳನ್ನು ಕೊಲ್ಲುವೆನು.<verse eid="HOS 2:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="HOS 2:4"/>ನಾನು ಅವಳ ಮಕ್ಕಳಿಗೂ ಸಹ ಪ್ರೀತಿ ತೋರಿಸುವುದಿಲ್ಲ.</para>
  <para style="q2" vid="HOS 2:4">ಏಕೆಂದರೆ ಅವರು ವ್ಯಭಿಚಾರದ ಮಕ್ಕಳಾಗಿದ್ದಾರೆ.<verse eid="HOS 2:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="HOS 2:5"/>ಅವರ ತಾಯಿ ವಿಶ್ವಾಸದ್ರೋಹಿ</para>
  <para style="q2" vid="HOS 2:5">ಮತ್ತು ಅವಮಾನಕರವಾಗಿ ಅವರನ್ನು ಗರ್ಭಧರಿಸಿದ್ದಾರೆ.</para>
  <para style="q1" vid="HOS 2:5">ಅವಳು, ‘ನನಗೆ ನನ್ನ ಅನ್ನಪಾನ,</para>
  <para style="q2" vid="HOS 2:5">ನನ್ನ ಉಣ್ಣೆ ಮತ್ತು ನನ್ನ ನಾರಿನ ಉಡುಗೆ,</para>
  <para style="q1" vid="HOS 2:5">ನನ್ನ ತೈಲ, ನನ್ನ ಪಾಯಸಪಾನಕಗಳನ್ನು ಕೊಡುವಂಥ</para>
  <para style="q2" vid="HOS 2:5">ನನ್ನ ಪ್ರೇಮಿಗಳ ಹಿಂದೆ ಹೋಗುವೆನು,’ ಎಂದುಕೊಂಡಿದ್ದಾಳೆ.<verse eid="HOS 2:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="HOS 2:6"/>ಆದ್ದರಿಂದ ನಾನು ಅವಳ ಮಾರ್ಗಕ್ಕೆ ಮುಳ್ಳುಗಳ ಬೇಲಿಹಾಕಿ ತಡೆಯುವೆನು.</para>
  <para style="q2" vid="HOS 2:6">ಅವಳು ತನ್ನ ಹಾದಿಗಳನ್ನು ಕಾಣದ ಹಾಗೆ</para>
  <para style="q2" vid="HOS 2:6">ಅವಳ ಮುಂದೆ ಗೋಡೆಯನ್ನು ಕಟ್ಟುವೆನು.<verse eid="HOS 2:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="HOS 2:7"/>ಅವಳು ತನ್ನ ಪ್ರೇಮಿಗಳನ್ನು ಹಿಂಬಾಲಿಸಿದರೂ ಅವರನ್ನು ಸಂಧಿಸುವುದಿಲ್ಲ.</para>
  <para style="q2" vid="HOS 2:7">ಹುಡುಕಿದರೂ ಅವರು ಸಿಕ್ಕುವುದಿಲ್ಲ.</para>
  <para style="q1" vid="HOS 2:7">ಆಗ ಅವಳು ಹೀಗೆ ಎಂದುಕೊಳ್ಳುವಳು,</para>
  <para style="q2" vid="HOS 2:7">‘ನನ್ನ ಮೊದಲನೆಯ ಗಂಡನ ಬಳಿಗೆ ಹಿಂದಿರುಗಿ ಹೋಗುವೆನು.</para>
  <para style="q2" vid="HOS 2:7">ಏಕೆಂದರೆ ಆಗ ನನ್ನ ಸ್ಥಿತಿ ಪ್ರಸ್ತುತ ಸ್ಥಿತಿಗಿಂತ ಉತ್ತಮವಾಗಿತ್ತು.’<verse eid="HOS 2:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="HOS 2:8"/>ಏಕೆಂದರೆ ಅವರು ಬಾಳನಿಗಾಗಿ ಉಪಯೋಗಿಸಿದ</para>
  <para style="q2" vid="HOS 2:8">ಧಾನ್ಯ, ದ್ರಾಕ್ಷಾರಸ ಹಾಗೂ ಎಣ್ಣೆಯನ್ನು ನಾನೇ ಅವಳಿಗೆ ಕೊಟ್ಟು,</para>
  <para style="q1" vid="HOS 2:8">ಬೆಳ್ಳಿಬಂಗಾರವನ್ನು ನಾನೇ ಧಾರಾಳವಾಗಿ ಹೆಚ್ಚಿಸಿದೆನೆಂದು ಅವಳು ತಿಳಿಯಲಿಲ್ಲ.<verse eid="HOS 2:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="HOS 2:9"/>“ಆದ್ದರಿಂದ ನಾನು ತಿರುಗಿಕೊಂಡು,</para>
  <para style="q2" vid="HOS 2:9">ನನ್ನ ಧಾನ್ಯವನ್ನು ಅದರ ಕಾಲದಲ್ಲಿಯೂ,</para>
  <para style="q2" vid="HOS 2:9">ನನ್ನ ದ್ರಾಕ್ಷಾರಸವನ್ನು ಅದರ ಸುಗ್ಗಿಯ ಸಮಯದಲ್ಲಿಯೂ ತೆಗೆದ ಹಾಗೆ,</para>
  <para style="q1" vid="HOS 2:9">ಅವಳ ಬೆತ್ತಲೆತನವನ್ನು ಮುಚ್ಚವುದಕ್ಕಿದ್ದ ನನ್ನ ಉಣ್ಣೆಯನ್ನೂ,</para>
  <para style="q2" vid="HOS 2:9">ನನ್ನ ನಾರುಬಟ್ಟೆಯನ್ನೂ ತೆಗೆದುಕೊಳ್ಳುವೆನು.<verse eid="HOS 2:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="HOS 2:10"/>ಈಗ ಅವಳ ತುಚ್ಚತನವನ್ನು,</para>
  <para style="q2" vid="HOS 2:10">ಅವಳ ಪ್ರೇಮಿಗಳ ಕಣ್ಣುಗಳ ಮುಂದೆ ಬಯಲು ಪಡಿಸುವೆನು.</para>
  <para style="q2" vid="HOS 2:10">ನನ್ನ ಕೈಯೊಳಗಿಂದ ಅವಳನ್ನು ಯಾರೂ ಬಿಡಿಸರು.<verse eid="HOS 2:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="HOS 2:11"/>ನಾನು ಅವಳಿಗೆ ಉಲ್ಲಾಸಕರವಾದ ಅವಳ ಹಬ್ಬ,</para>
  <para style="q2" vid="HOS 2:11">ಅವಳ ಅಮಾವಾಸ್ಯೆ, ಅವಳ ಸಬ್ಬತ್ ದಿನದ ಆಚರಣೆ,</para>
  <para style="q2" vid="HOS 2:11">ಅವಳ ಸಭಾ ಸಮಾರಂಭ ಇವುಗಳನ್ನೆಲ್ಲಾ ನಿಲ್ಲಿಸಿಬಿಡುವೆನು.<verse eid="HOS 2:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="HOS 2:12"/>ತನ್ನ ಮಿಂಡರಿಂದಾದ ಪ್ರತಿಫಲ ಇವುಗಳೇ ಎಂದು,</para>
  <para style="q2" vid="HOS 2:12">ಅವಳು ಹೇಳಿದ ಅವಳ ದ್ರಾಕ್ಷಿಬಳ್ಳಿಗಳನ್ನು,</para>
  <para style="q2" vid="HOS 2:12">ಅವಳ ಅಂಜೂರದ ಮರಗಳನ್ನು ನಾನು ಹಾಳು ಮಾಡಿ,</para>
  <para style="q1" vid="HOS 2:12">ಅವುಗಳನ್ನು ನಾನು ಕಾಡನ್ನಾಗಿ ಮಾಡುವೆನು.</para>
  <para style="q2" vid="HOS 2:12">ಕಾಡುಮೃಗಗಳು ಅವುಗಳನ್ನು ನುಂಗುವವು.<verse eid="HOS 2:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="HOS 2:13"/>ತರುವಾಯ ಅವಳು ನನ್ನನ್ನು ಮರೆತು</para>
  <para style="q2" vid="HOS 2:13">ಕಿವಿಯೋಲೆ ಮೊದಲಾದ ಒಡವೆಗಳಿಂದ ಸಿಂಗರಿಸಿಕೊಂಡು,</para>
  <para style="q1" vid="HOS 2:13">ಅವಳ ಪ್ರೇಮಿಗಳ ಹಿಂದೆ ಹೋಗಿ,</para>
  <para style="q2" vid="HOS 2:13">ಬಾಳ್ ದೇವತೆಗಳಿಗೆ ಧೂಪ ಸುಟ್ಟ</para>
  <para style="q2" vid="HOS 2:13">ದಿವಸಗಳಿಗಾಗಿ ನಾನು ಅವಳನ್ನು ದಂಡಿಸುವೆನು,”</para>
  <para style="q2" vid="HOS 2:13">ಎಂದು ಯೆಹೋವ ದೇವರು ಹೇಳುತ್ತಾರೆ.<verse eid="HOS 2:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="HOS 2:14"/>ಆದ್ದರಿಂದ ನಾನು ಅವಳನ್ನು ಮೋಹಿಸಿ,</para>
  <para style="q2" vid="HOS 2:14">ಅವಳನ್ನು ಮರುಭೂಮಿಯೊಳಗೆ ಕರೆದುಕೊಂಡು ಬಂದು,</para>
  <para style="q2" vid="HOS 2:14">ಅವಳ ಸಂಗಡ ಹಿತಕರವಾಗಿ ಮಾತನಾಡುವೆನು.<verse eid="HOS 2:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="HOS 2:15"/>ಅವಳ ದ್ರಾಕ್ಷಿತೋಟಗಳನ್ನು ಅಲ್ಲಿರುವಾಗಲೇ ಅವಳಿಗೆ ಹಿಂದಕ್ಕೆ ಕೊಡುವೆನು.</para>
  <para style="q2" vid="HOS 2:15">ಆಕೋರಿನ<note caller="+" style="f"><char style="fr" closed="false">2:15 </char><char style="fq" closed="false">ಆಕೋರಿನ </char><char style="ft" closed="false">ಅಂದರೆ </char><char style="fqa" closed="false">ತೊಂದರೆ</char></note> ಕಣಿವೆಯನ್ನೇ, ಅವಳ ನಿರೀಕ್ಷೆಗೆ ದ್ವಾರವನ್ನಾಗಿ ಮಾಡುವೆನು.</para>
  <para style="q1" vid="HOS 2:15">ಅಲ್ಲಿ ಅವಳು ತಾನು ಯೌವನದ ದಿವಸಗಳಲ್ಲಿಯೂ,</para>
  <para style="q2" vid="HOS 2:15">ಈಜಿಪ್ಟ್ ದೇಶದೊಳಗಿಂದ ಹೊರಟು ಬಂದ</para>
  <para style="q2" vid="HOS 2:15">ದಿವಸಗಳಲ್ಲಿಯೂ ಆದ ಹಾಗೆ ಆಡುವಳು.<verse eid="HOS 2:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="HOS 2:16"/>ಯೆಹೋವ ದೇವರು ಹೀಗೆನ್ನುತ್ತಾರೆ, “ಆ ದಿವಸದಲ್ಲಿ,”</para>
  <para style="q2" vid="HOS 2:16">“ನೀನು ನನ್ನನ್ನು ಇನ್ನು ಮೇಲೆ, ‘ನನ್ನ ಒಡೆಯ’ ಎಂದು ಕರೆಯದೆ,</para>
  <para style="q2" vid="HOS 2:16">‘ನನ್ನ ಪತಿ’ ಎಂದು ಕರೆಯುವೆ.<verse eid="HOS 2:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="HOS 2:17"/>ನಾನು ಬಾಳ್ ದೇವತೆಗಳ ಹೆಸರುಗಳನ್ನು ಅವಳ ಬಾಯಿಯಿಂದ ತೆಗೆದುಹಾಕುವೆನು.</para>
  <para style="q2" vid="HOS 2:17">ಇನ್ನು ಮುಂದೆ ಅವರ ಹೆಸರನ್ನು ಕರೆಯಲಾಗುವುದಿಲ್ಲ.<verse eid="HOS 2:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="HOS 2:18"/>ಆ ದಿವಸದಲ್ಲಿ, ಅವರಿಗೋಸ್ಕರ ಅಡವಿಯ ಮೃಗಗಳ,</para>
  <para style="q2" vid="HOS 2:18">ಆಕಾಶದ ಪಕ್ಷಿಗಳ ಮತ್ತು</para>
  <para style="q2" vid="HOS 2:18">ಭೂಮಿಯ ಕ್ರಿಮಿಗಳ ಸಂಗಡ ಒಡಂಬಡಿಕೆ ಮಾಡುವೆನು.</para>
  <para style="q1" vid="HOS 2:18">ನಾನು ಬಿಲ್ಲನ್ನೂ, ಖಡ್ಗವನ್ನೂ ಯುದ್ಧವನ್ನೂ</para>
  <para style="q2" vid="HOS 2:18">ದೇಶದೊಳಗಿಂದ ಮುರಿದುಹಾಕಿ,</para>
  <para style="q2" vid="HOS 2:18">ಅವರೆಲ್ಲರೂ ಸುರಕ್ಷಿತರಾಗಿ ಮಲಗುವಂತೆ ಮಾಡುವೆನು.<verse eid="HOS 2:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="HOS 2:19"/>ನಿನ್ನನ್ನು ನನಗೆ ಸದಾಕಾಲಕ್ಕೆ ನಿಶ್ಚಿತಾರ್ಥ ಮಾಡಿಕೊಳ್ಳುವೆನು.</para>
  <para style="q2" vid="HOS 2:19">ನೀತಿಯಿಂದಲೂ, ನ್ಯಾಯದಿಂದಲೂ, ಪ್ರೀತಿಯಿಂದಲೂ, ಅನುಕಂಪದಿಂದಲೂ,</para>
  <para style="q2" vid="HOS 2:19">ನಿನ್ನನ್ನು ನನಗೆ ನಿಶ್ಚಿತಾರ್ಥ ಮಾಡಿಕೊಳ್ಳುವೆನು.<verse eid="HOS 2:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="HOS 2:20"/>ನಾನು ನಿನ್ನನ್ನು ನಂಬಿಗಸ್ತಿಕೆಯಿಂದಲೇ ನಿಶ್ಚಿತಾರ್ಥ ಮಾಡಿಕೊಳ್ಳುವೆನು.</para>
  <para style="q2" vid="HOS 2:20">ಆಗ ನೀನು ಯೆಹೋವ ದೇವರನ್ನು ತಿಳಿದುಕೊಳ್ಳುವೆ.<verse eid="HOS 2:20"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="21" style="v" sid="HOS 2:21"/>“ಆ ದಿವಸಗಳಲ್ಲಿ, ನಾನು ಕೇಳುವೆನು,”</para>
  <para style="q2" vid="HOS 2:21">ಎಂದು ಯೆಹೋವ ದೇವರು ಹೇಳುತ್ತಾರೆ.</para>
  <para style="q1" vid="HOS 2:21">“ನಾನು ಆಕಾಶಗಳನ್ನು ಕೇಳುವೆನು.</para>
  <para style="q2" vid="HOS 2:21">ಅವು ಭೂಮಿಯನ್ನು ಕೇಳುವುವು.<verse eid="HOS 2:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="HOS 2:22"/>ಭೂಮಿಯು ಧಾನ್ಯವನ್ನೂ,</para>
  <para style="q2" vid="HOS 2:22">ದ್ರಾಕ್ಷಾರಸವನ್ನೂ, ಎಣ್ಣೆಯನ್ನೂ ಕೇಳುವುವು.</para>
  <para style="q2" vid="HOS 2:22">ಅವು ಇಜ್ರೆಯೇಲಿಗೆ ಒಲಿಯುವುವು.<verse eid="HOS 2:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="HOS 2:23"/>ನಾನು ದೇಶದಲ್ಲಿ ಆಕೆಯನ್ನು ನನಗಾಗಿ ಬಿತ್ತಿಕೊಳ್ಳುವೆನು.</para>
  <para style="q2" vid="HOS 2:23">‘ನನ್ನ ಪ್ರಿಯರಲ್ಲ’ ಎಂದು ಕರೆದವರಿಗೆ, ನಾನು ನನ್ನ ಪ್ರೀತಿಯನ್ನು ತೋರಿಸುವೆನು.</para>
  <para style="q1" vid="HOS 2:23">ನಾನು, ‘ನೀವು ನನ್ನ ಜನರಲ್ಲ’ ಎಂದು ಹೇಳಿದವರನ್ನು,</para>
  <para style="q2" vid="HOS 2:23">‘ನೀವು ನನ್ನ ಜನರು,’ ಎಂದು ಹೇಳುವೆನು.</para>
  <para style="q2" vid="HOS 2:23">ಅವರು, ‘ನೀವು ನಮ್ಮ ದೇವರು’ ” ಎಂದು ಹೇಳುವರು.<verse eid="HOS 2:23"/></para>
  <chapter eid="HOS 2"/>
  <chapter number="3" style="c" sid="HOS 3"/>
  <para style="s1">ತನ್ನ ಪತ್ನಿಯೊಂದಿಗೆ ಹೋಶೇಯನ ಸಂಧಾನವಾದದ್ದು</para>
  <para style="p">
    <verse number="1" style="v" sid="HOS 3:1"/>ತರುವಾಯ ಯೆಹೋವ ದೇವರು ನನಗೆ, “ಬೇರೆ ದೇವತೆಗಳ ಕಡೆಗೆ ತಿರುಗಿಕೊಂಡು, ದ್ರಾಕ್ಷಿ ಉಂಡೆಗಳನ್ನು ಪ್ರೀತಿಸುವ ಇಸ್ರಾಯೇಲರನ್ನು ಯೆಹೋವ ದೇವರು ಪ್ರೀತಿಸುವ ಪ್ರಕಾರ, ನೀನು ಹೋಗಿ ನಿನ್ನ ಹೆಂಡತಿ ವ್ಯಭಿಚಾರಿಣಿಯಾಗಿದ್ದರೂ ಆಕೆಯನ್ನು ಪುನಃ ಪ್ರೀತಿಸು,” ಎಂದು ಹೇಳಿದನು.<verse eid="HOS 3:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="HOS 3:2"/>ಅಂತೆಯೇ ನಾನು ಅವಳನ್ನು ನನಗಾಗಿ ಹದಿನೈದು ಶೆಕೆಲ್ ಬೆಳ್ಳಿ<note caller="+" style="f"><char style="fr" closed="false">3:2 </char><char style="ft" closed="false">ಸುಮಾರು 170 ಗ್ರಾಂ</char></note> ಮತ್ತು ಸುಮಾರು ಒಂದು ಹೋಮೆರ್ ಹಾಗೂ ಒಂದು ಲೆಥೆಕ<note caller="+" style="f"><char style="fr" closed="false">3:2 </char><char style="ft" closed="false">ಸುಮಾರು 195 ಕಿಲೋಗ್ರಾಂ</char></note> ಜವೆಗೋಧಿಗೂ ಕೊಂಡುಕೊಂಡೆನು. <verse eid="HOS 3:2"/><verse number="3" style="v" sid="HOS 3:3"/>ನಾನು ಅವಳಿಗೆ, “ನನ್ನೊಂದಿಗೆ ಬಹಳ ದಿವಸಗಳು ನನಗಾಗಿ ಇರಬೇಕು. ನೀನು ವ್ಯಭಿಚಾರವನ್ನು ಮಾಡಬಾರದು. ನೀನು ಬೇರೆ ಪುರುಷನಿಗಾಗಿ ಇರಬಾರದು. ಆಗ ನಿನ್ನೊಂದಿಗೆ ಇರುವೆನು,” ಎಂದು ಹೇಳಿದೆನು.<verse eid="HOS 3:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="HOS 3:4"/>ಇಸ್ರಾಯೇಲರು ಬಹಳ ದಿವಸಗಳವರೆಗೆ ಅರಸನಿಲ್ಲದೆ, ರಾಜಕುಮಾರನಿಲ್ಲದೆ, ಬಲಿ ಇಲ್ಲದೆ, ಪವಿತ್ರ ಕಲ್ಲುಗಳಿಲ್ಲದೆ, ಏಫೋದ್ ಇಲ್ಲದೆ ಮತ್ತು ವಿಗ್ರಹಗಳು ಇಲ್ಲದೆ ಇರುವರು. <verse eid="HOS 3:4"/><verse number="5" style="v" sid="HOS 3:5"/>ಆಮೇಲೆ ಇಸ್ರಾಯೇಲರು ತಿರುಗಿಕೊಂಡು ಅವರ ದೇವರಾದ ಯೆಹೋವ ದೇವರನ್ನು ಮತ್ತು ಅವರ ಅರಸನಾದ ದಾವೀದನನ್ನು ಹುಡುಕಿಕೊಂಡು, ಅಂತ್ಯ ದಿವಸಗಳಲ್ಲಿ ಯೆಹೋವ ದೇವರನ್ನೂ, ಆತನ ಒಳ್ಳೆಯತನವನ್ನೂ ಭಯಭಕ್ತಿಯಿಂದ ಪಡೆಯುವರು.<verse eid="HOS 3:5"/></para>
  <chapter eid="HOS 3"/>
  <chapter number="4" style="c" sid="HOS 4"/>
  <para style="s1">ಇಸ್ರಾಯೇಲಿನ ವಿರುದ್ಧ ಆರೋಪ</para>
  <para style="q1">
    <verse number="1" style="v" sid="HOS 4:1"/>ಇಸ್ರಾಯೇಲರೇ, ಯೆಹೋವ ದೇವರ ವಾಕ್ಯವನ್ನು ಕೇಳಿರಿ:</para>
  <para style="q2" vid="HOS 4:1">ದೇಶದ ನಿವಾಸಿಗಳಾದ ನಿಮ್ಮ ಮೇಲೆ</para>
  <para style="q2" vid="HOS 4:1">ಯೆಹೋವ ದೇವರು ಆಪಾದನೆ ಹೊರಿಸಿದ್ದಾರೆ.</para>
  <para style="q1" vid="HOS 4:1">“ಏಕೆಂದರೆ ದೇಶದಲ್ಲಿ ಸತ್ಯವೂ ಇಲ್ಲ, ದಯೆಯೂ ಇಲ್ಲ,</para>
  <para style="q2" vid="HOS 4:1">ದೇವರ ತಿಳುವಳಿಕೆಯೂ ಇಲ್ಲ.<verse eid="HOS 4:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="HOS 4:2"/>ಶಪಿಸುವದೂ, ಸುಳ್ಳು ಹೇಳುವುದೂ, ಕೊಲ್ಲುವುದು,</para>
  <para style="q2" vid="HOS 4:2">ಕದಿಯುವುದೂ, ವ್ಯಭಿಚಾರ ಮಾಡುವುದೂ ಹೆಚ್ಚಾಗಿ ಬಿಟ್ಟಿವೆ.</para>
  <para style="q1" vid="HOS 4:2">ಅವರು ಎಲ್ಲಾ ಮಿತಿಗಳನ್ನು ಮೀರಿದ್ದಾರೆ.</para>
  <para style="q2" vid="HOS 4:2">ದೇಶವೆಲ್ಲಾ ರಕ್ತಮಯವಾಗಿದೆ.<verse eid="HOS 4:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="HOS 4:3"/>ಆದ್ದರಿಂದ ದೇಶವು ದುಃಖಪಡುತ್ತಿದೆ.</para>
  <para style="q2" vid="HOS 4:3">ಅದರಲ್ಲಿ ವಾಸಿಸುವ ಪ್ರತಿಯೊಬ್ಬನು ಕುಗ್ಗಿಹೋಗಿದ್ದಾನೆ.</para>
  <para style="q1" vid="HOS 4:3">ಅಡವಿಯ ಮೃಗಗಳೂ ಆಕಾಶದ ಪಕ್ಷಿಗಳೂ,</para>
  <para style="q2" vid="HOS 4:3">ಸಮುದ್ರ ಮೀನುಗಳು ನಶಿಸಿ ಹೋಗುತ್ತಿವೆ.<verse eid="HOS 4:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="HOS 4:4"/>“ಆದರೂ ಯಾವನಾದರೂ ವಾದಿಸದಿರಲಿ</para>
  <para style="q2" vid="HOS 4:4">ಇಲ್ಲವೆ ಬೇರೆಯವರನ್ನು ಖಂಡಿಸದಿರಲಿ.</para>
  <para style="q1" vid="HOS 4:4">ಏಕೆಂದರೆ ನಿಮ್ಮ ಜನರೆಲ್ಲರೂ</para>
  <para style="q2" vid="HOS 4:4">ಯಾಜಕನೊಂದಿಗೆ ವಾದಿಸುವವರಾಗಿದ್ದಾರೆ.<verse eid="HOS 4:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="HOS 4:5"/>ನೀನು ಹಗಲಿನಲ್ಲಿಯೂ, ರಾತ್ರಿಯಲ್ಲಿಯೂ ಬೀಳುವೆ.</para>
  <para style="q2" vid="HOS 4:5">ಪ್ರವಾದಿಗಳು ನಿನ್ನ ಸಂಗಡ ಮುಗ್ಗರಿಸಿಬೀಳುವರು.</para>
  <para style="q1" vid="HOS 4:5">ಆದ್ದರಿಂದ ನಾನು ನಿನ್ನ ತಾಯಿಯನ್ನು ನಾಶಮಾಡುವೆನು.<verse eid="HOS 4:5"/></para>
  <para style="q2">
    <verse number="6" style="v" sid="HOS 4:6"/>ನನ್ನ ಜನರು ಜ್ಞಾನಹೀನರಾಗಿ ಅಳಿದು ಹೋಗುತ್ತಿದ್ದಾರೆ.</para>
  <para style="b" vid="HOS 4:6"/>
  <para style="q1" vid="HOS 4:6">“ಏಕೆಂದರೆ ನೀವು ದೈವಜ್ಞಾನವನ್ನು ತಿರಸ್ಕರಿಸಿದ್ದೀರಿ.</para>
  <para style="q2" vid="HOS 4:6">ನಾನು ಸಹ ಯಾಜಕ ವರ್ಗದಿಂದ ನಿಮ್ಮನ್ನು ವರ್ಜಿಸಿ ಬಿಡುತ್ತೇನೆ.</para>
  <para style="q1" vid="HOS 4:6">ಏಕೆಂದರೆ ನೀವು ದೇವರ ನಿಯಮವನ್ನು ಮರೆತುಬಿಟ್ಟಿದ್ದೀರಿ,</para>
  <para style="q2" vid="HOS 4:6">ನಾನು ನಿಮ್ಮ ಮಕ್ಕಳನ್ನು ಮರೆತುಬಿಡುತ್ತೇನೆ.<verse eid="HOS 4:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="HOS 4:7"/>ಯಾಜಕರು ಹೆಚ್ಚಿದ ಹಾಗೆಲ್ಲಾ</para>
  <para style="q2" vid="HOS 4:7">ಅವರು ನನಗೆ ವಿರೋಧವಾಗಿ ಪಾಪಮಾಡಿದ್ದಾರೆ.</para>
  <para style="q2" vid="HOS 4:7">ಆದ್ದರಿಂದ ನಾನು ಅವರ ಮಾನವನ್ನು ಅವಮಾನವನ್ನಾಗಿ ಮಾರ್ಪಡಿಸುವೆನು.<verse eid="HOS 4:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="HOS 4:8"/>ಅವರು ನನ್ನ ಜನರ ಪಾಪವನ್ನು ತಿನ್ನುತ್ತಾರೆ.</para>
  <para style="q2" vid="HOS 4:8">ಅವರು ದುಷ್ಟತನದ ಮೇಲೆ ಅವರ ಮನಸ್ಸನ್ನು ಇಡುತ್ತಾರೆ.<verse eid="HOS 4:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="HOS 4:9"/>ಯಾಜಕನು ಹೇಗೋ ಹಾಗೆಯೇ ಜನರು ಇರುವರು.</para>
  <para style="q2" vid="HOS 4:9">ನಾನು ಅವರ ಮಾರ್ಗಗಳಿಗೋಸ್ಕರ ಅವರನ್ನು ಶಿಕ್ಷಿಸಿ,</para>
  <para style="q2" vid="HOS 4:9">ಅವರ ಕೃತ್ಯಗಳಿಗೆ ತಕ್ಕಂತೆ ಪ್ರತಿಫಲ ಕೊಡುವೆನು.<verse eid="HOS 4:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="HOS 4:10"/>“ಏಕೆಂದರೆ ಅವರು ತಿಂದರೂ ಸಾಕಾಗುವುದಿಲ್ಲ.</para>
  <para style="q2" vid="HOS 4:10">ಅವರು ವ್ಯಭಿಚಾರ ಮಾಡಿದರೂ ಅಭಿವೃದ್ಧಿ ಆಗುವುದಿಲ್ಲ.</para>
  <para style="q1" vid="HOS 4:10">ಏಕೆಂದರೆ ಅವರು ಯೆಹೋವ ದೇವರನ್ನೇ ಬಿಟ್ಟುಬಿಟ್ಟಿದ್ದಾರೆ.<verse eid="HOS 4:10"/></para>
  <para style="q2">
    <verse number="11" style="v" sid="HOS 4:11"/>ಮದ್ಯಪಾನ, ದ್ರಾಕ್ಷಾರಸ</para>
  <para style="q2" vid="HOS 4:11">ಇವು ಜನರನ್ನು ಜ್ಞಾನಹೀನರನ್ನಾಗಿ ಮಾಡುತ್ತವೆ.<verse eid="HOS 4:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="HOS 4:12"/>ನನ್ನ ಜನರು ಮರದ ತುಂಡುಗಳಿಂದ ಕಣಿ ಕೇಳುತ್ತಾರೆ.</para>
  <para style="q2" vid="HOS 4:12">ಹಿಡಿದ ಕೋಲಿನಿಂದ ಉತ್ತರ ಪಡೆಯಲು ಯತ್ನಿಸುತ್ತಾರೆ.</para>
  <para style="q1" vid="HOS 4:12">ಏಕೆಂದರೆ ವ್ಯಭಿಚಾರದ ಆತ್ಮವು ಅವರನ್ನು ತಪ್ಪಿಸಿಬಿಟ್ಟಿದೆ.</para>
  <para style="q2" vid="HOS 4:12">ಅವರು ತಮ್ಮ ದೇವರಿಗೆ ಅಪನಂಬಿಗಸ್ತರಾಗಿ ದ್ರೋಹ ಮಾಡಿದ್ದಾರೆ.<verse eid="HOS 4:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="HOS 4:13"/>ಅವರು ಬೆಟ್ಟಗಳ ತುದಿಯಲ್ಲಿ ಬಲಿಗಳನ್ನು ಅರ್ಪಿಸುತ್ತಾರೆ.</para>
  <para style="q2" vid="HOS 4:13">ಗುಡ್ಡಗಳ ಮೇಲೆ ಏಲಾ, ಲಿಬ್ನೆ,</para>
  <para style="q1" vid="HOS 4:13">ಏಲಾ ಮರಗಳ ಕೆಳಗೆ ಅವುಗಳ ನೆರಳು</para>
  <para style="q2" vid="HOS 4:13">ದಟ್ಟವಾಗಿರುವುದರಿಂದ ಧೂಪವನ್ನು ಸುಡುತ್ತಾರೆ.</para>
  <para style="q1" vid="HOS 4:13">ಆದ್ದರಿಂದ ನಿಮ್ಮ ಪುತ್ರಿಯರು ವ್ಯಭಿಚಾರ ಮಾಡುವರು.</para>
  <para style="q2" vid="HOS 4:13">ನಿಮ್ಮ ಸೊಸೆಯಂದಿರು ವ್ಯಭಿಚಾರಿಣಿಗಳಾಗುವರು.<verse eid="HOS 4:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="HOS 4:14"/>“ನಿಮ್ಮ ಪುತ್ರಿಯರು</para>
  <para style="q2" vid="HOS 4:14">ವ್ಯಭಿಚಾರ ಮಾಡುವಾಗಲೂ,</para>
  <para style="q1" vid="HOS 4:14">ನಿಮ್ಮ ಸೊಸೆಯಂದಿರು</para>
  <para style="q2" vid="HOS 4:14">ವ್ಯಭಿಚಾರ ಮಾಡುವಾಗಲೂ ನಾನು ಅವರನ್ನು ಶಿಕ್ಷಿಸುವುದಿಲ್ಲ.</para>
  <para style="q1" vid="HOS 4:14">ಏಕೆಂದರೆ ಪುರುಷರು ಸ್ವತಃ ವೇಶ್ಯೆಯರೊಂದಿಗೆ ವಾಸಿಸುತ್ತಾರೆ</para>
  <para style="q2" vid="HOS 4:14">ಮತ್ತು ದೇವಾಲಯದ ವೇಶ್ಯೆಯರೊಂದಿಗೆ ಬಲಿ ಅರ್ಪಿಸುತ್ತಾರೆ.</para>
  <para style="q2" vid="HOS 4:14">ಆದ್ದರಿಂದ ವಿವೇಕವಿಲ್ಲದ ಜನರು ನಾಶವಾಗುತ್ತಾರೆ.<verse eid="HOS 4:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="HOS 4:15"/>“ಇಸ್ರಾಯೇಲೇ, ನೀನು ವ್ಯಭಿಚಾರ ಮಾಡಿದರೂ,</para>
  <para style="q2" vid="HOS 4:15">ಯೆಹೂದವು ಆ ದೋಷಕ್ಕೆ ಒಳಗಾಗದಿರಲಿ.</para>
  <para style="b" vid="HOS 4:15"/>
  <para style="q1" vid="HOS 4:15">“ಗಿಲ್ಗಾಲಿಗೆ ಹೋಗದೆ,</para>
  <para style="q2" vid="HOS 4:15">ಇಲ್ಲವೆ ಬೇತಾವೆನಿಗೆ ಏರದೇ,</para>
  <para style="q2" vid="HOS 4:15">‘ಯೆಹೋವ ದೇವರ ಜೀವದಾಣೆ,’ ಎಂದು ಪ್ರಮಾಣ ಮಾಡದೆ ಇರಲಿ.<verse eid="HOS 4:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="HOS 4:16"/>ಹಠಮಾರಿ ಹಸುವಿನ ಹಾಗೆ</para>
  <para style="q2" vid="HOS 4:16">ಇಸ್ರಾಯೇಲು ಹಟಮಾರಿಯಾಗಿದೆ.</para>
  <para style="q1" vid="HOS 4:16">ಈಗ ಯೆಹೋವ ದೇವರು ಹುಲ್ಲುಗಾವಲಲ್ಲಿರುವ</para>
  <para style="q2" vid="HOS 4:16">ಕುರಿಮರಿಯ ಹಾಗೆ ಅವರನ್ನು ಹೇಗೆ ಮೇಯಿಸುವರು?<verse eid="HOS 4:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="HOS 4:17"/>ಎಫ್ರಾಯೀಮನು ವಿಗ್ರಹಗಳಿಗೆ ಸೇರಿಕೊಂಡಿದ್ದಾನೆ.</para>
  <para style="q2" vid="HOS 4:17">ಅವನನ್ನು ಅವನಷ್ಟಕ್ಕೆ ಬಿಟ್ಟುಬಿಡು.<verse eid="HOS 4:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="HOS 4:18"/>ಅವರು ಮಿತಿಮೀರಿ ಕುಡಿಯುತ್ತಾರೆ.</para>
  <para style="q2" vid="HOS 4:18">ಅವರು ಯಾವಾಗಲೂ ವ್ಯಭಿಚಾರ ಮಾಡುವವರಾಗಿದ್ದಾರೆ.</para>
  <para style="q2" vid="HOS 4:18">ಅವರನ್ನು ಆಳುವವರು ಅವಮಾನ ಕಾರ್ಯಗಳಲ್ಲಿ ಇಷ್ಟಪಡುತ್ತಾರೆ.<verse eid="HOS 4:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="HOS 4:19"/>ಗಾಳಿಯು ಅವರನ್ನು ತನ್ನ ರೆಕ್ಕೆಗಳಿಂದ ಬಂಧಿಸಿದೆ.</para>
  <para style="q2" vid="HOS 4:19">ಅವರು ತಮ್ಮ ಬಲಿಗಳಿಂದ ನಾಚಿಕೆಪಡುವರು.<verse eid="HOS 4:19"/></para>
  <chapter eid="HOS 4"/>
  <chapter number="5" style="c" sid="HOS 5"/>
  <para style="s1">ಇಸ್ರಾಯೇಲರ ವಿರುದ್ಧ ತೀರ್ಪು</para>
  <para style="q1">
    <verse number="1" style="v" sid="HOS 5:1"/>“ಯಾಜಕರೇ, ಇದನ್ನು ನೀವು ಕೇಳಿರಿ;</para>
  <para style="q2" vid="HOS 5:1">ಇಸ್ರಾಯೇಲಿನ ಮನೆತನದವರೇ ಕೇಳಿಸಿಕೊಳ್ಳಿರಿ;</para>
  <para style="q1" vid="HOS 5:1">ಅರಸನ ಮನೆಯವರೇ ಕಿವಿಗೊಡಿರಿ.</para>
  <para style="q2" vid="HOS 5:1">ನೀವು ಮಿಚ್ಪದಲ್ಲಿ ಉರುಲಾಗಿಯೂ,</para>
  <para style="q1" vid="HOS 5:1">ತಾಬೋರಿನ ಮೇಲೆ ಒಡ್ಡಿದ ಬಲೆಯಾಗಿಯೂ ಇದ್ದ ಕಾರಣ</para>
  <para style="q2" vid="HOS 5:1">ನಿಮಗೆ ವಿರುದ್ಧವಾಗಿ ಈ ನ್ಯಾಯತೀರ್ಪು ಬಂದಿದೆ.<verse eid="HOS 5:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="HOS 5:2"/>ನನಗೆ ತಿರುಗಿಬಿದ್ದವರು ಅಗಾಧವಾದ ಕೊಲೆಯನ್ನು ಮಾಡುವುದರಲ್ಲಿ ಮಗ್ನರಾಗಿದ್ದರೆ.</para>
  <para style="q2" vid="HOS 5:2">ಆದರೂ ನಾನು ಅವರೆಲ್ಲರನ್ನು ಶಿಕ್ಷಿಸುವವನಾಗಿದ್ದೇನೆ.<verse eid="HOS 5:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="HOS 5:3"/>ನಾನು ಎಫ್ರಾಯೀಮನ್ನು ಬಲ್ಲೆನು,</para>
  <para style="q2" vid="HOS 5:3">ಇಸ್ರಾಯೇಲು ನನಗೆ ಮರೆಯಾದದ್ದಲ್ಲ.</para>
  <para style="q1" vid="HOS 5:3">ಏಕೆಂದರೆ ಎಫ್ರಾಯೀಮೇ, ನೀನು ಈಗಲೇ ವ್ಯಭಿಚಾರ ಮಾಡಲು ತಿರುಗಿಕೊಂಡಿದ್ದೀ.</para>
  <para style="q2" vid="HOS 5:3">ಇಸ್ರಾಯೇಲು ಸಹ ಅಪವಿತ್ರವಾಯಿತು.<verse eid="HOS 5:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="HOS 5:4"/>“ಅವರು ತಮ್ಮ ದೇವರ ಬಳಿಗೆ ತಿರುಗಿಕೊಳ್ಳದಂತೆ,</para>
  <para style="q2" vid="HOS 5:4">ಅವರ ದುಷ್ಕೃತ್ಯಗಳು ಅವರಿಗೆ ಅಡ್ಡಿಯಾಗಿವೆ.</para>
  <para style="q1" vid="HOS 5:4">ವ್ಯಭಿಚಾರದ ಆತ್ಮವು ಅವರ ಹೃದಯದಲ್ಲಿದೆ.</para>
  <para style="q2" vid="HOS 5:4">ಅವರು ಯೆಹೋವ ದೇವರನ್ನು ಸ್ವೀಕರಿಸಿಕೊಳ್ಳುವುದಿಲ್ಲ.<verse eid="HOS 5:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="HOS 5:5"/>ಇಸ್ರಾಯೇಲಿನ ಗರ್ವವು ಅವರ ಮುಖದ ಮುಂದೆ ಸಾಕ್ಷಿಕೊಡುತ್ತದೆ.</para>
  <para style="q2" vid="HOS 5:5">ಇಸ್ರಾಯೇಲು ಮತ್ತು ಎಫ್ರಾಯೀಮು ತಮ್ಮ ಪಾಪದಲ್ಲಿ ಎಡವಿ ಬೀಳುವವು.</para>
  <para style="q2" vid="HOS 5:5">ಯೆಹೂದವು ಸಹ ಅವರೊಂದಿಗೆ ಬೀಳುವುದು.<verse eid="HOS 5:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="HOS 5:6"/>ಅವರು ಯೆಹೋವ ದೇವರನ್ನು</para>
  <para style="q2" vid="HOS 5:6">ಹುಡುಕುವುದಕ್ಕೆ ತಮ್ಮ ದನಕುರಿಗಳೊಂದಿಗೂ ಹೋಗುವರು.</para>
  <para style="q1" vid="HOS 5:6">ಆದರೆ ಆತನು ಅವರಿಂದ ತನ್ನನ್ನು ಹಿಂದೆಗೆದುಕೊಂಡಿದ್ದರಿಂದ,</para>
  <para style="q2" vid="HOS 5:6">ಅವರು ಆತನನ್ನು ಕಾಣುವುದೇ ಇಲ್ಲ.<verse eid="HOS 5:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="HOS 5:7"/>ಅವರು ಯೆಹೋವ ದೇವರಿಗೆ ಅಪನಂಬಿಗಸ್ತರಾಗಿದ್ದಾರೆ.</para>
  <para style="q2" vid="HOS 5:7">ಅವರು ವ್ಯಭಿಚಾರದ ಮಕ್ಕಳನ್ನು ಪಡೆದಿದ್ದಾರೆ.</para>
  <para style="q1" vid="HOS 5:7">ಅವರು ತಮ್ಮ ಅಮಾವಾಸ್ಯೆ ಹಬ್ಬಗಳನ್ನು ಆಚರಿಸಿದಾಗ,</para>
  <para style="q2" vid="HOS 5:7">ಅವರ ಹೊಲಗಳು ನುಂಗಿಬಿಡಲಾಗುವವು.<verse eid="HOS 5:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="HOS 5:8"/>“ಗಿಬೆಯದಲ್ಲಿ ತುತೂರಿಯನ್ನೂ</para>
  <para style="q2" vid="HOS 5:8">ರಾಮದಲ್ಲಿ ಕೊಂಬನ್ನೂ ಊದಿರಿ.</para>
  <para style="q1" vid="HOS 5:8">ಬೆನ್ಯಾಮೀನೇ, ನಿನ್ನ ಹಿಂದೆ ನೋಡು!</para>
  <para style="q2" vid="HOS 5:8">ಬೇತಾವೆನಿನಲ್ಲಿ ಗಟ್ಟಿಯಾಗಿ ಕೂಗು.<verse eid="HOS 5:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="HOS 5:9"/>ಎಫ್ರಾಯೀಮು ಗದರಿಸುವ</para>
  <para style="q2" vid="HOS 5:9">ದಿವಸದಲ್ಲೇ ಹಾಳಾಗುವುದು.</para>
  <para style="q1" vid="HOS 5:9">ಇಸ್ರಾಯೇಲಿನ ಗೋತ್ರಗಳಲ್ಲಿ</para>
  <para style="q2" vid="HOS 5:9">ನಾನು ನಿಶ್ಚಯವಾಗಿ ಆಗುವಂಥದ್ದನ್ನೇ ತಿಳಿಸಿದ್ದೇನೆ.<verse eid="HOS 5:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="HOS 5:10"/>ಯೆಹೂದದ ನಾಯಕರು</para>
  <para style="q2" vid="HOS 5:10">ಮೇರೆಗಳನ್ನು ಸರಿಸುವವರ ಹಾಗೆ ಇದ್ದರು.</para>
  <para style="q1" vid="HOS 5:10">ಅವರ ಮೇಲೆ,</para>
  <para style="q2" vid="HOS 5:10">ನೀರಿನ ಪ್ರವಾಹದಂತೆ ನನ್ನ ಕೋಪವನ್ನು ಸುರಿಸುವೆನು.<verse eid="HOS 5:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="HOS 5:11"/>ಎಫ್ರಾಯೀಮು, ವಿಗ್ರಹಗಳನ್ನು ಅನುಸರಿಸಲು ಮನಸ್ಸು ಮಾಡಿದ ಕಾರಣ,</para>
  <para style="q2" vid="HOS 5:11">ಅವನು ನ್ಯಾಯತೀರ್ಪಿಗೆ ಗುರಿಯಾಗಿ, ಹಿಂಸೆಗೆ ಒಳಗಾದನು.<verse eid="HOS 5:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="HOS 5:12"/>ನಾನು ಎಫ್ರಾಯೀಮಿಗೆ ನುಸಿಯ ಹಾಗೆಯೂ,</para>
  <para style="q2" vid="HOS 5:12">ಯೆಹೂದದ ಮನೆತನದವರಿಗೆ ಕೊಳೆಯುವಿಕೆಯ ಹಾಗೆಯೂ ಇರುವೆನು.<verse eid="HOS 5:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="HOS 5:13"/>“ಎಫ್ರಾಯೀಮು ತನ್ನ ರೋಗವನ್ನು</para>
  <para style="q2" vid="HOS 5:13">ಯೆಹೂದವು ತನ್ನ ಗಾಯವನ್ನು ನೋಡಿದಾಗ,</para>
  <para style="q1" vid="HOS 5:13">ಎಫ್ರಾಯೀಮ್ ಅಸ್ಸೀರಿಯಕ್ಕೆ ತಿರುಗಿ,</para>
  <para style="q2" vid="HOS 5:13">ಸಹಾಯಕ್ಕಾಗಿ ಮಹಾ ಅರಸನ ಬಳಿಗೆ ಕಳುಹಿಸಿತು.</para>
  <para style="q1" vid="HOS 5:13">ಆದರೆ ನಿಮ್ಮನ್ನು ಗುಣಪಡಿಸಲು</para>
  <para style="q2" vid="HOS 5:13">ಅವನು ಶಕ್ತನಲ್ಲ.</para>
  <para style="q2" vid="HOS 5:13">ನಿಮ್ಮ ಗಾಯವನ್ನು ಗುಣಪಡಿಸಲಾರನು.<verse eid="HOS 5:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="HOS 5:14"/>ಏಕೆಂದರೆ ನಾನು ಎಫ್ರಾಯೀಮಿಗೆ ಸಿಂಹದ ಹಾಗೆಯೂ,</para>
  <para style="q2" vid="HOS 5:14">ಯೆಹೂದದ ಮನೆತನದವರಿಗೆ ಪ್ರಾಯದ ಸಿಂಹದ ಹಾಗೆಯೂ ಇರುವೆನು.</para>
  <para style="q1" vid="HOS 5:14">ನಾನೇ ಅವರನ್ನು ಸೀಳಿಬಿಟ್ಟು ಹೋಗುವೆನು.</para>
  <para style="q2" vid="HOS 5:14">ನಾನು ಎತ್ತಿಕೊಂಡು ಹೋಗಲು, ಅವರನ್ನು ಯಾರೂ ಬಿಡಿಸಲಾರರು.<verse eid="HOS 5:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="HOS 5:15"/>ಅಪರಾಧಗಳನ್ನು ಅರಿಕೆಮಾಡಿ,</para>
  <para style="q2" vid="HOS 5:15">ನನ್ನ ಮುಖವನ್ನು ಹುಡುಕುವವರೆಗೂ,</para>
  <para style="q2" vid="HOS 5:15">ನಾನು ತಿರುಗಿಕೊಂಡು ನನ್ನ ಗುಹೆಗೆ ಹೋಗುವೆನು.</para>
  <para style="q1" vid="HOS 5:15">ಅವರ ಕಷ್ಟದಲ್ಲಿ</para>
  <para style="q2" vid="HOS 5:15">ಅವರು ನನ್ನನ್ನು ಬೇಗ ಹುಡುಕುವರು.”<verse eid="HOS 5:15"/></para>
  <chapter eid="HOS 5"/>
  <chapter number="6" style="c" sid="HOS 6"/>
  <para style="s1">ಪಶ್ಚಾತ್ತಾಪವಿಲ್ಲದ ಇಸ್ರಾಯೇಲರು</para>
  <para style="q1">
    <verse number="1" style="v" sid="HOS 6:1"/>ಬನ್ನಿರಿ, ನಾವು ಯೆಹೋವ ದೇವರ ಕಡೆಗೆ ತಿರುಗಿಕೊಳ್ಳೋಣ.</para>
  <para style="q1" vid="HOS 6:1">ಅವರು ನಮ್ಮನ್ನು ಗಾಯಗೊಳಿಸಿದ್ದಾರೆ,</para>
  <para style="q2" vid="HOS 6:1">ಅವರೇ ನಮ್ಮನ್ನು ಸ್ವಸ್ಥ ಮಾಡುವರು.</para>
  <para style="q1" vid="HOS 6:1">ಅವರು ಹೊಡೆದಿದ್ದಾನೆ,</para>
  <para style="q2" vid="HOS 6:1">ಅವರೇ ನಮ್ಮನ್ನು ಕಟ್ಟುವರು.<verse eid="HOS 6:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="HOS 6:2"/>ಅವರು ಎರಡು ದಿವಸಗಳಾದ ಮೇಲೆ ನಮ್ಮನ್ನು ಪುನರ್ಜೀವಿಸ ಮಾಡುವನು.</para>
  <para style="q2" vid="HOS 6:2">ಮೂರನೆಯ ದಿವಸದಲ್ಲಿ ಆತನೇ ನಮ್ಮನ್ನು ಪುನಃಸ್ಥಾಪಿಸುವರು.</para>
  <para style="q2" vid="HOS 6:2">ನಾವು ಅವರ ದೃಷ್ಟಿಯಲ್ಲಿ ಜೀವಿಸುವೆವು.<verse eid="HOS 6:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="HOS 6:3"/>ನಾವು ಯೆಹೋವ ದೇವರನ್ನು ತಿಳಿದುಕೊಳ್ಳಲು,</para>
  <para style="q2" vid="HOS 6:3">ಅವರನ್ನು ಹಿಂಬಾಲಿಸಿದರೆ ತಿಳಿದುಕೊಳ್ಳುವೆವು.</para>
  <para style="q1" vid="HOS 6:3">ಅವರ ಆಗಮನವು</para>
  <para style="q2" vid="HOS 6:3">ಅರುಣೋದಯದಂತೆ ನಿಶ್ಚಯ.</para>
  <para style="q1" vid="HOS 6:3">ಅವರು ಮಳೆಯಂತೆಯೂ ಮುಂಗಾರಿನಂತೆಯೂ,</para>
  <para style="q2" vid="HOS 6:3">ಭೂಮಿಯನ್ನು ತಂಪು ಮಾಡುವ ಹಿಂಗಾರಿನಂತೆಯೂ ಬಳಿಗೆ ಬರುವರು.<verse eid="HOS 6:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="HOS 6:4"/>ಎಫ್ರಾಯೀಮೇ, ನಿನಗೆ ನಾನು ಏನು ಮಾಡಲಿ?</para>
  <para style="q2" vid="HOS 6:4">ಯೆಹೂದವೇ, ನಿನಗೆ ನಾನು ಏನು ಮಾಡಲಿ?</para>
  <para style="q1" vid="HOS 6:4">ನಿಮ್ಮ ಪ್ರೀತಿಯು ಹೊತ್ತಾರೆಯ ಮೇಘದ ಹಾಗೆಯೂ,</para>
  <para style="q2" vid="HOS 6:4">ಮುಂಜಾನೆಯ ಮಂಜಿನ ಹಾಗೆಯೂ ಹೋಗಿಬಿಡುತ್ತದೆ.<verse eid="HOS 6:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="HOS 6:5"/>ಆದ್ದರಿಂದ ನಾನು ನಿಮ್ಮ ಜನರನ್ನು ಪ್ರವಾದಿಗಳ ಮುಖಾಂತರ ಕಡಿದುಬಿಟ್ಟು,</para>
  <para style="q2" vid="HOS 6:5">ನನ್ನ ಬಾಯಿಮಾತುಗಳಿಂದ ಅವರನ್ನು ಸಂಹರಿಸಿದ್ದೇನೆ.</para>
  <para style="q2" vid="HOS 6:5">ನನ್ನ ನ್ಯಾಯತೀರ್ಪುಗಳು ಸೂರ್ಯನ ಹಾಗೆ ಹೊರಟವು.<verse eid="HOS 6:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="HOS 6:6"/>ಏಕೆಂದರೆ ನಾನು ಯಜ್ಞವನ್ನಲ್ಲ, ಕರುಣೆಯನ್ನೇ ಅಪೇಕ್ಷಿಸುತ್ತೇನೆ.</para>
  <para style="q2" vid="HOS 6:6">ದಹನಬಲಿಗಳಿಗಿಂತ ದೇವರ ಅಂಗೀಕಾರವನ್ನೇ ಅಪೇಕ್ಷಿಸುತ್ತೇನೆ.<verse eid="HOS 6:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="HOS 6:7"/>ಅವರು ಆದಾಮನಂತೆ ಒಡಂಬಡಿಕೆಯನ್ನು ಮೀರಿದ್ದಾರೆ.</para>
  <para style="q2" vid="HOS 6:7">ಅಲ್ಲಿ ಅವರು ನನಗೆ ವಿರುದ್ಧವಾಗಿ ಅಪನಂಬಿಗಸ್ತಿಕೆಯಿಂದ ನಡೆದುಕೊಂಡಿದ್ದಾರೆ.<verse eid="HOS 6:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="HOS 6:8"/>ಗಿಲ್ಯಾದ್ ಕೆಟ್ಟ ಕೆಲಸ ಮಾಡುವವರ ಮತ್ತು</para>
  <para style="q2" vid="HOS 6:8">ರಕ್ತದಿಂದ ಅಪವಿತ್ರಮಾಡಿದ ಪಟ್ಟಣವಾಗಿದೆ.<verse eid="HOS 6:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="HOS 6:9"/>ದರೋಡೆಕೋರರು ಮನುಷ್ಯನಿಗೋಸ್ಕರ ಹೊಂಚುಹಾಕುವಂತೆ,</para>
  <para style="q2" vid="HOS 6:9">ಯಾಜಕರ ಗುಂಪು ದಾರಿಹೋಕರಿಗಾಗಿ ಹೊಂಚುಹಾಕುತ್ತಾ</para>
  <para style="q1" vid="HOS 6:9">ಶೆಕೆಮಿಗೆ ಹೋಗುವವರನ್ನು ದಾರಿಯಲ್ಲಿ ಕೊಲೆಮಾಡುತ್ತಾರೆ.</para>
  <para style="q2" vid="HOS 6:9">ಅವರು ನೀಚತನವನ್ನು ಮಾಡುವವರಾಗಿದ್ದಾರೆ.<verse eid="HOS 6:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="HOS 6:10"/>ಇಸ್ರಾಯೇಲಿನ ಮನೆತನದವರಲ್ಲಿ ಅತಿ ಭಯಂಕರವಾದ ಸಂಗತಿಯನ್ನು ನೋಡಿದೆನು.</para>
  <para style="q2" vid="HOS 6:10">ಅಲ್ಲಿ ಎಫ್ರಾಯೀಮಿನ ವ್ಯಭಿಚಾರವು ನಡೆಯುತ್ತದೆ,</para>
  <para style="q2" vid="HOS 6:10">ಇಸ್ರಾಯೇಲು ಅಪವಿತ್ರವಾಗಿದೆ.<verse eid="HOS 6:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="HOS 6:11"/>“ಯೆಹೂದವೇ, ನಿನಗೂ ಸಹ,</para>
  <para style="q2" vid="HOS 6:11">ತಕ್ಕ ಸುಗ್ಗಿಯು ನೇಮಕವಾಗಿದೆ.</para>
  <para style="b" vid="HOS 6:11"/>
  <para style="q1" vid="HOS 6:11">“ಸೆರೆಯಾದ ನನ್ನ ಜನರಿಗೆ, ಪುನಃಸ್ಥಾಪನೆಯಾಗುವುದು.<verse eid="HOS 6:11"/></para>
  <chapter eid="HOS 6"/>
  <chapter number="7" style="c" sid="HOS 7"/>
  <para style="q2">
    <verse number="1" style="v" sid="HOS 7:1"/>ನಾನು ಇಸ್ರಾಯೇಲನ್ನು ಗುಣ ಮಾಡಬೇಕೆಂದಿರುವಾಗ</para>
  <para style="q1" vid="HOS 7:1">ಎಫ್ರಾಯೀಮಿನ ಪಾಪಗಳನ್ನು ಬಹಿರಂಗಪಡಿಸುತ್ತೇನೆ.</para>
  <para style="q2" vid="HOS 7:1">ಮತ್ತು ಸಮಾರ್ಯದ ಕೆಟ್ಟತನವನ್ನು ಪ್ರಕಟಪಡಿಸುತ್ತೇನೆ.</para>
  <para style="q1" vid="HOS 7:1">ಅವರು ಸುಳ್ಳನ್ನು ನಡೆಸುತ್ತಾರೆ.</para>
  <para style="q2" vid="HOS 7:1">ಕಳ್ಳನು ಒಳಗೆ ಬರುತ್ತಾನೆ ಮತ್ತು</para>
  <para style="q2" vid="HOS 7:1">ಕಳ್ಳರ ಗುಂಪು ಹೊರಗೆ ಸುಲಿದುಕೊಳ್ಳುತ್ತದೆ.<verse eid="HOS 7:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="HOS 7:2"/>ಆದರೆ ನಾನು ಅವರ ಕೆಟ್ಟತನವನ್ನೆಲ್ಲಾ</para>
  <para style="q2" vid="HOS 7:2">ಜ್ಞಾಪಕ ಮಾಡುತ್ತೇನೆಂದು ಅವರು ತಮ್ಮ ಹೃದಯಗಳಲ್ಲಿ ನೆನೆಸಿಕೊಳ್ಳುವುದಿಲ್ಲ.</para>
  <para style="q1" vid="HOS 7:2">ಈಗ ಅವರ ಪಾಪಗಳು ಅವರನ್ನು ಸುತ್ತಿಕೊಂಡಿವೆ.</para>
  <para style="q2" vid="HOS 7:2">ಅವು ನನ್ನ ಮುಖದ ಮುಂದೆ ಇವೆ.<verse eid="HOS 7:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="HOS 7:3"/>“ಅವರು ತಮ್ಮ ಕೆಟ್ಟತನದಿಂದ ಅರಸನನ್ನೂ,</para>
  <para style="q2" vid="HOS 7:3">ಅವರ ಸುಳ್ಳಿನಿಂದ ರಾಜಕುಮಾರನನ್ನೂ ಸಂತೋಷ ಪಡಿಸುತ್ತಾರೆ.<verse eid="HOS 7:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="HOS 7:4"/>ಅವರೆಲ್ಲರು ವ್ಯಭಿಚಾರಿಗಳು,</para>
  <para style="q2" vid="HOS 7:4">ರೊಟ್ಟಿಸುಡುವವನು ಬೆಂಕಿಹೊತ್ತಿಸಿ, ಉರಿಸುವ ಒಲೆಗೆ ಸಮಾನರಾಗಿದ್ದಾರೆ.</para>
  <para style="q1" vid="HOS 7:4">ಅವನು ಹಿಟ್ಟು ನಾದಿದ ಮೇಲೆ,</para>
  <para style="q2" vid="HOS 7:4">ಅದು ಹುಳಿಯಾಗುವ ತನಕ ಉರಿಸದೆ ಬಿಟ್ಟಿರುವ ಕೆಂಡಕ್ಕೆ ಸಮಾನರಾಗಿದ್ದಾರೆ.<verse eid="HOS 7:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="HOS 7:5"/>ನಮ್ಮ ಅರಸನ ಹಬ್ಬದ ದಿವಸಗಳಲ್ಲಿ ರಾಜಕುಮಾರರು</para>
  <para style="q2" vid="HOS 7:5">ದ್ರಾಕ್ಷಾರಸವನ್ನು ಕುಡಿದು ಮತ್ತರಾಗುತ್ತಾರೆ.</para>
  <para style="q2" vid="HOS 7:5">ಅವನು ಪರಿಹಾಸ್ಯಗಾರರ ಸಂಗಡ ತನ್ನ ಕೈಚಾಚುತ್ತಾನೆ.<verse eid="HOS 7:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="HOS 7:6"/>ಅವರು ಹೊಂಚುಹಾಕಿಕೊಂಡಿದ್ದಾಗ,</para>
  <para style="q2" vid="HOS 7:6">ತಮ್ಮ ಹೃದಯವನ್ನು ಅವರು ಒಲೆಯ ಹಾಗೆ ಸಿದ್ಧಮಾಡಿದ್ದಾರೆ.</para>
  <para style="q1" vid="HOS 7:6">ಅವರ ರೋಷಾಗ್ನಿಯು ರಾತ್ರಿಯೆಲ್ಲಾ ಹೊತ್ತಿಕೊಂಡೇ ಇರುತ್ತದೆ</para>
  <para style="q2" vid="HOS 7:6">ಬೆಳಿಗ್ಗೆ ಅದು ಪ್ರಜ್ವಲಿಸುವ ಬೆಂಕಿಯ ಹಾಗೆ ಉರಿಯುತ್ತದೆ.<verse eid="HOS 7:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="HOS 7:7"/>ಅವರೆಲ್ಲರೂ ಒಲೆಯ ಹಾಗೆ ಬಿಸಿಯಾಗಿದ್ದಾರೆ.</para>
  <para style="q2" vid="HOS 7:7">ಅವರು ತಮ್ಮ ನ್ಯಾಯಾಧಿಪತಿಗಳನ್ನು ನುಂಗಿಬಿಡುತ್ತಾರೆ.</para>
  <para style="q1" vid="HOS 7:7">ಅವರ ಅರಸರೆಲ್ಲರು ಬಿದ್ದು ಹೋಗಿದ್ದಾರೆ.</para>
  <para style="q2" vid="HOS 7:7">ಅವರಲ್ಲಿ ಒಬ್ಬನಾದರೂ ನನ್ನನ್ನು ಕರೆಯುವುದಿಲ್ಲ.<verse eid="HOS 7:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="HOS 7:8"/>“ಎಫ್ರಾಯೀಮು ಜನಾಂಗಗಳೊಂದಿಗೆ ತನ್ನನ್ನು ಬೆರೆಸಿಕೊಂಡಿದೆ.</para>
  <para style="q2" vid="HOS 7:8">ಎಫ್ರಾಯೀಮು ತಿರುವಿ ಹಾಕದ ರೊಟ್ಟಿಯಾಗಿದ್ದಾನೆ.<verse eid="HOS 7:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="HOS 7:9"/>ವಿದೇಶಿಯರು ಅವನ ಶಕ್ತಿಯನ್ನು ಹೀರಿಬಿಟ್ಟಿದ್ದಾರೆ.</para>
  <para style="q2" vid="HOS 7:9">ಅದು ಅವನಿಗೆ ಗೊತ್ತಿಲ್ಲ.</para>
  <para style="q1" vid="HOS 7:9">ನರೆಕೂದಲು ಸಹ ಅವನ ಮೇಲೆ ಇದೆ.</para>
  <para style="q2" vid="HOS 7:9">ಆದರೂ ಅವನು ತಿಳಿಯದೇ ಇದ್ದಾನೆ.<verse eid="HOS 7:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="HOS 7:10"/>ಇಸ್ರಾಯೇಲಿನ ಗರ್ವವು</para>
  <para style="q2" vid="HOS 7:10">ಅವನಿಗೆ ವಿರುದ್ಧವಾಗಿ ಸಾಕ್ಷಿಕೊಡುತ್ತದೆ.</para>
  <para style="q1" vid="HOS 7:10">ಆದರೂ ಅವರು ತಮ್ಮ ಯೆಹೋವ ದೇವರ ಕಡೆಗೆ ತಿರುಗದೆ ಇದ್ದಾರೆ.</para>
  <para style="q2" vid="HOS 7:10">ಆತನನ್ನು ಹುಡುಕದೇ ಇದ್ದಾರೆ.<verse eid="HOS 7:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="HOS 7:11"/>“ಎಫ್ರಾಯೀಮು ಸಹ ಸುಲಭವಾಗಿ ಮೋಸಕ್ಕೆ ಒಳಗಾಗುವ</para>
  <para style="q2" vid="HOS 7:11">ಪಾರಿವಾಳದ ಹಾಗಿದ್ದಾನೆ.</para>
  <para style="q1" vid="HOS 7:11">ಈಗ ಅವರು ಈಜಿಪ್ಟನ್ನು ಕರೆಯುತ್ತಾರೆ.</para>
  <para style="q2" vid="HOS 7:11">ಈಗ ಅವರು ಅಸ್ಸೀರಿಯದ ಆಶ್ರಯಕ್ಕೆ ಹೋಗುತ್ತಾರೆ.<verse eid="HOS 7:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="HOS 7:12"/>ಅವರು ಹೋಗುವಾಗ, ನಾನು ಅವರ ಮೇಲೆ ನನ್ನ ಬಲೆಯನ್ನು ಹಾಸುವೆನು.</para>
  <para style="q2" vid="HOS 7:12">ಆಕಾಶದ ಪಕ್ಷಿಗಳ ಹಾಗೆ, ಅವರನ್ನು ಕೆಳಗೆ ಇಳಿಸಿ,</para>
  <para style="q1" vid="HOS 7:12">ಅವರು ಒಟ್ಟಿಗೆ ಸೇರುವುದನ್ನು ನಾನು ಕೇಳಿದಾಗ,</para>
  <para style="q2" vid="HOS 7:12">ನಾನು ಅವುಗಳನ್ನು ಹಿಡಿಯುತ್ತೇನೆ.<verse eid="HOS 7:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="HOS 7:13"/>ಅವರಿಗೆ ಕಷ್ಟ,</para>
  <para style="q2" vid="HOS 7:13">ಏಕೆಂದರೆ ಅವರು ನನ್ನನ್ನು ಬಿಟ್ಟು ಹೋಗಿದ್ದಾರೆ.</para>
  <para style="q1" vid="HOS 7:13">ಅವರು ನಾಶವಾಗಲಿ!</para>
  <para style="q2" vid="HOS 7:13">ಏಕೆಂದರೆ ಅವರು ನನಗೆ ವಿರುದ್ಧವಾಗಿ ದ್ರೋಹ ಮಾಡಿದ್ದಾರೆ.</para>
  <para style="q1" vid="HOS 7:13">ನಾನು ಅವರಿಗೆ ವಿಮೋಚನೆ ಮಾಡಿದ್ದರೂ,</para>
  <para style="q2" vid="HOS 7:13">ಅವರು ನನಗೆ ವಿರುದ್ಧವಾಗಿ ಸುಳ್ಳು ಹೇಳಿದ್ದಾರೆ.<verse eid="HOS 7:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="HOS 7:14"/>ತಮ್ಮ ಹಾಸಿಗೆಯ ಮೇಲೆ ಗೋಳಾಡುವಾಗಲೂ,</para>
  <para style="q2" vid="HOS 7:14">ಅವರು ತಮ್ಮ ಹೃದಯದಿಂದ ನನ್ನನ್ನು ಕೂಗಲಿಲ್ಲ.</para>
  <para style="q1" vid="HOS 7:14">ಧಾನ್ಯ ಮತ್ತು ದ್ರಾಕ್ಷಾರಸಗಳ ನಿಮಿತ್ತ</para>
  <para style="q2" vid="HOS 7:14">ಅವರು ತಮ್ಮ ದೇವರುಗಳಿಗೆ ಮನವಿ ಮಾಡುವಾಗ ತಮ್ಮನ್ನು ತಾವು ಗಾಯಗೊಳಿಸಿಕೊಳ್ಳುತ್ತಾರೆ,</para>
  <para style="q2" vid="HOS 7:14">ಆದರೆ ಅವರು ನನ್ನಿಂದ ದೂರವಿರುತ್ತಾರೆ.<verse eid="HOS 7:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="HOS 7:15"/>ನಾನು ಅವರ ತೋಳುಗಳನ್ನು ಬಂಧಿಸಿ ಬಲಪಡಿಸಿದ್ದೇನೆ.</para>
  <para style="q2" vid="HOS 7:15">ಆದರೂ ಅವರು ನನಗೆ ವಿರುದ್ಧವಾಗಿ ಕೇಡು ಮಾಡಲು ಊಹಿಸಿಕೊಂಡಿದ್ದಾರೆ.<verse eid="HOS 7:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="HOS 7:16"/>ಅವರು ಮಹೋನ್ನತನಾದಾತನ ಕಡೆಗೆ ತಿರುಗಿಕೊಳ್ಳುವುದಿಲ್ಲ.</para>
  <para style="q2" vid="HOS 7:16">ಅವರು ಮೋಸದ ಬಿಲ್ಲಿನ ಹಾಗೆ ಇದ್ದಾರೆ.</para>
  <para style="q1" vid="HOS 7:16">ಅವರ ನಾಯಕರು ನಾಲಿಗೆಯ ಹುಚ್ಚು ಕೂಗಾಟದಿಂದ,</para>
  <para style="q2" vid="HOS 7:16">ಖಡ್ಗದಿಂದ ಬೀಳುವರು.</para>
  <para style="q1" vid="HOS 7:16">ಇದೇ ಈಜಿಪ್ಟ್ ದೇಶದಲ್ಲಿ</para>
  <para style="q2" vid="HOS 7:16">ಅವರಿಗಿರುವ ನಿಂದೆಯಾಗಿದೆ.<verse eid="HOS 7:16"/></para>
  <chapter eid="HOS 7"/>
  <chapter number="8" style="c" sid="HOS 8"/>
  <para style="s1">ಇಸ್ರಾಯೇಲ್ ಸುಂಟರಗಾಳಿಯನ್ನು ಕೊಯ್ಲು ಮಾಡುವುದು</para>
  <para style="q1">
    <verse number="1" style="v" sid="HOS 8:1"/>“ನಿನ್ನ ಬಾಯಿಗೆ ತುತೂರಿಯನ್ನು ಇಟ್ಟುಕೋ.</para>
  <para style="q2" vid="HOS 8:1">ಅವರು ನನ್ನ ಒಡಂಬಡಿಕೆಯನ್ನು ಮೀರಿ,</para>
  <para style="q1" vid="HOS 8:1">ನನ್ನ ನ್ಯಾಯ ಪ್ರಮಾಣಕ್ಕೆ ವಿರುದ್ಧವಾಗಿ ಅಪರಾಧ ಮಾಡಿದ್ದರಿಂದ</para>
  <para style="q2" vid="HOS 8:1">ಶತ್ರುಗಳು ಹದ್ದಿನ ಹಾಗೆ ಯೆಹೋವ ದೇವರ ಆಲಯದ ಮೇಲೆ ಬರುವರು.<verse eid="HOS 8:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="HOS 8:2"/>ಇಸ್ರಾಯೇಲಿನವರು, ‘ನನ್ನ ದೇವರೇ, ನಾವು ನಿಮ್ಮನ್ನು ತಿಳಿದಿದ್ದೇವೆ,’</para>
  <para style="q2" vid="HOS 8:2">ಎಂದು ನನಗೆ ಕೂಗುತ್ತಿದ್ದಾರೆ.<verse eid="HOS 8:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="HOS 8:3"/>ಆದರೆ ಇಸ್ರಾಯೇಲು ಒಳ್ಳೆಯ ಸಂಗತಿಯನ್ನು ತಳ್ಳಿಬಿಟ್ಟಿದೆ.</para>
  <para style="q2" vid="HOS 8:3">ಒಬ್ಬ ಶತ್ರುವು ಅವನನ್ನು ಹಿಂದಟ್ಟುವನು.<verse eid="HOS 8:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="HOS 8:4"/>ಅವರು ಅರಸರನ್ನು ನೇಮಿಸಿದ್ದಾರೆ.</para>
  <para style="q2" vid="HOS 8:4">ಆದರೆ ನನ್ನಿಂದಲ್ಲ. ಅವರು ನನ್ನ ಅನುಮತಿಯಿಲ್ಲದೆ</para>
  <para style="q1" vid="HOS 8:4">ರಾಜಕುಮಾರರನ್ನು ಆಯ್ಕೆ ಮಾಡಿದ್ದಾರೆ.</para>
  <para style="q2" vid="HOS 8:4">ಅವರು ತಾವು ನಾಶವಾಗುವಂತೆ</para>
  <para style="q1" vid="HOS 8:4">ತಮ್ಮ ಬೆಳ್ಳಿಯಿಂದಲೂ, ತಮ್ಮ ಬಂಗಾರದಿಂದಲೂ</para>
  <para style="q2" vid="HOS 8:4">ತಮಗೆ ವಿಗ್ರಹಗಳನ್ನು ಮಾಡಿಕೊಂಡಿದ್ದಾರೆ.<verse eid="HOS 8:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="HOS 8:5"/>ಸಮಾರ್ಯವೇ, ನಿನ್ನ ಬಸವ ವಿಗ್ರಹವನ್ನು ಬಿಸಾಡಿಬಿಡು.</para>
  <para style="q2" vid="HOS 8:5">ನನ್ನ ಕೋಪವು ಅವರ ಮೇಲೆ ಉರಿಯುತ್ತದೆ.</para>
  <para style="q1" vid="HOS 8:5">ಅವರು ಎಷ್ಟು ಕಾಲ ಶುದ್ಧತೆಗೆ ಅಸಮರ್ಥರಾಗಿರುತ್ತಾರೆ?<verse eid="HOS 8:5"/></para>
  <para style="q2">
    <verse number="6" style="v" sid="HOS 8:6"/>ಅವರು ಇಸ್ರಾಯೇಲಿನಿಂದ ಬಂದವರು.</para>
  <para style="q1" vid="HOS 8:6">ಕಮ್ಮಾರನು ಈ ಬಸವ ವಿಗ್ರಹವನ್ನು ಮಾಡಿದನು.</para>
  <para style="q2" vid="HOS 8:6">ಅದು ದೇವರಲ್ಲ,</para>
  <para style="q1" vid="HOS 8:6">ಆದರೆ ಸಮಾರ್ಯದ</para>
  <para style="q2" vid="HOS 8:6">ಬಸವನನ್ನು ಚೂರುಚೂರಾಗುವುದು.<verse eid="HOS 8:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="HOS 8:7"/>“ಅವರು ಗಾಳಿಯನ್ನು ಬಿತ್ತಿದ್ದಾರೆ.</para>
  <para style="q2" vid="HOS 8:7">ಬಿರುಗಾಳಿಯನ್ನು ಕೊಯ್ಯುತ್ತಾರೆ.</para>
  <para style="q1" vid="HOS 8:7">ಇಸ್ರಾಯೇಲರ ಪೈರು ತೆನೆಗೆ ಬಾರದು.</para>
  <para style="q2" vid="HOS 8:7">ಮೊಳಕೆಯು ಆಹಾರವನ್ನು ಕೊಡುವುದಿಲ್ಲ.</para>
  <para style="q1" vid="HOS 8:7">ಒಂದು ವೇಳೆ ಅದು ಕೊಟ್ಟರೂ</para>
  <para style="q2" vid="HOS 8:7">ವಿದೇಶಿಯರು ಅದನ್ನು ನುಂಗುತ್ತಾರೆ.<verse eid="HOS 8:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="HOS 8:8"/>ಇಸ್ರಾಯೇಲನ್ನು ಕಬಳಿಸಲಾಗಿದೆ.</para>
  <para style="q2" vid="HOS 8:8">ಅವರು ಜನಾಂಗಗಳಲ್ಲಿ</para>
  <para style="q2" vid="HOS 8:8">ಬೇಡವಾದ ಪಾತ್ರೆಯ ಹಾಗೆ ಇದ್ದಾರೆ.<verse eid="HOS 8:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="HOS 8:9"/>ಅವರು ಒಂಟಿಯಾದ ಕಾಡುಕತ್ತೆಯ ಹಾಗೆ</para>
  <para style="q2" vid="HOS 8:9">ಅಸ್ಸೀರಿಯಗೆ ಹೋಗಿದ್ದಾರೆ.</para>
  <para style="q2" vid="HOS 8:9">ಎಫ್ರಾಯೀಮು ಪ್ರೇಮಿಗಳಿಗೆ ತನ್ನನ್ನು ಮಾರಿಕೊಂಡಿದೆ.<verse eid="HOS 8:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="HOS 8:10"/>ಎಫ್ರಾಯೀಮು ಜನಾಂಗಗಳಿಗೆ ತಮ್ಮನ್ನು ಮಾರಿಕೊಂಡಿದ್ದರೂ</para>
  <para style="q2" vid="HOS 8:10">ಅವರನ್ನು ನಾನು ಈಗ ಒಟ್ಟುಗೂಡಿಸುವೆನು.</para>
  <para style="q1" vid="HOS 8:10">ಅವರು ಪ್ರಬಲ ಅರಸನ ಹಿಂಸೆಯಿಂದಾಗಿ ಕಷ್ಟಪಡುವರು.<verse eid="HOS 8:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="HOS 8:11"/>“ಎಫ್ರಾಯೀಮು ಪಾಪ ಪರಿಹಾರಕ್ಕಾಗಿ ಅನೇಕ ಬಲಿಪೀಠಗಳನ್ನು ಕಟ್ಟಿದ್ದರೂ,</para>
  <para style="q2" vid="HOS 8:11">ಈ ಬಲಿಪೀಠಗಳೇ ಅವರ ಪಾಪಕ್ಕೆ ಕಾರಣವಾಗಿವೆ.<verse eid="HOS 8:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="HOS 8:12"/>ನಾನು ನನ್ನ ನಿಯಮದ ಅನೇಕ ಸಂಗತಿಗಳನ್ನು ಅವನಿಗೆ ಬರೆದಿದ್ದೇನೆ.</para>
  <para style="q2" vid="HOS 8:12">ಆದರೆ ಅವನು ಅವುಗಳನ್ನು ಅನ್ಯವಾದವುಗಳೆಂದು ಪರಿಗಣಿಸಿದನು.<verse eid="HOS 8:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="HOS 8:13"/>ಅವರು ಯಜ್ಞದ ಮಾಂಸವನ್ನು ಬಲಿಯಾಗಿ ಅರ್ಪಿಸಿ,</para>
  <para style="q2" vid="HOS 8:13">ನನ್ನ ಕಾಣಿಕೆಗಳಿಂದ ಬಲಿಗಳನ್ನು ತಿನ್ನುತ್ತಾರೆ.</para>
  <para style="q2" vid="HOS 8:13">ಆದರೆ ಯೆಹೋವ ದೇವರು ಅವುಗಳಿಗೆ ಮೆಚ್ಚುವುದಿಲ್ಲ.</para>
  <para style="q1" vid="HOS 8:13">ಈಗ ಅವರ ಅಕ್ರಮಗಳನ್ನು ಜ್ಞಾಪಕಮಾಡಿಕೊಂಡು,</para>
  <para style="q2" vid="HOS 8:13">ಅವರ ಪಾಪಗಳನ್ನು ಶಿಕ್ಷಿಸಿದರು.</para>
  <para style="q2" vid="HOS 8:13">ಅವರು ಈಜಿಪ್ಟಿಗೆ ಹಿಂದಿರುಗುವರು.<verse eid="HOS 8:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="HOS 8:14"/>ಇಸ್ರಾಯೇಲರು ತಮ್ಮ ಸೃಷ್ಟಿಕರ್ತನನ್ನು ಮರೆತುಬಿಟ್ಟು,</para>
  <para style="q2" vid="HOS 8:14">ಅರಮನೆಗಳನ್ನು ಕಟ್ಟುತ್ತಾರೆ.</para>
  <para style="q2" vid="HOS 8:14">ಯೆಹೂದವು ಸಹ ಕೋಟೆಯುಳ್ಳ ಪಟ್ಟಣಗಳನ್ನು ಹೆಚ್ಚುಮಾಡಿಕೊಂಡಿದೆ.</para>
  <para style="q1" vid="HOS 8:14">ಆದರೆ ನಾನು ಅದರ ಪಟ್ಟಣಗಳ ಮೇಲೆ ಬೆಂಕಿಯನ್ನು ಕಳುಹಿಸುವೆನು.</para>
  <para style="q2" vid="HOS 8:14">ಅದು ಅವರ ಕೋಟೆಗಳನ್ನು ನುಂಗಿಬಿಡುವುದು.”<verse eid="HOS 8:14"/></para>
  <chapter eid="HOS 8"/>
  <chapter number="9" style="c" sid="HOS 9"/>
  <para style="s1">ಇಸ್ರಾಯೇಲರಿಗೆ ದಂಡನೆ</para>
  <para style="q1">
    <verse number="1" style="v" sid="HOS 9:1"/>ಇಸ್ರಾಯೇಲೇ, ಬೇರೆ ಜನಾಂಗಗಳು ಉಲ್ಲಾಸಿಸುವ ಪ್ರಕಾರ</para>
  <para style="q2" vid="HOS 9:1">ಸಂತೋಷ ಪಡಬೇಡ.</para>
  <para style="q1" vid="HOS 9:1">ಏಕೆಂದರೆ ನೀನು ನಿನ್ನ ದೇವರನ್ನು ಬಿಟ್ಟು ವ್ಯಭಿಚಾರ ಮಾಡಿದ್ದೀಯೆ.</para>
  <para style="q2" vid="HOS 9:1">ಎಲ್ಲಾ ಧಾನ್ಯದ ಕಣಗಳಲ್ಲಿ</para>
  <para style="q2" vid="HOS 9:1">ವ್ಯಭಿಚಾರದ ಕೂಲಿಯನ್ನು ಪ್ರೀತಿ ಮಾಡಿದ್ದೀಯೆ.<verse eid="HOS 9:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="HOS 9:2"/>ಧಾನ್ಯ ಕಣವು ಮತ್ತು ದ್ರಾಕ್ಷಿಯ ತೊಟ್ಟಿಯೂ ಅವರನ್ನು ಪೋಷಿಸುವುದಿಲ್ಲ.</para>
  <para style="q2" vid="HOS 9:2">ಹೊಸ ದ್ರಾಕ್ಷಾರಸವು ಅವಳಲ್ಲಿ ನಿಂತುಹೋಗುವುವು.<verse eid="HOS 9:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="HOS 9:3"/>ಅವರು ಯೆಹೋವ ದೇವರ ದೇಶದಲ್ಲಿ ನೆಲೆಸುವುದಿಲ್ಲ.</para>
  <para style="q2" vid="HOS 9:3">ಆದರೆ ಎಫ್ರಾಯೀಮು ಈಜಿಪ್ಟಿಗೆ ಹಿಂದಿರುಗುವುದು.</para>
  <para style="q2" vid="HOS 9:3">ಅವರು ಅಸ್ಸೀರಿಯದಲ್ಲಿ ಅಶುದ್ಧವಾದವುಗಳನ್ನು ತಿನ್ನುವರು.<verse eid="HOS 9:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="HOS 9:4"/>ಅವರು ದ್ರಾಕ್ಷಾರಸವನ್ನು ಕಾಣಿಕೆಯಾಗಿ ಯೆಹೋವ ದೇವರಿಗೆ ಅರ್ಪಿಸುವುದಿಲ್ಲ.</para>
  <para style="q2" vid="HOS 9:4">ಅವರ ಬಲಿಗಳು ಆತನಿಗೆ ಮೆಚ್ಚಿಗೆಯಾಗಿರುವುದಿಲ್ಲ.</para>
  <para style="q1" vid="HOS 9:4">ಅವರ ಬಲಿಗಳು ಅವರಿಗೆ ದುಃಖಿಸುವವರ ರೊಟ್ಟಿಯ ಹಾಗಿರುವುವು.</para>
  <para style="q2" vid="HOS 9:4">ಅದನ್ನು ತಿನ್ನುವವರೆಲ್ಲರೂ ಅಪವಿತ್ರರಾಗುವರು.</para>
  <para style="q1" vid="HOS 9:4">ಏಕೆಂದರೆ ಅದು ಅವರ ಹೊಟ್ಟೆ ತುಂಬುವುದಕ್ಕೆ ಮಾತ್ರ ಸರಿಯೇ ಹೊರತು,</para>
  <para style="q2" vid="HOS 9:4">ಯೆಹೋವ ದೇವರ ಆಲಯಕ್ಕೆ ಸಲ್ಲುವುದಿಲ್ಲ.<verse eid="HOS 9:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="HOS 9:5"/>ಪರಿಶುದ್ಧ ದಿವಸದಲ್ಲಿಯೂ,</para>
  <para style="q2" vid="HOS 9:5">ಯೆಹೋವ ದೇವರ ಹಬ್ಬಗಳ ದಿವಸದಲ್ಲಿಯೂ ನೀನು ಏನು ಮಾಡುತ್ತೀ?<verse eid="HOS 9:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="HOS 9:6"/>ಇಗೋ, ನಾಶನದಿಂದ ಅವರು ತಪ್ಪಿಸಿಕೊಂಡರೂ</para>
  <para style="q2" vid="HOS 9:6">ಈಜಿಪ್ಟ್ ಅವರನ್ನು ಕೂಡಿಸುವುದು.</para>
  <para style="q2" vid="HOS 9:6">ಮೋಫ್ ಪಟ್ಟಣವು ಅವರನ್ನು ಹೂಳುವುದು.</para>
  <para style="q1" vid="HOS 9:6">ಅವರ ಬೆಳ್ಳಿಯ ಬೊಕ್ಕಸಗಳು ಮುಳ್ಳು ಪೊದೆಗಳ ಪಾಲಾಗುವುವು.</para>
  <para style="q2" vid="HOS 9:6">ಮುಳ್ಳುಗಿಡಗಳು ಅವರ ಗುಡಾರಗಳನ್ನು ಆವರಿಸಿಕೊಂಡಿರುವುದು.<verse eid="HOS 9:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="HOS 9:7"/>ದಂಡನೆಯ ದಿವಸಗಳು ಬಂದಿವೆ,</para>
  <para style="q2" vid="HOS 9:7">ಮುಯ್ಯಿ ತೀರಿಸುವ ದಿವಸಗಳೂ ಸಮೀಪವಾಗಿವೆ.</para>
  <para style="q2" vid="HOS 9:7">ಇಸ್ರಾಯೇಲು ಅದನ್ನು ತಿಳಿದುಕೊಳ್ಳಲಿ.</para>
  <para style="q1" vid="HOS 9:7">ಏಕೆಂದರೆ ನಿನ್ನ ಪಾಪಗಳು ಬಹಳವಾಗಿರುವುದರಿಂದಲೂ,</para>
  <para style="q2" vid="HOS 9:7">ದ್ವೇಷವು ಹೆಚ್ಚಾಗಿರುವುದರಿಂದಲೂ,</para>
  <para style="q1" vid="HOS 9:7">“ಪ್ರವಾದಿ ಮೂರ್ಖನೂ,</para>
  <para style="q2" vid="HOS 9:7">ಪ್ರೇರಿತ ಮನುಷ್ಯನು ಹುಚ್ಚನೂ,”</para>
  <para style="q2" vid="HOS 9:7">ಎಂದು ಇಸ್ರಾಯೇಲು ಹೇಳಿಕೊಳ್ಳುತ್ತದೆ.<verse eid="HOS 9:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="HOS 9:8"/>ನನ್ನ ದೇವರೊಂದಿಗೆ ಪ್ರವಾದಿಯು</para>
  <para style="q2" vid="HOS 9:8">ಎಫ್ರಾಯೀಮನ ಮೇಲೆ ಕಾವಲುಗಾರನಾಗಿದ್ದಾನೆ,</para>
  <para style="q1" vid="HOS 9:8">ಆದರೂ ಅವನ ಮಾರ್ಗಗಳಲ್ಲೆಲ್ಲ ಬೇಟೆಯ ಬಲೆ ಒಡ್ಡಲಾಗಿದೆ</para>
  <para style="q2" vid="HOS 9:8">ಮತ್ತು ಅವನ ದೇವರ ಮನೆಯಲ್ಲಿ ದ್ವೇಷವಿದೆ.<verse eid="HOS 9:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="HOS 9:9"/>ಗಿಬೆಯದ ದಿವಸಗಳಲ್ಲಿ ಆದ ಹಾಗೆ</para>
  <para style="q2" vid="HOS 9:9">ತಮ್ಮನ್ನು ಬಹಳವಾಗಿ ಕೆಡಿಸಿಕೊಂಡಿದ್ದಾರೆ.</para>
  <para style="q1" vid="HOS 9:9">ಆದ್ದರಿಂದ ಅವರ ಅಕ್ರಮವನ್ನು ಆತನು ಜ್ಞಾಪಕ ಮಾಡಿಕೊಳ್ಳುವನು.</para>
  <para style="q2" vid="HOS 9:9">ಅವರ ಪಾಪಕ್ಕೆ ತನ್ನ ದಂಡನೆಯನ್ನು ವಿಧಿಸುವನು.<verse eid="HOS 9:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="HOS 9:10"/>“ನಾನು ಮರುಭೂಮಿಯಲ್ಲಿ ದ್ರಾಕ್ಷಾಫಲದ ಹಾಗೆ</para>
  <para style="q2" vid="HOS 9:10">ಇಸ್ರಾಯೇಲನ್ನು ಕಂಡುಕೊಂಡೆನು.</para>
  <para style="q1" vid="HOS 9:10">ಅಂಜೂರದ ಗಿಡದಲ್ಲಿ ಮೊದಲು ಮಾಗಿದ ಹಣ್ಣನ್ನು ಕಂಡ ಹಾಗೆ</para>
  <para style="q2" vid="HOS 9:10">ನಿಮ್ಮ ಪಿತೃಗಳನ್ನು ನೋಡಿದೆನು.</para>
  <para style="q1" vid="HOS 9:10">ಆದರೆ ಅವರು ಬಾಳ್ ಪೆಯೋರನ ಹತ್ತಿರ ಬಂದು</para>
  <para style="q2" vid="HOS 9:10">ನಾಚಿಕೆಯ ವಿಗ್ರಹಕ್ಕೆ ತಮ್ಮನ್ನು ಪ್ರತ್ಯೇಕಿಸಿಕೊಂಡರು.</para>
  <para style="q2" vid="HOS 9:10">ಅವರು ಪ್ರೀತಿಸಿದ ವಿಗ್ರಹಗಳ ಹಾಗೆ ಅಸಹ್ಯರಾದರು.<verse eid="HOS 9:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="HOS 9:11"/>ಎಫ್ರಾಯೀಮ್ ಘನತೆಯು ಪಕ್ಷಿಯಂತೆ ಹಾರಿಹೋಗುವುದು.</para>
  <para style="q2" vid="HOS 9:11">ಜನನವಿಲ್ಲ, ಗರ್ಭಧಾರಣೆ ಇಲ್ಲ, ಪ್ರಸವವಿಲ್ಲ.<verse eid="HOS 9:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="HOS 9:12"/>ಅವರು ತಮ್ಮ ಮಕ್ಕಳನ್ನು ಬೆಳೆಸಿದ್ದರೂ,</para>
  <para style="q2" vid="HOS 9:12">ಅವರ ಮಕ್ಕಳಲ್ಲಿ ಯಾರೂ ಉಳಿಯದ ಹಾಗೆ</para>
  <para style="q1" vid="HOS 9:12">ನಾನು ಅವರನ್ನು ಮಕ್ಕಳಿಲ್ಲದವರನ್ನಾಗಿ ಮಾಡುವೆನು.</para>
  <para style="q2" vid="HOS 9:12">ನಾನು ಅವರನ್ನು ಬಿಟ್ಟು ಹೋಗುವಾಗ ಅವರಿಗೆ ಕಷ್ಟ!<verse eid="HOS 9:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="HOS 9:13"/>ಎಫ್ರಾಯೀಮ್ ಟೈರ್‌ನಂತಹ ಸುಂದರವಾದ ಸ್ಥಳದಲ್ಲಿ</para>
  <para style="q2" vid="HOS 9:13">ನೆಡುವುದನ್ನು ನಾನು ಕಂಡೆನು.</para>
  <para style="q2" vid="HOS 9:13">ಆದರೆ ಎಫ್ರಾಯೀಮ್ ತನ್ನ ಮಕ್ಕಳನ್ನು ಹತ್ಯಗೆ ಈಡಾಗುವಂತೆ ಕಳುಹಿಸುವುದು.”<verse eid="HOS 9:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="HOS 9:14"/>ಯೆಹೋವ ದೇವರೇ, ಅವರಿಗೆ ಕೊಡಿರಿ.</para>
  <para style="q2" vid="HOS 9:14">ಅವರಿಗೆ ನೀವು ಏನು ಕೊಡುತ್ತೀರಿ?</para>
  <para style="q1" vid="HOS 9:14">ಗರ್ಭ ಸ್ರಾವ, ಗರ್ಭವನ್ನು ಮತ್ತು</para>
  <para style="q2" vid="HOS 9:14">ಬತ್ತಿದ ಸ್ತನಗಳನ್ನು ಅವರಿಗೆ ಕೊಡಿರಿ.<verse eid="HOS 9:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="HOS 9:15"/>ಅವರ ದುಷ್ಟತನವೆಲ್ಲಾ ಗಿಲ್ಗಾಲಿನಲ್ಲಿದೆ.</para>
  <para style="q2" vid="HOS 9:15">ಅಲ್ಲಿ ಅವರನ್ನು ಹಗೆ ಮಾಡಿದ್ದೇನೆ.</para>
  <para style="q1" vid="HOS 9:15">ಅವರ ಪಾಪ ಕೃತ್ಯಗಳ ನಿಮಿತ್ತ ಅವರನ್ನು</para>
  <para style="q2" vid="HOS 9:15">ನನ್ನ ಆಲಯದೊಳಗಿಂದ ಹೊರಡಿಸಿ,</para>
  <para style="q1" vid="HOS 9:15">ಅವರನ್ನು ಇನ್ನು ಪ್ರೀತಿಸುವುದೇ ಇಲ್ಲ.</para>
  <para style="q2" vid="HOS 9:15">ಅವರ ಅಧಿಕಾರಿಗಳೆಲ್ಲಾ ತಿರುಗಿ ಬೀಳುವವರೇ.<verse eid="HOS 9:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="HOS 9:16"/>ಎಫ್ರಾಯೀಮು ಹೊಡೆತಕ್ಕೆ ಒಳಗಾಗಿದೆ.</para>
  <para style="q2" vid="HOS 9:16">ಅವರ ಬೇರು ಒಣಗಿಹೋಗಿದೆ,</para>
  <para style="q2" vid="HOS 9:16">ಅವರು ಫಲವನ್ನು ಕೊಡುವುದಿಲ್ಲ,</para>
  <para style="q1" vid="HOS 9:16">ಅವರು ಹೆತ್ತರೂ ಅವರ ಗರ್ಭದ ಪ್ರಿಯಕರವಾದ</para>
  <para style="q2" vid="HOS 9:16">ಫಲವನ್ನು ಸಹ ನಾನು ಕೊಲ್ಲುವೆನು.<verse eid="HOS 9:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="HOS 9:17"/>ನನ್ನ ದೇವರು ಅವರನ್ನು ತಳ್ಳಿಬಿಡುವರು.</para>
  <para style="q2" vid="HOS 9:17">ಏಕೆಂದರೆ ಅವರು ಆತನಿಗೆ ವಿಧೇಯರಾಗಲಿಲ್ಲ.</para>
  <para style="q2" vid="HOS 9:17">ಅವರು ಜನಾಂಗಗಳಲ್ಲಿ ಅಲೆದಾಡುವವರಾಗಿರುವರು.<verse eid="HOS 9:17"/></para>
  <para style="b"/>
  <chapter eid="HOS 9"/>
  <chapter number="10" style="c" sid="HOS 10"/>
  <para style="q1">
    <verse number="1" style="v" sid="HOS 10:1"/>ಇಸ್ರಾಯೇಲು ಹರಡುವ ದ್ರಾಕ್ಷಿಬಳ್ಳಿಯಾಗಿದೆ,</para>
  <para style="q2" vid="HOS 10:1">ಅವನು ತನಗಾಗಿ ಫಲಫಲಿಸುತ್ತಾನೆ.</para>
  <para style="q1" vid="HOS 10:1">ತನ್ನ ಬಹಳ ಫಲದ ಪ್ರಕಾರವಾಗಿ</para>
  <para style="q2" vid="HOS 10:1">ಅವನು ಬಲಿಪೀಠಗಳನ್ನೂ ಹೆಚ್ಚಿಸಿದ್ದಾನೆ.</para>
  <para style="q1" vid="HOS 10:1">ತನ್ನ ದೇಶದ ಅಭಿವೃದ್ಧಿಯ</para>
  <para style="q2" vid="HOS 10:1">ಪ್ರಕಾರ ಅಂದವಾದ ವಿಗ್ರಹಗಳನ್ನು ಮಾಡಿದ್ದಾನೆ.<verse eid="HOS 10:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="HOS 10:2"/>ಅವರ ಹೃದಯವು ವಂಚಕವಾದದ್ದು.</para>
  <para style="q2" vid="HOS 10:2">ಈಗ ಅವರು ಅಪರಾಧಗಳನ್ನು ಹೊರಬೇಕು.</para>
  <para style="q1" vid="HOS 10:2">ಯೆಹೋವ ದೇವರು ಅವರ ಬಲಿಪೀಠಗಳನ್ನು ಕೆಡವಿ,</para>
  <para style="q2" vid="HOS 10:2">ಅವರ ವಿಗ್ರಹಗಳನ್ನು ನಾಶಮಾಡುವರು.<verse eid="HOS 10:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="HOS 10:3"/>ಆಗ ಅವರು, “ನಮಗೆ ಅರಸನಿಲ್ಲ,</para>
  <para style="q2" vid="HOS 10:3">ಏಕೆಂದರೆ ನಾವು ಯೆಹೋವ ದೇವರಲ್ಲಿ ಭಯಭಕ್ತಿ ಇಟ್ಟವರಲ್ಲ.</para>
  <para style="q1" vid="HOS 10:3">ಅರಸನು ನಮಗಿದ್ದರೂ</para>
  <para style="q2" vid="HOS 10:3">ಏನು ಮಾಡುವನು?” ಎಂದುಕೊಳ್ಳುತ್ತಾರೆ.<verse eid="HOS 10:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="HOS 10:4"/>ಅವರು ಮಾತುಗಳನ್ನಾಡಿ</para>
  <para style="q2" vid="HOS 10:4">ಒಡಂಬಡಿಕೆಯನ್ನು ಮಾಡುವುದಕ್ಕೆ</para>
  <para style="q2" vid="HOS 10:4">ಸುಳ್ಳು ಪ್ರಮಾಣವನ್ನು ಮಾಡುತ್ತಾರೆ.</para>
  <para style="q1" vid="HOS 10:4">ಆದ್ದರಿಂದ ನ್ಯಾಯತೀರ್ಪು</para>
  <para style="q2" vid="HOS 10:4">ವಿಷದ ಕಳೆಯ ಹಾಗೆ ಹೊಲದ ಸಾಲುಗಳಲ್ಲಿ ಮೊಳೆಯುತ್ತದೆ.<verse eid="HOS 10:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="HOS 10:5"/>ಬೇತಾವೆನಿನ ಬಸವ ವಿಗ್ರಹಕ್ಕೆ</para>
  <para style="q2" vid="HOS 10:5">ಸಮಾರ್ಯದ ನಿವಾಸಿಗಳು ಭಯಪಡುವರು.</para>
  <para style="q1" vid="HOS 10:5">ಅದರಲ್ಲಿ ಆನಂದಿಸಿದ ಜನರು ಅದಕ್ಕೋಸ್ಕರ ಗೋಳಾಡುವರು.</para>
  <para style="q2" vid="HOS 10:5">ಅದರ ಯಾಜಕರು ನಡುಗುವರು.</para>
  <para style="q1" vid="HOS 10:5">ಏಕೆಂದರೆ ಅದರ ವೈಭವವು</para>
  <para style="q2" vid="HOS 10:5">ಅದರಿಂದ ಕುಂದಿಹೋಯಿತು.<verse eid="HOS 10:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="HOS 10:6"/>ಅದು ಸಹ, ಮಹಾರಾಜನಿಗೆ</para>
  <para style="q2" vid="HOS 10:6">ಕಾಣಿಕೆಯಾಗಿ ಅಸ್ಸೀರಿಯಕ್ಕೆ ಒಯ್ಯಲಾಗುವುದು.</para>
  <para style="q1" vid="HOS 10:6">ಎಫ್ರಾಯೀಮು ನಾಚಿಕೆಯನ್ನು ಹೊಂದುವುದು.</para>
  <para style="q2" vid="HOS 10:6">ಇಸ್ರಾಯೇಲ್ ಸಹ ತನ್ನ ಸಲಹೆಯ ಬಗ್ಗೆ ನಾಚಿಕೆಪಡುತ್ತದೆ.<verse eid="HOS 10:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="HOS 10:7"/>ಸಮಾರ್ಯ ಹಾಗು ಅದರ ಅರಸನು</para>
  <para style="q2" vid="HOS 10:7">ನೀರಿನ ಮೇಲಿನ ಕಡ್ಡಿಯ ಹಾಗೆ ಅಳಿದು ಹೋಗುವನು.<verse eid="HOS 10:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="HOS 10:8"/>ಇಸ್ರಾಯೇಲಿನ ಪಾಪಕ್ಕೆ</para>
  <para style="q2" vid="HOS 10:8">ಆಸ್ಪದವಾದ ಆವೆನಿನ ಉನ್ನತ ಪೂಜಾಸ್ಥಳಗಳು ಹಾಳಾಗಿ ಹೋಗುವುವು.</para>
  <para style="q1" vid="HOS 10:8">ಮುಳ್ಳುಗಿಡಗಳೂ, ಕಳೆಗಳೂ</para>
  <para style="q2" vid="HOS 10:8">ಬಲಿಪೀಠಗಳ ಮೇಲೆ ಬೆಳೆಯುವುವು.</para>
  <para style="q1" vid="HOS 10:8">ಜನರು ಬೆಟ್ಟಗಳಿಗೆ, “ನಮ್ಮ ಮೇಲೆ ಬೀಳಿರಿ!</para>
  <para style="q2" vid="HOS 10:8">ಗುಡ್ಡಗಳಿಗೆ, ನಮ್ಮನ್ನು ಮುಚ್ಚಿಕೊಳ್ಳಿರಿ!” ಎನ್ನುವರು.<verse eid="HOS 10:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="HOS 10:9"/>ಇಸ್ರಾಯೇಲೇ ನೀನು ಗಿಬೆಯದಲ್ಲಿದ್ದ ಕಾಲದಿಂದ</para>
  <para style="q2" vid="HOS 10:9">ನನ್ನ ವಿರುದ್ಧ ಪಾಪ ಮಾಡುತ್ತಲೇ ಬಂದಿರುವೆ.</para>
  <para style="q1" vid="HOS 10:9">ನಿನ್ನ ಜನರು ಪಾಪದಲ್ಲಿಯೇ ಮುಂದುವರಿಯುತ್ತಿದ್ದಾರೆ.</para>
  <para style="q2" vid="HOS 10:9">ಗಿಬೆಯದಲ್ಲಿ ಕೆಟ್ಟದ್ದನ್ನು ಮಾಡುವ ಜನರು ಯುದ್ಧಕ್ಕೆ ತುತ್ತಾಗಲಿದ್ದಾರೆ.<verse eid="HOS 10:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="HOS 10:10"/>ನಾನು ಅವರನ್ನು ಶಿಕ್ಷಿಸಲು ನನಗೆ ಮನಸ್ಸುಂಟು.</para>
  <para style="q2" vid="HOS 10:10">ಅವರ ಇಮ್ಮಡಿ ಅಪರಾಧಕ್ಕೆ ತಕ್ಕ ಶಾಸ್ತಿಯಾಗುವುದು,</para>
  <para style="q2" vid="HOS 10:10">ಆಗ ಇತರ ರಾಷ್ಟ್ರಗಳು ಅವರಿಗೆ ವಿರುದ್ಧವಾಗಿ ಒಂದುಗೂಡುವುವು.<verse eid="HOS 10:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="HOS 10:11"/>ಎಫ್ರಾಯೀಮು ಒಂದು ತರಬೇತಿ ಪಡೆದ ಕಡಸಾಗಿದೆ.</para>
  <para style="q2" vid="HOS 10:11">ಅದು ತುಳಿಯುವುದನ್ನು ಇಷ್ಟಪಡುತ್ತದೆ.</para>
  <para style="q1" vid="HOS 10:11">ಆದರೆ ನಾನು ಅದರ ಸುಂದರವಾದ</para>
  <para style="q2" vid="HOS 10:11">ಕುತ್ತಿಗೆಯ ಮೇಲೆ ನೊಗವನ್ನು ಹೊರುತ್ತೇನೆ.</para>
  <para style="q1" vid="HOS 10:11">ಎಫ್ರಾಯೀಮು ಸವಾರಿ ಮಾಡುವ ಹಾಗೆ ನಾನು ಮಾಡುವೆನು.</para>
  <para style="q2" vid="HOS 10:11">ಯೆಹೂದ ಉಳುವನು.</para>
  <para style="q2" vid="HOS 10:11">ಯಾಕೋಬನು ಅವನ ಹೆಂಟೆಗಳನ್ನು ಒಡೆಯುವನು.<verse eid="HOS 10:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="HOS 10:12"/>ನಿಮಗಾಗಿ ನೀತಿಯ ಬೀಜವನ್ನು ಬಿತ್ತಿರಿ.</para>
  <para style="q2" vid="HOS 10:12">ಪ್ರೀತಿಯ ಫಲವನ್ನು ಕೊಯ್ಯಿರಿ.</para>
  <para style="q1" vid="HOS 10:12">ಹಾಳಾಗಿ ಬೀಳುಬಿದ್ದ ನಿಮ್ಮ ಭೂಮಿಯನ್ನು ಅಗೆಯಿರಿ.</para>
  <para style="q2" vid="HOS 10:12">ಏಕೆಂದರೆ ಆತನು ಬಂದು</para>
  <para style="q1" vid="HOS 10:12">ನಿಮ್ಮ ಮೇಲೆ ನೀತಿಯನ್ನು ಸುರಿಸುವವರೆಗೂ</para>
  <para style="q2" vid="HOS 10:12">ಯೆಹೋವ ದೇವರನ್ನು ಹುಡುಕುವ ಸಮಯ ಇದೇ.<verse eid="HOS 10:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="HOS 10:13"/>ಆದರೆ ನೀವು ದುಷ್ಟತ್ವವನ್ನು ಬಿತ್ತಿ,</para>
  <para style="q2" vid="HOS 10:13">ಅನ್ಯಾಯವನ್ನು ಕೊಯ್ದಿರಿ,</para>
  <para style="q1" vid="HOS 10:13">ವಂಚನೆಯ ಫಲವನ್ನು ತಿಂದಿದ್ದೀರಿ.</para>
  <para style="q2" vid="HOS 10:13">ಏಕೆಂದರೆ ನೀವು ನಿಮ್ಮ ಸ್ವಂತ ಬಲದಲ್ಲಿ</para>
  <para style="q2" vid="HOS 10:13">ನಿಮ್ಮ ಶೂರರಲ್ಲಿಯೂ ಭರವಸೆಯಿಟ್ಟಿದ್ದೀರಿ.<verse eid="HOS 10:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="HOS 10:14"/>ಆದ್ದರಿಂದ ನಿನ್ನ ಜನರಲ್ಲಿ ಗಲಭೆ ಉಂಟಾಗುವುದು.</para>
  <para style="q2" vid="HOS 10:14">ಶಲ್ಮಾನ ರಾಜನು ಬೇತ್ ಅರ್ಬೇಲನ್ನು ಯುದ್ಧದ ದಿನದಲ್ಲಿ ನಾಶಮಾಡಿದ ಪ್ರಕಾರ,</para>
  <para style="q1" vid="HOS 10:14">ನಿನ್ನ ಕೋಟೆಗಳೆಲ್ಲಾ ನಾಶವಾಗುವವು.</para>
  <para style="q2" vid="HOS 10:14">ತಾಯಿ, ತನ್ನ ಮಕ್ಕಳ ಸಹಿತ ಬಂಡೆಗೆ ಅಪ್ಪಳಿಸಿದ<verse eid="HOS 10:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="HOS 10:15"/>ಹಾಗೆಯೇ, ಬಹಳ ದುಷ್ಟತ್ವದ ನಿಮಿತ್ತ</para>
  <para style="q2" vid="HOS 10:15">ಬೇತೇಲಿಗೆ ಸಂಭವಿಸುವುದು.</para>
  <para style="q1" vid="HOS 10:15">ಬೆಳಗಿನ ಜಾವದಲ್ಲಿ ಇಸ್ರಾಯೇಲಿನ</para>
  <para style="q2" vid="HOS 10:15">ಅರಸನು ಸಂಪೂರ್ಣವಾಗಿ ನಾಶವಾಗುವನು.<verse eid="HOS 10:15"/></para>
  <chapter eid="HOS 10"/>
  <chapter number="11" style="c" sid="HOS 11"/>
  <para style="s1">ಇಸ್ರಾಯೇಲರಿಗೆ ದೇವರ ಪ್ರೀತಿ</para>
  <para style="q1">
    <verse number="1" style="v" sid="HOS 11:1"/>“ಇಸ್ರಾಯೇಲನು ಹುಡುಗನಾಗಿದ್ದಾಗ, ನಾನು ಅವನನ್ನು ಪ್ರೀತಿ ಮಾಡಿದೆನು</para>
  <para style="q2" vid="HOS 11:1">ಮತ್ತು ಈಜಿಪ್ಟಿನಿಂದ ನನ್ನ ಮಗನನ್ನು ನಾನು ಕರೆದೆನು.<verse eid="HOS 11:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="HOS 11:2"/>ನಾನು ಇಸ್ರಾಯೇಲನ್ನು ಹೆಚ್ಚಾಗಿ ಕರೆದ ಹಾಗೆಯೇ,</para>
  <para style="q2" vid="HOS 11:2">ನನ್ನಿಂದ ಅವರು ದೂರ ಹೊರಟು ಹೋದರು.</para>
  <para style="q1" vid="HOS 11:2">ಅವರು ಬಾಳ್ ದೇವತೆಗಳಿಗೆ ಬಲಿ ಅರ್ಪಿಸಿದರು.</para>
  <para style="q2" vid="HOS 11:2">ಕೆತ್ತಿದ ವಿಗ್ರಹಗಳಿಗೆ ಧೂಪವನ್ನು ಸುಟ್ಟರು.<verse eid="HOS 11:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="HOS 11:3"/>ನಾನು ಎಫ್ರಾಯೀಮಿನ ತೋಳುಗಳನ್ನು</para>
  <para style="q2" vid="HOS 11:3">ಹಿಡಿದು ನಡೆಯುವುದನ್ನು ಕಲಿಸಿದೆನು.</para>
  <para style="q1" vid="HOS 11:3">ಆದರೆ ನಾನು ಅವರನ್ನು ಸ್ವಸ್ಥ ಮಾಡಿದ್ದೇನೆಂದು</para>
  <para style="q2" vid="HOS 11:3">ಅವರಿಗೆ ತಿಳಿಯಲಿಲ್ಲ.<verse eid="HOS 11:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="HOS 11:4"/>ನಾನು ಅವರನ್ನು ಮನುಷ್ಯನ ಹಗ್ಗಗಳಿಂದಲೂ,</para>
  <para style="q2" vid="HOS 11:4">ಪ್ರೀತಿಯ ಬಂಧನಗಳಿಂದಲೂ ಎಳೆದೆನು.</para>
  <para style="q1" vid="HOS 11:4">ಅವರಿಗೆ ನಾನು ಚಿಕ್ಕ ಮಗುವನ್ನು</para>
  <para style="q2" vid="HOS 11:4">ಕೆನ್ನೆಯವರೆಗೆ ಎತ್ತುವವರಂತೆ ಇದ್ದೆ,</para>
  <para style="q2" vid="HOS 11:4">ಮತ್ತು ನಾನು ಅವರಿಗೆ ಬಾಗಿ ತಿನ್ನಿಸುತ್ತಿದ್ದೆ.<verse eid="HOS 11:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="HOS 11:5"/>“ಅವರು ಮಾನಸಾಂತರಪಡಲು ನಿರಾಕರಿಸಿದ್ದರಿಂದ,</para>
  <para style="q2" vid="HOS 11:5">ಪುನಃ ಈಜಿಪ್ಟಿಗೆ ಹಿಂದಿರುಗುವರು,</para>
  <para style="q2" vid="HOS 11:5">ಅಸ್ಸೀರಿಯದ ಆಳ್ವಿಕೆಗೆ ಒಳಗಾಗುವರು.<verse eid="HOS 11:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="HOS 11:6"/>ಅವರ ಪಟ್ಟಣಗಳಲ್ಲಿ ಖಡ್ಗವು ಹೊಳೆಯುವುದು.</para>
  <para style="q2" vid="HOS 11:6">ಅದು ಅವರ ಸುಳ್ಳು ಪ್ರವಾದಿಗಳನ್ನು ನುಂಗಿಹಾಕುತ್ತದೆ.</para>
  <para style="q2" vid="HOS 11:6">ಮತ್ತು ಅವರ ಯೋಜನೆಗಳನ್ನು ಕೊನೆಗೊಳಿಸುತ್ತದೆ.<verse eid="HOS 11:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="HOS 11:7"/>ನನ್ನ ಜನರು ನನ್ನ ಕಡೆಯಿಂದ ಹಿಂಜಾರಬೇಕೆಂದು ತೀರ್ಮಾನಿಸಿದ್ದಾರೆ.</para>
  <para style="q2" vid="HOS 11:7">ಅವರು ನನ್ನನ್ನು ಸರ್ವೋನ್ನತ ದೇವರು ಎಂದು ಕರೆದರೂ</para>
  <para style="q2" vid="HOS 11:7">ನಾನು ಅವರನ್ನು ಯಾವುದೇ ರೀತಿಯಲ್ಲಿ ಉನ್ನತೀಕರಿಸುವುದಿಲ್ಲ.<verse eid="HOS 11:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="HOS 11:8"/>“ಎಫ್ರಾಯೀಮೇ, ನಿನ್ನನ್ನು ಹೇಗೆ ಬಿಟ್ಟುಬಿಡಲಿ?</para>
  <para style="q2" vid="HOS 11:8">ಇಸ್ರಾಯೇಲೇ, ನಿನ್ನನ್ನು ಹೇಗೆ ಕೈಬಿಡಲಿ?</para>
  <para style="q1" vid="HOS 11:8">ಅದ್ಮದ ಹಾಗೆ ನಿನ್ನನ್ನು ದುರ್ಗತಿಗೆ ಹೇಗೆ ಒಪ್ಪಿಸಲಿ?</para>
  <para style="q2" vid="HOS 11:8">ಚೆಬೋಯಿಮನಂತೆ ನಿನ್ನನ್ನು ಹೇಗೆ ನಾಶಮಾಡಲಿ?</para>
  <para style="q1" vid="HOS 11:8">ನನ್ನ ಹೃದಯವು ನನ್ನಲ್ಲಿ ಮಾರ್ಪಟ್ಟಿದೆ.</para>
  <para style="q2" vid="HOS 11:8">ನನ್ನಲ್ಲಿ ಕರುಣೆ ಉಕ್ಕಿ ಬಂದಿದೆ.<verse eid="HOS 11:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="HOS 11:9"/>ನನ್ನ ಕೋಪದ ಉರಿಯನ್ನು ನಾನು ತೀರಿಸುವುದಿಲ್ಲ.</para>
  <para style="q2" vid="HOS 11:9">ನಾನು ಎಫ್ರಾಯೀಮನ್ನು ತಿರುಗಿ ನಾಶಮಾಡುವುದಿಲ್ಲ.</para>
  <para style="q1" vid="HOS 11:9">ಏಕೆಂದರೆ ನಾನು ಮನುಷ್ಯನಲ್ಲ, ದೇವರೇ.</para>
  <para style="q2" vid="HOS 11:9">ನಿನ್ನ ಮಧ್ಯದಲ್ಲಿ ಪರಿಶುದ್ಧನಾಗಿದ್ದೇನೆ.</para>
  <para style="q2" vid="HOS 11:9">ನಾನು ಅವರ ಪಟ್ಟಣಗಳ ವಿರುದ್ಧ ಬರುವುದಿಲ್ಲ.<verse eid="HOS 11:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="HOS 11:10"/>ಅವರು ಯೆಹೋವ ದೇವರ ಹಿಂದೆ ಹೋಗುವರು.</para>
  <para style="q2" vid="HOS 11:10">ಅವರು ಸಿಂಹದ ಹಾಗೆ ಗರ್ಜಿಸುವರು.</para>
  <para style="q1" vid="HOS 11:10">ಅವರು ಗರ್ಜಿಸುವಾಗ</para>
  <para style="q2" vid="HOS 11:10">ಪಶ್ಚಿಮದಿಂದ ಮಕ್ಕಳು ನಡುಗುತ್ತಾ ಬರುವರು.<verse eid="HOS 11:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="HOS 11:11"/>ಈಜಿಪ್ಟಿನಿಂದ ಪಕ್ಷಿಯಗಳಂತೆಯೂ</para>
  <para style="q2" vid="HOS 11:11">ಅಸ್ಸೀರಿಯದಿಂದ ಪಾರಿವಾಳಗಳಂತೆಯೂ ಅವರು ಬರುವರು.</para>
  <para style="q1" vid="HOS 11:11">ನಾನು ಅವರ ಮನೆಗಳಲ್ಲಿ ಇರುವೆನು,”</para>
  <para style="q2" vid="HOS 11:11">ಎಂದು ಯೆಹೋವ ದೇವರು ಹೇಳುತ್ತಾರೆ.<verse eid="HOS 11:11"/></para>
  <para style="s1">ಇಸ್ರಾಯೇಲಿನ ಪಾಪ</para>
  <para style="q1">
    <verse number="12" style="v" sid="HOS 11:12"/>ಎಫ್ರಾಯೀಮು ಸುಳ್ಳಿನಿಂದ ಮತ್ತು ಇಸ್ರಾಯೇಲಿನ</para>
  <para style="q2" vid="HOS 11:12">ಮನೆಯವರು ಮೋಸದಿಂದ ನನ್ನನ್ನು ಸುತ್ತಿಕೊಂಡಿದ್ದಾರೆ.</para>
  <para style="q1" vid="HOS 11:12">ಯೆಹೂದ ಕೂಡ ಪರಿಶುದ್ಧರೂ ನಂಬಿಗಸ್ತರೂ</para>
  <para style="q2" vid="HOS 11:12">ಆದ ದೇವರ ವಿರುದ್ಧ ಅಶಿಸ್ತಿನಿಂದ ಇದೆ.<verse eid="HOS 11:12"/></para>
  <chapter eid="HOS 11"/>
  <chapter number="12" style="c" sid="HOS 12"/>
  <para style="q1">
    <verse number="1" style="v" sid="HOS 12:1"/>ಎಫ್ರಾಯೀಮು ಗಾಳಿಯನ್ನು ತಿನ್ನುತ್ತದೆ.</para>
  <para style="q2" vid="HOS 12:1">ಪೂರ್ವದ ಗಾಳಿಯ ಹಿಂದೆ ಹಿಂಬಾಲಿಸಿಕೊಂಡು ಹೋಗುತ್ತದೆ.</para>
  <para style="q1" vid="HOS 12:1">ಅವನು ದಿನವೆಲ್ಲಾ ಸುಳ್ಳನ್ನೂ, ಹಿಂಸೆಯನ್ನೂ ಹೆಚ್ಚಿಸಿ,</para>
  <para style="q2" vid="HOS 12:1">ಅಸ್ಸೀರಿಯರೊಂದಿಗೆ ಒಡಂಬಡಿಕೆ ಮಾಡಿಕೊಂಡು,</para>
  <para style="q1" vid="HOS 12:1">ಈಜಿಪ್ಟಿಗೆ ಎಣ್ಣೆಯನ್ನು ಕಾಣಿಕೆಯಾಗಿ ಹೊತ್ತುಕೊಂಡು ಹೋಗುತ್ತಾನೆ.<verse eid="HOS 12:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="HOS 12:2"/>ಯೆಹೂದರೊಂದಿಗೆ ಯೆಹೋವ ದೇವರು ಆಪಾದನೆ ಮಾಡಿ,</para>
  <para style="q2" vid="HOS 12:2">ಯಾಕೋಬನನ್ನು ತನ್ನ ಮಾರ್ಗಗಳ ಪ್ರಕಾರ ಶಿಕ್ಷಿಸಿ,</para>
  <para style="q2" vid="HOS 12:2">ಅವನ ಕ್ರಿಯೆಗಳ ಪ್ರಕಾರ ಮುಯ್ಯಿ ತೀರಿಸಿ, ಅವನಿಗೆ ಪ್ರತಿಫಲವನ್ನು ಕೊಡುವರು.<verse eid="HOS 12:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="HOS 12:3"/>ಗರ್ಭದಲ್ಲಿ ಅವನು ತನ್ನ ಸಹೋದರನನ್ನು ಹಿಮ್ಮಡಿಯಿಂದ ಹಿಡಿದು,</para>
  <para style="q2" vid="HOS 12:3">ಮನುಷ್ಯನಾಗಿಯೇ ದೇವರೊಂದಿಗೆ ಹೋರಾಡಿದನು.<verse eid="HOS 12:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="HOS 12:4"/>ಯಾಕೋಬನು ದೇವದೂತನ ಸಂಗಡ ಹೋರಾಡಿ ಜಯಿಸಿದನು.</para>
  <para style="q2" vid="HOS 12:4">ಅವನು ಅತ್ತು ಆತನ ಅನುಗ್ರಹಕ್ಕಾಗಿ ವಿಜ್ಞಾಪನೆಯನ್ನು ಸಲ್ಲಿಸಿದನು.</para>
  <para style="q1" vid="HOS 12:4">ಅವನು ಆತನನ್ನು ಬೇತೇಲಿನಲ್ಲಿ ಕಂಡುಕೊಂಡನು.</para>
  <para style="q2" vid="HOS 12:4">ಅಲ್ಲಿ ಅವನು ಆತನೊಂದಿಗೆ ಮಾತನಾಡಿದನು.<verse eid="HOS 12:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="HOS 12:5"/>ಅವರೇ ಸರ್ವಶಕ್ತರಾದ ಯೆಹೋವ ದೇವರು;</para>
  <para style="q2" vid="HOS 12:5">ಅವರ ಪ್ರಸಿದ್ಧ ಹೆಸರು ಯೆಹೋವ ದೇವರು ಎಂಬುದೇ.<verse eid="HOS 12:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="HOS 12:6"/>ಆದರೆ ನೀನು ನಿನ್ನ ದೇವರ ಕಡೆಗೆ ತಿರುಗಿಕೋ.</para>
  <para style="q2" vid="HOS 12:6">ಪ್ರೀತಿಯನ್ನೂ, ನ್ಯಾಯವನ್ನೂ ಪಾಲಿಸು</para>
  <para style="q2" vid="HOS 12:6">ಮತ್ತು ನಿನ್ನ ದೇವರಿಗಾಗಿ ಯಾವಾಗಲೂ ಕಾದುಕೊಂಡಿರು.<verse eid="HOS 12:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="HOS 12:7"/>ಅವನು ವ್ಯಾಪಾರಿಯಾಗಿದ್ದು, ಅವನ ಕೈಯಲ್ಲಿ ಮೋಸದ ತಕ್ಕಡಿ ಇದೆ.</para>
  <para style="q2" vid="HOS 12:7">ಇತರರಿಂದ ಕಸಿದುಕೊಳ್ಳಬೇಕೆಂಬುದೇ ಅವನ ದುರಾಶೆ.<verse eid="HOS 12:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="HOS 12:8"/>ಎಫ್ರಾಯೀಮು ಹೆಚ್ಚಳ ಪಡುತ್ತಾ ಹೀಗೆಂದು ಹೇಳುತ್ತದೆ,</para>
  <para style="q2" vid="HOS 12:8">“ನಾನು ಐಶ್ವರ್ಯವಂತನಾದೆನು, ನಾನು ಆಸ್ತಿಯನ್ನು ಕಂಡುಕೊಂಡೆನು.</para>
  <para style="q1" vid="HOS 12:8">ನನ್ನ ಐಶ್ವರ್ಯದಿಂದಾಗಿ ಅವರು ನನ್ನಲ್ಲಿ</para>
  <para style="q2" vid="HOS 12:8">ಯಾವ ಅಪರಾಧ ಅಥವಾ ಪಾಪವನ್ನು ಕಾಣುವುದಿಲ್ಲ.”<verse eid="HOS 12:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="HOS 12:9"/>ಆದರೆ ಈಜಿಪ್ಟಿನಿಂದ ನಿನ್ನನ್ನು ಬಿಡಿಸಿಕೊಂಡು ಬಂದಾಗಿನಿಂದಲೂ,</para>
  <para style="q2" vid="HOS 12:9">ನಿನ್ನ ದೇವರಾಗಿರುವ ಯೆಹೋವ ದೇವರಾದ ನಾನು,</para>
  <para style="q1" vid="HOS 12:9">ಜಾತ್ರೆಯ ದಿನಗಳಲ್ಲಿ ನೀವು ವನವಾಸ ಮಾಡಿದಂತೆ,</para>
  <para style="q2" vid="HOS 12:9">ನಿಮ್ಮನ್ನು ಪುನಃ ಗುಡಾರದ ವಾಸಕ್ಕೆ ಗುರಿಪಡಿಸುವೆನು.<verse eid="HOS 12:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="HOS 12:10"/>ನಾನು ಪ್ರವಾದಿಗಳೊಂದಿಗೆ ಮಾತನಾಡಿದ್ದೇನೆ.</para>
  <para style="q2" vid="HOS 12:10">ಅವರಿಗೆ ಹಲವಾರು ದರ್ಶನಗಳನ್ನು ದಯಪಾಲಿಸಿದ್ದೇನೆ.</para>
  <para style="q2" vid="HOS 12:10">ಅವರ ಮುಖಾಂತರ ಸಾಮ್ಯಗಳನ್ನು ಜನರಿಗೆ ಹೇಳಿದ್ದೇನೆ.<verse eid="HOS 12:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="HOS 12:11"/>ಗಿಲ್ಯಾದಿನಲ್ಲಿ ದುಷ್ಟತನ ಇದೆಯೋ?</para>
  <para style="q2" vid="HOS 12:11">ಅಲ್ಲಿನ ಜನರು ಅಯೋಗ್ಯರೇ?</para>
  <para style="q1" vid="HOS 12:11">ಅವರು ಗಿಲ್ಗಾಲಿನಲ್ಲಿ ಹೋರಿಗಳನ್ನು ಅರ್ಪಿಸುತ್ತಾರೆಯೇ?</para>
  <para style="q2" vid="HOS 12:11">ಅವರ ಬಲಿಪೀಠಗಳು ಹೊಲದ ಸಾಲುಗಳಲ್ಲಿರುವ</para>
  <para style="q2" vid="HOS 12:11">ಕಲ್ಲು ಕುಪ್ಪೆಯ ಹಾಗಿವೆ, ಎಂದು ಹೇಳಿದನು.<verse eid="HOS 12:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="HOS 12:12"/>ಯಾಕೋಬನು ಸಿರಿಯಾ ದೇಶಕ್ಕೆ ಓಡಿಹೋದನು.</para>
  <para style="q2" vid="HOS 12:12">ಇಸ್ರಾಯೇಲನು ಹೆಂಡತಿಯ ನಿಮಿತ್ತ ಸೇವೆಮಾಡಿ,</para>
  <para style="q2" vid="HOS 12:12">ಹೆಂಡತಿಯ ನಿಮಿತ್ತ ಕುರಿಗಳನ್ನು ಕಾದನು.<verse eid="HOS 12:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="HOS 12:13"/>ಪ್ರವಾದಿಯಿಂದ ಯೆಹೋವ ದೇವರು ಇಸ್ರಾಯೇಲರನ್ನು ಈಜಿಪ್ಟಿನೊಳಗಿಂದ ಬರಮಾಡಿ,</para>
  <para style="q2" vid="HOS 12:13">ಆ ಪ್ರವಾದಿಯಿಂದಲೇ ಆತನು ಅವರನ್ನು ಕಾಪಾಡಿದರು.<verse eid="HOS 12:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="HOS 12:14"/>ಆದರೂ ಎಫ್ರಾಯೀಮು ಬಹು ಕಠೋರವಾಗಿ ಆತನನ್ನು ರೇಗಿಸಿತು.</para>
  <para style="q2" vid="HOS 12:14">ಆದ್ದರಿಂದ ಯೆಹೋವ ದೇವರು ಅದರ ರಕ್ತಾಪರಾಧವನ್ನು ಅದರ ಮೇಲೆ ಬರಮಾಡುವರು.</para>
  <para style="q2" vid="HOS 12:14">ಅವನ ನಿಂದೆಯನ್ನು ಯೆಹೋವ ದೇವರು ಅವನ ಮೇಲೆ ಬರಮಾಡುವರು.<verse eid="HOS 12:14"/></para>
  <chapter eid="HOS 12"/>
  <chapter number="13" style="c" sid="HOS 13"/>
  <para style="s1">ಇಸ್ರಾಯೇಲಿನ ಮೇಲೆ ಯೆಹೋವ ದೇವರ ರೌದ್ರ</para>
  <para style="q1">
    <verse number="1" style="v" sid="HOS 13:1"/>“ಪೂರ್ವದಲ್ಲಿ ಎಫ್ರಾಯೀಮು ಮಾತನಾಡುವಾಗ,</para>
  <para style="q2" vid="HOS 13:1">ಅವನು ತನ್ನನ್ನು ಇಸ್ರಾಯೇಲಿನಲ್ಲಿ ಹೆಚ್ಚಿಸಿಕೊಂಡನು.</para>
  <para style="q2" vid="HOS 13:1">ಆದರೆ ಬಾಳನ ಆರಾಧನೆಯಲ್ಲಿ ಅವನು ಅಪರಾಧಿಯಾಗಿ ಸತ್ತನು.<verse eid="HOS 13:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="HOS 13:2"/>ಈಗ ಅವರು ಹೆಚ್ಚೆಚ್ಚಾಗಿ ಪಾಪವನ್ನು ಮಾಡುತ್ತಾರೆ.</para>
  <para style="q2" vid="HOS 13:2">ಸ್ವಂತ ಬುದ್ಧಿಯ ಪ್ರಕಾರ ತಮ್ಮ ಬೆಳ್ಳಿಯಿಂದ ಎರಕದ ವಿಗ್ರಹಗಳನ್ನೂ,</para>
  <para style="q1" vid="HOS 13:2">ಮೂರ್ತಿಗಳನ್ನೂ ಮಾಡಿಕೊಂಡಿದ್ದಾರೆ.</para>
  <para style="q2" vid="HOS 13:2">ಅದೆಲ್ಲವೂ ಕಮ್ಮಾರರ ಕೈಕೆಲಸವೇ.</para>
  <para style="q1" vid="HOS 13:2">ಅವರು ನರಬಲಿಯನ್ನು ಅರ್ಪಿಸುತ್ತಾರೆ,</para>
  <para style="q2" vid="HOS 13:2">ಬಸವನ ವಿಗ್ರಹಕ್ಕೆ ಮುದ್ದಿಡುತ್ತಾರೆ,”</para>
  <para style="q2" vid="HOS 13:2">ಎಂದು ಜನರು ಅವರ ಬಗ್ಗೆ ಹೇಳುತ್ತಾರೆ.<verse eid="HOS 13:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="HOS 13:3"/>ಆದ್ದರಿಂದ ಅವರು ಪ್ರಾತಃಕಾಲದ ಮಂಜಿನ ಹಾಗೆಯೂ,</para>
  <para style="q2" vid="HOS 13:3">ಬೇಗನೆ ಮಾಯವಾಗುವ ಇಬ್ಬನಿಯ ಹಾಗೆಯೂ,</para>
  <para style="q2" vid="HOS 13:3">ಸುಳಿಗಾಳಿಯು ಕಣದಿಂದ ಬಡಿದುಕೊಂಡು ಹೋಗುವ ಹೊಟ್ಟಿನ ಹಾಗೆಯೂ,</para>
  <para style="q2" vid="HOS 13:3">ಚಿಮಿಣಿಯಿಂದ ಹೊರಡುವ ಹೊಗೆಯ ಹಾಗೆಯೂ ಇರುವರು.<verse eid="HOS 13:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="HOS 13:4"/>ಆದರೂ ನಾನು ಈಜಿಪ್ಟಿನಿಂದ ನಿನ್ನನ್ನು ಬಿಡಿಸಿಕೊಂಡು ಬಂದಾಗಿನಿಂದ,</para>
  <para style="q2" vid="HOS 13:4">ನಾನೇ ನಿನ್ನ ದೇವರಾಗಿರುವ ಯೆಹೋವನಾಗಿದ್ದೇನೆ.</para>
  <para style="q1" vid="HOS 13:4">ನೀನು ನನ್ನ ಹೊರತು ಯಾವ ದೇವರನ್ನೂ ತಿಳಿದುಕೊಳ್ಳಬಾರದು.</para>
  <para style="q2" vid="HOS 13:4">ಏಕೆಂದರೆ ನನ್ನ ಹೊರತು ನಿನಗೆ ಬೇರೆ ರಕ್ಷಕನು ಇಲ್ಲ.<verse eid="HOS 13:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="HOS 13:5"/>ನಾನು ನಿನ್ನನ್ನು ಮರುಭೂಮಿಯಲ್ಲಿಯೂ,</para>
  <para style="q2" vid="HOS 13:5">ಬಹು ಬಾಯಾರಿಕೆಯ ದೇಶದಲ್ಲಿಯೂ ತಿಳಿದುಕೊಂಡಿದ್ದೇನೆ.<verse eid="HOS 13:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="HOS 13:6"/>ನಾನು ಅವರಿಗೆ ಆಹಾರ ಕೊಟ್ಟೆನು, ಅವರು ತೃಪ್ತರಾದರು.</para>
  <para style="q2" vid="HOS 13:6">ಅವರು ತೃಪ್ತರಾದಾಗ, ಅಹಂಕಾರಿಗಳಾದರು,</para>
  <para style="q2" vid="HOS 13:6">ಅನಂತರ ಅವರು ನನ್ನನ್ನು ಮರೆತುಬಿಟ್ಟರು.<verse eid="HOS 13:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="HOS 13:7"/>ಆದ್ದರಿಂದ ನಾನು ಅವರಿಗೆ ಸಿಂಹದ ಹಾಗೆ ಆಗುವೆನು.</para>
  <para style="q2" vid="HOS 13:7">ಮಾರ್ಗದಲ್ಲಿ ಚಿರತೆಯ ಹಾಗೆ ಅವರಿಗಾಗಿ ಹೊಂಚುಹಾಕುವೆನು.<verse eid="HOS 13:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="HOS 13:8"/>ನಾನು ಮರಿಯನ್ನು ಕಳೆದುಕೊಂಡ ಕರಡಿಯಂತೆ ಅವರನ್ನು ಎದುರುಗೊಳ್ಳುವೆನು.</para>
  <para style="q2" vid="HOS 13:8">ಅವರ ಹೃದಯದ ಪೊರೆಯನ್ನು ಹರಿದುಬಿಡುವೆನು.</para>
  <para style="q1" vid="HOS 13:8">ನಾನು ಸಿಂಹದ ಹಾಗೆ ಅವರನ್ನು ನುಂಗುವೆನು.</para>
  <para style="q2" vid="HOS 13:8">ಕಾಡುಮೃಗವು ಅವರನ್ನು ಸೀಳಿ ಹಾಕುವುದು.<verse eid="HOS 13:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="HOS 13:9"/>“ಇಸ್ರಾಯೇಲೇ, ನೀನು ನಿನ್ನ ಬೆಂಬಲವಾದ ನನಗೆ</para>
  <para style="q2" vid="HOS 13:9">ತಿರುಗಿಬಿದ್ದದರಿಂದ ನಾಶವಾಗಿದ್ದೀ.<verse eid="HOS 13:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="HOS 13:10"/>ಈಗ ನಿನ್ನ ಅರಸನು ಎಲ್ಲಿ?</para>
  <para style="q2" vid="HOS 13:10">ನಿನ್ನ ಪಟ್ಟಣಗಳೆಲ್ಲಾ ನಿನ್ನವರನ್ನು ಉದ್ಧರಿಸುವನೋ?</para>
  <para style="q1" vid="HOS 13:10">ನನಗೆ ರಾಜ್ಯವನ್ನೂ ರಾಜ್ಯಾಧಿಕಾರಿಗಳನ್ನೂ ದಯಪಾಲಿಸು</para>
  <para style="q2" vid="HOS 13:10">ಎಂದು ನನ್ನನ್ನು ಕೇಳಿಕೊಂಡಿಯಷ್ಟೆ.</para>
  <para style="q2" vid="HOS 13:10">ಆ ನ್ಯಾಯಾಧಿಪತಿಗಳು ಎಲ್ಲಿ?<verse eid="HOS 13:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="HOS 13:11"/>ನನ್ನ ಕೋಪದಲ್ಲಿ ನಿನಗೆ ಅರಸನನ್ನು ಕೊಟ್ಟೆನು</para>
  <para style="q2" vid="HOS 13:11">ಮತ್ತು ನನ್ನ ರೌದ್ರದಲ್ಲಿ ಅವನನ್ನು ತೆಗೆದುಹಾಕಿದೆನು.<verse eid="HOS 13:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="HOS 13:12"/>ಎಫ್ರಾಯೀಮಿನ ದುಷ್ಕೃತ್ಯವು ಸಂಗ್ರಹವಾಗಿದೆ.</para>
  <para style="q2" vid="HOS 13:12">ಅವನ ಪಾಪವು ದಾಖಲೆಯಾಗಿದೆ.<verse eid="HOS 13:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="HOS 13:13"/>ಎಫ್ರಾಯೀಮಿಗೆ ಪ್ರಸವವೇದನೆ ಬಂದಿದೆ.</para>
  <para style="q2" vid="HOS 13:13">ಅಷ್ಟೇ ಅಲ್ಲ.</para>
  <para style="q1" vid="HOS 13:13">ಅದೊಂದು ಮಂಕು ಮಗುವಿನಂತಿದೆ.</para>
  <para style="q2" vid="HOS 13:13">ಹುಟ್ಟಿ, ಹೊರಗೆ ಬರಬಹುದಾದರೂ,</para>
  <para style="q2" vid="HOS 13:13">ಅವನು ಬಾರದೆ ಇದ್ದಾನೆ.<verse eid="HOS 13:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="HOS 13:14"/>“ಸಮಾಧಿಯ ಶಕ್ತಿಯಿಂದ ಅವರನ್ನು ಕ್ರಯಕೊಟ್ಟು ವಿಮೋಚಿಸುವೆನು.</para>
  <para style="q2" vid="HOS 13:14">ಮರಣದಿಂದ ಅವರನ್ನು ಬಿಡಿಸುವೆನು.</para>
  <para style="q1" vid="HOS 13:14">ಮರಣವೇ ನಿನ್ನ ಉಪದ್ರವ ಎಲ್ಲಿ?</para>
  <para style="q2" vid="HOS 13:14">ಪಾತಾಳವೇ ನಿನ್ನ ವಿನಾಶವೆಲ್ಲಿ?</para>
  <para style="b" vid="HOS 13:14"/>
  <para style="q1" vid="HOS 13:14">“ಅನುಕಂಪವು ನನ್ನಿಂದ ದೂರವಾಗಿದೆ.<verse eid="HOS 13:14"/></para>
  <para style="q2">
    <verse number="15" style="v" sid="HOS 13:15"/>ಎಫ್ರಾಯೀಮು ತನ್ನ ಸಹೋದರರಲ್ಲಿ ಫಲ ಸಮೃದ್ಧವಾಗಿದ್ದರೂ,</para>
  <para style="q1" vid="HOS 13:15">ಕಾಡಿನಿಂದ ಯೆಹೋವ ದೇವರು ಬೀಸಮಾಡುವ</para>
  <para style="q2" vid="HOS 13:15">ಪೂರ್ವ ಗಾಳಿಯು ಬರಲು,</para>
  <para style="q1" vid="HOS 13:15">ಅವನ ಬುಗ್ಗೆಯು ಬತ್ತುವುದು.</para>
  <para style="q2" vid="HOS 13:15">ಅವನ ಒರತೆಯು ಒಣಗುವುದು.</para>
  <para style="q1" vid="HOS 13:15">ಅವನ ಬೊಕ್ಕಸಗಳ ನಿಧಿಯನ್ನು</para>
  <para style="q2" vid="HOS 13:15">ಶತ್ರುಗಳು ಸೂರೆಮಾಡುವರು.<verse eid="HOS 13:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="HOS 13:16"/>ಸಮಾರ್ಯವು ತನ್ನ ದೇವರಿಗೆ ತಿರುಗಿಬಿದ್ದದರಿಂದ,</para>
  <para style="q2" vid="HOS 13:16">ತನ್ನ ದೋಷಫಲವನ್ನು ಅನುಭವಿಸಲೇಬೇಕು.</para>
  <para style="q1" vid="HOS 13:16">ಅದರ ಜನರು ಖಡ್ಗದಿಂದ ಹತರಾಗುವರು,</para>
  <para style="q2" vid="HOS 13:16">ವೈರಿಗಳು ಅವಳ ಮಕ್ಕಳನ್ನು ಬಂಡೆಗೆ ಅಪ್ಪಳಿಸುವರು.</para>
  <para style="q2" vid="HOS 13:16">ಗರ್ಭಿಣಿಯರ ಹೊಟ್ಟೆಯನ್ನು ಸೀಳುವರು.”<verse eid="HOS 13:16"/></para>
  <chapter eid="HOS 13"/>
  <chapter number="14" style="c" sid="HOS 14"/>
  <para style="s1">ಆಶೀರ್ವಾದಕ್ಕಾಗಿ ಪಶ್ಚಾತ್ತಾಪ ಪಡುತ್ತಾರೆ</para>
  <para style="q1">
    <verse number="1" style="v" sid="HOS 14:1"/>ಇಸ್ರಾಯೇಲೇ, ನಿನ್ನ ದೇವರಾದ ಯೆಹೋವ ದೇವರ ಕಡೆಗೆ ತಿರುಗಿಕೋ.</para>
  <para style="q2" vid="HOS 14:1">ಏಕೆಂದರೆ ನಿನ್ನ ಪಾಪಗಳೇ, ನಿನ್ನ ಬೀಳುವಿಕೆಗೆ ಕಾರಣ.<verse eid="HOS 14:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="HOS 14:2"/>ಮಾತುಗಳನ್ನು ನಿಮ್ಮ ಸಂಗಡ ತೆಗೆದುಕೊಂಡು,</para>
  <para style="q2" vid="HOS 14:2">ಯೆಹೋವ ದೇವರ ಕಡೆಗೆ ತಿರುಗಿಕೊಂಡು,</para>
  <para style="q1" vid="HOS 14:2">ಅವರಿಗೆ ಹೇಳಿರಿ:</para>
  <para style="q2" vid="HOS 14:2">“ನಮ್ಮ ಪಾಪಗಳನ್ನೆಲ್ಲಾ ಕ್ಷಮಿಸಿ,</para>
  <para style="q1" vid="HOS 14:2">ನಮ್ಮಲ್ಲಿ ಒಳ್ಳೆಯದನ್ನು ಸ್ವೀಕರಿಸಿರಿ.</para>
  <para style="q2" vid="HOS 14:2">ಆಗ ನಮ್ಮ ಸ್ತೋತ್ರ ಬಲಿಯನ್ನು ನಿಮಗೆ ಅರ್ಪಿಸುವೆವು.<verse eid="HOS 14:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="HOS 14:3"/>ಅಸ್ಸೀರಿಯ ನಮ್ಮನ್ನು ರಕ್ಷಿಸುವುದಿಲ್ಲ.</para>
  <para style="q2" vid="HOS 14:3">ನಾವು ಕುದುರೆಗಳ ಮೇಲೆ ಸವಾರಿ ಮಾಡುವುದಿಲ್ಲ.</para>
  <para style="q1" vid="HOS 14:3">ನಮ್ಮ ಕೈಗಳಿಂದ ಉಂಟು ಮಾಡಿದವುಗಳಿಗೆ,</para>
  <para style="q2" vid="HOS 14:3">‘ನೀವು ನಮ್ಮ ದೇವರುಗಳೇ,’ ಎಂದು ನಾವು ಇನ್ನು ಮುಂದೆ ಹೇಳುವುದೇ ಇಲ್ಲ.</para>
  <para style="q2" vid="HOS 14:3">ಏಕೆಂದರೆ ನಿಮ್ಮಲ್ಲಿ ದಿಕ್ಕಿಲ್ಲದವರಿಗೆ ಅನುಕಂಪ ದೊರೆಯುತ್ತದೆ.”<verse eid="HOS 14:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="HOS 14:4"/>“ನಾನು ಅವರ ಹಿಂಜಾರುವಿಕೆಯನ್ನು ಸ್ವಸ್ಥ ಮಾಡುವೆನು.</para>
  <para style="q2" vid="HOS 14:4">ನಾನು ಅವರನ್ನು ಮನಃಪೂರ್ವಕವಾಗಿ ಪ್ರೀತಿಸುವೆನು.</para>
  <para style="q2" vid="HOS 14:4">ಏಕೆಂದರೆ ನನ್ನ ಕೋಪವು ಅವರ ಕಡೆಯಿಂದ ತಿರುಗಿಕೊಂಡಿದೆ.<verse eid="HOS 14:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="HOS 14:5"/>ಇಸ್ರಾಯೇಲಿಗೆ ನಾನು ಮಂಜಿನ ಹಾಗೆ ಇರುವೆನು.</para>
  <para style="q2" vid="HOS 14:5">ಅವನು ತಾವರೆಯ ಹಾಗೆ ಬೆಳೆಯುವನು.</para>
  <para style="q1" vid="HOS 14:5">ತನ್ನ ಬೇರುಗಳನ್ನು ಲೆಬನೋನಿನ</para>
  <para style="q2" vid="HOS 14:5">ಹಾಗೆ ಆಳಕ್ಕೆ ಹರಡುವನು.<verse eid="HOS 14:5"/></para>
  <para style="q2">
    <verse number="6" style="v" sid="HOS 14:6"/>ಅವನ ಕೊಂಬೆಗಳು ಹರಡಿಕೊಂಡು,</para>
  <para style="q1" vid="HOS 14:6">ಅವನ ಸೌಂದರ್ಯವು ಎಣ್ಣೆಮರಗಳ ಹಾಗೆಯೂ</para>
  <para style="q2" vid="HOS 14:6">ಅವನ ಪರಿಮಳವು ಲೆಬನೋನಿನ ದೇವದಾರಿನ ಹಾಗೆಯೂ ಇರುವುದು.<verse eid="HOS 14:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="HOS 14:7"/>ಆತನ ನೆರಳಿನಲ್ಲಿ ಜನರು ವಾಸಿಸುವರು,</para>
  <para style="q2" vid="HOS 14:7">ಧಾನ್ಯದ ಹಾಗೆ ಜೀವಿಸುವರು,</para>
  <para style="q1" vid="HOS 14:7">ದ್ರಾಕ್ಷಿಬಳ್ಳಿಯ ಹಾಗೆ ಫಲಪ್ರದವಾಗುವರು.</para>
  <para style="q2" vid="HOS 14:7">ಇಸ್ರಾಯೇಲಿನ ಕೀರ್ತಿಯು ಲೆಬನೋನಿನ ದ್ರಾಕ್ಷಾರಸದ ಹಾಗೆ ಇರುವುದು.<verse eid="HOS 14:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="HOS 14:8"/>ಎಫ್ರಾಯೀಮೇ, ವಿಗ್ರಹಗಳೊಂದಿಗೆ ಇನ್ನು ಏನು ಮಾಡಬೇಕಾಗಿದೆ?</para>
  <para style="q2" vid="HOS 14:8">ನಾನು ಅವನಿಗೆ ಉತ್ತರಿಸಿದ್ದೇನೆ. ನಾನು ಅವನ ಬಗ್ಗೆ ಕಾಳಜಿ ವಹಿಸುತ್ತೇನೆ.</para>
  <para style="q1" vid="HOS 14:8">ನಾನು ಹಸಿರಾಗಿ ಬೆಳೆದಿರುವ ತುರಾಯಿ ಮರದಂತಿದ್ದೇನೆ.</para>
  <para style="q2" vid="HOS 14:8">ನಿನ್ನ ಫಲವು ನನ್ನಿಂದ ಬರುವುದು.”<verse eid="HOS 14:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="HOS 14:9"/>ಯಾರು ಬುದ್ಧಿವಂತರು? ಅವರು ಈ ಸತ್ಯಗಳನ್ನು ಅರ್ಥಮಾಡಿಕೊಳ್ಳಲಿ.</para>
  <para style="q2" vid="HOS 14:9">ಯಾರು ವಿವೇಚನೆಯುಳ್ಳವರು? ಅವರು ಇವುಗಳನ್ನು ತಿಳಿದುಕೊಳ್ಳಲಿ.</para>
  <para style="q1" vid="HOS 14:9">ಏಕೆಂದರೆ, ಯೆಹೋವ ದೇವರ ಮಾರ್ಗಗಳು ನ್ಯಾಯವಾಗಿವೆ.</para>
  <para style="q2" vid="HOS 14:9">ನೀತಿವಂತರು ಅದರಲ್ಲಿ ನಡೆಯುವರು.</para>
  <para style="q2" vid="HOS 14:9">ಆದರೆ ಅಕ್ರಮಗಾರರು ಅವುಗಳಿಂದ ಎಡವಿಬೀಳುವರು.<verse eid="HOS 14:9"/></para>
  <chapter eid="HOS 14"/>
</usx>
