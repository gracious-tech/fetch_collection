<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="PHP" style="id">- Biblica® Open Kannada Contemporary Version</book>
  <para style="h">ಫಿಲಿಪ್ಪಿಯವರಿಗೆ</para>
  <para style="toc1">ಫಿಲಿಪ್ಪಿಯವರಿಗೆ ಪೌಲನು ಬರೆದ ಪತ್ರಿಕೆ</para>
  <para style="toc2">ಫಿಲಿಪ್ಪಿಯವರಿಗೆ</para>
  <para style="toc3">ಫಿಲಿಪ್ಪಿ</para>
  <para style="mt1">ಫಿಲಿಪ್ಪಿಯವರಿಗೆ</para>
  <para style="mt2">ಪೌಲನು ಬರೆದ ಪತ್ರಿಕೆ</para>
  <chapter number="1" style="c" sid="PHP 1"/>
  <para style="p">
    <verse number="1" style="v" sid="PHP 1:1"/>ಕ್ರಿಸ್ತ ಯೇಸುವಿನ ದಾಸರಾದ ಪೌಲ ತಿಮೊಥೆಯರು,</para>
  <para style="b" vid="PHP 1:1"/>
  <para style="p" vid="PHP 1:1">ಕ್ರಿಸ್ತ ಯೇಸುವಿನಲ್ಲಿರುವ ಫಿಲಿಪ್ಪಿಯ ದೇವರ ಪರಿಶುದ್ಧರೆಲ್ಲರಿಗೂ, ಅವರೊಂದಿಗಿರುವ ಮೇಲ್ವಿಚಾರಕರಿಗೂ ಸಭಾಸೇವಕರಿಗೂ ಬರೆಯುವ ಪತ್ರ:<verse eid="PHP 1:1"/></para>
  <para style="b"/>
  <para style="p">
    <verse number="2" style="v" sid="PHP 1:2"/>ನಮ್ಮ ತಂದೆಯಾದ ದೇವರಿಂದಲೂ ಕರ್ತ ಆಗಿರುವ ಯೇಸು ಕ್ರಿಸ್ತರಿಂದಲೂ ನಿಮಗೆ ಕೃಪೆಯೂ ಶಾಂತಿಯೂ ಆಗಲಿ.<verse eid="PHP 1:2"/></para>
  <para style="b"/>
  <para style="s1">ಕೃತಜ್ಞತಾಸ್ತುತಿ ಮತ್ತು ಪ್ರಾರ್ಥನೆ</para>
  <para style="p">
    <verse number="3" style="v" sid="PHP 1:3"/>ನಾನು ನಿಮ್ಮನ್ನು ನೆನೆಸಿಕೊಳ್ಳುವಾಗೆಲ್ಲಾ ನನ್ನ ದೇವರಿಗೆ ಕೃತಜ್ಞತೆಯನ್ನು ಸಲ್ಲಿಸುತ್ತೇನೆ. <verse eid="PHP 1:3"/><verse number="4" style="v" sid="PHP 1:4"/>ನಾನು ನಿಮ್ಮೆಲ್ಲರಿಗೋಸ್ಕರ ಯಾವಾಗಲೂ ಮಾಡುವ ನನ್ನ ಪ್ರತಿಯೊಂದು ಪ್ರಾರ್ಥನೆಯಲ್ಲಿ ಆನಂದದಿಂದಲೇ ಬೇಡಿಕೊಳ್ಳುವವನಾಗಿದ್ದೇನೆ. <verse eid="PHP 1:4"/><verse number="5" style="v" sid="PHP 1:5"/>ಏಕೆಂದರೆ, ನೀವು ಮೊದಲನೆಯ ದಿನದಿಂದ ಇಂದಿನವರೆಗೂ ಸುವಾರ್ತೆಯಲ್ಲಿ ಸಹಭಾಗಿಗಳಾಗಿದ್ದೀರಿ. <verse eid="PHP 1:5"/><verse number="6" style="v" sid="PHP 1:6"/>ಒಳ್ಳೆಯ ಕೆಲಸಗಳನ್ನು ನಿಮ್ಮಲ್ಲಿ ಪ್ರಾರಂಭಿಸಿದ ದೇವರು ಅದನ್ನು ಕ್ರಿಸ್ತ ಯೇಸುವಿನ ಪುನರಾಗಮನ ದಿನದವರೆಗೆ ಪೂರೈಸುವರು ಎಂಬುದೇ ನನ್ನ ದೃಢ ವಿಶ್ವಾಸವಾಗಿದೆ.<verse eid="PHP 1:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="PHP 1:7"/>ನಿಮ್ಮೆಲ್ಲರ ವಿಷಯದಲ್ಲಿ ಹೀಗೆ ಯೋಚಿಸುವುದು ನನಗೆ ಸೂಕ್ತವಾಗಿದೆ. ಏಕೆಂದರೆ ನಾನು ನಿಮ್ಮನ್ನು ನನ್ನ ಹೃದಯದಲ್ಲಿಟ್ಟುಕೊಂಡಿದ್ದೇನೆ. ನಾನು ಬೇಡಿಗಳಿಂದ ಸೆರೆಯಲ್ಲಿರುವಾಗಲೂ ಸುವಾರ್ತೆಯನ್ನು ಸಮರ್ಥಿಸಿ ದೃಢಪಡಿಸುವಾಗಲೂ ನೀವೆಲ್ಲರು ನನ್ನೊಂದಿಗಿರುವ ಕೃಪೆಯಲ್ಲಿ ಪಾಲುಗಾರರಾಗಿದ್ದೀರಿ. <verse eid="PHP 1:7"/><verse number="8" style="v" sid="PHP 1:8"/>ಕ್ರಿಸ್ತ ಯೇಸುವಿನ ವಾತ್ಸಲ್ಯದಿಂದ ನಿಮ್ಮೆಲ್ಲರಿಗೋಸ್ಕರ ನಾನು ಎಷ್ಟೋ ಹಂಬಲಿಸುತ್ತೇನೆ. ಇದಕ್ಕೆ ದೇವರೇ ಸಾಕ್ಷಿ.<verse eid="PHP 1:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="PHP 1:9"/>ನಿಮ್ಮ ಪ್ರೀತಿಯು ಹೆಚ್ಚುತ್ತಾ ಜ್ಞಾನದಲ್ಲಿಯೂ ಒಳನೋಟದಲ್ಲಿಯೂ ಬಹು ಹೆಚ್ಚಾಗಿ ಸಮೃದ್ಧಿಯಾಗಲಿ. <verse eid="PHP 1:9"/><verse number="10" style="v" sid="PHP 1:10"/>ಆಗ, ಅತ್ಯುತ್ತಮ ಕಾರ್ಯಗಳನ್ನು ನೀವು ವಿವೇಚಿಸಿಕೊಳ್ಳುವಿರಿ. ಕ್ರಿಸ್ತನ ಪುನರಾಗಮನ ದಿನದವರೆಗೆ ನೀವು ಪರಿಶುದ್ಧರಾಗಿಯೂ ನಿರ್ದೋಷಿಗಳಾಗಿಯೂ ಇರಬೇಕೆಂತಲೂ <verse eid="PHP 1:10"/><verse number="11" style="v" sid="PHP 1:11"/>ದೇವರ ಮಹಿಮೆ ಹಾಗೂ ಸ್ತೋತ್ರಕ್ಕಾಗಿ ಕ್ರಿಸ್ತ ಯೇಸುವಿನ ಮೂಲಕ ಬರುವ ನೀತಿಯ ಫಲಗಳಿಂದ ತುಂಬಿದವರಾಗಿರಬೇಕೆಂತಲೂ ಪ್ರಾರ್ಥಿಸುತ್ತೇನೆ.<verse eid="PHP 1:11"/></para>
  <para style="s1">ಪೌಲನ ಸೆರೆಯು ಸುವಾರ್ತೆಯ ಪ್ರಗತಿಯು</para>
  <para style="p">
    <verse number="12" style="v" sid="PHP 1:12"/>ಪ್ರಿಯರೇ, ನನಗೆ ಸಂಭವಿಸಿದ ಸಂಕಟಗಳು ಸುವಾರ್ತೆಯ ಪ್ರಗತಿಗಾಗಿಯೇ ಅನುಕೂಲವಾಯಿತು ಎಂಬುದನ್ನು ನೀವು ತಿಳಿಯಬೇಕೆಂದು ನಾನು ಅಪೇಕ್ಷಿಸುತ್ತೇನೆ. <verse eid="PHP 1:12"/><verse number="13" style="v" sid="PHP 1:13"/>ಹೇಗೆಂದರೆ, ನಾನು ಸೆರೆಯಲ್ಲಿರುವುದು ಕ್ರಿಸ್ತನ ನಿಮಿತ್ತವೇ ಎಂದು ಇಡೀ ರಾಜಭವನದಲ್ಲಿಯೂ ಮಿಕ್ಕಾದವರೆಲ್ಲರಿಗೂ ಚೆನ್ನಾಗಿ ತಿಳಿದಿದೆ. <verse eid="PHP 1:13"/><verse number="14" style="v" sid="PHP 1:14"/>ನಾನು ಸೆರೆಯಲ್ಲಿರುವುದರಿಂದಲೇ ಕರ್ತ ದೇವರಲ್ಲಿರುವ ಅನೇಕ ಸಹೋದರರು ಭಯವಿಲ್ಲದೆಯೂ ಭರವಸೆಯಿಂದಲೂ ಸುವಾರ್ತೆಯ ವಾಕ್ಯವನ್ನು ಮಾತನಾಡುವುದಕ್ಕೆ ಪ್ರೋತ್ಸಾಹ ಹೊಂದಿದ್ದಾರೆ.<verse eid="PHP 1:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="PHP 1:15"/>ಕೆಲವರು ಅಸೂಯೆಯಿಂದಲೂ ಸ್ಪರ್ಧೆಯ ಮನೋಭಾವನೆಯಿಂದಲೂ ಕ್ರಿಸ್ತನನ್ನು ಸಾರುವುದು ನಿಜ. ಆದರೆ ಇತರರು ಒಳ್ಳೆಯ ಮನೋಭಾವದಿಂದ ಕ್ರಿಸ್ತ ಯೇಸುವನ್ನು ಸಾರುತ್ತಿದ್ದಾರೆ. <verse eid="PHP 1:15"/><verse number="16" style="v" sid="PHP 1:16"/>ಇವರಾದರೋ, ನಾನು ಸುವಾರ್ತೆಗಾಗಿ ನೇಮಕವಾಗಿದ್ದೇವೆಂದು ತಿಳಿದು ಪ್ರೀತಿಯಿಂದ ಸಾರುತ್ತಾರೆ. <verse eid="PHP 1:16"/><verse number="17" style="v" sid="PHP 1:17"/>ಅವರಾದರೋ, ನಾನು ಬೇಡಿಗಳಿಂದ ಸೆರೆಮನೆಯಲ್ಲಿರುವಾಗ ಸಂಕಟವನ್ನು ಹೆಚ್ಚಿಸಬೇಕೆಂದು ಯೋಚಿಸಿ ಕ್ರಿಸ್ತನನ್ನು ಯಥಾರ್ಥವಾಗಿ ಪ್ರಸಿದ್ಧ ಪಡಿಸದೆ ಪ್ರತಿಸ್ಪರ್ಧೆಗಾಗಿ ಸಾರುತ್ತಾರೆ. <verse eid="PHP 1:17"/><verse number="18" style="v" sid="PHP 1:18"/>ಹೇಗಾದರೇನು? ಕಪಟದಿಂದಾಗಲಿ, ಸತ್ಯದಿಂದಾಗಲಿ ಯಾವ ರೀತಿಯಿಂದಾದರೂ ಕ್ರಿಸ್ತನನ್ನು ಅವರು ಸಾರುತ್ತಿರುವುದೇ ನನಗೆ ಸಂತೋಷ.</para>
  <para style="p" vid="PHP 1:18">ಹೌದು ಮುಂದೆಯೂ ಸಂತೋಷಿಸುವೆನು. <verse eid="PHP 1:18"/><verse number="19" style="v" sid="PHP 1:19"/>ನಿಮ್ಮ ಪ್ರಾರ್ಥನೆಯಿಂದಲೂ ಕ್ರಿಸ್ತ ಯೇಸು ಕೊಡುವ ಪವಿತ್ರಾತ್ಮರ ಸಹಾಯದಿಂದ ನನಗೆ ಸಂಭವಿಸಿದವುಗಳು ನನ್ನ ಬಿಡುಗಡೆಗಾಗಿಯೇ ಎಂದು ನಾನು ಬಲ್ಲೆನು. <verse eid="PHP 1:19"/><verse number="20" style="v" sid="PHP 1:20"/>ಹೇಗೆಂದರೆ, ನಾನು ಯಾವ ವಿಷಯದಲ್ಲೂ ನಾಚಿಕೆಪಡದೆ ಎಂದಿನಂತೆ ಈಗಲೂ ಪೂರ್ಣ ಧೈರ್ಯದಿಂದಿರುವಂತೆಯೇ ಬದುಕಿದರೂ ಸತ್ತರೂ ನನ್ನ ದೇಹದ ಮೂಲಕ ಕ್ರಿಸ್ತನಿಗೆ ಮಹಿಮೆಯುಂಟಾಗಬೇಕೆಂಬುದೇ ನನ್ನ ಬಯಕೆಯೂ ನಿರೀಕ್ಷೆಯೂ ಆಗಿದೆ. <verse eid="PHP 1:20"/><verse number="21" style="v" sid="PHP 1:21"/>ನನಗಂತೂ ಬದುಕುವುದೆಂದರೆ ಕ್ರಿಸ್ತನೇ, ಸಾಯುವುದು ಲಾಭವೇ, <verse eid="PHP 1:21"/><verse number="22" style="v" sid="PHP 1:22"/>ಶರೀರದಲ್ಲಿಯೇ ಬದುಕುವುದು ನನಗೆ ಫಲದಾಯಕವಾದ ಪ್ರಯಾಸವಾಗಿದ್ದರೆ, ನಾನು ಯಾವುದನ್ನು ಆರಿಸಿಕೊಳ್ಳಬೇಕೋ ನನಗೆ ತಿಳಿಯದು. <verse eid="PHP 1:22"/><verse number="23" style="v" sid="PHP 1:23"/>ಈ ಎರಡರ ನಡುವೆ ಸಿಕ್ಕಿಕೊಂಡಿದ್ದೇನೆ. ಇಲ್ಲಿಂದ ಹೊರಟು ಕ್ರಿಸ್ತನೊಡನೆ ಇರಬೇಕೆಂಬ ಆಶೆಯಿದೆ. ಅದು ಬಹು ಉತ್ತಮವಾಗಿರುವುದು. <verse eid="PHP 1:23"/><verse number="24" style="v" sid="PHP 1:24"/>ಆದರೂ ನಾನು ಶರೀರದಲ್ಲಿಯೇ ಉಳಿದಿರುವುದು ನಿಮಗೋಸ್ಕರ ಬಹು ಅವಶ್ಯಕವಾಗಿದೆ. <verse eid="PHP 1:24"/><verse number="25" style="v" sid="PHP 1:25"/>ನಿಮಗೆ ನಂಬಿಕೆಯಲ್ಲಿ ಅಭಿವೃದ್ಧಿಯೂ ಸಂತೋಷವೂ ಉಂಟಾಗುವುದಕ್ಕೋಸ್ಕರ ನಾನು ಜೀವದಿಂದುಳಿದು ನಿಮ್ಮೆಲ್ಲರೊಡನೆ ಇರುವೆನೆಂದು ನಿಶ್ಚಯವಾಗಿ ತಿಳಿದಿದ್ದೇನೆ. <verse eid="PHP 1:25"/><verse number="26" style="v" sid="PHP 1:26"/>ಹೀಗೆ ನಾನು ಪುನಃ ನಿಮ್ಮ ಬಳಿಗೆ ಬರುವುದರಿಂದ ಕ್ರಿಸ್ತ ಯೇಸುವಿನಲ್ಲಿರುವ ನಿಮ್ಮ ಸಂತೋಷವು ನನ್ನ ನಿಮಿತ್ತವಾಗಿ ಅತ್ಯಧಿಕವಾಗಿರುವುದು.<verse eid="PHP 1:26"/></para>
  <para style="s1">ಸುವಾರ್ತೆಗೆ ಯೋಗ್ಯರಾಗಿ ನಡೆದುಕೊಳ್ಳುವುದು</para>
  <para style="p">
    <verse number="27" style="v" sid="PHP 1:27"/>ಏನೇ ಸಂಭವಿಸಿದರೂ ಕ್ರಿಸ್ತನ ಸುವಾರ್ತೆಗೆ ಯೋಗ್ಯರಾಗಿ ನಡೆದುಕೊಳ್ಳಿರಿ. ಆಗ ನಾನು ಬಂದು ನಿಮ್ಮನ್ನು ನೋಡಿದರೂ ಸರಿ, ದೂರದಲ್ಲಿದ್ದು ನಿಮ್ಮ ವಿಷಯವಾಗಿ ಕೇಳಿದರೂ ಸರಿ, ನೀವು ಒಂದೇ ಆತ್ಮದಲ್ಲಿ ದೃಢವಾಗಿ ನಿಂತು ಸುವಾರ್ತೆಯಲ್ಲಿಟ್ಟ ನಂಬಿಕೆಗಾಗಿ ಒಂದೇ ಮನಸ್ಸಿನಿಂದ ಒಟ್ಟಿಗೆ ಹೋರಾಡುವವರಾಗಿದ್ದೀರೆಂದು ನಾನು ತಿಳಿದುಕೊಳ್ಳುವೆನು. <verse eid="PHP 1:27"/><verse number="28" style="v" sid="PHP 1:28"/>ನಿಮ್ಮ ವಿರೋಧಿಗಳಿಗೆ ಯಾವ ವಿಷಯದಲ್ಲಿಯೂ ಅಂಜದೆ ಧೈರ್ಯದಿಂದಿರಿ. ನೀವು ಧೈರ್ಯದಿಂದಿರುವುದು, ಅವರ ವಿನಾಶಕ್ಕೂ, ನಿಮ್ಮ ರಕ್ಷಣೆಗೂ ದೇವರಿಂದಾದ ಸೂಚನೆಯಾಗಿದೆ. <verse eid="PHP 1:28"/><verse number="29" style="v" sid="PHP 1:29"/>ನೀವು ಕ್ರಿಸ್ತ ಯೇಸುವಿನಲ್ಲಿ ನಂಬಿಕೆಯಿಡುವುದು ಮಾತ್ರವಲ್ಲ, ಅವರಿಗೋಸ್ಕರ ಸಂಕಷ್ಟಗಳನ್ನು ಅನುಭವಿಸುವುದೂ ನಿಮಗೆ ದಾನವಾಗಿ ಕೊಡಲಾಗಿದೆ. <verse eid="PHP 1:29"/><verse number="30" style="v" sid="PHP 1:30"/>ನೀವು ನನ್ನಲ್ಲಿ ಕಂಡು, ಈಗ ನನ್ನಲ್ಲಿರುವುದೆಂದು ಕೇಳುತ್ತಿರುವ ಅದೇ ಹೋರಾಟದ ಅನುಭವವೇ ನಿಮಗೂ ಇದೆ.<verse eid="PHP 1:30"/></para>
  <chapter eid="PHP 1"/>
  <chapter number="2" style="c" sid="PHP 2"/>
  <para style="s1">ಕ್ರಿಸ್ತನ ದೀನತೆಯ ಅನುಸರಣೆ</para>
  <para style="p">
    <verse number="1" style="v" sid="PHP 2:1"/>ನೀವು ಕ್ರಿಸ್ತನೊಂದಿಗೆ ಐಕ್ಯವಾಗಿರುವುದರಿಂದ ಉತ್ತೇಜನ, ಅವರ ಪ್ರೀತಿಯಿಂದ ಸಂತೈಸುವಿಕೆ, ಆತ್ಮನಲ್ಲಿ ಅನ್ಯೋನ್ಯತೆ, ಕನಿಕರದ ವಾತ್ಸಲ್ಯಗಳು ಇರುವುದಾದರೆ, <verse eid="PHP 2:1"/><verse number="2" style="v" sid="PHP 2:2"/>ನೀವು ಒಂದೇ ಮನಸ್ಸು, ಒಂದೇ ಪ್ರೀತಿ, ಆತ್ಮ, ಹಾಗೂ ಒಂದೇ ಗುರಿಯುಳ್ಳವರಾಗಿ, ನನ್ನ ಸಂತೋಷವನ್ನು ಪರಿಪೂರ್ಣಗೊಳಿಸಿರಿ. <verse eid="PHP 2:2"/><verse number="3" style="v" sid="PHP 2:3"/>ಸ್ವಾರ್ಥ ಉದ್ದೇಶದಿಂದಾಗಲಿ, ವ್ಯರ್ಥ ಹೆಮ್ಮೆಯಿಂದಾಗಲಿ ಯಾವುದನ್ನೂ ಮಾಡದೆ ಪ್ರತಿಯೊಬ್ಬನೂ ದೀನತ್ವದಿಂದ ಮತ್ತೊಬ್ಬನನ್ನು ತನಗಿಂತಲೂ ಶ್ರೇಷ್ಠನೆಂದು ಎಣಿಸಲಿ. <verse eid="PHP 2:3"/><verse number="4" style="v" sid="PHP 2:4"/>ಪ್ರತಿಯೊಬ್ಬನೂ ಸ್ವಹಿತವನ್ನು ನೋಡದೆ ಪರಹಿತವನ್ನು ಸಹ ನೋಡಲಿ.<verse eid="PHP 2:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="PHP 2:5"/>ಕ್ರಿಸ್ತ ಯೇಸುವಿನಲ್ಲಿದ್ದ ಮನಸ್ಸೇ ನಿಮ್ಮಲ್ಲಿಯೂ ಇರಲಿ:<verse eid="PHP 2:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PHP 2:6"/>ಅವರು ದೇವರ ಸ್ವರೂಪವಾಗಿದ್ದರೂ,</para>
  <para style="q2" vid="PHP 2:6">ದೇವರಿಗೆ ಸಮಾನರಾಗಿರುವುದನ್ನು ಬಿಡಲೊಲ್ಲೆನೆಂದು ಎಣಿಸದೆ,<verse eid="PHP 2:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PHP 2:7"/>ತಮ್ಮನ್ನು ತಾವೇ ಬರಿದುಮಾಡಿಕೊಂಡು</para>
  <para style="q2" vid="PHP 2:7">ಗುಲಾಮನ ರೂಪವನ್ನು ಧರಿಸಿಕೊಂಡು</para>
  <para style="q2" vid="PHP 2:7">ಮನುಷ್ಯರಿಗೆ ಸಮನಾದರು.<verse eid="PHP 2:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PHP 2:8"/>ಹೀಗೆ ಅವರು ಆಕಾರದಲ್ಲಿ ಮನುಷ್ಯರಾಗಿ ಕಾಣಿಸಿಕೊಂಡಾಗ</para>
  <para style="q2" vid="PHP 2:8">ತಮ್ಮನ್ನು ತಾವೇ ತಗ್ಗಿಸಿಕೊಂಡು</para>
  <para style="q2" vid="PHP 2:8">ಮರಣವನ್ನು ಎಂದರೆ ಶಿಲುಬೆಯ</para>
  <para style="q3" vid="PHP 2:8">ಮರಣವನ್ನೂ ಹೊಂದುವಷ್ಟು ವಿಧೇಯರಾದರು.<verse eid="PHP 2:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PHP 2:9"/>ಈ ಕಾರಣದಿಂದಲೇ ದೇವರು ಅವರನ್ನು ಅತ್ಯುನ್ನತ ಸ್ಥಾನಕ್ಕೆ ಏರಿಸಿ</para>
  <para style="q2" vid="PHP 2:9">ಎಲ್ಲಾ ಹೆಸರುಗಳಿಗಿಂತ ಉನ್ನತವಾದ ಹೆಸರನ್ನು ಅವರಿಗೆ ದಯಪಾಲಿಸಿದ್ದಾರೆ.<verse eid="PHP 2:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PHP 2:10"/>ಆದ್ದರಿಂದ ಪರಲೋಕ, ಭೂಲೋಕ, ಭೂಮಿಯ ಕೆಳಗಿರುವವರೆಲ್ಲರೂ</para>
  <para style="q2" vid="PHP 2:10">ಯೇಸುವಿನ ಹೆಸರಿನಲ್ಲಿ ಮೊಣಕಾಲೂರಿ,<verse eid="PHP 2:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PHP 2:11"/>ತಂದೆಯಾದ ದೇವರ ಮಹಿಮೆಗಾಗಿ</para>
  <para style="q2" vid="PHP 2:11">ಯೇಸು ಕ್ರಿಸ್ತನು ಕರ್ತದೇವರು ಎಂಬುದಾಗಿ ಪ್ರತಿಯೊಂದು ನಾಲಿಗೆಯೂ ಅರಿಕೆ ಮಾಡುವುದು.<verse eid="PHP 2:11"/></para>
  <para style="s1">ಗೊಣಗುಟ್ಟದೆ ಎಲ್ಲವನ್ನೂ ಮಾಡಿರಿ</para>
  <para style="p">
    <verse number="12" style="v" sid="PHP 2:12"/>ಹೀಗಿರುವಲ್ಲಿ ನನ್ನ ಪ್ರಿಯ ಸ್ನೇಹಿತರೇ, ನಿಮ್ಮಲ್ಲಿರುವಾಗ ಮಾತ್ರವಲ್ಲದೆ ನಾನಿಲ್ಲದಿರುವಾಗಲೂ ನೀವು ಯಾವಾಗಲೂ ನನಗೆ ವಿಧೇಯರಾದಂತೆ ಈಗಲೂ ವಿಧೇಯರಾಗಿ, ಬಹು ಹೆಚ್ಚಾಗಿ ಭಯದಿಂದ ನಡುಗುತ್ತಾ ನಿಮ್ಮ ರಕ್ಷಣೆಯನ್ನು ಕಾರ್ಯರೂಪಕ್ಕೆ ತನ್ನಿರಿ. <verse eid="PHP 2:12"/><verse number="13" style="v" sid="PHP 2:13"/>ಏಕೆಂದರೆ, ತಮ್ಮ ಸದುದ್ದೇಶವನ್ನು ನೆರವೇರಿಸುವಂತೆ ನಿಮ್ಮಲ್ಲಿ ಬಯಕೆಯನ್ನೂ ಕಾರ್ಯಸಾಧನೆಯನ್ನೂ ನಿರ್ಮಿಸುವವರು ದೇವರೇ.<verse eid="PHP 2:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="PHP 2:14"/>ಗೊಣಗುಟ್ಟದೆಯೂ ವಿವಾದವಿಲ್ಲದೆಯೂ ಎಲ್ಲವನ್ನೂ ಮಾಡಿರಿ. <verse eid="PHP 2:14"/><verse number="15" style="v" sid="PHP 2:15"/>ಹೀಗೆ ನೀವು ನಿಂದಾರಹಿತರೂ ದೋಷವಿಲ್ಲದವರೂ, “ನಿಷ್ಕಳಂಕರಾದ ದೇವರ ಮಕ್ಕಳಾಗಿ, ವಕ್ರವಾದ ದುಷ್ಟ ಜನಾಂಗದ ಮಧ್ಯದಲ್ಲಿ,”<note caller="+" style="f"><char style="fr" closed="false">2:15 </char><char style="ft" closed="false"><char style="xt"><ref loc="DEU 32:5">ಧರ್ಮೋ 32:5</ref></char></char></note> ಜೀವವಾಕ್ಯವನ್ನು ಹಿಡಿದುಕೊಂಡು, ಲೋಕದಲ್ಲಿ ನಕ್ಷತ್ರಗಳಂತೆ ಹೊಳೆಯುವವರಾಗಿರುವಿರಿ. <verse eid="PHP 2:15"/><verse number="16" style="v" sid="PHP 2:16"/>ನೀವು ಜೀವವಾಕ್ಯವನ್ನು ಹಿಡಿದವರಾಗಿದ್ದರೆ, ಹೀಗೆ ನಾನು ಓಡಿದ ಓಟವೂ ಪ್ರಯಾಸವೂ ವ್ಯರ್ಥವಾಗಲಿಲ್ಲವೆಂದು ತಿಳಿದು ಕ್ರಿಸ್ತನ ಪುನರಾಗಮನ ದಿನದಲ್ಲಿ ಅಭಿಮಾನ ಪಡುವೆನು. <verse eid="PHP 2:16"/><verse number="17" style="v" sid="PHP 2:17"/>ನಿಮ್ಮ ವಿಶ್ವಾಸದಿಂದ ಬರುವ ಯಜ್ಞದ ಮೇಲೆಯೂ ಸೇವೆಯ ಮೇಲೆಯೂ ನಾನು ಪಾನಸಮರ್ಪಣೆಯಾದರೂ ಸಹ ಹರ್ಷದಿಂದ ನಿಮ್ಮೆಲ್ಲರೊಡನೆ ಆನಂದಿಸುವೆನು. <verse eid="PHP 2:17"/><verse number="18" style="v" sid="PHP 2:18"/>ಇದಕ್ಕಾಗಿಯೇ ನೀವೂ ಹರ್ಷಿಸಿರಿ. ನನ್ನೊಡನೆ ಆನಂದಿಸಿರಿ.<verse eid="PHP 2:18"/></para>
  <para style="s1">ತಿಮೊಥೆಯನೂ ಎಪಫ್ರೊದೀತನೂ</para>
  <para style="p">
    <verse number="19" style="v" sid="PHP 2:19"/>ನಾನು ತಿಮೊಥೆಯನನ್ನು ಬೇಗನೆ ನಿಮ್ಮ ಬಳಿಗೆ ಕಳುಹಿಸುವುದಕ್ಕೆ ಕರ್ತ ಯೇಸುವಿನಲ್ಲಿ ನಿರೀಕ್ಷಿಸುತ್ತೇನೆ. ಹೀಗೆ ಅವನ ಮುಖಾಂತರ ನಿಮ್ಮ ವಿಷಯವನ್ನು ತಿಳಿದು ನಾನು ಸಹ ಉತ್ತೇಜನಗೊಳ್ಳುವೆನು. <verse eid="PHP 2:19"/><verse number="20" style="v" sid="PHP 2:20"/>ಅವನ ಹಾಗೆ ನಿಮ್ಮ ಯೋಗಕ್ಷೇಮವನ್ನು ಕುರಿತು ಯಥಾರ್ಥವಾಗಿ ಚಿಂತಿಸುವವರು, ನನ್ನ ಬಳಿ ಬೇರೆ ಯಾರೂ ಇಲ್ಲ. <verse eid="PHP 2:20"/><verse number="21" style="v" sid="PHP 2:21"/>ಎಲ್ಲರೂ ಸ್ವಕಾರ್ಯಗಳನ್ನೇ ಹುಡುಕುತ್ತಾರೆಯೇ ಹೊರತು ಕ್ರಿಸ್ತ ಯೇಸುವಿನ ಕಾರ್ಯಗಳನ್ನು ಹುಡುಕುವುದಿಲ್ಲ. <verse eid="PHP 2:21"/><verse number="22" style="v" sid="PHP 2:22"/>ಆದರೆ ತಿಮೊಥೆಯನ ಗುಣಸ್ವಭಾವವನ್ನು ನೀವು ಬಲ್ಲಿರಿ. ಮಗನು ತಂದೆಗೆ ಹೇಗೋ ಹಾಗೆಯೇ ಅವನು ಸುವಾರ್ತೆಯಲ್ಲಿ ನನ್ನೊಂದಿಗೆ ಶ್ರಮಿಸಿದ್ದಾನೆ. <verse eid="PHP 2:22"/><verse number="23" style="v" sid="PHP 2:23"/>ಆದ್ದರಿಂದ ನನಗೆ ಏನು ಸಂಭವಿಸುವುದು ಎಂದು ತಿಳಿದ ಕೂಡಲೇ ಅವನನ್ನು ಕಳುಹಿಸುವ ನಿರೀಕ್ಷೆಯಿದೆ. <verse eid="PHP 2:23"/><verse number="24" style="v" sid="PHP 2:24"/>ಇದಲ್ಲದೆ ನಾನು ಸಹ ಬೇಗನೆ ಬರುವೆನೆಂದು ಕರ್ತ ದೇವರಲ್ಲಿ ಭರವಸೆಯುಳ್ಳವನಾಗಿದ್ದೇನೆ.<verse eid="PHP 2:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="PHP 2:25"/>ಆದರೂ ನನ್ನ ಸಹೋದರನೂ ಜೊತೆ ಕೆಲಸದವನೂ ಸಹಸೈನಿಕನೂ ಆಗಿರುವ ಎಪಫ್ರೊದೀತನನ್ನು ನಿಮ್ಮ ಬಳಿಗೆ ಕಳುಹಿಸುವುದು ಅವಶ್ಯವೆಂದು ನಾನು ನೆನೆಸಿದ್ದೇನೆ. ಅವನು ನನ್ನ ಕೊರತೆಯಲ್ಲಿ ಸೇವೆ ಮಾಡುವಂತೆ ನೀವು ಕಳುಹಿಸಿದ ನಿಮ್ಮ ಸಂದೇಶಕನೂ ಆಗಿದ್ದಾನೆ. <verse eid="PHP 2:25"/><verse number="26" style="v" sid="PHP 2:26"/>ಏಕೆಂದರೆ ಅವನು ನಿಮ್ಮೆಲ್ಲರನ್ನು ಕುರಿತು ಹಂಬಲಿಸುತ್ತಿದ್ದಾನೆ. ತಾನು ಅಸ್ವಸ್ಥನಾದ ಸುದ್ದಿಯು ನಿಮಗೆ ಮುಟ್ಟಿತೆಂದು ತಿಳಿದು ತುಂಬಾ ವ್ಯಸನಪಡುತ್ತಿದ್ದಾನೆ. <verse eid="PHP 2:26"/><verse number="27" style="v" sid="PHP 2:27"/>ಅವನು ಅಸ್ವಸ್ಥನಾಗಿ ಸಾಯುವ ಹಾಗೆ ಇದ್ದದ್ದು ನಿಜವೇ. ಆದರೆ ದೇವರು ಅವನನ್ನು ಕರುಣಿಸಿದರು. ಅವನನ್ನು ಮಾತ್ರವಲ್ಲದೆ ನನಗೆ ದುಃಖದ ಮೇಲೆ ದುಃಖ ಬಾರದಂತೆ ನನ್ನನ್ನು ಕರುಣಿಸಿದರು. <verse eid="PHP 2:27"/><verse number="28" style="v" sid="PHP 2:28"/>ಆದ್ದರಿಂದ ನೀವು ಅವನನ್ನು ನೋಡಿ ಪುನಃ ಆನಂದಿಸುವಂತೆಯೂ ನನಗೆ ದುಃಖ ಕಡಿಮೆಯಾಗುವಂತೆಯೂ ನಾನು ಅವನನ್ನು ಅತ್ಯಾಸಕ್ತಿಯಿಂದ ಕಳುಹಿಸಿದ್ದೇನೆ. <verse eid="PHP 2:28"/><verse number="29" style="v" sid="PHP 2:29"/>ನೀವು ಅವನನ್ನು ಪೂರ್ಣ ಆನಂದದಿಂದ ಕರ್ತನಲ್ಲಿ ಸೇರಿಸಿಕೊಳ್ಳಿರಿ ಮತ್ತು ಅಂಥವರನ್ನು ಸನ್ಮಾನಿಸಿರಿ. <verse eid="PHP 2:29"/><verse number="30" style="v" sid="PHP 2:30"/>ಅವನು ಕ್ರಿಸ್ತನ ಸೇವೆಯ ನಿಮಿತ್ತ ಸಾಯುವ ಹಾಗಿದ್ದನು. ನೀವು ನನಗೆ ಮಾಡಲು ಸಾಧ್ಯವಾಗದೆ ಹೋದ ಸಹಾಯವನ್ನು ತಾನೇ ಪೂರ್ತಿ ಮಾಡುವುದಕ್ಕಾಗಿ, ಅವನು ತನ್ನ ಪ್ರಾಣವನ್ನೇ ಅಪಾಯಕ್ಕೆ ಗುರಿಪಡಿಸಿಕೊಂಡನು.<verse eid="PHP 2:30"/></para>
  <chapter eid="PHP 2"/>
  <chapter number="3" style="c" sid="PHP 3"/>
  <para style="s1">ಸ್ವಶರೀರದಲ್ಲಿ ಭರವಸೆಯಿಡದಿರುವುದು</para>
  <para style="p">
    <verse number="1" style="v" sid="PHP 3:1"/>ಕಡೆಯದಾಗಿ ನನ್ನ ಪ್ರಿಯರೇ, ಕರ್ತನಲ್ಲಿ ಆನಂದಿಸಿರಿ. ಬರೆದದ್ದನ್ನೇ ನಿಮಗೆ ಬರೆಯುವುದರಲ್ಲಿ ನನಗೆ ಬೇಸರವಿಲ್ಲ, ಅದು ನಿಮಗೆ ಸುರಕ್ಷಿತವೇ. <verse eid="PHP 3:1"/><verse number="2" style="v" sid="PHP 3:2"/>ನಾಯಿಗಳಂತೆ ವರ್ತಿಸುವವರಿಗೆ ಎಚ್ಚರಿಕೆ. ದುಷ್ಟಕಾರ್ಯಮಾಡುವವರಿಗೆ ಎಚ್ಚರಿಕೆ, ಸುಳ್ಳು ಸುನ್ನತಿಗಾಗಿ ವಾಗ್ವಾದಿಸುವವರಿಗೆ ಎಚ್ಚರಿಕೆ. <verse eid="PHP 3:2"/><verse number="3" style="v" sid="PHP 3:3"/>ಏಕೆಂದರೆ ದೇವರನ್ನು ಪವಿತ್ರಾತ್ಮರಿಂದ ಆರಾಧಿಸಿ ಕ್ರಿಸ್ತ ಯೇಸುವನ್ನು ಮಹಿಮೆಪಡಿಸುತ್ತಾ ಹರ್ಷಗೊಳ್ಳುವವರೂ ಮಾಂಸದಲ್ಲಿ ಭರವಸೆಯಿಡದ ನಾವೇ ಸುನ್ನತಿಯಾಗಿದ್ದೇವೆ. <verse eid="PHP 3:3"/><verse number="4" style="v" sid="PHP 3:4"/>ಮಾಂಸದಲ್ಲಿ ಭರವಸೆ ಇಡಲು ನನಗೆ ಸಾಕಷ್ಟು ಕಾರಣಗಳಿವೆ.</para>
  <para style="p" vid="PHP 3:4">ಬೇರೆ ಯಾವನಾದರೂ ಮಾನವೀಯ ಪ್ರಯತ್ನಗಳಲ್ಲಿ ಭರವಸೆ ಇಡಬಹುದೆಂದು ಭಾವಿಸುವುದಾದರೆ, ನಾನು ಅದಕ್ಕಿಂತಲೂ ಹೆಚ್ಚಾಗಿ ಹೇಳಬಹುದು: <verse eid="PHP 3:4"/><verse number="5" style="v" sid="PHP 3:5"/>ಎಂಟನೆಯ ದಿನದಲ್ಲಿ ನನಗೆ ಸುನ್ನತಿಯಾಯಿತು, ನಾನು ಇಸ್ರಾಯೇಲ್ ವಂಶದವನು; ಬೆನ್ಯಾಮೀನನ ಕುಲದವನು; ಹೀಬ್ರಿಯರಿಂದ ಹುಟ್ಟಿದ ಹೀಬ್ರಿಯನು; ಮೋಶೆಯ ನಿಯಮದ ಅನುಸಾರವಾಗಿ ನಾನು ಫರಿಸಾಯನು. <verse eid="PHP 3:5"/><verse number="6" style="v" sid="PHP 3:6"/>ಆಸಕ್ತಿಯನ್ನು ನೋಡಿದರೆ, ನಾನು ಸಭೆಯ ಹಿಂಸಕನು; ಮೋಶೆಯ ನಿಯಮದಲ್ಲಿರುವ ನೀತಿಯ ಅನುಸಾರವಾಗಿ ನಾನು ನಿರ್ದೋಷಿ.<verse eid="PHP 3:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="PHP 3:7"/>ನನಗೆ ಲಾಭವಾಗಿದ್ದ ಎಲ್ಲವನ್ನೂ ಈಗ ನಾನು ಕ್ರಿಸ್ತನ ನಿಮಿತ್ತ ನಷ್ಟವೆಂದು ಎಣಿಸುತ್ತೇನೆ. <verse eid="PHP 3:7"/><verse number="8" style="v" sid="PHP 3:8"/>ಇದಲ್ಲದೆ, ನನ್ನ ಕರ್ತದೇವರು ಆಗಿರುವ ಕ್ರಿಸ್ತ ಯೇಸುವನ್ನು ಅರಿತುಕೊಳ್ಳುವುದೇ ಅತಿ ಶ್ರೇಷ್ಠವಾದುದ್ದೆಂದು, ನಾನು ಎಲ್ಲವನ್ನೂ ನಷ್ಟವೆಂದು ಎಣಿಸುತ್ತೇನೆ. ಕ್ರಿಸ್ತನನ್ನೇ ಲಾಭವನ್ನಾಗಿಸಿಕೊಳ್ಳಲು ನಾನು ಎಲ್ಲವನ್ನೂ ಕಸವೆಂದೇ ಪರಿಗಣಿಸುತ್ತೇನೆ. <verse eid="PHP 3:8"/><verse number="9" style="v" sid="PHP 3:9"/>ಹೀಗೆ ನಾನು ಕ್ರಿಸ್ತನನ್ನು ಸಂಪಾದಿಸಿಕೊಂಡು ಅವರಲ್ಲಿ ಒಂದಾಗಿರ ಬಯಸುತ್ತೇನೆ. ನಿಯಮದಿಂದ ಬರುವ ಸ್ವನೀತಿಯನ್ನು ಆಶ್ರಯಿಸಿಕೊಳ್ಳದೆ, ಕ್ರಿಸ್ತನನ್ನು ನಂಬುವುದರ ಮೂಲಕ ವಿಶ್ವಾಸದ ಆಧಾರದ ಮೇಲೆ ದೇವರು ಕೊಡುವ ನೀತಿಯನ್ನೇ ಹೊಂದಿದವನಾಗಿರ ಬಯಸುತ್ತೇನೆ. <verse eid="PHP 3:9"/><verse number="10" style="v" sid="PHP 3:10"/>ಕ್ರಿಸ್ತನನ್ನೂ ಅವರ ಪುನರುತ್ಥಾನದ ಶಕ್ತಿಯನ್ನೂ ನಾನು ಅರಿತುಕೊಂಡು, ಕ್ರಿಸ್ತನ ಶ್ರಮೆಯಲ್ಲಿ ಪಾಲುಗೊಳ್ಳುವ ಅನ್ಯೋನ್ಯತೆಯನ್ನೂ ಅವರ ಮರಣದಲ್ಲಿ ಅವರ ಹಾಗೆ ಆಗುವುದನ್ನೂ ತಿಳಿಯುವುದೇ ನನ್ನ ಅಪೇಕ್ಷೆ. <verse eid="PHP 3:10"/><verse number="11" style="v" sid="PHP 3:11"/>ಹೇಗಾದರೂ, ನಾನೂ ಸಹ ಸತ್ತವರೊಳಗಿಂದ ಪುನರುತ್ಥಾನ ಹೊಂದುವೆನು.<verse eid="PHP 3:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="PHP 3:12"/>ಇದನ್ನೆಲ್ಲಾ ನಾನು ಸಾಧಿಸಿದ್ದೇನೆಂದಲ್ಲ ಅಥವಾ ಈಗಲೇ ನಾನು ಪರಿಪೂರ್ಣನಾಗಿದ್ದೇನೆಂದೂ ನಾನು ಹೇಳುತ್ತಾ ಇಲ್ಲ. ಆದರೆ ಕ್ರಿಸ್ತ ಯೇಸು ನನ್ನನ್ನು ಅನುಸರಿಸಬೇಕೆಂದು ಯಾವುದಕ್ಕಾಗಿ ಆರಿಸಿಕೊಂಡರೋ, ಆ ಪೂರ್ಣತೆಯೆಡೆಗೆ ತಲುಪುವಂತೆ ನಾನು ಪರಿಶ್ರಮಿಸುತ್ತಿದ್ದೇನೆ. <verse eid="PHP 3:12"/><verse number="13" style="v" sid="PHP 3:13"/>ಪ್ರಿಯರೇ, ನಾನಂತೂ ಆ ಗುರಿಯನ್ನು ತಲುಪಿದ್ದೇನೆಂದು ಭಾವಿಸಿಕೊಂಡಿಲ್ಲ. ಆದರೆ ಒಂದು ಸಂಗತಿ, ನಾನು ಹಿಂದಿನ ವಿಷಯಗಳನ್ನು ಮರೆತುಬಿಟ್ಟು, ಮುಂದಿನ ವಿಷಯಗಳನ್ನು ಮಾತ್ರ ಲಕ್ಷ್ಯವನ್ನಾಗಿ ಮಾಡಿಕೊಂಡು ಅದನ್ನೇ ಪಡೆದುಕೊಳ್ಳುವುದಕ್ಕಾಗಿ ಓಡುತ್ತಿದ್ದೇನೆ. <verse eid="PHP 3:13"/><verse number="14" style="v" sid="PHP 3:14"/>ಹೀಗೆ ನಾನು ಕ್ರಿಸ್ತ ಯೇಸುವಿನಲ್ಲಿ ದೇವರ ಸ್ವರ್ಗೀಯ ಕರೆಯ ಬಹುಮಾನದ ಗುರಿಯೆಡೆಗೆ ಮುಂದೆ ಸಾಗುತ್ತಾ ಇದ್ದೇನೆ.<verse eid="PHP 3:14"/></para>
  <para style="s1">ಪೌಲನ ಮಾದರಿಯನ್ನು ಅನುಸರಿಸುವುದು</para>
  <para style="p">
    <verse number="15" style="v" sid="PHP 3:15"/>ಆದ್ದರಿಂದ ನಮ್ಮಲ್ಲಿ ಆತ್ಮಿಕ ಪರಿಪಕ್ವತೆಯುಳ್ಳವರು ಇದೇ ಮನೋಭಾವವುಳ್ಳವರಾಗಿರಬೇಕು. ಕೆಲವು ವಿಷಯಗಳ ಮೇಲೆ ಭಿನ್ನಾಭಿಪ್ರಾಯವಿದ್ದರೆ, ಅದನ್ನೂ ದೇವರು ನಿಮಗೆ ಸ್ಪಷ್ಟಪಡಿಸುವರು. <verse eid="PHP 3:15"/><verse number="16" style="v" sid="PHP 3:16"/>ಆದರೂ ಈಗಾಗಲೇ ನಾವು ಯಾವುದರಲ್ಲಿ ಮುಂದುವರೆದಿದ್ದೇವೋ ಆ ಸೂತ್ರದ ಪ್ರಕಾರ ಒಂದೇ ಮನಸ್ಸುಳ್ಳವರಾಗಿ ಬಾಳೋಣ.<verse eid="PHP 3:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="PHP 3:17"/>ಪ್ರಿಯರೇ, ನೀವು ನನ್ನನ್ನು ಅನುಸರಿಸುವವರಾಗಿರಿ. ನಮ್ಮ ಹಾಗೆ ಬಾಳುವ ಆದರ್ಶದ ಪ್ರಕಾರ ನಡೆದುಕೊಳ್ಳುವವರನ್ನು ಗಮನಿಸಿರಿ. <verse eid="PHP 3:17"/><verse number="18" style="v" sid="PHP 3:18"/>ಅನೇಕರು ಕ್ರಿಸ್ತನ ಶಿಲುಬೆಗೆ ವಿರೋಧಿಗಳಾಗಿ ಬಾಳುತ್ತಿದ್ದಾರೆ. ಅವರ ವಿಷಯದಲ್ಲಿ ನಾನು ನಿಮಗೆ ಹಲವಾರು ಸಾರಿ ತಿಳಿಸಿರುವಂತೆ ಈಗಲೂ ಕಣ್ಣೀರಿನಿಂದ ಹೇಳುತ್ತೇನೆ. <verse eid="PHP 3:18"/><verse number="19" style="v" sid="PHP 3:19"/>ವಿನಾಶನವೇ ಅವರ ಅಂತ್ಯವು. ಹೊಟ್ಟೆಯೇ ಅವರ ದೇವರು. ನಾಚಿಕೆ ಕಾರ್ಯಗಳಲ್ಲಿಯೇ ಅವರ ಪ್ರಭಾವ. ಅವರು ಲೌಕಿಕವಾದವುಗಳ ಮೇಲೆ ಮನಸ್ಸಿಡುತ್ತಾರೆ. <verse eid="PHP 3:19"/><verse number="20" style="v" sid="PHP 3:20"/>ಆದರೆ ನಮ್ಮ ಪೌರತ್ವವು ಪರಲೋಕದಲ್ಲಿದೆ. ನಾವು ಪರಲೋಕದಿಂದಲೇ ರಕ್ಷಕರಾಗಿರುವ ಒಬ್ಬರ ಬರುವಿಕೆಗಾಗಿ ಆತುರದಿಂದ ಎದುರುನೋಡುತ್ತಿದ್ದೇವೆ. ಅವರೇ ಕರ್ತದೇವರು ಆಗಿರುವ ಕ್ರಿಸ್ತ ಯೇಸು. <verse eid="PHP 3:20"/><verse number="21" style="v" sid="PHP 3:21"/>ಹೀಗೆ ಕ್ರಿಸ್ತ ಯೇಸು ಎಲ್ಲವನ್ನೂ ತಮಗೆ ಅಧೀನ ಮಾಡಿಕೊಳ್ಳುವ ತಮ್ಮ ಶಕ್ತಿಯ ಪ್ರಕಾರ, ಮಹಿಮೆಯುಳ್ಳ ತಮ್ಮ ದೇಹಕ್ಕೆ ಸಮವಾಗಿ ಸಾರೂಪ್ಯವಾಗುವಂತೆ ದೀನಾವಸ್ಥೆಯುಳ್ಳ ನಮ್ಮ ದೇಹವನ್ನು ರೂಪಾಂತರಪಡಿಸುವರು.<verse eid="PHP 3:21"/></para>
  <chapter eid="PHP 3"/>
  <chapter number="4" style="c" sid="PHP 4"/>
  <para style="s1">ಸ್ಥಿರತೆ ಮತ್ತು ಐಕ್ಯತೆಗೆ ಮುಕ್ತಾಯ ಬೇಡಿಕೆ</para>
  <para style="p">
    <verse number="1" style="v" sid="PHP 4:1"/>ಹೀಗಿರಲಾಗಿ, ನನಗೆ ಆಪ್ತರೂ ನಾನು ಹಂಬಲಿಸುವವರೂ ಆದ ನನ್ನ ಪ್ರಿಯರೇ, ನನ್ನ ಆನಂದವೂ ಕಿರೀಟವೂ ಆಗಿರುವ ಸ್ನೇಹಿತರೇ, ಈಗಲೂ ಕರ್ತ ದೇವರಲ್ಲಿ ದೃಢವಾಗಿ ನಿಲ್ಲಿರಿ!<verse eid="PHP 4:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="PHP 4:2"/>ಕರ್ತ ದೇವರಲ್ಲಿ ಒಂದೇ ಮನಸ್ಸುಳ್ಳವರಾಗಿರಬೇಕೆಂದು ಯುವೊದ್ಯಳನ್ನೂ ಸಂತುಕೆಯನ್ನೂ ಬೇಡಿಕೊಳ್ಳುತ್ತೇನೆ. <verse eid="PHP 4:2"/><verse number="3" style="v" sid="PHP 4:3"/>ಜೀವಗ್ರಂಥದಲ್ಲಿ ಹೆಸರು ಬರೆದಿರುವ ಕ್ಲೇಮೆನ್ಸ್ ಮುಂತಾದ ನನ್ನ ಜೊತೆ ಕೆಲಸದವರೊಡನೆ ನನ್ನೊಂದಿಗೆ ಸುವಾರ್ತೆಗೋಸ್ಕರ ಪ್ರಯಾಸಪಟ್ಟ ಆ ಸ್ತ್ರೀಯರಿಗೆ ನೀನೂ ಸಹಾಯಕನಾಗಿರಬೇಕೆಂದು ನಿಜ ಜೊತೆಗಾರನೇ, ನಿನ್ನನ್ನೂ ಕೇಳಿಕೊಳ್ಳುತ್ತೇನೆ.<verse eid="PHP 4:3"/></para>
  <para style="s1">ಅಂತಿಮ ಪ್ರಬೋಧನೆಗಳು</para>
  <para style="p">
    <verse number="4" style="v" sid="PHP 4:4"/>ಯಾವಾಗಲೂ ಕರ್ತ ದೇವರಲ್ಲಿ ಆನಂದಿಸಿರಿ, ಆನಂದಪಡಿರಿ ಎಂದು ಮತ್ತೆ ಹೇಳುತ್ತೇನೆ. <verse eid="PHP 4:4"/><verse number="5" style="v" sid="PHP 4:5"/>ನಿಮ್ಮ ಸಹನೆಯು ಎಲ್ಲರಿಗೂ ತಿಳಿದಿರಲಿ. ಕರ್ತದೇವರ ಬರುವಿಕೆಯು ಹತ್ತಿರವಾಗಿದೆ. <verse eid="PHP 4:5"/><verse number="6" style="v" sid="PHP 4:6"/>ಯಾವ ವಿಷಯವಾಗಿಯೂ ಚಿಂತೆ ಮಾಡದೆ, ಸರ್ವ ವಿಷಯದಲ್ಲಿ ಕೃತಜ್ಞತಾಸ್ತುತಿಯೊಡನೆ ಪ್ರಾರ್ಥನೆ ವಿಜ್ಞಾಪನೆಗಳನ್ನು ಮಾಡುತ್ತಾ ನಿಮ್ಮ ಬೇಡಿಕೆಯನ್ನು ದೇವರಿಗೆ ಸಮರ್ಪಿಸಿರಿ. <verse eid="PHP 4:6"/><verse number="7" style="v" sid="PHP 4:7"/>ಆಗ ಎಲ್ಲಾ ಗ್ರಹಿಕೆಯನ್ನೂ ಮೀರುವ ದೇವರ ಸಮಾಧಾನವು ನಿಮ್ಮ ಹೃದಯಗಳನ್ನೂ ಯೋಚನೆಗಳನ್ನೂ ಕ್ರಿಸ್ತ ಯೇಸುವಿನಲ್ಲಿ ಕಾಯುವುದು.<verse eid="PHP 4:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="PHP 4:8"/>ಕಡೆಯದಾಗಿ ಪ್ರಿಯರೇ, ಯಾವುದು ಸತ್ಯವೂ ಯಾವುದು ಮಾನ್ಯವೂ ಯಾವುದು ನ್ಯಾಯವೂ ಯಾವುದು ಶುದ್ಧವೂ ಯಾವುದು ಪ್ರೀತಿಕರವೂ ಯಾವುದು ಮನೋಹರವೂ ಯಾವುದು ಉತ್ತಮವಾದದ್ದೋ ಯಾವುದು ಕೀರ್ತಿಗೆ ಯೋಗ್ಯವೋ ಅವೆಲ್ಲವುಗಳನ್ನೇ ಆಲೋಚಿಸಿರಿ. <verse eid="PHP 4:8"/><verse number="9" style="v" sid="PHP 4:9"/>ನೀವು ಯಾವುದನ್ನು ನನ್ನಿಂದ ಕಲಿತು ಹೊಂದಿದ್ದೀರೋ ಮತ್ತು ಯಾವುದನ್ನು ನನ್ನಲ್ಲಿ ಕೇಳಿ ಕಂಡಿದ್ದೀರೋ ಅದನ್ನೇ ಮಾಡುವವರಾಗಿರಿ. ಆಗ ಸಮಾಧಾನದ ದೇವರು ನಿಮ್ಮೊಂದಿಗಿರುವರು.<verse eid="PHP 4:9"/></para>
  <para style="s1">ಉಡುಗೊರೆಗಳಿಗಾಗಿ ಧನ್ಯವಾದಗಳು</para>
  <para style="p">
    <verse number="10" style="v" sid="PHP 4:10"/>ಅಂತೂ ಕೊನೆಯದಾಗಿ ನನ್ನ ಬಗ್ಗೆ ನಿಮಗಿರುವ ಆಸಕ್ತಿಯು ಪುನಃ ಚಿಗುರಿದ್ದಕ್ಕಾಗಿ ಕರ್ತ ದೇವರಲ್ಲಿ ಬಹಳವಾಗಿ ಆನಂದಿಸುತ್ತೇನೆ. ನೀವು ನನ್ನ ಬಗ್ಗೆ ಆಸಕ್ತಿ ಮೊದಲಿನಿಂದ ಹೊಂದಿದ್ದರೂ ಅದನ್ನು ತೋರಿಸಲು ನಿಮಗೆ ಸೂಕ್ತ ಅವಕಾಶ ಸಿಕ್ಕಿರಲಿಲ್ಲ. <verse eid="PHP 4:10"/><verse number="11" style="v" sid="PHP 4:11"/>ನನಗೆ ಕೊರತೆಯಿದೆ ಎಂಬುದಕ್ಕಾಗಿ ನಾನು ಇದನ್ನು ಹೇಳುತ್ತಿಲ್ಲ. ಯಾವುದೇ ಪರಿಸ್ಥಿತಿಯಲ್ಲಿ ಸಂತೃಪ್ತನಾಗಿರುವುದನ್ನು ನಾನು ಕಲಿತುಕೊಂಡಿದ್ದೇನೆ. <verse eid="PHP 4:11"/><verse number="12" style="v" sid="PHP 4:12"/>ಕೊರತೆಯಲ್ಲಾಗಲಿ, ಸಮೃದ್ಧಿಯಲ್ಲಾಗಲಿ ಹೇಗೆ ಜೀವಿಸಬೇಕೆಂಬ ಅನುಭವವನ್ನು ತಿಳಿದುಕೊಂಡಿದ್ದೇನೆ. ಚೆನ್ನಾಗಿ ಊಟಮಾಡಿರಲಿ, ಹಸಿವೆಯಿಂದಿರಲಿ, ಸಮೃದ್ಧಿಯುಳ್ಳವನಾಗಿರಲಿ, ಕೊರತೆಯುಳ್ಳವನಾಗಿರಲಿ, ಯಾವುದೇ ಪರಿಸ್ಥಿತಿಯಲ್ಲಿದ್ದರೂ ಎಲ್ಲಾ ಪರಿಸ್ಥಿತಿಗಳಲ್ಲಿ ತೃಪ್ತನಾಗಿರುವ ರಹಸ್ಯವನ್ನು ಕಲಿತುಕೊಂಡಿದ್ದೇನೆ. <verse eid="PHP 4:12"/><verse number="13" style="v" sid="PHP 4:13"/>ನನಗೆ ಶಕ್ತಿನೀಡುವ ಕ್ರಿಸ್ತ ಯೇಸುವಿನ ಮೂಲಕ ನಾನು ಎಲ್ಲವನ್ನೂ ಮಾಡಲು ಶಕ್ತನಾಗಿದ್ದೇನೆ.<verse eid="PHP 4:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="PHP 4:14"/>ಹೀಗಿದ್ದರೂ, ನನ್ನ ತೊಂದರೆಗಳಲ್ಲಿ ನೀವು ಭಾಗವಹಿಸಿದ್ದು ಒಳ್ಳೆಯದಾಯಿತು. <verse eid="PHP 4:14"/><verse number="15" style="v" sid="PHP 4:15"/>ಫಿಲಿಪ್ಪಿಯವರೇ, ನಾನು ಪ್ರಾರಂಭ ದಿನಗಳಲ್ಲಿ ನಿಮ್ಮ ನಡುವೆ ಸುವಾರ್ತೆ ಸಾರಿ ಮಕೆದೋನ್ಯದಿಂದ ಹೊರಟುಹೋದಾಗ, ನಿಮ್ಮನ್ನು ಬಿಟ್ಟು ಬೇರಾವ ಸಭೆಯವರು ಕೊಡುವ ಮತ್ತು ತೆಗೆದುಕೊಳ್ಳುವ ವಿಷಯದಲ್ಲಿ ಯಾರೂ ನನ್ನೊಂದಿಗೆ ಪಾಲುಗಾರರಾಗಲಿಲ್ಲ ಎಂಬುದನ್ನು ನೀವು ತಿಳಿದುಕೊಂಡಿದ್ದೀರಿ. <verse eid="PHP 4:15"/><verse number="16" style="v" sid="PHP 4:16"/>ನಾನು ಥೆಸಲೋನಿಕದಲ್ಲಿದ್ದಾಗಲೂ ನನಗೆ ಕೊರತೆಯಾದಾಗ ನೀವು ಒಂದೆರಡು ಬಾರಿ ಸಹಾಯ ಕಳುಹಿಸಿದಿರಿ. <verse eid="PHP 4:16"/><verse number="17" style="v" sid="PHP 4:17"/>ನಾನು ನಿಮ್ಮಿಂದ ದಾನವನ್ನು ನಿರೀಕ್ಷಿಸುವುದಿಲ್ಲ. ಆದರೆ ನಿಮ್ಮ ಲೆಕ್ಕಕ್ಕೆ ಲಾಭ ಹೆಚ್ಚಿಸುವುದನ್ನೇ ನೋಡುತ್ತಿದ್ದೇನೆ. <verse eid="PHP 4:17"/><verse number="18" style="v" sid="PHP 4:18"/>ನಾನು ಎಲ್ಲವನ್ನೂ ಪರಿಪೂರ್ಣವಾಗಿ ಹೊಂದಿದ್ದೇನೆ. ನನಗೆ ಅಗತ್ಯಕ್ಕಿಂತಲೂ ಹೆಚ್ಚು ದೊರೆತಿದೆ. ನೀವು ಎಪಫ್ರೊದೀತನಿಂದ ಕಳುಹಿಸುವವುಗಳು ಈಗ ನನಗೆ ತಲುಪಿದೆ; ನಿಮ್ಮ ಕೊಡುಗೆ ದೇವರನ್ನು ಮೆಚ್ಚಿಸುವ ಸುಗಂಧ ಕಾಣಿಕೆಯೂ ಸ್ವೀಕೃತವಾದ ಯಜ್ಞವೂ ಆಗಿರುತ್ತವೆ. <verse eid="PHP 4:18"/><verse number="19" style="v" sid="PHP 4:19"/>ನನ್ನ ದೇವರು, ಕ್ರಿಸ್ತ ಯೇಸುವಿನಲ್ಲಿರುವ ತಮ್ಮ ಮಹಿಮೆಯ ಐಶ್ವರ್ಯಕ್ಕೆ ತಕ್ಕಂತೆಯೇ ನಿಮ್ಮ ಎಲ್ಲಾ ಕೊರತೆಗಳನ್ನು ನೀಗಿಸುವರು.<verse eid="PHP 4:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="PHP 4:20"/>ನಮ್ಮ ತಂದೆ ದೇವರಿಗೆ ನಿರಂತರವೂ ಮಹಿಮೆಯಾಗಲಿ. ಆಮೆನ್.<verse eid="PHP 4:20"/></para>
  <para style="b"/>
  <para style="s1">ಅಂತಿಮ ವಂದನೆಗಳು</para>
  <para style="p">
    <verse number="21" style="v" sid="PHP 4:21"/>ಕ್ರಿಸ್ತ ಯೇಸುವಿನಲ್ಲಿರುವ ಎಲ್ಲಾ ದೇವಜನರಿಗೂ ವಂದನೆಗಳನ್ನು ಹೇಳಿರಿ.</para>
  <para style="p" vid="PHP 4:21">ನನ್ನ ಜೊತೆಯಲ್ಲಿರುವ ಸಹೋದರರೂ ಸಹೋದರಿಯರೂ ವಂದನೆಗಳನ್ನು ತಿಳಿಸುತ್ತಾರೆ.<verse eid="PHP 4:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="PHP 4:22"/>ಎಲ್ಲಾ ದೇವಜನರೂ ವಿಶೇಷವಾಗಿ ಕೈಸರನ ಮನೆತನಕ್ಕೆ ಸೇರಿದವರೂ ನಿಮಗೆ ವಂದನೆಗಳನ್ನು ತಿಳಿಸುತ್ತಾರೆ.<verse eid="PHP 4:22"/></para>
  <para style="b"/>
  <para style="p">
    <verse number="23" style="v" sid="PHP 4:23"/>ಕರ್ತದೇವರು ಆಗಿರುವ ಕ್ರಿಸ್ತ ಯೇಸುವಿನ ಕೃಪೆಯು ನಿಮ್ಮ ಆತ್ಮದೊಂದಿಗೆ ಇರಲಿ. ಆಮೆನ್.<verse eid="PHP 4:23"/></para>
  <chapter eid="PHP 4"/>
</usx>
