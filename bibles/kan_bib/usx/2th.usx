<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="2TH" style="id">- Biblica® Open Kannada Contemporary Version</book>
  <para style="h">2 ಥೆಸಲೋನಿಕದವರಿಗೆ</para>
  <para style="toc1">ಥೆಸಲೋನಿಕದವರಿಗೆ ಪೌಲನು ಬರೆದ ಎರಡನೆಯ ಪತ್ರಿಕೆ</para>
  <para style="toc2">2 ಥೆಸಲೋನಿಕದವರಿಗೆ</para>
  <para style="toc3">2 ಥೆಸ</para>
  <para style="mt1">ಥೆಸಲೋನಿಕದವರಿಗೆ</para>
  <para style="mt2">ಪೌಲನು ಬರೆದ ಎರಡನೆಯ ಪತ್ರಿಕೆ</para>
  <chapter number="1" style="c" sid="2TH 1"/>
  <para style="p">
    <verse number="1" style="v" sid="2TH 1:1"/>ನಮ್ಮ ತಂದೆ ದೇವರಲ್ಲಿಯೂ,</para>
  <para style="b" vid="2TH 1:1"/>
  <para style="p" vid="2TH 1:1">ನಮಗೆ ಕರ್ತ ಆಗಿರುವ ಯೇಸು ಕ್ರಿಸ್ತರಲ್ಲಿಯೂ ಇರುವ ಥೆಸಲೋನಿಕದವರ ಸಭೆಗೆ ಪೌಲ, ಸಿಲ್ವಾನ, ತಿಮೊಥೆಯರು ಬರೆಯುವುದು:<verse eid="2TH 1:1"/></para>
  <para style="b"/>
  <para style="p">
    <verse number="2" style="v" sid="2TH 1:2"/>ನಮ್ಮ ತಂದೆ ದೇವರಿಂದಲೂ ನಮಗೆ ಕರ್ತ ಆಗಿರುವ ಯೇಸು ಕ್ರಿಸ್ತರಿಂದಲೂ ನಿಮಗೆ ಕೃಪೆಯೂ ಸಮಾಧಾನವೂ ಉಂಟಾಗಲಿ.<verse eid="2TH 1:2"/></para>
  <para style="b"/>
  <para style="s1">ಕೃತಜ್ಞತಾಸ್ತುತಿ ಹಾಗೂ ಪ್ರಾರ್ಥನೆ</para>
  <para style="p">
    <verse number="3" style="v" sid="2TH 1:3"/>ಪ್ರಿಯರೇ, ನಾವು ಯಾವಾಗಲೂ ನಿಮಗಾಗಿ ದೇವರಿಗೆ ಕೃತಜ್ಞತೆಯನ್ನು ಸಲ್ಲಿಸಲು ಬದ್ಧರಾಗಿದ್ದೇವೆ. ಹಾಗೆ ಮಾಡುವುದು ಯೋಗ್ಯ. ಏಕೆಂದರೆ ನಿಮ್ಮ ವಿಶ್ವಾಸವು ಹೆಚ್ಚೆಚ್ಚಾಗಿ ಅಭಿವೃದ್ಧಿಯಾಗುತ್ತಾ ಇದೆ ಮತ್ತು ಪರಸ್ಪರ ನಿಮ್ಮೆಲ್ಲರಲ್ಲಿ ಪ್ರೀತಿಯೂ ಹೆಚ್ಚುತ್ತಿದೆ. <verse eid="2TH 1:3"/><verse number="4" style="v" sid="2TH 1:4"/>ಹೀಗಿರುವುದರಿಂದ, ನೀವು ಸಹಿಸುತ್ತಿರುವ ನಿಮ್ಮ ಎಲ್ಲಾ ಹಿಂಸೆಗಳಲ್ಲಿಯೂ ಸಂಕಟಗಳಲ್ಲಿಯೂ ನಿಮಗೆ ತೋರಿ ಬಂದ ನಿಮ್ಮ ತಾಳ್ಮೆ, ನಂಬಿಕೆಗಳನ್ನು ನೆನೆಸಿ ನಿಮ್ಮ ವಿಷಯವಾಗಿ ದೇವರ ಸಭೆಗಳಲ್ಲಿ ನಾವೇ ಹೆಮ್ಮೆಪಡುತ್ತೇವೆ.<verse eid="2TH 1:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="2TH 1:5"/>ನೀವು ಯಾವ ದೇವರ ರಾಜ್ಯಕ್ಕಾಗಿ ಕಷ್ಟವನ್ನು ಅನುಭವಿಸುತ್ತಿರುವಿರೋ, ಆ ರಾಜ್ಯಕ್ಕಾಗಿ ನೀವು ಯೋಗ್ಯರೆಂದು ಎಣಿಕೆಯಾಗಲು ಇದು ದೇವರ ನೀತಿಯುಳ್ಳ ನ್ಯಾಯತೀರ್ಪಿಗೆ ಸ್ಪಷ್ಟವಾದ ನಿದರ್ಶನವಾಗಿದೆ. <verse eid="2TH 1:5"/><verse number="6" style="v" sid="2TH 1:6"/>ನಿಮ್ಮನ್ನು ಸಂಕಟ ಪಡಿಸುವವರಿಗೆ ದೇವರು ಪ್ರತಿಯಾಗಿ ಸಂಕಟವನ್ನೂ ಮತ್ತು <verse eid="2TH 1:6"/><verse number="7" style="v" sid="2TH 1:7"/>ಸಂಕಟ ಪಡುವವರಾದ ನಿಮಗೆ ನಮ್ಮೊಡನೆ ಉಪಶಮನವನ್ನೂ ಕೊಡುವುದು ದೇವರಿಗೆ ನ್ಯಾಯವಾಗಿದೆ. ನಮಗೆ ಕರ್ತ ಆಗಿರುವ ಯೇಸು ತಮ್ಮ ಶಕ್ತಿಯುತವಾದ ದೂತರೊಂದಿಗೆ ಪರಲೋಕದಿಂದ ಪ್ರಜ್ವಲಿಸುವ ಜ್ವಾಲೆಯಲ್ಲಿ ಪ್ರತ್ಯಕ್ಷರಾಗುವಾಗ ಇದಾಗುವುದು. <verse eid="2TH 1:7"/><verse number="8" style="v" sid="2TH 1:8"/>ಅವರು ದೇವರನ್ನು ಅರಿಯದವರಿಗೂ ನಮಗೆ ಕರ್ತ ಆಗಿರುವ ಯೇಸುವಿನ ಸುವಾರ್ತೆಗೆ ಅವಿಧೇಯರಾದವರಿಗೂ ಪ್ರತೀಕಾರ ಮಾಡುವರು. <verse eid="2TH 1:8"/><verse number="9" style="v" sid="2TH 1:9"/>ಅಂಥವರು ಕರ್ತ ಯೇಸುವಿನ ಸನ್ನಿಧಿಯಿಂದಲೂ ಅವರ ಮಹಿಮೆಯ ಬಲದಿಂದಲೂ ಬಹಿಷ್ಕೃತರಾಗಿ ನಿತ್ಯನಾಶದ ಶಿಕ್ಷೆಯನ್ನು ಅನುಭವಿಸುವರು. <verse eid="2TH 1:9"/><verse number="10" style="v" sid="2TH 1:10"/>ಆ ದಿನದಲ್ಲಿ ಕರ್ತ ಯೇಸು ತಮ್ಮ ಪರಿಶುದ್ಧ ಜನರಲ್ಲಿ ಮಹಿಮೆ ಹೊಂದುವವರಾಗಿಯೂ ನಂಬುವವರೆಲ್ಲರನ್ನು ಆಶ್ಚರ್ಯಪಡಿಸುವವರಾಗಿಯೂ ಬರುವರು. ನಮ್ಮ ಸಾಕ್ಷಿಯನ್ನು ನಂಬಿದ್ದರಿಂದ ನಿಮಗೂ ಇವು ಸಂಭವಿಸುವುವು.<verse eid="2TH 1:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="2TH 1:11"/>ನಮ್ಮ ದೇವರು ನೀಡಿರುವ ಕರೆಯುವಿಕೆಗೆ ನಿಮ್ಮನ್ನು ಯೋಗ್ಯರೆಂದು ಎಣಿಸಿ, ಒಳಿತನ್ನು ಮಾಡಲು ನಿಮ್ಮ ಎಲ್ಲಾ ಇಷ್ಟಾರ್ಥವನ್ನೂ ವಿಶ್ವಾಸದಿಂದ ಆಗಿರುವ ನಿಮ್ಮ ಎಲ್ಲಾ ಕಾರ್ಯಗಳನ್ನೂ ದೇವರು ತಮ್ಮ ಶಕ್ತಿಯಿಂದ ಪರಿಪೂರ್ಣಗೊಳಿಸುವಂತೆ ನಾವು ಯಾವಾಗಲೂ ನಿಮಗೋಸ್ಕರ ಪ್ರಾರ್ಥನೆ ಮಾಡುತ್ತೇವೆ. <verse eid="2TH 1:11"/><verse number="12" style="v" sid="2TH 1:12"/>ನಮ್ಮ ದೇವರ ಹಾಗೂ ನಮಗೆ ಕರ್ತ ಆಗಿರುವ ಯೇಸುಕ್ರಿಸ್ತರ ಕೃಪೆಯ ಅನುಸಾರವಾಗಿ, ನಮಗೆ ಕರ್ತ ಆಗಿರುವ ಕ್ರಿಸ್ತ ಯೇಸುವಿನ ಹೆಸರು ನಿಮ್ಮಲ್ಲಿ ಮಹಿಮೆ ಹೊಂದಬೇಕು. ಮಾತ್ರವಲ್ಲದೇ ನೀವು ಕೂಡಾ ಅವರಲ್ಲಿ ಮಹಿಮೆ ಹೊಂದಬೇಕು ಎಂದು ಬೇಡಿಕೊಳ್ಳುತ್ತೇವೆ.<verse eid="2TH 1:12"/></para>
  <chapter eid="2TH 1"/>
  <chapter number="2" style="c" sid="2TH 2"/>
  <para style="s1">ಕರ್ತ ಯೇಸುವಿನ ದಿನವೂ ನಿಯಮ ಮೀರುವ ಮನುಷ್ಯನೂ</para>
  <para style="p">
    <verse number="1" style="v" sid="2TH 2:1"/>ಪ್ರಿಯರೇ, ನಮಗೆ ಕರ್ತ ಆಗಿರುವ ಯೇಸುಕ್ರಿಸ್ತರ ಬರುವಿಕೆಯನ್ನೂ ನಾವು ಅವರ ಸನ್ನಿಧಿಯಲ್ಲಿ ಒಂದಾಗಿ ಸೇರುವ ವಿಷಯವನ್ನೂ ಕುರಿತು ನಾವು ನಿಮ್ಮನ್ನು ಬೇಡಿಕೊಳ್ಳುವುದೇನೆಂದರೆ: <verse eid="2TH 2:1"/><verse number="2" style="v" sid="2TH 2:2"/>ಕ್ರಿಸ್ತ ಯೇಸುವಿನ ದಿನವು ಈಗಾಗಲೇ ಬಂದಿದೆಯೆಂದು ಪ್ರವಾದನೆಯಿಂದಾಗಲಿ, ಪ್ರಸಂಗದಿಂದಾಗಲಿ ಅಥವಾ ನಮ್ಮ ಪತ್ರದಿಂದಾಗಲಿ ತಿಳಿದು ನೀವು ಬೇಗನೆ ಚಂಚಲರಾಗಿ ಕಳವಳಪಡಬೇಡಿರಿ. <verse eid="2TH 2:2"/><verse number="3" style="v" sid="2TH 2:3"/>ನಿಮ್ಮನ್ನು ಯಾರೂ ಯಾವ ವಿಧದಲ್ಲಿಯೂ ವಂಚಿಸದಿರಲಿ. ಏಕೆಂದರೆ ವಿಶ್ವಾಸದಿಂದ ಬಿದ್ದುಹೋಗುವಿಕೆಯು ಸಂಭವಿಸಿ, ನಾಶಕ್ಕೆ ನೇಮಕವಾಗಿರುವ ನಿಯಮ ಮೀರುವ ಮನುಷ್ಯನು ಬರುವುದಕ್ಕೆ ಮುಂಚೆ ಕರ್ತ ಯೇಸುವಿನ ದಿನವು ಬರುವುದಿಲ್ಲ! <verse eid="2TH 2:3"/><verse number="4" style="v" sid="2TH 2:4"/>ದೇವರೆಣಿಸಿಕೊಳ್ಳುವ ಎಲ್ಲವನ್ನೂ ಆರಾಧಿಸಲಾಗುವ ಪ್ರತಿಯೊಂದನ್ನೂ ಅವನು ವಿರೋಧಿಸಿ ನಿಲ್ಲುವನು. ದೇವರಿಗೆ ಸಂಬಂಧಿಸಿದ ಇವೆಲ್ಲವುಗಳ ಮೇಲೆ ತನ್ನನ್ನು ಹೆಚ್ಚಿಸಿಕೊಳ್ಳುವನು. ತಾನೇ ದೇವರೆಂದು ಘೋಷಿಸಿ ದೇವರ ಆಲಯದಲ್ಲಿ ಕೂತುಕೊಳ್ಳುವನು.<verse eid="2TH 2:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="2TH 2:5"/>ನಾನು ನಿಮ್ಮ ಸಂಗಡ ಇರುವಾಗ ಈ ಸಂಗತಿಗಳನ್ನು ನಿಮಗೆ ಹೇಳಿದ್ದು ಜ್ಞಾಪಕವಿಲ್ಲವೋ? <verse eid="2TH 2:5"/><verse number="6" style="v" sid="2TH 2:6"/>ಇದಲ್ಲದೆ ಅವನು ನಿಯಮಿತ ಕಾಲದಲ್ಲಿ ಮಾತ್ರ ಕಾಣಿಸಿಕೊಳ್ಳುವಂತೆ ಈಗ ಅವನನ್ನು ಏನು ಅಡ್ಡಿಮಾಡುತ್ತಿದೆಯೋ ಅದನ್ನು ನೀವೇ ಬಲ್ಲಿರಿ. <verse eid="2TH 2:6"/><verse number="7" style="v" sid="2TH 2:7"/>ಏಕೆಂದರೆ, ನಿಯಮ ಮೀರುವ ರಹಸ್ಯ ಶಕ್ತಿಯು ಈಗಾಗಲೇ ಕಾರ್ಯಮಾಡುತ್ತಿದೆ. ಅವನನ್ನು ದಾರಿಯಿಂದ ತೆಗೆಯುವವರೆಗೆ ಈಗ ಅಡ್ಡಿಮಾಡುವಾತನು ಅಡ್ಡಿ ಮಾಡುತ್ತಲೇ ಇರುವನು. <verse eid="2TH 2:7"/><verse number="8" style="v" sid="2TH 2:8"/>ಆಗ ಆ ನಿಯಮ ಮೀರುವವನು ಪ್ರತ್ಯಕ್ಷನಾಗುವನು. ಅವನನ್ನು ಕರ್ತ ಯೇಸು ತಮ್ಮ ಬಾಯಿಯ ಶ್ವಾಸದಿಂದ ಕೆಡವಿ, ತಮ್ಮ ಪ್ರತ್ಯಕ್ಷತೆಯ ಮಹಿಮೆಯಿಂದ ನಾಶಮಾಡಿಬಿಡುವರು. <verse eid="2TH 2:8"/><verse number="9" style="v" sid="2TH 2:9"/>ಆ ನಿಯಮ ಮೀರುವವನ ಬರುವಿಕೆಯು ಸೈತಾನನ ಕಾರ್ಯಗಳಿಗೆ ಅನುಸಾರವಾಗಿರುವುದು. ಅವು ಎಲ್ಲಾ ಶಕ್ತಿಯ ಪ್ರದರ್ಶನದಿಂದಲೂ ಸುಳ್ಳಾದ ಸೂಚಕಕಾರ್ಯಗಳಿಂದಲೂ ಅದ್ಭುತಕಾರ್ಯಗಳಿಂದಲೂ ಇರುವವು. <verse eid="2TH 2:9"/><verse number="10" style="v" sid="2TH 2:10"/>ಎಲ್ಲಾ ವಿಧವಾದ ದುಷ್ಟತನದ ವಂಚನೆಯಿಂದಲೂ ಕೂಡಿ ನಾಶವಾಗುವವರಲ್ಲಿ ಇದು ಸಂಭವಿಸುವುದು. ಏಕೆಂದರೆ ಅವರು ರಕ್ಷಣೆ ಹೊಂದುವಂತೆ ಸತ್ಯವನ್ನು ಪ್ರೀತಿಸಲು ನಿರಾಕರಿಸಿದ ಕಾರಣದಿಂದ ನಾಶವಾಗಿ ಹೋಗುವರು. <verse eid="2TH 2:10"/><verse number="11" style="v" sid="2TH 2:11"/>ಇದೇ ಕಾರಣದಿಂದ ದೇವರು ಅವರ ಮೇಲೆ ವಂಚಿಸಲು ಶಕ್ತಿಯುಳ್ಳ ಭ್ರಮೆಯನ್ನು ಕಳುಹಿಸಿ ಅವರು ಆ ಸುಳ್ಳನ್ನು ನಂಬುವಂತೆ ಮಾಡುವರು. <verse eid="2TH 2:11"/><verse number="12" style="v" sid="2TH 2:12"/>ಸತ್ಯವನ್ನು ನಂಬದೆ ಅನೀತಿಯಲ್ಲಿ ಆನಂದಿಸುವವರೆಲ್ಲರೂ ಈ ಪ್ರಕಾರ ತೀರ್ಪಿಗೆ ಗುರಿಯಾಗುವರು.<verse eid="2TH 2:12"/></para>
  <para style="s1">ದೃಢವಾಗಿ ನಿಲ್ಲಿರಿ</para>
  <para style="p">
    <verse number="13" style="v" sid="2TH 2:13"/>ಕರ್ತ ಯೇಸುವಿಗೆ ಪ್ರಿಯರಾಗಿರುವವರೇ, ನಾವು ನಿಮ್ಮ ವಿಷಯದಲ್ಲಿ ಯಾವಾಗಲೂ ದೇವರಿಗೆ ಕೃತಜ್ಞತೆಯನ್ನು ಸಲ್ಲಿಸುತ್ತೇವೆ. ಏಕೆಂದರೆ, ನೀವು ಪವಿತ್ರಾತ್ಮ ದೇವರ ಶುದ್ಧೀಕರಣದಿಂದಲೂ ಸತ್ಯವನ್ನು ನಂಬುವುದರಿಂದಲೂ ರಕ್ಷಣೆಯನ್ನು ಹೊಂದಿ ಪ್ರಥಮ ಫಲವಾಗುವುದಕ್ಕೆ ದೇವರು ನಿಮ್ಮನ್ನು ಆದಿಯಿಂದ ಆರಿಸಿಕೊಂಡಿದ್ದಾರೆ. <verse eid="2TH 2:13"/><verse number="14" style="v" sid="2TH 2:14"/>ನಾವು ನಿಮಗೆ ತಿಳಿಸಿದ ಸುವಾರ್ತೆಯ ಮೂಲಕವಾಗಿ, ನೀವು ನಮಗೆ ಕರ್ತ ಆಗಿರುವ ಯೇಸುಕ್ರಿಸ್ತರ ಮಹಿಮೆಯನ್ನು ಸಂಪಾದಿಸಿಕೊಳ್ಳಬೇಕೆಂದು ದೇವರು ನಿಮ್ಮನ್ನು ಈ ಆಯ್ಕೆಗಾಗಿ ಕರೆದರು.<verse eid="2TH 2:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="2TH 2:15"/>ಹೀಗಿರುವುದರಿಂದ ಪ್ರಿಯರೇ, ದೃಢವಾಗಿ ನಿಲ್ಲಿರಿ. ನಾವು ಮಾತಿನಿಂದಾಗಲಿ, ಪತ್ರದಿಂದಾಗಲಿ ನಿಮಗೆ ಕಲಿಸಿದ ಬೋಧನೆಗಳನ್ನು ನೀವು ಭದ್ರವಾಗಿ ಪಾಲಿಸಿರಿ.<verse eid="2TH 2:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="2TH 2:16"/>ನಮಗೆ ಕರ್ತ ಆಗಿರುವ ಯೇಸು ಕ್ರಿಸ್ತರು ಹಾಗೂ ನಮ್ಮ ತಂದೆ ದೇವರು ನಮ್ಮನ್ನು ಪ್ರೀತಿಸಿ ಕೃಪೆಯಿಂದ ಕೊಟ್ಟಿರುವ ನಮಗೆ ನಿತ್ಯ ಆದರಣೆಯನ್ನೂ ಒಳ್ಳೆಯ ನಿರೀಕ್ಷೆಯನ್ನೂ ನೀಡಿ, <verse eid="2TH 2:16"/><verse number="17" style="v" sid="2TH 2:17"/>ನಿಮ್ಮ ಹೃದಯಗಳನ್ನು ಸಂತೈಸಿ, ಸಕಲ ಸದ್ವಾಕ್ಯದಲ್ಲಿಯೂ ಸತ್ಕಾರ್ಯದಲ್ಲಿಯೂ ದೃಢಪಡಿಸಲಿ.<verse eid="2TH 2:17"/></para>
  <chapter eid="2TH 2"/>
  <chapter number="3" style="c" sid="2TH 3"/>
  <para style="s1">ಪ್ರಾರ್ಥನೆಗಾಗಿ ಬೇಡಿಕೆ</para>
  <para style="p">
    <verse number="1" style="v" sid="2TH 3:1"/>ಕೊನೆಯದಾಗಿ ಪ್ರಿಯರೇ, ಕರ್ತ ಯೇಸುವಿನ ವಾಕ್ಯವು ನಿಮ್ಮಲ್ಲಿ ಹಬ್ಬಿದಂತೆ ಎಲ್ಲ ಕಡೆಗಳಲ್ಲಿಯೂ ಅತಿವೇಗದಿಂದ ಹಬ್ಬಿ ಹರಡುವಂತೆ ನಮಗಾಗಿ ಬೇಡಿಕೊಳ್ಳಿರಿ. <verse eid="2TH 3:1"/><verse number="2" style="v" sid="2TH 3:2"/>ವಕ್ರಬುದ್ಧಿಯುಳ್ಳ ದುಷ್ಟರ ಕೈಯಿಂದ ನಾವು ತಪ್ಪಿಸಿಕೊಳ್ಳುವಂತೆಯೂ ಪ್ರಾರ್ಥಿಸಿರಿ. ಏಕೆಂದರೆ ಎಲ್ಲರಲ್ಲಿಯೂ ವಿಶ್ವಾಸವಿಲ್ಲವಲ್ಲಾ. <verse eid="2TH 3:2"/><verse number="3" style="v" sid="2TH 3:3"/>ಆದರೆ ಕರ್ತ ಯೇಸು ನಂಬಿಗಸ್ತರು, ಅವರು ನಿಮ್ಮನ್ನು ದೃಢಪಡಿಸಿ ನಿಮ್ಮನ್ನು ಕೆಡುಕನಿಂದ ತಪ್ಪಿಸುವರು. <verse eid="2TH 3:3"/><verse number="4" style="v" sid="2TH 3:4"/>ನಾವು ನಿಮಗೆ ಆಜ್ಞಾಪಿಸಿದವುಗಳನ್ನು ನೀವು ಮಾಡುತ್ತೀರೆಂತಲೂ ಮುಂದೆಯೂ ಮಾಡುವಿರೆಂತಲೂ ನಿಮ್ಮ ವಿಷಯವಾಗಿ ಕರ್ತ ಯೇಸುವಿನಲ್ಲಿ ನಮಗೆ ಭರವಸೆಯಿದೆ. <verse eid="2TH 3:4"/><verse number="5" style="v" sid="2TH 3:5"/>ಕರ್ತ ಯೇಸು ದೇವರ ಪ್ರೀತಿಯಲ್ಲಿಯೂ ತಮ್ಮ ತಾಳ್ಮೆಯಲ್ಲಿಯೂ ನಿಮ್ಮ ಹೃದಯಗಳನ್ನು ನಡೆಸಲಿ.<verse eid="2TH 3:5"/></para>
  <para style="s1">ಸೋಮಾರಿತನದ ಬಗ್ಗೆ ಎಚ್ಚರಿಕೆ</para>
  <para style="p">
    <verse number="6" style="v" sid="2TH 3:6"/>ಪ್ರಿಯರೇ, ನಮಗೆ ಕರ್ತ ಆಗಿರುವ ಯೇಸುಕ್ರಿಸ್ತರ ಹೆಸರಿನಲ್ಲಿ ನಾವು ನಿಮಗೆ ಆಜ್ಞಾಪಿಸುವುದೇನೆಂದರೆ, ನಮ್ಮಿಂದ ಸ್ವೀಕರಿಸಿದ ಬೋಧನೆಯನ್ನು ಅನುಸರಿಸದೆ, ಸೋಮಾರಿಯಾಗಿ ಅಶಿಸ್ತಿನಿಂದ ನಡೆಯುವ ಪ್ರತಿ ವಿಶ್ವಾಸಿಗೆ ನೀವು ದೂರವಾಗಿರಬೇಕು. <verse eid="2TH 3:6"/><verse number="7" style="v" sid="2TH 3:7"/>ನೀವು ನಮ್ಮ ಮಾದರಿಯನ್ನು ಅನುಸರಿಸಿ ಹೇಗೆ ನಡೆಯಬೇಕೆಂದು ನೀವೇ ಬಲ್ಲಿರಿ. ಏಕೆಂದರೆ ನಾವು ನಿಮ್ಮಲ್ಲಿರುವಾಗ ಸೋಮಾರಿಗಳಾಗಿರಲಿಲ್ಲ. <verse eid="2TH 3:7"/><verse number="8" style="v" sid="2TH 3:8"/>ನಾವು ಉಚಿತವಾಗಿ ಯಾರ ಬಳಿಯಲ್ಲಿಯೂ ಊಟ ಮಾಡಲಿಲ್ಲ. ನಿಮ್ಮಲ್ಲಿ ಒಬ್ಬರಿಗೂ ನಾವು ಭಾರವಾಗಬಾರದೆಂದು ಹಗಲಿರುಳೂ ಕಷ್ಟದಿಂದಲೂ ಪ್ರಯಾಸದಿಂದಲೂ ದುಡಿದೆವು. <verse eid="2TH 3:8"/><verse number="9" style="v" sid="2TH 3:9"/>ನಿಮ್ಮಿಂದ ಪೋಷಣೆ ಹೊಂದುವುದಕ್ಕೆ ನಮಗೆ ಹಕ್ಕಿಲ್ಲವೆಂದಲ್ಲ. ನೀವು ನಮ್ಮನ್ನು ಅನುಸರಿಸುವುದಕ್ಕಾಗಿ ನಿಮಗೆ ಆದರ್ಶರಾಗಿರಬೇಕೆಂದು ಹಾಗೆ ಮಾಡಿದೆವು. <verse eid="2TH 3:9"/><verse number="10" style="v" sid="2TH 3:10"/>ನಾವು ನಿಮ್ಮ ಸಂಗಡ ಇದ್ದಾಗ, “ಕೆಲಸ ಮಾಡಲೊಲ್ಲದವನು ಉಣ್ಣಲೂಬಾರದು,” ಎಂದು ನಿಮಗೆ ಆಜ್ಞಾಪಿಸಿದ್ದೆವು.<verse eid="2TH 3:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="2TH 3:11"/>ಆದರೆ ನಿಮ್ಮಲ್ಲಿ ಕೆಲವರು ಯಾವ ಕೆಲಸವನ್ನೂ ಮಾಡದೆ ಇತರರ ಕೆಲಸದಲ್ಲಿ ಮಾತ್ರ ತಲೆಹಾಕಿ ಅಶಿಸ್ತಿನಿಂದ ನಡೆಯುತ್ತಾರೆಂದು ಕೇಳಿದ್ದೇವೆ. <verse eid="2TH 3:11"/><verse number="12" style="v" sid="2TH 3:12"/>ಅಂಥವರು ಶಾಂತವಾಗಿ ಕೆಲಸಮಾಡಿ ತಮ್ಮ ಸ್ವಂತ ಆಹಾರವನ್ನೇ ಊಟ ಮಾಡಬೇಕೆಂದು ನಮಗೆ ಕರ್ತ ಆಗಿರುವ ಯೇಸು ಕ್ರಿಸ್ತರಲ್ಲಿ ನಾವು ಆಜ್ಞಾಪಿಸಿ ಪ್ರಬೋಧಿಸುತ್ತೇವೆ. <verse eid="2TH 3:12"/><verse number="13" style="v" sid="2TH 3:13"/>ಪ್ರಿಯರೇ, ನೀವಾದರೋ ಒಳ್ಳೆಯದನ್ನು ಮಾಡುವುದರಲ್ಲಿ ಬೇಸರಗೊಳ್ಳಬೇಡಿರಿ.<verse eid="2TH 3:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="2TH 3:14"/>ಈ ಪತ್ರದ ಮೂಲಕ ಹೇಳಿರುವ ನಮ್ಮ ಮಾತಿಗೆ ಯಾರಾದರೂ ವಿಧೇಯರಾಗದಿದ್ದರೆ ಅಂಥವರನ್ನು ಗುರುತಿಸಿ ಅವರಿಗೆ ನಾಚಿಕೆಯಾಗುವಂತೆ ಅವರ ಸಹವಾಸದಲ್ಲಿ ಸೇರಬೇಡಿರಿ. <verse eid="2TH 3:14"/><verse number="15" style="v" sid="2TH 3:15"/>ಆದರೂ ಅಂಥವರನ್ನು ವೈರಿಯೆಂದು ಎಣಿಸದೆ, ಜೊತೆ ವಿಶ್ವಾಸಿಯೆಂದು ಭಾವಿಸಿ ಬುದ್ಧಿಹೇಳಿರಿ.<verse eid="2TH 3:15"/></para>
  <para style="b"/>
  <para style="s1">ಅಂತಿಮ ವಂದನೆಗಳು</para>
  <para style="p">
    <verse number="16" style="v" sid="2TH 3:16"/>ನಮಗೆ ಕರ್ತ ಆಗಿರುವ ಯೇಸು ಈ ಸಮಾಧಾನದಲ್ಲಿ ತಾವೇ ಸದಾಕಾಲದಲ್ಲಿಯೂ ಸಕಲ ವಿಧದಲ್ಲಿಯೂ ನಿಮಗೆ ಸಮಾಧಾನವನ್ನು ದಯಪಾಲಿಸಲಿ. ಕರ್ತದೇವರು ನಿಮ್ಮೆಲ್ಲರೊಂದಿಗೆ ಇರಲಿ.<verse eid="2TH 3:16"/></para>
  <para style="b"/>
  <para style="p">
    <verse number="17" style="v" sid="2TH 3:17"/>ಪೌಲನೆಂಬ ನಾನು ಸ್ವತಃ ನನ್ನ ಕೈಯಿಂದ ಬರೆದ ವಂದನೆಯಿದು. ನನ್ನ ಎಲ್ಲಾ ಪತ್ರಗಳಲ್ಲಿಯೂ ಇದೇ ಗುರುತು. ನಾನು ಹೀಗೆಯೇ ಬರೆಯುತ್ತೇನೆ.<verse eid="2TH 3:17"/></para>
  <para style="b"/>
  <para style="p">
    <verse number="18" style="v" sid="2TH 3:18"/>ನಮ್ಮ ಕರ್ತ ಆಗಿರುವ ಯೇಸುಕ್ರಿಸ್ತರ ಕೃಪೆಯು ನಿಮ್ಮೆಲ್ಲರ ಸಂಗಡ ಇರಲಿ.<verse eid="2TH 3:18"/></para>
  <chapter eid="2TH 3"/>
</usx>
