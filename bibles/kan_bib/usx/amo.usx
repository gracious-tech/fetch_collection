<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="AMO" style="id">- Biblica® Open Kannada Contemporary Version</book>
  <para style="h">ಆಮೋಸ</para>
  <para style="toc1">ಆಮೋಸ</para>
  <para style="toc2">ಆಮೋಸ</para>
  <para style="toc3">ಆಮೋ</para>
  <para style="mt1">ಆಮೋಸ</para>
  <chapter number="1" style="c" sid="AMO 1"/>
  <para style="p">
    <verse number="1" style="v" sid="AMO 1:1"/>ತೆಕೋವದ ಕುರುಬರಲ್ಲಿ ಒಬ್ಬನಾದ ಆಮೋಸನು, ಯೆಹೂದದ ಅರಸನಾದ ಉಜ್ಜೀಯನ ದಿವಸಗಳಲ್ಲಿಯೂ ಇಸ್ರಾಯೇಲಿನ ಅರಸನಾದ ಯೋವಾಷನ ಮಗ ಯಾರೊಬ್ಬಾಮನ ದಿವಸಗಳಲ್ಲಿಯೂ ಭೂಕಂಪಕ್ಕೆ ಎರಡು ವರ್ಷಗಳ ಮುಂಚೆ ಇಸ್ರಾಯೇಲಿನ ವಿಷಯವಾಗಿ ಕಂಡ ದರ್ಶನಗಳು.<verse eid="AMO 1:1"/></para>
  <para style="b"/>
  <para style="b"/>
  <para style="p">
    <verse number="2" style="v" sid="AMO 1:2"/>ಆಮೋಸನು ಹೇಳಿದ್ದೇನೆಂದರೆ:</para>
  <para style="q1" vid="AMO 1:2">“ಯೆಹೋವ ದೇವರು ಚೀಯೋನಿನಿಂದ ಗರ್ಜಿಸಿ,</para>
  <para style="q2" vid="AMO 1:2">ಯೆರೂಸಲೇಮಿನಿಂದ ತಮ್ಮ ಧ್ವನಿ ಗೈಯುವರು.</para>
  <para style="q1" vid="AMO 1:2">ಕುರುಬರ ಹುಲ್ಲುಗಾವಲುಗಳು ಬಾಡಿ ಹೋಗುತ್ತಿವೆ,</para>
  <para style="q2" vid="AMO 1:2">ಕರ್ಮೆಲಿನ ತುದಿಯ ಗಿಡಗಳು ಒಣಗಿ ಹೋಗುತ್ತವೆ.”<verse eid="AMO 1:2"/></para>
  <para style="s1">ಇಸ್ರಾಯೇಲಿನ ನೆರೆಯವರಿಗೆ ನ್ಯಾಯತೀರ್ಪು</para>
  <para style="p">
    <verse number="3" style="v" sid="AMO 1:3"/>ಯೆಹೋವ ದೇವರು ಹೀಗೆ ಹೇಳುತ್ತಾರೆ:</para>
  <para style="q1" vid="AMO 1:3">ದಮಸ್ಕದ ಜನರು ಮಾಡಿರುವ ಮೂರು ಹೌದು ನಾಲ್ಕು ಪಾಪಗಳಿಗಾಗಿ,</para>
  <para style="q2" vid="AMO 1:3">ಆಗಬೇಕಾದ ದಂಡನೆಯನ್ನು ನಾನು ತಪ್ಪಿಸುವುದೇ ಇಲ್ಲ.</para>
  <para style="q1" vid="AMO 1:3">ಏಕೆಂದರೆ ಕಬ್ಬಿಣದ ಬಡಿಗೆಯಿಂದ ಧಾನ್ಯಗಳನ್ನು ಒಕ್ಕುವಂತೆ,</para>
  <para style="q2" vid="AMO 1:3">ಅವರು ಗಿಲ್ಯಾದ್ ಜನರನ್ನು ಬಡಿದುಬಿಟ್ಟಿದ್ದಾರೆ.<verse eid="AMO 1:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="AMO 1:4"/>ಆದರೆ ನಾನು ಹಜಾಯೇಲನ ವಂಶದ ಮೇಲೆ ಬೆಂಕಿಯನ್ನು ಕಳುಹಿಸುವೆನು.</para>
  <para style="q2" vid="AMO 1:4">ಅದು ಬೆನ್ಹದದನ ಕೋಟೆಗಳನ್ನು ದಹಿಸಿಬಿಡುವುದು.<verse eid="AMO 1:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="AMO 1:5"/>ನಾನು ದಮಸ್ಕದ ಹೆಬ್ಬಾಗಿಲನ್ನು ಸಹ ಮುರಿಯುವೆನು.</para>
  <para style="q2" vid="AMO 1:5">ಆವೆನಿನ ಕಣಿವೆಯಿಂದ ನಿವಾಸಿಯನ್ನು</para>
  <para style="q1" vid="AMO 1:5">ಮತ್ತು ಬೇತ್ ಏದೆನಿನ ಮನೆಯಿಂದ ರಾಜದಂಡ ಹಿಡಿಯುವವನನ್ನೂ ಕಡಿದುಬಿಡುವೆನು.</para>
  <para style="q2" vid="AMO 1:5">ಅರಾಮ್ ಜನರು ಸೆರೆಯಾಗಿ ಕೀರಿಗೆ ಹೋಗುವರು,</para>
  <para style="q2" vid="AMO 1:5">ಇದು ಯೆಹೋವ ದೇವರ ನುಡಿ.<verse eid="AMO 1:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="AMO 1:6"/>ಯೆಹೋವ ದೇವರು ಹೀಗೆ ಹೇಳುತ್ತಾರೆ:</para>
  <para style="q1" vid="AMO 1:6">“ಗಾಜದ ಜನರು ಮಾಡಿರುವ ಮೂರು ಹೌದು ನಾಲ್ಕು ಪಾಪಗಳಿಗಾಗಿ,</para>
  <para style="q2" vid="AMO 1:6">ಆಗಬೇಕಾದ ದಂಡನೆಯನ್ನು ನಾನು ತಪ್ಪಿಸುವುದೇ ಇಲ್ಲ.</para>
  <para style="q1" vid="AMO 1:6">ಏಕೆಂದರೆ ಅವರು ಎಲ್ಲಾ ಸಮುದಾಯಗಳನ್ನು ಸೆರೆಹಿಡಿದು</para>
  <para style="q2" vid="AMO 1:6">ಎದೋಮಿಗೆ ಮಾರಿಬಿಟ್ಟರು.<verse eid="AMO 1:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="AMO 1:7"/>ನಾನು ಗಾಜದ ಗೋಡೆಯ ಮೇಲೆ ಬೆಂಕಿಯನ್ನು ಕಳುಹಿಸುವೆನು.</para>
  <para style="q2" vid="AMO 1:7">ಅದು ಅವರ ಕೋಟೆಗಳನ್ನು ದಹಿಸಿಬಿಡುವುದು.<verse eid="AMO 1:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="AMO 1:8"/>ಅಷ್ಡೋದಿನಿಂದ ನಿವಾಸಿಯನ್ನು</para>
  <para style="q2" vid="AMO 1:8">ಮತ್ತು ಅಷ್ಕೆಲೋನಿನಿಂದ ರಾಜದಂಡ ಹಿಡಿಯುವವನನ್ನು ನಾಶಮಾಡುವೆನು.</para>
  <para style="q1" vid="AMO 1:8">ಫಿಲಿಷ್ಟಿಯರಲ್ಲಿ ಕೊನೆಯವರು ಸಾಯುವವರೆಗೂ</para>
  <para style="q2" vid="AMO 1:8">ನಾನು ಎಕ್ರೋನಿನ ವಿರುದ್ಧ ನನ್ನ ಕೈಯನ್ನು ತಿರುಗಿಸುವೆನು,”</para>
  <para style="q2" vid="AMO 1:8">ಎಂದು ಸಾರ್ವಭೌಮ ಯೆಹೋವ ದೇವರು ಹೇಳುತ್ತಾರೆ.<verse eid="AMO 1:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="AMO 1:9"/>ಯೆಹೋವ ದೇವರು ಹೀಗೆ ಹೇಳುತ್ತಾರೆ:</para>
  <para style="q1" vid="AMO 1:9">“ಟೈರ್ ಪಟ್ಟಣದ ಜನರು ಮಾಡಿರುವ ಮೂರು ಹೌದು ನಾಲ್ಕು ಪಾಪಗಳಿಗಾಗಿ,</para>
  <para style="q2" vid="AMO 1:9">ಆಗಬೇಕಾದ ದಂಡನೆಯನ್ನು ನಾನು ತಪ್ಪಿಸುವುದೇ ಇಲ್ಲ.</para>
  <para style="q1" vid="AMO 1:9">ಏಕೆಂದರೆ ಅವರು ಸಹೋದರರ ಒಡಂಬಡಿಕೆಯನ್ನು ಜ್ಞಾಪಕಮಾಡಿಕೊಳ್ಳದೆ</para>
  <para style="q2" vid="AMO 1:9">ಸೆರೆಯಾಳುಗಳ ಸಂಪೂರ್ಣ ಸಮುದಾಯಗಳನ್ನು ಎದೋಮಿಗೆ ಮಾರಿಬಿಟ್ಟರು.<verse eid="AMO 1:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="AMO 1:10"/>ಆದರೆ ನಾನು ಟೈರ್ ಪಟ್ಟಣದ ಗೋಡೆಯ ಮೇಲೆ ಬೆಂಕಿಯನ್ನು ಕಳುಹಿಸುವೆನು.</para>
  <para style="q2" vid="AMO 1:10">ಅದು ಅಲ್ಲಿಯ ಕೋಟೆಗಳನ್ನು ದಹಿಸಿಬಿಡುವುದು.”<verse eid="AMO 1:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="AMO 1:11"/>ಯೆಹೋವ ದೇವರು ಹೀಗೆ ಹೇಳುತ್ತಾರೆ:</para>
  <para style="q1" vid="AMO 1:11">“ಎದೋಮಿನವರು ಮಾಡಿರುವ ಮೂರು ಹೌದು ನಾಲ್ಕು ಪಾಪಗಳಿಗಾಗಿ,</para>
  <para style="q2" vid="AMO 1:11">ಆಗಬೇಕಾದ ದಂಡನೆಯನ್ನು ನಾನು ತಪ್ಪಿಸುವುದೇ ಇಲ್ಲ.</para>
  <para style="q1" vid="AMO 1:11">ಏಕೆಂದರೆ ಅವನು ತನ್ನ ಸಹೋದರನನ್ನು ಖಡ್ಗವನ್ನು ಹಿಂಬಾಲಿಸಿದನು.</para>
  <para style="q2" vid="AMO 1:11">ಮತ್ತು ದೇಶದ ಸ್ತ್ರೀಯರನ್ನು ಕೊಂದುಹಾಕಿದನು.</para>
  <para style="q1" vid="AMO 1:11">ಏಕೆಂದರೆ ಅವನ ಕೋಪವು ನಿರಂತರವಾಗಿ ಹರಿಯುತ್ತಿತ್ತು.</para>
  <para style="q2" vid="AMO 1:11">ಆತನು ರೌದ್ರವನ್ನು ನಿತ್ಯವಾಗಿ ಇಟ್ಟುಕೊಂಡನು.<verse eid="AMO 1:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="AMO 1:12"/>ಆದರೆ ನಾನು ತೇಮಾನಿನ ಮೇಲೆ ಬೆಂಕಿಯನ್ನು ಕಳುಹಿಸುವೆನು.</para>
  <para style="q2" vid="AMO 1:12">ಅದು ಬೊಚ್ರದ ಕೋಟೆಗಳನ್ನು ದಹಿಸಿಬಿಡುವುದು.”<verse eid="AMO 1:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="AMO 1:13"/>ಯೆಹೋವ ದೇವರು ಹೀಗೆ ಹೇಳುತ್ತಾರೆ:</para>
  <para style="q1" vid="AMO 1:13">“ಅಮ್ಮೋನಿನ ಮಕ್ಕಳು ಮಾಡಿರುವ ಮೂರು ಹೌದು ನಾಲ್ಕು ಪಾಪಗಳಿಗಾಗಿ,</para>
  <para style="q2" vid="AMO 1:13">ಆಗಬೇಕಾದ ದಂಡನೆಯನ್ನು ನಾನು ತಪ್ಪಿಸುವುದೇ ಇಲ್ಲ.</para>
  <para style="q1" vid="AMO 1:13">ಏಕೆಂದರೆ ತಮ್ಮ ಮೇರೆಯನ್ನು ವಿಸ್ತಾರ ಮಾಡುವುದಕ್ಕಾಗಿ,</para>
  <para style="q2" vid="AMO 1:13">ಗಿಲ್ಯಾದಿನ ಗರ್ಭಿಣಿಯರನ್ನು ಸೀಳಿಬಿಟ್ಟಿದ್ದಾರೆ.<verse eid="AMO 1:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="AMO 1:14"/>ನಾನು ರಬ್ಬದ ಪ್ರಾಕಾರಗಳ ಮೇಲೆ ಬೆಂಕಿಯನ್ನು ಸುರಿಸುವೆನು.</para>
  <para style="q2" vid="AMO 1:14">ಅದು ಅದರ ಕೋಟೆಗಳನ್ನು ದಹಿಸಿಬಿಡುವುದು.</para>
  <para style="q1" vid="AMO 1:14">ಆಗ ಯುದ್ಧಾರ್ಭಟವೂ, ಚಂಡಮಾರುತದಂಥ ಪ್ರಚಂಡ ಕಾದಾಟವೂ ಉಂಟಾಗುವುವು.<verse eid="AMO 1:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="AMO 1:15"/>ಅವರ ಅರಸನು ತನ್ನ ರಾಜ್ಯಾಧಿಕಾರರ ಸಂಗಡ ಸೆರೆಗೆ ಹೋಗುವನು”</para>
  <para style="q2" vid="AMO 1:15">ಎಂದು ಯೆಹೋವ ದೇವರು ಹೇಳುತ್ತಾರೆ.<verse eid="AMO 1:15"/></para>
  <chapter eid="AMO 1"/>
  <chapter number="2" style="c" sid="AMO 2"/>
  <para style="p">
    <verse number="1" style="v" sid="AMO 2:1"/>ಯೆಹೋವ ದೇವರು ಹೀಗೆ ಹೇಳುತ್ತಾನೆ:</para>
  <para style="q1" vid="AMO 2:1">“ಮೋವಾಬಿನವರು ಮಾಡಿರುವ ಮೂರು ಹೌದು ನಾಲ್ಕು ಪಾಪಗಳಿಗಾಗಿ,</para>
  <para style="q2" vid="AMO 2:1">ಆಗಬೇಕಾದ ದಂಡನೆಯನ್ನು ನಾನು ತಪ್ಪಿಸುವುದೇ ಇಲ್ಲ.</para>
  <para style="q1" vid="AMO 2:1">ಏಕೆಂದರೆ ಅವನು ಎದೋಮಿನ ಅರಸನ ಎಲುಬುಗಳನ್ನು,</para>
  <para style="q2" vid="AMO 2:1">ಸುಟ್ಟು ಸುಣ್ಣ ಮಾಡಿದ್ದಾನೆ.<verse eid="AMO 2:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="AMO 2:2"/>ನಾನು ಮೋವಾಬಿನ ಮೇಲೆ ಬೆಂಕಿಯನ್ನು ಕಳುಹಿಸುವೆನು.</para>
  <para style="q2" vid="AMO 2:2">ಅದು ಕೆರೀಯೋತಿನ ಕೋಟೆಗಳನ್ನು ದಹಿಸಿಬಿಡುವುದು.</para>
  <para style="q1" vid="AMO 2:2">ಮೋವಾಬು ಆರ್ಭಟದ ಮತ್ತು ತುತೂರಿಯ ಧ್ವನಿಯ ಸಂಗಡ</para>
  <para style="q2" vid="AMO 2:2">ಗಲಿಬಿಲಿಯಲ್ಲಿ ಸಾಯುವುದು.<verse eid="AMO 2:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="AMO 2:3"/>ನಾನು ಅದರ ಮಧ್ಯದಿಂದ ನ್ಯಾಯಾಧಿಪತಿಯನ್ನು ಕಡಿದುಹಾಕುವೆನು.</para>
  <para style="q2" vid="AMO 2:3">ಎಲ್ಲಾ ಪ್ರಧಾನರನ್ನು ಅಲ್ಲಿ ಅವನೊಂದಿಗೆ ಕೊಲ್ಲುವೆನು,”</para>
  <para style="q2" vid="AMO 2:3">ಎಂದು ಯೆಹೋವ ದೇವರು ಹೇಳುತ್ತಾರೆ.<verse eid="AMO 2:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="AMO 2:4"/>ಯೆಹೋವ ದೇವರು ಹೀಗೆ ಹೇಳುತ್ತಾರೆ:</para>
  <para style="q1" vid="AMO 2:4">“ಯೆಹೂದದವರು ಮಾಡಿರುವ ಮೂರು ಹೌದು ನಾಲ್ಕು ಪಾಪಗಳಿಗಾಗಿ,</para>
  <para style="q2" vid="AMO 2:4">ಆಗಬೇಕಾದ ದಂಡನೆಯನ್ನು ನಾನು ತಪ್ಪಿಸುವುದೇ ಇಲ್ಲ.</para>
  <para style="q1" vid="AMO 2:4">ಏಕೆಂದರೆ ಅವರು ಯೆಹೋವ ದೇವರ ನಿಯಮವನ್ನು ನಿರಾಕರಿಸಿದರು.</para>
  <para style="q2" vid="AMO 2:4">ಆತನ ಆಜ್ಞೆಗಳನ್ನು ಕೈಗೊಳ್ಳಲಿಲ್ಲ.</para>
  <para style="q1" vid="AMO 2:4">ಅವರ ಪಿತೃಗಳು ಅನುಸರಿಸಿದ ಸುಳ್ಳು ದೇವರುಗಳೇ,</para>
  <para style="q2" vid="AMO 2:4">ಇವರನ್ನು ದಾರಿ ತಪ್ಪುವವರನ್ನಾಗಿ ಮಾಡಿವೆ.<verse eid="AMO 2:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="AMO 2:5"/>ನಾನು ಯೆಹೂದದ ಮೇಲೆ ಬೆಂಕಿಯನ್ನು ಕಳುಹಿಸುವೆನು.</para>
  <para style="q2" vid="AMO 2:5">ಅದು ಯೆರೂಸಲೇಮಿನ ಕೋಟೆಗಳನ್ನು ದಹಿಸಿಬಿಡುವುದು.”<verse eid="AMO 2:5"/></para>
  <para style="s1">ಇಸ್ರಾಯೇಲರ ಮೇಲೆ ತೀರ್ಪು</para>
  <para style="p">
    <verse number="6" style="v" sid="AMO 2:6"/>ಯೆಹೋವ ದೇವರು ಹೀಗೆ ಹೇಳುತ್ತಾರೆ:</para>
  <para style="q1" vid="AMO 2:6">“ಇಸ್ರಾಯೇಲಿನವರು ಮಾಡಿರುವ ಮೂರು ಹೌದು ನಾಲ್ಕು ಪಾಪಗಳಿಗಾಗಿ,</para>
  <para style="q2" vid="AMO 2:6">ಆಗಬೇಕಾದ ದಂಡನೆಯನ್ನು ನಾನು ತಪ್ಪಿಸುವುದೇ ಇಲ್ಲ.</para>
  <para style="q1" vid="AMO 2:6">ಏಕೆಂದರೆ ಅವರು ನಿರಪರಾಧಿಗಳನ್ನು ಬೆಳ್ಳಿಗೆ</para>
  <para style="q2" vid="AMO 2:6">ಮತ್ತು ಬಡವರನ್ನು ಒಂದು ಜೋಡಿ ಕೆರಗಳಿಗೆ ಮಾರಿದರು.<verse eid="AMO 2:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="AMO 2:7"/>ಬಡವರ ತಲೆಗಳನ್ನು ಬೀದಿಯ ಧೂಳಿನಂತೆ ತುಳಿದು ಬಿಡುತ್ತಾರೆ.</para>
  <para style="q2" vid="AMO 2:7">ದೀನದಲಿತರಿಗೆ ನ್ಯಾಯ ದೊರಕದಂತೆ ಮಾಡುತ್ತಾರೆ.</para>
  <para style="q1" vid="AMO 2:7">ತಂದೆಯೂ ಮಗನೂ ಒಬ್ಬ ಮಹಿಳೆಯನ್ನು ಇಟ್ಟುಕೊಂಡು,</para>
  <para style="q2" vid="AMO 2:7">ನನ್ನ ಪವಿತ್ರ ನಾಮಕ್ಕೆ ಅಪಕೀರ್ತಿ ತರುತ್ತಾರೆ.<verse eid="AMO 2:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="AMO 2:8"/>ಅವರು ಅಡವು ಇಟ್ಟ ವಸ್ತ್ರಗಳ ಮೇಲೆ</para>
  <para style="q2" vid="AMO 2:8">ಪ್ರತಿಯೊಂದು ಬಲಿಪೀಠಗಳ ಬಳಿಯಲ್ಲೂ ಮಲಗುತ್ತಾರೆ.</para>
  <para style="q1" vid="AMO 2:8">ನಿಷೇಧಿಸಿದ ದ್ರಾಕ್ಷಾರಸವನ್ನು</para>
  <para style="q2" vid="AMO 2:8">ತಮ್ಮ ದೇವರ ಆಲಯದಲ್ಲಿ ಕುಡಿಯುತ್ತಾರೆ.<verse eid="AMO 2:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="AMO 2:9"/>“ಆದರೂ ನನ್ನ ಜನರೇ, ದೇವದಾರು ಮರದಂತೆ ಎತ್ತರವಾಗಿ,</para>
  <para style="q2" vid="AMO 2:9">ಅಲ್ಲೋನ್ ಮರದಂತೆ ಬಲಿಷ್ಠರಾಗಿ ಇದ್ದ,</para>
  <para style="q2" vid="AMO 2:9">ಅಮೋರಿಯರನ್ನು ನಾನು ನಾಶ ಪಡಿಸಿದೆನು.</para>
  <para style="q1" vid="AMO 2:9">ನಾನು ಮೇಲೆ ಅದರ ಫಲವನ್ನು ಮತ್ತು ಕೆಳಗೆ ಅದರ ಬೇರನ್ನು ಕಿತ್ತು ಹಾಕುವಂತೆ,</para>
  <para style="q2" vid="AMO 2:9">ಅವರನ್ನು ನಿರ್ಮೂಲ ಮಾಡುವೆನು.<verse eid="AMO 2:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="AMO 2:10"/>ನಾನೇ ನಿಮ್ಮನ್ನು ಈಜಿಪ್ಟ್ ದೇಶದಿಂದ ಕರೆತಂದೆನು.</para>
  <para style="q2" vid="AMO 2:10">ಅಮೋರಿಯರ ದೇಶವನ್ನು ನಿಮಗೆ ಸೊತ್ತಾಗಿ ಕೊಡಲು,</para>
  <para style="q2" vid="AMO 2:10">ನಿಮ್ಮನ್ನು ನಾಲ್ವತ್ತು ವರ್ಷ ಮರುಭೂಮಿಯಲ್ಲಿ ನಡೆಸಿದೆನು.<verse eid="AMO 2:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="AMO 2:11"/>“ನಾನು ನಿಮ್ಮ ಪುತ್ರರಲ್ಲಿ ಪ್ರವಾದಿಗಳನ್ನೂ</para>
  <para style="q2" vid="AMO 2:11">ನಿಮ್ಮ ಯೌವನಸ್ಥರಲ್ಲಿ ನಾಜೀರರನ್ನೂ ಎಬ್ಬಿಸಿದೆನು.</para>
  <para style="q1" vid="AMO 2:11">ಇಸ್ರಾಯೇಲಿನ ಜನರೇ, ಇದು ಸರಿಯಲ್ಲವೋ?”</para>
  <para style="q2" vid="AMO 2:11">ಎಂದು ಯೆಹೋವ ದೇವರು ಹೇಳುತ್ತಾರೆ.<verse eid="AMO 2:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="AMO 2:12"/>“ಆದರೆ ನೀವು ನಾಜೀರರಿಗೆ ಕುಡಿಯಲು ದ್ರಾಕ್ಷಾರಸವನ್ನು ಕೊಟ್ಟಿರಿ.</para>
  <para style="q2" vid="AMO 2:12">ಪ್ರವಾದಿಗಳಿಗೆ ಪ್ರವಾದಿಸಬೇಡಿರಿ ಎಂದು ಆಜ್ಞಾಪಿಸಿದಿರಿ.<verse eid="AMO 2:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="AMO 2:13"/>“ಇಗೋ, ಸಿವುಡು ತುಂಬಿದ ಬಂಡಿ ಒತ್ತುವ ಪ್ರಕಾರ,</para>
  <para style="q2" vid="AMO 2:13">ನಾನು ನಿಮ್ಮನ್ನು ಕೆಳಗೆ ಹಾಕಿ ಒತ್ತುವೆನು.<verse eid="AMO 2:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="AMO 2:14"/>ಆದ್ದರಿಂದ ತ್ವರೆಯಾಗಿ ಓಡುವವನು ತಪ್ಪಿಸಿಕೊಳ್ಳನು.</para>
  <para style="q2" vid="AMO 2:14">ಬಲಿಷ್ಠನು ತನ್ನ ತ್ರಾಣವನ್ನು ಬಲಪಡಿಸಿಕೊಳ್ಳಲಾರನು.</para>
  <para style="q2" vid="AMO 2:14">ಪರಾಕ್ರಮಿಯು ತನ್ನ ಪ್ರಾಣವನ್ನು ಉಳಿಸಿಕೊಳ್ಳನು.<verse eid="AMO 2:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="AMO 2:15"/>ಬಿಲ್ಲು ಹಿಡಿಯುವವನು ಭೂಮಿಯ ಮೇಲೆ ನಿಲ್ಲನು.</para>
  <para style="q2" vid="AMO 2:15">ಪಾದತ್ವರಿತನು ತಪ್ಪಿಸಿಕೊಳ್ಳನು.</para>
  <para style="q2" vid="AMO 2:15">ಅಶ್ವಾರೂಢನು ತನ್ನ ಪ್ರಾಣವನ್ನು ಉಳಿಸಿಕೊಳ್ಳನು.<verse eid="AMO 2:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="AMO 2:16"/>ಶೂರರಲ್ಲಿ ಧೈರ್ಯ ಹೃದಯವುಳ್ಳವನು,</para>
  <para style="q2" vid="AMO 2:16">ಆ ದಿನದಲ್ಲಿ ಬೆತ್ತಲೆಯಾಗಿ ಓಡಿಹೋಗುವನು,”</para>
  <para style="q2" vid="AMO 2:16">ಎಂದು ಯೆಹೋವ ದೇವರು ಹೇಳುತ್ತಾರೆ.<verse eid="AMO 2:16"/></para>
  <chapter eid="AMO 2"/>
  <chapter number="3" style="c" sid="AMO 3"/>
  <para style="s1">ಇಸ್ರಾಯೇಲಿಗೆ ವಿರುದ್ಧ ಸಾಕ್ಷಿಗಳನ್ನು ಕರೆಯಲಾದದ್ದು</para>
  <para style="p">
    <verse number="1" style="v" sid="AMO 3:1"/>ಇಸ್ರಾಯೇಲರೇ, ಯೆಹೋವ ದೇವರು ನಿಮಗೆ ವಿರೋಧವಾಗಿ ಹೇಳುವ ವಾಕ್ಯವನ್ನು ಕೇಳಿರಿ. ನಾನು ಈಜಿಪ್ಟ್ ದೇಶದೊಳಗಿಂದ ಕರೆದುತಂದ ಸಮಸ್ತ ಕುಟುಂಬಕ್ಕೆ ಹೇಳುವುದೇನೆಂದರೆ:<verse eid="AMO 3:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="AMO 3:2"/>“ಭೂಮಿಯ ಎಲ್ಲಾ ಕುಟುಂಬಗಳಲ್ಲಿ</para>
  <para style="q2" vid="AMO 3:2">ನಿಮ್ಮನ್ನು ಮಾತ್ರವೇ ಆರಿಸಿಕೊಂಡಿದ್ದೇನೆ.</para>
  <para style="q1" vid="AMO 3:2">ಆದ್ದರಿಂದ ನಾನು ನಿಮ್ಮ ಎಲ್ಲಾ ಪಾಪಗಳಿಗಾಗಿ ಶಿಕ್ಷಿಸುತ್ತೇನೆ.”<verse eid="AMO 3:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="AMO 3:3"/>ಒಪ್ಪಂದ ಮಾಡಿಕೊಳ್ಳದ ಹೊರತು,</para>
  <para style="q2" vid="AMO 3:3">ಇಬ್ಬರು ಜೊತೆಯಾಗಿ ನಡೆಯಲು ಸಾಧ್ಯವೋ?<verse eid="AMO 3:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="AMO 3:4"/>ಬೇಟೆ ಇಲ್ಲದಿದ್ದರೆ,</para>
  <para style="q2" vid="AMO 3:4">ಅಡವಿಯಲ್ಲಿ ಸಿಂಹವು ಗರ್ಜಿಸುವುದೋ?</para>
  <para style="q1" vid="AMO 3:4">ಏನಾದರೂ ಹಿಡಿಯದಿದ್ದರೆ,</para>
  <para style="q2" vid="AMO 3:4">ಗುಹೆಯಲ್ಲಿರುವ ಎಳೆಯ ಸಿಂಹವು ಅರಚುವುದೋ?<verse eid="AMO 3:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="AMO 3:5"/>ಬೋನು ಇಲ್ಲದಿದ್ದರೆ</para>
  <para style="q2" vid="AMO 3:5">ಪಕ್ಷಿಯು ಭೂಮಿಯ ಮೇಲೆ ಉರುಲಿನಲ್ಲಿ ಬೀಳುವುದೇ?</para>
  <para style="q1" vid="AMO 3:5">ಏನೂ ಸಿಕ್ಕಿಕೊಳ್ಳದಿದ್ದರೆ,</para>
  <para style="q2" vid="AMO 3:5">ಅದನ್ನು ಭೂಮಿಯಿಂದ ಯಾರಾದರೂ ತೆಗೆಯುವರೇ?<verse eid="AMO 3:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="AMO 3:6"/>ಪಟ್ಟಣದಲ್ಲಿ ಕಹಳೆಯನ್ನು ಊದಿದರೆ,</para>
  <para style="q2" vid="AMO 3:6">ಜನರು ಹೆದರುವುದಿಲ್ಲವೇ?</para>
  <para style="q1" vid="AMO 3:6">ಯೆಹೋವ ದೇವರಿಂದಲ್ಲದೆ</para>
  <para style="q2" vid="AMO 3:6">ಪಟ್ಟಣಕ್ಕೆ ಕೇಡು ತಟ್ಟುವುದುಂಟೇ?<verse eid="AMO 3:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="AMO 3:7"/>ನಿಶ್ಚಯವಾಗಿ ತನ್ನ ಸೇವಕರಾದ ಪ್ರವಾದಿಗಳಿಗೆ</para>
  <para style="q2" vid="AMO 3:7">ತನ್ನ ಯೋಜನೆಗಳನ್ನು ತಿಳಿಸದೆ,</para>
  <para style="q2" vid="AMO 3:7">ಸಾರ್ವಭೌಮ ಯೆಹೋವ ದೇವರು ಏನನ್ನೂ ಮಾಡುವುದಿಲ್ಲ.<verse eid="AMO 3:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="AMO 3:8"/>ಸಿಂಹವು ಗರ್ಜಿಸಿದರೆ</para>
  <para style="q2" vid="AMO 3:8">ಭಯಪಡದೆ ಇರುವವರು ಯಾರು?</para>
  <para style="q1" vid="AMO 3:8">ಸಾರ್ವಭೌಮ ಯೆಹೋವ ದೇವರು ನುಡಿದಿದ್ದಾರೆ,</para>
  <para style="q2" vid="AMO 3:8">ಅವರ ನುಡಿಯನ್ನು ಪ್ರವಾದಿಸದವರು ಯಾರು?<verse eid="AMO 3:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="AMO 3:9"/>ಅಷ್ಡೋದಿನ ಕೋಟೆಗಳಲ್ಲಿ</para>
  <para style="q2" vid="AMO 3:9">ಮತ್ತು ಈಜಿಪ್ಟ್ ದೇಶದ ಕೋಟೆಗಳಲ್ಲಿ ಹೀಗೆ ಸಾರಿ ಹೇಳಿರಿ:</para>
  <para style="q1" vid="AMO 3:9">“ಸಮಾರ್ಯ ಬೆಟ್ಟಗಳ ಮೇಲೆ ನೀವೆಲ್ಲರೂ ಕೂಡಿಕೊಂಡು,</para>
  <para style="q2" vid="AMO 3:9">ಅದರ ಮಧ್ಯದಲ್ಲಿರುವ ದೊಡ್ಡ ಗದ್ದಲವನ್ನೂ</para>
  <para style="q2" vid="AMO 3:9">ಅದರೊಳಗಿರುವ ಹೆಚ್ಚಾದ ಹಿಂಸೆಯನ್ನೂ ನೋಡಿರಿ.”<verse eid="AMO 3:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="AMO 3:10"/>“ತಮ್ಮ ಕೋಟೆಗಳಲ್ಲಿ ಬಲಾತ್ಕಾರವನ್ನೂ ಕೊಳ್ಳೆಯನ್ನೂ</para>
  <para style="q2" vid="AMO 3:10">ನಿಕ್ಷೇಪವಾಗಿ ಕೂಡಿಸಿಕೊಂಡಿರುವವರಿಗೆ,</para>
  <para style="q1" vid="AMO 3:10">ನ್ಯಾಯ ನೀತಿಯನ್ನು ಮಾಡುವುದಕ್ಕೆ ತಿಳಿಯುವುದಿಲ್ಲ,”</para>
  <para style="q2" vid="AMO 3:10">ಎಂದು ಯೆಹೋವ ದೇವರು ಹೇಳುತ್ತಾರೆ.<verse eid="AMO 3:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="AMO 3:11"/>ಆದ್ದರಿಂದ ಸಾರ್ವಭೌಮ ಯೆಹೋವ ದೇವರು ಹೀಗೆ ಹೇಳುತ್ತಾರೆ:</para>
  <para style="q1" vid="AMO 3:11">“ವಿರೋಧಿಯು ದೇಶದ ಸುತ್ತಲೂ ಇರುವನು.</para>
  <para style="q2" vid="AMO 3:11">ನಿನ್ನ ಬಲವನ್ನು ತಗ್ಗಿಸುವನು.</para>
  <para style="q2" vid="AMO 3:11">ನಿನ್ನ ಅರಮನೆಗಳು ಸೂರೆಯಾಗುವುವು.”<verse eid="AMO 3:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="AMO 3:12"/>ಯೆಹೋವ ದೇವರು ಹೀಗೆ ಹೇಳುತ್ತಾರೆ:</para>
  <para style="q1" vid="AMO 3:12">“ಹೇಗೆ ಕುರುಬನು ಸಿಂಹದ ಬಾಯಿಯಿಂದ</para>
  <para style="q2" vid="AMO 3:12">ಎರಡು ಕಾಲಿನ ಎಲಬುಗಳನ್ನು ಅಥವಾ ಕಿವಿಯ ಒಂದು ತುಂಡನ್ನು ರಕ್ಷಿಸಲು ಪ್ರಯತ್ನಿಸುತ್ತಾನೋ</para>
  <para style="q1" vid="AMO 3:12">ಹಾಗೆಯೇ ಸಮಾರ್ಯದಲ್ಲಿ ವಾಸಿಸುವ ಇಸ್ರಾಯೇಲರು</para>
  <para style="q2" vid="AMO 3:12">ಹಾಸಿಗೆಯ ತಲೆ ಮತ್ತು ಮಂಚದ ಬಟ್ಟೆಯ ತುಂಡುಗಳೊಂದಿಗೆ</para>
  <para style="q2" vid="AMO 3:12">ಸಂರಕ್ಷಣೆ ಹೊಂದುತ್ತಾರೆ.”<verse eid="AMO 3:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="AMO 3:13"/>ಸರ್ವಶಕ್ತ ದೇವರಾದ ಯೆಹೋವ ದೇವರು ಹೇಳುವುದೇನೆಂದರೆ: “ನೀವು ಕೇಳಿ, ಯಾಕೋಬಿನ ಮನೆತನದವರಿಗೆ ವಿರುದ್ಧವಾಗಿ ಸಾಕ್ಷಿ ಕೊಡಿರಿ.”<verse eid="AMO 3:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="AMO 3:14"/>“ನಾನು ಇಸ್ರಾಯೇಲಿನ ಪಾಪಗಳನ್ನು ವಿಚಾರಿಸುವ ದಿವಸದಲ್ಲಿ,</para>
  <para style="q2" vid="AMO 3:14">ಬೇತೇಲಿನ ಬಲಿಪೀಠಗಳನ್ನು ನಾಶಮಾಡುವೆನು.</para>
  <para style="q1" vid="AMO 3:14">ಬಲಿಪೀಠದ ಕೊಂಬುಗಳು ಕಡಿಯಲಾಗಿ,</para>
  <para style="q2" vid="AMO 3:14">ನೆಲಕ್ಕೆ ಉರುಳುವುವು.<verse eid="AMO 3:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="AMO 3:15"/>ಚಳಿಗಾಲದ ಮನೆಯನ್ನು ಬೇಸಿಗೆಯ ಮನೆಯ ಸಂಗಡ</para>
  <para style="q2" vid="AMO 3:15">ಹೊಡೆದು ಹಾಕುವೆನು.</para>
  <para style="q1" vid="AMO 3:15">ಆಗ ದಂತ ಮಂದಿರಗಳು ನಾಶವಾಗುವುವು.</para>
  <para style="q2" vid="AMO 3:15">ದೊಡ್ಡ ಮನೆಗಳು ಕೊನೆಗಾಣುವುವು,”</para>
  <para style="q2" vid="AMO 3:15">ಎಂದು ಯೆಹೋವ ದೇವರು ಹೇಳುತ್ತಾರೆ.<verse eid="AMO 3:15"/></para>
  <chapter eid="AMO 3"/>
  <chapter number="4" style="c" sid="AMO 4"/>
  <para style="s1">ಇಸ್ರಾಯೇಲರು ದೇವರ ಕಡೆಗೆ ತಿರುಗಲಿಲ್ಲ</para>
  <para style="q1">
    <verse number="1" style="v" sid="AMO 4:1"/>ಸಮಾರ್ಯ ಬೆಟ್ಟದಲ್ಲಿರುವ ಬಾಷಾನಿನ ಹಸುಗಳಂತಿರುವ ಮಹಿಳೆಯರೇ,</para>
  <para style="q2" vid="AMO 4:1">ನೀವು ಬಡವರನ್ನು ಹಿಂಸಾಚಾರ ಮಾಡಿ, ದರಿದ್ರರನ್ನು ಜಜ್ಜಿ,</para>
  <para style="q1" vid="AMO 4:1">ನಿಮ್ಮ ಪತಿಗಳಿಗೆ, “ಪಾನವನ್ನು ತರಿಸಿರಿ, ಕುಡಿಯೋಣ,”</para>
  <para style="q2" vid="AMO 4:1">ಎಂದು ಹೇಳುವವರೇ, ಈ ವಾಕ್ಯವನ್ನು ಕೇಳಿರಿ.<verse eid="AMO 4:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="AMO 4:2"/>“ದಿನಗಳು ಬರುವುವು.</para>
  <para style="q2" vid="AMO 4:2">ಆಗ ನಿಮ್ಮನ್ನು ಕೊಂಡಿಗಳಿಂದ ಎಳೆದುಕೊಂಡು ಹೋಗುವರು.</para>
  <para style="q1" vid="AMO 4:2">ನಿಮ್ಮಲ್ಲಿ ಅಳಿದುಳಿದವರನ್ನು ಗಾಳಕ್ಕೆ ಸಿಕ್ಕಿದ ಮೀನಿನಂತೆ ಸೆಳೆದೊಯ್ಯುವರು.</para>
  <para style="q2" vid="AMO 4:2">ಎಂದು ಸಾರ್ವಭೌಮ ಯೆಹೋವ ದೇವರು ಇದನ್ನು ಆಣೆಯಿಟ್ಟು ನುಡಿದಿದ್ದಾರೆ.<verse eid="AMO 4:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="AMO 4:3"/>ಗೋಡೆಯಲ್ಲಿಯ ಬಿರುಕುಗಳ ಮೂಲಕ</para>
  <para style="q2" vid="AMO 4:3">ನೀವು ಹೊರಟು ಹೋಗುವಿರಿ.</para>
  <para style="q1" vid="AMO 4:3">ನಿಮ್ಮನ್ನು ಹರ್ಮೋನಿನ ಕಡೆಗೆ ಎಸೆಯಲಾಗುತ್ತದೆ,”</para>
  <para style="q2" vid="AMO 4:3">ಎಂದು ಯೆಹೋವ ದೇವರು ಹೇಳುತ್ತಾರೆ.<verse eid="AMO 4:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="AMO 4:4"/>“ಪಾಪ ಮಾಡಬೇಕಾದರೆ, ಬೇತೇಲಿಗೆ ಹೋಗಿ ಪಾಪ ಮಾಡಿರಿ.</para>
  <para style="q2" vid="AMO 4:4">ಗಿಲ್ಗಾಲಿಗೆ ಹೋಗಿ ಯಥೇಚ್ಛವಾಗಿ ಪಾಪ ಮಾಡಿರಿ.</para>
  <para style="q1" vid="AMO 4:4">ಪ್ರತಿದಿನವೂ ಪ್ರಾತಃಕಾಲದ ಬಲಿಗಳನ್ನು ಅರ್ಪಿಸಿರಿ.</para>
  <para style="q2" vid="AMO 4:4">ಮೂರು ದಿನಗಳಿಗೊಮ್ಮೆ<note caller="+" style="f"><char style="fr" closed="false">4:4 </char><char style="fq" closed="false">ದಿನಗಳಿಗೊಮ್ಮೆ </char><char style="ft" closed="false">ಅಥವಾ </char><char style="fqa" closed="false">ವರ್ಷಗಳು</char></note> ದಶಮಾಂಶವನ್ನು ಸಲ್ಲಿಸಿರಿ.”<verse eid="AMO 4:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="AMO 4:5"/>“ಹುಳಿಹಿಟ್ಟಿನ ರೊಟ್ಟಿಯನ್ನು ಹೋಮ ಮಾಡಿ,</para>
  <para style="q2" vid="AMO 4:5">ಸ್ತೋತ್ರದ ಯಜ್ಞವನ್ನೂ ಅರ್ಪಿಸಿರಿ.</para>
  <para style="q1" vid="AMO 4:5">ಕಾಣಿಕೆ ಕೊಟ್ಟದ್ದನ್ನು ಹೇಳಿಕೊಳ್ಳಿರಿ.</para>
  <para style="q2" vid="AMO 4:5">ಇಸ್ರಾಯೇಲರೇ, ಹೀಗೆ ಮಾಡುವುದು ಇಷ್ಟವಾಗಿದೆ,”</para>
  <para style="q2" vid="AMO 4:5">ಎಂದು ಸಾರ್ವಭೌಮ ಯೆಹೋವ ದೇವರು ಹೇಳುತ್ತಾರೆ.<verse eid="AMO 4:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="AMO 4:6"/>“ಪ್ರತಿಯೊಂದು ಪಟ್ಟಣದಲ್ಲಿ ಬರಿದಾದ ಹೊಟ್ಟೆಗಳನ್ನು ನಿಮಗೆ ಕೊಟ್ಟಿದ್ದೇನೆ.</para>
  <para style="q2" vid="AMO 4:6">ಪ್ರತಿಯೊಂದು ಪಟ್ಟಣದಲ್ಲಿ ಆಹಾರದ ಕೊರತೆಯಿದೆ.</para>
  <para style="q1" vid="AMO 4:6">ಆದರೂ ನೀವು ನನ್ನ ಕಡೆಗೆ ಹಿಂದಿರುಗಿಕೊಳ್ಳಲಿಲ್ಲ,”</para>
  <para style="q2" vid="AMO 4:6">ಎಂದು ಯೆಹೋವ ದೇವರು ಹೇಳುತ್ತಾರೆ.<verse eid="AMO 4:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="AMO 4:7"/>“ಸುಗ್ಗಿಯು ಇನ್ನು ಮೂರು ತಿಂಗಳು ಇರುವಾಗ,</para>
  <para style="q2" vid="AMO 4:7">ಮಳೆಯನ್ನು ನಾನು ನಿಮ್ಮಿಂದ ಹಿಂದೆಗೆದಿದ್ದೇನೆ.</para>
  <para style="q1" vid="AMO 4:7">ಒಂದು ಪಟ್ಟಣದ ಮೇಲೆ ಮಳೆ ಸುರಿಸಿ,</para>
  <para style="q2" vid="AMO 4:7">ಇನ್ನೊಂದು ಪಟ್ಟಣದ ಮೇಲೆ ಮಳೆ ಸುರಿಸಲಿಲ್ಲ.</para>
  <para style="q1" vid="AMO 4:7">ಒಂದು ಹೊಲದ ಮೇಲೆ ಮಳೆ ಸುರಿಸಿ,</para>
  <para style="q2" vid="AMO 4:7">ಇನ್ನೊಂದು ಹೊಲದ ಮೇಲೆ ಮಳೆ ಸುರಿಸಲಿಲ್ಲ ಮತ್ತು ಅದು ಒಣಗಿ ಹೋಯಿತು.<verse eid="AMO 4:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="AMO 4:8"/>ಎರಡು ಅಥವಾ ಮೂರು ಪಟ್ಟಣದವರು ಕುಡಿಯುವ ನೀರಿಗಾಗಿ ಒಂದು ಪಟ್ಟಣದಿಂದ</para>
  <para style="q2" vid="AMO 4:8">ಇನ್ನೊಂದು ಪಟ್ಟಣಕ್ಕೆ ಅಲೆದಾಡುತ್ತಾ ಹೋದರೂ,</para>
  <para style="q2" vid="AMO 4:8">ಅವರ ಬಾಯಾರಿಕೆ ತೀರಲಿಲ್ಲ.</para>
  <para style="q1" vid="AMO 4:8">ಆದರೂ ನೀವು ನನ್ನ ಕಡೆಗೆ ಹಿಂದಿರುಗಿಕೊಳ್ಳಲಿಲ್ಲ,”</para>
  <para style="q2" vid="AMO 4:8">ಎಂದು ಯೆಹೋವ ದೇವರು ಹೇಳುತ್ತಾರೆ.<verse eid="AMO 4:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="AMO 4:9"/>“ಬಿಸಿಗಾಳಿಯನ್ನು ಕಳುಹಿಸಿ ನಿಮ್ಮ ಉದ್ಯಾನವನಗಳನ್ನು</para>
  <para style="q2" vid="AMO 4:9">ಮತ್ತು ದ್ರಾಕ್ಷಿತೋಟಗಳನ್ನು ಒಣಗುವಂತೆ ಮಾಡಿದೆ.</para>
  <para style="q2" vid="AMO 4:9">ನಿಮ್ಮ ಬೆಳೆ ರೋಗ ಮತ್ತು ಶಿಲೀಂಧ್ರವುಗಳಿಂದ ನಾಶವಾಯಿತು.</para>
  <para style="q1" vid="AMO 4:9">ನಿಮ್ಮ ಅಂಜೂರದ ಗಿಡ ಮತ್ತು ಎಣ್ಣೆಮರಗಳನ್ನೂ ಮಿಡತೆಗಳು ತಿಂದು ಬಿಡುವಂತೆ ಮಾಡಿದೆ.</para>
  <para style="q2" vid="AMO 4:9">ಆದರೂ ನೀವು ನನ್ನ ಕಡೆಗೆ ಹಿಂದಿರುಗಿಕೊಳ್ಳಲಿಲ್ಲ,</para>
  <para style="q2" vid="AMO 4:9">ಎಂದು ಯೆಹೋವ ದೇವರು ಹೇಳುತ್ತಾರೆ.<verse eid="AMO 4:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="AMO 4:10"/>“ಹಿಂದೊಮ್ಮೆ ಈಜಿಪ್ಟಿಗೆ ನಾನು ಮಾಡಿದಂತೆ</para>
  <para style="q2" vid="AMO 4:10">ನಿಮ್ಮನ್ನು ವ್ಯಾಧಿಯಿಂದ ಬಾಧಿಸಿದೆ.</para>
  <para style="q1" vid="AMO 4:10">ನಿಮ್ಮ ಕುದುರೆಗಳನ್ನು ತೆಗೆದುಕೊಂಡು ಹೋದವರ ಜೊತೆಯಲ್ಲಿ,</para>
  <para style="q2" vid="AMO 4:10">ನಿಮ್ಮ ಯೌವನಸ್ಥರನ್ನೂ ಖಡ್ಗದಿಂದ ಕೊಂದು ಹಾಕಿದ್ದೇನೆ.</para>
  <para style="q1" vid="AMO 4:10">ನಿಮ್ಮ ಪಾಳೆಯಗಳ ದುರ್ವಾಸನೆಯು ನಿಮ್ಮ ಮೂಗು ಸಹಿಸದ ಹಾಗೆ ಮಾಡಿದ್ದೇನೆ.</para>
  <para style="q2" vid="AMO 4:10">ಆದರೂ ನೀವು ನನ್ನ ಕಡೆಗೆ ಹಿಂದಿರುಗಿಕೊಳ್ಳಲಿಲ್ಲ,”</para>
  <para style="q2" vid="AMO 4:10">ಎಂದು ಯೆಹೋವ ದೇವರು ಹೇಳುತ್ತಾರೆ.<verse eid="AMO 4:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="AMO 4:11"/>“ಸೊದೋಮನ್ನೂ, ಗೊಮೋರವನ್ನೂ ಕೆಡವಿದ ಹಾಗೆ,</para>
  <para style="q2" vid="AMO 4:11">ನಾನು ನಿಮ್ಮಲ್ಲಿ ಕೆಲವರನ್ನು ಕೆಡವಿ ಹಾಕಿದ್ದೇನೆ.</para>
  <para style="q1" vid="AMO 4:11">ಬೆಂಕಿ ಉರಿಯೊಳಗಿಂದ ತೆಗೆದ ಕೊಳ್ಳಿಯ ಹಾಗೆ ಇದ್ದೀರಿ.</para>
  <para style="q2" vid="AMO 4:11">ಆದರೂ ನೀವೂ ನನ್ನ ಕಡೆಗೆ ಹಿಂದಿರುಗಿಕೊಳ್ಳಲಿಲ್ಲ,”</para>
  <para style="q2" vid="AMO 4:11">ಎಂದು ಯೆಹೋವ ದೇವರು ಹೇಳುತ್ತಾರೆ.<verse eid="AMO 4:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="AMO 4:12"/>ಇಸ್ರಾಯೇಲೇ, ನಾನು ನಿನಗೆ ಹೀಗೆ ಮಾಡುತ್ತೇನೆ.</para>
  <para style="q2" vid="AMO 4:12">ನಾನು ನಿನಗೆ ಹೀಗೆ ಮಾಡುವುದರಿಂದ,</para>
  <para style="q2" vid="AMO 4:12">ನೀನು ನಿನ್ನ ದೇವರನ್ನು ಎದುರುಗೊಳ್ಳಲು ಸಿದ್ಧಮಾಡಿಕೋ.<verse eid="AMO 4:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="AMO 4:13"/>ಬೆಟ್ಟಗಳನ್ನು ರೂಪಿಸಿ,</para>
  <para style="q2" vid="AMO 4:13">ಗಾಳಿಯನ್ನು ನಿರ್ಮಿಸಿ,</para>
  <para style="q2" vid="AMO 4:13">ಮನುಷ್ಯನಿಗೆ ಅವನ ಯೋಚನೆ ಏನೆಂದು ತಿಳಿಸಿ,</para>
  <para style="q1" vid="AMO 4:13">ಉದಯವನ್ನು ಅಂಧಕಾರವನ್ನಾಗಿ ಮಾಡಿ,</para>
  <para style="q2" vid="AMO 4:13">ಭೂಮಿಯ ಉನ್ನತ ಸ್ಥಳಗಳನ್ನು ತುಳಿದುಬಿಡುವಾತನು,</para>
  <para style="q2" vid="AMO 4:13">ಸರ್ವಶಕ್ತರಾದ ಯೆಹೋವ ದೇವರು ಇದೇ ಅವರ ಹೆಸರು.<verse eid="AMO 4:13"/></para>
  <chapter eid="AMO 4"/>
  <chapter number="5" style="c" sid="AMO 5"/>
  <para style="s1">ಒಂದು ಪ್ರಲಾಪ ಮತ್ತು ಪಶ್ಚಾತ್ತಾಪಕ್ಕೆ ಕರೆ</para>
  <para style="p">
    <verse number="1" style="v" sid="AMO 5:1"/>ಇಸ್ರಾಯೇಲಿನ ಜನರೇ, ನಿಮ್ಮನ್ನು ಕುರಿತು ನಾನು ಹಾಡುವ ಈ ಶೋಕಗೀತೆಯ ವಾಕ್ಯವನ್ನು ಕೇಳಿರಿ:<verse eid="AMO 5:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="AMO 5:2"/>“ಇಸ್ರಾಯೇಲ್ ಎಂಬ ಕನ್ಯೆಯು ಬಿದ್ದಿದ್ದಾಳೆ.</para>
  <para style="q2" vid="AMO 5:2">ಇನ್ನು ಮೇಲೆ ಎದ್ದೇಳುವುದೇ ಇಲ್ಲ.</para>
  <para style="q1" vid="AMO 5:2">ಅವಳು ದಿಕ್ಕಿಲ್ಲದೆ ತನ್ನ ಭೂಮಿಯ ಮೇಲೆ ಒರಗಿದ್ದಾಳೆ.</para>
  <para style="q2" vid="AMO 5:2">ಅಲ್ಲಿ ಅವಳನ್ನು ಎಬ್ಬಿಸುವವರು ಯಾರೂ ಇಲ್ಲ.”<verse eid="AMO 5:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="AMO 5:3"/>ಸಾರ್ವಭೌಮ ಯೆಹೋವ ದೇವರು ಹೀಗೆ ಹೇಳುತ್ತಾರೆ:</para>
  <para style="q1" vid="AMO 5:3">“ಯುದ್ಧಕ್ಕೆ ಹೊರಟ ಸಾವಿರ ಮಂದಿ ಸೈನಿಕರಲ್ಲಿ,</para>
  <para style="q2" vid="AMO 5:3">ಪಟ್ಟಣಕ್ಕೆ ಮರಳಿದವರು ನೂರೇ ಮಂದಿ.</para>
  <para style="q1" vid="AMO 5:3">ರಣರಂಗಕ್ಕೆ ಹೊರಟ ನೂರು ಮಂದಿ ಯೋಧರಲ್ಲಿ,</para>
  <para style="q2" vid="AMO 5:3">ಇಸ್ರಾಯೇಲಿಗೆ ಮರಳಿದವರು ಹತ್ತೇ ಮಂದಿ.”<verse eid="AMO 5:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="AMO 5:4"/>ಯೆಹೋವ ದೇವರು ಇಸ್ರಾಯೇಲಿನ ಮನೆಯವರಿಗೆ ಹೀಗೆ ಹೇಳುತ್ತಾರೆ:</para>
  <para style="q1" vid="AMO 5:4">“ನೀವು ನನ್ನನ್ನು ಹುಡುಕಿರಿ ಮತ್ತು ಬದುಕಿಕೊಳ್ಳಿರಿ.<verse eid="AMO 5:4"/></para>
  <para style="q2">
    <verse number="5" style="v" sid="AMO 5:5"/>ಆದರೆ ಬೇತೇಲನ್ನು ಹುಡುಕಬೇಡಿರಿ.</para>
  <para style="q1" vid="AMO 5:5">ಗಿಲ್ಗಾಲಿಗೆ ಹೋಗಬೇಡಿರಿ.</para>
  <para style="q2" vid="AMO 5:5">ಬೇರ್ಷೆಬಕ್ಕೆ ಯಾತ್ರೆ ಹೋಗಬೇಡಿರಿ.</para>
  <para style="q1" vid="AMO 5:5">ಏಕೆಂದರೆ ಗಿಲ್ಗಾಲು ಸೆರೆಗೆ ನಿಶ್ವಯವಾಗಿ ಹೋಗುವುದು,</para>
  <para style="q2" vid="AMO 5:5">ಬೇತೇಲಿನ ಬಾಧೆಗಳು ಕೊನೆಗೊಳ್ಳುವುದಿಲ್ಲ<note caller="+" style="f"><char style="fr" closed="false">5:5 </char><char style="fq" closed="false">ಕೊನೆಗೊಳ್ಳುವುದಿಲ್ಲ </char><char style="ft" closed="false"><char style="xt"><ref loc="HOS 4:15">ಹೋಶೇ 4:15</ref></char> ನೋಡಿರಿ</char></note>.”<verse eid="AMO 5:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="AMO 5:6"/>ನೀವು ಯೆಹೋವ ದೇವರನ್ನು ಹುಡುಕಿರಿ ಮತ್ತು ಬದುಕಿರಿ.</para>
  <para style="q2" vid="AMO 5:6">ಇಲ್ಲದಿದ್ದರೆ, ಆತನು ಬೆಂಕಿಯಂತೆ ಯೋಸೇಫನ ಗೋತ್ರಗಳಲ್ಲಿ ಪ್ರವೇಶಿಸುವನು.</para>
  <para style="q1" vid="AMO 5:6">ಅದು ದಹಿಸಿಬಿಡುವುದು,</para>
  <para style="q2" vid="AMO 5:6">ಅದನ್ನು ಆರಿಸುವವರು ಬೇತೇಲಿನಲ್ಲಿ ಯಾರೂ ಇರುವುದಿಲ್ಲ.<verse eid="AMO 5:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="AMO 5:7"/>ನ್ಯಾಯವನ್ನು ಕಹಿಯಾಗಿ ತಿರುಗಿಸುವವರೇ,</para>
  <para style="q2" vid="AMO 5:7">ನೀತಿಯನ್ನು ಭೂಮಿಯಲ್ಲಿ ಬಿಡುವವರೇ.<verse eid="AMO 5:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="AMO 5:8"/>ವೃಷಭ ರಾಶಿಯನ್ನೂ, ಮೃಗಶಿರವನ್ನೂ ಉಂಟು ಮಾಡಿದವನನ್ನೂ</para>
  <para style="q2" vid="AMO 5:8">ಕಾರ್ಗತ್ತಲನ್ನು ಉದಯಕ್ಕೆ ಬದಲಿಸಿ,</para>
  <para style="q2" vid="AMO 5:8">ಹಗಲನ್ನು ರಾತ್ರಿಯಾಗುವ ಹಾಗೆ ಕತ್ತಲೆ ಮಾಡಿ,</para>
  <para style="q1" vid="AMO 5:8">ಸಮುದ್ರದ ನೀರನ್ನು ಬರಮಾಡಿ,</para>
  <para style="q2" vid="AMO 5:8">ಅವುಗಳನ್ನು ಭೂಮಿಯ ಮೇಲೆ ಸುರಿಸುವ</para>
  <para style="q2" vid="AMO 5:8">ಯೆಹೋವ ದೇವರು ಎಂಬ ಹೆಸರುಳ್ಳವರನ್ನೇ ಹುಡುಕಿರಿ.<verse eid="AMO 5:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="AMO 5:9"/>ಕಣ್ಣು ಮಿಟುಕಿಸುವುದರಲ್ಲಿ ಅವರು ಕೋಟೆಯನ್ನು ನಾಶಪಡಿಸುತ್ತಾರೆ</para>
  <para style="q2" vid="AMO 5:9">ಮತ್ತು ಕೋಟೆಯ ನಗರವನ್ನು ವಿನಾಶಪಡಿಸುತ್ತಾರೆ.<verse eid="AMO 5:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="AMO 5:10"/>ಸಭೆಯಲ್ಲಿ ದೋಷವನ್ನು ಎತ್ತಿ ತೋರಿಸುವವನನ್ನು ನೀವು ದ್ವೇಷಿಸುತ್ತೀರಿ.</para>
  <para style="q2" vid="AMO 5:10">ನಿಮ್ಮ ವಿಷಯವಾಗಿ ಸತ್ಯವನ್ನು ಹೇಳುವವನನ್ನೇ ಹೀನೈಸುತ್ತೀರಿ.<verse eid="AMO 5:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="AMO 5:11"/>ಆದಕಾರಣ ನೀವು ಬಡವನನ್ನು ತುಳಿದು</para>
  <para style="q2" vid="AMO 5:11">ಅವರ ಧಾನ್ಯಕ್ಕೆ ತೆರಿಗೆ ವಿಧಿಸುತ್ತೀರಿ.</para>
  <para style="q1" vid="AMO 5:11">ಆದ್ದರಿಂದ ನೀವು ಕೆತ್ತಿದ ಕಲ್ಲಿನ ಮನೆಗಳನ್ನು ಕಟ್ಟಿದ್ದೀರಿ.</para>
  <para style="q2" vid="AMO 5:11">ಆದರೆ ನೀವು ಅವುಗಳಲ್ಲಿ ವಾಸ ಮಾಡದೇ ಇರುವಿರಿ.</para>
  <para style="q1" vid="AMO 5:11">ರಮ್ಯವಾದ ದ್ರಾಕ್ಷಿತೋಟಗಳನ್ನು ನೆಟ್ಟಿರಲ್ಲಾ,</para>
  <para style="q2" vid="AMO 5:11">ಆದರೆ ಅವುಗಳ ದ್ರಾಕ್ಷಾರಸವನ್ನು ಕುಡಿಯಲಾರಿರಿ.<verse eid="AMO 5:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="AMO 5:12"/>ಏಕೆಂದರೆ ನಿಮ್ಮ ಅನೇಕ ಅಪರಾಧಗಳನ್ನೂ,</para>
  <para style="q2" vid="AMO 5:12">ನಿಮ್ಮ ಘೋರವಾದ ಪಾಪಗಳನ್ನೂ ನಾನು ಬಲ್ಲೆನು.</para>
  <para style="b" vid="AMO 5:12"/>
  <para style="q1" vid="AMO 5:12">ಅವರು ನಿರಪರಾಧಿಯನ್ನು ಬಾಧೆಪಡಿಸಿ, ಲಂಚವನ್ನು ತೆಗೆದುಕೊಂಡರು</para>
  <para style="q2" vid="AMO 5:12">ಮತ್ತು ಬಾಗಿಲ ಬಳಿಯಲ್ಲಿರುವ ಬಡವರ ನ್ಯಾಯವನ್ನು ತೀರಿಸದೇ ಕಳುಹಿಸಿಬಿಟ್ಟಿರಿ.<verse eid="AMO 5:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="AMO 5:13"/>ಆದ್ದರಿಂದ ಆ ಕಾಲದಲ್ಲಿ ಬುದ್ಧಿವಂತನು ಮೌನವಾಗಿರುವನು,</para>
  <para style="q2" vid="AMO 5:13">ಏಕೆಂದರೆ ಅದು ಕೆಟ್ಟ ಕಾಲವಾಗಿದೆ.<verse eid="AMO 5:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="AMO 5:14"/>ನೀವು ಬದುಕುವ ಹಾಗೆ</para>
  <para style="q2" vid="AMO 5:14">ಒಳ್ಳೆಯದನ್ನು ಹುಡುಕಿ, ಕೆಟ್ಟದ್ದನ್ನಲ್ಲ.</para>
  <para style="q1" vid="AMO 5:14">ಆಗ ನೀವು ಹೇಳಿಕೊಳ್ಳುವಂತೆ</para>
  <para style="q2" vid="AMO 5:14">ಸರ್ವಶಕ್ತರಾದ ಯೆಹೋವ ದೇವರು ನಿಮ್ಮ ಸಂಗಡ ಇರುವರು.<verse eid="AMO 5:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="AMO 5:15"/>ಕೆಟ್ಟದ್ದನ್ನು ದ್ವೇಷಿಸಿರಿ, ಒಳ್ಳೆಯದನ್ನು ಪ್ರೀತಿಸಿರಿ,</para>
  <para style="q2" vid="AMO 5:15">ಬಾಗಿಲಲ್ಲಿ ನ್ಯಾಯವನ್ನು ಸ್ಥಾಪಿಸಿರಿ.</para>
  <para style="q1" vid="AMO 5:15">ಒಂದು ವೇಳೆ ಸರ್ವಶಕ್ತರಾದ ಯೆಹೋವ ದೇವರು</para>
  <para style="q2" vid="AMO 5:15">ಯೋಸೇಫನ ಗೋತ್ರದಲ್ಲಿ ಉಳಿದವರಿಗೆ ಕನಿಕರಿಸಬಹುದು.<verse eid="AMO 5:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="AMO 5:16"/>ಆದ್ದರಿಂದ ಸರ್ವಶಕ್ತ ದೇವರಾದ ಯೆಹೋವ ದೇವರು ಹೀಗೆ ಹೇಳುತ್ತಾರೆ:</para>
  <para style="q1" vid="AMO 5:16">“ಎಲ್ಲಾ ಬೀದಿಗಳಲ್ಲೂ ವಿಲಾಪಗಳು,</para>
  <para style="q2" vid="AMO 5:16">ಎಲ್ಲಾ ಸಾರ್ವಜನಿಕ ಚೌಕದಲ್ಲಿ ದುಃಖದ ಗೋಳಾಟಗಳು ಎನ್ನುವರು.</para>
  <para style="q1" vid="AMO 5:16">ರೈತರನ್ನು ಕಣ್ಣೀರಿಡುವುದಕ್ಕೂ ಶೋಕವೃತ್ತಿಯವರನ್ನು,</para>
  <para style="q2" vid="AMO 5:16">ಗೋಳಾಡುವುದಕ್ಕೂ ಕರೆಯಲಾಗುವುದು.<verse eid="AMO 5:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="AMO 5:17"/>ಎಲ್ಲಾ ದ್ರಾಕ್ಷಿ ತೋಟಗಳಲ್ಲೂ ಗೋಳಾಟವು ಇರುವುದು.</para>
  <para style="q2" vid="AMO 5:17">ಏಕೆಂದರೆ ನಾನು ನಿನ್ನ ಮಧ್ಯೆ ಹಾದು ಹೋಗುವೆನು,”</para>
  <para style="q2" vid="AMO 5:17">ಎಂದು ಯೆಹೋವ ದೇವರು ಹೇಳುತ್ತಾರೆ.<verse eid="AMO 5:17"/></para>
  <para style="s1">ಯೆಹೋವ ದೇವರ ದಿನ</para>
  <para style="q1">
    <verse number="18" style="v" sid="AMO 5:18"/>ಯೆಹೋವ ದೇವರ ದಿನವನ್ನು ಅಪೇಕ್ಷಿಸುವವರೇ,</para>
  <para style="q2" vid="AMO 5:18">ಅಯ್ಯೋ ನಿಮಗೆ ಕಷ್ಟ!</para>
  <para style="q1" vid="AMO 5:18">ಆ ದಿನವನ್ನು ನೀವು ಅಪೇಕ್ಷಿಸುವುದೇಕೆ?</para>
  <para style="q2" vid="AMO 5:18">ಯೆಹೋವ ದೇವರ ದಿವಸವು ನಿಮಗೆ ಬೆಳಕಲ್ಲ, ಕತ್ತಲೆಯೇ.<verse eid="AMO 5:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="AMO 5:19"/>ಇದು ಒಬ್ಬ ಮನುಷ್ಯನು ಸಿಂಹದಿಂದ ತಪ್ಪಿಸಿಕೊಂಡು ಓಡಿಹೋಗಿ,</para>
  <para style="q2" vid="AMO 5:19">ಕರಡಿಯನ್ನು ಎದುರುಗೊಂಡ ಹಾಗೆಯೂ,</para>
  <para style="q1" vid="AMO 5:19">ಇಲ್ಲವೆ ಅವನು ಮನೆಗೆ ಹೋಗಿ</para>
  <para style="q2" vid="AMO 5:19">ಗೋಡೆಗೆ ತನ್ನ ಕೈಯನ್ನು ಒರಗಿಸಿದಾಗ,</para>
  <para style="q2" vid="AMO 5:19">ಸರ್ಪವು ಕಚ್ಚಿದ ಹಾಗೆಯೂ ಇರುವುದು.<verse eid="AMO 5:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="AMO 5:20"/>ಹೀಗೆ ಯೆಹೋವ ದೇವರ ದಿವಸವು ಬೆಳಕಲ್ಲ, ಕತ್ತಲೆಯೇ.</para>
  <para style="q2" vid="AMO 5:20">ಅದರಲ್ಲಿ ಪ್ರಕಾಶವೇನೂ ಇಲ್ಲದ ಕಾರ್ಗತ್ತಲೆಯೇ.<verse eid="AMO 5:20"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="21" style="v" sid="AMO 5:21"/>ನಿಮ್ಮ ಹಬ್ಬಗಳನ್ನು ಹಗೆಮಾಡಿ ತುಚ್ಛೀಕರಿಸುತ್ತೇನೆ.</para>
  <para style="q2" vid="AMO 5:21">ನಿಮ್ಮ ಸಭೆಗಳು ನನಗೆ ದುರ್ವಾಸನೆ ಇದ್ದಂತೆ.<verse eid="AMO 5:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="AMO 5:22"/>ನೀವು ನನಗೆ ದಹನಬಲಿಗಳನ್ನೂ ಧಾನ್ಯ ಸಮರ್ಪಣೆಗಳನ್ನೂ ಅರ್ಪಿಸಿದರೂ,</para>
  <para style="q2" vid="AMO 5:22">ನಾನು ಅವುಗಳನ್ನು ಅಂಗೀಕರಿಸುವುದಿಲ್ಲ.</para>
  <para style="q1" vid="AMO 5:22">ನಿಮ್ಮ ಕೊಬ್ಬಿದ ಪ್ರಾಣಿಗಳ ಸಮಾಧಾನದ ಬಲಿಗಳನ್ನೂ</para>
  <para style="q2" vid="AMO 5:22">ನಾನು ಲಕ್ಷಿಸುವುದಿಲ್ಲ.<verse eid="AMO 5:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="AMO 5:23"/>ನಿಮ್ಮ ಹಾಡುಗಳ ಬೊಬ್ಬೆಗಳನ್ನು ನನ್ನಿಂದ ತೊಲಗಿಸಿರಿ.</para>
  <para style="q2" vid="AMO 5:23">ನಿಮ್ಮ ವೀಣೆಗಳ ಮಧುರ ಸ್ವರವನ್ನು ನಾನು ಕೇಳುವುದಿಲ್ಲ.<verse eid="AMO 5:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="AMO 5:24"/>ಆದರೆ ನ್ಯಾಯವು ನೀರಿನಂತೆಯೂ</para>
  <para style="q2" vid="AMO 5:24">ನೀತಿಯು ಬಲವಾದ ಪ್ರವಾಹದಂತೆಯೂ ಹರಿಯಲಿ.<verse eid="AMO 5:24"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="25" style="v" sid="AMO 5:25"/>ಇಸ್ರಾಯೇಲಿನ ಮನೆತನದವರೇ,</para>
  <para style="q2" vid="AMO 5:25">ನೀವು ನನಗೆ ನಲವತ್ತು ವರ್ಷ ಮರುಭೂಮಿಯಲ್ಲಿ ಬಲಿಗಳನ್ನು, ಕಾಣಿಕೆಗಳನ್ನು ಅರ್ಪಿಸಿದಿರೋ?<verse eid="AMO 5:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="AMO 5:26"/>ಆದರೆ ನೀವು ನಿಮಗೋಸ್ಕರ ಮಾಡಿಕೊಂಡ ಮೂರ್ತಿಗಳಾದ</para>
  <para style="q2" vid="AMO 5:26">ಸಿಕ್ಕೊತ್ ಎಂಬ ನಿಮ್ಮ ರಾಜನನ್ನೂ</para>
  <para style="q2" vid="AMO 5:26">ಕಿಯೂನ್ ಎಂಬ ನಿಮ್ಮ ನಕ್ಷತ್ರ ದೇವತೆಯನ್ನೂ</para>
  <para style="q2" vid="AMO 5:26">ನೀವೇ ಹೊತ್ತುಕೊಂಡು ಹೋಗಬೇಕಾಗುವುದು.<verse eid="AMO 5:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="AMO 5:27"/>ಆದ್ದರಿಂದ ದಮಸ್ಕದ ಆಚೆ ನಿಮ್ಮನ್ನು ಸೆರೆಯಾಳುಗಳಾಗಿ ಕಳುಹಿಸುವೆ,</para>
  <para style="q2" vid="AMO 5:27">ಎಂದು ಸರ್ವಶಕ್ತರಾದ ದೇವರೆಂದು ಹೆಸರುಗೊಂಡ ಯೆಹೋವ ದೇವರು ಹೇಳುತ್ತಾರೆ.<verse eid="AMO 5:27"/></para>
  <chapter eid="AMO 5"/>
  <chapter number="6" style="c" sid="AMO 6"/>
  <para style="s1">ನಿಶ್ಚಿಂತೆಯಿಂದ ಇರುವವರಿಗೆ ಕಷ್ಟ</para>
  <para style="q1">
    <verse number="1" style="v" sid="AMO 6:1"/>ಚೀಯೋನಿನಲ್ಲಿ ಹಾಯಾಗಿರುವವರಿಗೂ,</para>
  <para style="q2" vid="AMO 6:1">ಸಮಾರ್ಯ ಬೆಟ್ಟದಲ್ಲಿ ಸುಭದ್ರವಾಗಿರುವವರಿಗೂ,</para>
  <para style="q1" vid="AMO 6:1">ಇಸ್ರಾಯೇಲಿನ ಮನೆತನದವರು ಯಾರ ಬಳಿಗೆ ಬರುತ್ತಾರೋ,</para>
  <para style="q2" vid="AMO 6:1">ಆ ಪ್ರಮುಖ ಜನಾಂಗದಲ್ಲಿ ಹೆಸರುಗೊಂಡವರಿಗೂ ಕಷ್ಟ!<verse eid="AMO 6:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="AMO 6:2"/>ಕಲ್ನೇ ಪಟ್ಟಣಕ್ಕೆ ಹೋಗಿ ನೋಡಿರಿ.</para>
  <para style="q2" vid="AMO 6:2">ಅಲ್ಲಿಂದ ಮಹಾ ಪಟ್ಟಣವಾದ ಹಮಾತಿಗೆ ಹೋಗಿರಿ.</para>
  <para style="q2" vid="AMO 6:2">ಅಲ್ಲಿಂದ ಫಿಲಿಷ್ಟಿಯರ ಗತ್ ಊರಿಗೆ ಇಳಿಯಿರಿ.</para>
  <para style="q1" vid="AMO 6:2">ಅವು ನಿಮ್ಮ ಎರಡು ರಾಜ್ಯಗಳಿಗಿಂತ ಶ್ರೇಷ್ಠವೋ?</para>
  <para style="q2" vid="AMO 6:2">ಅವುಗಳ ಪ್ರಾಂತ್ಯವು ನಿಮ್ಮ ಪ್ರಾಂತ್ಯಕ್ಕಿಂತ ದೊಡ್ಡದೋ?<verse eid="AMO 6:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="AMO 6:3"/>ನೀವು ಕೆಟ್ಟ ದಿವಸವನ್ನು ದೂರಮಾಡಿಕೊಂಡು,</para>
  <para style="q2" vid="AMO 6:3">ಭಯಂಕರ ಆಳ್ವಿಕೆಯನ್ನು ಹತ್ತಿರ ಮಾಡಿಕೊಳ್ಳುತ್ತೀರಿ.<verse eid="AMO 6:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="AMO 6:4"/>ದಂತದ ಮಂಚಗಳ ಮೇಲೆ ಮಲಗಿಕೊಳ್ಳುತ್ತೀರಿ.</para>
  <para style="q2" vid="AMO 6:4">ತಮ್ಮ ಹಾಸಿಗೆಗಳ ಮೇಲೆ ಹಾಯಾಗಿ ಒರಗಿಕೊಳ್ಳುತ್ತೀರಿ.</para>
  <para style="q1" vid="AMO 6:4">ಮಂದೆಯೊಳಗಿಂದ ಕುರಿಮರಿಗಳನ್ನೂ</para>
  <para style="q2" vid="AMO 6:4">ಹಟ್ಟಿಯ ಮಂದೆಯೊಳಗಿಂದ ಕರುಗಳನ್ನೂ ತಿನ್ನುತ್ತೀರಿ.<verse eid="AMO 6:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="AMO 6:5"/>ವೀಣೆಯ ಸ್ವರಕ್ಕೆ ಹಾಡುತ್ತೀರಿ,</para>
  <para style="q2" vid="AMO 6:5">ದಾವೀದನ ಹಾಗೆ ನಿಮಗೆ ನೀವೇ ಗಾನವಾದ್ಯಗಳನ್ನು ಕಲ್ಪಿಸಿಕೊಳ್ಳುತ್ತೀರಿ.<verse eid="AMO 6:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="AMO 6:6"/>ನೀವು ತುಂಬಿದ ಪಾತ್ರೆಗಳಲ್ಲಿ ದ್ರಾಕ್ಷಾರಸವನ್ನು ಕುಡಿಯುತ್ತೀರಿ,</para>
  <para style="q2" vid="AMO 6:6">ಶ್ರೇಷ್ಠವಾದ ಎಣ್ಣೆಗಳಿಂದ ನಿಮ್ಮನ್ನು ಅಭಿಷೇಕಿಸಿಕೊಳ್ಳುತ್ತೀರಿ.</para>
  <para style="q2" vid="AMO 6:6">ಆದರೆ ಯೋಸೇಫನ ನಷ್ಟಕ್ಕೆ ವ್ಯಸನ ಪಡುವುದಿಲ್ಲ.<verse eid="AMO 6:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="AMO 6:7"/>ಆದ್ದರಿಂದ ಸೆರೆಗೆ ಕರೆದೊಯ್ಯುವವರಲ್ಲಿ ನೀವು ಮೊದಲಿಗರಾಗಿರುವಿರಿ,</para>
  <para style="q2" vid="AMO 6:7">ಭೋಗ ಮಾಡುವವರ ಹರ್ಷ ಧ್ವನಿಯು ಗತಿಸಿ ಹೋಗುವುದು.<verse eid="AMO 6:7"/></para>
  <para style="s1">ಯೆಹೋವ ದೇವರು ಇಸ್ರಾಯೇಲಿನ ಅಹಂಕಾರವನ್ನು ಅಸಹ್ಯಪಡುತ್ತಾರೆ</para>
  <para style="p">
    <verse number="8" style="v" sid="AMO 6:8"/>ಸಾರ್ವಭೌಮ ಯೆಹೋವ ದೇವರು ಹೀಗೆ ಹೇಳುತ್ತಾರೆ. ಸರ್ವಶಕ್ತ ದೇವರಾದ ಯೆಹೋವ ದೇವರು ತಮ್ಮ ಮೇಲೆ ಆಣೆಯಿಟ್ಟುಕೊಂಡಿದ್ದಾರೆ:</para>
  <para style="q1" vid="AMO 6:8">ನಾನು ಯಾಕೋಬಿನ ಅಹಂಕಾರವನ್ನು ಅಸಹ್ಯಿಸಿಕೊಂಡು,</para>
  <para style="q2" vid="AMO 6:8">ಅವನ ಅರಮನೆಗಳನ್ನು ಹಗೆಮಾಡುತ್ತೇನೆ.</para>
  <para style="q1" vid="AMO 6:8">ಆದಕಾರಣ ಪಟ್ಟಣವನ್ನೂ ಅದರಲ್ಲಿರುವ ಸಮಸ್ತವನ್ನೂ</para>
  <para style="q2" vid="AMO 6:8">ನಾನು ಒಪ್ಪಿಸಿ ಬಿಡುತ್ತೇನೆ.<verse eid="AMO 6:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="AMO 6:9"/>ಒಂದು ಮನೆಯಲ್ಲಿ ಹತ್ತು ಜನರು ಉಳಿದರೆ, ಅವರು ಸಾಯುವರು. <verse eid="AMO 6:9"/><verse number="10" style="v" sid="AMO 6:10"/>ಮತ್ತು ಸಂಬಂಧಿಯೊಬ್ಬರು ಮೃತ ದೇಹಗಳನ್ನು ಸುಡಲು ಆ ಮನೆಯಿಂದ ಹೊರತೆಗೆಯಲು ಬಂದಾಗ ಮತ್ತು ಅಲ್ಲಿ ಅಡಗಿಕೊಂಡಿದ್ದ ವ್ಯಕ್ತಿಯನ್ನು, “ನಿಮ್ಮೊಂದಿಗೆ ಬೇರೆ ಯಾರಾದರೂ ಇದ್ದಾರೆಯೇ?” ಎಂದು ಕೇಳಲು ಅವನು ಇಲ್ಲ ಎನ್ನುವನು. ಆಗ ಆ ಸಂಬಂಧಿಕನು, “ಮೌನದಿಂದಿರು! ನಾವು ಯೆಹೋವ ದೇವರ ಹೆಸರನ್ನು ತೆಗೆದುಕೊಳ್ಳಬಾರದು.”<verse eid="AMO 6:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="AMO 6:11"/>ಏಕೆಂದರೆ, ಯೆಹೋವ ದೇವರು ಆಜ್ಞಾಪಿಸುತ್ತಾರೆ,</para>
  <para style="q2" vid="AMO 6:11">ಆತನು ದೊಡ್ಡ ಮನೆಯನ್ನು ಸೀಳುಗಳಿಂದಲೂ</para>
  <para style="q2" vid="AMO 6:11">ಚಿಕ್ಕ ಮನೆಯನ್ನು ಬಿರುಕುಗಳಿಂದಲೂ ಹೊಡೆಯುವನು.<verse eid="AMO 6:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="AMO 6:12"/>ಕುದುರೆಗಳು ಬಂಡೆಯ ಮೇಲೆ ಓಡುವುದುಂಟೇ?</para>
  <para style="q2" vid="AMO 6:12">ಎತ್ತುಗಳಿಂದ ಅಲ್ಲಿ ಉಳುವನೋ?</para>
  <para style="q1" vid="AMO 6:12">ನಿಮ್ಮ ನ್ಯಾಯವನ್ನು ವಿಷವನ್ನಾಗಿ,</para>
  <para style="q2" vid="AMO 6:12">ನೀತಿ ಫಲವನ್ನು ಕಹಿಯನ್ನಾಗಿ ಬದಲಾಯಿಸಿದ್ದೀರಿ.<verse eid="AMO 6:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="AMO 6:13"/>ಏನೂ ಇಲ್ಲದಿದ್ದರಲ್ಲಿ ಸಂತೋಷ ಪಡುವವರೇ,</para>
  <para style="q2" vid="AMO 6:13">ನೀವು ಹೆಚ್ಚಳ ಪಡುವುದು ಶೂನ್ಯವಾಗಿರುವುದರಲ್ಲಿಯೇ?</para>
  <para style="q2" vid="AMO 6:13">“ಸ್ವಬಲದಿಂದ ಕೊಂಬುಗಳನ್ನು ತೆಗೆದುಕೊಂಡಿಲ್ಲವೇ?” ಅಂದುಕೊಳ್ಳುತ್ತೀರಿ.<verse eid="AMO 6:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="AMO 6:14"/>ಸರ್ವಶಕ್ತರಾದ ಯೆಹೋವ ದೇವರು ಹೀಗೆ ಹೇಳುತ್ತಾರೆ:</para>
  <para style="q2" vid="AMO 6:14">ಇಸ್ರಾಯೇಲಿನ ಮನೆತನದವರೇ,</para>
  <para style="q2" vid="AMO 6:14">ಜನಾಂಗವನ್ನು ನಿಮಗೆ ವಿರೋಧವಾಗಿ ಎಬ್ಬಿಸುವೆನು.</para>
  <para style="q2" vid="AMO 6:14">ಲೆಬೊ ಹಮಾತಿನ ಪ್ರದೇಶದಿಂದ ಅರಾಬಾ ತಗ್ಗಿನ ನದಿಯವರೆಗೂ ನಿಮ್ಮನ್ನು ಹಿಂಸಿಸುವರು.<verse eid="AMO 6:14"/></para>
  <chapter eid="AMO 6"/>
  <chapter number="7" style="c" sid="AMO 7"/>
  <para style="s1">ಮಿಡತೆಗಳು, ಬೆಂಕಿ ಮತ್ತು ಒಂದು ನೂಲುಗುಂಡು</para>
  <para style="p">
    <verse number="1" style="v" sid="AMO 7:1"/>ಸಾರ್ವಭೌಮ ಯೆಹೋವ ದೇವರು ನನಗೆ ಹೀಗೆ ತೋರಿಸಿದರು: ಹಿಂಗಾರು ಮಳೆ ಬಿದ್ದು, ಪೈರು ಸೊಂಪಾಗುವುದಕ್ಕೆ ಆರಂಭವಾದಾಗ, ಅಂದರೆ ರಾಜಾದಾಯದ ಹುಲ್ಲನ್ನು ಕೊಯ್ದ ಮೇಲೆ, ಬೆಳೆಯು ವೃದ್ಧಿಯಾಗುತ್ತಿದ್ದಾಗ, ಇಗೋ ಯೆಹೋವ ದೇವರು, ಮಿಡತೆಗಳನ್ನು ಉಂಟುಮಾಡಿದರು. <verse eid="AMO 7:1"/><verse number="2" style="v" sid="AMO 7:2"/>ಅವು ದೇಶದ ಹುಲ್ಲನ್ನು ತಿಂದು ಮುಗಿಸಿದ ಮೇಲೆ ನಾನು, “ಸಾರ್ವಭೌಮ ಯೆಹೋವ ದೇವರೇ, ಲಾಲಿಸು, ನನ್ನನ್ನು ಮನ್ನಿಸು. ಯಾಕೋಬ ಜನಾಂಗ ಹೇಗೆ ಉಳಿಯುವುದು? ಏಕೆಂದರೆ ಅದು ಚಿಕ್ಕದಾದ ಜನಾಂಗ,” ಎಂದು ವಿಜ್ಞಾಪಿಸಿಕೊಂಡೆನು.<verse eid="AMO 7:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="AMO 7:3"/>ಯೆಹೋವ ದೇವರು ಇದನ್ನು ಕುರಿತು ಮನಮರುಗಿ,</para>
  <para style="p" vid="AMO 7:3">“ಈ ದರ್ಶನ ನೆರವೇರುವುದಿಲ್ಲ,” ಎಂದರು.<verse eid="AMO 7:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="AMO 7:4"/>ಸಾರ್ವಭೌಮ ಯೆಹೋವ ದೇವರು ನನಗೆ ಹೀಗೆ ತೋರಿಸಿದರು: ಸಾರ್ವಭೌಮ ಯೆಹೋವ ದೇವರು ಬೆಂಕಿಯಿಂದ ನ್ಯಾಯತೀರ್ಪು ಮಾಡುವುದಕ್ಕೆ ಕರೆದರು. ಅದು ದೊಡ್ಡ ಅಗಾಧವನ್ನು ನುಂಗಿತು ಮತ್ತು ವಿಭಾಗವನ್ನು ತಿಂದುಬಿಟ್ಟಿತು. <verse eid="AMO 7:4"/><verse number="5" style="v" sid="AMO 7:5"/>ಆಗ ನಾನು, “ಸಾರ್ವಭೌಮ ಯೆಹೋವ ದೇವರೇ, ನಿಲ್ಲಿಸಿಬಿಡಿರಿ,” ಎಂದು ಬೇಡಿಕೊಳ್ಳುತ್ತೇನೆ. “ಯಾಕೋಬನು ಹೇಗೆ ಬದುಕುಳಿಯುತ್ತಾನೆ? ಅವನು ತುಂಬಾ ಚಿಕ್ಕವನು,” ಎಂದು ಮೊರೆಯಿಟ್ಟೆನು.<verse eid="AMO 7:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="AMO 7:6"/>ಆಗ ಸಾರ್ವಭೌಮ ಯೆಹೋವ ದೇವರು ಇದನ್ನು ಕುರಿತು ಮನಮರುಗಿ,</para>
  <para style="p" vid="AMO 7:6">“ಈ ದರ್ಶನ ನೆರವೇರುವುದಿಲ್ಲ,” ಎಂದರು.<verse eid="AMO 7:6"/></para>
  <para style="b"/>
  <para style="p">
    <verse number="7" style="v" sid="AMO 7:7"/>ಆತನು ನನಗೆ ಹೀಗೆ ತೋರಿಸಿದನು. ಯೆಹೋವ ದೇವರು ನೂಲುಮಟ್ಟದ ನೆಟ್ಟಗಿರುವ ಗೋಡೆಯ ಮೇಲೆ ನಿಂತಿದ್ದರು. ಆತನ ಕೈಯಲ್ಲಿ ನೂಲುಗುಂಡು ಇತ್ತು. <verse eid="AMO 7:7"/><verse number="8" style="v" sid="AMO 7:8"/>ಯೆಹೋವ ದೇವರು ನನಗೆ, “ಆಮೋಸನೇ, ಏನನ್ನು ನೋಡುತ್ತಿರುವೆ?” ಎಂದು ಕೇಳಿದರು.</para>
  <para style="p" vid="AMO 7:8">ಆಗ ನಾನು, “ನೂಲುಗುಂಡು,” ಎಂದೆನು.</para>
  <para style="p" vid="AMO 7:8">ನಂತರ ಯೆಹೋವ ದೇವರು ಹೇಳಿದ್ದೇನೆಂದರೆ, “ನೋಡು, ನಾನು ನನ್ನ ಜನರಾದ ಇಸ್ರಾಯೇಲರ ಮಧ್ಯದಲ್ಲಿ ನೂಲುಗುಂಡನ್ನು ಇಡುತ್ತೇನೆ. ಇನ್ನು ಮೇಲೆ ಅವರನ್ನು ದಾಟಿ ಹೋಗುವುದಿಲ್ಲ.<verse eid="AMO 7:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="AMO 7:9"/>“ಇಸಾಕನ ಉನ್ನತ ಪೂಜಾಸ್ಥಳಗಳು ನಾಶವಾಗುವುವು.</para>
  <para style="q2" vid="AMO 7:9">ಇಸ್ರಾಯೇಲಿನ ಪರಿಶುದ್ಧ ಸ್ಥಳಗಳು ಹಾಳಾಗುವುವು.</para>
  <para style="q2" vid="AMO 7:9">ನಾನು ಖಡ್ಗದೊಂದಿಗೆ ಯಾರೊಬ್ಬಾಮನ ಮನೆತನಕ್ಕೆ ವಿರುದ್ಧವಾಗಿ ಏಳುವೆನು.”<verse eid="AMO 7:9"/></para>
  <para style="s1">ಆಮೋಸನು ಮತ್ತು ಅಮಚ್ಯನು</para>
  <para style="p">
    <verse number="10" style="v" sid="AMO 7:10"/>ಆಗ ಬೇತೇಲಿನ ಯಾಜಕನಾದ ಅಮಚ್ಯನು, ಇಸ್ರಾಯೇಲಿನ ಅರಸನಾದ ಯಾರೊಬ್ಬಾಮನಿಗೆ ಕಳುಹಿಸಿ ಹೇಳಿದ್ದೇನೆಂದರೆ: “ಆಮೋಸನು ಇಸ್ರಾಯೇಲಿನ ಮನೆತನದವರ ಮಧ್ಯದಲ್ಲಿ ನಿನಗೆ ವಿರೋಧವಾಗಿ ಒಳಸಂಚು ಮಾಡಿದ್ದಾನೆ. ದೇಶವು ಅವನ ಎಲ್ಲಾ ಮಾತುಗಳನ್ನು ತಾಳಲಾರದು. <verse eid="AMO 7:10"/><verse number="11" style="v" sid="AMO 7:11"/>ಆಮೋಸನು ಹೇಳಿದ್ದೇನೆಂದರೆ:</para>
  <para style="q1" vid="AMO 7:11">“ಯಾರೊಬ್ಬಾಮನು ಖಡ್ಗದಿಂದ ಸಾಯುವನೆಂದೂ</para>
  <para style="q2" vid="AMO 7:11">ಇಸ್ರಾಯೇಲರು ನಿಶ್ಚಯವಾಗಿ ತಮ್ಮ ಸ್ವದೇಶದಿಂದ ಸೆರೆಯಾಗಿ ಕರೆದೊಯ್ಯುವರು.”<verse eid="AMO 7:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="AMO 7:12"/>ಅನಂತರ ಅಮಚ್ಯನು ಆಮೋಸನಿಗೆ ಹೇಳಿದ್ದೇನೆಂದರೆ: “ದರ್ಶಿಯೇ, ಯೆಹೂದ ದೇಶಕ್ಕೆ ಓಡಿಹೋಗು. ಅಲ್ಲಿ ದುಡಿದು ರೊಟ್ಟಿ ತಿಂದು ಅಲ್ಲಿಯೇ ಪ್ರವಾದಿಸು. <verse eid="AMO 7:12"/><verse number="13" style="v" sid="AMO 7:13"/>ಆದರೆ ಇನ್ನು ಮೇಲೆ ಬೇತೇಲಿನಲ್ಲಿ ಪ್ರವಾದಿಸಬೇಡ. ಏಕೆಂದರೆ ಅದು ಅರಸನ ಪರಿಶುದ್ಧ ಸ್ಥಾನವಾಗಿಯೂ, ರಾಜ್ಯದ ಆಲಯವಾಗಿಯೂ ಇದೆ,” ಎಂದನು.<verse eid="AMO 7:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="AMO 7:14"/>ಆಗ ಆಮೋಸನು ಅಮಚ್ಯನಿಗೆ ಉತ್ತರವಾಗಿ, “ನಾನು ಪ್ರವಾದಿಯಲ್ಲ, ಪ್ರವಾದಿಯ ಮಗನೂ ಅಲ್ಲ. ಆದರೆ ನಾನು ಕುರುಬನೂ ಅತ್ತಿಹಣ್ಣುಗಳನ್ನು ಕೂಡಿಸುವವನೂ ಆಗಿದ್ದೆನು,” ಎಂದನು. <verse eid="AMO 7:14"/><verse number="15" style="v" sid="AMO 7:15"/>ನಾನು ಕುರಿಯ ಹಿಂಡನ್ನು ಹಿಂಬಾಲಿಸುವ ವೇಳೆಯಲ್ಲಿ, ಯೆಹೋವ ದೇವರು ನನ್ನನ್ನು ಕರೆದು ಹೇಳಿದ್ದೇನೆಂದರೆ: “ನೀನು ಹೋಗಿ ನನ್ನ ಜನರಾದ ಇಸ್ರಾಯೇಲರಿಗೆ ಪ್ರವಾದಿಸು.” <verse eid="AMO 7:15"/><verse number="16" style="v" sid="AMO 7:16"/>ಹೀಗಿರುವುದರಿಂದ ನೀನು ಈಗ ಯೆಹೋವ ದೇವರ ವಾಕ್ಯವನ್ನು ಕೇಳು:</para>
  <para style="q1" vid="AMO 7:16">ಇಸ್ರಾಯೇಲಿಗೆ ಪ್ರವಾದನೆ ಮಾಡಬೇಡವೆಂದೂ,</para>
  <para style="q2" vid="AMO 7:16">ಇಸಾಕನ ಮನೆತನಕ್ಕೆ ವಿರೋಧವಾಗಿ ಖಂಡನೆ ಮಾಡಬಾರದೆಂದೂ ನೀನು ಹೇಳುವೆಯಲ್ಲಾ.<verse eid="AMO 7:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="AMO 7:17"/>ಆದ್ದರಿಂದ ಯೆಹೋವ ದೇವರು ಹೇಳುವುದೇನೆಂದರೆ:</para>
  <para style="q1" vid="AMO 7:17">“ ‘ನಿನ್ನ ಹೆಂಡತಿ ಪಟ್ಟಣದಲ್ಲಿ ವ್ಯಭಿಚಾರಿಣಿಯಾಗುವಳು.</para>
  <para style="q2" vid="AMO 7:17">ನಿನ್ನ ಪುತ್ರ ಪುತ್ರಿಯರೂ ಖಡ್ಗದಿಂದ ಬೀಳುವರು.</para>
  <para style="q1" vid="AMO 7:17">ನಿನ್ನ ದೇಶವನ್ನು ಅಳೆಯಲಾಗುತ್ತದೆ ಮತ್ತು ವಿಭಾಗಿಸಲಾಗುತ್ತದೆ.</para>
  <para style="q2" vid="AMO 7:17">ನೀನು ಅಪವಿತ್ರವಾದ ದೇಶದಲ್ಲಿ ಸಾಯುವಿ.</para>
  <para style="q2" vid="AMO 7:17">ಇಸ್ರಾಯೇಲ್ ನಿಶ್ಚಯವಾಗಿ ತನ್ನ ದೇಶದಿಂದ ಸೆರೆಯಾಗಿ ಕರೆದೊಯ್ಯಲಾಗುವುದು.’ ”<verse eid="AMO 7:17"/></para>
  <chapter eid="AMO 7"/>
  <chapter number="8" style="c" sid="AMO 8"/>
  <para style="s1">ಮಾಗಿದ ಹಣ್ಣುಗಳುಳ್ಳ ಪುಟ್ಟಿ</para>
  <para style="p">
    <verse number="1" style="v" sid="AMO 8:1"/>ಸಾರ್ವಭೌಮ ಯೆಹೋವ ದೇವರು ನನಗೆ ಮಾಗಿದ ಹಣ್ಣುಗಳುಳ್ಳ ಬುಟ್ಟಿ ತೋರಿಸಿದರು. <verse eid="AMO 8:1"/><verse number="2" style="v" sid="AMO 8:2"/>ಆಗ, “ಆಮೋಸನೇ, ಏನು ನೋಡುತ್ತಿರುವೆ?” ಎಂದು ಕೇಳಿದರು.</para>
  <para style="p" vid="AMO 8:2">ನಾನು, “ಮಾಗಿದ ಹಣ್ಣುಗಳ ಬುಟ್ಟಿ,” ಎಂದೆನು.</para>
  <para style="p" vid="AMO 8:2">ಆಗ ಯೆಹೋವ ದೇವರು ನನಗೆ, “ನನ್ನ ಜನರಾದ ಇಸ್ರಾಯೇಲರ ಸಮಯವು ಮಾಗುತ್ತಾ ಬಂತು. ನಾನು ಇನ್ನು ಮೇಲೆ ಅವರನ್ನು ಉಳಿಸುವುದಿಲ್ಲ,” ಎಂದು ಹೇಳಿದರು.<verse eid="AMO 8:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="AMO 8:3"/>“ಆ ದಿನದಲ್ಲಿ ದೇವಾಲಯದ ಹಾಡುಗಳು ವಿಲಾಪವಾಗುವುವು,” ಎಂದು ಸಾರ್ವಭೌಮ ಯೆಹೋವ ದೇವರು ಹೇಳುತ್ತಾರೆ. “ಎಲ್ಲಾ ಕಡೆಗಳಲ್ಲಿ ಅನೇಕ ಹೆಣಗಳು ಬಿದ್ದಿರುವುವು. ಮೌನವಾಗಿರಿ!”<verse eid="AMO 8:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="AMO 8:4"/>ಬಡವರನ್ನು ನುಂಗುವವರೇ,</para>
  <para style="q2" vid="AMO 8:4">ನಾಡಿನ ಬಡವರನ್ನು ಮುಗಿಸಿಬಿಡಬೇಕೆಂದಿರುವವರೇ, ಇದನ್ನು ಕೇಳಿರಿ.<verse eid="AMO 8:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="AMO 8:5"/>ನೀವು ಹೇಳುವುದೇನೆಂದರೆ,</para>
  <para style="q1" vid="AMO 8:5">“ನಾವು ಧಾನ್ಯವನ್ನು ಮಾರುವ ಹಾಗೆ</para>
  <para style="q2" vid="AMO 8:5">ಅಮಾವಾಸ್ಯೆಯು ಯಾವಾಗ ಕೊನೆಗೊಳ್ಳುತ್ತದೆ?</para>
  <para style="q1" vid="AMO 8:5">ಗೋಧಿಯನ್ನು ಮಾರುವ ಹಾಗೆ</para>
  <para style="q2" vid="AMO 8:5">ಸಬ್ಬತ್ ದಿನವು ಯಾವಾಗ ಮುಗಿಯುವುದು?</para>
  <para style="q1" vid="AMO 8:5">ಕೊಳಗವನ್ನು ಚಿಕ್ಕದಾಗಿಯೂ ತೊಲಗಳನ್ನು ದೊಡ್ಡದಾಗಿಯೂ,</para>
  <para style="q2" vid="AMO 8:5">ಕಳ್ಳತಕ್ಕಡಿಗಳನ್ನು ಮೋಸಕ್ಕಾಗಿಯೂ ಮಾಡೋಣವೆಂದೂ,<verse eid="AMO 8:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="AMO 8:6"/>ಬಡವರನ್ನು ಬೆಳ್ಳಿಗೂ</para>
  <para style="q2" vid="AMO 8:6">ದರಿದ್ರರನ್ನು ಕೆರಗಳ ಜೋಡಿಗೂ ಕೊಂಡುಕೊಳ್ಳುವೆವು,</para>
  <para style="q2" vid="AMO 8:6">ಹೌದು ಗೋಧಿಯ ಕಸವನ್ನು ಸಹ ಮಾರೋಣ.”<verse eid="AMO 8:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="AMO 8:7"/>ಯೆಹೋವ ದೇವರು ಯಾಕೋಬಿನ ಅಹಂಕಾರದ ಮೇಲೆ ಆಣೆ ಇಟ್ಟುಕೊಂಡು ಹೇಳುವುದೇನೆಂದರೆ: “ನಿಶ್ಚಯವಾಗಿಯೂ ನಾನು ಎಂದೆಂದಿಗೂ ಅವರ ಯಾವ ಕ್ರಿಯೆಗಳನ್ನೂ ಮರೆಯುವುದಿಲ್ಲ.<verse eid="AMO 8:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="AMO 8:8"/>“ಇದಕ್ಕಾಗಿ ದೇಶವು ನಡುಗುವುದಿಲ್ಲವೇ?</para>
  <para style="q2" vid="AMO 8:8">ಅದರಲ್ಲಿ ವಾಸಿಸುವವರೆಲ್ಲರೂ ಗೋಳಾಡುವುದಿಲ್ಲವೇ?</para>
  <para style="q1" vid="AMO 8:8">ದೇಶವೆಲ್ಲಾ ನೈಲ್ ನದಿಯ ಪ್ರವಾಹದಂತೆ ಉಬ್ಬಿ ಅಲ್ಲೊಲಕಲ್ಲೋಲವಾಗುವುದು,</para>
  <para style="q2" vid="AMO 8:8">ಈಜಿಪ್ಟಿನ ನದಿಯಂತೆ ಇಳಿದುಹೋಗುವದು.<verse eid="AMO 8:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="AMO 8:9"/>“ಸಾರ್ವಭೌಮ ಯೆಹೋವ ದೇವರು ಹೇಳುತ್ತಾರೆ,</para>
  <para style="q1" vid="AMO 8:9">“ಆ ದಿನದಲ್ಲಿ,” ನಾನು ಸೂರ್ಯನನ್ನು ಮಧ್ಯಾಹ್ನದಲ್ಲಿ ಮುಳುಗುವಂತೆ ಮಾಡುತ್ತೇನೆ.</para>
  <para style="q2" vid="AMO 8:9">ಭೂಮಿಯನ್ನು ಹಗಲಲ್ಲೇ ಕತ್ತಲಾಗುವಂತೆ ಮಾಡುತ್ತೇನೆ.<verse eid="AMO 8:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="AMO 8:10"/>ನಿಮ್ಮ ಹಬ್ಬಗಳನ್ನು ದುಃಖಕ್ಕೂ,</para>
  <para style="q2" vid="AMO 8:10">ನಿಮ್ಮ ಹಾಡುಗಳನ್ನೆಲ್ಲಾ ಗೋಳಾಟಕ್ಕೂ ಬದಲಾಯಿಸುವೆನು.</para>
  <para style="q1" vid="AMO 8:10">ಎಲ್ಲರೂ ಸೊಂಟಗಳಿಗೆ ಗೋಣಿತಟ್ಟನ್ನು ಕಟ್ಟಿಕೊಂಡು,</para>
  <para style="q2" vid="AMO 8:10">ತಲೆಗಳನ್ನು ಬೋಳಿಸಿಕೊಳ್ಳುವಂತೆ ಮಾಡುವೆನು.</para>
  <para style="q1" vid="AMO 8:10">ಒಬ್ಬನೇ ಮಗನಿಗಾಗಿ ಗೋಳಾಡುವ ಸಮಯದಂತೆ ಮಾಡುವೆನು.</para>
  <para style="q2" vid="AMO 8:10">ಅದರ ಅಂತ್ಯವು ಕಹಿಯಾದ ದಿನದಂತಿರುವುದು.<verse eid="AMO 8:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="AMO 8:11"/>ದಿನಗಳು ಬರುವುವು,</para>
  <para style="q2" vid="AMO 8:11">ಆಗ ನಾನು ದೇಶದಲ್ಲಿ ಕ್ಷಾಮವನ್ನು ಕಳುಹಿಸುವೆನು.</para>
  <para style="q1" vid="AMO 8:11">ಅದು ರೊಟ್ಟಿಯ ಕ್ಷಾಮವಲ್ಲ, ನೀರಿನ ದಾಹದ ಬರವಲ್ಲ.</para>
  <para style="q2" vid="AMO 8:11">ಯೆಹೋವ ದೇವರ ವಾಕ್ಯಗಳನ್ನು ಕೇಳಬೇಕೆಂಬ ಕ್ಷಾಮವನ್ನೇ,</para>
  <para style="q2" vid="AMO 8:11">ಎಂದು ಸಾರ್ವಭೌಮ ಯೆಹೋವ ದೇವರು ಹೇಳುತ್ತಾನೆ.<verse eid="AMO 8:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="AMO 8:12"/>ಆಗ ಅವರು ಸಮುದ್ರದಿಂದ ಸಮುದ್ರಕ್ಕೂ,</para>
  <para style="q2" vid="AMO 8:12">ಉತ್ತರದಿಂದ ಪೂರ್ವಕ್ಕೂ ಅಲೆದು</para>
  <para style="q1" vid="AMO 8:12">ಯೆಹೋವ ದೇವರ ವಾಕ್ಯವನ್ನು ಹುಡುಕುವುದಕ್ಕೆ ಅತ್ತಿತ್ತ ಓಡಾಡಿ, ಅದನ್ನು ಕಾಣದೆ ಹೋಗುವರು.<verse eid="AMO 8:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="AMO 8:13"/>“ಆ ದಿನದಲ್ಲಿ,</para>
  <para style="q1" vid="AMO 8:13">“ಸೌಂದರ್ಯವತಿಯರಾದ ಕನ್ಯೆಯರು</para>
  <para style="q2" vid="AMO 8:13">ಮತ್ತು ಯೌವನಸ್ಥರು ಸಹ ದಾಹದಿಂದ ಕುಗ್ಗಿ ಹೋಗುವರು.<verse eid="AMO 8:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="AMO 8:14"/>ಅವರು ಸಮಾರ್ಯದ ಪಾಪದ ಮೇಲೆ ಆಣೆ ಇಟ್ಟುಕೊಂಡು,</para>
  <para style="q2" vid="AMO 8:14">ದಾನೇ, ನಿನ್ನ ದೇವರ ಜೀವದಾಣೆ ಎಂದೂ,</para>
  <para style="q2" vid="AMO 8:14">ಬೇರ್ಷೆಬದ ಮಾರ್ಗದ ಜೀವದಾಣೆ ಎಂದೂ ಹೇಳುವರು.</para>
  <para style="q2" vid="AMO 8:14">ಅವರು ಬಿದ್ದು ಮತ್ತೆ ಮೇಲೆ ಏಳಲಾರರು.”<verse eid="AMO 8:14"/></para>
  <chapter eid="AMO 8"/>
  <chapter number="9" style="c" sid="AMO 9"/>
  <para style="s1">ಇಸ್ರಾಯೇಲು ನಾಶವಾಗುವುದು</para>
  <para style="p">
    <verse number="1" style="v" sid="AMO 9:1"/>ಕರ್ತದೇವರು ಬಲಿಪೀಠದ ಪಕ್ಕದಲ್ಲಿ ನಿಂತಿರುವುದನ್ನು ನಾನು ಕಂಡೆನು. ಅವರು ಹೇಳಿದ್ದೇನೆಂದರೆ:</para>
  <para style="q1" vid="AMO 9:1">“ಹೊಸ್ತಿಲುಗಳು ಕದಲುವಂತೆ</para>
  <para style="q2" vid="AMO 9:1">ಆಧಾರ ಬೋದಿಗೆಗಳನ್ನು ಬಲವಾಗಿ ಹೊಡೆದು,</para>
  <para style="q1" vid="AMO 9:1">ಅವು ಎಲ್ಲರ ತಲೆಗಳ ಮೇಲೆ ಬೀಳುವ ಹಾಗೆ ಅವುಗಳನ್ನು ಕಡಿದುಬಿಡು.</para>
  <para style="q2" vid="AMO 9:1">ಅವರಲ್ಲಿ ಉಳಿದವರನ್ನು ಖಡ್ಗದಿಂದ ಕೊಲ್ಲುವೆನು.</para>
  <para style="q2" vid="AMO 9:1">ಅವರಲ್ಲಿ ಓಡಿಹೋಗುವವನು ಓಡಿಹೋಗಲಾಗುವುದಿಲ್ಲ.<verse eid="AMO 9:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="AMO 9:2"/>ಅವರು ಪಾತಾಳದವರೆಗೂ ಅಗೆದುಕೊಂಡು ಹೋದರೂ,</para>
  <para style="q2" vid="AMO 9:2">ನನ್ನ ಕೈ ಅವರನ್ನು ಅಲ್ಲಿಂದ ಹಿಡಿದೆಳೆಯುವುದು.</para>
  <para style="q1" vid="AMO 9:2">ಅವರು ಆಕಾಶಕ್ಕೆ ಏರಿಹೋದರೂ,</para>
  <para style="q2" vid="AMO 9:2">ನಾನು ಅವರನ್ನು ಅಲ್ಲಿಂದ ಕೆಳಗೆ ಇಳಿಸುವೆನು.<verse eid="AMO 9:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="AMO 9:3"/>ಅವರು ಕರ್ಮೆಲಿನ ಬೆಟ್ಟದ ತುದಿಯಲ್ಲಿ ಅಡಗಿಕೊಂಡರೂ,</para>
  <para style="q2" vid="AMO 9:3">ನಾನು ಅವರನ್ನು ಹುಡುಕಿ, ಅಲ್ಲಿಂದ ತೆಗೆಯುವೆನು.</para>
  <para style="q1" vid="AMO 9:3">ಅವರು ನನ್ನ ದೃಷ್ಟಿಗೆ ಮರೆಯಾಗಿ ಸಮುದ್ರದ ತಳದಲ್ಲಿ ಅಡಗಿಕೊಂಡರೂ,</para>
  <para style="q2" vid="AMO 9:3">ಸರ್ಪಕ್ಕೆ ಅಪ್ಪಣೆಕೊಟ್ಟು, ಅದು ಅವರನ್ನು ಅಲ್ಲೇ ಕಚ್ಚುವಂತೆ ಮಾಡುವೆನು.<verse eid="AMO 9:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="AMO 9:4"/>ಅವರು ತಮ್ಮ ಶತ್ರುಗಳ ಮುಂದೆ ಸೆರೆಗೆ ಹೋಗಿದ್ದರೂ,</para>
  <para style="q2" vid="AMO 9:4">ಖಡ್ಗವು ನನ್ನ ಆಜ್ಞಾನುಸಾರ ಅಲ್ಲಿಯೂ ಅವರನ್ನು ಕೊಲ್ಲುವುದು.</para>
  <para style="b" vid="AMO 9:4"/>
  <para style="q1" vid="AMO 9:4">“ಅವರ ಮೇಲಿಗಾಗಿ ಅಲ್ಲ,</para>
  <para style="q2" vid="AMO 9:4">ಕೇಡಿಗಾಗಿ ಅವರ ಮೇಲೆ ನನ್ನ ದೃಷ್ಟಿಯಿಡುವೆನು.”<verse eid="AMO 9:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="AMO 9:5"/>ಸೇನಾಧೀಶ್ವರ ಯೆಹೋವ ದೇವರಾದ ಕರ್ತರೇ,</para>
  <para style="q1" vid="AMO 9:5">ನೀವು ದೇಶವನ್ನು ಮುಟ್ಟಿದ ಮಾತ್ರಕ್ಕೆ ಅದು ಕರಗಿ ಹೋಗುವುದು.</para>
  <para style="q2" vid="AMO 9:5">ಅದರಲ್ಲಿ ವಾಸವಾಗಿರುವವರೆಲ್ಲರೂ ಗೋಳಾಡುವರು.</para>
  <para style="q1" vid="AMO 9:5">ಅವೆಲ್ಲಾ ನೈಲ್ ನದಿಯ ಹಾಗೆ ಪ್ರವಾಹದಂತೆ ಉಕ್ಕಿ,</para>
  <para style="q2" vid="AMO 9:5">ಈಜಿಪ್ಟಿನ ಪ್ರವಾಹದಂತೆ ಉಕ್ಕಿ ಮುಳುಗಿ ಹೋಗುವುದು.<verse eid="AMO 9:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="AMO 9:6"/>ಆಕಾಶದಲ್ಲಿ ಉಪ್ಪರಿಗೆಗಳನ್ನು ಕಟ್ಟಿಕೊಂಡು,</para>
  <para style="q2" vid="AMO 9:6">ಭೂಮಿಯ ಮೇಲೆ ತಮ್ಮ ತಂಡಗಳನ್ನು ಸ್ಥಾಪಿಸಿ,</para>
  <para style="q1" vid="AMO 9:6">ಸಮುದ್ರದ ನೀರನ್ನು ಕರೆದು,</para>
  <para style="q2" vid="AMO 9:6">ಅದನ್ನು ಭೂಮಿಯ ಮೇಲೆ ಹೊಯ್ಯುವಂತೆ ಮಾಡುವಾತರು ಅವರೇ.</para>
  <para style="q2" vid="AMO 9:6">ಅವರ ಹೆಸರು ಯೆಹೋವ ದೇವರು.<verse eid="AMO 9:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="AMO 9:7"/>“ಇಸ್ರಾಯೇಲರೇ, ನೀವು ನನಗೆ ಕೂಷ್ಯರ ಮಕ್ಕಳ ಹಾಗಲ್ಲವೇ?</para>
  <para style="q2" vid="AMO 9:7">ನಾನು ನಿಮ್ಮನ್ನು ಈಜಿಪ್ಟಿನಿಂದಲೂ ಫಿಲಿಷ್ಟಿಯರನ್ನು</para>
  <para style="q2" vid="AMO 9:7">ಕಫ್ತೋರಿನಿಂದಲೂ ಅರಾಮ್ಯರನ್ನು ಕೀರಿನಿಂದಲೂ ತರಲಿಲ್ಲವೇ?”</para>
  <para style="q2" vid="AMO 9:7">ಎಂದು ಯೆಹೋವ ದೇವರು ಹೇಳುತ್ತಾರೆ.<verse eid="AMO 9:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="AMO 9:8"/>“ಸಾರ್ವಭೌಮ ಯೆಹೋವ ದೇವರ ಕಣ್ಣುಗಳು</para>
  <para style="q2" vid="AMO 9:8">ಪಾಪವುಳ್ಳ ರಾಜ್ಯದ ಮೇಲೆ ಇವೆ.</para>
  <para style="q1" vid="AMO 9:8">ನಾನು ಅದನ್ನು ಭೂಮಿಯ ಮೇಲಿನಿಂದ ನಾಶಮಾಡುವೆನು.</para>
  <para style="q2" vid="AMO 9:8">ಆದರೆ ಯಾಕೋಬಿನ ಮನೆತನದವರನ್ನು ನಾನು ನಿಜವಾಗಿ ನಾಶಮಾಡುವುದಿಲ್ಲ,”</para>
  <para style="q2" vid="AMO 9:8">ಎಂದು ಯೆಹೋವ ದೇವರು ಹೇಳುತ್ತಾರೆ.<verse eid="AMO 9:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="AMO 9:9"/>ಧಾನ್ಯವನ್ನು ಜರಡಿಯಲ್ಲಿ ಜಾಲಿಸುವಂತೆ</para>
  <para style="q2" vid="AMO 9:9">ನಾನು ಇಸ್ರಾಯೇಲರನ್ನು ಎಲ್ಲಾ ಜನಾಂಗಗಳಲ್ಲಿ ಹಾಕಿ ಜಾಲಿಸಬೇಕೆಂದು ಆಜ್ಞಾಪಿಸುವೆನು.</para>
  <para style="q2" vid="AMO 9:9">ಆದರೂ ಒಂದು ಕಾಳಾದರೂ ನೆಲಕ್ಕೆ ಬೀಳುವುದಿಲ್ಲ.<verse eid="AMO 9:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="AMO 9:10"/>ಕೇಡು ನಮ್ಮನ್ನು ಹಿಂದಟ್ಟದು ಮತ್ತು ನಮ್ಮನ್ನು ತಡೆಯುವದೂ ಇಲ್ಲ,</para>
  <para style="q2" vid="AMO 9:10">ಎನ್ನುವ ನನ್ನ ಜನರಲ್ಲಿರುವ ಪಾಪಿಗಳೆಲ್ಲರೂ ಖಡ್ಗದಿಂದ ಸಾಯುವರು.<verse eid="AMO 9:10"/></para>
  <para style="s1">ಇಸ್ರಾಯೇಲಿನ ಪುನಃಸ್ಥಾಪನೆ</para>
  <para style="p">
    <verse number="11" style="v" sid="AMO 9:11"/>ಆ ದಿನದಲ್ಲಿ,</para>
  <para style="q1" vid="AMO 9:11">ಬಿದ್ದುಹೋದ ದಾವೀದನ ಗುಡಾರವನ್ನು ನಾನು ನಿಲ್ಲಿಸಿ</para>
  <para style="q2" vid="AMO 9:11">ಅದರ ಮುರಿದ ಗೋಡೆಗಳನ್ನು ಸರಿಪಡಿಸುತ್ತೇನೆ.</para>
  <para style="q2" vid="AMO 9:11">ಮತ್ತು ಅದರ ಅವಶೇಷಗಳನ್ನು ಪುನಃಸ್ಥಾಪಿಸಿ</para>
  <para style="q2" vid="AMO 9:11">ಮತ್ತು ಅದನ್ನು ಮೊದಲಿನಂತೆ ಪುನಃ ನಿರ್ಮಿಸುವೆನು.<verse eid="AMO 9:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="AMO 9:12"/>ಆಗ ಅವರು ಎದೋಮಿನ ಮಿಕ್ಕ ಭಾಗವನ್ನೂ,</para>
  <para style="q2" vid="AMO 9:12">ನನ್ನ ಹೆಸರಿನಿಂದ ಕರೆಯಲಾಗುವ ಎಲ್ಲಾ ಜನಾಂಗಗಳನ್ನೂ ಸ್ವಾಧೀನ ಮಾಡಿಕೊಳ್ಳುವೆನು,</para>
  <para style="q2" vid="AMO 9:12">ಎಂಬುದಾಗಿ ಇದನ್ನು ಮಾಡುವವರಾದ ಯೆಹೋವ ದೇವರು ಹೇಳುತ್ತಾರೆ.<verse eid="AMO 9:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="AMO 9:13"/>ಯೆಹೋವ ದೇವರು ಹೇಳುವುದೇನೆಂದರೆ: “ದಿನಗಳು ಬರುವುವು,”</para>
  <para style="q1" vid="AMO 9:13">“ಆಗ ಉಳುವವನು ಕೊಯ್ಯುವವನನ್ನೂ,</para>
  <para style="q2" vid="AMO 9:13">ದ್ರಾಕ್ಷಿ ಮಾರುವವನು ಬೀಜ ಹಾಕುವವನನ್ನೂ ಹಿಂದಟ್ಟುವರು.</para>
  <para style="q1" vid="AMO 9:13">ಆಗ ಬೆಟ್ಟಗಳು ಹೊಸ ಸಿಹಿ ದ್ರಾಕ್ಷಾರಸವನ್ನು ಸುರಿಯುವುವು,</para>
  <para style="q2" vid="AMO 9:13">ಗುಡ್ಡಗಳೆಲ್ಲಾ ಕರಗುವುವು.<verse eid="AMO 9:13"/></para>
  <para style="q2">
    <verse number="14" style="v" sid="AMO 9:14"/>ನನ್ನ ಜನರಾದ ಇಸ್ರಾಯೇಲರನ್ನು ಸೆರೆಯಿಂದ ತಿರುಗಿ ಬರಮಾಡುವೆನು.</para>
  <para style="b" vid="AMO 9:14"/>
  <para style="q1" vid="AMO 9:14">“ಅವರು ಹಾಳಾದ ಪಟ್ಟಣಗಳನ್ನು ಕಟ್ಟಿ ವಾಸಮಾಡುವರು.</para>
  <para style="q2" vid="AMO 9:14">ದ್ರಾಕ್ಷಿತೋಟಗಳನ್ನು ನೆಟ್ಟು, ಅವುಗಳ ದ್ರಾಕ್ಷಾರಸವನ್ನು ಕುಡಿಯುವರು.</para>
  <para style="q2" vid="AMO 9:14">ತೋಟಗಳನ್ನು ಮಾಡಿ ಅವುಗಳ ಫಲವನ್ನು ತಿನ್ನುವರು.<verse eid="AMO 9:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="AMO 9:15"/>ನಾನು ಇಸ್ರಾಯೇಲರನ್ನು ಅವರ ದೇಶದಲ್ಲಿ ನೆಡುವೆನು.</para>
  <para style="q2" vid="AMO 9:15">ನಾನು ಅವರಿಗೆ ಕೊಟ್ಟಿರುವ ದೇಶದಿಂದ ಇನ್ನು ಮುಂದೆ ಯಾರೂ ಅವರನ್ನು ಕಿತ್ತುಹಾಕರು,”</para>
  <para style="m" vid="AMO 9:15">ಎಂದು ನಿಮ್ಮ ದೇವರಾದ ಯೆಹೋವ ದೇವರು ಹೇಳುತ್ತಾರೆ.<verse eid="AMO 9:15"/></para>
  <chapter eid="AMO 9"/>
</usx>
