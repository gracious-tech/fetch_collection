<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="TIT" style="id">- Biblica® Open Kannada Contemporary Version</book>
  <para style="h">ತೀತನಿಗೆ</para>
  <para style="toc1">ತೀತನಿಗೆ ಪೌಲನು ಬರೆದ ಪತ್ರಿಕೆ</para>
  <para style="toc2">ತೀತನಿಗೆ</para>
  <para style="toc3">ತೀತ</para>
  <para style="mt1">ತೀತನಿಗೆ</para>
  <para style="mt2">ಪೌಲನು ಬರೆದ ಪತ್ರಿಕೆ</para>
  <chapter number="1" style="c" sid="TIT 1"/>
  <para style="p">
    <verse number="1" style="v" sid="TIT 1:1"/>ದೇವರು ಆಯ್ದುಕೊಂಡವರ ನಂಬಿಕೆಗನುಸಾರವೂ ಭಕ್ತಿಗನುಸಾರವಾದ ಸತ್ಯದ ತಿಳುವಳಿಕೆಗನುಸಾರವೂ ದೇವರ ಸೇವಕನೂ ಕ್ರಿಸ್ತ ಯೇಸುವಿನ ಅಪೊಸ್ತಲನೂ ಆಗಿರುವ ಪೌಲನೆಂಬ ನನಗೆ <verse eid="TIT 1:1"/><verse number="2" style="v" sid="TIT 1:2"/>ಸುಳ್ಳಾಡದ ದೇವರು, ಕಾಲಾರಂಭಕ್ಕೆ ಮುಂಚೆಯೇ ನಿತ್ಯಜೀವದ ನಿರೀಕ್ಷೆಯನ್ನು ವಾಗ್ದಾನಮಾಡಿದ್ದಾರೆ. <verse eid="TIT 1:2"/><verse number="3" style="v" sid="TIT 1:3"/>ತಮ್ಮ ವಾಕ್ಯ ಸಾರುವುದರ ಮೂಲಕ ತಕ್ಕ ಕಾಲದಲ್ಲಿ ಪ್ರಕಟಿಸಿ ನಮ್ಮ ರಕ್ಷಕರಾದ ದೇವರ ಆಜ್ಞೆಗನುಸಾರವಾಗಿ ನನಗೆ ಒಪ್ಪಿಸಿದರು.<verse eid="TIT 1:3"/></para>
  <para style="b"/>
  <para style="p">
    <verse number="4" style="v" sid="TIT 1:4"/>ನಮ್ಮಲ್ಲಿ ಹುದುವಾಗಿರುವ ವಿಶ್ವಾಸಕ್ಕೆ ಅನುಸಾರವಾಗಿ ನನ್ನ ನಿಜಕುಮಾರನಾದ ತೀತನಿಗೆ ಬರೆಯುವುದು:</para>
  <para style="b" vid="TIT 1:4"/>
  <para style="p" vid="TIT 1:4">ತಂದೆಯಾದ ದೇವರಿಂದಲೂ ನಮಗೆ ರಕ್ಷಕ ಹಾಗೂ ಕರ್ತ ಆಗಿರುವ ಕ್ರಿಸ್ತ ಯೇಸುವಿನಿಂದಲೂ ಕೃಪೆಯೂ ಕರುಣೆಯೂ ಶಾಂತಿಯೂ ಆಗಲಿ.<verse eid="TIT 1:4"/></para>
  <para style="b"/>
  <para style="s1">ಸಭಾಹಿರಿಯರ ಆಯ್ಕೆ</para>
  <para style="p">
    <verse number="5" style="v" sid="TIT 1:5"/>ಕ್ರೇತದ್ವೀಪದಲ್ಲಿ ಪೂರ್ಣಗೊಳಿಸದ ಕಾರ್ಯಗಳನ್ನು ನೀನು ಕ್ರಮಪಡಿಸಿ ನಾನು ನಿನಗೆ ಆಜ್ಞಾಪಿಸಿದ ಪ್ರಕಾರ ಪ್ರತಿಯೊಂದು ಪಟ್ಟಣದಲ್ಲಿ ಹಿರಿಯರನ್ನು ನೇಮಿಸಬೇಕೆಂದು ನಿನ್ನನ್ನು ಅಲ್ಲೇ ಬಿಟ್ಟು ಬಂದೆನು. <verse eid="TIT 1:5"/><verse number="6" style="v" sid="TIT 1:6"/>ಸಭೆಯ ಹಿರಿಯನು, ನಿಂದಾರಹಿತನೂ ಪತ್ನಿಗೆ ನಂಬಿಗಸ್ತನೂ ಆಗಿರಬೇಕು. ಅವನ ಮಕ್ಕಳು ವಿಶ್ವಾಸಿಗಳಾಗಿರಬೇಕು. ಅವರು ದುರ್ಮಾಗಿಗಳು ಇಲ್ಲವೆ ತಿರುಗಿ ಬೀಳುವವರೂ ಎಂಬ ಆರೋಪವನ್ನು ಹೊಂದಿರಬಾರದು. <verse eid="TIT 1:6"/><verse number="7" style="v" sid="TIT 1:7"/>ಏಕೆಂದರೆ ಸಭಾಧ್ಯಕ್ಷನು ದೇವರ ಕಾರ್ಯಭಾರವನ್ನು ಉಳ್ಳವನಾಗಿರುವುದರಿಂದ ನಿಂದಾರಹಿತನಾಗಿರಬೇಕು; ಅವನು ಗರ್ವಿಷ್ಠನೂ ಮುಂಗೋಪಿಯೂ ಮದ್ಯಪಾನ ಮಾಡುವವನೂ ಹೊಡೆದಾಡುವವನೂ ನೀಚಲಾಭವನ್ನು ಆಶಿಸುವವನೂ ಆಗಿರಬಾರದು. <verse eid="TIT 1:7"/><verse number="8" style="v" sid="TIT 1:8"/>ಆದರೆ, ಅವನು ಅತಿಥಿ ಸತ್ಕಾರ ಮಾಡುವವನೂ ಒಳ್ಳೆಯದನ್ನು ಪ್ರೀತಿಸುವವನೂ ಸ್ವಯಂನಿಯಂತ್ರವುಳ್ಳವನೂ ನ್ಯಾಯವಂತನೂ ಪರಿಶುದ್ಧನೂ ಶಿಸ್ತುಳ್ಳವನಾಗಿರಬೇಕು. <verse eid="TIT 1:8"/><verse number="9" style="v" sid="TIT 1:9"/>ಇತರರನ್ನು ಸ್ವಸ್ಥಬೋಧನೆಯಿಂದ ಪ್ರೋತ್ಸಾಹಿಸುವುದಕ್ಕೂ ಎದುರಿಸುವವರನ್ನು ಖಂಡಿಸುವಂತೆ ಮಾತನಾಡುವುದಕ್ಕೂ ಶಕ್ತನಾಗಿರಲು ಅವನು ಬೋಧಿಸಿದ ಪ್ರಕಾರ ನಂಬತಕ್ಕ ವಾಕ್ಯವನ್ನು ದೃಢವಾಗಿ ಹಿಡಿದುಕೊಂಡವನಾಗಿರಬೇಕು.<verse eid="TIT 1:9"/></para>
  <para style="s1">ಒಳಿತು ಮಾಡದವರನ್ನು ಗದರಿಸುವುದು</para>
  <para style="p">
    <verse number="10" style="v" sid="TIT 1:10"/>ಏಕೆಂದರೆ, ಅನೇಕ ದಂಗೆಕೋರ ಜನರೂ ಬರೀ ಮಾತನಾಡುವವರೂ ಮೋಸಗೊಳಿಸುವವರೂ ಮುಖ್ಯವಾಗಿ ಸುನ್ನತಿಯಾಗಬೇಕೆಂದು ಹೇಳುವ ಗುಂಪಿನವರೂ ಇದ್ದಾರೆ. <verse eid="TIT 1:10"/><verse number="11" style="v" sid="TIT 1:11"/>ಅವರು ನೀಚಲಾಭವನ್ನು ಹೊಂದುವುದಕ್ಕಾಗಿ ಮಾಡಬಾರದ ಬೋಧನೆಯನ್ನು ಮಾಡಿ ಇಡೀ ಕುಟುಂಬಗಳನ್ನೇ ಹಾಳು ಮಾಡುತ್ತಿದ್ದಾರೆ. ಆದ್ದರಿಂದ ಅವರ ಬಾಯಿಗಳನ್ನು ಮುಚ್ಚಿಸಬೇಕಾಗಿದೆ. <verse eid="TIT 1:11"/><verse number="12" style="v" sid="TIT 1:12"/>“ಕ್ರೇತದವರು ಯಾವಾಗಲೂ ಸುಳ್ಳುಗಾರರೂ ದುಷ್ಟಮೃಗಗಳಂಥವರೂ ಸೋಮಾರಿಗಳಾದ ಹೊಟ್ಟೆಬಾಕರೂ ಆಗಿದ್ದಾರೆ!” ಎಂದು ಅವರ ಸ್ವಂತ ಪ್ರವಾದಿಗಳಲ್ಲಿ ಒಬ್ಬನು ಹೇಳಿದನು. <verse eid="TIT 1:12"/><verse number="13" style="v" sid="TIT 1:13"/>ಈ ಸಾಕ್ಷಿಯು ನಿಜವೇ. ಇದರ ದೆಸೆಯಿಂದ ಅವರು ನಂಬಿಕೆಯಲ್ಲಿ ಸ್ವಸ್ಥರಾಗಿರುವಂತೆ ಅವರನ್ನು ಕಠಿಣವಾಗಿ ಖಂಡಿಸು. <verse eid="TIT 1:13"/><verse number="14" style="v" sid="TIT 1:14"/>ಅವರು ಯೆಹೂದ್ಯರ ಕಟ್ಟುಕಥೆಗಳಿಗೂ ಸತ್ಯದಿಂದ ದೂರಮಾಡುವ ಮಾನವರ ಆಜ್ಞೆಗಳಿಗೂ ಲಕ್ಷ್ಯಕೊಡಬಾರದು. <verse eid="TIT 1:14"/><verse number="15" style="v" sid="TIT 1:15"/>ಶುದ್ಧರಿಗೆ ಎಲ್ಲವೂ ಶುದ್ಧವೇ. ಆದರೆ ಮಲಿನವಾದವರಿಗೂ ಅವಿಶ್ವಾಸಿಗಳಿಗೂ ಯಾವುದೂ ಶುದ್ಧವಲ್ಲ. ಅವರ ಬುದ್ಧಿಯೂ ಮನಸ್ಸಾಕ್ಷಿಯೂ ಮಲಿನವಾಗಿವೆ. <verse eid="TIT 1:15"/><verse number="16" style="v" sid="TIT 1:16"/>ತಾವು ದೇವರನ್ನು ತಿಳಿದವರೆಂದು ಅವರು ವಾದಿಸುತ್ತಾರೆ. ಆದರೆ ತಮ್ಮ ಕೃತ್ಯಗಳಿಂದ ದೇವರನ್ನೇ ಅಲ್ಲಗಳೆಯುವರಾಗಿದ್ದಾರೆ. ಅವರು ಅಸಹ್ಯರೂ ಅವಿಧೇಯರೂ ಯಾವ ಸತ್ಕಾರ್ಯಗಳನ್ನು ಮಾಡುವುದಕ್ಕೆ ಅಯೋಗ್ಯರಾಗಿದ್ದಾರೆ.<verse eid="TIT 1:16"/></para>
  <chapter eid="TIT 1"/>
  <chapter number="2" style="c" sid="TIT 2"/>
  <para style="s1">ಸುವಾರ್ತೆಗಾಗಿ ಒಳ್ಳೆಯದನ್ನು ಮಾಡುವುದು</para>
  <para style="p">
    <verse number="1" style="v" sid="TIT 2:1"/>ನೀನಾದರೋ ಸ್ವಸ್ಥಬೋಧನೆಗೆ ಅನುಗುಣವಾಗಿ ಉಪದೇಶಿಸು. <verse eid="TIT 2:1"/><verse number="2" style="v" sid="TIT 2:2"/>ವೃದ್ಧರು ಆತ್ಮ ಸಂಯಮವುಳ್ಳವರೂ ಗೌರವಕ್ಕೆ ಯೋಗ್ಯರೂ ಸ್ವಯಂನಿಯಂತ್ರಿತರೂ ನಂಬಿಕೆ, ಪ್ರೀತಿ, ತಾಳ್ಮೆ ಇವುಗಳಲ್ಲಿ ಬದಲಾಗದವರೂ ಆಗಿರಬೇಕೆಂದು ಉಪದೇಶಿಸು.<verse eid="TIT 2:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="TIT 2:3"/>ಅದೇ ಪ್ರಕಾರ, ವೃದ್ಧಸ್ತ್ರೀಯರು ನಡತೆಯಲ್ಲಿ ಭಕ್ತಿಗೆ ತಕ್ಕ ಹಾಗೆ ಇರುವವರಾಗಿರಬೇಕು. ಅವರು ಸುಳ್ಳಾಗಿ ದೂರುವವರೂ ಮದ್ಯಾಸಕ್ತರೂ ಆಗಿರದೆ, ಒಳ್ಳೆಯವುಗಳನ್ನು ಬೋಧಿಸುವವರಾಗಿರಬೇಕು ಎಂದು ಅವರಿಗೆ ಉಪದೇಶಿಸು. <verse eid="TIT 2:3"/><verse number="4" style="v" sid="TIT 2:4"/>ಇದಲ್ಲದೆ ದೇವರ ವಾಕ್ಯವು ದೂಷಣೆಯಾಗದಂತೆ ಯೌವನ ಸ್ತ್ರೀಯರು ತಮ್ಮ ಗಂಡಂದಿರನ್ನು ಮತ್ತು ಮಕ್ಕಳನ್ನು ಪ್ರೀತಿಸುವವರೂ <verse eid="TIT 2:4"/><verse number="5" style="v" sid="TIT 2:5"/>ಸ್ವಶಿಸ್ತನ್ನು ಹೊಂದಿದವರೂ ಪತಿವ್ರತೆಯರೂ ಮನೆಯಲ್ಲಿ ಕೆಲಸ ಮಾಡುವವರೂ ದಯೆವುಳ್ಳವರೂ ತಮ್ಮ ಗಂಡಂದಿರಿಗೆ ಅಧೀನರೂ ಆಗಿರಬೇಕೆಂದು ವೃದ್ಧಸ್ತ್ರೀಯರಿಂದ ಕಲಿತುಕೊಳ್ಳಿರಿ.<verse eid="TIT 2:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="TIT 2:6"/>ಹಾಗೆಯೇ, ಯೌವನಸ್ಥರು ಆತ್ಮ ಸ್ವಶಿಸ್ತನ್ನು ಹೊಂದಿದವರಾಗಿರಬೇಕೆಂದು ಅವರನ್ನು ಪ್ರೋತ್ಸಾಹಿಸು. <verse eid="TIT 2:6"/><verse number="7" style="v" sid="TIT 2:7"/>ಎಲ್ಲಾ ವಿಷಯಗಳಲ್ಲಿ ನಿನ್ನನ್ನು ಸತ್ಕಾರ್ಯ ಮಾಡುವುದರಲ್ಲಿ ಆದರ್ಶವಾಗಿ ತೋರಿಸು. ಬೋಧನೆಯಲ್ಲಿ ಪ್ರಾಮಾಣಿಕತೆಯನ್ನೂ ಗಂಭೀರತೆಯನ್ನೂ <verse eid="TIT 2:7"/><verse number="8" style="v" sid="TIT 2:8"/>ನಿಂದೆಗೆ ಹೊರತಾದ ಸ್ವಸ್ಥ ಮಾತುಗಳನ್ನಾಡುವವನಾಗಿರು. ಇದರಿಂದ ವಿರೋಧಿಸುವವನು ನಿನ್ನ ವಿಷಯದಲ್ಲಿ ಕೆಟ್ಟದ್ದೇನೂ ಹೇಳುವುದಕ್ಕಾಗದೆ ನಾಚಿಕೆ ಪಡುವನು.<verse eid="TIT 2:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="TIT 2:9"/>ಸೇವಕರು ತಮ್ಮ ಸ್ವಂತ ಯಜಮಾನರಿಗೆ ಅಧೀನರಾಗಿದ್ದು ಎಲ್ಲವುಗಳಲ್ಲಿ ಅವರನ್ನು ಮೆಚ್ಚಿಸುವವರಾಗಿ ಎದುರು ಮಾತನಾಡದೆ, <verse eid="TIT 2:9"/><verse number="10" style="v" sid="TIT 2:10"/>ಯಾವುದನ್ನೂ ಕದ್ದಿಟ್ಟುಕೊಳ್ಳದೆ, ನಮ್ಮ ರಕ್ಷಕರಾದ ದೇವರ ಉಪದೇಶವನ್ನು ಎಲ್ಲಾ ವಿಷಯಗಳಲ್ಲಿಯೂ ಅಲಂಕರಿಸುವಂತೆ, ಒಳ್ಳೆಯ ನಂಬಿಗಸ್ತರೆಂದು ಎಲ್ಲದರಲ್ಲಿಯೂ ತೋರಿಸಬೇಕೆಂದು ಅವರನ್ನು ಉಪದೇಶಿಸು.<verse eid="TIT 2:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="TIT 2:11"/>ಏಕೆಂದರೆ ಎಲ್ಲಾ ಮನುಷ್ಯರಿಗೆ ರಕ್ಷಣೆಯನ್ನು ತರುವ ದೇವರ ಕೃಪೆಯೂ ಪ್ರತ್ಯಕ್ಷವಾಯಿತು. <verse eid="TIT 2:11"/><verse number="12" style="v" sid="TIT 2:12"/>ನಾವು ಭಕ್ತಿಹೀನತೆಯನ್ನೂ ಲೋಕದ ಆಶೆಗಳನ್ನೂ ತೊರೆದು, ಈಗಿನ ಲೋಕದಲ್ಲಿ ಸ್ವಶಿಸ್ತನ್ನು ಹೊಂದಿದವವರಾಗಿಯೂ ನೀತಿವಂತರಾಗಿಯೂ ಭಕ್ತಿಯುಳ್ಳವರಾಗಿಯೂ ಬದುಕಬೇಕೆಂತಲೂ ದೇವರ ಕೃಪೆಯು ನಮಗೆ ಬೋಧಿಸುತ್ತದೆ. <verse eid="TIT 2:12"/><verse number="13" style="v" sid="TIT 2:13"/>ನಮಗೆ ರಕ್ಷಕರೂ ಮಹಾ ದೇವರೂ ಆಗಿರುವ ಕ್ರಿಸ್ತ ಯೇಸುವಿನ ಭಾಗ್ಯಕರವಾದ ಮಹಿಮೆಯ ಪ್ರತ್ಯಕ್ಷತೆಯ ನಿರೀಕ್ಷೆಯನ್ನೂ ಎದುರು ನೋಡುತ್ತಿರಬೇಕೆಂದು ಕೃಪೆಯು ನಮಗೆ ಬೋಧಿಸುತ್ತದೆ. <verse eid="TIT 2:13"/><verse number="14" style="v" sid="TIT 2:14"/>ಕ್ರಿಸ್ತ ಯೇಸು ನಮ್ಮನ್ನು ಎಲ್ಲಾ ದುಷ್ಟತನದಿಂದ ವಿಮೋಚಿಸಿ ಸತ್ಕ್ರಿಯೆಗಳಲ್ಲಿ ಆಸಕ್ತರಾದ ಸ್ವಂತ ಜನರನ್ನು ತಮಗಾಗಿ ಪರಿಶುದ್ಧ ಮಾಡುವಂತೆ ನಮಗೋಸ್ಕರ ತಮ್ಮನ್ನು ತಾವೇ ಒಪ್ಪಿಸಿಕೊಟ್ಟರು.<verse eid="TIT 2:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="TIT 2:15"/>ಈ ಕಾರ್ಯಗಳ ವಿಷಯದಲ್ಲಿ, ನೀನು ಉಪದೇಶಿಸುತ್ತಾ ಇರು. ಪ್ರೋತ್ಸಾಹಮಾಡುತ್ತಾ ಪೂರ್ಣ ಅಧಿಕಾರದಿಂದ ಖಂಡಿಸುತ್ತಾ ಇರು. ಯಾರೂ ನಿನ್ನನ್ನು ತಿರಸ್ಕರಿಸದಿರಲಿ.<verse eid="TIT 2:15"/></para>
  <chapter eid="TIT 2"/>
  <chapter number="3" style="c" sid="TIT 3"/>
  <para style="s1">ಒಳ್ಳೆಯದನ್ನು ಮಾಡುವುದು</para>
  <para style="p">
    <verse number="1" style="v" sid="TIT 3:1"/>ಆಳುವವರಿಗೂ ಅಧಿಕಾರಿಗಳಿಗೂ ಅಧೀನರಾಗಿ ವಿಧೇಯರಾಗಿರಬೇಕೆಂತಲೂ ಪ್ರತಿಯೊಂದು ಒಳ್ಳೆಯ ಕಾರ್ಯಕ್ಕೆ ಸಿದ್ಧರಾಗಿರಬೇಕೆಂತಲೂ ಅವರಿಗೆ ಜ್ಞಾಪಕಮಾಡು. <verse eid="TIT 3:1"/><verse number="2" style="v" sid="TIT 3:2"/>ಯಾರ ವಿಷಯವಾಗಿಯೂ ಕೆಟ್ಟದ್ದನ್ನಾಡದೆ, ಎಲ್ಲರೊಂದಿಗೆ ಸಮಾಧಾನವಾಗಿಯೂ ಇತರರನ್ನು ಅರ್ಥಮಾಡಿಕೊಳ್ಳುವವರಾಗಿಯೂ ಯಾವಾಗಲೂ ನಮ್ರರಾಗಿ ಇರಬೇಕೆಂತಲೂ ಅವರಿಗೆ ಜ್ಞಾಪಕಮಾಡು.<verse eid="TIT 3:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="TIT 3:3"/>ನಾವು ಸಹ ಮೊದಲು ಅವಿವೇಕಿಗಳೂ ಅವಿಧೇಯರೂ ಮೋಸ ಹೋದವರೂ ವಿವಿಧ ಆಶೆಗಳಿಗೂ ಭೋಗಗಳಿಗೂ ದಾಸರಾಗಿದ್ದೆವು. ಕೆಟ್ಟತನ ಹಾಗೂ ಮತ್ಸರಗಳಲ್ಲಿ ಜೀವಿಸುವವರೂ ಅಸಹ್ಯರೂ ಒಬ್ಬರನ್ನೊಬ್ಬರು ದ್ವೇಷಿಸುವವರೂ ಆಗಿದ್ದೆವು. <verse eid="TIT 3:3"/><verse number="4" style="v" sid="TIT 3:4"/>ಆದರೆ ನಮಗೆ ರಕ್ಷಕರೂ ದೇವರೂ ಆಗಿರುವ ಕ್ರಿಸ್ತ ಯೇಸುವಿನ ದಯೆಯೂ ಪ್ರೀತಿಯೂ ಮನುಷ್ಯರ ಕಡೆಗೆ ಪ್ರತ್ಯಕ್ಷವಾದಾಗ, <verse eid="TIT 3:4"/><verse number="5" style="v" sid="TIT 3:5"/>ಅವರು ನಮ್ಮನ್ನು ರಕ್ಷಿಸಿದರು. ಹೇಗೆಂದರೆ, ನಾವು ಮಾಡಿದ ಪುಣ್ಯ ಕ್ರಿಯೆಗಳಿಂದಲ್ಲ, ಅವರ ಕರುಣೆಗೆ ಅನುಸಾರವಾಗಿ ಆತ್ಮಿಕವಾಗಿ ಹುಟ್ಟುವಂತೆ ಮಾಡಿ, ನಮ್ಮನ್ನು ತೊಳೆದೂ ಪವಿತ್ರಾತ್ಮ ದೇವರು ನೂತನ ಜೀವನವನ್ನು ಕೊಡುವುದರ ಮೂಲಕವೇ ಅವರು ನಮ್ಮನ್ನು ರಕ್ಷಿಸಿದರು. <verse eid="TIT 3:5"/><verse number="6" style="v" sid="TIT 3:6"/>ನಮಗೆ ರಕ್ಷಕರಾದ ಕ್ರಿಸ್ತ ಯೇಸುವಿನ ಮೂಲಕ ದೇವರು ಪವಿತ್ರಾತ್ಮ ದೇವರನ್ನು ನಮ್ಮ ಮೇಲೆ ಸಮೃದ್ಧವಾಗಿ ಸುರಿಸಿದರು. <verse eid="TIT 3:6"/><verse number="7" style="v" sid="TIT 3:7"/>ನಾವು ಅವರ ಕೃಪೆಯಿಂದ ನೀತಿವಂತರೆಂದು ನಿರ್ಣಯ ಹೊಂದಿ, ನಿತ್ಯಜೀವದ ನಿರೀಕ್ಷೆಗೆ ಅನುಸಾರವಾಗಿ ಬಾಧ್ಯರಾಗುವಂತೆ ಮಾಡಿದರು. <verse eid="TIT 3:7"/><verse number="8" style="v" sid="TIT 3:8"/>ಇದು ನಂಬತಕ್ಕ ಮಾತಾಗಿದೆ. ದೇವರನ್ನು ನಂಬಿದವರು ಸತ್ಕ್ರಿಯೆಗಳನ್ನು ಮಾಡುವುದರಲ್ಲಿ ಜಾಗರೂಕರಾಗಿರುವಂತೆ ನೀನು ಇವುಗಳ ವಿಷಯವಾಗಿ ಪ್ರಾಮುಖ್ಯತೆಯನ್ನು ಕೊಡಬೇಕೆಂದು ಅಪೇಕ್ಷಿಸುತ್ತೇನೆ. ಇವು ಮನುಷ್ಯರಿಗೆ ಹಿತಕರವೂ ಪ್ರಯೋಜನಕರವೂ ಆಗಿವೆ.<verse eid="TIT 3:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="TIT 3:9"/>ಆದರೆ ಬುದ್ಧಿಯಿಲ್ಲದ ವಿತರ್ಕಗಳಿಗೂ ವಂಶಾವಳಿಗಳಿಗೂ ಜಗಳಗಳಿಗೂ ನಿಯಮದ ವಿಷಯವಾಗಿರುವ ವಾಗ್ವಾದಗಳಿಗೂ ದೂರವಾಗಿರು. ಏಕೆಂದರೆ ಅವು ನಿಷ್ಪ್ರಯೋಜನವಾದವುಗಳೂ ವ್ಯರ್ಥವಾದವುಗಳೂ ಆಗಿವೆ. <verse eid="TIT 3:9"/><verse number="10" style="v" sid="TIT 3:10"/>ಭೇದ ಹುಟ್ಟಿಸುವವರನ್ನು ಒಂದೆರಡು ಸಾರಿ ಬುದ್ಧಿ ಹೇಳಿದ ಮೇಲೆ ಬಿಟ್ಟುಬಿಡು. ಅಂಥವರ ಸಹವಾಸ ಮಾಡದಿರು. <verse eid="TIT 3:10"/><verse number="11" style="v" sid="TIT 3:11"/>ಅಂಥವರು ಸನ್ಮಾರ್ಗ ತಪ್ಪಿದವರೂ ತಮ್ಮನ್ನು ತಾವೇ ಖಂಡಿಸಿಕೊಳ್ಳುವವರಾಗಿ ಪಾಪಮಾಡುವವರೂ ಆಗಿದ್ದಾರೆಂದು ನಿಶ್ಚಯವಾಗಿ ತಿಳಿದುಕೊ.<verse eid="TIT 3:11"/></para>
  <para style="b"/>
  <para style="s1">ಕಡೇ ಮಾತುಗಳು</para>
  <para style="p">
    <verse number="12" style="v" sid="TIT 3:12"/>ನಾನು ಅರ್ತೆಮನನ್ನಾಗಲಿ, ತುಖಿಕನನ್ನಾಗಲಿ ನಿನ್ನ ಬಳಿಗೆ ಕಳುಹಿಸಿದಾಗ ನೀನು ನಿಕೊಪೊಲಿಯಲ್ಲಿ ನನ್ನ ಹತ್ತಿರ ಬರುವುದಕ್ಕೆ ಪ್ರಯತ್ನ ಮಾಡು. ಅಲ್ಲಿಯೇ ಚಳಿಗಾಲವನ್ನು ಕಳೆಯಬೇಕೆಂದು ನಾನು ತೀರ್ಮಾನಿಸಿದ್ದೇನೆ. <verse eid="TIT 3:12"/><verse number="13" style="v" sid="TIT 3:13"/>ನಿಯಮ ಪಂಡಿತನಾದ ಜೇನನನ್ನೂ ಅಪೊಲ್ಲೋಸನನ್ನೂ ಜಾಗ್ರತೆಯಾಗಿ ಸಾಗಕಳುಹಿಸು. ಅವರಿಗೇನೂ ಕೊರತೆಯಾಗಬಾರದು.<verse eid="TIT 3:13"/></para>
  <para style="b"/>
  <para style="p">
    <verse number="14" style="v" sid="TIT 3:14"/>ನಮ್ಮವರು ಸತ್ಕ್ರಿಯೆಗಳನ್ನು ಮಾಡುವುದಕ್ಕಾಗಿಯೂ ಅಗತ್ಯವಾಗಿರುವ ಕೊರತೆಗಳನ್ನು ನೀಗಿಸುವುದಕ್ಕೂ ಕಲಿತುಕೊಳ್ಳಲಿ. ಆಗ ಅವರು ನಿಷ್ಪಲರಾಗದೇ ಇರುವರು.<verse eid="TIT 3:14"/></para>
  <para style="b"/>
  <para style="p">
    <verse number="15" style="v" sid="TIT 3:15"/>ನನ್ನೊಂದಿಗಿರುವವರೆಲ್ಲರೂ ನಿನಗೆ ವಂದನೆ ಹೇಳುತ್ತಾರೆ.</para>
  <para style="p" vid="TIT 3:15">ವಿಶ್ವಾಸದಲ್ಲಿ ನಮ್ಮನ್ನು ಪ್ರೀತಿಸುವವರಿಗೆ ವಂದನೆಗಳನ್ನು ಹೇಳು.</para>
  <para style="b" vid="TIT 3:15"/>
  <para style="p" vid="TIT 3:15">ಕೃಪೆಯು ನಿಮ್ಮೆಲ್ಲರೊಂದಿಗೆ ಇರಲಿ!<verse eid="TIT 3:15"/></para>
  <chapter eid="TIT 3"/>
</usx>
