<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="HAG" style="id">- Biblica® Open Kannada Contemporary Version</book>
  <para style="h">ಹಗ್ಗಾಯ</para>
  <para style="toc1">ಹಗ್ಗಾಯ</para>
  <para style="toc2">ಹಗ್ಗಾಯ</para>
  <para style="toc3">ಹಗ್ಗಾ</para>
  <para style="mt1">ಹಗ್ಗಾಯ</para>
  <chapter number="1" style="c" sid="HAG 1"/>
  <para style="s1">ಯೆಹೋವ ದೇವರ ಆಲಯ ಕಟ್ಟಲು ಕರೆ</para>
  <para style="p">
    <verse number="1" style="v" sid="HAG 1:1"/>ಪಾರಸಿಯ ಅರಸ ದಾರ್ಯಾವೆಷನ ಆಳಿಕೆಯ ಎರಡನೆಯ ವರ್ಷದಲ್ಲಿ, ಆರನೇ ತಿಂಗಳಿನ ಮೊದಲನೇ ದಿವಸದಲ್ಲಿ, ಯೆಹೋವ ದೇವರ ವಾಕ್ಯವು ಪ್ರವಾದಿಯಾದ ಹಗ್ಗಾಯನ ಮುಖಾಂತರ, ಶೆಯಲ್ತಿಯೇಲನ ಮಗನು ಮತ್ತು ಯೆಹೂದದ ಅಧಿಪತಿ ಆದ ಜೆರುಬ್ಬಾಬೆಲನಿಗೂ ಯೆಹೋಚಾದಾಕನ ಮಗನು ಮತ್ತು ಮಹಾಯಾಜಕನಾದ ಯೆಹೋಶುವನಿಗೂ ಬಂದಿತು:<verse eid="HAG 1:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="HAG 1:2"/>“ಸರ್ವಶಕ್ತರಾದ ಯೆಹೋವ ದೇವರು ಹೀಗೆ ಹೇಳುತ್ತಾರೆ: ‘ಯೆಹೋವ ದೇವರ ಆಲಯವನ್ನು ಕಟ್ಟುವ ಕಾಲವು ಇನ್ನೂ ಬಂದಿಲ್ಲ,’ ಎಂದು ಈ ಜನರು ಅಂದುಕೊಳ್ಳುತ್ತಾರೆ.”<verse eid="HAG 1:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="HAG 1:3"/>ಆಗ ಯೆಹೋವ ದೇವರ ವಾಕ್ಯವು ಪ್ರವಾದಿಯಾದ ಹಗ್ಗಾಯನ ಮೂಲಕ ಬಂದಿತು: <verse eid="HAG 1:3"/><verse number="4" style="v" sid="HAG 1:4"/>“ಈ ಆಲಯ ಹಾಳುಬಿದ್ದಿರುವಾಗ, ನೀವು, ನಿಮ್ಮ ಚಿತ್ರ ಹಲಗೆಗಳುಳ್ಳ ಮನೆಗಳಲ್ಲಿ ವಾಸಮಾಡುವುದಕ್ಕೆ ಇದು ನಿಮಗೆ ಕಾಲವೋ?”<verse eid="HAG 1:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="HAG 1:5"/>ಈಗ ಸೇನಾಧೀಶ್ವರ ಯೆಹೋವ ದೇವರು ಹೀಗೆ ಹೇಳುತ್ತಾರೆ: “ನಿಮ್ಮ ಮಾರ್ಗಗಳನ್ನು ಆಲೋಚಿಸಿ ನೋಡಿರಿ. <verse eid="HAG 1:5"/><verse number="6" style="v" sid="HAG 1:6"/>ಬಹಳವಾಗಿ ಬಿತ್ತಿದ್ದೀರಿ, ಆದರೆ ಕೊಂಚವಾಗಿ ಸುಗ್ಗಿ ಮಾಡಿದ್ದೀರಿ; ತಿನ್ನುತ್ತೀರಿ, ಆದರೆ ಸಾಕಾಗಲಿಲ್ಲ; ಕುಡಿಯುತ್ತೀರಿ, ಆದರೆ ತೃಪ್ತಿಯಾಗಲಿಲ್ಲ; ಬಟ್ಟೆಯನ್ನು ಧರಿಸುತ್ತೀರಿ, ಆದರೆ ಬೆಚ್ಚಗೆ ಆಗಲಿಲ್ಲ; ಸಂಬಳ ಸಂಪಾದಿಸುತ್ತೀರಿ, ಅದನ್ನು ತೂತುಗಳುಳ್ಳ ಚೀಲಗಳಲ್ಲಿ ಹಾಕಿಡುತ್ತೀರಿ.”<verse eid="HAG 1:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="HAG 1:7"/>ಸೇನಾಧೀಶ್ವರ ಯೆಹೋವ ದೇವರು ಹೇಳುವುದೇನೆಂದರೆ, “ನಿಮ್ಮ ಮಾರ್ಗಗಳನ್ನು ಆಲೋಚಿಸಿ ನೋಡಿರಿ. <verse eid="HAG 1:7"/><verse number="8" style="v" sid="HAG 1:8"/>ಬೆಟ್ಟಕ್ಕೆ ಹೋಗಿ ಮರವನ್ನು ತಂದು, ಆಲಯವನ್ನು ಕಟ್ಟಿರಿ. ಆಗ ನಾನು ಅದಕ್ಕೆ ಮೆಚ್ಚಿ, ಮಹಿಮೆ ಹೊಂದುವೆನೆಂದು, ಯೆಹೋವ ದೇವರು ಹೇಳುತ್ತಾರೆ. <verse eid="HAG 1:8"/><verse number="9" style="v" sid="HAG 1:9"/>ಬಹಳ ಆಗಬೇಕೆಂದು ನೋಡಿಕೊಂಡಿರಿ. ಆದರೆ ಇದೋ ಕೊಂಚವು. ನೀವು ಇದನ್ನು ಮನೆಗೆ ತಂದಾಗ, ನಾನು ಅದರ ಮೇಲೆ ಊದಿ ಬಿಟ್ಟೆನು. ಏತಕ್ಕೆ ಎಂದು ಸೇನಾಧೀಶ್ವರ ಯೆಹೋವ ದೇವರು ಹೇಳುತ್ತಾರೆ. ನನ್ನ ಆಲಯವು ಹಾಳುಬಿದ್ದಿರುವಾಗ, ನೀವು ನಿಮ್ಮ ನಿಮ್ಮ ಸ್ವಂತ ಮನೆಗಳ ಕಡೆಗೆ ಹೆಚ್ಚು ಗಮನ ಕೊಡುತ್ತೀರಿ. <verse eid="HAG 1:9"/><verse number="10" style="v" sid="HAG 1:10"/>ಆದ್ದರಿಂದ ನಿಮ್ಮ ನಿಮಿತ್ತವೇ ಆಕಾಶವು ಮಂಜನ್ನು ತಡೆಯುತ್ತದೆ; ಭೂಮಿಯು ತನ್ನ ಹುಟ್ಟುವಳಿಯನ್ನು ತಡೆದುಬಿಟ್ಟಿದೆ. <verse eid="HAG 1:10"/><verse number="11" style="v" sid="HAG 1:11"/>ಇದಲ್ಲದೆ ನಾನು ಭೂಮಿಯ ಮೇಲೆಯೂ ಬೆಟ್ಟಗಳ ಮೇಲೆಯೂ ಧಾನ್ಯದ ಮೇಲೆಯೂ ಹೊಸ ದ್ರಾಕ್ಷಾರಸದ ಮೇಲೆಯೂ ಎಣ್ಣೆಯ ಮೇಲೆಯೂ ಭೂಮಿಯ ಹುಟ್ಟುವಳಿಯ ಮೇಲೆಯೂ ಮನುಷ್ಯರ ಮೇಲೆಯೂ ಪಶುಗಳ ಮೇಲೆಯೂ ಕೈಕಸುಬುಗಳ ಮೇಲೆಯೂ ಬರಗಾಲವನ್ನು ತಂದಿದ್ದೇನೆ.”<verse eid="HAG 1:11"/></para>
  <para style="b"/>
  <para style="p">
    <verse number="12" style="v" sid="HAG 1:12"/>ಆಗ ಶೆಯಲ್ತಿಯೇಲನ ಮಗ ಜೆರುಬ್ಬಾಬೆಲನೂ ಯೆಹೋಚಾದಾಕನ ಮಗ ಮತ್ತು ಮಹಾಯಾಜಕ ಯೆಹೋಶುವನೂ ಜನರಲ್ಲಿ ಉಳಿದವರೆಲ್ಲರೂ ತಮ್ಮ ದೇವರಾದ ಯೆಹೋವ ದೇವರ ಮಾತನ್ನೂ ತಮ್ಮ ದೇವರಾದ ಯೆಹೋವ ದೇವರು ಕಳುಹಿಸಿದ ಪ್ರವಾದಿಯಾದ ಹಗ್ಗಾಯನ ಮಾತುಗಳನ್ನೂ ಕೇಳಿದರು. ಜನರು ಯೆಹೋವ ದೇವರಿಗೆ ಭಯಪಟ್ಟರು.<verse eid="HAG 1:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="HAG 1:13"/>ಆಗ ಯೆಹೋವ ದೇವರ ಸೇವಕನಾದ ಹಗ್ಗಾಯನು, ಯೆಹೋವ ದೇವರ ಜನರಿಗೆ, “ನಾನು ನಿಮ್ಮ ಸಂಗಡ ಇದ್ದೇನೆ” ಎಂದು ಯೆಹೋವ ದೇವರು ಹೇಳುತ್ತಾರೆ. <verse eid="HAG 1:13"/><verse number="14-15" style="v" sid="HAG 1:14-15"/>ಯೆಹೋವ ದೇವರು ಶೆಯಲ್ತಿಯೇಲನ ಮಗ ಮತ್ತು ಯೆಹೂದದ ಅಧಿಪತಿಯಾದ ಜೆರುಬ್ಬಾಬೆಲನ ಆತ್ಮವನ್ನೂ, ಯೆಹೋಚಾದಾಕನ ಮಗ ಮತ್ತು ಮಹಾಯಾಜಕ ಯೆಹೋಶುವನ ಆತ್ಮವನ್ನೂ, ಜನರಲ್ಲಿ ಉಳಿದವರೆಲ್ಲರ ಆತ್ಮವನ್ನೂ ಪ್ರೇರೇಪಿಸಿದರು. ಅವರು ಬಂದು ಅರಸನಾದ ದಾರ್ಯಾವೆಷನ ಆಳಿಕೆಯ ಎರಡನೇ ವರ್ಷದ, ಆರನೆಯ ತಿಂಗಳಿನ, ಇಪ್ಪತ್ನಾಲ್ಕನೆಯ ದಿವಸದಲ್ಲಿ ತಮ್ಮ ದೇವರಾದ ಸೇನಾಧೀಶ್ವರ ಯೆಹೋವ ದೇವರ ಆಲಯದ ಕೆಲಸ ಪ್ರಾರಂಭಿಸಿದರು.</para>
  <para style="s1" vid="HAG 1:14-15">ದೇವಾಲಯದ ಮುಂದಿನ ವೈಭವದ ವಾಗ್ದಾನ</para>
  <para style="p" vid="HAG 1:14-15">ಅರಸನಾದ ದಾರ್ಯಾವೆಷನ ಎರಡನೇ ವರ್ಷದಲ್ಲಿ,<verse eid="HAG 1:14-15"/></para>
  <chapter eid="HAG 1"/>
  <chapter number="2" style="c" sid="HAG 2"/>
  <para style="nb">
    <verse number="1" style="v" sid="HAG 2:1"/>ಏಳನೆಯ ತಿಂಗಳಿನ, ಇಪ್ಪತ್ತೊಂದನೆಯ ದಿವಸದಲ್ಲಿ, ಯೆಹೋವ ದೇವರ ವಾಕ್ಯವು ಪ್ರವಾದಿಯಾದ ಹಗ್ಗಾಯನ ಮೂಲಕ ಬಂದಿತು: <verse eid="HAG 2:1"/><verse number="2" style="v" sid="HAG 2:2"/>“ಶೆಯಲ್ತಿಯೇಲನ ಮಗ ಮತ್ತು ಯೆಹೂದದ ಅಧಿಪತಿಯಾದ ಜೆರುಬ್ಬಾಬೆಲನಿಗೂ ಯೆಹೋಚಾದಾಕನ ಮಗ ಮತ್ತು ಮಹಾಯಾಜಕನಾದ ಯೆಹೋಶುವನಿಗೂ ಜನರಲ್ಲಿ ಉಳಿದವರಿಗೂ ನೀನು ಇದನ್ನು ಹೇಳತಕ್ಕದ್ದು. <verse eid="HAG 2:2"/><verse number="3" style="v" sid="HAG 2:3"/>ಈ ಆಲಯದ ಅದರ ಪೂರ್ವದ ಮಹಿಮೆಯನ್ನು ನೋಡಿದವರೊಳಗೆ ಉಳಿದವನು ನಿಮ್ಮಲ್ಲಿ ಯಾರು ಇದ್ದಾರೆ? ಈಗ ಅದು ಹೇಗೆ ಕಾಣುತ್ತದೆ? ಇದು ನಿಮ್ಮ ದೃಷ್ಟಿಗೆ ಏನೂ ಇಲ್ಲದ ಹಾಗೆ ತೋರುತ್ತದಲ್ಲವೋ? <verse eid="HAG 2:3"/><verse number="4" style="v" sid="HAG 2:4"/>ಆದರೂ ಈಗ ಯೆಹೋವ ದೇವರು ಹೀಗೆ ಹೇಳಿದರು: ‘ಜೆರುಬ್ಬಾಬೆಲನೇ, ಬಲವಾಗಿರು. ಯೆಹೋಚಾದಾಕನ ಮಗ ಮತ್ತು ಮಹಾಯಾಜಕನಾದ ಯೆಹೋಶುವನೇ, ಬಲವಾಗಿರು. ದೇಶದ ಜನರೆಲ್ಲರೇ, ಬಲವಾಗಿರಿ,’ ಕೆಲಸಮಾಡಿರಿ. ‘ನಾನು ನಿಮ್ಮ ಸಂಗಡ ಇದ್ದೇನೆ’ ಎಂದು ಸರ್ವಶಕ್ತರಾದ ಯೆಹೋವ ದೇವರು ಹೇಳುತ್ತಾರೆ. <verse eid="HAG 2:4"/><verse number="5" style="v" sid="HAG 2:5"/>ನೀವು ಈಜಿಪ್ಟಿನೊಳಗಿನಿಂದ ಹೊರಗೆ ಬಂದಾಗ, ನಾನು ನಿಮ್ಮ ಸಂಗಡ ಒಡಂಬಡಿಕೆ ಮಾಡಿದ ವಾಕ್ಯದ ಪ್ರಕಾರ, ನನ್ನ ಆತ್ಮವು ನಿಮ್ಮಲ್ಲಿ ನೆಲೆಗೊಂಡಿರುವುದು. ನೀವು ಭಯಪಡಬೇಡಿರಿ.<verse eid="HAG 2:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="HAG 2:6"/>“ಏಕೆಂದರೆ ಸರ್ವಶಕ್ತರಾದ ಯೆಹೋವ ದೇವರು ಹೀಗೆ ಹೇಳುತ್ತಾರೆ: ‘ಸ್ವಲ್ಪ ಕಾಲದ ನಂತರ ಇನ್ನೊಂದು ಸಾರಿ ನಾನು ಆಕಾಶಗಳನ್ನು ಭೂಮಿಯನ್ನು, ಸಮುದ್ರವನ್ನು ಮತ್ತು ಒಣನೆಲವನ್ನು ಕದಲಿಸುತ್ತೇನೆ. <verse eid="HAG 2:6"/><verse number="7" style="v" sid="HAG 2:7"/>ಎಲ್ಲಾ ಜನಾಂಗಗಳನ್ನು ನಡುಗಿಸುವೆನು. ಎಲ್ಲಾ ಜನಾಂಗಗಳ ಇಷ್ಟ ವಸ್ತುಗಳು ಬಂದು ಒದಗಲು, ಈ ಆಲಯವನ್ನು ಮಹಿಮೆಯಿಂದ ತುಂಬಿಸುತ್ತೇನೆ’ ಎಂದು ಸರ್ವಶಕ್ತರಾದ ಯೆಹೋವ ದೇವರು ಹೇಳುತ್ತಾರೆ. <verse eid="HAG 2:7"/><verse number="8" style="v" sid="HAG 2:8"/>‘ಬೆಳ್ಳಿ ನನ್ನದು, ಚಿನ್ನವು ನನ್ನದು,’ ಎಂದು ಸರ್ವಶಕ್ತರಾದ ಯೆಹೋವ ದೇವರು ಹೇಳುತ್ತಾರೆ. <verse eid="HAG 2:8"/><verse number="9" style="v" sid="HAG 2:9"/>‘ಈಗಿರುವ ಆಲಯದ ಮಹಿಮೆಯು, ಹಿಂದಿನ ಆಲಯದ ಮಹಿಮೆಗಿಂತ ವಿಶೇಷವಾಗಿರುವುದು,’ ಎಂದು ಸೇನಾಧೀಶ್ವರ ಯೆಹೋವ ದೇವರು ಹೇಳುತ್ತಾರೆ. ‘ನಾನೇ ಈ ಸ್ಥಳದಲ್ಲಿ ಸಮಾಧಾನ ಕೊಡುವೆನು,’ ಎಂದು ಸೇನಾಧೀಶ್ವರ ಯೆಹೋವ ದೇವರು ಹೇಳುತ್ತಾರೆ.”<verse eid="HAG 2:9"/></para>
  <para style="s1">ಕೆಟ್ಟು ಹೋದ ಜನರಿಗಾಗಿ ಆಶೀರ್ವಾದ</para>
  <para style="p">
    <verse number="10" style="v" sid="HAG 2:10"/>ದಾರ್ಯಾವೆಷನ ಎರಡನೆಯ ವರ್ಷದ, ಒಂಬತ್ತನೆಯ ತಿಂಗಳಿನ, ಇಪ್ಪತ್ನಾಲ್ಕನೆಯ ದಿನದಲ್ಲಿ, ಯೆಹೋವ ದೇವರ ವಾಕ್ಯವು ಪ್ರವಾದಿಯಾದ ಹಗ್ಗಾಯನಿಗೆ ಬಂದಿತು: <verse eid="HAG 2:10"/><verse number="11" style="v" sid="HAG 2:11"/>“ಸೇನಾಧೀಶ್ವರ ಯೆಹೋವ ದೇವರು ಹೇಳುವುದೇನೆಂದರೆ: ‘ಮೋಶೆಯ ನಿಯಮದ ಪ್ರಕಾರವಾಗಿ ಯಾಜಕರಿಗೆ, <verse eid="HAG 2:11"/><verse number="12" style="v" sid="HAG 2:12"/>ಒಬ್ಬನು ತನ್ನ ವಸ್ತ್ರದ ಸೆರಗಿನಲ್ಲಿ ಪ್ರತಿಷ್ಠಿಸಿದ ಮಾಂಸವನ್ನು ಹೊತ್ತು, ತನ್ನ ಸೆರಗಿನಿಂದ ರೊಟ್ಟಿಯನ್ನಾದರೂ ಬೇಯಿಸಿದ್ದನ್ನಾದರೂ ದ್ರಾಕ್ಷಾರಸವನ್ನಾದರೂ ಎಣ್ಣೆಯನ್ನಾದರೂ ಯಾವ ವಿಧವಾದ ಆಹಾರವನ್ನಾದರೂ ಮುಟ್ಟಿದರೆ, ಅದು ಪರಿಶುದ್ಧವಾಗುವುದೋ? ಕೇಳು,’ ” ಎಂದನು. ಹಗ್ಗಾಯನು ಹಾಗೆ ವಿಚಾರಿಸಲು,</para>
  <para style="p" vid="HAG 2:12">ಯಾಜಕರು, “ಇಲ್ಲ,” ಎಂದು ಉತ್ತರಕೊಟ್ಟರು.<verse eid="HAG 2:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="HAG 2:13"/>ಆಗ ಹಗ್ಗಾಯನು, “ಹೆಣದಿಂದ ಅಶುದ್ಧವಾದವನು, ಇವುಗಳಲ್ಲಿ ಯಾವುದನ್ನಾದರೂ ಮುಟ್ಟಿದರೆ, ಅಶುದ್ಧವಾಗುವುದೋ?” ಎಂದನು. ಯಾಜಕರು ಉತ್ತರವಾಗಿ,</para>
  <para style="p" vid="HAG 2:13">“ಹೌದು, ಅಶುದ್ಧವಾಗುವುದು,” ಎಂದರು.<verse eid="HAG 2:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="HAG 2:14"/>ಆಗ ಹಗ್ಗಾಯನು ಮುಂದುವರಿಸಿ ಹೇಳಿದ್ದೇನೆಂದರೆ, “ಈ ಜನರೂ, ಈ ಜನಾಂಗವೂ ನನ್ನ ಮುಂದೆ ಹೀಗೆಯೇ ಇದ್ದಾರೆ ಎಂದು ಯೆಹೋವ ದೇವರು ಹೇಳುತ್ತಾರೆ. ಅವರು ಅರ್ಪಿಸುವಂಥಾದ್ದು ಅಶುದ್ಧವೇ.<verse eid="HAG 2:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="HAG 2:15"/>“ಈಗ ಚೆನ್ನಾಗಿ ಯೋಚಿಸಿಕೊಳ್ಳಿರಿ. ಯೆಹೋವ ದೇವರ ಆಲಯ ನಿವೇಶನದಲ್ಲಿ, ಕಲ್ಲಿನ ಮೇಲೆ ಕಲ್ಲು ಇಡುವ, ಈ ಮೊದಲ ದಿನದ ಹಿಂದಿನ ಕಾಲವನ್ನು ನೆನಪಿಗೆ ತಂದುಕೊಳ್ಳಿರಿ. <verse eid="HAG 2:15"/><verse number="16" style="v" sid="HAG 2:16"/>ಆ ದಿನಗಳು ಇದ್ದದ್ದು ಮೊದಲುಗೊಂಡು, ಒಬ್ಬನು ಇಪ್ಪತ್ತು ಸೇರಿನ ರಾಶಿಗೆ ಬಂದಾಗ, ಹತ್ತು ಸೇರು ಮಾತ್ರ ಸಿಕ್ಕುತ್ತಿತ್ತು. ಒಬ್ಬನು ಐವತ್ತು ಪಾತ್ರೆ ದ್ರಾಕ್ಷಾರಸವನ್ನು ತುಂಬಿಸುವುದಕ್ಕೆ ತೊಟ್ಟಿಗೆ ಬಂದಾಗ, ಇಪ್ಪತ್ತು ಮಾತ್ರ ದೊರೆಯುತ್ತಿತ್ತಷ್ಟೆ. <verse eid="HAG 2:16"/><verse number="17" style="v" sid="HAG 2:17"/>ನಾನು ನಿಮ್ಮ ಕೈ ದುಡಿತಗಳನ್ನೆಲ್ಲಾ ಬೂಜಿನಿಂದಲೂ ಉರಿಗಾಳಿಯಿಂದಲೂ ಕಲ್ಮಳೆಯಿಂದಲೂ ಹಾಳುಮಾಡಿದೆನು. ಆದರೂ ನೀವು ನನ್ನ ಕಡೆಗೆ ತಿರುಗಲಿಲ್ಲವೆಂದು ಯೆಹೋವ ದೇವರು ಹೇಳುತ್ತಾರೆ. <verse eid="HAG 2:17"/><verse number="18" style="v" sid="HAG 2:18"/>ಚೆನ್ನಾಗಿ ನೆನಪಿಗೆ ತಂದುಕೊಳ್ಳಿರಿ. ಇಂದಿನಿಂದ ಇದಕ್ಕೆ ಮುಂಚೆ ಒಂಬತ್ತನೆಯ ತಿಂಗಳಿನ, ಇಪ್ಪತ್ನಾಲ್ಕನೆಯ ದಿವಸದಲ್ಲಿ, ಯೆಹೋವ ದೇವರ ಮಂದಿರದ ಅಸ್ತಿವಾರವು ಹಾಕಲಾದ ದಿನದಿಂದ ಸೂಕ್ಷ್ಮವಾಗಿ ಯೋಚಿಸಿಕೊಳ್ಳಿರಿ. <verse eid="HAG 2:18"/><verse number="19" style="v" sid="HAG 2:19"/>ಬೀಜವು ಇನ್ನು ಕಣಜದಲ್ಲಿ ಉಂಟೋ? ದ್ರಾಕ್ಷಿ, ಅಂಜೂರ, ದಾಳಿಂಬೆ, ಎಣ್ಣೆಮರಗಳು ಇನ್ನೂ ಫಲಿಸಲಿಲ್ಲವಲ್ಲಾ.</para>
  <para style="p" vid="HAG 2:19">“ಈ ದಿನ ಮೊದಲುಗೊಂಡು ನಿಮ್ಮನ್ನು ಆಶೀರ್ವದಿಸುವೆನು,” ಎಂದರು.<verse eid="HAG 2:19"/></para>
  <para style="s1">ಜೆರುಬ್ಬಾಬೆಲು ಯೆಹೋವ ದೇವರ ಮುದ್ರೆಯ ಉಂಗುರ</para>
  <para style="p">
    <verse number="20" style="v" sid="HAG 2:20"/>ಎರಡನೆಯ ಸಾರಿ ಯೆಹೋವ ದೇವರ ವಾಕ್ಯವು, ಅದೇ ತಿಂಗಳಿನ ಇಪ್ಪತ್ತನಾಲ್ಕನೆಯ ದಿವಸದಲ್ಲಿ, ಹಗ್ಗಾಯನಿಗೆ ಬಂದಿತು. <verse eid="HAG 2:20"/><verse number="21" style="v" sid="HAG 2:21"/>ಯೆಹೂದದ ಅಧಿಪತಿಯಾದ ಜೆರುಬ್ಬಾಬೆಲನಿಗೆ ನೀನು ಹೇಳತಕ್ಕದ್ದೇನೆಂದರೆ, “ನಾನು ಆಕಾಶಗಳನ್ನೂ, ಭೂಮಿಯನ್ನೂ ಕದಲಿಸುವೆನು. <verse eid="HAG 2:21"/><verse number="22" style="v" sid="HAG 2:22"/>ರಾಜ್ಯಗಳ ಸಿಂಹಾಸನವನ್ನು ಕೆಡವಿಹಾಕುವೆನು. ನಾನು ಇತರ ಜನಾಂಗಗಳ, ರಾಜ್ಯಗಳ ಬಲವನ್ನು ನಾಶಮಾಡುವೆನು. ರಥಗಳನ್ನೂ, ಅವುಗಳಲ್ಲಿ ಸವಾರಿ ಮಾಡುವವರನ್ನೂ ಕೆಡವಿಹಾಕುವೆನು. ಕುದುರೆಗಳೂ ಅದರ ಸವಾರರೂ ಪ್ರತಿಯೊಬ್ಬನೂ ತನ್ನ ಸಹೋದರನ ಖಡ್ಗದಿಂದ ಬೀಳುವನು.<verse eid="HAG 2:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="HAG 2:23"/>“ಸೇನಾಧೀಶ್ವರ ಯೆಹೋವ ದೇವರು ಹೀಗೆ ಹೇಳುತ್ತಾರೆ: ‘ಶೆಯಲ್ತಿಯೇಲನ ಮಗನಾದ ನನ್ನ ಸೇವಕ ಜೆರುಬ್ಬಾಬೆಲನೇ, ಆ ದಿನದಲ್ಲಿ ನಾನು ನಿನ್ನನ್ನು ತೆಗೆದುಕೊಂಡು ನಿನ್ನನ್ನು ಮುದ್ರೆಯ ಉಂಗುರದ ಹಾಗೆ ಇಡುವೆನು. ಏಕೆಂದರೆ ನಿನ್ನನ್ನು ನಾನೇ ಆಯ್ದುಕೊಂಡಿದ್ದೇನೆ,’ ಎಂದು ಸೇನಾಧೀಶ್ವರ ಯೆಹೋವ ದೇವರು ಹೇಳುತ್ತಾರೆ.”<verse eid="HAG 2:23"/></para>
  <chapter eid="HAG 2"/>
</usx>
