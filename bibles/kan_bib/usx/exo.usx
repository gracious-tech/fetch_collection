<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="EXO" style="id">- Biblica® Open Kannada Contemporary Version</book>
  <para style="h">ವಿಮೋಚನಕಾಂಡ</para>
  <para style="toc1">ವಿಮೋಚನಕಾಂಡ</para>
  <para style="toc2">ವಿಮೋಚನಕಾಂಡ</para>
  <para style="toc3">ವಿಮೋ</para>
  <para style="mt1">ವಿಮೋಚನಕಾಂಡ</para>
  <chapter number="1" style="c" sid="EXO 1"/>
  <para style="s1">ಇಸ್ರಾಯೇಲರಿಗಾದ ಹಿಂಸೆ</para>
  <para style="li4">
    <verse number="1" style="v" sid="EXO 1:1"/>ಯಾಕೋಬನೊಂದಿಗೆ ಈಜಿಪ್ಟಿಗೆ ತಮ್ಮ ತಮ್ಮ ಮನೆಯವರ ಸಂಗಡ ಬಂದ ಇಸ್ರಾಯೇಲನ ಮಕ್ಕಳ ಹೆಸರುಗಳು:<verse eid="EXO 1:1"/></para>
  <para style="b"/>
  <para style="li1">
    <verse number="2" style="v" sid="EXO 1:2"/>ರೂಬೇನ್, ಸಿಮೆಯೋನ್, ಲೇವಿ ಮತ್ತು ಯೆಹೂದ,<verse eid="EXO 1:2"/></para>
  <para style="li1">
    <verse number="3" style="v" sid="EXO 1:3"/>ಇಸ್ಸಾಕಾರ್ ಜೆಬುಲೂನ್ ಮತ್ತು ಬೆನ್ಯಾಮೀನ್,<verse eid="EXO 1:3"/></para>
  <para style="li1">
    <verse number="4" style="v" sid="EXO 1:4"/>ದಾನ್, ನಫ್ತಾಲಿ,</para>
  <para style="li1" vid="EXO 1:4">ಗಾದ್ ಮತ್ತು ಆಶೇರ್.<verse eid="EXO 1:4"/></para>
  <para style="b"/>
  <para style="li4">
    <verse number="5" style="v" sid="EXO 1:5"/>ಯಾಕೋಬನ ವಂಶಜರು ಒಟ್ಟು ಎಪ್ಪತ್ತು ಮಂದಿ ಆದರೆ ಯೋಸೇಫನು ಮೊದಲೇ ಈಜಿಪ್ಟಿನಲ್ಲಿದ್ದನು.<verse eid="EXO 1:5"/></para>
  <para style="b"/>
  <para style="p">
    <verse number="6" style="v" sid="EXO 1:6"/>ಹಲವು ವರ್ಷಗಳ ಬಳಿಕ ಯೋಸೇಫನೂ ಅವನ ಸಹೋದರರೆಲ್ಲರೂ ಆ ಸಂತತಿಯವರೆಲ್ಲರೂ ಸತ್ತರು. <verse eid="EXO 1:6"/><verse number="7" style="v" sid="EXO 1:7"/>ಆದರೆ ಇಸ್ರಾಯೇಲರ ಮಕ್ಕಳು ಅತ್ಯಧಿಕವಾಗಿ ಅಭಿವೃದ್ಧಿಯಾಗಿ ಹೆಚ್ಚಿನ ಸಂಖ್ಯೆಯಲ್ಲಿ ಹರಡಿಕೊಂಡು ಬಲಗೊಂಡರು, ಅದರಿಂದ ಆ ದೇಶವು ಅವರಿಂದ ತುಂಬಿತು.<verse eid="EXO 1:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="EXO 1:8"/>ತರುವಾಯ ಯೋಸೇಫನನ್ನೇ ಅರಿಯದ ಬೇರೊಬ್ಬ ಅರಸನು, ಈಜಿಪ್ಟಿನಲ್ಲಿ ಅಧಿಕಾರಕ್ಕೆ ಬಂದನು. <verse eid="EXO 1:8"/><verse number="9" style="v" sid="EXO 1:9"/>ಅವನು ತನ್ನ ಜನರಿಗೆ, “ಇಸ್ರಾಯೇಲರು ನಮಗಿಂತ ಹೆಚ್ಚಿನ ಸಂಖ್ಯೆಯಲ್ಲಿದ್ದಾರೆ ಮತ್ತು ಹೆಚ್ಚು ಬಲವುಳ್ಳವರಾಗಿದ್ದಾರೆ. <verse eid="EXO 1:9"/><verse number="10" style="v" sid="EXO 1:10"/>ನಮಗೆ ಯುದ್ಧ ಸಂಭವಿಸಿದರೆ ಅವರು ನಮ್ಮ ಶತ್ರುಗಳ ಸಂಗಡ ಕೂಡಿಕೊಂಡು, ನಮಗೆ ವಿರೋಧವಾಗಿ ಯುದ್ಧಮಾಡಿ, ದೇಶವನ್ನು ಬಿಟ್ಟು ಹೋಗಬಹುದು ಆದ್ದರಿಂದ ಅವರು ವೃದ್ಧಿಯಾಗದಂತೆ ಅವರೊಂದಿಗೆ ಬುದ್ಧಿವಂತಿಕೆಯಿಂದ ನಾವು ವರ್ತಿಸೋಣ,” ಎಂದನು.<verse eid="EXO 1:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="EXO 1:11"/>ಆಗ ಅವರನ್ನು ಬಿಟ್ಟೀ ಕೆಲಸಗಳಿಂದ ಶ್ರಮಪಡಿಸುವುದಕ್ಕಾಗಿ, ಬಿಟ್ಟೀ ಕೆಲಸಮಾಡಿಸುವ ಅಧಿಕಾರಿಗಳನ್ನು ಅವರ ಮೇಲೆ ನೇಮಿಸಿದರು. ಅವರು ಫರೋಹನಿಗೆ ಪಿತೋಮ್ ಮತ್ತು ರಮ್ಸೇಸ್ ಎಂಬ ಉಗ್ರಾಣ ಪಟ್ಟಣಗಳನ್ನು ಕಟ್ಟಿಸಿದರು. <verse eid="EXO 1:11"/><verse number="12" style="v" sid="EXO 1:12"/>ಆದರೆ ಈಜಿಪ್ಟನವರು ಅವರನ್ನು ಎಷ್ಟು ಶ್ರಮಪಡಿಸಿದರೋ, ಅಷ್ಟು ಅಧಿಕವಾಗಿ ಅವರು ಹೆಚ್ಚಿ ಹರಡಿಕೊಂಡದ್ದರಿಂದ ಈಜಿಪ್ಟಿನವರು ಇಸ್ರಾಯೇಲರ ಬಗ್ಗೆ ಹೆದರಿದವರಾದರು. <verse eid="EXO 1:12"/><verse number="13" style="v" sid="EXO 1:13"/>ಆದ್ದರಿಂದ ಈಜಿಪ್ಟಿನವರು ಇಸ್ರಾಯೇಲರನ್ನು ಕ್ರೂರವಾಗಿ ನಡೆಸಿಕೊಳ್ಳುತ್ತಾ ಸೇವೆ ಮಾಡಿಸಿಕೊಂಡರು. <verse eid="EXO 1:13"/><verse number="14" style="v" sid="EXO 1:14"/>ಮಣ್ಣು ಅಗೆಯುವ, ಇಟ್ಟಿಗೆಯನ್ನು ಮಾಡುವ ಮತ್ತು ವ್ಯವಸಾಯದ ಎಲ್ಲಾ ವಿಧವಾದ ಕೆಲಸಗಳಲ್ಲಿಯೂ ಕಠಿಣವಾಗಿ ದುಡಿಸಿಕೊಂಡು ಅವರ ಜೀವಿತವನ್ನೇ ಬೇಸರಪಡಿಸಿದರು. ಈಜಿಪ್ಟಿನವರು ಅವರಿಂದ ಮಾಡಿಸಿದ ಎಲ್ಲಾ ಕೆಲಸವು ಕಠೋರವಾಗಿತ್ತು.<verse eid="EXO 1:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="EXO 1:15"/>ಈಜಿಪ್ಟಿನ ಅರಸನು ಶಿಪ್ರಾ ಮತ್ತು ಪೂಗಾ ಎಂದು ಹೆಸರಿದ್ದ ಹಿಬ್ರಿಯ ಸೂಲಗಿತ್ತಿಯರ ಸಂಗಡ ಮಾತನಾಡಿ, <verse eid="EXO 1:15"/><verse number="16" style="v" sid="EXO 1:16"/>ಅವರಿಗೆ, “ನೀವು ಹಿಬ್ರಿಯ ಸ್ತ್ರೀಯರಿಗೆ ಸೂಲಗಿತ್ತಿಯ ಕೆಲಸ ಮಾಡುವುದಕ್ಕೆ ಹೆರಿಗೆಯ ಸಮಯದಲ್ಲಿ ಅವರನ್ನು ಪರಾಂಬರಿಸುವಾಗ, ಗಂಡು ಮಗುವಾದರೆ ಅದನ್ನು ಕೊಂದುಹಾಕಿರಿ, ಹೆಣ್ಣಾದರೆ ಬದುಕಲಿ,” ಎಂದು ಹೇಳಿದ್ದನು. <verse eid="EXO 1:16"/><verse number="17" style="v" sid="EXO 1:17"/>ಆದರೆ ಸೂಲಗಿತ್ತಿಯರು ದೇವರಿಗೆ ಭಯಪಟ್ಟು ಈಜಿಪ್ಟಿನ ಅರಸನು ತಮಗೆ ಹೇಳಿದಂತೆ ಮಾಡದೆ ಗಂಡು ಮಕ್ಕಳನ್ನು ಬದುಕಿಸಿದರು. <verse eid="EXO 1:17"/><verse number="18" style="v" sid="EXO 1:18"/>ಆಗ ಈಜಿಪ್ಟಿನ ಅರಸನು ಸೂಲಗಿತ್ತಿಯರನ್ನು ಕರೆಯಿಸಿ, “ಏಕೆ ಗಂಡು ಮಕ್ಕಳನ್ನು ಬದುಕಿಸಿದ್ದೀರಿ? ಇಂಥ ಕೆಲಸವನ್ನು ಏಕೆ ಮಾಡಿದಿರಿ?” ಎಂದನು.<verse eid="EXO 1:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="EXO 1:19"/>ಸೂಲಗಿತ್ತಿಯರು ಫರೋಹನಿಗೆ, “ಹಿಬ್ರಿಯರ ಸ್ತ್ರೀಯರು ಈಜಿಪ್ಟಿನ ಸ್ತ್ರೀಯರಂತೆ ಅಲ್ಲ, ಅವರು ಚುರುಕಾಗಿದ್ದಾರೆ. ಸೂಲಗಿತ್ತಿಯರು ಅವರ ಹತ್ತಿರ ಬರುವುದಕ್ಕೆ ಮುಂಚೆಯೇ ಹೆರುತ್ತಾರೆ,” ಎಂದರು.<verse eid="EXO 1:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="EXO 1:20"/>ಆದ್ದರಿಂದ ದೇವರು ಸೂಲಗಿತ್ತಿಯರಿಗೆ ಒಳ್ಳೆಯದನ್ನು ಮಾಡಿದರು. ಇದಲ್ಲದೆ ಇಸ್ರಾಯೇಲರು ಸಂಖ್ಯೆಯಲ್ಲೂ ಹೆಚ್ಚಾಗಿ ಬಹು ಬಲಗೊಂಡರು. <verse eid="EXO 1:20"/><verse number="21" style="v" sid="EXO 1:21"/>ಸೂಲಗಿತ್ತಿಯರು ದೇವರಿಗೆ ಭಯಪಟ್ಟದ್ದರಿಂದ, ದೇವರು ಅವರ ಕುಟುಂಬಕ್ಕೆ ಅಭಿವೃದ್ಧಿಯನ್ನು ಉಂಟುಮಾಡಿದರು.<verse eid="EXO 1:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="EXO 1:22"/>ಆದರೆ ಫರೋಹನು ತನ್ನ ಎಲ್ಲಾ ಜನರಿಗೆ, “ಹುಟ್ಟುವ ಹಿಬ್ರಿಯರ ಗಂಡು ಮಕ್ಕಳನ್ನೆಲ್ಲಾ ನೈಲ್ ನದಿಯಲ್ಲಿ ಹಾಕಬೇಕು, ಹೆಣ್ಣುಮಕ್ಕಳನ್ನೆಲ್ಲಾ ಬದುಕಿಸಬೇಕು,” ಎಂದು ಅಪ್ಪಣೆಕೊಟ್ಟನು.<verse eid="EXO 1:22"/></para>
  <chapter eid="EXO 1"/>
  <chapter number="2" style="c" sid="EXO 2"/>
  <para style="s1">ಮೋಶೆಯ ಜನನ ಮತ್ತು ಬಾಲ್ಯ</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 2:1"/>ಈ ಸಮಯದಲ್ಲಿ ಲೇವಿಯ ವಂಶದವನಾದ ಒಬ್ಬನು ಲೇವಿಯ ಸ್ತ್ರೀಯನ್ನು ಮದುವೆಯಾದನು. <verse eid="EXO 2:1"/><verse number="2" style="v" sid="EXO 2:2"/>ಆ ಸ್ತ್ರೀಯು ಗರ್ಭಧರಿಸಿ, ಗಂಡು ಮಗುವನ್ನು ಹೆತ್ತಳು. ಅದು ಸುಂದರವಾಗಿದ್ದುದರಿಂದ ಮೂರು ತಿಂಗಳು ಬಚ್ಚಿಟ್ಟರು. <verse eid="EXO 2:2"/><verse number="3" style="v" sid="EXO 2:3"/>ಆದರೆ ಅದನ್ನು ಹೆಚ್ಚುಕಾಲ ಬಚ್ಚಿಡುವುದಕ್ಕಾಗದೆ ಇದ್ದಾಗ, ಅವನಿಗಾಗಿ ಆಪಿನ ಪೆಟ್ಟಿಗೆಯನ್ನು ತೆಗೆದುಕೊಂಡು, ಜೇಡಿಮಣ್ಣನ್ನು ಮತ್ತು ರಾಳವನ್ನು ಹಚ್ಚಿ, ಕೂಸನ್ನು ಅದರಲ್ಲಿಟ್ಟು, ನೈಲ್ ನದಿಯ ಅಂಚಿನಲ್ಲಿ ಇದ್ದ ಜಂಬು ಹುಲ್ಲಿನಲ್ಲಿ ಇಟ್ಟರು. <verse eid="EXO 2:3"/><verse number="4" style="v" sid="EXO 2:4"/>ಕೂಸಿಗೆ ಏನಾಗುವುದೋ ಎಂದು ತಿಳಿದುಕೊಳ್ಳುವುದಕ್ಕೆ ದೂರದಲ್ಲಿ ಅದರ ಅಕ್ಕ ನಿಂತುಕೊಂಡಳು.<verse eid="EXO 2:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="EXO 2:5"/>ಆಗ ಫರೋಹನ ಮಗಳು ನೈಲ್ ನದಿಯಲ್ಲಿ ಸ್ನಾನ ಮಾಡುವದಕ್ಕೆ ಬಂದಳು. ಆಕೆಯ ದಾಸಿಯರು ನದಿಯ ಅಂಚಿನಲ್ಲಿ ತಿರುಗಾಡುತ್ತಿದ್ದರು. ಫರೋಹನ ಮಗಳು ಜಂಬು ಹುಲ್ಲಿನಲ್ಲಿದ್ದ ಪೆಟ್ಟಿಗೆಯನ್ನು ನೋಡಿ ತನ್ನ ದಾಸಿಯನ್ನು ಕಳುಹಿಸಿ, ಅದನ್ನು ತರಿಸಿದಳು. <verse eid="EXO 2:5"/><verse number="6" style="v" sid="EXO 2:6"/>ಆ ಪೆಟ್ಟಿಗೆಯನ್ನು ತೆರೆದಾಗ, ಕೂಸನ್ನು ನೋಡಿದಳು. ಕೂಸು ಅಳುತ್ತಿತ್ತು. ಆಕೆಗೆ ಅದರ ಮೇಲೆ ಕನಿಕರ ಹುಟ್ಟಿತು. ಅವಳು, “ಇದು ಹಿಬ್ರಿಯರ ಮಕ್ಕಳಲ್ಲಿ ಒಂದಾಗಿರಬೇಕು,” ಎಂದು ಹೇಳಿದಳು.<verse eid="EXO 2:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="EXO 2:7"/>ಆಗ ಮಗುವಿನ ಅಕ್ಕ ಫರೋಹನ ಮಗಳಿಗೆ, “ನಾನು ಹೋಗಿ ಈ ಕೂಸಿಗೆ ಹಾಲು ಕೊಟ್ಟು ಸಾಕುವುದಕ್ಕೆ ಹಿಬ್ರಿಯ ಸ್ತ್ರೀಯರಿಂದ ಒಬ್ಬ ದಾದಿಯನ್ನು ನಿನಗೋಸ್ಕರ ಕರೆದುಕೊಂಡು ಬರಲೋ?” ಎಂದಳು.<verse eid="EXO 2:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="EXO 2:8"/>ಫರೋಹನ ಮಗಳು ಆಕೆಗೆ, “ಹೌದು, ಹೋಗು,” ಎಂದಳು. ಆಗ ಆ ಹುಡುಗಿಯು ಹೋಗಿ ಕೂಸಿನ ತಾಯಿಯನ್ನೇ ಕರೆದುಕೊಂಡು ಬಂದಳು. <verse eid="EXO 2:8"/><verse number="9" style="v" sid="EXO 2:9"/>ಫರೋಹನ ಮಗಳು ಆಕೆಗೆ, “ಈ ಮಗುವನ್ನು ತೆಗೆದುಕೊಂಡುಹೋಗಿ, ನನಗೋಸ್ಕರ ಸಾಕು. ನಾನು ನಿನಗೆ ಸಂಬಳವನ್ನು ಕೊಡುವೆನು,” ಎಂದಳು. ಆಗ ಆ ಸ್ತ್ರೀಯು ಕೂಸನ್ನು ತೆಗೆದುಕೊಂಡುಹೋಗಿ ಸಾಕಿದಳು. <verse eid="EXO 2:9"/><verse number="10" style="v" sid="EXO 2:10"/>ಆ ಮಗುವು ಬೆಳೆದಾಗ, ಅವನನ್ನು ಫರೋಹನ ಮಗಳ ಬಳಿಗೆ ತೆಗೆದುಕೊಂಡು ಹೋದಳು. ಅವನು ಆಕೆಗೆ ಮಗನಾದನು. ಆಕೆಯು, “ನೀರಿನೊಳಗಿಂದ ಇವನನ್ನು ಎಳೆದೆ,” ಎಂದು ಹೇಳಿ ಅವನಿಗೆ “ಮೋಶೆ” ಎಂದು ಹೆಸರಿಟ್ಟಳು.<verse eid="EXO 2:10"/></para>
  <para style="s1">ಮೋಶೆಯು ಮಿದ್ಯಾನ್ ದೇಶಕ್ಕೆ ಓಡಿಹೋದದ್ದು</para>
  <para style="p">
    <verse number="11" style="v" sid="EXO 2:11"/>ಹಲವು ವರ್ಷಗಳ ನಂತರ ಮೋಶೆಯು ದೊಡ್ಡವನಾದ ಮೇಲೆ ತನ್ನ ಸಹೋದರರ ಬಳಿಗೆ ಹೋಗಿ ಅವರ ಬಿಟ್ಟೀ ಕೆಲಸಗಳನ್ನು ನೋಡಿದಾಗ, ಒಬ್ಬ ಈಜಿಪ್ಟಿನವನು ತನ್ನ ಸಹೋದರರಲ್ಲಿ ಒಬ್ಬ ಹಿಬ್ರಿಯನನ್ನು ಹೊಡೆಯುವುದನ್ನು ನೋಡಿದನು. <verse eid="EXO 2:11"/><verse number="12" style="v" sid="EXO 2:12"/>ಅವನು ಸುತ್ತಮುತ್ತ ನೋಡಿ, ಯಾರೂ ಇಲ್ಲವೆಂದು ತಿಳಿದು ಆ ಈಜಿಪ್ಟಿನವನನ್ನು ಕೊಂದುಹಾಕಿ, ಮರಳಿನಲ್ಲಿ ಮುಚ್ಚಿಹಾಕಿದನು. <verse eid="EXO 2:12"/><verse number="13" style="v" sid="EXO 2:13"/>ಮರುದಿನ ಅವನು ಮತ್ತೆ ಹೊರಗೆ ಹೋದಾಗ, ಹಿಬ್ರಿಯರಾದ ಇಬ್ಬರು ಮನುಷ್ಯರು ಜಗಳವಾಡುತ್ತಿದ್ದರು. ತಪ್ಪು ಮಾಡಿದವನಿಗೆ ಮೋಶೆ, “ಏಕೆ ನಿನ್ನ ಜೊತೆಯವನನ್ನು ಹೊಡೆಯುತ್ತೀ?” ಎಂದನು.<verse eid="EXO 2:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="EXO 2:14"/>ಅದಕ್ಕವನು, “ಯಾರು ನಿನ್ನನ್ನು ನಮ್ಮ ಮೇಲೆ ಪ್ರಭುವನ್ನಾಗಿಯೂ ನ್ಯಾಯಾಧಿಪತಿಯನ್ನಾಗಿಯೂ ನೇಮಿಸಿದ್ದಾರೆ? ಆ ಈಜಿಪ್ಟಿನವನನ್ನು ಕೊಂದುಹಾಕಿದಂತೆ ನನ್ನನ್ನೂ ಕೊಂದು ಹಾಕಬೇಕೆಂದಿದ್ದೀಯೋ?” ಎಂದನು. ಆಗ ಮೋಶೆಯು ಭಯಪಟ್ಟು, “ನಿಶ್ಚಯವಾಗಿ ನಾನು ಮಾಡಿದ ಕಾರ್ಯವು ತಿಳಿದಿರಬೇಕು,” ಎಂದುಕೊಂಡನು.<verse eid="EXO 2:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="EXO 2:15"/>ಫರೋಹನು ಈ ವಿಷಯವನ್ನು ಕೇಳಿದಾಗ, ಮೋಶೆಯನ್ನು ಕೊಂದುಹಾಕುವುದಕ್ಕೆ ಪ್ರಯತ್ನಿಸಿದನು. ಆದರೆ ಮೋಶೆಯು ಫರೋಹನ ಎದುರಿನಿಂದ ಓಡಿಹೋಗಿ ಮಿದ್ಯಾನ್ ದೇಶಕ್ಕೆ ವಾಸಿಸಲು ಹೋದನು. ಅಲ್ಲಿ ಒಂದು ಬಾವಿಯ ಬಳಿಯಲ್ಲಿ ಕೂತುಕೊಂಡನು. <verse eid="EXO 2:15"/><verse number="16" style="v" sid="EXO 2:16"/>ಮಿದ್ಯಾನಿನ ಯಾಜಕನಿಗೆ ಏಳುಮಂದಿ ಪುತ್ರಿಯರಿದ್ದರು. ಇವರು ಬಂದು ತಮ್ಮ ತಂದೆಯ ಕುರಿಮಂದೆಗಳಿಗೆ ನೀರು ಕುಡಿಸುವದಕ್ಕಾಗಿ ನೀರು ಸೇದಿ, ದೋಣಿಗಳನ್ನು ತುಂಬಿಸುತ್ತಿದ್ದರು. <verse eid="EXO 2:16"/><verse number="17" style="v" sid="EXO 2:17"/>ಕುರುಬರು ಬಂದು ಅವರನ್ನು ಅಲ್ಲಿಂದ ಓಡಿಸಲು, ಮೋಶೆಯು ಎದ್ದು ಬಂದು ಅವರಿಗೆ ಸಹಾಯಮಾಡಿ, ಅವರ ಕುರಿಗಳಿಗೆ ನೀರು ಕುಡಿಸಿದನು.<verse eid="EXO 2:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="EXO 2:18"/>ಹುಡುಗಿಯರು ತಮ್ಮ ತಂದೆ ರೆಯೂವೇಲನ ಬಳಿಗೆ ಬಂದಾಗ, ಅವನು ಅವರಿಗೆ, “ಏಕೆ ಈ ಹೊತ್ತು ಬೇಗ ಬಂದಿರಿ?” ಎಂದನು.<verse eid="EXO 2:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="EXO 2:19"/>ಅದಕ್ಕೆ ಅವರು, “ಈಜಿಪ್ಟಿನವನಾದ ಒಬ್ಬ ಮನುಷ್ಯನು ಕುರುಬರ ಕೈಯಿಂದ ನಮ್ಮನ್ನು ತಪ್ಪಿಸಿ, ನಮಗೋಸ್ಕರ ಸಾಕಾಗುವಷ್ಟು ನೀರು ಸೇದಿ, ಮಂದೆಗೆ ಕುಡಿಸಿದನು,” ಎಂದರು.<verse eid="EXO 2:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="EXO 2:20"/>ಆಗ ರೆಯೂವೇಲನು ತನ್ನ ಪುತ್ರಿಯರಿಗೆ, “ಅವನು ಎಲ್ಲಿದ್ದಾನೆ? ಏಕೆ ಆ ಮನುಷ್ಯನನ್ನು ಬಿಟ್ಟು ಬಂದಿರಿ? ಅವನನ್ನು ಕರೆಯಿರಿ, ಅವನು ಊಟಮಾಡಲಿ,” ಎಂದನು.<verse eid="EXO 2:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="EXO 2:21"/>ಮೋಶೆಯು ಆ ಮನುಷ್ಯನ ಸಂಗಡ ವಾಸಮಾಡುವುದಕ್ಕೆ ಸಮ್ಮತಿಸಿದನು. ಅವನು ಮೋಶೆಗೆ ತನ್ನ ಮಗಳಾದ ಚಿಪ್ಪೋರಳನ್ನು ಮದುವೆ ಮಾಡಿಕೊಟ್ಟನು. <verse eid="EXO 2:21"/><verse number="22" style="v" sid="EXO 2:22"/>ಆಕೆಯು ಅವನಿಗೆ ಮಗನನ್ನು ಹೆತ್ತಾಗ, ಮೋಶೆಯು ಅವನಿಗೆ ಗೇರ್ಷೋಮ್<note caller="+" style="f"><char style="fr" closed="false">2:22 </char><char style="fq" closed="false">ಗೇರ್ಷೋಮ್ </char><char style="ft" closed="false">ಹೀಬ್ರೂ ಭಾಷೆಯಲ್ಲಿ </char><char style="fqa" closed="false">ಪರದೇಶದವನು</char></note> ಎಂದು ಹೆಸರಿಟ್ಟನು ಏಕೆಂದರೆ ಅವನು, “ನಾನು ಪರದೇಶದಲ್ಲಿ ಅನ್ಯನಾಗಿದ್ದೇನೆ,” ಎಂದನು.<verse eid="EXO 2:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="EXO 2:23"/>ಹೀಗೆ ಬಹಳ ದಿನಗಳಾದ ಮೇಲೆ ಈಜಿಪ್ಟಿನ ಅರಸನು ಸತ್ತನು. ಇಸ್ರಾಯೇಲರು ದಾಸತ್ವದ ಕಾರಣದಿಂದ ನರಳಾಡುತ್ತಾ ಮೊರೆಯಿಡುತ್ತಿದ್ದರು. ದಾಸತ್ವದ ನಿಮಿತ್ತವಾಗಿ ಅವರ ಕೂಗು ದೇವರ ಬಳಿಗೆ ಮುಟ್ಟಿತು. <verse eid="EXO 2:23"/><verse number="24" style="v" sid="EXO 2:24"/>ದೇವರು ಅವರ ನರಳಾಟವನ್ನು ಕೇಳಿದಾಗ, ಅವರು ಅಬ್ರಹಾಮ, ಇಸಾಕ ಮತ್ತು ಯಾಕೋಬನ ಸಂಗಡ ತಾವು ಮಾಡಿದ ಒಡಂಬಡಿಕೆಯನ್ನು ಜ್ಞಾಪಕಮಾಡಿಕೊಂಡರು. <verse eid="EXO 2:24"/><verse number="25" style="v" sid="EXO 2:25"/>ದೇವರು ಇಸ್ರಾಯೇಲರನ್ನು ನೋಡಿ ಅವರಲ್ಲಿ ಕನಿಕರಗೊಂಡರು.<verse eid="EXO 2:25"/></para>
  <chapter eid="EXO 2"/>
  <chapter number="3" style="c" sid="EXO 3"/>
  <para style="s1">ಮೋಶೆ ಹಾಗೂ ಉರಿಯುತ್ತಿರುವ ಪೊದೆ</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 3:1"/>ಮೋಶೆಯು ತನ್ನ ಮಾವನೂ ಮಿದ್ಯಾನಿನ ಯಾಜಕನೂ ಆದ ಇತ್ರೋವನ ಮಂದೆಯನ್ನು ಮೇಯಿಸುತ್ತಿದ್ದನು. ಮರುಭೂಮಿಯ ಹಿಂಭಾಗಕ್ಕೆ ನಡೆಸಿಕೊಂಡು ಹೋಗಿ ಹೋರೇಬ್ ಎಂಬ ದೇವರ ಬೆಟ್ಟಕ್ಕೆ ಬಂದನು. <verse eid="EXO 3:1"/><verse number="2" style="v" sid="EXO 3:2"/>ಆಗ ಯೆಹೋವ ದೇವರ ದೂತನು ಪೊದೆಯೊಳಗೆ ಉರಿಯುವ ಬೆಂಕಿಯಲ್ಲಿ ಅವನಿಗೆ ಕಾಣಿಸಿಕೊಂಡನು. ಮೋಶೆಯು ನೋಡಿದಾಗ, ಪೊದೆಯು ಬೆಂಕಿಯಿಂದ ಉರಿಯುತ್ತಿತ್ತು ಆದಾಗ್ಯೂ ಪೊದೆಯು ಸುಟ್ಟು ಹೋಗಲಿಲ್ಲ. <verse eid="EXO 3:2"/><verse number="3" style="v" sid="EXO 3:3"/>ಆಗ ಮೋಶೆಯು, “ನಾನು ಹೋಗಿ ಆ ವಿಚಿತ್ರ ನೋಟವನ್ನೂ ಪೊದೆಯು ಏಕೆ ಸುಟ್ಟುಹೋಗಲಿಲ್ಲವೆಂಬುದನ್ನೂ ನೋಡುವೆನು,” ಎಂದುಕೊಂಡನು.<verse eid="EXO 3:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="EXO 3:4"/>ಅವನು ನೋಡುವುದಕ್ಕೆ ಹತ್ತಿರ ಬರುವುದನ್ನು ಯೆಹೋವ ದೇವರು ನೋಡಿದಾಗ, ದೇವರು ಪೊದೆಯೊಳಗಿಂದ ಅವನಿಗೆ, “ಮೋಶೇ, ಮೋಶೇ,” ಎಂದು ಕರೆದರು.</para>
  <para style="p" vid="EXO 3:4">ಆಗ ಅವನು, “ನಾನು ಇಲ್ಲಿ ಇದ್ದೇನೆ,” ಎಂದನು.<verse eid="EXO 3:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="EXO 3:5"/>ಆಗ ದೇವರು ಅವನಿಗೆ, “ಇಲ್ಲಿ ಸಮೀಪಕ್ಕೆ ಬರಬೇಡ, ನಿನ್ನ ಪಾದರಕ್ಷೆಗಳನ್ನು ತೆಗೆದಿಡು. ನೀನು ನಿಂತಿರುವ ಸ್ಥಳ ಪರಿಶುದ್ಧ ಭೂಮಿ,” ಎಂದರು. <verse eid="EXO 3:5"/><verse number="6" style="v" sid="EXO 3:6"/>ಇದಲ್ಲದೆ ಮೋಶೆಗೆ, “ನಾನು ನಿನ್ನ ಪಿತೃಗಳ ದೇವರೂ ಅಬ್ರಹಾಮನ ದೇವರೂ ಇಸಾಕನ ದೇವರೂ ಯಾಕೋಬನ ದೇವರೂ ಆಗಿದ್ದೇನೆ,” ಎಂದು ಹೇಳಿದರು. ಮೋಶೆಯು ದೇವರ ಕಡೆ ದೃಷ್ಟಿ ಇಡುವುದಕ್ಕೆ ಭಯಪಟ್ಟು ತನ್ನ ಮುಖವನ್ನು ಮುಚ್ಚಿಕೊಂಡನು.<verse eid="EXO 3:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="EXO 3:7"/>ಆಗ ಯೆಹೋವ ದೇವರು, “ಈಜಿಪ್ಟಿನಲ್ಲಿರುವ ನನ್ನ ಜನರ ವ್ಯಥೆಯನ್ನು ವಾಸ್ತವವಾಗಿಯೂ ಕಂಡಿದ್ದೇನೆ. ಬಿಟ್ಟೀ ಮಾಡಿಸುವವರ ವಿಷಯದಲ್ಲಿ ಅವರು ಇಟ್ಟ ಮೊರೆಯು ನನಗೆ ಕೇಳಿಸಿತು. ಅವರ ದುಃಖವನ್ನು ಬಲ್ಲೆನು. <verse eid="EXO 3:7"/><verse number="8" style="v" sid="EXO 3:8"/>ಆದಕಾರಣ ಅವರನ್ನು ಈಜಿಪ್ಟನವರ ಕೈಯೊಳಗಿಂದ ಬಿಡುಗಡೆ ಮಾಡುವುದಕ್ಕೆ ಬಂದಿದ್ದೇನೆ. ನಾನು ಅವರನ್ನು ಆ ದೇಶದಿಂದ ಬಿಡಿಸಿ, ಹಾಲೂ ಜೇನೂ ಹರಿಯುವ ವಿಸ್ತಾರವಾದ ಒಳ್ಳೆಯ ದೇಶಕ್ಕೆ ಅಂದರೆ ಕಾನಾನ್ಯರು, ಹಿತ್ತಿಯರು, ಅಮೋರಿಯರು, ಪೆರಿಜೀಯರು, ಹಿವ್ವಿಯರು, ಯೆಬೂಸಿಯರು ವಾಸವಾಗಿರುವ ದೇಶಕ್ಕೆ ನಡೆಸಿಕೊಂಡು ಹೋಗುವುದಕ್ಕೂ ಇಳಿದು ಬಂದಿದ್ದೇನೆ. <verse eid="EXO 3:8"/><verse number="9" style="v" sid="EXO 3:9"/>ಈಗ ಇಸ್ರಾಯೇಲರ ಕೂಗು ನನಗೆ ಮುಟ್ಟಿದೆ. ಈಜಿಪ್ಟಿನವರು ಅವರಿಗೆ ಕೊಡುತ್ತಿರುವ ಉಪದ್ರವವನ್ನು ನಾನು ನೋಡಿದ್ದೇನೆ. <verse eid="EXO 3:9"/><verse number="10" style="v" sid="EXO 3:10"/>ಆದ್ದರಿಂದ ಈಗ ಬಾ, ನಾನು ನಿನ್ನನ್ನು ಫರೋಹನ ಬಳಿಗೆ ಕಳುಹಿಸುತ್ತೇನೆ. ಇಸ್ರಾಯೇಲರಾದ ನನ್ನ ಜನರನ್ನು ನೀನು ಈಜಿಪ್ಟಿನೊಳಗಿಂದ ಹೊರಗೆ ಬರಮಾಡಬೇಕು,” ಎಂದರು.<verse eid="EXO 3:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="EXO 3:11"/>ಆಗ ಮೋಶೆಯು ದೇವರಿಗೆ, “ಫರೋಹನ ಬಳಿಗೆ ಹೋಗಿ, ಇಸ್ರಾಯೇಲರನ್ನು ಈಜಿಪ್ಟಿನೊಳಗಿಂದ ಹೊರಗೆ ತರುವುದಕ್ಕೆ ನಾನು ಎಷ್ಟರವನು?” ಎಂದನು.<verse eid="EXO 3:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="EXO 3:12"/>ಆಗ ದೇವರು, “ನಿಶ್ಚಯವಾಗಿ ನಾನು ನಿನ್ನ ಸಂಗಡ ಇರುವೆನು. ನೀನು ಜನರನ್ನು ಈಜಿಪ್ಟಿನೊಳಗಿಂದ ಹೊರಗೆ ತಂದ ತರುವಾಯ ನೀವು ಈ ಬೆಟ್ಟದ ಮೇಲೆ ದೇವರಾದ ನನ್ನನ್ನು ಆರಾಧಿಸುವಿರಿ. ನಾನು ನಿನ್ನನ್ನು ಕಳುಹಿಸಿದವನು ಎಂಬುದಕ್ಕೆ ಇದೇ ನಿನಗೆ ಗುರುತಾಗಿ ಇರುವುದು,” ಎಂದರು.<verse eid="EXO 3:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="EXO 3:13"/>ಅದಕ್ಕೆ ಮೋಶೆಯು ದೇವರಿಗೆ, “ಇಸ್ರಾಯೇಲರ ಬಳಿಗೆ ಹೋಗಿ, ‘ನಿಮ್ಮ ಪಿತೃಗಳ ದೇವರು ನನ್ನನ್ನು ನಿಮ್ಮ ಬಳಿಗೆ ಕಳುಹಿಸಿದ್ದಾರೆ,’ ಎಂದು ಹೇಳುವಾಗ ಅವರು ನನಗೆ, ‘ಅವರ ಹೆಸರು ಏನು?’ ಎಂದು ಕೇಳಿದರೆ, ನಾನು ಅವರಿಗೆ ಏನು ಹೇಳಬೇಕು?” ಎಂದನು.<verse eid="EXO 3:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="EXO 3:14"/>ಆಗ ದೇವರು ಮೋಶೆಗೆ, “ಇರುವಾತನೇ ಆಗಿದ್ದೇನೆ. ‘ಆ ಇರುವಾತನು ನನ್ನನ್ನು ನಿಮ್ಮ ಬಳಿಗೆ ಕಳುಹಿಸಿದ್ದಾರೆ,’ ಎಂದು ಇಸ್ರಾಯೇಲರಿಗೆ ಹೇಳಬೇಕು,” ಎಂದರು.<verse eid="EXO 3:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="EXO 3:15"/>ಮತ್ತೆ ದೇವರು ಮೋಶೆಗೆ, “ ‘ನಿಮ್ಮ ಪಿತೃಗಳ ದೇವರೂ ಅಬ್ರಹಾಮನ ದೇವರೂ ಇಸಾಕನ ದೇವರೂ ಯಾಕೋಬನ ದೇವರೂ ಆಗಿರುವ ಯೆಹೋವ ದೇವರು ನನ್ನನ್ನು ನಿಮ್ಮ ಬಳಿಗೆ ಕಳುಹಿಸಿದ್ದಾರೆ,’ ಎಂದು ಇಸ್ರಾಯೇಲರಿಗೆ ಹೇಳಬೇಕು,</para>
  <para style="q1" vid="EXO 3:15">“ಇದೇ ಯುಗಯುಗಕ್ಕೆ ನನ್ನ ಹೆಸರೂ,</para>
  <para style="q2" vid="EXO 3:15">ತಲತಲಾಂತರಕ್ಕೂ ನನ್ನನ್ನು</para>
  <para style="q2" vid="EXO 3:15">ಸ್ಮರಿಸಬೇಕಾದ ಹೆಸರು.<verse eid="EXO 3:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="EXO 3:16"/>“ನೀನು ಹೋಗಿ ಇಸ್ರಾಯೇಲ್ ಹಿರಿಯರನ್ನು ಕೂಡಿಸಿ ಅವರಿಗೆ, ‘ನಿಮ್ಮ ಪಿತೃಗಳ ದೇವರೂ ಅಬ್ರಹಾಮನ ದೇವರೂ ಇಸಾಕನ ದೇವರೂ ಯಾಕೋಬನ ದೇವರೂ ಆಗಿರುವ ಯೆಹೋವ ದೇವರು ನನಗೆ ಕಾಣಿಸಿಕೊಂಡು ಹೀಗೆಂದಿದ್ದಾರೆ: ನಾನು ನಿಮ್ಮನ್ನೂ ಈಜಿಪ್ಟಿನಲ್ಲಿ ನಿಮಗೆ ಸಂಭವಿಸಿದ್ದನ್ನೆಲ್ಲವನ್ನೂ ನಿಶ್ಚಯವಾಗಿ ನೋಡಿದ್ದೇನೆ. <verse eid="EXO 3:16"/><verse number="17" style="v" sid="EXO 3:17"/>ಈಜಿಪ್ಟಿನ ವ್ಯಥೆಯಿಂದ ಬಿಡಿಸಿ ನಿಮ್ಮನ್ನು ಕಾನಾನ್ಯರು, ಹಿತ್ತಿಯರು, ಅಮೋರಿಯರು, ಪೆರಿಜೀಯರು, ಹಿವ್ವಿಯರು, ಯೆಬೂಸಿಯರು ಇರುವ ಹಾಲು ಜೇನು ಹರಿಯುವ ದೇಶಕ್ಕೆ ಬರಮಾಡುವೆನೆಂದು ವಾಗ್ದಾನ ಮಾಡಿದ್ದೇನೆ,’ ಎಂದು ಅವರಿಗೆ ತಿಳಿಸು.<verse eid="EXO 3:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="EXO 3:18"/>“ಇಸ್ರಾಯೇಲರ ಹಿರಿಯರು ನಿನ್ನ ಮಾತನ್ನು ಕೇಳುವರು. ಆಗ ನೀನು ಇಸ್ರಾಯೇಲ್ ಜನರ ಹಿರಿಯರ ಸಹಿತವಾಗಿ ಈಜಿಪ್ಟಿನ ಅರಸನ ಬಳಿಗೆ ಹೋಗಿ ಅವನಿಗೆ, ‘ಹಿಬ್ರಿಯರ ದೇವರಾಗಿರುವ ಯೆಹೋವ ದೇವರು ನಮಗೆ ಪ್ರತ್ಯಕ್ಷನಾಗಿದ್ದಾರೆ. ಆದ್ದರಿಂದ ನಾವು ಮರುಭೂಮಿಯಲ್ಲಿ ಮೂರು ದಿನ ಪ್ರಯಾಣಮಾಡಿ, ನಮ್ಮ ಯೆಹೋವ ದೇವರಿಗೆ ಯಜ್ಞಮಾಡಬೇಕಾಗಿದೆ. ಅದಕ್ಕಾಗಿ ನಮ್ಮನ್ನು ಬಿಡು ಎಂದು ಬೇಡಿಕೊಳ್ಳುತ್ತೇವೆ,’ ಎಂದು ಹೇಳಬೇಕು. <verse eid="EXO 3:18"/><verse number="19" style="v" sid="EXO 3:19"/>ಆದರೂ ಈಜಿಪ್ಟಿನ ಅರಸನು ನೀವು ಎಷ್ಟು ಬಲವಂತ ಮಾಡಿದರೂ ನಿಮ್ಮನ್ನು ಹೋಗಗೊಡಿಸುವುದಿಲ್ಲ ಎಂದು ನನಗೆ ನಿಶ್ಚಯವಾಗಿ ತಿಳಿದಿದೆ. <verse eid="EXO 3:19"/><verse number="20" style="v" sid="EXO 3:20"/>ಹೀಗಿರುವುದರಿಂದ ನನ್ನ ಕೈಯನ್ನು ಚಾಚಿ ಈಜಿಪ್ಟ್ ದೇಶದಲ್ಲಿ ಅದ್ಭುತಕಾರ್ಯಗಳನ್ನು ಮಾಡಿ, ನಾನು ಅದನ್ನು ನಾನಾ ವಿಧವಾಗಿ ಬಾಧಿಸುವೆನು. ತರುವಾಯ ಅವನು ನಿಮ್ಮನ್ನು ಕಳುಹಿಸಿಬಿಡುವನು.<verse eid="EXO 3:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="EXO 3:21"/>“ಇದಲ್ಲದೆ ಈ ಜನರಿಗೆ ಈಜಿಪ್ಟಿನವರ ಕಣ್ಣೆದುರಿನಲ್ಲಿ ದಯೆ ದೊರಕುವಂತೆ ಮಾಡುವೆನು. ನೀವು ಹೋಗುವಾಗ ಬರಿಗೈಯಲ್ಲಿ ಹೋಗುವುದಿಲ್ಲ. <verse eid="EXO 3:21"/><verse number="22" style="v" sid="EXO 3:22"/>ಆದರೆ ಪ್ರತಿ ಸ್ತ್ರೀಯು ತನ್ನ ಮನೆಯಲ್ಲಿ ಇಳಿದುಕೊಂಡಿರುವ ಸ್ತ್ರೀಯಿಂದಲೂ ನೆರೆಯವಳಿಂದಲೂ ಬೆಳ್ಳಿಬಂಗಾರದ ಒಡವೆಗಳನ್ನು ಮತ್ತು ವಸ್ತ್ರಗಳನ್ನು ಕೇಳಿಕೊಳ್ಳಲಿ. ಅವುಗಳನ್ನು ನಿಮ್ಮ ಪುತ್ರಪುತ್ರಿಯರ ಮೇಲೆ ಹಾಕಿರಿ. ಹೀಗೆ ನೀವು ಈಜಿಪ್ಟಿನವರನ್ನು ಸೂರೆಮಾಡುವಿರಿ,” ಎಂದರು.<verse eid="EXO 3:22"/></para>
  <chapter eid="EXO 3"/>
  <chapter number="4" style="c" sid="EXO 4"/>
  <para style="s1">ಮೋಶೆಗಾಗಿ ಸೂಚಕಕಾರ್ಯಗಳು</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 4:1"/>ಮೋಶೆಯು ಉತ್ತರವಾಗಿ, “ಅವರು ನನ್ನನ್ನು ನಂಬದೆ, ನನ್ನ ಮಾತಿಗೆ ಕಿವಿಗೊಡದೆ, ‘ಯೆಹೋವ ದೇವರು ನಿನಗೆ ಕಾಣಿಸಿಕೊಂಡೇ ಇಲ್ಲ,’ ಎಂದು ಹೇಳಬಹುದು,” ಎಂದನು.<verse eid="EXO 4:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="EXO 4:2"/>ಯೆಹೋವ ದೇವರು ಅವನಿಗೆ, “ನಿನ್ನ ಕೈಯಲ್ಲಿರುವುದೇನು?” ಎಂದು ಕೇಳಿದರು.</para>
  <para style="p" vid="EXO 4:2">ಅವನು, “ಕೋಲು,” ಎಂದನು.<verse eid="EXO 4:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="EXO 4:3"/>ಯೆಹೋವ ದೇವರು ಅವನಿಗೆ, “ಅದನ್ನು ನೆಲದ ಮೇಲೆ ಬಿಸಾಡು,” ಎಂದರು.</para>
  <para style="p" vid="EXO 4:3">ಅವನು ಅದನ್ನು ನೆಲದ ಮೇಲೆ ಬಿಸಾಡಿದನು. ಆಗ ಅದು ಸರ್ಪವಾಯಿತು. ಮೋಶೆ ಅಲ್ಲಿಂದ ಓಡಿಹೋದನು. <verse eid="EXO 4:3"/><verse number="4" style="v" sid="EXO 4:4"/>ಯೆಹೋವ ದೇವರು ಮೋಶೆಗೆ, “ನಿನ್ನ ಕೈಚಾಚಿ, ಅದರ ಬಾಲವನ್ನು ಹಿಡಿ,” ಎಂದಾಗ, ಅವನು ಕೈಚಾಚಿ ಅದನ್ನು ಹಿಡಿದ ಕೂಡಲೇ, ಅದು ಅವನ ಕೈಯಲ್ಲಿ ಕೋಲಾಯಿತು. <verse eid="EXO 4:4"/><verse number="5" style="v" sid="EXO 4:5"/>ಆಗ ಯೆಹೋವ ದೇವರು ಅವನಿಗೆ, “ಇದರಿಂದ ಆ ಜನರು ತಮ್ಮ ಪೂರ್ವಜರಾದ ಅಬ್ರಹಾಮ, ಇಸಾಕ ಹಾಗೂ ಯಾಕೋಬರ ದೇವರಾಗಿರುವ ಯೆಹೋವ ದೇವರು ನಿನಗೆ ಪ್ರಕಟವಾಗಿದ್ದು ನಿಜ ಎಂಬುದನ್ನು ನಂಬುವರು,” ಎಂದರು.<verse eid="EXO 4:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="EXO 4:6"/>ಇದಲ್ಲದೆ ಯೆಹೋವ ದೇವರು ಅವನ ಸಂಗಡ ಇನ್ನೂ ಮಾತನಾಡಿ, “ನಿನ್ನ ಕೈಯನ್ನು ನಿನ್ನ ಉಡಿಯಲ್ಲಿ ಇಟ್ಟುಕೋ,” ಎಂದಾಗ, ಅವನು ತನ್ನ ಕೈಯನ್ನು ಉಡಿಯಲ್ಲಿ ಹಾಕಿ ಹೊರಗೆ ತೆಗೆದನು. ಇಗೋ, ಅವನ ಕೈ ಕುಷ್ಠದಿಂದ<note caller="+" style="f"><char style="fr" closed="false">4:6 </char><char style="ft" closed="false">ಹೀಬ್ರೂ ಭಾಷೆಯಲ್ಲಿ </char><char style="fq" closed="false">ಕುಷ್ಠ </char><char style="ft" closed="false">ಎಂಬ ಪದವನ್ನು ಚರ್ಮದ ಮೇಲೆ ಪರಿಣಾಮ ಬೀರುವ ವಿವಿಧ ಕಾಯಿಲೆಗಳಿಗೆ ಬಳಸಲಾಗುತ್ತದೆ.</char></note> ಹಿಮದಂತೆ ಆಗಿತ್ತು.<verse eid="EXO 4:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="EXO 4:7"/>ದೇವರು ಅವನಿಗೆ, “ನಿನ್ನ ಕೈಯನ್ನು ಉಡಿಯಲ್ಲಿ ಹಾಕು,” ಎಂದಾಗ, ಅವನು ತನ್ನ ಕೈಯನ್ನು ಉಡಿಯಲ್ಲಿ ಹಾಕಿ, ಉಡಿಯಿಂದ ಹೊರಗೆ ತೆಗೆದಾಗ, ಅದು ಅವನ ಉಳಿದ ಮೈಯಂತೆ ಆಗಿತ್ತು.<verse eid="EXO 4:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="EXO 4:8"/>ಆಗ ಯೆಹೋವ ದೇವರು, “ಜನರು ನಿನ್ನನ್ನು ನಂಬದೆ ಮೊದಲನೆಯ ಸೂಚಕಕಾರ್ಯವನ್ನು ಗಮನಿಸದೆ ಹೋದರೂ, ಎರಡನೆಯ ಸೂಚಕಕಾರ್ಯವನ್ನು ನೋಡಿ ನಂಬುವರು. <verse eid="EXO 4:8"/><verse number="9" style="v" sid="EXO 4:9"/>ಆ ಎರಡೂ ಸೂಚಕಕಾರ್ಯಗಳನ್ನು ಅವರು ನಂಬದೆ, ನಿನ್ನ ಮಾತನ್ನು ಕೇಳದೆ ಹೋದರೆ, ನೀನು ನೈಲ್ ನದಿಯ ನೀರನ್ನು ತೆಗೆದು, ಒಣಗಿದ ನೆಲದ ಮೇಲೆ ಸುರಿಯಬೇಕು. ಆಗ ನೀನು ತೆಗೆದ ನದಿಯ ನೀರು ಒಣಗಿದ ನೆಲದ ಮೇಲೆ ರಕ್ತವಾಗುವುದು,” ಎಂದರು.<verse eid="EXO 4:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="EXO 4:10"/>ಮೋಶೆಯು ಯೆಹೋವ ದೇವರಿಗೆ, “ಸ್ವಾಮಿ, ನನ್ನನ್ನು ಕ್ಷಮಿಸಿರಿ, ನಾನು ಮೊದಲಿನಿಂದಲೂ ನೀವು ನಿಮ್ಮ ದಾಸನ ಸಂಗಡ ಮಾತನಾಡಿದಂದಿನಿಂದಲೂ ವಾಕ್ಚಾತುರ್ಯವಿಲ್ಲದವನು. ನನ್ನ ಮಾತೂ ನಾಲಿಗೆಯೂ ಮಂದವಾಗಿವೆ,” ಎಂದನು.<verse eid="EXO 4:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="EXO 4:11"/>ಅದಕ್ಕೆ ಯೆಹೋವ ದೇವರು ಅವನಿಗೆ, “ಮನುಷ್ಯರಿಗೆ ಬಾಯಿ ಕೊಟ್ಟಾತನೂ ಯಾರು? ಮೂಕರನ್ನೂ ಕಿವುಡರನ್ನೂ ಮಾಡಿದಾತನೂ ಯಾರು? ದೃಷ್ಟಿಯುಳ್ಳವರನ್ನೂ ದೃಷ್ಟಿಯಿಲ್ಲದವರನ್ನೂ ಮಾಡಿದಾತನೂ ಯಾರು? ಯೆಹೋವ ದೇವರಾದ ನಾನೇ ಅಲ್ಲವೋ? <verse eid="EXO 4:11"/><verse number="12" style="v" sid="EXO 4:12"/>ಹಾಗಾದರೆ ಈಗ ಹೋಗು, ನಾನೇ ನಿನ್ನ ಸಂಗಡವಿದ್ದು, ನೀನು ಮಾತನಾಡತಕ್ಕದ್ದನ್ನು ನಿನಗೆ ಬೋಧಿಸುವೆನು,” ಎಂದರು.<verse eid="EXO 4:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="EXO 4:13"/>ಅದಕ್ಕೆ ಮೋಶೆಯು, “ಸ್ವಾಮಿ, ನೀವು ಬೇರೊಬ್ಬನನ್ನು ಕಳುಹಿಸಿರಿ, ಎಂದು ಬೇಡುತ್ತೇನೆ,” ಎಂದನು.<verse eid="EXO 4:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="EXO 4:14"/>ಯೆಹೋವ ದೇವರು ಮೋಶೆಯ ಮೇಲೆ ಬೇಸರಗೊಂಡು, “ಲೇವಿಯನಾದ ಆರೋನನು ನಿನ್ನ ಸಹೋದರನಲ್ಲವೇ? ಅವನು ಚೆನ್ನಾಗಿ ಮಾತನಾಡಬಲ್ಲನೆಂದು ನನಗೆ ಗೊತ್ತಿದೆ. ಅವನು ನಿನ್ನನ್ನು ಎದುರುಗೊಳ್ಳುವುದಕ್ಕೆ ಬರುತ್ತಾನೆ. ಅವನು ನಿನ್ನನ್ನು ಕಂಡು, ತನ್ನ ಹೃದಯದಲ್ಲಿ ಆನಂದಿಸುವನು. <verse eid="EXO 4:14"/><verse number="15" style="v" sid="EXO 4:15"/>ಅವನ ಸಂಗಡ ನೀನು ಮಾತನಾಡಿ, ಹೇಳಬೇಕಾದ ಮಾತುಗಳನ್ನು ಅವನಿಗೆ ತಿಳಿಸಬೇಕು. ನಿನ್ನ ಬಾಯಿಂದಲೂ ಅವನ ಬಾಯಿಂದಲೂ ನಾನೇ ಮಾತನಾಡಿ ನೀವು ಮಾಡಬೇಕಾದುದನ್ನು ಕಲಿಸುವೆನು. <verse eid="EXO 4:15"/><verse number="16" style="v" sid="EXO 4:16"/>ಅವನು ನಿನ್ನ ಪರವಾಗಿ ಜನರ ಸಂಗಡ ಮಾತನಾಡುವನು. ಅವನು ನಿನಗೆ ಬಾಯಿಯಾಗಿರುವನು, ನೀನು ಅವನಿಗೆ ದೇವರಂತಿರುವಿ. <verse eid="EXO 4:16"/><verse number="17" style="v" sid="EXO 4:17"/>ಆದರೆ ಈ ಕೋಲನ್ನು ನಿನ್ನ ಕೈಯಲ್ಲಿ ತೆಗೆದುಕೊಳ್ಳಬೇಕು. ಇದರಿಂದಲೇ ನೀನು ಸೂಚಕಕಾರ್ಯಗಳನ್ನು ಮಾಡುವೆ,” ಎಂದರು.<verse eid="EXO 4:17"/></para>
  <para style="s1">ಮೋಶೆ ಈಜಿಪ್ಟ್ ದೇಶಕ್ಕೆ ಇಸ್ರಾಯೇಲರ ಬಳಿಗೆ ಬಂದದ್ದು</para>
  <para style="p">
    <verse number="18" style="v" sid="EXO 4:18"/>ಇದಾದ ಮೇಲೆ ಮೋಶೆಯು ತನ್ನ ಮಾವನಾದ ಇತ್ರೋವನ ಬಳಿಗೆ ಬಂದು ಅವನಿಗೆ, “ಈಜಿಪ್ಟಿನಲ್ಲಿರುವ ನನ್ನ ಸಹೋದರರ ಬಳಿಗೆ ಹಿಂದಿರುಗಿ ಹೋಗಿ, ಅವರು ಇನ್ನೂ ಜೀವದಿಂದ ಇದ್ದಾರೋ ಎಂಬುದನ್ನು ನೋಡುವೆನು,” ಎಂದನು.</para>
  <para style="p" vid="EXO 4:18">ಇತ್ರೋವನು ಮೋಶೆಗೆ, “ಸಮಾಧಾನದಿಂದ ಹೋಗು,” ಎಂದನು.<verse eid="EXO 4:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="EXO 4:19"/>ಯೆಹೋವ ದೇವರು ಮಿದ್ಯಾನಿನಲ್ಲಿ ಮೋಶೆಗೆ, “ಈಜಿಪ್ಟಿಗೆ ಹಿಂದಿರುಗಿ ಹೋಗು. ಏಕೆಂದರೆ ನಿನ್ನನ್ನು ಕೊಲ್ಲಬೇಕೆಂದಿದ್ದ ಜನರೆಲ್ಲಾ ಸತ್ತಿದ್ದಾರೆ,” ಎಂದರು. <verse eid="EXO 4:19"/><verse number="20" style="v" sid="EXO 4:20"/>ಆಗ ಮೋಶೆಯು ತನ್ನ ಹೆಂಡತಿಯನ್ನೂ ಮಕ್ಕಳನ್ನೂ ಕರೆದುಕೊಂಡು ಅವರನ್ನು ಕತ್ತೆಯ ಮೇಲೆ ಕುಳ್ಳಿರಿಸಿ, ಈಜಿಪ್ಟ್ ದೇಶಕ್ಕೆ ಹಿಂದಿರುಗಿ ಬಂದನು. ಇದಲ್ಲದೆ ದೇವರ ಕೋಲನ್ನು ಕೈಯಲ್ಲಿ ತೆಗೆದುಕೊಂಡನು.<verse eid="EXO 4:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="EXO 4:21"/>ಆಗ ಯೆಹೋವ ದೇವರು ಮೋಶೆಗೆ, “ನೀನು ಈಜಿಪ್ಟ್ ದೇಶಕ್ಕೆ ಹಿಂದಿರುಗಿ ಹೋಗುವಾಗ, ನಾನು ನಿನ್ನ ಕೈಯಲ್ಲಿ ಮಾಡಿಸಿದ ಎಲ್ಲಾ ಸೂಚಕಕಾರ್ಯಗಳನ್ನು ಫರೋಹನ ಮುಂದೆ ಮಾಡು. ಆದರೆ ನಾನು ಅವನ ಹೃದಯವನ್ನು ಕಠಿಣಪಡಿಸುವೆನು. ಅವನು ಜನರನ್ನು ಹೋಗಗೊಡಿಸುವುದಿಲ್ಲ. <verse eid="EXO 4:21"/><verse number="22" style="v" sid="EXO 4:22"/>ಆಗ ನೀನು ಫರೋಹನಿಗೆ, ‘ಯೆಹೋವ ದೇವರು ಹೀಗೆ ಹೇಳುತ್ತಾರೆ: ಇಸ್ರಾಯೇಲ ನನ್ನ ಮಗನು, ನನ್ನ ಜೇಷ್ಠಪುತ್ರನು. <verse eid="EXO 4:22"/><verse number="23" style="v" sid="EXO 4:23"/>ಫರೋಹನೇ, ನಾನು ನಿನಗೆ ಹೇಳುವುದೇನೆಂದರೆ: “ನನ್ನ ಸೇವೆಮಾಡುವಂತೆ ನನ್ನ ಮಗನನ್ನು ಕಳುಹಿಸು.” ನೀನು ಅವನನ್ನು ಕಳುಹಿಸುವುದನ್ನು ನಿರಾಕರಿಸಿದರೆ, ನಾನು ನಿನ್ನ ಮಗನನ್ನು ಅಂದರೆ, ನಿನ್ನ ಜೇಷ್ಠಪುತ್ರನನ್ನು ಕೊಲ್ಲುವೆನು,’ ಎಂದು ತಿಳಿಸಬೇಕು,” ಎಂದರು.<verse eid="EXO 4:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="EXO 4:24"/>ಇದಲ್ಲದೆ ಮೋಶೆಯು ಹೋಗುವ ದಾರಿಯಲ್ಲಿ ವಸತಿಗೃಹದಲ್ಲಿದ್ದಾಗ, ಯೆಹೋವ ದೇವರು ಮೋಶೆಯ ಎದುರಿಗೆ ಬಂದು ಅವನನ್ನು ಕೊಲ್ಲುವುದಕ್ಕಿದ್ದಾಗ, <verse eid="EXO 4:24"/><verse number="25" style="v" sid="EXO 4:25"/>ಚಿಪ್ಪೋರಳು ಕಲ್ಲಿನ ಚೂರಿ ತೆಗೆದುಕೊಂಡು ತನ್ನ ಮಗನಿಗೆ ಸುನ್ನತಿ ಮಾಡಿ, ಅದನ್ನು ಮೋಶೆಯ ಪಾದಗಳಿಗೆ ಮುಟ್ಟಿಸಿ ಅವನಿಗೆ, “ಖಂಡಿತವಾಗಿ ನೀನು ನನಗೆ ರಕ್ತಧಾರೆಯಿಂದಾದ ಗಂಡನು,” ಎಂದಳು. <verse eid="EXO 4:25"/><verse number="26" style="v" sid="EXO 4:26"/>ಆಗ ಯೆಹೋವ ದೇವರು ಅವನನ್ನು ಉಳಿಸಿದರು. ಆಗ ಅವಳು, “ಸುನ್ನತಿಯ ನಿಮಿತ್ತ ನೀನು ನನಗೆ ರಕ್ತಧಾರೆಯಿಂದ ಗಂಡನಾಗಿದ್ದೀ,” ಎಂದಳು.<verse eid="EXO 4:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="EXO 4:27"/>ಇದಲ್ಲದೆ ಯೆಹೋವ ದೇವರು ಆರೋನನಿಗೆ, “ಮೋಶೆಯನ್ನು ಎದುರುಗೊಳ್ಳುವದಕ್ಕೆ ಮರುಭೂಮಿಗೆ ಹೋಗು,” ಎಂದರು. ಆಗ ಅವನು ಹೋಗಿ ದೇವರ ಬೆಟ್ಟದಲ್ಲಿ ಮೋಶೆಯನ್ನು ಎದುರುಗೊಂಡು ಮುದ್ದಿಟ್ಟನು. <verse eid="EXO 4:27"/><verse number="28" style="v" sid="EXO 4:28"/>ಆಗ ಮೋಶೆಯು ಆರೋನನಿಗೆ ತನ್ನನ್ನು ಕಳುಹಿಸಿದ ಯೆಹೋವ ದೇವರ ಎಲ್ಲಾ ಮಾತುಗಳನ್ನೂ ತನಗೆ ಆಜ್ಞಾಪಿಸಿದ ಎಲ್ಲಾ ಸೂಚಕಕಾರ್ಯಗಳನ್ನೂ ತಿಳಿಸಿದನು.<verse eid="EXO 4:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="EXO 4:29"/>ತರುವಾಯ ಮೋಶೆಯೂ ಆರೋನನೂ ಹೋಗಿ ಇಸ್ರಾಯೇಲಿನ ಹಿರಿಯರನ್ನೆಲ್ಲಾ ಒಟ್ಟುಗೂಡಿಸಿದರು. <verse eid="EXO 4:29"/><verse number="30" style="v" sid="EXO 4:30"/>ಯೆಹೋವ ದೇವರು ಮೋಶೆಗೆ ಹೇಳಿದ ಮಾತುಗಳನ್ನೆಲ್ಲಾ ಆರೋನನು ಅವರಿಗೆ ಹೇಳಿ, ಜನರ ಮುಂದೆ ಸೂಚಕಕಾರ್ಯಗಳನ್ನು ಮಾಡಿದನು. <verse eid="EXO 4:30"/><verse number="31" style="v" sid="EXO 4:31"/>ಜನರು ನಂಬಿದರು. ಯೆಹೋವ ದೇವರು ಇಸ್ರಾಯೇಲರನ್ನು ದರ್ಶಿಸಿ, ಅವರ ವ್ಯಥೆಯನ್ನು ನೋಡಿದ್ದಾರೆ ಎಂದು ಅವರು ಕೇಳಿದಾಗ, ತಲೆಬಾಗಿಸಿ ಆರಾಧಿಸಿದರು.<verse eid="EXO 4:31"/></para>
  <chapter eid="EXO 4"/>
  <chapter number="5" style="c" sid="EXO 5"/>
  <para style="s1">ಒಣಹುಲ್ಲಿಲ್ಲದೇ ಇಟ್ಟಿಗೆಗಳು</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 5:1"/>ತರುವಾಯ ಮೋಶೆಯೂ ಆರೋನನೂ ಹೋಗಿ ಫರೋಹನಿಗೆ, “ಇಸ್ರಾಯೇಲಿನ ಯೆಹೋವ ದೇವರು, ‘ಮರುಭೂಮಿಯಲ್ಲಿ ನನಗೆ ನನ್ನ ಜನರು ಹಬ್ಬವನ್ನಾಚರಿಸುವುದಕ್ಕೆ ಅವರನ್ನು ಹೋಗಗೊಡಿಸು,’ ಎಂದು ಹೇಳುತ್ತಾರೆ,” ಎಂದರು.<verse eid="EXO 5:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="EXO 5:2"/>ಆಗ ಫರೋಹನು, “ನಾನು ಆತನ ಮಾತಿಗೆ ವಿಧೇಯನಾಗಿ ಇಸ್ರಾಯೇಲರನ್ನು ಕಳುಹಿಸಿಬಿಡುವಂತೆ ಆ ಯೆಹೋವ ಯಾರು? ಆ ಯೆಹೋವ ದೇವರನ್ನು ನಾನರಿಯೆನು. ಇಸ್ರಾಯೇಲರನ್ನೂ ಕಳುಹಿಸುವುದಿಲ್ಲ,” ಎಂದನು.<verse eid="EXO 5:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="EXO 5:3"/>ಆಗ ಅವರು ಫರೋಹನಿಗೆ, “ಹಿಬ್ರಿಯರ ದೇವರು ನಮ್ಮನ್ನು ಸಂದರ್ಶಿಸಿದ್ದಾರೆ. ಆದ್ದರಿಂದ ನಾವು ಮರುಭೂಮಿಯಲ್ಲಿ ಮೂರು ದಿವಸ ಪ್ರಯಾಣಮಾಡಿ, ನಮ್ಮ ಯೆಹೋವ ದೇವರಿಗೆ ಯಜ್ಞ ಅರ್ಪಿಸುವುದಕ್ಕೆ ನಾವು ಹೋಗಬೇಕು. ಇಲ್ಲವಾದರೆ ಅವರು ಉಪದ್ರವದಿಂದಲೋ ಖಡ್ಗದಿಂದಲೋ ನಮ್ಮನ್ನು ದಂಡಿಸುವರು,” ಎಂದರು.<verse eid="EXO 5:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="EXO 5:4"/>ಈಜಿಪ್ಟಿನ ಅರಸನು ಅವರಿಗೆ, “ಮೋಶೆಯೇ, ಆರೋನನೇ, ಜನರು ತಮ್ಮ ಕೆಲಸಗಳನ್ನು ಮಾಡದಂತೆ ಏಕೆ ಮಾಡುತ್ತೀರಿ? ನಿಮ್ಮ ಬಿಟ್ಟೀ ಕೆಲಸಗಳಿಗೆ ಹೋಗಿ,” ಎಂದನು. <verse eid="EXO 5:4"/><verse number="5" style="v" sid="EXO 5:5"/>ಇದಲ್ಲದೆ ಫರೋಹನು, “ಈಗ ಹಿಬ್ರಿಯರು ಈ ದೇಶದಲ್ಲಿ ಹೆಚ್ಚಿದ್ದಾರೆ. ನೀವು ಅವರನ್ನು ಅವರ ಬಿಟ್ಟಿಕೆಲಸಗಳಿಂದ ನಿಲ್ಲಿಸಿಬಿಡುತ್ತೀರಲ್ಲಾ?” ಎಂದನು.<verse eid="EXO 5:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="EXO 5:6"/>ಅದೇ ದಿನದಲ್ಲಿ ಫರೋಹನು ಬಿಟ್ಟಿಕೆಲಸ ಮಾಡಿಸುವವರಿಗೂ ಅವರ ಮೇಲ್ವಿಚಾರಕರಿಗೂ, <verse eid="EXO 5:6"/><verse number="7" style="v" sid="EXO 5:7"/>“ನೀವು ಇನ್ನು ಇಟ್ಟಿಗೆಗಳನ್ನು ಮಾಡುವುದಕ್ಕೆ ಮೊದಲಿನ ಹಾಗೆ ಜನರಿಗೆ ಒಣಹುಲ್ಲನ್ನು ಕೊಡಬೇಡಿರಿ. ಅವರೇ ಹೋಗಿ ಹುಲ್ಲನ್ನು ಕೂಡಿಸಿಕೊಳ್ಳಲಿ. <verse eid="EXO 5:7"/><verse number="8" style="v" sid="EXO 5:8"/>ಅವರು ಈವರೆಗೆ ಮಾಡಿದ ಇಟ್ಟಿಗೆಗಳ ಲೆಕ್ಕದಲ್ಲಿ ಏನೂ ಕಡಿಮೆ ಮಾಡಬಾರದೆಂದು ಅವರಿಗೆ ಹೇಳಬೇಕು. ಅವರು ಮೈಗಳ್ಳರೇ, ಆದ್ದರಿಂದ ಅವರು, ‘ನಾವು ಹೋಗಿ ನಮ್ಮ ದೇವರಿಗೆ ಯಜ್ಞವನ್ನು ಅರ್ಪಿಸೋಣ,’ ಎಂದು ಕೂಗುತ್ತಾರೆ. <verse eid="EXO 5:8"/><verse number="9" style="v" sid="EXO 5:9"/>ಈ ಜನರು ಸುಳ್ಳು ಮಾತುಗಳಿಗೆ ಲಕ್ಷ್ಯಕೊಡದಂತೆ ಅವರ ಮೇಲೆ ಹೆಚ್ಚು ಕೆಲಸಗಳನ್ನು ಹೊರಿಸಿರಿ. ಅವರು ದುಡಿಯಲಿ,” ಎಂದು ಆಜ್ಞಾಪಿಸಿದನು.<verse eid="EXO 5:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="EXO 5:10"/>ಆಗ ಬಿಟ್ಟಿಕೆಲಸವನ್ನು ಮಾಡಿಸುವವರೂ ಮೇಲ್ವಿಚಾರಕರೂ ಹೊರಗೆ ಹೋಗಿ ಜನರಿಗೆ, “ಫರೋಹನು ಹೀಗೆ ಹೇಳುತ್ತಾನೆ: ‘ನಾನು ನಿಮಗೆ ಒಣಹುಲ್ಲು ಕೊಡುವುದಿಲ್ಲ. <verse eid="EXO 5:10"/><verse number="11" style="v" sid="EXO 5:11"/>ನಿಮಗೆ ಹುಲ್ಲು ಎಲ್ಲಿ ದೊರಕುವುದೋ, ಅಲ್ಲಿಗೆ ನೀವೇ ಹೋಗಿ ತೆಗೆದುಕೊಳ್ಳಿರಿ. ಆದರೆ ನಿಮ್ಮ ಕೆಲಸವು ಏನೂ ಕಡಿಮೆಯಾಗಬಾರದು,’ ಎಂದು ಹೇಳಿದ್ದಾನೆ,” ಎಂದರು. <verse eid="EXO 5:11"/><verse number="12" style="v" sid="EXO 5:12"/>ಆಗ ಜನರು ಒಣಹುಲ್ಲಿಗಾಗಿ ಕಳೆಕೀಳಿಸುವುದಕ್ಕೆ ಈಜಿಪ್ಟ್ ದೇಶದಲ್ಲೆಲ್ಲಾ ಚದರಿಹೋದರು. <verse eid="EXO 5:12"/><verse number="13" style="v" sid="EXO 5:13"/>ಇದಲ್ಲದೆ ಬಿಟ್ಟಿಕೆಲಸ ಮಾಡಿಸುವವರು, “ಹುಲ್ಲು ಇದ್ದಾಗ ನಿಮ್ಮ ಕೆಲಸಗಳನ್ನು ಮಾಡಿದಂತೆಯೇ, ಪ್ರತಿಯೊಂದು ದಿನದಲ್ಲಿ, ಆ ದಿನದ ಕೆಲಸವನ್ನು ತೀರಿಸಿಬಿಡಬೇಕು,” ಎಂದು ಹೇಳಿ ಅವರನ್ನು ತ್ವರೆಪಡಿಸಿದರು. <verse eid="EXO 5:13"/><verse number="14" style="v" sid="EXO 5:14"/>ಫರೋಹನ ಅಧಿಕಾರಿಗಳು ತಾವೇ ನೇಮಿಸಿದ ಇಸ್ರಾಯೇಲರ ಮೇಲ್ವಿಚಾರಕರಿಗೆ, “ನೀವು ಮೊದಲು ಇಟ್ಟಿಗೆಗಳ ಲೆಕ್ಕವನ್ನು ಒಪ್ಪಿಸಿದಂತೆ ನಿನ್ನೆ ಈ ಹೊತ್ತು ಏಕೆ ಒಪ್ಪಿಸಲಿಲ್ಲ,” ಎಂದು ಹೇಳಿ ಅವರನ್ನು ಹೊಡೆಸಿದರು.<verse eid="EXO 5:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="EXO 5:15"/>ಇಸ್ರಾಯೇಲರ ಮೇಲ್ವಿಚಾರಕರು ಫರೋಹನ ಬಳಿಗೆ ಹೋಗಿ, “ಏಕೆ ನಿಮ್ಮ ದಾಸರಿಗೆ ಹೀಗೆ ಮಾಡುತ್ತೀರಿ? <verse eid="EXO 5:15"/><verse number="16" style="v" sid="EXO 5:16"/>ನಿಮ್ಮ ದಾಸರಿಗೆ ನೇಮಿಸಿದ ಅಧಿಕಾರಿಗಳು ಹುಲ್ಲನ್ನು ಕೊಡದೆ, ‘ಇಟ್ಟಿಗೆಗಳನ್ನು ಮಾಡಿರಿ’ ಎಂದು ನಮಗೆ ಹೇಳುತ್ತಾ ನಮ್ಮನ್ನು ಹೊಡೆಯುತ್ತಿದ್ದಾರೆ. ಆದರೆ ತಪ್ಪು ನಿಮ್ಮ ಸ್ವಂತ ಜನರಲ್ಲಿಯೇ ಇದೆ,” ಎಂದರು.<verse eid="EXO 5:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="EXO 5:17"/>ಅದಕ್ಕೆ ಅವನು, “ನೀವು ಮೈಗಳ್ಳರು, ನೀವು ಮೈಗಳ್ಳರಾದ ಕಾರಣ, ನೀವು, ‘ನಾವು ಹೋಗಿ ಯೆಹೋವ ದೇವರಿಗೆ ಯಜ್ಞವನ್ನರ್ಪಿಸುತ್ತೇವೆ,’ ಎಂದು ಹೇಳುತ್ತೀರಿ. <verse eid="EXO 5:17"/><verse number="18" style="v" sid="EXO 5:18"/>ಆದ್ದರಿಂದ ಈಗ ಹೋಗಿ ಕೆಲಸಮಾಡಿರಿ. ಹುಲ್ಲನ್ನು ನಿಮಗೆ ಕೊಡುವುದಕ್ಕಾಗುವುದಿಲ್ಲ. ಆದರೂ ನೇಮಿಸಿದ್ದ ಇಟ್ಟಿಗೆಗಳನ್ನು ನೀವು ತಯಾರಿಸಬೇಕು,” ಎಂದನು.<verse eid="EXO 5:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="EXO 5:19"/>ದಿನದಿನವೂ ಒಪ್ಪಿಸಬೇಕಾದ ಇಟ್ಟಿಗೆಗಳ ಲೆಕ್ಕ ಕಡಿಮೆಯಾಗಬಾರದೆಂದು ಅಪ್ಪಣೆಯಾದ್ದರಿಂದ, ಇಸ್ರಾಯೇಲರ ಮೇಲ್ವಿಚಾರಕರು ತಾವು ದುರವಸ್ಥೆಯಲ್ಲಿ ಇದ್ದೇವೆಂದು ತಿಳಿದುಕೊಂಡರು. <verse eid="EXO 5:19"/><verse number="20" style="v" sid="EXO 5:20"/>ಅವರು ಫರೋಹನ ಬಳಿಯಿಂದ ಹೊರಗೆ ಬಂದಾಗ, ದಾರಿಯಲ್ಲಿ ಕಾದಿದ್ದ ಮೋಶೆಯನ್ನೂ, ಆರೋನನನ್ನೂ ಸಂಧಿಸಿದರು. <verse eid="EXO 5:20"/><verse number="21" style="v" sid="EXO 5:21"/>ಅವರು ಮೋಶೆ ಆರೋನರಿಗೆ, “ಯೆಹೋವ ದೇವರು ನಿಮ್ಮನ್ನು ನೋಡಿ ನ್ಯಾಯತೀರಿಸಲಿ! ಏಕೆಂದರೆ ನೀವೇ ಫರೋಹನ ಮುಂದೆಯೂ ಅವನ ದಾಸರ ಮುಂದೆಯೂ ನಮ್ಮನ್ನು ಅವರು ಹೇಸಿಕೊಳ್ಳುವಂತೆ ಮಾಡಿದಿರಿ. ನಮ್ಮನ್ನು ಸಂಹರಿಸುವುದಕ್ಕೆ ನೀವು ಅವರ ಕೈಗೆ ಖಡ್ಗವನ್ನು ಕೊಟ್ಟಿದ್ದೀರಿ,” ಎಂದರು.<verse eid="EXO 5:21"/></para>
  <para style="s1">ದೇವರು ವಿಮೋಚನೆಯನ್ನು ವಾಗ್ದಾನ ಮಾಡಿದ್ದು</para>
  <para style="p">
    <verse number="22" style="v" sid="EXO 5:22"/>ಆಗ ಮೋಶೆಯು ಯೆಹೋವ ದೇವರ ಬಳಿಗೆ ಬಂದು, “ಸ್ವಾಮಿ, ಈ ಜನರಿಗೆ ಏಕೆ ಕಷ್ಟವನ್ನು ಕೊಟ್ಟಿದ್ದೀರಿ? ಏಕೆ ನನ್ನನ್ನು ಕಳುಹಿಸಿದಿರಿ? <verse eid="EXO 5:22"/><verse number="23" style="v" sid="EXO 5:23"/>ನಾನು ಫರೋಹನ ಬಳಿಗೆ ಬಂದು ನಿಮ್ಮ ಹೆಸರಿನಲ್ಲಿ ಮಾತನಾಡಿದಂದಿನಿಂದ, ಈ ಜನರಿಗೆ ಅವನು ಕೇಡನ್ನೇ ಮಾಡುತ್ತಿದ್ದಾನೆ. ನೀವು ನಿಮ್ಮ ಜನರನ್ನು ರಕ್ಷಿಸಲಿಲ್ಲವಲ್ಲಾ,” ಎಂದನು.<verse eid="EXO 5:23"/></para>
  <chapter eid="EXO 5"/>
  <chapter number="6" style="c" sid="EXO 6"/>
  <para style="p">
    <verse number="1" style="v" sid="EXO 6:1"/>ಆಗ ಯೆಹೋವ ದೇವರು ಮೋಶೆಗೆ, “ನಾನು ಫರೋಹನಿಗೆ ಮಾಡುವುದನ್ನು ಈಗ ನೀನು ನೋಡುವೆ. ನನ್ನ ಬಲವಾದ ಹಸ್ತವನ್ನು ಕಂಡು ಅವನು ಅವರನ್ನು ಹೋಗಗೊಡಿಸುವನು. ನನ್ನ ಬಲವಾದ ಹಸ್ತದ ಕಾರಣದಿಂದ ಅವನು ಅವರನ್ನು ತನ್ನ ದೇಶದೊಳಗಿಂದ ಹೊರಡಿಸುವನು,” ಎಂದರು.<verse eid="EXO 6:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="EXO 6:2"/>ಇದಲ್ಲದೆ ದೇವರು ಮೋಶೆಯ ಸಂಗಡ ಮಾತನಾಡಿ, “ನಾನೇ ಯೆಹೋವ ದೇವರು. <verse eid="EXO 6:2"/><verse number="3" style="v" sid="EXO 6:3"/>ನಾನೇ ಅಬ್ರಹಾಮನಿಗೂ ಇಸಾಕನಿಗೂ ಯಾಕೋಬನಿಗೂ ಸರ್ವಶಕ್ತ ದೇವರೆಂದು ಪ್ರಕಟಿಸಿಗೊಂಡೆನು. ಆದರೆ ಯೆಹೋವ ದೇವರೆಂಬ ನನ್ನ ಹೆಸರಿನಿಂದ ನಾನು ಅವರಿಗೆ ಪೂರ್ಣವಾಗಿ ತಿಳಿಸಲಿಲ್ಲ. <verse eid="EXO 6:3"/><verse number="4" style="v" sid="EXO 6:4"/>ಕಾನಾನ್ ದೇಶವನ್ನು ಅಂದರೆ, ಅವರು ವಾಸವಾಗಿದ್ದ ಅವರ ಪ್ರವಾಸದ ದೇಶವನ್ನು ನಾನು ಅವರಿಗೆ ಕೊಡುವೆನೆಂದು ಅವರ ಸಂಗಡ ನನ್ನ ಒಡಂಬಡಿಕೆಯನ್ನು ದೃಢಪಡಿಸಿದೆನು. <verse eid="EXO 6:4"/><verse number="5" style="v" sid="EXO 6:5"/>ಈಜಿಪ್ಟಿನವರು ದಾಸರನ್ನಾಗಿ ಇಟ್ಟುಕೊಂಡಿರುವ ಇಸ್ರಾಯೇಲರ ನರಳುವಿಕೆಯನ್ನು ಕೇಳಿ, ನನ್ನ ಒಡಂಬಡಿಕೆಯನ್ನು ನೆನಪಿಗೆ ತಂದುಕೊಂಡೆನು.<verse eid="EXO 6:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="EXO 6:6"/>“ಆದ್ದರಿಂದ ಇಸ್ರಾಯೇಲರಿಗೆ, ‘ನಾನೇ ಯೆಹೋವ ದೇವರು. ನಾನು ನಿಮ್ಮನ್ನು ಈಜಿಪ್ಟಿನ ಬಿಟ್ಟಿಕೆಲಸದಿಂದ ಅವರಿಗೆ ದಾಸತ್ವದಲ್ಲಿರುವುದರಿಂದ, ನಾನು ಚಾಚಿದ ಬಾಹುವಿನಿಂದಲೂ ಬಲವಾದ ನ್ಯಾಯತೀರ್ಪುಗಳಿಂದಲೂ ನಿಮ್ಮನ್ನು ಬಿಡಿಸುವೆನು. <verse eid="EXO 6:6"/><verse number="7" style="v" sid="EXO 6:7"/>ನಿಮ್ಮನ್ನು ನನ್ನ ಜನರನ್ನಾಗಿ ತೆಗೆದುಕೊಂಡು ನಿಮಗೆ ದೇವರಾಗಿರುವೆನು. ಈಜಿಪ್ಟಿನ ಬಿಟ್ಟಿಕೆಲಸಗಳೊಳಗಿಂದ ನಿಮ್ಮನ್ನು ಹೊರಗೆ ಬರಮಾಡಿದಾಗ, ಯೆಹೋವ ದೇವರಾಗಿರುವ ನಾನೇ ನಿಮ್ಮ ದೇವರಾಗಿದ್ದೇನೆಂದು ನಿಮಗೆ ತಿಳಿಯುವುದು. <verse eid="EXO 6:7"/><verse number="8" style="v" sid="EXO 6:8"/>ನಾನು ಅಬ್ರಹಾಮನಿಗೂ ಇಸಾಕನಿಗೂ ಯಾಕೋಬನಿಗೂ ಕೊಡುವೆನೆಂದು ಕೈಯನ್ನೆತ್ತಿ ಪ್ರಮಾಣ ಮಾಡಿದ ದೇಶದಲ್ಲಿ ನಿಮ್ಮನ್ನು ಬರಮಾಡಿ, ಅದನ್ನು ನಿಮಗೆ ಸೊತ್ತಾಗಿ ಕೊಡುವೆನೆಂದು ಹೇಳಿದ ಯೆಹೋವ ದೇವರು ನಾನೇ,’ ಎಂದು ಹೇಳು,” ಎಂದರು.<verse eid="EXO 6:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="EXO 6:9"/>ಮೋಶೆಯು ಇಸ್ರಾಯೇಲರಿಗೆ ಹಾಗೆ ಹೇಳಿದಾಗ, ಅವರು ಮನೋವೇದನೆಯ ದೆಸೆಯಿಂದಲೂ ಕ್ರೂರವಾದ ದಾಸತ್ವದ ದೆಸೆಯಿಂದಲೂ ಮೋಶೆಯ ಮಾತನ್ನು ಕೇಳಲಿಲ್ಲ.<verse eid="EXO 6:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="EXO 6:10"/>ಆಗ ಯೆಹೋವ ದೇವರು ಮೋಶೆಯ ಸಂಗಡ ಮಾತನಾಡಿ, <verse eid="EXO 6:10"/><verse number="11" style="v" sid="EXO 6:11"/>“ನೀನು ಈಜಿಪ್ಟಿನ ಅರಸನಾದ ಫರೋಹನ ಬಳಿಗೆ ಹೋಗಿ, ಅವನು ಇಸ್ರಾಯೇಲರನ್ನು ತನ್ನ ದೇಶದಿಂದ ಹೊರಗೆ ಕಳುಹಿಸುವಂತೆ ಅವನ ಸಂಗಡ ಮಾತನಾಡು,” ಎಂದರು.<verse eid="EXO 6:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="EXO 6:12"/>ಆದರೆ ಮೋಶೆಯು ಯೆಹೋವ ದೇವರ ಸನ್ನಿಧಿಯಲ್ಲಿ, “ಇಗೋ, ಇಸ್ರಾಯೇಲರೇ ನನ್ನ ಮಾತನ್ನು ಕೇಳದಿರುವಲ್ಲಿ, ತೊದಲು ಮಾತನಾಡುವ ನನ್ನ ಮಾತನ್ನು ಫರೋಹನು ಕೇಳುವುದು ಹೇಗೆ?” ಎಂದನು.<verse eid="EXO 6:12"/></para>
  <para style="s1">ಮೋಶೆ ಮತ್ತು ಆರೋನರ ವಂಶಾವಳಿ</para>
  <para style="p">
    <verse number="13" style="v" sid="EXO 6:13"/>ಯೆಹೋವ ದೇವರು ಮೋಶೆ ಮತ್ತು ಆರೋನರ ಸಂಗಡ ಮಾತನಾಡಿ, ಇಸ್ರಾಯೇಲರನ್ನು ಈಜಿಪ್ಟಿನ ದೇಶದೊಳಗಿಂದ ಹೊರಗೆ ಬರಮಾಡುವಂತೆ ಇಸ್ರಾಯೇಲರ ಬಳಿಗೂ ಅರಸನಾದ ಫರೋಹನ ಬಳಿಗೂ ಹೋಗಬೇಕೆಂದು ಅವರಿಗೆ ಆಜ್ಞಾಪಿಸಿದರು.<verse eid="EXO 6:13"/></para>
  <para style="b"/>
  <para style="li4">
    <verse number="14" style="v" sid="EXO 6:14"/>ಇಸ್ರಾಯೇಲ್ ಗೋತ್ರಗಳ ಮನೆಯ ಮುಖ್ಯಸ್ಥರು ಇವರೇ:</para>
  <para style="b" vid="EXO 6:14"/>
  <para style="li1" vid="EXO 6:14">ಇಸ್ರಾಯೇಲನ ಜೇಷ್ಠ ಪುತ್ರನಾದ ರೂಬೇನನ ಪುತ್ರರು:</para>
  <para style="li2" vid="EXO 6:14">ಹನೋಕ್, ಪಲ್ಲೂ, ಹೆಚ್ರೋನ್, ಕರ್ಮೀ.</para>
  <para style="li4" vid="EXO 6:14">ಇವರು ರೂಬೇನನ ಗೋತ್ರಗಳ ಮೂಲ ಪುರುಷರು.<verse eid="EXO 6:14"/></para>
  <para style="b"/>
  <para style="li1">
    <verse number="15" style="v" sid="EXO 6:15"/>ಸಿಮೆಯೋನನ ಪುತ್ರರು:</para>
  <para style="li2" vid="EXO 6:15">ಯೆಮೂಯೇಲ್, ಯಾಮೀನ್, ಓಹದ್, ಯಾಕೀನ್, ಚೋಹರ್ ಮತ್ತು ಕಾನಾನ್ಯಳ ಮಗನಾದ ಸೌಲ.</para>
  <para style="li4" vid="EXO 6:15">ಇವು ಸಿಮೆಯೋನನ ಗೋತ್ರಗಳು.<verse eid="EXO 6:15"/></para>
  <para style="b"/>
  <para style="li1">
    <verse number="16" style="v" sid="EXO 6:16"/>ತಮ್ಮ ತಮ್ಮ ವಂಶಾವಳಿಗಳ ಪ್ರಕಾರವಾಗಿರುವ ಲೇವಿಯ ಪುತ್ರರ ಹೆಸರುಗಳು:</para>
  <para style="li2" vid="EXO 6:16">ಗೇರ್ಷೋನ್, ಕೊಹಾತ್, ಮೆರಾರೀ.</para>
  <para style="li4" vid="EXO 6:16">ಲೇವಿಯು ನೂರಮೂವತ್ತೇಳು ವರ್ಷಗಳವರೆಗೆ ಬದುಕಿದ್ದನು.<verse eid="EXO 6:16"/></para>
  <para style="li2">
    <verse number="17" style="v" sid="EXO 6:17"/>ಗೇರ್ಷೋನನ ಪುತ್ರರು ಅವರ ಗೋತ್ರಗಳಿಗನುಸಾರವಾಗಿ:</para>
  <para style="li3" vid="EXO 6:17">ಲಿಬ್ನೀ ಮತ್ತು ಶಿಮ್ಮೀಯರು.<verse eid="EXO 6:17"/></para>
  <para style="li2">
    <verse number="18" style="v" sid="EXO 6:18"/>ಕೊಹಾತನ ಪುತ್ರರು:</para>
  <para style="li3" vid="EXO 6:18">ಅಮ್ರಾಮ್, ಇಚ್ಹಾರ್, ಹೆಬ್ರೋನ್, ಉಜ್ಜೀಯೇಲ್.</para>
  <para style="li2" vid="EXO 6:18">ಕೊಹಾತನು ಜೀವಿಸಿದ ವರ್ಷಗಳು ನೂರಮೂವತ್ತಮೂರು.<verse eid="EXO 6:18"/></para>
  <para style="li2">
    <verse number="19" style="v" sid="EXO 6:19"/>ಮೆರಾರೀಯ ಪುತ್ರರು:</para>
  <para style="li3" vid="EXO 6:19">ಮಹ್ಲೀ, ಮೂಷೀ.</para>
  <para style="li4" vid="EXO 6:19">ವಂಶಾವಳಿಗಳ ಪ್ರಕಾರ ಇವೇ ಲೇವಿಯ ಗೋತ್ರಗಳು.<verse eid="EXO 6:19"/></para>
  <para style="b"/>
  <para style="li1">
    <verse number="20" style="v" sid="EXO 6:20"/>ಅಮ್ರಾಮನು ತನ್ನ ಸೋದರತ್ತೆಯಾದ ಯೋಕೆಬೆದಳನ್ನು ಮದುವೆಯಾದನು. ಆಕೆಯು ಅವನಿಗೆ ಆರೋನನನ್ನೂ, ಮೋಶೆಯನ್ನೂ ಹೆತ್ತಳು.</para>
  <para style="li4" vid="EXO 6:20">ಅಮ್ರಾಮನು ಜೀವಿಸಿದ ಕಾಲ ನೂರಮೂವತ್ತೇಳು ವರ್ಷಗಳು.<verse eid="EXO 6:20"/></para>
  <para style="li1">
    <verse number="21" style="v" sid="EXO 6:21"/>ಇಚ್ಹಾರನ ಪುತ್ರರು:</para>
  <para style="li2" vid="EXO 6:21">ಕೋರಹ, ನೆಫೆಗ್ ಮತ್ತು ಜಿಕ್ರಿ.<verse eid="EXO 6:21"/></para>
  <para style="li1">
    <verse number="22" style="v" sid="EXO 6:22"/>ಉಜ್ಜೀಯೇಲನ ಪುತ್ರರು:</para>
  <para style="li2" vid="EXO 6:22">ಮೀಶಾಯೇಲ್, ಎಲ್ಜಾಫಾನ್ ಮತ್ತು ಸಿತ್ರಿ.<verse eid="EXO 6:22"/></para>
  <para style="li1">
    <verse number="23" style="v" sid="EXO 6:23"/>ಆರೋನನು ಅಮ್ಮೀನಾದಾಬನ ಮಗಳೂ ನಹಶೋನನ ಸಹೋದರಿಯೂ ಆದ ಎಲೀಶೇಬಳನ್ನು ಮದುವೆಯಾದನು. ಆಕೆಯು ಅವನಿಗೆ ನಾದಾಬ್, ಅಬೀಹೂ, ಎಲಿಯಾಜರ್, ಈತಾಮಾರ್ ಇವರನ್ನು ಹೆತ್ತಳು.<verse eid="EXO 6:23"/></para>
  <para style="b"/>
  <para style="li1">
    <verse number="24" style="v" sid="EXO 6:24"/>ಕೋರಹನ ಪುತ್ರರು:</para>
  <para style="li2" vid="EXO 6:24">ಅಸ್ಸೀರ್ ಎಲ್ಕಾನಾ, ಅಬೀಯಾಸಾಫ್ ಎಂಬುವರು.</para>
  <para style="li4" vid="EXO 6:24">ಇವು ಕೋರಹೀಯರ ಗೋತ್ರಗಳು.<verse eid="EXO 6:24"/></para>
  <para style="b"/>
  <para style="li1">
    <verse number="25" style="v" sid="EXO 6:25"/>ಆರೋನನ ಮಗ ಎಲಿಯಾಜರನು ಪೂಟಿಯೇಲನ ಹೆಣ್ಣುಮಕ್ಕಳಲ್ಲಿ ಒಬ್ಬಳನ್ನು ಮದುವೆಯಾದನು. ಆಕೆಯು ಅವನಿಗೆ ಫೀನೆಹಾಸನನ್ನು ಹೆತ್ತಳು.</para>
  <para style="b" vid="EXO 6:25"/>
  <para style="li4" vid="EXO 6:25">ಗೋತ್ರಗಳ ಪ್ರಕಾರ ಇವರು ಲೇವಿಯರ ಗೋತ್ರಗಳ ಮುಖ್ಯಸ್ಥರು.<verse eid="EXO 6:25"/></para>
  <para style="b"/>
  <para style="p">
    <verse number="26" style="v" sid="EXO 6:26"/>ಆರೋನ್, ಮೋಶೆ ಇವರಿಗೆ, “ಇಸ್ರಾಯೇಲರನ್ನು ಅವರವರ ಗೋತ್ರಗಳಿಗನುಸಾರವಾಗಿ ಈಜಿಪ್ಟಿನ ಒಳಗಿಂದ ಹೊರಗೆ ಬರಮಾಡಬೇಕು,” ಎಂದು ಯೆಹೋವ ದೇವರು ಹೇಳಿದ್ದರು. <verse eid="EXO 6:26"/><verse number="27" style="v" sid="EXO 6:27"/>ಆದುದರಿಂದ ಮೋಶೆ, ಆರೋನರೂ ಇಸ್ರಾಯೇಲರನ್ನು ಹೊರಗೆ ತರುವುದಕ್ಕಾಗಿ ಈಜಿಪ್ಟಿನ ಅರಸನಾದ ಫರೋಹನ ಸಂಗಡ ಮಾತನಾಡಿದರು.<verse eid="EXO 6:27"/></para>
  <para style="s1">ಆರೋನನು ಮೋಶೆಯ ಪರವಾಗಿ ಮಾತನಾಡುವುದು</para>
  <para style="p">
    <verse number="28" style="v" sid="EXO 6:28"/>ಯೆಹೋವ ದೇವರು ಈಜಿಪ್ಟ್ ದೇಶದಲ್ಲಿ ಮೋಶೆಯ ಸಂಗಡ ಮಾತನಾಡಿದರು. <verse eid="EXO 6:28"/><verse number="29" style="v" sid="EXO 6:29"/>ಅವರು ಮೋಶೆಗೆ, “ನಾನೇ ಯೆಹೋವ ದೇವರು. ನಾನು ನಿನಗೆ ಹೇಳುವುದನ್ನೆಲ್ಲಾ ಈಜಿಪ್ಟಿನ ಅರಸನಾದ ಫರೋಹನಿಗೆ ತಿಳಿಸು,” ಎಂದರು.<verse eid="EXO 6:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="EXO 6:30"/>ಅದಕ್ಕೆ ಮೋಶೆಯು ಯೆಹೋವ ದೇವರ ಮುಂದೆ, “ಇಗೋ, ನಾನು ತೊದಲು ಮಾತನಾಡುವವನು. ಫರೋಹನು ನನ್ನ ಮಾತನ್ನು ಹೇಗೆ ಕೇಳುತ್ತಾನೆ?” ಎಂದನು.<verse eid="EXO 6:30"/></para>
  <chapter eid="EXO 6"/>
  <chapter number="7" style="c" sid="EXO 7"/>
  <para style="p">
    <verse number="1" style="v" sid="EXO 7:1"/>ಆಗ ಯೆಹೋವ ದೇವರು ಮೋಶೆಗೆ, “ಇಗೋ, ನಿನ್ನನ್ನು ಫರೋಹನಿಗೆ ದೇವರಂತೆ ಮಾಡಿದ್ದೇನೆ. ನಿನ್ನ ಸಹೋದರನಾದ ಆರೋನನು ನಿನ್ನ ಪ್ರವಾದಿಯಾಗಿರುವನು. <verse eid="EXO 7:1"/><verse number="2" style="v" sid="EXO 7:2"/>ನಾನು ನಿನಗೆ ಆಜ್ಞಾಪಿಸುವುದನ್ನೆಲ್ಲಾ ನೀನು ಮಾತನಾಡಬೇಕು. ಇಸ್ರಾಯೇಲರನ್ನು ತನ್ನ ದೇಶದೊಳಗಿಂದ ಕಳುಹಿಸಿಬಿಡುವ ಹಾಗೆ ನಿನ್ನ ಸಹೋದರನಾದ ಆರೋನನು ಫರೋಹನ ಸಂಗಡ ಮಾತನಾಡಬೇಕು. <verse eid="EXO 7:2"/><verse number="3" style="v" sid="EXO 7:3"/>ಆದರೆ ನಾನು ಫರೋಹನ ಹೃದಯವನ್ನು ಕಠಿಣಪಡಿಸಿ, ನನ್ನ ಸೂಚಕಕಾರ್ಯಗಳನ್ನೂ, ನನ್ನ ಅದ್ಭುತಕಾರ್ಯಗಳನ್ನೂ ಈಜಿಪ್ಟ್ ದೇಶದಲ್ಲಿ ಹೆಚ್ಚಿಸುವೆನು. <verse eid="EXO 7:3"/><verse number="4" style="v" sid="EXO 7:4"/>ಆದರೆ ಫರೋಹನು ನಿಮ್ಮ ಮಾತನ್ನು ಕೇಳುವುದಿಲ್ಲ. ಆದರೆ ನನ್ನ ಕೈಯನ್ನು ಈಜಿಪ್ಟಿನ ಮೇಲೆ ಇಟ್ಟು, ದೊಡ್ಡ ನ್ಯಾಯ ತೀರ್ಪುಗಳಿಂದ ನನ್ನ ಜನರಾದ ಇಸ್ರಾಯೇಲರನ್ನೂ, ಅವರ ಸೈನ್ಯಗಳನ್ನೂ ಈಜಿಪ್ಟ್ ದೇಶದೊಳಗಿಂದ ಹೊರಗೆ ಬರಮಾಡುವೆನು. <verse eid="EXO 7:4"/><verse number="5" style="v" sid="EXO 7:5"/>ನಾನು ಈಜಿಪ್ಟಿನ ಮೇಲೆ ನನ್ನ ಕೈಯನ್ನಿಟ್ಟು, ಅವರೊಳಗಿಂದ ಇಸ್ರಾಯೇಲರನ್ನು ಹೊರಗೆ ಬರಮಾಡಿದಾಗ, ನಾನು ಯೆಹೋವ ದೇವರೆಂದು ಈಜಿಪ್ಟಿನವರಿಗೆ ತಿಳಿದುಬರುವುದು,” ಎಂದು ಹೇಳಿದರು.<verse eid="EXO 7:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="EXO 7:6"/>ಮೋಶೆಯೂ ಆರೋನನೂ ಯೆಹೋವ ದೇವರು ತಮಗೆ ಆಜ್ಞಾಪಿಸಿದ ಪ್ರಕಾರವೇ ಮಾಡಿದರು. <verse eid="EXO 7:6"/><verse number="7" style="v" sid="EXO 7:7"/>ಅವರು ಫರೋಹನ ಮುಂದೆ ಮಾತನಾಡುವಾಗ ಮೋಶೆಯು ಎಂಬತ್ತು ವರ್ಷದವನೂ ಆರೋನನು ಎಂಬತ್ತಮೂರು ವರ್ಷದವನೂ ಆಗಿದ್ದನು.<verse eid="EXO 7:7"/></para>
  <para style="s1">ಆರೋನನ ಕೋಲು ಸರ್ಪವಾದದ್ದು</para>
  <para style="p">
    <verse number="8" style="v" sid="EXO 7:8"/>ಆಗ ಯೆಹೋವ ದೇವರು ಮಾತನಾಡಿ ಮೋಶೆಗೂ ಆರೋನನಿಗೂ, <verse eid="EXO 7:8"/><verse number="9" style="v" sid="EXO 7:9"/>“ಫರೋಹನು ನಿಮಗೆ, ‘ನೀವು ಒಂದು ಅದ್ಭುತಕಾರ್ಯವನ್ನು ತೋರಿಸಿರಿ,’ ಎಂದಾಗ ನೀನು ಆರೋನನಿಗೆ, ‘ನಿನ್ನ ಕೋಲನ್ನು ತೆಗೆದುಕೊಂಡು ಫರೋಹನ ಮುಂದೆ ಬಿಸಾಡು,’ ಎಂದು ಹೇಳು, ಆಗ ಅದು ಸರ್ಪವಾಗುವುದು,” ಎಂದು ಹೇಳಿದರು.<verse eid="EXO 7:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="EXO 7:10"/>ಆಗ ಮೋಶೆಯೂ ಆರೋನನೂ ಫರೋಹನ ಬಳಿಗೆ ಹೋಗಿ ಯೆಹೋವ ದೇವರು ತಮಗೆ ಆಜ್ಞಾಪಿಸಿದಂತೆಯೇ ಮಾಡಿದರು. ಆರೋನನು ತನ್ನ ಕೋಲನ್ನು ಫರೋಹ ಮತ್ತು ಅವನ ಸೇವಕರ ಮುಂದೆಯೂ ಬಿಸಾಡಿದಾಗ, ಅದು ಸರ್ಪವಾಯಿತು. <verse eid="EXO 7:10"/><verse number="11" style="v" sid="EXO 7:11"/>ಫರೋಹನು ಜ್ಞಾನಿಗಳನ್ನೂ, ಮಂತ್ರವಾದಿಗಳನ್ನೂ ಕರೆಸಿದನು. ಆಗ ಈಜಿಪ್ಟಿನ ಮಂತ್ರಗಾರರೂ ಸಹ ತಮ್ಮ ಮಾಟಗಳಿಂದ ಹಾಗೆಯೇ ಮಾಡಿದರು. <verse eid="EXO 7:11"/><verse number="12" style="v" sid="EXO 7:12"/>ಅವರು ತಮ್ಮ ತಮ್ಮ ಕೋಲುಗಳನ್ನು ಬಿಸಾಡಿದಾಗ, ಅವು ಸರ್ಪಗಳಾದವು. ಆದರೆ ಆರೋನನ ಕೋಲು ಅವರ ಕೋಲುಗಳನ್ನು ನುಂಗಿಬಿಟ್ಟಿತು. <verse eid="EXO 7:12"/><verse number="13" style="v" sid="EXO 7:13"/>ಯೆಹೋವ ದೇವರು ಹೇಳಿದಂತೆಯೇ ಫರೋಹನ ಹೃದಯವು ಕಠಿಣವಾಯಿತು. ಅವನು ಅವರ ಮಾತನ್ನು ಕೇಳಲಿಲ್ಲ.<verse eid="EXO 7:13"/></para>
  <para style="s1">ರಕ್ತದ ಉಪದ್ರವ</para>
  <para style="p">
    <verse number="14" style="v" sid="EXO 7:14"/>ಆಗ ಯೆಹೋವ ದೇವರು ಮೋಶೆಗೆ, “ಫರೋಹನ ಹೃದಯವು ಕಠಿಣವಾಯಿತು. ಅವನು ಜನರನ್ನು ಕಳುಹಿಸಿಬಿಡುವುದಕ್ಕೆ ನಿರಾಕರಿಸುತ್ತಿದ್ದಾನೆ. <verse eid="EXO 7:14"/><verse number="15" style="v" sid="EXO 7:15"/>ಬೆಳಿಗ್ಗೆ ಫರೋಹನ ಬಳಿಗೆ ಹೋಗು. ಅವನು ಹೊರಗೆ ನದಿಯ ಬಳಿಗೆ ಹೋಗುವನು. ಆಗ ನೈಲ್ ನದಿ ತೀರದಲ್ಲಿ ಅವನೆದುರಿಗೆ ನಿಂತುಕೊಂಡು, ಸರ್ಪವಾಗಿ ಮಾಡಿದ ಕೋಲನ್ನು ನಿನ್ನ ಕೈಯಲ್ಲಿ ಹಿಡಿದುಕೊಂಡಿರು. <verse eid="EXO 7:15"/><verse number="16" style="v" sid="EXO 7:16"/>ಅವನಿಗೆ ನೀನು, ‘ಹಿಬ್ರಿಯರ ದೇವರಾದ ಯೆಹೋವ ದೇವರು ನನ್ನನ್ನು ನಿನ್ನ ಬಳಿಗೆ ಕಳುಹಿಸಿದ್ದಾರೆ. ಮರುಭೂಮಿಯಲ್ಲಿ ನನಗೆ ಆರಾಧನೆ ಮಾಡುವ ಹಾಗೆ ನನ್ನ ಜನರನ್ನು ಕಳುಹಿಸು, ಎಂದು ಅವರು ಹೇಳಿದ್ದಾರೆ. ಆದರೆ ಇಗೋ, ಇಂದಿನವರೆಗೂ ನೀನು ಕೇಳಲಿಲ್ಲ. <verse eid="EXO 7:16"/><verse number="17" style="v" sid="EXO 7:17"/>ಆದುದರಿಂದ ಯೆಹೋವ ದೇವರು ಮತ್ತೆ ನಿನಗೆ ಹೇಳುವುದೇನೆಂದರೆ: ನಾನೇ ಯೆಹೋವ ದೇವರೆಂದು ನೀನು ಇದರಿಂದ ತಿಳಿದುಕೊಳ್ಳುವೆ. ನನ್ನ ಕೈಯಲ್ಲಿರುವ ಕೋಲಿನಿಂದ, ನೈಲ್ ನದಿಯಲ್ಲಿರುವ ನೀರನ್ನು ಹೊಡೆಯುವೆನು, ಆಗ ಅದು ರಕ್ತವಾಗುವುದು. <verse eid="EXO 7:17"/><verse number="18" style="v" sid="EXO 7:18"/>ನದಿಯಲ್ಲಿರುವ ಮೀನುಗಳು ಸಾಯುವುವು. ನೈಲ್ ನದಿಯು ಹೊಲಸಾಗಿ ನಾರುವುದು. ಈಜಿಪ್ಟಿನವರು ನದಿಯ ನೀರನ್ನು ಕುಡಿಯುವುದಕ್ಕೆ ಅಸಹ್ಯಪಡುವರು,’ ಎಂದು ಹೇಳು,” ಎಂದರು.<verse eid="EXO 7:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="EXO 7:19"/>ಅನಂತರ ಯೆಹೋವ ದೇವರು ಮೋಶೆಗೆ, “ನೀನು ಆರೋನನಿಗೆ, ‘ನಿನ್ನ ಕೋಲನ್ನು ತೆಗೆದುಕೊಂಡು ಈಜಿಪ್ಟಿನ ನೀರಿನ ಮೇಲೆಯೂ ಅದರ ನದಿಗಳ ಮೇಲೆಯೂ ಕೊಳಗಳ ಮೇಲೆಯೂ ಅದರ ಕಾಲುವೆ ಮೇಲೆಯೂ ಅದರ ಕೆರೆಗಳ ಮೇಲೆಯೂ ಕೈಚಾಚು,’ ಎಂದು ಹೇಳು. ಆಗ ಅವು ರಕ್ತವಾಗುವುವು. ಈಜಿಪ್ಟ್ ದೇಶದಲ್ಲಿ ನೀರಿರುವ ಮರದ ತೊಟ್ಟಿಗಳಲ್ಲಾಗಲೀ, ಕಲ್ಲಿನ ಪಾತ್ರೆಗಳಲ್ಲಾಗಲೀ ರಕ್ತವಿರುವುದು,” ಎಂದು ಹೇಳಿದರು.<verse eid="EXO 7:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="EXO 7:20"/>ಮೋಶೆಯೂ ಆರೋನನೂ ಯೆಹೋವ ದೇವರು ತಮಗೆ ಆಜ್ಞಾಪಿಸಿದಂತೆಯೇ ಮಾಡಿದರು. ಅವನು ಕೋಲನ್ನು ಎತ್ತಿ, ನೈಲ್ ನದಿಯಲ್ಲಿರುವ ನೀರನ್ನು ಫರೋಹನ ಮುಂದೆಯೂ, ಅವನ ಸೇವಕರ ಮುಂದೆಯೂ ಹೊಡೆದನು. ಆಗ ನದಿಯಲ್ಲಿದ್ದ ನೀರೆಲ್ಲಾ ರಕ್ತವಾಯಿತು. <verse eid="EXO 7:20"/><verse number="21" style="v" sid="EXO 7:21"/>ನದಿಯಲ್ಲಿದ್ದ ಮೀನುಗಳು ಸತ್ತವು, ನದಿಯು ದುರ್ವಾಸನೆಗೊಂಡಿತು. ಈಜಿಪ್ಟಿನವರು ನೈಲ್ ನದಿಯ ನೀರನ್ನು ಕುಡಿಯಲಾರದೆ ಹೋದರು. ಆಗ ಈಜಿಪ್ಟ್ ದೇಶದಲ್ಲೆಲ್ಲಾ ರಕ್ತವಿತ್ತು.<verse eid="EXO 7:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="EXO 7:22"/>ಆದರೆ ಈಜಿಪ್ಟಿನ ಮಂತ್ರಗಾರರು ತಮ್ಮ ಮಾಟಗಳಿಂದ ಹಾಗೆಯೇ ಮಾಡಿದ್ದರಿಂದ ಫರೋಹನ ಹೃದಯವು ಕಠಿಣವಾಯಿತು. ಯೆಹೋವ ದೇವರು ಹೇಳಿದಂತೆಯೇ ಅವನು ಅವರ ಮಾತನ್ನು ಕೇಳಲಿಲ್ಲ. <verse eid="EXO 7:22"/><verse number="23" style="v" sid="EXO 7:23"/>ಫರೋಹನು ತಿರುಗಿಕೊಂಡು ತನ್ನ ಅರಮನೆಗೆ ಹಿಂದಿರುಗಿದನು. ಅವನು ಈ ಅದ್ಭುತಕ್ಕೂ ಗಮನಕೊಡಲಿಲ್ಲ. <verse eid="EXO 7:23"/><verse number="24" style="v" sid="EXO 7:24"/>ಆದರೆ ಈಜಿಪ್ಟಿನವರೆಲ್ಲರೂ ನದಿಯ ನೀರನ್ನು ಕುಡಿಯಲಾರದೆ, ಕುಡಿಯುವ ನೀರಿಗಾಗಿ ನೈಲ್ ನದಿಯ ಸುತ್ತಲೂ ಅಗೆದರು.<verse eid="EXO 7:24"/></para>
  <para style="s1">ಕಪ್ಪೆಗಳ ಉಪದ್ರವ</para>
  <para style="p">
    <verse number="25" style="v" sid="EXO 7:25"/>ಯೆಹೋವ ದೇವರು ನೈಲ್ ನದಿಯನ್ನು ರಕ್ತವನ್ನಾಗಿ ಮಾಡಿ ಏಳು ದಿನಗಳು ಕಳೆದವು.<verse eid="EXO 7:25"/></para>
  <chapter eid="EXO 7"/>
  <chapter number="8" style="c" sid="EXO 8"/>
  <para style="nb">
    <verse number="1" style="v" sid="EXO 8:1"/>ಅನಂತರ ಯೆಹೋವ ದೇವರು ಮೋಶೆಯ ಸಂಗಡ ಮಾತನಾಡಿ ಅವನಿಗೆ, “ನೀನು ಫರೋಹನ ಬಳಿಗೆ ಹೋಗಿ ಅವನಿಗೆ ಯೆಹೋವ ದೇವರು ಹೀಗೆ ಹೇಳುತ್ತಾರೆ, ‘ನನ್ನನ್ನು ಆರಾಧಿಸುವಂತೆ ನನ್ನ ಜನರನ್ನು ಕಳುಹಿಸು. <verse eid="EXO 8:1"/><verse number="2" style="v" sid="EXO 8:2"/>ಕಳುಹಿಸುವುದಕ್ಕೆ ನಿರಾಕರಿಸಿದರೆ, ನಾನು ನಿನ್ನ ದೇಶವನ್ನೆಲ್ಲಾ ಕಪ್ಪೆಗಳಿಂದ ಉಪದ್ರವ ತರುವೆನು. <verse eid="EXO 8:2"/><verse number="3" style="v" sid="EXO 8:3"/>ನೈಲ್ ನದಿಯಲ್ಲಿ ಕಪ್ಪೆಗಳು ತುಂಬಿಹೋಗುವುವು. ಅವು ನಿನ್ನ ಅರಮನೆಯಲ್ಲಿಯೂ ನೀನು ಮಲಗುವ ಕೊಠಡಿಯಲ್ಲಿಯೂ ನಿನ್ನ ಹಾಸಿಗೆಯ ಮೇಲೂ ನಿನ್ನ ಸೇವಕರ ಮನೆಗಳಲ್ಲಿಯೂ ನಿನ್ನ ಜನರ ಮೇಲೆಯೂ ನಿನ್ನ ಒಲೆಗಳಲ್ಲಿಯೂ ನಿನ್ನ ಹಿಟ್ಟು ನಾದುವ ಹರಿವಾಣಗಳಲ್ಲಿಯೂ ಕಾಣಿಸಿಕೊಳ್ಳುವುವು. <verse eid="EXO 8:3"/><verse number="4" style="v" sid="EXO 8:4"/>ನಿನ್ನ ಮೇಲೆಯೂ ನಿನ್ನ ಜನರ ಮೇಲೆಯೂ ನಿನ್ನ ಎಲ್ಲಾ ಅಧಿಕಾರಿಗಳ ಮೇಲೆಯೂ ಕಪ್ಪೆಗಳು ಏರಿ ಬರುವುವು,’ ಎಂದು ಹೇಳು,” ಎಂದರು.<verse eid="EXO 8:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="EXO 8:5"/>ಅನಂತರ ಯೆಹೋವ ದೇವರು ಮೋಶೆಯ ಸಂಗಡ ಮಾತನಾಡಿ, “ನೀನು ಆರೋನನಿಗೆ, ‘ನೀನು ಕೋಲನ್ನು ಹಿಡಿದುಕೊಂಡು ನದಿ, ಕಾಲುವೆ, ಕೆರೆಗಳ ಮೇಲೆಲ್ಲಾ ನಿನ್ನ ಕೈಚಾಚಿ ಈಜಿಪ್ಟ್ ದೇಶದ ಮೇಲೆಲ್ಲಾ ಕಪ್ಪೆಗಳು ಬರುವಂತೆ ಮಾಡು,’ ಎಂದು ಹೇಳಬೇಕು,” ಎಂದರು.<verse eid="EXO 8:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="EXO 8:6"/>ಆರೋನನು ಈಜಿಪ್ಟಿನ ನೀರಿನ ಮೇಲೆ ಕೈಚಾಚಿದಾಗ, ಕಪ್ಪೆಗಳು ಏರಿಬಂದು ಈಜಿಪ್ಟ್ ದೇಶವನ್ನು ಮುತ್ತಿಕೊಂಡವು. <verse eid="EXO 8:6"/><verse number="7" style="v" sid="EXO 8:7"/>ಆದರೆ ಮಂತ್ರಗಾರರು ತಮ್ಮ ಮಾಟಗಳಿಂದ ಹಾಗೆಯೇ ಮಾಡಿ, ಕಪ್ಪೆಗಳನ್ನು ಈಜಿಪ್ಟ್ ದೇಶದ ಮೇಲೆ ಬರಮಾಡಿದರು.<verse eid="EXO 8:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="EXO 8:8"/>ಆಗ ಫರೋಹನು ಮೋಶೆ ಮತ್ತು ಆರೋನರನ್ನು ಕರೆಯಿಸಿ, “ನೀವು ಯೆಹೋವ ದೇವರನ್ನು ಬೇಡಿಕೊಂಡು ಈ ಕಪ್ಪೆಗಳನ್ನು ನನ್ನ ಬಳಿಯಿಂದಲೂ ನನ್ನ ಪ್ರಜೆಗಳ ಬಳಿಯಿಂದಲೂ ತೊಲಗಿಸಬೇಕು. ಹಾಗೆ ಮಾಡಿದರೆ ನಿಮ್ಮ ಜನರು ಯೆಹೋವ ದೇವರಿಗೋಸ್ಕರ ಯಜ್ಞಮಾಡುವಂತೆ ಅವರಿಗೆ ನಾನು ಅಪ್ಪಣೆ ಕೊಡುವೆನು,” ಎಂದನು.<verse eid="EXO 8:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="EXO 8:9"/>ಅದಕ್ಕೆ ಮೋಶೆ, “ಈ ಕಪ್ಪೆಗಳು ತಮ್ಮ ಬಳಿಯಿಂದಲೂ ನಿನ್ನ ಮನೆಗಳಿಂದಲೂ ತೊಲಗಿ ಹೋಗಿ, ನೈಲ್ ನದಿಯಲ್ಲಿ ಮಾತ್ರ ಉಳಿಯುವಂತೆ ನಾನು ಯಾವಾಗ ನಿನ್ನ ಪರವಾಗಿ, ನಿನ್ನ ಪ್ರಜಾ ಪರಿವಾರದ ಪರವಾಗಿ ಪ್ರಾರ್ಥನೆ ಸಲ್ಲಿಸಬೇಕು? ನಿನಗೆ ಸರಿದೋರಿದಂತೆ ನೀನೇ ಅದಕ್ಕೊಂದು ಕಾಲವನ್ನು ನಿಗದಿಮಾಡಬೇಕು,” ಎಂದು ಫರೋಹನನ್ನು ವಿನಂತಿಸಿದನು.<verse eid="EXO 8:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="EXO 8:10"/>ಫರೋಹನು ಮೋಶೆಗೆ, “ನಾಳೆ,” ಎಂದನು.</para>
  <para style="p" vid="EXO 8:10">ಆಗ ಮೋಶೆಯು, “ನಮ್ಮ ದೇವರಾಗಿರುವ ಯೆಹೋವ ದೇವರ ಹಾಗೆ ಯಾರೂ ಇಲ್ಲವೆಂದು ನೀನು ತಿಳಿದುಕೊಳ್ಳುವ ಹಾಗೆ, ನಿನ್ನ ಮಾತಿನ ಪ್ರಕಾರ ಆಗಲಿ. <verse eid="EXO 8:10"/><verse number="11" style="v" sid="EXO 8:11"/>ಕಪ್ಪೆಗಳು ನಿನ್ನಿಂದಲೂ ನಿನ್ನ ಮನೆಗಳಿಂದಲೂ ನಿನ್ನ ಸೇವಕರಿಂದಲೂ ನಿನ್ನ ಜನರಿಂದಲೂ ಹೊರಟುಹೋಗಿ, ನೈಲ್ ನದಿಯಲ್ಲಿ ಮಾತ್ರ ಇರುವುವು,” ಎಂದನು.<verse eid="EXO 8:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="EXO 8:12"/>ಮೋಶೆ ಆರೋನರು ಫರೋಹನನ್ನು ಬಿಟ್ಟು ಹೊರಗೆ ಹೋದಾಗ, ಮೋಶೆ ಫರೋಹನ ಮೇಲೆ ಬರಮಾಡಿದ ಕಪ್ಪೆಗಳ ಕಾಟದ ಬಗ್ಗೆ ಯೆಹೋವ ದೇವರಿಗೆ ಮೊರೆಯಿಟ್ಟನು. <verse eid="EXO 8:12"/><verse number="13" style="v" sid="EXO 8:13"/>ಮೋಶೆ ಹೇಳಿದ ಪ್ರಕಾರ ಯೆಹೋವ ದೇವರು ಮಾಡಿದರು. ಮನೆಗಳಲ್ಲಿಯೂ ಅಂಗಳಗಳಲ್ಲಿಯೂ ಹೊಲಗಳಲ್ಲಿಯೂ ಇದ್ದ ಕಪ್ಪೆಗಳು ಸತ್ತವು. <verse eid="EXO 8:13"/><verse number="14" style="v" sid="EXO 8:14"/>ಅವರು ಅವುಗಳನ್ನು ರಾಶಿಗಳಾಗಿ ಕೂಡಿಸಿಟ್ಟಿದ್ದರಿಂದ ದೇಶವು ದುರ್ವಾಸನೆಯಿಂದ ತುಂಬಿತು. <verse eid="EXO 8:14"/><verse number="15" style="v" sid="EXO 8:15"/>ಆದರೆ ಫರೋಹನು ತನಗೆ ಉಪಶಮನವಾಯಿತೆಂದು ನೋಡಿದಾಗ, ಯೆಹೋವ ದೇವರು ಹೇಳಿದಂತೆ ಅವನು ತನ್ನ ಹೃದಯವನ್ನು ಕಠಿಣ ಮಾಡಿಕೊಂಡು, ಮೋಶೆ ಮತ್ತು ಆರೋನರ ಮಾತನ್ನು ಕೇಳಲಿಲ್ಲ.<verse eid="EXO 8:15"/></para>
  <para style="s1">ಹೇನುಗಳ ಉಪದ್ರವ</para>
  <para style="p">
    <verse number="16" style="v" sid="EXO 8:16"/>ಅನಂತರ ಯೆಹೋವ ದೇವರು ಮೋಶೆಯ ಸಂಗಡ ಮಾತನಾಡಿ, “ನೀನು ಆರೋನನಿಗೆ, ‘ನೀನು ಕೋಲನ್ನು ಚಾಚಿ ಭೂಮಿಯ ಧೂಳನ್ನು ಹೊಡೆ, ಆಗ ಈಜಿಪ್ಟ್ ದೇಶದಲ್ಲೆಲ್ಲಾ ಧೂಳು ಹೇನುಗಳಾಗುವುವು,’ ಎಂದು ಹೇಳು,” ಎಂದರು. <verse eid="EXO 8:16"/><verse number="17" style="v" sid="EXO 8:17"/>ಅವರು ಹಾಗೆಯೇ ಮಾಡಲಾರಂಭಿಸಿದರು. ಆರೋನನು ಕೋಲನ್ನು ಕೈಯಲ್ಲಿ ಹಿಡಿದು, ಅದನ್ನು ಚಾಚಿ, ಭೂಮಿಯ ಧೂಳನ್ನು ಹೊಡೆದನು. ಆಗ ಮನುಷ್ಯರಲ್ಲಿಯೂ ಪಶುಗಳಲ್ಲಿಯೂ ಹೇನುಗಳಾದವು. ಈಜಿಪ್ಟ್ ದೇಶದಲ್ಲೆಲ್ಲಾ ನೆಲದ ಧೂಳು ಹೇನುಗಳಾದವು <verse eid="EXO 8:17"/><verse number="18" style="v" sid="EXO 8:18"/>ಮಂತ್ರಗಾರರು ಹೇನುಗಳನ್ನು ಬರಮಾಡುವುದಕ್ಕೆ ತಮ್ಮ ಮಾಟಗಳಿಂದ ಪ್ರಯತ್ನಿಸಿದರು, ಆದರೆ ಸಾಧ್ಯವಾಗದೆ ಹೋಯಿತು.</para>
  <para style="p" vid="EXO 8:18">ಆ ಹೇನುಗಳು ಮನುಷ್ಯರ ಮೇಲೆಯೂ ಪಶುಗಳ ಮೇಲೆಯೂ ಹಾಗೆಯೇ ಇದ್ದವು. <verse eid="EXO 8:18"/><verse number="19" style="v" sid="EXO 8:19"/>ಆಗ ಮಂತ್ರಗಾರರು ಫರೋಹನಿಗೆ, “ಇದು ದೇವರ ಕೈಕೆಲಸವೇ ಸರಿ,” ಎಂದರು. ಆದರೆ ಯೆಹೋವ ದೇವರು ಹೇಳಿದಂತೆ ಫರೋಹನ ಹೃದಯ ಕಠಿಣವಾಯಿತು. ಆದ್ದರಿಂದ ಅವನು ಅವರ ಮಾತನ್ನು ಕೇಳಲಿಲ್ಲ.<verse eid="EXO 8:19"/></para>
  <para style="s1">ನೊಣಗಳ ಉಪದ್ರವ</para>
  <para style="p">
    <verse number="20" style="v" sid="EXO 8:20"/>ಆಗ ಯೆಹೋವ ದೇವರು ಮೋಶೆಗೆ, “ನೀನು ಬೆಳಿಗ್ಗೆ ಎದ್ದು ಫರೋಹನ ಮುಂದೆ ನಿಂತುಕೋ. ಅವನು ಹೊರಗೆ ನದಿಯ ಬಳಿಗೆ ಬರುತ್ತಾನೆ. ನೀನು ಅವನಿಗೆ ಹೇಳಬೇಕಾದದ್ದೇನೆಂದರೆ, ‘ಯೆಹೋವ ದೇವರು ಹೀಗೆ ಹೇಳುತ್ತಾರೆ: ನನ್ನ ಜನರು ನನ್ನನ್ನು ಆರಾಧಿಸುವಂತೆ ಅವರನ್ನು ಕಳುಹಿಸು. <verse eid="EXO 8:20"/><verse number="21" style="v" sid="EXO 8:21"/>ನೀನು ನನ್ನ ಜನರನ್ನು ಕಳುಹಿಸದೆ ಹೋದರೆ, ನಾನು ನಿನ್ನ ಮೇಲೆಯೂ ನಿನ್ನ ಸೇವಕರ ಮೇಲೆಯೂ ನಿನ್ನ ಜನರ ಮೇಲೆಯೂ ನಿನ್ನ ಮನೆಗಳಿಗೂ ನೊಣಗಳನ್ನು ಕಳುಹಿಸುವೆನು. ಈಜಿಪ್ಟಿನವರ ಮನೆಗಳೂ, ಅವರು ವಾಸವಾಗಿರುವ ಭೂಮಿಯೂ ನೊಣಗಳಿಂದ ತುಂಬಿರುವುವು.<verse eid="EXO 8:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="EXO 8:22"/>“ ‘ಆದರೆ ಆ ದಿವಸದಲ್ಲಿ ನಾನೇ ಭೂಲೋಕದಲ್ಲಿ ಯೆಹೋವ ದೇವರೆಂದು ನೀನು ತಿಳಿದುಕೊಳ್ಳುವಂತೆ, ನನ್ನ ಜನರು ವಾಸಿಸುವ ಗೋಷೆನ್ ಪ್ರಾಂತದಲ್ಲಿ ನೊಣಗಳು ಇರದ ಹಾಗೆ ಅದನ್ನು ನಾನು ಪ್ರತ್ಯೇಕಿಸುವೆನು. <verse eid="EXO 8:22"/><verse number="23" style="v" sid="EXO 8:23"/>ನನ್ನ ಜನರನ್ನೂ, ನಿನ್ನ ಜನರನ್ನೂ ವಿಂಗಡಿಸುವೆನು. ನಾಳೆ ಈ ಸೂಚಕಕಾರ್ಯ ಕಾಣುವುದು,’ ಎಂದು ಹೇಳು,” ಎಂದರು.<verse eid="EXO 8:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="EXO 8:24"/>ಯೆಹೋವ ದೇವರು ಹಾಗೆಯೇ ಮಾಡಲಾರಂಭಿಸಿದರು. ಬಾಧಿಸುವ ನೊಣಗಳು ಫರೋಹನ ಮನೆಯಲ್ಲಿಯೂ ಅವನ ಸೇವಕರ ಮನೆಗಳಲ್ಲಿಯೂ ಸಮಸ್ತ ಈಜಿಪ್ಟ್ ದೇಶದಲ್ಲಿಯೂ ಬಂದವು. ನೊಣಗಳಿಂದ ದೇಶವು ಹಾಳಾಗಿ ಹೋಯಿತು.<verse eid="EXO 8:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="EXO 8:25"/>ಆಗ ಫರೋಹನು ಮೋಶೆ ಆರೋನರನ್ನು ಕರೆಯಿಸಿ ಅವರಿಗೆ, “ನೀವು ಹೋಗಿ ಈ ದೇಶದಲ್ಲಿಯೇ ನಿಮ್ಮ ದೇವರಿಗೆ ಯಜ್ಞವನ್ನರ್ಪಿಸಿರಿ,” ಎಂದನು.<verse eid="EXO 8:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="EXO 8:26"/>ಆದರೆ ಮೋಶೆಯು ಫರೋಹನಿಗೆ, “ಹಾಗೆ ಮಾಡುವುದು ಯುಕ್ತವಲ್ಲ. ಏಕೆಂದರೆ ನಮ್ಮ ಯೆಹೋವ ದೇವರಾದ ದೇವರಿಗೆ ಯಜ್ಞವನ್ನರ್ಪಿಸುವುದು ಈಜಿಪ್ಟಿನವರಿಗೆ ಅಸಹ್ಯವಾಗಿರುವುದು. ಈಜಿಪ್ಟಿನವರಿಗೆ ಅಸಹ್ಯವಾಗಿರುವುದನ್ನು ಅವರ ಕಣ್ಣೆದುರಿಗೆ ಅರ್ಪಿಸಿದರೆ, ಅವರು ನಮ್ಮ ಮೇಲೆ ಕಲ್ಲೆಸೆದಾರು. <verse eid="EXO 8:26"/><verse number="27" style="v" sid="EXO 8:27"/>ಮರುಭೂಮಿಯಲ್ಲಿ ಮೂರು ದಿನಗಳು ಪ್ರಯಾಣಮಾಡಿ, ನಮ್ಮ ದೇವರಾದ ಯೆಹೋವ ದೇವರಿಗೆ ಅವರ ಅಪ್ಪಣೆಯಂತೆ ಯಜ್ಞಮಾಡುವೆವು,” ಎಂದು ಹೇಳಿದನು.<verse eid="EXO 8:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="EXO 8:28"/>ಅದಕ್ಕೆ ಫರೋಹನು ಅವನಿಗೆ, “ನಿಮ್ಮ ದೇವರಾದ ಯೆಹೋವ ದೇವರಿಗೆ ಮರುಭೂಮಿಯಲ್ಲಿ ಯಜ್ಞವನ್ನರ್ಪಿಸುವಂತೆ ನಿಮ್ಮನ್ನು ಕಳುಹಿಸುತ್ತೇನೆ. ಆದರೆ ದೂರ ಹೋಗಬೇಡಿರಿ, ನನಗೋಸ್ಕರ ಪ್ರಾರ್ಥನೆಮಾಡಿರಿ,” ಎಂದನು.<verse eid="EXO 8:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="EXO 8:29"/>ಆಗ ಮೋಶೆಯು ಅವನಿಗೆ, “ನಾನು ನಿನ್ನನ್ನು ಬಿಟ್ಟು ಹೋಗಿ, ಯೆಹೋವ ದೇವರಿಗೆ ಪ್ರಾರ್ಥನೆ ಮಾಡುವೆನು. ನೊಣಗಳು ನಾಳೆ ಫರೋಹನನ್ನೂ, ಅವನ ಸೇವಕರನ್ನೂ, ಅವರ ಜನರನ್ನೂ ಬಿಟ್ಟು ಹೋಗುವುವು. ಆದರೆ ಯೆಹೋವ ದೇವರಿಗೆ ಯಜ್ಞವನ್ನರ್ಪಿಸುವುದಕ್ಕೆ ಫರೋಹನಾದ ನೀನು ಜನರನ್ನು ಕಳುಹಿಸದೆ ಇನ್ನು ಮೇಲೆ ವಂಚಿಸಬಾರದು,” ಎಂದನು.<verse eid="EXO 8:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="EXO 8:30"/>ತರುವಾಯ ಮೋಶೆಯು ಫರೋಹನನ್ನು ಬಿಟ್ಟು ಹೋಗಿ, ಯೆಹೋವ ದೇವರನ್ನು ಬೇಡಿಕೊಂಡನು. <verse eid="EXO 8:30"/><verse number="31" style="v" sid="EXO 8:31"/>ಮೋಶೆಯು ಕೇಳಿದಂತೆಯೇ ಯೆಹೋವ ದೇವರು ಮಾಡಿದರು. ಅವರು ಫರೋಹನಿಂದಲೂ ಅವನ ಸೇವಕರಿಂದಲೂ, ಅವರ ಜನರಿಂದಲೂ ನೊಣಗಳನ್ನು ತೆಗೆದುಹಾಕಿದರು. ಅಲ್ಲಿ ಒಂದಾದರೂ ಉಳಿಯಲಿಲ್ಲ. <verse eid="EXO 8:31"/><verse number="32" style="v" sid="EXO 8:32"/>ಆದರೆ ಫರೋಹನು ಆ ಸಮಯದಲ್ಲಿಯೂ ತನ್ನ ಹೃದಯವನ್ನು ಕಠಿಣ ಮಾಡಿಕೊಂಡಿದ್ದಲ್ಲದೆ, ಜನರನ್ನೂ ಹೋಗಗೊಡಿಸಲಿಲ್ಲ.<verse eid="EXO 8:32"/></para>
  <chapter eid="EXO 8"/>
  <chapter number="9" style="c" sid="EXO 9"/>
  <para style="s1">ಪಶುಗಳ ಉಪದ್ರವ</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 9:1"/>ಅನಂತರ ಯೆಹೋವ ದೇವರು ಮೋಶೆಗೆ ಹೇಳಿದ್ದೇನಂದರೆ, “ಫರೋಹನ ಬಳಿಗೆ ಹೋಗಿ ಅವನಿಗೆ, ‘ಹಿಬ್ರಿಯರ ದೇವರಾದ ಯೆಹೋವ ದೇವರು ಹೀಗೆ ಹೇಳುತ್ತಾರೆ: “ನನ್ನನ್ನು ಆರಾಧಿಸುವಂತೆ ನನ್ನ ಜನರನ್ನು ಕಳುಹಿಸು.” <verse eid="EXO 9:1"/><verse number="2" style="v" sid="EXO 9:2"/>ಅವರನ್ನು ಕಳುಹಿಸುವುದಕ್ಕೆ ನಿರಾಕರಿಸಿ ಇನ್ನೂ ತಡೆದರೆ, <verse eid="EXO 9:2"/><verse number="3" style="v" sid="EXO 9:3"/>ಯೆಹೋವ ದೇವರ ಕೈ ಹೊಲದಲ್ಲಿರುವ ನಿನ್ನ ಪಶುಗಳ ಮೇಲೆ ಇರುವುದು. ಕುದುರೆ, ಕತ್ತೆ, ಒಂಟೆ, ಎತ್ತು, ಕುರಿ, ಆಡು ಇವುಗಳ ಮೇಲೆ ಕಠಿಣವಾದ ಉಪದ್ರವ ಬರುವುದು. <verse eid="EXO 9:3"/><verse number="4" style="v" sid="EXO 9:4"/>ಯೆಹೋವ ದೇವರು ಇಸ್ರಾಯೇಲರ ಪಶುಗಳನ್ನೂ ಈಜಿಪ್ಟಿನವರ ಪಶುಗಳನ್ನೂ ವಿಂಗಡಿಸುವರು. ಇಸ್ರಾಯೇಲರ ಪಶುಗಳಲ್ಲಿ ಒಂದೂ ಸಾಯುವುದಿಲ್ಲ,’ ” ಎಂದರು.<verse eid="EXO 9:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="EXO 9:5"/>ಇದಲ್ಲದೆ ಯೆಹೋವ ದೇವರು, “ನಿರ್ದಿಷ್ಟವಾದ ಒಂದು ಸಮಯವನ್ನು ನೇಮಿಸಿ, ನಾಳೆ ಯೆಹೋವ ದೇವರು ಈ ಕಾರ್ಯವನ್ನು ಈ ದೇಶದಲ್ಲಿ ಮಾಡುವರು, ಎಂದು ಹೇಳು,” ಎಂದರು. <verse eid="EXO 9:5"/><verse number="6" style="v" sid="EXO 9:6"/>ಮಾರನೆಯ ದಿನವೇ ಯೆಹೋವ ದೇವರು ಆ ಕಾರ್ಯವನ್ನು ಮಾಡಲಾರಂಭಿಸಿದರು. ಈಜಿಪ್ಟಿನ ಪಶುಗಳೆಲ್ಲಾ ಸತ್ತು ಹೋದವು. ಆದರೆ ಇಸ್ರಾಯೇಲರ ಪಶುಗಳಲ್ಲಿ ಒಂದೂ ಸಾಯಲಿಲ್ಲ. <verse eid="EXO 9:6"/><verse number="7" style="v" sid="EXO 9:7"/>ಫರೋಹನು ಆಳುಗಳನ್ನು ಕಳುಹಿಸಿ ನೋಡಿದಾಗ, ಇಸ್ರಾಯೇಲರ ಪಶುಗಳಲ್ಲಿ ಒಂದೂ ಸತ್ತಿರಲಿಲ್ಲ. ಆದರೆ ಫರೋಹನ ಹೃದಯವು ಕಠಿಣವಾಗಿದ್ದುದರಿಂದ ಅವನು ಜನರನ್ನು ಹೋಗಗೊಡಿಸಲಿಲ್ಲ.<verse eid="EXO 9:7"/></para>
  <para style="s1">ಹುಣ್ಣುಗಳ ಉಪದ್ರವ</para>
  <para style="p">
    <verse number="8" style="v" sid="EXO 9:8"/>ಆಗ ಯೆಹೋವ ದೇವರು ಮೋಶೆ ಆರೋನರಿಗೆ, “ಕೈತುಂಬಾ ಒಲೆಯ ಬೂದಿಯನ್ನು ತೆಗೆದುಕೊಳ್ಳಿರಿ. ಅದನ್ನು ಮೋಶೆಯು ಫರೋಹನ ಮುಂದೆ ಆಕಾಶದ ಕಡೆಗೆ ತೂರಲಿ. <verse eid="EXO 9:8"/><verse number="9" style="v" sid="EXO 9:9"/>ಆಗ ಅದು ಈಜಿಪ್ಟ್ ದೇಶದಲ್ಲೆಲ್ಲಾ ಪುಡಿಯಾಗುವುದು. ಅದು ಈಜಿಪ್ಟ್ ದೇಶದಲ್ಲೆಲ್ಲಾ ಮನುಷ್ಯರ ಮೇಲೆಯೂ ಪಶುಗಳ ಮೇಲೆಯೂ ಹುಣ್ಣುಗಳಾಗುವ ಬೊಕ್ಕೆಗಳು ಏಳುವಂತೆ ಮಾಡುವುದು,” ಎಂದು ಹೇಳಿದರು.<verse eid="EXO 9:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="EXO 9:10"/>ಆಗ ಅವರು ಒಲೆಯ ಬೂದಿಯನ್ನು ತೆಗೆದುಕೊಂಡು ಫರೋಹನ ಮುಂದೆ ನಿಂತರು. ಮೋಶೆಯು ಅದನ್ನು ಆಕಾಶದ ಕಡೆಗೆ ತೂರಿದನು. ಆಗ ಅದು ಮನುಷ್ಯರಲ್ಲಿಯೂ ಪಶುಗಳಲ್ಲಿಯೂ ಹರಡಿ ಹುಣ್ಣುಗಳಾಗುವಂಥ ಬೊಕ್ಕೆಗಳಾದವು. <verse eid="EXO 9:10"/><verse number="11" style="v" sid="EXO 9:11"/>ಇದಲ್ಲದೆ ಮಂತ್ರಗಾರರು ಹುಣ್ಣಿನ ನಿಮಿತ್ತ ಮೋಶೆಯ ಮುಂದೆ ನಿಂತುಕೊಳ್ಳಲಾರದೆ ಹೋದರು. ಏಕೆಂದರೆ ಹುಣ್ಣುಗಳು ಮಂತ್ರಗಾರರ ಮೇಲೆಯೂ ಈಜಿಪ್ಟಿನವರ ಮೇಲೆಯೂ ಇದ್ದವು. <verse eid="EXO 9:11"/><verse number="12" style="v" sid="EXO 9:12"/>ಆದರೆ ಯೆಹೋವ ದೇವರು ಫರೋಹನ ಹೃದಯವನ್ನು ಕಠಿಣ ಮಾಡಿದರು. ಯೆಹೋವ ದೇವರು ಮೋಶೆಗೆ ಹೇಳಿದಂತೆಯೇ ಅವನು ಅವರ ಮಾತನ್ನು ಕೇಳಲಿಲ್ಲ.<verse eid="EXO 9:12"/></para>
  <para style="s1">ಆಲಿಕಲ್ಲಿನ ಮಳೆಯ ಉಪದ್ರವ</para>
  <para style="p">
    <verse number="13" style="v" sid="EXO 9:13"/>ಯೆಹೋವ ದೇವರು ಮೋಶೆಗೆ, “ಬೆಳಿಗ್ಗೆ ಎದ್ದು ಫರೋಹನ ಮುಂದೆ ನಿಂತುಕೊಂಡು ಅವನಿಗೆ, ‘ಹಿಬ್ರಿಯರ ದೇವರಾದ ಯೆಹೋವ ದೇವರು ಹೀಗೆ ಹೇಳುತ್ತಾರೆ: ನನ್ನನ್ನು ಅವರು ಆರಾಧಿಸುವ ಹಾಗೆ ನನ್ನ ಜನರನ್ನು ಕಳುಹಿಸು. <verse eid="EXO 9:13"/><verse number="14" style="v" sid="EXO 9:14"/>ಭೂಲೋಕದಲ್ಲೆಲ್ಲಾ ನನ್ನ ಹಾಗೆ ಯಾರೂ ಇಲ್ಲವೆಂದು ನೀನು ತಿಳಿದುಕೊಳ್ಳುವ ಹಾಗೆ, ಈ ಸಾರಿ ನಾನು ಎಲ್ಲಾ ಉಪದ್ರವಗಳನ್ನು ನಿನ್ನ ಮೇಲೆಯೂ ನಿನ್ನ ಸೇವಕರ ಮೇಲೆಯೂ ನಿನ್ನ ಜನರ ಮೇಲೆಯೂ ಬರಮಾಡುವೆನು. <verse eid="EXO 9:14"/><verse number="15" style="v" sid="EXO 9:15"/>ಈಗ ನನ್ನ ಕೈಚಾಚಿ ನಿನ್ನನ್ನೂ, ನಿನ್ನ ಜನರನ್ನೂ ಉಪದ್ರವದಿಂದ ಬಾಧಿಸುವೆನು. ನಿನ್ನನ್ನು ಭೂಮಿಯೊಳಗಿಂದ ನಿರ್ಮೂಲ ಮಾಡುವೆನು. <verse eid="EXO 9:15"/><verse number="16" style="v" sid="EXO 9:16"/>ಆದರೆ ನಿಶ್ಚಯವಾಗಿ ನಾನು ನಿನ್ನಲ್ಲಿ ನನ್ನ ಶಕ್ತಿಯನ್ನು ತೋರಿಸಿ, ನನ್ನ ಹೆಸರನ್ನು ಭೂಮಿಯ ಮೇಲೆಲ್ಲಾ ಪ್ರಸಿದ್ಧಪಡಿಸಬೇಕೆಂಬ ಉದ್ದೇಶದಿಂದಲೇ ನಿನ್ನನ್ನು ಸಾಯಿಸದೆ ಉಳಿಸಿದ್ದೇನೆ. <verse eid="EXO 9:16"/><verse number="17" style="v" sid="EXO 9:17"/>ನೀನು ಇನ್ನೂ ಅವರನ್ನು ಕಳುಹಿಸದೆ ನನ್ನ ಜನರಿಗೆ ವಿರೋಧವಾಗಿ ನಿನ್ನನ್ನು ನೀನೇ ಹೆಚ್ಚಿಸಿಕೊಳ್ಳುತ್ತೀಯೋ? <verse eid="EXO 9:17"/><verse number="18" style="v" sid="EXO 9:18"/>ಹಾಗಾದರೆ ನಾಳೆ ಇಷ್ಟು ಹೊತ್ತಿಗೆ ಮಹಾ ಕಠಿಣವಾದ ಆಲಿಕಲ್ಲಿನ ಮಳೆಯನ್ನು ಬೀಳುವಂತೆ ಮಾಡುವೆನು. ಅಂಥದ್ದು ಈಜಿಪ್ಟಿನಲ್ಲಿ, ಅದರ ರಾಜ್ಯವು ಸ್ಥಾಪಿತವಾದಂದಿನಿಂದ ಇಲ್ಲಿಯವರೆಗೂ ಆಗಿಲ್ಲ. <verse eid="EXO 9:18"/><verse number="19" style="v" sid="EXO 9:19"/>ಹೀಗಿರುವುದರಿಂದ ಯಾರನ್ನಾದರೂ ಕಳುಹಿಸಿ ನಿನ್ನ ಪಶುಗಳನ್ನೂ, ಹೊಲದಲ್ಲಿ ನಿನಗಿರುವವುಗಳನ್ನೂ ಭದ್ರಪಡಿಸು. ಏಕೆಂದರೆ ಮನೆಗಳಿಗೆ ಬಾರದೆ ಹೊಲದಲ್ಲಿ ಸಿಕ್ಕುವ ಮನುಷ್ಯರ ಮೇಲೆಯೂ ಪಶುಗಳ ಮೇಲೆಯೂ ಆಲಿಕಲ್ಲಿನ ಮಳೆಯು ಸುರಿದು ಕೊಲ್ಲುವುದು,’ ಎಂದು ಹೇಳು,” ಎಂದರು.<verse eid="EXO 9:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="EXO 9:20"/>ಆಗ ಫರೋಹನ ಸೇವಕರಲ್ಲಿ ಯೆಹೋವ ದೇವರ ವಾಕ್ಯಕ್ಕೆ ಭಯಪಟ್ಟವರೆಲ್ಲರೂ ತಮ್ಮ ದಾಸರನ್ನೂ ಪಶುಗಳನ್ನೂ ಮನೆಗಳಿಗೆ ಓಡಿ ಬರುವಂತೆ ಮಾಡಿದರು. <verse eid="EXO 9:20"/><verse number="21" style="v" sid="EXO 9:21"/>ಆದರೆ ಯೆಹೋವ ದೇವರ ವಾಕ್ಯಕ್ಕೆ ಮನಸ್ಸು ಕೊಡದವರು, ತಮ್ಮ ದಾಸರನ್ನೂ ಪಶುಗಳನ್ನೂ ಹೊಲದಲ್ಲಿ ಬಿಟ್ಟರು.<verse eid="EXO 9:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="EXO 9:22"/>ಆಗ ಯೆಹೋವ ದೇವರು ಮೋಶೆಗೆ, “ಆಕಾಶದ ಕಡೆಗೆ ನಿನ್ನ ಕೈಚಾಚು. ಈಜಿಪ್ಟ್ ದೇಶದಲ್ಲೆಲ್ಲಾ ಮನುಷ್ಯರ ಮೇಲೆಯೂ ಪಶುಗಳ ಮೇಲೆಯೂ ಮತ್ತು ಈಜಿಪ್ಟ್ ದೇಶದಲ್ಲಿ ಇರುವ ಎಲ್ಲಾ ಹೊಲದ ಬೆಳೆಯ ಮೇಲೆಯೂ ಆಲಿಕಲ್ಲಿನ ಮಳೆ ಸುರಿಯುವುದು,” ಎಂದು ಪ್ರಕಟಪಡಿಸಿದರು. <verse eid="EXO 9:22"/><verse number="23" style="v" sid="EXO 9:23"/>ಮೋಶೆಯು ಆಕಾಶದ ಕಡೆಗೆ ತನ್ನ ಕೋಲನ್ನು ಚಾಚಿದನು. ಆಗ ಯೆಹೋವ ದೇವರು ಗುಡುಗುಗಳನ್ನೂ ಆಲಿಕಲ್ಲಿನ ಮಳೆಯನ್ನೂ ಸುರಿಸಿದರು. ಸಿಡಿಲು ನೆಲಕ್ಕೆ ಬಡಿಯಿತು. ಸಿಡಿಲಿನ ಆರ್ಭಟದೊಂದಿಗೆ ಯೆಹೋವ ದೇವರು ಈಜಿಪ್ಟ್ ದೇಶದ ಮೇಲೆ ಆಲಿಕಲ್ಲಿನ ಮಳೆಯನ್ನು ಸುರಿಸಿದರು. <verse eid="EXO 9:23"/><verse number="24" style="v" sid="EXO 9:24"/>ಸಿಡಿಲಿನ ಆರ್ಭಟದೊಂದಿಗೆ ಕಠಿಣವಾದ ಆಲಿಕಲ್ಲಿನ ಮಳೆಯೂ ಸುರಿಯಿತು. ಈಜಿಪ್ಟ್ ಒಂದು ರಾಷ್ಟ್ರವಾದಂದಿನಿಂದ ಅಂಥ ಘೋರವಾದ ಆಲಿಕಲ್ಲಿನ ಮಳೆಯೂ ಆ ದೇಶದಲ್ಲಿ ಆಗಿರಲಿಲ್ಲ. <verse eid="EXO 9:24"/><verse number="25" style="v" sid="EXO 9:25"/>ಆ ಆಲಿಕಲ್ಲಿನ ಮಳೆಯು ಈಜಿಪ್ಟ್ ದೇಶದಲ್ಲೆಲ್ಲಾ ಮನುಷ್ಯರು ಮೊದಲುಗೊಂಡು ಪಶುಗಳವರೆಗೂ ಹೊಲದಲ್ಲಿ ಇದ್ದದ್ದನ್ನೆಲ್ಲಾ ಹಾಳುಮಾಡಿತು. ಹೊಲದ ಎಲ್ಲಾ ಸೊಪ್ಪನ್ನೂ ಹಾಳು ಮಾಡಿ, ಎಲ್ಲಾ ಮರಗಳನ್ನು ಮುರಿದುಹಾಕಿತು. <verse eid="EXO 9:25"/><verse number="26" style="v" sid="EXO 9:26"/>ಇಸ್ರಾಯೇಲರು ಇದ್ದ ಗೋಷೆನ್ ಪ್ರಾಂತದಲ್ಲಿ ಆಲಿಕಲ್ಲಿನ ಮಳೆಯು ಇರಲಿಲ್ಲ.<verse eid="EXO 9:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="EXO 9:27"/>ಆಗ ಫರೋಹನು ಮೋಶೆ ಆರೋನರನ್ನು ಕರೆಕಳುಹಿಸಿ ಅವರಿಗೆ, “ಈ ಸಲ ನಾನು ಪಾಪಮಾಡಿದ್ದೇನೆ, ಯೆಹೋವ ದೇವರು ನೀತಿವಂತನು. ಆದರೆ ನಾನೂ, ನನ್ನ ಜನರೂ ತಪ್ಪಿತಸ್ಥರು. <verse eid="EXO 9:27"/><verse number="28" style="v" sid="EXO 9:28"/>ಆದ್ದರಿಂದ ಈ ಬಲವಾದ ಗುಡುಗುಗಳೂ ಆಲಿಕಲ್ಲಿನ ಮಳೆಯೂ ಇನ್ನು ಸಾಕು. ಇವುಗಳು ನಿಂತುಹೋಗುವಂತೆ ಯೆಹೋವ ದೇವರನ್ನು ಬೇಡಿಕೊಳ್ಳಿರಿ, ನೀವು ಇನ್ನು ಇಲ್ಲಿ ಇರದಂತೆ ನಾನು ನಿಮ್ಮನ್ನು ಕಳುಹಿಸಿಬಿಡುವೆನು,” ಎಂದನು.<verse eid="EXO 9:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="EXO 9:29"/>ಮೋಶೆಯು ಅವನಿಗೆ, “ನಾನು ಪಟ್ಟಣವನ್ನು ಬಿಟ್ಟುಹೋದ ಕೂಡಲೇ, ಯೆಹೋವ ದೇವರ ಕಡೆಗೆ ನನ್ನ ಕೈಗಳನ್ನು ಚಾಚಿ ಪ್ರಾರ್ಥಿಸುವೆನು. ಭೂಮಿಯು ಯೆಹೋವ ದೇವರದೇ ಎಂದು ನೀನು ತಿಳಿದುಕೊಳ್ಳುವಂತೆ ಗುಡುಗುಗಳು ನಿಂತುಹೋಗುವುವು. ಆಲಿಕಲ್ಲಿನ ಮಳೆಯು ಇನ್ನು ಇರದು. <verse eid="EXO 9:29"/><verse number="30" style="v" sid="EXO 9:30"/>ಆದರೂ ನೀನು ಮತ್ತು ನಿನ್ನ ಅಧಿಕಾರಿಗಳು ದೇವರಾದ ಯೆಹೋವ ದೇವರಿಗೆ ಭಯಪಡುವುದಿಲ್ಲವೆಂದು ನಾನು ಬಲ್ಲೆನು,” ಎಂದನು.<verse eid="EXO 9:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="EXO 9:31"/>ಜವೆಗೋಧಿಗೆ ತೆನೆಯೂ ಅಗಸೆಯ ಮೊಗ್ಗುಗಳೂ ಇದ್ದುದರಿಂದ ಅಗಸೆಯೂ ಜವೆಗೋಧಿಯೂ ಹಾಳಾದವು. <verse eid="EXO 9:31"/><verse number="32" style="v" sid="EXO 9:32"/>ಆದರೆ ಗೋಧಿ ಮತ್ತು ಕಡಲೆ ಬೆಳೆದಿಲ್ಲವಾದ್ದರಿಂದ ಹಾಳಾಗಲಿಲ್ಲ.<verse eid="EXO 9:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="EXO 9:33"/>ತರುವಾಯ ಮೋಶೆಯು ಫರೋಹನನ್ನು ಬಿಟ್ಟು ಪಟ್ಟಣದ ಹೊರಗೆ ಬಂದಾಗ, ತನ್ನ ಕೈಗಳನ್ನು ಯೆಹೋವ ದೇವರ ಕಡೆಗೆ ಚಾಚಿದನು. ಆಗ ಗುಡುಗುಗಳೂ ಆಲಿಕಲ್ಲಿನ ಮಳೆಯೂ ನಿಂತುಹೋದವು. ಇನ್ನು ಮಳೆಯು ಭೂಮಿಯ ಮೇಲೆ ಬೀಳಲಿಲ್ಲ. <verse eid="EXO 9:33"/><verse number="34" style="v" sid="EXO 9:34"/>ಮಳೆ, ಆಲಿಕಲ್ಲಿನ ಮಳೆ, ಗುಡುಗುಗಳು ನಿಂತುಹೋದದ್ದನ್ನು ಫರೋಹನು ನೋಡಿದಾಗ, ಅವನು ಪುನಃ ಪಾಪಮಾಡಿದನು. ತನ್ನ ಅಧಿಕಾರಿಗಳ ಸಹಿತವಾಗಿ ತನ್ನ ಹೃದಯವನ್ನು ಕಠಿಣ ಮಾಡಿಕೊಂಡನು. <verse eid="EXO 9:34"/><verse number="35" style="v" sid="EXO 9:35"/>ಫರೋಹನ ಹೃದಯವು ಕಠಿಣವಾಯಿತು. ಯೆಹೋವ ದೇವರು ಮೋಶೆಗೆ ಹೇಳಿದಂತೆ, ಅವನು ಇಸ್ರಾಯೇಲರನ್ನು ಕಳುಹಿಸಲೇ ಇಲ್ಲ.<verse eid="EXO 9:35"/></para>
  <chapter eid="EXO 9"/>
  <chapter number="10" style="c" sid="EXO 10"/>
  <para style="s1">ಮಿಡತೆಗಳ ಉಪದ್ರವ</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 10:1"/>ತರುವಾಯ ಯೆಹೋವ ದೇವರು ಮೋಶೆಗೆ, “ಫರೋಹನ ಬಳಿಗೆ ಹೋಗು, ಏಕೆಂದರೆ ನಾನು ನನ್ನ ಅದ್ಭುತ ಸೂಚಕಕಾರ್ಯಗಳನ್ನು ಅವನ ಮುಂದೆ ತೋರಿಸುವುದಕ್ಕಾಗಿ ಅವನ ಹೃದಯವನ್ನೂ ಅವನ ಅಧಿಕಾರಿಗಳ ಹೃದಯಗಳನ್ನೂ ಕಠಿಣ ಮಾಡಿದ್ದೇನೆ. <verse eid="EXO 10:1"/><verse number="2" style="v" sid="EXO 10:2"/>ಇದಲ್ಲದೆ ನೀನು ನಿನ್ನ ಮಕ್ಕಳಿಗೂ ನಿನ್ನ ಮಕ್ಕಳ ಮಕ್ಕಳಿಗೂ ನಾನು ಈಜಿಪ್ಟಿನಲ್ಲಿ ಏನು ಮಾಡಿದೆನೆಂದೂ, ನಾನೇ ಯೆಹೋವ ದೇವರೆಂದೂ ನೀವು ತಿಳಿದುಕೊಳ್ಳುವಂತೆ ನಾನು ಅವರ ಮಧ್ಯದಲ್ಲಿ ಮಾಡಿದ ಅದ್ಭುತ ಸೂಚಕಕಾರ್ಯಗಳನ್ನು ತಿಳಿಸಬೇಕು,” ಎಂದು ಹೇಳಿದರು.<verse eid="EXO 10:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="EXO 10:3"/>ಮೋಶೆ ಆರೋನರು ಫರೋಹನ ಬಳಿಗೆ ಬಂದು ಅವನಿಗೆ, “ಹಿಬ್ರಿಯರ ದೇವರಾದ ಯೆಹೋವ ದೇವರು ಹೀಗೆ ಹೇಳುತ್ತಾರೆ, ‘ನನ್ನ ಸನ್ನಿಧಿಯಲ್ಲಿ ನೀನು ಎಷ್ಟು ಕಾಲ ತಲೆ ತಗ್ಗಿಸದಿರುವೆ? ನನ್ನನ್ನು ಆರಾಧಿಸುವಂತೆ ನನ್ನ ಜನರನ್ನು ಹೋಗಗೊಡಿಸು. <verse eid="EXO 10:3"/><verse number="4" style="v" sid="EXO 10:4"/>ನೀನು ನನ್ನ ಜನರನ್ನು ಹೋಗಗೊಡಿಸದಿದ್ದರೆ, ನಾಳೆಯೇ ನಾನು ನಿನ್ನ ರಾಜ್ಯದಲ್ಲಿ ಮಿಡತೆಗಳನ್ನು ಬರಮಾಡುವೆನು. <verse eid="EXO 10:4"/><verse number="5" style="v" sid="EXO 10:5"/>ಒಬ್ಬನು ಭೂಮಿಯನ್ನು ಕಾಣುವುದಕ್ಕಾಗದಷ್ಟು ಅವು ಭೂಮಿಯನ್ನೆಲ್ಲಾ ಮುಚ್ಚಿಕೊಳ್ಳುವುವು. ಇದಲ್ಲದೆ ಅವು ಆಲಿಕಲ್ಲಿನ ಮಳೆಯಿಂದ ಹಾಳಾಗದೆ ನಿಮಗಾಗಿ ಉಳಿದಿರುವುದೆಲ್ಲವನ್ನೂ, ಹೊಲಗಳಲ್ಲಿ ಚಿಗುರಿರುವ ಪ್ರತಿಯೊಂದು ಮರವನ್ನೂ ತಿಂದುಬಿಡುವುವು. <verse eid="EXO 10:5"/><verse number="6" style="v" sid="EXO 10:6"/>ಅವು ನಿನ್ನ ಮನೆಗಳಲ್ಲಿಯೂ ನಿನ್ನ ಅಧಿಕಾರಿಗಳ ಮನೆಗಳಲ್ಲಿಯೂ ಈಜಿಪ್ಟಿನ ಎಲ್ಲಾ ಮನೆಗಳಲ್ಲಿಯೂ ತುಂಬಿಕೊಳ್ಳುವುವು. ನಿನ್ನ ತಂದೆ ಅಲ್ಲದೆ ನಿನ್ನ ತಂದೆಯ ತಂದೆಗಳಾಗಲಿ, ಭೂಮಿಯ ಮೇಲೆ ಇದ್ದಂದಿನಿಂದ ಇಂದಿನವರೆಗೂ ಅಂಥ ಮಿಡತೆಯ ದಂಡನ್ನು ಯಾರೂ ನೋಡಿಲ್ಲ,’ ” ಎಂದು ಮೋಶೆ ಹೇಳಿ ಫರೋಹನ ಬಳಿಯಿಂದ ಹೊರಟುಹೋದನು.<verse eid="EXO 10:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="EXO 10:7"/>ಫರೋಹನ ಅಧಿಕಾರಿಗಳು ಅವನಿಗೆ, “ಇವನು ಎಷ್ಟು ಕಾಲ ನಮಗೆ ಉರುಲಾಗಿರಬೇಕು. ಆ ಜನರು ತಮ್ಮ ದೇವರಾದ ಯೆಹೋವ ದೇವರಿಗೆ ಆರಾಧನೆ ಮಾಡುವಂತೆ ಅವರನ್ನು ಕಳುಹಿಸಿಬಿಡು. ಈಜಿಪ್ಟ್ ನಾಶವಾಯಿತೆಂದು ನಿನಗೆ ಇನ್ನೂ ತಿಳಿಯಲಿಲ್ಲವೋ?” ಎಂದರು.<verse eid="EXO 10:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="EXO 10:8"/>ಆದುದರಿಂದ ಫರೋಹನು ಮೋಶೆ ಮತ್ತು ಆರೋನರನ್ನು ಪುನಃ ಕರೆಯಿಸಿ ಅವರಿಗೆ, “ನೀವು ಹೋಗಿ ನಿಮ್ಮ ದೇವರಾದ ಯೆಹೋವ ದೇವರಿಗೆ ಆರಾಧನೆ ಮಾಡಿರಿ, ಆದರೆ ಹೋಗುವವರು ಯಾರ‍್ಯಾರು?” ಎಂದು ಕೇಳಿದನು.<verse eid="EXO 10:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="EXO 10:9"/>ಅದಕ್ಕೆ ಮೋಶೆಯು ಅವನಿಗೆ, “ನಮ್ಮ ಚಿಕ್ಕವರನ್ನೂ ವೃದ್ಧರನ್ನೂ ಕರೆದುಕೊಂಡು ಹೋಗುತ್ತೇವೆ. ಇದಲ್ಲದೆ ನಮ್ಮ ಪುತ್ರಪುತ್ರಿಯರನ್ನೂ ನಮ್ಮ ದನಕುರಿಗಳನ್ನೂ ತೆಗೆದುಕೊಂಡು ಹೋಗುತ್ತೇವೆ. ಏಕೆಂದರೆ ನಾವು ಯೆಹೋವ ದೇವರಿಗಾಗಿ ಹಬ್ಬವನ್ನು ಮಾಡಬೇಕು,” ಎಂದನು.<verse eid="EXO 10:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="EXO 10:10"/>ಫರೋಹನು ಅವರಿಗೆ, “ನಾನು ನಿಮ್ಮ ಮಡದಿ ಮಕ್ಕಳನ್ನೂ ಕಳುಹಿಸಿಕೊಟ್ಟು, ಯೆಹೋವ ದೇವರು ನಿಮ್ಮ ಸಂಗಡ ಇರಲಿ ಎಂದು ನಾನು ಹೇಳಬಯಸುವಿರೋ? ಇಲ್ಲಾ! ನೀವು ಕೇಡು ಮಾಡಲು ನಿರ್ಧರಿಸಿರುವಿರಿ? <verse eid="EXO 10:10"/><verse number="11" style="v" sid="EXO 10:11"/>ಹಾಗೆ ಮಾಡದೆ, ಗಂಡಸರಾದ ನೀವು ಮಾತ್ರ ಹೋಗಿ ಯೆಹೋವ ದೇವರಿಗೆ ಆರಾಧನೆ ಮಾಡಿರಿ, ಏಕೆಂದರೆ ಇದನ್ನೇ ನೀವು ಬಯಸಿದಿರಿ,” ಎಂದನು. ತರುವಾಯ ಫರೋಹನು ಅವರನ್ನು ತನ್ನ ಸನ್ನಿಧಿಯಿಂದ ಹೊರಡಿಸಿಬಿಟ್ಟನು.<verse eid="EXO 10:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="EXO 10:12"/>ಆಗ ಯೆಹೋವ ದೇವರು ಮೋಶೆಗೆ, “ಮಿಡತೆಗಳಿಗಾಗಿ ನಿನ್ನ ಕೈಯನ್ನು ಈಜಿಪ್ಟಿನ ಮೇಲೆ ಚಾಚು. ಅವು ಈಜಿಪ್ಟಿನ ಮೇಲೆ ಬಂದು, ಆಲಿಕಲ್ಲಿನ ಮಳೆಯು ದೇಶದಲ್ಲಿ ಉಳಿಸಿದ ಹಸುರಾದದ್ದನ್ನೆಲ್ಲಾ ತಿಂದುಬಿಡಲಿ,” ಎಂದರು.<verse eid="EXO 10:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="EXO 10:13"/>ಮೋಶೆಯು ತನ್ನ ಕೋಲನ್ನು ಈಜಿಪ್ಟ್ ದೇಶದ ಮೇಲೆ ಚಾಚಿದಾಗ, ಯೆಹೋವ ದೇವರು ಹಗಲಲ್ಲೂ ರಾತ್ರಿಯಲ್ಲೂ ಪೂರ್ವದಿಕ್ಕಿನಿಂದ ಗಾಳಿಯನ್ನು ಬರಮಾಡಿದರು. ಉದಯವಾದಾಗ ಆ ಗಾಳಿಯು ಮಿಡತೆಗಳನ್ನು ಅಟ್ಟಿಕೊಂಡು ಬಂದಿತು. <verse eid="EXO 10:13"/><verse number="14" style="v" sid="EXO 10:14"/>ಹೀಗೆ ಮಿಡತೆಗಳ ಉಪದ್ರವ ಈಜಿಪ್ಟ್ ದೇಶದಲ್ಲೆಲ್ಲಾ ಬಂದು, ಈಜಿಪ್ಟಿನ ಎಲ್ಲಾ ಮೇರೆಗಳಲ್ಲಿ ದೊಡ್ಡ ಸಮೂಹವಾಗಿ ಸೇರಿಕೊಂಡವು. ಅವುಗಳಂಥವು ಹಿಂದೆ ಎಂದಿಗೂ ಇರಲಿಲ್ಲ, ಅನಂತರವೂ ಇರಲಾರವು. <verse eid="EXO 10:14"/><verse number="15" style="v" sid="EXO 10:15"/>ಏಕೆಂದರೆ ಅವು ಭೂಮಿಯನ್ನೆಲ್ಲಾ ಮುತ್ತಿಕೊಂಡದ್ದರಿಂದ, ಆ ದೇಶದಲ್ಲಿ ಕತ್ತಲಾಯಿತು. ಅವು ಭೂಮಿಯ ಎಲ್ಲಾ ಸೊಪ್ಪನ್ನೂ, ಆಲಿಕಲ್ಲಿನ ಮಳೆಯು ಉಳಿಸಿದ ಎಲ್ಲಾ ಫಲವನ್ನೂ ತಿಂದುಬಿಟ್ಟವು. ಮರಗಳಲ್ಲಾಗಲಿ, ಹೊಲದ ಗಿಡಗಳಲ್ಲಾಗಲಿ ಹಸುರಾದದ್ದು ಈಜಿಪ್ಟ್ ದೇಶದಲ್ಲೆಲ್ಲಿಯೂ ಉಳಿಯಲಿಲ್ಲ.<verse eid="EXO 10:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="EXO 10:16"/>ಆಗ ಫರೋಹನು ಮೋಶೆ ಆರೋನರನ್ನು ತ್ವರೆಯಾಗಿ ಕರೆಯಿಸಿ ಅವರಿಗೆ, “ನಾನು ನಿಮ್ಮ ದೇವರಾದ ಯೆಹೋವ ದೇವರಿಗೂ, ನಿಮಗೂ ವಿರೋಧವಾಗಿ ಪಾಪಮಾಡಿದ್ದೇನೆ. <verse eid="EXO 10:16"/><verse number="17" style="v" sid="EXO 10:17"/>ಹೀಗಿರುವುದರಿಂದ ಈಗ ಒಂದೇ ಸಾರಿ ಮಾತ್ರ ನನ್ನ ಪಾಪವನ್ನು ಕ್ಷಮಿಸಬೇಕು. ಈ ಮರಣಕರವಾದ ಉಪದ್ರವವನ್ನು ನನ್ನಿಂದ ತೊಲಗಿಸುವಂತೆ ನಿಮ್ಮ ದೇವರಾದ ಯೆಹೋವ ದೇವರನ್ನು ಬೇಡಿಕೊಳ್ಳಿರಿ,” ಎಂದನು.<verse eid="EXO 10:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="EXO 10:18"/>ಆಗ ಮೋಶೆ ಫರೋಹನನ್ನು ಬಿಟ್ಟು ಹೋಗಿ ಯೆಹೋವ ದೇವರನ್ನು ಬೇಡಿಕೊಂಡನು. <verse eid="EXO 10:18"/><verse number="19" style="v" sid="EXO 10:19"/>ಯೆಹೋವ ದೇವರು ಬಲವಾದ ಪಶ್ಚಿಮ ಗಾಳಿಯನ್ನು ಬೀಸುವಂತೆ ಮಾಡಿದರು. ಅದು ಮಿಡತೆಗಳನ್ನು ಎತ್ತಿಕೊಂಡು ಹೋಗಿ ಕೆಂಪು ಸಮುದ್ರದಲ್ಲಿ ಹಾಕಿತು. ಈಜಿಪ್ಟ್ ಮೇರೆಗಳಲ್ಲೆಲ್ಲಾ ಒಂದು ಮಿಡತೆಯಾದರೂ ಉಳಿಯಲಿಲ್ಲ. <verse eid="EXO 10:19"/><verse number="20" style="v" sid="EXO 10:20"/>ಆದರೆ ಯೆಹೋವ ದೇವರು ಫರೋಹನ ಹೃದಯವನ್ನು ಕಠಿಣ ಮಾಡಿದ್ದರಿಂದ, ಅವನು ಇಸ್ರಾಯೇಲರನ್ನು ಕಳುಹಿಸದೆ ಹೋದನು.<verse eid="EXO 10:20"/></para>
  <para style="s1">ಕಾರ್ಗತ್ತಲಿನ ಉಪದ್ರವ</para>
  <para style="p">
    <verse number="21" style="v" sid="EXO 10:21"/>ಆಗ ಯೆಹೋವ ದೇವರು ಮೋಶೆಗೆ, “ಈಜಿಪ್ಟ್ ದೇಶದಲ್ಲಿ ಕತ್ತಲೆ ಕವಿದು ಗಾಡಾಂಧಕಾರವಾಗುವಂತೆ ನಿನ್ನ ಕೈಯನ್ನು ಆಕಾಶದ ಕಡೆಗೆ ಚಾಚು,” ಎಂದರು. <verse eid="EXO 10:21"/><verse number="22" style="v" sid="EXO 10:22"/>ಮೋಶೆಯು ಆಕಾಶದ ಕಡೆಗೆ ಕೈಚಾಚಿದಾಗ, ಈಜಿಪ್ಟ್ ದೇಶದಲ್ಲೆಲ್ಲಾ ಮೂರು ದಿನಗಳವರೆಗೆ ಘೋರವಾದ ಕತ್ತಲೆ ಕವಿಯಿತು. <verse eid="EXO 10:22"/><verse number="23" style="v" sid="EXO 10:23"/>ಮೂರು ದಿನಗಳವರೆಗೆ ಅವರು ಒಬ್ಬರನ್ನೊಬ್ಬರು ನೋಡಲಾಗಲಿಲ್ಲ. ಯಾರೂ ತಮ್ಮ ಸ್ಥಳವನ್ನು ಬಿಟ್ಟು ಏಳಲಿಲ್ಲ. ಆದರೆ ಇಸ್ರಾಯೇಲರಿಗೆಲ್ಲಾ ಅವರು ವಾಸಿಸುವ ಸ್ಥಳದಲ್ಲಿ ಅವರಿಗೆ ಬೆಳಕಿತ್ತು.<verse eid="EXO 10:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="EXO 10:24"/>ಆಗ ಫರೋಹನು ಮೋಶೆಯನ್ನು ಕರೆಯಿಸಿ ಅವನಿಗೆ, “ನೀವು ಹೋಗಿ ಯೆಹೋವ ದೇವರಿಗೆ ಆರಾಧನೆ ಮಾಡಿರಿ. ನಿಮ್ಮ ಕುರಿದನಗಳು ಮಾತ್ರ ಇಲ್ಲಿರಲಿ. ನಿಮ್ಮ ಮಡದಿ ಮಕ್ಕಳೂ ನಿಮ್ಮ ಸಂಗಡ ಹೋಗಲಿ,” ಎಂದನು.<verse eid="EXO 10:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="EXO 10:25"/>ಅದಕ್ಕೆ ಮೋಶೆಯು ಅವನಿಗೆ, “ನಮ್ಮ ದೇವರಾದ ಯೆಹೋವ ದೇವರಿಗೆ ಅರ್ಪಿಸುವುದಕ್ಕಾಗಿ ಯಜ್ಞಗಳನ್ನೂ ದಹನಬಲಿಗಳನ್ನೂ ತೆಗೆದುಕೊಂಡು ಹೋಗಲು ಅಪ್ಪಣೆಬೇಕು. <verse eid="EXO 10:25"/><verse number="26" style="v" sid="EXO 10:26"/>ನಮ್ಮ ಪಶುಪ್ರಾಣಿಗಳನ್ನೂ ನಾವು ನಮ್ಮ ಸಂಗಡ ತೆಗೆದುಕೊಂಡು ಹೋಗುವೆವು. ಒಂದು ಗೊರಸನ್ನೂ ಬಿಡಲಾರೆವು. ಏಕೆಂದರೆ ನಮ್ಮ ದೇವರಾದ ಯೆಹೋವ ದೇವರಿಗೆ ಆರಾಧನೆ ಮಾಡುವುದಕ್ಕೆ ಅವುಗಳಿಂದಲೇ ಬಲಿ ಅರ್ಪಿಸಬೇಕು. ಯೆಹೋವ ದೇವರಿಗೆ ಯಾವ ಅರ್ಪಣೆ ಮಾಡಬೇಕೆಂಬುದು ಅಲ್ಲಿಗೆ ಹೋಗುವವರೆಗೂ ನಮಗೆ ತಿಳಿಯದು,” ಎಂದನು.<verse eid="EXO 10:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="EXO 10:27"/>ಆದರೆ ಯೆಹೋವ ದೇವರು ಫರೋಹನ ಹೃದಯವನ್ನು ಕಠಿಣ ಮಾಡಿದ್ದರಿಂದ, ಅವನು ಅವರನ್ನು ಕಳುಹಿಸಲಾರದೆ ಹೋದನು. <verse eid="EXO 10:27"/><verse number="28" style="v" sid="EXO 10:28"/>ಆಗ ಫರೋಹನು ಮೋಶೆಗೆ, “ನನ್ನನ್ನು ಬಿಟ್ಟು ಹೋಗು. ಇನ್ನು ನನ್ನ ಮುಖವನ್ನು ನೋಡದಂತೆ ಎಚ್ಚರ. ಏಕೆಂದರೆ ನೀನು ನನ್ನ ಮುಖವನ್ನು ನೋಡಿದ ದಿನದಲ್ಲಿ ಸಾಯುವೆ,” ಎಂದನು.<verse eid="EXO 10:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="EXO 10:29"/>ಮೋಶೆಯು ಅವನಿಗೆ, “ನೀನು ಸರಿಯಾಗಿ ಹೇಳಿದ್ದೀ. ಇನ್ನು ಮೇಲೆ ನಾನು ನಿನ್ನ ಮುಖವನ್ನು ನೋಡುವುದಿಲ್ಲ,” ಎಂದನು.<verse eid="EXO 10:29"/></para>
  <chapter eid="EXO 10"/>
  <chapter number="11" style="c" sid="EXO 11"/>
  <para style="s1">ಚೊಚ್ಚಲು ಮಕ್ಕಳ ಮೇಲೆ ಉಪದ್ರವ</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 11:1"/>ಯೆಹೋವ ದೇವರು ಮೋಶೆಗೆ, “ಇನ್ನು ಒಂದೇ ಉಪದ್ರವವನ್ನು ಫರೋಹನ ಮೇಲೆಯೂ, ಈಜಿಪ್ಟ್ ಮೇಲೆಯೂ ಬರಮಾಡುವೆನು. ಆಮೇಲೆ ಅವನು ಇಲ್ಲಿಂದ ಕಳುಹಿಸುವನು. ಇಲ್ಲಿಂದ ನಿಮ್ಮನ್ನು ನಿಶ್ಚಯವಾಗಿ ಬಲವಂತದಿಂದ ಎಲ್ಲರನ್ನೂ ಕಳುಹಿಸಿಬಿಡುವನು. <verse eid="EXO 11:1"/><verse number="2" style="v" sid="EXO 11:2"/>ಆದ್ದರಿಂದ ಸ್ತ್ರೀಪುರುಷರೆಲ್ಲರು ತನ್ನ ನೆರೆಯವನಿಂದಲೂ ಬೆಳ್ಳಿಬಂಗಾರ ಒಡವೆಗಳನ್ನು ಕೇಳಿಕೊಳ್ಳಬೇಕೆಂದು ಇಸ್ರಾಯೇಲರಿಗೆ ಹೇಳು,” ಎಂದು ಹೇಳಿದರು. <verse eid="EXO 11:2"/><verse number="3" style="v" sid="EXO 11:3"/>ಇದಲ್ಲದೆ ಯೆಹೋವ ದೇವರು ಈಜಿಪ್ಟಿನವರ ದೃಷ್ಟಿಯಲ್ಲಿ ಜನರಿಗೆ ದಯೆ ದೊರಕುವಂತೆ ಮಾಡಿದರು. ಇದಲ್ಲದೆ ಮೋಶೆಯು ಈಜಿಪ್ಟ್ ದೇಶದಲ್ಲಿಯೂ ಫರೋಹನ ಅಧಿಕಾರಿಗಳ ದೃಷ್ಟಿಯಲ್ಲಿಯೂ ಜನರ ದೃಷ್ಟಿಯಲ್ಲಿಯೂ ಬಹಳ ಗೌರವ ಹೊಂದಿದನು.<verse eid="EXO 11:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="EXO 11:4"/>ಆಗ ಮೋಶೆಯು ಫರೋಹನಿಗೆ, “ಯೆಹೋವ ದೇವರು ಹೀಗೆ ಹೇಳುತ್ತಾರೆ: ‘ಸುಮಾರು ಮಧ್ಯರಾತ್ರಿಯಲ್ಲಿ ನಾನು ಈಜಿಪ್ಟಿನ ಮಧ್ಯದಲ್ಲಿ ಹಾದು ಹೋಗುವೆನು. <verse eid="EXO 11:4"/><verse number="5" style="v" sid="EXO 11:5"/>ಆಗ ಈಜಿಪ್ಟ್ ದೇಶದ ಚೊಚ್ಚಲ ಮಕ್ಕಳು ಅಂದರೆ, ಸಿಂಹಾಸನದ ಮೇಲೆ ಕೂತಿರುವ ಫರೋಹನ ಚೊಚ್ಚಲ ಮಗನು ಮೊದಲುಗೊಂಡು ಬೀಸುವ ಕಲ್ಲನ್ನು ಹಿಡಿದಿರುವ ದಾಸಿಯ ಚೊಚ್ಚಲ ಮಗನವರೆಗೆ ಮತ್ತು ಪಶುಗಳಲ್ಲಿ ಚೊಚ್ಚಲಾದವುಗಳೆಲ್ಲವೂ ಸಾಯುವುವು. <verse eid="EXO 11:5"/><verse number="6" style="v" sid="EXO 11:6"/>ಈಜಿಪ್ಟ್ ದೇಶದಲ್ಲೆಲ್ಲಾ ದೊಡ್ಡ ಗೋಳಾಟವಿರುವುದು. ಅಂಥಾ ಗೋಳಾಟವು ಹಿಂದೆಯೂ ಇರಲಿಲ್ಲ, ಇನ್ನು ಮುಂದೆಯೂ ಇರುವುದಿಲ್ಲ. <verse eid="EXO 11:6"/><verse number="7" style="v" sid="EXO 11:7"/>ಆದರೆ ಯೆಹೋವ ದೇವರು ಈಜಿಪ್ಟಿನವರಿಗೂ, ಇಸ್ರಾಯೇಲರಿಗೂ ಮಧ್ಯದಲ್ಲಿಟ್ಟಿರುವ ವ್ಯತ್ಯಾಸವನ್ನು ನೀವು ತಿಳುಕೊಳ್ಳುವಂತೆ, ಇಸ್ರಾಯೇಲಿನವರ ವಿರುದ್ಧ ಇಲ್ಲವೆ ಪ್ರಾಣಿಗಳ ವಿರುದ್ಧ ಒಂದು ನಾಯಿ ಸಹ ಬೊಗಳುವುದಿಲ್ಲ.’ <verse eid="EXO 11:7"/><verse number="8" style="v" sid="EXO 11:8"/>ಆಗ ನಿನ್ನ ದಾಸರಾದ ಇವರೆಲ್ಲರೂ ನನ್ನ ಬಳಿಗೆ ಬಂದು, ನನಗೆ ಅಡ್ಡಬಿದ್ದು, ನನಗೆ ನೀನೂ, ನಿನ್ನನ್ನು ಹಿಂಬಾಲಿಸುವ ಜನರೆಲ್ಲರೂ, ‘ಹೊರಗೆ ಹೋಗಿರಿ,’ ಎಂದು ಹೇಳುವರು. ತರುವಾಯ ನಾನು ಹೊರಗೆ ಹೋಗುವೆನು,” ಎಂದು ಹೇಳಿ ಮೋಶೆಯು ಕೋಪಾವೇಶವುಳ್ಳವನಾಗಿ ಫರೋಹನ ಬಳಿಯಿಂದ ಹೊರಟುಹೋದನು.<verse eid="EXO 11:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="EXO 11:9"/>ಆದರೆ ಯೆಹೋವ ದೇವರು ಮೋಶೆಗೆ, “ನನ್ನ ಅದ್ಭುತಗಳು ಈಜಿಪ್ಟ್ ದೇಶದಲ್ಲಿ ಹೆಚ್ಚಾಗುವಂತೆ ಫರೋಹನು ನಿಮ್ಮ ಮಾತನ್ನು ಕೇಳುವುದಿಲ್ಲ,” ಎಂದರು. <verse eid="EXO 11:9"/><verse number="10" style="v" sid="EXO 11:10"/>ಈ ಅದ್ಭುತಗಳನ್ನೆಲ್ಲಾ ಮೋಶೆ ಆರೋನರು ಫರೋಹನ ಮುಂದೆ ಮಾಡಿದರು. ಆದರೆ ಯೆಹೋವ ದೇವರು ಫರೋಹನ ಹೃದಯವನ್ನು ಕಠಿಣ ಮಾಡಿದ್ದರಿಂದ, ಅವನು ಇಸ್ರಾಯೇಲರನ್ನು ತನ್ನ ದೇಶದೊಳಗಿಂದ ಕಳುಹಿಸಲಿಲ್ಲ.<verse eid="EXO 11:10"/></para>
  <chapter eid="EXO 11"/>
  <chapter number="12" style="c" sid="EXO 12"/>
  <para style="s1">ಪಸ್ಕಹಬ್ಬ ಮತ್ತು ಹುಳಿಯಿಲ್ಲದ ರೊಟ್ಟಿ</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 12:1"/>ಯೆಹೋವ ದೇವರು ಈಜಿಪ್ಟಿನಲ್ಲಿ ಮೋಶೆ ಆರೋನರ ಸಂಗಡ ಮಾತನಾಡಿ ಹೇಳಿದ್ದೇನೆಂದರೆ, <verse eid="EXO 12:1"/><verse number="2" style="v" sid="EXO 12:2"/>“ಎಲ್ಲಾ ಮಾಸಗಳಲ್ಲಿ ಇದೇ ನಿಮಗೆ ಆದಿಮಾಸವಾಗಿರಬೇಕು. ಇದು ನಿಮಗೆ ವರುಷದ ಮೊದಲನೆಯ ತಿಂಗಳಾಗಿರಬೇಕು. <verse eid="EXO 12:2"/><verse number="3" style="v" sid="EXO 12:3"/>ಇಸ್ರಾಯೇಲ್ ಸಭೆಗೆಲ್ಲಾ ನೀವು ಹೇಳಬೇಕಾದದ್ದೇನೆಂದರೆ, ಈ ತಿಂಗಳಿನ ಹತ್ತನೆಯ ದಿನದಲ್ಲಿ ಅವರು ತಮಗೆ ಪ್ರತಿ ಗೋತ್ರಗಳ ಪ್ರತಿಯೊಂದು ಕುಟುಂಬಕ್ಕೆ ಒಂದರಂತೆ ಕುರಿಮರಿಯನ್ನು ತೆಗೆದುಕೊಳ್ಳಬೇಕು. <verse eid="EXO 12:3"/><verse number="4" style="v" sid="EXO 12:4"/>ಆ ಕುರಿಮರಿಯನ್ನು ಪೂರ್ತಿಯಾಗಿ ತಿನ್ನುವುದಕ್ಕೆ ಕುಟುಂಬವು ಚಿಕ್ಕದಾಗಿದ್ದರೆ, ತನ್ನ ಮನೆಗೆ ಸಮೀಪವಾಗಿರುವ ತನ್ನ ನೆರೆಯವನ ಕುಟುಂಬದಲ್ಲಿ ಲೆಕ್ಕನೋಡಿ ಅವರೊಂದಿಗೆ ಪಾಲು ಹೊಂದಲಿ. ಒಬ್ಬೊಬ್ಬನು ತಿನ್ನುವ ಅಳತೆಯ ಪ್ರಕಾರ ಕುರಿಮರಿಯನ್ನು ತೆಗೆದುಕೊಳ್ಳಲಿ. <verse eid="EXO 12:4"/><verse number="5" style="v" sid="EXO 12:5"/>ನೀವು ಆಯ್ದುಕೊಳ್ಳುವ ಕುರಿಮರಿಯು ದೋಷರಹಿತವಾಗಿರುವ ಒಂದು ವರ್ಷದ ಗಂಡುಮರಿಯಾಗಿರಬೇಕು. ನೀವು ಕುರಿಗಳಿಂದಾಗಲಿ, ಆಡುಗಳಿಂದಾಗಲಿ ತೆಗೆದುಕೊಳ್ಳಬಹುದು. <verse eid="EXO 12:5"/><verse number="6" style="v" sid="EXO 12:6"/>ಈ ತಿಂಗಳಿನ ಹದಿನಾಲ್ಕನೆಯ ದಿನದವರೆಗೆ ಅವುಗಳನ್ನು ಇಟ್ಟುಕೊಳ್ಳಬೇಕು. ತರುವಾಯ ಸಂಜೆಯಲ್ಲಿ ಇಸ್ರಾಯೇಲಿನ ಜನಾಂಗದವರೆಲ್ಲರೂ ಅವುಗಳನ್ನು ವಧಿಸಬೇಕು. <verse eid="EXO 12:6"/><verse number="7" style="v" sid="EXO 12:7"/>ಅವರು ರಕ್ತದಲ್ಲಿ ಸ್ವಲ್ಪ ತೆಗೆದು, ಕುರಿಮರಿಯ ಮಾಂಸವನ್ನು ಭೋಜನಮಾಡುವ ಮನೆಗಳ ಬಾಗಿಲಿನ ನಿಲುವು ಪಟ್ಟಿಗಳಿಗೂ, ಮೇಲಿನ ಪಟ್ಟಿಗೂ ಹಚ್ಚಬೇಕು. <verse eid="EXO 12:7"/><verse number="8" style="v" sid="EXO 12:8"/>ಆ ರಾತ್ರಿಯಲ್ಲಿಯೇ ಮಾಂಸವನ್ನು ಸುಟ್ಟು, ಅದನ್ನೂ, ಹುಳಿಯಿಲ್ಲದ ರೊಟ್ಟಿಗಳನ್ನೂ ಕಹಿಯಾದ ಪಲ್ಯಗಳ ಸಂಗಡ ತಿನ್ನಬೇಕು. <verse eid="EXO 12:8"/><verse number="9" style="v" sid="EXO 12:9"/>ಅದರಲ್ಲಿ ಯಾವುದನ್ನೂ ಹಸಿಯಾದದ್ದನ್ನಾಗಲಿ, ನೀರಿನಲ್ಲಿ ಬೇಯಿಸಿಯಾಗಲಿ ತಿನ್ನದೆ, ಅದರ ತಲೆ, ತೊಡೆ, ಒಳಗಿನವುಗಳ ಸಹಿತವಾಗಿ ಬೆಂಕಿಯಲ್ಲಿ ಸುಟ್ಟೇ ಅದನ್ನು ತಿನ್ನಬೇಕು. <verse eid="EXO 12:9"/><verse number="10" style="v" sid="EXO 12:10"/>ಅದರಲ್ಲಿ ಬೆಳಗಿನವರೆಗೆ ಏನನ್ನೂ ಉಳಿಸಬಾರದು. ಬೆಳಗಿನವರೆಗೆ ಅದರಲ್ಲಿ ಉಳಿದದ್ದನ್ನು ಬೆಂಕಿಯಿಂದ ಸುಟ್ಟುಬಿಡಬೇಕು. <verse eid="EXO 12:10"/><verse number="11" style="v" sid="EXO 12:11"/>ನೀವು ಅದನ್ನು ತಿನ್ನತಕ್ಕ ರೀತಿ ಇದೇ: ನೀವು ನಿಮ್ಮ ನಡುಕಟ್ಟಿಕೊಂಡು, ಕೆರಮೆಟ್ಟಿಕೊಂಡು ಊರುಗೋಲನ್ನು ಹಿಡಿದುಕೊಂಡು ತ್ವರೆಯಾಗಿ ಅದನ್ನು ತಿನ್ನಬೇಕು, ಅದು ಯೆಹೋವ ದೇವರ ಪಸ್ಕವಾಗಿದೆ.<verse eid="EXO 12:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="EXO 12:12"/>“ಏಕೆಂದರೆ ನಾನು ಈ ರಾತ್ರಿ ಈಜಿಪ್ಟ್ ದೇಶದಲ್ಲಿರುವ ಎಲ್ಲಾ ಮನುಷ್ಯರಲ್ಲಿಯೂ, ಪಶುಗಳಲ್ಲಿಯೂ ಇರುವ ಚೊಚ್ಚಲಾದವುಗಳನ್ನು ಸಂಹರಿಸುವೆನು. ಈಜಿಪ್ಟಿನ ದೇವರುಗಳಿಗೆಲ್ಲಾ ನಾನು ನ್ಯಾಯತೀರಿಸುವೆನು. ನಾನೇ ಯೆಹೋವ ದೇವರು. <verse eid="EXO 12:12"/><verse number="13" style="v" sid="EXO 12:13"/>ಆದರೆ ನೀವು ಇರುವ ಎಲ್ಲಾ ಮನೆಗಳ ಮೇಲೆ ರಕ್ತವು ನಿಮಗೆ ಗುರುತಾಗಿರುವುದು. ಆ ರಕ್ತವನ್ನು ನಾನು ನೋಡುವಾಗ, ನಿಮ್ಮನ್ನು ದಾಟಿಹೋಗುವೆನು. ಈಜಿಪ್ಟ್ ದೇಶವನ್ನು ನಾನು ಸಂಹರಿಸುವ ಸಮಯದಲ್ಲಿ, ನಿಮ್ಮನ್ನು ನಾಶಮಾಡುವ ಯಾವ ಉಪದ್ರವವು ನಿಮ್ಮ ಮೇಲೆ ಬರುವುದಿಲ್ಲ.<verse eid="EXO 12:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="EXO 12:14"/>“ಈ ದಿನವು ನಿಮಗೆ ಜ್ಞಾಪಕಾರ್ಥವಾಗಿರುವುದು. ನೀವು ಅದನ್ನು ಯೆಹೋವ ದೇವರಿಗೆ ಹಬ್ಬವಾಗಿ ತಲತಲಾಂತರಗಳಲ್ಲಿ ಆಚರಿಸಬೇಕು. ಅದನ್ನು ಶಾಶ್ವತ ನಿಯಮವೆಂದು ಎಂದೆಂದಿಗೂ ಆಚರಿಸಬೇಕು. <verse eid="EXO 12:14"/><verse number="15" style="v" sid="EXO 12:15"/>ಏಳು ದಿನಗಳವರೆಗೆ ಹುಳಿಯಿಲ್ಲದ ರೊಟ್ಟಿಗಳನ್ನು ತಿನ್ನಬೇಕು. ಮೊದಲನೆಯ ದಿನದಲ್ಲಿಯೇ ಹುಳಿಹಿಟ್ಟನ್ನು ನಿಮ್ಮ ಮನೆಯೊಳಗಿಂದ ತೆಗೆದುಹಾಕಬೇಕು. ಏಕೆಂದರೆ ಮೊದಲನೆಯ ದಿನದಿಂದ ಏಳನೆಯ ದಿನದವರೆಗೆ ಹುಳಿರೊಟ್ಟಿ ತಿನ್ನುವವರನ್ನು ಇಸ್ರಾಯೇಲಿನೊಳಗಿಂದ ಬಹಿಷ್ಕರಿಸಬೇಕು. <verse eid="EXO 12:15"/><verse number="16" style="v" sid="EXO 12:16"/>ಇದಲ್ಲದೆ ಮೊದಲನೆಯ ದಿನದಲ್ಲಿ ಪರಿಶುದ್ಧ ದೇವಾರಾಧನೆಗಾಗಿ ಸಭೆ ಸೇರಬೇಕು, ಏಳನೆಯ ದಿನದಲ್ಲಿ ದೇವಾರಾಧನೆಗಾಗಿ ಸಭೆ ಸೇರಬೇಕು. ಊಟಕ್ಕೆ ಬೇಕಾದದ್ದನ್ನು ಮಾಡುವುದನ್ನು ಬಿಟ್ಟು, ಆ ದಿನಗಳಲ್ಲಿ ಯಾವ ತರವಾದ ಕೆಲಸವನ್ನೂ ಮಾಡಬಾರದು.<verse eid="EXO 12:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="EXO 12:17"/>“ನೀವು ಹುಳಿಯಿಲ್ಲದ ರೊಟ್ಟಿಯ ಹಬ್ಬವನ್ನು ಆಚರಿಸಬೇಕು. ಏಕೆಂದರೆ ಆ ದಿನದಲ್ಲಿಯೇ ನಾನು ನಿಮ್ಮ ಸೈನ್ಯಗಳನ್ನು ಈಜಿಪ್ಟ್ ದೇಶದೊಳಗಿಂದ ಹೊರಗೆ ಬರಮಾಡಿದ್ದೇನೆ. ಆದಕಾರಣ ನಿಮ್ಮ ಸಂತತಿಗಳಲ್ಲಿ ಅದನ್ನು ಶಾಶ್ವತ ನಿಯಮವೆಂದು ಎಂದೆಂದಿಗೂ ಆಚರಿಸಬೇಕು. <verse eid="EXO 12:17"/><verse number="18" style="v" sid="EXO 12:18"/>ಮೊದಲನೆಯ ತಿಂಗಳಿನ ಹದಿನಾಲ್ಕನೆಯ ದಿನದ ಸಂಜೆಯಿಂದ ಅದೇ ತಿಂಗಳಿನ ಇಪ್ಪತ್ತೊಂದನೆಯ ದಿನ ಸಂಜೆಯವರೆಗೆ ನೀವು ಹುಳಿಯಿಲ್ಲದ ರೊಟ್ಟಿಗಳನ್ನು ತಿನ್ನಬೇಕು. <verse eid="EXO 12:18"/><verse number="19" style="v" sid="EXO 12:19"/>ಏಳು ದಿನಗಳವರೆಗೆ ಹುಳಿ ಹಿಟ್ಟು ನಿಮ್ಮ ಮನೆಗಳಲ್ಲಿ ಸಿಕ್ಕಬಾರದು, ಏಕೆಂದರೆ ಹುಳಿ ಬೆರೆಸಿದ್ದನ್ನು ಯಾರು ತಿನ್ನುವರೋ ಅವರು ಪರದೇಶದವರಾಗಲಿ, ಸ್ವದೇಶದವರಾಗಲಿ ಅವರನ್ನು ಇಸ್ರಾಯೇಲ್ ಸಭೆಯೊಳಗಿಂದ ಬಹಿಷ್ಕರಿಸಬೇಕು. <verse eid="EXO 12:19"/><verse number="20" style="v" sid="EXO 12:20"/>ಹುಳಿ ಕಲಸಿದ್ದು ಯಾವುದೇ ಆಗಿರಲಿ ನೀವು ತಿನ್ನಬಾರದು. ನಿಮ್ಮ ಎಲ್ಲಾ ನಿವಾಸಗಳಲ್ಲಿ ಹುಳಿಯಿಲ್ಲದ ರೊಟ್ಟಿಗಳನ್ನೇ ತಿನ್ನಬೇಕು,” ಎಂದು ಹೇಳಿದರು.<verse eid="EXO 12:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="EXO 12:21"/>ಆಗ ಮೋಶೆಯು ಇಸ್ರಾಯೇಲಿನ ಎಲ್ಲಾ ಹಿರಿಯರನ್ನು ಕರೆದು ಅವರಿಗೆ, “ನಿಮ್ಮ ಕುಟುಂಬಗಳ ಪ್ರಕಾರ ಕುರಿಗಳನ್ನು ಆಯ್ದುಕೊಂಡು ಪಸ್ಕಹಬ್ಬಕ್ಕಾಗಿ ಕೊಯ್ಯಿರಿ. <verse eid="EXO 12:21"/><verse number="22" style="v" sid="EXO 12:22"/>ಹಿಸ್ಸೋಪ ಗಿಡದ ಕಟ್ಟನ್ನು ತೆಗೆದುಕೊಂಡು, ಬೋಗುಣಿಯಲ್ಲಿರುವ ರಕ್ತದಲ್ಲಿ ಅದನ್ನು ಅದ್ದಿ, ಬಾಗಿಲಿನ ಮೇಲೆ ಅಡ್ಡ ಪಟ್ಟಿಗೂ, ಅದರ ಪಕ್ಕದಲ್ಲಿರುವ ಎರಡು ನಿಲುವು ಕಂಬಗಳಿಗೂ ಹಚ್ಚಿರಿ. ನಿಮ್ಮಲ್ಲಿ ಯಾರೂ ಬೆಳಗಾಗುವವರೆಗೆ ಮನೆಯ ಬಾಗಿಲನ್ನು ಬಿಟ್ಟುಹೋಗಬಾರದು. <verse eid="EXO 12:22"/><verse number="23" style="v" sid="EXO 12:23"/>ಏಕೆಂದರೆ ಯೆಹೋವ ದೇವರು ಈಜಿಪ್ಟಿನವರನ್ನು ಸಂಹರಿಸುವುದಕ್ಕಾಗಿ ಹಾದುಹೋಗುವರು. ಅವರು ಅಡ್ಡ ಪಟ್ಟಿಯ ಮೇಲೂ, ಅದರ ಪಕ್ಕದ ಎರಡು ನಿಲುವು ಕಂಬಗಳ ಮೇಲೂ ರಕ್ತವನ್ನು ನೋಡಿದಾಗ, ಸಂಹಾರಕನು ನಿಮ್ಮ ಮನೆಗಳೊಳಗೆ ಬಂದು ನಿಮ್ಮನ್ನು ಸಂಹಾರಮಾಡದಂತೆ, ಯೆಹೋವ ದೇವರು ನಿಮ್ಮ ಬಾಗಿಲುಗಳನ್ನು ದಾಟಿಹೋಗುವರು.<verse eid="EXO 12:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="EXO 12:24"/>“ಇದನ್ನು ಒಂದು ಶಾಸನವಾಗಿ ನೀವೂ, ನಿಮ್ಮ ಪುತ್ರರೂ ಸದಾಕಾಲಕ್ಕೂ ಆಚರಿಸತಕ್ಕದ್ದು. <verse eid="EXO 12:24"/><verse number="25" style="v" sid="EXO 12:25"/>ಯೆಹೋವ ದೇವರು ಕೊಡುವೆನೆಂದು ಪ್ರಮಾಣ ಮಾಡಿದ ದೇಶಕ್ಕೆ ನೀವು ಬಂದಾಗ, ಈ ಆಚರಣೆಯನ್ನು ನೀವು ಕೈಗೊಳ್ಳಬೇಕು. <verse eid="EXO 12:25"/><verse number="26" style="v" sid="EXO 12:26"/>ನಿಮ್ಮ ಮಕ್ಕಳು, ‘ಈ ಆಚರಣೆಯ ಅರ್ಥವೇನು?’ ಎಂದು ಕೇಳಿದಾಗ, <verse eid="EXO 12:26"/><verse number="27" style="v" sid="EXO 12:27"/>ನೀವು ಅವರಿಗೆ, ‘ಯೆಹೋವ ದೇವರು ಈಜಿಪ್ಟ್ ದೇಶದಲ್ಲಿ ಈಜಿಪ್ಟಿನವರನ್ನು ಸಂಹರಿಸಿ, ನಮ್ಮ ಮನೆಗಳನ್ನು ಕಾಪಾಡುವುದಕ್ಕಾಗಿ ಇಸ್ರಾಯೇಲರ ಮನೆಗಳನ್ನು ದಾಟಿಹೋದ ಯೆಹೋವ ದೇವರ ಪಸ್ಕ ಬಲಿಯ ಆಚರಣೆಯನ್ನು ನಡೆಸುತ್ತಿದ್ದೇವೆ,’ ಎಂದು ನೀವು ಹೇಳಬೇಕು,” ಎಂದನು. ಆಗ ಜನರು ತಲೆಬಾಗಿಸಿ ಆರಾಧಿಸಿದರು. <verse eid="EXO 12:27"/><verse number="28" style="v" sid="EXO 12:28"/>ಯೆಹೋವ ದೇವರು ಮೋಶೆ ಆರೋನರಿಗೆ ಆಜ್ಞಾಪಿಸಿದ ಮೇರೆಗೆ ಇಸ್ರಾಯೇಲರು ಮಾಡಿದರು.<verse eid="EXO 12:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="EXO 12:29"/>ಮಧ್ಯರಾತ್ರಿಯಲ್ಲಿ ಸಿಂಹಾಸನದ ಮೇಲೆ ಕೂತುಕೊಂಡ ಫರೋಹನ ಚೊಚ್ಚಲು ಮಗನು ಮೊದಲುಗೊಂಡು, ಸೆರೆಯಲ್ಲಿದ್ದ ಸೆರೆಯವನ ಚೊಚ್ಚಲು ಮಗನವರೆಗೂ, ಎಂದರೆ ಈಜಿಪ್ಟ್ ದೇಶದಲ್ಲಿದ್ದ ಎಲ್ಲಾ ಚೊಚ್ಚಲು ಮಕ್ಕಳನ್ನೂ, ಪಶುಗಳಲ್ಲಿ ಚೊಚ್ಚಲಾದವುಗಳೆಲ್ಲವನ್ನೂ ಯೆಹೋವ ದೇವರು ಸಂಹರಿಸಿದರು. <verse eid="EXO 12:29"/><verse number="30" style="v" sid="EXO 12:30"/>ಆಗ ಫರೋಹನೂ, ಅವನ ಎಲ್ಲಾ ಅಧಿಕಾರಿಗಳೂ, ಎಲ್ಲಾ ಈಜಿಪ್ಟಿನವರೂ ರಾತ್ರಿಯಲ್ಲಿ ಎದ್ದರು. ಆ ಈಜಿಪ್ಟಿನಲ್ಲಿ ದೊಡ್ಡ ಗೋಳಾಟವಾಯಿತು. ಏಕೆಂದರೆ ಅಲ್ಲಿ ಸತ್ತವರು ಇಲ್ಲದ ಒಂದು ಮನೆಯಾದರೂ ಇರಲಿಲ್ಲ.<verse eid="EXO 12:30"/></para>
  <para style="s1">ವಿಮೋಚನೆ</para>
  <para style="p">
    <verse number="31" style="v" sid="EXO 12:31"/>ಫರೋಹನು ರಾತ್ರಿಯಲ್ಲಿ ಮೋಶೆ ಆರೋನರನ್ನು ಕರೆಯಿಸಿ ಅವರಿಗೆ, “ನೀವು ಮತ್ತು ಇಸ್ರಾಯೇಲರೆಲ್ಲರೂ ಎದ್ದು ನನ್ನ ಜನರೊಳಗಿಂದ ಹೊರಟು ಹೋಗಿರಿ. ನೀವು ಹೇಳಿದ ಹಾಗೆಯೇ, ಯೆಹೋವ ದೇವರನ್ನು ಆರಾಧಿಸುವುದಕ್ಕೆ ಹೊರಟುಹೋಗಿರಿ. <verse eid="EXO 12:31"/><verse number="32" style="v" sid="EXO 12:32"/>ನೀವು ಹೇಳಿದಂತೆ ನಿಮ್ಮ ಕುರಿದನಗಳನ್ನು ತೆಗೆದುಕೊಳ್ಳಿರಿ. ನನ್ನನ್ನು ಸಹ ಆಶೀರ್ವದಿಸಿರಿ,” ಎಂದನು.<verse eid="EXO 12:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="EXO 12:33"/>ಇದಲ್ಲದೆ ಈಜಿಪ್ಟಿನವರು, “ನಾವೆಲ್ಲರೂ ಸಾಯುತ್ತೇವೆ,” ಎಂದು ಹೇಳಿ, ಅವರನ್ನು ತ್ವರೆಯಾಗಿ ದೇಶದೊಳಗಿಂದ ಕಳುಹಿಸಿಬಿಡುವ ಹಾಗೆ ಜನರನ್ನು ಒತ್ತಾಯಮಾಡಿದರು. <verse eid="EXO 12:33"/><verse number="34" style="v" sid="EXO 12:34"/>ಆದ್ದರಿಂದ ಜನರು ಹಿಟ್ಟಿಗೆ ಹುಳಿ ಹಾಕುವುದಕ್ಕಿಂತ ಮುಂಚೆ, ಅಡಿಗೆ ಮಾಡುವ ಪಾತ್ರೆಗಳ ಸಂಗಡ ಬಟ್ಟೆಗಳಲ್ಲಿ ಕಟ್ಟಿ, ಹೆಗಲಿನ ಮೇಲೆ ಹೊತ್ತುಕೊಂಡು ಹೋದರು. <verse eid="EXO 12:34"/><verse number="35" style="v" sid="EXO 12:35"/>ಇಸ್ರಾಯೇಲರು ಮೋಶೆಯು ಹೇಳಿದಂತೆ ಮಾಡಿ, ಬೆಳ್ಳಿಬಂಗಾರದ ಒಡವೆಗಳನ್ನೂ, ಬಟ್ಟೆಗಳನ್ನೂ ಈಜಿಪ್ಟಿನವರಿಂದ ಕೇಳಿ ಪಡೆದರು. <verse eid="EXO 12:35"/><verse number="36" style="v" sid="EXO 12:36"/>ಯೆಹೋವ ದೇವರು ಈಜಿಪ್ಟಿನವರ ಎದುರಿನಲ್ಲಿ ಜನರ ಮೇಲೆ ದಯೆ ತೋರಿಸಿದ್ದರಿಂದ, ಅವರು ಕೇಳಿದ್ದನ್ನು ಕೊಟ್ಟರು. ಹೀಗೆ ಅವರು ಈಜಿಪ್ಟಿನವರ ಸೊತ್ತನ್ನು ಸುಲಿದುಕೊಂಡರು.<verse eid="EXO 12:36"/></para>
  <para style="p">
    <verse number="37" style="v" sid="EXO 12:37"/>ಆಗ ಇಸ್ರಾಯೇಲರಲ್ಲಿ ಮಕ್ಕಳಲ್ಲದೆ ಗಂಡಸರು ಮಾತ್ರ ಆರು ಲಕ್ಷ ಜನರು ಕಾಲುನಡಿಗೆಯಾಗಿ ರಮ್ಸೇಸನ್ನು ಬಿಟ್ಟು ಸುಕ್ಕೋತಿಗೆ ಪ್ರಯಾಣಮಾಡಿದರು. <verse eid="EXO 12:37"/><verse number="38" style="v" sid="EXO 12:38"/>ಬೇರೆ ಜನಸಮೂಹವೂ ಕುರಿದನ ಮೊದಲಾದ ಪಶುಗಳ ಬಹುದೊಡ್ಡ ಹಿಂಡೂ ಇಸ್ರಾಯೇಲರ ಸಂಗಡ ಹೋದವು. <verse eid="EXO 12:38"/><verse number="39" style="v" sid="EXO 12:39"/>ಆಗ ಅವರು ಈಜಿಪ್ಟಿನಿಂದ ತಂದಿದ್ದ ನಾದಿದ ಹಿಟ್ಟು ಇನ್ನೂ ಹುಳಿಯಾಗದ ಕಾರಣ, ಹಿಟ್ಟಿನಿಂದ ಹುಳಿಯಿಲ್ಲದ ರೊಟ್ಟಿಗಳನ್ನು ಮಾಡಿದರು. ಏಕೆಂದರೆ ಅವರನ್ನು ಅಲ್ಲಿ ನಿಲ್ಲಗೊಡದೆ ಈಜಿಪ್ಟಿನಿಂದ ಓಡಿಸಿಬಿಟ್ಟಿದ್ದರು. ಅವರು ತಮಗಾಗಿ ಯಾವ ಆಹಾರವನ್ನೂ ಸಿದ್ಧಪಡಿಸಿಕೊಂಡಿರಲಿಲ್ಲ.<verse eid="EXO 12:39"/></para>
  <para style="p">
    <verse number="40" style="v" sid="EXO 12:40"/>ಇಸ್ರಾಯೇಲರು ಈಜಿಪ್ಟಿನಲ್ಲಿ ಪ್ರವಾಸವಾಗಿ ವಾಸಮಾಡಿದ್ದ ಕಾಲವು ನಾನೂರ ಮೂವತ್ತು ವರ್ಷಗಳಾಗಿದ್ದವು. <verse eid="EXO 12:40"/><verse number="41" style="v" sid="EXO 12:41"/>ನಾನೂರ ಮೂವತ್ತು ವರ್ಷಗಳು ತೀರಿದ ತರುವಾಯ, ಅದೇ ದಿನದಲ್ಲಿ ಯೆಹೋವ ದೇವರ ಸೈನ್ಯಗಳೆಲ್ಲಾ ಈಜಿಪ್ಟ್ ದೇಶವನ್ನು ಬಿಟ್ಟು ಹೊರಗೆ ಹೋದವು. <verse eid="EXO 12:41"/><verse number="42" style="v" sid="EXO 12:42"/>ದೇವರು ಈಜಿಪ್ಟ್ ದೇಶದಿಂದ ಅವರನ್ನು ಹೊರಗೆ ತಂದ ಕಾರಣ, ಇದು ಯೆಹೋವ ದೇವರಿಗೆ ಆಚರಿಸಬೇಕಾದ ರಾತ್ರಿಯಾಗಿತ್ತು. ಇಸ್ರಾಯೇಲರು ತಮ್ಮ ಸಂತತಿಗಳಲ್ಲಿ ಯೆಹೋವ ದೇವರಿಗೆ ಆಚರಿಸಬೇಕಾದ ರಾತ್ರಿಯು ಇದೇ.<verse eid="EXO 12:42"/></para>
  <para style="s1">ಪಸ್ಕಹಬ್ಬದ ನಿಯಮಗಳು</para>
  <para style="p">
    <verse number="43" style="v" sid="EXO 12:43"/>ಯೆಹೋವ ದೇವರು ಮೋಶೆ ಆರೋನರಿಗೆ, “ಪಸ್ಕದ ಶಾಸನವು ಇದೆ:</para>
  <para style="p" vid="EXO 12:43">“ವಿದೇಶಿಯರಲ್ಲಿ ಯಾರೂ ಪಸ್ಕಭೋಜನವನ್ನು ತಿನ್ನಬಾರದು. <verse eid="EXO 12:43"/><verse number="44" style="v" sid="EXO 12:44"/>ಆದರೆ ಕ್ರಯಕ್ಕೆ ತೆಗೆದುಕೊಂಡ ಪ್ರತಿಯೊಬ್ಬ ಗುಲಾಮನು ಸುನ್ನತಿ ಮಾಡಿಸಿಕೊಂಡ ತರುವಾಯ, ಅಂಥವನು ಅದನ್ನು ತಿನ್ನಬಹುದು. <verse eid="EXO 12:44"/><verse number="45" style="v" sid="EXO 12:45"/>ಪರದೇಶದವರೂ, ಕೂಲಿಯವರೂ, ಅದನ್ನು ತಿನ್ನಬಾರದು.<verse eid="EXO 12:45"/></para>
  <para style="p">
    <verse number="46" style="v" sid="EXO 12:46"/>“ಒಂದೇ ಮನೆಯಲ್ಲಿ ಅದನ್ನು ತಿನ್ನಬೇಕು. ಆ ಮಾಂಸದಲ್ಲಿ ಸ್ವಲ್ಪ ಅಂಶವನ್ನಾದರೂ ಮನೆಯ ಹೊರಗೆ ತೆಗೆದುಕೊಂಡು ಹೋಗಬಾರದು. ಪಶುವಿನ ಎಲುಬುಗಳಲ್ಲಿ ಒಂದನ್ನಾದರೂ ಮುರಿಯಬಾರದು. <verse eid="EXO 12:46"/><verse number="47" style="v" sid="EXO 12:47"/>ಇಸ್ರಾಯೇಲಿನ ಸಮೂಹದಲ್ಲಿರುವವರೆಲ್ಲರೂ ಇದನ್ನು ಆಚರಿಸಬೇಕು.<verse eid="EXO 12:47"/></para>
  <para style="p">
    <verse number="48" style="v" sid="EXO 12:48"/>“ನಿಮ್ಮ ಜೊತೆಯಲ್ಲಿ ವಾಸಮಾಡಿದ ಪರದೇಶದವನು ಯೆಹೋವ ದೇವರಿಗೆ ಪಸ್ಕವನ್ನು ಆಚರಿಸಬೇಕೆಂದಿದ್ದರೆ, ಅವನ ಗಂಡಸರೆಲ್ಲಾ ಸುನ್ನತಿ ಮಾಡಿಸಿಕೊಳ್ಳಲಿ. ತರುವಾಯ ಅವನು ಅದನ್ನು ಆಚರಿಸುವುದಕ್ಕೆ ಸಮೀಪಬರಲಿ, ಅಂಥವರು ಸ್ವದೇಶದಲ್ಲಿ ಹುಟ್ಟಿದವರಂತೆ ಇರುವರು. ಆದರೆ ಸುನ್ನತಿ ಮಾಡಿಸಿಕೊಳ್ಳದ ಒಬ್ಬನಾದರೂ ಅದನ್ನು ತಿನ್ನಬಾರದು. <verse eid="EXO 12:48"/><verse number="49" style="v" sid="EXO 12:49"/>ಸ್ವದೇಶದಲ್ಲಿ ಹುಟ್ಟಿದವನಿಗೂ, ನಿಮ್ಮಲ್ಲಿ ಪ್ರವಾಸಿಯಾಗಿರುವ ಅನ್ಯನಿಗೂ ಒಂದೇ ನಿಯಮವಿರಲಿ,” ಎಂದು ಹೇಳಿದರು.<verse eid="EXO 12:49"/></para>
  <para style="p">
    <verse number="50" style="v" sid="EXO 12:50"/>ಇಸ್ರಾಯೇಲರೆಲ್ಲಾ ಯೆಹೋವ ದೇವರು ಮೋಶೆ ಆರೋನರಿಗೆ ಆಜ್ಞಾಪಿಸಿದಂತೆಯೇ ಮಾಡಿದರು. <verse eid="EXO 12:50"/><verse number="51" style="v" sid="EXO 12:51"/>ಅದೇ ದಿನದಲ್ಲಿ ಯೆಹೋವ ದೇವರು ಇಸ್ರಾಯೇಲರನ್ನು ಅವರ ಸೈನ್ಯಗಳ ಪ್ರಕಾರ ಈಜಿಪ್ಟ್ ದೇಶದೊಳಗಿಂದ ಹೊರಗೆ ತಂದರು.<verse eid="EXO 12:51"/></para>
  <chapter eid="EXO 12"/>
  <chapter number="13" style="c" sid="EXO 13"/>
  <para style="s1">ಚೊಚ್ಚಲಾದವರ ಪ್ರತಿಷ್ಠೆ</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 13:1"/>ಯೆಹೋವ ದೇವರು ಮೋಶೆಯ ಸಂಗಡ ಮಾತನಾಡಿ, <verse eid="EXO 13:1"/><verse number="2" style="v" sid="EXO 13:2"/>“ಇಸ್ರಾಯೇಲರಲ್ಲಿ ಹುಟ್ಟಿರುವ ಪ್ರತಿಯೊಂದು ಚೊಚ್ಚಲ ಗಂಡನ್ನು ನನಗಾಗಿ ಮೀಸಲಾಗಿಡು. ಮನುಷ್ಯರಾಗಿರಲಿ, ಪಶುಪ್ರಾಣಿಗಳಾಗಿರಲಿ ಪ್ರಥಮ ಗರ್ಭಫಲವು ನನ್ನದಾಗಿದೆ,” ಎಂದರು.<verse eid="EXO 13:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="EXO 13:3"/>ಆಗ ಮೋಶೆಯು ಜನರಿಗೆ, “ನೀವು ಈಜಿಪ್ಟಿನ ದಾಸತ್ವದಿಂದ ಹೊರಬಂದ ಈ ದಿನವನ್ನು ಜ್ಞಾಪಕಮಾಡಿಕೊಳ್ಳಿರಿ. ಏಕೆಂದರೆ ಯೆಹೋವ ದೇವರು ನಿಮ್ಮನ್ನು ತಮ್ಮ ಭುಜಬಲದಿಂದ ಅಲ್ಲಿಂದ ಹೊರಗೆ ಬರಮಾಡಿದ್ದಾರೆ. ಹೀಗಿರುವುದರಿಂದ ಈ ದಿನ ನೀವು ಹುಳಿರೊಟ್ಟಿಯನ್ನು ತಿನ್ನಬಾರದು. <verse eid="EXO 13:3"/><verse number="4" style="v" sid="EXO 13:4"/>ಅಬೀಬ<note caller="+" style="f"><char style="fr" closed="false">13:4 </char><char style="fq" closed="false">ಅಬೀಬ </char><char style="ft" closed="false">ಅಂದರೆ ಹೀಬ್ರೂ ಕ್ಯಾಲೆಂಡರಿನ ಪ್ರಕಾರ </char><char style="fqa" closed="false">ಮೊದಲ ತಿಂಗಳು</char></note> ತಿಂಗಳಿನ ಈ ದಿನದಲ್ಲಿ ನೀವು ಹೊರಗೆ ಬಂದಿದ್ದೀರಿ. <verse eid="EXO 13:4"/><verse number="5" style="v" sid="EXO 13:5"/>ಆದ್ದರಿಂದ ಯೆಹೋವ ದೇವರು ನಿಮ್ಮ ಪಿತೃಗಳಿಗೆ ಪ್ರಮಾಣ ಮಾಡಿದ ಹಾಲೂ ಜೇನೂ ಹರಿಯುವ ದೇಶಕ್ಕೆ ಅಂದರೆ ಕಾನಾನ್ಯರ, ಹಿತ್ತಿಯರ, ಅಮೋರಿಯರ, ಹಿವ್ವಿಯರ, ಯೆಬೂಸಿಯರ ದೇಶಕ್ಕೆ ನಿಮ್ಮನ್ನು ಕರೆತಂದು ಅದನ್ನು ನಿಮಗೆ ಕೊಟ್ಟಾಗ ಈ ಹಬ್ಬವನ್ನು ಈ ತಿಂಗಳಲ್ಲಿ ಆಚರಿಸಬೇಕು. <verse eid="EXO 13:5"/><verse number="6" style="v" sid="EXO 13:6"/>ನೀವು ಹುಳಿಯಿಲ್ಲದ ರೊಟ್ಟಿಯನ್ನು ಏಳು ದಿವಸ ತಿನ್ನಬೇಕು. ಏಳನೆಯ ದಿನದಲ್ಲಿ ಯೆಹೋವ ದೇವರಿಗೆ ಹಬ್ಬವನ್ನಾಚರಿಸಬೇಕು. <verse eid="EXO 13:6"/><verse number="7" style="v" sid="EXO 13:7"/>ಆ ಏಳು ದಿನಗಳಲ್ಲಿ ಹುಳಿಯಿಲ್ಲದ ರೊಟ್ಟಿಯನ್ನು ತಿನ್ನಬೇಕು. ಅಲ್ಲದೆ ನಿಮ್ಮ ಬಳಿಯಲ್ಲಿ ಹುಳಿಯಾಗಲಿ ಇಲ್ಲವೆ ಹುಳಿಹಿಟ್ಟಾಗಲಿ ನಿಮ್ಮ ಯಾವ ಮೇರೆಯಲ್ಲೂ ಕಾಣಬಾರದು. <verse eid="EXO 13:7"/><verse number="8" style="v" sid="EXO 13:8"/>ಆ ದಿನದಲ್ಲಿ ನಿಮ್ಮ ಮಕ್ಕಳಿಗೆ, ‘ನಾವು ಈಜಿಪ್ಟಿನಿಂದ ಹೊರಗೆ ಬಂದಾಗ ಯೆಹೋವ ದೇವರು ನಮಗೆ ಮಾಡಿದ್ದನ್ನು ಸ್ಮರಿಸುವುದಕ್ಕಾಗಿ ಇದನ್ನು ಆಚರಿಸುತ್ತೇವೆ,’ ಎಂದು ತಿಳಿಸಬೇಕು. <verse eid="EXO 13:8"/><verse number="9" style="v" sid="EXO 13:9"/>ಏಕೆಂದರೆ ಯೆಹೋವ ದೇವರು ನಿಮ್ಮನ್ನು ತಮ್ಮ ಭುಜಬಲದಿಂದ ಈಜಿಪ್ಟಿನಿಂದ ಹೊರಗೆ ಬರಮಾಡಿದ್ದಾರೆ. ಆದ್ದರಿಂದ ದೇವರ ನಿಯಮವು ನಿಮ್ಮ ಬಾಯಲ್ಲಿ ಇರುವಂತೆ, ಈ ಆಚರಣೆಯು ನಿಮ್ಮ ಕೈಯಲ್ಲಿ ಗುರುತಾಗಿಯೂ ನಿಮ್ಮ ಹಣೆಯಲ್ಲಿ ಜ್ಞಾಪಕಾರ್ಥವಾಗಿಯೂ ಇರಬೇಕು. <verse eid="EXO 13:9"/><verse number="10" style="v" sid="EXO 13:10"/>ಹೀಗಿರುವುದರಿಂದ ನೀವು ಪ್ರತಿ ವರುಷವು ನೇಮಿತವಾದ ಕಾಲದಲ್ಲಿ ಈ ಶಾಸನವನ್ನು ಕೈಗೊಳ್ಳಬೇಕು.<verse eid="EXO 13:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="EXO 13:11"/>“ಯೆಹೋವ ದೇವರು ನಿಮಗೂ ನಿಮ್ಮ ಪಿತೃಗಳಿಗೂ ಪ್ರಮಾಣ ಮಾಡಿದ ಪ್ರಕಾರ, ನಿಮ್ಮನ್ನು ಕಾನಾನ್ಯರ ದೇಶಕ್ಕೆ ಬರಮಾಡಿ, ಅದನ್ನು ನಿಮಗೆ ಕೊಟ್ಟನಂತರ, <verse eid="EXO 13:11"/><verse number="12" style="v" sid="EXO 13:12"/>ನಿಮ್ಮಲ್ಲಿಯೂ ನಿಮ್ಮ ಪಶುಪ್ರಾಣಿಗಳಲ್ಲಿಯೂ ಹುಟ್ಟುವ ಪ್ರತಿಯೊಂದು ಗರ್ಭದ ಪ್ರಥಮ ಫಲವನ್ನು ನೀವು ಯೆಹೋವ ದೇವರಿಗೆ ಕೊಡಬೇಕು. <verse eid="EXO 13:12"/><verse number="13" style="v" sid="EXO 13:13"/>ಕತ್ತೆಯ ಚೊಚ್ಚಲು ಮರಿಗೆ ಬದಲಾಗಿ ಕುರಿಮರಿಯನ್ನು ಕೊಟ್ಟು ವಿಮೋಚಿಸಿಕೊಳ್ಳಬೇಕು. ಹಾಗೆ ವಿಮೋಚಿಸಿಕೊಳ್ಳದೆ ಹೋದರೆ ಅದರ ಕುತ್ತಿಗೆ ಮುರಿಯಬೇಕು. ಮನುಷ್ಯರಲ್ಲಿ ಚೊಚ್ಚಲ ಗಂಡು ಮಕ್ಕಳನ್ನು ಬದಲುಕೊಟ್ಟು, ವಿಮೋಚಿಸಲೇಬೇಕು.<verse eid="EXO 13:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="EXO 13:14"/>“ಮುಂದೆ ಬರುವ ಕಾಲದಲ್ಲಿ ನಿಮ್ಮ ಪುತ್ರರು ನಿಮಗೆ, ‘ಇದರ ಅರ್ಥವೇನು?’ ಎಂದು ಕೇಳುವಾಗ, ನೀವು ಅವರಿಗೆ, ‘ಯೆಹೋವ ದೇವರು ತಮ್ಮ ಭುಜಬಲದಿಂದ ನಮ್ಮನ್ನು ಈಜಿಪ್ಟಿನ ದಾಸತ್ವದೊಳಗಿಂದ ಹೊರಗೆ ಬರಮಾಡಿದ್ದಾರೆ. <verse eid="EXO 13:14"/><verse number="15" style="v" sid="EXO 13:15"/>ಫರೋಹನು ಹಟಮಾರಿತನದಿಂದ ನಮ್ಮನ್ನು ಕಳುಹಿಸದೆ ಇದ್ದಾಗ, ಯೆಹೋವ ದೇವರು ಈಜಿಪ್ಟ್ ದೇಶದಲ್ಲಿ ಚೊಚ್ಚಲಾದದ್ದನ್ನೆಲ್ಲಾ ಎಂದರೆ, ಮನುಷ್ಯರ ಹಾಗೂ ಪಶುಪ್ರಾಣಿಗಳ ಚೊಚ್ಚಲಾದವುಗಳನ್ನು ಕೊಂದುಹಾಕಿದರು. ಆದ್ದರಿಂದ ಚೊಚ್ಚಲ ಗಂಡುಗಳನ್ನೆಲ್ಲಾ ಯೆಹೋವ ದೇವರಿಗೆ ಅರ್ಪಿಸುತ್ತೇವೆ. ನಮ್ಮ ಪುತ್ರರಲ್ಲಿ ಚೊಚ್ಚಲಾದವರೆಲ್ಲರನ್ನು ವಿಮೋಚಿಸುತ್ತೇವೆ,’ <verse eid="EXO 13:15"/><verse number="16" style="v" sid="EXO 13:16"/>ಇದು ನಿಮ್ಮ ಕೈಯಲ್ಲಿ ಗುರುತಾಗಿಯೂ ನಿಮ್ಮ ಹಣೆಯ ಮೇಲೆ ಸಂಕೇತವಾಗಿಯೂ ಇರಲಿ. ಏಕೆಂದರೆ ಯೆಹೋವ ದೇವರು ತಮ್ಮ ಭುಜಬಲದಿಂದ ನಮ್ಮನ್ನು ಈಜಿಪ್ಟಿನೊಳಗಿಂದ ಹೊರಗೆ ಬರಮಾಡಿದ್ದಾರೆ ಎಂದು ಹೇಳಬೇಕು,” ಎಂದರು.<verse eid="EXO 13:16"/></para>
  <para style="s1">ಸಮುದ್ರವನ್ನು ದಾಟಿದ್ದು</para>
  <para style="p">
    <verse number="17" style="v" sid="EXO 13:17"/>ಫರೋಹನು ಜನರನ್ನು ಕಳುಹಿಸಿಬಿಟ್ಟಾಗ, ಫಿಲಿಷ್ಟಿಯರ ದೇಶದ ದಾರಿಯು ಸಮೀಪವಿದ್ದರೂ ದೇವರು ಅವರನ್ನು ಅದರಲ್ಲಿ ನಡೆಸಲಿಲ್ಲ. ಏಕೆಂದರೆ ದೇವರು, “ಜನರು ಯುದ್ಧವನ್ನು ನೋಡಿ, ಮನಸ್ಸನ್ನು ಬೇರೆಮಾಡಿಕೊಂಡು, ಈಜಿಪ್ಟಿಗೆ ಹಿಂದಿರುಗಿಯಾರು,” ಎಂದು ಹೇಳಿದರು. <verse eid="EXO 13:17"/><verse number="18" style="v" sid="EXO 13:18"/>ಹೀಗಿರುವುದರಿಂದ ಯೆಹೋವ ದೇವರು ಜನರನ್ನು ಕೆಂಪುಸಮುದ್ರದ ಮರುಭೂಮಿಯಲ್ಲಿ ಸುತ್ತಿಕೊಂಡು ಹೋಗುವಂತೆ ಮಾಡಿದರು. ಇಸ್ರಾಯೇಲರು ಯುದ್ಧಸನ್ನದ್ಧರಾಗಿ ಈಜಿಪ್ಟ್ ದೇಶದೊಳಗಿಂದ ಹೋದರು.<verse eid="EXO 13:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="EXO 13:19"/>ಆಗ ಮೋಶೆಯು ತನ್ನೊಂದಿಗೆ ಯೋಸೇಫನ ಎಲುಬುಗಳನ್ನು ತೆಗೆದುಕೊಂಡು ಹೋದನು. ಏಕೆಂದರೆ ಯೋಸೇಫನು ಇಸ್ರಾಯೇಲರಿಗೆ, “ದೇವರು ನಿಜವಾಗಿಯೂ ನಿಮ್ಮ ಸಹಾಯಕ್ಕೆ ಬರುವರು. ಆಗ ನೀವು ನನ್ನ ಎಲುಬುಗಳನ್ನು ಇಲ್ಲಿಂದ ನಿಮ್ಮ ಕೂಡ ತೆಗೆದುಕೊಂಡು ಹೋಗಬೇಕು,”<note caller="+" style="f"><char style="fr" closed="false">13:19 </char><char style="ft" closed="false">ನೋಡಿರಿ <char style="xt"><ref loc="GEN 50:25">ಆದಿ 50:25</ref></char></char></note> ಎಂದು ಹೇಳಿ ಅವರಿಂದ ದೃಢಪ್ರಮಾಣ ಮಾಡಿಸಿದ್ದನು.<verse eid="EXO 13:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="EXO 13:20"/>ಹೀಗೆ ಅವರು ಸುಕ್ಕೋತಿನಿಂದ ಪ್ರಯಾಣಮಾಡಿ, ಏತಾಮಿನ ಮರುಭೂಮಿಯ ಅಂಚಿನಲ್ಲಿ ಇಳಿದುಕೊಂಡರು. <verse eid="EXO 13:20"/><verse number="21" style="v" sid="EXO 13:21"/>ಇದಲ್ಲದೆ ಅವರು ಹಗಲೂ ರಾತ್ರಿಯೂ ಪ್ರಯಾಣ ಮಾಡುವ ಹಾಗೆ ಯೆಹೋವ ದೇವರು ಹಗಲಲ್ಲಿ ಅವರಿಗೆ ದಾರಿ ತೋರಿಸುವುದಕ್ಕೆ ಮೇಘದ ಸ್ತಂಭದಲ್ಲಿಯೂ ರಾತ್ರಿಯಲ್ಲಿ ಅವರಿಗೆ ಬೆಳಕು ಕೊಡುವುದಕ್ಕೆ ಅಗ್ನಿಯ ಸ್ತಂಭದಲ್ಲಿಯೂ ಅವರ ಮುಂದೆ ಹೋದರು. <verse eid="EXO 13:21"/><verse number="22" style="v" sid="EXO 13:22"/>ದೇವರು ಹಗಲಲ್ಲಿ ಮೇಘಸ್ತಂಭವನ್ನೂ ರಾತ್ರಿಯಲ್ಲಿ ಅಗ್ನಿಸ್ತಂಭವನ್ನೂ ಜನರ ಎದುರಿನಿಂದ ತೆಗೆದುಬಿಡಲಿಲ್ಲ.<verse eid="EXO 13:22"/></para>
  <chapter eid="EXO 13"/>
  <chapter number="14" style="c" sid="EXO 14"/>
  <para style="p">
    <verse number="1" style="v" sid="EXO 14:1"/>ತರುವಾಯ ಯೆಹೋವ ದೇವರು ಮಾತನಾಡಿ ಮೋಶೆಗೆ, <verse eid="EXO 14:1"/><verse number="2" style="v" sid="EXO 14:2"/>“ಇಸ್ರಾಯೇಲರು ಹಿಂತಿರುಗಿ ಹೋಗಿ ಪೀಹಹೀರೋತಿಗೆ ಎದುರಾಗಿ ಮಿಗ್ದೋಲಿಗೂ ಸಮುದ್ರಕ್ಕೂ ಮಧ್ಯದಲ್ಲಿ ಬಾಲ್ಜೆಫೋನಿಗೆ ಎದುರಾಗಿ ಇಳಿದುಕೊಳ್ಳಬೇಕೆಂದು ಅವರಿಗೆ ಹೇಳು. ಅದರ ಎದುರಾಗಿ ನೀವು ಸಮುದ್ರದ ತೀರದಲ್ಲಿ ಇಳಿದುಕೊಳ್ಳಬೇಕು. <verse eid="EXO 14:2"/><verse number="3" style="v" sid="EXO 14:3"/>ಏಕೆಂದರೆ ಫರೋಹನು ಇಸ್ರಾಯೇಲರ ವಿಷಯದಲ್ಲಿ, ‘ಅವರು ಗಲಿಬಿಲಿಗೊಂಡು ಮರುಭೂಮಿಯನ್ನು ಸುತ್ತುವರಿದ ಪ್ರದೇಶದಲ್ಲಿ ಅತ್ತಿತ್ತ ಹೋಗುತ್ತಿರುವರು,’ ಎಂದುಕೊಳ್ಳುವನು. <verse eid="EXO 14:3"/><verse number="4" style="v" sid="EXO 14:4"/>ಇದಲ್ಲದೆ ಫರೋಹನು ನಿಮ್ಮನ್ನು ಹಿಂದಟ್ಟುವಂತೆ ನಾನು ಅವನ ಹೃದಯವನ್ನು ಕಠಿಣ ಮಾಡುವೆನು. ಫರೋಹನಲ್ಲಿಯೂ, ಅವನ ಎಲ್ಲಾ ಸೈನ್ಯದಲ್ಲಿಯೂ ನನ್ನನ್ನು ಘನಪಡಿಸಿಕೊಳ್ಳುವೆನು. ಆಗ ನಾನೇ ಯೆಹೋವ ದೇವರೆಂದು ಈಜಿಪ್ಟಿನವರು ತಿಳಿಯುವರು,” ಎಂದು ಹೇಳಿದರು. ಅದರಂತೆಯೇ ಇಸ್ರಾಯೇಲರು ಮಾಡಿದರು.<verse eid="EXO 14:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="EXO 14:5"/>ಜನರು ಓಡಿಹೋದರೆಂಬ ವಿಷಯ ಈಜಿಪ್ಟಿನ ಅರಸನಿಗೆ ತಿಳಿಯಿತು. ಆಗ ಫರೋಹನ ಮತ್ತು ಅವನ ಸೇವಕರ ಹೃದಯವು ಅವರಿಗೆ ವಿರೋಧವಾಗಿ ತಿರುಗಿಕೊಂಡಿತು. ಅವರು, “ಇಸ್ರಾಯೇಲರು ನಮ್ಮ ಸೇವೆ ಮಾಡುವುದನ್ನು ಬಿಟ್ಟು ಹೋಗಿಬಿಡುವಂತೆ ನಾವು ಏಕೆ ಮಾಡಿದೆವು?” ಎಂದುಕೊಂಡರು. <verse eid="EXO 14:5"/><verse number="6" style="v" sid="EXO 14:6"/>ಆಗ ಫರೋಹನು ತನ್ನ ರಥವನ್ನು ಸಿದ್ಧಮಾಡಿ, ತನ್ನ ಸೈನ್ಯವನ್ನು ತನ್ನೊಂದಿಗೆ ತೆಗೆದುಕೊಂಡನು. <verse eid="EXO 14:6"/><verse number="7" style="v" sid="EXO 14:7"/>ಇದಲ್ಲದೆ ಅವನು ಆರಿಸಿಕೊಂಡ ಅತ್ಯುತ್ತಮ ಆರುನೂರು ರಥಗಳನ್ನೂ, ಈಜಿಪ್ಟಿನ ಎಲ್ಲಾ ರಥಗಳನ್ನೂ, ಅವುಗಳ ಮೇಲೆ ಅಧಿಪತಿಗಳನ್ನೂ ತೆಗೆದುಕೊಂಡನು. <verse eid="EXO 14:7"/><verse number="8" style="v" sid="EXO 14:8"/>ಈಜಿಪ್ಟಿನ ಅರಸನಾದ ಫರೋಹನ ಹೃದಯವನ್ನು ಯೆಹೋವ ದೇವರು ಕಠಿಣ ಮಾಡಿದ್ದರಿಂದ ಅವನು ಇಸ್ರಾಯೇಲರನ್ನು ಹಿಂದಟ್ಟಿದನು. ಆದರೆ ಇಸ್ರಾಯೇಲರು ಧೈರ್ಯದಿಂದ ಹೊರಗೆ ಹೋದರು. <verse eid="EXO 14:8"/><verse number="9" style="v" sid="EXO 14:9"/>ಈಜಿಪ್ಟಿನವರು ಅವರನ್ನು ಹಿಂದಟ್ಟಿದರು. ಅವರು ಸಮುದ್ರ ತೀರದಲ್ಲಿ ಇಳಿದುಕೊಂಡಿರುವಾಗ, ಫರೋಹನ ಎಲ್ಲಾ ಕುದುರೆಗಳೂ ರಥಗಳೂ ಕುದುರೆ ಸವಾರರೂ ಅವನ ಸೈನ್ಯವೂ ಪೀಹಹೀರೋತಿನ ಸಮೀಪದಲ್ಲಿ ಬಾಲ್ಜೆಫೋನಿನ ಎದುರಾಗಿ ಇಸ್ರಾಯೇಲರನ್ನು ಸಮೀಪಿಸಿದರು.<verse eid="EXO 14:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="EXO 14:10"/>ಫರೋಹನು ಸಮೀಪಕ್ಕೆ ಬರುವುದನ್ನು ಇಸ್ರಾಯೇಲರು ಕಣ್ಣೆತ್ತಿ ನೋಡಿದರು. ಈಜಿಪ್ಟಿನವರು ಅವರ ಹಿಂದೆ ಬರುತ್ತಿರುವುದನ್ನು ಕಂಡು ಇಸ್ರಾಯೇಲರು ಬಹಳ ಭಯಪಟ್ಟು ಯೆಹೋವ ದೇವರಿಗೆ ಮೊರೆಯಿಟ್ಟರು. <verse eid="EXO 14:10"/><verse number="11" style="v" sid="EXO 14:11"/>ಅವರು ಮೋಶೆಗೆ, “ಈಜಿಪ್ಟಿನಲ್ಲಿ ಸಮಾಧಿಗಳು ಇಲ್ಲದ ಕಾರಣ ನಾವು ಮರುಭೂಮಿಯಲ್ಲಿ ಸಾಯುವ ಹಾಗೆ ನಮ್ಮನ್ನು ಕರೆದುಕೊಂಡು ಬಂದೆಯೋ? ಏಕೆ ನೀನು ಈ ಪ್ರಕಾರ ನಮಗೆ ಮಾಡಿ, ನಮ್ಮನ್ನು ಈಜಿಪ್ಟಿನಿಂದ ಕರೆದುಕೊಂಡು ಬಂದೆ? <verse eid="EXO 14:11"/><verse number="12" style="v" sid="EXO 14:12"/>ನಾವು ಈಜಿಪ್ಟ್ ದೇಶದಲ್ಲಿದ್ದಾಗಲೇ, ‘ನೀನು ನಮ್ಮ ಗೊಡವೆಗೆ ಬರಬೇಡ, ನಾವು ಈಜಿಪ್ಟಿನವರಿಗೆ ಸೇವೆಮಾಡುತ್ತೇವೆ,’ ಎಂದು ನಿನಗೆ ಹೇಳಲಿಲ್ಲವೇ? ನಾವು ಮರುಭೂಮಿಯಲ್ಲಿ ಸಾಯುವುದಕ್ಕಿಂತ ಈಜಿಪ್ಟಿನವರಿಗೆ ಸೇವೆ ಮಾಡುವುದೇ ಒಳ್ಳೆಯದಾಗಿತ್ತಲ್ಲಾ?” ಎಂದು ಹೇಳಿದರು.<verse eid="EXO 14:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="EXO 14:13"/>ಅದಕ್ಕೆ ಮೋಶೆಯು ಜನರಿಗೆ, “ನೀವು ಭಯಪಡಬೇಡಿರಿ, ದೃಢವಾಗಿ ನಿಲ್ಲಿರಿ. ಯೆಹೋವ ದೇವರು ನಿಮಗೆ ಈ ಹೊತ್ತು ತೋರಿಸುವ ರಕ್ಷಣೆಯನ್ನು ನೋಡಿರಿ. ನೀವು ಈ ಹೊತ್ತು ನೋಡುವ ಈಜಿಪ್ಟಿನವರನ್ನು ಇನ್ನು ಮುಂದೆ ಎಂದೆಂದಿಗೂ ನೋಡುವುದಿಲ್ಲ. <verse eid="EXO 14:13"/><verse number="14" style="v" sid="EXO 14:14"/>ಯೆಹೋವ ದೇವರು ನಿಮಗೋಸ್ಕರ ಯುದ್ಧಮಾಡುವರು, ಆದರೆ ನೀವು ವಿಶ್ರಾಂತಿಯಿಂದಿರಿ,” ಎಂದನು.<verse eid="EXO 14:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="EXO 14:15"/>ಆಗ ಯೆಹೋವ ದೇವರು ಮೋಶೆಗೆ, “ನೀನು ನನಗೆ ಮೊರೆಯಿಡುವುದೇನು? ಇಸ್ರಾಯೇಲರಿಗೆ ಮುಂದಕ್ಕೆ ಹೊರಡಬೇಕೆಂದು ಹೇಳು. <verse eid="EXO 14:15"/><verse number="16" style="v" sid="EXO 14:16"/>ನೀನು ನಿನ್ನ ಕೋಲನ್ನು ಎತ್ತಿ, ನಿನ್ನ ಕೈಯನ್ನು ಸಮುದ್ರದ ಮೇಲೆ ಚಾಚಿ, ಅದನ್ನು ವಿಭಾಗಿಸು. ಆಗ ಇಸ್ರಾಯೇಲರು ಸಮುದ್ರದ ಮಧ್ಯದಲ್ಲಿ ಒಣಗಿದ ನೆಲದ ಮೇಲೆ ಹೋಗುವರು. <verse eid="EXO 14:16"/><verse number="17" style="v" sid="EXO 14:17"/>ನಾನು ಈಜಿಪ್ಟಿನವರ ಹೃದಯವನ್ನು ಕಠಿಣ ಮಾಡುತ್ತೇನೆ. ಅವರು ಇವರನ್ನು ಹಿಂದಟ್ಟುವರು. ಇದಲ್ಲದೆ ಫರೋಹನ ಮೇಲೆಯೂ ಅವನ ಎಲ್ಲಾ ಸೈನ್ಯದ ಮೇಲೆಯೂ ಅವನ ರಥಗಳ ಮೇಲೆಯೂ ಕುದುರೆಯ ಸವಾರರ ಮೇಲೆಯೂ ನನ್ನನ್ನು ಘನಪಡಿಸಿಕೊಳ್ಳುವೆನು. <verse eid="EXO 14:17"/><verse number="18" style="v" sid="EXO 14:18"/>ನಾನು ಫರೋಹನ ಮೇಲೆಯೂ ಅವನ ರಥಗಳ ಮೇಲೆಯೂ ಅವನ ಕುದುರೆ ಸವಾರರ ಮೇಲೆಯೂ ನನ್ನನ್ನು ಘನಪಡಿಸಿಕೊಂಡಾಗ, ನಾನೇ ಯೆಹೋವ ದೇವರೆಂದು ಈಜಿಪ್ಟಿನವರು ತಿಳಿದುಕೊಳ್ಳುವರು,” ಎಂದರು.<verse eid="EXO 14:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="EXO 14:19"/>ಆಗ ಇಸ್ರಾಯೇಲ್ ದಂಡಿನ ಮುಂದೆ ಹೋಗುತ್ತಿದ್ದ ದೇವದೂತನು ತನ್ನ ಸ್ಥಳವನ್ನು ಬಿಟ್ಟು ಅವರ ಹಿಂದೆ ಬಂದನು. ಅವರ ಮುಂದೆ ಇದ್ದ ಮೇಘಸ್ತಂಭವು ಅಲ್ಲಿಂದ ಬಂದು ಅವರ ಹಿಂದೆ ನಿಂತುಕೊಂಡಿತು. <verse eid="EXO 14:19"/><verse number="20" style="v" sid="EXO 14:20"/>ಅದು ಈಜಿಪ್ಟಿನ ದಂಡಿಗೂ ಇಸ್ರಾಯೇಲರ ದಂಡಿಗೂ ನಡುವೆ ಬಂದಿತು. ಮೇಘಸ್ತಂಭವು ಈಜಿಪ್ಟಿನವರಿಗೆ ಕತ್ತಲನ್ನೂ ಇಸ್ರಾಯೇಲರಿಗೆ ಬೆಳಕನ್ನೂ ನೀಡಿತು. ಆ ರಾತ್ರಿಯೆಲ್ಲಾ ಒಬ್ಬರ ಹತ್ತಿರ ಒಬ್ಬರು ಬರಲಾಗಲಿಲ್ಲ.<verse eid="EXO 14:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="EXO 14:21"/>ಆಗ ಮೋಶೆಯು ಸಮುದ್ರದ ಮೇಲೆ ತನ್ನ ಬಲಗೈಯನ್ನು ಚಾಚಲಾಗಿ, ಯೆಹೋವ ದೇವರು ರಾತ್ರಿಯೆಲ್ಲಾ ಬಲವಾದ ಪೂರ್ವದಿಕ್ಕಿನ ಗಾಳಿಯಿಂದ ಸಮುದ್ರವನ್ನು ಹಿಂದಕ್ಕೆ ಹೋಗುವಂತೆ ಸಮುದ್ರವನ್ನು ಸರಿಸಿ, ಒಣ ನೆಲ ಕಾಣಿಸುವಂತೆ ಮಾಡಿದರು. ಆಗ ನೀರು ವಿಭಾಗವಾಯಿತು. <verse eid="EXO 14:21"/><verse number="22" style="v" sid="EXO 14:22"/>ಹೀಗೆ ಇಸ್ರಾಯೇಲರು ಸಮುದ್ರದ ಮಧ್ಯದಲ್ಲಿ ಒಣಗಿದ ನೆಲದ ಮೇಲೆ ನಡೆದುಹೋದರು. ನೀರು ಅವರಿಗೆ ಎಡಗಡೆ ಮತ್ತು ಬಲಗಡೆಗಳಲ್ಲಿ ಗೋಡೆಯಾಗಿ ನಿಂತಿತ್ತು.<verse eid="EXO 14:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="EXO 14:23"/>ಈಜಿಪ್ಟಿನವರೂ ಫರೋಹನ ಎಲ್ಲಾ ಕುದುರೆಗಳೂ ಅವನ ರಥಗಳೂ ಕುದುರೆ ಸವಾರರೂ ಅವರನ್ನು ಹಿಂದಟ್ಟಿ, ಅವರ ಹಿಂದೆ ಸಮುದ್ರದ ಮಧ್ಯದಲ್ಲಿ ಸೇರಿದರು. <verse eid="EXO 14:23"/><verse number="24" style="v" sid="EXO 14:24"/>ಬೆಳಗಿನ ಜಾವದಲ್ಲಿ ಯೆಹೋವ ದೇವರು ಅಗ್ನಿ ಮೇಘಗಳ ಸ್ತಂಭದೊಳಗಿಂದ ಈಜಿಪ್ಟಿನ ದಂಡಿನ ಮೇಲೆ ದೃಷ್ಟಿಯಿಟ್ಟು, ಈಜಿಪ್ಟಿನ ದಂಡನ್ನು ಗಾಬರಿಗೊಳಿಸಿದರು. <verse eid="EXO 14:24"/><verse number="25" style="v" sid="EXO 14:25"/>ಅವರ ರಥಗಳ ಚಕ್ರಗಳನ್ನು ತೆಗೆದುಬಿಟ್ಟು ಕಷ್ಟದಿಂದ ಅವರು ಹೋಗುವಂತೆ ಮಾಡಿದರು. ಆಗ ಈಜಿಪ್ಟಿನವರು, “ಇಸ್ರಾಯೇಲರ ಎದುರಿನಿಂದ ಓಡಿಹೋಗೋಣ. ಏಕೆಂದರೆ ಯೆಹೋವ ದೇವರು ಈಜಿಪ್ಟಿನವರಿಗೆ ವಿರೋಧವಾಗಿ ಯುದ್ಧಮಾಡುತ್ತಾರೆ,” ಎಂದು ಹೇಳಿಕೊಂಡರು.<verse eid="EXO 14:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="EXO 14:26"/>ಆಗ ಯೆಹೋವ ದೇವರು ಮೋಶೆಗೆ, “ಈಜಿಪ್ಟಿನವರನ್ನೂ ಅವರ ರಥಗಳ ಕುದುರೆಯ ಸವಾರರನ್ನೂ ಸಮುದ್ರವು ಮುಳುಗಿಸುವಂತೆ ಸಮುದ್ರದ ಮೇಲೆ ಕೈಚಾಚು,” ಎಂದರು. <verse eid="EXO 14:26"/><verse number="27" style="v" sid="EXO 14:27"/>ಆಗ ಮೋಶೆಯು ಸಮುದ್ರದ ಮೇಲೆ ಕೈಚಾಚಲಾಗಿ ಸಮುದ್ರವು ಬೆಳಗಾಗುವಾಗಲೇ ಮೊದಲಿನಂತೆ ತುಂಬಿಕೊಂಡಿತು. ಈಜಿಪ್ಟಿನವರು ಓಡಿಹೋಗುತ್ತಾ ಅದಕ್ಕೆ ಎದುರಾಗಿಯೇ ಬಂದರು. ಹೀಗೆ ಯೆಹೋವ ದೇವರು ಈಜಿಪ್ಟಿನವರನ್ನು ಸಮುದ್ರದೊಳಗೆ ಕೆಡವಿಬಿಟ್ಟರು. <verse eid="EXO 14:27"/><verse number="28" style="v" sid="EXO 14:28"/>ನೀರು ತಿರುಗಿಬಂದು ರಥಗಳೂ ಕುದುರೆಗಳೂ ಸವಾರರೂ ಅವರ ಹಿಂದೆ ಸಮುದ್ರದಲ್ಲಿ ಬರುತ್ತಿದ್ದ ಫರೋಹನ ಎಲ್ಲಾ ಸೈನ್ಯವೂ ಹೀಗೆ ಒಬ್ಬರೂ ಉಳಿಯದಂತೆ ಮುಳುಗಿಸಿತು.<verse eid="EXO 14:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="EXO 14:29"/>ಆದರೆ ಇಸ್ರಾಯೇಲರು ಸಮುದ್ರದ ಮಧ್ಯದಲ್ಲಿದ್ದ ಒಣಗಿದ ನೆಲದ ಮೇಲೆ ನಡೆದುಹೋದರು. ನೀರು ಅವರಿಗೆ ಎಡಗಡೆ ಮತ್ತು ಬಲಗಡೆಗಳಲ್ಲಿ ಗೋಡೆಯಂತಿತ್ತು. <verse eid="EXO 14:29"/><verse number="30" style="v" sid="EXO 14:30"/>ಆ ದಿನದಲ್ಲಿ ಯೆಹೋವ ದೇವರು ಈ ಪ್ರಕಾರ ಇಸ್ರಾಯೇಲರನ್ನು ಈಜಿಪ್ಟಿನವರ ಕೈಯಿಂದ ರಕ್ಷಿಸಿದರು. ಇಸ್ರಾಯೇಲರು ಸಮುದ್ರ ತೀರದಲ್ಲಿ ಸತ್ತ ಈಜಿಪ್ಟಿನವರನ್ನು ನೋಡಿದರು. <verse eid="EXO 14:30"/><verse number="31" style="v" sid="EXO 14:31"/>ಈಜಿಪ್ಟಿನವರ ಮೇಲೆ ಯೆಹೋವ ದೇವರು ಮಾಡಿದ ದೊಡ್ಡ ಕಾರ್ಯವನ್ನು ನೋಡಿದಾಗ, ಇಸ್ರಾಯೇಲರು ಯೆಹೋವ ದೇವರಿಗೆ ಭಯಪಟ್ಟು, ಅವರಲ್ಲಿಯೂ ಅವರ ಸೇವಕನಾದ ಮೋಶೆಯಲ್ಲಿಯೂ ನಂಬಿಕೆಯಿಟ್ಟರು.<verse eid="EXO 14:31"/></para>
  <chapter eid="EXO 14"/>
  <chapter number="15" style="c" sid="EXO 15"/>
  <para style="s1">ಮೋಶೆ ಮತ್ತು ಮಿರ್ಯಾಮಳು ಹಾಡಿದ ಗೀತೆ</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 15:1"/>ಆಗ ಮೋಶೆ ಮತ್ತು ಇಸ್ರಾಯೇಲರು ಯೆಹೋವ ದೇವರಿಗೆ ಈ ಹಾಡನ್ನು ಹಾಡಿದರು:</para>
  <para style="q1" vid="EXO 15:1">“ನಾನು ಯೆಹೋವ ದೇವರಿಗೆ ಹಾಡುತ್ತೇನೆ.</para>
  <para style="q2" vid="EXO 15:1">ಏಕೆಂದರೆ ಅವರು ಪ್ರಭಾವದಿಂದ ಜಯಶಾಲಿಯಾದರು.</para>
  <para style="q2" vid="EXO 15:1">ಕುದುರೆಗಳನ್ನೂ ರಾಹುತರನ್ನೂ ಸಮುದ್ರದಲ್ಲಿ ದಬ್ಬಿದ್ದಾರೆ.<verse eid="EXO 15:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="EXO 15:2"/>“ಯೆಹೋವ ದೇವರು ನನ್ನ ಬಲವೂ ಕೀರ್ತನೆಯೂ ಆಗಿದ್ದಾರೆ;</para>
  <para style="q2" vid="EXO 15:2">ಅವರು ನನ್ನ ರಕ್ಷಣೆಯಾದರು;</para>
  <para style="q1" vid="EXO 15:2">ಅವರು ನನ್ನ ದೇವರು, ಅವರನ್ನು ಕೊಂಡಾಡುವೆನು;</para>
  <para style="q2" vid="EXO 15:2">ಅವರು ನನ್ನ ತಂದೆಯ ದೇವರು, ನಾನು ಅವರನ್ನು ಘನಪಡಿಸುವೆನು.<verse eid="EXO 15:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="EXO 15:3"/>ಯೆಹೋವ ದೇವರು ಯುದ್ಧವೀರರು;</para>
  <para style="q2" vid="EXO 15:3">ಯೆಹೋವ ದೇವರು ಎಂಬುದೇ ಅವರ ಹೆಸರು.<verse eid="EXO 15:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="EXO 15:4"/>ಅವರು ಫರೋಹನ ರಥಗಳನ್ನೂ,</para>
  <para style="q2" vid="EXO 15:4">ಅವನ ಸ್ಯೆನ್ಯವನ್ನೂ ಸಮುದ್ರದಲ್ಲಿ ಅಲ್ಲಾಡಿಸಿ ಎಸೆದಿದ್ದಾರೆ.</para>
  <para style="q1" vid="EXO 15:4">ಫರೋಹನ ಅತ್ಯುತ್ತಮ ಅಧಿಕಾರಿಗಳು ಸಹ</para>
  <para style="q2" vid="EXO 15:4">ಕೆಂಪು ಸಮುದ್ರದಲ್ಲಿ ಮುಳುಗಿ ಹೋದರು.<verse eid="EXO 15:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="EXO 15:5"/>ಆಳವಾದ ಜಲರಾಶಿ ಅವರನ್ನು ಮುಚ್ಚಿಕೊಂಡವು.</para>
  <para style="q2" vid="EXO 15:5">ಅವರು ಕಲ್ಲಿನಂತೆ ಸಮುದ್ರದ ತಳಕ್ಕೆ ಮುಳುಗಿದರು.<verse eid="EXO 15:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="EXO 15:6"/>ಯೆಹೋವ ದೇವರೇ, ನಿಮ್ಮ ಬಲಗೈ</para>
  <para style="q2" vid="EXO 15:6">ಶಕ್ತಿಯಲ್ಲಿ ಮಹಿಮೆಯುಳ್ಳದ್ದಾಗಿದೆ;</para>
  <para style="q1" vid="EXO 15:6">ಯೆಹೋವ ದೇವರೇ, ನಿಮ್ಮ ಬಲಗೈ</para>
  <para style="q2" vid="EXO 15:6">ಶತ್ರುವನ್ನು ಜಜ್ಜಿ ಪುಡಿ ಮಾಡಿತು.<verse eid="EXO 15:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="EXO 15:7"/>“ನಿಮ್ಮ ಮಹತ್ತಾದ ಘನತೆಯಲ್ಲಿ</para>
  <para style="q2" vid="EXO 15:7">ನಿಮಗೆ ವಿರೋಧವಾಗಿ ಎದ್ದವರನ್ನು ಕೆಡವಿಬಿಟ್ಟಿರುವಿರಿ.</para>
  <para style="q1" vid="EXO 15:7">ನಿಮ್ಮ ಕೋಪವು ಬೆಂಕಿಯಂತೆ ಕಾರಿದೆ;</para>
  <para style="q2" vid="EXO 15:7">ಅದು ಅವರನ್ನು ಕೋಲಿನಂತೆ ದಹಿಸಿತು.<verse eid="EXO 15:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="EXO 15:8"/>ನೀವು ಬೀಸಿದ ಬಿರುಸಾದ ಗಾಳಿಯಿಂದ</para>
  <para style="q2" vid="EXO 15:8">ನೀರು ಒಟ್ಟುಗೂಡಿದವು.</para>
  <para style="q1" vid="EXO 15:8">ಪ್ರವಾಹಗಳು ರಾಶಿಯಂತೆ ನಿಂತವು.</para>
  <para style="q2" vid="EXO 15:8">ಜಲರಾಶಿಗಳು ಸಮುದ್ರದ ಮಧ್ಯದಲ್ಲಿ ಗಟ್ಟಿಯಾದವು.<verse eid="EXO 15:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="EXO 15:9"/>ಶತ್ರುವು ಹೆಮ್ಮೆಯಿಂದ ಹೀಗೆ ಮಾತನಾಡಿಕೊಳ್ಳುತ್ತಿದ್ದರು,</para>
  <para style="q2" vid="EXO 15:9">‘ನಾನು ಹಿಂದಟ್ಟುವೆನು, ಅವರನ್ನು ಹಿಡಿಯುವೆನು,</para>
  <para style="q1" vid="EXO 15:9">ನಾನು ಅವರ ಕೊಳ್ಳೆಯನ್ನು ಹಂಚುವೆನು;</para>
  <para style="q2" vid="EXO 15:9">ನನ್ನ ಆಶೆಗಳು ಅವರಿಂದ ತೃಪ್ತಿ ಹೊಂದುವುವು;</para>
  <para style="q1" vid="EXO 15:9">ನಾನು ನನ್ನ ಖಡ್ಗವನ್ನು ಹಿರಿಯುವೆನು;</para>
  <para style="q2" vid="EXO 15:9">ನನ್ನ ಕೈ ಅವರನ್ನು ಸಂಹಾರ ಮಾಡುವುದು.’<verse eid="EXO 15:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="EXO 15:10"/>ನೀವು ನಿಮ್ಮ ಶ್ವಾಸ ಊದಿದಾಗ</para>
  <para style="q2" vid="EXO 15:10">ಸಮುದ್ರವು ಅವರನ್ನು ನುಂಗಿಕೊಂಡಿತು.</para>
  <para style="q1" vid="EXO 15:10">ಅವರು ಸೀಸದಂತೆ</para>
  <para style="q2" vid="EXO 15:10">ಮಹಾಸಾಗರದಲ್ಲಿ ಮುಳುಗಿ ಹೋದರು.<verse eid="EXO 15:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="EXO 15:11"/>ಯೆಹೋವ ದೇವರೇ,</para>
  <para style="q2" vid="EXO 15:11">ನಿಮ್ಮ ಹಾಗೆ ಯಾರಿದ್ದಾರೆ?</para>
  <para style="q1" vid="EXO 15:11">ಪರಿಶುದ್ಧತ್ವದಲ್ಲಿ ವೈಭವ ಹೊಂದಿದವರೂ,</para>
  <para style="q2" vid="EXO 15:11">ಮಹಿಮೆಯಲ್ಲಿ ಅತಿಶಯರೂ,</para>
  <para style="q1" vid="EXO 15:11">ಅದ್ಭುತಗಳನ್ನು ಮಾಡುವವರೂ ಆದ</para>
  <para style="q2" vid="EXO 15:11">ನಿಮ್ಮ ಹಾಗೆ ಯಾರಿದ್ದಾರೆ?<verse eid="EXO 15:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="EXO 15:12"/>“ನೀವು ನಿಮ್ಮ ಬಲಗೈಯನ್ನು ಚಾಚಲು</para>
  <para style="q2" vid="EXO 15:12">ಭೂಮಿಯು ಅವರನ್ನು ನುಂಗಿತು.<verse eid="EXO 15:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="EXO 15:13"/>ನೀವು ವಿಮೋಚಿಸಿದ ಜನರನ್ನು</para>
  <para style="q2" vid="EXO 15:13">ನೀವು ನಿಮ್ಮ ಪ್ರೀತಿಯಿಂದ ನಡೆಸಿದ್ದೀರಿ.</para>
  <para style="q1" vid="EXO 15:13">ನೀವು ಅವರನ್ನು ನಿಮ್ಮ ಬಲದಿಂದ</para>
  <para style="q2" vid="EXO 15:13">ನಿಮ್ಮ ಪರಿಶುದ್ಧ ನಿವಾಸಕ್ಕೆ ನಡೆಸಿದ್ದೀರಿ.<verse eid="EXO 15:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="EXO 15:14"/>ಜನರು ಇದನ್ನು ಕೇಳಿದಾಗ ಭಯಪಡುವರು.</para>
  <para style="q2" vid="EXO 15:14">ದುಃಖವು ಫಿಲಿಷ್ಟಿಯದಲ್ಲಿ ವಾಸಿಸುವವರನ್ನು ಹಿಡಿಯುವುದು.<verse eid="EXO 15:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="EXO 15:15"/>ಆಗ ಎದೋಮಿನ ಪ್ರಭುಗಳು ದಿಗ್ಭ್ರಮೆಗೊಳ್ಳುವರು;</para>
  <para style="q2" vid="EXO 15:15">ಕಂಪನವು ಮೋವಾಬಿನ ಬಲಿಷ್ಠರನ್ನು ಹಿಡಿಯುವುದು;</para>
  <para style="q1" vid="EXO 15:15">ಕಾನಾನಿನ ನಿವಾಸಿಗಳೆಲ್ಲಾ<note caller="+" style="f"><char style="fr" closed="false">15:15 </char><char style="ft" closed="false">ಅಥವಾ </char><char style="fqa" closed="false">ಆಳುವ</char></note> ಕರಗಿ ಹೋಗುವರು.<verse eid="EXO 15:15"/></para>
  <para style="q2">
    <verse number="16" style="v" sid="EXO 15:16"/>ಭಯವೂ ಹೆದರಿಕೆಯೂ ಅವರಿಗಾಗುವುದು;</para>
  <para style="q1" vid="EXO 15:16">ನಿಮ್ಮ ಜನರು ದಾಟಿ ಹೋಗುವವರೆಗೆ ಯೆಹೋವ ದೇವರೇ,</para>
  <para style="q2" vid="EXO 15:16">ನೀವು ಕೊಂಡುಕೊಂಡ<note caller="+" style="f"><char style="fr" closed="false">15:16 </char><char style="ft" closed="false">ಅಥವಾ </char><char style="fqa" closed="false">ಸೃಷ್ಟಿಸಿದ</char></note> ಜನರು ದಾಟಿಹೋಗುವವರೆಗೆ</para>
  <para style="q1" vid="EXO 15:16">ನಿಮ್ಮ ಬಾಹುವಿನ ದೊಡ್ಡಸ್ತಿಕೆಯಿಂದ</para>
  <para style="q2" vid="EXO 15:16">ಅವರು ಕಲ್ಲಿನಂತೆ ಸ್ತಬ್ಧರಾಗಿರುವರು.<verse eid="EXO 15:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="EXO 15:17"/>ಅವರನ್ನು ಒಳಗೆ ಬರಮಾಡಿ, ಯೆಹೋವ ದೇವರೇ,</para>
  <para style="q2" vid="EXO 15:17">ನಿಮ್ಮ ಕೈಗಳು ಸ್ಥಾಪಿಸಿದ ಪರಿಶುದ್ಧ ನಿವಾಸದಲ್ಲಿಯೂ</para>
  <para style="q1" vid="EXO 15:17">ಯೆಹೋವ ದೇವರೇ, ನೀವು ವಾಸಿಸುವುದಕ್ಕೆ ಮಾಡಿಕೊಂಡಿರುವ</para>
  <para style="q2" vid="EXO 15:17">ನಿಮ್ಮ ಸ್ವತ್ತಾಗಿರುವ ಪರ್ವತದಲ್ಲಿಯೂ ಅವರನ್ನು ಸ್ಥಾಪಿಸುವಿರಿ.<verse eid="EXO 15:17"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="18" style="v" sid="EXO 15:18"/>“ಯೆಹೋವ ದೇವರು</para>
  <para style="q2" vid="EXO 15:18">ಯುಗಯುಗಾಂತರಗಳವರೆಗೆ ಆಳುವರು.”<verse eid="EXO 15:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="EXO 15:19"/>ಫರೋಹನ ಕುದುರೆಗಳು ಅವನ ರಥಗಳ ಮತ್ತು ಸವಾರರ ಸಂಗಡ ಸಮುದ್ರದೊಳಗೆ ಬಂದಾಗ, ಯೆಹೋವ ದೇವರು ಸಮುದ್ರದ ನೀರನ್ನು ಅವರ ಮೇಲೆ ತಿರುಗಿ ಬರಮಾಡಿದರು. ಆದರೆ ಇಸ್ರಾಯೇಲರು ಸಮುದ್ರದ ಮಧ್ಯದಲ್ಲಿನ ಒಣನೆಲದ ಮೇಲೆ ದಾಟಿಹೋದರು. <verse eid="EXO 15:19"/><verse number="20" style="v" sid="EXO 15:20"/>ಆಗ ಪ್ರವಾದಿನಿಯಾಗಿದ್ದ ಆರೋನನ ಸಹೋದರಿ ಮಿರ್ಯಾಮಳು ಕೈಯಲ್ಲಿ ತಾಳವನ್ನು ತೆಗೆದುಕೊಂಡಳು. ಸ್ತ್ರೀಯರೆಲ್ಲರೂ ತಾಳಗಳನ್ನು ಹಿಡಿದುಕೊಂಡು ನಾಟ್ಯವಾಡುತ್ತಾ, ಆಕೆಯನ್ನು ಹಿಂಬಾಲಿಸಿ ಹೊರಹೊರಟರು. <verse eid="EXO 15:20"/><verse number="21" style="v" sid="EXO 15:21"/>ಮಿರ್ಯಾಮಳು ಅವರಿಗೆ ಹೀಗೆ ಹಾಡಿದಳು:</para>
  <para style="q1" vid="EXO 15:21">“ಯೆಹೋವ ದೇವರಿಗೆ ನೀವು ಹಾಡಿರಿ,</para>
  <para style="q2" vid="EXO 15:21">ಅವರು ಮಹೋನ್ನತದಲ್ಲಿದ್ದಾರೆ;</para>
  <para style="q1" vid="EXO 15:21">ಕುದುರೆಯನ್ನೂ ಸವಾರರನ್ನೂ</para>
  <para style="q2" vid="EXO 15:21">ಸಮುದ್ರದಲ್ಲಿ ಮುಣುಗಿಸಿಬಿಟ್ಟರು.”<verse eid="EXO 15:21"/></para>
  <para style="s1">ಕಹಿ ನೀರು ಸಿಹಿಯಾದದ್ದು</para>
  <para style="p">
    <verse number="22" style="v" sid="EXO 15:22"/>ಆಮೇಲೆ ಮೋಶೆಯು ಇಸ್ರಾಯೇಲರನ್ನು ಕೆಂಪು ಸಮುದ್ರದಿಂದ ನಡೆಸಿದನು. ಅವರು ಶೂರಿನ ಮರುಭೂಮಿಯೊಳಗೆ ಹೋದರು. ಅವರು ಮರುಭೂಮಿಯಲ್ಲಿ ಮೂರು ದಿನಗಳು ಪ್ರಯಾಣಮಾಡಿದರೂ ನೀರನ್ನು ಕಂಡುಕೊಳ್ಳಲಿಲ್ಲ. <verse eid="EXO 15:22"/><verse number="23" style="v" sid="EXO 15:23"/>ಅವರು ಮಾರಾ ಎಂಬಲ್ಲಿಗೆ ಬಂದ ಮೇಲೆ ಅಲ್ಲಿಯ ನೀರನ್ನು ಕುಡಿಯಲಾರದೆ ಇದ್ದರು; ಅದು ಕಹಿಯಾಗಿತ್ತು. ಆದಕಾರಣ ಅದರ ಹೆಸರು “ಮಾರಾ” ಎಂದು ಕರೆಯಲಾಯಿತು. <verse eid="EXO 15:23"/><verse number="24" style="v" sid="EXO 15:24"/>ಆದ್ದರಿಂದ ಜನರು, “ನಾವು ಏನು ಕುಡಿಯೋಣ?” ಎಂದು ಹೇಳಿ, ಮೋಶೆಗೆ ವಿರೋಧವಾಗಿ ಗೊಣಗುಟ್ಟಿದರು.<verse eid="EXO 15:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="EXO 15:25"/>ಅವನು ಯೆಹೋವ ದೇವರಿಗೆ ಮೊರೆಯಿಟ್ಟನು. ಯೆಹೋವ ದೇವರು ಅವನಿಗೆ ಒಂದು ಗಿಡವನ್ನು ತೋರಿಸಿದರು. ಅವನು ಅದನ್ನು ನೀರಿನಲ್ಲಿ ಹಾಕಿದಾಗ, ನೀರು ಸಿಹಿಯಾಗಿ ಬಿಟ್ಟಿತು.</para>
  <para style="p" vid="EXO 15:25">ಅಲ್ಲಿ ದೇವರು ಅವರಿಗಾಗಿ ಒಂದು ನಿಯಮವನ್ನೂ ಒಂದು ಶಾಸನವನ್ನೂ ಮಾಡಿದರು. ಅಲ್ಲಿಯೇ ದೇವರು ಅವರನ್ನು ಪರೀಕ್ಷಿಸಿದರು. <verse eid="EXO 15:25"/><verse number="26" style="v" sid="EXO 15:26"/>ದೇವರು, “ನೀವು ನಿಮ್ಮ ದೇವರಾದ ಯೆಹೋವ ದೇವರ ಮಾತಿಗೆ ಶ್ರದ್ಧೆಯಿಂದ ಕಿವಿಗೊಟ್ಟು, ಅವರ ದೃಷ್ಟಿಯಲ್ಲಿ ಸರಿಯಾದದ್ದನ್ನು ಮಾಡಿ, ಅವರ ಆಜ್ಞೆಗಳಿಗೆ ಕಿವಿಗೊಟ್ಟು, ಅವರ ನಿಯಮಗಳನ್ನು ಕೈಗೊಂಡರೆ, ಈಜಿಪ್ಟಿನ ಮೇಲೆ ಬರಮಾಡಿದ ಯಾವ ವ್ಯಾಧಿಯನ್ನೂ ನಿಮ್ಮ ಮೇಲೆ ಬರಮಾಡುವುದಿಲ್ಲ. ನಿಮ್ಮನ್ನು ಸ್ವಸ್ಥಪಡಿಸುವ ಯೆಹೋವ ದೇವರು ನಾನೇ ಆಗಿದ್ದೇನೆ,” ಎಂದು ಪ್ರಕಟಪಡಿಸಿದರು.<verse eid="EXO 15:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="EXO 15:27"/>ತರುವಾಯ ಇಸ್ರಾಯೇಲರು ಏಲೀಮಿಗೆ ಬಂದರು. ಅಲ್ಲಿ ಹನ್ನೆರಡು ನೀರಿನ ಬಾವಿಗಳೂ ಎಪ್ಪತ್ತು ಖರ್ಜೂರದ ಮರಗಳೂ ಇದ್ದವು. ಅವರು ಆ ನೀರಿನ ಬಳಿಯಲ್ಲಿ ಇಳಿದುಕೊಂಡರು.<verse eid="EXO 15:27"/></para>
  <chapter eid="EXO 15"/>
  <chapter number="16" style="c" sid="EXO 16"/>
  <para style="s1">ಮನ್ನ ಮತ್ತು ಲಾವಕ್ಕಿ</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 16:1"/>ಇಸ್ರಾಯೇಲರ ಸಭೆಯೆಲ್ಲಾ ಏಲೀಮಿನಿಂದ ಪ್ರಯಾಣಮಾಡಿ, ಈಜಿಪ್ಟ್ ದೇಶದಿಂದ ಹೊರಟ ಎರಡನೆಯ ತಿಂಗಳಿನ ಹದಿನೈದನೆಯ ದಿನದಲ್ಲಿ ಏಲೀಮಿಗೂ, ಸೀನಾಯಿ ಪರ್ವತಕ್ಕೂ ಮಧ್ಯೆ ಇರುವ ಸೀನ್ ಮರುಭೂಮಿಗೆ ಬಂದರು. <verse eid="EXO 16:1"/><verse number="2" style="v" sid="EXO 16:2"/>ಆಗ ಇಸ್ರಾಯೇಲರ ಸಭೆಯೆಲ್ಲಾ ಮರುಭೂಮಿಯಲ್ಲಿ ಮೋಶೆ ಮತ್ತು ಆರೋನರ ವಿರೋಧವಾಗಿ ಗೊಣಗುಟ್ಟಿದರು. <verse eid="EXO 16:2"/><verse number="3" style="v" sid="EXO 16:3"/>ಇಸ್ರಾಯೇಲರು ಅವರಿಗೆ, “ನಾವು ಈಜಿಪ್ಟ್ ದೇಶದಲ್ಲಿ ಮಾಂಸದ ಪಾತ್ರೆಗಳ ಬಳಿಯಲ್ಲಿ ಕುಳಿತುಕೊಂಡು ಸಾಕಾಗುವಷ್ಟು ರೊಟ್ಟಿಯನ್ನು ತಿನ್ನುತ್ತಿದ್ದಾಗ, ಯೆಹೋವ ದೇವರ ಕೈಯಿಂದ ಸತ್ತು ಹೋಗಿದ್ದರೆ ಒಳ್ಳೆಯದಾಗಿತ್ತು. ಇಡೀ ಜನಾಂಗವೇ ಹಸಿವೆಯಿಂದ ಸತ್ತು ಹೋಗುವಂತೆ ನಮ್ಮನ್ನು ಈ ಮರುಭೂಮಿಗೆ ಬರಮಾಡಿದ್ದೀರಿ,” ಎಂದರು.<verse eid="EXO 16:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="EXO 16:4"/>ಆಗ ಯೆಹೋವ ದೇವರು ಮೋಶೆಗೆ, “ನಾನು ರೊಟ್ಟಿಯನ್ನು ನಿಮಗಾಗಿ ಆಕಾಶದಿಂದ ಸುರಿಸುತ್ತೇನೆ. ಜನರು ಹೊರಗೆ ಹೋಗಿ ಪ್ರತಿದಿನ ಆ ದಿನಕ್ಕೆ ಬೇಕಾದದ್ದನ್ನು ಕೂಡಿಸಲಿ. ಇದರಿಂದ ಅವರು ನನ್ನ ಆಜ್ಞೆಗಳನ್ನು ಕೈಗೊಳ್ಳುವರೋ, ಇಲ್ಲವೋ ಎಂಬುದನ್ನು ಪರೀಕ್ಷಿಸುತ್ತೇನೆ. <verse eid="EXO 16:4"/><verse number="5" style="v" sid="EXO 16:5"/>ಆರನೆಯ ದಿವಸದಲ್ಲಿ ಮಾತ್ರ ಅವರು ತಂದದ್ದನ್ನು ಸಿದ್ಧಪಡಿಸಿಕೊಳ್ಳುವಾಗ, ಪ್ರತಿದಿನ ಕೂಡಿಸುವುದಕ್ಕಿಂತಲೂ ಎರಡರಷ್ಟಾಗಿರುವುದು,” ಎಂದು ಹೇಳಿದರು.<verse eid="EXO 16:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="EXO 16:6"/>ಆಗ ಮೋಶೆ, ಆರೋನರು ಇಸ್ರಾಯೇಲರಿಗೆಲ್ಲಾ, “ನಿಮ್ಮನ್ನು ಈಜಿಪ್ಟ್ ದೇಶದೊಳಗಿಂದ ಹೊರಗೆ ಬರಮಾಡಿದವರು ಯೆಹೋವ ದೇವರೇ, ಎಂದು ಸಾಯಂಕಾಲವಾದಾಗ ನಿಮಗೆ ತಿಳಿಯುವುದು. <verse eid="EXO 16:6"/><verse number="7" style="v" sid="EXO 16:7"/>ಬೆಳಿಗ್ಗೆ ಯೆಹೋವ ದೇವರ ಮಹಿಮೆಯನ್ನು ನೋಡುವಿರಿ. ಏಕೆಂದರೆ ಯೆಹೋವ ದೇವರಿಗೆ ವಿರೋಧವಾಗಿ ನೀವು ಗೊಣಗುಟ್ಟಿದ್ದನ್ನು ಅವರು ಕೇಳಿದ್ದಾರೆ. ನಮಗೆ ವಿರೋಧವಾಗಿ ನೀವು ಗೊಣಗುಟ್ಟುವ ಹಾಗೆ ನಾವು ಯಾರು?” ಎಂದರು. <verse eid="EXO 16:7"/><verse number="8" style="v" sid="EXO 16:8"/>ಮೋಶೆ ಮುಂದುವರಿಸಿ, “ಸಂಜೆಯಲ್ಲಿ ಯೆಹೋವ ದೇವರು ನಿಮಗೆ ಮಾಂಸಾಹಾರವನ್ನೂ, ಬೆಳಿಗ್ಗೆ ಬೇಕಾದಷ್ಟು ರೊಟ್ಟಿಯನ್ನೂ ಕೊಡುವರು. ನಿಮ್ಮ ಗೊಣಗುಟ್ಟುವಿಕೆಯು ಯೆಹೋವ ದೇವರಿಗೆ ಹೊರತು ನಮಗಲ್ಲ. ನಾವು ಎಷ್ಟು ಮಾತ್ರದವರು,” ಎಂದನು.<verse eid="EXO 16:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="EXO 16:9"/>ಅನಂತರ ಮೋಶೆ ಆರೋನನಿಗೆ, “ನೀನು ಇಸ್ರಾಯೇಲರ ಸಮೂಹಕ್ಕೆ, ‘ನಿಮ್ಮ ಗೊಣಗುಟ್ಟುವಿಕೆಯನ್ನು ಯೆಹೋವ ದೇವರು ಕೇಳಿದ್ದರಿಂದ ನೀವು ಅವರ ಮುಂದೆ ಬನ್ನಿರಿ,’ ಎಂದು ಹೇಳು,” ಎಂದನು.<verse eid="EXO 16:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="EXO 16:10"/>ಆರೋನನು ಇಸ್ರಾಯೇಲರ ಸಭೆಯ ಸಂಗಡ ಮಾತನಾಡುತ್ತಿದ್ದಾಗ ಅವರು ಮರುಭೂಮಿಯ ಕಡೆಗೆ ನೋಡಿದರು. ಆಗ, ಯೆಹೋವ ದೇವರ ಮಹಿಮೆಯು ಮೇಘದಲ್ಲಿ ಪ್ರತ್ಯಕ್ಷವಾಯಿತು.<verse eid="EXO 16:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="EXO 16:11"/>ಆಗ ಯೆಹೋವ ದೇವರು ಮೋಶೆಯ ಸಂಗಡ ಮಾತನಾಡಿ, <verse eid="EXO 16:11"/><verse number="12" style="v" sid="EXO 16:12"/>“ಇಸ್ರಾಯೇಲರ ಗೊಣಗುಟ್ಟುವಿಕೆಯನ್ನು ಕೇಳಿದ್ದೇನೆ. ಅವರ ಸಂಗಡ ನೀನು ಮಾತನಾಡಿ, ‘ನೀವು ಸಂಜೆಯಲ್ಲಿ ಮಾಂಸವನ್ನು ತಿನ್ನುವಿರಿ. ಬೆಳಿಗ್ಗೆ ರೊಟ್ಟಿಯಿಂದ ತೃಪ್ತರಾಗುವಿರಿ. ನಾನೇ ನಿಮ್ಮ ದೇವರಾದ ಯೆಹೋವ ದೇವರೆಂದು ತಿಳಿದುಕೊಳ್ಳುವಿರಿ,’ ಎಂದು ಅವರಿಗೆ ಹೇಳು,” ಎಂದರು.<verse eid="EXO 16:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="EXO 16:13"/>ಸಂಜೆಯಲ್ಲಿ ಲಾವಕ್ಕಿಗಳು ಬಂದು ಅವರ ಪಾಳೆಯವನ್ನು ಮುಚ್ಚಿಕೊಂಡವು. ಬೆಳಿಗ್ಗೆ ಮಂಜು ಪಾಳೆಯದ ಸುತ್ತಲೂ ಬಿದ್ದಿತ್ತು. <verse eid="EXO 16:13"/><verse number="14" style="v" sid="EXO 16:14"/>ಬಿದ್ದಿದ್ದ ಮಂಜು ಹೋದ ಮೇಲೆ, ಗಟ್ಟಿಯಾದ ಪದಾರ್ಥವು ಮಂಜಿನ ಹನಿಯಷ್ಟು ಚಿಕ್ಕದಾದದ್ದೂ, ಗುಂಡಾದದ್ದೂ ಮರುಭೂಮಿಯಲ್ಲಿ ಹರಡಿತ್ತು. <verse eid="EXO 16:14"/><verse number="15" style="v" sid="EXO 16:15"/>ಇಸ್ರಾಯೇಲರು ಅದನ್ನು ನೋಡಿದಾಗ ಅವರು, ಒಬ್ಬರಿಗೊಬ್ಬರು, “ಇದೇನು?” ಎಂದರು. ಏಕೆಂದರೆ ಅದು ಏನಾಗಿತ್ತೆಂದು ಅವರಿಗೆ ತಿಳಿಯಲಿಲ್ಲ.</para>
  <para style="p" vid="EXO 16:15">ಆಗ ಮೋಶೆಯು ಅವರಿಗೆ, “ಯೆಹೋವ ದೇವರು ನಿಮಗೆ ಕೊಟ್ಟಿರುವ ರೊಟ್ಟಿಯು ಇದೇ. <verse eid="EXO 16:15"/><verse number="16" style="v" sid="EXO 16:16"/>ಯೆಹೋವ ದೇವರು, ‘ಪ್ರತಿಯೊಬ್ಬನು ತಾನು ಎಷ್ಟು ತಿನ್ನುವನೋ ಅದರ ಪ್ರಕಾರ ಅದನ್ನು ಕೂಡಿಸಲಿ. ಪ್ರತಿಯೊಬ್ಬನಿಗೆ ಸುಮಾರು ಒಂದು ಕಿಲೋಗ್ರಾಂದಷ್ಟು<note caller="+" style="f"><char style="fr" closed="false">16:16 </char><char style="ft" closed="false">ಹೀಬ್ರೂ ಭಾಷೆಯಲ್ಲಿ </char><char style="fqa" closed="false">ಒಂದು ಓಮೆರ್, </char><char style="ft" closed="false">ಅಂದರೆ ಸುಮಾರು 1 ಕಿಲೋಗ್ರಾಂ</char></note> ನಿಮ್ಮ ಡೇರೆಗಳಲ್ಲಿರುವ ವ್ಯಕ್ತಿಗಳ ಲೆಕ್ಕದ ಪ್ರಕಾರ ನೀವು ತೆಗೆದುಕೊಳ್ಳಿರಿ,’ ಎಂದು ಹೇಳಿದ್ದಾರೆ,” ಎಂದನು.<verse eid="EXO 16:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="EXO 16:17"/>ಇಸ್ರಾಯೇಲರು ಅದರಂತೆ ಮಾಡಿ ಕೆಲವರು ಹೆಚ್ಚು, ಕೆಲವರು ಕಡಿಮೆ ಕೂಡಿಸಿದರು. <verse eid="EXO 16:17"/><verse number="18" style="v" sid="EXO 16:18"/>ಓಮೆರದಿಂದ ಅಳತೆಮಾಡಿದಾಗ, ಅತಿಯಾಗಿ ಕೂಡಿಸಿದವನಿಗೆ ಹೆಚ್ಚಾಗಲಿಲ್ಲ, ಮಿತವಾಗಿ ಕೂಡಿಸಿದವನಿಗೆ ಕೊರತೆಯಾಗಲಿಲ್ಲ. ಒಬ್ಬೊಬ್ಬನು ಊಟಮಾಡುವಷ್ಟು ಅವರು ಕೂಡಿಸಿದರು.<verse eid="EXO 16:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="EXO 16:19"/>ಮೋಶೆ ಅವರಿಗೆ, “ಇದನ್ನು ಯಾರೂ ಮರುದಿನದವರೆಗೆ ಇಟ್ಟುಕೊಳ್ಳಬಾರದು,” ಎಂದು ಹೇಳಿದನು.<verse eid="EXO 16:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="EXO 16:20"/>ಆದರೂ ಅವರು ಮೋಶೆಯ ಮಾತನ್ನು ಕೇಳಲಿಲ್ಲ. ಕೆಲವರು ಅದನ್ನು ಬೆಳಗಿನವರೆಗೆ ಇಟ್ಟುಕೊಂಡಾಗ, ಅದು ಹುಳ ಬಿದ್ದು ಹೊಲಸುವಾಸನೆ ಹುಟ್ಟಿತು. ಆಗ ಮೋಶೆಯು ಅವರ ಮೇಲೆ ಕೋಪಿಸಿಕೊಂಡನು.<verse eid="EXO 16:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="EXO 16:21"/>ಹೀಗೆ ಅವರಲ್ಲಿ ಪ್ರತಿಯೊಬ್ಬನು ತಿನ್ನುವಷ್ಟು ಪ್ರತಿದಿನದ ಬೆಳಿಗ್ಗೆ ಅದನ್ನು ಕೂಡಿಸುತ್ತಿದ್ದರು. ಬಿಸಿಲು ಬಹಳವಾದಾಗ ಅದು ಕರಗಿ ಹೋಗುತ್ತಿತ್ತು. <verse eid="EXO 16:21"/><verse number="22" style="v" sid="EXO 16:22"/>ಆರನೆಯ ದಿನದಲ್ಲಿ ಅವರು ಎರಡರಷ್ಟು ಅಂದರೆ ಒಬ್ಬನಿಗೆ ಎರಡು ಓಮೆರದಂತೆ ಕೂಡಿಸಿದ್ದರಿಂದ ಸಭೆಯ ಎಲ್ಲಾ ಅಧಿಕಾರಿಗಳು ಬಂದು ಮೋಶೆಗೆ ತಿಳಿಸಿದರು. <verse eid="EXO 16:22"/><verse number="23" style="v" sid="EXO 16:23"/>ಅದಕ್ಕೆ ಮೋಶೆ, “ಯೆಹೋವ ದೇವರು ಆಜ್ಞಾಪಿಸಿದ ಮಾತು ಇದೇ: ‘ನಾಳೆ ಯೆಹೋವ ದೇವರಿಗೆ ಪರಿಶುದ್ಧ ಸಬ್ಬತ್<note caller="+" style="f"><char style="fr" closed="false">16:23 </char><char style="fq" closed="false">ಸಬ್ಬತ್ </char><char style="ft" closed="false">ಅಂದರೆ </char><char style="fqa" closed="false">ವಿಶ್ರಾಂತಿಯ ದಿನ</char></note> ದಿನವಾಗಿದೆ. ಇಂದೇ ಸುಡಬೇಕಾದದ್ದನ್ನು ಸುಟ್ಟು, ಬೇಯಿಸಬೇಕಾದದ್ದನ್ನು ಬೇಯಿಸಿರಿ. ಇದರಲ್ಲಿ ಮಿಕ್ಕಾದದ್ದನ್ನೆಲ್ಲಾ ಬೆಳಗಿನವರೆಗೆ ಇಟ್ಟುಕೊಳ್ಳಿರಿ,’ ” ಎಂದನು.<verse eid="EXO 16:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="EXO 16:24"/>ಮೋಶೆಯು ಆಜ್ಞಾಪಿಸಿದ ಪ್ರಕಾರ ಅದನ್ನು ಮರುದಿನದವರೆಗೆ ಇಟ್ಟುಕೊಂಡಾಗ, ಅದು ಹೊಲಸುವಾಸನೆ ಹೊಂದಲಿಲ್ಲ. ಅದರಲ್ಲಿ ಹುಳಗಳೂ ಇರಲಿಲ್ಲ. <verse eid="EXO 16:24"/><verse number="25" style="v" sid="EXO 16:25"/>ಆಗ ಮೋಶೆಯು, “ಈ ಹೊತ್ತು ಅದನ್ನು ಊಟಮಾಡಿರಿ. ಏಕೆಂದರೆ ಈ ದಿನವು ಯೆಹೋವ ದೇವರ ಸಬ್ಬತ್ ದಿನವಾಗಿದೆ. ಈ ಹೊತ್ತು ನಿಮಗೆ ಹೊಲದಲ್ಲಿ ಆಹಾರ ಸಿಕ್ಕುವುದಿಲ್ಲ. <verse eid="EXO 16:25"/><verse number="26" style="v" sid="EXO 16:26"/>ಆರು ದಿವಸ ಅದನ್ನು ಕೂಡಿಸಬೇಕು. ಏಳನೆಯ ದಿನ ಸಬ್ಬತ್ ದಿನವಾಗಿರುವುದರಿಂದ ಅದು ದೊರೆಯುವುದಿಲ್ಲ,” ಎಂದನು.<verse eid="EXO 16:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="EXO 16:27"/>ಏಳನೆಯ ದಿನ ಜನರಲ್ಲಿ ಕೆಲವರು ಕೂಡಿಸುವುದಕ್ಕೆ ಹೊರಗೆ ಹೋದಾಗ, ಅವರಿಗೆ ಏನೂ ಸಿಕ್ಕಲಿಲ್ಲ. <verse eid="EXO 16:27"/><verse number="28" style="v" sid="EXO 16:28"/>ಆಗ ಯೆಹೋವ ದೇವರು ಮೋಶೆಗೆ, “ಎಷ್ಟು ಕಾಲ ನನ್ನ ಕಟ್ಟಳೆಗಳನ್ನೂ, ನಿಯಮಗಳನ್ನೂ ಕೈಗೊಳ್ಳದೆ ನಿರಾಕರಿಸುವಿರಿ? <verse eid="EXO 16:28"/><verse number="29" style="v" sid="EXO 16:29"/>ನೋಡಿರಿ, ಯೆಹೋವ ದೇವರಾದ ನಾನು ನಿಮಗೆ ಸಬ್ಬತ್ ದಿನವನ್ನು ಕೊಟ್ಟಿದ್ದರಿಂದಲೇ, ಆರನೆಯ ದಿನದಲ್ಲಿ ನಿಮಗೆ ಎರಡು ದಿನಗಳಿಗೆ ಸಾಕಾಗುವಷ್ಟು ಆಹಾರ ಕೊಟ್ಟಿದ್ದೇನೆ. ಪ್ರತಿಯೊಬ್ಬನೂ ತನ್ನ ತನ್ನ ಸ್ಥಳದಲ್ಲಿ ಇರಲಿ. ಏಳನೆಯ ದಿನದಲ್ಲಿ ಯಾರೂ ತನ್ನ ಸ್ಥಳವನ್ನು ಬಿಟ್ಟುಹೋಗಬಾರದು,” ಎಂದರು. <verse eid="EXO 16:29"/><verse number="30" style="v" sid="EXO 16:30"/>ಹೀಗೆ ಜನರು ಏಳನೆಯ ದಿನದಲ್ಲಿ ವಿಶ್ರಮಿಸಿಕೊಂಡರು.<verse eid="EXO 16:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="EXO 16:31"/>ಇಸ್ರಾಯೇಲರು ಆ ಆಹಾರಕ್ಕೆ ಮನ್ನಾ, ಎಂದು ಹೆಸರಿಟ್ಟರು. ಅದು ಕೊತ್ತಂಬರಿ ಬೀಜದಂತೆ ಬೆಳ್ಳಗಿತ್ತು. ಅದರ ರುಚಿಯು ಜೇನುತುಪ್ಪ ಕಲಸಿದ ದೋಸೆಯಂತೆ ಇತ್ತು. <verse eid="EXO 16:31"/><verse number="32" style="v" sid="EXO 16:32"/>ಮೋಶೆಯು ಅವರಿಗೆ, “ಯೆಹೋವ ದೇವರು ಆಜ್ಞಾಪಿಸಿದ್ದು ಇದೇ: ‘ನಾನು ನಿಮ್ಮನ್ನು ಈಜಿಪ್ಟ್ ದೇಶದೊಳಗಿಂದ ಹೊರಡಿಸಿದಾಗ, ಮರುಭೂಮಿಯಲ್ಲಿ ನಿಮಗೆ ತಿನ್ನಿಸಿದ ರೊಟ್ಟಿಯನ್ನು ನಿಮ್ಮ ಸಂತಾನಗಳು ನೋಡುವಂತೆ ಒಂದು ಓಮೆರ್ ಮನ್ನವನ್ನು ತುಂಬಿಸಿ ಇಟ್ಟಿರಬೇಕು,’ ಎಂಬುದು,” ಎಂದನು.<verse eid="EXO 16:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="EXO 16:33"/>ಮೋಶೆ ಆರೋನನಿಗೆ, “ನೀನು ಒಂದು ಪಾತ್ರೆಯನ್ನು ತೆಗೆದುಕೊಂಡು ಒಂದು ಓಮೆರ್ ಮನ್ನವನ್ನು ಅದರಲ್ಲಿ ಹಾಕಿ ನಿಮ್ಮ ಸಂತತಿಯವರು ನೋಡುವುದಕ್ಕೋಸ್ಕರ ಅದನ್ನು ಯೆಹೋವ ದೇವರ ಮುಂದೆ ಇಡು,” ಎಂದನು.<verse eid="EXO 16:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="EXO 16:34"/>ಯೆಹೋವ ದೇವರು ಮೋಶೆಗೆ ಆಜ್ಞಾಪಿಸಿದಂತೆಯೇ ಆರೋನನು ಮನ್ನವನ್ನು ಸಂರಕ್ಷಿಸುವುದಕ್ಕೆ ಸಾಕ್ಷಿಯಾಗಿ ಇಟ್ಟನು. <verse eid="EXO 16:34"/><verse number="35" style="v" sid="EXO 16:35"/>ಇಸ್ರಾಯೇಲರು ತಾವು ವಾಸವಾಗಿರತಕ್ಕ ದೇಶಕ್ಕೆ ಬರುವವರೆಗೆ, ನಲವತ್ತು ವರುಷ ಮನ್ನವನ್ನು ತಿಂದರು. ಕಾನಾನ್ ದೇಶದ ಮೇರೆಗಳಿಗೆ ಸೇರುವವರೆಗೂ ಅವರು ಮನ್ನವನ್ನು ತಿಂದರು.<verse eid="EXO 16:35"/></para>
  <para style="p">
    <verse number="36" style="v" sid="EXO 16:36"/>ಓಮೆರ್ ಎಂದರೆ ಏಫಾದಲ್ಲಿ ಹತ್ತನೆಯ ಒಂದು ಪಾಲು ಹಿಡಿಯುವಂಥ ಅಳತೆ.<verse eid="EXO 16:36"/></para>
  <chapter eid="EXO 16"/>
  <chapter number="17" style="c" sid="EXO 17"/>
  <para style="s1">ಬಂಡೆಯೊಳಗಿಂದ ಬಂದ ನೀರು</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 17:1"/>ಇಸ್ರಾಯೇಲ್ ಸಮೂಹವೆಲ್ಲಾ ಯೆಹೋವ ದೇವರ ಅಪ್ಪಣೆಯ ಪ್ರಕಾರ ಅವರವರು ಹೊರಡುವ ಕ್ರಮದಂತೆ ಸೀನ್ ಮರುಭೂಮಿಯಿಂದ ಹೊರಟು ರೆಫೀದೀಮಿನಲ್ಲಿ ತಂಗಿದರು. ಅಲ್ಲಿ ಜನರಿಗೆ ಕುಡಿಯುವುದಕ್ಕೆ ನೀರು ಇರಲಿಲ್ಲ. <verse eid="EXO 17:1"/><verse number="2" style="v" sid="EXO 17:2"/>ಆದಕಾರಣ ಜನರು ಮೋಶೆಯ ಸಂಗಡ ವಿವಾದ ಮಾಡಿ, “ನಮಗೆ ಕುಡಿಯುವುದಕ್ಕೆ ನೀರು ಕೊಡು,” ಎಂದರು.</para>
  <para style="p" vid="EXO 17:2">ಮೋಶೆಯು ಅವರಿಗೆ, “ಏಕೆ ನನ್ನ ಸಂಗಡ ವಿವಾದ ಮಾಡುತ್ತೀರಿ? ಯೆಹೋವ ದೇವರನ್ನು ಏಕೆ ಪರೀಕ್ಷಿಸುತ್ತೀರಿ?” ಎಂದನು.<verse eid="EXO 17:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="EXO 17:3"/>ಅಲ್ಲಿ ಜನರು ದಾಹಗೊಂಡು ಮೋಶೆಗೆ ವಿರುದ್ಧವಾಗಿ ಗೊಣಗುಟ್ಟಿ, “ನಮ್ನನ್ನೂ, ನಮ್ಮ ಮಕ್ಕಳನ್ನೂ, ನಮ್ಮ ಪಶುಗಳನ್ನೂ ದಾಹದಿಂದ ಕೊಲ್ಲುವುದಕ್ಕಾಗಿ ಏಕೆ ಈಜಿಪ್ಟಿನೊಳಗಿಂದ ಇಲ್ಲಿಗೆ ಬರಮಾಡಿದೆ,” ಎಂದರು.<verse eid="EXO 17:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="EXO 17:4"/>ಆಗ ಮೋಶೆಯು ಯೆಹೋವ ದೇವರಿಗೆ ಮೊರೆಯಿಟ್ಟು, “ಈ ಜನರಿಗೆ ನಾನೇನು ಮಾಡಲಿ? ಅವರು ಬಹಳಮಟ್ಟಿಗೆ ನನಗೆ ಕಲ್ಲೆಸೆಯುವುದಕ್ಕಿದ್ದಾರೆ,” ಎಂದನು.<verse eid="EXO 17:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="EXO 17:5"/>ಆಗ ಯೆಹೋವ ದೇವರು ಮೋಶೆಗೆ, “ಜನರ ಮುಂದೆ ಹಾದು ಹೋಗಿ ಇಸ್ರಾಯೇಲಿನ ಹಿರಿಯರಲ್ಲಿ ಕೆಲವರನ್ನು ಕರಕೊಂಡು ನೀನು ನೈಲ್ ನದಿಯನ್ನು ಹೊಡೆದ ಕೋಲನ್ನು ಕೈಯಲ್ಲಿ ತೆಗೆದುಕೊಂಡು ಹೋಗು. <verse eid="EXO 17:5"/><verse number="6" style="v" sid="EXO 17:6"/>ಅಲ್ಲಿ, ನಾನು ಹೋರೇಬಿನಲ್ಲಿ ಬಂಡೆಯ ಮೇಲೆ ನಿನ್ನ ಮುಂದೆ ನಿಂತುಕೊಳ್ಳುವೆನು, ನೀನು ಬಂಡೆಯನ್ನು ಹೊಡೆಯಬೇಕು. ಆಗ ಜನರು ಕುಡಿಯುವಂತೆ ನೀರು ಹೊರಗೆ ಬರುವುದು,” ಎಂದರು. ಮೋಶೆಯು ಇಸ್ರಾಯೇಲರ ಹಿರಿಯರ ಎದುರಿನಲ್ಲಿ ಹಾಗೆಯೇ ಮಾಡಿದನು. <verse eid="EXO 17:6"/><verse number="7" style="v" sid="EXO 17:7"/>“ಯೆಹೋವ ದೇವರು ತಮ್ಮ ಮಧ್ಯದಲ್ಲಿ ಇದ್ದಾನೋ ಇಲ್ಲವೋ,” ಎಂದು ಜನರು ಪರೀಕ್ಷಿಸಿದ್ದರಿಂದ ಮೋಶೆ ಆ ಸ್ಥಳಕ್ಕೆ ಮಸ್ಸಾ<note caller="+" style="f"><char style="fr" closed="false">17:7 </char><char style="fq" closed="false">ಮಸ್ಸಾ </char><char style="ft" closed="false">ಎಂದರೆ </char><char style="fqa" closed="false">ಪರೀಕ್ಷೆ</char></note> ಎಂದು ಹೆಸರಿಟ್ಟನು. ಅಲ್ಲಿ ಇಸ್ರಾಯೇಲರು ತನ್ನೊಡನೆ ವಿವಾದ ಮಾಡಿದ್ದರಿಂದ ಮೆರೀಬಾ<note caller="+" style="f"><char style="fr" closed="false">17:7 </char><char style="fq" closed="false">ಮೆರೀಬಾ </char><char style="ft" closed="false">ಎಂದರೆ </char><char style="fqa" closed="false">ಜಗಳ</char></note> ಎಂತಲೂ ಹೆಸರಿಟ್ಟನು.<verse eid="EXO 17:7"/></para>
  <para style="s1">ಅಮಾಲೇಕ್ಯರನ್ನು ಸೋಲಿಸಿದ್ದು</para>
  <para style="p">
    <verse number="8" style="v" sid="EXO 17:8"/>ಅಮಾಲೇಕ್ಯರು ಬಂದು ರೆಫೀದೀಮಿನಲ್ಲಿ ಇಸ್ರಾಯೇಲರ ಸಂಗಡ ಯುದ್ಧಮಾಡಿದರು. <verse eid="EXO 17:8"/><verse number="9" style="v" sid="EXO 17:9"/>ಆಗ ಮೋಶೆಯು ಯೆಹೋಶುವನಿಗೆ, “ನೀನು ನಮ್ಮ ಜನರಲ್ಲಿ ಕೆಲವರನ್ನು ಆರಿಸಿಕೊಂಡು ಅಮಾಲೇಕ್ಯರ ಸಂಗಡ ಯುದ್ಧಮಾಡುವುದಕ್ಕೆ ಹೋಗು. ನಾಳೆ ನಾನು ದೇವರ ಕೋಲನ್ನು ಕೈಯಲ್ಲಿ ಹಿಡಿದುಕೊಂಡು ಗುಡ್ಡದ ಮೇಲೆ ನಿಂತುಕೊಳ್ಳುವೆನು,” ಎಂದನು.<verse eid="EXO 17:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="EXO 17:10"/>ಯೆಹೋಶುವನು ಮೋಶೆ ಅಪ್ಪಣೆ ಕೊಟ್ಟಂತೆ ಅಮಾಲೇಕ್ಯರೊಂದಿಗೆ ಯುದ್ಧಮಾಡಿದನು. ಮೋಶೆಯೂ ಆರೋನನೂ ಹೂರನೂ ಗುಡ್ಡದ ಮೇಲೆ ಏರಿಹೋದರು. <verse eid="EXO 17:10"/><verse number="11" style="v" sid="EXO 17:11"/>ಮೋಶೆಯು ತನ್ನ ಕೈಯನ್ನು ಎತ್ತಿದಾಗ, ಇಸ್ರಾಯೇಲರು ಜಯಿಸಿದರು. ಅವನು ತನ್ನ ಕೈಯನ್ನು ಇಳಿಸಿದಾಗ ಅಮಾಲೇಕ್ಯರು ಜಯಿಸಿದರು. <verse eid="EXO 17:11"/><verse number="12" style="v" sid="EXO 17:12"/>ಆದರೆ ಮೋಶೆಯ ಕೈಗಳು ಭಾರವಾಗಿರಲಾಗಿ ಅವರು ಕಲ್ಲನ್ನು ತಂದು ಇಟ್ಟಾಗ, ಅವನು ಅದರ ಮೇಲೆ ಕೂತುಕೊಂಡನು. ಆರೋನನು ಒಂದು ಕಡೆಯಲ್ಲಿಯೂ, ಹೂರನು ಇನ್ನೊಂದು ಕಡೆಯಲ್ಲಿಯೂ ಮೋಶೆಯ ಕೈಗಳಿಗೆ ಆಧಾರ ಕೊಟ್ಟರು. ಹೀಗೆ ಸೂರ್ಯನು ಮುಳುಗುವವರೆಗೆ ಅವನ ಕೈಗಳು ಇಳಿಯದೆ ನಿಂತೇ ಇದ್ದವು. <verse eid="EXO 17:12"/><verse number="13" style="v" sid="EXO 17:13"/>ಯೆಹೋಶುವನು ಅಮಾಲೇಕ್ಯರನ್ನೂ, ಅವನ ಜನರನ್ನೂ ಖಡ್ಗದಿಂದ ಸೋಲಿಸಿದನು.<verse eid="EXO 17:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="EXO 17:14"/>ಆಗ ಯೆಹೋವ ದೇವರು ಮೋಶೆಗೆ, “ಇದನ್ನು ಜ್ಞಾಪಕಾರ್ಥವಾಗಿ ಗ್ರಂಥದಲ್ಲಿ ಬರೆ. ಏಕೆಂದರೆ ನಾನು ಅಮಾಲೇಕ್ಯರ ನೆನಪು ಭೂಲೋಕದಲ್ಲಿ ಇರದಂತೆ ಸಂಪೂರ್ಣವಾಗಿ ಅಳಿಸಿಬಿಡುವೆನು. ಇದನ್ನು ಯೆಹೋಶುವನಿಗೆ ಮನದಟ್ಟಾಗುವಂತೆ ಹೇಳು,” ಎಂದರು.<verse eid="EXO 17:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="EXO 17:15"/>ಇದಾದ ಮೇಲೆ ಮೋಶೆ ಬಲಿಪೀಠವನ್ನು ಕಟ್ಟಿ, ಅದಕ್ಕೆ “ಯೆಹೋವ ನಿಸ್ಸೀ,” ಎಂದು ಹೆಸರಿಟ್ಟನು. <verse eid="EXO 17:15"/><verse number="16" style="v" sid="EXO 17:16"/>ಅನಂತರ ಮೋಶೆ, “ಯೆಹೋವ ದೇವರ ಸಿಂಹಾಸನಕ್ಕೆ ವಿರೋಧವಾಗಿ ಅಮಾಲೇಕ್ಯರ ಕೈಗಳು ಎತ್ತಿದ್ದರಿಂದ, ಯೆಹೋವ ದೇವರು ತಲತಲಾಂತರಗಳಲ್ಲಿ ಅಮಾಲೇಕ್ಯರ ವಿರುದ್ಧ ಯುದ್ಧಮಾಡುವರು,” ಎಂದನು.<verse eid="EXO 17:16"/></para>
  <chapter eid="EXO 17"/>
  <chapter number="18" style="c" sid="EXO 18"/>
  <para style="s1">ಇತ್ರೋವನು ಮೋಶೆಯನ್ನು ಸಂದರ್ಶಿಸಿದ್ದು</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 18:1"/>ದೇವರು ಮೋಶೆಗೂ, ತಮ್ಮ ಜನರಾದ ಇಸ್ರಾಯೇಲರಿಗೂ ಮಾಡಿದವುಗಳೆಲ್ಲವನ್ನೂ ಯೆಹೋವ ದೇವರು ಇಸ್ರಾಯೇಲರನ್ನು ಈಜಿಪ್ಟಿನೊಳಗಿಂದ ಹೊರಗೆ ತಂದದ್ದನ್ನೂ, ಮಿದ್ಯಾನಿನ ಯಾಜಕನೂ, ಮೋಶೆಯ ಮಾವನೂ ಆಗಿದ್ದ ಇತ್ರೋವನಿಗೆ ಮುಟ್ಟಿತು.<verse eid="EXO 18:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="EXO 18:2"/>ಅವನು ತನ್ನ ಬಳಿಗೆ ಕಳುಹಿಸಲಾಗಿದ್ದ ಮೋಶೆಯ ಹೆಂಡತಿ ಚಿಪ್ಪೋರಳನ್ನು ಮತ್ತು ಆಕೆಯ ಇಬ್ಬರು ಪುತ್ರರನ್ನು ಕರೆದುಕೊಂಡು ಬಂದನು. <verse eid="EXO 18:2"/><verse number="3" style="v" sid="EXO 18:3"/>ಮೋಶೆಯು, “ನಾನು ಪರದೇಶದಲ್ಲಿ ಅನ್ಯನಾಗಿದ್ದೆನು,” ಎಂದು ಹೇಳಿ ಆ ಪುತ್ರರಲ್ಲಿ ಒಬ್ಬನಿಗೆ ಗೇರ್ಷೋಮ್ ಎಂದು ಹೆಸರಿಟ್ಟಿದ್ದನು. <verse eid="EXO 18:3"/><verse number="4" style="v" sid="EXO 18:4"/>“ನನ್ನ ತಂದೆಯ ದೇವರು ನನ್ನ ಸಹಾಯಕನಾಗಿದ್ದು, ಫರೋಹನ ಖಡ್ಗದಿಂದ ಬಿಡುಗಡೆ ಮಾಡಿದನು,” ಎಂದು ಹೇಳಿ ಇನ್ನೊಬ್ಬ ಮಗನಿಗೆ ಎಲೀಯೆಜೆರ್<note caller="+" style="f"><char style="fr" closed="false">18:4 </char><char style="fq" closed="false">ಎಲೀಯೆಜೆರ್ </char><char style="ft" closed="false">ಎಂದರೆ </char><char style="fqa" closed="false">ದೇವರು ನನ್ನ ಸಹಾಯಕ</char></note> ಎಂದು ಹೆಸರಿಟ್ಟಿದ್ದನು.<verse eid="EXO 18:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="EXO 18:5"/>ಮೋಶೆಯ ಮಾವನಾದ ಇತ್ರೋವನ ಸಂಗಡ ಮೋಶೆಯ ಹೆಂಡತಿಯನ್ನೂ, ಅವನ ಪುತ್ರರನ್ನೂ ಮೋಶೆಯ ಬಳಿಗೆ ಅವನು ತಂಗಿದ್ದ ಮರುಭೂಮಿಯಲ್ಲಿ ದೇವರ ಬೆಟ್ಟದ ಬಳಿಗೆ ಬಂದರು. <verse eid="EXO 18:5"/><verse number="6" style="v" sid="EXO 18:6"/>ಆಗ ಅವನು ಮೋಶೆಗೆ, “ನಿನ್ನ ಮಾವ ಇತ್ರೋವನೆಂಬ ನಾನು ನಿನ್ನ ಹೆಂಡತಿ, ಇಬ್ಬರು ಮಕ್ಕಳನ್ನೂ ಕರೆದುಕೊಂಡು ನಿನ್ನ ಬಳಿಗೆ ಬಂದಿದ್ದೇನೆ,” ಎಂದು ಹೇಳಿ ಕಳುಹಿಸಿದನು.<verse eid="EXO 18:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="EXO 18:7"/>ಮೋಶೆಗೆ ತನ್ನ ಮಾವನನ್ನು ಎದುರುಗೊಂಡು ಅವನನ್ನು ವಂದಿಸಿ, ಮುದ್ದಿಟ್ಟನು. ಅವರು ಪರಸ್ಪರ ಕ್ಷೇಮಸಮಾಚಾರವನ್ನು ಕೇಳಿಕೊಂಡು ಗುಡಾರಕ್ಕೆ ಬಂದರು. <verse eid="EXO 18:7"/><verse number="8" style="v" sid="EXO 18:8"/>ಇಸ್ರಾಯೇಲರಿಗೋಸ್ಕರ ಯೆಹೋವ ದೇವರು ಫರೋಹನಿಗೂ ಈಜಿಪ್ಟಿನವರಿಗೂ ಮಾಡಿದ್ದೆಲ್ಲವನ್ನೂ, ಅವರಿಗೆ ಒದಗಿದ ಎಲ್ಲಾ ಸಂಕಟವನ್ನೂ ಯೆಹೋವ ದೇವರು ತಮ್ಮನ್ನು ಹೇಗೆ ತಪ್ಪಿಸಿದನೆಂಬುದನ್ನೂ ಮೋಶೆಯು ತನ್ನ ಮಾವನಿಗೆ ತಿಳಿಯಪಡಿಸಿದನು.<verse eid="EXO 18:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="EXO 18:9"/>ಇದಲ್ಲದೆ ಯೆಹೋವ ದೇವರು ಇಸ್ರಾಯೇಲರಿಗೆ ಮಾಡಿದ ಎಲ್ಲಾ ಉಪಕಾರಕ್ಕಾಗಿಯೂ, ಯೆಹೋವ ದೇವರು ಅವರನ್ನು ಈಜಿಪ್ಟಿನವರ ಕೈಗಳಿಂದ ತಪ್ಪಿಸಿದ್ದಕ್ಕಾಗಿಯೂ ಇತ್ರೋವನು ಸಂತೋಷಪಟ್ಟನು. <verse eid="EXO 18:9"/><verse number="10" style="v" sid="EXO 18:10"/>ಇತ್ರೋವನು, “ಈಜಿಪ್ಟಿನವರ ಕೈಗೂ ಫರೋಹನ ಕೈಗೂ ಈಜಿಪ್ಟಿನವರ ಅಧಿಕಾರದೊಳಗಿಂದಲೂ ಜನರನ್ನು ತಪ್ಪಿಸಿದ ಯೆಹೋವ ದೇವರಿಗೆ ಸ್ತೋತ್ರವಾಗಲಿ. <verse eid="EXO 18:10"/><verse number="11" style="v" sid="EXO 18:11"/>ಎಲ್ಲಾ ದೇವರುಗಳಿಗಿಂತ ಯೆಹೋವ ದೇವರೇ ದೊಡ್ಡವರೆಂದು ಈಗ ನಾನು ತಿಳಿದುಕೊಂಡಿದ್ದೇನೆ. ಏಕೆಂದರೆ ಈಜಿಪ್ಟಿನವರು ಗರ್ವಪಟ್ಟಿದ್ದರಿಂದ ಯೆಹೋವ ದೇವರು ಅವರನ್ನು ತಗ್ಗಿಸಿದರು,” ಎಂದನು. <verse eid="EXO 18:11"/><verse number="12" style="v" sid="EXO 18:12"/>ಮೋಶೆಯ ಮಾವ ಇತ್ರೋವನು ದಹನಬಲಿಯನ್ನೂ, ಯಜ್ಞಗಳನ್ನೂ ದೇವರಿಗಾಗಿ ತೆಗೆದುಕೊಂಡು ಬಂದನು. ಆರೋನನೂ, ಇಸ್ರಾಯೇಲಿನ ಹಿರಿಯರೆಲ್ಲರೂ ದೇವರ ಸನ್ನಿಧಿಯಲ್ಲಿ ಮೋಶೆಯ ಮಾವನ ಸಂಗಡ ಭೋಜನವನ್ನು ಮಾಡುವುದಕ್ಕೆ ಬಂದರು.<verse eid="EXO 18:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="EXO 18:13"/>ಮರುದಿನ ಮೋಶೆಯು ಜನರಿಗೆ ನ್ಯಾಯತೀರಿಸುವುದಕ್ಕೆ ಕೂತುಕೊಂಡಾಗ, ಜನರು ಬೆಳಗಿನಿಂದ ಸಂಜೆಯವರೆಗೆ ಮೋಶೆಯ ಬಳಿಯಲ್ಲಿ ನಿಂತಿದ್ದರು. <verse eid="EXO 18:13"/><verse number="14" style="v" sid="EXO 18:14"/>ಇತ್ರೋವನು ಮೋಶೆಯು ಜನರಿಗಾಗಿ ಮಾಡುವುದನ್ನೆಲ್ಲಾ ನೋಡಿದಾಗ, ಅವನು ಮೋಶೆಗೆ, “ಇದೇನು ಜನರಿಗೆ ನೀನು ಮಾಡುವುದು? ಏಕೆ ನೀನೊಬ್ಬನೇ ನ್ಯಾಯಾಧೀಶನಾಗಿ ಕೂತಿರಲಾಗಿ, ಜನರು ಬೆಳಗಿನಿಂದ ಸಂಜೆಯವರೆಗೆ ನಿನ್ನ ಬಳಿಯಲ್ಲಿ ನಿಂತಿರಬೇಕು?” ಎಂದನು.<verse eid="EXO 18:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="EXO 18:15"/>ಅದಕ್ಕೆ ಮೋಶೆಯು ತನ್ನ ಮಾವನಿಗೆ, “ದೇವರ ವಿಷಯವಾಗಿ ಕೇಳುವುದಕ್ಕಾಗಿ ಜನರು ನನ್ನ ಬಳಿಗೆ ಬರುತ್ತಾರೆ. <verse eid="EXO 18:15"/><verse number="16" style="v" sid="EXO 18:16"/>ಅವರಿಗೆ ಏನಾದರೂ ವ್ಯಾಜ್ಯವಿದ್ದರೆ ನನ್ನ ಬಳಿಗೆ ಬರುತ್ತಾರೆ. ನಾನು ಒಬ್ಬರ ಸಂಗಡ ಇನ್ನೊಬ್ಬರಿಗಿರುವ ವ್ಯಾಜ್ಯವನ್ನು ತೀರಿಸುತ್ತೇನೆ. ದೇವರ ನಿಯಮಗಳನ್ನೂ, ಆಜ್ಞೆಗಳನ್ನೂ ಅವರಿಗೆ ತಿಳಿಯಪಡಿಸುತ್ತೇನೆ,” ಎಂದನು.<verse eid="EXO 18:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="EXO 18:17"/>ಮೋಶೆಯ ಮಾವನು ಅವನಿಗೆ, “ನೀನು ಮಾಡುವ ಕಾರ್ಯವಿಧಾನ ಸರಿಯಲ್ಲ, <verse eid="EXO 18:17"/><verse number="18" style="v" sid="EXO 18:18"/>ನೀನೂ, ನಿನ್ನ ಸಂಗಡ ಇರುವ ಜನರೂ ಖಂಡಿತ ಬಳಲುವಿರಿ. ಏಕೆಂದರೆ ಇದು ನಿನಗೆ ಬಹು ಭಾರ. ನೀನೊಬ್ಬನೇ ಇದನ್ನು ಮಾಡಲಾರೆ. <verse eid="EXO 18:18"/><verse number="19" style="v" sid="EXO 18:19"/>ಆದ್ದರಿಂದ ಈಗ ನನ್ನ ಮಾತನ್ನು ಕೇಳು, ನಿನಗೆ ಆಲೋಚನೆ ಹೇಳುತ್ತೇನೆ. ದೇವರು ನಿನ್ನ ಸಂಗಡ ಇರಲಿ. ನೀನು ಜನರಿಗಾಗಿ ದೇವರ ಪಕ್ಷದಲ್ಲಿದ್ದು, ಅವರ ವ್ಯಾಜ್ಯಗಳನ್ನು ದೇವರ ಮುಂದೆ ತರಬೇಕು. <verse eid="EXO 18:19"/><verse number="20" style="v" sid="EXO 18:20"/>ನಿಯಮಗಳನ್ನೂ, ಆಜ್ಞೆಗಳನ್ನೂ ಅವರಿಗೆ ಕಲಿಸಿ, ಅವರು ನಡೆಯಬೇಕಾದ ಮಾರ್ಗವನ್ನೂ, ಅವರು ಮಾಡಬೇಕಾದ ಕೆಲಸವನ್ನೂ ಅವರಿಗೆ ತೋರಿಸಬೇಕು. <verse eid="EXO 18:20"/><verse number="21" style="v" sid="EXO 18:21"/>ಇದಲ್ಲದೆ ನೀನು ಸಮಸ್ತ ಜನರೊಳಗೆ ಸಮರ್ಥರು ಅಂದರೆ ದೇವರಿಗೆ ಭಯಪಡುವವರೂ, ಸತ್ಯವಂತರೂ, ದುರಾಶೆಯನ್ನು ಹಗೆಮಾಡುವವರೂ ಆಗಿರುವವರನ್ನು ಸಾವಿರ ಮಂದಿಯ ಮೇಲೆಯೂ, ನೂರು ಮಂದಿಯ ಮೇಲೆಯೂ, ಐವತ್ತು ಮಂದಿಯ ಮೇಲೆಯೂ, ಹತ್ತು ಮಂದಿಯ ಮೇಲೆಯೂ ಅಧಿಕಾರಿಗಳನ್ನಾಗಿ ನೇಮಿಸು. <verse eid="EXO 18:21"/><verse number="22" style="v" sid="EXO 18:22"/>ಇವರು ಎಲ್ಲಾ ಕಾಲಗಳಲ್ಲಿಯೂ ಜನರಿಗೆ ನ್ಯಾಯತೀರಿಸಲಿ. ಆದರೆ ದೊಡ್ಡ ವ್ಯಾಜ್ಯಗಳನ್ನೆಲ್ಲಾ ನಿನ್ನ ಮುಂದೆ ತಂದು, ಸಣ್ಣ ವ್ಯಾಜ್ಯಗಳನ್ನೆಲ್ಲಾ ತಾವೇ ತೀರಿಸಲಿ. ಆಗ ನಿನಗೆ ಸುಲಭವಾಗುವುದು. ಅವರೂ ನಿನ್ನ ಸಂಗಡ ಭಾರವನ್ನು ಹೊರುವರು. <verse eid="EXO 18:22"/><verse number="23" style="v" sid="EXO 18:23"/>ಈ ಕಾರ್ಯವನ್ನು ಮಾಡುವುದಕ್ಕೆ ದೇವರು ನಿನಗೆ ಅಪ್ಪಣೆ ಕೊಟ್ಟರೆ, ಆಗ ನೀನು ಇದನ್ನು ನಿರ್ವಹಿಸಲು ಶಕ್ತನಾಗುವೆ. ಈ ಜನರೆಲ್ಲರೂ ತಮ್ಮ ತಮ್ಮ ಸ್ಥಳಗಳಿಗೆ ಸಮಾಧಾನದಿಂದ ಹೋಗುವರು,” ಎಂದನು.<verse eid="EXO 18:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="EXO 18:24"/>ಮೋಶೆಯು ತನ್ನ ಮಾವನ ಮಾತನ್ನು ಕೇಳಿ, ಅವನು ಹೇಳಿದ್ದನ್ನೆಲ್ಲಾ ಮಾಡಿದನು. <verse eid="EXO 18:24"/><verse number="25" style="v" sid="EXO 18:25"/>ಮೋಶೆಯು ಇಸ್ರಾಯೇಲರಲ್ಲಿ ಇರುವ ಸಮರ್ಥರನ್ನು ಆರಿಸಿಕೊಂಡು, ಅವರನ್ನು ಜನರ ಮೇಲೆ ಮುಖ್ಯಸ್ಥರನ್ನಾಗಿ ಮಾಡಿ, ಸಾವಿರ ಮಂದಿಯ ಮೇಲೆ, ನೂರು ಮಂದಿಯ ಮೇಲೆ, ಐವತ್ತು ಮಂದಿಯ ಮೇಲೆ, ಹತ್ತು ಮಂದಿಯ ಮೇಲೆ ಅಧಿಕಾರಿಗಳನ್ನಾಗಿ ನೇಮಿಸಿದನು. <verse eid="EXO 18:25"/><verse number="26" style="v" sid="EXO 18:26"/>ಇವರು ಎಲ್ಲಾ ಕಾಲಗಳಲ್ಲಿ ಜನರಿಗೆ ನ್ಯಾಯತೀರಿಸಿ, ಕಠಿಣ ವ್ಯಾಜ್ಯಗಳನ್ನು ಮೋಶೆಯ ಬಳಿಗೆ ತರುತ್ತಿದ್ದರು. ಸಣ್ಣ ವ್ಯಾಜ್ಯಗಳನ್ನು ತಾವೇ ತೀರಿಸಿದರು.<verse eid="EXO 18:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="EXO 18:27"/>ತರುವಾಯ ಮೋಶೆಯು ತನ್ನ ಮಾವ ಇತ್ರೋವನಿಗೆ ಸಾಗಕಳುಹಿಸಿದಾಗ, ಅವನು ಸ್ವದೇಶಕ್ಕೆ ಹೊರಟುಹೋದನು.<verse eid="EXO 18:27"/></para>
  <chapter eid="EXO 18"/>
  <chapter number="19" style="c" sid="EXO 19"/>
  <para style="s1">ಸೀನಾಯಿ ಬೆಟ್ಟದ ಬಳಿಯಲ್ಲಿ</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 19:1"/>ಇಸ್ರಾಯೇಲರು ಈಜಿಪ್ಟನ್ನು ಬಿಟ್ಟ ಮೂರನೆಯ ತಿಂಗಳಿನ ಅದೇ ದಿನದಲ್ಲಿ ಸೀನಾಯಿ ಮರುಭೂಮಿಗೆ ಬಂದರು. <verse eid="EXO 19:1"/><verse number="2" style="v" sid="EXO 19:2"/>ಅವರು ರೆಫೀದೀಮಿನಿಂದ ಹೊರಟು, ಸೀನಾಯಿ ಮರುಭೂಮಿಗೆ ಬಂದು, ಮರುಭೂಮಿಯಲ್ಲಿ ಡೇರೆ ಹಾಕಿ, ಬೆಟ್ಟಕ್ಕೆದುರಾಗಿ ಇಳಿದುಕೊಂಡರು.<verse eid="EXO 19:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="EXO 19:3"/>ಮೋಶೆಯು ದೇವರ ಸನ್ನಿಧಿಗೆ ಬೆಟ್ಟದ ಮೇಲೆ ಹೋದನು. ಆಗ ಯೆಹೋವ ದೇವರು ಸೀನಾಯಿ ಪರ್ವತದ ಮೇಲಿನಿಂದ ಅವನನ್ನು ಕರೆದು ಅವನಿಗೆ, “ನೀನು ಯಾಕೋಬನ ಮನೆತನದವರಾದ ಇಸ್ರಾಯೇಲರಿಗೆ ಇದನ್ನು ತಿಳಿಸು: <verse eid="EXO 19:3"/><verse number="4" style="v" sid="EXO 19:4"/>‘ನಾನು ಈಜಿಪ್ಟಿನವರಿಗೆ ಮಾಡಿದ್ದನ್ನೂ, ಹದ್ದು ತನ್ನ ಮರಿಗಳನ್ನು ತನ್ನ ರೆಕ್ಕೆಗಳ ಮೇಲೆ ಹೊತ್ತು ಬರುವಂತೆ ನಿಮ್ಮನ್ನು ಈ ಸ್ಥಳಕ್ಕೆ ಬರಮಾಡಿದ್ದನ್ನೆಲ್ಲಾ ನೀವು ನೋಡಿದ್ದೀರಿ. <verse eid="EXO 19:4"/><verse number="5" style="v" sid="EXO 19:5"/>ಆದ್ದರಿಂದ ಈಗ ನೀವು ನನ್ನ ಮಾತನ್ನು ಕೇಳಿ, ನನ್ನ ಒಡಂಬಡಿಕೆಯನ್ನು ಕಾಪಾಡಿದರೆ, ಸಮಸ್ತ ಜನರಲ್ಲಿ ನೀವು ನನ್ನ ಸಂಗ್ರಹಿಸಿದ ಸೊತ್ತಾಗಿರುವಿರಿ. ಏಕೆಂದರೆ ಭೂಮಿಯೆಲ್ಲಾ ನನ್ನದೇ. <verse eid="EXO 19:5"/><verse number="6" style="v" sid="EXO 19:6"/>ನೀವು ನನಗೆ ಯಾಜಕ ರಾಜ್ಯವೂ ಪರಿಶುದ್ಧ ಜನಾಂಗವೂ ಆಗಿರುವಿರಿ.’ ಇಸ್ರಾಯೇಲರಿಗೆ ನೀನು ಹೇಳಬೇಕಾದ ಮಾತುಗಳು ಇವೇ,” ಎಂದರು.<verse eid="EXO 19:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="EXO 19:7"/>ಆಗ ಮೋಶೆಯು ಇಳಿದುಬಂದು ಜನರ ಹಿರಿಯರನ್ನು ಕರೆದು, ಯೆಹೋವ ದೇವರು ತನಗೆ ಆಜ್ಞಾಪಿಸಿದ ಈ ಮಾತುಗಳನ್ನೆಲ್ಲಾ ಅವರ ಮುಂದೆ ಇಟ್ಟನು. <verse eid="EXO 19:7"/><verse number="8" style="v" sid="EXO 19:8"/>ಜನರೆಲ್ಲಾ ಒಂದಾಗಿ ಉತ್ತರಕೊಟ್ಟು, “ಯೆಹೋವ ದೇವರು ಹೇಳಿದ್ದನ್ನೆಲ್ಲಾ ಮಾಡುತ್ತೇವೆ,” ಎಂದು ಹೇಳಿದರು. ಆಗ ಮೋಶೆಯು ಜನರ ಮಾತುಗಳನ್ನು ಯೆಹೋವ ದೇವರಿಗೆ ಹೇಳಿದನು.<verse eid="EXO 19:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="EXO 19:9"/>ಯೆಹೋವ ದೇವರು ಮೋಶೆಗೆ, “ನಾನು ನಿನ್ನ ಸಂಗಡ ಮಾತನಾಡುವುದನ್ನು ಜನರು ಕೇಳುವ ಹಾಗೆಯೂ ಅವರು ಸದಾಕಾಲ ನಿನ್ನನ್ನು ನಂಬುವಂತೆಯೂ ದಟ್ಟವಾದ ಮೇಘದಲ್ಲಿ ನಾನು ನಿನ್ನ ಬಳಿಗೆ ಬರುತ್ತೇನೆ,” ಎಂದರು. ಮೋಶೆಯು ಜನರ ಮಾತುಗಳನ್ನು ಯೆಹೋವ ದೇವರಿಗೆ ತಿಳಿಸಿದನು.<verse eid="EXO 19:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="EXO 19:10"/>ಆಗ ಯೆಹೋವ ದೇವರು ಮೋಶೆಗೆ, “ಜನರ ಬಳಿಗೆ ಹೋಗಿ ಈ ಹೊತ್ತೂ ನಾಳೆಯೂ ಅವರನ್ನು ಶುದ್ಧಮಾಡು. ಅವರು ತಮ್ಮ ವಸ್ತ್ರಗಳನ್ನು ತೊಳೆದುಕೊಳ್ಳಲಿ. <verse eid="EXO 19:10"/><verse number="11" style="v" sid="EXO 19:11"/>ಮೂರನೆಯ ದಿನದಲ್ಲಿ ಅವರು ಸಿದ್ಧವಾಗಿರಲಿ. ಏಕೆಂದರೆ ಮೂರನೆಯ ದಿನದಲ್ಲಿ ಯೆಹೋವ ದೇವರು ಸಮಸ್ತ ಜನರ ಕಣ್ಣೆದುರಿನಲ್ಲಿ ಸೀನಾಯಿ ಪರ್ವತಕ್ಕೆ ಇಳಿದು ಬರುವರು. <verse eid="EXO 19:11"/><verse number="12" style="v" sid="EXO 19:12"/>ಜನರಿಗೋಸ್ಕರ ಸುತ್ತಲೂ ಮೇರೆಗಳನ್ನು ಮಾಡಿಸಿ, ‘ಅವರು ಬೆಟ್ಟವನ್ನು ಏರದಂತೆಯೂ ಅದರ ಮೇರೆಯನ್ನು ಮುಟ್ಟದಂತೆಯೂ ಜಾಗ್ರತೆಯಾಗಿರಬೇಕು. ಬೆಟ್ಟವನ್ನು ಮುಟ್ಟಿದವರೆಲ್ಲಾ ಖಂಡಿತವಾಗಿ ಸತ್ತು ಹೋಗುವರು. <verse eid="EXO 19:12"/><verse number="13" style="v" sid="EXO 19:13"/>ಯಾರೂ ಅಂಥವರನ್ನು ಮುಟ್ಟಬಾರದು. ಮುಟ್ಟಿದ ಪಶುವಾಗಲಿ, ಮನುಷ್ಯನಾಗಲಿ ನಿಶ್ಚಯವಾಗಿ ಕಲ್ಲೆಸೆದು ಕೊಲ್ಲಬೇಕು. ಇಲ್ಲವೆ ಈಟಿಯಿಂದ ತಿವಿಯಬೇಕು.’ ದೀರ್ಘವಾಗಿ ತುತೂರಿ ಊದುವ ಸಮಯದಲ್ಲಿ ಅವರು ಬೆಟ್ಟದ ಬಳಿಗೆ ಬರಬೇಕು,” ಎಂದರು.<verse eid="EXO 19:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="EXO 19:14"/>ಆಗ ಮೋಶೆಯು ಬೆಟ್ಟದಿಂದಿಳಿದು ಜನರನ್ನು ಶುದ್ಧಿಮಾಡಿದನು. ಅವರು ತಮ್ಮ ವಸ್ತ್ರಗಳನ್ನು ತೊಳೆದುಕೊಂಡರು. <verse eid="EXO 19:14"/><verse number="15" style="v" sid="EXO 19:15"/>ಅವನು ಜನರಿಗೆ, “ಮೂರನೆಯ ದಿನಕ್ಕಾಗಿ ಸಿದ್ಧರಾಗಿರಿ, ನೀವು ಲೈಂಗಿಕ ಸಂಬಂಧದಿಂದ ದೂರವಾಗಿರಿ,” ಎಂದನು.<verse eid="EXO 19:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="EXO 19:16"/>ಮೂರನೆಯ ದಿನದಲ್ಲಿ ಉದಯವಾದಾಗ, ಬೆಟ್ಟದ ಮೇಲೆ ಗುಡುಗು, ಮಿಂಚು, ದಟ್ಟವಾದ ಮೇಘ ಮತ್ತು ತುತೂರಿಯ ಮಹಾ ಧ್ವನಿ ಉಂಟಾದವು. ಪಾಳೆಯದಲ್ಲಿದ್ದ ಜನರೆಲ್ಲರೂ ನಡುಗಿದರು. <verse eid="EXO 19:16"/><verse number="17" style="v" sid="EXO 19:17"/>ಆಗ ಮೋಶೆಯು ದೇವರನ್ನು ಸಂಧಿಸುವುದಕ್ಕೆ ಜನರನ್ನು ಪಾಳೆಯದೊಳಗಿಂದ ಹೊರಗೆ ಬರಮಾಡಿದನು. ಆಗ ಅವರು ಬೆಟ್ಟದ ಕೆಳಗೆ ನಿಂತುಕೊಂಡರು. <verse eid="EXO 19:17"/><verse number="18" style="v" sid="EXO 19:18"/>ಯೆಹೋವ ದೇವರು ಅಗ್ನಿಯೊಳಗೆ ಬೆಟ್ಟದ ಮೇಲೆ ಇಳಿದಿದ್ದರಿಂದ ಸೀನಾಯಿ ಬೆಟ್ಟದಲ್ಲೆಲ್ಲಾ ಹೊಗೆ ಹಾಯುತ್ತಿತ್ತು. ಅದರ ಹೊಗೆಯು ಆವಿಗೆಯ ಹೊಗೆಯಂತೆ ಏರಿ ಬರುತ್ತಾ ಇತ್ತು. ಬೆಟ್ಟವೆಲ್ಲಾ ಬಹಳವಾಗಿ ಕಂಪಿಸಿತು. <verse eid="EXO 19:18"/><verse number="19" style="v" sid="EXO 19:19"/>ತುತೂರಿಯ ಧ್ವನಿಯು ಬರಬರುತ್ತಾ ಹೆಚ್ಚಾಗುತ್ತಾ ಇತ್ತು. ಆಗ ಮೋಶೆಯು ದೇವರೊಡನೆ ಮಾತನಾಡಿದನು. ಅವನಿಗೆ ದೇವರು ಉತ್ತರಕೊಟ್ಟರು.<verse eid="EXO 19:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="EXO 19:20"/>ಯೆಹೋವ ದೇವರು ಸೀನಾಯಿ ಬೆಟ್ಟದ ತುದಿಯಲ್ಲಿ ಇಳಿದುಬಂದು ಮೋಶೆಯನ್ನು ಬೆಟ್ಟದ ತುದಿಗೆ ಕರೆದರು. ಮೋಶೆಯು ಮೇಲೆ ಹೋದನು. <verse eid="EXO 19:20"/><verse number="21" style="v" sid="EXO 19:21"/>ಯೆಹೋವ ದೇವರು ಮೋಶೆಗೆ, “ನೀನು ಇಳಿದು ಹೋಗಿ ಜನರನ್ನು ಎಚ್ಚರಿಸಬೇಕು. ಅವರು ಯೆಹೋವ ದೇವರನ್ನು ನೋಡುವದಕ್ಕಾಗಿ ಮುಂದೆ ಬಂದರೆ, ಅವರಲ್ಲಿ ಬಹಳ ಜನರು ಸಾಯುವರು. <verse eid="EXO 19:21"/><verse number="22" style="v" sid="EXO 19:22"/>ಯೆಹೋವ ದೇವರ ಸಮೀಪಕ್ಕೆ ಬರುವ ಯಾಜಕರು ಸಹ ಯೆಹೋವ ದೇವರು ಅವರನ್ನು ಸಾಯಿಸದಂತೆ ತಮ್ಮನ್ನು ಶುದ್ಧಿಮಾಡಿಕೊಳ್ಳಲಿ, ಇಲ್ಲವಾದರೆ ಅವರನ್ನೂ ನಾನು ತಟ್ಟನೆ ನಾಶಮಾಡುವೆನು,” ಎಂದರು.<verse eid="EXO 19:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="EXO 19:23"/>ಮೋಶೆಯು ಯೆಹೋವ ದೇವರಿಗೆ, “ಜನರು ಸೀನಾಯಿ ಬೆಟ್ಟವನ್ನು ಏರಲಾರರು. ಬೆಟ್ಟಕ್ಕೆ ಮೇರೆಗಳನ್ನು ಹಾಕಿ ಅದನ್ನು ಶುದ್ಧಮಾಡೆಂದು ನೀವೇ ನಮ್ಮನ್ನು ಎಚ್ಚರಿಸಿದ್ದೀರಿ,” ಎಂದನು.<verse eid="EXO 19:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="EXO 19:24"/>ಆಗ ಯೆಹೋವ ದೇವರು ಅವನಿಗೆ, “ನೀನು ಇಳಿದು ಹೋಗಿ, ಆರೋನನನ್ನು ಕರೆದುಕೊಂಡು ಇಲ್ಲಿಗೆ ಬಾ. ಆದರೆ ಯೆಹೋವ ದೇವರಿಂದ ಸಂಹಾರವಾಗದಂತೆ ಯಾಜಕರೂ ಜನರೂ ಮುಂದೆ ಯೆಹೋವ ದೇವರ ಬಳಿಗೆ ಬಾರದೇ ಇರಲಿ,” ಎಂದರು.<verse eid="EXO 19:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="EXO 19:25"/>ಮೋಶೆಯು ಜನರ ಬಳಿಗೆ ಇಳಿದು ಹೋಗಿ ಅವರಿಗೆ ಇದನ್ನೆಲ್ಲಾ ಹೇಳಿದನು.<verse eid="EXO 19:25"/></para>
  <chapter eid="EXO 19"/>
  <chapter number="20" style="c" sid="EXO 20"/>
  <para style="s1">ದಶಾಜ್ಞೆಗಳು</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 20:1"/>ದೇವರು ಈ ಎಲ್ಲಾ ವಾಕ್ಯಗಳನ್ನು ಹೇಳಿದರು:<verse eid="EXO 20:1"/></para>
  <para style="b"/>
  <para style="li4">
    <verse number="2" style="v" sid="EXO 20:2"/>“ನಿನ್ನನ್ನು ಈಜಿಪ್ಟ್ ದೇಶದಿಂದಲೂ ದಾಸತ್ವದ ನಾಡಿನೊಳಗಿಂದಲೂ ಹೊರಗೆ ತಂದ ನಿನ್ನ ದೇವರಾದ ಯೆಹೋವ ದೇವರು ನಾನೇ.<verse eid="EXO 20:2"/></para>
  <para style="b"/>
  <para style="li1">
    <verse number="3" style="v" sid="EXO 20:3"/>“ನಾನಲ್ಲದೆ ನಿನಗೆ ಬೇರೆ ದೇವರುಗಳು ಇರಬಾರದು.<verse eid="EXO 20:3"/></para>
  <para style="li1">
    <verse number="4" style="v" sid="EXO 20:4"/>ಮೇಲಿನ ಆಕಾಶದಲ್ಲಾಗಲಿ, ಕೆಳಗಿನ ಭೂಮಿಯಲ್ಲಾಗಲಿ, ಭೂಮಿಯ ಕೆಳಗಿರುವ ನೀರುಗಳಲ್ಲಾಗಲಿ ಇರುವ ಯಾವುದರ ವಿಗ್ರಹವನ್ನಾಗಲಿ, ರೂಪವನ್ನಾಗಲಿ ನೀನು ಮಾಡಿಕೊಳ್ಳಬಾರದು. <verse eid="EXO 20:4"/><verse number="5" style="v" sid="EXO 20:5"/>ನೀನು ಅವುಗಳಿಗೆ ಅಡ್ಡ ಬೀಳಬಾರದು ಮತ್ತು ಆರಾಧಿಸಲೂಬಾರದು. ಏಕೆಂದರೆ ನಿನ್ನ ದೇವರಾದ ನಾನು, ನನಗೆ ಸಲ್ಲಬೇಕಾದ ಗೌರವವನ್ನು ಮತ್ತೊಬ್ಬರಿಗೆ ಸಲ್ಲಗೊಡಿಸದ ಸ್ವಾಮ್ಯಾಸಕ್ತನಾದ ಯೆಹೋವ ದೇವರಾಗಿದ್ದೇನೆ. ನನ್ನನ್ನು ಹಗೆ ಮಾಡುವ ತಂದೆತಾಯಿಗಳ ಅಪರಾಧವನ್ನು ಮಕ್ಕಳ ಮೇಲೆಯೂ ಮೂರನೆಯ ನಾಲ್ಕನೆಯ ತಲೆಗಳವರೆಗೂ ಬರಮಾಡುವೆನು. <verse eid="EXO 20:5"/><verse number="6" style="v" sid="EXO 20:6"/>ನನ್ನನ್ನು ಪ್ರೀತಿಸಿ, ನನ್ನ ಆಜ್ಞೆಗಳನ್ನು ಕೈಗೊಳ್ಳುವವರಿಗೆ, ಸಾವಿರ ತಲೆಗಳವರೆಗೆ ಪ್ರೀತಿ ತೋರಿಸುತ್ತೇನೆ.<verse eid="EXO 20:6"/></para>
  <para style="li1">
    <verse number="7" style="v" sid="EXO 20:7"/>ನಿನ್ನ ದೇವರಾದ ಯೆಹೋವ ದೇವರ ಹೆಸರನ್ನು ದುರುಪಯೋಗಮಾಡಬಾರದು. ಏಕೆಂದರೆ ಯೆಹೋವ ದೇವರು ತಮ್ಮ ಹೆಸರನ್ನು ದುರುಪಯೋಗಮಾಡುವವರನ್ನು ಶಿಕ್ಷಿಸದೆ ಬಿಡುವುದಿಲ್ಲ.<verse eid="EXO 20:7"/></para>
  <para style="li1">
    <verse number="8" style="v" sid="EXO 20:8"/>ಸಬ್ಬತ್ ದಿನವನ್ನು ಪರಿಶುದ್ಧ ದಿನವೆಂದು ಜ್ಞಾಪಕದಲ್ಲಿಟ್ಟುಕೊಂಡು ಆಚರಿಸಿರಿ. <verse eid="EXO 20:8"/><verse number="9" style="v" sid="EXO 20:9"/>ಆರು ದಿನಗಳಲ್ಲಿ ನೀನು ದುಡಿದು, ನಿನ್ನ ಕೆಲಸವನ್ನೆಲ್ಲಾ ಮಾಡಬೇಕು. <verse eid="EXO 20:9"/><verse number="10" style="v" sid="EXO 20:10"/>ಆದರೆ ಏಳನೆಯ ದಿನ ನಿನ್ನ ದೇವರಾದ ಯೆಹೋವ ದೇವರ ಸಬ್ಬತ್ ದಿನವಾಗಿದೆ. ಅದರಲ್ಲಿ ನೀನಾಗಲೀ, ನಿನ್ನ ಮಗನಾಗಲೀ, ನಿನ್ನ ಮಗಳಾಗಲೀ, ನಿನ್ನ ದಾಸನಾಗಲೀ, ನಿನ್ನ ದಾಸಿಯಾಗಲೀ, ನಿನ್ನ ಪಶುಗಳಾಗಲೀ ಮತ್ತು ನಿನ್ನ ಊರಲ್ಲಿರುವ ಅನ್ಯದೇಶದವರು ಸಹ ಯಾವ ಕೆಲಸವನ್ನೂ ಮಾಡಬಾರದು. <verse eid="EXO 20:10"/><verse number="11" style="v" sid="EXO 20:11"/>ಏಕೆಂದರೆ ಆರು ದಿನಗಳಲ್ಲಿ ಯೆಹೋವ ದೇವರು ಆಕಾಶವನ್ನೂ ಭೂಮಿಯನ್ನೂ ಸಮುದ್ರವನ್ನೂ ಅದರಲ್ಲಿರುವ ಪ್ರತಿಯೊಂದನ್ನೂ ಉಂಟುಮಾಡಿ, ಏಳನೆಯ ದಿನದಲ್ಲಿ ವಿಶ್ರಮಿಸಿಕೊಂಡನು. ಆದ್ದರಿಂದ ಯೆಹೋವ ದೇವರು ಸಬ್ಬತ್ ದಿನವನ್ನು ಆಶೀರ್ವದಿಸಿ, ಅದನ್ನು ಪರಿಶುದ್ಧ ಮಾಡಿದರು.<verse eid="EXO 20:11"/></para>
  <para style="li1">
    <verse number="12" style="v" sid="EXO 20:12"/>ನಿನ್ನ ದೇವರಾದ ಯೆಹೋವ ದೇವರು ನಿನಗೆ ಕೊಡುವ ದೇಶದಲ್ಲಿ ನೀನು ಬಹುಕಾಲ ಬಾಳುವಂತೆ ನಿನ್ನ ತಂದೆತಾಯಿಗಳನ್ನು ಗೌರವಿಸು.<verse eid="EXO 20:12"/></para>
  <para style="li1">
    <verse number="13" style="v" sid="EXO 20:13"/>ಕೊಲೆ ಮಾಡಬೇಡ.<verse eid="EXO 20:13"/></para>
  <para style="li1">
    <verse number="14" style="v" sid="EXO 20:14"/>ವ್ಯಭಿಚಾರ ಮಾಡಬೇಡ.<verse eid="EXO 20:14"/></para>
  <para style="li1">
    <verse number="15" style="v" sid="EXO 20:15"/>ಕದಿಯಬೇಡ.<verse eid="EXO 20:15"/></para>
  <para style="li1">
    <verse number="16" style="v" sid="EXO 20:16"/>ನಿನ್ನ ನೆರೆಯವನಿಗೆ ವಿರೋಧವಾಗಿ ಸುಳ್ಳುಸಾಕ್ಷಿ ಹೇಳಬೇಡ.<verse eid="EXO 20:16"/></para>
  <para style="li1">
    <verse number="17" style="v" sid="EXO 20:17"/>ನಿನ್ನ ನೆರೆಯವನ ಮನೆಯನ್ನು ಆಶಿಸಬೇಡ. ನಿನ್ನ ನೆರೆಯವನ ಹೆಂಡತಿಯನ್ನು ಆಶಿಸಬೇಡ. ಅವನ ದಾಸನನ್ನಾಗಲಿ, ಅವನ ದಾಸಿಯನ್ನಾಗಲಿ, ಅವನ ಎತ್ತನ್ನಾಗಲಿ, ಅವನ ಕತ್ತೆಯನ್ನಾಗಲಿ, ನಿನ್ನ ನೆರೆಯವನಿಗೆ ಇರುವ ಯಾವುದನ್ನೂ ಆಶಿಸಬೇಡ.”<verse eid="EXO 20:17"/></para>
  <para style="b"/>
  <para style="p">
    <verse number="18" style="v" sid="EXO 20:18"/>ಜನರೆಲ್ಲಾ ಗುಡುಗುಗಳನ್ನೂ ಮಿಂಚುಗಳನ್ನೂ ತುತೂರಿಯ ಶಬ್ದವನ್ನೂ ಬೆಟ್ಟದಲ್ಲಿ ಹೊಗೆ ಹಾಯುವುದನ್ನೂ ನೋಡಿದರು. ಜನರು ಅದನ್ನು ನೋಡಿ ನಡುಗುತ್ತಾ ದೂರಹೋಗಿ ನಿಂತುಕೊಂಡರು. <verse eid="EXO 20:18"/><verse number="19" style="v" sid="EXO 20:19"/>ಅವರು ಮೋಶೆಗೆ, “ನೀನೇ ನಮ್ಮ ಸಂಗಡ ಮಾತನಾಡು, ಆಗ ನಾವು ಕೇಳುವೆವು. ನಾವು ಸಾಯದ ಹಾಗೆ ದೇವರು ನಮ್ಮೊಂದಿಗೆ ನೇರವಾಗಿ ಮಾತನಾಡಲು ಬಿಡಬೇಡಿ,” ಎಂದು ವಿನಂತಿಸಿಕೊಂಡರು.<verse eid="EXO 20:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="EXO 20:20"/>ಆಗ ಮೋಶೆಯು ಜನರಿಗೆ, “ಭಯಪಡಬೇಡಿರಿ. ಏಕೆಂದರೆ ನಿಮ್ಮನ್ನು ಪರೀಕ್ಷಿಸುವುದಕ್ಕೋಸ್ಕರವೂ ನೀವು ಪಾಪಮಾಡದಂತೆ ಅವರ ಭಯವು ನಿಮಗಿರಲೆಂದೂ ದೇವರು ಬಂದಿದ್ದಾರೆ,” ಎಂದನು.<verse eid="EXO 20:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="EXO 20:21"/>ಆಗ ಜನರು ದೂರದಲ್ಲಿ ನಿಂತರು. ಮೋಶೆಯು ದೇವರಿದ್ದ ಕಾರ್ಗತ್ತಲೆಯ ಹತ್ತಿರ ಬಂದನು.<verse eid="EXO 20:21"/></para>
  <para style="s1">ವಿಗ್ರಹಗಳು ಮತ್ತು ಬಲಿಪೀಠ</para>
  <para style="p">
    <verse number="22" style="v" sid="EXO 20:22"/>ಯೆಹೋವ ದೇವರು ಮೋಶೆಗೆ, “ನೀನು ಇಸ್ರಾಯೇಲರಿಗೆ ಹೀಗೆ ಹೇಳಬೇಕು, ‘ನಾನು ಆಕಾಶದಿಂದ ನಿಮ್ಮ ಸಂಗಡ ಮಾತನಾಡಿದ್ದನ್ನು ನೀವು ನೋಡಿದ್ದೀರಿ. <verse eid="EXO 20:22"/><verse number="23" style="v" sid="EXO 20:23"/>ನನ್ನ ಹೊರತಾಗಿ ಬೆಳ್ಳಿ ಬಂಗಾರಗಳ ದೇವರುಗಳನ್ನು ಮಾಡಿಕೊಳ್ಳಬೇಡಿರಿ.<verse eid="EXO 20:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="EXO 20:24"/>“ ‘ಬಲಿಪೀಠವನ್ನು ಮಣ್ಣಿನಿಂದ ಮಾಡಬೇಕು. ಅದರ ಮೇಲೆ ನಿಮ್ಮ ಸಮರ್ಪಣೆಗಳಾದ ದಹನಬಲಿಗಳನ್ನೂ ಸಮಾಧಾನದ ಬಲಿಗಳನ್ನೂ ಕುರಿಮೇಕೆಗಳನ್ನೂ ದನಗಳನ್ನೂ ಅರ್ಪಿಸಬೇಕು. ನಾನು ನನ್ನ ಹೆಸರನ್ನು ಗೌರವಿಸುವಂತೆ ಮಾಡುವ ಎಲ್ಲಾ ಸ್ಥಳಗಳಲ್ಲಿಯೂ ನಾನು ನಿಮ್ಮ ಬಳಿಗೆ ಬಂದು ನಿಮ್ಮನ್ನು ಆಶೀರ್ವದಿಸುವೆನು. <verse eid="EXO 20:24"/><verse number="25" style="v" sid="EXO 20:25"/>ಬಲಿಪೀಠವನ್ನು ಕಲ್ಲಿನಿಂದ ಮಾಡಿದರೆ, ಅದನ್ನು ಕೆತ್ತಿದ ಕಲ್ಲಿನಿಂದ ಕಟ್ಟಬಾರದು. ಏಕೆಂದರೆ ಉಳಿಯನ್ನು ಅದರ ಮೇಲೆ ಉಪಯೋಗಿಸಿದರೆ, ಅದನ್ನು ಅಪವಿತ್ರಮಾಡಿದ ಹಾಗಾಗುತ್ತದೆ. <verse eid="EXO 20:25"/><verse number="26" style="v" sid="EXO 20:26"/>ನನಗಾಗಿ ಬಲಿಪೀಠದ ಮೇಲೆ ಹೋಗಲು ಹತ್ತುವಾಗ ನಿನ್ನ ಬೆತ್ತಲೆತನ ಕಾಣಬಾರದು. ಅದರ ಮೆಟ್ಟಲುಗಳನ್ನು ಹತ್ತಬಾರದು,’ ಎಂದು ಹೇಳಿದರು.<verse eid="EXO 20:26"/></para>
  <chapter eid="EXO 20"/>
  <chapter number="21" style="c" sid="EXO 21"/>
  <para style="p">
    <verse number="1" style="v" sid="EXO 21:1"/>“ಈಗ ಅವರ ಮುಂದೆ ನೀನು ಇಡತಕ್ಕ ನ್ಯಾಯವಿಧಿಗಳು ಇವೇ.<verse eid="EXO 21:1"/></para>
  <para style="s1">ಹಿಬ್ರಿಯ ದಾಸರು</para>
  <para style="p">
    <verse number="2" style="v" sid="EXO 21:2"/>“ನೀನು ಹಿಬ್ರಿಯ ದಾಸನನ್ನು ಕೊಂಡುಕೊಂಡರೆ, ಅವನು ಆರು ವರ್ಷ ನಿನಗೆ ಸೇವೆಮಾಡಬೇಕು. ಏಳನೆಯ ವರ್ಷದಲ್ಲಿ ಅವನು ಏನೂ ಕೊಡದೆ ಬಿಡುಗಡೆಯಾಗಿ ಹೋಗಲಿ. <verse eid="EXO 21:2"/><verse number="3" style="v" sid="EXO 21:3"/>ಅವನು ಒಬ್ಬನಾಗಿ ಬಂದಿದ್ದರೆ, ಒಬ್ಬನಾಗಿಯೇ ಹೋಗಬೇಕು. ಅವನು ಮದುವೆಯಾದವನಾಗಿದ್ದರೆ, ಅವನ ಹೆಂಡತಿಯು ಅವನ ಸಂಗಡ ಹೋಗಬೇಕು. <verse eid="EXO 21:3"/><verse number="4" style="v" sid="EXO 21:4"/>ಅವನ ಯಜಮಾನನು ಅವನಿಗೆ ಮದುವೆಮಾಡಿಸಿ ಆ ಹೆಂಡತಿಗೆ ಗಂಡು ಇಲ್ಲವೆ ಹೆಣ್ಣುಮಕ್ಕಳು ಹುಟ್ಟಿದ್ದರೆ, ಆ ಹೆಂಡತಿಯೂ ಅವಳ ಮಕ್ಕಳೂ ಯಜಮಾನನ ಸೊತ್ತಾಗುವರು. ಅವನು ಒಬ್ಬನಾಗಿಯೇ ಹೋಗಬೇಕು.<verse eid="EXO 21:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="EXO 21:5"/>“ಆದರೆ ದಾಸನು, ‘ನಾನು ನನ್ನ ಯಜಮಾನನನ್ನೂ ನನ್ನ ಹೆಂಡತಿಯನ್ನೂ ನನ್ನ ಮಕ್ಕಳನ್ನೂ ಪ್ರೀತಿಮಾಡುತ್ತೇನೆ. ಆದ್ದರಿಂದ ನಾನು ಬಿಡುಗಡೆಯಾಗಿ ಹೋಗುವುದಕ್ಕೆ ಮನಸ್ಸಿಲ್ಲ,’ ಎಂದು ಸ್ವಷ್ಟವಾಗಿ ಹೇಳಿದರೆ, <verse eid="EXO 21:5"/><verse number="6" style="v" sid="EXO 21:6"/>ಅವನ ಯಜಮಾನನು ಅವನನ್ನು ನ್ಯಾಯಾಧೀಶರ<note caller="+" style="f"><char style="fr" closed="false">21:6 </char><char style="ft" closed="false">ಅಥವಾ </char><char style="fqa" closed="false">ದೇವರು</char></note> ಬಳಿಗೆ ಕರಕೊಂಡು ಬಂದು, ಬಾಗಿಲಿನ ಬಳಿಗಾದರೂ ಅದರ ಕಂಬದ ಬಳಿಗಾದರೂ ಬರಮಾಡಿ, ಅವನ ಯಜಮಾನನು ಅವನ ಕಿವಿಯನ್ನು ದಬ್ಬಳದಿಂದ ಚುಚ್ಚಬೇಕು. ಆಗ ಅವನು ಸದಾಕಾಲಕ್ಕೂ ಅವನ ದಾಸನಾಗಿರಬೇಕು.<verse eid="EXO 21:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="EXO 21:7"/>“ಒಬ್ಬನು ತನ್ನ ಮಗಳನ್ನು ದಾಸಿಯನ್ನಾಗಿ ಮಾರಿದರೆ, ದಾಸರು ಹೋಗುವಂತೆ ಆಕೆಯು ಹೋಗಿಬಿಡಬಾರದು. <verse eid="EXO 21:7"/><verse number="8" style="v" sid="EXO 21:8"/>ಅವಳನ್ನು ನಿಶ್ಚಯಮಾಡಿಕೊಂಡ ಯಜಮಾನನಿಗೆ ಒಂದು ವೇಳೆ ಅವಳು ಮೆಚ್ಚಿಕೆಯಾಗದೆ ಹೋದರೆ, ಆಗ ಅವಳು ಬಿಡುಗಡೆಯಾಗುವಂತೆ ಮಾಡಲಿ. ಅವನು ಅವಳನ್ನು ವಂಚಿಸಿದ್ದರಿಂದ ಯೆಹೂದ್ಯರಲ್ಲದವರಿಗೆ ಅವಳನ್ನು ಮಾರುವುದಕ್ಕೆ ಅವನಿಗೆ ಅಧಿಕಾರವಿಲ್ಲ. <verse eid="EXO 21:8"/><verse number="9" style="v" sid="EXO 21:9"/>ಒಂದು ವೇಳೆ ಅವನು ತನ್ನ ಮಗನಿಗೆ ಅವಳನ್ನು ನಿಶ್ಚಯ ಮಾಡಿದರೆ, ಹೆಣ್ಣು ಮಕ್ಕಳ ನ್ಯಾಯದ ಪ್ರಕಾರ ಅವಳಿಗೆ ಮಾಡಬೇಕು. <verse eid="EXO 21:9"/><verse number="10" style="v" sid="EXO 21:10"/>ಒಂದು ವೇಳೆ ಅವನು ಇನ್ನೊಬ್ಬಳನ್ನು ಮದುವೆಯಾದರೆ, ಮೊದಲನೆಯವಳಿಗೆ ಅನ್ನ, ವಸ್ತ್ರ, ದಾಂಪತ್ಯದ ಹಕ್ಕನ್ನು ಕಡಿಮೆ ಮಾಡಬಾರದು. <verse eid="EXO 21:10"/><verse number="11" style="v" sid="EXO 21:11"/>ಈ ಮೂರನ್ನು ಅವಳಿಗೆ ಮಾಡದೆ ಹೋದರೆ, ಅವಳು ಏನೂ ಕ್ರಯ ಕೊಡದೆ, ಸ್ವತಂತ್ರಳಾಗಿ ಹೋಗಿಬಿಡಬಹುದು.<verse eid="EXO 21:11"/></para>
  <para style="s1">ಹಿಂಸಾಚಾರಗಳ ಬಗ್ಗೆ</para>
  <para style="p">
    <verse number="12" style="v" sid="EXO 21:12"/>“ಮನುಷ್ಯನನ್ನು ಸಾಯುವಂತೆ ಹೊಡೆದವನು ಖಂಡಿತವಾಗಿ ಸಾಯಬೇಕು. <verse eid="EXO 21:12"/><verse number="13" style="v" sid="EXO 21:13"/>ಆದರೆ ಕೊಲ್ಲಬೇಕೆಂಬ ಯೋಚನೆ ಇಲ್ಲದೆ ದೇವರು ಅನುಮತಿಸಿದ್ದರಿಂದ ಕೊಲೆಯಾದರೆ, ಕೊಂದವನು ಓಡಿಹೋಗುವಂತೆ ಅವನಿಗೆ ಒಂದು ಸ್ಥಳವನ್ನು ನಾನು ನೇಮಿಸುವೆನು. <verse eid="EXO 21:13"/><verse number="14" style="v" sid="EXO 21:14"/>ಆದರೆ ಒಬ್ಬನು ಮತ್ತೊಬ್ಬನನ್ನು ಕೊಲ್ಲಬೇಕೆಂಬ ಉದ್ದೇಶ ಇಟ್ಟುಕೊಂಡು ಮೋಸದಿಂದ ಕೊಂದರೆ, ಅವನು ಸಾಯುವಂತೆ ನೀನು ಅವನನ್ನು ನನ್ನ ಬಲಿಪೀಠದಿಂದ ದೂರ ತೆಗೆದುಕೊಂಡುಹೋಗಿ ಕೊಂದುಹಾಕಬೇಕು.<verse eid="EXO 21:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="EXO 21:15"/>“ತಂದೆತಾಯಿಗಳನ್ನು ಹೊಡೆಯುವವನು<note caller="+" style="f"><char style="fr" closed="false">21:15 </char><char style="ft" closed="false">ಅಥವಾ </char><char style="fqa" closed="false">ಕೊಲೆಮಾಡುವವನು</char></note> ಖಂಡಿತವಾಗಿ ಮರಣದಂಡನೆ ಹೊಂದಬೇಕು.<verse eid="EXO 21:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="EXO 21:16"/>“ಒಬ್ಬನು ಮತ್ತೊಬ್ಬನನ್ನು ಅಪಹರಿಸಿಕೊಂಡು ಹೋಗಿ ಮಾರಿದರೆ, ಇಲ್ಲವೆ ಅವನು ಬಂಧನಕ್ಕೊಳಗಾದಾಗ ಅಪಹರಿಸಲಾದವನು ಅವನೊಂದಿಗಿದ್ದರೆ, ಅವನನ್ನು ಮರಣದಂಡನೆಗೆ ಗುರಿಮಾಡಬೇಕು.<verse eid="EXO 21:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="EXO 21:17"/>“ತಂದೆಗಾದರೂ ತಾಯಿಗಾದರೂ ಶಾಪಕೊಟ್ಟವನು ಖಂಡಿತವಾಗಿ ಸಾಯಬೇಕು.<verse eid="EXO 21:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="EXO 21:18"/>“ಇಬ್ಬರು ಜಗಳವಾಡುವಾಗ ಒಬ್ಬನು ಮತ್ತೊಬ್ಬನನ್ನು ಕಲ್ಲಿನಿಂದಾಗಲಿ, ಮುಷ್ಟಿಯಿಂದಾಗಲಿ<note caller="+" style="f"><char style="fr" closed="false">21:18 </char><char style="ft" closed="false">ಅಥವಾ </char><char style="fqa" closed="false">ಯಾವುದಾದರೂ ಸಾಧನ</char></note> ಹೊಡೆದದ್ದರಿಂದ ಅವನು ಸಾಯದೆ ಗಾಯಗೊಂಡು, ಹಾಸಿಗೆ ಹಿಡಿದು, ಕ್ರಮೇಣ <verse eid="EXO 21:18"/><verse number="19" style="v" sid="EXO 21:19"/>ಅವನು ಎದ್ದು ಕೋಲೂರಿಕೊಂಡು ತಿರುಗಾಡುವುದಾದರೆ, ಅವನನ್ನು ಹೊಡೆದವನು ಅಪರಾಧವಿಲ್ಲದೆ ಹೋಗಬೇಕು. ಪೆಟ್ಟು ತಿಂದವನು ಗುಣಹೊಂದುವವರೆಗೆ ಆಗುವ ಖರ್ಚನ್ನು ಹೊಡೆದವನು ಕೊಡಬೇಕು ಮತ್ತು ಅವನನ್ನು ಪೂರ್ಣ ಸ್ವಸ್ಥನಾಗುವಂತೆ ಮಾಡಬೇಕು.<verse eid="EXO 21:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="EXO 21:20"/>“ಒಬ್ಬನು ದಾಸನನ್ನಾಗಲಿ, ದಾಸಿಯನ್ನಾಗಲಿ ಸಾಯುವಂತೆ ಕೋಲಿನಿಂದ ಹೊಡೆದಾಗ, ಹೊಡೆದವನಿಗೆ ಖಂಡಿತವಾಗಿ ಶಿಕ್ಷೆಯಾಗಬೇಕು. <verse eid="EXO 21:20"/><verse number="21" style="v" sid="EXO 21:21"/>ದಾಸದಾಸಿಯರು ಒಂದೆರಡು ದಿನಗಳ ನಂತರ ಉಳಿದರೆ ಶಿಕ್ಷೆಯಾಗಬಾರದು. ಏಕೆಂದರೆ ಅವರು ಅವನ ಸೊತ್ತು.<verse eid="EXO 21:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="EXO 21:22"/>“ಜನರು ಜಗಳವಾಡುವಾಗ ಗರ್ಭಿಣಿಯಾದ ಸ್ತ್ರೀಗೆ ಏಟು ತಗಲಿ ಗರ್ಭಸ್ರಾವವಾದರೆ, ಆ ಸ್ತ್ರೀಯ ಗಂಡನು ಕೇಳಿದಷ್ಟು ಮತ್ತು ನ್ಯಾಯಾಲಯವು ವಿಧಿಸುವಷ್ಟು ದಂಡವನ್ನು ಹೊಡೆದವನು ಕೊಡಬೇಕು. <verse eid="EXO 21:22"/><verse number="23" style="v" sid="EXO 21:23"/>ಬೇರೆ ಹಾನಿಯಾದ ಪಕ್ಷದಲ್ಲಿ ಪ್ರಾಣಕ್ಕೆ ಪ್ರಾಣವನ್ನು, ಕಣ್ಣಿಗೆ ಕಣ್ಣನ್ನು, <verse eid="EXO 21:23"/><verse number="24" style="v" sid="EXO 21:24"/>ಹಲ್ಲಿಗೆ ಹಲ್ಲು, ಕೈಗೆ ಕೈಯನ್ನು, ಕಾಲಿಗೆ ಕಾಲನ್ನು, <verse eid="EXO 21:24"/><verse number="25" style="v" sid="EXO 21:25"/>ಸುಟ್ಟ ಗಾಯಕ್ಕೆ ಸುಟ್ಟಗಾಯವನ್ನು, ಕಡಿದ ಗಾಯಕ್ಕೆ ಕಡಿದ ಗಾಯವನ್ನು, ಹೊಡೆದ ಗಾಯಕ್ಕೆ ಹೊಡೆದು ಗಾಯವನ್ನು ನೀನು ಮಾಡಬೇಕು.<verse eid="EXO 21:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="EXO 21:26"/>“ಒಬ್ಬನು ದಾಸನ ಕಣ್ಣನ್ನು ಇಲ್ಲವೆ ದಾಸಿಯ ಕಣ್ಣನ್ನು ಹೊಡೆದು ನಷ್ಟಪಡಿಸಿದರೆ, ಆ ಕಣ್ಣಿಗೋಸ್ಕರ ಅವರನ್ನು ಅವನು ಬಿಡುಗಡೆ ಮಾಡಿ ಕಳುಹಿಸಲಿ. <verse eid="EXO 21:26"/><verse number="27" style="v" sid="EXO 21:27"/>ಒಬ್ಬನು ದಾಸನ ಹಲ್ಲನ್ನು, ಇಲ್ಲವೆ ದಾಸಿಯ ಹಲ್ಲನ್ನು ಉದುರಿಸಿದರೆ, ಹಲ್ಲಿಗೋಸ್ಕರ ಅವರನ್ನು ಬಿಡುಗಡೆ ಮಾಡಿ ಕಳುಹಿಸಲಿ.<verse eid="EXO 21:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="EXO 21:28"/>“ಯಾವುದಾದರೂ ಒಂದು ಎತ್ತು ಪುರುಷನನ್ನಾಗಲಿ, ಸ್ತ್ರೀಯನ್ನಾಗಲಿ ಹಾಯ್ದು ಕೊಂದರೆ, ಆ ಎತ್ತನ್ನು ಖಂಡಿತವಾಗಿ ಕಲ್ಲೆಸೆದು ಕೊಲ್ಲಬೇಕು. ಅದರ ಮಾಂಸವನ್ನು ತಿನ್ನಬಾರದು. ಆ ಎತ್ತಿನ ಯಜಮಾನನು ನಿರಪರಾಧಿ. <verse eid="EXO 21:28"/><verse number="29" style="v" sid="EXO 21:29"/>ಆದರೆ ಆ ಎತ್ತು ಮೊದಲಿನಿಂದ ಹಾಯುವಂಥದ್ದೆಂದು ಯಜಮಾನನಿಗೆ ತಿಳಿದಿದ್ದರೂ ಅವನು ಅದನ್ನು ಕಟ್ಟಿಹಾಕದೆ ಇದ್ದುದರಿಂದ ಅದು ಪುರುಷನನ್ನಾಗಲಿ, ಸ್ತ್ರೀಯನ್ನಾಗಲಿ ಕೊಂದುಹಾಕಿದರೆ, ಆ ಎತ್ತನ್ನು ಕಲ್ಲೆಸೆದು ಕೊಲ್ಲಬೇಕು. ಆದರೆ ಯಜಮಾನನೂ ಮರಣದಂಡನೆಗೆ ಗುರಿಯಾಗುವನು. <verse eid="EXO 21:29"/><verse number="30" style="v" sid="EXO 21:30"/>ಒಂದು ವೇಳೆ ಅವನಿಗೆ ಪ್ರಾಯಶ್ಚಿತ್ತವನ್ನು ನೇಮಿಸಿದರೆ, ಅವನು ತನಗೆ ನೇಮಿಸಿದ್ದನ್ನೆಲ್ಲಾ ತನ್ನ ಪ್ರಾಣವಿಮೋಚನೆಗಾಗಿ ಕೊಡಲಿ. <verse eid="EXO 21:30"/><verse number="31" style="v" sid="EXO 21:31"/>ಅದು ಮಗನನ್ನು ಹಾಯ್ದಿದ್ದರೂ, ಮಗಳನ್ನು ಹಾಯ್ದಿದ್ದರೂ ಈ ನ್ಯಾಯತೀರ್ಪಿನ ಪ್ರಕಾರ ಅದರ ಯಜಮಾನನಿಗೆ ಮಾಡಬೇಕು. <verse eid="EXO 21:31"/><verse number="32" style="v" sid="EXO 21:32"/>ದಾಸನನ್ನಾದರೂ, ದಾಸಿಯನ್ನಾದರೂ ಎತ್ತು ಹಾಯ್ದರೆ, ದಾಸನ, ದಾಸಿಯ ಯಜಮಾನನಿಗೆ ಮೂವತ್ತು ಬೆಳ್ಳಿ ನಾಣ್ಯಗಳನ್ನು ಕೊಡಬೇಕು ಮತ್ತು ಎತ್ತನ್ನು ಕಲ್ಲೆಸೆದು ಕೊಲ್ಲಬೇಕು.<verse eid="EXO 21:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="EXO 21:33"/>“ಗುಂಡಿಯನ್ನು ಅಗೆದವನು ಅದನ್ನು ಮುಚ್ಚದೆ ಇದ್ದುದರಿಂದ ಎತ್ತಾದರೂ ಕತ್ತೆಯಾದರೂ ಆ ಗುಂಡಿಯಲ್ಲಿ ಬಿದ್ದು ಸತ್ತರೆ, <verse eid="EXO 21:33"/><verse number="34" style="v" sid="EXO 21:34"/>ಗುಂಡಿಯನ್ನು ಅಗೆದವನು ಈಡು ಕೊಡಬೇಕು. ಅವುಗಳ ಯಜಮಾನನಿಗೆ ಕ್ರಯ ನೀಡಬೇಕು. ಆದರೆ ಸತ್ತ ಪಶು ಅವನದಾಗಬೇಕು.<verse eid="EXO 21:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="EXO 21:35"/>“ಒಬ್ಬನ ಎತ್ತು ಮತ್ತೊಬ್ಬನ ಎತ್ತನ್ನು ಹಾಯ್ದು ಕೊಂದರೆ, ಜೀವದಿಂದಿರುವ ಎತ್ತನ್ನು ಮಾರಿ ಅದರ ಕ್ರಯವನ್ನೂ, ಸತ್ತ ಎತ್ತನ್ನೂ ಸರಿಯಾಗಿ ಇಬ್ಬರೂ ಪಾಲುಮಾಡಿಕೊಳ್ಳಬೇಕು. <verse eid="EXO 21:35"/><verse number="36" style="v" sid="EXO 21:36"/>ಇಲ್ಲವೆ ಆ ಎತ್ತು ಮೊದಲಿನಿಂದಲೂ ಹಾಯುವಂಥದ್ದೇ ಎಂದು ತಿಳಿದಿದ್ದರೂ, ಅದರ ಯಜಮಾನನು ಅದನ್ನು ಕಟ್ಟಿಹಾಕದೆ ಹೋಗಿದ್ದರೆ, ಎತ್ತಿಗೆ ಎತ್ತನ್ನು ಖಂಡಿತವಾಗಿ ಬದಲುಕೊಡಬೇಕು. ಆದರೆ ಸತ್ತ ಪಶುವನ್ನು ಅವನು ತೆಗೆದುಕೊಳ್ಳಬಹುದು.<verse eid="EXO 21:36"/></para>
  <chapter eid="EXO 21"/>
  <chapter number="22" style="c" sid="EXO 22"/>
  <para style="s1">ಆಸ್ತಿಯ ಭದ್ರತೆ</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 22:1"/>“ಒಬ್ಬನು ಎತ್ತನ್ನಾಗಲಿ, ಕುರಿಯನ್ನಾಗಲಿ ಕದ್ದು ಕೊಯ್ದರೆ, ಇಲ್ಲವೆ ಅದನ್ನು ಮಾರಿದರೆ, ಅವನು ಒಂದು ಎತ್ತಿಗೆ ಬದಲಾಗಿ ಐದು ಎತ್ತುಗಳನ್ನೂ, ಒಂದು ಕುರಿಗೆ ನಾಲ್ಕು ಕುರಿಗಳನ್ನೂ ಕೊಡಬೇಕು.<verse eid="EXO 22:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="EXO 22:2"/>“ಒಬ್ಬ ಕಳ್ಳನು ಮನೆ ಮುರಿಯುವಾಗಲೇ ಕೈಗೆ ಸಿಕ್ಕಿದಾಗ ಅವನನ್ನು ಹೊಡೆದುಕೊಂದರೆ, ಹೊಡೆದವನ ರಕ್ತ ಸುರಿಸಬಾರದು. <verse eid="EXO 22:2"/><verse number="3" style="v" sid="EXO 22:3"/>ಅವನು ಕಳ್ಳತನ ಮಾಡುವಾಗ ಸೂರ್ಯೋದಯವಾದರೆ, ಹೊಡೆದವನ ರಕ್ತ ಸುರಿಸಬೇಕು.</para>
  <para style="p" vid="EXO 22:3">“ಕಳ್ಳನು ಕದ್ದದ್ದನ್ನೆಲ್ಲಾ ಪೂರ್ತಿಯಾಗಿ ಹಿಂದಿರುಗಿಸಬೇಕು. ಅವನಲ್ಲಿ ಕೊಡಲು ಇಲ್ಲದ ಪಕ್ಷಕ್ಕೆ ಅವನ ಕಳ್ಳತನಕ್ಕಾಗಿ ಅವನನ್ನು ಗುಲಾಮನನ್ನಾಗಿ ಮಾರಬೇಕು. <verse eid="EXO 22:3"/><verse number="4" style="v" sid="EXO 22:4"/>ಕಳ್ಳತನ ಮಾಡಿದ ಎತ್ತಾಗಲಿ, ಕತ್ತೆಯಾಗಲಿ, ಕುರಿಯಾಗಲಿ ಕದ್ದವನ ಬಳಿಯಲ್ಲಿ ಜೀವವುಳ್ಳದ್ದಾಗಿ ಸಿಕ್ಕಿದರೆ ಅವನು ಎರಡರಷ್ಟು ಈಡು ಕೊಡಬೇಕು.<verse eid="EXO 22:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="EXO 22:5"/>“ಒಬ್ಬನು ಇನ್ನೊಬ್ಬನ ಹೊಲದಲ್ಲಿ ತನ್ನ ಪಶುಗಳನ್ನು ಬಿಟ್ಟು ಬೆಳೆಯನ್ನೂ, ದ್ರಾಕ್ಷಿ ತೋಟವನ್ನೂ ಮೇಯಿಸಿದರೆ, ಅವನು ತನ್ನ ಸ್ವಂತ ಹೊಲದ ಉತ್ತಮ ಭಾಗವನ್ನೂ, ದ್ರಾಕ್ಷಿ ತೋಟದಲ್ಲಿನ ಉತ್ತಮವಾದದ್ದನ್ನೂ ಈಡು ಕೊಡಬೇಕು.<verse eid="EXO 22:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="EXO 22:6"/>“ಬೆಂಕಿಹತ್ತಿ ಅದು ಮುಳ್ಳಿನ ಕೊಂಪೆಗೆ ತಗುಲಿ, ಸಿವುಡುಗಳ ಬಣವೆಗಳನ್ನಾಗಲಿ, ನಿಂತ ಬೆಳೆಯನ್ನಾಗಲಿ, ಹೊಲವನ್ನಾಗಲಿ ಸುಟ್ಟುಬಿಟ್ಟರೆ, ಆ ಬೆಂಕಿಯನ್ನು ಹಚ್ಚಿದವನು ಖಂಡಿತವಾಗಿ ಈಡು ಕೊಡಬೇಕು.<verse eid="EXO 22:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="EXO 22:7"/>“ಒಬ್ಬನು ತನ್ನ ನೆರೆಯವನಿಗೆ ತನ್ನ ಹಣವನ್ನಾಗಲಿ, ವಸ್ತುಗಳನ್ನಾಗಲಿ ಇಟ್ಟುಕೊಳ್ಳುವುದಕ್ಕೆ ಕೊಟ್ಟಾಗ, ಅದು ಅವನ ಮನೆಯಿಂದ ಕಳ್ಳತನವಾದರೆ, ಕಳ್ಳತನ ಮಾಡಿದವನು ಸಿಕ್ಕಿದರೆ, ಅವನು ಎರಡರಷ್ಟು ಕೊಡಬೇಕು. <verse eid="EXO 22:7"/><verse number="8" style="v" sid="EXO 22:8"/>ಕಳ್ಳನು ಸಿಕ್ಕದೆ ಹೋದರೆ ಮನೆಯ ಯಜಮಾನನು ತನ್ನ ನೆರೆಯವನ ವಸ್ತುಗಳನ್ನು ಅವನು ಮುಟ್ಟಲಿಲ್ಲವೆಂದು ವಿಚಾರಿಸುವುದಕ್ಕೆ ದೇವರ ಸನ್ನಿಧಿಯಲ್ಲಿ ಅವನನ್ನು ಹಾಜರುಪಡಿಸಬೇಕು. <verse eid="EXO 22:8"/><verse number="9" style="v" sid="EXO 22:9"/>ಎತ್ತು, ಕತ್ತೆ, ಕುರಿ ವಸ್ತ್ರಗಳ ವಿಷಯವಾದ ಎಲ್ಲಾ ಅಪರಾಧಗಳಿಗೋಸ್ಕರ ಇಲ್ಲವೆ ಕಳೆದುಹೋದ ಯಾವ ತರದ ವಸ್ತುಗಳ ವಿಷಯದಲ್ಲಿ ಒಬ್ಬನು ಇನ್ನೊಬ್ಬನ ಬಳಿಯಲ್ಲಿ ಅದನ್ನು ಕಂಡು, ‘ಇದು ತನ್ನದೆಂದು,’ ಹೇಳಿದ ಪಕ್ಷಕ್ಕೆ ಆ ಇಬ್ಬರ ವ್ಯಾಜ್ಯವು ದೇವರ ಸನ್ನಿಧಿಗೆ ಬರಬೇಕು. ನ್ಯಾಯಾಧಿಪತಿಗಳು ಯಾರನ್ನು ಅಪರಾಧಿಯೆಂದು ನಿರ್ಣಯಿಸುವರೋ, ಅವನು ಎರಡರಷ್ಟು ತನ್ನ ನೆರೆಯವನಿಗೆ ಕೊಡಬೇಕು.<verse eid="EXO 22:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="EXO 22:10"/>“ಒಬ್ಬನು ತನ್ನ ನೆರೆಯವನಿಗೆ ಕತ್ತೆಯನ್ನಾದರೂ ಎತ್ತನ್ನಾದರೂ ಕುರಿಯನ್ನಾದರೂ ಬೇರೆ ಯಾವ ಪಶುವನ್ನಾದರೂ ಕಾಯುವುದಕ್ಕೆ ಕೊಟ್ಟಾಗ, ಅದು ಸತ್ತರೆ, ಇಲ್ಲವೆ ಊನವಾದರೆ, ಇಲ್ಲವೆ ಯಾರೂ ತಿಳಿಯದಂತೆ ಸುಲಿಗೆಯಾದರೆ, <verse eid="EXO 22:10"/><verse number="11" style="v" sid="EXO 22:11"/>ತಾನು ತನ್ನ ನೆರೆಯವನ ವಸ್ತುವನ್ನು ತೆಗೆದುಕೊಳ್ಳಲಿಲ್ಲವೆಂದು ಅವರಿಬ್ಬರ ಮಧ್ಯದಲ್ಲಿ ಯೆಹೋವ ದೇವರ ಮುಂದೆ ಪ್ರಮಾಣಮಾಡಬೇಕು. ಅದನ್ನು ಪಶುವಿನ ಯಜಮಾನನು ಒಪ್ಪಿದರೆ ಅವನು ಈಡುಕೊಡಬಾರದು. <verse eid="EXO 22:11"/><verse number="12" style="v" sid="EXO 22:12"/>ಆದರೆ ಅದು ಅವನ ಬಳಿಯಿಂದ ಕಳ್ಳತನವಾಗಿ ಹೋಗಿದ್ದರೆ, ಯಜಮಾನನಿಗೆ ಈಡು ಕೊಡಬೇಕು. <verse eid="EXO 22:12"/><verse number="13" style="v" sid="EXO 22:13"/>ಕಾಡುಮೃಗವು ಅದನ್ನು ಕೊಂದಿದ್ದರೆ, ಅದರ ಹೆಣವನ್ನು ಸಾಕ್ಷಿಗಾಗಿ ತರಲಿ. ಕಾಡುಮೃಗ ಕೊಂದಿದ್ದಕ್ಕೆ ಈಡುಕೊಡಬೇಕಾದ ಅವಶ್ಯಕತೆ ಇಲ್ಲ.<verse eid="EXO 22:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="EXO 22:14"/>“ಒಬ್ಬನು ತನ್ನ ನೆರೆಯವನಿಂದ ಪಶುವನ್ನು ಎರವಲಾಗಿ ತೆಗೆದುಕೊಂಡಿರಲಾಗಿ ಅದರ ಒಡೆಯನು ಅದರ ಹತ್ತಿರ ಇಲ್ಲದಿರುವಾಗ, ಆ ಪಶುವಿಗೆ ಊನವಾದರೆ, ಇಲ್ಲವೆ ಅದು ಸತ್ತರೆ ಅದಕ್ಕೆ ಅವನು ಖಂಡಿತವಾಗಿ ಈಡು ಕೊಡಬೇಕು. <verse eid="EXO 22:14"/><verse number="15" style="v" sid="EXO 22:15"/>ಆದರೆ ಅದರ ಯಜಮಾನನು ಅದರ ಸಂಗಡ ಇದ್ದರೆ ಈಡು ಕೊಡದೆಯಿರಲಿ. ಅದು ಬಾಡಿಗೆಗೆ ತಂದಿದ್ದರೆ ಅದರ ಬಾಡಿಗೆಯಲ್ಲಿಯೇ ಎಣಿಕೆಯಾಗಲಿ.<verse eid="EXO 22:15"/></para>
  <para style="s1">ಸಾಮಾಜಿಕ ಜವಾಬ್ದಾರಿಕೆ</para>
  <para style="p">
    <verse number="16" style="v" sid="EXO 22:16"/>“ಒಬ್ಬನು ಕನ್ನಿಕೆಯನ್ನು ಮೋಸಗೊಳಿಸಿ, ಅವಳ ಸಂಗಡ ಮಲಗಿದರೆ ಅವಳು ತನ್ನ ಹೆಂಡತಿಯಾಗುವಂತೆ ಆಕೆಗೆ ಖಂಡಿತವಾಗಿ ತೆರವನ್ನು ಕೊಡಬೇಕು. <verse eid="EXO 22:16"/><verse number="17" style="v" sid="EXO 22:17"/>ಆಕೆಯ ತಂದೆಗೆ ಆಕೆಯನ್ನು ಕೊಡುವುದಕ್ಕೆ ಮನಸ್ಸಿಲ್ಲದಿದ್ದರೆ, ಅವನಿಗೆ ಕನ್ನಿಕೆಯ ತೆರವಿನ ಪ್ರಕಾರ ಹಣ ಸಲ್ಲಿಸಬೇಕು.<verse eid="EXO 22:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="EXO 22:18"/>“ಮಾಟಗಾರ್ತಿಯನ್ನು ಬದುಕಲು ಬಿಡಬಾರದು.<verse eid="EXO 22:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="EXO 22:19"/>“ಪಶುವಿನ ಸಂಗಡ ಸಂಗಮಿಸುವ ಯಾರಾದರೂ ಸರಿ, ಅಂಥವನಿಗೆ ಮರಣದಂಡನೆಯಾಗಬೇಕು.<verse eid="EXO 22:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="EXO 22:20"/>“ಯೆಹೋವ ದೇವರು ಹೊರತಾಗಿ ಮತ್ತೊಬ್ಬ ದೇವರಿಗೆ ಯಜ್ಞ ಅರ್ಪಿಸುವವನು ಸಂಪೂರ್ಣವಾಗಿ ನಾಶವಾಗಬೇಕು.<verse eid="EXO 22:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="EXO 22:21"/>“ಪರದೇಶಸ್ಥನನ್ನು ಉಪದ್ರವ ಪಡಿಸಬೇಡಿರಿ ಮತ್ತು ಬಾಧಿಸಲೂ ಬೇಡಿರಿ. ಏಕೆಂದರೆ ನೀವು ಈಜಿಪ್ಟ್ ದೇಶದಲ್ಲಿ ಪರದೇಶಿಗಳಾಗಿದ್ದೀರಿ.<verse eid="EXO 22:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="EXO 22:22"/>“ಯಾವ ವಿಧವೆಯನ್ನು, ದಿಕ್ಕಿಲ್ಲದ ಮಗುವನ್ನು ಬಾಧಿಸಬೇಡಿರಿ. <verse eid="EXO 22:22"/><verse number="23" style="v" sid="EXO 22:23"/>ನೀವು ಯಾವ ರೀತಿಯಲ್ಲಿ ಅವರನ್ನು ಬಾಧಿಸಿದರೂ ಅವರು ಕೂಗಿದರೆ ನಾನು ನಿಶ್ಚಯವಾಗಿ ಅವರ ಕೂಗನ್ನು ಕೇಳುವೆನು. <verse eid="EXO 22:23"/><verse number="24" style="v" sid="EXO 22:24"/>ಆಗ ನನ್ನ ಕೋಪವು ಉರಿಯುವುದು. ಖಡ್ಗದಿಂದ ನಿಮ್ಮನ್ನು ಕೊಲ್ಲುವೆನು. ನಿಮ್ಮ ಹೆಂಡತಿಯರು ವಿಧವೆಯರಾಗುವರು. ನಿಮ್ಮ ಮಕ್ಕಳು ದಿಕ್ಕಿಲ್ಲದವರಾಗುವರು.<verse eid="EXO 22:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="EXO 22:25"/>“ನಿಮ್ಮ ಬಳಿಯಲ್ಲಿ ಬಡವರಾಗಿರುವ ನನ್ನ ಜನರಿಗೆ ಹಣವನ್ನು ಸಾಲವಾಗಿ ಕೊಟ್ಟರೆ, ಅವನಿಂದ ಬಡ್ಡಿ ತೆಗೆದುಕೊಳ್ಳಬಾರದು. <verse eid="EXO 22:25"/><verse number="26" style="v" sid="EXO 22:26"/>ಇಲ್ಲವೆ ಅವನ ಮೇಲೆ ಬಡ್ಡಿ ಹೊರಿಸಬೇಡ. ನಿಮ್ಮ ನೆರೆಯವನ ಮೇಲಂಗಿಯನ್ನು ಅಡವು ಇಟ್ಟುಕೊಂಡಿದ್ದರೆ, ಸೂರ್ಯನು ಮುಳುಗುವುದರೊಳಗಾಗಿ ಅವನಿಗೆ ಹಿಂದಕ್ಕೆ ಕೊಡಬೇಕು. <verse eid="EXO 22:26"/><verse number="27" style="v" sid="EXO 22:27"/>ಏಕೆಂದರೆ ಅದು ಅವನಿಗೆ ಒಂದೇ ಹೊದಿಕೆಯಾಗಿದೆ. ಅದೇ ಅವನ ಮೈಗೆ ಉಡುಪು. ಅವನು ಯಾವುದನ್ನು ಹೊದ್ದುಕೊಂಡು ಮಲಗಿಯಾನು? ಅವನು ನನಗೆ ಮೊರೆಯಿಟ್ಟರೆ ನಾನು ಕೇಳುವೆನು. ಏಕೆಂದರೆ ನಾನು ಅನುಕಂಪ ಉಳ್ಳವನು.<verse eid="EXO 22:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="EXO 22:28"/>“ದೇವರನ್ನು ದೂಷಿಸಬೇಡ, ನಿನ್ನ ಜನರ ಅಧಿಕಾರಿಗಳನ್ನು ಶಪಿಸಬೇಡ.<verse eid="EXO 22:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="EXO 22:29"/>“ನಿನ್ನ ಧಾನ್ಯಗಳನ್ನೂ ಪಾನಗಳನ್ನೂ ನನಗೆ ಅರ್ಪಿಸುವುದಕ್ಕೆ ತಡಮಾಡಬೇಡ.</para>
  <para style="p" vid="EXO 22:29">“ನಿನ್ನ ಮಕ್ಕಳಲ್ಲಿ ಚೊಚ್ಚಲಾದವರನ್ನು ನನಗೆ ಮೀಸಲಾಗಿಡಬೇಕು. <verse eid="EXO 22:29"/><verse number="30" style="v" sid="EXO 22:30"/>ಅದರಂತೆಯೇ ನಿಮ್ಮ ದನಕುರಿಗಳನ್ನೂ ನನಗೆ ಸಮರ್ಪಿಸಬೇಕು. ಅದು ಏಳು ದಿನಗಳು ತಾಯಿಯ ಬಳಿಯಲ್ಲಿರಲಿ, ಎಂಟನೆಯ ದಿನದಲ್ಲಿ ಅದನ್ನು ನನಗೆ ಸಮರ್ಪಿಸಬೇಕು.<verse eid="EXO 22:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="EXO 22:31"/>“ನೀವು ನನಗೆ ಪರಿಶುದ್ಧ ಜನರಾಗಿರಬೇಕು. ಆದ್ದರಿಂದ ಹೊಲದಲ್ಲಿ ಕಾಡುಮೃಗ ಕೊಂದದ್ದನ್ನು ನೀವು ತಿನ್ನಬಾರದು, ಅದನ್ನು ನಾಯಿಗಳಿಗೆ ಹಾಕಬೇಕು.<verse eid="EXO 22:31"/></para>
  <chapter eid="EXO 22"/>
  <chapter number="23" style="c" sid="EXO 23"/>
  <para style="s1">ನ್ಯಾಯ ಹಾಗೂ ಕರುಣೆಯ ನಿಯಮಗಳು</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 23:1"/>“ಸುಳ್ಳು ಸುದ್ದಿಯನ್ನು ಹಬ್ಬಿಸಬಾರದು. ದುರುದ್ದೇಶಪೂರಿತ ಸಾಕ್ಷಿಯಾಗುವ ಮೂಲಕ ದುಷ್ಟರಿಗೆ ಸಹಾಯಮಾಡಬೇಡ.<verse eid="EXO 23:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="EXO 23:2"/>“ಕೆಟ್ಟದ್ದನ್ನು ಮಾಡುವವರು ಬಹುಮಂದಿ ಆದರೂ ನೀವು ಅವರನ್ನು ಹಿಂಬಾಲಿಸಬೇಡ. ಬಹುಮಂದಿಯೊಂದಿಗೆ ನ್ಯಾಯಕ್ಕೆ ವಿರುದ್ಧವಾಗಿ ವ್ಯಾಜ್ಯದಲ್ಲಿ ಸಾಕ್ಷಿಕೊಡಬೇಡ. <verse eid="EXO 23:2"/><verse number="3" style="v" sid="EXO 23:3"/>ಬಡವನಿಗೂ ವ್ಯಾಜ್ಯದಲ್ಲಿ ಮುಖದಾಕ್ಷಿಣ್ಯ ಮಾಡಬೇಡ.<verse eid="EXO 23:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="EXO 23:4"/>“ನೀವು ವೈರಿಯ ಎತ್ತಾಗಲಿ, ಕತ್ತೆಯಾಗಲಿ ತಪ್ಪಿಸಿಕೊಂಡು ಹೋಗುವಾಗ, ಅದು ನಿಮಗೆ ಸಿಕ್ಕಿದರೆ ನೀವು ಅದನ್ನು ಖಂಡಿತವಾಗಿ ತಿರುಗಿ ಅವನಿಗೆ ತಂದುಕೊಡಬೇಕು. <verse eid="EXO 23:4"/><verse number="5" style="v" sid="EXO 23:5"/>ನಿಮ್ಮನ್ನು ಹಗೆ ಮಾಡುವವನ ಕತ್ತೆಯು ತನ್ನ ಹೊರೆಯ ಕೆಳಗೆ ಬಿದ್ದಿರುವುದನ್ನು ನೀವು ಕಂಡಾಗ, ಅವನಿಗೆ ಸಹಾಯ ಮಾಡುವುದಕ್ಕೆ ಮನಸ್ಸಿಲ್ಲದಿದ್ದರೂ ನೀವು ಖಂಡಿತವಾಗಿ ಅವನಿಗೆ ಸಹಾಯಮಾಡಬೇಕು.<verse eid="EXO 23:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="EXO 23:6"/>“ಬಡವನ ವ್ಯಾಜ್ಯದಲ್ಲಿ ನ್ಯಾಯವನ್ನು ತಪ್ಪಿಸಿ ತೀರ್ಪುಕೊಡಬಾರದು. <verse eid="EXO 23:6"/><verse number="7" style="v" sid="EXO 23:7"/>ಸುಳ್ಳಿನ ವಿಷಯಗಳಿಂದ ನೀವು ದೂರವಿರಬೇಕು. ನಿರಪರಾಧಿ, ನೀತಿವಂತ ಆದ ವ್ಯಕ್ತಿಗೆ ಮರಣದಂಡನೆ ವಿಧಿಸಬಾರದು. ಅಂಥ ದುಷ್ಕೃತ್ಯ ಮಾಡಿದವನಿಗೆ ನಾನು ಶಿಕ್ಷೆ ವಿಧಿಸದೆ ಬಿಡುವುದಿಲ್ಲ.<verse eid="EXO 23:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="EXO 23:8"/>“ಲಂಚವನ್ನು ತೆಗೆದುಕೊಳ್ಳಬಾರದು. ಏಕೆಂದರೆ ಲಂಚವು ಜ್ಞಾನಿಗಳ ಕಣ್ಣುಗಳನ್ನು ಕುರುಡುಮಾಡಿ, ನಿರಪರಾಧಿಗೆ ದೊರಕಬೇಕಾದ ನ್ಯಾಯವನ್ನು ತಪ್ಪಿಸುತ್ತದೆ.<verse eid="EXO 23:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="EXO 23:9"/>“ಪರದೇಶಿಯರನ್ನು ಪೀಡಿಸಬಾರದು. ಏಕೆಂದರೆ ಈಜಿಪ್ಟ್ ದೇಶದಲ್ಲಿ ನೀವೂ ಪರದೇಶಿಗಳಾದ್ದಿರಷ್ಟೇ, ಅಂಥವರ ಮನೋವ್ಯಥೆಯನ್ನು ನಿಮಗೆ ತಿಳಿದಿದೆ.<verse eid="EXO 23:9"/></para>
  <para style="s1">ಸಬ್ಬತ್ ದಿನದ ನಿಯಮಗಳು</para>
  <para style="p">
    <verse number="10" style="v" sid="EXO 23:10"/>“ಆರು ವರ್ಷ ನಿಮ್ಮ ಭೂಮಿಗೆ ಬೀಜ ಹಾಕಿ, ಅದರ ಬೆಳೆಯನ್ನು ಕೂಡಿಸಬೇಕು. <verse eid="EXO 23:10"/><verse number="11" style="v" sid="EXO 23:11"/>ಆದರೆ ಏಳನೆಯ ವರುಷದಲ್ಲಿ ಅದಕ್ಕೆ ವಿಶ್ರಾಂತಿಯನ್ನು ಕೊಟ್ಟು, ಅದನ್ನು ಬೀಳುಬಿಡಬೇಕು. ಆಗ ನಿಮ್ಮ ಜನರಲ್ಲಿರುವ ಬಡವರು ಅದರಲ್ಲಿ ಬೆಳೆದದ್ದನ್ನು ತಿನ್ನಲಿ. ಅವರು ಬಿಟ್ಟದ್ದನ್ನು ಕಾಡುಮೃಗಗಳು ತಿನ್ನಲಿ. ನಿಮ್ಮ ದ್ರಾಕ್ಷಿತೋಟದ, ಓಲಿವ್ ಮರಗಳ ವಿಷಯದಲ್ಲಿಯೂ ಹಾಗೆಯೇ ಮಾಡಬೇಕು.<verse eid="EXO 23:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="EXO 23:12"/>“ಆರು ದಿವಸ ನೀವು ನಿಮ್ಮ ಕೆಲಸಗಳನ್ನು ಮಾಡಬೇಕು. ಏಳನೆಯ ದಿನದಲ್ಲಿ ನೀವು, ನಿಮ್ಮ ಎತ್ತು ಮತ್ತು ನಿಮ್ಮ ಕತ್ತೆ ವಿಶ್ರಮಿಸಿಕೊಳ್ಳಬೇಕು. ಇದಲ್ಲದೆ ನಿಮ್ಮ ಮನೆಯಲ್ಲಿ ಜನಿಸಿದ ದಾಸದಾಸಿಯರೂ ಪರದೇಶಸ್ಥರೂ ದಣಿವು ಆರಿಸಿಕೊಳ್ಳಲಿ.<verse eid="EXO 23:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="EXO 23:13"/>“ನಾನು ನಿಮಗೆ ಆಜ್ಞಾಪಿಸಿದ್ದನ್ನೆಲ್ಲಾ ಜಾಗರೂಕತೆಯಿಂದ ಕೈಗೊಳ್ಳಬೇಕು. ಬೇರೆ ದೇವರುಗಳ ಹೆಸರನ್ನು ಎತ್ತಬೇಡ. ಅದನ್ನು ಉಚ್ಚರಿಸಲೂ ಬೇಡ.<verse eid="EXO 23:13"/></para>
  <para style="s1">ಮೂರು ವಾರ್ಷಿಕೋತ್ಸವಗಳು</para>
  <para style="p">
    <verse number="14" style="v" sid="EXO 23:14"/>“ವರ್ಷಕ್ಕೆ ಮೂರು ಸಾರಿ ನನಗೆ ಹಬ್ಬ ಮಾಡಬೇಕು.<verse eid="EXO 23:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="EXO 23:15"/>“ಹುಳಿಯಿಲ್ಲದ ರೊಟ್ಟಿಗಳ ಹಬ್ಬವನ್ನು ಆಚರಿಸಬೇಕು. ಅಬೀಬ ತಿಂಗಳಿನ ನೇಮಕವಾದ ಸಮಯದಲ್ಲಿ ಏಳು ದಿನಗಳವರೆಗೆ ನಾನು ನಿಮಗೆ ಆಜ್ಞಾಪಿಸಿದ ಪ್ರಕಾರ ಹುಳಿಯಿಲ್ಲದ ರೊಟ್ಟಿಗಳನ್ನು ತಿನ್ನಬೇಕು. ಏಕೆಂದರೆ ನೀವು ಆ ತಿಂಗಳಲ್ಲೇ ಈಜಿಪ್ಟಿನಿಂದ ಹೊರಗೆ ಬಂದಿದ್ದೀರಿ.</para>
  <para style="p" vid="EXO 23:15">“ಒಬ್ಬರೂ ಕಾಣಿಕೆಯಿಲ್ಲದೆ ಬರಿಗೈಯಿಂದ ನನ್ನ ಸನ್ನಿಧಿಗೆ ಬರಬಾರದು.<verse eid="EXO 23:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="EXO 23:16"/>“ನೀವು ಬಿತ್ತಿದ ಹೊಲದಲ್ಲಿ ಪ್ರಥಮ ಫಲವು ದೊರೆತಾಗ ಸುಗ್ಗಿ ಹಬ್ಬವನ್ನು ಆಚರಿಸಬೇಕು.</para>
  <para style="p" vid="EXO 23:16">“ಹೊಲತೋಟಗಳ ಬೆಳೆಯನ್ನು ಕೂಡಿಸುವಾಗ<note caller="+" style="f"><char style="fr" closed="false">23:16 </char><char style="ft" closed="false">ಇದನ್ನು ವಾರಗಳ ಹಬ್ಬವೆಂದೂ ಕರೆಯುತ್ತಾರೆ, ಇವತ್ತಿನ ದಿನದಲ್ಲಿ ಇದನ್ನು ಶಾವು ಆತ ಅಥವಾ ಶಬು ಒತ ಎಂದು ಕರೆಯುತ್ತಾರೆ. <char style="xt"><ref loc="EXO 34:22">ವಿಮೋ 34:22</ref>; <ref loc="LEV 23:15-22">ಯಾಜಕ 23:15-22</ref></char></char></note> ಅಂದರೆ, ವರ್ಷದ ಕೊನೆಯಲ್ಲಿ ಫಲಸಂಗ್ರಹದ ಹಬ್ಬವನ್ನು ಆಚರಿಸಬೇಕು.<note caller="+" style="f"><char style="fr" closed="false">23:16 </char><char style="ft" closed="false">ನಂತರದ ದಿನಗಳಲ್ಲಿ ಇದನ್ನು ಗುಡಾರದ ಹಬ್ಬವೆಂದು ಕರೆಯಲಾಗಿದೆ. <char style="xt"><ref loc="LEV 23:16-20">ಯಾಜಕ 23:16-20</ref></char></char></note><verse eid="EXO 23:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="EXO 23:17"/>“ವರ್ಷಕ್ಕೆ ಮೂರು ಸಾರಿ ನಿಮ್ಮಲ್ಲಿರುವ ಪುರುಷರೆಲ್ಲಾ ಸಾರ್ವಭೌಮ ಯೆಹೋವ ದೇವರ ಸನ್ನಿಧಿಯಲ್ಲಿ ಕಾಣಿಸಿಕೊಳ್ಳಬೇಕು.<verse eid="EXO 23:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="EXO 23:18"/>“ಬಲಿ ಅರ್ಪಣೆಯ ರಕ್ತವನ್ನು ಹುಳಿಯಿರುವ ರೊಟ್ಟಿಯ ಸಂಗಡ ಅರ್ಪಿಸಬಾರದು.</para>
  <para style="p" vid="EXO 23:18">“ಯಾವುದೇ ಹಬ್ಬದ ಅರ್ಪಣೆಯಲ್ಲಿ ಕೊಬ್ಬನ್ನು ಬೆಳಗಿನವರೆಗೆ ಇಟ್ಟುಕೊಳ್ಳಬಾರದು.<verse eid="EXO 23:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="EXO 23:19"/>“ನಿಮ್ಮ ಭೂಮಿಯ ಪ್ರಥಮ ಫಲಗಳಲ್ಲಿ ಅತ್ಯುತ್ತಮವಾದದ್ದನ್ನು ನಿಮ್ಮ ಯೆಹೋವ ದೇವರ ಆಲಯಕ್ಕೆ ತರಬೇಕು.</para>
  <para style="p" vid="EXO 23:19">“ಮೇಕೆಯ ಮರಿಯನ್ನು ಅದರ ತಾಯಿಯ ಹಾಲಿನಲ್ಲಿ ಬೇಯಿಸಬಾರದು.<verse eid="EXO 23:19"/></para>
  <para style="s1">ಮಾರ್ಗ ಸಿದ್ಧಪಡಿಸಲು ದೇವದೂತನು</para>
  <para style="p">
    <verse number="20" style="v" sid="EXO 23:20"/>“ಮಾರ್ಗದಲ್ಲಿ ನಿಮ್ಮನ್ನು ಕಾಪಾಡುವುದಕ್ಕೋಸ್ಕರವೂ ನಾನು ಸಿದ್ಧಮಾಡಿದ ಸ್ಥಳಕ್ಕೆ ತರುವುದಕ್ಕೋಸ್ಕರವೂ ನಾನು ಒಬ್ಬ ದೂತನನ್ನು ನಿಮ್ಮ ಮುಂದೆ ಕಳುಹಿಸುತ್ತೇನೆ. <verse eid="EXO 23:20"/><verse number="21" style="v" sid="EXO 23:21"/>ಅವನ ವಿಷಯದಲ್ಲಿ ಜಾಗ್ರತೆಯಾಗಿದ್ದು, ಅವನ ಮಾತಿಗೆ ವಿಧೇಯರಾಗಿರಿ. ಅವನಿಗೆ ಕೋಪವನ್ನೆಬ್ಬಿಸಬೇಡಿರಿ. ಏಕೆಂದರೆ ನನ್ನ ಹೆಸರು ಅವನಲ್ಲಿ ಇರುವುದರಿಂದ ಅವನು ನಿಮ್ಮ ದ್ರೋಹಗಳನ್ನು ಮನ್ನಿಸುವುದಿಲ್ಲ. <verse eid="EXO 23:21"/><verse number="22" style="v" sid="EXO 23:22"/>ಅವನ ಮಾತಿಗೆ ನೀವು ನಿಜವಾಗಿಯೂ ವಿಧೇಯರಾಗಿ ನಾನು ಹೇಳಿದ್ದನ್ನೆಲ್ಲಾ ನೀವು ಮಾಡಿದರೆ, ನಿಮ್ಮ ಶತ್ರುಗಳಿಗೆ ನಾನು ಶತ್ರುವಾಗಿಯೂ ನಿಮ್ಮ ವಿರೋಧಿಗಳಿಗೆ ನಾನು ವಿರೋಧಿಯಾಗಿಯೂ ಇರುವೆನು. <verse eid="EXO 23:22"/><verse number="23" style="v" sid="EXO 23:23"/>ಏಕೆಂದರೆ ನನ್ನ ದೂತನು ನಿಮ್ಮ ಮುಂದೆ ಹೋಗಿ ಅಮೋರಿಯರು, ಹಿತ್ತಿಯರು, ಪೆರಿಜೀಯರು, ಕಾನಾನ್ಯರು, ಹಿವ್ವಿಯರು ಮತ್ತು ಯೆಬೂಸಿಯರು ಇರುವ ದೇಶಕ್ಕೆ ನಿಮ್ಮನ್ನು ಬರಮಾಡುವನು. ಅವರನ್ನು ನಾನು ನಿರ್ಮೂಲ ಮಾಡುವೆನು. <verse eid="EXO 23:23"/><verse number="24" style="v" sid="EXO 23:24"/>ಅವರ ದೇವರುಗಳಿಗೆ ನೀವು ಅಡ್ಡಬೀಳಲೂಬಾರದು, ಅವುಗಳನ್ನು ಆರಾಧಿಸಲೂಬಾರದು. ಇದಲ್ಲದೆ ನೀವು ಅವರ ಕೃತ್ಯಗಳ ಪ್ರಕಾರ ಮಾಡದೆ, ಅವರನ್ನು ನಿರ್ಮೂಲ ಮಾಡಿಬಿಟ್ಟು, ಅವರ ವಿಗ್ರಹಗಳನ್ನು ಪೂರ್ಣವಾಗಿ ಒಡೆದುಹಾಕಬೇಕು. <verse eid="EXO 23:24"/><verse number="25" style="v" sid="EXO 23:25"/>ನೀವು ನಿಮ್ಮ ದೇವರಾದ ಯೆಹೋವ ದೇವರಿಗೆ ಆರಾಧನೆ ಮಾಡಬೇಕು. ಆಗ ಆತನು ನಿಮ್ಮ ಆಹಾರವನ್ನೂ ನೀರನ್ನೂ ಆಶೀರ್ವದಿಸುವನು. ನಾನು ವ್ಯಾಧಿಯನ್ನು ನಿಮ್ಮ ಮಧ್ಯದಿಂದ ತೊಲಗಿಸಿಬಿಡುವೆನು. <verse eid="EXO 23:25"/><verse number="26" style="v" sid="EXO 23:26"/>ಗರ್ಭ ಸ್ರಾವವಾಗಲಿ, ಬಂಜೆತನವಾಗಲಿ ನಿಮ್ಮ ದೇಶದಲ್ಲಿ ಇರುವುದಿಲ್ಲ. ನಾನು ನಿಮಗೆ ಸಂಪೂರ್ಣವಾದ ಆಯುಷ್ಯವನ್ನು ಅನುಗ್ರಹಿಸುವೆನು.<verse eid="EXO 23:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="EXO 23:27"/>“ನೀವು ಹೋಗುವ ಎಲ್ಲ ಜಾಗಗಳಲ್ಲಿಯೂ ನನ್ನ ಮೇಲಿನ ಭೀತಿಯನ್ನು ನಿಮ್ಮನ್ನು ಎದುರಿಸುವ ಜನರಲ್ಲಿ ಉಂಟುಮಾಡಿಸಿ, ಕಳವಳವನ್ನು ಉಂಟುಮಾಡುವೆನು ಮತ್ತು ನಿಮ್ಮನ್ನು ವಿರೋಧಿಸುವವರೆಲ್ಲಾ ನಿಮಗೆ ಬೆನ್ನು ತೋರಿಸುವಂತೆ ಮಾಡುವೆನು. <verse eid="EXO 23:27"/><verse number="28" style="v" sid="EXO 23:28"/>ಹಿವ್ವಿಯರು, ಕಾನಾನ್ಯರು ಮತ್ತು ಹಿತ್ತಿಯರೂ ನಿಮ್ಮ ಎದುರಿನಿಂದ ಓಡಿಹೋಗುವಂತೆ ಕಡಜದ ಹುಳಗಳನ್ನು ನಿಮ್ಮ ಮುಂದೆ ಕಳಹಿಸುವೆನು. <verse eid="EXO 23:28"/><verse number="29" style="v" sid="EXO 23:29"/>ಭೂಮಿಯು ಬರಿದಾಗದಂತೆಯೂ ಕಾಡುಮೃಗಗಳು ನಿಮ್ಮ ವಿರೋಧವಾಗಿ ಹೆಚ್ಚಾಗದ ಹಾಗೆಯೂ ಅವುಗಳನ್ನು ಒಂದೇ ವರ್ಷದಲ್ಲಿ ನಿಮ್ಮ ಎದುರಿನಿಂದ ಓಡಿಸದೆ <verse eid="EXO 23:29"/><verse number="30" style="v" sid="EXO 23:30"/>ನೀವು ಅಭಿವೃದ್ಧಿಯಾಗಿ ದೇಶವನ್ನು ಸ್ವತಂತ್ರಿಸಿಕೊಳ್ಳುವವರೆಗೆ ಸ್ವಲ್ಪ ಸ್ವಲ್ಪವಾಗಿ ಹೊರಡಿಸುತ್ತಿರುವೆನು.<verse eid="EXO 23:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="EXO 23:31"/>“ಕೆಂಪು ಸಮುದ್ರದಿಂದ ಫಿಲಿಷ್ಟಿಯರ ಸಮುದ್ರದವರೆಗೆ<note caller="+" style="f"><char style="fr" closed="false">23:31 </char><char style="ft" closed="false">ಅಥವಾ </char><char style="fqa" closed="false">ಮೆಡಿಟರೇನಿಯನ್ ಸಮುದ್ರ</char></note> ಮರುಭೂಮಿಯಿಂದ ನದಿಯವರೆಗೂ ನಿಮ್ಮ ಮೇರೆಗಳನ್ನು ನೇಮಿಸುವೆನು. ದೇಶದ ನಿವಾಸಿಗಳನ್ನು ನಿಮ್ಮ ಕೈಗಳಿಗೆ ಒಪ್ಪಿಸುವೆನು. ನೀವು ಅವರನ್ನು ನಿಮ್ಮ ಎದುರಿನಿಂದ ಓಡಿಸಿಬಿಡುವಿರಿ. <verse eid="EXO 23:31"/><verse number="32" style="v" sid="EXO 23:32"/>ಅವರ ಸಂಗಡ, ಅವರ ದೇವರುಗಳ ಸಂಗಡ ಯಾವ ಒಡಂಬಡಿಕೆಯನ್ನು ಮಾಡಿಕೊಳ್ಳಬಾರದು. <verse eid="EXO 23:32"/><verse number="33" style="v" sid="EXO 23:33"/>ನನಗೆ ವಿರೋಧವಾಗಿ ನೀವು ಪಾಪಮಾಡದಂತಾಗಬೇಕಾದರೆ, ಅವರು ನಿಮ್ಮ ದೇಶದಲ್ಲಿ ವಾಸವಾಗಿರಬಾರದು. ಏಕೆಂದರೆ ನೀವು ಅವರ ದೇವರುಗಳನ್ನು ಆರಾಧಿಸಿದರೆ ಅದು ನಿಮಗೆ ಖಂಡಿತವಾಗಿ ಉರುಲಾಗಿರುವುದು.”<verse eid="EXO 23:33"/></para>
  <chapter eid="EXO 23"/>
  <chapter number="24" style="c" sid="EXO 24"/>
  <para style="s1">ಒಡಂಬಡಿಕೆಯ ದೃಢೀಕರಣ</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 24:1"/>ತರುವಾಯ ಯೆಹೋವ ದೇವರು ಮೋಶೆಗೆ, “ನೀನು, ಆರೋನ್, ನಾದಾಬ್, ಅಬೀಹೂ ಮತ್ತು ಇಸ್ರಾಯೇಲಿನ ಹಿರಿಯರಲ್ಲಿ ಎಪ್ಪತ್ತು ಮಂದಿಯೂ ಈ ಬೆಟ್ಟವನ್ನು ಹತ್ತಿ ಯೆಹೋವ ದೇವರಾದ ನನ್ನ ಬಳಿಗೆ ಬಂದು ದೂರದಲ್ಲಿ ಆರಾಧಿಸಿರಿ. <verse eid="EXO 24:1"/><verse number="2" style="v" sid="EXO 24:2"/>ಮೋಶೆ ಒಬ್ಬನೇ ಯೆಹೋವ ದೇವರ ಸಮೀಪಕ್ಕೆ ಬರಲಿ. ಬೇರೆ ಯಾರೂ ಸಮೀಪಕ್ಕೆ ಬರಬಾರದು. ಜನರೂ ಅವನ ಸಂಗಡ ಮೇಲೇರಿ ಬರಬಾರದು,” ಎಂದು ಹೇಳಿದರು.<verse eid="EXO 24:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="EXO 24:3"/>ಮೋಶೆಯು ಬಂದು ಯೆಹೋವ ದೇವರ ಎಲ್ಲಾ ಮಾತುಗಳನ್ನೂ ಎಲ್ಲಾ ನ್ಯಾಯವಿಧಿಗಳನ್ನು ಜನರಿಗೆ ತಿಳಿಸಿದನು. ಆಗ ಜನರೆಲ್ಲಾ ಒಂದೇ ಸ್ವರದಿಂದ, “ಯೆಹೋವ ದೇವರು ಹೇಳಿದ ಎಲ್ಲಾ ಮಾತುಗಳ ಪ್ರಕಾರ ಮಾಡುತ್ತೇವೆ,” ಎಂದು ಉತ್ತರಕೊಟ್ಟರು. <verse eid="EXO 24:3"/><verse number="4" style="v" sid="EXO 24:4"/>ಮೋಶೆಯು ಯೆಹೋವ ದೇವರು ಪ್ರಕಟಪಡಿಸಿದ ಮಾತುಗಳನ್ನೆಲ್ಲಾ ಬರೆದಿಟ್ಟನು.</para>
  <para style="p" vid="EXO 24:4">ಅವನು ಮರುದಿನ ಬೆಳಿಗ್ಗೆ ಎದ್ದು ಬೆಟ್ಟದ ಕೆಳಗೆ ಬಲಿಪೀಠವನ್ನು ಕಟ್ಟಿಸಿ, ಇಸ್ರಾಯೇಲಿನ ಹನ್ನೆರಡು ಗೋತ್ರಗಳಿಗನುಸಾರವಾಗಿ ಹನ್ನೆರಡು ಸ್ತಂಭಗಳನ್ನು ನಿಲ್ಲಿಸಿದನು. <verse eid="EXO 24:4"/><verse number="5" style="v" sid="EXO 24:5"/>ಅವನು ಯೆಹೋವ ದೇವರಿಗೆ ದಹನಬಲಿಗಳನ್ನೂ ಸಮಾಧಾನದ ಬಲಿಗಾಗಿ ಹೋರಿಗಳನ್ನೂ ಅರ್ಪಿಸುವುದಕ್ಕಾಗಿ ಇಸ್ರಾಯೇಲರ ಯೌವನಸ್ಥರನ್ನು ಕಳುಹಿಸಲು ಅವರು ಅದನ್ನು ಅರ್ಪಿಸಿದರು. <verse eid="EXO 24:5"/><verse number="6" style="v" sid="EXO 24:6"/>ಮೋಶೆಯು ರಕ್ತದಲ್ಲಿ ಅರ್ಧವನ್ನು ತೆಗೆದುಕೊಂಡು ಬೋಗುಣಿಗಳಲ್ಲಿ ಹಾಕಿದನು ಮತ್ತು ರಕ್ತದಲ್ಲಿ ಮಿಕ್ಕ ಅರ್ಧವನ್ನು ಬಲಿಪೀಠದ ಮೇಲೆ ಚಿಮುಕಿಸಿದನು. <verse eid="EXO 24:6"/><verse number="7" style="v" sid="EXO 24:7"/>ಒಡಂಬಡಿಕೆಯ ಗ್ರಂಥವನ್ನು ತೆಗೆದುಕೊಂಡು ಜನರ ಸಭೆಯಲ್ಲಿ ಓದಿದನು. ಆಗ ಅವರು, “ಯೆಹೋವ ದೇವರ ಆಜ್ಞೆಗಳನ್ನೆಲ್ಲಾ ನಾವು ಅನುಸರಿಸಿ ಅವುಗಳಿಗೆ ವಿಧೇಯರಾಗುವೆವು,” ಎಂದರು.<verse eid="EXO 24:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="EXO 24:8"/>ತರುವಾಯ ಮೋಶೆಯು ರಕ್ತವನ್ನು ತೆಗೆದುಕೊಂಡು ಜನರ ಮೇಲೆ ಚಿಮುಕಿಸಿ, “ಈ ಎಲ್ಲಾ ಮಾತುಗಳ ವಿಷಯದಲ್ಲಿ ಯೆಹೋವ ದೇವರು ನಿಮ್ಮೊಂದಿಗೆ ಮಾಡಿದ ಒಡಂಬಡಿಕೆಯ ರಕ್ತ,” ಎಂದನು.<verse eid="EXO 24:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="EXO 24:9"/>ಆಗ ಮೋಶೆ, ಆರೋನ್, ನಾದಾಬ್, ಅಬೀಹೂ ಮತ್ತು ಇಸ್ರಾಯೇಲಿನ ಹಿರಿಯರಲ್ಲಿ ಎಪ್ಪತ್ತು ಮಂದಿಯೂ ಮೇಲಕ್ಕೆ ಹೋದರು. <verse eid="EXO 24:9"/><verse number="10" style="v" sid="EXO 24:10"/>ಅವರು ಇಸ್ರಾಯೇಲಿನ ದೇವರನ್ನು ನೋಡಿದರು. ಆತನ ಪಾದಗಳ ಕೆಳಗೆ ನೀಲ ವರ್ಣದ ಕಲ್ಲಿನ ಕೆಲಸಕ್ಕೆ ಸಮಾನವಾದದ್ದೂ, ಆಕಾಶದ ಹಾಗೆ ನಿರ್ಮಲವಾದದ್ದೂ ಇತ್ತು. <verse eid="EXO 24:10"/><verse number="11" style="v" sid="EXO 24:11"/>ಆದರೆ ದೇವರು ಇಸ್ರಾಯೇಲರ ಶ್ರೇಷ್ಠರನ್ನು ತಳ್ಳಿಬಿಡಲಿಲ್ಲ. ಅವರು ಸಹ ದೇವರನ್ನು ನೋಡಿ, ಊಟಮಾಡಿ, ಪಾನಮಾಡಿದರು.<verse eid="EXO 24:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="EXO 24:12"/>ಯೆಹೋವ ದೇವರು ಮೋಶೆಗೆ, “ಬೆಟ್ಟವನ್ನೇರಿ, ನನ್ನ ಬಳಿಗೆ ಬಂದು ಇಲ್ಲೇ ಇರು. ನಿಯಮವನ್ನು ಹಾಗು ಆಜ್ಞೆಗಳನ್ನು ನೀನು ಜನರಿಗೆ ಬೋಧನೆಮಾಡುವಂತೆ ಬರೆದಿರುವ ಕಲ್ಲಿನ ಹಲಗೆಗಳನ್ನು ನಾನು ನಿನಗೆ ಕೊಡುತ್ತೇನೆ,” ಎಂದು ಹೇಳಿದರು.<verse eid="EXO 24:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="EXO 24:13"/>ಆಗ ಮೋಶೆಯೂ ಅವನ ಸಹಾಯಕನಾದ ಯೆಹೋಶುವನೂ ದೇವರ ಬೆಟ್ಟದ ಮೇಲೆ ಹೊರಟರು. <verse eid="EXO 24:13"/><verse number="14" style="v" sid="EXO 24:14"/>ಆಗ ಮೋಶೆ ಹಿರಿಯರಿಗೆ, “ನಾವು ನಿಮ್ಮ ಬಳಿಗೆ ತಿರುಗಿ ಬರುವವರೆಗೆ ಇಲ್ಲಿ ನಮಗಾಗಿ ಕಾದುಕೊಂಡಿರಿ. ಆರೋನನೂ ಹೂರನೂ ನಿಮ್ಮ ಸಂಗಡ ಇರುತ್ತಾರೆ. ಯಾರಿಗಾದರೂ ವ್ಯಾಜ್ಯವಿದ್ದರೆ ಅವರ ಬಳಿಗೆ ಹೋಗಲಿ,” ಎಂದನು.<verse eid="EXO 24:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="EXO 24:15"/>ಮೋಶೆ ಬೆಟ್ಟವನ್ನೇರಿ ಹೋದಾಗ ಮೇಘವು ಬೆಟ್ಟವನ್ನು ಮುಚ್ಚಿಕೊಂಡಿತು. <verse eid="EXO 24:15"/><verse number="16" style="v" sid="EXO 24:16"/>ಇದಲ್ಲದೆ ಯೆಹೋವ ದೇವರ ಮಹಿಮೆಯು ಸೀನಾಯಿ ಬೆಟ್ಟದ ಮೇಲೆ ನೆಲೆಯಾಗಿದ್ದುದರಿಂದ ಮೇಘವು ಅದನ್ನು ಆರು ದಿನಗಳವರೆಗೆ ಮುಚ್ಚಿಕೊಂಡಿತು. ಏಳನೆಯ ದಿನದಲ್ಲಿ ಆತನು ಮೇಘದೊಳಗಿಂದ ಮೋಶೆಯನ್ನು ಕರೆದರು. <verse eid="EXO 24:16"/><verse number="17" style="v" sid="EXO 24:17"/>ಯೆಹೋವ ದೇವರ ಮಹಿಮೆಯ ದೃಶ್ಯವು ಇಸ್ರಾಯೇಲರ ಕಣ್ಣುಗಳ ಮುಂದೆ ಬೆಟ್ಟದ ತುದಿಯಲ್ಲಿ ದಹಿಸುವ ಅಗ್ನಿಯಂತಿತ್ತು. <verse eid="EXO 24:17"/><verse number="18" style="v" sid="EXO 24:18"/>ಆಗ ಮೋಶೆಯು ಮೇಘದ ಮಧ್ಯಕ್ಕೆ ಬಂದು ಬೆಟ್ಟವನ್ನೇರಿದನು. ಅವನು ಹಗಲಿರುಳು ನಲವತ್ತು ದಿವಸ ಪರ್ವತದ ಮೇಲಿದ್ದನು.<verse eid="EXO 24:18"/></para>
  <chapter eid="EXO 24"/>
  <chapter number="25" style="c" sid="EXO 25"/>
  <para style="s1">ದೇವದರ್ಶನದ ಗುಡಾರಕ್ಕಾಗಿ ಕಾಣಿಕೆಗಳು</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 25:1"/>ಯೆಹೋವ ದೇವರು ಮೋಶೆಗೆ, <verse eid="EXO 25:1"/><verse number="2" style="v" sid="EXO 25:2"/>“ನನಗೆ ಕಾಣಿಕೆಗಳನ್ನು ತೆಗೆದುಕೊಂಡು ಬರುವಂತೆ ಇಸ್ರಾಯೇಲರ ಸಂಗಡ ಮಾತನಾಡು. ಯಾರ ಹೃದಯದಲ್ಲಿ ಕಾಣಿಕೆ ಕೊಡಬೇಕೆಂಬ ಪ್ರೇರಣೆ ಹುಟ್ಟುತ್ತದೋ, ಅಂಥವರ ಕಾಣಿಕೆಯನ್ನು ನೀನು ತೆಗೆದುಕೊಳ್ಳಬೇಕು.<verse eid="EXO 25:2"/></para>
  <para style="b"/>
  <para style="li4">
    <verse number="3" style="v" sid="EXO 25:3"/>“ನೀನು ಅವರಿಂದ ತೆಗೆದುಕೊಳ್ಳಬೇಕಾದ ಕಾಣಿಕೆಗಳು:</para>
  <para style="b" vid="EXO 25:3"/>
  <para style="li1" vid="EXO 25:3">“ಚಿನ್ನ, ಬೆಳ್ಳಿ, ಕಂಚು,<verse eid="EXO 25:3"/></para>
  <para style="li1">
    <verse number="4" style="v" sid="EXO 25:4"/>ನೀಲಿ, ಧೂಮ್ರ, ರಕ್ತವರ್ಣದಾರಗಳು, ನಾರುಬಟ್ಟೆಗಳು,</para>
  <para style="li1" vid="EXO 25:4">ಮೇಕೆಯ ಕೂದಲು,<verse eid="EXO 25:4"/></para>
  <para style="li1">
    <verse number="5" style="v" sid="EXO 25:5"/>ಕೆಂಪು ಬಣ್ಣದಲ್ಲಿ ಅದ್ದಿದ ಟಗರುಗಳ ಚರ್ಮಗಳು, ಕಡಲುಹಂದಿಯ ಚರ್ಮಗಳು,</para>
  <para style="li1" vid="EXO 25:5">ಜಾಲಿ ಮರದ ಕಟ್ಟಿಗೆ.<verse eid="EXO 25:5"/></para>
  <para style="li1">
    <verse number="6" style="v" sid="EXO 25:6"/>ದೀಪಕ್ಕಾಗಿ ಓಲಿವ್ ಎಣ್ಣೆ ಮತ್ತು</para>
  <para style="li1" vid="EXO 25:6">ಅಭಿಷೇಕಿಸುವ ಎಣ್ಣೆಗೋಸ್ಕರ ಪರಿಮಳ ಧೂಪಕ್ಕೋಸ್ಕರ ಸುಗಂಧ ದ್ರವ್ಯಗಳು,<verse eid="EXO 25:6"/></para>
  <para style="li1">
    <verse number="7" style="v" sid="EXO 25:7"/>ಏಫೋದ್<note caller="+" style="f"><char style="fr" closed="false">25:7 </char><char style="fq" closed="false">ಏಫೋದ್ </char><char style="ft" closed="false">ಅಂದರೆ </char><char style="fqa" closed="false">ಮಹಾಯಾಜಕನ ಉಡುಗೆ</char></note> ಕವಚಕ್ಕಾಗಿ ಗೋಮೇಧಿಕಗಳು ಮತ್ತು ಎದೆಪದಕದಲ್ಲಿ ಹಚ್ಚಬೇಕಾದ ನಾನಾ ರತ್ನಗಳು ಇವೆ.<verse eid="EXO 25:7"/></para>
  <para style="b"/>
  <para style="p">
    <verse number="8" style="v" sid="EXO 25:8"/>“ನಾನು ಅವರ ಮಧ್ಯದಲ್ಲಿ ವಾಸಿಸುವ ಹಾಗೆ ಅವರು ನನಗೆ ಒಂದು ಪರಿಶುದ್ಧ ಆಲಯವನ್ನು ಕಟ್ಟಬೇಕು. <verse eid="EXO 25:8"/><verse number="9" style="v" sid="EXO 25:9"/>ಗುಡಾರದ ಮಾದರಿಯನ್ನೂ, ಅದರ ಎಲ್ಲಾ ಸಲಕರಣೆಗಳ ಮಾದರಿಯನ್ನೂ ನಾನು ನಿನಗೆ ತೋರಿಸುವಂತೆಯೇ ನೀನು ಮಾಡಬೇಕು.<verse eid="EXO 25:9"/></para>
  <para style="s1">ಮಂಜೂಷ</para>
  <para style="p">
    <verse number="10" style="v" sid="EXO 25:10"/>“ಜಾಲಿ ಮರದಿಂದ ಸುಮಾರು ಒಂದು ಮೀಟರ್ ಉದ್ದ ಮತ್ತು ಅರವತ್ತೆಂಟು ಸೆಂಟಿಮೀಟರ್ ಅಗಲ ಮತ್ತು ಅರವತ್ತೆಂಟು ಸೆಂಟಿಮೀಟರ್ ಎತ್ತರವಾಗಿರುವ<note caller="+" style="f"><char style="fr" closed="false">25:10 </char><char style="ft" closed="false">ಸುಮಾರು ಎರಡೂವರೆ ಮೊಳ ಉದ್ದ, ಒಂದೂವರೆ ಮೊಳ ಅಗಲ ಮತ್ತು ಎತ್ತರ</char></note> ಮಂಜೂಷವನ್ನು ಮಾಡಬೇಕು. <verse eid="EXO 25:10"/><verse number="11" style="v" sid="EXO 25:11"/>ಅದನ್ನು ಶುದ್ಧ ಬಂಗಾರದಿಂದ ಒಳಗೂ ಹೊರಗೂ ಹೊದಿಸಬೇಕು. ಅದರ ಸುತ್ತಲೂ ಬಂಗಾರದ ತೋರಣವನ್ನು ಮಾಡಿಸಬೇಕು. <verse eid="EXO 25:11"/><verse number="12" style="v" sid="EXO 25:12"/>ಅದಕ್ಕೆ ನಾಲ್ಕು ಬಂಗಾರದ ಬಳೆಗಳನ್ನು ಎರಕಹೊಯಿಸಿ ಅದರ ನಾಲ್ಕು ಮೂಲೆಗಳಲ್ಲಿ ಎಂದರೆ ಒಂದು ಕಡೆಯಲ್ಲಿ ಎರಡು ಬಳೆಗಳನ್ನು ಮತ್ತೊಂದು ಕಡೆಯಲ್ಲಿ ಎರಡು ಬಳೆಗಳನ್ನು ಇಡಬೇಕು. <verse eid="EXO 25:12"/><verse number="13" style="v" sid="EXO 25:13"/>ಆಮೇಲೆ ಜಾಲಿ ಮರದ ಕೋಲುಗಳನ್ನು ಮಾಡಿಸಿ, ಅವುಗಳಿಗೆ ಬಂಗಾರದಿಂದ ಹೊದಿಸಬೇಕು. <verse eid="EXO 25:13"/><verse number="14" style="v" sid="EXO 25:14"/>ಮಂಜೂಷವನ್ನು ಹೊರುವುದಕ್ಕಾಗಿ ಕೋಲುಗಳನ್ನು ಮಂಜೂಷದ ಎರಡು ಕಡೆಗಳಲ್ಲಿರುವ ಬಳೆಗಳಲ್ಲಿ ಸೇರಿಸಬೇಕು. <verse eid="EXO 25:14"/><verse number="15" style="v" sid="EXO 25:15"/>ಮಂಜೂಷದ ಬಳೆಗಳಲ್ಲಿಯೇ ಕೋಲುಗಳನ್ನು ಇಡಬೇಕು. ಅವುಗಳೊಳಗಿಂದ ಕೋಲುಗಳನ್ನು ತೆಗೆಯಬಾರದು. <verse eid="EXO 25:15"/><verse number="16" style="v" sid="EXO 25:16"/>ಮಂಜೂಷದಲ್ಲಿ ನಾನು ನಿನಗೆ ಕೊಡುವ ಒಡಂಬಡಿಕೆಯ ಶಾಸನದ ಹಲಗೆಯನ್ನು ಇಡಬೇಕು.<verse eid="EXO 25:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="EXO 25:17"/>“ಸುಮಾರು ನೂರಹತ್ತು ಸೆಂಟಿಮೀಟರ್ ಉದ್ದವೂ ಎಪ್ಪತ್ತು ಸೆಂಟಿಮೀಟರ್ ಅಗಲವೂ ಇರುವ ಕರುಣಾಸನವನ್ನು<note caller="+" style="f"><char style="fr" closed="false">25:17 </char><char style="fq" closed="false">ಕರುಣಾಸನ </char><char style="ft" closed="false">ಹೀಬ್ರೂ ಭಾಷೆಯಲ್ಲಿ ಪ್ರಾಯಶ್ಚಿತ್ತದ ಮುಚ್ಚಳ </char><char style="fqa" closed="false">ಪಾಪ ನಿವಾರಣ ಸ್ಥಳ</char></note> ಶುದ್ಧ ಬಂಗಾರದಿಂದ ಮಾಡಬೇಕು. <verse eid="EXO 25:17"/><verse number="18" style="v" sid="EXO 25:18"/>ಕರುಣಾಸನದ ಎರಡು ತುದಿಗಳಲ್ಲಿ ಎರಡು ಬಂಗಾರದಿಂದ ಕೆರೂಬಿಗಳನ್ನು ನಕಾಸಿ ಕೆಲಸದಿಂದ ಮಾಡಿಸಬೇಕು. <verse eid="EXO 25:18"/><verse number="19" style="v" sid="EXO 25:19"/>ಒಂದು ಬದಿಯ ಕೊನೆಯಲ್ಲಿ ಒಂದು ಕೆರೂಬಿಯನ್ನೂ<note caller="+" style="f"><char style="fr" closed="false">25:19 </char><char style="fq" closed="false">ಕೆರೂಬ </char><char style="ft" closed="false">ಅನ್ನು ಸಾಮಾನ್ಯವಾಗಿ </char><char style="fqa" closed="false">ದೇವದೂತ </char><char style="ft" closed="false">ಎಂದು ಪರಿಗಣಿಸಲಾಗುತ್ತದೆ. ಆದರೆ ಇದು ಯಾವ ರೀತಿಯದ್ದು ಎಂದು ನಿಖರವಾಗಿ ಹೇಳಲಾಗದು. ಈ ಜೀವಿಯು ರೆಕ್ಕೆಗಳನ್ನು, ಪ್ರಾಣಿ ಮತ್ತು ಮನುಷ್ಯನ ದೈಹಿಕ ರೂಪವನ್ನು ಹೊಂದಿದೆ</char></note> ಇನ್ನೊಂದು ಬದಿಯ ಕೊನೆಯಲ್ಲಿ ಒಂದು ಕೆರೂಬಿಯನ್ನೂ ಮಾಡಿಸಬೇಕು. ಹೀಗೆ ಕರುಣಾಸನದ ಎರಡೂ ಬದಿಗಳಲ್ಲಿ ಕೆರೂಬಿಯನ್ನು ಮಾಡಿಸಬೇಕು. <verse eid="EXO 25:19"/><verse number="20" style="v" sid="EXO 25:20"/>ಆ ಕೆರೂಬಿಗಳು ತಮ್ಮ ರೆಕ್ಕೆಗಳನ್ನು ಮೇಲಕ್ಕೆ ಚಾಚಿರುವಂತೆಯೂ ಕರುಣಾಸನವನ್ನು ತಮ್ಮ ರೆಕ್ಕೆಗಳಿಂದ ಮುಚ್ಚುವಂತೆಯೂ ಕೆರೂಬಿಗಳ ಮುಖಗಳು ಎದುರುಬದುರಾಗಿ ಕರುಣಾಸನವನ್ನು ನೋಡುತ್ತಿರಬೇಕು. <verse eid="EXO 25:20"/><verse number="21" style="v" sid="EXO 25:21"/>ಕರುಣಾಸನವನ್ನು ಮಂಜೂಷದ ಮೇಲಿಡಬೇಕು ಮತ್ತು ಮಂಜೂಷದಲ್ಲಿ ನಾನು ನಿನಗೆ ಕೊಡುವ ಒಡಂಬಡಿಕೆಯ ಶಾಸನಗಳನ್ನು ಇಡಬೇಕು. <verse eid="EXO 25:21"/><verse number="22" style="v" sid="EXO 25:22"/>ನಾನು ಅಲ್ಲಿ ನಿನಗೆ ದರ್ಶನವನ್ನು ಕೊಟ್ಟು, ಕರುಣಾಸನದ ಮೇಲೆ ಒಡಂಬಡಿಕೆಯ ಮಂಜೂಷದ<note caller="+" style="f"><char style="fr" closed="false">25:22 </char><char style="fq" closed="false">ಒಡಂಬಡಿಕೆಯ ಮಂಜೂಷ </char><char style="ft" closed="false">ಅಂದರೆ </char><char style="fqa" closed="false">ಆಜ್ಞಾಶಾಸನಗಳನ್ನಿಟ್ಟಿರುವ ಪೆಟ್ಟಿಗೆ</char></note> ಮೇಲಿರುವ ಎರಡು ಕೆರೂಬಿಗಳ ಮಧ್ಯದಿಂದ ಇಸ್ರಾಯೇಲರ ವಿಷಯದಲ್ಲಿ ನಾನು ನಿನಗೆ ಆಜ್ಞಾಪಿಸುವವುಗಳನ್ನೆಲ್ಲಾ ನಿನಗೆ ತಿಳಿಸುವೆನು.<verse eid="EXO 25:22"/></para>
  <para style="s1">ರೊಟ್ಟಿಗಾಗಿ ಮೇಜು</para>
  <para style="p">
    <verse number="23" style="v" sid="EXO 25:23"/>“ಸುಮಾರು ತೊಂಬತ್ತು ಸೆಂಟಿಮೀಟರ್ ಉದ್ದ, ನಲವತ್ತೈದು ಸೆಂಟಿಮೀಟರ್ ಅಗಲ ಮತ್ತು ಅರವತ್ತೆಂಟು ಸೆಂಟಿಮೀಟರ್ ಎತ್ತರ<note caller="+" style="f"><char style="fr" closed="false">25:23 </char><char style="ft" closed="false">ಸುಮಾರು ಎರಡು ಮೊಳ ಉದ್ದ, ಒಂದು ಮೊಳ ಅಗಲ, ಒಂದೂವರೆ ಮೊಳ ಎತ್ತರ</char></note> ಇರುವ ಮೇಜನ್ನು ಜಾಲಿ ಮರದಿಂದ ಮಾಡಬೇಕು. <verse eid="EXO 25:23"/><verse number="24" style="v" sid="EXO 25:24"/>ಶುದ್ಧ ಬಂಗಾರದಿಂದ ಮೇಜನ್ನು ಹೊದಿಸಿ, ಅದರ ಸುತ್ತಲೂ ಬಂಗಾರದ ತೋರಣವನ್ನು ಮಾಡಬೇಕು. <verse eid="EXO 25:24"/><verse number="25" style="v" sid="EXO 25:25"/>ಮೇಜಿನ ಸುತ್ತಲೂ ಅಂಗೈ ಅಗಲದ<note caller="+" style="f"><char style="fr" closed="false">25:25 </char><char style="ft" closed="false">ಸುಮಾರು 7.5 ಸೆಂಟಿಮೀಟರ್</char></note> ಅಡ್ಡಪಟ್ಟಿಯನ್ನು ಮಾಡಿಸಿ, ಅಂಚಿನ ಸುತ್ತಲೂ ಬಂಗಾರದ ತೋರಣವನ್ನು ಮಾಡಬೇಕು. <verse eid="EXO 25:25"/><verse number="26" style="v" sid="EXO 25:26"/>ಇದಲ್ಲದೆ ಆ ಮೇಜಿಗೆ ಬಂಗಾರದ ನಾಲ್ಕು ಬಳೆಗಳನ್ನು ಮಾಡಿ, ಅವುಗಳನ್ನು ಅದರ ನಾಲ್ಕು ಕಾಲುಗಳಲ್ಲಿರುವ ನಾಲ್ಕು ಮೂಲೆಗಳಿಗೆ ಜೋಡಿಸಬೇಕು. <verse eid="EXO 25:26"/><verse number="27" style="v" sid="EXO 25:27"/>ಅಂಚಿಗೆ ಸಮೀಪವಾಗಿ ಮೇಜನ್ನು ಹೊತ್ತುಕೊಂಡು ಹೋಗಲು ಇರುವ ಕೋಲುಗಳಿಗೆ ಬಳೆಗಳು ಇರಬೇಕು. <verse eid="EXO 25:27"/><verse number="28" style="v" sid="EXO 25:28"/>ಮೇಜನ್ನು ಹೊರುವುದಕ್ಕಾಗಿ ಕೋಲುಗಳನ್ನು, ತೋರಣವನ್ನು ಜಾಲಿ ಮರದಿಂದ ಮಾಡಿ, ಬಂಗಾರದಿಂದ ಹೊದಿಸಬೇಕು. <verse eid="EXO 25:28"/><verse number="29" style="v" sid="EXO 25:29"/>ಇದಲ್ಲದೆ ನೀನು ಪಾತ್ರೆಗಳನ್ನು, ಧೂಪಾರತಿಗಳನ್ನು, ಮುಚ್ಚಳಗಳನ್ನು ಪಾನಾರ್ಪಣೆಗೆ ಹೂಜೆಗಳನ್ನೂ ಬೇಕಾದ ಬಟ್ಟಲುಗಳನ್ನೂ, ಶುದ್ಧ ಬಂಗಾರದಿಂದ ಮಾಡಬೇಕು. <verse eid="EXO 25:29"/><verse number="30" style="v" sid="EXO 25:30"/>ಮೇಜಿನ ಮೇಲೆ ನೈವೇದ್ಯದ ರೊಟ್ಟಿಯನ್ನು ಯಾವಾಗಲೂ ನನ್ನ ಮುಂದೆ ಇಡಬೇಕು.<verse eid="EXO 25:30"/></para>
  <para style="s1">ಬಂಗಾರದ ದೀಪಸ್ತಂಭ</para>
  <para style="p">
    <verse number="31" style="v" sid="EXO 25:31"/>“ಶುದ್ಧ ಬಂಗಾರದಿಂದ ದೀಪಸ್ತಂಭವನ್ನು ಮಾಡಬೇಕು. ಅದರ ಬುಡವನ್ನೂ ಕಂಬವನ್ನೂ ನಕಾಸಿ ಕೆಲಸದಿಂದ ಮಾಡಬೇಕು. ದೀಪಸ್ತಂಭದ ಬುಡದಿಂದಲೇ ಅಖಂಡವಾಗಿ ಪುಷ್ಪದ ಗೊಂಚಲುಗಳಂತೆಯೂ ಹಣತೆಗಳಂತೆಯೂ ಮೊಗ್ಗುಗಳಂತೆಯೂ ಇರಬೇಕು. <verse eid="EXO 25:31"/><verse number="32" style="v" sid="EXO 25:32"/>ದೀಪಸ್ತಂಭದಿಂದ ಆರು ಕೊಂಬೆಗಳು ಹೊರ ಬಂದಿರಬೇಕು. ಅಂದರೆ ಒಂದು ಭಾಗದಿಂದ ಮೂರು ಕೊಂಬೆಗಳೂ ಮತ್ತೊಂದು ಭಾಗದಿಂದ ಮೂರು ಕೊಂಬೆಗಳೂ ಹೊರಗೆ ಬರಬೇಕು. <verse eid="EXO 25:32"/><verse number="33" style="v" sid="EXO 25:33"/>ಒಂದು ಕೊಂಬೆಯಲ್ಲಿ ಬಾದಾಮಿ ಪುಷ್ಟದಂತಿರುವ ಮೂರು ಹಣತೆಗಳು, ಮೊಗ್ಗು ಪುಷ್ಟಗಳಿರಬೇಕು ಮತ್ತು ಮತ್ತೊಂದು ಕೊಂಬೆಯಲ್ಲಿ ಬಾದಾಮಿಯ ಪುಷ್ಟವಿದ್ದ ಮೂರು ಹಣತೆಗಳು, ಮೊಗ್ಗು ಪುಷ್ಟಗಳಿರಬೇಕು. ಈ ಪ್ರಕಾರ ದೀಪಸ್ತಂಭದಿಂದ ಹೊರಗೆ ಬರುವ ಆರು ಕೊಂಬೆಗಳಲ್ಲಿಯೂ ಇರಬೇಕು. <verse eid="EXO 25:33"/><verse number="34" style="v" sid="EXO 25:34"/>ದೀಪಸ್ತಂಭದಲ್ಲಿಯೇ ಬಾದಾಮಿ ಹೂವುಗಳಂತೆಯೂ ಮೊಗ್ಗುಗಳಂತೆಯೂ ಅದಕ್ಕೊಂದು ಪುಷ್ಪದ ಆಕಾರದಲ್ಲಿ ನಾಲ್ಕು ಹಣತೆಗಳು ಇರಬೇಕು. <verse eid="EXO 25:34"/><verse number="35" style="v" sid="EXO 25:35"/>ದೀಪಸ್ತಂಭದಿಂದ ಹೊರಬರುವ ಒಂದು ಮೊಗ್ಗು ಮೊದಲ ಜೋಡಿ ಕೊಂಬೆಗಳ ಅಡಿಯಲ್ಲಿರಬೇಕು. ಎರಡನೇ ಮೊಗ್ಗು ಎರಡನೇ ಜೋಡಿಯ ಅಡಿಯಲ್ಲಿ ಮತ್ತು ಮೂರನೆಯ ಮೊಗ್ಗು ಮೂರನೆಯ ಜೋಡಿಯ ಅಡಿಯಲ್ಲಿ ಹೀಗೆ ಆರು ಕೊಂಬೆಗಳು ಇರಬೇಕು. <verse eid="EXO 25:35"/><verse number="36" style="v" sid="EXO 25:36"/>ಅದರ ಮೊಗ್ಗುಗಳೂ ಕೊಂಬೆಗಳೂ ಅದರಿಂದಲೇ ಬಂದಿರಬೇಕು. ದೀಪಸ್ತಂಭವನ್ನೆಲ್ಲಾ ಶುದ್ಧ ಬಂಗಾರದ ಒಂದೇ ಅಚ್ಚಿನಲ್ಲಿ ಬರೆದ ಕಲಾಕೃತಿಯಾಗಿರಬೇಕು.<verse eid="EXO 25:36"/></para>
  <para style="p">
    <verse number="37" style="v" sid="EXO 25:37"/>“ಅದರ ಏಳು ದೀಪಗಳನ್ನು ಮಾಡಿ ಅವು ಮುಂದುಗಡೆಯಲ್ಲಿ ಪ್ರಕಾಶಕೊಡುವಂತೆ ಅವುಗಳನ್ನು ಹೊತ್ತಿಸಬೇಕು. <verse eid="EXO 25:37"/><verse number="38" style="v" sid="EXO 25:38"/>ಇದಲ್ಲದೆ ಅದರ ಕುಡಿ ಕತ್ತರಿಸುವ ಕತ್ತರಿಗಳನ್ನೂ ಬೂದಿಯ ಪಾತ್ರೆಗಳನ್ನೂ ಶುದ್ಧ ಬಂಗಾರದಿಂದಲೇ ಮಾಡಬೇಕು. <verse eid="EXO 25:38"/><verse number="39" style="v" sid="EXO 25:39"/>ದೀಪಸ್ತಂಭವನ್ನೂ ಅದರ ಎಲ್ಲಾ ಸಲಕರಣೆಗಳನ್ನೂ ಒಂದು ತಲಾಂತು<note caller="+" style="f"><char style="fr" closed="false">25:39 </char><char style="ft" closed="false">ಸುಮಾರು 34 ಕಿಲೋಗ್ರಾಂಗಳಷ್ಟು</char></note> ಶುದ್ಧ ಬಂಗಾರದಿಂದ ಮಾಡಬೇಕು. <verse eid="EXO 25:39"/><verse number="40" style="v" sid="EXO 25:40"/>ಬೆಟ್ಟದಲ್ಲಿ ನಿನಗೆ ತೋರಿಸಿದ ಮಾದರಿಯ ಪ್ರಕಾರವೇ ಅವುಗಳನ್ನು ಮಾಡುವಂತೆ ನೋಡಿಕೋ.<verse eid="EXO 25:40"/></para>
  <chapter eid="EXO 25"/>
  <chapter number="26" style="c" sid="EXO 26"/>
  <para style="s1">ದೇವದರ್ಶನದ ಗುಡಾರ</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 26:1"/>“ಗುಡಾರವನ್ನು ಹತ್ತು ಪರದೆಗಳಿಂದ ಮಾಡಿ, ನಯವಾಗಿ ಹೊಸೆದ ನಾರಿನಿಂದಲೂ ನೀಲಿ, ಧೂಮ್ರ, ರಕ್ತವರ್ಣದ ದಾರದಿಂದ ಮತ್ತು ಕೌಶಲ್ಯದ ಕೆಲಸದಿಂದಲೂ ಮಾಡಿದ ಕೆರೂಬಿಗಳುಳ್ಳವುಗಳಾಗಿಯೂ ಇರಬೇಕು. <verse eid="EXO 26:1"/><verse number="2" style="v" sid="EXO 26:2"/>ಎಲ್ಲಾ ಪರದೆಗಳೂ ಒಂದೇ ಅಳತೆಯವುಗಳಾಗಿರಬೇಕು. ಪ್ರತಿಯೊಂದು ಪರದೆಯು ಸುಮಾರು ಹದಿಮೂರು ಮೀಟರ್ ಉದ್ದ ಮತ್ತು ಎರಡು ಮೀಟರ್ ಅಗಲವಿರಬೇಕು.<note caller="+" style="f"><char style="fr" closed="false">26:2 </char><char style="ft" closed="false">ಸುಮಾರು ಇಪ್ಪತ್ತೆಂಟು ಮೊಳ ಉದ್ದ ಮತ್ತು ಅದರ ಅಗಲವು ನಾಲ್ಕು ಮೊಳವಾಗಿರಬೇಕು</char></note> <verse eid="EXO 26:2"/><verse number="3" style="v" sid="EXO 26:3"/>ಐದು ಪರದೆಗಳನ್ನು ಒಂದಕ್ಕೊಂದು ಜೋಡಿಸಬೇಕು ಮತ್ತು ಇನ್ನುಳಿದ ಐದು ಪರದೆಗಳನ್ನೂ ಒಂದಕ್ಕೊಂದು ಜೋಡಿಸಬೇಕು. <verse eid="EXO 26:3"/><verse number="4" style="v" sid="EXO 26:4"/>ಕೊನೆಯ ಪರದೆಯ ಅಂಚಿನ ಒಂದು ಜೋಡಣೆಯ ಸ್ಥಳದಲ್ಲಿ ನೀಲಿ ದಾರಿನ ಕುಣಿಕೆಗಳನ್ನು ಮಾಡಿ, ಎರಡನೆಯ ಜೋಡಣೆಯ ಕಟ್ಟಕಡೆಯ ಪರದೆಯ ಅಂಚಿನಲ್ಲಿಯೂ ಅದೇ ಪ್ರಕಾರ ಮಾಡಬೇಕು. <verse eid="EXO 26:4"/><verse number="5" style="v" sid="EXO 26:5"/>ಒಂದು ಪರದೆಯನ್ನು ಜೋಡಿಸುವ ಸ್ಥಳದಲ್ಲಿ ಇರುವ ಇನ್ನೊಂದು ಪರದೆಯ ಕೊನೆಯಲ್ಲಿ ಐವತ್ತು ಕುಣಿಕೆಗಳನ್ನು ಮಾಡಬೇಕು. ಆ ಕುಣಿಕೆಗಳು ಒಂದಕ್ಕೊಂದು ಎದುರುಬದುರಾಗಿ ಹಿಡಿದುಕೊಳ್ಳುವವುಗಳಾಗಿರಬೇಕು. <verse eid="EXO 26:5"/><verse number="6" style="v" sid="EXO 26:6"/>ಬಂಗಾರದ ಐವತ್ತು ಕೊಂಡಿಗಳನ್ನು ಮಾಡಿ, ಅವುಗಳಿಂದ ಪರದೆಗಳನ್ನು ಒಂದಕ್ಕೊಂದು ಜೋಡಿಸಬೇಕು. ಹೀಗೆ ಅದು ಒಂದೇ ಗುಡಾರವಾಗಬೇಕು.<verse eid="EXO 26:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="EXO 26:7"/>“ಇದಲ್ಲದೆ ನೀನು ಗುಡಾರದ ಮೇಲೆ ಹೊದಿಸುವುದಕ್ಕಾಗಿ ಮೇಕೆಯ ಕೂದಲಿನಿಂದ ಹನ್ನೊಂದು ಪರದೆಗಳನ್ನು ಮಾಡಬೇಕು. <verse eid="EXO 26:7"/><verse number="8" style="v" sid="EXO 26:8"/>ಒಂದೊಂದು ಪರದೆಯು ಸುಮಾರು ಹದಿಮೂರುವರೆ ಮೀಟರ್ ಉದ್ದ ಮತ್ತು ಒಂದುವರೆ ಮೀಟರ್ ಅಗಲ<note caller="+" style="f"><char style="fr" closed="false">26:8 </char><char style="ft" closed="false">ಸುಮಾರು ಮೂವತ್ತು ಮೊಳ ಉದ್ದ ಮತ್ತು ನಾಲ್ಕು ಮೊಳ ಅಗಲ</char></note> ಇರಬೇಕು. ಹನ್ನೊಂದು ಪರದೆಗಳೂ ಒಂದೇ ಅಳತೆಯಾಗಿರಬೇಕು. <verse eid="EXO 26:8"/><verse number="9" style="v" sid="EXO 26:9"/>ಐದು ಪರದೆಗಳನ್ನು ಒಂದಾಗಿ ಜೋಡಿಸಿ ಇನ್ನುಳಿದ ಆರು ಪರದೆಗಳನ್ನು ಒಂದಾಗಿ ಜೋಡಿಸಿ, ಆರನೆಯ ಪರದೆಯನ್ನು ಗುಡಾರದ ಮುಂಭಾಗದಲ್ಲಿ ಮಡಿಸಿ ತೂಗಾಡಬಿಡಬೇಕು. <verse eid="EXO 26:9"/><verse number="10" style="v" sid="EXO 26:10"/>ಜೋಡಿಸುವಾಗ ಕೊನೆಯ ಒಂದು ಪರದೆಯ ಅಂಚಿನಲ್ಲಿ ಐವತ್ತು ಕುಣಿಕೆಗಳನ್ನು, ಜೋಡಣೆಯಲ್ಲಿರುವ ಕೊನೆಯ ಎರಡನೆಯ ಪರದೆಯ ಅಂಚಿನಲ್ಲಿ ಐವತ್ತು ಕುಣಿಕೆಗಳನ್ನು ಮಾಡಬೇಕು. <verse eid="EXO 26:10"/><verse number="11" style="v" sid="EXO 26:11"/>ಇದಲ್ಲದೆ ಕಂಚಿನ ಐವತ್ತು ಕೊಂಡಿಗಳನ್ನು ಮಾಡಿ, ಕೊಂಡಿಗಳನ್ನು ಕುಣಿಕೆಗಳಲ್ಲಿ ಸಿಕ್ಕಿಸಿ, ಒಂದೇ ಡೇರೆ ಆಗುವಂತೆ ಜೋಡಿಸಬೇಕು. <verse eid="EXO 26:11"/><verse number="12" style="v" sid="EXO 26:12"/>ಗುಡಾರದ ಪರದೆಗಳನ್ನು ಮಿಕ್ಕಿದ ತೂಗಾಡುವಂಥದ್ದು ಎಂದರೆ ಉಳಿದ ಅರ್ಧ ಪರದೆಯು ಗುಡಾರದ ಹಿಂಭಾಗದಲ್ಲಿ ತೂಗಾಡಲಿ. <verse eid="EXO 26:12"/><verse number="13" style="v" sid="EXO 26:13"/>ಗುಡಾರದ ಪರದೆಗಳ ಉದ್ದದಲ್ಲಿ ಈಚೆ ಆಚೆ ಮಿಕ್ಕಿದ ಮೊಳವು ಗುಡಾರದ ಈಚೆ ಆಚೆಯಲ್ಲಿ ಅದನ್ನು ಮುಚ್ಚುವುದಕ್ಕಾಗಿ ತೂಗಾಡಲಿ. <verse eid="EXO 26:13"/><verse number="14" style="v" sid="EXO 26:14"/>ಗುಡಾರದ ಮೇಲ್ಹೊದಿಕೆಯನ್ನು ಕೆಂಪು ಬಣ್ಣದಲ್ಲಿ ಅದ್ದಿ ತೆಗೆದ ಟಗರುಗಳ ಚರ್ಮದಿಂದ ಮಾಡಬೇಕು, ಅದರ ಮೇಲೆ ಕಡಲುಹಂದಿಯ ಚರ್ಮದ ಮೇಲ್ಹೊದಿಕೆಯನ್ನು ಮಾಡಬೇಕು.<verse eid="EXO 26:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="EXO 26:15"/>“ಗುಡಾರಕ್ಕೆ ಜಾಲಿ ಮರದಿಂದ ಚೌಕಟ್ಟುಗಳನ್ನು ಮಾಡಬೇಕು. <verse eid="EXO 26:15"/><verse number="16" style="v" sid="EXO 26:16"/>ಒಂದೊಂದು ಚೌಕಟ್ಟಿನ ಉದ್ದವು ಸುಮಾರು ನಾಲ್ಕುವರೆ ಮೀಟರ್ ಮತ್ತು ಅಗಲ ಅರವತ್ತೆಂಟು ಸೆಂಟಿಮೀಟರ್<note caller="+" style="f"><char style="fr" closed="false">26:16 </char><char style="ft" closed="false">ಸುಮಾರು ಹತ್ತು ಮೊಳ ಉದ್ದ ಮತ್ತು ಒಂದೂವರೆ ಮೊಳ ಅಗಲ</char></note> ಇರಬೇಕು. <verse eid="EXO 26:16"/><verse number="17" style="v" sid="EXO 26:17"/>ಒಂದು ಚೌಕಟ್ಟಿಗೆ ಒಂದಕ್ಕೊಂದು ಸರಿಯಾದ ಅಂತರದಲ್ಲಿ ಎರಡು ಕೈಗಳನ್ನು ಮಾಡಬೇಕು. ಅದೇ ಪ್ರಕಾರ ಗುಡಾರದ ಎಲ್ಲಾ ಚೌಕಟ್ಟುಗಳಿಗೆ ಮಾಡಬೇಕು. <verse eid="EXO 26:17"/><verse number="18" style="v" sid="EXO 26:18"/>ಗುಡಾರದ ದಕ್ಷಿಣ ಭಾಗದಲ್ಲಿ ಇಪ್ಪತ್ತು ಚೌಕಟ್ಟುಗಳನ್ನು ಮಾಡಬೇಕು. <verse eid="EXO 26:18"/><verse number="19" style="v" sid="EXO 26:19"/>ಇಪ್ಪತ್ತು ಚೌಕಟ್ಟುಗಳ ಕೆಳಗೆ ನಾಲ್ವತ್ತು ಬೆಳ್ಳಿಯ ಗದ್ದಿಗೇ ಕಲ್ಲುಗಳನ್ನು ಮಾಡಬೇಕು ಮತ್ತು ಒಂದೊಂದು ಚೌಕಟ್ಟಿನ ಕೆಳಗೆ ಅದರ ಎರಡು ಪಟ್ಟಿಗಳಿಗಾಗಿ ಎರಡೆರಡು ಕುಳಿಗಳನ್ನು ಮಾಡಬೇಕು. <verse eid="EXO 26:19"/><verse number="20" style="v" sid="EXO 26:20"/>ಹಾಗೆಯೇ ಗುಡಾರದ ಉತ್ತರ ದಿಕ್ಕಿನಲ್ಲಿ ಇಪ್ಪತ್ತು ಚೌಕಟ್ಟುಗಳನ್ನೂ, <verse eid="EXO 26:20"/><verse number="21" style="v" sid="EXO 26:21"/>ಮತ್ತು ಒಂದೊಂದು ಚೌಕಟ್ಟಿನ ಕೆಳಗೆ ಎರಡೆರಡು ಗದ್ದಿಗೇ ಕಲ್ಲುಗಳಂತೆ ನಲವತ್ತು ಬೆಳ್ಳಿಯ ಗದ್ದಿಗೇ ಕಲ್ಲುಗಳನ್ನೂ, <verse eid="EXO 26:21"/><verse number="22" style="v" sid="EXO 26:22"/>ಗುಡಾರದ ಹಿಂಭಾಗಕ್ಕೆ ಅಂದರೆ ಪಶ್ಚಿಮದ ಕಡೆಗೆ ಆರು ಚೌಕಟ್ಟುಗಳನ್ನು ಮಾಡಬೇಕು. <verse eid="EXO 26:22"/><verse number="23" style="v" sid="EXO 26:23"/>ಗುಡಾರದ ಹಿಂಭಾಗದ ಎರಡು ಮೂಲೆಗಳಿಗೆ ಬೇರೆ ಎರಡು ಚೌಕಟ್ಟುಗಳನ್ನು ಮಾಡಬೇಕು. <verse eid="EXO 26:23"/><verse number="24" style="v" sid="EXO 26:24"/>ಈ ಮೂಲೆಗಳನ್ನು ಅಡಿಯಲ್ಲಿ ಜೋಡಿಸಿರಬೇಕು. ಮೇಲ್ಭಾಗದಲ್ಲಿಯೂ ಒಂದೇ ಬಳೆಗೆ ಜೋಡಿಸಿರಬೇಕು. ಇದೇ ರೀತಿಯಲ್ಲಿ ಅವು ಎರಡು ಮೂಲೆಗಳಲ್ಲಿ ಎರಡಕ್ಕೂ ಇರಬೇಕು. <verse eid="EXO 26:24"/><verse number="25" style="v" sid="EXO 26:25"/>ಹೀಗೆ ಅವು ಎಂಟು ಚೌಕಟ್ಟುಗಳೂ ಒಂದೊಂದು ಚೌಕಟ್ಟಿನ ಕೆಳಗೆ ಎರಡೆರಡು ಕೂರುಗದ್ದಿಗೇ ಕಲ್ಲುಗಳೂ ಇರುವುದರಿಂದ ಅವುಗಳಿಗೆ ಹದಿನಾರು ಬೆಳ್ಳಿಯ ಕೂರುಗದ್ದಿಗೇ ಕಲ್ಲುಗಳೂ ಇರಬೇಕು.<verse eid="EXO 26:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="EXO 26:26"/>“ಜಾಲಿ ಮರದಿಂದ ಅಗುಳಿಗಳನ್ನು ಮಾಡಬೇಕು. ಗುಡಾರದ ಒಂದು ಕಡೆಯ ಚೌಕಟ್ಟುಗಳಿಗೆ ಐದು ಅಗುಳಿಗಳನ್ನು, <verse eid="EXO 26:26"/><verse number="27" style="v" sid="EXO 26:27"/>ಗುಡಾರದ ಇನ್ನೊಂದು ಭಾಗದ ಚೌಕಟ್ಟುಗಳಿಗೆ ಐದು ಅಗುಳಿಗಳನ್ನು, ಅದರ ಹಿಂದುಗಡೆಯ ಅಂದರೆ ಪಶ್ಚಿಮ ಭಾಗದಲ್ಲಿರುವ ಚೌಕಟ್ಟುಗಳಿಗೆ ಐದು ಅಗುಳಿಗಳನ್ನು ಮಾಡಬೇಕು. <verse eid="EXO 26:27"/><verse number="28" style="v" sid="EXO 26:28"/>ಮಧ್ಯದ ಅಗುಳಿಯು ಚೌಕಟ್ಟುಗಳ ನಡುವೆ ಒಂದು ಕಡೆಯಿಂದ ಮತ್ತೊಂದು ಕಡೆಯವರೆಗೆ ಮುಟ್ಟಿರಬೇಕು. <verse eid="EXO 26:28"/><verse number="29" style="v" sid="EXO 26:29"/>ಆ ಚೌಕಟ್ಟುಗಳನ್ನು ಬಂಗಾರದಿಂದ ಹೊದಿಸಬೇಕು. ಅವುಗಳಿಗೆ ಬಂಗಾರದಿಂದ ಬಳೆಗಳನ್ನು ಮಾಡಬೇಕು. ಅಗುಳಿಗಳನ್ನು ಬಂಗಾರದಿಂದ ಹೊದಿಸಬೇಕು.<verse eid="EXO 26:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="EXO 26:30"/>“ಹೀಗೆ ಬೆಟ್ಟದ ಮೇಲೆ ನಾನು ನಿನಗೆ ತೋರಿಸಿದ ಕ್ರಮದ ಪ್ರಕಾರ ಗುಡಾರವನ್ನು ನಿಲ್ಲಿಸಬೇಕು.<verse eid="EXO 26:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="EXO 26:31"/>“ಪರದೆಯನ್ನು ನೀಲಿ, ಧೂಮ್ರ, ರಕ್ತವರ್ಣದ ದಾರದಿಂದ ಮತ್ತು ನಯವಾದ ನಾರಿನಿಂದ ಹೊಸೆದು ಮಾಡಬೇಕು. ಅದರ ಮೇಲೆ ಕೌಶಲ್ಯದಿಂದ ಕಸೂತಿಹಾಕಿ ಮಾಡಿದ ಕೆರೂಬಿಗಳುಳ್ಳದ್ದನ್ನಾಗಿ ಅದನ್ನು ಮಾಡಬೇಕು. <verse eid="EXO 26:31"/><verse number="32" style="v" sid="EXO 26:32"/>ಜಾಲಿ ಮರದ ನಾಲ್ಕು ಸ್ತಂಭಗಳನ್ನು ಮಾಡಿ, ಬಂಗಾರ ತಗಡುಗಳಿಂದ ಅವುಗಳನ್ನು ಹೊದಿಸಿದರು. ಅವುಗಳಿಗೆ ಬಂಗಾರದ ಕೊಂಡಿಗಳನ್ನು ಮಾಡಿ, ಬೆಳ್ಳಿಯ ನಾಲ್ಕು ಗದ್ದಿಗೇ ಕಲ್ಲುಗಳ ಮೇಲೆ ಊರಿಕೊಂಡಿರುವ ಜಾಲಿ ಮರದ ಸ್ತಂಭಗಳಲ್ಲಿ ಅದನ್ನು ತೂಗು ಹಾಕಬೇಕು. <verse eid="EXO 26:32"/><verse number="33" style="v" sid="EXO 26:33"/>ಆ ಪರದೆಯನ್ನು ಕೊಂಡಿಗಳ ಕೆಳಗೆ ತೂಗುಹಾಕಿ, ಪರದೆಯೊಳಗೆ ಒಡಂಬಡಿಕೆಯ ಮಂಜೂಷವನ್ನು ತರಬೇಕು. ಪರಿಶುದ್ಧ ಸ್ಥಳಕ್ಕೂ ಮಹಾಪರಿಶುದ್ಧ ಸ್ಥಳಕ್ಕೂ ಮಧ್ಯದಲ್ಲಿ ಆ ಪರದೆಯನ್ನು ವಿಂಗಡಿಸಬೇಕು. <verse eid="EXO 26:33"/><verse number="34" style="v" sid="EXO 26:34"/>ಮಹಾಪರಿಶುದ್ಧ ಸ್ಥಳದಲ್ಲಿ ಒಡಂಬಡಿಕೆಯ ಮಂಜೂಷದ ಮೇಲೆ ಕರುಣಾಸನವನ್ನು ಇಡಬೇಕು. <verse eid="EXO 26:34"/><verse number="35" style="v" sid="EXO 26:35"/>ಇದಲ್ಲದೆ ಗುಡಾರದ ಉತ್ತರ ಕಡೆಯಲ್ಲಿ ಪರದೆಯ ಹೊರಗೆ ಮೇಜನ್ನು ಇಡಬೇಕು ಮತ್ತು ದೀಪಸ್ತಂಭವನ್ನು ಅದರ ಎದುರಾಗಿ ದಕ್ಷಿಣದ ದಿಕ್ಕಿನಲ್ಲಿ ಇಡಬೇಕು.<verse eid="EXO 26:35"/></para>
  <para style="p">
    <verse number="36" style="v" sid="EXO 26:36"/>“ಗುಡಾರದ ಬಾಗಿಲಿಗೆ ನೀಲಿ, ಧೂಮ್ರ, ರಕ್ತವರ್ಣದ ದಾರದಿಂದ ಮತ್ತು ನಯವಾದ ನಾರುಗಳಿಂದ ಹೊಸೆದು ಕಸೂತಿ ಕೆಲಸಮಾಡಿದ ಪರದೆಯನ್ನು ಮಾಡಬೇಕು. <verse eid="EXO 26:36"/><verse number="37" style="v" sid="EXO 26:37"/>ಆ ಪರದೆಗೆ ಜಾಲಿ ಮರದ ಐದು ಕಂಬಗಳನ್ನು ಮಾಡಿ, ಅವುಗಳನ್ನು ಬಂಗಾರದಿಂದ ಹೊದಿಸಬೇಕು. ಅವುಗಳ ಕೊಂಡಿಗಳು ಬಂಗಾರದವುಗಳಾಗಿರಬೇಕು. ಅವುಗಳಿಗೆ ಐದು ಗದ್ದಿಗೇ ಕಲ್ಲುಗಳನ್ನು ಕಂಚಿನಿಂದ ಎರಕಹೊಯಿಸಬೇಕು.<verse eid="EXO 26:37"/></para>
  <chapter eid="EXO 26"/>
  <chapter number="27" style="c" sid="EXO 27"/>
  <para style="s1">ದಹನಬಲಿಪೀಠ</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 27:1"/>“ಇದಲ್ಲದೆ ಜಾಲಿ ಮರದಿಂದ ಬಲಿಪೀಠವನ್ನು ಮಾಡಬೇಕು. ಅದರ ಎತ್ತರವು ಸುಮಾರು ಒಂದು ಮೀಟರ್<note caller="+" style="f"><char style="fr" closed="false">27:1 </char><char style="ft" closed="false">ಅಂದರೆ, ಮೂರು ಮೊಳ</char></note> ಇರಬೇಕು. ಅದರ ಉದ್ದ ಮತ್ತು ಅಗಲವು ಸುಮಾರು ಎರಡೂವರೆ ಮೀಟರ್<note caller="+" style="f"><char style="fr" closed="false">27:1 </char><char style="ft" closed="false">ಅಂದರೆ, ಐದು ಮೊಳ</char></note> ಚಚ್ಚೌಕವಾಗಿರಬೇಕು. <verse eid="EXO 27:1"/><verse number="2" style="v" sid="EXO 27:2"/>ಅದರ ನಾಲ್ಕು ಮೂಲೆಗಳಲ್ಲಿ ಕೊಂಬುಗಳನ್ನು ಮಾಡಬೇಕು. ಆ ಕೊಂಬುಗಳು ಆ ಬಲಿಪೀಠಕ್ಕೆ ಏಕವಾಗಿರಬೇಕು. ಅವುಗಳನ್ನು ಕಂಚಿನಿಂದ ಹೊದಿಸಬೇಕು. <verse eid="EXO 27:2"/><verse number="3" style="v" sid="EXO 27:3"/>ಅದರ ಬೂದಿಯನ್ನು ತೆಗೆಯುವದಕ್ಕಾಗಿ ಬಟ್ಟಲುಗಳು, ಸಲಿಕೆಗಳು, ಮುಳ್ಳುಚಮಚಗಳು, ಬೋಗುಣಿಗಳು, ಅಗ್ಗಿಷ್ಟಿಕೆಗಳು ಮತ್ತು ಬಲಿಪೀಠದ ಉಪಕರಣಗಳನ್ನೆಲ್ಲಾ ಕಂಚಿನಿಂದ ಮಾಡಬೇಕು. <verse eid="EXO 27:3"/><verse number="4" style="v" sid="EXO 27:4"/>ಅದಕ್ಕೆ ಹೆಣಿಗೆ ಕೆಲಸದಿಂದ ಕಂಚಿನ ಜಾಳಿಗೆಯನ್ನು ಮಾಡಿ, ಆ ಜಾಳಿಗೆಯ ನಾಲ್ಕು ಮೂಲೆಗಳಿಗೆ ಕಂಚಿನ ನಾಲ್ಕು ಬಳೆಗಳನ್ನು ಮಾಡಬೇಕು. <verse eid="EXO 27:4"/><verse number="5" style="v" sid="EXO 27:5"/>ಆ ಜಾಳಿಗೆಯು ಬಲಿಪೀಠದ ಸುತ್ತಲಿರುವ ಕಟ್ಟಿಗೆಯ ಕಟ್ಟೆಯ ಕೆಳಗೆ ಇದ್ದು, ಅದನ್ನು ಬಲಿಪೀಠದ ಕೆಳಭಾಗದಿಂದ ಮಧ್ಯದವರೆಗೆ ಇರುವಂತೆ ಮಾಡಬೇಕು. <verse eid="EXO 27:5"/><verse number="6" style="v" sid="EXO 27:6"/>ಬಲಿಪೀಠಕ್ಕೆ ಜಾಲಿ ಮರದಿಂದ ಕೋಲುಗಳನ್ನು ಮಾಡಿ, ಅವುಗಳನ್ನು ಕಂಚಿನಿಂದ ಹೊದಿಸಬೇಕು. <verse eid="EXO 27:6"/><verse number="7" style="v" sid="EXO 27:7"/>ಆ ಕೋಲುಗಳನ್ನು ಬಳೆಗಳಲ್ಲಿ ಸೇರಿಸಬೇಕು. ಅವುಗಳು ಬಲಿಪೀಠವನ್ನು ಹೊರುವುದಕ್ಕೆ ಅದರ ಎರಡೂ ಬದಿಯಲ್ಲಿ ಇರಬೇಕು. <verse eid="EXO 27:7"/><verse number="8" style="v" sid="EXO 27:8"/>ಬಲಿಪೀಠವನ್ನು ಚೌಕಟ್ಟುಗಳಿಂದ ಪೊಳ್ಳಾಗಿರುವಂತೆ ಮಾಡಬೇಕು. ಬೆಟ್ಟದಲ್ಲಿ ನಿನಗೆ ತೋರಿಸಿದಂತೆ ಅದನ್ನು ಮಾಡಬೇಕು.<verse eid="EXO 27:8"/></para>
  <para style="s1">ಗುಡಾರದ ಅಂಗಳ</para>
  <para style="p">
    <verse number="9" style="v" sid="EXO 27:9"/>“ಗುಡಾರದ ಅಂಗಳವನ್ನು ಮಾಡಬೇಕು. ಹೇಗೆಂದರೆ ದಕ್ಷಿಣ ದಿಕ್ಕಿನಲ್ಲಿರುವ ಅಂಗಳಕ್ಕೋಸ್ಕರ ನಯವಾಗಿ ಹೊಸೆದ ನಾರಿನ ಪರದೆಗಳನ್ನು ಮಾಡಬೇಕು. ಅವು ಸುಮಾರು ನಲವತ್ತೈದು ಮೀಟರ್<note caller="+" style="f"><char style="fr" closed="false">27:9 </char><char style="ft" closed="false">ಅಂದರೆ, ನೂರು ಮೊಳ</char></note> ಉದ್ದವಾಗಿರಬೇಕು. <verse eid="EXO 27:9"/><verse number="10" style="v" sid="EXO 27:10"/>ಆ ಕಡೆಯಲ್ಲಿ ಇಪ್ಪತ್ತು ಸ್ತಂಭಗಳು ಮತ್ತು ಅವುಗಳಿಗೆ ಇಪ್ಪತ್ತು ಕಂಚಿನ ಗದ್ದಿಗೇ ಕಲ್ಲುಗಳಿರಬೇಕು. ಸ್ತಂಭಗಳ ಕೊಂಡಿಗಳನ್ನು ಮತ್ತು ಅವುಗಳ ಪಟ್ಟಿಗಳನ್ನು ಬೆಳ್ಳಿಯಿಂದ ಮಾಡಬೇಕು. <verse eid="EXO 27:10"/><verse number="11" style="v" sid="EXO 27:11"/>ಹಾಗೆಯೇ ಉತ್ತರ ದಿಕ್ಕಿನ ಪರದೆಗಳು ಸುಮಾರು ನಲವತ್ತೈದು ಮೀಟರ್ ಉದ್ದವಾಗಿರಬೇಕು, ಇಪ್ಪತ್ತು ಸ್ತಂಭಗಳು ಮತ್ತು ಇಪ್ಪತ್ತು ಕಂಚಿನ ಗದ್ದಿಗೇ ಕಲ್ಲುಗಳಿರಬೇಕು. ಆ ಸ್ತಂಭಗಳ ಕೊಂಡಿಗಳು ಮತ್ತು ಕಟ್ಟುಗಳು ಬೆಳ್ಳಿಯಿಂದ ಮಾಡಬೇಕು.<verse eid="EXO 27:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="EXO 27:12"/>“ಅಂಗಳದ ಪಶ್ಚಿಮ ಭಾಗದಲ್ಲಿ ಸುಮಾರು ಇಪ್ಪತ್ತಮೂರು ಮೀಟರ್<note caller="+" style="f"><char style="fr" closed="false">27:12 </char><char style="ft" closed="false">ಅಂದರೆ, ಐವತ್ತು ಮೊಳ</char></note> ಉದ್ದವಾದ ಪರದೆಗಳು, ಹತ್ತು ಸ್ತಂಭಗಳು ಮತ್ತು ಆ ಸ್ತಂಭಗಳಿಗೆ ಹತ್ತು ಗದ್ದಿಗೇ ಕಲ್ಲುಗಳಿರಬೇಕು. <verse eid="EXO 27:12"/><verse number="13" style="v" sid="EXO 27:13"/>ಪೂರ್ವದಿಕ್ಕಿನಲ್ಲಿ ಸೂರ್ಯೋದಯದ ಕಡೆಗೆ ಅಂಗಳದ ಅಗಲವು ಸುಮಾರು ಇಪ್ಪತ್ತಮೂರು ಮೀಟರ್ ಉದ್ದವಾಗಿರಬೇಕು. <verse eid="EXO 27:13"/><verse number="14" style="v" sid="EXO 27:14"/>ದ್ವಾರದ ಒಂದು ಬದಿಯ ಪರದೆಗಳು ಸುಮಾರು ಆರುವರೆ ಮೀಟರ್<note caller="+" style="f"><char style="fr" closed="false">27:14 </char><char style="ft" closed="false">ಅಂದರೆ, ಹದಿನೈದು ಮೊಳ</char></note> ಉದ್ದವಾಗಿರಬೇಕು. ಅವುಗಳಿಗೆ ಮೂರು ಸ್ತಂಭಗಳು, ಆ ಸ್ತಂಭಗಳಿಗೆ ಮೂರು ಕಾಲು ಗದ್ದಿಗೇ ಕಲ್ಲುಗಳು ಇರಬೇಕು. <verse eid="EXO 27:14"/><verse number="15" style="v" sid="EXO 27:15"/>ಎರಡೂ ಕಡೆಗಳಲ್ಲಿ ಸುಮಾರು ಆರುವರೆ ಮೀಟರ್ ಉದ್ದವಾದ ಪರದೆಗಳು, ಅವುಗಳಿಗೆ ಮೂರು ಸ್ತಂಭಗಳು ಮತ್ತು ಮೂರು ಗದ್ದಿಗೇ ಕಲ್ಲುಗಳಿರಬೇಕು.<verse eid="EXO 27:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="EXO 27:16"/>“ಗುಡಾರದ ಅಂಗಳದ ದ್ವಾರಕ್ಕಾಗಿ ನೀಲಿ, ಧೂಮ್ರ, ರಕ್ತವರ್ಣದ ದಾರದಿಂದ ಮತ್ತು ನಯವಾದ ನಾರಿನಿಂದ ಹೊಸೆದು ಕಸೂತಿ ಕೆಲಸಮಾಡಿದ ಇಪ್ಪತ್ತು ಮೊಳದ ಪರದೆ, ಅದಕ್ಕೆ ನಾಲ್ಕು ಸ್ತಂಭಗಳು ಮತ್ತು ನಾಲ್ಕು ಗದ್ದಿಗೇ ಕಲ್ಲುಗಳಿರಬೇಕು. <verse eid="EXO 27:16"/><verse number="17" style="v" sid="EXO 27:17"/>ಅಂಗಳದ ಸುತ್ತಲಿರುವ ಸ್ತಂಭಗಳಿಗೆಲ್ಲಾ ಬೆಳ್ಳಿಯ ಕಟ್ಟುಗಳು, ಬೆಳ್ಳಿಯ ಕೊಂಡಿಗಳು ಮತ್ತು ಗದ್ದಿಗೇ ಕಲ್ಲುಗಳು ಕಂಚಿನದ್ದಾಗಿರಬೇಕು. <verse eid="EXO 27:17"/><verse number="18" style="v" sid="EXO 27:18"/>ಅಂಗಳದ ಉದ್ದ ಸುಮಾರು ನಲವತ್ತೈದು ಮೀಟರ್, ಅಗಲ ಸುಮಾರು ಇಪ್ಪತ್ತಮೂರು ಮೀಟರ್<note caller="+" style="f"><char style="fr" closed="false">27:18 </char><char style="ft" closed="false">ಅಂದರೆ, ಐವತ್ತು ಮೊಳ</char></note>, ಅದರ ಎತ್ತರ ಸುಮಾರು ಎರಡು ಮೀಟರ್<note caller="+" style="f"><char style="fr" closed="false">27:18 </char><char style="ft" closed="false">ಅಂದರೆ, ಐದು ಮೊಳ</char></note> ಇರಬೇಕು. ಪರದೆಗಳು ನಯವಾದ ನಾರಿನಿಂದ ಹೊಸೆದದ್ದಾಗಿದ್ದು, ಅವುಗಳ ಕುಳಿಗಳನ್ನು ಕಂಚಿನಿಂದ ಮಾಡಿಸಬೇಕು. <verse eid="EXO 27:18"/><verse number="19" style="v" sid="EXO 27:19"/>ಗುಡಾರದ ಕೆಲಸಕ್ಕೆ ಬೇಕಾಗುವ ಎಲ್ಲಾ ಉಪಕರಣಗಳು, ಅಂಗಳದ ಸುತ್ತಲೂ ಇರುವ ಎಲ್ಲಾ ಗೂಟಗಳೂ ಕಂಚಿನಿಂದ ಮಾಡಿದ್ದವುಗಳಾಗಿರಬೇಕು.<verse eid="EXO 27:19"/></para>
  <para style="s1">ದೀಪಸ್ತಂಭದ ದೀಪವನ್ನು ಉರಿಸುವುದಕ್ಕೆ ಎಣ್ಣೆ</para>
  <para style="p">
    <verse number="20" style="v" sid="EXO 27:20"/>“ಬೆಳಕಿಗೋಸ್ಕರ ದೀಪಗಳು ಯಾವಾಗಲೂ ಉರಿಯುತ್ತಿರುವಂತೆ ಅವರು ಕುಟ್ಟಿದ ಶುದ್ಧವಾದ ಓಲಿವ್ ಎಣ್ಣೆಯನ್ನು ನನ್ನ ಬಳಿಗೆ ತರುವಂತೆ ನೀನು ಇಸ್ರಾಯೇಲರಿಗೆ ಆಜ್ಞಾಪಿಸಬೇಕು. <verse eid="EXO 27:20"/><verse number="21" style="v" sid="EXO 27:21"/>ದೇವದರ್ಶನದ ಗುಡಾರದಲ್ಲಿ ಒಡಂಬಡಿಕೆಯ ಮಂಜೂಷದ ಮುಂದೆ ಇರುವ ಪರದೆಯ ಹೊರಗೆ, ಆರೋನನು ಮತ್ತು ಅವನ ಮಕ್ಕಳು ಸಂಜೆಯಿಂದ ಉದಯದವರೆಗೆ ಯೆಹೋವ ದೇವರ ಮುಂದೆ ದೀಪವನ್ನು ಸರಿಪಡಿಸುತ್ತಾ ಉರಿಸುತ್ತಿರಬೇಕು. ಈ ನಿಯಮವು ಇಸ್ರಾಯೇಲರಿಗೆ ಮತ್ತು ಅವರ ಸಂತತಿಯವರಿಗೆ ಶಾಶ್ವತವಾದ ನಿಯಮವಾಗಿರಬೇಕು.<verse eid="EXO 27:21"/></para>
  <chapter eid="EXO 27"/>
  <chapter number="28" style="c" sid="EXO 28"/>
  <para style="s1">ಯಾಜಕರು ಧರಿಸಬೇಕಾದ ವಸ್ತ್ರಗಳು</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 28:1"/>“ನನಗೆ ಯಾಜಕ ಸೇವೆ ಮಾಡುವುದಕ್ಕೆ ನೀನು ಇಸ್ರಾಯೇಲರಿಂದ ನಿನ್ನ ಅಣ್ಣನಾದ ಆರೋನನನ್ನೂ, ಅವನ ಮಕ್ಕಳಾದ ನಾದಾಬ್, ಅಬೀಹೂ, ಎಲಿಯಾಜರ್, ಈತಾಮಾರ್ ಎಂಬುವರನ್ನು ನಿನ್ನ ಹತ್ತಿರ ಬರಮಾಡಬೇಕು. <verse eid="EXO 28:1"/><verse number="2" style="v" sid="EXO 28:2"/>ನಿನ್ನ ಸಹೋದರನಾದ ಆರೋನನ ಗೌರವಕ್ಕೋಸ್ಕರವೂ ಅಲಂಕಾರಕ್ಕೋಸ್ಕರವೂ ಪರಿಶುದ್ಧ ವಸ್ತ್ರಗಳನ್ನು ನೀನು ಮಾಡಿಸಬೇಕು. <verse eid="EXO 28:2"/><verse number="3" style="v" sid="EXO 28:3"/>ಇದಲ್ಲದೆ ನಾನು ಜ್ಞಾನದ ಆತ್ಮದಿಂದ ತುಂಬಿದ ವಿವೇಕದ ಹೃದಯವಿರುವವರ ಸಂಗಡ ನೀನು ಮಾತನಾಡು, ಅವರು ಆರೋನನ ವಸ್ತ್ರಗಳನ್ನು ಮಾಡಲಿ. ಅವನು ಅವುಗಳನ್ನು ಧರಿಸಿಕೊಂಡು ನನ್ನ ಯಾಜಕನಾಗುವುದಕ್ಕೆ ಪ್ರತಿಷ್ಠಿತನಾಗುವನು. <verse eid="EXO 28:3"/><verse number="4" style="v" sid="EXO 28:4"/>ಅವರು ಮಾಡಬೇಕಾದ ವಸ್ತ್ರಗಳು ಇವು: ಎದೆಪದಕವು, ಏಫೋದ್, ನಿಲುವಂಗಿ, ಕಸೂತಿಯ ಕೆಲಸದ ಮೇಲಂಗಿ, ಮುಂಡಾಸ, ನಡುಕಟ್ಟು. ನಿನ್ನ ಸಹೋದರನಾದ ಆರೋನನೂ ಅವನ ಪುತ್ರರೂ ನನ್ನ ಯಾಜಕರಾಗಿ ಸೇವೆ ಮಾಡುವುದಕ್ಕೆ ಅವರಿಗಾಗಿ ಪರಿಶುದ್ಧ ವಸ್ತ್ರಗಳನ್ನು ಮಾಡಿಸು. <verse eid="EXO 28:4"/><verse number="5" style="v" sid="EXO 28:5"/>ಅವರು ಬಂಗಾರ, ನೀಲಿ, ಧೂಮ್ರ, ರಕ್ತವರ್ಣದ ದಾರವನ್ನು ಮತ್ತು ನಯವಾದ ನಾರುಬಟ್ಟೆಯನ್ನು ಹೊಸೆದು ಉಪಯೋಗಿಸಬೇಕು.<verse eid="EXO 28:5"/></para>
  <para style="s1">ಏಫೋದ್ ಎಂಬ ಕವಚ</para>
  <para style="p">
    <verse number="6" style="v" sid="EXO 28:6"/>“ಏಫೋದನ್ನು ಬಂಗಾರ, ನೀಲಿ, ಧೂಮ್ರ, ರಕ್ತವರ್ಣದ ದಾರದಿಂದ ಮತ್ತು ನಯವಾದ ನಾರಿನಿಂದ ಹೊಸೆದು ಕಸೂತಿ ಕೆಲಸ ಮಾಡಬೇಕು. <verse eid="EXO 28:6"/><verse number="7" style="v" sid="EXO 28:7"/>ಈ ಕವಚಕ್ಕೆ ಅದರ ಎರಡೂ ಕೊನೆಗಳನ್ನು ಜೋಡಿಸುವುದಕ್ಕೆ ಎರಡು ಹೆಗಲು ಪಟ್ಟಿಗಳಿರಬೇಕು. <verse eid="EXO 28:7"/><verse number="8" style="v" sid="EXO 28:8"/>ಅದರ ಮೇಲಿರುವ ಕಸೂತಿ ಕೆಲಸದ ಏಫೋದಿನ ನಡುಕಟ್ಟನ್ನು ಒಂದೇ ರೀತಿಯ ವಸ್ತುಗಳಿಂದ ತಯಾರಿಸಬೇಕು ಅಂದರೆ ಬಂಗಾರ, ನೀಲಿ, ಧೂಮ್ರ, ರಕ್ತವರ್ಣದ ದಾರಿನಿಂದ ಮತ್ತು ನಯವಾದ ನಾರಿನಿಂದ ಹೊಸೆದು ಮಾಡಿದ್ದಾಗಿರಬೇಕು.<verse eid="EXO 28:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="EXO 28:9"/>“ನೀನು ಎರಡು ಗೋಮೇಧಿಕ ರತ್ನಗಳನ್ನು ತೆಗೆದುಕೊಂಡು ಇಸ್ರಾಯೇಲರ ಮಕ್ಕಳ ಹೆಸರುಗಳನ್ನು ಅವುಗಳ ಮೇಲೆ ಕೆತ್ತಬೇಕು. <verse eid="EXO 28:9"/><verse number="10" style="v" sid="EXO 28:10"/>ಒಂದು ರತ್ನದ ಮೇಲೆ ಆರು ಹೆಸರುಗಳನ್ನು ಮತ್ತೊಂದು ರತ್ನದ ಮೇಲೆ ಮಿಕ್ಕ ಆರು ಹೆಸರುಗಳನ್ನು ಅವರವರ ಜನನದ ಪ್ರಕಾರ ಕೆತ್ತಬೇಕು. <verse eid="EXO 28:10"/><verse number="11" style="v" sid="EXO 28:11"/>ಶಿಲ್ಪಿಗನು ಕಲ್ಲಿನ ಮೇಲೆ ಮುದ್ರೆ ಕೆತ್ತುವ ಪ್ರಕಾರ, ಆ ಎರಡೂ ರತ್ನಗಳ ಮೇಲೆ ಇಸ್ರಾಯೇಲರ ಮಕ್ಕಳ ಹೆಸರುಗಳನ್ನು ಕೆತ್ತಿಸಿ, ಅವುಗಳನ್ನು ಬಂಗಾರದ ಜವೆಗಳಲ್ಲಿ ಹೊದಿಸಿದ್ದಾಗಿ ಮಾಡಬೇಕು. <verse eid="EXO 28:11"/><verse number="12" style="v" sid="EXO 28:12"/>ಆ ಎರಡು ರತ್ನಗಳನ್ನು ಏಫೋದಿನ ಹೆಗಲಿನ ಭಾಗದ ಮೇಲೆ ಇಸ್ರಾಯೇಲರ ಜ್ಞಾಪಕಾರ್ಥವಾದ ರತ್ನಗಳಾಗಿ ಇಡಬೇಕು. ಆರೋನನು ತನ್ನ ಎರಡು ಹೆಗಲುಗಳ ಮೇಲೆ ಅವರ ಹೆಸರುಗಳನ್ನು ಯೆಹೋವ ದೇವರ ಸನ್ನಿಧಿಯಲ್ಲಿ ಜ್ಞಾಪಕಾರ್ಥವಾಗಿ ಹೊರಬೇಕು. <verse eid="EXO 28:12"/><verse number="13" style="v" sid="EXO 28:13"/>ನೀನು ಬಂಗಾರದ ಜವೆಗಳನ್ನು ಮಾಡಬೇಕು. <verse eid="EXO 28:13"/><verse number="14" style="v" sid="EXO 28:14"/>ಹೊಸೆದ ಹಗ್ಗದಂತೆ ಶುದ್ಧ ಬಂಗಾರದ ಎರಡು ಸರಪಣಿಗಳನ್ನು ಹೆಣಿಗೆ ಕೆಲಸದಿಂದ ಮಾಡಿ, ಆ ಹೆಣೆದ ಸರಪಣಿಗಳ ಕೊನೆಗಳನ್ನು ಜವೆಗಳಿಗೆ ಸೇರಿಸಿಬೇಕು.<verse eid="EXO 28:14"/></para>
  <para style="s1">ಎದೆಯ ಪದಕ</para>
  <para style="p">
    <verse number="15" style="v" sid="EXO 28:15"/>“ದೇವನಿರ್ಣಯ ಮಾಡುವ ಆತನ ಎದೆಪದಕವನ್ನು ಕೌಶಲ್ಯ ಕೆಲಸದಿಂದ ಎಂದರೆ ಏಫೋದಿನ ಕೆಲಸದ ಹಾಗೆಯೇ ಬಂಗಾರ, ನೀಲಿ, ಧೂಮ್ರ, ರಕ್ತವರ್ಣದ ದಾರಿನಿಂದ ಮತ್ತು ನಯವಾದ ನಾರಿನಿಂದ ಹೊಸೆದು ಮಾಡಿಸಬೇಕು. <verse eid="EXO 28:15"/><verse number="16" style="v" sid="EXO 28:16"/>ಅದು ಗೇಣು ಉದ್ದ, ಒಂದು ಗೇಣು ಅಗಲ ಮತ್ತು ಇದು ಎರಡು ಪದರುಳ್ಳದ್ದಾಗಿ ಚಚ್ಚೌಕವಾಗಿಯೂ ಇರಬೇಕು. <verse eid="EXO 28:16"/><verse number="17" style="v" sid="EXO 28:17"/>ನಂತರ ಅದರಲ್ಲಿ ನಾಲ್ಕು ಸಾಲುಗಳಾಗಿ ರತ್ನಗಳನ್ನು ಜೋಡಿಸಬೇಕು. ಮೊದಲನೆಯ ಸಾಲಿನಲ್ಲಿ ಮಾಣಿಕ್ಯ, ಪುಷ್ಯರಾಗ ಮತ್ತು ಸ್ಫಟಿಕಗಳಿರಬೇಕು. <verse eid="EXO 28:17"/><verse number="18" style="v" sid="EXO 28:18"/>ಎರಡನೆಯ ಸಾಲಿನಲ್ಲಿ ಕೆಂಪರಲು, ನೀಲ ಮತ್ತು ಪಚ್ಚೆಗಳಿರಬೇಕು. <verse eid="EXO 28:18"/><verse number="19" style="v" sid="EXO 28:19"/>ಮೂರನೆಯ ಸಾಲಿನಲ್ಲಿ ಸುವರ್ಣರತ್ನ, ಗೋಮೇಧಿಕ ಮತ್ತು ಧೂಮ್ರಮಣಿಗಳಿರಬೇಕು. <verse eid="EXO 28:19"/><verse number="20" style="v" sid="EXO 28:20"/>ನಾಲ್ಕನೆಯ ಸಾಲಿನಲ್ಲಿ ಪೀತರತ್ನ, ಗೋಮೇಧಿಕ, ಸೂರ್ಯಕಾಂತ ಶಿಲೆ ಇವುಗಳನ್ನು ಬಂಗಾರದ ಜವೆಯ ಕಲ್ಲುಗಳಲ್ಲಿ ಸೇರಿಸಬೇಕು. <verse eid="EXO 28:20"/><verse number="21" style="v" sid="EXO 28:21"/>ಈ ರತ್ನಗಳು ಇಸ್ರಾಯೇಲರ ಗೋತ್ರದ ಹೆಸರುಗಳ ಪ್ರಕಾರ ಅವು ಹನ್ನೆರಡಾಗಿರಬೇಕು. ಒಂದೊಂದರ ಮೇಲೆ ಒಂದೊಂದು ಹೆಸರಿದ್ದು, ಹನ್ನೆರಡು ಗೋತ್ರಗಳ ಪ್ರಕಾರ ಮುದ್ರೆಗಳ ಹಾಗೆ ಕೆತ್ತಿರಬೇಕು.<verse eid="EXO 28:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="EXO 28:22"/>“ಎದೆಪದಕದ ಮೇಲಿರುವ ಕೊನೆಗಳಲ್ಲಿ ಶುದ್ಧ ಬಂಗಾರದಿಂದ ಹೆಣೆದ ಕೆಲಸವಾಗಿರುವ ಹುರಿಗಳಂತಿರುವ ಸರಪಣಿಯನ್ನು ಮಾಡಬೇಕು. <verse eid="EXO 28:22"/><verse number="23" style="v" sid="EXO 28:23"/>ಆ ಎದೆಪದಕದ ಮೇಲೆ ಬಂಗಾರದ ಎರಡು ಬಳೆಗಳನ್ನು ಮಾಡಿ, ಆ ಎರಡು ಬಳೆಗಳನ್ನು ಎದೆಪದಕದ ಎರಡು ಕೊನೆಗಳಲ್ಲಿ ಹಾಕಬೇಕು. <verse eid="EXO 28:23"/><verse number="24" style="v" sid="EXO 28:24"/>ಬಂಗಾರದಿಂದ ಹೆಣೆದ ಆ ಎರಡು ಸರಪಣಿಗಳನ್ನು ಎದೆಪದಕದ ಕೊನೆಗಳಲ್ಲಿರುವ ಎರಡು ಬಳೆಗಳಲ್ಲಿ ಸೇರಿಸಬೇಕು. <verse eid="EXO 28:24"/><verse number="25" style="v" sid="EXO 28:25"/>ಆ ಎರಡು ಹೆಣೆದ ಸರಪಣಿಗಳ ಎರಡು ಕೊನೆಗಳನ್ನು ಎರಡು ಜವೆಗಳಲ್ಲಿ ಸೇರಿಸಿ, ಏಫೋದಿನ ಹೆಗಲು ಭಾಗಗಳ ಮುಂದುಗಡೆ ಇರಿಸಬೇಕು. <verse eid="EXO 28:25"/><verse number="26" style="v" sid="EXO 28:26"/>ಅದಲ್ಲದೆ ಬಂಗಾರದ ಎರಡು ಉಂಗುರಗಳನ್ನು ಮಾಡಿ, ಎದೆಪದಕದ ಎರಡು ಕೊನೆಗಳಲ್ಲಿ ಸೇರಿಸಿ, ಏಫೋದಿನ ಬದಿಗೆ ಒಳಗಡೆಯಲ್ಲಿ ಹಾಕಬೇಕು. <verse eid="EXO 28:26"/><verse number="27" style="v" sid="EXO 28:27"/>ಚಿನ್ನದ ಬೇರೆ ಎರಡು ಉಂಗುರಗಳನ್ನು ಮಾಡಿ, ಏಫೋದಿನ ಮುಂಬದಿಯ ಕೆಳಗಿನ ಎರಡು ಹೆಗಲಿನ ಪಟ್ಟಿಗಳಲ್ಲಿ, ಏಫೋದಿನ ವಿಚಿತ್ರವಾದ ನಡುಕಟ್ಟಿನ ಮೇಲೆ ಅದನ್ನು ಜೋಡಿಸುವ ಸ್ಥಳಕ್ಕೆ ಎದುರಾಗಿ ಇರಿಸಬೇಕು. <verse eid="EXO 28:27"/><verse number="28" style="v" sid="EXO 28:28"/>ಆ ಎದೆಪದಕವನ್ನು ಏಫೋದಿನ ವಿಚಿತ್ರವಾದ ನಡುಕಟ್ಟಿನ ಮೇಲೆ ಇರುವಂತೆಯೂ, ಎದೆಪದಕವು ಏಫೋದನ್ನು ಬಿಟ್ಟು ಅಲ್ಲಾಡದಂತೆಯೂ, ಅದರ ಉಂಗುರಗಳ ಮೂಲಕವಾಗಿ ಏಫೋದಿನ ಉಂಗುರಗಳಿಗೆ ನೀಲಿ ದಾರದಿಂದ ಕಟ್ಟಬೇಕು.<verse eid="EXO 28:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="EXO 28:29"/>“ಹೀಗೆ ಆರೋನನು ಪರಿಶುದ್ಧ ಸ್ಥಳಕ್ಕೆ ಬರುವಾಗ ಇಸ್ರಾಯೇಲರ ಹೆಸರುಗಳನ್ನು ಯಾವಾಗಲೂ ಯೆಹೋವ ದೇವರ ಮುಂದೆ ಜ್ಞಾಪಕ ಮಾಡುವುದಕ್ಕಾಗಿ ನ್ಯಾಯದ ಎದೆಪದಕವನ್ನು ತನ್ನ ಹೃದಯದ ಮೇಲೆ ಹೊರಬೇಕು. <verse eid="EXO 28:29"/><verse number="30" style="v" sid="EXO 28:30"/>ನಿರ್ಣಯವನ್ನು ತಿಳಿಸುವ ಎದೆಪದಕದಲ್ಲಿ ಊರೀಮ್ ಮತ್ತು ತುಮ್ಮೀಮ್‌ಗಳನ್ನು ಇಡಬೇಕು. ಆರೋನನು ಯೆಹೋವ ದೇವರ ಸನ್ನಿಧಿಗೆ ಬರುವ ಸಮಯದಲ್ಲಿ ಅವು ಅವನ ಹೃದಯದ ಮೇಲೆ ಇರಬೇಕು. ಹೀಗೆ ಆರೋನನು ಯೆಹೋವ ದೇವರ ಮುಂದೆ ಯಾವಾಗಲೂ ಇಸ್ರಾಯೇಲರ ನಿರ್ಣಯಗಳನ್ನು ತನ್ನ ಹೃದಯದ ಮೇಲೆ ಹೊರಬೇಕು.<verse eid="EXO 28:30"/></para>
  <para style="s1">ಯಾಜಕನ ಇತರ ವಸ್ತ್ರಗಳು</para>
  <para style="p">
    <verse number="31" style="v" sid="EXO 28:31"/>“ಏಫೋದಿನ ನಿಲುವಂಗಿಯನ್ನೆಲ್ಲಾ ನೀಲಿ ಬಣ್ಣದ ಬಟ್ಟೆಯಿಂದ ಮಾಡಬೇಕು. <verse eid="EXO 28:31"/><verse number="32" style="v" sid="EXO 28:32"/>ಅದರ ಮಧ್ಯದಲ್ಲಿ ಮೇಲ್ಗಡೆ ತಲೆದೂರಿಸುವುದಕ್ಕೆ ರಂದ್ರವಿರಬೇಕು. ಅದು ಹರಿಯದ ಆ ರಂದ್ರದ ಸುತ್ತಲೂ ನೇಯ್ಗೆ ಕಸೂತಿಯನ್ನು ಹಾಕಿಸಬೇಕು. <verse eid="EXO 28:32"/><verse number="33" style="v" sid="EXO 28:33"/>ನಿಲುವಂಗಿಯ ಅಂಚಿನ ಮೇಲೆ ನೀಲಿ, ಧೂಮ್ರ, ರಕ್ತವರ್ಣದ ದಾರದಿಂದ ದಾಳಿಂಬೆ ಹಣ್ಣಿನಂತೆ ಅದರ ಅಂಚಿನ ಸುತ್ತಲೂ ಮಾಡಿ, ಅವುಗಳ ಮಧ್ಯದಲ್ಲಿ ಬಂಗಾರದ ಗಂಟೆಗಳನ್ನೂ ಸುತ್ತಲೂ ಇರಿಸಬೇಕು. <verse eid="EXO 28:33"/><verse number="34" style="v" sid="EXO 28:34"/>ಒಂದು ಗೆಜ್ಜೆ, ಒಂದು ದಾಳಿಂಬೆಯಂತಿರುವ ಚೆಂಡನ್ನು ಒಂದಾದ ಮೇಲೆ ಒಂದು ಮೇಲಂಗಿಯ ಅಂಚಿನ ಸುತ್ತಲೂ ಇರಬೇಕು. <verse eid="EXO 28:34"/><verse number="35" style="v" sid="EXO 28:35"/>ಇದು ಸೇವೆಗಾಗಿ ಆರೋನನ ಮೇಲೆ ಇರಬೇಕು. ಅವನು ಯೆಹೋವ ದೇವರ ಸಮ್ಮುಖದಲ್ಲಿ ಪರಿಶುದ್ಧ ಸ್ಥಳಕ್ಕೆ ಬರುತ್ತಾ ಹೋಗುತ್ತಾ ಇರುವ ಸಮಯದಲ್ಲಿ, ಅವನು ಸಾಯದಂತೆ ಅವನ ಶಬ್ದವು ಕೇಳಿಸಬೇಕು.<verse eid="EXO 28:35"/></para>
  <para style="p">
    <verse number="36" style="v" sid="EXO 28:36"/>“ಶುದ್ಧ ಬಂಗಾರದ ತಗಡನ್ನು ಮಾಡಿ ಮುದ್ರೆ ಕೆತ್ತುವ ಪ್ರಕಾರ, ಅದರಲ್ಲಿ ಹೀಗೆ ಕೆತ್ತಬೇಕು:</para>
  <para style="pc" vid="EXO 28:36">
    <char style="sc">‘ಯೆಹೋವ ದೇವರಿಗೆ ಪರಿಶುದ್ಧ.’</char><verse eid="EXO 28:36"/></para>
  <para style="m">
    <verse number="37" style="v" sid="EXO 28:37"/>ಅದು ಮುಂಡಾಸದ ಮುಂಭಾಗದಲ್ಲಿರುವಂತೆ ಅದನ್ನು ನೀಲಿ ದಾರಿನಿಂದ ಕಟ್ಟಬೇಕು. <verse eid="EXO 28:37"/><verse number="38" style="v" sid="EXO 28:38"/>ಇಸ್ರಾಯೇಲರು ತಮ್ಮ ಪರಿಶುದ್ಧ ದಾನಗಳನ್ನೆಲ್ಲಾ ಪರಿಶುದ್ಧ ಮಾಡುವ ಪರಿಶುದ್ಧ ಕಾರ್ಯಗಳ ದೋಷವನ್ನು ಆರೋನನು ಹೊರುವ ಹಾಗೆ ಅದು ಆರೋನನ ಹಣೆಯ ಮೇಲಿರಬೇಕು. ಯೆಹೋವ ದೇವರ ಮುಂದೆ ಅವುಗಳೆಲ್ಲಾ ಅಂಗೀಕಾರವಾಗುವ ಹಾಗೆ ಅದು ಯಾವಾಗಲೂ ಅವನ ಹಣೆಯ ಮೇಲೆ ಇರಬೇಕು.<verse eid="EXO 28:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="EXO 28:39"/>“ನಯವಾದ ನಾರಿನಿಂದ ಹೊಸೆದು ಕಸೂತಿ ಕೆಲಸದಿಂದ ಮಾಡಿದ ಮೇಲಂಗಿಯನ್ನೂ ನಯವಾದ ನಾರಿನಿಂದ ಮಾಡಿದ ಮುಂಡಾಸವನ್ನೂ ಹೆಣಿಗೆಯ ಕೆಲಸದಿಂದ ನಡುಕಟ್ಟನ್ನೂ ಮಾಡಿಸಬೇಕು. <verse eid="EXO 28:39"/><verse number="40" style="v" sid="EXO 28:40"/>ಆರೋನನ ಮಕ್ಕಳಿಗೆ ತಕ್ಕ ಗೌರವ ಹಾಗೂ ಶೋಭೆ ಸಿಗುವಂತೆ ನಿಲುವಂಗಿಗಳನ್ನೂ, ನಡುಕಟ್ಟುಗಳನ್ನೂ ಹಾಗೂ ಪೇಟಗಳನ್ನೂ ಮಾಡಿಸು. <verse eid="EXO 28:40"/><verse number="41" style="v" sid="EXO 28:41"/>ಅವುಗಳನ್ನು ನಿನ್ನ ಸಹೋದರ ಆರೋನನ ಮತ್ತು ಅವನ ಪುತ್ರರಿಗೆ ತೊಡಿಸಿ, ಅವರನ್ನು ಅಭಿಷೇಕಿಸಿ, ಪ್ರತಿಷ್ಠೆ ಮಾಡು. ಅವರು ನನಗೆ ಯಾಜಕ ಸೇವೆ ಮಾಡುವ ಹಾಗೆ ಅವರನ್ನು ಶುದ್ಧಮಾಡು.<verse eid="EXO 28:41"/></para>
  <para style="p">
    <verse number="42" style="v" sid="EXO 28:42"/>“ಅವರ ಬೆತ್ತಲೆಯನ್ನು ಮುಚ್ಚುವ ಹಾಗೆ ನಾರಿನ ಚಡ್ಡಿಗಳನ್ನು ಮಾಡಿಸು. ಅವು ಸೊಂಟದಿಂದ ತೊಡೆಯವರೆಗೆ ಇರಬೇಕು. <verse eid="EXO 28:42"/><verse number="43" style="v" sid="EXO 28:43"/>ಆರೋನನೂ ಅವನ ಪುತ್ರರೂ ದೇವದರ್ಶನದ ಗುಡಾರಕ್ಕೆ ಬರುವ ಸಮಯದಲ್ಲಿಯೂ ಪರಿಶುದ್ಧ ಸ್ಥಳದಲ್ಲಿ ಸೇವೆ ಮಾಡುವುದಕ್ಕೆ ಬಲಿಪೀಠದ ಸಮೀಪಕ್ಕೆ ಬರುವ ಸಮಯದಲ್ಲಿಯೂ ದೋಷವನ್ನು ಹೊತ್ತು ಸಾಯದ ಹಾಗೆ ಇವುಗಳನ್ನು ಹಾಕಿಕೊಂಡಿರಬೇಕು.</para>
  <para style="p" vid="EXO 28:43">“ಇದೇ ಆರೋನನಿಗೂ ಅವನ ತರುವಾಯ ಅವನ ಸಂತತಿಯವರಿಗೂ ಇರಬೇಕಾದ ನಿತ್ಯವಾದ ಕಟ್ಟಳೆ.<verse eid="EXO 28:43"/></para>
  <chapter eid="EXO 28"/>
  <chapter number="29" style="c" sid="EXO 29"/>
  <para style="s1">ಯಾಜಕರನ್ನು ಪ್ರತಿಷ್ಠಿಸಬೇಕಾದ ಕ್ರಮ</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 29:1"/>“ಅವರು ನನಗೆ ಯಾಜಕ ಸೇವೆಮಾಡುವಂತೆ ನೀನು ಅವರನ್ನು ಶುದ್ಧ ಮಾಡಲು ಮಾಡಬೇಕಾದದ್ದೇನೆಂದರೆ: ದೋಷವಿಲ್ಲದ ಒಂದು ಹೋರಿಯನ್ನೂ ಎರಡು ಟಗರುಗಳನ್ನೂ, <verse eid="EXO 29:1"/><verse number="2" style="v" sid="EXO 29:2"/>ಅತ್ಯುತ್ತಮ ಗೋಧಿಯ ಹಿಟ್ಟಿನಿಂದ ಹುಳಿಯಿಲ್ಲದ ರೊಟ್ಟಿಗಳನ್ನೂ ಎಣ್ಣೆ ಹೊಯ್ದ ಹುಳಿಯಿಲ್ಲದ ಹೋಳಿಗೆಗಳನ್ನೂ ಎಣ್ಣೆ ಹಚ್ಚಿದ ಹುಳಿಯಿಲ್ಲದ ಪೂರಿಗಳನ್ನೂ ತೆಗೆದುಕೊಳ್ಳಬೇಕು. <verse eid="EXO 29:2"/><verse number="3" style="v" sid="EXO 29:3"/>ಇವುಗಳನ್ನು ಒಂದೇ ಬುಟ್ಟಿಯಲ್ಲಿ ಇಟ್ಟುಕೊಂಡು ಹೋರಿ ಮತ್ತು ಎರಡು ಟಗರುಗಳ ಸಂಗಡ ತೆಗೆದುಕೊಂಡು ಬರಬೇಕು. <verse eid="EXO 29:3"/><verse number="4" style="v" sid="EXO 29:4"/>ಆರೋನನನ್ನೂ ಅವನ ಪುತ್ರರನ್ನೂ ದೇವದರ್ಶನದ ಗುಡಾರದ ಬಾಗಿಲಿನ ಬಳಿಗೆ ತಂದು, ನೀರಿನಲ್ಲಿ ಅವರನ್ನು ತೊಳೆಯಬೇಕು. <verse eid="EXO 29:4"/><verse number="5" style="v" sid="EXO 29:5"/>ತರುವಾಯ ಆ ವಸ್ತ್ರಗಳನ್ನು ತೆಗೆದುಕೊಂಡು ಆರೋನನಿಗೆ ಅಂಗಿಯನ್ನೂ ಏಫೋದಿನ ನಿಲುವಂಗಿಯನ್ನೂ ಏಫೋದನ್ನೂ ಎದೆಪದಕವನ್ನೂ ತೊಡಿಸಿ, ಏಫೋದಿನ ಕಲಾತ್ಮಕವಾದ ನಡುಕಟ್ಟಿನಿಂದ ಅವನ ನಡುವನ್ನೂ ಕಟ್ಟಿ, <verse eid="EXO 29:5"/><verse number="6" style="v" sid="EXO 29:6"/>ಅವನ ತಲೆಗೆ ಮುಂಡಾಸವನ್ನು ಇಟ್ಟು, ಮುಂಡಾಸದ ಮೇಲೆ ಪರಿಶುದ್ಧ ಪಟ್ಟವನ್ನು ಇಟ್ಟು, <verse eid="EXO 29:6"/><verse number="7" style="v" sid="EXO 29:7"/>ಅಭಿಷೇಕಿಸುವ ಎಣ್ಣೆಯನ್ನು ತೆಗೆದುಕೊಂಡು, ಅವನ ತಲೆಯ ಮೇಲೆ ಹೊಯ್ದು, ಅವನನ್ನು ಅಭಿಷೇಕಿಸಬೇಕು. <verse eid="EXO 29:7"/><verse number="8" style="v" sid="EXO 29:8"/>ನೀನು ಅವನ ಪುತ್ರರನ್ನು ಕರೆದುಕೊಂಡು ಬಂದು ಅವರಿಗೆ ನಿಲುವಂಗಿಗಳನ್ನು ತೊಡಿಸಿ, <verse eid="EXO 29:8"/><verse number="9" style="v" sid="EXO 29:9"/>ಆರೋನನಿಗೂ ಅವನ ಪುತ್ರರಿಗೂ ಮುಂಡಾಸುಗಳನ್ನು ಇಟ್ಟು ನಡುಕಟ್ಟುಗಳನ್ನು ಕಟ್ಟಬೇಕು, ಅವರಿಗೆ ಹೀಗೆ ಅವರಿಗೆ ಯಾಜಕತ್ವ ಸೇವೆಯು ಶಾಶ್ವತ ಕಟ್ಟಳೆಯಾಗಿರುವುದು.</para>
  <para style="p" vid="EXO 29:9">“ಈ ರೀತಿಯಾಗಿ ಆರೋನನನ್ನೂ ಅವನ ಪುತ್ರರನ್ನೂ ನೀನು ಪ್ರತಿಷ್ಠೆ ಮಾಡಬೇಕು.<verse eid="EXO 29:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="EXO 29:10"/>“ಇದಲ್ಲದೆ ಆ ಹೋರಿಯನ್ನು ಸಭೆಯ ಗುಡಾರದ ಮುಂದೆ ತರಬೇಕು. ಆರೋನನೂ ಅವನ ಪುತ್ರರೂ ಹೋರಿಯ ತಲೆಯ ಮೇಲೆ ತಮ್ಮ ಕೈಗಳನ್ನು ಇಡಬೇಕು. <verse eid="EXO 29:10"/><verse number="11" style="v" sid="EXO 29:11"/>ತರುವಾಯ ನೀನು ಆ ಹೋರಿಯನ್ನು ಯೆಹೋವ ದೇವರ ಮುಂದೆ ದೇವದರ್ಶನದ ಗುಡಾರದ ಬಾಗಿಲಲ್ಲಿ ವಧಿಸಬೇಕು. <verse eid="EXO 29:11"/><verse number="12" style="v" sid="EXO 29:12"/>ನೀನು ಹೋರಿಯ ರಕ್ತವನ್ನು ತೆಗೆದುಕೊಂಡು ನಿನ್ನ ಬೆರಳಿನಿಂದ ಬಲಿಪೀಠದ ಕೊಂಬುಗಳಿಗೆ ಹಚ್ಚಿ, ರಕ್ತವನ್ನೆಲ್ಲಾ ಬಲಿಪೀಠದ ಅಡಿಯಲ್ಲಿ ಸುರಿಯಬೇಕು. <verse eid="EXO 29:12"/><verse number="13" style="v" sid="EXO 29:13"/>ನೀನು ಕರುಳುಗಳನ್ನೂ ಅವುಗಳ ಮೇಲಿರುವ ಎಲ್ಲಾ ಕೊಬ್ಬನ್ನೂ ಕಾಳಿಜದ ಮೇಲಿರುವ ಕೊಬ್ಬನ್ನೂ ಎರಡು ಮೂತ್ರ ಜನಕಾಂಗಗಳನ್ನೂ ಅವುಗಳ ಕೊಬ್ಬನ್ನೂ ತೆಗೆದುಕೊಂಡು ಬಲಿಪೀಠದ ಮೇಲೆ ಸುಡಬೇಕು. <verse eid="EXO 29:13"/><verse number="14" style="v" sid="EXO 29:14"/>ಇದಲ್ಲದೆ ಹೋರಿಯ ಮಾಂಸವನ್ನೂ ಅದರ ಚರ್ಮವನ್ನೂ, ಅದರ ಸಗಣಿಯನ್ನೂ ಪಾಳೆಯದ ಹೊರಗೆ ಬೆಂಕಿಯಿಂದ ಸುಡಬೇಕು. ಅದು ಪಾಪ ಪರಿಹಾರದ ಬಲಿಯಾಗಿದೆ.<verse eid="EXO 29:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="EXO 29:15"/>“ನೀನು ಒಂದು ಟಗರನ್ನು ಸಹ ತೆಗೆದುಕೊಳ್ಳಬೇಕು. ಆರೋನನು ಮತ್ತು ಅವನ ಪುತ್ರರು ಆ ಟಗರಿನ ತಲೆಯ ಮೇಲೆ ತಮ್ಮ ಕೈಗಳನ್ನು ಇಡಬೇಕು. <verse eid="EXO 29:15"/><verse number="16" style="v" sid="EXO 29:16"/>ತರುವಾಯ ಆ ಟಗರನ್ನು ನೀನು ವಧಿಸಿ, ಅದರ ರಕ್ತವನ್ನು ತೆಗೆದುಕೊಂಡು ಬಲಿಪೀಠದ ಮೇಲೆ ಸುತ್ತಲೂ ಚಿಮುಕಿಸಬೇಕು. <verse eid="EXO 29:16"/><verse number="17" style="v" sid="EXO 29:17"/>ಇದಲ್ಲದೆ ಆ ಟಗರನ್ನು ತುಂಡುತುಂಡಾಗಿ ಕಡಿದು, ಅದರ ಕರುಳುಗಳನ್ನೂ ಕಾಲುಗಳನ್ನೂ ತೊಳೆದು, ಅದರ ತುಂಡುಗಳನ್ನು ತಲೆಯ ಸಂಗಡ ಇಡಬೇಕು. <verse eid="EXO 29:17"/><verse number="18" style="v" sid="EXO 29:18"/>ಅದನ್ನೆಲ್ಲಾ ಬಲಿಪೀಠದ ಮೇಲೆ ಸುಡಬೇಕು. ಅದು ಯೆಹೋವ ದೇವರಿಗೆ ದಹನಬಲಿಯಾಗಿದೆ. ಅದು ಯೆಹೋವ ದೇವರಿಗೆ ಸುವಾಸನೆಯ ದಹನಬಲಿ.<verse eid="EXO 29:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="EXO 29:19"/>“ಆ ಇನ್ನೊಂದು ಟಗರನ್ನು ನೀನು ತಂದಾಗ, ಆರೋನನೂ ಅವನ ಪುತ್ರರೂ ಆ ಟಗರಿನ ತಲೆಯ ಮೇಲೆ ತಮ್ಮ ಕೈಗಳನ್ನು ಇಡಬೇಕು. <verse eid="EXO 29:19"/><verse number="20" style="v" sid="EXO 29:20"/>ತರುವಾಯ ನೀನು ಅದನ್ನು ವಧಿಸಿ, ಅದರ ರಕ್ತವನ್ನು ಆರೋನನ ಮತ್ತು ಅವನ ಪುತ್ರರ ಬಲಗಿವಿಯ ತುದಿಗೂ ಬಲಗೈಯ ಹೆಬ್ಬೆರಳಿಗೂ ಬಲಗಾಲಿನ ಹೆಬ್ಬೆಟ್ಟಿಗೂ ಹಚ್ಚಿ, ಆ ರಕ್ತವನ್ನು ಬಲಿಪೀಠದ ಸುತ್ತಲೂ ಚಿಮುಕಿಸಬೇಕು. <verse eid="EXO 29:20"/><verse number="21" style="v" sid="EXO 29:21"/>ಆರೋನನೂ ಅವನ ವಸ್ತ್ರಗಳೂ ಅವನೊಂದಿಗೆ ಅವನ ಪುತ್ರರೂ ಅವರ ವಸ್ತ್ರಗಳೂ ಪರಿಶುದ್ಧವಾಗುವ ಹಾಗೆ ಬಲಿಪೀಠದ ಮೇಲಿರುವ ರಕ್ತವನ್ನೂ, ಅಭಿಷೇಕ ತೈಲವನ್ನೂ ತೆಗೆದುಕೊಂಡು ಆರೋನನ ಮೇಲೆಯೂ ಅವನ ವಸ್ತ್ರಗಳ ಮೇಲೆಯೂ ಅವನ ಪುತ್ರರ ಮೇಲೆಯೂ ಅವರ ವಸ್ತ್ರಗಳ ಮೇಲೆಯೂ ನೀನು ಚಿಮುಕಿಸಬೇಕು.<verse eid="EXO 29:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="EXO 29:22"/>“ಇದಲ್ಲದೆ ಆ ಟಗರಿನ ಕೊಬ್ಬನ್ನೂ ಬಾಲವನ್ನೂ ಕರುಳುಗಳ ಮೇಲಿರುವ ಕೊಬ್ಬನ್ನೂ ಕಾಳಿಜದ ಮೇಲಿರುವ ಕೊಬ್ಬನ್ನೂ ಎರಡು ಮೂತ್ರ ಜನಕಾಂಗಗಳನ್ನೂ ಅವುಗಳ ಕೊಬ್ಬನ್ನೂ ಬಲದೊಡೆಯನ್ನೂ ತೆಗೆದುಕೊಳ್ಳಬೇಕು. ಏಕೆಂದರೆ ಅದು ಪ್ರತಿಷ್ಠೆಯ ಟಗರು. <verse eid="EXO 29:22"/><verse number="23" style="v" sid="EXO 29:23"/>ಯೆಹೋವ ದೇವರ ಸನ್ನಿಧಿಯಲ್ಲಿರುವ ಹುಳಿಯಿಲ್ಲದ ರೊಟ್ಟಿಯ ಪುಟ್ಟಿಯೊಳಗಿಂದ ಒಂದು ರೊಟ್ಟಿಯನ್ನೂ ಎಣ್ಣೆಯ ಒಂದು ಹೋಳಿಗೆಯನ್ನೂ ಒಂದು ಪೂರಿಯನ್ನೂ <verse eid="EXO 29:23"/><verse number="24" style="v" sid="EXO 29:24"/>ನೀನು ತೆಗೆದುಕೊಂಡು ಅವುಗಳನ್ನೆಲ್ಲಾ ಆರೋನನ ಮತ್ತು ಅವನ ಪುತ್ರರ ಕೈಗಳಿಗೆ ಕೊಟ್ಟು, ಅವರು ಯೆಹೋವ ದೇವರ ಮುಂದೆ ಅದನ್ನು ನೈವೇದ್ಯವಾಗಿ ನಿವಾಳಿಸಬೇಕು. <verse eid="EXO 29:24"/><verse number="25" style="v" sid="EXO 29:25"/>ನೀನು ಅವುಗಳನ್ನು ಅವರ ಕೈಗಳಿಂದ ತೆಗೆದುಕೊಂಡು, ಬಲಿಪೀಠದ ಮೇಲೆ ದಹನಬಲಿಯಾಗಿ ಯೆಹೋವ ದೇವರ ಮುಂದೆ ಸುವಾಸನೆಗೋಸ್ಕರ ದಹಿಸಬೇಕು. ಅದು ಯೆಹೋವ ದೇವರಿಗೆ ಬೆಂಕಿಯಿಂದ ಮಾಡಿದ ಅರ್ಪಣೆ. <verse eid="EXO 29:25"/><verse number="26" style="v" sid="EXO 29:26"/>ಇದಲ್ಲದೆ ಆರೋನನು ಪ್ರತಿಷ್ಠೆಯ ಟಗರಿನ ಎದೆಯ ಭಾಗವನ್ನು ತೆಗೆದುಕೊಂಡು, ನೈವೇದ್ಯವಾಗಿ ಯೆಹೋವ ದೇವರ ಸನ್ನಿಧಿಯಲ್ಲಿ ನಿವಾಳಿಸಬೇಕು. ಅದು ನಿನ್ನ ಪಾಲಾಗಿರುವುದು.<verse eid="EXO 29:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="EXO 29:27"/>“ನೀನು ನೈವೇದ್ಯ ಮಾಡಿದ ಎದೆಯ ಭಾಗವನ್ನೂ, ಅರ್ಪಣೆ ಮಾಡಿದ ಬಲದ ಮುಂದೊಡೆಯನ್ನೂ, ಆರೋನನ, ಅವನ ಪುತ್ರರಿಗೆ ಸಲ್ಲಬೇಕಾದ ಪ್ರತಿಷ್ಠಿತ ಟಗರಿನ ಭಾಗವನ್ನು ಪ್ರತಿಷ್ಠಿಸು. <verse eid="EXO 29:27"/><verse number="28" style="v" sid="EXO 29:28"/>ಅದು ಆರೋನನಿಗೂ ಅವನ ಪುತ್ರರಿಗೂ ಇಸ್ರಾಯೇಲರ ಕಡೆಯಿಂದ ನಿತ್ಯವಾಗಿ ಕೊಡುವ ಭಾಗವಾಗಿರಬೇಕು. ಏಕೆಂದರೆ ಅದು ನೈವೇದ್ಯವಾಗಿದೆ. ಇಸ್ರಾಯೇಲರ ಸಮಾಧಾನದ ಬಲಿಗಳ ಅರ್ಪಣೆಗಳಿಂದ ಅವರು ಯೆಹೋವ ದೇವರಿಗೆ ನೈವೇದ್ಯ ಮಾಡುವಂಥದ್ದು ಆಗಿರಬೇಕು.<verse eid="EXO 29:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="EXO 29:29"/>“ಇದಲ್ಲದೆ ಆರೋನನಿಗೆ ಇದ್ದ ಪರಿಶುದ್ಧ ವಸ್ತ್ರಗಳು ಅವನ ತರುವಾಯ ಅವನ ಪುತ್ರರಿಗೆ ಆಗಬೇಕು. ಅವರು ಅಭಿಷಿಕ್ತರಾಗಿ ಅವುಗಳನ್ನು ಧರಿಸಿಕೊಂಡು, ಪ್ರತಿಷ್ಠಿತರಾಗಬೇಕು. <verse eid="EXO 29:29"/><verse number="30" style="v" sid="EXO 29:30"/>ಅವನ ಬದಲಾಗಿ ಅವನ ಮಗನು ಯಾಜಕತ್ವವನ್ನು ನಡೆಸಿ, ಪರಿಶುದ್ಧ ಸ್ಥಳದಲ್ಲಿ ಸೇವೆಮಾಡುವಂತೆ ದೇವದರ್ಶನದ ಗುಡಾರದೊಳಗೆ ಪ್ರವೇಶಿಸಿದ ದಿನದಿಂದ ಅವುಗಳನ್ನು ಏಳು ದಿನಗಳವರೆಗೆ ತೊಟ್ಟುಕೊಳ್ಳಬೇಕು.<verse eid="EXO 29:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="EXO 29:31"/>“ಪ್ರತಿಷ್ಠೆಯ ಟಗರನ್ನು ತೆಗೆದುಕೊಂಡು ನೀನು ಅದರ ಮಾಂಸವನ್ನು ಪರಿಶುದ್ಧ ಸ್ಥಳದಲ್ಲಿ ಬೇಯಿಸಬೇಕು. <verse eid="EXO 29:31"/><verse number="32" style="v" sid="EXO 29:32"/>ಆರೋನನೂ ಅವನ ಪುತ್ರರೂ ಟಗರಿನ ಮಾಂಸವನ್ನೂ ಪುಟ್ಟಿಯಲ್ಲಿರುವ ರೊಟ್ಟಿಯನ್ನೂ ದೇವದರ್ಶನದ ಗುಡಾರದ ಬಾಗಿಲ ಬಳಿಯಲ್ಲಿ ಊಟಮಾಡಬೇಕು. <verse eid="EXO 29:32"/><verse number="33" style="v" sid="EXO 29:33"/>ಅವರನ್ನು ಪ್ರತಿಷ್ಠೆ ಮಾಡುವುದಕ್ಕೋಸ್ಕರ ಮತ್ತು ಪರಿಶುದ್ಧ ಮಾಡುವುದಕ್ಕೋಸ್ಕರ ಅವರಿಗಾಗಿ ಪ್ರಾಯಶ್ಚಿತ್ತ ಮಾಡಿದವುಗಳನ್ನು ಅವರೇ ಊಟಮಾಡಬೇಕು. ಇತರರು ಅದನ್ನು ಉಣ್ಣಬಾರದು. ಏಕೆಂದರೆ ಅವು ಪರಿಶುದ್ಧವಾದವುಗಳು. <verse eid="EXO 29:33"/><verse number="34" style="v" sid="EXO 29:34"/>ಪ್ರತಿಷ್ಠೆ ಬಲಿ ಮಾಂಸದಲ್ಲಿಯೂ ರೊಟ್ಟಿಯಲ್ಲಿಯೂ ಮರುದಿನದವರೆಗೆ ಏನಾದರೂ ಉಳಿದರೆ ಅದನ್ನು ಬೆಂಕಿಯಿಂದ ಸುಡಬೇಕು. ಅದು ಪರಿಶುದ್ಧವಾಗಿರುವುದರಿಂದ ಅದನ್ನು ಮರುದಿನ ತಿನ್ನಬಾರದು.<verse eid="EXO 29:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="EXO 29:35"/>“ಹೀಗೆ ಆರೋನನಿಗೂ ಅವನ ಪುತ್ರಿರಿಗೂ ನಾನು ನಿನಗೆ ಆಜ್ಞಾಪಿಸಿದ ಎಲ್ಲವುಗಳ ಪ್ರಕಾರಮಾಡಿ, ಏಳು ದಿವಸ ಅವರನ್ನು ಪ್ರತಿಷ್ಠೆ ಕ್ರಮವನ್ನು ಮಾಡಬೇಕು. <verse eid="EXO 29:35"/><verse number="36" style="v" sid="EXO 29:36"/>ಪ್ರತಿದಿನ ದೋಷಪರಿಹಾರಕ್ಕಾಗಿ ಒಂದು ಹೋರಿಯನ್ನು ಯಜ್ಞ ಮಾಡಬೇಕು. ಬಲಿಪೀಠವನ್ನು ಶುದ್ಧಿಮಾಡುವುದಕ್ಕಾಗಿ ಅದರ ಮೇಲೆ ಪಾಪ ಪರಿಹಾರದ ಬಲಿಯನ್ನು ಸಮರ್ಪಿಸಿ, ಅದನ್ನು ದೇವರ ಸೇವೆಗಾಗಿ ಪ್ರತಿಷ್ಠಿಸುವುದಕ್ಕಾಗಿ ಅಭಿಷೇಕಿಸಬೇಕು. <verse eid="EXO 29:36"/><verse number="37" style="v" sid="EXO 29:37"/>ಏಳು ದಿವಸ ಬಲಿಪೀಠಕ್ಕೊಸ್ಕರ ಪ್ರಾಯಶ್ಚಿತ್ತ ಮಾಡಿ, ಅದನ್ನು ಪವಿತ್ರ ಮಾಡಬೇಕು. ಆಗ ಬಲಿಪೀಠವು ಅತಿ ಪರಿಶುದ್ಧವಾಗಿರುವುದು. ಬಲಿಪೀಠವನ್ನು ಮುಟ್ಟುವುದೆಲ್ಲಾ ಪವಿತ್ರವಾಗಿರಬೇಕು.<verse eid="EXO 29:37"/></para>
  <para style="p">
    <verse number="38" style="v" sid="EXO 29:38"/>“ಬಲಿಪೀಠದ ಮೇಲೆ ನೀನು ಅರ್ಪಿಸಬೇಕಾದದ್ದು ಇದೇ: ಒಂದು ವರ್ಷದ ಎರಡು ಕುರಿಮರಿಗಳನ್ನು ಪ್ರತಿದಿನ ಬಿಟ್ಟುಬಿಡದೆ ದಹನಬಲಿಯಾಗಿ ಅರ್ಪಿಸಬೇಕು. <verse eid="EXO 29:38"/><verse number="39" style="v" sid="EXO 29:39"/>ಒಂದು ಕುರಿಮರಿಯನ್ನು ಮುಂಜಾನೆಯಲ್ಲಿಯೂ ಮತ್ತೊಂದನ್ನು ಸಾಯಂಕಾಲದಲ್ಲಿಯೂ ಸಮರ್ಪಿಸಬೇಕು. <verse eid="EXO 29:39"/><verse number="40" style="v" sid="EXO 29:40"/>ಒಂದು ಲೀಟರ್<note caller="+" style="f"><char style="fr" closed="false">29:40 </char><char style="ft" closed="false">ಹೀಬ್ರೂ ಭಾಷೆಯಲ್ಲಿ </char><char style="fqa" closed="false">1/4 ಹಿನ್, </char><char style="ft" closed="false">ಅಂದರೆ ಸುಮಾರು 1 ಲೀಟರ್</char></note> ಕುಟ್ಟಿ ತೆಗೆದ ಓಲಿವ್ ಎಣ್ಣೆಯನ್ನು ಸುಮಾರು ಒಂದುವರೆ ಕಿಲೋಗ್ರಾಂ<note caller="+" style="f"><char style="fr" closed="false">29:40 </char><char style="ft" closed="false">ಹೀಬ್ರೂ ಭಾಷೆಯಲ್ಲಿ </char><char style="fqa" closed="false">ಎಫಾದ ಹತ್ತನೇ ಭಾಗ, </char><char style="ft" closed="false">ಅಂದರೆ ಸುಮಾರು 1.6 ಲೀಟರ್</char></note> ಗೋಧಿಹಿಟ್ಟಿಗೆ ಬೆರೆಸಿ, ಒಂದು ಲೀಟರ್ ದ್ರಾಕ್ಷಾರಸವನ್ನು ಸಮರ್ಪಣೆಗಾಗಿ ಆ ಮೊದಲನೆಯ ಕುರಿಯ ಸಮೇತ ಹೋಮ ಮಾಡಬೇಕು. <verse eid="EXO 29:40"/><verse number="41" style="v" sid="EXO 29:41"/>ಇನ್ನೊಂದು ಕುರಿಮರಿಯನ್ನು ಸಂಜೆಯಲ್ಲಿ ಅರ್ಪಿಸಬೇಕು. ಬೆಳಿಗ್ಗೆ ಮಾಡಿದಂತೆಯೇ ಅದರ ಧಾನ್ಯ ಸಮರ್ಪಣೆಯನ್ನೂ ಪಾನದ ಅರ್ಪಣೆಯನ್ನೂ ಯೆಹೋವ ದೇವರಿಗೆ ಸುವಾಸನೆಯಾಗಿರುವಂತೆ ಬೆಂಕಿಯಿಂದ ಅರ್ಪಿಸಬೇಕು.<verse eid="EXO 29:41"/></para>
  <para style="p">
    <verse number="42" style="v" sid="EXO 29:42"/>“ಇದು ತಲತಲಾಂತರಗಳಲ್ಲಿಯೂ ನಿತ್ಯಕ್ಕೂ ದೇವದರ್ಶನದ ಗುಡಾರದ ಮುಂದೆ ಯೆಹೋವ ದೇವರ ಸನ್ನಿಧಿಯಲ್ಲಿ ನಾನು ನಿಮ್ಮ ಸಂಗಡ ಮಾತನಾಡುವುದಕ್ಕೆ ಸಂಧಿಸುವಲ್ಲಿ ಇದೇ ನಿತ್ಯವಾದ ದಹನಬಲಿಯಾಗಿರುವುದು. <verse eid="EXO 29:42"/><verse number="43" style="v" sid="EXO 29:43"/>ಅಲ್ಲಿ ನಾನು ಇಸ್ರಾಯೇಲರನ್ನು ಸಂಧಿಸುವೆನು. ಅದು ನನ್ನ ಮಹಿಮೆಯಿಂದ ಪವಿತ್ರವಾಗುವುದು.<verse eid="EXO 29:43"/></para>
  <para style="p">
    <verse number="44" style="v" sid="EXO 29:44"/>“ನಾನು ದೇವದರ್ಶನದ ಗುಡಾರವನ್ನೂ ಬಲಿಪೀಠವನ್ನೂ ಪರಿಶುದ್ಧ ಮಾಡುವೆನು. ಆರೋನನನ್ನೂ ಅವನ ಪುತ್ರರನ್ನೂ ನನಗೆ ಯಾಜಕ ಸೇವೆಮಾಡುವಂತೆ ಪವಿತ್ರ ಮಾಡುವೆನು. <verse eid="EXO 29:44"/><verse number="45" style="v" sid="EXO 29:45"/>ಇಸ್ರಾಯೇಲರ ಮಧ್ಯದಲ್ಲಿ ನಾನು ವಾಸಮಾಡಿ, ಅವರಿಗೆ ನಾನು ದೇವರಾಗಿರುವೆನು. <verse eid="EXO 29:45"/><verse number="46" style="v" sid="EXO 29:46"/>ಅವರ ಮಧ್ಯದಲ್ಲಿ ನಾನು ವಾಸವಾಗಿರುವದಕ್ಕಾಗಿ ಅವರನ್ನು ಈಜಿಪ್ಟ್ ದೇಶದೊಳಗಿಂದ ಹೊರಗೆ ಬರಮಾಡಿದ ಅವರ ದೇವರಾದ ಯೆಹೋವ ದೇವರು ನಾನೇ ಎಂದು ಅವರಿಗೆ ತಿಳಿಯುವುದು. ನಾನೇ ಅವರ ದೇವರಾದ ಯೆಹೋವ ದೇವರು.<verse eid="EXO 29:46"/></para>
  <chapter eid="EXO 29"/>
  <chapter number="30" style="c" sid="EXO 30"/>
  <para style="s1">ಧೂಪವೇದಿಕೆ</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 30:1"/>“ನೀನು ಜಾಲಿ ಮರದ ಕಟ್ಟಿಗೆಯಿಂದ ಧೂಪವೇದಿಯನ್ನು ಮಾಡಬೇಕು. <verse eid="EXO 30:1"/><verse number="2" style="v" sid="EXO 30:2"/>ಅದರ ಉದ್ದ ಮತ್ತು ಅಗಲ ಸುಮಾರು ನಲವತ್ತೈದು ಸೆಂಟಿಮೀಟರ್<note caller="+" style="f"><char style="fr" closed="false">30:2 </char><char style="ft" closed="false">ಅಂದರೆ, ಒಂದು ಮೊಳ</char></note>, ಅದರ ಎತ್ತರ ಸುಮಾರು ತೊಂಬತ್ತು ಸೆಂಟಿಮೀಟರ್<note caller="+" style="f"><char style="fr" closed="false">30:2 </char><char style="ft" closed="false">ಅಂದರೆ, ಎರಡು ಮೊಳ</char></note> ಇದ್ದು, ಅದು ಚಚ್ಚೌಕವಾಗಿರಬೇಕು. ಅದರ ಕೊಂಬುಗಳನ್ನು ಸಹ ಜಾಲಿ ಮರದಿಂದಲೇ ಮಾಡಬೇಕು. <verse eid="EXO 30:2"/><verse number="3" style="v" sid="EXO 30:3"/>ಅದರ ಮೇಲ್ಭಾಗವನ್ನೂ ಅದರ ಸುತ್ತಲಿನ ಬದಿಗಳನ್ನೂ ಕೊಂಬುಗಳನ್ನೂ ಶುದ್ಧ ಬಂಗಾರದಿಂದ ಹೊದಿಸಿ, ಅದರ ಸುತ್ತಲೂ ಬಂಗಾರದ ಗೋಟನ್ನು ಮಾಡಬೇಕು. <verse eid="EXO 30:3"/><verse number="4" style="v" sid="EXO 30:4"/>ಅದರ ಗೋಟಿನ ಕೆಳಗೆ ಎರಡು ಬದಿಗಿರುವ ಎರಡು ಮೂಲೆಗಳಲ್ಲಿ ಎರಡು ಬಂಗಾರದ ಬಳೆಗಳನ್ನು ಮಾಡಬೇಕು. ಇವುಗಳನ್ನು ಹೊರುವುದಕ್ಕಾಗಿ ಅವುಗಳಲ್ಲಿ ಕೋಲುಗಳನ್ನು ಸಿಕ್ಕಿಸಬೇಕು. <verse eid="EXO 30:4"/><verse number="5" style="v" sid="EXO 30:5"/>ಆ ಕೋಲುಗಳನ್ನು ಜಾಲಿ ಮರದಿಂದ ಮಾಡಿ, ಅವುಗಳನ್ನು ಬಂಗಾರದಿಂದ ಹೊದಿಸಬೇಕು. <verse eid="EXO 30:5"/><verse number="6" style="v" sid="EXO 30:6"/>ಅದನ್ನು ಒಡಂಬಡಿಕೆಯ ಮಂಜೂಷದ ಮುಂದೆ ಇರುವ ಪರದೆಯ ಮುಂದೆಯೂ ನಾನು ನಿನ್ನನ್ನು ಸಂಧಿಸುವ ಸ್ಥಳದಲ್ಲಿ ಇರುವ ಮಂಜೂಷದ ಮೇಲಿನ ಕರುಣಾಸನದ ಮುಂದೆಯೂ ಇಡಬೇಕು.<verse eid="EXO 30:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="EXO 30:7"/>“ಅದರ ಮೇಲೆ ಆರೋನನು ಪರಿಮಳ ಧೂಪವನ್ನು ಸುಡಬೇಕು. ಪ್ರತಿದಿನ ಬೆಳಿಗ್ಗೆ ಸುಡಬೇಕು. ಪ್ರತಿದಿನ ಬೆಳಿಗ್ಗೆ ದೀಪಗಳನ್ನು ಸಿದ್ಧಮಾಡುವಾಗ ಅದನ್ನು ಸುಡಬೇಕು. <verse eid="EXO 30:7"/><verse number="8" style="v" sid="EXO 30:8"/>ಆರೋನನು ಸಂಜೆ ದೀಪಗಳನ್ನು ಹಚ್ಚುವ ಸಮಯದಲ್ಲಿ ಧೂಪವೇದಿಯ ಮೇಲೆ ಧೂಪವನ್ನು ಸುಡಬೇಕು. ಅದೇ ನಿಮ್ಮ ಸಂತತಿಯವರಿಗೆ ಯೆಹೋವ ದೇವರ ಮುಂದೆ ಅರ್ಪಿಸಬೇಕಾದ ನಿತ್ಯವಾದ ಧೂಪವು. <verse eid="EXO 30:8"/><verse number="9" style="v" sid="EXO 30:9"/>ನೀವು ಅದರ ಮೇಲೆ ಬೇರೆ ಧೂಪವನ್ನಾಗಲಿ, ದಹನಬಲಿಗಳನ್ನಾಗಲಿ, ಧಾನ್ಯಗಳ ಅರ್ಪಣೆಯನ್ನಾಗಲಿ ಅರ್ಪಿಸಬಾರದು. ಇಲ್ಲವೆ ಪಾನಾರ್ಪಣೆಯನ್ನು ಅದರ ಮೇಲೆ ಹೊಯ್ಯಬಾರದು. <verse eid="EXO 30:9"/><verse number="10" style="v" sid="EXO 30:10"/>ಆರೋನನು ಮತ್ತು ಅವನ ಸಂತತಿಯವರು ವರ್ಷಕ್ಕೆ ಒಂದು ಸಾರಿ ಪಾಪ ಪರಿಹಾರದ ಬಲಿಯ ರಕ್ತದಿಂದ ಅದರ ಕೊಂಬುಗಳಿಗೆ ಹಚ್ಚಿ ಪ್ರಾಯಶ್ಚಿತ್ತ ಮಾಡಬೇಕು. ಅದು ಯೆಹೋವ ದೇವರಿಗೆ ಮಹಾಪರಿಶುದ್ಧವಾದದ್ದು.”<verse eid="EXO 30:10"/></para>
  <para style="s1">ಪ್ರಾಯಶ್ಚಿತ್ತದ ಹಣ</para>
  <para style="p">
    <verse number="11" style="v" sid="EXO 30:11"/>ಆಗ ಯೆಹೋವ ದೇವರು ಪ್ರಕಟಪಡಿಸಿ ಮೋಶೆಗೆ, <verse eid="EXO 30:11"/><verse number="12" style="v" sid="EXO 30:12"/>“ನೀನು ಇಸ್ರಾಯೇಲರನ್ನು ಎಣಿಸಲು ಜನಗಣತಿಯನ್ನು ತೆಗೆದುಕೊಂಡಾಗ ಪ್ರತಿಯೊಬ್ಬನು ತನ್ನ ಜೀವನದ ವಿಮೋಚನೆಯ ಕ್ರಯವನ್ನು ಯೆಹೋವ ದೇವರಿಗೆ ಕೊಡಬೇಕು. ಈ ರೀತಿ ಮಾಡಿದಲ್ಲಿ ಅವರನ್ನು ಎಣಿಸುವಾಗ ಅವರಲ್ಲಿ ವ್ಯಾಧಿ ಉಂಟಾಗುವುದಿಲ್ಲ. <verse eid="EXO 30:12"/><verse number="13" style="v" sid="EXO 30:13"/>ಲೆಕ್ಕಿತರಾದವರಲ್ಲಿ ಸೇರುವ ಪ್ರತಿಯೊಬ್ಬ ಮನುಷ್ಯನು ಕೊಡಬೇಕಾದದ್ದು ಏನೆಂದರೆ ಶೆಕೆಲಿಗೆ<note caller="+" style="f"><char style="fr" closed="false">30:13 </char><char style="ft" closed="false">ಸುಮಾರು ಒಂದು ಶೆಕೆಲ್ ಹನ್ನೊಂದು ಗ್ರಾಂ</char></note> ಇಪ್ಪತ್ತು ಗೇರಾಗಳ<note caller="+" style="f"><char style="fr" closed="false">30:13 </char><char style="ft" closed="false">ಸುಮಾರು ಒಂದು ಗೇರಾ ಆರುನೂರು ಗ್ರಾಂ</char></note> ಪ್ರಕಾರವಾಗಿ ಪರಿಶುದ್ಧ ಆಲಯದ ಶೆಕೆಲಿನ ಮೇರೆಗೆ ಅರ್ಧ ಶೆಕೆಲ್ ಕೊಡಬೇಕು. ಅರ್ಧ ಶೆಕೆಲ್ ಯೆಹೋವ ದೇವರಿಗೆ ಅರ್ಪಿಸುವ ಕಾಣಿಕೆಯಾಗಿರಬೇಕು. <verse eid="EXO 30:13"/><verse number="14" style="v" sid="EXO 30:14"/>ಲೆಕ್ಕಿತರಾದವರಲ್ಲಿ ಇಪ್ಪತ್ತು ವರ್ಷದವರೂ ಅದಕ್ಕೂ ಹೆಚ್ಚು ಪ್ರಾಯವುಳ್ಳವರೂ ಯೆಹೋವ ದೇವರಿಗೆ ಕಾಣಿಕೆಯನ್ನು ಕೊಡಬೇಕು. <verse eid="EXO 30:14"/><verse number="15" style="v" sid="EXO 30:15"/>ನಿಮ್ಮ ಜೀವನದ ಪ್ರಾಯಶ್ಚಿತ್ತಕ್ಕೆ ಯೆಹೋವ ದೇವರಿಗೆ ಅರ್ಪಿಸುವ ಕಾಣಿಕೆಯನ್ನು ಕೊಡುವುದರಲ್ಲಿ ಐಶ್ವರ್ಯವಂತರು ಅರ್ಧ ಶೇಕೆಲಿಗಿಂತ ಹೆಚ್ಚು ಕೊಡಬಾರದು. ಬಡವನು ಕಡಿಮೆ ಕೊಡಬಾರದು. <verse eid="EXO 30:15"/><verse number="16" style="v" sid="EXO 30:16"/>ಪ್ರಾಯಶ್ಚಿತ್ತದ ಹಣವನ್ನು ಇಸ್ರಾಯೇಲರಿಂದ ತೆಗೆದುಕೊಂಡು ದೇವದರ್ಶನದ ಗುಡಾರದ ಕೆಲಸಕ್ಕಾಗಿ ಪ್ರತ್ಯೇಕಿಸಬೇಕು. ಇದೇ ಯೆಹೋವ ದೇವರ ಮುಂದೆ ಇಸ್ರಾಯೇಲರಿಗೆ ಜ್ಞಾಪಕಾರ್ಥಕ್ಕಾಗಿಯೂ ಅವರ ಪ್ರಾಯಶ್ಚಿತ್ತಕ್ಕಾಗಿಯೂ ಇರುವುದು,” ಎಂದರು.<verse eid="EXO 30:16"/></para>
  <para style="s1">ತೊಳೆಯುವುದಕ್ಕೆ ಬೋಗುಣಿ</para>
  <para style="p">
    <verse number="17" style="v" sid="EXO 30:17"/>ಯೆಹೋವ ದೇವರು ಮೋಶೆಗೆ, <verse eid="EXO 30:17"/><verse number="18" style="v" sid="EXO 30:18"/>“ತೊಳೆದುಕೊಳ್ಳುವದಕ್ಕಾಗಿ ಕಂಚಿನ ಬೋಗುಣಿಯನ್ನು ಮಾಡಿಸಿ ಅದಕ್ಕೆ ಕಂಚಿನ ಪೀಠವನ್ನೂ ಮಾಡಿಸಿ, ಅದನ್ನು ದೇವದರ್ಶನದ ಗುಡಾರ ಮತ್ತು ಬಲಿಪೀಠದ ಮಧ್ಯದಲ್ಲಿಟ್ಟು, ಅದರಲ್ಲಿ ನೀರನ್ನು ತುಂಬಿಸಿಡಬೇಕು. <verse eid="EXO 30:18"/><verse number="19" style="v" sid="EXO 30:19"/>ಏಕೆಂದರೆ ಆರೋನನೂ ಅವನ ಪುತ್ರರೂ ಅದರಲ್ಲಿ ಕೈಕಾಲುಗಳನ್ನು ತೊಳೆಯಬೇಕು. <verse eid="EXO 30:19"/><verse number="20" style="v" sid="EXO 30:20"/>ಅವರು ದೇವದರ್ಶನದ ಗುಡಾರದಲ್ಲಿ ಪ್ರವೇಶಿಸುವಾಗ ಸೇವೆ ಮಾಡುವುದಕ್ಕೂ, ಬೆಂಕಿಯಿಂದ ಯೆಹೋವ ದೇವರಿಗೆ ದಹನಬಲಿಯನ್ನು ಅರ್ಪಿಸುವುದಕ್ಕೂ ಬಲಿಪೀಠದ ಬಳಿಗೆ ಬರುವಾಗ ಅವರು ಸಾಯದ ಹಾಗೆ ನೀರಿನಲ್ಲಿ ತೊಳೆದುಕೊಳ್ಳಬೇಕು. <verse eid="EXO 30:20"/><verse number="21" style="v" sid="EXO 30:21"/>ಅವರು ಸಾಯದ ಹಾಗೆ ತಮ್ಮ ಕೈಕಾಲುಗಳನ್ನು ತೊಳೆದುಕೊಳ್ಳಬೇಕು. ಇದೇ ಅವನಿಗೂ ಅವನ ಸಂತತಿಯವರಿಗೂ ತಲತಲಾಂತರಗಳಲ್ಲಿ ನಿತ್ಯವಾದ ಕಟ್ಟಳೆಯಾಗಿರಬೇಕು,” ಎಂದರು.<verse eid="EXO 30:21"/></para>
  <para style="s1">ಅಭಿಷೇಕ ತೈಲ</para>
  <para style="p">
    <verse number="22" style="v" sid="EXO 30:22"/>ಯೆಹೋವ ದೇವರು ಮೋಶೆಗೆ, <verse eid="EXO 30:22"/><verse number="23" style="v" sid="EXO 30:23"/>“ಉತ್ತಮವಾದ ತೈಲಗಳನ್ನು ಆರು ಕಿಲೋಗ್ರಾಂ ಸ್ವಚ್ಛವಾದ ರಕ್ತಬೋಳವು, ಇದರ ಅರ್ಧದಷ್ಟು ಮೂರು ಕಿಲೋಗ್ರಾಂ ಸುಗಂಧವಾದ ಲವಂಗಚಕ್ಕೆಯನ್ನು ಮತ್ತು ಮೂರು ಕಿಲೋಗ್ರಾಂ ಸುಗಂಧವಾದ ಬಜೆಯನ್ನು, <verse eid="EXO 30:23"/><verse number="24" style="v" sid="EXO 30:24"/>ಆರು ಕಿಲೋಗ್ರಾಂ ದಾಲ್ಚಿನ್ನಿಯನ್ನು ಪರಿಶುದ್ಧಸ್ಥಳದ ಅಳತೆಯ ಮೇರೆಗೆ ಇವುಗಳನ್ನು ನೀನು ತೆಗೆದುಕೊಳ್ಳಬೇಕು. ಸುಮಾರು ನಾಲ್ಕು ಲೀಟರಷ್ಟು<note caller="+" style="f"><char style="fr" closed="false">30:24 </char><char style="ft" closed="false">ಹೀಬ್ರೂ ಭಾಷೆಯಲ್ಲಿ ಒಂದು </char><char style="fqa" closed="false">ಹಿನ್, </char><char style="ft" closed="false">ಅಂದರೆ ಸುಮಾರು 4 ಲೀಟರ್</char></note> ಓಲಿವ್ ಎಣ್ಣೆಯನ್ನು ಸಹ ತೆಗೆದುಕೊಂಡು, <verse eid="EXO 30:24"/><verse number="25" style="v" sid="EXO 30:25"/>ಅದರಿಂದ ಸುಗಂಧಕಾರನ ವಿದ್ಯೆಯ ಪ್ರಕಾರ ಪರಿಶುದ್ಧವಾದ ಅಭಿಷೇಕ ತೈಲವನ್ನು ಮಾಡು. ಇದು ಪರಿಶುದ್ಧವಾದ ಅಭಿಷೇಕದ ತೈಲವಾಗಿರುವುದು. <verse eid="EXO 30:25"/><verse number="26" style="v" sid="EXO 30:26"/>ಅದರಿಂದ ಸಭೆಯ ಗುಡಾರವನ್ನೂ ಒಡಂಬಡಿಕೆಯ ಮಂಜೂಷವನ್ನೂ <verse eid="EXO 30:26"/><verse number="27" style="v" sid="EXO 30:27"/>ಮೇಜನ್ನೂ ಅದರ ಎಲ್ಲಾ ಸಲಕರಣೆಗಳನ್ನೂ ದೀಪಸ್ತಂಭವನ್ನೂ ಅದರ ಎಲ್ಲಾ ಸಲಕರಣೆಗಳನ್ನೂ ಧೂಪದ ವೇದಿಯನ್ನೂ <verse eid="EXO 30:27"/><verse number="28" style="v" sid="EXO 30:28"/>ದಹನಬಲಿಯ ಪೀಠವನ್ನೂ ಅದರ ಎಲ್ಲಾ ಸಲಕರಣೆಗಳನ್ನೂ ಗಂಗಾಳವನ್ನೂ, ಅದರ ಕಾಲುಗಳನ್ನೂ ಅಭಿಷೇಕಿಸು. <verse eid="EXO 30:28"/><verse number="29" style="v" sid="EXO 30:29"/>ಅವು ಮಹಾಪರಿಶುದ್ಧವಾಗುವಂತೆ ಅವುಗಳನ್ನು ಶುದ್ಧಮಾಡು. ಅವುಗಳನ್ನು ಮುಟ್ಟುವುದೆಲ್ಲವೂ ಪರಿಶುದ್ಧವಾಗಿರಬೇಕು.<verse eid="EXO 30:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="EXO 30:30"/>“ಆರೋನನನ್ನೂ, ಅವನ ಪುತ್ರರನ್ನೂ ಅಭಿಷೇಕಿಸಿ, ಅವರು ನನಗೆ ಯಾಜಕ ಸೇವೆಮಾಡುವಂತೆ ಅವರನ್ನು ಪ್ರತಿಷ್ಠೆ ಮಾಡು, ಎಂದರು. <verse eid="EXO 30:30"/><verse number="31" style="v" sid="EXO 30:31"/>ನೀನು ಇಸ್ರಾಯೇಲರಿಗೆ: ‘ತಲತಲಾಂತರಗಳಲ್ಲಿ ಇದು ನನಗೆ ಪರಿಶುದ್ಧವಾದ ಅಭಿಷೇಕ ಎಣ್ಣೆಯಾಗಿರಬೇಕು. <verse eid="EXO 30:31"/><verse number="32" style="v" sid="EXO 30:32"/>ಇದನ್ನು ಮನುಷ್ಯರ ಮೇಲೆ ಹೊಯ್ಯಬಾರದು. ಇದರ ಮಾದರಿಯಂತೆ ಅಥವಾ ಇದಕ್ಕೆ ಸಮಾನವಾದದ್ದನ್ನು ಮಾಡಬಾರದು. ಇದು ಪರಿಶುದ್ಧವಾದದ್ದು. ನೀವು ಸಹ ಇದನ್ನು ಪರಿಶುದ್ಧವೆಂದು ತಿಳಿದುಕೊಳ್ಳಬೇಕು. <verse eid="EXO 30:32"/><verse number="33" style="v" sid="EXO 30:33"/>ಇದರ ಹಾಗೆ ತೈಲ ಮಾಡುವವನೂ ಯಾಜಕನಲ್ಲದವನ ಮೇಲೆ ಇದನ್ನು ಹಚ್ಚುವವನನ್ನು ಸ್ವಜನರೊಳಗಿಂದ ತೆಗೆದುಹಾಕಬೇಕು,’ ಎಂದು ಹೇಳು,” ಎಂದರು.<verse eid="EXO 30:33"/></para>
  <para style="s1">ಪರಿಮಳ ದ್ರವ್ಯಗಳು</para>
  <para style="p">
    <verse number="34" style="v" sid="EXO 30:34"/>ಯೆಹೋವ ದೇವರು ಮೋಶೆಗೆ, “ನೀನು ಹಾಲು ಮಡ್ಡಿ, ಗುಗ್ಗಲ ಹಾಗೂ ಗಂಧದ ಚಕ್ಕೆ ಎಂಬ ಪರಿಮಳಗಳನ್ನೂ ಶುದ್ಧವಾದ ಸಾಮ್ರಾಣಿಯನ್ನೂ ತೆಗೆದುಕೋ. ಅವು ಸಮತೂಕವಾಗಿರಲಿ. <verse eid="EXO 30:34"/><verse number="35" style="v" sid="EXO 30:35"/>ಅದನ್ನು ಸುಗಂಧ ತೈಲ ಮಾಡುವವರ ವಿದ್ಯೆಯ ಪ್ರಕಾರ ಬೆರಸಿ, ಶುದ್ಧವಾದ ಮತ್ತು ಪವಿತ್ರವಾದ ತೈಲವನ್ನು ಮಾಡಬೇಕು. <verse eid="EXO 30:35"/><verse number="36" style="v" sid="EXO 30:36"/>ಅದರಲ್ಲಿ ಸ್ವಲ್ಪ ಪುಡಿಮಾಡಿ, ದೇವದರ್ಶನದ ಗುಡಾರದಲ್ಲಿ ನಾನು ನಿನ್ನನ್ನು ಸಂಧಿಸುವ ಸ್ಥಳದಲ್ಲಿ ಒಡಂಬಡಿಕೆಯ ಮಂಜೂಷದ ಮುಂದೆ ಇಡು. ಅದು ನಿಮಗೆ ಮಹಾಪರಿಶುದ್ಧವಾಗಿರಲಿ. <verse eid="EXO 30:36"/><verse number="37" style="v" sid="EXO 30:37"/>ನೀನು ಮಾಡುವ ಧೂಪದ ಮಾದರಿಯಂತೆ ನಿಮಗೋಸ್ಕರ ಮಾಡಿಕೊಳ್ಳಬಾರದು. ಅದನ್ನು ಯೆಹೋವ ದೇವರಿಗೆ ಪವಿತ್ರವೆಂದು ಪರಿಗಣಿಸಬೇಕು. <verse eid="EXO 30:37"/><verse number="38" style="v" sid="EXO 30:38"/>ಸುವಾಸನೆಗಾಗಿ ಅದನ್ನು ಮಾಡಿಕೊಳ್ಳುವವನನ್ನು ಅವನ ಕುಲದಿಂದ ಬಹಿಷ್ಕರಿಸಬೇಕು.”<verse eid="EXO 30:38"/></para>
  <chapter eid="EXO 30"/>
  <chapter number="31" style="c" sid="EXO 31"/>
  <para style="s1">ಬೆಚಲಯೇಲ್ ಹಾಗೂ ಒಹೊಲಿಯಾಬ</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 31:1"/>ಯೆಹೋವ ದೇವರು ಮೋಶೆಯ ಸಂಗಡ ಮಾತನಾಡಿ ಅವನಿಗೆ, <verse eid="EXO 31:1"/><verse number="2" style="v" sid="EXO 31:2"/>“ನೋಡು, ನಾನು ಯೆಹೂದ ಕುಲದವನಾದ ಹೂರನ ಮೊಮ್ಮಗನೂ ಊರಿಯನ ಮಗನೂ ಆದ ಬೆಚಲಯೇಲ್ ಎಂಬವನನ್ನು ಗುರುತಿಸಿ ನಾನು ಆರಿಸಿಕೊಂಡಿದ್ದೇನೆ. <verse eid="EXO 31:2"/><verse number="3" style="v" sid="EXO 31:3"/>ನಾನು ಅವನನ್ನು ದೇವರ ಆತ್ಮನಿಂದಲೂ ಜ್ಞಾನದಿಂದಲೂ ತಿಳುವಳಿಕೆಯಿಂದಲೂ ವಿವೇಕದಿಂದಲೂ ಎಲ್ಲಾ ವಿಧವಾದ ಕೌಶಲ್ಯದಿಂದಲೂ ತುಂಬಿಸಿದ್ದೇನೆ. <verse eid="EXO 31:3"/><verse number="4" style="v" sid="EXO 31:4"/>ಅವನು ಚಿನ್ನ, ಬೆಳ್ಳಿ, ಕಂಚಿನಲ್ಲಿ ಕಲಾತ್ಮಕವಾದ ವಿನ್ಯಾಸಗಳ ಕೆಲಸವನ್ನು ಮಾಡುವುದಕ್ಕೂ, <verse eid="EXO 31:4"/><verse number="5" style="v" sid="EXO 31:5"/>ರತ್ನಗಳಲ್ಲಿ ಕೆತ್ತನೆಯನ್ನೂ ಮರದಲ್ಲಿ ಕೆತ್ತನೆಯನ್ನೂ ಸಕಲ ವಿಧವಾದ ಕೌಶಲ್ಯದ ಕೆಲಸವನ್ನು ಬಲ್ಲವನಾಗಿರುವನು. <verse eid="EXO 31:5"/><verse number="6" style="v" sid="EXO 31:6"/>ಇಗೋ, ನಾನೇ ಅವನೊಂದಿಗೆ ದಾನನ ಕುಲದವನಾದ ಅಹೀಸಾಮಾಕನ ಮಗನಾದ ಒಹೋಲಿಯಾಬನನ್ನು ನೇಮಿಸಿದ್ದೇನೆ.</para>
  <para style="b" vid="EXO 31:6"/>
  <para style="li4" vid="EXO 31:6">“ನಾನು ನಿನಗೆ ಆಜ್ಞಾಪಿಸಿದ್ದೆಲ್ಲವನ್ನು ಮಾಡುವುದಕ್ಕೆ ಜಾಣರಾದವರೆಲ್ಲರ ಹೃದಯಗಳಲ್ಲಿ ಯಾವ ಕೆಲಸವನ್ನಾದರೂ ಕಲ್ಪಿಸಿ ಮಾಡುವದಕ್ಕೆ ಜ್ಞಾನವನ್ನು ಅನುಗ್ರಹಿಸಿದ್ದೇನೆ.<verse eid="EXO 31:6"/></para>
  <para style="b"/>
  <para style="li1">
    <verse number="7" style="v" sid="EXO 31:7"/>“ದೇವದರ್ಶನದ ಗುಡಾರ,</para>
  <para style="li1" vid="EXO 31:7">ಒಡಂಬಡಿಕೆಯ ಮಂಜೂಷ, ಅದರ ಮೇಲಿರುವ ಕರುಣಾಸನ,</para>
  <para style="li1" vid="EXO 31:7">ಗುಡಾರದ ಎಲ್ಲಾ ಉಪಕರಣಗಳು,<verse eid="EXO 31:7"/></para>
  <para style="li2">
    <verse number="8" style="v" sid="EXO 31:8"/>ಮೇಜು ಅದರ ಉಪಕರಣಗಳು,</para>
  <para style="li2" vid="EXO 31:8">ಶುದ್ಧ ಬಂಗಾರದ ದೀಪಸ್ತಂಭ, ಅದರ ಎಲ್ಲಾ ಉಪಕರಣಗಳು,</para>
  <para style="li2" vid="EXO 31:8">ಧೂಪವೇದಿ, ಬಲಿಪೀಠ,<verse eid="EXO 31:8"/></para>
  <para style="li2">
    <verse number="9" style="v" sid="EXO 31:9"/>ದಹನಬಲಿಪೀಠದ ಎಲ್ಲಾ ಉಪಕರಣಗಳು,</para>
  <para style="li2" vid="EXO 31:9">ಗಂಗಾಳ, ಅದರ ಕಾಲು,<verse eid="EXO 31:9"/></para>
  <para style="li1">
    <verse number="10" style="v" sid="EXO 31:10"/>ಯಾಜಕನಾದ ಆರೋನನ ಕಲಾತ್ಮಕವಾಗಿ ನೇಯ್ದ ಸೇವಾವಸ್ತ್ರಗಳು,</para>
  <para style="li2" vid="EXO 31:10">ಪರಿಶುದ್ಧ ವಸ್ತ್ರಗಳು,</para>
  <para style="li2" vid="EXO 31:10">ಯಾಜಕನ ಕೆಲಸ ಮಾಡುವುದಕ್ಕೆ ಅವನ ಮಕ್ಕಳ ವಸ್ತ್ರಗಳು,<verse eid="EXO 31:10"/></para>
  <para style="li1">
    <verse number="11" style="v" sid="EXO 31:11"/>ಅಭಿಷೇಕಿಸುವ ತೈಲ, ಪರಿಶುದ್ಧ ಸ್ಥಳಕ್ಕೋಸ್ಕರವಿರುವ ಪರಿಮಳ ಧೂಪ.</para>
  <para style="b" vid="EXO 31:11"/>
  <para style="li4" vid="EXO 31:11">“ಇವುಗಳನ್ನೆಲ್ಲಾ ನಾನು ನಿನಗೆ ಆಜ್ಞಾಪಿಸಿದಂತೆಯೇ ಅವರು ಮಾಡುವರು,” ಎಂದರು.<verse eid="EXO 31:11"/></para>
  <para style="s1">ಸಬ್ಬತ್ ದಿನ</para>
  <para style="p">
    <verse number="12" style="v" sid="EXO 31:12"/>ಯೆಹೋವ ದೇವರು ಮೋಶೆಯೊಂದಿಗೆ ಮಾತನಾಡಿ, <verse eid="EXO 31:12"/><verse number="13" style="v" sid="EXO 31:13"/>“ನೀನು ಇಸ್ರಾಯೇಲರೊಂದಿಗೆ ಮಾತನಾಡಿ, ‘ನಿಶ್ಚಯವಾಗಿ ನೀವು ನನ್ನ ವಿಶ್ರಾಂತಿಯ ದಿನವನ್ನು ಕೈಗೊಳ್ಳಬೇಕು. ಏಕೆಂದರೆ ನಿಮ್ಮನ್ನು ಪರಿಶುದ್ಧ ಮಾಡುವ ಯೆಹೋವ ದೇವರು ನಾನೇ ಎಂದು ನೀವು ತಿಳಿಯುವಂತೆ ಇದೇ ನನಗೂ, ನಿಮಗೂ, ನಿಮ್ಮ ಸಂತತಿಯವರಿಗೂ ಗುರುತಾಗಿರುವುದು.<verse eid="EXO 31:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="EXO 31:14"/>“ ‘ಹೀಗಿರುವುದರಿಂದ ನೀವು ಸಬ್ಬತ್ ದಿನವನ್ನು ಕೈಗೊಳ್ಳಬೇಕು. ಏಕೆಂದರೆ ಅದು ನಿಮಗೆ ಪರಿಶುದ್ಧವಾದದ್ದು. ಅದನ್ನು ಅಪವಿತ್ರ ಮಾಡುವ ಪ್ರತಿಯೊಬ್ಬನು ಸಾಯಲೇಬೇಕು. ಆ ದಿನದಲ್ಲಿ ಯಾರಾದರೂ ಕೆಲಸ ಮಾಡಿದರೆ, ಅವರನ್ನು ನಿಮ್ಮ ಜನರೊಳಗಿಂದ ತೆಗೆದುಹಾಕಬೇಕು. <verse eid="EXO 31:14"/><verse number="15" style="v" sid="EXO 31:15"/>ಆರು ದಿವಸ ಕೆಲಸ ಮಾಡಬೇಕು. ಆದರೆ ಏಳನೆಯ ದಿನವು ಯೆಹೋವ ದೇವರಿಗೆ ಪರಿಶುದ್ಧವಾದ ಸಬ್ಬತ್ ದಿನ. ಆ ಸಬ್ಬತ್ ದಿನದಲ್ಲಿ ಕೆಲಸ ಮಾಡುವವರೆಲ್ಲಾ ಸಾಯಲೇಬೇಕು. <verse eid="EXO 31:15"/><verse number="16" style="v" sid="EXO 31:16"/>ಹೀಗಿರಲಾಗಿ ಇಸ್ರಾಯೇಲರು ತಮ್ಮ ತಲತಲಾಂತರಗಳಲ್ಲಿ ನಿತ್ಯ ಒಡಂಬಡಿಕೆಯಾಗಿ ಆಚರಿಸುವಂತೆ ಸಬ್ಬತ್ ದಿನವನ್ನು ಕೈಗೊಳ್ಳಬೇಕು. <verse eid="EXO 31:16"/><verse number="17" style="v" sid="EXO 31:17"/>ನನಗೂ, ಇಸ್ರಾಯೇಲರಿಗೂ ಇದೇ ಶಾಶ್ವತವಾದ ಗುರುತು. ಏಕೆಂದರೆ ಆರು ದಿವಸಗಳಲ್ಲಿ ಯೆಹೋವ ದೇವರು ಆಕಾಶವನ್ನೂ, ಭೂಮಿಯನ್ನೂ ಉಂಟುಮಾಡಿ ಏಳನೆಯ ದಿನದಲ್ಲಿ ಕೆಲಸ ನಿಲ್ಲಿಸಿ, ವಿಶ್ರಮಿಸಿಕೊಂಡರು ಎಂದು ಹೇಳು,’ ” ಎಂದರು.<verse eid="EXO 31:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="EXO 31:18"/>ಯೆಹೋವ ದೇವರು ಮೋಶೆಯ ಸಂಗಡ ಸೀನಾಯಿ ಬೆಟ್ಟದಲ್ಲಿ ಮಾತನಾಡಿ ಮುಗಿಸಿದ ಮೇಲೆ, ಅವನಿಗೆ ಸಾಕ್ಷಿಯ ಎರಡು ಹಲಗೆಗಳನ್ನೂ ದೇವರು ಬೆರಳಿನಿಂದ ಬರೆದ ಕಲ್ಲಿನ ಹಲಗೆಗಳನ್ನೂ ಕೊಟ್ಟನು.<verse eid="EXO 31:18"/></para>
  <chapter eid="EXO 31"/>
  <chapter number="32" style="c" sid="EXO 32"/>
  <para style="s1">ಚಿನ್ನದ ಕರು</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 32:1"/>ಮೋಶೆಯು ಬೆಟ್ಟದಿಂದ ಇಳಿಯದೆ ತಡಮಾಡಿದ್ದನ್ನು ಇಸ್ರಾಯೇಲರು ನೋಡಿದಾಗ, ಅವರು ಆರೋನನ ಬಳಿಗೆ ಕೂಡಿಬಂದು ಅವನಿಗೆ, “ನೀನು ಎದ್ದು ನಮ್ಮನ್ನು ಮುನ್ನಡೆಸಿಕೊಂಡು ಹೋಗುವ ದೇವರುಗಳನ್ನು ನಮಗಾಗಿ ಮಾಡು. ಏಕೆಂದರೆ ಈಜಿಪ್ಟ್ ದೇಶದೊಳಗಿಂದ ನಮ್ಮನ್ನು ಕರೆದುಕೊಂಡು ಬಂದ ಮನುಷ್ಯನಾದ ಈ ಮೋಶೆಗೆ ಏನಾಯಿತೋ ನಮಗೆ ತಿಳಿಯದು,” ಎಂದರು.<verse eid="EXO 32:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="EXO 32:2"/>ಅದಕ್ಕೆ ಆರೋನನು ಅವರಿಗೆ, “ನಿಮ್ಮ ಹೆಂಡತಿಯರ ಮತ್ತು ನಿಮ್ಮ ಪುತ್ರಪುತ್ರಿಯರ ಕಿವಿಗಳಲ್ಲಿರುವ ಚಿನ್ನದ ವಾಲೆಗಳನ್ನು ಬಿಚ್ಚಿ ನನ್ನ ಬಳಿಗೆ ತನ್ನಿರಿ,” ಎಂದನು. <verse eid="EXO 32:2"/><verse number="3" style="v" sid="EXO 32:3"/>ಆಗ ಜನರೆಲ್ಲರೂ ತಮ್ಮ ಕಿವಿಗಳಲ್ಲಿದ್ದ ಚಿನ್ನದ ವಾಲೆಗಳನ್ನು ಕಿತ್ತು ಆರೋನನ ಬಳಿಗೆ ತಂದರು. <verse eid="EXO 32:3"/><verse number="4" style="v" sid="EXO 32:4"/>ಅವನು ಅವುಗಳನ್ನು ಅವರ ಕೈಗಳಿಂದ ತೆಗೆದುಕೊಂಡು, ಉಳಿಯಿಂದ ರೂಪಿಸಿ, ಎರಕ ಹೊಯ್ದು, ಕರುವಾಗಿ ಮಾಡಿದನು. ಆಗ ಅವರು, “ಇಸ್ರಾಯೇಲರೇ, ನಿಮ್ಮನ್ನು ಈಜಿಪ್ಟ್ ದೇಶದೊಳಗಿನಿಂದ ಬರಮಾಡಿದ ನಿಮ್ಮ ದೇವರುಗಳು ಇವೇ,” ಎಂದರು.<verse eid="EXO 32:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="EXO 32:5"/>ಆರೋನನು ಅದನ್ನು ನೋಡಿ ಅದರ ಮುಂದೆ ಬಲಿಪೀಠವನ್ನು ಕಟ್ಟಿದನು. “ನಾಳೆ ಯೆಹೋವ ದೇವರಿಗೆ ಹಬ್ಬ,” ಎಂದು ಪ್ರಕಟಿಸಿದನು. <verse eid="EXO 32:5"/><verse number="6" style="v" sid="EXO 32:6"/>ಮರುದಿನ ಬೆಳಿಗ್ಗೆ ಜನರು ಎದ್ದು, ದಹನಬಲಿಗಳನ್ನೂ, ಸಮಾಧಾನ ಬಲಿಗಳನ್ನೂ ಸಮರ್ಪಿಸಿದರು. ಬಳಿಕ ತಿನ್ನಲೂ ಕುಡಿಯಲೂ ಕುಳಿತುಕೊಂಡರು, ಆಮೇಲೆ ಎದ್ದು ಕುಣಿದಾಡಿದರು.<verse eid="EXO 32:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="EXO 32:7"/>ಆಗ ಯೆಹೋವ ದೇವರು ಮೋಶೆಗೆ, “ನೀನು ಇಳಿದು ಹೋಗು ಏಕೆಂದರೆ ನೀನು ಈಜಿಪ್ಟ್ ದೇಶದೊಳಗಿಂದ ಬರಮಾಡಿದ ನಿನ್ನ ಜನರು ತಮ್ಮನ್ನು ಕೆಡಿಸಿಕೊಂಡಿದ್ದಾರೆ. <verse eid="EXO 32:7"/><verse number="8" style="v" sid="EXO 32:8"/>ನಾನು ಅವರಿಗೆ ಆಜ್ಞಾಪಿಸಿದ ಮಾರ್ಗವನ್ನು ಬೇಗನೆ ಬಿಟ್ಟು, ತಮಗೆ ಎರಕ ಹೊಯ್ದ ಕರುವನ್ನು ಮಾಡಿಕೊಂಡು, ಅದನ್ನು ಆರಾಧಿಸುತ್ತಾ, ಅದಕ್ಕೆ ಬಲಿ ಅರ್ಪಿಸಿ, ‘ಇಸ್ರಾಯೇಲರೇ, ನಿಮ್ಮನ್ನು ಈಜಿಪ್ಟ್ ದೇಶದೊಳಗಿಂದ ಬರಮಾಡಿದ ನಿಮ್ಮ ದೇವರುಗಳು ಇವುಗಳೇ,’ ಎಂದು ಹೇಳುತ್ತಿದ್ದಾರೆ.”<verse eid="EXO 32:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="EXO 32:9"/>ಇದಲ್ಲದೆ ಯೆಹೋವ ದೇವರು ಮೋಶೆಗೆ, “ನಾನು ಈ ಜನರನ್ನು ನೋಡಿದ್ದೇನೆ. ಇವರು ಹಟಮಾರಿ ಜನರೇ, <verse eid="EXO 32:9"/><verse number="10" style="v" sid="EXO 32:10"/>ಹೀಗಿರುವುದರಿಂದ ನನ್ನ ಕೋಪಾಗ್ನಿಯು ಅವರ ಮೇಲೆ ಉರಿದು ಅವರನ್ನು ದಹಿಸಿಬಿಡುವಂತೆ ನನ್ನನ್ನು ಬಿಡು. ತರುವಾಯ ನಾನು ನಿನ್ನನ್ನು ದೊಡ್ಡ ಜನಾಂಗವಾಗುವಂತೆ ಮಾಡುವೆನು,” ಎಂದರು.<verse eid="EXO 32:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="EXO 32:11"/>ಅದಕ್ಕೆ ಮೋಶೆ, ತನ್ನ ದೇವರಾದ ಯೆಹೋವ ದೇವರ ಸನ್ನಿಧಿಯಲ್ಲಿ ಬೇಡಿಕೊಂಡು ಹೇಳಿದ್ದೇನೆಂದರೆ, “ಯೆಹೋವ ದೇವರೇ, ನೀವು ಮಹಾಶಕ್ತಿಯಿಂದಲೂ, ಬಲವುಳ್ಳ ಕೈಯಿಂದಲೂ ಈಜಿಪ್ಟ್ ದೇಶದೊಳಗಿಂದ ಹೊರಗೆ ಬರಮಾಡಿದ ನಿಮ್ಮ ಜನರ ಮೇಲೆ ಏಕೆ ನಿಮ್ಮ ಕೋಪವು ಉರಿಯುವುದು? <verse eid="EXO 32:11"/><verse number="12" style="v" sid="EXO 32:12"/>‘ಕೇಡಿನ ನಿಮಿತ್ತವೂ ಬೆಟ್ಟಗಳಲ್ಲಿ ಅವರನ್ನು ಸಾಯಿಸಿ, ಭೂಮಿಯ ಮೇಲಿನಿಂದ ಅವರನ್ನು ಅಳಿಸಿಬಿಡುವುದಕ್ಕೂ, ದೇವರು ಅವರನ್ನು ಹೊರಗೆ ಬರಮಾಡಿದ್ದಾರೆ,’ ಎಂದು ಈಜಿಪ್ಟಿನವರು ಏಕೆ ಹೇಳಬೇಕು? ತಾವು ಕೋಪಾಗ್ನಿಯನ್ನು ಬಿಟ್ಟು ತಿರುಗಿಕೊಳ್ಳಿ. ನಿಮ್ಮ ಜನರಿಗೆ ವಿರೋಧವಾದ ಈ ಕೇಡಿನ ವಿಷಯದಲ್ಲಿ ತಮ್ಮ ಮನಸ್ಸನ್ನು ಬದಲಾಯಿಸಿರಿ. <verse eid="EXO 32:12"/><verse number="13" style="v" sid="EXO 32:13"/>ಆ ನಿಮ್ಮ ಸೇವಕರಾದ ಅಬ್ರಹಾಮನನ್ನೂ, ಇಸಾಕನನ್ನೂ, ಇಸ್ರಾಯೇಲನನ್ನೂ ಜ್ಞಾಪಕಮಾಡಿಕೊಳ್ಳಿರಿ, ಯಾರಿಗೆ ನೀವು ಆಣೆಯಿಟ್ಟು ಪ್ರಮಾಣಮಾಡಿ: ‘ಆಕಾಶದ ನಕ್ಷತ್ರಗಳ ಹಾಗೆ ನಿನ್ನ ಸಂತತಿಯನ್ನು ಹೆಚ್ಚಿಸಿ, ನಾನು ಹೇಳಿದ ಈ ದೇಶವನ್ನು ನಿಮ್ಮ ಸಂತತಿಯವರಿಗೆ ಕೊಡುವೆನು ಮತ್ತು ಅವರು ನಿತ್ಯವಾಗಿ ಸ್ವಾಧೀನವಾಗಿಟ್ಟುಕೊಳ್ಳುವರು’ ಎಂದು ಮಾತುಕೊಡಲಿಲ್ಲವೆ?” ಎಂದನು. <verse eid="EXO 32:13"/><verse number="14" style="v" sid="EXO 32:14"/>ಆಗ ಯೆಹೋವ ದೇವರು ತಮ್ಮ ಜನರಿಗೆ ಮಾಡುವೆನೆಂದು ಹೇಳಿದ ಕೇಡಿನ ವಿಷಯದಲ್ಲಿ ಮನಸ್ಸನ್ನು ಮಾರ್ಪಡಿಸಿಕೊಂಡರು.<verse eid="EXO 32:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="EXO 32:15"/>ಮೋಶೆಯು ತಿರುಗಿಕೊಂಡು ಎರಡೂ ಬದಿಯಲ್ಲಿ ಬರೆದಿರುವ ಸಾಕ್ಷಿಯ ಎರಡು ಹಲಗೆಗಳನ್ನು ಕೈಯಲ್ಲಿ ಹಿಡಿದುಕೊಂಡು ಬೆಟ್ಟದಿಂದ ಇಳಿದು ಬಂದನು. ಆ ಹಲಗೆಗಳ ಎರಡೂ ಬದಿಗಳಲ್ಲಿ ಅಂದರೆ ಈ ಕಡೆಯಲ್ಲಿಯೂ ಮತ್ತು ಆ ಕಡೆಯಲ್ಲಿಯೂ ಬರಹವಿತ್ತು. <verse eid="EXO 32:15"/><verse number="16" style="v" sid="EXO 32:16"/>ಆ ಹಲಗೆಗಳು ದೇವರ ಕೆಲಸಗಳಾಗಿದ್ದವು. ಆ ಹಲಗೆಗಳ ಮೇಲೆ ಕೆತ್ತಿದ ಬರಹವು ದೇವರದ್ದೇ ಆಗಿತ್ತು.<verse eid="EXO 32:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="EXO 32:17"/>ಯೆಹೋಶುವನು ಜನರು ಕೂಗುತ್ತಿದ್ದ ಶಬ್ದವನ್ನು ಕೇಳಿ ಮೋಶೆಗೆ, “ಪಾಳೆಯದ ಕಡೆಯಿಂದ ಯುದ್ಧದ ಶಬ್ದವು ಕೇಳಿಸುತ್ತದೆ,” ಎಂದು ಹೇಳಿದನು.<verse eid="EXO 32:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="EXO 32:18"/>ಅದಕ್ಕೆ ಮೋಶೆಯು ಹೀಗೆ ಉತ್ತರಿಸಿದನು:</para>
  <para style="q1" vid="EXO 32:18">“ಅದು ಜಯಧ್ವನಿಯು ಅಲ್ಲ,</para>
  <para style="q2" vid="EXO 32:18">ಅಪಜಯದ ಧ್ವನಿಯೂ ಅಲ್ಲ.</para>
  <para style="q2" vid="EXO 32:18">ಆದರೆ ನನಗೆ ಹಾಡುವ ಧ್ವನಿಯು ಕೇಳಿಸುತ್ತಿದೆ.”<verse eid="EXO 32:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="EXO 32:19"/>ಇದಾದ ಮೇಲೆ ಮೋಶೆ ಪಾಳೆಯದ ಸಮೀಪಕ್ಕೆ ಬಂದು ಆ ಕರುವನ್ನೂ, ಅವರ ಕುಣಿದಾಟವನ್ನೂ ನೋಡಿದಾಗ, ಮೋಶೆಯು ಕೋಪಗೊಂಡು ಕೈಯಲ್ಲಿದ್ದ ಹಲಗೆಗಳನ್ನು ಬೆಟ್ಟದ ಅಡಿಯಲ್ಲಿ ಬಿಸಾಡಿ ಅವುಗಳನ್ನು ಒಡೆದುಬಿಟ್ಟನು. <verse eid="EXO 32:19"/><verse number="20" style="v" sid="EXO 32:20"/>ಅವರು ಮಾಡಿದ ಕರುವನ್ನು ಅವನು ತೆಗೆದುಕೊಂಡು, ಅದನ್ನು ಬೆಂಕಿಯಿಂದ ಸುಟ್ಟು ಪುಡಿಯಾಗುವವರೆಗೆ ಅರೆದು ನೀರಿನ ಮೇಲೆ ಚೆಲ್ಲಿ, ಆ ನೀರನ್ನು ಇಸ್ರಾಯೇಲರು ಕುಡಿಯುವಂತೆ ಮಾಡಿದನು.<verse eid="EXO 32:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="EXO 32:21"/>ಮೋಶೆಯು ಆರೋನನಿಗೆ, “ಈ ಜನರ ಮೇಲೆ ದೊಡ್ಡ ಪಾಪವನ್ನು ನೀನು ಬರಮಾಡುವಂತೆ ಅವರು ನಿನಗೆ ಏನು ಮಾಡಿದರು?” ಎಂದು ಕೇಳಿದನು.<verse eid="EXO 32:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="EXO 32:22"/>ಅದಕ್ಕೆ ಆರೋನನು, “ನನ್ನ ಒಡೆಯನೇ ಕೋಪಗೊಳ್ಳಬೇಡಿ ಈ ಜನರು ಕೆಡುಕಿನ ಮನಸ್ಸಿನವರಾಗಿದ್ದಾರೆಂದು ನೀವು ಬಲ್ಲಿರಿ. <verse eid="EXO 32:22"/><verse number="23" style="v" sid="EXO 32:23"/>ಅವರು ನನಗೆ, ‘ನಮ್ಮನ್ನು ಮುನ್ನಡೆಸಿಕೊಂಡು ಹೋಗುವ ದೇವರುಗಳನ್ನು ಮಾಡು. ಏಕೆಂದರೆ ಈಜಿಪ್ಟ್ ದೇಶದೊಳಗಿಂದ ನಮ್ಮನ್ನು ಬರಮಾಡಿದ ಈ ಮೋಶೆಗೆ ಏನಾಯಿತೋ ನಮಗೆ ತಿಳಿಯದು,’ ಎಂದು ಹೇಳಿದರು. <verse eid="EXO 32:23"/><verse number="24" style="v" sid="EXO 32:24"/>ಆದ್ದರಿಂದ ನಾನು ಅವರಿಗೆ, ‘ಚಿನ್ನ ಇದ್ದವರು ಅದನ್ನು ತರಲಿ,’ ಎಂದೆನು. ಅವರು ಅದನ್ನು ನನಗೆ ಕೊಟ್ಟರು. ಆಗ ನಾನು ಅದನ್ನು ಬೆಂಕಿಯಲ್ಲಿ ಹಾಕಿದಾಗ, ಈ ಕರುವು ಉಂಟಾಯಿತು,” ಎಂದನು.<verse eid="EXO 32:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="EXO 32:25"/>ಮೋಶೆಯು ಜನರು ಕ್ರಮವಿಲ್ಲದಿರುವುದನ್ನು ಕಂಡನು. ಆರೋನನು ಅವರನ್ನು ಮಿತಿಮೀರಿ ಇಷ್ಟಬಂದಂತೆ ಮಾಡುವದಕ್ಕೆ ಅವಕಾಶ ಮಾಡಿಕೊಟ್ಟದ್ದರಿಂದ ಅವರ ವೈರಿಗಳ ಮುಂದೆ ಅಪಹಾಸ್ಯಕ್ಕೆ ಆಸ್ಪದವಾಯಿತು. <verse eid="EXO 32:25"/><verse number="26" style="v" sid="EXO 32:26"/>ಮೋಶೆಯು ಪಾಳೆಯದ ಬಾಗಿಲಲ್ಲಿ ನಿಂತುಕೊಂಡು, “ಯೆಹೋವ ದೇವರ ಪಕ್ಷದವರೆಲ್ಲರೂ ನನ್ನ ಬಳಿಗೆ ಬರಲಿ,” ಎಂದನು. ಆಗ ಲೇವಿಯರೆಲ್ಲರು ಅವನ ಬಳಿಗೆ ಕೂಡಿಬಂದರು.<verse eid="EXO 32:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="EXO 32:27"/>ಆಗ ಅವನು ಅವರಿಗೆ, “ಇಸ್ರಾಯೇಲಿನ ದೇವರಾದ ಯೆಹೋವ ದೇವರು ಹೀಗೆ ಹೇಳುತ್ತಾರೆ, ‘ಪ್ರತಿಯೊಬ್ಬನು ತನ್ನ ಖಡ್ಗವನ್ನು ಪಕ್ಕದಲ್ಲಿ ಕಟ್ಟಿಕೊಂಡು ಪಾಳೆಯದಲ್ಲೆಲ್ಲಾ ಒಂದು ದ್ವಾರದಿಂದ ಇನ್ನೊಂದು ದ್ವಾರಕ್ಕೆ ಹೋಗಿ ಹೋಗುತ್ತಾ ಬರುತ್ತಾ ತನ್ನ ಸಹೋದರನನ್ನೂ, ತನ್ನ ಜೊತೆಗಾರನನ್ನೂ ಮತ್ತು ನೆರೆಹೊರೆಯವನೆಂದು ಲಕ್ಷಿಸದೆ ಕೊಲ್ಲಲಿ,’ ” ಎಂದು ಹೇಳಿದನು. <verse eid="EXO 32:27"/><verse number="28" style="v" sid="EXO 32:28"/>ಲೇವಿಯರು ಮೋಶೆಯು ಆಜ್ಞಾಪಿಸಿದಂತೆ ಮಾಡಿದರು. ಆ ದಿನ ಹೆಚ್ಚು ಕಡಿಮೆ ಮೂರು ಸಾವಿರ ಜನರು ಸತ್ತರು. <verse eid="EXO 32:28"/><verse number="29" style="v" sid="EXO 32:29"/>ಆಗ ಮೋಶೆ ಆ ಲೇವಿಯರಿಗೆ, “ಈ ದಿನ ನಿಮ್ಮಲ್ಲಿ ಪ್ರತಿಯೊಬ್ಬನು ಮಗನನ್ನಾದರೂ, ಅಣ್ಣತಮ್ಮಂದಿರನ್ನಾದರೂ ಲಕ್ಷ್ಯಕ್ಕೆ ತೆಗೆದುಕೊಳ್ಳದೆ, ನಿಮ್ಮನ್ನೇ ಯೆಹೋವ ದೇವರ ಸೇವೆಗೆ ಪ್ರತಿಷ್ಠಾಪಿಸಿಕೊಂಡಿದ್ದೀರಿ. ಆದ್ದರಿಂದ ಅವರು ಈ ದಿನ ನಿಮ್ಮನ್ನು ಆಶೀರ್ವದಿಸಿರುವರು,” ಎಂದು ಹೇಳಿದನು.<verse eid="EXO 32:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="EXO 32:30"/>ಮರುದಿನದಲ್ಲಿ, ಮೋಶೆಯು ಜನರಿಗೆ, “ನೀವು ದೊಡ್ಡ ಪಾಪವನ್ನು ಮಾಡಿದ್ದೀರಿ. ಆದ್ದರಿಂದ ನಾನು ಈಗ ಬೆಟ್ಟವನ್ನು ಹತ್ತಿ ಯೆಹೋವ ದೇವರ ಬಳಿಗೆ ಹೋಗುವೆನು. ಒಂದು ವೇಳೆ ನಿಮ್ಮ ಪಾಪಕ್ಕಾಗಿ ನಾನು ಪ್ರಾಯಶ್ಚಿತ್ತ ಮಾಡಿಕೊಳ್ಳಬಹುದು,” ಎಂದನು.<verse eid="EXO 32:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="EXO 32:31"/>ಹೀಗೆ ಮೋಶೆಯು ಯೆಹೋವ ದೇವರ ಬಳಿಗೆ ತಿರುಗಿ ಹೋಗಿ, “ಅಯ್ಯೋ, ಈ ಜನರು ದೊಡ್ಡ ಪಾಪವನ್ನು ಮಾಡಿದ್ದಾರೆ. ಅವರು ತಮಗೆ ಚಿನ್ನದ ದೇವರುಗಳನ್ನು ಮಾಡಿಕೊಂಡಿದ್ದಾರೆ. <verse eid="EXO 32:31"/><verse number="32" style="v" sid="EXO 32:32"/>ಆದರೂ ಈಗ ನೀವು ಅವರ ಪಾಪವನ್ನು ಕ್ಷಮಿಸಬೇಕು. ಇಲ್ಲವಾದರೆ ನೀವು ಬರೆದ ಗ್ರಂಥದಿಂದ ನನ್ನ ಹೆಸರನ್ನು ಅಳಿಸಿಬಿಡಿ,” ಎಂದು ಬೇಡಿಕೊಂಡನು.<verse eid="EXO 32:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="EXO 32:33"/>ಅದಕ್ಕೆ ಯೆಹೋವ ದೇವರು ಮೋಶೆಗೆ, “ನನಗೆ ವಿರೋಧವಾಗಿ ಪಾಪಮಾಡಿದವನ ಹೆಸರನ್ನೇ ನಾನು ನನ್ನ ಪುಸ್ತಕದಿಂದ ಅಳಿಸಿಬಿಡುವೆನು. <verse eid="EXO 32:33"/><verse number="34" style="v" sid="EXO 32:34"/>ಆದರೆ ಈಗ ನೀನು ಹೋಗಿ, ಜನರನ್ನು ನಿನಗೆ ನಾನು ಹೇಳಿದ ಸ್ಥಳಕ್ಕೆ ಕರೆದುಕೊಂಡು ಹೋಗು. ಇಗೋ, ನನ್ನ ದೂತನು ನಿನ್ನನ್ನು ಮುನ್ನಡೆಸುವನು. ಆದರೂ ನಾನು ವಿಚಾರಿಸುವ ದಿನ ಬಂದಾಗ ಅವರ ಪಾಪಕ್ಕೆ ತಕ್ಕಂತೆ ಅವರನ್ನು ಶಿಕ್ಷಿಸುತ್ತೇನೆ,” ಎಂದರು.<verse eid="EXO 32:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="EXO 32:35"/>ಹೀಗೆ ಆರೋನನು ಮಾಡಿದ ಕರುವನ್ನು ಅವರು ಆರಾಧಿಸಿದ್ದರಿಂದ ಯೆಹೋವ ದೇವರು ಜನರನ್ನು ಉಪದ್ರವದಿಂದ ಬಾಧಿಸಿದರು.<verse eid="EXO 32:35"/></para>
  <chapter eid="EXO 32"/>
  <chapter number="33" style="c" sid="EXO 33"/>
  <para style="p">
    <verse number="1" style="v" sid="EXO 33:1"/>ಯೆಹೋವ ದೇವರು ಮೋಶೆಗೆ, “ನೀನು ಈಜಿಪ್ಟ್ ದೇಶದೊಳಗಿಂದ ಬರಮಾಡಿದ ಜನರ ಸಂಗಡ ಈ ಸ್ಥಳವನ್ನು ಬಿಟ್ಟು ನಾನು ಅಬ್ರಹಾಮನಿಗೂ, ಇಸಾಕನಿಗೂ, ಯಾಕೋಬನಿಗೂ, ‘ನಿಮ್ಮ ಸಂತತಿಯವರಿಗೆ ಅದನ್ನು ಕೊಡುವೆನು,’ ಎಂದು ಹೇಳಿ ಪ್ರಮಾಣ ಮಾಡಿದ ದೇಶಕ್ಕೆ ಹೋಗು. <verse eid="EXO 33:1"/><verse number="2" style="v" sid="EXO 33:2"/>ನಾನು ನಿನ್ನ ಮುಂದೆ ದೂತನನ್ನು ಕಳುಹಿಸಿ ಕಾನಾನ್ಯರನ್ನೂ, ಅಮೋರಿಯರನ್ನೂ, ಹಿತ್ತಿಯರನ್ನೂ, ಪೆರಿಜೀಯರನ್ನೂ, ಹಿವ್ವಿಯರನ್ನೂ, ಯೆಬೂಸಿಯರನ್ನೂ ಹೊರದೂಡುವೆನು. <verse eid="EXO 33:2"/><verse number="3" style="v" sid="EXO 33:3"/>ಹಾಲೂ ಜೇನೂ ಹರಿಯುವ ದೇಶಕ್ಕೆ ಹೋಗು. ನಾನು ನಿಮ್ಮ ಸಂಗಡ ಹೋಗುವುದಿಲ್ಲ ಏಕೆಂದರೆ ನೀವು ಮಾತು ಕೇಳದ ಹಟಮಾರಿ ಜನರಾಗಿದ್ದೀರಿ ಮತ್ತು ಮಾರ್ಗದಲ್ಲಿ ನಾನು ನಿಮ್ಮನ್ನು ಸಂಹರಿಸಬೇಕಾಗಬಹುದು,” ಎಂದರು.<verse eid="EXO 33:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="EXO 33:4"/>ಜನರು ಈ ಕಠಿಣವಾದ ಮಾತುಗಳನ್ನು ಕೇಳಿದಾಗ ದುಃಖಪಟ್ಟರು. ಯಾರೂ ತಮ್ಮ ಆಭರಣಗಳನ್ನು ಧರಿಸಿಕೊಳ್ಳಲಿಲ್ಲ. <verse eid="EXO 33:4"/><verse number="5" style="v" sid="EXO 33:5"/>ಏಕೆಂದರೆ ಯೆಹೋವ ದೇವರು ಮೋಶೆಗೆ, “ಇಸ್ರಾಯೇಲರಿಗೆ ಹೀಗೆ ಹೇಳು: ‘ನೀವು ಆಜ್ಞೆಗಳನ್ನು ಪಾಲಿಸದ ಹಟಮಾರಿ ಜನರು. ನಾನು ಕ್ಷಣಮಾತ್ರವೂ ನಿಮ್ಮೊಡನೆ ಬಂದರೆ ನೀವು ನಿರ್ಮೂಲವಾಗಿಬಿಡುವಿರಿ. ಹೀಗಿರುವುದರಿಂದ ಈಗ ನಿಮ್ಮ ಆಭರಣಗಳನ್ನು ನಿಮ್ಮಿಂದ ತೆಗೆದುಬಿಡಿರಿ, ನಾನು ನಿಮಗೆ ಏನು ಮಾಡಬೇಕೆಂಬುದನ್ನು ತೀರ್ಮಾನಿಸುವೆನು’ ಎಂದು ಹೇಳು,” ಎಂದು ತಿಳಿಸಿದರು. <verse eid="EXO 33:5"/><verse number="6" style="v" sid="EXO 33:6"/>ಅದರಂತೆಯೇ ಇಸ್ರಾಯೇಲರು ಹೋರೇಬ್<note caller="+" style="f"><char style="fr" closed="false">33:6 </char><char style="fqa" closed="false">ಸೀನಾಯಿ </char><char style="ft" closed="false">ಪರ್ವತಕ್ಕೆ ಇನ್ನೊಂದು ಹೆಸರು.</char></note> ಬೆಟ್ಟದ ಬಳಿಯಲ್ಲಿ ತಮ್ಮ ಆಭರಣಗಳನ್ನು ತೆಗೆದುಬಿಟ್ಟರು.<verse eid="EXO 33:6"/></para>
  <para style="s1">ದೇವದರ್ಶನದ ಗುಡಾರ</para>
  <para style="p">
    <verse number="7" style="v" sid="EXO 33:7"/>ಮೋಶೆಯು ಗುಡಾರವನ್ನು ತೆಗೆದು ಪಾಳೆಯದ ಹೊರಗೆ ಪಾಳೆಯಕ್ಕೆ ದೂರವಾಗಿ ಹಾಕಿ, ಅದಕ್ಕೆ “ದೇವದರ್ಶನದ ಗುಡಾರ” ಎಂದು ಹೆಸರಿಟ್ಟನು. ತರುವಾಯ ಯೆಹೋವ ದೇವರನ್ನು ಹುಡುಕುವವರೆಲ್ಲಾ ಪಾಳೆಯದ ಹೊರಗೆ ಇರುವ ದೇವದರ್ಶನದ ಗುಡಾರಕ್ಕೆ ಹೋದರು. <verse eid="EXO 33:7"/><verse number="8" style="v" sid="EXO 33:8"/>ಇದಾದ ಮೇಲೆ ಮೋಶೆಯು ಗುಡಾರದ ಬಳಿಗೆ ಹೊರಗೆ ಹೋಗುತ್ತಿರುವಾಗ ಜನರೆಲ್ಲರೂ ಎದ್ದು, ತಮ್ಮ ತಮ್ಮ ಗುಡಾರಗಳ ಬಾಗಿಲುಗಳಲ್ಲಿ ನಿಂತುಕೊಂಡು ಮೋಶೆಯು ಗುಡಾರದಲ್ಲಿ ಪ್ರವೇಶಿಸುವವರೆಗೆ ಅವನ ಹಿಂದೆ ನೋಡುತ್ತಿದ್ದರು. <verse eid="EXO 33:8"/><verse number="9" style="v" sid="EXO 33:9"/>ಮೋಶೆ ಗುಡಾರದೊಳಗೆ ಹೋಗುವಾಗ, ಮೇಘಸ್ತಂಭವು ಪ್ರವೇಶದ್ವಾರದ ಬಳಿಯಲ್ಲಿ ನಿಲ್ಲುತ್ತಿತ್ತು. ಆಗ ಯೆಹೋವ ದೇವರು ಮೋಶೆಯೊಂದಿಗೆ ಮಾತನಾಡುತ್ತಿದ್ದರು. <verse eid="EXO 33:9"/><verse number="10" style="v" sid="EXO 33:10"/>ಜನರೆಲ್ಲರೂ ಗುಡಾರದ ಬಾಗಿಲಲ್ಲಿ ನಿಂತ ಮೇಘಸ್ತಂಭವನ್ನು ನೋಡುವಾಗ ತಮ್ಮ ತಮ್ಮ ಡೇರೆಗಳ ಬಾಗಿಲುಗಳಲ್ಲಿ ಎದ್ದು ನಿಂತು ಯೆಹೋವ ದೇವರನ್ನು ಆರಾಧಿಸುತ್ತಿದ್ದರು. <verse eid="EXO 33:10"/><verse number="11" style="v" sid="EXO 33:11"/>ಒಬ್ಬ ಮನುಷ್ಯನು ತನ್ನ ಸ್ನೇಹಿತನ ಸಂಗಡ ಮಾತನಾಡುವಂತೆ ಯೆಹೋವ ದೇವರು ಮೋಶೆಯ ಸಂಗಡ ಮುಖಾಮುಖಿಯಾಗಿ ಮಾತನಾಡುತ್ತಿದ್ದರು. ತರುವಾಯ ಅವನು ಪಾಳೆಯಕ್ಕೆ ಹಿಂದಿರುಗಿ ಹೋಗುತ್ತಿದ್ದನು. ಆದರೆ ಅವನ ಸೇವಕನೂ ನೂನನ ಮಗನೂ ಆದ ಯೆಹೋಶುವನೆಂಬ ಯೌವನಸ್ಥನು ಗುಡಾರವನ್ನು ಬಿಟ್ಟುಹೋಗಲಿಲ್ಲ.<verse eid="EXO 33:11"/></para>
  <para style="s1">ಮೋಶೆ ಮತ್ತು ಯೆಹೋವ ದೇವರ ಮಹಿಮೆ</para>
  <para style="p">
    <verse number="12" style="v" sid="EXO 33:12"/>ಮೋಶೆಯು ಯೆಹೋವ ದೇವರಿಗೆ, “ ‘ಈ ಜನರನ್ನು ನಡೆಸಿಕೊಂಡು ಹೋಗು,’ ಎಂದು ನನಗೆ ಹೇಳುತ್ತಿರುವಿರಿ. ಯಾರನ್ನು ನನ್ನ ಸಂಗಡ ಕಳುಹಿಸುವಿರಿ, ಎಂದು ನೀವು ನನಗೆ ತಿಳಿಸಲಿಲ್ಲ. ಆದರೂ ನೀವು ನನಗೆ, ‘ನಾನು ನಿನ್ನನ್ನು ನಿನ್ನ ಹೆಸರಿನ ಮೂಲಕ ತಿಳಿದಿದ್ದೇನೆ, ನನ್ನ ದೃಷ್ಟಿಯಲ್ಲಿ ನಿನಗೆ ಕೃಪೆ ದೊರೆಯಿತು,’ ಎಂದೂ ಹೇಳಿದ್ದೀರಲ್ಲಾ. <verse eid="EXO 33:12"/><verse number="13" style="v" sid="EXO 33:13"/>ಹಾಗಾದರೆ ಈಗ ನಿಮ್ಮ ದೃಷ್ಟಿಯಲ್ಲಿ ನನಗೆ ದಯೆ ದೊರೆಕಿದ್ದೇ ಆದರೆ ನಾನು ನಿಮ್ಮನ್ನು ತಿಳಿಯುವ ಹಾಗೆ, ನಿಮ್ಮ ಮಾರ್ಗವನ್ನು ನನಗೆ ತೋರಿಸಿ. ಆಗ ನಿಮ್ಮ ದೃಷ್ಟಿಯಲ್ಲಿ ನನಗೆ ದಯೆ ದೊರಕಿರುವುದು. ಈ ಜನಾಂಗವು ನಿಮ್ಮ ಜನರೇ, ಎಂದು ಜ್ಞಾಪಿಸಿಕೊಳ್ಳುವೆನು,” ಎಂದು ಹೇಳಿದನು.<verse eid="EXO 33:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="EXO 33:14"/>ಆಗ ಯೆಹೋವ ದೇವರು, “ನನ್ನ ಪ್ರಸನ್ನತೆಯು ನಿನ್ನ ಸಂಗಡ ಹೋಗುವುದು. ನಾನು ನಿನಗೆ ವಿಶ್ರಾಂತಿಯನ್ನು ಕೊಡುವೆನು,” ಎಂದರು.<verse eid="EXO 33:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="EXO 33:15"/>ಮೋಶೆಯು ಅವರಿಗೆ, “ನಿಮ್ಮ ಪ್ರಸನ್ನತೆಯು ನಮ್ಮೊಂದಿಗೆ ಹೋಗದಿದ್ದರೆ ನಮ್ಮನ್ನು ಇಲ್ಲಿಂದ ಕರೆದುಕೊಂಡು ಹೋಗಬೇಡಿ. <verse eid="EXO 33:15"/><verse number="16" style="v" sid="EXO 33:16"/>ಏಕೆಂದರೆ ನನಗೂ ನಿಮ್ಮ ಜನರಿಗೂ ನಿಮ್ಮ ದೃಷ್ಟಿಯಲ್ಲಿ ದಯೆ ದೊರಕಿತೆಂದು ಯಾವುದರಿಂದ ತಿಳಿದುಬರುವುದು? ನೀವು ನನ್ನೊಂದಿಗೆ ಹೋಗುವುದರಿಂದಲ್ಲವೋ? ಹೀಗೆ ನಾನೂ ನಿಮ್ಮ ಜನರೂ ಭೂಮಿಯ ಮೇಲಿರುವ ಎಲ್ಲಾ ಜನರಿಂದ ಪ್ರತ್ಯೇಕವಾಗಿರುವೆವು,” ಎಂದನು.<verse eid="EXO 33:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="EXO 33:17"/>ಅದಕ್ಕೆ ಯೆಹೋವ ದೇವರು ಮೋಶೆಗೆ, “ನೀನು ಆಡಿದ ಈ ಮಾತಿನಂತೆಯೇ ನಾನು ಇದನ್ನು ಮಾಡುತ್ತೇನೆ. ಏಕೆಂದರೆ ನನ್ನ ದೃಷ್ಟಿಯಲ್ಲಿ ನಿನಗೆ ದಯೆ ದೊರಕಿತು. ನಾನು ನಿನ್ನನ್ನು ನಿನ್ನ ಹೆಸರಿನಿಂದ ತಿಳಿದಿದ್ದೇನೆ,” ಎಂದರು.<verse eid="EXO 33:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="EXO 33:18"/>ಆಗ ಮೋಶೆ, “ನಿಮ್ಮ ಮಹಿಮೆಯನ್ನು ನನಗೆ ತೋರಿಸಿ ಎಂದು ನಾನು ನಿಮ್ಮನ್ನು ಬೇಡಿಕೊಳ್ಳುತ್ತೇನೆ,” ಎಂದನು.<verse eid="EXO 33:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="EXO 33:19"/>ಅದಕ್ಕೆ ಅವರು, “ನಾನು ನನ್ನ ಒಳ್ಳೆಯತನವನ್ನೆಲ್ಲಾ ನಿನ್ನ ಎದುರಿಗೆ ಹಾದು ಹೋಗ ಮಾಡಿ, ಯೆಹೋವ ದೇವರ ಹೆಸರನ್ನು ನಿನ್ನ ಮುಂದೆ ಪ್ರಕಟಮಾಡಿ, ಯಾವನ ಮೇಲೆ ನನ್ನ ಕರುಣೆ ಉಂಟೋ, ಅವನನ್ನು ಕರುಣಿಸುವೆನು. ಯಾವನ ಮೇಲೆ ನನ್ನ ಕನಿಕರವಿದೆಯೋ ಅವನನ್ನು ಕನಿಕರಿಸುವೆನು,” ಎಂದರು. <verse eid="EXO 33:19"/><verse number="20" style="v" sid="EXO 33:20"/>ಮತ್ತೆ ದೇವರು ಮೋಶೆಗೆ, “ನೀನು ನನ್ನ ಮುಖವನ್ನು ನೋಡಲಾರಿ. ಏಕೆಂದರೆ ಯಾವ ಮನುಷ್ಯನೂ ನನ್ನನ್ನು ನೋಡಿ ಬದುಕಿರಲಾರನು,” ಎಂದರು.<verse eid="EXO 33:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="EXO 33:21"/>ಇದಲ್ಲದೆ ಯೆಹೋವ ದೇವರು, “ನನ್ನ ಬಳಿಯಲ್ಲಿ ಒಂದು ಸ್ಥಳವಿದೆ. ನೀನು ಬಂಡೆಯ ಮೇಲೆ ನಿಂತುಕೋ. <verse eid="EXO 33:21"/><verse number="22" style="v" sid="EXO 33:22"/>ಆಗ ನನ್ನ ಮಹಿಮೆಯು ಹಾದುಹೋಗುವಾಗ, ನಿನ್ನನ್ನು ಬಂಡೆಯ ಬಿರುಕಿನಲ್ಲಿ ನಿಲ್ಲಿಸಿ, ನಿನ್ನ ಮೇಲೆ ನನ್ನ ಕೈ ಮುಚ್ಚುವೆನು. <verse eid="EXO 33:22"/><verse number="23" style="v" sid="EXO 33:23"/>ತರುವಾಯ ನನ್ನ ಕೈಯನ್ನು ತೆಗೆದುಬಿಡುವೆನು. ಆಗ ನೀನು ನನ್ನ ಬೆನ್ನನ್ನು ನೋಡುವೆ, ಆದರೆ ನನ್ನ ಮುಖವು ನಿನಗೆ ಕಾಣಿಸುವುದಿಲ್ಲ,” ಎಂದರು.<verse eid="EXO 33:23"/></para>
  <chapter eid="EXO 33"/>
  <chapter number="34" style="c" sid="EXO 34"/>
  <para style="s1">ಹೊಸ ಕಲ್ಲಿನ ಹಲಗೆಗಳು</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 34:1"/>ಯೆಹೋವ ದೇವರು ಮೋಶೆಗೆ, “ಮೊದಲಿನವುಗಳ ಹಾಗೆ ಎರಡು ಕಲ್ಲಿನ ಹಲಗೆಗಳನ್ನು ಕೆತ್ತಿಸಿಕೋ. ಆಗ ನೀನು ಒಡೆದ ಆ ಮೊದಲನೆಯ ಹಲಗೆಗಳ ಮೇಲೆ ಇದ್ದ ವಾಕ್ಯಗಳನ್ನು ಈ ಹಲಗೆಗಳ ಮೇಲೆ ನಾನು ಬರೆಯುವೆನು. <verse eid="EXO 34:1"/><verse number="2" style="v" sid="EXO 34:2"/>ಬೆಳಿಗ್ಗೆ ನೀನು ಸಿದ್ಧನಾಗಿ ಸೀನಾಯಿ ಬೆಟ್ಟವನ್ನೇರಿ, ಆ ಬೆಟ್ಟದ ತುದಿಯ ಮೇಲೆ ನನ್ನ ಸನ್ನಿಧಿಯಲ್ಲಿ ನಿಂತಿರಬೇಕು. <verse eid="EXO 34:2"/><verse number="3" style="v" sid="EXO 34:3"/>ಆದರೆ ಯಾರೂ ನಿನ್ನ ಸಂಗಡ ಮೇಲಕ್ಕೆ ಬರಬಾರದು. ಬೆಟ್ಟದ ಮೇಲೆ ಎಲ್ಲಿಯೂ ಯಾರೂ ಕಾಣಿಸಬಾರದು, ಆ ಬೆಟ್ಟದ ಎದುರಿನಲ್ಲಿ ದನಕುರಿಗಳು ಸಹ ಮೇಯಬಾರದು,” ಎಂದು ಹೇಳಿದರು.<verse eid="EXO 34:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="EXO 34:4"/>ಆಗ ಮೋಶೆಯು ಮೊದಲಿನವುಗಳಂತೆ ಎರಡು ಕಲ್ಲಿನ ಹಲಗೆಗಳನ್ನು ಕೆತ್ತಿಸಿಕೊಂಡನು. ಬೆಳಿಗ್ಗೆ ಎದ್ದು ಯೆಹೋವ ದೇವರು ತನಗೆ ಆಜ್ಞಾಪಿಸಿದಂತೆ ಕಲ್ಲಿನ ಎರಡು ಹಲಗೆಗಳನ್ನು ತನ್ನ ಕೈಯಲ್ಲಿ ತೆಗೆದುಕೊಂಡು ಸೀನಾಯಿ ಬೆಟ್ಟದ ಮೇಲೆ ಹೋದನು. <verse eid="EXO 34:4"/><verse number="5" style="v" sid="EXO 34:5"/>ಆಗ ಯೆಹೋವ ದೇವರು ಮೇಘದಲ್ಲಿ ಇಳಿದುಬಂದು ಅಲ್ಲಿ ಅವನ ಸಂಗಡ ನಿಂತುಕೊಂಡು, ಯೆಹೋವ ದೇವರು ತಮ್ಮ ಹೆಸರನ್ನು ಪ್ರಕಟಮಾಡಿದರು. <verse eid="EXO 34:5"/><verse number="6" style="v" sid="EXO 34:6"/>ಯೆಹೋವ ದೇವರು ಅವನೆದುರಿಗೆ ಹಾದು ಹೋಗಿ, “ಯೆಹೋವ ದೇವರು, ಯೆಹೋವ ದೇವರು, ಕರುಣಾಳುವು, ಕೃಪಾಳುವು, ದೀರ್ಘಶಾಂತನು, ಮಹಾ ಪ್ರೀತಿಯುಳ್ಳವನು ಮತ್ತು ಸತ್ಯದಲ್ಲಿ ಸಮೃದ್ಧಿಯಾದಾತನೂ <verse eid="EXO 34:6"/><verse number="7" style="v" sid="EXO 34:7"/>ಸಾವಿರ ತಲೆಗಳವರೆಗೂ ಕರುಣೆ ತೋರಿಸುವಾತನು. ದೋಷವನ್ನು, ಅಪರಾಧವನ್ನು, ಪಾಪವನ್ನು ಕ್ಷಮಿಸುವಾತನು ಆದರೂ ಅಪರಾಧಿಯನ್ನು ಶಿಕ್ಷಿಸದೆ ಬಿಡದವನೂ ತಂದೆಗಳ ದೋಷವನ್ನು ಮಕ್ಕಳ ಮೇಲೆಯೂ ಮೊಮ್ಮಕ್ಕಳ ಮೇಲೆಯೂ ಮೂರನೆಯ ಮತ್ತು ನಾಲ್ಕನೆಯ ತಲೆಗಳವರೆಗೂ ಶಿಕ್ಷಿಸುವಾತನು,” ಎಂದು ಪ್ರಕಟಿಸಿಕೊಂಡರು.<verse eid="EXO 34:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="EXO 34:8"/>ಆಗ ಮೋಶೆಯು ತ್ವರೆಪಟ್ಟು ನೆಲಕ್ಕೆ ಬಾಗಿ ಅವರನ್ನು ಆರಾಧಿಸಿದನು. <verse eid="EXO 34:8"/><verse number="9" style="v" sid="EXO 34:9"/>ಅವನು, ಕರ್ತನೇ, “ಈಗ ನಿಮ್ಮ ದೃಷ್ಟಿಯಲ್ಲಿ ನನಗೆ ದಯೆ ದೊರಕಿದರೆ, ನನ್ನ ಕರ್ತನೇ ತಾವೇ ನಮ್ಮ ಸಂಗಡ ಬರಬೇಕು. ಇದು ಮಾತು ಕೇಳದ ಹಟಮಾರಿ ಜನಾಂಗವೇ ಹೌದು. ಆದರೂ ನಮ್ಮ ದೋಷವನ್ನೂ ಪಾಪವನ್ನೂ ಮನ್ನಿಸಿ ನಮ್ಮನ್ನು ನಿಮ್ಮ ಸೊತ್ತಾಗಿ ತೆಗೆದುಕೊಳ್ಳಿ,” ಎಂದನು.<verse eid="EXO 34:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="EXO 34:10"/>ಅದಕ್ಕೆ ಯೆಹೋವ ದೇವರು, “ನಾನು ಒಂದು ಒಡಂಬಡಿಕೆಯನ್ನು ಮಾಡುತ್ತೇನೆ. ಸಮಸ್ತ ಭೂಮಿಯಲ್ಲಿಯೂ ಯಾವ ಜನಾಂಗದಲ್ಲಿಯೂ ಹಿಂದೆಂದಿಗೂ ಮಾಡದಿರುವಂಥ ಅದ್ಭುತಗಳನ್ನು ನಿನ್ನ ಎಲ್ಲಾ ಜನರ ಮುಂದೆ ಮಾಡುವೆನು. ನೀನು ಯಾರ ಮಧ್ಯದಲ್ಲಿ ಇರುವೆಯೋ ಆ ಜನರೂ ಯೆಹೋವ ದೇವರ ಕಾರ್ಯವನ್ನು ನೋಡುವರು ಏಕೆಂದರೆ ನಾನು ನಿಮಗೆ ಮಾಡುವಂಥದ್ದು ಭಯಂಕರವಾಗಿರುವುದು. <verse eid="EXO 34:10"/><verse number="11" style="v" sid="EXO 34:11"/>ನಾನು ಈ ಹೊತ್ತು ನಿಮಗೆ ಆಜ್ಞಾಪಿಸುವುದನ್ನು ಅನುಸರಿಸಿ ನಡೆಯಬೇಕು. ಹಿತ್ತಿಯರನ್ನೂ ಅಮೋರಿಯರನ್ನೂ ಕಾನಾನ್ಯರನ್ನೂ, ಪೆರಿಜೀಯರನ್ನೂ ಹಿವ್ವಿಯರನ್ನೂ ಯೆಬೂಸಿಯರನ್ನೂ ನಿಮ್ಮ ಮುಂದೆಯೇ ಹೊರಡಿಸಿಬಿಡುತ್ತೇನೆ. <verse eid="EXO 34:11"/><verse number="12" style="v" sid="EXO 34:12"/>ನೀನು ಹೋಗುವ ದೇಶದ ನಿವಾಸಿಗಳ ಸಂಗಡ ಒಪ್ಪಂದವನ್ನು ಮಾಡದಂತೆ ನೋಡಿಕೋ. ಒಂದು ವೇಳೆ ಮಾಡಿದರೆ ಅದು ನಿಮ್ಮ ಮಧ್ಯದಲ್ಲಿ ಉರುಲಾಗಿರುವುದು. <verse eid="EXO 34:12"/><verse number="13" style="v" sid="EXO 34:13"/>ಆದರೆ ಅವರ ಬಲಿಪೀಠಗಳನ್ನು ಒಡೆದುಹಾಕಬೇಕು. ಅವರ ಪವಿತ್ರ ಕಲ್ಲುಕಂಬಗಳನ್ನು ಒಡೆದು, ಅಶೇರವೆಂಬ ವಿಗ್ರಹಸ್ತಂಭಗಳನ್ನು<note caller="+" style="f"><char style="fr" closed="false">34:13 </char><char style="ft" closed="false">ಅಶೇರಾ ದೇವಿಯ ಕಟ್ಟಿಗೆಯ ಸ್ತಂಭಗಳ ಚಿಹ್ನೆಗಳು</char></note> ಕಡಿದುಹಾಕಬೇಕು. <verse eid="EXO 34:13"/><verse number="14" style="v" sid="EXO 34:14"/>ಏಕೆಂದರೆ, ‘ರೋಷವುಳ್ಳವನು,’ ಎಂದು ಹೆಸರುಳ್ಳ ಯೆಹೋವ ದೇವರು ರೋಷವುಳ್ಳ ದೇವರಾಗಿರುವುದರಿಂದ ನೀನು ಬೇರೆ ದೇವರುಗಳನ್ನು ಆರಾಧಿಸಬಾರದು.<verse eid="EXO 34:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="EXO 34:15"/>“ನೀನು ಆ ದೇಶದ ನಿವಾಸಿಗಳ ಸಂಗಡ ಒಪ್ಪಂದ ಮಾಡಿಕೊಳ್ಳದಂತೆ ಎಚ್ಚರದಿಂದಿರು. ಅವರು ಅನ್ಯದೇವರುಗಳನ್ನು ಆರಾಧಿಸಿ, ಅವುಗಳಿಗೆ ಯಜ್ಞ ಅರ್ಪಿಸುವ ಸಮಯದಲ್ಲಿ ಒಬ್ಬನು ನಿನ್ನನ್ನು ಕರೆದಾನು, ನೀನು ಅವನ ಯಜ್ಞಭೋಜನವನ್ನು ಮಾಡಬೇಕಾದೀತು. <verse eid="EXO 34:15"/><verse number="16" style="v" sid="EXO 34:16"/>ಇದಲ್ಲದೆ ಅವರ ಪುತ್ರಿಯರನ್ನು ನಿನ್ನ ಪುತ್ರರಿಗೋಸ್ಕರ ತೆಗೆದುಕೊಳ್ಳಬೇಕಾಗಬಹುದು. ತೆಗೆದುಕೊಂಡರೆ ಅವರ ಪುತ್ರಿಯರು ತಮ್ಮ ದೇವರುಗಳನ್ನು ಆರಾಧಿಸಿ, ನಿಮ್ಮ ಪುತ್ರರನ್ನೂ ಅನ್ಯದೇವರುಗಳ ಆರಾಧನೆಯೆಂಬ ವ್ಯಭಿಚಾರಕ್ಕೆ ಎಳೆಯಬಹುದು.<verse eid="EXO 34:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="EXO 34:17"/>“ನಿಮಗಾಗಿ ದೇವರುಗಳ ಎರಕ ಹೊಯ್ದ ವಿಗ್ರಹಗಳನ್ನು ಮಾಡಿಕೊಳ್ಳಬಾರದು.<verse eid="EXO 34:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="EXO 34:18"/>“ಹುಳಿಯಿಲ್ಲದ ರೊಟ್ಟಿಗಳ ಹಬ್ಬವನ್ನು ಆಚರಿಸಬೇಕು. ನಾನು ನಿಮಗೆ ಆಜ್ಞಾಪಿಸಿದಂತೆ ಚೈತ್ರ ಮಾಸದ ಏಳು ದಿವಸ ಹುಳಿಯಿಲ್ಲದ ರೊಟ್ಟಿಗಳನ್ನು ತಿನ್ನಬೇಕು. ಏಕೆಂದರೆ ಅಬೀಬ ತಿಂಗಳಿನಲ್ಲಿ ನೀವು ಈಜಿಪ್ಟ್ ದೇಶವನ್ನು ಬಿಟ್ಟು ಬಂದಿದ್ದೀರಿ.<verse eid="EXO 34:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="EXO 34:19"/>“ಪ್ರಥಮ ಗರ್ಭಫಲವೆಲ್ಲಾ ಅಂದರೆ ನಿಮ್ಮ ಪಶುಗಳಾಗಲಿ, ಎತ್ತುಗಳಾಗಲಿ, ಟಗರುಗಳಾಗಲಿ ಮೊದಲು ಹುಟ್ಟುವವುಗಳೆಲ್ಲಾ ಗಂಡಾಗಿದ್ದರೆ ಅವು ನನ್ನವೇ. <verse eid="EXO 34:19"/><verse number="20" style="v" sid="EXO 34:20"/>ಕತ್ತೆಮರಿಗೆ ಬದಲಾಗಿ ಕುರಿಮರಿಯನ್ನು ವಿಮೋಚಿಸಬೇಕು. ನೀನು ವಿಮೋಚಿಸದೆ ಹೋದರೆ, ಕುತ್ತಿಗೆಯನ್ನು ಮುರಿಯಬೇಕು. ನಿನ್ನ ಪುತ್ರರಲ್ಲಿ ಚೊಚ್ಚಲಾದವರನ್ನೆಲ್ಲಾ ವಿಮೋಚಿಸಬೇಕು.</para>
  <para style="p" vid="EXO 34:20">“ನನ್ನ ಮುಂದೆ ಯಾರೂ ಬರಿಗೈಯಿಂದ ಕಾಣಿಸಿಕೊಳ್ಳಬಾರದು.<verse eid="EXO 34:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="EXO 34:21"/>“ಆರು ದಿನಗಳು ಕೆಲಸಮಾಡಿ, ಏಳನೆಯ ದಿನದಲ್ಲಿ ವಿಶ್ರಮಿಸಿಕೊಳ್ಳಬೇಕು. ಬಿತ್ತುವ ಕಾಲದಲ್ಲಿಯೂ ಕೊಯ್ಯುವ ಕಾಲದಲ್ಲಿಯೂ ಏಳನೆಯ ದಿನದಲ್ಲಿ ವಿಶ್ರಮಿಸಿಕೊಳ್ಳಬೇಕು.<verse eid="EXO 34:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="EXO 34:22"/>“ಪ್ರಥಮ ಗೋಧಿ ಸುಗ್ಗಿಯ ವಾರಗಳ ಹಬ್ಬವನ್ನು ಮತ್ತು ವರ್ಷದ ಕೊನೆಯಲ್ಲಿ ಬೆಳೆ ಸಂಗ್ರಹದ ಹಬ್ಬವನ್ನು ಆಚರಿಸಬೇಕು. <verse eid="EXO 34:22"/><verse number="23" style="v" sid="EXO 34:23"/>ವರುಷಕ್ಕೆ ಮೂರು ಸಾರಿ ನಿಮ್ಮ ಗಂಡು ಮಕ್ಕಳೆಲ್ಲಾ ಸಾರ್ವಭೌಮ ಯೆಹೋವ ದೇವರ ಮುಂದೆ ಅಂದರೆ ಇಸ್ರಾಯೇಲಿನ ದೇವರ ಮುಂದೆ ಬರಬೇಕು. <verse eid="EXO 34:23"/><verse number="24" style="v" sid="EXO 34:24"/>ಏಕೆಂದರೆ ನಾನು ಜನಾಂಗಗಳನ್ನು ನಿಮ್ಮ ಸನ್ನಿಧಿಯಿಂದ ಹೊರಡಿಸಿಬಿಟ್ಟು, ನಿಮ್ಮ ಮೇರೆಗಳನ್ನು ವಿಸ್ತಾರ ಮಾಡುವೆನು. ವರ್ಷಕ್ಕೆ ಮೂರು ಸಾರಿ ನೀವು ನಿಮ್ಮ ಯೆಹೋವ ದೇವರ ಮುಂದೆ ಬರುವ ಸಮಯದಲ್ಲಿ ಯಾರೂ ನಿಮ್ಮ ಭೂಮಿಯನ್ನು ಅಪಹರಿಸಲು ಆಶೆಪಡುವುದಿಲ್ಲ.<verse eid="EXO 34:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="EXO 34:25"/>“ಬಲಿ ಅರ್ಪಣೆಯ ರಕ್ತವನ್ನು ಹುಳಿಯಿರುವ ರೊಟ್ಟಿಯ ಸಂಗಡ ಅರ್ಪಿಸಬಾರದು. ಇಲ್ಲವೆ ಪಸ್ಕಹಬ್ಬದ ಬಲಿಯಲ್ಲಿ ಯಾವುದೂ ಬೆಳಗಿನವರೆಗೆ ಉಳಿಸಬಾರದು.<verse eid="EXO 34:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="EXO 34:26"/>“ನಿಮ್ಮ ಭೂಮಿಯ ಪ್ರಥಮ ಫಲಗಳಲ್ಲಿ ಅತ್ಯುತ್ತಮವಾದದ್ದನ್ನು ನಿಮ್ಮ ಯೆಹೋವ ದೇವರ ಆಲಯಕ್ಕೆ ತರಬೇಕು.</para>
  <para style="p" vid="EXO 34:26">“ಮೇಕೆಯ ಮರಿಯನ್ನು ಅದರ ತಾಯಿಯ ಹಾಲಿನಲ್ಲಿ ಬೇಯಿಸಬಾರದು,” ಎಂದು ಹೇಳಿದರು.<verse eid="EXO 34:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="EXO 34:27"/>ಯೆಹೋವ ದೇವರು ಮೋಶೆಗೆ ಹೀಗೆ ಹೇಳಿದರು, “ನೀನು ಈ ವಾಕ್ಯಗಳನ್ನು ಬರೆ. ಏಕೆಂದರೆ ಈ ವಾಕ್ಯಗಳ ಪ್ರಕಾರವೇ ನಾನು ನಿನ್ನ ಮತ್ತು ಇಸ್ರಾಯೇಲಿನ ಸಂಗಡ ಒಡಂಬಡಿಕೆಯನ್ನು ಮಾಡಿಕೊಂಡಿದ್ದೇನೆ.” <verse eid="EXO 34:27"/><verse number="28" style="v" sid="EXO 34:28"/>ಮೋಶೆಯು ಹಗಲಿರುಳು ನಲವತ್ತು ದಿವಸ ರೊಟ್ಟಿಯನ್ನು ತಿನ್ನದೇ, ನೀರನ್ನು ಕುಡಿಯದೇ ಅಲ್ಲಿ ಯೆಹೋವ ದೇವರ ಸಂಗಡ ಇದ್ದನು. ದೇವರು ಒಡಂಬಡಿಕೆಯ ವಾಕ್ಯಗಳಾದ ಹತ್ತು ಆಜ್ಞೆಗಳನ್ನು ಹಲಗೆಗಳ ಮೇಲೆ ಬರೆದರು.<verse eid="EXO 34:28"/></para>
  <para style="s1">ಮೋಶೆಯ ಮುಖವು ಪ್ರಕಾಶಿಸಿದ್ದು</para>
  <para style="p">
    <verse number="29" style="v" sid="EXO 34:29"/>ಮೋಶೆಯು ಸಾಕ್ಷಿಯ ಎರಡು ಹಲಗೆಗಳನ್ನು ತನ್ನ ಕೈಯಲ್ಲಿ ಹಿಡಿದುಕೊಂಡು ಸೀನಾಯಿ ಬೆಟ್ಟದಿಂದ ಇಳಿದಾಗ, ಅವನು ಯೆಹೋವ ದೇವರ ಸಂಗಡ ಬೆಟ್ಟದಲ್ಲಿ ಮಾತನಾಡಿದ್ದರಿಂದ ಅವನ ಮುಖವು ಪ್ರಕಾಶಿಸುತ್ತದೆಂದು ಬೆಟ್ಟದಿಂದ ಇಳಿದಾಗ ಮೋಶೆಗೆ ತಿಳಿಯಲಿಲ್ಲ. <verse eid="EXO 34:29"/><verse number="30" style="v" sid="EXO 34:30"/>ಆದರೆ ಆರೋನನು ಮತ್ತು ಇಸ್ರಾಯೇಲರೆಲ್ಲರೂ ಮೋಶೆಯನ್ನು ನೋಡಿದಾಗ, ಇಗೋ, ಅವನ ಮುಖವು ಪ್ರಕಾಶಿಸುತ್ತಿತ್ತು. ಆದ್ದರಿಂದ ಅವರು ಅವನ ಹತ್ತಿರ ಬರುವುದಕ್ಕೆ ಭಯಪಟ್ಟರು. <verse eid="EXO 34:30"/><verse number="31" style="v" sid="EXO 34:31"/>ಮೋಶೆಯು ಅವರನ್ನು ಕರೆದಾಗ, ಆರೋನನು ಮತ್ತು ಸಭೆಯ ಮುಖ್ಯಸ್ಥರೆಲ್ಲರೂ ಅವನ ಬಳಿಗೆ ತಿರುಗಿ ಬಂದರು. ಆಗ ಮೋಶೆಯು ಅವರ ಸಂಗಡ ಮಾತನಾಡಿದನು. <verse eid="EXO 34:31"/><verse number="32" style="v" sid="EXO 34:32"/>ತರುವಾಯ ಇಸ್ರಾಯೇಲರೆಲ್ಲರೂ ಹತ್ತಿರ ಬಂದರು. ಆಗ ಅವನು ಅವರಿಗೆ, ಯೆಹೋವ ದೇವರು ತನಗೆ ಸೀನಾಯಿ ಬೆಟ್ಟದಲ್ಲಿ ಹೇಳಿದವುಗಳನ್ನೆಲ್ಲಾ ಆಜ್ಞಾಪಿಸಿ ಹೇಳಿದನು.<verse eid="EXO 34:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="EXO 34:33"/>ಮೋಶೆಯು ಅವರ ಸಂಗಡ ಮಾತನಾಡಿ ಮುಗಿಸುವವರೆಗೂ ಅವನು ತನ್ನ ಮುಖದ ಮೇಲೆ ಮುಸುಕು ಹಾಕಿಕೊಂಡನು. <verse eid="EXO 34:33"/><verse number="34" style="v" sid="EXO 34:34"/>ಆದರೆ ಮೋಶೆಯು ಯೆಹೋವ ದೇವರ ಸನ್ನಿಧಿಯಲ್ಲಿ ಆತನ ಸಂಗಡ ಮಾತನಾಡುವುದಕ್ಕೆ ಒಳಗೆ ಪ್ರವೇಶಿಸಿ ಹೊರಗೆ ಬರುವವರೆಗೆ ಆ ಮುಸುಕನ್ನು ತೆಗೆದು ಬಿಡುತ್ತಿದ್ದನು. ಅವನು ಹೊರಗೆ ಬಂದು ತನಗೆ ಆಜ್ಞಾಪಿಸಿದ್ದನ್ನು ಇಸ್ರಾಯೇಲರಿಗೆ ಹೇಳಿದನು. <verse eid="EXO 34:34"/><verse number="35" style="v" sid="EXO 34:35"/>ಆಗ ಮೋಶೆಯ ಮುಖವು ಪ್ರಕಾಶಿಸುವುದನ್ನು ಇಸ್ರಾಯೇಲರು ನೋಡಿದ್ದರು. ಮೋಶೆ ದೇವರ ಸಂಗಡ ಮಾತನಾಡುವುದಕ್ಕೆ ಹೋಗುವವರೆಗೆ ಅವನು ತನ್ನ ಮುಖದ ಮೇಲೆ ತಿರುಗಿ ಮುಸುಕನ್ನು ಹಾಕಿಕೊಳ್ಳುತ್ತಿದ್ದನು.<verse eid="EXO 34:35"/></para>
  <chapter eid="EXO 34"/>
  <chapter number="35" style="c" sid="EXO 35"/>
  <para style="s1">ಸಬ್ಬತ್ ದಿನದ ನಿಯಮಗಳು</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 35:1"/>ಮೋಶೆಯು ಇಸ್ರಾಯೇಲರ ಸಮೂಹವನ್ನು ಒಟ್ಟುಗೂಡಿಸಿ ಅವರಿಗೆ, “ನೀವು ಅನುಸರಿಸಬೇಕೆಂದು ಯೆಹೋವ ದೇವರು ನಿಮಗೆ ಹೀಗೆ ಆಜ್ಞಾಪಿಸಿದ್ದಾರೆ. <verse eid="EXO 35:1"/><verse number="2" style="v" sid="EXO 35:2"/>ಆರು ದಿನಗಳು ಕೆಲಸ ಮಾಡಬೇಕು. ಆದರೆ ಏಳನೆಯ ದಿನವು ನಿಮಗೆ ಪರಿಶುದ್ಧವಾಗಿರಬೇಕು. ಅದು ಯೆಹೋವ ದೇವರ ಸಬ್ಬತ್ ದಿನ. ಆ ದಿನದಲ್ಲಿ ಕೆಲಸಮಾಡುವವರಿಗೆ ಮರಣದಂಡನೆಯಾಗಬೇಕು. <verse eid="EXO 35:2"/><verse number="3" style="v" sid="EXO 35:3"/>ಸಬ್ಬತ್ ದಿನದಲ್ಲಿ ನೀವು ವಾಸಮಾಡುವ ಯಾವ ಮನೆಯಲ್ಲಿಯೂ ಬೆಂಕಿಯನ್ನು ಹೊತ್ತಿಸಬಾರದು,” ಎಂದು ಹೇಳಿದನು.<verse eid="EXO 35:3"/></para>
  <para style="s1">ದೇವದರ್ಶನದ ಗುಡಾರಕ್ಕೆ ಬೇಕಾದ ವಸ್ತುಗಳು</para>
  <para style="p">
    <verse number="4" style="v" sid="EXO 35:4"/>ಮೋಶೆಯು ಇಸ್ರಾಯೇಲರ ಇಡೀ ಸಮೂಹಕ್ಕೆ ಹೇಳಿದ್ದು: “ಯೆಹೋವ ದೇವರು ಆಜ್ಞಾಪಿಸಿದ್ದು ಇದೇ. <verse eid="EXO 35:4"/><verse number="5" style="v" sid="EXO 35:5"/>ನಿಮ್ಮಲ್ಲಿರುವದರಿಂದ ಯೆಹೋವ ದೇವರಿಗೆ ಕಾಣಿಕೆಯನ್ನು ಅರ್ಪಿಸಿರಿ. ಯಾರ‍್ಯಾರಿಗೆ ಇಷ್ಟವಿದೆಯೋ ಅವರು,</para>
  <para style="b" vid="EXO 35:5"/>
  <para style="li1" vid="EXO 35:5">“ಚಿನ್ನ, ಬೆಳ್ಳಿ, ಕಂಚು,<verse eid="EXO 35:5"/></para>
  <para style="li1">
    <verse number="6" style="v" sid="EXO 35:6"/>ನೀಲಿ, ನಾರು, ರಕ್ತವರ್ಣ ನಾರು, ಲಾಕಿ ಬಣ್ಣ, ನಾರು, ನಾರುಬಟ್ಟೆಗಳು,</para>
  <para style="li1" vid="EXO 35:6">ಮೇಕೆಯ ಕೂದಲು,<verse eid="EXO 35:6"/></para>
  <para style="li1">
    <verse number="7" style="v" sid="EXO 35:7"/>ಕೆಂಪು ಬಣ್ಣದಲ್ಲಿ ಅದ್ದಿದ ಟಗರುಗಳ ಚರ್ಮಗಳು, ಕಡಲುಹಂದಿಯ ಚರ್ಮಗಳು,</para>
  <para style="li1" vid="EXO 35:7">ಜಾಲಿ ಮರದ ಕಟ್ಟಿಗೆ,<verse eid="EXO 35:7"/></para>
  <para style="li1">
    <verse number="8" style="v" sid="EXO 35:8"/>ದೀಪಕ್ಕಾಗಿ ಓಲಿವ್ ಎಣ್ಣೆ</para>
  <para style="li1" vid="EXO 35:8">ಅಭಿಷೇಕಿಸುವ ಎಣ್ಣೆಗೋಸ್ಕರ ಪರಿಮಳ ಮತ್ತು ಧೂಪಕ್ಕೋಸ್ಕರ ಸುಗಂಧ ದ್ರವ್ಯಗಳು,<verse eid="EXO 35:8"/></para>
  <para style="li1">
    <verse number="9" style="v" sid="EXO 35:9"/>ಏಫೋದ್ ಕವಚಕ್ಕಾಗಿ ಗೋಮೇಧಿಕಗಳು ಮತ್ತು ಎದೆಪದಕದಲ್ಲಿ ಹಚ್ಚಬೇಕಾದ ನಾನಾ ರತ್ನಗಳನ್ನು ತನ್ನಿರಿ.<verse eid="EXO 35:9"/></para>
  <para style="b"/>
  <para style="p">
    <verse number="10" style="v" sid="EXO 35:10"/>“ನಿಮ್ಮಲ್ಲಿರುವ ಶಿಲ್ಪಿಗಳೆಲ್ಲರೂ ಬಂದು, ಯೆಹೋವ ದೇವರು ಆಜ್ಞಾಪಿಸಿದವುಗಳನ್ನೆಲ್ಲಾ ಮಾಡಬೇಕು. ಅವು ಯಾವುವೆಂದರೆ:<verse eid="EXO 35:10"/></para>
  <para style="b"/>
  <para style="li1">
    <verse number="11" style="v" sid="EXO 35:11"/>“ದೇವದರ್ಶನದ ಗುಡಾರವನ್ನು, ಅದರ ಮೇಲ್ಹೊದಿಕೆಯನ್ನು, ಅದರ ಕೊಂಡಿಗಳನ್ನು, ಅದರ ಚೌಕಟ್ಟುಗಳನ್ನು, ಅದರ ಅಗುಳಿಗಳನ್ನು, ಅದರ ಸ್ತಂಭಗಳನ್ನು, ಅದರ ಕುಣಿಕೆಗಳನ್ನು,<verse eid="EXO 35:11"/></para>
  <para style="li1">
    <verse number="12" style="v" sid="EXO 35:12"/>ಮಂಜೂಷವನ್ನು, ಅದರ ಕೋಲುಗಳನ್ನು, ಅವುಗಳೊಂದಿಗೆ ಕರುಣಾಸನವನ್ನು, ಮರೆಮಾಡುವ ಪರದೆಯನ್ನು,<verse eid="EXO 35:12"/></para>
  <para style="li1">
    <verse number="13" style="v" sid="EXO 35:13"/>ಮೇಜನ್ನು, ಅದರ ಕೋಲುಗಳನ್ನು, ಅದರ ಎಲ್ಲಾ ಉಪಕರಣಗಳನ್ನು, ನೈವೇದ್ಯದ ರೊಟ್ಟಿಯನ್ನು,<verse eid="EXO 35:13"/></para>
  <para style="li1">
    <verse number="14" style="v" sid="EXO 35:14"/>ಬೆಳಕಿಗಾಗಿ ದೀಪಸ್ತಂಭವನ್ನು, ಅದರ ಉಪಕರಣಗಳನ್ನು, ಅದರ ದೀಪಗಳನ್ನು, ದೀಪಸ್ತಂಭಕ್ಕಾಗಿ ಎಣ್ಣೆಯನ್ನು,<verse eid="EXO 35:14"/></para>
  <para style="li1">
    <verse number="15" style="v" sid="EXO 35:15"/>ಧೂಪವೇದಿಯನ್ನು, ಅದರ ಕೋಲುಗಳನ್ನು, ಅಭಿಷೇಕಿಸುವ ತೈಲವನ್ನು, ಪರಿಮಳ ಧೂಪವನ್ನು,</para>
  <para style="li1" vid="EXO 35:15">ಗುಡಾರದ ಬಾಗಿಲಿನ ಪರದೆಯನ್ನು,<verse eid="EXO 35:15"/></para>
  <para style="li1">
    <verse number="16" style="v" sid="EXO 35:16"/>ದಹನಬಲಿಯ ಪೀಠವನ್ನು, ಅದರೊಂದಿಗೆ ಕಂಚಿನ ಜಾಳಿಗೆಯನ್ನು, ಅದರ ಕೋಲುಗಳನ್ನು, ಅದರ ಎಲ್ಲಾ ಉಪಕರಣಗಳನ್ನು,</para>
  <para style="li1" vid="EXO 35:16">ಕಂಚಿನ ಗಂಗಾಳವನ್ನು, ಅದರ ಕಾಲನ್ನು,<verse eid="EXO 35:16"/></para>
  <para style="li1">
    <verse number="17" style="v" sid="EXO 35:17"/>ದೇವದರ್ಶನದ ಗುಡಾರ ಅಂಗಳದ ಪರದೆಗಳನ್ನು, ಅದರ ಸ್ತಂಭಗಳನ್ನು, ಅದರ ಗದ್ದಿಗೇ ಕಲ್ಲುಗಳನ್ನು, ಅಂಗಳದ ಬಾಗಿಲಿನ ಪರದೆಗಳನ್ನು,<verse eid="EXO 35:17"/></para>
  <para style="li1">
    <verse number="18" style="v" sid="EXO 35:18"/>ಗುಡಾರದ ಗೂಟಗಳನ್ನು, ಅಂಗಳದ ಗೂಟಗಳನ್ನು, ಅದರ ಹಗ್ಗಗಳನ್ನು,<verse eid="EXO 35:18"/></para>
  <para style="li1">
    <verse number="19" style="v" sid="EXO 35:19"/>ಪರಿಶುದ್ಧಸ್ಥಳದ ಸೇವೆಗೋಸ್ಕರ ನೇಯ್ದ ಪರಿಶುದ್ಧ ವಸ್ತ್ರಗಳನ್ನು ಅಂದರೆ ಸೇವೆಮಾಡುವದಕ್ಕೆ ಯಾಜಕನಾದ ಆರೋನನಿಗೆ ಮತ್ತು ಅವನ ಪುತ್ರರಿಗೆ ಯಾಜಕವಸ್ತ್ರಗಳನ್ನು ಮಾಡಲಿ,” ಎಂದನು.<verse eid="EXO 35:19"/></para>
  <para style="b"/>
  <para style="p">
    <verse number="20" style="v" sid="EXO 35:20"/>ಆಗ ಇಸ್ರಾಯೇಲರ ಸಮೂಹವೆಲ್ಲಾ ಮೋಶೆಯ ಸನ್ನಿಧಿಯಿಂದ ಹೊರಟು ಹೋದರು. <verse eid="EXO 35:20"/><verse number="21" style="v" sid="EXO 35:21"/>ಹೃದಯ ಪ್ರೇರಣೆ ಹೊಂದಿದವರೂ ಸಿದ್ಧಮನಸ್ಸಿನವರೂ ದೇವದರ್ಶನದ ಗುಡಾರದ ಕೆಲಸಕ್ಕಾಗಿಯೂ ಅದರ ಎಲ್ಲಾ ಸೇವೆಗಾಗಿಯೂ ಪರಿಶುದ್ಧ ವಸ್ತ್ರಗಳಿಗಾಗಿಯೂ ಯೆಹೋವ ದೇವರಿಗೆ ಕಾಣಿಕೆಗಳನ್ನು ತೆಗೆದುಕೊಂಡು ಬಂದರು. <verse eid="EXO 35:21"/><verse number="22" style="v" sid="EXO 35:22"/>ಸ್ತ್ರೀಪುರುಷರೆಲ್ಲರೂ ಮನಃಪೂರ್ವಕವಾಗಿ ಬಂದು ಬಳೆಗಳನ್ನೂ ಮೂಗುತಿಗಳನ್ನೂ ಉಂಗುರಗಳನ್ನೂ ಮುದ್ರೆಗಳನ್ನೂ ಚಿನ್ನದ ಎಲ್ಲಾ ಒಡವೆಗಳನ್ನೂ ತಂದರು. ಜನರೆಲ್ಲಾ ಚಿನ್ನವನ್ನು ವಿಶೇಷ ಕಾಣಿಕೆಗಳನ್ನಾಗಿ ಯೆಹೋವ ದೇವರಿಗೆ ಅರ್ಪಿಸಿದರು. <verse eid="EXO 35:22"/><verse number="23" style="v" sid="EXO 35:23"/>ನೀಲಿ, ಧೂಮ್ರ, ರಕ್ತವರ್ಣ ದಾರಗಳೂ ನಯವಾದ ನಾರುಮಡಿ, ಮೇಕೆಯ ಕೂದಲು, ಟಗರುಗಳ ಕೆಂಪು ಬಣ್ಣದ ಚರ್ಮಗಳೂ ಕಡಲುಹಂದಿಯ ಚರ್ಮಗಳೂ ಯಾರ ಬಳಿಯಲ್ಲಿದ್ದವೋ ಅವರೆಲ್ಲರೂ ತಂದರು. <verse eid="EXO 35:23"/><verse number="24" style="v" sid="EXO 35:24"/>ಬೆಳ್ಳಿ, ಕಂಚುಗಳ ಕಾಣಿಕೆಗಳನ್ನು ಅರ್ಪಿಸುವುದಕ್ಕೆ ಮನಸ್ಸಿದ್ದವರೆಲ್ಲರೂ ಯೆಹೋವ ದೇವರಿಗೆ ಕಾಣಿಕೆಗಳನ್ನು ತಂದರು. ಸೇವೆಯ ಎಲ್ಲಾ ಕೆಲಸಕ್ಕೋಸ್ಕರ ಜಾಲಿ ಮರವಿದ್ದವರು ಅದನ್ನು ತಂದರು. <verse eid="EXO 35:24"/><verse number="25" style="v" sid="EXO 35:25"/>ಕುಶಲತೆ ಬಲ್ಲ ಸ್ತ್ರೀಯರೆಲ್ಲರೂ ತಮ್ಮ ಕೈಗಳಿಂದ ನೇಯ್ದ ನೀಲಿ, ಧೂಮ್ರ, ರಕ್ತವರ್ಣ ದಾರಗಳನ್ನು ಮತ್ತು ನಯವಾದ ನಾರುಮಡಿಯನ್ನು ತಂದರು. <verse eid="EXO 35:25"/><verse number="26" style="v" sid="EXO 35:26"/>ಕುಶಲತೆ ಬಲ್ಲ ಎಲ್ಲಾ ಸ್ತ್ರೀಯರು ಮೇಕೆ ಕೂದಲುಗಳನ್ನು ನೇಯ್ದರು. <verse eid="EXO 35:26"/><verse number="27" style="v" sid="EXO 35:27"/>ಅಧಿಪತಿಗಳು ಏಫೋದಿನಲ್ಲಿಯೂ ಎದೆಪದಕದಲ್ಲಿಯೂ ಕೂಡ್ರಿಸುವುದಕ್ಕೆ ಗೋಮೇಧಿಕಗಳನ್ನೂ ರತ್ನಗಳನ್ನೂ <verse eid="EXO 35:27"/><verse number="28" style="v" sid="EXO 35:28"/>ಸುಗಂಧದ್ರವ್ಯಗಳನ್ನೂ ದೀಪಕ್ಕೋಸ್ಕರವೂ ಅಭಿಷೇಕಿಸುವ ತೈಲಕ್ಕೋಸ್ಕರವೂ ಪರಿಮಳ ಧೂಪಕ್ಕೋಸ್ಕರವೂ ಎಣ್ಣೆಯನ್ನೂ ತಂದರು. <verse eid="EXO 35:28"/><verse number="29" style="v" sid="EXO 35:29"/>ಹೀಗೆ ಮಾಡಬೇಕೆಂದು ಯೆಹೋವ ದೇವರು ಮೋಶೆಯ ಮುಖಾಂತರವಾಗಿ ಆಜ್ಞಾಪಿಸಿದ ಎಲ್ಲಾ ಕೆಲಸಕ್ಕೋಸ್ಕರ ಬೇಕಾದವುಗಳನ್ನು ಇಸ್ರಾಯೇಲಿನ ಸ್ತ್ರೀಪುರುಷರೆಲ್ಲರು ಮನಃಪೂರ್ವಕವಾಗಿಯೇ ಯೆಹೋವ ದೇವರಿಗೆ ಕಾಣಿಕೆಯನ್ನು ತಂದರು.<verse eid="EXO 35:29"/></para>
  <para style="s1">ಬೆಚಲಯೇಲ್ ಮತ್ತು ಒಹೋಲಿಯಾಬನು</para>
  <para style="p">
    <verse number="30" style="v" sid="EXO 35:30"/>ಆಗ ಮೋಶೆಯು ಇಸ್ರಾಯೇಲರಿಗೆ, “ನೋಡಿರಿ, ಯೆಹೋವ ದೇವರು ಯೆಹೂದ ಕುಲದವನಾದ ಹೂರನ ಮೊಮ್ಮಗನೂ ಊರಿಯನ ಮಗನೂ ಆದ ಬೆಚಲಯೇಲ್ ಎಂಬವನನ್ನು ಗುರುತಿಸಿ ಆರಿಸಿಕೊಂಡಿದ್ದಾರೆ, <verse eid="EXO 35:30"/><verse number="31" style="v" sid="EXO 35:31"/>ಅವರು ಅವನನ್ನು ದೇವರ ಆತ್ಮನಿಂದಲೂ ಜ್ಞಾನದಿಂದಲೂ ತಿಳುವಳಿಕೆಯಿಂದಲೂ ವಿವೇಕದಿಂದಲೂ <verse eid="EXO 35:31"/><verse number="32" style="v" sid="EXO 35:32"/>ಚಿನ್ನ, ಬೆಳ್ಳಿ, ಕಂಚಿನಲ್ಲಿ ಕಲಾತ್ಮಕವಾದ ವಿನ್ಯಾಸಗಳ ಕೆಲಸವನ್ನು ಮಾಡುವುದರಲ್ಲಿಯೂ <verse eid="EXO 35:32"/><verse number="33" style="v" sid="EXO 35:33"/>ರತ್ನಗಳಲ್ಲಿ ಕೆತ್ತನೆಯನ್ನೂ ಮರದಲ್ಲಿ ಕೆತ್ತನೆಯನ್ನೂ ಸಕಲ ವಿಧವಾದ ಕೌಶಲ್ಯದ ಕೆಲಸದ ಜ್ಞಾನದಿಂದಲೂ ಅವನನ್ನು ತುಂಬಿಸಿದ್ದಾರೆ. <verse eid="EXO 35:33"/><verse number="34" style="v" sid="EXO 35:34"/>ಇದಲ್ಲದೆ ಕಲಿಸುವುದಕ್ಕೆ ಅವನಿಗೆ ಮತ್ತು ದಾನನ ಕುಲದವನಾದ ಅಹೀಸಾಮಾಕನ ಮಗನಾದ ಒಹೋಲಿಯಾಬನನ್ನು ನೇಮಿಸಿದ್ದಾರೆ. <verse eid="EXO 35:34"/><verse number="35" style="v" sid="EXO 35:35"/>ಕೆತ್ತನೆಯ ಕೆಲಸಗಳನ್ನು, ವಿನ್ಯಾಸದ ಕೆಲಸಗಳನ್ನು, ನೀಲಿ, ಧೂಮ್ರ, ರಕ್ತವರ್ಣದ ದಾರದಿಂದ, ನಯವಾದ ನಾರುಬಟ್ಟೆ ಇವುಗಳಲ್ಲಿ ಕಸೂತಿ ಕೆಲಸಗಳನ್ನು ಮಾಡುವುದಕ್ಕೆ ಮತ್ತು ನೇಯ್ಗೆಯ ಕೆಲಸ ಮಾಡುವುದಕ್ಕೆ ಎಂದರೆ ಅವುಗಳಲ್ಲಿ ಯಾವ ಕೆಲಸವನ್ನಾದರೂ ಕಲ್ಪಿಸಿ ಮಾಡುವದಕ್ಕೆ ಯೆಹೋವ ದೇವರು ಅವರಿಗೆ ಜ್ಞಾನವನ್ನು ಅನುಗ್ರಹಿಸಿದ್ದಾರೆ.<verse eid="EXO 35:35"/></para>
  <chapter eid="EXO 35"/>
  <chapter number="36" style="c" sid="EXO 36"/>
  <para style="nb">
    <verse number="1" style="v" sid="EXO 36:1"/>ತರುವಾಯ ಬೆಚಲಯೇಲ್ ಮತ್ತು ಒಹೋಲಿಯಾಬನೂ ಯೆಹೋವ ದೇವರು ಆಜ್ಞಾಪಿಸಿದಂತೆಯೇ ಎಲ್ಲವುಗಳನ್ನು ಮಾಡುವರು. ಅವರು ಪರಿಶುದ್ಧಸ್ಥಳದ ಸೇವೆಗೋಸ್ಕರ ಎಲ್ಲಾ ವಿಧವಾದ ಕೆಲಸವನ್ನು ಯೆಹೋವ ದೇವರಿಂದ ಜ್ಞಾನ ವಿವೇಕಗಳನ್ನು ಹೊಂದಿದ ಇತರರೊಂದಿಗೆ ಕೆಲಸಮಾಡುವರು,” ಎಂದು ಹೇಳಿದನು.<verse eid="EXO 36:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="EXO 36:2"/>ಬೆಚಲಯೇಲನನ್ನು, ಒಹೋಲಿಯಾಬನನ್ನು ಮತ್ತು ಯೆಹೋವ ದೇವರು ಜ್ಞಾನಕೊಟ್ಟಿದ್ದ ಪ್ರತಿಯೊಬ್ಬ ಶಿಲ್ಪಿಯನ್ನೂ ಆ ಕೆಲಸ ಮಾಡುವುದಕ್ಕೆ ಸಿದ್ಧ ಮನಸ್ಸಿದ್ದ ಪ್ರತಿಯೊಬ್ಬನನ್ನೂ ಮೋಶೆಯು ಕರೆದನು. <verse eid="EXO 36:2"/><verse number="3" style="v" sid="EXO 36:3"/>ಅವರು ಪರಿಶುದ್ಧ ಆಲಯದ ನಿರ್ಮಾಣಕ್ಕೋಸ್ಕರ ಇಸ್ರಾಯೇಲರು ತಂದ ಕಾಣಿಕೆಗಳನ್ನೆಲ್ಲಾ ಮೋಶೆಯ ಬಳಿಯಿಂದ ತೆಗೆದುಕೊಂಡರು. ಇದಲ್ಲದೆ ಅವರು ಪ್ರತಿದಿನ ಬೆಳಿಗ್ಗೆ ಉಚಿತವಾದ ಕಾಣಿಕೆಗಳನ್ನು ತರುತ್ತಿದ್ದರು. <verse eid="EXO 36:3"/><verse number="4" style="v" sid="EXO 36:4"/>ಆಗ ಪರಿಶುದ್ಧಸ್ಥಳದ ಕೆಲಸವನ್ನು ಮಾಡುವ ಜ್ಞಾನಿಗಳೆಲ್ಲರೂ ತಮ್ಮ ತಮ್ಮ ಕೆಲಸವನ್ನು ಬಿಟ್ಟು ಬಂದು, <verse eid="EXO 36:4"/><verse number="5" style="v" sid="EXO 36:5"/>ಮೋಶೆಯ ಸಂಗಡ ಮಾತನಾಡಿ, “ಯೆಹೋವ ದೇವರು ಮಾಡಬೇಕೆಂದು ಆಜ್ಞಾಪಿಸಿದ ಸೇವೆಯ ಕೆಲಸಕ್ಕೆ ಬೇಕಾಗಿರುವುದಕ್ಕಿಂತ ಹೆಚ್ಚಾಗಿ ಕಾಣಿಕೆಗಳನ್ನು ಈ ಜನರು ತರುತ್ತಿದ್ದಾರೆ,” ಎಂದು ಹೇಳಿದರು.<verse eid="EXO 36:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="EXO 36:6"/>ಆಗ ಮೋಶೆಯು, “ಇನ್ನು ಮೇಲೆ ಪರಿಶುದ್ಧಸ್ಥಳದ ಕಾಣಿಕೆಗೋಸ್ಕರ ಯಾವ ಪುರುಷನಾಗಲಿ, ಸ್ತ್ರೀಯಾಗಲಿ ಕೆಲಸ ಮಾಡಬಾರದೆಂದು ಪಾಳೆಯದಲ್ಲೆಲ್ಲಾ ಪ್ರಕಟಿಸಬೇಕು,” ಎಂದು ಆಜ್ಞಾಪಿಸಿದನು. ಹೀಗೆ ಜನರು ಕಾಣಿಕೆಗಳನ್ನು ತರುವುದನ್ನು ನಿಲ್ಲಿಸಿಬಿಟ್ಟರು. <verse eid="EXO 36:6"/><verse number="7" style="v" sid="EXO 36:7"/>ಏಕೆಂದರೆ ಎಲ್ಲಾ ಕೆಲಸವನ್ನು ಮಾಡುವುದಕ್ಕೆ ಸಾಕಾಗಿ ಮಿಕ್ಕುವಷ್ಟು ಸಾಮಗ್ರಿಗಳು ದೊರೆತವು.<verse eid="EXO 36:7"/></para>
  <para style="s1">ದೇವದರ್ಶನದ ಗುಡಾರವು</para>
  <para style="p">
    <verse number="8" style="v" sid="EXO 36:8"/>ಕೆಲಸದವರಲ್ಲಿದ್ದ ಶಿಲ್ಪಿಗಳೆಲ್ಲರೂ ಗುಡಾರವನ್ನು ಹತ್ತು ಪರದೆಗಳಿಂದ ಮಾಡಿ, ನಯವಾಗಿ ಹೊಸೆದ ನಾರಿನಿಂದಲೂ ನೀಲಿ, ಧೂಮ್ರ, ರಕ್ತವರ್ಣದ ದಾರದಿಂದ ಮತ್ತು ಕೌಶಲ್ಯದ ಕೆಲಸದಿಂದಲೂ ಕೆರೂಬಿಗಳನ್ನು ಮಾಡಿದರು. <verse eid="EXO 36:8"/><verse number="9" style="v" sid="EXO 36:9"/>ಎಲ್ಲಾ ಪರದೆಗಳೂ ಒಂದೇ ಅಳತೆಯವುಗಳಾಗಿದ್ದವು. ಪ್ರತಿಯೊಂದು ಪರದೆಯು ಸುಮಾರು ಹದಿಮೂರು ಮೀಟರ್ ಉದ್ದ ಮತ್ತು ಎರಡು ಮೀಟರ್ ಅಗಲವಿದ್ದವು.<note caller="+" style="f"><char style="fr" closed="false">36:9 </char><char style="ft" closed="false">ಸುಮಾರು ಇಪ್ಪತ್ತೆಂಟು ಮೊಳ ಉದ್ದ ಮತ್ತು ಅದರ ಅಗಲವು ನಾಲ್ಕು ಮೊಳವಾಗಿರಬೇಕು</char></note> <verse eid="EXO 36:9"/><verse number="10" style="v" sid="EXO 36:10"/>ಅವರು ಐದು ಪರದೆಗಳನ್ನು ಒಂದಕ್ಕೊಂದು ಜೋಡಿಸಿದರು ಮತ್ತು ಇನ್ನುಳಿದ ಐದು ಪರದೆಗಳನ್ನೂ ಒಂದಕ್ಕೊಂದು ಜೋಡಿಸಿದರು. <verse eid="EXO 36:10"/><verse number="11" style="v" sid="EXO 36:11"/>ಕೊನೆಯ ಪರದೆಯ ಅಂಚಿನ ಒಂದು ಜೋಡಣೆಯ ಸ್ಥಳದಲ್ಲಿ ನೀಲಿ ದಾರಿನ ಕುಣಿಕೆಗಳನ್ನು ಮಾಡಿದ್ದಲ್ಲದೆ, ಎರಡನೆಯ ಜೋಡಣೆಯ ಕಟ್ಟಕಡೆಯ ಪರದೆಯ ಅಂಚಿನಲ್ಲಿಯೂ ಅದೇ ಪ್ರಕಾರ ಮಾಡಿದರು. <verse eid="EXO 36:11"/><verse number="12" style="v" sid="EXO 36:12"/>ಒಂದು ಪರದೆಯಲ್ಲಿ ಐವತ್ತು ಕುಣಿಕೆಗಳನ್ನು ಮಾಡಿ, ಇನ್ನೊಂದು ಪರದೆಯ ಅಂಚನ್ನು ಜೋಡಿಸುವ ಸ್ಥಳದಲ್ಲಿ ಐವತ್ತು ಕುಣಿಕೆಗಳನ್ನು ಮಾಡಿದರು. ಆ ಕುಣಿಕೆಗಳು ಒಂದು ಪರದೆಯನ್ನು ಮತ್ತೊಂದು ಪರದೆಯು ಹಿಡಿದುಕೊಳ್ಳುವಂತೆ ಮಾಡಿದರು. <verse eid="EXO 36:12"/><verse number="13" style="v" sid="EXO 36:13"/>ಅವರು ಬಂಗಾರದ ಐವತ್ತು ಕೊಂಡಿಗಳನ್ನು ಮಾಡಿ, ಅವುಗಳಿಂದ ಎರಡು ಜೋಡಣೆ ಪರದೆಗಳನ್ನು ಒಂದಕ್ಕೊಂದು ಜೋಡಿಸಿದರು. ಹೀಗೆ ಅದು ಒಂದೇ ಗುಡಾರವಾಯಿತು.<verse eid="EXO 36:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="EXO 36:14"/>ಈ ಗುಡಾರದ ಮೇಲೆ ಹೊದಿಸುವುದಕ್ಕಾಗಿ ಅವರು ಮೇಕೆಯ ಕೂದಲಿನಿಂದ ಹನ್ನೊಂದು ಪರದೆಗಳನ್ನು ಮಾಡಿದರು. <verse eid="EXO 36:14"/><verse number="15" style="v" sid="EXO 36:15"/>ಒಂದೊಂದು ಪರದೆಯು ಸುಮಾರು ಹದಿಮೂರುವರೆ ಮೀಟರ್ ಉದ್ದ ಮತ್ತು ಒಂದುವರೆ ಮೀಟರ್ ಅಗಲ ಇರಬೇಕು. ಹನ್ನೊಂದು ಪರದೆಗಳೂ ಒಂದೇ ಅಳತೆಯಾಗಿದ್ದವು<note caller="+" style="f"><char style="fr" closed="false">36:15 </char><char style="ft" closed="false">ಸುಮಾರು 14 ಮೀಟರ್ ಉದ್ದ ಮತ್ತು 1.8 ಮೀಟರ್ ಅಗಲವಿದೆ</char></note>. <verse eid="EXO 36:15"/><verse number="16" style="v" sid="EXO 36:16"/>ಅವರು ಐದು ಪರದೆಗಳನ್ನು ಒಂದಾಗಿ ಜೋಡಿಸಿ ಇನ್ನುಳಿದ ಆರು ಪರದೆಗಳನ್ನು ಒಂದಾಗಿ ಜೋಡಿಸಿದರು. <verse eid="EXO 36:16"/><verse number="17" style="v" sid="EXO 36:17"/>ಅವರು ಕೊನೆಯ ಒಂದು ಪರದೆಯ ಅಂಚಿನಲ್ಲಿ ಐವತ್ತು ಕುಣಿಕೆಗಳನ್ನು, ಜೋಡಣೆಯಲ್ಲಿರುವ ಕೊನೆಯ ಎರಡನೆಯ ಪರದೆಯ ಅಂಚಿನಲ್ಲಿ ಐವತ್ತು ಕುಣಿಕೆಗಳನ್ನು ಮಾಡಿದರು. <verse eid="EXO 36:17"/><verse number="18" style="v" sid="EXO 36:18"/>ಅದು ಒಂದೇ ಡೇರೆ ಆಗುವಂತೆ ಅವುಗಳ ಜೋಡಣೆಗೆ ಅವರು ಕಂಚಿನ ಐವತ್ತು ಕೊಂಡಿಗಳನ್ನು ಮಾಡಿದರು. <verse eid="EXO 36:18"/><verse number="19" style="v" sid="EXO 36:19"/>ಅದಲ್ಲದೆ ಗುಡಾರದ ಮೇಲ್ಹೊದಿಕೆಯನ್ನು ಕೆಂಪು ಬಣ್ಣದಲ್ಲಿ ಅದ್ದಿ ತೆಗೆದ ಟಗರುಗಳ ಚರ್ಮದಿಂದ ಮಾಡಿದರು. ಅದರ ಮೇಲೆ ಕಡಲುಹಂದಿಯ ಚರ್ಮದ ಮೇಲ್ಹೊದಿಕೆಯನ್ನು ಮಾಡಿದರು.<verse eid="EXO 36:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="EXO 36:20"/>ಗುಡಾರವು ನಿಂತುಕೊಂಡಿರುವುದಕ್ಕೆ ಅವರು ಜಾಲಿ ಮರದಿಂದ ಚೌಕಟ್ಟುಗಳನ್ನು ಮಾಡಿದರು. <verse eid="EXO 36:20"/><verse number="21" style="v" sid="EXO 36:21"/>ಒಂದೊಂದು ಚೌಕಟ್ಟಿನ ಉದ್ದವು ಸುಮಾರು ನಾಲ್ಕುವರೆ ಮೀಟರ್ ಮತ್ತು ಅಗಲ ಅರವತ್ತೆಂಟು ಸೆಂಟಿಮೀಟರ್<note caller="+" style="f"><char style="fr" closed="false">36:21 </char><char style="ft" closed="false">ಸುಮಾರು 4.5 ಮೀಟರ್ ಉದ್ದ ಮತ್ತು 68 ಸೆಂಟಿಮೀಟರ್ ಅಗಲವಿದೆ</char></note> ಇತ್ತು. <verse eid="EXO 36:21"/><verse number="22" style="v" sid="EXO 36:22"/>ಒಂದು ಚೌಕಟ್ಟಿಗೆ ಒಂದಕ್ಕೊಂದು ಸರಿಯಾದ ಅಂತರದಲ್ಲಿ ಎರಡು ಕೈಗಳನ್ನು ಮಾಡಿದರು. ಅದೇ ಪ್ರಕಾರ ಅವರು ಗುಡಾರದ ಎಲ್ಲಾ ಚೌಕಟ್ಟುಗಳಿಗೆ ಮಾಡಿದರು. <verse eid="EXO 36:22"/><verse number="23" style="v" sid="EXO 36:23"/>ಅವರು ಗುಡಾರದ ದಕ್ಷಿಣ ಭಾಗದಲ್ಲಿ ಇಪ್ಪತ್ತು ಚೌಕಟ್ಟುಗಳನ್ನು ಮಾಡಿದರು. <verse eid="EXO 36:23"/><verse number="24" style="v" sid="EXO 36:24"/>ಅವರು ಇಪ್ಪತ್ತು ಚೌಕಟ್ಟುಗಳ ಕೆಳಗೆ ನಾಲ್ವತ್ತು ಬೆಳ್ಳಿಯ ಗದ್ದಿಗೇ ಕಲ್ಲುಗಳನ್ನು ಮಾಡಿದರು ಮತ್ತು ಒಂದೊಂದು ಚೌಕಟ್ಟಿನ ಕೆಳಗೆ ಅದರ ಎರಡು ಪಟ್ಟಿಗಳಿಗಾಗಿ ಎರಡೆರಡು ಕುಳಿಗಳನ್ನು ಮಾಡಿದರು. <verse eid="EXO 36:24"/><verse number="25" style="v" sid="EXO 36:25"/>ಇನ್ನೊಂದು ಭಾಗಕ್ಕೆ ಅಂದರೆ ಗುಡಾರದ ಉತ್ತರ ದಿಕ್ಕಿನಲ್ಲಿ ಇಪ್ಪತ್ತು ಚೌಕಟ್ಟುಗಳನ್ನು ಮಾಡಿದರು. <verse eid="EXO 36:25"/><verse number="26" style="v" sid="EXO 36:26"/>ಒಂದೊಂದು ಚೌಕಟ್ಟಿನ ಕೆಳಗೆ ಎರಡೆರಡು ಗದ್ದಿಗೇ ಕಲ್ಲುಗಳಂತೆ ನಲವತ್ತು ಬೆಳ್ಳಿಯ ಗದ್ದಿಗೇ ಕಲ್ಲುಗಳನ್ನು ಮಾಡಿದರು. <verse eid="EXO 36:26"/><verse number="27" style="v" sid="EXO 36:27"/>ಗುಡಾರದ ಹಿಂಭಾಗಕ್ಕೆ ಅಂದರೆ ಪಶ್ಚಿಮದ ಕಡೆಗೆ ಆರು ಚೌಕಟ್ಟುಗಳನ್ನು ಮಾಡಿದರು. <verse eid="EXO 36:27"/><verse number="28" style="v" sid="EXO 36:28"/>ಅವರು ಗುಡಾರದ ಹಿಂಭಾಗದ ಎರಡು ಮೂಲೆಗಳಿಗೆ ಬೇರೆ ಎರಡು ಚೌಕಟ್ಟುಗಳನ್ನು ಮಾಡಿದರು. <verse eid="EXO 36:28"/><verse number="29" style="v" sid="EXO 36:29"/>ಈ ಮೂಲೆಗಳನ್ನು ಅಡಿಯಲ್ಲಿ ಜೋಡಿಸಿರಬೇಕು. ಮೇಲ್ಭಾಗದಲ್ಲಿಯೂ ಒಂದೇ ಬಳೆಗೆ ಜೋಡಿಸಿದರು. ಇದೇ ರೀತಿಯಲ್ಲಿ ಅವರು ಎರಡು ಮೂಲೆಗಳಲ್ಲಿ ಎರಡಕ್ಕೂ ಮಾಡಿದರು. <verse eid="EXO 36:29"/><verse number="30" style="v" sid="EXO 36:30"/>ಇಂಥ ಎಂಟು ಚೌಕಟ್ಟುಗಳಿದ್ದವು. ಪ್ರತಿಯೊಂದು ಚೌಕಟ್ಟಿನ ಕೆಳಗೆ ಎರಡೆರಡು ಕೂರುಗದ್ದಿಗೇ ಕಲ್ಲುಗಳಂತೆ ಅವುಗಳಿಗೆ ಹದಿನಾರು ಬೆಳ್ಳಿಯ ಕೂರುಗದ್ದಿಗೇ ಕಲ್ಲುಗಳಿದ್ದವು.<verse eid="EXO 36:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="EXO 36:31"/>ಅವರು ಜಾಲಿ ಮರದಿಂದ ಅಗುಳಿಗಳನ್ನು ಮಾಡಿದರು, ಗುಡಾರದ ಒಂದು ಕಡೆಯ ಚೌಕಟ್ಟುಗಳಿಗೆ ಐದು ಅಗುಳಿಗಳು, <verse eid="EXO 36:31"/><verse number="32" style="v" sid="EXO 36:32"/>ಗುಡಾರದ ಇನ್ನೊಂದು ಭಾಗದ ಚೌಕಟ್ಟುಗಳಿಗೆ ಐದು ಅಗುಳಿಗಳನ್ನು, ಅದರ ಹಿಂದುಗಡೆಯ ಅಂದರೆ ಪಶ್ಚಿಮ ಭಾಗದಲ್ಲಿರುವ ಚೌಕಟ್ಟುಗಳಿಗೆ ಐದು ಅಗುಳಿಗಳನ್ನು ಮಾಡಿದರು. <verse eid="EXO 36:32"/><verse number="33" style="v" sid="EXO 36:33"/>ಮಧ್ಯದ ಅಗುಳಿಯು ಚೌಕಟ್ಟುಗಳ ನಡುವೆ ಒಂದು ಕಡೆಯಿಂದ ಮತ್ತೊಂದು ಕಡೆಯವರೆಗೆ ಹಾದು ಹೋಗುವಹಾಗೆ ಮಾಡಿದರು. <verse eid="EXO 36:33"/><verse number="34" style="v" sid="EXO 36:34"/>ಆ ಚೌಕಟ್ಟುಗಳನ್ನು ಬಂಗಾರದಿಂದ ಹೊದಿಸಿ, ಆ ಅಗುಳಿಗಳಿಗಾಗಿ ಬಂಗಾರದಿಂದ ಬಳೆಗಳನ್ನು ಮಾಡಿ, ಮಾಡಿದ ಅಗುಳಿಗಳನ್ನು ಬಂಗಾರದಿಂದ ಹೊದಿಸಿದರು.<verse eid="EXO 36:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="EXO 36:35"/>ಪರದೆಯನ್ನು ನೀಲಿ, ಧೂಮ್ರ, ರಕ್ತವರ್ಣದ ದಾರದಿಂದ ಮತ್ತು ನಯವಾದ ನಾರಿನಿಂದ ಹೊಸೆದು ಮಾಡಿದರು. ಅದರ ಮೇಲೆ ಕೌಶಲ್ಯದಿಂದ ಕಸೂತಿಹಾಕಿ ಮಾಡಿದ ಕೆರೂಬಿಗಳುಳ್ಳದ್ದನ್ನಾಗಿ ಅದನ್ನು ಮಾಡಿದರು. <verse eid="EXO 36:35"/><verse number="36" style="v" sid="EXO 36:36"/>ಅದಕ್ಕೆ ಜಾಲಿ ಮರದ ನಾಲ್ಕು ಸ್ತಂಭಗಳನ್ನು ಮಾಡಿ, ಬಂಗಾರ ತಗಡುಗಳಿಂದ ಅವುಗಳನ್ನು ಹೊದಿಸಿದರು. ಅವುಗಳಿಗೆ ಬಂಗಾರದ ಕೊಂಡಿಗಳನ್ನು ಮಾಡಿ, ಅವುಗಳಿಗೆ ಬೆಳ್ಳಿಯ ನಾಲ್ಕು ಗದ್ದಿಗೇ ಕಲ್ಲುಗಳನ್ನು ಎರಕ ಹೊಯ್ದರು. <verse eid="EXO 36:36"/><verse number="37" style="v" sid="EXO 36:37"/>ಗುಡಾರದ ಬಾಗಿಲಿಗೆ ನೀಲಿ, ಧೂಮ್ರ, ರಕ್ತವರ್ಣದ ದಾರದಿಂದ ಮತ್ತು ನಯವಾದ ನಾರುಗಳಿಂದ ಹೊಸೆದು ಕಸೂತಿ ಕೆಲಸಮಾಡಿದ ಪರದೆಯನ್ನು ಮಾಡಿದರು. <verse eid="EXO 36:37"/><verse number="38" style="v" sid="EXO 36:38"/>ಕೊಂಡಿಯಿರುವ ಐದು ಕಂಬಗಳನ್ನು ಮಾಡಿ, ಅವುಗಳ ತಲೆಗಳನ್ನೂ ಕಂಬಗಳನ್ನೂ ಬಂಗಾರದಿಂದ ಹೊದಿಸಿದರು. ಆದರೆ ಅವುಗಳ ಐದು ಗದ್ದಿಗೇ ಕಲ್ಲುಗಳನ್ನು ಕಂಚಿನಿಂದ ಮಾಡಿದರು.<verse eid="EXO 36:38"/></para>
  <chapter eid="EXO 36"/>
  <chapter number="37" style="c" sid="EXO 37"/>
  <para style="s1">ಶಾಸನಗಳ ಮಂಜೂಷವು</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 37:1"/>ಬೆಚಲಯೇಲನು ಜಾಲಿ ಮರದಿಂದ ಸುಮಾರು ಒಂದು ಮೀಟರ್ ಉದ್ದ ಮತ್ತು ಅರವತ್ತೆಂಟು ಸೆಂಟಿಮೀಟರ್ ಅಗಲ ಮತ್ತು ಎತ್ತರವಾಗಿರುವ<note caller="+" style="f"><char style="fr" closed="false">37:1 </char><char style="ft" closed="false">ಸುಮಾರು ಎರಡೂವರೆ ಮೊಳ ಉದ್ದ, ಒಂದೂವರೆ ಮೊಳ ಅಗಲ ಮತ್ತು ಒಂದೂವರೆ ಮೊಳ ಎತ್ತರ</char></note> ಮಂಜೂಷವನ್ನು ಮಾಡಿದನು. <verse eid="EXO 37:1"/><verse number="2" style="v" sid="EXO 37:2"/>ಅದನ್ನು ಶುದ್ಧ ಬಂಗಾರದಿಂದ ಒಳಗೂ ಹೊರಗೂ ಹೊದಿಸಿ, ಅದರ ಸುತ್ತಲೂ ಬಂಗಾರದ ತೋರಣವನ್ನು ಮಾಡಿದನು. <verse eid="EXO 37:2"/><verse number="3" style="v" sid="EXO 37:3"/>ಅದರ ನಾಲ್ಕು ಬಂಗಾರದ ಬಳೆಗಳನ್ನು ಎರಕಹೊಯಿಸಿ ಅದರ ನಾಲ್ಕು ಮೂಲೆಗಳಲ್ಲಿ ಎಂದರೆ ಒಂದು ಕಡೆಯಲ್ಲಿ ಎರಡು ಬಳೆಗಳನ್ನು ಮತ್ತೊಂದು ಕಡೆಯಲ್ಲಿ ಎರಡು ಬಳೆಗಳನ್ನು ಇರಿಸಿದನು. <verse eid="EXO 37:3"/><verse number="4" style="v" sid="EXO 37:4"/>ಆಮೇಲೆ ಜಾಲಿ ಮರದ ಕೋಲುಗಳನ್ನು ಮಾಡಿಸಿ, ಅವುಗಳಿಗೆ ಬಂಗಾರದಿಂದ ಹೊದಿಸಬೇಕು. <verse eid="EXO 37:4"/><verse number="5" style="v" sid="EXO 37:5"/>ಮಂಜೂಷವನ್ನು ಹೊರುವುದಕ್ಕಾಗಿ ಕೋಲುಗಳನ್ನು ಮಂಜೂಷದ ಎರಡು ಕಡೆಗಳಲ್ಲಿರುವ ಬಳೆಗಳಲ್ಲಿ ಸೇರಿಸಿದನು.<verse eid="EXO 37:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="EXO 37:6"/>ಇದಲ್ಲದೆ ಸುಮಾರು ನೂರಹತ್ತು ಸೆಂಟಿಮೀಟರ್ ಉದ್ದವೂ ಎಪ್ಪತ್ತು ಸೆಂಟಿಮೀಟರ್ ಅಗಲವೂ ಇರುವ ಕರುಣಾಸನವನ್ನು ಶುದ್ಧ ಬಂಗಾರದಿಂದ ಮಾಡಿದನು. <verse eid="EXO 37:6"/><verse number="7" style="v" sid="EXO 37:7"/>ಅವನು ಕರುಣಾಸನದ ಎರಡು ತುದಿಗಳಲ್ಲಿ ಎರಡು ಬಂಗಾರದಿಂದ ಕೆರೂಬಿಗಳನ್ನು ನಕಾಸಿ ಕೆಲಸದಿಂದ ಮಾಡಿದನು. <verse eid="EXO 37:7"/><verse number="8" style="v" sid="EXO 37:8"/>ಒಂದು ಬದಿಯ ಕೊನೆಯಲ್ಲಿ ಒಂದು ಕೆರೂಬಿಯನ್ನೂ ಇನ್ನೊಂದು ಬದಿಯ ಕೊನೆಯಲ್ಲಿ ಒಂದು ಕೆರೂಬಿಯನ್ನೂ ಮಾಡಿದನು. ಹೀಗೆ ಕರುಣಾಸನದ ಎರಡೂ ಬದಿಗಳಲ್ಲಿ ಕೆರೂಬಿಯನ್ನು ಮಾಡಿದನು. <verse eid="EXO 37:8"/><verse number="9" style="v" sid="EXO 37:9"/>ಆ ಕೆರೂಬಿಗಳು ತಮ್ಮ ರೆಕ್ಕೆಗಳನ್ನು ಮೇಲಕ್ಕೆ ಚಾಚಿರುವಂತೆಯೂ ಕರುಣಾಸನವನ್ನು ತಮ್ಮ ರೆಕ್ಕೆಗಳಿಂದ ಮುಚ್ಚುವಂತೆಯೂ ಇದ್ದವು. ಕೆರೂಬಿಗಳ ಮುಖಗಳು ಎದುರುಬದುರಾಗಿ ಕರುಣಾಸನವನ್ನು ನೋಡುತ್ತಿದ್ದವು.<verse eid="EXO 37:9"/></para>
  <para style="s1">ಮೇಜು</para>
  <para style="p">
    <verse number="10" style="v" sid="EXO 37:10"/>ಸುಮಾರು ತೊಂಬತ್ತು ಸೆಂಟಿಮೀಟರ್ ಉದ್ದ, ನಲವತ್ತೈದು ಸೆಂಟಿಮೀಟರ್ ಅಗಲ ಮತ್ತು ಅರವತ್ತೆಂಟು ಸೆಂಟಿಮೀಟರ್ ಎತ್ತರ ಇರುವ ಮೇಜನ್ನು ಜಾಲಿ ಮರದಿಂದ ಮಾಡಿದನು. <verse eid="EXO 37:10"/><verse number="11" style="v" sid="EXO 37:11"/>ಆಮೇಲೆ ಅದನ್ನು ಶುದ್ಧ ಬಂಗಾರದಿಂದ ಹೊದಿಸಿ, ಸುತ್ತಲೂ ಬಂಗಾರದ ತೋರಣ ಕಟ್ಟಿದನು. <verse eid="EXO 37:11"/><verse number="12" style="v" sid="EXO 37:12"/>ಸುತ್ತಲೂ ಅಂಗೈ ಅಗಲದ ಅಡ್ಡಪಟ್ಟಿಯನ್ನು ಮಾಡಿಸಿ, ಅಂಚಿನ ಸುತ್ತಲೂ ಬಂಗಾರದ ತೋರಣವನ್ನು ಕಟ್ಟಿದರು. <verse eid="EXO 37:12"/><verse number="13" style="v" sid="EXO 37:13"/>ಮೇಜಿಗೆ ಬಂಗಾರದ ನಾಲ್ಕು ಬಳೆಗಳನ್ನು ಎರಕ ಹೊಯ್ದು, ಅವುಗಳನ್ನು ಅದರ ನಾಲ್ಕು ಕಾಲುಗಳಲ್ಲಿರುವ ನಾಲ್ಕು ಮೂಲೆಗಳಿಗೆ ಜೋಡಿಸಿದರು. <verse eid="EXO 37:13"/><verse number="14" style="v" sid="EXO 37:14"/>ಮೇಜನ್ನು ಹೊತ್ತುಕೊಂಡು ಹೋಗಲು ಕೋಲುಗಳನ್ನು ಮಾಡಿ, ಈ ಬಳೆಗಳನ್ನು ಅಡ್ಡಪಟ್ಟಿಗೆ ಸಮೀಪದಲ್ಲಿ ಕೂಡಿಸಿದರು. <verse eid="EXO 37:14"/><verse number="15" style="v" sid="EXO 37:15"/>ಮೇಜನ್ನು ಹೊತ್ತುಕೊಂಡು ಹೋಗುವವರಿಗಾಗಿ ಜಾಲಿ ಮರದಿಂದ ಕೋಲುಗಳನ್ನು ಮಾಡಿ, ಅವುಗಳಿಗೆ ಬಂಗಾರದಿಂದ ಹೊದಿಸಲಾಯಿತು. <verse eid="EXO 37:15"/><verse number="16" style="v" sid="EXO 37:16"/>ಮೇಜಿನ ಮೇಲೆ ಇಡಬೇಕಾದ ಉಪಕರಣಗಳನ್ನು ಅಂದರೆ ಹರಿವಾಣ, ಧೂಪಾರತಿಗಳು, ಹೂಜೆಗಳು, ಪಾನದ್ರವ್ಯಗಳ ಅರ್ಪಣೆಗಾಗಿ ಬೇಕಾಗುವ ಬಟ್ಟಲುಗಳನ್ನು ಶುದ್ಧ ಬಂಗಾರದಿಂದ ಮಾಡಿದರು.<verse eid="EXO 37:16"/></para>
  <para style="s1">ದೀಪಸ್ತಂಭವು</para>
  <para style="p">
    <verse number="17" style="v" sid="EXO 37:17"/>ಚೊಕ್ಕ ಬಂಗಾರದಿಂದ ದೀಪಸ್ತಂಭವನ್ನು ಮಾಡಿದರು. ಅದರ ಬುಡವನ್ನೂ ಕಂಬವನ್ನೂ ನಕಾಸಿ ಕೆಲಸದಿಂದ ಮಾಡಿದರು. ದೀಪಸ್ತಂಭದ ಬುಡದಿಂದಲೇ ಅಖಂಡವಾಗಿ ಪುಷ್ಪದ ಗೊಂಚಲುಗಳಂತೆಯೂ ಹಣತೆಗಳಂತೆಯೂ ಮೊಗ್ಗುಗಳಂತೆಯೂ ಇದ್ದವು. <verse eid="EXO 37:17"/><verse number="18" style="v" sid="EXO 37:18"/>ಆ ದೀಪಸ್ತಂಭದಿಂದ ಆರು ಕೊಂಬೆಗಳು ಹೊರ ಬಂದಿದ್ದವು. ಅಂದರೆ ಒಂದು ಭಾಗದಿಂದ ಮೂರು ಕೊಂಬೆಗಳೂ ಮತ್ತೊಂದು ಭಾಗದಿಂದ ಮೂರು ಕೊಂಬೆಗಳೂ ಹೊರಗೆ ಬಂದಿದ್ದವು. <verse eid="EXO 37:18"/><verse number="19" style="v" sid="EXO 37:19"/>ಒಂದು ಕೊಂಬೆಯಲ್ಲಿ ಬಾದಾಮಿ ಪುಷ್ಟದಂತಿರುವ ಮೂರು ಹಣತೆಗಳು, ಮೊಗ್ಗು ಪುಷ್ಟಗಳಿದ್ದವು ಮತ್ತು ಮತ್ತೊಂದು ಕೊಂಬೆಯಲ್ಲಿ ಬಾದಾಮಿಯ ಪುಷ್ಟವಿದ್ದ ಮೂರು ಹಣತೆಗಳು ಮೊಗ್ಗು ಪುಷ್ಟಗಳಿದ್ದವು. ಈ ಪ್ರಕಾರ ದೀಪಸ್ತಂಭದಿಂದ ಹೊರಗೆ ಬರುವ ಆರು ಕೊಂಬೆಗಳಲ್ಲಿಯೂ ಇದ್ದವು. <verse eid="EXO 37:19"/><verse number="20" style="v" sid="EXO 37:20"/>ದೀಪಸ್ತಂಭದಲ್ಲಿಯೇ ಬಾದಾಮಿ ಹೂವುಗಳಂತೆಯೂ ಮೊಗ್ಗುಗಳಂತೆಯೂ ಅದಕ್ಕೊಂದು ಪುಷ್ಪದ ಆಕಾರದಲ್ಲಿ ನಾಲ್ಕು ಹಣತೆಗಳು ಇದ್ದವು. <verse eid="EXO 37:20"/><verse number="21" style="v" sid="EXO 37:21"/>ದೀಪಸ್ತಂಭದಿಂದ ಹೊರಬರುವ ಒಂದು ಮೊಗ್ಗು ಮೊದಲ ಜೋಡಿ ಕೊಂಬೆಗಳ ಅಡಿಯಲ್ಲಿತ್ತು, ಎರಡನೇ ಮೊಗ್ಗು ಎರಡನೇ ಜೋಡಿಯ ಅಡಿಯಲ್ಲಿ ಮತ್ತು ಮೂರನೆಯ ಮೊಗ್ಗು ಮೂರನೆಯ ಜೋಡಿಯ ಅಡಿಯಲ್ಲಿ ಹೀಗೆ ಆರು ಕೊಂಬೆಗಳಿದ್ದವು. <verse eid="EXO 37:21"/><verse number="22" style="v" sid="EXO 37:22"/>ಅದರ ಮೊಗ್ಗುಗಳೂ ಕೊಂಬೆಗಳೂ ಅದರಿಂದಲೇ ಬಂದಿದ್ದವು. ದೀಪಸ್ತಂಭವನ್ನೆಲ್ಲಾ ಶುದ್ಧ ಬಂಗಾರದ ಒಂದೇ ಅಚ್ಚಿನಲ್ಲಿ ಬರೆದ ಕಲಾಕೃತಿಯಾಗಿತ್ತು.<verse eid="EXO 37:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="EXO 37:23"/>ಅವರು ಏಳು ದೀಪಗಳನ್ನೂ ಕುಡಿ ಕತ್ತರಿಸುವ ಕತ್ತರಿಗಳನ್ನೂ ಬೂದಿಯ ಪಾತ್ರೆಗಳನ್ನೂ ಶುದ್ಧ ಬಂಗಾರದಿಂದಲೇ ಮಾಡಿದರು. <verse eid="EXO 37:23"/><verse number="24" style="v" sid="EXO 37:24"/>ದೀಪಸ್ತಂಭವನ್ನೂ ಅದರ ಎಲ್ಲಾ ಸಲಕರಣೆಗಳನ್ನೂ ಒಂದು ತಲಾಂತು ಶುದ್ಧ ಬಂಗಾರದಿಂದ ಮಾಡಿದರು.<verse eid="EXO 37:24"/></para>
  <para style="s1">ಧೂಪವೇದಿ</para>
  <para style="p">
    <verse number="25" style="v" sid="EXO 37:25"/>ಜಾಲಿ ಮರದ ಕಟ್ಟಿಗೆಯಿಂದ ಧೂಪವೇದಿಯನ್ನು ಮಾಡಿದರು. ಅದರ ಉದ್ದ ಮತ್ತು ಅಗಲ ಸುಮಾರು ನಲವತ್ತೈದು ಸೆಂಟಿಮೀಟರ್, ಅದರ ಎತ್ತರ ಸುಮಾರು ತೊಂಬತ್ತು ಸೆಂಟಿಮೀಟರ್ ಇದ್ದು, ಅದು ಚಚ್ಚೌಕವಾಗಿತ್ತು. ಅದರ ಕೊಂಬುಗಳನ್ನು ಸಹ ಜಾಲಿ ಮರದಿಂದಲೇ ಮಾಡಲಾಗಿತ್ತು. <verse eid="EXO 37:25"/><verse number="26" style="v" sid="EXO 37:26"/>ಅದರ ಮೇಲ್ಭಾಗವನ್ನೂ ಅದರ ಸುತ್ತಲಿನ ಬದಿಗಳನ್ನೂ ಕೊಂಬುಗಳನ್ನೂ ಶುದ್ಧ ಬಂಗಾರದಿಂದ ಹೊದಿಸಿದರು. ಅದರ ಸುತ್ತಲೂ ಬಂಗಾರದ ಗೋಟನ್ನು ಕಟ್ಟಿಸಿದರು. <verse eid="EXO 37:26"/><verse number="27" style="v" sid="EXO 37:27"/>ಅದರ ಗೋಟಿನ ಕೆಳಗೆ ಎರಡು ಬದಿಗಿರುವ ಎರಡು ಮೂಲೆಗಳಲ್ಲಿ ಎರಡು ಬಂಗಾರದ ಬಳೆಗಳನ್ನು ಮಾಡಿದರು, ಇವುಗಳನ್ನು ಹೊರುವುದಕ್ಕಾಗಿ ಅವುಗಳಲ್ಲಿ ಕೋಲುಗಳನ್ನು ಸಿಕ್ಕಿಸಿದರು. <verse eid="EXO 37:27"/><verse number="28" style="v" sid="EXO 37:28"/>ಕೋಲುಗಳನ್ನು ಜಾಲಿ ಮರದಿಂದ ಮಾಡಿ, ಅವುಗಳನ್ನು ಬಂಗಾರದಿಂದ ಹೊದಿಸಿದರು.<verse eid="EXO 37:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="EXO 37:29"/>ಅನಂತರ ಅವರು ಸುಗಂಧಕಾರನ ವಿದ್ಯೆಯ ಪ್ರಕಾರ ಪರಿಶುದ್ಧವಾದ ಅಭಿಷೇಕ ತೈಲವನ್ನು ಮತ್ತು ಪರಿಮಳ ದ್ರವ್ಯದಿಂದ ಶುದ್ಧವಾದ ಧೂಪವನ್ನು ತಯಾರಿಸಿದರು.<verse eid="EXO 37:29"/></para>
  <chapter eid="EXO 37"/>
  <chapter number="38" style="c" sid="EXO 38"/>
  <para style="s1">ದಹನಬಲಿಯ ಪೀಠ</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 38:1"/>ಬೆಚಲೇಲನು ಜಾಲಿ ಮರದಿಂದ ದಹನಬಲಿಯ ಪೀಠವನ್ನು ಮಾಡಿದರು. ಅದರ ಎತ್ತರವು ಸುಮಾರು ಒಂದು ಮೀಟರ್ ಇರಬೇಕು. ಅದರ ಉದ್ದ ಮತ್ತು ಅಗಲವು ಸುಮಾರು ಎರಡೂವರೆ ಮೀಟರ್ ಚಚ್ಚೌಕವಾಗಿರಬೇಕು<note caller="+" style="f"><char style="fr" closed="false">38:1 </char><char style="ft" closed="false">ಅಥವಾ ಸುಮಾರು 1.4 ಮೀಟರ್</char></note>. <verse eid="EXO 38:1"/><verse number="2" style="v" sid="EXO 38:2"/>ಅದರ ನಾಲ್ಕು ಮೂಲೆಗಳಲ್ಲಿ ಕೊಂಬುಗಳನ್ನು ಮಾಡಿದರು. ಆ ಕೊಂಬುಗಳು ಆ ಬಲಿಪೀಠಕ್ಕೆ ಏಕವಾಗಿರಬೇಕು. ಅವುಗಳನ್ನು ಕಂಚಿನಿಂದ ಹೊದಿಸಿದರು. <verse eid="EXO 38:2"/><verse number="3" style="v" sid="EXO 38:3"/>ಅನಂತರ ಅವರು ಬಲಿಪೀಠದ ಉಪಕರಣಗಳನ್ನೆಲ್ಲಾ ಅಂದರೆ ಬಟ್ಟಲುಗಳು, ಸಲಿಕೆಗಳು, ಮುಳ್ಳುಚಮಚಗಳು, ಬೋಗುಣಿಗಳು, ಅಗ್ಗಿಷ್ಟಿಕೆಗಳು ಇವುಗಳೆನ್ನೆಲ್ಲಾ ಕಂಚಿನಿಂದ ಮಾಡಿದರು. <verse eid="EXO 38:3"/><verse number="4" style="v" sid="EXO 38:4"/>ಬಲಿಪೀಠಕ್ಕೆ ಹೆಣಿಗೆ ಕೆಲಸದಿಂದ ಕಂಚಿನ ಜಾಳಿಗೆಯನ್ನು ಮಾಡಿದರು. ಅದು ಬಲಿಪೀಠದ ಸುತ್ತಲಿರುವ ಕಟ್ಟಿಗೆಯ ಕಟ್ಟೆಯ ಕೆಳಗೆ ಇದ್ದು, ಅದನ್ನು ಬಲಿಪೀಠದ ಕೆಳಭಾಗದಿಂದ ಮಧ್ಯದವರೆಗೆ ಇರುವಂತೆ ಮಾಡಿದರು. <verse eid="EXO 38:4"/><verse number="5" style="v" sid="EXO 38:5"/>ವೇದಿಯನ್ನು ಹೊರುವಾಗ ಕೋಲು ಸಿಕ್ಕಿಸುವುದಕ್ಕೋಸ್ಕರ ಅದರ ನಾಲ್ಕು ಮೂಲೆಗಳಲ್ಲಿ ನಾಲ್ಕು ಬಳೆಗಳನ್ನು ಕಂಚಿನಿಂದ ಎರಕ ಹೊಯ್ದರು. <verse eid="EXO 38:5"/><verse number="6" style="v" sid="EXO 38:6"/>ಅವರು ಜಾಲಿ ಮರದಿಂದ ಕೋಲುಗಳನ್ನು ಮಾಡಿ, ಅವುಗಳನ್ನು ಕಂಚಿನಿಂದ ಹೊದಿಸಿದರು. <verse eid="EXO 38:6"/><verse number="7" style="v" sid="EXO 38:7"/>ಬಲಿಪೀಠವನ್ನು ಹೊರುವುದಕ್ಕೆ ಅದರ ಎರಡೂ ಬದಿಯಲ್ಲಿ ಮಾಡಿದ ಕೋಲುಗಳನ್ನು ಬಳೆಗಳಲ್ಲಿ ಸೇರಿಸಿದರು. ಅವರು ಆ ಬಲಿಪೀಠವನ್ನು ಚೌಕಟ್ಟುಗಳಿಂದ ಪೊಳ್ಳಾಗಿರುವಂತೆ ಮಾಡಿದರು.<verse eid="EXO 38:7"/></para>
  <para style="s1">ಗಂಗಾಳವು</para>
  <para style="p">
    <verse number="8" style="v" sid="EXO 38:8"/>ದೇವದರ್ಶನದ ಗುಡಾರದ ಬಾಗಿಲ ಬಳಿಯಲ್ಲಿ ಸೇವೆಮಾಡುತ್ತಿದ್ದ ಸ್ತ್ರೀಯರಿಂದ ಕೂಡಿಸಿದ ಕಂಚಿನ ದರ್ಪಣಗಳಿಂದ ಕಂಚಿನಿಂದ ಬೋಗುಣಿಯನ್ನು ಅದರ ಪೀಠವನ್ನೂ ಮಾಡಿದರು.<verse eid="EXO 38:8"/></para>
  <para style="s1">ಗುಡಾರದ ಅಂಗಳವು</para>
  <para style="p">
    <verse number="9" style="v" sid="EXO 38:9"/>ಅವರು ಗುಡಾರದ ಅಂಗಳವನ್ನು ಮಾಡಿದರು. ಹೇಗೆಂದರೆ ದಕ್ಷಿಣ ದಿಕ್ಕಿನಲ್ಲಿರುವ ಅಂಗಳಕ್ಕೋಸ್ಕರ ನಯವಾಗಿ ಹೊಸೆದ ನಾರಿನ ಪರದೆಗಳನ್ನು ಮಾಡಲಾಗಿತ್ತು. ಅವು ಸುಮಾರು ನಲವತ್ತೈದು ಮೀಟರ್ ಉದ್ದವಾಗಿದ್ದವು. <verse eid="EXO 38:9"/><verse number="10" style="v" sid="EXO 38:10"/>ಆ ಕಡೆಯಲ್ಲಿ ಇಪ್ಪತ್ತು ಸ್ತಂಭಗಳಿದ್ದವು ಮತ್ತು ಅವುಗಳಿಗೆ ಇಪ್ಪತ್ತು ಕಂಚಿನ ಗದ್ದಿಗೇ ಕಲ್ಲುಗಳಿದ್ದವು. ಸ್ತಂಭಗಳ ಕೊಂಡಿಗಳನ್ನು ಮತ್ತು ಅವುಗಳ ಪಟ್ಟಿಗಳನ್ನು ಬೆಳ್ಳಿಯಿಂದ ಮಾಡಲಾಗಿತ್ತು. <verse eid="EXO 38:10"/><verse number="11" style="v" sid="EXO 38:11"/>ಉತ್ತರ ದಿಕ್ಕಿನ ಪರದೆಗಳು ಸುಮಾರು ನಲವತ್ತೈದು ಮೀಟರ್ ಉದ್ದವಾಗಿದ್ದವು. ಇಪ್ಪತ್ತು ಸ್ತಂಭಗಳು ಮತ್ತು ಇಪ್ಪತ್ತು ಕಂಚಿನ ಗದ್ದಿಗೇ ಕಲ್ಲುಗಳಿದ್ದವು. ಆ ಸ್ತಂಭಗಳ ಕೊಂಡಿಗಳು ಮತ್ತು ಕಟ್ಟುಗಳು ಬೆಳ್ಳಿಯಿಂದ ಮಾಡಿದ್ದಾಗಿದ್ದವು.<verse eid="EXO 38:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="EXO 38:12"/>ಅಂಗಳದ ಪಶ್ಚಿಮ ಭಾಗದಲ್ಲಿ ಸುಮಾರು ಇಪ್ಪತ್ತಮೂರು ಮೀಟರ್ ಉದ್ದವಾದ ಪರದೆಗಳಿದ್ದವು. ಹತ್ತು ಸ್ತಂಭಗಳು ಮತ್ತು ಆ ಸ್ತಂಭಗಳಿಗೆ ಹತ್ತು ಗದ್ದಿಗೇ ಕಲ್ಲುಗಳಿದ್ದವು. ಸ್ತಂಭಗಳ ಕೊಂಡಿ ಮತ್ತು ಅಲಂಕಾರದ ಮೇಲಿನ ಕಟ್ಟುಗಳು ಬೆಳ್ಳಿಯದ್ದಾಗಿದ್ದವು. <verse eid="EXO 38:12"/><verse number="13" style="v" sid="EXO 38:13"/>ಪೂರ್ವದಿಕ್ಕಿನಲ್ಲಿ ಸೂರ್ಯೋದಯದ ಕಡೆಗೆ ಅಂಗಳದ ಅಗಲವು ಸುಮಾರು ಇಪ್ಪತ್ತಮೂರು ಮೀಟರವಾಗಿತ್ತು. <verse eid="EXO 38:13"/><verse number="14" style="v" sid="EXO 38:14"/>ದ್ವಾರದ ಒಂದು ಬದಿಯ ಪರದೆಗಳು ಸುಮಾರು ಆರುವರೆ ಮೀಟರ್ ಉದ್ದವಾಗಿದ್ದವು. ಅವುಗಳಿಗೆ ಮೂರು ಸ್ತಂಭಗಳು, ಆ ಸ್ತಂಭಗಳಿಗೆ ಮೂರು ಗದ್ದಿಗೇ ಕಲ್ಲುಗಳು ಇದ್ದವು. <verse eid="EXO 38:14"/><verse number="15" style="v" sid="EXO 38:15"/>ಅಂಗಳದ ದ್ವಾರದ ಎರಡೂ ಕಡೆಗಳಲ್ಲಿ ಸುಮಾರು ಆರುವರೆ ಮೀಟರ್ ಉದ್ದವಾದ ಪರದೆಗಳಿದ್ದವು, ಅವುಗಳಿಗೆ ಮೂರು ಸ್ತಂಭಗಳು ಮತ್ತು ಮೂರು ಗದ್ದಿಗೇ ಕಲ್ಲುಗಳಿದ್ದವು. <verse eid="EXO 38:15"/><verse number="16" style="v" sid="EXO 38:16"/>ಅಂಗಳದ ಸುತ್ತಲಿದ್ದ ಎಲ್ಲ ಪರದೆಗಳು ನಯವಾಗಿ ಹೊಸೆದ ನಾರಿನ ಬಟ್ಟೆಯಿಂದ ಮಾಡಲಾಗಿದ್ದವು. <verse eid="EXO 38:16"/><verse number="17" style="v" sid="EXO 38:17"/>ಸ್ತಂಭಗಳ ಗದ್ದಿಗೇ ಕಲ್ಲುಗಳು ಕಂಚಿನದ್ದಾಗಿದ್ದವು. ಸ್ತಂಭಗಳ ಕೊಂಡಿಗಳು ಮತ್ತು ಕಟ್ಟುಗಳು ಬೆಳ್ಳಿಯದ್ದಾಗಿದ್ದವು. ಸ್ತಂಭದ ಬೋದಿಗೆಗಳು ಬೆಳ್ಳಿಯಿಂದ ಹೊದಿಸಲಾಗಿತ್ತು. ಅಂಗಳದ ಎಲ್ಲಾ ಸ್ತಂಭಗಳಿಗೆ ಬೆಳ್ಳಿಯ ಕಟ್ಟುಗಳಿದ್ದವು.<verse eid="EXO 38:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="EXO 38:18"/>ಗುಡಾರದ ಅಂಗಳದ ದ್ವಾರಕ್ಕಾಗಿ ನೀಲಿ, ಧೂಮ್ರ, ರಕ್ತವರ್ಣದ ದಾರದಿಂದ ಮತ್ತು ನಯವಾದ ನಾರಿನಿಂದ ಹೊಸೆದು ಕಸೂತಿ ಕೆಲಸಮಾಡಿದ ಇಪ್ಪತ್ತು ಮೊಳದ ಪರದೆ ಮಾಡಲಾಗಿತ್ತು. ಅದರ ಉದ್ದವು ಇಪ್ಪತ್ತು ಮೊಳವಾಗಿತ್ತು. ಅಗಲ, ಎತ್ತರಗಳಲ್ಲಿ ಅಂಗಳದ ಉಳಿದ ಪರದೆಗಳಿಗೆ ಸರಿಯಾಗುವಂತೆ ಐದು ಮೊಳ ಇತ್ತು. <verse eid="EXO 38:18"/><verse number="19" style="v" sid="EXO 38:19"/>ಅವುಗಳಿಗೆ ನಾಲ್ಕು ಸ್ತಂಭಗಳು, ಆ ಕಂಬಗಳಿಗೆ ನಾಲ್ಕು ಕಂಚಿನ ಗದ್ದಿಗೇ ಕಲ್ಲುಗಳಿದ್ದವು. ಅವುಗಳ ಕೊಂಡಿಗಳು ಬೆಳ್ಳಿಯದ್ದಾಗಿದ್ದವು. ಅವುಗಳ ಬೋದಿಗಳ ಹೊದಿಕೆ ಮತ್ತು ಅಲಂಕಾರದ ಪಟ್ಟಿಗಳು ಬೆಳ್ಳಿಯದ್ದಾಗಿದ್ದವು. <verse eid="EXO 38:19"/><verse number="20" style="v" sid="EXO 38:20"/>ಗುಡಾರದ ಮತ್ತು ಅಂಗಳದ ಸುತ್ತಲೂ ಇರುವ ಎಲ್ಲಾ ಗೂಟಗಳೂ ಕಂಚಿನಿಂದ ಮಾಡಿದ್ದಾಗಿದ್ದವು.<verse eid="EXO 38:20"/></para>
  <para style="s1">ಲೋಹಗಳ ಬಳಕೆ</para>
  <para style="p">
    <verse number="21" style="v" sid="EXO 38:21"/>ದೇವದರ್ಶನದ ಗುಡಾರಕ್ಕೆ ಅಂದರೆ ಒಡಂಬಡಿಕೆಯ ನಿಯಮದ ಗುಡಾರ ನಿರ್ಮಾಣಕ್ಕೆ ಬಳಸಿದ ವಸ್ತುಗಳ ಲೆಕ್ಕ ಇವು: ಮೋಶೆಯ ಆಜ್ಞೆಯ ಮೇರೆಗೆ ಯಾಜಕನಾದ ಆರೋನನ ಮಗನಾದ ಈತಾಮಾರನ ನಿರ್ದೇಶನದಲ್ಲಿ ಲೇವಿಯರ ಕೈಯಿಂದ ಲೆಕ್ಕ ಮಾಡಿಸಿದ್ದು. <verse eid="EXO 38:21"/><verse number="22" style="v" sid="EXO 38:22"/>ಯೆಹೋವ ದೇವರು ಮೋಶೆಗೆ ಆಜ್ಞಾಪಿಸಿದ್ದನ್ನೆಲ್ಲಾ ಯೆಹೂದ ಕುಲದವನಾದ ಊರಿಯ ಮಗನೂ ಹೂರನ ಮೊಮ್ಮಗನೂ ಆದ ಬೆಚಲಯೇಲನು ಮಾಡಿದನು. <verse eid="EXO 38:22"/><verse number="23" style="v" sid="EXO 38:23"/>ಅವನ ಜೊತೆಯಲ್ಲಿ ದಾನ್ ಕುಲದವನಾದ ಅಹೀಸಾಮಾಕನ ಮಗ ಒಹೋಲಿಯಾಬನೂ ಇದ್ದನು. ಇವನು ಕೆತ್ತನೆ ಕೆಲಸ ಮಾಡುವವನೂ ಕುಶಲ ಕೆಲಸಗಾರನೂ ನೀಲಿ, ಧೂಮ್ರ ಮತ್ತು ರಕ್ತವರ್ಣದ ನಯವಾದ ನಾರಿನಿಂದ ಹೊಸೆದು ಕಸೂತಿ ಕೆಲಸ ಮಾಡುವವನೂ ಆಗಿದ್ದನು. <verse eid="EXO 38:23"/><verse number="24" style="v" sid="EXO 38:24"/>ಪರಿಶುದ್ಧಾಲಯದ ಸೇವೆಗೆ ನೇಮಕವಾದ ಪರಿಶುದ್ಧ ಕೆಲಸಕ್ಕೆ ಉಪಯೋಗಿಸಿದ ಎಲ್ಲಾ ಬಂಗಾರವು ವಿಶೇಷವಾಗಿ ಅರ್ಪಿಸಿದ ಕಾಣಿಕೆಯಾಗಿತ್ತು, ಅದು ಇಪ್ಪತ್ತೊಂಬತ್ತು ತಲಾಂತು ಮತ್ತು ಏಳುನೂರ ಮೂವತ್ತು ಶೆಕೆಲ್ ಇತ್ತು<note caller="+" style="f"><char style="fr" closed="false">38:24 </char><char style="ft" closed="false">ಚಿನ್ನದ ತೂಕವು ಒಂದು ಟನ್‌ಗಿಂತ ಸ್ವಲ್ಪ ಹೆಚ್ಚಿತ್ತು</char></note>.<verse eid="EXO 38:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="EXO 38:25"/>ಪರಿಶುದ್ಧಾಲಯದ ನಿಯಮದ ಮೇರೆಗೆ ಸಮೂಹದ ಜನಗಣತಿಯಲ್ಲಿ ದಾಖಲಿಸಿದ ಜನರಿಂದ ಸಂಗ್ರಹಿದ ಬೆಳ್ಳಿಯ ತೂಕವು ಸುಮಾರು 3,400 ಕಿಲೋಗ್ರಾಂ ಇತ್ತು. <verse eid="EXO 38:25"/><verse number="26" style="v" sid="EXO 38:26"/>ಪರಿಶುದ್ಧಾಲಯದ ನಿಯಮದ ಮೇರೆಗೆ ಪ್ರತಿಯೊಬ್ಬ ಮನುಷ್ಯನಿಂದ ಒಂದೊಂದು “ಬೆಕಾ” ಅಂದರೆ ಅರ್ಧ ಶೆಕೆಲ್ ಆಗಿತ್ತು. ಕೊಟ್ಟವರ ಲೆಕ್ಕವನ್ನು ಇಪ್ಪತ್ತು ವರ್ಷದವರು ಮತ್ತು ಅದಕ್ಕೆ ಮೇಲಿನ ಪ್ರಾಯದವರನ್ನು ಲೆಕ್ಕ ಮಾಡಲಾಗಿ ಅದು 6,03,550 ಗಂಡಸರ ಸಂಖ್ಯೆ ಇತ್ತು. <verse eid="EXO 38:26"/><verse number="27" style="v" sid="EXO 38:27"/>ಪರಿಶುದ್ಧಾಲಯದ ಗದ್ದಿಗೇ ಕಲ್ಲುಗಳಿಗೆ ಮತ್ತು ಪರದೆಗಳ ಗದ್ದಿಗೇ ಕಲ್ಲುಗಳಿಗೆ ಎರಕ ಹೊಯ್ಯಲು 3,400 ಕಿಲೋಗ್ರಾಂ ಬೆಳ್ಳಿ ಹಿಡಿಯಿತು. ಒಂದು ಗದ್ದಿಗೇ ಕಲ್ಲಿಗೆ ಮೂವತ್ನಾಲ್ಕು ಕಿಲೋಗ್ರಾಂನಂತೆ ನೂರು ಗದ್ದಿಗೇ ಕಲ್ಲುಗಳಿಗೆ 3,400 ಕಿಲೋಗ್ರಾಂ ಬೆಳ್ಳಿ ಆಯಿತು. <verse eid="EXO 38:27"/><verse number="28" style="v" sid="EXO 38:28"/>ಒಂದರ ತೂಕ ಸುಮಾರು 34 ಕಿಲೋಗ್ರಾಂ ಇತ್ತು. ಅವನು ಕಂಬಗಳಿಗೆ ಕೊಂಡಿಗಳನ್ನೂ ಕಂಬದ ಬೋದಿಗೆ ಮೇಲ್ಹೊದಿಕೆಯನ್ನೂ ಅಲಂಕಾರದ ಪಟ್ಟಿಗಳನ್ನೂ ಮಾಡಿದರು.<verse eid="EXO 38:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="EXO 38:29"/>ವಿಶೇಷ ಕಾಣಿಕೆಯಾಗಿ ಬಂದ ಕಂಚು 2,425 ಕಿಲೋಗ್ರಾಂ ತೂಕವಿತ್ತು. <verse eid="EXO 38:29"/><verse number="30" style="v" sid="EXO 38:30"/>ಆ ಕಂಚಿನಿಂದ ಅವರು ದೇವದರ್ಶನದ ಗುಡಾರದ ದ್ವಾರಗಳಿಗೆ ಗದ್ದಿಗೇ ಕಲ್ಲುಗಳನ್ನೂ ಬಲಿಪೀಠವನ್ನೂ ಅದಕ್ಕೆ ಕಂಚಿನ ಜಾಳಿಗೆಯನ್ನೂ ಬಲಿಪೀಠದ ಸಮಸ್ತ ಪಾತ್ರೆಗಳನ್ನೂ ಮಾಡಿದರು. <verse eid="EXO 38:30"/><verse number="31" style="v" sid="EXO 38:31"/>ಅಂಗಳದ ಸುತ್ತಲಿನ ಗದ್ದಿಗೇ ಕಲ್ಲುಗಳನ್ನೂ, ಗುಡಾರದ ಮತ್ತು ಅಂಗಳದ ಸುತ್ತಲಿನ ಎಲ್ಲಾ ಗೂಟಗಳನ್ನೂ ಮಾಡಿದರು.<verse eid="EXO 38:31"/></para>
  <chapter eid="EXO 38"/>
  <chapter number="39" style="c" sid="EXO 39"/>
  <para style="s1">ಯಾಜಕರ ವಸ್ತ್ರಗಳು</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 39:1"/>ಯೆಹೋವ ದೇವರು ಮೋಶೆಗೆ ಆಜ್ಞಾಪಿಸಿದ ಮೇರೆಗೆ ನೀಲಿ, ಧೂಮ್ರ, ರಕ್ತವರ್ಣದ ದಾರಿನಿಂದ ಪವಿತ್ರ ಆಲಯದ ಸೇವೆ ಮಾಡುವುದಕ್ಕೆ ಕಲಾತ್ಮಕವಾಗಿ ನೇಯ್ದ ಸೇವಾ ವಸ್ತ್ರಗಳನ್ನು ಮತ್ತು ಆರೋನನಿಗೆ ಪರಿಶುದ್ಧ ವಸ್ತ್ರಗಳನ್ನು ಮಾಡಿದರು.<verse eid="EXO 39:1"/></para>
  <para style="s1">ಏಫೋದ್</para>
  <para style="p">
    <verse number="2" style="v" sid="EXO 39:2"/>ಬೆಚಲೇಲನು ಏಫೋದನ್ನು ಬಂಗಾರ, ನೀಲಿ, ಧೂಮ್ರ, ರಕ್ತವರ್ಣದ ದಾರದಿಂದ ಮತ್ತು ನಯವಾದ ನಾರುಬಟ್ಟೆಯನ್ನು ಹೊಸೆದು ಉಪಯೋಗಿಸಿದ್ದರು. <verse eid="EXO 39:2"/><verse number="3" style="v" sid="EXO 39:3"/>ಅವರು ಬಂಗಾರವನ್ನು ಹೊಡೆದು, ತೆಳುವಾದ ತಗಡುಗಳನ್ನಾಗಿ ಮಾಡಿ, ಅದನ್ನು ಕತ್ತರಿಸಿ ಎಳೆಗಳನ್ನಾಗಿ ಮಾಡಿ, ಆ ಎಳೆಗಳನ್ನು ನೀಲಿ, ಧೂಮ್ರ, ರಕ್ತವರ್ಣದ ದಾರದಿಂದ ಮತ್ತು ನಯವಾದ ನಾರಿನಿಂದ ಹೊಸೆದು ಕಸೂತಿ ಕೆಲಸ ಮಾಡುವುದಕ್ಕೆ ಉಪಯೋಗಿಸಿದ್ದರು. <verse eid="EXO 39:3"/><verse number="4" style="v" sid="EXO 39:4"/>ಆ ಕವಚಕ್ಕೆ ಅದರ ಎರಡೂ ಕೊನೆಗಳನ್ನು ಜೋಡಿಸುವುದಕ್ಕೆ ಎರಡು ಹೆಗಲು ಪಟ್ಟಿಗಳನ್ನು ತಯಾರಿಸಿದ್ದರು. <verse eid="EXO 39:4"/><verse number="5" style="v" sid="EXO 39:5"/>ಅದರ ಮೇಲಿರುವ ಅದರ ಮೇಲಿರುವ ಕಸೂತಿ ಕೆಲಸದ ಏಫೋದಿನ ನಡುಕಟ್ಟನ್ನು ಒಂದೇ ರೀತಿಯ ವಸ್ತುಗಳಿಂದ ತಯಾರಿಸಬೇಕು ಅಂದರೆ ಬಂಗಾರ, ನೀಲಿ, ಧೂಮ್ರ, ರಕ್ತವರ್ಣದ ದಾರಿನಿಂದ ಮತ್ತು ನಯವಾದ ನಾರಿನಿಂದ ಹೊಸೆದು ಮಾಡಲಾಗಿತ್ತು, ಯೆಹೋವ ದೇವರು ಮೋಶೆಗೆ ಆಜ್ಞಾಪಿಸಿದಂತೆಯೇ ಇತ್ತು.<verse eid="EXO 39:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="EXO 39:6"/>ಮುದ್ರೆ ಕೆತ್ತುವ ಪ್ರಕಾರ, ಗೋಮೇಧಿಕ ರತ್ನಗಳಲ್ಲಿ ಹನ್ನೆರಡು ಇಸ್ರಾಯೇಲರ ಮಕ್ಕಳ ಹೆಸರುಗಳನ್ನು ಕೆತ್ತಿ ಬಂಗಾರದ ಕುಂದಣದಲ್ಲಿ ಇಟ್ಟರು. <verse eid="EXO 39:6"/><verse number="7" style="v" sid="EXO 39:7"/>ಯೆಹೋವ ದೇವರು ಮೋಶೆಗೆ ಆಜ್ಞಾಪಿಸಿದ ಹಾಗೆಯೇ ಅವರು ಆ ಎರಡು ರತ್ನಗಳನ್ನು ಏಫೋದಿನ ಹೆಗಲಿನ ಭಾಗದ ಮೇಲೆ ಇಸ್ರಾಯೇಲರ ಜ್ಞಾಪಕಾರ್ಥವಾದ ರತ್ನಗಳಾಗುವಂತೆ ಇಟ್ಟರು.<verse eid="EXO 39:7"/></para>
  <para style="s1">ಎದೆಪದಕ</para>
  <para style="p">
    <verse number="8" style="v" sid="EXO 39:8"/>ಎದೆಪದಕವನ್ನು ಕೌಶಲ್ಯ ಕೆಲಸದಿಂದ ಎಂದರೆ ಏಫೋದಿನ ಕೆಲಸದ ಹಾಗೆಯೇ ಬಂಗಾರ, ನೀಲಿ, ಧೂಮ್ರ, ರಕ್ತವರ್ಣದ ದಾರಿನಿಂದ ಮತ್ತು ನಯವಾದ ನಾರಿನಿಂದ ಹೊಸೆದು ಮಾಡಿದರು. <verse eid="EXO 39:8"/><verse number="9" style="v" sid="EXO 39:9"/>ಅದು ಚಚ್ಚೌಕವಾಗಿತ್ತು, ಅದು ಗೇಣು ಉದ್ದ, ಒಂದು ಗೇಣು ಅಗಲ ಮತ್ತು ಇದು ಎರಡು ಪದರುಳ್ಳದ್ದಾಗಿತ್ತು. <verse eid="EXO 39:9"/><verse number="10" style="v" sid="EXO 39:10"/>ನಂತರ ಅದರಲ್ಲಿ ನಾಲ್ಕು ಸಾಲುಗಳಾಗಿ ರತ್ನಗಳನ್ನು ಜೋಡಿಸಿದರು. ಮೊದಲನೆಯ ಸಾಲಿನಲ್ಲಿ ಮಾಣಿಕ್ಯ, ಪುಷ್ಯರಾಗ ಮತ್ತು ಸ್ಪಟಿಕಗಳಿದ್ದವು. <verse eid="EXO 39:10"/><verse number="11" style="v" sid="EXO 39:11"/>ಎರಡನೆಯ ಸಾಲಿನಲ್ಲಿ ಕೆಂಪರಲು, ನೀಲ ಮತ್ತು ಪಚ್ಚೆಗಳಿದ್ದವು. <verse eid="EXO 39:11"/><verse number="12" style="v" sid="EXO 39:12"/>ಮೂರನೆಯ ಸಾಲಿನಲ್ಲಿ ಸುವರ್ಣರತ್ನ, ಗೋಮೇಧಿಕ ಮತ್ತು ಧೂಮ್ರಮಣಿಗಳಿದ್ದವು. <verse eid="EXO 39:12"/><verse number="13" style="v" sid="EXO 39:13"/>ನಾಲ್ಕನೆಯ ಸಾಲಿನಲ್ಲಿ ಪೀತರತ್ನ, ಗೋಮೇಧಿಕ, ಸೂರ್ಯಕಾಂತ ಶಿಲೆ ಇವುಗಳನ್ನು ಬಂಗಾರದ ಜವೆಯ ಕಲ್ಲುಗಳಲ್ಲಿ ಸೇರಿಸಲಾಗಿದ್ದವು. <verse eid="EXO 39:13"/><verse number="14" style="v" sid="EXO 39:14"/>ಆ ರತ್ನಗಳು ಇಸ್ರಾಯೇಲರ ಗೋತ್ರದ ಹೆಸರುಗಳ ಪ್ರಕಾರ ಅವು ಹನ್ನೆರಡಾಗಿದ್ದವು. ಒಂದೊಂದರ ಮೇಲೆ ಒಂದೊಂದು ಹೆಸರಿದ್ದು ಹನ್ನೆರಡು ಗೋತ್ರಗಳ ಪ್ರಕಾರ ಮುದ್ರೆಗಳ ಹಾಗೆ ಕೆತ್ತಿದವುಗಳಾಗಿದ್ದವು.<verse eid="EXO 39:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="EXO 39:15"/>ಎದೆಪದಕದ ಮೇಲಿರುವ ಕೊನೆಗಳಲ್ಲಿ ಶುದ್ಧ ಬಂಗಾರದಿಂದ ಹೆಣೆದ ಕೆಲಸವಾಗಿರುವ ಹುರಿಗಳಂತಿರುವ ಸರಪಣಿಯನ್ನು ಮಾಡಿದರು. <verse eid="EXO 39:15"/><verse number="16" style="v" sid="EXO 39:16"/>ಬಂಗಾರದ ಆ ಎರಡು ಜವೆಗಳನ್ನು ಮಾಡಿ, ಆ ಎರಡು ಬಳೆಗಳನ್ನು ಎದೆಪದಕದ ಎರಡು ಕೊನೆಗಳಲ್ಲಿ ಸೇರಿಸಿದರು. <verse eid="EXO 39:16"/><verse number="17" style="v" sid="EXO 39:17"/>ಬಂಗಾರದಿಂದ ಹೆಣೆದ ಆ ಎರಡು ಸರಪಣಿಗಳನ್ನು ಎದೆಪದಕದ ಕೊನೆಗಳಲ್ಲಿರುವ ಎರಡು ಬಳೆಗಳಲ್ಲಿ ಸೇರಿಸಿದರು. <verse eid="EXO 39:17"/><verse number="18" style="v" sid="EXO 39:18"/>ಆ ಎರಡು ಹೆಣೆದ ಸರಪಣಿಗಳ ಎರಡು ಕೊನೆಗಳನ್ನು ಆ ಎರಡು ಜವೆಗಳಲ್ಲಿ ಸೇರಿಸಿ, ಏಫೋದಿನ ಹೆಗಲು ಭಾಗಗಳ ಮುಂದುಗಡೆ ಇರಿಸಿದರು. <verse eid="EXO 39:18"/><verse number="19" style="v" sid="EXO 39:19"/>ಬಂಗಾರದ ಎರಡು ಉಂಗುರಗಳನ್ನು ಮಾಡಿ, ಎದೆಪದಕದ ಎರಡು ಕೊನೆಗಳಲ್ಲಿ ಸೇರಿಸಿ ಏಫೋದಿನ ಬದಿಗೆ ಒಳಗಡೆಯಲ್ಲಿ ಹಾಕಿದರು. <verse eid="EXO 39:19"/><verse number="20" style="v" sid="EXO 39:20"/>ಚಿನ್ನದ ಬೇರೆ ಎರಡು ಉಂಗುರಗಳನ್ನು ಮಾಡಿ, ಏಫೋದಿನ ಮುಂಬದಿಯ ಕೆಳಗಿನ ಎರಡು ಹೆಗಲಿನ ಪಟ್ಟಿಗಳಲ್ಲಿ, ಏಫೋದಿನ ವಿಚಿತ್ರವಾದ ನಡುಕಟ್ಟಿನ ಮೇಲೆ ಅದನ್ನು ಜೋಡಿಸುವ ಸ್ಥಳಕ್ಕೆ ಎದುರಾಗಿ ಇರಿಸಿದರು. <verse eid="EXO 39:20"/><verse number="21" style="v" sid="EXO 39:21"/>ಯೆಹೋವ ದೇವರು ಮೋಶೆಗೆ ಆಜ್ಞಾಪಿಸಿದ ಹಾಗೆಯೇ ಆ ಎದೆಪದಕವನ್ನು ಏಫೋದಿನ ವಿಚಿತ್ರವಾದ ನಡುಕಟ್ಟಿನ ಮೇಲೆ ಇರುವಂತೆಯೂ ಎದೆಪದಕವು ಏಫೋದನ್ನು ಬಿಟ್ಟು ಅಲ್ಲಾಡದಂತೆಯೂ ಅದರ ಉಂಗುರಗಳ ಮೂಲಕವಾಗಿ ಏಫೋದಿನ ಉಂಗುರಗಳಿಗೆ ನೀಲಿ ದಾರದಿಂದ ಕಟ್ಟಿದರು.<verse eid="EXO 39:21"/></para>
  <para style="s1">ಯಾಜಕರ ಇತರ ವಸ್ತ್ರಗಳು</para>
  <para style="p">
    <verse number="22" style="v" sid="EXO 39:22"/>ಏಫೋದಿನ ನಿಲುವಂಗಿಯನ್ನೆಲ್ಲಾ ನೀಲಿ ಬಣ್ಣದ ಬಟ್ಟೆಯಿಂದ ಮಾಡಿದರು. ಅದು ನೇಕಾರನ ಕೆಲಸವಾಗಿತ್ತು. <verse eid="EXO 39:22"/><verse number="23" style="v" sid="EXO 39:23"/>ನಿಲುವಂಗಿಯ ರಂದ್ರ, ಕವಚದ ರಂದ್ರದ ಹಾಗೆ ಅದರ ಮಧ್ಯದಲ್ಲಿ ಇತ್ತು. ಅದು ಹರಿಯದ ಹಾಗೆ ಯುದ್ಧದ ಕವಚದೋಪಾದಿಯಲ್ಲಿ ಆ ರಂದ್ರದ ಸುತ್ತಲೂ ನೇಯ್ಗೆ ಪಟ್ಟಿ ಇತ್ತು. <verse eid="EXO 39:23"/><verse number="24" style="v" sid="EXO 39:24"/>ನಿಲುವಂಗಿಯ ಅಂಚಿನ ಮೇಲೆ ನೀಲಿ, ಧೂಮ್ರ, ರಕ್ತವರ್ಣದ ದಾರದಿಂದ ಮತ್ತು ನಯವಾದ ನಾರಿನಿಂದ ಹೊಸೆದು ದಾಳಿಂಬೆ ಹಣ್ಣಿನಂತೆ ಮಾಡಿದರು. <verse eid="EXO 39:24"/><verse number="25" style="v" sid="EXO 39:25"/>ಶುದ್ಧ ಬಂಗಾರದ ಗಂಟೆಗಳನ್ನು ಮಾಡಿ, ಆ ಗಂಟೆಗಳನ್ನು ದಾಳಿಂಬೆಗಳ ನಡುವೆಯೇ ಇರಿಸಿದರು. <verse eid="EXO 39:25"/><verse number="26" style="v" sid="EXO 39:26"/>ಒಂದು ಗೆಜ್ಜೆ, ಒಂದು ದಾಳಿಂಬೆಯಂತಿರುವ ಚೆಂಡನ್ನು ಒಂದಾದ ಮೇಲೆ ಒಂದು ಸೇವೆಗೋಸ್ಕರ ಮಾಡಿದ ಮೇಲಂಗಿಯ ಅಂಚಿನ ಸುತ್ತಲೂ ಇದ್ದವು. ಯೆಹೋವ ದೇವರು ಮೋಶೆಗೆ ಆಜ್ಞಾಪಿಸಿದ ಹಾಗೆಯೇ ಅದು ಇತ್ತು.<verse eid="EXO 39:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="EXO 39:27"/>ಆರೋನನಿಗೆ ಹಾಗೂ ಅವನ ಮಕ್ಕಳಿಗೆ ನಯವಾದ ನಾರಿನಿಂದ ಹೊಸೆದ ಕೆಲಸದಿಂದ ಮಾಡಿದ ಮೇಲಂಗಿಗಳನ್ನೂ <verse eid="EXO 39:27"/><verse number="28" style="v" sid="EXO 39:28"/>ನಯವಾದ ನಾರಿನಿಂದ ಮಾಡಿದ ಮುಂಡಾಸವನ್ನೂ ಸೌಂದರ್ಯವುಳ್ಳ ನಾರಿನ ಕುಲಾವಿಗಳನ್ನೂ ಹೊಸೆದ ನಯವಾದ ನಾರುಗಳಿಂದ ಮಾಡಿದ ಒಳಉಡುಪುಗಳನ್ನೂ <verse eid="EXO 39:28"/><verse number="29" style="v" sid="EXO 39:29"/>ನಯವಾದ ನಾರಿನಿಂದ ಹೊಸೆದ ನೀಲಿ, ಧೂಮ್ರ, ರಕ್ತವರ್ಣದ ದಾರದಿಂದ ಹೆಣಿಗೆಯ ಕೆಲಸದಿಂದ ನಡುಕಟ್ಟನ್ನೂ ಮಾಡಿದರು. ಇವುಗಳನ್ನು ಯೆಹೋವ ದೇವರು ಮೋಶೆಗೆ ಆಜ್ಞಾಪಿಸಿದಂತೆಯೇ ಮಾಡಿದರು.<verse eid="EXO 39:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="EXO 39:30"/>ಶುದ್ಧ ಬಂಗಾರದಿಂದ ಪರಿಶುದ್ಧ ಕಿರೀಟದ ತಗಡನ್ನು ಮಾಡಿ, ಮುದ್ರೆ ಕೆತ್ತುವ ಪ್ರಕಾರ ಅದರಲ್ಲಿ,</para>
  <para style="pc" vid="EXO 39:30">
    <char style="sc">“ಯೆಹೋವ ದೇವರಿಗೆ ಪರಿಶುದ್ಧ,” ಎಂದು ಕೆತ್ತಿಸಿದರು,</char><verse eid="EXO 39:30"/></para>
  <para style="m">
    <verse number="31" style="v" sid="EXO 39:31"/>ಅದು ಮುಂಡಾಸದ ಮುಂಭಾಗದಲ್ಲಿರುವಂತೆ ಅದನ್ನು ನೀಲಿ ದಾರಿನಿಂದ ಕಟ್ಟಿಸಿದರು. ಇದನ್ನು ಯೆಹೋವ ದೇವರು ಮೋಶೆಗೆ ಆಜ್ಞಾಪಿಸಿದ ಹಾಗೆಯೇ ಮಾಡಿದರು.<verse eid="EXO 39:31"/></para>
  <para style="s1">ಮೋಶೆಯು ಗುಡಾರವನ್ನು ಪರಿಶೀಲಿಸಿದ್ದು</para>
  <para style="p">
    <verse number="32" style="v" sid="EXO 39:32"/>ಈ ಪ್ರಕಾರ ದೇವದರ್ಶನದ ಗುಡಾರದ ಕೆಲಸವೆಲ್ಲಾ ಮುಗಿಯಿತು. ಯೆಹೋವ ದೇವರು ಮೋಶೆಗೆ ಆಜ್ಞಾಪಿಸಿದ್ದನ್ನೆಲ್ಲಾ ಇಸ್ರಾಯೇಲರು ಅದರಂತೆಯೇ ಮಾಡಿದರು. <verse eid="EXO 39:32"/><verse number="33" style="v" sid="EXO 39:33"/>ಆಗ ಅವರು ದೇವದರ್ಶನದ ಗುಡಾರವನ್ನು ಮೋಶೆಯ ಬಳಿಗೆ ತಂದರು.</para>
  <para style="b" vid="EXO 39:33"/>
  <para style="li1" vid="EXO 39:33">ಅದರ ಮೇಲ್ಹೊದಿಕೆಯನ್ನು, ಅದರ ಎಲ್ಲಾ ಸಲಕರಣೆಗಳನ್ನು ಅದರ ಕೊಂಡಿಗಳನ್ನು, ಅದರ ಚೌಕಟ್ಟುಗಳನ್ನು, ಅದರ ಅಗುಳಿಗಳನ್ನು, ಅದರ ಸ್ತಂಭಗಳನ್ನು, ಅದರ ಕುಣಿಕೆಗಳನ್ನು,<verse eid="EXO 39:33"/></para>
  <para style="li1">
    <verse number="34" style="v" sid="EXO 39:34"/>ಕೆಂಪು ಬಣ್ಣದಲ್ಲಿ ಅದ್ದಿದ ಟಗರುಗಳ ಹೊದಿಕೆಯನ್ನು, ಕಡಲುಹಂದಿಗಳ ಚರ್ಮಗಳ ಹೊದಿಕೆಗಳನ್ನು, ಮರೆಮಾಡುವ ಪರದೆಯನ್ನು,<verse eid="EXO 39:34"/></para>
  <para style="li1">
    <verse number="35" style="v" sid="EXO 39:35"/>ಒಡಂಬಡಿಕೆಯ ಮಂಜೂಷನ್ನು, ಅದರ ಕೋಲುಗಳನ್ನು, ಕರುಣಾಸನವನ್ನು,<verse eid="EXO 39:35"/></para>
  <para style="li1">
    <verse number="36" style="v" sid="EXO 39:36"/>ಮೇಜನ್ನು, ಅದರ ಎಲ್ಲಾ ಉಪಕರಣಗಳನ್ನು, ನೈವೇದ್ಯದ ರೊಟ್ಟಿಯನ್ನು,<verse eid="EXO 39:36"/></para>
  <para style="li1">
    <verse number="37" style="v" sid="EXO 39:37"/>ಶುದ್ಧವಾದ ದೀಪಸ್ತಂಭವನ್ನು, ಅದರ ದೀಪಗಳನ್ನು, ಕ್ರಮವಾಗಿಡುವ ದೀಪಗಳನ್ನು, ಅದರ ಉಪಕರಣಗಳನ್ನು, ದೀಪಸ್ತಂಭಕ್ಕಾಗಿ ಎಣ್ಣೆಯನ್ನು,<verse eid="EXO 39:37"/></para>
  <para style="li1">
    <verse number="38" style="v" sid="EXO 39:38"/>ಚಿನ್ನದ ಬಲಿಪೀಠವನ್ನು, ಅಭಿಷೇಕಿಸುವ ತೈಲವನ್ನು, ಪರಿಮಳ ಧೂಪವನ್ನು, ಗುಡಾರದ ಬಾಗಿಲಿನ ಪರದೆಯನ್ನು,<verse eid="EXO 39:38"/></para>
  <para style="li1">
    <verse number="39" style="v" sid="EXO 39:39"/>ಬಲಿಪೀಠವನ್ನು, ಅದರೊಂದಿಗೆ ಕಂಚಿನ ಜಾಳಿಗೆಯನ್ನು, ಅದರ ಕೋಲುಗಳನ್ನು, ಅದರ ಎಲ್ಲಾ ಉಪಕರಣಗಳನ್ನು, ಕಂಚಿನ ಗಂಗಾಳವನ್ನು,</para>
  <para style="li1" vid="EXO 39:39">ಅದರ ಕಾಲನ್ನು,<verse eid="EXO 39:39"/></para>
  <para style="li1">
    <verse number="40" style="v" sid="EXO 39:40"/>ದೇವದರ್ಶನದ ಗುಡಾರ ಅಂಗಳದ ಪರದೆಗಳನ್ನು, ಅದರ ಸ್ತಂಭಗಳನ್ನು, ಅದರ ಗದ್ದಿಗೇ ಕಲ್ಲುಗಳನ್ನು, ಅಂಗಳದ ಬಾಗಿಲಿನ ಪರದೆಗಳನ್ನು,</para>
  <para style="li1" vid="EXO 39:40">ಅದರ ಹಗ್ಗಗಳನ್ನು, ಗುಡಾರದ ಗೂಟಗಳನ್ನು,</para>
  <para style="li1" vid="EXO 39:40">ಸಭೆಯ ದೇವದರ್ಶನದ ಗುಡಾರಕ್ಕೆ ಬೇಕಾದ ಎಲ್ಲಾ ವಸ್ತುಗಳನ್ನು,<verse eid="EXO 39:40"/></para>
  <para style="li1">
    <verse number="41" style="v" sid="EXO 39:41"/>ಪರಿಶುದ್ಧಸ್ಥಳದ ಸೇವೆಗೋಸ್ಕರ ನೇಯ್ದ ಪರಿಶುದ್ಧ ವಸ್ತ್ರಗಳನ್ನು ಅಂದರೆ ಸೇವೆಮಾಡುವದಕ್ಕೆ ಯಾಜಕನಾದ ಆರೋನನಿಗೆ ಮತ್ತು ಅವನ ಪುತ್ರರಿಗೆ ಯಾಜಕವಸ್ತ್ರಗಳನ್ನು ತಂದರು.<verse eid="EXO 39:41"/></para>
  <para style="b"/>
  <para style="p">
    <verse number="42" style="v" sid="EXO 39:42"/>ಯೆಹೋವ ದೇವರು ಮೋಶೆಗೆ ಆಜ್ಞಾಪಿಸಿದ ಹಾಗೆಯೇ, ಇಸ್ರಾಯೇಲರು ಈ ಕೆಲಸಗಳನ್ನೆಲ್ಲಾ ಮಾಡಿದರು. <verse eid="EXO 39:42"/><verse number="43" style="v" sid="EXO 39:43"/>ಮೋಶೆಯು ಆ ಕೆಲಸವನ್ನೆಲ್ಲಾ ನೋಡಿದಾಗ, ಯೆಹೋವ ದೇವರು ಆಜ್ಞಾಪಿಸಿದ ಪ್ರಕಾರವೇ ಅವರು ಅದನ್ನು ಮಾಡಿದ್ದರು. ಆದ್ದರಿಂದ ಮೋಶೆಯು ಅವರನ್ನು ಆಶೀರ್ವದಿಸಿದನು.<verse eid="EXO 39:43"/></para>
  <chapter eid="EXO 39"/>
  <chapter number="40" style="c" sid="EXO 40"/>
  <para style="s1">ಗುಡಾರದ ಪ್ರತಿಷ್ಠಾಪನೆ</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 40:1"/>ಆಗ ಯೆಹೋವ ದೇವರು ಮೋಶೆಯ ಸಂಗಡ ಮಾತನಾಡಿ, <verse eid="EXO 40:1"/><verse number="2" style="v" sid="EXO 40:2"/>“ಮೊದಲನೆಯ ತಿಂಗಳಿನ ಮೊದಲನೆಯ ದಿವಸದಲ್ಲಿ ಸಭೆಯ ಡೇರೆಯನ್ನು ಮತ್ತು ಗುಡಾರವನ್ನು ಎತ್ತಿ ನಿಲ್ಲಿಸು. <verse eid="EXO 40:2"/><verse number="3" style="v" sid="EXO 40:3"/>ಒಡಂಬಡಿಕೆಯ ಮಂಜೂಷವನ್ನು ಅದರಲ್ಲಿ ಇಟ್ಟು, ಅದನ್ನು ನೀನು ಪರದೆಯಿಂದ ಮುಚ್ಚಬೇಕು. <verse eid="EXO 40:3"/><verse number="4" style="v" sid="EXO 40:4"/>ಮೇಜನ್ನು ಒಳಗೆ ತಂದು, ಅದರ ಮೇಲಿಡಬೇಕಾದದ್ದನ್ನು ಸರಿಯಾಗಿ ಇಡಬೇಕು. ದೀಪಸ್ತಂಭವನ್ನು ಒಳಗೆ ತಂದು, ನೀನು ಅದರ ದೀಪಗಳನ್ನು ಅಂಟಿಸಬೇಕು. <verse eid="EXO 40:4"/><verse number="5" style="v" sid="EXO 40:5"/>ನೀನು ಮಾಡಿದ ಚಿನ್ನದ ಧೂಪಪೀಠವನ್ನು ಒಡಂಬಡಿಕೆಯ ಮಂಜೂಷದ ಎದುರಾಗಿ ಇಟ್ಟು, ದೇವದರ್ಶನದ ಗುಡಾರದ ಬಾಗಿಲಿಗೆ ಪರದೆಯನ್ನು ಹಾಕಬೇಕು.<verse eid="EXO 40:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="EXO 40:6"/>“ನೀನು ದಹನಬಲಿಯ ಪೀಠವನ್ನು ಸಭೆಯ ಡೇರೆಯಾದ ಗುಡಾರದ ಬಾಗಿಲಿಗೆ ಎದುರಾಗಿ ಇಡಬೇಕು. <verse eid="EXO 40:6"/><verse number="7" style="v" sid="EXO 40:7"/>ನೀನು ದೇವದರ್ಶನದ ಗುಡಾರಕ್ಕೂ, ಬಲಿಪೀಠಕ್ಕೂ ಮಧ್ಯದಲ್ಲಿ ಗಂಗಾಳವನ್ನಿಟ್ಟು, ಅದರಲ್ಲಿ ನೀರನ್ನು ತುಂಬಿಸಬೇಕು. <verse eid="EXO 40:7"/><verse number="8" style="v" sid="EXO 40:8"/>ಅದರ ಸುತ್ತಲೂ ಆವರಣವನ್ನು ನಿಲ್ಲಿಸಿ, ಆ ಆವರಣದ ಬಾಗಿಲಿನ ಬಳಿಯಲ್ಲಿ ನೀನು ಪರದೆಯನ್ನು ತೂಗು ಹಾಕಬೇಕು.<verse eid="EXO 40:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="EXO 40:9"/>“ನೀನು ಅಭಿಷೇಕ ತೈಲವನ್ನು ತೆಗೆದುಕೊಂಡು ಗುಡಾರವನ್ನೂ, ಅದರಲ್ಲಿರುವ ಎಲ್ಲವುಗಳನ್ನೂ ಅಭಿಷೇಕಿಸಿ, ಅದರಲ್ಲಿರುವ ಎಲ್ಲಾ ಸಾಮಗ್ರಿಗಳನ್ನೂ ಪರಿಶುದ್ಧ ಮಾಡು. ಆಗ ಅದು ಪರಿಶುದ್ಧವಾಗುವುದು. <verse eid="EXO 40:9"/><verse number="10" style="v" sid="EXO 40:10"/>ದಹನಬಲಿಯ ಪೀಠವನ್ನೂ, ಅದರ ಎಲ್ಲಾ ಸಲಕರಣೆಗಳನ್ನೂ ನೀನು ಅಭಿಷೇಕಿಸಿ, ಬಲಿಪೀಠವನ್ನು ಪವಿತ್ರಮಾಡು. ಆಗ ಅದು ಅತಿಪರಿಶುದ್ಧವಾದ ಬಲಿಪೀಠವಾಗುವುದು. <verse eid="EXO 40:10"/><verse number="11" style="v" sid="EXO 40:11"/>ಗಂಗಾಳವನ್ನೂ, ಅದರ ಕಾಲುಗಳನ್ನೂ ನೀನು ಅಭಿಷೇಕಿಸಿ, ಅದನ್ನು ಪ್ರತಿಷ್ಠಾಪನೆ ಮಾಡಬೇಕು.<verse eid="EXO 40:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="EXO 40:12"/>“ಆರೋನನನ್ನೂ, ಅವನ ಮಕ್ಕಳನ್ನೂ ದೇವದರ್ಶನದ ಗುಡಾರದ ಬಾಗಿಲಿನ ಬಳಿಗೆ ಬರಮಾಡಿ, ಅವರನ್ನು ನೀರಿನಿಂದ ಸ್ನಾನ ಮಾಡಿಸಬೇಕು. <verse eid="EXO 40:12"/><verse number="13" style="v" sid="EXO 40:13"/>ಆರೋನನು ನನಗೆ ಯಾಜಕ ಸೇವೆ ಮಾಡುವ ಹಾಗೆ ಅವನಿಗೆ ಪರಿಶುದ್ಧ ವಸ್ತ್ರಗಳನ್ನು ತೊಡಿಸಿ, ಅವನನ್ನು ಅಭಿಷೇಕಿಸಿ, ಅವನನ್ನು ಶುದ್ಧಮಾಡಬೇಕು. <verse eid="EXO 40:13"/><verse number="14" style="v" sid="EXO 40:14"/>ಅವನ ಪುತ್ರರನ್ನು ನೀನು ಬರಮಾಡಿಕೊಂಡು, ಅವರಿಗೆ ಅಂಗಿಗಳನ್ನು ತೊಡಿಸಿ, <verse eid="EXO 40:14"/><verse number="15" style="v" sid="EXO 40:15"/>ಅವರ ತಂದೆಯನ್ನು ಅಭಿಷೇಕಿಸಿದ ಪ್ರಕಾರ, ಅವರು ನನಗೆ ಯಾಜಕ ಸೇವೆಯನ್ನು ಮಾಡುವ ಹಾಗೆ ಅವರನ್ನೂ ನೀನು ಅಭಿಷೇಕಿಸು. ಅವರ ಈ ಅಭಿಷೇಕದಿಂದ ಅವರ ಸಂತತಿಗಳಲ್ಲಿ ನಿತ್ಯವಾದ ಯಾಜಕತ್ವವಾಗಿರುವುದು,” ಎಂದು ಹೇಳಿದರು. <verse eid="EXO 40:15"/><verse number="16" style="v" sid="EXO 40:16"/>ಮೋಶೆಯು ಯೆಹೋವ ದೇವರು ತನಗೆ ಆಜ್ಞಾಪಿಸಿದ ಪ್ರಕಾರವೇ ಅವನು ಎಲ್ಲವನ್ನು ಮಾಡಿದನು.<verse eid="EXO 40:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="EXO 40:17"/>ಎರಡನೆಯ ವರ್ಷದ ಮೊದಲನೆಯ ತಿಂಗಳಿನ ಮೊದಲನೆಯ ದಿವಸದಲ್ಲಿ ಗುಡಾರವು ಎದ್ದುನಿಂತಿತು. <verse eid="EXO 40:17"/><verse number="18" style="v" sid="EXO 40:18"/>ಆಗ ಮೋಶೆಯು ಗುಡಾರವನ್ನು ನಿಲ್ಲಿಸಿ, ಅದರ ಕಾಲುಗಳನ್ನು ಬಿಗಿದು, ಅದರ ಚೌಕಟ್ಟುಗಳನ್ನು ಇರಿಸಿ, ಅಗುಳಿಗಳನ್ನು ಹಾಕಿ, ಅದರ ಸ್ತಂಭಗಳನ್ನು ನಿಲ್ಲಿಸಿದನು. <verse eid="EXO 40:18"/><verse number="19" style="v" sid="EXO 40:19"/>ಯೆಹೋವ ದೇವರು ಮೋಶೆಗೆ ಆಜ್ಞಾಪಿಸಿದ ಹಾಗೆ ಗುಡಾರದ ಮೇಲೆ ಡೇರೆಯನ್ನು ಹರಡಿಸಿ, ಡೇರೆಯ ಹೊದಿಕೆಯನ್ನು ಅದರ ಮೇಲೆ ಹಾಕಿದನು.<verse eid="EXO 40:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="EXO 40:20"/>ಅವನು ಆಜ್ಞಾಶಾಸನಗಳನ್ನು ತೆಗೆದುಕೊಂಡು ಮಂಜೂಷದ ಪೆಟ್ಟಿಗೆಯಲ್ಲಿಟ್ಟು, ಮಂಜೂಷಕ್ಕೆ ಕೋಲುಗಳನ್ನು ಸೇರಿಸಿ, ಮಂಜೂಷದ ಮೇಲೆ ಕರುಣಾಸನವನ್ನು ಇಟ್ಟನು. <verse eid="EXO 40:20"/><verse number="21" style="v" sid="EXO 40:21"/>ಅವನು ಮಂಜೂಷವನ್ನು ಗುಡಾರಕ್ಕೆ ತಂದು, ಮರೆಮಾಡುವ ಪರದೆಯನ್ನಿರಿಸಿ, ಒಡಂಬಡಿಕೆಯ ಮಂಜೂಷವನ್ನು ಮರೆಮಾಡಿದನು. ಯೆಹೋವ ದೇವರು ಆಜ್ಞಾಪಿಸಿದ ಹಾಗೆಯೇ ಮೋಶೆಯು ಮಾಡಿದನು.<verse eid="EXO 40:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="EXO 40:22"/>ಅನಂತರ ಮೋಶೆ ದೇವದರ್ಶನದ ಗುಡಾರದ ಉತ್ತರ ಭಾಗದಲ್ಲಿ, ಪರದೆಯ ಹೊರಗೆ ಮೇಜನ್ನು ಇಟ್ಟನು. <verse eid="EXO 40:22"/><verse number="23" style="v" sid="EXO 40:23"/>ಯೆಹೋವ ದೇವರು ಮೋಶೆಗೆ ಆಜ್ಞಾಪಿಸಿದ ಹಾಗೆ ಅದರ ಮೇಲೆ ರೊಟ್ಟಿಯನ್ನು ಯೆಹೋವ ದೇವರ ಸನ್ನಿಧಿಯಲ್ಲಿ ಕ್ರಮವಾಗಿ ಇಟ್ಟನು.<verse eid="EXO 40:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="EXO 40:24"/>ದೇವದರ್ಶನದ ಗುಡಾರದಲ್ಲಿ ಮೇಜಿಗೆ ಎದುರಾಗಿ ಗುಡಾರದ ದಕ್ಷಿಣ ಭಾಗದಲ್ಲಿ ದೀಪಸ್ತಂಭವನ್ನು ಇಟ್ಟನು. <verse eid="EXO 40:24"/><verse number="25" style="v" sid="EXO 40:25"/>ಯೆಹೋವ ದೇವರು ಮೋಶೆಗೆ ಆಜ್ಞಾಪಿಸಿದ ಹಾಗೆ ಯೆಹೋವ ದೇವರ ಸನ್ನಿಧಿಯಲ್ಲಿ ದೀಪಗಳನ್ನು ಇರಿಸಿದನು.<verse eid="EXO 40:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="EXO 40:26"/>ಚಿನ್ನದ ಧೂಪವೇದಿಯನ್ನು ದೇವದರ್ಶನದ ಗುಡಾರದಲ್ಲಿ ಪರದೆಯ ಮುಂದೆ ಇಟ್ಟನು. <verse eid="EXO 40:26"/><verse number="27" style="v" sid="EXO 40:27"/>ಯೆಹೋವ ದೇವರು ಮೋಶೆಗೆ ಆಜ್ಞಾಪಿಸಿದ ಹಾಗೆ ಅದರ ಮೇಲೆ ಪರಿಮಳ ಧೂಪವನ್ನು ಸುಟ್ಟನು.<verse eid="EXO 40:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="EXO 40:28"/>ಗುಡಾರದ ಬಾಗಿಲಿನ ಪರದೆಯನ್ನು ತೂಗುಹಾಕಿದನು. <verse eid="EXO 40:28"/><verse number="29" style="v" sid="EXO 40:29"/>ದೇವದರ್ಶನದ ಗುಡಾರದ ಬಳಿಯಲ್ಲಿ ದಹನಬಲಿಯ ಪೀಠವನ್ನು ಇಟ್ಟನು. ಯೆಹೋವ ದೇವರು ಮೋಶೆಗೆ ಆಜ್ಞಾಪಿಸಿದ ಹಾಗೆ ದೇವದರ್ಶನದ ಗುಡಾರದ ಬಾಗಿಲಿನ ಮುಂದೆ ಬಲಿಪೀಠ ಇಟ್ಟು ಅದರ ಮೇಲೆ ದಹನಬಲಿ ಮತ್ತು ಧಾನ್ಯ ಸಮರ್ಪಣೆಯನ್ನೂ ಅರ್ಪಿಸಿದನು.<verse eid="EXO 40:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="EXO 40:30"/>ದೇವದರ್ಶನದ ಗುಡಾರಕ್ಕೂ, ಬಲಿಪೀಠಕ್ಕೂ ಮಧ್ಯ ಗಂಗಾಳವನ್ನು ಇಟ್ಟು, ಅದರಲ್ಲಿ ತೊಳೆಯುವುದಕ್ಕೆ ನೀರನ್ನು ತುಂಬಿಸಿದನು. <verse eid="EXO 40:30"/><verse number="31" style="v" sid="EXO 40:31"/>ಮೋಶೆಯೂ, ಆರೋನನೂ, ಅವನ ಪುತ್ರರೂ ಅದರಲ್ಲಿ ಕೈಕಾಲುಗಳನ್ನು ತೊಳೆದುಕೊಂಡರು. <verse eid="EXO 40:31"/><verse number="32" style="v" sid="EXO 40:32"/>ಅವರು ದೇವದರ್ಶನದ ಗುಡಾರದ ಒಳಗೆ ಸೇರುವ ಸಮಯದಲ್ಲಿಯೂ, ಬಲಿಪೀಠದ ಸಮೀಪಕ್ಕೆ ಬರುವ ಸಮಯದಲ್ಲಿಯೂ ಯೆಹೋವ ದೇವರು ಮೋಶೆಗೆ ಆಜ್ಞಾಪಿಸಿದ ಹಾಗೆಯೇ ಅವರು ಸ್ನಾನ ಮಾಡಿದರು.<verse eid="EXO 40:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="EXO 40:33"/>ಮೋಶೆಯು ಗುಡಾರಕ್ಕೂ, ಬಲಿಪೀಠಕ್ಕೂ ಸುತ್ತಲೂ ಅಂಗಳವನ್ನು ನಿಲ್ಲಿಸಿ, ಅಂಗಳದ ಬಾಗಿಲಿನ ಪರದೆಯನ್ನು ತೂಗುಹಾಕಿದನು. ಈ ಪ್ರಕಾರ ಮೋಶೆಯು ಆ ಕೆಲಸವನ್ನು ತೀರಿಸಿದನು.<verse eid="EXO 40:33"/></para>
  <para style="s1">ಯೆಹೋವ ದೇವರ ಮಹಿಮೆ</para>
  <para style="p">
    <verse number="34" style="v" sid="EXO 40:34"/>ಆಗ ಮೇಘವು ದೇವದರ್ಶನದ ಗುಡಾರವನ್ನು ಮುಚ್ಚಿಕೊಂಡು, ಯೆಹೋವ ದೇವರ ಮಹಿಮೆಯು ದೇವದರ್ಶನದ ಗುಡಾರವನ್ನು ತುಂಬಿಕೊಂಡಿತು. <verse eid="EXO 40:34"/><verse number="35" style="v" sid="EXO 40:35"/>ದೇವದರ್ಶನದ ಗುಡಾರದ ಮೇಲೆ ಮೇಘವು ನೆಲೆಯಾಗಿದ್ದದರಿಂದಲೂ, ಯೆಹೋವ ದೇವರು ಮಹಿಮೆಯು ದೇವದರ್ಶನದ ಗುಡಾರವನ್ನು ತುಂಬಿದ್ದರಿಂದಲೂ, ಮೋಶೆಯು ಒಳಗೆ ಪ್ರವೇಶಿಸಲಾರದೆ ಇದ್ದನು.<verse eid="EXO 40:35"/></para>
  <para style="p">
    <verse number="36" style="v" sid="EXO 40:36"/>ಮೇಘವು ಗುಡಾರವನ್ನು ಬಿಟ್ಟು ಮೇಲಕ್ಕೆ ಹೋದಾಗ, ಇಸ್ರಾಯೇಲರು ತಮ್ಮ ಪ್ರಯಾಣಕ್ಕಾಗಿ ಮುಂದೆ ಹೊರಡುತ್ತಿದ್ದರು. <verse eid="EXO 40:36"/><verse number="37" style="v" sid="EXO 40:37"/>ಆದರೆ ಮೇಘವು ಮೇಲಕ್ಕೆ ಎತ್ತದೇ ಇರುವಾಗ ಅದು ಎತ್ತುವ ದಿವಸದವರೆಗೆ ಅವರು ಪ್ರಯಾಣ ಮಾಡಲಿಲ್ಲ. <verse eid="EXO 40:37"/><verse number="38" style="v" sid="EXO 40:38"/>ಏಕೆಂದರೆ ಇಸ್ರಾಯೇಲರ ಎಲ್ಲಾ ಪ್ರಯಾಣಗಳಲ್ಲಿ ಅವರ ಕಣ್ಣುಗಳ ಮುಂದೆ ಹಗಲಿನಲ್ಲಿ ಯೆಹೋವ ದೇವರ ಮೇಘವು ಗುಡಾರದ ಮೇಲೆ ಇತ್ತು. ರಾತ್ರಿಯಲ್ಲಿ ಮೇಘದೊಳಗೆ ಅಗ್ನಿಯು ಪ್ರಕಾಶಿಸುತ್ತಿತ್ತು.<verse eid="EXO 40:38"/></para>
  <chapter eid="EXO 40"/>
</usx>
