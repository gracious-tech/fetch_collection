<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="MIC" style="id">- Biblica® Open Kannada Contemporary Version</book>
  <para style="h">ಮೀಕ</para>
  <para style="toc1">ಮೀಕ</para>
  <para style="toc2">ಮೀಕ</para>
  <para style="toc3">ಮೀಕ</para>
  <para style="mt1">ಮೀಕ</para>
  <chapter number="1" style="c" sid="MIC 1"/>
  <para style="p">
    <verse number="1" style="v" sid="MIC 1:1"/>ಯೆಹೂದದ ಅರಸರಾದ ಯೋತಾಮನ ಆಹಾಜನ, ಹಿಜ್ಕೀಯನ, ದಿವಸಗಳಲ್ಲಿ ಮೊರೇಷೆತಿನವನಾದ ಮೀಕನಿಗೆ ಬಂದ ಯೆಹೋವ ದೇವರ ವಾಕ್ಯವು. ಅವನು ಸಮಾರ್ಯ ಮತ್ತು ಯೆರೂಸಲೇಮಿನ ವಿಷಯವಾಗಿ ಕಂಡ ದರ್ಶನ.<verse eid="MIC 1:1"/></para>
  <para style="b"/>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="MIC 1:2"/>ಎಲ್ಲಾ ಜನಗಳೇ ಕೇಳಿರಿ,</para>
  <para style="q2" vid="MIC 1:2">ಭೂಮಿಯೇ, ಅದರಲ್ಲಿರುವವರೆಲ್ಲರೇ, ಕಿವಿಗೊಡಿರಿ.</para>
  <para style="q1" vid="MIC 1:2">ಸಾರ್ವಭೌಮ ಯೆಹೋವ ದೇವರು ತಮ್ಮ ಪರಿಶುದ್ಧ ಮಂದಿರದೊಳಗಿಂದ ನಿಮಗೆ</para>
  <para style="q2" vid="MIC 1:2">ವಿರೋಧವಾಗಿ ಸಾಕ್ಷಿ ಹೇಳುವರು.<verse eid="MIC 1:2"/></para>
  <para style="s1">ಸಮಾರ್ಯಕ್ಕೂ ಯೆರೂಸಲೇಮಿಗೂ ದಂಡನೆ</para>
  <para style="q1">
    <verse number="3" style="v" sid="MIC 1:3"/>ಯೆಹೋವ ದೇವರು ತಮ್ಮ ವಾಸಸ್ಥಾನದಿಂದ ಇಳಿದು ಬರುತ್ತಾರೆ.</para>
  <para style="q2" vid="MIC 1:3">ಅವರು ಇಳಿದು ಭೂಮಿಯ ಉನ್ನತವಾದ ಸ್ಥಳಗಳ ಮೇಲೆ ಸಂಚರಿಸುತ್ತಾರೆ.<verse eid="MIC 1:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="MIC 1:4"/>ಬೆಂಕಿಯ ಮುಂದೆ ಮೇಣದ ಹಾಗೆಯೂ</para>
  <para style="q2" vid="MIC 1:4">ಇಳಿಜಾರಿನ ಸ್ಥಳದಲ್ಲಿ ರಭಸವಾಗಿ ಹರಿಯುವ ನೀರಿನ ಹಾಗೆಯೂ</para>
  <para style="q1" vid="MIC 1:4">ಬೆಟ್ಟಗಳು ಆತನ ಕೆಳಗೆ ಕರಗುವುವು;</para>
  <para style="q2" vid="MIC 1:4">ತಗ್ಗುಗಳು ಸೀಳುವುವು.<verse eid="MIC 1:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="MIC 1:5"/>ಇದೆಲ್ಲಾ ಯಾಕೋಬಿನ ಅಪರಾಧದ ನಿಮಿತ್ತವೇ</para>
  <para style="q2" vid="MIC 1:5">ಇಸ್ರಾಯೇಲಿನ ಮನೆತನದವರ ಪಾಪದಿಂದಲೇ,</para>
  <para style="q1" vid="MIC 1:5">ಯಾಕೋಬನ ಅಪರಾಧವೇನು? ಅದು ಸಮಾರ್ಯವಲ್ಲವೇ?</para>
  <para style="q1" vid="MIC 1:5">ಯೆಹೂದದ ಉನ್ನತ ಪೂಜಾಸ್ಥಳ ಯಾವುದು?</para>
  <para style="q2" vid="MIC 1:5">ಅದು ಯೆರೂಸಲೇಮು ಅಲ್ಲವೋ?<verse eid="MIC 1:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="MIC 1:6"/>ಹೀಗಿರುವುದರಿಂದ ನಾನು ಸಮಾರ್ಯವನ್ನು ಹೊಲದ ದಿಬ್ಬವನ್ನಾಗಿಯೂ</para>
  <para style="q2" vid="MIC 1:6">ದ್ರಾಕ್ಷಿಬಳ್ಳಿ ನೆಡುವ ಸ್ಥಳವನ್ನಾಗಿಯೂ ಮಾಡುವೆನು.</para>
  <para style="q1" vid="MIC 1:6">ಅದರ ಕಲ್ಲುಗಳನ್ನು ತಗ್ಗಿನಲ್ಲಿ ಸುರಿದುಬಿಟ್ಟು,</para>
  <para style="q2" vid="MIC 1:6">ಅದರ ಅಸ್ತಿವಾರಗಳನ್ನು ಹೊರಗೆಡಹುವೆನು.<verse eid="MIC 1:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="MIC 1:7"/>ಅದರ ವಿಗ್ರಹಗಳೆಲ್ಲಾ ತುಂಡುಗಳಾಗುವಂತೆ ಮಾಡುವೆನು.</para>
  <para style="q2" vid="MIC 1:7">ಅದರ ಆಲಯದ ಕಾಣಿಕೆಗಳೆಲ್ಲಾ ಬೆಂಕಿಯಿಂದ ಸುಟ್ಟುಹೋಗುವುದು.</para>
  <para style="q2" vid="MIC 1:7">ಅದರ ವಿಗ್ರಹಗಳನ್ನೆಲ್ಲಾ ಹಾಳುಮಾಡುವೆನು.</para>
  <para style="q1" vid="MIC 1:7">ಅದು ವೇಶ್ಯಾವೃತ್ತಿಯ ಕೂಲಿಯಿಂದ ಕೂಡಿಸಿಕೊಂಡವು.</para>
  <para style="q2" vid="MIC 1:7">ವೇಶ್ಯಾವೃತ್ತಿಯ ಕೂಲಿಯನ್ನಾಗಿಯೇ ಅವುಗಳನ್ನು ಉಪಯೋಗಿಸಬೇಕಾಗುತ್ತದೆ.<verse eid="MIC 1:7"/></para>
  <para style="s1">ಗೋಳಾಟ ಮತ್ತು ಕೂಗಾಟ</para>
  <para style="q1">
    <verse number="8" style="v" sid="MIC 1:8"/>ಆದ್ದರಿಂದ ನಾನು ಗೋಳಾಡಿ ಅರಚುವೆನು.</para>
  <para style="q2" vid="MIC 1:8">ಬರಿಗಾಲಿನಲ್ಲಿಯೂ ಬೆತ್ತಲೆಯಾಗಿಯೂ ಹೋಗುವೆನು.</para>
  <para style="q1" vid="MIC 1:8">ನರಿಗಳ ಹಾಗೆ ಕೂಗುವೆನು,</para>
  <para style="q2" vid="MIC 1:8">ಉಷ್ಟ್ರಪಕ್ಷಿಯಂತೆ ನರಳುವೆನು.<verse eid="MIC 1:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="MIC 1:9"/>ಸಮಾರ್ಯದ ಗಾಯವು ಗುಣವಾಗದಂಥದ್ದು,</para>
  <para style="q2" vid="MIC 1:9">ಅದು ಯೆಹೂದಕ್ಕೆ ಬಂತು;</para>
  <para style="q1" vid="MIC 1:9">ನನ್ನ ಜನರ ಬಾಗಿಲಿಗೂ</para>
  <para style="q2" vid="MIC 1:9">ಯೆರೂಸಲೇಮಿನವರೆಗೂ ಅದು ತಲುಪಿತು.<verse eid="MIC 1:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="MIC 1:10"/>ಗತ್ ಊರಿನಲ್ಲಿ ಅದನ್ನು ತಿಳಿಸಬೇಡ;</para>
  <para style="q2" vid="MIC 1:10">ಸ್ವಲ್ಪವಾದರೂ ಅಳಬೇಡ;</para>
  <para style="q1" vid="MIC 1:10">ಬೇತ್ ಒಫ್‌ರಾಹದಲ್ಲಿ<note caller="+" style="f"><char style="fr" closed="false">1:10 </char><char style="fq" closed="false">ಬೇತ್ ಒಫ್ </char><char style="ft" closed="false">ಅಂದರೆ </char><char style="fqa" closed="false">ಧೂಳಿನ ಮನೆ</char></note></para>
  <para style="q2" vid="MIC 1:10">ಧೂಳಿನಲ್ಲಿ ಹೊರಳಾಡು.<verse eid="MIC 1:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="MIC 1:11"/>ಶಾಫೀರಿನ ನಿವಾಸಿಯೇ,</para>
  <para style="q2" vid="MIC 1:11">ನಗ್ನತೆಯಿಂದಲೂ ನಾಚಿಕೆಯಿಂದಲೂ ಹಾದುಹೋಗಿರಿ,</para>
  <para style="q1" vid="MIC 1:11">ಚಾನಾನಿನಲ್ಲಿ ವಾಸಿಸುವವರು</para>
  <para style="q2" vid="MIC 1:11">ಹೊರಗೆ ಬರುವುದಿಲ್ಲ,</para>
  <para style="q1" vid="MIC 1:11">ಬೇತ್ ಎಚೆಲು ನರಳುತ್ತಿದೆ.</para>
  <para style="q2" vid="MIC 1:11">ಅದು ಇನ್ನು ಮುಂದೆ ನಿಮ್ಮನ್ನು ರಕ್ಷಿಸುವುದಿಲ್ಲ.<verse eid="MIC 1:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="MIC 1:12"/>ಕೇಡು ಯೆಹೋವ ದೇವರಿಂದ ಇಳಿದು</para>
  <para style="q2" vid="MIC 1:12">ಯೆರೂಸಲೇಮಿನ ಪುರದ್ವಾರಕ್ಕೆ ತಗಲಿದ ಕಾರಣ</para>
  <para style="q1" vid="MIC 1:12">ಮಾರೋತಿನವರು ಮೇಲುಂಟಾಗುವುದಿಲ್ಲವೋ ಎಂದು</para>
  <para style="q2" vid="MIC 1:12">ವೇದನೆ ಪಡುತ್ತಾರೆ.<verse eid="MIC 1:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="MIC 1:13"/>ಲಾಕೀಷಿನ ನಿವಾಸಿಗಳೇ,</para>
  <para style="q2" vid="MIC 1:13">ಕುದುರೆಗಳನ್ನು ರಥಕ್ಕೆ ಕಟ್ಟಿರಿ,</para>
  <para style="q1" vid="MIC 1:13">ಚೀಯೋನ್ ಮಗಳ ಪಾಪವು ನಿನ್ನಿಂದ ಪ್ರಾರಂಭವಾಯಿತು</para>
  <para style="q2" vid="MIC 1:13">ಇಸ್ರಾಯೇಲಿನ ದ್ರೋಹಗಳು ನಿಮ್ಮಲ್ಲಿಯೇ ಹುಟ್ಟಿ ಬಂದವು.<verse eid="MIC 1:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="MIC 1:14"/>ಹೀಗಿರುವುದರಿಂದ ಮೋರೆಶತ್ ಗತ್</para>
  <para style="q2" vid="MIC 1:14">ಊರಿಗೆ ಅಗಲಿ ಹೋಗುವ ಕಾಣಿಕೆಗಳನ್ನು ಕೊಡುವೆ.</para>
  <para style="q1" vid="MIC 1:14">ಅಕ್ಜೀಬಿನ ಮನೆತನಗಳು</para>
  <para style="q2" vid="MIC 1:14">ಇಸ್ರಾಯೇಲಿನ ಅರಸರಿಗೆ ಮೋಸಮಾಡುವುವು.<verse eid="MIC 1:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="MIC 1:15"/>ಮಾರೇಷದ ನಿವಾಸಿಯೇ,</para>
  <para style="q2" vid="MIC 1:15">ನಿನಗೆ ವಿರೋಧವಾಗಿ ಜಯಶಾಲಿಗಳನ್ನು ನಾನು ತರುವೆನು.</para>
  <para style="q1" vid="MIC 1:15">ಇಸ್ರಾಯೇಲಿನ ಮಹಿಮೆಯಾದಾತನು</para>
  <para style="q2" vid="MIC 1:15">ಅದುಲ್ಲಾಮಿನ ಮಟ್ಟಿಗೂ ಬರುವನು.<verse eid="MIC 1:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="MIC 1:16"/>ನಿನ್ನ ಮುದ್ದುಮಕ್ಕಳಿಗೋಸ್ಕರ</para>
  <para style="q2" vid="MIC 1:16">ತಲೆ ಬೋಳಿಸಿಕೊಂಡು ಕ್ಷೌರಮಾಡಿಸಿಕೋ.</para>
  <para style="q1" vid="MIC 1:16">ನಿನ್ನ ಬೋಳುತನವನ್ನು ಹದ್ದಿನಂತೆ ಮಾಡಿಕೋ.</para>
  <para style="q2" vid="MIC 1:16">ಏಕೆಂದರೆ ಅವರು ನಿನ್ನನ್ನು ಬಿಟ್ಟು ಸೆರೆಯಾಗಿ ಹೋಗುವರು.<verse eid="MIC 1:16"/></para>
  <chapter eid="MIC 1"/>
  <chapter number="2" style="c" sid="MIC 2"/>
  <para style="s1">ಮನುಷ್ಯನ ಯೋಜನೆ ಹಾಗೂ ದೇವರ ಯೋಜನೆ</para>
  <para style="q1">
    <verse number="1" style="v" sid="MIC 2:1"/>ಅಪರಾಧವನ್ನು ಯೋಚಿಸಿ ಅಪರಾಧವನ್ನು ಕಲ್ಪಿಸಿ,</para>
  <para style="q2" vid="MIC 2:1">ತಮ್ಮ ಹಾಸಿಗೆಗಳ ಮೇಲೆ ಕೆಟ್ಟದ್ದನ್ನು ನಡೆಸುವವರಿಗೆ ಕಷ್ಟ!</para>
  <para style="q1" vid="MIC 2:1">ಹೊತ್ತಾರೆ ಬೆಳಕಾಗುವಾಗ ಅದನ್ನು ಮಾಡುತ್ತಾರೆ.</para>
  <para style="q2" vid="MIC 2:1">ಏಕೆಂದರೆ ಅದು ಅವರ ಕೈಶಕ್ತಿಯಲ್ಲಿದೆ.<verse eid="MIC 2:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="MIC 2:2"/>ಅವರು ಹೊಲಗಳನ್ನು ಆಶಿಸಿ ಬಲಾತ್ಕಾರದಿಂದ ತೆಗೆದುಕೊಳ್ಳುತ್ತಾರೆ.</para>
  <para style="q2" vid="MIC 2:2">ಮನೆಗಳನ್ನೂ ಸಹ ತೆಗೆದುಕೊಳ್ಳುತ್ತಾರೆ.</para>
  <para style="q1" vid="MIC 2:2">ಮನುಷ್ಯನಿಗೂ ಅವನ ಮನೆಗೂ</para>
  <para style="q2" vid="MIC 2:2">ಇತರರಿಗೂ ಅವನ ಸ್ವಾಸ್ತ್ಯವನ್ನು ಕಸಿದುಕೊಳ್ಳುತ್ತಾರೆ.<verse eid="MIC 2:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="MIC 2:3"/>ಆದ್ದರಿಂದ ಯೆಹೋವ ದೇವರು ಹೀಗೆನ್ನುತ್ತಾರೆ,</para>
  <para style="q1" vid="MIC 2:3">“ಇಗೋ, ನಾನು ಈ ವಂಶಕ್ಕೆ ವಿರೋಧವಾಗಿ ನಾಶನವನ್ನು ಯೋಚಿಸುತ್ತೇನೆ.</para>
  <para style="q2" vid="MIC 2:3">ಇದರಿಂದ ನೀವು ನಿಮ್ಮನ್ನು ರಕ್ಷಿಸಿಕೊಳ್ಳಲಾರಿರಿ.</para>
  <para style="q1" vid="MIC 2:3">ಅಹಂಕಾರವಾಗಿ ನಡೆಯದೆ ಇರುವಿರಿ.</para>
  <para style="q2" vid="MIC 2:3">ಇದು ವಿಪತ್ತಿನ ಕಾಲವೇ,<verse eid="MIC 2:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="MIC 2:4"/>ಆ ದಿನದಲ್ಲಿ ಜನರು ನಿಮ್ಮನ್ನು ಅಪಹಾಸ್ಯ ಮಾಡುವರು.</para>
  <para style="q2" vid="MIC 2:4">‘ನಾವು ಸಂಪೂರ್ಣವಾಗಿ ಹಾಳಾಗಿದ್ದೇವೆ.</para>
  <para style="q1" vid="MIC 2:4">ನನ್ನ ಪ್ರಜೆಗಳ ಆಸ್ತಿ ವಿಭಾಗವಾಗಿದೆ.</para>
  <para style="q2" vid="MIC 2:4">ಆತನು ಅದನ್ನು ನನ್ನಿಂದ ತೆಗೆದುಕೊಳ್ಳುವನು.</para>
  <para style="q1" vid="MIC 2:4">ಆತನು ನಮ್ಮ ಹೊಲಗಳನ್ನು ದ್ರೋಹಿಗಳಿಗೆ ಹಂಚಿಕೊಟ್ಟಿದ್ದಾನೆ,’ ”</para>
  <para style="q2" vid="MIC 2:4">ಎಂಬ ದುಃಖದಾಯಕ ಸಂಗೀತದಿಂದ ಹಾಸ್ಯಮಾಡುವರು.<verse eid="MIC 2:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="MIC 2:5"/>ಆದ್ದರಿಂದ ಚೀಟುಹಾಕಿ ದೇಶವನ್ನು</para>
  <para style="q2" vid="MIC 2:5">ಹಂಚುವದಕ್ಕೆ ಯೆಹೋವ ದೇವರ ಸಭೆಯಲ್ಲಿ ನಿನಗೆ ಯಾರೂ ಇರುವುದಿಲ್ಲ.<verse eid="MIC 2:5"/></para>
  <para style="s1">ಸುಳ್ಳು ಪ್ರವಾದಿಗಳು</para>
  <para style="q1">
    <verse number="6" style="v" sid="MIC 2:6"/>“ಪ್ರವಾದಿಸಬೇಡ, ಈ ಸಂಗತಿಗಳ ಬಗ್ಗೆ ಪ್ರವಾದನೆ ಹೇಳಬೇಡ.</para>
  <para style="q2" vid="MIC 2:6">ಅವಮಾನ ನಮ್ಮ ಮೇಲೆ ಬರುವುದೇ ಇಲ್ಲ,”</para>
  <para style="q2" vid="MIC 2:6">ಎಂದು ಅವರ ಪ್ರವಾದಿಗಳು ಹೇಳುತ್ತಾರೆ.<verse eid="MIC 2:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="MIC 2:7"/>ಯಾಕೋಬಿನ ಮನೆತನದವರೇ,</para>
  <para style="q2" vid="MIC 2:7">“ಯೆಹೋವ ದೇವರ ಆತ್ಮವು ಕೋಪಗೊಂಡಿದೆಯೇ?</para>
  <para style="q2" vid="MIC 2:7">ಅವರು ಇಂಥ ಕಾರ್ಯ ಮಾಡುವರೋ?”</para>
  <para style="b" vid="MIC 2:7"/>
  <para style="q1" vid="MIC 2:7">“ಯಥಾರ್ಥವಾಗಿ ನಡೆಯುವವನಿಗೆ</para>
  <para style="q2" vid="MIC 2:7">ನನ್ನ ಮಾತುಗಳು ಒಳ್ಳೆಯದನ್ನು ಮಾಡುವುದಿಲ್ಲವೋ?<verse eid="MIC 2:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="MIC 2:8"/>ಇತ್ತೀಚೆಗೆ ನನ್ನ ಜನರು</para>
  <para style="q2" vid="MIC 2:8">ವೈರಿಯ ಹಾಗೆ ಎದ್ದಿದ್ದಾರೆ.</para>
  <para style="q1" vid="MIC 2:8">ಯುದ್ಧದಿಂದ ತಿರುಗಿಕೊಂಡು ನಿರ್ಭಯವಾಗಿ</para>
  <para style="q2" vid="MIC 2:8">ಹೋಗುವವರ ವಸ್ತ್ರದ ಸಂಗಡ</para>
  <para style="q2" vid="MIC 2:8">ನಿಲುವಂಗಿಯನ್ನು ನೀವು ಕಿತ್ತುಕೊಳ್ಳುತ್ತೀರಿ.<verse eid="MIC 2:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="MIC 2:9"/>ನನ್ನ ಜನರ ಸ್ತ್ರೀಯರನ್ನು</para>
  <para style="q2" vid="MIC 2:9">ಅವರ ರಮ್ಯವಾದ ಮನೆಗಳೊಳಗಿಂದ ಹೊರಡಿಸಿದ್ದೀರಿ.</para>
  <para style="q1" vid="MIC 2:9">ಅವರ ಮಕ್ಕಳಿಂದ</para>
  <para style="q2" vid="MIC 2:9">ನನ್ನ ಆಶೀರ್ವಾದವನ್ನು ಎಂದೆಂದಿಗೂ ತೆಗೆದಿದ್ದೀರಿ.<verse eid="MIC 2:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="MIC 2:10"/>ಎದ್ದು ಹೋಗಿರಿ;</para>
  <para style="q2" vid="MIC 2:10">ಇದು ನಿಮ್ಮ ವಿಶ್ರಾಂತಿಯ ಸ್ಥಳವಲ್ಲ,</para>
  <para style="q1" vid="MIC 2:10">ಏಕೆಂದರೆ ಇದಕ್ಕೆ ಹೊಲಸು ಅಂಟಿಕೊಂಡು,</para>
  <para style="q2" vid="MIC 2:10">ಯಾವ ಸುಧಾರಣೆಗೂ ಒಳಗಾಗದಂತೆ ಹಾಳಾಗಿ ಹೋಗಿಬಿಟ್ಟಿದೆ.<verse eid="MIC 2:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="MIC 2:11"/>ಒಬ್ಬ ಸುಳ್ಳುಗಾರನೂ ಮೋಸಗಾರನೂ ಬಂದು,</para>
  <para style="q2" vid="MIC 2:11">‘ನಿನಗೆ ದ್ರಾಕ್ಷಾರಸವೂ ಮದ್ಯಪಾನವೂ ಯಥೇಚ್ಛವಾಗಿ</para>
  <para style="q1" vid="MIC 2:11">ದೊರೆಯುವುದೆಂದು ನಾನು ಪ್ರವಾದಿಸುವೆನು,’</para>
  <para style="q2" vid="MIC 2:11">ಎಂದು ಹೇಳಿದರೆ, ಇವನೇ ಈ ಜನರಿಗೆ ಪ್ರವಾದಿಯಾಗಿರುವನು.<verse eid="MIC 2:11"/></para>
  <para style="s1">ಇಸ್ರಾಯೇಲಿಗೆ ರಕ್ಷಣೆ ವಾಗ್ದಾನ</para>
  <para style="q1">
    <verse number="12" style="v" sid="MIC 2:12"/>“ಯಾಕೋಬೇ, ನಿನ್ನವರನ್ನೆಲ್ಲಾ ನಿಶ್ಚಯವಾಗಿ ಕೂಡಿಸುವೆನು.</para>
  <para style="q2" vid="MIC 2:12">ಇಸ್ರಾಯೇಲಿನಲ್ಲಿ ಉಳಿದವರನ್ನು ನಿಶ್ಚಯವಾಗಿ ಕೂಡಿಸುವೆನು.</para>
  <para style="q1" vid="MIC 2:12">ಬೊಚ್ರದ ಕುರಿಗಳಂತೆಯೂ ತಮ್ಮ ಹಟ್ಟಿಯ ನಡುವೆ ಇರುವ ಮಂದೆಯಂತೆಯೂ</para>
  <para style="q2" vid="MIC 2:12">ಅವರನ್ನು ಒಟ್ಟಾಗಿ ಕೂಡಿಸುವೆನು.</para>
  <para style="q2" vid="MIC 2:12">ಹುಲ್ಲುಗಾವಲಿನ ಕುರಿಮಂದೆಯಂತೆ, ಸ್ಥಳವು ಜನರಿಂದ ತುಂಬಿ ತುಳುಕುವುದು.<verse eid="MIC 2:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="MIC 2:13"/>ಮಾರ್ಗ ತೆರೆಯುವಾತನು ಅವರ ಮುಂದೆ ಹೋಗುವನು.</para>
  <para style="q2" vid="MIC 2:13">ಅವರು ಬಾಗಿಲು ತೆರೆದು ಹೊರಗೆ ಹೋಗುವರು.</para>
  <para style="q1" vid="MIC 2:13">ಅವರ ಅರಸನು ಅವರ ಮುಂದೆ ಹಾದು ಹೋಗುತ್ತಾನೆ.</para>
  <para style="q2" vid="MIC 2:13">ಯೆಹೋವ ದೇವರು ಅವರ ಮುಂದಾಳತ್ವವನ್ನು ವಹಿಸುವರು.”<verse eid="MIC 2:13"/></para>
  <chapter eid="MIC 2"/>
  <chapter number="3" style="c" sid="MIC 3"/>
  <para style="s1">ನಾಯಕರನ್ನು ಪ್ರವಾದಿಗಳನ್ನು ಗದರಿಸಿದ್ದು</para>
  <para style="p">
    <verse number="1" style="v" sid="MIC 3:1"/>ಆಗ ನಾನು,</para>
  <para style="q1" vid="MIC 3:1">“ಯಾಕೋಬಿನ ಮುಖ್ಯಸ್ಥರೇ,</para>
  <para style="q2" vid="MIC 3:1">ಇಸ್ರಾಯೇಲಿನ ಮನೆತನದ ಪ್ರಧಾನರೇ,</para>
  <para style="q1" vid="MIC 3:1">ಈಗ ಕೇಳಿರಿ. ನೀವು ನ್ಯಾಯವನ್ನು ಪ್ರೀತಿಸಬಾರದೇ.<verse eid="MIC 3:1"/></para>
  <para style="q2">
    <verse number="2" style="v" sid="MIC 3:2"/>ಒಳ್ಳೆಯದನ್ನು ದ್ವೇಷಮಾಡಿ ಕೆಟ್ಟದ್ದನ್ನು ಪ್ರೀತಿ ಮಾಡುವವರೇ,</para>
  <para style="q1" vid="MIC 3:2">ಅವರ ಮೇಲಿನಿಂದ ಅವರ ಚರ್ಮವನ್ನೂ ನನ್ನ ಜನರ</para>
  <para style="q2" vid="MIC 3:2">ಎಲುಬುಗಳ ಮೇಲಿನಿಂದ ಅವರ ಮಾಂಸವನ್ನೂ ಕಿತ್ತು ಕೊಳ್ಳುವವರೇ,<verse eid="MIC 3:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="MIC 3:3"/>ನನ್ನ ಪ್ರಜೆಯ ಮಾಂಸವನ್ನು ತಿನ್ನುತ್ತಾರೆ.</para>
  <para style="q2" vid="MIC 3:3">ಅವರ ಚರ್ಮವನ್ನು ಸುಲಿದುಹಾಕುತ್ತಾರೆ.</para>
  <para style="q2" vid="MIC 3:3">ಅವರ ಎಲುಬುಗಳನ್ನು ಮುರಿದುಹಾಕುತ್ತೀರಿ.</para>
  <para style="q1" vid="MIC 3:3">ಹಂಡೆಯಲ್ಲಿನ ತುಂಡುಗಳಂತೆ, ಮಡಕೆಯಲ್ಲಿನ ಮಾಂಸದ ಚೂರುಗಳಂತೆ</para>
  <para style="q2" vid="MIC 3:3">ನನ್ನ ಪ್ರಜೆಯನ್ನು ಚೂರುಚೂರಾಗಿ ಕತ್ತರಿಸಿಹಾಕಿದ್ದೀರಿ.”<verse eid="MIC 3:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="MIC 3:4"/>ಆಗ ಅವರು ಯೆಹೋವ ದೇವರಿಗೆ ಮೊರೆಯಿಡುವರು;</para>
  <para style="q2" vid="MIC 3:4">ಆದರೆ ಅವರು ಅವರಿಗೆ ಉತ್ತರ ಕೊಡುವುದಿಲ್ಲ.</para>
  <para style="q1" vid="MIC 3:4">ಅವರು ಕೆಟ್ಟ ಕ್ರಿಯೆಗಳನ್ನು ಮಾಡಿದ ಪ್ರಕಾರವೇ,</para>
  <para style="q2" vid="MIC 3:4">ಆ ಕಾಲದಲ್ಲಿ ಅವರಿಗೆ ತಮ್ಮ ಮುಖವನ್ನು ಮರೆಮಾಡುವರು.<verse eid="MIC 3:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="MIC 3:5"/>ಯೆಹೋವ ದೇವರು ಹೇಳುವುದೇನೆಂದರೆ,</para>
  <para style="q1" vid="MIC 3:5">“ನನ್ನ ಜನರನ್ನು ಸನ್ಮಾರ್ಗದಿಂದ ತಪ್ಪಿಸುವ ಪ್ರವಾದಿಗಳಿಗೆ</para>
  <para style="q2" vid="MIC 3:5">ತಿನ್ನಲು ಕೊಟ್ಟರೆ ‘ಸಮಾಧಾನವಾಗಲಿ’ ಎನ್ನುವರು.</para>
  <para style="q1" vid="MIC 3:5">ಆದರೆ ಅವರಿಗೆ ತಿನ್ನಲು ಏನೂ ಕೊಡದವನ</para>
  <para style="q2" vid="MIC 3:5">ವಿರೋಧವಾಗಿ ಯುದ್ಧಕ್ಕೂ ಅವರು ಸಿದ್ಧರಾಗುವರು.<verse eid="MIC 3:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="MIC 3:6"/>ದರ್ಶನವಿಲ್ಲದೆ, ನಿಮಗೆ ರಾತ್ರಿಯಾಗುವುದು;</para>
  <para style="q2" vid="MIC 3:6">ಶಕುನವಿಲ್ಲದೆ ನಿಮಗೆ ಕತ್ತಲಾಗುವುದು.</para>
  <para style="q1" vid="MIC 3:6">ಪ್ರವಾದಿಗಳಿಗೆ ಸೂರ್ಯ ಮುಳುಗುವುದು.</para>
  <para style="q2" vid="MIC 3:6">ಅವರ ಮೇಲೆ ಹಗಲು ಕತ್ತಲೆಯಾಗುವುದು.<verse eid="MIC 3:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="MIC 3:7"/>ಆಗ ದರ್ಶಿಗಳು ನಾಚಿಕೆಪಡುವರು,</para>
  <para style="q2" vid="MIC 3:7">ಶಕುನಗಾರರು ಅವಮಾನಗೊಳ್ಳುವರು.</para>
  <para style="q1" vid="MIC 3:7">ದೇವರಿಂದ ಉತ್ತರವಿಲ್ಲದ ಕಾರಣ,</para>
  <para style="q2" vid="MIC 3:7">ಎಲ್ಲರೂ ತಮ್ಮ ತುಟಿಗಳನ್ನು ಮುಚ್ಚಿಕೊಳ್ಳುವರು.”<verse eid="MIC 3:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="MIC 3:8"/>ಆದರೆ ನಿಶ್ಚಯವಾಗಿ ನಾನು ಯಾಕೋಬಿನ ಅವನ ಅಪರಾಧವನ್ನೂ</para>
  <para style="q2" vid="MIC 3:8">ಇಸ್ರಾಯೇಲಿಗೆ ಅವನ ಪಾಪವನ್ನೂ ತಿಳಿಸುವುದಕ್ಕೆ</para>
  <para style="q1" vid="MIC 3:8">ಯೆಹೋವ ದೇವರ ಆತ್ಮದ ಮುಖಾಂತರ ಶಕ್ತಿಯಿಂದಲೂ</para>
  <para style="q2" vid="MIC 3:8">ನ್ಯಾಯದಿಂದಲೂ ತ್ರಾಣದಿಂದಲೂ ತುಂಬಿದ್ದೇನೆ.<verse eid="MIC 3:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="MIC 3:9"/>ಯಾಕೋಬನ ಮನೆತನದವರ ಪ್ರಧಾನರೇ,</para>
  <para style="q2" vid="MIC 3:9">ಇಸ್ರಾಯೇಲಿನ ಮನೆತನದವರ</para>
  <para style="q1" vid="MIC 3:9">ನ್ಯಾಯಾಧಿಪತಿಗಳೇ, ನ್ಯಾಯವನ್ನು ನಿಂದಿಸಿ</para>
  <para style="q2" vid="MIC 3:9">ಸರಿಯಾದದ್ದನ್ನೆಲ್ಲಾ ಡೊಂಕುಮಾಡುವವರೇ,<verse eid="MIC 3:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="MIC 3:10"/>ಚೀಯೋನನ್ನು ರಕ್ತದಿಂದಲೂ</para>
  <para style="q2" vid="MIC 3:10">ಯೆರೂಸಲೇಮನ್ನು ಅನ್ಯಾಯದಿಂದಲೂ ಕಟ್ಟುವವರೇ, ಈಗ ಇದನ್ನು ಕೇಳಿರಿ.<verse eid="MIC 3:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="MIC 3:11"/>ಅದರ ಮುಖ್ಯಸ್ಥರು ಲಂಚಕ್ಕೆ ನ್ಯಾಯತೀರಿಸುತ್ತಾರೆ.</para>
  <para style="q2" vid="MIC 3:11">ಅದರ ಯಾಜಕರು ಸಂಬಳಕ್ಕೆ ಬೋಧಿಸುತ್ತಾರೆ.</para>
  <para style="q2" vid="MIC 3:11">ಅದರ ಪ್ರವಾದಿಗಳು ಹಣಕ್ಕೆ ಶಕುನ ಹೇಳುತ್ತಾರೆ.</para>
  <para style="q1" vid="MIC 3:11">ಆದರೂ ಯೆಹೋವ ದೇವರ ಮೇಲೆ ಆತುಕೊಂಡು,</para>
  <para style="q2" vid="MIC 3:11">“ಯೆಹೋವ ದೇವರು ನಮ್ಮ ಮಧ್ಯದಲ್ಲಿ ಇಲ್ಲವೋ?</para>
  <para style="q2" vid="MIC 3:11">ನಮ್ಮ ಮೇಲೆ ಕೇಡು ಬರುವುದಿಲ್ಲ,” ಎನ್ನುತ್ತಾರೆ.<verse eid="MIC 3:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="MIC 3:12"/>ಆದಕಾರಣ ನಿಮ್ಮ ನಿಮಿತ್ತವೇ,</para>
  <para style="q2" vid="MIC 3:12">ಚೀಯೋನನ್ನು ಹೊಲದ ಹಾಗೆ ಉಳಲಾಗುವುದು.</para>
  <para style="q1" vid="MIC 3:12">ಯೆರೂಸಲೇಮು ಹಾಳುದಿಬ್ಬಗಳಾಗುವುದು.</para>
  <para style="q2" vid="MIC 3:12">ಆಲಯದ ಬೆಟ್ಟವೂ ಕಾಡುಗುಡ್ಡಗಳಂತಾಗುವುದು.<verse eid="MIC 3:12"/></para>
  <chapter eid="MIC 3"/>
  <chapter number="4" style="c" sid="MIC 4"/>
  <para style="s1">ಯೆಹೋವ ದೇವರ ಬೆಟ್ಟ</para>
  <para style="p">
    <verse number="1" style="v" sid="MIC 4:1"/>ಅಂತ್ಯಕಾಲದಲ್ಲಿ,</para>
  <para style="q1" vid="MIC 4:1">ಯೆಹೋವ ದೇವರ ಮಂದಿರದ ಪರ್ವತವು</para>
  <para style="q2" vid="MIC 4:1">ಎಲ್ಲಾ ಗುಡ್ಡಬೆಟ್ಟಗಳಿಗಿಂತ ಉನ್ನತೋನ್ನತವಾಗಿ</para>
  <para style="q1" vid="MIC 4:1">ಬೆಳೆದು ನೆಲೆಗೊಳ್ಳುವುದು,</para>
  <para style="q2" vid="MIC 4:1">ಆಗ ಜನಾಂಗಗಳು ಅದರ ಬಳಿಗೆ ಪ್ರವಾಹದಂತೆ ಬರುವವು.<verse eid="MIC 4:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="MIC 4:2"/>ಅನೇಕ ಜನಾಂಗಗಳು ಬಂದು ಹೀಗೆಂದು ಹೇಳುವರು,</para>
  <para style="q1" vid="MIC 4:2">“ಬನ್ನಿರಿ, ಯೆಹೋವ ದೇವರ ಪರ್ವತಕ್ಕೂ</para>
  <para style="q2" vid="MIC 4:2">ಯಾಕೋಬನ ದೇವರ ಆಲಯಕ್ಕೂ ಏರಿಹೋಗೋಣ.</para>
  <para style="q1" vid="MIC 4:2">ಅವರು ತಮ್ಮ ಮಾರ್ಗಗಳನ್ನು ನಮಗೆ ಬೋಧಿಸುವರು.</para>
  <para style="q2" vid="MIC 4:2">ನಾವು ಅವರ ದಾರಿಗಳಲ್ಲಿ ನಡೆಯುವೆವು.</para>
  <para style="q1" vid="MIC 4:2">ಚೀಯೋನಿನಿಂದ ದೇವರ ನಿಯಮವೂ</para>
  <para style="q2" vid="MIC 4:2">ಯೆರೂಸಲೇಮಿನಿಂದ ದೇವರ ವಾಕ್ಯವೂ ಹೊರಡುವುವು.”<verse eid="MIC 4:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="MIC 4:3"/>ಆಗ ಆತನು ಅನೇಕ ಜನಗಳ ಮಧ್ಯದಲ್ಲಿ ನ್ಯಾಯತೀರಿಸಿ</para>
  <para style="q2" vid="MIC 4:3">ದೂರದಲ್ಲಿರುವ ಬಲವಾದ ಜನಾಂಗಗಳಿಗೆ ತೀರ್ಪುಕೊಡುವನು.</para>
  <para style="q1" vid="MIC 4:3">ಅವರು ತಮ್ಮ ಖಡ್ಗಗಳನ್ನು ನೇಗಿಲಿನ ಗುಳಗಳನ್ನಾಗಿಯೂ</para>
  <para style="q2" vid="MIC 4:3">ಬರ್ಜಿಗಳನ್ನು ಕುಡುಗೋಲುಗಳನ್ನಾಗಿಯೂ ಮಾಡುವರು.</para>
  <para style="q1" vid="MIC 4:3">ಜನಾಂಗಕ್ಕೆ ವಿರೋಧವಾಗಿ ಜನಾಂಗವು ಖಡ್ಗವನ್ನು ಪ್ರಯೋಗಿಸುವುದಿಲ್ಲ.</para>
  <para style="q2" vid="MIC 4:3">ಇನ್ನು ಮೇಲೆ ಯುದ್ಧಾಭ್ಯಾಸದ ಅಗತ್ಯ ಇರುವುದೇ ಇಲ್ಲ.<verse eid="MIC 4:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="MIC 4:4"/>ಆದರೆ ಒಬ್ಬಬ್ಬನು ತನ್ನ ತನ್ನ ದ್ರಾಕ್ಷಿಬಳ್ಳಿಯ ಕೆಳಗೂ</para>
  <para style="q2" vid="MIC 4:4">ತನ್ನ ತನ್ನ ಅಂಜೂರದ ಗಿಡದ ಕೆಳಗೂ ಕುಳಿತುಕೊಳ್ಳುವನು.</para>
  <para style="q1" vid="MIC 4:4">ಭಯಪಡಿಸುವವನು ಯಾರೂ ಇರುವುದಿಲ್ಲ.</para>
  <para style="q2" vid="MIC 4:4">ಏಕೆಂದರೆ ಸೇನಾಧೀಶ್ವರ ಯೆಹೋವ ದೇವರು ಇದನ್ನು ನುಡಿದಿದ್ದಾರೆ.<verse eid="MIC 4:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="MIC 4:5"/>ಎಲ್ಲಾ ಜನಾಂಗಗಳಲ್ಲಿ ಪ್ರತಿಯೊಬ್ಬನು</para>
  <para style="q2" vid="MIC 4:5">ತನ್ನ ತನ್ನ ದೇವರ ಹೆಸರಿನಲ್ಲಿ ನಡೆಯುವನು.</para>
  <para style="q1" vid="MIC 4:5">ಆದರೆ ನಾವು ನಮ್ಮ ದೇವರಾದ</para>
  <para style="q2" vid="MIC 4:5">ಯೆಹೋವ ದೇವರ ಹೆಸರಿನಲ್ಲಿ ಎಂದೆಂದಿಗೂ ನಡೆಯುವೆವು.<verse eid="MIC 4:5"/></para>
  <para style="s1">ದೇವರ ಯೋಜನೆ</para>
  <para style="q1">
    <verse number="6" style="v" sid="MIC 4:6"/>ಯೆಹೋವ ದೇವರು ಹೀಗೆ ಘೋಷಿಸುತ್ತಾರೆ, “ಆ ದಿವಸದಲ್ಲಿ”</para>
  <para style="q2" vid="MIC 4:6">ನಾನು ಕುಂಟಾದವರನ್ನು ಒಟ್ಟುಗೂಡಿಸುವೆನು.</para>
  <para style="q1" vid="MIC 4:6">ನಾನು ತಳ್ಳಿಬಿಟ್ಟದ್ದನ್ನೂ ಕಷ್ಟಪಡಿಸಿದವರನ್ನೂ</para>
  <para style="q2" vid="MIC 4:6">ಒಂದಾಗಿ ಸೇರಿಸುವೆನು.<verse eid="MIC 4:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="MIC 4:7"/>“ಕುಂಟಾದದ್ದನ್ನು ಉಳಿದದ್ದನ್ನಾಗಿಯೂ ತಳ್ಳಿಬಿಟ್ಟಿದ್ದನ್ನು</para>
  <para style="q2" vid="MIC 4:7">ಬಲವಾದ ಜನಾಂಗವಾಗಿಯೂ ಮಾಡುವೆನು.</para>
  <para style="q1" vid="MIC 4:7">ಯೆಹೋವ ದೇವರು ಇಂದಿನಿಂದ ಸದಾಕಾಲವೂ</para>
  <para style="q2" vid="MIC 4:7">ಚೀಯೋನ್ ಪರ್ವತದಲ್ಲಿ ಅವರ ಮೇಲೆ ಆಳುವರು.<verse eid="MIC 4:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="MIC 4:8"/>ಕುರಿಮಂದೆಯ ಬುರುಜೇ,</para>
  <para style="q2" vid="MIC 4:8">ಚೀಯೋನ್ ಪುತ್ರಿಯ ದುರ್ಗವೇ,</para>
  <para style="q1" vid="MIC 4:8">ಮೊದಲಿದ್ದ ರಾಜ್ಯಾಧಿಕಾರವೂ ನಿಮಗೆ ಲಭಿಸುವುದು.</para>
  <para style="q2" vid="MIC 4:8">ಯೆರೂಸಲೇಮಿನ ಪುತ್ರಿಗೆ ರಾಜ್ಯತ್ವವೂ ಬರುವುದು.”<verse eid="MIC 4:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="MIC 4:9"/>ಈಗ ಏಕೆ ಗಟ್ಟಿಯಾಗಿ ಕೂಗುತ್ತೀ?</para>
  <para style="q2" vid="MIC 4:9">ನಿನ್ನಲ್ಲಿ ಅರಸನಿಲ್ಲವೋ?</para>
  <para style="q1" vid="MIC 4:9">ನಿನ್ನ ಅಧಿಕಾರಿಯು ನಾಶವಾದನೋ?</para>
  <para style="q2" vid="MIC 4:9">ಹೆರುವವಳಂತೆ ನಿನಗೆ ವೇದನೆ ಬಂದಿರುವುದೋ?<verse eid="MIC 4:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="MIC 4:10"/>ಚೀಯೋನ್ ಪುತ್ರಿಯೇ ಹೆರುವವಳಂತೆ</para>
  <para style="q2" vid="MIC 4:10">ವೇದನೆ ತಾಳಿಕೋ,</para>
  <para style="q1" vid="MIC 4:10">ಏಕೆಂದರೆ ಈಗ ಪಟ್ಟಣದೊಳಗಿಂದ ಹೊರಟು</para>
  <para style="q2" vid="MIC 4:10">ಹೊಲದಲ್ಲಿ ವಾಸಮಾಡಿ</para>
  <para style="q1" vid="MIC 4:10">ಬಾಬಿಲೋನಿಗೆ ಹೋಗುವೆ,</para>
  <para style="q2" vid="MIC 4:10">ಅಲ್ಲಿ ನಿನಗೆ ಬಿಡುಗಡೆಯಾಗುವುದು.</para>
  <para style="q1" vid="MIC 4:10">ಅಲ್ಲಿ ಯೆಹೋವ ದೇವರು ನಿನ್ನನ್ನು</para>
  <para style="q2" vid="MIC 4:10">ನಿನ್ನ ಶತ್ರುಗಳ ಕೈಯೊಳಗಿಂದ ವಿಮೋಚಿಸುವರು.<verse eid="MIC 4:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="MIC 4:11"/>ಆದರೆ ಈಗ ಅನೇಕ ಜನಾಂಗಗಳು</para>
  <para style="q2" vid="MIC 4:11">ನಿನಗೆ ವಿರೋಧವಾಗಿ ಕೂಡಿಬಂದಿವೆ.</para>
  <para style="q1" vid="MIC 4:11">ಅವರು, “ಯೆರೂಸಲೇಮನ್ನು ಕೆಡಿಸೋಣ.</para>
  <para style="q2" vid="MIC 4:11">ಚೀಯೋನಿನ ನಾಶನವನ್ನು ಕಣ್ಣಾರೆ ನೋಡೋಣ,” ಎಂದು ಹೇಳುತ್ತಾರೆ.<verse eid="MIC 4:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="MIC 4:12"/>ಆದರೆ ಯೆಹೋವ ದೇವರ ಯೋಚನೆಗಳು</para>
  <para style="q2" vid="MIC 4:12">ಅವರಿಗೆ ತಿಳಿದಿಲ್ಲ.</para>
  <para style="q1" vid="MIC 4:12">ಆತನ ಆಲೋಚನೆಯನ್ನು ಅವರು ಗ್ರಹಿಸಲಿಲ್ಲ.</para>
  <para style="q2" vid="MIC 4:12">ಏಕೆಂದರೆ ಕಣದಲ್ಲಿ ಸಿವುಡುಗಳ ಹಾಗೆ ಅವರನ್ನು ಕೂಡಿಸುವರು.<verse eid="MIC 4:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="MIC 4:13"/>ಚೀಯೋನ್ ಪುತ್ರಿಯೇ, ಎದ್ದು ತುಳಿ.</para>
  <para style="q2" vid="MIC 4:13">ಏಕೆಂದರೆ ನಿನ್ನ ಕೊಂಬನ್ನು ಕಬ್ಬಿಣವಾಗಿಯೂ</para>
  <para style="q1" vid="MIC 4:13">ನಿನ್ನ ಗೊರಸುಗಳನ್ನು ಕಂಚಿನದಾಗಿಯೂ ಮಾಡುವೆನು.</para>
  <para style="q2" vid="MIC 4:13">ನೀನು ಅನೇಕ ಜನಾಂಗಗಳನ್ನು ಚೂರುಚೂರಾಗಿ ಮಾಡುವೆ.</para>
  <para style="q1" vid="MIC 4:13">ಅವರ ಕೊಳ್ಳೆಹೊಡೆದು ಸಂಪಾದಿಸಿದ್ದ ಸ್ವತ್ತನ್ನು ಯೆಹೋವ ದೇವರಿಗೂ</para>
  <para style="q2" vid="MIC 4:13">ಅವರ ಸಂಪತ್ತನ್ನು ಲೋಕದ ಕರ್ತ ದೇವರಿಗೂ ಪ್ರತಿಷ್ಠೆಮಾಡುವೆನು.<verse eid="MIC 4:13"/></para>
  <chapter eid="MIC 4"/>
  <chapter number="5" style="c" sid="MIC 5"/>
  <para style="s1">ಇಸ್ರಾಯೇಲರನ್ನು ರಕ್ಷಿಸುವ ಅಧಿಪತಿ</para>
  <para style="q1">
    <verse number="1" style="v" sid="MIC 5:1"/>ಬೇತ್ಲೆಹೇಮಿನಿಂದ ಒಬ್ಬ ಅಧಿಪತಿಯು ಸೈನ್ಯಗಳ ಪಟ್ಟಣವೇ, ಗುಂಪುಗಳಾಗಿ ಕೂಡಿಕೊಳ್ಳಿರಿ.</para>
  <para style="q2" vid="MIC 5:1">ನಮ್ಮ ಮೇಲೆ ಮುತ್ತಿಗೆ ಹಾಕಿದ್ದಾರೆ.</para>
  <para style="q1" vid="MIC 5:1">ಇಸ್ರಾಯೇಲಿನ ಅಧಿಪತಿಯನ್ನು</para>
  <para style="q2" vid="MIC 5:1">ಕೋಲಿನಿಂದ ಕೆನ್ನೆಯ ಮೇಲೆ ಹೊಡೆಯುತ್ತಾರೆ.<verse eid="MIC 5:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="MIC 5:2"/>ಆದರೆ ಎಫ್ರಾತದ ಬೇತ್ಲೆಹೇಮೇ,</para>
  <para style="q2" vid="MIC 5:2">ನೀನು ಯೆಹೂದದ ಗೋತ್ರಗಳಲ್ಲಿ ಸಣ್ಣದಾಗಿದ್ದರೂ</para>
  <para style="q1" vid="MIC 5:2">ಇಸ್ರಾಯೇಲಿನಲ್ಲಿ ದೊರೆತನ ಮಾಡತಕ್ಕವನು</para>
  <para style="q2" vid="MIC 5:2">ನಿನ್ನೊಳಗಿಂದ ನನಗಾಗಿ ಹೊರಡುವನು.</para>
  <para style="q1" vid="MIC 5:2">ಆತನ ಮೂಲವು ಪೂರ್ವದಿಂದಲೂ</para>
  <para style="q2" vid="MIC 5:2">ಅನಾದಿ ಕಾಲದಿಂದಲೂ ಆದದ್ದು.<verse eid="MIC 5:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="MIC 5:3"/>ಆದ್ದರಿಂದ ಹೆರುವವಳು ಒಬ್ಬ ಮಗನನ್ನು</para>
  <para style="q2" vid="MIC 5:3">ಹೆರುವ ಕಾಲದವರೆಗೂ ಇಸ್ರಾಯೇಲನ್ನು ಕೈಬಿಡಲಾಗುವುದು.</para>
  <para style="q1" vid="MIC 5:3">ಆಗ ಅವನ ಸಹೋದರರಲ್ಲಿ ಉಳಿದವರು</para>
  <para style="q2" vid="MIC 5:3">ಇಸ್ರಾಯೇಲರ ಬಳಿಗೆ ಹಿಂದಿರುಗುವರು.<verse eid="MIC 5:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="MIC 5:4"/>ಆತನು ಯೆಹೋವ ದೇವರ ಬಲದಲ್ಲಿಯೂ</para>
  <para style="q2" vid="MIC 5:4">ತನ್ನ ದೇವರಾದ ಯೆಹೋವ ದೇವರ ಹೆಸರಿನ ಘನತೆಯಲ್ಲಿಯೂ</para>
  <para style="q2" vid="MIC 5:4">ನಿಂತುಕೊಂಡು ತನ್ನ ಮಂದೆಯನ್ನು ಮೇಯಿಸುವನು.</para>
  <para style="q1" vid="MIC 5:4">ಅವರು ನೆಲೆಯಾಗಿರುವರು,</para>
  <para style="q2" vid="MIC 5:4">ಆತನ ಘನತೆಯು ಭೂಮಿಯ ಅಂತ್ಯಗಳ ಮಟ್ಟಿಗೂ ತಲುಪುವುದು.<verse eid="MIC 5:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="MIC 5:5"/>ಆತನೇ ಅವರ ಸಮಾಧಾನವಾಗಿರುವನು.</para>
  <para style="q2" vid="MIC 5:5">ಅಸ್ಸೀರಿಯದವನು ನಮ್ಮ ನಾಡಿಗೆ ಮುತ್ತಿಗೆ ಹಾಕುವಾಗ</para>
  <para style="q2" vid="MIC 5:5">ನಮ್ಮ ಕೋಟೆಗಳ ಮೂಲಕ ಸೈನ್ಯವಾಗಿ ಹೋಗುವಾಗ</para>
  <para style="q1" vid="MIC 5:5">ನಾವು ಅವನಿಗೆ ವಿರೋಧವಾಗಿ ಏಳು ಕುರುಬರನ್ನೂ</para>
  <para style="q2" vid="MIC 5:5">ಎಂಟು ಸೇನಾಪತಿಗಳನ್ನೂ ಎಬ್ಬಿಸುವೆವು.<verse eid="MIC 5:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="MIC 5:6"/>ಅವರು ಅಸ್ಸೀರಿಯ ದೇಶವನ್ನು ಖಡ್ಗದಿಂದಲೂ</para>
  <para style="q2" vid="MIC 5:6">ನಿಮ್ರೋದನ ದೇಶವನ್ನು ಹಿಡಿದ ಖಡ್ಗದಿಂದಲೂ ಆಳುವರು.</para>
  <para style="q1" vid="MIC 5:6">ಅಸ್ಸೀರಿಯವು ನಮ್ಮ ದೇಶದಲ್ಲಿ ಬಂದು</para>
  <para style="q2" vid="MIC 5:6">ನಮ್ಮ ಪ್ರದೇಶವನ್ನು ಮುತ್ತಿಗೆ ಹಾಕಿ ಪ್ರಾಂತಗಳಲ್ಲಿ ನಡೆಯುವಾಗ</para>
  <para style="q2" vid="MIC 5:6">ಆತನು ನಮ್ಮನ್ನು ತಪ್ಪಿಸುವನು.<verse eid="MIC 5:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="MIC 5:7"/>ಇದಲ್ಲದೆ ಯಾಕೋಬನ ಶೇಷವು</para>
  <para style="q2" vid="MIC 5:7">ಅನೇಕ ಜನಾಂಗಳ ಮಧ್ಯದಲ್ಲಿ</para>
  <para style="q1" vid="MIC 5:7">ಯೆಹೋವ ದೇವರಿಂದ ಬಂದ ಮಂಜಿನ ಹಾಗೆಯೂ</para>
  <para style="q2" vid="MIC 5:7">ಹುಲ್ಲಿನ ಮೇಲೆ ಜಡಿಮಳೆಯ ಹಾಗೆಯೂ ಇರುವುದು.</para>
  <para style="q1" vid="MIC 5:7">ಅದು ಮನುಷ್ಯರಿಗೋಸ್ಕರ ಆತುಕೊಳ್ಳುವುದಿಲ್ಲ,</para>
  <para style="q2" vid="MIC 5:7">ಮನುಷ್ಯ ಮಕ್ಕಳಿಗಾಗಿ ಕಾದುಕೊಳ್ಳುವುದಿಲ್ಲ.<verse eid="MIC 5:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="MIC 5:8"/>ಯಾಕೋಬನ ಜನಶೇಷವು ದೇಶದೇಶಗಳೊಳಗೆ</para>
  <para style="q2" vid="MIC 5:8">ಅನೇಕ ಜನಾಂಗಗಳ ಮಧ್ಯದಲ್ಲಿ,</para>
  <para style="q1" vid="MIC 5:8">ಅಡವಿಯ ಮೃಗಗಳಲ್ಲಿ ಸಿಂಹದಂತೆಯೂ</para>
  <para style="q2" vid="MIC 5:8">ಕುರಿಮಂದೆಗಳಲ್ಲಿ ಪ್ರಾಯದ ಸಿಂಹದಂತೆಯೂ ಇರುವುದು.</para>
  <para style="q1" vid="MIC 5:8">ಅದು ಹಾದುಹೋದರೆ ಇಳಿದುಬಿಟ್ಟು ಹರಿದುಬಿಡುತ್ತದೆ,</para>
  <para style="q2" vid="MIC 5:8">ಯಾರೂ ಬಿಡಿಸಲಾರರು,<verse eid="MIC 5:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="MIC 5:9"/>ನಿನ್ನ ಕೈ ನಿನ್ನ ವೈರಿಗಳೆಲ್ಲರ ಮೇಲೆ ಉನ್ನತವಾಗಿರುವುದು.</para>
  <para style="q2" vid="MIC 5:9">ನಿನ್ನ ಶತ್ರುಗಳೆಲ್ಲರು ನಾಶಹೊಂದುವರು.<verse eid="MIC 5:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="MIC 5:10"/>ಯೆಹೋವ ದೇವರು ಹೀಗೆ ಘೋಷಿಸುತ್ತಾರೆ:</para>
  <para style="q1" vid="MIC 5:10">“ಆ ದಿವಸದಲ್ಲಿ, ನಾನು ನಿನ್ನ ಮಧ್ಯದೊಳಗಿರುವ ನಿನ್ನ ಕುದುರೆಗಳನ್ನು ಕಡಿದುಬಿಟ್ಟು</para>
  <para style="q2" vid="MIC 5:10">ನಿನ್ನ ರಥಗಳನ್ನು ನಾಶಮಾಡುವೆನು.<verse eid="MIC 5:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="MIC 5:11"/>ನಿನ್ನ ದೇಶದ ಪಟ್ಟಣಗಳನ್ನು ನಾಶಮಾಡಿಬಿಟ್ಟು</para>
  <para style="q2" vid="MIC 5:11">ನಿನ್ನ ಕೋಟೆಗಳನ್ನೆಲ್ಲಾ ಕೆಡವಿಹಾಕುವೆನು.<verse eid="MIC 5:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="MIC 5:12"/>ನಿನ್ನ ಮಂತ್ರತಂತ್ರವನ್ನು ನಾಶಮಾಡುವೆನು;</para>
  <para style="q2" vid="MIC 5:12">ಕಣಿ ಹೇಳುವವರು ನಿನಗೆ ಇನ್ನು ಇರುವುದಿಲ್ಲ.<verse eid="MIC 5:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="MIC 5:13"/>ನಿನ್ನ ಕೆತ್ತಿದ ವಿಗ್ರಹಗಳನ್ನೂ</para>
  <para style="q2" vid="MIC 5:13">ನಿಂತಿರುವ ನಿನ್ನ ಪ್ರತಿಮೆಗಳನ್ನೂ ಸಹ ನಿನ್ನ ಮಧ್ಯದೊಳಗಿಂದ ಕಡಿದುಬಿಡುವೆನು.</para>
  <para style="q1" vid="MIC 5:13">ಇನ್ನು ನಿನ್ನ ಸ್ವಂತ ಕೈಗಳು ರೂಪಿಸಿದ್ದನ್ನು</para>
  <para style="q2" vid="MIC 5:13">ನೀನು ಆರಾಧಿಸದಂತೆ ಮಾಡುವೆನು.<verse eid="MIC 5:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="MIC 5:14"/>ನಿನ್ನ ಅಶೇರ ಸ್ತಂಭಗಳನ್ನು ನಿನ್ನ ಮಧ್ಯದೊಳಗಿಂದ ಕಿತ್ತುಹಾಕಿ</para>
  <para style="q2" vid="MIC 5:14">ನಿನ್ನ ಪಟ್ಟಣಗಳನ್ನು ನಾಶಮಾಡುವೆನು.<verse eid="MIC 5:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="MIC 5:15"/>ನನಗೆ ಕಿವಿಗೊಡದೆ ಇದ್ದ ಜನಾಂಗಗಳಿಗೆ</para>
  <para style="q2" vid="MIC 5:15">ಕೋಪದಿಂದಲೂ ಉಗ್ರದಿಂದಲೂ ಮುಯ್ಯಿಗೆ ಮುಯ್ಯಿತೀರಿಸುವೆನು.”<verse eid="MIC 5:15"/></para>
  <chapter eid="MIC 5"/>
  <chapter number="6" style="c" sid="MIC 6"/>
  <para style="s1">ಇಸ್ರಾಯೇಲರ ವಿರುದ್ಧ ಯೆಹೋವ ದೇವರ ವ್ಯಾಜ್ಯ</para>
  <para style="p">
    <verse number="1" style="v" sid="MIC 6:1"/>ಯೆಹೋವ ದೇವರು ಹೇಳುವುದನ್ನು ಈಗ ಕೇಳಿರಿ,</para>
  <para style="q1" vid="MIC 6:1">ಎದ್ದೇಳು, ಬೆಟ್ಟಗಳ ಮುಂದೆ ವ್ಯಾಜ್ಯವಾಡು;</para>
  <para style="q2" vid="MIC 6:1">ನೀನು ಹೇಳುವುದನ್ನು ಗುಡ್ಡಗಳು ಕೇಳಲಿ.<verse eid="MIC 6:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="MIC 6:2"/>ಬೆಟ್ಟಗಳೇ, ಯೆಹೋವ ದೇವರ ಆಪಾದನೆಯನ್ನು ಕೇಳಿರಿ.</para>
  <para style="q2" vid="MIC 6:2">ಭೂಮಿಯ ಶಾಶ್ವತವಾದ ಅಸ್ತಿವಾರಗಳೇ ಕಿವಿಗೊಡಿರಿ.</para>
  <para style="q1" vid="MIC 6:2">ಏಕೆಂದರೆ ಯೆಹೋವ ದೇವರಿಗೆ ತಮ್ಮ ಜನರ ವಿರುದ್ಧ ವ್ಯಾಜ್ಯವಿದೆ,</para>
  <para style="q2" vid="MIC 6:2">ಅವರು ಇಸ್ರಾಯೇಲಿನ ವಿರುದ್ಧ ಆರೋಪಿಸುತ್ತಾರೆ.<verse eid="MIC 6:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="MIC 6:3"/>ನನ್ನ ಜನರೇ, ನಾನು ನಿಮಗೆ ಏನು ಮಾಡಿದ್ದೇನೆ?</para>
  <para style="q2" vid="MIC 6:3">ನಾನು ನಿಮ್ಮ ಮೇಲೆ ಭಾರ ಹಾಕಿದ್ದೇನೋ? ನನಗೆ ಉತ್ತರಕೊಡಿರಿ.<verse eid="MIC 6:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="MIC 6:4"/>ನಾನು ಈಜಿಪ್ಟ್ ದೇಶದೊಳಗಿಂದ ನಿನ್ನನ್ನು ಮೇಲೆ ಬರಮಾಡಿ,</para>
  <para style="q2" vid="MIC 6:4">ದಾಸತ್ವದ ದೇಶದೊಳಗಿಂದ ನಿನ್ನನ್ನು ವಿಮೋಚಿಸಿ,</para>
  <para style="q1" vid="MIC 6:4">ಮೋಶೆ, ಆರೋನ್ ಮತ್ತು ಮಿರ್ಯಾಮಳನ್ನು</para>
  <para style="q2" vid="MIC 6:4">ನಿನಗೆ ನಾಯಕರನ್ನಾಗಿ ಕಳುಹಿಸಿದೆನು.<verse eid="MIC 6:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="MIC 6:5"/>ನನ್ನ ಜನರೇ,</para>
  <para style="q2" vid="MIC 6:5">ಮೋವಾಬಿನ ಅರಸನಾದ ಬಾಲಾಕನು ಯೋಚಿಸಿದ್ದನ್ನೂ</para>
  <para style="q2" vid="MIC 6:5">ಬೆಯೋರನ ಮಗ ಬಿಳಾಮನು ಅವನಿಗೆ ಉತ್ತರವಾಗಿ ಹೇಳಿದ್ದನ್ನೂ</para>
  <para style="q1" vid="MIC 6:5">ಶಿಟ್ಟೀಮು ಮೊದಲುಗೊಂಡು ಗಿಲ್ಗಾಲಿನ ವರೆಗೆ ಆದ</para>
  <para style="q2" vid="MIC 6:5">ನಿಮ್ಮ ಪ್ರಯಾಣವನ್ನೂ ಈಗ ಜ್ಞಾಪಕಮಾಡಿಕೊಳ್ಳಿರಿ.</para>
  <para style="q2" vid="MIC 6:5">ಆಗ ಯೆಹೋವ ದೇವರ ನೀತಿಯ ಕೃತ್ಯಗಳನ್ನು ತಿಳಿದುಕೊಳ್ಳುವಿರಿ.<verse eid="MIC 6:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="MIC 6:6"/>ನಾನು ಯಾವುದರೊಂದಿಗೆ ಯೆಹೋವ ದೇವರ ಮುಂದೆ ಬಂದು,</para>
  <para style="q2" vid="MIC 6:6">ಯಾವುದರೊಂದಿಗೆ ಉನ್ನತವಾದ ದೇವರ ಮುಂದೆ ಅಡ್ಡಬೀಳಲಿ?</para>
  <para style="q1" vid="MIC 6:6">ದಹನಬಲಿಗಳ ಮತ್ತು</para>
  <para style="q2" vid="MIC 6:6">ಒಂದು ವರ್ಷದ ಕರುಗಳ ಸಂಗಡ ಆತನ ಮುಂದೆ ಹೋಗಲೇ?<verse eid="MIC 6:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="MIC 6:7"/>ಯೆಹೋವ ದೇವರು ಸಾವಿರ ಟಗರುಗಳಿಗಾದರೂ</para>
  <para style="q2" vid="MIC 6:7">ಎಣ್ಣೆಯ ಹತ್ತು ಸಾವಿರ ನದಿಗಳಿಗಾದರೂ ಮೆಚ್ಚುವರೋ?</para>
  <para style="q1" vid="MIC 6:7">ನನ್ನ ದ್ರೋಹಕ್ಕಾಗಿ ನನ್ನ ಚೊಚ್ಚಲ ಮಗನನ್ನೂ</para>
  <para style="q2" vid="MIC 6:7">ನನ್ನ ಆತ್ಮದ ಪಾಪಕ್ಕಾಗಿ ನನ್ನ ಗರ್ಭದ ಫಲವನ್ನೂ ಕೊಡಲೋ?<verse eid="MIC 6:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="MIC 6:8"/>ಮನುಷ್ಯನೇ, ಒಳ್ಳೆಯದೇನೆಂದು ನಿನಗೆ ದೇವರು ತೋರಿಸಿದ್ದಾರೆ.</para>
  <para style="q2" vid="MIC 6:8">ಹೌದು, ನ್ಯಾಯವನ್ನು ಕೈಗೊಳ್ಳುವದೂ ಕರುಣೆಯನ್ನು ಪ್ರೀತಿಸುವುದೂ</para>
  <para style="q1" vid="MIC 6:8">ನಿನ್ನ ದೇವರ ಮುಂದೆ ನಮ್ರನಾಗಿ ನಡೆದುಕೊಳ್ಳುವದೂ</para>
  <para style="q2" vid="MIC 6:8">ಇದನ್ನೇ ಹೊರತು ಯೆಹೋವ ದೇವರು ನಿನ್ನಿಂದ ಇನ್ನೇನನ್ನು ಅಪೇಕ್ಷಿಸುತ್ತಾರೆ?<verse eid="MIC 6:8"/></para>
  <para style="s1">ಇಸ್ರಾಯೇಲರ ವಂಚನೆ ಮತ್ತು ಶಿಕ್ಷೆ</para>
  <para style="q1">
    <verse number="9" style="v" sid="MIC 6:9"/>ಕೇಳು! ಯೆಹೋವ ದೇವರು ಪಟ್ಟಣವನ್ನು ಕರೆಯುತ್ತಿದ್ದಾರೆ.</para>
  <para style="q2" vid="MIC 6:9">ನಿಮ್ಮ ನಾಮಕ್ಕೆ ಭಯಪಡುವುದು ಜ್ಞಾನ.</para>
  <para style="q2" vid="MIC 6:9">ಕೋಲು ಮತ್ತು ಅದನ್ನು ನೇಮಿಸಿದ ವ್ಯಕ್ತಿಯನ್ನು ಎಚ್ಚರಿಕೆಯಿಂದ ಆಲಿಸಿರಿ.<verse eid="MIC 6:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="MIC 6:10"/>ದುಷ್ಟಮನೆತನವೇ ನೀನು ಕೆಟ್ಟದ್ದಾಗಿ ಸಂಪಾದಿಸಿದ್ದನ್ನು ಶಾಪಗ್ರಸ್ತರಾದ</para>
  <para style="q2" vid="MIC 6:10">ಕಡಿಮೆ ಅಳತೆಯನ್ನು ನಾನು ಮರೆಯಬೇಕೋ?<verse eid="MIC 6:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="MIC 6:11"/>ನಾನು ದುಷ್ಟತ್ವದ ತಕ್ಕಡಿಗಳುಳ್ಳವರನ್ನು</para>
  <para style="q2" vid="MIC 6:11">ಮೋಸವಾದ ಕಲ್ಲುಗಳ ಚೀಲವುಳ್ಳವರನ್ನು ನಿರ್ಮಲರೆಂದೆಣಿಸುವೆನೋ?<verse eid="MIC 6:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="MIC 6:12"/>ಅದರ ಐಶ್ವರ್ಯವಂತರು ಬಲಾತ್ಕಾರದಿಂದ ತುಂಬಿದ್ದಾರೆ.</para>
  <para style="q2" vid="MIC 6:12">ಅದರ ನಿವಾಸಿಗಳು ಸುಳ್ಳುಗಳನ್ನು ಹೇಳುವವರಾಗಿದ್ದಾರೆ.</para>
  <para style="q2" vid="MIC 6:12">ಅವರ ನಾಲಿಗೆ ಅವರ ಬಾಯಿಯಲ್ಲಿ ಕಪಟವುಳ್ಳದ್ದೇ.<verse eid="MIC 6:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="MIC 6:13"/>ಆದ್ದರಿಂದ ನಾನು ಸಹ ನಿನ್ನನ್ನು ಹೊಡೆದು</para>
  <para style="q2" vid="MIC 6:13">ನಿನ್ನ ಪಾಪಗಳ ನಿಮಿತ್ತ ನಿನ್ನನ್ನು ಹಾಳುಮಾಡುವೆನು.<verse eid="MIC 6:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="MIC 6:14"/>ನೀನು ಉಂಡರೂ ತೃಪ್ತಿಯಾಗದೆ ಇರುವೆ;</para>
  <para style="q2" vid="MIC 6:14">ನಿನ್ನೊಳಗೆ ಹಸಿವೆಯು ಇರುವುದು;</para>
  <para style="q1" vid="MIC 6:14">ನೀವು ಸಂಗ್ರಹಿಸುತ್ತೀರಿ ಆದರೆ ಏನನ್ನೂ ಉಳಿಸುವುದಿಲ್ಲ,</para>
  <para style="q2" vid="MIC 6:14">ಏಕೆಂದರೆ ನೀವು ಉಳಿಸುವದನ್ನು ನಾನು ಕತ್ತಿಗೆ ಕೊಡುತ್ತೇನೆ.<verse eid="MIC 6:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="MIC 6:15"/>ನೀನು ಬೀಜ ಬಿತ್ತಿ ಕೊಯ್ಯದೆ ಇರುವೆ;</para>
  <para style="q2" vid="MIC 6:15">ಹಿಪ್ಪೆಗಳನ್ನು ತುಳಿದು ಎಣ್ಣೆ ಹಚ್ಚಿಕೊಳ್ಳದೆ ಇರುವೆ;</para>
  <para style="q2" vid="MIC 6:15">ದ್ರಾಕ್ಷಾರಸಮಾಡಿ ಕುಡಿಯದೆ ಇರುವೆ.<verse eid="MIC 6:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="MIC 6:16"/>ಏಕೆಂದರೆ ಒಮ್ರಿಯ ನಿಯಮಗಳನ್ನೂ ಕೈಕೊಳ್ಳುತ್ತೀರಿ.</para>
  <para style="q2" vid="MIC 6:16">ಅಹಾಬ್ ಮನೆತನದ ದುರಾಚಾರಗಳನ್ನೂ</para>
  <para style="q2" vid="MIC 6:16">ಅವರ ಸಂಪ್ರದಾಯಗಳನ್ನೂ ಅನುಸರಿಸುತ್ತಾ ಬಂದಿದ್ದೀರಿ.</para>
  <para style="q1" vid="MIC 6:16">ಆದ್ದರಿಂದ ನೀವು ನಾಶವಾಗುವಂತೆ ಮಾಡುವೆನು.</para>
  <para style="q2" vid="MIC 6:16">ನಿಮ್ಮ ಜನರನ್ನು ಅಪಹಾಸ್ಯಕ್ಕೆ ಗುರಿಮಾಡುವೆನು.</para>
  <para style="q2" vid="MIC 6:16">ಆದ್ದರಿಂದ ನೀವು ನನ್ನ ಜನರ ನಿಂದೆಯನ್ನು ಹೊರುವಿರಿ.<verse eid="MIC 6:16"/></para>
  <chapter eid="MIC 6"/>
  <chapter number="7" style="c" sid="MIC 7"/>
  <para style="s1">ಇಸ್ರಾಯೇಲಿನ ಕೊರಗುವಿಕೆ</para>
  <para style="q1">
    <verse number="1" style="v" sid="MIC 7:1"/>ಎಂತಹ ಸಂಕಟ ನನ್ನದು!</para>
  <para style="q1" vid="MIC 7:1">ನಾನು ಬೇಸಿಗೆ ಕಾಲದ ಹಣ್ಣುಗಳನ್ನು ಕೂಡಿಸುವವರ ಹಾಗೆಯೂ</para>
  <para style="q2" vid="MIC 7:1">ದ್ರಾಕ್ಷಿ ಸುಗ್ಗಿಯಲ್ಲಿ ಹಕ್ಕಲು ಆರಿಸುವವರ ಹಾಗೆಯೂ ಇದ್ದೇನೆ.</para>
  <para style="q1" vid="MIC 7:1">ತಿನ್ನುವುದಕ್ಕೆ ಗೊಂಚಲೇ ಇಲ್ಲ.</para>
  <para style="q2" vid="MIC 7:1">ನನಗೆ ಪ್ರಿಯವಾದ ಮೊದಲು ಮಾಗಿದ ಅಂಜೂರದ ಹಣ್ಣುಗಳೂ ಇಲ್ಲ.<verse eid="MIC 7:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="MIC 7:2"/>ನಿಷ್ಠಾವಂತರು ಭೂಮಿಯೊಳಗಿಂದ ನಾಶವಾಗಿದ್ದಾರೆ.</para>
  <para style="q2" vid="MIC 7:2">ಮನುಷ್ಯರಲ್ಲಿ ಯಥಾರ್ಥನು ಒಬ್ಬನು ಉಳಿದಿಲ್ಲ;</para>
  <para style="q1" vid="MIC 7:2">ಎಲ್ಲರು ರಕ್ತಕ್ಕೆ ಹೊಂಚಿ ನೋಡುತ್ತಾ,</para>
  <para style="q2" vid="MIC 7:2">ತಮ್ಮ ತಮ್ಮ ಸಹೋದರರನ್ನು ಬಲೆಹಾಕಿ ಬೇಟೆ ಆಡುತ್ತಾರೆ.<verse eid="MIC 7:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="MIC 7:3"/>ಕೆಟ್ಟದ್ದನ್ನು ಎರಡು ಕೈಗಳಿಂದ ಚೆನ್ನಾಗಿ ಮಾಡುವಂತೆ</para>
  <para style="q2" vid="MIC 7:3">ಆಡಳಿತಗಾರರು ಉಡುಗೊರೆಗಳನ್ನು ಕೇಳುತ್ತಾರೆ.</para>
  <para style="q1" vid="MIC 7:3">ನ್ಯಾಯಾಧಿಪತಿಗಳು ಲಂಚವನ್ನು ತೆಗೆದುಕೊಳ್ಳುತ್ತಾರೆ.</para>
  <para style="q2" vid="MIC 7:3">ಶಕ್ತಿಶಾಲಿ ಮನುಷ್ಯನು ತನ್ನ ಕೇಡಿನ ಆಸೆಯನ್ನು ತಾನೇ ಹೇಳುತ್ತಾನೆ;</para>
  <para style="q2" vid="MIC 7:3">ಅವರೆಲ್ಲರೂ ಒಟ್ಟಾಗಿ ಒಳಸಂಚುಮಾಡುತ್ತಾರೆ.<verse eid="MIC 7:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="MIC 7:4"/>ಅವರಲ್ಲಿ ಉತ್ತಮನು ದತ್ತೂರಿಯ ಹಾಗೆಯೂ</para>
  <para style="q2" vid="MIC 7:4">ಬಹು ಯಥಾರ್ಥನು ಮುಳ್ಳಿನ ಬೇಲಿಯ ಹಾಗೆಯೂ ಇದ್ದಾನೆ.</para>
  <para style="q2" vid="MIC 7:4">ದೇವರು ನಿನ್ನನ್ನು ಭೇಟಿಮಾಡುವ ದಿನ ಬಂದಿದೆ,</para>
  <para style="q1" vid="MIC 7:4">ನಿನ್ನ ಕಾವಲುಗಾರರು ಎಚ್ಚರಿಕೆಯ ಗಂಟೆಯನ್ನು ಬಾರಿಸುತ್ತಾರೆ.</para>
  <para style="q2" vid="MIC 7:4">ಈಗ ನೀವು ಭಯಭೀತರಾಗುವ ಸಮಯ.<verse eid="MIC 7:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="MIC 7:5"/>ನೆರೆಯವನಲ್ಲಿ ನಂಬಿಕೆ ಇಡಬೇಡಿರಿ;</para>
  <para style="q2" vid="MIC 7:5">ಆಪ್ತಸ್ನೇಹಿತನಲ್ಲಿ ಭರವಸೆ ಇಡಬೇಡಿರಿ;</para>
  <para style="q1" vid="MIC 7:5">ನಿನ್ನ ಎದೆಯಲ್ಲಿ ಮಲಗುವವಳಿಗೆ</para>
  <para style="q2" vid="MIC 7:5">ನಿನ್ನ ಬಾಯಿಯ ಬಾಗಿಲುಗಳನ್ನು ಕಾಯಿ.<verse eid="MIC 7:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="MIC 7:6"/>ಏಕೆಂದರೆ ಮಗನು ತನ್ನ ತಂದೆಯನ್ನು ಅವಮಾನ ಮಾಡುತ್ತಾನೆ.</para>
  <para style="q2" vid="MIC 7:6">ಮಗಳು ತನ್ನ ತಾಯಿಗೂ,</para>
  <para style="q1" vid="MIC 7:6">ಸೊಸೆಗೂ ಆಕೆಯ ಅತ್ತೆಗೂ ವಿರೋಧವಾಗಿ ಏಳುತ್ತಾರೆ.</para>
  <para style="q2" vid="MIC 7:6">ಒಬ್ಬ ಮನುಷ್ಯನಿಗೆ ಅವನ ಮನೆಯವರೇ ವೈರಿಗಳಾಗುವರು.<verse eid="MIC 7:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="MIC 7:7"/>ಆದರೆ ನಾನು ಯೆಹೋವ ದೇವರನ್ನು ಎದುರು ನೋಡುವೆನು.</para>
  <para style="q2" vid="MIC 7:7">ನನ್ನ ರಕ್ಷಣೆಯ ದೇವರಿಗೋಸ್ಕರ ಕಾದುಕೊಳ್ಳುವೆನು.</para>
  <para style="q2" vid="MIC 7:7">ನನ್ನ ದೇವರು ನನ್ನ ಕಡೆಗೆ ಕಿವಿಗೊಡುವರು.<verse eid="MIC 7:7"/></para>
  <para style="s1">ಇಸ್ರಾಯೇಲು ಎದ್ದೇಳುವುದು</para>
  <para style="q1">
    <verse number="8" style="v" sid="MIC 7:8"/>ನನ್ನ ಶತ್ರುವೇ, ನನ್ನ ಮೇಲೆ ಸಂತೋಷ ಪಡಬೇಡ,</para>
  <para style="q2" vid="MIC 7:8">ನಾನು ಬಿದ್ದಿದ್ದರೂ ತಿರುಗಿ ಏಳುವೆನು.</para>
  <para style="q1" vid="MIC 7:8">ನಾನು ಕತ್ತಲೆಯಲ್ಲಿ ಕುಳಿತುಕೊಂಡರೂ</para>
  <para style="q2" vid="MIC 7:8">ಯೆಹೋವ ದೇವರೇ ನನಗೆ ಬೆಳಕಾಗಿರುವರು.<verse eid="MIC 7:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="MIC 7:9"/>ನಾನು ಯೆಹೋವ ದೇವರಿಗೆ ವಿರೋಧವಾಗಿ ಪಾಪಮಾಡಿದ್ದರಿಂದ</para>
  <para style="q2" vid="MIC 7:9">ಅವರು ನನ್ನ ವ್ಯಾಜ್ಯವಾಡಿ</para>
  <para style="q1" vid="MIC 7:9">ನನ್ನ ನ್ಯಾಯವನ್ನು ನಡೆಸುವ ತನಕ</para>
  <para style="q2" vid="MIC 7:9">ಅವರ ಕೋಪವನ್ನು ತಾಳುವೆನು.</para>
  <para style="q1" vid="MIC 7:9">ಆತನು ನನ್ನನ್ನು ಬೆಳಕಿಗೆ ತರುವನು.</para>
  <para style="q2" vid="MIC 7:9">ಆತನ ನೀತಿಯನ್ನು ನೋಡುವೆನು.<verse eid="MIC 7:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="MIC 7:10"/>ಆಗ ನನ್ನ ಶತ್ರು ಇದನ್ನು ನೋಡುವನು.</para>
  <para style="q2" vid="MIC 7:10">ಅವನ ಮುಖವನ್ನು ಅವಮಾನದಿಂದ ಮುಚ್ಚಿಕೊಳ್ಳುವನು,</para>
  <para style="q1" vid="MIC 7:10">“ನಿನ್ನ ಯೆಹೋವ ದೇವರು ಎಲ್ಲಿ?”</para>
  <para style="q2" vid="MIC 7:10">ಎಂದು ನನ್ನನ್ನು ಜರೆದವರೇ ನಾಚಿಕೆಪಡುವರು.</para>
  <para style="q1" vid="MIC 7:10">ಇದನ್ನು ನಾನು ಕಣ್ಣಾರೆ ಕಾಣುವೆನು.</para>
  <para style="q2" vid="MIC 7:10">ಆ ಶತ್ರುಗಳಾದರೋ ಬೀದಿಯ ಕಸದಂತೆ</para>
  <para style="q2" vid="MIC 7:10">ದಾರಿಹೋಕರ ತುಳಿತಕ್ಕೆ ಈಡಾಗುವರು.<verse eid="MIC 7:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="MIC 7:11"/>ನಿನ್ನ ಗೋಡೆಗಳು ಪುನಃ ಕಟ್ಟುವ</para>
  <para style="q2" vid="MIC 7:11">ಆ ದಿವಸ ಬರುವುದು. ಮತ್ತು ನಿಮ್ಮ ಮಿತಿಗಳನ್ನು ಹೆಚ್ಚಿಸುವ ದಿನ ಬರುತ್ತದೆ.<verse eid="MIC 7:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="MIC 7:12"/>ಆ ದಿವಸದಲ್ಲಿ</para>
  <para style="q2" vid="MIC 7:12">ಅಸ್ಸೀರಿಯರಿಂದಲೂ ಈಜಿಪ್ಟ್ ಪಟ್ಟಣಗಳಿಂದಲೂ</para>
  <para style="q1" vid="MIC 7:12">ಯೂಫ್ರೇಟೀಸ್ ನದಿಯವರೆಗೂ</para>
  <para style="q2" vid="MIC 7:12">ಸಮುದ್ರದಿಂದ ಸಮುದ್ರದವರೆಗೂ</para>
  <para style="q2" vid="MIC 7:12">ಬೆಟ್ಟದಿಂದ ಬೆಟ್ಟದವರೆಗೂ ಜನರೆಲ್ಲರು ನಿನ್ನ ಬಳಿಗೆ ಬರುವರು.<verse eid="MIC 7:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="MIC 7:13"/>ಆದರೂ ದೇಶವು ಅದರ ನಿವಾಸಿಗಳ ನಿಮಿತ್ತ</para>
  <para style="q2" vid="MIC 7:13">ಅವರ ದುಷ್ಕ್ರಿಯೆಗಳ ಫಲದಿಂದ ಹಾಳಾಗುವುದು.<verse eid="MIC 7:13"/></para>
  <para style="s1">ಸ್ತೋತ್ರ ಮತ್ತು ಪ್ರಾರ್ಥನೆ</para>
  <para style="q1">
    <verse number="14" style="v" sid="MIC 7:14"/>ನಿನ್ನ ಜನರನ್ನೂ ಏಕಾಂತವಾಗಿ</para>
  <para style="q2" vid="MIC 7:14">ಅಡವಿಯಲ್ಲಿ ಕರ್ಮೆಲಿನ ನಡುವೆ ವಾಸವಾಗಿರುವ</para>
  <para style="q1" vid="MIC 7:14">ನಿನ್ನ ಬಾಧ್ಯತೆಯ ಮಂದೆಯನ್ನೂ</para>
  <para style="q2" vid="MIC 7:14">ನಿನ್ನ ಕೋಲಿನಿಂದ ಮೇಯಿಸು.</para>
  <para style="q1" vid="MIC 7:14">ಅವರು ಪೂರ್ವದ ದಿವಸಗಳಲ್ಲಾದ ಹಾಗೆ</para>
  <para style="q2" vid="MIC 7:14">ಬಾಷಾನಿನಲ್ಲಿಯೂ ಗಿಲ್ಯಾದಿನಲ್ಲಿಯೂ ಮೇಯಲಿ.<verse eid="MIC 7:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="MIC 7:15"/>ನೀನು ಈಜಿಪ್ಟ್ ದೇಶದೊಳಗಿಂದ ಹೊರಡುವ ದಿವಸಗಳ ಹಾಗೆ</para>
  <para style="q2" vid="MIC 7:15">ಅವರಿಗೆ ಆಶ್ಚರ್ಯವಾದವುಗಳನ್ನು ತೋರಿಸುವೆನು.<verse eid="MIC 7:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="MIC 7:16"/>ಜನಾಂಗಗಳು ನೋಡಿ ನಾಚಿಕೊಳ್ಳುವರು</para>
  <para style="q2" vid="MIC 7:16">ತಮ್ಮ ತಮ್ಮ ಶಕ್ತಿಗೆ ವಂಚಿತರಾಗಿ ನಾಚಿಕೆಪಡುವರು.</para>
  <para style="q1" vid="MIC 7:16">ತಮ್ಮ ಕೈಗಳನ್ನು ಬಾಯಿಯ ಮೇಲೆ ಇಡುವರು;</para>
  <para style="q2" vid="MIC 7:16">ಅವರ ಕಿವಿಗಳು ಕಿವುಡಾಗಿ ಹೋಗುವುವು.<verse eid="MIC 7:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="MIC 7:17"/>ಅವರು ಹಾವಿನಂತೆ,</para>
  <para style="q2" vid="MIC 7:17">ನೆಲದ ಮೇಲೆ ತೆವಳುವ ಜೀವಿಗಳಂತೆ ಧೂಳನ್ನು ನೆಕ್ಕುತ್ತಾರೆ.</para>
  <para style="q1" vid="MIC 7:17">ಅವರು ರಂಧ್ರಗಳಿಂದ ಹೊರಗೆ ಬರುವರು.</para>
  <para style="q2" vid="MIC 7:17">ನಮ್ಮ ದೇವರಾದ ಯೆಹೋವ ದೇವರಿಗೆ ಅವರು ಹೆದರುವರು.</para>
  <para style="q2" vid="MIC 7:17">ನಿನಗೆ ಭಯಪಡುವರು.<verse eid="MIC 7:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="MIC 7:18"/>ಪಾಪಗಳನ್ನು ಮತ್ತು ಅಪರಾಧಗಳನ್ನು ಮನ್ನಿಸುವವನೂ,</para>
  <para style="q2" vid="MIC 7:18">ತನ್ನ ಬಾಧ್ಯತೆಯ ಶೇಷದ ದ್ರೋಹವನ್ನು ಲಕ್ಷಿಸದವನೂ,</para>
  <para style="q2" vid="MIC 7:18">ನಿನ್ನ ಹಾಗೆ ಇರುವ ದೇವರು ಯಾರು?</para>
  <para style="q1" vid="MIC 7:18">ಆತನು ತನ್ನ ಕೋಪವನ್ನು ಎಂದೆಂದಿಗೂ ಇಟ್ಟುಕೊಳ್ಳುವುದಿಲ್ಲ.</para>
  <para style="q2" vid="MIC 7:18">ಏಕೆಂದರೆ ನೀವು ಕರುಣೆಯಲ್ಲಿ ಸಂತೋಷಪಡುತ್ತೀರಿ.<verse eid="MIC 7:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="MIC 7:19"/>ಆತನು ತಿರುಗಿಕೊಂಡು ನಮ್ಮನ್ನು ಕನಿಕರಿಸುವನು;</para>
  <para style="q2" vid="MIC 7:19">ನಮ್ಮ ಅಕ್ರಮಗಳನ್ನು ತುಳಿದುಬಿಡುವನು;</para>
  <para style="q2" vid="MIC 7:19">ನಮ್ಮ ಪಾಪಗಳನ್ನೆಲ್ಲಾ ಸಮುದ್ರದ ಅಗಾಧಗಳಲ್ಲಿ ಹಾಕುವನು.<verse eid="MIC 7:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="MIC 7:20"/>ನೀನು ಪುರಾತನ ಕಾಲದಿಂದಲೂ ನಮ್ಮ ಪಿತೃಗಳಿಗೆ ಪ್ರಮಾಣಮಾಡಿರುವಂತೆ</para>
  <para style="q2" vid="MIC 7:20">ಯಾಕೋಬನ ವಂಶದವರಿಗೆ ಸತ್ಯಪರನಾಗಿಯೂ,</para>
  <para style="q2" vid="MIC 7:20">ಅಬ್ರಹಾಮನ ವಂಶದವರಿಗೆ ಪ್ರೀತಿಪರನಾಗಿಯೂ ನಡೆಯುವಿ.<verse eid="MIC 7:20"/></para>
  <chapter eid="MIC 7"/>
</usx>
