<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="SNG" style="id">- Biblica® Open Kannada Contemporary Version</book>
  <para style="h">ಪರಮಗೀತೆ</para>
  <para style="toc1">ಪರಮಗೀತೆ</para>
  <para style="toc2">ಪರಮಗೀತೆ</para>
  <para style="toc3">ಪರಮ</para>
  <para style="mt1">ಪರಮಗೀತೆ</para>
  <chapter number="1" style="c" sid="SNG 1"/>
  <para style="p">
    <verse number="1" style="v" sid="SNG 1:1"/>ಸೊಲೊಮೋನನ ಪರಮಗೀತೆ.<verse eid="SNG 1:1"/></para>
  <para style="b"/>
  <para style="sp">ಪ್ರಿಯತಮೆ</para>
  <para style="q1">
    <verse number="2" style="v" sid="SNG 1:2"/>ಬಾಯಿಯ ಮುದ್ದುಗಳಿಂದ ನನಗೆ ಮುದ್ದಿಡಲಿ,</para>
  <para style="q2" vid="SNG 1:2">ನಿನ್ನ ಪ್ರೀತಿಯು ದ್ರಾಕ್ಷಾರಸಕ್ಕಿಂತ ಉತ್ತಮ.<verse eid="SNG 1:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="SNG 1:3"/>ನೀನು ಹಚ್ಚಿಕೊಂಡಿರುವ ಸುಗಂಧ ತೈಲದ ಪರಿಮಳವು ಮೆಚ್ಚಿಕೆಯಾಗಿದೆ.</para>
  <para style="q2" vid="SNG 1:3">ನಿನ್ನ ಹೆಸರು ಸುರಿದ ಸುಗಂಧ ತೈಲವಾಗಿದೆ.</para>
  <para style="q2" vid="SNG 1:3">ಆದ್ದರಿಂದ ಕನ್ಯೆಯರು ನಿನ್ನನ್ನು ಪ್ರೀತಿ ಮಾಡುತ್ತಾರೆ!<verse eid="SNG 1:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="SNG 1:4"/>ನನ್ನನ್ನು ನಿನ್ನೊಂದಿಗೆ ಕರೆದುಕೊಂಡು ಹೋಗಲು ಅವಸರಪಡು!</para>
  <para style="q2" vid="SNG 1:4">ಅರಸನು ನನ್ನನ್ನು ತನ್ನ ಕೊಠಡಿಯೊಳಗೆ ಕರೆದುಕೊಂಡು ಬರಲಿ.</para>
  <para style="sp" vid="SNG 1:4">ಸ್ನೇಹಿತರು</para>
  <para style="q1" vid="SNG 1:4">ನಾವು ನಿನ್ನಲ್ಲಿ ಉಲ್ಲಾಸಪಟ್ಟು, ಸಂತೋಷ ಪಡುತ್ತೇವೆ.</para>
  <para style="q2" vid="SNG 1:4">ದ್ರಾಕ್ಷಾರಸಕ್ಕಿಂತ ಹೆಚ್ಚಾಗಿ ನಿನ್ನ ಪ್ರೀತಿಯನ್ನು ಹೊಗಳುತ್ತೇವೆ.</para>
  <para style="sp" vid="SNG 1:4">ಪ್ರಿಯತಮೆ</para>
  <para style="q1" vid="SNG 1:4">ಅವರು ಯಥಾರ್ಥವಾಗಿ ನಿನ್ನನ್ನು ಮೆಚ್ಚುತ್ತಾರೆ!<verse eid="SNG 1:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="SNG 1:5"/>ಯೆರೂಸಲೇಮಿನ ಪುತ್ರಿಯರೇ,</para>
  <para style="q2" vid="SNG 1:5">ನಾನು ಕಪ್ಪಾದವಳು ಆದರೂ ಸುಂದರಿ.</para>
  <para style="q1" vid="SNG 1:5">ಕೇದಾರಿನ ಗುಡಾರಗಳಂತೆಯೂ, ಸೊಲೊಮೋನನ ಡೇರೆಯ ತೆರೆಗಳಂತೆಯೂ ಚೆಲುವೆ.<verse eid="SNG 1:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="SNG 1:6"/>ನನ್ನನ್ನು ದಿಟ್ಟಿಸಿ ನೋಡಬೇಡಿರಿ.</para>
  <para style="q2" vid="SNG 1:6">ನಾನು ಸೂರ್ಯನ ದೃಷ್ಟಿಗೆ ಬಿದ್ದು ಕಪ್ಪಾಗಿದ್ದೇನೆ.</para>
  <para style="q1" vid="SNG 1:6">ನನ್ನ ಸಹೋದರರು ನನ್ನ ಮೇಲೆ ಕೋಪಮಾಡಿಕೊಂಡು,</para>
  <para style="q2" vid="SNG 1:6">ದ್ರಾಕ್ಷಿತೋಟಗಳನ್ನು ಕಾಯಲು ನನ್ನನ್ನು ನೇಮಿಸಿದರು.</para>
  <para style="q2" vid="SNG 1:6">ಆದರೆ ನನ್ನ ಸ್ವಂತ ದ್ರಾಕ್ಷಿತೋಟವನ್ನು ನಾನು ಅಲಕ್ಷ್ಯ ಮಾಡಬೇಕಾಯಿತು.<verse eid="SNG 1:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="SNG 1:7"/>ನನ್ನ ಪ್ರಾಣ ಪ್ರಿಯನೇ,</para>
  <para style="q2" vid="SNG 1:7">ನೀನು ನಿನ್ನ ಮಂದೆಯನ್ನು ಮೇಯಿಸುವುದು ಎಲ್ಲಿ?</para>
  <para style="q2" vid="SNG 1:7">ಮಧ್ಯಾಹ್ನದಲ್ಲಿ ನೀನು ವಿಶ್ರಮಿಸಿಕೊಳ್ಳುವ ಸ್ಥಳ ಎಲ್ಲಿ? ನನಗೆ ತಿಳಿಸು.</para>
  <para style="q1" vid="SNG 1:7">ನಾನು ನಿನ್ನ ಜೊತೆಗಾರರ ಮಂದೆಗಳ ಬಳಿಯಲ್ಲಿ</para>
  <para style="q2" vid="SNG 1:7">ಮುಸುಕು ಹಾಕಿದವಳಂತೆ ಏಕೆ ಅಲೆಯಬೇಕು?<verse eid="SNG 1:7"/></para>
  <para style="sp">ಸ್ನೇಹಿತರು</para>
  <para style="q1">
    <verse number="8" style="v" sid="SNG 1:8"/>ಸ್ತ್ರೀಯರಲ್ಲಿ ಸೌಂದರ್ಯವಂತಳೇ, ನಿನಗೆ ಗೊತ್ತಿಲ್ಲವಾದರೆ,</para>
  <para style="q2" vid="SNG 1:8">ನೀನು ಮಂದೆಯ ಜಾಡಿನಲ್ಲಿಯೇ ಹೋಗಿ,</para>
  <para style="q1" vid="SNG 1:8">ಕುರುಬರ ಗುಡಾರಗಳ ಬಳಿಯಲ್ಲಿ</para>
  <para style="q2" vid="SNG 1:8">ನಿನ್ನ ಮೇಕೆಯ ಮರಿಗಳನ್ನು ಮೇಯಿಸು.<verse eid="SNG 1:8"/></para>
  <para style="sp">ಪ್ರಿಯಕರ</para>
  <para style="q1">
    <verse number="9" style="v" sid="SNG 1:9"/>ನನ್ನ ಪ್ರಿಯಳೇ, ಫರೋಹನ ರಥಕ್ಕೆ ಕಟ್ಟಿದ ಕುದುರೆಗೆ</para>
  <para style="q2" vid="SNG 1:9">ನಿನ್ನನ್ನು ಹೋಲಿಸಿದ್ದೇನೆ.<verse eid="SNG 1:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="SNG 1:10"/>ನಿನ್ನ ಕೆನ್ನೆಗಳು ಆಭರಣಗಳ ಸಾಲಿನಿಂದಲೂ,</para>
  <para style="q2" vid="SNG 1:10">ನಿನ್ನ ಕೊರಳು ಕಂಠ ಮಾಲೆಗಳಿಂದಲೂ ರಮ್ಯವಾಗಿವೆ.<verse eid="SNG 1:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="SNG 1:11"/>ನಾವು ನಿನಗೋಸ್ಕರ ಬಂಗಾರದ ಕಿವಿಯೋಲೆಗಳನ್ನು</para>
  <para style="q2" vid="SNG 1:11">ಬೆಳ್ಳಿಯ ಸರಪಳಿಗಳೊಂದಿಗೆ ಮಾಡಿಸುವೆವು.<verse eid="SNG 1:11"/></para>
  <para style="sp">ಪ್ರಿಯತಮೆ</para>
  <para style="q1">
    <verse number="12" style="v" sid="SNG 1:12"/>ಅರಸನು ಮೇಜಿನ ಬಳಿಯಲ್ಲಿ ಕೂತಿದ್ದಾಗ,</para>
  <para style="q2" vid="SNG 1:12">ನನ್ನ ಪರಿಮಳ ತೈಲವು ಸುವಾಸನೆಯನ್ನು ಬೀರುತ್ತಿತ್ತು.<verse eid="SNG 1:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="SNG 1:13"/>ನನ್ನ ಪ್ರಿಯತಮನು ನನ್ನ ಸ್ತನಗಳ ಮಧ್ಯದಲ್ಲಿ</para>
  <para style="q2" vid="SNG 1:13">ವಿಶ್ರಾಂತಿ ಪಡೆಯುವ ರಕ್ತಬೋಳದ ಚೀಲದಂತಿರುವನು.<verse eid="SNG 1:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="SNG 1:14"/>ನನ್ನ ಪ್ರಿಯನು ನನಗೆ ಏನ್ಗೆದಿಯ ದ್ರಾಕ್ಷಿ ತೋಟಗಳಲ್ಲಿರುವ</para>
  <para style="q2" vid="SNG 1:14">ಗೋರಂಟಿ ಹೂಗೊಂಚಲಿನಂತೆ ಇರುವನು.<verse eid="SNG 1:14"/></para>
  <para style="sp">ಪ್ರಿಯಕರ</para>
  <para style="q1">
    <verse number="15" style="v" sid="SNG 1:15"/>ನನ್ನ ಪ್ರಿಯಳೇ, ನೀನು ಎಷ್ಟು ಸೌಂದರ್ಯವಂತೆ!</para>
  <para style="q2" vid="SNG 1:15">ಆಹಾ, ನೀನು ಸೌಂದರ್ಯವಂತಳೇ!</para>
  <para style="q2" vid="SNG 1:15">ನಿನ್ನ ಕಣ್ಣುಗಳು ಪಾರಿವಾಳಗಳಂತಿವೆ.<verse eid="SNG 1:15"/></para>
  <para style="sp">ಪ್ರಿಯತಮೆ</para>
  <para style="q1">
    <verse number="16" style="v" sid="SNG 1:16"/>ನನ್ನ ಪ್ರಿಯನೇ, ಇಗೋ, ನೀನು ಎಷ್ಟು ಸೌಂದರ್ಯವಂತನು!</para>
  <para style="q2" vid="SNG 1:16">ಹೌದು, ರಮ್ಯವಾದವನು!</para>
  <para style="q2" vid="SNG 1:16">ಹಸಿರು ಚಿಗುರುಗಳೇ ನಮ್ಮ ಮಂಚವಾಗಿದೆ.<verse eid="SNG 1:16"/></para>
  <para style="sp">ಪ್ರಿಯಕರ</para>
  <para style="q1">
    <verse number="17" style="v" sid="SNG 1:17"/>ನಮ್ಮ ಮನೆಯ ತೊಲೆಗಳು ದೇವದಾರು ಮರಗಳು.</para>
  <para style="q2" vid="SNG 1:17">ನಮ್ಮ ಮೇಲ್ಛಾವಣಿ ತುರಾಯಿ ಮರಗಳು.<verse eid="SNG 1:17"/></para>
  <chapter eid="SNG 1"/>
  <chapter number="2" style="c" sid="SNG 2"/>
  <para style="sp">ಪ್ರಿಯತಮೆ</para>
  <para style="q1">
    <verse number="1" style="v" sid="SNG 2:1"/>ಶಾರೋನಿನ ಗುಲಾಬಿ ಹೂವೂ,</para>
  <para style="q2" vid="SNG 2:1">ತಗ್ಗಿನ ತಾವರೆಯೂ ನಾನೇ.<verse eid="SNG 2:1"/></para>
  <para style="sp">ಪ್ರಿಯಕರ</para>
  <para style="q1">
    <verse number="2" style="v" sid="SNG 2:2"/>ಮುಳ್ಳುಪೊದರಿನ ನಡುವೆ ತಾವರೆಯಂತೆ</para>
  <para style="q2" vid="SNG 2:2">ನನ್ನ ಪ್ರಿಯಳು ಕನ್ಯಾಮಣಿಗಳಲ್ಲಿ ಶ್ರೇಷ್ಠಳು.<verse eid="SNG 2:2"/></para>
  <para style="sp">ಪ್ರಿಯತಮೆ</para>
  <para style="q1">
    <verse number="3" style="v" sid="SNG 2:3"/>ಅಡವಿಯ ಮರಗಳಲ್ಲಿ ಸೇಬಿನ ಮರದಂತೆ</para>
  <para style="q2" vid="SNG 2:3">ಯುವಜನರಲ್ಲಿ ನನ್ನ ಪ್ರಿಯನಿದ್ದಾನೆ.</para>
  <para style="q1" vid="SNG 2:3">ನಾನು ಅವನ ನೆರಳಿನಲ್ಲಿ ಬಹು ಆನಂದವಾಗಿ ಕುಳಿತುಕೊಂಡೆನು.</para>
  <para style="q2" vid="SNG 2:3">ಅವನ ಫಲವು ನನ್ನ ರುಚಿಗೆ ಮಧುರವಾಗಿತ್ತು.<verse eid="SNG 2:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="SNG 2:4"/>ಅವನು ಔತಣದ ಮನೆಗೆ ನನ್ನನ್ನು ಕರೆದುಕೊಂಡು ಬಂದನು.</para>
  <para style="q2" vid="SNG 2:4">ನನ್ನ ಮೇಲೆ ಇರುವ ಅವನ ಧ್ವಜವು ಪ್ರೀತಿಯೇ.<verse eid="SNG 2:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="SNG 2:5"/>ದ್ರಾಕ್ಷೆಯಿಂದ ನನ್ನನ್ನು ಬಲಪಡಿಸು.</para>
  <para style="q2" vid="SNG 2:5">ಸೇಬು ಹಣ್ಣುಗಳಿಂದ ನನ್ನನ್ನು ಚೇತನಗೊಳಿಸು.</para>
  <para style="q2" vid="SNG 2:5">ಏಕೆಂದರೆ ನಾನು ಪ್ರೀತಿಯ ದೆಸೆಯಿಂದ ಅಸ್ವಸ್ಥಳಾಗಿದ್ದೇನೆ.<verse eid="SNG 2:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="SNG 2:6"/>ಅವನ ಎಡಗೈ ನನ್ನ ತಲೆದಿಂಬಾಗಿರಲಿ.</para>
  <para style="q2" vid="SNG 2:6">ಅವನ ಬಲಗೈ ನನ್ನನ್ನು ಅಪ್ಪಿಕೊಳ್ಳಲಿ.<verse eid="SNG 2:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="SNG 2:7"/>ಯೆರೂಸಲೇಮಿನ ಪುತ್ರಿಯರೇ,</para>
  <para style="q2" vid="SNG 2:7">ಮೆಚ್ಚುವ ಕಾಲಕ್ಕೆ ಮುಂಚೆ ನೀವು ಪ್ರೀತಿಯನ್ನು ಎಬ್ಬಿಸಬೇಡಿರಿ.</para>
  <para style="q1" vid="SNG 2:7">ಎಚ್ಚರಿಸಲೂ ಬೇಡಿರಿ ಎಂದು</para>
  <para style="q2" vid="SNG 2:7">ಅಡವಿಯ ಹುಲ್ಲೆ ಹರಿಣಿಗಳ ಮೇಲೆ ನಿಮ್ಮಿಂದ ಪ್ರಮಾಣಮಾಡಿಸುತ್ತೇನೆ.<verse eid="SNG 2:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="SNG 2:8"/>ನನ್ನ ಪ್ರಿಯನ ಸ್ವರವು! ಇಗೋ!</para>
  <para style="q2" vid="SNG 2:8">ಅವನು ಪರ್ವತಗಳ ಮೇಲೆ ಹಾರುತ್ತಾ,</para>
  <para style="q1" vid="SNG 2:8">ಗುಡ್ಡಗಳ ಮೇಲೆ ಜಿಗಿಯುತ್ತಾ ಬರುತ್ತಿದ್ದಾನೆ.<verse eid="SNG 2:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="SNG 2:9"/>ನನ್ನ ಪ್ರಿಯನು ಜಿಂಕೆಯ ಹಾಗೆ ಇದ್ದಾನೆ.</para>
  <para style="q2" vid="SNG 2:9">ದುಪ್ಪಿಯ ಮರಿಯ ಹಾಗೆಯೂ ಇದ್ದಾನೆ.</para>
  <para style="q1" vid="SNG 2:9">ಇಗೋ! ಅವನು ನಮ್ಮ ಗೋಡೆಯ ಹಿಂದೆ ನಿಂತಿದ್ದಾನೆ.</para>
  <para style="q2" vid="SNG 2:9">ಜಾಲಾಂತರಗಳಲ್ಲಿ ತನ್ನನ್ನು ತೋರಿಸಿ, ಕಿಟಿಕಿಗಳಿಂದ ನೋಡುತ್ತಿದ್ದಾನೆ.<verse eid="SNG 2:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="SNG 2:10"/>ನನ್ನ ಪ್ರಿಯನು ನನ್ನೊಡನೆ ಮಾತನಾಡಿ ಹೀಗೆಂದನು:</para>
  <para style="q2" vid="SNG 2:10">“ನನ್ನ ಪ್ರಿಯಳೇ ಎದ್ದು ಬಾ,</para>
  <para style="q2" vid="SNG 2:10">ನನ್ನ ಸುಂದರಿಯೇ, ಹೊರಟು ಬಾ.<verse eid="SNG 2:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="SNG 2:11"/>ಇಗೋ! ಚಳಿಗಾಲ ಕಳೆಯಿತು,</para>
  <para style="q2" vid="SNG 2:11">ಮಳೆ ನಿಂತುಹೋಯಿತು.<verse eid="SNG 2:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="SNG 2:12"/>ಪುಷ್ಪಗಳು ಭೂಮಿಯ ಮೇಲೆ ಕಾಣಿಸುತ್ತಿವೆ.</para>
  <para style="q2" vid="SNG 2:12">ಪಕ್ಷಿಗಳು ಹಾಡುವ ಕಾಲ ಬಂತು.</para>
  <para style="q1" vid="SNG 2:12">ಪಾರಿವಾಳಗಳ ಸ್ವರ</para>
  <para style="q2" vid="SNG 2:12">ನಮ್ಮ ಊರಲ್ಲಿ ಕೇಳಿಸುತ್ತಿದೆ.<verse eid="SNG 2:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="SNG 2:13"/>ಅಂಜೂರದ ಕಾಯಿಗಳು ಹಣ್ಣಾಗಿವೆ.</para>
  <para style="q2" vid="SNG 2:13">ದ್ರಾಕ್ಷಿಬಳ್ಳಿಗಳು ಹೂಬಿಟ್ಟಿವೆ. ಅದರ ಪರಿಮಳ ಹರಡುತ್ತಿದೆ.</para>
  <para style="q1" vid="SNG 2:13">ಎದ್ದು ಬಾ, ನನ್ನ ಪ್ರಿಯಳೇ,</para>
  <para style="q2" vid="SNG 2:13">ನನ್ನ ಸುಂದರಿಯೇ, ನನ್ನೊಂದಿಗೆ ಬಾ.”<verse eid="SNG 2:13"/></para>
  <para style="sp">ಪ್ರಿಯಕರ</para>
  <para style="q1">
    <verse number="14" style="v" sid="SNG 2:14"/>ಬಂಡೆಯ ಬಿರುಕುಗಳಲ್ಲಿಯೂ</para>
  <para style="q2" vid="SNG 2:14">ಸಂದುಗಳ ಮರೆಯಲ್ಲಿಯೂ ಇರುವ ನನ್ನ ಪಾರಿವಾಳವೇ ಬಾ.</para>
  <para style="q1" vid="SNG 2:14">ನಿನ್ನ ಮುಖವನ್ನು ನನಗೆ ತೋರಿಸು.</para>
  <para style="q2" vid="SNG 2:14">ನಿನ್ನ ಸ್ವರವನ್ನು ನನಗೆ ಕೇಳಿಸು.</para>
  <para style="q1" vid="SNG 2:14">ನಿನ್ನ ಸ್ವರವು ಇಂಪಾಗಿದೆ.</para>
  <para style="q2" vid="SNG 2:14">ನಿನ್ನ ಮುಖವು ಸುಂದರವಾಗಿಯೂ ಇದೆ.<verse eid="SNG 2:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="SNG 2:15"/>ದ್ರಾಕ್ಷಿತೋಟಗಳನ್ನು ಹಾಳುಮಾಡುವ ನರಿಗಳನ್ನೂ</para>
  <para style="q2" vid="SNG 2:15">ನರಿಮರಿಗಳನ್ನೂ ಹಿಡಿಯಿರಿ.</para>
  <para style="q2" vid="SNG 2:15">ನಮ್ಮ ದ್ರಾಕ್ಷಿತೋಟಗಳಲ್ಲಿ ಹೂಗಳು ಅರಳಿವೆ.<verse eid="SNG 2:15"/></para>
  <para style="sp">ಪ್ರಿಯತಮೆ</para>
  <para style="q1">
    <verse number="16" style="v" sid="SNG 2:16"/>ನನ್ನ ಪ್ರಿಯನು ನನ್ನವನೇ, ನಾನು ಅವನವಳೇ.</para>
  <para style="q2" vid="SNG 2:16">ಅವನು ನೆಲದಾವರೆಗಳ ನಡುವೆ ಮಂದೆಯನ್ನು ಮೇಯಿಸುತ್ತಾನೆ.<verse eid="SNG 2:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="SNG 2:17"/>ನನ್ನ ಪ್ರಿಯನೇ,</para>
  <para style="q2" vid="SNG 2:17">ಹೊತ್ತು ಮೂಡುವ ಮುಂಚೆ</para>
  <para style="q1" vid="SNG 2:17">ಕತ್ತಲು ಕವಿಯುವ ಮೊದಲು ಹೊರಟು ಬಾ.</para>
  <para style="q2" vid="SNG 2:17">ಒರಟಾದ ಪರ್ವತಗಳ<note caller="+" style="f"><char style="fr" closed="false">2:17 </char><char style="ft" closed="false">ಅಥವಾ </char><char style="fqa" closed="false">ಬೆತೇರ್ ಪರ್ವತ</char></note></para>
  <para style="q1" vid="SNG 2:17">ಮೇಲಿರುವ ಜಿಂಕೆಯಂತಿರು.</para>
  <para style="q2" vid="SNG 2:17">ಹೌದು, ಪ್ರಾಯದ ದುಪ್ಪಿಯಂತೆಯೂ ಇರು.<verse eid="SNG 2:17"/></para>
  <para style="b"/>
  <chapter eid="SNG 2"/>
  <chapter number="3" style="c" sid="SNG 3"/>
  <para style="q1">
    <verse number="1" style="v" sid="SNG 3:1"/>ರಾತ್ರಿಯೆಲ್ಲಾ ನನ್ನ ಹಾಸಿಗೆಯ ಮೇಲಿದ್ದೆನು;</para>
  <para style="q2" vid="SNG 3:1">ನನ್ನ ಪ್ರಾಣ ಪ್ರಿಯನನ್ನು ಹುಡಕಿದೆನು. ಅವನನ್ನು ಎಷ್ಟು ಹುಡುಕಿದರೂ</para>
  <para style="q2" vid="SNG 3:1">ಅವನು ಸಿಗಲಿಲ್ಲ.<verse eid="SNG 3:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="SNG 3:2"/>ನಾನು ಎದ್ದು, ಪಟ್ಟಣವನ್ನು ಸಂಚರಿಸಿ,</para>
  <para style="q2" vid="SNG 3:2">ಬೀದಿಗಳಲ್ಲಿಯೂ, ಮಾರ್ಗಗಳಲ್ಲಿಯೂ</para>
  <para style="q1" vid="SNG 3:2">ನನ್ನ ಪ್ರಾಣ ಪ್ರಿಯನನ್ನು ಹುಡುಕಾಡಿದೆನು.</para>
  <para style="q2" vid="SNG 3:2">ಅವನನ್ನು ಎಷ್ಟು ಹುಡುಕಿದರೂ ಅವನು ಸಿಗಲೇ ಇಲ್ಲ.<verse eid="SNG 3:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="SNG 3:3"/>ನಾನು ಪಟ್ಟಣವನ್ನು ಕಾಯುವ</para>
  <para style="q2" vid="SNG 3:3">ಕಾವಲುಗಾರರಿಗೆ ಸಿಕ್ಕಿಬಿದ್ದಾಗ,</para>
  <para style="q2" vid="SNG 3:3">“ನನ್ನ ಪ್ರಾಣ ಪ್ರಿಯನನ್ನು ನೀವು ಕಂಡಿರಾ?” ಎಂದು ವಿಚಾರಿಸಿದೆ.<verse eid="SNG 3:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="SNG 3:4"/>ನಾನು ಅವರನ್ನು ಬಿಟ್ಟು ಸ್ವಲ್ಪ ದೂರ ಹೋದ ಮೇಲೆ,</para>
  <para style="q2" vid="SNG 3:4">ನನ್ನ ಪ್ರಾಣ ಪ್ರಿಯನನ್ನು ಕಂಡುಕೊಂಡೆನು.</para>
  <para style="q1" vid="SNG 3:4">ನಾನು ಅವನ ಕೈಯನ್ನು ಹಿಡಿದುಕೊಂಡು ನನ್ನ ತಾಯಿಯ ಮನೆಗೆ,</para>
  <para style="q2" vid="SNG 3:4">ಹೌದು, ನನ್ನ ಹೆತ್ತವಳ ಕೋಣೆಗೆ</para>
  <para style="q2" vid="SNG 3:4">ಅವನನ್ನು ಬಿಡದೆ ಕರೆದುಕೊಂಡು ಹೋದೆನು.<verse eid="SNG 3:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="SNG 3:5"/>ಯೆರೂಸಲೇಮಿನ ಪುತ್ರಿಯರೇ,</para>
  <para style="q2" vid="SNG 3:5">ಮೆಚ್ಚುವ ಕಾಲಕ್ಕೆ ಮುಂಚೆ ನೀವು ಪ್ರೀತಿಯನ್ನು ಎಬ್ಬಿಸಬೇಡಿರಿ.</para>
  <para style="q1" vid="SNG 3:5">ಎಚ್ಚರಿಸಲೂ ಬೇಡಿರಿ ಎಂದು</para>
  <para style="q2" vid="SNG 3:5">ಅಡವಿಯ ಹುಲ್ಲೆ ಹರಿಣಿಗಳ ಮೇಲೆ ನಿಮ್ಮಿಂದ ಪ್ರಮಾಣಮಾಡಿಸುತ್ತೇನೆ.<verse eid="SNG 3:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="SNG 3:6"/>ರಕ್ತಬೋಳ, ಸಾಂಬ್ರಾಣಿಗಳಿಂದಲೂ</para>
  <para style="q2" vid="SNG 3:6">ವರ್ತಕರು ಮಾರುವ ಸಕಲ ಸುಗಂಧ ದ್ರವ್ಯಗಳಿಂದಲೂ</para>
  <para style="q2" vid="SNG 3:6">ಧೂಮಸ್ತಂಭಗಳಂತೆ ಅಡವಿಯಿಂದ ಬರುವ ಈ ಮೆರವಣೆಗೆ ಯಾರದು?<verse eid="SNG 3:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="SNG 3:7"/>ನೋಡಿರಿ! ಇದು ಸೊಲೊಮೋನನ ರಥ.</para>
  <para style="q2" vid="SNG 3:7">ಇಸ್ರಾಯೇಲಿನ ಪರಾಕ್ರಮಶಾಲಿಗಳಲ್ಲಿ ಅರವತ್ತು</para>
  <para style="q2" vid="SNG 3:7">ಮಂದಿ ಅದರ ಸುತ್ತಲಿದ್ದಾರೆ.<verse eid="SNG 3:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="SNG 3:8"/>ಯುದ್ಧ ನಿಪುಣರಾದ ಅವರೆಲ್ಲರೂ</para>
  <para style="q2" vid="SNG 3:8">ಖಡ್ಗ ಹಿಡಿದಿದ್ದಾರೆ.</para>
  <para style="q1" vid="SNG 3:8">ರಾತ್ರಿಯ ಅಪಾಯದ ನಿಮಿತ್ತ ಪ್ರತಿಯೊಬ್ಬರೂ</para>
  <para style="q2" vid="SNG 3:8">ಖಡ್ಗವನ್ನು ಸೊಂಟಕ್ಕೆ ಕಟ್ಟಿಕೊಂಡಿದ್ದಾರೆ.<verse eid="SNG 3:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="SNG 3:9"/>ಅರಸನಾದ ಸೊಲೊಮೋನನು ಲೆಬನೋನಿನ ಮರದಿಂದ</para>
  <para style="q2" vid="SNG 3:9">ಒಂದು ರಥವನ್ನು ತನಗೆ ಮಾಡಿಸಿಕೊಂಡಿದ್ದನು.<verse eid="SNG 3:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="SNG 3:10"/>ಅವನು ಅದರ ಸ್ತಂಭಗಳನ್ನು ಬೆಳ್ಳಿಯಿಂದಲೂ</para>
  <para style="q2" vid="SNG 3:10">ಅದರ ಕೆಳಗಿನ ಭಾಗವನ್ನು ಬಂಗಾರದಿಂದಲೂ</para>
  <para style="q1" vid="SNG 3:10">ಅದರ ಹೊದಿಕೆಯನ್ನು</para>
  <para style="q2" vid="SNG 3:10">ಧೂಮ್ರವರ್ಣದ ವಸ್ತ್ರದಿಂದಲೂ ಮಾಡಿಸಿದ್ದನು.</para>
  <para style="q1" vid="SNG 3:10">ಯೆರೂಸಲೇಮಿನ ಪುತ್ರಿಯರು ಪ್ರೀತಿಯಿಂದ ಅದನ್ನು ಅಲಂಕರಿಸಿದ್ದರು.<verse eid="SNG 3:10"/></para>
  <para style="q2">
    <verse number="11" style="v" sid="SNG 3:11"/>ಚೀಯೋನಿನ ಪುತ್ರಿಯರೇ, ನೀವು ಹೊರಗೆ ಬನ್ನಿರಿ.</para>
  <para style="q2" vid="SNG 3:11">ಅರಸನಾದ ಸೊಲೊಮೋನನನ್ನು ನೋಡಿರಿ.</para>
  <para style="q2" vid="SNG 3:11">ಅವನ ಮದುವೆಯ ದಿನದಂದು,</para>
  <para style="q1" vid="SNG 3:11">ಅವನ ಹೃದಯ ಸಂತೋಷಗೊಂಡ ದಿನದಲ್ಲಿ,</para>
  <para style="q2" vid="SNG 3:11">ಅವನ ತಾಯಿ ಅವನಿಗೆ ತೊಡಿಸಿದ ಕಿರೀಟವನ್ನು ಅವನು ಧರಿಸಿರುವುದನ್ನು ಬಂದು ನೋಡಿರಿ.<verse eid="SNG 3:11"/></para>
  <chapter eid="SNG 3"/>
  <chapter number="4" style="c" sid="SNG 4"/>
  <para style="sp">ಪ್ರಿಯಕರ</para>
  <para style="q1">
    <verse number="1" style="v" sid="SNG 4:1"/>ಇಗೋ, ನನ್ನ ಪ್ರಿಯಳೇ,</para>
  <para style="q2" vid="SNG 4:1">ನೀನು ಎಷ್ಟು ಸುಂದರಿ!</para>
  <para style="q2" vid="SNG 4:1">ಆಹಾ, ನೀನು ಎಷ್ಟು ಸುಂದರಿಯು.</para>
  <para style="q1" vid="SNG 4:1">ನಿನ್ನ ಮುಸುಕಿನೊಳಗಿನ ನಿನ್ನ ಕಣ್ಣುಗಳು ಪಾರಿವಾಳಗಳೇ.</para>
  <para style="q2" vid="SNG 4:1">ನಿನ್ನ ತಲೆಕೂದಲು ಗಿಲ್ಯಾದಿನ ಪರ್ವತದಿಂದ ಇಳಿದು ಬರುವ ಮೇಕೆ ಮಂದೆಯ ಹಾಗೆ ಇದೆ.<verse eid="SNG 4:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="SNG 4:2"/>ನಿನ್ನ ಹಲ್ಲುಗಳ ಹೊಳಪು</para>
  <para style="q2" vid="SNG 4:2">ಉಣ್ಣೆ ಕತ್ತರಿಸಿ ಸ್ನಾನಮಾಡಿಸಿದ ಕುರಿಮಂದೆಗೆ ಸಮಾನ.</para>
  <para style="q1" vid="SNG 4:2">ಅವು ಜೊತೆಯಾಗಿಯೇ ಇರುತ್ತವೆ.</para>
  <para style="q2" vid="SNG 4:2">ಅವುಗಳಲ್ಲಿ ಒಂದೂ ಒಂಟಿಯಾಗಿರದು.<verse eid="SNG 4:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="SNG 4:3"/>ನಿನ್ನ ತುಟಿ ಕೆಂಪು ದಾರದ ಹಾಗೆ ಇವೆ.</para>
  <para style="q2" vid="SNG 4:3">ನಿನ್ನ ಮಾತು ರಮ್ಯ.</para>
  <para style="q1" vid="SNG 4:3">ಮುಸುಕಿನೊಳಗಿನ ನಿನ್ನ ಕೆನ್ನೆ</para>
  <para style="q2" vid="SNG 4:3">ವಿಭಾಗಿಸಿದ ದಾಳಿಂಬೆಯ ಹಣ್ಣಿನ ಹಾಗೆ ಇದೆ.<verse eid="SNG 4:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="SNG 4:4"/>ನಿನ್ನ ಕೊರಳು ದಾವೀದನ ಆಯುಧ ಶಾಲೆಗೋಸ್ಕರ</para>
  <para style="q2" vid="SNG 4:4">ಕಟ್ಟಿಸಲಾದ ಬುರುಜಿನ ಹಾಗೆ ಇದೆ.</para>
  <para style="q1" vid="SNG 4:4">ಅದರಲ್ಲಿ ಶೂರರ ಸಾವಿರ ಗುರಾಣಿಗಳು</para>
  <para style="q2" vid="SNG 4:4">ತೂಗುಹಾಕಿ ಇವೆ.<verse eid="SNG 4:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="SNG 4:5"/>ನಿನ್ನ ಎರಡು ಸ್ತನಗಳು</para>
  <para style="q2" vid="SNG 4:5">ನೆಲದಾವರೆಯ ನಡುವೆ ಮೇಯುವ</para>
  <para style="q2" vid="SNG 4:5">ಹುಲ್ಲೆಯ ಅವಳಿಮರಿಗಳ ಹಾಗಿವೆ.<verse eid="SNG 4:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="SNG 4:6"/>ಹೊತ್ತು ಮೂಡುವವರೆಗೂ</para>
  <para style="q2" vid="SNG 4:6">ನೆರಳು ಓಡಿ ಹೋಗುವವರೆಗೂ</para>
  <para style="q1" vid="SNG 4:6">ನಾನು ರಕ್ತಬೋಳದ ಪರ್ವತಕ್ಕೂ</para>
  <para style="q2" vid="SNG 4:6">ಸಾಂಬ್ರಾಣಿಯ ಗುಡ್ಡಕ್ಕೂ ಹೋಗುವೆನು.<verse eid="SNG 4:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="SNG 4:7"/>ನನ್ನ ಪ್ರಿಯಳೇ, ನೀನು ಪೂರ್ಣ ಸುಂದರಿ,</para>
  <para style="q2" vid="SNG 4:7">ನಿನ್ನಲ್ಲಿ ದೋಷವೇನೂ ಇಲ್ಲ.<verse eid="SNG 4:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="SNG 4:8"/>ಬಾ, ವಧುವೇ, ಲೆಬನೋನಿನಿಂದ ಬಾ,</para>
  <para style="q2" vid="SNG 4:8">ಲೆಬನೋನಿನಿಂದ ನನ್ನೊಡನೆ ಬಾ.</para>
  <para style="q1" vid="SNG 4:8">ಅಮಾನದ ಶಿಖರಗಳಿಂದ,</para>
  <para style="q2" vid="SNG 4:8">ಸೆನೀರ್, ಹೆರ್ಮೋನ್ ಶಿಖರಗಳಿಂದ,</para>
  <para style="q1" vid="SNG 4:8">ಸಿಂಹದ ಗವಿಗಳಿಂದ,</para>
  <para style="q2" vid="SNG 4:8">ಚಿರತೆಗಳ ಪರ್ವತಗಳಿಂದ ಇಳಿದು ಬಾ.<verse eid="SNG 4:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="SNG 4:9"/>ನನ್ನ ಹೃದಯವನ್ನು ನೀನು ಸೆಳಕೊಂಡಿರುವೆ. ನನ್ನ ಪ್ರಿಯಳೇ, ನನ್ನ ವಧುವೇ,</para>
  <para style="q2" vid="SNG 4:9">ನೀನು ನಿನ್ನ ಒಂದೇ ಕಿರುನೋಟದಿಂದಲೂ,</para>
  <para style="q1" vid="SNG 4:9">ನಿನ್ನ ಕೊರಳಿನ ಒಂದೇ ಕಂಠ ಹಾರದಿಂದಲೂ,</para>
  <para style="q2" vid="SNG 4:9">ನನ್ನ ಹೃದಯವನ್ನು ಸೆಳಕೊಂಡಿರುವೆ.<verse eid="SNG 4:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="SNG 4:10"/>ನನ್ನ ಪ್ರಿಯಳೇ, ವಧುವೇ! ನಿನ್ನ ಪ್ರೀತಿಯು ಎಷ್ಟೋ ಚೆಂದ.</para>
  <para style="q2" vid="SNG 4:10">ನಿನ್ನ ಪ್ರೀತಿಯು ದ್ರಾಕ್ಷಾರಸಕ್ಕಿಂತ ಎಷ್ಟೋ ಉತ್ತಮ!</para>
  <para style="q1" vid="SNG 4:10">ಎಲ್ಲಾ ಸುಗಂಧಗಳಿಗಿಂತ</para>
  <para style="q2" vid="SNG 4:10">ನಿನ್ನ ತೈಲದ ಸುವಾಸನೆಯು ಎಷ್ಟೋ ಉತ್ತಮ!<verse eid="SNG 4:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="SNG 4:11"/>ನನ್ನ ವಧುವೇ, ನಿನ್ನ ತುಟಿಗಳಿಂದ ಜೇನು ಸುರಿಯುತ್ತಿದೆ.</para>
  <para style="q2" vid="SNG 4:11">ಹಾಲೂ, ಜೇನೂ ನಿನ್ನ ನಾಲಿಗೆ ಅಡಿಯಲ್ಲಿವೆ.</para>
  <para style="q1" vid="SNG 4:11">ನಿನ್ನ ವಸ್ತ್ರಗಳ ಸುವಾಸನೆಯು</para>
  <para style="q2" vid="SNG 4:11">ಲೆಬನೋನಿನ ಸುಗಂಧದಂತಿದೆ.<verse eid="SNG 4:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="SNG 4:12"/>ನನ್ನ ಪ್ರಿಯಳೇ, ನನ್ನ ವಧುವೇ, ನೀನು ಭದ್ರ ತೋಟವೂ ಬೇಲಿಯೊಳಗಿನ ಬುಗ್ಗೆಯೂ</para>
  <para style="q2" vid="SNG 4:12">ಮುದ್ರಿಸಿದ ಬಾವಿಯೂ ಆಗಿರುವೆ.<verse eid="SNG 4:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="SNG 4:13"/>ನಿನ್ನ ತೋಟದಲ್ಲಿ ದಾಳಿಂಬೆ ವನವೂ</para>
  <para style="q2" vid="SNG 4:13">ಫಲಕೊಡುವ ಉತ್ತಮ ಗಿಡಗಳೂ</para>
  <para style="q2" vid="SNG 4:13">ಕರ್ಪೂರವೂ ಜಟಾಮಾಂಸಿಯೂ ಇವೆ.<verse eid="SNG 4:13"/></para>
  <para style="q2">
    <verse number="14" style="v" sid="SNG 4:14"/>ಜಟಾಮಾಂಸಿ ಅಷ್ಟೇ ಅಲ್ಲದೆ ಕೇಸರಿಯೂ</para>
  <para style="q2" vid="SNG 4:14">ಬಜೆಯೂ ದಾಲ್ಚಿನ್ನಿಯೂ</para>
  <para style="q2" vid="SNG 4:14">ಸಕಲ ಸಾಂಬ್ರಾಣಿ ಗಿಡಮೂಲಿಕೆಗಳೂ</para>
  <para style="q2" vid="SNG 4:14">ರಕ್ತಬೋಳವೂ ಅಗರೂ</para>
  <para style="q2" vid="SNG 4:14">ಸಕಲವಿಧ ಶ್ರೇಷ್ಠ ಸುಗಂಧ ದ್ರವ್ಯಗಳೂ ಬೆಳೆದಿವೆ.<verse eid="SNG 4:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="SNG 4:15"/>ನೀನು ತೋಟದ ಬುಗ್ಗೆಯೂ</para>
  <para style="q2" vid="SNG 4:15">ಉಕ್ಕಿಬರುವ ಒರತೆಯೂ</para>
  <para style="q2" vid="SNG 4:15">ಲೆಬನೋನಿನಿಂದ ಹರಿಯುವ ಹೊಳೆಯೂ ಆಗಿರುವೆ.<verse eid="SNG 4:15"/></para>
  <para style="sp">ಪ್ರಿಯತಮೆ</para>
  <para style="q1">
    <verse number="16" style="v" sid="SNG 4:16"/>ಉತ್ತರಗಾಳಿಯೇ, ಬೀಸು,</para>
  <para style="q2" vid="SNG 4:16">ದಕ್ಷಿಣ ಗಾಳಿಯೇ ಬಾ</para>
  <para style="q1" vid="SNG 4:16">ನನ್ನ ತೋಟದ ಮೇಲೆ ಬೀಸು.</para>
  <para style="q2" vid="SNG 4:16">ಸುಗಂಧ ಸುವಾಸನೆ ಹರಡಲಿ.</para>
  <para style="q1" vid="SNG 4:16">ನನ್ನ ಪ್ರಿಯನು ತನ್ನ ತೋಟಕ್ಕೆ ಬಂದು ಉತ್ತಮ ಫಲಗಳನ್ನು ರುಚಿಸಲಿ.<verse eid="SNG 4:16"/></para>
  <chapter eid="SNG 4"/>
  <chapter number="5" style="c" sid="SNG 5"/>
  <para style="sp">ಪ್ರಿಯಕರ</para>
  <para style="q1">
    <verse number="1" style="v" sid="SNG 5:1"/>ನನ್ನ ಪ್ರಿಯಳೇ, ನನ್ನ ವಧುವೇ, ನಾನು ನನ್ನ ತೋಟಕ್ಕೆ ಬಂದಿರುವೆ.</para>
  <para style="q2" vid="SNG 5:1">ನನ್ನ ರಕ್ತಬೋಳ ಸುಗಂಧಗಳನ್ನೂ ಕೂಡಿಸಿರುವೆ.</para>
  <para style="q1" vid="SNG 5:1">ನನ್ನ ಜೇನುಗೂಡನ್ನೂ ಜೇನುತುಪ್ಪವನ್ನೂ ತಿಂದಿರುವೆ.</para>
  <para style="q2" vid="SNG 5:1">ನನ್ನ ದ್ರಾಕ್ಷಾರಸವನ್ನೂ ಹಾಲನ್ನೂ ಕುಡಿದಿದ್ದೇನೆ.</para>
  <para style="sp" vid="SNG 5:1">ಸ್ನೇಹಿತರು</para>
  <para style="q1" vid="SNG 5:1">ಸ್ನೇಹಿತರೇ, ಊಟಮಾಡಿರಿ, ಕುಡಿಯಿರಿ.</para>
  <para style="q2" vid="SNG 5:1">ಹೌದು ಪ್ರಿಯರೇ, ಸಮೃದ್ಧಿಯಾಗಿ ಪಾನಮಾಡಿರಿ.<verse eid="SNG 5:1"/></para>
  <para style="sp">ಪ್ರಿಯತಮೆ</para>
  <para style="q1">
    <verse number="2" style="v" sid="SNG 5:2"/>ನಾನು ನಿದ್ರಿಸುತ್ತಿದ್ದರೂ, ನನ್ನ ಹೃದಯವು ಎಚ್ಚರವಾಗಿತ್ತು.</para>
  <para style="q2" vid="SNG 5:2">ಇಗೋ! ಬಾಗಿಲು ತಟ್ಟುವ ನನ್ನ ಪ್ರಿಯನ ಶಬ್ದವಿದು:</para>
  <para style="q1" vid="SNG 5:2">“ನನ್ನ ಪ್ರಿಯಳೇ, ನನ್ನ ವಧುವೇ,</para>
  <para style="q2" vid="SNG 5:2">ನನ್ನ ಪಾರಿವಾಳವೇ, ಪರಿಪೂರ್ಣಳೇ,</para>
  <para style="q1" vid="SNG 5:2">ಬಾಗಿಲು ತೆಗೆ! ನನ್ನ ತಲೆ ಮಂಜಿನಿಂದ ನೆನೆದಿದೆ.</para>
  <para style="q2" vid="SNG 5:2">ನನ್ನ ಕೂದಲು ರಾತ್ರಿಯ ಹನಿಗಳಿಂದ ತೋಯ್ದಿದೆ.”<verse eid="SNG 5:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="SNG 5:3"/>ನಾನು ನನ್ನ ಅಂಗಿಯನ್ನು ತೆಗೆದು ಹಾಕಿರಲು,</para>
  <para style="q2" vid="SNG 5:3">ಅದನ್ನು ಮತ್ತೆ ಹಾಕಿಕೊಳ್ಳುವುದು ಹೇಗೆ?</para>
  <para style="q1" vid="SNG 5:3">ನಾನು ನನ್ನ ಕಾಲುಗಳನ್ನು ತೊಳೆದುಕೊಂಡಿರಲು,</para>
  <para style="q2" vid="SNG 5:3">ನಾನು ಮತ್ತೆ ಅವುಗಳನ್ನು ಕೊಳೆ ಮಾಡುವುದು ಹೇಗೆ?<verse eid="SNG 5:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="SNG 5:4"/>ಅನಂತರ ನನ್ನ ಪ್ರಿಯನು ಬಾಗಿಲ ಸಂದಿನಲ್ಲಿ ತನ್ನ ಕೈ ಹಾಕಿದನು.</para>
  <para style="q2" vid="SNG 5:4">ನನ್ನ ಹೃದಯವು ಅವನಿಗಾಗಿ ಮಿಡಿಯಿತು.<verse eid="SNG 5:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="SNG 5:5"/>ನಾನು ನನ್ನ ಪ್ರಿಯನಿಗೆ ಬಾಗಿಲು ತೆರೆಯಲು ಎದ್ದಾಗ,</para>
  <para style="q2" vid="SNG 5:5">ಬೀಗದ ಹಿಡಿಗಳ ಮೇಲೆ</para>
  <para style="q1" vid="SNG 5:5">ನನ್ನ ಕೈಗಳಿಂದ ರಕ್ತಬೋಳವು ತೊಟ್ಟಿಕ್ಕಿತು.</para>
  <para style="q2" vid="SNG 5:5">ನನ್ನ ಬೆರಳುಗಳಿಂದಲೂ ರಕ್ತಬೋಳವು ಸುರಿಯಿತು.<verse eid="SNG 5:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="SNG 5:6"/>ನಾನು ನನ್ನ ಪ್ರಿಯನಿಗೆ ಬಾಗಿಲು ತೆರೆದೆನು.</para>
  <para style="q2" vid="SNG 5:6">ಆದರೆ ಅಷ್ಟರಲ್ಲಿ ನನ್ನ ಪ್ರಿಯನು ಹಿಂದಿರುಗಿ ಹೋಗಿಬಿಟ್ಟಿದ್ದನು.</para>
  <para style="q2" vid="SNG 5:6">ಅವನು ಹೋಗಿದ್ದರಿಂದ ನನ್ನ ಹೃದಯ ಕುಗ್ಗಿಹೋಯಿತು.</para>
  <para style="q1" vid="SNG 5:6">ಅವನನ್ನು ಹುಡುಕಿದೆನು, ಆದರೆ ಸಿಕ್ಕಲಿಲ್ಲ.</para>
  <para style="q2" vid="SNG 5:6">ಅವನನ್ನು ಕರೆದೆನು, ಉತ್ತರವೇ ಇಲ್ಲ.<verse eid="SNG 5:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="SNG 5:7"/>ಪಟ್ಟಣದಲ್ಲಿ ಸಂಚರಿಸುವ</para>
  <para style="q2" vid="SNG 5:7">ಕಾವಲುಗಾರರು ನನ್ನನ್ನು ಕಂಡುಹಿಡಿದರು.</para>
  <para style="q1" vid="SNG 5:7">ನನ್ನನ್ನು ಹೊಡೆದು, ಗಾಯ ಮಾಡಿದರು.</para>
  <para style="q2" vid="SNG 5:7">ಗೋಡೆಗಳನ್ನು ಕಾಯುವವರು</para>
  <para style="q2" vid="SNG 5:7">ನನ್ನ ಮುಸುಕನ್ನು ಕಸಿದುಕೊಂಡರು.<verse eid="SNG 5:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="SNG 5:8"/>ಯೆರೂಸಲೇಮಿನ ಪುತ್ರಿಯರೇ, ನಿಮಗೆ ಆಣೆಯಿಟ್ಟು ಹೇಳುತ್ತೇನೆ.</para>
  <para style="q2" vid="SNG 5:8">ನೀವು ನನ್ನ ಪ್ರಿಯನನ್ನು ಕಂಡರೆ,</para>
  <para style="q1" vid="SNG 5:8">ನಾನು ಪ್ರೀತಿಯಿಂದ ಅಸ್ವಸ್ಥಳಾಗಿದ್ದೇನೆಂದು</para>
  <para style="q2" vid="SNG 5:8">ಅವನಿಗೆ ತಿಳಿಸಿರಿ.<verse eid="SNG 5:8"/></para>
  <para style="sp">ಸ್ನೇಹಿತರು</para>
  <para style="q1">
    <verse number="9" style="v" sid="SNG 5:9"/>ಸ್ತ್ರೀಯರಲ್ಲಿ ಅತಿ ಸುಂದರಿಯೇ,</para>
  <para style="q2" vid="SNG 5:9">ಬೇರೆಯವರ ಪ್ರಿಯನಿಗಿಂತ ನಿನ್ನ ಪ್ರಿಯನ ಅತಿಶಯವೇನು?</para>
  <para style="q1" vid="SNG 5:9">ನೀನು ನಮಗೆ ಹೀಗೆ ಆಣೆ ಇಡುವುದಕ್ಕೆ ಬೇರೆಯವರ ಪ್ರಿಯರಿಗಿಂತ</para>
  <para style="q2" vid="SNG 5:9">ನಿನ್ನ ಪ್ರಿಯನ ವಿಶೇಷವೇನು?<verse eid="SNG 5:9"/></para>
  <para style="sp">ಪ್ರಿಯತಮೆ</para>
  <para style="q1">
    <verse number="10" style="v" sid="SNG 5:10"/>ನನ್ನ ಪ್ರಿಯನು, ತೇಜೋಮಯನು, ಕೆಂಪೂ ಬಣ್ಣವುಳ್ಳವನು.</para>
  <para style="q2" vid="SNG 5:10">ಹತ್ತು ಸಾವಿರ ಜನರಲ್ಲಿ ಶ್ರೇಷ್ಠನು.<verse eid="SNG 5:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="SNG 5:11"/>ಅವನ ತಲೆಯು ಚೊಕ್ಕ ಬಂಗಾರದಂತಿದೆ.</para>
  <para style="q2" vid="SNG 5:11">ಅವನ ಗುಂಗುರು ಕೂದಲು</para>
  <para style="q2" vid="SNG 5:11">ಕಾಗೆಯಂತೆ ಕಪ್ಪಾಗಿದೆ.<verse eid="SNG 5:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="SNG 5:12"/>ಅವನ ಕಣ್ಣುಗಳು ತುಂಬುತೊರೆಗಳ ಬಳಿ ತಂಗುವ,</para>
  <para style="q2" vid="SNG 5:12">ಹಾಲಿನಿಂದ ತೊಳೆದಿರುವ,</para>
  <para style="q2" vid="SNG 5:12">ಪಾರಿವಾಳಗಳ ಕಣ್ಣುಗಳಂತಿವೆ.<verse eid="SNG 5:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="SNG 5:13"/>ಅವನ ಕೆನ್ನೆಗಳು</para>
  <para style="q2" vid="SNG 5:13">ಸುಗಂಧ ಸಸ್ಯಗಳು ಬೆಳೆಯುವ ದಿಬ್ಬಗಳಂತಿವೆ.</para>
  <para style="q1" vid="SNG 5:13">ಅವನ ತುಟಿಗಳು</para>
  <para style="q2" vid="SNG 5:13">ಸುಗಂಧ ರಕ್ತಬೋಳವನ್ನು ಸುರಿಸುವ ಕೆಂದಾವರೆಗಳು.<verse eid="SNG 5:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="SNG 5:14"/>ಅವನ ಕೈಗಳು ಗೋಮೇಧಿಕ ರತ್ನದ</para>
  <para style="q2" vid="SNG 5:14">ಬಂಗಾರದ ಸಲಾಕೆಗಳಂತಿವೆ.</para>
  <para style="q1" vid="SNG 5:14">ಅವನ ದೇಹ ಇಂದ್ರನೀಲಗಳಿಂದ</para>
  <para style="q2" vid="SNG 5:14">ಹೊಳೆಯುವ ದಂತದ ಹಾಗೆ ಇದೆ.<verse eid="SNG 5:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="SNG 5:15"/>ಅವನ ಕಾಲುಗಳು ಶುದ್ಧ ಬಂಗಾರದ ಮೇಲೆ</para>
  <para style="q2" vid="SNG 5:15">ನಿಂತಿರುವ ಚಂದ್ರಕಾಂತ ಸ್ತಂಭಗಳು.</para>
  <para style="q1" vid="SNG 5:15">ಅವನ ತೋರಿಕೆಯು ಲೆಬನೋನಿನ</para>
  <para style="q2" vid="SNG 5:15">ದೇವದಾರುಗಳ ಹಾಗೆ ಶ್ರೇಷ್ಠವಾಗಿವೆ.<verse eid="SNG 5:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="SNG 5:16"/>ಅವನ ಬಾಯಿ ಮಾತು ಬಹು ಮಧುರ.</para>
  <para style="q2" vid="SNG 5:16">ಹೌದು, ಅವನು ಸರ್ವಾಂಗ ಸುಂದರ.</para>
  <para style="q1" vid="SNG 5:16">ಯೆರೂಸಲೇಮಿನ ಪುತ್ರಿಯರೇ,</para>
  <para style="q2" vid="SNG 5:16">ಇವನೇ ನನ್ನ ಪ್ರಿಯನು, ಇವನೇ ನನ್ನ ಸ್ನೇಹಿತನು.<verse eid="SNG 5:16"/></para>
  <chapter eid="SNG 5"/>
  <chapter number="6" style="c" sid="SNG 6"/>
  <para style="sp">ಸ್ನೇಹಿತರು</para>
  <para style="q1">
    <verse number="1" style="v" sid="SNG 6:1"/>ನಿನ್ನ ಪ್ರಿಯನು ಎಲ್ಲಿಗೆ ಹೋದನು?</para>
  <para style="q2" vid="SNG 6:1">ಸ್ತ್ರೀಯರಲ್ಲಿ ಅತಿ ಸುಂದರಿಯೇ,</para>
  <para style="q1" vid="SNG 6:1">ನಾವು ಅವನನ್ನು ನಿನ್ನ ಸಂಗಡ ಹುಡುಕುವಂತೆ</para>
  <para style="q2" vid="SNG 6:1">ನಿನ್ನ ಪ್ರಿಯನು ಯಾವ ಕಡೆಗೆ ಹೋಗಿದ್ದಾನೆ?<verse eid="SNG 6:1"/></para>
  <para style="sp">ಪ್ರಿಯತಮೆ</para>
  <para style="q1">
    <verse number="2" style="v" sid="SNG 6:2"/>ನನ್ನ ಪ್ರಿಯನು ತೋಟಗಳಲ್ಲಿ ಮಂದೆ ಮೇಯಿಸುವುದಕ್ಕೂ,</para>
  <para style="q2" vid="SNG 6:2">ನೆಲದಾವರೆಗಳನ್ನು ಕೊಯ್ದು ತರುವುದಕ್ಕೂ,</para>
  <para style="q1" vid="SNG 6:2">ಸುಗಂಧ ಸಸ್ಯಗಳಿರುವ</para>
  <para style="q2" vid="SNG 6:2">ಉದ್ಯಾನವನಕ್ಕೆ ಹೋಗಿದ್ದಾನೆ.<verse eid="SNG 6:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="SNG 6:3"/>ನನ್ನ ಪ್ರಿಯನು ನನ್ನವನೇ, ನಾನು ಅವನವಳೇ.</para>
  <para style="q2" vid="SNG 6:3">ಅವನು ನೆಲದಾವರೆಗಳ ನಡುವೆ ಮಂದೆಯನ್ನು ಮೇಯಿಸುತ್ತಾನೆ.<verse eid="SNG 6:3"/></para>
  <para style="sp">ಪ್ರಿಯಕರ</para>
  <para style="q1">
    <verse number="4" style="v" sid="SNG 6:4"/>ನನ್ನ ಪ್ರಿಯಳೇ, ನೀನು ತಿರ್ಚ ನಗರದಂತೆ ಸುಂದರಿ,</para>
  <para style="q2" vid="SNG 6:4">ಯೆರೂಸಲೇಮಿನ ಹಾಗೆ ರಮ್ಯಳು,</para>
  <para style="q2" vid="SNG 6:4">ಧ್ವಜಗಳಿರುವ ದಂಡಿನ ಹಾಗೆ ಗಂಭೀರಳೂ ಆಗಿರುವೆ.<verse eid="SNG 6:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="SNG 6:5"/>ನಿನ್ನ ಕಣ್ಣುಗಳನ್ನು ನನ್ನ ಕಡೆಯಿಂದ ತಿರುಗಿಸು,</para>
  <para style="q2" vid="SNG 6:5">ಏಕೆಂದರೆ ಅವು ನನ್ನನ್ನು ಜಯಿಸಿವೆ.</para>
  <para style="q1" vid="SNG 6:5">ನಿನ್ನ ತಲೆಗೂದಲು ಗಿಲ್ಯಾದ್ ಪರ್ವತದಿಂದ ಇಳಿಯುವ</para>
  <para style="q2" vid="SNG 6:5">ಮೇಕೆಯ ಮಂದೆಯಂತಿದೆ.<verse eid="SNG 6:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="SNG 6:6"/>ನಿನ್ನ ಹಲ್ಲುಗಳ ಹೊಳಪು</para>
  <para style="q2" vid="SNG 6:6">ಉಣ್ಣೆ ಕತ್ತರಿಸಿ ಸ್ನಾನಮಾಡಿಸಿದ ಕುರಿಮಂದೆಗೆ ಸಮಾನ.</para>
  <para style="q1" vid="SNG 6:6">ಅವು ಜೊತೆಯಾಗಿಯೇ ಇರುತ್ತವೆ.</para>
  <para style="q2" vid="SNG 6:6">ಅವುಗಳಲ್ಲಿ ಒಂದೂ ಒಂಟಿಯಾಗಿರದು.<verse eid="SNG 6:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="SNG 6:7"/>ಮುಸುಕಿನೊಳಗಿನ ನಿನ್ನ ಕೆನ್ನೆ</para>
  <para style="q2" vid="SNG 6:7">ವಿಭಾಗಿಸಿದ ದಾಳಿಂಬೆಯ ಹಣ್ಣಿನ ಹಾಗೆ ಇದೆ.<verse eid="SNG 6:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="SNG 6:8"/>ಅರಸನಿಗೆ ಅರವತ್ತು ಮಂದಿ ರಾಣಿಯರೂ</para>
  <para style="q2" vid="SNG 6:8">ಎಂಬತ್ತು ಮಂದಿ ಉಪಪತ್ನಿಯರೂ</para>
  <para style="q2" vid="SNG 6:8">ಲೆಕ್ಕವಿಲ್ಲದ ಕನ್ಯೆಯರೂ ಇದ್ದಾರೆ.<verse eid="SNG 6:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="SNG 6:9"/>ಆದರೆ ನನಗೆ ನನ್ನ ಪಾರಿವಾಳವು, ನನ್ನ ಪರಿಪೂರ್ಣಳು ಒಬ್ಬಳೇ.</para>
  <para style="q2" vid="SNG 6:9">ಇವಳು ತನ್ನ ತಾಯಿಗೆ ಒಬ್ಬಳೇ ಮಗಳು.</para>
  <para style="q2" vid="SNG 6:9">ತನ್ನ ಹೆತ್ತವಳಿಗೆ ಪ್ರಿಯಳು.</para>
  <para style="q1" vid="SNG 6:9">ಕನ್ನಿಕೆಯರು ಇವಳನ್ನು ಕಂಡು ಆಶೀರ್ವದಿಸಿದರು.</para>
  <para style="q2" vid="SNG 6:9">ಹೌದು, ರಾಣಿಯರೂ ಉಪಪತ್ನಿಯರೂ ಇವಳನ್ನು ಹೀಗೆಂದು ಹೊಗಳಿದರು:<verse eid="SNG 6:9"/></para>
  <para style="sp">ಸ್ನೇಹಿತರು</para>
  <para style="q1">
    <verse number="10" style="v" sid="SNG 6:10"/>ಮೆರವಣೆಗೆಯಲ್ಲಿ ನಕ್ಷತ್ರಗಳ ಹಾಗೆ ಗಂಭೀರಳೂ,</para>
  <para style="q2" vid="SNG 6:10">ಚಂದ್ರನ ಹಾಗೆ ಸುಂದರಿಯೂ, ಸೂರ್ಯನ ಹಾಗೆ ಪ್ರಕಾಶಿಸುವವಳೂ</para>
  <para style="q2" vid="SNG 6:10">ಆಗಿರುವ ಈ ಉದಯವಂತೆ ಯಾರು?<verse eid="SNG 6:10"/></para>
  <para style="sp">ಪ್ರಿಯಕರ</para>
  <para style="q1">
    <verse number="11" style="v" sid="SNG 6:11"/>ದ್ರಾಕ್ಷಿಬಳ್ಳಿಯು ಚಿಗುರಿದೆಯೋ,</para>
  <para style="q2" vid="SNG 6:11">ದಾಳಿಂಬೆ ಗಿಡ ಹೂಬಿಟ್ಟಿದೆಯೋ ಎಂದು</para>
  <para style="q1" vid="SNG 6:11">ಕಣಿವೆಯಲ್ಲಿನ ಫಲಗಳನ್ನು ನೋಡಲು</para>
  <para style="q2" vid="SNG 6:11">ನಾನು ಬಾದಾಮಿಯ ತೋಟಕ್ಕೆ ಹೋದೆನು.<verse eid="SNG 6:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="SNG 6:12"/>ನಾನು ಅದನ್ನು ಅರಿತುಕೊಳ್ಳುವ ಮೊದಲು,</para>
  <para style="q2" vid="SNG 6:12">ನನ್ನ ಆಸೆ ನನ್ನ ಜನ ಪ್ರಧಾನರ ನಡುವೆ ರಥದ ಮೇಲೆ ಕೂತಿರುವಂತೆ ನನ್ನನ್ನು ನಡೆಸಿತು.<verse eid="SNG 6:12"/></para>
  <para style="sp">ಸ್ನೇಹಿತರು</para>
  <para style="q1">
    <verse number="13" style="v" sid="SNG 6:13"/>ತಿರುಗಿ ಬಾ, ತಿರುಗಿ ಬಾ, ಶೂಲಮ್ ಊರಿನವಳೇ,</para>
  <para style="q2" vid="SNG 6:13">ನಾವು ನಿನ್ನನ್ನು ನೋಡುವಂತೆ ತಿರುಗಿ ಬಾ, ತಿರುಗಿ ಬಾ!</para>
  <para style="sp" vid="SNG 6:13">ಪ್ರಿಯಕರ</para>
  <para style="q1" vid="SNG 6:13">ಎರಡು ಗುಂಪಿನ<note caller="+" style="f"><char style="fr" closed="false">6:13 </char><char style="fq" closed="false">ಎರಡು ಗುಂಪಿನ </char><char style="ft" closed="false">ಹೀಬ್ರೂ ಭಾಷೆಯಲ್ಲಿ </char><char style="fqa" closed="false">ಮಹನಯಿಮ್</char></note> ನರ್ತಕಿಯರ ನಡುವೆ ಕುಣಿಯುತ್ತಿರುವ,</para>
  <para style="q2" vid="SNG 6:13">ಶೂಲಮ್ ಊರಿನವಳನ್ನು ನೀವು ನೋಡುವುದೇಕೆ?<verse eid="SNG 6:13"/></para>
  <para style="b"/>
  <chapter eid="SNG 6"/>
  <chapter number="7" style="c" sid="SNG 7"/>
  <para style="q1">
    <verse number="1" style="v" sid="SNG 7:1"/>ಓ ರಾಜಪುತ್ರಿಯೇ!</para>
  <para style="q2" vid="SNG 7:1">ಕೆರಗಳನ್ನು ಮೆಟ್ಟಿರುವ ನಿನ್ನ ಪಾದಗಳು ಎಷ್ಟು ಸುಂದರವಾಗಿವೆ!</para>
  <para style="q1" vid="SNG 7:1">ನಿನ್ನ ಅಂದದ ಕಾಲುಗಳು</para>
  <para style="q2" vid="SNG 7:1">ಶಿಲ್ಪಿಯ ಕೈಕೆಲಸದ ಆಭರಣಗಳಂತಿವೆ.<verse eid="SNG 7:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="SNG 7:2"/>ನಿನ್ನ ಹೊಕ್ಕಳು ಮಿಶ್ರಪಾನಕ ತುಂಬಿದ</para>
  <para style="q2" vid="SNG 7:2">ದುಂಡು ಬಟ್ಟಲಿನ ಹಾಗಿದೆ.</para>
  <para style="q1" vid="SNG 7:2">ನಿನ್ನ ಹೊಟ್ಟೆ ನೆಲದಾವರೆಗಳಿಂದ ಸುತ್ತಿಕೊಂಡಿರುವ ಹೂವುಗಳು ಸುತ್ತಿಕೊಂಡಿರುವ</para>
  <para style="q2" vid="SNG 7:2">ಗೋಧಿಯ ರಾಶಿಯಾಗಿದೆ.<verse eid="SNG 7:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="SNG 7:3"/>ನಿನ್ನ ಸ್ತನಗಳೆರಡೂ</para>
  <para style="q2" vid="SNG 7:3">ಹುಲ್ಲೆಯ ಅವಳಿಮರಿಗಳ ಹಾಗಿವೆ.<verse eid="SNG 7:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="SNG 7:4"/>ನಿನ್ನ ಕೊರಳು ದಂತದ ಗೋಪುರ.</para>
  <para style="q1" vid="SNG 7:4">ನಿನ್ನ ಕಣ್ಣುಗಳು ಬತ್ ರಬ್ಬೀಮ್ ಬಾಗಿಲ ಬಳಿಯಲ್ಲಿರುವ</para>
  <para style="q2" vid="SNG 7:4">ಹೆಷ್ಬೋನಿನ ಕೊಳಗಳು.</para>
  <para style="q1" vid="SNG 7:4">ನಿನ್ನ ಮೂಗು, ದಮಸ್ಕದ ಕಡೆಗಿರುವ</para>
  <para style="q2" vid="SNG 7:4">ಲೆಬನೋನಿನ ಗೋಪುರದ ಹಾಗಿದೆ.<verse eid="SNG 7:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="SNG 7:5"/>ನಿನ್ನ ತಲೆಯು ಕರ್ಮೆಲ್ ಬೆಟ್ಟದಂತೆ ವೈಭವ.</para>
  <para style="q2" vid="SNG 7:5">ನಿನ್ನ ತಲೆಕೂದಲು ಧೂಮ್ರ ಬಣ್ಣದ ಹಾಗೆ ಇದೆ.</para>
  <para style="q2" vid="SNG 7:5">ಹೆಣೆದ ಆ ಜಡೆಯಿಂದ ಅರಸನಿಗೂ ಆಕರ್ಷಣ.<verse eid="SNG 7:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="SNG 7:6"/>ನನ್ನ ಪ್ರೇಮವೇ, ನೀನು ನಿನ್ನ ಹರ್ಷದಿಂದ</para>
  <para style="q2" vid="SNG 7:6">ಎಷ್ಟೋ ಸುಂದರಿಯೂ ಎಷ್ಟೋ ಮನೋಹರಳೂ ಆಗಿರುವೆ.<verse eid="SNG 7:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="SNG 7:7"/>ನಿನ್ನ ನೀಳ ಆಕಾರವು ಖರ್ಜೂರ ಮರದಂತಿದೆ.</para>
  <para style="q2" vid="SNG 7:7">ನಿನ್ನ ಸ್ತನಗಳು ಅದರ ಗೊಂಚಲುಗಳು.<verse eid="SNG 7:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="SNG 7:8"/>ನಾನು, “ಆ ಖರ್ಜೂರದ ಮರವನ್ನು ಹತ್ತಿ</para>
  <para style="q2" vid="SNG 7:8">ಅದರ ಗರಿಗಳನ್ನು ಹಿಡಿಯುವೆ,” ಎಂದುಕೊಂಡೆನು.</para>
  <para style="q1" vid="SNG 7:8">ನಿನ್ನ ಸ್ತನಗಳು ದ್ರಾಕ್ಷಿ ಗೊಂಚಲುಗಳಂತಿರಲಿ,</para>
  <para style="q2" vid="SNG 7:8">ನಿನ್ನ ಉಸಿರು ಸೇಬು ಹಣ್ಣಿನ ಪರಿಮಳದಂತೆಯೂ ಇರಲಿ.<verse eid="SNG 7:8"/></para>
  <para style="q2">
    <verse number="9" style="v" sid="SNG 7:9"/>ನಿನ್ನ ಬಾಯಿಯ ಮುದ್ದುಗಳು ಉತ್ತಮ ದ್ರಾಕ್ಷಾರಸದ ಹಾಗಿರಲಿ.</para>
  <para style="sp" vid="SNG 7:9">ಪ್ರಿಯತಮೆ</para>
  <para style="q1" vid="SNG 7:9">ನನ್ನ ಪ್ರಿಯಕರನ ತುಟಿ, ಹಲ್ಲುಗಳಲ್ಲಿ ದ್ರಾಕ್ಷಾರಸವು</para>
  <para style="q2" vid="SNG 7:9">ನೇರವಾಗಿ ಹರಿದು ಇಂಪಾಗಿ ರುಚಿಸಲಿ.<verse eid="SNG 7:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="SNG 7:10"/>ನಾನು ನನ್ನ ಪ್ರಿಯನವಳು.</para>
  <para style="q2" vid="SNG 7:10">ಅವನ ಆಸೆಯು ನನ್ನ ಕಡೆಗಿರುವುದು.<verse eid="SNG 7:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="SNG 7:11"/>ನನ್ನ ಪ್ರಿಯನೇ, ಬಾ ಹೋಗೋಣ.</para>
  <para style="q2" vid="SNG 7:11">ನಾವು ಗ್ರಾಮಗಳಲ್ಲಿ ವಸತಿಯಾಗಿರೋಣ ಬಾ.<verse eid="SNG 7:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="SNG 7:12"/>ನಾವು ಬೆಳಗ್ಗೆ ಹೊರಟು, ದ್ರಾಕ್ಷಿ ತೋಟಗಳಿಗೆ ಹೋಗೋಣ ಬಾ.</para>
  <para style="q2" vid="SNG 7:12">ದ್ರಾಕ್ಷಿ ಚಿಗುರಿದೆಯೋ,</para>
  <para style="q1" vid="SNG 7:12">ಅದರ ಹೂ ಅರಳಿದೆಯೋ</para>
  <para style="q2" vid="SNG 7:12">ದಾಳಿಂಬೆ ಹೂಬಿಟ್ಟಿದೆಯೋ ನೋಡೋಣ ಬಾ.</para>
  <para style="q2" vid="SNG 7:12">ಅಲ್ಲಿ ನನ್ನ ಪ್ರೀತಿಯನ್ನು ನಿನಗೆ ಅರ್ಪಿಸುವೆನು.<verse eid="SNG 7:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="SNG 7:13"/>ನನ್ನ ಪ್ರಿಯನೇ, ಕಾಮಜನಕ ವೃಕ್ಷಗಳು ಪರಿಮಳ ಬೀರುತ್ತಿವೆ.</para>
  <para style="q2" vid="SNG 7:13">ನಮ್ಮ ಬಾಗಿಲ ಬಳಿಯಲ್ಲಿ ನಿನಗೋಸ್ಕರ ನಾನು</para>
  <para style="q1" vid="SNG 7:13">ರುಚಿಯುಳ್ಳ ಮಾಗಿದ ಹೊಸ ಹಣ್ಣುಗಳನ್ನು ಸಿದ್ಧಪಡಿಸಿದ್ದೇನೆ.<verse eid="SNG 7:13"/></para>
  <para style="b"/>
  <chapter eid="SNG 7"/>
  <chapter number="8" style="c" sid="SNG 8"/>
  <para style="q1">
    <verse number="1" style="v" sid="SNG 8:1"/>ನೀನು ನನ್ನ ತಾಯಿಯ ಹಾಲು ಕುಡಿದ</para>
  <para style="q2" vid="SNG 8:1">ನನ್ನ ಅಣ್ಣನಾಗಿದ್ದರೆ, ಎಷ್ಟೋ ಚೆನ್ನಾಗಿರುತ್ತಿತ್ತು!</para>
  <para style="q1" vid="SNG 8:1">ನಾನು ನಿನ್ನನ್ನು ಕಂಡು ಹೊರಗೆಯೇ</para>
  <para style="q2" vid="SNG 8:1">ನಿನಗೆ ಮುದ್ದಿಡುತ್ತಿದ್ದೆ.</para>
  <para style="q2" vid="SNG 8:1">ಆಗ ಯಾರೂ ನನ್ನನ್ನು ನಿಂದಿಸುತ್ತಿರಲಿಲ್ಲ.<verse eid="SNG 8:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="SNG 8:2"/>ನಿನ್ನನ್ನು ನನ್ನ ತಾಯಿಯ ಮನೆಗೆ ಕರೆದುಕೊಂಡು ಹೋಗುತ್ತಿದ್ದೆನು.</para>
  <para style="q2" vid="SNG 8:2">ಅಲ್ಲಿ ನೀನು ನನಗೆ ಉಪದೇಶ ಮಾಡಬಹುದಾಗಿತ್ತು.</para>
  <para style="q1" vid="SNG 8:2">ನಾನು ದ್ರಾಕ್ಷಿ ಮಿಶ್ರಪಾನಕವನ್ನು ಕೊಡುತ್ತಿದ್ದೆನು.</para>
  <para style="q2" vid="SNG 8:2">ದಾಳಿಂಬೆ ರಸವನ್ನು ನಿನಗೆ ಕುಡಿಸುತ್ತಿದ್ದೆನು.<verse eid="SNG 8:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="SNG 8:3"/>ನಿನ್ನ ಎಡಗೈ ನನ್ನ ತಲೆದಿಂಬಾಗಿರಲಿ.</para>
  <para style="q2" vid="SNG 8:3">ನಿನ್ನ ಬಲಗೈ ನನ್ನನ್ನು ಅಪ್ಪಿಕೊಳ್ಳಲಿ.<verse eid="SNG 8:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="SNG 8:4"/>ಯೆರೂಸಲೇಮಿನ ಪುತ್ರಿಯರೇ,</para>
  <para style="q2" vid="SNG 8:4">ಮೆಚ್ಚುವ ಕಾಲಕ್ಕೆ ಮುಂಚೆ</para>
  <para style="q1" vid="SNG 8:4">ನೀವು ಪ್ರೀತಿಯನ್ನು ಎಬ್ಬಿಸಬೇಡಿರಿ,</para>
  <para style="q2" vid="SNG 8:4">ಎಚ್ಚರಿಸಲೂ ಬೇಡಿರಿ ಎಂದು ನಿಮ್ಮಿಂದ ಪ್ರಮಾಣಮಾಡಿಸುತ್ತೇನೆ.<verse eid="SNG 8:4"/></para>
  <para style="sp">ಸ್ನೇಹಿತರು</para>
  <para style="q1">
    <verse number="5" style="v" sid="SNG 8:5"/>ತನ್ನ ಪ್ರಿಯನನ್ನು ಒರಗಿಕೊಂಡು ಅಡವಿಯಿಂದ ಬರುವ</para>
  <para style="q2" vid="SNG 8:5">ಇವಳು ಯಾರು?</para>
  <para style="sp" vid="SNG 8:5">ಪ್ರಿಯತಮೆ</para>
  <para style="q1" vid="SNG 8:5">ಸೇಬುಗಿಡದ ಕೆಳಗೆ ನಿನ್ನನ್ನು ಪ್ರೇರಿಸಿದೆನು.</para>
  <para style="q2" vid="SNG 8:5">ಅದು ನಿನ್ನ ತಾಯಿ ನಿನ್ನನ್ನು ಗರ್ಭಧರಿಸಿದ ಸ್ಥಳ.</para>
  <para style="q2" vid="SNG 8:5">ಅಲ್ಲಿ ನಿನ್ನ ತಾಯಿ ಪ್ರಸವವೇದನೆಯಿಂದ ನಿನ್ನನ್ನು ಹಡೆದಳು.<verse eid="SNG 8:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="SNG 8:6"/>ನನ್ನನ್ನು ನಿನ್ನ ಹೃದಯದ ಮೇಲೆ ಒಂದು ಮುದ್ರೆಯಾಗಿ ಧರಿಸಿಕೋ.</para>
  <para style="q2" vid="SNG 8:6">ನಾನು ನಿನ್ನ ಕೈಮೇಲೆ ಒಂದು ಮುದ್ರೆಯಾಗಿರುವೆ.</para>
  <para style="q1" vid="SNG 8:6">ಪ್ರೀತಿಯು ಮರಣದಷ್ಟು ಬಲವಾಗಿದೆ.</para>
  <para style="q2" vid="SNG 8:6">ಮತ್ಸರವು ಸಮಾಧಿಯಷ್ಟು ಕ್ರೂರ.</para>
  <para style="q1" vid="SNG 8:6">ಪ್ರೀತಿಯು ಉರಿಯುವ ಬೆಂಕಿ ಪ್ರಜ್ವಲಿಸುವ</para>
  <para style="q2" vid="SNG 8:6">ಜ್ವಾಲೆಯ ಹಾಗಿರುವುದು.<verse eid="SNG 8:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="SNG 8:7"/>ಜಲರಾಶಿಗಳು ಪ್ರೀತಿಯನ್ನು ನಂದಿಸಲಾರವು.</para>
  <para style="q2" vid="SNG 8:7">ಪ್ರವಾಹಗಳು ಸಹ ಪ್ರೀತಿಯನ್ನು ಮುಳುಗಿಸಲಾರವು.</para>
  <para style="q1" vid="SNG 8:7">ಒಬ್ಬನು ತನ್ನ ಆಸ್ತಿಯನ್ನೆಲ್ಲಾ</para>
  <para style="q2" vid="SNG 8:7">ಪ್ರೀತಿಗೋಸ್ಕರ ಕೊಟ್ಟರೂ,</para>
  <para style="q2" vid="SNG 8:7">ಆ ಪ್ರೀತಿಗೆ ಬದಲಾಗಿ ಅಂಥವನಿಗೆ ಸಂಪೂರ್ಣ ನಿಂದೆಯೇ ಸಿಗುವುದು.<verse eid="SNG 8:7"/></para>
  <para style="sp">ಸ್ನೇಹಿತರು</para>
  <para style="q1">
    <verse number="8" style="v" sid="SNG 8:8"/>ಪ್ರಾಯಕ್ಕೆ ಬಾರದ ತಂಗಿ ಒಬ್ಬಳು ನಮಗಿದ್ದಾಳೆ.</para>
  <para style="q2" vid="SNG 8:8">ಅವಳನ್ನು ಮದುವೆಗಾಗಿ ಮಾತಾಡಲು</para>
  <para style="q2" vid="SNG 8:8">ಯಾರಾದರೂ ಬಂದರೆ, ನಾವೇನು ಮಾಡೋಣ?<verse eid="SNG 8:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="SNG 8:9"/>ಅವಳು ಗೋಡೆಯಾದರೆ,</para>
  <para style="q2" vid="SNG 8:9">ನಾವು ಅವಳ ಮೇಲೆ ಬೆಳ್ಳಿಯ ಗೋಪುರವನ್ನು ಕಟ್ಟುವೆವು.</para>
  <para style="q1" vid="SNG 8:9">ಅವಳು ಬಾಗಿಲಾದರೆ,</para>
  <para style="q2" vid="SNG 8:9">ದೇವದಾರು ಹಲಿಗೆಗಳಿಂದ ಅವಳನ್ನು ಭದ್ರಪಡಿಸುವೆವು.<verse eid="SNG 8:9"/></para>
  <para style="sp">ಪ್ರಿಯತಮೆ</para>
  <para style="q1">
    <verse number="10" style="v" sid="SNG 8:10"/>ನಾನು ಗೋಡೆಯಂಥವಳೇ,</para>
  <para style="q2" vid="SNG 8:10">ನನ್ನ ಯೌವನವು ಬುರುಜುಗಳು.</para>
  <para style="q1" vid="SNG 8:10">ಹೀಗೆ ನಾನು ಅವನ ದೃಷ್ಟಿಯಲ್ಲಿ</para>
  <para style="q2" vid="SNG 8:10">ಸಮಾಧಾನ ಹೊಂದುವೆನು.<verse eid="SNG 8:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="SNG 8:11"/>ಸೊಲೊಮೋನನಿಗೆ ಬಾಳ್ ಹಾಮೋನಿನಲ್ಲಿ ಒಂದು ದ್ರಾಕ್ಷಿತೋಟ ಇತ್ತು.</para>
  <para style="q2" vid="SNG 8:11">ಅವನು ಆ ದ್ರಾಕ್ಷಿತೋಟವನ್ನು ರೈತರಿಗೆ ಗುತ್ತಿಗೆಗೆ ಕೊಟ್ಟನು.</para>
  <para style="q1" vid="SNG 8:11">ಪ್ರತಿಯೊಬ್ಬ ಗುತ್ತಿಗೆಗಾರನು ಅದರ ಫಲದಿಂದ</para>
  <para style="q2" vid="SNG 8:11">ಸಾವಿರ ಬೆಳ್ಳಿಯ ನಾಣ್ಯಗಳನ್ನು<note caller="+" style="f"><char style="fr" closed="false">8:11 </char><char style="ft" closed="false">ಸುಮಾರು 12 ಕಿಲೋಗ್ರಾಂ</char></note> ತರಬೇಕಾಗಿತ್ತು.<verse eid="SNG 8:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="SNG 8:12"/>ಸೊಲೊಮೋನನೇ, ಆ ಸಾವಿರ ಬೆಳ್ಳಿ ನಾಣ್ಯಗಳು ನಿನಗೇ ಇರಲಿ.<note caller="+" style="f"><char style="fr" closed="false">8:12 </char><char style="ft" closed="false">ಸುಮಾರು 2.3 ಕಿಲೋಗ್ರಾಂ</char></note></para>
  <para style="q2" vid="SNG 8:12">ತೋಟದ ಫಲವನ್ನು ಕಾಪಾಡುವವರಿಗೆ ಇನ್ನೂರು ಬೆಳ್ಳಿನಾಣ್ಯಗಳು ಸೇರಲಿ.</para>
  <para style="q2" vid="SNG 8:12">ಆದರೆ ನನ್ನ ದ್ರಾಕ್ಷಿತೋಟ ನನಗೇ ಇರಲಿ.<verse eid="SNG 8:12"/></para>
  <para style="sp">ಪ್ರಿಯಕರ</para>
  <para style="q1">
    <verse number="13" style="v" sid="SNG 8:13"/>ತೋಟಗಳಲ್ಲಿ ವಾಸವಾಗಿರುವಳೇ,</para>
  <para style="q2" vid="SNG 8:13">ಸ್ನೇಹಿತರು ನನ್ನ ಸಂಗಡ ಇದ್ದಾರೆ.</para>
  <para style="q2" vid="SNG 8:13">ನಾನು ನಿನ್ನ ಧ್ವನಿಯನ್ನು ಕೇಳ ಮಾಡು!<verse eid="SNG 8:13"/></para>
  <para style="sp">ಪ್ರಿಯತಮೆ</para>
  <para style="q1">
    <verse number="14" style="v" sid="SNG 8:14"/>ನನ್ನ ಪ್ರಿಯನೇ,</para>
  <para style="q2" vid="SNG 8:14">ಸುಗಂಧ ಸಸ್ಯ ಪರ್ವತಗಳ ಮೇಲಿರುವ</para>
  <para style="q1" vid="SNG 8:14">ಜಿಂಕೆಯಂತೆಯೂ, ಪ್ರಾಯದ ಹುಲ್ಲೆಯಂತೆಯೂ</para>
  <para style="q2" vid="SNG 8:14">ನೀನು ಬೇಗ ಬಾ.<verse eid="SNG 8:14"/></para>
  <chapter eid="SNG 8"/>
</usx>
