<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="JOL" style="id">- Biblica® Open Kannada Contemporary Version</book>
  <para style="h">ಯೋಯೇಲ</para>
  <para style="toc1">ಯೋಯೇಲ</para>
  <para style="toc2">ಯೋಯೇಲ</para>
  <para style="toc3">ಯೋಯೇಲ</para>
  <para style="mt1">ಯೋಯೇಲ</para>
  <chapter number="1" style="c" sid="JOL 1"/>
  <para style="p">
    <verse number="1" style="v" sid="JOL 1:1"/>ಪೆತುಯೇಲನ ಮಗನಾದ ಯೋಯೇಲನಿಗೆ ಬಂದ ಯೆಹೋವ ದೇವರು ವಾಕ್ಯವು:<verse eid="JOL 1:1"/></para>
  <para style="b"/>
  <para style="s1">ಮಿಡತೆಗಳಿಂದಾದ ಹಾನಿ</para>
  <para style="q1">
    <verse number="2" style="v" sid="JOL 1:2"/>ಹಿರಿಯರೇ, ಇದನ್ನು ಕೇಳಿರಿ:</para>
  <para style="q2" vid="JOL 1:2">ದೇಶದ ನಿವಾಸಿಗಳೇ, ಕಿವಿಗೊಡಿರಿ.</para>
  <para style="q1" vid="JOL 1:2">ಇಂಥ ದುರ್ಘಟನೆಯು ನಿಮ್ಮ ದಿವಸಗಳಲ್ಲಾದರೂ</para>
  <para style="q2" vid="JOL 1:2">ನಿಮ್ಮ ಪೂರ್ವಿಕರ ದಿವಸಗಳಲ್ಲಾದರೂ ಉಂಟಾಯಿತೋ?<verse eid="JOL 1:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="JOL 1:3"/>ಇದರ ವಿಷಯವನ್ನು ನಿಮ್ಮ ಮಕ್ಕಳಿಗೆ ತಿಳಿಸಿರಿ,</para>
  <para style="q2" vid="JOL 1:3">ಅವರು ತಮ್ಮ ಮಕ್ಕಳಿಗೆ ತಿಳಿಸಲಿ,</para>
  <para style="q2" vid="JOL 1:3">ಅವರ ಮಕ್ಕಳೂ ಮತ್ತೊಂದು ತಲಾಂತರಕ್ಕೂ ತಿಳಿಸಲಿ.<verse eid="JOL 1:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="JOL 1:4"/>ಚೂರಿಮಿಡತೆ ತಿಂದು, ಉಳಿದಿದ್ದ ಬೆಳೆಯನ್ನು</para>
  <para style="q2" vid="JOL 1:4">ಗುಂಪುಮಿಡತೆ ತಿಂದುಬಿಟ್ಟಿತು.</para>
  <para style="q1" vid="JOL 1:4">ಗುಂಪುಮಿಡತೆ ತಿಂದು ಬಿಟ್ಟಿದ್ದನ್ನು,</para>
  <para style="q2" vid="JOL 1:4">ಕುದುರೆಮಿಡತೆ ತಿಂದುಬಿಟ್ಟಿತು.</para>
  <para style="q1" vid="JOL 1:4">ಕುದುರೆಮಿಡತೆ ಬಿಟ್ಟಿದ್ದನ್ನು</para>
  <para style="q2" vid="JOL 1:4">ಕಂಬಳಿಮಿಡತೆ ತಿಂದುಬಿಟ್ಟಿತು.<verse eid="JOL 1:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="JOL 1:5"/>ಅಮಲೇರಿದವರೇ, ಎಚ್ಚೆತ್ತು ಅಳಿರಿ;</para>
  <para style="q2" vid="JOL 1:5">ದ್ರಾಕ್ಷಾರಸ ಕುಡಿಯುವವರೆಲ್ಲರೇ,</para>
  <para style="q1" vid="JOL 1:5">ಹೊಸ ದ್ರಾಕ್ಷಾರಸದ ನಿಮಿತ್ತ ಗೋಳಾಡಿರಿ;</para>
  <para style="q2" vid="JOL 1:5">ಏಕೆಂದರೆ, ಅದು ನಿಮ್ಮ ಬಾಯಿಗೆ ಇನ್ನು ದೊರಕುವುದಿಲ್ಲ.<verse eid="JOL 1:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="JOL 1:6"/>ನನ್ನ ದೇಶದ ಮೇಲೆ ಒಂದು ಜನಾಂಗವು ಏರಿ ಬಂತು.</para>
  <para style="q2" vid="JOL 1:6">ಅದು ಬಲವಾದದ್ದೂ, ಲೆಕ್ಕವಿಲ್ಲದ್ದೂ;</para>
  <para style="q1" vid="JOL 1:6">ಅದರ ಕೋರೆಗಳು ಸಿಂಹದ ಹಲ್ಲುಗಳು,</para>
  <para style="q2" vid="JOL 1:6">ಸಿಂಹಿಣಿಯ ಹಲ್ಲುಗಳು ಅದಕ್ಕೆ ಇವೆ.<verse eid="JOL 1:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="JOL 1:7"/>ಅದು ನನ್ನ ದ್ರಾಕ್ಷಿಬಳ್ಳಿಯನ್ನು ಹಾಳು ಮಾಡಿ,</para>
  <para style="q2" vid="JOL 1:7">ನನ್ನ ಅಂಜೂರದ ಗಿಡವನ್ನು ಮುರಿದು ಹಾಕಿದೆ.</para>
  <para style="q1" vid="JOL 1:7">ಅದನ್ನು ಸಂಪೂರ್ಣ ಸುಲಿದು ಬಿಸಾಡಿಬಿಟ್ಟಿದೆ.</para>
  <para style="q2" vid="JOL 1:7">ಅದರ ಕೊಂಬೆಗಳು ಬಿಳುಪಾದವು.<verse eid="JOL 1:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="JOL 1:8"/>ಯೌವನದ ಗಂಡನಿಗೋಸ್ಕರ ಗೋಣಿತಟ್ಟು ಧರಿಸಿ,</para>
  <para style="q2" vid="JOL 1:8">ಕನ್ಯೆಯ ಹಾಗೆ ಪ್ರಲಾಪಿಸು.<verse eid="JOL 1:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="JOL 1:9"/>ಧಾನ್ಯ ಸಮರ್ಪಣೆಯನ್ನಾಗಲಿ ಪಾನಾರ್ಪಣೆಯನ್ನಾಗಲಿ</para>
  <para style="q2" vid="JOL 1:9">ಯೆಹೋವ ದೇವರ ಆಲಯದಲ್ಲಿ ಅರ್ಪಿಸುವುದಿಲ್ಲ.</para>
  <para style="q1" vid="JOL 1:9">ಯೆಹೋವ ದೇವರ ಸೇವಕರಾದ ಯಾಜಕರು ಗೋಳಾಡುತ್ತಾರೆ.<verse eid="JOL 1:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="JOL 1:10"/>ಹೊಲವು ಹಾಳಾಗಿದೆ;</para>
  <para style="q2" vid="JOL 1:10">ಭೂಮಿಯು ಒಣಗಿದೆ,</para>
  <para style="q1" vid="JOL 1:10">ಧಾನ್ಯವು ನಾಶವಾಗಿದೆ;</para>
  <para style="q2" vid="JOL 1:10">ಹೊಸ ದ್ರಾಕ್ಷಾರಸವು ಒಣಗಿದೆ;</para>
  <para style="q2" vid="JOL 1:10">ಎಣ್ಣೆ ತೀರಿಹೋಗಿದೆ.<verse eid="JOL 1:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="JOL 1:11"/>ರೈತರೇ, ರೋದಿಸಿರಿ,</para>
  <para style="q2" vid="JOL 1:11">ತೋಟಗಾರರೇ, ಪರಿತಪಿಸಿರಿ;</para>
  <para style="q1" vid="JOL 1:11">ಗೋಧಿ ಮತ್ತು ಜವೆಗೋಧಿಗಾಗಿ ದುಃಖಿಸಿ;</para>
  <para style="q2" vid="JOL 1:11">ಏಕೆಂದರೆ ಹೊಲದ ಬೆಳೆ ನಾಶವಾಗಿದೆ.<verse eid="JOL 1:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="JOL 1:12"/>ದ್ರಾಕ್ಷಾಲತೆ ಒಣಗಿದೆ;</para>
  <para style="q2" vid="JOL 1:12">ಅಂಜೂರದ ಗಿಡ ಬಾಡಿ ಹೋಗಿದೆ;</para>
  <para style="q1" vid="JOL 1:12">ದಾಳಿಂಬೆ, ಖರ್ಜೂರ, ಸೇಬು ಮುಂತಾದ ಫಲವೃಕ್ಷಗಳು ಒಣಗಿ ಬೆಂಡಾಗಿವೆ.</para>
  <para style="q2" vid="JOL 1:12">ನರಮಾನವರು ಸೊರಗಿ ಸಂತೋಷವಿಲ್ಲದೆ ಸಪ್ಪೆಯಾಗಿದ್ದಾರೆ.<verse eid="JOL 1:12"/></para>
  <para style="s1">ಪ್ರಲಾಪಕ್ಕೆ ಕರೆ</para>
  <para style="q1">
    <verse number="13" style="v" sid="JOL 1:13"/>ಯಾಜಕರೇ, ಗೋಣಿತಟ್ಟು ಕಟ್ಟಿಕೊಂಡು ಗೋಳಾಡಿರಿ.</para>
  <para style="q2" vid="JOL 1:13">ಬಲಿಪೀಠದ ಸೇವಕರೇ, ಗೋಳಾಡಿರಿ.</para>
  <para style="q1" vid="JOL 1:13">ನನ್ನ ದೇವರ ಸೇವಕರೇ,</para>
  <para style="q2" vid="JOL 1:13">ಬಂದು ಗೋಣಿತಟ್ಟಿನಲ್ಲಿ ರಾತ್ರಿಯೆಲ್ಲಾ ಕಳೆಯಿರಿ.</para>
  <para style="q1" vid="JOL 1:13">ಏಕೆಂದರೆ, ಧಾನ್ಯ ಸಮರ್ಪಣೆಯೂ ಪಾನಾರ್ಪಣೆಯೂ</para>
  <para style="q2" vid="JOL 1:13">ನಿಮ್ಮ ದೇವರ ಆಲಯದಿಂದ ನಿಂತುಹೋಗಿವೆ.<verse eid="JOL 1:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="JOL 1:14"/>ಪವಿತ್ರ ಉಪವಾಸವನ್ನು ಘೋಷಿಸಿರಿ.</para>
  <para style="q2" vid="JOL 1:14">ಪವಿತ್ರ ಸಭೆಯನ್ನು ಕರೆಯಿರಿ.</para>
  <para style="q1" vid="JOL 1:14">ಹಿರಿಯರನ್ನೂ ದೇಶದ ನಿವಾಸಿಗಳೆಲ್ಲರನ್ನೂ</para>
  <para style="q2" vid="JOL 1:14">ನಿಮ್ಮ ಯೆಹೋವ ದೇವರ ಆಲಯದಲ್ಲಿ ಕೂಡಿಸಿ,</para>
  <para style="q2" vid="JOL 1:14">ಯೆಹೋವ ದೇವರಿಗೆ ಮೊರೆಯಿಡಿರಿ.<verse eid="JOL 1:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="JOL 1:15"/>ಆ ದಿನ ಭಯಂಕರವಾದದ್ದು!</para>
  <para style="q2" vid="JOL 1:15">ಏಕೆಂದರೆ ಯೆಹೋವ ದೇವರ ದಿವಸವು ಸಮೀಪವಾಗಿದೆ.</para>
  <para style="q2" vid="JOL 1:15">ಸರ್ವಶಕ್ತರ ಕಡೆಯಿಂದ ಇದು ನಾಶವಾದಂತೆ ಬರುವುದು.<verse eid="JOL 1:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="JOL 1:16"/>ನಮ್ಮ ಕಣ್ಣೆದುರೇ</para>
  <para style="q2" vid="JOL 1:16">ಆಹಾರವು ಹಾಳಾಯಿತಲ್ಲಾ.</para>
  <para style="q1" vid="JOL 1:16">ಸಂತೋಷವೂ ಉಲ್ಲಾಸವೂ</para>
  <para style="q2" vid="JOL 1:16">ನಮ್ಮ ದೇವರ ಆಲಯವನ್ನು ಬಿಟ್ಟುಹೋಯಿತಲ್ಲವೇ?<verse eid="JOL 1:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="JOL 1:17"/>ಬೀಜಗಳು ಹೆಂಟೆಗಳ ಕೆಳಗೆ ಕೆಟ್ಟು ಹೋಗಿವೆ.</para>
  <para style="q2" vid="JOL 1:17">ಉಗ್ರಾಣಗಳು ನಾಶವಾಗಿವೆ.</para>
  <para style="q1" vid="JOL 1:17">ಕಣಜಗಳು ಕುಸಿದುಬಿದ್ದಿವೆ.</para>
  <para style="q2" vid="JOL 1:17">ಏಕೆಂದರೆ ಧಾನ್ಯವು ಒಣಗಿದೆ.<verse eid="JOL 1:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="JOL 1:18"/>ಪಶುಗಳು ನರಳುತ್ತವೆ.</para>
  <para style="q2" vid="JOL 1:18">ದನದ ಹಿಂಡುಗಳು ಕಳವಳಗೊಂಡಿವೆ.</para>
  <para style="q1" vid="JOL 1:18">ಏಕೆಂದರೆ ಅವುಗಳಿಗೆ ಮೇವು ಇಲ್ಲ;</para>
  <para style="q2" vid="JOL 1:18">ಕುರಿಮಂದೆಗಳು ಸಹ ಕಷ್ಟಪಡುತ್ತಲಿವೆ.<verse eid="JOL 1:18"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="JOL 1:19"/>ಯೆಹೋವ ದೇವರೇ, ನಿಮಗೆ ಮೊರೆಯಿಡುತ್ತೇನೆ.</para>
  <para style="q2" vid="JOL 1:19">ಬೆಂಕಿಯು ಹುಲ್ಲುಗಾವಲನ್ನು ದಹಿಸಿಬಿಟ್ಟಿದೆ;</para>
  <para style="q2" vid="JOL 1:19">ಜ್ವಾಲೆಯು ಅಡವಿಯ ಮರಗಳನ್ನೆಲ್ಲಾ ಸುಟ್ಟುಬಿಟ್ಟಿವೆ.<verse eid="JOL 1:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="JOL 1:20"/>ಕಾಡುಮೃಗಗಳು ಸಹ ನಿನ್ನ ಕಡೆಗೆ ತಲೆಯೆತ್ತಿವೆ.</para>
  <para style="q2" vid="JOL 1:20">ನೀರಿನ ಹೊಳೆಗಳು ಬತ್ತಿ ಹೋಗಿವೆ.</para>
  <para style="q2" vid="JOL 1:20">ಹುಲ್ಲುಗಾವಲನ್ನು ಬೆಂಕಿಯು ದಹಿಸಿಬಿಟ್ಟಿದೆ.<verse eid="JOL 1:20"/></para>
  <chapter eid="JOL 1"/>
  <chapter number="2" style="c" sid="JOL 2"/>
  <para style="s1">ಮಿಡತೆಗಳ ಒಂದು ಸೈನ್ಯ</para>
  <para style="q1">
    <verse number="1" style="v" sid="JOL 2:1"/>ನೀವು ಚೀಯೋನಿನಲ್ಲಿ ಕೊಂಬು ಊದಿರಿ.</para>
  <para style="q2" vid="JOL 2:1">ನನ್ನ ಪರಿಶುದ್ಧ ಪರ್ವತದಲ್ಲಿ ಆರ್ಭಟಿಸಿರಿ.</para>
  <para style="b" vid="JOL 2:1"/>
  <para style="q1" vid="JOL 2:1">ದೇಶದ ನಿವಾಸಿಗಳೆಲ್ಲರು ನಡುಗಲಿ.</para>
  <para style="q2" vid="JOL 2:1">ಏಕೆಂದರೆ ಯೆಹೋವ ದೇವರ ದಿವಸವು ಬರುತ್ತದೆ.</para>
  <para style="q1" vid="JOL 2:1">ಅದು ಸಮೀಪವಾಗಿದೆ.<verse eid="JOL 2:1"/></para>
  <para style="q2">
    <verse number="2" style="v" sid="JOL 2:2"/>ಅದು ಕತ್ತಲೆಯೂ ಮಬ್ಬೂ ಉಳ್ಳ ದಿವಸವೂ,</para>
  <para style="q2" vid="JOL 2:2">ಮೇಘವೂ ಕಾರ್ಗತ್ತಲು ಉಳ್ಳ ದಿವಸವೂ ಆಗಿದೆ.</para>
  <para style="q1" vid="JOL 2:2">ಬೆಟ್ಟಗಳ ಮೇಲೆ ಹರಡುವ ಉದಯದ ಹಾಗೆ</para>
  <para style="q2" vid="JOL 2:2">ದೊಡ್ಡ ಬಲವಾದ ಸ್ಯೆನ್ಯವು ಬರುತ್ತದೆ.</para>
  <para style="q1" vid="JOL 2:2">ಅದು ಪ್ರಾಚೀನ ಕಾಲದಲ್ಲಿ ಮತ್ತು</para>
  <para style="q2" vid="JOL 2:2">ಮುಂದಿನ ಯುಗಗಳಲ್ಲಿ ಎಂದಿಗೂ ಇರುವುದಿಲ್ಲ.<verse eid="JOL 2:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="JOL 2:3"/>ಅವುಗಳ ಮುಂದೆ ಬೆಂಕಿ ದಹಿಸುತ್ತದೆ.</para>
  <para style="q2" vid="JOL 2:3">ಅವುಗಳ ಹಿಂದೆ ಜ್ವಾಲೆ ಧಗಧಗಿಸುತ್ತದೆ.</para>
  <para style="q1" vid="JOL 2:3">ಅವುಗಳ ಮುಂದೆ ದೇಶವು ಏದೆನ್ ತೋಟದ ಹಾಗಿದೆ.</para>
  <para style="q2" vid="JOL 2:3">ಅವುಗಳ ಹಿಂದೆ ಕಾಡು ಹಾಳಾಗಿದೆ.</para>
  <para style="q2" vid="JOL 2:3">ಯಾವುದೂ ಅವುಗಳಿಂದ ತಪ್ಪಿಸಿಕೊಳ್ಳುವುದಿಲ್ಲ.<verse eid="JOL 2:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="JOL 2:4"/>ಅವುಗಳ ಆಕಾರವು ಕುದುರೆಗಳ ಆಕಾರದ ಹಾಗಿದೆ.</para>
  <para style="q2" vid="JOL 2:4">ಸವಾರರ ಹಾಗೆಯೇ ಓಡುತ್ತವೆ.<verse eid="JOL 2:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="JOL 2:5"/>ರಥಗಳ ಶಬ್ದದಂತೆ ಅವು ಪರ್ವತಗಳ ತುದಿಗಳಲ್ಲಿ ಹಾರುತ್ತವೆ.</para>
  <para style="q2" vid="JOL 2:5">ಸಿಡಿಯುವ ಬೆಂಕಿಯು ದಹಿಸುವ ಕೋಲಿನಂತೆ,</para>
  <para style="q1" vid="JOL 2:5">ಯುದ್ಧಕ್ಕೆ ಸಿದ್ಧವಾದ ಬಲವುಳ್ಳ ಸೈನ್ಯದ ಹಾಗೆಯೂ ಇವೆ.<verse eid="JOL 2:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="JOL 2:6"/>ಅವುಗಳ ಮುಂದೆ ಜನಾಂಗಗಳು ಬಹಳವಾಗಿ ನೊಂದುಕೊಳ್ಳುತ್ತವೆ.</para>
  <para style="q2" vid="JOL 2:6">ಎಲ್ಲಾ ಮುಖಗಳು ಕಳೆಗುಂದುತ್ತವೆ.<verse eid="JOL 2:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="JOL 2:7"/>ಶೂರರ ಹಾಗೆ ಓಡುತ್ತವೆ.</para>
  <para style="q2" vid="JOL 2:7">ಯುದ್ಧಶಾಲಿಗಳ ಹಾಗೆ ಗೋಡೆ ಏರುತ್ತವೆ.</para>
  <para style="q1" vid="JOL 2:7">ಅವೆಲ್ಲಾ ಸಾಲಾಗಿ ಮುನ್ನಡೆಯುತ್ತವೆ.</para>
  <para style="q2" vid="JOL 2:7">ತಮ್ಮ ಹಾದಿಗಳನ್ನು ಬದಲು ಮಾಡುವುದಿಲ್ಲ.<verse eid="JOL 2:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="JOL 2:8"/>ಒಂದು ಇನ್ನೊಂದನ್ನು ನೂಕುವುದಿಲ್ಲ.</para>
  <para style="q2" vid="JOL 2:8">ಅವುಗಳಲ್ಲಿ ಪ್ರತಿಯೊಂದು</para>
  <para style="q1" vid="JOL 2:8">ತನ್ನ ತನ್ನ ದಾರಿಯಲ್ಲಿ ಮುನ್ನಡೆಯುತ್ತವೆ.</para>
  <para style="q2" vid="JOL 2:8">ತಮ್ಮ ಸ್ಥಾನಗಳನ್ನು ಬಿಟ್ಟುಕೊಡದೆ ಯುದ್ಧ ಮಾಡುತ್ತವೆ.<verse eid="JOL 2:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="JOL 2:9"/>ಪಟ್ಟಣದಲ್ಲಿ ಅತ್ತಿತ್ತ ತಿರುಗಾಡುತ್ತವೆ.</para>
  <para style="q2" vid="JOL 2:9">ಗೋಡೆಯ ಮೇಲೆ ಓಡುತ್ತವೆ.</para>
  <para style="q1" vid="JOL 2:9">ಅವು ಮನೆಗಳನ್ನು ಹತ್ತಿ,</para>
  <para style="q2" vid="JOL 2:9">ಕಳ್ಳನ ಹಾಗೆ ಕಿಟಿಕಿಗಳಿಂದ ಪ್ರವೇಶಿಸುತ್ತವೆ.<verse eid="JOL 2:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="JOL 2:10"/>ಅವುಗಳ ಮುಂದೆ ಭೂಮಿಯು ನಡುಗುತ್ತದೆ.</para>
  <para style="q2" vid="JOL 2:10">ಆಕಾಶಗಳು ಅದರುತ್ತವೆ.</para>
  <para style="q1" vid="JOL 2:10">ಸೂರ್ಯ ಚಂದ್ರರು ಕಪ್ಪಾಗುತ್ತವೆ.</para>
  <para style="q2" vid="JOL 2:10">ನಕ್ಷತ್ರಗಳು ಇನ್ನು ಮುಂದೆ ಹೊಳೆಯುವುದಿಲ್ಲ.<verse eid="JOL 2:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="JOL 2:11"/>ಯೆಹೋವ ದೇವರು ತಮ್ಮ ಸೈನ್ಯಕ್ಕೆ</para>
  <para style="q2" vid="JOL 2:11">ಗುಡುಗಿನಂತೆ ಆಜ್ಞಾಪಿಸುತ್ತಾರೆ.</para>
  <para style="q1" vid="JOL 2:11">ಅವರ ಸೈನ್ಯ ಬಹು ದೊಡ್ಡದಾಗಿದೆ.</para>
  <para style="q2" vid="JOL 2:11">ಅವರ ಆಜ್ಞೆಯನ್ನು ಪಾಲಿಸುವವನು ಪರಾಕ್ರಮಿಯು.</para>
  <para style="q1" vid="JOL 2:11">ಯೆಹೋವ ದೇವರ ದಿವಸವು ದೊಡ್ಡದು,</para>
  <para style="q2" vid="JOL 2:11">ಮಹಾ ಭಯಂಕರವಾದದ್ದು.</para>
  <para style="q2" vid="JOL 2:11">ಅದನ್ನು ಸಹಿಸಿಕೊಳ್ಳುವವರು ಯಾರು?<verse eid="JOL 2:11"/></para>
  <para style="s1">ನಿಮ್ಮ ಹೃದಯಗಳನ್ನು ಹರಿದುಕೊಳ್ಳಿರಿ</para>
  <para style="q1">
    <verse number="12" style="v" sid="JOL 2:12"/>ಯೆಹೋವ ದೇವರು ಹೀಗೆ ಘೋಷಿಸುತ್ತಾರೆ, “ಈಗಲಾದರೂ</para>
  <para style="q2" vid="JOL 2:12">ಉಪವಾಸದಿಂದಲೂ ಅಳುವಿಕೆಯಿಂದಲೂ ಗೋಳಾಟದಿಂದಲೂ</para>
  <para style="q2" vid="JOL 2:12">ನಿಮ್ಮ ಪೂರ್ಣಹೃದಯದಿಂದ ನನ್ನ ಕಡೆಗೆ ತಿರುಗಿಕೊಳ್ಳಿರಿ.”<verse eid="JOL 2:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="JOL 2:13"/>ನಿಮ್ಮ ಬಟ್ಟೆಗಳನ್ನಲ್ಲ,</para>
  <para style="q2" vid="JOL 2:13">ನಿಮ್ಮ ಹೃದಯಗಳನ್ನು ಹರಿದುಕೊಂಡು,</para>
  <para style="q1" vid="JOL 2:13">ನಿಮ್ಮ ದೇವರಾದ ಯೆಹೋವ ದೇವರ ಕಡೆಗೆ ತಿರುಗಿಕೊಳ್ಳಿರಿ.</para>
  <para style="q2" vid="JOL 2:13">ಅವರು ದಯೆಯೂ ಕರುಣೆಯೂ,</para>
  <para style="q1" vid="JOL 2:13">ದೀರ್ಘಶಾಂತಿಯೂ ಮಹಾ ಪ್ರೀತಿಯೂ</para>
  <para style="q2" vid="JOL 2:13">ಉಳ್ಳವರಾಗಿ ಮಾಡಬೇಕೆಂದಿರುವ ಕೇಡಿಗೆ ಮನಮರುಗುತ್ತಾರೆ.<verse eid="JOL 2:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="JOL 2:14"/>ದೇವರು ಒಂದು ವೇಳೆ ತಮ್ಮ ಮನಸ್ಸನ್ನು ಬದಲಾಯಿಸಬಹುದು.</para>
  <para style="q2" vid="JOL 2:14">ನಿಮ್ಮ ಕಡೆಗೆ ತಿರುಗಿಕೊಂಡು ನಿಮ್ಮನ್ನು ಆಶೀರ್ವದಿಸಬಹುದು.</para>
  <para style="q1" vid="JOL 2:14">ನಿಮ್ಮ ಯೆಹೋವ ದೇವರಿಗೆ ಅರ್ಪಿಸಲು ಬೇಕಾದ ಧಾನ್ಯ ಸಮರ್ಪಣೆ ಹಾಗು ಪಾನಾರ್ಪಣೆಯನ್ನು</para>
  <para style="q2" vid="JOL 2:14">ನಿಮಗೆ ಧಾರಾಳವಾಗಿ ಉಳಿಸಬಹುದು, ಯಾರಿಗೆ ಗೊತ್ತು?<verse eid="JOL 2:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="JOL 2:15"/>ಚೀಯೋನಿನಲ್ಲಿ ಕೊಂಬು ಊದಿರಿ;</para>
  <para style="q2" vid="JOL 2:15">ಪವಿತ್ರ ಉಪವಾಸವನ್ನು ಸಾರಿರಿ;</para>
  <para style="q2" vid="JOL 2:15">ಪವಿತ್ರ ಸಭೆಯನ್ನು ಕರೆಯಿರಿ.<verse eid="JOL 2:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="JOL 2:16"/>ಜನರನ್ನು ಕೂಡಿಸಿರಿ;</para>
  <para style="q2" vid="JOL 2:16">ಸಭೆಯನ್ನು ಪವಿತ್ರಗೊಳಿಸಿರಿ;</para>
  <para style="q1" vid="JOL 2:16">ಹಿರಿಯರನ್ನು ಒಟ್ಟುಗೂಡಿಸಿರಿ,</para>
  <para style="q2" vid="JOL 2:16">ಮಕ್ಕಳನ್ನೂ ಹಸುಗೂಸುಗಳನ್ನೂ ಕೂಡಿಸಿರಿ;</para>
  <para style="q1" vid="JOL 2:16">ಮದುಮಗನು ತನ್ನ ಕೊಠಡಿಯೊಳಗಿಂದಲೂ</para>
  <para style="q2" vid="JOL 2:16">ಮದುಮಗಳು ತನ್ನ ಕೊಠಡಿಯೊಳಗಿಂದಲೂ ಹೊರಡಲಿ.<verse eid="JOL 2:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="JOL 2:17"/>ಯೆಹೋವ ದೇವರ ಸಮ್ಮುಖ ಸೇವಕರಾದ ಯಾಜಕರು,</para>
  <para style="q2" vid="JOL 2:17">ಅಂಗಳಕ್ಕೂ, ಬಲಿಪೀಠಕ್ಕೂ ನಡುವೆ ಅತ್ತು ಹೀಗೆ ಹೇಳಲಿ,</para>
  <para style="q1" vid="JOL 2:17">“ಯೆಹೋವ ದೇವರೇ, ನಿನ್ನ ಜನರನ್ನು ಕನಿಕರಿಸು,</para>
  <para style="q2" vid="JOL 2:17">ಜನಾಂಗಗಳು ನಿಂದಿಸುವುದಕ್ಕೆ ನಿನ್ನ ಬಾಧ್ಯತೆಯನ್ನು</para>
  <para style="q2" vid="JOL 2:17">ದೂಷಣೆಗೆ ಗುರಿಮಾಡಬೇಡಿರಿ.</para>
  <para style="q1" vid="JOL 2:17">‘ಅವರ ದೇವರು ಎಲ್ಲಿ?’</para>
  <para style="q2" vid="JOL 2:17">ಎಂದು ಅವರು ಏಕೆ ನಿಂದಿಸಬೇಕು?”<verse eid="JOL 2:17"/></para>
  <para style="s1">ಯೆಹೋವ ದೇವರ ಉತ್ತರ</para>
  <para style="q1">
    <verse number="18" style="v" sid="JOL 2:18"/>ಆಗ ಯೆಹೋವ ದೇವರು ತಮ್ಮ ದೇಶಕ್ಕೋಸ್ಕರ ಅಭಿಮಾನಗೊಂಡು,</para>
  <para style="q2" vid="JOL 2:18">ತಮ್ಮ ಜನರನ್ನು ಕನಿಕರಿಸುವರು.<verse eid="JOL 2:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="JOL 2:19"/>ಯೆಹೋವ ದೇವರು ತನ್ನ ಜನರಿಗೆ ಉತ್ತರಕೊಟ್ಟು,</para>
  <para style="q1" vid="JOL 2:19">ನಾನು ನಿಮಗೆ ಧಾನ್ಯವನ್ನೂ, ದ್ರಾಕ್ಷಾರಸವನ್ನೂ, ಎಣ್ಣೆಯನ್ನೂ</para>
  <para style="q2" vid="JOL 2:19">ನಿಮಗೆ ಸಾಕಾಗುವಷ್ಟು ಕಳುಹಿಸಿ,</para>
  <para style="q1" vid="JOL 2:19">ನಿಮ್ಮನ್ನು ಇನ್ನು ಮೇಲೆ</para>
  <para style="q2" vid="JOL 2:19">ಜನಾಂಗಗಳಲ್ಲಿ ನಿಂದಿತರಾಗಿ ಇಡುವುದಿಲ್ಲ.<verse eid="JOL 2:19"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="20" style="v" sid="JOL 2:20"/>“ಉತ್ತರ ದಿಕ್ಕಿನ ಸೈನ್ಯವನ್ನು ನಿಮ್ಮಿಂದ ದೂರಮಾಡಿ,</para>
  <para style="q2" vid="JOL 2:20">ಅದನ್ನು ಹಾಳುಬಿದ್ದ ಬಂಜರು ಭೂಮಿಗೂ,</para>
  <para style="q1" vid="JOL 2:20">ಅದರ ಮುಂಭಾಗವನ್ನು ಪೂರ್ವದ ಉಪ್ಪು ಸಮುದ್ರಕ್ಕೂ</para>
  <para style="q2" vid="JOL 2:20">ಅದರ ಹಿಂಭಾಗವನ್ನು ಪಶ್ಚಿಮದ ಮೆಡಿಟರೇನಿಯನ್ ಸಮುದ್ರಕ್ಕೂ ಓಡಿಸಿಬಿಡುವೆನು.</para>
  <para style="q1" vid="JOL 2:20">ಅದರ ದುರ್ವಾಸನೆಯು ಏರುವುದು.</para>
  <para style="q2" vid="JOL 2:20">ಅದು ಗಬ್ಬು ನಾರುವುದು.”</para>
  <para style="b" vid="JOL 2:20"/>
  <para style="q1" vid="JOL 2:20">ಏಕೆಂದರೆ, ಆತನು ಮಹಾಕಾರ್ಯಗಳನ್ನು ಮಾಡಿದ್ದಾರೆ.<verse eid="JOL 2:20"/></para>
  <para style="q2">
    <verse number="21" style="v" sid="JOL 2:21"/>ಯಹೂದ ದೇಶವೇ, ಭಯಪಡಬೇಡ;</para>
  <para style="q2" vid="JOL 2:21">ಉಲ್ಲಾಸಿಸಿ, ಸಂತೋಷವಾಗಿರು.</para>
  <para style="q1" vid="JOL 2:21">ಏಕೆಂದರೆ, ಯೆಹೋವ ದೇವರು ಮಹತ್ತಾದವುಗಳನ್ನು ಮಾಡಿದ್ದಾರೆ.<verse eid="JOL 2:21"/></para>
  <para style="q2">
    <verse number="22" style="v" sid="JOL 2:22"/>ಕಾಡುಮೃಗಗಳೇ, ಭಯಪಡಬೇಡಿರಿ.</para>
  <para style="q2" vid="JOL 2:22">ಏಕೆಂದರೆ, ಅಡವಿಯ ಮೇವಿನ ಸ್ಥಳಗಳು ಮೊಳೆಯುತ್ತವೆ.</para>
  <para style="q1" vid="JOL 2:22">ಮರಗಳು ತಮ್ಮ ಫಲವನ್ನು ಫಲಿಸುತ್ತವೆ.</para>
  <para style="q2" vid="JOL 2:22">ಅಂಜೂರದ ಗಿಡವೂ ದ್ರಾಕ್ಷಿ ಬಳ್ಳಿಯೂ ತಮ್ಮ ಫಲವನ್ನು ಕೊಡುತ್ತವೆ.<verse eid="JOL 2:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="JOL 2:23"/>ಚೀಯೋನಿನ ಜನರೇ,</para>
  <para style="q2" vid="JOL 2:23">ನಿಮ್ಮ ದೇವರಾದ ಯೆಹೋವ ದೇವರಲ್ಲಿ ಉಲ್ಲಾಸಿಸಿರಿ, ಸಂತೋಷವಾಗಿರಿ.</para>
  <para style="q1" vid="JOL 2:23">ಏಕೆಂದರೆ ನಿಮಗೆ ಮುಂಗಾರು ಮಳೆಯನ್ನು</para>
  <para style="q2" vid="JOL 2:23">ಸಾಕಷ್ಟು ಕೊಡುವರು.</para>
  <para style="q1" vid="JOL 2:23">ಮುಂಗಾರು, ಹಿಂಗಾರು ಮಳೆಗಳನ್ನು ಮೊದಲಿನ ಹಾಗೆ</para>
  <para style="q2" vid="JOL 2:23">ನಿಮಗೆ ಸುರಿಸುವರು.<verse eid="JOL 2:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="JOL 2:24"/>ಕಣಗಳು ಧಾನ್ಯದಿಂದ ತುಂಬುವುವು.</para>
  <para style="q2" vid="JOL 2:24">ತೊಟ್ಟಿಗಳು ದ್ರಾಕ್ಷಾರಸದಿಂದಲೂ ಎಣ್ಣೆಯಿಂದಲೂ ತುಂಬಿ ತುಳುಕುವುವು.<verse eid="JOL 2:24"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="25" style="v" sid="JOL 2:25"/>“ನಾನು ನಿಮ್ಮಲ್ಲಿ ಕಳುಹಿಸಿದಂಥ ನನ್ನ ದೊಡ್ಡ ಸೈನ್ಯವಾದ ಮಿಡತೆಗಳು,</para>
  <para style="q2" vid="JOL 2:25">ಗುಂಪು ಮಿಡತೆಗಳು, ಕಂಬಳಿ ಮಿಡತೆಗಳು,</para>
  <para style="q2" vid="JOL 2:25">ಚೂರಿ ಮಿಡತೆಗಳು ತಿಂದು ಬಿಟ್ಟ ವರ್ಷಗಳನ್ನು</para>
  <para style="q1" vid="JOL 2:25">ನಿಮಗೆ ಪುನಃಸ್ಥಾಪಿಸಿ ಕೊಡುವೆನು.<verse eid="JOL 2:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="JOL 2:26"/>ಸಮೃದ್ಧಿಯಾಗಿ ಉಂಡು, ತೃಪ್ತಿಪಟ್ಟು,</para>
  <para style="q2" vid="JOL 2:26">ನಿಮ್ಮನ್ನು ಅದ್ಭುತವಾಗಿ ನಡೆಸಿದ</para>
  <para style="q2" vid="JOL 2:26">ನಿಮ್ಮ ದೇವರಾದ ಯೆಹೋವ ದೇವರ ಹೆಸರನ್ನು ಸ್ತುತಿಸುವಿರಿ.</para>
  <para style="q1" vid="JOL 2:26">ನನ್ನ ಜನರು ಎಂದೆಂದಿಗೂ ನಾಚಿಕೆಪಡರು.<verse eid="JOL 2:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="JOL 2:27"/>ನಾನೇ ಇಸ್ರಾಯೇಲಿನ ಮಧ್ಯೆ ನೆಲೆಯಾಗಿ ಇರುವವನು.</para>
  <para style="q2" vid="JOL 2:27">ನಾನೇ ನಿಮ್ಮ ಯೆಹೋವ ದೇವರು,</para>
  <para style="q2" vid="JOL 2:27">ನಾನಲ್ಲದೆ ಬೇರೆ ದೇವರು ನಿಮಗಿಲ್ಲ.</para>
  <para style="q1" vid="JOL 2:27">ನನ್ನ ಜನರು ಎಂದಿಗೂ ನಾಚಿಕೆಪಡರು.<verse eid="JOL 2:27"/></para>
  <para style="s1">ಯೆಹೋವ ದೇವರ ದಿನ</para>
  <para style="q1">
    <verse number="28" style="v" sid="JOL 2:28"/>“ಆಮೇಲೆ ನಾನು,</para>
  <para style="q2" vid="JOL 2:28">ನನ್ನ ಆತ್ಮನನ್ನು ಎಲ್ಲಾ ಮನುಷ್ಯರ ಮೇಲೆ ಸುರಿಸುವೆನು,</para>
  <para style="q1" vid="JOL 2:28">ನಿಮ್ಮ ಗಂಡು ಹೆಣ್ಣುಮಕ್ಕಳು ಪ್ರವಾದಿಸುವರು.</para>
  <para style="q2" vid="JOL 2:28">ನಿಮ್ಮ ಹಿರಿಯರಿಗೆ ಕನಸುಗಳು ಬೀಳುವುವು.</para>
  <para style="q2" vid="JOL 2:28">ನಿಮ್ಮ ಯುವಜನರಿಗೆ ದರ್ಶನಗಳಾಗುವವು.<verse eid="JOL 2:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="JOL 2:29"/>ಆ ದಿನಗಳಲ್ಲಿ, ನನ್ನ ದಾಸ ದಾಸಿಯರ ಮೇಲೆ,</para>
  <para style="q2" vid="JOL 2:29">ನನ್ನ ಆತ್ಮವನ್ನು ಸುರಿಸುವೆನು.<verse eid="JOL 2:29"/></para>
  <para style="q1">
    <verse number="30" style="v" sid="JOL 2:30"/>ಆಕಾಶಗಳಲ್ಲಿ ಮತ್ತು ಭೂಮಿಯಲ್ಲಿ ಅದ್ಭುತಗಳನ್ನು,</para>
  <para style="q2" vid="JOL 2:30">ರಕ್ತ, ಬೆಂಕಿ, ಹಬೆಯನ್ನು ತೋರಿಸುವೆನು.<verse eid="JOL 2:30"/></para>
  <para style="q1">
    <verse number="31" style="v" sid="JOL 2:31"/>ಯೆಹೋವ ದೇವರ ಭಯಂಕರವಾದ ಮಹಾದಿನವು ಬರುವುದಕ್ಕಿಂತ ಮೊದಲು,</para>
  <para style="q2" vid="JOL 2:31">ಸೂರ್ಯನು ಕತ್ತಲಾಗುವನು,</para>
  <para style="q2" vid="JOL 2:31">ಚಂದ್ರನು ರಕ್ತವಾಗುವನು.<verse eid="JOL 2:31"/></para>
  <para style="q1">
    <verse number="32" style="v" sid="JOL 2:32"/>ಯೆಹೋವ ದೇವರ ಹೆಸರನ್ನು</para>
  <para style="q2" vid="JOL 2:32">ಕರೆಯುವವರೆಲ್ಲರಿಗೆ ರಕ್ಷಣೆ ಆಗುವುದು.</para>
  <para style="q1" vid="JOL 2:32">ಏಕೆಂದರೆ ಚೀಯೋನ್ ಪರ್ವತದಲ್ಲಿಯೂ ಯೆರೂಸಲೇಮಿನಲ್ಲಿಯೂ</para>
  <para style="q2" vid="JOL 2:32">ಅನೇಕರಿಗೆ ಮುಕ್ತಿ ದೊರಕುವುದು.</para>
  <para style="q1" vid="JOL 2:32">ಯೆಹೋವ ದೇವರು ಹೇಳಿದ ಪ್ರಕಾರ</para>
  <para style="q2" vid="JOL 2:32">ಯೆಹೋವ ದೇವರ ಕರೆಹೊಂದಿ ಉಳಿದವರಲ್ಲಿಯೂ ಬಿಡುಗಡೆ ಇರುವುದು.<verse eid="JOL 2:32"/></para>
  <chapter eid="JOL 2"/>
  <chapter number="3" style="c" sid="JOL 3"/>
  <para style="s1">ಜನಾಂಗಗಳ ನ್ಯಾಯತೀರ್ಪು</para>
  <para style="q1">
    <verse number="1" style="v" sid="JOL 3:1"/>“ಆ ದಿವಸಗಳಲ್ಲಿಯೂ, ಆ ಸಮಯದಲ್ಲಿಯೂ</para>
  <para style="q2" vid="JOL 3:1">ನಾನು ಯೆಹೂದ ಮತ್ತು ಯೆರೂಸಲೇಮಿನ ಸಿರಿಸಂಪತ್ತನ್ನು ಪುನಃ ಸ್ಥಾಪಿಸುವಾಗ,<verse eid="JOL 3:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="JOL 3:2"/>ನಾನು ಎಲ್ಲಾ ಜನಾಂಗಗಳನ್ನು ಕೂಡಿಸುವೆನು.</para>
  <para style="q2" vid="JOL 3:2">ಯೆಹೋಷಾಫಾಟನ<note caller="+" style="f"><char style="fr" closed="false">3:2 </char><char style="fq" closed="false">ಯೆಹೋಷಾಫಾಟ </char><char style="ft" closed="false">ಇದರ ಅರ್ಥ </char><char style="fqa" closed="false">ಯೆಹೋವ ದೇವರು ನ್ಯಾಯತೀರ್ಪು ಮಾಡುತ್ತಾರೆ</char></note> ತಗ್ಗಿಗೆ ಅವರನ್ನು ತರುವೆನು.</para>
  <para style="q1" vid="JOL 3:2">ಅಲ್ಲಿ ನನ್ನ ಜನರೂ ನನ್ನ ಬಾಧ್ಯತೆಯೂ ಆಗಿರುವ ಇಸ್ರಾಯೇಲಿನ ವಿಷಯವಾಗಿ</para>
  <para style="q2" vid="JOL 3:2">ಅವರ ಸಂಗಡ ವ್ಯಾಜ್ಯವಾಡುವೆನು.</para>
  <para style="q1" vid="JOL 3:2">ಅವರು ಅವರನ್ನು ಜನಾಂಗಗಳಲ್ಲಿ ಚದುರಿಸಿ,</para>
  <para style="q2" vid="JOL 3:2">ನನ್ನ ದೇಶವನ್ನು ಹಂಚಿಕೊಂಡರು.<verse eid="JOL 3:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="JOL 3:3"/>ನನ್ನ ಜನರಿಗೋಸ್ಕರ ಚೀಟುಹಾಕಿ,</para>
  <para style="q2" vid="JOL 3:3">ಬಾಲಕರನ್ನು ವೇಶ್ಯಾ ವೃತ್ತಿಗೆ ಕೊಟ್ಟು,</para>
  <para style="q2" vid="JOL 3:3">ಬಾಲಕಿಯರನ್ನು ಕುಡಿಯುವ ದ್ರಾಕ್ಷಾರಸಕ್ಕಾಗಿ ಮಾರಿದ್ದಾರೆ.<verse eid="JOL 3:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="JOL 3:4"/>“ಟೈರೇ, ಸೀದೋನೇ, ಫಿಲಿಷ್ಟಿಯದ ಎಲ್ಲಾ ಪ್ರಾಂತ್ಯಗಳೇ, ನನ್ನ ವಿರೋಧವಾಗಿ ನಿಮಗೆ ಏನು ಇದೆ? ನನಗೆ ಮುಯ್ಯಿಗೆ ಮುಯ್ಯಿ ಸಲ್ಲಿಸುವಿರೋ? ನೀವು ಮುಯ್ಯಿ ನನಗೆ ಸಲ್ಲಿಸಿದರೆ, ಜಾಗ್ರತೆಯಾಗಿಯೂ ತ್ವರೆಯಾಗಿಯೂ ನಿಮ್ಮ ತಲೆಯ ಮೇಲೆ ಮುಯ್ಯಿಗೆ ಮುಯ್ಯಿ ತರಿಸುವೆನು. <verse eid="JOL 3:4"/><verse number="5" style="v" sid="JOL 3:5"/>ನೀವು ನನ್ನ ಬೆಳ್ಳಿಯನ್ನೂ ನನ್ನ ಬಂಗಾರವನ್ನೂ, ನನ್ನ ಅತ್ಯುತ್ತಮ ಸಂಪತ್ತನ್ನೂ ನಿಮ್ಮ ದೇವಸ್ಥಾನಗಳಿಗೆ ತೆಗೆದುಕೊಂಡು ಹೋಗಿದ್ದಿರಿ. <verse eid="JOL 3:5"/><verse number="6" style="v" sid="JOL 3:6"/>ಯೆಹೂದದ ಹಾಗೂ ಯೆರೂಸಲೇಮಿನ ಜನರನ್ನು ಅವರ ಪ್ರಾಂತಗಳಿಂದ ದೂರ ಮಾಡುವುದಕ್ಕಾಗಿ ಗ್ರೀಕರಿಗೆ ಮಾರಿದ್ದೀರಿ.<verse eid="JOL 3:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="JOL 3:7"/>“ಇಗೋ, ಎಲ್ಲಿ ಅವರನ್ನು ಮಾರಿದಿರೋ, ಆ ಸ್ಥಳದಿಂದ ನಾನು ಅವರನ್ನು ಎಬ್ಬಿಸಿ, ನಿಮ್ಮ ತಲೆಯ ಮೇಲೆ ಮುಯ್ಯಿಗೆ ಮುಯ್ಯಿತೀರಿಸುವೆನು. <verse eid="JOL 3:7"/><verse number="8" style="v" sid="JOL 3:8"/>ನಿಮ್ಮ ಪುತ್ರರನ್ನೂ ನಿಮ್ಮ ಪುತ್ರಿಯರನ್ನೂ ಯೆಹೂದದ ಜನರಿಗೆ ಮಾರುವೆನು. ಇವರು ಅವರನ್ನು ದೂರ ಜನವಾದ ಶೆಬದವರಿಗೆ ಮಾರುವರು.” ಯೆಹೋವ ದೇವರು ಇದನ್ನು ಹೇಳಿದ್ದಾರೆ.<verse eid="JOL 3:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="JOL 3:9"/>ಜನಾಂಗಗಳಲ್ಲಿ ಇದನ್ನು ಘೋಷಿಸಿರಿ;</para>
  <para style="q2" vid="JOL 3:9">ಯುದ್ಧಕ್ಕೆ ಇದನ್ನು ಸಿದ್ಧಮಾಡಿರಿ;</para>
  <para style="q1" vid="JOL 3:9">ಶೂರರನ್ನು ಎಬ್ಬಿಸಿರಿ;</para>
  <para style="q2" vid="JOL 3:9">ಯುದ್ಧಭಟರೆಲ್ಲರು ಸಮೀಪಿಸಿ ಬರಲಿ.<verse eid="JOL 3:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="JOL 3:10"/>ನಿಮ್ಮ ನೇಗಿಲುಗಳ ಗುಳಗಳನ್ನು ಖಡ್ಗಗಳನ್ನಾಗಿಯೂ</para>
  <para style="q2" vid="JOL 3:10">ನಿಮ್ಮ ಕುಡುಗೋಲುಗಳನ್ನು ಈಟಿಗಳನ್ನಾಗಿಯೂ ಬಡಿಯಿರಿ</para>
  <para style="q1" vid="JOL 3:10">ಬಲಹೀನನು ಸಹ</para>
  <para style="q2" vid="JOL 3:10">ನಾನು ಶಕ್ತಿವಂತನು ಎಂದು ಹೇಳಲಿ.<verse eid="JOL 3:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="JOL 3:11"/>ಸುತ್ತಲಿನ ಎಲ್ಲಾ ರಾಷ್ಟ್ರಗಳೇ,</para>
  <para style="q2" vid="JOL 3:11">ಸಭೆಯಾಗಿ ಕೂಡಿಕೊಳ್ಳಿರಿ.</para>
  <para style="b" vid="JOL 3:11"/>
  <para style="q1" vid="JOL 3:11">ಯೆಹೋವ ದೇವರೇ, ನಿನ್ನ ಶೂರರನ್ನು ಕೆಳಗೆ ಇಳಿಸಿರಿ.<verse eid="JOL 3:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="JOL 3:12"/>ಜನಾಂಗಗಳು ಎಚ್ಚೆತ್ತು</para>
  <para style="q2" vid="JOL 3:12">ಯೆಹೋಷಾಫಾಟನ ಕಣಿವೆಗೆ ಇಳಿಯಲಿ.</para>
  <para style="q1" vid="JOL 3:12">ಸುತ್ತಮುತ್ತ ನೆರೆದಿರುವ ಜನಾಂಗಗಳಿಗೆ ನ್ಯಾಯತೀರಿಸಲು</para>
  <para style="q2" vid="JOL 3:12">ಅಲ್ಲಿ ನಾನು ಆಸೀನನಾಗಿರುವೆನು.<verse eid="JOL 3:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="JOL 3:13"/>ಕುಡುಗೋಲನ್ನು ಹಾಕಿರಿ.</para>
  <para style="q2" vid="JOL 3:13">ಏಕೆಂದರೆ ಬೆಳೆ ಪಕ್ವವಾಯಿತು.</para>
  <para style="q1" vid="JOL 3:13">ಬಂದು ಇಳಿಯಿರಿ. ಏಕೆಂದರೆ ದ್ರಾಕ್ಷಿಯ ಆಲೆ ತುಂಬಿ ಇದೆ.</para>
  <para style="q2" vid="JOL 3:13">ತೊಟ್ಟಿಗಳು ತುಳುಕುವಂತೆ</para>
  <para style="q2" vid="JOL 3:13">ಅವರ ಕೆಟ್ಟತನವು ಬಹಳವಾಗಿದೆ.<verse eid="JOL 3:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="JOL 3:14"/>ತೀರ್ಮಾನದ ಕಣಿವೆಯಲ್ಲಿ</para>
  <para style="q2" vid="JOL 3:14">ಗುಂಪು ಗುಂಪುಗಳಾಗಿ ಜನರಿದ್ದಾರೆ!</para>
  <para style="q1" vid="JOL 3:14">ಏಕೆಂದರೆ ಯೆಹೋವ ದೇವರ ದಿವಸವು</para>
  <para style="q2" vid="JOL 3:14">ನಿರ್ಣಯದ ತಗ್ಗಿನಲ್ಲಿ ಸಮೀಪವಾಗಿದೆ.<verse eid="JOL 3:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="JOL 3:15"/>ಸೂರ್ಯ, ಚಂದ್ರರು ಕಪ್ಪಾಗುವುವು.</para>
  <para style="q2" vid="JOL 3:15">ನಕ್ಷತ್ರಗಳು ತಮ್ಮ ಪ್ರಕಾಶವನ್ನು ಮರೆಮಾಡುವುವು.<verse eid="JOL 3:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="JOL 3:16"/>ಯೆಹೋವ ದೇವರು ಚೀಯೋನಿನೊಳಗಿಂದ ಗರ್ಜಿಸಿ,</para>
  <para style="q2" vid="JOL 3:16">ಯೆರೂಸಲೇಮಿನೊಳಗಿಂದ ಗುಡುಗುವರು.</para>
  <para style="q2" vid="JOL 3:16">ಆಕಾಶಗಳೂ ಭೂಮಿಯೂ ನಡುಗುವುವು.</para>
  <para style="q1" vid="JOL 3:16">ಆದರೆ ಯೆಹೋವ ದೇವರು ತಮ್ಮ ಜನರಿಗೆ ಆಶ್ರಯವೂ,</para>
  <para style="q2" vid="JOL 3:16">ಇಸ್ರಾಯೇಲರಿಗೆ ರಕ್ಷಣೆಯ ದುರ್ಗವೂ ಆಗಿರುವರು.<verse eid="JOL 3:16"/></para>
  <para style="s1">ದೇವರ ಜನರಿಗೆ ಆಶೀರ್ವಾದಗಳು</para>
  <para style="q1">
    <verse number="17" style="v" sid="JOL 3:17"/>ಆಗ ನನ್ನ ಪರಿಶುದ್ಧ ಪರ್ವತವಾದ ಚೀಯೋನಿನಲ್ಲಿ ವಾಸಿಸುವ</para>
  <para style="q2" vid="JOL 3:17">ನಿಮ್ಮ ದೇವರಾಗಿರುವ ಯೆಹೋವ ದೇವರು ನಾನೇ ಎಂದು ನೀವು ತಿಳಿದುಕೊಳ್ಳುವಿರಿ.</para>
  <para style="q1" vid="JOL 3:17">ಯೆರೂಸಲೇಮು ಪರಿಶುದ್ಧವಾಗಿರುವುದು.</para>
  <para style="q2" vid="JOL 3:17">ವಿದೇಶಿಯರು ಅದನ್ನೆಂದಿಗೂ ಆಕ್ರಮಿಸರು.<verse eid="JOL 3:17"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="18" style="v" sid="JOL 3:18"/>ಆ ದಿವಸದಲ್ಲಿ ಬೆಟ್ಟಗಳು ಹೊಸ ದ್ರಾಕ್ಷಾರಸವನ್ನು ಸುರಿಯುವುವು.</para>
  <para style="q2" vid="JOL 3:18">ಗುಡ್ಡಗಳು ಹಾಲಿನಿಂದ ಹರಿಯುವುವು.</para>
  <para style="q2" vid="JOL 3:18">ಯೆಹೂದದ ಹಳ್ಳಗಳೆಲ್ಲಾ ನೀರಿನಿಂದ ಹರಿಯುವುವು.</para>
  <para style="q1" vid="JOL 3:18">ಯೆಹೋವ ದೇವರ ಆಲಯದೊಳಗಿಂದ ಬುಗ್ಗೆ ಹೊರಟು,</para>
  <para style="q2" vid="JOL 3:18">ಶಿಟ್ಟೀಮಿನ<note caller="+" style="f"><char style="fr" closed="false">3:18 </char><char style="fq" closed="false">ಶಿಟ್ಟೀಮಿನ </char><char style="ft" closed="false">ಅಥವಾ </char><char style="fqa" closed="false">ಅಕೇಶಿಯಾ</char></note> ಕಣಿವೆಗೆ ಜಲ ಕೊಡುವುದು.<verse eid="JOL 3:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="JOL 3:19"/>ಈಜಿಪ್ಟ್ ಹಾಳಾಗುವುದು.</para>
  <para style="q2" vid="JOL 3:19">ಎದೋಮು ಹಾಳಾದ ಮರುಭೂಮಿಯಾಗುವುದು.</para>
  <para style="q1" vid="JOL 3:19">ಏಕೆಂದರೆ ಅವರು ಯೆಹೂದದ ಜನರನ್ನು ಬಲಾತ್ಕಾರ ಮಾಡಿ,</para>
  <para style="q2" vid="JOL 3:19">ತಮ್ಮ ದೇಶದಲ್ಲಿ ಅಪರಾಧವಿಲ್ಲದ ರಕ್ತವನ್ನು ಚೆಲ್ಲಿದರು.<verse eid="JOL 3:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="JOL 3:20"/>ಯೆಹೂದವು ಎಂದೆಂದಿಗೂ ಜನಭರಿತವಾಗುವುದು.</para>
  <para style="q2" vid="JOL 3:20">ಯೆರೂಸಲೇಮು ಸಹ ತಲತಲಾಂತರಕ್ಕೂ ನಿಲ್ಲುವುದು.<verse eid="JOL 3:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="JOL 3:21"/>ನಾನು ಅವರ ಮುಗ್ಧ ರಕ್ತಕ್ಕೆ ಪ್ರತೀಕಾರ ತೀರಿಸದೆ ಬಿಡಬೇಕೇ?</para>
  <para style="q2" vid="JOL 3:21">ಇಲ್ಲ, ನಾನು ಎಂದಿಗೂ ಬಿಡುವುದಿಲ್ಲ.</para>
  <para style="b" vid="JOL 3:21"/>
  <para style="qc" vid="JOL 3:21">ಯೆಹೋವ ದೇವರು ಚೀಯೋನಿನಲ್ಲಿ ವಾಸವಾಗಿರುತ್ತಾರೆ.<verse eid="JOL 3:21"/></para>
  <chapter eid="JOL 3"/>
</usx>
