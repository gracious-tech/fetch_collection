<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="LAM" style="id">- Biblica® Open Kannada Contemporary Version</book>
  <para style="h">ಪ್ರಲಾಪಗಳು</para>
  <para style="toc1">ಪ್ರಲಾಪಗಳು</para>
  <para style="toc2">ಪ್ರಲಾಪಗಳು</para>
  <para style="toc3">ಪ್ರಲಾಪ</para>
  <para style="mt1">ಪ್ರಲಾಪಗಳು</para>
  <chapter number="1" style="c" sid="LAM 1"/>
  <para style="q1">
    <verse number="1" style="v" sid="LAM 1:1"/>ಜನಭರಿತವಾಗಿದ್ದ ನಗರಿಯು</para>
  <para style="q2" vid="LAM 1:1">ಹೇಗೆ ಬರಿದಾಗಿ ಹೋಗಿದೆ!</para>
  <para style="q1" vid="LAM 1:1">ಜನಾಂಗಗಳಲ್ಲಿ ಶ್ರೇಷ್ಠಳಾದವಳೂ,</para>
  <para style="q2" vid="LAM 1:1">ಈಗ ಹೇಗೆ ವಿಧವೆಯಾಗಿದ್ದಾಳೆ!</para>
  <para style="q1" vid="LAM 1:1">ಸಂಸ್ಥಾನಗಳಲ್ಲಿ ರಾಜಕುಮಾರಿಯಾಗಿದ್ದವಳೂ,</para>
  <para style="q2" vid="LAM 1:1">ಹೇಗೆ ಈಗ ದಾಸಿಯಂತಾಗಿದ್ದಾಳೆ!<verse eid="LAM 1:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="LAM 1:2"/>ಅವಳು ರಾತ್ರಿಯಲ್ಲಿ ಯಾತನೆಗೊಂಡು ಅಳುತ್ತಾಳೆ,</para>
  <para style="q2" vid="LAM 1:2">ಆಕೆಯ ಕಣ್ಣೀರು, ಆಕೆಯ ಕೆನ್ನೆಗಳ ಮೇಲಿದೆ.</para>
  <para style="q1" vid="LAM 1:2">ಆಕೆಯ ಎಲ್ಲಾ ಪ್ರಿಯರಲ್ಲಿ, ಆಕೆಯನ್ನು ಸಂತೈಸುವವರು ಒಬ್ಬರೂ ಇಲ್ಲ.</para>
  <para style="q2" vid="LAM 1:2">ಆಕೆಯ ಸ್ನೇಹಿತರೆಲ್ಲರೂ,</para>
  <para style="q1" vid="LAM 1:2">ಆಕೆಗೆ ವಂಚನೆಮಾಡಿ,</para>
  <para style="q2" vid="LAM 1:2">ಆಕೆಗೆ ಶತ್ರುಗಳಾದರು.<verse eid="LAM 1:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="LAM 1:3"/>ಯೆಹೂದವೆಂಬಾಕೆಯು ಸಂಕಟದ ನಿಮಿತ್ತವೂ,</para>
  <para style="q2" vid="LAM 1:3">ಘೋರವಾದ ದಾಸ್ಯದ ನಿಮಿತ್ತವೂ ಸೆರೆಯಾಗಿ ಹೋದಳು.</para>
  <para style="q1" vid="LAM 1:3">ಆಕೆಯು ಬೇರೆ ಜನಾಂಗಗಳೊಳಗೆ ವಾಸಮಾಡುವವಳಾಗಿ,</para>
  <para style="q2" vid="LAM 1:3">ವಿಶ್ರಾಂತಿಯನ್ನು ಕಾಣಳು.</para>
  <para style="q1" vid="LAM 1:3">ಆಕೆಯು ಇಕ್ಕಟ್ಟಿಗೆ ಸಿಕ್ಕಿಕೊಂಡಿರುವಾಗಲೇ ಆಕೆಯ ಹಿಂಸಕರೆಲ್ಲಾ</para>
  <para style="q2" vid="LAM 1:3">ಆಕೆಯನ್ನು ಹಿಂದಟ್ಟಿ ಹಿಡಿದರು.<verse eid="LAM 1:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="LAM 1:4"/>ಚೀಯೋನಿನ ಮಾರ್ಗಗಳು ದುಃಖಿಸುತ್ತವೆ.</para>
  <para style="q2" vid="LAM 1:4">ಏಕೆಂದರೆ ಆಕೆಯ ನಿರ್ಧರಿತ ಹಬ್ಬಗಳಿಗೆ ಯಾರೂ ಬರಲಿಲ್ಲ.</para>
  <para style="q1" vid="LAM 1:4">ಆಕೆಯ ಎಲ್ಲಾ ಬಾಗಿಲುಗಳು ಹಾಳು ಬಿದ್ದಿವೆ.</para>
  <para style="q2" vid="LAM 1:4">ಆಕೆಯ ಯಾಜಕರು ನರಳುತ್ತಾರೆ.</para>
  <para style="q1" vid="LAM 1:4">ಆಕೆಯ ಕನ್ಯೆಯರು ದುಃಖಿಸುತ್ತಾರೆ.</para>
  <para style="q2" vid="LAM 1:4">ಆಕೆಯು ಕಹಿ ವೇದನೆಯಲ್ಲಿದ್ದಾಳೆ.<verse eid="LAM 1:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="LAM 1:5"/>ಆಕೆಯ ವೈರಿಗಳು ಆಕೆಯ ಯಜಮಾನರಾಗಿದ್ದಾರೆ.</para>
  <para style="q2" vid="LAM 1:5">ಆಕೆಯ ಶತ್ರುಗಳು ನೆಮ್ಮದಿಯಿಂದ ಇದ್ದಾರೆ.</para>
  <para style="q1" vid="LAM 1:5">ಏಕೆಂದರೆ ಆಕೆಯ ಅನೇಕ ಪಾಪಗಳ</para>
  <para style="q2" vid="LAM 1:5">ನಿಮಿತ್ತ ಯೆಹೋವ ದೇವರು ಆಕೆಯನ್ನು ಸಂಕಟಪಡಿಸಿದ್ದಾರೆ.</para>
  <para style="q1" vid="LAM 1:5">ಆಕೆಯ ಮಕ್ಕಳು</para>
  <para style="q2" vid="LAM 1:5">ಶತ್ರುವಿನ ಮುಂದೆ ಸೆರೆಗೆ ಹೋಗಿದ್ದಾರೆ.<verse eid="LAM 1:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="LAM 1:6"/>ಚೀಯೋನ್ ಪುತ್ರಿಯ</para>
  <para style="q2" vid="LAM 1:6">ಎಲ್ಲಾ ವೈಭವವು ಅವಳನ್ನು ಬಿಟ್ಟುಹೋಯಿತು.</para>
  <para style="q1" vid="LAM 1:6">ಅವಳ ಪ್ರಧಾನರು</para>
  <para style="q2" vid="LAM 1:6">ಹುಲ್ಲುಗಾವಲು ಕಾಣದ ಜಿಂಕೆಗಳ ಹಾಗಾದರು,</para>
  <para style="q1" vid="LAM 1:6">ಅವರು ಹಿಂದಟ್ಟುವವನ ಮುಂದೆ</para>
  <para style="q2" vid="LAM 1:6">ತ್ರಾಣವಿಲ್ಲದವರ ಹಾಗೆ ಓಡಿಹೋದರು.<verse eid="LAM 1:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="LAM 1:7"/>ಯೆರೂಸಲೇಮು ಕಷ್ಟದ ಮತ್ತು ಸಂಕಟದ ದಿನಗಳಲ್ಲಿ</para>
  <para style="q2" vid="LAM 1:7">ಪೂರ್ವದಿನಗಳಲ್ಲಿ ತನಗಿದ್ದ</para>
  <para style="q2" vid="LAM 1:7">ಸಂಪತ್ತೆಲ್ಲವನ್ನು ಜ್ಞಾಪಕ ಮಾಡಿಕೊಂಡಿದ್ದಾಳೆ.</para>
  <para style="q1" vid="LAM 1:7">ಆಕೆಯ ಜನರು ಶತ್ರುವಿನ ಕೈಯಲ್ಲಿ ಬಿದ್ದಾಗ,</para>
  <para style="q2" vid="LAM 1:7">ಅವಳಿಗೆ ಯಾರೂ ಸಹಾಯ ಮಾಡಲಿಲ್ಲ.</para>
  <para style="q1" vid="LAM 1:7">ವೈರಿಗಳು ಅವಳನ್ನು ನೋಡಿ</para>
  <para style="q2" vid="LAM 1:7">ಅವಳ ನಾಶನದ ವಿಷಯವಾಗಿ ಅಪಹಾಸ್ಯ ಮಾಡಿದರು.<verse eid="LAM 1:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="LAM 1:8"/>ಯೆರೂಸಲೇಮು ಘೋರ ಪಾಪಮಾಡಿದೆ.</para>
  <para style="q2" vid="LAM 1:8">ಆದ್ದರಿಂದ ಅವಳು ಅಶುದ್ಧಳಾಗಿದ್ದಾಳೆ.</para>
  <para style="q1" vid="LAM 1:8">ಅವಳನ್ನು ಸನ್ಮಾನಿಸಿದವರೆಲ್ಲರೂ,</para>
  <para style="q2" vid="LAM 1:8">ಅವಳನ್ನು ಹೀನೈಸುತ್ತಾರೆ.</para>
  <para style="q1" vid="LAM 1:8">ಏಕೆಂದರೆ ಅವರು ಅವಳ ಬೆತ್ತಲೆತನವನ್ನು ನೋಡಿದ್ದಾರೆ.</para>
  <para style="q2" vid="LAM 1:8">ಹೌದು, ಅವಳು ನರಳುತ್ತಾ ಹಿಂದಕ್ಕೆ ತಿರುಗುತ್ತಾಳೆ.<verse eid="LAM 1:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="LAM 1:9"/>ಅವಳ ಅಶುದ್ಧವು ಅವಳ ನೆರಿಗೆಗೆ ಅಂಟಿಕೊಂಡಿದೆ.</para>
  <para style="q2" vid="LAM 1:9">ಅವಳು ತನ್ನ ಭವಿಷ್ಯವನ್ನು ಜ್ಞಾಪಕಮಾಡಿಕೊಳ್ಳುವುದಿಲ್ಲ.</para>
  <para style="q1" vid="LAM 1:9">ಆದ್ದರಿಂದ ಅವಳು ಭಯಂಕರವಾಗಿ ಇಳಿದು ಬಂದಳು.</para>
  <para style="q2" vid="LAM 1:9">ಅವಳನ್ನು ಆದರಿಸುವವರು ಯಾರೂ ಇಲ್ಲ.</para>
  <para style="q1" vid="LAM 1:9">“ಓ ಯೆಹೋವ ದೇವರೇ, ನನ್ನ ಸಂಕಟವನ್ನು ನೋಡಿರಿ,</para>
  <para style="q2" vid="LAM 1:9">ಶತ್ರುವು ಜಯಿಸಿದ್ದಾನೆ.”<verse eid="LAM 1:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="LAM 1:10"/>ವೈರಿಯು ಆಕೆಯ ಎಲ್ಲಾ ಬೊಕ್ಕಸಗಳ ಮೇಲೆ</para>
  <para style="q2" vid="LAM 1:10">ತನ್ನ ಕೈಚಾಚಿದ್ದಾನೆ.</para>
  <para style="q1" vid="LAM 1:10">ನಿನ್ನ ಸಭೆಯಲ್ಲಿ ಸೇರಬಾರದೆಂದು</para>
  <para style="q2" vid="LAM 1:10">ನೀನು ಆಜ್ಞಾಪಿಸಿದ ಇತರ ಜನಾಂಗಗಳು,</para>
  <para style="q1" vid="LAM 1:10">ತನ್ನ ಪರಿಶುದ್ಧ</para>
  <para style="q2" vid="LAM 1:10">ಸ್ಥಳದಲ್ಲಿ ಸೇರುವುದನ್ನು ನೋಡಿದ್ದಾಳೆ.<verse eid="LAM 1:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="LAM 1:11"/>ಅವಳ ಜನರೆಲ್ಲರು ನರಳಾಡುತ್ತಾರೆ.</para>
  <para style="q2" vid="LAM 1:11">ಅವರು ರೊಟ್ಟಿ ಹುಡುಕುತ್ತಾರೆ.</para>
  <para style="q1" vid="LAM 1:11">ಅವರು ಪ್ರಾಣವನ್ನು ಉಳಿಸಿಕೊಳ್ಳಲು,</para>
  <para style="q2" vid="LAM 1:11">ಅವರು ಆಹಾರಕ್ಕಾಗಿ ತಮ್ಮ ಬೊಕ್ಕಸಗಳನ್ನು ವಿನಿಮಯ ಮಾಡಿಕೊಳ್ಳುತ್ತಾರೆ</para>
  <para style="q1" vid="LAM 1:11">“ಯೆಹೋವ ದೇವರೇ, ನೋಡು, ಲಕ್ಷಿಸಿ;</para>
  <para style="q2" vid="LAM 1:11">ಏಕೆಂದರೆ ನಾನು ಭ್ರಷ್ಠಳಾದೆನು.”<verse eid="LAM 1:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="LAM 1:12"/>ಹಾದು ಹೋಗುವವರೇ, ಇದು ನಿಮಗೆ ಏನೂ ಇಲ್ಲವೋ?</para>
  <para style="q2" vid="LAM 1:12">ಸುತ್ತಲೂ ದೃಷ್ಟಿಸಿ ನೋಡಿರಿ.</para>
  <para style="q1" vid="LAM 1:12">ಯೆಹೋವ ದೇವರ ಉಗ್ರಕೋಪದ ದಿನದಲ್ಲಿ</para>
  <para style="q2" vid="LAM 1:12">ನನ್ನನ್ನು ಸಂಕಟ ಪಡಿಸಿದ ಇಂಥಾ ದುಃಖವು,</para>
  <para style="q2" vid="LAM 1:12">ಯಾರಿಗಾದರೂ ಉಂಟೋ ನೋಡಿರಿ.<verse eid="LAM 1:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="LAM 1:13"/>ಆತನು ಮೇಲಿನಿಂದ</para>
  <para style="q2" vid="LAM 1:13">ನನ್ನ ಎಲುಬುಗಳಿಗೆ ಬೆಂಕಿಯನ್ನು ಕಳುಹಿಸಿದ್ದಾನೆ.</para>
  <para style="q1" vid="LAM 1:13">ಆತನು ನನ್ನ ಪಾದದ ಮೇಲೆ ಒಂದು ಬಲೆಯನ್ನು ಬೀಸಿ,</para>
  <para style="q2" vid="LAM 1:13">ಆತನು ನನ್ನನ್ನು ಹಿಂದಕ್ಕೆ ತಿರುಗಿಸಿದ್ದಾರೆ.</para>
  <para style="q1" vid="LAM 1:13">ಆತನು ನನ್ನನ್ನು ದಿನವೆಲ್ಲಾ ಹಾಳಾಗಿಯೂ,</para>
  <para style="q2" vid="LAM 1:13">ಮೂರ್ಛೆ ಹೋಗುವಂತೆಯೂ ಮಾಡಿದ್ದಾನೆ.<verse eid="LAM 1:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="LAM 1:14"/>ನನ್ನ ಪಾಪಗಳು ನನಗೆ ನೊಗವಾಗಿ,</para>
  <para style="q2" vid="LAM 1:14">ನನ್ನ ಕುತ್ತಿಗೆಯ ಮೇಲೆ ಅವು ಬಂದಿವೆ.</para>
  <para style="q1" vid="LAM 1:14">ಕರ್ತದೇವರು ನನ್ನ ಶಕ್ತಿಯನ್ನು ಕುಂದಿಸಿದ್ದಾರೆ.</para>
  <para style="q1" vid="LAM 1:14">ಯೆಹೋವ ದೇವರು ನನ್ನನ್ನು ಅವರ ಕೈಗಳಿಗೆ ಒಪ್ಪಿಸಿ,</para>
  <para style="q2" vid="LAM 1:14">ಅವರನ್ನು ನಾನು ಎದುರಿಸಲಾರದಂತೆ ಮಾಡಿದ್ದಾರೆ.<verse eid="LAM 1:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="LAM 1:15"/>ಕರ್ತದೇವರು ನನ್ನ</para>
  <para style="q2" vid="LAM 1:15">ಶೂರರನ್ನೆಲ್ಲಾ ತಿರಸ್ಕರಿಸಿದ್ದಾರೆ.</para>
  <para style="q1" vid="LAM 1:15">ಅವರು ನನಗೆ ವಿರುದ್ಧ ಸೈನ್ಯವನ್ನು ಬರಮಾಡಿ,</para>
  <para style="q2" vid="LAM 1:15">ನನ್ನ ಯುವಕರನ್ನು ಜಜ್ಜಿದ್ದಾರೆ.</para>
  <para style="q1" vid="LAM 1:15">ಕರ್ತದೇವರು ಯೆಹೂದದ ಕನ್ಯೆಯನ್ನು</para>
  <para style="q2" vid="LAM 1:15">ದ್ರಾಕ್ಷಿಯ ತೊಟ್ಟಿಯಂತೆ ತುಳಿದಿದ್ದಾರೆ.<verse eid="LAM 1:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="LAM 1:16"/>ಇವುಗಳ ನಿಮಿತ್ತ ನಾನು ಅಳುತ್ತೇನೆ.</para>
  <para style="q2" vid="LAM 1:16">ನನ್ನ ಕಣ್ಣೀರು ಕಣ್ಣಿನಿಂದ ತುಂಬಿ ಹರಿಯುತ್ತದೆ.</para>
  <para style="q1" vid="LAM 1:16">ಏಕೆಂದರೆ ನನ್ನನ್ನು ಆದರಿಸುವವರೂ,</para>
  <para style="q2" vid="LAM 1:16">ನನ್ನ ಪ್ರಾಣವನ್ನು ಬದುಕಿಸುವ ಆದರಿಕರೂ ನನ್ನಿಂದ ದೂರವಾಗಿದ್ದಾರೆ.</para>
  <para style="q1" vid="LAM 1:16">ನನ್ನ ಮಕ್ಕಳು ಹಾಳಾಗಿದ್ದಾರೆ.</para>
  <para style="q2" vid="LAM 1:16">ಏಕೆಂದರೆ ನನ್ನ ಶತ್ರುವು ಜಯಿಸಿದ್ದಾನೆ.<verse eid="LAM 1:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="LAM 1:17"/>ಚೀಯೋನ್ ತನ್ನ ಕೈಗಳನ್ನು ಚಾಚುತ್ತಾಳೆ.</para>
  <para style="q2" vid="LAM 1:17">ಅವಳನ್ನು ಆದರಿಸುವವನು ಒಬ್ಬನೂ ಇಲ್ಲ.</para>
  <para style="q1" vid="LAM 1:17">ಯಾಕೋಬಿಗೆ ಸಂಬಂಧಿಸಿದ ಅವನ ವೈರಿಗಳು ಅವನ ಸುತ್ತಲೂ ಇರಬೇಕೆಂದು</para>
  <para style="q2" vid="LAM 1:17">ಯೆಹೋವ ದೇವರು ಆಜ್ಞಾಪಿಸಿದ್ದಾರೆ.</para>
  <para style="q2" vid="LAM 1:17">ಯೆರೂಸಲೇಮ್ ಅವರ ಮಧ್ಯದಲ್ಲಿ ಅಶುದ್ಧ ವಸ್ತುವಿನಂತಿದೆ.<verse eid="LAM 1:17"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="18" style="v" sid="LAM 1:18"/>ಯೆಹೋವ ದೇವರು ನೀತಿವಂತನು.</para>
  <para style="q2" vid="LAM 1:18">ಏಕೆಂದರೆ ನಾನು ಆತನ ಆಜ್ಞೆಗೆ ವಿರುದ್ಧವಾಗಿ ತಿರುಗಿ ಬಿದ್ದಿದ್ದೇನೆ.</para>
  <para style="q1" vid="LAM 1:18">ಎಲ್ಲಾ ಜನರೇ ಕೇಳಿರಿ, ನಾನು ನಿಮ್ಮನ್ನು ಕೇಳಿಕೊಳ್ಳುತ್ತೇನೆ.</para>
  <para style="q2" vid="LAM 1:18">ನನ್ನ ದುಃಖವನ್ನು ನೋಡಿರಿ.</para>
  <para style="q1" vid="LAM 1:18">ನನ್ನ ಕನ್ಯೆಯರೂ, ನನ್ನ ಯೌವನಸ್ಥರೂ</para>
  <para style="q2" vid="LAM 1:18">ಸೆರೆಗೆ ಹೋಗಿದ್ದಾರೆ.<verse eid="LAM 1:18"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="LAM 1:19"/>ನಾನು ನನ್ನ ಪ್ರಿಯರನ್ನು ಕರೆದೆನು.</para>
  <para style="q2" vid="LAM 1:19">ಆದರೆ ಅವರು ನನ್ನನ್ನು ಮೋಸಗೊಳಿಸಿದರು.</para>
  <para style="q1" vid="LAM 1:19">ನನ್ನ ಯಾಜಕರು, ನನ್ನ ಹಿರಿಯರು</para>
  <para style="q2" vid="LAM 1:19">ತಮ್ಮ ಪ್ರಾಣವನ್ನು ಉಳಿಸಿಕೊಳ್ಳುವುದಕ್ಕೆ</para>
  <para style="q1" vid="LAM 1:19">ರೊಟ್ಟಿಯನ್ನು ಹುಡುಕುತ್ತಾ</para>
  <para style="q2" vid="LAM 1:19">ನಗರದಲ್ಲಿ ಸತ್ತುಹೋದರು.<verse eid="LAM 1:19"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="20" style="v" sid="LAM 1:20"/>ಯೆಹೋವ ದೇವರೇ ನೋಡು, ಏಕೆಂದರೆ ನಾನು ಇಕ್ಕಟ್ಟಿನಲ್ಲಿದ್ದೇನೆ.</para>
  <para style="q2" vid="LAM 1:20">ನನ್ನ ಆತ್ಮವು ಕಳವಳಗೊಂಡಿದೆ.</para>
  <para style="q1" vid="LAM 1:20">ನನ್ನ ಹೃದಯವು ನನ್ನೊಂದಿಗೆ ತಿರುಗಿಕೊಂಡಿದೆ.</para>
  <para style="q2" vid="LAM 1:20">ಏಕೆಂದರೆ ನಾನು ಘೋರವಾಗಿ ಬಿದ್ದಿದ್ದೇನೆ.</para>
  <para style="q1" vid="LAM 1:20">ಹೊರಗೆ ಖಡ್ಗದಿಂದ ಸಂಹಾರ,</para>
  <para style="q2" vid="LAM 1:20">ಮನೆಯೊಳಗೆ ಮರಣ.<verse eid="LAM 1:20"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="21" style="v" sid="LAM 1:21"/>ನಾನು ನರಳಾಡುವುದನ್ನು ಅವರು ಕೇಳಿದರೂ,</para>
  <para style="q2" vid="LAM 1:21">ನನ್ನನ್ನು ಆದರಿಸಲು ಅಲ್ಲಿರಲಿಲ್ಲ.</para>
  <para style="q1" vid="LAM 1:21">ನನ್ನ ಎಲ್ಲಾ ಶತ್ರುಗಳು ನನ್ನ ಕಷ್ಟದ ವಿಷಯವನ್ನು ಕೇಳಿದರು.</para>
  <para style="q2" vid="LAM 1:21">ನೀವು ಹಾಗೆ ಮಾಡಿದಿರೆಂದು ಅವರು ಸಂತೋಷಪಟ್ಟರು.</para>
  <para style="q1" vid="LAM 1:21">ನೀನು ತಿಳಿಸಿದ ಆ ದಿನವು ಬರಲು,</para>
  <para style="q2" vid="LAM 1:21">ಅವರು ನನ್ನ ಹಾಗೆಯೇ ಆಗುವರು.<verse eid="LAM 1:21"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="22" style="v" sid="LAM 1:22"/>ಅವರ ಎಲ್ಲಾ ಕೆಟ್ಟತನವು ನಿನ್ನ ಮುಂದೆ ಇರಲಿ.</para>
  <para style="q2" vid="LAM 1:22">ನನ್ನ ಎಲ್ಲಾ ದ್ರೋಹಗಳ ನಿಮಿತ್ತ,</para>
  <para style="q1" vid="LAM 1:22">ನೀನು ನನಗೆ ಮಾಡಿದ ಪ್ರಕಾರವೇ</para>
  <para style="q2" vid="LAM 1:22">ಅವರಿಗೆ ಮಾಡು.</para>
  <para style="q1" vid="LAM 1:22">ಏಕೆಂದರೆ ನನ್ನ ನರಳಾಟವು ಅನೇಕವಾಗಿವೆ.</para>
  <para style="q2" vid="LAM 1:22">ನನ್ನ ಹೃದಯವು ಮೂರ್ಛೆಗೊಂಡಿದೆ.<verse eid="LAM 1:22"/></para>
  <para style="b"/>
  <para style="b"/>
  <chapter eid="LAM 1"/>
  <chapter number="2" style="c" sid="LAM 2"/>
  <para style="q1">
    <verse number="1" style="v" sid="LAM 2:1"/>ಕರ್ತದೇವರು ಹೇಗೆ ತಮ್ಮ ಕೋಪದ ಮೇಘದಿಂದ ಚೀಯೋನಿನ ಮಗಳನ್ನು ಮುಚ್ಚಿ</para>
  <para style="q2" vid="LAM 2:1">ಇಸ್ರಾಯೇಲಿನ ಸೌಂದರ್ಯವನ್ನು ಆಕಾಶದಿಂದ ಭೂಮಿಗೆ ಎಸೆದರು.</para>
  <para style="q1" vid="LAM 2:1">ತನ್ನ ಕೋಪದ ದಿನದಲ್ಲಿ,</para>
  <para style="q2" vid="LAM 2:1">ತನ್ನ ಪಾದಪೀಠವನ್ನು ಜ್ಞಾಪಕ ಮಾಡಿಕೊಳ್ಳಲಿಲ್ಲ.<verse eid="LAM 2:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="LAM 2:2"/>ಕರ್ತದೇವರು ಯಾಕೋಬಿನ ಎಲ್ಲಾ ನಿವಾಸಿಗಳನ್ನು</para>
  <para style="q2" vid="LAM 2:2">ಕನಿಕರಿಸದೆ ನುಂಗಿದ್ದಾರೆ.</para>
  <para style="q1" vid="LAM 2:2">ಯೆಹೂದದ ಪುತ್ರಿಯ ಭದ್ರವಾದ ಸ್ಥಾನಗಳನ್ನು</para>
  <para style="q2" vid="LAM 2:2">ತನ್ನ ರೋಷದಲ್ಲಿ ಕೆಡವಿ ಹಾಕಿದ್ದಾರೆ.</para>
  <para style="q1" vid="LAM 2:2">ಅವರು ಅವುಗಳನ್ನು ನೆಲಸಮ ಮಾಡಿದ್ದಾರೆ.</para>
  <para style="q2" vid="LAM 2:2">ಅವರು ಆಕೆಯ ರಾಜ್ಯವನ್ನೂ, ಪ್ರಭುಗಳನ್ನೂ ಅಗೌರವಿಸಿ ನೆಲಕ್ಕೆ ದಬ್ಬಿದ್ದಾರೆ.<verse eid="LAM 2:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="LAM 2:3"/>ಅವರು ತನ್ನ ತೀಕ್ಷ್ಣ ಕೋಪದಲ್ಲಿ</para>
  <para style="q2" vid="LAM 2:3">ಇಸ್ರಾಯೇಲಿನ ಕೊಂಬುಗಳನ್ನೆಲ್ಲಾ ಮುರಿದು ಹಾಕಿದ್ದಾರೆ.</para>
  <para style="q1" vid="LAM 2:3">ಅವರು ಶತ್ರುವಿನ ಎದುರಿನಿಂದ</para>
  <para style="q2" vid="LAM 2:3">ತನ್ನ ಬಲಗೈಯನ್ನು ಹಿಂತೆಗೆದುಕೊಂಡಿದ್ದಾರೆ.</para>
  <para style="q1" vid="LAM 2:3">ತನ್ನ ಸುತ್ತಲೂ ಇರುವವರನ್ನು ದಹಿಸುವ ಬೆಂಕಿಯಂತೆ,</para>
  <para style="q2" vid="LAM 2:3">ಅವರು ಯಾಕೋಬನಿಗೆ ವಿರುದ್ಧವಾಗಿ ದಹಿಸಿಬಿಟ್ಟಿದ್ದಾರೆ.<verse eid="LAM 2:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="LAM 2:4"/>ಅವರು ಶತ್ರುವಿನ ಹಾಗೆಯೇ ತನ್ನ ಬಿಲ್ಲನ್ನು ಬಗ್ಗಿಸಿದ್ದಾರೆ.</para>
  <para style="q2" vid="LAM 2:4">ವೈರಿಯ ಹಾಗೆ ತನ್ನ ಬಲಗೈ ಎತ್ತಿ ನಿಂತುಕೊಂಡು,</para>
  <para style="q1" vid="LAM 2:4">ಕಣ್ಣಿಗೆ ರಮ್ಯವಾಗಿ ಕಾಣುವ ಎಲ್ಲವುಗಳನ್ನು ಕೊಂದುಹಾಕಿದ್ದಾರೆ.</para>
  <para style="q2" vid="LAM 2:4">ಅವರು ತನ್ನ ರೋಷವೆಂಬ ಅಗ್ನಿಯನ್ನು ಚೀಯೋನ್ ಪುತ್ರಿಯ ಡೇರೆಯಲ್ಲಿ ಸುರಿದಿದ್ದಾರೆ.<verse eid="LAM 2:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="LAM 2:5"/>ಕರ್ತದೇವರು ಶತ್ರುವಿನಂತೆ ಆಗಿ,</para>
  <para style="q2" vid="LAM 2:5">ಇಸ್ರಾಯೇಲನ್ನು ನುಂಗಿಬಿಟ್ಟಿದ್ದಾರೆ.</para>
  <para style="q1" vid="LAM 2:5">ಕರ್ತದೇವರು ಅವನ ಭದ್ರವಾದ ಸ್ಥಾನಗಳನ್ನೆಲ್ಲಾ ನಾಶಮಾಡಿದ್ದಾರೆ.</para>
  <para style="q2" vid="LAM 2:5">ಯೆಹೂದದ ದುಃಖವನ್ನೂ,</para>
  <para style="q2" vid="LAM 2:5">ಪ್ರಲಾಪವನ್ನೂ ಹೆಚ್ಚಿಸಿದ್ದಾರೆ.<verse eid="LAM 2:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="LAM 2:6"/>ಅವರು ತನ್ನ ಗುಡಾರವನ್ನು ತೋಟದಂತೆ ಬಲಾತ್ಕಾರವಾಗಿ ತೆಗೆದುಹಾಕಿದ್ದಾರೆ.</para>
  <para style="q2" vid="LAM 2:6">ಅವರು ತನ್ನ ಸಭಾ ಸ್ಥಾನಗಳನ್ನು ನಾಶಮಾಡಿದ್ದಾರೆ.</para>
  <para style="q1" vid="LAM 2:6">ಯೆಹೋವ ದೇವರು ಚೀಯೋನಿಗೆ ಪವಿತ್ರ ಹಬ್ಬಗಳನ್ನೂ,</para>
  <para style="q2" vid="LAM 2:6">ಸಬ್ಬತ್ ದಿನಗಳನ್ನೂ ಮರೆತುಬಿಡುವಂತೆ ಮಾಡಿದ್ದಾರೆ.</para>
  <para style="q1" vid="LAM 2:6">ತನ್ನ ಕೋಪದ ಉರಿಯಲ್ಲಿ ಅರಸನನ್ನೂ,</para>
  <para style="q2" vid="LAM 2:6">ಯಾಜಕನನ್ನೂ ತುಚ್ಛೀಕರಿಸಿದ್ದಾರೆ.<verse eid="LAM 2:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="LAM 2:7"/>ಕರ್ತದೇವರು ತನ್ನ ಬಲಿಪೀಠವನ್ನು ತಳ್ಳಿಬಿಟ್ಟಿದ್ದಾರೆ.</para>
  <para style="q2" vid="LAM 2:7">ತನ್ನ ಪರಿಶುದ್ಧ ಸ್ಥಳವನ್ನು ಅಸಹ್ಯ ಪಡಿಸಿದ್ದಾನೆ.</para>
  <para style="q1" vid="LAM 2:7">ಆತನು ಅವಳ ಅರಮನೆಗಳ ಗೋಡೆಗಳನ್ನು</para>
  <para style="q2" vid="LAM 2:7">ಶತ್ರುವಿನ ಕೈಯಲ್ಲಿ ಒಪ್ಪಿಸಿಕೊಟ್ಟಿದ್ದಾನೆ.</para>
  <para style="q1" vid="LAM 2:7">ಪರಿಶುದ್ಧ ಹಬ್ಬದ ದಿನದಲ್ಲಿ ಮಾಡಿದ ಹಾಗೆ,</para>
  <para style="q2" vid="LAM 2:7">ಅವರು ಯೆಹೋವ ದೇವರು ಆಲಯದಲ್ಲಿ ಶಬ್ದ ಮಾಡಿದ್ದಾರೆ.<verse eid="LAM 2:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="LAM 2:8"/>ಯೆಹೋವ ದೇವರು ಚೀಯೋನಿನ ಗೋಡೆಯನ್ನು ನಾಶಮಾಡಬೇಕೆಂದು ಉದ್ದೇಶಿಸಿದ್ದಾರೆ.</para>
  <para style="q2" vid="LAM 2:8">ಅಳತೆಯ ಗೆರೆಯನ್ನು ಎಳೆದಿದ್ದಾರೆ.</para>
  <para style="q1" vid="LAM 2:8">ತನ್ನ ಕೈಯನ್ನು ಕೆಡಿಸುವುದರಿಂದ ಹಿಂದೆಗೆಯಲಿಲ್ಲ.</para>
  <para style="q2" vid="LAM 2:8">ಆದ್ದರಿಂದ ಕಲ್ಲಿನ ಪ್ರಾಕಾರವನ್ನು ಮತ್ತು</para>
  <para style="q1" vid="LAM 2:8">ಗೋಡೆಯನ್ನು ಗೋಳಾಡುವಂತೆ ಆತನು ಮಾಡಿದ್ದಾನೆ.</para>
  <para style="q2" vid="LAM 2:8">ಅವೆರಡೂ ಜೊತೆಯಾಗಿ ಕುಸಿದು ಹೋಗಿವೆ.<verse eid="LAM 2:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="LAM 2:9"/>ಅವಳ ಬಾಗಿಲುಗಳು ನೆಲದೊಳಗೆ ಹೂತುಕೊಂಡಿವೆ.</para>
  <para style="q2" vid="LAM 2:9">ಆತನು ಆಕೆಯ ಅಗುಳಿಗಳನ್ನು ಮುರಿದು ಹಾಳು ಮಾಡಿದ್ದಾನೆ.</para>
  <para style="q1" vid="LAM 2:9">ಅವಳ ಅರಸನು ಮತ್ತು ಅವಳ ಪ್ರಭುಗಳು ಇತರ ಜನಾಂಗಗಳ ಮಧ್ಯೆ ಇರುವರು.</para>
  <para style="q2" vid="LAM 2:9">ಇನ್ನು ದೈವನಿಯಮವು ನಿಂತುಹೋಗಿವೆ.</para>
  <para style="q1" vid="LAM 2:9">ಆಕೆಯ ಪ್ರವಾದಿಗಳು ಸಹ</para>
  <para style="q2" vid="LAM 2:9">ಯೆಹೋವ ದೇವರಿಂದ ದರ್ಶನವನ್ನು ಕಂಡುಕೊಳ್ಳುವುದಿಲ್ಲ.<verse eid="LAM 2:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="LAM 2:10"/>ಚೀಯೋನಿನ ಹಿರಿಯರು</para>
  <para style="q2" vid="LAM 2:10">ನೆಲದ ಮೇಲೆ ಕುಳಿತುಕೊಂಡು ನಿಶ್ಶಬ್ದವಾಗಿದ್ದಾರೆ.</para>
  <para style="q1" vid="LAM 2:10">ಅವರು ತಮ್ಮ ತಲೆಗಳ ಮೇಲೆ ಧೂಳು ಹಾಕಿಕೊಂಡಿದ್ದಾರೆ.</para>
  <para style="q2" vid="LAM 2:10">ಅವರು ಗೋಣಿತಟ್ಟನ್ನು ಸುತ್ತಿಕೊಂಡಿದ್ದಾರೆ.</para>
  <para style="q1" vid="LAM 2:10">ಯೆರೂಸಲೇಮಿನ ಕನ್ಯೆಯರು</para>
  <para style="q2" vid="LAM 2:10">ತಮ್ಮ ತಲೆಯನ್ನು ನೆಲದ ಕಡೆಗೆ ಬಗ್ಗಿಸಿಕೊಂಡಿದ್ದಾರೆ.<verse eid="LAM 2:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="LAM 2:11"/>ನನ್ನ ಕಣ್ಣುಗಳು ಕಣ್ಣೀರಿನಿಂದ ಕುಂದಿ ಹೋಗುತ್ತವೆ.</para>
  <para style="q2" vid="LAM 2:11">ನನ್ನ ಆತ್ಮವು ಕಳವಳಗೊಂಡಿದೆ.</para>
  <para style="q1" vid="LAM 2:11">ನನ್ನ ಹೃದಯವು ನೆಲದ ಮೇಲೆ ಹರಡಿದೆ.</para>
  <para style="q2" vid="LAM 2:11">ಏಕೆಂದರೆ ನನ್ನ ಜನರು ನಾಶವಾಗಿದ್ದಾರೆ.</para>
  <para style="q1" vid="LAM 2:11">ಮಕ್ಕಳೂ ಶಿಶುಗಳೂ</para>
  <para style="q2" vid="LAM 2:11">ನಗರದ ಬೀದಿಗಳಲ್ಲಿ ಮೂರ್ಛೆ ಹೋಗಿದ್ದಾರೆ.<verse eid="LAM 2:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="LAM 2:12"/>ಅವರು ನಗರದ ಬೀದಿಗಳಲ್ಲಿ</para>
  <para style="q2" vid="LAM 2:12">ಗಾಯಪಟ್ಟವರ ಹಾಗೆ ಮೂರ್ಛೆ ಹೋದಾಗ,</para>
  <para style="q1" vid="LAM 2:12">ತಮ್ಮ ತಾಯಂದಿರ ಎದೆಯಲ್ಲಿ ಪ್ರಾಣ ಸುರಿದಾಗ,</para>
  <para style="q2" vid="LAM 2:12">“ತಿನ್ನಲಿಕ್ಕೆ ರೊಟ್ಟಿಯೂ ದ್ರಾಕ್ಷಾರಸವೂ ಎಲ್ಲಿ?”</para>
  <para style="q2" vid="LAM 2:12">ಎಂದು ತಮ್ಮ ತಾಯಂದಿರಿಗೆ ಕೇಳುತ್ತಾರೆ.<verse eid="LAM 2:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="LAM 2:13"/>ಯೆರೂಸಲೇಮಿನ ಪುತ್ರಿಯೇ,</para>
  <para style="q2" vid="LAM 2:13">ನಾನು ಯಾವುದನ್ನು ನಿನಗೆ ಸಾಕ್ಷಿಯನ್ನಾಗಿಡಲಿ?</para>
  <para style="q1" vid="LAM 2:13">ಯಾವುದನ್ನು ನಿನಗೆ ಸಮಾನ ಮಾಡಲಿ?</para>
  <para style="q2" vid="LAM 2:13">ಚೀಯೋನಿನ ಕನ್ಯೆಯೇ,</para>
  <para style="q2" vid="LAM 2:13">ನಿನ್ನನ್ನು ಆದರಿಸುವವರು ಯಾರು?<verse eid="LAM 2:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="LAM 2:14"/>ನಿನ್ನ ಪ್ರವಾದಿಗಳು</para>
  <para style="q2" vid="LAM 2:14">ನಿನಗಾಗಿ ವ್ಯರ್ಥವಾದ ಮತ್ತು</para>
  <para style="q1" vid="LAM 2:14">ಮೂರ್ಖತನದ ದರ್ಶನಗಳನ್ನು ನೋಡಿದ್ದಾರೆ.</para>
  <para style="q2" vid="LAM 2:14">ಅವರು ನಿನ್ನ ಬಂಧನವನ್ನು ನೀಗಿಸುವುದಕ್ಕಾಗಿ ನಿನ್ನ ಪಾಪವನ್ನು ಬಯಲಿಗೆ ತರಲಿಲ್ಲ.</para>
  <para style="q1" vid="LAM 2:14">ಆದರೆ ನಿನಗಾಗಿ ಸುಳ್ಳಿನ ಪ್ರವಾದನೆಗಳನ್ನು ಕೊಟ್ಟು</para>
  <para style="q2" vid="LAM 2:14">ಗಡಿಪಾರು ಮಾಡುವುದಕ್ಕೆ ಕಾರಣರಾಗಿದ್ದಾರೆ.<verse eid="LAM 2:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="LAM 2:15"/>ದಾರಿಯಲ್ಲಿ ಹೋಗುವವರೆಲ್ಲರೂ</para>
  <para style="q2" vid="LAM 2:15">ನಿನ್ನ ವಿಷಯದಲ್ಲಿ ತಮ್ಮ ಕೈಗಳನ್ನು ತಟ್ಟುತ್ತಾರೆ.</para>
  <para style="q1" vid="LAM 2:15">ಅವರು ಯೆರೂಸಲೇಮಿನ ಪುತ್ರಿಯ ವಿಷಯದಲ್ಲಿ</para>
  <para style="q2" vid="LAM 2:15">ಸಿಳ್ಳುಹಾಕಿ, ತಲೆಯಾಡಿಸಿ</para>
  <para style="q1" vid="LAM 2:15">ಆ ಮನುಷ್ಯರು ಕರೆಯುತ್ತಿದ್ದ</para>
  <para style="q2" vid="LAM 2:15">ಸೌಂದರ್ಯದ ಸಂಪೂರ್ಣತೆಯೂ,</para>
  <para style="q2" vid="LAM 2:15">ಸರ್ವಭೂಮಿಯ ಸಂತೋಷವೂ ಆಗಿರುವ ನಗರಿಯು ಇದೆಯೋ?<verse eid="LAM 2:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="LAM 2:16"/>ನಿನ್ನ ಎಲ್ಲಾ ಶತ್ರುಗಳು</para>
  <para style="q2" vid="LAM 2:16">ನಿನಗೆ ವಿರೋಧವಾಗಿ ತಮ್ಮ ಬಾಯಿತೆರೆದಿದ್ದಾರೆ.</para>
  <para style="q1" vid="LAM 2:16">“ನಾವು ಆಕೆಯನ್ನು ನುಂಗಿಬಿಟ್ಟೆವು.</para>
  <para style="q2" vid="LAM 2:16">ನಿಶ್ಚಯವಾಗಿ ನಾವು ನಿರೀಕ್ಷಿಸಿದ ದಿನವು ಇದೇ.</para>
  <para style="q1" vid="LAM 2:16">ಅದನ್ನು ನಾವು ಕಣ್ಣಾರೆ ಕಂಡಿದ್ದೇವೆ,”</para>
  <para style="q2" vid="LAM 2:16">ಎಂದು ಅವರು ಕೊಚ್ಚಿಕೊಳ್ಳುತ್ತಾರೆ.<verse eid="LAM 2:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="LAM 2:17"/>ಯೆಹೋವ ದೇವರು ತಾವು ಸಂಕಲ್ಪಿಸಿದ್ದನ್ನು ಮಾಡಿದ್ದಾರೆ.</para>
  <para style="q2" vid="LAM 2:17">ಅವರು ಪುರಾತನ ಕಾಲದ ದಿನಗಳಲ್ಲಿ</para>
  <para style="q2" vid="LAM 2:17">ಆಜ್ಞಾಪಿಸಿದ ತಮ್ಮ ವಾಕ್ಯವನ್ನು ಪೂರೈಸಿದ್ದಾರೆ.</para>
  <para style="q1" vid="LAM 2:17">ಅವರು ಕೆಡವಿ ಕನಿಕರಿಸಲಿಲ್ಲ.</para>
  <para style="q2" vid="LAM 2:17">ಅವರು ನಿನ್ನ ಶತ್ರುವನ್ನು ನಿನ್ನ ವಿಷಯವಾಗಿ ಸಂತೋಷಪಡುವ ಹಾಗೆ ಮಾಡಿದ್ದಾರೆ.</para>
  <para style="q2" vid="LAM 2:17">ಆತನು ನಿನ್ನ ವೈರಿಗಳ ಕೊಂಬನ್ನು ಎತ್ತಿದ್ದಾರೆ.<verse eid="LAM 2:17"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="18" style="v" sid="LAM 2:18"/>ಅವರ ಹೃದಯವು</para>
  <para style="q2" vid="LAM 2:18">ಕರ್ತದೇವರ ಕಡೆಗೆ ಕೂಗಿ,</para>
  <para style="q1" vid="LAM 2:18">ಚೀಯೋನಿನ ಗೋಡೆಯೇ,</para>
  <para style="q2" vid="LAM 2:18">ರಾತ್ರಿ ಹಗಲೂ</para>
  <para style="q2" vid="LAM 2:18">ನಿನ್ನ ಕಣ್ಣೀರು ನದಿಯಂತೆ ಹರಿದು ಹೋಗಲಿ,</para>
  <para style="q1" vid="LAM 2:18">ನಿನಗೆ ವಿಶ್ರಾಂತಿ ಬೇಡ,</para>
  <para style="q2" vid="LAM 2:18">ನಿನ್ನ ಕಣ್ಣ ರೆಪ್ಪೆಯನ್ನು ಮುಚ್ಚಬೇಡ.<verse eid="LAM 2:18"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="LAM 2:19"/>ಎದ್ದೇಳು, ರಾತ್ರಿಯಲ್ಲಿ ಕೂಗು.</para>
  <para style="q2" vid="LAM 2:19">ನಿನ್ನ ಹೃದಯವನ್ನು ಕರ್ತದೇವರ ಸಮ್ಮುಖದಲ್ಲಿ</para>
  <para style="q1" vid="LAM 2:19">ಆರಂಭದ ಜಾವಗಳಲ್ಲಿ</para>
  <para style="q2" vid="LAM 2:19">ನೀರಿನಂತೆ ಹೊಯ್ದುಬಿಡಿರಿ;</para>
  <para style="q1" vid="LAM 2:19">ನಿನ್ನ ಕೈಗಳನ್ನು ಆತನ ಕಡೆಗೆ ಎತ್ತು,</para>
  <para style="q2" vid="LAM 2:19">ಏಕೆಂದರೆ ನಿನ್ನ ಚಿಕ್ಕ ಮಕ್ಕಳ ಪ್ರಾಣವು</para>
  <para style="q1" vid="LAM 2:19">ಪ್ರತಿಯೊಂದು ಬೀದಿಯ ಬದಿಯಲ್ಲಿ</para>
  <para style="q2" vid="LAM 2:19">ಹಸಿವೆಯಿಂದ ದುರ್ಬಲವಾಗಿದೆ.<verse eid="LAM 2:19"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="20" style="v" sid="LAM 2:20"/>ಯೆಹೋವ ದೇವರೇ, ಕಟಾಕ್ಷಿಸಿ:</para>
  <para style="q2" vid="LAM 2:20">ನೀವು ಇದನ್ನು ಯಾರಿಗೆ ಮಾಡಿದಿರೋ ಯೋಚಿಸಿರಿ.</para>
  <para style="q1" vid="LAM 2:20">ಸ್ತ್ರೀಯರು ತಮ್ಮ ಫಲವಾದ</para>
  <para style="q2" vid="LAM 2:20">ಕೂಸುಗಳನ್ನು ತಿನ್ನಬೇಕೇ?</para>
  <para style="q1" vid="LAM 2:20">ಯಾಜಕನು ಮತ್ತು ಪ್ರವಾದಿಯು</para>
  <para style="q2" vid="LAM 2:20">ಕರ್ತದೇವರ ಪರಿಶುದ್ಧ ಸ್ಥಳದಲ್ಲಿ ಹತರಾಗಬೇಕೋ?<verse eid="LAM 2:20"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="21" style="v" sid="LAM 2:21"/>ಯುವಕರು ಮತ್ತು ವೃದ್ಧರು</para>
  <para style="q2" vid="LAM 2:21">ಬೀದಿಗಳ ನೆಲದ ಮೇಲೆ ಮಲಗಿದ್ದಾರೆ.</para>
  <para style="q1" vid="LAM 2:21">ನನ್ನ ಯುವಕರು, ಯುವತಿಯರು</para>
  <para style="q2" vid="LAM 2:21">ಖಡ್ಗದಿಂದ ಹತರಾಗಿದ್ದಾರೆ.</para>
  <para style="q1" vid="LAM 2:21">ನಿನ್ನ ಕೋಪದ ದಿನದಲ್ಲಿ ನೀನು ಅವರನ್ನು ಸಾಯಿಸಿರುವಿರಿ,</para>
  <para style="q2" vid="LAM 2:21">ಕೊಂದುಹಾಕಿದಿರಿ, ಕನಿಕರಿಸಲಿಲ್ಲ.<verse eid="LAM 2:21"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="22" style="v" sid="LAM 2:22"/>ಹಬ್ಬದ ದಿನಕ್ಕೆ ಕರೆಯುವಂತೆಯೇ</para>
  <para style="q2" vid="LAM 2:22">ನನ್ನ ವಿರುದ್ಧವಾಗಿ ಪ್ರತಿಯೊಂದು ದಿಕ್ಕಿನಲ್ಲಿಯ ವಿರೋಧಿಗಳನ್ನು ಕರೆದಿದ್ದೀರಿ.</para>
  <para style="q1" vid="LAM 2:22">ಯೆಹೋವ ದೇವರ ಕೋಪದ ದಿನದಲ್ಲಿ</para>
  <para style="q2" vid="LAM 2:22">ಯಾರೂ ತಪ್ಪಿಸಿಕೊಳ್ಳಲಾರರು, ಉಳಿದುಕೊಳ್ಳಲಾರರು.</para>
  <para style="q1" vid="LAM 2:22">ನಾನು ಬೆಳೆಸಿ ಸಾಕಿದವರನ್ನು</para>
  <para style="q2" vid="LAM 2:22">ವೈರಿಯು ನಾಶಮಾಡಿದ್ದಾನೆ.<verse eid="LAM 2:22"/></para>
  <para style="b"/>
  <para style="b"/>
  <chapter eid="LAM 2"/>
  <chapter number="3" style="c" sid="LAM 3"/>
  <para style="q1">
    <verse number="1" style="v" sid="LAM 3:1"/>ಯೆಹೋವ ದೇವರ ಕೋಪದ ಕೋಲಿನಿಂದ ಕಷ್ಟವನ್ನು ನೋಡಿದ</para>
  <para style="q2" vid="LAM 3:1">ಮನುಷ್ಯನು ನಾನೇ.<verse eid="LAM 3:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="LAM 3:2"/>ಅವರು ನನ್ನನ್ನು ಕರೆತಂದು ನಡೆಸಿದ್ದು</para>
  <para style="q2" vid="LAM 3:2">ಕತ್ತಲೆಗೇ ಹೊರತು ಬೆಳಕಿಗಲ್ಲ.<verse eid="LAM 3:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="LAM 3:3"/>ನಿಶ್ಚಯವಾಗಿ ಅವರು ನನಗೆ ವಿರೋಧವಾಗಿ ತಿರುಗಿದ್ದಾರೆ.</para>
  <para style="q2" vid="LAM 3:3">ಅವರು ದಿನವೆಲ್ಲಾ ತಮ್ಮ ಕೈಯನ್ನು ನನಗೆ ವಿರೋಧವಾಗಿ ತಿರುಗಿಸಿದ್ದಾರೆ.<verse eid="LAM 3:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="LAM 3:4"/>ನನ್ನ ಮಾಂಸ, ಚರ್ಮವನ್ನು ಆತನು ಹಳೆಯದನ್ನಾಗಿ ಮಾಡಿದ್ದಾರೆ.</para>
  <para style="q2" vid="LAM 3:4">ಅವರು ನನ್ನ ಎಲುಬುಗಳನ್ನು ಮುರಿದಿದ್ದಾರೆ.<verse eid="LAM 3:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="LAM 3:5"/>ಅವರು ನನಗೆ ವಿರೋಧವಾಗಿ ಕಟ್ಟಿದ್ದಾರೆ ಮತ್ತು ನನ್ನನ್ನು ವಿಷದಿಂದಲೂ,</para>
  <para style="q2" vid="LAM 3:5">ಸಂಕಟದಿಂದಲೂ ಸುತ್ತಿಕೊಂಡಿದ್ದಾರೆ.<verse eid="LAM 3:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="LAM 3:6"/>ಅವರು ನನ್ನನ್ನು ಬಹುಕಾಲದ ಹಿಂದೆ ಸತ್ತವರ ಹಾಗೆ,</para>
  <para style="q2" vid="LAM 3:6">ಕತ್ತಲೆಯ ಸ್ಥಳಗಳಲ್ಲಿ ಇರಿಸಿದ್ದಾರೆ.<verse eid="LAM 3:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="LAM 3:7"/>ನಾನು ಹೊರಗೆ ಬಾರದ ಹಾಗೆ, ಅವರು ನನ್ನ ಸುತ್ತಲೂ ಗೋಡೆಯನ್ನು ಕಟ್ಟಿದ್ದಾರೆ.</para>
  <para style="q2" vid="LAM 3:7">ಅವರು ನನ್ನ ಸಂಕೋಲೆಯ ಭಾರವನ್ನು ಹೆಚ್ಚಿಸಿದ್ದಾರೆ.<verse eid="LAM 3:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="LAM 3:8"/>ನಾನು ಕರೆದು ಕೂಗಿದರೂ</para>
  <para style="q2" vid="LAM 3:8">ಅವರು ನನ್ನ ಪ್ರಾರ್ಥನೆಯನ್ನು ಲಾಲಿಸುವುದಿಲ್ಲ.<verse eid="LAM 3:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="LAM 3:9"/>ಕೆತ್ತಿದ ಕಲ್ಲಿನಿಂದ ನನ್ನ ಮಾರ್ಗಗಳನ್ನು ಮುಚ್ಚಿ,</para>
  <para style="q2" vid="LAM 3:9">ಆ ನನ್ನ ದಾರಿಗಳನ್ನು ಡೊಂಕು ಮಾಡಿದ್ದಾನೆ.<verse eid="LAM 3:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="LAM 3:10"/>ಅವರು ನನಗೆ ಹೊಂಚು ಹಾಕುವ ಕರಡಿಯ ಹಾಗೆಯೂ,</para>
  <para style="q2" vid="LAM 3:10">ಗುಪ್ತ ಸ್ಥಳಗಳಲ್ಲಿರುವ ಸಿಂಹದ ಹಾಗೆಯೂ ಇದ್ದಾರೆ.<verse eid="LAM 3:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="LAM 3:11"/>ಅವರು ನನ್ನ ಮಾರ್ಗಗಳನ್ನು ತಪ್ಪಿಸಿ, ನನ್ನನ್ನು ತುಂಡುಗಳನ್ನಾಗಿ ಕತ್ತರಿಸಿ,</para>
  <para style="q2" vid="LAM 3:11">ನನ್ನನ್ನು ಹಾಳು ಮಾಡಿದ್ದಾರೆ.<verse eid="LAM 3:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="LAM 3:12"/>ಅವರು ತನ್ನ ಬಿಲ್ಲನ್ನು ಬಗ್ಗಿಸಿದ್ದಾರೆ,</para>
  <para style="q2" vid="LAM 3:12">ನನ್ನನ್ನು ಬಾಣಕ್ಕೆ ಗುರಿಮಾಡಿದ್ದಾರೆ.<verse eid="LAM 3:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="LAM 3:13"/>ಅವರು ತನ್ನ ಬತ್ತಳಿಕೆಯಲ್ಲಿನ ಬಾಣಗಳನ್ನು</para>
  <para style="q2" vid="LAM 3:13">ನನ್ನ ಅಂತರಂಗಗಳಲ್ಲಿ ತೂರಿ ಹೋಗುವಹಾಗೆ ಮಾಡಿದ್ದಾರೆ.<verse eid="LAM 3:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="LAM 3:14"/>ನಾನು ನನ್ನ ಎಲ್ಲಾ ಜನರಿಗೆ ಹಾಸ್ಯವೂ,</para>
  <para style="q2" vid="LAM 3:14">ದಿನವೆಲ್ಲವೂ ಅವರ ಗೇಲಿಯ ಹಾಡಾಗಿಯೂ ಇದ್ದೇನೆ.<verse eid="LAM 3:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="LAM 3:15"/>ಅವರು ನನ್ನನ್ನು ಕಹಿಯಿಂದ ತುಂಬಿಸಿ,</para>
  <para style="q2" vid="LAM 3:15">ವಿಷ ಸಸ್ಯಗಳಿಂದ ನನ್ನನ್ನು ತಣಿಸಿದ್ದಾರೆ.<verse eid="LAM 3:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="LAM 3:16"/>ಅವರು ನುರುಜು ಕಲ್ಲುಗಳಿಂದ ನನ್ನ ಹಲ್ಲುಗಳನ್ನು ಮುರಿದು,</para>
  <para style="q2" vid="LAM 3:16">ಅವರು ನನ್ನನ್ನು ಧೂಳಿನಲ್ಲಿ ತುಳಿದಿದ್ದಾರೆ.<verse eid="LAM 3:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="LAM 3:17"/>ನನ್ನ ಪ್ರಾಣವನ್ನು ಸಮಾಧಾನದಿಂದ ದೂರ ಮಾಡಿದ್ದಾರೆ,</para>
  <para style="q2" vid="LAM 3:17">ನಾನು ಸಮೃದ್ಧಿಯನ್ನು ಮರೆತುಬಿಟ್ಟೆನು.<verse eid="LAM 3:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="LAM 3:18"/>“ಅಯ್ಯೋ, ನನ್ನ ಬಲವು ಮತ್ತು</para>
  <para style="q2" vid="LAM 3:18">ನನ್ನ ನಿರೀಕ್ಷೆಯು ಯೆಹೋವ ದೇವರಿಂದ ನಾಶವಾದವು,”</para>
  <para style="q2" vid="LAM 3:18">ಎಂದು ನಾನು ಹೇಳಿದೆನು.<verse eid="LAM 3:18"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="LAM 3:19"/>ನನ್ನ ಸಂಕಟವನ್ನು, ನನ್ನ ಅಲೆದಾಡುವಿಕೆಯನ್ನು,</para>
  <para style="q2" vid="LAM 3:19">ನನ್ನ ಕಹಿಯನ್ನು, ನನ್ನ ವಿಷತನವನ್ನು ನಾನು ಜ್ಞಾಪಕಮಾಡಿಕೊಂಡಿದ್ದೇನೆ.<verse eid="LAM 3:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="LAM 3:20"/>ನನ್ನ ಪ್ರಾಣವು ಇನ್ನೂ ಅವುಗಳನ್ನು ಜ್ಞಾಪಿಸಿಕೊಳ್ಳುತ್ತಾ</para>
  <para style="q2" vid="LAM 3:20">ನನ್ನೊಳಗೆ ಕುಂದಿಹೋಗಿದೆ.<verse eid="LAM 3:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="LAM 3:21"/>ಇದನ್ನು ನಾನು ನನ್ನ ಮನಸ್ಸಿಗೆ ತಂದುಕೊಳ್ಳುತ್ತೇನೆ.</para>
  <para style="q2" vid="LAM 3:21">ಆದ್ದರಿಂದ ನನಗೆ ನಿರೀಕ್ಷೆ ಇದೆ.<verse eid="LAM 3:21"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="22" style="v" sid="LAM 3:22"/>ನಾವು ನಾಶವಾಗದೇ ಉಳಿದಿರುವುದು ಯೆಹೋವ ದೇವರ ಮಹಾ ಪ್ರೀತಿಯಿಂದಲೇ.</para>
  <para style="q2" vid="LAM 3:22">ಏಕೆಂದರೆ ಅವರ ಅನುಕಂಪಗಳು ಮುಗಿಯುವುದಿಲ್ಲ.<verse eid="LAM 3:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="LAM 3:23"/>ಅವು ಪ್ರತಿ ಮುಂಜಾನೆಯೂ ಹೊಸದಾಗಿರುವುವು.</para>
  <para style="q2" vid="LAM 3:23">ನಿನ್ನ ನಂಬಿಗಸ್ತಿಕೆಯು ಮಹತ್ತಾದದ್ದು.<verse eid="LAM 3:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="LAM 3:24"/>“ಯೆಹೋವ ದೇವರೇ ನನ್ನ ಪಾಲು,</para>
  <para style="q2" vid="LAM 3:24">ಆದ್ದರಿಂದ ನಾನು ಅವರಿಗಾಗಿ ಕಾದಿರುತ್ತೇನೆ,”</para>
  <para style="q2" vid="LAM 3:24">ಎಂದು ನಾನು ನನ್ನೊಳಗೆ ಎಂದುಕೊಳ್ಳುವೆನು.<verse eid="LAM 3:24"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="25" style="v" sid="LAM 3:25"/>ಆತನನ್ನು ನಿರೀಕ್ಷಿಸುವವರಿಗೂ,</para>
  <para style="q2" vid="LAM 3:25">ಆತನನ್ನು ಹುಡಕುವವರಿಗೂ ಯೆಹೋವ ದೇವರು ಒಳ್ಳೆಯವರಾಗಿದ್ದಾರೆ.<verse eid="LAM 3:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="LAM 3:26"/>ಮನುಷ್ಯನು ಮೌನವಾಗಿ</para>
  <para style="q2" vid="LAM 3:26">ಯೆಹೋವ ದೇವರ ರಕ್ಷಣೆಗೆ ಕಾಯುವುದು ಒಳ್ಳೆಯದು.<verse eid="LAM 3:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="LAM 3:27"/>ತನ್ನ ಯೌವನದಲ್ಲಿ</para>
  <para style="q2" vid="LAM 3:27">ನೊಗವನ್ನು ಹೊಂದಿರುವುದು ಮಾನವನಿಗೆ ಒಳ್ಳೆಯದು.<verse eid="LAM 3:27"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="28" style="v" sid="LAM 3:28"/>ಅವನು ಒಂಟಿಯಾಗಿ ಕುಳಿತು ಮೌನವಾಗಿರಲಿ.</para>
  <para style="q2" vid="LAM 3:28">ಏಕೆಂದರೆ ಯೆಹೋವ ದೇವರೇ ಅದನ್ನು ಅವನ ಮೇಲೆ ಹೊರಿಸಿದ್ದಾರೆ.<verse eid="LAM 3:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="LAM 3:29"/>ಒಂದು ವೇಳೆ ನಿರೀಕ್ಷೆ ಇರಬಹುದೇನೋ ಎಂದು</para>
  <para style="q2" vid="LAM 3:29">ಅವನು ತನ್ನ ಮುಖವನ್ನು ಧೂಳಿನಲ್ಲಿ ಇಟ್ಟುಕೊಳ್ಳಲಿ.<verse eid="LAM 3:29"/></para>
  <para style="q1">
    <verse number="30" style="v" sid="LAM 3:30"/>ಅವನು ತನ್ನನ್ನು ಹೊಡೆಯುವವನಿಗೆ ಕೆನ್ನೆ ಕೊಡಲಿ.</para>
  <para style="q2" vid="LAM 3:30">ಅವನು ನಿಂದೆಯಿಂದಲೇ ತುಂಬಿರಲಿ.<verse eid="LAM 3:30"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="31" style="v" sid="LAM 3:31"/>ಏಕೆಂದರೆ ಕರ್ತದೇವರು</para>
  <para style="q2" vid="LAM 3:31">ಜನರನ್ನು ಎಂದೆಂದಿಗೂ ತಳ್ಳಿಬಿಡುವುದಿಲ್ಲ.<verse eid="LAM 3:31"/></para>
  <para style="q1">
    <verse number="32" style="v" sid="LAM 3:32"/>ಆತನು ದುಃಖಪಡಿಸಿದರೂ,</para>
  <para style="q2" vid="LAM 3:32">ತನ್ನ ಒಡಂಬಡಿಕೆಯ ಮಹಾಪ್ರೀತಿಯಿಂದ ಅನುಕಂಪ ತೋರಿಸುವರು.<verse eid="LAM 3:32"/></para>
  <para style="q1">
    <verse number="33" style="v" sid="LAM 3:33"/>ಏಕೆಂದರೆ ಆತನು ಬೇಕೆಂದು ಮನುಷ್ಯರ ಮಕ್ಕಳಿಗೆ ಬಾಧೆಯನ್ನೂ,</para>
  <para style="q2" vid="LAM 3:33">ದುಃಖವನ್ನೂ ಕೊಡುವುದಿಲ್ಲ.<verse eid="LAM 3:33"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="34" style="v" sid="LAM 3:34"/>ಭೂಲೋಕದ ಸೆರೆಯವರನ್ನೆಲ್ಲಾ</para>
  <para style="q2" vid="LAM 3:34">ಕಾಲುಗಳ ಕೆಳಗೆ ತುಳಿಯುವುದನ್ನೂ,<verse eid="LAM 3:34"/></para>
  <para style="q1">
    <verse number="35" style="v" sid="LAM 3:35"/>ಮಹೋನ್ನತನ ಸನ್ನಿಧಿಯಲ್ಲಿ</para>
  <para style="q2" vid="LAM 3:35">ಮನುಷ್ಯನ ನ್ಯಾಯವನ್ನು ನಿರಾಕರಿಸುವುದನ್ನೂ,<verse eid="LAM 3:35"/></para>
  <para style="q1">
    <verse number="36" style="v" sid="LAM 3:36"/>ಮನುಷ್ಯನನ್ನು ಅವನ ಜಗಳದಲ್ಲಿ</para>
  <para style="q2" vid="LAM 3:36">ಅನ್ಯಾಯವಾಗಿ ತೀರಿಸುವುದು ಕರ್ತದೇವರು ಮೆಚ್ಚುವುದಿಲ್ಲ.<verse eid="LAM 3:36"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="37" style="v" sid="LAM 3:37"/>ಕರ್ತದೇವರು ಆಜ್ಞಾಪಿಸದೆ ಇರುವಾಗ,</para>
  <para style="q2" vid="LAM 3:37">ಸಂಭವಿಸಿ ನಡೆಯುವ ಹಾಗೆ ಹೇಳುವವನು ಯಾರು?<verse eid="LAM 3:37"/></para>
  <para style="q1">
    <verse number="38" style="v" sid="LAM 3:38"/>ಮಹೋನ್ನತರ ಬಾಯಿಂದ ಕೇಡೂ,</para>
  <para style="q2" vid="LAM 3:38">ಒಳ್ಳೆಯ ಸಂಗತಿಗಳೂ ಹೊರಡುವುದಿಲ್ಲವೇ?<verse eid="LAM 3:38"/></para>
  <para style="q1">
    <verse number="39" style="v" sid="LAM 3:39"/>ಬದುಕುವ ಮನುಷ್ಯನು</para>
  <para style="q2" vid="LAM 3:39">ತನ್ನ ಪಾಪಗಳ ಶಿಕ್ಷೆಗಾಗಿ ಗೊಣಗುಟ್ಟುವುದೇಕೆ?<verse eid="LAM 3:39"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="40" style="v" sid="LAM 3:40"/>ನಾವು ನಮ್ಮ ಮಾರ್ಗಗಳನ್ನು ಪರಿಶೋಧಿಸಿ,</para>
  <para style="q2" vid="LAM 3:40">ಪರೀಕ್ಷಿಸಿಕೊಂಡು ಆಮೇಲೆ ಯೆಹೋವ ದೇವರ ಬಳಿಗೆ ತಿರುಗಿಕೊಳ್ಳೋಣ.<verse eid="LAM 3:40"/></para>
  <para style="q1">
    <verse number="41" style="v" sid="LAM 3:41"/>ನಮ್ಮ ಹೃದಯಗಳನ್ನು ನಮ್ಮ ಕೈಗಳೊಂದಿಗೆ</para>
  <para style="q2" vid="LAM 3:41">ಪರಲೋಕದ ದೇವರ ಕಡೆಗೆ ಎತ್ತಿಕೊಳ್ಳೋಣ.<verse eid="LAM 3:41"/></para>
  <para style="q1">
    <verse number="42" style="v" sid="LAM 3:42"/>ನಾವು ದ್ರೋಹಮಾಡಿದ್ದೇವೆ ಮತ್ತು ಎದುರು ಬಿದ್ದಿದ್ದೇವೆ,</para>
  <para style="q2" vid="LAM 3:42">ನೀವು ಮನ್ನಿಸಲಿಲ್ಲ.<verse eid="LAM 3:42"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="43" style="v" sid="LAM 3:43"/>ಕೋಪದಲ್ಲಿ ನಮ್ಮನ್ನು ಮುಚ್ಚಿ ಹಿಂಸಿಸಿದ್ದೀರಿ.</para>
  <para style="q2" vid="LAM 3:43">ಕನಿಕರಿಸದೆ ಕೊಂದು ಹಾಕಿರುವಿರಿ.<verse eid="LAM 3:43"/></para>
  <para style="q1">
    <verse number="44" style="v" sid="LAM 3:44"/>ನಮ್ಮ ಪ್ರಾರ್ಥನೆಯು ನಿನ್ನ ಸನ್ನಿಧಿಗೆ ಸೇರದಂತೆ</para>
  <para style="q2" vid="LAM 3:44">ನಿನ್ನನ್ನು ಮೇಘದಿಂದ ಮುಚ್ಚಿಕೊಂಡಿದ್ದೀರಿ.<verse eid="LAM 3:44"/></para>
  <para style="q1">
    <verse number="45" style="v" sid="LAM 3:45"/>ನೀನು ನಮ್ಮನ್ನು ಜನರ ಮಧ್ಯದಲ್ಲಿ ಕಲ್ಮಷವನ್ನಾಗಿಯೂ,</para>
  <para style="q2" vid="LAM 3:45">ಕಸವನ್ನಾಗಿಯೂ ಮಾಡಿದ್ದೀಯೆ.<verse eid="LAM 3:45"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="46" style="v" sid="LAM 3:46"/>ನಮ್ಮ ಎಲ್ಲಾ ಶತ್ರುಗಳು</para>
  <para style="q2" vid="LAM 3:46">ನಮಗೆ ವಿರುದ್ಧವಾಗಿ ಅವರ ಬಾಯಿಗಳನ್ನು ತೆರೆದಿದ್ದಾರೆ.<verse eid="LAM 3:46"/></para>
  <para style="q1">
    <verse number="47" style="v" sid="LAM 3:47"/>ಭಯವನ್ನೂ, ನಾಶವನ್ನೂ</para>
  <para style="q2" vid="LAM 3:47">ನಾವು ಅನುಭವಿಸಿದ್ದೇವೆ.<verse eid="LAM 3:47"/></para>
  <para style="q1">
    <verse number="48" style="v" sid="LAM 3:48"/>ನನ್ನ ಜನರ ನಾಶದ ನಿಮಿತ್ತವಾಗಿ,</para>
  <para style="q2" vid="LAM 3:48">ನನ್ನ ಕಣ್ಣಿನಿಂದ ನೀರು ನದಿಯಾಗಿ ಹರಿದು ಹೋಗುತ್ತದೆ.<verse eid="LAM 3:48"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="49" style="v" sid="LAM 3:49"/>ಯೆಹೋವ ದೇವರು ಕಟಾಕ್ಷಿಸಿ,</para>
  <para style="q2" vid="LAM 3:49">ಪರಲೋಕದಿಂದ ನೋಡುವ ತನಕ</para>
  <para style="q1" vid="LAM 3:49">ನೇತ್ರವು ನಿರಂತರ ಕಣ್ಣೀರು ಸುರಿಸುತ್ತದೆ.<verse eid="LAM 3:49"/></para>
  <para style="q2">
    <verse number="50" style="v" sid="LAM 3:50"/>ವಿಶ್ರಮಿಸಿಕೊಳ್ಳುವುದೂ ಇಲ್ಲ.<verse eid="LAM 3:50"/></para>
  <para style="q1">
    <verse number="51" style="v" sid="LAM 3:51"/>ನನ್ನ ನಗರದ ಪುತ್ರಿಯರೆಲ್ಲರ ನಿಮಿತ್ತವಾಗಿ</para>
  <para style="q2" vid="LAM 3:51">ನನ್ನ ಕಣ್ಣುಗಳು ನನ್ನ ಹೃದಯವನ್ನು ಪೀಡಿಸಿದೆ.<verse eid="LAM 3:51"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="52" style="v" sid="LAM 3:52"/>ನನ್ನ ಶತ್ರುಗಳು ಕಾರಣವಿಲ್ಲದೆ</para>
  <para style="q2" vid="LAM 3:52">ಪಕ್ಷಿಯಂತೆ ನನ್ನನ್ನು ಕಠೋರವಾಗಿ ಹಿಂದಟ್ಟಿ ಬೇಟೆಯಾಡಿದರು.<verse eid="LAM 3:52"/></para>
  <para style="q1">
    <verse number="53" style="v" sid="LAM 3:53"/>ಅವರು ಕಾರಾಗೃಹದಲ್ಲಿ ನನ್ನ ಜೀವವನ್ನು ತೆಗೆದುಹಾಕಿ,</para>
  <para style="q2" vid="LAM 3:53">ನನ್ನ ಮೇಲೆ ಕಲ್ಲನ್ನು ಹಾಕಿದ್ದಾರೆ.<verse eid="LAM 3:53"/></para>
  <para style="q1">
    <verse number="54" style="v" sid="LAM 3:54"/>ನನ್ನ ತಲೆಯ ಮೇಲೆ ನೀರು ಹರಿಯಿತು.</para>
  <para style="q2" vid="LAM 3:54">ಆಗ ನಾನು ನಾಶವಾದೆನು ಅಂದುಕೊಂಡೆನು.<verse eid="LAM 3:54"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="55" style="v" sid="LAM 3:55"/>ಯೆಹೋವ ದೇವರೇ, ನಾನು ಆಳವಾದ ಕಾರಾಗೃಹದಿಂದ</para>
  <para style="q2" vid="LAM 3:55">ನಿಮ್ಮ ಹೆಸರನ್ನು ಎತ್ತಿ ಬೇಡಿಕೊಂಡೆನು.<verse eid="LAM 3:55"/></para>
  <para style="q1">
    <verse number="56" style="v" sid="LAM 3:56"/>ನೀನು ನನ್ನ ಸ್ವರವನ್ನು ಕೇಳಿದ್ದೀ.</para>
  <para style="q2" vid="LAM 3:56">“ನನ್ನ ಶ್ವಾಸಕ್ಕೂ, ನನ್ನ ಕೂಗಿಗೂ ನಿನ್ನ ಕಿವಿಯನ್ನು ಮರೆಮಾಡಬೇಡಿರಿ.”<verse eid="LAM 3:56"/></para>
  <para style="q1">
    <verse number="57" style="v" sid="LAM 3:57"/>ನಾನು ನಿನ್ನನ್ನು ಕರೆದ ದಿನದಲ್ಲಿ ನೀನು ಸಮೀಪಕ್ಕೆ ಬಂದು,</para>
  <para style="q2" vid="LAM 3:57">“ಭಯಪಡಬೇಡ,” ಎಂದು ಹೇಳಿದಿರಿ.<verse eid="LAM 3:57"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="58" style="v" sid="LAM 3:58"/>ಕರ್ತದೇವರೇ, ನೀನು ನನ್ನ ಪ್ರಾಣದ ವ್ಯಾಜ್ಯಗಳನ್ನು ನಡೆಸಿ,</para>
  <para style="q2" vid="LAM 3:58">ನನ್ನ ಜೀವವನ್ನು ವಿಮೋಚಿಸಿದ್ದೀರಿ.<verse eid="LAM 3:58"/></para>
  <para style="q1">
    <verse number="59" style="v" sid="LAM 3:59"/>ಯೆಹೋವ ದೇವರೇ, ನೀವು ನನ್ನ ಅನ್ಯಾಯವನ್ನು ನೋಡಿದ್ದೀರಿ,</para>
  <para style="q2" vid="LAM 3:59">ನೀವು ನನ್ನ ನ್ಯಾಯವನ್ನು ತೀರಿಸಿರಿ.<verse eid="LAM 3:59"/></para>
  <para style="q1">
    <verse number="60" style="v" sid="LAM 3:60"/>ನನಗೆ ವಿರುದ್ಧವಾಗಿ</para>
  <para style="q2" vid="LAM 3:60">ಅವರ ಎಲ್ಲಾ ಪ್ರತೀಕಾರವನ್ನೂ ನೋಡಿದ್ದೀರಲ್ಲಾ.<verse eid="LAM 3:60"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="61" style="v" sid="LAM 3:61"/>ಯೆಹೋವ ದೇವರೇ, ಅವರ ಎಲ್ಲಾ ಕಲ್ಪನೆಗಳನ್ನೂ ಮತ್ತು</para>
  <para style="q2" vid="LAM 3:61">ನನಗೆ ವಿರುದ್ಧವಾಗಿ ಹೇಳುವವರ ತುಟಿಗಳನ್ನೂ,<verse eid="LAM 3:61"/></para>
  <para style="q1">
    <verse number="62" style="v" sid="LAM 3:62"/>ದಿನವಿಡೀ ನನಗೆ ವಿರುದ್ಧವಾದ</para>
  <para style="q2" vid="LAM 3:62">ಅವರ ದುರಾಲೋಚನೆಯನ್ನೂ ಕೇಳಿರುವಿರಿ.<verse eid="LAM 3:62"/></para>
  <para style="q1">
    <verse number="63" style="v" sid="LAM 3:63"/>ಅವರನ್ನು ನೋಡು! ಕುಳಿತು ಅಥವಾ ನಿಂತಾಗ,</para>
  <para style="q2" vid="LAM 3:63">ಅವರು ತಮ್ಮ ಹಾಡುಗಳಲ್ಲಿ ನನ್ನನ್ನು ಅಣಕಿಸುತ್ತಾರೆ.<verse eid="LAM 3:63"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="64" style="v" sid="LAM 3:64"/>ಯೆಹೋವ ದೇವರೇ, ಅವರ ಕೈಕೆಲಸಗಳ ಪ್ರಕಾರ ಅವರಿಗೆ</para>
  <para style="q2" vid="LAM 3:64">ಪ್ರತಿಫಲವನ್ನು ಕೊಡಿ.<verse eid="LAM 3:64"/></para>
  <para style="q1">
    <verse number="65" style="v" sid="LAM 3:65"/>ಅವರಿಗೆ ದುಃಖಕರವಾದ ಹೃದಯವನ್ನೂ,</para>
  <para style="q2" vid="LAM 3:65">ನಿಮ್ಮ ಶಾಪವನ್ನೂ ಕೊಡಿ.<verse eid="LAM 3:65"/></para>
  <para style="q1">
    <verse number="66" style="v" sid="LAM 3:66"/>ಯೆಹೋವ ದೇವರೇ, ಆಕಾಶದ ಕೆಳಗಿನಿಂದ ಕೋಪದಿಂದ</para>
  <para style="q2" vid="LAM 3:66">ಅವರನ್ನು ಹಿಂಸಿಸಿ ಹಾಳುಮಾಡಿರಿ.<verse eid="LAM 3:66"/></para>
  <para style="b"/>
  <para style="b"/>
  <chapter eid="LAM 3"/>
  <chapter number="4" style="c" sid="LAM 4"/>
  <para style="q1">
    <verse number="1" style="v" sid="LAM 4:1"/>ಬಂಗಾರವು ಹೇಗೆ ಮಸುಕಾಯಿತು!</para>
  <para style="q2" vid="LAM 4:1">ಬಹಳ ಶುದ್ಧವಾದ ಬಂಗಾರವು ಹೇಗೆ ಬದಲಾಯಿತು!</para>
  <para style="q1" vid="LAM 4:1">ಪರಿಶುದ್ಧಸ್ಥಳದ ಕಲ್ಲುಗಳೂ</para>
  <para style="q2" vid="LAM 4:1">ಬೀದಿಯ ಬದಿಯಲ್ಲಿ ಚೆಲ್ಲಾಪಿಲ್ಲಿಯಾಗಿವೆ.<verse eid="LAM 4:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="LAM 4:2"/>ಅಪರಂಜಿಗೆ ಸಮಾನರಾದ ಚೀಯೋನಿನ ಅಮೂಲ್ಯ ಪುತ್ರರು,</para>
  <para style="q2" vid="LAM 4:2">ಈಗ ಕುಂಬಾರನ ಕೈಕೆಲಸದ ಮಣ್ಣಿನ ಮಡಕೆಯಂತೆ ತಿರಸ್ಕೃತರಾಗಿದ್ದಾರಲ್ಲಾ!<verse eid="LAM 4:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="LAM 4:3"/>ನರಿಗಳೂ ತಮ್ಮ ಕೆಚ್ಚಲನ್ನು ಹೊರ ಎಳೆದು</para>
  <para style="q2" vid="LAM 4:3">ತಮ್ಮ ಮರಿಗಳಿಗೆ ಹಾಲು ಕುಡಿಸುತ್ತವೆ.</para>
  <para style="q1" vid="LAM 4:3">ಆದರೆ ನನ್ನ ಜನರು ಅರಣ್ಯದಲ್ಲಿರುವ</para>
  <para style="q2" vid="LAM 4:3">ಉಷ್ಟ್ರಪಕ್ಷಿಗಳ ಹಾಗೆ ಕ್ರೂರವಾಗಿದ್ದಾರೆ.<verse eid="LAM 4:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="LAM 4:4"/>ಹಸುಳೆಗಳ ನಾಲಿಗೆಯು ದಾಹದಿಂದ</para>
  <para style="q2" vid="LAM 4:4">ಅಂಗಳಕ್ಕೆ ಹತ್ತುತ್ತದೆ.</para>
  <para style="q1" vid="LAM 4:4">ಎಳೆಯ ಕೂಸುಗಳು ಅನ್ನ ಕೇಳುತ್ತವೆ.</para>
  <para style="q2" vid="LAM 4:4">ಆದರೆ ಅವರಿಗೆ ಯಾರೂ ಅದನ್ನು ಕೊಡುವುದಿಲ್ಲ.<verse eid="LAM 4:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="LAM 4:5"/>ರುಚಿಯಾದವುಗಳನ್ನು ಒಮ್ಮೆ ತಿಂದವರು</para>
  <para style="q2" vid="LAM 4:5">ಬೀದಿಗಳಲ್ಲಿ ಹಾಳಾಗಿದ್ದಾರೆ.</para>
  <para style="q1" vid="LAM 4:5">ಚಿಕ್ಕಂದಿನಿಂದಲೂ ಶ್ರೇಷ್ಠ ವಸ್ತ್ರವನ್ನು ತೊಡುತ್ತಿದ್ದವರು,</para>
  <para style="q2" vid="LAM 4:5">ತಿಪ್ಪೆಗಳಲ್ಲಿ ಬಿದ್ದುಕೊಂಡಿದ್ದಾರೆ.<verse eid="LAM 4:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="LAM 4:6"/>ನನ್ನ ಜನರ ಅಕ್ರಮದ ದಂಡನೆಯು</para>
  <para style="q2" vid="LAM 4:6">ಸೊದೋಮಿನ ಪಾಪದ ದಂಡನೆಗಿಂತ ದೊಡ್ಡದು.</para>
  <para style="q1" vid="LAM 4:6">ಅದು ಕ್ಷಣಮಾತ್ರದಲ್ಲಿ ಕೆಡವಿ ಹಾಕಲಾಯಿತು ಮತ್ತು</para>
  <para style="q2" vid="LAM 4:6">ಅವಳಿಗೆ ಸಹಾಯಮಾಡಲು ಯಾವ ಕೈಗಳೂ ಇರಲಿಲ್ಲ.<verse eid="LAM 4:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="LAM 4:7"/>ಅವಳ ರಾಜಕುಮಾರರು ಹಿಮಕ್ಕಿಂತಲೂ ಪ್ರಕಾಶಮಾನವಾಗಿದ್ದರು.</para>
  <para style="q2" vid="LAM 4:7">ಹಾಲಿಗಿಂತಲೂ ಬೆಳ್ಳಗಿದ್ದರು.</para>
  <para style="q1" vid="LAM 4:7">ಅವರು ಮೈಕಟ್ಟಿನಲ್ಲಿ ಹವಳಕ್ಕಿಂತಲೂ ಕೆಂಪಾಗಿದ್ದರು.</para>
  <para style="q2" vid="LAM 4:7">ಅವರ ಹೊಳಪು ಇಂದ್ರನೀಲ ಮಣಿಯ ಹಾಗಿತ್ತು.<verse eid="LAM 4:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="LAM 4:8"/>ಆದರೆ ಈಗ ಅವರ ರೂಪವು ಕಲ್ಲಿದ್ದಲಿನಂತೆ ಕಪ್ಪಾಗಿದೆ.</para>
  <para style="q2" vid="LAM 4:8">ಬೀದಿಗಳಲ್ಲಿ ಅವರು ಯಾರೆಂಬುದು ತಿಳಿಯಲಿಲ್ಲ.</para>
  <para style="q1" vid="LAM 4:8">ಅವರ ಚರ್ಮವು ಅವರ ಎಲುಬುಗಳಿಗೆ ಹತ್ತಿಕೊಂಡಿದೆ.</para>
  <para style="q2" vid="LAM 4:8">ಅದು ಒಣಗಿ ಕಡ್ಡಿಯ ಹಾಗೆ ಆಗಿದೆ.<verse eid="LAM 4:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="LAM 4:9"/>ಖಡ್ಗದಿಂದ ಹತರಾದವರು ಹಸಿವೆಯಿಂದ</para>
  <para style="q2" vid="LAM 4:9">ಹತರಾದವರಿಗಿಂತಲೂ ಲೇಸು.</para>
  <para style="q1" vid="LAM 4:9">ಏಕೆಂದರೆ, ಇವರು ಭೂಮಿಯ ಫಲಗಳಿಲ್ಲದೆ</para>
  <para style="q2" vid="LAM 4:9">ಕ್ಷಾಮದ ಪೆಟ್ಟನ್ನು ತಿಂದು, ಕ್ಷಯಿಸಿ ಹೋದರು.<verse eid="LAM 4:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="LAM 4:10"/>ಕನಿಕರ ತುಂಬಿದ ಸ್ತ್ರೀಯರ ಕೈಗಳು</para>
  <para style="q2" vid="LAM 4:10">ತಮ್ಮ ಸ್ವಂತ ಮಕ್ಕಳನ್ನೇ ಬೇಯಿಸಿದವು.</para>
  <para style="q1" vid="LAM 4:10">ಇವರು ನನ್ನ ಜನರ ನಾಶದಲ್ಲಿ</para>
  <para style="q2" vid="LAM 4:10">ಅವರಿಗೆ ಆಹಾರವಾದರು.<verse eid="LAM 4:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="LAM 4:11"/>ಯೆಹೋವ ದೇವರು ತಮ್ಮ ರೋಷವನ್ನು ತೀರಿಸಿದ್ದಾರೆ.</para>
  <para style="q2" vid="LAM 4:11">ಅವರು ತಮ್ಮ ಉಗ್ರವಾದ ಕೋಪವನ್ನು ಸುರಿದಿದ್ದಾರೆ.</para>
  <para style="q1" vid="LAM 4:11">ಚೀಯೋನಿನಲ್ಲಿ ಹೊತ್ತಿಸಿದ ಬೆಂಕಿಯು</para>
  <para style="q2" vid="LAM 4:11">ಅದರ ಅಸ್ತಿವಾರಗಳನ್ನು ತಿಂದುಬಿಟ್ಟಿತು.<verse eid="LAM 4:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="LAM 4:12"/>ಭೂರಾಜರೂ, ವಿರೋಧಿಯೂ,</para>
  <para style="q2" vid="LAM 4:12">ಶತ್ರುವೂ ಯೆರೂಸಲೇಮಿನ ಬಾಗಿಲುಗಳಲ್ಲಿ ಪ್ರವೇಶಿಸಿದ್ದನ್ನು</para>
  <para style="q2" vid="LAM 4:12">ಪ್ರಪಂಚದ ಎಲ್ಲಾ ನಿವಾಸಿಗಳೂ ನಂಬುತ್ತಿರಲಿಲ್ಲ.<verse eid="LAM 4:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="LAM 4:13"/>ಅವಳ ಪ್ರವಾದಿಗಳ ಪಾಪಗಳಿಗೋಸ್ಕರವೂ,</para>
  <para style="q2" vid="LAM 4:13">ಅವಳ ಯಾಜಕರ ಅಕ್ರಮಗಳಿಗೋಸ್ಕರವೂ ಹೀಗಾಯಿತು.</para>
  <para style="q1" vid="LAM 4:13">ಏಕೆಂದರೆ ಇವರು ನೀತಿವಂತರ ರಕ್ತವನ್ನು</para>
  <para style="q2" vid="LAM 4:13">ಅವರ ಮಧ್ಯದಲ್ಲಿ ಚೆಲ್ಲಿದ್ದರು.<verse eid="LAM 4:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="LAM 4:14"/>ಅವರು ಬೀದಿಗಳಲ್ಲಿ ಕುರುಡರಂತೆ ಅಲೆದಾಡಿದರು.</para>
  <para style="q2" vid="LAM 4:14">ಅವರು ರಕ್ತದಿಂದ ತಮ್ಮನ್ನು ತಾವೇ ಕಲುಷಿತಗೊಳಿಸಿಕೊಂಡರು.</para>
  <para style="q1" vid="LAM 4:14">ಆದ್ದರಿಂದ ಮನುಷ್ಯರು ಅವರ ವಸ್ತ್ರಗಳನ್ನು</para>
  <para style="q2" vid="LAM 4:14">ಮುಟ್ಟಲಾರದೇ ಹೋದರು.<verse eid="LAM 4:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="LAM 4:15"/>ಅವರು ಜನರಿಗೆ, ನೀವು ದೂರ ಹೋಗಿರಿ, ನೀವು ಅಶುದ್ಧವಾಗಿದ್ದೀರಿ;</para>
  <para style="q2" vid="LAM 4:15">ದೂರ ಹೋಗಿರಿ, ದೂರ ಹೋಗಿರಿ, ಮುಟ್ಟಬೇಡಿರಿ, ಎಂದು ಕೂಗಿಕೊಂಡರು.</para>
  <para style="q1" vid="LAM 4:15">ಅವರು ಓಡಿಹೋಗಿ ಅಲೆದಾಡುತ್ತಿರುವಾಗ,</para>
  <para style="q2" vid="LAM 4:15">ಅವರು ಇನ್ನು ಮೇಲೆ ಅಲ್ಲಿ ವಾಸಮಾಡುವುದಿಲ್ಲ,</para>
  <para style="q2" vid="LAM 4:15">ಎಂದು ಬೇರೆ ಜನಾಂಗಗಳೊಳಗೆ ಹೇಳಿದರು.<verse eid="LAM 4:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="LAM 4:16"/>ಯೆಹೋವ ದೇವರ ಕೋಪವು ಅವರನ್ನು ಚದುರಿಸಿತು.</para>
  <para style="q2" vid="LAM 4:16">ಅವರು ಇನ್ನು ಅವರನ್ನು ಲಕ್ಷಿಸುವುದಿಲ್ಲ.</para>
  <para style="q1" vid="LAM 4:16">ಅವರು ಯಾಜಕರನ್ನು ಗೌರವಿಸಲಿಲ್ಲ.</para>
  <para style="q2" vid="LAM 4:16">ಅವರು ಹಿರಿಯರಿಗೆ ದಯೆ ತೋರಿಸಲಿಲ್ಲ.<verse eid="LAM 4:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="LAM 4:17"/>ನಮಗಾದರೋ ನಮ್ಮ ಕಣ್ಣುಗಳು ನಮ್ಮ ವ್ಯರ್ಥವಾದ</para>
  <para style="q2" vid="LAM 4:17">ಸಹಾಯಕ್ಕಾಗಿ ನೋಡಿ ಸೋತು ಹೋದವು.</para>
  <para style="q1" vid="LAM 4:17">ನಮ್ಮ ಕಣ್ಣುಗಳು ನಮ್ಮನ್ನು ರಕ್ಷಿಸಲಾರದಂಥ</para>
  <para style="q2" vid="LAM 4:17">ಜನಾಂಗಕ್ಕಾಗಿ ಕಾವಲಾಗಿದ್ದವು.<verse eid="LAM 4:17"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="18" style="v" sid="LAM 4:18"/>ನಾವು ನಮ್ಮ ಬೀದಿಗಳಲ್ಲಿ ಹೋಗದ ಹಾಗೆ,</para>
  <para style="q2" vid="LAM 4:18">ಶತ್ರುಗಳು ನಮ್ಮ ಹೆಜ್ಜೆಗಳನ್ನೇ ಬೇಟೆಯಾಡುತ್ತಾರೆ.</para>
  <para style="q1" vid="LAM 4:18">ನಮ್ಮ ಅಂತ್ಯವು ಸಮೀಪಿಸಿತು, ನಮ್ಮ ದಿನಗಳು ತೀರಿದವು.</para>
  <para style="q2" vid="LAM 4:18">ಏಕೆಂದರೆ ನಮ್ಮ ಅಂತ್ಯವು ಬಂದಿತು.<verse eid="LAM 4:18"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="LAM 4:19"/>ನಮ್ಮನ್ನು ಹಿಂಸಿಸುವವರು</para>
  <para style="q2" vid="LAM 4:19">ಆಕಾಶದಲ್ಲಿ ಹಾರುವ ಹದ್ದುಗಳಿಗಿಂತ ತೀವ್ರವಾಗಿದ್ದಾರೆ.</para>
  <para style="q1" vid="LAM 4:19">ಅವರು ಪರ್ವತಗಳ ಮೇಲೆ ನಮ್ಮನ್ನು ಹಿಂದಟ್ಟಿ,</para>
  <para style="q2" vid="LAM 4:19">ಅರಣ್ಯದಲ್ಲಿ ಹೊಂಚು ಹಾಕಿದರು.<verse eid="LAM 4:19"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="20" style="v" sid="LAM 4:20"/>ಯಾರ ವಿಷಯವಾಗಿ ನಾವು ಅವನ ನೆರಳಿನ ಕೆಳಗೆ</para>
  <para style="q2" vid="LAM 4:20">ಬೇರೆ ಜನಾಂಗಗಳೊಳಗೆ ಬದುಕುವೆವು ಎಂದು ಹೇಳಿಕೊಂಡೆವೋ,</para>
  <para style="q1" vid="LAM 4:20">ನಮ್ಮ ಮೂಗಿನ ಉಸಿರಾದ ಆ ಯೆಹೋವ ದೇವರ ಅಭಿಷಿಕ್ತನು</para>
  <para style="q2" vid="LAM 4:20">ಅವರ ಬಲೆಗಳಲ್ಲಿ ಸಿಕ್ಕಿಕೊಂಡನು.<verse eid="LAM 4:20"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="21" style="v" sid="LAM 4:21"/>ಎದೋಮಿನ ಪುತ್ರಿಯೇ, ಊಚ್ ದೇಶದಲ್ಲಿ ವಾಸವಾಗಿರುವವಳೇ,</para>
  <para style="q2" vid="LAM 4:21">ಆನಂದಿಸು ಮತ್ತು ಸಂತೋಷಪಡು;</para>
  <para style="q1" vid="LAM 4:21">ಆದರೆ ನಿನ್ನ ಬಳಿಗೆ ಪಾತ್ರೆಯು ಸಹ ದಾಟಿ ಬರುವುದು.</para>
  <para style="q2" vid="LAM 4:21">ನೀನು ಕುಡಿದು, ಬೆತ್ತಲೆಯಾಗಿರುವೆ.<verse eid="LAM 4:21"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="22" style="v" sid="LAM 4:22"/>ಚೀಯೋನ್ ಪುತ್ರಿಯೇ, ನಿನ್ನ ಅಕ್ರಮದ ಶಿಕ್ಷೆಯು ತೀರಿ ಹೋಯಿತು.</para>
  <para style="q2" vid="LAM 4:22">ಅವರು ಇನ್ನು ಮೇಲೆ ನಿನ್ನ ಗಡಿಪಾರನ್ನು ಹೆಚ್ಚಿಸುವುದಿಲ್ಲ.</para>
  <para style="q1" vid="LAM 4:22">ಎದೋಮಿನ ಪುತ್ರಿಯೇ, ಅವರು ನಿನ್ನ ಅಕ್ರಮವನ್ನು ವಿಚಾರಿಸುವನು.</para>
  <para style="q2" vid="LAM 4:22">ಆತನು ನಿನ್ನ ಪಾಪಗಳನ್ನು ಬಹಿರಂಗಪಡಿಸುವರು.<verse eid="LAM 4:22"/></para>
  <para style="b"/>
  <para style="b"/>
  <chapter eid="LAM 4"/>
  <chapter number="5" style="c" sid="LAM 5"/>
  <para style="q1">
    <verse number="1" style="v" sid="LAM 5:1"/>ಯೆಹೋವ ದೇವರೇ, ನಮಗೆ ಏನು ಸಂಭವಿಸಿದೆ ಎಂದು ಜ್ಞಾಪಕಮಾಡಿಕೊಳ್ಳಿರಿ.</para>
  <para style="q2" vid="LAM 5:1">ಪರಿಗಣಿಸಿ, ನಮ್ಮ ನಿಂದೆಯನ್ನು ನೋಡಿರಿ.<verse eid="LAM 5:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="LAM 5:2"/>ನಮ್ಮ ಸ್ವಾಸ್ತ್ಯವು ಅಪರಿಚಿತರಿಗೂ,</para>
  <para style="q2" vid="LAM 5:2">ನಮ್ಮ ಮನೆಗಳು ಪರರಿಗೂ ವಶವಾದವು.<verse eid="LAM 5:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="LAM 5:3"/>ನಾವು ಅನಾಥರು, ತಂದೆ ಇಲ್ಲದವರು,</para>
  <para style="q2" vid="LAM 5:3">ನಮ್ಮ ತಾಯಂದಿರು ವಿಧವೆಯರು.<verse eid="LAM 5:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="LAM 5:4"/>ನಾವು ನಮ್ಮ ನೀರನ್ನು ಹಣಕೊಟ್ಟು ಕುಡಿಯಬೇಕಾಗಿದೆ.</para>
  <para style="q2" vid="LAM 5:4">ನಮ್ಮ ಸೌದೆಯು ನಮಗೇ ಮಾರಲಾಗಿದೆ.<verse eid="LAM 5:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="LAM 5:5"/>ನಮ್ಮನ್ನು ಹಿಂಬಾಲಿಸುವವರು ನಮ್ಮ ನೆರಳಿನಲ್ಲೇ ಇದ್ದಾರೆ;</para>
  <para style="q2" vid="LAM 5:5">ನಾವು ದಣಿದಿದ್ದೇವೆ ಮತ್ತು ವಿಶ್ರಾಂತಿಯನ್ನು ಕಾಣುವುದಿಲ್ಲ.<verse eid="LAM 5:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="LAM 5:6"/>ಸಾಕಷ್ಟು ರೊಟ್ಟಿಯನ್ನು ಪಡೆಯಲು</para>
  <para style="q2" vid="LAM 5:6">ನಾವು ಈಜಿಪ್ಟ್ ಮತ್ತು ಅಸ್ಸೀರಿಯಕ್ಕೆ ಅಧೀನರಾಗಿದ್ದೇವೆ.<verse eid="LAM 5:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="LAM 5:7"/>ನಮ್ಮ ತಂದೆಗಳು ಪಾಪಮಾಡಿ ಇಲ್ಲವಾದರು.</para>
  <para style="q2" vid="LAM 5:7">ನಾವು ಅವರ ಅಕ್ರಮಗಳನ್ನು ಹೊರುತ್ತೇವೆ.<verse eid="LAM 5:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="LAM 5:8"/>ಆಳುಗಳು ನಮ್ಮ ಮೇಲೆ ಆಳಿದ್ದಾರೆ.</para>
  <para style="q2" vid="LAM 5:8">ಯಾರೂ ಅವರ ಕೈಯಿಂದ ನಮ್ಮನ್ನು ತಪ್ಪಿಸುವುದಿಲ್ಲ.<verse eid="LAM 5:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="LAM 5:9"/>ಅಡವಿಯ ಖಡ್ಗದ ನಿಮಿತ್ತ</para>
  <para style="q2" vid="LAM 5:9">ಪ್ರಾಣ ಸಂಕಟದಿಂದ ನಮಗೆ ರೊಟ್ಟಿ ಸಿಕ್ಕಿದೆ.<verse eid="LAM 5:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="LAM 5:10"/>ಭಯಂಕರವಾದ ಕ್ಷಾಮದಿಂದ</para>
  <para style="q2" vid="LAM 5:10">ನಮ್ಮ ಚರ್ಮ ಒಲೆಯ ಹಾಗೆ ಕಪ್ಪಾಗಿದೆ.<verse eid="LAM 5:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="LAM 5:11"/>ಅವರು ಚೀಯೋನಿನಲ್ಲಿ ಸ್ತ್ರೀಯರ ಮೇಲೆ</para>
  <para style="q2" vid="LAM 5:11">ಮತ್ತು ಯೆಹೂದದ ನಗರಗಳಲ್ಲಿ ಕನ್ಯೆಯರ ದೌರ್ಜನ್ಯ ಮಾಡಲಾಗಿದೆ.<verse eid="LAM 5:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="LAM 5:12"/>ರಾಜಕುಮಾರರ ಕೈಗಳನ್ನು ಗಲ್ಲಿಗೆ ನೇತುಹಾಕಿದ್ದಾರೆ.</para>
  <para style="q2" vid="LAM 5:12">ಹಿರಿಯರಿಗೆ ಗೌರವವಿಲ್ಲ.<verse eid="LAM 5:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="LAM 5:13"/>ಅವರು ಯೌವನಸ್ಥರನ್ನು ಅರೆಯುವುದಕ್ಕೆ ತೆಗೆದುಕೊಂಡರು</para>
  <para style="q2" vid="LAM 5:13">ಮತ್ತು ಹುಡುಗರು ಕಟ್ಟಿಗೆಯ ಕೆಳಗೆ ಬಿದ್ದರು.<verse eid="LAM 5:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="LAM 5:14"/>ಪಟ್ಟಣದ ದ್ವಾರದಿಂದ ಹಿರಿಯರು ಹೋಗಿದ್ದಾರೆ.</para>
  <para style="q2" vid="LAM 5:14">ಯುವಜನರು ತಮ್ಮ ಸಂಗೀತವನ್ನು ನಿಲ್ಲಿಸಿದ್ದಾರೆ.<verse eid="LAM 5:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="LAM 5:15"/>ನಮ್ಮ ಹೃದಯಾನಂದವು ತೀರಿತು.</para>
  <para style="q2" vid="LAM 5:15">ನಮ್ಮ ನರ್ತನವು ಶೋಕವಾಗಿ ಮಾರ್ಪಟ್ಟಿತು.<verse eid="LAM 5:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="LAM 5:16"/>ಕಿರೀಟವು ನಮ್ಮ ತಲೆಯ ಮೇಲಿನಿಂದ ಬಿದ್ದುಹೋಯಿತು.</para>
  <para style="q2" vid="LAM 5:16">ಅಯ್ಯೋ, ನಾವು ಪಾಪಮಾಡಿದ್ದೇವೆ.<verse eid="LAM 5:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="LAM 5:17"/>ಇದಕ್ಕಾಗಿ ನಮ್ಮ ಹೃದಯವು ದುರ್ಬಲವಾಗಿದೆ.</para>
  <para style="q2" vid="LAM 5:17">ಏಕೆಂದರೆ ಇವುಗಳಿಂದ ನಮ್ಮ ಕಣ್ಣುಗಳು ಮೊಬ್ಬಾಗಿವೆ.<verse eid="LAM 5:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="LAM 5:18"/>ಏಕೆಂದರೆ ಚೀಯೋನ್ ಪರ್ವತವು ಹಾಳಾಗಿರುವುದರಿಂದಲೇ</para>
  <para style="q2" vid="LAM 5:18">ನರಿಗಳು ಅವುಗಳ ಮೇಲೆ ತಿರುಗಾಡುವುವು.<verse eid="LAM 5:18"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="LAM 5:19"/>ಯೆಹೋವ ದೇವರೇ, ನೀವು ಎಂದೆಂದಿಗೂ ಇರುತ್ತೀರಿ.</para>
  <para style="q2" vid="LAM 5:19">ನಿಮ್ಮ ಸಿಂಹಾಸನವು ತಲತಲಾಂತರಗಳವರೆಗೂ ಇರುವುದು.<verse eid="LAM 5:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="LAM 5:20"/>ನೀವು ನಮ್ಮನ್ನು ಯಾವಾಗಲೂ ಮರೆಯುವುದೇಕೆ?</para>
  <para style="q2" vid="LAM 5:20">ಇಷ್ಟುಕಾಲ ನಮ್ಮನ್ನು ಮರೆತಿರುವುದೇಕೆ?<verse eid="LAM 5:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="LAM 5:21"/>ಯೆಹೋವ ದೇವರೇ, ನಾವು ನಿಮ್ಮ ಕಡೆ ಹಿಂದಿರುಗುವಂತೆ,</para>
  <para style="q2" vid="LAM 5:21">ನಮ್ಮನ್ನು ನಿಮ್ಮ ಕಡೆಗೆ ಪುನಃ ಸ್ಥಾಪಿಸಿಕೊಳ್ಳಿ.</para>
  <para style="q2" vid="LAM 5:21">ನಮ್ಮ ದಿನಗಳನ್ನು ಹಿಂದಿನಂತೆಯೇ ನವೀಕರಿಸಿರಿ.<verse eid="LAM 5:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="LAM 5:22"/>ಯೆಹೋವ ದೇವರೇ, ನೀವು ನಮ್ಮ ಮೇಲೆ ಮಿತಿಮೀರಿ ಸಿಟ್ಟುಗೊಂಡಿರುವಿರೋ?</para>
  <para style="q2" vid="LAM 5:22">ನಮ್ಮನ್ನು ಸಂಪೂರ್ಣವಾಗಿ ಕೈಬಿಟ್ಟಿರುವಿರೋ?<verse eid="LAM 5:22"/></para>
  <chapter eid="LAM 5"/>
</usx>
