<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="1TH" style="id">- Biblica® Open Kannada Contemporary Version</book>
  <para style="h">1 ಥೆಸಲೋನಿಕದವರಿಗೆ</para>
  <para style="toc1">ಥೆಸಲೋನಿಕದವರಿಗೆ ಪೌಲನು ಬರೆದ ಮೊದಲನೆಯ ಪತ್ರಿಕೆ</para>
  <para style="toc2">1 ಥೆಸಲೋನಿಕದವರಿಗೆ</para>
  <para style="toc3">1 ಥೆಸ</para>
  <para style="mt1">ಥೆಸಲೋನಿಕದವರಿಗೆ</para>
  <para style="mt2">ಪೌಲನು ಬರೆದ ಮೊದಲನೆಯ ಪತ್ರಿಕೆ</para>
  <chapter number="1" style="c" sid="1TH 1"/>
  <para style="p">
    <verse number="1" style="v" sid="1TH 1:1"/>ತಂದೆ ದೇವರಲ್ಲಿಯೂ ನಮಗೆ ಕರ್ತ ಆಗಿರುವ ಯೇಸು ಕ್ರಿಸ್ತರಲ್ಲಿಯೂ ಇರುವ ಥೆಸಲೋನಿಕದವರ ಸಭೆಗೆ,</para>
  <para style="b" vid="1TH 1:1"/>
  <para style="p" vid="1TH 1:1">ಪೌಲ, ಸಿಲ್ವಾನ ಹಾಗೂ ತಿಮೊಥೆ ಇವರು ಬರೆಯುವ ಪತ್ರ:</para>
  <para style="b" vid="1TH 1:1"/>
  <para style="p" vid="1TH 1:1">ನಿಮಗೆ ಕೃಪೆಯೂ ಶಾಂತಿಯೂ ಆಗಲಿ.<verse eid="1TH 1:1"/></para>
  <para style="b"/>
  <para style="s1">ಪೌಲನ ಕೃತಜ್ಞತಾಸ್ತುತಿ</para>
  <para style="p">
    <verse number="2" style="v" sid="1TH 1:2"/>ನಾವು ನಮ್ಮ ಪ್ರಾರ್ಥನೆಗಳಲ್ಲಿ ನಿಮ್ಮನ್ನು ಸ್ಮರಿಸುತ್ತಾ ನಿಮ್ಮೆಲ್ಲರಿಗಾಗಿ ದೇವರಿಗೆ ಯಾವಾಗಲೂ ಕೃತಜ್ಞತೆಯನ್ನು ಸಲ್ಲಿಸುತ್ತೇವೆ. <verse eid="1TH 1:2"/><verse number="3" style="v" sid="1TH 1:3"/>ನಿಮ್ಮ ವಿಶ್ವಾಸ ಪ್ರಕಟಿಸುವ ಕ್ರಿಯೆಯನ್ನೂ ಪ್ರೀತಿ ಪ್ರೇರಿತ ಪ್ರಯಾಸವನ್ನೂ ನಮಗೆ ಕರ್ತ ಆಗಿರುವ ಯೇಸು ಕ್ರಿಸ್ತರಲ್ಲಿರುವ ನಿರೀಕ್ಷೆಯ ಸ್ಮರಣೆಯನ್ನೂ ನಾವು ನಮ್ಮ ತಂದೆಯಾದ ದೇವರ ಮುಂದೆ ಎಡಬಿಡದೆ ಜ್ಞಾಪಿಸಿಕೊಳ್ಳುತ್ತೇವೆ.<verse eid="1TH 1:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="1TH 1:4"/>ದೇವರು ಪ್ರೀತಿಸುವ ಪ್ರಿಯರೇ, ದೇವರು ತಾವಾಗಿಯೇ ನಿಮ್ಮನ್ನು ಆರಿಸಿಕೊಂಡಿದ್ದಾರೆಂದು ನಾವು ಬಲ್ಲೆವು. <verse eid="1TH 1:4"/><verse number="5" style="v" sid="1TH 1:5"/>ಏಕೆಂದರೆ ನಮ್ಮ ಸುವಾರ್ತೆಯು ನಿಮಗೆ ಬರೀ ಮಾತಾಗಿ ಬಾರದೆ, ಶಕ್ತಿಯಲ್ಲಿಯೂ ಪವಿತ್ರಾತ್ಮ ದೇವರ ಸನ್ನಿಧಿಯಲ್ಲಿಯೂ ಬಹು ನಿಶ್ಚಯದಲ್ಲಿಯೂ ಬಂತೆಂಬುದನ್ನು ತಿಳಿದಿದ್ದೇವೆ. ನಾವು ನಿಮ್ಮಲ್ಲಿದ್ದುಕೊಂಡು ನಿಮಗೋಸ್ಕರ ಮಾಡಿದ ಜೀವನ ಎಂಥದ್ದೆಂದು ನೀವೇ ಬಲ್ಲಿರಿ. <verse eid="1TH 1:5"/><verse number="6" style="v" sid="1TH 1:6"/>ನೀವು ಬಹು ಹಿಂಸೆಯಿಂದಲೂ ಪವಿತ್ರಾತ್ಮ ಪ್ರೇರಿತ ಆನಂದದಿಂದಲೂ ವಾಕ್ಯವನ್ನು ಅಂಗೀಕರಿಸಿ ನಮ್ಮನ್ನೂ ಕರ್ತ ಯೇಸುವನ್ನೂ ಅನುಸರಿಸುವವರಾಗಿದ್ದೀರಿ. <verse eid="1TH 1:6"/><verse number="7" style="v" sid="1TH 1:7"/>ಹೀಗೆ ಮಕೆದೋನ್ಯ ಹಾಗೂ ಅಖಾಯದ ವಿಶ್ವಾಸಿಗಳೆಲ್ಲರಿಗೂ ನೀವು ಆದರ್ಶರಾದಿರಿ. <verse eid="1TH 1:7"/><verse number="8" style="v" sid="1TH 1:8"/>ಕರ್ತನ ವಾಕ್ಯವು ನಿಮ್ಮಿಂದಲೇ ಮಕೆದೋನ್ಯ ಹಾಗೂ ಅಖಾಯದಲ್ಲಿ ಘೋಷಿತವಾದದ್ದಲ್ಲದೆ, ದೇವರ ಮೇಲೆ ನೀವು ಇಟ್ಟಿರುವ ನಂಬಿಕೆಯು ಎಲ್ಲಾ ಸ್ಥಳಗಳಲ್ಲಿಯೂ ಹರಡಿತು. ಆದ್ದರಿಂದ ಇದನ್ನು ಕುರಿತು ನಾವು ಹೇಳಬೇಕಾದ ಅವಶ್ಯ ಏನೂ ಇಲ್ಲ. <verse eid="1TH 1:8"/><verse number="9" style="v" sid="1TH 1:9"/>ಏಕೆಂದರೆ ನೀವು ನಮ್ಮನ್ನು ಹೇಗೆ ಸ್ವೀಕರಿಸಿದ್ದಿರೆಂಬುದನ್ನೂ ನೀವು ಹೇಗೆ ದೇವರಲ್ಲದವುಗಳನ್ನು ಬಿಟ್ಟುಬಿಟ್ಟು ದೇವರ ಕಡೆಗೆ ತಿರುಗಿಕೊಂಡು ಜೀವವುಳ್ಳ ಸತ್ಯದೇವರನ್ನು ಸೇವಿಸುವವರಾದಿರೆಂಬುದನ್ನೂ ಅವರು ತಾವೇ ವಿವರಿಸುತ್ತಾರೆ. <verse eid="1TH 1:9"/><verse number="10" style="v" sid="1TH 1:10"/>ಇದಲ್ಲದೆ, ದೇವರು ಸತ್ತವರೊಳಗಿಂದ ಜೀವಂತವಾಗಿ ಎಬ್ಬಿಸಿದ ತಮ್ಮ ಪುತ್ರರಾಗಿರುವ ಯೇಸು ಮುಂದೆ ಬರುವ ಕೋಪದಿಂದ ನಮ್ಮನ್ನು ಬಿಡಿಸುವವರೂ ಆಗಿದ್ದಾರೆ. ಈ ಯೇಸುವನ್ನೇ ಪರಲೋಕದಿಂದ ಬರುವುದನ್ನು ನೀವು ಎದುರು ನೋಡುತ್ತಿದ್ದೀರಿ ಎಂಬುದನ್ನೂ ಅವರು ನಮಗೆ ವಿವರಿಸಿದರು.<verse eid="1TH 1:10"/></para>
  <chapter eid="1TH 1"/>
  <chapter number="2" style="c" sid="1TH 2"/>
  <para style="s1">ಥೆಸಲೋನಿಕದಲ್ಲಿ ಪೌಲನು ಮಾಡಿದ ಸೇವೆ</para>
  <para style="p">
    <verse number="1" style="v" sid="1TH 2:1"/>ಪ್ರಿಯರೇ, ನಾವು ನಿಮ್ಮ ಬಳಿಗೆ ಬಂದದ್ದು ವ್ಯರ್ಥವಾಗಲಿಲ್ಲವೆಂಬುದನ್ನು ನೀವು ತಿಳಿದಿದ್ದೀರಿ. <verse eid="1TH 2:1"/><verse number="2" style="v" sid="1TH 2:2"/>ಫಿಲಿಪ್ಪಿ ಪಟ್ಟಣದಲ್ಲಿ ಮುಂಚೆ ನಮಗೆ ಹಿಂಸೆ ಮತ್ತು ಅವಮಾನವು ಸಂಭವಿಸಿದ್ದನ್ನು ನೀವು ಬಲ್ಲಿರಿ. ಹಾಗಿದ್ದರೂ ನಾವು ನಮ್ಮ ದೇವರ ಸಹಾಯದಿಂದ ಧೈರ್ಯಗೊಂಡು ಬಹು ವಿರೋಧದ ನಡುವೆ ನಿಮಗೆ ಸುವಾರ್ತೆಯನ್ನು ತಿಳಿಸಿದೆವು. <verse eid="1TH 2:2"/><verse number="3" style="v" sid="1TH 2:3"/>ಏಕೆಂದರೆ ನಮ್ಮ ಬೋಧನೆಯು ದುರುದ್ದೇಶದಿಂದಲೂ ಇಲ್ಲವೆ ವಂಚನೆಗಳಿಂದಲೂ ತಪ್ಪುಗಳಿಂದಲೂ ಕೂಡಿದ್ದಲ್ಲ. <verse eid="1TH 2:3"/><verse number="4" style="v" sid="1TH 2:4"/>ದೇವರು ನಮ್ಮನ್ನು ಅನುಮೋದಿಸಿ ನಮ್ಮ ವಶಕ್ಕೆ ಸುವಾರ್ತೆಯನ್ನು ಒಪ್ಪಿಸಿಕೊಟ್ಟಿದ್ದಾರೆ. ಹಾಗಿರುವುದರಿಂದ, ನಾವು ಮನುಷ್ಯರನ್ನು ಮೆಚ್ಚಿಸದೆ ನಮ್ಮ ಹೃದಯಗಳನ್ನು ಪರಿಶೋಧಿಸುವ ದೇವರನ್ನೇ ಮೆಚ್ಚಿಸಬೇಕೆಂದು ಮಾತನಾಡುತ್ತೇವೆ. <verse eid="1TH 2:4"/><verse number="5" style="v" sid="1TH 2:5"/>ನಾವು ಎಂದಿಗೂ ನಿಮ್ಮನ್ನು ಹೊಗಳಿ ಮಾತನಾಡಲಿಲ್ಲ, ಕೌಶಲ್ಯವನ್ನು ಪ್ರಯೋಗಿಸಿ ಹಣದಾಸೆಯನ್ನು ಮರೆಮಾಡುವವರು ಆಗಿರಲಿಲ್ಲ ಎಂಬುದನ್ನು ನೀವು ತಿಳಿದಿರುವಿರಿ. ಇದಕ್ಕೆ ದೇವರೇ ಸಾಕ್ಷಿ. <verse eid="1TH 2:5"/><verse number="6" style="v" sid="1TH 2:6"/>ಕ್ರಿಸ್ತ ಯೇಸುವಿನ ಅಪೊಸ್ತಲರಾದ ನಾವು ನಿಮ್ಮ ಮೇಲೆ ಭಾರವನ್ನು ಹಾಕಬಹುದಾಗಿದ್ದರೂ ಮನುಷ್ಯರಿಂದ ಬರುವ ಗೌರವವನ್ನು ನಿಮ್ಮಿಂದಾಗಲೀ, ಇತರರಿಂದಾಗಲೀ, ಹುಡುಕುವವರಾಗಿರಲಿಲ್ಲ. <verse eid="1TH 2:6"/><verse number="7" style="v" sid="1TH 2:7"/>ಅದರ ಬದಲಾಗಿ, ನಾವು ನಿಮ್ಮ ನಡುವೆ ಶಿಶುಗಳಂತೆ ಇದ್ದೆವು.</para>
  <para style="p" vid="1TH 2:7">ತಾಯಿಯು ತನ್ನ ಮಕ್ಕಳನ್ನು ಪೋಷಿಸುವಂತೆ, <verse eid="1TH 2:7"/><verse number="8" style="v" sid="1TH 2:8"/>ನಿಮ್ಮನ್ನು ಪೋಷಿಸಿದೆವು. ಏಕೆಂದರೆ ನಾವು ನಿಮ್ಮನ್ನು ಬಹಳವಾಗಿ ಪ್ರೀತಿಸಿದ್ದರಿಂದ, ದೇವರ ಸುವಾರ್ತೆಯನ್ನು ಸಾರುವುದಕ್ಕೆ ಮಾತ್ರವಲ್ಲದೆ ನಿಮಗೋಸ್ಕರ ನಾವು ನಮ್ಮ ಪ್ರಾಣವನ್ನೇ ಕೊಡುವುದಕ್ಕೂ ಇಷ್ಟವುಳ್ಳವರಾಗಿದ್ದೆವು. <verse eid="1TH 2:8"/><verse number="9" style="v" sid="1TH 2:9"/>ಪ್ರಿಯರೇ, ನಾವು ನಿಮ್ಮಲ್ಲಿ ಯಾರ ಮೇಲೆಯೂ ಭಾರಹಾಕಬಾರದೆಂದು ಹಗಲಿರುಳು ದುಡಿದು ಕಷ್ಟ ಪ್ರಯಾಸದಿಂದ ದೇವರ ಸುವಾರ್ತೆಯನ್ನು ನಿಮಗೆ ಸಾರಿದೆವೆಂಬುದು ನಿಮ್ಮ ನೆನಪಿನಲ್ಲಿರುವುದಷ್ಟೆ. <verse eid="1TH 2:9"/><verse number="10" style="v" sid="1TH 2:10"/>ನಂಬುವವರಾದ ನಿಮ್ಮೊಂದಿಗೆ ನಾವು ಎಷ್ಟೋ ಪವಿತ್ರರಾಗಿಯೂ ನೀತಿವಂತರಾಗಿಯೂ ನಿರ್ದೋಷಿಗಳಾಗಿಯೂ ನಡೆದುಕೊಂಡೆವೆಂಬುದಕ್ಕೆ ನೀವೇ ಸಾಕ್ಷಿಗಳು, ಮಾತ್ರವಲ್ಲದೆ ದೇವರೂ ಸಾಕ್ಷಿ. <verse eid="1TH 2:10"/><verse number="11" style="v" sid="1TH 2:11"/>ತಂದೆಯು ತನ್ನ ಮಕ್ಕಳಿಗೆ ಹೇಗೋ ಹಾಗೆಯೇ ನಾವು ನಿಮ್ಮಲ್ಲಿ ಪ್ರತಿಯೊಬ್ಬನನ್ನು ನಡೆಸಿದೆವು. <verse eid="1TH 2:11"/><verse number="12" style="v" sid="1TH 2:12"/>ನಿಮಗೆ ಬುದ್ಧಿ ಹೇಳುತ್ತಾ ಸಂತೈಸುತ್ತಾ ಬಂದೆವು. ಹೀಗೆ ದೇವರ ಹಾಗೂ ಅವರ ರಾಜ್ಯದ ಮಹಿಮೆಗಾಗಿ ಕರೆದಾತನಿಗೆ ನೀವು ಯೋಗ್ಯರಾಗಿ ನಡೆಯಬೇಕೆಂದು ಸಾಕ್ಷಿ ಹೇಳಿದೆವೆಂಬುದು ನಿಮಗೆ ತಿಳಿದಿದೆ.<verse eid="1TH 2:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="1TH 2:13"/>ಈ ಕಾರಣಕ್ಕಾಗಿಯೇ ನಂಬುವವರಾದ ನಿಮ್ಮಲ್ಲಿ ಕಾರ್ಯಸಾಧಿಸುವ ದೇವರ ವಾಕ್ಯವನ್ನು ನಮ್ಮಿಂದ ನೀವು ಕೇಳಿದಾಗ ಅದನ್ನು ಮನುಷ್ಯರ ವಾಕ್ಯವೆಂದೆಣಿಸದೆ, ನಿಜವಾಗಿಯೂ ದೇವರ ವಾಕ್ಯವೆಂದೇ ತಿಳಿದು ಅಂಗೀಕರಿಸಿದ್ದಕ್ಕಾಗಿ ನಾವಂತೂ ಎಡೆಬಿಡದೆ ದೇವರಿಗೆ ಕೃತಜ್ಞತೆಯನ್ನು ಸಲ್ಲಿಸುತ್ತೇವೆ. <verse eid="1TH 2:13"/><verse number="14" style="v" sid="1TH 2:14"/>ಪ್ರಿಯರೇ, ನೀವು ಯೂದಾಯದಲ್ಲಿ ಕ್ರಿಸ್ತ ಯೇಸುವಿನಲ್ಲಿರುವ ದೇವರ ಸಭೆಗಳನ್ನು ಅನುಸರಿಸುವವರಾದಿರಿ. ಅವರು ಯೆಹೂದ್ಯರಿಂದ ಅನುಭವಿಸಿದಂಥ ಕಷ್ಟಗಳನ್ನೇ ನೀವೂ ಸಹ ನಿಮ್ಮ ಸ್ವದೇಶಿಯರಿಂದ ಅನುಭವಿಸಿದಿರಿ. <verse eid="1TH 2:14"/><verse number="15" style="v" sid="1TH 2:15"/>ಆ ಯೆಹೂದ್ಯರು ನಮಗೆ ಕರ್ತ ಆಗಿರುವ ಯೇಸುವನ್ನು ಮತ್ತು ಪ್ರವಾದಿಗಳನ್ನು ಕೊಂದರು. ನಮ್ಮನ್ನೂ ಓಡಿಸಿಬಿಟ್ಟರು. ಅವರು ದೇವರನ್ನು ಮೆಚ್ಚಿಸದೆ ಜನರೆಲ್ಲರಿಗೂ ವಿರೋಧಿಗಳಾಗಿದ್ದಾರೆ. <verse eid="1TH 2:15"/><verse number="16" style="v" sid="1TH 2:16"/>ಯೆಹೂದ್ಯರಲ್ಲದವರಿಗೆ ರಕ್ಷಣೆಯಾಗುವಂತೆ ಮಾತನಾಡುವ ನಮಗೆ ಅವರು ಅಡ್ಡಿ ಮಾಡುತ್ತಾರೆ. ಹೀಗೆ ತಮ್ಮ ಪಾಪಗಳನ್ನು ಯಾವಾಗಲೂ ಹೆಚ್ಚೆಚ್ಚಾಗಿ ಕೂಡಿಸಿಕೊಳ್ಳುತ್ತಾ ಹೋಗುತ್ತಾರೆ. ಕೊನೆಗೆ ಕೋಪಾಗ್ನಿಯೂ ಅವರ ಮೇಲೆ ಬರಲಿದೆ.<verse eid="1TH 2:16"/></para>
  <para style="s1">ಪೌಲನು ಥೆಸಲೋನಿಕದವರನ್ನು ನೋಡುವುದಕ್ಕೆ ಹಾರೈಸಿದ್ದು</para>
  <para style="p">
    <verse number="17" style="v" sid="1TH 2:17"/>ಪ್ರಿಯರೇ, ನಾವು ದೈಹಿಕವಾಗಿ ನಿಮ್ಮನ್ನು ಬಿಟ್ಟು ಸ್ವಲ್ಪಕಾಲ ಅಗಲಿದರೂ ಹೃದಯದಲ್ಲಿ ಅಗಲದೆ, ನಿಮ್ಮ ಮುಖವನ್ನು ಕಾಣಲು ಅತ್ಯಾಶೆಯಿಂದ ಬಹಳ ಪ್ರಯತ್ನ ಮಾಡಿದೆವು. <verse eid="1TH 2:17"/><verse number="18" style="v" sid="1TH 2:18"/>ಆದ್ದರಿಂದ ನಿಮ್ಮ ಬಳಿಗೆ ಬರುವುದಕ್ಕೆ ನಮಗೆ ಮನಸ್ಸಿತ್ತು. ಪೌಲನಾದ ನಾನಂತೂ ಮತ್ತೆ ಮತ್ತೆ ಬರಲು ಬಯಸಿದೆನು. ಆದರೆ ಸೈತಾನನು ನಮಗೆ ಅಭ್ಯಂತರ ಮಾಡಿದನು. <verse eid="1TH 2:18"/><verse number="19" style="v" sid="1TH 2:19"/>ನಮಗೆ ಕರ್ತ ಆಗಿರುವ ಯೇಸು ಬರುವಾಗ ಅವರ ಮುಂದೆ ನಮ್ಮ ನಿರೀಕ್ಷೆಯೂ ಆನಂದವೂ ಅಭಿಮಾನದ ಕಿರೀಟವೂ ಯಾರು? ನೀವೇ ಅಲ್ಲವೇ? <verse eid="1TH 2:19"/><verse number="20" style="v" sid="1TH 2:20"/>ನೀವೇ ನಮ್ಮ ಮಹಿಮೆಯೂ ಆನಂದವೂ ಆಗಿದ್ದೀರಿ.<verse eid="1TH 2:20"/></para>
  <chapter eid="1TH 2"/>
  <chapter number="3" style="c" sid="1TH 3"/>
  <para style="p">
    <verse number="1" style="v" sid="1TH 3:1"/>ಆದ್ದರಿಂದ ನಿಮ್ಮ ಅಗಲಿಕೆಯನ್ನು ಸಹಿಸಲಾಗದೆ, ನಾವು ಅಥೇನೆಯಲ್ಲಿ ಒಬ್ಬಂಟಿಗರಾಗಿಯೇ ಇರುವುದು ಒಳ್ಳೆಯದೆಂದು ಯೋಚಿಸಿದೆವು. <verse eid="1TH 3:1"/><verse number="2" style="v" sid="1TH 3:2"/>ನಿಮ್ಮನ್ನು ದೃಢಪಡಿಸುವುದಕ್ಕೂ ನಿಮ್ಮ ನಂಬಿಕೆಯ ವಿಷಯವಾಗಿ ನಿಮ್ಮನ್ನು ಉತ್ತೇಜಿಸುವುದಕ್ಕೂ ನಮ್ಮ ಸಹೋದರನೂ ದೇವರ ಸೇವಕನೂ ಯೇಸುಕ್ರಿಸ್ತರ ಸುವಾರ್ತೆಯಲ್ಲಿ ನಮ್ಮ ಜೊತೆ ಸೇವಕನೂ ಆಗಿರುವ ತಿಮೊಥೆಯನನ್ನು ಕಳುಹಿಸಿದೆವು. <verse eid="1TH 3:2"/><verse number="3" style="v" sid="1TH 3:3"/>ಹೀಗಿರುವಲ್ಲಿ ಈ ಸಂಕಟಗಳಿಂದ ಒಬ್ಬರೂ ಚಂಚಲರಾಗಬೇಡಿರಿ. ಏಕೆಂದರೆ ಇವುಗಳಿಗಾಗಿಯೇ ನಾವು ನೇಮಕವಾಗಿದ್ದೇವೆ ಎಂದು ನೀವೇ ಬಲ್ಲಿರಿ. <verse eid="1TH 3:3"/><verse number="4" style="v" sid="1TH 3:4"/>ನಾವು ನಿಮ್ಮ ಬಳಿಯಲ್ಲಿದ್ದಾಗ ಸಂಕಟವನ್ನು ಅನುಭವಿಸಲೇಬೇಕೆಂದು ಮುಂದಾಗಿ ಹೇಳಿದೆವಲ್ಲಾ. ಹಾಗೆ ಆಯಿತೆಂದು ನೀವೂ ಚೆನ್ನಾಗಿ ಬಲ್ಲಿರಿ. <verse eid="1TH 3:4"/><verse number="5" style="v" sid="1TH 3:5"/>ಈ ಕಾರಣದಿಂದ, ನಮ್ಮ ಪ್ರಯಾಸವು ವ್ಯರ್ಥವಾಗುವಂತೆ ಶೋಧಕನು ನಿಮ್ಮನ್ನು ಶೋಧಿಸುವನೋ ಎಂಬ ಭಯದ ದೆಸೆಯಿಂದ, ನಾನು ಸಹ ಸಹಿಸಲಾರದೆ ನಿಮ್ಮ ನಂಬಿಕೆಯ ವಿಷಯದಲ್ಲಿ ತಿಳಿದುಕೊಳ್ಳುವುದಕ್ಕೆ ತಿಮೊಥೆಯನನ್ನು ಕಳುಹಿಸಿದೆನು.<verse eid="1TH 3:5"/></para>
  <para style="s1">ತಿಮೊಥೆ ಕೊಟ್ಟ ಪ್ರೋತ್ಸಾಹ ಕಾರ್ಯದ ವರದಿ</para>
  <para style="p">
    <verse number="6" style="v" sid="1TH 3:6"/>ತಿಮೊಥೆಯನು ಈಗಲೇ ನಿಮ್ಮಿಂದ ನಮ್ಮ ಬಳಿಗೆ ಬಂದು ನಿಮ್ಮ ವಿಶ್ವಾಸ ಹಾಗೂ ಪ್ರೀತಿಯ ವಿಷಯವಾಗಿ ಒಳ್ಳೆಯ ವರ್ತಮಾನವನ್ನು ತಂದಿದ್ದಾನೆ. ನೀವು ನಮ್ಮನ್ನು ಯಾವಾಗಲೂ ಚೆನ್ನಾಗಿ ನೆನಪಿಸಿಕೊಂಡು, ನಾವು ನಿಮ್ಮನ್ನು ಹೇಗೋ ಹಾಗೆಯೇ ನೀವೂ ನಮ್ಮನ್ನು ನೋಡುವುದಕ್ಕೆ ಹಾರೈಸುತ್ತೀರೆಂಬುದನ್ನು ತಿಳಿಸಿದ್ದಾನೆ. <verse eid="1TH 3:6"/><verse number="7" style="v" sid="1TH 3:7"/>ಈ ಕಾರಣದಿಂದ ಪ್ರಿಯರೇ, ನಮ್ಮ ಎಲ್ಲಾ ಇಕ್ಕಟ್ಟು ಹಾಗೂ ಹಿಂಸೆಗಳಲ್ಲಿಯೂ ನಿಮ್ಮ ನಂಬಿಕೆಯ ಮೂಲಕ ನಮಗೆ ಆದರಣೆಯಾಯಿತು. <verse eid="1TH 3:7"/><verse number="8" style="v" sid="1TH 3:8"/>ಏಕೆಂದರೆ ನೀವು ಕರ್ತ ಯೇಸುವಿನಲ್ಲಿ ದೃಢವಾಗಿ ನಿಂತಿರುವುದರಿಂದಲೇ ಈಗ ನಾವು ನಿಜವಾಗಿಯೂ ಜೀವಿಸುತ್ತಿದ್ದೇವೆ. <verse eid="1TH 3:8"/><verse number="9" style="v" sid="1TH 3:9"/>ನಿಮ್ಮ ನಿಮಿತ್ತ ನಮ್ಮ ದೇವರ ಮುಂದೆ ನಮಗಿರುವ ಎಲ್ಲಾ ಆನಂದಕ್ಕೆ ಬದಲಾಗಿ ದೇವರಿಗೆ ಹೇಗೆ ಸಾಕಷ್ಟು ಕೃತಜ್ಞತೆಯನ್ನು ಸಲ್ಲಿಸಬಹುದು? <verse eid="1TH 3:9"/><verse number="10" style="v" sid="1TH 3:10"/>ನಿಮ್ಮ ಮುಖವನ್ನು ನೋಡುವುದಕ್ಕಾಗಿಯೂ ನಿಮ್ಮ ನಂಬಿಕೆಯಲ್ಲಿರುವ ಕೊರತೆಯನ್ನು ನಿವಾರಿಸುವುದಕ್ಕೂ ನಾವು ಹಗಲಿರುಳು ಆಸಕ್ತಿಯಿಂದ ಪ್ರಾರ್ಥಿಸುತ್ತಿದ್ದೇವೆ.<verse eid="1TH 3:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="1TH 3:11"/>ನಮ್ಮ ತಂದೆಯಾದ ದೇವರೂ ನಮಗೆ ಕರ್ತ ಆಗಿರುವ ಯೇಸುವೂ ನಾವು ನಿಮ್ಮಲ್ಲಿಗೆ ಬರುವಂತೆ ಮಾರ್ಗವನ್ನು ಸುಗಮಗೊಳಿಸಲಿ. <verse eid="1TH 3:11"/><verse number="12" style="v" sid="1TH 3:12"/>ನಮ್ಮ ಪ್ರೀತಿಯು ನಿಮ್ಮ ಕಡೆಗೆ ಸಮೃದ್ಧಿಯಾಗಿರುವಂತೆಯೇ ನಿಮ್ಮ ಪ್ರೀತಿಯೂ ಒಬ್ಬರಿಂದೊಬ್ಬರಿಗೂ ಎಲ್ಲರ ಮೇಲೆಯೂ ತುಂಬಿರುವಂತೆ ಕರ್ತ ಯೇಸು ನಿಮಗೆ ಅನುಗ್ರಹಿಸಲಿ. <verse eid="1TH 3:12"/><verse number="13" style="v" sid="1TH 3:13"/>ನಮಗೆ ಕರ್ತ ಆಗಿರುವ ಯೇಸುವು ತಮ್ಮ ಎಲ್ಲಾ ಪರಿಶುದ್ಧರೊಂದಿಗೆ ಬರುವಾಗ, ನೀವು ತಂದೆ ದೇವರ ಮುಂದೆ ಪರಿಶುದ್ಧರೂ ನಿರ್ದೋಷಿಗಳೂ ಆಗಿರುವಂತೆ ನಿಮ್ಮ ಹೃದಯಗಳನ್ನು ಬಲಪಡಿಸಲಿ!<verse eid="1TH 3:13"/></para>
  <chapter eid="1TH 3"/>
  <chapter number="4" style="c" sid="1TH 4"/>
  <para style="s1">ದೇವರನ್ನು ಮೆಚ್ಚಿಸಲು ಜೀವಿಸುವುದು</para>
  <para style="p">
    <verse number="1" style="v" sid="1TH 4:1"/>ಪ್ರಿಯರೇ, ನೀವು ಹೇಗೆ ನಡೆದುಕೊಂಡು ದೇವರನ್ನು ಮೆಚ್ಚಿಸಬೇಕೆಂದು ನಮ್ಮಿಂದ ಕೇಳಿದಂತೆಯೇ ಜೀವಿಸುತಿರುವಿರಿ. ಇದರಲ್ಲಿ ನೀವು ಹೆಚ್ಚೆಚ್ಚಾಗಿ ಮಾಡಬೇಕೆಂದು ನಾವು ಕಡೆಯದಾಗಿ ನಮಗೆ ಕರ್ತ ಆಗಿರುವ ಯೇಸುವಿನಲ್ಲಿ ನಿಮ್ಮನ್ನು ಪ್ರಬೋಧಿಸುತ್ತೇವೆ ಮತ್ತು ಉತ್ತೇಜಿಸುತ್ತೇವೆ. <verse eid="1TH 4:1"/><verse number="2" style="v" sid="1TH 4:2"/>ನಮಗೆ ಕರ್ತ ಆಗಿರುವ ಯೇಸುವಿನ ಅಧಿಕಾರದ ಮೂಲಕ ನಿಮಗೆ ಕೊಟ್ಟ ಆಜ್ಞೆಗಳನ್ನು ನೀವು ತಿಳಿದವರಾಗಿದ್ದೀರಿ.<verse eid="1TH 4:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="1TH 4:3"/>ನೀವು ಪವಿತ್ರರಾಗಿ ಇರಬೇಕೆಂಬುದೇ ದೇವರ ಚಿತ್ತವಾಗಿದೆ. ಆದ್ದರಿಂದ ನೀವು ಕಾಮಾತಿರೇಕಕ್ಕೆ ದೂರವಾಗಿರಬೇಕು. <verse eid="1TH 4:3"/><verse number="4" style="v" sid="1TH 4:4"/>ನಿಮ್ಮಲ್ಲಿ ಪ್ರತಿಯೊಬ್ಬನೂ ಪವಿತ್ರತೆಯಿಂದಲೂ ಘನತೆಯಿಂದಲೂ ತನ್ನ ಸ್ವಂತ ದೇಹವನ್ನು<note caller="+" style="f"><char style="fr" closed="false">4:4 </char><char style="ft" closed="false">ಅಥವಾ </char><char style="fqa" closed="false">ತನ್ನ ಸ್ವಂತ ಪತ್ನಿಯನ್ನು</char></note> ಕಾಪಾಡಿಕೊಳ್ಳಲು ತಿಳಿಯಬೇಕು. <verse eid="1TH 4:4"/><verse number="5" style="v" sid="1TH 4:5"/>ನೀವು ದೇವರನ್ನರಿಯದ ಯೆಹೂದ್ಯರಲ್ಲದವರಂತೆ ಕಾಮಾಭಿಲಾಷೆಗೆ ಒಳಪಡಬಾರದು. <verse eid="1TH 4:5"/><verse number="6" style="v" sid="1TH 4:6"/>ಈ ವಿಷಯದಲ್ಲಿ ಯಾರೂ ಅತಿಕ್ರಮಿಸಿ ತಮ್ಮ ಸಹೋದರ ಸಹೋದರಿಯನ್ನು ವಂಚಿಸದಿರಲಿ. ಏಕೆಂದರೆ ನಾವು ಮೊದಲು ತಿಳಿಸಿ ನಿಮಗೆ ಗಂಭೀರವಾಗಿ ಎಚ್ಚರಿಸಿದಂತೆ ಈ ಪಾಪಗಳ ವಿಷಯದಲ್ಲಿ ಕರ್ತ ಯೇಸುವು ಮುಯ್ಯಿಗೆ ಮುಯ್ಯಿ ತೀರಿಸುವವರಾಗಿದ್ದಾರೆ. <verse eid="1TH 4:6"/><verse number="7" style="v" sid="1TH 4:7"/>ದೇವರು ನಮ್ಮನ್ನು ಅಶುದ್ಧತೆಗೆ ಕರೆಯದೆ ಪವಿತ್ರ ಜೀವನವನ್ನು ಜೀವಿಸಲು ಕರೆದಿದ್ದಾರೆ. <verse eid="1TH 4:7"/><verse number="8" style="v" sid="1TH 4:8"/>ಆದ್ದರಿಂದ, ಈ ಆಜ್ಞೆಗಳನ್ನು ತಿರಸ್ಕರಿಸುವವನು ಮನುಷ್ಯನನ್ನಲ್ಲ ದೇವರನ್ನು ಅಂದರೆ, ತಮ್ಮ ಪವಿತ್ರಾತ್ಮರನ್ನು ನಮಗೆ ಕೊಡುವ ದೇವರನ್ನೇ ತಿರಸ್ಕರಿಸುತ್ತಾನೆ.<verse eid="1TH 4:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="1TH 4:9"/>ಸಹೋದರ ಪ್ರೀತಿಯ ವಿಷಯದಲ್ಲಿ ನಿಮಗೆ ಬರೆಯುವುದು ಅವಶ್ಯವಿಲ್ಲ. ಒಬ್ಬರನ್ನೊಬ್ಬರು ಪ್ರೀತಿಸಬೇಕೆಂದು ನೀವು ದೇವರಿಂದಲೇ ಉಪದೇಶ ಹೊಂದಿದ್ದೀರಿ. <verse eid="1TH 4:9"/><verse number="10" style="v" sid="1TH 4:10"/>ಸಮಸ್ತ ಮಕೆದೋನ್ಯದಲ್ಲಿರುವ ಸಹೋದರರನ್ನೆಲ್ಲಾ ನೀವು ಪ್ರೀತಿಸುತ್ತಿರುವುದು ನಿಜವೆ. ಆದರೂ ಪ್ರಿಯರೇ, ನೀವು ಪ್ರೀತಿಯಲ್ಲಿ ಇನ್ನೂ ಸಮೃದ್ಧಿಯಾಗಬೇಕೆಂದು ನಾವು ನಿಮ್ಮನ್ನು ಉತ್ತೇಜಿಸುತ್ತೇವೆ. <verse eid="1TH 4:10"/><verse number="11" style="v" sid="1TH 4:11"/>ಇದಲ್ಲದೆ ನಾವು ನಿಮಗೆ ಹೇಳಿದ ಪ್ರಕಾರ ಪ್ರಶಾಂತ ಜೀವನವೇ ನಿಮ್ಮ ಗುರಿಯಾಗಿರಲಿ: ನೀವು ಸ್ವಂತ ಕಾರ್ಯಗಳನ್ನೇ ನಡೆಸಿಕೊಂಡು, ನಿಮ್ಮ ಕೈಯಾರೆ ಕೆಲಸ ಮಾಡುವವರಾಗಿರಿ. <verse eid="1TH 4:11"/><verse number="12" style="v" sid="1TH 4:12"/>ಹೀಗೆ ನಿಮ್ಮ ಅನುದಿನದ ಜೀವನವು ಹೊರಗಿನವರ ಮುಂದೆ ಯೋಗ್ಯವಾಗಿರುವುದು ಮತ್ತು ನೀವು ಯಾರ ಮೇಲೆಯೂ ಆತುಕೊಳ್ಳದೆ ಬಾಳುವಿರಿ.<verse eid="1TH 4:12"/></para>
  <para style="s1">ಪುನರುತ್ಥಾನದ ನಿರೀಕ್ಷೆ</para>
  <para style="p">
    <verse number="13" style="v" sid="1TH 4:13"/>ಪ್ರಿಯರೇ, ನೀವು ನಿರೀಕ್ಷೆಯಿಲ್ಲದೆ ಗೋಳಾಡುವವರಂತೆ ಮರಣ ಹೊಂದಿದ ವಿಶ್ವಾಸಿಗಳ ಬಗ್ಗೆ ಅಜ್ಞಾನಿಗಳಾಗಿರಬಾರದೆಂದು ನಾವು ಅಪೇಕ್ಷಿಸುತ್ತೇವೆ. <verse eid="1TH 4:13"/><verse number="14" style="v" sid="1TH 4:14"/>ಏಕೆಂದರೆ ಯೇಸು ಸತ್ತು ಪುನಃ ಜೀವಂತವಾಗಿ ಎದ್ದರೆಂದು ನಾವು ನಂಬಿದರೆ, ಅದರಂತೆ ಯೇಸುವಿನಲ್ಲಿ ನಿದ್ರೆಹೋದವರನ್ನು ಸಹ ದೇವರು ಅವರೊಡನೆ ಕರೆದುಕೊಂಡು ಬರುವರು. <verse eid="1TH 4:14"/><verse number="15" style="v" sid="1TH 4:15"/>ಕರ್ತ ಯೇಸುವಿನ ಪುನರಾಗಮನದವರೆಗೆ ಇನ್ನೂ ಜೀವದಿಂದ ಉಳಿದಿರುವ ನಾವು ಮರಣಹೊಂದಿದವರಿಗಿಂತ ಮುಂದಾಗಿ ಪುನರುತ್ಥಾನವಾಗುವುದಿಲ್ಲ ಎಂದು, ನಾವು ಕರ್ತ ಯೇಸುವಿನ ವಾಕ್ಯದ ಆಧಾರದಿಂದ ನಿಮಗೆ ಹೇಳುತ್ತಿದ್ದೇವೆ. <verse eid="1TH 4:15"/><verse number="16" style="v" sid="1TH 4:16"/>ಏಕೆಂದರೆ ಕರ್ತ ಯೇಸು ತಾವೇ ಆಜ್ಞಾಘೋಷದೊಡನೆಯೂ ಪ್ರಧಾನ ದೇವದೂತನ ಧ್ವನಿಯೊಡನೆಯೂ ದೇವರ ತುತೂರಿಯೊಡನೆಯೂ ಪರಲೋಕದಿಂದ ಇಳಿದು ಬರುವರು. ಆಗ ಕ್ರಿಸ್ತ ಯೇಸುವಿನಲ್ಲಿ ಸತ್ತವರು ಮೊದಲು ಎದ್ದು ಬರುವರು. <verse eid="1TH 4:16"/><verse number="17" style="v" sid="1TH 4:17"/>ಆಮೇಲೆ, ಜೀವದಿಂದ ಉಳಿದಿರುವ ನಾವು ಅವರೊಂದಿಗೆ ಅಂತರಿಕ್ಷದಲ್ಲಿ ಕರ್ತ ಯೇಸುವನ್ನು ಎದುರುಗೊಳ್ಳುವುದಕ್ಕಾಗಿ ಮೇಘಗಳಲ್ಲಿ ಒಯ್ಯಲಾಗುವೆವು. ಹೀಗೆ ನಾವು ಸದಾಕಾಲವೂ ಕರ್ತ ಯೇಸುವಿನ ಜೊತೆಯಲ್ಲಿಯೇ ಇರುವೆವು. <verse eid="1TH 4:17"/><verse number="18" style="v" sid="1TH 4:18"/>ಆದಕಾರಣ ಈ ಮಾತುಗಳಿಂದ ಒಬ್ಬರನ್ನೊಬ್ಬರು ಸಂತೈಸಿರಿ.<verse eid="1TH 4:18"/></para>
  <chapter eid="1TH 4"/>
  <chapter number="5" style="c" sid="1TH 5"/>
  <para style="s1">ಕರ್ತ ಯೇಸುವಿನ ದಿನವು</para>
  <para style="p">
    <verse number="1" style="v" sid="1TH 5:1"/>ಪ್ರಿಯರೇ, ಈ ಕಾಲಸಮಯಗಳನ್ನು ಕುರಿತು ನಿಮಗೆ ಬರೆಯುವುದು ಅವಶ್ಯವಿಲ್ಲ. <verse eid="1TH 5:1"/><verse number="2" style="v" sid="1TH 5:2"/>ರಾತ್ರಿಯಲ್ಲಿ ಕಳ್ಳನು ಬರುವಂತೆ ಕರ್ತ ಯೇಸುವಿನ ದಿನವು ಬರುವುದೆಂದು ನೀವೇ ಚೆನ್ನಾಗಿ ಬಲ್ಲಿರಿ. <verse eid="1TH 5:2"/><verse number="3" style="v" sid="1TH 5:3"/>ಆದರೆ, “ಸಮಾಧಾನ, ಸುರಕ್ಷಿತ,” ಎಂದು ಜನರು ಹೇಳುತ್ತಿರುವಾಗಲೇ, ಅವರ ಮೇಲೆ ವಿನಾಶವು ಗರ್ಭಿಣಿಗೆ ಪ್ರಸವವೇದನೆ ಬರುವಂತೆ ಫಕ್ಕನೆ ಬರುವುದು. ಅವರು ಹೇಗೂ ತಪ್ಪಿಸಿಕೊಳ್ಳಲಾರರು.<verse eid="1TH 5:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="1TH 5:4"/>ಆದರೆ ಪ್ರಿಯರೇ, ಆ ದಿನವು ಕಳ್ಳನಂತೆ ನಿಮ್ಮನ್ನು ಆಶ್ಚರ್ಯಪಡಿಸುವುದಕ್ಕೆ ನೀವು ಕತ್ತಲೆಯಲ್ಲಿರುವವರಲ್ಲ. <verse eid="1TH 5:4"/><verse number="5" style="v" sid="1TH 5:5"/>ನೀವೆಲ್ಲರೂ ಬೆಳಕಿನ ಮಕ್ಕಳೂ ಹಗಲಿನ ಮಕ್ಕಳೂ ಆಗಿದ್ದೀರಿ. ನಾವು ರಾತ್ರಿಯವರೂ ಅಲ್ಲ, ಕತ್ತಲೆಯವರೂ ಅಲ್ಲ. <verse eid="1TH 5:5"/><verse number="6" style="v" sid="1TH 5:6"/>ಆದಕಾರಣ ನಾವು ಇತರರಂತೆ ನಿದ್ರೆ ಮಾಡದೆ ಎಚ್ಚರವಾಗಿದ್ದು ಸ್ವಸ್ಥಚಿತ್ತರಾಗಿರೋಣ. <verse eid="1TH 5:6"/><verse number="7" style="v" sid="1TH 5:7"/>ನಿದ್ರೆ ಮಾಡುವವರು ರಾತ್ರಿಯಲ್ಲಿ ನಿದ್ರೆ ಮಾಡುತ್ತಾರೆ. ಅಮಲೇರುವವರು ರಾತ್ರಿಯಲ್ಲಿ ಅಮಲೇರುತ್ತಾರೆ. <verse eid="1TH 5:7"/><verse number="8" style="v" sid="1TH 5:8"/>ನಾವಾದರೋ ಹಗಲಿಗೆ ಸೇರಿದವರಾಗಿ ಇರುವುದರಿಂದ ನಂಬಿಕೆ ಹಾಗೂ ಪ್ರೀತಿಯನ್ನು ಕವಚವನ್ನಾಗಿಯೂ ರಕ್ಷಣೆಯ ನಿರೀಕ್ಷೆಯನ್ನು ಶಿರಸ್ತ್ರಾಣವನ್ನಾಗಿಯೂ ಧರಿಸಿಕೊಂಡು ಸ್ವಸ್ಥಚಿತ್ತರಾಗಿರೋಣ. <verse eid="1TH 5:8"/><verse number="9" style="v" sid="1TH 5:9"/>ಏಕೆಂದರೆ ದೇವರು ನಮ್ಮನ್ನು ಕೋಪಾಗ್ನಿಗೆ ನೇಮಿಸದೆ ನಾವು ನಮಗೆ ಕರ್ತ ಆಗಿರುವ ಯೇಸುಕ್ರಿಸ್ತರ ಮೂಲಕವಾಗಿ ರಕ್ಷಣೆಯನ್ನು ಹೊಂದಬೇಕೆಂದೇ ನೇಮಿಸಿದರು. <verse eid="1TH 5:9"/><verse number="10" style="v" sid="1TH 5:10"/>ನಾವು ಎಚ್ಚರವಾಗಿದ್ದರೂ ನಿದ್ರೆಯಲ್ಲಿದ್ದರೂ ತಮ್ಮ ಜೊತೆಯಲ್ಲಿಯೇ ನಾವು ಜೀವಿಸಬೇಕೆಂದು ಅವರು ನಮಗಾಗಿ ಸತ್ತರು. <verse eid="1TH 5:10"/><verse number="11" style="v" sid="1TH 5:11"/>ಆದ್ದರಿಂದ ನೀವು ಈಗ ಮಾಡುತ್ತಿರುವಂತೆಯೇ ಒಬ್ಬರನ್ನೊಬ್ಬರು ಪ್ರೋತ್ಸಾಹಿಸಿರಿ. ಒಬ್ಬರ ಭಕ್ತಿಯನ್ನೊಬ್ಬರು ವೃದ್ಧಿಗೊಳಿಸಿರಿ.<verse eid="1TH 5:11"/></para>
  <para style="s1">ಅನುಸರಿಸಬೇಕಾದ ಅಂತಿಮ ಆಜ್ಞೆಗಳು</para>
  <para style="p">
    <verse number="12" style="v" sid="1TH 5:12"/>ಪ್ರಿಯರೇ, ಯಾರು ನಿಮ್ಮ ನಡುವೆ ಪ್ರಯಾಸಪಟ್ಟು ಕರ್ತ ಯೇಸುವಿನಲ್ಲಿ ನಿಮ್ಮನ್ನು ಪರಾಮರಿಸುವವರಾಗಿದ್ದು ನಿಮಗೆ ಬುದ್ಧಿ ಹೇಳುತ್ತಾರೋ ಅವರನ್ನು ಗೌರವಿಸಿರಿ. <verse eid="1TH 5:12"/><verse number="13" style="v" sid="1TH 5:13"/>ಅವರ ಕೆಲಸದ ನಿಮಿತ್ತ ಅವರನ್ನು ಪ್ರೀತಿಯಿಂದ ಅತ್ಯಧಿಕವಾಗಿ ಸನ್ಮಾನ ಮಾಡಬೇಕೆಂದು ನಿಮ್ಮನ್ನು ಕೇಳಿಕೊಳ್ಳುತ್ತೇವೆ. ನಿಮ್ಮನಿಮ್ಮೊಳಗೆ ಸಮಾಧಾನದಿಂದಿರಿ. <verse eid="1TH 5:13"/><verse number="14" style="v" sid="1TH 5:14"/>ಪ್ರಿಯರೇ, ಶಿಸ್ತು ಇಲ್ಲದವರನ್ನು ಎಚ್ಚರಿಸಿರಿ. ಮನಗುಂದಿದವರನ್ನು ಆದರಿಸಿರಿ. ಬಲಹೀನರಿಗೆ ಆಧಾರವಾಗಿರಿ. ಎಲ್ಲರೊಂದಿಗೂ ತಾಳ್ಮೆಯುಳ್ಳವರಾಗಿರಿ ಎಂದು ನಿಮ್ಮನ್ನು ಪ್ರಬೋಧಿಸುತ್ತೇವೆ. <verse eid="1TH 5:14"/><verse number="15" style="v" sid="1TH 5:15"/>ಯಾರೂ ಅಪಕಾರಕ್ಕೆ ಅಪಕಾರ ಮಾಡದಂತೆ ನೋಡಿಕೊಳ್ಳಿರಿ. ಯಾವಾಗಲೂ ನೀವು ಒಬ್ಬರಿಗೊಬ್ಬರು ಹಿತವನ್ನು ಮಾಡಿಕೊಳ್ಳುವುದಲ್ಲದೆ ಎಲ್ಲರಿಗೂ ಹಿತವನ್ನು ಮಾಡುವವರಾಗಿರಿ.<verse eid="1TH 5:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="1TH 5:16"/>ಯಾವಾಗಲೂ ಆನಂದಿಸಿರಿ. <verse eid="1TH 5:16"/><verse number="17" style="v" sid="1TH 5:17"/>ಎಡೆಬಿಡದೆ ಪ್ರಾರ್ಥಿಸಿರಿ. <verse eid="1TH 5:17"/><verse number="18" style="v" sid="1TH 5:18"/>ಎಲ್ಲವುಗಳಿಗಾಗಿ ಕೃತಜ್ಞತೆ ಸಲ್ಲಿಸಿರಿ. ಏಕೆಂದರೆ ಇದೇ ನಿಮ್ಮ ವಿಷಯವಾಗಿ ಕ್ರಿಸ್ತ ಯೇಸುವಿನಲ್ಲಿರುವ ದೇವರ ಚಿತ್ತವಾಗಿದೆ.<verse eid="1TH 5:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="1TH 5:19"/>ಪವಿತ್ರಾತ್ಮ ದೇವರ ಸನ್ನಿಧಿಯನ್ನು ನಂದಿಸಬೇಡಿರಿ. <verse eid="1TH 5:19"/><verse number="20" style="v" sid="1TH 5:20"/>ಪ್ರವಾದನೆಗಳನ್ನು ಹೀನೈಸಬೇಡಿರಿ. <verse eid="1TH 5:20"/><verse number="21" style="v" sid="1TH 5:21"/>ಎಲ್ಲವನ್ನು ಪರಿಶೋಧಿಸಿ ಒಳ್ಳೆಯದನ್ನೇ ಬಿಗಿಯಾಗಿ ಹಿಡಿದುಕೊಳ್ಳಿರಿ. <verse eid="1TH 5:21"/><verse number="22" style="v" sid="1TH 5:22"/>ಸಕಲ ವಿಧವಾದ ಕೆಟ್ಟತನಗಳಿಗೆ ದೂರವಾಗಿರಿ.<verse eid="1TH 5:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="1TH 5:23"/>ಸಮಾಧಾನದ ದೇವರು ತಾವಾಗಿಯೇ ನಿಮ್ಮನ್ನು ಪರಿಪೂರ್ಣವಾಗಿ ಪವಿತ್ರ ಮಾಡಲಿ. ನಮಗೆ ಕರ್ತ ಆಗಿರುವ ಯೇಸುಕ್ರಿಸ್ತರ ಪುನರಾಗಮನದಲ್ಲಿ ನಿಮ್ಮ ಆತ್ಮ, ಪ್ರಾಣ, ಶರೀರಗಳು ದೋಷವಿಲ್ಲದೆ ಸಂಪೂರ್ಣವಾಗಿ ಸುರಕ್ಷಿತವಾಗಿರಲಿ. <verse eid="1TH 5:23"/><verse number="24" style="v" sid="1TH 5:24"/>ನಿಮ್ಮನ್ನು ಕರೆಯುವ ದೇವರು ನಂಬಿಗಸ್ತರು, ಅವರೇ ಅದನ್ನು ಸಾಧಿಸುವವರೂ ಆಗಿದ್ದಾರೆ.<verse eid="1TH 5:24"/></para>
  <para style="b"/>
  <para style="b"/>
  <para style="p">
    <verse number="25" style="v" sid="1TH 5:25"/>ಪ್ರಿಯರೇ, ನಮಗಾಗಿ ಪ್ರಾರ್ಥಿಸಿರಿ.<verse eid="1TH 5:25"/></para>
  <para style="b"/>
  <para style="p">
    <verse number="26" style="v" sid="1TH 5:26"/>ಪವಿತ್ರವಾದ ಮುದ್ದಿಟ್ಟು ದೇವಜನರೆಲ್ಲರನ್ನೂ ವಂದಿಸಿರಿ.<verse eid="1TH 5:26"/></para>
  <para style="b"/>
  <para style="p">
    <verse number="27" style="v" sid="1TH 5:27"/>ಈ ಪತ್ರವನ್ನು ಸಹೋದರ ಸಹೋದರಿಯರೆಲ್ಲರಿಗೂ ಓದಿ ಹೇಳಬೇಕೆಂದು ನಿಮಗೆ ಕರ್ತ ಯೇಸುವಿನ ಹೆಸರಿನಲ್ಲಿ ಆಜ್ಞಾಪಿಸುತ್ತೇನೆ.<verse eid="1TH 5:27"/></para>
  <para style="b"/>
  <para style="p">
    <verse number="28" style="v" sid="1TH 5:28"/>ನಮ್ಮ ಕರ್ತ ಆಗಿರುವ ಯೇಸುಕ್ರಿಸ್ತರ ಕೃಪೆಯು ನಿಮ್ಮೊಂದಿಗಿರಲಿ.<verse eid="1TH 5:28"/></para>
  <chapter eid="1TH 5"/>
</usx>
