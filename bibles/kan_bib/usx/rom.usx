<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="ROM" style="id">- Biblica® Open Kannada Contemporary Version</book>
  <para style="h">ರೋಮಾಪುರದವರಿಗೆ</para>
  <para style="toc1">ರೋಮಾಪುರದವರಿಗೆ ಪೌಲನು ಬರೆದ ಪತ್ರಿಕೆ</para>
  <para style="toc2">ರೋಮಾಪುರದವರಿಗೆ</para>
  <para style="toc3">ರೋಮಾ</para>
  <para style="mt1">ರೋಮಾಪುರದವರಿಗೆ</para>
  <para style="mt2">ಪೌಲನು ಬರೆದ ಪತ್ರಿಕೆ</para>
  <chapter number="1" style="c" sid="ROM 1"/>
  <para style="p">
    <verse number="1" style="v" sid="ROM 1:1"/>ಕ್ರಿಸ್ತ ಯೇಸುವಿನ ದಾಸನೂ ಅಪೊಸ್ತಲನಾಗುವುದಕ್ಕೆ ಕರೆಹೊಂದಿದವನೂ ದೇವರ ಸುವಾರ್ತೆಯನ್ನು ಸಾರುವುದಕ್ಕೆ ಪ್ರತ್ಯೇಕಗೊಂಡವನೂ ಆಗಿರುವ ಪೌಲನು ಬರೆಯುವ ಪತ್ರ. <verse eid="ROM 1:1"/><verse number="2" style="v" sid="ROM 1:2"/>ದೇವರು ಮುಂಚಿತವಾಗಿ ಪವಿತ್ರ ವೇದಗಳಲ್ಲಿ ತಮ್ಮ ಪ್ರವಾದಿಗಳ ಮೂಲಕ ವಾಗ್ದಾನಮಾಡಿದ, <verse eid="ROM 1:2"/><verse number="3" style="v" sid="ROM 1:3"/>ಈ ಸುವಾರ್ತೆಯು ದೇವಪುತ್ರನ ವಿಷಯವಾದದ್ದು. ಯೇಸು ಮನುಷ್ಯತ್ವದ ಪ್ರಕಾರ ದಾವೀದನ ಸಂತಾನದವರೂ <verse eid="ROM 1:3"/><verse number="4" style="v" sid="ROM 1:4"/>ಸತ್ತವರೊಳಗಿಂದ ಪುನರುತ್ಥಾನಗೊಂಡು ಪರಿಶುದ್ಧತೆಯ ಆತ್ಮದ ಪ್ರಕಾರ ದೇವಪುತ್ರರೆಂದು ಪ್ರಬಲವಾಗಿ ನಿರ್ಣಯಿಸಲಾದವರೂ ಆಗಿದ್ದಾರೆ. ಇವರೇ ನಮ್ಮ ಕರ್ತ ಯೇಸು ಕ್ರಿಸ್ತ. <verse eid="ROM 1:4"/><verse number="5" style="v" sid="ROM 1:5"/>ಯೇಸುವಿನ ನಾಮದ ಮಹಿಮೆಗಾಗಿ ಯೆಹೂದ್ಯರಲ್ಲದವರಲ್ಲಿಯೂ ನಂಬಿಕೆಯ ವಿಧೇಯತೆ ಉಂಟಾಗುವುದಕ್ಕಾಗಿ ನಾವು ಯೇಸುವಿನ ಮೂಲಕವಾಗಿ ಕೃಪೆಯನ್ನೂ ಅಪೊಸ್ತಲರಾಗಿರುವುದನ್ನೂ ಹೊಂದಿದೆವು. <verse eid="ROM 1:5"/><verse number="6" style="v" sid="ROM 1:6"/>ಯೇಸು ಕ್ರಿಸ್ತನವರಾಗಲು ಕರೆಯಲಾದವರಲ್ಲಿ ಯೆಹೂದ್ಯರಲ್ಲದವರಲ್ಲಿ ನೀವೂ ಸಹ ಸೇರಿದ್ದೀರಿ.<verse eid="ROM 1:6"/></para>
  <para style="b"/>
  <para style="p">
    <verse number="7" style="v" sid="ROM 1:7"/>ರೋಮ್ ನಗರದಲ್ಲಿ ದೇವರಿಗೆ ಪ್ರಿಯರೂ ದೇವರ ಪವಿತ್ರ ಜನರಾಗುವುದಕ್ಕೆ ಕರೆಯಲಾದವರೂ ಆಗಿರುವವರೆಲ್ಲರಿಗೂ:</para>
  <para style="b" vid="ROM 1:7"/>
  <para style="p" vid="ROM 1:7">ನಮ್ಮ ತಂದೆಯಾದ ದೇವರಿಂದಲೂ ಕರ್ತ ಯೇಸು ಕ್ರಿಸ್ತರಿಂದಲೂ ಕೃಪೆಯೂ ಶಾಂತಿಯೂ ಆಗಲಿ.<verse eid="ROM 1:7"/></para>
  <para style="b"/>
  <para style="s1">ರೋಮ್ ಪಟ್ಟಣ ಸಂದರ್ಶಿಸಬೇಕೆಂಬ ಪೌಲನ ಬಯಕೆ</para>
  <para style="p">
    <verse number="8" style="v" sid="ROM 1:8"/>ಮೊದಲನೆಯದಾಗಿ, ನಿಮ್ಮ ನಂಬಿಕೆಯು ಲೋಕದಲ್ಲೆಲ್ಲಾ ಪ್ರಸಿದ್ಧಿಗೆ ಬಂದದ್ದರಿಂದ ನಿಮ್ಮೆಲ್ಲರ ವಿಷಯವಾಗಿ ಕ್ರಿಸ್ತ ಯೇಸುವಿನ ಮೂಲಕ ನನ್ನ ದೇವರಿಗೆ ಕೃತಜ್ಞತೆಯನ್ನು ಸಲ್ಲಿಸುತ್ತೇನೆ. <verse eid="ROM 1:8"/><verse number="9" style="v" sid="ROM 1:9"/>ದೇವಪುತ್ರನ ಸುವಾರ್ತೆಯನ್ನು ಸಾರುವುದರಿಂದ ದೇವರನ್ನೇ ನನ್ನ ಆತ್ಮದಲ್ಲಿ ಸೇವೆ ಮಾಡುವವನಾಗಿದ್ದೇನೆ. ಇದಕ್ಕೆ ದೇವರೇ ನನ್ನ ಸಾಕ್ಷಿ. <verse eid="ROM 1:9"/><verse number="10" style="v" sid="ROM 1:10"/>ನಾನು ಪ್ರಾರ್ಥನೆ ಮಾಡುವಾಗಲೆಲ್ಲಾ ತಪ್ಪದೆ ನಿಮಗೋಸ್ಕರ ವಿಜ್ಞಾಪನೆ ಮಾಡುತ್ತಾ ಇನ್ನು ಮೇಲಾದರೂ ನಿಮ್ಮ ಬಳಿಗೆ ಬರುವುದಕ್ಕೆ ದೇವರ ಚಿತ್ತದಿಂದ ನನಗೆ ಯಾವ ರೀತಿಯಲ್ಲಾದರೂ ಅನುಕೂಲವಾಗಬೇಕೆಂದು ಬೇಡಿಕೊಳ್ಳುತ್ತೇನೆ.<verse eid="ROM 1:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="ROM 1:11"/>ನಿಮ್ಮನ್ನು ದೃಢಪಡಿಸುವುದಕ್ಕಾಗಿ ನಾನು ನಿಮಗೆ ಕೆಲವು ಆತ್ಮಿಕ ವರಗಳನ್ನು ಕೊಡಲು ನಿಮ್ಮನ್ನು ನೋಡಬೇಕೆಂದು ಅಪೇಕ್ಷಿಸುತ್ತೇನೆ. <verse eid="ROM 1:11"/><verse number="12" style="v" sid="ROM 1:12"/>ಹೀಗೆ ನಾವು ಒಬ್ಬರಿಂದೊಬ್ಬರ ನಂಬಿಕೆಯಿಂದ ಪರಸ್ಪರ ಪ್ರೋತ್ಸಾಹಗೊಳ್ಳಬೇಕು. <verse eid="ROM 1:12"/><verse number="13" style="v" sid="ROM 1:13"/>ಪ್ರಿಯರೇ, ನನ್ನ ಸೇವೆಯು ಯೆಹೂದ್ಯರಲ್ಲದವರಲ್ಲಿ ಫಲಉಂಟಾದಂತೆ ನಿಮ್ಮಲ್ಲಿಯೂ ಫಲಉಂಟಾಗಬೇಕೆಂದು ನಿಮ್ಮ ಬಳಿಗೆ ಬರುವುದಕ್ಕೆ ಅನೇಕಾವರ್ತಿ ಉದ್ದೇಶಿಸಿದೆನು. ಆದರೆ ಅದಕ್ಕೆ ಇಂದಿನವರೆಗೂ ಅಡ್ಡಿಯಾಯಿತೆಂದು ನಿಮಗೆ ತಿಳಿದಿರಬೇಕೆಂಬುದು ನನ್ನ ಅಪೇಕ್ಷೆ.<verse eid="ROM 1:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="ROM 1:14"/>ಗ್ರೀಕರಿಗೂ ಗ್ರೀಕರಲ್ಲದವರಿಗೂ ಜ್ಞಾನಿಗಳಿಗೂ ಮೂಢರಿಗೂ ನಾನು ಸಾಲಗಾರನಾಗಿದ್ದೇನೆ. <verse eid="ROM 1:14"/><verse number="15" style="v" sid="ROM 1:15"/>ಹೀಗಿರುವುದರಿಂದ ರೋಮ್ ನಗರದಲ್ಲಿರುವ ನಿಮಗೂ ಸಹ ಸುವಾರ್ತೆಯನ್ನು ಸಾರುವುದಕ್ಕೆ ನಾನು ಉತ್ಸುಕನಾಗಿದ್ದೇನೆ.<verse eid="ROM 1:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="ROM 1:16"/>ನಾನು ಸುವಾರ್ತೆಯ ವಿಷಯದಲ್ಲಿ ನಾಚಿಕೊಳ್ಳುವವನಲ್ಲ. ಏಕೆಂದರೆ ಅದು ಮೊದಲು ಯೆಹೂದ್ಯರಿಗೆ ಆಮೇಲೆ ಯೆಹೂದ್ಯರಲ್ಲದವರಿಗೆ, ಹೀಗೆ ನಂಬುವವರೆಲ್ಲರಿಗೂ ರಕ್ಷಣೆಯನ್ನು ಉಂಟುಮಾಡುವ ದೇವರ ಶಕ್ತಿಯಾಗಿದೆ. <verse eid="ROM 1:16"/><verse number="17" style="v" sid="ROM 1:17"/>ದೇವರಿಂದ ದೊರಕುವ ನೀತಿಯು ಸುವಾರ್ತೆಯಲ್ಲಿ ಪ್ರಕಟವಾಗಿದೆ. “ನೀತಿವಂತನು ನಂಬಿಕೆಯಿಂದಲೇ ಬದುಕುವನು,”<note caller="+" style="f"><char style="fr" closed="false">1:17 </char><char style="ft" closed="false"><char style="xt"><ref loc="HAB 2:4">ಹಬ 2:4</ref></char></char></note> ಎಂದು ಬರೆದಿರುವ ಪ್ರಕಾರ, ಆ ನೀತಿಯು ಪ್ರಾರಂಭದಿಂದ ಕೊನೆಯವರೆಗೆ ನಂಬಿಕೆಯಿಂದಲೇ ಆದದ್ದು.<verse eid="ROM 1:17"/></para>
  <para style="s1">ದೇವರ ಕೋಪಾಗ್ನಿ</para>
  <para style="p">
    <verse number="18" style="v" sid="ROM 1:18"/>ದುಷ್ಟತನದಿಂದ ಸತ್ಯವನ್ನು ಅಡಗಿಸುವವರಾದ ಮನುಷ್ಯರ ಎಲ್ಲಾ ವಿಧವಾದ ಭಕ್ತಿಹೀನತೆ ಹಾಗೂ ದುಷ್ಟತನದ ಮೇಲೆ ದೇವರ ರೌದ್ರವು ಪರಲೋಕದಿಂದ ಪ್ರಕಟವಾಗುತ್ತಿದೆ. <verse eid="ROM 1:18"/><verse number="19" style="v" sid="ROM 1:19"/>ದೇವರ ವಿಷಯವಾಗಿ ತಿಳಿಯಬಹುದಾದದ್ದನ್ನು ಅವರಿಗೆ ಸ್ಪಷ್ಟಪಡಿಸಲಾಗಿದೆ. ಏಕೆಂದರೆ ಅದನ್ನು ಅವರಿಗೆ ದೇವರೇ ಪ್ರಕಟಿಸಿದರು. <verse eid="ROM 1:19"/><verse number="20" style="v" sid="ROM 1:20"/>ಹೇಗೆಂದರೆ ಕಣ್ಣಿಗೆ ಕಾಣದ ಗುಣಲಕ್ಷಣಗಳಾಗಿರುವ ದೇವರ ಗುಣವೂ ನಿತ್ಯಶಕ್ತಿಯೂ ದೈವಸ್ವಭಾವವೂ ಜಗದ ಸೃಷ್ಟಿ ದಿನದಿಂದ ಅವರು ಸೃಷ್ಟಿಸಿದವುಗಳ ಮೂಲಕ ಸ್ಪಷ್ಟವಾಗಿ ಕಂಡುಬರುತ್ತಿವೆ. ಹೀಗಿರುವುದರಿಂದ ಜನರಿಗೆ ತಪ್ಪಿಸಿಕೊಳ್ಳಲು ನೆಪ ಇಲ್ಲವಾಗಿದೆ.<verse eid="ROM 1:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="ROM 1:21"/>ಏಕೆಂದರೆ ದೇವರನ್ನು ಅವರು ತಿಳಿದಿದ್ದರೂ ದೇವರೆಂದು ಮಹಿಮೆ ಪಡಿಸಲಿಲ್ಲ, ದೇವರ ಉಪಕಾರ ಸ್ಮರಿಸಲಿಲ್ಲ. ಆದರೆ ಅವರು ತಮ್ಮ ವಿಚಾರಗಳಲ್ಲಿ ವ್ಯರ್ಥರಾದರು. ವಿವೇಕವಿಲ್ಲದ ಅವರ ಹೃದಯವು ಕತ್ತಲಾಯಿತು. <verse eid="ROM 1:21"/><verse number="22" style="v" sid="ROM 1:22"/>ತಾವು ಜ್ಞಾನಿಗಳೆಂದು ಹೇಳಿಕೊಂಡರೂ ಮೂಢರಾಗಿದ್ದಾರೆ. <verse eid="ROM 1:22"/><verse number="23" style="v" sid="ROM 1:23"/>ಲಯವಿಲ್ಲದ ದೇವರ ಮಹಿಮೆಯನ್ನು ಲಯವಾಗುವ ಮನುಷ್ಯ, ಪಶು, ಪಕ್ಷಿ, ಸರ್ಪಾದಿಗಳ ಮೂರ್ತಿಗಳೊಂದಿಗೆ ಬದಲಿಸಿಕೊಂಡರು.<verse eid="ROM 1:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="ROM 1:24"/>ಆದಕಾರಣ ಅವರು ತಮ್ಮ ಹೃದಯದ ದುರಾಶೆಗಳಂತೆ ನಡೆದು ತಮ್ಮ ದೇಹಗಳನ್ನು ಮಲಿನ ಮಾಡಿಕೊಳ್ಳಲಿ ಎಂದು ದೇವರು ಅವರನ್ನು ಅಶುದ್ಧತೆಗೆ ಒಪ್ಪಿಸಿಬಿಟ್ಟರು. <verse eid="ROM 1:24"/><verse number="25" style="v" sid="ROM 1:25"/>ಅವರು ದೇವರ ಸತ್ಯವನ್ನು ಸುಳ್ಳನ್ನಾಗಿ ಬದಲಿಸಿಕೊಂಡು, ಸೃಷ್ಟಿಕರ್ತನನ್ನು ಆರಾಧಿಸದೆ ಸೃಷ್ಟಿವಸ್ತುಗಳನ್ನೇ ಪೂಜಿಸಿ ಸೇವೆ ಸಲ್ಲಿಸುವವರಾದರು. ಸೃಷ್ಟಿ ಕರ್ತನೇ ನಿರಂತರವಾಗಿ ಸ್ತುತಿ ಹೊಂದತಕ್ಕವರು. ಆಮೆನ್.<verse eid="ROM 1:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="ROM 1:26"/>ಅವರು ಇಂಥದ್ದನ್ನು ಮಾಡಿದ್ದರಿಂದ ದೇವರು ಅವರನ್ನು ಕೇವಲ ಲಜ್ಜಾಸ್ಪದವಾದ ಕಾಮಾಭಿಲಾಷೆಗೆ ಒಪ್ಪಿಸಿಬಿಟ್ಟರು. ಹೇಗೆಂದರೆ ಅವರ ಸ್ತ್ರೀಯರು ಸಹ ಸ್ವಾಭಾವಿಕವಾದ ಭೋಗವನ್ನು ಬಿಟ್ಟು, ಅಸ್ವಾಭಾವಿಕವಾದದ್ದನ್ನು ಅನುಸರಿಸಿದರು. <verse eid="ROM 1:26"/><verse number="27" style="v" sid="ROM 1:27"/>ಅದರಂತೆ ಗಂಡಸರು ಸಹ ಸ್ವಾಭಾವಿಕವಾದ ಸ್ತ್ರೀಭೋಗವನ್ನು ಬಿಟ್ಟು ಒಬ್ಬರೊಂದಿಗೊಬ್ಬರು ಕಾಮಾತುರದಿಂದ ತಾಪಗೊಂಡರು. ಗಂಡಸರ ಸಂಗಡ ಗಂಡಸರು ಕೇವಲ ಅವಲಕ್ಷಣ ಕೃತ್ಯಗಳನ್ನು ನಡೆಸಿ ತಮ್ಮ ತಪ್ಪಿಗೆ ತಕ್ಕ ದಂಡನೆಯನ್ನು ಹೊಂದುವವರಾದರು.<verse eid="ROM 1:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="ROM 1:28"/>ಇದಲ್ಲದೆ, ದೇವರನ್ನು ಒಪ್ಪಿಕೊಳ್ಳಲು ಅವರಿಗೆ ಇಷ್ಟವಿಲ್ಲದ್ದರಿಂದ ಅಲ್ಲದ ಕೃತ್ಯಗಳನ್ನು ನಡೆಸುವವರಾಗುವಂತೆ ದೇವರು ಅನಾಚಾರದ ಮನಸ್ಸಿಗೆ ಅವರನ್ನು ಒಪ್ಪಿಸಿದರು. <verse eid="ROM 1:28"/><verse number="29" style="v" sid="ROM 1:29"/>ಅವರು ಸಕಲ ವಿಧವಾದ ಅನ್ಯಾಯ, ದುರ್ಮಾರ್ಗತನ, ಲೋಭ, ದುಷ್ಟತ್ವ, ಹೊಟ್ಟೆಕಿಚ್ಚು, ಕೊಲೆ, ಜಗಳ, ಕಪಟ, ಹಗೆತನಗಳಿಂದಲೂ ತುಂಬಿದವರಾದರು. <verse eid="ROM 1:29"/><verse number="30" style="v" sid="ROM 1:30"/>ಅವರು ಕಿವಿ ಊದುವವರೂ ಚಾಡಿಹೇಳುವವರೂ ದೇವರನ್ನು ದ್ವೇಷಿಸುವವರೂ ಸೊಕ್ಕಿನವರೂ ಅಹಂಕಾರಿಗಳೂ ಬಡಾಯಿ ಕೊಚ್ಚುವವರೂ ಕೇಡನ್ನು ಕಲ್ಪಿಸುವವರೂ ತಂದೆತಾಯಿಗಳ ಮಾತನ್ನು ಕೇಳದವರೂ <verse eid="ROM 1:30"/><verse number="31" style="v" sid="ROM 1:31"/>ವಿವೇಚನೆಯಿಲ್ಲದವರೂ ನಂಬಿಕೆಯಿಲ್ಲದವರೂ ಮಮತೆಯಿಲ್ಲದವರೂ ಕರುಣೆಯಿಲ್ಲದವರೂ ಆದರು. <verse eid="ROM 1:31"/><verse number="32" style="v" sid="ROM 1:32"/>ಇಂಥವುಗಳನ್ನು ನಡೆಸುವವರು ಮರಣಕ್ಕೆ ಪಾತ್ರರಾಗಿದ್ದಾರೆಂಬ ದೈವವಿಧಿಯನ್ನು ತಿಳಿದಿದ್ದರೂ ಅವರು ತಾವೇ ಅವುಗಳನ್ನು ಮಾಡುವುದಲ್ಲದೆ ಹಾಗೆ ಮಾಡುವವರನ್ನು ಮೆಚ್ಚುತ್ತಾರೆ.<verse eid="ROM 1:32"/></para>
  <chapter eid="ROM 1"/>
  <chapter number="2" style="c" sid="ROM 2"/>
  <para style="s1">ದೇವರ ನೀತಿಯ ತೀರ್ಪು</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 2:1"/>ಆದ್ದರಿಂದ, ಯಾವ ಕಾರಣಕ್ಕಾಗಿ ನೀನು ಇತರರಿಗೆ ತೀರ್ಪು ಮಾಡುತ್ತಿರುವೆಯೋ ಅದನ್ನೇ ನೀನೂ ಮಾಡುತ್ತಿರುವುದರಿಂದ ನಿನ್ನನ್ನು ನೀನೇ ತೀರ್ಪು ಮಾಡಿಕೊಂಡ ಹಾಗಾಯಿತು. ಇತರರ ಮೇಲೆ ತೀರ್ಪುಮಾಡುವ ನಿನಗೆ ಹೇಳುವುದಕ್ಕೆ ನೆಪವಿಲ್ಲ. <verse eid="ROM 2:1"/><verse number="2" style="v" sid="ROM 2:2"/>ಆದರೆ ಅಂಥಾ ಅಪರಾಧಗಳನ್ನು ಮಾಡುವವರ ವಿಷಯದಲ್ಲಿ ದೇವರು ಮಾಡುವ ತೀರ್ಪು ಸತ್ಯಕ್ಕನುಸಾರವಾಗಿಯೇ ಇರುವುದೆಂದು ನಾವು ಬಲ್ಲೆವು. <verse eid="ROM 2:2"/><verse number="3" style="v" sid="ROM 2:3"/>ಮನುಷ್ಯನೇ, ಅಂಥವುಗಳನ್ನು ನಡೆಸುವವರ ಮೇಲೆ ತೀರ್ಪುಮಾಡುತ್ತಿರುವ ನೀನು ದೇವರ ತೀರ್ಪಿನಿಂದ ತಪ್ಪಿಸಿಕೊಂಡೇನೆಂದು ನೆನಸುತ್ತೀಯೋ? <verse eid="ROM 2:3"/><verse number="4" style="v" sid="ROM 2:4"/>ದೇವರ ದಯೆ, ಐಶ್ವರ್ಯ, ಸಹನೆ ಮತ್ತು ದೀರ್ಘಶಾಂತಿ ಇವುಗಳನ್ನು ತಾತ್ಸಾರ ಮಾಡುತ್ತೀಯೋ? ದೇವರ ಒಳ್ಳೆಯತನವು ನಿನ್ನನ್ನು ಪಶ್ಚಾತ್ತಾಪಕ್ಕೆ ನಡೆಸುತ್ತದೆಂಬುದು ನಿನಗೆ ತಿಳಿಯದೋ?<verse eid="ROM 2:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="ROM 2:5"/>ನೀನು ನಿನ್ನ ಕಠಿಣವಾದ ಮತ್ತು ಪಶ್ಚಾತ್ತಾಪ ಪಡದ ಹೃದಯದಿಂದ, ನಿನಗೋಸ್ಕರ ದೇವರ ನೀತಿಯುಳ್ಳ ತೀರ್ಪು ಪ್ರಕಟವಾಗುವ ಕೋಪದ ದಿನಕ್ಕಾಗಿ ದೇವರ ಕೋಪವನ್ನು ಸಂಗ್ರಹಿಸಿಕೊಳ್ಳುತ್ತಿದ್ದಿ. <verse eid="ROM 2:5"/><verse number="6" style="v" sid="ROM 2:6"/>ದೇವರು, “ಪ್ರತಿಯೊಬ್ಬನಿಗೂ ಅವನವನ ಕೃತ್ಯಗಳಿಗೆ ತಕ್ಕ ಪ್ರತಿಫಲ ಕೊಡುವರು.”<note caller="+" style="f"><char style="fr" closed="false">2:6 </char><char style="ft" closed="false"><char style="xt"><ref loc="PSA 62:12">ಕೀರ್ತನೆ 62:12</ref>; <ref loc="PRO 24:12">ಜ್ಞಾನೋಕ್ತಿ 24:12</ref></char></char></note> <verse eid="ROM 2:6"/><verse number="7" style="v" sid="ROM 2:7"/>ಯಾರು ಮಹಿಮೆ, ಮಾನ, ಅಮರತ್ವ ಸತ್ಕ್ರಿಯೆಗಳನ್ನು ಸಹನೆಯಿಂದ ಮಾಡುತ್ತಾರೋ ಅವರಿಗೆ ದೇವರು ನಿತ್ಯಜೀವವನ್ನು ಕೊಡುವರು. <verse eid="ROM 2:7"/><verse number="8" style="v" sid="ROM 2:8"/>ಯಾರು ಸ್ವಾರ್ಥಿಗಳಾಗಿದ್ದು ಸತ್ಯವನ್ನು ಅನುಸರಿಸದೆ ಅನೀತಿಯನ್ನು ಅನುಸರಿಸುತ್ತಾರೋ ಅವರ ವಿರುದ್ಧ ದೇವರಿಗೆ ಕೋಪವೂ ಆಕ್ರೋಶವೂ ಬರುತ್ತವೆ. <verse eid="ROM 2:8"/><verse number="9" style="v" sid="ROM 2:9"/>ಕೆಟ್ಟದ್ದನ್ನು ನಡೆಸುವ ಪ್ರತಿ ಮನುಷ್ಯನಿಗೆ ಕಷ್ಟವೂ ಸಂಕಟವೂ ಬರುತ್ತವೆ, ಯೆಹೂದ್ಯರಿಗೆ ಮೊದಲು, ಅನಂತರ ಯೆಹೂದ್ಯರಲ್ಲದವರಿಗೂ ಸಹ. <verse eid="ROM 2:9"/><verse number="10" style="v" sid="ROM 2:10"/>ಆದರೆ ಒಳ್ಳೆಯದನ್ನು ನಡೆಸುವ ಪ್ರತಿಯೊಬ್ಬನಿಗೆ ಮಹಿಮೆಯೂ ಗೌರವವೂ ಸಮಾಧಾನವೂ ಉಂಟಾಗುತ್ತವೆ. ಯೆಹೂದ್ಯರಿಗೆ ಮೊದಲು, ಅನಂತರ ಯೆಹೂದ್ಯರಲ್ಲದವರಿಗೂ ಸಹ. <verse eid="ROM 2:10"/><verse number="11" style="v" sid="ROM 2:11"/>ದೇವರಲ್ಲಿ ಪಕ್ಷಪಾತವಿಲ್ಲ.<verse eid="ROM 2:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="ROM 2:12"/>ನಿಯಮವಿಲ್ಲದವರಾಗಿ ಪಾಪಮಾಡಿದವರು ನಿಯಮವಿಲ್ಲದೆಯೇ ನಾಶಹೊಂದುವರು. ನಿಯಮಕ್ಕೆ ಅಧೀನರಾಗಿದ್ದು ಪಾಪಮಾಡಿದವರು ನಿಯಮದ ಮೂಲಕವಾಗಿ ತೀರ್ಪನ್ನು ಹೊಂದುವರು. <verse eid="ROM 2:12"/><verse number="13" style="v" sid="ROM 2:13"/>ಯಾರೂ ನಿಯಮವನ್ನು ಕೇಳಿದ ಮಾತ್ರಕ್ಕೆ ದೇವರ ಮುಂದೆ ನೀತಿವಂತರಾಗುವುದಿಲ್ಲ. ಆದರೆ ನಿಯಮಕ್ಕೆ ವಿಧೇಯರಾಗುವವರೇ ನೀತಿವಂತರಾಗುವರು. <verse eid="ROM 2:13"/><verse number="14" style="v" sid="ROM 2:14"/>ನಿಯಮವಿಲ್ಲದ ಯೆಹೂದ್ಯರಲ್ಲದವರು ಸ್ವಾಭಾವಿಕವಾಗಿ ನಿಯಮದಲ್ಲಿ ಹೇಳಿದಂತೆ ನಡೆಯುವಾಗ ಅವರಿಗೆ ನಿಯಮವಿಲ್ಲದಿದ್ದರೂ ಅವರ ಅಂತರಂಗವೇ ನಿಯಮವಾಗಿದೆ. <verse eid="ROM 2:14"/><verse number="15" style="v" sid="ROM 2:15"/>ಅವರು ತಮ್ಮ ನಡತೆಯಿಂದಲೇ ನಿಯಮವು ತಮ್ಮ ಹೃದಯದಲ್ಲಿ ಬರೆದಿದೆ ಎಂಬುದನ್ನು ತೋರಿಸುತ್ತಾರೆ. ಇದಕ್ಕೆ ಅವರ ಮನಸ್ಸು ಸಾಕ್ಷಿಕೊಡುತ್ತದೆ. ಅವರ ಯೋಚನೆಗಳು ಒಂದಕ್ಕೊಂದು ಇದು ತಪ್ಪು ಅಥವಾ ತಪ್ಪಲ್ಲ ಎಂಬುದನ್ನು ಸೂಚಿಸುತ್ತವೆ. <verse eid="ROM 2:15"/><verse number="16" style="v" sid="ROM 2:16"/>ನಾನು ಸಾರುವ ಸುವಾರ್ತೆಯ ಪ್ರಕಾರ ದೇವರು ಕ್ರಿಸ್ತ ಯೇಸುವಿನ ಮೂಲಕವಾಗಿ ಮನುಷ್ಯರ ಗುಟ್ಟುಗಳನ್ನು ವಿಚಾರಿಸುವ ದಿನದಲ್ಲಿ ಇವೆಲ್ಲಾ ಸಂಭವಿಸುವುದು.<verse eid="ROM 2:16"/></para>
  <para style="s1">ಯೆಹೂದ್ಯರು ಮತ್ತು ಮೋಶೆಯ ನಿಯಮ</para>
  <para style="p">
    <verse number="17" style="v" sid="ROM 2:17"/>ಆದರೆ, ನೀನು ಯೆಹೂದ್ಯನೆನಿಸಿಕೊಂಡವನೂ ನಿಯಮದಲ್ಲಿ ಭರವಸೆಯಿಟ್ಟವನೂ ದೇವರಿಗೆ ಸೇರಿದವನೂ <verse eid="ROM 2:17"/><verse number="18" style="v" sid="ROM 2:18"/>ದೇವರ ಚಿತ್ತವನ್ನು ಬಲ್ಲವನೂ ನಿಯಮದಿಂದ ಉಪದೇಶವನ್ನು ಹೊಂದಿ ಯಾವುದು ಉತ್ತಮವಾದದ್ದೆಂದು ಅನುಮೋದಿಸುವವನೂ ಆಗಿದ್ದೀ. <verse eid="ROM 2:18"/><verse number="19" style="v" sid="ROM 2:19"/>ನಿನಗೆ ನಿಯಮದ ಜ್ಞಾನ ಮತ್ತು ಸತ್ಯವು ಇರುವುದರಿಂದ ನೀನು ಕುರುಡರಿಗೆ ಮಾರ್ಗದರ್ಶಿಯೂ ಕತ್ತಲೆಯಲ್ಲಿರುವವರಿಗೆ ಬೆಳಕೂ <verse eid="ROM 2:19"/><verse number="20" style="v" sid="ROM 2:20"/>ತಿಳುವಳಿಕೆಯಿಲ್ಲದವರಿಗೆ ಶಿಕ್ಷಕನೂ ಬಾಲಕರಿಗೆ ಉಪಾಧ್ಯಾಯನೂ ಆಗಿದ್ದೀಯೆಂದು ಧೈರ್ಯವಾಗಿದ್ದೀಯಲ್ಲಾ? <verse eid="ROM 2:20"/><verse number="21" style="v" sid="ROM 2:21"/>ಇತರರಿಗೆ ಉಪದೇಶಿಸುವ ನೀನು, ನಿನಗೆ ನೀನೇ ಉಪದೇಶ ಮಾಡಿಕೋ. ಕದಿಯಬಾರದೆಂದು ಸಾರುವ ನೀನು ಕದಿಯುತ್ತೀಯೋ? <verse eid="ROM 2:21"/><verse number="22" style="v" sid="ROM 2:22"/>ವ್ಯಭಿಚಾರ ಮಾಡಬಾರದೆಂದು ಹೇಳುವ ನೀನು ವ್ಯಭಿಚಾರ ಮಾಡುತ್ತೀಯೋ? ವಿಗ್ರಹಗಳಲ್ಲಿ ಅಸಹ್ಯಪಡುವ ನೀನು ದೇವಾಲಯಗಳನ್ನು ದೋಚುತ್ತೀಯೋ? <verse eid="ROM 2:22"/><verse number="23" style="v" sid="ROM 2:23"/>ನಿಯಮದ ಬಗ್ಗೆ ಹೆಚ್ಚಳ ಪಡುವ ನೀನು ನಿಯಮವನ್ನು ಮೀರಿ ನಡೆದು ದೇವರನ್ನು ಅವಮಾನ ಪಡಿಸುತ್ತೀಯೋ? <verse eid="ROM 2:23"/><verse number="24" style="v" sid="ROM 2:24"/>ಪವಿತ್ರ ವೇದದಲ್ಲಿ ಬರೆದಿರುವಂತೆ, “ನಿಮ್ಮ ದೆಸೆಯಿಂದ ಯೆಹೂದ್ಯರಲ್ಲದವರಲ್ಲಿ ದೇವರ ನಾಮವು ದೂಷಣೆಗೆ ಗುರಿಯಾಗುತ್ತಿದೆ.”<note caller="+" style="f"><char style="fr" closed="false">2:24 </char><char style="ft" closed="false"><char style="xt"><ref loc="ISA 52:5">ಯೆಶಾಯ 52:5</ref>; <ref loc="EZK 36:20">ಯೆಹೆ 36:20</ref>,<ref loc="EZK 36:22">22</ref></char></char></note><verse eid="ROM 2:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="ROM 2:25"/>ನೀನು ನಿಯಮವನ್ನು ಕೈಕೊಳ್ಳುವವನಾದರೆ, ಸುನ್ನತಿ ಪ್ರಯೋಜನಕರವಾಗಿರುವುದು. ಆದರೆ ನೀನು ನಿಯಮವನ್ನು ಮೀರಿ ನಡೆಯುವವನಾದರೆ, ನಿನಗೆ ಸುನ್ನತಿಯಾಗಿದ್ದರೂ ಇಲ್ಲದಂತಾಗಿರುವುದು. <verse eid="ROM 2:25"/><verse number="26" style="v" sid="ROM 2:26"/>ಸುನ್ನತಿಯಿಲ್ಲದವನು ನಿಯಮಗಳನ್ನು ಕೈಗೊಳ್ಳುವವರೆಗೆ ಸುನ್ನತಿಯಿಲ್ಲದವನಾಗಿದ್ದರೂ ಸುನ್ನತಿಯಿದ್ದವನಂತೆ ಎಣಿಸುವುದಿಲ್ಲವೇ? <verse eid="ROM 2:26"/><verse number="27" style="v" sid="ROM 2:27"/>ಅವನು ಶಾರೀರಿಕವಾಗಿ ಸುನ್ನತಿಯಿಲ್ಲದವನಾಗಿದ್ದರೂ ನಿಯಮವನ್ನು ಅನುಸರಿಸುವುದರಿಂದ ಲಿಖಿತ ನಿಯಮವೂ ಸುನ್ನತಿಯೂ ಇದ್ದು ನಿಯಮವನ್ನು ಮೀರಿ ನಡೆಯುವ ನಿನ್ನನ್ನು ದೋಷಿಯೆಂದು ತೀರ್ಪು ಮಾಡುವನಲ್ಲವೇ?<verse eid="ROM 2:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="ROM 2:28"/>ಹೊರಗೆ ಮಾತ್ರ ಯೆಹೂದ್ಯನಾಗಿರುವವನು ಯೆಹೂದ್ಯನಲ್ಲ. ಹೊರಗೆ ಶರೀರದಲ್ಲಿ ಮಾತ್ರ ಮಾಡಿರುವ ಸುನ್ನತಿಯು ಸುನ್ನತಿಯಲ್ಲ. <verse eid="ROM 2:28"/><verse number="29" style="v" sid="ROM 2:29"/>ಆದರೆ, ಆಂತರ್ಯದಲ್ಲಿ ಯೆಹೂದ್ಯನಾಗಿರುವವನೇ ಯೆಹೂದ್ಯನು. ಹಾಗೆಯೇ ಸುನ್ನತಿಯು ಆತ್ಮನಿಂದ ಹೃದಯದಲ್ಲಿ ಆಗುವಂಥದ್ದಾಗಿದೆ. ಇದು ಲಿಖಿತ ನಿಯಮದಿಂದ ಆಗುವಂಥದಲ್ಲ. ಅಂಥವನಿಗೆ ಮೆಚ್ಚುಗೆಯು ಮನುಷ್ಯರಿಂದ ಬರುವಂಥದಲ್ಲ, ದೇವರಿಂದಲೇ ಬರುವಂಥದ್ದಾಗಿದೆ.<verse eid="ROM 2:29"/></para>
  <chapter eid="ROM 2"/>
  <chapter number="3" style="c" sid="ROM 3"/>
  <para style="s1">ದೇವರ ನಂಬಿಗಸ್ತಿಕೆ</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 3:1"/>ಹಾಗಾದರೆ ಯೆಹೂದ್ಯರಾಗಿರುವುದರಿಂದ ಪ್ರಯೋಜನವೇನು? ಅಥವಾ ಸುನ್ನತಿಯಿಂದ ಲಾಭವೇನು? <verse eid="ROM 3:1"/><verse number="2" style="v" sid="ROM 3:2"/>ಎಲ್ಲಾ ವಿಷಯಗಳಲ್ಲಿಯೂ ಬಹಳ ಪ್ರಯೋಜನವಿದೆ. ಮೊದಲನೆಯದಾಗಿ ದೇವರ ವಾಕ್ಯಗಳು ಯೆಹೂದ್ಯರ ವಶಕ್ಕೆ ಒಪ್ಪಿಸಲಾಗಿವೆ.<verse eid="ROM 3:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="ROM 3:3"/>ಅವರಲ್ಲಿ ಕೆಲವರು ನಂಬದೆ ಹೋಗಿದ್ದರೇನು? ಅವರ ಅಪನಂಬಿಕೆಯು ದೇವರ ಪ್ರಾಮಾಣಿಕತೆಯನ್ನು ರದ್ದುಗೊಳಿಸುವುದೇ? <verse eid="ROM 3:3"/><verse number="4" style="v" sid="ROM 3:4"/>ಎಂದಿಗೂ ಹಾಗೆ ಆಗದಿರಲಿ. ಆದರೆ ಪ್ರತಿ ಮನುಷ್ಯನು ಸುಳ್ಳುಗಾರನಾದರೂ ದೇವರು ಸತ್ಯವಂತರೇ. ಪವಿತ್ರ ವೇದದಲ್ಲಿ ಹೀಗೆ ಬರೆದಿದೆ:</para>
  <para style="q1" vid="ROM 3:4">“ನೀನು ನಿನ್ನ ಮಾತುಗಳಲ್ಲಿಯೇ ನೀತಿವಂತನೆಂದು ನಿರ್ಣಯಿಸಲಾಗುವೆ.</para>
  <para style="q2" vid="ROM 3:4">ನಿನ್ನ ಮೇಲೆ ತೀರ್ಪು ಮಾಡುವಾಗ ನೀನು ಜಯಿಸಬೇಕು.”<note caller="+" style="f"><char style="fr" closed="false">3:4 </char><char style="ft" closed="false"><char style="xt"><ref loc="PSA 51:4">ಕೀರ್ತನೆ 51:4</ref></char></char></note><verse eid="ROM 3:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="ROM 3:5"/>ಹೀಗೆ ನಮ್ಮ ಅನೀತಿಯೂ ದೇವರ ನೀತಿಯನ್ನು ಪ್ರಸಿದ್ಧಿಗೆ ತರುವುದಾದರೆ, ಕೋಪವನ್ನು ಸುರಿಸುವ ದೇವರು ಅನ್ಯಾಯಗಾರರೇನು? ನಾನು ಮಾನವ ರೀತಿಯಲ್ಲಿ ಮಾತನಾಡಿದ್ದೇನೆ. <verse eid="ROM 3:5"/><verse number="6" style="v" sid="ROM 3:6"/>ಎಂದಿಗೂ ಹಾಗೆ ಆಗದಿರಲಿ. ದೇವರು ಅನ್ಯಾಯಗಾರರಾಗಿದ್ದರೆ ಲೋಕಕ್ಕೆ ನ್ಯಾಯತೀರಿಸುವುದು ಹೇಗೆ? <verse eid="ROM 3:6"/><verse number="7" style="v" sid="ROM 3:7"/>“ನನ್ನ ಸುಳ್ಳಿನಿಂದ ದೇವರ ಸತ್ಯವು ಪ್ರಸಿದ್ಧಿಗೊಂಡು ಅವರ ಮಹಿಮೆಯನ್ನು ಹೆಚ್ಚಿಸುವುದಾದರೆ ನನಗೆ ಪಾಪಿಯೆಂದು ಇನ್ನು ತೀರ್ಪಾಗುವುದು ಏಕೆ?” <verse eid="ROM 3:7"/><verse number="8" style="v" sid="ROM 3:8"/>“ಒಳ್ಳೆಯದಾಗುವಂತೆ ಕೆಟ್ಟದ್ದನ್ನು ಮಾಡೋಣ,” ಎಂದು ನಾವು ಹೇಳುತ್ತಿರುವುದಾಗಿ, ಕೆಲವರು ನಮ್ಮ ಬಗ್ಗೆ ದೂಷಿಸಿ ಹೇಳುವ ಪ್ರಕಾರ ನಾವೇಕೆ ಹೇಳಬಾರದು? ಅಂಥವರಿಗೆ ದಂಡನೆಯ ತೀರ್ಪಾಗುವುದು ನ್ಯಾಯವೇ!<verse eid="ROM 3:8"/></para>
  <para style="s1">ಯಾರೂ ನೀತಿವಂತರಲ್ಲ</para>
  <para style="p">
    <verse number="9" style="v" sid="ROM 3:9"/>ಹಾಗಾದರೆ ಏನು? ಯೆಹೂದ್ಯರಾದ ನಾವು ಯೆಹೂದ್ಯರಲ್ಲದವರಿಗಿಂತಲೂ ಶ್ರೇಷ್ಠರೋ? ಎಂದಿಗೂ ಇಲ್ಲವಲ್ಲ. ಯೆಹೂದ್ಯರಾಗಲಿ, ಯೆಹೂದ್ಯರಲ್ಲದವರಾಗಲಿ ಎಲ್ಲರೂ ಪಾಪದ ಶಕ್ತಿಗೆ ಒಳಗಾದವರೆಂದು ನಾವು ಈಗಾಗಲೇ ತೋರಿಸಿದ್ದೇವೆ. <verse eid="ROM 3:9"/><verse number="10" style="v" sid="ROM 3:10"/>ಪವಿತ್ರ ವೇದಗಳಲ್ಲಿ ಬರೆದಿರುವಂತೆ:</para>
  <para style="q1" vid="ROM 3:10">“ನೀತಿವಂತನು ಇಲ್ಲ, ಒಬ್ಬನೂ ಇಲ್ಲ.<verse eid="ROM 3:10"/></para>
  <para style="q2">
    <verse number="11" style="v" sid="ROM 3:11"/>ಅರ್ಥಮಾಡಿಕೊಳ್ಳುವವನು ಒಬ್ಬನೂ ಇಲ್ಲ.</para>
  <para style="q2" vid="ROM 3:11">ದೇವರನ್ನು ಹುಡುಕುವವನು ಒಬ್ಬನೂ ಇಲ್ಲ.<verse eid="ROM 3:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="ROM 3:12"/>ಎಲ್ಲರೂ ದಾರಿತಪ್ಪಿ ಹೋಗಿದ್ದಾರೆ,</para>
  <para style="q2" vid="ROM 3:12">ಎಲ್ಲರೂ ಕೆಲಸಕ್ಕೆ ಬಾರದವರಾಗಿದ್ದಾರೆ.</para>
  <para style="q1" vid="ROM 3:12">ಒಳ್ಳೆಯದನ್ನು ಮಾಡುವವನು ಇಲ್ಲ</para>
  <para style="q2" vid="ROM 3:12">ಒಬ್ಬನಾದರೂ ಇಲ್ಲ.”<note caller="+" style="f"><char style="fr" closed="false">3:12 </char><char style="ft" closed="false"><char style="xt"><ref loc="PSA 14:1-3">ಕೀರ್ತನೆ 14:1-3</ref>; <ref loc="PSA 53:1-3">53:1-3</ref>; <ref loc="ECC 7:20">ಪ್ರಸಂಗಿ 7:20</ref></char></char></note><verse eid="ROM 3:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="ROM 3:13"/>“ಅವರ ಗಂಟಲುಗಳು ತೆರೆದ ಸಮಾಧಿಗಳು.</para>
  <para style="q2" vid="ROM 3:13">ಅವರ ನಾಲಿಗೆಯು ವಂಚನೆಯನ್ನು ನುಡಿಯುತ್ತದೆ.”<note caller="+" style="f"><char style="fr" closed="false">3:13 </char><char style="ft" closed="false"><char style="xt"><ref loc="PSA 5:9">ಕೀರ್ತನೆ 5:9</ref></char></char></note></para>
  <para style="q1" vid="ROM 3:13">“ಅವರ ತುಟಿಗಳಲ್ಲಿ ಹಾವಿನ ವಿಷವಿದೆ.”<note caller="+" style="f"><char style="fr" closed="false">3:13 </char><char style="ft" closed="false"><char style="xt"><ref loc="PSA 140:3">ಕೀರ್ತನೆ 140:3</ref></char></char></note><verse eid="ROM 3:13"/></para>
  <para style="q2">
    <verse number="14" style="v" sid="ROM 3:14"/>“ಅವರ ಬಾಯಿ ಶಾಪದಿಂದಲೂ ಕಹಿಯಿಂದಲೂ ತುಂಬಿರುತ್ತವೆ.”<note caller="+" style="f"><char style="fr" closed="false">3:14 </char><char style="ft" closed="false"><char style="xt"><ref loc="PSA 10:7">ಕೀರ್ತನೆ 10:7</ref></char></char></note><verse eid="ROM 3:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="ROM 3:15"/>“ಅವರ ಕಾಲುಗಳು ರಕ್ತಪಾತಕ್ಕೆ ಆತುರಗೊಂಡಿವೆ.<verse eid="ROM 3:15"/></para>
  <para style="q2">
    <verse number="16" style="v" sid="ROM 3:16"/>ನಾಶ, ಸಂಕಟಗಳು ಅವರ ಮಾರ್ಗಗಳಲ್ಲಿ ಹಿಂಬಾಲಿಸುತ್ತವೆ.<verse eid="ROM 3:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="ROM 3:17"/>ಸಮಾಧಾನದ ಮಾರ್ಗವನ್ನೇ ಅವರು ಅರಿಯರು.”<note caller="+" style="f"><char style="fr" closed="false">3:17 </char><char style="ft" closed="false"><char style="xt"><ref loc="ISA 59:7">ಯೆಶಾಯ 59:7</ref>,<ref loc="ISA 59:8">8</ref></char></char></note><verse eid="ROM 3:17"/></para>
  <para style="q2">
    <verse number="18" style="v" sid="ROM 3:18"/>“ಅವರ ದೃಷ್ಟಿಯಲ್ಲಿ ದೇವರ ಭಯವೇ ಇಲ್ಲ.”<note caller="+" style="f"><char style="fr" closed="false">3:18 </char><char style="ft" closed="false"><char style="xt"><ref loc="PSA 36:1">ಕೀರ್ತನೆ 36:1</ref></char></char></note><verse eid="ROM 3:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="ROM 3:19"/>ನಿಯಮವು ಏನೇ ಹೇಳುವುದಾದರೂ ಅದು ನಿಯಮಕ್ಕೆ ಒಳಪಟ್ಟಿರುವವರಿಗೇ ಅನ್ವಯವಾಗುವುದೆಂದು ನಾವು ಬಲ್ಲೆವು. ಹೀಗೆ ಎಲ್ಲರ ಬಾಯಿ ಮುಚ್ಚಿಹೋಗುವುದು ಮತ್ತು ಲೋಕವೆಲ್ಲಾ ದೇವರ ತೀರ್ಪಿಗೆ ಒಳಗಾಗಿರುವುದು. <verse eid="ROM 3:19"/><verse number="20" style="v" sid="ROM 3:20"/>ಆದ್ದರಿಂದ ಯಾರೂ ದೇವರ ದೃಷ್ಟಿಯಲ್ಲಿ ನಿಯಮದ ಕೃತ್ಯಗಳಿಂದ ನೀತಿವಂತರೆಂದು ನಿರ್ಣಯಿಸಲಾಗುವುದಿಲ್ಲ. ನಿಯಮದಿಂದ ಪಾಪದ ಪ್ರಜ್ಞೆ ಉಂಟಾಗುತ್ತದಷ್ಟೆ.<verse eid="ROM 3:20"/></para>
  <para style="s1">ನಂಬಿಕೆಯ ಮೂಲಕ ನೀತಿವಂತರೆಂಬ ನಿರ್ಣಯ</para>
  <para style="p">
    <verse number="21" style="v" sid="ROM 3:21"/>ಆದರೆ ಈಗ ನಿಯಮವಿಲ್ಲದೆ ದೇವರ ನೀತಿಯು ಪ್ರಕಟವಾಗಿದೆ. ಅದಕ್ಕೆ ನಿಯಮವೂ ಪ್ರವಾದಿಗಳೂ ಸಾಕ್ಷಿಕೊಡುತ್ತಾರೆ. <verse eid="ROM 3:21"/><verse number="22" style="v" sid="ROM 3:22"/>ದೇವರ ನೀತಿಯು ನಂಬುವವರೆಲ್ಲರಿಗೆ ಕ್ರಿಸ್ತ ಯೇಸುವಿನಲ್ಲಿ ವಿಶ್ವಾಸವಿಡುವುದರ ಮೂಲಕ ಲಭಿಸುತ್ತದೆ. ಇಲ್ಲಿ ಯಾವ ಭೇದವೂ ಇರುವುದಿಲ್ಲ. <verse eid="ROM 3:22"/><verse number="23" style="v" sid="ROM 3:23"/>ಏಕೆಂದರೆ ಎಲ್ಲರೂ ಪಾಪಮಾಡಿ ದೇವರ ಮಹಿಮೆಯನ್ನು ಹೊಂದದೆ ಹೋಗಿದ್ದಾರೆ. <verse eid="ROM 3:23"/><verse number="24" style="v" sid="ROM 3:24"/>ಆದರೆ ಕ್ರಿಸ್ತ ಯೇಸುವಿನಲ್ಲಿ ಬಂದ ವಿಮೋಚನೆಯ ಮೂಲಕ ಅವರು ದೇವರ ಕೃಪೆಯಿಂದ ಉಚಿತವಾಗಿ ನೀತಿವಂತರೆಂದು ನಿರ್ಣಯ ಹೊಂದುತ್ತಾರೆ. <verse eid="ROM 3:24"/><verse number="25" style="v" sid="ROM 3:25"/>ಇದನ್ನು ನಂಬಿಕೆಯಿಂದ ಕ್ರಿಸ್ತ ಯೇಸುವಿನ ರಕ್ತದ ಮೂಲಕ ದೊರಕುವಂತೆ ದೇವರು ಕ್ರಿಸ್ತ ಯೇಸುವನ್ನು ನಮಗಾಗಿ ಪ್ರಾಯಶ್ಚಿತ್ತ ಬಲಿಯಾಗಿ<note caller="+" style="f"><char style="fr" closed="false">3:25 </char><char style="ft" closed="false"><char style="xt"><ref loc="LEV 16:15">ಯಾಜಕ 16:15</ref>,<ref loc="LEV 16:16">16</ref></char></char></note> ಒಪ್ಪಿಸಿದರು. ದೇವರು ಹಿಂದಿನ ಕಾಲದಲ್ಲಿ ಜನರು ಮಾಡಿರುವ ಪಾಪಗಳನ್ನು ದಂಡಿಸದೆ ತಮ್ಮ ನೀತಿಯನ್ನು ತೋರಿಸಿಕೊಡುವುದಕ್ಕಾಗಿಯೂ <verse eid="ROM 3:25"/><verse number="26" style="v" sid="ROM 3:26"/>ಈಗಿನ ಕಾಲದಲ್ಲಿ ದೇವರು ತಮ್ಮ ನೀತಿಯನ್ನು ತೋರ್ಪಡಿಸಲೂ ಯೇಸುವಿನಲ್ಲಿ ನಂಬಿಕೆಯಿಡುವವರನ್ನು ನೀತಿವಂತರೆಂದು ನಿರ್ಣಯಿಸುವುದಕ್ಕಾಗಿಯೂ ದೀರ್ಘಶಾಂತರಾಗಿದ್ದಾರೆ.<verse eid="ROM 3:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="ROM 3:27"/>ಹಾಗಾದರೆ, ನಾವು ಕೊಚ್ಚಿಕೊಳ್ಳುವುದಕ್ಕೆ ಆಸ್ಪದವೆಲ್ಲಿ? ಆಸ್ಪದವೇ ಇಲ್ಲ. ನೀತಿವಂತರೆಂಬ ನಿರ್ಣಯ ನಿಯಮದಿಂದಲೋ? ಕ್ರಿಯೆಗಳಿಂದಲೋ? ಇಲ್ಲ, ಅದು ಇಲ್ಲದೆ ಹೋಯಿತು. ಅದು ನಂಬಿಕೆಯ ನಿಯಮದಿಂದಲೇ. <verse eid="ROM 3:27"/><verse number="28" style="v" sid="ROM 3:28"/>ಏಕೆಂದರೆ ನಿಯಮವನ್ನು ಕೈಕೊಳ್ಳುವುದರಿಂದಲೇ. ನಂಬಿಕೆಯಿಂದಲೇ ಒಬ್ಬ ಮನುಷ್ಯನು ನೀತಿವಂತನೆಂದು ನಿರ್ಣಯ ಹೊಂದುತ್ತಾನೆಂದು ಎಣಿಸುತ್ತೇವೆ. <verse eid="ROM 3:28"/><verse number="29" style="v" sid="ROM 3:29"/>ದೇವರು ಯೆಹೂದ್ಯರಿಗೆ ಮಾತ್ರ ದೇವರೋ? ದೇವರು ಯೆಹೂದ್ಯರಲ್ಲದವರಿಗೂ ಸಹ ದೇವರಾಗಿರುವುದಿಲ್ಲವೋ? ಹೌದು, ಯೆಹೂದ್ಯರಲ್ಲದವರಿಗೂ ಸಹ ದೇವರಾಗಿದ್ದಾರೆ. <verse eid="ROM 3:29"/><verse number="30" style="v" sid="ROM 3:30"/>ಸುನ್ನತಿಯವರಿಗೂ ಸುನ್ನತಿಯಿಲ್ಲದವರಿಗೂ ಒಂದೇ ನಂಬಿಕೆಯ ಮೂಲಕ ನೀತಿವಂತರೆಂದು ನಿರ್ಣಯಿಸುವುದಕ್ಕೆ ಒಬ್ಬರೇ ದೇವರಿದ್ದಾರೆ. <verse eid="ROM 3:30"/><verse number="31" style="v" sid="ROM 3:31"/>ಹಾಗಾದರೆ, ನಾವು ನಂಬಿಕೆಯ ಮೂಲಕ ನೀತಿವಂತರೆಂದು ನಿರ್ಣಯಿಸುವುದಕ್ಕೆ ಒಬ್ಬರೇ ದೇವರಿದ್ದಾರೆ. ಹಾಗಾದರೆ, ನಾವು ನಂಬಿಕೆಯ ಮೂಲಕ ನಿಯಮವನ್ನು ನಿರರ್ಥಕಗೊಳಿಸುತ್ತೇವೋ? ಎಂದಿಗೂ ಇಲ್ಲ. ನಾವು ನಿಯಮವನ್ನು ಸ್ಥಿರಪಡಿಸುತ್ತೇವಷ್ಟೇ.<verse eid="ROM 3:31"/></para>
  <chapter eid="ROM 3"/>
  <chapter number="4" style="c" sid="ROM 4"/>
  <para style="s1">ಅಬ್ರಹಾಮನು ನಂಬಿಕೆಯಿಂದ ನೀತಿವಂತನೆಂದು ನಿರ್ಣಯಿಸಲಾದದ್ದು</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 4:1"/>ಹಾಗಾದರೆ ವಂಶಾನುಕ್ರಮವಾಗಿ ನಮ್ಮ ಮೂಲ ಪಿತೃವಾಗಿರುವ ಅಬ್ರಹಾಮನು, ಈ ವಿಷಯದಲ್ಲಿ ಏನು ಕಂಡುಕೊಂಡನೆಂದು ಹೇಳಬೇಕು? <verse eid="ROM 4:1"/><verse number="2" style="v" sid="ROM 4:2"/>ಅಬ್ರಹಾಮನು ಕ್ರಿಯೆಗಳ ಮೂಲಕ ನೀತಿವಂತನೆಂದು ನಿರ್ಣಯ ಹೊಂದಿದವನಾಗಿದ್ದರೆ, ದೇವರ ಮುಂದೆ ಹೊಗಳಿಸಿಕೊಳ್ಳಲು ಅವನಿಗೆ ಆಸ್ಪದ ಇರುವುದಿಲ್ಲ. <verse eid="ROM 4:2"/><verse number="3" style="v" sid="ROM 4:3"/>ಏಕೆಂದರೆ ಪವಿತ್ರ ವೇದವು: “ಅಬ್ರಹಾಮನು ದೇವರನ್ನು ನಂಬಿದನು, ಆ ನಂಬಿಕೆಯು ಅವನ ಲೆಕ್ಕಕ್ಕೆ ನೀತಿ ಎಂದು ಎಣಿಸಲಾಯಿತು,”<note caller="+" style="f"><char style="fr" closed="false">4:3 </char><char style="ft" closed="false"><char style="xt"><ref loc="GEN 15:6">ಆದಿ 15:6</ref></char></char></note> ಎಂದು ಹೇಳುತ್ತದೆ.<verse eid="ROM 4:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="ROM 4:4"/>ಕೆಲಸ ಮಾಡಿದವನಿಗೆ ದೊರೆಯುವ ಕೂಲಿಯು, ಉಚಿತ ದಾನವಲ್ಲ ಅದು ಅವನ ದುಡಿದ ಸಂಪಾದನೆ. <verse eid="ROM 4:4"/><verse number="5" style="v" sid="ROM 4:5"/>ಆದರೆ ಯಾರು ಕೃತ್ಯಗಳನ್ನು ಮಾಡದೆ, ಭಕ್ತಿಹೀನರನ್ನು ನೀತಿವಂತರೆಂದು ನಿರ್ಣಯಿಸುವ ದೇವರಲ್ಲಿ ನಂಬಿಕೆ ಇಡುತ್ತಾರೋ ಅವರ ನಂಬಿಕೆಯೇ ನೀತಿ ಎಂದು ಎಣಿಸಲಾಗುವುದು. <verse eid="ROM 4:5"/><verse number="6" style="v" sid="ROM 4:6"/>ದೇವರು ಯಾರನ್ನು ಕ್ರಿಯೆಗಳಿಲ್ಲದೆ ನೀತಿವಂತನೆಂದು ಎಣಿಸುತ್ತಾರೋ ಅವನೇ ಧನ್ಯನು. ಇದರ ಬಗ್ಗೆ ದಾವೀದನು ಹೀಗೆ ಹೇಳುತ್ತಾನೆ:<verse eid="ROM 4:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="ROM 4:7"/>“ಯಾರ ಅಪರಾಧಗಳು ಕ್ಷಮಿಸಲಾಗಿವೆಯೋ,</para>
  <para style="q2" vid="ROM 4:7">ಯಾರ ಪಾಪಗಳು ಮುಚ್ಚಲಾಗಿವೆಯೋ</para>
  <para style="q2" vid="ROM 4:7">ಅವರೇ ಧನ್ಯರು.<verse eid="ROM 4:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="ROM 4:8"/>ಯಾರ ಪಾಪಗಳನ್ನು ಕರ್ತನು ಅವರ ಲೆಕ್ಕಕ್ಕೆ ಎಣಿಸುವುದಿಲ್ಲವೋ,</para>
  <para style="q2" vid="ROM 4:8">ಆ ಮನುಷ್ಯನು ಧನ್ಯನು.”<note caller="+" style="f"><char style="fr" closed="false">4:8 </char><char style="ft" closed="false"><char style="xt"><ref loc="PSA 32:1">ಕೀರ್ತನೆ 32:1</ref>,<ref loc="PSA 32:2">2</ref></char></char></note><verse eid="ROM 4:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="ROM 4:9"/>ಈ ಧನ್ಯತೆಯು ಕೇವಲ ಸುನ್ನತಿಯಾದವರಿಗೆ ಮಾತ್ರವೋ? ಅಥವಾ ಸುನ್ನತಿಯಿಲ್ಲದವರಿಗೂ ಇರುತ್ತದೆಯೋ? ಅಬ್ರಹಾಮನ ಲೆಕ್ಕಕ್ಕೆ ಅವನ ನಂಬಿಕೆಯೇ ನೀತಿ ಎಂದು ಎಣಿಸಲಾಗಿತೆಂದು ಹೇಳುತ್ತೇವಲ್ಲಾ. <verse eid="ROM 4:9"/><verse number="10" style="v" sid="ROM 4:10"/>ಅದು ಯಾವಾಗ ಎಣಿಸಲಾಯಿತು? ಅವನಿಗೆ ಸುನ್ನತಿ ಆದ ಬಳಿಕವೋ? ಅಥವಾ ಸುನ್ನತಿಯಾಗುವುದಕ್ಕೆ ಮೊದಲೋ? ಅದು ನಂತರವಲ್ಲ, ಮೊದಲೇ! <verse eid="ROM 4:10"/><verse number="11" style="v" sid="ROM 4:11"/>ಹೌದು, ಸುನ್ನತಿಯಾಗುವ ಮೊದಲೇ ಅಬ್ರಹಾಮನಿಗಿದ್ದ ನಂಬಿಕೆಯಿಂದ ಅವನು ನೀತಿಯ ಮುದ್ರೆಯನ್ನು ಹೊಂದಿದನು. ಹೀಗಿರುವಲ್ಲಿ, ಸುನ್ನತಿಯಿಲ್ಲದೆ ನಂಬುವವರೆಲ್ಲರಿಗೂ ಅಬ್ರಹಾಮನು ತಂದೆಯಾಗಿರುತ್ತಾನೆ. ಹೀಗೆ ಅವರಿಗೆ ನೀತಿಯು ಎಣಿಕೆಯಾಗುವುದು. <verse eid="ROM 4:11"/><verse number="12" style="v" sid="ROM 4:12"/>ನಮ್ಮ ಪಿತೃವಾದ ಅಬ್ರಹಾಮನು ಸುನ್ನತಿ ಹೊಂದಿದವರಿಗೆ ಮಾತ್ರವೇ ತಂದೆಯಾಗಿರದೆ ಅವನಿಗೆ ಸುನ್ನತಿ ಆಗುವ ಮೊದಲು ಇದ್ದ ನಂಬಿಕೆಯ ಹೆಜ್ಜೆಯಲ್ಲಿ ನಡೆಯುವವರಿಗೂ ತಂದೆಯಾಗಿರುತ್ತಾನೆ.<verse eid="ROM 4:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="ROM 4:13"/>ಅಬ್ರಹಾಮನು ಮತ್ತು ಅವನ ಸಂತತಿಯವರು ಜಗತ್ತಿಗೇ ಹಕ್ಕುದಾರರಾಗುವರೆಂಬ ವಾಗ್ದಾನವು ನಿಯಮದಿಂದ ಆದದ್ದಲ್ಲ. ನಂಬಿಕೆಯಿಂದುಂಟಾದ ನೀತಿಯ ಮೂಲಕವೇ ಬರುವಂಥದ್ದಾಗಿದೆ. <verse eid="ROM 4:13"/><verse number="14" style="v" sid="ROM 4:14"/>ನಿಯಮಕ್ಕೆ ಒಳಗಾಗುವವರೇ ಬಾಧ್ಯರಾದರೆ, ನಂಬಿಕೆಗೆ ಬೆಲೆಯಿಲ್ಲದಂತಾಯಿತು. ವಾಗ್ದಾನವೂ ನಿರರ್ಥಕ. <verse eid="ROM 4:14"/><verse number="15" style="v" sid="ROM 4:15"/>ನಿಯಮವು ದೇವರ ಕೋಪವನ್ನು ತರುತ್ತದೆ. ಎಲ್ಲಿ ನಿಯಮವು ಇರುವುದಿಲ್ಲವೋ ಅಲ್ಲಿ ಅದರ ಉಲ್ಲಂಘನೆಯೂ ಇರುವುದಿಲ್ಲ.<verse eid="ROM 4:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="ROM 4:16"/>ಆದ್ದರಿಂದ ಆ ಬಾಧ್ಯತೆಯು ಕೃಪೆಯಿಂದಲೇ, ನಂಬಿಕೆಯ ಮೂಲಕ ದೊರಕುತ್ತದೆ. ಈ ವಾಗ್ದಾನವು ನಿಯಮದ ಸಂತತಿಯವರಿಗೆ ಮಾತ್ರವಲ್ಲ ಅಬ್ರಹಾಮನಲ್ಲಿ ಇದ್ದ ನಂಬಿಕೆ ಇರುವವರ ಸಂತತಿಯವರೆಲ್ಲರಿಗೂ ಶಾಶ್ವತವಾಗಿ ದೊರಕುವುದು. ಏಕೆಂದರೆ ಅವನು ನಮ್ಮೆಲ್ಲರಿಗೂ ತಂದೆಯಾಗಿದ್ದಾನೆ. <verse eid="ROM 4:16"/><verse number="17" style="v" sid="ROM 4:17"/>“ನಾನು ನಿನ್ನನ್ನು ಅನೇಕ ಜನಾಂಗಗಳಿಗೆ ಒಬ್ಬ ತಂದೆಯನ್ನಾಗಿ ನೇಮಿಸಿದ್ದೇನೆ,”<note caller="+" style="f"><char style="fr" closed="false">4:17 </char><char style="ft" closed="false"><char style="xt"><ref loc="GEN 17:5">ಆದಿ 17:5</ref></char></char></note> ಎಂದು ಪವಿತ್ರ ವೇದದಲ್ಲಿ ಲಿಖಿತವಾಗಿದೆ. ದೇವರು ಸತ್ತವರಿಗೆ ಜೀವಕೊಡುವವರೂ ಇಲ್ಲದವುಗಳನ್ನು ಇರುವವುಗಳೋ ಎಂಬಂತೆ ಕರೆಯುವವರೂ ಆಗಿರುತ್ತಾರೆಂದು ಅಬ್ರಹಾಮನು ದೇವರ ಸನ್ನಿಧಿಯಲ್ಲಿ ನಂಬಿದನು.<verse eid="ROM 4:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="ROM 4:18"/>ಅವನು ತನಗೆ ದೇವರಿಂದ ಹೇಳಲಾದ ನಿರೀಕ್ಷೆಗೆ ಯಾವ ಆಸ್ಪದವು ಇಲ್ಲದಿರುವಾಗಲೂ ನಿರೀಕ್ಷೆಯಿಂದ ನಂಬಿ, “ನಿನ್ನ ಸಂತಾನವು ನಕ್ಷತ್ರಗಳಷ್ಟು ಇರುವುದು,”<note caller="+" style="f"><char style="fr" closed="false">4:18 </char><char style="ft" closed="false"><char style="xt"><ref loc="GEN 15:5">ಆದಿ 15:5</ref></char></char></note> ಎಂಬ ಹೇಳಿಕೆಯಂತೆ ಅವನು ಅನೇಕ ಜನಾಂಗಗಳಿಗೆ ತಂದೆಯಾದನು. <verse eid="ROM 4:18"/><verse number="19" style="v" sid="ROM 4:19"/>ಅವನು ಆಗಲೇ ಸುಮಾರು ನೂರು ವರ್ಷದವನಾಗಿದ್ದು, ತನ್ನ ದೇಹವು ದುರ್ಬಲವಾಗಿದ್ದರೂ ಹೆಂಡತಿಯಾದ ಸಾರಳಿಗೆ ಗರ್ಭಧರಿಸುವ ಕಾಲ ಮುಗಿದು ಹೋಗಿದ್ದರೂ ನಂಬಿಕೆಯಲ್ಲಿ ಬಲಹೀನನಾಗಲಿಲ್ಲ. <verse eid="ROM 4:19"/><verse number="20" style="v" sid="ROM 4:20"/>ಅವನು ದೇವರು ಮಾಡಿದ ವಾಗ್ದಾನಕ್ಕೆ ವಿರುದ್ಧ ಅಪನಂಬಿಕೆಯಿಂದ ಚಂಚಲಚಿತ್ತನಾಗದೆ, ನಂಬಿಕೆಯಿಂದ ಶಕ್ತಿವಂತನಾಗಿ ದೇವರಿಗೆ ಮಹಿಮೆಯನ್ನು ಸಲ್ಲಿಸಿದನು. <verse eid="ROM 4:20"/><verse number="21" style="v" sid="ROM 4:21"/>ಅವನು ವಾಗ್ದಾನವನ್ನು ನೆರವೇರಿಸಲು ದೇವರು ಶಕ್ತರಾಗಿದ್ದಾರೆಂದು ಪೂರ್ಣ ದೃಢತೆಯುಳ್ಳವನಾದನು. <verse eid="ROM 4:21"/><verse number="22" style="v" sid="ROM 4:22"/>ಆದ್ದರಿಂದ, “ಅದು ಅವನ ಪಾಲಿಗೆ ನೀತಿ ಎಂಬುದಾಗಿ ಎಣಿಸಲಾಯಿತು.” <verse eid="ROM 4:22"/><verse number="23" style="v" sid="ROM 4:23"/>ಹೀಗೆ, “ಅವನ ಪಾಲಿಗೆ ನೀತಿ ಎಂದು ಎಣಿಸಲಾಯಿತು,” ಎಂದು ಬರೆದ ಮಾತು ಅವನಿಗೋಸ್ಕರ ಮಾತ್ರವೇ ಆಗಿರದೆ, <verse eid="ROM 4:23"/><verse number="24" style="v" sid="ROM 4:24"/>ನಮಗೋಸ್ಕರವೂ ಅಂದರೆ, ನಮ್ಮ ಕರ್ತ ಕ್ರಿಸ್ತ ಯೇಸುವನ್ನು ಸತ್ತವರೊಳಗಿಂದ ಎಬ್ಬಿಸಿರುವ ದೇವರನ್ನು ನಂಬುವ ನಮ್ಮ ಪಾಲಿಗೂ ನೀತಿಯೆಂದು ಎಣಿಸಲಾಗುವುದು. <verse eid="ROM 4:24"/><verse number="25" style="v" sid="ROM 4:25"/>ನಮ್ಮ ಪಾಪಗಳ ನಿಮಿತ್ತವಾಗಿ ಯೇಸುವನ್ನು ಮರಣಕ್ಕೆ ಒಪ್ಪಿಸಲಾಯಿತು ಮತ್ತು ನಮ್ಮನ್ನು ನೀತಿವಂತರನ್ನಾಗಿ ನಿರ್ಣಯಿಸಲು, ಜೀವದಿಂದ ಎಬ್ಬಿಸಲಾಯಿತು.<verse eid="ROM 4:25"/></para>
  <chapter eid="ROM 4"/>
  <chapter number="5" style="c" sid="ROM 5"/>
  <para style="s1">ಸಮಾಧಾನ ಮತ್ತು ನಿರೀಕ್ಷೆ</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 5:1"/>ಹೀಗಿರುವುದರಿಂದ, ವಿಶ್ವಾಸದ ಮೂಲಕ ನೀತಿವಂತರೆಂಬ ನಿರ್ಣಯ ಹೊಂದಿದ ನಮ್ಮ ಕರ್ತ ಆಗಿರುವ ಯೇಸುಕ್ರಿಸ್ತರ ಮೂಲಕ ನಮಗೆ ದೇವರೊಂದಿಗೆ ಸಮಾಧಾನವಿರುತ್ತದೆ. <verse eid="ROM 5:1"/><verse number="2" style="v" sid="ROM 5:2"/>ಯೇಸುವಿನ ಮೂಲಕವೇ ನಾವು ಈಗ ಈ ಕೃಪೆಯಲ್ಲಿ ವಿಶ್ವಾಸದಿಂದ ಪ್ರವೇಶಮಾಡಿದ್ದೇವೆ. ಈ ಕೃಪೆಯಲ್ಲಿಯೇ ಈಗ ನಿಂತಿದ್ದೇವೆ. ನಾವು ದೇವರ ಮಹಿಮೆಯಲ್ಲಿ ಪಾಲುಗೊಳ್ಳುತ್ತೆವೆಂಬ ನಿರೀಕ್ಷೆಯಲ್ಲಿ ಆನಂದಪಡುತ್ತೇವೆ. <verse eid="ROM 5:2"/><verse number="3" style="v" sid="ROM 5:3"/>ಅಷ್ಟು ಮಾತ್ರವೇ ಅಲ್ಲ, ನಮ್ಮ ಕಷ್ಟಸಂಕಟಗಳಲ್ಲಿಯೂ ಸಂತೋಷ ಪಡುವವರಾಗಿರುತ್ತೇವೆ. ಏಕೆಂದರೆ ಕಷ್ಟಸಂಕಟವು ತಾಳ್ಮೆಯನ್ನು ಉಂಟುಮಾಡುತ್ತದೆಂದೂ <verse eid="ROM 5:3"/><verse number="4" style="v" sid="ROM 5:4"/>ತಾಳ್ಮೆಯು ಸದ್ಗುಣವನ್ನೂ ಸದ್ಗುಣವು ನಿರೀಕ್ಷೆಯನ್ನೂ ಉಂಟು ಮಾಡುತ್ತದೆಂದು ಬಲ್ಲೆವು. <verse eid="ROM 5:4"/><verse number="5" style="v" sid="ROM 5:5"/>ಈ ನಿರೀಕ್ಷೆಯು ನಮ್ಮನ್ನು ನಿರಾಶೆ ಪಡಿಸುವುದಿಲ್ಲ. ಏಕೆಂದರೆ ದೇವರು ನಮಗೆ ಅನುಗ್ರಹಿಸಿರುವ ಪವಿತ್ರಾತ್ಮ ಮೂಲಕ ನಮ್ಮ ಹೃದಯಗಳಲ್ಲಿ ತಮ್ಮ ಪ್ರೀತಿಯನ್ನು ಧಾರಾಳವಾಗಿ ಸುರಿಸಿದ್ದಾರೆ.<verse eid="ROM 5:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="ROM 5:6"/>ನಾವು ಇನ್ನೂ ಬಲಹೀನರಾಗಿದ್ದಾಗಲೇ, ಸೂಕ್ತ ಸಮಯದಲ್ಲಿ ಕ್ರಿಸ್ತ ಯೇಸು ಭಕ್ತಿಹೀನರಿಗೋಸ್ಕರ ಪ್ರಾಣಕೊಟ್ಟರು. <verse eid="ROM 5:6"/><verse number="7" style="v" sid="ROM 5:7"/>ನೀತಿವಂತನಿಗೋಸ್ಕರ ಯಾರಾದರೂ ಪ್ರಾಣಕೊಡುವುದು ಅಪರೂಪ. ಒಬ್ಬ ಸತ್ಪುರುಷನಿಗಾಗಿ ಯಾರಾದರೂ ಪ್ರಾಣಕೊಡುವುದಕ್ಕೆ ಧೈರ್ಯ ಮಾಡಬಹುದು. <verse eid="ROM 5:7"/><verse number="8" style="v" sid="ROM 5:8"/>ಆದರೆ ಕ್ರಿಸ್ತ ಯೇಸು ನಾವು ಇನ್ನೂ ಪಾಪಿಗಳಾಗಿದ್ದಾಗಲೇ ನಮಗೋಸ್ಕರ ಪ್ರಾಣ ಕೊಟ್ಟದ್ದರಲ್ಲಿ ದೇವರು ನಮ್ಮ ಮೇಲೆ ಇಟ್ಟಿರುವ ತಮ್ಮ ಪ್ರೀತಿಯನ್ನು ತೋರಿಸಿದ್ದಾರೆ.<verse eid="ROM 5:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="ROM 5:9"/>ಈಗ ನಾವು ಕ್ರಿಸ್ತ ಯೇಸುವಿನ ರಕ್ತದಿಂದ ನೀತಿವಂತರೆಂದು ನಿರ್ಣಯ ಹೊಂದಿರುವುದರಿಂದ, ಕ್ರಿಸ್ತ ಯೇಸುವಿನ ಮೂಲಕವಾಗಿಯೇ ದೇವರ ಕೋಪದಿಂದ ರಕ್ಷಿಸಲಾಗುವುದು ಇನ್ನೂ ಖಂಡಿತವಲ್ಲವೆ? <verse eid="ROM 5:9"/><verse number="10" style="v" sid="ROM 5:10"/>ನಾವು ದೇವರ ಶತ್ರುಗಳಾಗಿದ್ದಾಗಲೇ ಅವರು ನಮ್ಮನ್ನು ತಮ್ಮ ಪುತ್ರನ ಮರಣದ ಮೂಲಕ ಸಂಧಾನ ಮಾಡಿಕೊಂಡಿರುವುದಾದರೆ, ಕ್ರಿಸ್ತ ಯೇಸುವಿನ ಜೀವದ ಮೂಲಕ ಎಷ್ಟೋ ಹೆಚ್ಚಾಗಿ ನಾವು ರಕ್ಷಿಸುವುದು ಇನ್ನೂ ಖಚಿತವಲ್ಲವೆ? <verse eid="ROM 5:10"/><verse number="11" style="v" sid="ROM 5:11"/>ಇಷ್ಟು ಮಾತ್ರವೇ ಅಲ್ಲ, ಈಗ ನಮ್ಮ ಕರ್ತ ಆಗಿರುವ ಯೇಸುಕ್ರಿಸ್ತರ ಮೂಲಕ ನಾವು ದೇವರೊಂದಿಗೆ ಮಿತ್ರರಾಗಿ, ಯೇಸುವಿನ ಮೂಲಕವೇ ದೇವರಲ್ಲಿ ಉಲ್ಲಾಸ ಪಡುತ್ತೇವೆ.<verse eid="ROM 5:11"/></para>
  <para style="s1">ಆದಾಮನ ಮೂಲಕ ಮರಣ, ಕ್ರಿಸ್ತ ಯೇಸುವಿನ ಮೂಲಕ ಜೀವ</para>
  <para style="p">
    <verse number="12" style="v" sid="ROM 5:12"/>ಆದ್ದರಿಂದ, ಒಬ್ಬ ಮನುಷ್ಯನ ಮೂಲಕ ಪಾಪವೂ ಪಾಪದ ಮೂಲಕ ಮರಣವೂ ಲೋಕದೊಳಗೆ ಪ್ರವೇಶಿಸಿದ ಹಾಗೆಯೇ ಎಲ್ಲರೂ ಪಾಪಮಾಡಿದ್ದರಿಂದ ಮರಣವು ಎಲ್ಲರಲ್ಲಿಯೂ ವ್ಯಾಪಿಸಿತು.<verse eid="ROM 5:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="ROM 5:13"/>ನಿಯಮವು ಕೊಡುವುದಕ್ಕೆ ಮೊದಲೇ ಪಾಪವು ಲೋಕದಲ್ಲಿ ಇತ್ತು. ಆದರೆ ನಿಯಮವು ಇಲ್ಲದಿದ್ದಾಗ ಪಾಪವು ಲೆಕ್ಕಕ್ಕೆ ಬರುವುದಿಲ್ಲ. <verse eid="ROM 5:13"/><verse number="14" style="v" sid="ROM 5:14"/>ಆದರೂ ಮರಣವು ಆದಾಮನಿಂದ ಮೋಶೆಯವರೆಗೂ ದೊರೆತನ ಮಾಡುತ್ತಿತ್ತು. ಆದಾಮನು ಮಾಡಿದ ಅಪರಾಧಕ್ಕೆ ಸಮಾನವಾಗಿ ಪಾಪಮಾಡಿದವರ ಮೇಲೆಯೂ ಅದು ದೊರೆತನ ಮಾಡುತ್ತಿತ್ತು. ಆದಾಮನು ಮುಂದೆ ಬರಲಿಕ್ಕಿದ್ದ ಒಬ್ಬಾತನಿಗೆ ಸಂಕೇತವಾಗಿದ್ದಾನೆ.<verse eid="ROM 5:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="ROM 5:15"/>ಆದರೆ ಆ ಅಪರಾಧಕ್ಕೂ ದೇವರ ವರಕ್ಕೂ ಬಹಳ ವ್ಯತ್ಯಾಸವಿದೆ. ಹೇಗೆಂದರೆ, ಆದಾಮನ ಅಪರಾಧದಿಂದ ಎಲ್ಲ ಮನುಷ್ಯರೂ ಸತ್ತರು. ಕ್ರಿಸ್ತ ಯೇಸುವೆಂಬ ಈ ಒಬ್ಬ ಮನುಷ್ಯನ ಕೃಪೆಯಿಂದ ಸಿಕ್ಕುವ ದೇವರ ಕೃಪೆಯ ವರವು ಅನೇಕರಿಗೆ ಇನ್ನೂ ಹೆಚ್ಚಾಗಿ ಸಿಕ್ಕುವುದು ನಿಶ್ಚಯವಲ್ಲವೇ? <verse eid="ROM 5:15"/><verse number="16" style="v" sid="ROM 5:16"/>ಇದಲ್ಲದೆ ಪಾಪಮಾಡಿದ ಒಬ್ಬನಿಂದಲೇ ದುಷ್ಪಲ ಬಂದಂತೆ ಈ ವರವು ಬರಲಿಲ್ಲ. ಹೇಗೆಂದರೆ, ಒಬ್ಬನೇ ಮನುಷ್ಯನ ಪಾಪದ ದೆಸೆಯಿಂದ ಸಾಯಬೇಕೆಂಬ ದಂಡನಾತೀರ್ಪು ಉಂಟಾಯಿತು. ಆದರೆ ದೇವರ ಕೃಪೆಯು ಅನೇಕರ ಅಪರಾಧಗಳಿಂದ ಅವರನ್ನು ನೀತಿವಂತರೆಂದು ನಿರ್ಣಯಿಸುವುದಾಗಿದೆ. <verse eid="ROM 5:16"/><verse number="17" style="v" sid="ROM 5:17"/>ಒಬ್ಬ ಮನುಷ್ಯನು ಮಾಡಿದ ಅಪರಾಧದಿಂದ ಮರಣವು ಉಂಟಾಗಿ ಆ ಒಬ್ಬನ ಮುಖಾಂತರ ಮರಣವು ಆಳುವುದಾದರೆ, ದೇವರ ಧಾರಾಳವಾದ ಕೃಪೆಯನ್ನೂ ನೀತಿಯ ವರವನ್ನೂ ಹೊಂದಿದವರಾಗಿ ಕ್ರಿಸ್ತ ಯೇಸುವೆಂಬ ಒಬ್ಬಾತನ ಮೂಲಕ ಜೀವದಲ್ಲಿ ಆಳುವುದು ಇನ್ನೂ ಹೆಚ್ಚಾದದ್ದಲ್ಲವೆ!<verse eid="ROM 5:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="ROM 5:18"/>ಹೀಗೆ, ಒಂದು ಅಪರಾಧದ ನಿಮಿತ್ತ ಎಲ್ಲಾ ಜನರ ಮೇಲೆ ದಂಡನಾತೀರ್ಪು ಬಂದಂತೆಯೇ ಒಂದು ನೀತಿಯ ಕೃತ್ಯದಿಂದ ಎಲ್ಲಾ ಜನರಿಗೂ ಜೀವವನ್ನುಂಟು ಮಾಡುವ ನೀತಿಕರಣವು ಉಂಟಾಯಿತು. <verse eid="ROM 5:18"/><verse number="19" style="v" sid="ROM 5:19"/>ಒಬ್ಬ ಮನುಷ್ಯನ ಅವಿಧೇಯತೆಯಿಂದಾಗಿ ಅನೇಕರು, ಪಾಪಿಗಳು ಆದಂತೆಯೇ ಒಬ್ಬ ಮನುಷ್ಯನ ವಿಧೇಯತೆಯಿಂದಾಗಿ ಅನೇಕರು ನೀತಿವಂತರಾಗುವರು.<verse eid="ROM 5:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="ROM 5:20"/>ಅಪರಾಧವು ಹೆಚ್ಚುವಂತೆ ನಿಯಮವು ಪ್ರವೇಶಿಸಿತು. ಆದರೆ ಪಾಪವು ಹೆಚ್ಚಾದಾಗ, ಕೃಪೆಯು ಇನ್ನೂ ಹೆಚ್ಚಾಯಿತು. <verse eid="ROM 5:20"/><verse number="21" style="v" sid="ROM 5:21"/>ಹೀಗೆ ಪಾಪವು ಮರಣದ ಮೂಲಕ ಆಳಿದಂತೆಯೇ ನಮ್ಮ ಕರ್ತ ಆಗಿರುವ ಯೇಸುಕ್ರಿಸ್ತರ ಮೂಲಕ ನಿತ್ಯಜೀವವನ್ನುಂಟು ಮಾಡಲು ಕೃಪೆಯು ನೀತಿಯ ಮೂಲಕ ಆಳುವುದು.<verse eid="ROM 5:21"/></para>
  <chapter eid="ROM 5"/>
  <chapter number="6" style="c" sid="ROM 6"/>
  <para style="s1">ಪಾಪಕ್ಕೆ ಸತ್ತು ಕ್ರಿಸ್ತ ಯೇಸುವಿನಲ್ಲಿ ಜೀವಂತನಾಗಿರುವುದು</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 6:1"/>ಹಾಗಾದರೆ ನಾವು ಏನು ಹೇಳೋಣ? ಕೃಪೆಯು ಹೆಚ್ಚಾಗಲಿ ಎಂದು ನಾವು ಪಾಪದಲ್ಲಿ ಮುಂದುವರಿಯೋಣವೆ? <verse eid="ROM 6:1"/><verse number="2" style="v" sid="ROM 6:2"/>ಎಂದಿಗೂ ಹಾಗಾಗದಿರಲಿ! ನಾವು ಪಾಪದ ಪಾಲಿಗೆ ಸತ್ತೆವು, ನಾವು ಇನ್ನೂ ಪಾಪದಲ್ಲಿ ಜೀವಿಸುವುದು ಹೇಗೆ? <verse eid="ROM 6:2"/><verse number="3" style="v" sid="ROM 6:3"/>ಅಥವಾ ಕ್ರಿಸ್ತ ಯೇಸುವಿನಲ್ಲಿ ದೀಕ್ಷಾಸ್ನಾನ ಪಡೆದುಕೊಂಡಿರುವ ನಾವು ಅವರ ಮರಣದಲ್ಲಿ ದೀಕ್ಷಾಸ್ನಾನ ಪಡೆದುಕೊಂಡಿರುತ್ತೇವೆಂಬುದು ನಿಮಗೆ ತಿಳಿಯದೋ? <verse eid="ROM 6:3"/><verse number="4" style="v" sid="ROM 6:4"/>ಹೀಗಿರುವಲ್ಲಿ ಯೇಸುವಿರೊಂದಿಗೆ ದೀಕ್ಷಾಸ್ನಾನದ ಮೂಲಕ ಅವರ ಮರಣದಲ್ಲಿ ಹೂಣಲಾದೆವು. ಆದ್ದರಿಂದ ತಂದೆಯ ಮಹಿಮೆಯ ಮೂಲಕ ಕ್ರಿಸ್ತ ಯೇಸು ಸತ್ತವರೊಳಗಿಂದ ಎಬ್ಬಿಸಲಾದಂತೆಯೇ ನಾವು ಹೊಸ ಜೀವವನ್ನು ಜೀವಿಸಬೇಕು.<verse eid="ROM 6:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="ROM 6:5"/>ನಾವು ಕ್ರಿಸ್ತ ಯೇಸುವಿನೊಂದಿಗೆ ಸೇರಿ ಅವರ ಮರಣದಲ್ಲಿ ಪಾಲುಗಾರರಾದರೆ, ಅವರ ಪುನರುತ್ಥಾನದಲ್ಲಿಯೂ ಪಾಲುಗಾರರಾಗುವೆವು. <verse eid="ROM 6:5"/><verse number="6" style="v" sid="ROM 6:6"/>ನಮ್ಮ ಪಾಪದ ಶರೀರವು ನಾಶವಾಗಿ ನಾವು ಇನ್ನು ಮುಂದೆ ಎಂದಿಗೂ ಪಾಪಕ್ಕೆ ಗುಲಾಮರಾಗದಂತೆ, ನಮ್ಮ ಹಳೆಯ ಮನುಷ್ಯ ಸ್ವಭಾವ ಯೇಸುವಿನೊಂದಿಗೆ ಶಿಲುಬೆಗೆ ಹಾಕಲಾಯಿತು ಎಂದು ನಾವು ಬಲ್ಲೆವು. <verse eid="ROM 6:6"/><verse number="7" style="v" sid="ROM 6:7"/>ಮರಣ ಹೊಂದಿರುವ ಯಾರೇ ಆದರೂ ಪಾಪದಿಂದ ಮುಕ್ತರಾಗಿರುತ್ತಾರೆ.<verse eid="ROM 6:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="ROM 6:8"/>ನಾವು ಈಗ ಕ್ರಿಸ್ತ ಯೇಸುವಿನೊಂದಿಗೆ ಸತ್ತಿರುವುದಾದರೆ, ಅವರೊಂದಿಗೆ ಬದುಕುವೆವು ಎಂದು ನಂಬುತ್ತೇವೆ. <verse eid="ROM 6:8"/><verse number="9" style="v" sid="ROM 6:9"/>ಕ್ರಿಸ್ತ ಯೇಸು ಮರಣದಿಂದ ಜೀವಿತರಾಗಿ ಎದ್ದು ಬಂದದ್ದರಿಂದ ಅವರು ಪುನಃ ಸಾಯಲಾರರೆಂದು ಬಲ್ಲೆವು. ಇನ್ನು ಮುಂದೆ ಅವರ ಮೇಲೆ ಮರಣಕ್ಕೆ ಅಧಿಕಾರವಿಲ್ಲ. <verse eid="ROM 6:9"/><verse number="10" style="v" sid="ROM 6:10"/>ಕ್ರಿಸ್ತ ಯೇಸು ಪಾಪದ ಪಾಲಿಗೆ ಸತ್ತದ್ದೂ ಒಂದೇ ಸಾರಿಯಾಗಿರುತ್ತದೆ. ಆದರೆ, ಅವರು ಜೀವಿಸುವ ಜೀವಿತವು ದೇವರಿಗಾಗಿಯೇ.<verse eid="ROM 6:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="ROM 6:11"/>ಅದೇ ರೀತಿಯಲ್ಲಿ, ನೀವೂ ಸಹ ಪಾಪದ ಪಾಲಿಗೆ ಸತ್ತವರೆಂದೂ ಕ್ರಿಸ್ತ ಯೇಸುವಿನಲ್ಲಿ ದೇವರಿಗಾಗಿ ಜೀವಿಸುವವರೆಂದೂ ಎಣಿಸಿಕೊಳ್ಳಿರಿ. <verse eid="ROM 6:11"/><verse number="12" style="v" sid="ROM 6:12"/>ಆದ್ದರಿಂದ ನೀವು ದೇಹದ ಆಶೆಗಳಿಗೆ ಒಳಗಾಗದಂತೆ ನಿಮ್ಮ ನಶ್ವರ ದೇಹಗಳಲ್ಲಿ ಪಾಪವು ಅಧಿಕಾರ ನಡೆಸಲು ಬಿಡಬೇಡಿರಿ. <verse eid="ROM 6:12"/><verse number="13" style="v" sid="ROM 6:13"/>ನಿಮ್ಮ ದೇಹದ ಅವಯವಗಳನ್ನು ಅನೀತಿಯನ್ನು ನಡೆಸುವ ಸಾಧನಗಳಾಗುವಂತೆ ಪಾಪಕ್ಕೆ ಒಪ್ಪಿಸಬೇಡಿರಿ. ಆದರೆ ಅದರ ಬದಲಾಗಿ ಮರಣದಿಂದ ಜೀವಕ್ಕೆ ಬಂದವರಂತೆ ನಿಮ್ಮನ್ನು ದೇವರಿಗೆ ಸಮರ್ಪಿಸಿಕೊಳ್ಳಿರಿ. ನಿಮ್ಮ ದೇಹದ ಅವಯವಗಳನ್ನು ನೀತಿಯ ಸಾಧನಗಳಾಗಿರುವುದಕ್ಕಾಗಿ ದೇವರಿಗೆ ಸಮರ್ಪಿಸಿರಿ. <verse eid="ROM 6:13"/><verse number="14" style="v" sid="ROM 6:14"/>ಪಾಪವು ನಿಮ್ಮ ಮೇಲೆ ಅಧಿಕಾರ ನಡೆಸದು; ಏಕೆಂದರೆ ನೀವು ನಿಯಮಕ್ಕೆ ಅಧೀನರಲ್ಲ, ಕೃಪೆಗೆ ಅಧೀನರಾಗಿದ್ದೀರಿ.<verse eid="ROM 6:14"/></para>
  <para style="s1">ನೀತಿಗೆ ಗುಲಾಮರು</para>
  <para style="p">
    <verse number="15" style="v" sid="ROM 6:15"/>ಹಾಗಾದರೆ ಏನು? ನಾವು ನಿಯಮಕ್ಕೆ ಅಧೀನರಾಗಿರದೆ ಕೃಪೆಗೆ ಅಧೀನರಾಗಿರುತ್ತೇವೆಂದು ಪಾಪ ಮಾಡಬಹುದೋ? ಎಂದಿಗೂ ಇಲ್ಲ! <verse eid="ROM 6:15"/><verse number="16" style="v" sid="ROM 6:16"/>ನೀವು ಯಾರಾದರೊಬ್ಬರಿಗೆ ವಿಧೇಯರಾಗಿರುವುದಕ್ಕಾಗಿ ಗುಲಾಮರಾಗಿ ನಿಮ್ಮನ್ನು ಒಪ್ಪಿಸಿಕೊಟ್ಟಾಗ, ನೀವು ಅವನಿಗೆ ವಿಧೇಯರಾದ ಗುಲಾಮರಾಗುತ್ತೀರಿ ಎಂಬುದು ನಿಮಗೆ ತಿಳಿಯದೋ? ಮರಣಕ್ಕೆ ನಡೆಸುವ ಪಾಪಕ್ಕೆ ನೀವು ಗುಲಾಮರಾಗಿರಬಹುದು ಇಲ್ಲವೆ ನೀತಿಗೆ ನಡೆಸುವ ವಿಧೇಯತೆಗೆ ಒಳಪಟ್ಟಿರಬಹುದು. <verse eid="ROM 6:16"/><verse number="17" style="v" sid="ROM 6:17"/>ಆದರೆ ನೀವು ಪಾಪಕ್ಕೆ ಗುಲಾಮರಾಗಿದ್ದರೂ ನಿಮಗೆ ಒಪ್ಪಿಸಿದ ಬೋಧನೆಗೆ ಹೃದಯದಿಂದ ವಿಧೇಯರಾದುದ್ದಕ್ಕಾಗಿ, ದೇವರಿಗೆ ಸ್ತೋತ್ರವಾಗಲಿ. <verse eid="ROM 6:17"/><verse number="18" style="v" sid="ROM 6:18"/>ಪಾಪದಿಂದ ಬಿಡುಗಡೆಹೊಂದಿ ನೀತಿಗೆ ಗುಲಾಮರಾಗಿದ್ದೀರಿ.<verse eid="ROM 6:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="ROM 6:19"/>ನೀವು ಶರೀರಭಾವದಲ್ಲಿ ಬಲಹೀನರಾಗಿರುವುದರಿಂದ ನಾನು ಮಾನವ ಮಾತುಗಳಲ್ಲಿ ಇದನ್ನು ಹೇಳುತ್ತಿದ್ದೇನೆ. ನಿಮ್ಮ ದೇಹದ ಅವಯವಗಳನ್ನು ಅಶುದ್ಧತೆಗೂ ಅಧರ್ಮಕ್ಕೂ ದಾಸತ್ವದಲ್ಲಿ ಒಪ್ಪಿಸಿ ಕೊಡುತ್ತಿದ್ದಂತೆಯೇ ನೀವು ಈಗ ಅವುಗಳನ್ನು ಪರಿಶುದ್ಧತೆಗೆ ನಡೆಸುವ ನೀತಿಗೆ ಗುಲಾಮರಾಗಿ ಒಪ್ಪಿಸಿರಿ. <verse eid="ROM 6:19"/><verse number="20" style="v" sid="ROM 6:20"/>ನೀವು ಪಾಪಕ್ಕೆ ಗುಲಾಮರಾಗಿದ್ದಾಗ ನೀತಿಗೆ ಅಧೀನರಾಗಿರಲಿಲ್ಲ. <verse eid="ROM 6:20"/><verse number="21" style="v" sid="ROM 6:21"/>ಆದ್ದರಿಂದ ಈಗ ನೀವು ನಾಚಿಕೆ ಪಟ್ಟುಕೊಳ್ಳುತ್ತಿರುವ ಸಂಗತಿಗಳಿಂದ ನಿಮಗಾದ ಲಾಭವೇನು? ಅವು ಮರಣದಲ್ಲಿ ಸಮಾಪ್ತವಾಗುತ್ತವೆ! <verse eid="ROM 6:21"/><verse number="22" style="v" sid="ROM 6:22"/>ಆದರೆ ಈಗ ನೀವು ಪಾಪದಿಂದ ಬಿಡುಗಡೆ ಹೊಂದಿದವರಾಗಿ ದೇವರಿಗೆ ಗುಲಾಮರಾಗಿರುವುದರಿಂದ, ಪವಿತ್ರವಾಗಿರುವುದೇ ನಿಮಗೆ ದೊರಕುವ ಫಲವು. ಕಡೆಗೆ ದೊರೆಯುವಂಥದು ನಿತ್ಯಜೀವವಾಗಿರುತ್ತದೆ. <verse eid="ROM 6:22"/><verse number="23" style="v" sid="ROM 6:23"/>ಏಕೆಂದರೆ ಪಾಪವು ಕೊಡುವ ಸಂಬಳ ಮರಣ, ದೇವರ ಉಚಿತ ವರವಾದರೋ ನಮಗೆ ಕರ್ತ ಆಗಿರುವ ಕ್ರಿಸ್ತ ಯೇಸುವಿನಲ್ಲಿ ಇರುವ ನಿತ್ಯಜೀವ.<verse eid="ROM 6:23"/></para>
  <chapter eid="ROM 6"/>
  <chapter number="7" style="c" sid="ROM 7"/>
  <para style="s1">ಕ್ರಿಸ್ತ ಯೇಸುವಿನವರು ನಿಯಮಕ್ಕೆ ಅಧೀನರಲ್ಲ</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 7:1"/>ಪ್ರಿಯರೇ, ನಿಯಮವನ್ನು ತಿಳಿದವರಿಗೆ ನಾನು ಹೇಳುವುದೇನೆಂದರೆ, ಒಬ್ಬ ಮನುಷ್ಯನು ಜೀವದಿಂದಿರುವ ತನಕ ಮಾತ್ರ ನಿಯಮಕ್ಕೆ ಅವನ ಮೇಲೆ ಅಧಿಕಾರ ಇರುತ್ತದೆಂದು ನೀವು ಬಲ್ಲಿರಿ. <verse eid="ROM 7:1"/><verse number="2" style="v" sid="ROM 7:2"/>ಒಬ್ಬ ಮದುವೆಯಾದ ಹೆಣ್ಣು ಮಗಳು ಕಾನೂನಿಗನುಸಾರವಾಗಿ ಅವಳ ಪತಿಯು ಜೀವದಿಂದಿರುವ ತನಕ ಮಾತ್ರ ಅವನಿಗೆ ಬದ್ಧಳಾಗಿರುತ್ತಾಳೆ. ಆದರೆ ಪತಿಯು ಸತ್ತರೆ ಆಕೆಯು ಮದುವೆಯ ಕಾನೂನಿನಿಂದ ಬಿಡುಗಡೆ ಹೊಂದಿದವಳಾಗಿರುತ್ತಾಳೆ. <verse eid="ROM 7:2"/><verse number="3" style="v" sid="ROM 7:3"/>ಹೀಗಿರುವಾಗ, ಅವಳ ಪತಿಯು ಜೀವಂತನಾಗಿರುವಾಗ ಆಕೆಯು ಇನ್ನೊಬ್ಬನನ್ನು ಮದುವೆಯಾದರೆ ವ್ಯಭಿಚಾರಿಣಿ ಎಂದು ಎನಿಸಿಕೊಳ್ಳುವಳು. ಆದರೆ ಪತಿಯು ಸತ್ತರೆ, ಆಕೆಯು ಬೇರೊಬ್ಬನನ್ನು ಮದುವೆಯಾದರೂ ಆ ಕಾನೂನಿನಿಂದ ಅವಳು ಬಿಡುಗಡೆ ಆಗಿರಲಾಗಿ ವ್ಯಭಿಚಾರಿಣಿ ಎಂದು ಎನಿಸಿಕೊಳ್ಳುವುದಿಲ್ಲ.<verse eid="ROM 7:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="ROM 7:4"/>ಆದ್ದರಿಂದ, ನನ್ನ ಪ್ರಿಯರೇ, ನೀವು ದೇವರಿಗೆ ಫಲಕೊಡುವವರಾಗಬೇಕೆಂದು ಸತ್ತವರೊಳಗಿಂದ ಎದ್ದುಬಂದಾತನಿಗೆ ಸೇರಿದವರಾಗಲು ಕ್ರಿಸ್ತ ಯೇಸುವಿನ ದೇಹದ ಮೂಲಕ ನಿಯಮದ ಪಾಲಿಗೆ ಸತ್ತಿರಿ. <verse eid="ROM 7:4"/><verse number="5" style="v" sid="ROM 7:5"/>ಮಾಂಸಭಾವಕ್ಕನುಸಾರವಾಗಿ ನಾವು ಜೀವಿಸುತ್ತಿದ್ದಾಗ, ನಿಯಮದಿಂದ ಉತ್ತೇಜನಗೊಂಡ ಪಾಪದ ದುರಾಶೆಗಳು ನಮ್ಮ ದೇಹದಲ್ಲಿ ಕಾರ್ಯ ನಡೆಸುತ್ತಿದ್ದವು. ಆದ್ದರಿಂದ ನಾವು ಮರಣಕ್ಕೆ ಫಲಗಳನ್ನು ಹುಟ್ಟಿಸುತ್ತಿದ್ದೆವು. <verse eid="ROM 7:5"/><verse number="6" style="v" sid="ROM 7:6"/>ಈಗಲಾದರೋ ಒಂದು ಕಾಲದಲ್ಲಿ ನಮ್ಮನ್ನು ಯಾವುದು ಬಂಧನದಲ್ಲಿರಿಸಿತ್ತೋ ಅದಕ್ಕೆ ಸತ್ತವರಾಗಿದ್ದು ನಿಯಮದಿಂದ ಬಿಡುಗಡೆ ಹೊಂದಿದವರಾಗಿರುತ್ತೇವೆ. ಹೀಗೆ ನಾವು ಲಿಖಿತವಾದ ಹಳೆಯ ನಿಯಮದಂತೆ ನಡೆಯದೆ ಆತ್ಮದಿಂದ ನವಜೀವನದಲ್ಲಿ ನಡೆಯುವರಾಗಿದ್ದೇವೆ.<verse eid="ROM 7:6"/></para>
  <para style="s1">ನಿಯಮವೂ ಪಾಪವೂ</para>
  <para style="p">
    <verse number="7" style="v" sid="ROM 7:7"/>ಹಾಗಾದರೆ ನಾವು ಏನು ಹೇಳೋಣ? ನಿಯಮವೇ ಪಾಪವಾಗಿದೆಯೋ? ಎಂದಿಗೂ ಇಲ್ಲ. ಆದರೂ ನಿಯಮವನ್ನು ಬಿಟ್ಟು ಬೇರಾವುದರ ಮೂಲಕವೂ ಪಾಪವೆಂದರೆ ಏನೆಂದು ನನಗೆ ತಿಳಿದುಕೊಳ್ಳಲು ಸಾಧ್ಯವಿರಲಿಲ್ಲ. ನಿಯಮವು, “ದುರಾಶೆ ಪಡಬೇಡ,”<note caller="+" style="f"><char style="fr" closed="false">7:7 </char><char style="ft" closed="false"><char style="xt"><ref loc="EXO 20:17">ವಿಮೋ 20:17</ref>; <ref loc="DEU 5:21">ಧರ್ಮೋ 5:21</ref></char></char></note> ಎಂದು ಹೇಳದೆ ಇರುತ್ತಿದ್ದರೆ ದುರಾಶೆ ಎಂದರೆ ಏನೆಂದು ನಾನು ತಿಳಿಯಲು ಸಾಧ್ಯವಿರಲಿಲ್ಲ. <verse eid="ROM 7:7"/><verse number="8" style="v" sid="ROM 7:8"/>ಆದರೆ ಪಾಪವು, ಆ ಆಜ್ಞೆಯಿಂದ ಅನುಕೂಲ ಹೊಂದಿ ನನ್ನಲ್ಲಿ ಎಲ್ಲಾ ವಿಧದ ಆಶೆಗಳನ್ನು ಉಂಟುಮಾಡಿತು. ಏಕೆಂದರೆ ನಿಯಮವಿಲ್ಲದೆ ಪಾಪವು ಸತ್ತದ್ದಾಗಿರುತ್ತದೆ. <verse eid="ROM 7:8"/><verse number="9" style="v" sid="ROM 7:9"/>ಒಮ್ಮೆ ನಾನು ನಿಯಮವಿಲ್ಲದೆ ಜೀವಿಸುತ್ತಿದ್ದೆನು. ಆದರೆ ಯಾವಾಗ ಆಜ್ಞೆಯು ಬಂದಿತೋ ಆಗ ಪಾಪವು ಜೀವಂತವಾಯಿತು, ನಾನು ಸತ್ತವನಾದೆನು. <verse eid="ROM 7:9"/><verse number="10" style="v" sid="ROM 7:10"/>ಜೀವವನ್ನು ತರಲಿಕ್ಕಾಗಿ ಕೊಟ್ಟಿರುವ ಆಜ್ಞೆಯೇ ಮರಣವನ್ನು ಉಂಟುಮಾಡುವುದಾಯಿತು ಎಂದು ಕಂಡುಕೊಂಡೆನು. <verse eid="ROM 7:10"/><verse number="11" style="v" sid="ROM 7:11"/>ಪಾಪವು ಆಜ್ಞೆಯಿಂದ ಅನುಕೂಲ ಹೊಂದಿ ನನ್ನನ್ನು ವಂಚಿಸಿ, ಅದೇ ನನ್ನನ್ನು ಮರಣಕ್ಕೆ ಒಳಪಡಿಸಿತು. <verse eid="ROM 7:11"/><verse number="12" style="v" sid="ROM 7:12"/>ಹೀಗಿರಲಾಗಿ, ನಿಯಮವು ಪವಿತ್ರವಾದದ್ದು. ಆಜ್ಞೆಯು ಪವಿತ್ರವೂ ನ್ಯಾಯವೂ ಒಳ್ಳೆಯದೂ ಆಗಿರುತ್ತದೆ.<verse eid="ROM 7:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="ROM 7:13"/>ಹಾಗಾದರೆ ಒಳ್ಳೆಯದಾಗಿರುವ ನಿಯಮವೇ ನನಗೆ ಮರಣಕ್ಕೆ ಕಾರಣವಾಯಿತೋ? ಎಂದಿಗೂ ಇಲ್ಲ! ಆದರೂ ಪಾಪವು ಪಾಪವೇ ಎಂದು ಕಾಣುವಂತೆ ಒಳ್ಳೆಯದಾಗಿರುವ ನಿಯಮದ ಮೂಲಕವೇ ಪಾಪವು ನನ್ನಲ್ಲಿ ಮರಣವು ಉಂಟಾಗುವಂತೆ ಮಾಡಿತು. ಈ ರೀತಿಯಾಗಿ ಆಜ್ಞೆಯ ಮೂಲಕ ಪಾಪವು ಘೋರವಾದದ್ದೇ ಎಂದು ಕಂಡುಬರಲು ಸಾಧ್ಯವಾಯಿತು.<verse eid="ROM 7:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="ROM 7:14"/>ನಿಯಮವು ಆತ್ಮಿಕವಾದದ್ದೆಂದು ಬಲ್ಲೆವು. ಆದರೆ ನರಮಾನವನಾದ ನಾನು ಪಾಪಕ್ಕೆ ಗುಲಾಮನಂತೆ ಮಾರಿಕೊಂಡವನಾಗಿದ್ದೇನೆ. <verse eid="ROM 7:14"/><verse number="15" style="v" sid="ROM 7:15"/>ನಾನು ಏನು ಮಾಡುತ್ತೇನೆ ಎಂಬುದನ್ನು ತಿಳಿಯದವನಾಗಿದ್ದೇನೆ. ಏಕೆಂದರೆ ನಾನು ಮಾಡಬೇಕೆಂದು ಬಯಸುವುದನ್ನು ಮಾಡದೆ, ಯಾವುದನ್ನು ದ್ವೇಷಿಸುತ್ತೇನೋ ಅದನ್ನೇ ಮಾಡುವವನಾಗಿದ್ದೇನೆ. <verse eid="ROM 7:15"/><verse number="16" style="v" sid="ROM 7:16"/>ನಾನು ಮಾಡಲು ಬಯಸದಿರುವುದನ್ನು ಮಾಡುವುದಾದರೆ, ನಿಯಮವು ಒಳ್ಳೆಯದೆಂದು ಒಪ್ಪುತ್ತೇನೆ. <verse eid="ROM 7:16"/><verse number="17" style="v" sid="ROM 7:17"/>ಹೀಗಿರಲಾಗಿ ನಾನು ಬಯಸದಿರುವುದನ್ನು ಮಾಡುವವನು ಇನ್ನು ನಾನಲ್ಲ, ನನ್ನಲ್ಲಿ ನೆಲೆಸಿರುವ ಪಾಪವೇ ಅದನ್ನು ಮಾಡುತ್ತದೆ. <verse eid="ROM 7:17"/><verse number="18" style="v" sid="ROM 7:18"/>ನನ್ನಲ್ಲಿ, ಅಂದರೆ ನನ್ನ ಶಾರೀರಿಕ ಸ್ವಭಾವದಲ್ಲಿ ಒಳ್ಳೆಯದೇನೂ ವಾಸವಾಗಿಲ್ಲ ಎಂದು ಬಲ್ಲೆನು. ಏಕೆಂದರೆ ಒಳ್ಳೆಯದನ್ನು ಮಾಡಬೇಕೆಂಬ ಮನಸ್ಸೇನೋ ನನ್ನಲ್ಲಿ ಇದೆ, ಆದರೆ ಅದನ್ನು ಮಾಡುವುದಕ್ಕೆ ನನ್ನಿಂದಾಗದು. <verse eid="ROM 7:18"/><verse number="19" style="v" sid="ROM 7:19"/>ನಾನು ಬಯಸುವ ಒಳ್ಳೆಯದನ್ನು ಮಾಡದೆ, ನಾನು ಮಾಡಲು ಬಯಸದೆ ಇರುವ ಕೆಟ್ಟದ್ದನ್ನೇ ಮಾಡುತ್ತಿದ್ದೇನೆ. <verse eid="ROM 7:19"/><verse number="20" style="v" sid="ROM 7:20"/>ಮಾಡಬಾರದೆನ್ನುವ ಕೆಲಸವನ್ನು ನಾನು ಮಾಡುತ್ತಿರುವುದಾದರೆ ಅದನ್ನು ಮಾಡಿದವನು ನಾನಲ್ಲ. ನನ್ನಲ್ಲಿ ನೆಲೆಗೊಂಡಿರುವ ಪಾಪವೇ ಅದನ್ನು ಮಾಡುತ್ತಿದೆ.<verse eid="ROM 7:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="ROM 7:21"/>ಒಳ್ಳೆಯದನ್ನು ಮಾಡಲು ಬಯಸುತ್ತಿರುವ ನನ್ನಲ್ಲಿ ಕೆಟ್ಟದ್ದು ಇರುವ ನಿಯಮವನ್ನು ಕಾಣುತ್ತಿದ್ದೇನೆ. <verse eid="ROM 7:21"/><verse number="22" style="v" sid="ROM 7:22"/>ಏಕೆಂದರೆ ನಾನು ಹೃದಯಪೂರ್ವಕವಾಗಿ ದೇವರ ನಿಯಮದಲ್ಲಿ ಹರ್ಷಗೊಳ್ಳುವವನಾಗಿದ್ದೇನೆ. <verse eid="ROM 7:22"/><verse number="23" style="v" sid="ROM 7:23"/>ಆದರೆ ನನ್ನ ಅವಯವಗಳಲ್ಲಿ ಬೇರೊಂದು ನಿಯಮವನ್ನು ಕಾಣುತ್ತಿದ್ದೇನೆ. ಅದು ನನ್ನ ಮನಸ್ಸಿನಲ್ಲಿರುವ ನಿಯಮಕ್ಕೆ ವಿರೋಧವಾಗಿ ಹೋರಾಡುತ್ತಾ ನನ್ನ ಅವಯವಗಳಲ್ಲಿ ಸೇರಿಕೊಂಡಿರುವ ಪಾಪದ ನಿಯಮಕ್ಕೆ ಸೆರೆಯವನನ್ನಾಗಿ ಮಾಡುತ್ತಿದೆ. <verse eid="ROM 7:23"/><verse number="24" style="v" sid="ROM 7:24"/>ನಾನು ಎಂಥಾ ದುರವಸ್ಥೆಯುಳ್ಳ ಮನುಷ್ಯನು! ನನ್ನನ್ನು ಈ ಮರಣಕರವಾದ ದೇಹದಿಂದ ಯಾರು ಬಿಡಿಸಬಲ್ಲರು? <verse eid="ROM 7:24"/><verse number="25" style="v" sid="ROM 7:25"/>ನಮ್ಮ ಕರ್ತ ಆಗಿರುವ ಯೇಸುಕ್ರಿಸ್ತರ ಮೂಲಕ ದೇವರಿಗೆ ಸ್ತೋತ್ರ!</para>
  <para style="p" vid="ROM 7:25">ಏಕೆಂದರೆ ನನ್ನಷ್ಟಕ್ಕೆ ನಾನೇ ನನ್ನ ಮನಸ್ಸಿನಲ್ಲಿ ದೇವರ ನಿಯಮಕ್ಕೆ ಗುಲಾಮನಾಗಿಯೂ ನನ್ನ ಮಾಂಸಭಾವದ ದೇಹದಲ್ಲಿ ಪಾಪದ ನಿಯಮಕ್ಕೆ ಗುಲಾಮನಾಗಿಯೂ ಇದ್ದೇನೆ.<verse eid="ROM 7:25"/></para>
  <chapter eid="ROM 7"/>
  <chapter number="8" style="c" sid="ROM 8"/>
  <para style="s1">ಪವಿತ್ರಾತ್ಮರ ಮೂಲಕ ಜೀವನ</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 8:1"/>ಆದ್ದರಿಂದ, ಈಗ ಕ್ರಿಸ್ತ ಯೇಸುವಿನಲ್ಲಿ ಇರುವವರಿಗೆ ದಂಡನಾತೀರ್ಪು ಇರುವುದಿಲ್ಲ. <verse eid="ROM 8:1"/><verse number="2" style="v" sid="ROM 8:2"/>ಏಕೆಂದರೆ ಕ್ರಿಸ್ತ ಯೇಸುವಿನ ಮೂಲಕ ಪವಿತ್ರಾತ್ಮರ ಜೀವದ ನಿಯಮವು ನಿನ್ನನ್ನು<note caller="+" style="f"><char style="fr" closed="false">8:2 </char><char style="ft" closed="false">ಕೆಲವು ಪ್ರತಿಗಳಲ್ಲಿ </char><char style="fqa" closed="false">ನನ್ನನ್ನು</char></note> ಪಾಪದ ನಿಯಮದಿಂದಲೂ ಮರಣದ ನಿಯಮದಿಂದಲೂ ಬಿಡುಗಡೆ ಮಾಡಿದೆ. <verse eid="ROM 8:2"/><verse number="3" style="v" sid="ROM 8:3"/>ನಿಯಮವು ನಮ್ಮ ಮಾಂಸಭಾವದ ಬಲಹೀನತೆಯಿಂದ ಯಾವುದನ್ನು ಮಾಡಲಿಕ್ಕೆ ಸಾಧ್ಯವಾಗದೆ ಹೋಯಿತೋ ಅದನ್ನು ದೇವರೇ ಮಾಡಿದರು. ಪಾಪ ಪರಿಹಾರಕ್ಕಾಗಿ ದೇವರು ತಮ್ಮ ಸ್ವಂತ ಪುತ್ರನನ್ನು ಪಾಪಮಯವಾದ ನರಮಾಂಸದ ರೂಪದಲ್ಲಿ ಕಳುಹಿಸಿಕೊಟ್ಟರು. ಆ ನರಮಾಂಸದಲ್ಲಿಯೇ ಪಾಪಕ್ಕೆ ದಂಡನಾತೀರ್ಪು ಮಾಡಿ ಸಾಧ್ಯಗೊಳಿಸಿದರು. <verse eid="ROM 8:3"/><verse number="4" style="v" sid="ROM 8:4"/>ಹೀಗೆ ನಾವು ಮಾಂಸಭಾವದವರಾಗಿ ಬಾಳದೆ ಪವಿತ್ರಾತ್ಮರಿಗನುಸಾರವಾಗಿ ಬಾಳುವ ನಮ್ಮಲ್ಲಿ ನಿಯಮದ ಅಗತ್ಯವು ನೆರವೇರುವುದಕ್ಕೆ ಆಸ್ಪದವಾಯಿತು.<verse eid="ROM 8:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="ROM 8:5"/>ಮಾಂಸಭಾವದವರಾಗಿ ಬಾಳುವವರ ಮನಸ್ಸು ಅದಕ್ಕೆ ಸಂಬಂಧಪಟ್ಟವುಗಳ ಮೇಲಿರುತ್ತದೆ. ಆದರೆ ಪವಿತ್ರಾತ್ಮ ದೇವರಿಗೆ ಅನುಸಾರವಾಗಿ ಬಾಳುವವರ ಮನಸ್ಸು ಪವಿತ್ರಾತ್ಮ ದೇವರಿಗೆ ಸಂಬಂಧಪಟ್ಟವುಗಳ ಮೇಲಿರುತ್ತದೆ. <verse eid="ROM 8:5"/><verse number="6" style="v" sid="ROM 8:6"/>ಮಾಂಸಭಾವದ ಮನಸ್ಸು ಮರಣಕರವಾದದ್ದು, ಪವಿತ್ರಾತ್ಮ ದೇವರ ಮೇಲೆ ಮನಸ್ಸಿಡುವುದು ಜೀವವೂ ಸಮಾಧಾನವೂ ಆಗಿರುತ್ತದೆ. <verse eid="ROM 8:6"/><verse number="7" style="v" sid="ROM 8:7"/>ಮಾಂಸಭಾವದ ಮನಸ್ಸು ದೇವರಿಗೆ ಶತ್ರುವಾಗಿರುತ್ತದೆ. ಏಕೆಂದರೆ, ಅದು ದೇವರ ನಿಯಮಕ್ಕೆ ಒಳಪಡುವುದೂ ಇಲ್ಲ, ಒಳಪಡುವುದಕ್ಕಾಗುವುದೂ ಇಲ್ಲ. <verse eid="ROM 8:7"/><verse number="8" style="v" sid="ROM 8:8"/>ಮಾಂಸಭಾವಕ್ಕೆ ಒಳಗಾದವರು ದೇವರನ್ನು ಮೆಚ್ಚಿಸಲಾರರು.<verse eid="ROM 8:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="ROM 8:9"/>ಆದರೆ ದೇವರ ಆತ್ಮವು ನಿಮ್ಮಲ್ಲಿ ಇರುವುದು ನಿಜವಾಗಿದ್ದರೆ ನೀವು ಮಾಂಸಭಾವಾಧೀನರಾಗಿರದೆ ದೇವರ ಆತ್ಮನಿಗೆ ಅಧೀನರಾಗಿದ್ದೀರಿ. ಕ್ರಿಸ್ತ ಯೇಸುವಿನ ಆತ್ಮ ಇಲ್ಲದವನು ಕ್ರಿಸ್ತ ಯೇಸುವಿಗೆ ಸೇರಿದವನಲ್ಲ. <verse eid="ROM 8:9"/><verse number="10" style="v" sid="ROM 8:10"/>ಆದರೆ ಕ್ರಿಸ್ತ ಯೇಸು ನಿಮ್ಮಲ್ಲಿ ಇರುವುದಾದರೆ, ನಿಮ್ಮ ಶರೀರವು ಪಾಪದ ನಿಮಿತ್ತ ಸತ್ತಿದ್ದರೂ ನಿಮ್ಮ ಆತ್ಮವು ನೀತಿಯ ನಿಮಿತ್ತ ಜೀವಿಸುತ್ತದೆ. <verse eid="ROM 8:10"/><verse number="11" style="v" sid="ROM 8:11"/>ಯೇಸುವನ್ನು ಮರಣದಿಂದ ಜೀವಂತವಾಗಿ ಎಬ್ಬಿಸಿದ ದೇವರ ಆತ್ಮವು ನಿಮ್ಮಲ್ಲಿ ವಾಸಮಾಡುತ್ತಿರುವುದಾದರೆ, ಕ್ರಿಸ್ತ ಯೇಸುವನ್ನು ಮರಣದಿಂದ ಎಬ್ಬಿಸಿದ ದೇವರು ನಿಮ್ಮಲ್ಲಿ ವಾಸಿಸುವ ಪವಿತ್ರಾತ್ಮ ದೇವರ ಮೂಲಕವೇ ನಿಮ್ಮ ಸಾಯುತ್ತಿರುವ ದೇಹಗಳಿಗೂ ಜೀವವನ್ನು ಕೊಡುವರು.<verse eid="ROM 8:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="ROM 8:12"/>ಆದ್ದರಿಂದ, ಪ್ರಿಯರೇ, ನಾವು ಮಾಂಸಭಾವದ ಹಂಗಿನಲ್ಲಿಲ್ಲ. ಅದರ ಆಶಾಪಾಶಗಳಿಗೆ ಅನುಗುಣವಾಗಿ ಬದುಕಲು ಋಣಸ್ಥರಲ್ಲ. <verse eid="ROM 8:12"/><verse number="13" style="v" sid="ROM 8:13"/>ಏಕೆಂದರೆ, ನೀವು ಮಾಂಸಭಾವಕ್ಕೆ ಅನುಸಾರವಾಗಿ ಜೀವಿಸಿದರೆ, ಸಾಯುವಿರಿ. ಆದರೆ ಪವಿತ್ರಾತ್ಮ ದೇವರಿಂದ ದೈಹಿಕ ದುರಭ್ಯಾಸಗಳನ್ನು ಸಾಯಿಸಿದರೆ, ನೀವು ಬದುಕುವಿರಿ.<verse eid="ROM 8:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="ROM 8:14"/>ಯಾರು ದೇವರ ಆತ್ಮರಿಂದ ನಡಿಸಿಕೊಳ್ಳುತ್ತಾರೋ ಅವರು ದೇವರ ಪುತ್ರರಾಗಿರುತ್ತಾರೆ. <verse eid="ROM 8:14"/><verse number="15" style="v" sid="ROM 8:15"/>ನಿಮ್ಮನ್ನು ಪುನಃ ಭಯಕ್ಕೆ ದಾಸರನ್ನಾಗಿ ಮಾಡುವ ಆತ್ಮನನ್ನು ನಾವು ಹೊಂದದೆ, ಪುತ್ರತ್ವದ ಪವಿತ್ರಾತ್ಮನನ್ನೇ ಹೊಂದಿದವರಾಗಿ ದೇವರನ್ನು, “ಅಪ್ಪಾ, ತಂದೆಯೇ,” ಎಂದು ಕರೆಯುತ್ತೇವೆ. <verse eid="ROM 8:15"/><verse number="16" style="v" sid="ROM 8:16"/>ನಾವು ದೇವರ ಮಕ್ಕಳಾಗಿದ್ದೇವೆ ಎಂಬುದಕ್ಕೆ ದೇವರ ಆತ್ಮರು ನಮ್ಮ ಆತ್ಮದೊಂದಿಗೆ ಸಾಕ್ಷಿಕೊಡುತ್ತಾರೆ. <verse eid="ROM 8:16"/><verse number="17" style="v" sid="ROM 8:17"/>ನಾವು ಈಗ ಮಕ್ಕಳಾಗಿರುವುದಾದರೆ, ಬಾಧ್ಯರಾಗಿರುತ್ತೇವೆ; ದೇವರಿಗೆ ಬಾಧ್ಯರು ಮತ್ತು ಕ್ರಿಸ್ತ ಯೇಸುವಿನೊಂದಿಗೆ ಸಹಬಾಧ್ಯರಾಗಿದ್ದೇವೆ. ನಾವು ಕ್ರಿಸ್ತ ಯೇಸುವಿನ ಶ್ರಮೆಗಳಲ್ಲಿ ನಿಜವಾಗಿಯೂ ಪಾಲುಗಾರರಾಗಿದ್ದರೆ, ಅವರ ಮಹಿಮೆಯಲ್ಲಿಯೂ ಪಾಲುಗಾರರಾಗುವೆವು.<verse eid="ROM 8:17"/></para>
  <para style="s1">ಮುಂದಣ ಮಹಿಮೆ</para>
  <para style="p">
    <verse number="18" style="v" sid="ROM 8:18"/>ನಮಗೆ ಮುಂದೆ ಪ್ರಕಟವಾಗಲಿರುವ ಮಹಿಮೆಯೊಂದಿಗೆ ಹೋಲಿಸುವಾಗ ಈಗಿನ ಸಂಕಟಗಳು ಅಲ್ಪವೆಂದು ನಾನು ಎಣಿಸುತ್ತೇನೆ. <verse eid="ROM 8:18"/><verse number="19" style="v" sid="ROM 8:19"/>ದೇವರ ಮಕ್ಕಳ ಪ್ರತ್ಯಕ್ಷತೆಯನ್ನು ಸೃಷ್ಟಿಯು ಆತುರದಿಂದ ಎದುರು ನೋಡುತ್ತಿದೆ. <verse eid="ROM 8:19"/><verse number="20" style="v" sid="ROM 8:20"/>ಸೃಷ್ಟಿಯು ನಾಶಕ್ಕೆ ಒಳಗಾಯಿತು. ಆದರೆ ಸ್ವಂತ ಇಚ್ಛೆಯಿಂದಲ್ಲ. ಅದನ್ನು ನಿರೀಕ್ಷೆಯಿಂದ ಒಳಪಡಿಸಿದ ದೇವರಿಂದಲೇ ಆಯಿತು. ಆದರೂ ಸೃಷ್ಟಿಗೂ ನಿರೀಕ್ಷೆಯಿದೆ. <verse eid="ROM 8:20"/><verse number="21" style="v" sid="ROM 8:21"/>ಈ ಸೃಷ್ಟಿಯು ಕೂಡ ನಾಶದ ಬಂಧನದಿಂದ ಬಿಡುಗಡೆಯಾಗಿ ದೇವರ ಮಕ್ಕಳ ಮಹಿಮೆಯುಳ್ಳ ಸ್ವಾತಂತ್ರ್ಯದಲ್ಲಿ ಪಾಲುಗೊಳ್ಳುತ್ತದೆ.<verse eid="ROM 8:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="ROM 8:22"/>ಈವರೆಗೂ ಸೃಷ್ಟಿಯೆಲ್ಲ ಪ್ರಸವ ವೇದನೆಯಂಥ ನೋವಿನಿಂದ ನರಳುತ್ತಿದೆ ಎಂದು ನಾವು ಬಲ್ಲೆವು. <verse eid="ROM 8:22"/><verse number="23" style="v" sid="ROM 8:23"/>ಅಷ್ಟೇ ಅಲ್ಲದೆ, ಪವಿತ್ರಾತ್ಮ ದೇವರ ಪ್ರಥಮ ಫಲವನ್ನು ಹೊಂದಿದವರಾಗಿರುವ ನಾವು ಕೂಡ, ಮಕ್ಕಳ ಪದವಿಯನ್ನು ಪಡೆಯುವುದಕ್ಕಾಗಿ ನಮ್ಮ ದೇಹಗಳ ಬಿಡುಗಡೆಗಾಗಿ ಎದುರುನೋಡುತ್ತಾ ಆತುರದಿಂದ ನರಳುತ್ತಾ ಇದ್ದೇವೆ. <verse eid="ROM 8:23"/><verse number="24" style="v" sid="ROM 8:24"/>ಈ ನಿರೀಕ್ಷೆಯಿಂದಲೇ ನಾವು ರಕ್ಷಣೆಯನ್ನು ಹೊಂದಿದವರಾಗಿದ್ದೇವೆ. ಆದರೆ ಕಣ್ಣಿಗೆ ಕಾಣುವ ನಿರೀಕ್ಷೆಯು ನಿರೀಕ್ಷೆಯೇ ಅಲ್ಲ. ಕಾಣುತ್ತಿರುವುದನ್ನು ಯಾರಾದರೂ ನಿರೀಕ್ಷಿಸುವರೋ? <verse eid="ROM 8:24"/><verse number="25" style="v" sid="ROM 8:25"/>ಆದರೆ ನಾವು ಇನ್ನು ಕಾಣದಿರುವಂಥದ್ದಕ್ಕಾಗಿ ನಿರೀಕ್ಷಿಸುವುದಾದರೆ ಅದಕ್ಕಾಗಿ ತಾಳ್ಮೆಯಿಂದ ಕಾದುಕೊಂಡಿರುತ್ತೇವೆ.<verse eid="ROM 8:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="ROM 8:26"/>ಅದೇ ರೀತಿಯಲ್ಲಿ ಪವಿತ್ರಾತ್ಮರು ನಮ್ಮ ಬಲಹೀನತೆಯಲ್ಲಿ ನಮಗೆ ಸಹಾಯ ಮಾಡುತ್ತಾರೆ. ಯಾವುದಕ್ಕಾಗಿ ಹೇಗೆ ಪ್ರಾರ್ಥಿಸಬೇಕೆಂದು ನಾವು ತಿಳಿಯದವರಾಗಿದ್ದೇವೆ. ಆದರೆ ಪವಿತ್ರಾತ್ಮರು ತಾವೇ ಮಾತುಗಳಿಂದ ವ್ಯಕ್ತಪಡಿಸಲು ಸಾಧ್ಯವಾಗದ ನರಳಾಟದೊಂದಿಗೆ ನಮಗೋಸ್ಕರ ಪ್ರಾರ್ಥಿಸುವವರಾಗಿದ್ದಾರೆ. <verse eid="ROM 8:26"/><verse number="27" style="v" sid="ROM 8:27"/>ನಮ್ಮ ಹೃದಯಗಳನ್ನು ಪರಿಶೋಧಿಸುವ ದೇವರು ಪವಿತ್ರಾತ್ಮರ ಮನಸ್ಸನ್ನು ಬಲ್ಲವರಾಗಿದ್ದಾರೆ. ಏಕೆಂದರೆ ಪವಿತ್ರಾತ್ಮರು ದೇವಜನರಿಗಾಗಿ ದೇವರ ಚಿತ್ತದ ಪ್ರಕಾರ ವಿಜ್ಞಾಪಿಸುತ್ತಾರೆ.<verse eid="ROM 8:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="ROM 8:28"/>ದೇವರನ್ನು ಪ್ರೀತಿಸಿ ದೇವರ ಉದ್ದೇಶಕ್ಕೆ ಅನುಸಾರವಾಗಿ ಕರೆಹೊಂದಿದವರಿಗೆ ಸಕಲವನ್ನು ಒಳ್ಳೆಯದಕ್ಕಾಗಿಯೇ ದೇವರು ಮಾಡುವರು, ಎಂದು ನಮಗೆ ಗೊತ್ತಿದೆ. <verse eid="ROM 8:28"/><verse number="29" style="v" sid="ROM 8:29"/>ಅನೇಕ ಸಹೋದರರ ಮಧ್ಯೆ ಜ್ಯೇಷ್ಠಪುತ್ರನೆನಿಸುವಂತೆ ದೇವರು ಯಾರನ್ನು ಮೊದಲು ತಿಳಿದುಕೊಂಡರೋ ಅವರನ್ನು ತಮ್ಮ ಪುತ್ರನ ಹೋಲಿಕೆಗೆ ಸಮಾನರಾಗುವಂತೆ ಮುಂದಾಗಿ ನೇಮಿಸಿದರು. <verse eid="ROM 8:29"/><verse number="30" style="v" sid="ROM 8:30"/>ಆದರೆ ದೇವರು ಯಾರನ್ನು ಮುಂದಾಗಿ ನೇಮಿಸಿದರೋ, ಅವರನ್ನು ಕರೆದರು; ಯಾರನ್ನು ಕರೆದರೋ, ಅವರನ್ನು ನೀತಿವಂತರೆಂದು ನಿರ್ಣಯಿಸಿದರು; ಯಾರನ್ನು ನೀತಿವಂತರೆಂದು ನಿರ್ಣಯಿಸಿದರೋ ಅವರನ್ನು ಮಹಿಮೆಪಡಿಸಿದರು.<verse eid="ROM 8:30"/></para>
  <para style="s1">ಜಯಶಾಲಿಗಳಿಗಿಂತಲೂ ಹೆಚ್ಚಿನವರು</para>
  <para style="p">
    <verse number="31" style="v" sid="ROM 8:31"/>ಹಾಗಾದರೆ, ಈ ವಿಷಯಗಳಲ್ಲಿ ನಾವು ಏನು ಹೇಳೋಣ? ದೇವರು ನಮ್ಮ ಪರವಾಗಿ ಇದ್ದರೆ ನಮ್ಮನ್ನು ವಿರೋಧಿಸುವವರು ಯಾರು? <verse eid="ROM 8:31"/><verse number="32" style="v" sid="ROM 8:32"/>ದೇವರು ತಮ್ಮ ಸ್ವಂತ ಮಗನನ್ನೇ ಉಳಿಸಿಕೊಳ್ಳದೆ ನಮ್ಮೆಲ್ಲರಿಗೋಸ್ಕರ ಕ್ರಿಸ್ತ ಯೇಸುವನ್ನು ಕೊಟ್ಟ ಮೇಲೆ ನಮಗೆ ಉದಾರವಾಗಿ ಅವರೊಂದಿಗೆ ಎಲ್ಲವನ್ನು ಸಹ ಕೊಡದೆ ಇರುವರೇ? <verse eid="ROM 8:32"/><verse number="33" style="v" sid="ROM 8:33"/>ದೇವರು ತಾವೇ ಆರಿಸಿಕೊಂಡವರ ಮೇಲೆ ದೋಷಾರೋಪಣೆ ಮಾಡುವವರಾರು? ದೇವರೇ ನೀತಿವಂತರೆಂದು ನಿರ್ಣಯ ಮಾಡುವವರಾಗಿರುತ್ತಾರೆ. <verse eid="ROM 8:33"/><verse number="34" style="v" sid="ROM 8:34"/>ಅಪರಾಧಿಗಳೆಂದು ನಿರ್ಣಯಿಸುವವರು ಯಾರು? ಕ್ರಿಸ್ತ ಯೇಸು ಮರಣವನ್ನು ಹೊಂದಿದ್ದಲ್ಲದೆ, ಜೀವಿತರಾಗಿ ಎದ್ದು ದೇವರ ಬಲಗಡೆಯಲ್ಲಿ ಇದ್ದಾರೆ ಮತ್ತು ಅವರೇ ನಮಗೋಸ್ಕರ ವಿಜ್ಞಾಪಿಸುವವರಾಗಿರುತ್ತಾರೆ. <verse eid="ROM 8:34"/><verse number="35" style="v" sid="ROM 8:35"/>ಕ್ರಿಸ್ತ ಯೇಸುವಿನ ಪ್ರೀತಿಯಿಂದ ನಮ್ಮನ್ನು ಅಗಲಿಸುವವರು ಯಾರು? ಕಷ್ಟವೋ ಇಕ್ಕಟ್ಟೋ ಹಿಂಸೆಯೋ ಆಹಾರವಿಲ್ಲದಿರುವುದೋ ಬಟ್ಟೆ ಇಲ್ಲದಿರುವುದೋ ಅಪಾಯವೋ ಖಡ್ಗವೋ? ಇವೆಲ್ಲವೂ ನಮ್ಮನ್ನು ಅಗಲಿಸಲಾರವು. <verse eid="ROM 8:35"/><verse number="36" style="v" sid="ROM 8:36"/>ಇವು ಪವಿತ್ರ ವೇದದಲ್ಲಿ ಬರೆದಿರುವಂತೆ ಇವೆ:</para>
  <para style="q1" vid="ROM 8:36">“ನಿನಗೋಸ್ಕರ ನಾವು ದಿನವೆಲ್ಲಾ ಮರಣಕ್ಕೆ ಗುರಿಯಾಗಿದ್ದೇವೆ;</para>
  <para style="q2" vid="ROM 8:36">ವಧಿಸಲಿಕ್ಕಾಗಿರುವ ಕುರಿಗಳಂತೆ ನಾವು ಭಾವಿಸಿರುತ್ತೇವೆ.”<note caller="+" style="f"><char style="fr" closed="false">8:36 </char><char style="ft" closed="false"><char style="xt"><ref loc="PSA 44:22">ಕೀರ್ತನೆ 44:22</ref></char></char></note><verse eid="ROM 8:36"/></para>
  <para style="m">
    <verse number="37" style="v" sid="ROM 8:37"/>ಇವೆಲ್ಲವುಗಳಲ್ಲಿಯೂ ನಾವು ನಮ್ಮನ್ನು ಪ್ರೀತಿಸಿದಾತನ ಮೂಲಕ ಜಯ ಹೊಂದಿದವರಿಗಿಂತಲೂ ಹೆಚ್ಚಿನವರಾಗಿದ್ದೇವೆ. <verse eid="ROM 8:37"/><verse number="38" style="v" sid="ROM 8:38"/>ಏಕೆಂದರೆ ಮರಣವಾಗಲಿ, ಜೀವವಾಗಲಿ, ದೇವದೂತರಾಗಲಿ, ದುರಾತ್ಮಗಳಾಗಲಿ, ವರ್ತಮಾನಕಾಲದ ಸಂಗತಿಗಳಾಗಲಿ, ಭವಿಷ್ಯತ್ಕಾಲದ ಸಂಗತಿಗಳಾಗಲಿ, ಯಾವುದೇ ಶಕ್ತಿಯಾಗಲಿ, <verse eid="ROM 8:38"/><verse number="39" style="v" sid="ROM 8:39"/>ಎತ್ತರವಾಗಲಿ, ಆಳವಾಗಲಿ ಅಥವಾ ಸೃಷ್ಟಿಯಲ್ಲಿರುವ ಬೇರೆ ಯಾವುದೇ ಆಗಲಿ ನಮ್ಮ ಕರ್ತ ಆಗಿರುವ ಕ್ರಿಸ್ತ ಯೇಸುವಿನಲ್ಲಿರುವ ದೇವರ ಪ್ರೀತಿಯಿಂದ ನಮ್ಮನ್ನು ಅಗಲಿಸಲಾಗದೆಂದು ನಮಗೆ ದೃಢ ನಿಶ್ಚಯವಿದೆ.<verse eid="ROM 8:39"/></para>
  <chapter eid="ROM 8"/>
  <chapter number="9" style="c" sid="ROM 9"/>
  <para style="s1">ಇಸ್ರಾಯೇಲರ ಮೇಲೆ ಪೌಲನ ವೇದನೆ</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 9:1"/>ನಾನು ಕ್ರಿಸ್ತ ಯೇಸುವಿನಲ್ಲಿ ಸತ್ಯವನ್ನು ಮಾತನಾಡುತ್ತೇನೆ. ನಾನು ಸುಳ್ಳು ಹೇಳುತ್ತಾ ಇಲ್ಲ. ನನ್ನ ಮನಸ್ಸಾಕ್ಷಿಯು ಇದನ್ನು ಪವಿತ್ರಾತ್ಮ ದೇವರ ಮೂಲಕ ಖಚಿತ ಪಡಿಸುತ್ತದೆ. <verse eid="ROM 9:1"/><verse number="2" style="v" sid="ROM 9:2"/>ನನ್ನ ಹೃದಯದಲ್ಲಿ ಮಹಾದುಖಃವೂ ಎಡೆಬಿಡದ ವೇದನೆಯೂ ತೀರದವೇದನೆಯೂ ಇದೆ. <verse eid="ROM 9:2"/><verse number="3" style="v" sid="ROM 9:3"/>ನನ್ನ ಸ್ವಂತ ಜನರಾದ ನನ್ನ ಯೆಹೂದ್ಯ ಸಹೋದರರಿಗಾಗಿ, ಸಾಧ್ಯವಾದರೆ ನಾನೇ ಕ್ರಿಸ್ತ ಯೇಸುವಿನಿಂದ ದೂರಹೋಗಿ ಶಾಪಗ್ರಸ್ತನಾಗಲು ಸಿದ್ಧನಾಗಿದ್ದೇನೆ. <verse eid="ROM 9:3"/><verse number="4" style="v" sid="ROM 9:4"/>ಇಸ್ರಾಯೇಲರಾದ ಅವರಿಗೆ ಸ್ವೀಕಾರವೂ ದೇವರ ಮಹಿಮೆಯೂ ಒಡಂಬಡಿಕೆಗಳೂ ನಿಯಮ ಕೊಡೋಣವೂ ದೇವಾಲಯದ ಸೇವೆಯೂ ಹಾಗೂ ವಾಗ್ದಾನಗಳೂ ಒಪ್ಪಿಸಲಾಗಿವೆ. <verse eid="ROM 9:4"/><verse number="5" style="v" sid="ROM 9:5"/>ನಮ್ಮ ಪಿತೃಗಳು ಅವರಿಗೆ ಸೇರಿದವರು. ಕ್ರಿಸ್ತ ಯೇಸುವು ಮನುಷ್ಯರಾಗಿ ಹುಟ್ಟಿದ್ದು ಅವರ ವಂಶದಲ್ಲಿಯೇ; ಈ ಕ್ರಿಸ್ತ ಯೇಸುವೇ ಎಲ್ಲರ ಮೇಲಿರುವ ದೇವರೂ ಎಂದೆಂದಿಗೂ ಸ್ತುತಿಹೊಂದತಕ್ಕವರೂ ಆಗಿದ್ದಾರೆ! ಆಮೆನ್.<verse eid="ROM 9:5"/></para>
  <para style="s1">ದೇವರ ಸಾರ್ವಭೌಮ ಆಯ್ಕೆ</para>
  <para style="p">
    <verse number="6" style="v" sid="ROM 9:6"/>ಇದು ದೇವರ ವಾಕ್ಯವು ನೆರವೇರಲಿಲ್ಲ ಎಂಬಂತೆ ಅಲ್ಲ. ಏಕೆಂದರೆ ಇಸ್ರಾಯೇಲ್ ವಂಶದಲ್ಲಿ ಬಂದವರೆಲ್ಲರೂ ಇಸ್ರಾಯೇಲರಲ್ಲ. <verse eid="ROM 9:6"/><verse number="7" style="v" sid="ROM 9:7"/>ಅಥವಾ ಅಬ್ರಹಾಮನ ಸಂತತಿಯವರೆಲ್ಲ ಅವನ ಮಕ್ಕಳಲ್ಲ. ಆದರೆ, “ಇಸಾಕನಿಂದ ಹುಟ್ಟುವವರೇ ನಿನ್ನ ಸಂತತಿ ಎನಿಸಿಕೊಳ್ಳುವರು,”<note caller="+" style="f"><char style="fr" closed="false">9:7 </char><char style="ft" closed="false"><char style="xt"><ref loc="GEN 21:12">ಆದಿ 21:12</ref></char></char></note> ಎಂದು ಹೇಳಲಾಗಿದೆ. <verse eid="ROM 9:7"/><verse number="8" style="v" sid="ROM 9:8"/>ಇದರ ಅರ್ಥ, ಶರೀರಸಂಬಂಧದ ಮಕ್ಕಳು ದೇವರ ಮಕ್ಕಳಾಗಿರದೆ ವಾಗ್ದಾನದ ಮಕ್ಕಳೇ ಅಬ್ರಹಾಮನ ಮಕ್ಕಳೆಂದು ಎನಿಸಿಕೊಳ್ಳುವರು ಎಂಬುದು. <verse eid="ROM 9:8"/><verse number="9" style="v" sid="ROM 9:9"/>ಏಕೆಂದರೆ, “ನೇಮಕವಾದ ಕಾಲದಲ್ಲಿ ನಾನು ತಿರುಗಿ ಬಂದಾಗ ಸಾರಳಿಗೆ ಒಬ್ಬ ಮಗನಿರುವನು,”<note caller="+" style="f"><char style="fr" closed="false">9:9 </char><char style="ft" closed="false"><char style="xt"><ref loc="GEN 18:10">ಆದಿ 18:10</ref>,<ref loc="GEN 18:14">14</ref></char></char></note> ಅದು ವಾಗ್ದಾನದ ಮಾತಾಗಿತ್ತು.<verse eid="ROM 9:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="ROM 9:10"/>ಇದು ಮಾತ್ರವಲ್ಲದೆ, ರೆಬೆಕ್ಕಳು ಸಹ ನಮ್ಮ ಪಿತೃವಾದ ಇಸಾಕನ ಮೂಲಕ ಅವಳಿಜವಳಿ ಮಕ್ಕಳನ್ನು ಪಡೆದಳು. <verse eid="ROM 9:10"/><verse number="11" style="v" sid="ROM 9:11"/>ಹೀಗೆ, ಆ ಮಕ್ಕಳು ಹುಟ್ಟುವುದಕ್ಕೆ ಮುಂಚೆ, ಒಳ್ಳೆಯದು ಅಥವಾ ಕೆಟ್ಟದ್ದನ್ನು ಮಾಡುವುದಕ್ಕೆ ಮುಂಚೆಯೇ, ದೇವರ ಆಯ್ಕೆಯ ಉದ್ದೇಶವು ಕೃತ್ಯಗಳಿಗೆ ಅನುಸಾರವಲ್ಲವೆಂಬುದು ಸ್ಥಿರವಾಯಿತು. <verse eid="ROM 9:11"/><verse number="12" style="v" sid="ROM 9:12"/>ಆದರೆ ಅದು ಕರೆಯುವಾತನಿಂದಲೇ, “ಹಿರಿಯನು ಕಿರಿಯವನಿಗೆ ಸೇವೆಮಾಡುವನು,”<note caller="+" style="f"><char style="fr" closed="false">9:12 </char><char style="ft" closed="false"><char style="xt"><ref loc="GEN 25:23">ಆದಿ 25:23</ref></char></char></note> ಎಂದು ರೆಬೆಕ್ಕಳಿಗೆ ಹೇಳಲಾಗಿತ್ತು. <verse eid="ROM 9:12"/><verse number="13" style="v" sid="ROM 9:13"/>ಇದಕ್ಕನುಸಾರವಾಗಿ, “ಯಾಕೋಬನನ್ನು ನಾನು ಪ್ರೀತಿಸಿದೆನು, ಆದರೆ ಏಸಾವನನ್ನು ಹಗೆ ಮಾಡಿದೆನು,”<note caller="+" style="f"><char style="fr" closed="false">9:13 </char><char style="ft" closed="false"><char style="xt"><ref loc="MAL 1:2">ಮಲಾಕಿ 1:2</ref>,<ref loc="MAL 1:3">3</ref></char></char></note> ಎಂದು ಬರೆದಿರುತ್ತದೆ.<verse eid="ROM 9:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="ROM 9:14"/>ಹಾಗಾದರೆ ನಾವು ಏನು ಹೇಳೋಣ? ದೇವರು ಅನ್ಯಾಯಗಾರನೋ? ಎಂದಿಗೂ ಇಲ್ಲ. <verse eid="ROM 9:14"/><verse number="15" style="v" sid="ROM 9:15"/>ದೇವರು ಮೋಶೆಗೆ ಹೇಳಿದ್ದೇನೆಂದರೆ,</para>
  <para style="q1" vid="ROM 9:15">“ಯಾವನ ಮೇಲೆ ನನ್ನ ಕರುಣೆ ಉಂಟೋ, ಅವನನ್ನು ಕರುಣಿಸುವೆನು.</para>
  <para style="q2" vid="ROM 9:15">ಯಾವನ ಮೇಲೆ ನನ್ನ ಕನಿಕರವಿದೆಯೋ ಅವನನ್ನು ಕನಿಕರಿಸುವೆನು.”<note caller="+" style="f"><char style="fr" closed="false">9:15 </char><char style="ft" closed="false"><char style="xt"><ref loc="EXO 33:19">ವಿಮೋ 33:19</ref></char></char></note><verse eid="ROM 9:15"/></para>
  <para style="m">
    <verse number="16" style="v" sid="ROM 9:16"/>ಆದ್ದರಿಂದ ದೇವರ ಆಯ್ಕೆಯು ಮನುಷ್ಯನ ಬಯಕೆ ಅಥವಾ ಪ್ರಯತ್ನದಿಂದಾಗಿರದೆ, ದೇವರ ಕರುಣೆಯಿಂದಲೇ ಆಗಿದೆ. <verse eid="ROM 9:16"/><verse number="17" style="v" sid="ROM 9:17"/>ಏಕೆಂದರೆ, “ನಾನು ನಿನ್ನಲ್ಲಿ ನನ್ನ ಶಕ್ತಿಯನ್ನು ತೋರಿಸಿ ನನ್ನ ಹೆಸರನ್ನು ಭೂಮಿಯ ಮೇಲೆಲ್ಲಾ ಪ್ರಸಿದ್ಧಪಡಿಸಬೇಕೆಂಬ ಉದ್ದೇಶದಿಂದಲೇ ನಿನ್ನನ್ನು ಉನ್ನತಸ್ಥಾನಕ್ಕೆ ಏರಿಸಿದೆನು,”<note caller="+" style="f"><char style="fr" closed="false">9:17 </char><char style="ft" closed="false"><char style="xt"><ref loc="EXO 9:16">ವಿಮೋ 9:16</ref></char></char></note> ಎಂದು ಪವಿತ್ರ ವೇದದಲ್ಲಿ ದೇವರು ಫರೋಹನಿಗೆ ಹೇಳುತ್ತಾರೆ. <verse eid="ROM 9:17"/><verse number="18" style="v" sid="ROM 9:18"/>ಆದ್ದರಿಂದ ದೇವರು ಯಾರನ್ನು ಕರುಣಿಸಬೇಕೆಂದು ಬಯಸುತ್ತಾರೋ, ಅವರನ್ನು ಕರುಣಿಸುತ್ತಾರೆ. ಯಾರನ್ನು ಕಠಿಣಪಡಿಸಬೇಕೆಂದು ಬಯಸುತ್ತಾರೋ, ಅವರನ್ನು ಕಠೋರನ್ನಾಗಿ ಮಾಡುತ್ತಾರೆ.<verse eid="ROM 9:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="ROM 9:19"/>ಹಾಗಾದರೆ ನೀನು, “ದೇವರು ಇನ್ನೂ ತಪ್ಪು ಕಂಡುಹಿಡಿಯುವುದು ಏಕೆ? ದೇವರ ಸಂಕಲ್ಪವನ್ನು ಎದುರಿಸುವವರು ಯಾರು?” ಎಂದು ನೀನು ನನ್ನನ್ನು ಕೇಳುವೆ. <verse eid="ROM 9:19"/><verse number="20" style="v" sid="ROM 9:20"/>ಎಲೈ, ಮನುಷ್ಯನೇ, ದೇವರಿಗೆ ಎದುರಾಗಿ ಮಾತನಾಡಲು ನೀನು ಯಾರು? “ರೂಪಿಸಿರುವುದು ರೂಪಿಸಿದವನಿಗೆ, ‘ಏಕೆ ನನ್ನನ್ನು ಹೀಗೆ ರೂಪಿಸಿದೆ?’ ”<note caller="+" style="f"><char style="fr" closed="false">9:20 </char><char style="ft" closed="false"><char style="xt"><ref loc="ISA 29:16">ಯೆಶಾಯ 29:16</ref>; <ref loc="ISA 45:9">45:9</ref></char></char></note> ಎಂದು ಪ್ರಶ್ನಿಸಬಹುದೋ? <verse eid="ROM 9:20"/><verse number="21" style="v" sid="ROM 9:21"/>ಕುಂಬಾರನಿಗೆ ಒಂದೇ ಮಣ್ಣಿನ ರಾಶಿಯಿಂದ ಒಂದನ್ನು ಉತ್ತಮವಾದ ಪಾತ್ರೆಯನ್ನಾಗಿಯೂ ಮತ್ತೊಂದನ್ನು ಸಾಮಾನ್ಯವಾದ ಪಾತ್ರೆಯನ್ನಾಗಿಯೂ ಮಾಡುವ ಅಧಿಕಾರ ಇಲ್ಲವೋ?<verse eid="ROM 9:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="ROM 9:22"/>ನಾಶಕ್ಕೂ, ಕೋಪಾಗ್ನಿಗೂ ಪಾತ್ರೆಯಾಗಿರುವುದರ ಮೇಲೆ ದೇವರು ತಮ್ಮ ಕೋಪವನ್ನು ತೋರಿಸಿ ತಮ್ಮ ಸಾಮರ್ಥ್ಯವನ್ನು ತಿಳಿಯಪಡಿಸಬೇಕೆಂದಿದ್ದರೂ ಬಹು ಸಹನೆಯಿಂದ ತಾಳಿಕೊಂಡಿರಲು ಬಯಸಿದರೆ, ಯಾರು ಏನು ಮಾಡಬಹುದು? <verse eid="ROM 9:22"/><verse number="23" style="v" sid="ROM 9:23"/>ದೇವರು ಯೆಹೂದ್ಯರೊಳಗಿಂದ ಮಾತ್ರವೇ ಕರೆಯದೆ, ಯೆಹೂದ್ಯರಲ್ಲದವರಿಂದಲೂ ಕರೆದು, ಮಹಿಮೆಗೆಂದು ಮೊದಲೇ ಸಿದ್ಧಮಾಡಿ, ತಮ್ಮ ಕರುಣೆಗೆ ಪಾತ್ರರಾದ ಜನರಿಗೆ ತಮ್ಮ ಮಹಿಮೆಯ ಐಶ್ವರ್ಯವನ್ನು ಪ್ರಕಟಿಸಲು ಇದನ್ನು ಮಾಡಿದರು. <verse eid="ROM 9:23"/><verse number="24" style="v" sid="ROM 9:24"/>ಇದಕ್ಕಾಗಿಯೇ ದೇವರು ಯೆಹೂದ್ಯರನ್ನು ಮಾತ್ರವೇ ಕರೆಯದೆ ಯೆಹೂದ್ಯರಲ್ಲದವರನ್ನು ಸಹ ಕರೆದಿದ್ದಾರಲ್ಲಾ? <verse eid="ROM 9:24"/><verse number="25" style="v" sid="ROM 9:25"/>ಹೋಶೇಯನ ಪ್ರವಾದನೆಯಲ್ಲಿ ದೇವರು,</para>
  <para style="q1" vid="ROM 9:25">“ನನ್ನ ಜನರಲ್ಲದವರನ್ನು ‘ನನ್ನ ಜನರು,’ ಎಂದು ಕರೆಯುವರು.</para>
  <para style="q2" vid="ROM 9:25">ನಾನು ಪ್ರೀತಿಸದವರನ್ನು ನನ್ನ ‘ಪ್ರಿಯರು’ ಎಂದೂ ಹೇಳುವರು.”<note caller="+" style="f"><char style="fr" closed="false">9:25 </char><char style="ft" closed="false"><char style="xt"><ref loc="HOS 2:23">ಹೋಶೇ 2:23</ref></char></char></note><verse eid="ROM 9:25"/></para>
  <para style="m">
    <verse number="26" style="v" sid="ROM 9:26"/>ಮತ್ತು,</para>
  <para style="q1" vid="ROM 9:26">“ಯಾವ ಸ್ಥಳದಲ್ಲಿ</para>
  <para style="q2" vid="ROM 9:26">‘ನೀವು ನನ್ನ ಜನರಲ್ಲ,’ ಎಂದು ಅವರಿಗೆ ಹೇಳಲಾಗಿತ್ತೋ,</para>
  <para style="q2" vid="ROM 9:26">ಆ ಸ್ಥಳದಲ್ಲಿಯೇ, ‘ಅವರು ಜೀವಸ್ವರೂಪಿಯಾದ ದೇವರ ಮಕ್ಕಳು,’ ಎಂದು ಕರೆಯಲಾಗುವರು,”<note caller="+" style="f"><char style="fr" closed="false">9:26 </char><char style="ft" closed="false"><char style="xt"><ref loc="HOS 1:10">ಹೋಶೇ 1:10</ref></char></char></note></para>
  <para style="m" vid="ROM 9:26">ಎಂದು ದೇವರು ಹೇಳುತ್ತಾರೆ.<verse eid="ROM 9:26"/></para>
  <para style="m">
    <verse number="27" style="v" sid="ROM 9:27"/>ಇದಲ್ಲದೆ ಯೆಶಾಯನು ಇಸ್ರಾಯೇಲರನ್ನು ಕುರಿತು ಕೂಗಿ ಹೇಳುವುದೇನೆಂದರೆ,</para>
  <para style="q1" vid="ROM 9:27">“ಇಸ್ರಾಯೇಲರ ಸಂಖ್ಯೆಯು ಸಮುದ್ರದ ಉಸುಬಿನಂತಿದ್ದರೂ</para>
  <para style="q2" vid="ROM 9:27">ಅವರಲ್ಲಿ ಕೆಲವರು ಮಾತ್ರ ರಕ್ಷಣೆಹೊಂದುವರು.<verse eid="ROM 9:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="ROM 9:28"/>ಏಕೆಂದರೆ ಕರ್ತನು ತಮ್ಮ ವಾಕ್ಯವನ್ನು</para>
  <para style="q2" vid="ROM 9:28">ಭೂಮಿಯ ಮೇಲೆ ಅಂತಿಮವಾಗಿಯೂ ತ್ವರಿತವಾಗಿಯೂ ನೆರವೇರಿಸುವರು.”<note caller="+" style="f"><char style="fr" closed="false">9:28 </char><char style="ft" closed="false"><char style="xt"><ref loc="ISA 10:22">ಯೆಶಾಯ 10:22</ref>,<ref loc="ISA 10:23">23</ref></char></char></note><verse eid="ROM 9:28"/></para>
  <para style="m">
    <verse number="29" style="v" sid="ROM 9:29"/>ಯೆಶಾಯನು ಈ ಹಿಂದೆ,</para>
  <para style="q1" vid="ROM 9:29">“ಸೇನಾಧೀಶ್ವರರಾದ ದೇವರು</para>
  <para style="q2" vid="ROM 9:29">ನಮಗೆ ಸಂತತಿಯನ್ನು ಉಳಿಸದೆ ಹೋಗಿದ್ದರೆ,</para>
  <para style="q1" vid="ROM 9:29">ನಾವು ಸೊದೋಮಿನಂತೆ ಆಗುತ್ತಿದ್ದೆವು,</para>
  <para style="q2" vid="ROM 9:29">ಗೊಮೋರದ ಹಾಗೆ ಇರುತ್ತಿದ್ದೆವು.”<note caller="+" style="f"><char style="fr" closed="false">9:29 </char><char style="ft" closed="false"><char style="xt"><ref loc="ISA 1:9">ಯೆಶಾಯ 1:9</ref></char></char></note></para>
  <para style="m" vid="ROM 9:29">ಎಂದು ಹೇಳಿದ್ದಾನೆ.<verse eid="ROM 9:29"/></para>
  <para style="s1">ಇಸ್ರಾಯೇಲಿನ ಅಪನಂಬಿಕೆ</para>
  <para style="p">
    <verse number="30" style="v" sid="ROM 9:30"/>ಹಾಗಾದರೆ ನಾವು ಏನು ಹೇಳೋಣ? ನೀತಿಯನ್ನು ಅನುಸರಿಸದ ಯೆಹೂದ್ಯರಲ್ಲದವರು ನಂಬಿಕೆಯ ಮೂಲಕ ದೊರಕುವ ನೀತಿಯನ್ನು ಪಡೆದರು. <verse eid="ROM 9:30"/><verse number="31" style="v" sid="ROM 9:31"/>ಆದರೆ ನೀತಿಯ ನಿಯಮವನ್ನು ಅನುಸರಿಸಿದ ಇಸ್ರಾಯೇಲರಾದರೋ ಆ ನೀತಿಯ ಮಾರ್ಗವನ್ನು ಪಡೆಯಲಿಲ್ಲ. <verse eid="ROM 9:31"/><verse number="32" style="v" sid="ROM 9:32"/>ಏಕೆ? ಏಕೆಂದರೆ ಅವರು ನಂಬಿಕೆಯನ್ನು ಅನುಸರಿಸದೆ ಕೃತ್ಯಗಳನ್ನು ಅನುಸರಿಸಿದ್ದರಿಂದಲೇ. ಅವರು ಎಡವುಕಲ್ಲನ್ನು ಎಡವಿದರು. <verse eid="ROM 9:32"/><verse number="33" style="v" sid="ROM 9:33"/>ಪವಿತ್ರ ವೇದದಲ್ಲಿ ಹೀಗೆ ಬರೆಯಲಾಗಿದೆ:</para>
  <para style="q1" vid="ROM 9:33">“ಇಗೋ, ನಾನು ಚೀಯೋನಿನಲ್ಲಿ ಜನರು ಎಡವಿ ಬೀಳುವಂತೆ ಮಾಡುವ ಕಲ್ಲನ್ನೂ</para>
  <para style="q2" vid="ROM 9:33">ಮುಗ್ಗರಿಸುವ ಬಂಡೆಯನ್ನೂ ಇಡುತ್ತೇನೆ.</para>
  <para style="q2" vid="ROM 9:33">ಆತನ ಮೇಲೆ ನಂಬಿಕೆಯಿಡುವವನು ಆಶಾಭಂಗಪಡುವದೇ ಇಲ್ಲ.”<note caller="+" style="f"><char style="fr" closed="false">9:33 </char><char style="ft" closed="false"><char style="xt"><ref loc="ISA 8:14">ಯೆಶಾಯ 8:14</ref>; <ref loc="ISA 28:16">28:16</ref></char></char></note><verse eid="ROM 9:33"/></para>
  <chapter eid="ROM 9"/>
  <chapter number="10" style="c" sid="ROM 10"/>
  <para style="p">
    <verse number="1" style="v" sid="ROM 10:1"/>ಪ್ರಿಯರೇ, ನನ್ನ ಹೃದಯದ ಬಯಕೆಯು, ನಾನು ದೇವರಿಗೆ ಸಲ್ಲಿಸುವ ಪ್ರಾರ್ಥನೆಯು ಇಸ್ರಾಯೇಲರು ರಕ್ಷಣೆ ಹೊಂದಬೇಕೆಂಬುದೇ. <verse eid="ROM 10:1"/><verse number="2" style="v" sid="ROM 10:2"/>ಅವರು ದೇವರಿಗಾಗಿ ಆಸಕ್ತರು ಎಂಬುದಾಗಿ ನಾನು ಸಾಕ್ಷಿಕೊಡುತ್ತೇನೆ. ಆದರೆ ಅವರ ಆಸಕ್ತಿಯು ಜ್ಞಾನಕ್ಕೆ ಅನುಸಾರವಾದದ್ದು ಅಲ್ಲ. <verse eid="ROM 10:2"/><verse number="3" style="v" sid="ROM 10:3"/>ಅವರು ದೇವರಿಂದ ಬರುವ ನೀತಿಯನ್ನು ತಿಳಿಯದವರಾಗಿ ತಮ್ಮದೇ ಆದ ನೀತಿಯನ್ನು ಸ್ಥಾಪಿಸಲು ಪ್ರಯತ್ನಪಟ್ಟದ್ದರಿಂದ ಅವರು ತಮ್ಮನ್ನು ದೇವರ ನೀತಿಗೆ ಒಳಪಡಿಸಲಿಲ್ಲ. <verse eid="ROM 10:3"/><verse number="4" style="v" sid="ROM 10:4"/>ಕ್ರಿಸ್ತ ಯೇಸುವನ್ನು ನಂಬುವ ಪ್ರತಿಯೊಬ್ಬರಿಗೂ ನೀತಿಯು ದೊರಕುವಂತೆ ಕ್ರಿಸ್ತ ಯೇಸು ಮೋಶೆಯ ನಿಯಮದ ಅಂತ್ಯವಾಗಿರುತ್ತಾರೆ.<verse eid="ROM 10:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="ROM 10:5"/>ನಿಯಮದಿಂದ ಬರುವ ನೀತಿಯ ಬಗ್ಗೆ ಮೋಶೆಯು ಬರೆದಿರುವುದು ಏನೆಂದರೆ: “ನಿಯಮದಲ್ಲಿ ಬರೆದಿರುವ ಎಲ್ಲವನ್ನೂ ಮಾಡುವವರೇ ಬಾಳುವವರು,”<note caller="+" style="f"><char style="fr" closed="false">10:5 </char><char style="ft" closed="false"><char style="xt"><ref loc="LEV 18:5">ಯಾಜಕ 18:5</ref></char></char></note> ಎಂಬುದಾಗಿ ಬರೆದನು. <verse eid="ROM 10:5"/><verse number="6" style="v" sid="ROM 10:6"/>ಆದರೆ ವಿಶ್ವಾಸದಿಂದ ಬರುವ ನೀತಿಯ ಬಗ್ಗೆ ಮೋಶೆಯು ಹೇಳುವುದೇನೆಂದರೆ: “ ‘ಕ್ರಿಸ್ತನನ್ನು ಕೆಳಗೆ ತರಲು ಪರಲೋಕಕ್ಕೆ ಯಾರು ಏರಿ ಹೋಗುವರು?’<note caller="+" style="f"><char style="fr" closed="false">10:6 </char><char style="ft" closed="false"><char style="xt"><ref loc="DEU 30:12">ಧರ್ಮೋ 30:12</ref></char></char></note> <verse eid="ROM 10:6"/><verse number="7" style="v" sid="ROM 10:7"/>ಅಥವಾ, ‘ಕ್ರಿಸ್ತನನ್ನು ಸತ್ತವರೊಳಗಿಂದ ಎಬ್ಬಿಸಿಕೊಂಡು ಬರಲು ಯಾರು ಪಾತಾಳಕ್ಕೆ ಇಳಿದು ಹೋಗುವರು?’<note caller="+" style="f"><char style="fr" closed="false">10:7 </char><char style="ft" closed="false"><char style="xt"><ref loc="DEU 30:13">ಧರ್ಮೋ 30:13</ref></char></char></note> ಎಂದು ಮನಸ್ಸಿನಲ್ಲಿ ಹೇಳಿಕೊಳ್ಳಬೇಡ.” <verse eid="ROM 10:7"/><verse number="8" style="v" sid="ROM 10:8"/>ಆದರೆ ಇದು ಏನು ಹೇಳುತ್ತದೆ, “ತಕ್ಕ ವಾಕ್ಯವು ನಿನ್ನ ಬಳಿಯಲ್ಲಿ ಇದೆ, ಅದು ನಿನ್ನ ಬಾಯಿಯಲ್ಲಿಯೂ ಹೃದಯದಲ್ಲಿಯೂ ಇದೆ.”<note caller="+" style="f"><char style="fr" closed="false">10:8 </char><char style="ft" closed="false"><char style="xt"><ref loc="DEU 30:14">ಧರ್ಮೋ 30:14</ref></char></char></note> ಅದೇ ನಾವು ಸಾರುವ ವಿಶ್ವಾಸದ ವಾಕ್ಯ. <verse eid="ROM 10:8"/><verse number="9" style="v" sid="ROM 10:9"/>ನೀನು, “ಯೇಸುವೇ ಕರ್ತ,” ಎಂದು ಬಾಯಿಂದ ಅರಿಕೆಮಾಡಿ, ದೇವರು ಯೇಸುವನ್ನು ಸತ್ತವರೊಳಗಿಂದ ಎಬ್ಬಿಸಿದರೆಂದು ಹೃದಯದಲ್ಲಿ ನಂಬಿದರೆ ನೀನು ರಕ್ಷಣೆ ಹೊಂದುವೆ. <verse eid="ROM 10:9"/><verse number="10" style="v" sid="ROM 10:10"/>ನೀನು ನಿನ್ನ ಹೃದಯದಿಂದ ನಂಬಿ ನೀತಿವಂತನೆಂದು ಎಣಿಸಿಕೊಳ್ಳುವಿ ಮತ್ತು ನಿನ್ನ ಬಾಯಿಂದ ನಿನ್ನ ವಿಶ್ವಾಸವನ್ನು ಅರಿಕೆ ಮಾಡಿದಾಗ ರಕ್ಷಣೆ ಹೊಂದುತ್ತಿ. <verse eid="ROM 10:10"/><verse number="11" style="v" sid="ROM 10:11"/>ಪವಿತ್ರ ವೇದದಲ್ಲಿ ಹೇಳಿರುವಂತೆ, “ಅವರ ಮೇಲೆ ನಂಬಿಕೆಯಿಡುವ ಯಾವನಾದರೂ ಆಶಾಭಂಗಪಡುವದೇ ಇಲ್ಲ.”<note caller="+" style="f"><char style="fr" closed="false">10:11 </char><char style="ft" closed="false"><char style="xt"><ref loc="ISA 28:16">ಯೆಶಾಯ 28:16</ref></char></char></note> <verse eid="ROM 10:11"/><verse number="12" style="v" sid="ROM 10:12"/>ಈ ವಿಷಯದಲ್ಲಿ ಯೆಹೂದ್ಯರಿಗೂ ಯೆಹೂದ್ಯರಲ್ಲದವರಿಗೂ ಯಾವ ವ್ಯತ್ಯಾಸವೂ ಇಲ್ಲ. ಎಲ್ಲರಿಗೂ ಕರ್ತ ಆಗಿರುವ ಒಬ್ಬರೇ ಕರ್ತ; ಅವರು ತಮ್ಮನ್ನು ಕರೆಯುವವರೆಲ್ಲರನ್ನು ಹೇರಳವಾಗಿ ಆಶೀರ್ವದಿಸುತ್ತಾರೆ. <verse eid="ROM 10:12"/><verse number="13" style="v" sid="ROM 10:13"/>ಏಕೆಂದರೆ, “ಕರ್ತನ ಹೆಸರನ್ನು ಕರೆಯುವವರೆಲ್ಲರಿಗೆ ರಕ್ಷಣೆ ಆಗುವುದು.”<note caller="+" style="f"><char style="fr" closed="false">10:13 </char><char style="ft" closed="false"><char style="xt"><ref loc="JOL 2:32">ಯೋಯೇಲ 2:32</ref></char></char></note><verse eid="ROM 10:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="ROM 10:14"/>ಆದರೆ, ತಾವು ವಿಶ್ವಾಸವಿಡದ ಕರ್ತನನ್ನು ಕರೆಯುವುದಾದರೂ ಹೇಗೆ? ತಾವು ಕೇಳದ ಕರ್ತನ ಬಗ್ಗೆ ಅವರು ವಿಶ್ವಾಸವಿಡುವುದು ಹೇಗೆ? ಕರ್ತನ ಬಗ್ಗೆ ಸಾರುವವನಿಲ್ಲದೆ ಅವರು ಕೇಳುವುದಾದರೂ ಹೇಗೆ? <verse eid="ROM 10:14"/><verse number="15" style="v" sid="ROM 10:15"/>ಅವರು ಕಳುಹಿಸದ ಹೊರತು ಸಾರುವುದಾದರೂ ಹೇಗೆ? ಆದ್ದರಿಂದಲೇ, “ಶುಭವರ್ತಮಾನವನ್ನು ಸಾರುವವರ ಪಾದಗಳು ಎಷ್ಟೊಂದು ಅಂದವಾಗಿವೆ!”<note caller="+" style="f"><char style="fr" closed="false">10:15 </char><char style="ft" closed="false"><char style="xt"><ref loc="ISA 52:7">ಯೆಶಾಯ 52:7</ref></char></char></note> ಎಂದು ಬರೆಯಲಾಗಿದೆ.<verse eid="ROM 10:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="ROM 10:16"/>ಆದರೆ ಇಸ್ರಾಯೇಲರಲ್ಲಿ ಎಲ್ಲರೂ ಸುವಾರ್ತೆಯನ್ನು ಸ್ವೀಕರಿಸಲಿಲ್ಲ. ಏಕೆಂದರೆ, “ಕರ್ತನೇ, ನಮ್ಮ ಸಂದೇಶವನ್ನು ಯಾರು ನಂಬಿದರು?”<note caller="+" style="f"><char style="fr" closed="false">10:16 </char><char style="ft" closed="false"><char style="xt"><ref loc="ISA 53:1">ಯೆಶಾಯ 53:1</ref></char></char></note> ಎಂದು ಯೆಶಾಯ ಪ್ರವಾದಿಯು ಹೇಳುತ್ತಾನೆ. <verse eid="ROM 10:16"/><verse number="17" style="v" sid="ROM 10:17"/>ಆದಕಾರಣ, ತಕ್ಕ ವಾಕ್ಯವನ್ನು ಕೇಳುವುದರಿಂದಲೇ ವಿಶ್ವಾಸವು ಬರುತ್ತದೆ, ಅದು ಕ್ರಿಸ್ತನ ವಾಕ್ಯವನ್ನು ಕೇಳುವುದರಿಂದಲೇ ಬರುತ್ತದೆ. <verse eid="ROM 10:17"/><verse number="18" style="v" sid="ROM 10:18"/>ಆದರೆ ಇಸ್ರಾಯೇಲರು ಎಂದೂ ಸುವಾರ್ತೆಯನ್ನು ಕೇಳಲಿಲ್ಲವೋ ಎಂದು ನಾನು ಪ್ರಶ್ನಿಸುತ್ತೇನೆ? ಅವರು ನಿಶ್ಚಯವಾಗಿ ಕೇಳಿದ್ದಾರೆ. ಪವಿತ್ರ ವೇದದಲ್ಲಿ ಹೇಳಿರುವಂತೆ:</para>
  <para style="q1" vid="ROM 10:18">“ಅವರ ಸ್ವರವು ಭೂಮಿಯ ಎಲ್ಲಾ ಕಡೆಗಳಲ್ಲಿ ಹೋಗಿರುತ್ತದೆ,</para>
  <para style="q2" vid="ROM 10:18">ಅವರ ನುಡಿಗಳು ಲೋಕದ ಕಟ್ಟಕಡೆಯವರೆಗೂ ವ್ಯಾಪಿಸಿವೆ.”<note caller="+" style="f"><char style="fr" closed="false">10:18 </char><char style="ft" closed="false"><char style="xt"><ref loc="PSA 19:4">ಕೀರ್ತನೆ 19:4</ref></char></char></note><verse eid="ROM 10:18"/></para>
  <para style="m">
    <verse number="19" style="v" sid="ROM 10:19"/>ಆದರೆ ಇಸ್ರಾಯೇಲರಿಗೆ ಅರ್ಥವಾಗಲಿಲ್ಲವೇ? ಎಂದು ನಾನು ಪ್ರಶ್ನಿಸುತ್ತೇನೆ. ಮೊದಲನೆಯದಾಗಿ ಮೋಶೆಯು,</para>
  <para style="q1" vid="ROM 10:19">“ನಾನು ಜನಾಂಗವಲ್ಲದವರ ಮೂಲಕ ನೀವು ಅಸೂಯೆಪಡುವಂತೆ ಮಾಡುವೆನು.</para>
  <para style="q2" vid="ROM 10:19">ತಿಳುವಳಿಕೆಯಿಲ್ಲದ ಜನಾಂಗದವರ ಮೂಲಕ ನೀವು ಕೋಪಗೊಳ್ಳುವಂತೆ ಮಾಡುವೆನು,”<note caller="+" style="f"><char style="fr" closed="false">10:19 </char><char style="ft" closed="false"><char style="xt"><ref loc="DEU 32:21">ಧರ್ಮೋ 32:21</ref></char></char></note></para>
  <para style="m" vid="ROM 10:19">ಎಂದು ಹೇಳುತ್ತಾನೆ. <verse eid="ROM 10:19"/><verse number="20" style="v" sid="ROM 10:20"/>ಆದರೆ ಯೆಶಾಯನು ಬಹು ಧೈರ್ಯವಾಗಿ,</para>
  <para style="q1" vid="ROM 10:20">“ನನ್ನನ್ನು ಹುಡುಕದವರಿಗೆ ನಾನು ಸಿಕ್ಕಿದೆನು.</para>
  <para style="q2" vid="ROM 10:20">ನನ್ನ ವಿಷಯವಾಗಿ ವಿಚಾರ ಮಾಡದವರಿಗೂ ಪ್ರತ್ಯಕ್ಷನಾದೆನು,”<note caller="+" style="f"><char style="fr" closed="false">10:20 </char><char style="ft" closed="false"><char style="xt"><ref loc="ISA 65:1">ಯೆಶಾಯ 65:1</ref></char></char></note></para>
  <para style="m" vid="ROM 10:20">ಎಂದು ಹೇಳುತ್ತಾನೆ. <verse eid="ROM 10:20"/><verse number="21" style="v" sid="ROM 10:21"/>ಆದರೆ ಇಸ್ರಾಯೇಲರ ಕುರಿತಾಗಿ,</para>
  <para style="q1" vid="ROM 10:21">“ನನಗೆ ಅವಿಧೇಯರೂ ಎದುರುಮಾತಾಡುವವರೂ ಆಗಿರುವ ಜನರಿಗೆ,</para>
  <para style="q2" vid="ROM 10:21">ದಿನವೆಲ್ಲಾ ನಾನು ಕೈಚಾಚಿ ಕರೆದೆನು,”<note caller="+" style="f"><char style="fr" closed="false">10:21 </char><char style="ft" closed="false"><char style="xt"><ref loc="ISA 65:2">ಯೆಶಾಯ 65:2</ref></char></char></note></para>
  <para style="m" vid="ROM 10:21">ಎಂದು ಹೇಳುತ್ತಾನೆ.<verse eid="ROM 10:21"/></para>
  <chapter eid="ROM 10"/>
  <chapter number="11" style="c" sid="ROM 11"/>
  <para style="s1">ಇಸ್ರಾಯೇಲಿನಲ್ಲಿ ಉಳಿದವರು</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 11:1"/>ಹಾಗಾದರೆ, ದೇವರು ತಮ್ಮ ಜನರನ್ನು ತ್ಯಜಿಸಿಬಿಟ್ಟಿದ್ದಾರೋ ಎಂದು ಕೇಳುತ್ತೇನೆ? ಎಂದಿಗೂ ಇಲ್ಲ. ನಾನು ಸಹ ಇಸ್ರಾಯೇಲನೂ ಅಬ್ರಹಾಮನ ವಂಶದವನೂ ಬೆನ್ಯಾಮೀನನ ಕುಲದವನೂ ಆಗಿದ್ದೇನೆ. <verse eid="ROM 11:1"/><verse number="2" style="v" sid="ROM 11:2"/>ದೇವರು ತಾವು ಮುಂದಾಗಿ ತಿಳಿದುಕೊಂಡ ತಮ್ಮ ಜನರನ್ನು ತ್ಯಜಿಸಲಿಲ್ಲ. ದೇವರ ವಾಕ್ಯವು ಎಲೀಯನನ್ನು ಕುರಿತು ಏನು ಹೇಳುತ್ತದೆಂದು ನಿಮಗೆ ಗೊತ್ತಿಲ್ಲವೋ? <verse eid="ROM 11:2"/><verse number="3" style="v" sid="ROM 11:3"/>“ಕರ್ತಾ, ಅವರು ನಿಮ್ಮ ಪ್ರವಾದಿಗಳನ್ನು ಕೊಂದಿದ್ದಾರೆ. ನಿಮ್ಮ ಬಲಿಪೀಠವನ್ನು ಒಡೆದುಹಾಕಿದ್ದಾರೆ, ನಾನು ಒಬ್ಬನೇ ಉಳಿದಿದ್ದೇನೆ. ಅವರು ನನ್ನನ್ನು ಕೊಲ್ಲಲು ಪ್ರಯತ್ನಿಸುತ್ತಿದ್ದಾರೆ,”<note caller="+" style="f"><char style="fr" closed="false">11:3 </char><char style="ft" closed="false"><char style="xt"><ref loc="1KI 19:10">1 ಅರಸು 19:10</ref>,<ref loc="1KI 19:14">14</ref></char></char></note> ಎಂದು ಇಸ್ರಾಯೇಲರಿಗೆ ವಿರೋಧವಾಗಿ ದೇವರಲ್ಲಿ ವಿಜ್ಞಾಪನೆ ಮಾಡಿಕೊಂಡನು. <verse eid="ROM 11:3"/><verse number="4" style="v" sid="ROM 11:4"/>ಅದಕ್ಕೆ ದೇವರು ಅವನಿಗೆ ಕೊಟ್ಟ ಉತ್ತರವೇನಾಗಿತ್ತು? “ಬಾಳನಿಗೆ ಅಡ್ಡಬೀಳದ ಏಳು ಸಾವಿರ ಮಂದಿಯನ್ನು ನನಗೋಸ್ಕರ ಉಳಿಸಿದ್ದೇನೆ,”<note caller="+" style="f"><char style="fr" closed="false">11:4 </char><char style="ft" closed="false"><char style="xt"><ref loc="1KI 19:18">1 ಅರಸು 19:18</ref></char></char></note> ಎಂದಲ್ಲವೇ? <verse eid="ROM 11:4"/><verse number="5" style="v" sid="ROM 11:5"/>ಅದೇ ರೀತಿಯಲ್ಲಿ, ಈ ಕಾಲದಲ್ಲಿಯೂ ಕೃಪೆಯಿಂದ ಆಯ್ಕೆಯಾದ ಇಸ್ರಾಯೇಲರಲ್ಲಿ ಕೆಲವರು ಉಳಿದಿದ್ದಾರೆ. <verse eid="ROM 11:5"/><verse number="6" style="v" sid="ROM 11:6"/>ಆ ಆಯ್ಕೆಯು ಕ್ರಿಯೆಗಳ ಆಧಾರದಿಂದಲ್ಲ, ಕೃಪೆಯಿಂದಲೇ ಆಗಿರುತ್ತದೆ. ಕ್ರಿಯೆಗಳಿಂದ ಅದು ಆಗಿದ್ದರೆ ಇನ್ನೆಂದಿಗೂ ಕೃಪೆಯಾಗಲಾರದು.<verse eid="ROM 11:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="ROM 11:7"/>ಹಾಗಾದರೆ ಏನು? ಇಸ್ರಾಯೇಲ್ ಹುಡುಕಿದ್ದನ್ನು ಹೊಂದಲಿಲ್ಲ. ಆದರೆ ಅವರಲ್ಲಿ ಆಯ್ಕೆಯಾದವರು ಹೊಂದಿದರು, ಮಿಕ್ಕವರು ಕಠಿಣ ಹೃದಯಿಗಳಾದರು. <verse eid="ROM 11:7"/><verse number="8" style="v" sid="ROM 11:8"/>ಪವಿತ್ರ ವೇದದಲ್ಲಿ ಬರೆದಿರುವಂತೆ,</para>
  <para style="q1" vid="ROM 11:8">“ದೇವರು ಅವರಿಗೆ ಜಡಸ್ವಭಾವದ ಆತ್ಮವನ್ನು,</para>
  <para style="q2" vid="ROM 11:8">ಕಾಣಲಾರದ ಕಣ್ಣನ್ನು</para>
  <para style="q2" vid="ROM 11:8">ಮತ್ತು ಕೇಳಲಾರದ ಕಿವಿಯನ್ನು ಕೊಟ್ಟರು,</para>
  <para style="q1" vid="ROM 11:8">ಅದು ಇಂದಿನವರೆಗೂ ಹಾಗೆಯೇ ಇದೆ.”<note caller="+" style="f"><char style="fr" closed="false">11:8 </char><char style="ft" closed="false"><char style="xt"><ref loc="DEU 29:4">ಧರ್ಮೋ 29:4</ref>; <ref loc="ISA 29:10">ಯೆಶಾಯ 29:10</ref></char></char></note><verse eid="ROM 11:8"/></para>
  <para style="m">
    <verse number="9" style="v" sid="ROM 11:9"/>ದಾವೀದನು,</para>
  <para style="q1" vid="ROM 11:9">“ಅವರ ಊಟವೇ ಅವರಿಗೆ ಉರುಲೂ ಬೋನೂ ಆಗಲಿ.</para>
  <para style="q2" vid="ROM 11:9">ಅದು ಅಡೆತಡೆಯೂ ಪ್ರತಿಕಾರವೂ ಆಗಲಿ.<verse eid="ROM 11:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="ROM 11:10"/>ಅವರ ಕಣ್ಣುಗಳು ಕಾಣದ ಹಾಗೆ ಕತ್ತಲಾಗಲಿ.</para>
  <para style="q2" vid="ROM 11:10">ಮತ್ತು ಅವರ ಬೆನ್ನು ಎಂದೆಂದಿಗೂ ಬಗ್ಗಿ ಹೋಗಲಿ,”<note caller="+" style="f"><char style="fr" closed="false">11:10 </char><char style="ft" closed="false"><char style="xt"><ref loc="PSA 69:22">ಕೀರ್ತನೆ 69:22</ref>,<ref loc="PSA 69:23">23</ref></char></char></note></para>
  <para style="m" vid="ROM 11:10">ಎಂದು ಹೇಳುತ್ತಾನೆ.<verse eid="ROM 11:10"/></para>
  <para style="s1">ಕಸಿಕಟ್ಟಿದ ಕೊಂಬೆಗಳು</para>
  <para style="p">
    <verse number="11" style="v" sid="ROM 11:11"/>ಇಸ್ರಾಯೇಲರು ಏಳಲಾರದ ಹಾಗೇ ಎಡವಿದರೋ? ಎಂದು ನಾನು ಕೇಳುತ್ತೇನೆ. ಇಲ್ಲವೇ ಇಲ್ಲ! ಆದರೆ, ಇಸ್ರಾಯೇಲರಲ್ಲಿ ಮತ್ಸರ ಉಂಟಾಗುವಂತೆ ಅವರ ಅಪರಾಧದ ನಿಮಿತ್ತ ಯೆಹೂದ್ಯರಲ್ಲದವರಿಗೆ ರಕ್ಷಣೆಯು ಉಂಟಾಯಿತು. <verse eid="ROM 11:11"/><verse number="12" style="v" sid="ROM 11:12"/>ಆದರೆ ಅವರ ಅಪರಾಧವು ಜಗತ್ತಿಗೆ ಐಶ್ವರ್ಯವನ್ನು ಉಂಟುಮಾಡಿತು. ಅವರ ನಷ್ಟವೇ ಯೆಹೂದ್ಯರಲ್ಲದವರಿಗೆ ಐಶ್ವರ್ಯವನ್ನು ಉಂಟುಮಾಡುವುದಾದರೆ, ಅವರ ಪರಿಪೂರ್ಣತೆಯು ಇನ್ನೂ ಎಷ್ಟೋ ಹೆಚ್ಚಾದ ಐಶ್ವರ್ಯವನ್ನು ಉಂಟುಮಾಡಬಹುದಲ್ಲವೇ!<verse eid="ROM 11:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="ROM 11:13"/>ಯೆಹೂದ್ಯರಲ್ಲದವರಾಗಿರುವ ನಿಮ್ಮೊಂದಿಗೆ ಮಾತನಾಡುತ್ತಿದ್ದೇನೆ. ನಾನು ಯೆಹೂದ್ಯರಲ್ಲದವರಿಗೆ ಅಪೊಸ್ತಲನಾಗಿರುವಷ್ಟರ ಮಟ್ಟಿಗೆ ನನ್ನ ಸೇವೆಯನ್ನು ಪ್ರಭಾವಗೊಳಿಸುತ್ತೇನೆ. <verse eid="ROM 11:13"/><verse number="14" style="v" sid="ROM 11:14"/>ಹೇಗೂ ನಾನು ನನ್ನ ಸ್ವಂತ ಜನರಾದ ಯೆಹೂದ್ಯರಲ್ಲಿ ಮತ್ಸರವನ್ನು ಉದ್ರೇಕಿಸಿ ಅವರಲ್ಲಿ ಕೆಲವರನ್ನಾದರೂ ರಕ್ಷಿಸಬೇಕು. <verse eid="ROM 11:14"/><verse number="15" style="v" sid="ROM 11:15"/>ಏಕೆಂದರೆ ಇಸ್ರಾಯೇಲರನ್ನು ತ್ಯಜಿಸುವುದರಿಂದ ಜಗತ್ತು ದೇವರೊಡನೆ ಸಂಧಾನವಾಗುವುದಾದರೆ, ಅವರನ್ನು ಸ್ವೀಕರಿಸುವುದು, ಸತ್ತವರು ಜೀವಿತರಾಗಿ ಎದ್ದು ಬಂದಂತಾಗಿರುವುದಲ್ಲವೇ? <verse eid="ROM 11:15"/><verse number="16" style="v" sid="ROM 11:16"/>ಪ್ರಥಮಫಲವಾಗಿ ಹಿಟ್ಟಿನಲ್ಲಿ ದೇವರಿಗೆ ಭಾಗವನ್ನು ಸಮರ್ಪಿಸಿದ್ದು ಪವಿತ್ರವಾಗಿದ್ದರೆ, ಹಿಟ್ಟೆಲ್ಲಾ ಪವಿತ್ರವಾಗಿರುತ್ತದೆ. ಬೇರು ಪವಿತ್ರವಾಗಿದ್ದರೆ, ಕೊಂಬೆಗಳೂ ಪವಿತ್ರವಾಗಿರುತ್ತವೆ?<verse eid="ROM 11:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="ROM 11:17"/>ಕೆಲವು ಕೊಂಬೆಗಳು ಮುರಿದುಹೋಗಿರುವುದಾದರೆ, ಕಾಡು ಓಲಿವ್ ಮರದಂತಿರುವ ನೀನು ಅವುಗಳ ನಡುವೆ ಕಸಿಮಾಡಿ ಉತ್ತಮ ಓಲಿವ್ ಮರದ ರಸವತ್ತಾದ ಬೇರಿನಲ್ಲಿ ಪಾಲುಹೊಂದಿರಲಾಗಿ, <verse eid="ROM 11:17"/><verse number="18" style="v" sid="ROM 11:18"/>ಆ ಕೊಂಬೆಗಳನ್ನು ಕಡೆಗಣಿಸಿ ನಿನ್ನನ್ನು ಹೆಚ್ಚಿಸಿಕೊಳ್ಳಬೇಡ. ಹೆಚ್ಚಿಸಿಕೊಂಡರೆ, ನೀನು ಆ ಬೇರಿನ ಆಧಾರವಲ್ಲ. ಆ ಬೇರೇ ನಿನಗೆ ಆಧಾರವಾಗಿದೆ. <verse eid="ROM 11:18"/><verse number="19" style="v" sid="ROM 11:19"/>ಹಾಗಾದರೆ ನೀನು, “ನಾನು ಕಸಿಕಟ್ಟಿಸಿಕೊಳ್ಳಬೇಕೆಂದು ಆ ಕೊಂಬೆಗಳನ್ನು ಮುರಿದು ಹಾಕಲಾಯಿತು,” ಎಂದು ನೀನು ಹೇಳಬಹುದು. <verse eid="ROM 11:19"/><verse number="20" style="v" sid="ROM 11:20"/>ಅದು ನಿಜವೆ, ಆದರೆ ಅವರ ಅವಿಶ್ವಾಸದಿಂದಲೇ ಅವರನ್ನು ಮುರಿದು ಹಾಕಲಾಯಿತು. ನೀನಾದರೋ ವಿಶ್ವಾಸದಿಂದಲೇ ಇನ್ನೂ ನಿಂತಿರುವೆ. ಗರ್ವಪಡದೆ ಭಯದಿಂದಿರು. <verse eid="ROM 11:20"/><verse number="21" style="v" sid="ROM 11:21"/>ಏಕೆಂದರೆ ದೇವರು ಹುಟ್ಟು ಕೊಂಬೆಗಳನ್ನು ಉಳಿಸದಿದ್ದ ಮೇಲೆ ನಿನ್ನನ್ನೂ ಉಳಿಸುವುದಿಲ್ಲ.<verse eid="ROM 11:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="ROM 11:22"/>ಆದ್ದರಿಂದ, ದೇವರ ದಯೆಯನ್ನೂ ಕಾಠಿಣ್ಯವನ್ನೂ ನೋಡು. ಬಿದ್ದವರ ಕಡೆಗೆ ಅವರ ಕಾಠಿಣ್ಯವಿದೆ, ನೀನು ದೇವರ ದಯೆಯಲ್ಲಿಯೇ ಮುಂದುವರಿಯುವುದಾದರೆ ನಿನ್ನ ಮೇಲೆ ದೇವರ ದಯೆಯಿರುವುದು. ಇಲ್ಲದೆ ಹೋದರೆ, ನೀನು ಕೂಡ ಕಡಿದುಹಾಕಲಾಗುವೆ. <verse eid="ROM 11:22"/><verse number="23" style="v" sid="ROM 11:23"/>ಇಸ್ರಾಯೇಲರು ಕೂಡ ಇನ್ನೂ ಅವಿಶ್ವಾಸದಲ್ಲಿ ಮುಂದುವರಿಯದಿದ್ದರೆ, ಕಸಿಕಟ್ಟಲಾಗುವರು, ಏಕೆಂದರೆ ಅವರನ್ನು ಪುನಃ ಕಸಿಕಟ್ಟಲು ದೇವರು ಶಕ್ತರಾಗಿರುತ್ತಾರೆ. <verse eid="ROM 11:23"/><verse number="24" style="v" sid="ROM 11:24"/>ಎಷ್ಟಾದರೂ ಕಾಡು ಓಲಿವ್ ಮರದಿಂದ ನೀನು ಕಡಿದುಹಾಕಲಾದ ಕೊಂಬೆ. ನೀನು ನೆಟ್ಟು ಬೆಳೆಸಿರುವ ಉತ್ತಮ ಓಲಿವ್ ಮರಕ್ಕೆ ಅಸ್ವಾಭಾವಿಕವಾಗಿ ಕಸಿಮಾಡುವುದಾದರೆ ಸ್ವಾಭಾವಿಕವಾಗಿರುವ ಈ ಕೊಂಬೆಗಳನ್ನು ಎಷ್ಟೋ ಹೆಚ್ಚಾಗಿ ಓಲಿವ್ ಮರಕ್ಕೆ ಅದೇ ಕಸಿಕಟ್ಟುವುದು ಸುಲಭವಲ್ಲವೇ?<verse eid="ROM 11:24"/></para>
  <para style="s1">ಎಲ್ಲಾ ಇಸ್ರಾಯೇಲರಿಗೆ ರಕ್ಷಣೆ</para>
  <para style="p">
    <verse number="25" style="v" sid="ROM 11:25"/>ಪ್ರಿಯರೇ, ನೀವು ಈ ಮರ್ಮದ ಬಗ್ಗೆ ಅಜ್ಞಾನಿಗಳಾಗಿರಬೇಕೆಂದು ನಾನು ಬಯಸುವುದಿಲ್ಲ. ಅದೇನೆಂದರೆ, ಯೆಹೂದ್ಯರಲ್ಲದವರು ಪೂರ್ಣಸಂಖ್ಯೆಯಲ್ಲಿ ದೇವರ ಬಳಿಗೆ ಬರುವವರೆಗೆ ಮಾತ್ರ ಇಸ್ರಾಯೇಲರು ತಮ್ಮ ಹೃದಯದ ಕಾಠಿಣ್ಯಕ್ಕೆ ತಾತ್ಕಾಲಿಕವಾಗಿ ಒಳಗಾಗಿರುವರು. <verse eid="ROM 11:25"/><verse number="26" style="v" sid="ROM 11:26"/>ಹೀಗೆ ಪವಿತ್ರ ವೇದದಲ್ಲಿ ಬರೆದಿರುವಂತೆ, ಇಸ್ರಾಯೇಲ್ ಜನರೆಲ್ಲಾ ರಕ್ಷಣೆಹೊಂದುವರು:</para>
  <para style="q1" vid="ROM 11:26">“ವಿಮೋಚಿಸುವವರು ಒಬ್ಬರು ಚೀಯೋನಿನಿಂದ<note caller="+" style="f"><char style="fr" closed="false">11:26 </char><char style="fqa" closed="false">ಯೆರೂಸಲೇಮಿನ </char><char style="ft" closed="false">ಇನ್ನೊಂದು ಹೆಸರು</char></note> ಬರುತ್ತಾರೆ,</para>
  <para style="q2" vid="ROM 11:26">ಅವರು ಯಾಕೋಬನ<note caller="+" style="f"><char style="fr" closed="false">11:26 </char><char style="ft" closed="false">ಇಸ್ರಾಯೇಲ್ ದೇಶದಿಂದ</char></note> ಸಂತತಿಯಲ್ಲಿ ದೇವರನ್ನು ಅಲ್ಲಗಳೆಯುವ ಸ್ವಭಾವನ್ನು ತಾವೇ ತೆಗೆದುಹಾಕುವರು.<verse eid="ROM 11:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="ROM 11:27"/>ನಾನು ಅವರ ಪಾಪಗಳನ್ನು ತೆಗೆದುಹಾಕುವಾಗ,</para>
  <para style="q2" vid="ROM 11:27">ಅವರೊಂದಿಗೆ ನಾನು ಮಾಡಿಕೊಳ್ಳುವ ಒಡಂಬಡಿಕೆ ಇದೇ ಎಂದು ತಿಳಿದುಕೊಳ್ಳುವೆನು,”<note caller="+" style="f"><char style="fr" closed="false">11:27 </char><char style="ft" closed="false"><char style="xt"><ref loc="ISA 59:20">ಯೆಶಾಯ 59:20</ref>,<ref loc="ISA 59:21">21</ref>; <ref loc="ISA 27:9">27:9</ref>; <ref loc="JER 31:33">ಯೆರೆ 31:33</ref>,<ref loc="JER 31:34">34</ref></char></char></note></para>
  <para style="m" vid="ROM 11:27">ಎಂಬುದೇ.<verse eid="ROM 11:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="ROM 11:28"/>ಸುವಾರ್ತೆಯ ಪ್ರಕಾರ ಇಸ್ರಾಯೇಲರು ಈಗ ನಿಮ್ಮ ನಿಮಿತ್ತ ಶತ್ರುಗಳು. ಆದರೆ ದೇವರ ಆಯ್ಕೆಯ ದೃಷ್ಟಿಯಲ್ಲಿ ನೋಡುವಾಗ ಮೂಲಪಿತೃಗಳ ನಿಮಿತ್ತದಿಂದ ಅವರು ಪ್ರೀತಿಹೊಂದಿದವರು. <verse eid="ROM 11:28"/><verse number="29" style="v" sid="ROM 11:29"/>ದೇವರು ಕೊಡುವ ವರಗಳನ್ನು, ಕರೆಗಳನ್ನು ಅವರು ಎಂದಿಗೂ ಹಿಂತೆಗೆದುಕೊಳ್ಳುವವರಲ್ಲ. <verse eid="ROM 11:29"/><verse number="30" style="v" sid="ROM 11:30"/>ಒಂದು ಕಾಲದಲ್ಲಿ ದೇವರಿಗೆ ಅವಿಧೇಯರಾಗಿದ್ದ ನೀವು ಇಸ್ರಾಯೇಲರ ಅವಿಧೇಯತೆಯಿಂದ ಈಗ ಕರುಣೆಯನ್ನು ಹೊಂದಿರುವಿರಿ. <verse eid="ROM 11:30"/><verse number="31" style="v" sid="ROM 11:31"/>ಅದೇ ಪ್ರಕಾರವಾಗಿ ಇಸ್ರಾಯೇಲರು ಈಗ ಅವಿಧೇಯರಾಗಿದ್ದರೂ ನಿಮಗೆ ಕರುಣೆ ದೊರಕಿದಂತೆ, ಅವರಿಗೂ ಈಗ ಕರುಣೆ ದೊರಕುವುದು. <verse eid="ROM 11:31"/><verse number="32" style="v" sid="ROM 11:32"/>ದೇವರು ತಾವು ಎಲ್ಲರಿಗೂ ಕರುಣೆ ತೋರಿಸುವುದಕ್ಕಾಗಿ ಎಲ್ಲರನ್ನೂ ಅವಿಧೇಯತೆಯಲ್ಲಿ ಕಟ್ಟಿಹಾಕಿರುತ್ತಾರೆ.<verse eid="ROM 11:32"/></para>
  <para style="s1">ದೇವಸ್ತುತಿ</para>
  <para style="q1">
    <verse number="33" style="v" sid="ROM 11:33"/>ಆಹಾ! ದೇವರ ಐಶ್ವರ್ಯ, ಜ್ಞಾನ ಮತ್ತು ವಿವೇಕಗಳು ಎಷ್ಟು ಆಳವಾದವುಗಳು!</para>
  <para style="q2" vid="ROM 11:33">ದೇವರ ತೀರ್ಮಾನಗಳು ಪರೀಶೀಲಿಸಲು ಅಸಾಧ್ಯವಾದದ್ದು!</para>
  <para style="q2" vid="ROM 11:33">ದೇವರ ಮಾರ್ಗಗಳನ್ನು ಕಂಡುಹಿಡಿಯುವುದು ಅಪರಿಮಿತವಾದದ್ದು!<verse eid="ROM 11:33"/></para>
  <para style="q1">
    <verse number="34" style="v" sid="ROM 11:34"/>“ಕರ್ತದೇವರ ಮನಸ್ಸನ್ನು ಅರಿತವರು ಯಾರು?</para>
  <para style="q2" vid="ROM 11:34">ಅವರಿಗೆ ಆಲೋಚನೆಯನ್ನು ನೀಡುವವರು ಯಾರು?”<note caller="+" style="f"><char style="fr" closed="false">11:34 </char><char style="ft" closed="false"><char style="xt"><ref loc="ISA 40:13">ಯೆಶಾಯ 40:13</ref></char></char></note><verse eid="ROM 11:34"/></para>
  <para style="q1">
    <verse number="35" style="v" sid="ROM 11:35"/>“ದೇವರಿಗೆ ಮೊದಲು ಕೊಟ್ಟು,</para>
  <para style="q2" vid="ROM 11:35">ಅವರಿಂದ ಪ್ರತಿಫಲವನ್ನು ಪಡೆಯುವವರು ಯಾರು?”<note caller="+" style="f"><char style="fr" closed="false">11:35 </char><char style="ft" closed="false"><char style="xt"><ref loc="JOB 41:11">ಯೋಬ 41:11</ref></char></char></note><verse eid="ROM 11:35"/></para>
  <para style="q1">
    <verse number="36" style="v" sid="ROM 11:36"/>ಏಕೆಂದರೆ ಸಮಸ್ತವೂ ದೇವರಿಂದ ಉಂಟಾಗಿ ದೇವರ ಮೂಲಕವಾಗಿಯೂ ದೇವರಿಗಾಗಿಯೂ ಇರುತ್ತವೆ.</para>
  <para style="q2" vid="ROM 11:36">ಮಹಿಮೆಯು ಸದಾಕಾಲವೂ ದೇವರಿಗೇ ಸಲ್ಲುವುದಾಗಿರಲಿ. ಆಮೆನ್.<verse eid="ROM 11:36"/></para>
  <chapter eid="ROM 11"/>
  <chapter number="12" style="c" sid="ROM 12"/>
  <para style="s1">ಸಜೀವ ಯಜ್ಞಗಳು</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 12:1"/>ಆದ್ದರಿಂದ, ಪ್ರಿಯರೇ ದೇವರ ಕರುಣೆಯಿಂದ ಬೇಡಿಕೊಳ್ಳುವುದೇನೆಂದರೆ, ನೀವು ನಿಮ್ಮ ದೇಹಗಳನ್ನು ದೇವರಿಗೆ ಪರಿಶುದ್ಧವೂ ಮೆಚ್ಚುಗೆಯೂ ಆಗಿರುವ ಸಜೀವ ಯಜ್ಞವಾಗಿ ಸಮರ್ಪಿಸಿರಿ. ಇದೇ ನಿಮ್ಮ ವಿವೇಕ ಪೂರ್ವಕವಾದ ಆರಾಧನೆಯು. <verse eid="ROM 12:1"/><verse number="2" style="v" sid="ROM 12:2"/>ಈ ಲೋಕದ ನಡುವಳಿಕೆಯನ್ನು ಹೊಂದಿಕೊಳ್ಳದೇ, ನಿಮ್ಮ ಮನಸ್ಸನ್ನು ರೂಪಾಂತರಿಸಿಕೊಂಡು ನವೀಕರಿಸಿಕೊಳ್ಳಿರಿ. ಆಗ ನೀವು ಉತ್ತಮವಾದ, ಮೆಚ್ಚುಗೆಯಾಗಿರುವಂಥ ಮತ್ತು ಪರಿಪೂರ್ಣವಾದ ದೇವರ ಚಿತ್ತ ಯಾವುದು ಎಂಬುದನ್ನು ತಿಳಿದುಕೊಳ್ಳುವಿರಿ.<verse eid="ROM 12:2"/></para>
  <para style="s1">ಕ್ರಿಸ್ತನ ದೇಹದಲ್ಲಿನ ದೀನಸೇವೆ</para>
  <para style="p">
    <verse number="3" style="v" sid="ROM 12:3"/>ನನಗೆ ದಯಪಾಲಿಸಿರುವ ಕೃಪೆಯಿಂದ ನಿಮ್ಮಲ್ಲಿ ಪ್ರತಿಯೊಬ್ಬರಿಗೂ ನಾನು ಹೇಳುವುದೇನೆಂದರೆ, ನೀವು ಭಾವಿಸುವುದಕ್ಕಿಂತ ಹೆಚ್ಚಾಗಿ ಯಾರೂ ನಿಮ್ಮನ್ನು ನೀವೇ ಉನ್ನತವಾಗಿ ಭಾವಿಸಿಕೊಳ್ಳಬೇಡಿರಿ. ಅದರ ಬದಲಾಗಿ ದೇವರು ನಿಮಗೆ ಅನುಗ್ರಹಿಸಿರುವ ವಿಶ್ವಾಸದ ಅಳತೆಗೆ ಅನುಸಾರವಾಗಿ ಸ್ವಸ್ಥಚಿತ್ತವುಳ್ಳವರಾಗಿ ಭಾವಿಸಿಕೊಳ್ಳಿರಿ. <verse eid="ROM 12:3"/><verse number="4" style="v" sid="ROM 12:4"/>ನಮ್ಮಲ್ಲಿ ಪ್ರತಿಯೊಬ್ಬನಿಗೂ ಅನೇಕ ಅಂಗಗಳಿಂದ ಕೂಡಿದ ಒಂದು ದೇಹವಿರುವ ಹಾಗೆಯೇ ಮತ್ತು ಹೇಗೆ ಈ ಅಂಗಾಂಗಗಳಿಗೆಲ್ಲಾ ಒಂದೇ ಕೆಲಸವಿರುವುದ್ಲಿಲವೋ, <verse eid="ROM 12:4"/><verse number="5" style="v" sid="ROM 12:5"/>ಅದೇ ರೀತಿಯಲ್ಲಿ, ಅನೇಕರಾಗಿರುವ ನಾವು ಕ್ರಿಸ್ತನಲ್ಲಿ ಒಂದೇ ದೇಹವಾಗುತ್ತೇವೆ ಮತ್ತು ಪ್ರತಿಯೊಬ್ಬನೂ ಒಬ್ಬರಿಗೊಬ್ಬರು ಅಂಗಗಳಾಗಿರುತ್ತೇವೆ. <verse eid="ROM 12:5"/><verse number="6" style="v" sid="ROM 12:6"/>ನಮಗೆ ಕೊಟ್ಟಿರುವ ದೇವರ ಕೃಪೆಗೆ ಅನುಸಾರವಾಗಿ ನಮಗೆ ಬೇರೆ ಬೇರೆ ವರಗಳಿರುತ್ತವೆ. ಒಬ್ಬನಿಗೆ ಪ್ರವಾದನಾ ವರವಾಗಿದ್ದರೆ, ಅದನ್ನು ಅವನ ವಿಶ್ವಾಸದ ಅಳತೆಗೆ ತಕ್ಕ ರೀತಿಯಲ್ಲಿ ಉಪಯೋಗಿಸಲಿ. <verse eid="ROM 12:6"/><verse number="7" style="v" sid="ROM 12:7"/>ಅದು ಇತರರಿಗೆ ಸೇವೆ ಸಲ್ಲಿಸುವುದಾಗಿದ್ದರೆ, ಅದನ್ನು ಇತರರಿಗೆ ಸೇವೆ ಸಲ್ಲಿಸುವುದರಲ್ಲಿ ಉಪಯೋಗಿಸಲಿ. ಅದು ಬೋಧಿಸುವ ವರವಾಗಿದ್ದರೆ, ಅವನು ಬೋಧಿಸಲಿ. <verse eid="ROM 12:7"/><verse number="8" style="v" sid="ROM 12:8"/>ಅದು ಪ್ರೋತ್ಸಾಹಗೊಳಿಸುವುದಾಗಿದ್ದರೆ, ಅವನು ಪ್ರೋತ್ಸಾಹಗೊಳಿಸಲಿ. ದಾನಕೊಡುವ ವರವಾಗಿದ್ದರೆ, ಅವನು ಧಾರಾಳವಾಗಿ ಕೊಡಲಿ. ನಾಯಕತ್ವ ವಹಿಸುವ ವರವಾಗಿದ್ದರೆ, ಅವನು ಶ್ರದ್ಧೆಯಿಂದ ಮಾಡಲಿ ದಯೆ ತೋರಿಸುವ ವರವಾಗಿದ್ದರೆ ಅದನ್ನು ಅವನು ಸಂತೋಷದಿಂದ ಮಾಡಲಿ.<verse eid="ROM 12:8"/></para>
  <para style="s1">ಪ್ರೀತಿ</para>
  <para style="p">
    <verse number="9" style="v" sid="ROM 12:9"/>ನಿಮ್ಮ ಪ್ರೀತಿಯು ನಿಷ್ಕಪಟವಾಗಿರಲಿ. ಕೆಟ್ಟದ್ದನ್ನು ದ್ವೇಷಿಸಿ ಒಳ್ಳೆಯದಕ್ಕೆ ಅಂಟಿಕೊಳ್ಳಿರಿ. <verse eid="ROM 12:9"/><verse number="10" style="v" sid="ROM 12:10"/>ಒಬ್ಬರಿಗೊಬ್ಬರು ಸಹೋದರ ಪ್ರೀತಿಯಲ್ಲಿ ಸಮರ್ಪಿತರಾಗಿರಿ. ಗೌರವಿಸುವುದರಲ್ಲಿ ಒಬ್ಬರಿಗೊಬ್ಬರು ಮುಂದಾಗಿರಿ. <verse eid="ROM 12:10"/><verse number="11" style="v" sid="ROM 12:11"/>ಉತ್ಸಾಹದಲ್ಲಿ ಆಲಸ್ಯರಾಗದೆ, ಆತ್ಮದಲ್ಲಿ ಬೆಂಕಿಯುಳ್ಳವರಾಗಿ ಕರ್ತನ ಸೇವೆಯನ್ನು ಮಾಡಿರಿ. <verse eid="ROM 12:11"/><verse number="12" style="v" sid="ROM 12:12"/>ನಿರೀಕ್ಷೆಯಲ್ಲಿ ಸಂತೋಷವುಳ್ಳವರೂ ಸಂಕಟಗಳಲ್ಲಿ ಸಹನೆಯುಳ್ಳವರೂ ಪ್ರಾರ್ಥನೆಯಲ್ಲಿ ದೃಢಮನಸ್ಸುಳ್ಳವರೂ ಆಗಿ ಮುಂದುವರಿಯಿರಿ. <verse eid="ROM 12:12"/><verse number="13" style="v" sid="ROM 12:13"/>ಕೊರತೆ ಇರುವ ದೇವಜನರೊಂದಿಗೆ ನಿಮಗೆ ಇರುವುದನ್ನು ಹಂಚಿಕೊಳ್ಳಿರಿ, ಅತಿಥಿ ಸತ್ಕಾರವನ್ನು ಮಾಡುತ್ತಾ ಇರಿ.<verse eid="ROM 12:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="ROM 12:14"/>ನಿಮ್ಮನ್ನು ಹಿಂಸಿಸುವರನ್ನು ಆಶೀರ್ವದಿಸಿರಿ, ಶಪಿಸಬೇಡಿರಿ. <verse eid="ROM 12:14"/><verse number="15" style="v" sid="ROM 12:15"/>ಸಂತೋಷ ಪಡುವವರೊಂದಿಗೆ ಸಂತೋಷಪಡಿರಿ, ಅಳುವವರೊಂದಿಗೆ ಅಳಿರಿ. <verse eid="ROM 12:15"/><verse number="16" style="v" sid="ROM 12:16"/>ಒಬ್ಬರಿಗೊಬ್ಬರು ಒಂದೇ ಮನಸ್ಸುಳ್ಳವರಾಗಿರಿ. ನೀವು ಮನಸ್ಸಿನಲ್ಲಿ ಅಹಂಕಾರಿಗಳಾಗಿರದೆ, ದೀನರೊಂದಿಗೆ ಸಂತೋಷದಿಂದ ಸಹಭಾಗಿಗಳಾಗಿರಿ. ನಿಮ್ಮನ್ನು ನೀವೇ ಬುದ್ಧಿವಂತರೆಂದು ಭಾವಿಸಿಕೊಳ್ಳಬೇಡಿರಿ.<verse eid="ROM 12:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="ROM 12:17"/>ಯಾರಿಗೂ ಕೆಟ್ಟದ್ದಕ್ಕೆ ಪ್ರತಿಯಾಗಿ ಕೆಟ್ಟದ್ದನ್ನು ಮಾಡಬೇಡಿರಿ. ಎಲ್ಲರ ದೃಷ್ಟಿಯಲ್ಲಿಯೂ ಒಳ್ಳೆಯದನ್ನು ಮಾಡಿರಿ. <verse eid="ROM 12:17"/><verse number="18" style="v" sid="ROM 12:18"/>ಸಾಧ್ಯವಾದರೆ, ನಿಮ್ಮಿಂದ ಆದಷ್ಟು ಎಲ್ಲರೊಂದಿಗೂ ಸಮಾಧಾನದಿಂದಿರಿ. <verse eid="ROM 12:18"/><verse number="19" style="v" sid="ROM 12:19"/>ಪ್ರಿಯರೇ, ಮುಯ್ಯಿಗೆ ಮುಯ್ಯಿ ತೀರಿಸದೆ, ಅದನ್ನು ದೇವರ ಕೋಪಕ್ಕೆ ಬಿಟ್ಟುಬಿಡಿರಿ. ಏಕೆಂದರೆ, “ಮುಯ್ಯಿ ತೀರಿಸುವುದು ನನಗೆ ಸೇರಿದ್ದು. ನಾನು ಅದನ್ನು ತೀರಿಸುವೆನು,<note caller="+" style="f"><char style="fr" closed="false">12:19 </char><char style="ft" closed="false"><char style="xt"><ref loc="DEU 32:35">ಧರ್ಮೋ 32:35</ref></char></char></note> ಎಂದು ಕರ್ತನು ಹೇಳುತ್ತಾರೆ,” ಎಂದು ಪವಿತ್ರ ವೇದದಲ್ಲಿ ಬರೆಯಲಾಗಿದೆ.<verse eid="ROM 12:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="ROM 12:20"/>“ಆದರೆ, ನಿನ್ನ ವೈರಿಯು ಹಸಿದಿದ್ದರೆ, ಅವನಿಗೆ ಆಹಾರ ಕೊಡು,</para>
  <para style="q2" vid="ROM 12:20">ಅವನು ಬಾಯಾರಿದ್ದರೆ ಕುಡಿಯಲು ಕೊಡು.</para>
  <para style="q1" vid="ROM 12:20">ಹೀಗೆ ಮಾಡುವುದರಿಂದ ನೀನು ಅವನ ತಲೆಯ ಮೇಲೆ ಉರಿಯುವ ಕೆಂಡವನ್ನು ಸುರಿದಂತಾಗುವುದು.”<note caller="+" style="f"><char style="fr" closed="false">12:20 </char><char style="ft" closed="false"><char style="xt"><ref loc="PRO 25:21">ಜ್ಞಾನೋಕ್ತಿ 25:21</ref>,<ref loc="PRO 25:22">22</ref></char></char></note><verse eid="ROM 12:20"/></para>
  <para style="m">
    <verse number="21" style="v" sid="ROM 12:21"/>ಕೆಟ್ಟದ್ದಕ್ಕೆ ಸೋಲಬೇಡಿರಿ, ಕೆಟ್ಟದ್ದನ್ನು ಒಳ್ಳೆಯದರಿಂದ ಜಯಿಸಿರಿ.<verse eid="ROM 12:21"/></para>
  <chapter eid="ROM 12"/>
  <chapter number="13" style="c" sid="ROM 13"/>
  <para style="s1">ಅಧಿಕಾರಿಗಳಿಗೆ ಅಧೀನನಾಗಿರುವುದು</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 13:1"/>ಪ್ರತಿಯೊಬ್ಬನೂ ಮೇಲಧಿಕಾರಿಗಳಿಗೆ ಅಧೀನನಾಗಿರಬೇಕು, ಏಕೆಂದರೆ ದೇವರು ನೇಮಿಸಿದ ಅಧಿಕಾರದ ಹೊರತು ಬೇರೆ ಯಾವದೂ ಇರುವುದಿಲ್ಲ. ಇರುವ ಅಧಿಕಾರಗಳು ದೇವರಿಂದಲೇ ನೇಮಕಗೊಂಡಿವೆ. <verse eid="ROM 13:1"/><verse number="2" style="v" sid="ROM 13:2"/>ಆದ್ದರಿಂದ ಅಧಿಕಾರಕ್ಕೆ ಎದುರು ಬೀಳುವವನು ದೇವರ ನೇಮಕವನ್ನು ಎದುರಿಸುವವನಾಗಿರುತ್ತಾನೆ. ಹಾಗೆ ಎದುರಿಸುವವರು ತೀರ್ಪಿಗೆ ಗುರಿಯಾಗುವರು. <verse eid="ROM 13:2"/><verse number="3" style="v" sid="ROM 13:3"/>ಕೆಟ್ಟದ್ದನ್ನು ಮಾಡುವವನಿಗೆ ಅಧಿಪತಿಗಳ ಭಯವಿರುವುದೇ ಹೊರತು, ಒಳ್ಳೆಯದನ್ನು ಮಾಡುವವನಿಗೆ ಅಲ್ಲ. ಅಧಿಕಾರಿಗಳಿಗೆ ಭಯಪಡಬಾರದೇ? ಒಳ್ಳೆಯದನ್ನು ಮಾಡು. ಅದರಿಂದ ನಿನಗೆ ಪ್ರಶಂಸೆ ದೊರಕುವುದು. <verse eid="ROM 13:3"/><verse number="4" style="v" sid="ROM 13:4"/>ಏಕೆಂದರೆ, ಅವನು ನಿನಗೆ ಒಳ್ಳೆಯದನ್ನು ಮಾಡುವುದಕ್ಕೋಸ್ಕರ ಇರುವ ದೇವರ ಸೇವಕನಾಗಿರುತ್ತಾನೆ. ಆದರೆ ನೀನು ಕೆಟ್ಟದ್ದನ್ನು ಮಾಡುವವನಾಗಿದ್ದರೆ ಭಯಪಡಬೇಕು. ಏಕೆಂದರೆ ಅವನು ವ್ಯರ್ಥವಾಗಿ ಅಧಿಕಾರವನ್ನು ಪಡೆದಿಲ್ಲ. ಅವನು ದೇವರ ಸೇವಕನಾಗಿದ್ದು ಕೆಟ್ಟದ್ದನ್ನು ಅಭ್ಯಾಸ ಮಾಡುವವನಿಗೆ ದಂಡನೆಯನ್ನು ವಿಧಿಸುತ್ತಾನೆ. <verse eid="ROM 13:4"/><verse number="5" style="v" sid="ROM 13:5"/>ಆದ್ದರಿಂದ, ಭಯದ ನಿಮಿತ್ತದಿಂದ ಮಾತ್ರವಲ್ಲ ಮನಸ್ಸಾಕ್ಷಿಯ ನಿಮಿತ್ತವೂ ಅಧಿಕಾರಿಗಳಿಗೆ ಅಧೀನನಾಗಿರುವುದು ಅಗತ್ಯವಾಗಿರುತ್ತದೆ.<verse eid="ROM 13:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="ROM 13:6"/>ಇದರ ನಿಮಿತ್ತವಾಗಿಯೇ ನೀವು ತೆರಿಗೆಯನ್ನು ಪಾವತಿ ಮಾಡುತ್ತೀರಿ. ಏಕೆಂದರೆ, ಅಧಿಕಾರಿಗಳು ಇದರಲ್ಲಿಯೇ ನಿರತರಾಗಿರುವ ದೇವರ ಸೇವಕರಾಗಿರುತ್ತಾರೆ. <verse eid="ROM 13:6"/><verse number="7" style="v" sid="ROM 13:7"/>ನೀವು ಯಾರಿಗೆ ಏನು ಸಲ್ಲಿಸಬೇಕೋ ಅದನ್ನು ಸಲ್ಲಿಸಿರಿ. ತೆರಿಗೆ ಕಟ್ಟಬೇಕಾಗಿದ್ದರೆ ತೆರಿಗೆಯನ್ನು, ಸುಂಕ ಕೊಡಬೇಕಾಗಿದ್ದರೆ ಸುಂಕವನ್ನು, ಯಾರಿಗೆ ಮರ್ಯಾದೆಯೋ ಅವರಿಗೆ ಮರ್ಯಾದೆಯನ್ನು, ಗೌರವ ಸಲ್ಲಿಸಬೇಕಾಗಿದ್ದರೆ ಗೌರವವನ್ನು ಸಲ್ಲಿಸಿರಿ.<verse eid="ROM 13:7"/></para>
  <para style="s1">ಪ್ರೀತಿಯು ಮೋಶೆಯ ನಿಯಮವನ್ನು ನೆರವೇರಿಸುವುದು</para>
  <para style="p">
    <verse number="8" style="v" sid="ROM 13:8"/>ಒಬ್ಬರನ್ನೊಬ್ಬರು ಪ್ರೀತಿಸಬೇಕೆಂಬ ಸಾಲವೇ ಹೊರತು ನಿಮಗೆ ಬೇರೆ ಯಾವ ಸಾಲವೂ ಇರಬಾರದು. ಏಕೆಂದರೆ ಮತ್ತೊಬ್ಬರನ್ನು ಪ್ರೀತಿಸುವವನು ಮೋಶೆಯ ನಿಯಮವನ್ನೇ ನೆರವೇರಿಸಿದ್ದಾನೆ. <verse eid="ROM 13:8"/><verse number="9" style="v" sid="ROM 13:9"/>ಏಕೆಂದರೆ, “ವ್ಯಭಿಚಾರ ಮಾಡಬೇಡ, ಕೊಲೆ ಮಾಡಬೇಡ, ಕದಿಯಬೇಡ, ದುರಾಶೆ ಪಡಬೇಡ,”<note caller="+" style="f"><char style="fr" closed="false">13:9 </char><char style="ft" closed="false"><char style="xt"><ref loc="EXO 20:13-15">ವಿಮೋ 20:13-15</ref>,<ref loc="EXO 20:17">17</ref>; <ref loc="DEU 5:17-19">ಧರ್ಮೋ 5:17-19</ref>,<ref loc="DEU 5:21">21</ref></char></char></note> ಎನ್ನುವ ಹಾಗೂ ಇತರ ಯಾವ ಆಜ್ಞೆಗಳೇ ಇರಲಿ ಅವೆಲ್ಲವೂ, “ನಿನ್ನ ನೆರೆಯವನನ್ನು ನಿನ್ನಂತೆಯೇ ಪ್ರೀತಿಸು,”<note caller="+" style="f"><char style="fr" closed="false">13:9 </char><char style="ft" closed="false"><char style="xt"><ref loc="LEV 19:18">ಯಾಜಕ 19:18</ref></char></char></note> ಎಂಬ ಒಂದೇ ಮಾತಿನಲ್ಲಿವೆ. <verse eid="ROM 13:9"/><verse number="10" style="v" sid="ROM 13:10"/>ಪ್ರೀತಿಯು ತನ್ನ ನೆರೆಯವನಿಗೆ ಹಾನಿ ಮಾಡುವುದಿಲ್ಲ. ಆದ್ದರಿಂದ ಪ್ರೀತಿಯು ನಿಯಮದ ನೆರವೇರಿಕೆಯಾಗಿರುತ್ತದೆ.<verse eid="ROM 13:10"/></para>
  <para style="s1">ಕಡೆಯದಿನವು ಸಮೀಪವಾಗಿದೆ</para>
  <para style="p">
    <verse number="11" style="v" sid="ROM 13:11"/>ಈಗಿನ ಕಾಲವನ್ನು ತಿಳಿದು ಇದನ್ನೆಲ್ಲಾ ಮಾಡಿರಿ. ನೀವು ನಿದ್ರೆಯಿಂದ ಎಚ್ಚರಗೊಳ್ಳುವ ಗಳಿಗೆಯಾಗಿದೆ. ಏಕೆಂದರೆ, ನಮ್ಮ ರಕ್ಷಣೆಯು ನಾವು ಮೊದಲು ವಿಶ್ವಾಸವಿಟ್ಟಿದಕ್ಕಿಂತ ಈಗ ಹತ್ತಿರವಾಗಿರುತ್ತದೆ. <verse eid="ROM 13:11"/><verse number="12" style="v" sid="ROM 13:12"/>ರಾತ್ರಿಯು ಬಹಳಷ್ಟು ಕಳೆದು ಹಗಲು ಸಮೀಪಿಸಿದೆ. ಆದ್ದರಿಂದ ನಾವು ಕತ್ತಲೆಯ ಕೃತ್ಯಗಳನ್ನು ಎಸೆದು ಬೆಳಕಿನ ಆಯುಧಗಳನ್ನು ಧರಿಸಿಕೊಳ್ಳೋಣ. <verse eid="ROM 13:12"/><verse number="13" style="v" sid="ROM 13:13"/>ಪಕ್ಷತನ ಕುಡಿಕತನಗಳಲ್ಲಾಗಲಿ, ಕಾಮವಿಲಾಸ ನಿರ್ಲಜ್ಯ ಕೃತ್ಯಗಳಲ್ಲಾಗಲಿ, ಮತ್ಸರಗಳಲ್ಲಾಗಲಿ ನಿರತರಾಗಿರದೆ ಹಗಲಿನಲ್ಲಿರುವವರಂತೆ ಸಭ್ಯತೆಯಿಂದ ನಡೆದುಕೊಳ್ಳೋಣ. <verse eid="ROM 13:13"/><verse number="14" style="v" sid="ROM 13:14"/>ಕರ್ತ ಆಗಿರುವ ಯೇಸು ಕ್ರಿಸ್ತರನ್ನು ಧರಿಸಿಕೊಳ್ಳಿರಿ. ದೈಹಿಕ ಆಶೆಗಳನ್ನು ನೆರವೇರಿಸಲು ಯೋಚಿಸಬೇಡಿರಿ.<verse eid="ROM 13:14"/></para>
  <chapter eid="ROM 13"/>
  <chapter number="14" style="c" sid="ROM 14"/>
  <para style="s1">ಬಲಹೀನರು ಮತ್ತು ಬಲಿಷ್ಠರು</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 14:1"/>ಅಂಥವನ ಅಭಿಪ್ರಾಯಗಳ ಬಗ್ಗೆ ವಾಗ್ವಾದ ಮಾಡಬೇಡಿರಿ. ವಿಶ್ವಾಸದಲ್ಲಿ ಬಲಹೀನನಾಗಿರುವವನನ್ನು ಸ್ವೀಕರಿಸಿಕೊಳ್ಳಿರಿ. <verse eid="ROM 14:1"/><verse number="2" style="v" sid="ROM 14:2"/>ಒಬ್ಬನ ವಿಶ್ವಾಸವು ಎಲ್ಲವನ್ನೂ ತಿನ್ನುವಂತೆ ಮಾಡುತ್ತದೆ. ಆದರೆ ವಿಶ್ವಾಸದಲ್ಲಿ ಬಲಹೀನನಾಗಿರುವವನು ಸಸ್ಯಾಹಾರಿಯಾಗಿಯೇ ಇರುತ್ತಾನೆ. <verse eid="ROM 14:2"/><verse number="3" style="v" sid="ROM 14:3"/>ಮಾಂಸಾಹಾರಿಯು ಸಸ್ಯಾಹಾರಿಯನ್ನು ಹೀನೈಸದಿರಲಿ. ಸಸ್ಯಾಹಾರಿಯು ಮಾಂಸಾಹಾರಿಯನ್ನು ತೀರ್ಪು ಮಾಡದಿರಲಿ. ಏಕೆಂದರೆ ದೇವರು ಇಬ್ಬರನ್ನು ಸ್ವೀಕಾರ ಮಾಡಿರುತ್ತಾರೆ. <verse eid="ROM 14:3"/><verse number="4" style="v" sid="ROM 14:4"/>ಬೇರೊಬ್ಬನ ಮನೆಗೆಲಸದವನನ್ನು ತೀರ್ಪುಮಾಡಲು ನೀನು ಯಾರು? ಅವನು ನಿಂತರೂ ಬಿದ್ದರೂ ಅದು ಅವನ ಯಜಮಾನನಿಗೆ ಸೇರಿದ್ದು. ಅವನನ್ನು ನಿಲ್ಲುವಂತೆ ಮಾಡಲು ಕರ್ತನು ಶಕ್ತನಾಗಿರುವುದರಿಂದ ಅವನು ಎದ್ದು ನಿಲ್ಲುವನು.<verse eid="ROM 14:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="ROM 14:5"/>ಕೆಲವರು ಒಂದು ದಿನವನ್ನು ಮತ್ತೊಂದು ದಿನಕ್ಕಿಂತ ವಿಶೇಷವೆಂದು ಎಣಿಸುತ್ತಾರೆ. ಪ್ರತಿಯೊಬ್ಬರೂ ತಮ್ಮ ಮನಸ್ಸಿನಲ್ಲಿ ನಿಶ್ಚಯಿಸಿಕೊಂಡಂತೆ ನಡೆಯಲಿ. <verse eid="ROM 14:5"/><verse number="6" style="v" sid="ROM 14:6"/>ಒಬ್ಬ ಒಂದು ದಿನವನ್ನು ವಿಶೇಷವೆಂದು ಎಣಿಸುವುದಾದರೆ ಅವನು ಅದನ್ನು ಕರ್ತನಿಗಾಗಿಯೇ ಮಾಡಲಿ. ಮಾಂಸಾಹಾರಿಯು ದೇವರಿಗೆ ಕೃತಜ್ಞತೆಯನ್ನು ಮಾಡಿ ಊಟಮಾಡುವುದಾದರೆ ಅವನು ಅದನ್ನು ಮಾಡುವುದು ಕರ್ತನಿಗಾಗಿಯೇ. ಸಸ್ಯಾಹಾರಿಯು ಕರ್ತನಿಗಾಗಿಯೇ ತಿನ್ನದೆ ಕೃತಜ್ಞತೆ ಸಲ್ಲಿಸುತ್ತಾನೆ. <verse eid="ROM 14:6"/><verse number="7" style="v" sid="ROM 14:7"/>ನಮ್ಮಲ್ಲಿ ಯಾರೂ ತಮಗಾಗಿ ಜೀವಿಸದಿರಲಿ, ತಮಗಾಗಿ ಮರಣಿಸುವುದು ಬೇಡ. <verse eid="ROM 14:7"/><verse number="8" style="v" sid="ROM 14:8"/>ಬದುಕಿದರೆ ನಾವು ಕರ್ತನಿಗಾಗಿ ಬದುಕುತ್ತೇವೆ, ಸತ್ತರೆ ಕರ್ತನಿಗಾಗಿ ಸಾಯುತ್ತೇವೆ. ಹೀಗೆ ನಾವು ಬದುಕಿದರೂ ಸತ್ತರೂ ಕರ್ತನಿಗೆ ಸೇರಿದವರಾಗಿರುತ್ತೇವೆ. <verse eid="ROM 14:8"/><verse number="9" style="v" sid="ROM 14:9"/>ಈ ಕಾರಣಕ್ಕಾಗಿಯೇ, ಜೀವಿಸುವವರಿಗೂ ಸತ್ತವರಿಗೂ ಕರ್ತನಾಗಿರಬೇಕೆಂದು ಕ್ರಿಸ್ತನು ಮರಣಹೊಂದಿ ಪುನರುತ್ಥಾನಗೊಂಡರು.<verse eid="ROM 14:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="ROM 14:10"/>ಹೀಗಿರುವಾಗ, ನೀನು ಏಕೆ ನಿನ್ನ ಸಹೋದರರಿಗೆ ತೀರ್ಪುಮಾಡುತ್ತೀ? ಅಥವಾ ನಿನ್ನ ಸಹೋದರರನ್ನು ಏಕೆ ಹೀನಾಯವಾಗಿ ಕಾಣುತ್ತೀ? ನಾವೆಲ್ಲರೂ ದೇವರ ನ್ಯಾಯಾಸನದ ಮುಂದೆ ನಿಲ್ಲುವೆವು. <verse eid="ROM 14:10"/><verse number="11" style="v" sid="ROM 14:11"/>ಪವಿತ್ರ ವೇದದಲ್ಲಿ ಹೀಗೆ ಬರೆದಿದೆ:</para>
  <para style="q1" vid="ROM 14:11">“ ‘ನಾನು ಜೀವಿಸುವುದರಿಂದ,</para>
  <para style="q1" vid="ROM 14:11">ಪ್ರತಿಯೊಬ್ಬರೂ ನನ್ನ ಮುಂದೆ ಮೊಣಕಾಲೂರುವರು.</para>
  <para style="q2" vid="ROM 14:11">ಪ್ರತಿಯೊಂದು ನಾಲಿಗೆಯೂ ನನ್ನನ್ನು ದೇವರೆಂದು ಅರಿಕೆ ಮಾಡುವುದು,’</para>
  <para style="q2" vid="ROM 14:11">ಎಂದು ಕರ್ತನು ಹೇಳುತ್ತಾರೆ.”<note caller="+" style="f"><char style="fr" closed="false">14:11 </char><char style="ft" closed="false"><char style="xt"><ref loc="ISA 45:23">ಯೆಶಾಯ 45:23</ref></char></char></note><verse eid="ROM 14:11"/></para>
  <para style="m">
    <verse number="12" style="v" sid="ROM 14:12"/>ಹೀಗಿರುವಾಗ ನಮ್ಮಲ್ಲಿ ಪ್ರತಿಯೊಬ್ಬರೂ ತಮ್ಮ ಬಗ್ಗೆ ದೇವರಿಗೆ ಲೆಕ್ಕ ಒಪ್ಪಿಸಬೇಕು.<verse eid="ROM 14:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="ROM 14:13"/>ಆದ್ದರಿಂದ ನಾವು ಒಬ್ಬರ ಮೇಲೊಬ್ಬರು ತೀರ್ಪುಮಾಡದಿರೋಣ. ಇದಲ್ಲದೆ ಸಹೋದರರಿಗೆ ಅಡೆತಡೆಯನ್ನಾಗಲಿ, ಅಡ್ಡಿಯನ್ನಾಗಲಿ, ಹಾಕದಿರೋಣ. <verse eid="ROM 14:13"/><verse number="14" style="v" sid="ROM 14:14"/>ಯಾವುದೇ ಪದಾರ್ಥವು ತನ್ನಷ್ಟಕ್ಕೆ ಅಶುದ್ಧವಲ್ಲ ಎಂದು ನಾನು ಕರ್ತ ಆಗಿರುವ ಯೇಸುವಿನಲ್ಲಿ ನಿಶ್ಚಯವಾಗಿ ಬಲ್ಲೆನು. ಆದರೆ ಯಾರಾದರೂ ಅಶುದ್ಧವೆಂದು ಪರಿಗಣಿಸಿದರೆ ಅದು ಅವರಿಗೆ ಅಶುದ್ಧವಾಗಿರುವುದು. <verse eid="ROM 14:14"/><verse number="15" style="v" sid="ROM 14:15"/>ನೀವು ಆಹಾರದಿಂದ ನಿಮ್ಮ ಸಹೋದರರನ್ನು ದುಃಖ ಪಡಿಸುವುದಾದರೆ ನೀವು ಪ್ರೀತಿಯಿಂದ ನಡೆದುಕೊಳ್ಳುವುದಿಲ್ಲ. ನೀವು ತಿನ್ನುವುದರ ಮೂಲಕ ಕ್ರಿಸ್ತನು ಯಾವನಿಗೋಸ್ಕರವಾಗಿ ಸತ್ತರೋ ಅಂಥವರನ್ನು ನಾಶಮಾಡಬೇಡಿರಿ. <verse eid="ROM 14:15"/><verse number="16" style="v" sid="ROM 14:16"/>ನಿಮಗಿರುವ ಒಳ್ಳೆಯದು ಪರರ ದೂಷಣೆಗೆ ಗುರಿಯಾಗದಿರಲಿ. <verse eid="ROM 14:16"/><verse number="17" style="v" sid="ROM 14:17"/>ಏಕೆಂದರೆ ತಿನ್ನುವುದೂ ಕುಡಿಯುವುದೂ ದೇವರ ರಾಜ್ಯವಲ್ಲ. ನೀತಿ, ಸಮಾಧಾನ, ಪವಿತ್ರಾತ್ಮರಲ್ಲಿರುವ ಆನಂದವೂ ಆಗಿದೆ. <verse eid="ROM 14:17"/><verse number="18" style="v" sid="ROM 14:18"/>ಈ ರೀತಿಯಲ್ಲಿ ಕ್ರಿಸ್ತನಿಗೆ ಸೇವೆಮಾಡುವವರು ದೇವರಿಗೆ ಮೆಚ್ಚುಗೆಯಾದವರೂ ಜನರಿಂದ ಅನುಮೋದನೆ ಹೊಂದಿದವರೂ ಆಗಿರುತ್ತಾರೆ.<verse eid="ROM 14:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="ROM 14:19"/>ಆದ್ದರಿಂದ ಯಾವುದು ನಮ್ಮನ್ನು ಸಮಾಧಾನಕ್ಕೂ ಪರಸ್ಪರ ಭಕ್ತಿವೃದ್ಧಿಗೂ ನಡೆಸುತ್ತದೋ ಅದನ್ನೇ ಮಾಡೋಣ. <verse eid="ROM 14:19"/><verse number="20" style="v" sid="ROM 14:20"/>ಆಹಾರದ ನಿಮಿತ್ತವಾಗಿ ದೇವರ ಕೆಲಸವನ್ನು ಕೆಡಿಸಬೇಡ, ಎಲ್ಲಾ ಆಹಾರವೂ ಶುದ್ಧವಾದದ್ದೇ. ಆದರೆ ಒಬ್ಬರು ತಿಂದು ವಿಘ್ನವನ್ನು ಒಡ್ಡುವುದು ಕೆಟ್ಟದ್ದು. <verse eid="ROM 14:20"/><verse number="21" style="v" sid="ROM 14:21"/>ಮಾಂಸ ತಿನ್ನುವುದಾಗಲಿ, ದ್ರಾಕ್ಷಾರಸವನ್ನು ಕುಡಿಯುವುದಾಗಲಿ ಅಥವಾ ಬೇರೆ ಏನನ್ನೇ ಆಗಲಿ, ಅದು ನಿಮ್ಮ ಸಹೋದರರನ್ನು ಎಡವುವಂತೆ ಮಾಡುವುದಾದರೆ ಅದನ್ನು ಮಾಡದೆ ಇರುವುದೇ ಒಳ್ಳೆಯದು.<verse eid="ROM 14:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="ROM 14:22"/>ಈ ವಿಷಯದಲ್ಲಿ ನಿಮಗಿರುವ ವೈಯಕ್ತಿಕ ದೃಢವಿಶ್ವಾಸವನ್ನು ನೀವು ದೇವರ ಮುಂದೆ ಇಟ್ಟುಕೊಂಡಿರು. ತಾವು ಅನುಮೋದಿಸಿ ಮಾಡಿದ ಕಾರ್ಯಗಳ ಬಗ್ಗೆ ತಮಗೆ ದಂಡನಾತೀರ್ಪು ಮಾಡಿಕೊಳ್ಳದವರು ಧನ್ಯರು. <verse eid="ROM 14:22"/><verse number="23" style="v" sid="ROM 14:23"/>ಆದರೆ ಅನುಮಾನವುಳ್ಳವರು ಊಟಮಾಡುವುದು ವಿಶ್ವಾಸದಿಂದ ಅಲ್ಲವಾದ್ದರಿಂದ ಅವರು ದೋಷಿಯಾಗುತ್ತಾರೆ. ವಿಶ್ವಾಸವಿಲ್ಲದೆ ಮಾಡುವ ಎಲ್ಲವೂ ಪಾಪವಾಗಿವೆ.<verse eid="ROM 14:23"/></para>
  <chapter eid="ROM 14"/>
  <chapter number="15" style="c" sid="ROM 15"/>
  <para style="p">
    <verse number="1" style="v" sid="ROM 15:1"/>ವಿಶ್ವಾಸದಲ್ಲಿ ಬಲವುಳ್ಳವರಾದ ನಾವು ನಮ್ಮ ಸುಖವನ್ನು ನೋಡಿಕೊಳ್ಳದೆ, ಬಲಹೀನರ ಬಲಹೀನತೆಗಳನ್ನು ಸಹಿಸಿಕೊಳ್ಳಬೇಕು. <verse eid="ROM 15:1"/><verse number="2" style="v" sid="ROM 15:2"/>ನಮ್ಮಲ್ಲಿ ಪ್ರತಿಯೊಬ್ಬರು ತಮ್ಮ ನೆರೆಯವರ ಭಕ್ತಿವೃದ್ಧಿಯ ಹಿತಕ್ಕಾಗಿ ಅವರನ್ನು ಸುಖವನ್ನು ನೋಡಿಕೊಳ್ಳಲಿ. <verse eid="ROM 15:2"/><verse number="3" style="v" sid="ROM 15:3"/>“ನಿಮ್ಮನ್ನು ನಿಂದಿಸುವವರ ನಿಂದೆಗಳು ನನ್ನ ಮೇಲೆ ಬಂದವು,”<note caller="+" style="f"><char style="fr" closed="false">15:3 </char><char style="ft" closed="false"><char style="xt"><ref loc="PSA 69:9">ಕೀರ್ತನೆ 69:9</ref></char></char></note> ಎಂದು ಬರೆದಿರುವಂತೆ ಕ್ರಿಸ್ತನು ಸಹ ತಮ್ಮ ಸುಖಕ್ಕಾಗಿ ಬಾಳಲಿಲ್ಲ. <verse eid="ROM 15:3"/><verse number="4" style="v" sid="ROM 15:4"/>ಪವಿತ್ರ ವೇದದಲ್ಲಿ ಮುಂಚಿತವಾಗಿ ಬರೆದಿರುವುದೆಲ್ಲವೂ ನಮ್ಮ ಬೋಧನೆಗಾಗಿಯೇ ಬರೆಯಲಾಗಿದೆ. ನಾವು ಆ ಬೋಧನೆಗಳ ಮೂಲಕ ಸಹನೆಯನ್ನೂ ಉತ್ತೇಜನೆಯನ್ನೂ ಹೊಂದಿಕೊಂಡು ನಿರೀಕ್ಷೆಯುಳ್ಳವರಾಗಿರಬೇಕೆಂದು ಬರೆಯಲಾಗಿದೆ.<verse eid="ROM 15:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="ROM 15:5"/>ಸಹನೆಯನ್ನೂ ಉತ್ತೇಜನವನ್ನೂ ಕೊಡುವ ದೇವರು ನೀವು ಕ್ರಿಸ್ತ ಯೇಸುವನ್ನು ಹಿಂಬಾಲಿಸುವಂತೆ ನಿಮಗೆ ಒಂದೇ ಆತ್ಮವನ್ನು ಕೊಡಲಿ. <verse eid="ROM 15:5"/><verse number="6" style="v" sid="ROM 15:6"/>ಹೀಗೆ ನೀವು ಒಂದೇ ಮನಸ್ಸುಳ್ಳವರಾಗಿ ನಮಗೆ ಕರ್ತ ಆಗಿರುವ ಯೇಸುಕ್ರಿಸ್ತರ ತಂದೆಯಾದ ದೇವರನ್ನು ಒಂದೇ ಬಾಯಿಂದ ಮಹಿಮೆ ಪಡಿಸುವಿರಿ.<verse eid="ROM 15:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="ROM 15:7"/>ದೇವರಿಗೆ ಮಹಿಮೆಯಾಗುವುದಕ್ಕಾಗಿ ಕ್ರಿಸ್ತನು ನಿಮ್ಮನ್ನು ಸ್ವೀಕರಿಸಿದಂತೆಯೇ ನೀವು ಒಬ್ಬರನ್ನೊಬ್ಬರು ಸ್ವೀಕರಿಸಿರಿ. <verse eid="ROM 15:7"/><verse number="8" style="v" sid="ROM 15:8"/>ನಾನು ನಿಮಗೆ ಹೇಳುವುದೇನೆಂದರೆ, ದೇವರು ನಂಬಿಗಸ್ತರು ಎಂದು ತೋರಿಸುವುದಕ್ಕಾಗಿ ಕ್ರಿಸ್ತ ಯೇಸು ಯೆಹೂದ್ಯರಿಗೆ ಸೇವಕರಾಗಿ ಬಂದರು. ಹೀಗೆ ದೇವರು ಪಿತೃಗಳಿಗೆ ಕೊಟ್ಟ ವಾಗ್ದಾನಗಳನ್ನು ದೃಢಪಡಿಸಿದರು. <verse eid="ROM 15:8"/><verse number="9" style="v" sid="ROM 15:9"/>ಇದಲ್ಲದೆ ಯೆಹೂದ್ಯರಲ್ಲದವರು ದೇವರ ಕರುಣೆಗಾಗಿ ದೇವರನ್ನು ಮಹಿಮೆ ಪಡಿಸುವಂತೆ ಹೀಗೆ ಮಾಡಿದರು. ಇದು ಪವಿತ್ರ ವೇದದಲ್ಲಿ ಹೀಗೆ ಬರೆದದ್ದನ್ನು ನೆರವೇರಿಸಿತು:</para>
  <para style="q1" vid="ROM 15:9">“ಆದ್ದರಿಂದ ಯೆಹೂದ್ಯರಲ್ಲದವರ ನಡುವೆ ನಾನು ನಿನ್ನನ್ನು ಸ್ತುತಿಸುವೆನು,</para>
  <para style="q2" vid="ROM 15:9">ನಾನು ನಿನ್ನ ನಾಮವನ್ನು ಸ್ತುತಿಸಿ ಹಾಡುವೆನು.”<note caller="+" style="f"><char style="fr" closed="false">15:9 </char><char style="ft" closed="false"><char style="xt"><ref loc="2SA 22:50">2 ಸಮು 22:50</ref>; <ref loc="PSA 18:49">ಕೀರ್ತನೆ 18:49</ref></char></char></note><verse eid="ROM 15:9"/></para>
  <para style="m">
    <verse number="10" style="v" sid="ROM 15:10"/>ಮತ್ತೊಂದು ಕಡೆಯಲ್ಲಿ ಹೀಗೆ ಬರೆಯಲಾಗಿದೆ:</para>
  <para style="q1" vid="ROM 15:10">“ಯೆಹೂದ್ಯರಲ್ಲದವರೇ ದೇವಜನರೊಂದಿಗೆ ಸೇರಿ ಸಂತೋಷಪಡಿರಿ.”<note caller="+" style="f"><char style="fr" closed="false">15:10 </char><char style="ft" closed="false"><char style="xt"><ref loc="DEU 32:43">ಧರ್ಮೋ 32:43</ref></char></char></note><verse eid="ROM 15:10"/></para>
  <para style="m">
    <verse number="11" style="v" sid="ROM 15:11"/>ಇನ್ನೊಂದು ಕಡೆಯಲ್ಲಿ,</para>
  <para style="q1" vid="ROM 15:11">“ಯೆಹೂದ್ಯರಲ್ಲದವರೇ ಕರ್ತನನ್ನು ಸ್ತುತಿಸಿರಿ.</para>
  <para style="q2" vid="ROM 15:11">ಸಮಸ್ತ ಜನರೇ ಕರ್ತನಿಗೆ ಸ್ತೋತ್ರಮಾಡಿರಿ.”<note caller="+" style="f"><char style="fr" closed="false">15:11 </char><char style="ft" closed="false"><char style="xt"><ref loc="PSA 117:1">ಕೀರ್ತನೆ 117:1</ref></char></char></note><verse eid="ROM 15:11"/></para>
  <para style="m">
    <verse number="12" style="v" sid="ROM 15:12"/>ಪುನಃ ಪ್ರವಾದಿ ಯೆಶಾಯನು ಹೇಳುವುದೇನೆಂದರೆ:</para>
  <para style="q1" vid="ROM 15:12">“ಇಷಯನ ವಂಶದಿಂದ ಬೇರು ಒಂದು ಚಿಗುರುವುದು,</para>
  <para style="q2" vid="ROM 15:12">ಜನಾಂಗಗಳನ್ನು ಆಳುವವರಾಗಿ ಅವರು ಉದಯಿಸುವರು.</para>
  <para style="q2" vid="ROM 15:12">ಯೆಹೂದ್ಯರಲ್ಲದವರು ಆತನಲ್ಲಿ ನಿರೀಕ್ಷೆ ಇಡುವರು.”<note caller="+" style="f"><char style="fr" closed="false">15:12 </char><char style="ft" closed="false"><char style="xt"><ref loc="ISA 11:10">ಯೆಶಾಯ 11:10</ref></char></char></note><verse eid="ROM 15:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="ROM 15:13"/>ನಿರೀಕ್ಷೆಯ ದೇವರು, ನೀವು ಪವಿತ್ರಾತ್ಮನ ಶಕ್ತಿಯಿಂದ ನಿಮ್ಮ ನಿರೀಕ್ಷೆಯನ್ನು ಹೆಚ್ಚಿಸಿ, ನೀವು ನಿಮ್ಮ ವಿಶ್ವಾಸದಿಂದ ಸಕಲ ಸಂತೋಷದಿಂದಲೂ ಸಮಾಧಾನದಿಂದಲೂ ಪ್ರವಾಹಿಸುವಂತೆ ಮಾಡಲಿ.<verse eid="ROM 15:13"/></para>
  <para style="s1">ಪೌಲನು ಯೆಹೂದ್ಯರಲ್ಲದವರಿಗೆ ಸೇವಕ</para>
  <para style="p">
    <verse number="14" style="v" sid="ROM 15:14"/>ನನ್ನ ಪ್ರಿಯರೇ, ನೀವು ಒಳ್ಳೆಯತನದಿಂದ ಪೂರ್ಣವಾದವರೂ ಸಕಲ ತಿಳುವಳಿಕೆಯಿಂದ ತುಂಬಿದವರೂ ಆಗಿದ್ದು, ಒಬ್ಬರಿಗೊಬ್ಬರು ಬುದ್ಧಿ ಹೇಳುವುದಕ್ಕೆ ಶಕ್ತರಾಗಿದ್ದೀರೆಂದು ನಿಮ್ಮ ಬಗ್ಗೆ ನನಗೆ ಭರವಸೆ ಇದೆ. <verse eid="ROM 15:14"/><verse number="15" style="v" sid="ROM 15:15"/>ನಾನು ನಿಮಗೆ ಕೆಲವು ವಿಷಯಗಳನ್ನು ಜ್ಞಾಪಕ ಪಡಿಸುವುದಕ್ಕಾಗಿ ಬಹಳ ಧೈರ್ಯದಿಂದ ಹೀಗೆ ಬರೆದಿದ್ದೇನೆ. <verse eid="ROM 15:15"/><verse number="16" style="v" sid="ROM 15:16"/>ಯೆಹೂದ್ಯರಲ್ಲದವರು ಪವಿತ್ರಾತ್ಮನಿಂದ ಪರಿಶುದ್ಧರಾಗಿ, ದೇವರಿಗೆ ಅಂಗೀಕೃತವಾದ ಕಾಣಿಕೆಗಳಾಗಬೇಕೆಂಬ ಕಾರಣದಿಂದ, ನಾನು ಯೆಹೂದ್ಯರಲ್ಲದವರಿಗೆ ಕ್ರಿಸ್ತ ಯೇಸುವಿನ ಸೇವಕನಾಗಿ ದೇವರ ಸುವಾರ್ತೆಯನ್ನು ಪ್ರಕಟಿಸಲು ದೇವರು ನನಗೆ ಕೃಪೆ ನೀಡಿದ್ದಾರೆ.<verse eid="ROM 15:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="ROM 15:17"/>ಆದ್ದರಿಂದ ಕ್ರಿಸ್ತ ಯೇಸುವಿನಲ್ಲಿ ದೇವರ ಸೇವೆಯ ವಿಷಯವಾಗಿ ಹೊಗಳಿಕೊಳ್ಳುತ್ತೇನೆ. <verse eid="ROM 15:17"/><verse number="18" style="v" sid="ROM 15:18"/>ಯೆಹೂದ್ಯರಲ್ಲದವರನ್ನು ದೇವರಿಗೆ ವಿಧೇಯರಾಗುವುದಕ್ಕಾಗಿ ಕ್ರಿಸ್ತನು ನನ್ನ ಮೂಲಕ ಮಾತಿನಿಂದಲೂ ಕೃತ್ಯದಿಂದಲೂ <verse eid="ROM 15:18"/><verse number="19" style="v" sid="ROM 15:19"/>ಬಲವಾದ ಸೂಚಕಕಾರ್ಯಗಳಿಂದಲೂ ಅದ್ಭುತಕಾರ್ಯಗಳಿಂದಲೂ ಪವಿತ್ರಾತ್ಮ ಶಕ್ತಿಯಿಂದಲೂ ಮಾಡಿದ ಕಾರ್ಯಗಳನ್ನೇ ಹೊರತು ಬೇರೆ ಯಾವ ಕಾರ್ಯಗಳನ್ನೂ ಹೇಳುವುದಕ್ಕೆ ನನಗೆ ಧೈರ್ಯ ಸಾಲದು. ಯೆರೂಸಲೇಮಿನಿಂದ ಪ್ರಾರಂಭಿಸಿ, ಇಲ್ಲುರಿಕದವರೆಗೆ ನಾನು ಕ್ರಿಸ್ತನ ಸುವಾರ್ತೆಯನ್ನು ಸಂಪೂರ್ಣವಾಗಿ ಸಾರಿದ್ದೇನೆ. <verse eid="ROM 15:19"/><verse number="20" style="v" sid="ROM 15:20"/>ಬೇರೊಬ್ಬರು ಹಾಕಿರುವ ಅಸ್ತಿವಾರದ ಮೇಲೆ ನಾನು ಕಟ್ಟಬಾರದೆಂದು, ಕ್ರಿಸ್ತನ ಹೆಸರು ತಿಳಿಯಪಡಿಸದೆ ಇರುವಲ್ಲಿ ಸುವಾರ್ತೆಯನ್ನು ಸಾರಬೇಕೆಂದು ಆತುರದಿಂದ ಹೋರಾಡುತ್ತಿದ್ದೇನೆ. <verse eid="ROM 15:20"/><verse number="21" style="v" sid="ROM 15:21"/>ಪವಿತ್ರ ವೇದದಲ್ಲಿ ಬರೆದಿರುವಂತೆ :</para>
  <para style="q1" vid="ROM 15:21">“ಯಾರಿಗೆ ಆತನ ಸುದ್ದಿ ಮುಟ್ಟಲಿಲ್ಲವೋ ಅವರು ಆತನನ್ನು ಕಾಣುವರು;</para>
  <para style="q2" vid="ROM 15:21">ಯಾರು ಆತನ ವರ್ತಮಾನ ಕೇಳಲಿಲ್ಲವೋ ಅವರು ಗ್ರಹಿಸಿಕೊಳ್ಳುವರು.”<note caller="+" style="f"><char style="fr" closed="false">15:21 </char><char style="ft" closed="false"><char style="xt"><ref loc="ISA 52:15">ಯೆಶಾಯ 52:15</ref></char></char></note><verse eid="ROM 15:21"/></para>
  <para style="m">
    <verse number="22" style="v" sid="ROM 15:22"/>ಈ ಕಾರಣದಿಂದಲೇ ನಾನು ನಿಮ್ಮ ಬಳಿಗೆ ಬರುವುದಕ್ಕೆ ಅನೇಕಬಾರಿ ಅಭ್ಯಂತರವಾಯಿತು.<verse eid="ROM 15:22"/></para>
  <para style="s1">ರೋಮನ್ನು ಸಂದರ್ಶಿಸಲು ಪೌಲನ ಯೋಜನೆ</para>
  <para style="p">
    <verse number="23" style="v" sid="ROM 15:23"/>ಈಗಲಾದರೋ ಈ ಪ್ರದೇಶದಲ್ಲಿ ನನಗೆ ಅವಕಾಶವಿಲ್ಲದಿರುವುದರಿಂದಲೂ ಅನೇಕ ವರ್ಷಗಳಿಂದ ನಿಮ್ಮನ್ನು ಸಂದರ್ಶಿಸಬೇಕೆಂಬ ಹಂಬಲವಿರುವುದರಿಂದಲೂ <verse eid="ROM 15:23"/><verse number="24" style="v" sid="ROM 15:24"/>ನಾನು ಸ್ಪೇನ್ ದೇಶಕ್ಕೆ ಹೋಗುವಾಗ ನಿಮ್ಮನ್ನು ಸಂದರ್ಶಿಸುವ ನಿರೀಕ್ಷೆಯಲ್ಲಿದ್ದೇನೆ. ಸ್ವಲ್ಪಕಾಲ ನಿಮ್ಮ ಅನ್ಯೋನ್ಯತೆಯ ಆನಂದವನ್ನು ಪಡೆದ ಬಳಿಕ ಅಲ್ಲಿಗೆ ಹೋಗುವ ನನ್ನ ಪ್ರಯಾಣದಲ್ಲಿ ನಿಮ್ಮ ಸಹಕಾರವನ್ನು ಬಯಸುತ್ತೇನೆ. <verse eid="ROM 15:24"/><verse number="25" style="v" sid="ROM 15:25"/>ಈಗಲಾದರೋ ನಾನು ದೇವಜನರ ಸೇವೆಗಾಗಿ ಯೆರೂಸಲೇಮಿಗೆ ಹೋಗುತ್ತಿದ್ದೇನೆ. <verse eid="ROM 15:25"/><verse number="26" style="v" sid="ROM 15:26"/>ಮಕೆದೋನ್ಯ ಮತ್ತು ಅಖಾಯದವರು ಯೆರೂಸಲೇಮಿನ ಭಕ್ತರಲ್ಲಿರುವ ಬಡವರಾಗಿರುವವರಿಗೆ ಸಹಾಯ ಮಾಡುವುದು ಒಳ್ಳೆಯದೆಂದು ಭಾವಿಸಿದ್ದಾರೆ. <verse eid="ROM 15:26"/><verse number="27" style="v" sid="ROM 15:27"/>ಅವರು ಅದನ್ನು ಮಾಡಲು ಇಷ್ಟಪಟ್ಟದ್ದಲ್ಲದೆ, ಅದು ಕರ್ತವ್ಯವೂ ಆಗಿದೆ. ಹೌದು, ಯೆಹೂದ್ಯರಲ್ಲದವರು ಯೆಹೂದ್ಯರ ಆತ್ಮಿಕ ಆಶೀರ್ವಾದಗಳಲ್ಲಿ ಪಾಲುಗೊಂಡಿರುವುದಾದರೆ ತಮ್ಮ ಲೌಕಿಕ ವಿಷಯಗಳಲ್ಲಿ ಅವರೊಂದಿಗೆ ಹಂಚಿಕೊಳ್ಳುವುದು ಅವರ ಕರ್ತವ್ಯವಾಗಿದೆ. <verse eid="ROM 15:27"/><verse number="28" style="v" sid="ROM 15:28"/>ಆದ್ದರಿಂದ ಈ ಕೆಲಸವನ್ನು ಪೂರೈಸಿ ಸಂಗ್ರಹಿಸಿ ಕೊಟ್ಟದ್ದನ್ನು ಅವರಿಗೆ ಒಪ್ಪಿಸಿ ಖಚಿತವಾದ ಬಳಿಕ, ನಾನು ಸ್ಪೇನ್ ದೇಶಕ್ಕೆ ಹೋಗುವ ದಾರಿಯಲ್ಲಿ ನಿಮ್ಮನ್ನು ಸಂದರ್ಶಿಸುತ್ತೇನೆ. <verse eid="ROM 15:28"/><verse number="29" style="v" sid="ROM 15:29"/>ನಾನು ನಿಮ್ಮ ಬಳಿಗೆ ಬರುವಾಗ ಕ್ರಿಸ್ತನ ಆಶೀರ್ವಾದದಿಂದ ತುಂಬಿದವನಾಗಿ ಬರುತ್ತೇನೆಂದು ಬಲ್ಲೆನು.<verse eid="ROM 15:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="ROM 15:30"/>ಪ್ರಿಯರೇ, ನಮ್ಮ ಕರ್ತ ಆಗಿರುವ ಯೇಸುಕ್ರಿಸ್ತರ ಮೂಲಕವಾಗಿಯೂ ಪವಿತ್ರಾತ್ಮರ ಪ್ರೀತಿಯ ಮೂಲಕವಾಗಿಯೂ ನಾನು ನಿಮ್ಮನ್ನು ಬೇಡಿಕೊಳ್ಳುವುದೇನೆಂದರೆ, ನನಗೋಸ್ಕರ ದೇವರಲ್ಲಿ ಪ್ರಾರ್ಥಿಸಿ, ನನ್ನೊಂದಿಗೆ ಹೋರಾಡಿರಿ. <verse eid="ROM 15:30"/><verse number="31" style="v" sid="ROM 15:31"/>ನಾನು ಯೂದಾಯ ಪ್ರಾಂತದಲ್ಲಿ ಅವಿಶ್ವಾಸಿಗಳ ಕೈಯಿಂದ ಕಾಪಾಡಬೇಕೆಂತಲೂ ನನ್ನ ಸೇವೆಯು ಯೆರೂಸಲೇಮಿನಲ್ಲಿರುವ ದೇವಜನರಿಗೆ ಮೆಚ್ಚುಗೆಯಾಗಿರಬೇಕೆಂತಲೂ ಪ್ರಾರ್ಥಿಸಿರಿ. <verse eid="ROM 15:31"/><verse number="32" style="v" sid="ROM 15:32"/>ಆಗ ನಾನು ದೇವರ ಚಿತ್ತಾನುಸಾರ ನಿಮ್ಮ ಬಳಿಗೆ ಸಂತೋಷದಿಂದ ಬಂದು, ನಿಮ್ಮ ಸಂಗಡ ವಿಶ್ರಾಂತಿ ಹೊಂದುವೆನು. <verse eid="ROM 15:32"/><verse number="33" style="v" sid="ROM 15:33"/>ಸಮಾಧಾನದ ದೇವರು ನಿಮ್ಮೆಲ್ಲರೊಂದಿಗಿರಲಿ. ಆಮೆನ್.<verse eid="ROM 15:33"/></para>
  <para style="b"/>
  <chapter eid="ROM 15"/>
  <chapter number="16" style="c" sid="ROM 16"/>
  <para style="s1">ಪೌಲನ ವಂದನೆಗಳು</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 16:1"/>ನಮ್ಮ ಸಹೋದರಿಯೂ ಕೆಂಖ್ರೆಯ ಸಭೆಯ ಸೇವಕಿಯೂ ಆಗಿರುವ ಫೊಯಿಬೆಯನ್ನು ನಿಮಗೆ ಪರಿಚಯಿಸುತ್ತೇನೆ. <verse eid="ROM 16:1"/><verse number="2" style="v" sid="ROM 16:2"/>ಕರ್ತನಲ್ಲಿ ದೇವಜನರಿಗೆ ಯೋಗ್ಯವಾಗಿರುವ ರೀತಿಯಲ್ಲಿ ಆಕೆಯನ್ನು ಸ್ವೀಕರಿಸಿ, ಆಕೆಯು ಅನೇಕರಿಗೂ ನನಗೂ ವಿಶೇಷವಾದ ರೀತಿಯಲ್ಲಿ ಸಹಾಯ ಮಾಡಿದವಳಾಗಿರುವುದರಿಂದ ನಿಮಗೆ ಯಾವ ಕೊರತೆಗಳಿದ್ದರೂ ಆಕೆಗೆ ಬೇಕಾದದ್ದನ್ನು ಒದಗಿಸಿರಿ.<verse eid="ROM 16:2"/></para>
  <para style="b"/>
  <para style="p">
    <verse number="3" style="v" sid="ROM 16:3"/>ಕ್ರಿಸ್ತ ಯೇಸುವಿನಲ್ಲಿ ನನ್ನ ಜೊತೆ ಕೆಲಸದವರಾಗಿರುವ ಪ್ರಿಸ್ಕಳಿಗೂ ಅಕ್ವಿಲನಿಗೂ ನನ್ನ ವಂದನೆಗಳನ್ನು ತಿಳಿಸಿರಿ. <verse eid="ROM 16:3"/><verse number="4" style="v" sid="ROM 16:4"/>ಅವರು ನನ್ನ ಪ್ರಾಣದ ನಿಮಿತ್ತವಾಗಿ ತಮ್ಮ ಪ್ರಾಣಗಳನ್ನು ಅಪಾಯಕ್ಕೆ ಒಡ್ಡಿದರು. ಅವರಿಗೆ ನಾನು ಮಾತ್ರವೇ ಅಲ್ಲ ಯೆಹೂದ್ಯರಲ್ಲದವರು ಎಲ್ಲಾ ಸಭೆಗಳವರೂ ಕೃತಜ್ಞರಾಗಿರುತ್ತಾರೆ.<verse eid="ROM 16:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="ROM 16:5"/>ಅವರ ಮನೆಯಲ್ಲಿ ಸೇರಿ ಬರುವ ಸಭೆಗೂ ನನ್ನ ವಂದನೆಗಳನ್ನು ತಿಳಿಸಿರಿ.</para>
  <para style="p" vid="ROM 16:5">ಏಷ್ಯಾ ಪ್ರಾಂತದಲ್ಲಿ ಕ್ರಿಸ್ತನಿಗೆ ಪ್ರಥಮ ಫಲವಾಗಿರುವ ನನ್ನ ಪ್ರಿಯನಾಗಿರುವ ಎಪೈನೆತನಿಗೂ ನನ್ನ ವಂದನೆಗಳನ್ನು ತಿಳಿಸಿರಿ.<verse eid="ROM 16:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="ROM 16:6"/>ನಿಮಗೋಸ್ಕರ ಬಹು ಶ್ರಮೆಪಟ್ಟ ಮರಿಯಳಿಗೆ ವಂದನೆಗಳು.<verse eid="ROM 16:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="ROM 16:7"/>ನನ್ನ ಬಂಧುಗಳೂ ಜೊತೆ ಸೆರೆಯವರೂ ಆದ ಅಂದ್ರೋನಿಕನಿಗೂ ಯೂನ್ಯಳಿಗೂ ವಂದನೆಗಳು. ಅವರು ಅಪೊಸ್ತಲರಲ್ಲಿ ಪ್ರಸಿದ್ಧರೂ ಮತ್ತು ನನಗಿಂತ ಮೊದಲೇ ಕ್ರಿಸ್ತನಲ್ಲಿದ್ದವರೂ ಆಗಿರುತ್ತಾರೆ.<verse eid="ROM 16:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="ROM 16:8"/>ನನಗೆ ಕರ್ತನಲ್ಲಿ ಪ್ರಿಯನಾದ ಅಂಪ್ಲಿಯಾತನಿಗೆ ವಂದನೆಗಳು.<verse eid="ROM 16:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="ROM 16:9"/>ಕ್ರಿಸ್ತನಲ್ಲಿ ನನ್ನ ಜೊತೆ ಸೇವಕನಾಗಿರುವ ಉರ್ಬಾನನಿಗೂ ನನಗೆ ಪ್ರಿಯನಾದ ಸ್ತಾಖುನಿಗೂ ವಂದನೆಗಳು.<verse eid="ROM 16:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="ROM 16:10"/>ಕ್ರಿಸ್ತನಲ್ಲಿ ಪರಿಶೋಧಿತನಾದ ಅಪೆಲ್ಲನಿಗೆ ವಂದನೆಗಳು,</para>
  <para style="p" vid="ROM 16:10">ಅರಿಸ್ತೊಬೂಲನ ಮನೆಯವರಿಗೆ ವಂದನೆಗಳು.<verse eid="ROM 16:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="ROM 16:11"/>ನನ್ನ ಸಂಬಂಧಿಯಾಗಿರುವ ಹೆರೊಡಿಯೋನನಿಗೆ ವಂದನೆಗಳು,</para>
  <para style="p" vid="ROM 16:11">ಕರ್ತನಲ್ಲಿರುವ ನಾರ್ಕಿಸ್ಸನ ಕುಟುಂಬದವರಿಗೆ ವಂದನೆಗಳು.<verse eid="ROM 16:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="ROM 16:12"/>ಕರ್ತನ ಸೇವೆಯಲ್ಲಿ ದುಡಿಯುವ ತ್ರುಫೈನಳಿಗೂ ತ್ರುಫೋಸಳಿಗೂ ವಂದನೆಗಳು,</para>
  <para style="p" vid="ROM 16:12">ಕರ್ತನಲ್ಲಿ ತುಂಬಾ ಶ್ರಮಪಟ್ಟು ದುಡಿದಿರುವ ಪ್ರೀತಿಯ ಪೆರ್ಸೀಸಳಿಗೂ ನನ್ನ ವಂದನೆಗಳು.<verse eid="ROM 16:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="ROM 16:13"/>ಕರ್ತನಲ್ಲಿ ಆಯ್ಕೆಯಾಗಿರುವ ರೂಫನಿಗೂ ನನಗೂ ತಾಯಿಯಂತಿದ್ದ ಅವನ ತಾಯಿಗೂ ವಂದನೆಗಳು.<verse eid="ROM 16:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="ROM 16:14"/>ಅಸುಂಕ್ರಿತ, ಪ್ಲೆಗೋನ, ಹೆರ್ಮೆಯನಿಗೂ ಪತ್ರೋಬನಿಗೂ ಹೆರ್ಮಾನ ಮತ್ತು ಅವನೊಂದಿಗಿರುವ ಪ್ರಿಯರಿಗೂ ವಂದನೆಗಳು.<verse eid="ROM 16:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="ROM 16:15"/>ಫಿಲೊಲೊಗ, ಯೂಲ್ಯಳು, ನೇರ್ಯ ಮತ್ತು ಅವನ ಸಹೋದರಿ, ಒಲುಂಪ ಮತ್ತು ಅವರೊಂದಿಗಿರುವ ಎಲ್ಲಾ ಭಕ್ತರಿಗೂ ವಂದನೆಗಳು.<verse eid="ROM 16:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="ROM 16:16"/>ಪವಿತ್ರವಾದ ಮುದ್ದನ್ನಿಟ್ಟು ಒಬ್ಬರನ್ನೊಬ್ಬರು ವಂದಿಸಿರಿ.</para>
  <para style="p" vid="ROM 16:16">ಕ್ರಿಸ್ತನ ಎಲ್ಲಾ ಸಭೆಗಳವರೂ ನಿಮಗೆ ವಂದನೆಗಳನ್ನು ಕಳುಹಿಸುತ್ತಾರೆ.<verse eid="ROM 16:16"/></para>
  <para style="b"/>
  <para style="p">
    <verse number="17" style="v" sid="ROM 16:17"/>ಪ್ರಿಯರೇ, ನೀವು ಕಲಿತುಕೊಂಡ ಬೋಧನೆಗೆ ವಿರೋಧವಾಗಿರುವ ಭೇದಗಳನ್ನೂ ಅಭ್ಯಂತರಗಳನ್ನೂ ಮಾಡುವವರ ಬಗ್ಗೆ ಎಚ್ಚರಿಕೆಯಿಂದಿರಿ. ಅಂಥವರಿಂದ ದೂರವಾಗಿರಿ ಎಂದು ನಿಮ್ಮನ್ನು ಬೇಡಿಕೊಳ್ಳುತ್ತೇನೆ. <verse eid="ROM 16:17"/><verse number="18" style="v" sid="ROM 16:18"/>ಅಂಥಾ ಜನರು ನಮಗೆ ಕರ್ತ ಆಗಿರುವ ಕ್ರಿಸ್ತ ಯೇಸುವಿನ ಸೇವೆ ಮಾಡುವವರಾಗಿರದೆ ತಮ್ಮ ಹೊಟ್ಟೆಯ ಸೇವೆ ಮಾಡುವವರಾಗಿರುತ್ತಾರೆ. ನಯವಾದ ಮತ್ತು ಮುಖಸ್ತುತಿಯ ಮಾತುಗಳಿಂದ ನಿಷ್ಕಪಟಿಗಳ ಹೃದಯಗಳನ್ನು ಮೋಸಗೊಳಿಸುತ್ತಾರೆ. <verse eid="ROM 16:18"/><verse number="19" style="v" sid="ROM 16:19"/>ನಿಮ್ಮ ವಿಧೇಯತೆಯು ಎಲ್ಲಾ ಮನುಷ್ಯರಿಗೂ ಪ್ರಸಿದ್ಧವಾಯಿತು. ಆದ್ದರಿಂದ ನಾನು ನಿಮ್ಮ ವಿಷಯದಲ್ಲಿ ಸಂತೋಷಪಡುತ್ತೇನೆ. ಆದರೆ ನೀವು ಒಳ್ಳೆಯದನ್ನು ಕುರಿತು ಜ್ಞಾನಿಗಳಾಗಿಯೂ ಕೆಟ್ಟವುಗಳನ್ನು ಕುರಿತು ನಿಷ್ಕಳಂಕರಾಗಿಯೂ ಇರಬೇಕೆಂದು ಅಪೇಕ್ಷಿಸುತ್ತೇನೆ.<verse eid="ROM 16:19"/></para>
  <para style="b"/>
  <para style="p">
    <verse number="20" style="v" sid="ROM 16:20"/>ಆಗ ಸಮಾಧಾನದ ದೇವರು ಬೇಗನೆ ಸೈತಾನನನ್ನು ನಿಮ್ಮ ಕಾಲುಗಳ ಕೆಳಗೆ ಹಾಕಿ ಜಜ್ಜಿಬಿಡುವನು.</para>
  <para style="b" vid="ROM 16:20"/>
  <para style="p" vid="ROM 16:20">ನಮ್ಮ ಕರ್ತ ಆಗಿರುವ ಯೇಸುವಿನ ಕೃಪೆಯು ನಿಮ್ಮೊಂದಿಗಿರಲಿ.<verse eid="ROM 16:20"/></para>
  <para style="b"/>
  <para style="p">
    <verse number="21" style="v" sid="ROM 16:21"/>ನನ್ನ ಜೊತೆ ಕೆಲಸದವನಾಗಿರುವ ತಿಮೊಥೆಯನು ನಿಮಗೆ ವಂದನೆಗಳನ್ನು ತಿಳಿಸುತ್ತಾನೆ. ಹಾಗೆಯೇ ನನ್ನ ಬಂಧುಗಳಾದ ಲೂಕ್ಯನೂ ಯಾಸೋನನೂ ಸೋಸಿಪತ್ರನೂ ನಿಮಗೆ ವಂದನೆಗಳನ್ನು ತಿಳಿಸುತ್ತಾರೆ.<verse eid="ROM 16:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="ROM 16:22"/>ಈ ಪತ್ರವನ್ನು ಬರೆದ ತೆರ್ತ್ಯನೆಂಬ ನಾನು ಕರ್ತನಲ್ಲಿ ನಿಮ್ಮನ್ನು ವಂದಿಸುತ್ತೇನೆ.<verse eid="ROM 16:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="ROM 16:23"/>ಇಲ್ಲಿ ನನಗೂ ಇಡೀ ಸಭೆಗೂ ಅತಿಥಿ ಸತ್ಕಾರ ಮಾಡುತ್ತಿರುವ ಗಾಯನು ತನ್ನ ವಂದನೆಗಳನ್ನು ತಿಳಿಸುತ್ತಾನೆ.</para>
  <para style="p" vid="ROM 16:23">ಈ ಪಟ್ಟಣದ ಖಜಾಂಚಿಯಾಗಿರುವ ಎರಸ್ತನೂ ಮತ್ತು ಸಹೋದರ ಕ್ವರ್ತನೂ ನಿಮಗೆ ವಂದನೆಗಳನ್ನು ಹೇಳುತ್ತಾರೆ.<verse eid="ROM 16:23"/></para>
  <para style="b"/>
  <para style="p">
    <verse number="24" style="v" sid="ROM 16:24"/>
    <char style="it">ನಮ್ಮ ಕರ್ತ ಆಗಿರುವ ಯೇಸುಕ್ರಿಸ್ತರ ಕೃಪೆಯು ನಿಮ್ಮೆಲ್ಲರೊಡನೆ ಇರಲಿ! ಆಮೆನ್.</char>
    <note caller="+" style="f">
      <char style="fr" closed="false">16:24 </char>
      <char style="ft" closed="false">ಕೆಲವು ಮೂಲ ಪ್ರತಿಗಳಲ್ಲಿ ಈ ವಾಕ್ಯ ಸೇರ್ಪಡೆಯಾಗಿರುವುದಿಲ್ಲ.</char>
    </note><verse eid="ROM 16:24"/></para>
  <para style="b"/>
  <para style="p">
    <verse number="25" style="v" sid="ROM 16:25"/>ನನ್ನ ಸುವಾರ್ತೆಯು ಹೇಳುವಂತೆಯೇ ನಿಮ್ಮನ್ನು ಬಲಪಡಿಸುವ ದೇವರಿಗೆ ಈಗ ಎಲ್ಲಾ ಮಹಿಮೆಯಾಗಲಿ. ಕ್ರಿಸ್ತ ಯೇಸುವಿನ ಕುರಿತಾಗಿರುವ ಈ ಸಂದೇಶವು ಆದಿಯಿಂದಲೂ ಗುಪ್ತವಾಗಿರುವ ರಹಸ್ಯದ ದೇವರ ಯೋಜನೆಯು ಯೆಹೂದ್ಯರಲ್ಲದವರಾದ ನಿಮಗಾಗಿ ಈಗ ಪ್ರಕಟವಾಗಿದೆ. <verse eid="ROM 16:25"/><verse number="26" style="v" sid="ROM 16:26"/>ಆದರೆ ನಿತ್ಯ ದೇವರು ಆಜ್ಞಾಪಿಸಿದಂತೆ ಈಗ ಪ್ರವಾದಿಗಳ ಗ್ರಂಥಗಳ ಮೂಲಕ ಮುಂತಿಳಿಸಿರುವಂತೆ, ಈ ಸಂದೇಶವು ಯೆಹೂದ್ಯರಲ್ಲದ ಜನರೆಲ್ಲರಿಗೂ ತಿಳಿಸಲಾಗಿದೆ. ಹೀಗೆ ಅವರು ನಂಬಿದ್ದರಿಂದ ವಿಧೇಯರಾಗುತ್ತಾರೆ. <verse eid="ROM 16:26"/><verse number="27" style="v" sid="ROM 16:27"/>ಶಕ್ತರಾಗಿರುವ ಒಬ್ಬರೇ ಜ್ಞಾನವಂತರಾಗಿರುವ ದೇವರಿಗೆ ಕ್ರಿಸ್ತ ಯೇಸುವಿನ ಮೂಲಕ ಎಂದೆಂದಿಗೂ ಮಹಿಮೆಯಾಗಲಿ! ಆಮೆನ್.<verse eid="ROM 16:27"/></para>
  <chapter eid="ROM 16"/>
</usx>
