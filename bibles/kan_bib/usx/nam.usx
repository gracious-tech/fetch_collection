<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="NAM" style="id">- Biblica® Open Kannada Contemporary Version</book>
  <para style="h">ನಹೂಮ</para>
  <para style="toc1">ನಹೂಮ</para>
  <para style="toc2">ನಹೂಮ</para>
  <para style="toc3">ನಹೂಮ</para>
  <para style="mt1">ನಹೂಮ</para>
  <chapter number="1" style="c" sid="NAM 1"/>
  <para style="p">
    <verse number="1" style="v" sid="NAM 1:1"/>ನಿನೆವೆಯ ವಿಷಯವಾದ ಪ್ರವಾದನೆ: ಎಲ್ಕೋಷಿನವನಾದ ನಹೂಮನ ದರ್ಶನದ ಪುಸ್ತಕವು.<verse eid="NAM 1:1"/></para>
  <para style="b"/>
  <para style="s1">ನಿನೆವೆ ಮೇಲೆ ಯೆಹೋವ ದೇವರ ರೌದ್ರ</para>
  <para style="q1">
    <verse number="2" style="v" sid="NAM 1:2"/>ಯೆಹೋವ ದೇವರು ಅಸೂಯೆಪಡುವ ಮತ್ತು ಸೇಡು ತೀರಿಸಿಕೊಳ್ಳುವ ದೇವರು.</para>
  <para style="q2" vid="NAM 1:2">ಅವರು ತಮ್ಮನ್ನು ಎದುರಿಸುವವರನ್ನು ಎದುರಿಸುತ್ತಾರೆ.</para>
  <para style="q2" vid="NAM 1:2">ಯೆಹೋವ ದೇವರು ರೋಷದಿಂದ ಮುಯ್ಯಿಗೆ ಮುಯ್ಯಿ ತೀರಿಸುತ್ತಾರೆ.</para>
  <para style="q1" vid="NAM 1:2">ಯೆಹೋವ ದೇವರು ತಮ್ಮ ವೈರಿಗಳಿಗೆ ಮುಯ್ಯಿಗೆ ಮುಯ್ಯಿ ತೀರಿಸಿ,</para>
  <para style="q2" vid="NAM 1:2">ತಮ್ಮ ಶತ್ರುಗಳ ಮೇಲೆ ಕೋಪವನ್ನು ಪ್ರಕಟಿಸಿಕೊಳ್ಳುತ್ತಾರೆ.<verse eid="NAM 1:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="NAM 1:3"/>ಯೆಹೋವ ದೇವರು ಕೋಪಗೊಳ್ಳುವುದರಲ್ಲಿ ಶಾಂತಿಸ್ವರೂಪರು. ಆದರೂ ಶಕ್ತಿಯಲ್ಲಿ ಮಹತ್ತಾದವರು.</para>
  <para style="q2" vid="NAM 1:3">ದುರ್ಮಾರ್ಗದವರನ್ನು ಎಷ್ಟು ಮಾತ್ರಕ್ಕೂ ಶಿಕ್ಷಿಸದೆ ಇರರು.</para>
  <para style="q1" vid="NAM 1:3">ಯೆಹೋವ ದೇವರ ಮಾರ್ಗವು ಸುಳಿಗಾಳಿಯಲ್ಲಿಯೂ, ಬಿರುಗಾಳಿಯಲ್ಲಿಯೂ ಇದೆ.</para>
  <para style="q2" vid="NAM 1:3">ಮೇಘಗಳು ಅವರ ಕಾಲುಗಳ ಧೂಳೇ.<verse eid="NAM 1:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="NAM 1:4"/>ಅವರು ಸಮುದ್ರವನ್ನು ಗದರಿಸಿ, ಅದನ್ನು ಒಣಗುವಂತೆ ಮಾಡುತ್ತಾರೆ.</para>
  <para style="q2" vid="NAM 1:4">ಸಕಲನದಿಗಳನ್ನು ಬತ್ತಿಸುತ್ತಾರೆ.</para>
  <para style="q1" vid="NAM 1:4">ಬಾಷಾನು, ಕರ್ಮೆಲು ಬಾಡಿ ಹೋಗುತ್ತವೆ</para>
  <para style="q2" vid="NAM 1:4">ಮತ್ತು ಲೆಬನೋನಿನ ಹೂವು ಬಾಡಿ ಹೋಗುತ್ತದೆ.<verse eid="NAM 1:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="NAM 1:5"/>ಬೆಟ್ಟಗಳು ಅವರ ಮುಂದೆ ಕಂಪಿಸುತ್ತವೆ;</para>
  <para style="q2" vid="NAM 1:5">ಗುಡ್ಡಗಳು ಕರಗುತ್ತವೆ;</para>
  <para style="q1" vid="NAM 1:5">ಭೂಮಿಯೂ, ಲೋಕವೂ, ಅದರ ನಿವಾಸಿಗಳೆಲ್ಲವೂ</para>
  <para style="q2" vid="NAM 1:5">ಅವರ ಮುಂದೆ ನಡುಗುತ್ತವೆ.<verse eid="NAM 1:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="NAM 1:6"/>ಅವರ ರೌದ್ರದ ಎದುರಿಗೆ ಯಾರು ನಿಲ್ಲುವರು?</para>
  <para style="q2" vid="NAM 1:6">ಅವರ ರೋಷಾಗ್ನಿಯಲ್ಲಿ ಯಾರು ನಿಂತುಕೊಳ್ಳುವರು?</para>
  <para style="q1" vid="NAM 1:6">ಅವರ ಕೋಪಾಗ್ನಿ ಬೆಂಕಿಯ ಹಾಗೆ ಸುರಿಸಲಾಗಿದೆ;</para>
  <para style="q2" vid="NAM 1:6">ಬಂಡೆಗಳು ಆತನ ಮುಂದೆ ಕೆಡವಲಾಗಿವೆ.<verse eid="NAM 1:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="NAM 1:7"/>ಯೆಹೋವ ದೇವರು ಒಳ್ಳೆಯವರು.</para>
  <para style="q2" vid="NAM 1:7">ಇಕ್ಕಟ್ಟಿನ ದಿವಸದಲ್ಲಿ ಆಶ್ರಯದಾತರಾಗಿದ್ದಾರೆ.</para>
  <para style="q1" vid="NAM 1:7">ತಮ್ಮಲ್ಲಿ ನಂಬಿಕೆ ಇಡುವವರನ್ನು ಅವರು ಪರಿಪಾಲಿಸುತ್ತಾರೆ.<verse eid="NAM 1:7"/></para>
  <para style="q2">
    <verse number="8" style="v" sid="NAM 1:8"/>ಆದರೆ ಮೇರೆ ಮೀರುವ ಪ್ರಳಯದಿಂದ</para>
  <para style="q1" vid="NAM 1:8">ನಿನೆವೆಯನ್ನು ಮುಗಿಸಿಬಿಡುವರು.</para>
  <para style="q2" vid="NAM 1:8">ಕತ್ತಲೆ ಅವರ ಶತ್ರಗಳನ್ನು ಹಿಂದಟ್ಟುವುದು.<verse eid="NAM 1:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="NAM 1:9"/>ಯೆಹೋವ ದೇವರಿಗೆ ವಿರೋಧವಾಗಿ ಅವರು ಏನೇನು ಯೋಚಿಸಿರುವರೋ,</para>
  <para style="q2" vid="NAM 1:9">ಅದನ್ನು ಅವರು ಅಂತ್ಯಗೊಳಿಸುವರು.</para>
  <para style="q2" vid="NAM 1:9">ತೊಂದರೆಯು ಎರಡು ಸಾರಿ ಏಳದು.<verse eid="NAM 1:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="NAM 1:10"/>ಅವರು ಮುಳ್ಳುಗಳಲ್ಲಿ ಸಿಕ್ಕಿಕೊಳ್ಳುವರು,</para>
  <para style="q2" vid="NAM 1:10">ತಮ್ಮ ದ್ರಾಕ್ಷಾರಸದಿಂದ ಮತ್ತರಾಗುವರು.</para>
  <para style="q2" vid="NAM 1:10">ಪೂರ್ಣವಾಗಿ ಒಣಗಿದ ಕೂಳೆಯಂತೆ ಅವರು ಸುಟ್ಟು ಹೋಗುವರು.<verse eid="NAM 1:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="NAM 1:11"/>ನಿನೆವೆಯೇ ಯೆಹೋವ ದೇವರಿಗೆ</para>
  <para style="q2" vid="NAM 1:11">ವಿರೋಧವಾಗಿ ದುರಾಲೋಚನೆ ಮಾಡಿ,</para>
  <para style="q2" vid="NAM 1:11">ಕೇಡನ್ನು ಯೋಚಿಸುವವನು ನಿನ್ನೊಳಗಿಂದ ಹೊರಟಿದ್ದಾನೆ.<verse eid="NAM 1:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="NAM 1:12"/>ಯೆಹೋವ ದೇವರು ಹೀಗೆ ಹೇಳುತ್ತಾರೆ:</para>
  <para style="q1" vid="NAM 1:12">ಅವರೊಂದಿಗೆ ಒಪ್ಪಂದ ಮಾಡಿಕೊಂಡವರಿದ್ದರೂ,</para>
  <para style="q2" vid="NAM 1:12">ಅವರು ಬಹುಮಂದಿಯಾಗಿದ್ದರೂ ನಾಶಕ್ಕೆ ಒಳಗಾಗುವರು.</para>
  <para style="q1" vid="NAM 1:12">ಯೆಹೂದವೇ, ನಾನು ನಿನ್ನನ್ನು ಕಷ್ಟಪಡಿಸಿದಾಗ್ಯೂ,</para>
  <para style="q2" vid="NAM 1:12">ಇನ್ನು ಮೇಲೆ ಕಷ್ಟಪಡಿಸೆನು.<verse eid="NAM 1:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="NAM 1:13"/>ನಾನು ಈಗ ನಿನ್ನ ಮೇಲಿನ ಅವರ ನೊಗವನ್ನು ಮುರಿದು,</para>
  <para style="q2" vid="NAM 1:13">ನಿನ್ನ ಬಂಧನಗಳನ್ನು ಹರಿದುಬಿಡುವೆನು.<verse eid="NAM 1:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="NAM 1:14"/>ನಿನೆವೆಯೇ, ನಿನ್ನ ವಿಷಯವಾಗಿ ಯೆಹೋವ ದೇವರು ಆಜ್ಞಾಪಿಸುವುದೇನೆಂದರೆ:</para>
  <para style="q2" vid="NAM 1:14">ಹೆಸರೆತ್ತಲು ನಿನಗೆ ಸಂತಾನವಿಲ್ಲದಂತೆ ಮಾಡುವೆನು.</para>
  <para style="q1" vid="NAM 1:14">ನಿನ್ನ ದೇವರ ಮಂದಿರದಲ್ಲಿರುವ ಕೆತ್ತಿದ ವಿಗ್ರಹವನ್ನೂ,</para>
  <para style="q2" vid="NAM 1:14">ಎರಕ ಬೊಂಬೆಯನ್ನೂ ನಾಶಮಾಡುವೆನು.</para>
  <para style="q1" vid="NAM 1:14">ನೀನು ತುಚ್ಛನಾದದ್ದರಿಂದ</para>
  <para style="q2" vid="NAM 1:14">ನಿನಗೆ ಸಮಾಧಿಯನ್ನು ಸಿದ್ಧಮಾಡುವೆನು.<verse eid="NAM 1:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="NAM 1:15"/>ಇಗೋ, ಪರ್ವತಗಳ ಮೇಲೆ ಶುಭಸಮಾಚಾರವನ್ನು ತಂದು,</para>
  <para style="q2" vid="NAM 1:15">ಸಮಾಧಾನವನ್ನು ತಿಳಿಸುವವನ ಪಾದಗಳನ್ನು ನೋಡು.</para>
  <para style="q1" vid="NAM 1:15">ಯೆಹೂದವೇ, ನಿನ್ನ ಪರಿಶುದ್ಧ ಹಬ್ಬಗಳನ್ನು ನಡೆಸು,</para>
  <para style="q2" vid="NAM 1:15">ನಿನ್ನ ಹರಕೆಗಳನ್ನು ಸಲ್ಲಿಸು.</para>
  <para style="q1" vid="NAM 1:15">ಏಕೆಂದರೆ ಇನ್ನು ಮೇಲೆ ದುಷ್ಟರು ನಿನ್ನ ಮೇಲೆ ಮುತ್ತಿಗೆ ಹಾಕರು.</para>
  <para style="q2" vid="NAM 1:15">ಅವರು ಸಂಪೂರ್ಣವಾಗಿ ನಾಶವಾಗುವರು.<verse eid="NAM 1:15"/></para>
  <chapter eid="NAM 1"/>
  <chapter number="2" style="c" sid="NAM 2"/>
  <para style="s1">ನಿನೆವೆಯು ಬೀಳುವುದು</para>
  <para style="q1">
    <verse number="1" style="v" sid="NAM 2:1"/>ನಿನೆವೆಯೇ, ಮುತ್ತಿಗೆ ಹಾಕುವವನು ನಿನಗೆ ವಿರೋಧವಾಗಿ ಹೊರಟಿದ್ದಾನೆ,</para>
  <para style="q2" vid="NAM 2:1">ಕೋಟೆಯನ್ನು ಭದ್ರಪಡಿಸು;</para>
  <para style="q2" vid="NAM 2:1">ದಾರಿಯನ್ನು ಕಾಯಿ;</para>
  <para style="q2" vid="NAM 2:1">ನಡುವನ್ನು ಬಲಪಡಿಸಿಕೋ;</para>
  <para style="q2" vid="NAM 2:1">ನಿನ್ನ ಶಕ್ತಿಯನ್ನು ಬಲವಾಗಿ ಗಟ್ಟಿಮಾಡಿಕೋ.<verse eid="NAM 2:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="NAM 2:2"/>ಯೆಹೋವ ದೇವರು ಯಾಕೋಬಿನ ಹೆಚ್ಚಳವನ್ನು</para>
  <para style="q2" vid="NAM 2:2">ಇಸ್ರಾಯೇಲಿನ ಹೆಚ್ಚಳದ ಹಾಗೆಯೇ ಪುನಃ ಸ್ಥಾಪಿಸುತ್ತಾರೆ.</para>
  <para style="q1" vid="NAM 2:2">ನಾಶಕರು ಅವುಗಳನ್ನು ನಾಶಮಾಡಿದರೂ</para>
  <para style="q2" vid="NAM 2:2">ಅವರ ದ್ರಾಕ್ಷಿಬಳ್ಳಿಗಳನ್ನು ಕೆಡಿಸಿದ್ದಾರೆ.<verse eid="NAM 2:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="NAM 2:3"/>ಸೈನಿಕರ ಗುರಾಣಿಗಳು ಕೆಂಪಾಗಿವೆ;</para>
  <para style="q2" vid="NAM 2:3">ಯುದ್ಧವೀರರು ರಕ್ತವರ್ಣದ ಬಟ್ಟೆ ಧರಿಸಿದ್ದಾರೆ;</para>
  <para style="q1" vid="NAM 2:3">ಆತನು ಸಿದ್ಧಮಾಡುವ ದಿವಸದಲ್ಲಿ,</para>
  <para style="q2" vid="NAM 2:3">ರಥಗಳ ಉಕ್ಕು ಥಳಥಳಿಸುವುದು,</para>
  <para style="q2" vid="NAM 2:3">ತುರಾಯಿ ಮರದಿಂದ ಮಾಡಿದ ಈಟಿಗಳು ಝಳಪಿಸುವುವು;<verse eid="NAM 2:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="NAM 2:4"/>ರಥಗಳು ಬೀದಿಗಳಲ್ಲಿ ಬಿರುಗಾಳಿಯಂತೆ ಓಡಾಡುತ್ತವೆ,</para>
  <para style="q2" vid="NAM 2:4">ಅವು ಚೌಕಗಳಲ್ಲಿ ವೇಗವಾಗಿ ಹಿಂದಕ್ಕೆ ಮತ್ತು ಮುಂದಕ್ಕೆ ನುಗ್ಗುತ್ತವೆ.</para>
  <para style="q1" vid="NAM 2:4">ಅವು ಉರಿಯುವ ಪಂಜುಗಳಂತೆ ಕಾಣುತ್ತವೆ;</para>
  <para style="q2" vid="NAM 2:4">ಅವರು ಮಿಂಚಿನಂತೆ ಸುತ್ತಾಡುತ್ತಾರೆ.<verse eid="NAM 2:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="NAM 2:5"/>ನಿನೆವೆಯು ತನ್ನ ಸೇನಾಪತಿಗಳನ್ನು ಕರೆಕಳುಹಿಸಿದ್ದಾನೆ.</para>
  <para style="q2" vid="NAM 2:5">ಅವರು ತಮ್ಮ ನಡೆಯಲ್ಲಿ ಎಡವುವರು.</para>
  <para style="q1" vid="NAM 2:5">ಅವರು ಸುಣ್ಣದ ಗೋಡೆಯ ಬಳಿಗೆ ತ್ವರೆಯಾಗಿ ಬರುವರು.</para>
  <para style="q2" vid="NAM 2:5">ರಕ್ಷಣಾತ್ಮಕ ಗುರಾಣಿಯನ್ನು ಸಿದ್ಧ ಮಾಡಲಾಗಿದೆ.<verse eid="NAM 2:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="NAM 2:6"/>ನದಿಗಳ ಬಾಗಿಲುಗಳು ತೆರೆಯಲಾಗಿವೆ;</para>
  <para style="q2" vid="NAM 2:6">ಅರಮನೆ ಬಿದ್ದುಹೋಗುವುದು.<verse eid="NAM 2:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="NAM 2:7"/>ನಿನೆವೆಯು ಸೆರೆಯಾಗಿ</para>
  <para style="q2" vid="NAM 2:7">ಹೋಗಬೇಕೆಂಬ ಆಜ್ಞೆಯಾಗಿದೆ.</para>
  <para style="q1" vid="NAM 2:7">ಅವಳ ದಾಸಿಯರು ಪಾರಿವಾಳಗಳಂತೆ ರೋದಿಸುವರು,</para>
  <para style="q2" vid="NAM 2:7">ತಮ್ಮ ಎದೆಗಳನ್ನು ಬಡಿದುಕೊಳ್ಳುವರು.<verse eid="NAM 2:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="NAM 2:8"/>ನಿನೆವೆ ಹುಟ್ಟಿದಂದಿನಿಂದ ನೀರಿನ ಕೆರೆಯ ಹಾಗಿತ್ತು.</para>
  <para style="q2" vid="NAM 2:8">ಅದರ ನೀರು ಹರಿದು ಖಾಲಿಯಾಗುತ್ತಲಿದೆ.</para>
  <para style="q1" vid="NAM 2:8">“ನಿಲ್ಲಿರಿ! ನಿಲ್ಲಿರಿ!” ಎಂದು ಅವರು ಕೂಗಿದರೂ,</para>
  <para style="q2" vid="NAM 2:8">ಒಬ್ಬನೂ ಹಿಂದಕ್ಕೆ ನೋಡುವುದಿಲ್ಲ.<verse eid="NAM 2:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="NAM 2:9"/>ಬೆಳ್ಳಿಯನ್ನು ಸುಲಿದುಕೊಳ್ಳಿರಿ;</para>
  <para style="q2" vid="NAM 2:9">ಬಂಗಾರವನ್ನು ಸುಲಿದುಕೊಳ್ಳಿರಿ.</para>
  <para style="q1" vid="NAM 2:9">ಕೂಡಿಸಿಟ್ಟ ಧನಕ್ಕೂ,</para>
  <para style="q2" vid="NAM 2:9">ಸಕಲ ವಿಧವಾದ ಶ್ರೇಷ್ಠ ವಸ್ತುಗಳ ನಿಧಿಗೂ ಪಾರವೇ ಇಲ್ಲ.<verse eid="NAM 2:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="NAM 2:10"/>ನಿನೆವೆ ಬರಿದಾಗಿದೆ, ಸುಲಿಗೆಯಾಗಿದೆ, ಹಾಳುಬಿದ್ದಿದೆ,</para>
  <para style="q2" vid="NAM 2:10">ಹೃದಯಗಳು ಕರಗುತ್ತವೆ; ಮೊಣಕಾಲುಗಳು ಒಟ್ಟಾಗಿ ಬಡಿದುಕೊಳ್ಳುತ್ತವೆ.</para>
  <para style="q2" vid="NAM 2:10">ಎಲ್ಲರ ಸೊಂಟಗಳಲ್ಲಿ ಸಂಕಟವಿದೆ; ಎಲ್ಲಾ ಮುಖಗಳು ಕಳೆಗುಂದುತ್ತವೆ.<verse eid="NAM 2:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="NAM 2:11"/>ಸಿಂಹದ ಗವಿಯೂ,</para>
  <para style="q2" vid="NAM 2:11">ಎಳೆಯ ಸಿಂಹಗಳು ಮೇಯುವ ಸ್ಥಳವೂ ಎಲ್ಲಿ?</para>
  <para style="q1" vid="NAM 2:11">ಸಿಂಹವೂ, ಸಿಂಹಿಣಿಯೂ,</para>
  <para style="q2" vid="NAM 2:11">ಸಿಂಹದ ಮರಿಗಳೂ ಭಯವಿಲ್ಲದೆ ನಡೆದಾಡುವ ಸ್ಥಳಗಳೆಲ್ಲಿ?<verse eid="NAM 2:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="NAM 2:12"/>ಸಿಂಹವು, ತನ್ನ ಮರಿಗಳಿಗೆ,</para>
  <para style="q2" vid="NAM 2:12">ಸಿಂಹಿಣಿಗಳಿಗೆ, ಕೊರಳು ಹಿಸುಕಿ ಕೊಂದ ಪ್ರಾಣಿಗಳಿಂದ</para>
  <para style="q2" vid="NAM 2:12">ತನ್ನ ಗುಹೆಯನ್ನು ತುಂಬಿಸುತ್ತಿತ್ತು.<verse eid="NAM 2:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="NAM 2:13"/>ಸೇನಾಧೀಶ್ವರ ಯೆಹೋವ ದೇವರು ಹೀಗೆ ಹೇಳುತ್ತಾರೆ:</para>
  <para style="q2" vid="NAM 2:13">“ಇಗೋ, ನಾನು ನಿನಗೆ ವಿರೋಧವಾಗಿದ್ದೇನೆ.</para>
  <para style="q1" vid="NAM 2:13">ನಿನ್ನ ರಥಗಳನ್ನು ಹೊಗೆಯಾಗಲು ಸುಡುತ್ತೇನೆ.</para>
  <para style="q2" vid="NAM 2:13">ಖಡ್ಗವು ನಿನ್ನ ಎಳೆಯ ಸಿಂಹಗಳನ್ನು ನುಂಗಿಬಿಡುವುದು.</para>
  <para style="q2" vid="NAM 2:13">ನಿನಗೆ ಸಿಕ್ಕಿದ ಬೇಟೆಯನ್ನು ಭೂಮಿಯ ಮೇಲಿನಿಂದ ತೆಗೆದುಬಿಡುತ್ತೇನೆ.</para>
  <para style="q1" vid="NAM 2:13">ನಿನ್ನ ರಾಯಭಾರಿಗಳ ಧ್ವನಿಯು</para>
  <para style="q2" vid="NAM 2:13">ಇನ್ನು ಕೇಳಿಸದು.”<verse eid="NAM 2:13"/></para>
  <chapter eid="NAM 2"/>
  <chapter number="3" style="c" sid="NAM 3"/>
  <para style="s1">ನಿನೆವೆಗೆ ಕಷ್ಟ</para>
  <para style="q1">
    <verse number="1" style="v" sid="NAM 3:1"/>ರಕ್ತಮಯ ಪಟ್ಟಣಕ್ಕೆ ಕಷ್ಟ,</para>
  <para style="q2" vid="NAM 3:1">ಅದೆಲ್ಲಾ ಸುಳ್ಳಿನಿಂದಲೂ,</para>
  <para style="q1" vid="NAM 3:1">ಕಳ್ಳತನದಿಂದಲೂ ತುಂಬಿದೆ,</para>
  <para style="q2" vid="NAM 3:1">ಕೊಳ್ಳೆಯನ್ನೂ ಬಿಡುವುದಿಲ್ಲ.<verse eid="NAM 3:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="NAM 3:2"/>ಚಾವಟಿಗೆ, ಚಬುಕಿನ ಶಬ್ದವೂ,</para>
  <para style="q2" vid="NAM 3:2">ಚಕ್ರಗಳ ಧಡಧಡನೆಯ ಶಬ್ದವೂ,</para>
  <para style="q1" vid="NAM 3:2">ಕುದುರೆಗಳ ಕುಣಿದಾಟವೂ,</para>
  <para style="q2" vid="NAM 3:2">ರಥಗಳ ಹಾರಾಟವೂ ಇದೆ.<verse eid="NAM 3:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="NAM 3:3"/>ಸವಾರರು ಹತ್ತುತ್ತಾರೆ,</para>
  <para style="q2" vid="NAM 3:3">ಈಟಿಗಳು ಥಳಥಳಿಸುತ್ತವೆ,</para>
  <para style="q2" vid="NAM 3:3">ಖಡ್ಗಗಳು ಮಿಂಚುತ್ತವೆ,</para>
  <para style="q1" vid="NAM 3:3">ಹತರಾದವರು ಬಹಳ;</para>
  <para style="q2" vid="NAM 3:3">ಹೆಣಗಳ ರಾಶಿ;</para>
  <para style="q1" vid="NAM 3:3">ಅಸಂಖ್ಯಾತ ಮೃತ ದೇಹಗಳು,</para>
  <para style="q2" vid="NAM 3:3">ಶವಗಳ ಮೇಲೆ ತತ್ತರಿಸುತ್ತಿರುವ ಜನರು,<verse eid="NAM 3:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="NAM 3:4"/>ಇದೆಲ್ಲವೂ ಆ ಒಬ್ಬ ವೇಶ್ಯೆಯ ಕಾಮತೃಷೆಯಿಂದಾಗಿ,</para>
  <para style="q2" vid="NAM 3:4">ವೇಶ್ಯೆಯು ಲೆಕ್ಕವಿಲ್ಲದ ವೇಶ್ಯಾವಾಟಿಕೆಯ ಬಹಳ.</para>
  <para style="q1" vid="NAM 3:4">ಅವಳು ತನ್ನ ಸೂಳೆತನಗಳಿಂದ ಜನಾಂಗಗಳನ್ನೂ,</para>
  <para style="q2" vid="NAM 3:4">ತನ್ನ ಮಾಟಗಳಿಂದ ಗೋತ್ರಗಳನ್ನೂ ಗುಲಾಮರನ್ನಾಗಿ ಮಾಡಿಕೊಂಡಳಲ್ಲವೇ?<verse eid="NAM 3:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="NAM 3:5"/>ಸೇನಾಧೀಶ್ವರ ಯೆಹೋವ ದೇವರು ಹೇಳುವುದೇನೆಂದರೆ,</para>
  <para style="q2" vid="NAM 3:5">“ಇಗೋ, ನಾನು ನಿನಗೆ ವಿರೋಧವಾಗಿದ್ದೇನೆ.</para>
  <para style="q2" vid="NAM 3:5">ನಿನ್ನ ಸೆರಗುಗಳನ್ನು ನಿನ್ನ ಮುಖದ ಮೇಲಿಂದ ಎತ್ತಿ,</para>
  <para style="q1" vid="NAM 3:5">ಜನಾಂಗಗಳಿಗೆ ನಿನ್ನ ನಾಚಿಕೆಯನ್ನೂ,</para>
  <para style="q2" vid="NAM 3:5">ರಾಜ್ಯಗಳಿಗೆ ನಿನ್ನ ನಿಂದೆಯ ಬೆತ್ತಲೆತನವನ್ನೂ ತೋರಿಸುತ್ತೇನೆ.<verse eid="NAM 3:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="NAM 3:6"/>ಅಸಹ್ಯವಾದವುಗಳನ್ನು ನಿನ್ನ ಮೇಲೆ ಹಾಕಿ,</para>
  <para style="q2" vid="NAM 3:6">ನಿನ್ನನ್ನು ನೀಚಳನ್ನಾಗಿ ಮಾಡಿ,</para>
  <para style="q2" vid="NAM 3:6">ನಿನ್ನನ್ನು ಪರಿಹಾಸ್ಯಕ್ಕೀಡುಮಾಡುವೆನು.<verse eid="NAM 3:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="NAM 3:7"/>ನಿನ್ನನ್ನು ನೋಡುವವರೆಲ್ಲರೂ ನಿನ್ನಿಂದ ಓಡಿಹೋಗಿ ಹೀಗೆ ಹೇಳುವರು,</para>
  <para style="q2" vid="NAM 3:7">‘ನಿನೆವೆ ಹಾಳಾಯಿತು, ಅದಕ್ಕೆ ಯಾರು ಚಿಂತೆಪಡುವರು?’</para>
  <para style="q2" vid="NAM 3:7">ನಿನ್ನನ್ನು ಆದರಿಸುವವರನ್ನು ನಾನು ಎಲ್ಲಿಂದ ಹುಡುಕಲಿ.”<verse eid="NAM 3:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="NAM 3:8"/>ನೈಲ್ ನದಿಯ ಬಳಿ ನೆಲೆಯಾಗಿದ್ದ ತೆಬೆಸ್ಸಿಗಿಂತ</para>
  <para style="q2" vid="NAM 3:8">ನೀನು ಒಳ್ಳೆಯವಳೋ?</para>
  <para style="q2" vid="NAM 3:8">ಅವಳ ಸುತ್ತಲೂ ನೀರಿತ್ತು.</para>
  <para style="q1" vid="NAM 3:8">ನದಿ ಅವಳ ರಕ್ಷಣೆ,</para>
  <para style="q2" vid="NAM 3:8">ನೀರು ಅವಳ ಗೋಡೆ.<verse eid="NAM 3:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="NAM 3:9"/>ಕೂಷ್ ಮತ್ತು ಈಜಿಪ್ಟ್ ಅವಳ ಅಪಾರ ಬಲವಾಗಿದ್ದವು.</para>
  <para style="q2" vid="NAM 3:9">ಪೂಟರೂ, ಲಿಬಿಯದವರೂ ಅವಳ ಸಹಾಯಕರಾಗಿದ್ದರು.<verse eid="NAM 3:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="NAM 3:10"/>ಆದರೆ ಅವಳು ಸೆರೆಯಾಗಿ</para>
  <para style="q2" vid="NAM 3:10">ದೇಶಾಂತರಕ್ಕೆ ಹೋದಳು.</para>
  <para style="q1" vid="NAM 3:10">ಅವಳ ಕೂಸುಗಳು ಸಹ</para>
  <para style="q2" vid="NAM 3:10">ಎಲ್ಲಾ ಬೀದಿಗಳ ಮುಖ್ಯ ಸ್ಥಳಗಳಲ್ಲಿ ಅಪ್ಪಳಿಸಲಾಯಿತು.</para>
  <para style="q1" vid="NAM 3:10">ಅವಳ ಪ್ರಧಾನರಿಗೋಸ್ಕರ ಚೀಟುಹಾಕಿದರು.</para>
  <para style="q2" vid="NAM 3:10">ಅವಳ ಮಹನೀಯರೆಲ್ಲರನ್ನು ಸಂಕೋಲೆಗಳಿಂದ ಕಟ್ಟಿದರು.<verse eid="NAM 3:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="NAM 3:11"/>ನೀನೂ ಸಹ ಅಮಲೇರಿ ಅಡಗಿಕೊಳ್ಳುವೆ;</para>
  <para style="q2" vid="NAM 3:11">ನೀನೂ ಸಹ ಶತ್ರುವಿನ ನಿಮಿತ್ತ</para>
  <para style="q2" vid="NAM 3:11">ಅಡಗಿಕೊಳ್ಳಲು ಆಶ್ರಯ ಸ್ಥಾನವನ್ನು ಹುಡುಕುವೆ.<verse eid="NAM 3:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="NAM 3:12"/>ನಿನ್ನ ಕೋಟೆಗಳೆಲ್ಲಾ ಮೊದಲನೆಯ ಮಾಗಿದ ಹಣ್ಣುಳ್ಳ</para>
  <para style="q2" vid="NAM 3:12">ಅಂಜೂರದ ಗಿಡಗಳ ಹಾಗಿರುವುವು.</para>
  <para style="q1" vid="NAM 3:12">ಅಲ್ಲಾಡಿಸಿದರೆ ಹಣ್ಣು</para>
  <para style="q2" vid="NAM 3:12">ತಿನ್ನುವವನ ಬಾಯಿಗೆ ಬೀಳುವುದು.<verse eid="NAM 3:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="NAM 3:13"/>ಇಗೋ, ನಿನ್ನ ಸೈನ್ಯಗಳನ್ನು ನೋಡು.</para>
  <para style="q2" vid="NAM 3:13">ಅವರೆಲ್ಲರೂ ಮಹಿಳೆಯರೇ.</para>
  <para style="q1" vid="NAM 3:13">ನಿನ್ನ ದೇಶದ ಬಾಗಿಲುಗಳು</para>
  <para style="q2" vid="NAM 3:13">ನಿನ್ನ ಶತ್ರುಗಳಿಗೆ ವಿಶಾಲವಾಗಿ ತೆರೆದಿವೆ.</para>
  <para style="q2" vid="NAM 3:13">ಬೆಂಕಿ ನಿನ್ನ ಅಗುಳಿಗಳನ್ನು ತಿಂದುಬಿಟ್ಟಿದೆ.<verse eid="NAM 3:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="NAM 3:14"/>ಮುತ್ತಿಗೆಗೋಸ್ಕರ ನೀರನ್ನು ಸೇದು;</para>
  <para style="q2" vid="NAM 3:14">ನಿನ್ನ ಬಲವಾದ ಕೋಟೆಗಳನ್ನು ಭದ್ರಮಾಡು; ಕೆಸರಿನಲ್ಲಿ ಸೇರು;</para>
  <para style="q1" vid="NAM 3:14">ಮಣ್ಣನ್ನು ತುಳಿ;</para>
  <para style="q2" vid="NAM 3:14">ಇಟ್ಟಿಗೆ ಅಚ್ಚನ್ನು ಹಿಡಿ.<verse eid="NAM 3:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="NAM 3:15"/>ಅಲ್ಲೇ ಬೆಂಕಿ ನಿನ್ನನ್ನು ತಿನ್ನುವುದು;</para>
  <para style="q2" vid="NAM 3:15">ಖಡ್ಗವು ನಿನ್ನನ್ನು ಕಡಿದುಬಿಡುವುದು;</para>
  <para style="q2" vid="NAM 3:15">ಹುಲ್ಲು ಮೇಯುವ ಹುಳ ನಿನ್ನನ್ನು ತಿಂದುಬಿಡುವುದು;</para>
  <para style="q1" vid="NAM 3:15">ಬಹುಮಂದಿಯಾಗು, ಮಿಡತೆಗಳಂತೆ</para>
  <para style="q2" vid="NAM 3:15">ಬಹುಮಂದಿಯಾಗು, ಗುಂಪು ಮಿಡತೆಗಳಂತೆ<verse eid="NAM 3:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="NAM 3:16"/>ನಿನ್ನ ವರ್ತಕರನ್ನು ಆಕಾಶದ ನಕ್ಷತ್ರಗಳಿಗಿಂತ</para>
  <para style="q2" vid="NAM 3:16">ಹೆಚ್ಚಾಗಿ ಸಂಖ್ಯೆಯಲ್ಲಿ ಬೆಳೆಸಿದ್ದೀ.</para>
  <para style="q1" vid="NAM 3:16">ಆದರೆ ಅವರು ಮಿಡತೆಗಳಂತೆ ದೇಶವನ್ನು</para>
  <para style="q2" vid="NAM 3:16">ಸುಲಿದುಕೊಂಡು ಹಾರಿಹೋಗುವರು.<verse eid="NAM 3:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="NAM 3:17"/>ನಿನ್ನ ಕಾವಲುಗಾರರು ಮಿಡತೆಗಳ ಹಾಗೆಯೂ,</para>
  <para style="q2" vid="NAM 3:17">ನಿನ್ನ ಅಧಿಪತಿಗಳು ತಂಪಾದ ದಿವಸದಲ್ಲಿ ಬೇಲಿಗಳೊಳಗೆ</para>
  <para style="q2" vid="NAM 3:17">ಇಳಿದುಕೊಳ್ಳುವ ದೊಡ್ಡ ಮಿಡತೆಗಳ ಹಾಗೆಯೂ ಇದ್ದಾರೆ.</para>
  <para style="q1" vid="NAM 3:17">ಸೂರ್ಯೋದಯವಾಗುವಾಗ ಹಾರಿ ಹೋಗುತ್ತವೆ.</para>
  <para style="q2" vid="NAM 3:17">ಆಗ ಅವು ಎಲ್ಲಿದ್ದಾವೆಂದು ಅವುಗಳ ಸ್ಥಳವು ತಿಳಿಯುವುದಿಲ್ಲ.<verse eid="NAM 3:17"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="18" style="v" sid="NAM 3:18"/>ಅಸ್ಸೀರಿಯದ ಅರಸನೇ, ನಿನ್ನ ಕುರುಬರು ತೂಕಡಿಸುತ್ತಾರೆ.</para>
  <para style="q2" vid="NAM 3:18">ನಿನ್ನ ಪ್ರಧಾನರು ವಿಶ್ರಾಂತಿಗೈಯುತ್ತಿದ್ದಾರೆ.</para>
  <para style="q1" vid="NAM 3:18">ಕೂಡಿಸುವವರು ಯಾರೂ ಇಲ್ಲದಂತೆ</para>
  <para style="q2" vid="NAM 3:18">ನಿನ್ನ ಜನರೆಲ್ಲರೂ ಬೆಟ್ಟಗಳಲ್ಲಿ ಚದರಿಹೋಗಿದ್ದಾರೆ.<verse eid="NAM 3:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="NAM 3:19"/>ನಿನ್ನ ಗಾಯಕ್ಕೆ ಮದ್ದಿಲ್ಲ,</para>
  <para style="q2" vid="NAM 3:19">ನಿನ್ನ ಗಾಯ ಪ್ರಾಣನಾಶಕ.</para>
  <para style="q1" vid="NAM 3:19">ನಿನ್ನ ಸುದ್ದಿಯನ್ನು ಕೇಳುವವರೆಲ್ಲರೂ</para>
  <para style="q2" vid="NAM 3:19">ನಿನ್ನ ಪತನಕ್ಕಾಗಿ ಕೈ ತಟ್ಟುವರು.</para>
  <para style="q1" vid="NAM 3:19">ಏಕೆಂದರೆ ನಿನ್ನ ಕೆಡುಕಿಗೆ</para>
  <para style="q2" vid="NAM 3:19">ನಿತ್ಯವೂ ಗುರಿಯಾಗದವರು ಯಾರಿದ್ದಾರೆ?<verse eid="NAM 3:19"/></para>
  <chapter eid="NAM 3"/>
</usx>
