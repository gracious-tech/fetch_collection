<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="2TI" style="id">- Biblica® Open Kannada Contemporary Version</book>
  <para style="h">2 ತಿಮೊಥೆಯನಿಗೆ</para>
  <para style="toc1">ತಿಮೊಥೆಯನಿಗೆ ಪೌಲನು ಬರೆದ ಎರಡನೆಯ ಪತ್ರಿಕೆ</para>
  <para style="toc2">2 ತಿಮೊಥೆಯನಿಗೆ</para>
  <para style="toc3">2 ತಿಮೊಥೆ</para>
  <para style="mt1">ತಿಮೊಥೆಯನಿಗೆ</para>
  <para style="mt2">ಪೌಲನು ಬರೆದ ಎರಡನೆಯ ಪತ್ರಿಕೆ</para>
  <chapter number="1" style="c" sid="2TI 1"/>
  <para style="p">
    <verse number="1" style="v" sid="2TI 1:1"/>ಕ್ರಿಸ್ತ ಯೇಸುವಿನಲ್ಲಿರುವ ಜೀವ ವಾಗ್ದಾನದ ಪ್ರಕಾರ ದೇವರ ಚಿತ್ತದಿಂದ ಕ್ರಿಸ್ತ ಯೇಸುವಿನ ಅಪೊಸ್ತಲನಾದ ಪೌಲನೆಂಬ ನಾನು,<verse eid="2TI 1:1"/></para>
  <para style="b"/>
  <para style="p">
    <verse number="2" style="v" sid="2TI 1:2"/>ನನ್ನ ಪ್ರಿಯ ಪುತ್ರನಾದ ತಿಮೊಥೆಯನಿಗೆ ಬರೆಯುವುದು:</para>
  <para style="b" vid="2TI 1:2"/>
  <para style="p" vid="2TI 1:2">ತಂದೆ ದೇವರಿಂದಲೂ ನಮಗೆ ಕರ್ತ ಆಗಿರುವ ಕ್ರಿಸ್ತ ಯೇಸುವಿನಿಂದಲೂ ಕೃಪೆಯೂ ಕರುಣೆಯೂ ಶಾಂತಿಯೂ ಆಗಲಿ.<verse eid="2TI 1:2"/></para>
  <para style="b"/>
  <para style="s1">ನಂಬಿಗಸ್ತನಾಗಿರಲು ಪ್ರೋತ್ಸಾಹ</para>
  <para style="p">
    <verse number="3" style="v" sid="2TI 1:3"/>ನಾನು ಹಗಲಿರುಳು ನನ್ನ ಪ್ರಾರ್ಥನೆಗಳಲ್ಲಿ ನಿನ್ನನ್ನು ತಪ್ಪದೆ ನೆನೆಸಿಕೊಳ್ಳುತ್ತೇನೆ. ಇದಲ್ಲದೆ ಶುದ್ಧ ಮನಸ್ಸಾಕ್ಷಿಯುಳ್ಳವನಾಗಿ ನಾನು ನನ್ನ ಪೂರ್ವಿಕರಂತೆ ದೇವರ ಸೇವೆಮಾಡುತ್ತಾ ದೇವರಿಗೆ ಕೃತಜ್ಞತೆಯನ್ನು ಸಲ್ಲಿಸುತ್ತೇನೆ. <verse eid="2TI 1:3"/><verse number="4" style="v" sid="2TI 1:4"/>ನಾನು ನಿನ್ನ ಕಣ್ಣೀರನ್ನು ನೆನಪಿಗೆ ತಂದು, ನಿನ್ನನ್ನು ನೋಡಿ ಆನಂದಭರಿತನಾಗಬೇಕೆಂದು ಬಹಳವಾಗಿ ಹಂಬಲಿಸುತ್ತೇನೆ. <verse eid="2TI 1:4"/><verse number="5" style="v" sid="2TI 1:5"/>ನಿನ್ನಲ್ಲಿರುವ ನಿಷ್ಕಪಟವಾದ ನಂಬಿಕೆಯು ನನ್ನ ನೆನಪಿನಲ್ಲಿದೆ. ನಿನ್ನ ಅಜ್ಜಿಯಾದ ಲೋವಿಯಲ್ಲಿಯೂ ನಿನ್ನ ತಾಯಿಯಾದ ಯೂನಿಕೆಯಲ್ಲಿಯೂ ಮೊದಲು ಇದ್ದ ನಂಬಿಕೆಯು ಈಗ ನಿನ್ನಲ್ಲಿಯೂ ಇದೆಯೆಂದು ನಾನು ದೃಢವಾಗಿ ನಂಬಿದ್ದೇನೆ.<verse eid="2TI 1:5"/></para>
  <para style="s1">ಪೌಲನಿಗೂ ಸುವಾರ್ತೆಗೂ ಇರಬೇಕಾದ ನಂಬಿಗಸ್ತಿಕೆ</para>
  <para style="p">
    <verse number="6" style="v" sid="2TI 1:6"/>ಆದಕಾರಣ ನಾನು ನಿನ್ನ ತಲೆಯ ಮೇಲೆ ಹಸ್ತಗಳನ್ನು ಇಟ್ಟಿದ್ದರ ಮೂಲಕ ನಿನಗೆ ದೊರಕಿದ ದೇವರ ವರವು ಪ್ರಜ್ವಲಿಸುವಂತೆ ಮಾಡಬೇಕೆಂದು ನಿನಗೆ ಜ್ಞಾಪಕ ಮಾಡುತ್ತೇನೆ. <verse eid="2TI 1:6"/><verse number="7" style="v" sid="2TI 1:7"/>ದೇವರು ನಮಗೆ ಕೊಟ್ಟಿರುವ ಆತ್ಮವು ಶಕ್ತಿ, ಪ್ರೀತಿ ಹಾಗೂ ಸ್ವಶಿಸ್ತು ಆತ್ಮವೇ ಹೊರತು ಭಯದ ಆತ್ಮವಲ್ಲ. <verse eid="2TI 1:7"/><verse number="8" style="v" sid="2TI 1:8"/>ಹೀಗಿರುವುದರಿಂದ ನಮ್ಮ ಕರ್ತ ಯೇಸುವಿನ ಸಾಕ್ಷಿಯ ವಿಷಯವಾಗಿಯೂ ಅವರ ಸೆರೆಯವನಾದ ನನ್ನ ವಿಷಯವಾಗಿಯೂ ನೀನು ನಾಚಿಕೆಪಡಬೇಡ. ಅದರ ಬದಲಾಗಿ, ದೇವರ ಶಕ್ತಿಗೆ ಅನುಸಾರವಾಗಿ, ಸುವಾರ್ತೆಗೋಸ್ಕರ ನನ್ನೊಂದಿಗೆ ಶ್ರಮೆಯನ್ನು ಅನುಭವಿಸು. <verse eid="2TI 1:8"/><verse number="9" style="v" sid="2TI 1:9"/>ದೇವರು ನಮ್ಮ ಕ್ರಿಯೆಗಳಿಗನುಸಾರವಾಗಿ ಅಲ್ಲ, ತಮ್ಮ ಸ್ವಂತ ಸಂಕಲ್ಪ ಮತ್ತು ಕೃಪೆಯ ಪ್ರಕಾರ ನಮ್ಮನ್ನು ರಕ್ಷಿಸಿ ಪರಿಶುದ್ಧವಾದ ಜೀವಿತಕ್ಕೆ ನಮ್ಮನ್ನು ಕರೆದರು. ಈ ಕೃಪೆಯು ಕಾಲದ ಆರಂಭಕ್ಕೆ ಮುಂಚೆಯೇ ಕ್ರಿಸ್ತ ಯೇಸುವಿನಲ್ಲಿ ನಮಗೆ ಕೊಡಲಾಯಿತು. <verse eid="2TI 1:9"/><verse number="10" style="v" sid="2TI 1:10"/>ಆದರೆ ಈಗ ನಮಗೆ ರಕ್ಷಕ ಆಗಿರುವ ಕ್ರಿಸ್ತ ಯೇಸುವಿನ ಪ್ರತ್ಯಕ್ಷತೆಯ ಮೂಲಕ ಕೃಪೆ ಪ್ರಕಟವಾಯಿತು. ಕ್ರಿಸ್ತ ಯೇಸು ಮರಣವನ್ನು ನಾಶಮಾಡಿ, ಸುವಾರ್ತೆಯ ಮೂಲಕ ಜೀವವನ್ನೂ ನಿರ್ಲಯತ್ವವನ್ನೂ ಪ್ರಕಾಶಗೊಳಿಸಿದರು. <verse eid="2TI 1:10"/><verse number="11" style="v" sid="2TI 1:11"/>ಈ ಸುವಾರ್ತೆಯನ್ನು ನಾನು ಸಾರುವವನಾಗಿಯೂ ಅಪೊಸ್ತಲನಾಗಿಯೂ ಯೆಹೂದ್ಯರಲ್ಲದವರಿಗೆ ಉಪದೇಶಕನಾಗಿಯೂ ದೇವರಿಂದ ನೇಮಕವಾದೆನು. <verse eid="2TI 1:11"/><verse number="12" style="v" sid="2TI 1:12"/>ಇದಕ್ಕಾಗಿಯೇ ನಾನು ಈ ಶ್ರಮೆಗಳನ್ನು ಅನುಭವಿಸುತ್ತಿದ್ದೇನೆ. ಆದರೆ ನಾನು ನಾಚಿಕೆಪಡುವುದಿಲ್ಲ. ಏಕೆಂದರೆ ನಾನು ನಂಬಿರುವ ಕ್ರಿಸ್ತ ಯೇಸುವನ್ನು ಬಲ್ಲೆನು. ನಾನು ಕ್ರಿಸ್ತ ಯೇಸುವಿಗೆ ಒಪ್ಪಿಸಿದ್ದನ್ನು ಅವರು ಆ ದಿನಕ್ಕಾಗಿ ಕಾಪಾಡುವುದಕ್ಕೆ ಶಕ್ತರಾಗಿದ್ದಾರೆಂಬ ದೃಢವಿಶ್ವಾಸ ನನಗಿದೆ.<verse eid="2TI 1:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="2TI 1:13"/>ನೀನು ನನ್ನಿಂದ ಕೇಳಿದ ಸ್ವಸ್ಥವಾಕ್ಯಗಳನ್ನು ಕ್ರಿಸ್ತ ಯೇಸುವಿನಲ್ಲಿರುವ ವಿಶ್ವಾಸ ಹಾಗೂ ಪ್ರೀತಿಯೊಂದಿಗೆ ಒಂದು ಮಾದರಿಯಾಗಿ ಹಿಡಿದುಕೋ. <verse eid="2TI 1:13"/><verse number="14" style="v" sid="2TI 1:14"/>ನಿನಗೆ ಒಪ್ಪಿಸಲಾಗಿರುವ ಆ ಒಳ್ಳೆಯದನ್ನು ನಮ್ಮಲ್ಲಿ ವಾಸವಾಗಿರುವ ಪವಿತ್ರಾತ್ಮ ದೇವರ ಮೂಲಕ ನೀನು ಕಾಪಾಡು.<verse eid="2TI 1:14"/></para>
  <para style="s1">ನಂಬಿಗಸ್ತಿಕೆ ಮತ್ತು ಅಪನಂಬಿಗಸ್ತಿಕೆ</para>
  <para style="p">
    <verse number="15" style="v" sid="2TI 1:15"/>ಏಷ್ಯ ಸೀಮೆಯಲ್ಲಿ ಫುಗೇಲನೂ ಹರ್ಮೊಗೇನನೂ ಒಳಗೊಂಡು ಎಲ್ಲರೂ ನನ್ನನ್ನು ಬಿಟ್ಟು ಹೋದರೆಂಬುದನ್ನು ನೀನು ಬಲ್ಲೆ.<verse eid="2TI 1:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="2TI 1:16"/>ಒನೇಸಿಫೊರನ ಮನೆಯವರಿಗೆ ಕರ್ತ ಯೇಸು ಕರುಣೆಯನ್ನು ದಯಪಾಲಿಸಲಿ. ಏಕೆಂದರೆ ಅವನು ಅನೇಕಾವರ್ತಿ ನನ್ನನ್ನು ಉತ್ತೇಜನ ಪಡಿಸಿದನು. ನನ್ನ ಬೇಡಿಗಳಿಗೆ ನಾಚಿಕೆ ಪಡಲಿಲ್ಲ. <verse eid="2TI 1:16"/><verse number="17" style="v" sid="2TI 1:17"/>ಆದರೆ ಅವನು ರೋಮಿನಲ್ಲಿದ್ದಾಗ ಪ್ರಯಾಸದಿಂದ ನನ್ನನ್ನು ಹುಡುಕಿ ಕಂಡುಕೊಂಡನು. <verse eid="2TI 1:17"/><verse number="18" style="v" sid="2TI 1:18"/>ಅವನು ಆ ದಿನದಲ್ಲಿ ಕರ್ತ ಯೇಸುವಿನಿಂದ ಕರುಣೆಯನ್ನು ಕಂಡುಕೊಳ್ಳುವಂತೆ ಕರ್ತ ಯೇಸುವೇ ಅವನಿಗೆ ಅನುಗ್ರಹ ಮಾಡಲಿ. ಎಫೆಸದಲ್ಲಿ ಅವನು ನನಗೆ ಎಷ್ಟು ಸಹಾಯಮಾಡಿದನೆಂಬುದು ನಿನಗೆ ಚೆನ್ನಾಗಿ ಗೊತ್ತಿದೆ.<verse eid="2TI 1:18"/></para>
  <chapter eid="2TI 1"/>
  <chapter number="2" style="c" sid="2TI 2"/>
  <para style="s1">ಕ್ರಿಸ್ತ ಯೇಸುವಿನ ಒಳ್ಳೆಯ ಸೈನಿಕ</para>
  <para style="p">
    <verse number="1" style="v" sid="2TI 2:1"/>ಆದ್ದರಿಂದ ನನ್ನ ಮಗನೇ, ನೀನು ಕ್ರಿಸ್ತ ಯೇಸುವಿನಲ್ಲಿರುವ ಕೃಪೆಯಲ್ಲಿ ಬಲಗೊಂಡವನಾಗಿರು. <verse eid="2TI 2:1"/><verse number="2" style="v" sid="2TI 2:2"/>ಅನೇಕ ಸಾಕ್ಷಿಗಳ ಮುಂದೆ ನೀನು ನನ್ನಿಂದ ಕೇಳಿದವುಗಳನ್ನು ಇತರರಿಗೆ ಸಹ ಬೋಧಿಸಲು ಶಕ್ತರಾದ ನಂಬಿಗಸ್ತ ಮನುಷ್ಯರಿಗೆ ಒಪ್ಪಿಸಿಕೊಡು. <verse eid="2TI 2:2"/><verse number="3" style="v" sid="2TI 2:3"/>ಆದ್ದರಿಂದ ನೀನು ಕ್ರಿಸ್ತ ಯೇಸುವಿನ ಒಳ್ಳೆಯ ಸೈನಿಕನಂತೆ ನನ್ನೊಂದಿಗೆ ಶ್ರಮೆಯನ್ನು ಅನುಭವಿಸು. <verse eid="2TI 2:3"/><verse number="4" style="v" sid="2TI 2:4"/>ತನ್ನನ್ನು ಸೈನಿಕನನ್ನಾಗಿ ಆರಿಸಿಕೊಂಡ ನಾಯಕನನ್ನು ಮೆಚ್ಚಿಸಬೇಕೆಂದು ಯುದ್ಧಕ್ಕೆ ಹೋಗುವವನು ಈ ಜೀವನದ ವ್ಯವಹಾರಗಳಲ್ಲಿ ಸಿಕ್ಕಿಕೊಳ್ಳಲಾರನು. <verse eid="2TI 2:4"/><verse number="5" style="v" sid="2TI 2:5"/>ಇದಲ್ಲದೆ ಯಾವನಾದರೂ ಆಟದ ಸ್ವರ್ಧೆಯಲ್ಲಿ ಹೋರಾಡುವಾಗ ನಿಯಮದ ಪ್ರಕಾರ ಹೋರಾಡದಿದ್ದರೆ, ಅವನು ಜಯಶಾಲಿಯ ಕಿರೀಟ ಹೊಂದುವುದಿಲ್ಲ. <verse eid="2TI 2:5"/><verse number="6" style="v" sid="2TI 2:6"/>ಪ್ರಯಾಸ ಪಡುವ ವ್ಯವಸಾಯಗಾರನು ಫಲಗಳಲ್ಲಿ ಮೊದಲನೆಯದಾಗಿ ಪಾಲುಗಾರನಾಗಿರತಕ್ಕದ್ದು. <verse eid="2TI 2:6"/><verse number="7" style="v" sid="2TI 2:7"/>ನಾನು ಹೇಳುತ್ತಿರುವುದನ್ನು ಆಲೋಚಿಸು. ಕರ್ತ ಯೇಸುವು ಇವೆಲ್ಲವುಗಳಲ್ಲಿ ನಿನಗೆ ವಿವೇಕವನ್ನು ದಯಪಾಲಿಸುವರು.<verse eid="2TI 2:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="2TI 2:8"/>ನನ್ನ ಸುವಾರ್ತೆಯ ಸಾರೋಣಕ್ಕೆ ಅನುಸಾರವಾಗಿ ದಾವೀದನ ವಂಶದವರಾದ ಯೇಸು ಕ್ರಿಸ್ತರು ಸತ್ತವರೊಳಗಿಂದ ಎಬ್ಬಿಸಲಾದರೆಂದು ಜ್ಞಾಪಕಮಾಡಿಕೋ. <verse eid="2TI 2:8"/><verse number="9" style="v" sid="2TI 2:9"/>ಈ ಸುವಾರ್ತೆಗಾಗಿ ನಾನು ಕಷ್ಟವನ್ನು ಅನುಭವಿಸಿ ದುಷ್ಕರ್ಮಿಯಂತೆ ಬೇಡಿಗಳಿಂದ ಬಂಧಿತನಾಗಿದ್ದೇನೆ. ಆದರೆ ದೇವರ ವಾಕ್ಯಕ್ಕೆ ಬಂಧನವಿಲ್ಲ. <verse eid="2TI 2:9"/><verse number="10" style="v" sid="2TI 2:10"/>ಆದಕಾರಣ ಆರಿಸಿಕೊಂಡವರು ಸಹ ಕ್ರಿಸ್ತ ಯೇಸುವಿನಲ್ಲಿರುವ ರಕ್ಷಣೆಯನ್ನು ನಿತ್ಯ ಮಹಿಮೆ ಸಹಿತವಾಗಿ ಹೊಂದಬೇಕೆಂದು ನಾನು ಅವರಿಗೋಸ್ಕರ ಎಲ್ಲವನ್ನೂ ಸಹಿಸಿಕೊಳ್ಳುತ್ತೇನೆ.<verse eid="2TI 2:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="2TI 2:11"/>ಇದು ನಂಬತಕ್ಕ ವಾಕ್ಯವಾಗಿದೆ:</para>
  <para style="q1" vid="2TI 2:11">ನಾವು ಕ್ರಿಸ್ತ ಯೇಸುವಿನ ಜೊತೆಯಲ್ಲಿ ಸತ್ತಿದ್ದರೆ,</para>
  <para style="q2" vid="2TI 2:11">ಕ್ರಿಸ್ತ ಯೇಸುವಿನ ಜೊತೆಯಲ್ಲಿ ನಾವು ಸಹ ಜೀವಿಸುವೆವು.<verse eid="2TI 2:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="2TI 2:12"/>ನಾವು ಸಹಿಸಿಕೊಳ್ಳುವವರಾಗಿದ್ದರೆ</para>
  <para style="q2" vid="2TI 2:12">ಕ್ರಿಸ್ತ ಯೇಸುವಿನ ಜೊತೆಯಲ್ಲಿ ನಾವು ಸಹ ಆಳುವೆವು.</para>
  <para style="q1" vid="2TI 2:12">ಅವರನ್ನು ನಿರಾಕರಿಸಿದರೆ</para>
  <para style="q2" vid="2TI 2:12">ಅವರು ಸಹ ನಮ್ಮನ್ನು ನಿರಾಕರಿಸುವರು.<verse eid="2TI 2:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="2TI 2:13"/>ನಾವು ಅಪನಂಬಿಗಸ್ತರಾಗಿದ್ದರೂ</para>
  <para style="q2" vid="2TI 2:13">ಅವರು ನಂಬಿಗಸ್ತರಾಗಿಯೇ ಉಳಿದಿರುವರು.</para>
  <para style="q2" vid="2TI 2:13">ಅವರು ತಮ್ಮ ಸ್ವಭಾವವನ್ನು ತಾವೇ ನಿರಾಕರಿಸಲಾರರು.<verse eid="2TI 2:13"/></para>
  <para style="s1">ದೇವರಿಂದ ಮನ್ನಣೆ ಹೊಂದಿದ ಕೆಲಸದವನು</para>
  <para style="p">
    <verse number="14" style="v" sid="2TI 2:14"/>ಈ ವಿಷಯಗಳನ್ನು ದೇವಜನರ ನೆನಪಿಗೆ ತರಬೇಕು. ಕೇಳುವವರಿಗೆ ಯಾವ ಪ್ರಯೋಜನವನ್ನೂ ಉಂಟು ಮಾಡದೆ ಕೆಡವಿ ಹಾಕುವ ವಾಗ್ವಾದಗಳನ್ನು ಮಾಡಬಾರದೆಂದು ಅವರಿಗೆ ದೇವರ ಮುಂದೆ ಎಚ್ಚರಿಸು. <verse eid="2TI 2:14"/><verse number="15" style="v" sid="2TI 2:15"/>ನೀನು ನಾಚಿಕೆಗೆ ಒಳಪಡದ ಕೆಲಸದವನೂ ಸತ್ಯವಾಕ್ಯವನ್ನು ಸರಿಯಾಗಿ ಬೋಧಿಸುವವನೂ ಆಗಿರುವಂತೆ ನಿನ್ನನ್ನು ದೇವರಿಗೆ ಮೆಚ್ಚಿಕೆಯಾದವನಾಗಿರಲು ಸಮರ್ಪಿಸಲು ಅತ್ಯಂತ ಆಸಕ್ತನಾಗಿರು. <verse eid="2TI 2:15"/><verse number="16" style="v" sid="2TI 2:16"/>ಆದರೆ ಭಕ್ತಿಗೆ ವಿರುದ್ಧವಾದ ಹರಟೆ ಮಾತುಗಳಿಂದ ತೊಲಗಿರು. ಅವುಗಳಿಗೆ ಮನಸ್ಸು ಕೊಡುವವರು ಹೆಚ್ಚೆಚ್ಚಾಗಿ ಭಕ್ತಿಹೀನರಾಗುವರು. <verse eid="2TI 2:16"/><verse number="17" style="v" sid="2TI 2:17"/>ಅವರ ಬೋಧನೆ ಮಾರಕ ಹುಣ್ಣಿನಂತೆ ಹರಡಿಕೊಳ್ಳುವುದು. ಅವರಲ್ಲಿ ಹುಮೆನಾಯನೂ ಪಿಲೇತನೂ ಇದ್ದಾರೆ. <verse eid="2TI 2:17"/><verse number="18" style="v" sid="2TI 2:18"/>ಅವರು ಪುನರುತ್ಥಾನವು ಆಗಲೇ ಆಗಿ ಹೋಯಿತೆಂದು ಹೇಳುತ್ತಾ ಸತ್ಯದ ಗುರಿಯನ್ನು ತಪ್ಪಿದವರಾಗಿ ಕೆಲವರ ವಿಶ್ವಾಸವನ್ನು ಕೆಡಿಸಿಬಿಡುವವರಾಗಿದ್ದಾರೆ. <verse eid="2TI 2:18"/><verse number="19" style="v" sid="2TI 2:19"/>ಆದರೂ ದೇವರ ಸ್ಥಿರವಾದ ಅಸ್ತಿವಾರವು ನಿಲ್ಲುತ್ತದೆ. ಅದರ ಮೇಲೆ, “ತನ್ನವರು ಯಾರಾರೆಂಬುದನ್ನು ಕರ್ತದೇವರು ತಿಳಿದಿದ್ದಾರೆ!” ಎಂತಲೂ, “ಕರ್ತದೇವರ ಹೆಸರನ್ನು ಅರಿಕೆಮಾಡುವವರೆಲ್ಲರೂ ದುಷ್ಟತನವನ್ನು ಬಿಟ್ಟುಬಿಡಬೇಕು!” ಎಂತಲೂ ಮುದ್ರೆ ಉಂಟು.<verse eid="2TI 2:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="2TI 2:20"/>ದೊಡ್ಡ ಮನೆಯಲ್ಲಿ ಬೆಳ್ಳಿಬಂಗಾರದ ಪಾತ್ರೆಗಳಲ್ಲದೆ ಮರದ ಹಾಗೂ ಮಣ್ಣಿನ ಪಾತ್ರೆಗಳೂ ಇರುತ್ತವೆ. ಕೆಲವು ವಿಶೇಷ ಉದ್ದೇಶಗಳಿಗಾಗಿಯೂ ಕೆಲವು ಸಾಮಾನ್ಯ ಉಪಯೋಗಕ್ಕಾಗಿಯೂ ಇರುತ್ತವೆ. <verse eid="2TI 2:20"/><verse number="21" style="v" sid="2TI 2:21"/>ಒಬ್ಬನು ತನ್ನನ್ನು ಸಾಮಾನ್ಯ ಘನಹೀನತೆಯಿಂದ ಶುದ್ಧಮಾಡಿಕೊಂಡರೆ, ಅವನು ವಿಶೇಷ ಉದ್ದೇಶಕ್ಕಾಗಿ ಶುದ್ಧೀಕರಗೊಂಡವನೂ ಯಜಮಾನನಿಗೆ ಉಪಯುಕ್ತನೂ ಸಕಲ ಸತ್ಕಾರ್ಯಕ್ಕೆ ಸಿದ್ಧನೂ ಆಗಿರುವ ಗೌರವದ ಪಾತ್ರೆಯಾಗಿರುವನು.<verse eid="2TI 2:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="2TI 2:22"/>ಯೌವನದ ಆಶೆಗಳನ್ನು ಬಿಟ್ಟು ಓಡಿಹೋಗು. ಶುದ್ಧ ಹೃದಯವುಳ್ಳವರಾಗಿ ಕರ್ತ ಯೇಸುವನ್ನು ಬೇಡಿಕೊಳ್ಳುವವರ ಸಂಗಡ ನೀತಿ, ವಿಶ್ವಾಸ, ಪ್ರೀತಿ, ಸಮಾಧಾನ ಇವುಗಳನ್ನು ಬೆನ್ನಟ್ಟು. <verse eid="2TI 2:22"/><verse number="23" style="v" sid="2TI 2:23"/>ಬುದ್ಧಿಯಿಲ್ಲದ ಅಯುಕ್ತ ವಾಗ್ವಾದಗಳು ಜಗಳಗಳನ್ನು ಹುಟ್ಟಿಸುತ್ತವೆ ಎಂದು ತಿಳಿದು ಅವುಗಳನ್ನು ನಿರಾಕರಿಸು. <verse eid="2TI 2:23"/><verse number="24" style="v" sid="2TI 2:24"/>ಕರ್ತ ಯೇಸುವಿನ ದಾಸನು ಜಗಳವಾಡದೆ ಎಲ್ಲರ ವಿಷಯದಲ್ಲಿ ದಯೆಯುಳ್ಳವನೂ ಬೋಧಿಸುವುದರಲ್ಲಿ ಪ್ರವೀಣನೂ ಸಹನೆಯುಳ್ಳವನೂ ಆಗಿರಬೇಕು. <verse eid="2TI 2:24"/><verse number="25" style="v" sid="2TI 2:25"/>ವಿರೋಧಿಸುವವರ ಮನಸ್ಸನ್ನು ತಾಳ್ಮೆಯಿಂದ ತಿದ್ದುವವನಾಗಿದ್ದರೆ, ದೇವರು ಒಂದು ವೇಳೆ ಅಂಥವರಿಗೆ ಸತ್ಯದ ತಿಳುವಳಿಕೆಗೆ ನಡೆಸುವ ಪಶ್ಚಾತ್ತಾಪವನ್ನು ಕೊಡುವ ನಿರೀಕ್ಷೆ ಇರುವುದು. <verse eid="2TI 2:25"/><verse number="26" style="v" sid="2TI 2:26"/>ಈ ರೀತಿಯಾಗಿ, ಸೈತಾನನ ಚಿತ್ತವನ್ನು ನೆರವೇರಿಸಲು ಗುಲಾಮರಾಗಿರುವವರು, ಅವನ ಬಲೆಯಿಂದ ಬಿಡುಗಡೆಹೊಂದಿ ಸ್ವಸ್ಥಮನಸ್ಸುಳ್ಳವರಾಗಿ ತಪ್ಪಿಸಿಕೊಳ್ಳುವರು.<verse eid="2TI 2:26"/></para>
  <chapter eid="2TI 2"/>
  <chapter number="3" style="c" sid="2TI 3"/>
  <para style="p">
    <verse number="1" style="v" sid="2TI 3:1"/>ಆದರೆ ಕಡೆಯ ದಿವಸಗಳಲ್ಲಿ ಕಷ್ಟಕರವಾದ ಕಾಲಗಳು ಬರುವುವೆಂಬುದನ್ನು ಸಹ ತಿಳಿದುಕೋ. <verse eid="2TI 3:1"/><verse number="2" style="v" sid="2TI 3:2"/>ಮನುಷ್ಯರು ತಮ್ಮನ್ನು ತಾವೇ ಪ್ರೀತಿಸಿಕೊಳ್ಳುವವರೂ ಹಣದಾಶೆಯುಳ್ಳವರೂ ಬಡಾಯಿ ಕೊಚ್ಚುವವರೂ ಅಹಂಕಾರಿಗಳೂ ದೇವದೂಷಕರೂ ತಂದೆತಾಯಿಗಳಿಗೆ ಅವಿಧೇಯರೂ ಕೃತಜ್ಞತೆಯಿಲ್ಲದವರೂ ಅಶುದ್ಧರೂ <verse eid="2TI 3:2"/><verse number="3" style="v" sid="2TI 3:3"/>ಮಾನವತ್ವವಿಲ್ಲದವರೂ ಸಮಾಧಾನವಾಗದವರೂ ಚಾಡಿಕೋರರೂ ಸಂಯಮವಿಲ್ಲದವರೂ ಉಗ್ರತೆಯುಳ್ಳವರೂ ಒಳ್ಳೆಯದನ್ನು ಪ್ರೀತಿಸದವರೂ <verse eid="2TI 3:3"/><verse number="4" style="v" sid="2TI 3:4"/>ದ್ರೋಹಿಗಳೂ ದುಡುಕುವವರೂ ಉಬ್ಬಿಕೊಂಡವರೂ ದೇವರನ್ನು ಪ್ರೀತಿಸುವುದಕ್ಕಿಂತಲೂ ಭೋಗಗಳನ್ನೇ ಪ್ರೀತಿಸುವವರೂ <verse eid="2TI 3:4"/><verse number="5" style="v" sid="2TI 3:5"/>ಭಕ್ತಿಯ ವೇಷವಿದ್ದು ಅದರ ಬಲವನ್ನು ಅಲ್ಲಗಳೆಯುವವರೂ ಆಗಿರುವರು. ಇಂಥವರನ್ನು ಬಿಟ್ಟು ಪ್ರತ್ಯೇಕವಾಗಿರು.<verse eid="2TI 3:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="2TI 3:6"/>ಇಂಥವರು ಮನೆಗಳಲ್ಲಿ ನುಸುಳಿ ಪಾಪಗಳಿಂದ ತುಂಬಿದವರೂ ನಾನಾ ವಿಧವಾದ ಇಚ್ಛೆಗಳಿಂದ ಪ್ರೇರಣೆ ಹೊಂದಿ ಸುಲಭವಾಗಿ ಮೋಸಹೋಗುವ ಸ್ತ್ರೀಯರನ್ನು ವಶಮಾಡಿಕೊಳ್ಳುವರು. <verse eid="2TI 3:6"/><verse number="7" style="v" sid="2TI 3:7"/>ಇಂಥ ಸ್ತ್ರೀಯರು ಯಾವಾಗಲೂ ಕಲಿಯುತ್ತಿದ್ದರೂ ಸತ್ಯದ ಜ್ಞಾನಕ್ಕೆ ಬರಲಾರದವರು ಆಗಿರುವರು. <verse eid="2TI 3:7"/><verse number="8" style="v" sid="2TI 3:8"/>ಯನ್ನ, ಯಂಬ್ರ ಎಂಬವರು ಮೋಶೆಯನ್ನು ವಿರೋಧಿಸಿದಂತೆಯೇ, ಈ ಸುಳ್ಳು ಬೋಧಕರು ಸಹ ಸತ್ಯವನ್ನು ವಿರೋಧಿಸುತ್ತಾರೆ. ಇದಲ್ಲದೆ ಇವರು ಬುದ್ಧಿಗೆಟ್ಟವರೂ ವಿಶ್ವಾಸದ ವಿಷಯದಲ್ಲಿ ಭ್ರಷ್ಠರೂ ಆಗಿ, ತಿರಸ್ಕಾರ ಹೊಂದಿರುತ್ತಾರೆ. <verse eid="2TI 3:8"/><verse number="9" style="v" sid="2TI 3:9"/>ಆದರೆ ಇವರು ಇನ್ನು ಮುಂದುವರಿಯಲಾರರು. ಯನ್ನ, ಯಂಬ್ರರ ಮೂರ್ಖತನವು ಎಲ್ಲರಿಗೂ ಸ್ಪಷ್ಟವಾಗಿ ತಿಳಿದುಬಂದಂತೆಯೇ, ಇವರದೂ ತಿಳಿದುಬರುವುದು.<verse eid="2TI 3:9"/></para>
  <para style="s1">ತಿಮೊಥೆಗೆ ಪೌಲನ ಅಪ್ಪಣೆ</para>
  <para style="p">
    <verse number="10" style="v" sid="2TI 3:10"/>ನೀನಾದರೋ ನನ್ನ ಎಲ್ಲಾ ಬೋಧನೆ, ನನ್ನ ನಡತೆ, ನನ್ನ ಉದ್ದೇಶ, ನಂಬಿಕೆ, ದೀರ್ಘಶಾಂತಿ, ಪ್ರೀತಿ, ಸೈರಣೆ, <verse eid="2TI 3:10"/><verse number="11" style="v" sid="2TI 3:11"/>ನಾನು ಎಂತೆಂಥ ಹಿಂಸೆಗಳನ್ನು ಸಹಿಸಿಕೊಂಡೆನೆಂಬುದನ್ನೂ ಅಂತಿಯೋಕ್ಯ, ಇಕೋನ್ಯ, ಲುಸ್ತ್ರ ಪಟ್ಟಣಗಳಲ್ಲಿ ನನಗೆ ಸಂಭವಿಸಿದ ಕಷ್ಟಾನುಭವಗಳನ್ನೂ ನನಗುಂಟಾದ ಎಲ್ಲಾ ಹಿಂಸೆಗಳನ್ನೂ ನೀನು ಪೂರ್ಣವಾಗಿ ತಿಳಿದವನಾಗಿದ್ದೀ. ಆದರೆ ಕರ್ತದೇವರು ನನ್ನನ್ನು ಇವೆಲ್ಲವುಗಳಿಂದ ಬಿಡಿಸಿದರು. <verse eid="2TI 3:11"/><verse number="12" style="v" sid="2TI 3:12"/>ನಿಜವಾಗಿಯೂ ಕ್ರಿಸ್ತ ಯೇಸುವಿನಲ್ಲಿ ಭಕ್ತಿಯುಳ್ಳವರಾಗಿ ಜೀವಿಸುವುದಕ್ಕೆ ಮನಸ್ಸು ಮಾಡುವವರೆಲ್ಲರೂ ಹಿಂಸೆಗೊಳಗಾಗುವರು. <verse eid="2TI 3:12"/><verse number="13" style="v" sid="2TI 3:13"/>ಆದರೆ ದುಷ್ಟರೂ ಇತರರಂತೆ ನಟಿಸುವ ವೇಷಧಾರಿಗಳೂ ಇತರರನ್ನು ವಂಚಿಸುತ್ತಾ ತಮ್ಮನ್ನೂ ವಂಚಿಸಿಕೊಳ್ಳುತ್ತಾ ಹೆಚ್ಚಾದ ಕೆಟ್ಟತನಕ್ಕೆ ಸಾಗುವರು. <verse eid="2TI 3:13"/><verse number="14" style="v" sid="2TI 3:14"/>ನೀನಾದರೋ, ಕಲಿತು ನಿಶ್ಚಯಗೊಂಡವುಗಳಲ್ಲಿ ಮುಂದುವರಿಯುತ್ತಿರು. ನಿನಗೆ ಕಲಿಸಿಕೊಟ್ಟವರು ಯಾರೆಂಬುದು ನಿನಗೆ ತಿಳಿದಿದೆ. <verse eid="2TI 3:14"/><verse number="15" style="v" sid="2TI 3:15"/>ಕ್ರಿಸ್ತ ಯೇಸುವಿನಲ್ಲಿ ವಿಶ್ವಾಸದ ಮೂಲಕ ರಕ್ಷಣೆ ಹೊಂದುವಂತೆ ನಿನ್ನನ್ನು ಜ್ಞಾನಿಯನ್ನಾಗಿ ಮಾಡಲು ಶಕ್ತವಾಗಿರುವ ಪವಿತ್ರ ವೇದಗಳನ್ನು ನೀನು ಚಿಕ್ಕಂದಿನಿಂದಲೂ ತಿಳಿದವನಾಗಿದ್ದೀಯಲ್ಲಾ. <verse eid="2TI 3:15"/><verse number="16" style="v" sid="2TI 3:16"/>ಪವಿತ್ರ ವೇದಗಳೆಲ್ಲವೂ ದೇವರ ಶ್ವಾಸದಿಂದಲೇ ಉಂಟಾದದ್ದು. ಅದು ಉಪದೇಶಕ್ಕೂ ಖಂಡನೆಗೂ ತಿದ್ದುಪಾಟಿಗೂ ನೀತಿಯ ಶಿಕ್ಷಣಕ್ಕೂ ಉಪಯುಕ್ತವಾಗಿದೆ. <verse eid="2TI 3:16"/><verse number="17" style="v" sid="2TI 3:17"/>ಆದ್ದರಿಂದ ದೇವರ ಮನುಷ್ಯನು ಪರಿಪೂರ್ಣನಾಗಿ ಸಕಲ ಸತ್ಕಾರ್ಯಗಳಿಗೆ ಸನ್ನದ್ಧನಾಗುವನು.<verse eid="2TI 3:17"/></para>
  <chapter eid="2TI 3"/>
  <chapter number="4" style="c" sid="2TI 4"/>
  <para style="p">
    <verse number="1" style="v" sid="2TI 4:1"/>ದೇವರ ಮುಂದೆಯೂ ಜೀವಿಸುವವರಿಗೂ ಸತ್ತವರಿಗೂ ನ್ಯಾಯತೀರಿಸಲು ಕರ್ತ ಆಗಿರುವ ಕ್ರಿಸ್ತ ಯೇಸುವಿನ ಮುಂದೆಯೂ ಅವರ ಪ್ರತ್ಯಕ್ಷತೆ ಹಾಗೂ ಅವರ ರಾಜ್ಯದ ಮುಂದೆಯೂ ನಾನು ನಿನಗೆ ಆಜ್ಞಾಪಿಸಿ ಹೇಳುವುದೇನೆಂದರೆ: <verse eid="2TI 4:1"/><verse number="2" style="v" sid="2TI 4:2"/>ವಾಕ್ಯವನ್ನು ಸಾರು; ಅನುಕೂಲವಾದ ಕಾಲದಲ್ಲಿಯೂ ಅನುಕೂಲವಿಲ್ಲದ ಕಾಲದಲ್ಲಿಯೂ ಸಿದ್ಧವಾಗಿರು. ಎಲ್ಲಾ ತಾಳ್ಮೆಯಿಂದ ಉಪದೇಶಿಸಿ ಖಂಡಿಸು, ಗದರಿಸು, ಪ್ರೋತ್ಸಾಹಿಸು. <verse eid="2TI 4:2"/><verse number="3" style="v" sid="2TI 4:3"/>ಏಕೆಂದರೆ ಜನರು ಸ್ವಸ್ಥಬೋಧನೆಯನ್ನು ಸಹಿಸಲಾರದ ಕಾಲವು ಬರುತ್ತದೆ. ಆದರೆ ಅವರು ತಮ್ಮ ಕಿವಿಗಳು ಕೇಳಲು ಆಶೆಪಡುವ ಅನೇಕ ಉಪದೇಶಕರನ್ನು ಕೂಡಿಟ್ಟುಕೊಳ್ಳುವರು. <verse eid="2TI 4:3"/><verse number="4" style="v" sid="2TI 4:4"/>ಅವರು ಸತ್ಯಕ್ಕೆ ಕಿವಿಗೊಡದೆ ಕಟ್ಟುಕಥೆಗಳನ್ನು ಕೇಳುವುದಕ್ಕೆ ತಿರುಗಿಕೊಳ್ಳುವರು. <verse eid="2TI 4:4"/><verse number="5" style="v" sid="2TI 4:5"/>ಆದರೆ ನೀನು ಎಲ್ಲಾ ವಿಷಯಗಳಲ್ಲಿ ಸ್ವಸ್ಥಚಿತ್ತನಾಗಿರು. ಶ್ರಮೆಗಳನ್ನು ತಾಳಿಕೋ. ಸುವಾರ್ತಿಕನ ಕೆಲಸವನ್ನು ಮಾಡು. ನಿನ್ನ ಸೇವೆಯ ಎಲ್ಲಾ ಕರ್ತವ್ಯಗಳನ್ನು ನೆರವೇರಿಸು.<verse eid="2TI 4:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="2TI 4:6"/>ಏಕೆಂದರೆ ನಾನು ಈಗಲೇ ಪಾನ ಅರ್ಪಣೆಯಾಗಿ ಇದ್ದೇನೆ. ನಾನು ಹೊರಟುಹೋಗಬೇಕಾದ ಸಮಯವು ಹತ್ತಿರ ಬಂದಿದೆ. <verse eid="2TI 4:6"/><verse number="7" style="v" sid="2TI 4:7"/>ನಾನು ಒಳ್ಳೆಯ ಹೋರಾಟವನ್ನು ಮಾಡಿದ್ದೇನೆ. ನಾನು ಓಟವನ್ನು ಮುಗಿಸಿದ್ದೇನೆ. ನಾನು ವಿಶ್ವಾಸವನ್ನು ಕಾಪಾಡಿಕೊಂಡಿದ್ದೇನೆ. <verse eid="2TI 4:7"/><verse number="8" style="v" sid="2TI 4:8"/>ಈಗ ನನಗೋಸ್ಕರ ನೀತಿಯ ಕಿರೀಟವು ಇಡಲಾಗಿದೆ. ಅದನ್ನು ನೀತಿಯುಳ್ಳ ನ್ಯಾಯಾಧಿಪತಿಯಾದ ಕರ್ತದೇವರು ಆ ದಿನದಲ್ಲಿ ನನಗೆ ಕೊಡುವರು. ನನಗೆ ಮಾತ್ರವಲ್ಲದೆ ಅವರ ಪುನರಾಗಮನಕ್ಕಾಗಿ ಆಸಕ್ತಿಯಿಂದ ಕಾದಿರುವವರೆಲ್ಲರಿಗೂ ಕೊಡುವರು.<verse eid="2TI 4:8"/></para>
  <para style="s1">ವೈಯಕ್ತಿಕ ಹಿತನುಡಿಗಳು</para>
  <para style="p">
    <verse number="9" style="v" sid="2TI 4:9"/>ನನ್ನ ಬಳಿಗೆ ಆದಷ್ಟು ಬೇಗನೆ ಬರುವುದಕ್ಕೆ ನೀನು ಪ್ರಯತ್ನ ಮಾಡು. <verse eid="2TI 4:9"/><verse number="10" style="v" sid="2TI 4:10"/>ಏಕೆಂದರೆ ದೇಮನು ಇಹಲೋಕವನ್ನು ಪ್ರೀತಿಸಿ ನನ್ನನ್ನು ತೊರೆದುಬಿಟ್ಟು ಥೆಸಲೋನಿಕಕ್ಕೆ ಹೋದನು. ಕ್ರೆಸ್ಕನು ಗಲಾತ್ಯಕ್ಕೂ, ತೀತನು ದಲ್ಮಾತ್ಯಕ್ಕೂ ಹೋದನು. <verse eid="2TI 4:10"/><verse number="11" style="v" sid="2TI 4:11"/>ಲೂಕನು ಮಾತ್ರ ನನ್ನ ಜೊತೆಯಲ್ಲಿದ್ದಾನೆ. ಮಾರ್ಕನನ್ನು ನಿನ್ನ ಸಂಗಡ ಕರೆದುಕೊಂಡು ಬಾ. ಅವನು ನನ್ನ ಸೇವೆಗಾಗಿ ನನಗೆ ಉಪಯುಕ್ತನಾಗಿದ್ದಾನೆ. <verse eid="2TI 4:11"/><verse number="12" style="v" sid="2TI 4:12"/>ತುಖಿಕನನ್ನು ನಾನು ಎಫೆಸಕ್ಕೆ ಕಳುಹಿಸಿದೆನು. <verse eid="2TI 4:12"/><verse number="13" style="v" sid="2TI 4:13"/>ತ್ರೋವದಲ್ಲಿ ನಾನು ಕರ್ಪನ ಬಳಿ ಬಿಟ್ಟುಬಂದ ಮೇಲಂಗಿಯನ್ನೂ ಪುಸ್ತಕಗಳನ್ನೂ ಮುಖ್ಯವಾಗಿ ಚರ್ಮದ ಕಾಗದಗಳನ್ನೂ ನೀನು ಬರುವಾಗ ತೆಗೆದುಕೊಂಡು ಬಾ.<verse eid="2TI 4:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="2TI 4:14"/>ಕಂಚುಗಾರನಾದ ಅಲೆಕ್ಸಾಂದ್ರನು ನನಗೆ ಬಹಳ ಕೇಡು ಮಾಡಿದ್ದಾನೆ. ಕರ್ತದೇವರು ಅವನ ಕೃತ್ಯಗಳಿಗೆ ಅನುಸಾರವಾಗಿ ಅವನಿಗೆ ಪ್ರತಿಫಲವನ್ನು ಕೊಡಲಿ. <verse eid="2TI 4:14"/><verse number="15" style="v" sid="2TI 4:15"/>ನೀನು ಸಹ ಅವನ ವಿಷಯದಲ್ಲಿ ಎಚ್ಚರಿಕೆಯಿಂದಿರು. ಏಕೆಂದರೆ ಅವನು ನಮ್ಮ ಸಂದೇಶವನ್ನು ಬಹಳವಾಗಿ ವಿರೋಧಿಸಿದನು.<verse eid="2TI 4:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="2TI 4:16"/>ನಾನು ಮೊದಲನೆಯ ಸಾರಿ ಪ್ರತಿವಾದ ಮಾಡಿದಾಗ ಯಾರೂ ನನ್ನೊಂದಿಗೆ ನಿಲ್ಲಲಿಲ್ಲ. ಎಲ್ಲರೂ ನನ್ನನ್ನು ಕೈಬಿಟ್ಟರು. ಇದು ಅವರ ಲೆಕ್ಕಕ್ಕೆ ಸೇರಿಸಲಾಗದೆ ಇರಲಿ. <verse eid="2TI 4:16"/><verse number="17" style="v" sid="2TI 4:17"/>ಆದರೆ ಕರ್ತ ಯೇಸು ನನ್ನ ಬಳಿಯಲ್ಲಿ ನಿಂತು ನನ್ನನ್ನು ಬಲಪಡಿಸಿ, ನನ್ನ ಮೂಲಕ ಸುವಾರ್ತೆಯು ಸಂಪೂರ್ಣವಾಗಿ ಸಾರುವಂತೆ ಮಾಡಿದರು. ಯೆಹೂದ್ಯರಲ್ಲದವರೆಲ್ಲರೂ ಸಹ ಅದನ್ನು ಕೇಳುವಂತೆಯೂ ಮಾಡಿದರು. ಇದಲ್ಲದೆ ಕರ್ತ ಯೇಸು ನನ್ನನ್ನು ಸಿಂಹದ ಬಾಯೊಳಗಿಂದ ಸಂರಕ್ಷಿಸಿದರು. <verse eid="2TI 4:17"/><verse number="18" style="v" sid="2TI 4:18"/>ನನ್ನನ್ನು ಪ್ರತಿಯೊಂದು ದುಷ್ಟದಾಳಿಯಿಂದ ಕರ್ತ ಯೇಸು ತಪ್ಪಿಸಿ, ತಮ್ಮ ಪರಲೋಕ ರಾಜ್ಯಕ್ಕೆ ನನ್ನನ್ನು ಸುರಕ್ಷಿತವಾಗಿ ತರುವರು. ಯುಗಯುಗಾಂತರಗಳಲ್ಲಿಯೂ ಅವರಿಗೆ ಮಹಿಮೆ. ಆಮೆನ್.<verse eid="2TI 4:18"/></para>
  <para style="b"/>
  <para style="s1">ಅಂತಿಮ ವಂದನೆಗಳು</para>
  <para style="p">
    <verse number="19" style="v" sid="2TI 4:19"/>ಪ್ರಿಸ್ಕಳಿಗೂ ಅಕ್ವಿಲನಿಗೂ ಒನೇಸಿಫೊರನ ಮನೆಯವರಿಗೂ ವಂದನೆ.<verse eid="2TI 4:19"/></para>
  <para style="b"/>
  <para style="p">
    <verse number="20" style="v" sid="2TI 4:20"/>ಎರಸ್ತನು ಕೊರಿಂಥದಲ್ಲಿ ಉಳಿದುಕೊಂಡಿದ್ದಾನೆ. ಆದರೆ ತ್ರೊಫಿಮನು ಅಸ್ವಸ್ಥನಾಗಿದ್ದುದರಿಂದ ಅವನನ್ನು ನಾನು ಮಿಲೇತದಲ್ಲಿ ಬಿಟ್ಟಿದ್ದೇನೆ. <verse eid="2TI 4:20"/><verse number="21" style="v" sid="2TI 4:21"/>ನೀನು ಚಳಿಗಾಲಕ್ಕೆ ಮುಂಚೆಯೇ ಆದಷ್ಟು ಬೇಗನೆ ಬರುವುದಕ್ಕೆ ಪ್ರಯತ್ನ ಮಾಡು.</para>
  <para style="b" vid="2TI 4:21"/>
  <para style="p" vid="2TI 4:21">ಯುಬೂಲನೂ ಪೊದೆಯನೂ ಲೀನನೂ ಕ್ಲೌದ್ಯಳೂ ಎಲ್ಲಾ ಸಹೋದರರೂ ನಿನಗೆ ವಂದನೆ ಹೇಳುತ್ತಾರೆ.<verse eid="2TI 4:21"/></para>
  <para style="b"/>
  <para style="p">
    <verse number="22" style="v" sid="2TI 4:22"/>ಕರ್ತ ಯೇಸು ನಿನ್ನ ಆತ್ಮದೊಂದಿಗೆ ಇರಲಿ. ಕೃಪೆಯು ನಿಮ್ಮೆಲ್ಲರೊಂದಿಗಿರಲಿ.<verse eid="2TI 4:22"/></para>
  <chapter eid="2TI 4"/>
</usx>
