<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="JUD" style="id">- Biblica® Open Kannada Contemporary Version</book>
  <para style="h">ಯೂದನು</para>
  <para style="toc1">ಯೂದನು ಬರೆದ ಪತ್ರಿಕೆ</para>
  <para style="toc2">ಯೂದನು</para>
  <para style="toc3">ಯೂದ</para>
  <para style="mt1">ಯೂದನು</para>
  <para style="mt2">ಬರೆದ ಪತ್ರಿಕೆ</para>
  <chapter number="1" style="c" sid="JUD 1"/>
  <para style="p">
    <verse number="1" style="v" sid="JUD 1:1"/>ಕ್ರಿಸ್ತ ಯೇಸುವಿನ ದಾಸನೂ ಯಾಕೋಬನ ಸಹೋದರನೂ ಆಗಿರುವ ಯೂದನು,</para>
  <para style="b" vid="JUD 1:1"/>
  <para style="p" vid="JUD 1:1">ತಂದೆಯಾದ ದೇವರಿಗೆ ಪ್ರಿಯರಾದವವರಿಗೂ ಕ್ರಿಸ್ತ ಯೇಸು ಸುರಕ್ಷತೆಯನ್ನೂ ಅವರ ಕರೆಯುವಿಕೆಯನ್ನೂ ಹೊಂದಿದವರಿಗೆ ಬರೆಯುವ ಪತ್ರ:<verse eid="JUD 1:1"/></para>
  <para style="b"/>
  <para style="p">
    <verse number="2" style="v" sid="JUD 1:2"/>ನಿಮಗೆ ಕರುಣೆಯೂ ಶಾಂತಿಯೂ ಪ್ರೀತಿಯೂ ಹೆಚ್ಚೆಚ್ಚಾಗಿ ದೊರೆಯಲಿ.<verse eid="JUD 1:2"/></para>
  <para style="b"/>
  <para style="s1">ಸಭೆಯೊಳಗೆ ದುರ್ಮಾರ್ಗಿಗಳು</para>
  <para style="p">
    <verse number="3" style="v" sid="JUD 1:3"/>ಪ್ರಿಯ ಸ್ನೇಹಿತರೇ, ನಾವು ಹಂಚಿಕೊಳ್ಳುವ ರಕ್ಷಣೆಯ ವಿಷಯದಲ್ಲಿ ನಿಮಗೆ ಬರೆಯುವುದಕ್ಕೆ ಪೂರ್ಣಜಾಗ್ರತೆಯಿಂದ ಪ್ರಯತ್ನ ಮಾಡುತ್ತಿದ್ದಾಗ, ಪರಿಶುದ್ಧರಿಗೆ ಒಂದೇ ಸಾರಿ ಒಪ್ಪಿಸಲಾದ ನಂಬಿಕೆಯನ್ನು ಕಾಪಾಡಿಕೊಳ್ಳುವುದಕ್ಕೆ ನೀವು ಹೋರಾಡಬೇಕೆಂದು ಎಚ್ಚರಿಸಿ ಬರೆಯುವುದು ನನಗೆ ಅವಶ್ಯವೆಂದು ತೋರಿತು. <verse eid="JUD 1:3"/><verse number="4" style="v" sid="JUD 1:4"/>ಏಕೆಂದರೆ ಭಕ್ತಿಹೀನರೂ ನಮ್ಮ ದೇವರ ಕೃಪೆಯನ್ನು ನೆಪಮಾಡಿಕೊಂಡು ನಾಚಿಕೆಗೆಟ್ಟ ಕೃತ್ಯಗಳನ್ನು ನಡೆಸುವವರೂ ನಮ್ಮ ಒಬ್ಬರೇ ಕರ್ತ ಆಗಿರುವ ದೇವರನ್ನು ಮತ್ತು ನಮಗೆ ಕರ್ತ ಆಗಿರುವ ಯೇಸು ಕ್ರಿಸ್ತರನ್ನು ಅಲ್ಲಗಳೆಯುವ ಕೆಲವು ಜನರೂ ರಹಸ್ಯವಾಗಿ ಸಭೆಯೊಳಗೆ ಹೊಕ್ಕಿದ್ದಾರೆ. ಇವರು ದಂಡನೆಗೋಸ್ಕರ ಪೂರ್ವದಲ್ಲಿಯೇ ನೇಮಕವಾಗಿದ್ದಾರೆ.<verse eid="JUD 1:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="JUD 1:5"/>ಇದನ್ನು ನೀವು ಈಗಾಗಲೇ ಒಂದು ಸಾರಿ ತಿಳಿದವರಾಗಿದ್ದೀರಿ. ಆದರೂ ನಾನು ಅದನ್ನೇ ನಿಮ್ಮ ಜ್ಞಾಪಕಕ್ಕೆ ತರಬೇಕೆಂದು ಅಪೇಕ್ಷಿಸುತ್ತೇನೆ. ಅದು ಯಾವುದೆಂದರೆ: ಕರ್ತದೇವರು ತಮ್ಮ ಪ್ರಜೆಯನ್ನು ಈಜಿಪ್ಟ್ ದೇಶದೊಳಗಿಂದ ರಕ್ಷಿಸಿದರೂ ತರುವಾಯ ಅವರೊಳಗೆ ನಂಬದೆ ಹೋದವರನ್ನು ಸಂಹಾರ ಮಾಡಿದರು. <verse eid="JUD 1:5"/><verse number="6" style="v" sid="JUD 1:6"/>ತಮ್ಮ ಅಧಿಕಾರದ ಸ್ಥಾನವನ್ನು ಕಾಪಾಡದೆ, ತಮ್ಮ ಸ್ವಂತ ವಾಸಸ್ಥಾನವನ್ನು ಬಿಟ್ಟ ದೇವದೂತರಿಗೆ ಅವರು ನಿತ್ಯವಾದ ಬೇಡಿಗಳನ್ನು ಹಾಕಿ, ಮಹಾದಿನದ ತೀರ್ಪಿಗಾಗಿ ಅವರನ್ನು ಕತ್ತಲೆಯೊಳಗೆ ಕಾದಿಟ್ಟಿದ್ದಾರೆ. <verse eid="JUD 1:6"/><verse number="7" style="v" sid="JUD 1:7"/>ಸೊದೋಮ ಗೊಮೋರದವರೂ ಹಾಗೆಯೇ ಅವುಗಳ ಸುತ್ತಮುತ್ತಣ ಪಟ್ಟಣಗಳವರೂ ಅದೇ ರೀತಿಯಲ್ಲಿ ತಮ್ಮನ್ನು ಅನೈತಿಕತೆಗೆ ಒಪ್ಪಿಸಿಕೊಟ್ಟರು. ಅವರು ಸ್ವಭಾವಕ್ಕೆ ವಿರುದ್ಧ ಕಾರ್ಯಗಳನ್ನು ಅನುಸರಿಸಿದ್ದರಿಂದ ಅವರು ನಿತ್ಯವಾದ ಅಗ್ನಿಯಲ್ಲಿ ದಂಡನೆಯನ್ನು ಅನುಭವಿಸುತ್ತಾ ಉದಾಹರಣೆಗಾಗಿ ಇಡಲಾಗಿದ್ದಾರೆ.<verse eid="JUD 1:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="JUD 1:8"/>ಹಾಗೆಯೇ ಈ ದುಃಸ್ವಪ್ನದವರೂ ಶರೀರವನ್ನು ಮಲಿನಮಾಡಿಕೊಳ್ಳುವವರೂ ಪ್ರಭುತ್ವವನ್ನು ಅಸಡ್ಡೆಮಾಡುವವರೂ ದೇವದೂತರುಗಳನ್ನು ದೂಷಿಸುವವರೂ ಆಗಿದ್ದಾರೆ. <verse eid="JUD 1:8"/><verse number="9" style="v" sid="JUD 1:9"/>ಆದರೂ ಪ್ರಧಾನ ದೇವದೂತನಾದ ಮೀಕಾಯೇಲನು, ಮೋಶೆಯ ಶವದ ವಿಷಯದಲ್ಲಿ ಸೈತಾನನೊಂದಿಗೆ ವ್ಯಾಜ್ಯವಾಡಿ ವಾಗ್ವಾದ ಮಾಡಿದಾಗ, ಅವನು ಸೈತಾನನನ್ನು ದೂಷಿಸುವುದಕ್ಕೆ ಧೈರ್ಯಗೊಳ್ಳದೆ, “ಕರ್ತದೇವರು ನಿನ್ನನ್ನು ಗದರಿಸಲಿ!” ಎಂದನು. <verse eid="JUD 1:9"/><verse number="10" style="v" sid="JUD 1:10"/>ಆದರೆ ಈ ಜನರು ತಮಗೆ ಗೊತ್ತಿಲ್ಲದವುಗಳ ವಿಷಯವಾಗಿ ಕೆಟ್ಟದ್ದಾಗಿ ಮಾತನಾಡುತ್ತಾರೆ. ತಾವು ವಿವೇಕಶೂನ್ಯ ಮೃಗಗಳಂತೆ ಸ್ವಾಭಾವಿಕವಾಗಿ ಏನೇನನ್ನು ತಿಳಿದುಕೊಳ್ಳುತ್ತಾರೋ ಅವುಗಳಲ್ಲಿ ತಮ್ಮನ್ನು ಕೆಡಿಸಿಕೊಳ್ಳುತ್ತಾರೆ.<verse eid="JUD 1:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="JUD 1:11"/>ಅವರು ಕಾಯಿನನ ಮಾರ್ಗ ಹಿಡಿದವರೂ ಪ್ರತೀಕಾರ ಹೊಂದುವುದಕ್ಕಾಗಿ ಬಿಳಾಮನ ದೋಷವನ್ನು ಮಾಡುವುದಕ್ಕೆ ದುರಾಶೆಯಿಂದ ಓಡುವವರಾಗಿದ್ದಾರೆ. ಅವರು ಕೋರಹನಂತೆ ಎದುರು ಮಾತನಾಡಿ ನಾಶವಾಗುವವರಾಗಿದ್ದಾರೆ. ಆದ್ದರಿಂದ ಅವರ ಗತಿ ಏನೆಂದು ಹೇಳಲಿ!<verse eid="JUD 1:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="JUD 1:12"/>ಕಳಂಕರಾದ ಇವರು ನಿಮ್ಮ ಪ್ರೇಮ ಭೋಜನಗಳಲ್ಲಿ ನಿರ್ಭಯವಾಗಿ ತಿಂದು, ತಮ್ಮನ್ನು ತಾವೇ ಪೋಷಿಸಿಕೊಳ್ಳುತ್ತಾರೆ. ಇವರು ಗಾಳಿಯಿಂದ ಚದುರಿ ಹೋಗುವ ನೀರಿಲ್ಲದ ಮೇಘಗಳೂ ಎರಡು ಸಾರಿ ಸತ್ತು, ಹಣ್ಣು ಬಿಡದೆ ಒಣಗಿ ಹೋಗಿ ಬೇರುಸಹಿತ ಕಿತ್ತು ಬಿದ್ದ ಮರಗಳೂ <verse eid="JUD 1:12"/><verse number="13" style="v" sid="JUD 1:13"/>ಸ್ವಂತ ಅವಮಾನವೆಂಬ ನೊರೆಯನ್ನು ಕಾರುವ ಸಮುದ್ರದ ಹುಚ್ಚುತೆರೆಗಳೂ ಆಗಿದ್ದಾರೆ. ಅಲೆಯುವ ನಕ್ಷತ್ರಗಳಾದ ಇವರ ಪಾಲಿಗೆ ಕಾರ್ಗತ್ತಲೆಯು ಸದಾಕಾಲಕ್ಕೆ ಇಡಲಾಗಿದೆ.<verse eid="JUD 1:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="JUD 1:14"/>ಇಂಥವರ ವಿಷಯದಲ್ಲಿಯೇ ಆದಾಮನಿಂದ ಏಳನೆಯವನಾದ ಹನೋಕನು ಸಹ, “ಇಗೋ, ಕರ್ತದೇವರು ತಮ್ಮ ಅಸಂಖ್ಯಾತ ಪರಿಶುದ್ಧರನ್ನು ಕೂಡಿಕೊಂಡು <verse eid="JUD 1:14"/><verse number="15" style="v" sid="JUD 1:15"/>ಎಲ್ಲರಿಗೆ ನ್ಯಾಯತೀರಿಸುವುದಕ್ಕೆ ಬರುವರು. ಮಾತ್ರವಲ್ಲದೆ ಅವರಲ್ಲಿ ಭಕ್ತಿಹೀನರೆಲ್ಲರು ಮಾಡಿದ ದುಷ್ಕೃತ್ಯಗಳನ್ನು ಮತ್ತು ಪಾಪಿಷ್ಠರು ತಮಗೆ ವಿರೋಧವಾಗಿ ಆಡಿದ ಎಲ್ಲಾ ದೂಷಣೆಗಳ ವಿಷಯವಾಗಿ ಅವರನ್ನು ಖಂಡಿಸಲು ಬರುವರು,” ಎಂಬುದಾಗಿ ಪ್ರವಾದಿಸಿದನು. <verse eid="JUD 1:15"/><verse number="16" style="v" sid="JUD 1:16"/>ಇವರು ಗೊಣಗುಟ್ಟುವವರೂ ದೂರುವವರೂ ತಮ್ಮ ದುರಾಶೆಗಳನ್ನು ಅನುಸರಿಸಿ ನಡೆಯುವವರೂ ಆಗಿದ್ದಾರೆ. ಇವರ ಬಾಯಿಂದ ದೊಡ್ಡ ದೊಡ್ಡ ಮಾತುಗಳು ಉದುರುತ್ತವೆ. ಇವರು ಸ್ವಪ್ರಯೋಜನಕ್ಕಾಗಿ ಮುಖಸ್ತುತಿ ಮಾಡುತ್ತಾರೆ.<verse eid="JUD 1:16"/></para>
  <para style="s1">ದೇವರ ಮಕ್ಕಳಿಗೆ ಎಚ್ಚರಿಕೆ</para>
  <para style="p">
    <verse number="17" style="v" sid="JUD 1:17"/>ಪ್ರಿಯ ಸ್ನೇಹಿತರೇ, ನೀವಾದರೋ ನಮ್ಮ ಕರ್ತ ಆಗಿರುವ ಯೇಸುಕ್ರಿಸ್ತರ ಅಪೊಸ್ತಲರು ಮೊದಲು ಹೇಳಿದ ಮಾತುಗಳನ್ನು ಜ್ಞಾಪಕಮಾಡಿಕೊಳ್ಳಿರಿ. <verse eid="JUD 1:17"/><verse number="18" style="v" sid="JUD 1:18"/>“ಭಕ್ತಿಗೆ ವಿರುದ್ಧವಾದ ತಮ್ಮ ಆಶೆಗಳನ್ನು ಅನುಸರಿಸಿ ನಡೆಯುವ ಕುಚೋದ್ಯಗಾರರು ಅಂತ್ಯಕಾಲದಲ್ಲಿ ಬರುವರು,” ಎಂದು ಅಪೊಸ್ತಲರು ನಿಮಗೆ ಹೇಳಿದರು. <verse eid="JUD 1:18"/><verse number="19" style="v" sid="JUD 1:19"/>ಇವರು ನಿಮ್ಮಲ್ಲಿ ಭಿನ್ನಾಭಿಪ್ರಾಯವನ್ನು ಉಂಟುಮಾಡುವವರೂ ಪ್ರಾಪಂಚಿಕ ಮನುಷ್ಯರೂ ಪವಿತ್ರಾತ್ಮ ದೇವರಿಲ್ಲದವರೂ ಆಗಿದ್ದಾರೆ.<verse eid="JUD 1:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="JUD 1:20"/>ಪ್ರಿಯರೇ, ನೀವಾದರೋ ನಿಮಗಿರುವ ಅತಿಪರಿಶುದ್ಧವಾದ ನಂಬಿಕೆಯಲ್ಲಿ ನಿಮ್ಮನ್ನು ನಿರ್ಮಿಸಿಕೊಂಡವರಾಗಿ ಪರಿಶುದ್ಧಾತ್ಮ ದೇವರಲ್ಲಿ ಪ್ರಾರ್ಥಿಸಿರಿ. <verse eid="JUD 1:20"/><verse number="21" style="v" sid="JUD 1:21"/>ನಿತ್ಯಜೀವಕ್ಕಾಗಿ ನಮಗೆ ಕರ್ತ ಆಗಿರುವ ಯೇಸುಕ್ರಿಸ್ತರ ಕರುಣೆಗೋಸ್ಕರ ಎದುರುನೋಡುತ್ತಾ ನಿಮ್ಮನ್ನು ದೇವರ ಪ್ರೀತಿಯಲ್ಲಿ ಕಾಪಾಡಿಕೊಳ್ಳಿರಿ.<verse eid="JUD 1:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="JUD 1:22"/>ಸಂಶಯಪಡುವ ಕೆಲವರಿಗೆ ಕನಿಕರವನ್ನು ತೋರಿಸಿರಿ. <verse eid="JUD 1:22"/><verse number="23" style="v" sid="JUD 1:23"/>ಬೇರೆಯವರನ್ನು ಬೆಂಕಿಯಿಂದ ಎಳೆದು ರಕ್ಷಿಸಿರಿ. ಭಯದಿಂದ ಕರುಣೆ ತೋರಿಸಿರಿ. ಪಾಪ ಕೃತ್ಯಗಳಿಂದ ಮೈಲಿಗೆಯಾದ ಅವರ ಜೀವನವನ್ನು<note caller="+" style="f"><char style="fr" closed="false">1:23 </char><char style="ft" closed="false">ಅಥವಾ </char><char style="fqa" closed="false">ಅಂಗಿಯನ್ನು</char></note> ಸಹ ಹಗೆ ಮಾಡಿರಿ.<verse eid="JUD 1:23"/></para>
  <para style="b"/>
  <para style="s1">ಅಂತ್ಯ ಆಶೀರ್ವಾದ</para>
  <para style="p">
    <verse number="24" style="v" sid="JUD 1:24"/>ಎಡವಿಬೀಳದಂತೆ ನಿಮ್ಮನ್ನು ಕಾಪಾಡುವುದಕ್ಕೂ ತಮ್ಮ ಪ್ರಭಾವದ ಸಮಕ್ಷಮದಲ್ಲಿ ನಿಮ್ಮನ್ನು ಅತ್ಯಂತ ಹರ್ಷದೊಡನೆ ನಿರ್ದೋಷಿಗಳನ್ನಾಗಿ ನಿಲ್ಲಿಸುವುದಕ್ಕೂ ಶಕ್ತರಾಗಿರುವ <verse eid="JUD 1:24"/><verse number="25" style="v" sid="JUD 1:25"/>ನಮ್ಮ ರಕ್ಷಕರಾದ ಒಬ್ಬರೇ ದೇವರಿಗೆ ನಮಗೆ ಕರ್ತ ಆಗಿರುವ ಯೇಸುಕ್ರಿಸ್ತರ ಮುಖಾಂತರ ಮಹಿಮೆ, ಮಹತ್ವ, ಬಲವು, ಅಧಿಕಾರಗಳು ಎಂದೂ ಇದ್ದಂತೆ ಈಗಲೂ ಯಾವಾಗಲೂ ಇರಲಿ. ಆಮೆನ್.<verse eid="JUD 1:25"/></para>
  <chapter eid="JUD 1"/>
</usx>
