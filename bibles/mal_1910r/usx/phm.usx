<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="PHM" style="id">Malayalam-India സത്യവേദപുസ്തകം 1910 പതിപ്പ്</book>
  <para style="ide">65001 - Unicode (UTF-8)</para>
  <para style="rem">CAP Information: Digitized 2015 TFBF Volunteers ; revised orthography</para>
  <para style="rem">Please use a new orthography font like Noto Malayalam or Aruna</para>
  <para style="rem">eng_header: Philemon</para>
  <para style="h">ഫിലേമോൻ</para>
  <para style="toc1">അപ്പൊസ്തലനായ പൗലൊസ് ഫിലേമോന്നു എഴുതിയ ലേഖനം</para>
  <para style="toc2">ഫിലേമോൻ</para>
  <para style="toc3">ഫിലേ.</para>
  <para style="mt2">അപ്പൊസ്തലനായ പൗലൊസ്</para>
  <para style="mt1">ഫിലേമോന്നു എഴുതിയ ലേഖനം</para>
  <chapter number="1" style="c" sid="PHM 1"/>
  <para style="p">
    <verse number="1" style="v" sid="PHM 1:1"/>ക്രിസ്തുയേശുവിന്റെ ബദ്ധനായ പൗലൊസും സഹോദരനായ തിമൊഥെയൊസും ഞങ്ങളുടെ പ്രിയനും കൂട്ടുവേലക്കാരനുമായ ഫിലേമോൻ എന്ന നിനക്കും <verse eid="PHM 1:1"/><verse number="2" style="v" sid="PHM 1:2"/><note caller="-" style="x"><char style="xo" closed="false">1:2 </char><char style="xt" closed="false"><ref loc="COL 4:17">കൊലൊസ്സ്യർ 4:17</ref></char></note>സഹോദരിയായ അപ്പിയെക്കും ഞങ്ങളുടെ സഹഭടനായ അർക്കിപ്പൊസിന്നും നിന്റെ വീട്ടിലെ സഭെക്കും എഴുതുന്നതു: <verse eid="PHM 1:2"/><verse number="3" style="v" sid="PHM 1:3"/>നമ്മുടെ പിതാവായ ദൈവത്തിങ്കൽനിന്നും കർത്താവായ യേശുക്രിസ്തുവിങ്കൽനിന്നും നിങ്ങൾക്കു കൃപയും സമാധാനവും ഉണ്ടാകട്ടെ.<verse eid="PHM 1:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="PHM 1:4"/>കർത്താവായ യേശുവിനോടും സകലവിശുദ്ധന്മാരോടും നിനക്കുള്ള സ്നേഹത്തെയും വിശ്വാസത്തെയും കുറിച്ചു ഞാൻ കേട്ടിട്ടു <verse eid="PHM 1:4"/><verse number="5" style="v" sid="PHM 1:5"/>നമ്മിലുള്ള എല്ലാനന്മയുടെയും പരിജ്ഞാനത്താൽ നിന്റെ വിശ്വാസത്തിന്റെ കൂട്ടായ്മ ക്രിസ്തുവിന്നായി സഫലമാകേണ്ടതിന്നു <verse eid="PHM 1:5"/><verse number="6" style="v" sid="PHM 1:6"/>എന്റെ പ്രാർത്ഥനയിൽ നിന്നെ ഓർത്തു എപ്പോഴും എന്റെ ദൈവത്തിന്നു സ്തോത്രം ചെയ്യുന്നു. <verse eid="PHM 1:6"/><verse number="7" style="v" sid="PHM 1:7"/>സഹോദരാ, വിശുദ്ധന്മാരുടെ ഹൃദയം നീ തണുപ്പിച്ചതുനിമിത്തം നിന്റെ സ്നേഹത്തിൽ എനിക്കു വളരെ സന്തോഷവും ആശ്വാസവും ഉണ്ടായി.<verse eid="PHM 1:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="PHM 1:8"/>ആകയാൽ യുക്തമായതു നിന്നോടു കല്പിപ്പാൻ ക്രിസ്തുവിൽ എനിക്കു വളരെ ധൈര്യം ഉണ്ടെങ്കിലും <verse eid="PHM 1:8"/><verse number="9" style="v" sid="PHM 1:9"/>പൗലൊസ് എന്ന വയസ്സനും ഇപ്പോൾ ക്രിസ്തുയേശുവിന്റെ ബദ്ധനുമായിരിക്കുന്ന ഈ ഞാൻ സ്നേഹം നിമിത്തം അപേക്ഷിക്കയത്രേ ചെയ്യുന്നതു. <verse eid="PHM 1:9"/><verse number="10" style="v" sid="PHM 1:10"/><note caller="-" style="x"><char style="xo" closed="false">1:10 </char><char style="xt" closed="false"><ref loc="COL 4:9">കൊലൊസ്സ്യർ 4:9</ref></char></note>തടവിൽ ഇരിക്കുമ്പോൾ ഞാൻ ജനിപ്പിച്ച എന്റെ മകനായ ഒനേസിമൊസിന്നു<note caller="+" style="f"><char style="fr" closed="false">1:10 </char><char style="fk" closed="false">ഒനേസിമൊസ്</char><char style="ft" closed="false">ഈ പേരിന്റെ അർത്ഥം പ്രയോജനമുള്ളവൻ എന്നാണ്</char></note> വേണ്ടി ആകുന്നു നിന്നോടു അപേക്ഷിക്കുന്നതു. <verse eid="PHM 1:10"/><verse number="11" style="v" sid="PHM 1:11"/>അവൻ മുമ്പെ നിനക്കു പ്രയോജനമില്ലാത്തവൻ ആയിരുന്നു; ഇപ്പോൾ നിനക്കും എനിക്കും നല്ല പ്രയോജനമുള്ളവൻ തന്നേ. <verse eid="PHM 1:11"/><verse number="12" style="v" sid="PHM 1:12"/>എനിക്കു പ്രാണപ്രിയനായ അവനെ ഞാൻ മടക്കി അയച്ചിരിക്കുന്നു. <verse eid="PHM 1:12"/><verse number="13" style="v" sid="PHM 1:13"/>സുവിശേഷംനിമിത്തമുള്ള തടവിൽ എന്നെ ശുശ്രൂഷിക്കേണ്ടതിന്നു അവനെ നിനക്കു പകരം എന്റെ അടുക്കൽ തന്നേ നിർത്തിക്കൊൾവാൻ എനിക്കു ആഗ്രഹമുണ്ടായിരുന്നു. <verse eid="PHM 1:13"/><verse number="14" style="v" sid="PHM 1:14"/>എങ്കിലും നിന്റെ ഗുണം നിർബ്ബന്ധത്താൽ എന്നപോലെ അല്ല, മനസ്സോടെ ആകേണ്ടതിന്നു നിന്റെ സമ്മതം കൂടാതെ ഒന്നും ചെയ്‌വാൻ എനിക്കു മനസ്സില്ലായിരുന്നു. <verse eid="PHM 1:14"/><verse number="15" style="v" sid="PHM 1:15"/>അവൻ അല്പകാലം വേറുവിട്ടുപോയതു അവനെ സദാകാലത്തേക്കും നിനക്കു ലഭിക്കേണ്ടതിന്നു ആയിരിക്കും; <verse eid="PHM 1:15"/><verse number="16" style="v" sid="PHM 1:16"/>അവൻ ഇനി ദാസനല്ല, ദാസന്നു മീതെ പ്രിയ സഹോദരൻ തന്നേ; അവൻ വിശേഷാൽ എനിക്കു പ്രിയൻ എങ്കിൽ നിനക്കു ജഡസംബന്ധമായും കർത്തൃസംബന്ധമായും എത്ര അധികം? <verse eid="PHM 1:16"/><verse number="17" style="v" sid="PHM 1:17"/>ആകയാൽ നീ എന്നെ കൂട്ടാളി എന്നു കരുതുന്നു എങ്കിൽ അവനെ എന്നെപ്പോലെ ചേർത്തുകൊൾക. <verse eid="PHM 1:17"/><verse number="18" style="v" sid="PHM 1:18"/>അവൻ നിന്നോടു വല്ലതും അന്യായം ചെയ്തിട്ടോ കടംപെട്ടിട്ടോ ഉണ്ടെങ്കിൽ അതു എന്റെ പേരിൽ കണക്കിട്ടുകൊൾക. <verse eid="PHM 1:18"/><verse number="19" style="v" sid="PHM 1:19"/>പൗലൊസ് എന്ന ഞാൻ സ്വന്തകയ്യാൽ എഴുതിയിരിക്കുന്നു; ഞാൻ തന്നു തീർക്കാം. നീ നിന്നെത്തന്നേ എനിക്കു തരുവാൻ കടംപെട്ടിരിക്കുന്നു എന്നു ഞാൻ പറയേണം എന്നില്ലല്ലോ. <verse eid="PHM 1:19"/><verse number="20" style="v" sid="PHM 1:20"/>അതേ സഹോദരാ, നിന്നെക്കൊണ്ടു എനിക്കു കർത്താവിൽ ഒരനുഭവം വേണ്ടിയിരിക്കുന്നു; ക്രിസ്തുവിൽ എന്റെ ഹൃദയം തണുപ്പിക്ക. <verse eid="PHM 1:20"/><verse number="21" style="v" sid="PHM 1:21"/>നിന്റെ അനുസരണത്തെപ്പറ്റി എനിക്കു നിശ്ചയം ഉണ്ടു; ഞാൻ പറയുന്നതിലുമധികം നീ ചെയ്യും എന്നറിഞ്ഞിട്ടാകുന്നു ഞാൻ എഴുതുന്നതു. <verse eid="PHM 1:21"/><verse number="22" style="v" sid="PHM 1:22"/>ഇതല്ലാതെ നിങ്ങളുടെ പ്രാർത്ഥനയാൽ ഞാൻ നിങ്ങൾക്കു നല്കപ്പെടും എന്നു പ്രത്യാശ ഉണ്ടാകകൊണ്ടു എനിക്കു പാർപ്പിടം ഒരുക്കിക്കൊൾക.<verse eid="PHM 1:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="PHM 1:23"/>
    <note caller="-" style="x">
      <char style="xo" closed="false">1:23 </char>
      <char style="xt" closed="false">
        <ref loc="COL 1:7">കൊലൊസ്സ്യർ 1:7</ref>; <ref loc="COL 4:12">4:12</ref></char>
    </note>ക്രിസ്തുയേശുവിൽ എന്റെ സഹബദ്ധനായ എപ്പഫ്രാസും <verse eid="PHM 1:23"/><verse number="24" style="v" sid="PHM 1:24"/><note caller="-" style="x"><char style="xo" closed="false">1:24 a: </char><char style="xt" closed="false"><ref loc="ACT 12:12">അപ്പൊ. പ്രവൃത്തികൾ 12:12</ref>,<ref loc="ACT 12:25">25</ref>; <ref loc="ACT 13:13">13:13</ref>; <ref loc="ACT 15:37-39">15:37-39</ref>; <ref loc="COL 4:10">കൊലൊസ്സ്യർ 4:10</ref>; </char><char style="xo" closed="false">b: </char><char style="xt" closed="false"><ref loc="ACT 19:29">അപ്പൊ. പ്രവൃത്തികൾ 19:29</ref>; <ref loc="ACT 27:2">27:2</ref>; <ref loc="COL 4:10">കൊലൊസ്സ്യർ 4:10</ref>; </char><char style="xo" closed="false">c: </char><char style="xt" closed="false"><ref loc="COL 4:14">കൊലൊസ്സ്യർ 4:14</ref>; <ref loc="2TI 4:10">2. തിമൊഥെയൊസ് 4:10</ref>; </char><char style="xo" closed="false">d: </char><char style="xt" closed="false"><ref loc="COL 4:14">കൊലൊസ്സ്യർ 4:14</ref>; <ref loc="2TI 4:11">2. തിമൊഥെയൊസ് 4:11</ref></char></note>എന്റെ കൂട്ടുവേലക്കാരനായ മർക്കൊസും അരിസ്തർക്കൊസും ദേമാസും ലൂക്കൊസും നിനക്കു വന്ദനം ചൊല്ലുന്നു.<verse eid="PHM 1:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="PHM 1:25"/>നമ്മുടെ കർത്താവായ യേശുക്രിസ്തുവിന്റെ കൃപ നിങ്ങളുടെ ആത്മാവോടുകൂടെ ഇരിക്കുമാറാകട്ടെ. ആമേൻ.<verse eid="PHM 1:25"/></para>
  <chapter eid="PHM 1"/>
</usx>
