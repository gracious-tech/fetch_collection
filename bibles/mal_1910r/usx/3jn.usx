  <para style="rem">eng_header: 3 John</para>
  <para style="h">3. യോഹന്നാൻ</para>
  <para style="toc1">യോഹന്നാൻ എഴുതിയ മൂന്നാം ലേഖനം</para>
  <para style="toc2">3. യോഹന്നാൻ</para>
  <para style="toc3">3 യോഹ.</para>
  <para style="mt1">യോഹന്നാൻ എഴുതിയ മൂന്നാം ലേഖനം</para>
  <chapter number="1" style="c" sid="3JN 1"/>
  <para style="p">
    <verse number="1" style="v" sid="3JN 1:1"/>
    <note caller="-" style="x">
      <char style="xo" closed="false">1:1 </char>
      <char style="xt" closed="false">
        <ref loc="ACT 19:29">അപ്പൊ. പ്രവൃത്തികൾ 19:29</ref>; <ref loc="ROM 16:23">റോമർ 16:23</ref>; <ref loc="1CO 1:14">1. കൊരിന്ത്യർ 1:14</ref></char>
    </note>മൂപ്പനായ ഞാൻ സത്യത്തിൽ സ്നേഹിക്കുന്ന പ്രിയ ഗായൊസിന്നു എഴുതുന്നതു:<verse eid="3JN 1:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="3JN 1:2"/>പ്രിയനേ, നിന്റെ ആത്മാവു ശുഭമായിരിക്കുന്നതുപോലെ നീ സകലത്തിലും ശുഭമായും സുഖമായും ഇരിക്കേണം എന്നു ഞാൻ പ്രാർത്ഥിക്കുന്നു. <verse eid="3JN 1:2"/><verse number="3" style="v" sid="3JN 1:3"/>സഹോദരന്മാർ വന്നു, നീ സത്യത്തിൽ നടക്കുന്നു എന്നു നിന്റെ സത്യത്തിന്നു സാക്ഷ്യം പറകയാൽ ഞാൻ അത്യന്തം സന്തോഷിച്ചു. <verse eid="3JN 1:3"/><verse number="4" style="v" sid="3JN 1:4"/>എന്റെ മക്കൾ സത്യത്തിൽ നടക്കുന്നു എന്നു കേൾക്കുന്നതിനെക്കാൾ വലിയ സന്തോഷം എനിക്കില്ല.<verse eid="3JN 1:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="3JN 1:5"/>പ്രിയനേ, നീ സഹോദരന്മാർക്കും വിശേഷാൽ അതിഥികൾക്കും വേണ്ടി അദ്ധ്വാനിക്കുന്നതിൽ ഒക്കെയും വിശ്വസ്തത കാണിക്കുന്നു. <verse eid="3JN 1:5"/><verse number="6" style="v" sid="3JN 1:6"/>അവർ സഭയുടെ മുമ്പാകെ നിന്റെ സ്നേഹത്തിന്നു സാക്ഷ്യം പറഞ്ഞിരിക്കുന്നു; നീ അവരെ ദൈവത്തിന്നു യോഗ്യമാകുംവണ്ണം യാത്ര അയച്ചാൽ നന്നായിരിക്കും. <verse eid="3JN 1:6"/><verse number="7" style="v" sid="3JN 1:7"/>തിരുനാമം നിമിത്തമല്ലോ അവർ ജാതികളോടു ഒന്നും വാങ്ങാതെ പുറപ്പെട്ടതു. <verse eid="3JN 1:7"/><verse number="8" style="v" sid="3JN 1:8"/>ആകയാൽ നാം സത്യത്തിന്നു കൂട്ടുവേലക്കാർ ആകേണ്ടതിന്നു ഇങ്ങനെയുള്ളവരെ സല്ക്കരിക്കേണ്ടതാകുന്നു.<verse eid="3JN 1:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="3JN 1:9"/>സഭെക്കു ഞാൻ ഒന്നെഴുതിയിരുന്നു: എങ്കിലും അവരിൽ പ്രധാനിയാകുവാൻ ആഗ്രഹിക്കുന്ന ദിയൊത്രെഫേസ് ഞങ്ങളെ കൂട്ടാക്കുന്നില്ല. <verse eid="3JN 1:9"/><verse number="10" style="v" sid="3JN 1:10"/>അതുകൊണ്ടു ഞാൻ വന്നാൽ അവൻ ഞങ്ങളെ ദുർവ്വാക്കു പറഞ്ഞു ശകാരിച്ചുകൊണ്ടു ചെയ്യുന്ന പ്രവൃത്തി അവന്നു ഓർമ്മവരുത്തും. അവൻ അങ്ങനെ ചെയ്യുന്നതു പോരാ എന്നുവെച്ചു താൻ സഹോദരന്മാരെ കൈക്കൊള്ളാതിരിക്കുന്നതു മാത്രമല്ല, അതിന്നു മനസ്സുള്ളവരെ വിരോധിക്കയും സഭയിൽനിന്നു പുറത്താക്കുകയും ചെയ്യുന്നു. <verse eid="3JN 1:10"/><verse number="11" style="v" sid="3JN 1:11"/>പ്രിയനേ, നന്മയല്ലാതെ തിന്മ അനുകരിക്കരുതു; നന്മ ചെയ്യുന്നവൻ ദൈവത്തിൽനിന്നുള്ളവൻ ആകുന്നു; തിന്മ ചെയ്യുന്നവൻ ദൈവത്തെ കണ്ടിട്ടില്ല. <verse eid="3JN 1:11"/><verse number="12" style="v" sid="3JN 1:12"/>ദെമേത്രിയൊസിന്നു എല്ലാവരാലും സത്യത്താൽ തന്നേയും സാക്ഷ്യം ലഭിച്ചിട്ടുണ്ടു; ഞങ്ങളും സാക്ഷ്യം പറയുന്നു; ഞങ്ങളുടെ സാക്ഷ്യം സത്യം എന്നു നീ അറിയുന്നു.<verse eid="3JN 1:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="3JN 1:13"/>എഴുതി അയപ്പാൻ പലതും ഉണ്ടായിരുന്നു എങ്കിലും മഷിയും തൂവലുംകൊണ്ടു എഴുതുവാൻ എനിക്കു മനസ്സില്ല. <verse eid="3JN 1:13"/><verse number="14" style="v" sid="3JN 1:14"/>വേഗത്തിൽ നിന്നെ കാണ്മാൻ ആശിക്കുന്നു. അപ്പോൾ നമുക്കു മുഖാമുഖമായി സംസാരിക്കാം. <verse eid="3JN 1:14"/><verse number="15" style="v" sid="3JN 1:15"/>നിനക്കു സമാധാനം. സ്നേഹിതന്മാർ നിനക്കു വന്ദനം ചൊല്ലുന്നു. സ്നേഹിതന്മാർക്കു പേരുപേരായി വന്ദനം ചൊല്ലുക.<verse eid="3JN 1:15"/></para>
  <chapter eid="3JN 1"/>
</usx>
