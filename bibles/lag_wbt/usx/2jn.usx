<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="2JN" style="id">- Rangi Translation Project</book>
  <para style="h">2 Yooháani</para>
  <para style="rem">Consultant: John Macaulay</para>
  <para style="toc2">2 Yooháani</para>
  <para style="toc1">Barʉ́wa ya kavɨrɨ ya Yooháani</para>
  <para style="mt2">Barʉ́wa ya kavɨrɨ ya</para>
  <para style="mt">Yooháani</para>
  <para style="imt">Mʉlongooryo</para>
  <para style="ip">Barʉ́wa ɨhɨ, nɨ ya kavɨrɨ ˆyaandɨkwa nɨ mutumwi Yooháani. Yooháani aandɨka barʉ́wa ɨhɨ nkufi kwa mpuka ya vaantʉ ˆveene avɨɨmɨrɨráa. Mpuka ɨyo, yeeye ɨɨyanɨrɨra íyo na vaana vaachwe (<char style="xt"><ref loc="2JN 1:1">1:1</ref></char>). Yooháani iiwyɨɨra mpuka ɨyo ituube kʉteerera ʉlairiri wa Yéesu wo kiiyenda voovo kwa voovo (<char style="xt"><ref loc="2JN 1:5-6">1:5-6</ref></char>). Kei Yooháani avalʉma kutu vandootaanga ukiindya wa Kirisitʉ na ukiindya wa ʉloongo. Ukiindya ʉwo mʉvɨ, wareetwa nɨ vakooveri vara ˆvamusiita Yéesu nɨ Masía na ʉʉja kwa mʉvɨrɨ wa mʉʉntʉ (<char style="xt"><ref loc="2JN 1:7-8">1:7-8</ref></char>).</para>
  <para style="iot">ˆVyeene Kɨtáabu ɨkɨ Chagavwa</para>
  <para style="io1">Lʉmbɨ <char style="ior"><ref loc="2JN 1:1-3">1:1-3</ref></char></para>
  <para style="io1">Mwiikalo wo kiiyenda <char style="ior"><ref loc="2JN 1:4-6">1:4-6</ref></char></para>
  <para style="io1">Kusiita vara ˆvamusiita Kirisitʉ <char style="ior"><ref loc="2JN 1:7-11">1:7-11</ref></char></para>
  <para style="io1">Masáare yo herererya <char style="ior"><ref loc="2JN 1:12-13">1:12-13</ref></char></para>
  <chapter number="1" style="c" sid="2JN 1"/>
  <para style="s1">Lʉmbɨ</para>
  <para style="p">
    <verse number="1" style="v" sid="2JN 1:1"/>Lʉmbɨ kufuma kwa moosi mʉlongooli wa vaantʉ ˆvamuruma <char style="w">Yéesu</char>. Nɨ kwaandɨkɨra niise weewe íyo ˆʉsaawʉlwa nɨ Mʉlʉʉngʉ hamwɨ na vaana vaako. Nɨɨnɨ kɨmaarɨ naveenda. Maa kaa, sɨ nɨɨnɨ vii tʉkʉ ˆnaveenda, baa vaantʉ vɨɨngɨ voosi vamányire kɨmáárɨ. <verse eid="2JN 1:1"/><verse number="2" style="v" sid="2JN 1:2"/>Suusu taveenda, sa takwaatya kɨmáárɨ mitimii yiitʉ na veera kɨrɨ mʉʉmo kwa sikʉ ˆjisiina ʉhero. <verse eid="2JN 1:2"/><verse number="3" style="v" sid="2JN 1:3"/>Nduwo, riiso ra wʉʉja na mwiikalo mʉʉja fuma kwa Mʉlʉʉngʉ Taáta na fuma kwa Yéesu <char style="w">Kirisitʉ</char>, <char style="w" lemma="Mwaana wa Mʉlʉʉngʉ">Mwaana wa Taáta</char> kʉva jiri na suusu kʉrɨ kɨmáárɨ na kwiiyenda.<verse eid="2JN 1:3"/></para>
  <para style="s1">Kɨmáárɨ na Kwiiyenda</para>
  <para style="p">
    <verse number="4" style="v" sid="2JN 1:4"/>Neeriwa mʉtɨma maatʉkʉ vii kʉteera vamwɨ va vaana vaanyu ˆvamwaarɨ vootuuba njɨra ya kɨmáárɨ, ja ˆvyeene Mʉlʉʉngʉ Taáta atʉlairirya. <verse eid="2JN 1:4"/><verse number="5" style="v" sid="2JN 1:5"/>Haaha íyo nooloomba twiiyende. Sɨ noovaandɨkɨra ʉlairiri mufya tʉkʉ, maa kaa, nɨ ʉlairiri ʉʼʉra tʉjáa tatɨɨte keende ncholo.<note caller="+" style="x"><char style="xo" closed="false">1:5 </char><char style="xt" closed="false">Laanga <ref loc="JHN 13:34">Yooháani 13:34</ref>.</char></note> <verse eid="2JN 1:5"/><verse number="6" style="v" sid="2JN 1:6"/>Kweenda noo ʉkʉ, yasaakwa suusu twiikale ko tuuba ndairiri ja Mʉlʉʉngʉ. Na ʉhʉ noo ʉlairiri ˆmwateera keende aho ncholo, moosaakwa voosi mwiikale ko kiiyenda.<verse eid="2JN 1:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="2JN 1:7"/>Vakwaata ˆvarɨ foo vara sɨ ˆvaséaa, Yéesu noo <char style="w">Masía</char> na ʉʉja na mʉvɨrɨ wa mʉʉntʉ, vafʉ́mɨɨre aha weerwii.<note caller="+" style="x"><char style="xo" closed="false">1:7 </char><char style="xt" closed="false">Laanga <ref loc="1JN 4:2-3">1 Yooháani 4:2-3</ref>.</char></note> Mʉʉntʉ ˆalʉ́ʉsaa jeyyo nɨ mʉkwaata na nɨ musíiti Kirisitʉ. <verse eid="2JN 1:7"/><verse number="8" style="v" sid="2JN 1:8"/>Haaha nyuunyu mwiiyɨmɨrɨre neeja karɨ jɨ mʉtaahe kɨra ˆmwakɨtʉmamɨra tʉkʉ, maa kaa, mʉpate kʉnáálo yaanyu ˆyakiimana.<note caller="+" style="x"><char style="xo" closed="false">1:8 </char><char style="xt" closed="false">Laanga <ref loc="1CO 3:10-15">1 Vakoríinto 3:10-15</ref>.</char></note><verse eid="2JN 1:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="2JN 1:9"/>Ʉra sɨ ˆakwáatyaa ukiindya wa Kirisitʉ, maa kaa, akʉʉreka, ʉwo asiina Mʉlʉʉngʉ tʉkʉ. Maa kaa, ʉra ˆakwáatyaa ukiindya ʉwo, avatɨɨte voosi, Taáta na Mwaana. <verse eid="2JN 1:9"/><verse number="10" style="v" sid="2JN 1:10"/>Haaha koonɨ mʉʉntʉ uújire na kwaanyu na avaretere ukiindya ˆwiísimire na ʉhʉ, mʉteengyi na kaayii jaanyu tʉkʉ na muluumbyi tʉkʉ. <verse eid="2JN 1:10"/><verse number="11" style="v" sid="2JN 1:11"/>Mʉʉntʉ yoyoosi ˆarɨ mʉteengya kʉva arɨ hamwɨ na nteendo mbɨ ja ʉwo mʉʉntʉ.<verse eid="2JN 1:11"/></para>
  <para style="s1">Lʉmbɨ jo Kiimikirirya</para>
  <para style="p">
    <verse number="12" style="v" sid="2JN 1:12"/>Natɨɨte masáare ˆyarɨ foo yo vawyɨɨra, maa kaa, sɨ noosaaka bweeyya jeyyo na wíino na karatáasi tʉkʉ. Kɨrɨ vyoova jeyyo, nookiilaangya kʉʉja ndɨrɨ na kwaanyu ndʉʉsɨke na nyuunyu miiso kwa miiso, sa kweerya mɨtɨma kwiiswi kukiimane.<verse eid="2JN 1:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="2JN 1:13"/>Vaana va irʉʉmbʉ raako ˆasaawʉlwa, vakulúumbiirye.<verse eid="2JN 1:13"/></para>
  <chapter eid="2JN 1"/>
</usx>
