<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="PSA" style="id">- WolioNT</book>
  <para style="ide">UTF-8</para>
  <para style="h">ZABURU</para>
  <para style="rem">Second team draft</para>
  <para style="toc3">Zab.</para>
  <para style="toc2">Zaburu</para>
  <para style="toc1">Zaburu</para>
  <para style="mt1">Zaburu</para>
  <para style="is">Pogau bhaa-bhaana</para>
  <para style="im">Boku <char style="bk">Zaburu </char> satotuuna sagaa minaaka i Kitabi Momangkilo momembalina boku lagu-lagu tee boku doʼa. Boku incia sii aburia manga pande burina puisii i nuncana wakutuu momangengena mpuu. Manga lagu tee manga doʼa sii arombusakea miana Israel tee apakea i nuncana sambaheana manga, kasiimpo apapesuaia i nuncana Kitabi Momangkilo. Manga kabhantina agama sii apegiu-giu: dhaangia lagu kapujia tee dhaangia lagu to tasomba Aulataʼala; dhaangia o doʼa taemani tulungi, peulusa tee kasalaamati; doʼa taemani amponi; lagu kasukuru roonamo barakatina Aulataʼala, tee doʼa mamudhaakana o musuna atohukumu. Manga doʼa incia sii dhaangia mokosifatuna to karota samia, dhaangia uka mokosifatuna to saangua lipu. Pia-pia giu minaaka i doʼa sumai aʼibaratiaka namisina samia-samia i nuncana ngangarandana, sainamo mosagaanana apogauaka ifaraluuna tee namisina bhari-bharia uumatina Aulataʼala. Manga Zaburu apakea Isa, aalea minaaka i manga pande buri Pojanjia Bhaau, tee apamembalia boku sambahea aharagaangia mpuu i Gareja Karasiteni minaaka i auwalina.</para>
  <para style="iot">Antona</para>
  <para style="io1">I - 150 Zaburu abagea i nuncana lima kolompo atawa o boku, mboomo incia sii:</para>
  <para style="io1">Boku bhaa-bhaana: Zaburu 1--41</para>
  <para style="io1">Boku i rua anguna: Zaburu 42--72</para>
  <para style="io1">Boku i talu anguna: Zaburu 73--89</para>
  <para style="io1">Boku i pata anguna: Zaburu 90--106</para>
  <para style="io1">Boku i lima anguna: Zaburu 107--150</para>
  <chapter number="1" style="c" sid="PSA 1"/>
  <para style="ms">BOKU BHAA-BHAANA:</para>
  <para style="s2">ZABURU 1--41</para>
  <para style="s">Kasanaa Saʼumurua</para>
  <para style="sr">
    <ref loc="PSA 1:1-6">1:1-6</ref></para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 1:1"/>Amasanaamo mia</para>
  <para style="q2" vid="PSA 1:1">inda moosena kaadharina mia madhaki,</para>
  <para style="q1" vid="PSA 1:1">inda aose mia mokodosa</para>
  <para style="q1" vid="PSA 1:1">tee inda aposabhangka tee manga mia pande pogauakana mia,<verse eid="PSA 1:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 1:2"/>maka mopeeluna moosena hukumuna KAWASANA OPU,</para>
  <para style="q2" vid="PSA 1:2">tee audhania malo tee eo.<verse eid="PSA 1:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 1:3"/>
    <note caller="-" style="x">
      <char style="xo" closed="false">1:3 </char>
      <char style="xt" closed="false">
        <ref loc="JER 17:8">Yer. 17:8</ref>.</char>
    </note>Mia incia sumai bheakohasili i nuncana opeapo ikarajaana.</para>
  <para style="q2" vid="PSA 1:3">Incia mboomo puuna kau ipombula i bhiwina uwe mosiwulu,</para>
  <para style="q1" vid="PSA 1:3">akobhake wakutuuna akawa bulaana,</para>
  <para style="q2" vid="PSA 1:3">tee o tawana inda amalau.<verse eid="PSA 1:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 1:4"/>Maka o mia madhaki inda mboo sumai.</para>
  <para style="q2" vid="PSA 1:4">Manga incia mboomo kulina bhae ipolakaakana ngalu.<verse eid="PSA 1:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 1:5"/>Sababuna sumai o mia madhaki bheahukumua Aulataʼala wakutuuna atoʼadili,</para>
  <para style="q2" vid="PSA 1:5">mboomo uka o mia mokodosa inda bheapapesuaia i nuncana uumatina mobanara.<verse eid="PSA 1:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 1:6"/>Sababuna o KAWASANA OPU ajagani mia mobanara,</para>
  <para style="q2" vid="PSA 1:6">maka o mia madhaki bheabinasa.<verse eid="PSA 1:6"/></para>
  <chapter eid="PSA 1"/>
  <chapter number="2" style="c" sid="PSA 2"/>
  <para style="s1">Raja Ilantina Kawasana Opu</para>
  <para style="sr">
    <ref loc="PSA 2:1-12">2:1-12</ref></para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 2:1"/>Opea o sababuna manga lipu atobungke,</para>
  <para style="q2" vid="PSA 2:1">tee manga raʼeatina lipu ahaejatiaka parakara mosia-sia?<verse eid="PSA 2:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 2:2"/>Manga rajana dunia sii apasiapuaka karona,</para>
  <para style="q2" vid="PSA 2:2">tee manga mokenina kuasa apomufakatimo</para>
  <para style="q1" vid="PSA 2:2">gauna aewangi KAWASANA OPU tee raja ipilina.<note caller="+" style="f"><char style="fr" closed="false">2:2 </char><char style="fq" closed="false">raja ipilina: </char><char style="ft" closed="false">Saro incia sii asusuaka to Isa Al Masi.</char></note> Pogauna manga incia,<verse eid="PSA 2:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 2:3"/>"Mai tabhotukia o kabhokena KAWASANA OPU tee raja ipilina,</para>
  <para style="q2" vid="PSA 2:3">tee tabhanakea o rabutana manga incia minaaka i ingkita!"<verse eid="PSA 2:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 2:4"/>Incia mokokauncuramakana i sorogaa apotawa,</para>
  <para style="q2" vid="PSA 2:4">Kawasana Opu aele-ele manga incia.<verse eid="PSA 2:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 2:5"/>I wakutuu incia sumai Kawasana Opu bheafirimani i manga incia</para>
  <para style="q2" vid="PSA 2:5">tee apatokidha manga incia tee pamuruna,<verse eid="PSA 2:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 2:6"/>"Iaku padhamo kulanti rajaku i Sion,<note caller="+" style="f"><char style="fr" closed="false">2:6 </char><char style="fq" closed="false">Sion: </char><char style="ft" closed="false">Saro kaabhi-abhina Kota Yerusalem, tampana Baitulla.</char></note></para>
  <para style="q2" vid="PSA 2:6">i gunuku momangkilona sumai."<verse eid="PSA 2:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 2:7"/>Iaku bhekupogauaka opea mopadhana ipatotapuakana KAWASANA OPU.</para>
  <para style="b" vid="PSA 2:7"/>
  <para style="q1" vid="PSA 2:7">Incia padhamo afirimaniaku, "Ingkoomo anaku,</para>
  <para style="q2" vid="PSA 2:7">i eo sii Iaku kupamembaliko anaku.<verse eid="PSA 2:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 2:8"/>Emanimo i Iaku,</para>
  <para style="q2" vid="PSA 2:8">Sumaimo bhekudhawuakako manga lipu to amembali tinaurakamu,</para>
  <para style="q2" vid="PSA 2:8">tee saangua alamu kupamembalia pewauamu.<verse eid="PSA 2:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 2:9"/>Ingkoo bheupahancuru manga incia tee katuko ase</para>
  <para style="q2" vid="PSA 2:9">tee upasakia manga mboomo poluka reo."<verse eid="PSA 2:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 2:10"/>Rampaakanamo sumai, e manga raja,</para>
  <para style="q2" vid="PSA 2:10">pewaumo aarifu!</para>
  <para style="q2" vid="PSA 2:10">Tarimamo kaadhari, e manga mokuasaina dunia!<verse eid="PSA 2:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 2:11"/>Sombamo i KAWASANA OPU tee umaekaia,</para>
  <para style="q2" vid="PSA 2:11">Rengkumo, tee upekatambe karomiu i aroana raja tee kaunde-unde.<verse eid="PSA 2:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 2:12"/>Sombamo Incia tee kakatena totona incamu</para>
  <para style="q2" vid="PSA 2:12">mamudhaakana Incia inda apamuru tee apabinasakomiu i dhala</para>
  <para style="q2" vid="PSA 2:12">roonamo Incia amasimba mpuu aʼamara.</para>
  <para style="q1" vid="PSA 2:12">Amasanaamo bhari-bharia mia</para>
  <para style="q2" vid="PSA 2:12">mopeuluna i Incia!<verse eid="PSA 2:12"/></para>
  <chapter eid="PSA 2"/>
  <chapter number="3" style="c" sid="PSA 3"/>
  <para style="s1">Doʼa Saeona to Tapoaro tee Musu</para>
  <para style="sr">
    <ref loc="PSA 3:1-9">3:1-9</ref></para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 3:1"/>Zaburuna Daud, wakutuu incia apalaiaka karona minaaka i anana mokosarona Absalom.<note caller="+" style="f"><char style="fr" closed="false">3:1 </char><char style="fq" closed="false">Absalom: </char><char style="ft" closed="false">Absalom sumai anana Raja Daud, bhemopekandawuna Daud minaaka i kauncuramakana, roonamo incia gauna bheamembali raja to abholosi Daud. Kamata </char><char style="xt"><ref loc="2SA 15:13-17:22">2Sa. 15:13--17:22</ref>.</char></note><verse eid="PSA 3:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 3:2"/>E KAWASANA OPU, abhari mpuu o bhaliku!</para>
  <para style="q2" vid="PSA 3:2">Abhari mpuu moewangiaku!<verse eid="PSA 3:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 3:3"/>Abhari o mia mopogauakaaku,</para>
  <para style="q2" vid="PSA 3:3">"Aulataʼala amendeu atulungia." <char style="qs">Sela</char><note caller="+" style="f"><char style="fr" closed="false">3:3 </char><char style="fq" closed="false">Sela: </char><char style="ft" closed="false">Aipomo tandana to aunto wakutuuna lagu sumai atolaguaka, atawa o tanda to ahanda apekaogea o suarana, atawa onina gambusuna. Amembali uka to tanda to morangoa mamudhaakana asuju. </char></note><verse eid="PSA 3:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 3:4"/>Maka Ingkoo, e KAWASANA OPU, satotuuna o katangkesiku mojaganiaku,</para>
  <para style="q2" vid="PSA 3:4">Ingkoomo mopamembaliaku kutohoromati tee mopadhadhina incaku pendua.<verse eid="PSA 3:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 3:5"/>Iaku kugora kuemani tulungi i KAWASANA OPU,</para>
  <para style="q2" vid="PSA 3:5">tee Incia alawaniaku minaaka i gununa momangkilo.<note caller="+" style="f"><char style="fr" closed="false">3:5 </char><char style="fq" closed="false">gununa momangkilo: </char><char style="ft" closed="false">Gunu Sion i Kota Yerusalem, tampana ibaadatina miana Yahudi, siitumo Baitulla. Siitumo, miana Yahudi kananeana asarongiakea Gunu Sion "gununa momangkilo."</char></note> <char style="qs">Sela</char><verse eid="PSA 3:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 3:6"/>Iaku kupotidhole kukole, kasiimpo alipa o mataku,</para>
  <para style="q2" vid="PSA 3:6">tee kubhangu roonamo KAWASANA OPU motukoaku.<verse eid="PSA 3:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 3:7"/>Iaku inda kumaeka tee rewu-rewuna musu</para>
  <para style="q2" vid="PSA 3:7">bhemolibuaku minaaka i bhari-bharia rope.<verse eid="PSA 3:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 3:8"/>Bhangumo, KAWASANA OPU, tulungiaku e Aulataʼalaku!</para>
  <para style="q2" vid="PSA 3:8">Umbe, Ingkoo ubhebhe naunauna bhari-bharia musuku,</para>
  <para style="q2" vid="PSA 3:8">tee upekakatu ngincina manga mia madhaki.<verse eid="PSA 3:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 3:9"/>Kasalaamati aumba minaaka i KAWASANA OPU.</para>
  <para style="q2" vid="PSA 3:9">Barakatimu to uumatimu! <char style="qs">Sela</char><verse eid="PSA 3:9"/></para>
  <chapter eid="PSA 3"/>
  <chapter number="4" style="c" sid="PSA 4"/>
  <para style="s1">Doʼana Malo</para>
  <para style="sr">
    <ref loc="PSA 4:1-9">4:1-9</ref></para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 4:1"/>To kapalana molaguna. Tee kagasiana gambusu. Zaburuna Daud.<verse eid="PSA 4:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 4:2"/>E Aulataʼala, Ingkoomo moewaakaaku,</para>
  <para style="q2" vid="PSA 4:2">lawaniaku wakutuuna kugora.</para>
  <para style="q1" vid="PSA 4:2">Ingkoo udhawuaku kalalesa wakutuuna kumaseke.</para>
  <para style="q2" vid="PSA 4:2">Maasiakaaku tee rangomea o doʼaku!<verse eid="PSA 4:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 4:3"/>E manga mia, saopea uka o kangengena ingkomiu upekarombu kamuliangiku?</para>
  <para style="q2" vid="PSA 4:3">Saopea uka o kangengena umaasiaka giu mosia-sia tee upeelo giu inda mobanara? <char style="qs">Sela</char><verse eid="PSA 4:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 4:4"/>Mataua ande o KAWASANA OPU padhamo apili samia mosaalihina to karona,</para>
  <para style="q2" vid="PSA 4:4">KAWASANA OPU bhearangoa ande kugora i Incia.<verse eid="PSA 4:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 4:5"/>
    <note caller="-" style="x">
      <char style="xo" closed="false">4:5 </char>
      <char style="xt" closed="false">
        <ref loc="EPH 4:26">Ef. 4:26</ref>.</char>
    </note>Wakutuuna uʼamara, bholimo upewau dosa!</para>
  <para style="q2" vid="PSA 4:5">Pogaumo i nuncana ngangarandamu i kolemamu,</para>
  <para style="q2" vid="PSA 4:5">tee bholi tee uuʼuumu. <char style="qs">Sela</char><verse eid="PSA 4:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 4:6"/>Pasombaakamea o kurubani ipatotapuakana to Aulataʼala,</para>
  <para style="q2" vid="PSA 4:6">tee uparacaeamo i KAWASANA OPU.<verse eid="PSA 4:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 4:7"/>Abhari o mia mopogauna, "Incema bhemosusuakana kalape to ingkita?"</para>
  <para style="q2" vid="PSA 4:7">E KAWASANA OPU, taroakamo caheana roumu asuluwi ingkami!<verse eid="PSA 4:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 4:8"/>Ingkoo upewau incaku akaunde-unde</para>
  <para style="q2" vid="PSA 4:8">alabhi minaaka i kaunde-undena o mia motaralabhi-labhina timpuana gandum tee angguruna.<verse eid="PSA 4:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 4:9"/>Tee namisi momasanaa bhekupotidhole, kasiimpo kutokole,</para>
  <para style="q2" vid="PSA 4:9">sababuna tangkanamo Ingkoo KAWASANA OPU,</para>
  <para style="q2" vid="PSA 4:9">mopewauna dhadhiku aʼamani!<verse eid="PSA 4:9"/></para>
  <chapter eid="PSA 4"/>
  <chapter number="5" style="c" sid="PSA 5"/>
  <para style="s1">Doʼana Saeona</para>
  <para style="sr">
    <ref loc="PSA 5:1-13">5:1-13</ref></para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 5:1"/>To kapalana molaguna. Tee kagasiana suli. Zaburuna Daud.<verse eid="PSA 5:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 5:2"/>E KAWASANA OPU, rangoa o pogauku,</para>
  <para style="q2" vid="PSA 5:2">perangoia ipeenciakaku.<verse eid="PSA 5:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 5:3"/>Rangoa o goraku kuemani tulungi,</para>
  <para style="q2" vid="PSA 5:3">e Rajaku tee Aulataʼalaku,</para>
  <para style="q2" vid="PSA 5:3">roonamo i Ingkoomo iaku kudoʼa.<verse eid="PSA 5:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 5:4"/>E KAWASANA OPU, i wakutuuna raneeo Ingkoo urango doʼaku,</para>
  <para style="q2" vid="PSA 5:4">i wakutuuna raneeo kuʼatoro pasombaa to Ingkoo<note caller="+" style="f"><char style="fr" closed="false">5:4 </char><char style="fq" closed="false">pasombaa to Ingkoo: </char><char style="ft" closed="false">Maʼanana mencuana o Aulataʼala mofaraluuna saangu giu motopasombaakana to Incia (kamata </char><char style="xt"><ref loc="PSA 50:9-13">Zab. 50:9-13</ref></char>). Bhari-bharia motopasombaakana satotuuna to tamuliangi Incia, tasukuru i Incia, tee mamudhaakana amasanaa o namisina.</note> tee kuantaantagi kalawanimu.<verse eid="PSA 5:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 5:5"/>Ingkoo mencuana Aulataʼala momaasiakana pewauna mia mokodosa;</para>
  <para style="q2" vid="PSA 5:5">mia madhaki inda amembali amboore i aroamu.<verse eid="PSA 5:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 5:6"/>Mia mosomboakana karona inda uundaakea adhaangia i aroamu.</para>
  <para style="q2" vid="PSA 5:6">Ingkoo ubanci bhari-bharia mia mopewauna kadhaki.<verse eid="PSA 5:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 5:7"/>Ingkoo upabinasa manga mia mogau-gau.</para>
  <para style="q2" vid="PSA 5:7">Umarikaia ukamata pande pekamatena mia tee pande tipu.<verse eid="PSA 5:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 5:8"/>Maka rampaakanamo kaasimu inda momabhotu,</para>
  <para style="q2" vid="PSA 5:8">iaku bhekupesua i nuncana bhanuamu,</para>
  <para style="q1" vid="PSA 5:8">tee kusuju kusomba kupoaro i bhanuamu momangkilo,</para>
  <para style="q2" vid="PSA 5:8">tee kumaeka i Ingkoo.<verse eid="PSA 5:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 5:9"/>E KAWASANA OPU, susuakaaku dhalamu mobanara</para>
  <para style="q2" vid="PSA 5:9">roonamo manga musuku mojoli-joliaku.</para>
  <para style="q1" vid="PSA 5:9">Pekakatea o dhalamu i aroaku,</para>
  <para style="q2" vid="PSA 5:9">mamudhaakana kumembali kuose peeluamu.<verse eid="PSA 5:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 5:10"/>Sababuna pogauna manga incia inda amembali atoparacaea,</para>
  <para style="q2" vid="PSA 5:10">i nuncana ngangarandana, manga incia gauna apahancuru mia mosagaanana.</para>
  <para style="q1" vid="PSA 5:10">Goncona manga incia mboomo koburu moponganga,</para>
  <para style="q2" vid="PSA 5:10">dhela tee kawujuna manga incia amameko.<verse eid="PSA 5:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 5:11"/>E Aulataʼala, taroakamo manga incia atanggo kasalahana,</para>
  <para style="q2" vid="PSA 5:11">bheakangkanai i karona opea mopadhana ihaejatiakana to mia.</para>
  <para style="q1" vid="PSA 5:11">Padhencua manga incia roonamo abhari o kasalahana,</para>
  <para style="q2" vid="PSA 5:11">tee manga incia adorohaka i Ingkoo.<verse eid="PSA 5:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 5:12"/>Maka bhari-bharia mia mopeuluna i Ingkoo bheakaunde-unde,</para>
  <para style="q2" vid="PSA 5:12">manga incia bheasambo-sambo saʼumurua.</para>
  <para style="q1" vid="PSA 5:12">Jagania manga mia momaasiakana saromu,</para>
  <para style="q2" vid="PSA 5:12">mamudhaakana manga incia akaunde-unde i nuncana opea ipewaumu.<verse eid="PSA 5:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 5:13"/>Sababuna Ingkoomo mobarakatina mia mobanara, e KAWASANA OPU,</para>
  <para style="q2" vid="PSA 5:13">Ingkoo ujagani manga incia tee kaasimu mboomo katangkesi.<verse eid="PSA 5:13"/></para>
  <chapter eid="PSA 5"/>
  <chapter number="6" style="c" sid="PSA 6"/>
  <para style="s1">Doʼa i Nuncana Kanarakaa</para>
  <para style="sr">
    <ref loc="PSA 6:1-11">6:1-11</ref></para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 6:1"/>To kapalana molaguna, tee kagasiana gambusu. Mboomo lagu: I walu anguna. Zaburuna Daud.<verse eid="PSA 6:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 6:2"/>E KAWASANA OPU, bholi uhukumuaku i nuncana amaramu,</para>
  <para style="q2" vid="PSA 6:2">tee bholi uwanduaku i nuncana pamurumu.<verse eid="PSA 6:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 6:3"/>Maasiakaaku, e KAWASANA OPU, sababuna atopadhamo bukuku,</para>
  <para style="q2" vid="PSA 6:3">pekatangkaaku roonamo bukuku arengku.<verse eid="PSA 6:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 6:4"/>Amapii incaku.</para>
  <para style="q2" vid="PSA 6:4">Bholi upekangenge inda ulawaniaku, e KAWASANA OPU!<verse eid="PSA 6:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 6:5"/>E KAWASANA OPU, mbulimo, tee utulungiaku minaaka i mate!</para>
  <para style="q2" vid="PSA 6:5">Pasalaamatiaku roonamo kaasimu molagina.<verse eid="PSA 6:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 6:6"/>Sababuna i alamuna mia mate Ingkoo indamo utoudhani,</para>
  <para style="q2" vid="PSA 6:6">tee i nuncana koburu indamo dhaangia uka mosukuruna tee Ingkoo.<verse eid="PSA 6:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 6:7"/>Iaku kumangule roonamo kapeenciku,</para>
  <para style="q2" vid="PSA 6:7">samalo-samalo loluku apotiburi abhaho kolemaku.<verse eid="PSA 6:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 6:8"/>Mataku amarea roonamo kaporona inca,</para>
  <para style="q2" vid="PSA 6:8">tee amarawu roonamo bhari-bharia bhaliku.<verse eid="PSA 6:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 6:9"/>
    <note caller="-" style="x">
      <char style="xo" closed="false">6:9 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 7:23">Mat. 7:23</ref>; <ref loc="LUK 13:27">Luk. 13:27</ref>.</char>
    </note>Dhencumo minaaka i karoku, e manga mia mopewauna kadhaki,</para>
  <para style="q2" vid="PSA 6:9">roonamo KAWASANA OPU arangoa o tangiku.<verse eid="PSA 6:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 6:10"/>KAWASANA OPU arangomea iemaniku</para>
  <para style="q2" vid="PSA 6:10">tee atarimamea o doʼaku.<verse eid="PSA 6:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 6:11"/>Bhari-bharia musuku bheanamisi kaea tee atokidha mpuu,</para>
  <para style="q2" vid="PSA 6:11">manga incia asowo tee apokawaaka kaea sakijamata.<verse eid="PSA 6:11"/></para>
  <chapter eid="PSA 6"/>
  <chapter number="7" style="c" sid="PSA 7"/>
  <para style="s1">Doʼa Emaniana Kaʼadili</para>
  <para style="sr">
    <ref loc="PSA 7:1-18">7:1-18</ref></para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 7:1"/>Lagu kaporona incana Daud, ilaguakana to KAWASANA OPU roonamo Kus, miana Binyamin sumai.<verse eid="PSA 7:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 7:2"/>E KAWASANA OPU, e Aulataʼalaku, Ingkoomo peulusaku,</para>
  <para style="q2" vid="PSA 7:2">pasalaamatiaku tee rambasakaaku minaaka i bhari-bharia mia mopajereaku<verse eid="PSA 7:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 7:3"/>mamudhaakana manga incia inda apapakiaku mboo singa</para>
  <para style="q2" vid="PSA 7:3">asoroaku tee abheka-bhekaaku wakutuuna inda dhaangia motulungiaku.<verse eid="PSA 7:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 7:4"/>E KAWASANA OPU, e Aulataʼalaku, ande kupewau giu incia sii:</para>
  <para style="q2" vid="PSA 7:4">Ande kupewau inda aʼadili i mia mosagaanana,<verse eid="PSA 7:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 7:5"/>ande kuhianati sabhangkaku,</para>
  <para style="q2" vid="PSA 7:5">atawa kurampasi musuku inda tee sababuna,<verse eid="PSA 7:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 7:6"/>taroakamo musuku apajereaku tee arakoaku,</para>
  <para style="q2" vid="PSA 7:6">kasiimpo alandalandakiaku i tana,</para>
  <para style="q2" vid="PSA 7:6">tee adhika kamuliangiku i nuncana ngawu. <char style="qs">Sela</char><verse eid="PSA 7:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 7:7"/>E KAWASANA OPU bhangumo i nuncana pamurumu,</para>
  <para style="q2" vid="PSA 7:7">kakaromo to uewangiaka manga musuku!</para>
  <para style="q2" vid="PSA 7:7">Bhangumo to iaku, roonamo Ingkoomo moʼadilina maanusia.<verse eid="PSA 7:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 7:8"/>Rombusakamea bhari-bharia lipu i saripimu,</para>
  <para style="q2" vid="PSA 7:8">tee ukapalaimea manga incia i bhawona kauncuramakamu momalanga.<verse eid="PSA 7:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 7:9"/>KAWASANA OPU moʼadilina parakarana manga lipu.</para>
  <para style="q2" vid="PSA 7:9">E KAWASANA OPU, dhawuaku kaʼadili,</para>
  <para style="q2" vid="PSA 7:9">roonamo ipewauku abanara tee amakate totona incaku.<verse eid="PSA 7:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 7:10"/>
    <note caller="-" style="x">
      <char style="xo" closed="false">7:10 </char>
      <char style="xt" closed="false">
        <ref loc="REV 2:23">Wah. 2:23</ref>.</char>
    </note>Pauntoa o mia mokodosa apewau momadhakina,</para>
  <para style="q2" vid="PSA 7:10">tee upekatangkea incana mia mosaalihi,</para>
  <para style="q1" vid="PSA 7:10">sababuna Ingkoo Aulataʼala mobanara,</para>
  <para style="q2" vid="PSA 7:10">momatauna incana tee baatinina maanusia.<verse eid="PSA 7:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 7:11"/>Katangkesiku satotuuna o Aulataʼala,</para>
  <para style="q2" vid="PSA 7:11">mopasalaamatina mia momakatena totona incana.<verse eid="PSA 7:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 7:12"/>Aulataʼala satotuuna haakimu mobanara,</para>
  <para style="q2" vid="PSA 7:12">Incia apamuru saesaeo tee mia mopewauna kadhaki.<verse eid="PSA 7:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 7:13"/>Ande dhaangia o mia inda motoba, sumaimo Kawasana Opu bheawinto hancuna,</para>
  <para style="q2" vid="PSA 7:13">tee apasiapu panana.<verse eid="PSA 7:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 7:14"/>Incia apasiapuaka karona tee ewanga motomateaka,</para>
  <para style="q2" vid="PSA 7:14">tee akarajaa matana pana mokowaa.<verse eid="PSA 7:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 7:15"/>Satotuuna o mia incia sumai akokadhumaaka kadhaki,</para>
  <para style="q2" vid="PSA 7:15">incia abhawa kasega i nuncana karona tee apalaahiri gau-gau.<verse eid="PSA 7:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 7:16"/>Incia aseli kabhalongko to mia mosagaanana,</para>
  <para style="q2" vid="PSA 7:16">maka o karona mokotibuna.<verse eid="PSA 7:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 7:17"/>Jadi incia ahukumua kasegana tee haejatina karona,</para>
  <para style="q2" vid="PSA 7:17">tee o kasega ipewauna bheapanarakaa karona.<verse eid="PSA 7:17"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 7:18"/>Iaku bhekusukuru i KAWASANA OPU roonamo Incia aʼadili,</para>
  <para style="q2" vid="PSA 7:18">tee kulaguaka kapujia to KAWASANA OPU Momalanga.<verse eid="PSA 7:18"/></para>
  <chapter eid="PSA 7"/>
  <chapter number="8" style="c" sid="PSA 8"/>
  <para style="s1">Mahaluku Mohina mboomo Mahaluku Momulia</para>
  <para style="sr">
    <ref loc="PSA 8:1-10">8:1-10</ref></para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 8:1"/>To kapalana molaguna. Mboomo lagu Gitit.<note caller="+" style="f"><char style="fr" closed="false">8:1 </char><char style="fq" closed="false">Gitit: </char><char style="ft" closed="false">Zaburu incia sii aose suarana lagu tee gambusu minaaka i Gat, siitumo sala saangu kota miana Filistin. Gat sumai mopadhana imbooresina Nabii Daud wakutuuna apalaiaka karona minaaka i Raja Saul.</char></note> Zaburuna Daud.<verse eid="PSA 8:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 8:2"/>E KAWASANA OPU,<note caller="+" style="f"><char style="fr" closed="false">8:2 </char><char style="fq" closed="false">KAWASANA OPU: </char><char style="ft" closed="false">Ande atoburi tee horofu maoge, saro incia sii o sarona karona Aulataʼala i oni Ibrani atosarongi YAHWEH, sainamo ande atoburi tee horofu maidhiidhi, maʼanana o Kawasana Opu (Ibrani: Adonai).</char></note> e Aulataʼalamami,</para>
  <para style="q2" vid="PSA 8:2">saromu amulia i saangua alamu!</para>
  <para style="q2" vid="PSA 8:2">Kaogesana kuasamu alabhi kalangana minaaka i laiana.<verse eid="PSA 8:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 8:3"/>
    <note caller="-" style="x">
      <char style="xo" closed="false">8:3 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 21:16">Mat. 21:16</ref>.</char>
    </note>Minaaka i ngangana manga anaana momaidhiidhi tee anaana modudu uka apuji kamuliangimu.</para>
  <para style="q2" vid="PSA 8:3">Roonamo Ingkoo padhamo upakaro bente potaangia momatangka</para>
  <para style="q2" vid="PSA 8:3">sabutuna o ngangana bhari-bharia musu tee bhalimu atosoncongi.<verse eid="PSA 8:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 8:4"/>Ande kutonto tee kufikiri laiana ipadhaangiamu,</para>
  <para style="q2" vid="PSA 8:4">bula tee kalipopo idhikamu,<verse eid="PSA 8:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 8:5"/>
    <note caller="-" style="x">
      <char style="xo" closed="false">8:5 </char>
      <char style="xt" closed="false">
        <ref loc="JOB 7:17">Ayb. 7:17</ref>; <ref loc="PSA 144:3">Zab. 144:3</ref>; <ref loc="HEB 2:6-8">Ibr. 2:6-8</ref>.</char>
    </note>incema buaka o maanusia sumai, mbakana uudhania,</para>
  <para style="q2" vid="PSA 8:5">incema buaka o incia, mbakana udhambaakea?<verse eid="PSA 8:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 8:6"/>Maka upewau maanusia saidhepo apokana tee Aulataʼala,<note caller="+" style="f"><char style="fr" closed="false">8:6 </char><char style="fq" closed="false">Aulataʼala: </char><char style="ft" closed="false">Amembali uka maʼanana manga malaaʼekati atawa o mahalukuna sorogaa.</char></note></para>
  <para style="q2" vid="PSA 8:6">upakanaakea tee mahakota kamuliangi tee kahoromati.<verse eid="PSA 8:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 8:7"/>
    <note caller="-" style="x">
      <char style="xo" closed="false">8:7 </char>
      <char style="xt" closed="false">
        <ref loc="1CO 15:27">1Kor. 15:27</ref>; <ref loc="EPH 1:22">Ef. 1:22</ref>; <ref loc="HEB 2:8">Ibr. 2:8</ref>.</char>
    </note>Udhawua kuasa to saangua alamu,</para>
  <para style="q2" vid="PSA 8:7">bhari-bharia ipadhaangiamu upatungkua i incia:<verse eid="PSA 8:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 8:8"/>Dumba, sapi tee bhari-bharia binata kadhambaaka,</para>
  <para style="q2" vid="PSA 8:8">tee manga binata i rumpu;<verse eid="PSA 8:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 8:9"/>Manu-manu tee manga ikane</para>
  <para style="q2" vid="PSA 8:9">bhari-bharia mahaluku i nuncana tawo.<verse eid="PSA 8:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 8:10"/>E KAWASANA OPU, Aulataʼalamami,</para>
  <para style="q2" vid="PSA 8:10">saromu amulia i saangua alamu!<verse eid="PSA 8:10"/></para>
  <chapter eid="PSA 8"/>
  <chapter number="9" style="c" sid="PSA 9"/>
  <para style="s1">Kawasana Opu Peulusana Mia Mosaalihi</para>
  <para style="sr">
    <ref loc="PSA 9:1-10:18">9:1--10:18</ref></para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 9:1"/>To kapalana molaguna. Mboomo lagu: Matena Samia Ana. Zaburuna Daud.<verse eid="PSA 9:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 9:2"/>Iaku bhekusukuru i KAWASANA OPU, tee mpuu-mpuuna incaku;</para>
  <para style="q2" vid="PSA 9:2">iaku bhekupetulatulaaka bhari-bharia ipewaumu inda momentela.<verse eid="PSA 9:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 9:3"/>Iaku bhekukaunde-unde tee kumasanaa roonamo Ingkoo;</para>
  <para style="q2" vid="PSA 9:3">iaku bhekulaguaka manga kapujia roonamo saromu, e KAWASANA OPU Momalanga.<verse eid="PSA 9:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 9:4"/>Wakutuuna manga musuku asowo,</para>
  <para style="q2" vid="PSA 9:4">manga incia atosunu tee abinasa i aroamu.<verse eid="PSA 9:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 9:5"/>Ingkoo uewaaka parakaraku tee hakuku.</para>
  <para style="q2" vid="PSA 9:5">Ingkoo uhaakimu tee kabanara i bhawona kauncuramakamu.<verse eid="PSA 9:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 9:6"/>Ingkoo padhamo uhaakimu manga lipu</para>
  <para style="q2" vid="PSA 9:6">tee upabinasa manga mia madhaki,</para>
  <para style="q1" vid="PSA 9:6">Ingkoo padhamo uhapusua sarona manga incia</para>
  <para style="q2" vid="PSA 9:6">to saʼumurua.<verse eid="PSA 9:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 9:7"/>Manga musu amapupumo atopabinasa,</para>
  <para style="q2" vid="PSA 9:7">manga incia amofu saʼumurua.</para>
  <para style="q1" vid="PSA 9:7">Kota-kotana manga incia padhamo upahancurua mboomo ngawu atontalesaka,</para>
  <para style="q2" vid="PSA 9:7">kaudhania to manga incia uka ailamo.<verse eid="PSA 9:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 9:8"/>Maka, KAWASANA OPU akokuasa saʼumurua.</para>
  <para style="q2" vid="PSA 9:8">Incia padhamo apatotapuaka kauncuramakana to aʼadili maanusia.<verse eid="PSA 9:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 9:9"/>Inciamo bhemohaakimuna dunia sii tee kabanara,</para>
  <para style="q2" vid="PSA 9:9">Incia ahaakimu manga lipu tee kaʼadili.<verse eid="PSA 9:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 9:10"/>Sumaimo KAWASANA OPU amembali tampana peulusa to mia motopisaki,</para>
  <para style="q2" vid="PSA 9:10">tampana peulusa i wakutuuna kanarakaa.<verse eid="PSA 9:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 9:11"/>Manga mia momatauna saromu</para>
  <para style="q2" vid="PSA 9:11">adhika kaparacaeana i Ingkoo,</para>
  <para style="q1" vid="PSA 9:11">roonamo Ingkoo inda ubholi</para>
  <para style="q2" vid="PSA 9:11">mia mopeelona Ingkoo, e KAWASANA OPU.<verse eid="PSA 9:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 9:12"/>Lagumo tee pujimo KAWASANA OPU moparintana i Sion!</para>
  <para style="q2" vid="PSA 9:12">Pakoleleakamea manga pewauna i tanga-tangana manga lipu!<verse eid="PSA 9:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 9:13"/>Sababuna Incia audhani manga mia monarakaa</para>
  <para style="q2" vid="PSA 9:13">tee inda amalinguaka gorana mia motopisaki;</para>
  <para style="q2" vid="PSA 9:13">manga pande pekamatena mia bheabalasia tee ahukumua.<verse eid="PSA 9:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 9:14"/>E KAWASANA OPU, maasiakaaku;</para>
  <para style="q2" vid="PSA 9:14">kamatea o kanarakaa ipewauna manga mia mobanciaku,</para>
  <para style="q2" vid="PSA 9:14">e Aulataʼala pasalaamatiaku minaaka i mate,<verse eid="PSA 9:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 9:15"/>mamudhaakana amembali kupujiko i bhambana kotana Puteri Sion,<note caller="+" style="f"><char style="fr" closed="false">9:15 </char><char style="fq" closed="false">Puteri Sion: </char><char style="ft" closed="false">Sarona to kota Yerusalem, roonamo atobhangu i Gunu Sion.</char></note> siitumo i raʼeatina Yerusalem,</para>
  <para style="q2" vid="PSA 9:15">roonamo upasalaamatiaku.<verse eid="PSA 9:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 9:16"/>Manga lipu amandawu i nuncana bhalo mopadhana ikarajaana manga incia,</para>
  <para style="q2" vid="PSA 9:16">Manga incia apesua i nuncana jari ipasana tee ibuniakana karona.<verse eid="PSA 9:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 9:17"/>KAWASANA OPU apapematauaka karona,</para>
  <para style="q2" vid="PSA 9:17">tee aʼadili ahaakimu maanusia.</para>
  <para style="q1" vid="PSA 9:17">Mia madhaki akana i katapu ikarajaana karona. <char style="qs">Sela</char><verse eid="PSA 9:17"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 9:18"/>Manga mia madhaki bheambuli i duniana mia mate,</para>
  <para style="q2" vid="PSA 9:18">siitumo bhari-bharia lipu momalinguakana Aulataʼala.<verse eid="PSA 9:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 9:19"/>Maka o mia misikini inda sadia bheatomalinguaka,</para>
  <para style="q2" vid="PSA 9:19">tee inda saʼumurua bheaila opea iharapuna o mia monarakaa.<verse eid="PSA 9:19"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 9:20"/>E KAWASANA OPU, bhangumo. Bholi utaroakea o maanusia akana!</para>
  <para style="q2" vid="PSA 9:20">Taroakamo manga lipu sumai uʼadilia i aroamu.<verse eid="PSA 9:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 9:21"/>Pekaekaia manga incia, e KAWASANA OPU!</para>
  <para style="q2" vid="PSA 9:21">Mamudhaakana manga lipu sumai amataua ande manga incia tangkanamo maanusia. <char style="qs">Sela</char><verse eid="PSA 9:21"/></para>
  <chapter eid="PSA 9"/>
  <chapter number="10" style="c" sid="PSA 10"/>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 10:1"/>E KAWASANA OPU, pokia Ingkoo upekaridho?</para>
  <para style="q2" vid="PSA 10:1">Pokia Ingkoo ubuniaka karomu i wakutuuna ingkami tamaseke?<verse eid="PSA 10:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 10:2"/>Mia madhaki mosombo apajere mia motopisaki,</para>
  <para style="q2" vid="PSA 10:2">taroakamo manga incia akangkanaia katapuna momadhaki ihaejatiakana karona.<verse eid="PSA 10:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 10:3"/>Roonamo mia madhaki apuji-puji peeluana incana,</para>
  <para style="q2" vid="PSA 10:3">tee o mia masoʼo apekatunda tee ahina KAWASANA OPU.<verse eid="PSA 10:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 10:4"/>Mia madhaki apogau tee kasombo,</para>
  <para style="q2" vid="PSA 10:4">"Aulataʼala inda bheatuntua."</para>
  <para style="q2" vid="PSA 10:4">I fikirina tangkanamo, "Inda dhaangia o Aulataʼala!"<verse eid="PSA 10:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 10:5"/>Mia madhaki sadia apotibhaaka sagala ipeeluna.</para>
  <para style="q2" vid="PSA 10:5">Hukumuna Aulataʼala inda dhaangia o maʼanana to incia.</para>
  <para style="q3" vid="PSA 10:5">Incia apandaʼente bhari-bharia bhalina.<verse eid="PSA 10:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 10:6"/>Mia mokodosa apogau i nuncana ngangarandana, "Iaku sadhaadhaa bhekumatangka,</para>
  <para style="q2" vid="PSA 10:6">tee saʼumurua inda bheakangkanaiaku balaa."<verse eid="PSA 10:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 10:7"/>Ande apogau, o ngangana abukeaka katunda, gau-gau, tee kapisaki.</para>
  <para style="q2" vid="PSA 10:7">Incia sadia abhoasaka pogau madhaki tee apekabanci.<verse eid="PSA 10:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 10:8"/>Incia apekantaa i desa-desa,</para>
  <para style="q2" vid="PSA 10:8">Apekamate mia inda mosala, i tampa momalino.</para>
  <para style="q2" vid="PSA 10:8">Incia alukuti mia momalute.<verse eid="PSA 10:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 10:9"/>Incia apekantaa i tampa momalino</para>
  <para style="q2" vid="PSA 10:9">Mboomo singa i nuncana rumpu.</para>
  <para style="q1" vid="PSA 10:9">Incia apekantaa to arako mia motopisaki.</para>
  <para style="q2" vid="PSA 10:9">Arako mia motopisaki tee apapesuaia i nuncana jarina.<verse eid="PSA 10:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 10:10"/>Incia aʼungko mamudhaakana apekapapaki,</para>
  <para style="q2" vid="PSA 10:10">kasiimpo tee kakaana bukuna incia apakotibu mia malute sumai.<verse eid="PSA 10:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 10:11"/>Pogauna i nuncana ngangarandana, "Aulataʼala inda afaduliakea,</para>
  <para style="q2" vid="PSA 10:11">Incia apopiro tee sadia inda akamata opeopea uka."<verse eid="PSA 10:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 10:12"/>E KAWASANA OPU, bhangumo. Hukumumea manga mia madhaki!</para>
  <para style="q2" vid="PSA 10:12">Bholi umalinguaka mia motopisaki.<verse eid="PSA 10:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 10:13"/>Apokia manga mia madhaki sadia ahina Aulataʼala?</para>
  <para style="q2" vid="PSA 10:13">Manga incia apogau i nuncana ngangarandana, "Ingkoo inda bheutuntua!"<verse eid="PSA 10:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 10:14"/>Maka Ingkoo dhaanamo ukamatea, roonamo Ingkoomo mokamatana manga mia mosukara tee mia monarakaa,</para>
  <para style="q2" vid="PSA 10:14">tee uewaaka parakarana manga incia.</para>
  <para style="q1" vid="PSA 10:14">Mia momalute apasarakaaka karona i Ingkoo,</para>
  <para style="q2" vid="PSA 10:14">roonamo Ingkoomo motulungina manga ana maelu.<note caller="+" style="f"><char style="fr" closed="false">10:14 </char><char style="fq" closed="false">manga ana maelu: </char><char style="ft" closed="false">I nuncana oni Ibrani, pogau incia sii amenturu atopake to apogauaka manga mia monarakaa tee momisikini sababuna inda dhaangia modhambaakana manga incia.</char></note><verse eid="PSA 10:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 10:15"/>Katukimea o takiona mia mokodosa tee mia madhaki,</para>
  <para style="q2" vid="PSA 10:15">tuntumea o dosana manga incia,</para>
  <para style="q2" vid="PSA 10:15">sakawana inda upotibhaakea uka.<verse eid="PSA 10:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 10:16"/>KAWASANA OPU aparinta saʼumurua,</para>
  <para style="q2" vid="PSA 10:16">manga lipu inda momatauna Incia bheamofu minaaka i lipuna.<verse eid="PSA 10:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 10:17"/>
    <note caller="-" style="x">
      <char style="xo" closed="false">10:17 </char>
      <char style="xt" closed="false">
        <ref loc="ROM 3:14">Rom. 3:14</ref>.</char>
    </note>E KAWASANA OPU, opea ipeeluna manga mia motopisaki uperangoia.</para>
  <para style="q2" vid="PSA 10:17">Ingkoo bheupekatangka incana manga incia,</para>
  <para style="q2" vid="PSA 10:17">tee utaaia o talingamu<verse eid="PSA 10:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 10:18"/>to uewaaka ana maelu tee mia motopisaki</para>
  <para style="q2" vid="PSA 10:18">mamudhaakana inda dhaangia o maanusia mopekaekana manga incia.<verse eid="PSA 10:18"/></para>
  <chapter eid="PSA 10"/>
  <chapter number="11" style="c" sid="PSA 11"/>
  <para style="s">KAWASANA OPU Tampana Peulusa</para>
  <para style="sr">
    <ref loc="PSA 11:1-7">11:1-7</ref></para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 11:1"/>To kapalana molaguna. Zaburuna Daud.</para>
  <para style="b" vid="PSA 11:1"/>
  <para style="q1" vid="PSA 11:1">Iaku kupeulu i KAWASANA OPU;</para>
  <para style="q2" vid="PSA 11:1">inda tee faʼedana upogau tee iaku,</para>
  <para style="q2" vid="PSA 11:1">"Pasalaamatimea o karomu mboomo manu-manu mopolakana i gunu.<verse eid="PSA 11:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 11:2"/>Roonamo mia madhaki apekangkanamo panana</para>
  <para style="q2" vid="PSA 11:2">tee apasa matana panana</para>
  <para style="q2" vid="PSA 11:2">to apana mia momakatena incana i tampa momalalanda.<verse eid="PSA 11:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 11:3"/>Ande o tuturana raʼeatina atopahancuru,</para>
  <para style="q2" vid="PSA 11:3">mia mobanara inda amembali apewau opeopea."<verse eid="PSA 11:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 11:4"/>KAWASANA OPU dhaangia i nuncana Baitulla momangkilo,</para>
  <para style="q2" vid="PSA 11:4">kauncuramakana KAWASANA OPU dhaangia i sorogaa.</para>
  <para style="q1" vid="PSA 11:4">Incia atiliki maanusia</para>
  <para style="q2" vid="PSA 11:4">tee amataua sabhara ipewauna manga incia.<verse eid="PSA 11:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 11:5"/>KAWASANA OPU auji mia mobanara tee mia madhaki,</para>
  <para style="q2" vid="PSA 11:5">Incia abanci mia mopewauna kasega.<verse eid="PSA 11:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 11:6"/>Incia bheapadhaangia balaa to mia madhaki tee apasapoakea tee waa morore tee walera,</para>
  <para style="q2" vid="PSA 11:6">tee ngalu imangauaka siitumo to kahukumuna mia madhaki.<verse eid="PSA 11:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 11:7"/>Sababuna KAWASANA OPU aʼadili,</para>
  <para style="q2" vid="PSA 11:7">Incia amaasiaka kabanara.</para>
  <para style="q2" vid="PSA 11:7">Mia momakatena incana bheakamata tee bheamatau Incia.<verse eid="PSA 11:7"/></para>
  <chapter eid="PSA 11"/>
  <chapter number="12" style="c" sid="PSA 12"/>
  <para style="s1">Doʼa Emaniana Tulungi i KAWASANA OPU</para>
  <para style="sr">
    <ref loc="PSA 12:1-9">12:1-9</ref></para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 12:1"/>To kapalana molaguna. Mboomo lagu: I walu anguna. Zaburuna Daud.<verse eid="PSA 12:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 12:2"/>E KAWASANA OPU, manga tulungipo,</para>
  <para style="q2" vid="PSA 12:2">sababuna indamo dhaangia mia mosaalihi,</para>
  <para style="q2" vid="PSA 12:2">manga mia motaʼatina tee Ingkoo indamo dhaangia.<verse eid="PSA 12:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 12:3"/>Manga incia bhari-bharia aposapopagau-gau, podho-podho manga incia;</para>
  <para style="q2" vid="PSA 12:3">dhelana manga incia apekapuji, maka o ngangarandana apekatipu.<verse eid="PSA 12:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 12:4"/>Maasangia o KAWASANA OPU adhodho bhari-bharia bhiwina manga mia momamekona pogauna</para>
  <para style="q2" vid="PSA 12:4">tee dhelana manga mia mosombo.<verse eid="PSA 12:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 12:5"/>Manga incia apogau,</para>
  <para style="q1" vid="PSA 12:5">"Ingkami takokuasa tee pogau ibhoasakamami!</para>
  <para style="q2" vid="PSA 12:5">Ingkami tatangkaaka bhiwimami!</para>
  <para style="q2" vid="PSA 12:5">Inda dhaangia mojoli-jolina ingkami!"<verse eid="PSA 12:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 12:6"/>Firimanina KAWASANA OPU, "Roonamo mia maidhiidhi atopisaki</para>
  <para style="q2" vid="PSA 12:6">tee mia misikini apeenci roonamo anarakaa,</para>
  <para style="q1" vid="PSA 12:6">sabutuna sii-sii kuumba kudhawua kaʼamani</para>
  <para style="q2" vid="PSA 12:6">mboomo ipeeluna manga incia.<verse eid="PSA 12:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 12:7"/>KAWASANA OPU abhoasaka pogau momangkilo wakutuuna Incia apojanji.</para>
  <para style="q2" vid="PSA 12:7">Janjina amatangka mpuu,</para>
  <para style="q2" vid="PSA 12:7">mboomo pera asilii motorabuna pitu mpearo i nuncana waa.<verse eid="PSA 12:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 12:8"/>E KAWASANA OPU, Ingkoo bheujagani ingkami minaaka i manga mia madhaki sii.</para>
  <para style="q2" vid="PSA 12:8">Ingkoo ujagani ingkami sadia to saʼumurua.<verse eid="PSA 12:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 12:9"/>Mia madhaki pekawulu-wulu iapai-iapai tee abarani</para>
  <para style="q2" vid="PSA 12:9">roonamo kadhakina aabhia atopuji i tanga-tangana anana maanusia.<verse eid="PSA 12:9"/></para>
  <chapter eid="PSA 12"/>
  <chapter number="13" style="c" sid="PSA 13"/>
  <para style="s1">Doʼana Mia Moparacaeana tee Kaasina Aulataʼala</para>
  <para style="sr">
    <ref loc="PSA 13:1-6">13:1-6</ref></para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 13:1"/>To kapalana molaguna. Zaburuna Daud.<verse eid="PSA 13:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 13:2"/>Sakawana naepia, e KAWASANA OPU? Saʼumurua buaka Ingkoo umalinguakaaku?</para>
  <para style="q2" vid="PSA 13:2">Sakawana naepia Ingkoo ubuniaka roumu minaaka i karoku?<verse eid="PSA 13:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 13:3"/>Sakawana naepia kutanggo kanarakaa i nuncana karoku?</para>
  <para style="q2" vid="PSA 13:3">Saeoa amaporo incaku.</para>
  <para style="q2" vid="PSA 13:3">Sakawana naepia akuasaiaku musuku?<verse eid="PSA 13:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 13:4"/>E KAWASANA OPU, Aulataʼalaku, kamatea tee ulawaniakumo.</para>
  <para style="q2" vid="PSA 13:4">Pekatangkea o bukuku mamudhaakana inda kumate!<verse eid="PSA 13:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 13:5"/>Bholi utaroakea o musuku apogau, "Kutalomea!"</para>
  <para style="q2" vid="PSA 13:5">Tee o bhaliku akaunde-unde wakutuuna kusindoli.<verse eid="PSA 13:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 13:6"/>Maka kuparacaea o kaasimu molagina,</para>
  <para style="q2" vid="PSA 13:6">Incaku akaunde-unde roonamo upasalaamatiaku.</para>
  <para style="q1" vid="PSA 13:6">Iaku gauku kulagu to KAWASANA OPU</para>
  <para style="q2" vid="PSA 13:6">roonamo Incia padhamo apewau kalape tee iaku!<verse eid="PSA 13:6"/></para>
  <chapter eid="PSA 13"/>
  <chapter number="14" style="c" sid="PSA 14"/>
  <para style="s1">Kadhakina Maanusia Inda Moparacaeana Kawasana Opu</para>
  <para style="sr">
    <ref loc="PSA 14:1-7">14:1-7</ref></para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 14:1"/>
    <note caller="-" style="x">
      <char style="xo" closed="false">14:1-3 </char>
      <char style="xt" closed="false">
        <ref loc="ROM 3:10-12">Rom. 3:10-12</ref>.</char>
    </note>
    <note caller="-" style="x">
      <char style="xo" closed="false">14:1-7 </char>
      <char style="xt" closed="false">
        <ref loc="PSA 53">Zab. 53</ref>.</char>
    </note>To kapalana molaguna. Zaburuna Daud.</para>
  <para style="b" vid="PSA 14:1"/>
  <para style="q1" vid="PSA 14:1">Mia mokabhongo-bhongo apogau i nuncana ngangarandana,</para>
  <para style="q2" vid="PSA 14:1">"Inda dhaangia o Aulataʼala."</para>
  <para style="q1" vid="PSA 14:1">Pewauna manga incia amadhaki tee atomarika,</para>
  <para style="q2" vid="PSA 14:1">inda dhaangia mopewauna kalape.<verse eid="PSA 14:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 14:2"/>Minaaka i sorogaa KAWASANA OPU atonto</para>
  <para style="q2" vid="PSA 14:2">anana maanusia,</para>
  <para style="q1" vid="PSA 14:2">to akamata ara dhaangia o mia moʼaarifu,</para>
  <para style="q2" vid="PSA 14:2">mopeelona Aulataʼala.<verse eid="PSA 14:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 14:3"/>Bhari-bharia mia abholi dhala mobanara tee akarajaa giu momadhaki.</para>
  <para style="q2" vid="PSA 14:3">Inda dhaangia mopewauna kalape, moomini samia uka.<verse eid="PSA 14:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 14:4"/>Firimanina Aulataʼala, "Buaka apesua i akala, ande bhari-bharia mia mopewauna kadhaki inda amatau giu momalape?</para>
  <para style="q2" vid="PSA 14:4">Manga incia apekaoge karona tee akande uumatiku mboomo akande roti,</para>
  <para style="q2" vid="PSA 14:4">tee inda adoʼa i Iaku."<verse eid="PSA 14:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 14:5"/>Iwe sumai manga incia bheamaeka mpuu</para>
  <para style="q2" vid="PSA 14:5">roonamo Aulataʼala atulungi uumatina mobanara.<verse eid="PSA 14:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 14:6"/>Ingkomiu bheupekaea haejatina mia motopisaki,</para>
  <para style="q2" vid="PSA 14:6">maka o KAWASANA OPU amembali peulusana manga incia.<verse eid="PSA 14:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 14:7"/>Maasangia kasalaamati to miana Israel aumba minaaka i Sion, kotana Aulataʼala!</para>
  <para style="q2" vid="PSA 14:7">Wakutuuna KAWASANA OPU apambuli kadhaangiana uumatina,</para>
  <para style="q2" vid="PSA 14:7">siwuluna Yakub bheamasanaa o namisina tee o Israel bheakaunde-unde.<verse eid="PSA 14:7"/></para>
  <chapter eid="PSA 14"/>
  <chapter number="15" style="c" sid="PSA 15"/>
  <para style="s1">Mia Molaengana to Aumba i KAWASANA OPU</para>
  <para style="sr">
    <ref loc="PSA 15:1-5">15:1-5</ref></para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 15:1"/>Zaburuna Daud.</para>
  <para style="b" vid="PSA 15:1"/>
  <para style="q1" vid="PSA 15:1">E KAWASANA OPU, incema momembalina mobutuna i Kemamu Momangkilo?</para>
  <para style="q2" vid="PSA 15:1">Incema momembalina momboorena i gunumu momangkilo?<verse eid="PSA 15:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 15:2"/>Siitumo mia modhadhina inda tee kasalahana,</para>
  <para style="q2" vid="PSA 15:2">mopewauna kalape,</para>
  <para style="q1" vid="PSA 15:2">tee mopogauakana mototuuna</para>
  <para style="q2" vid="PSA 15:2">tee incia apogau tee mpuu-mpuuna incana.<verse eid="PSA 15:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 15:3"/>Manga incia inda afitanaa tee dhelana,</para>
  <para style="q2" vid="PSA 15:3">inda apewau kadhaki i sabhangkana,</para>
  <para style="q2" vid="PSA 15:3">tee inda apekadhaki sarona sarimbanuana.<verse eid="PSA 15:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 15:4"/>Manga incia inda mohoromatina manga mia inda itarimana Aulataʼala,</para>
  <para style="q2" vid="PSA 15:4">maka ahoromati mia momaekana KAWASANA OPU,</para>
  <para style="q1" vid="PSA 15:4">motaʼatina janjina,</para>
  <para style="q2" vid="PSA 15:4">moomini amarugi.<verse eid="PSA 15:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 15:5"/>Manga incia apekapaadhaaka doina tee inda aala laba,</para>
  <para style="q2" vid="PSA 15:5">tee inda atarima kasogo to aewangi mia inda mosala.</para>
  <para style="b" vid="PSA 15:5"/>
  <para style="q1" vid="PSA 15:5">Mia mopewauna mboo sumai</para>
  <para style="q2" vid="PSA 15:5">bheamasanaa tee aʼamani saʼumurua.<verse eid="PSA 15:5"/></para>
  <chapter eid="PSA 15"/>
  <chapter number="16" style="c" sid="PSA 16"/>
  <para style="s1">Kasanaana Mia Mosaalihi</para>
  <para style="sr">
    <ref loc="PSA 16:1-11">16:1-11</ref></para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 16:1"/>Miktam.<note caller="+" style="f"><char style="fr" closed="false">16:1 </char><char style="fq" closed="false">Miktam: </char><char style="ft" closed="false">Sarona sala saangu zaburu mokomaʼanana kabhanti bulawa. Miktam minaaka i oni </char><char style="it">kethem</char> i nuncana pogau Ibrani akomaʼana "bulawa." </note> Zaburuna Daud.</para>
  <para style="b" vid="PSA 16:1"/>
  <para style="q1" vid="PSA 16:1">E Aulataʼala, jaganiaku</para>
  <para style="q2" vid="PSA 16:1">roonamo Ingkoomo peulusaku.<verse eid="PSA 16:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 16:2"/>Iaku kupogau i KAWASANA OPU, "Ingkoomo Kawasana Opuku,</para>
  <para style="q2" vid="PSA 16:2">inda dhaangia momalapena to iaku, tangkanamo Ingkoo."<verse eid="PSA 16:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 16:3"/>Mia momangkilo modhaangiana i alamu,</para>
  <para style="q2" vid="PSA 16:3">manga inciamo o mia momulia mosadiana ipeeluku.<verse eid="PSA 16:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 16:4"/>Kanarakaana manga mia mosombana dewa mosagaanana bheahanda kabharina.</para>
  <para style="q2" vid="PSA 16:4">Iaku inda bhekulali pasombaana raana kurubanina manga incia,</para>
  <para style="q2" vid="PSA 16:4">atawa uka kusarongi sarona manga dewa mosagaanana i bhiwiku.<verse eid="PSA 16:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 16:5"/>E KAWASANA OPU, tangkanamo Ingkoo o pusakaku,</para>
  <para style="q2" vid="PSA 16:5">Ingkoomo motantuakana dhalana dhadhiku,</para>
  <para style="q2" vid="PSA 16:5">Ingkoomo mokenina katooku.<verse eid="PSA 16:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 16:6"/>Ingkoomo modhawuaku manga giu momakesa</para>
  <para style="q2" vid="PSA 16:6">satotuuna kadhawumu sumai mopaunde-undeaku.<verse eid="PSA 16:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 16:7"/>Iaku kupuji KAWASANA OPU, mopadhana moudhaniakaaku;</para>
  <para style="q2" vid="PSA 16:7">i wakutuuna malo baatiniku aadhariaku.<verse eid="PSA 16:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 16:8"/>
    <note caller="-" style="x">
      <char style="xo" closed="false">16:8-11 </char>
      <char style="xt" closed="false">
        <ref loc="ACT 2:25-28">Tul. 2:25-28</ref>.</char>
    </note>Iaku sadia kuudhani KAWASANA OPU;</para>
  <para style="q2" vid="PSA 16:8">Incia dhaangia i saripiku, rampaakanamo sumai kumatangka.<verse eid="PSA 16:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 16:9"/>Sababuna sumai, incaku amasanaa tee ngangarandaku akaunde-unde,</para>
  <para style="q2" vid="PSA 16:9">badaku aponiunto tee kuʼamani.<verse eid="PSA 16:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 16:10"/>
    <note caller="-" style="x">
      <char style="xo" closed="false">16:10 </char>
      <char style="xt" closed="false">
        <ref loc="ACT 13:35">Tul. 13:35</ref>.</char>
    </note>Sababuna Ingkoo inda utaroakaaku kumate,</para>
  <para style="q2" vid="PSA 16:10">mia mosaalihi inda utaroakea abinasa.<verse eid="PSA 16:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 16:11"/>Upaumbaakaaku dhala moporopena i dhadhi imalapeaka,</para>
  <para style="q2" vid="PSA 16:11">i aroamu abhari mpuu kasanaa,</para>
  <para style="q2" vid="PSA 16:11">i lima kaanamu dhaangia kasanaa to saʼumurua.<verse eid="PSA 16:11"/></para>
  <chapter eid="PSA 16"/>
  <chapter number="17" style="c" sid="PSA 17"/>
  <para style="s1">Atopajere Moomini Inda Asala</para>
  <para style="sr">
    <ref loc="PSA 17:1-15">17:1-15</ref></para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 17:1"/>Doʼana Daud.</para>
  <para style="b" vid="PSA 17:1"/>
  <para style="q1" vid="PSA 17:1">E KAWASANA OPU, maasangia uperangoi parakara mobanara.</para>
  <para style="q2" vid="PSA 17:1">Tilikia o goraku!</para>
  <para style="q1" vid="PSA 17:1">Perangoia o doʼaku,</para>
  <para style="q2" vid="PSA 17:1">molimbana minaaka i bhiwiku mojujuruna sii.<verse eid="PSA 17:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 17:2"/>Taroakamo kambotuna parakaraku aumba minaaka i Ingkoo,</para>
  <para style="q2" vid="PSA 17:2">roonamo matamu akamata kabanara.<verse eid="PSA 17:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 17:3"/>Ande Ingkoo uuji ngangarandaku,</para>
  <para style="q2" vid="PSA 17:3">tee uumba utilikiaku i wakutuuna amalo,</para>
  <para style="q1" vid="PSA 17:3">ande uujiaku mboomo mia moujina bulawa,</para>
  <para style="q2" vid="PSA 17:3">sumaimo Ingkoo inda bheupotibhaaka kadhaki i nuncana karoku.</para>
  <para style="q1" vid="PSA 17:3">Iaku padhamo kuneati</para>
  <para style="q2" vid="PSA 17:3">mamudhaakana inda kubhoasaka manga pogau mosala, mboomo ipewauna manga mia mosagaanana.<verse eid="PSA 17:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 17:4"/>Alaloi firimani ipakawaakamu,</para>
  <para style="q2" vid="PSA 17:4">iaku padhamo kujagani karoku minaaka i dhalana manga mia mopewauna kasega.<verse eid="PSA 17:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 17:5"/>Bhengkalaku sadhaadhaa aose dhalamu,</para>
  <para style="q2" vid="PSA 17:5">tee o aeku inda asindoli.<verse eid="PSA 17:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 17:6"/>Iaku kugora i Ingkoo</para>
  <para style="q2" vid="PSA 17:6">roonamo Ingkoo bheulawaniaku, e Aulataʼala.</para>
  <para style="q1" vid="PSA 17:6">Perangoiaku,</para>
  <para style="q2" vid="PSA 17:6">rangoa manga pogauku.<verse eid="PSA 17:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 17:7"/>Susuakaaku o kaasimu molagina inda momentela sumai!</para>
  <para style="q2" vid="PSA 17:7">Lima kaanamu<note caller="+" style="f"><char style="fr" closed="false">17:7 </char><char style="fq" closed="false">lima kaanamu: </char><char style="ft" closed="false">Ibaratina kuasana Aulataʼala mopapeuluna tee mopasalaamatina maanusia.</char></note> mopasalaamatina manga mia mopeuluna i Ingkoo minaaka i musuna.<verse eid="PSA 17:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 17:8"/>Jaganiaku mboomo opea imaasiakamu,</para>
  <para style="q2" vid="PSA 17:8">jaganiaku mboomo inana manu-manu mojaganina anana i nuncana panina<verse eid="PSA 17:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 17:9"/>minaaka i mia madhaki bhemopabinasaaku,</para>
  <para style="q2" vid="PSA 17:9">siitumo manga musu molibuaku to mopekamateaku.<verse eid="PSA 17:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 17:10"/>Manga incia inda tee kaasina incana,</para>
  <para style="q2" vid="PSA 17:10">tee abhoasaka pogau mosombo.<verse eid="PSA 17:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 17:11"/>Sii-sii manga incia aose bhengkalaku to alibuaku,</para>
  <para style="q2" vid="PSA 17:11">apeelo dhala to arambitakaaku i tana.<verse eid="PSA 17:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 17:12"/>Manga incia mboomo singa mopapakina kinandena,</para>
  <para style="q2" vid="PSA 17:12">mboomo singa mangura mopekantaana i tampa momalino.<verse eid="PSA 17:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 17:13"/>E KAWASANA OPU, bhangumo.</para>
  <para style="q2" vid="PSA 17:13">Poaroakamea tee upekatalomea manga incia!</para>
  <para style="q1" vid="PSA 17:13">Pasalaamatiaku tee ewangamu minaaka i manga mia madhaki,<verse eid="PSA 17:13"/></para>
  <para style="q2">
    <verse number="14" style="v" sid="PSA 17:14"/>e Kawasana Opu, pasalaamatiaku tee limamu minaaka i manga mia madhaki,</para>
  <para style="q2" vid="PSA 17:14">minaaka i manga mia soo mofaduliakana harataana dunia.</para>
  <para style="q1" vid="PSA 17:14">Maka pekambosua manga mia imaasiakamu.</para>
  <para style="q2" vid="PSA 17:14">Maasangia manga anana atumpu incana</para>
  <para style="q2" vid="PSA 17:14">tee abholi tinaurakana to manga siwuluna.<verse eid="PSA 17:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 17:15"/>Roonamo kubanara, iaku bhekutonto roumu,</para>
  <para style="q2" vid="PSA 17:15">tee wakutuuna kubhangu, bheatumpu incaku roonamo kudhaangiapo i saripimu.<verse eid="PSA 17:15"/></para>
  <chapter eid="PSA 17"/>
  <chapter number="18" style="c" sid="PSA 18"/>
  <para style="s1">Lagu Kasukuruna Daud</para>
  <para style="sr">
    <ref loc="PSA 18:1-51">18:1-51</ref></para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 18:1"/>
    <note caller="-" style="x">
      <char style="xo" closed="false">18:1-51 </char>
      <char style="xt" closed="false">
        <ref loc="2SA 22">2Sa. 22</ref>.</char>
    </note>To kapalana molaguna. Minaaka i bhatuana KAWASANA OPU, siitumo o Daud, mopakawaakana lagu incia sii to KAWASANA OPU, wakutuuna KAWASANA OPU arambasaka Daud minaaka i limana Saul tee minaaka i manga musuna. Incia apogau,<verse eid="PSA 18:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 18:2"/>"Iaku kumaasiakako, e KAWASANA OPU, kakaaku!<verse eid="PSA 18:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 18:3"/>KAWASANA OPU mboomo kabumbuna bhatuku, bente potaangiaku, tee mopabebasiaku.</para>
  <para style="q2" vid="PSA 18:3">Aulataʼala isombaku mboomo gunu bhatu, tee kupeulu i Incia.</para>
  <para style="q2" vid="PSA 18:3">Incia o katangkesiku, mopasalaamatiaku minaaka i musuku, tee o tampana peulusaku mamudhaakana sadia kuʼamani.<verse eid="PSA 18:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 18:4"/>Iaku kugora i KAWASANA OPU molaengana ipuji,</para>
  <para style="q2" vid="PSA 18:4">tee Incia apasalaamatiaku minaaka i manga musuku.<verse eid="PSA 18:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 18:5"/>Manga jari imateaka arimpuaku,</para>
  <para style="q2" vid="PSA 18:5">tee akangkanaiaku uwena mawa maoge mopabinasaaku,<verse eid="PSA 18:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 18:6"/>Rabutana duniana mia mate arimpuaku,</para>
  <para style="q2" vid="PSA 18:6">tee manga katapu imateaka atotaa i aroaku.<verse eid="PSA 18:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 18:7"/>I nuncana kasukara iaku kugora i KAWASANA OPU,</para>
  <para style="q2" vid="PSA 18:7">tee kupekee kuemani tulungi i Aulataʼalaku.</para>
  <para style="q1" vid="PSA 18:7">Incia arango suaraku minaaka i Baitullana,</para>
  <para style="q2" vid="PSA 18:7">tee o pekeeku i Incia akawa i talingana.<verse eid="PSA 18:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 18:8"/>Sumaimo o alamu akohudha tee akolendu,</para>
  <para style="q2" vid="PSA 18:8">manga gunu uka atorende tee akohudha roonamo pamuruna Aulataʼala.<verse eid="PSA 18:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 18:9"/>Ombu alimba minaaka i angona,</para>
  <para style="q2" vid="PSA 18:9">waa alimba minaaka i ngangana,</para>
  <para style="q2" vid="PSA 18:9">weona waa akarore-rore.<verse eid="PSA 18:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 18:10"/>Laiana awetaia, kasiimpo Incia asapo</para>
  <para style="q2" vid="PSA 18:10">tee taʼina ngalu malalanda i tambena aena.<verse eid="PSA 18:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 18:11"/>Incia asawi i malaaʼekati kerub<note caller="+" style="f"><char style="fr" closed="false">18:11</char><char style="fq" closed="false">malaaʼekati kerub: </char><char style="ft" closed="false">Malaaʼekati igambaraaka mboomo mahaluku mokopani, agambaraaka kalangana Aulataʼala tee umbaana. Apogauakea ande kauncuramakana KAWASANA OPU dhaangia i bhawona manga malaaʼekati kerub. Dhaangia patuna rua malaaʼekati kerub i bhawona sorongana pojanjia tee i piamo itu Musa atarima firimanina Aulataʼala minaaka iwe sumai. Kamata </char><char style="xt" closed="false"><ref loc="EXO 25:18-19">Limb. 25:18-19</ref>.</char></note> kasiimpo apolaka,</para>
  <para style="q2" vid="PSA 18:11">atinti tee asawi i bhawona ngalu.<verse eid="PSA 18:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 18:12"/>Incia abuniaka karona tee kalalanda,</para>
  <para style="q2" vid="PSA 18:12">tampana mbooresana satotuuna o wao momalalanda tee taʼina ngalu momakapa i laiana.<verse eid="PSA 18:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 18:13"/>Minaaka i cahea i aroana,</para>
  <para style="q2" vid="PSA 18:13">waona esi tee weona waa alimbamo minaaka i manga taʼina ngaluna.<verse eid="PSA 18:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 18:14"/>KAWASANA OPU apakoguntu i laiana,</para>
  <para style="q2" vid="PSA 18:14">tee Aulataʼala Momalanga apaperangoiaka suarana i tanga-tangana waona esi tee weona waa.<verse eid="PSA 18:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 18:15"/>Incia arambasaka manga panana tee apapogaa-gaa musuna,</para>
  <para style="q2" vid="PSA 18:15">bhibhito apokilati sabutuna manga incia apalai amantale.<verse eid="PSA 18:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 18:16"/>Tambena tawo atokamata roonamo tawo amatuu,</para>
  <para style="q2" vid="PSA 18:16">tee atokamatamo fondasina alamu</para>
  <para style="q1" vid="PSA 18:16">roonamo kagorampangimu, e KAWASANA OPU,</para>
  <para style="q2" vid="PSA 18:16">tee roonamo poinuncana angomu.<verse eid="PSA 18:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 18:17"/>KAWASANA OPU apaulu limana minaaka i kalangaana tee apasalaamatiaku,</para>
  <para style="q2" vid="PSA 18:17">Incia ahelaaku minaaka i uwena mawa imateaka.<verse eid="PSA 18:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 18:18"/>Incia apasalaamatiaku minaaka i musuku momakaana</para>
  <para style="q2" vid="PSA 18:18">tee minaaka i manga mia mobanciaku,</para>
  <para style="q2" vid="PSA 18:18">roonamo musuku amarasai mpuu kutaloa.<verse eid="PSA 18:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 18:19"/>Manga incia ahumbuniaku i wakutuuna kusukara,</para>
  <para style="q2" vid="PSA 18:19">maka KAWASANA OPU motulungiaku,<verse eid="PSA 18:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 18:20"/>Incia apalimbaaku minaaka i kaseke tee abhawaaku i tampa momalalesa,</para>
  <para style="q2" vid="PSA 18:20">tee apasalaamatiaku roonamo amaasiakaaku.<verse eid="PSA 18:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 18:21"/>KAWASANA OPU amalape tee iaku apokana tee kabanaraku,</para>
  <para style="q2" vid="PSA 18:21">Incia abalasi pewauku, apokana tee kangkilona limaku<verse eid="PSA 18:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 18:22"/>roonamo iaku sadhaadhaa kutaʼati parintana KAWASANA OPU</para>
  <para style="q2" vid="PSA 18:22">tee inda kupewau madhaki i Aulataʼalaku.<verse eid="PSA 18:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 18:23"/>Bhari-bharia hukumuna dhaangia i aroaku,</para>
  <para style="q2" vid="PSA 18:23">tee iaku inda kupekaridho minaaka i manga katotapuna.<verse eid="PSA 18:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 18:24"/>Iaku inda kupewau madhaki i incia,</para>
  <para style="q2" vid="PSA 18:24">tee kujagani karoku minaaka i kasalaha.<verse eid="PSA 18:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 18:25"/>Sumaimo KAWASANA OPU abalasi pewauku mobanarana</para>
  <para style="q2" vid="PSA 18:25">roonamo kumangkilo i aroana.<verse eid="PSA 18:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 18:26"/>I mia motaʼati, Ingkoo ususuakea kaasimu molagina</para>
  <para style="q2" vid="PSA 18:26">tee i mia momalape, Ingkoo umalape.<verse eid="PSA 18:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 18:27"/>I mia momangkilo, Ingkoo umangkilo,</para>
  <para style="q2" vid="PSA 18:27">maka Ingkoo uewangi mia momadhakina incana.<verse eid="PSA 18:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 18:28"/>Ingkoo mopasalaamatina uumati motopisaki,</para>
  <para style="q2" vid="PSA 18:28">maka o mia mosombo upekaeaia.<verse eid="PSA 18:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="PSA 18:29"/>Ingkoo mopakatana suluku,</para>
  <para style="q2" vid="PSA 18:29">KAWASANA OPU, Aulataʼalaku, mosuluwina kalalandaku.<verse eid="PSA 18:29"/></para>
  <para style="q1">
    <verse number="30" style="v" sid="PSA 18:30"/>Satotuuna roonamo Ingkoo, iaku kumembali kuewangi gorombola musuku</para>
  <para style="q2" vid="PSA 18:30">tee kumembali kukompasi rindina bentena.<verse eid="PSA 18:30"/></para>
  <para style="q1">
    <verse number="31" style="v" sid="PSA 18:31"/>Pewauna Aulataʼala sadia amalape,</para>
  <para style="q2" vid="PSA 18:31">tee firimanina KAWASANA OPU atouji.</para>
  <para style="q1" vid="PSA 18:31">Incia o katangkesi to bhari-bharia mia</para>
  <para style="q2" vid="PSA 18:31">tee amasanaamo mia mopeuluna i Incia.<verse eid="PSA 18:31"/></para>
  <para style="q1">
    <verse number="32" style="v" sid="PSA 18:32"/>Sababuna tangkanamo KAWASANA OPU o Aulataʼalata,</para>
  <para style="q2" vid="PSA 18:32">soomo Aulataʼala peulusata.<verse eid="PSA 18:32"/></para>
  <para style="q1">
    <verse number="33" style="v" sid="PSA 18:33"/>Aulataʼala mopekatangkaaku,</para>
  <para style="q2" vid="PSA 18:33">tee aparatea o dhalaku mamudhaakana kuʼamani.<verse eid="PSA 18:33"/></para>
  <para style="q1">
    <verse number="34" style="v" sid="PSA 18:34"/>Incia apekatangka aeku mboomo aena rusa mamudhaakana kumadhei kubuntuli,</para>
  <para style="q2" vid="PSA 18:34">tee ajagani kasalaamatiku i gunu.<verse eid="PSA 18:34"/></para>
  <para style="q1">
    <verse number="35" style="v" sid="PSA 18:35"/>Incia aadhariakaaku carana potimbe,</para>
  <para style="q2" vid="PSA 18:35">sabutuna amembali kupaubhe pana tambagaku.<verse eid="PSA 18:35"/></para>
  <para style="q1">
    <verse number="36" style="v" sid="PSA 18:36"/>Ingkoo katangkesiku tee mopasalaamatiaku,</para>
  <para style="q2" vid="PSA 18:36">tee kuasamu iaku kuʼamani,</para>
  <para style="q2" vid="PSA 18:36">tee kalapemu kumembali kumakaa mpuu.<verse eid="PSA 18:36"/></para>
  <para style="q1">
    <verse number="37" style="v" sid="PSA 18:37"/>Ingkoo upekaewa dhala to bhengkalaku,</para>
  <para style="q2" vid="PSA 18:37">tee aeku inda asindoli.<verse eid="PSA 18:37"/></para>
  <para style="q1">
    <verse number="38" style="v" sid="PSA 18:38"/>Iaku kupajere manga musuku, tee kurako manga incia,</para>
  <para style="q2" vid="PSA 18:38">Iaku inda bhekumbuli ande manga incia inda atopepadhai.<verse eid="PSA 18:38"/></para>
  <para style="q1">
    <verse number="39" style="v" sid="PSA 18:39"/>Kupahancurua manga sakawana inda amembali abhangu pendua,</para>
  <para style="q2" vid="PSA 18:39">tee kupatobhatea i aroaku.<verse eid="PSA 18:39"/></para>
  <para style="q1">
    <verse number="40" style="v" sid="PSA 18:40"/>Ingkoo udhawuaku kakaa to kupotimbe,</para>
  <para style="q2" vid="PSA 18:40">roonamo Ingkoo iaku amembali kutalo manga musuku.<verse eid="PSA 18:40"/></para>
  <para style="q1">
    <verse number="41" style="v" sid="PSA 18:41"/>Ingkoo upewau manga musuku apalai minaaka i iaku,</para>
  <para style="q2" vid="PSA 18:41">manga mia mobanciaku kupabinasea.<verse eid="PSA 18:41"/></para>
  <para style="q1">
    <verse number="42" style="v" sid="PSA 18:42"/>Manga incia apekee aemani tulungi maka inda dhaangia mopasalaamatia.</para>
  <para style="q2" vid="PSA 18:42">Manga incia apekee i KAWASANA OPU,</para>
  <para style="q2" vid="PSA 18:42">maka Incia inda alawani.<verse eid="PSA 18:42"/></para>
  <para style="q1">
    <verse number="43" style="v" sid="PSA 18:43"/>Kupahancurua manga mboomo ngawu ipolakaakana ngalu,</para>
  <para style="q2" vid="PSA 18:43">tee kulandakia manga mboomo tomba i dhala.<verse eid="PSA 18:43"/></para>
  <para style="q1">
    <verse number="44" style="v" sid="PSA 18:44"/>Ingkoo upabebasiaku minaaka i raʼeati modorohaka,</para>
  <para style="q2" vid="PSA 18:44">Upamembaliaku mokuasaina manga lipu.</para>
  <para style="q2" vid="PSA 18:44">Tee lipu inda imatauku amembali bhatuaku.<verse eid="PSA 18:44"/></para>
  <para style="q1">
    <verse number="45" style="v" sid="PSA 18:45"/>Manga incia arango tee ataʼati parintaku.</para>
  <para style="q2" vid="PSA 18:45">Manga mia dhaga uka asomba tee arengku i aroaku.<verse eid="PSA 18:45"/></para>
  <para style="q1">
    <verse number="46" style="v" sid="PSA 18:46"/>Manga mia dhaga ailamo kabaranina,</para>
  <para style="q2" vid="PSA 18:46">tee arengku alimba minaaka i bente potaangiana.<verse eid="PSA 18:46"/></para>
  <para style="q1">
    <verse number="47" style="v" sid="PSA 18:47"/>Iaku kumataua ande o KAWASANA OPU adhadhi! Bhari-bharia kapujia to peulusaku!</para>
  <para style="q2" vid="PSA 18:47">Muliangia o Aulataʼala, mopasalaamatiaku!<verse eid="PSA 18:47"/></para>
  <para style="q1">
    <verse number="48" style="v" sid="PSA 18:48"/>Aulataʼala motulungiaku kutalo manga musuku,</para>
  <para style="q2" vid="PSA 18:48">tee manga lipu kukuasaia.<verse eid="PSA 18:48"/></para>
  <para style="q2">
    <verse number="49" style="v" sid="PSA 18:49"/>Incia mopasalaamatiaku minaaka i manga musuku.</para>
  <para style="q1" vid="PSA 18:49">Satotuuna, Ingkoomo mopekalangaaku minaaka i musu moewangiaku</para>
  <para style="q2" vid="PSA 18:49">tee upasalaamatiaku minaaka i mia momasega.<verse eid="PSA 18:49"/></para>
  <para style="q1">
    <verse number="50" style="v" sid="PSA 18:50"/>
    <note caller="-" style="x">
      <char style="xo" closed="false">18:50 </char>
      <char style="xt" closed="false">
        <ref loc="ROM 15:9">Rom. 15:9</ref>.</char>
    </note>Sababuna sumai, iaku bhekusukuru i Ingkoo, e KAWASANA OPU, i tanga-tangana manga lipu,</para>
  <para style="q2" vid="PSA 18:50">tee iaku bhekulaguaka kapujia to saromu.<verse eid="PSA 18:50"/></para>
  <para style="q1">
    <verse number="51" style="v" sid="PSA 18:51"/>Aulataʼala adhawuaka kasalaamati momaoge to raja ipilina,</para>
  <para style="q2" vid="PSA 18:51">tee asusuaka kaasina molagina i mia ilantina,</para>
  <para style="q2" vid="PSA 18:51">siitumo o Daud tee siwuluna to saʼumurua.<verse eid="PSA 18:51"/></para>
  <chapter eid="PSA 18"/>
  <chapter number="19" style="c" sid="PSA 19"/>
  <para style="s1">Kamuliangina Aulataʼala i Nuncana Ipadhaangiana tee Hukumuna</para>
  <para style="sr">
    <ref loc="PSA 19:1-15">19:1-15</ref></para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 19:1"/>To kapalana molaguna. Zaburuna Daud.<verse eid="PSA 19:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 19:2"/>Laiana apetulatulaaka kamuliangina KAWASANA OPU,</para>
  <para style="q2" vid="PSA 19:2">tee laiana apogauaka ikarajaana.<verse eid="PSA 19:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 19:3"/>Saesaeo laiana abhoasaka pogauna,</para>
  <para style="q2" vid="PSA 19:3">tee samalo-samalo uka apakoleleaka ilimuu.<verse eid="PSA 19:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 19:4"/>Inda tee pogau atawa o bhoasaka,</para>
  <para style="q2" vid="PSA 19:4">suarana uka inda atorango.<verse eid="PSA 19:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 19:5"/>
    <note caller="-" style="x">
      <char style="xo" closed="false">19:5 </char>
      <char style="xt" closed="false">
        <ref loc="ROM 10:18">Rom. 10:18</ref>.</char>
    </note>Maka o lelena atorango i saangua alamu,</para>
  <para style="q2" vid="PSA 19:5">tee kasameana sumai akawa i tapana dunia.</para>
  <para style="b" vid="PSA 19:5"/>
  <para style="q2" vid="PSA 19:5">KAWASANA OPU apadhaangia laiana to mbooresana matanaeo.<verse eid="PSA 19:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 19:6"/>Kasiimpo matanaeo abhete i wakutuu saeona,</para>
  <para style="q2" vid="PSA 19:6">mboomo panganti umane molimbana minaaka i kolemana,</para>
  <para style="q2" vid="PSA 19:6">mboomo samia hiri akaunde-unde wakutuu apepuungi lingkaana.<verse eid="PSA 19:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 19:7"/>Matanaeo abhete minaaka i tapana laiana,</para>
  <para style="q2" vid="PSA 19:7">atii akawa i tapa mosagaanana,</para>
  <para style="q2" vid="PSA 19:7">inda dhaangia molapana minaaka i kasodhona.<verse eid="PSA 19:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 19:8"/>Hukumuna KAWASANA OPU amondo tee inda tee kakurangana,</para>
  <para style="q2" vid="PSA 19:8">apadhadhi inca.</para>
  <para style="q1" vid="PSA 19:8">Tuturana KAWASANA OPU atoparacaea,</para>
  <para style="q2" vid="PSA 19:8">adhawu hikimati i manga mia inda moʼaarifu.<verse eid="PSA 19:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 19:9"/>Tuturana KAWASANA OPU sumai abanara,</para>
  <para style="q2" vid="PSA 19:9">apasanaa ngangaranda.</para>
  <para style="q1" vid="PSA 19:9">Parintana KAWASANA OPU sumai atinda,</para>
  <para style="q2" vid="PSA 19:9">amembali kainawa to karota.<verse eid="PSA 19:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 19:10"/>Namisi kaeka i KAWASANA OPU sumai amangkilo,</para>
  <para style="q2" vid="PSA 19:10">to saʼumurua.</para>
  <para style="q1" vid="PSA 19:10">Tuturana KAWASANA OPU sumai atoparacaea</para>
  <para style="q2" vid="PSA 19:10">tee aʼadili bhari-bharia.<verse eid="PSA 19:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 19:11"/>Hukumuna KAWASANA OPU alabhi o kaalina minaaka i bulawa asilii,</para>
  <para style="q2" vid="PSA 19:11">moomini abhari bulawa asilii,</para>
  <para style="q1" vid="PSA 19:11">alabhi o kamekona minaaka i golana uwani,</para>
  <para style="q2" vid="PSA 19:11">moomini golana uwani asilii minaaka i bhanuana uwani.<verse eid="PSA 19:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 19:12"/>Bhari-bharia hukumumu sumai audhaniaka bhatuamu sii;</para>
  <para style="q2" vid="PSA 19:12">dhaangia o fahala maoge to mia motaʼatina parintamu.<verse eid="PSA 19:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 19:13"/>Incema buaka momembalina momatauna kasalahana karona?</para>
  <para style="q2" vid="PSA 19:13">Pekangkiloakumo minaaka i manga dosa motobuniaka.<verse eid="PSA 19:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 19:14"/>Jaganiaku mamudhaakana inda kupewau dosa iporadhamii,</para>
  <para style="q2" vid="PSA 19:14">tee bholi utaroakea manga dosa akuasaiaku.</para>
  <para style="q1" vid="PSA 19:14">Kasiimpo iaku indamo uka kupewau madhaki,</para>
  <para style="q2" vid="PSA 19:14">tee kumangkilo minaaka i kasalaha momaoge.<verse eid="PSA 19:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 19:15"/>Maasangia o pogauku tee bhokuna ngangarandaku utarimaia,</para>
  <para style="q2" vid="PSA 19:15">e KAWASANA OPU, peulusaku tee motolosiaku.<verse eid="PSA 19:15"/></para>
  <chapter eid="PSA 19"/>
  <chapter number="20" style="c" sid="PSA 20"/>
  <para style="s1">Doʼa Emaniana Takana</para>
  <para style="sr">
    <ref loc="PSA 20:1-10">20:1-10</ref></para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 20:1"/>To kapalana lagu. Zaburuna Daud.<verse eid="PSA 20:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 20:2"/>Maasangia KAWASANA OPU alawaniko</para>
  <para style="q2" vid="PSA 20:2">i wakutuuna kasukara,</para>
  <para style="q2" vid="PSA 20:2">maasangia Aulataʼala, isombana Yakub ajaganiko!<verse eid="PSA 20:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 20:3"/>Maasangia Incia atulungiko minaaka i tampa momangkilo,</para>
  <para style="q2" vid="PSA 20:3">tee atukoko minaaka i Gunu Sion.<verse eid="PSA 20:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 20:4"/>Maasangia Incia audhani bhari-bharia pasombaamu,</para>
  <para style="q2" vid="PSA 20:4">tee atarima kurubani tunuamu. <char style="qs">Sela</char><verse eid="PSA 20:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 20:5"/>Maasangia Incia adhawuko opea ipeelumu,</para>
  <para style="q2" vid="PSA 20:5">tee apewau bhari-bharia haejatimu akohasili.<verse eid="PSA 20:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 20:6"/>Ingkami bhetasambo-sambo roonamo Ingkoo ukanamo,</para>
  <para style="q2" vid="PSA 20:6">tee tapabhale tombi to tapuji Aulataʼalamami.</para>
  <para style="q2" vid="PSA 20:6">Maasangia KAWASANA OPU adhawuko bhari-bharia iemanimu!<verse eid="PSA 20:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 20:7"/>Sii-sii iaku kumataua ande o KAWASANA OPU mopasalaamatina</para>
  <para style="q2" vid="PSA 20:7">raja ilantina.</para>
  <para style="q1" vid="PSA 20:7">Minaaka i sorogaa momangkilo Incia bhealawani</para>
  <para style="q2" vid="PSA 20:7">tee kuasana lima kaanana mopasalaamatina.<verse eid="PSA 20:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 20:8"/>Dhaangia o mia motangkaakana manga kareta potimbeana,</para>
  <para style="q2" vid="PSA 20:8">dhaangia uka motangkaakana manga ajarana,</para>
  <para style="q2" vid="PSA 20:8">maka ingkita tatangkaaka sarona KAWASANA OPU, Aulataʼalata.<verse eid="PSA 20:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 20:9"/>Manga incia atosunu tee amandawu,</para>
  <para style="q2" vid="PSA 20:9">maka ingkita tabhangu takabhale-bhale tee tamatangka.<verse eid="PSA 20:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 20:10"/>E KAWASANA OPU, pasalaamatia o raja,</para>
  <para style="q2" vid="PSA 20:10">manga lawani i wakutuuna ingkami tagora.<verse eid="PSA 20:10"/></para>
  <chapter eid="PSA 20"/>
  <chapter number="21" style="c" sid="PSA 21"/>
  <para style="s1">Kapujiana to Kamangantalona Raja</para>
  <para style="sr">
    <ref loc="PSA 21:1-14">21:1-14</ref></para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 21:1"/>To kapalana molaguna. Zaburuna Daud.<verse eid="PSA 21:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 21:2"/>E KAWASANA OPU, raja akaunde-unde roonamo kuasamu</para>
  <para style="q2" vid="PSA 21:2">tee amaoge mpuu o undena roonamo kasalaamati minaaka i Ingkoo!<verse eid="PSA 21:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 21:3"/>Ingkoo udhawua opea ipeeluna,</para>
  <para style="q1" vid="PSA 21:3">tee Ingkoo uundapia iemanina. <char style="qs">Sela</char><verse eid="PSA 21:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 21:4"/>Satotuuna, Ingkoo upepago incia tee barakati motaralabhi-labhi,</para>
  <para style="q2" vid="PSA 21:4">Ingkoo upasaakea mahakota minaaka i bulawa asilii i bhaana.<verse eid="PSA 21:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 21:5"/>Incia aemani dhadhi i karomu, tee Ingkoo udhawuakea</para>
  <para style="q2" vid="PSA 21:5">umuru marambe to saʼumurua.<verse eid="PSA 21:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 21:6"/>Amaoge o kamuliangina roonamo kasalaamati minaaka i karomu,</para>
  <para style="q2" vid="PSA 21:6">kaogesa tee kuasa udhawuakea to incia.<verse eid="PSA 21:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 21:7"/>Ingkoo udhawuakea barakati to incia saʼumurua,</para>
  <para style="q2" vid="PSA 21:7">tee upaunde-undea namisina i aroamu.<verse eid="PSA 21:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 21:8"/>Raja aparacaea i KAWASANA OPU,</para>
  <para style="q2" vid="PSA 21:8">tee roonamo kaasina molagina Aulataʼala Momalanga, incia inda bheasindoli.<verse eid="PSA 21:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 21:9"/>Tee kuasamu bheurako bhari-bharia musumu,</para>
  <para style="q2" vid="PSA 21:9">tee kuasamu karomu bheurako manga mia mobanciko.<verse eid="PSA 21:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 21:10"/>Ingkoo bheupamembali manga incia mboomo waa mokarore-rore</para>
  <para style="q2" vid="PSA 21:10">wakutuuna upatiumba karomu.</para>
  <para style="q1" vid="PSA 21:10">Roonamo tee pamuruna KAWASANA OPU, manga incia bheatopepadhai,</para>
  <para style="q2" vid="PSA 21:10">tee manga incia bheakandea waa.<verse eid="PSA 21:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 21:11"/>Bhari-bharia anana tee opuopuana manga incia bheupabinasea minaaka i bhawona alamu,</para>
  <para style="q2" vid="PSA 21:11">tee o siwuluna manga incia uka minaaka i tanga-tangana anana maanusia.<verse eid="PSA 21:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 21:12"/>Moomini manga incia ahaejati madhaki to Ingkoo,</para>
  <para style="q2" vid="PSA 21:12">tee ahaejati bheatipuko, manga incia inda bheamembali.<verse eid="PSA 21:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 21:13"/>Ingkoo bheupewau manga incia apalaiaka karona</para>
  <para style="q2" vid="PSA 21:13">wakutuuna uhela matana panamu tee upatotoaka rouna manga incia.<verse eid="PSA 21:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 21:14"/>E KAWASANA OPU, taroakamo utopekalanga i nuncana kuasamu!</para>
  <para style="q2" vid="PSA 21:14">Ingkami bhetalaguaka lagu kapujia to kaogesamu.<verse eid="PSA 21:14"/></para>
  <chapter eid="PSA 21"/>
  <chapter number="22" style="c" sid="PSA 22"/>
  <para style="s1">Aulataʼala, Haakimu Moʼadili</para>
  <para style="sr">
    <ref loc="PSA 22:1-32">22:1-32</ref></para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 22:1"/>To kapalana molaguna. Mboomo lagu: Rusa i wakutuuna raneeo. Zaburuna Daud.<verse eid="PSA 22:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 22:2"/>
    <note caller="-" style="x">
      <char style="xo" closed="false">22:2 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 27:46">Mat. 27:46</ref>; <ref loc="MRK 15:34">Mrk. 15:34</ref>.</char>
    </note>E Aulataʼalaku, e Aulataʼalaku, pokia ubholiaku?</para>
  <para style="q2" vid="PSA 22:2">Pokia upekaridho, inda utulungiaku</para>
  <para style="q2" vid="PSA 22:2">tee inda uperangoi goraku?<verse eid="PSA 22:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 22:3"/>E Aulataʼalaku, i wakutuuna eo iaku kudoʼa,</para>
  <para style="q2" vid="PSA 22:3">maka Ingkoo inda ulawani,</para>
  <para style="q1" vid="PSA 22:3">tee malo uka iaku kudoʼa,</para>
  <para style="q2" vid="PSA 22:3">maka o ngangarandaku inda uka awesa.<verse eid="PSA 22:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 22:4"/>Garaaka Ingkoo Momangkilona,</para>
  <para style="q2" vid="PSA 22:4">Ingkoo ukokauncuramaka i bhawona manga kapujiana miana Israel.<verse eid="PSA 22:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 22:5"/>Opu-opuamami aparacaeako.</para>
  <para style="q2" vid="PSA 22:5">Manga incia aparacaea, to upasalaamatia.<verse eid="PSA 22:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 22:6"/>Manga incia agora i Ingkoo, kasiimpo upasalaamatia;</para>
  <para style="q2" vid="PSA 22:6">manga incia aparacaeako, tee inda upekaeaia.<verse eid="PSA 22:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 22:7"/>Maka iaku sii mboomo ulo-ulo, mencuanamo mboomo maanusia.</para>
  <para style="q2" vid="PSA 22:7">Manga maanusia ahinaaku tee mia abhari abanciaku.<verse eid="PSA 22:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 22:8"/>
    <note caller="-" style="x">
      <char style="xo" closed="false">22:8 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 27:39">Mat. 27:39</ref>; <ref loc="MRK 15:29">Mrk. 15:29</ref>.</char>
    </note>Bhari-bharia mia mokamataaku aele-eleaku.</para>
  <para style="q2" vid="PSA 22:8">Manga incia angiripiaku, tee alengko-lengkoakaaku bhaana,<verse eid="PSA 22:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 22:9"/>
    <note caller="-" style="x">
      <char style="xo" closed="false">22:9 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 27:43">Mat. 27:43</ref>.</char>
    </note>"Incia atangkaaka KAWASANA OPU</para>
  <para style="q2" vid="PSA 22:9">sumaimo taroakamo Incia mopabebasia!</para>
  <para style="q1" vid="PSA 22:9">Taroakamo KAWASANA OPU mopasalaamatia</para>
  <para style="q2" vid="PSA 22:9">roonamo KAWASANA OPU amaasiakea."<verse eid="PSA 22:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 22:10"/>Maka Ingkoomo mopalimbaaku minaaka i nuncana kadhuma,</para>
  <para style="q2" vid="PSA 22:10">tee ujaganiaku i sangoana inaku.<verse eid="PSA 22:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 22:11"/>Mancuanaku apasarakaakaaku to Ingkoo pepuu minaaka i nuncana kompona.</para>
  <para style="q2" vid="PSA 22:11">Apepuu minaaka i nuncana kadhumana inaku, Ingkoomo Aulataʼalaku.<verse eid="PSA 22:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 22:12"/>Bholi upekaridho, roonamo o balaa amakasumo</para>
  <para style="q2" vid="PSA 22:12">tee inda dhaangia motulungiaku.<verse eid="PSA 22:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 22:13"/>Abhari o sapi umane molibutiaku,</para>
  <para style="q2" vid="PSA 22:13">tee gulumana karambau umane minaaka i Basan alibuaku.<verse eid="PSA 22:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 22:14"/>Manga binata sumai abungkale ngangana pekaewa i aroaku,</para>
  <para style="q2" vid="PSA 22:14">mboomo singa mopapakina kinandena tee akomburu.<verse eid="PSA 22:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 22:15"/>Kakaaku mboomo uwe motolali,</para>
  <para style="q2" vid="PSA 22:15">bhari-bharia bukuku atorambasaka minaaka i losuaku.</para>
  <para style="q1" vid="PSA 22:15">Ateku mboomo taru,</para>
  <para style="q2" vid="PSA 22:15">arere i nuncana badaku.<verse eid="PSA 22:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 22:16"/>Mbalo-mbalona bhorokoku amatuu mboomo kapasana balanga,</para>
  <para style="q2" vid="PSA 22:16">tee o dhelaku apika i ngaraku.</para>
  <para style="q2" vid="PSA 22:16">Ingkoo upewauaku mboomo mia mate.<verse eid="PSA 22:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 22:17"/>Manga mantoa alibutiaku,</para>
  <para style="q2" vid="PSA 22:17">tee gulumana mia madhaki alibuaku.</para>
  <para style="q2" vid="PSA 22:17">Manga incia asula limaku tee aeku.<verse eid="PSA 22:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 22:18"/>Bhari-bharia bukuku amembali kugagaria,</para>
  <para style="q2" vid="PSA 22:18">manga incia atontoaku tee akamakamataaku.<verse eid="PSA 22:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 22:19"/>
    <note caller="-" style="x">
      <char style="xo" closed="false">22:19 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 27:35">Mat. 27:35</ref>; <ref loc="MRK 15:24">Mrk. 15:24</ref>; <ref loc="LUK 23:34">Luk. 23:34</ref>; <ref loc="JHN 19:24">Yah. 19:24</ref>.</char>
    </note>Manga incia apodhawu-dhawuakea o pakeaku sumai,</para>
  <para style="q2" vid="PSA 22:19">tee aʼundia.<verse eid="PSA 22:19"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 22:20"/>Maka Ingkoo e KAWASANA OPU bholi umaridho minaaka i karoku!</para>
  <para style="q2" vid="PSA 22:20">Ingkoomo mopekatangkana bukuku, umbamo madhei utulungiaku!<verse eid="PSA 22:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 22:21"/>Rambasakea o inyawaku minaaka i ewanga,</para>
  <para style="q2" vid="PSA 22:21">tee upasalaamatiaku minaaka i mantoa mopapakiaku.<verse eid="PSA 22:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 22:22"/>Rambasakaaku minaaka i ngangana singa</para>
  <para style="q2" vid="PSA 22:22">tee minaaka i tanduna karambau.</para>
  <para style="q2" vid="PSA 22:22">Ingkoo padhamo upasalaamatiaku.<verse eid="PSA 22:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 22:23"/>
    <note caller="-" style="x">
      <char style="xo" closed="false">22:23 </char>
      <char style="xt" closed="false">
        <ref loc="HEB 2:12">Ibr. 2:12</ref>.</char>
    </note>Iaku bhekupetulatulaaka saromu i manga witinaiku,</para>
  <para style="q2" vid="PSA 22:23">tee i tanga-tangana jamaʼa bhekupuji-pujiko.<verse eid="PSA 22:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 22:24"/>Pujimo Incia, e manga mia momaekana i KAWASANA OPU!</para>
  <para style="q2" vid="PSA 22:24">E bhari-bharia siwuluna Yakub, muliangia o KAWASANA OPU!</para>
  <para style="q2" vid="PSA 22:24">E bhari-bharia siwuluna Israel, sujumo i Incia!<verse eid="PSA 22:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 22:25"/>Sababuna Incia inda apandaʼente tee ahina o mia motopisaki,</para>
  <para style="q2" vid="PSA 22:25">tee inda abuniaka rouna minaaka i mia incia sumai,</para>
  <para style="q2" vid="PSA 22:25">maka aperangoi o mia motopisaki sumai wakutuuna agora aemani tulungi i Incia.<verse eid="PSA 22:25"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 22:26"/>Roonamo Ingkoo, iaku kupuji-pujiko</para>
  <para style="q2" vid="PSA 22:26">i tanga-tangana jamaʼa mobhari sumai,</para>
  <para style="q1" vid="PSA 22:26">tee iaku bhekupomea tolauna oniku</para>
  <para style="q2" vid="PSA 22:26">i aroana manga mia momaekana tee Ingkoo.<verse eid="PSA 22:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 22:27"/>Iaku bhekukemba manga mia misikini mamudhaakana akande sakawana amambosu;</para>
  <para style="q2" vid="PSA 22:27">mia mopeelona KAWASANA OPU bheapujia;</para>
  <para style="q2" vid="PSA 22:27">taroakamo manga incia bhari-bharia amarambe o umuruna!<verse eid="PSA 22:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 22:28"/>Bhari-bharia lipu i dunia bheaudhania tee ambuli apuji kaogesana KAWASANA OPU.</para>
  <para style="q2" vid="PSA 22:28">Bhari-bharia siwulu minaaka i manga lipu bheasuju tee asomba i aroana<verse eid="PSA 22:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="PSA 22:29"/>roonamo tangkanamo KAWASANA OPU mokopamarintana,</para>
  <para style="q2" vid="PSA 22:29">Incia moparintana i bhari-bharia lipu.<verse eid="PSA 22:29"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="30" style="v" sid="PSA 22:30"/>Bhari-bharia mia morangkaea i dunia sii</para>
  <para style="q2" vid="PSA 22:30">bheasomba tee asuju i Incia.</para>
  <para style="q1" vid="PSA 22:30">Bhari-bharia maanusia mofanaa</para>
  <para style="q2" vid="PSA 22:30">bheasuju i aroana.<verse eid="PSA 22:30"/></para>
  <para style="q1">
    <verse number="31" style="v" sid="PSA 22:31"/>Manga opu-opuana naile itu bheasomba i Incia</para>
  <para style="q2" vid="PSA 22:31">tee apetulatulaaka KAWASANA OPU i siwuluna bhemoumbana naile itu.<verse eid="PSA 22:31"/></para>
  <para style="q1">
    <verse number="32" style="v" sid="PSA 22:32"/>Manga incia bheaumba tee apetulatulaaka kabanara</para>
  <para style="q2" vid="PSA 22:32">i lipu tee siwulu bhemoumbana naile itu</para>
  <para style="q2" vid="PSA 22:32">ande o KAWASANA OPU aʼadili tee uumatina.</para>
  <para style="q1" vid="PSA 22:32">Totuumo, Incia padhamo apewau mboo sumai.<verse eid="PSA 22:32"/></para>
  <chapter eid="PSA 22"/>
  <chapter number="23" style="c" sid="PSA 23"/>
  <para style="s1">KAWASANA OPU o Gembalaku Momalape</para>
  <para style="sr">
    <ref loc="PSA 23:1-6">23:1-6</ref></para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 23:1"/>Zaburuna Daud.</para>
  <para style="b" vid="PSA 23:1"/>
  <para style="q1" vid="PSA 23:1">KAWASANA OPU o gembalaku, iaku inda bhekukakuranga.<verse eid="PSA 23:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 23:2"/>
    <note caller="-" style="x">
      <char style="xo" closed="false">23:2 </char>
      <char style="xt" closed="false">
        <ref loc="REV 7:17">Wah. 7:17</ref>.</char>
    </note>Incia ataroakaaku kuponiunto i tana mokorumpu;</para>
  <para style="q2" vid="PSA 23:2">Incia abhawaaku i bhiwina uwe momalino.<verse eid="PSA 23:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 23:3"/>Incia apekatangkaaku,</para>
  <para style="q2" vid="PSA 23:3">tee atondaaku i dhala mobanara</para>
  <para style="q2" vid="PSA 23:3">rampaakanamo sifatuna mboomo gembala momalape.<verse eid="PSA 23:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 23:4"/>Moomini kudhala i nuncana mbolonga momalalanda mpuu,</para>
  <para style="q2" vid="PSA 23:4">iaku inda kumaeka balaa roonamo Ingkoo dhaangia i saripiku;</para>
  <para style="q1" vid="PSA 23:4">Ingkoo ujaganiaku</para>
  <para style="q2" vid="PSA 23:4">mboomo gembala mojaganina dumbana,</para>
  <para style="q2" vid="PSA 23:4">tee katuko ibhawamu, kunamisi kutohiburu.<verse eid="PSA 23:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 23:5"/>Ingkoo upasiapuakaaku kinande</para>
  <para style="q2" vid="PSA 23:5">i aroana manga bhaliku.</para>
  <para style="q1" vid="PSA 23:5">I bhaaku ujampuakea tee mina-mina mawondu;</para>
  <para style="q2" vid="PSA 23:5">tondeku uantokiakea tee giu isumpu motaralabhi-labhi.<verse eid="PSA 23:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 23:6"/>Kalape tee kaasi molagina bheaoseaku</para>
  <para style="q2" vid="PSA 23:6">saʼumurua dhadhiku,</para>
  <para style="q1" vid="PSA 23:6">tee iaku bhekumboore i nuncana Bhanuamu</para>
  <para style="q2" vid="PSA 23:6">saʼumurua.<verse eid="PSA 23:6"/></para>
  <chapter eid="PSA 23"/>
  <chapter number="24" style="c" sid="PSA 24"/>
  <para style="s1">Umbaana Raja Momulia i Nuncana Baitulla</para>
  <para style="sr">
    <ref loc="PSA 24:1-10">24:1-10</ref></para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 24:1"/>
    <note caller="-" style="x">
      <char style="xo" closed="false">24:1 </char>
      <char style="xt" closed="false">
        <ref loc="1CO 10:26">1Kor. 10:26</ref>.</char>
    </note>Zaburuna Daud.</para>
  <para style="q1" vid="PSA 24:1">KAWASANA OPU mokopewauaakana alamu tee bhari-bharia antona,</para>
  <para style="q2" vid="PSA 24:1">dunia tee bhari-bharia momboorena i nuncana.<verse eid="PSA 24:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 24:2"/>Incia modhikana kalempesina alamu i bhawona tawo,</para>
  <para style="q2" vid="PSA 24:2">tee apakaroa i bhawona manga umala.<verse eid="PSA 24:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 24:3"/>Incema momembalina mopenena i gununa KAWASANA OPU?</para>
  <para style="q2" vid="PSA 24:3">Tee incema momembalina moumbana i aroana tampa momangkilona?<verse eid="PSA 24:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 24:4"/>
    <note caller="-" style="x">
      <char style="xo" closed="false">24:4 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 5:8">Mat. 5:8</ref>.</char>
    </note>Mia momangkilona limana tee momalapena incana,</para>
  <para style="q2" vid="PSA 24:4">incia inda adoʼa i manga barahala,</para>
  <para style="q2" vid="PSA 24:4">tee inda aposumpa gau-gau.<verse eid="PSA 24:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 24:5"/>Incia bheapotibhaaka barakati minaaka i KAWASANA OPU,</para>
  <para style="q2" vid="PSA 24:5">tee Aulataʼala mopasalaamatia bheapabanarea.<verse eid="PSA 24:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 24:6"/>Siimo manga mia mopeelona Aulataʼala,</para>
  <para style="q2" vid="PSA 24:6">aumba to asomba Ingkoo, Aulataʼalana Yakub. <char style="qs">Sela</char><verse eid="PSA 24:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 24:7"/>Pobungkalemo pekaewa, e manga bhambana lawa!</para>
  <para style="q2" vid="PSA 24:7">Toangkamo, e manga bhamba motopakarona minaaka i piamo itu,</para>
  <para style="q2" vid="PSA 24:7">mamudhaakana Raja Momulia apesua!<verse eid="PSA 24:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 24:8"/>Incema o Raja Momulia sumai?</para>
  <para style="q2" vid="PSA 24:8">KAWASANA OPU, momakaana tee mohebana!</para>
  <para style="q2" vid="PSA 24:8">KAWASANA OPU, mohebana i nuncana potimbea!<verse eid="PSA 24:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 24:9"/>Pobungkalemo pekaewa, e manga bhambana lawa!</para>
  <para style="q2" vid="PSA 24:9">Toangkamo, e manga bhamba motopakarona minaaka i piamo itu,</para>
  <para style="q2" vid="PSA 24:9">mamudhaakana Raja Momulia apesua!<verse eid="PSA 24:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 24:10"/>"Incema buaka Raja momulia sumai?"</para>
  <para style="q2" vid="PSA 24:10">KAWASANA OPUNA saangua alamu,</para>
  <para style="q2" vid="PSA 24:10">Incia Raja Momulia! <char style="qs">Sela</char><verse eid="PSA 24:10"/></para>
  <chapter eid="PSA 24"/>
  <chapter number="25" style="c" sid="PSA 25"/>
  <para style="s1">Doʼa Emaniana Amponi tee Peulusa</para>
  <para style="sr">
    <ref loc="PSA 25:1-22">25:1-22</ref></para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 25:1"/>Zaburuna Daud.</para>
  <para style="b" vid="PSA 25:1"/>
  <para style="q1" vid="PSA 25:1">E KAWASANA OPU, i Ingkoomo kudoʼa!<verse eid="PSA 25:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 25:2"/>E Aulataʼalaku, i Ingkoomo kuparacaea,</para>
  <para style="q2" vid="PSA 25:2">maasangia inda kupotibhaaka kaea,</para>
  <para style="q2" vid="PSA 25:2">tee bholi utaroakea manga musuku apotawaikiaku.<verse eid="PSA 25:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 25:3"/>Bhari-bharia mia moharapuna i Ingkoo inda bheanamisi kaea,</para>
  <para style="q2" vid="PSA 25:3">maka manga mia mohianatia inda tee sababuna bheanamisi kaea.<verse eid="PSA 25:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 25:4"/>E KAWASANA OPU, paumbaakaaku manga dhalamu,</para>
  <para style="q2" vid="PSA 25:4">adhariakaaku manga parintamu.<verse eid="PSA 25:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 25:5"/>Bhawaaku kulingka i nuncana kabanaramu tee uadhariaku,</para>
  <para style="q2" vid="PSA 25:5">roonamo Ingkoomo Aulataʼala mopasalaamatiaku,</para>
  <para style="q2" vid="PSA 25:5">iaku kuantaantagiko saeoa.<verse eid="PSA 25:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 25:6"/>E KAWASANA OPU, udhania rahumatimu tee kaasimu molagina</para>
  <para style="q2" vid="PSA 25:6">roonamo bhari-bharia sumai adhaangiamo minaaka i zamani mangenge.<verse eid="PSA 25:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 25:7"/>Dosa-dosa wakutuuna amangura dhadhiku,</para>
  <para style="q2" vid="PSA 25:7">tee manga kasalaha ipewauku bholimo uudhania,</para>
  <para style="q1" vid="PSA 25:7">tabeana udhaniaku apokana tee kaasimu molagina</para>
  <para style="q2" vid="PSA 25:7">roonamo kalapena incamu, e KAWASANA OPU.<verse eid="PSA 25:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 25:8"/>KAWASANA OPU sumai amalape tee amakate totona incana,</para>
  <para style="q2" vid="PSA 25:8">sababuna Incia asusuaka dhala to manga mia mokodosa.<verse eid="PSA 25:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 25:9"/>KAWASANA OPU akapalai mia inda mosombo i dhala mobanara,</para>
  <para style="q2" vid="PSA 25:9">tee manga incia aadhariakea tee opea ipeeluna.<verse eid="PSA 25:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 25:10"/>Bhari-bharia dhalana KAWASANA OPU abukeaka tee kaasi molagina tee amembali atoparacaea</para>
  <para style="q2" vid="PSA 25:10">to mia mopengkenina i pojanjiana tee manga kaudhaniana.<verse eid="PSA 25:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 25:11"/>E KAWASANA OPU, roonamo saromu</para>
  <para style="q2" vid="PSA 25:11">amponia o kasalahaku moomini amaoge o kasalahaku sumai.<verse eid="PSA 25:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 25:12"/>Incema mia momaekana i KAWASANA OPU?</para>
  <para style="q2" vid="PSA 25:12">KAWASANA OPU bheasusuakea dhala to idhalikina.<verse eid="PSA 25:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 25:13"/>Manga incia bheasadhaadhaa adhadhi amasanaa,</para>
  <para style="q2" vid="PSA 25:13">tee manga siwuluna mokotinaurakaakana alamu.<verse eid="PSA 25:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 25:14"/>KAWASANA OPU aposabhangka tee manga mia momaekaia,</para>
  <para style="q2" vid="PSA 25:14">tee asusuaka o antona pojanjiana to manga incia.<verse eid="PSA 25:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 25:15"/>Mataku sadhaadhaa atonto KAWASANA OPU,</para>
  <para style="q2" vid="PSA 25:15">roonamo Incia bheapasalaamatiaku minaaka i balaa.<verse eid="PSA 25:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 25:16"/>Tontoaku, tee umaasiakaaku,</para>
  <para style="q2" vid="PSA 25:16">roonamo kumalino tee kutopisaki.<verse eid="PSA 25:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 25:17"/>Pekalalesaia o ngangarandaku sii minaaka i kasukara,</para>
  <para style="q2" vid="PSA 25:17">rambasakaaku minaaka i kanarakaaku.<verse eid="PSA 25:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 25:18"/>Tilikia kanarakaaku tee kasukaraku,</para>
  <para style="q2" vid="PSA 25:18">tee amponia bhari-bharia dhosaku.<verse eid="PSA 25:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 25:19"/>Kamatea, tapanamo kabhari o musuku,</para>
  <para style="q2" vid="PSA 25:19">tee manga incia abanciaku mpuu.<verse eid="PSA 25:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 25:20"/>Jagania inyawaku tee pasalaamatiaku,</para>
  <para style="q2" vid="PSA 25:20">bholi utaroakaaku kupotibhaaka kaea roonamo Ingkoo peulusaku.<verse eid="PSA 25:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 25:21"/>Maasangia o kakatena totona incamu tee kajujurumu ajaganiaku,</para>
  <para style="q2" vid="PSA 25:21">sababuna kuharapu i Ingkoo.<verse eid="PSA 25:21"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 25:22"/>E Aulataʼala, tolosia manga miana Israel minaaka i bhari-bharia kasukarana!<verse eid="PSA 25:22"/></para>
  <chapter eid="PSA 25"/>
  <chapter number="26" style="c" sid="PSA 26"/>
  <para style="s1">Doʼana Aemani Apabanarea KAWASANA OPU</para>
  <para style="sr">
    <ref loc="PSA 26:1-12">26:1-12</ref></para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 26:1"/>Zaburuna Daud.</para>
  <para style="b" vid="PSA 26:1"/>
  <para style="q1" vid="PSA 26:1">E KAWASANA OPU, ewaakaaku</para>
  <para style="q2" vid="PSA 26:1">roonamo kudhadhi i nuncana kakatena totona incaku.</para>
  <para style="q1" vid="PSA 26:1">Iaku kuparacaea i KAWASANA OPU</para>
  <para style="q2" vid="PSA 26:1">tee inda kusindoli.<verse eid="PSA 26:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 26:2"/>Parakisaaku, e KAWASANA OPU, tee ucobaaku,</para>
  <para style="q2" vid="PSA 26:2">ujimea o baatiniku tee ngangarandaku.<verse eid="PSA 26:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 26:3"/>Satotuuna, kaasimu molagina dhaangia i aroaku,</para>
  <para style="q2" vid="PSA 26:3">tee kudhadhi i nuncana kabanaramu.<verse eid="PSA 26:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 26:4"/>Iaku inda kuuncura tee mia pande gau-gau,</para>
  <para style="q2" vid="PSA 26:4">atawa kuposabhangka tee mia munaafiki.<verse eid="PSA 26:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 26:5"/>Iaku kubanci poromusakaana mia mopewauna kadhaki,</para>
  <para style="q2" vid="PSA 26:5">tee kumendeu kuuncura tee mia mokodosa.<verse eid="PSA 26:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 26:6"/>Iaku kubhanui limaku to tandana inda kusala,</para>
  <para style="q2" vid="PSA 26:6">kasiimpo kubulilingi tampana tunuana kurubanimu, e KAWASANA OPU,<verse eid="PSA 26:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 26:7"/>to kulaguaka manga kabhanti kasukuru to Aulataʼala tee suara makaa,</para>
  <para style="q2" vid="PSA 26:7">tee kupetulatulaaka bhari-bharia pewaumu inda momentela.<verse eid="PSA 26:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 26:8"/>E KAWASANA OPU, iaku kumaasiakea o bhanua mbooresamu,</para>
  <para style="q2" vid="PSA 26:8">tampana kamuliangimu amboore.<verse eid="PSA 26:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 26:9"/>Bholi uala inyawaku mboomo uala inyawana manga mia mokodosa,</para>
  <para style="q2" vid="PSA 26:9">tee bholi uala dhadhiku mboomo uala dhadhina pande pekamatena mia.<verse eid="PSA 26:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 26:10"/>I nuncana limana dhaangia tee haejati madhaki,</para>
  <para style="q2" vid="PSA 26:10">tee i lima kaanana atarima doina kasogo.<verse eid="PSA 26:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 26:11"/>Maka iaku bhekudhadhi tee kakatena totona incaku.</para>
  <para style="q2" vid="PSA 26:11">Pasalaamatiaku tee umaasiakaaku.<verse eid="PSA 26:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 26:12"/>Sii-sii kuʼamanimo minaaka i bhari-bharia balaa,</para>
  <para style="q2" vid="PSA 26:12">sumaimo iaku bhekupuji KAWASANA OPU i nuncana poromusakaana uumatina.<verse eid="PSA 26:12"/></para>
  <chapter eid="PSA 26"/>
  <chapter number="27" style="c" sid="PSA 27"/>
  <para style="s1">Amani i Nuncana Peulusana KAWASANA OPU</para>
  <para style="sr">
    <ref loc="PSA 27:1-14">27:1-14</ref></para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 27:1"/>Zaburuna Daud.</para>
  <para style="b" vid="PSA 27:1"/>
  <para style="q1" vid="PSA 27:1">KAWASANA OPU o kainawa tee kasalaamatiku,</para>
  <para style="q2" vid="PSA 27:1">tee incema buaka iaku bhekumaeka?</para>
  <para style="q1" vid="PSA 27:1">KAWASANA OPU o bentena dhadiku,</para>
  <para style="q2" vid="PSA 27:1">tee incema buaka iaku bhekurengku?<verse eid="PSA 27:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 27:2"/>Wakutuuna manga parampo aumba alibuaku</para>
  <para style="q2" vid="PSA 27:2">to akande dagiku,</para>
  <para style="q1" vid="PSA 27:2">siitumo bhari-bharia bhaliku tee musuku,</para>
  <para style="q2" vid="PSA 27:2">manga inciamo mosindolina tee momandawuna.<verse eid="PSA 27:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 27:3"/>Moomini alibuaku rombongana suludadu mobhari,</para>
  <para style="q2" vid="PSA 27:3">i nuncana ngangarandaku inda kumaeka.</para>
  <para style="q1" vid="PSA 27:3">Moomini dhaangia tee potimbea to moewangiaku,</para>
  <para style="q2" vid="PSA 27:3">iaku sadhaadhaa kuparacaea.<verse eid="PSA 27:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 27:4"/>Tangkanamo saangu iemaniku i KAWASANA OPU,</para>
  <para style="q2" vid="PSA 27:4">siitumo ipeeluku,</para>
  <para style="q1" vid="PSA 27:4">mamudhaakana kumboore i nuncana Bhanuana KAWASANA OPU</para>
  <para style="q2" vid="PSA 27:4">saʼumurua dhadhiku,</para>
  <para style="q1" vid="PSA 27:4">to kukamataaka kalapena KAWASANA OPU</para>
  <para style="q2" vid="PSA 27:4">tee kupengkaabha-abha i nuncana Bhanuana Momangkilo.<verse eid="PSA 27:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 27:5"/>Sababuna i wakutuuna kasukara,</para>
  <para style="q2" vid="PSA 27:5">KAWASANA OPU bheajaganiaku i tampana peulusana.</para>
  <para style="q1" vid="PSA 27:5">Incia bheabuniakaaku i nuncana Kemana Momangkilo,</para>
  <para style="q2" vid="PSA 27:5">tee Incia bheaangkaaku i tampa moʼamani, siitumo i bhawona gunu bhatu.<verse eid="PSA 27:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 27:6"/>Sumaimo, bhaaku indamo atungku</para>
  <para style="q2" vid="PSA 27:6">i aroana manga musu molibuaku,</para>
  <para style="q1" vid="PSA 27:6">tee i nuncana Kemana Momangkilo</para>
  <para style="q2" vid="PSA 27:6">iaku bhekupasombaaka kurubani isumbele tee kusambo-sambo;</para>
  <para style="q2" vid="PSA 27:6">iaku bhekulaguaka lagu kapujia to KAWASANA OPU.<verse eid="PSA 27:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 27:7"/>E KAWASANA OPU, maasangia urangoa o suaraku wakutuuna kugora,</para>
  <para style="q2" vid="PSA 27:7">maasiakaaku tee ulawaniaku!<verse eid="PSA 27:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 27:8"/>Totona incaku aose firimanimu, "Maimo umba uʼibaadati i Iaku."</para>
  <para style="q2" vid="PSA 27:8">Sumaimo, kulausakamo kuumba to kuʼibaadati, e KAWASANA OPU.<verse eid="PSA 27:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 27:9"/>Bholi ubuniaka karomu wakutuuna kuʼibaadati i Ingkoo.</para>
  <para style="q2" vid="PSA 27:9">Bholi inda umaheruakea o bhatuamu sii i nuncana pamurumu.</para>
  <para style="q1" vid="PSA 27:9">Ingkoomo moagoaku,</para>
  <para style="q2" vid="PSA 27:9">bholi umendeuaku atawa ubholiaku,</para>
  <para style="q2" vid="PSA 27:9">e Aulataʼala, mopasalaamatiaku!<verse eid="PSA 27:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 27:10"/>Moomini amaku tee inaku abholiaku,</para>
  <para style="q2" vid="PSA 27:10">KAWASANA OPU bheapepagoaku mboomo anana karona.<verse eid="PSA 27:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 27:11"/>E KAWASANA OPU, adhariakaaku opea ipeelumu,</para>
  <para style="q2" vid="PSA 27:11">tee ususuakaaku dhala momakate,</para>
  <para style="q2" vid="PSA 27:11">roonamo bhaliku tee musuku.<verse eid="PSA 27:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 27:12"/>Bholi upasaraakaaku i nawusuuna bhaliku,</para>
  <para style="q2" vid="PSA 27:12">roonamo manga sakusii gau-gau akakaromo aewangiaku,</para>
  <para style="q2" vid="PSA 27:12">siitumo manga mia modhadhina tee feʼeli madhaki.<verse eid="PSA 27:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 27:13"/>Iaku sadhaadhaa kuparacaea ande iaku bhekukamata kalapena KAWASANA OPU,</para>
  <para style="q2" vid="PSA 27:13">i lipuna manga mia modhadhi.<verse eid="PSA 27:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 27:14"/>Antagimo KAWASANA OPU!</para>
  <para style="q2" vid="PSA 27:14">Pekakaaia tee upekatangkea o incamu!</para>
  <para style="q2" vid="PSA 27:14">Umbe, antagimo KAWASANA OPU!<verse eid="PSA 27:14"/></para>
  <chapter eid="PSA 27"/>
  <chapter number="28" style="c" sid="PSA 28"/>
  <para style="s1">KAWASANA OPU o Peulusaku</para>
  <para style="sr">
    <ref loc="PSA 28:1-9">28:1-9</ref></para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 28:1"/>Zaburuna Daud.</para>
  <para style="b" vid="PSA 28:1"/>
  <para style="q1" vid="PSA 28:1">E KAWASANA OPU, gununa bhatuku, i Ingkoomo kugora!</para>
  <para style="q2" vid="PSA 28:1">Bholi utaroakaaku,</para>
  <para style="q1" vid="PSA 28:1">roonamo ande Ingkoo inda umaheruakaaku,</para>
  <para style="q2" vid="PSA 28:1">iaku mboomo mia mosapona i nuncana liana koburu.<verse eid="PSA 28:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 28:2"/>Perangoia iemaniku</para>
  <para style="q2" vid="PSA 28:2">wakutuuna kupekee kuemani tulungi i Ingkoo,</para>
  <para style="q1" vid="PSA 28:2">wakutuuna kuangka limaku tee kudoʼa</para>
  <para style="q2" vid="PSA 28:2">kupoaro i tampamu momangkilo mpuu.<verse eid="PSA 28:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 28:3"/>Ande uhukumuaku bholi upapobhawa-bhawaaku tee mia madhaki,</para>
  <para style="q2" vid="PSA 28:3">tee bholi upapobhawa-bhawaaku tee manga mia mopewauna madhaki,</para>
  <para style="q1" vid="PSA 28:3">mopogauna amalape i manga sabhangkana,</para>
  <para style="q2" vid="PSA 28:3">maka i nuncana ngangarandana abukeaka kadhaki.<verse eid="PSA 28:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 28:4"/>
    <note caller="-" style="x">
      <char style="xo" closed="false">28:4 </char>
      <char style="xt" closed="false">
        <ref loc="REV 22:12">Wah. 22:12</ref>.</char>
    </note>Hukumua manga incia apokana mboomo pewauna manga incia,</para>
  <para style="q2" vid="PSA 28:4">apokana mboomo feʼelina manga momadhakina.</para>
  <para style="q1" vid="PSA 28:4">Hukumua manga incia mboomo opea ipewauna limana,</para>
  <para style="q2" vid="PSA 28:4">pambuliakea to manga incia opea mopadhana ipewauna.<verse eid="PSA 28:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 28:5"/>Roonamo manga incia inda afaduliakea o opea ikarajaana KAWASANA OPU,</para>
  <para style="q2" vid="PSA 28:5">tee uka manga hali maoge mopadhana ipewauna.</para>
  <para style="q1" vid="PSA 28:5">KAWASANA OPU bheapatobhata manga incia tee inda apabhangua pendua.<verse eid="PSA 28:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 28:6"/>Atopujimo KAWASANA OPU</para>
  <para style="q2" vid="PSA 28:6">roonamo Incia padhamo aperangoi o opea iemaniku.<verse eid="PSA 28:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 28:7"/>KAWASANA OPU o kakaaku tee katangkesiku,</para>
  <para style="q2" vid="PSA 28:7">totona incaku aparacaea i Incia, tee atulungiaku.</para>
  <para style="q1" vid="PSA 28:7">Incaku akaunde-unde,</para>
  <para style="q2" vid="PSA 28:7">tee laguku kusukuru i Incia.<verse eid="PSA 28:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 28:8"/>KAWASANA OPU satotuuna o kakaana uumatina,</para>
  <para style="q2" vid="PSA 28:8">Incia o bente kasalaamatina to mia ilantina.<verse eid="PSA 28:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 28:9"/>Pasalaamatia o uumatimu,</para>
  <para style="q2" vid="PSA 28:9">barakatia pewauamu karomu.</para>
  <para style="q1" vid="PSA 28:9">Umembalimo gembalana, tee ubhawea saʼumurua.<verse eid="PSA 28:9"/></para>
  <chapter eid="PSA 28"/>
  <chapter number="29" style="c" sid="PSA 29"/>
  <para style="s1">Kaogesana KAWASANA OPU i Nuncana Garura<note caller="+" style="f"><char style="fr" closed="false">29:1 </char><char style="fq" closed="false">Garura: </char><char style="ft" closed="false">Ngalu makaa mpuu.</char></note></para>
  <para style="sr">
    <ref loc="PSA 29:1-11">29:1-11</ref></para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 29:1"/>
    <note caller="-" style="x">
      <char style="xo" closed="false">29:1 </char>
      <char style="xt" closed="false">
        <ref loc="PSA 96:7-9">Zab. 96:7-9</ref>.</char>
    </note>Zaburuna Daud.</para>
  <para style="b" vid="PSA 29:1"/>
  <para style="q1" vid="PSA 29:1">Pujimo KAWASANA OPU, e manga mahalukuna sorogaa,</para>
  <para style="q2" vid="PSA 29:1">pujimo kaogesana tee kuasana.<verse eid="PSA 29:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 29:2"/>Pujimo sarona KAWASANA OPU momulia</para>
  <para style="q2" vid="PSA 29:2">tee usombaia upake pakea momangkilo.<verse eid="PSA 29:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 29:3"/>Wakutuuna KAWASANA OPU apogau,</para>
  <para style="q2" vid="PSA 29:3">suarana Aulataʼala Momulia atorango angkolele</para>
  <para style="q2" vid="PSA 29:3">mboomo guntu i tangana andala.<verse eid="PSA 29:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 29:4"/>Suarana KAWASANA OPU amakaa mpuu,</para>
  <para style="q2" vid="PSA 29:4">Suarana KAWASANA OPU abukeaka kuasa.<verse eid="PSA 29:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 29:5"/>Wakutuuna KAWASANA OPU apogau, amembali akatuki manga puuna aras,</para>
  <para style="q2" vid="PSA 29:5">tee uka amembali apatobhata manga puuna aras motuwuna i Libanon.<verse eid="PSA 29:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 29:6"/>Incia apewau Gunu Libanon apekatiba-tiba mboomo anana sapi,</para>
  <para style="q2" vid="PSA 29:6">tee Gunu Siryon mboomo anana karambau.<verse eid="PSA 29:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 29:7"/>Suarana KAWASANA OPU apewau bherese apokilati.<verse eid="PSA 29:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 29:8"/>Suarana KAWASANA OPU apamembali tana matuu atorende,</para>
  <para style="q2" vid="PSA 29:8">KAWASANA OPU apamembali Tana Matuu Kades atorende.<verse eid="PSA 29:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 29:9"/>Suarana KAWASANA OPU amembali apakoana rusa bhawine mobhawa-bhawa,</para>
  <para style="q2" vid="PSA 29:9">tee apamembali manga koo amembali amatuu.</para>
  <para style="q1" vid="PSA 29:9">I nuncana Bhanuana Momangkilona</para>
  <para style="q2" vid="PSA 29:9">bhari-bharia uumati agora "Muliangimo KAWASANA OPU!"<verse eid="PSA 29:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 29:10"/>KAWASANA OPU akokuasa i bhawona mawa,</para>
  <para style="q2" vid="PSA 29:10">KAWASANA OPU o raja mokokuasa to saʼumurua.<verse eid="PSA 29:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 29:11"/>Maasangia KAWASANA OPU adhawu kakaa to uumatina,</para>
  <para style="q2" vid="PSA 29:11">tee abarakatiakea kasanaa tee kaʼamani to uumatina.<verse eid="PSA 29:11"/></para>
  <chapter eid="PSA 29"/>
  <chapter number="30" style="c" sid="PSA 30"/>
  <para style="s1">Doʼa Sukuru roonamo Asalaamati minaaka i Balaa</para>
  <para style="sr">
    <ref loc="PSA 30:1-13">30:1-13</ref></para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 30:1"/>Zaburuna Daud to alaguaka wakutuuna lipuna Israel alimbaisi Bhanua Mangkilo.<verse eid="PSA 30:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 30:2"/>Iaku kupujiko, e KAWASANA OPU,</para>
  <para style="q2" vid="PSA 30:2">sababuna Ingkoo padhamo upasalaamatiaku</para>
  <para style="q2" vid="PSA 30:2">tee inda utaroaka musuku asamboakaaku.<verse eid="PSA 30:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 30:3"/>E KAWASANA OPU, e Aulataʼalaku, iaku kugora i Ingkoo kuemani tulungi</para>
  <para style="q2" vid="PSA 30:3">tee Ingkoo mopauntona kapiiku.<verse eid="PSA 30:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 30:4"/>E KAWASANA OPU Ingkoo padhamo uangkaaku minaaka i alamuna koburu,</para>
  <para style="q2" vid="PSA 30:4">Ingkoo padhamo upotaangiaka dhadhiku sabutuna iaku inda kusapo i liana koburu.<verse eid="PSA 30:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 30:5"/>E manga mia mosaalihi, laguakamea manga lagu kapujia to KAWASANA OPU,</para>
  <para style="q2" vid="PSA 30:5">bhoasakamea o kasukuru to sarona momangkilona.<verse eid="PSA 30:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 30:6"/>Satotuuna o amarana sabantaramea,</para>
  <para style="q2" vid="PSA 30:6">maka o kalapena saʼumurua.</para>
  <para style="q1" vid="PSA 30:6">Moomini tatangi samaloa,</para>
  <para style="q2" vid="PSA 30:6">maka i wakutuuna saeona bhetakaunde-undemo.<verse eid="PSA 30:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 30:7"/>Roonamo kumasanaa, kupogau,</para>
  <para style="q2" vid="PSA 30:7">"Dhadhiku bheaʼamani torosu!"<verse eid="PSA 30:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 30:8"/>E KAWASANA OPU, roonamo kalapena incamu,</para>
  <para style="q2" vid="PSA 30:8">Upamembaliaku mboomo gunu momatangka.</para>
  <para style="q1" vid="PSA 30:8">Maka wakutuuna ubuniaka roumu,</para>
  <para style="q2" vid="PSA 30:8">iaku kumaeka.<verse eid="PSA 30:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 30:9"/>I Ingkoo iaku kugora, e KAWASANA OPU,</para>
  <para style="q2" vid="PSA 30:9">tee i Aulataʼala kuemani kaasi,<verse eid="PSA 30:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 30:10"/>"Opea o faʼedana to Ingkoo ande amabhotu inyawaku</para>
  <para style="q2" vid="PSA 30:10">tee kupesua i nuncana koburu?</para>
  <para style="q1" vid="PSA 30:10">Amembali buaka o ngawu asukuru i Ingkoo</para>
  <para style="q2" vid="PSA 30:10">tee apakoleleaka ande Ingkoo umembali utoparacaea?<verse eid="PSA 30:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 30:11"/>E KAWASANA OPU, maasangia urangoa tee umaasiakaaku.</para>
  <para style="q2" vid="PSA 30:11">E KAWASANA OPU, tulungiaku!"<verse eid="PSA 30:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 30:12"/>Tangiku ubhaliia amembali manari kaunde-unde,</para>
  <para style="q2" vid="PSA 30:12">kae kadhu tandana kaporona incaku ualea,</para>
  <para style="q2" vid="PSA 30:12">tee o tangaku ubhokeakea tee kasanaa.<verse eid="PSA 30:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 30:13"/>Sabutuna kumembali kulaguaka lagu kapujia to Ingkoo</para>
  <para style="q2" vid="PSA 30:13">tee inda soo kukatongo-tongo.</para>
  <para style="q1" vid="PSA 30:13">E KAWASANA OPU, e Aulataʼalaku, iaku gauku kusukuru i Ingkoo</para>
  <para style="q2" vid="PSA 30:13">to saʼumurua.<verse eid="PSA 30:13"/></para>
  <chapter eid="PSA 30"/>
  <chapter number="31" style="c" sid="PSA 31"/>
  <para style="s1">Amani i Nuncana Limana Aulataʼala</para>
  <para style="sr">
    <ref loc="PSA 31:1-25">31:1-25</ref></para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 31:1"/>To kapalana molaguna. Zaburuna Daud.<verse eid="PSA 31:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 31:2"/>E KAWASANA OPU, Ingkoomo peulusaku,</para>
  <para style="q2" vid="PSA 31:2">bholi utaroakaaku kutopekaea.</para>
  <para style="q2" vid="PSA 31:2">Pasalaamatiaku roonamo kaʼadilimu.<verse eid="PSA 31:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 31:3"/>Perangoiaku,</para>
  <para style="q2" vid="PSA 31:3">tee rambasakaaku pekadhei!</para>
  <para style="q1" vid="PSA 31:3">Umembalimo gunu bhatu to tampana peulusaku,</para>
  <para style="q2" vid="PSA 31:3">mboomo bentena potaangia mopasalaamatiaku.<verse eid="PSA 31:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 31:4"/>Satotuuna, Ingkoomo gunu bhatuku tee bentena potaangiaku.</para>
  <para style="q2" vid="PSA 31:4">Rampaakanamo saromu, kapalaikiaku tee utondaaku.<verse eid="PSA 31:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 31:5"/>Rambasakaaku minaaka i katapu</para>
  <para style="q2" vid="PSA 31:5">itaana musu to arakoaka iaku</para>
  <para style="q2" vid="PSA 31:5">roonamo Ingkoomo peulusaku.<verse eid="PSA 31:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 31:6"/>
    <note caller="-" style="x">
      <char style="xo" closed="false">31:6 </char>
      <char style="xt" closed="false">
        <ref loc="LUK 23:46">Luk. 23:46</ref>. </char>
    </note>I nuncana limamu kupasaraakaaka inyawaku.</para>
  <para style="q2" vid="PSA 31:6">Ingkoo padhamo upasalaamatiaku e KAWASANA OPU, Aulataʼala momembalina motoparacaea.<verse eid="PSA 31:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 31:7"/>Iaku kubanci manga mia mosombana barahala mosia-sia;</para>
  <para style="q2" vid="PSA 31:7">maka iaku samia kuparacaea i KAWASANA OPU.<verse eid="PSA 31:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 31:8"/>Iaku bhekusambo-sambo tee kukaunde-unde roonamo kaasimu molagina,</para>
  <para style="q2" vid="PSA 31:8">sababuna Ingkoo ukamata kanarakaaku</para>
  <para style="q2" vid="PSA 31:8">tee umatau kasukaraku.<verse eid="PSA 31:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 31:9"/>Ingkoo inda upasaraakaaku i limana musu,</para>
  <para style="q2" vid="PSA 31:9">maka Ingkoo upakakaro aeku i tampa momalalesa.<verse eid="PSA 31:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 31:10"/>E KAWASANA OPU, maasiakaakupo</para>
  <para style="q2" vid="PSA 31:10">roonamo iaku i nuncana kasukara,</para>
  <para style="q1" vid="PSA 31:10">mataku amandala roonamo kutangi,</para>
  <para style="q2" vid="PSA 31:10">badaku tee inyawaku anarakaa.<verse eid="PSA 31:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 31:11"/>Dhadhiku atopadha i nuncana kaporona inca,</para>
  <para style="q2" vid="PSA 31:11">umuruku atopadha roonamo kupeenci;</para>
  <para style="q1" vid="PSA 31:11">kakaaku aila roonamo kasalahaku,</para>
  <para style="q2" vid="PSA 31:11">tee manga bukuku amapuromo.<verse eid="PSA 31:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 31:12"/>I aroana bhari-bharia bhaliku, iaku kumembali giu ipotawaakana manga incia,</para>
  <para style="q2" vid="PSA 31:12">tee uka manga sarimbanuaku.</para>
  <para style="q1" vid="PSA 31:12">Iaku kumembali giu imingkiriaka to manga sampomatauku,</para>
  <para style="q2" vid="PSA 31:12">tee manga mia mokamataaku i dhala apalaiakaaku.<verse eid="PSA 31:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 31:13"/>Iaku kutomalinguaka mboomo mia mate,</para>
  <para style="q2" vid="PSA 31:13">iaku kumembali mboomo bara momapasa.<verse eid="PSA 31:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 31:14"/>Iaku kurango mia abhari apokamuntuiakaku,</para>
  <para style="q2" vid="PSA 31:14">kamingkiri<note caller="+" style="f"><char style="fr" closed="false">31:14 </char><char style="fq" closed="false">kamingkiri: </char><char style="ft" closed="false">Kadhaangiana mia monamisina karona amaeka mpuu tee ameri.</char></note> adhaangia i bhari-bharia rope!</para>
  <para style="q1" vid="PSA 31:14">Manga incia apomufakati to abhaliaku,</para>
  <para style="q2" vid="PSA 31:14">tee ahaejati to apekamateaku.<verse eid="PSA 31:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 31:15"/>Maka iaku kuparacaeako, e KAWASANA OPU,</para>
  <para style="q2" vid="PSA 31:15">sababuna iaku kupogau, "Ingkoomo Aulataʼala isombaku!"<verse eid="PSA 31:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 31:16"/>Dhadhiku dhaangia i nuncana limamu,</para>
  <para style="q2" vid="PSA 31:16">rambasakaaku minaaka i limana manga musuku</para>
  <para style="q2" vid="PSA 31:16">tee minaaka i manga mia mopajereaku.<verse eid="PSA 31:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 31:17"/>Taroakamo o caheana roumu akangkanai bhatuamu sii,</para>
  <para style="q2" vid="PSA 31:17">tee upasalaamatiaku roonamo kaasimu molagina.<verse eid="PSA 31:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 31:18"/>E KAWASANA OPU, bholi utaroakea manga musuku apekaeaaku</para>
  <para style="q2" vid="PSA 31:18">roonamo iaku kugora i Ingkoo.</para>
  <para style="q1" vid="PSA 31:18">Taroakamo manga mia madhaki apotibhaaka kaea,</para>
  <para style="q2" vid="PSA 31:18">tee taroakamo manga incia asapo i duniana mia mate tee inda tee uuʼuuna.<verse eid="PSA 31:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 31:19"/>Soncongia o muncuna manga pande gau-gau,</para>
  <para style="q2" vid="PSA 31:19">mohinana tee momangkatuna mia mobanara;</para>
  <para style="q2" vid="PSA 31:19">manga incia asombo tee apekahina.<verse eid="PSA 31:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 31:20"/>Tapanamo kabhari o kalapemu</para>
  <para style="q2" vid="PSA 31:20">mopadhana ipasiapuakamu to manga mia momaekako,</para>
  <para style="q2" vid="PSA 31:20">tee ipewaumu to manga mia mopeuluna i Ingkoo,</para>
  <para style="q2" vid="PSA 31:20">i aroana maanusia!<verse eid="PSA 31:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 31:21"/>Ingkoo ubuniaka manga incia i nuncana peulusana kuasamu</para>
  <para style="q2" vid="PSA 31:21">minaaka i mia mosahimuakana manga incia.</para>
  <para style="q1" vid="PSA 31:21">Ingkoo ujagani manga incia i nuncana mbooresamu</para>
  <para style="q2" vid="PSA 31:21">minaaka i manga mia moraeakana manga incia.<verse eid="PSA 31:21"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 31:22"/>Atopujimo KAWASANA OPU</para>
  <para style="q2" vid="PSA 31:22">roonamo inda amentela mpuu kaasina molagina mopadhana isusuakana to iaku</para>
  <para style="q2" vid="PSA 31:22">wakutuuna kumaseke mboomo kota motolibu.<verse eid="PSA 31:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 31:23"/>Roonamo kubingu, kusarongia,</para>
  <para style="q2" vid="PSA 31:23">"Kutopadhencumo minaaka i aroamu."</para>
  <para style="q1" vid="PSA 31:23">Maka satotuuna Ingkoo urangoa iemaniku</para>
  <para style="q2" vid="PSA 31:23">wakutuuna kugora kuemani tulungi i Ingkoo.<verse eid="PSA 31:23"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 31:24"/>Maasiakea o KAWASANA OPU,</para>
  <para style="q2" vid="PSA 31:24">e bhari-bharia mia mosaalihi!</para>
  <para style="q1" vid="PSA 31:24">KAWASANA OPU ajagani mia motaʼati</para>
  <para style="q2" vid="PSA 31:24">maka Incia ahukumu totuu-totuu o mia mosombo.<verse eid="PSA 31:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 31:25"/>Pekakaaia tee upekatangkea o incamu,</para>
  <para style="q2" vid="PSA 31:25">e bhari-bharia mia moharapuna i KAWASANA OPU!<verse eid="PSA 31:25"/></para>
  <chapter eid="PSA 31"/>
  <chapter number="32" style="c" sid="PSA 32"/>
  <para style="s1">Kasanaana Mia Motoʼamponina Dosana</para>
  <para style="sr">
    <ref loc="PSA 32:1-11">32:1-11</ref></para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 32:1"/>
    <note caller="-" style="x">
      <char style="xo" closed="false">32:1-2 </char>
      <char style="xt" closed="false">
        <ref loc="ROM 4:7-8">Rom. 4:7-8</ref>.</char>
    </note>Zaburuna Daud. Laguna kaadhari.</para>
  <para style="b" vid="PSA 32:1"/>
  <para style="q1" vid="PSA 32:1">Amasanaamo o mia motoʼamponina kasalahana,</para>
  <para style="q2" vid="PSA 32:1">tee o mia motomaʼafuakana dosana.<verse eid="PSA 32:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 32:2"/>Amasanaamo o mia</para>
  <para style="q2" vid="PSA 32:2">mopewauna kasalaha, maka inda alentua o KAWASANA OPU,</para>
  <para style="q2" vid="PSA 32:2">tee inda amakidha apekagau.<verse eid="PSA 32:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 32:3"/>Kangengena indapo kuʼakui dosaku,</para>
  <para style="q2" vid="PSA 32:3">buku-bukuku amalute roonamo kupeenci saeoa.<verse eid="PSA 32:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 32:4"/>Malo eona Ingkoo upekatamo kahukumuku.</para>
  <para style="q2" vid="PSA 32:4">Kakaaku atopadha mboomo kamba-kamba momalau roonamo akangkanaia kasodhona matanaeo. <char style="qs">Sela</char><verse eid="PSA 32:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 32:5"/>
    <note caller="-" style="x">
      <char style="xo" closed="false">32:5 </char>
      <char style="xt" closed="false">
        <ref loc="ROM 4:7-8">Rom. 4:7-8</ref>.</char>
    </note>Kasiimpo kuʼakuia o dosaku i Ingkoo</para>
  <para style="q2" vid="PSA 32:5">tee inda kubuniakea o kasalahaku.</para>
  <para style="q1" vid="PSA 32:5">Kupogau, "Iaku bhekuʼakuia manga kasalahaku i KAWASANA OPU,"</para>
  <para style="q2" vid="PSA 32:5">tee Ingkoo uʼamponi manga kasalahana dosaku. <char style="qs">Sela</char><verse eid="PSA 32:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 32:6"/>Sababuna sumai bhari-bharia mia mosaalihi tabeana adoʼa i Ingkoo</para>
  <para style="q2" vid="PSA 32:6">wakutuuna Ingkoo dhaangiapo umembali utopokawaaka.</para>
  <para style="q1" vid="PSA 32:6">Sumaimo wakutuuna uwena mawa maoge akawa,</para>
  <para style="q2" vid="PSA 32:6">uwena mawa sumai inda amembali apabinasa incia.<verse eid="PSA 32:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 32:7"/>Ingkoomo peulusaku,</para>
  <para style="q2" vid="PSA 32:7">Ingkoo mojaganiaku minaaka i kasukara,</para>
  <para style="q2" vid="PSA 32:7">Ingkoo modhikana lagu i nuncana ngangarandaku, roonamo padhamo upasalaamatiaku. <char style="qs">Sela</char><verse eid="PSA 32:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 32:8"/>Iaku bhekuadhariko tee kususuakako</para>
  <para style="q2" vid="PSA 32:8">dhala molaengana idhalaikimu.</para>
  <para style="q1" vid="PSA 32:8">Iaku bhekuudhaniakako,</para>
  <para style="q2" vid="PSA 32:8">tee kujaganiko mamudhaakana sadhaadhaa uʼamani.<verse eid="PSA 32:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 32:9"/>Bholi mboomo ajara atawa o siwuluna keledai</para>
  <para style="q2" vid="PSA 32:9">inda tee akalana,</para>
  <para style="q1" vid="PSA 32:9">tabeana atohelaaka tee kabhokena bhorokona tee rabutana,</para>
  <para style="q2" vid="PSA 32:9">ande inda mboo sumai, manga incia inda bheaoseko.<verse eid="PSA 32:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 32:10"/>Abhari o kanarakaa inamisina mia madhaki,</para>
  <para style="q2" vid="PSA 32:10">maka o mia moparacaeana i KAWASANA OPU</para>
  <para style="q2" vid="PSA 32:10">ajaganiakea tee kaasina molagina.<verse eid="PSA 32:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 32:11"/>E manga mia mobanara,</para>
  <para style="q2" vid="PSA 32:11">masanaamo tee ukaunde-undemo roonamo KAWASANA OPU!</para>
  <para style="q2" vid="PSA 32:11">Sambo-sambomo, e bhari-bharia mia momakatena incana!<verse eid="PSA 32:11"/></para>
  <chapter eid="PSA 32"/>
  <chapter number="33" style="c" sid="PSA 33"/>
  <para style="s">Manga Kapujia to KAWASANA OPU Isombana Miana Israel</para>
  <para style="sr">
    <ref loc="PSA 33:1-22">33:1-22</ref></para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 33:1"/>Sambo-sambomo rampaakanamo KAWASANA OPU, e manga mia mobanara!</para>
  <para style="q2" vid="PSA 33:1">Alaengamo mia momakatena incana apuji KAWASANA OPU.<verse eid="PSA 33:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 33:2"/>Emanimo sukuru i KAWASANA OPU tee umagasiaaka kecapi!</para>
  <para style="q2" vid="PSA 33:2">Laguakea o lagu kapujia to Incia tee umagasiaakea gambusu sapulu taliana.<verse eid="PSA 33:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 33:3"/>Laguakea to Incia saangu lagu bhaau!</para>
  <para style="q2" vid="PSA 33:3">Tikia pekalape o gambusumu, tee usambo-sambomo!<verse eid="PSA 33:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 33:4"/>Firimanina KAWASANA OPU sumai abanara,</para>
  <para style="q2" vid="PSA 33:4">tee bhari-bharia ikarajaana abukutiiakea ande Incia amembali atoparacaea.<verse eid="PSA 33:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 33:5"/>Incia amaasiaka kabanara tee kaʼadili,</para>
  <para style="q2" vid="PSA 33:5">saangua alamu abukeaka kaasina molagina.<verse eid="PSA 33:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 33:6"/>Minaaka i firimanina KAWASANA OPU o laiana apamembalia,</para>
  <para style="q2" vid="PSA 33:6">tee minaaka i poinuncana, bhari-bharia giu i laiana apadhaangiaia.<verse eid="PSA 33:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 33:7"/>Incia arombusaka uwena tawo mboomo arombusaka uwe i nuncana gusi,</para>
  <para style="q2" vid="PSA 33:7">tee mboomo andalaoge adhikaia i nuncana bendunga.<verse eid="PSA 33:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 33:8"/>Taroakamo saangua alamu amaeka i KAWASANA OPU,</para>
  <para style="q2" vid="PSA 33:8">tee taroakamo bhari-bharia mia i nuncana dunia atungku i Incia.<verse eid="PSA 33:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 33:9"/>Roonamo Incia afirimani sabutuna bhari-bharia amembali;</para>
  <para style="q2" vid="PSA 33:9">ande Incia adhawu parinta sabutuna bhari-bharia adhaangia tee amatangka.<verse eid="PSA 33:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 33:10"/>KAWASANA OPU apabatala opea ifikirina manga lipu,</para>
  <para style="q2" vid="PSA 33:10">tee apanainda opea ihaejatiakana manga incia.<verse eid="PSA 33:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 33:11"/>Maka o haejatina KAWASANA OPU sadhaadhaa saʼumurua,</para>
  <para style="q2" vid="PSA 33:11">tee o isikadina amatangka saʼumurua zamani.<verse eid="PSA 33:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 33:12"/>Amasanaamo mpuu o lipu mosombana KAWASANA OPU apamembalia Aulataʼalana,</para>
  <para style="q2" vid="PSA 33:12">amasanaamo mpuu uumati ipilina to mopotibhaakana tinaurakana.<verse eid="PSA 33:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 33:13"/>KAWASANA OPU apentiro minaaka i sorogaa,</para>
  <para style="q2" vid="PSA 33:13">tee akamata bhari-bharia maanusia.<verse eid="PSA 33:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 33:14"/>Minaaka i kauncuramakana, Incia atiliki</para>
  <para style="q2" vid="PSA 33:14">bhari-bharia momboorena i dunia.<verse eid="PSA 33:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 33:15"/>KAWASANA OPU mopebhanguina incana bhari-bharia maanusia,</para>
  <para style="q2" vid="PSA 33:15">KAWASANA OPU mokamatana bhari-bharia ipewauna manga incia.<verse eid="PSA 33:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 33:16"/>Samia raja inda atopasalaamati minaaka i kabharina suludaduna,</para>
  <para style="q2" vid="PSA 33:16">samia tantara mobarani inda bheasalaamati minaaka i kakaana.<verse eid="PSA 33:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 33:17"/>Ajarana potimbea inda amembali atotangkaaka to kasalaamati,</para>
  <para style="q2" vid="PSA 33:17">Moomini amakaa mpuu, o ajara inda amembali manga pasalaamati.<verse eid="PSA 33:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 33:18"/>Satotuuna, KAWASANA OPU afaduliaka manga mia momaekaia,</para>
  <para style="q2" vid="PSA 33:18">tee moharapuakana kaasina molagina<verse eid="PSA 33:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 33:19"/>to mopasalaamatina manga incia minaaka i mate,</para>
  <para style="q2" vid="PSA 33:19">tee apakande manga incia i wakutuuna umbaana balaana kaara.<verse eid="PSA 33:19"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 33:20"/>Incamami aharapuaka katulungina KAWASANA OPU,</para>
  <para style="q2" vid="PSA 33:20">Incia motulungina ingkita tee Incia amembali katangkesita.<verse eid="PSA 33:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 33:21"/>Roonamo Incia o incata akaunde-unde,</para>
  <para style="q2" vid="PSA 33:21">rampaakanamo ingkita taparacaea i sarona momangkilona.<verse eid="PSA 33:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 33:22"/>E KAWASANA OPU, taroakamo kaasimu molagina sadhaadhaa to ingkami</para>
  <para style="q2" vid="PSA 33:22">apokana tee opea mopadhana iharapumami i Ingkoo.<verse eid="PSA 33:22"/></para>
  <chapter eid="PSA 33"/>
  <chapter number="34" style="c" sid="PSA 34"/>
  <para style="s">I nuncana Kajaganina KAWASANA OPU</para>
  <para style="sr">
    <ref loc="PSA 34:1-23">34:1-23</ref></para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 34:1"/>
    <note caller="-" style="x">
      <char style="xo" closed="false">34:1 </char>
      <char style="xt" closed="false">
        <ref loc="1SA 21:13-15">1Sa. 21:13-15</ref>.</char>
    </note>Zaburuna Daud, wakutuuna incia apara-para amagila i aroana Abimelekh, sabutuna incia atopadhencu, kasiimpo alingka.<verse eid="PSA 34:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 34:2"/>Iaku bhekupuji KAWASANA OPU sadia,</para>
  <para style="q2" vid="PSA 34:2">tee inda kuunto-unto kupuji Incia.<verse eid="PSA 34:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 34:3"/>Iaku kubangga roonamo opea ipewauna KAWASANA OPU,</para>
  <para style="q2" vid="PSA 34:3">maasangia manga mia motopisaki arangoa tee akaunde-unde.<verse eid="PSA 34:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 34:4"/>Maimo tapobhawa-bhawa tamuliangi sarona KAWASANA OPU,</para>
  <para style="q2" vid="PSA 34:4">tee maimo tapobhawa-bhawaaka tapekalanga sarona!<verse eid="PSA 34:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 34:5"/>Iaku kudoʼa i KAWASANA OPU, tee Incia alawaniaku,</para>
  <para style="q2" vid="PSA 34:5">tee arambasakaaku minaaka i bhari-bharia kaekaku.<verse eid="PSA 34:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 34:6"/>Mia motontona Incia bheakocahea o rouna,</para>
  <para style="q2" vid="PSA 34:6">tee inda bheamaea.<verse eid="PSA 34:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 34:7"/>Mia motopisaki sii agora, tee o KAWASANA OPU aperangoia</para>
  <para style="q2" vid="PSA 34:7">tee apasalaamatia minaaka i bhari-bharia balaa.<verse eid="PSA 34:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 34:8"/>Malaaʼekatina KAWASANA OPU abulilingi tee ajagani mia momaekaia,</para>
  <para style="q2" vid="PSA 34:8">tee arambasaka manga incia minaaka i kasukara.<verse eid="PSA 34:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 34:9"/>
    <note caller="-" style="x">
      <char style="xo" closed="false">34:9 </char>
      <char style="xt" closed="false">
        <ref loc="1PE 2:3">1Ptr. 2:3</ref>.</char>
    </note>Namisimea tee ukamatamea tapanamo kalapena o KAWASANA OPU sumai!</para>
  <para style="q2" vid="PSA 34:9">Amasanaamo o mia mopeuluna i Incia.<verse eid="PSA 34:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 34:10"/>Maekamo i KAWASANA OPU, e ingkomiu manga uumatina momangkilo,</para>
  <para style="q2" vid="PSA 34:10">roonamo inda bheadhaangia ikakurangaakana manga mia momaekana i Incia.<verse eid="PSA 34:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 34:11"/>Manga singa momangura amalute tee amaara,</para>
  <para style="q2" vid="PSA 34:11">maka manga mia mopeelona KAWASANA OPU inda bheakakurangaaka manga giu momalape.<verse eid="PSA 34:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 34:12"/>Maimo e manga anaana, perangoiaku!</para>
  <para style="q2" vid="PSA 34:12">Iaku bhekuadhariakakomiu umaeka i KAWASANA OPU.<verse eid="PSA 34:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 34:13"/>
    <note caller="-" style="x">
      <char style="xo" closed="false">34:13-17 </char>
      <char style="xt" closed="false">
        <ref loc="1PE 3:10-12">1Ptr. 3:10-12</ref>.</char>
    </note>Incema mopeeluna dhadhi masanaa,</para>
  <para style="q2" vid="PSA 34:13">tee mopeeluna umuru marambe, mamudhaakana amembali aniʼimati manga giu malape?<verse eid="PSA 34:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 34:14"/>Jagania o dhelamu minaaka i momadhakina,</para>
  <para style="q2" vid="PSA 34:14">tee o bhiwimu minaaka i manga pogau mopekagau.<verse eid="PSA 34:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 34:15"/>Pekaridho minaaka i giu momadhaki, tee upewaumo manga giu momalape.</para>
  <para style="q2" vid="PSA 34:15">Peelomo kaʼamani tee kakaana bukumu tee uʼusahamo upomalape.<verse eid="PSA 34:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 34:16"/>KAWASANA OPU atiliki manga mia mobanara,</para>
  <para style="q2" vid="PSA 34:16">tee aperangoia ande agora aemani tulungi.<verse eid="PSA 34:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 34:17"/>KAWASANA OPU amusui manga mia mopewauna kadhaki</para>
  <para style="q2" vid="PSA 34:17">samatena manga incia, KAWASANA OPU apewau bhari-bharia mia amalinguaka manga mia madhaki sumai.<verse eid="PSA 34:17"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 34:18"/>Wakutuuna manga mia mobanara agora, KAWASANA OPU aperangoia,</para>
  <para style="q2" vid="PSA 34:18">tee arambasakea manga minaaka i bhari-bharia kanarakaana.<verse eid="PSA 34:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 34:19"/>KAWASANA OPU apomakasu tee manga mia momaidhiidhina incana,</para>
  <para style="q2" vid="PSA 34:19">Incia apasalaamati mia momatena akalana.<verse eid="PSA 34:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 34:20"/>Mia mobanara abhari o kanarakaana,</para>
  <para style="q2" vid="PSA 34:20">maka o KAWASANA OPU arambasakea minaaka i bhari-bharia sumai.<verse eid="PSA 34:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 34:21"/>
    <note caller="-" style="x">
      <char style="xo" closed="false">34:21 </char>
      <char style="xt" closed="false">
        <ref loc="JHN 19:36">Yah. 19:36</ref>.</char>
    </note>KAWASANA OPU ajagani bhari-bharia bukuna,</para>
  <para style="q2" vid="PSA 34:21">inda saangu uka momakatuna.<verse eid="PSA 34:21"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 34:22"/>Giu madhaki bheapekamate mia madhaki,</para>
  <para style="q2" vid="PSA 34:22">tee o mia mobancina mia mobanara bheatohukumu.<verse eid="PSA 34:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 34:23"/>KAWASANA OPU apasalaamati manga bhatuana,</para>
  <para style="q2" vid="PSA 34:23">tee bhari-bharia mia mopeuluna i Incia</para>
  <para style="q2" vid="PSA 34:23">inda bheatohukumu.<verse eid="PSA 34:23"/></para>
  <chapter eid="PSA 34"/>
  <chapter number="35" style="c" sid="PSA 35"/>
  <para style="s">Doʼa Emaniana Tulungi to Tapoaro tee Musu</para>
  <para style="sr">
    <ref loc="PSA 35:1-28">35:1-28</ref></para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 35:1"/>Zaburuna Daud.</para>
  <para style="b" vid="PSA 35:1"/>
  <para style="q1" vid="PSA 35:1">E KAWASANA OPU, upobhaliakea manga mia mobhaliaku,</para>
  <para style="q2" vid="PSA 35:1">tee upotimbeakea manga mia mopotimbeakaaku.<verse eid="PSA 35:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 35:2"/>Kenia o katangkesi maidhiidhi tee katangkesi maogemu,</para>
  <para style="q2" vid="PSA 35:2">tee ubhangumo utulungiaku!<verse eid="PSA 35:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 35:3"/>Bhindumea o pandanga tee ndamumu</para>
  <para style="q2" vid="PSA 35:3">to uewangi manga mia mopajereaku!</para>
  <para style="q1" vid="PSA 35:3">Paumbaaku ande Ingkoomo</para>
  <para style="q2" vid="PSA 35:3">mopasalaamatiaku!<verse eid="PSA 35:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 35:4"/>Taroakamo manga mia bhemopekamateaku</para>
  <para style="q2" vid="PSA 35:4">amaea tee apotibhaaka aebu.</para>
  <para style="q1" vid="PSA 35:4">Taroakamo manga mia mohaejatiakana kadhaki to iaku</para>
  <para style="q2" vid="PSA 35:4">asowo tee atopekaea.<verse eid="PSA 35:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 35:5"/>Taroakamo manga incia mboo kulina bhae</para>
  <para style="q2" vid="PSA 35:5">ikamburakana ngalu.</para>
  <para style="q1" vid="PSA 35:5">Taroakamo manga incia</para>
  <para style="q2" vid="PSA 35:5">apajerea malaaʼekatina KAWASANA OPU.<verse eid="PSA 35:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 35:6"/>Taroakamo dhalana manga incia amalalanda tee amararo,</para>
  <para style="q2" vid="PSA 35:6">tee manga incia apajerea malaaʼekatina KAWASANA OPU.<verse eid="PSA 35:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 35:7"/>Roonamo manga incia ataa katapu to iaku inda tee alasana</para>
  <para style="q2" vid="PSA 35:7">tee manga incia aseli kabhalongko to arakoaku inda tee sababuna.<verse eid="PSA 35:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 35:8"/>Taroakamo manga incia abinasa i wakutuu inda inamunamuna,</para>
  <para style="q2" vid="PSA 35:8">tee taroakamo manga incia apesua i nuncana katapu itaana karona.</para>
  <para style="q2" vid="PSA 35:8">Taroakamo manga incia akotibu tee abinasa i nuncana.<verse eid="PSA 35:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 35:9"/>Sumaimo kusambo-sambo roonamo KAWASANA OPU</para>
  <para style="q2" vid="PSA 35:9">tee kukaunde-unde roonamo Incia apasalaamatiaku.<verse eid="PSA 35:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 35:10"/>Tee mpuu-mpuuna incaku bhekupogau,</para>
  <para style="q2" vid="PSA 35:10">"E KAWASANA OPU, Ingkoo inda tee kadhimbamu!</para>
  <para style="q1" vid="PSA 35:10">Ingkoo upasalaamati manga mia malute</para>
  <para style="q2" vid="PSA 35:10">wakutuuna manga mia makaa apisaki manga incia,</para>
  <para style="q1" vid="PSA 35:10">Ingkoo ujagani manga mia malute tee momisikini</para>
  <para style="q2" vid="PSA 35:10">minaaka i limana manga mia morampasia."<verse eid="PSA 35:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 35:11"/>Manga mia madhaki adhawu kasakusiina to abhaliaku,</para>
  <para style="q2" vid="PSA 35:11">tee araeakaaku kupewau manga giu inda imatauku.<verse eid="PSA 35:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 35:12"/>Kalapeku manga incia abholosia tee kadhaki,</para>
  <para style="q2" vid="PSA 35:12">ngangarandaku amaasi tee amate o akalaku.<verse eid="PSA 35:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 35:13"/>Garaaka, wakutuuna manga incia amapii,</para>
  <para style="q2" vid="PSA 35:13">iaku kupake kae kadhu to tandana ande incaku amaporo.</para>
  <para style="q1" vid="PSA 35:13">Kusikisaa karoku tee kupoasa,</para>
  <para style="q2" vid="PSA 35:13">tee kupatungku bhaaku wakutuuna kudoʼa.<verse eid="PSA 35:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 35:14"/>Mboomo kudoʼaaka sabhangkaku atawa o witinaiku.</para>
  <para style="q1" vid="PSA 35:14">Iaku kutungku kutangisi manga incia,</para>
  <para style="q2" vid="PSA 35:14">mboomo mia mosukara motangisina mateana inana.<verse eid="PSA 35:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 35:15"/>Maka wakutuuna kutosunu, manga incia amasanaa tee aele-eleaku.</para>
  <para style="q2" vid="PSA 35:15">Manga incia aporomusaka abhaliaku,</para>
  <para style="q2" vid="PSA 35:15">tee inda aunto-unto afitanaaku.<verse eid="PSA 35:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 35:16"/>Mboomo manga mia munaafiki, manga incia aele-eleaku torosu</para>
  <para style="q2" vid="PSA 35:16">tee apakiri-kiriakaaku ngincina.<note caller="+" style="f"><char style="fr" closed="false">35:16 </char><char style="fq" closed="false">apakiri-kiriakaaku ngincina: </char><char style="ft" closed="false">Tandana o mia aʼamara tee abanci mia mosagaanana to miana Israel. </char></note><verse eid="PSA 35:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 35:17"/>E Kawasana Opu, sakawana naepia Ingkoo soo utonto-tontoaku?</para>
  <para style="q2" vid="PSA 35:17">Pabebasia o inyawaku minaaka i kahumbunina manga incia,</para>
  <para style="q1" vid="PSA 35:17">rambasakaaku minaaka i manga musuku mohumbuniaku mboomo manga singa mangura sumai!<verse eid="PSA 35:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 35:18"/>Sapadhana upasalaamatiaku, iaku bhekusukuru i Ingkoo</para>
  <para style="q2" vid="PSA 35:18">i tanga-tangana uumatimu,</para>
  <para style="q2" vid="PSA 35:18">tee bhekupujiko i tanga-tangana mia bhari.<verse eid="PSA 35:18"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 35:19"/>
    <note caller="-" style="x">
      <char style="xo" closed="false">35:19 </char>
      <char style="xt" closed="false">
        <ref loc="PSA 69:5">Zab. 69:5</ref>; <ref loc="JHN 15:25">Yah. 15:25</ref>.</char>
    </note>Bholi utaroakea manga mia amusuiaku inda tee sababuna</para>
  <para style="q2" vid="PSA 35:19">akaunde-unde wakutuuna akamataaku kunarakaa,</para>
  <para style="q1" vid="PSA 35:19">tee bholi utaroakea manga mia abanciaku inda tee sababuna</para>
  <para style="q2" vid="PSA 35:19">tee apotawaikiaku wakutuuna kusukara.<verse eid="PSA 35:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 35:20"/>Roonamo mencuana giu pomalape ipogauakana manga incia,</para>
  <para style="q2" vid="PSA 35:20">maka manga incia apogauaka haejatina to apekagau</para>
  <para style="q2" vid="PSA 35:20">to abhali manga mia mopomalapena i lipu sii.<verse eid="PSA 35:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 35:21"/>Manga incia akakee-kee tee ahinaaku</para>
  <para style="q2" vid="PSA 35:21">kasiimpo apogau, "Atumpu incamu, ingkami takamatamea ipewaumu!"<verse eid="PSA 35:21"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 35:22"/>E KAWASANA OPU Ingkoo padhamo ukamatea.</para>
  <para style="q2" vid="PSA 35:22">Bholimo soo utaroaka!</para>
  <para style="q1" vid="PSA 35:22">E Kawasana Opu, bholimo umaridho minaaka i iaku.<verse eid="PSA 35:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 35:23"/>Bhangumo uewaaka hakuku,</para>
  <para style="q2" vid="PSA 35:23">tee parakaraku, e Aulataʼalaku Kawasana Opuku!<verse eid="PSA 35:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 35:24"/>E KAWASANA OPU, e Aulataʼalaku, adiliaku upapokanea mboomo kabanaramu!</para>
  <para style="q2" vid="PSA 35:24">Bholi utaroakea manga incia akaunde-unde wakutuuna akamataaku kunarakaa.<verse eid="PSA 35:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 35:25"/>Bholi utaroakea manga incia apogau i nuncana ngangarandana,</para>
  <para style="q2" vid="PSA 35:25">"Atumpu incamu, siitumo ipeelumami!"</para>
  <para style="q2" vid="PSA 35:25">Bholi utaroakea manga incia apogau, "Padhamo tapahancurua!"<verse eid="PSA 35:25"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 35:26"/>Taroakamo manga mia mokaunde-undena mokamataaku wakutuuna kunarakaa</para>
  <para style="q2" vid="PSA 35:26">amembali amaea tee abingu.</para>
  <para style="q1" vid="PSA 35:26">Taroakamo manga mia mosomboakana karona</para>
  <para style="q2" vid="PSA 35:26">amaea tee apotibhaaka aebu.<verse eid="PSA 35:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 35:27"/>Taroakamo asambo-sambo tee akaunde-unde</para>
  <para style="q2" vid="PSA 35:27">manga mia gauna bheakamataaku kutopabanara!</para>
  <para style="q1" vid="PSA 35:27">Taroakamo manga incia bheapogau, "Tapanamo kaoge o KAWASANA OPU!</para>
  <para style="q2" vid="PSA 35:27">Incia akaunde-unde ande akamata dhadhina bhatuana amasanaa tee inda akakurangaaka opeopea!"<verse eid="PSA 35:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 35:28"/>Sumaimo iaku bhekupakoleleaka kabanaramu,</para>
  <para style="q2" vid="PSA 35:28">tee kupuji-pujiko saeoa.<verse eid="PSA 35:28"/></para>
  <chapter eid="PSA 35"/>
  <chapter number="36" style="c" sid="PSA 36"/>
  <para style="s">Kadhakina Mia Mokodosa tee Kaasina Aulataʼala</para>
  <para style="sr">
    <ref loc="PSA 36:1-13">36:1-13</ref></para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 36:1"/>To kapalana molaguna. Zaburuna Daud, o bhatuana KAWASANA OPU.<verse eid="PSA 36:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 36:2"/>Dosa apamembali mia madhaki arango pogau inda momalape i nuncana ngangarandana.</para>
  <para style="q2" vid="PSA 36:2">Mia incia sumai apogau i nuncana ngangarandana,</para>
  <para style="q2" vid="PSA 36:2">"Iaku inda kufaraluu kumaeka tee Aulataʼala."<verse eid="PSA 36:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 36:3"/>
    <note caller="-" style="x">
      <char style="xo" closed="false">36:3 </char>
      <char style="xt" closed="false">
        <ref loc="ROM 3:18">Rom. 3:18</ref>.</char>
    </note>Roonamo incia awuju karona,</para>
  <para style="q2" vid="PSA 36:3">tee afikiria ande o mia mosagaanana inda amataua o kasalahana, tee inda dhaangia mobancia.<verse eid="PSA 36:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 36:4"/>Pogau ibhoasakana satotuuna o kadhaki tee kagau-gau,</para>
  <para style="q2" vid="PSA 36:4">incia inda aʼaarifu tee inda apewau kalape.<verse eid="PSA 36:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 36:5"/>Incia ahaejatiaka kadhaki i bhawona kolemana,</para>
  <para style="q2" vid="PSA 36:5">sadiamo apewau inda momalapena,</para>
  <para style="q2" vid="PSA 36:5">tee inda amendeu apewau kadhaki.<verse eid="PSA 36:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 36:6"/>E KAWASANA OPU, kaasimu molagina akawa i laiana,</para>
  <para style="q2" vid="PSA 36:6">tee kaparacaeamu akawa i taʼina ngalu.<verse eid="PSA 36:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 36:7"/>Kabanaramu mboomo gunu momakaa,</para>
  <para style="q2" vid="PSA 36:7">manga kambotumu mboomo andalaogena,</para>
  <para style="q1" vid="PSA 36:7">E KAWASANA OPU, Ingkoomo modhambaakana maanusia tee binata.<verse eid="PSA 36:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 36:8"/>Tapanamo kalape o kaasimu molagina, e KAWASANA OPU!</para>
  <para style="q2" vid="PSA 36:8">Bhari-bharia maanusia ujagania i nuncana peulusana panimu.<verse eid="PSA 36:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 36:9"/>Manga incia amambosu akande i Bhanuamu,</para>
  <para style="q2" vid="PSA 36:9">tee atarima manga giu momalape mboomo o umala mosiwulu.<verse eid="PSA 36:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 36:10"/>Ingkoomo asalana dhadhina bhari-bharia mahaluku,</para>
  <para style="q2" vid="PSA 36:10">tee kainawamu mosuluwina dhadhimami.<verse eid="PSA 36:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 36:11"/>Palausakea o kaasimu molagina i mia momatauko,</para>
  <para style="q2" vid="PSA 36:11">tee kabanaramu i mia momakatena incana.<verse eid="PSA 36:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 36:12"/>Bholi utaroakaaku ahumbuniaku mia mosombo,</para>
  <para style="q2" vid="PSA 36:12">atawa apadhencuaku mia madhaki.<verse eid="PSA 36:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 36:13"/>Kamatea, mia mopewauna kadhaki akotibumo,</para>
  <para style="q2" vid="PSA 36:13">manga incia apolangkuri tee inda amembali abhangu pendua.<verse eid="PSA 36:13"/></para>
  <chapter eid="PSA 36"/>
  <chapter number="37" style="c" sid="PSA 37"/>
  <para style="s">Kaunde-undena Mia Madhaki Sabantaramea</para>
  <para style="sr">
    <ref loc="PSA 37:1-40">37:1-40</ref></para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 37:1"/>Zaburuna Daud.</para>
  <para style="b" vid="PSA 37:1"/>
  <para style="q1" vid="PSA 37:1">Bholi uʼamara roonamo o mia mopewauna kadhaki,</para>
  <para style="q2" vid="PSA 37:1">bholi ugigibulu<note caller="+" style="f"><char style="fr" closed="false">37:1 </char><char style="fq" closed="false">ugigibulu: </char><char style="ft" closed="false">Maʼanana uʼiri.</char></note> tee pande gau-gau roonamo opea ipotibhaakana,<verse eid="PSA 37:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 37:2"/>roonamo manga incia bhealausaka amatuu mboomo rumpu,</para>
  <para style="q2" vid="PSA 37:2">tee amalau mboomo penembula.<verse eid="PSA 37:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 37:3"/>Paracaeamo i KAWASANA OPU, tee upewaumo momalapena,</para>
  <para style="q2" vid="PSA 37:3">mbooremo i lipu sumai tee uʼamani.<verse eid="PSA 37:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 37:4"/>Kaunde-undemo roonamo KAWASANA OPU</para>
  <para style="q2" vid="PSA 37:4">sumaimo Incia bheadhawuakako opea ipeelumu.<verse eid="PSA 37:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 37:5"/>Pasaraakaakea o dhadhimu i KAWASANA OPU tee uparacaeamo i Incia,</para>
  <para style="q2" vid="PSA 37:5">sumaimo Incia bheatulungiko.<verse eid="PSA 37:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 37:6"/>Incia bheapatiumba kabanaramu mboomo kainawa,</para>
  <para style="q2" vid="PSA 37:6">tee o kaʼadilimu mboomo caheana matanaeo.<verse eid="PSA 37:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 37:7"/>Tanangimo, bholi tee uuʼuumu i aroana KAWASANA OPU tee uantagimea.</para>
  <para style="q2" vid="PSA 37:7">Bholi uʼamara tee mia momalapena dhawuana,</para>
  <para style="q2" vid="PSA 37:7">atawa tee mia mopekagau.<verse eid="PSA 37:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 37:8"/>Untomo uʼamara tee ubholimea opea ilumbuakana incamu.</para>
  <para style="q2" vid="PSA 37:8">Untomo uʼamara, roonamo giu incia sumai bheaumbaaka kadhaki.<verse eid="PSA 37:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 37:9"/>Satotuuna o mia mopewauna kadhaki bheatopabinasa,</para>
  <para style="q2" vid="PSA 37:9">maka manga incia moharapuna i KAWASANA OPU bheapotibhaaka tana tinauraka ijanjiakana sumai.<verse eid="PSA 37:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 37:10"/>Inda amangenge indamo bheadhaangia uka o mia madhaki.</para>
  <para style="q2" vid="PSA 37:10">Wakutuuna upeeloa i tampana, indamo tee manga incia.<verse eid="PSA 37:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 37:11"/>
    <note caller="-" style="x">
      <char style="xo" closed="false">37:11 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 5:5">Mat. 5:5</ref>.</char>
    </note>Maka o mia mopaporitambena karona bheakotinaurakaaka tana incia sumai,</para>
  <para style="q2" vid="PSA 37:11">tee akaunde-unde aniʼimati kasanaa motaralabhi-labhi.<verse eid="PSA 37:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 37:12"/>Mia madhaki ahaejati inda momalape i mia mobanara,</para>
  <para style="q2" vid="PSA 37:12">tee apakiri-kiriakea tee ngincina.<verse eid="PSA 37:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 37:13"/>Maka o Aulataʼala apotawaikia</para>
  <para style="q2" vid="PSA 37:13">roonamo akamatea ande o eona amakasumo.<verse eid="PSA 37:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 37:14"/>Manga mia madhaki ahela ewangana tee apasiapu panana</para>
  <para style="q2" vid="PSA 37:14">to apekamate manga mia misikini tee manga mia monarakaa,</para>
  <para style="q2" vid="PSA 37:14">tee apekamate manga mia momakatena incana.<verse eid="PSA 37:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 37:15"/>Maka manga incia bheatobhoki badana karona,</para>
  <para style="q2" vid="PSA 37:15">tee o panana manga incia bheatokatuki.<verse eid="PSA 37:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 37:16"/>Saidhe o harataana mia mobanara</para>
  <para style="q2" vid="PSA 37:16">alabhi o kalapena minaaka i mia madhaki mobharina harataana.<verse eid="PSA 37:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 37:17"/>Roonamo o takiona mia madhaki bheatokatuki,</para>
  <para style="q2" vid="PSA 37:17">maka o KAWASANA OPU bheajagani mia mobanara.<verse eid="PSA 37:17"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 37:18"/>KAWASANA OPU ajagani dhadhina mia inda tee kasalahana,</para>
  <para style="q2" vid="PSA 37:18">tinaurakana manga incia sadhaadhaa saʼumurua.<verse eid="PSA 37:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 37:19"/>Manga incia inda bheamaea i wakutuuna kanarakaa,</para>
  <para style="q2" vid="PSA 37:19">tee i wakutuuna kaara manga incia bheamambosu.<verse eid="PSA 37:19"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 37:20"/>Maka o mia madhaki bheabinasa,</para>
  <para style="q2" vid="PSA 37:20">tee manga musuna KAWASANA OPU bheamofu, mboomo kamba-kamba i tana mokorumpu.</para>
  <para style="q2" vid="PSA 37:20">Manga incia bheamofu tee atopadha mboomo ombu.<verse eid="PSA 37:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 37:21"/>Ande dhaangia iadhana mia madhaki, manga incia inda bheapambulia pendua opea iadhana sumai,</para>
  <para style="q2" vid="PSA 37:21">maka o mia mobanara abukeaka kaasi tee sadia apekadhawu.<verse eid="PSA 37:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 37:22"/>Satotuuna o mia ibarakatina KAWASANA OPU bheakotinaurakaaka tana ijanjiakana sumai,</para>
  <para style="q2" vid="PSA 37:22">sainamo o mia itundana bheatopamofu.<verse eid="PSA 37:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 37:23"/>KAWASANA OPU mosusuakana dhala mobanara,</para>
  <para style="q2" vid="PSA 37:23">to mia momalapena feʼelina mopasanaana ngangarandana.<verse eid="PSA 37:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 37:24"/>Moomini asindoli incia inda bheamandawu</para>
  <para style="q2" vid="PSA 37:24">roonamo KAWASANA OPU atuko limana.<verse eid="PSA 37:24"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 37:25"/>Pepuu minaaka kumangura sakawana kumancuana,</para>
  <para style="q2" vid="PSA 37:25">indapo mina kukamata mia mobanara abholia KAWASANA OPU,</para>
  <para style="q2" vid="PSA 37:25">atawa o siwuluna amembali pande pengkaemani.<verse eid="PSA 37:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 37:26"/>Incia abukeaka kaasi tee sadia apekapaadha,</para>
  <para style="q2" vid="PSA 37:26">tee manga anana amembali barakati to incia.<verse eid="PSA 37:26"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 37:27"/>Bholia momadhakina tee upewaumo momalapena,</para>
  <para style="q2" vid="PSA 37:27">sumaimo ingkoo bheusadhaadhaa umboore to saʼumurua.<verse eid="PSA 37:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 37:28"/>Roonamo KAWASANA OPU amaasiaka pewau momalape tee moʼadili,</para>
  <para style="q2" vid="PSA 37:28">tee inda abholi manga mia mosaalihi.</para>
  <para style="q1" vid="PSA 37:28">Manga incia bheatojagani saʼumurua,</para>
  <para style="q2" vid="PSA 37:28">maka o siwuluna mia madhaki bheatopamofu.<verse eid="PSA 37:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="PSA 37:29"/>Mia mobanara bheakotinaurakaaka tana ijanjiakana sumai,</para>
  <para style="q2" vid="PSA 37:29">tee amboore iwe sumai saʼumurua.<verse eid="PSA 37:29"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="30" style="v" sid="PSA 37:30"/>Mia mobanara o pogauna akohikimati,</para>
  <para style="q2" vid="PSA 37:30">bhari-bharia ipogauakana aʼadili.<verse eid="PSA 37:30"/></para>
  <para style="q1">
    <verse number="31" style="v" sid="PSA 37:31"/>Hukumuna Aulataʼalana manga incia adhikaia i nuncana ngangarandana,</para>
  <para style="q2" vid="PSA 37:31">tee o bhengkalana inda bheasindoli.<verse eid="PSA 37:31"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="32" style="v" sid="PSA 37:32"/>Mia madhaki amata-matai mia mobanara,</para>
  <para style="q2" vid="PSA 37:32">tee ahaejati apekamatea.<verse eid="PSA 37:32"/></para>
  <para style="q1">
    <verse number="33" style="v" sid="PSA 37:33"/>Maka o KAWASANA OPU inda bheataroakea amandawu i limana musuna,</para>
  <para style="q2" vid="PSA 37:33">atawa ataroakea atohukumu i wakutuuna atoʼadili.<verse eid="PSA 37:33"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="34" style="v" sid="PSA 37:34"/>Harapumo i KAWASANA OPU tee utaʼatia o parintana,</para>
  <para style="q2" vid="PSA 37:34">sumaimo Incia bheaangkako to apamembaliko mokotinaurakaakana tana ijanjiakana sumai,</para>
  <para style="q2" vid="PSA 37:34">tee ingkoo bheukamata manga mia madhaki atopamofu.<verse eid="PSA 37:34"/></para>
  <para style="q1">
    <verse number="35" style="v" sid="PSA 37:35"/>Saangu wakutuu kukamata mia madhaki mopisakina mia mosagaanana,</para>
  <para style="q2" vid="PSA 37:35">dhadhina mboomo puuna kau motuwuna ajulu amaoge tee amaowo<note caller="+" style="f"><char style="fr" closed="false">37:35 </char><char style="fq" closed="false">amaowo: </char><char style="ft" closed="false">Maʼanana "rimbun."</char></note> i lipuna,<verse eid="PSA 37:35"/></para>
  <para style="q1">
    <verse number="36" style="v" sid="PSA 37:36"/>maka sapadhana sumai incia amofu, tee indamo atokamata.</para>
  <para style="q2" vid="PSA 37:36">Moomini kupeeloa, indamo kupotibhaakea.<verse eid="PSA 37:36"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="37" style="v" sid="PSA 37:37"/>Kamatea o mia inda tee kasalahana tee momakatena incana,</para>
  <para style="q2" vid="PSA 37:37">roonamo manga mia modhadhina mopomalape bheakaunde-unde o siwuluna naile itu.<verse eid="PSA 37:37"/></para>
  <para style="q1">
    <verse number="38" style="v" sid="PSA 37:38"/>Maka o mia mokodosa bheapabinasea bhari-bharia,</para>
  <para style="q2" vid="PSA 37:38">tee o siwuluna bheatopamofu.<verse eid="PSA 37:38"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="39" style="v" sid="PSA 37:39"/>KAWASANA OPU apasalaamati mia mobanara,</para>
  <para style="q2" vid="PSA 37:39">tee ajagani manga incia i wakutuuna kaseke.<verse eid="PSA 37:39"/></para>
  <para style="q1">
    <verse number="40" style="v" sid="PSA 37:40"/>KAWASANA OPU atulungi tee apasalaamati manga incia;</para>
  <para style="q2" vid="PSA 37:40">Incia apasalaamatia minaaka i manga mia madhaki,</para>
  <para style="q2" vid="PSA 37:40">roonamo manga incia apeulu i KAWASANA OPU.<verse eid="PSA 37:40"/></para>
  <chapter eid="PSA 37"/>
  <chapter number="38" style="c" sid="PSA 38"/>
  <para style="s">Doʼa i Wakutuuna Kapii</para>
  <para style="sr">
    <ref loc="PSA 38:1-23">38:1-23</ref></para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 38:1"/>Zaburuna Daud. Zikiri i wakutuuna pasombaana kurubanina kaudhania.<verse eid="PSA 38:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 38:2"/>E KAWASANA OPU, bholi uhukumuaku i nuncana amaramu,</para>
  <para style="q2" vid="PSA 38:2">bholi usikisaaku i nuncana pamurumu.<verse eid="PSA 38:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 38:3"/>Roonamo anana panamu atongke i badaku,</para>
  <para style="q2" vid="PSA 38:3">tee o limamu amakaa abhebheaku.<verse eid="PSA 38:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 38:4"/>Inda dhaangia o kalapena namisi i badaku roonamo pamurumu,</para>
  <para style="q2" vid="PSA 38:4">inda amatangka manga bukuku roonamo dosaku.<verse eid="PSA 38:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 38:5"/>Manga kasalahaku abhari alaloia o bhaaku,</para>
  <para style="q2" vid="PSA 38:5">mboomo bhawa momatamo mpuu to iaku.<verse eid="PSA 38:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 38:6"/>Manga kambelaku akobhou tee amabuto,</para>
  <para style="q2" vid="PSA 38:6">roonamo o kabhongo-bhongoku.<verse eid="PSA 38:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 38:7"/>Kapiiku amatamo mpuu, sabutuna inda amembali kukakaro.</para>
  <para style="q2" vid="PSA 38:7">Saeoa kutangi mboomo mia momaporona incana.<verse eid="PSA 38:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 38:8"/>Badaku amasodho roonamo amagari buluku,</para>
  <para style="q2" vid="PSA 38:8">inda dhaangia kalapena namisi i badaku.<verse eid="PSA 38:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 38:9"/>Tanagaku amapupumo sabutuna inda kunamisi opeopea,</para>
  <para style="q2" vid="PSA 38:9">iaku kupekidhei roonamo alilaho ngangarandaku.<verse eid="PSA 38:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 38:10"/>E Kawasana Opu, bhari-bharia pemeliliku atokamata i aroamu,</para>
  <para style="q2" vid="PSA 38:10">tee peenciku inda kubuniakea minaaka i Ingkoo.<verse eid="PSA 38:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 38:11"/>Randaku akabhaka-bhaka tee o tanagaku indamo dhaangia,</para>
  <para style="q2" vid="PSA 38:11">mataku amarawumo.<verse eid="PSA 38:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 38:12"/>Manga sabhangkaku indamo akasuiaku roonamo panyakiku,</para>
  <para style="q2" vid="PSA 38:12">witinaiku apekaridho minaaka i iaku.<verse eid="PSA 38:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 38:13"/>Manga mia bhemopekamateaku ataakaaku katapu,</para>
  <para style="q2" vid="PSA 38:13">tee manga mia mohaejatiakana kadhaki to iaku apogauaka kahancuru.</para>
  <para style="q2" vid="PSA 38:13">Manga incia afikiriaka tuaapa carana amembali ahianati mia mosagaanana saeoa.<verse eid="PSA 38:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 38:14"/>Maka iaku mboomo mia mabhongo inda moporango,</para>
  <para style="q2" vid="PSA 38:14">mboomo mia mobhea inda momembalina mopogau.<verse eid="PSA 38:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 38:15"/>Atotuu, iaku mboomo mia inda moporango,</para>
  <para style="q2" vid="PSA 38:15">rampaakanamo incia sumai inda kutagali.<verse eid="PSA 38:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 38:16"/>Maka iaku kuharapu i Ingkoo, e KAWASANA OPU.</para>
  <para style="q2" vid="PSA 38:16">E Kawasana Opu, e Aulataʼalaku, Ingkoomo bhemolawaniaku.<verse eid="PSA 38:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 38:17"/>Iaku kupogau, "Ancosala manga incia akaunde-unde akamataaku kusukara,</para>
  <para style="q2" vid="PSA 38:17">atawa asomboaka karona wakutuuna akamataaku kusindoli."<verse eid="PSA 38:17"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 38:18"/>Iaku saidhepo kumandawu,</para>
  <para style="q2" vid="PSA 38:18">tee atorotorosu kunamisi kapii.<verse eid="PSA 38:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 38:19"/>Iaku kuʼakuia manga kasalahaku,</para>
  <para style="q2" vid="PSA 38:19">tee kulilaho wakutuuna kufikiri manga dosaku.<verse eid="PSA 38:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 38:20"/>Manga musuku amakaa tee abhari mpuu,</para>
  <para style="q2" vid="PSA 38:20">manga incia abanciaku inda tee sababuna.<verse eid="PSA 38:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 38:21"/>Manga mia abalasi kalapeku tee kadhaki,</para>
  <para style="q2" vid="PSA 38:21">tee amembali bhaliku garaaka iaku kupewau giu momalape.<verse eid="PSA 38:21"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 38:22"/>E KAWASANA OPU, bholi ubholiaku.</para>
  <para style="q2" vid="PSA 38:22">E Aulataʼalaku, bholi upekaridho minaaka i iaku.<verse eid="PSA 38:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 38:23"/>Tulungiaku pekadhei,</para>
  <para style="q2" vid="PSA 38:23">e Kawasana Opu, mopasalaamatiaku.<verse eid="PSA 38:23"/></para>
  <chapter eid="PSA 38"/>
  <chapter number="39" style="c" sid="PSA 39"/>
  <para style="s1">Doʼana Emaniana Tulungi</para>
  <para style="sr">
    <ref loc="PSA 39:1-14">39:1-14</ref></para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 39:1"/>To kapalana molaguna. To Yedutun. Zaburuna Daud.<verse eid="PSA 39:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 39:2"/>Iaku kupogau,</para>
  <para style="q1" vid="PSA 39:2">"Bhekupengkaanaka kujagani karoku</para>
  <para style="q2" vid="PSA 39:2">mamudhaakana inda kukodosa tee dhelaku.</para>
  <para style="q1" vid="PSA 39:2">Iaku bhekukoputi muncuku</para>
  <para style="q2" vid="PSA 39:2">kangengena dhaangia tee mia madhaki i aroaku."<verse eid="PSA 39:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 39:3"/>Iaku inda kupogau sampeampearo;</para>
  <para style="q2" vid="PSA 39:3">pogau momalape uka inda kubhoasakea,</para>
  <para style="q2" vid="PSA 39:3">maka o kanarakaaku ahanda amatamo,<verse eid="PSA 39:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 39:4"/>ngangarandaku alilaho.</para>
  <para style="q2" vid="PSA 39:4">Ahanda kufikiria, ahanda amasodho ngangarandaku;</para>
  <para style="q2" vid="PSA 39:4">kasiimpo kupogau,<verse eid="PSA 39:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 39:5"/>"E KAWASANA OPU, paumbaakaaku naepia akawa o ajalaku</para>
  <para style="q2" vid="PSA 39:5">tee dhaangia pia eopo uka o dhadhiku</para>
  <para style="q2" vid="PSA 39:5">mamudhaakana kumataua ande o umuruku amampodho!<verse eid="PSA 39:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 39:6"/>Kamatea, tapanamo kampodho o umuru itantuakamu to iaku.</para>
  <para style="q2" vid="PSA 39:6">Dhadhiku mboomo inda tee maʼanana i matamu.</para>
  <para style="q1" vid="PSA 39:6">Bhari-bharia maanusia modhaangiana i dunia</para>
  <para style="q2" vid="PSA 39:6">bheamofu sakijamata mboomo poinunca. <char style="qs">Sela</char><verse eid="PSA 39:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 39:7"/>Dhadhina maanusia mboomo ngkamia-mia!</para>
  <para style="q2" vid="PSA 39:7">Ncia-nciamo maanusia moomini apepadhai tanaga,</para>
  <para style="q2" vid="PSA 39:7">incia arombusaka o harataa wakutuuna dhaangiapo adhadhi, maka samatena, inda amataua incema bhemoniʼimatia."<verse eid="PSA 39:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 39:8"/>"Sii-sii opea bheiantagiku, e Kawasana Opu?</para>
  <para style="q2" vid="PSA 39:8">Ingkoomo iharapuku.<verse eid="PSA 39:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 39:9"/>Rambasakaaku minaaka i bhari-bharia dosaku,</para>
  <para style="q2" vid="PSA 39:9">tee bholi utaroakaaku aele-eleaku mia mokabhongo-bhongo.<verse eid="PSA 39:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 39:10"/>Iaku inda kukosuara tee inda kubungkale ngangaku,</para>
  <para style="q2" vid="PSA 39:10">roonamo Ingkoomo mohukumuaku.<verse eid="PSA 39:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 39:11"/>Pekaridhoa o limamu to ubhebheaku,</para>
  <para style="q2" vid="PSA 39:11">sababuna saidhepo kumate roonamo kahukumumu.<verse eid="PSA 39:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 39:12"/>Ingkoo uadhari maanusia tee kahukumu roonamo kasalahana,</para>
  <para style="q2" vid="PSA 39:12">Ingkoo mboomo ane upahancuru opea imaasiakamami.</para>
  <para style="q2" vid="PSA 39:12">Bhari-bharia maanusia tangkanamo mboomo poinunca!" <char style="qs">Sela</char><verse eid="PSA 39:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 39:13"/>"E KAWASANA OPU, perangoia o doʼaku,</para>
  <para style="q2" vid="PSA 39:13">tee utilikiaku wakutuuna kugora kuemani tulungi.</para>
  <para style="q1" vid="PSA 39:13">Bholi inda umaheruakea ande kutangi,</para>
  <para style="q2" vid="PSA 39:13">roonamo iaku sii mboomo samia dhaga moumbana i Ingkoo,</para>
  <para style="q2" vid="PSA 39:13">mboomo bhari-bharia manga opu-opuaku.<verse eid="PSA 39:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 39:14"/>Bholi ukamataaku tee pamurumu</para>
  <para style="q2" vid="PSA 39:14">mamudhaakana amembali kupemboi pendua</para>
  <para style="q2" vid="PSA 39:14">wakutuuna indapo kumate."<verse eid="PSA 39:14"/></para>
  <chapter eid="PSA 39"/>
  <chapter number="40" style="c" sid="PSA 40"/>
  <para style="s">Doʼana Sukuru tee Doʼana Emaniana Tulungi</para>
  <para style="sr">
    <ref loc="PSA 40:1-18">40:1-18</ref></para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 40:1"/>To kapalana molaguna. Zaburuna Daud.<verse eid="PSA 40:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 40:2"/>Iaku kuantagi tee kuharapu mpuu katulungina KAWASANA OPU,</para>
  <para style="q2" vid="PSA 40:2">kasiimpo Incia atilikiaku tee aperangoi goraku.<verse eid="PSA 40:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 40:3"/>Incia aangkaaku minaaka i bhalona karompa,</para>
  <para style="q2" vid="PSA 40:3">minaaka i tomba momandala.</para>
  <para style="q1" vid="PSA 40:3">Incia apaʼamaniaku i bhawona gunu bhatu</para>
  <para style="q2" vid="PSA 40:3">tee apekatangka bhengkalaku.<verse eid="PSA 40:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 40:4"/>Incia aadhariakaaku lagu bhaau,</para>
  <para style="q2" vid="PSA 40:4">lagu kapujia to Aulataʼalata.</para>
  <para style="q1" vid="PSA 40:4">Abhari o mia bhemokamatea, kasiimpo amaeka</para>
  <para style="q2" vid="PSA 40:4">tee aparacaea i KAWASANA OPU.<verse eid="PSA 40:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 40:5"/>Amasanaamo o mia moparacaeana i KAWASANA OPU,</para>
  <para style="q2" vid="PSA 40:5">incia inda aose mia mosombo,</para>
  <para style="q2" vid="PSA 40:5">atawa aose mia mosombana barahala.<verse eid="PSA 40:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 40:6"/>E KAWASANA OPU, e Aulataʼalaku, abhari o giu inda momentela</para>
  <para style="q2" vid="PSA 40:6">mopadhana ipewaumu tee ihaejatiakamu to ingkami!</para>
  <para style="q2" vid="PSA 40:6">Inda dhaangia momembalina mopodhimbana tee Ingkoo!</para>
  <para style="q1" vid="PSA 40:6">Iaku bhekupetulatulaakea tee kubhoasakea,</para>
  <para style="q2" vid="PSA 40:6">maka abhari laulauna to kugagaria.<verse eid="PSA 40:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 40:7"/>
    <note caller="-" style="x">
      <char style="xo" closed="false">40:7-9 </char>
      <char style="xt" closed="false">
        <ref loc="HEB 10:5-7">Ibr. 10:5-7</ref>.</char>
    </note>Ingkoo inda uemani mamudhaakana kudhawuakako kurubani itunu tee pasombaana giuna ikande,</para>
  <para style="q2" vid="PSA 40:7">maka Ingkoo padhamo ubungkale talingaku.</para>
  <para style="q1" vid="PSA 40:7">Kurubani itunu tee kurubani kahapusuana dosa inda utuntua.<verse eid="PSA 40:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 40:8"/>Kasiimpo kupogau, "Kamatea, iaku kuumba,</para>
  <para style="q2" vid="PSA 40:8">i nuncana kalulungina kitabi mopadhana motoburi tee momembalina i karoku.<verse eid="PSA 40:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 40:9"/>Iaku gauku kupewau opea ipeelumu, e Aulataʼalaku,</para>
  <para style="q2" vid="PSA 40:9">tee o hukumumu dhaangia i nuncana ngangarandaku."<verse eid="PSA 40:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 40:10"/>Iaku padhamo kupakoleleaka kabanara i tampana poromusakaana uumatimu mobharina sumai.</para>
  <para style="q2" vid="PSA 40:10">Kamatea, iaku inda kutaangi bhiwiku,</para>
  <para style="q2" vid="PSA 40:10">e KAWASANA OPU, Ingkoo uka umataua!<verse eid="PSA 40:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 40:11"/>Kabanaramu inda kubuniakea i nuncana ngangarandaku,</para>
  <para style="q2" vid="PSA 40:11">iaku kupogauaka ande Ingkoo sadia ukeniaka pojanjiamu tee kupogauaka kasalaamati minaaka i Ingkoo.</para>
  <para style="q1" vid="PSA 40:11">Kaasimu molagina tee kabanaramu inda kurahasiaakea</para>
  <para style="q2" vid="PSA 40:11">i aroana poromusakaana uumatimu mobhari sumai.<verse eid="PSA 40:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 40:12"/>E KAWASANA OPU, bholi utaangi rahumatimu to iaku,</para>
  <para style="q2" vid="PSA 40:12">taroakamo o kaasimu molagina tee kabanaramu sadia ajaganiaku.<verse eid="PSA 40:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 40:13"/>Roonamo abhari mpuu o balaa molibuaku.</para>
  <para style="q1" vid="PSA 40:13">Iaku apajereaku manga dosaku</para>
  <para style="q2" vid="PSA 40:13">tee inda kumembali kupokamata;</para>
  <para style="q1" vid="PSA 40:13">kabharina alabhia o bulua i bhaaku,</para>
  <para style="q2" vid="PSA 40:13">sabutuna amateakea akalaku.<verse eid="PSA 40:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 40:14"/>
    <note caller="-" style="x">
      <char style="xo" closed="false">40:14-18 </char>
      <char style="xt" closed="false">
        <ref loc="PSA 70:2-6">Zab. 70:2-6</ref>.</char>
    </note>E KAWASANA OPU, madheimo upasalaamatiaku,</para>
  <para style="q2" vid="PSA 40:14">e KAWASANA OPU, madheimo utulungiaku!<verse eid="PSA 40:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 40:15"/>Maasangia manga mia mohaejatina mopekamateaku</para>
  <para style="q2" vid="PSA 40:15">amaea tee abingu.</para>
  <para style="q1" vid="PSA 40:15">Maasangia manga mia mohaejatina to mopacilakaaku</para>
  <para style="q2" vid="PSA 40:15">apalai tee apotibhaaka aebu.<verse eid="PSA 40:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 40:16"/>Maasangia manga mia moele-eleaku</para>
  <para style="q2" vid="PSA 40:16">atokidha roonamo manga incia amaea.<verse eid="PSA 40:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 40:17"/>Taroakamo bhari-bharia mia mopeeloko</para>
  <para style="q2" vid="PSA 40:17">amasanaa tee akaunde-unde,</para>
  <para style="q1" vid="PSA 40:17">tee taroakamo bhari-bharia momaasiakana kasalaamati minaaka i Ingkoo</para>
  <para style="q2" vid="PSA 40:17">sadia apogau, "Tapanamo kaogena o KAWASANA OPU!"<verse eid="PSA 40:17"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 40:18"/>Iaku sii kunarakaa tee kumisikini,</para>
  <para style="q2" vid="PSA 40:18">maka o Aulataʼala afaduliakaaku.</para>
  <para style="q1" vid="PSA 40:18">Ingkoomo motulungiaku tee mopasalaamatiaku,</para>
  <para style="q2" vid="PSA 40:18">E Aulataʼalaku, bholi upekanoe-noe, pekadheimo utulungiaku.<verse eid="PSA 40:18"/></para>
  <chapter eid="PSA 40"/>
  <chapter number="41" style="c" sid="PSA 41"/>
  <para style="s">Doʼa Emaniana Auntoaka Panyaki</para>
  <para style="sr">
    <ref loc="PSA 41:1-14">41:1-14</ref></para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 41:1"/>To kapalana molaguna. Zaburuna Daud.<verse eid="PSA 41:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 41:2"/>Amasanaamo mia mofaduliakana mia misikini!</para>
  <para style="q2" vid="PSA 41:2">KAWASANA OPU bheapasalaamatia i wakutuuna anarakaa.<verse eid="PSA 41:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 41:3"/>KAWASANA OPU bheajagania tee adhambaakea.</para>
  <para style="q2" vid="PSA 41:3">Sabutuna manga mia bheasarongiakea amasanaamo i lipuna mbooresana,</para>
  <para style="q2" vid="PSA 41:3">tee inda upasaraakaakea i manga musuna.<verse eid="PSA 41:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 41:4"/>KAWASANA OPU bheatulungia i wakutuuna amapii,</para>
  <para style="q2" vid="PSA 41:4">tee apauntoa minaaka i kapiina.<verse eid="PSA 41:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 41:5"/>Iaku kupogau, "E KAWASANA OPU, maasiakaaku,</para>
  <para style="q2" vid="PSA 41:5">pauntoa o panyakiku roonamo kukodosamo tee Ingkoo."<verse eid="PSA 41:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 41:6"/>Manga musuku apogauakaaku madhaki,</para>
  <para style="q2" vid="PSA 41:6">manga incia apogau, "Naepia incia bheamate mamudhaakana manga mia amalinguakea?"<verse eid="PSA 41:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 41:7"/>Manga mia mosoloaku inda amakate o ngangarandana;</para>
  <para style="q2" vid="PSA 41:7">manga incia apara-para afaduli tee agau-gau.</para>
  <para style="q1" vid="PSA 41:7">Manga incia apeelo lele madhaki minaaka i iaku,</para>
  <para style="q2" vid="PSA 41:7">kasiimpo alingka apetulatulaakea i dhala.<verse eid="PSA 41:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 41:8"/>Bhari-bharia mobanciaku apokamuntuiakaaku,</para>
  <para style="q2" vid="PSA 41:8">manga incia ahaejatiakaaku tee kadhaki.<verse eid="PSA 41:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 41:9"/>Pogauna manga incia, "Kapiina ahanda mpuu,</para>
  <para style="q2" vid="PSA 41:9">indamo bheamembali atopaunto."<verse eid="PSA 41:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 41:10"/>
    <note caller="-" style="x">
      <char style="xo" closed="false">41:10 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 26:23">Mat. 26:23</ref>; <ref loc="MRK 14:20">Mrk. 14:20</ref>; <ref loc="LUK 22:21">Luk. 22:21</ref>; <ref loc="JHN 13:18">Yah. 13:18</ref>.</char>
    </note>Sampe moomini o sabhangkaku momakasuna iparacaeaku,</para>
  <para style="q2" vid="PSA 41:10">mokandena rotiku, ambulimo abhaliaku.<verse eid="PSA 41:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 41:11"/>Maka Ingkoo, e KAWASANA OPU, susuakaaku o kaasimu, tee pauntoaku minaaka i kapiiku,</para>
  <para style="q2" vid="PSA 41:11">mamudhaakana amembali kubalasi kadhakina manga musuku.<verse eid="PSA 41:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 41:12"/>Tee mboo sumai iaku kumataua ande Ingkoo umaasiakaaku</para>
  <para style="q2" vid="PSA 41:12">roonamo o musuku inda amembali asambo-samboakaaku.<verse eid="PSA 41:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 41:13"/>Ingkoo utulungiaku roonamo kakatena totona incaku,</para>
  <para style="q2" vid="PSA 41:13">tee udhikaaku i saripimu saʼumurua.<verse eid="PSA 41:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 41:14"/>
    <note caller="-" style="x">
      <char style="xo" closed="false">41:14 </char>
      <char style="xt" closed="false">
        <ref loc="PSA 106:48">Zab. 106:48</ref>.</char>
    </note>Atopujimo KAWASANA OPU, Aulataʼala isombana miana Israel,</para>
  <para style="q2" vid="PSA 41:14">sii-sii tee saʼumurua!</para>
  <para style="q2" vid="PSA 41:14">Aamin!<verse eid="PSA 41:14"/></para>
  <chapter eid="PSA 41"/>
  <chapter number="42" style="c" sid="PSA 42"/>
  <para style="ms">BOKU I RUA ANGUNA:</para>
  <para style="s2">ZABURU 42--72</para>
  <para style="s1">Pemelili to Aulataʼala, Haakimu Moʼadili</para>
  <para style="sr">
    <ref loc="PSA 42:1-43:5">42:1--43:5</ref></para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 42:1"/>To kapalana molaguna. Lagu kaadharina miana Korah.<note caller="+" style="f"><char style="fr" closed="false">42:1 </char><char style="fq" closed="false">miana Korah: </char><char style="ft" closed="false">Kolompona molaguna minaaka i siwuluna Korah (kamata </char><char style="xt"><ref loc="NUM 26:10">Kab. 26:10</ref></char>), siitumo o Heman tee manga anana. Nabii Daud apatugasiaka Heman to apakawaaka kasameana nabii aoseakea gambusu tee lagu i nuncana ibaadati i Baitulla.</note><verse eid="PSA 42:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 42:2"/>Mboomo rusa apemeliliaka umala mokouwe,</para>
  <para style="q2" vid="PSA 42:2">mboo sumai uka iaku kupemeliliaka Ingkoo, e Aulataʼala.<verse eid="PSA 42:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 42:3"/>Iaku kufaraluu mpuu Aulataʼala,</para>
  <para style="q2" vid="PSA 42:3">Aulataʼala modhadhi.</para>
  <para style="q1" vid="PSA 42:3">Naepia amembali kupoaro tee kukamata Aulataʼala?<verse eid="PSA 42:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 42:4"/>Malo eona kutangi,</para>
  <para style="q2" vid="PSA 42:4">loluku amembali kinandeku.</para>
  <para style="q1" vid="PSA 42:4">Saeoa o musuku aele-eleaku tee apogau,</para>
  <para style="q2" vid="PSA 42:4">"Iapai o Aulataʼalamu?"<verse eid="PSA 42:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 42:5"/>Giumo incia sii iudhaniku,</para>
  <para style="q2" vid="PSA 42:5">wakutuuna kupetulatulaaka o antona ngangarandaku:</para>
  <para style="q1" vid="PSA 42:5">Tuaapa i piamo itu kulingka kupobhawa tee mia bhari wakutuu taporope i bhanuana Aulataʼala,</para>
  <para style="q2" vid="PSA 42:5">kuporiaroaaka dhala</para>
  <para style="q1" vid="PSA 42:5">poose tasambo-sambo tee tasukuru</para>
  <para style="q2" vid="PSA 42:5">i nuncana kariaa sumai.<verse eid="PSA 42:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 42:6"/>Pokia ingkoo umaasi e ngangarandaku,</para>
  <para style="q2" vid="PSA 42:6">tee ulilaho i nuncana badaku?</para>
  <para style="q1" vid="PSA 42:6">Harapumo i Aulataʼala roonamo iaku uka bhekupuji Incia</para>
  <para style="q2" vid="PSA 42:6">tee kasalaamati moumbana minaaka i aroana.<verse eid="PSA 42:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 42:7"/>E Aulataʼalaku, ngangarandaku ahancuru i nuncana badaku,</para>
  <para style="q2" vid="PSA 42:7">rampaakanamo sumai iaku bhekuudhaniko</para>
  <para style="q1" vid="PSA 42:7">minaaka i lipuna Umala Yordan tee Gunu Hermon,</para>
  <para style="q2" vid="PSA 42:7">tee minaaka i Gunu Mizar.<verse eid="PSA 42:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 42:8"/>Andalaoge alawani andalaoge mosagaanana</para>
  <para style="q2" vid="PSA 42:8">tee suarana momakaa o uwe momandawu minaaka i kalangaana.</para>
  <para style="q1" vid="PSA 42:8">Bhari-bharia ewo tee solomu</para>
  <para style="q2" vid="PSA 42:8">akangkanaiaku.<verse eid="PSA 42:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 42:9"/>I wakutuuna aeo KAWASANA OPU aparintaaka kaasina molagina,</para>
  <para style="q2" vid="PSA 42:9">tee i wakutuuna amalo iaku kulagu,</para>
  <para style="q2" vid="PSA 42:9">siitumo saangu doʼa to Aulataʼala mopadhadhiaku.<verse eid="PSA 42:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 42:10"/>Iaku kupogau tee Aulataʼala, gunu bhatuku,</para>
  <para style="q2" vid="PSA 42:10">"Pokia umalinguakaaku?</para>
  <para style="q1" vid="PSA 42:10">Pokia manga musuku apisakiaku</para>
  <para style="q2" vid="PSA 42:10">sabutuna iaku sadiamo kusukara?<verse eid="PSA 42:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 42:11"/>Mboomo katobhoki imateaka i nuncana bukuku,</para>
  <para style="q2" vid="PSA 42:11">manga bhaliku aele-eleaku.</para>
  <para style="q1" vid="PSA 42:11">Manga incia saeoa aabha,</para>
  <para style="q2" vid="PSA 42:11">"Iapai o Aulataʼalamu?"<verse eid="PSA 42:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 42:12"/>Pokia ingkoo umaasi, e ngangarandaku,</para>
  <para style="q2" vid="PSA 42:12">pokia ulilaho i nuncana badaku?</para>
  <para style="q1" vid="PSA 42:12">Harapumo i Aulataʼala roonamo iaku uka bhekupuji Incia,</para>
  <para style="q2" vid="PSA 42:12">Aulataʼalaku mopasalaamatiaku.<verse eid="PSA 42:12"/></para>
  <chapter eid="PSA 42"/>
  <chapter number="43" style="c" sid="PSA 43"/>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 43:1"/>E Aulataʼala, dhawuakumo kaʼadili,</para>
  <para style="q2" vid="PSA 43:1">tee uewaaka parakaraku i aroana lipu modorohaka.</para>
  <para style="q1" vid="PSA 43:1">Pabebasiaku minaaka i pande pekagau tee mia madhaki,<verse eid="PSA 43:1"/></para>
  <para style="q2">
    <verse number="2" style="v" sid="PSA 43:2"/>roonamo Ingkoomo Aulataʼala peulusaku.</para>
  <para style="q1" vid="PSA 43:2">Pokia Ingkoo umendeuaku?</para>
  <para style="q2" vid="PSA 43:2">Pokia iaku sadiamo kusukara</para>
  <para style="q2" vid="PSA 43:2">roonamo kapisakina musu?<verse eid="PSA 43:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 43:3"/>Lambokoa o kainawamu tee kabanaramu</para>
  <para style="q2" vid="PSA 43:3">to akapalaikiaku</para>
  <para style="q1" vid="PSA 43:3">tee abhawaaku i gunumu momangkilo,</para>
  <para style="q2" vid="PSA 43:3">i tampana mbooresamu.<verse eid="PSA 43:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 43:4"/>Sumaimo, iaku bhekulingka kuporope i tampa tunuana kurubani to Aulataʼala,</para>
  <para style="q2" vid="PSA 43:4">iaku bhekupoaro i Aulataʼala, mopasanaaku tee mopaunde-undeaku.</para>
  <para style="q1" vid="PSA 43:4">Iaku bhekupujiko tee kecapi,</para>
  <para style="q2" vid="PSA 43:4">e Kawasana Opu, e Aulataʼalaku.<verse eid="PSA 43:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 43:5"/>Pokia umaasi e ngangarandaku</para>
  <para style="q2" vid="PSA 43:5">tee pokia ulilaho i nuncana badaku?</para>
  <para style="q1" vid="PSA 43:5">Uharapumo i Aulataʼala roonamo iaku uka bhekupuji Incia,</para>
  <para style="q2" vid="PSA 43:5">Aulataʼalaku mopasalaamatiaku.<verse eid="PSA 43:5"/></para>
  <chapter eid="PSA 43"/>
  <chapter number="44" style="c" sid="PSA 44"/>
  <para style="s1">Pekidheina Lipu Motopisaki</para>
  <para style="sr">
    <ref loc="PSA 44:1-27">44:1-27</ref></para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 44:1"/>To kapalana molaguna. Zaburuna miana Korah. Laguna kaadhari.<verse eid="PSA 44:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 44:2"/>E Aulataʼala, ingkami padhamo tarangoa.</para>
  <para style="q2" vid="PSA 44:2">Opu-opuamami padhamo manga petulatulaaka</para>
  <para style="q1" vid="PSA 44:2">giu mopadhana ipewaumu i zamanina manga incia,</para>
  <para style="q2" vid="PSA 44:2">siitumo i zamani mangenge.<verse eid="PSA 44:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 44:3"/>Ingkoo upadhencu manga lipu mosagaanana tee limamu karomu,</para>
  <para style="q2" vid="PSA 44:3">kasiimpo upamboore opu-opuamami to kabholosina manga incia.</para>
  <para style="q1" vid="PSA 44:3">Ingkoo upahancuru manga lipu,</para>
  <para style="q2" vid="PSA 44:3">maka utaroakea opu-opuamami ajulu o kabharina.<verse eid="PSA 44:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 44:4"/>Manga incia inda apoewaangiakea to apotibhaaka tana incia sumai,</para>
  <para style="q2" vid="PSA 44:4">mencuana tee limana manga incia imembaliakana akana,</para>
  <para style="q1" vid="PSA 44:4">maka tee lima kaanamu tee kuasamu,</para>
  <para style="q2" vid="PSA 44:4">tee caheana roumu</para>
  <para style="q2" vid="PSA 44:4">roonamo Ingkoo umaasiaka manga incia.<verse eid="PSA 44:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 44:5"/>E Aulataʼala, Ingkoomo Rajaku,</para>
  <para style="q2" vid="PSA 44:5">mopamembalina miana Israel akana.<verse eid="PSA 44:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 44:6"/>Tee kuasamu ingkami tapadhencu musumami,</para>
  <para style="q2" vid="PSA 44:6">tee saromu, talandalandaki manga mia bhemoewangina ingkami.<verse eid="PSA 44:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 44:7"/>Mencuana panaku itangkaakaku,</para>
  <para style="q2" vid="PSA 44:7">hancuku uka inda apasalaamatiaku.<verse eid="PSA 44:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 44:8"/>Maka Ingkoomo mopasalaamatina ingkami minaaka i bhalimami,</para>
  <para style="q2" vid="PSA 44:8">tee upekaea manga mia mobancina ingkami.<verse eid="PSA 44:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 44:9"/>Roonamo Aulataʼala, ingkami sadia talaguaka lagu kapujia,</para>
  <para style="q2" vid="PSA 44:9">tee saromu, ingkami bhetasukuru saʼumurua. <char style="qs">Sela</char><verse eid="PSA 44:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 44:10"/>Maka sii-sii Ingkoo manga bholimo tee manga taroaka tamaea.</para>
  <para style="q2" vid="PSA 44:10">Ingkoo indamo umaju uka upobhawa tee tantaramami.<verse eid="PSA 44:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 44:11"/>Ingkoo manga taroaka tapalai minaaka i musumami,</para>
  <para style="q2" vid="PSA 44:11">tee manga mia mobancina ingkami arampasi harataamami.<verse eid="PSA 44:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 44:12"/>Ingkoo manga pasarakaaka mboomo dumba isumbele,</para>
  <para style="q2" vid="PSA 44:12">tee manga papogaa-gaa i lipu mosagaanana.<verse eid="PSA 44:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 44:13"/>Ingkoo uaso uumatimu inda tee haragaana i musuna to amembali bhatua,</para>
  <para style="q2" vid="PSA 44:13">tee inda uala laba saidhe uka.<verse eid="PSA 44:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 44:14"/>Ingkoo utaroaka ingkami mangahina manga lipu sarimbanuamami,</para>
  <para style="q2" vid="PSA 44:14">tee tamembali kaele-elena manga mia i saripimami.<verse eid="PSA 44:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 44:15"/>Utaroakea manga lipu apotawaiki ingkami.</para>
  <para style="q2" vid="PSA 44:15">Manga incia alengko-lengko bhaana to ingkami.<verse eid="PSA 44:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 44:16"/>Saeoa kutohina,</para>
  <para style="q2" vid="PSA 44:16">tee kutanggo kaeaku,<verse eid="PSA 44:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 44:17"/>roonamo kurango kaele-ele tee kahina</para>
  <para style="q2" vid="PSA 44:17">minaaka i musumami tee manga mia modhikaakana bukuna incana tee ingkami.<verse eid="PSA 44:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 44:18"/>Bhari-bharia sumai padhamo akangkanai ingkami</para>
  <para style="q2" vid="PSA 44:18">maka ingkami inda tamalinguakako</para>
  <para style="q2" vid="PSA 44:18">atawa tahianati janjimu tee ingkami.<verse eid="PSA 44:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 44:19"/>Incamami inda abhalii minaaka i Ingkoo,</para>
  <para style="q2" vid="PSA 44:19">tee ingkami inda tabholi o kaadharimu<verse eid="PSA 44:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 44:20"/>moomini Ingkoo padhamo upahancuru ingkami i tampana serigala,</para>
  <para style="q2" vid="PSA 44:20">tee udhika ingkami i nuncana kalalanda.<verse eid="PSA 44:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 44:21"/>Ande ingkami tamalinguaka sarona Aulataʼalamami,</para>
  <para style="q2" vid="PSA 44:21">atawa tadoʼa tee tasomba i Aulataʼala mosagaanana,<verse eid="PSA 44:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 44:22"/>Aulataʼala dhaanamo bheamataua,</para>
  <para style="q2" vid="PSA 44:22">satotuuna Incia amataua o rahasiana ngangarandamami!<verse eid="PSA 44:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 44:23"/>
    <note caller="-" style="x">
      <char style="xo" closed="false">44:23 </char>
      <char style="xt" closed="false">
        <ref loc="ROM 8:36">Rom. 8:36</ref>.</char>
    </note>Saeo-saeo ingkami taaro mate rampaakanamo taose tee tataʼati i Ingkoo,</para>
  <para style="q2" vid="PSA 44:23">tee ingkami tatoabhi mboomo dumba isumbele.<verse eid="PSA 44:23"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 44:24"/>E Aulataʼala, pewaumo. Pokia Ingkoo mboomo ukole?</para>
  <para style="q2" vid="PSA 44:24">Pewaumo! Bholi manga umendeu saʼumurua.<verse eid="PSA 44:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 44:25"/>Pokia Ingkoo ubuniaka karomu</para>
  <para style="q2" vid="PSA 44:25">tee umalinguaka kanarakaa tee kapisakimami?<verse eid="PSA 44:25"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 44:26"/>Ingkami takotibu i nuncana ngawu,</para>
  <para style="q2" vid="PSA 44:26">tee o badamami akumbu i tana.<verse eid="PSA 44:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 44:27"/>Pewaumo tee tulungimo ingkami!</para>
  <para style="q2" vid="PSA 44:27">Roonamo kaasimu molagina, manga tolosi!<verse eid="PSA 44:27"/></para>
  <chapter eid="PSA 44"/>
  <chapter number="45" style="c" sid="PSA 45"/>
  <para style="s">Lagu i Wakutuuna Kawiana Raja</para>
  <para style="sr">
    <ref loc="PSA 45:1-18">45:1-18</ref></para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 45:1"/>To kapalana molaguna. Aose lagu: Kamba-kamba Bakung. Zaburuna miana Korah. Laguna kaadhari; laguna kaasi.<verse eid="PSA 45:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 45:2"/>Ngangarandaku abukeaka tee manga lagu makesa.</para>
  <para style="q2" vid="PSA 45:2">Iaku bhekulaguaka laguku to raja,</para>
  <para style="q2" vid="PSA 45:2">dhelaku mboomo folupenina samia juru tulisi momakidha.<verse eid="PSA 45:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 45:3"/>Ingkoo momangadana i tanga-tangana umane,</para>
  <para style="q2" vid="PSA 45:3">kalapemu atokamata minaaka i pogaumu,</para>
  <para style="q2" vid="PSA 45:3">sababuna sumai Aulataʼala abarakatiko to saʼumurua.<verse eid="PSA 45:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 45:4"/>Bhokea o ewangamu i tangamu, e raja mobarani,</para>
  <para style="q2" vid="PSA 45:4">ingkoo momalangana tee momuliana!<verse eid="PSA 45:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 45:5"/>I nuncana kamuliangimu sumai usawikimo karetamu tee ukanamo,</para>
  <para style="q2" vid="PSA 45:5">to kabanara, sifatuna mia inda mosombo, tee kaʼadili!</para>
  <para style="q2" vid="PSA 45:5">Taroakamo lima kaanamu akarajaa pewauna motomaeka.<verse eid="PSA 45:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 45:6"/>Anana panamu amatadha,</para>
  <para style="q2" vid="PSA 45:6">alosa i bhakena manga musumu,</para>
  <para style="q2" vid="PSA 45:6">manga lipu akotibu i aroamu.<verse eid="PSA 45:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 45:7"/>
    <note caller="-" style="x">
      <char style="xo" closed="false">45:7-8 </char>
      <char style="xt" closed="false">
        <ref loc="HEB 1:8-9">Ibr. 1:8-9</ref>.</char>
    </note>Kauncuramakamu, e Aulataʼala, sadhaadhaa torotorosu tee saʼumurua,</para>
  <para style="q2" vid="PSA 45:7">tee o katukona pamarintamu satotuuna o katukona kabanara.<verse eid="PSA 45:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 45:8"/>Ingkoo umaasiaka kabanara tee ubanci mia madhaki.</para>
  <para style="q2" vid="PSA 45:8">Sababuna sumai, Kawasana Opumu, Aulataʼalamu, padhamo alantiko umembali raja</para>
  <para style="q2" vid="PSA 45:8">tee apasanaako alabhi minaaka i raja mosagaanana.<verse eid="PSA 45:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 45:9"/>Bhari-bharia pakeamu akobhou mina-mina mawondu mboomo polona damar, garu, tee asana.</para>
  <para style="q2" vid="PSA 45:9">Ingkoo umasanaa urango suarana kecapi tee gambusu minaaka i maligemu motobhelokiakana gadhi.<verse eid="PSA 45:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 45:10"/>I tanga-tangana manga bhawine molaianiko dhaangia tee manga bhawine o anana raja.</para>
  <para style="q2" vid="PSA 45:10">I weta kaanamu akabhale-bhale o ratu mopakena kabheloki bulawa momalape minaaka i Ofir.<verse eid="PSA 45:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 45:11"/>Perangoiaku pekalape, e kabuabua, kamatea tee utaaia o talingamu!</para>
  <para style="q2" vid="PSA 45:11">Malinguakamea o lipumu tee bhanuana amamu.<verse eid="PSA 45:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 45:12"/>Taroakamo o raja apeeluko roonamo umakesa!</para>
  <para style="q2" vid="PSA 45:12">Incia o opumu, sujumo uhoromatia.<verse eid="PSA 45:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 45:13"/>Raʼeatina kota Tirus bheabhawaakako pasombaa,</para>
  <para style="q2" vid="PSA 45:13">tee manga mia morangkaea bheaʼusaha to aala-ala incamu.<verse eid="PSA 45:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 45:14"/>Anana raja bhemokawina tee rajana Israel apesua i nuncana maligena,<note caller="+" style="f"><char style="fr" closed="false">45:14 </char><char style="fq" closed="false">Anana raja bhemokawina tee rajana Israel: </char><char style="ft" closed="false">Atokamata mboomo kabuabua ipetulatulaakana i aeati 11, siitumo anana raja minaaka i lipu mosagaanana, bheakawi tee rajana Israel.</char></note></para>
  <para style="q2" vid="PSA 45:14">pakeana kabuabua sumai abukeaka kasokai bulawa.<note caller="+" style="f"><char style="fr" closed="false">45:14 </char><char style="fq" closed="false">pakeana kabuabua sumai abukeaka kasokai bulawa: </char><char style="ft" closed="false">Pakea motobhelokiakana tee kambari mokowaranaa.</char></note><verse eid="PSA 45:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 45:15"/>Incia bheatoʼantara i raja tee pakea motosokai,</para>
  <para style="q2" vid="PSA 45:15">apoose tee manga sabhangkana,</para>
  <para style="q2" vid="PSA 45:15">siitumo manga kabuabua molaianina anana raja.<verse eid="PSA 45:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 45:16"/>Manga incia atoʼantara tee asambo-sambo tee akaunde-unde,</para>
  <para style="q2" vid="PSA 45:16">manga incia apesua i nuncana maligena raja.<verse eid="PSA 45:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 45:17"/>E raja, manga anamu bheabholosi opu-opuamu,</para>
  <para style="q2" vid="PSA 45:17">ingkoo bheuangkea manga to amembali kaogesa i saangua alamu.<verse eid="PSA 45:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 45:18"/>Iaku bhekupewau saromu amaoge tee bhari-bharia ipewaumu audhania mia sii-sii sakawana i aaherati,</para>
  <para style="q2" vid="PSA 45:18">sabutuna bhari-bharia lipu bheapuji-pujiko torosu saʼumurua.<verse eid="PSA 45:18"/></para>
  <chapter eid="PSA 45"/>
  <chapter number="46" style="c" sid="PSA 46"/>
  <para style="s">Aulataʼala o Kotana Benteta</para>
  <para style="sr">
    <ref loc="PSA 46:1-12">46:1-12</ref></para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 46:1"/>To kapalana molaguna. Laguna miana Korah; alaguakea tee suara momalanga.<verse eid="PSA 46:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 46:2"/>Aulataʼala sumai o tampana peulusata tee o kakaata.</para>
  <para style="q2" vid="PSA 46:2">Incia sadia amakasu to manga tulungi i wakutuuna kaseke.<verse eid="PSA 46:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 46:3"/>Sumaimo ingkita inda tamaeka, moomini o alamu akolendu,</para>
  <para style="q2" vid="PSA 46:3">moomini manga gunu atondu i nuncana tawo,<verse eid="PSA 46:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 46:4"/>tee moomini o tawo akomburu tee akobura</para>
  <para style="q2" vid="PSA 46:4">tee manga gunu akohudha rampaakanamo akangkanaia ewona tawo sumai. <char style="qs">Sela</char><verse eid="PSA 46:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 46:5"/>Dhaangia manga siwuluana uwena umala aumbaaka kaunde-unde to raʼeatina kotana Aulataʼala,<note caller="+" style="f"><char style="fr" closed="false">46:5 </char><char style="fq" closed="false">kotana Aulataʼala: </char><char style="ft" closed="false">Siitumo Kota Yerusalem, tampana Baitulla Momangkilo to miana Yahudi. </char></note></para>
  <para style="q2" vid="PSA 46:5">siitumo o tampa momangkilo, mbooresana Aulataʼala Momalanga.<verse eid="PSA 46:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 46:6"/>Aulataʼala amboore i tanga-tangana kota sumai, sabutuna o kota sumai inda bheakohudha.</para>
  <para style="q2" vid="PSA 46:6">Aulataʼala bheatulungia wakutuuna akawa raneeo.<verse eid="PSA 46:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 46:7"/>Manga raʼeatina lipu atobungke tee manga pamarintana abagoea,</para>
  <para style="q2" vid="PSA 46:7">rampaakanamo Incia aparangoaka suarana, alamu ahancuru.<verse eid="PSA 46:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 46:8"/>KAWASANA OPU, kapalana saangua pasukana sorogaa, apoose tee ingkita,</para>
  <para style="q2" vid="PSA 46:8">Aulataʼala isombana Yakub siitumo o kotana benteta. <char style="qs">Sela</char><verse eid="PSA 46:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 46:9"/>Mai, kamatea opea ikarajaana KAWASANA OPU,</para>
  <para style="q2" vid="PSA 46:9">Incia apewau giu inda momentela i alamu!<verse eid="PSA 46:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 46:10"/>Incia apaunto potimbea i saangua dunia,</para>
  <para style="q2" vid="PSA 46:10">pana apahancurua tee pandanga akatukia,</para>
  <para style="q2" vid="PSA 46:10">Incia atunu manga kareta potimbea tee waa.<verse eid="PSA 46:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 46:11"/>Firimanina, "Untomo upoewangi, mataumea ande Iaku sii o Aulataʼala!</para>
  <para style="q2" vid="PSA 46:11">Manga lipu bheapekalangaaku,</para>
  <para style="q2" vid="PSA 46:11">tee saangua alamu bheamuliangiaku."<verse eid="PSA 46:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 46:12"/>KAWASANA OPU, kapalana saangua pasukana sorogaa, apoose tee ingkita,</para>
  <para style="q2" vid="PSA 46:12">Aulataʼala isombana Yakub siitumo kotana benteta. <char style="qs">Sela</char><verse eid="PSA 46:12"/></para>
  <chapter eid="PSA 46"/>
  <chapter number="47" style="c" sid="PSA 47"/>
  <para style="s1">Aulataʼala Rajana Saangua Alamu</para>
  <para style="sr">
    <ref loc="PSA 47:1-10">47:1-10</ref></para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 47:1"/>To kapalana molaguna. Zaburu minaaka i miana Korah.<verse eid="PSA 47:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 47:2"/>E bhari-bharia lipu, pujimo Aulataʼala!</para>
  <para style="q2" vid="PSA 47:2">Bhija-bhijamea o Aulataʼala tee usambo-sambomo.<verse eid="PSA 47:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 47:3"/>Roonamo KAWASANA OPU Momalanga sumai atomaeka mpuu,</para>
  <para style="q2" vid="PSA 47:3">Incia o raja maoge mokuasaina saangua alamu.<verse eid="PSA 47:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 47:4"/>Incia apekatalo manga lipu tee adhawuakea i nuncana kuasata,</para>
  <para style="q2" vid="PSA 47:4">tee manga lipu adhikaia i tambena aeta.<verse eid="PSA 47:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 47:5"/>Incia mangapiliaka tana</para>
  <para style="q2" vid="PSA 47:5">bhemomembalina tinauraka ibanggaakata saʼumurua.<note caller="+" style="f"><char style="fr" closed="false">47:5 </char><char style="fq" closed="false">tinauraka ibanggaakata saʼumurua: </char><char style="ft" closed="false">Tinauraka sumai siitumo Tana Kanaan, tana ijanjiakana Aulataʼala to Ibrahim tee manga siwuluna.</char></note></para>
  <para style="q1" vid="PSA 47:5">Ingkita o siwuluna Yakub,</para>
  <para style="q2" vid="PSA 47:5">uumati imaasiakana. <char style="qs">Sela</char><verse eid="PSA 47:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 47:6"/>Wakutuuna Aulataʼala akompa i kauncuramakana, manga mia asambo-sambo tee akaunde-unde,</para>
  <para style="q2" vid="PSA 47:6">tee atowiiakea sangkakala.<verse eid="PSA 47:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 47:7"/>Laguakamea o lagu kapujia to Aulataʼala, laguakamea!</para>
  <para style="q2" vid="PSA 47:7">Laguakamea o lagu kapujia to Rajata, laguakamea!<verse eid="PSA 47:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 47:8"/>Roonamo Aulataʼala o Rajana saangua alamu,</para>
  <para style="q2" vid="PSA 47:8">laguakamea o laguna kaadhari!<verse eid="PSA 47:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 47:9"/>Aulataʼala satotuuna o Rajana bhari-bharia lipu,</para>
  <para style="q2" vid="PSA 47:9">Incia amboore i bhawona kauncuramakana momangkilo.<verse eid="PSA 47:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 47:10"/>Manga kapalana lipu aporomusaka</para>
  <para style="q2" vid="PSA 47:10">to amembali uumatina Aulataʼala isombana Ibrahim.</para>
  <para style="q1" vid="PSA 47:10">Roonamo bhari-bharia mokuasaina alamu sii atungku i Aulataʼala,</para>
  <para style="q2" vid="PSA 47:10">Incia atomuliangi mpuu.<verse eid="PSA 47:10"/></para>
  <chapter eid="PSA 47"/>
  <chapter number="48" style="c" sid="PSA 48"/>
  <para style="s1">Sion, Kotana Aulataʼala</para>
  <para style="sr">
    <ref loc="PSA 48:1-15">48:1-15</ref></para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 48:1"/>Zaburuna miana Korah to lagu.<verse eid="PSA 48:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 48:2"/>Tapanamo kaoge o KAWASANA OPU tee alaenga mpuu atopuji</para>
  <para style="q2" vid="PSA 48:2">i kotana Aulataʼalata, i gununa momangkilo.<verse eid="PSA 48:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 48:3"/>
    <note caller="-" style="x">
      <char style="xo" closed="false">48:3 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 5:35">Mat. 5:35</ref>.</char>
    </note>Amakesa amalanga, apasanaa mia i saangua alamu,</para>
  <para style="q2" vid="PSA 48:3">siitumo o gunu Sion i weta i napa,</para>
  <para style="q2" vid="PSA 48:3">kotana Raja Maoge!<verse eid="PSA 48:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 48:4"/>I nuncana manga bentena</para>
  <para style="q2" vid="PSA 48:4">Aulataʼala padhamo apatiumbaaka ande karona satotuuna o bente momakaa.<verse eid="PSA 48:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 48:5"/>Kamatea, manga raja aporomusaka,</para>
  <para style="q2" vid="PSA 48:5">manga incia amaju apobhawa-bhawa.<verse eid="PSA 48:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 48:6"/>Sakamatana kotana Sion, manga incia amente;</para>
  <para style="q2" vid="PSA 48:6">manga raja atokidha tee apalai roonamo amaeka.<verse eid="PSA 48:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 48:7"/>Iwe sumai manga incia arengku roonamo amaeka,</para>
  <para style="q2" vid="PSA 48:7">tee anamisi kapii mboomo bhawine bhemopalaahirina.<verse eid="PSA 48:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 48:8"/>Tee garura</para>
  <para style="q2" vid="PSA 48:8">Ingkoo upahancuru manga kapala maoge minaaka i Tarsis.<verse eid="PSA 48:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 48:9"/>Mboomo mopadhana irangota, mboo siitumo uka ikamatata,</para>
  <para style="q2" vid="PSA 48:9">i kotana KAWASANA OPUNA saangua alamu,</para>
  <para style="q1" vid="PSA 48:9">i kotana Aulataʼalata,</para>
  <para style="q2" vid="PSA 48:9">ipekatangkana Aulataʼala to saʼumurua. <char style="qs">Sela</char><verse eid="PSA 48:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 48:10"/>E Aulataʼala, ingkami taudhania o kaasimu molagina</para>
  <para style="q2" vid="PSA 48:10">i nuncana Baitullamu momangkilo.<verse eid="PSA 48:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 48:11"/>Mboomo saromu, e Aulataʼala,</para>
  <para style="q2" vid="PSA 48:11">mboo siitumo o mia i saangua alamu amuliangiko.</para>
  <para style="q2" vid="PSA 48:11">Ingkoo ukokuasa tee uʼadili.<verse eid="PSA 48:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 48:12"/>Taroakamo raʼeatina Sion akaunde-unde,</para>
  <para style="q2" vid="PSA 48:12">tee taroakamo manga anana bhawine Yuda asambo-sambo</para>
  <para style="q2" vid="PSA 48:12">roonamo sadia uʼadili i wakutuuna uhaakimu mia.<verse eid="PSA 48:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 48:13"/>Lingkamo uumatina Aulataʼala, tiingia o Sion, tee ubulilingia,</para>
  <para style="q2" vid="PSA 48:13">tee ugagaria manga munarana.<verse eid="PSA 48:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 48:14"/>Tilikia manga rindina,</para>
  <para style="q1" vid="PSA 48:14">kamatea o bentena,</para>
  <para style="q2" vid="PSA 48:14">mamudhaakana amembali upetulatulaakea i manga siwulumu.<verse eid="PSA 48:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 48:15"/>Satotuuna o siimo Aulataʼala, Aulataʼalata abakaa;</para>
  <para style="q2" vid="PSA 48:15">Incia bhemokapalaikina ingkita saʼumurua!<verse eid="PSA 48:15"/></para>
  <chapter eid="PSA 48"/>
  <chapter number="49" style="c" sid="PSA 49"/>
  <para style="s1">Kasanaa Mosia-sia</para>
  <para style="sr">
    <ref loc="PSA 49:1-21">49:1-21</ref></para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 49:1"/>To kapalana molaguna. Zaburuna miana Korah.<verse eid="PSA 49:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 49:2"/>Perangoia o giu incia sii, e bhari-bharia lipu,</para>
  <para style="q2" vid="PSA 49:2">taaia o talingamiu e bhari-bharia raʼeatina dunia,<verse eid="PSA 49:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 49:3"/>Malape o kaogesa atawa o mia maidhiidhi,</para>
  <para style="q2" vid="PSA 49:3">mia morangkaea atawa o mia misikini!<verse eid="PSA 49:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 49:4"/>Ngangaku bheabhoasaka manga pogau imembaliakamiu ubukeaka hikimati,</para>
  <para style="q2" vid="PSA 49:4">tee ngangarandaku bheafikiri manga giu imembaliakamiu umakidha umaʼanaia.<verse eid="PSA 49:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 49:5"/>Talingaku bhekubungkalea to kuperangoi manga kabhanti moʼaarifu,</para>
  <para style="q2" vid="PSA 49:5">poose kumagasiaaka kecapi, bhekubhoasakea maʼanana o taataangkeku.<verse eid="PSA 49:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 49:6"/>Iaku inda kufaraluu kumaeka i wakutuuna kaseke,</para>
  <para style="q2" vid="PSA 49:6">wakutuuna kadhakina musuku alibuaku.<verse eid="PSA 49:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 49:7"/>Manga incia mia motangkaakana harataana</para>
  <para style="q2" vid="PSA 49:7">tee mosomboakana karangkaeana.<verse eid="PSA 49:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 49:8"/>Satotuuna, inda samia uka momembalina mopasalaamatina karona samia,</para>
  <para style="q2" vid="PSA 49:8">atawa apomea katolosina i Aulataʼala to apamembalia kabholosina inyawana<verse eid="PSA 49:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 49:9"/>roonamo ponambona katolosina inyawana mia amaali mpuu,</para>
  <para style="q2" vid="PSA 49:9">tee inda bheakawa moomini apomeaia tee opeapo uka<verse eid="PSA 49:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 49:10"/>mamudhaakana incia amembali adhadhi saʼumurua</para>
  <para style="q2" vid="PSA 49:10">tee inda bheakamata bhalona koburuna.<verse eid="PSA 49:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 49:11"/>Maka satotuuna, incia bheakamata</para>
  <para style="q2" vid="PSA 49:11">mia moʼaarifu uka bheamate,</para>
  <para style="q1" vid="PSA 49:11">mboo sumai uka tee mia mokabhongo-bhongo tee mia mobhore;</para>
  <para style="q2" vid="PSA 49:11">manga incia bheabholi harataana to mia mosagaanana.<verse eid="PSA 49:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 49:12"/>Koburuna manga incia bheamembali bhanuana saʼumurua,</para>
  <para style="q2" vid="PSA 49:12">mbooresana manga incia asadhaadhaa to saʼumurua,</para>
  <para style="q2" vid="PSA 49:12">moomini manga incia dhaangia tee tanana karona.<verse eid="PSA 49:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 49:13"/>Maka o maanusia moomini tee karangkaeana inda bheamembali adhadhi torosu.</para>
  <para style="q2" vid="PSA 49:13">Maanusia apokana tee binata dhaanamo bheabinasa.<verse eid="PSA 49:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 49:14"/>Mboo siimo dhawuana mia motangkaakana karona,</para>
  <para style="q2" vid="PSA 49:14">tee ajalana manga mia momaasiakana pogauna karona. <char style="qs">Sela</char><note caller="+" style="f"><char style="fr" closed="false">49:14 </char><char style="fq" closed="false">Sela: </char><char style="ft" closed="false">Aipomo tandana to aunto wakutuuna lagu sumai atolaguaka, atawa o tanda to ahanda apekaogea o suarana, atawa onina gambusuna. Amembali uka to tanda to morangoa mamudhaakana asuju.</char></note><verse eid="PSA 49:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 49:15"/>Aulataʼala apatotapuaka manga incia to amate mboomo dumba,</para>
  <para style="q2" vid="PSA 49:15">manga incia awulua mboomo dumba apesua i bhalona koburu,</para>
  <para style="q2" vid="PSA 49:15">manga incia bheasapo lausaka i nuncana koburu.</para>
  <para style="q1" vid="PSA 49:15">Badana manga incia bheamabuto tee ahancuru,</para>
  <para style="q2" vid="PSA 49:15">amaridho minaaka i bhanuana.<verse eid="PSA 49:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 49:16"/>Maka o Aulataʼala bheatolosiaku</para>
  <para style="q2" vid="PSA 49:16">minaaka i duniana mia mate</para>
  <para style="q2" vid="PSA 49:16">roonamo Incia bheaalaaku minaaka iwe sumai. <char style="qs">Sela</char><verse eid="PSA 49:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 49:17"/>Bholi umaeka ande o mia mosagaanana amembali arangkaea,</para>
  <para style="q2" vid="PSA 49:17">tee o harataana ahandamo abhari,<verse eid="PSA 49:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 49:18"/>roonamo wakutuuna amate, incia inda amembali abhawa opeopeapo uka,</para>
  <para style="q2" vid="PSA 49:18">tee o harataana inda bheasapo i koburu to apobhawa tee incia.<verse eid="PSA 49:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 49:19"/>Moomini kangengena dhadhina incia aabhi karona atobarakati</para>
  <para style="q2" vid="PSA 49:19">tee apuji-pujia mia roonamo akodhawua,<verse eid="PSA 49:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 49:20"/>incia uka bheatutuni manga opu-opuana,</para>
  <para style="q2" vid="PSA 49:20">momatena porikana i tampa momalalanda</para>
  <para style="q2" vid="PSA 49:20">tee iwe sumai, indamo uka bheakamata kainawa pendua.<verse eid="PSA 49:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 49:21"/>Maanusia morangkaea, maka inda amembali amaʼanai hikimati,</para>
  <para style="q2" vid="PSA 49:21">amembali tapapokanea tee binata motopabinasa.<verse eid="PSA 49:21"/></para>
  <chapter eid="PSA 49"/>
  <chapter number="50" style="c" sid="PSA 50"/>
  <para style="s">Ibaadati Mobanara</para>
  <para style="sr">
    <ref loc="PSA 50:1-23">50:1-23</ref></para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 50:1"/>Zaburuna Asaf.<note caller="+" style="f"><char style="fr" closed="false">50:1 </char><char style="fq" closed="false">Asaf: </char><char style="ft" closed="false">Asaf sii apatugasiakea Nabii Daud to akapalai molaguna i nuncana ibaadati i Baitulla. Incia o miana Lewi mopakawaakana kasameana nabii i tambena kuasana Nabii Daud.</char></note></para>
  <para style="b" vid="PSA 50:1"/>
  <para style="q1" vid="PSA 50:1">KAWASANA OPU, Aulataʼala Mokokuasana Mpuu, afirimani</para>
  <para style="q2" vid="PSA 50:1">tee agoraaka saangua alamu minaaka i timbu sakawana i bhara.<verse eid="PSA 50:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 50:2"/>Minaaka i kota Sion momakesa mpuu,</para>
  <para style="q2" vid="PSA 50:2">Aulataʼala apatiumba karona mboomo cahea.<verse eid="PSA 50:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 50:3"/>Aulataʼalata aumba tee inda soo akatongo-tongo;</para>
  <para style="q2" vid="PSA 50:3">waa imangauaka dhaangia i aroana,</para>
  <para style="q2" vid="PSA 50:3">tee garura<note caller="+" style="f"><char style="fr" closed="false">50:3 </char><char style="fq" closed="false">garura: </char><char style="ft" closed="false">Wao maranca tee ngalu makaa mpuu apoose tee bhibhito.</char></note> momakaa dhaangia i saripina.<verse eid="PSA 50:3"/></para>
  <para style="q2">
    <verse number="4" style="v" sid="PSA 50:4"/>Incia agoraaka laiana tee alamu</para>
  <para style="q2" vid="PSA 50:4">to amembali sakusii wakutuuna aʼadili uumatina.<verse eid="PSA 50:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 50:5"/>Firimanina, "Romusakaakaaku bhari-bharia uumatiku mosaalihi i aroaku,</para>
  <para style="q2" vid="PSA 50:5">siitumo manga incia mopadhana mobokena pojanjia tee Iaku alaloi kurubani isumbele."<verse eid="PSA 50:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 50:6"/>Laiana apakoleleaka kabanarana,</para>
  <para style="q2" vid="PSA 50:6">roonamo o karona Aulataʼala moʼadilina uumatina. <char style="qs">Sela</char><verse eid="PSA 50:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 50:7"/>"Rangoa e uumatiku, Iaku bhekufirimani!</para>
  <para style="q2" vid="PSA 50:7">E Israel, Iaku bhekumembali sakusii tee opea mopadhana ipewaumu,</para>
  <para style="q2" vid="PSA 50:7">Iakumo o Kawasana Opu, Aulataʼalamu!<verse eid="PSA 50:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 50:8"/>Mencuana rampaakanamo kurubani isumbelemu mbakana kuraeakako,</para>
  <para style="q2" vid="PSA 50:8">atawa o kurubani tunuamu</para>
  <para style="q2" vid="PSA 50:8">modhaangiana i aroaku.<verse eid="PSA 50:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 50:9"/>Iaku kumendeu bhekutarima sapi umane minaaka i bhanuamu,</para>
  <para style="q2" vid="PSA 50:9">atawa o bhembe umane minaaka i kandamu,<verse eid="PSA 50:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 50:10"/>roonamo bhari-bharia binata maila i koo o pewauaku,</para>
  <para style="q2" vid="PSA 50:10">tee uka bhari-bharia manga kadhambaaka modhaangiana i rewuna gunu.<verse eid="PSA 50:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 50:11"/>Iaku kumataua bhari-bharia manu-manu modhaangiana i gunu,</para>
  <para style="q2" vid="PSA 50:11">tee manga mahaluku modhadhi i nuncana koo o pewauaku.<verse eid="PSA 50:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 50:12"/>Ande kumaara, inda afaraluu kupaumbaakako,</para>
  <para style="q2" vid="PSA 50:12">roonamo alamu tee bhari-bharia antona o pewauaku.<verse eid="PSA 50:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 50:13"/>Iaku inda kukande dagina sapi umane,</para>
  <para style="q2" vid="PSA 50:13">inda uka kusumpu raana bhembe umane.<verse eid="PSA 50:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 50:14"/>Sukurumo i Aulataʼala to amembali pasombaamu to Incia,</para>
  <para style="q2" vid="PSA 50:14">tee upomeaia o tolauna onimu i KAWASANA OPU.<verse eid="PSA 50:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 50:15"/>Goraakaaku i wakutuuna umaseke,</para>
  <para style="q1" vid="PSA 50:15">Iaku bhekutulungiko,</para>
  <para style="q2" vid="PSA 50:15">tee ingkoo bheumuliangiaku."<verse eid="PSA 50:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 50:16"/>Maka to mia madhaki o KAWASANA OPU afirimani,</para>
  <para style="q2" vid="PSA 50:16">"Inda tee faʼedana ingkoo usarongi hukumuku,</para>
  <para style="q2" vid="PSA 50:16">tee upogauaka manga pojanjiaku.<verse eid="PSA 50:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 50:17"/>Roonamo ingkoo umendeu utoudhaniaka,</para>
  <para style="q2" vid="PSA 50:17">tee inda umaheruakea uka manga firimaniku.<verse eid="PSA 50:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 50:18"/>Ande upokawa tee mia manako, ingkoo uposabhangkaakea,</para>
  <para style="q2" vid="PSA 50:18">tee manga pande zina, ingkoo upooseakea.<verse eid="PSA 50:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 50:19"/>Muncumu utaroakea abhoasaka manga pogau madhaki,</para>
  <para style="q2" vid="PSA 50:19">tee o dhelamu sadia apekagau.<verse eid="PSA 50:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 50:20"/>Ingkoo utorotorosu uraeaka tee upogauaka witinaimu karomu,</para>
  <para style="q2" vid="PSA 50:20">tee ufitanaaia.<verse eid="PSA 50:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 50:21"/>Mboo sumaimo ipewaumu, maka Iaku inda tee uuʼuuku,</para>
  <para style="q2" vid="PSA 50:21">jadi ufikiria ande Iaku sii kupokana tee ingkoo.</para>
  <para style="q1" vid="PSA 50:21">Maka sii-sii bhekuhukumuko,</para>
  <para style="q1" vid="PSA 50:21">tee kubhawea o parakara incia sii i aroamu mamudhaakana umaʼanaia.<verse eid="PSA 50:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 50:22"/>Kamatamea o giu incia sii, e ingkomiu momalinguakana Aulataʼala,</para>
  <para style="q2" vid="PSA 50:22">kojagamo ancosala Kupabinasakomiu tee inda dhaangia mopasalaamatikomiu.<verse eid="PSA 50:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 50:23"/>Incema mopasombaakana sukuru i Iaku mboomo kurubani,</para>
  <para style="q2" vid="PSA 50:23">inciamo amuliangiaku;</para>
  <para style="q1" vid="PSA 50:23">o mia modhadhina i nuncana kajujuru,</para>
  <para style="q2" vid="PSA 50:23">Aulataʼala bhekususuakea kasalaamati to incia."<verse eid="PSA 50:23"/></para>
  <chapter eid="PSA 50"/>
  <chapter number="51" style="c" sid="PSA 51"/>
  <para style="s1">Doʼa Emaniana Amponi</para>
  <para style="sr">
    <ref loc="PSA 51:1-21">51:1-21</ref></para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 51:1"/>To kapalana molaguna. Zaburuna Daud.<verse eid="PSA 51:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 51:2"/>
    <note caller="-" style="x">
      <char style="xo" closed="false">51:2 </char>
      <char style="xt" closed="false">
        <ref loc="2SA 12:1-15">2Sa. 12:1-15</ref>.</char>
    </note>I wakutuuna Nabii Natan audhaniaka Raja Daud sapadhana incia apewau zinaa tee Batsyeba.<note caller="+" style="f"><char style="fr" closed="false">51:2 </char><char style="fq" closed="false">Batsyeba: </char><char style="ft" closed="false">Bhawine sii amangada mpuu tee bhawinena samia suludaduna Daud mokosaroakana Uriah. Sapadhana Daud azina tee Batsyeba tee amataua ande incia abhawa-bhawa, Daud asampea tee antona mamudhaakana apekamate Uriah. Samatena Uriah, Daud akawi tee Batsyeba. Maka giu sumai amataua Nabii Natan. Kamatea </char><char style="xt"><ref loc="2SA 11:2-27">2Sa. 11:2-27</ref>.</char></note><verse eid="PSA 51:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 51:3"/>E Aulataʼala, maasiakaaku roonamo kaasimu molagina.</para>
  <para style="q2" vid="PSA 51:3">Apokana tee rahumatimu momaoge, hapusumea manga dosaku!<verse eid="PSA 51:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 51:4"/>Bhanuia tee pekangkiloa karoku minaaka i kasalahaku,</para>
  <para style="q2" vid="PSA 51:4">tee pekangkiloaku minaaka i dosaku.<verse eid="PSA 51:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 51:5"/>Roonamo kumataua manga kasalahaku,</para>
  <para style="q2" vid="PSA 51:5">tee dosaku sadia kuudhania.<verse eid="PSA 51:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 51:6"/>
    <note caller="-" style="x">
      <char style="xo" closed="false">51:6 </char>
      <char style="xt" closed="false">
        <ref loc="ROM 3:4">Rom. 3:4</ref>.</char>
    </note>I Ingkoo, tangkanamo i Ingkoo kukodosa</para>
  <para style="q2" vid="PSA 51:6">tee kupewau opea iabhimu amadhaki.</para>
  <para style="q1" vid="PSA 51:6">Sabutuna ubanara i wakutuuna ufirimani ande kusala,</para>
  <para style="q2" vid="PSA 51:6">tee uʼadili i wakutuuna uhukumuaku.<verse eid="PSA 51:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 51:7"/>Satotuuna, kumadhaki pepuu mina kutopalaahiri,</para>
  <para style="q2" vid="PSA 51:7">tee kukodosa minaaka i nuncana kadhuma.<verse eid="PSA 51:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 51:8"/>Satotuuna, Ingkoo upeelu kabanara i nuncana baatini,</para>
  <para style="q2" vid="PSA 51:8">tee Ingkoo uadhariakaaku hikimati i nuncana ngangarandaku.<verse eid="PSA 51:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 51:9"/>Pekangkilomea o dosaku, sumaimo iaku bhekumangkilo,</para>
  <para style="q2" vid="PSA 51:9">pekangkiloaku sumaimo bhekumembali maputi mpuu.<verse eid="PSA 51:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 51:10"/>Taroakamo kurango lele kaunde-unde tee kasanaa,</para>
  <para style="q2" vid="PSA 51:10">tee taroakamo manga bukuku ipahancurumu sii akaunde-unde pendua.<verse eid="PSA 51:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 51:11"/>Tutubhia o roumu tee bholi ukamata manga giu madhaki ipewauku,</para>
  <para style="q2" vid="PSA 51:11">tee uhapusumea bhari-bharia kasalahaku.<verse eid="PSA 51:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 51:12"/>E Aulataʼala, padhaangiakaaku ngangaranda momangkilo,</para>
  <para style="q2" vid="PSA 51:12">dhikaia o rohi mobhaau tee matangka i nuncana baatiniku.<verse eid="PSA 51:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 51:13"/>Bholi ubhanakaaku minaaka i aroamu,</para>
  <para style="q2" vid="PSA 51:13">tee bholi ualea o rohimu momangkilona.<verse eid="PSA 51:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 51:14"/>Paunde-undeaku pendua roonamo kasalaamati minaaka i Ingkoo,</para>
  <para style="q2" vid="PSA 51:14">tee dhawuaku ngangaranda morela to kutaʼati i Ingkoo.<verse eid="PSA 51:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 51:15"/>Sumaimo, iaku bhekuadhariaka parintamu i manga mia mopewauna kasalaha,</para>
  <para style="q2" vid="PSA 51:15">tee manga mia mokodosa bheambuli i Ingkoo.<verse eid="PSA 51:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 51:16"/>Rambasakaaku minaaka i kasalaha roonamo kupekamate mia sagaanana, e Kawasana Opu,</para>
  <para style="q2" vid="PSA 51:16">e Aulataʼala mopasalaamatiaku,</para>
  <para style="q2" vid="PSA 51:16">tee bhekulaguaka roonamo kabanaramu.<verse eid="PSA 51:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 51:17"/>E Aulataʼala, papogauaku,</para>
  <para style="q2" vid="PSA 51:17">sumaimo iaku bhekupujiko!<verse eid="PSA 51:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 51:18"/>Sumaimo Ingkoo inda upeelua kurubani isumbele.</para>
  <para style="q2" vid="PSA 51:18">Moomini iaku kupasombaaka kurubani tunua, Ingkoo inda upeelua.<verse eid="PSA 51:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 51:19"/>Satotuuna kurubani mopasanaana Aulataʼala sumai o rohi mohancuru.</para>
  <para style="q2" vid="PSA 51:19">E Aulataʼala, ngangaranda mohancuru tee momapuro inda bheuhinaia.<verse eid="PSA 51:19"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 51:20"/>Maasangia Ingkoo usanaa pewau malape i Sion,</para>
  <para style="q2" vid="PSA 51:20">pakakaroa pendua rindina peulusa i sakaaratea kotana Yerusalem.<verse eid="PSA 51:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 51:21"/>Sumaimo, bheupeelu utarimaia manga kurubani isumbele molaenga,</para>
  <para style="q2" vid="PSA 51:21">siitumo kurubani pasombaa itunu tee kurubani pasombaa mototunu saangua,</para>
  <para style="q2" vid="PSA 51:21">sumaimo mia bheapasombaaka manga sapi umane i bhawona tampana tunuana kurubanimu.<verse eid="PSA 51:21"/></para>
  <chapter eid="PSA 51"/>
  <chapter number="52" style="c" sid="PSA 52"/>
  <para style="s1">Kahukumuna to Mia Madhaki</para>
  <para style="sr">
    <ref loc="PSA 52:1-11">52:1-11</ref></para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 52:1"/>To kapalana molaguna.</para>
  <para style="q1" vid="PSA 52:1">Lagu kaadharina Daud,<verse eid="PSA 52:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 52:2"/>
    <note caller="-" style="x">
      <char style="xo" closed="false">52:2 </char>
      <char style="xt" closed="false">
        <ref loc="1SA 22:9-10">1Sa. 22:9-10</ref>.</char>
    </note>wakutuuna Doʼeg, miana Edom sumai, aumba apokawa tee Saul tee apaumbaaka ande o Daud akawamo i bhanuana Abimelekh.<verse eid="PSA 52:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 52:3"/>E mia mobarani, pokia ingkoo usomboaka kadhakimiu?</para>
  <para style="q2" vid="PSA 52:3">Kaasina Kawasana Opu sadhaadhaana to saʼumurua!<verse eid="PSA 52:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 52:4"/>Saeo ingkoo uhaejati to upanarakaa mia sagaanana.</para>
  <para style="q2" vid="PSA 52:4">Pogaumu amatadha mboomo piso motowinto,</para>
  <para style="q2" vid="PSA 52:4">e mia pande pekagau!<verse eid="PSA 52:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 52:5"/>Ingkoo ulabhi upeelu momadhakina tee inda upeelu momalapena,</para>
  <para style="q2" vid="PSA 52:5">labhi upeelu kagau-gau minaaka i upogauaka kabanara. <char style="qs">Sela</char><verse eid="PSA 52:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 52:6"/>Ingkoo usanaa upekapii incana mia tee manga pogaumu,</para>
  <para style="q2" vid="PSA 52:6">e pande pekagau!<verse eid="PSA 52:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 52:7"/>Maka o Aulataʼala bheapahancuruko to saʼumurua.</para>
  <para style="q2" vid="PSA 52:7">Incia bheasoroko tee apalimbako minaaka i mbooresamu,</para>
  <para style="q2" vid="PSA 52:7">tee adhikako i nuncana duniana mia mate. <char style="qs">Sela</char><verse eid="PSA 52:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 52:8"/>Akamata incia sumai, mia mobanara bheamaeka tee amente,</para>
  <para style="q2" vid="PSA 52:8">kasiimpo apotawaikiko,<verse eid="PSA 52:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 52:9"/>Manga incia apogau, "Siitumo mia moindana moemanina peulusa i Kawasana Opu,</para>
  <para style="q2" vid="PSA 52:9">tabeana soo atangkaaka karangkaeana motaralabhi-labhi,</para>
  <para style="q2" vid="PSA 52:9">tee apahancuru mia mosagaanana to apekatangka karona."<verse eid="PSA 52:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 52:10"/>Maka, iaku sii mboomo puuna zaitun mosuburu</para>
  <para style="q2" vid="PSA 52:10">i nuncana bhanuana Aulataʼala.</para>
  <para style="q1" vid="PSA 52:10">Iaku kuparacaea tee kaasina molagina Aulataʼala</para>
  <para style="q2" vid="PSA 52:10">to saʼumurua.<verse eid="PSA 52:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 52:11"/>Iaku sadiamo kusukuru i Ingkoo saʼumurua</para>
  <para style="q2" vid="PSA 52:11">rampaakanamo opea ipewaumu.</para>
  <para style="q1" vid="PSA 52:11">Iaku bhekuharapu i saromu i aroana manga mia mosaalihi</para>
  <para style="q2" vid="PSA 52:11">sababuna saromu amalape.<verse eid="PSA 52:11"/></para>
  <chapter eid="PSA 52"/>
  <chapter number="53" style="c" sid="PSA 53"/>
  <para style="s1">
    <note caller="-" style="x">
      <char style="xo" closed="false">53:1 </char>
      <char style="xt" closed="false">
        <ref loc="PSA 14:1-7">14:1-7</ref>.</char>
    </note>Kadhakina Maanusia Inda Moparacaeana Kawasana Opu</para>
  <para style="sr">
    <ref loc="PSA 53:1-7">53:1-7</ref></para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 53:1"/>To kapalana molaguna.</para>
  <para style="q1" vid="PSA 53:1">Mboomo laguna kanarakaa. Lagu kaadharina Daud.<note caller="+" style="f"><char style="fr" closed="false">53:1 </char><char style="ft" closed="false">Zaburu incia sii apokana tee Zaburu 14, somanamo dhaangia tee posalana.</char></note><verse eid="PSA 53:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 53:2"/>
    <note caller="-" style="x">
      <char style="xo" closed="false">53:2-4 </char>
      <char style="xt" closed="false">
        <ref loc="ROM 3:10-12">Rom. 3:10-12</ref>.</char>
    </note>
    <note caller="-" style="x">
      <char style="xo" closed="false">53:2-7 </char>
      <char style="xt" closed="false">
        <ref loc="PSA 14">Zab. 14</ref>.</char>
    </note>Mia mokabhongo-bhongo apogau i nuncana ngangarandana,</para>
  <para style="q2" vid="PSA 53:2">"Inda dhaangia o Aulataʼala."</para>
  <para style="q1" vid="PSA 53:2">Pewauna manga incia amadhaki tee atomarika,</para>
  <para style="q2" vid="PSA 53:2">inda dhaangia mopewauna kalape.<verse eid="PSA 53:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 53:3"/>Minaaka i sorogaa, Aulataʼala</para>
  <para style="q2" vid="PSA 53:3">atonto anana maanusia,</para>
  <para style="q1" vid="PSA 53:3">to akamata ara dhaangia o mia moʼaarifu,</para>
  <para style="q2" vid="PSA 53:3">mopeelona Aulataʼala.<verse eid="PSA 53:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 53:4"/>Bhari-bharia mia abholi dhala mobanara tee akarajaa giu momadhaki.</para>
  <para style="q2" vid="PSA 53:4">Inda dhaangia mopewauna kalape,</para>
  <para style="q2" vid="PSA 53:4">moomini samia uka.<verse eid="PSA 53:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 53:5"/>Firimanina Aulataʼala, "Buaka apesua i akala, ande manga mia mopewauna kadhaki inda amatau giu momalape?</para>
  <para style="q2" vid="PSA 53:5">Manga incia apekaoge karona tee akande uumatiku mboomo akande roti,</para>
  <para style="q2" vid="PSA 53:5">tee inda adoʼa i Iaku."<verse eid="PSA 53:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 53:6"/>Maka iwe sumai manga incia bheamaeka mpuu,</para>
  <para style="q2" vid="PSA 53:6">garaaka inda dhaangia o giu imaeka!</para>
  <para style="q1" vid="PSA 53:6">Sababuna Aulataʼala apekantale bukuna manga mia moewangiko.</para>
  <para style="q2" vid="PSA 53:6">Ingkoo bheupekatalo tee upekaea manga incia, sababuna o Aulataʼala amendeu manga incia.<verse eid="PSA 53:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 53:7"/>Maasangia o kasalaamati to miana Israel aumba minaaka i Sion, kotana Aulataʼala!</para>
  <para style="q2" vid="PSA 53:7">Wakutuuna Aulataʼala apambuli kadhaangiana uumatina,</para>
  <para style="q2" vid="PSA 53:7">siwuluna Yakub bheamasanaa o namisina tee o miana Israel bheakaunde-unde.<verse eid="PSA 53:7"/></para>
  <chapter eid="PSA 53"/>
  <chapter number="54" style="c" sid="PSA 54"/>
  <para style="s1">Doʼa Emaniana Peulusa</para>
  <para style="sr">
    <ref loc="PSA 54:1-9">54:1-9</ref></para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 54:1"/>To kapalana molaguna.</para>
  <para style="q1" vid="PSA 54:1">Tee kagasiana kecapi. Lagu kaadharina Daud<verse eid="PSA 54:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 54:2"/>
    <note caller="-" style="x">
      <char style="xo" closed="false">54:2 </char>
      <char style="xt" closed="false">
        <ref loc="1SA 23:19">1Sa. 23:19</ref>; <ref loc="1SA 26:1">26:1</ref>.</char>
    </note>wakutuuna miana Zifi aumba apogauaka i Raja Saul, "Daud apeopo i ingkami."<verse eid="PSA 54:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 54:3"/>E Aulataʼala pasalaamatiaku roonamo saromu,</para>
  <para style="q2" vid="PSA 54:3">tee adilia parakaraku roonamo kakaamu.<verse eid="PSA 54:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 54:4"/>Maasangia urangoa doʼaku, e Aulataʼala,</para>
  <para style="q2" vid="PSA 54:4">rangoa manga pogau ibhoasakaku.<verse eid="PSA 54:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 54:5"/>Manga mia momalangana incana akakaro aewangiaku,</para>
  <para style="q2" vid="PSA 54:5">tee manga mia mosombo gauna bheaala inyawaku.</para>
  <para style="q2" vid="PSA 54:5">Manga incia inda afaduliaka Aulataʼala. <char style="qs">Sela</char><verse eid="PSA 54:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 54:6"/>Satotuuna Aulataʼala motulungiaku,</para>
  <para style="q2" vid="PSA 54:6">Kawasana Opu modhambaakaaku.<verse eid="PSA 54:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 54:7"/>Taroakamo kadhaki ambuli akangkanai manga musuku.</para>
  <para style="q2" vid="PSA 54:7">Roonamo kaasimu molagina, pabinasamea manga incia!<verse eid="PSA 54:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 54:8"/>Tee relana totona incaku, iaku bhekupasombaaka kurubani to Ingkoo.</para>
  <para style="q2" vid="PSA 54:8">Iaku bhekusukuru tee Ingkoo, e KAWASANA OPU, roonamo saromu amalape.<verse eid="PSA 54:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 54:9"/>Roonamo Ingkoo padhamo urambasakaaku minaaka i sagala kanarakaa,</para>
  <para style="q2" vid="PSA 54:9">sabutuna kukamata musuku amatalo.<verse eid="PSA 54:9"/></para>
  <chapter eid="PSA 54"/>
  <chapter number="55" style="c" sid="PSA 55"/>
  <para style="s">Doʼa Emani Peulusa minaaka i Kahandana Musu</para>
  <para style="sr">
    <ref loc="PSA 55:1-24">55:1-24</ref></para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 55:1"/>To kapalana molaguna.</para>
  <para style="q1" vid="PSA 55:1">Tee kagasiana kecapi. Lagu kaadharina Daud.<verse eid="PSA 55:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 55:2"/>E Aulataʼala, perangoia o doʼaku,</para>
  <para style="q2" vid="PSA 55:2">tee bholi inda ufaduliakea giu iemaniku.<verse eid="PSA 55:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 55:3"/>Kamataaku tee tulungiaku!</para>
  <para style="q2" vid="PSA 55:3">Kulilaho tee kupekidhei<verse eid="PSA 55:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 55:4"/>roonamo kahandana musu</para>
  <para style="q2" vid="PSA 55:4">tee roonamo kapisakina mia madhaki.</para>
  <para style="q1" vid="PSA 55:4">Manga incia apanarakaaku,</para>
  <para style="q2" vid="PSA 55:4">manga incia aʼamaraikiaku tee abanciaku.<verse eid="PSA 55:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 55:5"/>Ngangarandaku abagoea,</para>
  <para style="q2" vid="PSA 55:5">kamingkirina mate aoseaku.<verse eid="PSA 55:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 55:6"/>Iaku kurengku tee kumaeka mpuu,</para>
  <para style="q2" vid="PSA 55:6">kamingkiri akuasaiaku.<verse eid="PSA 55:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 55:7"/>Iaku kupogau, "Ande kukopani mboomo manu-manu jarajara!</para>
  <para style="q2" vid="PSA 55:7">Iaku bhekupolaka tee kupeelo tampa momalino.<verse eid="PSA 55:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 55:8"/>Umbe, iaku bhekulingka maridho mpuu,</para>
  <para style="q2" vid="PSA 55:8">tee kumboore i tana matuu. <char style="qs">Sela</char><verse eid="PSA 55:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 55:9"/>Iaku bhekupekadhei kupeelo tampa peulusaku</para>
  <para style="q2" vid="PSA 55:9">minaaka i ngalu makaa tee garura."<verse eid="PSA 55:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 55:10"/>E Kawasana Opu, upabingumea manga musuku tee upapogeso-gesomea pogauna,</para>
  <para style="q2" vid="PSA 55:10">roonamo kukamata mia apewau kasega tee apogera i nuncana kota.<verse eid="PSA 55:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 55:11"/>Malo eona manga incia apekatii-tii i bhawona rindina bente motiingina kota,</para>
  <para style="q2" vid="PSA 55:11">tee i nuncana kota apewau kadhaki tee apanarakaa mia.<verse eid="PSA 55:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 55:12"/>Manga incia apabinasa mia i tanga-tangana kota,</para>
  <para style="q2" vid="PSA 55:12">i dhaoa manga incia sadhaadhaa apekapisaki tee apekatipu.<verse eid="PSA 55:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 55:13"/>Ande o musuku abanciaku,</para>
  <para style="q2" vid="PSA 55:13">amembali kukapoia,</para>
  <para style="q1" vid="PSA 55:13">ande o bhaliku ahinaaku</para>
  <para style="q2" vid="PSA 55:13">amembali kupekaridho.<verse eid="PSA 55:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 55:14"/>Maka ingkoo mboomo samia witinaiku!</para>
  <para style="q2" vid="PSA 55:14">Sabhangkaku! Sampomatauku malape!<verse eid="PSA 55:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 55:15"/>I piamo itu ingkita taposabhangka malape,</para>
  <para style="q2" vid="PSA 55:15">tee tapobhawa-bhawa talingka i bhanuana Aulataʼala i tanga-tangana mia bhari!<verse eid="PSA 55:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 55:16"/>Taroakamo manga musuku amate inda atomatau,</para>
  <para style="q2" vid="PSA 55:16">tee asapo akadhadhi-dhadhi i duniana mia mate,</para>
  <para style="q2" vid="PSA 55:16">roonamo kadhaki dhaangia i mbooresana tee i tanga-tangana manga incia.<verse eid="PSA 55:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 55:17"/>Maka iaku bhekugora i Aulataʼala,</para>
  <para style="q2" vid="PSA 55:17">tee KAWASANA OPU bheapasalaamatiaku.<verse eid="PSA 55:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 55:18"/>Wakutuuna konowia, saeona, tee pontanga eo,</para>
  <para style="q2" vid="PSA 55:18">kupeenci tee kupekidhei,</para>
  <para style="q2" vid="PSA 55:18">tee Incia uka bhearango suaraku.<verse eid="PSA 55:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 55:19"/>Incia bheatolosiaku</para>
  <para style="q2" vid="PSA 55:19">minaaka i musu mobhaliaku,</para>
  <para style="q2" vid="PSA 55:19">roonamo abhari mia moewangiaku.<verse eid="PSA 55:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 55:20"/>Aulataʼala, mokokauncuramakana pepuu i zamani i piamo itu,</para>
  <para style="q2" vid="PSA 55:20">bhearangoa doʼaku tee apekatalo manga incia,</para>
  <para style="q1" vid="PSA 55:20">roonamo manga incia amendeu atoba</para>
  <para style="q2" vid="PSA 55:20">tee inda amaeka i Aulataʼala. <char style="qs">Sela</char><verse eid="PSA 55:20"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 55:21"/>Mia mopadhana kuabhia witinaiku incia sumai apacilaka sabhangkana,</para>
  <para style="q2" vid="PSA 55:21">tee incia inda akeniakea janjina.<verse eid="PSA 55:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 55:22"/>Bhoasakana amaʼalusu mpuu to aala-ala inca,</para>
  <para style="q2" vid="PSA 55:22">maka neatina to apacilaka mia.</para>
  <para style="q1" vid="PSA 55:22">Pogauna amararo alabhi minaaka i mina,</para>
  <para style="q2" vid="PSA 55:22">maka satotuuna bhari-bharia sumai mboomo ewanga momatadha.<verse eid="PSA 55:22"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 55:23"/>Pasarakaakamea o bhawamu i KAWASANA OPU,</para>
  <para style="q2" vid="PSA 55:23">sumaimo Incia bheadhambaakako,</para>
  <para style="q2" vid="PSA 55:23">tee inda bheataroaka mia mobanara abagoea saʼumurua.<verse eid="PSA 55:23"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 55:24"/>Maka Ingkoo, e Aulataʼala, bheupapesua manga incia</para>
  <para style="q2" vid="PSA 55:24">i nuncana kabhalongko momandalana mpuu.</para>
  <para style="q1" vid="PSA 55:24">Manga pande pekamate tee pande pekagau</para>
  <para style="q2" vid="PSA 55:24">inda bheakawa samuntanga umuruna.</para>
  <para style="q1" vid="PSA 55:24">Maka, iaku kuparacaea i Ingkoo.<verse eid="PSA 55:24"/></para>
  <chapter eid="PSA 55"/>
  <chapter number="56" style="c" sid="PSA 56"/>
  <para style="s1">I Nuncana Kanarakaa, Taharapu i Aulataʼala</para>
  <para style="sr">
    <ref loc="PSA 56:1-14">56:1-14</ref></para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 56:1"/>
    <note caller="-" style="x">
      <char style="xo" closed="false">56:1 </char>
      <char style="xt" closed="false">
        <ref loc="1SA 21:12">1Sa. 21:12</ref>.</char>
    </note>To kapalana molaguna.</para>
  <para style="q1" vid="PSA 56:1">Mboomo lagu: Manu-manu jarajara mopopoteona i puuna kau tarbantin<note caller="+" style="f"><char style="fr" closed="false">56:1 </char><char style="fq" closed="false">tarbantin: </char><char style="ft" closed="false">Sagiu puuna kau maoge tee rahana abhari mboomo puuna kau wuraha. </char></note> momaridho. Zaburuna Daud wakutuuna miana Filistin arako incia i Gat.<verse eid="PSA 56:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 56:2"/>E Kawasana Opu, maasiakaaku roonamo manga mia alanda-landakiaku</para>
  <para style="q2" vid="PSA 56:2">tee saeoa apisakiaku.<verse eid="PSA 56:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 56:3"/>Manga musuku sadia alanda-landakiaku,</para>
  <para style="q2" vid="PSA 56:3">abhari mia moewangiaku, e Aulataʼala Momalanga!<verse eid="PSA 56:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 56:4"/>I wakutuuna kumaeka,</para>
  <para style="q2" vid="PSA 56:4">kuparacaea i Ingkoo.<verse eid="PSA 56:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 56:5"/>Iaku kupuji firimanina Aulataʼala,</para>
  <para style="q2" vid="PSA 56:5">tee kuparacaea i Aulataʼala, siitumo inda bhekumaeka.</para>
  <para style="q2" vid="PSA 56:5">Opea momembalina ipewauna maanusia to iaku? Inda dhaangia!<verse eid="PSA 56:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 56:6"/>Saeoa musuku apatiipambuli pogauku,</para>
  <para style="q2" vid="PSA 56:6">bhari-bharia haejatina manga incia to iaku amadhaki.<verse eid="PSA 56:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 56:7"/>Manga incia aporomusaka tee apeopo,</para>
  <para style="q2" vid="PSA 56:7">alukuti bhengkalaku,</para>
  <para style="q2" vid="PSA 56:7">tee ahaejati apekamateaku.<verse eid="PSA 56:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 56:8"/>Balasia manga incia to kadhakina ipewauna;</para>
  <para style="q2" vid="PSA 56:8">e Kawasana Opu, patobhatamea manga lipu tee amaramu!<verse eid="PSA 56:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 56:9"/>Ingkoo umataua saopea kabharina kanarakaaku,</para>
  <para style="q2" vid="PSA 56:9">Udhika loluku i nuncana butolomu.</para>
  <para style="q2" vid="PSA 56:9">Buaka bhari-bharia dhaangia i nuncana kitabimu?<verse eid="PSA 56:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 56:10"/>Sumaimo manga musuku bheasowo</para>
  <para style="q2" vid="PSA 56:10">i wakutuuna kugora.</para>
  <para style="q1" vid="PSA 56:10">Tee mboo sumai, kumataua</para>
  <para style="q2" vid="PSA 56:10">ande Aulataʼala aewaakaaku.<verse eid="PSA 56:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 56:11"/>Iaku kupogauaka kalape to KAWASANA OPU tee kupuji firimanina,</para>
  <para style="q2" vid="PSA 56:11">roonamo Aulataʼala adhawu janji momalape.<verse eid="PSA 56:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 56:12"/>Iaku kuparacaea i Incia, siitumo iaku inda bhekumaeka.</para>
  <para style="q2" vid="PSA 56:12">Opea momembalina ipewauna maanusia to iaku?<verse eid="PSA 56:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 56:13"/>E Aulataʼala, kuwaajibu bhekupewaua tolauna oniku tee Ingkoo,</para>
  <para style="q2" vid="PSA 56:13">bhekupasombaaka kurubani kasukuru i Ingkoo.<verse eid="PSA 56:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 56:14"/>Sababuna Ingkoo upasalaamatiaku minaaka i mate,</para>
  <para style="q2" vid="PSA 56:14">tee ujaganiaku sabutuna inda kutosunu.</para>
  <para style="q1" vid="PSA 56:14">Tee mboo sumai, iaku kumembali kulingka i aroana Aulataʼala</para>
  <para style="q2" vid="PSA 56:14">i nuncana kainawana dhadhi.<verse eid="PSA 56:14"/></para>
  <chapter eid="PSA 56"/>
  <chapter number="57" style="c" sid="PSA 57"/>
  <para style="s1">Apajerea Musu, maka Atulungia Kawasana Opu</para>
  <para style="sr">
    <ref loc="PSA 57:1-12">57:1-12</ref></para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 57:1"/>
    <note caller="-" style="x">
      <char style="xo" closed="false">57:1 </char>
      <char style="xt" closed="false">
        <ref loc="1SA 22:1">1Sa. 22:1</ref>; <ref loc="1SA 24:3">24:3</ref>.</char>
    </note>To kapalana molaguna.</para>
  <para style="q1" vid="PSA 57:1">Mboomo lagu: Bholi upahancuru. Zaburuna Daud, wakutuuna incia apalaiaka Saul tee aopo i nuncana lia.<verse eid="PSA 57:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 57:2"/>Maasiakaaku, e Aulataʼala, maasiakaaku,</para>
  <para style="q2" vid="PSA 57:2">roonamo i Ingkoomo kupeulu.</para>
  <para style="q1" vid="PSA 57:2">I tambena panimu iaku kupeulu,</para>
  <para style="q2" vid="PSA 57:2">sakawana garura sumai aunto.<verse eid="PSA 57:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 57:3"/>Iaku kudoʼa kuemani tulungi i Aulataʼala Momalanga,</para>
  <para style="q2" vid="PSA 57:3">Aulataʼala apamondo ihaejatiakana to dhadhiku.<verse eid="PSA 57:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 57:4"/>Maasangia Incia bhealawaniaku minaaka i sorogaa tee apasalaamatiaku,</para>
  <para style="q2" vid="PSA 57:4">Incia bheapaʼaebu manga mia molanda-landakiaku. <char style="qs">Sela</char></para>
  <para style="q1" vid="PSA 57:4">Aulataʼala alamboko kaasina molagina tee inda bheamabhotu janjina tee iaku saʼumurua.<verse eid="PSA 57:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 57:5"/>Iaku kudhaangia i tanga-tangana musu,</para>
  <para style="q2" vid="PSA 57:5">manga incia mboomo singa mobhembaruna maanusia.</para>
  <para style="q1" vid="PSA 57:5">Ngincina amatadha mboomo pandanga tee anana pana,</para>
  <para style="q2" vid="PSA 57:5">tee dhelana mboomo ewanga momatadha.<verse eid="PSA 57:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 57:6"/>E Aulataʼala, susuakea kaogesamu i laiana</para>
  <para style="q2" vid="PSA 57:6">tee kamuliangimu i saangua alamu.<verse eid="PSA 57:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 57:7"/>Manga musuku ataa katapu to iaku,</para>
  <para style="q2" vid="PSA 57:7">sakawana amate akalaku.</para>
  <para style="q1" vid="PSA 57:7">Manga incia aseli kabhalongko i aroaku to apacilakaaku,</para>
  <para style="q2" vid="PSA 57:7">maka o karona manga mokotibuna. <char style="qs">Sela</char><verse eid="PSA 57:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 57:8"/>
    <note caller="-" style="x">
      <char style="xo" closed="false">57:8-12 </char>
      <char style="xt" closed="false">
        <ref loc="PSA 108:2-6">Zab. 108:2-6</ref>.</char>
    </note>Ngangarandaku amatangka, e Aulataʼala, ngangarandaku amatangka.</para>
  <para style="q2" vid="PSA 57:8">Gauku bhekulaguaka lagu kapujia to Ingkoo.<verse eid="PSA 57:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 57:9"/>Iaku bhekubhangu</para>
  <para style="q2" vid="PSA 57:9">tee kumagasiaaka gambusu tee kecapi!</para>
  <para style="q2" vid="PSA 57:9">Iaku bhekubhangu raneeooge!<verse eid="PSA 57:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 57:10"/>Iaku bhekusukuru i Ingkoo i tanga-tangana manga lipu, e Kawasana Opu,</para>
  <para style="q2" vid="PSA 57:10">tee kulaguaka manga lagu kapujia.<verse eid="PSA 57:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 57:11"/>Sababuna kaasimu molagina amaoge akawa i laiana,</para>
  <para style="q2" vid="PSA 57:11">tee kabanaramu akawa i taʼina ngalu.<verse eid="PSA 57:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 57:12"/>E Aulataʼala, susuakea kaogesamu i laiana,</para>
  <para style="q2" vid="PSA 57:12">tee kamuliangimu i saangua alamu.<verse eid="PSA 57:12"/></para>
  <chapter eid="PSA 57"/>
  <chapter number="58" style="c" sid="PSA 58"/>
  <para style="s1">Doʼa Emaniana Kabalasina to Mia Madhaki</para>
  <para style="sr">
    <ref loc="PSA 58:1-12">58:1-12</ref></para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 58:1"/>To kapalana molaguna.</para>
  <para style="q1" vid="PSA 58:1">Mboomo lagu: Bholi upahancuru. Zaburuna Daud.<verse eid="PSA 58:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 58:2"/>E manga mia mokokuasa,<note caller="+" style="f"><char style="fr" closed="false">58:2 </char><char style="fq" closed="false">mia mokokuasa: </char><char style="ft" closed="false">I nuncana pogau Ibrani, oni </char><char style="it">elim</char> dhaangia maʼana 'mokokuasa' atawa 'opu' atawa 'dewa.'</note> atotuu buaka udhawu kambotu mobanara?</para>
  <para style="q2" vid="PSA 58:2">Buaka ujujuru i wakutuuna uʼadili maanusia?<verse eid="PSA 58:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 58:3"/>Inda, uhaejatiaka momadhakina i nuncana ngangarandamiu,</para>
  <para style="q2" vid="PSA 58:3">tee upewau kasega tee limamiu i bhawona alamu.<verse eid="PSA 58:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 58:4"/>Mia madhaki asaladhala pepuu minaaka alaahiri,</para>
  <para style="q2" vid="PSA 58:4">tee agau-gau minaaka i nuncana kadhuma.<verse eid="PSA 58:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 58:5"/>Manga incia mboomo ulo mokobisa</para>
  <para style="q2" vid="PSA 58:5">tee mboomo ulo momabhongo momendeuna morango<verse eid="PSA 58:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 58:6"/>sabutuna inda arango suarana pande parikana ulo,<note caller="+" style="f"><char style="fr" closed="false">58:6 </char><char style="fq" closed="false">pande parikana ulo: </char><char style="ft" closed="false">Mia motowiina suli mamudhaakana ulo maila amembali ulo manea tee inda apapaki mia.</char></note></para>
  <para style="q2" vid="PSA 58:6">moomini suarana pande baca doʼa moʼahalii.<verse eid="PSA 58:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 58:7"/>E Aulataʼala, upahancurumea o ngincina i nuncana ngangana.</para>
  <para style="q2" vid="PSA 58:7">Hobutimea nginci mantoana manga singa mangura, e KAWASANA OPU!<verse eid="PSA 58:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 58:8"/>Taroakamo manga incia aila mboomo uwe motobusaka kasiimpo indamo atokamata.</para>
  <para style="q2" vid="PSA 58:8">Wakutuuna manga incia ahela panana, o panana manga amembalimo amakundu.<verse eid="PSA 58:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 58:9"/>Taroakamo manga incia mboomo bhiku morere amembali nggalanggala,</para>
  <para style="q2" vid="PSA 58:9">mboomo rahasia momatena i nuncana kadhuma tee indapo akamata matana eo.<verse eid="PSA 58:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 58:10"/>Indapo asadaria, manga incia abinasamo,</para>
  <para style="q2" vid="PSA 58:10">ibaratina mboomo rumpu mokorui momaijo tee indapo amaoge,</para>
  <para style="q2" vid="PSA 58:10">maka aporikanamo atowiia ngalu tee apolakaakea mboomo penembulana momalau.</para>
  <para style="q1" vid="PSA 58:10">Amarana Kawasana Opu bheakangkanaia</para>
  <para style="q2" vid="PSA 58:10">i wakutuuna manga incia dhaangiapo adhadhi.<verse eid="PSA 58:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 58:11"/>Mia mobanara bheakaunde-unde wakutuuna manga incia akamata kabalasina to mia madhaki,</para>
  <para style="q2" vid="PSA 58:11">tee abhanui aena tee raana manga incia.<verse eid="PSA 58:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 58:12"/>Mia bheapogau, "Totuu dhaangia fahala to mia mobanara!</para>
  <para style="q2" vid="PSA 58:12">Satotuuna, Aulataʼala modhawuna kaʼadili i alamu!"<verse eid="PSA 58:12"/></para>
  <chapter eid="PSA 58"/>
  <chapter number="59" style="c" sid="PSA 59"/>
  <para style="s">Doʼa Emaniana Mamudhaakana Tasalaamati minaaka i Manga Musu</para>
  <para style="sr">
    <ref loc="PSA 59:1-18">59:1-18</ref></para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 59:1"/>
    <note caller="-" style="x">
      <char style="xo" closed="false">59:1 </char>
      <char style="xt" closed="false">
        <ref loc="1SA 19:11">1Sa. 19:11</ref>.</char>
    </note>To kapalana molaguna.</para>
  <para style="q1" vid="PSA 59:1">Mboomo lagu: Bholi upahancuru. Zaburuna Daud, siitumo wakutuuna Raja Saul atumpu mia to alibu bhanuana Daud tee ahaejati to apekamatea.<verse eid="PSA 59:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 59:2"/>E Aulataʼalaku, rambasakaaku minaaka i manga musuku,</para>
  <para style="q2" vid="PSA 59:2">jaganiaku minaaka i manga mia moewangiaku.<verse eid="PSA 59:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 59:3"/>Rambasakaaku minaaka i manga mia mopewauna kadhaki,</para>
  <para style="q2" vid="PSA 59:3">tee pasalaamatiaku minaaka i pande pekamatena mia.<verse eid="PSA 59:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 59:4"/>Kamatea, manga incia aopo tee aantagiaku kulalo mamudhaakana amembali apekamateaku,</para>
  <para style="q2" vid="PSA 59:4">manga mia makaa aporomusaka to aewangiaku,</para>
  <para style="q1" vid="PSA 59:4">garaaka iaku inda kupewau kasalaha,</para>
  <para style="q2" vid="PSA 59:4">tee uka inda kupewau dosa, e KAWASANA OPU.<verse eid="PSA 59:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 59:5"/>Moomini inda dhaangia o kasalahaku,</para>
  <para style="q2" vid="PSA 59:5">manga incia abuntuli tee amakanu aewangiaku.</para>
  <para style="b" vid="PSA 59:5"/>
  <para style="q1" vid="PSA 59:5">Bhangumo, upokawaakaaku tee ukamata kadhaangiaku!<verse eid="PSA 59:5"/></para>
  <para style="q2">
    <verse number="6" style="v" sid="PSA 59:6"/>E KAWASANA OPU, Ingkoo Aulataʼalana saangua alamu isombana miana Israel.</para>
  <para style="q1" vid="PSA 59:6">Maasangia ubhangumo to uhukumu bhari-bharia lipu!</para>
  <para style="q2" vid="PSA 59:6">Bholi umaasi i bhari-bharia mia mopewauna kadhaki tee pande hianati. <char style="qs">Sela</char><verse eid="PSA 59:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 59:7"/>I wakutuuna konowia manga incia ambulimo,</para>
  <para style="q2" vid="PSA 59:7">tee akaolu-olu mboomo mantoa mobulilingina kota.<verse eid="PSA 59:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 59:8"/>Kamatea, ngangana manga incia apekasindiri!</para>
  <para style="q2" vid="PSA 59:8">Dhelana manga incia mboomo ewanga momatadha,</para>
  <para style="q2" vid="PSA 59:8">roonamo manga pande hianati afikiri, "Inda dhaangia manga rangona!"<verse eid="PSA 59:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 59:9"/>Maka Ingkoo, upotawaiki manga incia, e KAWASANA OPU,</para>
  <para style="q2" vid="PSA 59:9">Ingkoo uele-ele bhari-bharia lipu.<verse eid="PSA 59:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 59:10"/>E kakaaku, iaku bhekuantagiko;</para>
  <para style="q2" vid="PSA 59:10">roonamo Ingkoo, e Aulataʼala, satotuuna o kota benteku.<verse eid="PSA 59:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 59:11"/>Aulataʼala i nuncana kaasi molagina bhemopokawaakaaku,</para>
  <para style="q2" vid="PSA 59:11">tee bheataroakaaku kukamata manga musuku atotalo.<verse eid="PSA 59:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 59:12"/>Bholi upekamate manga incia mamudhaakana lipuku inda amalingu;</para>
  <para style="q2" vid="PSA 59:12">maka tee kuasamu upapogaa-gaaia</para>
  <para style="q2" vid="PSA 59:12">tee pakotibumea manga incia, e Aulataʼala, peulusamami!<verse eid="PSA 59:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 59:13"/>Roonamo dosa minaaka i muncuna tee pogau ibhoasakana dhelana,</para>
  <para style="q2" vid="PSA 59:13">taroakamo manga incia atorako i nuncana kasombona.</para>
  <para style="q1" vid="PSA 59:13">Roonamo katunda tee kagau-gau ibhoasakana manga incia,<verse eid="PSA 59:13"/></para>
  <para style="q2">
    <verse number="14" style="v" sid="PSA 59:14"/>pabinasamea i nuncana amaramu;</para>
  <para style="q2" vid="PSA 59:14">pabinasamea sampe amapupu.</para>
  <para style="q1" vid="PSA 59:14">Tee mboo sumai, mia bheamataua ande Kawasana Opu aparintangi lipuna Israel,</para>
  <para style="q2" vid="PSA 59:14">tee uka bhari-bharia lipu i dunia. <char style="qs">Sela</char><verse eid="PSA 59:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 59:15"/>I wakutuuna konowia manga incia ambulimo,</para>
  <para style="q2" vid="PSA 59:15">tee akaolu-olu mboomo mantoa atiingi kota.<verse eid="PSA 59:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 59:16"/>Manga incia apekalingka-lingka apeelo kinandena,</para>
  <para style="q2" vid="PSA 59:16">tee akaolu-olu ande inda amambosu.<verse eid="PSA 59:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 59:17"/>Maka iaku bhekulaguaka kuasamu,</para>
  <para style="q2" vid="PSA 59:17">i saeona iaku bhekusambo-sambo roonamo kaasimu molagina,</para>
  <para style="q1" vid="PSA 59:17">sababuna Ingkoo mboomo bente mojaganiaku</para>
  <para style="q2" vid="PSA 59:17">tee tampana peulusaku i wakutuuna kanarakaaku.<verse eid="PSA 59:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 59:18"/>E kakaaku, i Ingkoomo iaku bhekulaguaka manga lagu kapujia,</para>
  <para style="q2" vid="PSA 59:18">roonamo Ingkoomo, e Aulataʼala, benteku mojaganiaku,</para>
  <para style="q2" vid="PSA 59:18">Kawasana Opu momaasiakaaku.<verse eid="PSA 59:18"/></para>
  <chapter eid="PSA 59"/>
  <chapter number="60" style="c" sid="PSA 60"/>
  <para style="s1">Doʼa Emaniana Kamangantalo</para>
  <para style="sr">
    <ref loc="PSA 60:1-14">60:1-14</ref></para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 60:1"/>To kapalana molaguna.</para>
  <para style="q1" vid="PSA 60:1">Aose lagu: Kamba Bakung Kasakusii. Zaburuna Daud, to atoadhariaka<verse eid="PSA 60:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 60:2"/>
    <note caller="-" style="x">
      <char style="xo" closed="false">60:2 </char>
      <char style="xt" closed="false">
        <ref loc="2SA 8:13">2Sa. 8:13</ref>; <ref loc="1CH 18:12">1Taw. 18:12</ref>.</char>
    </note>wakutuuna incia aewangi miana Aram-Naharaim tee miana Aram-Zoba, tee wakutuuna Yoab ambuli sapadhana apekamate 12.000 miana Edom i Mbolongana Asin.<verse eid="PSA 60:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 60:3"/>E Aulataʼala, Ingkoo padhamo manga mendeu, tee utaroaka manga musu akatuki katangkesimami.</para>
  <para style="q2" vid="PSA 60:3">Ingkoo uʼamara tee ingkami, maka sii-sii upekalapea pendua kadhaangiamami minaaka i kanarakaa.<verse eid="PSA 60:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 60:4"/>Ingkoo padhamo ulendu alamu tee upaporuawetaia,</para>
  <para style="q2" vid="PSA 60:4">tulungi upekalapea pendua manga ngkolelena, roonamo dunia sii atorende.<verse eid="PSA 60:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 60:5"/>Utaroakea uumatimu anamisi giu momatamo,</para>
  <para style="q2" vid="PSA 60:5">upasumpu ingkami angguru sakawana tadida.<note caller="+" style="f"><char style="fr" closed="false">60:5 </char><char style="fq" closed="false">angguru sakawana tadida: </char><char style="ft" closed="false">Ibaratina momatadha to agambaraaka hukumuna to uumatina Aulataʼala inda motaʼatina.</char></note><verse eid="PSA 60:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 60:6"/>Ingkoo padhamo upabhale tombi to manga mia momaekana tee Ingkoo</para>
  <para style="q2" vid="PSA 60:6">mamudhaakana manga incia aporomusaka iwe sumai to apeulu minaaka i manga pande pana. <char style="qs">Sela</char><verse eid="PSA 60:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 60:7"/>
    <note caller="-" style="x">
      <char style="xo" closed="false">60:7-14 </char>
      <char style="xt" closed="false">
        <ref loc="PSA 108:7-14">Zab. 108:7-14</ref>.</char>
    </note>Manga pakana tee kuasamu tee uperangoimea o doʼamami,</para>
  <para style="q2" vid="PSA 60:7">mamudhaakana manga mia imaasiakamu atopasalaamati.<verse eid="PSA 60:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 60:8"/>Aulataʼala padhamo afirimani i tampana momangkilo,</para>
  <para style="q2" vid="PSA 60:8">"Iaku gauku kukaunde-unde, tee kupodhawu-dhawuaka Tana Sikhem,</para>
  <para style="q2" vid="PSA 60:8">tee kuʼukuru Mbolongana Sukot.<verse eid="PSA 60:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 60:9"/>Gilead tee Manasye o pewauaku,</para>
  <para style="q2" vid="PSA 60:9">Efraim mboomo helem minaaka i ase mojaganina bhaaku,</para>
  <para style="q2" vid="PSA 60:9">tee Yuda katukona pamarintaku.<verse eid="PSA 60:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 60:10"/>Maka o Tana Moab amembali palangga tampana bhanuiana aeku,</para>
  <para style="q2" vid="PSA 60:10">tee i bhawona Tana Edom kutudhaaka sandaliku.<note caller="+" style="f"><char style="fr" closed="false">60:10 </char><char style="fq" closed="false">kutudhaaka sandaliku: </char><char style="ft" closed="false">To ibarati ande o lipuna Moab tee Edom bheapaporitambea Aulataʼala. </char></note></para>
  <para style="q2" vid="PSA 60:10">E Tana Filistin, Iaku kusambo-sambomo roonamo padhamo kutaloko!"<verse eid="PSA 60:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 60:11"/>Incema bhemobhawaaku i kota mokobentena makaa sumai?</para>
  <para style="q2" vid="PSA 60:11">Incema momembalina moʼantaraaku sakawana i Edom?<verse eid="PSA 60:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 60:12"/>E Aulataʼala, buaka mencuana Ingkoo mangabhanakana?</para>
  <para style="q2" vid="PSA 60:12">E Aulataʼala, Ingkoo inda umaju upobhawa tee tantaramami to taewangi musu.<verse eid="PSA 60:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 60:13"/>Manga tulungi minaaka i musu,</para>
  <para style="q2" vid="PSA 60:13">roonamo o katulungina maanusia inda akoguna.<verse eid="PSA 60:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 60:14"/>Tapobhawa tee Aulataʼala ingkita tamembali tatalo musuta,</para>
  <para style="q2" vid="PSA 60:14">sababuna Incia bhemopahancuruna musuta.<verse eid="PSA 60:14"/></para>
  <chapter eid="PSA 60"/>
  <chapter number="61" style="c" sid="PSA 61"/>
  <para style="s">Doʼa Emaniana Peulusa</para>
  <para style="sr">
    <ref loc="PSA 61:1-9">61:1-9</ref></para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 61:1"/>To kapalana molaguna.</para>
  <para style="q1" vid="PSA 61:1">Tee kagasiana kecapi. Zaburuna Daud.<verse eid="PSA 61:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 61:2"/>E Aulataʼala rangoa igoraakaku,</para>
  <para style="q2" vid="PSA 61:2">perangoia o doʼaku.<verse eid="PSA 61:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 61:3"/>Minaaka i tapana alamu kugoraakako</para>
  <para style="q2" vid="PSA 61:3">wakutuuna amate akalaku.</para>
  <para style="b" vid="PSA 61:3"/>
  <para style="q1" vid="PSA 61:3">Bhawaaku i gunu bhatu</para>
  <para style="q2" vid="PSA 61:3">molabhina kalangana minaaka i karoku<verse eid="PSA 61:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 61:4"/>roonamo Ingkoomo peulusaku,</para>
  <para style="q2" vid="PSA 61:4">munara momakaa to kupeuluaka minaaka i musuku.<verse eid="PSA 61:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 61:5"/>Taroakamo saʼumurua dhadhiku kumboore i nuncana Kema Momangkilomu,</para>
  <para style="q2" vid="PSA 61:5">mamudhaakana kuʼamani i nuncana peulusana panimu. <char style="qs">Sela</char><verse eid="PSA 61:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 61:6"/>Sababuna Ingkoo padhamo urango tolauna oniku, e Aulataʼala,</para>
  <para style="q2" vid="PSA 61:6">tee padhamo udhawuaku tinauraka idhawuakamu to mia momaekako.<verse eid="PSA 61:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 61:7"/>Maasangia upekarambe umuruna raja,</para>
  <para style="q2" vid="PSA 61:7">mamudhaakana incia adhadhi saʼumurua.<verse eid="PSA 61:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 61:8"/>Maasangia incia amembali raja saʼumurua i aroana Aulataʼala,</para>
  <para style="q2" vid="PSA 61:8">parintaakamea o kaasimu molagina tee janjimu inda momabhotu to mojagania.<verse eid="PSA 61:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 61:9"/>Sumaimo iaku sadia bhekulaguaka lagu kapujia to saromu,</para>
  <para style="q2" vid="PSA 61:9">tee kupomea tolauna oniku saesaeo.<verse eid="PSA 61:9"/></para>
  <chapter eid="PSA 61"/>
  <chapter number="62" style="c" sid="PSA 62"/>
  <para style="s">Namisi Momalimua i Saripina Aulataʼala</para>
  <para style="sr">
    <ref loc="PSA 62:1-13">62:1-13</ref></para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 62:1"/>To kapalana molaguna.</para>
  <para style="q1" vid="PSA 62:1">Mboomo: Yedutun. Zaburuna Daud.<verse eid="PSA 62:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 62:2"/>Tangkanamo i saripina Aulataʼala o namisiku amalimua,</para>
  <para style="q2" vid="PSA 62:2">minaakamo i Incia o kasalaamatiku.<verse eid="PSA 62:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 62:3"/>Tangkanamo Incia gunu bhatuku tee mopasalaamatiaku,</para>
  <para style="q2" vid="PSA 62:3">Incia mboomo kota bente moewaakaaku, iaku inda bhekukohudha sampeampearo.<verse eid="PSA 62:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 62:4"/>Sakawana naepia ingkomiu uhumbuni mia?</para>
  <para style="q2" vid="PSA 62:4">E bhari-bharikomiu, buaka ingkomiu bheubhebhe mia ihumbunimiu,</para>
  <para style="q1" vid="PSA 62:4">mboomo ubhebhe rindi mobhele tee tondo momakasuna motobhata?<verse eid="PSA 62:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 62:5"/>Manga incia tangkanamo ahaejati to apasabua minaaka i kauncuramakana momalangana,</para>
  <para style="q2" vid="PSA 62:5">manga incia sadia agau-gau,</para>
  <para style="q1" vid="PSA 62:5">tee o muncuna manga incia aemani barakati,</para>
  <para style="q2" vid="PSA 62:5">maka i nuncana ngangarandana apekatunda. <char style="qs">Sela</char><note caller="+" style="f"><char style="fr" closed="false">62:5 </char><char style="fq" closed="false">Sela: </char><char style="ft" closed="false">Aipomo tandana to aunto wakutuuna lagu sumai atolaguaka, atawa o tanda to ahanda apekaogea o suarana, atawa onina gambusuna.</char></note><verse eid="PSA 62:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 62:6"/>E ngangarandaku, tangkanamo i Aulataʼala o namisiku amalimua</para>
  <para style="q2" vid="PSA 62:6">roonamo tangkanamo Incia iharapuku.<verse eid="PSA 62:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 62:7"/>Tangkanamo Incia o gunu bhatuku tee mopasalaamatiaku,</para>
  <para style="q2" vid="PSA 62:7">Incia o benteku, iaku inda bhekukohudha.<verse eid="PSA 62:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 62:8"/>Aulataʼala modhawuaku kasalaamati tee mopamembaliaku kumulia,</para>
  <para style="q2" vid="PSA 62:8">Incia o gunu bhatuku momakaa tee o tampana peulusaku.<verse eid="PSA 62:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 62:9"/>E manga witinai, sadiamo uparacaea i Aulataʼala,</para>
  <para style="q2" vid="PSA 62:9">palimbamea antona ngangarandamu i aroana,</para>
  <para style="q2" vid="PSA 62:9">sababuna Incia o tampana peulusata. <char style="qs">Sela</char><verse eid="PSA 62:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 62:10"/>Mia mohina mboomo sampearo poinunca,</para>
  <para style="q2" vid="PSA 62:10">tee o mia momulia inda amembali atoparacaea.</para>
  <para style="q1" vid="PSA 62:10">Atotimbangi manga incia bhari-bharia amagaagaa,</para>
  <para style="q2" vid="PSA 62:10">alabhi o kagaa-gaana minaaka i ngalu.<verse eid="PSA 62:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 62:11"/>Bholi uparacaea tee hasili ipotibhaakamiu minaaka i uhanda mia,</para>
  <para style="q2" vid="PSA 62:11">tee bholi uharapuaka harataa irampasi.</para>
  <para style="q1" vid="PSA 62:11">Ande o harataamiu ajulu o kabharina,</para>
  <para style="q2" vid="PSA 62:11">incamu bholi aposaronaka i harataamiu sumai.<verse eid="PSA 62:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 62:12"/>Sampearo Aulataʼala afirimani,</para>
  <para style="q2" vid="PSA 62:12">rua giu irangoku,</para>
  <para style="q1" vid="PSA 62:12">siitumo ande o kuasa minaaka i Aulataʼala,<verse eid="PSA 62:12"/></para>
  <para style="q2">
    <verse number="13" style="v" sid="PSA 62:13"/>
    <note caller="-" style="x">
      <char style="xo" closed="false">62:13 </char>
      <char style="xt" closed="false">
        <ref loc="JOB 34:11">Ayb. 34:11</ref>; <ref loc="JER 17:10">Yer. 17:10</ref>; <ref loc="MAT 16:27">Mat. 16:27</ref>; <ref loc="ROM 2:6">Rom. 2:6</ref>; <ref loc="REV 2:23">Wah. 2:23</ref>.</char>
    </note>tee minaaka i Ingkoo uka o kaasi molagina, e Kawasana Opu.</para>
  <para style="q1" vid="PSA 62:13">Roonamo Ingkoo mobalasina bhari-bharia mia</para>
  <para style="q2" vid="PSA 62:13">apokana mboomo ipewauna.<verse eid="PSA 62:13"/></para>
  <chapter eid="PSA 62"/>
  <chapter number="63" style="c" sid="PSA 63"/>
  <para style="s">Pemelili i Kawasana Opu</para>
  <para style="sr">
    <ref loc="PSA 63:1-12">63:1-12</ref></para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 63:1"/>
    <note caller="-" style="x">
      <char style="xo" closed="false">63:1 </char>
      <char style="xt" closed="false">
        <ref loc="1SA 23:14">1Sa. 23:14</ref>.</char>
    </note>Zaburuna Daud wakutuuna incia adhaangia i Tana Matuuna Yuda.<verse eid="PSA 63:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 63:2"/>E Aulataʼala, Ingkoomo Aulataʼalaku, iaku kupeeloko,</para>
  <para style="q2" vid="PSA 63:2">tee gauku kupokawa tee Ingkoo.</para>
  <para style="q1" vid="PSA 63:2">Saangua badaku apemeliliakako,</para>
  <para style="q2" vid="PSA 63:2">mboomo mia molingkana i tana matuu mofaraluuna uwe.<verse eid="PSA 63:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 63:3"/>Mboo sumaimo kutontoko i tampamu momangkilo</para>
  <para style="q2" vid="PSA 63:3">to kukamataaka kuasamu tee kamuliangimu.<verse eid="PSA 63:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 63:4"/>Roonamo kaasimu molagina alabhi akoharagaa minaaka i dhadhi,</para>
  <para style="q2" vid="PSA 63:4">sababuna sumai kupujiko.<verse eid="PSA 63:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 63:5"/>Mboo sumaimo bhekupujiko saʼumurua dhadhiku,</para>
  <para style="q2" vid="PSA 63:5">tee kuangka limaku to kumuliangi saromu.<verse eid="PSA 63:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 63:6"/>Atumpu incaku, mboomo tee kinande momambaka,</para>
  <para style="q2" vid="PSA 63:6">tee kupujiko tee bhiwiku mokaunde-unde,<verse eid="PSA 63:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 63:7"/>wakutuu kuudhaniko i kolemaku,</para>
  <para style="q2" vid="PSA 63:7">tee kufikiriko samaloa.<verse eid="PSA 63:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 63:8"/>Roonamo Ingkoomo motulungiaku,</para>
  <para style="q2" vid="PSA 63:8">i tambena panimu iaku kusambo-sambo.<verse eid="PSA 63:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 63:9"/>Ngangarandaku bheakeniakako pekatangka,</para>
  <para style="q2" vid="PSA 63:9">lima kaanamu atukoaku.<verse eid="PSA 63:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 63:10"/>Maka manga mia mohaejatina mopekamateaku</para>
  <para style="q2" vid="PSA 63:10">bheapesua i tambena tana tee manga mia mate;<verse eid="PSA 63:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 63:11"/>manga musuku bheatopekamateaka tee hancu,</para>
  <para style="q2" vid="PSA 63:11">tee amembali kinandena serigala.<verse eid="PSA 63:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 63:12"/>Maka raja bheakaunde-unde roonamo katulungina Aulataʼala;</para>
  <para style="q2" vid="PSA 63:12">bhari-bharia mia moposumpana tee Aulataʼala bheabangga,</para>
  <para style="q2" vid="PSA 63:12">roonamo Incia bheasoncongi ngangana manga pande gau-gau.<verse eid="PSA 63:12"/></para>
  <chapter eid="PSA 63"/>
  <chapter number="64" style="c" sid="PSA 64"/>
  <para style="s">Kahukumuna Aulataʼala to Mia Madhaki</para>
  <para style="sr">
    <ref loc="PSA 64:1-11">64:1-11</ref></para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 64:1"/>To kapalana molaguna. Zaburuna Daud.<verse eid="PSA 64:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 64:2"/>E Aulataʼala, maasangia urango doʼaku i wakutuuna kupeenci,</para>
  <para style="q2" vid="PSA 64:2">pasalaamatia inyawaku minaaka i kasegana musu.<verse eid="PSA 64:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 64:3"/>Jaganiaku minaaka i haejati irahasiaakana manga mia madhaki,</para>
  <para style="q2" vid="PSA 64:3">tee minaaka i isikadina manga mia mopewauna kadhaki.<verse eid="PSA 64:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 64:4"/>Pogauna manga amatadha mboomo hancu,</para>
  <para style="q2" vid="PSA 64:4">tee pogau ibhoasakana amapii mboomo anana pana.<verse eid="PSA 64:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 64:5"/>Manga incia apana manga mia inda mosala minaaka i tampana opoana,</para>
  <para style="q2" vid="PSA 64:5">sumaimo alausaka apanea inda tee kaekana.<verse eid="PSA 64:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 64:6"/>Manga incia sadia ahaejatiaka momadhakina,</para>
  <para style="q2" vid="PSA 64:6">apomufakati to ataa katapu tee apobuniaka,</para>
  <para style="q2" vid="PSA 64:6">tee apogau i nuncana ngangarandana, "Inda dhaangia manga kamatana!"<verse eid="PSA 64:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 64:7"/>Manga incia ahaejatiaka kadhaki tee apogau,</para>
  <para style="q2" vid="PSA 64:7">"Ihaejatiakamami amondomo!"</para>
  <para style="q1" vid="PSA 64:7">Manga incia abuniaka opea ihaejatiakana,</para>
  <para style="q2" vid="PSA 64:7">roonamo ngangarandana maanusia inda amembali amataua mia mosagaanana.<verse eid="PSA 64:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 64:8"/>Maka Aulataʼala apana manga incia</para>
  <para style="q2" vid="PSA 64:8">tee saanampuu manga incia amambela.<verse eid="PSA 64:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 64:9"/>Aulataʼala bheapasindoli manga incia rampaakanamo dhelana;</para>
  <para style="q2" vid="PSA 64:9">bhari-bharia mia mokamatea bhearengku tee abhibhi.<verse eid="PSA 64:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 64:10"/>Bhari-bharia mia bheamaeka;</para>
  <para style="q2" vid="PSA 64:10">manga incia bheapetulatulaaka opea mopadhana ipewauna Aulataʼala,</para>
  <para style="q2" vid="PSA 64:10">tee bheafikiri opea mopadhana ipewauna.<verse eid="PSA 64:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 64:11"/>Taroakamo mia mobanara akaunde-unde roonamo KAWASANA OPU</para>
  <para style="q2" vid="PSA 64:11">tee apeulu i Incia.</para>
  <para style="q1" vid="PSA 64:11">Taroakamo bhari-bharia mia momakatena incana bheabangga tee Incia!<verse eid="PSA 64:11"/></para>
  <chapter eid="PSA 64"/>
  <chapter number="65" style="c" sid="PSA 65"/>
  <para style="s">Kasukuru to Barakati Idhawuakana Aulataʼala</para>
  <para style="sr">
    <ref loc="PSA 65:1-14">65:1-14</ref></para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 65:1"/>To kapalana molaguna. Zaburuna Daud. Laguna.<verse eid="PSA 65:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 65:2"/>E Aulataʼala, alaengamo ingkami tapujiko i Sion,</para>
  <para style="q2" vid="PSA 65:2">tee tapomea o tolauna onimami i Ingkoo.<verse eid="PSA 65:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 65:3"/>Sababuna Ingkoomo moperangoina doʼa,</para>
  <para style="q1" vid="PSA 65:3">i Ingkoomo bhari-bharia maanusia bheaumba.<verse eid="PSA 65:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 65:4"/>Wakutuuna dosamami alabhi o katamona minaaka i kakaamami,</para>
  <para style="q2" vid="PSA 65:4">Ingkoomo moʼamponina kasalahamami.<verse eid="PSA 65:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 65:5"/>Amasanaamo mia ipilimu tee ipekakasumu</para>
  <para style="q2" vid="PSA 65:5">to amboore i aroana Bhanuamu.</para>
  <para style="q1" vid="PSA 65:5">Bheapatumpu incamami tee bhari-bharia momalapena modhaangiana i Bhanuamu,</para>
  <para style="q2" vid="PSA 65:5">siitumo i nuncana Baitullamu momangkilo.<verse eid="PSA 65:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 65:6"/>Tee manga pewaumu moʼadili tee inda momentela</para>
  <para style="q2" vid="PSA 65:6">Ingkoo ulawani ingkami,</para>
  <para style="q2" vid="PSA 65:6">e Kawasana Opu, mopasalaamatina ingkami.</para>
  <para style="q1" vid="PSA 65:6">Ingkoomo iparacaeana saangua alamu</para>
  <para style="q2" vid="PSA 65:6">tee i tawo momaridho mpuu.<verse eid="PSA 65:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 65:7"/>Minaaka i kakaamu, upakaro manga gunu;</para>
  <para style="q2" vid="PSA 65:7">upakanaakea kuasamu momakaana.<verse eid="PSA 65:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 65:8"/>Ingkoomo mopauntona suarana pamuruna tawo,</para>
  <para style="q2" vid="PSA 65:8">siitumo suarana pamuruna ewona,</para>
  <para style="q2" vid="PSA 65:8">tee karobhona manga lipu.<verse eid="PSA 65:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 65:9"/>Manga mia i saangua alamu</para>
  <para style="q2" vid="PSA 65:9">amaeka akamata manga tanda inda momentela ipewaumu.</para>
  <para style="q1" vid="PSA 65:9">Minaaka i timbu sakawana i bhara,</para>
  <para style="q2" vid="PSA 65:9">upewaua asambo-sambo tee akaunde-unde.<verse eid="PSA 65:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 65:10"/>Tana sumai udhambaakea tee udhawua wao,</para>
  <para style="q2" vid="PSA 65:10">Upasuburua sabutuna hasilina abhari mpuu.</para>
  <para style="q1" vid="PSA 65:10">Umalana Aulataʼala abukeaka tee uwe,</para>
  <para style="q2" vid="PSA 65:10">tee upasadiaakea gandum to maanusia,</para>
  <para style="q1" vid="PSA 65:10">mboo sumaimo upatotapuakea.<verse eid="PSA 65:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 65:11"/>Ingkoo sadia upakouwe tana ibhingkunina,</para>
  <para style="q2" vid="PSA 65:11">tee uparatea manga tongkana tanana,</para>
  <para style="q1" vid="PSA 65:11">upekagodhea tee wao,</para>
  <para style="q2" vid="PSA 65:11">tee ubarakati manga penembulana.<verse eid="PSA 65:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 65:12"/>Roonamo kalapemu, satao-satao udhawuakea timpua,</para>
  <para style="q2" vid="PSA 65:12">I iapaipo ubhengkala, ubholi manga giu momalape.<verse eid="PSA 65:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 65:13"/>Manga rumpu i tana matuu atuwu asuburu,</para>
  <para style="q2" vid="PSA 65:13">manga gunu akaunde-unde.<verse eid="PSA 65:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 65:14"/>Manga tana mokorumpu abukeaka gulumana dumba,</para>
  <para style="q2" vid="PSA 65:14">tee manga mbolonga atipuaka gandum.</para>
  <para style="q2" vid="PSA 65:14">Bhari-bharia asambo-sambo tee alagu akaunde-unde.<verse eid="PSA 65:14"/></para>
  <chapter eid="PSA 65"/>
  <chapter number="66" style="c" sid="PSA 66"/>
  <para style="s">Kasukuru roonamo Miana Israel Atotulungi</para>
  <para style="sr">
    <ref loc="PSA 66:1-20">66:1-20</ref></para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 66:1"/>To kapalana molaguna. Laguna Zaburu.</para>
  <para style="b" vid="PSA 66:1"/>
  <para style="q1" vid="PSA 66:1">Sambo-sambomo to Aulataʼala, e saangua alamu!<verse eid="PSA 66:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 66:2"/>Laguakamo manga lagu kapujia tee umuliangimea o sarona,</para>
  <para style="q2" vid="PSA 66:2">muliangimea o kapujiana to Incia.<verse eid="PSA 66:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 66:3"/>Pakawaakea i Aulataʼala, "Tapanamo atomaeka ipewaumu!</para>
  <para style="q2" vid="PSA 66:3">Roonamo kuasamu amaoge, sumaimo o musu-musumu atungku tee arengku i aroamu.<verse eid="PSA 66:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 66:4"/>Saangua dunia asuju asombako.</para>
  <para style="q2" vid="PSA 66:4">Manga incia apuji-pujiko,</para>
  <para style="q2" vid="PSA 66:4">tee alaguaka lagu kapujia to saromu." <char style="qs">Sela</char><note caller="+" style="f"><char style="fr" closed="false">66:4 </char><char style="fq" closed="false">Sela: </char><char style="ft" closed="false">Aipomo tandana to aunto wakutuuna lagu sumai atolaguaka, atawa o tanda to ahanda apekaogea o suarana, atawa onina gambusuna.</char></note><verse eid="PSA 66:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 66:5"/>Mai, kamatea opea ipewauna Aulataʼala,</para>
  <para style="q2" vid="PSA 66:5">ipewauna inda momentela to maanusia.<verse eid="PSA 66:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 66:6"/>
    <note caller="-" style="x">
      <char style="xo" closed="false">66:6 </char>
      <char style="xt" closed="false">
        <ref loc="EXO 14:21-29">Limb. 14:21-29</ref>.</char>
    </note>Incia abhalii tawo amembali tana matuu,</para>
  <para style="q2" vid="PSA 66:6">tee manga opu-opuata apolimba i umala tee adhala ae.<note caller="+" style="f"><char style="fr" closed="false">66:6 </char><char style="ft" closed="false">I aeati incia sii, moburina zaburu incia sii apogauaka rua kajadia inda momentela iapai Aulataʼala atulungi miana Israel apolimba i uwe. Wakutuuna Musa tee miana Israel abholi Mesir, manga incia amembali apalaiaka karona minaaka i tantarana Firaun sapadhana Aulataʼala aweta Tawo Towu Lambe mamudhaakana manga incia amembali adhala i tanga-tangana tee akawa i sawetana. Kasiimpo 40 tao i aroa, Aulataʼala apaunto siwuluna Umala Yordan mamudhaakana Yusak tee miana Israel adhala i tanga-tangana umala incia sumai tee apesuaiki Tana Kanaan. </char></note></para>
  <para style="q1" vid="PSA 66:6">Siitumo ingkita takaunde-unde roonamo bhari-bharia ipewauna.<verse eid="PSA 66:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 66:7"/>Incia aparinta tee kakaana to saʼumurua,</para>
  <para style="q2" vid="PSA 66:7">tee o matana ajagani manga lipu</para>
  <para style="q2" vid="PSA 66:7">mamudhaakana manga mia mobhalia inda asomboaka karona. <char style="qs">Sela</char><verse eid="PSA 66:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 66:8"/>Pujimo Aulataʼalamami, e manga lipu,</para>
  <para style="q2" vid="PSA 66:8">parangoakamea o kapujiamiu i Incia!<verse eid="PSA 66:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 66:9"/>Incia mojagani inyawamami mamudhaakana inda tamate,</para>
  <para style="q2" vid="PSA 66:9">tee inda ataroakea o aemami asindoli.<verse eid="PSA 66:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 66:10"/>E Aulataʼala, Ingkoo padhamo manga uuji,</para>
  <para style="q2" vid="PSA 66:10">tee manga pekangkilo mboomo mia mopekangkilona pera i nuncana waa.<verse eid="PSA 66:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 66:11"/>Ingkoo upapesua ingkami i nuncana jari,</para>
  <para style="q2" vid="PSA 66:11">tee udhika bhawa momatamo i bhawona torukumami.<verse eid="PSA 66:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 66:12"/>Ingkoo utaroakea manga mia alanda-landaki bhaamami.</para>
  <para style="q2" vid="PSA 66:12">Ingkami talaloi waa tee mawa,</para>
  <para style="q2" vid="PSA 66:12">maka Ingkoo ubhawa ingkami i tampa momalape tee momalalesa.<verse eid="PSA 66:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 66:13"/>Iaku bhekupesua i nuncana bhanuamu tee kubhawa kurubani itunu.</para>
  <para style="q2" vid="PSA 66:13">Iaku bhekupomea tolauna oniku<verse eid="PSA 66:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 66:14"/>ibhoasakaku minaaka i ngangaku i wakutuuna kumaseke.<verse eid="PSA 66:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 66:15"/>Iaku bhekupasombaaka to Ingkoo</para>
  <para style="q2" vid="PSA 66:15">manga kurubani itunu minaaka i binata momalompo,</para>
  <para style="q2" vid="PSA 66:15">tee momawonduna bhouna minaaka i dumba umane.</para>
  <para style="q2" vid="PSA 66:15">Iaku bhekupasombaakako manga sapi umane tee bhembe umane. <char style="qs">Sela</char><verse eid="PSA 66:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 66:16"/>Mai perangoia, e bhari-bharia mia momaeka i Aulataʼala!</para>
  <para style="q2" vid="PSA 66:16">Iaku bhekupetulatulaaka opea mopadhana ipewauna to iaku.<verse eid="PSA 66:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 66:17"/>Tee ngangaku kugoraakea</para>
  <para style="q2" vid="PSA 66:17">sabutuna o dhelaku alaguaka lagu kapujia to Incia.<verse eid="PSA 66:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 66:18"/>Ande kumaasiaka giu madhaki i nuncana ngangarandaku,</para>
  <para style="q2" vid="PSA 66:18">atantumo o Aulataʼala amendeu aperangoiaku.<verse eid="PSA 66:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 66:19"/>Maka o Aulataʼala aperangoia,</para>
  <para style="q2" vid="PSA 66:19">Incia amaheruakaaku wakutuuna kudoʼa.<verse eid="PSA 66:19"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 66:20"/>Atopujimo o Aulataʼala,</para>
  <para style="q2" vid="PSA 66:20">moperangoina doʼaku</para>
  <para style="q2" vid="PSA 66:20">tee inda apekaridhoakaaku o kaasina molagina minaaka i karoku.<verse eid="PSA 66:20"/></para>
  <chapter eid="PSA 66"/>
  <chapter number="67" style="c" sid="PSA 67"/>
  <para style="s">Kasukuru to Bhari-bharia Barakati Idhawuakana Aulataʼala</para>
  <para style="sr">
    <ref loc="PSA 67:1-8">67:1-8</ref></para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 67:1"/>To kapalana molaguna.</para>
  <para style="q1" vid="PSA 67:1">Tee kagasiana kecapi. Laguna Zaburu.<verse eid="PSA 67:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 67:2"/>Maasangia o Aulataʼala manga maasiaka tee manga barakati,</para>
  <para style="q2" vid="PSA 67:2">maasangia Incia manga kamata tee kalapena incana, <char style="qs">Sela</char><verse eid="PSA 67:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 67:3"/>tee mboo sumai, maanusia i bhawona alamu sii amataua opea ipeelumu to manga incia,</para>
  <para style="q2" vid="PSA 67:3">tee bhari-bharia lipu amataua ande Ingkoo mokokuasana to mopasalaamatina manga incia.<verse eid="PSA 67:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 67:4"/>E Aulataʼala, maasangia manga lipu apujiko,</para>
  <para style="q2" vid="PSA 67:4">maasangia bhari-bharia lipu apujiko.<verse eid="PSA 67:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 67:5"/>Maasangia manga lipu akaunde-unde tee asambo-sambo</para>
  <para style="q2" vid="PSA 67:5">roonamo Ingkoo tee kaʼadili uhaakimu manga lipu,</para>
  <para style="q2" vid="PSA 67:5">tee utonda bhari-bharia lipu i bhawona alamu. <char style="qs">Sela</char><verse eid="PSA 67:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 67:6"/>Maasangia manga lipu apujiko, e Aulataʼala,</para>
  <para style="q2" vid="PSA 67:6">maasangia bhari-bharia lipu apujiko.<verse eid="PSA 67:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 67:7"/>Alamu padhamo adhawuaka hasilina;</para>
  <para style="q2" vid="PSA 67:7">Aulataʼala, Aulataʼalata, padhamo abarakati ingkita.<verse eid="PSA 67:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 67:8"/>Maasangia Aulataʼala manga barakati torosu;</para>
  <para style="q2" vid="PSA 67:8">maasangia bhari-bharia lipu i bhawona dunia amaekaia.<verse eid="PSA 67:8"/></para>
  <chapter eid="PSA 67"/>
  <chapter number="68" style="c" sid="PSA 68"/>
  <para style="s">Lagu Kamangantalona Kawasana Opu</para>
  <para style="sr">
    <ref loc="PSA 68:1-36">68:1-36</ref></para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 68:1"/>To kapalana molaguna. Zaburuna Daud. Laguna.<verse eid="PSA 68:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 68:2"/>Taroakamo Aulataʼala akakaro tee apewau musuna apogaa-gaa;</para>
  <para style="q2" vid="PSA 68:2">taroakamo manga mia mobancia amatalo tee apalai minaaka i aroana.<verse eid="PSA 68:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 68:3"/>Mboomo ombu aila wakutuuna atowiia ngalu, taroakamo Ingkoo uwulu manga incia.</para>
  <para style="q2" vid="PSA 68:3">Mboomo taru arere i aroana waa,</para>
  <para style="q2" vid="PSA 68:3">taroakamo mia madhaki abinasa i aroana Aulataʼala.<verse eid="PSA 68:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 68:4"/>Maka taroakamo o mia mobanara akaunde-unde,</para>
  <para style="q2" vid="PSA 68:4">taroakamo manga incia amasanaa i aroana Aulataʼala,</para>
  <para style="q2" vid="PSA 68:4">tee taroakamo manga incia asambo-sambo tee akaunde-unde.<verse eid="PSA 68:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 68:5"/>Lagumo to Aulataʼala, laguakamo lagu kapujia to sarona!</para>
  <para style="q2" vid="PSA 68:5">Pasiapuakea dhala oge to Incia mosawina i taʼina ngalu!<note caller="+" style="f"><char style="fr" closed="false">68:5 </char><char style="fq" closed="false">mosawina i taʼina ngalu: </char><char style="ft" closed="false">Pogau kabhanti mokotandana o kaogesana Aulataʼala.</char></note></para>
  <para style="q1" vid="PSA 68:5">Sarona o KAWASANA OPU,</para>
  <para style="q2" vid="PSA 68:5">kaunde-undemo i aroana!<verse eid="PSA 68:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 68:6"/>Amana manga ana maelu tee moewaakana manga iaiaro</para>
  <para style="q2" vid="PSA 68:6">siitumo o Aulataʼala i tampana mbooresana momangkilo.<verse eid="PSA 68:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 68:7"/>Mia momboorena samia-miana Aulataʼala aposaangua i nuncana saangu bhanua,</para>
  <para style="q2" vid="PSA 68:7">Incia apabebasi mia mototorongku sabutuna manga incia amasanaamo dhadhina,</para>
  <para style="q2" vid="PSA 68:7">maka manga mia mobhalia amboore i tana matuu.<verse eid="PSA 68:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 68:8"/>
    <note caller="-" style="x">
      <char style="xo" closed="false">68:8-9 </char>
      <char style="xt" closed="false">
        <ref loc="EXO 14:12">Limb. 14:12</ref>; <ref loc="EXO 19:18">19:18</ref>. </char>
    </note>E Aulataʼala, wakutuuna ukapalai uumatimu wakutuuna apotimbe,</para>
  <para style="q2" vid="PSA 68:8">tee wakutuuna ulaloi tana matuu, <char style="qs">Sela</char><verse eid="PSA 68:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 68:9"/>alamu akolendu, tee o laiana apasapo wao,</para>
  <para style="q1" vid="PSA 68:9">roonamo umbaana Aulataʼala isombana miana Israel,</para>
  <para style="q2" vid="PSA 68:9">siitumo isarongiakana Aulataʼala i Sinai.<note caller="+" style="f"><char style="fr" closed="false">68:9 </char><char style="fq" closed="false">Aulataʼala i Sinai: </char><char style="ft" closed="false">Aulataʼala apatokamataaka karona i miana Israel i Gunu Sinai wakutuuna manga incia alingka minaaka i Mesir aporope i Kanaan. Kamata </char><char style="xt" closed="false"><ref loc="EXO 19:16-25">Limb. 19:16-25</ref>.</char></note><verse eid="PSA 68:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 68:10"/>E Aulataʼala, amaranca mpuu Ingkoo upasapo wao,</para>
  <para style="q2" vid="PSA 68:10">tee upasuburu tana tinaurakamu<note caller="+" style="f"><char style="fr" closed="false">68:10 </char><char style="fq" closed="false">tinaurakamu: </char><char style="ft" closed="false">Siitumo Tana Kanaan, idhawuakana Kawasana Opu to miana Israel.</char></note> i wakutuuna amatuu;<verse eid="PSA 68:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 68:11"/>sabutuna o uumatimu ambooresia.</para>
  <para style="q2" vid="PSA 68:11">E Aulataʼala, tee kalapemu udhawuakea</para>
  <para style="q2" vid="PSA 68:11">bhari-bharia ifaraluuna mia misikini.<verse eid="PSA 68:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 68:12"/>Kawasana Opu apakawaaka firimanina,</para>
  <para style="q2" vid="PSA 68:12">tee rombongana mia bhari<note caller="+" style="f"><char style="fr" closed="false">68:12 </char><char style="fq" closed="false">rombongana mia bhari: </char><char style="ft" closed="false">Amembali uka "rombongana bhawine bhari."</char></note> mobhawana lele malape sumai.<verse eid="PSA 68:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 68:13"/>"Manga raja tee tantarana apalai, umbe, apalaiaka karona!"</para>
  <para style="q2" vid="PSA 68:13">Manga bhawine momboorena i nuncana bhanua apodhawu-dhawuaka bara irampasi minaaka i tampana potimbea.<verse eid="PSA 68:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 68:14"/>Moomini ingkomiu apotidhole i tanga-tangana kandana dumba,</para>
  <para style="q2" vid="PSA 68:14">bara irampasimiu mboomo panina jarajara ilapisiaka pera,</para>
  <para style="q2" vid="PSA 68:14">buluna minaaka i bulawa mokokila!<verse eid="PSA 68:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 68:15"/>Wakutuuna o Kawasana Opu Mokokuasana apapogaa-gaa manga raja iwe sumai,</para>
  <para style="q2" vid="PSA 68:15">asapomo salju i Gunu Zalmon.<verse eid="PSA 68:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 68:16"/>Gunu Basan o gunu momakaa.</para>
  <para style="q2" vid="PSA 68:16">Gunu mobharina tubuna, siitumo o Gunu Basan.<verse eid="PSA 68:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 68:17"/>E Gunu Basan mobharina tubuna, pokia ingkoo ugigibulu</para>
  <para style="q2" vid="PSA 68:17">tee Gunu Sion<note caller="-" style="x"><char style="xo" closed="false">68:17 </char><char style="xt" closed="false"><ref loc="PSA 2:6">2:6</ref>.</char></note> ipilina Aulataʼala to amembali tampana kauncuramakana?</para>
  <para style="q2" vid="PSA 68:17">Satotuuna o KAWASANA OPU bheamboore iwe sumai saʼumurua!<verse eid="PSA 68:17"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 68:18"/>Kawasana Opu aumbamo minaaka i Gunu Sinai</para>
  <para style="q2" vid="PSA 68:18">tee apesua i tampana momangkilo</para>
  <para style="q1" vid="PSA 68:18">tee puluna rewu kareta potimbeana,</para>
  <para style="q2" vid="PSA 68:18">inda atolentu o kabharina.<verse eid="PSA 68:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 68:19"/>
    <note caller="-" style="x">
      <char style="xo" closed="false">68:19 </char>
      <char style="xt" closed="false">
        <ref loc="EPH 4:8">Ef. 4:8</ref>. </char>
    </note>Ingkoo ukompa i tampa momalanga</para>
  <para style="q2" vid="PSA 68:19">tee ubhawa manga mia mototaangi i talikumu.<note caller="+" style="f"><char style="fr" closed="false">68:19 </char><char style="fq" closed="false">manga mia mototaangi i talikumu: </char><char style="ft" closed="false">I zamani mangenge, ande saangu lipu atalo lipu mosagaanana, raja mokana bheabhawa manga mia momatalo i talikuna to amembali bhatua i lipuna. </char></note></para>
  <para style="q1" vid="PSA 68:19">Ingkoo utarima hadia mobhari minaaka i maanusia,</para>
  <para style="q2" vid="PSA 68:19">moomini minaaka i manga mia mobhaliko.</para>
  <para style="q1" vid="PSA 68:19">KAWASANA OPU, Aulataʼala,</para>
  <para style="q2" vid="PSA 68:19">bheamboore iwe sumai.<verse eid="PSA 68:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 68:20"/>Atopujimo Kawasana Opu,</para>
  <para style="q2" vid="PSA 68:20">mosodhana bhawata saesaeo.</para>
  <para style="q2" vid="PSA 68:20">Incia o Aulataʼala mopasalaamatina ingkita. <char style="qs">Sela</char><verse eid="PSA 68:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 68:21"/>Aulataʼalata satotuuna o Aulataʼala mopasalaamatina ingkita,</para>
  <para style="q2" vid="PSA 68:21">tee KAWASANA OPU motulungina ingkita mamudhaakana inda tamate.<verse eid="PSA 68:21"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 68:22"/>Maka o Aulataʼala bheapurokoti bhaana musuna,</para>
  <para style="q2" vid="PSA 68:22">tee kauwana bhaana mokobulua minaaka i manga mia</para>
  <para style="q2" vid="PSA 68:22">mosadhaadhaana modhadhina i nuncana kasalaha.<verse eid="PSA 68:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 68:23"/>Kawasana Opu afirimani, "Iaku bhekubhawea pendua o musumu minaaka i Basan;</para>
  <para style="q2" vid="PSA 68:23">bhekubhawea pendua manga incia minaaka i tawo momandala<verse eid="PSA 68:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 68:24"/>mamudhaakana ingkomiu amembali ubhanui aemu tee raana manga incia,</para>
  <para style="q2" vid="PSA 68:24">tee manga mantoamu amembali apotibhaaka dhawuna tee atumpu incana adhelapia."<verse eid="PSA 68:24"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 68:25"/>Manga mia padhamo akamatako wakutuuna ambeliakako mboomo raja, e Aulataʼala;</para>
  <para style="q2" vid="PSA 68:25">ambeliakako o Kawasana Opuku, o Rajaku to ulingka uporope i mbooresamu momangkilo.<verse eid="PSA 68:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 68:26"/>Manga molaguna adhaangia i aroa,</para>
  <para style="q2" vid="PSA 68:26">momagasiaakana kecapi i taliku,</para>
  <para style="q2" vid="PSA 68:26">i tanga-tanga manga kabuabua mobhebhena ganda-ganda. Mboo siimo laguna manga incia,<verse eid="PSA 68:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 68:27"/>"Pujimea o Aulataʼala i tanga-tangana uumatina momaoge,</para>
  <para style="q2" vid="PSA 68:27">Pujimea o KAWASANA OPU, e bhari-bharikomiu siwuluna Israel!"<verse eid="PSA 68:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 68:28"/>Bhaa-bhaana o siwuluna Binyamin, momembalina kamia momaidhiidhi mpuu mokapalaina manga incia,</para>
  <para style="q2" vid="PSA 68:28">kasiimpo aosea manga lakina Yuda i saangu rombongana,</para>
  <para style="q2" vid="PSA 68:28">kasiimpo manga lakina Zebulon tee lakina Naftali.<verse eid="PSA 68:28"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="29" style="v" sid="PSA 68:29"/>E Aulataʼala, palimbamea o kakaamu.</para>
  <para style="q2" vid="PSA 68:29">E Aulataʼala, susuakamea o kakaamu,</para>
  <para style="q2" vid="PSA 68:29">mboomo mopadhana ipewaumu to ingkami.<verse eid="PSA 68:29"/></para>
  <para style="q1">
    <verse number="30" style="v" sid="PSA 68:30"/>Rampaakanamo Bhanuamu i Yerusalem,</para>
  <para style="q2" vid="PSA 68:30">manga raja abhawa pasombaa to Ingkoo.<verse eid="PSA 68:30"/></para>
  <para style="q1">
    <verse number="31" style="v" sid="PSA 68:31"/>Gorampangia o Mesir, lipu mboomo binata maila i tanga-tangana gelaga,</para>
  <para style="q2" vid="PSA 68:31">gorampangia o Mesir, lipu mboomo gulumana sapi umane tee manga anana, siitumo manga lipu mokokuasa.</para>
  <para style="q1" vid="PSA 68:31">Pahancurua manga incia momasoʼoakana pera,</para>
  <para style="q2" vid="PSA 68:31">papogaa-gaaia manga lipu momaasiakana potimbea.<verse eid="PSA 68:31"/></para>
  <para style="q1">
    <verse number="32" style="v" sid="PSA 68:32"/>Manga potolowea bheaumba minaaka i Mesir,</para>
  <para style="q2" vid="PSA 68:32">tee miana Etiopia lausaka bheataanaka limana tee adhawu pasombaana i Aulataʼala.<verse eid="PSA 68:32"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="33" style="v" sid="PSA 68:33"/>Lagumo to Aulataʼala, e bhari-bharia lipu i dunia sii!</para>
  <para style="q2" vid="PSA 68:33">Laguakamo lagu kapujia to Kawasana Opu, <char style="qs">Sela</char><verse eid="PSA 68:33"/></para>
  <para style="q1">
    <verse number="34" style="v" sid="PSA 68:34"/>to Incia mosawina i kareta modhalana i bhawona laiana, siitumo laiana modhaangiana pepuu minaaka i zamani mangenge.</para>
  <para style="q1" vid="PSA 68:34">Rangoa, Incia apaperangoaka suarana,</para>
  <para style="q2" vid="PSA 68:34">suarana amakaa tee akoguntu.<verse eid="PSA 68:34"/></para>
  <para style="q1">
    <verse number="35" style="v" sid="PSA 68:35"/>Akuimea o kuasana Aulataʼala!</para>
  <para style="q2" vid="PSA 68:35">Kaogena dhaangia i bhawona lipu Israel,</para>
  <para style="q2" vid="PSA 68:35">kuasana akawea i laiana.<verse eid="PSA 68:35"/></para>
  <para style="q1">
    <verse number="36" style="v" sid="PSA 68:36"/>E Aulataʼala, Ingkoo inda umentela mpuu</para>
  <para style="q2" vid="PSA 68:36">wakutuuna ulimba minaaka i tampana mbooresamu momangkilo!</para>
  <para style="q2" vid="PSA 68:36">Aulataʼala isombana miana Israel adhawuaka kuasana tee kakaana to uumatina.</para>
  <para style="b" vid="PSA 68:36"/>
  <para style="q1" vid="PSA 68:36">Atopujimo Aulataʼala!<verse eid="PSA 68:36"/></para>
  <chapter eid="PSA 68"/>
  <chapter number="69" style="c" sid="PSA 69"/>
  <para style="s">Doʼa i Wakutuuna Kaseke</para>
  <para style="sr">
    <ref loc="PSA 69:1-37">69:1-37</ref></para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 69:1"/>To kapalana molaguna. Aose lagu: Kamba-kamba Bakung. Zaburuna Daud.<verse eid="PSA 69:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 69:2"/>Pasalaamatiaku, e Aulataʼala,</para>
  <para style="q2" vid="PSA 69:2">roonamo o uwe akawamo i bhorokoku.<verse eid="PSA 69:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 69:3"/>Iaku kutondu i nuncana tomba momandala,</para>
  <para style="q2" vid="PSA 69:3">inda dhaangia o tampana polandakaku.</para>
  <para style="q1" vid="PSA 69:3">Iaku kukotibu i uwe momandala,</para>
  <para style="q2" vid="PSA 69:3">tee o mawa apaampeaku.<verse eid="PSA 69:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 69:4"/>Iaku kumangule kugora kuemani tulungi;</para>
  <para style="q2" vid="PSA 69:4">goncoku amatuu.</para>
  <para style="q1" vid="PSA 69:4">Mataku amalau kuantagi Aulataʼalaku.<verse eid="PSA 69:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 69:5"/>
    <note caller="-" style="x">
      <char style="xo" closed="false">69:5 </char>
      <char style="xt" closed="false">
        <ref loc="PSA 35:19">Zab. 35:19</ref>; <ref loc="JHN 15:25">Yah. 15:25</ref>.</char>
    </note>Mia mobanciaku inda akoʼalasa,</para>
  <para style="q2" vid="PSA 69:5">alabhi o kabharina minaaka i bulua i bhaaku.</para>
  <para style="q1" vid="PSA 69:5">Manga mia mogauna mopabinasaaku abhari mpuu;</para>
  <para style="q2" vid="PSA 69:5">manga incia amembali musuku inda akosababu.</para>
  <para style="q1" vid="PSA 69:5">Iaku apakisaaku kubholosi</para>
  <para style="q2" vid="PSA 69:5">harataa inda irampasiku.<verse eid="PSA 69:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 69:6"/>E Aulataʼala, Ingkoo umataua o kabhongo-bhongoku,</para>
  <para style="q2" vid="PSA 69:6">manga kasalahaku inda atobuniaka minaaka i Ingkoo.<verse eid="PSA 69:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 69:7"/>Bholi utaroakea manga mia motangkaakako</para>
  <para style="q2" vid="PSA 69:7">apotibhaaka kaea roonamo iaku, e KAWASANA OPU, Aulataʼalana saangua alamu!</para>
  <para style="q1" vid="PSA 69:7">Bholi utaroakea manga mia mopeeloko</para>
  <para style="q2" vid="PSA 69:7">apotibhaaka aebu roonamo iaku, e Aulataʼala isombana miana Israel!<verse eid="PSA 69:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 69:8"/>Rampaakanamo Ingkoo iaku kutohina,</para>
  <para style="q2" vid="PSA 69:8">tee o kae atutubhi rouku.<verse eid="PSA 69:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 69:9"/>Iaku mboomo dhaga to manga witinaiku,</para>
  <para style="q2" vid="PSA 69:9">tee bhari-bharia witinaiku aabhiaku mia moumba.<verse eid="PSA 69:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 69:10"/>
    <note caller="-" style="x">
      <char style="xo" closed="false">69:10 </char>
      <char style="xt" closed="false">
        <ref loc="JHN 2:17">Yah. 2:17</ref>; <ref loc="ROM 15:3">Rom. 15:3</ref>.</char>
    </note>Ngangarandaku akarore-rore to kuewaaka bhanuamu, sabutuna apekangauaku,</para>
  <para style="q2" vid="PSA 69:10">tee o kahinana manga mia mohinako akangkanaiaku.<verse eid="PSA 69:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 69:11"/>Wakutuuna kupaporitambe karoku tee kupoasa,</para>
  <para style="q2" vid="PSA 69:11">iaku kumembali kahinana mia.<verse eid="PSA 69:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 69:12"/>Wakutuuna kupake kae kadhu to tandana kusukara,</para>
  <para style="q2" vid="PSA 69:12">rampaakanamo sumai manga incia apotawaikiaku.<verse eid="PSA 69:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 69:13"/>Iaku kumembali giu ipogauakana manga mia mouncurana i bhambana lawana kota</para>
  <para style="q2" vid="PSA 69:13">tee apamembaliaku lagu kaele-elena manga pande sumpu.<verse eid="PSA 69:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 69:14"/>Maka kudoʼa i Ingkoo, e KAWASANA OPU,</para>
  <para style="q2" vid="PSA 69:14">e Aulataʼala, lawaniaku i wakutuu momalape;</para>
  <para style="q1" vid="PSA 69:14">lawaniaku roonamo kaasimu molagina motaralabhi-labhi</para>
  <para style="q2" vid="PSA 69:14">tee roonamo katulungimu momembalina iparacaeaku.<verse eid="PSA 69:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 69:15"/>Pasalaamatiaku minaaka i nuncana tomba,</para>
  <para style="q2" vid="PSA 69:15">tee bholi utaroakaaku kutondu.</para>
  <para style="q1" vid="PSA 69:15">Rambasakaaku minaaka i manga mia mobanciaku</para>
  <para style="q2" vid="PSA 69:15">tee minaaka i uwe momandala.<verse eid="PSA 69:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 69:16"/>Bholi utaroakaaku apaampeaku mawa,</para>
  <para style="q2" vid="PSA 69:16">atawa kutondu i tawo momandala.</para>
  <para style="q2" vid="PSA 69:16">Bholi utaroakaaku kutokoburu i nuncana bhalo.<verse eid="PSA 69:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 69:17"/>E KAWASANA OPU, maasangia ulawaniaku roonamo kaasimu molagina amalape,</para>
  <para style="q2" vid="PSA 69:17">poilimo tee urangoaku rampaakanamo rahumatimu momaoge.<verse eid="PSA 69:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 69:18"/>Bholi ubuniaka roumu minaaka i bhatuamu</para>
  <para style="q2" vid="PSA 69:18">roonamo iaku kunarakaa, lawaniakumo pekadhei.<verse eid="PSA 69:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 69:19"/>Umbamo pasalaamatiaku,</para>
  <para style="q2" vid="PSA 69:19">pabebasiaku minaaka i manga musuku.<verse eid="PSA 69:19"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 69:20"/>Ingkoo umataua tuaapa o musuku aele-eleaku, apekaeaaku tee ahinaaku.</para>
  <para style="q2" vid="PSA 69:20">Ingkoo ukamatea bhari-bharia musuku.<verse eid="PSA 69:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 69:21"/>Kahinana sumai apahancuru incaku,</para>
  <para style="q2" vid="PSA 69:21">sabutuna amate o akalaku.</para>
  <para style="q1" vid="PSA 69:21">Iaku kuharapu kaasina mia, maka inda dhaangia;</para>
  <para style="q2" vid="PSA 69:21">iaku kupeelo mia mohiburuaku, maka inda kupotibhaakea.<verse eid="PSA 69:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 69:22"/>
    <note caller="-" style="x">
      <char style="xo" closed="false">69:22 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 27:48">Mat. 27:48</ref>; <ref loc="MRK 15:36">Mrk. 15:36</ref>; <ref loc="JHN 19:28-29">Yah. 19:28-29</ref>.</char>
    </note>Sampe manga incia uka adhawuaku racu to kukandea,</para>
  <para style="q2" vid="PSA 69:22">tee wakutuuna amatuu bhorokoku, adhawuaku cuka to kusumpua.<verse eid="PSA 69:22"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 69:23"/>
    <note caller="-" style="x">
      <char style="xo" closed="false">69:23-24 </char>
      <char style="xt" closed="false">
        <ref loc="ROM 11:9-10">Rom. 11:9-10</ref>.</char>
    </note>Taroakamo kinande i aroana manga incia amembali katapu to karona,</para>
  <para style="q2" vid="PSA 69:23">tee amembali kapetambo to manga sabhangkana.<verse eid="PSA 69:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 69:24"/>Taroakamo matana manga incia amarawu mamudhaakana inda amembali apokamata,</para>
  <para style="q2" vid="PSA 69:24">tee taroakamo o tangana manga incia sadia arengku.<verse eid="PSA 69:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 69:25"/>Palimbamea pamurumu to manga incia,</para>
  <para style="q2" vid="PSA 69:25">tee taroakamo o amaramu mokarore-rorena akangkanai manga incia.<verse eid="PSA 69:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 69:26"/>
    <note caller="-" style="x">
      <char style="xo" closed="false">69:26 </char>
      <char style="xt" closed="false">
        <ref loc="ACT 1:20">Tul. 1:20</ref>.</char>
    </note>Taroakamo pokemaana manga incia amembali amalino,</para>
  <para style="q2" vid="PSA 69:26">tee taroakamo inda samia uka momboorena i kemana manga incia.<verse eid="PSA 69:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 69:27"/>Roonamo manga incia apajere manga mia mopadhana ibhebhemu,</para>
  <para style="q2" vid="PSA 69:27">tee apetulatulaaka o kanarakaana manga mia mopadhana ipekambelamu.<verse eid="PSA 69:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 69:28"/>Taroakamo urangania kabharina kasalahana manga incia,</para>
  <para style="q2" vid="PSA 69:28">tee manga incia bholi upabanarea.<verse eid="PSA 69:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="PSA 69:29"/>
    <note caller="-" style="x">
      <char style="xo" closed="false">69:29 </char>
      <char style="xt" closed="false">
        <ref loc="EXO 32:32">Limb. 32:32</ref>; <ref loc="REV 3:5">Wah. 3:5</ref>; <ref loc="REV 13:8">13:8</ref>; <ref loc="REV 17:8">17:8</ref>.</char>
    </note>Taroakamo o sarona manga incia uhapusua minaaka i nuncana boku mokoantoakana manga sarona mia momalape,</para>
  <para style="q2" vid="PSA 69:29">tee o sarona manga incia bholi upapesuaia i nuncana daftarana mia mobanara.<verse eid="PSA 69:29"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="30" style="v" sid="PSA 69:30"/>Maka iaku sii kunarakaa tee kumapii.</para>
  <para style="q2" vid="PSA 69:30">E Aulataʼala, tulungiaku</para>
  <para style="q2" vid="PSA 69:30">tee ujaganiaku.<verse eid="PSA 69:30"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="31" style="v" sid="PSA 69:31"/>Iaku bhekulagu to kupuji sarona Aulataʼala,</para>
  <para style="q2" vid="PSA 69:31">tee kusukuru tee kumuliangia.<verse eid="PSA 69:31"/></para>
  <para style="q1">
    <verse number="32" style="v" sid="PSA 69:32"/>Giu incia sumai alabhi alaenga i matana KAWASANA OPU minaaka i binata pasombaa,</para>
  <para style="q2" vid="PSA 69:32">tee minaaka i sapi umane maoge mokotandu tee mokokonuku mopoweta.<verse eid="PSA 69:32"/></para>
  <para style="q1">
    <verse number="33" style="v" sid="PSA 69:33"/>Manga mia monarakaa bheakamatea tee akaunde-unde.</para>
  <para style="q2" vid="PSA 69:33">Taroakamo incamiu adhadhi pendua, e ingkomiu mopeelona Aulataʼala!<verse eid="PSA 69:33"/></para>
  <para style="q1">
    <verse number="34" style="v" sid="PSA 69:34"/>KAWASANA OPU aperangoi mia misikini,</para>
  <para style="q2" vid="PSA 69:34">tee Incia inda apandaʼente uumatina modhaangiana i nuncana katorongku.<verse eid="PSA 69:34"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="35" style="v" sid="PSA 69:35"/>Taroakamo Incia apujia bhari-bharia modhaangiana i laiana tee i dunia,</para>
  <para style="q2" vid="PSA 69:35">i tawo tee bhari-bharia mahaluku modhadhina i nuncana tawo<verse eid="PSA 69:35"/></para>
  <para style="q1">
    <verse number="36" style="v" sid="PSA 69:36"/>roonamo Aulataʼala bheapasalaamati Kota Sion,</para>
  <para style="q2" vid="PSA 69:36">tee apendua abhangu manga kota i Tana Yuda</para>
  <para style="q2" vid="PSA 69:36">mamudhaakana manga bhatuana amboore tee akotanaaka lipu incia sumai saʼumurua.<verse eid="PSA 69:36"/></para>
  <para style="q1">
    <verse number="37" style="v" sid="PSA 69:37"/>Siwuluna minaaka i manga bhatuana bhemokotinaurakaakea,</para>
  <para style="q2" vid="PSA 69:37">tee manga mia momaasiakana Kawasana Opu bheamboore i nuncana.<verse eid="PSA 69:37"/></para>
  <chapter eid="PSA 69"/>
  <chapter number="70" style="c" sid="PSA 70"/>
  <para style="s">Doʼa Emaniana Katulungi</para>
  <para style="sr">
    <ref loc="PSA 70:1-6">70:1-6</ref></para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 70:1"/>To kapalana molaguna. Zaburuna Daud. Zikiri i wakutuuna pasombaana kurubanina kaudhania.<verse eid="PSA 70:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 70:2"/>
    <note caller="-" style="x">
      <char style="xo" closed="false">70:2-6 </char>
      <char style="xt" closed="false">
        <ref loc="PSA 40:14-18">Zab. 40:14-18</ref>.</char>
    </note>E Aulataʼala, pasalaamatiaku!</para>
  <para style="q2" vid="PSA 70:2">E KAWASANA OPU, tulungiaku pekadhei!<verse eid="PSA 70:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 70:3"/>Taroakamo manga mia mogauna mopekamateaku</para>
  <para style="q2" vid="PSA 70:3">amaea tee apalai roonamo abingu.</para>
  <para style="q1" vid="PSA 70:3">Taroakamo manga mia mogauna mopacilakaaku</para>
  <para style="q2" vid="PSA 70:3">apotibhaaka kahina tee aʼaebu.<verse eid="PSA 70:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 70:4"/>Taroakamo manga mia mopogauna, "Namisia, namisia!" tee mopotawaikiaku</para>
  <para style="q2" vid="PSA 70:4">abhalili roonamo amaea.<verse eid="PSA 70:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 70:5"/>Taroakamo bhari-bharia mia mopeeloko</para>
  <para style="q2" vid="PSA 70:5">asambo-sambo tee akaunde-unde roonamo Ingkoo.</para>
  <para style="q1" vid="PSA 70:5">Taroakamo manga mia momaasiakana kasalaamati minaaka i Ingkoo</para>
  <para style="q2" vid="PSA 70:5">sadia apogau, "Tapanamo kalanga o Aulataʼala!"<verse eid="PSA 70:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 70:6"/>Iaku sii kunarakaa tee kumisikini,</para>
  <para style="q2" vid="PSA 70:6">umbamo pekadhei, e Aulataʼala!</para>
  <para style="q1" vid="PSA 70:6">Ingkoomo motulungiaku tee mopasalaamatiaku.</para>
  <para style="q2" vid="PSA 70:6">E KAWASANA OPU bholi upekanoe-noe!<verse eid="PSA 70:6"/></para>
  <chapter eid="PSA 70"/>
  <chapter number="71" style="c" sid="PSA 71"/>
  <para style="s">Doʼa Emaniana Peulusa i Wakutuu Tamancuana</para>
  <para style="sr">
    <ref loc="PSA 71:1-24">71:1-24</ref></para>
  <para style="b"/>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 71:1"/>E KAWASANA OPU, Ingkoomo o peulusaku,</para>
  <para style="q2" vid="PSA 71:1">bholi sampeampearo kutopekaea.<verse eid="PSA 71:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 71:2"/>Rambasakaaku, tee upabebasiaku roonamo Ingkoo ubanara;</para>
  <para style="q2" vid="PSA 71:2">perangoiaku tee upasalaamatiaku.<verse eid="PSA 71:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 71:3"/>Membalimo gunu bhatu to tampana mbooresaku</para>
  <para style="q2" vid="PSA 71:3">sadia momembalina iumbatiku.</para>
  <para style="q1" vid="PSA 71:3">Ingkoo padhamo udhawu parinta mamudhaakana kutopasalaamati</para>
  <para style="q2" vid="PSA 71:3">roonamo Ingkoomo gunu bhatu mojaganiaku tee bente potaangiaku.<verse eid="PSA 71:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 71:4"/>E Aulataʼalaku, pasalaamatiaku minaaka i limana mia madhaki,</para>
  <para style="q2" vid="PSA 71:4">minaaka i kuasana mia inda moʼadili tee mia masega.<verse eid="PSA 71:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 71:5"/>Ingkoomo iharapuku, e KAWASANA OPU Aulataʼala,</para>
  <para style="q2" vid="PSA 71:5">Ingkoomo iparacaeaku minaaka dhaangia kumangura.<verse eid="PSA 71:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 71:6"/>Ingkoomo o tampana kupasande minaaka i nuncana kadhuma;</para>
  <para style="q2" vid="PSA 71:6">Ingkoomo mopalimbaaku minaaka i kompona inaku,</para>
  <para style="q2" vid="PSA 71:6">sumaimo iaku sadia kupujiko.<verse eid="PSA 71:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 71:7"/>Iaku kumembali mboomo mia ipeelona manga pande pana,</para>
  <para style="q2" vid="PSA 71:7">maka Ingkoomo o tampana peulusaku momakaa.<verse eid="PSA 71:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 71:8"/>Ngangaku sadia apujiko,</para>
  <para style="q2" vid="PSA 71:8">saeoa iaku kumuliangiko.<verse eid="PSA 71:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 71:9"/>Bholi ubhanakaaku i wakutuuna kumancuana,</para>
  <para style="q2" vid="PSA 71:9">tee bholi ubholiaku ande atopadhamo kakaaku.<verse eid="PSA 71:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 71:10"/>Sababuna manga musuku apogauakaaku,</para>
  <para style="q2" vid="PSA 71:10">tee manga mia mogauna mopekamateaku asahimuakaaku.<verse eid="PSA 71:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 71:11"/>Pogauna manga incia, "Aulataʼala padhamo abholi incia!</para>
  <para style="q2" vid="PSA 71:11">Pajeremea tee urakomea roonamo inda dhaangia bhemorambasakea!"<verse eid="PSA 71:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 71:12"/>E Aulataʼala, bholi umaridho minaaka i iaku,</para>
  <para style="q2" vid="PSA 71:12">e Aulataʼalaku, tulungiaku pekadhei!<verse eid="PSA 71:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 71:13"/>Taroakamo mia moraeakaaku</para>
  <para style="q2" vid="PSA 71:13">apotibhaaka kaea tee abinasa.</para>
  <para style="q1" vid="PSA 71:13">Taroakamo manga mia mogauna mopacilakaaku</para>
  <para style="q2" vid="PSA 71:13">abukeaka kahina tee aebu.<verse eid="PSA 71:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 71:14"/>Maka sadia kuharapu,</para>
  <para style="q2" vid="PSA 71:14">tee iaku ahandamo bhekupujiko.<verse eid="PSA 71:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 71:15"/>Ngangaku saeoa bhekupetulatulaaka manga pewaumu mobanara,</para>
  <para style="q2" vid="PSA 71:15">tee kasalaamati inda motolentu minaaka i Ingkoo.<verse eid="PSA 71:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 71:16"/>Iaku bhekuumba tee kupuji pewauna momakaana KAWASANA OPU Aulataʼala.</para>
  <para style="q2" vid="PSA 71:16">Iaku bhekumuliangiakea tangkanamo kaʼadilina Karomu samia.<verse eid="PSA 71:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 71:17"/>E Aulataʼala, minaaka kumangura Ingkoo moadhariaku,</para>
  <para style="q2" vid="PSA 71:17">tee sakawana sii-sii iaku kupetulatulaaka pewaumu inda momentela.<verse eid="PSA 71:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 71:18"/>Sampe sakawana kumancuana tee kukouwa uka,</para>
  <para style="q2" vid="PSA 71:18">e Aulataʼala, bholi ubholiaku,</para>
  <para style="q1" vid="PSA 71:18">mamudhaakana kumembali kupakoleleaka kuasamu i siwulu sii-sii,</para>
  <para style="q2" vid="PSA 71:18">tee kaogesamu i bhari-bharia mia bhemoumbana naile itu.<verse eid="PSA 71:18"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 71:19"/>E Aulataʼala, kuasamu tee kabanaramu akawea i laiana!</para>
  <para style="q2" vid="PSA 71:19">Ingkoo padhamo upewau manga giu momaoge,</para>
  <para style="q2" vid="PSA 71:19">e Aulataʼala, incema mopokanana tee Ingkoo?<verse eid="PSA 71:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 71:20"/>Ingkoo padhamo utaroakaaku kunamisi bhari kanarakaa tee balaa,</para>
  <para style="q2" vid="PSA 71:20">Ingkoo uka bheupadhadhiaku pendua.</para>
  <para style="q2" vid="PSA 71:20">Minaaka i nuncana koburu</para>
  <para style="q2" vid="PSA 71:20">Ingkoo bheuangkaaku pendua.<verse eid="PSA 71:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 71:21"/>Ingkoo bheupamembaliaku ajulu kutohoromati,</para>
  <para style="q2" vid="PSA 71:21">tee uhiburuaku pendua.<verse eid="PSA 71:21"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 71:22"/>Iaku bhekupujiko tee gambusu</para>
  <para style="q2" vid="PSA 71:22">roonamo umembali utoparacaea, e Aulataʼalaku.</para>
  <para style="q1" vid="PSA 71:22">Tee kecapi Iaku bhekulaguaka lagu kapujia to Ingkoo,</para>
  <para style="q2" vid="PSA 71:22">e Momangkilona, Aulataʼala isombana miana Israel!<verse eid="PSA 71:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 71:23"/>Bhiwiku bheasambo-sambo</para>
  <para style="q2" vid="PSA 71:23">wakutuuna kulaguaka lagu kapujia to Ingkoo,</para>
  <para style="q1" vid="PSA 71:23">apokana uka mboomo inyawaku mopadhana itolosimu.<verse eid="PSA 71:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 71:24"/>Dhelaku bheapakoleleaka</para>
  <para style="q2" vid="PSA 71:24">katulungimu mobanara saeoa,</para>
  <para style="q1" vid="PSA 71:24">roonamo manga mia mopadhana moʼusahana to mopacilakaaku</para>
  <para style="q2" vid="PSA 71:24">amembali amaea tee amajule.<verse eid="PSA 71:24"/></para>
  <chapter eid="PSA 71"/>
  <chapter number="72" style="c" sid="PSA 72"/>
  <para style="s">Doʼa Iharapuaka to Raja</para>
  <para style="sr">
    <ref loc="PSA 72:1-20">72:1-20</ref></para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 72:1"/>Zaburuna Sulaiman.<note caller="+" style="f"><char style="fr" closed="false">72:1 </char><char style="ft" closed="false">Sulaiman o anana Raja Daud momembalina rajana Israel sapadhana Daud.</char></note></para>
  <para style="b" vid="PSA 72:1"/>
  <para style="q1" vid="PSA 72:1">E Kawasana Opu, dhawuakea o kaʼadilimu to raja,</para>
  <para style="q2" vid="PSA 72:1">tee udhawuakea o kabanaramu to anana raja.<verse eid="PSA 72:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 72:2"/>Maasangia incia aʼadili uumatimu tee kabanara,</para>
  <para style="q2" vid="PSA 72:2">tee aʼadili apewau mia motopisaki.<verse eid="PSA 72:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 72:3"/>Maasangia manga gunu aumbaaka kasanaa to raʼeati,</para>
  <para style="q2" vid="PSA 72:3">tee manga kabumbu ahasiliaka kabanara.<verse eid="PSA 72:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 72:4"/>Maasangia incia bheaewaaka parakarana</para>
  <para style="q2" vid="PSA 72:4">manga mia motopisaki i tanga-tangana raʼeati,</para>
  <para style="q1" vid="PSA 72:4">apasalaamati manga mia misikini</para>
  <para style="q1" vid="PSA 72:4">tee apahancuru manga pande pisaki.<verse eid="PSA 72:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 72:5"/>Maasangia manga incia bheamaeka i Ingkoo</para>
  <para style="q2" vid="PSA 72:5">kangengena dhaangia tee matanaeo</para>
  <para style="q1" vid="PSA 72:5">tee kangengena dhaangia tee bula,</para>
  <para style="q2" vid="PSA 72:5">saʼumurua.<verse eid="PSA 72:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 72:6"/>Maasangia raja incia sumai mboomo uwena wao mosapona</para>
  <para style="q2" vid="PSA 72:6">i bhawona rumpu mopadhana motoweli,</para>
  <para style="q2" vid="PSA 72:6">tee mboomo wao maranca mobubusina dunia.<verse eid="PSA 72:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 72:7"/>Maasangia o kabanara sadhaadhaa aniʼimatia raʼeati kangengena raja dhaangiapo adhadhi,</para>
  <para style="q2" vid="PSA 72:7">tee o kasanaa ataralabhi-labhi sakawana bula indamo dhaangia.<verse eid="PSA 72:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 72:8"/>Incia bheakokuasa minaaka i tawo sakawana i tawo,</para>
  <para style="q2" vid="PSA 72:8">minaaka i Umala Efrat sakawana i tapana dunia.<verse eid="PSA 72:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 72:9"/>Manga mia momboorena i tana matuu</para>
  <para style="q2" vid="PSA 72:9">bheatungku i aroana,</para>
  <para style="q2" vid="PSA 72:9">tee manga musuna adhelapi ngawuna tana.<verse eid="PSA 72:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 72:10"/>Maasangia manga raja minaaka i Tarsis tee manga raja minaaka i pulo-pulo mosagaanana</para>
  <para style="q2" vid="PSA 72:10">bheabhawaakea hadia.</para>
  <para style="q1" vid="PSA 72:10">Maasangia manga raja minaaka i Syeba tee Seba</para>
  <para style="q2" vid="PSA 72:10">abhawa pasombaa to incia.<verse eid="PSA 72:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 72:11"/>Maasangia bhari-bharia raja bheasuju i aroana,</para>
  <para style="q2" vid="PSA 72:11">tee bhari-bharia lipu apabhatua karona i incia.<verse eid="PSA 72:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 72:12"/>Roonamo incia bhearambasaka mia misikini mogorana i incia,</para>
  <para style="q2" vid="PSA 72:12">tee atolosi mia motopisaki tee mia inda mototulungi.<verse eid="PSA 72:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 72:13"/>Incia bheamaasiaka mia misikini tee mia monarakaa,</para>
  <para style="q2" vid="PSA 72:13">tee apasalaamati inyawana mia inda mokokadhaangia.<verse eid="PSA 72:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 72:14"/>Tee bheatolosi dhadhina manga incia minaaka i mia masega tee mopisakina manga incia,</para>
  <para style="q2" vid="PSA 72:14">sababuna o dhadhina manga incia akoharagaa mpuu i matana.<verse eid="PSA 72:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 72:15"/>Maasangia amarambe o umuruna!</para>
  <para style="q2" vid="PSA 72:15">Maasangia o bulawa minaaka i Syeba atopasombaaka to incia.</para>
  <para style="q1" vid="PSA 72:15">Maasangia incia sadia atodoʼaaka,</para>
  <para style="q2" vid="PSA 72:15">tee saeoa o mia aemaniakea barakati.<verse eid="PSA 72:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 72:16"/>Maasangia o gandum ataralabhi-labhi i saangua lipu,</para>
  <para style="q2" vid="PSA 72:16">akawea i lolona gunu.</para>
  <para style="q1" vid="PSA 72:16">Maasangia o hasilina tanana asuburu mboomo i Libanon,</para>
  <para style="q2" vid="PSA 72:16">tee o raʼeatina kotana ajulu o kabharina mboomo rumpu i tana lapa.<verse eid="PSA 72:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 72:17"/>Maasangia o sarona raja atoudhani saʼumurua,</para>
  <para style="q2" vid="PSA 72:17">maasangia sahandana abhari o mia momatauna sarona, kangengena dhaangiapo tee matanaeo.</para>
  <para style="b" vid="PSA 72:17"/>
  <para style="q1" vid="PSA 72:17">Maasangia bhari-bharia lipu bheapotibhaaka barakati roonamo incia,</para>
  <para style="q2" vid="PSA 72:17">tee bhari-bharia lipu asarongiakea amasanaa.<verse eid="PSA 72:17"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 72:18"/>Atopujimo KAWASANA OPU, siitumo Aulataʼala isombana miana Israel,</para>
  <para style="q2" vid="PSA 72:18">mopewauna manga giu inda momentela samia-miana!<verse eid="PSA 72:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 72:19"/>Atopujimo sarona momuliana saʼumurua!</para>
  <para style="q2" vid="PSA 72:19">Maasangia saangua alamu abukeaka tee kamuliangina.</para>
  <para style="q2" vid="PSA 72:19">Aamin, aamin!<verse eid="PSA 72:19"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 72:20"/>Mboo siimo kapadhaana doʼana Daud bin Isai.<verse eid="PSA 72:20"/></para>
  <chapter eid="PSA 72"/>
  <chapter number="73" style="c" sid="PSA 73"/>
  <para style="ms">BOKU I TALU ANGUNA:</para>
  <para style="mr">ZABURU 73--89</para>
  <para style="s1">Giu Imeriaka tee Giu Iharapu</para>
  <para style="sr">
    <ref loc="PSA 73:1-28">73:1-28</ref></para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 73:1"/>Zaburuna Asaf.<note caller="+" style="f"><char style="fr" closed="false">73:1</char><char style="fq" closed="false">Asaf: </char><char style="ft" closed="false">Incia apatugasiakea Nabii Daud to akapalai molaguna i nuncana Bhanuana Aulataʼala.</char></note></para>
  <para style="q1" vid="PSA 73:1">Satotuuna o Aulataʼala sumai amalape tee miana Israel,</para>
  <para style="q2" vid="PSA 73:1">tee mia morelana totona incana.<verse eid="PSA 73:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 73:2"/>Maka iaku saidhepo kusindoli,</para>
  <para style="q2" vid="PSA 73:2">tee saidhepo kumanduli,<verse eid="PSA 73:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 73:3"/>roonamo kugigibulu kukamata mia mosombo</para>
  <para style="q2" vid="PSA 73:3">wakutuuna kukamata kasanaana tee karangkaeana mia madhaki.<verse eid="PSA 73:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 73:4"/>Manga incia inda anamisi kapii,</para>
  <para style="q2" vid="PSA 73:4">badana manga incia amalompo tee amakaa.<verse eid="PSA 73:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 73:5"/>Manga incia inda anamisi kanarakaa mboomo mia mosagaanana,</para>
  <para style="q2" vid="PSA 73:5">tee manga incia inda akangkanaia balaa mboomo maanusia mosagaanana.<verse eid="PSA 73:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 73:6"/>Siitumo o sababuna manga incia aporanteaka tee pewau mosombo,</para>
  <para style="q2" vid="PSA 73:6">tee kasegana asalibumbuaka karona mboomo juba.<verse eid="PSA 73:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 73:7"/>Matana manga incia aʼuntu roonamo kaogena bukuna,</para>
  <para style="q2" vid="PSA 73:7">ngangarandana manga incia abukeaka tee manga haejati madhaki.<verse eid="PSA 73:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 73:8"/>Manga incia tee kadhakina aele-ele tee apeonii mia mosagaanana,</para>
  <para style="q2" vid="PSA 73:8">tee kalangana incana manga incia apekapahanda tee apekapisaki.<verse eid="PSA 73:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 73:9"/>Ngangana manga incia ahina sorogaa,</para>
  <para style="q2" vid="PSA 73:9">tee dhelana atipua saangua dunia to abhoasaka manga pogau inda mokoguna.<verse eid="PSA 73:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 73:10"/>Sumaimo manga mia ambuli aose manga incia,</para>
  <para style="q2" vid="PSA 73:10">tee inda apotibhaaka saangu kasalaha uka minaaka i manga incia.<verse eid="PSA 73:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 73:11"/>Tee manga mia madhaki apogau, "Tuaapa o Aulataʼala bheamataua opea ipewaumami?</para>
  <para style="q2" vid="PSA 73:11">Buaka Incia Momalangana dhaangia tee imatauna?"<verse eid="PSA 73:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 73:12"/>Kamatamea, mboo siimo manga mia madhaki:</para>
  <para style="q2" vid="PSA 73:12">manga incia atanangi torosu tee o harataana ahandamo abhari.<verse eid="PSA 73:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 73:13"/>Satotuuna asia-siamo kujagani ngangarandaku mamudhaakana amangkilo,</para>
  <para style="q2" vid="PSA 73:13">tee kubhanui limaku to tandana inda kusala.<verse eid="PSA 73:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 73:14"/>Roonamo saeoa akangkanaiaku balaa,</para>
  <para style="q2" vid="PSA 73:14">tee saraneeo-saraneeo kutohukumu.<verse eid="PSA 73:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 73:15"/>Ande kupogau, "Iaku gauku kupogau mboo sumai,"</para>
  <para style="q2" vid="PSA 73:15">sumaimo iaku kuhianati siwuluna uumatimu.<verse eid="PSA 73:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 73:16"/>Maka i wakutuuna kuʼusaha to kumaʼanaia,</para>
  <para style="q2" vid="PSA 73:16">hali incia sumai amarasai mpuu to iaku;<verse eid="PSA 73:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 73:17"/>siimpo kumataua o kapadhaana dhadhina manga incia</para>
  <para style="q2" vid="PSA 73:17">wakutuuna kupesua i nuncana bhanuana Aulataʼala.<verse eid="PSA 73:17"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 73:18"/>Satotuuna, i tampa momararo udhika manga incia,</para>
  <para style="q2" vid="PSA 73:18">tee upekandawua manga sakawana abinasa.<verse eid="PSA 73:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 73:19"/>Manga incia abinasa sakijamata,</para>
  <para style="q2" vid="PSA 73:19">apaampea sakawana amofu minaaka i kamingkiri.<verse eid="PSA 73:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 73:20"/>Manga mia madhaki bheaila mboomo pongipi i wakutuuna o mia atobhangu i koleana.</para>
  <para style="q2" vid="PSA 73:20">E Kawasana Opu, kaudhania to manga incia uhapusua wakutuuna ubhangu.<verse eid="PSA 73:20"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 73:21"/>Wakutuuna ngangarandaku amaporo mpuu,</para>
  <para style="q2" vid="PSA 73:21">tee o baatiniku mboomo isusu-susu,<verse eid="PSA 73:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 73:22"/>iaku kukabhongo-bhongo tee inda tee imaʼanaiku,</para>
  <para style="q2" vid="PSA 73:22">i aroamu iaku mboomo binata inda mokoʼakala.<verse eid="PSA 73:22"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 73:23"/>Moomini mboo sumai, iaku sadia i saripimu.</para>
  <para style="q2" vid="PSA 73:23">Ingkoo ukeni lima kaanaku.<verse eid="PSA 73:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 73:24"/>Ingkoo utondaaku tee naasehatimu,</para>
  <para style="q2" vid="PSA 73:24">tee utarimaaku tee kahoromati naile itu.<verse eid="PSA 73:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 73:25"/>Incema motulungiaku i sorogaa ande mencuana Ingkoo?</para>
  <para style="q2" vid="PSA 73:25">I dunia sii inda dhaangia ipeeluku, ande mencuana Ingkoo.<verse eid="PSA 73:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 73:26"/>Inyawa tee badaku amembali amofu tee abinasa,</para>
  <para style="q2" vid="PSA 73:26">maka o Aulataʼala kakaana incaku</para>
  <para style="q2" vid="PSA 73:26">tee o tinaurakaku saʼumurua.<verse eid="PSA 73:26"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 73:27"/>Satotuuna o mia momaridhona minaaka i Ingkoo bheabinasa.</para>
  <para style="q2" vid="PSA 73:27">Ingkoo bheupabinasa manga mia mohianatiko.<verse eid="PSA 73:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 73:28"/>Maka to iaku, tapanamo kalape ande kupomakasu tee Aulataʼala,</para>
  <para style="q2" vid="PSA 73:28">KAWASANA OPU Aulataʼala bhekupamembalia o tampana peulusaku</para>
  <para style="q2" vid="PSA 73:28">mamudhaakana kumembali kupetulatulaakea bhari-bharia ipewaumu!<verse eid="PSA 73:28"/></para>
  <chapter eid="PSA 73"/>
  <chapter number="74" style="c" sid="PSA 74"/>
  <para style="s">Laguna Kaporona Inca roonamo Bhanua Momangkilo Atopahancuru</para>
  <para style="sr">
    <ref loc="PSA 74:1-23">74:1-23</ref></para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 74:1"/>Lagu kaadharina Asaf.</para>
  <para style="b" vid="PSA 74:1"/>
  <para style="q1" vid="PSA 74:1">E Aulataʼala, pokia Ingkoo ubhanaka ingkami? Buaka ingkami tatomendeu saʼumurua?</para>
  <para style="q2" vid="PSA 74:1">Pokia pamurumu akarore-rore tee manga dumba igembalamu?<verse eid="PSA 74:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 74:2"/>Maasangia uudhania o uumatimu mopadhana ipotibhaakamu i piamo itu,</para>
  <para style="q2" vid="PSA 74:2">lipu mopadhana itolosimu amembali lipu tinaurakamu.</para>
  <para style="q1" vid="PSA 74:2">Udhania Gunu Sion,</para>
  <para style="q2" vid="PSA 74:2">tampa mopadhana iumbatimu to umbooresia.<verse eid="PSA 74:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 74:3"/>Paporopea bhengkalamu i tampa mohancuru saʼumurua sumai;</para>
  <para style="q2" vid="PSA 74:3">bhari-bharia bara i nuncana tampa momangkilo padhamo apahancurua musu.<verse eid="PSA 74:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 74:4"/>Manga bhalimu akakee-kee, "Takanamo!" i tampamu momangkilo,</para>
  <para style="q2" vid="PSA 74:4">tee apakaro manga tombi to tandana ande manga incia akana minaaka i ingkami.<verse eid="PSA 74:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 74:5"/>Atokamata mboomo mia moangkana ndamuna apekalanga-langea</para>
  <para style="q2" vid="PSA 74:5">to apale manga puuna kau i koo.<verse eid="PSA 74:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 74:6"/>Bhari-bharia bara ibheloki</para>
  <para style="q2" vid="PSA 74:6">andamua tee apalua.<verse eid="PSA 74:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 74:7"/>Manga incia atunu bhanua ibaadatimu sakawana arata tee tana,</para>
  <para style="q2" vid="PSA 74:7">tee apanaajisi tampana mbooresamu.<note caller="+" style="f"><char style="fr" closed="false">74:7 </char><char style="fq" closed="false">mbooresamu: </char><char style="ft" closed="false">I nuncana pogau Ibrani, "tampa mbooresana saromu;" sarona Aulataʼala apokana tee Aulataʼala karona.</char></note><verse eid="PSA 74:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 74:8"/>I nuncana ngangarandana manga incia apogau,</para>
  <para style="q1" vid="PSA 74:8">"Mai tapisakia bhari-bharia!"</para>
  <para style="q2" vid="PSA 74:8">Manga incia atunu bhari-bharia tampana ibaadati i lipu sii.<verse eid="PSA 74:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 74:9"/>Ingkami indamo uka takamata manga tanda inda momentela,</para>
  <para style="q2" vid="PSA 74:9">samia nabii uka inda dhaangia,</para>
  <para style="q1" vid="PSA 74:9">inda samia uka i tanga-tangamami momataua</para>
  <para style="q2" vid="PSA 74:9">sakawana naepia bhari-bharia sii amembali.<verse eid="PSA 74:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 74:10"/>E Aulataʼala, sakawana naepia manga bhali bheaele-eleko?</para>
  <para style="q2" vid="PSA 74:10">Buaka saʼumurua o musu bheahina saromu?<verse eid="PSA 74:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 74:11"/>Pokia Ingkoo uhelaia pendua o lima kaanamu?</para>
  <para style="q2" vid="PSA 74:11">Pokia Ingkoo soo usaku-saku limamu? Pepadhaimea manga incia!<verse eid="PSA 74:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 74:12"/>Maka o Aulataʼala o rajaku minaaka i piamo itu.</para>
  <para style="q2" vid="PSA 74:12">Incia mopasalaamatina ingkami i dunia.<verse eid="PSA 74:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 74:13"/>
    <note caller="-" style="x">
      <char style="xo" closed="false">74:13 </char>
      <char style="xt" closed="false">
        <ref loc="EXO 14:21">Limb. 14:21</ref>.</char>
    </note>Tee kakaamu Ingkoo uweta tawo,</para>
  <para style="q2" vid="PSA 74:13">tee upasaki bhaana manga Lewiatan i tawo.<verse eid="PSA 74:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 74:14"/>
    <note caller="-" style="x">
      <char style="xo" closed="false">74:14 </char>
      <char style="xt" closed="false">
        <ref loc="JOB 40:20">Ayb. 40:20</ref>; <ref loc="PSA 104:26">Zab. 104:26</ref>; <ref loc="ISA 27:1">Yes. 27:1</ref>.</char>
    </note>Ingkoo upekapuro manga bhaana Lewiatan,<note caller="+" style="f"><char style="fr" closed="false">74:14 </char><char style="fq" closed="false">Lewiatan: </char><char style="ft" closed="false">Mahalukuna tawo mboomo naga.</char></note></para>
  <para style="q2" vid="PSA 74:14">tee upamembalia kinandena manga binata momboorena i tana matuu.<verse eid="PSA 74:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 74:15"/>Ingkoo mobungkalena matana uwe tee umala;</para>
  <para style="q2" vid="PSA 74:15">sainamo manga umala mokouwena torotorosu, upekatuua.<verse eid="PSA 74:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 74:16"/>Ingkoomo mopadhaangiana eo tee malo,</para>
  <para style="q2" vid="PSA 74:16">Ingkoomo modhikana matanaeo tee bula.<verse eid="PSA 74:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 74:17"/>Ingkoo mopatotapuakana bhari-bharia tidhana alamu,</para>
  <para style="q2" vid="PSA 74:17">Ingkoo mopewauna bulaana paneeo tee bulaana wao.<verse eid="PSA 74:17"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 74:18"/>Udhania tuaapa o musumu aele-eleko, e KAWASANA OPU,</para>
  <para style="q2" vid="PSA 74:18">lipu mokaafiri ahina saromu.<verse eid="PSA 74:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 74:19"/>Bholi upasaraaka inyawana manu-manu jarajaramu i binata masega,</para>
  <para style="q2" vid="PSA 74:19">tee bholi umalinguakea to saʼumurua inyawana uumatimu motopisaki.<verse eid="PSA 74:19"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 74:20"/>Udhania o pojanjia ipewaumu tee ingkami,</para>
  <para style="q2" vid="PSA 74:20">roonamo manga tampa malalanda i dunia sii abukeaka tee manga mia mopewauna kasega.<verse eid="PSA 74:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 74:21"/>Bholi utaroakea o mia motopisaki ambuli atopekaea,</para>
  <para style="q2" vid="PSA 74:21">maka maasangia o mia monarakaa tee mia misikini bheapuji saromu.<verse eid="PSA 74:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 74:22"/>E Aulataʼala, bhangumo, ewaakea o parakaramu;</para>
  <para style="q2" vid="PSA 74:22">udhania ande manga mia mokaafiri ahinako saeoa.<verse eid="PSA 74:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 74:23"/>Bholi umalinguakea o suarana manga bhalimu,</para>
  <para style="q2" vid="PSA 74:23">tee o karobhona manga mia moewangiko apene torotorosu.<verse eid="PSA 74:23"/></para>
  <chapter eid="PSA 74"/>
  <chapter number="75" style="c" sid="PSA 75"/>
  <para style="s">Kawasana Opu, Haakimu Moʼadili</para>
  <para style="sr">
    <ref loc="PSA 75:1-11">75:1-11</ref></para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 75:1"/>To kapalana molaguna.</para>
  <para style="q1" vid="PSA 75:1">Zaburuna Asaf to lagu: Bholi Upahancurua.<verse eid="PSA 75:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 75:2"/>Ingkami tasukuru i Ingkoo, e Aulataʼala;</para>
  <para style="q2" vid="PSA 75:2">ingkami tasukuru i Ingkoo roonamo umakasu.</para>
  <para style="q1" vid="PSA 75:2">Manga mia apetulatulaaka bhari-bharia pewaumu inda momentela.<verse eid="PSA 75:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 75:3"/>"I wakutuu mopadhana itantuakaku,</para>
  <para style="q2" vid="PSA 75:3">Iaku bhekuhaakimu tee kaʼadili.<verse eid="PSA 75:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 75:4"/>I wakutuuna alamu tee bhari-bharia antona atolendu,</para>
  <para style="q2" vid="PSA 75:4">Iakumo bhemopekatangkana manga ariina. <char style="qs">Sela</char><verse eid="PSA 75:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 75:5"/>To manga mia mosombo Iaku kupogau, 'Bholi usombo,'</para>
  <para style="q2" vid="PSA 75:5">kasiimpo to mia madhaki, 'Bholi upepujiaka kakaamu;<verse eid="PSA 75:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 75:6"/>bholi upepujiaka kakaamu uewangi sorogaa,</para>
  <para style="q2" vid="PSA 75:6">atawa upogau tee upataja bhorokomu.' "<verse eid="PSA 75:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 75:7"/>Roonamo Incia Mokanana minaaka i timbu tee minaaka i bhara,</para>
  <para style="q2" vid="PSA 75:7">Inciamo Mokanana minaaka i tana matuu sakawana i tana mokogunu.<note caller="+" style="f"><char style="fr" closed="false">75:7 </char><char style="ft" closed="false">Dhaangia uka o kitabi tee Zaburu incia sii motoburina mboo sii, "Kahoromati inda aumba minaaka i timbu atawa minaaka i bhara, atawa uka minaaka i tana matuu."</char></note><verse eid="PSA 75:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 75:8"/>Aulataʼala o haakimu;</para>
  <para style="q2" vid="PSA 75:8">Incia apaporitambe mia mosala tee apekalanga mia mobanara.<verse eid="PSA 75:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 75:9"/>Roonamo pamuruna KAWASANA OPU mboomo tonde i limana,</para>
  <para style="q2" vid="PSA 75:9">akoantoaka uwena angguru mokobura, mobukeakana tee kajalona rampa.</para>
  <para style="q1" vid="PSA 75:9">Incia bhealali antona,</para>
  <para style="q2" vid="PSA 75:9">mamudhaakana o kulimpasana bheasumpua tee apepadhaia</para>
  <para style="q2" vid="PSA 75:9">bhari-bharia mia madhaki i dunia.<verse eid="PSA 75:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 75:10"/>Maka iaku saʼumurua bhekupakoleleaka giu incia sii,</para>
  <para style="q2" vid="PSA 75:10">Iaku bhekulaguaka lagu kapujia to Aulataʼala isombana Yakub.<verse eid="PSA 75:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 75:11"/>Iaku bhekupekakatu bhari-bharia kakaana mia madhaki,</para>
  <para style="q2" vid="PSA 75:11">maka o kakaana mia mobanara bhekurangania.<verse eid="PSA 75:11"/></para>
  <chapter eid="PSA 75"/>
  <chapter number="76" style="c" sid="PSA 76"/>
  <para style="s">Kawasana Opu, Haakimuna Bhari-bharia Lipu</para>
  <para style="sr">
    <ref loc="PSA 76:1-13">76:1-13</ref></para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 76:1"/>To kapalana molaguna.</para>
  <para style="q1" vid="PSA 76:1">Tee atikiakea kecapi. Zaburuna Asaf to lagu.<verse eid="PSA 76:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 76:2"/>Manga miana Yuda amatau Aulataʼala,</para>
  <para style="q2" vid="PSA 76:2">sarona amaoge i Israel.<verse eid="PSA 76:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 76:3"/>Bhanuana i Yerusalem,</para>
  <para style="q2" vid="PSA 76:3">tee tampana mbooresana i Gunu Sion.<verse eid="PSA 76:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 76:4"/>Iwe sumakomo Incia akatuki bhari-bharia manga ewangana potimbeana musuna,</para>
  <para style="q2" vid="PSA 76:4">bhari-bharia panana mokakila-kila, katangkesina, tee hancuna. <char style="qs">Sela</char><verse eid="PSA 76:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 76:5"/>Ingkoo ukocahea mpuu!</para>
  <para style="q2" vid="PSA 76:5">Alabhi umulia minaaka i manga gunu modhaangiana i zamani mangenge.<verse eid="PSA 76:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 76:6"/>Hasilina potimbea padhamo atorampasi minaaka i manga mia mobarani.<note caller="+" style="f"><char style="fr" closed="false">76:6 </char><char style="fq" closed="false">hasilina potimbea: </char><char style="ft" closed="false">I zamani mangenge, ande saangu lipu atalo lipu mosagaanana, lipu mokana sumai bearampasi manga giu mokoharagaa mboomo maanusia, bulawa, pakea, tee binata tee abhawea i lipuna.</char></note></para>
  <para style="q2" vid="PSA 76:6">Manga incia atokole saʼumurua;</para>
  <para style="q1" vid="PSA 76:6">inda dhaangia minaaka i tantarana sumai</para>
  <para style="q2" vid="PSA 76:6">momembalina moangkana limana uka.<verse eid="PSA 76:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 76:7"/>E Aulataʼala isombana Yakub, roonamo kagorampangimu,</para>
  <para style="q2" vid="PSA 76:7">manga ajara tee mosawikia amalimpu.<verse eid="PSA 76:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 76:8"/>Atotuu-totuu Ingkoo utomaeka mpuu!</para>
  <para style="q2" vid="PSA 76:8">Incema momembalina mopotaangina i aroamu wakutuuna upamuru?<verse eid="PSA 76:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 76:9"/>Minaaka i sorogaa uparangoakea o kambotuna kahukumumu,</para>
  <para style="q2" vid="PSA 76:9">alamu uka amaeka tee inda tee uuʼuuna<verse eid="PSA 76:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 76:10"/>wakutuuna Aulataʼala abhangu to apaʼadili</para>
  <para style="q2" vid="PSA 76:10">tee apasalaamati bhari-bharia mia motopisaki i alamu. <char style="qs">Sela</char><verse eid="PSA 76:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 76:11"/>Satotuuna o pamurumu tee maanusia imembaliakamu utopuji,</para>
  <para style="q2" vid="PSA 76:11">tee bhilaana pamurumu sumai upamembalia kabhokena tangamu.<verse eid="PSA 76:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 76:12"/>Pojanjimo tee upomeamea o tolauna onimu sumai i KAWASANA OPU, Aulataʼalamu!</para>
  <para style="q2" vid="PSA 76:12">Taroakamo bhari-bharia modhaangiana i saripina</para>
  <para style="q2" vid="PSA 76:12">abhawa pasombaana to Incia molaengana imaeka.<verse eid="PSA 76:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 76:13"/>Incia mopekamatena akalana manga mia mokokuasa,</para>
  <para style="q2" vid="PSA 76:13">tee manga raja i dunia amaeka i aroana.<verse eid="PSA 76:13"/></para>
  <chapter eid="PSA 76"/>
  <chapter number="77" style="c" sid="PSA 77"/>
  <para style="s">Ipewauna Kawasana Opu i Piamo itu</para>
  <para style="sr">
    <ref loc="PSA 77:1-21">77:1-21</ref></para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 77:1"/>To kapalana molaguna. Zaburuna Asaf to Yedutun.<verse eid="PSA 77:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 77:2"/>Iaku kugora i Aulataʼala tee suara momandii,</para>
  <para style="q2" vid="PSA 77:2">i Aulataʼala kugora, mamudhaakana aperangoiaku.<verse eid="PSA 77:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 77:3"/>I piamo itu, i eona kumaseke kupeelo Kawasana Opu,</para>
  <para style="q2" vid="PSA 77:3">tee wakutuuna amalo kutanaaka limaku inda kumangumangule;</para>
  <para style="q2" vid="PSA 77:3">ngangarandaku inda aunda atotautau.<verse eid="PSA 77:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 77:4"/>Ande kuudhani Aulataʼala, kupekidhei;</para>
  <para style="q2" vid="PSA 77:4">ande kupeudhaudhani,<note caller="+" style="f"><char style="fr" closed="false">77:4 </char><char style="fq" closed="false">kupeudhaudhani: </char><char style="ft" closed="false">Atawa "kupekidei;" dhaangia giu apokana i aeati </char><char style="xt"><ref loc="PSA 77:7">77:7</ref> </char> tee <char style="xt"><ref loc="PSA 77:13">77:13</ref> </char>uka.</note> ahanda amaule ngangarandaku. <char style="qs">Sela</char><verse eid="PSA 77:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 77:5"/>Ingkoo mopamembalina mataku sadhaadhaa atobungkale;</para>
  <para style="q2" vid="PSA 77:5">alilaho o namisiku sabutuna inda amembali kupogauaka opeopea.<verse eid="PSA 77:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 77:6"/>Kufikifikiriaka zamani i piamo itu,</para>
  <para style="q2" vid="PSA 77:6">tee i tao-tao molapa.<verse eid="PSA 77:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 77:7"/>Iaku kuudhani laguku i wakutuuna amalo,</para>
  <para style="q2" vid="PSA 77:7">kupeudhaudhani i nuncana ngangarandaku, tee o rohiku apekaabha-abha,<verse eid="PSA 77:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 77:8"/>"Buaka Kawasana Opu bheamanga bholi to saʼumurua?</para>
  <para style="q2" vid="PSA 77:8">Tee indamo uka manga maasiaka?<verse eid="PSA 77:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 77:9"/>Buaka atopadhamo o kaasina molagina?</para>
  <para style="q2" vid="PSA 77:9">Buaka amapupumo janjina saʼumurua?<verse eid="PSA 77:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 77:10"/>Buaka o Aulataʼala amalingumo to manga maasiaka?</para>
  <para style="q2" vid="PSA 77:10">Buaka i nuncana pamuruna Incia atutubhi rahumatina? <char style="qs">Sela</char><verse eid="PSA 77:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 77:11"/>Kasiimpo kupogau, "Siimo kaporona incaku</para>
  <para style="q2" vid="PSA 77:11">ande o lima kaanana Momalangana Mpuu indamo ajaganiaku."<verse eid="PSA 77:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 77:12"/>Iaku bhekuudhani opea mopadhana ipewauna KAWASANA OPU.</para>
  <para style="q2" vid="PSA 77:12">Umbe, iaku bhekuudhani manga giu inda momentela mopadhana ipewaumu i zamani i piamo itu.<verse eid="PSA 77:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 77:13"/>Iaku bhekuudhaudhania i nuncana ngangarandaku bhari-bharia ikarajaamu,</para>
  <para style="q2" vid="PSA 77:13">tee kufikifikiria bhari-bharia giu momaoge mopadhana ipewaumu.<verse eid="PSA 77:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 77:14"/>Dhalamu amangkilo, e Aulataʼala,</para>
  <para style="q2" vid="PSA 77:14">Dewa iapai momaogena mboo Aulataʼalamami?<verse eid="PSA 77:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 77:15"/>Ingkoomo Aulataʼala mopewauna giu inda momentela.</para>
  <para style="q2" vid="PSA 77:15">Ingkoo padhamo ususuaka kuasamu i tanga-tangana manga lipu.<verse eid="PSA 77:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 77:16"/>Tee limamu utolosi uumatimu,</para>
  <para style="q2" vid="PSA 77:16">siitumo siwuluna Yakub tee Yusuf. <char style="qs">Sela</char><verse eid="PSA 77:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 77:17"/>E Aulataʼala, uwe akamatako,</para>
  <para style="q2" vid="PSA 77:17">uwe akamatako tee amaeka;</para>
  <para style="q2" vid="PSA 77:17">umbe, andalaoge uka atorende.<verse eid="PSA 77:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 77:18"/>Taʼina ngalu apasapo wao maranca,</para>
  <para style="q2" vid="PSA 77:18">tee o laiana uka akanduu-nduu;</para>
  <para style="q2" vid="PSA 77:18">manga anana panamu akakila-kila.<verse eid="PSA 77:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 77:19"/>Ruuna guntumu atorango i nuncana tambusisi,</para>
  <para style="q2" vid="PSA 77:19">tee o bhibhitomu apekainawa dunia.</para>
  <para style="q2" vid="PSA 77:19">Alamu uka akolendu tee atorende.<verse eid="PSA 77:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 77:20"/>Dhalamu alaloi tawo,</para>
  <para style="q2" vid="PSA 77:20">tee udhala upolimba i andalaoge;</para>
  <para style="q2" vid="PSA 77:20">maka o tandarana aemu inda atokamata.<verse eid="PSA 77:20"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 77:21"/>
    <note caller="-" style="x">
      <char style="xo" closed="false">77:21 </char>
      <char style="xt" closed="false">
        <ref loc="PSA 23:1">Zab. 23:1</ref>.</char>
    </note>Ingkoo ugembalaaka uumatimu mboomo mia mowuluna gulumana dumba</para>
  <para style="q2" vid="PSA 77:21">tee upake limana Musa tee Harun to akapalai manga incia.<verse eid="PSA 77:21"/></para>
  <chapter eid="PSA 77"/>
  <chapter number="78" style="c" sid="PSA 78"/>
  <para style="s">Kalapena Kawasana Opu tee Miana Israel Mokodosa</para>
  <para style="sr">
    <ref loc="PSA 78:1-72">78:1-72</ref></para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 78:1"/>Lagu kaadharina Asaf.</para>
  <para style="b" vid="PSA 78:1"/>
  <para style="q1" vid="PSA 78:1">E lipuku, rangoa o kaadhariku,</para>
  <para style="q2" vid="PSA 78:1">taaia o talingamu tee opea ipogauakaku.<verse eid="PSA 78:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 78:2"/>
    <note caller="-" style="x">
      <char style="xo" closed="false">78:2 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 13:35">Mat. 13:35</ref>.</char>
    </note>Iaku bhekubungkale ngangaku to kupakawaaka ibarati,</para>
  <para style="q2" vid="PSA 78:2">tee bhekupogauaka manga pogau rahasia modhaangiana minaaka i zamani piamo itu,<verse eid="PSA 78:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 78:3"/>siitumo manga giu mopadhana irangomami tee imataumami,</para>
  <para style="q2" vid="PSA 78:3">tee mopadhana ipetulatulaakana manga opu-opuamami.<verse eid="PSA 78:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 78:4"/>Ingkami inda bhetabuniakea minaaka i anaanana manga incia,</para>
  <para style="q2" vid="PSA 78:4">maka ingkami bhetapetulatulaakea i siwuluna sapadhana ingkami</para>
  <para style="q1" vid="PSA 78:4">manga kapujia to KAWASANA OPU tee kakaana,</para>
  <para style="q2" vid="PSA 78:4">tee manga giu inda momentela mopadhana ipewauna.<verse eid="PSA 78:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 78:5"/>Incia padhamo apakawaaka tuturana to siwuluna Yakub,</para>
  <para style="q2" vid="PSA 78:5">tee apatotapuaka Hukumuna Taurati i tanga-tangana miana Israel.</para>
  <para style="q1" vid="PSA 78:5">Incia atumpu manga opu-opuata to aadhariakea i anana manga incia<verse eid="PSA 78:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 78:6"/>mamudhaakana o siwulu bhemoumbana amataua,</para>
  <para style="q2" vid="PSA 78:6">siitumo manga anaana bhemolaahirina naile itu.</para>
  <para style="q1" vid="PSA 78:6">Kasiimpo manga incia uka bheaumba</para>
  <para style="q2" vid="PSA 78:6">tee apetulatulaakea i anana manga incia.<verse eid="PSA 78:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 78:7"/>Tee mboo sumai manga incia bheadhika kaparacaeana i Aulataʼala,</para>
  <para style="q2" vid="PSA 78:7">tee inda amalinguaka opea ipewauna Aulataʼala,</para>
  <para style="q2" vid="PSA 78:7">maka ataʼatia manga parintana;<verse eid="PSA 78:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 78:8"/>tee bholi mboomo opu-opuana miana Israel,</para>
  <para style="q2" vid="PSA 78:8">adorohaka tee aewangiaku,</para>
  <para style="q1" vid="PSA 78:8">siitumo opu-opuana tee ngangarandana inda atotapu i Aulataʼala,</para>
  <para style="q2" vid="PSA 78:8">tee manga incia inda ataʼatia.<verse eid="PSA 78:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 78:9"/>Miana Efraim mokoewangaakana pana sumai,</para>
  <para style="q2" vid="PSA 78:9">abhalili tee apalai i eona potimbea.<verse eid="PSA 78:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 78:10"/>Manga incia inda akenia pekatangka o pojanjiana tee Aulataʼala,</para>
  <para style="q2" vid="PSA 78:10">tee amendeu aose hukumuna.<verse eid="PSA 78:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 78:11"/>Manga incia amalinguakea opea mopadhana ikarajaana Kawasana Opu</para>
  <para style="q2" vid="PSA 78:11">tee amalinguaka manga giu inda momentela mopadhana ipakamataakana to manga incia.<verse eid="PSA 78:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 78:12"/>
    <note caller="-" style="x">
      <char style="xo" closed="false">78:12 </char>
      <char style="xt" closed="false">
        <ref loc="EXO 7:8-12:32">Limb. 7:8--12:32</ref>.</char>
    </note>I aroana opu-opuana manga incia, Aulataʼala apewau giu inda momentela,</para>
  <para style="q2" vid="PSA 78:12">i atina Zoan i Tana Mesir.<verse eid="PSA 78:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 78:13"/>
    <note caller="-" style="x">
      <char style="xo" closed="false">78:13 </char>
      <char style="xt" closed="false">
        <ref loc="EXO 14:21-22">Limb. 14:21-22</ref>.</char>
    </note>Incia aweta tawo tee ataroakea manga incia apolimba,</para>
  <para style="q2" vid="PSA 78:13">tee o uwe apekakatea mboomo rindi.<verse eid="PSA 78:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 78:14"/>
    <note caller="-" style="x">
      <char style="xo" closed="false">78:14 </char>
      <char style="xt" closed="false">
        <ref loc="EXO 13:21-22">Limb. 13:21-22</ref>.</char>
    </note>Wakutuuna pontanga eo manga incia atondaia apapooseakea tee taʼina ngalu,</para>
  <para style="q2" vid="PSA 78:14">tee wakutuuna malo manga incia apapooseakea tee caheana waa.<verse eid="PSA 78:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 78:15"/>
    <note caller="-" style="x">
      <char style="xo" closed="false">78:15-16 </char>
      <char style="xt" closed="false">
        <ref loc="EXO 17:1-7">Limb. 17:1-7</ref>.</char>
    </note>Incia aweta manga bhatu i tana matuu,</para>
  <para style="q2" vid="PSA 78:15">tee adhawua manga asumpu ataralabhi-labhi, mboomo minaaka i andalaoge.<verse eid="PSA 78:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 78:16"/>Incia apalimba uwe minaaka i bhatu,</para>
  <para style="q2" vid="PSA 78:16">sabutuna o uwe sumai asiwulu mboomo umala.<verse eid="PSA 78:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 78:17"/>Maka manga incia dhaangiapo uka torotorosu akodosa</para>
  <para style="q2" vid="PSA 78:17">tee adorohaka i Momalangana i tana matuu.<verse eid="PSA 78:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 78:18"/>
    <note caller="-" style="x">
      <char style="xo" closed="false">78:18-31 </char>
      <char style="xt" closed="false">
        <ref loc="EXO 16:2-15">Limb. 16:2-15</ref>.</char>
    </note>Manga incia acobai Aulataʼala i nuncana ngangarandana</para>
  <para style="q2" vid="PSA 78:18">tee atuntu kinande ipeeluna apokana tee nawusuuna.<verse eid="PSA 78:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 78:19"/>Manga incia aewangi Aulataʼala tee apogau,</para>
  <para style="q2" vid="PSA 78:19">"Amembali buaka o Aulataʼala apasiapu kinande i tana matuu?<verse eid="PSA 78:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 78:20"/>Atotuumo ande o bhatu abhebhea sabutuna apidhiaka uwe</para>
  <para style="q2" vid="PSA 78:20">tee manga umala apasiwulua tee alua,</para>
  <para style="q2" vid="PSA 78:20">maka amembali buaka Incia manga dhawuaka roti,</para>
  <para style="q2" vid="PSA 78:20">atawa amembali buaka Incia apasiapu dagi to uumatina?"<verse eid="PSA 78:20"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 78:21"/>Sabutuna o KAWASANA OPU apamuru wakutuuna arango giu incia sumai;</para>
  <para style="q2" vid="PSA 78:21">waa morore akangkanai uumatina Yakub,</para>
  <para style="q2" vid="PSA 78:21">tee o pamuruna ahandamo mpuu to miana Israel,<verse eid="PSA 78:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 78:22"/>roonamo manga incia inda aʼiimani i Aulataʼala</para>
  <para style="q2" vid="PSA 78:22">tee inda aparacaea ande Incia bhemopasalaamatina manga incia.<verse eid="PSA 78:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 78:23"/>Maka Incia adhawu parintana to laiana,</para>
  <para style="q2" vid="PSA 78:23">tee abungkale manga bhambana sorogaa;<verse eid="PSA 78:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 78:24"/>
    <note caller="-" style="x">
      <char style="xo" closed="false">78:24 </char>
      <char style="xt" closed="false">
        <ref loc="JHN 6:31">Yah. 6:31</ref>.</char>
    </note>Incia apasapo waona manna<note caller="+" style="f"><char style="fr" closed="false">78:24 </char><char style="fq" closed="false">manna: </char><char style="ft" closed="false">Kinande idhawuakana Aulataʼala to miana Israel ipasapona i tana matuu saesaeo. Kamata </char><char style="xt" closed="false"><ref loc="EXO 16:2-15">Limb. 16:2-15</ref>.</char></note> mamudhaakana manga incia amembali akande,</para>
  <para style="q2" vid="PSA 78:24">tee mboo sumai Incia adhawuaka to manga incia o gandum minaaka i sorogaa.<verse eid="PSA 78:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 78:25"/>Maanusia akande rotina malaaʼekati;</para>
  <para style="q2" vid="PSA 78:25">Aulataʼala adhawuaka manga incia kinande motaralabhi-labhi.<verse eid="PSA 78:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 78:26"/>Incia atowii ngaluna timbu i laiana,</para>
  <para style="q2" vid="PSA 78:26">tee atowii ngaluna salata tee kuasana;<verse eid="PSA 78:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 78:27"/>Incia apasapo waona dagi mboomo ngawu o kabharina,</para>
  <para style="q2" vid="PSA 78:27">tee manu-manu mboomo kabharina bhone i tawo.<verse eid="PSA 78:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 78:28"/>Incia apakotibu manga manu-manu sumai i tanga-tangana pokemaana,</para>
  <para style="q2" vid="PSA 78:28">i saripina mbooresana manga incia.<verse eid="PSA 78:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="PSA 78:29"/>Kasiimpo manga incia akande sakawana amambosu mpuu,</para>
  <para style="q2" vid="PSA 78:29">roonamo Aulataʼala padhamo adhawuakea opea ipeeluna manga incia apokana tee nawusuuna.<verse eid="PSA 78:29"/></para>
  <para style="q1">
    <verse number="30" style="v" sid="PSA 78:30"/>Maka indapo uka manga incia atumpu incana,</para>
  <para style="q2" vid="PSA 78:30">siitumo tangasaana o kinande dhaangiapo i nuncana ngangana manga incia,<verse eid="PSA 78:30"/></para>
  <para style="q1">
    <verse number="31" style="v" sid="PSA 78:31"/>pamuruna Aulataʼala aumba tee abhali manga incia</para>
  <para style="q2" vid="PSA 78:31">tee ahobuti inyawana manga jampina manga incia,</para>
  <para style="q2" vid="PSA 78:31">tee apekamate manga ana mangurana Israel.<verse eid="PSA 78:31"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="32" style="v" sid="PSA 78:32"/>Moomini mboo sumai, manga incia sadhaadhaa akodosa,</para>
  <para style="q2" vid="PSA 78:32">manga incia inda aparacaea tee manga giu inda momentela mopadhana ipewauna.<verse eid="PSA 78:32"/></para>
  <para style="q1">
    <verse number="33" style="v" sid="PSA 78:33"/>Rampaakanamo sumai, Kawasana Opu apekamate manga incia mboomo sampearo tahela poinunca,</para>
  <para style="q2" vid="PSA 78:33">tee o dhadhina manga incia apepadhaia i nuncana balaa motomaeka mokawana inda inamu-namu.<verse eid="PSA 78:33"/></para>
  <para style="q1">
    <verse number="34" style="v" sid="PSA 78:34"/>Siitumo ande Incia apekamate sagaa minaaka i manga incia, siimpomo manga incia apeeloa;</para>
  <para style="q2" vid="PSA 78:34">manga incia atobamo tee abhalili apeelo Aulataʼala tee mpuu-mpuuna incana.<verse eid="PSA 78:34"/></para>
  <para style="q1">
    <verse number="35" style="v" sid="PSA 78:35"/>Manga incia audhania ande o Aulataʼala gunu bhatuna manga incia,</para>
  <para style="q2" vid="PSA 78:35">tee o Aulataʼala Momalanga motolosina manga incia.<verse eid="PSA 78:35"/></para>
  <para style="q1">
    <verse number="36" style="v" sid="PSA 78:36"/>Maka manga incia atipu Aulataʼala tee ngangana,</para>
  <para style="q2" vid="PSA 78:36">tee agau-gaua tee dhelana manga incia.<verse eid="PSA 78:36"/></para>
  <para style="q1">
    <verse number="37" style="v" sid="PSA 78:37"/>Ngangarandana manga incia inda atotapu i Aulataʼala;</para>
  <para style="q2" vid="PSA 78:37">manga incia inda akeniaka janjina.<verse eid="PSA 78:37"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="38" style="v" sid="PSA 78:38"/>Maka roonamo Incia amaasiaka uumatina,</para>
  <para style="q2" vid="PSA 78:38">sumaimo Aulataʼala aʼamponi kasalahana manga incia tee inda apabinasea.</para>
  <para style="q2" vid="PSA 78:38">Sampe Incia uka amenturu ataangi amarana,</para>
  <para style="q2" vid="PSA 78:38">tee inda apalimba pamuruna.<verse eid="PSA 78:38"/></para>
  <para style="q1">
    <verse number="39" style="v" sid="PSA 78:39"/>Incia amataua ande o maanusia inda abakaa,</para>
  <para style="q2" vid="PSA 78:39">manga incia mboomo ngalu molalo tee inda ambuli pendua.<verse eid="PSA 78:39"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="40" style="v" sid="PSA 78:40"/>Manga incia amenturu mpuu adorohaka tee Aulataʼala,</para>
  <para style="q2" vid="PSA 78:40">tee apekaporo incana i tana matuu.<verse eid="PSA 78:40"/></para>
  <para style="q1">
    <verse number="41" style="v" sid="PSA 78:41"/>Dhaangia pia mpearo manga incia acobai Aulataʼala,</para>
  <para style="q2" vid="PSA 78:41">tee apekaporo incana Momangkilona, Aulataʼala isombana miana Israel.<verse eid="PSA 78:41"/></para>
  <para style="q1">
    <verse number="42" style="v" sid="PSA 78:42"/>Manga incia inda audhania o kuasana,</para>
  <para style="q2" vid="PSA 78:42">tee inda audhania i wakutuuna Incia atolosi manga incia minaaka i bhalina;<verse eid="PSA 78:42"/></para>
  <para style="q1">
    <verse number="43" style="v" sid="PSA 78:43"/>i wakutuuna Incia apewau manga tanda inda momentela i Tana Mesir,</para>
  <para style="q2" vid="PSA 78:43">tee manga muuzizati i atina Zoan.<verse eid="PSA 78:43"/></para>
  <para style="q1">
    <verse number="44" style="v" sid="PSA 78:44"/>
    <note caller="-" style="x">
      <char style="xo" closed="false">78:44 </char>
      <char style="xt" closed="false">
        <ref loc="EXO 7:17-21">Limb. 7:17-21</ref>.</char>
    </note>Aulataʼala abhalii manga umala apamembalia raa,</para>
  <para style="q2" vid="PSA 78:44">mboo sumai uka tee manga siwuluna uwe,</para>
  <para style="q2" vid="PSA 78:44">sabutuna manga miana Mesir inda amembali asumpua.<verse eid="PSA 78:44"/></para>
  <para style="q1">
    <verse number="45" style="v" sid="PSA 78:45"/>
    <note caller="-" style="x">
      <char style="xo" closed="false">78:45 </char>
      <char style="xt" closed="false">
        <ref loc="EXO 8:1-6">Limb. 8:1-6</ref>; <ref loc="EXO 8:20-24">8:20-24</ref>.</char>
    </note>Incia aumbaaka gulumana lale mosampa to mopepadhaina manga incia,</para>
  <para style="q2" vid="PSA 78:45">tee aumbaaka barakaka to mopahancuruna manga incia.<verse eid="PSA 78:45"/></para>
  <para style="q1">
    <verse number="46" style="v" sid="PSA 78:46"/>
    <note caller="-" style="x">
      <char style="xo" closed="false">78:46 </char>
      <char style="xt" closed="false">
        <ref loc="EXO 10:12-15">Limb. 10:12-15</ref>.</char>
    </note>Incia adhawuaka hasilina timpuana manga incia mamudhaakana akandea o ulo-ulo,</para>
  <para style="q2" vid="PSA 78:46">tee o hasilina kanguleana bukuna manga incia to akandea kabhoro.<verse eid="PSA 78:46"/></para>
  <para style="q1">
    <verse number="47" style="v" sid="PSA 78:47"/>
    <note caller="-" style="x">
      <char style="xo" closed="false">78:47-48 </char>
      <char style="xt" closed="false">
        <ref loc="EXO 9:22-25">Limb. 9:22-25</ref>.</char>
    </note>Incia apahancuru puuna angguruna manga incia tee wao bhatu,</para>
  <para style="q2" vid="PSA 78:47">tee manga puuna arana manga incia tee alona esi.<verse eid="PSA 78:47"/></para>
  <para style="q1">
    <verse number="48" style="v" sid="PSA 78:48"/>Incia ataroaka o gulumana binatana manga incia akangkanaia waona bhatu,</para>
  <para style="q2" vid="PSA 78:48">tee o gulumana kadhambaakana manga incia akangkanaia bherese.<verse eid="PSA 78:48"/></para>
  <para style="q1">
    <verse number="49" style="v" sid="PSA 78:49"/>Aulataʼala arambasaka pamuruna mokarore-rore to manga incia;</para>
  <para style="q2" vid="PSA 78:49">amarana, lumbuna incana, tee kapiina incana,</para>
  <para style="q2" vid="PSA 78:49">mboomo sarombonga malaaʼekati moumbana to mopacilakana manga incia.<verse eid="PSA 78:49"/></para>
  <para style="q1">
    <verse number="50" style="v" sid="PSA 78:50"/>Aulataʼala ataroakea o pamuruna akarore-rore,</para>
  <para style="q2" vid="PSA 78:50">tee inda ajoli-joli manga incia mamudhaakana atopabinasa,</para>
  <para style="q2" vid="PSA 78:50">maka o inyawana manga incia apasaraakea i panyaki imateaka.<verse eid="PSA 78:50"/></para>
  <para style="q1">
    <verse number="51" style="v" sid="PSA 78:51"/>
    <note caller="-" style="x">
      <char style="xo" closed="false">78:51 </char>
      <char style="xt" closed="false">
        <ref loc="EXO 12:29">Limb. 12:29</ref>.</char>
    </note>Incia apekamate bhari-bharia ana umane tumpe i Mesir,</para>
  <para style="q2" vid="PSA 78:51">siitumo bhaa-bhaana o kakaana manga incia i pokemaa i Tana Ham.<verse eid="PSA 78:51"/></para>
  <para style="q1">
    <verse number="52" style="v" sid="PSA 78:52"/>
    <note caller="-" style="x">
      <char style="xo" closed="false">78:52 </char>
      <char style="xt" closed="false">
        <ref loc="EXO 13:17-22">Limb. 13:17-22</ref>.</char>
    </note>Maka o uumatina karona abhawea alimba mboomo dumba.</para>
  <para style="q2" vid="PSA 78:52">Incia atonda uumatina i tana matuu mboomo gulumana kadhambaaka.<verse eid="PSA 78:52"/></para>
  <para style="q1">
    <verse number="53" style="v" sid="PSA 78:53"/>
    <note caller="-" style="x">
      <char style="xo" closed="false">78:53 </char>
      <char style="xt" closed="false">
        <ref loc="EXO 14:26-28">Limb. 14:26-28</ref>.</char>
    </note>Incia akapalai uumatina sakawana asalaamati, sabutuna o uumatina inda amaeka;</para>
  <para style="q2" vid="PSA 78:53">sainamo musuna atanggalamu i nuncana tawo.<verse eid="PSA 78:53"/></para>
  <para style="q1">
    <verse number="54" style="v" sid="PSA 78:54"/>
    <note caller="-" style="x">
      <char style="xo" closed="false">78:54 </char>
      <char style="xt" closed="false">
        <ref loc="EXO 15:17">Limb. 15:17</ref>.</char>
    </note>Incia abhawa uumatina sakawana i tanana momangkilo,</para>
  <para style="q2" vid="PSA 78:54">i gunu incia siimo, mopadhana ipokawaakana tee lima kaanana.<verse eid="PSA 78:54"/></para>
  <para style="q1">
    <verse number="55" style="v" sid="PSA 78:55"/>Incia uka apadhencu manga lipu mosagaanana minaaka i aroana uumatina,</para>
  <para style="q2" vid="PSA 78:55">kasiimpo apapodhawu-dhawuakea tee kaʼukuru o lipu tinaurakana sumai to manga incia,</para>
  <para style="q2" vid="PSA 78:55">tee ataroaka manga lipuna Israel ambooresi kemana manga musuna.<verse eid="PSA 78:55"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="56" style="v" sid="PSA 78:56"/>Maka manga incia acobai Aulataʼala Momalanga,</para>
  <para style="q2" vid="PSA 78:56">tee adorohaka i Incia.</para>
  <para style="q2" vid="PSA 78:56">Manga incia inda aosea o parintana,<verse eid="PSA 78:56"/></para>
  <para style="q1">
    <verse number="57" style="v" sid="PSA 78:57"/>tee manga incia inda ataʼati tee ahianati pojanjiana tee Aulataʼala mboomo opu-opuana;</para>
  <para style="q2" vid="PSA 78:57">manga incia inda amembali atotangkaaka mboomo pana mobengko.<verse eid="PSA 78:57"/></para>
  <para style="q1">
    <verse number="58" style="v" sid="PSA 78:58"/>Manga incia apamembali Aulataʼala aʼamara tee tampana momalanga to apasombaaka kurubani;</para>
  <para style="q2" vid="PSA 78:58">manga incia apamembali Aulataʼala akaura-ura tee manga patuna dewana.<verse eid="PSA 78:58"/></para>
  <para style="q1">
    <verse number="59" style="v" sid="PSA 78:59"/>Wakutuuna o Aulataʼala arango giu incia sumai, Incia apamuru,</para>
  <para style="q2" vid="PSA 78:59">tee amendeu atarima miana Israel sampeampearo!<verse eid="PSA 78:59"/></para>
  <para style="q1">
    <verse number="60" style="v" sid="PSA 78:60"/>Incia amendeumo amboore i tampana mbooresana i Silo,<note caller="+" style="f"><char style="fr" closed="false">78:60 </char><char style="fq" closed="false">Silo: </char><char style="ft" closed="false">Tampana to Kema Momangkilo wakutuu bhaa-bhaana miana Israel apesua i Tana Kanaan, wakutuuna Baitulla indapo atopakakaro i Yerusalem.</char></note></para>
  <para style="q2" vid="PSA 78:60">siitumo o Kema Momangkilo, tampana mbooresana i tanga-tangana maanusia.<verse eid="PSA 78:60"/></para>
  <para style="q1">
    <verse number="61" style="v" sid="PSA 78:61"/>Incia ataroakea o sorongana pojanjiana atotaangi,</para>
  <para style="q2" vid="PSA 78:61">tee o tanda kamuliangina amandawu i limana bhali.<note caller="+" style="f"><char style="fr" closed="false">78:61</char><char style="fq" closed="false">tanda kamuliangina: </char><char style="ft" closed="false">Giu incia sii apogauaka tee asusuaka wakutuuna sorongana pojanjiana Kawasana Opu arampasia miana Filistin.</char></note><verse eid="PSA 78:61"/></para>
  <para style="q1">
    <verse number="62" style="v" sid="PSA 78:62"/>Incia ataroaka musu apekamate uumatina tee hancu,</para>
  <para style="q2" vid="PSA 78:62">tee apawoa amarana i uumatina karona.<verse eid="PSA 78:62"/></para>
  <para style="q1">
    <verse number="63" style="v" sid="PSA 78:63"/>Manga ana umane momangurana manga incia akandea waa</para>
  <para style="q2" vid="PSA 78:63">sabutuna inda atorango o laguna kawia to manga kabuabua.<verse eid="PSA 78:63"/></para>
  <para style="q1">
    <verse number="64" style="v" sid="PSA 78:64"/>Manga imamuna manga incia amateaka ewanga,</para>
  <para style="q2" vid="PSA 78:64">tee manga iaiarona imamu sumai inda atangisi umanena.<verse eid="PSA 78:64"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="65" style="v" sid="PSA 78:65"/>Kasiimpo abhangumo o KAWASANA OPU mboomo mia siimpo mobhanguna mokole,</para>
  <para style="q2" vid="PSA 78:65">mboomo jampi asambo-sambo sapadhana asumpu angguru.<verse eid="PSA 78:65"/></para>
  <para style="q1">
    <verse number="66" style="v" sid="PSA 78:66"/>Incia apewau manga bhalina apalaiaka karona;</para>
  <para style="q2" vid="PSA 78:66">Incia apewau manga incia amaea saʼumurua.<verse eid="PSA 78:66"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="67" style="v" sid="PSA 78:67"/>Incia amendeu siwuluna Yusuf</para>
  <para style="q2" vid="PSA 78:67">tee inda apili sukuna Efraim;<verse eid="PSA 78:67"/></para>
  <para style="q1">
    <verse number="68" style="v" sid="PSA 78:68"/>maka Incia apili sukuna Yuda,</para>
  <para style="q2" vid="PSA 78:68">siitumo Gunu Sion imaasiakana.<verse eid="PSA 78:68"/></para>
  <para style="q1">
    <verse number="69" style="v" sid="PSA 78:69"/>Incia apabhangu tampana momangkilo mboomo kalangana laiana,</para>
  <para style="q2" vid="PSA 78:69">tee mboomo alamu, momatangka to saʼumurua.<verse eid="PSA 78:69"/></para>
  <para style="q1">
    <verse number="70" style="v" sid="PSA 78:70"/>Aulataʼala apili Daud, o bhatuana,</para>
  <para style="q2" vid="PSA 78:70">tee aalea wakutuuna incia tangasaana ajagani gulumana dumba.<verse eid="PSA 78:70"/></para>
  <para style="q1">
    <verse number="71" style="v" sid="PSA 78:71"/>Aulataʼala aala Daud minaaka i karajaana awulu manga dumba mopadudu sumai</para>
  <para style="q2" vid="PSA 78:71">tee apamembalia mogembalaakana siwuluna Yakub,</para>
  <para style="q2" vid="PSA 78:71">siitumo o miana Israel, uumatina tee tinaurakana.<verse eid="PSA 78:71"/></para>
  <para style="q1">
    <verse number="72" style="v" sid="PSA 78:72"/>Tee karelana totona incana o Daud agembalaaka uumatina,</para>
  <para style="q2" vid="PSA 78:72">tee kakidhana incia amataua tuaapa o carana akapalai manga incia.<verse eid="PSA 78:72"/></para>
  <chapter eid="PSA 78"/>
  <chapter number="79" style="c" sid="PSA 79"/>
  <para style="s">Doʼana Uumati Motopisaki</para>
  <para style="sr">
    <ref loc="PSA 79:1-13">79:1-13</ref></para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 79:1"/>
    <note caller="-" style="x">
      <char style="xo" closed="false">79:1 </char>
      <char style="xt" closed="false">
        <ref loc="2KI 25:8-10">2Ra. 25:8-10</ref>; <ref loc="2CH 36:17-19">2Taw. 36:17-19</ref>; <ref loc="JER 52:12-14">Yer. 52:12-14</ref>.</char>
    </note>Zaburuna Asaf.</para>
  <para style="b" vid="PSA 79:1"/>
  <para style="q1" vid="PSA 79:1">E Aulataʼala, manga lipu inda momatauko apesuamo i nuncana tana tinaurakamu!</para>
  <para style="q2" vid="PSA 79:1">Manga incia apanaajisi Bhanuamu Momangkilo;</para>
  <para style="q2" vid="PSA 79:1">manga incia padhamo apahancuru saangua kota Yerusalem.<verse eid="PSA 79:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 79:2"/>Manga incia padhamo adhawuaka maeatina manga bhatuamu</para>
  <para style="q2" vid="PSA 79:2">to kinandena manga manu-manu i laiana,</para>
  <para style="q2" vid="PSA 79:2">tee o dagina maeatina manga mia mosaalihi to binata maila.<verse eid="PSA 79:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 79:3"/>Manga incia padhamo alali raana manga mia sumai mboomo uwe</para>
  <para style="q2" vid="PSA 79:3">i saangua kota Yerusalem, tee inda dhaangia mokoburua.<verse eid="PSA 79:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 79:4"/>Ingkami tamembalimo kahinana manga sarimbanuamami,</para>
  <para style="q2" vid="PSA 79:4">tee tamembali kaele-ele tee giu ipogauakana manga mia isaripimami.<verse eid="PSA 79:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 79:5"/>E KAWASANA OPU, sakawana naepia? Buaka Ingkoo bheupamuru to saʼumurua</para>
  <para style="q2" vid="PSA 79:5">tee amaramu bhearore mboomo waa roonamo ukaura-ura?<verse eid="PSA 79:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 79:6"/>Pasapomea o pamurumu</para>
  <para style="q2" vid="PSA 79:6">i bhawona manga lipu inda momatauko,</para>
  <para style="q1" vid="PSA 79:6">tee i bhawona manga pamarinta</para>
  <para style="q2" vid="PSA 79:6">inda mosombako!<verse eid="PSA 79:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 79:7"/>Sababuna manga incia padhamo apepadhaia uumatimu, siitumo siwuluna Yakub,</para>
  <para style="q2" vid="PSA 79:7">tee apahancuru mbooresana.<verse eid="PSA 79:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 79:8"/>Bholi upatanggoaka to ingkami o kasalahana manga opu-opuamami,</para>
  <para style="q2" vid="PSA 79:8">taroakamo o rahumatimu amadhei akawa i ingkami</para>
  <para style="q2" vid="PSA 79:8">roonamo amatemo akalamami.<verse eid="PSA 79:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 79:9"/>Manga tulungimo, e Aulataʼala mopasalaamatina ingkami,</para>
  <para style="q2" vid="PSA 79:9">to kaogesana saromu.</para>
  <para style="q1" vid="PSA 79:9">Rampaakanamo saromu,</para>
  <para style="q2" vid="PSA 79:9">manga rambasaka tee manga amponi minaaka i dosa-dosamami.<verse eid="PSA 79:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 79:10"/>Bholi utaroakea manga lipu mosagaanana aabha,</para>
  <para style="q2" vid="PSA 79:10">"Iapai o Aulataʼalana manga incia?"</para>
  <para style="q1" vid="PSA 79:10">Taroakamo ingkami takamatako wakutuuna ubalasi raana manga bhatuamu motopekamatena,</para>
  <para style="q2" vid="PSA 79:10">mamudhaakana manga lipu amataua.<verse eid="PSA 79:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 79:11"/>Taroakamo o pekidheina manga mia mototaangi</para>
  <para style="q2" vid="PSA 79:11">akawa i aroamu;</para>
  <para style="q1" vid="PSA 79:11">rampaakanamo kaogena kuasamu,</para>
  <para style="q2" vid="PSA 79:11">taroakamo adhadhiaka manga mia mopadhana itantuaka to atopekamate.<verse eid="PSA 79:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 79:12"/>Balasia manga lipu i saripimami sumai</para>
  <para style="q2" vid="PSA 79:12">pitu kali lipa o kahina mboomo mopadhana ipewauna manga incia to Ingkoo, e Kawasana Opu!<verse eid="PSA 79:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 79:13"/>Sumaimo ingkami o uumatimu, dumba igembalamu sii,</para>
  <para style="q2" vid="PSA 79:13">bhetasukuru i Ingkoo saʼumurua,</para>
  <para style="q2" vid="PSA 79:13">tee minaaka i siwulumami sakawana siwulu bhemoumbana bheapetulatulaaka kaogesana saromu.<verse eid="PSA 79:13"/></para>
  <chapter eid="PSA 79"/>
  <chapter number="80" style="c" sid="PSA 80"/>
  <para style="s">Doʼa to Kasalaamatina Miana Israel</para>
  <para style="sr">
    <ref loc="PSA 80:1-20">80:1-20</ref></para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 80:1"/>To kapalana molaguna. Aose lagu: Kamba-kamba Bakung. Laguna kasakusii. Zaburuna Asaf.<verse eid="PSA 80:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 80:2"/>Maasangia urangoa, e Gembalana miana Israel,</para>
  <para style="q2" vid="PSA 80:2">e Ingkoo mokapalaina siwuluna Yusuf mboomo gulumana dumba!</para>
  <para style="q1" vid="PSA 80:2">Ingkoo mokokauncuramakana i bhawona manga malaaʼekatina kerub,<note caller="+" style="f"><char style="fr" closed="false">80:2 </char><char style="fq" closed="false">manga malaaʼekatina kerub: </char><char style="ft" closed="false">Malaaʼekati igambaraaka mboomo mahaluku mokopani, agambaraaka kalangana Aulataʼala tee umbaana. Apogauakea ande kauncuramakana KAWASANA OPU dhaangia i bhawona manga malaaʼekati kerub. Dhaangia patuna rua malaaʼekati kerub i bhawona sorongana pojanjia tee i piamo itu Musa atarima firimanina Aulataʼala minaaka iwe sumai. Kamata </char><char style="xt" closed="false"><ref loc="EXO 25:18-22">Limb. 25:18-22</ref>.</char></note> utiumbamo tee caheamu<verse eid="PSA 80:2"/></para>
  <para style="q2">
    <verse number="3" style="v" sid="PSA 80:3"/>i aroana Efraim, Binyamin, tee Manasye!</para>
  <para style="q1" vid="PSA 80:3">Susuakamea o kuasamu</para>
  <para style="q2" vid="PSA 80:3">tee uumbamo to upasalaamati ingkami!<verse eid="PSA 80:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 80:4"/>E Aulataʼala, pambulimea pendua o kadhaangiamami;</para>
  <para style="q2" vid="PSA 80:4">taroakamo o roumu akocahea sabutuna ingkami bhetasalaamati.<verse eid="PSA 80:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 80:5"/>E KAWASANA OPU, Aulataʼalana saangua alamu,</para>
  <para style="q2" vid="PSA 80:5">sakawana naepia upamuru, moomini o uumatimu adoʼa?<verse eid="PSA 80:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 80:6"/>Ingkoo udhawua kaporona inca to kinandena manga incia,</para>
  <para style="q2" vid="PSA 80:6">tee lolu mobhari to uwe isumpuna.<verse eid="PSA 80:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 80:7"/>Ingkoo umanga pamembali giu</para>
  <para style="q2" vid="PSA 80:7">ipotagaliakana manga lipu isaripimami,</para>
  <para style="q2" vid="PSA 80:7">tee o musumami uka manga ele-ele.<verse eid="PSA 80:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 80:8"/>E Aulataʼalana saangua alamu, pambulimea pendua o kadhaangiamami,</para>
  <para style="q2" vid="PSA 80:8">maasangia o roumu akocahea mamudhaakana ingkami tasalaamati.<verse eid="PSA 80:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 80:9"/>Uumatimu mboomo puuna angguru Ingkoo ubhawea upalimbaia minaaka i Mesir;</para>
  <para style="q2" vid="PSA 80:9">upadhencu manga lipu mosagaanana, kasiimpo o puuna angguru sumai upombulaia.<verse eid="PSA 80:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 80:10"/>Ingkoo upekangkiloakea tana to incia,</para>
  <para style="q2" vid="PSA 80:10">kulesena atuwu tee apabuke saangua lipu.<verse eid="PSA 80:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 80:11"/>Manga gunu asalibumbuakea tee ngkamia-miana,</para>
  <para style="q2" vid="PSA 80:11">tee manga rahana atutubhi manga puuna aras momaoge.<verse eid="PSA 80:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 80:12"/>Manga rangkana adhola sakawana i tawo,</para>
  <para style="q2" vid="PSA 80:12">tee manga lolona akawa i Umala Efrat.<verse eid="PSA 80:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 80:13"/>Pokia Ingkoo ubhongka manga tondona</para>
  <para style="q2" vid="PSA 80:13">sabutuna bhari-bharia mia molalo amembali atobhe bhakena?<verse eid="PSA 80:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 80:14"/>Bhawu abhembarua,</para>
  <para style="q2" vid="PSA 80:14">tee bhari-bharia binata maila akandea.<verse eid="PSA 80:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 80:15"/>E Aulataʼalana saangua alamu, maimo umbuli i uumatimu,</para>
  <para style="q2" vid="PSA 80:15">tontomea minaaka i sorogaa tee ukamatamea!</para>
  <para style="q1" vid="PSA 80:15">Maheruakamea o puuna angguru sii,<verse eid="PSA 80:15"/></para>
  <para style="q2">
    <verse number="16" style="v" sid="PSA 80:16"/>puuna angguru ipombulamu tee kuasamu,</para>
  <para style="q2" vid="PSA 80:16">tee o tunana ipekatangkamu to karomu.<verse eid="PSA 80:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 80:17"/>Musu padhamo apale tee atunu puuna angguru sii.</para>
  <para style="q2" vid="PSA 80:17">Maasangia manga incia abinasa rampaakanamo kagorampangimu.<verse eid="PSA 80:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 80:18"/>Maka taroakamo limamu adhaangia to mia i weta i kaanamu,</para>
  <para style="q2" vid="PSA 80:18">siitumo to anana maanusia<note caller="+" style="f"><char style="fr" closed="false">80:18 </char><char style="fq" closed="false">anana maanusia: </char><char style="ft" closed="false">Aipomo mia incia sumai rajana miana Israel atawa amembali uka o Isa, momananeana asarongi karona Anana Maanusia.</char></note> ipekakaamu to karomu.<verse eid="PSA 80:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 80:19"/>Tee mboo sumai, ingkami inda bhetasowo minaaka i Ingkoo;</para>
  <para style="q2" vid="PSA 80:19">jagania o dhadhimami, sumaimo ingkami bhetasombako.<verse eid="PSA 80:19"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 80:20"/>E KAWASANA OPU, Aulataʼalana saangua alamu, pambulimea pendua o kadhaangiamami,</para>
  <para style="q2" vid="PSA 80:20">taroakamo o roumu akocahea mamudhaakana ingkami tasalaamati.<verse eid="PSA 80:20"/></para>
  <chapter eid="PSA 80"/>
  <chapter number="81" style="c" sid="PSA 81"/>
  <para style="s">Lagu i Wakutuuna Pebhaanguiana Pojanjia</para>
  <para style="sr">
    <ref loc="PSA 81:1-17">81:1-17</ref></para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 81:1"/>To kapalana molaguna. Mboomo lagu Gitit.<note caller="+" style="f"><char style="fr" closed="false">81:1 </char><char style="fq" closed="false">Gitit: </char><char style="ft" closed="false">Zaburu incia sii aose suarana lagu tee gambusu minaaka i Gat, siitumo sala saangu kota miana Filistin. Gat sumai mopadhana imbooresina Nabii Daud wakutuuna apalaiaka karona minaaka i Raja Saul.</char></note> Zaburuna Asaf.<verse eid="PSA 81:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 81:2"/>Sambo-sambomo to Kawasana Opu, o kakaata.</para>
  <para style="q2" vid="PSA 81:2">Sambomo tee ukaunde-undemo to Aulataʼala isombana Yakub.<verse eid="PSA 81:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 81:3"/>Lagumo tee upakoonimea o ganda-ganda,</para>
  <para style="q2" vid="PSA 81:3">pakoonimea o kecapi momandii upapooseakea tee suarana gambusu.<verse eid="PSA 81:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 81:4"/>Towiimea o torompe i bula mobhaau,</para>
  <para style="q2" vid="PSA 81:4">i wakutuuna kainawana bula, i eona raraeata.<verse eid="PSA 81:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 81:5"/>Siitumo saangu katotapu to miana Israel,</para>
  <para style="q2" vid="PSA 81:5">saangu hukumu minaaka i Aulataʼala isombana Yakub.<verse eid="PSA 81:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 81:6"/>Incia apatotapua amembali saangu kaudhania to siwuluna Yusuf,</para>
  <para style="q2" vid="PSA 81:6">wakutuuna Incia aewangi Tana Mesir.</para>
  <para style="b" vid="PSA 81:6"/>
  <para style="q2" vid="PSA 81:6">Iaku kurango suara inda imatauku,<note caller="+" style="f"><char style="fr" closed="false">81:6 </char><char style="fq" closed="false">suara inda imatauku: </char><char style="ft" closed="false">Siitumo suarana Kawasana Opu mopogauna tee siwuluna Yusuf.</char></note><verse eid="PSA 81:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 81:7"/>"Iaku padhamo kuangka bhawaamu minaaka i awaamu,</para>
  <para style="q2" vid="PSA 81:7">tee o limamu kupalapea minaaka i langka kasodhaamu.<verse eid="PSA 81:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 81:8"/>I nuncana kaseke ingkoo ugora, kasiimpo kurambasakako.</para>
  <para style="q2" vid="PSA 81:8">Kulawani ingkoo minaaka i tampa rahasiana guntu,</para>
  <para style="q2" vid="PSA 81:8">tee Iaku padhamo kuuji ingkoo i matana uwe Meriba.<note caller="+" style="f"><char style="fr" closed="false">81:8 </char><char style="fq" closed="false">Meriba: </char><char style="ft" closed="false">I tampana incia sumai manga miana Israel inda tee uwena tee apeenci i Aulataʼala (kamatea </char><char style="xt" closed="false"><ref loc="EXO 17:7">Limb. 17:7</ref>). </char></note> <char style="qs">Sela</char><verse eid="PSA 81:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 81:9"/>E uumatiku, rangoa opea iudhaniakaku!</para>
  <para style="q2" vid="PSA 81:9">E Israel, ande mpuu ingkoo unda uperangoiaku!<verse eid="PSA 81:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 81:10"/>
    <note caller="-" style="x">
      <char style="xo" closed="false">81:10 </char>
      <char style="xt" closed="false">
        <ref loc="EXO 20:2-3">Limb. 20:2-3</ref>.</char>
    </note>Bholi dhaangia i tanga-tangamiu aulataʼala mosagaanana,</para>
  <para style="q2" vid="PSA 81:10">tee bholimo usomba dewana lipu mosagaanana.<verse eid="PSA 81:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 81:11"/>Iakumo KAWASANA OPU, Aulataʼalamu,</para>
  <para style="q2" vid="PSA 81:11">mobhawako ulimba minaaka i tana Mesir.</para>
  <para style="q2" vid="PSA 81:11">Bungkalea ngangamu pekaewa-ewa, tee bhekuantokia kupabukea."<verse eid="PSA 81:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 81:12"/>"Maka, o uumatiku amendeu aperangoiaku,</para>
  <para style="q2" vid="PSA 81:12">Israel amendeu atungku i aroaku.<verse eid="PSA 81:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 81:13"/>Sababuna sumai, Iaku kutaroaka manga incia amentagali torosu,</para>
  <para style="q2" vid="PSA 81:13">sabutuna manga incia adhadhi aose haejatina karona.<verse eid="PSA 81:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 81:14"/>Ande mpuu o uumatiku aunda aperangoiaku,</para>
  <para style="q2" vid="PSA 81:14">ande mpuu Israel aunda adhadhi mboomo kapeeluku,<verse eid="PSA 81:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 81:15"/>sumaimo bhekuagoria to kupekatalo musuna manga incia,</para>
  <para style="q2" vid="PSA 81:15">tee kuewangi bhari-bharia bhalina manga incia.<verse eid="PSA 81:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 81:16"/>Manga mia mobancina KAWASANA OPU naile itu bheatungku tee arengku i aroana,</para>
  <para style="q2" vid="PSA 81:16">tee kahukumuna to manga incia bheanamisia saʼumurua.<verse eid="PSA 81:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 81:17"/>Maka, bhekudhawuakako kinande minaaka i gandum momalapena mpuu,</para>
  <para style="q2" vid="PSA 81:17">tee uka iaku bhekupekambosuakako golana uwani minaaka gunu bhatu."<verse eid="PSA 81:17"/></para>
  <chapter eid="PSA 81"/>
  <chapter number="82" style="c" sid="PSA 82"/>
  <para style="s">Aulataʼala i nuncana Sidangina Sorogaa</para>
  <para style="sr">
    <ref loc="PSA 82:1-8">82:1-8</ref></para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 82:1"/>Zaburuna Asaf.</para>
  <para style="b" vid="PSA 82:1"/>
  <para style="q1" vid="PSA 82:1">Aulataʼala akapalai sidangi i sorogaa.</para>
  <para style="q2" vid="PSA 82:1">Incia amembali haakimu mobhotukiakana parakara i tanga-tangana manga "aulataʼala,"<note caller="+" style="f"><char style="fr" closed="false">82:1 </char><char style="fq" closed="false">aulataʼala: </char><char style="ft" closed="false">Pogau Ibranina </char><char style="it">"elohim"</char> kananeana akomaʼana dewa atawa Kawasana Opu, maka i nuncana aeati incia sii tee <char style="xt"><ref loc="PSA 82:6">82:6</ref></char> amembali akomaʼana manga malaaʼekati modorohaka i Aulataʼala, siitumo manga seetani. Bhanguna mboo manga "aulataʼala" sumai atohakimi i sidangina sorogaa incia sii.</note><verse eid="PSA 82:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 82:2"/>"Sakawana naepia ingkomiu bheuala kambotu tee cara inda moʼadili</para>
  <para style="q2" vid="PSA 82:2">tee uewaaka manga mia madhaki? <char style="qs">Sela</char><note caller="+" style="f"><char style="fr" closed="false">82:2 </char><char style="fq" closed="false">Sela: </char><char style="ft" closed="false">Aipomo tandana to aunto wakutuuna lagu sumai atolaguaka, atawa o tanda to ahanda apekaogea o suarana, atawa onina gambusuna. Amembali uka to tanda to morangoa.</char></note><verse eid="PSA 82:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 82:3"/>Ewaakamea o hakuna mia momisikini tee ana maelu,</para>
  <para style="q2" vid="PSA 82:3">dhawuakea kaʼadili to mia motopisaki tee mia inda mokokadhaangia.<verse eid="PSA 82:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 82:4"/>Pasalaamatia o mia momisikini tee mia monarakaa,</para>
  <para style="q2" vid="PSA 82:4">rambasakea manga incia minaaka i limana mia madhaki."<verse eid="PSA 82:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 82:5"/>Ingkomiu inda umataua, ingkomiu uka inda umaʼanaia,</para>
  <para style="q2" vid="PSA 82:5">ingkomiu udhala i nuncana kalalanda;</para>
  <para style="q1" vid="PSA 82:5">bhari-bharia ariina alamu sii atolendu</para>
  <para style="q2" vid="PSA 82:5">tee tuturana raʼeati amarungga.<verse eid="PSA 82:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 82:6"/>
    <note caller="-" style="x">
      <char style="xo" closed="false">82:6 </char>
      <char style="xt" closed="false">
        <ref loc="JHN 10:34">Yah. 10:34</ref>.</char>
    </note>Iaku padhamo kufirimani, "Ingkomiu sii 'manga aulataʼala'</para>
  <para style="q2" vid="PSA 82:6">tee bhari-bharikomiu sii o anana Momalangana;<verse eid="PSA 82:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 82:7"/>moomini mboo sumai, ingkomiu bheumate mboomo maanusia,</para>
  <para style="q2" vid="PSA 82:7">tee mboomo manga kaogesa, ingkomiu uka bheumate."<verse eid="PSA 82:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 82:8"/>E Aulataʼala, kakaromo, adilia o dunia sii;</para>
  <para style="q2" vid="PSA 82:8">roonamo bhari-bharia lipu satotuuna o pewauamu.<verse eid="PSA 82:8"/></para>
  <chapter eid="PSA 82"/>
  <chapter number="83" style="c" sid="PSA 83"/>
  <para style="s">Doʼa Aemani i Aulataʼala to Ahukumuaka Musuna Israel</para>
  <para style="sr">
    <ref loc="PSA 83:1-19">83:1-19</ref></para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 83:1"/>Zaburuna Asaf to saangu lagu.<verse eid="PSA 83:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 83:2"/>E Aulataʼala, bholi inda tee uuʼuumu,</para>
  <para style="q2" vid="PSA 83:2">bholi ukatongo-tongo tee usaku limamu, e Aulataʼala!<verse eid="PSA 83:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 83:3"/>Kamatamea, manga musumu apewau karobho,</para>
  <para style="q2" vid="PSA 83:3">manga mia mobanciko apekalangamo bhaana.<verse eid="PSA 83:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 83:4"/>Manga incia apadhaangia pomufaakati madhaki to aewangi uumatimu,</para>
  <para style="q2" vid="PSA 83:4">tee aposaangu to aewangi manga mia ijaganimu.<verse eid="PSA 83:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 83:5"/>Pogauna manga incia, "Mai tapabinasea o lipuna Israel,</para>
  <para style="q2" vid="PSA 83:5">mamudhaakana o sarona Israel inda atoudhani!"<verse eid="PSA 83:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 83:6"/>Manga incia aposaangu i nuncana saangu haejati,</para>
  <para style="q2" vid="PSA 83:6">tee apojanji to aewangiko.<verse eid="PSA 83:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 83:7"/>Manga incia satotuuna o mia momboorena i pokemaana Edom tee miana Ismail,</para>
  <para style="q2" vid="PSA 83:7">miana Moab tee miana Hagar,<verse eid="PSA 83:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 83:8"/>Gebal, Amon, Amalek,</para>
  <para style="q2" vid="PSA 83:8">Tana Filistin tee raʼeatina Tirus.<verse eid="PSA 83:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 83:9"/>Tee o Asyur uka aposaangu tee manga incia,</para>
  <para style="q2" vid="PSA 83:9">amembali motulungina siwuluna Lut.<note caller="+" style="f"><char style="fr" closed="false">83:9 </char><char style="fq" closed="false">siwuluna Lut: </char><char style="ft" closed="false">Lut o pinoanana Ibrahim, tee siwuluna minaaka i rua miaia anana Lut amembali lipu Moab tee Amon (kamata </char><char style="xt"><ref loc="GEN 19:36-38">Bhaa. 19:36-38</ref>.</char>) Bhari-bharia lipu idaftaraakana i aeati 7-9 aposarimbanua tee lipu Israel tee amembali apomusu.</note> <char style="qs">Sela</char><verse eid="PSA 83:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 83:10"/>Pewaumea manga incia mboomo ipewaumu i miana Midian,</para>
  <para style="q2" vid="PSA 83:10">tee mboomo ipewaumu i Sisera tee Yabin i bhiwina Umala Kison,<verse eid="PSA 83:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 83:11"/>mopadhana ipabinasamu minaaka i nuncana dunia,</para>
  <para style="q2" vid="PSA 83:11">tee o maeatina amembali karombu to pasuburuana tana.<verse eid="PSA 83:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 83:12"/>Pamembalia o kaogesana manga incia mboomo Oreb tee Zeb,</para>
  <para style="q2" vid="PSA 83:12">patungkua o rajana manga incia mboomo Zebah tee Salmuna<verse eid="PSA 83:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 83:13"/>mopogauna, "Mai takuasaia o lipu mbooresana Aulataʼala!"<verse eid="PSA 83:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 83:14"/>E Aulataʼala, pamembalia manga incia mboomo ngawu mopolaka,</para>
  <para style="q2" vid="PSA 83:14">mboomo laena bhae ibhaleakana ngalu.<verse eid="PSA 83:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 83:15"/>Mboomo waa motununa koo,</para>
  <para style="q2" vid="PSA 83:15">tee mboomo rorena waa mopekangauna manga gunu,<verse eid="PSA 83:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 83:16"/>pajerea manga incia tee garuramu,</para>
  <para style="q2" vid="PSA 83:16">tee upekaekaia tee tambusisimu.<verse eid="PSA 83:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 83:17"/>Taroakamea o rouna manga incia abukeaka aebu</para>
  <para style="q2" vid="PSA 83:17">tee taroakamo saromu, e KAWASANA OPU, abalasiaka karona.<verse eid="PSA 83:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 83:18"/>Taroakamo manga incia amaea tee amaidhiidhi incana saʼumurua;</para>
  <para style="q2" vid="PSA 83:18">taroakamo manga incia anamisi kaea tee amate.<verse eid="PSA 83:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 83:19"/>Taroakamo manga incia amataua ande tangkanamo Ingkoo mokosarona KAWASANA OPU,</para>
  <para style="q2" vid="PSA 83:19">Momalangana i saangua dunia.<verse eid="PSA 83:19"/></para>
  <chapter eid="PSA 83"/>
  <chapter number="84" style="c" sid="PSA 84"/>
  <para style="s">Apemeliliaka Bhanuana Aulataʼala</para>
  <para style="sr">
    <ref loc="PSA 84:1-13">84:1-13</ref></para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 84:1"/>To kapalana molaguna. Mboomo lagu Gitit.<note caller="+" style="f"><char style="fr" closed="false">84:1 </char><char style="fq" closed="false">Gitit: </char><char style="ft" closed="false">Akomaʼana minaaka i Gat, siitumo sala saangu kota miana Filistin. Gat sumai mopadhana imbooresina Nabii Daud wakutuuna apalaiaka karona minaaka i Raja Saul.</char></note> Zaburuna miana Korah.<verse eid="PSA 84:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 84:2"/>Tapanamo kasanaana o tampana mbooresamu,</para>
  <para style="q2" vid="PSA 84:2">e KAWASANA OPUNA saangua alamu!<verse eid="PSA 84:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 84:3"/>Incaku apemeliliaka bhanuana KAWASANA OPU,</para>
  <para style="q2" vid="PSA 84:3">sampemo kumalute roonamo pemeliliku sumai.</para>
  <para style="q2" vid="PSA 84:3">Saangua badaku tee jiwaku akaunde-unde</para>
  <para style="q2" vid="PSA 84:3">to Aulataʼala modhadhi.<verse eid="PSA 84:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 84:4"/>Manu-manu ntomintomi apotibhaaka bhanua to karona,</para>
  <para style="q2" vid="PSA 84:4">tee o manu-manu walawalangke apotibhaaka saangu poteo,</para>
  <para style="q1" vid="PSA 84:4">to tampana adhika manga anana</para>
  <para style="q2" vid="PSA 84:4">i saripina manga tampana tunuana kurubanimu, e KAWASANA OPUNA saangua alamu, e Rajaku tee Aulataʼalaku.<verse eid="PSA 84:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 84:5"/>Amasanaamo o mia momboorena i Bhanuamu,</para>
  <para style="q2" vid="PSA 84:5">Manga incia atorotorosu apujiko. <char style="qs">Sela</char><verse eid="PSA 84:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 84:6"/>Amasanaamo mia mopotibhaakana kakaa minaaka i Ingkoo,</para>
  <para style="q2" vid="PSA 84:6">tee o ngangarandana apemeliliaka to aziara i Gunu Sion.<verse eid="PSA 84:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 84:7"/>Wakutuuna manga incia alalo i Mbolonga Baka,<note caller="+" style="f"><char style="fr" closed="false">84:7 </char><char style="fq" closed="false">Mbolonga Baka: </char><char style="ft" closed="false">I nuncana pogau Ibrani </char><char style="it">baka</char> amembali akomaʼana "tangi" tee puuna murbei, jadi aipomo maʼanana Mbolonga Tangi atawa Mbolonga Puuna Murbei.</note></para>
  <para style="q2" vid="PSA 84:7">tampa incia sumai abhaliia amembali matana uwe.</para>
  <para style="q1" vid="PSA 84:7">Bulaana wao bhaa-bhaana uka</para>
  <para style="q2" vid="PSA 84:7">abhari aumbaaka barakati to mbolonga sumai.<verse eid="PSA 84:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 84:8"/>Samangengena alingka sahandana uka o kakaana,</para>
  <para style="q2" vid="PSA 84:8">sakawana apoaro tee Aulataʼala mobhawoakana bhari-bharia dewa i Sion.<verse eid="PSA 84:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 84:9"/>E KAWASANA OPU, Aulataʼalana saangua alamu, perangoia o doʼaku.</para>
  <para style="q2" vid="PSA 84:9">Tilikimea, e Aulataʼala isombana Yakub! <char style="qs">Sela</char><verse eid="PSA 84:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 84:10"/>Tontomea o raja mopadhana ipilimu, e Aulataʼala,</para>
  <para style="q2" vid="PSA 84:10">kamatamea o rouna mia mopadhana ilantimu to katangkesina uumatimu.<verse eid="PSA 84:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 84:11"/>Roonamo amalape saeo i aroana Bhanuamu</para>
  <para style="q2" vid="PSA 84:11">minaaka i sarewu eo i tampa mosagaanana.</para>
  <para style="q1" vid="PSA 84:11">Iaku labhina kumaasiaka kumembali mojaganina Bhanuana Aulataʼalaku</para>
  <para style="q2" vid="PSA 84:11">minaaka i kumboore i kemana mia madhaki.<verse eid="PSA 84:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 84:12"/>Roonamo KAWASANA OPU, Aulataʼala satotuuna o matanaeo tee o katangkesita;</para>
  <para style="q2" vid="PSA 84:12">Incia manga dhawuaka rahumati tee kamuliangi.</para>
  <para style="q1" vid="PSA 84:12">KAWASANA OPU sadia apewau kalape tee manga mia</para>
  <para style="q2" vid="PSA 84:12">moosena dhala mobanara.<verse eid="PSA 84:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 84:13"/>E KAWASANA OPUNA saangua alamu,</para>
  <para style="q2" vid="PSA 84:13">akaunde-undemo bhari-bharia mia moparacaeako!<verse eid="PSA 84:13"/></para>
  <chapter eid="PSA 84"/>
  <chapter number="85" style="c" sid="PSA 85"/>
  <para style="s">Doʼana Miana Israel i Aulataʼala Mamudhaakana Atopasalaamati</para>
  <para style="sr">
    <ref loc="PSA 85:1-14">85:1-14</ref></para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 85:1"/>To kapalana molaguna. Zaburuna miana Korah.<verse eid="PSA 85:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 85:2"/>E KAWASANA OPU, Ingkoo padhamo upewau malape to lipumu minaaka i piamo itu,</para>
  <para style="q2" vid="PSA 85:2">Ingkoo padhamo upekalapea pendua o kadhaangiana miana Israel.<verse eid="PSA 85:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 85:3"/>Ingkoo padhamo uʼamponia o dosana uumatimu,</para>
  <para style="q2" vid="PSA 85:3">tee ututubhia bhari-bharia dosana manga incia. <char style="qs">Sela</char><verse eid="PSA 85:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 85:4"/>Bhari-bharia iʼamaraakamu padhamo upauntoa,</para>
  <para style="q2" vid="PSA 85:4">tee upanaindamea o pamurumu mokarore-rorena sumai.<verse eid="PSA 85:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 85:5"/>Sii-sii pambulimea pendua o kadhaangiamami mboomo i piamo itu, e Aulataʼala, manga mopasalaamatina,</para>
  <para style="q2" vid="PSA 85:5">tee upekaridhomea o pamurumu to ingkami.<verse eid="PSA 85:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 85:6"/>Buaka saʼumurua Ingkoo bheupamuru tee ingkami?</para>
  <para style="q2" vid="PSA 85:6">Buaka saʼumurua bheutorotorosu uʼamara tee ingkami tee siwulumami?<verse eid="PSA 85:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 85:7"/>Buaka Ingkoo umendeu manga padhadhi pendua</para>
  <para style="q2" vid="PSA 85:7">mamudhaakana o uumatimu akaunde-unde rampaakanamo Ingkoo?<verse eid="PSA 85:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 85:8"/>E KAWASANA OPU, susuakamea o kaasimu molagina to ingkami,</para>
  <para style="q2" vid="PSA 85:8">tee mangadhawuakamo kasalaamatimu.<verse eid="PSA 85:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 85:9"/>Iaku gauku kuperangoi opea bheifirimaniakana KAWASANA OPU, siitumo o Aulataʼala,</para>
  <para style="q2" vid="PSA 85:9">roonamo Incia bheafirimaniaka kasanaa</para>
  <para style="q2" vid="PSA 85:9">to uumatina tee manga mia mosaalihi.</para>
  <para style="q2" vid="PSA 85:9">Maka manga incia bholi apendua akabhongo-bhongo.<verse eid="PSA 85:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 85:10"/>Satotuuna o kasalaamati minaaka i Kawasana Opu amakasu tee manga mia momaekana tee Incia</para>
  <para style="q2" vid="PSA 85:10">mamudhaakana o kamuliangina amembali amboore i liputa.<verse eid="PSA 85:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 85:11"/>Kaasi molagina tee pojanjia inda momabhotu bheapokawa,</para>
  <para style="q2" vid="PSA 85:11">kabanara tee kasanaa bheaposakulaka.<verse eid="PSA 85:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 85:12"/>Kataʼatina maanusia i Kawasana Opu bheatuwu minaaka i tana,</para>
  <para style="q2" vid="PSA 85:12">tee o kabanara bheapotonto minaaka i sorogaa.<verse eid="PSA 85:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 85:13"/>KAWASANA OPU uka bhearahumatiaka kalapena,</para>
  <para style="q2" vid="PSA 85:13">tee o liputa bheakohasiliaka timpua motaralabhi-labhi.<verse eid="PSA 85:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 85:14"/>Kabanara bheaporikanaaka dhalana Aulataʼala,</para>
  <para style="q2" vid="PSA 85:14">tee apasiapuakea dhala to Incia.<verse eid="PSA 85:14"/></para>
  <chapter eid="PSA 85"/>
  <chapter number="86" style="c" sid="PSA 86"/>
  <para style="s">Doʼa Emaniana Tulungi minaaka i Manga Musu</para>
  <para style="sr">
    <ref loc="PSA 86:1-17">86:1-17</ref></para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 86:1"/>Doʼana Daud.</para>
  <para style="b" vid="PSA 86:1"/>
  <para style="q1" vid="PSA 86:1">E KAWASANA OPU, perangoiaku tee ulawaniakumo,</para>
  <para style="q2" vid="PSA 86:1">roonamo kunarakaa tee kumisikini.<verse eid="PSA 86:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 86:2"/>Jagania o inyawaku roonamo iaku kutaʼatiko,</para>
  <para style="q2" vid="PSA 86:2">pasalaamatia o bhatuamu moparacaeana tee Ingkoo.<verse eid="PSA 86:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 86:3"/>Maasiakaaku, e Kawasana Opuku,</para>
  <para style="q2" vid="PSA 86:3">roonamo saeoa kudoʼa i Ingkoo.<verse eid="PSA 86:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 86:4"/>Paunde-undemea o ngangarandana bhatuamu sii,</para>
  <para style="q2" vid="PSA 86:4">roonamo i Ingkoomo tampaku kusomba, e Kawasana Opu.<verse eid="PSA 86:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 86:5"/>E Aualataʼala, Ingkoo umalape tee upekaʼamponi,</para>
  <para style="q2" vid="PSA 86:5">kaasimu molagina ataralabhi-labhi to bhari-bharia mia modoʼana i Ingkoo.<verse eid="PSA 86:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 86:6"/>E KAWASANA OPU, perangoimea o doʼaku,</para>
  <para style="q2" vid="PSA 86:6">tee faduliakaaku wakutuuna kuemani tulungi.<verse eid="PSA 86:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 86:7"/>Wakutuuna kumaseke iaku kugora i Ingkoo</para>
  <para style="q2" vid="PSA 86:7">roonamo Ingkoo bheutarima doʼaku.<verse eid="PSA 86:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 86:8"/>Inda dhaangia mopokanana tee Ingkoo i tanga-tangana manga dewa, e Kawasana Opu,</para>
  <para style="q2" vid="PSA 86:8">tee inda dhaangia mopokanana tee opea ipewaumu.<verse eid="PSA 86:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 86:9"/>
    <note caller="-" style="x">
      <char style="xo" closed="false">86:9 </char>
      <char style="xt" closed="false">
        <ref loc="REV 15:4">Wah. 15:4</ref>.</char>
    </note>Bhari-bharia lipu ipadhaangiamu</para>
  <para style="q2" vid="PSA 86:9">bheaumba tee asuju i aroamu, e Kawasana Opu,</para>
  <para style="q2" vid="PSA 86:9">tee bheamuliangia o saromu.<verse eid="PSA 86:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 86:10"/>Sababuna Ingkoo umakaa tee upewau manga giu inda momentela.</para>
  <para style="q2" vid="PSA 86:10">Tangkanamo Ingkoo o Aulataʼala.<verse eid="PSA 86:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 86:11"/>E KAWASANA OPU, adhariakaaku dhalamu,</para>
  <para style="q2" vid="PSA 86:11">mamudhaakana kudhadhi kuosea kabanaramu;</para>
  <para style="q1" vid="PSA 86:11">pekatangkea incaku mamudhaakana kuhoromati saromu.<verse eid="PSA 86:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 86:12"/>E Aulataʼala, KAWASANA OPU, iaku bhekupujiko tee mpuu-mpuuna incaku,</para>
  <para style="q2" vid="PSA 86:12">tee bhekumuliangi saromu saʼumurua.<verse eid="PSA 86:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 86:13"/>Roonamo kaasimu molagina amaoge mpuu to iaku,</para>
  <para style="q2" vid="PSA 86:13">Ingkoo padhamo upasalaamatiaku minaaka i mate.<verse eid="PSA 86:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 86:14"/>E Aulataʼala, manga mia mosombo ahumbuniaku;</para>
  <para style="q2" vid="PSA 86:14">rombongana manga mia masega gauna apekamateaku,</para>
  <para style="q2" vid="PSA 86:14">tee manga incia inda afaduliakako.<verse eid="PSA 86:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 86:15"/>Maka Ingkoo e Kawasana Opu, satotuuna o Aulataʼala mobukeakana kaasi,</para>
  <para style="q2" vid="PSA 86:15">usabara tee ataralabhi-labhi o kaasimu molagina tee pojanjiamu tee iaku inda amabhotu.<verse eid="PSA 86:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 86:16"/>Tontoaku tee umaasiakaakumo;</para>
  <para style="q2" vid="PSA 86:16">dhawuakea bhatuamu sii kakaamu tee upasalaamatiaku,</para>
  <para style="q2" vid="PSA 86:16">roonamo mboomo inaku, iaku uka kulaianiko.<verse eid="PSA 86:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 86:17"/>Dhawuakaaku saangu tanda ande Ingkoo umalape</para>
  <para style="q2" vid="PSA 86:17">mamudhaakana manga mia mobanciaku amaea wakutuuna akamatea</para>
  <para style="q2" vid="PSA 86:17">ande Ingkoo, KAWASANA OPU, motulungiaku tee mopekatangkana incaku.<verse eid="PSA 86:17"/></para>
  <chapter eid="PSA 86"/>
  <chapter number="87" style="c" sid="PSA 87"/>
  <para style="s">Sion, siitumo Yerusalem, Kotana Aulataʼala</para>
  <para style="sr">
    <ref loc="PSA 87:1-7">87:1-7</ref></para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 87:1"/>Zaburuna miana Korah, saangu lagu.</para>
  <para style="b" vid="PSA 87:1"/>
  <para style="q1" vid="PSA 87:1">KAWASANA OPU apakaro kotana i bhawona tubuna gunu momangkilo.<verse eid="PSA 87:1"/></para>
  <para style="q2">
    <verse number="2" style="v" sid="PSA 87:2"/>KAWASANA OPU amaasiaka bhambana lawana Sion</para>
  <para style="q2" vid="PSA 87:2">alabhi minaaka i bhari-bharia tampa mosagaanana modhaangiana i Israel, lipuna Yakub.<verse eid="PSA 87:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 87:3"/>Manga mia apogauakako tee giu momulia,</para>
  <para style="q2" vid="PSA 87:3">e kotana Aulataʼala. <char style="qs">Sela</char><verse eid="PSA 87:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 87:4"/>Pogauna Kawasana Opu, "Iaku bhekusarongi Rahab<note caller="+" style="f"><char style="fr" closed="false">87:4 </char><char style="fq" closed="false">Rahab: </char><char style="ft" closed="false">Saro mosagaanana to asarongiaka Mesir mokomaʼanana "asombo."</char></note> tee Babel i tanga-tangana lipu momatauaku.</para>
  <para style="q2" vid="PSA 87:4">Tee uka o Tana Filistin, Tirus tee Etiopia,<note caller="+" style="f"><char style="fr" closed="false">87:4 </char><char style="ft" closed="false">Manga lipu moparacaeana tee Kawasana Opu bheatolentu mboomo mia molaahirina i Sion (kota Yerusalem), tee mboo sumai manga incia apesua i nuncana uumatina Aulataʼala.</char></note> 'Manga incia sii uka atoabhi amembali raʼeatina Sion.' "<verse eid="PSA 87:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 87:5"/>Maka to Sion, manga mia bheapogau, "Mia incia sii tee mia incia sumai alaahiri i nuncana,</para>
  <para style="q1" vid="PSA 87:5">tee o Aulataʼala Momalangana sakaro-karona bhemopekatangkea."<verse eid="PSA 87:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 87:6"/>KAWASANA OPU bhealentua wakutuuna daftaraana manga lipu,</para>
  <para style="q2" vid="PSA 87:6">"Manga incia sii uka aabhia o raʼeatina Sion." <char style="qs">Sela</char><verse eid="PSA 87:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 87:7"/>Apoose amanari, manga mia bhealagu, "Minaaka i Sion ingkita tatarima manga giu momalape</para>
  <para style="q2" vid="PSA 87:7">mboomo mia momboorena i saripina matana uwe."<verse eid="PSA 87:7"/></para>
  <chapter eid="PSA 87"/>
  <chapter number="88" style="c" sid="PSA 88"/>
  <para style="s">Doʼa i Wakutuuna Tamapii Makaa</para>
  <para style="sr">
    <ref loc="PSA 88:1-19">88:1-19</ref></para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 88:1"/>Doʼa to kapalana molaguna. Zaburuna miana Korah. Mboomo lagu: Kasukarana Kanarakaa.</para>
  <para style="q1" vid="PSA 88:1">Lagu kaadharina Heman, miana Ezrahi.<verse eid="PSA 88:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 88:2"/>E KAWASANA OPU, e Aulataʼala mopasalaamatiaku,</para>
  <para style="q2" vid="PSA 88:2">iaku kukagora-gora o eo tee malo i aroamu.<verse eid="PSA 88:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 88:3"/>Taroakamo o doʼaku akawa i aroamu.</para>
  <para style="q2" vid="PSA 88:3">Maasangia urangoa o goraku.<verse eid="PSA 88:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 88:4"/>Roonamo abharimo mpuu kunamisi kanarakaa,</para>
  <para style="q2" vid="PSA 88:4">tee saidhepo kumate.<verse eid="PSA 88:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 88:5"/>Iaku kutolentu i tanga-tangana mia mopesuana i liana koburu,</para>
  <para style="q2" vid="PSA 88:5">tee o kakaana bukuku kabilanga atopadhamo.<verse eid="PSA 88:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 88:6"/>Iaku mboomo mia motobholi i tanga-tangana mia mate,</para>
  <para style="q2" vid="PSA 88:6">mboomo mia motopekamate ipatidhole i nuncana koburu,</para>
  <para style="q1" vid="PSA 88:6">tee indamo uudhaniaku uka,</para>
  <para style="q2" vid="PSA 88:6">roonamo kutorambasakamo minaaka i limamu.<verse eid="PSA 88:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 88:7"/>Ingkoo udhikaaku i nuncana koburu i tambe mpuu,</para>
  <para style="q2" vid="PSA 88:7">i tampa momandala tee momalalanda.<verse eid="PSA 88:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 88:8"/>Pamurumu amatamo mpuu kunamisia,</para>
  <para style="q2" vid="PSA 88:8">tee utaburiaku mboomo ewona tawo. <char style="qs">Sela</char><verse eid="PSA 88:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 88:9"/>Ingkoo upekaridhoakaaku manga musirahaku,</para>
  <para style="q2" vid="PSA 88:9">tee upewaua manga incia amarikaaku.</para>
  <para style="q2" vid="PSA 88:9">Iaku kumboore i nuncana kurunga tee inda amembali kulimba;<verse eid="PSA 88:9"/></para>
  <para style="q2">
    <verse number="10" style="v" sid="PSA 88:10"/>mataku amarea roonamo kanarakaa.</para>
  <para style="q2" vid="PSA 88:10">E KAWASANA OPU, saesaeo iaku kugora i Ingkoo,</para>
  <para style="q2" vid="PSA 88:10">iaku kutaanaka limaku i Ingkoo.<verse eid="PSA 88:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 88:11"/>Buaka Ingkoo bheupewau muuzizati to mia mate? Inda!</para>
  <para style="q2" vid="PSA 88:11">Buaka o rohi bheabhangu to apuji Ingkoo? Inda!<char style="qs">Sela</char><verse eid="PSA 88:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 88:12"/>Buaka o kaasimu molagina atopakoleleaka i nuncana koburu,</para>
  <para style="q2" vid="PSA 88:12">tee o lele pojanjiamu inda amabhotu atopakoleleaka i tampana pabinasaana mia? Inda!<verse eid="PSA 88:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 88:13"/>Dhaangia buaka momatauna muuzizatimu i nuncana kalalanda,</para>
  <para style="q2" vid="PSA 88:13">tee momatauna kabanaramu i lipu tampana sagala giu atomalinguaka? Inda!<verse eid="PSA 88:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 88:14"/>Maka iaku kupekee kuemani tulungi i Ingkoo, e KAWASANA OPU,</para>
  <para style="q2" vid="PSA 88:14">saeona mpuu akawamo o doʼaku i aroamu.<verse eid="PSA 88:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 88:15"/>E KAWASANA OPU, pokia Ingkoo ubhanakaaku?</para>
  <para style="q2" vid="PSA 88:15">Pokia ubuniakea o roumu minaaka i karoku?<verse eid="PSA 88:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 88:16"/>Minaaka dhaangia kumaidhiidhi kunarakaa tee saidhepo kumate,</para>
  <para style="q2" vid="PSA 88:16">inda kukapoia kutanggo manga kamingkiri<note caller="+" style="f"><char style="fr" closed="false">88:16 </char><char style="fq" closed="false">kamingkiri: </char><char style="ft" closed="false">Kadhaangiana mia monamisina karona amaeka mpuu tee ameri.</char></note> iumbaakamu.<verse eid="PSA 88:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 88:17"/>Pamurumu mokarore-rore akangkanaiaku;</para>
  <para style="q2" vid="PSA 88:17">kamingkiri ahumbuniaku sakawana kubinasa.<verse eid="PSA 88:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 88:18"/>Bhari-bharia sumai akangkanaiaku mboomo mawa saeoa</para>
  <para style="q2" vid="PSA 88:18">tee alibuaku minaaka i bhari-bharia rope.<verse eid="PSA 88:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 88:19"/>Manga sabhangkaku tee musirahaku upekaridhoakaaku minaaka i karoku;</para>
  <para style="q2" vid="PSA 88:19">sii-sii o sabhangkaku soomo kalalanda.<verse eid="PSA 88:19"/></para>
  <chapter eid="PSA 88"/>
  <chapter number="89" style="c" sid="PSA 89"/>
  <para style="s">Pojanjiana Kawasana Opu tee Raja Daud</para>
  <para style="sr">
    <ref loc="PSA 89:1-53">89:1-53</ref></para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 89:1"/>Lagu kaadharina Etan, miana Ezrahi.<note caller="+" style="f"><char style="fr" closed="false">89:1 </char><char style="fq" closed="false">Etan, miana Ezrahi: </char><char style="ft" closed="false">Sifatu aarifuna Etan tee Heman atomatau mpuu, ruamiaia o miana Ezrahi (kamata </char><char style="xt"><ref loc="PSA 88:1">88:1</ref></char>). Manga ahalii Kitabi Momangkilo aabhia ande o Etan miana Ezrahi sii satotuuna o saro mosagaanana to asarongiaka Yedutun, sala samia minaaka i talu mia (Asaf, Heman, tee Yedutun) ipatugasina Nabii Daud to akapalai lagu wakutuuna asambahea i Baitulla.</note><verse eid="PSA 89:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 89:2"/>Iaku bhekulaguaka lagu kaasina KAWASANA OPU molagina saʼumurua,</para>
  <para style="q2" vid="PSA 89:2">tee ngangaku bhekupakoleleaka pojanjiamu inda amabhotu saʼumurua zamani.<verse eid="PSA 89:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 89:3"/>Iaku kupogau, "Kaasimu molagina amatangka saʼumurua,</para>
  <para style="q2" vid="PSA 89:3">tee pojanjiamu inda momabhotu upatotapua i laiana."<verse eid="PSA 89:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 89:4"/>
    <note caller="-" style="x">
      <char style="xo" closed="false">89:4-5 </char>
      <char style="xt" closed="false">
        <ref loc="2SA 7:12-16">2Sa. 7:12-16</ref>; <ref loc="1CH 17:11-14">1Taw. 17:11-14</ref>; <ref loc="PSA 132:11-12">Zab. 132:11-12</ref>; <ref loc="ACT 2:30">Tul. 2:30</ref>. </char>
    </note>Kawasana Opu apogau, "Iaku padhamo kubhoke pojanjia tee mia ipiliku,</para>
  <para style="q2" vid="PSA 89:4">Iaku padhamo kupotunda tee Daud, bhatuaku,<verse eid="PSA 89:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 89:5"/>'Iaku bhekupatotapuaka manga siwulumu saʼumurua,</para>
  <para style="q2" vid="PSA 89:5">tee kubhangu kauncuramakamu to siwulumu naile itu.' " <char style="qs">Sela</char><verse eid="PSA 89:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 89:6"/>E KAWASANA OPU, taroakamo manga mahalukuna sorogaa apuji manga giu inda momentela ipewaumu,</para>
  <para style="q2" vid="PSA 89:6">tee pojanjiamu inda momabhotu i tanga-tangana rombongana malaaʼekati mangkilo.<verse eid="PSA 89:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 89:7"/>Incema buaka i laiana momembalina mopodhimbana tee KAWASANA OPU?</para>
  <para style="q2" vid="PSA 89:7">Incema buaka modhaangiana i tanga-tangana mahalukuna sorogaa momembalina motopapokana tee KAWASANA OPU?<verse eid="PSA 89:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 89:8"/>Incia o Aulataʼala motohoromati i nuncana majilisina malaaʼekati momangkilo,</para>
  <para style="q2" vid="PSA 89:8">amaoge tee atomaeka alabhi minaaka i bhari-bharia modhaangiana i saripina.<verse eid="PSA 89:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 89:9"/>E KAWASANA OPU, Aulataʼalana saangua alamu,</para>
  <para style="q2" vid="PSA 89:9">incema buaka mopokanana tee ingkoo? Ingkoo umakaa, e KAWASANA OPU,</para>
  <para style="q2" vid="PSA 89:9">tee sadia ubukeaka pojanjia inda momabhotu.<verse eid="PSA 89:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 89:10"/>Ingkoo mokuasaina ewona tawo;</para>
  <para style="q2" vid="PSA 89:10">ande o ewo amalanga, Ingkoo mopekalinoa.<verse eid="PSA 89:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 89:11"/>Ingkoo mopahancuruna Rahab<note caller="+" style="f"><char style="fr" closed="false">89:11 </char><char style="fq" closed="false">Rahab: </char><char style="ft" closed="false">Mahaluku seetani.</char></note> mboomo maeati;</para>
  <para style="q2" vid="PSA 89:11">Ingkoo mopapogaa-gaana manga musumu tee kakaamu.<verse eid="PSA 89:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 89:12"/>Laiana o pewauamu tee o alamu o pewauamu uka.</para>
  <para style="q2" vid="PSA 89:12">Ingkoo mopadhaangiana dunia tee bhari-bharia antona.<verse eid="PSA 89:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 89:13"/>Napa tee salata, Ingkoo mopadhaangiaia;</para>
  <para style="q2" vid="PSA 89:13">Gunu Tabor tee Hermon uka asambo-sambo roonamo saromu.<verse eid="PSA 89:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 89:14"/>Limamu amaoge,</para>
  <para style="q2" vid="PSA 89:14">lima kaanamu atopekalanga tee kakaana momulia.<verse eid="PSA 89:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 89:15"/>Kabanara tee kaʼadili amembali o fondasina kauncuramakamu,</para>
  <para style="q2" vid="PSA 89:15">kaasi molagina tee pojanjiamu inda momabhotu atokamata i nuncana bhari-bharia pewaumu.<verse eid="PSA 89:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 89:16"/>Amasanaamo o lipu mosambo-sambona mopujiko,</para>
  <para style="q2" vid="PSA 89:16">modhadhina i nuncana caheana roumu, e KAWASANA OPU!<verse eid="PSA 89:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 89:17"/>Roonamo saromu manga incia akaunde-unde saeoa,</para>
  <para style="q2" vid="PSA 89:17">tee roonamo kabanaramu manga incia apujiko.<verse eid="PSA 89:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 89:18"/>Ingkoo o kamuliana kakaana manga incia,</para>
  <para style="q2" vid="PSA 89:18">tee roonamo kalapemu, ingkami tahandamo tamakaa.<verse eid="PSA 89:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 89:19"/>Katangkesimami o pewauana KAWASANA OPU,</para>
  <para style="q2" vid="PSA 89:19">siitumo o rajamami pewauana Aulataʼala Momangkilo isombana miana Israel.<verse eid="PSA 89:19"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 89:20"/>I piamo itu, i nuncana pokamataana mia Ingkoo ufirimani</para>
  <para style="q2" vid="PSA 89:20">i manga mia motaʼatiko, mboosii,</para>
  <para style="q1" vid="PSA 89:20">"Iaku padhamo kutulungi samia o mia mobarani,</para>
  <para style="q2" vid="PSA 89:20">Iaku padhamo kupekalanga samia ipiliku minaaka i lipu sumai.<verse eid="PSA 89:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 89:21"/>
    <note caller="-" style="x">
      <char style="xo" closed="false">89:21 </char>
      <char style="xt" closed="false">
        <ref loc="1SA 13:14">1Sa. 13:14</ref>; <ref loc="1SA 16:12">16:12</ref>; <ref loc="ACT 13:32">Tul. 13:32</ref>. </char>
    </note>Iaku padhamo kupokawaaka Daud, o bhatuaku,</para>
  <para style="q2" vid="PSA 89:21">tee padhamo kulantia tee mina hususuku momangkilo.<verse eid="PSA 89:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 89:22"/>Limaku sadhaadhaa bheajagania,</para>
  <para style="q2" vid="PSA 89:22">sampemo limaku uka bhekupekatangkaakea.<verse eid="PSA 89:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 89:23"/>Musu inda bheamembali ahumbunia,</para>
  <para style="q2" vid="PSA 89:23">tee inda bheapisakia mia madhaki.<verse eid="PSA 89:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 89:24"/>Iaku bhekupahancuru manga bhalina i aroana,</para>
  <para style="q2" vid="PSA 89:24">tee kupabinasa manga mia mobancia.<verse eid="PSA 89:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 89:25"/>Pojanjiaku inda bheamabhotu tee kaasiku molagina bheapobhawa tee incia,</para>
  <para style="q2" vid="PSA 89:25">tee roonamo saroku o bheajulu o kakaana.<verse eid="PSA 89:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 89:26"/>Iaku bhekupamembali limana akuasai tawo,</para>
  <para style="q2" vid="PSA 89:26">tee o lima kaanana akuasai manga umala.<verse eid="PSA 89:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 89:27"/>Incia bheagora i Iaku, 'Ingkoomo o Amaku,</para>
  <para style="q2" vid="PSA 89:27">Aulataʼalaku, tee gunu bhatu mopasalaamatiaku!'<verse eid="PSA 89:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 89:28"/>
    <note caller="-" style="x">
      <char style="xo" closed="false">89:28 </char>
      <char style="xt" closed="false">
        <ref loc="REV 1:5">Wah. 1:5</ref>. </char>
    </note>Iaku uka bhekuangkea to amembali ana tumpeku,</para>
  <para style="q2" vid="PSA 89:28">tee kupamembalia momalangana mpuu minaaka i bhari-bharia manga raja i dunia.<verse eid="PSA 89:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="PSA 89:29"/>To saʼumurua bhekudhambaakea o kaasiku molagina to incia,</para>
  <para style="q2" vid="PSA 89:29">tee o pojanjiaku tee incia bheasadhaadhaa amatangka.<verse eid="PSA 89:29"/></para>
  <para style="q1">
    <verse number="30" style="v" sid="PSA 89:30"/>Bhekupewaua o siwuluna adhaangia saʼumurua,</para>
  <para style="q2" vid="PSA 89:30">tee o kauncuramakana bhekupotaangiakea kangengena laiana dhaangiapo i bhawona dunia.<verse eid="PSA 89:30"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="31" style="v" sid="PSA 89:31"/>Ande manga anana inda ataʼati tee hukumuku,</para>
  <para style="q2" vid="PSA 89:31">tee o dhadhina inda aose tuturaku,<verse eid="PSA 89:31"/></para>
  <para style="q1">
    <verse number="32" style="v" sid="PSA 89:32"/>tee ande manga incia inda aose opea mopadhana ipatotapuakaku,</para>
  <para style="q2" vid="PSA 89:32">tee inda aose manga parintaku,<verse eid="PSA 89:32"/></para>
  <para style="q1">
    <verse number="33" style="v" sid="PSA 89:33"/>sumaimo bhekuhukumua manga incia tee kasambina lauro,</para>
  <para style="q2" vid="PSA 89:33">tee bhekubhebhea roonamo dosana manga incia.<verse eid="PSA 89:33"/></para>
  <para style="q1">
    <verse number="34" style="v" sid="PSA 89:34"/>Maka Iaku inda bhekubhotukia o kaasiku molagina to incia,</para>
  <para style="q2" vid="PSA 89:34">tee inda bhekumalinguakea pojanjiaku inda momabhotu.<verse eid="PSA 89:34"/></para>
  <para style="q1">
    <verse number="35" style="v" sid="PSA 89:35"/>Iaku sadhaadhaa kupamondo pojanjiaku,</para>
  <para style="q2" vid="PSA 89:35">tee opea mopadhana ifirimaniakaku inda bhekubhaliia.<verse eid="PSA 89:35"/></para>
  <para style="q1">
    <verse number="36" style="v" sid="PSA 89:36"/>Sampearo to saʼumurua Iaku kusumpa to kangkilona saroku,</para>
  <para style="q2" vid="PSA 89:36">tee inda bhekugau-gau Daud.<verse eid="PSA 89:36"/></para>
  <para style="q1">
    <verse number="37" style="v" sid="PSA 89:37"/>Siwuluna bheadhaangia to saʼumurua,</para>
  <para style="q2" vid="PSA 89:37">tee o kauncuramakana bheasadhaadhaa i aroaku mboomo matanaeo,<verse eid="PSA 89:37"/></para>
  <para style="q1">
    <verse number="38" style="v" sid="PSA 89:38"/>bheasadhaadhaa saʼumurua mboomo bula,</para>
  <para style="q2" vid="PSA 89:38">mosakusiiakea minaaka i laiana." <char style="qs">Sela</char><verse eid="PSA 89:38"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="39" style="v" sid="PSA 89:39"/>Maka sii-sii Ingkoo umendeua tee ubholia;</para>
  <para style="q2" vid="PSA 89:39">Ingkoo upamuru tee mia mopadhana ilantimu.<verse eid="PSA 89:39"/></para>
  <para style="q1">
    <verse number="40" style="v" sid="PSA 89:40"/>Ingkoo ubhotuki janjimu tee bhatuamu,</para>
  <para style="q2" vid="PSA 89:40">tee o mahakotana upekarombuakea tee ngawuna tana.<verse eid="PSA 89:40"/></para>
  <para style="q1">
    <verse number="41" style="v" sid="PSA 89:41"/>Upatobhatea bhari-bharia manga rindina kotana,</para>
  <para style="q2" vid="PSA 89:41">tee upahancurua manga bentena.<verse eid="PSA 89:41"/></para>
  <para style="q1">
    <verse number="42" style="v" sid="PSA 89:42"/>Bhari-bharia mia molalo amanako pewauana;</para>
  <para style="q2" vid="PSA 89:42">incia amembali giuna kaele-ele to manga sarimbanuana.<verse eid="PSA 89:42"/></para>
  <para style="q1">
    <verse number="43" style="v" sid="PSA 89:43"/>Ingkoo upekalanga lima kaanana manga bhalina,</para>
  <para style="q2" vid="PSA 89:43">tee bhari-bharia musuna upewaua akaunde-unde.<verse eid="PSA 89:43"/></para>
  <para style="q1">
    <verse number="44" style="v" sid="PSA 89:44"/>Ingkoo uka upamembali matana ewangana rajamami inda akoampadhea,</para>
  <para style="q2" vid="PSA 89:44">tee inda utulungia i nuncana potimbea.<verse eid="PSA 89:44"/></para>
  <para style="q1">
    <verse number="45" style="v" sid="PSA 89:45"/>Upauntoa o kuasana momuliana,</para>
  <para style="q2" vid="PSA 89:45">tee o kauncuramakana utudhaakea i tana.<verse eid="PSA 89:45"/></para>
  <para style="q1">
    <verse number="46" style="v" sid="PSA 89:46"/>Upekampodhoa o umuruna rajamami wakutuuna amangura,</para>
  <para style="q2" vid="PSA 89:46">tee usalibumbungiakea tee kaea. <char style="qs">Sela</char><verse eid="PSA 89:46"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="47" style="v" sid="PSA 89:47"/>Sakawana naepia uka e KAWASANA OPU? Buaka bheubuniaka karomu saʼumurua?</para>
  <para style="q2" vid="PSA 89:47">Sakawana naepia o pamurumu akarore-rore mboomo waa?<verse eid="PSA 89:47"/></para>
  <para style="q1">
    <verse number="48" style="v" sid="PSA 89:48"/>Udhania, tapanamo kampodho o dhadhiku sii,</para>
  <para style="q2" vid="PSA 89:48">tapanamo sia-siana dhadhina bhari-bharia maanusia ipadhaangiamu!<verse eid="PSA 89:48"/></para>
  <para style="q1">
    <verse number="49" style="v" sid="PSA 89:49"/>Incema buaka o maanusia momembalina modhadhina torosu tee inda amate?</para>
  <para style="q2" vid="PSA 89:49">Tee incema momembalina mopasalaamatina inyawana tee alapa minaaka i mate? <char style="qs">Sela</char><verse eid="PSA 89:49"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="50" style="v" sid="PSA 89:50"/>E Kawasana Opu, i iapai o kaasimu molagina i piamo itu</para>
  <para style="q2" vid="PSA 89:50">mopadhana ijanjiakamu to Daud tee katunda i nuncana pojanjiamu inda momabhotu?<verse eid="PSA 89:50"/></para>
  <para style="q1">
    <verse number="51" style="v" sid="PSA 89:51"/>E Kawasana Opu, udhania tuaapa o bhatuamu sii atohina;</para>
  <para style="q2" vid="PSA 89:51">incaku atanggo kahinana bhari lipu.<verse eid="PSA 89:51"/></para>
  <para style="q1">
    <verse number="52" style="v" sid="PSA 89:52"/>Manga musumu ahina raja mopadhana ilantimu, e KAWASANA OPU,</para>
  <para style="q2" vid="PSA 89:52">manga incia aele-elea iapaipo uka o lingkaana.<verse eid="PSA 89:52"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="53" style="v" sid="PSA 89:53"/>Pujimo KAWASANA OPU to saʼumurua!</para>
  <para style="q2" vid="PSA 89:53">Aamin, ya aamin!<verse eid="PSA 89:53"/></para>
  <chapter eid="PSA 89"/>
  <chapter number="90" style="c" sid="PSA 90"/>
  <para style="ms">BOKU I PATA ANGUNA:</para>
  <para style="s2">ZABURU 90--106</para>
  <para style="s1">Kawasana Opu, Tampana Peulusa Saʼumurua</para>
  <para style="sr">
    <ref loc="PSA 90:1-17">90:1-17</ref></para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 90:1"/>Doʼana Musa, bhatuana Aulataʼala.</para>
  <para style="b" vid="PSA 90:1"/>
  <para style="q1" vid="PSA 90:1">E Kawasana Opu, Ingkoomo tampamami tapeulu</para>
  <para style="q2" vid="PSA 90:1">to saʼumurua.<verse eid="PSA 90:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 90:2"/>Indapo manga gunu atopadhaangia,</para>
  <para style="q2" vid="PSA 90:2">indapo alamu tee dunia sii upamembalia,</para>
  <para style="q1" vid="PSA 90:2">Ingkoomo Aulataʼala mobakaa, inda tee auwalina inda tee aahirina.<verse eid="PSA 90:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 90:3"/>
    <note caller="-" style="x">
      <char style="xo" closed="false">90:3 </char>
      <char style="xt" closed="false">
        <ref loc="GEN 2:7">Bhaa. 2:7</ref>.</char>
    </note>Ingkoo ubhalii maanusia amembali ngawuna tana,</para>
  <para style="q2" vid="PSA 90:3">firimanimu, "Mbulimo i asalamu e anana maanusia."<verse eid="PSA 90:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 90:4"/>
    <note caller="-" style="x">
      <char style="xo" closed="false">90:4 </char>
      <char style="xt" closed="false">
        <ref loc="2PE 3:8">2Ptr. 3:8</ref>.</char>
    </note>I nuncana pokamatamu sarewu tao</para>
  <para style="q2" vid="PSA 90:4">apokana mboomo eo iawi siimpo molapana,</para>
  <para style="q2" vid="PSA 90:4">atawa mboomo sapalika jagaana malo.<verse eid="PSA 90:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 90:5"/>Ingkoo upepadhai dhadhimami mboomo tapongipi,</para>
  <para style="q2" vid="PSA 90:5">mboomo rumpu motuna saeona;<verse eid="PSA 90:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 90:6"/>wakutuuna saeona o rumpu atuwu tee atuna,</para>
  <para style="q2" vid="PSA 90:6">maka wakutuuna konowia amalau tee amatuu.<verse eid="PSA 90:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 90:7"/>Sababuna ingkami tamofu roonamo amaramu,</para>
  <para style="q2" vid="PSA 90:7">tee ingkami tatokidha roonamo pamurumu.<verse eid="PSA 90:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 90:8"/>Manga kasalahamami udhikaia i aroamu</para>
  <para style="q2" vid="PSA 90:8">tee o dosamami motobuniaka atokamata i nuncana caheana roumu.<verse eid="PSA 90:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 90:9"/>Sababuna bhari-bharia eomami tanamisi pamurumu mokarore-rore,</para>
  <para style="q2" vid="PSA 90:9">tee talaloi tao-taomami mboomo kadheina tapoinunca.<verse eid="PSA 90:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 90:10"/>Kangengena dhadhimami tangkanamo pitu pulu tao,</para>
  <para style="q2" vid="PSA 90:10">atawa ande amakaa o bukumami koroo akawa walu pulu tao,</para>
  <para style="q1" vid="PSA 90:10">maka manga eo momalape mpuu ipotibhaakamami tangkanamo kasukara tee kanarakaa;</para>
  <para style="q2" vid="PSA 90:10">dhadhimami amampodho tee amasimba, sapadhana sumai tamofumo.<verse eid="PSA 90:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 90:11"/>Incema buaka momatauna kaogena amaramu?</para>
  <para style="q2" vid="PSA 90:11">Pamurumu amaoge mpuu apokana mboomo mia amaekako.<verse eid="PSA 90:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 90:12"/>Manga adharimo to tagagari eo-eomami momampodhona sii</para>
  <para style="q2" vid="PSA 90:12">mamudhaakana ingkami tapotibhaaka o ngangaranda moʼaarifu.<verse eid="PSA 90:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 90:13"/>E KAWASANA OPU, mbulimo. Sakawana naepia Ingkoo uʼamara?</para>
  <para style="q2" vid="PSA 90:13">Maasiakapea manga bhatuamu.<verse eid="PSA 90:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 90:14"/>Patumpua o incamami i wakutuuna saeona tee kaasimu molagina</para>
  <para style="q2" vid="PSA 90:14">mamudhaakana ingkami tasambo-sambo tee takaunde-unde saʼumurua dhadhimami.<verse eid="PSA 90:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 90:15"/>Pasanaaia o incamami, apokana mboomo upewau eo-eomami i piamo itu asukara,</para>
  <para style="q2" vid="PSA 90:15">tee apokana tee tao-tao itanggomami wakutuuna tanamisi kanarakaa.<verse eid="PSA 90:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 90:16"/>Taroakamo opea ipewaumu akamatea manga bhatuamu,</para>
  <para style="q2" vid="PSA 90:16">tee o kuasamu momulia sumai akamatea anaanamami.<verse eid="PSA 90:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 90:17"/>Taroakamo kabarakatina Kawasana Opu, Aulataʼalamami, dhaangia to ingkami.</para>
  <para style="q2" vid="PSA 90:17">Pekatangkea o angkana limamami, mamudhaakana usahamami akohasili!<verse eid="PSA 90:17"/></para>
  <chapter eid="PSA 90"/>
  <chapter number="91" style="c" sid="PSA 91"/>
  <para style="s">I nuncana Kajaganina Kawasana Opu</para>
  <para style="sr">
    <ref loc="PSA 91:1-16">91:1-16</ref></para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 91:1"/>Mia modhadhina i nuncana kajaganina Aulataʼala Momalanga,</para>
  <para style="q2" vid="PSA 91:1">bheamboore i nuncana peulusana Kawasana Opu Mokokuasa,<verse eid="PSA 91:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 91:2"/>bheapogau i KAWASANA OPU,</para>
  <para style="q2" vid="PSA 91:2">"Ingkoomo o tampana peulusaku tee o bentena potaangiaku; Aulataʼalaku, iparacaeaku."<verse eid="PSA 91:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 91:3"/>Incia bhemorambasakako minaaka i katapu,</para>
  <para style="q2" vid="PSA 91:3">tee minaaka i panyaki imateaka.<verse eid="PSA 91:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 91:4"/>Incia bheasalibumbungiakako tee panina,</para>
  <para style="q2" vid="PSA 91:4">tee ingkoo bheuʼamani i nuncana peulusana.</para>
  <para style="q2" vid="PSA 91:4">Incia atoparacaea tee bheamembali katangkesi tee o bentemu.<verse eid="PSA 91:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 91:5"/>Ingkoo inda bheumaeka tee balaa moumbana i wakutuu malo,</para>
  <para style="q2" vid="PSA 91:5">atawa o kahumbuni inda inamu-namu moumbana i wakutuu eo.<verse eid="PSA 91:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 91:6"/>Ingkoo inda bheumaeaka tee panyaki imateaka moumbana i nuncana kalalanda,</para>
  <para style="q2" vid="PSA 91:6">atawa tee kalelei ibinasaaka moumbana i wakutuu pontanga eo.<verse eid="PSA 91:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 91:7"/>Moomini sarewu mia amate i saripimu,</para>
  <para style="q2" vid="PSA 91:7">tee sapulu rewu mia amate i weta i kaanamu,</para>
  <para style="q2" vid="PSA 91:7">maka ingkoo inda bheucilaka.<verse eid="PSA 91:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 91:8"/>Ingkoo tangkanamo bheutontoa tee matamu karomu,</para>
  <para style="q2" vid="PSA 91:8">tee ukamatea tuaapa Aulataʼala bheahukumu mia madhaki.<verse eid="PSA 91:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 91:9"/>Roonamo KAWASANA OPU upamembalia tampana peulusamu,</para>
  <para style="q2" vid="PSA 91:9">tee Aulataʼala Momalanga upamembalia mbooresamu,<verse eid="PSA 91:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 91:10"/>siitumo ingkoo inda bheucilaka,</para>
  <para style="q2" vid="PSA 91:10">tee balaa bheamaridho minaaka i bhanuamu.<verse eid="PSA 91:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 91:11"/>
    <note caller="-" style="x">
      <char style="xo" closed="false">91:11-12 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 4:6">Mat. 4:6</ref>; <ref loc="LUK 4:10-11">Luk. 4:10-11</ref>.</char>
    </note>Roonamo Incia bheatumpu manga malaaʼekatina to apobhawa tee ingkoo,</para>
  <para style="q2" vid="PSA 91:11">mamudhaakana ajaganiko iapaipo uka o lingkaamu.<verse eid="PSA 91:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 91:12"/>Manga malaaʼekati sumai bheaangkako tee rua mbalia limana</para>
  <para style="q2" vid="PSA 91:12">mamudhaakana o aemu inda atosunu i bhatu.<verse eid="PSA 91:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 91:13"/>
    <note caller="-" style="x">
      <char style="xo" closed="false">91:13 </char>
      <char style="xt" closed="false">
        <ref loc="LUK 10:19">Luk. 10:19</ref>. </char>
    </note>Singa tee ulo bheulempagia,</para>
  <para style="q2" vid="PSA 91:13">singa mangura tee ulo mokobisa bheulanda-landakia.<verse eid="PSA 91:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 91:14"/>Firimanina Kawasana Opu, "Roonamo manga mia momaasiakaaku, bhekupasalaamatia;</para>
  <para style="q2" vid="PSA 91:14">tee Iaku bhekujagani manga mia momatauna saroku.<verse eid="PSA 91:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 91:15"/>Wakutuuna manga incia agoraakaaku, siitumo Iaku bhekulawania;</para>
  <para style="q2" vid="PSA 91:15">Iaku bhekupobhawa tee manga incia i nuncana kaseke,</para>
  <para style="q2" vid="PSA 91:15">tee bhekupasalaamatia tee kumuliangia.<verse eid="PSA 91:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 91:16"/>Tee umuru marambe bhekupatumpua incana,</para>
  <para style="q2" vid="PSA 91:16">tee bhekususuakea ande Iaku bhemopasalaamatia."<verse eid="PSA 91:16"/></para>
  <chapter eid="PSA 91"/>
  <chapter number="92" style="c" sid="PSA 92"/>
  <para style="s">Kawasana Opu o Haakimu Moʼadili</para>
  <para style="sr">
    <ref loc="PSA 92:1-16">92:1-16</ref></para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 92:1"/>Zaburuna saangu lagu to eona Saputuu.<note caller="+" style="f"><char style="fr" closed="false">92:1 </char><char style="fq" closed="false">Saputuu: </char><char style="ft" closed="false">Eo pitu eona (Saputuu) ipepaliakana manga miana Israel minaaka i parintana Aulataʼala to eo to poniuntoa tee ibaadati.</char></note><verse eid="PSA 92:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 92:2"/>Tapanamo kalape tasukuru i KAWASANA OPU</para>
  <para style="q2" vid="PSA 92:2">tee talaguaka manga lagu kapujia to saromu, e KAWASANA OPU Momalanga;<verse eid="PSA 92:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 92:3"/>to tapakoleleaka kaasimu molagina i wakutuu saeona</para>
  <para style="q2" vid="PSA 92:3">tee tuaapa Ingkoo ukeniaka pojanjiamu inda momabhotu i wakutuu malo,<verse eid="PSA 92:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 92:4"/>poose tatiki gitari sapulu taliana,</para>
  <para style="q2" vid="PSA 92:4">tee taoseakea gambusu tee kecapi.<verse eid="PSA 92:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 92:5"/>Roonamo Ingkoo, e KAWASANA OPU, upaunde-undeaku tee opea mopadhana ipewaumu;</para>
  <para style="q2" vid="PSA 92:5">iaku kusambo-sambo tee opea mopadhana ikarajaamu.<verse eid="PSA 92:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 92:6"/>Amaoge mpuu bhari-bharia ipewaumu, e KAWASANA OPU,</para>
  <para style="q2" vid="PSA 92:6">amandala mpuu o fikirimu tee amarasai to tamaʼanaia!<verse eid="PSA 92:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 92:7"/>Mia mokabhongo-bhongo inda bheamembali amataua,</para>
  <para style="q2" vid="PSA 92:7">mia mokurana fikirina inda bheamaʼanaia o giu incia sumai:<verse eid="PSA 92:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 92:8"/>Moomini manga mia madhaki atuwu mboomo rumpu,</para>
  <para style="q2" vid="PSA 92:8">tee o mia madhaki ahandamo abhari,</para>
  <para style="q1" vid="PSA 92:8">maka manga incia sadhaadhaa bheatopabinasa saʼumurua.<verse eid="PSA 92:8"/></para>
  <para style="q2">
    <verse number="9" style="v" sid="PSA 92:9"/>Maka Ingkoo i tampa momalanga saʼumurua e KAWASANA OPU.<verse eid="PSA 92:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 92:10"/>Roonamo manga musumu, e KAWASANA OPU,</para>
  <para style="q2" vid="PSA 92:10">roonamo manga musumu bheabinasa;</para>
  <para style="q2" vid="PSA 92:10">tee bhari-bharia mia madhaki bheupapogaa-gaaia.<verse eid="PSA 92:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 92:11"/>Maka upamembaliaku kumakaa mboomo karambau,</para>
  <para style="q2" vid="PSA 92:11">tee ulaliakaaku mina bhaau to ubarakatiaku.<verse eid="PSA 92:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 92:12"/>Mataku akamatamo kandawuna manga musuku,</para>
  <para style="q2" vid="PSA 92:12">tee o talingaku arangomo katalona manga mia madhaki mobhaliaku.<verse eid="PSA 92:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 92:13"/>Mia mobanara bheatuwu tee akobhake torosu mboomo puuna horomaa,</para>
  <para style="q2" vid="PSA 92:13">tee incia bheamaoge mboomo puuna aras i Libanon.<verse eid="PSA 92:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 92:14"/>Manga incia mboomo puuna kau ipombula i aroana Bhanuana KAWASANA OPU,</para>
  <para style="q2" vid="PSA 92:14">tee ajulu o kaogena i aroana Bhanuana Aulataʼalata.<verse eid="PSA 92:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 92:15"/>Moomini akoʼumurumo dhaangiapo uka akobhake,</para>
  <para style="q2" vid="PSA 92:15">tee asadhaadhaa asuburu tee amaijo o tawana,<verse eid="PSA 92:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 92:16"/>manga miana mobanara sumai apakoleleaka ande o KAWASANA OPU sumai abanara.</para>
  <para style="q2" vid="PSA 92:16">Incia o gunu bhatuku, tee sadia apewau moʼadili.<verse eid="PSA 92:16"/></para>
  <chapter eid="PSA 92"/>
  <chapter number="93" style="c" sid="PSA 93"/>
  <para style="s">Kawasana Opu o Raja Saʼumurua</para>
  <para style="sr">
    <ref loc="PSA 93:1-5">93:1-5</ref></para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 93:1"/>KAWASANA OPU o Raja, Incia abukeaka kamuliangi!</para>
  <para style="q2" vid="PSA 93:1">KAWASANA OPU abukeaka kuasa, tee apatokamata kakaana.</para>
  <para style="q2" vid="PSA 93:1">Incia apakakaro dunia tee inda dhaangia momembalina mohudhalia.<verse eid="PSA 93:1"/></para>
  <para style="q2">
    <verse number="2" style="v" sid="PSA 93:2"/>Kauncuramakamu amatangka minaaka i zamani mangenge,</para>
  <para style="q2" vid="PSA 93:2">tee Ingkoo udhaangiamo minaaka i dunia indapo dhaangia.<verse eid="PSA 93:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 93:3"/>Manga umala mokalua-lua ahandamo apekaoge suarana, e KAWASANA OPU,</para>
  <para style="q2" vid="PSA 93:3">manga umala mokalua-lua ahandamo apekaoge suarana,</para>
  <para style="q2" vid="PSA 93:3">manga umala mokalua-lua ahandamo apekaoge ruuna ewona.<verse eid="PSA 93:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 93:4"/>Maka minaaka i suarana uwe momaoge,</para>
  <para style="q2" vid="PSA 93:4">tee minaaka i ewona tawo momakaa,</para>
  <para style="q2" vid="PSA 93:4">alabhi amaoge KAWASANA OPU i tampa momalanga.<verse eid="PSA 93:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 93:5"/>E KAWASANA OPU, hukumumu abakaa saʼumurua,</para>
  <para style="q2" vid="PSA 93:5">Kangkilo alaenga i nuncana Bhanuamu saʼumurua zamani.<verse eid="PSA 93:5"/></para>
  <chapter eid="PSA 93"/>
  <chapter number="94" style="c" sid="PSA 94"/>
  <para style="s">Kawasana Opu, Pambela Kaʼadili</para>
  <para style="sr">
    <ref loc="PSA 94:1-23">94:1-23</ref></para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 94:1"/>E Aulataʼala, Ingkoomo KAWASANA OPU mobalasina kadhaki.</para>
  <para style="q2" vid="PSA 94:1">Potokamatamea ande Ingkoo mobalasina kadhaki, e Aulataʼala!<verse eid="PSA 94:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 94:2"/>Maasangia ahukumua, e haakimuna dunia;</para>
  <para style="q2" vid="PSA 94:2">hukumua manga mia mosombo apokana tee pewauna!<verse eid="PSA 94:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 94:3"/>Sakawana naepia manga mia madhaki, e KAWASANA OPU,</para>
  <para style="q2" vid="PSA 94:3">sakawana naepia, manga mia madhaki akaunde-unde?<verse eid="PSA 94:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 94:4"/>Manga incia ataburaka pogau mosombo minaaka i ngangana,</para>
  <para style="q2" vid="PSA 94:4">tee bhari-bharia mia mopewauna kadhaki sumai apekalanga karona.<verse eid="PSA 94:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 94:5"/>Manga incia apisaki uumatimu, e KAWASANA OPU,</para>
  <para style="q2" vid="PSA 94:5">tee apahancuru tinaurakamu.<verse eid="PSA 94:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 94:6"/>Manga incia apekamate iaiaro tee mia dhaga,</para>
  <para style="q2" vid="PSA 94:6">tee apekamate ana maelu.<verse eid="PSA 94:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 94:7"/>Pogauna manga incia, "KAWASANA OPU inda akamatea,</para>
  <para style="q2" vid="PSA 94:7">Aulataʼalana Yakub isombana miana Israel inda atontoa."<verse eid="PSA 94:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 94:8"/>Perangoimea, e manga mia mokabhongo-bhongo i tanga-tangana lipu sii!</para>
  <para style="q2" vid="PSA 94:8">E manga mia mokabhongo-bhongo, naepia buaka ingkomiu bheumembali uʼaarifu?<verse eid="PSA 94:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 94:9"/>Incia modhikaakea talinga,</para>
  <para style="q2" vid="PSA 94:9">inda mungki Incia inda aporango!</para>
  <para style="q1" vid="PSA 94:9">Incia mopamodelena mata,</para>
  <para style="q2" vid="PSA 94:9">inda mungki Incia inda apokamata!<verse eid="PSA 94:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 94:10"/>Incia mosasina manga lipu tee moadharina maanusia,</para>
  <para style="q2" vid="PSA 94:10">dhaanamo Incia bheahukumua uka!<verse eid="PSA 94:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 94:11"/>KAWASANA OPU amataua haejatina maanusia,</para>
  <para style="q2" vid="PSA 94:11">ande bhari-bharia sumai inda tee maʼanana.<verse eid="PSA 94:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 94:12"/>Masanaamo mia iadharimu, e KAWASANA OPU,</para>
  <para style="q2" vid="PSA 94:12">tee udhawua kaadhari minaaka i hukumumu;<verse eid="PSA 94:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 94:13"/>
    <note caller="-" style="x">
      <char style="xo" closed="false">94:13 </char>
      <char style="xt" closed="false">
        <ref loc="EXO 14:21">Limb. 14:21</ref>. </char>
    </note>upasanaa incana i wakutuuna kasukara,</para>
  <para style="q2" vid="PSA 94:13">sakawana mia madhaki apesua i nuncana bhalona katapu.<verse eid="PSA 94:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 94:14"/>
    <note caller="-" style="x">
      <char style="xo" closed="false">94:14 </char>
      <char style="xt" closed="false">
        <ref loc="JOB 40:20">Ayb. 40:20</ref>; <ref loc="PSA 104:26">Zab. 104:26</ref>; <ref loc="ISA 27:1">Yes. 27:1</ref>. </char>
    </note>Roonamo KAWASANA OPU inda bheabhanaka uumatina,</para>
  <para style="q2" vid="PSA 94:14">tee Incia inda bheabholi miana lipuna momembalina tinaurakana;<verse eid="PSA 94:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 94:15"/>sababuna kaʼadili bheambuli pendua to manga mia mobanara,</para>
  <para style="q2" vid="PSA 94:15">tee bhari-bharia mia momakatena incana bheaose.<verse eid="PSA 94:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 94:16"/>Incema buaka moewaakaaku i manga mia madhaki?</para>
  <para style="q2" vid="PSA 94:16">Incema buaka bhemopoaroakaaku to aewangi manga mia mopewauna kadhaki?<verse eid="PSA 94:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 94:17"/>Ande mencuana KAWASANA OPU motulungiaku,</para>
  <para style="q2" vid="PSA 94:17">saidhepo kumate i tampa momalino.<verse eid="PSA 94:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 94:18"/>Wakutuuna kufikiri, "Aeku asindoli,"</para>
  <para style="q2" vid="PSA 94:18">sumaimo kaasina KAWASANA OPU molagina motukoaku.<verse eid="PSA 94:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 94:19"/>Wakutuuna abhari fikiriku i nuncana baatiniku,</para>
  <para style="q2" vid="PSA 94:19">Ingkoo utautauaku, sumaimo kukaunde-unde.<verse eid="PSA 94:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 94:20"/>Inda mungki Ingkoo uposaangu tee manga kaogesa momadhaki,</para>
  <para style="q2" vid="PSA 94:20">mopewauna kasalaha alaloi katotapuna inda moʼadilina.<verse eid="PSA 94:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 94:21"/>Manga incia apomufakati aewangi dhadhina mia mobanara,</para>
  <para style="q2" vid="PSA 94:21">tee ahukumu mate manga mia inda mosala.<verse eid="PSA 94:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 94:22"/>Maka KAWASANA OPU mboomo kota bente moewaakaaku,</para>
  <para style="q2" vid="PSA 94:22">tee Aulataʼala amembali gunu bhatu tampana peulusaku.<verse eid="PSA 94:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 94:23"/>Incia bheahukumu manga mia madhaki apokana tee pewauna,</para>
  <para style="q2" vid="PSA 94:23">tee bheapabinasea roonamo dosana.</para>
  <para style="q2" vid="PSA 94:23">KAWASANA OPU, Aulataʼalata bheapabinasa manga incia.<verse eid="PSA 94:23"/></para>
  <chapter eid="PSA 94"/>
  <chapter number="95" style="c" sid="PSA 95"/>
  <para style="s">Horomati tee Taʼatia Kawasana Opu</para>
  <para style="sr">
    <ref loc="PSA 95:1-11">95:1-11</ref></para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 95:1"/>Mai tasambo-samboaka to KAWASANA OPU!</para>
  <para style="q2" vid="PSA 95:1">Mai tasambo-sambo tee takaunde-unde to gunu bhatu kasalaamatita!<verse eid="PSA 95:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 95:2"/>Mai tapoaro i aroana tee taemani sukuru,</para>
  <para style="q2" vid="PSA 95:2">tee tasambo-sambo to Incia tee talaguakea lagu kapujia!<verse eid="PSA 95:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 95:3"/>Roonamo KAWASANA OPU o Aulataʼala momaoge,</para>
  <para style="q2" vid="PSA 95:3">tee Incia o Raja momaoge mokuasaina bhari-bharia dewa.<verse eid="PSA 95:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 95:4"/>Manga tampa momandala mpuu i alamu adhaangia i nuncana limana,</para>
  <para style="q2" vid="PSA 95:4">tee manga lolona gunu uka o pewauana.<verse eid="PSA 95:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 95:5"/>Incia mokuasaina tawo, roonamo Incia mopadhaangiaia,</para>
  <para style="q2" vid="PSA 95:5">tee ati uka, o angkana limana.<verse eid="PSA 95:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 95:6"/>Mai tasuju tasomba Incia,</para>
  <para style="q2" vid="PSA 95:6">tasuju i aroana KAWASANA OPU mopadhaangiana ingkita.<verse eid="PSA 95:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 95:7"/>Roonamo Inciamo o Aulataʼalata,</para>
  <para style="q2" vid="PSA 95:7">tee ingkita o uumati idhambaakana,</para>
  <para style="q1" vid="PSA 95:7">tee o gulumana dumba igembalaakana limana.</para>
  <para style="b" vid="PSA 95:7"/>
  <para style="q1" vid="PSA 95:7">Eo sii ande urango suarana,<verse eid="PSA 95:7"/></para>
  <para style="q2">
    <verse number="8" style="v" sid="PSA 95:8"/>
    <note caller="-" style="x">
      <char style="xo" closed="false">95:8 </char>
      <char style="xt" closed="false">
        <ref loc="EXO 17:1-7">Limb. 17:1-7</ref>.</char>
    </note>bholimo umentagali mboomo i Meriba,</para>
  <para style="q2" vid="PSA 95:8">tee mboomo wakutuuna i Masa, i tana matuu,<verse eid="PSA 95:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 95:9"/>wakutuuna o opu-opuamiu acobaiaku</para>
  <para style="q2" vid="PSA 95:9">tee aujiaku moomini manga incia padhamo akamata opea ikarajaaku.<verse eid="PSA 95:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 95:10"/>Pata pulu tao o kangengena kumarika manga mia incia sumai.</para>
  <para style="q2" vid="PSA 95:10">Firimaniku, "Manga incia o lipu mosaladhala,</para>
  <para style="q2" vid="PSA 95:10">tee inda aose parintaku."<verse eid="PSA 95:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 95:11"/>Rampaakanamo sumai, Iaku kupotunda i nuncana pamuruku,</para>
  <para style="q2" vid="PSA 95:11">"Manga incia inda bheapesua i tampana poniuntoa mopadhana ijanjiakaku to manga incia, siitumo i Kanaan."<verse eid="PSA 95:11"/></para>
  <chapter eid="PSA 95"/>
  <chapter number="96" style="c" sid="PSA 96"/>
  <para style="s">Kawasana Opu, Aulataʼala tee Haakimu i Saangua Dunia</para>
  <para style="sr">
    <ref loc="PSA 96:1-13">96:1-13</ref></para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 96:1"/>Laguakamo lagu bhaau to KAWASANA OPU,</para>
  <para style="q2" vid="PSA 96:1">Lagumo to KAWASANA OPU, e saangua dunia!<verse eid="PSA 96:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 96:2"/>Lagumo to KAWASANA OPU tee upujimo sarona!</para>
  <para style="q2" vid="PSA 96:2">Pakoleleakea saesaeo o kasalaamati minaaka i Incia.<verse eid="PSA 96:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 96:3"/>Petulatulaakea o kamuliangina i tanga-tangana manga lipu,</para>
  <para style="q2" vid="PSA 96:3">tee upetulatulaakea manga pewauna inda momentela i bhari-bharia uumatina maanusia.<verse eid="PSA 96:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 96:4"/>Sababuna o KAWASANA OPU amaoge tee atopuji mpuu.</para>
  <para style="q2" vid="PSA 96:4">Incia alaenga atomaeka alabhi minaaka i bhari-bharia dewa.<verse eid="PSA 96:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 96:5"/>Bhari-bharia dewa isombana manga lipu satotuuna o barahala,</para>
  <para style="q2" vid="PSA 96:5">maka o KAWASANA OPU mopadhaangiana laiana.<verse eid="PSA 96:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 96:6"/>Incia amaoge tee amulia;</para>
  <para style="q2" vid="PSA 96:6">kuasa tee kakesa dhaangia i tampana momangkilo.<verse eid="PSA 96:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 96:7"/>
    <note caller="-" style="x">
      <char style="xo" closed="false">96:7-9 </char>
      <char style="xt" closed="false">
        <ref loc="PSA 29:1-2">Zab. 29:1-2</ref>.</char>
    </note>Akuimea o KAWASANA OPU, e uumatina maanusia,</para>
  <para style="q2" vid="PSA 96:7">akuimea o KAWASANA OPU o kamuliangina tee kakaana!<verse eid="PSA 96:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 96:8"/>Akuimea o kamuliangina sarona to KAWASANA OPU,</para>
  <para style="q2" vid="PSA 96:8">bhawamo pasombaa tee uumbamo i aroana Bhanuana Aulataʼala!<verse eid="PSA 96:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 96:9"/>Sujumo usomba KAWASANA OPU tee upake pakea momangkilo;</para>
  <para style="q2" vid="PSA 96:9">maekamo tee urengkumo i aroana, e saangua alamu!<verse eid="PSA 96:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 96:10"/>Pakoleleakea i tanga-tangana manga lipu,</para>
  <para style="q2" vid="PSA 96:10">"KAWASANA OPU sumai o Raja!</para>
  <para style="q2" vid="PSA 96:10">Atotuu-totuu o alamu amatangka tee inda akohudha,</para>
  <para style="q2" vid="PSA 96:10">Incia bheahaakimu manga lipu tee kaʼadili."<verse eid="PSA 96:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 96:11"/>Taroakamo o laiana akaunde-unde tee o dunia asambo-sambo;</para>
  <para style="q2" vid="PSA 96:11">taroakamo o tawo akanduu-nduu tee bhari-bharia modhaangiana i nuncana,<verse eid="PSA 96:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 96:12"/>taroakamo inawu akaunde-unde tee bhari-bharia modhaangiana i bhawona.</para>
  <para style="q2" vid="PSA 96:12">I wakutuu incia sumai bhari-bharia puuna kau i koo bhealagu roonamo akaunde-unde<verse eid="PSA 96:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 96:13"/>i aroana KAWASANA OPU, roonamo Incia bheaumba,</para>
  <para style="q2" vid="PSA 96:13">roonamo Incia bheaumba to ahaakimu alamu.</para>
  <para style="q1" vid="PSA 96:13">Incia bheahaakimu dunia tee kaʼadili,</para>
  <para style="q2" vid="PSA 96:13">tee bhari-bharia lipu tee kabanarana.<verse eid="PSA 96:13"/></para>
  <chapter eid="PSA 96"/>
  <chapter number="97" style="c" sid="PSA 97"/>
  <para style="s">KAWASANA OPU o Raja Momaoge</para>
  <para style="sr">
    <ref loc="PSA 97:1-12">97:1-12</ref></para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 97:1"/>KAWASANA OPU o Raja! Taroakamo alamu akaunde-unde;</para>
  <para style="q2" vid="PSA 97:1">taroakamo o pulo-pulo mobhari sumai akaunde-unde!<verse eid="PSA 97:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 97:2"/>Taʼina ngalu tee kalalanda abulilingi KAWASANA OPU,</para>
  <para style="q2" vid="PSA 97:2">kabanara tee kaʼadili amembali polandakana kauncuramakana.<verse eid="PSA 97:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 97:3"/>Waa arore i aroana,</para>
  <para style="q2" vid="PSA 97:3">apekangau manga bhali i saripina.<verse eid="PSA 97:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 97:4"/>Manga bhibhitona asuluwi alamu,</para>
  <para style="q2" vid="PSA 97:4">tee o dunia akamatamea tee arengku.<verse eid="PSA 97:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 97:5"/>Manga gunu arere mboomo taru i aroana KAWASANA OPU,</para>
  <para style="q2" vid="PSA 97:5">i aroana Aulataʼalana saangua alamu.<verse eid="PSA 97:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 97:6"/>Laiana apakoleleaka kabanarana,</para>
  <para style="q2" vid="PSA 97:6">tee bhari-bharia lipu akamata kamuliangina.<verse eid="PSA 97:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 97:7"/>Bhari-bharia mia mosombana barahala bheatopekaea,</para>
  <para style="q2" vid="PSA 97:7">siitumo manga incia mosomboakana karona roonamo barahalana;</para>
  <para style="q2" vid="PSA 97:7">bhari-bharia dewa bheasuju tee asomba i aroana Kawasana Opu.<verse eid="PSA 97:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 97:8"/>Raʼeatina Sion akaunde-unde tee manga kampo modhaangiana i Tana Yuda uka amasanaa,</para>
  <para style="q2" vid="PSA 97:8">wakutuuna arango kambotumu, e KAWASANA OPU.<verse eid="PSA 97:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 97:9"/>Ingkoomo, e KAWASANA OPU, Momalangana i bhawona saangua alamu;</para>
  <para style="q2" vid="PSA 97:9">Ingkoo utomuliangi mpuu alabhi minaaka i bhari-bharia dewa.<verse eid="PSA 97:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 97:10"/>E ingkomiu momaasiakana KAWASANA OPU, bancimea o kadhaki!</para>
  <para style="q2" vid="PSA 97:10">Sababuna KAWASANA OPU ajagani dhadhina uumatina mosaalihi,</para>
  <para style="q2" vid="PSA 97:10">tee arambasakea manga incia minaaka i limana mia madhaki.<verse eid="PSA 97:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 97:11"/>Kainawa asuluwi mia mobanara,</para>
  <para style="q2" vid="PSA 97:11">tee o kasanaa to mia momakatena incana.<verse eid="PSA 97:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 97:12"/>E manga mia mobanara, kaunde-undemo roonamo KAWASANA OPU,</para>
  <para style="q2" vid="PSA 97:12">tee usukurumo to sarona momangkilo.<verse eid="PSA 97:12"/></para>
  <chapter eid="PSA 97"/>
  <chapter number="98" style="c" sid="PSA 98"/>
  <para style="s">Wakutuuna Pasalaamatia Amakasumo</para>
  <para style="sr">
    <ref loc="PSA 98:1-9">98:1-9</ref></para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 98:1"/>Zaburu.</para>
  <para style="b" vid="PSA 98:1"/>
  <para style="q1" vid="PSA 98:1">Laguakamo lagu bhaau to KAWASANA OPU</para>
  <para style="q2" vid="PSA 98:1">roonamo Incia padhamo apewau manga giu inda momentela;</para>
  <para style="q2" vid="PSA 98:1">kasalaamati padhamo akarajaaia lima kaanana,</para>
  <para style="q2" vid="PSA 98:1">siitumo o lima kaanana momangkilo.<verse eid="PSA 98:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 98:2"/>KAWASANA OPU apakoleleaka kasalaamatina;</para>
  <para style="q2" vid="PSA 98:2">Incia apaumbaaka kaʼadilina i aroana matana manga lipu.<verse eid="PSA 98:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 98:3"/>Incia audhania o kaasina molagina tee akeniaka pojanjiana inda momabhotu</para>
  <para style="q2" vid="PSA 98:3">to siwuluna Israel.</para>
  <para style="q1" vid="PSA 98:3">Saangua dunia padhamo akamatea</para>
  <para style="q2" vid="PSA 98:3">o kasalaamati minaaka i Aulataʼalata.<verse eid="PSA 98:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 98:4"/>Sambo-sambomo to KAWASANA OPU, e saangua dunia!</para>
  <para style="q2" vid="PSA 98:4">Kaunde-undemo tee usambo-sambomo, tee ulaguakamea manga lagu kapujia!<verse eid="PSA 98:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 98:5"/>Laguakamea o lagu kapujia to KAWASANA OPU,</para>
  <para style="q2" vid="PSA 98:5">poose umagasiaakea tee kecapi tee suara momandii,<verse eid="PSA 98:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 98:6"/>tee torompe tee sangkakala tee suara momandii.</para>
  <para style="q2" vid="PSA 98:6">Sambo-sambomo i aroana Raja, siitumo o KAWASANA OPU!<verse eid="PSA 98:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 98:7"/>Taroakamo o tawo akanduu-nduu tee bhari-bharia modhaangiana i nuncana,</para>
  <para style="q2" vid="PSA 98:7">tee uka o dunia tee bhari-bharia mombooresia.<verse eid="PSA 98:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 98:8"/>Taroakamo manga umala asambo-sambo,</para>
  <para style="q2" vid="PSA 98:8">tee manga gunu alagu apobhawa-bhawa roonamo akaunde-unde<verse eid="PSA 98:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 98:9"/>i aroana KAWASANA OPU</para>
  <para style="q2" vid="PSA 98:9">roonamo Incia aumba to ahaakimu dunia.</para>
  <para style="q1" vid="PSA 98:9">Incia bheahaakimu alamu tee kabanara,</para>
  <para style="q2" vid="PSA 98:9">tee ahaakimu manga lipu tee kaʼadili.<verse eid="PSA 98:9"/></para>
  <chapter eid="PSA 98"/>
  <chapter number="99" style="c" sid="PSA 99"/>
  <para style="s">Kawasana Opu, Raja Momangkilo</para>
  <para style="sr">
    <ref loc="PSA 99:1-9">99:1-9</ref></para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 99:1"/>
    <note caller="-" style="x">
      <char style="xo" closed="false">99:1 </char>
      <char style="xt" closed="false">
        <ref loc="EXO 25:22">Limb. 25:22</ref>.</char>
    </note>KAWASANA OPU satotuuna o Raja!</para>
  <para style="q2" vid="PSA 99:1">Sumaimo manga lipu arengku!</para>
  <para style="q1" vid="PSA 99:1">Incia auncura i kauncuramakana i bhawona manga malaaʼekati kerub;<note caller="+" style="f"><char style="fr" closed="false">99:1 </char><char style="fq" closed="false">manga malaaʼekati kerub: </char><char style="ft" closed="false">Malaaʼekati igambaraaka mboomo mahaluku mokopani, agambaraaka kalangana Aulataʼala tee umbaana. Apogauakea ande kauncuramakana KAWASANA OPU dhaangia i bhawona manga malaaʼekati kerub. Dhaangia patuna rua malaaʼekati kerub i bhawona sorongana pojanjia tee i piamo itu Musa atarima firimanina Aulataʼala minaaka iwe sumai. Kamata </char><char style="xt" closed="false"><ref loc="EXO 25:18-22">Limb. 25:18-22</ref>.</char></note></para>
  <para style="q2" vid="PSA 99:1">taroakamo o dunia akohudha!<verse eid="PSA 99:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 99:2"/>KAWASANA OPU momaoge i Sion;</para>
  <para style="q2" vid="PSA 99:2">Incia amalanga alabhi minaaka i bhari-bharia lipu.<verse eid="PSA 99:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 99:3"/>Taroakamo manga incia apuji saromu momaoge tee motomaekana sumai.</para>
  <para style="q2" vid="PSA 99:3">Incia amangkilo mpuu!<verse eid="PSA 99:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 99:4"/>Raja Momakaa, momaasiakana kaʼadili,</para>
  <para style="q2" vid="PSA 99:4">Ingkoo upadhamo upatotapu kabanara;</para>
  <para style="q1" vid="PSA 99:4">Ingkoo upadhamo uewaaka hukumu tee kaʼadili i tanga-tangana miana Israel.<verse eid="PSA 99:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 99:5"/>Pekalangea o KAWASANA OPU, Aulataʼalata, tee usujumo usomba i polandakana aena!</para>
  <para style="q2" vid="PSA 99:5">Incia amangkilo mpuu!<verse eid="PSA 99:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 99:6"/>Musa tee Harun adhaangia i tanga-tangana manga imamuna,</para>
  <para style="q2" vid="PSA 99:6">Samuel<note caller="+" style="f"><char style="fr" closed="false">99:6 </char><char style="fq" closed="false">Samuel: </char><char style="ft" closed="false">Nabii Samuel molantina Daud to amembali rajana miana Israel.</char></note> atolentu i tanga-tangana manga mia mogoraakana sarona.</para>
  <para style="q2" vid="PSA 99:6">Manga incia agora i KAWASANA OPU, tee Incia alawania.<verse eid="PSA 99:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 99:7"/>
    <note caller="-" style="x">
      <char style="xo" closed="false">99:7 </char>
      <char style="xt" closed="false">
        <ref loc="EXO 33:9">Limb. 33:9</ref>.</char>
    </note>Incia afirimani minaaka i ariina taʼina ngalu i manga incia;</para>
  <para style="q2" vid="PSA 99:7">manga incia akenia pekatangka manga parintana,</para>
  <para style="q2" vid="PSA 99:7">tee manga katotapu mopadhana idhawuakana to manga incia.<verse eid="PSA 99:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 99:8"/>E KAWASANA OPU, e Aulataʼalamami,</para>
  <para style="q2" vid="PSA 99:8">Ingkoo padhamo ulawani manga incia.</para>
  <para style="q1" vid="PSA 99:8">Ingkoo o Aulataʼala moʼamponina dosana miana Israel,</para>
  <para style="q2" vid="PSA 99:8">maka Ingkoo uka mohukumuna manga incia wakutuuna apewau kasalaha.<verse eid="PSA 99:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 99:9"/>Pekalangea o KAWASANA OPU, Aulataʼalata,</para>
  <para style="q2" vid="PSA 99:9">tee usujumo usombaia i gununa momangkilo;</para>
  <para style="q2" vid="PSA 99:9">roonamo o KAWASANA OPU Aulataʼalata, amangkilo.<verse eid="PSA 99:9"/></para>
  <chapter eid="PSA 99"/>
  <chapter number="100" style="c" sid="PSA 100"/>
  <para style="s">Pujimo Kawasana Opu i nuncana Bhanuana</para>
  <para style="sr">
    <ref loc="PSA 100:1-5">100:1-5</ref></para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 100:1"/>Zaburu to kurubani kasukuru.</para>
  <para style="b" vid="PSA 100:1"/>
  <para style="q1" vid="PSA 100:1">Sambo-sambomo to KAWASANA OPU, e saangua alamu!<verse eid="PSA 100:1"/></para>
  <para style="q2">
    <verse number="2" style="v" sid="PSA 100:2"/>Sambaheamo i KAWASANA OPU tee ukaunde-undemo,</para>
  <para style="q2" vid="PSA 100:2">umbamo i aroana tee ulaguaka lagu-lagu momasanaa.<verse eid="PSA 100:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 100:3"/>Mataumea ande o KAWASANA OPU sumai o Aulataʼala.</para>
  <para style="q2" vid="PSA 100:3">Inciamo manga padhaangiana, tee ingkita o pewauana;</para>
  <para style="q2" vid="PSA 100:3">ingkitamo o uumatina tee dumba-dumba igembalana.<verse eid="PSA 100:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 100:4"/>
    <note caller="-" style="x">
      <char style="xo" closed="false">100:4-5 </char>
      <char style="xt" closed="false">
        <ref loc="PSA 106:1">Zab. 106:1</ref>; <ref loc="PSA 107:1">107:1</ref>; <ref loc="PSA 118:1">118:1</ref>; <ref loc="PSA 136:1">136:1</ref>; <ref loc="JER 33:11">Yer. 33:11</ref>.</char>
    </note>Pesuamo ulaloi bhambana lawana upoose ulaguaka lagu kasukuru,</para>
  <para style="q2" vid="PSA 100:4">upesua i aroana Bhanuana Aulataʼala upoose upujia.</para>
  <para style="q2" vid="PSA 100:4">Sukurumo i Incia tee upujimo sarona.<verse eid="PSA 100:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 100:5"/>Roonamo o KAWASANA OPU sumai amalape;</para>
  <para style="q2" vid="PSA 100:5">kaasina molagina abakaa saʼumurua,</para>
  <para style="q2" vid="PSA 100:5">tee Incia akeni janjina saʼumurua zamani.<verse eid="PSA 100:5"/></para>
  <chapter eid="PSA 100"/>
  <chapter number="101" style="c" sid="PSA 101"/>
  <para style="s">Tolauna Onina Raja</para>
  <para style="sr">
    <ref loc="PSA 101:1-8">101:1-8</ref></para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 101:1"/>Zaburuna Daud.</para>
  <para style="b" vid="PSA 101:1"/>
  <para style="q1" vid="PSA 101:1">Iaku bhekulaguaka lagu to kaasina molagina tee kaʼadili,</para>
  <para style="q2" vid="PSA 101:1">to Ingkoo, e KAWASANA OPU, iaku bhekulaguaka lagu kapujia.<verse eid="PSA 101:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 101:2"/>Iaku bhekupengkaadhariaka carana mamudhaakana kudhadhi inda tee kasalahaku.</para>
  <para style="q2" vid="PSA 101:2">Naepia bhekupotibhaaka dhala sumai?</para>
  <para style="b" vid="PSA 101:2"/>
  <para style="q1" vid="PSA 101:2">Iaku bhekudhadhi tee kakatena totona incaku i nuncana bhanuaku.<verse eid="PSA 101:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 101:3"/>Iaku inda bhekudhikaia i aroaku</para>
  <para style="q2" vid="PSA 101:3">giu inda mokoampadhea.</para>
  <para style="b" vid="PSA 101:3"/>
  <para style="q1" vid="PSA 101:3">Iaku kubancia o pewau motagalina Aulataʼala;</para>
  <para style="q2" vid="PSA 101:3">giu incia sumai amaridho tee iaku.<verse eid="PSA 101:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 101:4"/>Iaku bhekupekaridho karoku tee fikiri inda mototo,</para>
  <para style="q2" vid="PSA 101:4">tee kumendeu kumatau tee saangu giu uka momadhaki.<verse eid="PSA 101:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 101:5"/>Incemapo uka mofitanaana sarimbanuana i talikuna</para>
  <para style="q2" vid="PSA 101:5">bhekupabinasea.</para>
  <para style="q1" vid="PSA 101:5">Iaku inda bhekusabara</para>
  <para style="q2" vid="PSA 101:5">to mia mosombo tee momalangana incana.<verse eid="PSA 101:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 101:6"/>Iaku kumaasiaka manga mia motaʼatina tee Aulataʼala,</para>
  <para style="q2" vid="PSA 101:6">mamudhaakana manga incia amembali amboore tee iaku.</para>
  <para style="q1" vid="PSA 101:6">Mia modhadhina i dhala inda mosala,</para>
  <para style="q2" vid="PSA 101:6">inciamo bhemolaianiaku.<verse eid="PSA 101:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 101:7"/>Pande gau-gau</para>
  <para style="q2" vid="PSA 101:7">inda bheamboore i bhanuaku;</para>
  <para style="q1" vid="PSA 101:7">mia mobhoasakana kagau-gau</para>
  <para style="q2" vid="PSA 101:7">inda bheasadhaadhaa i aroaku.<verse eid="PSA 101:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 101:8"/>Saesaeo bhekupabinasea</para>
  <para style="q2" vid="PSA 101:8">bhari-bharia mia madhaki i lipu sii,</para>
  <para style="q1" vid="PSA 101:8">mamudhaakana kupomofu bhari-bharia mia mopewauna kadhaki</para>
  <para style="q2" vid="PSA 101:8">minaaka i kotana KAWASANA OPU.<verse eid="PSA 101:8"/></para>
  <chapter eid="PSA 101"/>
  <chapter number="102" style="c" sid="PSA 102"/>
  <para style="s">Doʼa Emaniana Tulungi tee Doʼa to Sion</para>
  <para style="sr">
    <ref loc="PSA 102:1-29">102:1-29</ref></para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 102:1"/>Doʼana samia monarakaana, i wakutuuna amangule tee amalute apeenci i aroana KAWASANA OPU.<verse eid="PSA 102:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 102:2"/>E KAWASANA OPU, maasangia urangoa o doʼaku;</para>
  <para style="q2" vid="PSA 102:2">taroakamo o goraku akawa i Ingkoo.<verse eid="PSA 102:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 102:3"/>Bholi ubuniakea o roumu minaaka i iaku</para>
  <para style="q2" vid="PSA 102:3">i eona kunamisi kanarakaa.</para>
  <para style="q1" vid="PSA 102:3">Perangoiaku;</para>
  <para style="q2" vid="PSA 102:3">i eona kugora madheimo ulawaniaku,<verse eid="PSA 102:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 102:4"/>roonamo o dhadhiku aila mboomo ombu,</para>
  <para style="q2" vid="PSA 102:4">tee manga bukuku amangau mboomo dhalika.<verse eid="PSA 102:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 102:5"/>Ngangarandaku mboomo ibhebhe tee amalau mboomo rumpu,</para>
  <para style="q2" vid="PSA 102:5">sabutuna amawala kukande.<verse eid="PSA 102:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 102:6"/>Roonamo kakaana suaraku kupeenci,</para>
  <para style="q2" vid="PSA 102:6">badaku soomo buku.<verse eid="PSA 102:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 102:7"/>Iaku mboomo manu-manu koa i tana matuu,</para>
  <para style="q2" vid="PSA 102:7">mboomo koa maidhiidhi i tampa mohancuru tee momalino.<verse eid="PSA 102:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 102:8"/>Iaku Inda amembali kukole,</para>
  <para style="q2" vid="PSA 102:8">mboomo manu-manu modhadhina sambaa-mbaana i bhawona padhana bhanua.<verse eid="PSA 102:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 102:9"/>Saeoa ahinaaku manga musuku;</para>
  <para style="q2" vid="PSA 102:9">manga incia aele-eleaku tee apake saroku to katunda.<verse eid="PSA 102:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 102:10"/>Iaku kukande rapu mboomo roti,</para>
  <para style="q2" vid="PSA 102:10">giu isumpuku apojaloaka lolu,<verse eid="PSA 102:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 102:11"/>roonamo amaramu tee pamurumu;</para>
  <para style="q2" vid="PSA 102:11">uangkaaku, kasiimpo ubhanakaaku.<verse eid="PSA 102:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 102:12"/>Saesaeo dhadhiku mboomo ngkamia-mia i wakutuuna konowia,</para>
  <para style="q2" vid="PSA 102:12">tee kumalau mboomo rumpu.<verse eid="PSA 102:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 102:13"/>Maka Ingkoo, e KAWASANA OPU, ukokauncuramaka saʼumurua;</para>
  <para style="q2" vid="PSA 102:13">saromu asadhaadhaa atoudhani saʼumurua zamani.<verse eid="PSA 102:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 102:14"/>Ingkoo bheubhangu tee umaasiaka Sion,</para>
  <para style="q2" vid="PSA 102:14">roonamo wakutuunamo to umaasiakea,</para>
  <para style="q2" vid="PSA 102:14">tee akawamo wakutuu itantuakana.<verse eid="PSA 102:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 102:15"/>Manga bhatuamu amaasiaka manga bhatuna Kota Sion,</para>
  <para style="q2" vid="PSA 102:15">moomini o bhatuna amembalimo ngawu.<verse eid="PSA 102:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 102:16"/>Sumaimo manga lipu amembali amaeka tee sarona KAWASANA OPU,</para>
  <para style="q2" vid="PSA 102:16">tee bhari-bharia raja i alamu amaeka tee pewaumu momulia.<verse eid="PSA 102:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 102:17"/>KAWASANA OPU bheabhangu Sion pendua,</para>
  <para style="q2" vid="PSA 102:17">tee Incia bheaumba i nuncana kamuliangina.<verse eid="PSA 102:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 102:18"/>Incia bheaperangoi doʼana manga mia monarakaa,</para>
  <para style="q2" vid="PSA 102:18">tee o KAWASANA OPU inda bheamendeu doʼana manga incia.<verse eid="PSA 102:18"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 102:19"/>Buria bhari-bharia o giu incia sumai to siwulu bhemoumbana naile itu,</para>
  <para style="q2" vid="PSA 102:19">mamudhaakana o lipu bhemolaahirina naile itu apuji KAWASANA OPU.<verse eid="PSA 102:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 102:20"/>KAWASANA OPU apotonto minaaka i kalangaana i tampana momangkilo,</para>
  <para style="q2" vid="PSA 102:20">minaaka i sorogaa Incia apotonto i alamu,<verse eid="PSA 102:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 102:21"/>to aperangoi pekidheina mia itorongku</para>
  <para style="q2" vid="PSA 102:21">tee arambasaka manga mia mopadhana itantuaka to atopekamate;<verse eid="PSA 102:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 102:22"/>mamudhaakana o sarona KAWASANA OPU atopetulatulaaka i Sion,</para>
  <para style="q2" vid="PSA 102:22">tee bheatopuji i Yerusalem,<verse eid="PSA 102:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 102:23"/>wakutuuna manga lipu tee manga pamarintana,</para>
  <para style="q2" vid="PSA 102:23">aporomusaka to asambahea i KAWASANA OPU.<verse eid="PSA 102:23"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 102:24"/>KAWASANA OPU apaila kakaaku wakutuuna dhaangiapo kumangura,</para>
  <para style="q2" vid="PSA 102:24">tee apekampodho umuruku.<verse eid="PSA 102:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 102:25"/>Kasiimpo kupogau, "E Aulataʼalaku, bholi uala inyawaku i pomuntangaana umuruku,</para>
  <para style="q2" vid="PSA 102:25">Ingkoo usadhaadhaa dhaangia saʼumurua zamani."<verse eid="PSA 102:25"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 102:26"/>I piamo itu Ingkoo upadhaangia ariina dunia;</para>
  <para style="q2" vid="PSA 102:26">umbe, laiana uka karajaana limamu.<verse eid="PSA 102:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 102:27"/>Bhari-bharia sumai bheamofu, maka Ingkoo usadhaadhaa udhadhi saʼumurua.</para>
  <para style="q2" vid="PSA 102:27">Bhari-bharia sumai bheamalusa mboomo pakea,</para>
  <para style="q1" vid="PSA 102:27">Ingkoo bheubhalii alamu sii mboomo satuwu juba</para>
  <para style="q2" vid="PSA 102:27">tee bhari-bharia uka bheakoʼaahiri.<verse eid="PSA 102:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 102:28"/>Maka Ingkoo asadhaadhaa inda ubhalii,</para>
  <para style="q2" vid="PSA 102:28">tee o dhadhimu inda bheakoʼaahiri.<verse eid="PSA 102:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="PSA 102:29"/>Anamami bheamboore tee kaʼamani,</para>
  <para style="q2" vid="PSA 102:29">tee o siwuluna manga incia bheasadhaadhaa i aroamu.<verse eid="PSA 102:29"/></para>
  <chapter eid="PSA 102"/>
  <chapter number="103" style="c" sid="PSA 103"/>
  <para style="s">Pujimo Kawasana Opu, E Ngangarandaku!</para>
  <para style="sr">
    <ref loc="PSA 103:1-22">103:1-22</ref></para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 103:1"/>Zaburuna Daud.</para>
  <para style="b" vid="PSA 103:1"/>
  <para style="q1" vid="PSA 103:1">Pujimo KAWASANA OPU, e ngangarandaku!</para>
  <para style="q2" vid="PSA 103:1">E saangua baatiniku, pujimea o sarona momangkilo!<verse eid="PSA 103:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 103:2"/>Pujimo KAWASANA OPU, e ngangarandaku,</para>
  <para style="q2" vid="PSA 103:2">tee bholi umalinguakea bhari-bharia kalapena.<verse eid="PSA 103:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 103:3"/>Incia moʼamponina bhari-bharia kasalahamu,</para>
  <para style="q2" vid="PSA 103:3">tee Incia mopauntona bhari-bharia panyakimu.<verse eid="PSA 103:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 103:4"/>Incia mopasalaamatina inyawamu minaaka i koburu,</para>
  <para style="q2" vid="PSA 103:4">tee Incia modhawuko rahumati tee kaasina molagina.<verse eid="PSA 103:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 103:5"/>Incia mopatumpuna incamu tee kalape.</para>
  <para style="q2" vid="PSA 103:5">Sabutuna ingkoo usadhaadhaa umangura mboomo manu-manu bunia.<verse eid="PSA 103:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 103:6"/>KAWASANA OPU mokarajaana hukumu tee kaʼadili</para>
  <para style="q2" vid="PSA 103:6">to bhari-bharia mia motopisaki.<verse eid="PSA 103:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 103:7"/>Incia asusuaka dhalana to Musa</para>
  <para style="q2" vid="PSA 103:7">tee apaumbaaka opea mopadhana ipewauna to miana Israel.<verse eid="PSA 103:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 103:8"/>Sababuna o KAWASANA OPU abukeaka kaasina inca tee rahumati,</para>
  <para style="q2" vid="PSA 103:8">Incia sadia asabara tee o kaasina molagina ataralabhi-labhi.<verse eid="PSA 103:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 103:9"/>Incia inda mangaraeaka torotorosu,</para>
  <para style="q2" vid="PSA 103:9">tee inda bheaʼamara to saʼumurua.<verse eid="PSA 103:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 103:10"/>Incia inda manga hukumu apokana tee dosata,</para>
  <para style="q2" vid="PSA 103:10">atawa mangabalasi apokana tee kasalahata.<verse eid="PSA 103:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 103:11"/>Roonamo mboomo kalangana laiana i bhawona alamu,</para>
  <para style="q2" vid="PSA 103:11">mboo sumaimo o kaogena kaasina molagina to manga mia momaekaia.<verse eid="PSA 103:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 103:12"/>Mboomo karidhona minaaka i timbu sakawana i bhara,</para>
  <para style="q2" vid="PSA 103:12">mboo sumaimo Kawasana Opu ahapusu manga dosata tee abhanakea pekaridho minaaka i karota.<verse eid="PSA 103:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 103:13"/>Mboomo samia ama amaasiaka manga anana,</para>
  <para style="q2" vid="PSA 103:13">mboo sumaimo o KAWASANA OPU amaasiaka manga mia momaekaia.<verse eid="PSA 103:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 103:14"/>Roonamo Incia amataua tuaapa ingkita tatopebhangui;</para>
  <para style="q2" vid="PSA 103:14">Incia amataua ande ingkita sii tangkanamo ngawu.<verse eid="PSA 103:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 103:15"/>Maanusia o dhadhina amampodho mboomo rumpu;</para>
  <para style="q2" vid="PSA 103:15">manga incia akokamba mboomo kamba-kamba i inawu;<verse eid="PSA 103:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 103:16"/>ande atowiia ngalu, amalaumo o kamba-kamba sumai,</para>
  <para style="q2" vid="PSA 103:16">tee o tampana indamo atomatau uka.<verse eid="PSA 103:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 103:17"/>Maka o kaasi molagina KAWASANA OPU sadhaadhaa abakaa to manga mia momaekaia,</para>
  <para style="q2" vid="PSA 103:17">tee o kabanarana to anana tee siwuluna manga incia,<verse eid="PSA 103:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 103:18"/>siitumo to manga incia mokeniakana pojanjiana</para>
  <para style="q2" vid="PSA 103:18">tee moudhania to aose manga parintana.<verse eid="PSA 103:18"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 103:19"/>KAWASANA OPU padhamo apatotapuaka kauncuramakana i sorogaa,</para>
  <para style="q2" vid="PSA 103:19">tee o pamarintana akuasai bhari-bharia ipadhaangiana.<verse eid="PSA 103:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 103:20"/>E bhari-bharia malaaʼekati pujimo KAWASANA OPU,</para>
  <para style="q2" vid="PSA 103:20">e manga malaaʼekati mobarani momakaa tee mopewauna firimanina,</para>
  <para style="q2" vid="PSA 103:20">tee motaʼatina tee opea ibhoasakana!<verse eid="PSA 103:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 103:21"/>E bhari-bharia tantarana i sorogaa pujimo KAWASANA OPU,</para>
  <para style="q2" vid="PSA 103:21">e manga bhatuana moosena parintana!<verse eid="PSA 103:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 103:22"/>Pujimo KAWASANA OPU, e bhari-bharia mahaluku ipadhaangiana,</para>
  <para style="q2" vid="PSA 103:22">i sagala tampa ikuasaina!</para>
  <para style="q1" vid="PSA 103:22">Pujimo KAWASANA OPU, e ngangarandaku!<verse eid="PSA 103:22"/></para>
  <chapter eid="PSA 103"/>
  <chapter number="104" style="c" sid="PSA 104"/>
  <para style="s">Kaogesana Kawasana Opu i nuncana Bhari-bharia Ipadhaangiana</para>
  <para style="sr">
    <ref loc="PSA 104:1-35">104:1-35</ref></para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 104:1"/>Pujimo KAWASANA OPU, e ngangarandaku!</para>
  <para style="b" vid="PSA 104:1"/>
  <para style="q2" vid="PSA 104:1">E KAWASANA OPU, e Aulataʼalaku! Ingkoomo momaogena!</para>
  <para style="q1" vid="PSA 104:1">Ingkoo uposalibumbuaka kaogesa tee kamuliangi,<verse eid="PSA 104:1"/></para>
  <para style="q2">
    <verse number="2" style="v" sid="PSA 104:2"/>tee upakana kainawa mboomo juba.</para>
  <para style="q1" vid="PSA 104:2">Ingkoo ubhakesaka laiana mboomo saangu kema,<verse eid="PSA 104:2"/></para>
  <para style="q2">
    <verse number="3" style="v" sid="PSA 104:3"/>tee upakaro ariina bhanuamu i uwe i bhawona kubana laiana.</para>
  <para style="q1" vid="PSA 104:3">Manga taʼina ngalu upamembalia karetamu,</para>
  <para style="q2" vid="PSA 104:3">tee Ingkoo usawi i bhawona ngalu.<verse eid="PSA 104:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 104:4"/>Ngalu upamembalia potumpuamu,</para>
  <para style="q2" vid="PSA 104:4">tee o bherese amembali bhatuamu.<verse eid="PSA 104:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 104:5"/>Ingkoo udhika alamu i bhawona fondasina tee upekatangkea,</para>
  <para style="q2" vid="PSA 104:5">sabutuna inda bheakohudha saʼumurua.<verse eid="PSA 104:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 104:6"/>Ingkoo apake andalaoge mboomo juba to usalibumbu alamu,</para>
  <para style="q2" vid="PSA 104:6">o uwena mawa apene atutubhi manga gunu.<verse eid="PSA 104:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 104:7"/>Roonamo pamurumu o uwe sumai asiwulu makaa tee apalai,</para>
  <para style="q2" vid="PSA 104:7">tee roonamo arango ruuna guntumu o uwe sumai apalai pekadhei.<verse eid="PSA 104:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 104:8"/>Uwe sumai akompa i manga gunu tee asapo i nuncana manga mbolonga,</para>
  <para style="q2" vid="PSA 104:8">i tampa mopadhana itantuakamu to uwe sumai.<verse eid="PSA 104:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 104:9"/>Ingkoo padhamo utantuakea o tidha inda momembalina ilaloina</para>
  <para style="q2" vid="PSA 104:9">mamudhaakana o uwe sumai inda apendua uka asalibumbu alamu.<verse eid="PSA 104:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 104:10"/>Ingkoo upewau matana uwe alua i manga mbolonga,</para>
  <para style="q2" vid="PSA 104:10">kasiimpo asiwulu i tanga-tangana manga gunu,<verse eid="PSA 104:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 104:11"/>tee apasumpu bhari-bharia binata maila;</para>
  <para style="q2" vid="PSA 104:11">apaila katuuna bhorokona manga keledai maila.<verse eid="PSA 104:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 104:12"/>I bhiwina uwe sumai manga manu-manu i antara amboore,</para>
  <para style="q2" vid="PSA 104:12">kasiimpo manga incia apekawowo i tanga-tangana manga puuna kau.<verse eid="PSA 104:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 104:13"/>Minaaka i paana bhanuamu upasapoakea wao to manga gunu;</para>
  <para style="q2" vid="PSA 104:13">alamu abukeaka hali momalape mopadhana ipadhaangiamu.<verse eid="PSA 104:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 104:14"/>Ingkoo mopatuwuna rumpu to binata kadhambaaka,</para>
  <para style="q2" vid="PSA 104:14">tee upatuwu penembula to maanusia</para>
  <para style="q2" vid="PSA 104:14">mamudhaakana o alamu amembali akohasiliaka giuna ikande,<verse eid="PSA 104:14"/></para>
  <para style="q2">
    <verse number="15" style="v" sid="PSA 104:15"/>siitumo o angguru ipeeluna maanusia,</para>
  <para style="q2" vid="PSA 104:15">mina zaitun mopewauna rou akocahea,</para>
  <para style="q2" vid="PSA 104:15">tee o roti mopekatangkana dhadhina maanusia.<verse eid="PSA 104:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 104:16"/>Manga puuna kauna KAWASANA OPU apotibhaaka wao motaralabhi-labhi,</para>
  <para style="q2" vid="PSA 104:16">siitumo manga puuna aras i Libanon ipombulana karona.<verse eid="PSA 104:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 104:17"/>Iwe sumaimo manga manu-manu akarajaa poteona,</para>
  <para style="q2" vid="PSA 104:17">manu-manu ranggung<note caller="+" style="f"><char style="fr" closed="false">104:17 </char><char style="fq" closed="false">manu-manu ranggung: </char><char style="ft" closed="false">Manu-manu incia sii o bhanguna mboomo manu-manu hoo, aena amaarate tee o kalangana badana alabhi sametere, tee o tampana apeelo kinande i uwe tee i ati, tee o poteona i puuna kau momalanga.</char></note> akarajaa bhanuana i puuna sanobar.<verse eid="PSA 104:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 104:18"/>Manga gunu momalanga amembali tampa mbooresana bhembe maila,</para>
  <para style="q2" vid="PSA 104:18">tee manga kabumbu mokobhatu amembali tampana peulusana paapaando.<note caller="+" style="f"><char style="fr" closed="false">104:18 </char><char style="fq" closed="false">paapaando: </char><char style="ft" closed="false">Binata incia sii isarongiaka kancil i nuncana pogau Indonesia.</char></note><verse eid="PSA 104:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 104:19"/>Ingkoo upadhaangia bula to amembali tanda to motantuakana wakutuuna bula mobhaau,</para>
  <para style="q2" vid="PSA 104:19">tee o matanaeo amataua naepia o wakutuuna bheatondu.<verse eid="PSA 104:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 104:20"/>Ingkoo mopadhaangiana kalalanda, kasiimpo amembali amalo,</para>
  <para style="q2" vid="PSA 104:20">i wakutuumo incia sumai sagala binata i koo aposawele.<verse eid="PSA 104:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 104:21"/>Manga singa mangura akomburu apeelo kinandena,</para>
  <para style="q2" vid="PSA 104:21">aemani kinande minaaka i Aulataʼala.<verse eid="PSA 104:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 104:22"/>Matanaeo uka abhete,</para>
  <para style="q2" vid="PSA 104:22">kasiimpo manga binata sumai ambuli apotidhole i nuncana mbooresana.<verse eid="PSA 104:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 104:23"/>Kasiimpo maanusia alimba to akarajaa,</para>
  <para style="q2" vid="PSA 104:23">tee apajala usahana sakawana konowia.<verse eid="PSA 104:23"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 104:24"/>E KAWASANA OPU, abhari mpuu mopadhana ipewaumu!</para>
  <para style="q2" vid="PSA 104:24">Tee hikimati upamembalia bhari-bharia;</para>
  <para style="q2" vid="PSA 104:24">alamu abukeaka tee mahalukumu.<verse eid="PSA 104:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 104:25"/>Kamatea o tawo momaewa motobhakesakana sumai,</para>
  <para style="q2" vid="PSA 104:25">iwe sumako dhaangia tee sagala giu mahaluku mopondele inda atogagari o kabharina,</para>
  <para style="q2" vid="PSA 104:25">dhaangia o binata momaidhiidhi tee manga binata maoge.<verse eid="PSA 104:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 104:26"/>Iwe sumai manga kapala adhala,</para>
  <para style="q2" vid="PSA 104:26">tee iwe sumai uka o Lewiatan<note caller="+" style="f"><char style="fr" closed="false">104:26 </char><char style="fq" closed="false">Lewiatan: </char><char style="ft" closed="false">Mahaluku maoge i tawo mboomo naga. Kamata </char><char style="xt" closed="false"><ref loc="PSA 74:14">74:14</ref>.</char></note> mopadhana ipadhaangiamu amagamagasia.<verse eid="PSA 104:26"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 104:27"/>Bhari-bharia aharapu i Ingkoo,</para>
  <para style="q2" vid="PSA 104:27">mamudhaakana udhawua kinande ande akawa wakutuuna.<verse eid="PSA 104:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 104:28"/>Wakutuuna udhawuakea kinande,</para>
  <para style="q2" vid="PSA 104:28">manga incia arombusakea;</para>
  <para style="q1" vid="PSA 104:28">wakutuuna ubungkale limamu,</para>
  <para style="q2" vid="PSA 104:28">manga incia akandea sakawana amambosu.<verse eid="PSA 104:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="PSA 104:29"/>Wakutuuna ubuniaka roumu,</para>
  <para style="q2" vid="PSA 104:29">manga incia atokidha;</para>
  <para style="q1" vid="PSA 104:29">Wakutuuna uala poinuncana, amatemo manga incia,</para>
  <para style="q2" vid="PSA 104:29">kasiimpo ambuli pendua amembali ngawu.<verse eid="PSA 104:29"/></para>
  <para style="q1">
    <verse number="30" style="v" sid="PSA 104:30"/>Maka ande manga incia udhawua poinunca,<note caller="+" style="f"><char style="fr" closed="false">104:30 </char><char style="fq" closed="false">udhawua poinunca: </char><char style="ft" closed="false">Amembali uka akomaʼana "ulamboko rohimu."</char></note> manga incia atopamembali;</para>
  <para style="q2" vid="PSA 104:30">Ingkoo udhawu dhadhi bhaau to alamu.<verse eid="PSA 104:30"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="31" style="v" sid="PSA 104:31"/>Taroakamo o kamuliangina KAWASANA OPU asadhaadhaa saʼumurua;</para>
  <para style="q2" vid="PSA 104:31">taroakamo KAWASANA OPU akaunde-unde tee opea mopadhana ipewauna!<verse eid="PSA 104:31"/></para>
  <para style="q1">
    <verse number="32" style="v" sid="PSA 104:32"/>Wakutuuna Incia atonto alamu, sumaimo o alamu akorende,</para>
  <para style="q2" vid="PSA 104:32">tee wakutuuna adhingku manga gunu, sabutuna akoombu manga gunu incia sumai!<verse eid="PSA 104:32"/></para>
  <para style="q1">
    <verse number="33" style="v" sid="PSA 104:33"/>Iaku bhekulaguaka lagu to KAWASANA OPU saʼumurua dhadhiku;</para>
  <para style="q2" vid="PSA 104:33">iaku bhekupuji Aulataʼalaku kananteana dhaangiapo kudhadhi.<verse eid="PSA 104:33"/></para>
  <para style="q1">
    <verse number="34" style="v" sid="PSA 104:34"/>Maasangia opea ifikiriku amasanaakea incana;</para>
  <para style="q2" vid="PSA 104:34">iaku bhekukaunde-unde roonamo KAWASANA OPU.<verse eid="PSA 104:34"/></para>
  <para style="q1">
    <verse number="35" style="v" sid="PSA 104:35"/>Taroakamo o mia mokodosa amapupu minaaka i bhawona alamu,</para>
  <para style="q2" vid="PSA 104:35">tee manga mia madhaki indamo dhaangia.</para>
  <para style="b" vid="PSA 104:35"/>
  <para style="q1" vid="PSA 104:35">Pujimo KAWASANA OPU, e ngangarandaku!</para>
  <para style="q2" vid="PSA 104:35">Pujimo KAWASANA OPU!<verse eid="PSA 104:35"/></para>
  <chapter eid="PSA 104"/>
  <chapter number="105" style="c" sid="PSA 105"/>
  <para style="s">Manga Kapujia to Pewauna Kawasana Opu i Zamani Mangenge</para>
  <para style="sr">
    <ref loc="PSA 105:1-45">105:1-45</ref></para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 105:1"/>Sukurumo i KAWASANA OPU, tee ugoraakamo sarona,</para>
  <para style="q2" vid="PSA 105:1">pakoleleakea opea ipewauna i tanga-tangana manga lipu!<verse eid="PSA 105:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 105:2"/>Lagumo to Incia, tee upuji-pujimea;</para>
  <para style="q2" vid="PSA 105:2">petulatulaakamea bhari-bharia ipewauna inda momentela!<verse eid="PSA 105:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 105:3"/>Kaunde-undemo roonamo sarona momangkilo;</para>
  <para style="q2" vid="PSA 105:3">taroakamo akaunde-undeaka manga mia mopeelona KAWASANA OPU.<verse eid="PSA 105:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 105:4"/>Sadiamo upeelo KAWASANA OPU tee uemani kakaa minaaka i Incia;</para>
  <para style="q2" vid="PSA 105:4">sadiamo upeeloa.<verse eid="PSA 105:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 105:5"/>Udhania manga pewauna inda momentela mopadhana ikarajaana,</para>
  <para style="q2" vid="PSA 105:5">manga muuzizatina, tee manga kambotu ipakawaakana,<verse eid="PSA 105:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 105:6"/>e siwuluna Ibrahim, o bhatuana Aulataʼala,</para>
  <para style="q2" vid="PSA 105:6">e siwuluna Yakub, uumati ipilina Kawasana Opu!<verse eid="PSA 105:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 105:7"/>KAWASANA OPU satotuuna o Aulataʼalata;</para>
  <para style="q2" vid="PSA 105:7">kambotuna atopake i saangua alamu.<verse eid="PSA 105:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 105:8"/>Incia sadia bheaudhania o pojanjiana,</para>
  <para style="q2" vid="PSA 105:8">tee firimani mopadhana iparintaakana saʼumurua to siwulu bhemoumbana naile itu,<verse eid="PSA 105:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 105:9"/>
    <note caller="-" style="x">
      <char style="xo" closed="false">105:9 </char>
      <char style="xt" closed="false">
        <ref loc="GEN 12:7">Bhaa. 12:7</ref>; <ref loc="GEN 17:8">17:8</ref>; <ref loc="GEN 26:3">26:3</ref>.</char>
    </note>siitumo o pojanjia ibhokena tee Ibrahim,</para>
  <para style="q2" vid="PSA 105:9">tee o sumpana tee Ishak,<verse eid="PSA 105:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 105:10"/>
    <note caller="-" style="x">
      <char style="xo" closed="false">105:10-11 </char>
      <char style="xt" closed="false">
        <ref loc="GEN 28:13">Bhaa. 28:13</ref>.</char>
    </note>Incia apekatangka sumpa incia sumai to Yakub amembali saangu katotapu,</para>
  <para style="q2" vid="PSA 105:10">tee amembali pojanjia mobakaa to miana Israel,<verse eid="PSA 105:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 105:11"/>firimanina, "Tana Kanaan bhekudhawuaka to ingkoo,</para>
  <para style="q2" vid="PSA 105:11">amembali tinaurakamu."<verse eid="PSA 105:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 105:12"/>Wakutuuna miana Israel o kabharina tangkanamo saidhe,</para>
  <para style="q2" vid="PSA 105:12">saidhemea, tee manga incia amboore mboomo mia dhaga iwe sumai,<verse eid="PSA 105:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 105:13"/>manga incia apekalingka-lingka minaaka i saangu lipu sakawana i lipu mosagaanana,</para>
  <para style="q2" vid="PSA 105:13">minaaka i saangu pamarinta sakawana i pamarintana lipu mosagaanana.<verse eid="PSA 105:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 105:14"/>
    <note caller="-" style="x">
      <char style="xo" closed="false">105:14-15 </char>
      <char style="xt" closed="false">
        <ref loc="GEN 20:3-7">Bhaa. 20:3-7</ref>.</char>
    </note>Maka o KAWASANA OPU inda ataroaka incema uka mopisakina manga incia.</para>
  <para style="q2" vid="PSA 105:14">KAWASANA OPU audhaniaka manga raja to ajagani manga incia,<verse eid="PSA 105:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 105:15"/>"Bholi ukia-kiaia manga mia ipiliku,</para>
  <para style="q2" vid="PSA 105:15">tee bholi upacilaka manga nabiiku!"<verse eid="PSA 105:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 105:16"/>
    <note caller="-" style="x">
      <char style="xo" closed="false">105:16 </char>
      <char style="xt" closed="false">
        <ref loc="GEN 41:53-57">Bhaa. 41:53-57</ref>.</char>
    </note>Wakutuuna o KAWASANA OPU aumbaaka balaana kaara to lipu incia sumai,</para>
  <para style="q2" vid="PSA 105:16">tee apahancuru bhari-bharia kinande modhaangiana iwe sumai,<verse eid="PSA 105:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 105:17"/>
    <note caller="-" style="x">
      <char style="xo" closed="false">105:17 </char>
      <char style="xt" closed="false">
        <ref loc="GEN 37:28">Bhaa. 37:28</ref>; <ref loc="GEN 45:5">45:5</ref>.</char>
    </note>KAWASANA OPU atumpumo samia moporikanaakana manga incia,</para>
  <para style="q2" vid="PSA 105:17">sarona mia incia sumai o Yusuf, mopadhana iaso amembali bhatua.<verse eid="PSA 105:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 105:18"/>
    <note caller="-" style="x">
      <char style="xo" closed="false">105:18-19 </char>
      <char style="xt" closed="false">
        <ref loc="GEN 41:13">Bhaa. 41:13</ref>. </char>
    </note>Aena apekambelaakea tee rante,</para>
  <para style="q2" vid="PSA 105:18">bhorokona atobhokeaka tee rante minaaka i ase;<verse eid="PSA 105:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 105:19"/>sabutuna opea ipekilalaakana Yusuf atopamondomo,</para>
  <para style="q2" vid="PSA 105:19">KAWASANA OPU afirimani ande o Yusuf abanara.<verse eid="PSA 105:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 105:20"/>
    <note caller="-" style="x">
      <char style="xo" closed="false">105:20 </char>
      <char style="xt" closed="false">
        <ref loc="GEN 41:14">Bhaa. 41:14</ref>.</char>
    </note>Rajana Mesir momaogena kuasana sumai,</para>
  <para style="q2" vid="PSA 105:20">atumpu mia to apabebasi Yusuf minaaka i katorongku.<verse eid="PSA 105:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 105:21"/>
    <note caller="-" style="x">
      <char style="xo" closed="false">105:21 </char>
      <char style="xt" closed="false">
        <ref loc="GEN 41:39-41">Bhaa. 41:39-41</ref>.</char>
    </note>Incia aangkea amembali samia momalangana pangkatina i nuncana maligena raja,</para>
  <para style="q2" vid="PSA 105:21">tee o raja adhawua kuasa to moʼurusuna bhari-bharia harataana,<verse eid="PSA 105:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 105:22"/>tee uka adhawua kuasa to aʼatoro manga pagawena raja peepeeluana incana,</para>
  <para style="q2" vid="PSA 105:22">tee aadhariaka hikimati to manga mancuana monaasehatina raja.<verse eid="PSA 105:22"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 105:23"/>
    <note caller="-" style="x">
      <char style="xo" closed="false">105:23 </char>
      <char style="xt" closed="false">
        <ref loc="GEN 46:6">Bhaa. 46:6</ref>; <ref loc="GEN 47:11">47:11</ref>.</char>
    </note>Kasiimpo Yakub aumba i Mesir,</para>
  <para style="q2" vid="PSA 105:23">Yakub amboore i Tana Ham<note caller="+" style="f"><char style="fr" closed="false">105:23 </char><char style="fq" closed="false">Tana Ham: </char><char style="ft" closed="false">Saro mosagaanana to Tana Mesir.</char></note> mboomo samia dhaga.<verse eid="PSA 105:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 105:24"/>
    <note caller="-" style="x">
      <char style="xo" closed="false">105:24 </char>
      <char style="xt" closed="false">
        <ref loc="EXO 1:7-14">Limb. 1:7-14</ref>.</char>
    </note>KAWASANA OPU, apamembalia o uumatina ajulu o kabharina,</para>
  <para style="q2" vid="PSA 105:24">tee apamembalia manga incia alabhi o kakaana minaaka i bhalina.<verse eid="PSA 105:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 105:25"/>Kasiimpo KAWASANA OPU abhalii incana manga miana Mesir to abanci uumatina,</para>
  <para style="q2" vid="PSA 105:25">tee atipu miana Israel.<verse eid="PSA 105:25"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 105:26"/>
    <note caller="-" style="x">
      <char style="xo" closed="false">105:26 </char>
      <char style="xt" closed="false">
        <ref loc="EXO 3:10">Limb. 3:10</ref>; <ref loc="EXO 4:14-15">4:14-15</ref>.</char>
    </note>Sumaimo Incia alamboko Musa,</para>
  <para style="q2" vid="PSA 105:26">tee Harun, bhatuana mopadhana ipilina.<verse eid="PSA 105:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 105:27"/>Rua-rua miaia apadhaangia manga giu inda momentela minaaka i Kawasana Opu i tanga-tangana manga miana Mesir sumai,</para>
  <para style="q2" vid="PSA 105:27">tee apewau manga muuzizati i Tana Ham.<verse eid="PSA 105:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 105:28"/>
    <note caller="-" style="x">
      <char style="xo" closed="false">105:28 </char>
      <char style="xt" closed="false">
        <ref loc="EXO 10:21-23">Limb. 10:21-23</ref>.</char>
    </note>Kawasana Opu aumbaaka kalalanda, sumaimo amalalandamo o lipu incia sumai</para>
  <para style="q2" vid="PSA 105:28">maka o miana Mesir inda aose firimanina.<verse eid="PSA 105:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="PSA 105:29"/>
    <note caller="-" style="x">
      <char style="xo" closed="false">105:29 </char>
      <char style="xt" closed="false">
        <ref loc="EXO 7:17-21">Limb. 7:17-21</ref>.</char>
    </note>Incia abhalii uwena miana Mesir amembali raa,</para>
  <para style="q2" vid="PSA 105:29">tee apekamate bhari-bharia ikanena manga incia.<verse eid="PSA 105:29"/></para>
  <para style="q1">
    <verse number="30" style="v" sid="PSA 105:30"/>
    <note caller="-" style="x">
      <char style="xo" closed="false">105:30-31 </char>
      <char style="xt" closed="false">
        <ref loc="EXO 8:1-24">Limb. 8:1-24</ref>.</char>
    </note>Manga barakaka abuke i lipuna manga incia</para>
  <para style="q2" vid="PSA 105:30">sampe apesua uka i nuncana kolemana raja.<verse eid="PSA 105:30"/></para>
  <para style="q1">
    <verse number="31" style="v" sid="PSA 105:31"/>Kawasana Opu afirimani, sabutuna aumbamo manga lale mosampa,</para>
  <para style="q2" vid="PSA 105:31">tee ngkonunu apabuke saangua lipu.<verse eid="PSA 105:31"/></para>
  <para style="q1">
    <verse number="32" style="v" sid="PSA 105:32"/>
    <note caller="-" style="x">
      <char style="xo" closed="false">105:32 </char>
      <char style="xt" closed="false">
        <ref loc="EXO 9:22-25">Limb. 9:22-25</ref>.</char>
    </note>Incia apasapo waona esi,</para>
  <para style="q2" vid="PSA 105:32">tee bhibhito mokakila-kila i saangua lipuna manga incia.<verse eid="PSA 105:32"/></para>
  <para style="q1">
    <verse number="33" style="v" sid="PSA 105:33"/>Incia apabinasa puuna angguru tee puuna ara,</para>
  <para style="q2" vid="PSA 105:33">tee apatobhata bhari-bharia manga puuna kau i lipuna manga incia.<verse eid="PSA 105:33"/></para>
  <para style="q1">
    <verse number="34" style="v" sid="PSA 105:34"/>
    <note caller="-" style="x">
      <char style="xo" closed="false">105:34 </char>
      <char style="xt" closed="false">
        <ref loc="EXO 10:12-15">Limb. 10:12-15</ref>.</char>
    </note>Kawasana Opu afirimani uka, kasiimpo aumbamo manga kabhoro,</para>
  <para style="q2" vid="PSA 105:34">tee o kabhoro mopolaka kabharina inda atogagari.<verse eid="PSA 105:34"/></para>
  <para style="q1">
    <verse number="35" style="v" sid="PSA 105:35"/>Kabhoro sumai akande bhari-bharia penembula i lipuna manga incia,</para>
  <para style="q2" vid="PSA 105:35">tee apepadhaia bhari-bharia hasilina inawuna manga incia.<verse eid="PSA 105:35"/></para>
  <para style="q1">
    <verse number="36" style="v" sid="PSA 105:36"/>
    <note caller="-" style="x">
      <char style="xo" closed="false">105:36 </char>
      <char style="xt" closed="false">
        <ref loc="EXO 12:29">Limb. 12:29</ref>.</char>
    </note>Kawasana Opu uka apekamate bhari-bharia ana tumpe umane modhaangiana i lipuna incia sumai</para>
  <para style="q2" vid="PSA 105:36">siitumo bhaa-bhaana o kakaana manga incia.<verse eid="PSA 105:36"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="37" style="v" sid="PSA 105:37"/>
    <note caller="-" style="x">
      <char style="xo" closed="false">105:37-38 </char>
      <char style="xt" closed="false">
        <ref loc="EXO 12:33-36">Limb. 12:33-36</ref>.</char>
    </note>Kasiimpo Aulataʼala apalimba miana Israel apoose abhawa pera tee bulawa,</para>
  <para style="q2" vid="PSA 105:37">bhari-bharia manga incia amalape o namisina tee amakaa o bukuna wakutuuna alimba minaaka i Mesir.<verse eid="PSA 105:37"/></para>
  <para style="q1">
    <verse number="38" style="v" sid="PSA 105:38"/>Miana Mesir akaunde-unde wakutuuna manga incia alingka abholi lipu sumai</para>
  <para style="q2" vid="PSA 105:38">roonamo miana Mesir amaeka mpuu tee miana Israel.<verse eid="PSA 105:38"/></para>
  <para style="q1">
    <verse number="39" style="v" sid="PSA 105:39"/>
    <note caller="-" style="x">
      <char style="xo" closed="false">105:39 </char>
      <char style="xt" closed="false">
        <ref loc="EXO 13:21-22">Limb. 13:21-22</ref>.</char>
    </note>Aulataʼala abhakesaka taʼina ngalu to apapeulu uumatina,</para>
  <para style="q2" vid="PSA 105:39">tee waa to kasuluwi i wakutuuna amalo.<verse eid="PSA 105:39"/></para>
  <para style="q1">
    <verse number="40" style="v" sid="PSA 105:40"/>
    <note caller="-" style="x">
      <char style="xo" closed="false">105:40 </char>
      <char style="xt" closed="false">
        <ref loc="EXO 16:2-15">Limb. 16:2-15</ref>.</char>
    </note>Manga incia aemani kinande i Aulataʼala, sabutuna o Aulataʼala alambokoakea manu-manu sonta,</para>
  <para style="q2" vid="PSA 105:40">tee manga incia apekambosuakea roti minaaka i laiana.<verse eid="PSA 105:40"/></para>
  <para style="q1">
    <verse number="41" style="v" sid="PSA 105:41"/>
    <note caller="-" style="x">
      <char style="xo" closed="false">105:41 </char>
      <char style="xt" closed="false">
        <ref loc="EXO 17:1-7">Limb. 17:1-7</ref>. </char>
    </note>Awetaia o bhatu maoge, kasiimpo apidhimo o uwe,</para>
  <para style="q2" vid="PSA 105:41">asiwulu mboomo umala i tana matuu,<verse eid="PSA 105:41"/></para>
  <para style="q1">
    <verse number="42" style="v" sid="PSA 105:42"/>roonamo Incia audhani firimanina momangkilo,</para>
  <para style="q2" vid="PSA 105:42">tee audhani Ibrahim o bhatuana sumai.<verse eid="PSA 105:42"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="43" style="v" sid="PSA 105:43"/>Jadi Incia abhawa uumatina alimba tee akaunde-unde,</para>
  <para style="q2" vid="PSA 105:43">tee manga mia ipilina alagu tee asambo-sambo.<verse eid="PSA 105:43"/></para>
  <para style="q1">
    <verse number="44" style="v" sid="PSA 105:44"/>Aulataʼala adhawuakea tanana manga lipu mosagaanana to manga incia,</para>
  <para style="q2" vid="PSA 105:44">sabutuna manga incia apotibhaaka harataana manga lipu incia sumai.<verse eid="PSA 105:44"/></para>
  <para style="q1">
    <verse number="45" style="v" sid="PSA 105:45"/>Tee mboo sumai, manga incia amembali akenia pekatangka manga katotapuna,</para>
  <para style="q2" vid="PSA 105:45">tee aose kaadharina.</para>
  <para style="q1" vid="PSA 105:45">Pujimea o KAWASANA OPU!<verse eid="PSA 105:45"/></para>
  <chapter eid="PSA 105"/>
  <chapter number="106" style="c" sid="PSA 106"/>
  <para style="s">Kaasina Molagina Kawasana Opu tee Kakaana Incana Miana Israel</para>
  <para style="sr">
    <ref loc="PSA 106:1-48">106:1-48</ref></para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 106:1"/>
    <note caller="-" style="x">
      <char style="xo" closed="false">106:1 </char>
      <char style="xt" closed="false">
        <ref loc="PSA 100:4-5">Zab. 100:4-5</ref>.</char>
    </note>Pujimea o KAWASANA OPU!</para>
  <para style="b" vid="PSA 106:1"/>
  <para style="q1" vid="PSA 106:1">Sukurumo i KAWASANA OPU, roonamo Incia amalape,</para>
  <para style="q2" vid="PSA 106:1">kaasina molagina abakaa saʼumurua.<verse eid="PSA 106:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 106:2"/>Incema momembalina mopetulatulaakana giu maoge mopadhana ipewauna KAWASANA OPU,</para>
  <para style="q2" vid="PSA 106:2">atawa apaperangoiakea sagala kapujia to Incia?<verse eid="PSA 106:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 106:3"/>Amasanaamo manga mia mopewauna kaʼadili,</para>
  <para style="q2" vid="PSA 106:3">tee modhadhina i nuncana kabanara.<verse eid="PSA 106:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 106:4"/>E KAWASANA OPU, udhaniaku wakutuuna upewau malape i uumatimu;</para>
  <para style="q2" vid="PSA 106:4">bholi umalinguakaaku wakutuuna upasalaamati manga incia.<verse eid="PSA 106:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 106:5"/>Mamudhaakana amembali kukamata kalapena dhadhina manga mia ipilimu,</para>
  <para style="q2" vid="PSA 106:5">mamudhaakana amembali kumasanaa i nuncana kaunde-undena manga miana lipumu,</para>
  <para style="q1" vid="PSA 106:5">tee mamudhaakana amembali kupujiko kupobhawa-bhawa tee uumati momembalina tinaurakamu.<verse eid="PSA 106:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 106:6"/>Ingkami padhamo tapewau dosa mboomo opu-opuamami;</para>
  <para style="q2" vid="PSA 106:6">ingkami padhamo tapewau kasalaha tee tadorohaka.<verse eid="PSA 106:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 106:7"/>
    <note caller="-" style="x">
      <char style="xo" closed="false">106:7 </char>
      <char style="xt" closed="false">
        <ref loc="EXO 14:10-12">Limb. 14:10-12</ref>.</char>
    </note>Wakutuuna i Mesir,</para>
  <para style="q2" vid="PSA 106:7">opu-opuamami inda amaʼanaia manga giu inda momentela ipewaumu;</para>
  <para style="q1" vid="PSA 106:7">manga incia inda audhania o kaasimu molagina motaralabhi-labhi sumai,</para>
  <para style="q2" vid="PSA 106:7">maka manga incia adorohaka i Aulataʼala Momalanga i bhiwina Tawo Towu Lambe.<verse eid="PSA 106:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 106:8"/>Maka o Kawasana Opu apasalaamati manga incia to ajagani sarona karona,</para>
  <para style="q2" vid="PSA 106:8">mamudhaakana amataua o kaogena kuasana.<verse eid="PSA 106:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 106:9"/>
    <note caller="-" style="x">
      <char style="xo" closed="false">106:9-12 </char>
      <char style="xt" closed="false">
        <ref loc="EXO 14:21-31">Limb. 14:21-31</ref>.</char>
    </note>Incia agorampangi Tawo Towu Lambe sabutuna amatuumo o tawo sumai,</para>
  <para style="q2" vid="PSA 106:9">kasiimpo abhawa manga incia apolimba i tawo mboomo adhala i tana matuu.<verse eid="PSA 106:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 106:10"/>Jadi o Kawasana Opu apasalaamati manga incia minaaka i kuasana manga mia mobancia,</para>
  <para style="q2" vid="PSA 106:10">tee arambasakea manga minaaka i limana musu.<verse eid="PSA 106:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 106:11"/>Uwena tawo apatondu bhalina manga incia;</para>
  <para style="q2" vid="PSA 106:11">inda samia uka mosalaamatina.<verse eid="PSA 106:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 106:12"/>I wakutuu incia sumai manga incia aparacaeamo tee opea ifirimaniakana,</para>
  <para style="q2" vid="PSA 106:12">tee alaguaka manga kapujia to Incia.<verse eid="PSA 106:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 106:13"/>Maka manga incia amasimba mpuu amalinguaka opea ipewauna Kawasana Opu,</para>
  <para style="q2" vid="PSA 106:13">tee inda aantagi to arango opea ihaejatiakana to manga incia.<verse eid="PSA 106:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 106:14"/>Manga incia akuasaia nawusuu to akande i tampa momalino,</para>
  <para style="q2" vid="PSA 106:14">tee auji Aulataʼala mamudhaakana abukutiiakea o kuasana i tana matuu.<verse eid="PSA 106:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 106:15"/>Kawasana Opu adhawuakea opea iemanina manga incia,</para>
  <para style="q2" vid="PSA 106:15">maka apoose alambokoakea tee panyaki imembaliakana manga incia amangkuru.<verse eid="PSA 106:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 106:16"/>Wakutuuna i pokemaa manga incia amapii incana tee Musa,</para>
  <para style="q2" vid="PSA 106:16">tee amapii incana uka tee Harun, mia momangkilo ipilina KAWASANA OPU.<verse eid="PSA 106:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 106:17"/>Alamu apoweta kasiimpo adhoku Datan,</para>
  <para style="q2" vid="PSA 106:17">tee o tana atutubhi manga moosena Abiram.<note caller="+" style="f"><char style="fr" closed="false">106:17 </char><char style="fq" closed="false">Datan...Abiram: </char><char style="ft" closed="false">Datan tee Abiram akapalai saangu rombongana miana Israel modorohakana i Harun tee Musa. Manga mia incia sumai akangkanaia hisabuna Kawasana Opu.</char></note><verse eid="PSA 106:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 106:18"/>Waa uka arore i tanga-tangana manga incia,</para>
  <para style="q2" vid="PSA 106:18">rorena waa apekangau manga mia madhaki.<verse eid="PSA 106:18"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 106:19"/>
    <note caller="-" style="x">
      <char style="xo" closed="false">106:19 </char>
      <char style="xt" closed="false">
        <ref loc="EXO 32:1-14">Limb. 32:1-14</ref>.</char>
    </note>Manga incia akarajaa patu anana sapi i Horeb,</para>
  <para style="q2" vid="PSA 106:19">kasiimpo asomba patu motorabu sumai.<verse eid="PSA 106:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 106:20"/>Tee mboo sumai, manga incia padhamo abholosi kamuliangina Aulataʼala</para>
  <para style="q2" vid="PSA 106:20">tee patuna sapi mokandena rumpu.<verse eid="PSA 106:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 106:21"/>Manga incia amalinguaka Aulataʼala mopasalaamatina manga incia,</para>
  <para style="q2" vid="PSA 106:21">mopadhana mopewauna manga giu momaoge i Mesir.<verse eid="PSA 106:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 106:22"/>Siitumo Incia apewau manga giu inda momentela i Tana Ham,</para>
  <para style="q2" vid="PSA 106:22">tee manga giu motomaeka i bhiwina Tawo Towu Lambe.<verse eid="PSA 106:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 106:23"/>Siitumo sababuna o Kawasana Opu afirimani ande bheapabinasa manga incia</para>
  <para style="q2" vid="PSA 106:23">maka ataangia Musa, mia ipilina.</para>
  <para style="q1" vid="PSA 106:23">Musa ataangi pamuruna Kawasana Opu to manga incia,</para>
  <para style="q2" vid="PSA 106:23">sabutuna amarana auntomo tee inda apabinasea.<verse eid="PSA 106:23"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 106:24"/>Kasiimpo manga incia amendeu apesua i lipu momangada sumai,</para>
  <para style="q2" vid="PSA 106:24">tee inda aparacaea firimanina.<verse eid="PSA 106:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 106:25"/>Manga incia akamburu-mburu i nuncana kemana,</para>
  <para style="q2" vid="PSA 106:25">tee inda aperangoi firimanina KAWASANA OPU.<verse eid="PSA 106:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 106:26"/>Siitumo sababuna Incia aposumpa</para>
  <para style="q2" vid="PSA 106:26">ande bheapekamate manga incia i tana matuu,<verse eid="PSA 106:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 106:27"/>tee o siwuluna manga incia bheapapogaa-gaaia i tanga-tangana manga lipu,</para>
  <para style="q2" vid="PSA 106:27">tee apasaraakaakea i lipu mosagaanana.<verse eid="PSA 106:27"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 106:28"/>Manga incia uka asomba dewa Baal i Gunu Peor,</para>
  <para style="q2" vid="PSA 106:28">tee akande manga kurubani isumbele to manga barahala inda modhadhi.<verse eid="PSA 106:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="PSA 106:29"/>Manga giu incia sumai amapiiakea incana KAWASANA OPU,</para>
  <para style="q2" vid="PSA 106:29">sabutuna aumbamo o panyaki imateaka i tanga-tangana manga incia.<verse eid="PSA 106:29"/></para>
  <para style="q1">
    <verse number="30" style="v" sid="PSA 106:30"/>Maka o Pinehas aumba ahukumu manga mia mosala,</para>
  <para style="q2" vid="PSA 106:30">sabutuna auntomo o panyaki imateaka sumai.<verse eid="PSA 106:30"/></para>
  <para style="q1">
    <verse number="31" style="v" sid="PSA 106:31"/>Pewauna Pinehas sumai amembali saangu jasa tee giu mobanara to incia</para>
  <para style="q2" vid="PSA 106:31">sakawana saʼumurua zamani.<verse eid="PSA 106:31"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="32" style="v" sid="PSA 106:32"/>Manga incia apekapii incana KAWASANA OPU i saripina matana uwe i Meriba</para>
  <para style="q2" vid="PSA 106:32">sabutuna o Musa anarakaa roonamo pewauna manga incia,<verse eid="PSA 106:32"/></para>
  <para style="q1">
    <verse number="33" style="v" sid="PSA 106:33"/>sababuna manga incia apekarewu incana Musa,</para>
  <para style="q2" vid="PSA 106:33">sabutuna incia abhoasaka manga pogau inda ifikirina porikana.<verse eid="PSA 106:33"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="34" style="v" sid="PSA 106:34"/>Manga incia uka inda apabinasa manga lipu i Kanaan,</para>
  <para style="q2" vid="PSA 106:34">mboomo iparintaakana KAWASANA OPU to manga incia,<verse eid="PSA 106:34"/></para>
  <para style="q1">
    <verse number="35" style="v" sid="PSA 106:35"/>maka manga incia aporomu tee manga miana lipu incia sumai,</para>
  <para style="q2" vid="PSA 106:35">tee asiringi pewauna manga incia.<verse eid="PSA 106:35"/></para>
  <para style="q1">
    <verse number="36" style="v" sid="PSA 106:36"/>Miana Israel asomba manga barahalana miana Kanaan,</para>
  <para style="q2" vid="PSA 106:36">sabutuna o giu incia sumai amembali katapu to manga incia.<verse eid="PSA 106:36"/></para>
  <para style="q1">
    <verse number="37" style="v" sid="PSA 106:37"/>Manga incia apasombaakea o anana, malape o ana umane atawa o ana bhawine</para>
  <para style="q2" vid="PSA 106:37">amembali kurubani to manga seetani.<verse eid="PSA 106:37"/></para>
  <para style="q1">
    <verse number="38" style="v" sid="PSA 106:38"/>Manga incia apekamate manga mia inda mosala,</para>
  <para style="q2" vid="PSA 106:38">siitumo o raana anana manga incia,</para>
  <para style="q2" vid="PSA 106:38">ipasombaakana amembali kurubani to manga barahala i Kanaan,</para>
  <para style="q2" vid="PSA 106:38">sabutuna o lipu sumai amarombuaka raa.<verse eid="PSA 106:38"/></para>
  <para style="q1">
    <verse number="39" style="v" sid="PSA 106:39"/>Sumaimo manga incia apekarombu karona tee opea ipewauna,</para>
  <para style="q2" vid="PSA 106:39">tee o feʼelina mboomo bhawinena dhala.<note caller="+" style="f"><char style="fr" closed="false">106:39 </char><char style="ft" closed="false">Pokaiana Kawasana Opu tee Israel agambaraakea mboomo ibaratina umane tee bhawinena. Wakutuuna Israel asomba barahala sumai agambaraakea tee ibaratina Israel azina tee bhawinena dhala. </char></note><verse eid="PSA 106:39"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="40" style="v" sid="PSA 106:40"/>Siitumo sababuna o pamuruna KAWASANA OPU akarore-rore to uumatina,</para>
  <para style="q2" vid="PSA 106:40">tee amarika akamata lipuna uumatina karona.<verse eid="PSA 106:40"/></para>
  <para style="q1">
    <verse number="41" style="v" sid="PSA 106:41"/>Sumaimo Kawasana Opu apasarakaaka manga incia i manga lipu mosagaanana,</para>
  <para style="q2" vid="PSA 106:41">sabutuna manga incia akuasaia musuna.<verse eid="PSA 106:41"/></para>
  <para style="q1">
    <verse number="42" style="v" sid="PSA 106:42"/>Manga incia apisakia musuna,</para>
  <para style="q2" vid="PSA 106:42">sabutuna o miana Israel atokuasai tee atotalo.<verse eid="PSA 106:42"/></para>
  <para style="q1">
    <verse number="43" style="v" sid="PSA 106:43"/>Amenturu o Kawasana Opu atulungia,</para>
  <para style="q2" vid="PSA 106:43">maka manga incia sadia adorohaka tee opea ihaejatiakana,</para>
  <para style="q2" vid="PSA 106:43">sabutuna manga incia atondu i nuncana dosa.<verse eid="PSA 106:43"/></para>
  <para style="q1">
    <verse number="44" style="v" sid="PSA 106:44"/>Maka o Kawasana Opu akamatea o kanarakaana manga incia</para>
  <para style="q2" vid="PSA 106:44">wakutuuna arangoa o gorana.<verse eid="PSA 106:44"/></para>
  <para style="q1">
    <verse number="45" style="v" sid="PSA 106:45"/>Rampaakanamo Incia afaduli tee manga incia, Kawasana Opu audhanimea o pojanjiana,</para>
  <para style="q2" vid="PSA 106:45">tee amaasi akamata manga incia apokana tee kaasina molagina motaralabhi-labhi.<verse eid="PSA 106:45"/></para>
  <para style="q1">
    <verse number="46" style="v" sid="PSA 106:46"/>Rampaakanamo Kawasana Opu, manga incia apotibhaaka rahumati</para>
  <para style="q2" vid="PSA 106:46">sabutuna manga musuna amaasiakea.<verse eid="PSA 106:46"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="47" style="v" sid="PSA 106:47"/>Manga pasalaamatimo, e KAWASANA OPU, e Aulataʼalamami!</para>
  <para style="q2" vid="PSA 106:47">Manga romusakamo tee manga pambulimo minaaka i lipuna mia,</para>
  <para style="q1" vid="PSA 106:47">mamudhaakana ingkami tamembali tasukuru i saromu momangkilo</para>
  <para style="q2" vid="PSA 106:47">tee takaunde-unde wakutuuna tapuji-pujiko.<verse eid="PSA 106:47"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="48" style="v" sid="PSA 106:48"/>Atopujimo o KAWASANA OPU, Aulataʼala isombana miana Israel,</para>
  <para style="q2" vid="PSA 106:48">sii-sii tee saʼumurua!</para>
  <para style="q1" vid="PSA 106:48">Taroakamo bhari-bharia mia apogau, "Aamin!"</para>
  <para style="q2" vid="PSA 106:48">Pujimea o KAWASANA OPU!<verse eid="PSA 106:48"/></para>
  <chapter eid="PSA 106"/>
  <chapter number="107" style="c" sid="PSA 107"/>
  <para style="ms">BOKU I LIMA ANGUNA:</para>
  <para style="s2">Zaburu 107--150</para>
  <para style="s1">Kasukuru Minaaka i Manga Mia Ipasalaamatina Kawasana Opu</para>
  <para style="sr">
    <ref loc="PSA 107:1-43">107:1-43</ref></para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 107:1"/>
    <note caller="-" style="x">
      <char style="xo" closed="false">107:1 </char>
      <char style="xt" closed="false">
        <ref loc="PSA 100:4-5">Zab. 100:4-5</ref>; <ref loc="PSA 106:1">106:1</ref>; <ref loc="PSA 118:1">118:1</ref>; <ref loc="PSA 136:1">136:1</ref>; <ref loc="JER 33:11">Yer. 33:11</ref>.</char>
    </note>Sukurumo i KAWASANA OPU roonamo Incia amalape,</para>
  <para style="q2" vid="PSA 107:1">tee kaasina abakaa saʼumurua.<verse eid="PSA 107:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 107:2"/>Taroakamo o giu incia sumai abhoasakea manga mia mopadhana itolosina KAWASANA OPU,</para>
  <para style="q2" vid="PSA 107:2">siitumo manga incia mopadhana itolosina minaaka i kanarakaa,<verse eid="PSA 107:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 107:3"/>tee mopadhana iromusakana minaaka i manga lipu mosagaanana,</para>
  <para style="q2" vid="PSA 107:3">minaaka i timbu tee minaaka i bhara,</para>
  <para style="q2" vid="PSA 107:3">minaaka i napa tee minaaka i salata.<verse eid="PSA 107:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 107:4"/>Dhaangia uka manga mia mopekalingka-lingkana i tana matuu,</para>
  <para style="q2" vid="PSA 107:4">tee inda amatau dhala moporopena i kampo imbooresina mia.<verse eid="PSA 107:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 107:5"/>Manga incia amaara tee amatuu bhorokona,</para>
  <para style="q2" vid="PSA 107:5">tee ailamo bhari-bharia iharapuna.<verse eid="PSA 107:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 107:6"/>Manga incia agora tee aemani tulungi i KAWASANA OPU i wakutuuna kaseke,</para>
  <para style="q2" vid="PSA 107:6">kasiimpo Incia arambasakea manga minaaka i kanarakaana,<verse eid="PSA 107:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 107:7"/>tee atondaia alaloi dhala momakate,</para>
  <para style="q2" vid="PSA 107:7">sabutuna manga incia akawa i kampo imbooresina mia.<verse eid="PSA 107:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 107:8"/>Taroakamo manga incia asukuru i KAWASANA OPU roonamo kaasina molagina,</para>
  <para style="q2" vid="PSA 107:8">tee roonamo manga giu inda momentela ipewauna to maanusia,<verse eid="PSA 107:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 107:9"/>sababuna Incia apatumpu incana mia momatuuna bhorokona,</para>
  <para style="q2" vid="PSA 107:9">tee apekambosu mia momaara tee giu momalape.<verse eid="PSA 107:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 107:10"/>Sagaa minaaka i manga incia auncura i nuncana kalalanda tee kagalapu,</para>
  <para style="q2" vid="PSA 107:10">manga mia itaangi i katorongku amaporo incana tee atobhoke tee rante ase,<verse eid="PSA 107:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 107:11"/>roonamo manga incia adorohaka tee firimanina Aulataʼala,</para>
  <para style="q2" vid="PSA 107:11">tee amendeu atarima kaadharina Kawasana Opu Momalanga.<verse eid="PSA 107:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 107:12"/>Siitumo sababuna Incia apisaki ngangarandana manga incia tee karajaa matamo,</para>
  <para style="q2" vid="PSA 107:12">manga incia amandawu tee inda dhaangia motulungia.<verse eid="PSA 107:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 107:13"/>Kasiimpo manga incia agora i KAWASANA OPU i wakutuuna kaseke,</para>
  <para style="q2" vid="PSA 107:13">tee Incia apasalaamatia manga minaaka i kanarakaana;<verse eid="PSA 107:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 107:14"/>Manga incia apalimbaia minaaka i kalalanda tee kagalapu,</para>
  <para style="q2" vid="PSA 107:14">tee abhotukimea o kabhokena rantena manga incia.<verse eid="PSA 107:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 107:15"/>Taroakamo manga incia asukuru i KAWASANA OPU to kaasina molagina,</para>
  <para style="q2" vid="PSA 107:15">tee manga giu inda momentela ipewauna to maanusia,<verse eid="PSA 107:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 107:16"/>roonamo Incia apasaki manga bhamba tambaga,</para>
  <para style="q2" vid="PSA 107:16">tee atumpo manga kapasona bhamba motokarajaana minaaka i ase.<verse eid="PSA 107:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 107:17"/>Dhaangia uka momembalina mokabhongo-bhongo roonamo feʼelina manga incia modorohaka,</para>
  <para style="q2" vid="PSA 107:17">tee roonamo kasalahana karona, manga incia atosikisaa.<verse eid="PSA 107:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 107:18"/>Manga incia amendeu akande opea uka,</para>
  <para style="q2" vid="PSA 107:18">tee o ajalana manga incia amakasumo.<verse eid="PSA 107:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 107:19"/>Kasiimpo, manga incia agora aemani tulungi i KAWASANA OPU i wakutuuna kaseke,</para>
  <para style="q2" vid="PSA 107:19">tee Incia apasalaamatia manga minaaka i kanarakaa.<verse eid="PSA 107:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 107:20"/>KAWASANA OPU afirimani, tee o firimanina sumai amembali apaunto kapiina manga incia,</para>
  <para style="q2" vid="PSA 107:20">tee apasalaamatia manga minaaka i bhalona koburu.<verse eid="PSA 107:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 107:21"/>Taroakamo manga incia asukuru i KAWASANA OPU roonamo kaasina molagina,</para>
  <para style="q2" vid="PSA 107:21">tee roonamo manga giu inda momentela ipewauna to maanusia.<verse eid="PSA 107:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 107:22"/>Taroakamo manga incia abhawa pasombaa kasukuru,</para>
  <para style="q2" vid="PSA 107:22">tee apokoleleakea bhari-bharia ipewauna apoose asambo-sambo!<verse eid="PSA 107:22"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 107:23"/>Dhaangia uka mosapona mokarajaana i kapala i tawo,</para>
  <para style="q2" vid="PSA 107:23">siitumo manga mia mopodhagana i andalaoge.<verse eid="PSA 107:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 107:24"/>Manga incia akamatea bhari-bharia ipewauna KAWASANA OPU,</para>
  <para style="q2" vid="PSA 107:24">tee manga giu inda momentela ipewauna i andalaoge.<verse eid="PSA 107:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 107:25"/>Incia afirimani, sabutuna akawamo ngalu tee garura</para>
  <para style="q2" vid="PSA 107:25">moangkana manga ewona tawo pekalanga-langa.<verse eid="PSA 107:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 107:26"/>Manga incia atoangka sakawana i antara, kasiimpo atotudhaaka i andalaoge.</para>
  <para style="q2" vid="PSA 107:26">Manga incia akailanga kabaranina roonamo apoaro tee balaa.<verse eid="PSA 107:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 107:27"/>Manga incia alingka kabhele-bhele tee adida mboomo mia malango,</para>
  <para style="q2" vid="PSA 107:27">tee ailamo o akalana.<verse eid="PSA 107:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 107:28"/>Kasiimpo manga incia agora aemani tulungi i KAWASANA OPU i wakutuuna kaseke,</para>
  <para style="q2" vid="PSA 107:28">tee manga incia arambasakea minaaka i kanarakaa,<verse eid="PSA 107:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="PSA 107:29"/>tee apaunto garura,</para>
  <para style="q2" vid="PSA 107:29">sabutuna manga ewo i tawo amembali amalino.<verse eid="PSA 107:29"/></para>
  <para style="q1">
    <verse number="30" style="v" sid="PSA 107:30"/>Kasiimpo manga incia akaunde-unde roonamo amalinomo,</para>
  <para style="q2" vid="PSA 107:30">tee Incia abhawea manga i labusa iporopeana.<verse eid="PSA 107:30"/></para>
  <para style="q1">
    <verse number="31" style="v" sid="PSA 107:31"/>Taroakamo manga incia asukuru i KAWASANA OPU roonamo kaasina molagina,</para>
  <para style="q2" vid="PSA 107:31">tee roonamo manga giu inda momentela ipewauna to maanusia!<verse eid="PSA 107:31"/></para>
  <para style="q1">
    <verse number="32" style="v" sid="PSA 107:32"/>Taroakamo manga incia amuliangia i tanga-tangana poromusakaana uumatina,</para>
  <para style="q2" vid="PSA 107:32">tee apujia i nuncana majilisina manga mancuanana lipu.<verse eid="PSA 107:32"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="33" style="v" sid="PSA 107:33"/>Incia abhalii manga umala amembali tana matuu,</para>
  <para style="q2" vid="PSA 107:33">tee manga matana uwe amembali tana inda mokouwe.<verse eid="PSA 107:33"/></para>
  <para style="q1">
    <verse number="34" style="v" sid="PSA 107:34"/>Tana mosuburu apamembalia tana mokogara inda momembalina ipombulaaka penembula</para>
  <para style="q2" vid="PSA 107:34">roonamo kadhakina manga mia mombooresia.<verse eid="PSA 107:34"/></para>
  <para style="q1">
    <verse number="35" style="v" sid="PSA 107:35"/>Incia uka abhalii tana matuu amembali kolam,</para>
  <para style="q2" vid="PSA 107:35">tee o tana inda mokouwe apamembalia manga matana uwe.<verse eid="PSA 107:35"/></para>
  <para style="q1">
    <verse number="36" style="v" sid="PSA 107:36"/>KAWASANA OPU ataroaka manga mia momaara amboore iwe sumai,</para>
  <para style="q2" vid="PSA 107:36">kasiimpo manga incia abhangu kota to tampana mbooresana.<verse eid="PSA 107:36"/></para>
  <para style="q1">
    <verse number="37" style="v" sid="PSA 107:37"/>Manga incia ahewi manga inawu tee apombulaakea puuna angguru,</para>
  <para style="q2" vid="PSA 107:37">tee apotibhaaka timpua mobhari.<verse eid="PSA 107:37"/></para>
  <para style="q1">
    <verse number="38" style="v" sid="PSA 107:38"/>Minaaka i kabarakatina Kawasana Opu, manga incia ajulu o kabharina,</para>
  <para style="q2" vid="PSA 107:38">tee Incia inda ataroaka binata kadhambaakana akura o kabharina.<verse eid="PSA 107:38"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="39" style="v" sid="PSA 107:39"/>Maka sapadhana sumai, manga incia atalomea musuna, sabutuna o kabharina akuramo tee atungku i aroana bhalina,</para>
  <para style="q2" vid="PSA 107:39">roonamo o musu apisaki tee apacilaka manga incia tee apekaporoa incana.<verse eid="PSA 107:39"/></para>
  <para style="q1">
    <verse number="40" style="v" sid="PSA 107:40"/>KAWASANA OPU apasapoakea kahina to manga kaogesana lipuna,</para>
  <para style="q2" vid="PSA 107:40">manga incia apewaua apekalingka-lingka i tana matuu tee inda apotibhaaka dhala.<verse eid="PSA 107:40"/></para>
  <para style="q1">
    <verse number="41" style="v" sid="PSA 107:41"/>Maka o mia misikini aangkea minaaka i kanarakaana,</para>
  <para style="q2" vid="PSA 107:41">tee manga incia apamembalia ajulu o kabharina mboomo gulumana dumba.<verse eid="PSA 107:41"/></para>
  <para style="q1">
    <verse number="42" style="v" sid="PSA 107:42"/>Manga mia mobanara akamatea o giu incia sumai tee akaunde-unde,</para>
  <para style="q2" vid="PSA 107:42">maka o ngangana mia madhaki atosoncongi.<verse eid="PSA 107:42"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="43" style="v" sid="PSA 107:43"/>Taroakamo manga mia moʼaarifu akamata bhari-bharia o giu incia sii,</para>
  <para style="q2" vid="PSA 107:43">tee afahamua o kaasina KAWASANA OPU molagina.<verse eid="PSA 107:43"/></para>
  <chapter eid="PSA 107"/>
  <chapter number="108" style="c" sid="PSA 108"/>
  <para style="s">Sukuru tee Doʼa</para>
  <para style="r">(<ref loc="PSA 57:8-12">57:8-12</ref>; <ref loc="PSA 60:7-14">60:7-14</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 108:1"/>Lagu. Zaburuna Daud.<verse eid="PSA 108:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 108:2"/>
    <note caller="-" style="x">
      <char style="xo" closed="false">108:2-6 </char>
      <char style="xt" closed="false">
        <ref loc="PSA 57:8-12">Zab. 57:8-12</ref>.</char>
    </note>Ngangarandaku amatangka, e Aulataʼala!</para>
  <para style="q2" vid="PSA 108:2">Gauku bhekulaguaka lagu kapujia to Ingkoo.</para>
  <para style="q2" vid="PSA 108:2">Bhangumo, e inyawaku!<verse eid="PSA 108:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 108:3"/>Iaku bhekubhangu tee kumagasiaaka gambusu tee kecapi!</para>
  <para style="q2" vid="PSA 108:3">Iaku bhekubhangu raneeooge!<verse eid="PSA 108:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 108:4"/>Iaku bhekusukuru i Ingkoo i tanga-tangana manga lipu, e KAWASANA OPU,</para>
  <para style="q2" vid="PSA 108:4">tee kulaguaka manga lagu kapujia i manga lipu mosagaanana.<verse eid="PSA 108:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 108:5"/>Sababuna o kaasimu molagina amaoge akawa i laiana,</para>
  <para style="q2" vid="PSA 108:5">tee kabanaramu akawa i taʼina ngalu.<verse eid="PSA 108:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 108:6"/>E Aulataʼala, susuakea kaogesamu i laiana,</para>
  <para style="q2" vid="PSA 108:6">tee kamuliangimu i saangua alamu.<verse eid="PSA 108:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 108:7"/>
    <note caller="-" style="x">
      <char style="xo" closed="false">108:7-14 </char>
      <char style="xt" closed="false">
        <ref loc="PSA 60:7-14">Zab. 60:7-14</ref>.</char>
    </note>Mangapakana tee kuasamu tee uperangoimea o doʼaku,</para>
  <para style="q2" vid="PSA 108:7">mamudhaakana manga mia imaasiakamu atopasalaamati.<verse eid="PSA 108:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 108:8"/>Aulataʼala padhamo afirimani i tampana momangkilo,</para>
  <para style="q2" vid="PSA 108:8">"Iaku gauku kukaunde-unde, tee kupodhawu-dhawuaka Tana Sikhem,</para>
  <para style="q2" vid="PSA 108:8">tee kuʼukuru Mbolongana Sukot."<verse eid="PSA 108:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 108:9"/>Gilead tee Manasye o pewauaku,</para>
  <para style="q2" vid="PSA 108:9">Efraim mboomo helem minaaka i ase mojaganina bhaaku,</para>
  <para style="q2" vid="PSA 108:9">tee Yuda katukona pamarintaku.<verse eid="PSA 108:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 108:10"/>Maka o Tana Moab amembali palangga tampana bhanuiana aeku,</para>
  <para style="q2" vid="PSA 108:10">tee i bhawona Tana Edom kutudhaaka sandaliku.</para>
  <para style="q2" vid="PSA 108:10">E Tana Filistin, Iaku kusambo-sambomo roonamo padhamo kutaloko!"<verse eid="PSA 108:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 108:11"/>Incema bhemobhawaaku i kota mokobentena makaa sumai?</para>
  <para style="q2" vid="PSA 108:11">Incema momembalina moʼantaraaku sakawana i Edom?<verse eid="PSA 108:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 108:12"/>E Aulataʼala, buaka mencuana Ingkoo mangabhanakana?</para>
  <para style="q2" vid="PSA 108:12">E Aulataʼala, Ingkoo inda umaju upobhawa tee tantaramami to taewangi musu.<verse eid="PSA 108:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 108:13"/>Manga tulungi minaaka i musu,</para>
  <para style="q2" vid="PSA 108:13">roonamo o katulungina maanusia inda akoguna.<verse eid="PSA 108:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 108:14"/>Tapobhawa tee Aulataʼala ingkita tamembali tatalo musuta,</para>
  <para style="q2" vid="PSA 108:14">sababuna Incia bhemopahancuruna musuta.<verse eid="PSA 108:14"/></para>
  <chapter eid="PSA 108"/>
  <chapter number="109" style="c" sid="PSA 109"/>
  <para style="s">Doʼana Mia Motofitanaa</para>
  <para style="sr">
    <ref loc="PSA 109:1-31">109:1-31</ref></para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 109:1"/>To kapalana molaguna. Zaburuna Daud.</para>
  <para style="b" vid="PSA 109:1"/>
  <para style="q1" vid="PSA 109:1">Bholi inda tee uuʼuumu,</para>
  <para style="q2" vid="PSA 109:1">e Aulataʼala ipuji-pujiku.<verse eid="PSA 109:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 109:2"/>Roonamo ngangana manga mia madhaki tee pande gau-gau padha apogauakaaku madhaki;</para>
  <para style="q2" vid="PSA 109:2">manga incia afitanaaku tee dhela mogau-gau.<verse eid="PSA 109:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 109:3"/>Pogau ibhoasakana manga incia abukeaka kabancia,</para>
  <para style="q2" vid="PSA 109:3">tee aewangiaku inda akoʼalasa.<verse eid="PSA 109:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 109:4"/>Manga incia araeakaaku kupewau kadhaki to abalasi kaasiku,</para>
  <para style="q2" vid="PSA 109:4">moomini i tangasaana kudoʼaakea.<verse eid="PSA 109:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 109:5"/>Jadi manga incia abalasi kalapeku tee kadhaki,</para>
  <para style="q2" vid="PSA 109:5">tee abalasi kaasiku tee kabancia.<verse eid="PSA 109:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 109:6"/>Angkamo o mia madhaki to alawani musuku,</para>
  <para style="q2" vid="PSA 109:6">taroakamo o mia i weta kaanana to araeakea.<verse eid="PSA 109:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 109:7"/>Ande atoʼadili, taraoakamo incia atobhotukiaka amembali mia mosala,</para>
  <para style="q2" vid="PSA 109:7">tee doʼana atoabhi dosa.<verse eid="PSA 109:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 109:8"/>
    <note caller="-" style="x">
      <char style="xo" closed="false">109:8 </char>
      <char style="xt" closed="false">
        <ref loc="ACT 1:20">Tul. 1:20</ref>. </char>
    </note>Maasangia o umuruna amampodho,</para>
  <para style="q2" vid="PSA 109:8">tee taroakamo kauncuramakana aalea mia mosagaanana.<verse eid="PSA 109:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 109:9"/>Taroakamo manga anana amembali amaelu,</para>
  <para style="q2" vid="PSA 109:9">tee o bhawinena amembali iaiaro.<verse eid="PSA 109:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 109:10"/>Taroakamo manga anana apekalingka-lingka tee apengkaemani,</para>
  <para style="q2" vid="PSA 109:10">maasangia manga incia atopadhencu minaaka i karunggana bhanuana.<verse eid="PSA 109:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 109:11"/>Maasangia o mia pande giwuna dhosa aalea bhari-bharia pewauana modhaangiana i karona,</para>
  <para style="q2" vid="PSA 109:11">tee maasangia mia mosagaanana arampasia hasilina usahana.<verse eid="PSA 109:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 109:12"/>Bholi dhaangia samia uka momalapena incana tee incia,</para>
  <para style="q2" vid="PSA 109:12">atawa momaasiakana manga ana-anana momaeluna sumai.<verse eid="PSA 109:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 109:13"/>Taroakamo bhari-bharia siwuluna atopabinasa,</para>
  <para style="q2" vid="PSA 109:13">tee o sarona atomalinguaka i siwulu muri-murina.<verse eid="PSA 109:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 109:14"/>Taroakamo kasalahana opu-opuana sadhaadhaa audhania KAWASANA OPU,</para>
  <para style="q2" vid="PSA 109:14">tee inda ahapusu dosana inana.<verse eid="PSA 109:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 109:15"/>Taroakamo kasalahana sadhaadhaa i aroana KAWASANA OPU,</para>
  <para style="q2" vid="PSA 109:15">tee inda dhaangia uka moudhanina mia incia sumai i alamu,<verse eid="PSA 109:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 109:16"/>roonamo incia inda dhaangia audhani kalape,</para>
  <para style="q2" vid="PSA 109:16">tangkanamo apadhende mia monarakaa tee mia motopisaki,</para>
  <para style="q2" vid="PSA 109:16">tee mia momaporona incana sakawana amate.<verse eid="PSA 109:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 109:17"/>Incia sadia apekatunda, jadi taroakamo o katundana akangkanai karona!</para>
  <para style="q2" vid="PSA 109:17">Incia amendeu adoʼaaka tee abarakati mia mosagaanana, jadi taroakamo o barakati amaridho minaaka i karona!<verse eid="PSA 109:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 109:18"/>Incia apake katunda mboomo bajuna,</para>
  <para style="q2" vid="PSA 109:18">maasangia katunda sumai apesua i nuncana badana mboomo uwe,</para>
  <para style="q2" vid="PSA 109:18">tee apesua i nuncana buku-bukuna mboomo mina.<verse eid="PSA 109:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 109:19"/>Taroakamo o katunda sumai amembali mboomo juba ipakena to mosalibumbungiakana karona,</para>
  <para style="q2" vid="PSA 109:19">tee mboomo kabhokena tanga mosadiana abhokeaka tangana.<verse eid="PSA 109:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 109:20"/>Taroakamo o giu incia sii amembali kabalasina KAWASANA OPU to manga mia moraeakaaku,</para>
  <para style="q2" vid="PSA 109:20">tee manga mia mopogauakaaku madhaki.<verse eid="PSA 109:20"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 109:21"/>Maka Ingkoo, e KAWASANA OPU, e Aulataʼalaku, tulungiakumo roonamo saromu,</para>
  <para style="q2" vid="PSA 109:21">tee upasalaamatiaku roonamo kalapemu tee kaasimu molagina.<verse eid="PSA 109:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 109:22"/>Roonamo iaku sii kunarakaa tee kumisikini,</para>
  <para style="q2" vid="PSA 109:22">tee i nuncana karoku amambela o ngangarandaku.<verse eid="PSA 109:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 109:23"/>Iaku kuila mboomo ngkamia-mia i wakutuuna konowia;</para>
  <para style="q2" vid="PSA 109:23">inyawaku mboomo kabhoro itantamaka.<verse eid="PSA 109:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 109:24"/>Toputuku arengku roonamo kupoasa,</para>
  <para style="q2" vid="PSA 109:24">tee o badaku amangkurumo.<verse eid="PSA 109:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 109:25"/>
    <note caller="-" style="x">
      <char style="xo" closed="false">109:25 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 27:39">Mat. 27:39</ref>; <ref loc="MRK 15:29">Mrk. 15:29</ref>.</char>
    </note>Mia moraeakaaku ahinaaku;</para>
  <para style="q2" vid="PSA 109:25">wakutuuna akamataaku, manga incia alengko-lengko bhaana.<verse eid="PSA 109:25"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 109:26"/>E KAWASANA OPU, e Aulataʼalaku, tulungiaku.</para>
  <para style="q2" vid="PSA 109:26">Pasalaamatiaku apokana tee kaasimu molagina.<verse eid="PSA 109:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 109:27"/>Taroakamo o musuku amataua ande bhari-bharia sumai ipewauna limamu,</para>
  <para style="q2" vid="PSA 109:27">tee amataua ande Ingkoo mopewaua e KAWASANA OPU.<verse eid="PSA 109:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 109:28"/>Taroakamo manga incia apekatunda, maka Ingkoo ubarakatiaku.</para>
  <para style="q2" vid="PSA 109:28">Taroakamo manga incia apotibhaaka kaea, maka o bhatuamu sii bheakaunde-unde.<verse eid="PSA 109:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="PSA 109:29"/>Taroakamo manga mia moraeakaaku apake kaʼaebu to bajuna,</para>
  <para style="q2" vid="PSA 109:29">tee taroakamo manga incia aposalibumbuaka kaeana mboomo juba motutubhina karona.<verse eid="PSA 109:29"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="30" style="v" sid="PSA 109:30"/>Iaku sadia bhekusukuru i KAWASANA OPU tee ngangaku,</para>
  <para style="q2" vid="PSA 109:30">tee bhekupujia i tanga-tangana mia bhari<verse eid="PSA 109:30"/></para>
  <para style="q1">
    <verse number="31" style="v" sid="PSA 109:31"/>roonamo Incia aewaaka mia misikini</para>
  <para style="q2" vid="PSA 109:31">to apasalaamatia minaaka i manga mia mohukumua.<verse eid="PSA 109:31"/></para>
  <chapter eid="PSA 109"/>
  <chapter number="110" style="c" sid="PSA 110"/>
  <para style="s">Al Masi sumai Momembalina Raja tee Imamu</para>
  <para style="sr">
    <ref loc="PSA 110:1-7">110:1-7</ref></para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 110:1"/>
    <note caller="-" style="x">
      <char style="xo" closed="false">110:1 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 22:44">Mat. 22:44</ref>; <ref loc="MRK 12:36">Mrk. 12:36</ref>; <ref loc="LUK 20:42-43">Luk. 20:42-43</ref>; <ref loc="ACT 2:34-35">Tul. 2:34-35</ref>; <ref loc="1CO 15:25">1Kor. 15:25</ref>; <ref loc="COL 3:1">Kol. 3:1</ref>.</char>
    </note>Zaburuna Daud.</para>
  <para style="b" vid="PSA 110:1"/>
  <para style="q1" vid="PSA 110:1">Mboo siimo o firimanina KAWASANA OPU to Opuku,<note caller="+" style="f"><char style="fr" closed="false">110:1 </char><char style="fq" closed="false">Opuku: </char><char style="ft" closed="false">Iwe sii o Kawasana Opu afirimani i Opuna Nabii Daud. Mboomo motoburina i nuncana Kitabi Lele Malape, Opu sumai atosarongiaka Isa Al Masi (kamata </char><char style="xt"><ref loc="MAT 22:44">Mat. 22:44</ref></char>).</note></para>
  <para style="q2" vid="PSA 110:1">"Uncuramo i weta kaanaku,</para>
  <para style="q2" vid="PSA 110:1">sakawana kupewau manga musumu amembali polandakana aemu."<verse eid="PSA 110:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 110:2"/>KAWASANA OPU bheapekaewa pamarintamu minaaka i Kota Sion.</para>
  <para style="q2" vid="PSA 110:2">Kokuasamo i tanga-tangana manga musumu!<verse eid="PSA 110:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 110:3"/>Raʼeatimu arela bheamaju tee totona incana,</para>
  <para style="q2" vid="PSA 110:3">i eona ukapalai manga pasukamu</para>
  <para style="q2" vid="PSA 110:3">i bhawona manga gunu momangkilo.</para>
  <para style="q1" vid="PSA 110:3">Manga ana manguramu bheaumba i aroamu,</para>
  <para style="q2" vid="PSA 110:3">mboomo alo mosapona i wakutuuna raneeo.<verse eid="PSA 110:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 110:4"/>KAWASANA OPU padhamo apotunda</para>
  <para style="q2" vid="PSA 110:4">tee Incia inda bheahelaia pendua o kambotuna,</para>
  <para style="q1" vid="PSA 110:4">"Ingkoo satotuuna o imamu to saʼumurua</para>
  <para style="q2" vid="PSA 110:4">mboomo tuturana Malkisedik."<note caller="+" style="f"><char style="fr" closed="false">110:4 </char><char style="fq" closed="false">Malkisedik: </char><char style="ft" closed="false">Imamu tee rajana Salem moumbana i Abram sapadhana incia atalo Raja Kedorlaomer tee manga raja mopobhawana tee incia. Siitumo incia momembalina polanciringa mopokanana tee Al Masi bhemoumbana tee bhemotoangkana to amembali raja tee imamu. Kamata </char><char style="xt"><ref loc="GEN 14:17-24">Bhaa. 14:17-24</ref></char> tee <char style="xt"><ref loc="HEB 7:1-28">Ibr. 7:1-28</ref>.</char></note><verse eid="PSA 110:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 110:5"/>Kawasana Opu dhaangia i weta kaanamu;</para>
  <para style="q2" vid="PSA 110:5">Incia bheapahancuru manga raja i eona pamuruna.<note caller="+" style="f"><char style="fr" closed="false">110:5 </char><char style="fq" closed="false">Incia bheapahancuru manga raja i eona pamuruna: </char><char style="ft" closed="false">I wakutuuna aahirina zamani, Opu sumai bheapekatalo bhari-bharia pamarinta inda moʼadili (kamata </char><char style="xt"><ref loc="PSA 110:1">Zab. 110:1</ref>; <ref loc="PSA 2:6-9">2:6-9</ref></char>).</note><verse eid="PSA 110:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 110:6"/>Incia bheahukumu manga lipu,</para>
  <para style="q2" vid="PSA 110:6">sabutuna o lipu sumai abukeaka tee manga maeati.</para>
  <para style="q2" vid="PSA 110:6">Incia bheapasaki bhaana manga musuna i saangua alamu.<verse eid="PSA 110:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 110:7"/>Incia bheasumpu minaaka i saangu umala modhaangiana i bhiwina dhala,</para>
  <para style="q2" vid="PSA 110:7">siitumo incia bheaangka bhaana roonamo padhamo atalo manga musuna.<verse eid="PSA 110:7"/></para>
  <chapter eid="PSA 110"/>
  <chapter number="111" style="c" sid="PSA 111"/>
  <para style="s">Kalapena Kawasana Opu</para>
  <para style="sr">
    <ref loc="PSA 111:1-10">111:1-10</ref></para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 111:1"/>Pujimea o KAWASANA OPU!</para>
  <para style="b" vid="PSA 111:1"/>
  <para style="q1" vid="PSA 111:1">Iaku bhekusukuru i KAWASANA OPU tee mpuu-mpuuna incaku</para>
  <para style="q2" vid="PSA 111:1">i tampa poromusakaana mia momakatena incana</para>
  <para style="q2" vid="PSA 111:1">tee i tampana poromusakaana uumati.<verse eid="PSA 111:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 111:2"/>Tapanamo inda amentela ipewauna KAWASANA OPU,</para>
  <para style="q2" vid="PSA 111:2">alaenga mpuu afikiria bhari-bharia mia mopeelua,<verse eid="PSA 111:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 111:3"/>pewauna amulia tee atopuji,</para>
  <para style="q2" vid="PSA 111:3">kabanarana sadhaadhaa to saʼumurua.<verse eid="PSA 111:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 111:4"/>Incia apatokamata manga pewauna inda momentelana</para>
  <para style="q2" vid="PSA 111:4">mamudhaakana sadhaadhaa taudhania;</para>
  <para style="q2" vid="PSA 111:4">KAWASANA OPU sumai amalape incana tee amaasiaka uumatina.<verse eid="PSA 111:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 111:5"/>KAWASANA OPU adhawu razakii i mia momaekaia,</para>
  <para style="q2" vid="PSA 111:5">Incia sadhaadhaa audhani janjina.<verse eid="PSA 111:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 111:6"/>KAWASANA OPU padhamo asusuaka kuasana i uumatina,</para>
  <para style="q2" vid="PSA 111:6">tee manga incia adhawuakea tana tinaurakana manga lipu.<verse eid="PSA 111:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 111:7"/>KAWASANA OPU apewau adili tee amembali atoparacaea i nuncana bhari-bharia ipewauna,</para>
  <para style="q2" vid="PSA 111:7">tee bhari-bharia parintana atoparacaea.<verse eid="PSA 111:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 111:8"/>Bhari-bharia sadhaadhaa amatangka to saʼumurua,</para>
  <para style="q2" vid="PSA 111:8">tee apewaua i nuncana kaʼadili tee kabanara.<verse eid="PSA 111:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 111:9"/>KAWASANA OPU padhamo apabebasi uumatina,</para>
  <para style="q2" vid="PSA 111:9">tee apatotapuaka pojanjiana to saʼumurua.</para>
  <para style="q2" vid="PSA 111:9">Sarona amangkilo tee amaoge!<verse eid="PSA 111:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 111:10"/>Mia momaekana i KAWASANA OPU satotuuna o auwalina mia amembali aʼaarifu;</para>
  <para style="q2" vid="PSA 111:10">bhari-bharia mia mopewaua apotibhaaka fahamu momalape.</para>
  <para style="q1" vid="PSA 111:10">Kapujia to KAWASANA OPU asadhaadhaa saʼumurua!<verse eid="PSA 111:10"/></para>
  <chapter eid="PSA 111"/>
  <chapter number="112" style="c" sid="PSA 112"/>
  <para style="s">Kasanaana Mia Malape</para>
  <para style="sr">
    <ref loc="PSA 112:1-10">112:1-10</ref></para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 112:1"/>Pujimea o KAWASANA OPU!</para>
  <para style="b" vid="PSA 112:1"/>
  <para style="q1" vid="PSA 112:1">Amasanaamo mia momaekana i KAWASANA OPU,</para>
  <para style="q2" vid="PSA 112:1">mopeeluna mpuu manga parintana.<verse eid="PSA 112:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 112:2"/>Manga opu-opuana bheakokuasa i alamu,</para>
  <para style="q2" vid="PSA 112:2">tee siwulu momakatena incana bheatobarakati.<verse eid="PSA 112:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 112:3"/>Harataa tee karangkaea dhaangia i nuncana bhanuana,</para>
  <para style="q2" vid="PSA 112:3">tee kabanarana manga incia sadhaadhaa to saʼumurua.<verse eid="PSA 112:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 112:4"/>Moomini i nuncana kalalanda, dhaangia tee kainawa to mia mosaalihi;</para>
  <para style="q2" vid="PSA 112:4">siitumo to mia momalape, momaasi, tee mobanara.<verse eid="PSA 112:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 112:5"/>Akodhawuamo o mia mobukeakana kaasi tee momenturuna mopekapadhaakana doina,</para>
  <para style="q2" vid="PSA 112:5">tee aʼadili i nuncana bhari-bharia karajaana.<verse eid="PSA 112:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 112:6"/>Roonamo iimanina mia mobanara inda bheakohudha saʼumurua,</para>
  <para style="q2" vid="PSA 112:6">tee bheatoudhani saʼumurua.<verse eid="PSA 112:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 112:7"/>Manga incia inda amaeka tee lele madhaki;</para>
  <para style="q2" vid="PSA 112:7">incana amatangka roonamo aparacaea i KAWASANA OPU.<verse eid="PSA 112:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 112:8"/>Incana amatangka tee manga incia inda amaeka;</para>
  <para style="q2" vid="PSA 112:8">sabutuna manga incia bheakamata manga musuna amatalo.<verse eid="PSA 112:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 112:9"/>
    <note caller="-" style="x">
      <char style="xo" closed="false">112:9 </char>
      <char style="xt" closed="false">
        <ref loc="2CO 9:9">2Kor. 9:9</ref>.</char>
    </note>Tee relana totona incana, manga incia sadia asadakaa i mia misikini.</para>
  <para style="q2" vid="PSA 112:9">Kabanarana sadhaadhaa to saʼumurua;</para>
  <para style="q2" vid="PSA 112:9">manga incia akokuasa tee atohoromati.<verse eid="PSA 112:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 112:10"/>Manga mia madhaki akamata giu incia sumai asabhaakea randana;</para>
  <para style="q2" vid="PSA 112:10">manga incia uka apakiri-kiri ngincina, kasiimpo amofu.</para>
  <para style="q2" vid="PSA 112:10">Opea ihaejatiakana mia madhaki inda bheamembali.<verse eid="PSA 112:10"/></para>
  <chapter eid="PSA 112"/>
  <chapter number="113" style="c" sid="PSA 113"/>
  <para style="s">Kawasana Opu Apekalanga Mia Momaidhiidhi</para>
  <para style="sr">
    <ref loc="PSA 113:1-9">113:1-9</ref></para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 113:1"/>Pujimea o KAWASANA OPU!</para>
  <para style="q1" vid="PSA 113:1">Pujimea, e manga bhatuana KAWASANA OPU,</para>
  <para style="q2" vid="PSA 113:1">pujimea o sarona KAWASANA OPU!<verse eid="PSA 113:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 113:2"/>Bhari-bharia kapujia to sarona KAWASANA OPU,</para>
  <para style="q2" vid="PSA 113:2">sii-sii sampe saʼumurua!<verse eid="PSA 113:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 113:3"/>Pepuu minaaka i abhete matanaeo sakawana asoo matanaeo,</para>
  <para style="q2" vid="PSA 113:3">sarona KAWASANA OPU alaenga atopuji.<verse eid="PSA 113:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 113:4"/>KAWASANA OPU amalanga tee akokuasa i bhawona bhari-bharia lipu,</para>
  <para style="q2" vid="PSA 113:4">tee kamuliangina alabhi amalanga minaaka i laiana.<verse eid="PSA 113:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 113:5"/>Incema buaka mboomo KAWASANA OPU, Aulataʼalata,</para>
  <para style="q2" vid="PSA 113:5">mokokauncuramakana i tampa momalanga,<verse eid="PSA 113:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 113:6"/>tee mopaʼungkona karona to apotonto</para>
  <para style="q2" vid="PSA 113:6">i laiana tee i alamu?<verse eid="PSA 113:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 113:7"/>Incia aangka mia misikini minaaka i ngawu,</para>
  <para style="q2" vid="PSA 113:7">tee apalimba mia monarakaa minaaka i kabumbuna ngawu<verse eid="PSA 113:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 113:8"/>to apauncura manga incia aposaangu tee manga kaogesa</para>
  <para style="q2" vid="PSA 113:8">minaaka i uumatina.<verse eid="PSA 113:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 113:9"/>Incia arahumatiakea anaana i manga bhawine mokomba,<note caller="+" style="f"><char style="fr" closed="false">113:9 </char><char style="fq" closed="false">bhawine mokomba: </char><char style="ft" closed="false">Bhawine inda momembalina mokoana.</char></note></para>
  <para style="q2" vid="PSA 113:9">sabutuna o bhawine sumai akaunde-unde i nuncana bhanuana.</para>
  <para style="b" vid="PSA 113:9"/>
  <para style="q2" vid="PSA 113:9">Pujimea o KAWASANA OPU!<verse eid="PSA 113:9"/></para>
  <chapter eid="PSA 113"/>
  <chapter number="114" style="c" sid="PSA 114"/>
  <para style="s">Wakutuuna Miana Israel Alimba minaaka i Mesir</para>
  <para style="sr">
    <ref loc="PSA 114:1-8">114:1-8</ref></para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 114:1"/>
    <note caller="-" style="x">
      <char style="xo" closed="false">114:1 </char>
      <char style="xt" closed="false">
        <ref loc="EXO 12:51">Limb. 12:51</ref>.</char>
    </note>Wakutuuna miana Israel alimba minaaka i Mesir,</para>
  <para style="q2" vid="PSA 114:1">siitumo wakutuuna siwuluna Yakub abholi lipu moposalana pogauna sumai,<verse eid="PSA 114:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 114:2"/>Kawasana Opu apamembali Yuda tampana momangkilo,</para>
  <para style="q2" vid="PSA 114:2">tee Israel amembali tampana pamarintana.<verse eid="PSA 114:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 114:3"/>
    <note caller="-" style="x">
      <char style="xo" closed="false">114:3 </char>
      <char style="xt" closed="false">
        <ref loc="EXO 14:21">Limb. 14:21</ref>.</char>
    </note>Tawo Towu Lambe akamata KAWASANA OPU sabutuna apalai tee amembali amatuu,</para>
  <para style="q2" vid="PSA 114:3">Umala Yordan ambuli i talikuna.<note caller="+" style="f"><char style="fr" closed="false">114:3 </char><char style="ft" closed="false">Aeati 3 tee 5 apogauaka rua mpearo Aulataʼala abungkale dhala i tampa mokouwe to miana Israel wakutuuna manga incia abholi Mesir tee apesua i Tana Kanaan. </char></note><verse eid="PSA 114:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 114:4"/>Manga gunu apekalumpa-lumpa mboomo dumba umane,</para>
  <para style="q2" vid="PSA 114:4">tee manga kabumbu apekatiba-tiba mboomo anana dumba.<verse eid="PSA 114:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 114:5"/>E Tawo Towu Lambe, apokia upalai?</para>
  <para style="q2" vid="PSA 114:5">E Umala Yordan, apokia umbuli i talikumu?<verse eid="PSA 114:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 114:6"/>E manga gunu, apokia upekalumpa-lumpa mboomo dumba umane,</para>
  <para style="q2" vid="PSA 114:6">tee manga kabumbu, apokia upekatiba-tiba mboomo anana dumba?<verse eid="PSA 114:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 114:7"/>E alamu, torendemo i aroana Kawasana Opu,</para>
  <para style="q2" vid="PSA 114:7">i aroana Aulataʼala isombana Yakub,<verse eid="PSA 114:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 114:8"/>
    <note caller="-" style="x">
      <char style="xo" closed="false">114:8 </char>
      <char style="xt" closed="false">
        <ref loc="EXO 17:1-7">Limb. 17:1-7</ref>.</char>
    </note>mopamembalina uwe alimba minaaka i nuncana bhatu sakawana amembali tampana lembokana uwe to asumpuaka miana Yahudi,</para>
  <para style="q2" vid="PSA 114:8">tee o bhatu dhempa amembali matana uwe.<verse eid="PSA 114:8"/></para>
  <chapter eid="PSA 114"/>
  <chapter number="115" style="c" sid="PSA 115"/>
  <para style="s1">Kamuliangi Tangkanamo to Kawasana Opu</para>
  <para style="sr">
    <ref loc="PSA 115:1-18">115:1-18</ref></para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 115:1"/>Mencuana ingkami, e KAWASANA OPU, mencuana ingkami,</para>
  <para style="q2" vid="PSA 115:1">maka soomo saromu molaengana imuliangi,</para>
  <para style="q2" vid="PSA 115:1">roonamo kaasimu molagina tee umembali utoparacaea.<verse eid="PSA 115:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 115:2"/>Pokia manga lipu mosagaanana bheapogau,</para>
  <para style="q2" vid="PSA 115:2">"I iapai o Aulataʼalana manga incia?"<verse eid="PSA 115:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 115:3"/>Aulataʼalamami dhaangia i sorogaa,</para>
  <para style="q2" vid="PSA 115:3">Incia bheapewau opeapo uka ipeeluna.<verse eid="PSA 115:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 115:4"/>
    <note caller="-" style="x">
      <char style="xo" closed="false">115:4-8 </char>
      <char style="xt" closed="false">
        <ref loc="PSA 135:15-18">Zab. 135:15-18</ref>; <ref loc="REV 9:20">Wah. 9:20</ref>.</char>
    </note>Barahalana manga lipu sumai minaaka i bulawa tee pera,</para>
  <para style="q2" vid="PSA 115:4">ikarajaana limana maanusia.<verse eid="PSA 115:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 115:5"/>Manga barahala sumai akomuncu, maka inda amembali apogau,</para>
  <para style="q2" vid="PSA 115:5">akomata, maka inda amembali apokamata,<verse eid="PSA 115:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 115:6"/>akotalinga, maka inda amembali aporango,</para>
  <para style="q2" vid="PSA 115:6">akoango, maka inda amembali apebhou,<verse eid="PSA 115:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 115:7"/>akolima, maka inda dhaangia momembalina ipererena,</para>
  <para style="q2" vid="PSA 115:7">akoae, maka inda amembali alingka,</para>
  <para style="q2" vid="PSA 115:7">tee inda amembali uka apalimba suara minaaka i goncona.<verse eid="PSA 115:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 115:8"/>Manga mia mokarajaaia amembali apokana tee barahala sumai,</para>
  <para style="q2" vid="PSA 115:8">tee bhari-bharia mia moparacaeana i barahala sumai.<verse eid="PSA 115:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 115:9"/>E Israel, paracaeamo i KAWASANA OPU!</para>
  <para style="q2" vid="PSA 115:9">Incia motulungikomiu tee amembali katangkesi mojaganikomiu.<verse eid="PSA 115:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 115:10"/>E manga imamu mominaakana i siwuluna Harun, paracaeamo i KAWASANA OPU.</para>
  <para style="q2" vid="PSA 115:10">Incia motulungikomiu tee amembali katangkesi mojaganikomiu.<verse eid="PSA 115:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 115:11"/>E manga mia momaekana tee KAWASANA OPU, paracaeamo i KAWASANA OPU!</para>
  <para style="q2" vid="PSA 115:11">Incia motulungikomiu tee amembali katangkesi mojaganikomiu.<verse eid="PSA 115:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 115:12"/>KAWASANA OPU manga udhani tee bheamangabarakati,</para>
  <para style="q2" vid="PSA 115:12">Incia bheabarakati miana Israel,</para>
  <para style="q2" vid="PSA 115:12">tee bhari-bharia imamu mominaakana i siwuluna Harun,<verse eid="PSA 115:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 115:13"/>
    <note caller="-" style="x">
      <char style="xo" closed="false">115:13 </char>
      <char style="xt" closed="false">
        <ref loc="REV 11:18">Wah. 11:18</ref>.</char>
    </note>tee Incia bheabarakati manga mia momaekana tee KAWASANA OPU,</para>
  <para style="q2" vid="PSA 115:13">malape o kaogesa atawa o mia momaidhiidhi.<verse eid="PSA 115:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 115:14"/>Maasangia KAWASANA OPU apekabharia o siwulumu,</para>
  <para style="q2" vid="PSA 115:14">malape to ingkoo atawa to manga anamu.<verse eid="PSA 115:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 115:15"/>Maasangia ingkoo abarakatiko KAWASANA OPU,</para>
  <para style="q2" vid="PSA 115:15">mopadhaangiana laiana tee alamu!<verse eid="PSA 115:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 115:16"/>Laiana momalanga sumai o pewauana KAWASANA OPU,</para>
  <para style="q2" vid="PSA 115:16">maka o alamu sii padhamo adhawuakea to anana maanusia.<verse eid="PSA 115:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 115:17"/>Manga mia momate inda bheapuji-puji KAWASANA OPU,</para>
  <para style="q2" vid="PSA 115:17">mboo sumai uka manga mia mosapona i duniana mia mate momalino,<verse eid="PSA 115:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 115:18"/>maka ingkita dhaangiapo modhadhina sii bhemopujina KAWASANA OPU</para>
  <para style="q2" vid="PSA 115:18">pepuu sii-sii sakawana saʼumurua.</para>
  <para style="b" vid="PSA 115:18"/>
  <para style="q2" vid="PSA 115:18">Pujimea o KAWASANA OPU!<verse eid="PSA 115:18"/></para>
  <chapter eid="PSA 115"/>
  <chapter number="116" style="c" sid="PSA 116"/>
  <para style="s">Alapa minaaka i Katapu Imateaka</para>
  <para style="sr">
    <ref loc="PSA 116:1-19">116:1-19</ref></para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 116:1"/>Iaku kumaasiaka KAWASANA OPU, sababuna Incia arango</para>
  <para style="q2" vid="PSA 116:1">goraku tee bhari-bharia iemaniku.<verse eid="PSA 116:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 116:2"/>Roonamo Incia aperangoiaku,</para>
  <para style="q2" vid="PSA 116:2">sumaimo bhekugora i Incia saʼumurua dhadiku.<verse eid="PSA 116:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 116:3"/>Manga katapu imateaka abulilingiaku,</para>
  <para style="q2" vid="PSA 116:3">kanarakaa i nuncana koburu angkakanaiku,</para>
  <para style="q2" vid="PSA 116:3">iaku kunamisi kaseke tee kaporo.<verse eid="PSA 116:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 116:4"/>Kasiimpo kugoraaka sarona KAWASANA OPU,</para>
  <para style="q2" vid="PSA 116:4">"E KAWASANA OPU, pasalaamatia o inyawaku!"<verse eid="PSA 116:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 116:5"/>KAWASANA OPU satotuuna amalape tee abanara;</para>
  <para style="q2" vid="PSA 116:5">Aulataʼalata satotuuna amaasiaka uumatina.<verse eid="PSA 116:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 116:6"/>KAWASANA OPU ajagani manga mia inda momembalina motulungina karona.</para>
  <para style="q2" vid="PSA 116:6">Wakutuuna inda tee kakaaku, Incia mopasalaamatiaku.<verse eid="PSA 116:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 116:7"/>E ngangarandaku, tanangimo pendua</para>
  <para style="q2" vid="PSA 116:7">roonamo KAWASANA OPU padhamo apewau malape tee ingkoo.<verse eid="PSA 116:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 116:8"/>E KAWASANA OPU, Ingkoo padhamo upasalaamati inyawaku minaaka i mate,</para>
  <para style="q2" vid="PSA 116:8">ujagani mataku mamudhaakana inda kutangi,</para>
  <para style="q2" vid="PSA 116:8">tee upekatangka aeku mamudhaakana inda atosunu.<verse eid="PSA 116:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 116:9"/>Iaku bhekudhala i aroana KAWASANA OPU,</para>
  <para style="q2" vid="PSA 116:9">i lipuna manga mia modhadhi.<verse eid="PSA 116:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 116:10"/>
    <note caller="-" style="x">
      <char style="xo" closed="false">116:10 </char>
      <char style="xt" closed="false">
        <ref loc="2CO 4:13">2Kor. 4:13</ref>.</char>
    </note>Iaku sadhaadhaa kuparacaea, moomini wakutuuna kupogau,</para>
  <para style="q2" vid="PSA 116:10">"Iaku kunarakaa mpuu."<verse eid="PSA 116:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 116:11"/>I wakutuuna kubingu kupogau,</para>
  <para style="q2" vid="PSA 116:11">"Bhari-bharia mia inda amembali atoparacaea."<verse eid="PSA 116:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 116:12"/>Opea buaka momembalina ipasombaakaku i KAWASANA OPU to kubalasiaka</para>
  <para style="q2" vid="PSA 116:12">bhari-bharia kalapena incana to karoku?<verse eid="PSA 116:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 116:13"/>Iaku bhekuangka tondena kasalaamati<note caller="+" style="f"><char style="fr" closed="false">116:13 </char><char style="fq" closed="false">tondena kasalaamati: </char><char style="ft" closed="false">Miana Israel kananeana apasombaaka angguru i nuncana tonde to tandana asukuru roonamo padhamo apasalaamatia Kawasana Opu.</char></note></para>
  <para style="q2" vid="PSA 116:13">tee kugoraaka sarona KAWASANA OPU.<verse eid="PSA 116:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 116:14"/>Iaku bhekutolosi tolauna oniku i KAWASANA OPU</para>
  <para style="q2" vid="PSA 116:14">i aroana bhari-bharia uumatina.<verse eid="PSA 116:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 116:15"/>Akoharagaa i matana KAWASANA OPU</para>
  <para style="q2" vid="PSA 116:15">matena manga mia mosaalihi.<verse eid="PSA 116:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 116:16"/>E KAWASANA OPU, satotuuna iaku sii o bhatuamu.</para>
  <para style="q2" vid="PSA 116:16">Iakumo bhatuamu, o anana minaaka i bhatuamu bhawine.</para>
  <para style="q2" vid="PSA 116:16">Ingkoo padhamo urambasakaaku minaaka i kabhokeku.<verse eid="PSA 116:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 116:17"/>Iaku bhekupasombaaka kurubani sukuru to Ingkoo<note caller="+" style="f"><char style="fr" closed="false">116:17 </char><char style="fq" closed="false">pasombaaka kurubani sukuru to Ingkoo: </char><char style="ft" closed="false">Kawasana Opu inda afaraluu opeopea to atopasombaaka i Incia (kamata </char><char style="xt"><ref loc="PSA 50:9-13">Zab. 50:9-13</ref></char>). Bhari-bharia ipasombaaka satotuuna to amuliangi Incia, asukuru i Incia, tee mamudhaakana audhania Aulataʼala.</note></para>
  <para style="q2" vid="PSA 116:17">tee kugoraaka sarona KAWASANA OPU.<verse eid="PSA 116:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 116:18"/>Iaku bhekutolosi tolauna oniku i KAWASANA OPU</para>
  <para style="q2" vid="PSA 116:18">i aroana bhari-bharia uumatina,<verse eid="PSA 116:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 116:19"/>i tanalapana Baitullana KAWASANA OPU,</para>
  <para style="q2" vid="PSA 116:19">i tanga-tangamu, e Yerusalem!</para>
  <para style="b" vid="PSA 116:19"/>
  <para style="q2" vid="PSA 116:19">Pujimea o KAWASANA OPU!<verse eid="PSA 116:19"/></para>
  <chapter eid="PSA 116"/>
  <chapter number="117" style="c" sid="PSA 117"/>
  <para style="s1">Pujimo KAWASANA OPU, E Bhari-bharia Lipu</para>
  <para style="sr">
    <ref loc="PSA 117:1-2">117:1-2</ref></para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 117:1"/>
    <note caller="-" style="x">
      <char style="xo" closed="false">117:1 </char>
      <char style="xt" closed="false">
        <ref loc="ROM 15:11">Rom. 15:11</ref>. </char>
    </note>Pujimo KAWASANA OPU, e bhari-bharia lipu!</para>
  <para style="q2" vid="PSA 117:1">Muliangimea Incia, e bhari-bharia lipu!<verse eid="PSA 117:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 117:2"/>Roonamo amaoge o kaasina molagina to ingkita</para>
  <para style="q2" vid="PSA 117:2">tee KAWASANA OPU amembali atoparacaea saʼumurua.</para>
  <para style="b" vid="PSA 117:2"/>
  <para style="q2" vid="PSA 117:2">Pujimo KAWASANA OPU!<verse eid="PSA 117:2"/></para>
  <chapter eid="PSA 117"/>
  <chapter number="118" style="c" sid="PSA 118"/>
  <para style="s">Laguna Kasukuru Roonamo Takana</para>
  <para style="sr">
    <ref loc="PSA 118:1-29">118:1-29</ref></para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 118:1"/>
    <note caller="-" style="x">
      <char style="xo" closed="false">118:1 </char>
      <char style="xt" closed="false">
        <ref loc="PSA 100:4-5">Zab. 100:4-5</ref>.</char>
    </note>Sukurumo i KAWASANA OPU roonamo Incia amalape,</para>
  <para style="q2" vid="PSA 118:1">kaasina molagina abakaa saʼumurua.<verse eid="PSA 118:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 118:2"/>Taroakamo miana Israel apogau,</para>
  <para style="q2" vid="PSA 118:2">"Kaasina molagina abakaa saʼumurua."<verse eid="PSA 118:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 118:3"/>Taroakamo siwuluna Harun apogau,</para>
  <para style="q2" vid="PSA 118:3">"Kaasina molagina abakaa saʼumurua."<verse eid="PSA 118:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 118:4"/>Taroakamo bhari-bharia mia momaekana i KAWASANA OPU apogau,</para>
  <para style="q2" vid="PSA 118:4">"Kaasina molagina abakaa saʼumurua."<verse eid="PSA 118:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 118:5"/>I nuncana kaseke iaku kugora i KAWASANA OPU,</para>
  <para style="q2" vid="PSA 118:5">KAWASANA OPU alawaniaku tee apekalalesaia o ngangarandaku.<verse eid="PSA 118:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 118:6"/>Iaku inda bhekumaeka roonamo KAWASANA OPU apoose tee iaku;</para>
  <para style="q2" vid="PSA 118:6">maanusia inda amembali apewau opeopea tee iaku.<verse eid="PSA 118:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 118:7"/>KAWASANA OPU apoose tee iaku to atulungiaku,</para>
  <para style="q2" vid="PSA 118:7">iaku bhekukamata manga mia mobanciaku atotalo.<verse eid="PSA 118:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 118:8"/>Salabhina kupeulu i KAWASANA OPU,</para>
  <para style="q2" vid="PSA 118:8">tee kuparacaea i maanusia.<verse eid="PSA 118:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 118:9"/>Salabhina kupeulu i KAWASANA OPU,</para>
  <para style="q2" vid="PSA 118:9">tee kuparacaea i manga kaogesa.<verse eid="PSA 118:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 118:10"/>Bhari-bharia lipu alibuaku,</para>
  <para style="q2" vid="PSA 118:10">maka tee kuasana KAWASANA OPU, manga incia kutaloa!<verse eid="PSA 118:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 118:11"/>Manga incia alibuaku; umbe, manga incia alibuaku minaaka i bhari-bharia rope,</para>
  <para style="q2" vid="PSA 118:11">maka tee kuasana KAWASANA OPU, manga incia kutaloa!<verse eid="PSA 118:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 118:12"/>Manga incia alibuaku mboomo uwani,</para>
  <para style="q2" vid="PSA 118:12">maka manga incia atopekatalo i nuncana sakija mata mboomo waa motununa rumpu mokorui-rui.</para>
  <para style="q2" vid="PSA 118:12">Tee kuasana KAWASANA OPU, manga incia kutaloa!<verse eid="PSA 118:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 118:13"/>Iaku amakaa kutojumpuraka sabutuna saidhepo kumandawu,</para>
  <para style="q2" vid="PSA 118:13">maka o Kawasana Opu atulungiaku.<verse eid="PSA 118:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 118:14"/>
    <note caller="-" style="x">
      <char style="xo" closed="false">118:14 </char>
      <char style="xt" closed="false">
        <ref loc="EXO 15:2">Limb. 15:2</ref>; <ref loc="ISA 12:2">Yes. 12:2</ref>. </char>
    </note>KAWASANA OPU o kakaaku tee kapujiaku.</para>
  <para style="q2" vid="PSA 118:14">Incia amembalimo kasalaamatiku.<verse eid="PSA 118:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 118:15"/>Dhaangia o suarana sambo-sambo tee kamangantalo</para>
  <para style="q2" vid="PSA 118:15">i nuncana kemana manga mia mobanara,</para>
  <para style="q2" vid="PSA 118:15">"Lima kaanana KAWASANA OPU apewau manga giu momaoge!<verse eid="PSA 118:15"/></para>
  <para style="q2">
    <verse number="16" style="v" sid="PSA 118:16"/>Lima kaanana KAWASANA OPU atopekalanga!</para>
  <para style="q2" vid="PSA 118:16">Lima kaanana KAWASANA OPU apewau manga giu momaoge!"<verse eid="PSA 118:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 118:17"/>Iaku inda bhekumate, maka kudhadhi</para>
  <para style="q2" vid="PSA 118:17">tee kupakoleleaka manga pewauna KAWASANA OPU.<verse eid="PSA 118:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 118:18"/>KAWASANA OPU padhamo ahukumuaku pekakaa,</para>
  <para style="q2" vid="PSA 118:18">maka Incia inda apasaraakaaku i mate.<verse eid="PSA 118:18"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 118:19"/>Bungkaleakaaku manga bhambana lawana kabanara,</para>
  <para style="q2" vid="PSA 118:19">mamudhaakana iaku bhekupesua tee kusukuru i KAWASANA OPU.<verse eid="PSA 118:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 118:20"/>Siimo bhambana lawana KAWASANA OPU,</para>
  <para style="q2" vid="PSA 118:20">manga mia mobanara bheapesuaikia alaloia.<verse eid="PSA 118:20"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 118:21"/>Iaku bhekusukuru tee Ingkoo, roonamo Ingkoo padhamo ulawani doʼaku,</para>
  <para style="q2" vid="PSA 118:21">tee umembalimo mopasalaamatiaku.<verse eid="PSA 118:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 118:22"/>
    <note caller="-" style="x">
      <char style="xo" closed="false">118:22-23 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 21:42">Mat. 21:42</ref>; <ref loc="MRK 12:10-11">Mrk. 12:10-11</ref>; <ref loc="LUK 20:17">Luk. 20:17</ref>; <ref loc="ACT 4:11">Tul. 4:11</ref>; <ref loc="1PE 2:7">1Ptr. 2:7</ref>.</char>
    </note>Bhatu ibhanakana manga pandena bhanua</para>
  <para style="q2" vid="PSA 118:22">amembalimo bhatu parapuu mobhaa-bhaana.<verse eid="PSA 118:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 118:23"/>Siimo pewauna KAWASANA OPU,</para>
  <para style="q2" vid="PSA 118:23">inda amentela i matata.<verse eid="PSA 118:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 118:24"/>Siimo o eo ipadhaangiana KAWASANA OPU,</para>
  <para style="q2" vid="PSA 118:24">maimo tasambo-sambo tee takaunde-unde rampaakanamo Incia.<verse eid="PSA 118:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 118:25"/>E KAWASANA OPU, manga pasalaamatimo!</para>
  <para style="q2" vid="PSA 118:25">E KAWASANA OPU, manga dhawumo kamangantalo!<verse eid="PSA 118:25"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 118:26"/>
    <note caller="-" style="x">
      <char style="xo" closed="false">118:26 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 21:9">Mat. 21:9</ref>; <ref loc="MAT 23:39">23:39</ref>; <ref loc="MRK 11:9">Mrk. 11:9</ref>; <ref loc="LUK 13:35">Luk. 13:35</ref>; <ref loc="LUK 19:38">19:38</ref>; <ref loc="JHN 12:13">Yah. 12:13</ref>.</char>
    </note>Atobarakatimo incia moumbana i nuncana sarona KAWASANA OPU!</para>
  <para style="q2" vid="PSA 118:26">Ingkami taemaniakako barakati minaaka i nuncana Baitullana KAWASANA OPU.<verse eid="PSA 118:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 118:27"/>KAWASANA OPU o Aulataʼala,</para>
  <para style="q2" vid="PSA 118:27">tee Incia manga suluwina.</para>
  <para style="q1" vid="PSA 118:27">
    <note caller="-" style="x">
      <char style="xo" closed="false">118:27 </char>
      <char style="xt" closed="false">
        <ref loc="EXO 27:1-2">Limb. 27:1-2</ref>.</char>
    </note>Bhokemea o kurubanina raraea sumai tee rabuta</para>
  <para style="q2" vid="PSA 118:27">i manga tanduna singkuna tampana tunuana kurubanina KAWASANA OPU.<verse eid="PSA 118:27"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 118:28"/>Ingkoomo o Aulataʼalaku, iaku bhekusukuru tee Ingkoo;</para>
  <para style="q2" vid="PSA 118:28">Ingkoomo o Aulataʼalaku, iaku bhekumuliangiko!<verse eid="PSA 118:28"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="29" style="v" sid="PSA 118:29"/>Sukurumo i KAWASANA OPU roonamo Incia amalape</para>
  <para style="q2" vid="PSA 118:29">tee kaasina molagina abakaa saʼumurua.<verse eid="PSA 118:29"/></para>
  <chapter eid="PSA 118"/>
  <chapter number="119" style="c" sid="PSA 119"/>
  <para style="s1">Amasanaamo Mia Moosena Hukumuna KAWASANA OPU<note caller="+" style="f"><char style="fr" closed="false">119:0 </char><char style="ft" closed="false">Zaburu 119 akoantoaka manga kapujia to Hukumuna Aulataʼala idhawuakana to miana Israel alaloi Nabii Musa. Zaburu 119 apake modele akrostik (apokana tee Zaburu 9-10, 25, 34, 37, 111, 112). Polanciringana pogau akrostik asusuaka modelena kabhanti mopakena horofu Ibrani atosau-sau malape i auwalina saasaangu aeati. Jadi, walu aeati i nuncana weta bhaa-bhaana i nuncana Zaburu 119 apepuungia tee horofu Ibrani, </char><char style="it">alef</char>; walu aeati i nuncana weta iruaanguna apepuungia tee horofu iruaanguna oni Ibrani, <char style="it">bet</char>; walu aeati i nuncana weta italuanguna apepuungia tee horofu italuanguna oni Ibrani, <char style="it">gimel</char>; tee mosagaanana uka.</note> <note caller="+" style="f"><char style="fr" closed="false">119:0 </char><char style="ft" closed="false">Zaburu 119 apogauakea ande manga hukumu ipakawaakana i Musa, siitumo o Taurati, giu incia sumai aminaaka i Aulataʼala, mencuana minaaka i maanusia. Kawasana Opu mokarajaaia tee mopatotapua.</char></note></para>
  <para style="sr">
    <ref loc="PSA 119:1-176">119:1-176</ref></para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 119:1"/>Amasanaamo mia modhadhina inda tee kasalahana,</para>
  <para style="q2" vid="PSA 119:1">tee adhadhi aose hukumuna KAWASANA OPU.<verse eid="PSA 119:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 119:2"/>Amasanaamo mia moosena manga tuturana,</para>
  <para style="q2" vid="PSA 119:2">mopeeloa tee mpuu-mpuuna incana,<verse eid="PSA 119:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 119:3"/>tee inda apewau kadhaki,</para>
  <para style="q2" vid="PSA 119:3">maka adhadhi aose manga dhalana.<verse eid="PSA 119:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 119:4"/>Manga kasameamu padhamo upatotapuakea,</para>
  <para style="q2" vid="PSA 119:4">mamudhaakana atokeniaka mpuu-mpuu.<verse eid="PSA 119:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 119:5"/>Maasangia o bhengkalaku amatangka</para>
  <para style="q2" vid="PSA 119:5">mamudhaakana kuosea mpuu-mpuu manga katotapumu!<verse eid="PSA 119:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 119:6"/>Sumaimo, iaku inda bhekupotibhaaka kaea</para>
  <para style="q2" vid="PSA 119:6">ande iaku kuperangoi bhari-bharia parintamu.<verse eid="PSA 119:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 119:7"/>Iaku bhekusukuru i Ingkoo tee kakatena totona incaku</para>
  <para style="q2" vid="PSA 119:7">wakutuuna kupengkaadhariaka manga tuturamu mobanara<verse eid="PSA 119:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 119:8"/>Iaku bhekukeniakea mpuu-mpuu manga katotapumu,</para>
  <para style="q2" vid="PSA 119:8">bholi sampeampearo ubholiaku.<verse eid="PSA 119:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 119:9"/>Tee opea o mia mangura ajagani pemingkuina mamudhaakana sadhaadhaa amangkilo?</para>
  <para style="q2" vid="PSA 119:9">Ajagania alaloi pemingkuina apokana tee firimanimu.<verse eid="PSA 119:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 119:10"/>Iaku kupeeloko tee mpuu-mpuuna incaku;</para>
  <para style="q2" vid="PSA 119:10">bholi utaroakaaku kusaladhala minaaka i parintamu.<verse eid="PSA 119:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 119:11"/>Firimanimu kudhikaia i nuncana ngangarandaku</para>
  <para style="q2" vid="PSA 119:11">mamudhaakana inda kukodosa tee Ingkoo.<verse eid="PSA 119:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 119:12"/>Bhari-bharia kapujia to Ingkoo, e KAWASANA OPU!</para>
  <para style="q2" vid="PSA 119:12">Adhariakaaku manga katotapumu.<verse eid="PSA 119:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 119:13"/>Tee bhiwiku kupetulatulaaka</para>
  <para style="q2" vid="PSA 119:13">bhari-bharia tutura ibhoasakamu.<verse eid="PSA 119:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 119:14"/>Iaku kukaunde-unde kuose manga tuturamu,</para>
  <para style="q2" vid="PSA 119:14">mboomo mokopewauaakana sagala giuna harataa.<verse eid="PSA 119:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 119:15"/>Iaku bhekufikiria mpuu-mpuu manga kasameamu,</para>
  <para style="q2" vid="PSA 119:15">tee bhekukamatea manga dhalamu.<verse eid="PSA 119:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 119:16"/>Iaku bhekukaunde-unde roonamo manga katotapumu,</para>
  <para style="q2" vid="PSA 119:16">tee inda bhekumalinguakea o firimanimu.<verse eid="PSA 119:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 119:17"/>Pewaumo giu malape i bhatuamu mamudhaakana sadhaadhaa kudhadhi,</para>
  <para style="q2" vid="PSA 119:17">tee bhekukeniakea mpuu-mpuu o firimanimu.<verse eid="PSA 119:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 119:18"/>Bungkalea o mataku mamudhaakana bhekukamata</para>
  <para style="q2" vid="PSA 119:18">manga giu inda momentela minaaka i hukumumu.<verse eid="PSA 119:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 119:19"/>Iaku samia dhaga i dunia sii,</para>
  <para style="q2" vid="PSA 119:19">bholi ubuniakea o parintamu minaaka i karoku.<verse eid="PSA 119:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 119:20"/>Incaku amapii roonamo sadia kupemeliliaka manga tuturamu.<verse eid="PSA 119:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 119:21"/>Ingkoo ugorampangi manga mia mosombo, siitumo manga mia mototunda,</para>
  <para style="q2" vid="PSA 119:21">mosaladhalana minaaka i parintamu.<verse eid="PSA 119:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 119:22"/>Pekaridhoakaaku minaaka i kaele-ele tee kahinana manga incia,</para>
  <para style="q2" vid="PSA 119:22">roonamo kuose manga tuturamu.<verse eid="PSA 119:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 119:23"/>Moomini manga kaogesa apomufakati to aewangiaku,</para>
  <para style="q2" vid="PSA 119:23">bhatuamu sii bheafikiria mpuu-mpuu manga katotapumu.<verse eid="PSA 119:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 119:24"/>Manga tuturamu amembali kapeeluku</para>
  <para style="q2" vid="PSA 119:24">tee amembali monaasehatiaku.<verse eid="PSA 119:24"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 119:25"/>Inyawaku apika tee ngawu roonamo kumatalo;</para>
  <para style="q2" vid="PSA 119:25">padhadhiaku apokana tee firimanimu.<verse eid="PSA 119:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 119:26"/>Iaku padhamo kupetulatulaaka dhalana dhadiku, Ingkoo ulawaniaku;</para>
  <para style="q2" vid="PSA 119:26">adhariakaaku manga katotapumu.<verse eid="PSA 119:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 119:27"/>Tulungiaku mamudhaakana kumembali kumaʼanaia manga kasameamu,</para>
  <para style="q2" vid="PSA 119:27">sumaimo iaku bhekufikiria mpuu-mpuu manga pewaumu inda momentela sumai.<verse eid="PSA 119:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 119:28"/>Inyawaku atangi roonamo kaporona inca,</para>
  <para style="q2" vid="PSA 119:28">pekatangkaaku apokana mboomo firimanimu.<verse eid="PSA 119:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="PSA 119:29"/>Pekaridhoakaaku minaaka i dhala inda mobanara,</para>
  <para style="q2" vid="PSA 119:29">tee roonamo kalapena incamu, uadhariakaakumo o hukumumu.<verse eid="PSA 119:29"/></para>
  <para style="q1">
    <verse number="30" style="v" sid="PSA 119:30"/>Iaku kupili dhala mobanara;</para>
  <para style="q2" vid="PSA 119:30">manga tuturamu padhamo kudhikaia i aroaku.<verse eid="PSA 119:30"/></para>
  <para style="q1">
    <verse number="31" style="v" sid="PSA 119:31"/>Iaku padhamo kukeniaka bhari-bharia o tuturamu, e KAWASANA OPU;</para>
  <para style="q2" vid="PSA 119:31">bholi utaroakaaku kupotibhaaka kaea.<verse eid="PSA 119:31"/></para>
  <para style="q1">
    <verse number="32" style="v" sid="PSA 119:32"/>Iaku kuose manga parinta isusuakamu</para>
  <para style="q2" vid="PSA 119:32">roonamo Ingkoo mopekalalesana ngangarandaku.<verse eid="PSA 119:32"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="33" style="v" sid="PSA 119:33"/>E KAWASANA OPU, adhariakaaku manga katotapumu</para>
  <para style="q2" vid="PSA 119:33">sumaimo bhekuosea sakawana kumate.<verse eid="PSA 119:33"/></para>
  <para style="q1">
    <verse number="34" style="v" sid="PSA 119:34"/>Pamembaliaku kumaʼanaia hukumumu mamudhaakana kutaʼatia,</para>
  <para style="q2" vid="PSA 119:34">tee kukeniakea pekatangka tee mpuu-mpuuna incaku.<verse eid="PSA 119:34"/></para>
  <para style="q1">
    <verse number="35" style="v" sid="PSA 119:35"/>Tondaakumo mamudhaakana kudhadhi kuose manga parintamu,</para>
  <para style="q2" vid="PSA 119:35">roonamo giumo incia sumai ipeeluku.<verse eid="PSA 119:35"/></para>
  <para style="q1">
    <verse number="36" style="v" sid="PSA 119:36"/>Pamembalia o ngangarandaku to aose manga tuturamu,</para>
  <para style="q2" vid="PSA 119:36">mencuana kupeelo laba.<verse eid="PSA 119:36"/></para>
  <para style="q1">
    <verse number="37" style="v" sid="PSA 119:37"/>Pekaridhoakaaku o mataku minaaka i manga giu mosia-sia,</para>
  <para style="q2" vid="PSA 119:37">padhadhiaku i nuncana manga dhalamu.<verse eid="PSA 119:37"/></para>
  <para style="q1">
    <verse number="38" style="v" sid="PSA 119:38"/>Pekatangkea o janjimu i bhatuamu,</para>
  <para style="q2" vid="PSA 119:38">idhawuakamu to mia momaekako.<verse eid="PSA 119:38"/></para>
  <para style="q1">
    <verse number="39" style="v" sid="PSA 119:39"/>Pekaridhoakaaku o kahina imaekaku sumai</para>
  <para style="q2" vid="PSA 119:39">roonamo manga tuturamu amalape.<verse eid="PSA 119:39"/></para>
  <para style="q1">
    <verse number="40" style="v" sid="PSA 119:40"/>Satotuuna kupemeliliaka manga kasameamu;</para>
  <para style="q2" vid="PSA 119:40">padhadhiaku i nuncana kabanaramu.<verse eid="PSA 119:40"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="41" style="v" sid="PSA 119:41"/>E KAWASANA OPU, maasangia o kaasimu molagina aumbatiaku,</para>
  <para style="q2" vid="PSA 119:41">tee o kasalaamatimu apokana tee janjimu.<verse eid="PSA 119:41"/></para>
  <para style="q1">
    <verse number="42" style="v" sid="PSA 119:42"/>Tee mboo sumai, amembali kulawani manga mia mohinaaku</para>
  <para style="q2" vid="PSA 119:42">roonamo kuparacaea i Firimanimu.<verse eid="PSA 119:42"/></para>
  <para style="q1">
    <verse number="43" style="v" sid="PSA 119:43"/>Bholi sampeampearo ualea pendua manga firimanimu mobanara minaaka i ngangaku,</para>
  <para style="q2" vid="PSA 119:43">roonamo kuparacaea tee tuturamu.<verse eid="PSA 119:43"/></para>
  <para style="q1">
    <verse number="44" style="v" sid="PSA 119:44"/>Iaku bhekutorotorosu kukeniakea pekatangka o hukumumu</para>
  <para style="q2" vid="PSA 119:44">to saʼumurua.<verse eid="PSA 119:44"/></para>
  <para style="q1">
    <verse number="45" style="v" sid="PSA 119:45"/>Iaku bhekudhadhi i nuncana kalalesa</para>
  <para style="q2" vid="PSA 119:45">roonamo kupeelo manga kasameamu.<verse eid="PSA 119:45"/></para>
  <para style="q1">
    <verse number="46" style="v" sid="PSA 119:46"/>Iaku uka bhekupogauaka manga tuturamu i aroana manga raja,</para>
  <para style="q2" vid="PSA 119:46">tee iaku inda bhekumaea.<verse eid="PSA 119:46"/></para>
  <para style="q1">
    <verse number="47" style="v" sid="PSA 119:47"/>Iaku kumasanaa roonamo manga parintamu</para>
  <para style="q2" vid="PSA 119:47">imaasiakaku sumai.<verse eid="PSA 119:47"/></para>
  <para style="q1">
    <verse number="48" style="v" sid="PSA 119:48"/>Iaku bhekuangka limaku to kumuliangiaka manga parintamu imaasiakaku sumai,</para>
  <para style="q2" vid="PSA 119:48">tee bhekufikiria mpuu-mpuu manga katotapumu.<verse eid="PSA 119:48"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="49" style="v" sid="PSA 119:49"/>Udhania o firimani ipakawaakamu to bhatuamu</para>
  <para style="q2" vid="PSA 119:49">roonamo firimanimu sumai mopamembaliaku dhaangia tee iharapuku.<verse eid="PSA 119:49"/></para>
  <para style="q1">
    <verse number="50" style="v" sid="PSA 119:50"/>Siimo mohiburuaku i nuncana kanarakaaku</para>
  <para style="q2" vid="PSA 119:50">ande o janjimu sumai mopadhadhiaku.<verse eid="PSA 119:50"/></para>
  <para style="q1">
    <verse number="51" style="v" sid="PSA 119:51"/>Mia mosombo ahinaaku mpuu,</para>
  <para style="q2" vid="PSA 119:51">maka iaku inda kusaladhala minaaka i hukumumu.<verse eid="PSA 119:51"/></para>
  <para style="q1">
    <verse number="52" style="v" sid="PSA 119:52"/>Wakutuuna kuudhani manga tuturamu modhaangiana minaaka i piamo itu,</para>
  <para style="q2" vid="PSA 119:52">sumaimo atohiburumo incaku, e KAWASANA OPU.<verse eid="PSA 119:52"/></para>
  <para style="q1">
    <verse number="53" style="v" sid="PSA 119:53"/>Amasodho o ngangarandaku roonamo mia madhaki</para>
  <para style="q2" vid="PSA 119:53">tee mia inda moosena hukumumu.<verse eid="PSA 119:53"/></para>
  <para style="q1">
    <verse number="54" style="v" sid="PSA 119:54"/>Kangengena dhadhiku momampodho i alamu sii,</para>
  <para style="q2" vid="PSA 119:54">katotapumu kupamembalia manga lagu kapujiaku.<verse eid="PSA 119:54"/></para>
  <para style="q1">
    <verse number="55" style="v" sid="PSA 119:55"/>Wakutuuna amalo kuudhanimo saromu, e KAWASANA OPU,</para>
  <para style="q2" vid="PSA 119:55">tee kukeniakea pekatangka o hukumumu.<verse eid="PSA 119:55"/></para>
  <para style="q1">
    <verse number="56" style="v" sid="PSA 119:56"/>Barakatimo incia sii momembalina dhawuku</para>
  <para style="q2" vid="PSA 119:56">roonamo padhamo kuose manga kasameamu.<verse eid="PSA 119:56"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="57" style="v" sid="PSA 119:57"/>KAWASANA OPU o dhawuku,</para>
  <para style="q2" vid="PSA 119:57">iaku padhamo kupojanji to kukeniakea pekatangka o firimanimu.<verse eid="PSA 119:57"/></para>
  <para style="q1">
    <verse number="58" style="v" sid="PSA 119:58"/>Iaku kuemani kaasina incamu tee mpuu-mpuuna incaku,</para>
  <para style="q2" vid="PSA 119:58">maasiakaaku apokana tee janjimu.<verse eid="PSA 119:58"/></para>
  <para style="q1">
    <verse number="59" style="v" sid="PSA 119:59"/>Iaku kufikiri dhalana dhadhiku,</para>
  <para style="q2" vid="PSA 119:59">tee kubhotukiakea to kumbuli kuose manga tuturamu;<verse eid="PSA 119:59"/></para>
  <para style="q1">
    <verse number="60" style="v" sid="PSA 119:60"/>kupekadhei tee inda kupekanoe-noe</para>
  <para style="q2" vid="PSA 119:60">to kukeniakea pekatangka manga parintamu.<verse eid="PSA 119:60"/></para>
  <para style="q1">
    <verse number="61" style="v" sid="PSA 119:61"/>Mia madhaki ataakaaku katapu,</para>
  <para style="q2" vid="PSA 119:61">maka iaku inda kumalinguaka hukumumu.<verse eid="PSA 119:61"/></para>
  <para style="q1">
    <verse number="62" style="v" sid="PSA 119:62"/>Pontanga malo iaku bhekubhangu to kupujiko,</para>
  <para style="q2" vid="PSA 119:62">roonamo manga tuturamu mobanara.<verse eid="PSA 119:62"/></para>
  <para style="q1">
    <verse number="63" style="v" sid="PSA 119:63"/>Iaku kuposabhangka tee bhari-bharia mia momaekako,</para>
  <para style="q2" vid="PSA 119:63">tee mokenina pekatangka manga kasameamu.<verse eid="PSA 119:63"/></para>
  <para style="q1">
    <verse number="64" style="v" sid="PSA 119:64"/>E KAWASANA OPU, alamu sii abukeaka tee kaasimu molagina;</para>
  <para style="q2" vid="PSA 119:64">adhariakaaku manga katotapumu.<verse eid="PSA 119:64"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="65" style="v" sid="PSA 119:65"/>Ingkoo padhamo upewau kalape i bhatuamu,</para>
  <para style="q2" vid="PSA 119:65">apokana tee firimanimu, e KAWASANA OPU.<verse eid="PSA 119:65"/></para>
  <para style="q1">
    <verse number="66" style="v" sid="PSA 119:66"/>Dhawuakaaku hikimati tee ilimuu,</para>
  <para style="q2" vid="PSA 119:66">roonamo kuparacaea tee manga parintamu.<verse eid="PSA 119:66"/></para>
  <para style="q1">
    <verse number="67" style="v" sid="PSA 119:67"/>Wakutuuna indapo uhukumuaku, iaku kusaladhala,</para>
  <para style="q2" vid="PSA 119:67">maka sii-sii kukeniakea pekatangka o firimanimu.<verse eid="PSA 119:67"/></para>
  <para style="q1">
    <verse number="68" style="v" sid="PSA 119:68"/>Ingkoo umalape tee upewau kalape;</para>
  <para style="q2" vid="PSA 119:68">adhariakaaku manga katotapumu.<verse eid="PSA 119:68"/></para>
  <para style="q1">
    <verse number="69" style="v" sid="PSA 119:69"/>Mia mosombo afitanaaku,</para>
  <para style="q2" vid="PSA 119:69">maka iaku kuose manga kasameamu tee mpuu-mpuuna incaku.<verse eid="PSA 119:69"/></para>
  <para style="q1">
    <verse number="70" style="v" sid="PSA 119:70"/>Incana manga incia amakapa mboomo tabha sabutuna inda anamisi opeopea,</para>
  <para style="q2" vid="PSA 119:70">maka iaku kumaasiaka hukumumu.<verse eid="PSA 119:70"/></para>
  <para style="q1">
    <verse number="71" style="v" sid="PSA 119:71"/>Amalape uka to iaku ande kutopisaki</para>
  <para style="q2" vid="PSA 119:71">mamudhaakana kumembali kupengkaadhariaka manga katotapumu.<verse eid="PSA 119:71"/></para>
  <para style="q1">
    <verse number="72" style="v" sid="PSA 119:72"/>Hukumu ibhoasakamu alabhi o kalapena to iaku</para>
  <para style="q2" vid="PSA 119:72">minaaka i rewuna tibhana bulawa tee pera.<verse eid="PSA 119:72"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="73" style="v" sid="PSA 119:73"/>Limamumo mopamembaliaku tee mopebhanguiaku;</para>
  <para style="q2" vid="PSA 119:73">dhawuaku katau mamudhaakana kumembali kupengkaadhariaka manga parintamu.<verse eid="PSA 119:73"/></para>
  <para style="q1">
    <verse number="74" style="v" sid="PSA 119:74"/>Manga mia momaekako bheakamataaku tee akaunde-unde</para>
  <para style="q2" vid="PSA 119:74">roonamo kuharapu i firimanimu.<verse eid="PSA 119:74"/></para>
  <para style="q1">
    <verse number="75" style="v" sid="PSA 119:75"/>E KAWASANA OPU, iaku kumataua ande o tuturamu abanara,</para>
  <para style="q2" vid="PSA 119:75">tee moomini padhamo upanarakaaku, Ingkoo sadhaadhaa umembali utoparacaea.<verse eid="PSA 119:75"/></para>
  <para style="q1">
    <verse number="76" style="v" sid="PSA 119:76"/>Taroakamo kaasimu molagina mohiburuaku,</para>
  <para style="q2" vid="PSA 119:76">apokana tee janjimu i bhatuamu.<verse eid="PSA 119:76"/></para>
  <para style="q1">
    <verse number="77" style="v" sid="PSA 119:77"/>Taroakamo rahumatimu aumba i iaku mamudhaakana kudhadhi,</para>
  <para style="q2" vid="PSA 119:77">roonamo hukumumu satotuuna ipeeluku.<verse eid="PSA 119:77"/></para>
  <para style="q1">
    <verse number="78" style="v" sid="PSA 119:78"/>Taroakamo mia mosombo amaea,</para>
  <para style="q2" vid="PSA 119:78">roonamo manga incia afitanaaku inda tee sababuna,</para>
  <para style="q2" vid="PSA 119:78">maka iaku bhekufikiria mpuu-mpuu manga kasameamu.<verse eid="PSA 119:78"/></para>
  <para style="q1">
    <verse number="79" style="v" sid="PSA 119:79"/>Taroakamo manga mia momaekako aumbatiaku,</para>
  <para style="q2" vid="PSA 119:79">siitumo manga incia momatauna manga tuturamu.<verse eid="PSA 119:79"/></para>
  <para style="q1">
    <verse number="80" style="v" sid="PSA 119:80"/>Maasangia o ngangarandaku inda alimba minaaka i manga katotapumu</para>
  <para style="q2" vid="PSA 119:80">mamudhaakana iaku inda kupotibhaaka kaea.<verse eid="PSA 119:80"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="81" style="v" sid="PSA 119:81"/>Ngangarandaku apemeliliaka kasalaamati minaaka i Ingkoo,</para>
  <para style="q2" vid="PSA 119:81">iaku kuharapu i firimanimu.<verse eid="PSA 119:81"/></para>
  <para style="q1">
    <verse number="82" style="v" sid="PSA 119:82"/>Mataku amarea roonamo kupemeliliaka janjimu;</para>
  <para style="q2" vid="PSA 119:82">iaku kupogau, "Naepia buaka Ingkoo bheuhiburuaku?"<verse eid="PSA 119:82"/></para>
  <para style="q1">
    <verse number="83" style="v" sid="PSA 119:83"/>Moomini iaku mboomo saangu kadhuna angguru momalusa,</para>
  <para style="q2" vid="PSA 119:83">iaku inda kumalinguakea manga katotapumu.<verse eid="PSA 119:83"/></para>
  <para style="q1">
    <verse number="84" style="v" sid="PSA 119:84"/>Sakawana naepia buaka o bhatuamu tabeana bheaantagiko?</para>
  <para style="q2" vid="PSA 119:84">Naepia buaka Ingkoo bheuhukumu manga mia mopajereaku?<verse eid="PSA 119:84"/></para>
  <para style="q1">
    <verse number="85" style="v" sid="PSA 119:85"/>Manga mia mosombo padhamo aseli kabhalongko to karoku,</para>
  <para style="q2" vid="PSA 119:85">siitumo manga mia inda motaʼatina tee hukumumu.<verse eid="PSA 119:85"/></para>
  <para style="q1">
    <verse number="86" style="v" sid="PSA 119:86"/>Bhari-bharia parintamu atoparacaea.</para>
  <para style="q2" vid="PSA 119:86">Tulungiaku, roonamo manga incia apajereaku inda tee sababuna!<verse eid="PSA 119:86"/></para>
  <para style="q1">
    <verse number="87" style="v" sid="PSA 119:87"/>Saidhepo manga incia apekamateaku,</para>
  <para style="q2" vid="PSA 119:87">maka iaku inda kubholia manga kasameamu.<verse eid="PSA 119:87"/></para>
  <para style="q1">
    <verse number="88" style="v" sid="PSA 119:88"/>Padhadhiaku apokana tee kaasimu molagina</para>
  <para style="q2" vid="PSA 119:88">mamudhaakana kukeniakea mpuu-mpuu manga tutura ipakawaakamu.<verse eid="PSA 119:88"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="89" style="v" sid="PSA 119:89"/>E KAWASANA OPU, firimanimu amatangka</para>
  <para style="q2" vid="PSA 119:89">saʼumurua i sorogaa.<verse eid="PSA 119:89"/></para>
  <para style="q1">
    <verse number="90" style="v" sid="PSA 119:90"/>Ingkoo amembali utoparacaea saʼumurua zamani;</para>
  <para style="q2" vid="PSA 119:90">Ingkoo upekatangka alamu sabutuna asadhaadhaa adhaangia.<verse eid="PSA 119:90"/></para>
  <para style="q1">
    <verse number="91" style="v" sid="PSA 119:91"/>Manga tuturamu asadhaadhaa sakawana sii-sii</para>
  <para style="q2" vid="PSA 119:91">roonamo bhari-bharia modhaangia o bhatuamu.<verse eid="PSA 119:91"/></para>
  <para style="q1">
    <verse number="92" style="v" sid="PSA 119:92"/>Ande o hukumumu inda amembali giu imasanaakana incaku,</para>
  <para style="q2" vid="PSA 119:92">sumaimo dhaanamo kubinasa i nuncana kanarakaaku.<verse eid="PSA 119:92"/></para>
  <para style="q1">
    <verse number="93" style="v" sid="PSA 119:93"/>Inda sampeampearo bhekumalinguakea manga kasameamu,</para>
  <para style="q2" vid="PSA 119:93">roonamo alaloi bhari-bharia giu incia sumai Ingkoo upadhadhiaku.<verse eid="PSA 119:93"/></para>
  <para style="q1">
    <verse number="94" style="v" sid="PSA 119:94"/>Iaku sii o pewauamu; pasalaamatiaku,</para>
  <para style="q2" vid="PSA 119:94">roonamo iaku padhamo kupeeloa manga kasameamu.<verse eid="PSA 119:94"/></para>
  <para style="q1">
    <verse number="95" style="v" sid="PSA 119:95"/>Manga mia madhaki aantagiaku to apabinasaaku,</para>
  <para style="q2" vid="PSA 119:95">maka iaku bhekufikiria mpuu-mpuu manga tuturamu.<verse eid="PSA 119:95"/></para>
  <para style="q1">
    <verse number="96" style="v" sid="PSA 119:96"/>Bhari-bharia ikamataku dhaangia tee batasina, moomini o giu mosangka,</para>
  <para style="q2" vid="PSA 119:96">maka o parintamu amaewa mpuu.<verse eid="PSA 119:96"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="97" style="v" sid="PSA 119:97"/>Tapanamo kumaasiakea o hukumumu!</para>
  <para style="q2" vid="PSA 119:97">Iaku kufikiria mpuu-mpuu saeoa.<verse eid="PSA 119:97"/></para>
  <para style="q1">
    <verse number="98" style="v" sid="PSA 119:98"/>Manga parintamu apamembaliaku kuʼaarifu minaaka i manga musuku,</para>
  <para style="q2" vid="PSA 119:98">roonamo bhari-bharia giu incia sumai sadia adhaangia i karoku.<verse eid="PSA 119:98"/></para>
  <para style="q1">
    <verse number="99" style="v" sid="PSA 119:99"/>Katauku alabhi o kabharina minaaka imatauna manga guruku,</para>
  <para style="q2" vid="PSA 119:99">roonamo kufikiria mpuu-mpuu manga tuturamu.<verse eid="PSA 119:99"/></para>
  <para style="q1">
    <verse number="100" style="v" sid="PSA 119:100"/>Kumembali kumaʼanaia alabhi minaaka i manga mancuana,</para>
  <para style="q2" vid="PSA 119:100">roonamo iaku kuose manga kasameamu.<verse eid="PSA 119:100"/></para>
  <para style="q1">
    <verse number="101" style="v" sid="PSA 119:101"/>Kutaangia o aeku minaaka i bhari-bharia pewau madhaki,</para>
  <para style="q2" vid="PSA 119:101">mamudhaakana kumembali kukenia mpuu-mpuu o firimanimu.<verse eid="PSA 119:101"/></para>
  <para style="q1">
    <verse number="102" style="v" sid="PSA 119:102"/>Iaku inda kusaladhala minaaka i manga tuturamu,</para>
  <para style="q2" vid="PSA 119:102">roonamo Ingkoomo mopadhana moadhariaku.<verse eid="PSA 119:102"/></para>
  <para style="q1">
    <verse number="103" style="v" sid="PSA 119:103"/>Tapanamo kameko o firimanimu,</para>
  <para style="q2" vid="PSA 119:103">alabhi o kamekona minaaka i golana uwani!<verse eid="PSA 119:103"/></para>
  <para style="q1">
    <verse number="104" style="v" sid="PSA 119:104"/>Minaaka i manga kasameamu kupotibhaaka katau,</para>
  <para style="q2" vid="PSA 119:104">siitumo sababuna kubancia bhari-bharia dhala inda mobanara.<verse eid="PSA 119:104"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="105" style="v" sid="PSA 119:105"/>Firimanimu mboomo kanturu mosuluwina bhengkalaku,</para>
  <para style="q2" vid="PSA 119:105">tee mopekainawana dhalaku.<verse eid="PSA 119:105"/></para>
  <para style="q1">
    <verse number="106" style="v" sid="PSA 119:106"/>Iaku padhamo kuposumpa tee bhekupekatangkea pendua,</para>
  <para style="q2" vid="PSA 119:106">ande bhekukeniakea mpuu manga tuturamu mobanarana sumai.<verse eid="PSA 119:106"/></para>
  <para style="q1">
    <verse number="107" style="v" sid="PSA 119:107"/>Iaku kunarakaa mpuu,</para>
  <para style="q2" vid="PSA 119:107">e KAWASANA OPU, padhadhiaku pendua apokana tee firimanimu.<verse eid="PSA 119:107"/></para>
  <para style="q1">
    <verse number="108" style="v" sid="PSA 119:108"/>Maasangia utarimaia o pasombaana karelana incaku, siitumo manga kapujiaku, e KAWASANA OPU,</para>
  <para style="q2" vid="PSA 119:108">tee uadhariakaaku manga tuturamu.<verse eid="PSA 119:108"/></para>
  <para style="q1">
    <verse number="109" style="v" sid="PSA 119:109"/>Iaku sadia kutaaka inyawaku,</para>
  <para style="q2" vid="PSA 119:109">maka iaku inda kumalinguakea o hukumumu.<verse eid="PSA 119:109"/></para>
  <para style="q1">
    <verse number="110" style="v" sid="PSA 119:110"/>Manga mia madhaki ataa katapu to iaku,</para>
  <para style="q2" vid="PSA 119:110">maka iaku inda kusaladhala minaaka i manga kasameamu.<verse eid="PSA 119:110"/></para>
  <para style="q1">
    <verse number="111" style="v" sid="PSA 119:111"/>Manga tuturamu kupamembalia dhawuku mobakaa,</para>
  <para style="q2" vid="PSA 119:111">roonamo bhari-bharia sumai satotuuna mopaunde-undena incaku.<verse eid="PSA 119:111"/></para>
  <para style="q1">
    <verse number="112" style="v" sid="PSA 119:112"/>Iaku padhamo kubhawea o ngangarandaku to kupewauaka manga katotapumu</para>
  <para style="q2" vid="PSA 119:112">to saʼumurua, sakawana aahirina dhadhiku.<verse eid="PSA 119:112"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="113" style="v" sid="PSA 119:113"/>Iaku kubancia manga mia inda mototona incana,</para>
  <para style="q2" vid="PSA 119:113">maka kumaasiakea o hukumumu.<verse eid="PSA 119:113"/></para>
  <para style="q1">
    <verse number="114" style="v" sid="PSA 119:114"/>Ingkoomo tampana peulusaku tee katangkesi mojaganiaku;</para>
  <para style="q2" vid="PSA 119:114">iaku kuharapu i firimanimu.<verse eid="PSA 119:114"/></para>
  <para style="q1">
    <verse number="115" style="v" sid="PSA 119:115"/>Pekaridhomo minaaka i iaku, e manga mia mopewauna madhaki,</para>
  <para style="q2" vid="PSA 119:115">mamudhaakana kumembali kuose manga parintana Aulataʼalaku.<verse eid="PSA 119:115"/></para>
  <para style="q1">
    <verse number="116" style="v" sid="PSA 119:116"/>Pekakaaku apokana tee janjimu mamudhaakana kudhadhi,</para>
  <para style="q2" vid="PSA 119:116">tee bholi upekaeaaku i nuncana harapuku.<verse eid="PSA 119:116"/></para>
  <para style="q1">
    <verse number="117" style="v" sid="PSA 119:117"/>Tukoaku mamudhaakana kutopasalaamati,</para>
  <para style="q2" vid="PSA 119:117">tee sadia bhekuhoromatia manga katotapumu.<verse eid="PSA 119:117"/></para>
  <para style="q1">
    <verse number="118" style="v" sid="PSA 119:118"/>Ingkoo umendeu bhari-bharia mia mosaladhalana minaaka i manga katotapumu,</para>
  <para style="q2" vid="PSA 119:118">roonamo inda akoguna o katipuna manga incia.<verse eid="PSA 119:118"/></para>
  <para style="q1">
    <verse number="119" style="v" sid="PSA 119:119"/>Ingkoo uabhia bhari-bharia mia madhaki i alamu mboomo karombuna pera;</para>
  <para style="q2" vid="PSA 119:119">siitumo sababuna kumaasiakea manga tuturamu.<verse eid="PSA 119:119"/></para>
  <para style="q1">
    <verse number="120" style="v" sid="PSA 119:120"/>Badaku arengku roonamo kumeakako,</para>
  <para style="q2" vid="PSA 119:120">tee kumaeka tee manga tuturamu.<verse eid="PSA 119:120"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="121" style="v" sid="PSA 119:121"/>Iaku padhamo kupewau kaʼadili tee kabanara,</para>
  <para style="q2" vid="PSA 119:121">bholi upasaraakaaku i manga mia mopisakiaku.<verse eid="PSA 119:121"/></para>
  <para style="q1">
    <verse number="122" style="v" sid="PSA 119:122"/>Pojanjimo ande o bhatuamu bheamalape;</para>
  <para style="q2" vid="PSA 119:122">bholi utaroakaaku apisakiaku manga mia mosombo.<verse eid="PSA 119:122"/></para>
  <para style="q1">
    <verse number="123" style="v" sid="PSA 119:123"/>Mataku amarea roonamo kuantaantagi kasalaamati minaaka i Ingkoo,</para>
  <para style="q2" vid="PSA 119:123">tee utolosia o janjimu mobanara sumai.<verse eid="PSA 119:123"/></para>
  <para style="q1">
    <verse number="124" style="v" sid="PSA 119:124"/>Pewaumo to iaku apokana tee kaasimu molagina,</para>
  <para style="q2" vid="PSA 119:124">tee uadhariakaaku manga katotapumu.<verse eid="PSA 119:124"/></para>
  <para style="q1">
    <verse number="125" style="v" sid="PSA 119:125"/>Iaku o bhatuamu; dhawuaku maʼana,</para>
  <para style="q2" vid="PSA 119:125">mamudhaakana kumataua manga tuturamu.<verse eid="PSA 119:125"/></para>
  <para style="q1">
    <verse number="126" style="v" sid="PSA 119:126"/>Akawamo wakutuuna to KAWASANA OPU abhangu tee ahukumu manga incia,</para>
  <para style="q2" vid="PSA 119:126">roonamo manga incia inda ataʼati hukumumu.<verse eid="PSA 119:126"/></para>
  <para style="q1">
    <verse number="127" style="v" sid="PSA 119:127"/>Siitumo sababuna, kumaasiaka manga parintamu</para>
  <para style="q2" vid="PSA 119:127">alabhi minaaka i bulawa, alabhi minaaka i bulawa asilii.<verse eid="PSA 119:127"/></para>
  <para style="q1">
    <verse number="128" style="v" sid="PSA 119:128"/>Siitumo sababuna, kupekakate dhalaku to kuose bhari-bharia kasameamu;</para>
  <para style="q2" vid="PSA 119:128">tee kubancia bhari-bharia dhala inda mobanara.<verse eid="PSA 119:128"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="129" style="v" sid="PSA 119:129"/>Manga tuturamu inda amentela;</para>
  <para style="q2" vid="PSA 119:129">sababuna sumai kuosea.<verse eid="PSA 119:129"/></para>
  <para style="q1">
    <verse number="130" style="v" sid="PSA 119:130"/>Wakutuuna firimanimu sumai atopatinda, amembali adhawuaka kainawa</para>
  <para style="q2" vid="PSA 119:130">tee adhawuaka maʼana to mia inda momatauna opeopea.<verse eid="PSA 119:130"/></para>
  <para style="q1">
    <verse number="131" style="v" sid="PSA 119:131"/>Iaku kubungkale ngangaku tee kukahaahaa,</para>
  <para style="q2" vid="PSA 119:131">roonamo kupemeliliaka manga parintamu.<verse eid="PSA 119:131"/></para>
  <para style="q1">
    <verse number="132" style="v" sid="PSA 119:132"/>Tontoakumo tee umaasiakaakumo,</para>
  <para style="q2" vid="PSA 119:132">mboomo kananea ipewaumu to mia momaasiakana saromu.<verse eid="PSA 119:132"/></para>
  <para style="q1">
    <verse number="133" style="v" sid="PSA 119:133"/>Pekatangkea o bhengkalaku tee firimanimu,</para>
  <para style="q2" vid="PSA 119:133">tee bholi utaroakaaku akuasaiaku kadhaki.<verse eid="PSA 119:133"/></para>
  <para style="q1">
    <verse number="134" style="v" sid="PSA 119:134"/>Tolosiakumo minaaka i manga mia mopisakiaku</para>
  <para style="q2" vid="PSA 119:134">mamudhaakana kumembali kukeniakea mpuu-mpuu manga kasameamu.<verse eid="PSA 119:134"/></para>
  <para style="q1">
    <verse number="135" style="v" sid="PSA 119:135"/>Taroakamo roumu akocahea i bhawona karoku,</para>
  <para style="q2" vid="PSA 119:135">tee uadhariakaaku manga katotapumu.<verse eid="PSA 119:135"/></para>
  <para style="q1">
    <verse number="136" style="v" sid="PSA 119:136"/>Loluku asiwulu mboomo umala,</para>
  <para style="q2" vid="PSA 119:136">roonamo mia inda akeniakea mpuu-mpuu o hukumumu.<verse eid="PSA 119:136"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="137" style="v" sid="PSA 119:137"/>E KAWASANA OPU, Ingkoo uʼadili</para>
  <para style="q2" vid="PSA 119:137">tee manga tuturamu uka abanara.<verse eid="PSA 119:137"/></para>
  <para style="q1">
    <verse number="138" style="v" sid="PSA 119:138"/>Manga tuturamu padhamo upatotapuakea i nuncana kabanara</para>
  <para style="q2" vid="PSA 119:138">tee alaenga atoparacaea.<verse eid="PSA 119:138"/></para>
  <para style="q1">
    <verse number="139" style="v" sid="PSA 119:139"/>Amaraku ahanda mpuu i nuncana karoku</para>
  <para style="q2" vid="PSA 119:139">roonamo manga musuku amalinguaka firimanimu.<verse eid="PSA 119:139"/></para>
  <para style="q1">
    <verse number="140" style="v" sid="PSA 119:140"/>Janjimu atouji mpuu;</para>
  <para style="q2" vid="PSA 119:140">rampaakanamo sumai kumaasiakea.<verse eid="PSA 119:140"/></para>
  <para style="q1">
    <verse number="141" style="v" sid="PSA 119:141"/>Iaku sii kumaidhiidhi tee kumembali mia mohina,</para>
  <para style="q2" vid="PSA 119:141">maka iaku inda kumalinguakea manga kasameamu.<verse eid="PSA 119:141"/></para>
  <para style="q1">
    <verse number="142" style="v" sid="PSA 119:142"/>Kabanaramu atotuu saʼumurua,</para>
  <para style="q2" vid="PSA 119:142">tee o hukumumu atoparacaea.<verse eid="PSA 119:142"/></para>
  <para style="q1">
    <verse number="143" style="v" sid="PSA 119:143"/>Kaseke tee kanarakaa akangkanaiaku,</para>
  <para style="q2" vid="PSA 119:143">maka manga parintamu apasanaa ngangarandaku.<verse eid="PSA 119:143"/></para>
  <para style="q1">
    <verse number="144" style="v" sid="PSA 119:144"/>Manga tuturamu abanara saʼumurua;</para>
  <para style="q2" vid="PSA 119:144">dhawuaku katau mamudhaakana kudhadhi.<verse eid="PSA 119:144"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="145" style="v" sid="PSA 119:145"/>Iaku kugora tee mpuu-mpuuna incaku; lawaniakumo, e KAWASANA OPU.</para>
  <para style="q2" vid="PSA 119:145">Iaku bhekuosea manga katotapumu.<verse eid="PSA 119:145"/></para>
  <para style="q1">
    <verse number="146" style="v" sid="PSA 119:146"/>Iaku kugora i Ingkoo; pasalaamatiaku,</para>
  <para style="q2" vid="PSA 119:146">mamudhaakana bhekukenia mpuu-mpuu manga tuturamu.<verse eid="PSA 119:146"/></para>
  <para style="q1">
    <verse number="147" style="v" sid="PSA 119:147"/>Indapo raneeooge, kubhangumo tee kugora kuemani tulungi;</para>
  <para style="q2" vid="PSA 119:147">iaku kuharapu i firimanimu.<verse eid="PSA 119:147"/></para>
  <para style="q1">
    <verse number="148" style="v" sid="PSA 119:148"/>Samaloa inda kukole</para>
  <para style="q2" vid="PSA 119:148">mamudhaakana amembali kufikiria mpuu-mpuu o firimanimu.<verse eid="PSA 119:148"/></para>
  <para style="q1">
    <verse number="149" style="v" sid="PSA 119:149"/>Maasangia urangoa o doʼaku apokana tee kaasimu molagina.</para>
  <para style="q2" vid="PSA 119:149">E KAWASANA OPU, padhadhiaku apokana tee kaʼadilimu.<verse eid="PSA 119:149"/></para>
  <para style="q1">
    <verse number="150" style="v" sid="PSA 119:150"/>Manga mia mopajereaku tee haejati madhaki amakasumo;</para>
  <para style="q2" vid="PSA 119:150">manga incia amaridho minaaka i hukumumu.<verse eid="PSA 119:150"/></para>
  <para style="q1">
    <verse number="151" style="v" sid="PSA 119:151"/>Maka Ingkoo umakasu, e KAWASANA OPU,</para>
  <para style="q2" vid="PSA 119:151">tee bhari-bharia parintamu abanara.<verse eid="PSA 119:151"/></para>
  <para style="q1">
    <verse number="152" style="v" sid="PSA 119:152"/>Minaaka i piamo itu kumataua minaaka i manga tuturamu</para>
  <para style="q2" vid="PSA 119:152">ande Ingkoo padhamo upatotapuakea to saʼumurua.<verse eid="PSA 119:152"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="153" style="v" sid="PSA 119:153"/>Kamatamea o kanarakaaku tee upasalaamatiakumo,</para>
  <para style="q2" vid="PSA 119:153">roonamo inda kumalinguakea o hukumumu.<verse eid="PSA 119:153"/></para>
  <para style="q1">
    <verse number="154" style="v" sid="PSA 119:154"/>Ewaakea o parakaraku tee upabebasiaku,</para>
  <para style="q2" vid="PSA 119:154">padhadhiaku apokana mboomo janjimu.<verse eid="PSA 119:154"/></para>
  <para style="q1">
    <verse number="155" style="v" sid="PSA 119:155"/>Kasalaamatimu sumai amaridho minaaka i manga mia madhaki</para>
  <para style="q2" vid="PSA 119:155">roonamo manga incia inda apeelo katotapumu.<verse eid="PSA 119:155"/></para>
  <para style="q1">
    <verse number="156" style="v" sid="PSA 119:156"/>Tapanamo kaoge o rahumatimu, e KAWASANA OPU!</para>
  <para style="q2" vid="PSA 119:156">Padhadhiaku apokana mboomo manga tuturamu.<verse eid="PSA 119:156"/></para>
  <para style="q1">
    <verse number="157" style="v" sid="PSA 119:157"/>Abhari o mia mopajereaku tee momusuiaku,</para>
  <para style="q2" vid="PSA 119:157">maka inda kusaladhala minaaka i manga tuturamu.<verse eid="PSA 119:157"/></para>
  <para style="q1">
    <verse number="158" style="v" sid="PSA 119:158"/>Iaku kumarikaia manga pande hiaanati sumai,</para>
  <para style="q2" vid="PSA 119:158">roonamo manga incia inda aose firimanimu.<verse eid="PSA 119:158"/></para>
  <para style="q1">
    <verse number="159" style="v" sid="PSA 119:159"/>Kamatea tapanamo kaasiku tee manga kasameamu, e KAWASANA OPU!</para>
  <para style="q2" vid="PSA 119:159">Jagania o inyawaku apokana tee kaasimu molagina.<verse eid="PSA 119:159"/></para>
  <para style="q1">
    <verse number="160" style="v" sid="PSA 119:160"/>Bhari-bharia ipogauakamu atotuu,</para>
  <para style="q2" vid="PSA 119:160">tee bhari-bharia tuturamu mobanara sumai abakaa saʼumurua.<verse eid="PSA 119:160"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="161" style="v" sid="PSA 119:161"/>Manga kaogesa apajereaku inda tee sababuna,</para>
  <para style="q2" vid="PSA 119:161">maka tangkanamo firimanimu imaekaku.<verse eid="PSA 119:161"/></para>
  <para style="q1">
    <verse number="162" style="v" sid="PSA 119:162"/>Janjimu apewauaku kukaunde-unde,</para>
  <para style="q2" vid="PSA 119:162">mboomo mia mopotibhaakana harataa mobhari minaaka i potimbea.<verse eid="PSA 119:162"/></para>
  <para style="q1">
    <verse number="163" style="v" sid="PSA 119:163"/>Bhari-bharia kagau-gau kubancia,</para>
  <para style="q2" vid="PSA 119:163">maka o hukumumu kumaasiakea.<verse eid="PSA 119:163"/></para>
  <para style="q1">
    <verse number="164" style="v" sid="PSA 119:164"/>Pitu mpearo saeo kupujiko,</para>
  <para style="q2" vid="PSA 119:164">roonamo tuturamu moʼadili.<verse eid="PSA 119:164"/></para>
  <para style="q1">
    <verse number="165" style="v" sid="PSA 119:165"/>Mia momaasiakana hukumumu aʼamani tee amasanaa o dhadhina,</para>
  <para style="q2" vid="PSA 119:165">inda dhaangia giu momembalina imandawuakana manga incia.<verse eid="PSA 119:165"/></para>
  <para style="q1">
    <verse number="166" style="v" sid="PSA 119:166"/>Iaku kuantagi kasalaamati minaaka i Ingkoo, e KAWASANA OPU,</para>
  <para style="q2" vid="PSA 119:166">tee manga parintamu kupewaua.<verse eid="PSA 119:166"/></para>
  <para style="q1">
    <verse number="167" style="v" sid="PSA 119:167"/>Iaku kutaʼatia manga tuturamu,</para>
  <para style="q2" vid="PSA 119:167">tee kumaasiakea tee mpuu-mpuuna incaku.<verse eid="PSA 119:167"/></para>
  <para style="q1">
    <verse number="168" style="v" sid="PSA 119:168"/>Iaku kutaʼati manga kasameamu tee tuturamu,</para>
  <para style="q2" vid="PSA 119:168">roonamo ukamatea sagala giu ipewauku.<verse eid="PSA 119:168"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="169" style="v" sid="PSA 119:169"/>Maasangia o goraku akawa i Ingkoo, e KAWASANA OPU;</para>
  <para style="q2" vid="PSA 119:169">dhawuaku maʼana mopokanana tee janjimu.<verse eid="PSA 119:169"/></para>
  <para style="q1">
    <verse number="170" style="v" sid="PSA 119:170"/>Taroakamo iemaniku akawa i Ingkoo;</para>
  <para style="q2" vid="PSA 119:170">pasalaamatiaku apokana tee janjimu.<verse eid="PSA 119:170"/></para>
  <para style="q1">
    <verse number="171" style="v" sid="PSA 119:171"/>Taroakamo bhiwiku sadia apujiko,</para>
  <para style="q2" vid="PSA 119:171">roonamo padhamo uadhariakaaku manga katotapumu.<verse eid="PSA 119:171"/></para>
  <para style="q1">
    <verse number="172" style="v" sid="PSA 119:172"/>Taroakamo o dhelaku alaguaka janjimu,</para>
  <para style="q2" vid="PSA 119:172">roonamo bhari-bharia parintamu abanara.<verse eid="PSA 119:172"/></para>
  <para style="q1">
    <verse number="173" style="v" sid="PSA 119:173"/>Taroakamo limamu sadia atulungiaku,</para>
  <para style="q2" vid="PSA 119:173">roonamo iaku padhamo kupili manga kasameamu.<verse eid="PSA 119:173"/></para>
  <para style="q1">
    <verse number="174" style="v" sid="PSA 119:174"/>Iaku kupemeliliaka kasalaamati minaaka i Ingkoo, e KAWASANA OPU,</para>
  <para style="q2" vid="PSA 119:174">tee o hukumumu apaunde-undeaku.<verse eid="PSA 119:174"/></para>
  <para style="q1">
    <verse number="175" style="v" sid="PSA 119:175"/>Taroakamo kudhadhi, mamudhaakana kupujiko,</para>
  <para style="q2" vid="PSA 119:175">tee maasangia manga tuturamu atulungiaku.<verse eid="PSA 119:175"/></para>
  <para style="q1">
    <verse number="176" style="v" sid="PSA 119:176"/>Iaku kusaladhala mboomo dumba momambuu;</para>
  <para style="q2" vid="PSA 119:176">sumaimo uumbamo tee upokawaaka bhatuamu,</para>
  <para style="q2" vid="PSA 119:176">roonamo inda kumalinguakea manga parintamu.<verse eid="PSA 119:176"/></para>
  <chapter eid="PSA 119"/>
  <chapter number="120" style="c" sid="PSA 120"/>
  <para style="s">Doʼa Emaniana Kasalaamati minaaka i Fitanaa</para>
  <para style="sr">
    <ref loc="PSA 120:1-7">120:1-7</ref></para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 120:1"/>Laguna ziara.<note caller="+" style="f"><char style="fr" closed="false">120:1 </char><char style="fq" closed="false">ziara: </char><char style="ft" closed="false">Aipomo manga Zaburu 120-134 ilaguakana miana Israel wakutuuna apene aziara i Kota Yerusalem i tana mokogunuana.</char></note></para>
  <para style="b" vid="PSA 120:1"/>
  <para style="q1" vid="PSA 120:1">I nuncana kanarakaaku kugora i KAWASANA OPU,</para>
  <para style="q2" vid="PSA 120:1">tee Incia alawaniaku.<verse eid="PSA 120:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 120:2"/>"E KAWASANA OPU, maasangia urambasakaaku minaaka i bhiwi mogau-gau</para>
  <para style="q2" vid="PSA 120:2">tee dhela mopekatipu."<verse eid="PSA 120:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 120:3"/>Opea bheidhawuakana to ingkoo,</para>
  <para style="q2" vid="PSA 120:3">tee opea bheiranganina to ingkoo,</para>
  <para style="q2" vid="PSA 120:3">e pande tipu?<verse eid="PSA 120:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 120:4"/>Samia suludadu bheapanako tee pana momatadha</para>
  <para style="q2" vid="PSA 120:4">tee atunuakako tee weona waa!<verse eid="PSA 120:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 120:5"/>Kucilakamo roonamo kumboore mboomo samia dhaga i Mesekh,</para>
  <para style="q2" vid="PSA 120:5">tee tabeana kumboore i tanga-tangana kemana miana Kedar!<note caller="+" style="f"><char style="fr" closed="false">120:5 </char><char style="fq" closed="false">Mesekh ... Kedar: </char><char style="ft" closed="false">Miana Mesekh tee Kedar atoabhi mia masega tee inda akofeʼeli. </char></note><verse eid="PSA 120:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 120:6"/>Amangengemo laulau kumboore</para>
  <para style="q2" vid="PSA 120:6">kupoose tee manga mia mobancina dhadhi pomalape.<verse eid="PSA 120:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 120:7"/>Iaku gauku kudhadhi pomalape,</para>
  <para style="q2" vid="PSA 120:7">maka ande kupogau mamudhaakana ingkita tadhadhi pomalape,</para>
  <para style="q2" vid="PSA 120:7">manga incia gauna apotimbe.<verse eid="PSA 120:7"/></para>
  <chapter eid="PSA 120"/>
  <chapter number="121" style="c" sid="PSA 121"/>
  <para style="s">KAWASANA OPU, Mojaganina Israel</para>
  <para style="sr">
    <ref loc="PSA 121:1-8">121:1-8</ref></para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 121:1"/>Laguna ziara.</para>
  <para style="b" vid="PSA 121:1"/>
  <para style="q1" vid="PSA 121:1">Iaku kupotingara i manga gunu,</para>
  <para style="q2" vid="PSA 121:1">minaaka iapai bheakawa o katulungi to iaku?<verse eid="PSA 121:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 121:2"/>Katulungiku aumba minaaka i KAWASANA OPU,</para>
  <para style="q2" vid="PSA 121:2">mopadhaangiana laiana tee alamu.<verse eid="PSA 121:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 121:3"/>Incia inda bheataroakako usindoli;</para>
  <para style="q2" vid="PSA 121:3">Incia mojaganiko tee inda akole.<verse eid="PSA 121:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 121:4"/>Satotuuna, Incia mojaganina Israel</para>
  <para style="q2" vid="PSA 121:4">inda bheamangkoo matana atawa atokole.<verse eid="PSA 121:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 121:5"/>KAWASANA OPU mojaganiko,</para>
  <para style="q2" vid="PSA 121:5">KAWASANA OPU o peulusamu i weta kaanamu.<verse eid="PSA 121:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 121:6"/>Matanaeo inda bheapacilakako i wakutuuna eo,</para>
  <para style="q2" vid="PSA 121:6">atawa o bula i wakutuuna amalo.<note caller="+" style="f"><char style="fr" closed="false">121:6 </char><char style="ft" closed="false">Maʼanana mia bheaʼamani i wakutuuna eo tee malo.</char></note><verse eid="PSA 121:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 121:7"/>KAWASANA OPU bheajaganiko minaaka i balaa,</para>
  <para style="q2" vid="PSA 121:7">Incia bheajagani inyawamu.<verse eid="PSA 121:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 121:8"/>KAWASANA OPU bheajaganiko wakutuuna uumba tee ulingka,</para>
  <para style="q2" vid="PSA 121:8">pepuu sii-sii sakawana saʼumurua.<verse eid="PSA 121:8"/></para>
  <chapter eid="PSA 121"/>
  <chapter number="122" style="c" sid="PSA 122"/>
  <para style="s">Doʼana Kasanaa to Miana Yerusalem</para>
  <para style="sr">
    <ref loc="PSA 122:1-9">122:1-9</ref></para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 122:1"/>Laguna ziarana Daud.</para>
  <para style="b" vid="PSA 122:1"/>
  <para style="q1" vid="PSA 122:1">Iaku kukaunde-unde wakutuuna o mia apogau tee iaku,</para>
  <para style="q2" vid="PSA 122:1">"Mai talingkaaka i Bhanuana KAWASANA OPU!"<verse eid="PSA 122:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 122:2"/>Sii-sii aemami akakaro</para>
  <para style="q2" vid="PSA 122:2">i bhambana lawamu, e Yerusalem!<verse eid="PSA 122:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 122:3"/>Yerusalem padhamo atopakaro</para>
  <para style="q2" vid="PSA 122:3">amembali kota mototapi momakaa tee momatangka.<verse eid="PSA 122:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 122:4"/>Iwe siimo manga lipu aziara,</para>
  <para style="q2" vid="PSA 122:4">siitumo uumatina manga lipu ipilina KAWASANA OPU,</para>
  <para style="q2" vid="PSA 122:4">to aumba asukuru i Incia</para>
  <para style="q2" vid="PSA 122:4">mboomo manga tutura mopadhana iparintaakana to miana Israel.<verse eid="PSA 122:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 122:5"/>Iwe siimo manga rajana Israel, siitumo manga siwuluna Raja Daud auncura i kauncuramakana</para>
  <para style="q2" vid="PSA 122:5">tee adhawuaka kambotuna moʼadili to lipuna.<verse eid="PSA 122:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 122:6"/>Doʼamo to kasanaana Yerusalem,</para>
  <para style="q2" vid="PSA 122:6">"Maasangia bhari-bharia mia momaasiakako apotibhaaka kaʼamani.<verse eid="PSA 122:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 122:7"/>Maasangia dhaangia tee kasanaa i nuncana lipumu,</para>
  <para style="q2" vid="PSA 122:7">tee kaʼamani i nuncana manga bentemu."<verse eid="PSA 122:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 122:8"/>Rampaakanamo manga witinaiku tee manga sabhangkaku momboorena iwe sumai,</para>
  <para style="q2" vid="PSA 122:8">iaku bhekupogau, "Maasangia umasanaa!"<verse eid="PSA 122:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 122:9"/>Rampaakanamo Bhanuana KAWASANA OPU, Aulataʼalata dhaangia iwe sumai,</para>
  <para style="q2" vid="PSA 122:9">iaku bhekupeeloakako kalape.<verse eid="PSA 122:9"/></para>
  <chapter eid="PSA 122"/>
  <chapter number="123" style="c" sid="PSA 123"/>
  <para style="s">Taharapu i Rahumatina Kawasana Opu</para>
  <para style="sr">
    <ref loc="PSA 123:1-4">123:1-4</ref></para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 123:1"/>Laguna ziara.</para>
  <para style="b" vid="PSA 123:1"/>
  <para style="q1" vid="PSA 123:1">I Ingkoomo kupotingara,</para>
  <para style="q2" vid="PSA 123:1">e Ingkoo mokokauncuramakana i sorogaa!<verse eid="PSA 123:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 123:2"/>Kamatea, mboomo samia bhatua umane</para>
  <para style="q2" vid="PSA 123:2">moposaronakana i opuna,</para>
  <para style="q2" vid="PSA 123:2">tee mboomo samia bhatua bhawine moposaronakana i opuna bhawine,</para>
  <para style="q1" vid="PSA 123:2">mboo siitumo ingkita taposaronaka i KAWASANA OPU, Aulataʼalata,</para>
  <para style="q2" vid="PSA 123:2">sakawana manga maasiaka.<verse eid="PSA 123:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 123:3"/>Manga maasiakapo e KAWASANA OPU, manga maasiakapo,</para>
  <para style="q2" vid="PSA 123:3">roonamo amenturumo mpuu ingkami tatohina.<verse eid="PSA 123:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 123:4"/>Ingkami tamambosuakamo</para>
  <para style="q2" vid="PSA 123:4">kaele-elena manga mia moabhina karona amulia,</para>
  <para style="q2" vid="PSA 123:4">tee kahinana manga mia mosombo.<verse eid="PSA 123:4"/></para>
  <chapter eid="PSA 123"/>
  <chapter number="124" style="c" sid="PSA 124"/>
  <para style="s">Atopujimo Motulungina Miana Israel</para>
  <para style="sr">
    <ref loc="PSA 124:1-8">124:1-8</ref></para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 124:1"/>Laguna ziara. Zaburuna Daud.</para>
  <para style="b" vid="PSA 124:1"/>
  <para style="q1" vid="PSA 124:1">Ande mencuana o KAWASANA OPU mopobhawana tee ingkita</para>
  <para style="q2" vid="PSA 124:1">taroakamo miana Israel apogau mboo sumai,<verse eid="PSA 124:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 124:2"/>ande mencuana KAWASANA OPU mopobhawana tee ingkita</para>
  <para style="q2" vid="PSA 124:2">wakutuuna mangahumbuni bhalita,<verse eid="PSA 124:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 124:3"/>sumaimo manga incia mangadhoku takadhadhi-dhadhi</para>
  <para style="q2" vid="PSA 124:3">wakutuuna o amarana manga incia akarore-rore to ingkita.<verse eid="PSA 124:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 124:4"/>Sumaimo o uwena mawa mangapaampe,</para>
  <para style="q2" vid="PSA 124:4">tee o siwuluna uwena umala momaranca mangapatondu,<verse eid="PSA 124:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 124:5"/>sumaimo o uwe mokalua-lua sumai</para>
  <para style="q2" vid="PSA 124:5">akangkanaimo ingkita.<verse eid="PSA 124:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 124:6"/>Atopujimo o KAWASANA OPU, inda mangapasaraaka</para>
  <para style="q2" vid="PSA 124:6">tamembali kinandena manga incia.<verse eid="PSA 124:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 124:7"/>Ingkita talapamo mboomo manu-manu</para>
  <para style="q2" vid="PSA 124:7">minaaka i katapuna manga pande pekaose.</para>
  <para style="q2" vid="PSA 124:7">Katapu sumai amabhotumo,</para>
  <para style="q2" vid="PSA 124:7">tee ingkita uka talapamo.<verse eid="PSA 124:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 124:8"/>Katulungita aumba minaaka i KAWASANA OPU</para>
  <para style="q2" vid="PSA 124:8">mopadhaangiana laiana tee alamu.<verse eid="PSA 124:8"/></para>
  <chapter eid="PSA 124"/>
  <chapter number="125" style="c" sid="PSA 125"/>
  <para style="s1">Amani i nuncana Peulusana KAWASANA OPU</para>
  <para style="sr">
    <ref loc="PSA 125:1-5">125:1-5</ref></para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 125:1"/>Laguna ziara.</para>
  <para style="b" vid="PSA 125:1"/>
  <para style="q1" vid="PSA 125:1">Manga mia moparacaeana i KAWASANA OPU,</para>
  <para style="q2" vid="PSA 125:1">mboomo Gunu Sion momatangka tee inda amembali atohudha,</para>
  <para style="q2" vid="PSA 125:1">tee asadhaadhaa saʼumurua.<verse eid="PSA 125:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 125:2"/>Mboomo manga gunu ajagani Yerusalem,</para>
  <para style="q2" vid="PSA 125:2">mboomo uka KAWASANA OPU ajagani uumatina</para>
  <para style="q2" vid="PSA 125:2">pepuu sii-sii sakawana saʼumurua.<verse eid="PSA 125:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 125:3"/>Raja momadhaki inda bheakeni pamarintana saʼumurua</para>
  <para style="q2" vid="PSA 125:3">i lipuna manga mia mobanara,</para>
  <para style="q1" vid="PSA 125:3">mamudhaakana manga mia mobanara sumai inda aose</para>
  <para style="q2" vid="PSA 125:3">to apewau kadhaki.<verse eid="PSA 125:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 125:4"/>E KAWASANA OPU, maasangia upewau kalape i manga mia momalape,</para>
  <para style="q2" vid="PSA 125:4">tee i manga mia momakatena incana.<verse eid="PSA 125:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 125:5"/>Maka manga mia mosaladhala moosena dhalana karona mopekabelo-belo,</para>
  <para style="q2" vid="PSA 125:5">bheapadhencua KAWASANA OPU apobhawa tee manga mia mopewauna kadhaki.</para>
  <para style="b" vid="PSA 125:5"/>
  <para style="q2" vid="PSA 125:5">Amasanaamo miana Israel!<verse eid="PSA 125:5"/></para>
  <chapter eid="PSA 125"/>
  <chapter number="126" style="c" sid="PSA 126"/>
  <para style="s1">Kaharapu i nuncana Kanarakaa</para>
  <para style="sr">
    <ref loc="PSA 126:1-6">126:1-6</ref></para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 126:1"/>Laguna ziara.</para>
  <para style="b" vid="PSA 126:1"/>
  <para style="q1" vid="PSA 126:1">Wakutuuna KAWASANA OPU apambuli kadhaangiana Sion<note caller="+" style="f"><char style="fr" closed="false">126:1 </char><char style="fq" closed="false">Sion: </char><char style="ft" closed="false">Sarona mosagaanana to Kota Yerusalem.</char></note> amembali amalape pendua,</para>
  <para style="q2" vid="PSA 126:1">ingkita mboomo mia mopongipi.<verse eid="PSA 126:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 126:2"/>Wakutuu incia sumai o ngangata apotawa roonamo tamasanaa</para>
  <para style="q2" vid="PSA 126:2">tee o dhelata asambo-sambo roonamo takaunde-unde.</para>
  <para style="q1" vid="PSA 126:2">Sabutuna manga lipu mosagaanana apogau,</para>
  <para style="q2" vid="PSA 126:2">"KAWASANA OPU padhamo apewau giu momaoge to manga incia."<verse eid="PSA 126:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 126:3"/>KAWASANA OPU padhamo apewau giu momaoge to ingkita,</para>
  <para style="q2" vid="PSA 126:3">sababuna sumai takaunde-undemo.<verse eid="PSA 126:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 126:4"/>E KAWASANA OPU, maasangia upambulia pendua o kadhaangiamami momalape,</para>
  <para style="q2" vid="PSA 126:4">mboomo umala i Tana Negeb akouwe pendua i bulaana wao.<verse eid="PSA 126:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 126:5"/>Manga mia mohewina apoose atangi,</para>
  <para style="q2" vid="PSA 126:5">naile itu bheatimpu tee asambo-sambo.<verse eid="PSA 126:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 126:6"/>Mia molimbana minaaka i bhanua tee amaasi</para>
  <para style="q2" vid="PSA 126:6">apoose abhawa wine to ahewia,</para>
  <para style="q1" vid="PSA 126:6">dhaanamo bheambuli asambo-sambo</para>
  <para style="q2" vid="PSA 126:6">apoose abhawa hasilina timpuana.<verse eid="PSA 126:6"/></para>
  <chapter eid="PSA 126"/>
  <chapter number="127" style="c" sid="PSA 127"/>
  <para style="s1">Rahumatina Kawasana Opu Auwalina Kasalaamati</para>
  <para style="sr">
    <ref loc="PSA 127:1-5">127:1-5</ref></para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 127:1"/>Lagu ziarana Sulaiman.</para>
  <para style="b" vid="PSA 127:1"/>
  <para style="q1" vid="PSA 127:1">Ande mencuana KAWASANA OPU mopakarona bhanua,</para>
  <para style="q2" vid="PSA 127:1">asia-siamo kangulena mia mopakaroa.</para>
  <para style="q1" vid="PSA 127:1">Ande mencuana KAWASANA OPU mojaganina kota,</para>
  <para style="q2" vid="PSA 127:1">asia-siamo manga suludadu mojagania.<verse eid="PSA 127:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 127:2"/>Asia-siamo ubhangu saeona,</para>
  <para style="q2" vid="PSA 127:2">tee ukarajaa torotorosu inda uunto-unto sakawana pontanga malo,</para>
  <para style="q2" vid="PSA 127:2">tee ukande kinande ipotibhaakamu minaaka i kanguleana bukumu tee ulilaho;</para>
  <para style="q2" vid="PSA 127:2">roonamo Aulataʼala adhawu mia imaasiakana i wakutuuna akole.<verse eid="PSA 127:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 127:3"/>Satotuuna ana umane sumai o rahumati minaaka i KAWASANA OPU,</para>
  <para style="q2" vid="PSA 127:3">tee o antona kadhuma satotuuna saangu fahala.<verse eid="PSA 127:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 127:4"/>Mboomo anana pana i limana samia suludadu,</para>
  <para style="q2" vid="PSA 127:4">mboo sumaimo manga ana umane i wakutuuna amangura.<verse eid="PSA 127:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 127:5"/>Amasanaamo mia mopabukena</para>
  <para style="q2" vid="PSA 127:5">dhingkanana panana tee anana pana.</para>
  <para style="q1" vid="PSA 127:5">Incia inda bheapotibhaaka kaea,</para>
  <para style="q2" vid="PSA 127:5">wakutuuna apogau tee manga musuna i bhambana lawa kota.<verse eid="PSA 127:5"/></para>
  <chapter eid="PSA 127"/>
  <chapter number="128" style="c" sid="PSA 128"/>
  <para style="s">Rahumatina to Mobhawana Bhanua</para>
  <para style="sr">
    <ref loc="PSA 128:1-6">128:1-6</ref></para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 128:1"/>Laguna ziara.</para>
  <para style="b" vid="PSA 128:1"/>
  <para style="q1" vid="PSA 128:1">Amasanaamo o mia momaekana i KAWASANA OPU,</para>
  <para style="q2" vid="PSA 128:1">tee adhadhi aose parintana.<verse eid="PSA 128:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 128:2"/>Ingkoo bheukande minaaka i hasilina kanguleana bukumu;</para>
  <para style="q2" vid="PSA 128:2">ingkoo bheumasanaa, tee o dhadhimu bheamalape.<verse eid="PSA 128:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 128:3"/>Bhawinemu bheamembali mboomo puuna angguru mosuburu</para>
  <para style="q2" vid="PSA 128:3">i nuncana bhanuamu,</para>
  <para style="q1" vid="PSA 128:3">tee manga anamu mboomo tunana puuna zaitun</para>
  <para style="q2" vid="PSA 128:3">i saripina mejamu.<verse eid="PSA 128:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 128:4"/>Satotuuna, mboo sumaimo rahumati bheadhawuaka</para>
  <para style="q2" vid="PSA 128:4">to mia momaekana i KAWASANA OPU.<verse eid="PSA 128:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 128:5"/>Maasangia o KAWASANA OPU abarakatiko minaaka i Sion.</para>
  <para style="q2" vid="PSA 128:5">Maasangia ingkoo ukamata Yerusalem inda akakurangaaka opeopea</para>
  <para style="q2" vid="PSA 128:5">saʼumurua dhadhimu.<verse eid="PSA 128:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 128:6"/>Maasangia ingkoo ukamata manga opu-opuamu minaaka i manga anamu!</para>
  <para style="b" vid="PSA 128:6"/>
  <para style="q2" vid="PSA 128:6">Amasanaamo miana Israel!<verse eid="PSA 128:6"/></para>
  <chapter eid="PSA 128"/>
  <chapter number="129" style="c" sid="PSA 129"/>
  <para style="s">Aemani Kahukumu to Manga Musuna</para>
  <para style="sr">
    <ref loc="PSA 129:1-8">129:1-8</ref></para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 129:1"/>Laguna ziara.</para>
  <para style="b" vid="PSA 129:1"/>
  <para style="q1" vid="PSA 129:1">"Pepuu dhaangia kumangura amenturumo mpuu apanarakaaku manga musuku,"</para>
  <para style="q2" vid="PSA 129:1">taroakamo miana Israel apogau mboo sumai,<verse eid="PSA 129:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 129:2"/>"Pepuu dhaangia kumangura amenturumo mpuu apanarakaaku manga musuku,</para>
  <para style="q2" vid="PSA 129:2">maka manga incia inda amembali ataloaku.<verse eid="PSA 129:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 129:3"/>Manga incia apekambela awaaku mboomo tana ibhingkuni,</para>
  <para style="q2" vid="PSA 129:3">amaarate tee amandala o kambelana awaaku mboomo pande poinawu mobhingkunina tana.<verse eid="PSA 129:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 129:4"/>KAWASANA OPU abanara.</para>
  <para style="q2" vid="PSA 129:4">Incia padhamo atumpo rabuta ibhokena manga mia madhaki mamudhaakana mangarambasaka minaaka i kuasana mia madhaki.<verse eid="PSA 129:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 129:5"/>Taroakamo bhari-bharia mia mobancina Sion</para>
  <para style="q2" vid="PSA 129:5">asowo tee amaea.<verse eid="PSA 129:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 129:6"/>Taroakamo manga incia mboomo rumpu i bhawona padhana bhanua</para>
  <para style="q2" vid="PSA 129:6">amalau wakutuuna tangasaana atuwu;<verse eid="PSA 129:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 129:7"/>manga pande dhodhona gandum inda awelia,</para>
  <para style="q2" vid="PSA 129:7">tee manga pande bhokena timpua inda abhokea rampaakanamo rumpu sumai inda akoguna.<verse eid="PSA 129:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 129:8"/>Sabutuna manga mia molalo inda bheapogau,</para>
  <para style="q2" vid="PSA 129:8">"Maasangia abarakatiko KAWASANA OPU,</para>
  <para style="q1" vid="PSA 129:8">Ingkami tabarakatiko i nuncana sarona KAWASANA OPU."<verse eid="PSA 129:8"/></para>
  <chapter eid="PSA 129"/>
  <chapter number="130" style="c" sid="PSA 130"/>
  <para style="s">Doʼa i nuncana Kanarakaa</para>
  <para style="sr">
    <ref loc="PSA 130:1-8">130:1-8</ref></para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 130:1"/>Laguna ziara.</para>
  <para style="b" vid="PSA 130:1"/>
  <para style="q1" vid="PSA 130:1">Minaaka i mbolongana kanarakaa iaku kugoraakako, e KAWASANA OPU!<verse eid="PSA 130:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 130:2"/>E Kawasana Opu, maasangia urangoa o suaraku!</para>
  <para style="q2" vid="PSA 130:2">Taroakamo uperangoia opea iemaniku.<verse eid="PSA 130:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 130:3"/>E KAWASANA OPU, ande Ingkoo utorotorosu uudhani dosamami,</para>
  <para style="q2" vid="PSA 130:3">incema bhemomembalina abebasi minaaka i kahukumumu, e Aulataʼala?<verse eid="PSA 130:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 130:4"/>Maka Ingkoo sadia usiapu to upekaʼamponi,</para>
  <para style="q2" vid="PSA 130:4">mamudhaakana o mia amembali ahoromatiko.<verse eid="PSA 130:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 130:5"/>Iaku kuantagi katulungina KAWASANA OPU,</para>
  <para style="q2" vid="PSA 130:5">tee o janjina kuharapua.<verse eid="PSA 130:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 130:6"/>Ngangarandaku aharapuaka Kawasana Opu</para>
  <para style="q1" vid="PSA 130:6">alabhi minaaka i pande jagana kota mopemeliliakana akawa o wakutuuna matanaeo akotila.<verse eid="PSA 130:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 130:7"/>E Israel harapumo i KAWASANA OPU!</para>
  <para style="q2" vid="PSA 130:7">Roonamo KAWASANA OPU dhaangia tee kaasina molagina,</para>
  <para style="q1" vid="PSA 130:7">tee Incia sadia bheamangapasalaamati.<verse eid="PSA 130:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 130:8"/>
    <note caller="-" style="x">
      <char style="xo" closed="false">130:8 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 1:21">Mat. 1:21</ref>; <ref loc="TIT 2:14">Tit. 2:14</ref>.</char>
    </note>Incia bhemopabebasina Israel</para>
  <para style="q2" vid="PSA 130:8">minaaka i bhari-bharia kasalahana.<verse eid="PSA 130:8"/></para>
  <chapter eid="PSA 130"/>
  <chapter number="131" style="c" sid="PSA 131"/>
  <para style="s">Pasarakaaka Karota i KAWASANA OPU</para>
  <para style="sr">
    <ref loc="PSA 131:1-3">131:1-3</ref></para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 131:1"/>Laguna ziara. Zaburuna Daud.</para>
  <para style="b" vid="PSA 131:1"/>
  <para style="q1" vid="PSA 131:1">E KAWASANA OPU, iaku inda kusombo,</para>
  <para style="q2" vid="PSA 131:1">tee inda kupandaʼente mia.</para>
  <para style="q1" vid="PSA 131:1">Iaku inda kupajere manga hali</para>
  <para style="q2" vid="PSA 131:1">momaoge atawa manga giu inda momentela to karoku.<verse eid="PSA 131:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 131:2"/>Satotuuna, padhamo kupatanangi ngangarandaku,</para>
  <para style="q2" vid="PSA 131:2">mboomo anaana indamo adudu maka dhaangiapo i nuncana sangoana inana,</para>
  <para style="q2" vid="PSA 131:2">Umbe, ngangarandaku atanangimo mboomo anaana indamo adudu.<verse eid="PSA 131:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 131:3"/>E miana Israel, harapumo i KAWASANA OPU,</para>
  <para style="q2" vid="PSA 131:3">pepuu sii-sii sakawana saʼumurua.<verse eid="PSA 131:3"/></para>
  <chapter eid="PSA 131"/>
  <chapter number="132" style="c" sid="PSA 132"/>
  <para style="s">Raja Daud tee Kota Sion, Ipilina KAWASANA OPU</para>
  <para style="sr">
    <ref loc="PSA 132:1-18">132:1-18</ref></para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 132:1"/>Laguna ziara.</para>
  <para style="b" vid="PSA 132:1"/>
  <para style="q1" vid="PSA 132:1">E KAWASANA OPU, maasangia uudhani Daud,</para>
  <para style="q2" vid="PSA 132:1">tee bhari-bharia kanarakaana inamisina.<verse eid="PSA 132:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 132:2"/>Incia padhamo aposumpa i KAWASANA OPU,</para>
  <para style="q2" vid="PSA 132:2">tee ajanji i Aulataʼala Momakaa isombana Yakub,<verse eid="PSA 132:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 132:3"/>"Satotuuna, iaku inda bhekupesua i nuncana kema mbooresaku</para>
  <para style="q2" vid="PSA 132:3">atawa kukole i kolemaku;<verse eid="PSA 132:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 132:4"/>Satotuuna inda bhekutokole</para>
  <para style="q2" vid="PSA 132:4">atawa amangkoo mataku<verse eid="PSA 132:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 132:5"/>ande indapo kupotibhaaka tampa to KAWASANA OPU,</para>
  <para style="q2" vid="PSA 132:5">tee saangu mbooresa to Aulataʼala Momakaa isombana Yakub."<verse eid="PSA 132:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 132:6"/>Satotuuna, ingkita padhamo tarangoa o pokaiana tee Sorongana Pojanjia<note caller="+" style="f"><char style="fr" closed="false">132:6 </char><char style="fq" closed="false">Sorongana Pojanjia: </char><char style="ft" closed="false">Sorongana kau motandaina umbaana Aulataʼala i tanga-tangana uumatina tee amembali tampana to adhika rua katongkana bhatu mokoantona sapulu firimanina Aulataʼala idhawuakana i Nabii Musa (kamata </char><char style="xt"><ref loc="EXO 20:1-17">Limb. 20:1-17</ref>; <ref loc="EXO 31:18">31:18</ref></char>). </note> sumai i Bait Lahim,</para>
  <para style="q2" vid="PSA 132:6">tee padhamo tapotibhaakea i Tana Yaar.<note caller="+" style="f"><char style="fr" closed="false">132:6 </char><char style="fq" closed="false">tapotibhaakea i Tana Yaar: </char><char style="ft" closed="false">Zaburu incia sii apogauaka kajadia wakutuuna Daud amembali raja tee abhawa Soronga Pojanjia minaaka i Tana Yaar sakawana i Yerusalem.</char></note><verse eid="PSA 132:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 132:7"/>Maimo talingkaaka i mbooresana i Yerusalem!</para>
  <para style="q2" vid="PSA 132:7">Maimo tasuju tee tasombaia i aroana kauncuramakana.<verse eid="PSA 132:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 132:8"/>E KAWASANA OPU, pekadheimo ulingka i tampa mbooresamu,</para>
  <para style="q2" vid="PSA 132:8">tee upobhawa tee Soronga Pojanjia, tandana Ingkoo ukokuasa.<verse eid="PSA 132:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 132:9"/>Maasangia manga imamu sadia apewau kabanara,</para>
  <para style="q2" vid="PSA 132:9">tee taroakamo manga mia mosaalihi asambo-sambo tee akaunde-unde.<verse eid="PSA 132:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 132:10"/>Roonamo Daud, o bhatuamu,</para>
  <para style="q2" vid="PSA 132:10">bholi umendeua o raja mopadhana ilantimu.<verse eid="PSA 132:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 132:11"/>KAWASANA OPU padhamo aposumpa mpuu-mpuu tee Daud,</para>
  <para style="q2" vid="PSA 132:11">tee Incia inda bheamalinguaka opea ijanjiakana,</para>
  <para style="q1" vid="PSA 132:11">"Samia anamu minaaka i karomu</para>
  <para style="q2" vid="PSA 132:11">bhekupamembalia raja."<verse eid="PSA 132:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 132:12"/>Ande manga anamu akeniakea mpuu-mpuu o pojanjiaku</para>
  <para style="q2" vid="PSA 132:12">tee ataʼatia manga parinta bheiadhariakaku to manga incia,</para>
  <para style="q1" vid="PSA 132:12">sumaimo manga opu-opuana uka bheamembali raja</para>
  <para style="q2" vid="PSA 132:12">sakawana saʼumurua."<verse eid="PSA 132:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 132:13"/>KAWASANA OPU padhamo apili Sion,</para>
  <para style="q2" vid="PSA 132:13">tee gauna apamembalia tampana mbooresana.<verse eid="PSA 132:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 132:14"/>"Siimo mbooresaku sakawana saʼumurua,</para>
  <para style="q2" vid="PSA 132:14">Iwe siimo bhekumboore roonamo kupeelua.<verse eid="PSA 132:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 132:15"/>Iaku bhekudhawuakea bhaku motaralabhi-labhi,</para>
  <para style="q2" vid="PSA 132:15">tee bhekupekambosuakea tee roti manga mia misikini.<verse eid="PSA 132:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 132:16"/>Manga imamuna Yerusalem bheasusuaka kasalaamati moumbana minaaka i Iaku,</para>
  <para style="q2" vid="PSA 132:16">tee manga mia mosaalihi bheasambo-sambo tee akaunde-unde.<verse eid="PSA 132:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 132:17"/>Iwe sumakomo bhekuangka siwuluna Daud;</para>
  <para style="q2" vid="PSA 132:17">Iaku bhekupamembali o siwuluna aparinta sakawana saʼumurua mboomo sulu momainawana torosu.<verse eid="PSA 132:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 132:18"/>Manga musuna bhekupekaeaia,</para>
  <para style="q2" vid="PSA 132:18">maka incia, bhekupakanaakea mahakota bhemokakila-kila i bhaana."<verse eid="PSA 132:18"/></para>
  <chapter eid="PSA 132"/>
  <chapter number="133" style="c" sid="PSA 133"/>
  <para style="s1">Powitinai Mopomalape</para>
  <para style="sr">
    <ref loc="PSA 133:1-3">133:1-3</ref></para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 133:1"/>Laguna ziara. Zaburuna Daud.</para>
  <para style="b" vid="PSA 133:1"/>
  <para style="q1" vid="PSA 133:1">Kamatea, tapanamo kalape tee kangada</para>
  <para style="q2" vid="PSA 133:1">ande manga witinai adhadhi apomaamaasiaka.<verse eid="PSA 133:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 133:2"/>Giu incia sumai mboomo mina-mina mawondu mokoharagaa i bhawona bhaa,</para>
  <para style="q2" vid="PSA 133:2">asiwulu apekabhaho jangku,</para>
  <para style="q1" vid="PSA 133:2">i jangkuna Harun,</para>
  <para style="q2" vid="PSA 133:2">kasiimpo asapo sakawana i bhorokona jubana.<verse eid="PSA 133:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 133:3"/>Giu incia sumai mboomo alo i Gunu Hermon,</para>
  <para style="q2" vid="PSA 133:3">mosapona i bhawona manga gunu i Sion</para>
  <para style="q1" vid="PSA 133:3">roonamo iwe sumakomo KAWASANA OPU apasapo barakatina,</para>
  <para style="q2" vid="PSA 133:3">siitumo dhadhi to saʼumurua.<verse eid="PSA 133:3"/></para>
  <chapter eid="PSA 133"/>
  <chapter number="134" style="c" sid="PSA 134"/>
  <para style="s1">Lagu Kapujia i Wakutuuna Amalo</para>
  <para style="sr">
    <ref loc="PSA 134:1-3">134:1-3</ref></para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 134:1"/>Laguna ziara.</para>
  <para style="b" vid="PSA 134:1"/>
  <para style="q1" vid="PSA 134:1">Mai, pujimo KAWASANA OPU, e bhari-bharia bhatuana KAWASANA OPU</para>
  <para style="q2" vid="PSA 134:1">molaianina i Bhanuana KAWASANA OPU i wakutuuna amalo!<verse eid="PSA 134:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 134:2"/>Angkamea o limamiu upaporopea i tampa momangkilo,</para>
  <para style="q2" vid="PSA 134:2">tee upujimo KAWASANA OPU!<verse eid="PSA 134:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 134:3"/>Maasangia KAWASANA OPU, siitumo Incia mopadhaangiana laiana tee alamu,</para>
  <para style="q2" vid="PSA 134:3">abarakatiko minaaka i Sion.<verse eid="PSA 134:3"/></para>
  <chapter eid="PSA 134"/>
  <chapter number="135" style="c" sid="PSA 135"/>
  <para style="s1">Tangkanamo Kawasana Opu Molaengana Ipuji</para>
  <para style="sr">
    <ref loc="PSA 135:1-21">135:1-21</ref></para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 135:1"/>Pujimo KAWASANA OPU!<note caller="+" style="f"><char style="fr" closed="false">135:1 </char><char style="fq" closed="false">Pujimo KAWASANA OPU!</char><char style="ft" closed="false">I nuncana pogau Ibrani, oni incia sii </char><char style="it">Haleluya</char>. Mboo sumai uka i kapadhaana zaburu incia sii.</note></para>
  <para style="b" vid="PSA 135:1"/>
  <para style="q1" vid="PSA 135:1">Pujimo sarona KAWASANA OPU!</para>
  <para style="q2" vid="PSA 135:1">Pujimea, e manga bhatuana KAWASANA OPU,<verse eid="PSA 135:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 135:2"/>e manga mia molaianina i Bhanuana KAWASANA OPU</para>
  <para style="q2" vid="PSA 135:2">i tanalapa i aroana Bhanuana Aulataʼalata.<verse eid="PSA 135:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 135:3"/>Pujimo KAWASANA OPU roonamo Incia amalape,</para>
  <para style="q2" vid="PSA 135:3">laguakamea manga lagu kapujia to sarona,</para>
  <para style="q2" vid="PSA 135:3">roonamo sarona amakesa.<verse eid="PSA 135:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 135:4"/>KAWASANA OPU padhamo apili Yakub to karona,</para>
  <para style="q2" vid="PSA 135:4">tee o miana Israel apamembalia pewauana imaasiakana.<verse eid="PSA 135:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 135:5"/>Satotuuna kumataua ande o KAWASANA OPU amaoge mpuu,</para>
  <para style="q2" vid="PSA 135:5">tee o Aulataʼalata alabhi o kaogena minaaka i bhari-bharia dewa.<verse eid="PSA 135:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 135:6"/>KAWASANA OPU apewau opea ipeeluna,</para>
  <para style="q2" vid="PSA 135:6">malape i sorogaa atawa i alamu,</para>
  <para style="q2" vid="PSA 135:6">malape i tawo atawa i andala.<verse eid="PSA 135:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 135:7"/>Incia aumbaaka gawu minaaka i tapana alamu,</para>
  <para style="q2" vid="PSA 135:7">Incia apatiumba bhibhito apoose tee wao,</para>
  <para style="q2" vid="PSA 135:7">tee apalimba ngalu minaaka i tampana atodhika.<verse eid="PSA 135:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 135:8"/>
    <note caller="-" style="x">
      <char style="xo" closed="false">135:8 </char>
      <char style="xt" closed="false">
        <ref loc="EXO 12:28-30">Limb. 12:28-30</ref>.</char>
    </note>Incia mopekamatena manga anaana tumpe i Mesir,</para>
  <para style="q2" vid="PSA 135:8">malape maanusia atawa o binata.<verse eid="PSA 135:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 135:9"/>Incia mopadhaangiana manga tanda tee manga muuzizati</para>
  <para style="q2" vid="PSA 135:9">i tanga-tangana miana Mesir,</para>
  <para style="q2" vid="PSA 135:9">aewangi Firaun tee bhari-bharia pagawena.<verse eid="PSA 135:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 135:10"/>Incia mopekatalona manga lipu</para>
  <para style="q2" vid="PSA 135:10">tee apekamate manga raja momakaa--<verse eid="PSA 135:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 135:11"/>siitumo Sihon rajana Amori, tee Og rajana Basan,</para>
  <para style="q2" vid="PSA 135:11">tee bhari-bharia raja i Kanaan.<verse eid="PSA 135:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 135:12"/>Kasiimpo adhawuaka manga lipuna Kanaan to apamembalia pusaka,</para>
  <para style="q2" vid="PSA 135:12">siitumo o pusaka to miana Israel o uumatina sumai.<verse eid="PSA 135:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 135:13"/>E KAWASANA OPU, saromu abakaa,</para>
  <para style="q2" vid="PSA 135:13">e KAWASANA OPU, bhari-bharia siwulu bheaudania saʼumurua opea ipewaumu.<verse eid="PSA 135:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 135:14"/>KAWASANA OPU bheaewaaka parakarana uumatina,</para>
  <para style="q2" vid="PSA 135:14">tee amaasiaka manga bhatuana.<verse eid="PSA 135:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 135:15"/>
    <note caller="-" style="x">
      <char style="xo" closed="false">135:15-18 </char>
      <char style="xt" closed="false">
        <ref loc="PSA 115:4-8">Zab. 115:4-8</ref>; <ref loc="REV 9:20">Wah. 9:20</ref>.</char>
    </note>Barahalana manga lipu inda mosombako atokarajaa minaaka i bulawa tee pera,</para>
  <para style="q2" vid="PSA 135:15">ikarajaana limana maanusia.<verse eid="PSA 135:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 135:16"/>Manga barahala sumai akomuncu, maka inda amembali apogau;</para>
  <para style="q2" vid="PSA 135:16">akomata, maka inda apokamata;<verse eid="PSA 135:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 135:17"/>akotalinga, maka inda aporango.</para>
  <para style="q2" vid="PSA 135:17">Manga incia inda dhaangia o poinuncana.<verse eid="PSA 135:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 135:18"/>Bhari-bharia mia mokarajaana barahala tee bhari-bharia moparacaeaia</para>
  <para style="q2" vid="PSA 135:18">bheamembali mboomo barahala sumai tee inda bheamembali apewau opeopea uka.<verse eid="PSA 135:18"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 135:19"/>E siwuluna Israel, pekaogemo sarona KAWASANA OPU!</para>
  <para style="q2" vid="PSA 135:19">E manga imamu, siwuluna Harun, pekaogemo sarona KAWASANA OPU!<verse eid="PSA 135:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 135:20"/>E siwuluna Lewi, pekaogemo sarona KAWASANA OPU!</para>
  <para style="q2" vid="PSA 135:20">E manga mia momaekana i KAWASANA OPU, pekaogemo sarona KAWASANA OPU!<verse eid="PSA 135:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 135:21"/>Pekaogemo sarona KAWASANA OPU minaaka i Sion;</para>
  <para style="q2" vid="PSA 135:21">Incia momboorena i Yerusalem.<note caller="+" style="f"><char style="fr" closed="false">135:21 </char><char style="fq" closed="false">Incia momboorena i Yerusalem: </char><char style="ft" closed="false">Moomini o Aulataʼala adhaangia i saangua alamu sii, maka Incia padhamo apatotapuaka Kota Yerusalem minaaka i zamanina Israel apamembalia to Bhanua Momangkilo to apogauaka umbaana tee ajagani sarona.</char></note></para>
  <para style="b" vid="PSA 135:21"/>
  <para style="q2" vid="PSA 135:21">Pujimo KAWASANA OPU!<verse eid="PSA 135:21"/></para>
  <chapter eid="PSA 135"/>
  <chapter number="136" style="c" sid="PSA 136"/>
  <para style="s1">Kaasina Kawasana Opu to Miana Israel</para>
  <para style="sr">
    <ref loc="PSA 136:1-26">136:1-26</ref></para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 136:1"/>
    <note caller="-" style="x">
      <char style="xo" closed="false">136:1 </char>
      <char style="xt" closed="false">
        <ref loc="PSA 100:4-5">Zab. 100:4-5</ref>.</char>
    </note>Sukurumo i KAWASANA OPU, roonamo Incia amalape,</para>
  <para style="q2" vid="PSA 136:1">kaasina abakaa saʼumurua.<verse eid="PSA 136:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 136:2"/>Sukurumo i Aulataʼalana sagala Aulataʼala,</para>
  <para style="q2" vid="PSA 136:2">kaasina abakaa saʼumurua.<verse eid="PSA 136:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 136:3"/>Sukurumo i Kawasana Opuna sagala opu,</para>
  <para style="q2" vid="PSA 136:3">kaasina abakaa saʼumurua.<verse eid="PSA 136:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 136:4"/>Incia mopewauna manga giu inda momentela,</para>
  <para style="q2" vid="PSA 136:4">kaasina abakaa saʼumurua.<verse eid="PSA 136:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 136:5"/>
    <note caller="-" style="x">
      <char style="xo" closed="false">136:5-6 </char>
      <char style="xt" closed="false">
        <ref loc="GEN 1:1-2">Bhaa. 1:1-2</ref>.</char>
    </note>Incia mopadhaangiana laiana tee kalapena budina,</para>
  <para style="q2" vid="PSA 136:5">kaasina abakaa saʼumurua.<verse eid="PSA 136:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 136:6"/>Incia mobhakesakana ati i bhawona uwe,</para>
  <para style="q2" vid="PSA 136:6">kaasina abakaa saʼumurua.<verse eid="PSA 136:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 136:7"/>
    <note caller="-" style="x">
      <char style="xo" closed="false">136:7-9 </char>
      <char style="xt" closed="false">
        <ref loc="GEN 1:16">Bhaa. 1:16</ref>. </char>
    </note>Incia mopadhaangiana manga kainawa momaogena i laiana,</para>
  <para style="q2" vid="PSA 136:7">kaasina abakaa saʼumurua;<verse eid="PSA 136:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 136:8"/>matanaeo to akuasai eo,</para>
  <para style="q2" vid="PSA 136:8">kaasina abakaa saʼumurua;<verse eid="PSA 136:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 136:9"/>bula tee kalipopo to akuasai malo,</para>
  <para style="q2" vid="PSA 136:9">kaasina abakaa saʼumurua.<verse eid="PSA 136:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 136:10"/>
    <note caller="-" style="x">
      <char style="xo" closed="false">136:10 </char>
      <char style="xt" closed="false">
        <ref loc="EXO 12:29">Limb. 12:29</ref>.</char>
    </note>Incia mopekamatena manga anaana tumpe i Mesir,</para>
  <para style="q2" vid="PSA 136:10">kaasina abakaa saʼumurua;<verse eid="PSA 136:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 136:11"/>
    <note caller="-" style="x">
      <char style="xo" closed="false">136:11 </char>
      <char style="xt" closed="false">
        <ref loc="EXO 12:51">Limb. 12:51</ref>.</char>
    </note>tee o miana Israel apalimbaia minaaka i Mesir,</para>
  <para style="q2" vid="PSA 136:11">kaasina abakaa saʼumurua;<verse eid="PSA 136:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 136:12"/>tee limana momakaa tee kuasana momaoge,</para>
  <para style="q2" vid="PSA 136:12">kaasina abakaa saʼumurua.<verse eid="PSA 136:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 136:13"/>
    <note caller="-" style="x">
      <char style="xo" closed="false">136:13-15 </char>
      <char style="xt" closed="false">
        <ref loc="EXO 14:21-29">Limb. 14:21-29</ref>.</char>
    </note>Incia aweta Tawo Towu Lambe apaporuawetaia,</para>
  <para style="q2" vid="PSA 136:13">kaasina abakaa saʼumurua;<verse eid="PSA 136:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 136:14"/>tee apapolimba miana Israel adhala i tanga-tangana,</para>
  <para style="q2" vid="PSA 136:14">kaasina abakaa saʼumurua;<verse eid="PSA 136:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 136:15"/>maka Incia apatondu Firaun tee tantarana i nuncana Tawo Towu Lambe,</para>
  <para style="q2" vid="PSA 136:15">kaasina abakaa saʼumurua.<verse eid="PSA 136:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 136:16"/>Incia akapalai uumatina alaloi tana matuu,</para>
  <para style="q2" vid="PSA 136:16">kaasina abakaa saʼumurua.<verse eid="PSA 136:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 136:17"/>Incia apekatalo manga raja momakaa,</para>
  <para style="q2" vid="PSA 136:17">kaasina abakaa saʼumurua;<verse eid="PSA 136:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 136:18"/>tee apekamate manga raja momulia,</para>
  <para style="q2" vid="PSA 136:18">kaasina abakaa saʼumurua;<verse eid="PSA 136:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 136:19"/>siitumo Sihon, rajana miana Amori,</para>
  <para style="q2" vid="PSA 136:19">kaasina abakaa saʼumurua;<verse eid="PSA 136:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 136:20"/>tee Og, rajana Basan,</para>
  <para style="q2" vid="PSA 136:20">kaasina abakaa saʼumurua;<verse eid="PSA 136:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 136:21"/>tee adhawuakea o lipuna manga incia apamembalia pusakana uumatina,</para>
  <para style="q2" vid="PSA 136:21">kaasina abakaa saʼumurua;<verse eid="PSA 136:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 136:22"/>amembali pusaka to miana Israel o bhatuana sumai,</para>
  <para style="q2" vid="PSA 136:22">kaasina abakaa saʼumurua.<verse eid="PSA 136:22"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 136:23"/>Incia inda mangamalinguaka wakutuuna tee masaʼalata,</para>
  <para style="q2" vid="PSA 136:23">kaasina abakaa saʼumurua;<verse eid="PSA 136:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 136:24"/>tee mangarambasaka minaaka i limana musu,</para>
  <para style="q2" vid="PSA 136:24">kaasina abakaa saʼumurua.<verse eid="PSA 136:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 136:25"/>Incia mopakandena bhari-bharia mahaluku,</para>
  <para style="q2" vid="PSA 136:25">kaasina abakaa saʼumurua.<verse eid="PSA 136:25"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 136:26"/>Sukurumo i Aulataʼala moparintana i laiana,</para>
  <para style="q2" vid="PSA 136:26">kaasina abakaa saʼumurua.<verse eid="PSA 136:26"/></para>
  <chapter eid="PSA 136"/>
  <chapter number="137" style="c" sid="PSA 137"/>
  <para style="s1">Kaporona Inca i Bhiwina Umala Babel</para>
  <para style="sr">
    <ref loc="PSA 137:1-9">137:1-9</ref></para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 137:1"/>I bhiwina umala Babel,</para>
  <para style="q2" vid="PSA 137:1">iwe sumakomo ingkami tauncura tee tatangi</para>
  <para style="q2" vid="PSA 137:1">ande taudhani Sion, mbooresana miana Israel.<verse eid="PSA 137:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 137:2"/>I manga puuna gandarusa i tampa sumai,</para>
  <para style="q2" vid="PSA 137:2">ingkami tapaloe kecapimami<verse eid="PSA 137:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 137:3"/>roonamo iwe sumai manga miana Babel mangataangi</para>
  <para style="q2" vid="PSA 137:3">tee atumpu ingkami talaguakea,</para>
  <para style="q1" vid="PSA 137:3">mia mopisakina ingkami manga tumpu talaguakea manga lagu kaunde-unde, pogauna,</para>
  <para style="q2" vid="PSA 137:3">"Laguakamo to ingkami sala saangu lagu minaaka i Sion."<verse eid="PSA 137:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 137:4"/>Tuaapa amembali ingkami talaguaka lagu to KAWASANA OPU</para>
  <para style="q2" vid="PSA 137:4">i lipu dhaga?<verse eid="PSA 137:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 137:5"/>E Yerusalem, ande kumalinguakako,</para>
  <para style="q2" vid="PSA 137:5">taroakamo limaku indamo amembali amagasiaaka kecapi!<verse eid="PSA 137:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 137:6"/>Taroakamo dhelaku indamo amembali alagu</para>
  <para style="q2" vid="PSA 137:6">ande kumalinguakako,</para>
  <para style="q1" vid="PSA 137:6">tee ande inda kupamembali Yerusalem</para>
  <para style="q2" vid="PSA 137:6">tampa ikaunde-undeakaku mpuu.<verse eid="PSA 137:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 137:7"/>E KAWASANA OPU, udhania o miana Edom,</para>
  <para style="q2" vid="PSA 137:7">i wakutuuna Yerusalem atopahancuru, manga incia apogau,</para>
  <para style="q2" vid="PSA 137:7">"Patobhatamea! Patobhatamea sakawana i tana!"<verse eid="PSA 137:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 137:8"/>E raʼeatina Babel, ingkomiu bheutopabinasa!</para>
  <para style="q2" vid="PSA 137:8">Amasanaamo mia mobalasina ingkomiu</para>
  <para style="q2" vid="PSA 137:8">roonamo pewaumu momadhaki i ingkami.<verse eid="PSA 137:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 137:9"/>Amasanaamo mia morakona manga anaana maidhiidhimiu</para>
  <para style="q2" vid="PSA 137:9">tee arambitakea i bhatu!<note caller="+" style="f"><char style="fr" closed="false">137:9 </char><char style="fq" closed="false">Amasanaamo mia morakona manga anaana maidhiidhimiu: </char><char style="ft" closed="false">Rua giu molaengana imatau. Bhaa-bhaana, manga lipu modhaangiana i saripina lipu Israel padhamo apewau giu mopokana to miana Israel. Sapadhana sumai, Kawasana Opu afirimani ande o Babel bheanamisi giu mopokana to amembali kabalasina pewauna manga incia. </char></note><verse eid="PSA 137:9"/></para>
  <chapter eid="PSA 137"/>
  <chapter number="138" style="c" sid="PSA 138"/>
  <para style="s1">Doʼana Kasukuru roonamo Katulungina KAWASANA OPU</para>
  <para style="sr">
    <ref loc="PSA 138:1-8">138:1-8</ref></para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 138:1"/>Zaburuna Daud.</para>
  <para style="b" vid="PSA 138:1"/>
  <para style="q1" vid="PSA 138:1">Iaku bhekusukuru i Ingkoo, E KAWASANA OPU, tee mpuu-mpuuna incaku.</para>
  <para style="q1" vid="PSA 138:1">Iaku bhekulaguaka manga lagu kapujia to Ingkoo i aroana manga malaaʼekati.<verse eid="PSA 138:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 138:2"/>Iaku bhekusuju tee kusomba kupoaro i Bhanuamu momangkilo</para>
  <para style="q2" vid="PSA 138:2">tee kusukuru poose kupuji saromu</para>
  <para style="q1" vid="PSA 138:2">roonamo kaasimu molagina tee umembali utoparacaea,</para>
  <para style="q2" vid="PSA 138:2">sababuna Ingkoo padhamo ususuaka saromu tee janjimu alabhi minaaka i opeopeapo uka.<verse eid="PSA 138:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 138:3"/>I eona kugora, Ingkoo ulawaniaku,</para>
  <para style="q2" vid="PSA 138:3">tee Ingkoo upekatangka incaku tee kakaamu.<verse eid="PSA 138:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 138:4"/>Bhari-bharia raja i alamu bheapuji Ingkoo, e KAWASANA OPU,</para>
  <para style="q2" vid="PSA 138:4">roonamo manga incia padhamo arangoa manga janji ipakawaakamu.<verse eid="PSA 138:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 138:5"/>Manga incia bhealaguaka opea mopadhana ipewauna KAWASANA OPU</para>
  <para style="q2" vid="PSA 138:5">roonamo amaoge o kamuliangina KAWASANA OPU.<verse eid="PSA 138:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 138:6"/>Moomini KAWASANA OPU sumai amalanga, maka Incia akamata mia momaidhiidhi,</para>
  <para style="q2" vid="PSA 138:6">sainamo mia mosombo akamatea minaaka i karidhoana.<verse eid="PSA 138:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 138:7"/>Moomini kudhadhi i nuncana kanarakaa,</para>
  <para style="q2" vid="PSA 138:7">Ingkoo upotaangiaka dhadhiku;</para>
  <para style="q1" vid="PSA 138:7">Ingkoo upaulu limamu to ubhali pamuruna manga musuku,</para>
  <para style="q2" vid="PSA 138:7">tee o lima kaanamu mopasalaamatiaku.<verse eid="PSA 138:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 138:8"/>KAWASANA OPU bheapamando haejatina to dhadhiku;</para>
  <para style="q2" vid="PSA 138:8">E KAWASANA OPU, kaasimu abakaa saʼumurua;</para>
  <para style="q2" vid="PSA 138:8">bholi uunto upewau sagala giu mopadhana ipewaumu to uumatimu.<verse eid="PSA 138:8"/></para>
  <chapter eid="PSA 138"/>
  <chapter number="139" style="c" sid="PSA 139"/>
  <para style="s1">Doʼa i Aroana Kawasana Opu Momatauna Sagala Giu</para>
  <para style="sr">
    <ref loc="PSA 139:1-24">139:1-24</ref></para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 139:1"/>To kapalana molaguna. Zaburuna Daud.</para>
  <para style="b" vid="PSA 139:1"/>
  <para style="q1" vid="PSA 139:1">E KAWASANA OPU, Ingkoo utilikiaku tee umatauaku.<verse eid="PSA 139:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 139:2"/>Ingkoo umataua bhari-bharia ipewauku,</para>
  <para style="q2" vid="PSA 139:2">tee Ingkoo umatau opea ifikiriku minaaka i karidhoana.<verse eid="PSA 139:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 139:3"/>Ingkoo utilikiaku wakutuuna kulingka tee kupotidhole,</para>
  <para style="q2" vid="PSA 139:3">tee umataua bhari-bharia lingkaaku.<verse eid="PSA 139:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 139:4"/>Moomini indapo kupogau,</para>
  <para style="q2" vid="PSA 139:4">satotuuna Ingkoo umataumea bhari-bharia bheipogauakaku, e KAWASANA OPU.<verse eid="PSA 139:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 139:5"/>Ingkoo ujaganiaku minaaka i bhari-bharia singku,</para>
  <para style="q2" vid="PSA 139:5">tee ujaganiaku tee kuasamu.<verse eid="PSA 139:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 139:6"/>Tee katau incia sumai inda amentela mpuu to karoku,</para>
  <para style="q2" vid="PSA 139:6">tee inda akawa i fikiriku sababuna amalanga mpuu.<verse eid="PSA 139:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 139:7"/>Iapai bhekulingka mamudhaakana kumaridho minaaka i rohimu?</para>
  <para style="q2" vid="PSA 139:7">Iapai bhekupalai mamudhaakana kumaridho minaaka i karomu?<verse eid="PSA 139:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 139:8"/>Ande kupene i laiana, Ingkoo dhaangia iwe sumai.</para>
  <para style="q2" vid="PSA 139:8">Ande kukole i duniana mia mate, iwe sumai uka Ingkoo udhaangia.<verse eid="PSA 139:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 139:9"/>Ande kupene i laiana kupolaka tee panina matana eo wakutuuna abhete,</para>
  <para style="q2" vid="PSA 139:9">tee kumboore i tampana matanaeo atondu,<verse eid="PSA 139:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 139:10"/>iwe sumai Ingkoo upobhawa tee iaku,</para>
  <para style="q2" vid="PSA 139:10">tee o lima kaanamu bhemopekatangkaaku.<verse eid="PSA 139:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 139:11"/>Ande kupogau, "Satotuuna o kalalanda bheasalibumbungiaku,</para>
  <para style="q2" vid="PSA 139:11">tee o kainawa i saripiku bheamembali kalalanda,"<verse eid="PSA 139:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 139:12"/>sumaimo o kalalanda uabhia mencuana giu momalalanda to Ingkoo,</para>
  <para style="q2" vid="PSA 139:12">tee o malo mboomo kainawana pontanga eo,</para>
  <para style="q2" vid="PSA 139:12">roonamo kalalanda uabhia mboomo kainawa to karomu.<verse eid="PSA 139:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 139:13"/>Roonamo Ingkoo mopadhaangiana bhari-bharia parewana badaku;</para>
  <para style="q2" vid="PSA 139:13">Ingkoo mopebhanguiaku i nuncana kadhumana inaku.<verse eid="PSA 139:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 139:14"/>Iaku kusukuru i Ingkoo roonamo upadhaangiaaku tee cara inda momentela.</para>
  <para style="q2" vid="PSA 139:14">Bhari-bharia ipewaumu inda amentela,</para>
  <para style="q2" vid="PSA 139:14">tee atotuu-totuu kumataua o giu incia sumai.<verse eid="PSA 139:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 139:15"/>Manga bukuku ukamatea,</para>
  <para style="q2" vid="PSA 139:15">wakutuuna upadhaangiaaku i tampa rahasia,</para>
  <para style="q2" vid="PSA 139:15">tee upebhanguiaku i wetana alamu moporitambena mpuu.<verse eid="PSA 139:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 139:16"/>Ingkoo ukamataaku wakutuu dhaangiapo kumembali satongka raa,</para>
  <para style="q2" vid="PSA 139:16">tee i nuncana kitabimu bhari-bharia giu incia sumai padhamo atoburi</para>
  <para style="q1" vid="PSA 139:16">to eo-eona mopadhana ipatantuakamu to iaku</para>
  <para style="q2" vid="PSA 139:16">wakutuuna indapo aumba saangu eo minaaka i manga incia.<verse eid="PSA 139:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 139:17"/>Amarasai mpuu o fikirimu, e Aulataʼala, soo mpuu amarasai kumaʼanaia!</para>
  <para style="q2" vid="PSA 139:17">Abhari mpuu o fikirimu!<verse eid="PSA 139:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 139:18"/>Ande amembali kugagaria,</para>
  <para style="q2" vid="PSA 139:18">kabharina alabhi minaaka i kabharina bhone,</para>
  <para style="q2" vid="PSA 139:18">tee wakutuuna kuunto kugagaria,</para>
  <para style="q2" vid="PSA 139:18">iaku dhaangiapo uka kupobhawa tee Ingkoo.<verse eid="PSA 139:18"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 139:19"/>E Aulataʼala, maasangia Ingkoo upabinasa manga mia madhaki,</para>
  <para style="q2" vid="PSA 139:19">tee upekaridhoakaaku manga pande pekamatena mia!<verse eid="PSA 139:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 139:20"/>Manga incia apogauakako madhaki,</para>
  <para style="q2" vid="PSA 139:20">tee asia-sia asomboaka karona to aewangiko.<verse eid="PSA 139:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 139:21"/>E KAWASANA OPU, kubancia o mia mobanciko,</para>
  <para style="q2" vid="PSA 139:21">kumarikaia o mia moewangiko!<verse eid="PSA 139:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 139:22"/>Manga incia kubancia! Kubancia mpuu</para>
  <para style="q2" vid="PSA 139:22">tee kuabhia mboomo musu!<verse eid="PSA 139:22"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 139:23"/>E Aulataʼala, parakisaakumo tee umataumo ngangarandaku;</para>
  <para style="q2" vid="PSA 139:23">ujiakumo tee umataumea o fikiriku.<verse eid="PSA 139:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 139:24"/>Kamatamea ara dhaangia o kadhaki<note caller="+" style="f"><char style="fr" closed="false">139:24 </char><char style="fq" closed="false">kadhaki: </char><char style="ft" closed="false">Atawa uka "giu mopekapiina." </char></note> i nuncana karoku,</para>
  <para style="q2" vid="PSA 139:24">tee ususuakaakumo dhala mobakaa.<verse eid="PSA 139:24"/></para>
  <chapter eid="PSA 139"/>
  <chapter number="140" style="c" sid="PSA 140"/>
  <para style="s">Doʼa Emaniana Peulusa minaaka i Manga Mia Madhaki</para>
  <para style="sr">
    <ref loc="PSA 140:1-14">140:1-14</ref></para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 140:1"/>To kapalana molaguna. Zaburuna Daud.<verse eid="PSA 140:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 140:2"/>E KAWASANA OPU, maasangia</para>
  <para style="q1" vid="PSA 140:2">utulungiaku minaaka i mia madhaki,</para>
  <para style="q2" vid="PSA 140:2">tee ujaganiaku minaaka i mia masega.<verse eid="PSA 140:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 140:3"/>Manga incia ahaejatiaka kadhaki i nuncana ngangarandana,</para>
  <para style="q2" vid="PSA 140:3">tee saesaeo apadhaangia manga potimbea.<verse eid="PSA 140:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 140:4"/>
    <note caller="-" style="x">
      <char style="xo" closed="false">140:4 </char>
      <char style="xt" closed="false">
        <ref loc="ROM 3:13">Rom. 3:13</ref>.</char>
    </note>Manga incia apekatadha dhelana mboomo ulo,</para>
  <para style="q2" vid="PSA 140:4">pogauna manga incia mboomo racuna ulo mokobisa. <char style="qs">Sela</char><note caller="+" style="f"><char style="fr" closed="false">140:4 </char><char style="fq" closed="false">Sela: </char><char style="ft" closed="false">Aipomo tandana to aunto wakutuuna lagu sumai atolaguaka, atawa o tanda to ahanda apekaogea o suarana, atawa onina gambusuna. Amembali uka to tanda to morangoa mamudhaakana asuju. </char></note><verse eid="PSA 140:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 140:5"/>E KAWASANA OPU, jaganiaku minaaka i kuasana mia mokodosa,</para>
  <para style="q2" vid="PSA 140:5">tee ujaganiaku minaaka i mia masega,</para>
  <para style="q2" vid="PSA 140:5">mohaejatina to apekandawuaku.<verse eid="PSA 140:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 140:6"/>Mia mosombo abuniaka katapu to iaku.</para>
  <para style="q2" vid="PSA 140:6">Manga incia abhakesaka jarina i bhiwina dhala,</para>
  <para style="q2" vid="PSA 140:6">tee sakaaratea dhala manga incia ataakaaku katapu. <char style="qs">Sela</char><verse eid="PSA 140:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 140:7"/>Iaku kupogau tee KAWASANA OPU, "Ingkoomo Aulataʼalaku,</para>
  <para style="q2" vid="PSA 140:7">perangoimea opea iemaniku e KAWASANA OPU!"<verse eid="PSA 140:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 140:8"/>E KAWASANA OPU, e Aulataʼalaku, Ingkoomo o kasalaamatiku tee kakaaku,</para>
  <para style="q2" vid="PSA 140:8">Ingkoo padhamo ujagani bhaaku i eona potimbea.<verse eid="PSA 140:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 140:9"/>E KAWASANA OPU, bholi uose peeluana mia madhaki,</para>
  <para style="q2" vid="PSA 140:9">bholi uperangoia o haejati madhakina manga incia, mamudhaakana inda asomboaka karona. <char style="qs">Sela</char><verse eid="PSA 140:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 140:10"/>Maasangia o racu mominaakana i bhiwina apatondu manga mia madhaki molibuaku.<verse eid="PSA 140:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 140:11"/>Taroakamo manga incia apakowaoakea weona waa,</para>
  <para style="q2" vid="PSA 140:11">tee abhanakea i nuncana waa tee i bhalo mandala imateaka,</para>
  <para style="q2" vid="PSA 140:11">sabutuna inda amembali alimba pendua.<verse eid="PSA 140:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 140:12"/>Manga pande fitanaa inda bheadhadhi malape i dunia,</para>
  <para style="q2" vid="PSA 140:12">tee o mia mopewauna kasega bheaosea balaa.<verse eid="PSA 140:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 140:13"/>Iaku kumataua ande o KAWASANA OPU bheaewaaka hakuna mia motopisaki,</para>
  <para style="q2" vid="PSA 140:13">tee adhawu kaʼadili to mia momisikini.<verse eid="PSA 140:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 140:14"/>Atantumo o mia mobanara bheapuji saromu,</para>
  <para style="q2" vid="PSA 140:14">tee o mia momakatena totona incana bheamboore i aroamu.<verse eid="PSA 140:14"/></para>
  <chapter eid="PSA 140"/>
  <chapter number="141" style="c" sid="PSA 141"/>
  <para style="s">Doʼa i Wakutuuna Kapancoba</para>
  <para style="sr">
    <ref loc="PSA 141:1-10">141:1-10</ref></para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 141:1"/>Zaburuna Daud.</para>
  <para style="b" vid="PSA 141:1"/>
  <para style="q1" vid="PSA 141:1">E KAWASANA OPU, iaku kugora i Ingkoo, umbamo pekadhei!</para>
  <para style="q2" vid="PSA 141:1">Rangomea o doʼaku wakutuuna kugora i Ingkoo.<verse eid="PSA 141:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 141:2"/>
    <note caller="-" style="x">
      <char style="xo" closed="false">141:2 </char>
      <char style="xt" closed="false">
        <ref loc="REV 5:8">Wah. 5:8</ref>. </char>
    </note>Maasangia o doʼaku amembali pasombaa mboomo dhupa i aroamu,</para>
  <para style="q2" vid="PSA 141:2">tee limaku motoangkana mboomo pasombaa i wakutuuna konowia.<verse eid="PSA 141:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 141:3"/>E KAWASANA OPU, jagania muncuku,</para>
  <para style="q2" vid="PSA 141:3">tee kamatea bhiwiku.<verse eid="PSA 141:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 141:4"/>Bholi utaroakea incaku aose giu momadhaki</para>
  <para style="q2" vid="PSA 141:4">to kupewau manga giu mokodosa</para>
  <para style="q1" vid="PSA 141:4">tee manga mia mopewauna kadhaki;</para>
  <para style="q2" vid="PSA 141:4">bholi utaroakaaku kukande kinandena kariaana manga incia.<note caller="+" style="f"><char style="fr" closed="false">141:4 </char><char style="fq" closed="false">kukande kinandena kariaana manga incia: </char><char style="ft" closed="false">Aipomo ipogauakana iwe sii o kinande ipasombaaka i barahala i kariaana agama.</char></note><verse eid="PSA 141:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 141:5"/>Taroakamo mia mobanara atapaaku to audhaniaku;</para>
  <para style="q2" vid="PSA 141:5">taroakamo mia motaʼatiko ahukumuaku ande kupewau kasalaha,</para>
  <para style="q2" vid="PSA 141:5">ancosala o bhaaku amendeu atarima mina minaaka i mia mobanara.</para>
  <para style="q2" vid="PSA 141:5">Maka iaku sadhaadhaa kudoʼa kuewangi pewauna momadhaki manga mia madhaki sumai.<verse eid="PSA 141:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 141:6"/>Wakutuuna haakimuna manga incia atudhaakea minaaka i pimpina gunu bhatu,</para>
  <para style="q2" vid="PSA 141:6">sumaimo manga incia bheamataua ande manga pogauku abanara.<verse eid="PSA 141:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 141:7"/>Mboomo bhatu apaporua wetaia tee apahancurua i tana,</para>
  <para style="q2" vid="PSA 141:7">mboomo sumai uka bukuna manga incia bheamantale i ngangana koburu.<verse eid="PSA 141:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 141:8"/>Maka, mataku atonto i Ingkoo, e KAWASANA OPU, Aulataʼala isombaku;</para>
  <para style="q2" vid="PSA 141:8">Ingkoomo peulusaku, bholi utaroakaaku kubinasa!<verse eid="PSA 141:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 141:9"/>Maasangia ujaganiaku minaaka i katapu itaana manga incia,</para>
  <para style="q2" vid="PSA 141:9">tee minaaka i katapuna manga mia mopewauna kadhaki.<verse eid="PSA 141:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 141:10"/>Taroakamo manga mia madhaki sumai apesua i nuncana katapu itaana karona,</para>
  <para style="q2" vid="PSA 141:10">sainamo karoku samia kulaloia tee inda akangkanaiaku.<verse eid="PSA 141:10"/></para>
  <chapter eid="PSA 141"/>
  <chapter number="142" style="c" sid="PSA 142"/>
  <para style="s1">Doʼana Samia Motopajere</para>
  <para style="sr">
    <ref loc="PSA 142:1-8">142:1-8</ref></para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 142:1"/>Lagu kaadharina Daud wakutuuna incia apalaiaka Saul tee aopo i nuncana lia. Saangu doʼa.<verse eid="PSA 142:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 142:2"/>Tee suara makaa kugora i KAWASANA OPU;</para>
  <para style="q2" vid="PSA 142:2">tee suara makaa kuemani kaasi i KAWASANA OPU.<verse eid="PSA 142:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 142:3"/>I aroana kupeenci,</para>
  <para style="q2" vid="PSA 142:3">kupaumbaakea bhari-bharia kanarakaaku i Incia.<verse eid="PSA 142:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 142:4"/>Wakutuuna amate akalaku,</para>
  <para style="q2" vid="PSA 142:4">Ingkoo umataua o dhalaku.</para>
  <para style="q1" vid="PSA 142:4">I dhala bheilaloiku</para>
  <para style="q2" vid="PSA 142:4">manga musuku abuniaka katapu to iaku.<verse eid="PSA 142:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 142:5"/>Poilimo i weta kaanaku tee kamatea,</para>
  <para style="q2" vid="PSA 142:5">inda samia uka mokamataaku.</para>
  <para style="q1" vid="PSA 142:5">Inda dhaangia tampana peulusaku,</para>
  <para style="q2" vid="PSA 142:5">tee inda samia uka mofaduliakaaku.<verse eid="PSA 142:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 142:6"/>E KAWASANA OPU, iaku kugora i Ingkoo.</para>
  <para style="q1" vid="PSA 142:6">Pogauku, "Ingkoomo tampana peulusaku,</para>
  <para style="q2" vid="PSA 142:6">tee tangkanamo Ingkoo ifaraluuku i nuncana dhadhiku sii."<verse eid="PSA 142:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 142:7"/>Perangoia o doʼaku</para>
  <para style="q2" vid="PSA 142:7">roonamo indamo tee kakaana o bukuku.</para>
  <para style="q1" vid="PSA 142:7">Pasalaamatiaku minaaka i manga musu mosikisaaku</para>
  <para style="q2" vid="PSA 142:7">roonamo manga incia alabhi kakaana minaaka i iaku.<verse eid="PSA 142:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 142:8"/>Palimbaaku minaaka i katorongku,</para>
  <para style="q2" vid="PSA 142:8">mamudhaakana kumembali kusukuru i Ingkoo.</para>
  <para style="q1" vid="PSA 142:8">Manga mia mosaalihi bheaporomu tee iaku to tapuji saromu,</para>
  <para style="q2" vid="PSA 142:8">roonamo Ingkoo padhamo upewau malape i iaku.<verse eid="PSA 142:8"/></para>
  <chapter eid="PSA 142"/>
  <chapter number="143" style="c" sid="PSA 143"/>
  <para style="s1">Doʼa Emaniana Kasalaamati minaaka i Musu</para>
  <para style="sr">
    <ref loc="PSA 143:1-12">143:1-12</ref></para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 143:1"/>Zaburuna Daud.</para>
  <para style="b" vid="PSA 143:1"/>
  <para style="q1" vid="PSA 143:1">Maasangia urangoa o doʼaku, e KAWASANA OPU!</para>
  <para style="q2" vid="PSA 143:1">Perangoia iemaniku roonamo umembali utoparacaea;</para>
  <para style="q2" vid="PSA 143:1">lawaniaku i nuncana kabanaramu.<verse eid="PSA 143:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 143:2"/>
    <note caller="-" style="x">
      <char style="xo" closed="false">143:2 </char>
      <char style="xt" closed="false">
        <ref loc="ROM 3:20">Rom. 3:20</ref>; <ref loc="GAL 2:16">Gal. 2:16</ref>.</char>
    </note>Bholi ubhawa bhatuamu i pangadila,</para>
  <para style="q2" vid="PSA 143:2">roonamo inda dhaangia mia inda mosala i aroamu.<verse eid="PSA 143:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 143:3"/>Musuku apajereaku tee apatidhomuaku i tana;</para>
  <para style="q2" vid="PSA 143:3">incia adhikaaku i tampa momalalanda mboomo mia momangengena momate.<verse eid="PSA 143:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 143:4"/>Sababuna sumai, amate akalaku,</para>
  <para style="q2" vid="PSA 143:4">tee ngangarandaku ameri mpuu.<verse eid="PSA 143:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 143:5"/>Kutoudhanimo tee zamani momangenge,</para>
  <para style="q2" vid="PSA 143:5">iaku kuudhania bhari-bharia ipewaumu,</para>
  <para style="q2" vid="PSA 143:5">tee kufikiria bhari-bharia ipadhaangiamu.<verse eid="PSA 143:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 143:6"/>Iaku kuangka limaku tee kudoʼa i Ingkoo,</para>
  <para style="q2" vid="PSA 143:6">ngangarandaku apemeliliakako mboomo tana matuu apemeliliaka wao. <char style="qs">Sela</char><verse eid="PSA 143:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 143:7"/>E KAWASANA OPU, maasangia ulawaniaku madhei,</para>
  <para style="q2" vid="PSA 143:7">roonamo amatemo akalaku.</para>
  <para style="q1" vid="PSA 143:7">Bholi ubuniaka karomu minaaka i iaku</para>
  <para style="q2" vid="PSA 143:7">mamudhaakana iaku inda mboo manga mia mosapona i duniana mia mate.<verse eid="PSA 143:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 143:8"/>Parangoakaaku kaasimu molagina i wakutuu saeona,</para>
  <para style="q2" vid="PSA 143:8">roonamo kuparacaea i Ingkoo.</para>
  <para style="q1" vid="PSA 143:8">Susuakaaku dhala bheilaloiku,</para>
  <para style="q2" vid="PSA 143:8">roonamo i Ingkoomo kupasaraaka ngangarandaku.<verse eid="PSA 143:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 143:9"/>E KAWASANA OPU, pasalaamatiaku minaaka i manga musuku,</para>
  <para style="q2" vid="PSA 143:9">i Ingkoomo tampaku kupalai to kupeulu.<verse eid="PSA 143:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 143:10"/>Adhariaku kupewau opea ipeelumu,</para>
  <para style="q2" vid="PSA 143:10">roonamo Ingkoomo Aulataʼalaku.</para>
  <para style="q1" vid="PSA 143:10">Taroakea o rohimu momalape sumai</para>
  <para style="q2" vid="PSA 143:10">akapalaiaku i tana morata.<verse eid="PSA 143:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 143:11"/>E KAWASANA OPU, padhadhiaku roonamo saromu,</para>
  <para style="q2" vid="PSA 143:11">tee i nuncana kabanaramu pasalaamatiaku minaaka i kanarakaa.<verse eid="PSA 143:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 143:12"/>Roonamo kaasimu molagina, pahancurumea manga musuku,</para>
  <para style="q2" vid="PSA 143:12">tee pabinasamea bhari-bharia mia mopanarakaaku</para>
  <para style="q2" vid="PSA 143:12">roonamo iaku o bhatuamu.<verse eid="PSA 143:12"/></para>
  <chapter eid="PSA 143"/>
  <chapter number="144" style="c" sid="PSA 144"/>
  <para style="s1">Lagu Kasukuruna Raja</para>
  <para style="sr">
    <ref loc="PSA 144:1-15">144:1-15</ref></para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 144:1"/>Zaburuna Daud.</para>
  <para style="b" vid="PSA 144:1"/>
  <para style="q1" vid="PSA 144:1">Atopujimo KAWASANA OPU o gunu bhatuku,</para>
  <para style="q2" vid="PSA 144:1">moadharina limaku to apotimbe tee kauna limaku to apoewangi.<verse eid="PSA 144:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 144:2"/>Incia momaasiakaaku saʼumurua tee o bente potaangiaku,</para>
  <para style="q2" vid="PSA 144:2">kota benteku tee mopabebasiaku.</para>
  <para style="q1" vid="PSA 144:2">Incia o katangkesiku, Incia o tampana peulusaku,</para>
  <para style="q2" vid="PSA 144:2">Incia apekatalo manga lipu tee adhikaia i tambena kuasaku.<verse eid="PSA 144:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 144:3"/>
    <note caller="-" style="x">
      <char style="xo" closed="false">144:3 </char>
      <char style="xt" closed="false">
        <ref loc="PSA 8:5">Zab. 8:5</ref>.</char>
    </note>E KAWASANA OPU, incema buaka o maanusia sumai mbakana uudhania?</para>
  <para style="q2" vid="PSA 144:3">Incema buaka o maanusia sumai mbakana ufaduliakea?<verse eid="PSA 144:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 144:4"/>Maanusia sumai mboomo wiina ngalu,</para>
  <para style="q2" vid="PSA 144:4">tee o umuruna mboomo ngkamia-mia molalo.<verse eid="PSA 144:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 144:5"/>E KAWASANA OPU, bungkalemea o laianamu tee usapomo,</para>
  <para style="q2" vid="PSA 144:5">dhingkumea manga gunu mamudhaakana akoombu.<verse eid="PSA 144:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 144:6"/>Pasapomea o bhibhitomu mamudhaakana o musu apogaa-gaa,</para>
  <para style="q2" vid="PSA 144:6">rambasakamea o panamu mamudhaakana manga incia amambura.<verse eid="PSA 144:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 144:7"/>Paulumea o limamu minaaka i kalangaana;</para>
  <para style="q2" vid="PSA 144:7">pabebasiaku tee upasalaamatiakumo minaaka i uwena mawa,</para>
  <para style="q2" vid="PSA 144:7">tee minaaka i limana manga mia dhaga!<verse eid="PSA 144:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 144:8"/>Manga incia kapeeluana apekatipu,</para>
  <para style="q2" vid="PSA 144:8">tee agau-gau wakutuuna aposumpa.<verse eid="PSA 144:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 144:9"/>Iaku bhekulaguakako lagu bhaau, e Aulataʼala,</para>
  <para style="q2" vid="PSA 144:9">tee bhekulaguakako manga lagu kapujia poose kutikiakako gambusu sapulu taliana.<verse eid="PSA 144:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 144:10"/>Ingkoo modhawuna kamangantalo to manga raja,</para>
  <para style="q2" vid="PSA 144:10">tee upasalaamati Daud o bhatuamu.<verse eid="PSA 144:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 144:11"/>Rambasakaaku minaaka i hancuna mia masega,</para>
  <para style="q2" vid="PSA 144:11">pasalaamatiaku minaaka i kuasana manga mia dhaga.</para>
  <para style="q1" vid="PSA 144:11">Manga incia kapeeluana apekatipu,</para>
  <para style="q2" vid="PSA 144:11">tee agau-gau wakutuuna aposumpa.<verse eid="PSA 144:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 144:12"/>Maasangia manga anata umane</para>
  <para style="q2" vid="PSA 144:12">mboomo penembula motuwuna amembali amaoge,</para>
  <para style="q2" vid="PSA 144:12">tee manga anata bhawine</para>
  <para style="q2" vid="PSA 144:12">mboomo manga arii makesa</para>
  <para style="q1" vid="PSA 144:12">mobhelokina manga singkuna malige.<verse eid="PSA 144:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 144:13"/>Maasangia manga kampirita abukeaka</para>
  <para style="q2" vid="PSA 144:13">sagala giu hasilina alamu;</para>
  <para style="q1" vid="PSA 144:13">maasangia manga dumbata i tana mokorumpu amembali rewuna mbaa,</para>
  <para style="q2" vid="PSA 144:13">tee ajulu o kabharina amembali puluna rewu mbaa o kabharina.<verse eid="PSA 144:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 144:14"/>Maasangia manga sapita ahanda ajulu o kaogena badana</para>
  <para style="q2" vid="PSA 144:14">tee inda dhaangia momadhakina i nuncana kadhumana atawa amambuu.</para>
  <para style="q2" vid="PSA 144:14">Tee inda atorango suara motomaporoakana inca i dhalana manga kotata.<verse eid="PSA 144:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 144:15"/>Amasanaamo o lipu ibarakati mboo sumai!</para>
  <para style="q2" vid="PSA 144:15">Amasanaamo mpuu o lipu mosombana i Aulataʼala, siitumo mosombana i KAWASANA OPU.<verse eid="PSA 144:15"/></para>
  <chapter eid="PSA 144"/>
  <chapter number="145" style="c" sid="PSA 145"/>
  <para style="s1">Lagu Kapujia to Kalapena KAWASANA OPU</para>
  <para style="sr">
    <ref loc="PSA 145:1-21">145:1-21</ref></para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 145:1"/>Lagu kapujiana Daud.</para>
  <para style="b" vid="PSA 145:1"/>
  <para style="q1" vid="PSA 145:1">E Aulataʼalaku, e Raja, iaku bhekupekalangako,</para>
  <para style="q2" vid="PSA 145:1">tee bhekupuji saromu to saʼumurua.<verse eid="PSA 145:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 145:2"/>Saesaeo bhekupujiko,</para>
  <para style="q2" vid="PSA 145:2">tee bhekumuliangia o saromu to saʼumurua.<verse eid="PSA 145:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 145:3"/>Tapanamo kalanga o KAWASANA OPU tee alaenga mpuu atopuji!</para>
  <para style="q2" vid="PSA 145:3">Inda bhari-bharia sifatuna momaoge amembali amaʼanaia maanusia.<verse eid="PSA 145:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 145:4"/>Manga mancuana bheapuji opea mopadhana ikarajaamu i manga anana sakawana bhari-bharia siwuluna amataua,</para>
  <para style="q2" vid="PSA 145:4">tee bheapogauaka ande Ingkoo momakaana.<verse eid="PSA 145:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 145:5"/>Manga incia apakoleleaka kaogesamu momuliana</para>
  <para style="q2" vid="PSA 145:5">tee pewaumu inda momentela bhekufikiria i nuncana ngangarandaku.<verse eid="PSA 145:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 145:6"/>Mia bheapetulatulaaka manga ipewaumu momakaana,</para>
  <para style="q2" vid="PSA 145:6">tee bhekupakoleleaka kaogesamu.<verse eid="PSA 145:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 145:7"/>Manga incia bheakaunde-undeaka kaogesana saromu roonamo pewaumu momalape,</para>
  <para style="q2" vid="PSA 145:7">tee bheasambo-sambo roonamo kabanaramu.<verse eid="PSA 145:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 145:8"/>KAWASANA OPU sumai abukeaka kaasi tee rahumati.</para>
  <para style="q2" vid="PSA 145:8">Incia asabara mpuu tee o kaasina molagina amaoge.<verse eid="PSA 145:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 145:9"/>KAWASANA OPU sumai amalape i bhari-bharia mia,</para>
  <para style="q2" vid="PSA 145:9">tee rahumatina to bhari-bharia mahaluku mopadhana ipadhaangiana.<verse eid="PSA 145:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 145:10"/>Bhari-bharia ipadhaangiamu sumai bheasukuru i Ingkoo, e KAWASANA OPU,</para>
  <para style="q2" vid="PSA 145:10">tee bhari-bharia mia mosaalihi bheapujiko.<verse eid="PSA 145:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 145:11"/>Manga incia bheapogauaka kamuliangina pamarintamu,</para>
  <para style="q2" vid="PSA 145:11">tee apetulatulaaka kakaamu,<verse eid="PSA 145:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 145:12"/>sabutuna o maanusia amataua o kaogesana manga pewaumu,</para>
  <para style="q2" vid="PSA 145:12">tee kamuliangina pamarintamu amalanga.<verse eid="PSA 145:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 145:13"/>Pamarintamu o pamarinta mobakaa,</para>
  <para style="q2" vid="PSA 145:13">tee o kuasamu asadhaadhaa to saʼumurua.</para>
  <para style="b" vid="PSA 145:13"/>
  <para style="q1" vid="PSA 145:13">KAWASANA OPU amembali atoparacaea i nuncana bhari-bharia janjina</para>
  <para style="q2" vid="PSA 145:13">tee bhari-bharia ipewauna abukeaka rahumati.<verse eid="PSA 145:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 145:14"/>KAWASANA OPU atulungi bhari-bharia mia monarakaa,</para>
  <para style="q2" vid="PSA 145:14">tee apekatangka bhari-bharia mia motungku.<verse eid="PSA 145:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 145:15"/>Bhari-bharia matana mia aantaantagiko,</para>
  <para style="q2" vid="PSA 145:15">tee Ingkoo uka udhawua kinande akawa wakutuuna.<verse eid="PSA 145:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 145:16"/>Ingkoo ubungkale limamu,</para>
  <para style="q2" vid="PSA 145:16">tee upadhaangiaaka opea ipeeluna bhari-bharia mahaluku mokoinyawa.<verse eid="PSA 145:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 145:17"/>KAWASANA OPU abanara i bhari-bharia dhalana,</para>
  <para style="q2" vid="PSA 145:17">amalape tee abukeaka rahumati.<verse eid="PSA 145:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 145:18"/>KAWASANA OPU atulungi bhari-bharia mia mogorana i Incia,</para>
  <para style="q2" vid="PSA 145:18">bhari-bharia mia mogorana i Incia i nuncana kabanara.<verse eid="PSA 145:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 145:19"/>Incia apadhaangiakea bhari-bharia ifaraluuna mia momaekana i Incia;</para>
  <para style="q2" vid="PSA 145:19">Incia uka arangoa o pekeena manga incia tee apasalaamatia.<verse eid="PSA 145:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 145:20"/>KAWASANA OPU ajagani bhari-bharia mia momaasiakea,</para>
  <para style="q2" vid="PSA 145:20">maka Incia apabinasa bhari-bharia mia madhaki.<verse eid="PSA 145:20"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 145:21"/>Iaku bhekupuji KAWASANA OPU,</para>
  <para style="q2" vid="PSA 145:21">tee bhari-bharia mahaluku bheapuji sarona momangkilo to saʼumurua.<verse eid="PSA 145:21"/></para>
  <chapter eid="PSA 145"/>
  <chapter number="146" style="c" sid="PSA 146"/>
  <para style="s1">Tangkanamo KAWASANA OPU Mangatulungina</para>
  <para style="sr">
    <ref loc="PSA 146:1-10">146:1-10</ref></para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 146:1"/>Pujimo KAWASANA OPU!</para>
  <para style="b" vid="PSA 146:1"/>
  <para style="q1" vid="PSA 146:1">E inyawaku, pujimo KAWASANA OPU!<verse eid="PSA 146:1"/></para>
  <para style="q2">
    <verse number="2" style="v" sid="PSA 146:2"/>Iaku bhekupuji</para>
  <para style="q1" vid="PSA 146:2">KAWASANA OPU saʼumurua dhadhiku,</para>
  <para style="q2" vid="PSA 146:2">tee bhekulaguaka manga lagu kapujia to Aulataʼalaku kangengena dhaangia kudhadhi.<verse eid="PSA 146:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 146:3"/>Bholi uparacaea i manga mokokuasana,</para>
  <para style="q2" vid="PSA 146:3">i maanusia inda momembalina mopasalaamati.<verse eid="PSA 146:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 146:4"/>Wakutuuna inyawana amabhotu, manga incia ambulimo i tana,</para>
  <para style="q2" vid="PSA 146:4">tee i eo incia sumai uka bhari-bharia ihaejatiakana ailamo.<verse eid="PSA 146:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 146:5"/>Amasanaamo mia motarimana katulungi minaaka i Aulataʼala isombana Yakub,</para>
  <para style="q2" vid="PSA 146:5">modhikana harapuna i KAWASANA OPU, Aulataʼalana.<verse eid="PSA 146:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 146:6"/>Inciamo mopadhaangiana laiana tee alamu,</para>
  <para style="q2" vid="PSA 146:6">tawo tee bhari-bharia antona,</para>
  <para style="q2" vid="PSA 146:6">tee sadhaadhaana akeni janjina to saʼumurua.<verse eid="PSA 146:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 146:7"/>Inciamo moewaakana hakuna manga mia motopisaki,</para>
  <para style="q2" vid="PSA 146:7">tee adhawu kinande i manga mia momaara.</para>
  <para style="b" vid="PSA 146:7"/>
  <para style="q1" vid="PSA 146:7">KAWASANA OPU apabebasi manga mia itorongku;<verse eid="PSA 146:7"/></para>
  <para style="q2">
    <verse number="8" style="v" sid="PSA 146:8"/>KAWASANA OPU abungkale matana manga mia mawilo.</para>
  <para style="q1" vid="PSA 146:8">KAWASANA OPU aangka manga mia motungku;</para>
  <para style="q2" vid="PSA 146:8">KAWASANA OPU amaasiaka mia mobanara.<verse eid="PSA 146:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 146:9"/>KAWASANA OPU ajagani manga mia dhaga;</para>
  <para style="q2" vid="PSA 146:9">Incia apambuli kadhaangiana manga ana maelu tee iaiaro,</para>
  <para style="q2" vid="PSA 146:9">maka Incia apakacau haejatina mia madhaki.<verse eid="PSA 146:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 146:10"/>KAWASANA OPU bheaparinta mboomo Raja to saʼumurua.</para>
  <para style="q2" vid="PSA 146:10">E raʼeatina Sion, Aulataʼalamu akokuasa saʼumurua zamani.</para>
  <para style="q1" vid="PSA 146:10">Pujimo KAWASANA OPU!<verse eid="PSA 146:10"/></para>
  <chapter eid="PSA 146"/>
  <chapter number="147" style="c" sid="PSA 147"/>
  <para style="s1">Kakuasa tee Rahumatina KAWASANA OPU</para>
  <para style="sr">
    <ref loc="PSA 147:1-20">147:1-20</ref></para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 147:1"/>Pujimo KAWASANA OPU!</para>
  <para style="b" vid="PSA 147:1"/>
  <para style="q1" vid="PSA 147:1">Amalape mpuu talaguaka manga lagu kapujia to Aulataʼalata;</para>
  <para style="q2" vid="PSA 147:1">umbe, amalape mpuu tanamisia tee alaenga to tapujia!<verse eid="PSA 147:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 147:2"/>KAWASANA OPU apabhangu Yerusalem,</para>
  <para style="q2" vid="PSA 147:2">tee aromusaka manga miana Israel mopadhana ibhanakana.<verse eid="PSA 147:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 147:3"/>Incia apaunto manga mia momaporona incana,</para>
  <para style="q2" vid="PSA 147:3">tee atange kambelana manga incia.<verse eid="PSA 147:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 147:4"/>Incia atantuaka kabharina manga kalipopo,</para>
  <para style="q2" vid="PSA 147:4">tee sumbe-sumbere adhawua saro.<verse eid="PSA 147:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 147:5"/>Kawasana Oputa amaoge tee kakaana ataralabhi-labhi,</para>
  <para style="q2" vid="PSA 147:5">hikimatina inda atokera-kera.<verse eid="PSA 147:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 147:6"/>KAWASANA OPU atulungi manga mia motopisaki,</para>
  <para style="q2" vid="PSA 147:6">maka Incia apaporitambe manga mia madhaki sakawana i tana.<verse eid="PSA 147:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 147:7"/>Lagumo tee usukurumo i KAWASANA OPU!</para>
  <para style="q2" vid="PSA 147:7">Laguakamea manga lagu kapujia tee umagasiaaka kecapi to Aulataʼalata.<verse eid="PSA 147:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 147:8"/>Inciamo motutubhina laiana tee manga taʼina ngalu,</para>
  <para style="q2" vid="PSA 147:8">mopadhaangiana wao i alamu,</para>
  <para style="q2" vid="PSA 147:8">tee apatuwu rumpu i manga gunu.<verse eid="PSA 147:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 147:9"/>Incia uka modhawuna kinande i binata,</para>
  <para style="q2" vid="PSA 147:9">tee i manga anana manu-manu tongkaa mokaoni-onina.<verse eid="PSA 147:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 147:10"/>Mencuana kakaana ajara ipeeluna Aulataʼala,</para>
  <para style="q2" vid="PSA 147:10">tee uka mencuana suludadu momakaa imasinaina;<verse eid="PSA 147:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 147:11"/>maka o KAWASANA OPU amaasiaka manga mia momaekaia,</para>
  <para style="q2" vid="PSA 147:11">tee manga mia moharapuakana kaasina molagina.<verse eid="PSA 147:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 147:12"/>Muliangia o KAWASANA OPU, e Yerusalem!</para>
  <para style="q2" vid="PSA 147:12">Pujimo Aulataʼalamu, e Sion!<verse eid="PSA 147:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 147:13"/>Roonamo Incia apekatangka manga kapasona bhambana lawamu,</para>
  <para style="q2" vid="PSA 147:13">tee abarakati raʼeatimu tee manga giu momalape.<verse eid="PSA 147:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 147:14"/>Incia adhawu kaʼamani i lipumu,</para>
  <para style="q2" vid="PSA 147:14">tee apekambosuko tee gandum momalape.<verse eid="PSA 147:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 147:15"/>Incia apakawaaka parintana i alamu,</para>
  <para style="q2" vid="PSA 147:15">sumaimo firimanina lausaka atopewau.<verse eid="PSA 147:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 147:16"/>Incia apasapo salju mboomo buluna dumba,</para>
  <para style="q2" vid="PSA 147:16">tee o alo mokobhatu akamburakea mboomo rapu.<verse eid="PSA 147:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 147:17"/>Incia apasapo waona esi mboomo katongkana roti;</para>
  <para style="q2" vid="PSA 147:17">inda dhaangia momembalina motaraina kagarina.<verse eid="PSA 147:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 147:18"/>Incia apakawaaka firimanina, sumaimo areremo o esi sumai;</para>
  <para style="q2" vid="PSA 147:18">Incia atowii ngalu, sumaimo o uwe asiwulumo.<verse eid="PSA 147:18"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 147:19"/>Incia apakawaaka firimanina i Yakub,</para>
  <para style="q2" vid="PSA 147:19">tee manga katotapuna tee manga tuturana to Israel.<verse eid="PSA 147:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 147:20"/>Incia inda apewau giu mboo sumai i lipu mosagaanana iapaipo uka;</para>
  <para style="q2" vid="PSA 147:20">manga incia inda amataua manga tuturana.</para>
  <para style="b" vid="PSA 147:20"/>
  <para style="q1" vid="PSA 147:20">Pujimo KAWASANA OPU!<verse eid="PSA 147:20"/></para>
  <chapter eid="PSA 147"/>
  <chapter number="148" style="c" sid="PSA 148"/>
  <para style="s1">Laiana tee Alamu, Pujimo KAWASANA OPU!</para>
  <para style="sr">
    <ref loc="PSA 148:1-14">148:1-14</ref></para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 148:1"/>Pujimo KAWASANA OPU!</para>
  <para style="b" vid="PSA 148:1"/>
  <para style="q1" vid="PSA 148:1">Pujimo KAWASANA OPU minaaka i sorogaa,</para>
  <para style="q2" vid="PSA 148:1">pujimea i tampa momalanga!<verse eid="PSA 148:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 148:2"/>Pujimo Incia, e bhari-bharia malaaʼekatina,</para>
  <para style="q2" vid="PSA 148:2">pujimo Incia, e bhari-bharia tantarana!<verse eid="PSA 148:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 148:3"/>Pujimo Incia, e matanaeo tee bula;</para>
  <para style="q2" vid="PSA 148:3">pujimo Incia, e manga kalipopo momainawana!<verse eid="PSA 148:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 148:4"/>Pujimo Incia, e laiana momalanga,</para>
  <para style="q2" vid="PSA 148:4">tee uwe i bhawona laiana!<verse eid="PSA 148:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 148:5"/>Taroakamo bhari-bharia apuji sarona KAWASANA OPU</para>
  <para style="q2" vid="PSA 148:5">roonamo minaaka i firimanina Incia apadhaangia bhari-bharia.<verse eid="PSA 148:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 148:6"/>Incia uka motantuakana bhari-bharia giu i sorogaa tee i laiana to saʼumurua;</para>
  <para style="q2" vid="PSA 148:6">opea ipatotapuakana abakaa.<verse eid="PSA 148:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 148:7"/>Pujimo KAWASANA OPU minaaka i alamu,</para>
  <para style="q2" vid="PSA 148:7">e manga nagana tawo tee saangua andala oge;<verse eid="PSA 148:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 148:8"/>e waa tee waona esi, salju tee taʼina ngalu,</para>
  <para style="q2" vid="PSA 148:8">tee garura<note caller="+" style="f"><char style="fr" closed="false">148:8 </char><char style="fq" closed="false">garura: </char><char style="ft" closed="false">Ngalu momakaa mpuu. </char></note> moosena parintana Kawasana Opu;<verse eid="PSA 148:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 148:9"/>manga gunu tee bhari-bharia kabumbu,</para>
  <para style="q2" vid="PSA 148:9">manga puuna kau mokobhake tee bhari-bharia puuna aras;<verse eid="PSA 148:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 148:10"/>binata maila tee bhari-bharia kadhambaaka,</para>
  <para style="q2" vid="PSA 148:10">bhari-bharia binata mopondele tee manu-manu mokopani;<verse eid="PSA 148:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 148:11"/>manga raja i alamu tee bhari-bharia lipu i dunia,</para>
  <para style="q2" vid="PSA 148:11">manga kaogesa tee bhari-bharia haakimu i alamu;<verse eid="PSA 148:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 148:12"/>manga anaana umane tee kabuabua,</para>
  <para style="q2" vid="PSA 148:12">manga mancuana tee anaana apoose apuji Incia!<verse eid="PSA 148:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 148:13"/>Taroakamo bhari-bharia apuji sarona KAWASANA OPU,</para>
  <para style="q2" vid="PSA 148:13">roonamo tangkanamo sarona molaengana motopekalanga!</para>
  <para style="q2" vid="PSA 148:13">Kalangana alabhi minaaka i kalangana alamu tee laiana.<verse eid="PSA 148:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 148:14"/>Incia padhamo apajaea uumatina,</para>
  <para style="q2" vid="PSA 148:14">tee apamembalia giuna kapujia to bhari-bharia mia mosaalihi,</para>
  <para style="q2" vid="PSA 148:14">siitumo miana Israel, uumati momakasuna tee Incia.</para>
  <para style="b" vid="PSA 148:14"/>
  <para style="q1" vid="PSA 148:14">Pujimo KAWASANA OPU!<verse eid="PSA 148:14"/></para>
  <chapter eid="PSA 148"/>
  <chapter number="149" style="c" sid="PSA 149"/>
  <para style="s1">Lagu Bhaau to KAWASANA OPU</para>
  <para style="sr">
    <ref loc="PSA 149:1-9">149:1-9</ref></para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 149:1"/>Pujimo KAWASANA OPU!</para>
  <para style="b" vid="PSA 149:1"/>
  <para style="q1" vid="PSA 149:1">Laguakamo lagu bhaau to KAWASANA OPU!</para>
  <para style="q2" vid="PSA 149:1">Pujimea i nuncana poromusakaana mia mosaalihi!<verse eid="PSA 149:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 149:2"/>Taroakamo Israel akaunde-unde roonamo Kawasana Opu mopadhaangiakomiu,</para>
  <para style="q2" vid="PSA 149:2">tee taroakamo raʼeatina Sion akaunde-unde roonamo Rajana.<verse eid="PSA 149:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 149:3"/>Taroakamo manga incia amanari to apuji sarona Kawasana Opu,</para>
  <para style="q2" vid="PSA 149:3">tee alaguaka manga lagu kapujia apoose amagasiaaka ganda-ganda tee kecapi to apuji Incia,<verse eid="PSA 149:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 149:4"/>roonamo KAWASANA OPU amaasiaka uumatina,</para>
  <para style="q2" vid="PSA 149:4">tee Incia apakanaakea o mahakota kasalaamati to manga mia mopaporitambena karona.<verse eid="PSA 149:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 149:5"/>Taroakamo uumatina akaunde-unde i nuncana kamuliangi,</para>
  <para style="q2" vid="PSA 149:5">tee alagu asambo-sambo i kolemana.<verse eid="PSA 149:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 149:6"/>Taroakamo manga incia apuji Aulataʼala tee ngangana,</para>
  <para style="q2" vid="PSA 149:6">apoose akeni hancu momatadha ruaanguana matana i limana<verse eid="PSA 149:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 149:7"/>to abalasi pewauna manga lipu i dunia sii,</para>
  <para style="q2" vid="PSA 149:7">tee ahukumu manga raʼeatina lipu i alamu sii,<verse eid="PSA 149:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 149:8"/>to abhokeakea ase manga raja,</para>
  <para style="q2" vid="PSA 149:8">tee abhokeakea rante ase manga kaogesana lipu,<verse eid="PSA 149:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 149:9"/>to ahukumu manga lipu mboomo mopadhana ipatotapuakana Aulataʼala to manga incia.</para>
  <para style="q2" vid="PSA 149:9">Giu incia sumai amembali saangu giu momulia to bhari-bharia mia mosaalihi.</para>
  <para style="b" vid="PSA 149:9"/>
  <para style="q2" vid="PSA 149:9">Pujimo KAWASANA OPU!<verse eid="PSA 149:9"/></para>
  <chapter eid="PSA 149"/>
  <chapter number="150" style="c" sid="PSA 150"/>
  <para style="s1">Pujimo KAWASANA OPU!</para>
  <para style="sr">
    <ref loc="PSA 150:1-6">150:1-6</ref></para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 150:1"/>Pujimo KAWASANA OPU!</para>
  <para style="b" vid="PSA 150:1"/>
  <para style="q1" vid="PSA 150:1">Pujimo Aulataʼala i tampana momangkilona!</para>
  <para style="q2" vid="PSA 150:1">Pujimea i sorogaana momakaana!<verse eid="PSA 150:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 150:2"/>Pujimea roonamo pewauna mosusuakana kakaana.</para>
  <para style="q2" vid="PSA 150:2">Pujimea apokana tee kaogesana inda momentela!<verse eid="PSA 150:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 150:3"/>Pujimea tee onina torompe,</para>
  <para style="q2" vid="PSA 150:3">pujimea tee gambusu tee kecapi!<verse eid="PSA 150:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 150:4"/>Pujimea tee ganda-ganda tee umanari,</para>
  <para style="q2" vid="PSA 150:4">pujimea tee gambusu tee suli!<verse eid="PSA 150:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 150:5"/>Pujimea tee ceracap mokonduu,</para>
  <para style="q2" vid="PSA 150:5">pujimea tee ceracap mokondii!<verse eid="PSA 150:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 150:6"/>Taroakamo bhari-bharia mahaluku modhadhi apuji KAWASANA OPU!</para>
  <para style="b" vid="PSA 150:6"/>
  <para style="q1" vid="PSA 150:6">Pujimo KAWASANA OPU!<verse eid="PSA 150:6"/></para>
  <chapter eid="PSA 150"/>
</usx>
