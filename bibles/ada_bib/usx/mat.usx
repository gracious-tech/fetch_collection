<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="MAT" style="id">- Biblica® Open Dangme Living New Testament &amp; Psalms</book>
  <para style="rem">Copyright © 1997 by Biblica, Inc.</para>
  <para style="h">Mateo</para>
  <para style="toc1">Mateo Manye Munyu Ɔ</para>
  <para style="toc2">Mateo</para>
  <para style="toc3">Mat</para>
  <para style="mt1">Mateo Manye Munyu Ɔ</para>
  <chapter number="1" style="c" sid="MAT 1" />
  <para style="p">
    <verse number="1" style="v" sid="MAT 1:1" />Yesu Kristo nɛ ji Matsɛ David kɛ Abraham a bibimibi ɔ, e nana kasowahi ji ni nɛ ɔmɛ:<verse eid="MAT 1:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="MAT 1:2" />Abraham fɔ Isak, nɛ Isak fɔ Yakob, nɛ Yakob hu fɔ Yuda kɛ e nyɛmimɛ ɔmɛ. <verse eid="MAT 1:2" /><verse number="3" style="v" sid="MAT 1:3" />Yuda yo ji Tama, nɛ a bimɛ ji Perez kɛ Zera; Perez fɔ Hezron, nɛ Hezron hu fɔ Aram; <verse eid="MAT 1:3" /><verse number="4" style="v" sid="MAT 1:4" />Aram bi ji Aminadab, nɛ Aminadab fɔ Naason, nɛ Naason hu fɔ Salmon; <verse eid="MAT 1:4" /><verse number="5" style="v" sid="MAT 1:5" />Salmon kɛ e yo Rahab fɔ Boaz, nɛ Boaz kɛ Rut fɔ Obed, nɛ Obed fɔ Isai; <verse eid="MAT 1:5" /><verse number="6" style="v" sid="MAT 1:6" />Isai fɔ Matsɛ David, nɛ David kɛ Yuria yo ɔ fɔ Salomo;<verse eid="MAT 1:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 1:7" />Salomo fɔ Rehabeam, nɛ Rehabeam fɔ Abia, nɛ Abia hu fɔ Asa; <verse eid="MAT 1:7" /><verse number="8" style="v" sid="MAT 1:8" />Asa bi ji Yehosafat, nɛ Yehosafat fɔ Yoram, nɛ Yoram fɔ Uzia; <verse eid="MAT 1:8" /><verse number="9" style="v" sid="MAT 1:9" />Uzia fɔ Yotam; Yotam fɔ Ahaz, nɛ Ahaz fɔ Hezekia; <verse eid="MAT 1:9" /><verse number="10" style="v" sid="MAT 1:10" />Hezekia bi ji Manase, nɛ Manase fɔ Amon, nɛ Amon hu fɔ Yosia; <verse eid="MAT 1:10" /><verse number="11" style="v" sid="MAT 1:11" />Yosia fɔ Yekonia kɛ e nyɛmimɛ ɔmɛ be mi nɛ a ngɛ nyɔguɛ yee ngɛ Babilon ɔ. <verse eid="MAT 1:11" /><verse number="12" style="v" sid="MAT 1:12" />Ngɛ a nyɔguɛ yemi ɔ se ɔ, Yekonia fɔ Sealtiel, nɛ Sealtiel hu fɔ Zerubabel; <verse eid="MAT 1:12" /><verse number="13" style="v" sid="MAT 1:13" />Zerubabel bi ji Abiud, nɛ Abiud fɔ Eliakim, nɛ Eliakim fɔ Azor; <verse eid="MAT 1:13" /><verse number="14" style="v" sid="MAT 1:14" />Azor bi ji Zadok, nɛ Zadok fɔ Akim, nɛ Akim hu fɔ Eliud; <verse eid="MAT 1:14" /><verse number="15" style="v" sid="MAT 1:15" />Eliud fɔ Eleazar, nɛ Eleazar fɔ Matan, nɛ Matan hu fɔ Yakob; <verse eid="MAT 1:15" /><verse number="16" style="v" sid="MAT 1:16" />Yakob fɔ Yosef nɔ nɛ ngɔ Maria nɛ ji Yesu Kristo e nyɛ ɔ.<verse eid="MAT 1:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 1:17" />Enɛ ɔ tsɔɔ kaa weku nyɔngma kɛ eywiɛ nɛ ngɛ kɛ je Abraham yi nɔ kɛ ba su Matsɛ David nɔ; nɛ kɛ je Matsɛ David yi nɔ kɛ ba su be mi nɛ a ngɔ mɛ nyɔguɛ kɛ ho Babilon ya a hu peeɔ weku nyɔngma kɛ eywiɛ; nɛ kɛ je benɛ a je nyɔguɛ yemi ngɛ Babilon se kɛ ba su Kristo yi nɔ hu peeɔ weku nyɔngma ke eywiɛ.<verse eid="MAT 1:17" /></para>
  <para style="s1">Bimwɔyo ɔ fɔmi he si womi</para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 1:18" />Nɛ bɔ nɛ Yesu Kristo fɔmi ɔ ba ha ji, a bi Maria nɛ ji Yesu nyɛ ɔ si kɛ ha Yosef. Se Mumi Klɔuklɔu ɔ ha nɛ Maria na muklii benɛ e li nyumu. <verse eid="MAT 1:18" /><verse number="19" style="v" sid="MAT 1:19" />Sane nɛ ɔ hao Yosef saminya. Se akɛnɛ dalɔ kɛ nɔmlɔ nɛ buu e he ji lɛ he je ɔ, e pee e juɛmi kaa e maa ngmɛɛ Maria he dii bɔ nɛ pee nɛ e ko pue e hɛ mi si.<verse eid="MAT 1:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 1:20" />Se benɛ Yosef hwɔɔ si nɛ e ngɛ sane nɛ ɔ he susue ɔ, e nɔ mahe mi nɛ e nla nɛ Mawu bɔfo ko ba da si ngɛ e kasa nya nɛ e de lɛ ke “Yosef, David bi, mo ko ngmɛɛ Maria he, ejakaa e bɔɛ ajuama. Mumi Klɔuklɔu ɔ nɛ ha nɛ e da si ɔ nɛ. <verse eid="MAT 1:20" /><verse number="21" style="v" sid="MAT 1:21" />E ma fɔ binyumu, nɛ o maa wo lɛ biɛ ke Yesu, e sisi ji Yiwamihelɔ, ejakaa lɛ nɛ e ma ba he nimli a yi wami kɛ je a he yayami ɔmɛ a mi.” <verse eid="MAT 1:21" /><verse number="22" style="v" sid="MAT 1:22" />Enɛ ɔ ma ha Mawu si nɛ e wo kɛ gu gbali ɔmɛ a nɔ ɔ maa ba mi ke, <verse eid="MAT 1:22" /><verse number="23" style="v" sid="MAT 1:23" />Hyɛ! Zangmayo ɔ nɛ li nyumu ɔ ma na muklii nɛ e ma fɔ Binyumu, nɛ a ma tsɛ lɛ ke, “Yimanuel”, e sisi ji, “Mawu kɛ wɔ ngɛ”. <verse eid="MAT 1:23" /><verse number="24" style="v" sid="MAT 1:24" />Benɛ Yosef te si ɔ, e ye Mawu bɔfo ɔ gbi ɔ nɔ. E ya ngɔ Maria kɛ ba e we ɔ mi nɛ e kɛ lɛ ba hi si kaa e yo. <verse eid="MAT 1:24" /><verse number="25" style="v" sid="MAT 1:25" />Se a li a he kaa nyumu kɛ yo kɛ ya si be nɛ e fɔ nɛ Yosef wo bi ɔ biɛ ke “Yesu”.<verse eid="MAT 1:25" /></para>
  <chapter eid="MAT 1" />
  <chapter number="2" style="c" sid="MAT 2" />
  <para style="s1">Yesu fɔmi he sane</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 2:1" />A fɔ Yesu ngɛ Yudea ma ko nɛ a tsɛɛ ke Betlehem ɔ mi. Matsɛ Herode nɛ ngɛ matsɛ yee jamɛ a be ɔ mi. A fɔ Yesu bɔɔ pɛ nɛ ni leli etɛ komɛ je pu gbami he kɛ ba Yerusalem nɛ a ba bi ke, <verse eid="MAT 2:1" /><verse number="2" style="v" sid="MAT 2:2" />“Jije Yuda bi ɔmɛ a matsɛ ɔ nɛ a fɔ ɔ ngɛ? Wa na e dodoe ngɛ puje he lokoo nɛ wa ba nɛ wa ba ja lɛ.”<verse eid="MAT 2:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 2:3" />Sane nɛ ɔ hao Matsɛ Herode saminya, nɛ munyu ɔ gbɛ kɛ fia Yerusalem he tsuaa he.<verse eid="MAT 2:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 2:4" />Enɛ ɔ he je ɔ, Matsɛ Herode tsɛ Yudea osɔfo nikɔtɔma amɛ kpe nɛ e bi mɛ he nɛ gbali ɔmɛ tsɔɔ kaa a ma fɔ Yiwamihelɔ ɔ ngɛ ɔ.<verse eid="MAT 2:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 2:5" />A ha lɛ heto ke, “Ngɛ Betlehem, ejakaa bɔ nɛ Gbalɔ Mika ngma ji,<verse eid="MAT 2:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="MAT 2:6" />‘Mo Betlehem,</para>
  <para style="q2" vid="MAT 2:6">mo ji kɔpe nɛ klee we pe kulaa ngɛ Yudea zugba a nɔ,</para>
  <para style="q1" vid="MAT 2:6">se o mi nɛ matsɛ</para>
  <para style="q2" vid="MAT 2:6">nɛ ma kpaka ye ma Israel ɔ maa je.’ ”<verse eid="MAT 2:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 2:7" />Kɛkɛ nɛ Herode tsɔ ya tsɛ ni leli ɔmɛ zaa ke a ba na lɛ. Benɛ e kɛ mɛ kpe ɔ, e bi mɛ he tutuutu nɛ a na dodoe ɔ ngɛ. Jehanɛ ɔ, e de mɛ ke,<verse eid="MAT 2:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 2:8" />“Nyɛ ya hla bimwɔyo ɔ ngɛ Betlehem, nɛ ke nyɛ na lɛ ɔ, nyɛ ba de mi konɛ ami hu ma ya ja lɛ.”<verse eid="MAT 2:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 2:9" />Benɛ Herode kɛ ni leli ɔmɛ ye sɛ nɛ a pue blɔ ɔ, hlami dodoe ɔ je e he kpo ekohu nɛ e nyɛɛ a hɛ mi hluu kɛ ya si e ya da si ngɛ Betlehem he nɛ a fɔ bimwɔyo ɔ ngɛ ɔ tutuutu. <verse eid="MAT 2:9" /><verse number="10" style="v" sid="MAT 2:10" />Ni leli ɔmɛ a bua jɔ a he saminya!<verse eid="MAT 2:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 2:11" />Benɛ a ya sɛ we ɔ mi he nɛ bimwɔyo ɔ kɛ e nyɛ Maria ngɛ ɔ, a kpla si nɛ a ja lɛ, nɛ a ke lɛ sika tsu kɛ la su ku womi tsopa kɛ nu je via. <verse eid="MAT 2:11" /><verse number="12" style="v" sid="MAT 2:12" />Ni leli ɔmɛ gu blɔ kpa kɛ ho a je he ya. A ya gui Yerusalem nɛ a bɔ Matsɛ Herode amaniɛ, ejakaa Mawu de mɛ ngɛ nlami mi ke a ko ya gu Herode ngɔ hu.<verse eid="MAT 2:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 2:13" />Benɛ ni leli ɔmɛ je se ɔ, Mawu bɔfo ko ba je e he kpo kɛ tsɔɔ Yosef ngɛ nlami mi nɛ e de lɛ ke, “Matsɛ Herode ngɛ bimwɔyo ɔ hlae nɛ e gbe. Enɛ ɔ he je ɔ, moo te si nɛ o wo bimwɔyo ɔ kɛ ho Mizraim ya mla, nɛ nyɛ ya hi lejɛ ɔ kɛ ya si be nɛ i ma de nyɛ ekohu ke nyɛɛ kpale kɛ ba Betlehem.” <verse eid="MAT 2:13" /><verse number="14" style="v" sid="MAT 2:14" />Yosef ye bɔfo ɔ gbi ɔ nɔ nɛ e wo Maria kɛ bimwɔyo ɔ kɛ si Betlehem jamɛ a ligbi ɔ gbɔkuɛ ɔ nɔuu, <verse eid="MAT 2:14" /><verse number="15" style="v" sid="MAT 2:15" />nɛ a ya hi Mizraim kɛ ya si be nɛ a nu kaa Matsɛ Herode si je mi. Munyu nɛ ɔ ba mi kaa bɔ nɛ Gbalɔ Hosea gba ngɔ fɔ si ke, “I tsɛ ye bi ɔ kɛ je Mizraim” ɔ.<verse eid="MAT 2:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 2:16" />E dɔ Matsɛ Herode wawɛɛ kaa ni leli ɔmɛ ba gui e ngɔ nɛ a ba bɔ lɛ amaniɛ. Kɛkɛ nɛ e tsɔ sojahi kɛ ho ke a ya gbe binyumuwi nɛ ye kɛ je ligbi kake kɛ ya si jeha enyɔ loo nɔ́ ɔ kulaa ngɛ Betlehem kɛ e he kɔpe ɔmɛ a mi, ejakaa ni leli ɔmɛ de lɛ ke hlami dodoe ɔ je e he kpo kɛ tsɔɔ mɛ maa pee jeha enyɔ mi loko ji a kɛ ba e ngɔ ɔ nɛ. <verse eid="MAT 2:16" /><verse number="17" style="v" sid="MAT 2:17" />Yi mi wami ni tsumi nɛ Herode tsu nɛ ɔ ha nɛ gbami nɛ Yeremia gba kɛ fɔ si ɔ ba mi ke,<verse eid="MAT 2:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="MAT 2:18" />“Ya ngɛ pɛe, nɛ a ngɛ gbenɔ kɔmɔ yee ngɛ Rama.</para>
  <para style="q2" vid="MAT 2:18">Rahel ngɛ ya foe wawɛɛ nɛ e kplɛɛ we kpatami,</para>
  <para style="q2" vid="MAT 2:18">ejakaa e bi ɔmɛ tsuo gbo.”<verse eid="MAT 2:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 2:19" />Benɛ Herode gbo ɔ, Mawu bɔfo ko ba je e he kpo ngɔ tsɔɔ Yosef ngɛ Mizraim ekohu nɛ e de lɛ ngɛ nlami mi ke, <verse eid="MAT 2:19" /><verse number="20" style="v" sid="MAT 2:20" />“Moo te si nɛ o kpale bimwɔyo ɔ kɛ e nyɛ ɔ kɛ ho Israel zugba a nɔ ya ekohu, ejakaa nihi nɛ ngɛ jokuɛ ɔ hlae nɛ a gbe ɔ be je mi.”<verse eid="MAT 2:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 2:21" />Amlɔ ɔ nɔuu nɛ Yosef wo Maria kɛ Yesu kɛ pue blɔ kɛ ho Israel zugba a nɔ ya. <verse eid="MAT 2:21" /><verse number="22" style="v" sid="MAT 2:22" />Se benɛ a yaa ngɛ blɔ ɔ nɔ ɔ, Yosef tsui ya po benɛ e nu kaa nɔ nɛ ngɛ Herode nane mi yee ɔ ji e bi Arkelao. Kɛkɛ nɛ bɔfo ko ba de lɛ ngɛ nlami mi ekohu ke a ko ya Yudea. Enɛ ɔ he je ɔ, a ho Galilea zugba a nɔ ya nɛ a ya to kɔpe ko nɛ a tsɛɛ ke Nazaret ɔ mi. <verse eid="MAT 2:22" /><verse number="23" style="v" sid="MAT 2:23" />Nɛ enɛ ɔ ba mi kaa bɔ nɛ gbali ɔmɛ de kɛ fɔ si ke, “A ma tsɛ lɛ ke Nazaret no” ɔ.<verse eid="MAT 2:23" /></para>
  <chapter eid="MAT 2" />
  <chapter number="3" style="c" sid="MAT 3" />
  <para style="s1">Yohane Baptisilɔ ɔ ni tsumi sisi jemi</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 3:1" />Be mi nɛ Yesu kɛ e fɔli ɔmɛ ngɛ Nazaret ɔ, Yohane Baptisilɔ ɔ ngɛ fiɛe ngɛ Yudea nga a nɔ ke, <verse eid="MAT 3:1" /><verse number="2" style="v" sid="MAT 3:2" />“Nyɛɛ kpale ngɛ nyɛ yayami ɔmɛ a se, nyɛɛ ba Mawu ngɔ, ejakaa Hiɔwe Matsɛyemi ɔ su si ta.” <verse eid="MAT 3:2" /><verse number="3" style="v" sid="MAT 3:3" />Gbalɔ Yesaia tu Yohane Mawu Munyu fiɛmi nɛ ɔ he munyu momoomo nɛ e ngma ngɛ he ke,</para>
  <para style="q1" vid="MAT 3:3">“I nu nɛ nɔ ko ngɛ ngmlaa kpae ngɛ nga a nɔ ke,</para>
  <para style="q1" vid="MAT 3:3">‘Nyɛɛ je blɔ kɛ ha Nutsɔ ɔ.</para>
  <para style="q2" vid="MAT 3:3">Nyɛ dla blɔ nɛ Nutsɔ ɔ maa nyɛɛ nɔ ɔ nɛ e da tlɔmɔɔ!’ ”<verse eid="MAT 3:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 3:4" />Yohane ɔ, afukpɔngɔ he bwɔmi nɛ a kɛ lo e tade ɔ, nɛ e wo lohwe he womi ngɔ pee kpa nɛ e kɛ fi e mlɛ mi; nɛ e niye ni ji baalɛ kɛ nga nɔ hwo.<verse eid="MAT 3:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 3:5" />Nihi fuu je Yerusalem kɛ Yordan Dɔ ɔ mi kɛ Yudea zugba a nɔ he fɛɛ he kɛ ba e ngɔ ngɛ nga a nɔ ba bu e fiɛmi ɔ tue, <verse eid="MAT 3:5" /><verse number="6" style="v" sid="MAT 3:6" />nɛ e baptisi nihi nɛ nu a he sisi kaa yayami peeli ji mɛ ɔmɛ ngɛ Yordan Pa a mi.<verse eid="MAT 3:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 3:7" />Se benɛ Yohane na kaa Farisi bi ɔmɛ kɛ Saduki bi ɔmɛ hu a ti nihi fuu ma e ngɔ nɛ e baptisi mɛ ɔ, e de mɛ ke, “Sinɔhi a bimɛ, mɛnɔ slɔ nyɛ ke nyɛɛ ma Mawu abofu nɛ ma a nya fo? <verse eid="MAT 3:7" /><verse number="8" style="v" sid="MAT 3:8" />Loko ma baptisi nyɛ ɔ, nyɛɛ pee níhi nɛ maa tsɔɔ kaa nyɛ kpale ngɛ nyɛ yayami ɔmɛ a se. <verse eid="MAT 3:8" /><verse number="9" style="v" sid="MAT 3:9" />Nyɛ ko susu nɛ nyɛ de ke, wɔɔ lɛɛ wa ye wa he, ejakaa Abraham bimɛ ji wɔ. Se i ngɛ nyɛ dee ke Mawu ma nyɛ tsake tɛ nɛ ɔmɛ ngɛ hiɛ ɔ ngɔ pee bimɛ kɛ ha Abraham.<verse eid="MAT 3:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 3:10" />Amlɔ nɛ ɔ Mawu gbiɛ ɔ fɔɔ si ngɛ tso ɔmɛ a sisi, nɛ a maa po tso fɛɛ tso nɛ wui yiblii kpakpa a, nɛ a maa tsɔ lɛ la.<verse eid="MAT 3:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 3:11" />Ami lɛɛ nyu nɛ i ngɔ kɛ ngɛ nihi nɛ tsake a tsui ɔ baptisie; se nɔ ko ma nɛ kle pe mi; Jamɛ a nɔ ɔ kle hluu tsɔ pe mi bɔ nɛ i sɛ nɔ nɛ tlooɔ e tokotahi pohu! Lɛ ji nɔ nɛ ma ba baptisi nyɛ kɛ Mumi Klɔuklɔu ɔ kɛ la. <verse eid="MAT 3:11" /><verse number="12" style="v" sid="MAT 3:12" />E maa hla blɛfo ɔ ngɛ dudusa a mi nɛ e ma wo blɛfo ɔ ngɔ to blɛfo gba nɔ, nɛ e maa ngɔ dudusa a kɛ wo la nɛ be gboe gbleegbleegblee ɔ mi.”<verse eid="MAT 3:12" /></para>
  <para style="s1">Yesu baptisimi</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 3:13" />Kɛkɛ nɛ Yesu si Galilea kɛ ba Yordan Pa a nya konɛ Yohane nɛ baptisi lɛ. <verse eid="MAT 3:13" /><verse number="14" style="v" sid="MAT 3:14" />Se Yohane sume nɛ e baptisi lɛ nɛ e de lɛ ke, “Enɛ ɔ dɛ blɔ, ami mohu nɛ e he hia kaa o baptisi mi.”<verse eid="MAT 3:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 3:15" />Yesu ha Yohane heto ke, “Moo baptisi mi kɛkɛ. E sa nɛ ma pee nɔ́ tsuaa nɔ ngɛ e blɔ nɔ.” Kɛkɛ nɛ Yohane kplɛɛ nɛ e baptisi lɛ.<verse eid="MAT 3:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 3:16" />Benɛ Yohane baptisi Yesu ta nɛ e je kpo ngɛ nyu ɔ mi pɛ nɛ a bli hiɔwe nya ha lɛ, nɛ e na Mumi Klɔuklɔu ɔ nɛ ngɛ si kplee kaa obleku lahuɛ. <verse eid="MAT 3:16" /><verse number="17" style="v" sid="MAT 3:17" />Nɛ gbi ko pɛ kɛ je hiɔwe de ke, “Nɔ nɛ ɔ ji ye suɔmi Bi nɛ i naa e he bua jɔmi babauu ɔ nɛ.”<verse eid="MAT 3:17" /></para>
  <chapter eid="MAT 3" />
  <chapter number="4" style="c" sid="MAT 4" />
  <para style="s1">Yesu kami ɔ</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 4:1" />Jehanɛ ɔ Mumi Klɔuklɔu ɔ kpaka Yesu kɛ ho nga a nɔ ya konɛ Abosiami nɛ e ya ka lɛ ngɛ lejɛ ɔ. <verse eid="MAT 4:1" /><verse number="2" style="v" sid="MAT 4:2" />Benɛ Yesu hi ngma ngɛ nga a nɔ nyɔ kɛ pia ligbi nyingmi eywiɛ ɔ, hwɔ ba bɔni lɛ yemi wawɛɛ. <verse eid="MAT 4:2" /><verse number="3" style="v" sid="MAT 4:3" />Kɛkɛ nɛ Abosiami ba ka lɛ nɛ e de lɛ ke e ha nɛ tɛ ɔmɛ nɛ ngɛ lejɛ ɔ nɛ a plɛ abolo ha lɛ nɛ e ye. Abosiami tsa nɔ nɛ e de Yesu ke, “Ke o pee ja a, lɔ ɔ nɛ a ma kɛ na kaa Mawu Bi ji mo.”<verse eid="MAT 4:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 4:4" />Se Yesu ha lɛ heto nɛ e de lɛ ke, “Dabi! Mawu Munyu ɔ deɔ wɔ ke abolo kɛkɛ be adesa klaa yi wami nyɛe ma he, se Mawu Munyu ɔ nɔ yemi mohu nɛ he hia.”<verse eid="MAT 4:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 4:5" />Jehanɛ ɔ Abosiami ngɔ Yesu kɛ ho Yerusalem Sɔlemi We ɔ yi kpɛti ploplooplo ya nɛ e de lɛ ke, <verse eid="MAT 4:5" /><verse number="6" style="v" sid="MAT 4:6" />“Ke Mawu Bi ji mo tutuutu ɔ, moo tu kɛ je hiɛ ɔ kɛ ya ma si, ejakaa Mawu Munyu ɔ de ke,</para>
  <para style="q1" vid="MAT 4:6">‘Mawu maa tsɔ e bɔfo ɔmɛ</para>
  <para style="q2" vid="MAT 4:6">nɛ a maa bu o he</para>
  <para style="q2" vid="MAT 4:6">nɛ o be plaae.’ ”<verse eid="MAT 4:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 4:7" />Yesu ha Abosiami heto ke, “Mawu Munyu ɔ deɔ hu ke, ‘Mo ko ka Nutsɔ o Mawu ɔ yaka gu!’ ”<verse eid="MAT 4:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 4:8" />Yesu nya nɔɛ si tete nɛ Abosiami kata lɛ ekohu kɛ ho yoku gaga ko yi kpɛti ya nɛ e wo je ɔ mi mahi kɛ a mi akɔnɔ níhi tsuo ngɔ tsɔɔ lɛ nɛ e de lɛ ke, <verse eid="MAT 4:8" /><verse number="9" style="v" sid="MAT 4:9" />“Ma ngɔ ni nɛ ɔmɛ tsuo kɛ ha mo ke o ma kpla si kɛkɛ nɛ o ja mi.”<verse eid="MAT 4:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 4:10" />Yesu ha heto ke, “Abosiami, moo be kɛ ho ye se ya! Ejakaa a ngma ke, ‘Mo ja Tsaatsɛ Mawu pɛ, nɛ lɛ kɛkɛ tue o bu.’ ”<verse eid="MAT 4:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 4:11" />Kɛkɛ nɛ Abosiami si Yesu nɛ hiɔwe bɔfohi ba nɛ a ba sɔmɔ lɛ.<verse eid="MAT 4:11" /></para>
  <para style="s1">Yesu je e ni tsumi ɔ sisi</para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 4:12" />Benɛ Yesu nu kaa a nu Yohane kɛ wo tsu mi ɔ, e si Yudea nɛ e kpale kɛ ba Nazaret ngɛ Galilea. <verse eid="MAT 4:12" /><verse number="13" style="v" sid="MAT 4:13" />Se e kɛ we nɛ e kpale ke ba Kapernaum ngɛ Galilea Wo ɔ nya ngɛ Zebulon kɛ Naftali kasa mi. <verse eid="MAT 4:13" /><verse number="14" style="v" sid="MAT 4:14" />Enɛ ɔ ha nɛ Gbalɔ Yesaia munyu ɔ ba mi kaa,<verse eid="MAT 4:14" /></para>
  <para style="q1">
    <verse number="15-16" style="v" sid="MAT 4:15-16" />“La agbo ko kpɛ ha nibwɔhi nɛ ngɛ diblii mi ngɛ Zebulon kɛ Naftali,</para>
  <para style="q2" vid="MAT 4:15-16">mahi nɛ ngɛ Yordan Pa a he</para>
  <para style="q2" vid="MAT 4:15-16">kɛ Galilea zugba a se ɔ.”<verse eid="MAT 4:15-16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 4:17" />Nɛ Yesu bɔni fiɛmi kɛ je jamɛ a be ɔ mi ke, “Nyɛɛ kpale ngɛ nyɛ yayami ɔmɛ a se nɛ nyɛ ba sa we ngɛ Mawu ngɔ, ejakaa Hiɔwe Matsɛyemi ɔ su si ta.”<verse eid="MAT 4:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 4:18" />Ligbi ko benɛ Yesu ngɛ si slaae ngɛ Galilea Wo ɔ nya a, e na nyɛmimɛ wo hɛli enyɔ komɛ nɛ ji Simon nɛ a tsɛɛ lɛ ke Petro ɔ kɛ Andrea nɛ a ngɛ hɛe.<verse eid="MAT 4:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 4:19" />Yesu tsɛ mɛ nɛ e de mɛ ke, “Nyɛɛ ba nɛ nyɛ ba nyɛɛ ye se nɛ i ma pee nyɛ adesahi a klaahi a yi wami heli.” <verse eid="MAT 4:19" /><verse number="20" style="v" sid="MAT 4:20" />Yesu nya nɔɛ si nɛ Simon kɛ Andrea si a ya amɛ nɛ a fie e se.<verse eid="MAT 4:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 4:21" />Benɛ e yaa bɔɔ ngɛ wo ɔ nya a, e ya na nyɛmimɛ enyɔ kpahi nɛ a tsɛɛ mɛ ke Yakobo ke Yohane kɛ a tsɛ Zebedeo nɛ a ngɛ ya mi kpɛe ngɛ lɛ mi nɛ e tsɛ mɛ hu. <verse eid="MAT 4:21" /><verse number="22" style="v" sid="MAT 4:22" />Oya a nɔuu nɛ a jɔɔ ni tsumi ɔ. Kɛkɛ nɛ a si a tsɛ nɔmoyo ɔ nɛ a fie e se.<verse eid="MAT 4:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 4:23" />Yesu kpa si ngɛ Galilea zugba a nɔ tsuo nɛ e fiɛ Hiɔwe Matsɛyemi ɔ he Manye Munyu ɔ ngɛ Yuda bi ɔmɛ a kpe he ɔmɛ, nɛ e tsa hiɔ fɛɛ hiɔ. <verse eid="MAT 4:23" /><verse number="24" style="v" sid="MAT 4:24" />E nyakpɛ hiɔ tsami ɔ gbɛ kɛ fia Galilea zugba a nɔ tsuo. Enɛ ɔ he je ɔ, a ngɔ hiɔtsɛmɛ slɔɔtohi nɛ ji nihi nɛ hɛɛ mumi yayami hiɔhi, godotsɛhi kɛ nihi nɛ hule pue si nɛ a kɛ mɛ je tsitsaa hehi ke Siria tete kɛ ba e ngɔ nɛ e tsa mɛ kulaa. <verse eid="MAT 4:24" /><verse number="25" style="v" sid="MAT 4:25" />Enɛ ɔ ha nɛ nihi fuu je Galilea kɛ e he ma nyɔngma amɛ nɛ a tsɛɛ ke Dekapoli ɔmɛ a mi, kɛ Yerusalem kɛ Yudea kɛ Yordan Pa a se nɛ a ba bɔni e se nyɛɛmi.<verse eid="MAT 4:25" /></para>
  <chapter eid="MAT 4" />
  <chapter number="5" style="c" sid="MAT 5" />
  <para style="s1">Yoku nɔ fiɛmi ɔ</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 5:1" />Ligbi ko ɔ, benɛ nihi fuu bɔni a he nya buami ɔ, Yesu kɛ e kaseli ɔmɛ je kɛ ho yoku ko nɔ ya, nɛ benɛ a ya hi si ɔ, <verse eid="MAT 5:1" /><verse number="2" style="v" sid="MAT 5:2" />e tsɔɔ mɛ ni ke,<verse eid="MAT 5:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 5:3" />“A gbaa nihi nɛ baa a he si, ejakaa a nɔ ji Hiɔwe Matsɛyemi ɔ. <verse eid="MAT 5:3" /><verse number="4" style="v" sid="MAT 5:4" />A gbaa nihi nɛ ngɛ kɔmɔ yee, ejakaa a maa jɔɔ a bua. <verse eid="MAT 5:4" /><verse number="5" style="v" sid="MAT 5:5" />A gbaa nihi nɛ a he jɔ, ejakaa a nɔ ji je ɔ tsuo.<verse eid="MAT 5:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 5:6" />A gbaa nihi nɛ dami sane yemi he hwɔ kɛ kuma yee mɛ, ejakaa a maa tɔ. <verse eid="MAT 5:6" /><verse number="7" style="v" sid="MAT 5:7" />A gbaa nihi nɛ a mi jɔ nɛ a naa mɔbɔ, ejakaa a maa na mɛ mɔbɔ. <verse eid="MAT 5:7" /><verse number="8" style="v" sid="MAT 5:8" />A gbaa nihi nɛ a tsui mi tsɔ, ejakaa a maa na Mawu. <verse eid="MAT 5:8" /><verse number="9" style="v" sid="MAT 5:9" />A gbaa nihi nɛ kpataa pɛ, ejakaa a ma tsɛ mɛ Mawu bimɛ. <verse eid="MAT 5:9" /><verse number="10" style="v" sid="MAT 5:10" />A gbaa nihi nɛ a ngɛ mɛ yi kpɛti wae ngɛ a kpakpa peemi he, ejakaa a nɔ ji Hiɔwe Matsɛyemi ɔ.<verse eid="MAT 5:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 5:11" />A gbaa nyɛ ke a jɛ nyɛ nɛ a wa nyɛ yi mi nɛ a ngɔ nya kɛ po nyɛ nya ngɛ ye he, ejakaa ye se nyɛɛli ji nyɛ ɔ. <verse eid="MAT 5:11" /><verse number="12" style="v" sid="MAT 5:12" />Nyɛ nya nɛ nyɛ bua nɛ jɔ, ejakaa hiɔwo agbo ko fɔɔ si ha nyɛ ngɛ hiɔwe; nɛ nyɛ kai kaa ja a nɔuu nɛ a wa blema gbali ɔmɛ yi mi.<verse eid="MAT 5:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 5:13" />Nyɛ ji ngo ngɛ zugba a nɔ. Ke nyɛ nya nyu gbo ɔ, kɛ je ɔ maa pee kɛɛ? Ke e ba mi ja a, a ma sake nyɛ ngɔ pue he nɛ a maa naa nyɛ nɔ kaa nɔ́ ko nɛ se nami be he. <verse eid="MAT 5:13" /><verse number="14" style="v" sid="MAT 5:14" />Nyɛ ji la nɛ ngɛ kpɛe ha je ɔ tsuo, nɛ nyɛ ngɛ kaa ma nɛ maa si ngɛ yoku nɔ. <verse eid="MAT 5:14" /><verse number="15" style="v" sid="MAT 5:15" />Nyɛ ko wo nyɛ la a kɛ laa, se mohu nyɛ je lɛ kpo nɛ e tso ha nɔ tsuaa nɔ. <verse eid="MAT 5:15" /><verse number="16" style="v" sid="MAT 5:16" />Nyɛ ha nɛ a na nyɛ ni kpakpa peemi ɔmɛ nɛ a je nyɛ tsɛ nɛ ngɛ hiɔwe ɔ yi.<verse eid="MAT 5:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 5:17" />Nyɛ ko susu kaa Mose mlaa amɛ kɛ gbali ɔmɛ a si womi ɔmɛ a gumi he nɛ i ba ngɛ. Dabi, i ba nɛ ma ba fi mlaa amɛ a se nɛ ma ha si womi ɔmɛ a ba mi. <verse eid="MAT 5:17" /><verse number="18" style="v" sid="MAT 5:18" />Anɔkuale nɛ i ngɛ nyɛ dee ke, a ma tsu mlaa tsuaa mlaa he ni kaa bɔ nɛ e ngɛ mlaa womi ɔ mi ɔ kɛ ya si be nɛ a maa gbe nɔ́ tsuaa nɔ nya. <verse eid="MAT 5:18" /><verse number="19" style="v" sid="MAT 5:19" />Enɛ ɔ he je ɔ, ke nyɛ ti nɔ ko tɔ mlaa amɛ a ti nyafii ko nɔ nɛ e tsɔɔ ni kpahi hu nɛ a pee ja a, Jamɛ a nɔmlɔ ɔ maa pee nyafii pe kulaa ngɛ Hiɔwe Matsɛyemi ɔ mi. Se nihi nɛ tsɔɔ Mawu mlaa amɛ nɛ a yeɔ a nɔ ɔ, a maa pee agbo ngɛ Hiɔwe Matsɛyemi ɔ mi.<verse eid="MAT 5:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 5:20" />Se i ngɛ nyɛ si woe kaa ja nyɛ dami kle pe Farisi bi ɔmɛ kɛ Yuda nikɔtɔma amɛ a nɔ́, ke pi ja a, nyɛ be Hiɔwe Matsɛyemi ɔ mi nyɛe maa sɛ.”<verse eid="MAT 5:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 5:21" />“A de nyɛ ngɛ Mose mlaa a nya ke, ‘Ke nɔ ko gbe nɔ ko ɔ, e sa nɛ a gbe lɛ hu.’ <verse eid="MAT 5:21" /><verse number="22" style="v" sid="MAT 5:22" />Se ami lɛɛ i ngɛ nyɛ dee ke, a maa kojo nɔ nɛ ma na e nyɛmi he abofu tete; ja a nɔuu nɛ a maa kojo nɔ nɛ ma jɛ e nyɛmi ke yaka nɔmlɔ ji lɛ ɔ. Nɛ a maa bu nɔ nɛ maa gbiɛ e nyɛmi ɔ la gbenɔ fɔ.<verse eid="MAT 5:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 5:23" />Enɛ ɔ he je ɔ, ke nyɛ ti nɔ ko yaa sã bɔ ha Mawu, nɛ e kai ngɛ bɔ sami la tɛ ɔ he kaa e kɛ e nyɛmi ko ngɛ pɛe ɔ, <verse eid="MAT 5:23" /><verse number="24" style="v" sid="MAT 5:24" />e je bɔ sami ni ɔmɛ a he ngɛ lejɛ ɔ nɛ e ya nɛ e kɛ e pɛlɔ ɔ ya dla loko ji e kpale ba sã bɔ ɔ kɛ ha Mawu. <verse eid="MAT 5:24" /><verse number="25" style="v" sid="MAT 5:25" />O kɛ o pɛlɔ ɔ nɛ dla mla; se ke pi ja a, e ma wo mo kɛ ho kojomi he ɔ ya nɛ a maa wo mo tsu mi. <verse eid="MAT 5:25" /><verse number="26" style="v" sid="MAT 5:26" />Nɛ i ngɛ mo dee ke o maa hi tsu ɔ mi kɛ ya si be nɛ o maa wo hiɔ nɛ a bɔ mo ɔ tsuo.”<verse eid="MAT 5:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 5:27" />“Mose mlaa a de ke, ‘Koo bɔ ajuama.’ <verse eid="MAT 5:27" /><verse number="28" style="v" sid="MAT 5:28" />Se i ngɛ nyɛ dee ke, nɔ nɛ maa hyɛ yo nɛ e hɛ maa kɔ e nɔ ɔ, e bɔ ajuama ngɛ e tsui mi momo. <verse eid="MAT 5:28" /><verse number="29" style="v" sid="MAT 5:29" />Enɛ ɔ he je ɔ, ke o hɛ ngmɛ nɛ haa o hyɛɔ nɔ́ ɔ tete nɛ haa o peeɔ yayami ɔ, moo hia lɛ nɛ o sake lɛ kɛ fɔ he, ejakaa e fani kaa o nɔmlɔ tso ɔ he ko ma puɛ pe nɔ́ nɛ a ma sake o nɔmlɔ tso ɔ tsuo kɛ fɔ Abosiami la mi. <verse eid="MAT 5:29" /><verse number="30" style="v" sid="MAT 5:30" />Ja a nɔuu ke o hiɔ nine tete po haa nɛ o peeɔ yayami ɔ, moo po lɛ nɛ o sake lɛ kɛ fɔ Abosiami la mi.”<verse eid="MAT 5:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 5:31" />“Mose mlaa a de ke, ‘Ke nɔ ko ngɛ hlae nɛ e ngmɛɛ e yo he ɔ, e ha lɛ fiemi womi.’ <verse eid="MAT 5:31" /><verse number="32" style="v" sid="MAT 5:32" />Se i ngɛ nyɛ dee ke, ke nɔ ko fie e yo nɛ tsa pi ajuama bɔmi he i ɔ, ke yo ɔ ya gba ekohu ɔ, lɛ nɛ e ha nɛ yo ɔ bɔ ajuama; nɛ nɔ nɛ maa ngɔ jamɛ a yo ɔ nɛ e huno fie lɛ ɔ, lɛ hu e bɔ ajuama.”<verse eid="MAT 5:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 5:33" />“Mose mlaa a de hu ke, ‘Mo ko tɔ si nɛ o wo Mawu ɔ nɔ, se mohu o ye kulaa nɔ pɛpɛɛpɛ.’ <verse eid="MAT 5:33" /><verse number="34" style="v" sid="MAT 5:34" />Se ami lɛɛ i ngɛ nyɛ dee ke, nyɛ ko ka kita ko! Nyɛ ko ka hiɔwe tete, ejakaa Mawu Matsɛyemi sɛ ji hiɔwe ɔ nɛ. <verse eid="MAT 5:34" /><verse number="35" style="v" sid="MAT 5:35" />Nɛ nyɛ ko de hu ke, ‘I na zugba’, ejakaa Mawu nane ma he ji zugba a nɛ. Ja a nɔuu nɛ e sɛ kaa nyɛ kaa Yerusalem, ejakaa Matsɛ agbo ma ngua i. <verse eid="MAT 5:35" /><verse number="36" style="v" sid="MAT 5:36" />Nyɛ ko ka kita nɛ nyɛ de ke, ‘I na ye yi!’ Ejakaa nyɛ be nyɛe ma plɛ yi bwɔmi kake futaa loo yumuu. <verse eid="MAT 5:36" /><verse number="37" style="v" sid="MAT 5:37" />Nyɛ ha sane heto nɛ nyɛ de kɛkɛ ke, ‘Ee’, loo ‘Dabi’. Nya mi munyu kɛkɛ hiɛ, Nɛ kaa o ma ka kita kɛ fɔ si womi nɔ ɔ, e tsɔɔ kaa nɔ́ ko dɛ.”<verse eid="MAT 5:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="MAT 5:38" />“Mose mlaa amɛ eko deɔ ke, ‘Ke nɔ ko hia e nyɛmi e hɛ ngmɛ loo e lungu ɔ, lɛ hu e hia e nɔ kɛ to nane mi.’ <verse eid="MAT 5:38" /><verse number="39" style="v" sid="MAT 5:39" />Se ami lɛɛ i ngɛ nyɛ dee ke, nyɛ ko ngɔ yayami kɛ to yayami nane mi. Ke nɔ ko gba o tue mi hiɛ ɔ, mo plɛ lejɛ ɔ hu ha lɛ nɛ e gba. <verse eid="MAT 5:39" /><verse number="40" style="v" sid="MAT 5:40" />Nɛ ke a nu mo kɛ ho kojomi he ya nɛ a kpɔ o sisi tade ɔ, moo ngɔ o hiɔwe tade ɔ hu ngɔ piɛ he ha mɛ. <verse eid="MAT 5:40" /><verse number="41" style="v" sid="MAT 5:41" />Nɛ ke sojahi nyɛ o nɔ ke o tloo a ta hwumi níhi ha mɛ kɛ ya si tomi he kake ɔ, moo tloo kɛ ya si tomi he enyɔ. <verse eid="MAT 5:41" /><verse number="42" style="v" sid="MAT 5:42" />Ke nɔ ko bi nyɛ nɔ́ ko ɔ nyɛ ha lɛ, nɛ nɔ́ palɔ hu nyɛ ko nyɛ lɛ nɔ́ he.”<verse eid="MAT 5:42" /></para>
  <para style="p">
    <verse number="43" style="v" sid="MAT 5:43" />“Nyɛ nuɔ nɛ a deɔ ke, ‘Moo suɔ o huɛmɛ nɛ o nyɛ o he nyɛli.’ <verse eid="MAT 5:43" /><verse number="44" style="v" sid="MAT 5:44" />Se i ngɛ nyɛ dee ke, Nyɛɛ suɔ nyɛ he nyɛli nɛ nyɛɛ sɔle ha nihi nɛ peeɔ nyɛ yayami ɔ. <verse eid="MAT 5:44" /><verse number="45" style="v" sid="MAT 5:45" />Ke nyɛ pee ja a, e tsɔɔ kaa hiɔwe Tsɛ ɔ bimɛ ji nyɛ niinɛ. Ejakaa e haa nɛ pu tsoo kɛ haa nimli yayamihi kɛ nimli kpakpahi tsuo, nɛ e haa hiɔmi nɛɛ kɛ haa dali kɛ yayami peeli tsuo. <verse eid="MAT 5:45" /><verse number="46" style="v" sid="MAT 5:46" />Mɛni hiɔwo nɛ nyɛ ma na ke nyɛ suɔ nihi nɛ suɔ nyɛ? Ejakaa yayami peeli hu peeɔ ja a nɔuu. <verse eid="MAT 5:46" /><verse number="47" style="v" sid="MAT 5:47" />Ke nyɛ suɔli kɛkɛ a sane nyɛ suɔ kaa bɔ nɛ yayami peeli ɔmɛ peeɔ ɔ, lɛɛ mɛni mi gbami ngɛ nyɛɛ kɛ mɛ nyɛ kpɛti? <verse eid="MAT 5:47" /><verse number="48" style="v" sid="MAT 5:48" />E sa nɛ nyɛɛ lɛɛ nyɛɛ hi kɛ pi si kaa bɔ nɛ nyɛ hiɔwe Tsɛ ɔ hi kɛ pi si ɔ.”<verse eid="MAT 5:48" /></para>
  <chapter eid="MAT 5" />
  <chapter number="6" style="c" sid="MAT 6" />
  <para style="p">
    <verse number="1" style="v" sid="MAT 6:1" />“Nyɛɛ hyɛ saminya nɛ nyɛ kpakpa peemi nɛ ko ya pee he tsɔɔmi ngɛ ma hɛ mi bɔ nɛ pee nɛ a je nyɛ yi. Ke nyɛ pee ja a, nyɛ hiɔwe Tsɛ ɔ hiɔwo ɔ ma bɔ nyɛ. <verse eid="MAT 6:1" /><verse number="2" style="v" sid="MAT 6:2" />Ke nyɛ ke nɔ́ balɔ ko nɔ́ ko ɔ, nyɛ ko tsi nɔ ta nɛ ma nɛ nu kaa bɔ nɛ osatotsɛ ɔmɛ peeɔ nɛ a kpaa bɛ ngɛ kpe he ɔmɛ kɛ gbɛjegbɛ ɔmɛ a nɔ nɛ nihi nɛ a na kpakpa nɛ a peeɔ ɔ. Anɔkuale ji kaa a nine be hiɔwo kpa ko nɔ sue hu. <verse eid="MAT 6:2" /><verse number="3" style="v" sid="MAT 6:3" />Se nyɛɛ lɛɛ nyɛ ha nɛ nyɛ kpakpa peemi nɛ e hi laami mi. Nyɛ ko ha nɛ nyɛ muɔ nine po nɛ e le nɔ́ nɛ hiɔ nine ngɛ pee. <verse eid="MAT 6:3" /><verse number="4" style="v" sid="MAT 6:4" />Nɛ nyɛ Tsɛ ɔ nɛ naa laami mi ni ɔ, maa wo nyɛ hiɔ.”<verse eid="MAT 6:4" /></para>
  <para style="s1">Sɔlemi kɛ ngma himi</para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 6:5" />“Jehanɛ ɔ ngɛ sɔlemi blɔ fa mi ɔ, nyɛ ko sɔle kaa bɔ nɛ osatotsɛ ɔmɛ sɔleɔ ngɛ kpe hehi kɛ he nɛ nihi fuu bua a he nya ngɛ bɔ nɛ pee nɛ a na mɛ ɔ. Anɔkuale, lɔ ɔ pɛ ji hiɔwo nɛ a ma na. <verse eid="MAT 6:5" /><verse number="6" style="v" sid="MAT 6:6" />Se nyɛɛ lɛɛ ke nyɛ maa sɔle ɔ, nyɛɛ sɛ tsu mi nɛ nyɛ nga sinya kɛ wo nyɛ yi, nɛ nyɛɛ sɔle zaa ha nyɛ Tsɛ Ope ɔ nɛ le nyɛ laami sane ɔmɛ tsuo ɔ nɛ e maa wo nyɛ hiɔ.<verse eid="MAT 6:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 6:7" />Ke nyɛ ngɛ sɔlee ɔ, nyɛ ko ti Sɔlemi ɔ mi kaa bɔ nɛ wɔ jali ɔmɛ peeɔ ɔ, ejakaa a susuu kaa enɛ ɔ nɛ ma ha nɛ a nine maa su a ni bimi ni ɔmɛ a nɔ. <verse eid="MAT 6:7" /><verse number="8" style="v" sid="MAT 6:8" />Nyɛ ko pee kaa mɛ, ejakaa nyɛ Tsɛ ɔ le nyɛ hiami ni ɔmɛ momo loko ji nyɛ biɔ lɛ.<verse eid="MAT 6:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 6:9" />Enɛ ɔ he je ɔ nyɛɛ Sɔle ke, Wa Tsɛ nɛ ngɛ hiɔwe, o biɛ ɔ he nɛ tsɔ. <verse eid="MAT 6:9" /><verse number="10" style="v" sid="MAT 6:10" />O Matsɛyemi ɔ nɛ ba. A pee nɔ́ nɛ o suɔ ngɛ zugba a nɔ kaa bɔ nɛ a peeɔ ngɛ hiɔwe ɔ. <verse eid="MAT 6:10" /><verse number="11" style="v" sid="MAT 6:11" />Mo ha wɔ mwɔnɛ ɔ wa daa nya ngma, <verse eid="MAT 6:11" /><verse number="12" style="v" sid="MAT 6:12" />nɛ o kɛ wa he yayami ɔmɛ nɛ ke wɔ, kaa bɔ nɛ wɔ hu waa kɛ kee nihi nɛ tɔɔ wa nɔ ɔ. <verse eid="MAT 6:12" /><verse number="13" style="v" sid="MAT 6:13" />Nɛ o kɛ wɔ nɛ ko ya kami mi, se mohu o je wɔ kɛ je yayami mi. Amen. <verse eid="MAT 6:13" /><verse number="14" style="v" sid="MAT 6:14" />Nyɛ Tsɛ nɛ ngɛ hiɔwe ɔ kɛ nyɛ tɔmi ɔmɛ maa ke nyɛ ke nyɛ hu nyɛ kɛ nihi a tɔmihi kɛ e mɛ ɔ. <verse eid="MAT 6:14" /><verse number="15" style="v" sid="MAT 6:15" />Se ke nyɛ kɛ ki mɛ ɔ, lɛ hu e kɛ nyɛ tɔmi ɔmɛ be nyɛ kɛ e.<verse eid="MAT 6:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 6:16" />Nɛ ke nyɛ ngɛ hwɔ hae ɔ, nyɛ ko pee nyɛ hɛ mi mɔbɔmɔbɔ kɛ tsɔɔ nɛ a na kaa bɔ nɛ osatotsɛ ɔmɛ peeɔ a hɛ mi nyanyaanya bɔ nɛ pee nɛ nihi nɛ a na nɛ a he mɔbɔ nɛ pee mɛ ɔ. Anɔkuale, lɔ ɔ pɛ ji hiɔwo nɛ a ma na. <verse eid="MAT 6:16" /><verse number="17" style="v" sid="MAT 6:17" />Se nyɛɛ lɛɛ ke nyɛ ngɛ hwɔ hae ɔ, nyɛ dla nyɛ hɛ mi saminya, <verse eid="MAT 6:17" /><verse number="18" style="v" sid="MAT 6:18" />bɔ nɛ pee nɛ nɔ ko ko na kaa hwɔ ngɛ nyɛ yee, ja nyɛ Tsɛ nɛ ngɛ hiɔwe ɔ pɛ, nɔ nɛ naa laami mi ni ɔ, nɛ lɛ e maa wo nyɛ hiɔ.<verse eid="MAT 6:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 6:19" />Nyɛ ko ngɔ nyɛ june ɔmɛ kɛ to ngɛ zugba nɛ ɔ nɔ he nɛ a ma puɛ loo he nɛ julɔ maa ju mɛ ngɛ. <verse eid="MAT 6:19" /><verse number="20" style="v" sid="MAT 6:20" />Nyɛɛ ngɔ nyɛ níhi nɛ a he jua wa amɛ kɛ to ngɛ hiɔwe he nɛ a hɛ mi be kpatae ngɛ, nɛ julɔ ko hu be mɛ jue ngɛ ɔ. <verse eid="MAT 6:20" /><verse number="21" style="v" sid="MAT 6:21" />Ejakaa ke nyɛ weto ni ɔmɛ ngɛ hiɔwe ɔ, lejɛ ɔ nɔuu nɛ nyɛ tsui hu maa hi.<verse eid="MAT 6:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 6:22" />Ke o hɛ ngmɛ nɔ tsɔ ɔ, o klaa he maa tɛ. <verse eid="MAT 6:22" /><verse number="23" style="v" sid="MAT 6:23" />Se ke susumi yayahi ha o hɛ ngmɛ nɔ ɔ, o nɔmlɔ tso ɔ kulaa maa wo mumi mi diblii kpii. <verse eid="MAT 6:23" /><verse number="24" style="v" sid="MAT 6:24" />Nɔ ko be nutsɔmɛ enyɔ nyɛe ma sɔmɔ, Mawu kɛ sika. Ejakaa o be mɛ tsuo nyɛe ma sɔmɔ, o maa suɔ nɔ kake pe nɔ kake.<verse eid="MAT 6:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 6:25" />Enɛ ɔ he je ɔ, i ngɛ nyɛ dee ke, nyɛ ko hao nyɛ he ngɛ nɔ́ nɛ nyɛ maa ye, nɔ́ nɛ nyɛ maa nu kɛ nɔmlɔ tso he hami níhi a he. Ejakaa nyɛ ngɛ nɔmlɔ tso he wami momo, nɛ lɔ ɔ he hia pe nɔ́ nɛ nyɛ maa ye kɛ bo nɛ nyɛ ma bu. <verse eid="MAT 6:25" /><verse number="26" style="v" sid="MAT 6:26" />Nyɛɛ hyɛ lohwe pɛlitsɛ ɔmɛ ha! A gbo we niye ni he dengme, a du we ni nɛ a kpa we ni hulɔ, nɛ a be niye ni gba, se nyɛ Tsɛ nɛ ngɛ hiɔwe ɔ lɛɛ mɛ daa. Anɛ nyɛ he be se nami hluu ha lɛ pe mɛ lo? <verse eid="MAT 6:26" /><verse number="27" style="v" sid="MAT 6:27" />Anɛ ke nyɛ hao nyɛ he ɔ, lɔ ɔ ma ha nɛ nyɛ se maa kɛ ngɛ je ɔ mi lo?<verse eid="MAT 6:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 6:28" />Mɛni he je nɛ nyɛ haoɔ nyɛ he ngɛ bo nɛ nyɛ ma bu he? Nyɛɛ hyɛ nga nɔ mɔmɔ ɔmɛ ha! A yi tsui ngɛ a nɔ́ he. <verse eid="MAT 6:28" /><verse number="29" style="v" sid="MAT 6:29" />Se i ngɛ nyɛ dee ke, Matsɛ Salomo he fɛu ɔ sui a nɔ́ ɔ nya. <verse eid="MAT 6:29" /><verse number="30" style="v" sid="MAT 6:30" />Nɛ ke Mawu baa mɔmɔhi nɛ wa naa mwɔnɛ ɔ se hwɔ pɛ a gbo a yi ɔ, e be nyɛe maa baa nyɛ yi lo, nyɛ nihi nɛ nyɛ hemi kɛ yemi pi ɔ?<verse eid="MAT 6:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 6:31" />Enɛ ɔ he je ɔ, nyɛ ko hao nyɛ he ngɛ niye ni kɛ he hami níhi a he <verse eid="MAT 6:31" /><verse number="32" style="v" sid="MAT 6:32" />kaa bɔ nɛ je mi bi ɔmɛ peeɔ ɔ. Ejakaa mɛɛ lɛɛ a dii ni nɛ ɔmɛ a se kɛ hɛ dɔ. Se nyɛ Tsɛ nɛ ngɛ hiɔwe ɔ le kaa ni nɛ ɔmɛ a he hia nyɛ. <verse eid="MAT 6:32" /><verse number="33" style="v" sid="MAT 6:33" />Nɛ e maa ngɔ ni nɛ ɔmɛ tsuo kɛ ha nyɛ ke nyɛ ngɔ nyɛ he kɛ ha lɛ nɛ nyɛ hi si kaa bɔ nɛ e ngɛ hlae ɔ.<verse eid="MAT 6:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 6:34" />Enɛ ɔ he je ɔ, nyɛ ko hao nyɛ he ngɛ hwɔɔ je nɛ maa na he, nyɛ ko hao ejakaa Mawu maa to hwɔɔ he blɔ nya kɛ ha nyɛ. Hwɔɔ hu je ngua nɛ maa na.”<verse eid="MAT 6:34" /></para>
  <chapter eid="MAT 6" />
  <chapter number="7" style="c" sid="MAT 7" />
  <para style="p">
    <verse number="1" style="v" sid="MAT 7:1" />“Nyɛ ko kojo nɔ ko konɛ a ko kojo nyɛ hu. <verse eid="MAT 7:1" /><verse number="2" style="v" sid="MAT 7:2" />Ejakaa nɔ́ nɛ o ma kɛ pee nɔ ko ɔ, jamɛ a nɔ́ ɔ nɔuu nɛ a ma kɛ pee mo hu. <verse eid="MAT 7:2" /><verse number="3" style="v" sid="MAT 7:3" />Se mɛni he je nɛ o naa ngu nyafii nɛ ngɛ o nyɛmi hɛ ngmɛ nɔ ɔ, se mo nitsɛ o nɔ́ agbo ɔ lɛɛ o nɛ? <verse eid="MAT 7:3" /><verse number="4" style="v" sid="MAT 7:4" />Nɛ kɛ peeɔ kɛɛ nɛ o deɔ ke, Anyɛmi, mo ha nɛ ma je ngu bɔbɔyoo ɔ ngɛ o hɛ ngmɛ nɔ ha mo, be mi nɛ mo nitsɛ o nɔ́ ɔ maa si kaa koku nɛ o hyɛ we nɔ́. <verse eid="MAT 7:4" /><verse number="5" style="v" sid="MAT 7:5" />Osatotsɛ! Mo je o ngu agbo ɔ kekle loko ji o ma nyɛ ye ke bua o nyɛmi ɔ.<verse eid="MAT 7:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 7:6" />Nyɛ ko ngɔ níhi nɛ ngɛ klɔuklɔu kɛ ha nihi nɛ a he tsɔ we, nɛ nyɛ ko sake nyɛ june ngɔ pue si ngɛ kpotoohi a hɛ mi, ejakaa a maa naa nɔ nɛ a ma tua nyɛ hulɔ.<verse eid="MAT 7:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 7:7" />Nyɛ bi, nɛ a ma ha nyɛ; nyɛ hla, nɛ nyɛ maa na; nyɛ si, nɛ a ma bli ha nyɛ. <verse eid="MAT 7:7" /><verse number="8" style="v" sid="MAT 7:8" />Ejakaa nɔ tsuaa nɔ nɛ biɔ ɔ, e nine suu nɔ, nɛ nɔ tsuaa nɔ nɛ hlaa a, e naa; nɛ nɔ nɛ siɔ ɔ, a bliɔ haa lɛ. <verse eid="MAT 7:8" /><verse number="9" style="v" sid="MAT 7:9" />Tsɛ te nɔ nɛ ke e bi bi lɛ abolo nɛ e ma ha lɛ tɛ nɛɛ? <verse eid="MAT 7:9" /><verse number="10" style="v" sid="MAT 7:10" />Aloo ke e bi bi lɛ lo nɛ e ma ha lɛ sinɔ duɔtsɛ nɛɛ? Dabi! <verse eid="MAT 7:10" /><verse number="11" style="v" sid="MAT 7:11" />Lɛɛ ke nyɛ nimli yayamihi nyɛ le bɔ nɛ a kɛ e bimɛ ni kpakpahi ɔ, anɛ nyɛ he we yi kaa nyɛ Tsɛ nɛ ngɛ hiɔwe ɔ maa ngɔ ni kpakpahi kɛ ke nihi nɛ biɔ lɛ ɔ lo?<verse eid="MAT 7:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 7:12" />Nɔ́ nɛ nyɛ maa suɔ kaa nihi nɛ a pee ha nyɛ ɔ, nyɛ hu nyɛɛ pee ja a nɔuu ha mɛ. Enɛ ɔ ji Mose mlaa amɛ kulaa a kpiti pomi.”<verse eid="MAT 7:12" /></para>
  <para style="s1">Hiɔwe yami blɔ</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 7:13" />“Nyɛɛ sɛ agbo nɛ bli we ɔ mi, ejakaa agbo nɛ bli ɔ kɛ blɔ gbajaa nɛ nɔ nyɛɛmi yi ɔ kɛ nɔ yaa hɛ mi kpatami mi, nɛ nihi fuu nɛ sɛɛ mi. <verse eid="MAT 7:13" /><verse number="14" style="v" sid="MAT 7:14" />Se agbo nɛ bli we ɔ nɛ e kɛ nɔ yaa neneene wami mi ɔ nɛ, nɛ nihi bɔɔ pɛ nɛ naa jamɛ a blɔ ɔ.<verse eid="MAT 7:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 7:15" />Nyɛɛ hyɛ nyɛ he saminya ngɛ lakpa tsɔɔli ɔmɛ a he. Ejakaa a ngɔɔ jijɔ he womi kɛ haa a he kɛ baa nyɛ ngɔ nɛ nyɛ naa mɛ kaa a hi, se a mi je ɔ, ogbeteehi ji mɛ, nɛ a ma kpata nyɛ hɛ mi. <verse eid="MAT 7:15" /><verse number="16" style="v" sid="MAT 7:16" />A ni peemi ni ɔmɛ ma ha nyɛ yo mɛ kaa bɔ nɛ a leɔ tso kɛ e yiblii ɔ. Nɔ ko ya tsɔ we wai yiblii ngɛ mio tso nɔ, aloo tso ko kaa mangoo tsoɔ yiblii ngɛ zezle nɔ. <verse eid="MAT 7:16" /><verse number="17" style="v" sid="MAT 7:17" />A leɔ tso slɔɔtoslɔɔto ɔmɛ a mi tso kɛ a yiblii ɔmɛ. <verse eid="MAT 7:17" /><verse number="18" style="v" sid="MAT 7:18" />Tso nɛ woɔ yiblii nɛ ngɔɔ ɔ, lɛ nɔuu e be yiblii nɛ a yi woe. Ja a nɔuu tso nɛ woɔ yiblii nɛ a yi be yiblii kpakpa nyɛe maa wo. <verse eid="MAT 7:18" /><verse number="19" style="v" sid="MAT 7:19" />Enɛ ɔ he je nɛ a poo tso nɛ wui yiblii nɛ a yeɔ ɔ kɛ peeɔ lɛ nɛ a slɛɔ ɔ nɛ. <verse eid="MAT 7:19" /><verse number="20" style="v" sid="MAT 7:20" />Lɔ ɔ he je ɔ, blɔ nɔ nɛ a guu kɛ leɔ tso loo nɔmlɔ adesa mi tso ji yiblii nɛ e woɔ.<verse eid="MAT 7:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 7:21" />Tsa pi nɔ tsuaa nɔ nɛ deɔ ke, ‘Nutsɔ, Nutsɔ’ ɔ nɛ maa sɛ Hiɔwe Matsɛyemi ɔ mi, ja nihi nɛ peeɔ ye Tsɛ nɛ ngɛ hiɔwe ɔ suɔmi nya ni ɔ. <verse eid="MAT 7:21" /><verse number="22" style="v" sid="MAT 7:22" />Ngɛ Kojomi Ligbi ɔ nɔ ɔ, nihi fuu ma de mi ke, ‘Nutsɔ, Nutsɔ, wa fiɛ o he sane kɛ tsɔɔ nihi nɛ wa hia mumi yayamihi kɛ je nihi a mi, nɛ wa pee nyakpɛ níhi ngɛ o biɛ mi.’ <verse eid="MAT 7:22" /><verse number="23" style="v" sid="MAT 7:23" />Se ma de mɛ ke, ‘I li nyɛ. Nyɛɛ je ye nɔ, nyɛ nihi nɛ nyɛ peeɔ ni yayamihi ɔ.’<verse eid="MAT 7:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 7:24" />Nɔ tsuaa nɔ nɛ buɔ ye munyu ɔmɛ tue nɛ e yeɔ a nɔ ɔ hɛ mi tɛ; e ngɛ kaa nɔ ko nɛ e ma e tsu ngɛ tɛ nɔ. <verse eid="MAT 7:24" /><verse number="25" style="v" sid="MAT 7:25" />Nɛ akɛnɛ tsu ɔ maa si ngɛ tɛ nɔ he je ɔ, ke hiɔmi nɛ, nɛ pa hia, nɛ kɔɔhiɔ fia kɛ si tsu ɔ, e be hulee.<verse eid="MAT 7:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 7:26" />Se nihi nɛ nuɔ ye munyu ɔmɛ se a yi nɔ ɔ, a ngɛ kaa nɔmlɔ lohwe nɛ ma e tsu ngɛ kewu nɔ. <verse eid="MAT 7:26" /><verse number="27" style="v" sid="MAT 7:27" />Nɛ ke hiɔmi nɛ, nɛ pa hia, nɛ kɔɔhiɔ fia kɛ si tsu ɔ, e maa hule bum.” <verse eid="MAT 7:27" /><verse number="28" style="v" sid="MAT 7:28" />Benɛ Yesu gbe munyu nɛ ɔmɛ a nya a, nɔ tsuaa nɔ pee yaa, <verse eid="MAT 7:28" /><verse number="29" style="v" sid="MAT 7:29" />ejakaa e tsɔɔ mɛ ni kaa nɔ ko nɛ ngɛ he blɔ, se pi kaa Yuda mlaa tsɔɔli ɔmɛ.<verse eid="MAT 7:29" /></para>
  <chapter eid="MAT 7" />
  <chapter number="8" style="c" sid="MAT 8" />
  <para style="s1">Yesu tsa hiɔ slɔɔtohi</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 8:1" />Nihi fuu nyɛɛ Yesu se benɛ e bɔni si kplemi kɛ je yoku ɔ nɔ ɔ. <verse eid="MAT 8:1" /><verse number="2" style="v" sid="MAT 8:2" />Kɛkɛ nɛ kpititsɛ ko ba kpla si ngɛ e he mi ke pɛɛ kpami ke, “Nutsɔ, ke o suɔ ɔ, o ma nyɛ ma tsa mi.”<verse eid="MAT 8:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 8:3" />Yesu ta e he nɛ e de lɛ ke, “I suɔ kaa ma tsa mo, o he nɛ tsɔ!” E nya nɔɛ si nɛ e he womi nɔ tɛ.<verse eid="MAT 8:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 8:4" />Se Yesu de lɛ ke, “Mo ko de nɔ ko, se mohu yaa tɛɛ nɛ o kɛ o he ya tsɔɔ osɔfo ɔ, nɛ o sã bɔ kaa bɔ nɛ Mose mlaa a tsɔɔ ngɛ kpititsɛmɛ a tsami he ɔ nɛ o kɛ ye odase.”<verse eid="MAT 8:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 8:5" />Benɛ Yesu ba Kapernaum ɔ, Roma sojahi lafa a nyatsɛ ko ba e ngɔ,<verse eid="MAT 8:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 8:6" />nɛ e ba kpa lɛ pɛɛ ke e ba tsa e wenyumu ko nɛ ku pue si nɛ e miɔ nɛ e ma gbo ɔ ha lɛ.<verse eid="MAT 8:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 8:7" />Yesu ha lɛ heto ke, “Yoo, i ma ba tsa lɛ ha mo.”<verse eid="MAT 8:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 8:8" />Sojahi lafa a nyatsɛ ɔ de Yesu ke, “Nutsɔ, e sɛ kaa o sɛɔ ye we ɔ mi, ja he je ɔ, mo de kɛkɛ ke, ‘A tsa tsɔlɔ ɔ’, nɛ e ma na he wami. <verse eid="MAT 8:8" /><verse number="9" style="v" sid="MAT 8:9" />I he ye, ejakaa ami po nɛ a yeɔ ye nɔ ɔ, i ngɛ sojahi ngɛ ye sisi nɛ ke i de nɔ nɛ ɔ ke, ‘Mo, yaa’ a, e yaa; nɛ ke i de nɔ kpa hu ke, ‘Ba’ a, e baa; nɛ ke i de ye tsɔlɔ ke, ‘Moo pee enɛ ɔ kɛ enɛ ɔ’ ɔ, e peeɔ. Nɛ i heɔ yeɔ kaa o ngɛ he blɔ nɛ o tsaa hiɔ nɛ ɔ.” <verse eid="MAT 8:9" /><verse number="10" style="v" sid="MAT 8:10" />Yesu hɛ mi pee lɛ yaa, nɛ e de ma asafo ɔ nɛ nyɛɛ e se ɔ ke, “I nɛ hemi kɛ yemi nɛ ngɛ kaa enɛ ɔ ngɛ Israel zugba a nɔ he ko! <verse eid="MAT 8:10" /><verse number="11" style="v" sid="MAT 8:11" />Nɛ i ngɛ nyɛ dee ke ma je li fuu kaa Roma amlaalo nɛ ɔ maa je je ɔ tsuo kɛ ba nɛ a kɛ Abraham kɛ Isak kɛ Yakob ma ba hi si ngɛ Hiɔwe Matsɛyemi ɔ mi. <verse eid="MAT 8:11" /><verse number="12" style="v" sid="MAT 8:12" />Nɛ a ma sake Israel bi nɛ mɛ mohu ji nihi nɛ a dla Hiɔwe Matsɛyemi ɔ kɛ to ɔ ngɔ fɔ diblii kpii ɔ mi, he nɛ ya fomi kɛ nɔ nami ngɛ ɔ.”<verse eid="MAT 8:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 8:13" />Kɛkɛ nɛ Yesu de Roma no ɔ ke, “Moo ya we mi. A pee bɔ nɛ o he ye ɔ ha mo!” Nɛ e wenyumu ɔ na he wami jamɛ a ngmlɛfia a nɔuu.<verse eid="MAT 8:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 8:14" />Benɛ Yesu sɛ Petro we ɔ mi ɔ, e na kaa Petro nganyɛ ɔ ngɛ asla ku nue nɛ e nyɛ we si temi. <verse eid="MAT 8:14" /><verse number="15" style="v" sid="MAT 8:15" />Nɛ Yesu sa kɛ su hiɔtsɛ ɔ he nɛ e ta e nine he, kɛkɛ nɛ asla a nya po ha lɛ amlɔ ɔ nɔuu; nɛ e te si nɛ e sɔmɔ mɛ.<verse eid="MAT 8:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 8:16" />Jamɛ a ligbi ɔ gbɔkuɛ ɔ, a wo nihi nɛ mumi yayamihi ngɛ mɛ haoe kɛ ba Yesu ngɔ; nɛ Yesu tu munyu kɛ hia mumi yayami ɔmɛ nɛ e tsa hiɔtsɛ ɔmɛ tsuo. <verse eid="MAT 8:16" /><verse number="17" style="v" sid="MAT 8:17" />Enɛ ɔ ha nɛ Gbalɔ Yesaia munyu ɔ ba mi ke, “E wo wa dengme ɔmɛ nɛ e tsa wa hiɔ ɔmɛ tsuo.”<verse eid="MAT 8:17" /></para>
  <para style="s1">Taku ɔ se yami</para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 8:18" />Benɛ Yesu na kaa ni ɔmɛ a he bɔni hiɛmi ngɛ e he ɔ, e de e kaseli ɔmɛ ke a dla nɛ a po taku loo pa a kɛ ho e se je ya.<verse eid="MAT 8:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 8:19" />Yesu nya nɔɛ si nɛ Yuda bi ɔmɛ a womi ngmali ɔmɛ a ti nɔ kake de lɛ ke, “Tsɔɔlɔ, i ma nyɛɛ o se kɛ ya he tsuaa he nɛ o yaa!”<verse eid="MAT 8:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 8:20" />Se Yesu he nɔ nɛ e de lɛ ke, “Kɔkɔbohi ngɛ muɔhi nɛ a hwɔɔ mi, nɛ lohwe pɛlitsɛmɛ hu ngɛ tsuhi, se Nɔmlɔ Bi ɔ lɛɛ e be he nɛ e kɛ e yi fɔɔ.”<verse eid="MAT 8:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 8:21" />E kaseli ɔmɛ a ti nɔ kake hu de lɛ ke, “Nutsɔ, ha mi blɔ nɛ ma ya pu ye tsɛ konɛ ma ba nyɛɛ o se.”<verse eid="MAT 8:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 8:22" />Se Yesu de lɛ ke, “Moo nyɛɛ ye se nɔuu nɛ o ngmɛɛ nihi nɛ gbo ngɛ mumi mi ɔmɛ a he nɛ a pu a he.”<verse eid="MAT 8:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 8:23" />Ni nɛ ɔmɛ a se ɔ, Yesu kɛ e kaseli ɔmɛ sɛ lɛ mi nɛ a bɔni pa a pomi kɛ yaa e se.<verse eid="MAT 8:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 8:24" />Tlukaa a, kɔɔhiɔ ngua ko te nɛ e bɔni lɛ ɔ kpami, se Yesu hwɔ mahe.<verse eid="MAT 8:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 8:25" />E kaseli ɔmɛ sa kɛ su e he nɛ a tsiɛ lɛ kɛ ngmlaa ke, “Nutsɔ, mo he wa yi wami, wa ngɛ mue!”<verse eid="MAT 8:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 8:26" />Se Yesu de mɛ ke, “Nyɛ nɛ nyɛ hemi kɛ yemi pi! Mɛni ba nɛ nyɛ tsui po kikɛ ɔ?” Kɛkɛ nɛ e te si nɛ e ke kɔɔhiɔ kɛ nyu ɔ nɛ gli ɔ yi nɛ a ngmɛ dii.<verse eid="MAT 8:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 8:27" />Kaseli ɔmɛ ye gbeye nɛ a pee yaa nɛ a bi ke, “Mɛnɔ po ji nɛ ɔ nɛ kɔɔhiɔ kɛ wo tete buɔ lɛ tue nɛ ɔ?”<verse eid="MAT 8:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 8:28" />Benɛ a ya su pa a se ngɛ Gadara bi ɔmɛ a zugba a nɔ ɔ, nyumuhi enyɔ nɛ mumi yayamihi ngɛ a mi kɛ lɛ ba kpe. Gɔ mi ji he nɛ a hii, nɛ nɔ ko nyɛ we lejɛ ɔ gumi ejakaa a plɛ a he awi yeli.<verse eid="MAT 8:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 8:29" />Benɛ a na Yesu pɛ nɛ a hia ngmlaa nɛ a bɔni bimi ke, “Mɛni sane waa kɛ mo ngɛ, mo Mawu Bi ɔ? O be he blɔ nɛ o gbaa wa nya ngɛ be nɛ ɔ mi.”<verse eid="MAT 8:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="MAT 8:30" />Kpotoohi fuu ngɛ ni yee ngɛ lejɛ e ɔ, <verse eid="MAT 8:30" /><verse number="31" style="v" sid="MAT 8:31" />kɛkɛ nɛ mumi yayami ɔmɛ kpa Yesu pɛɛ nɛ e ha mɛ he blɔ nɛ a ya sɛ a mi.<verse eid="MAT 8:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 8:32" />Nɛ Yesu de mɛ ke, “Nyɛɛ ya!” Nɛ a je kpo ngɛ a mi kɛ ya sɛ kpotoo ɔmɛ a mi, nɛ kpotoo ɔmɛ kulaa wo fo kɛ je yoku ɔ nɔ kɛ ya sɛ pa a mi nɛ a gbo ngɛ nyu ɔ mi.<verse eid="MAT 8:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 8:33" />Se benɛ nihi nɛ ngɛ kpotoo ɔmɛ hyɛe ɔ na nɔ́ nɛ ba a, a tu fo kɛ ho ma a mi ya nɛ a ya bɔ ma mi bi ɔmɛ amaniɛ,<verse eid="MAT 8:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 8:34" />nɛ ma a tsuo je kpo, nɛ benɛ a ba na Yesu ɔ a kpa lɛ pee nɛ e je a zugba a mi ha mɛ kpoo.<verse eid="MAT 8:34" /></para>
  <chapter eid="MAT 8" />
  <chapter number="9" style="c" sid="MAT 9" />
  <para style="s1">Ye zugba nɛ ɔ nɔ ni tsumi</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 9:1" />Lɔ ɔ he je ɔ, Yesu sɛ lɛ nɛ e po pa a kɛ ba Kapernaum nɛ ji lɛ nitsɛ e ma a mi.<verse eid="MAT 9:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="MAT 9:2" />Benɛ Yesu ya su Kapernaum ɔ, ni komɛ ngɔ nyumuyo ko nɛ ngɛ kumi hiɔ nue nɛ fɔɔ si ngɛ sa nɔ kɛ ba e ngɔ. Benɛ Yesu na a hemi kɛ yemi ɔ, e de hiɔtsɛ ɔ ke, “Binyumu, o bua nɛ jɔ o he, a ngɔ o he yayami ɔmɛ kɛ ke mo!”<verse eid="MAT 9:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 9:3" />Mlaa tsɔɔli ɔmɛ a ti ni komɛ de ngɛ a yi mi ke, “Nyumu nɛ ɔ ngɛ musu bɔe, ejakaa e ngɛ dee ke lɛ ji Mawu.”<verse eid="MAT 9:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 9:4" />Yesu na a juɛmi ɔ nɛ e bi mɛ ke, “Mɛni he je nɛ nyɛ ngɛ yi mi yaya susue ɔ? <verse eid="MAT 9:4" /><verse number="5-6" style="v" sid="MAT 9:5-6" />Anɛ nɔ́ nɛ a ma de hiɔtsɛ ɔ ke a wo e he yayami ɔmɛ kɛ ke lɛ ɔ nɛ e demi wa aloo kaa a ma tsa lɛ ɔ nɛ e wa?” Bɔ nɛ pee nɛ nyɛɛ le kaa i ngɛ he blɔ ngɛ zugba a nɔ, nɛ i woɔ yayamihi ngɔ kɛ e he je ɔ, i ngɛ hiɔtsɛ nɛ ɔ dee ke, “Tee si nɛ o hluɛ o sa a nɛ o ho we mi ya, ejakaa a tsa mo.”<verse eid="MAT 9:5-6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 9:7" />Kɛkɛ nɛ nyumuyo ɔ te si amlɔ ɔ nɔuu nɛ e je kɛ ho we mi ya.<verse eid="MAT 9:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 9:8" />Nɛ nihi nɛ ngɛ lejɛ ɔ nɛ na nɔ́ nɛ ɔ, a nya kpɛ a he nɛ a je Mawu yi kaa e ha adesa kikɛmɛ a he blɔ nɛ ɔ.<verse eid="MAT 9:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 9:9" />Benɛ Yesu je lejɛ ɔ nɛ e pue blɔ kɛ yaa a, e ya na lapoo tsulɔ ko nɛ a tsɛɛ lɛ Mateo ɔ nɛ e hii si ngɛ lapoo hemi he ɔ nɛ e de lɛ ke, “Ba nyɛɛ ye se.” Nɛ Mateo te si amlɔ ɔ nɔuu nɛ e nyɛɛ e se.<verse eid="MAT 9:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 9:10" />Pee se benɛ Yesu kɛ e kaseli ɔmɛ ya ngɛ ni yee ngɛ Mateo we ɔ mi ɔ, yayami peeli kpanakuhi fuu ba nɛ a kɛ mɛ ba ye ni ɔ.<verse eid="MAT 9:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 9:11" />Enɛ ɔ pee Farisi bi ɔmɛ nyakpɛ nɛ a bi e kaseli ɔmɛ ke, “Mɛni he je nɛ nyɛ tsɔɔlɔ ɔ kɛ kikɛmɛ a nimli nɛ ɔmɛ ngɛ bɔe ɔ?”<verse eid="MAT 9:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 9:12" />Yesu ha mɛ heto ke, “I kɛ mɛ ngɛ bɔe ejakaa nihi nɛ ngɛ he wami ɔ tsopatsɛ he hia we mɛ, se mohu hiɔtsɛhi nɛ tsopatsɛ he hia.” <verse eid="MAT 9:12" /><verse number="13" style="v" sid="MAT 9:13" />Yesu tsa nɔ nɛ e de mɛ ke, “Nyɛɛ ya nɛ nyɛ ya hla Mawu Munyu kuku nɛ ɔ sisi, ‘Nyɛ bɔ sami ɔmɛ kɛ nike ni ɔmɛ a he hia we mi, se mohu nyɛ mɔbɔ nami he nɛ ngɛ mi hiae.’ Ejakaa i bɛ dali a tsɛmi, se mohu yayami peeli a he nɛ i ba ngɛ konɛ a tsake a tsui.”<verse eid="MAT 9:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 9:14" />Ligbi ko ɔ, Yohane Baptisilɔ ɔ kaseli ɔmɛ ba Yesu ngɔ nɛ a ba bi lɛ ke, “Mɛni he je nɛ wɔ Yohane kaseli ɔmɛ kɛ Farisi bi ɔmɛ pɔɔ nya fimi se o kaseli ɔmɛ lɛɛ a hɛ hwɔ ɔ?”<verse eid="MAT 9:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 9:15" />Yesu ha mɛ heto nɛ e bi mɛ ke, “Anɛ e sa kaa ayɛflo huno ɔ huɛmɛ nɛ ye kɔmɔ nɛ a ha hwɔ be mi nɛ ayɛflo huno ɔ kɛ mɛ ngɛ ɔ lo? Se be maa ba nɛ a maa ngɔ ayɛflo huno ɔ kɛ je a he, nɛ jamɛ a be ɔ mi loko a maa ha hwɔ ɔ nɛ.<verse eid="MAT 9:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 9:16" />Nɔ ko kɛ bo nya he ta we tade momo, ejakaa ke e pee ja a, tade momo ɔ gbaa ngɛ bo nya he nɛ a kɛ tsi puɔ ɔ he, nɛ puɔ ɔ bliɔ pe kekle ɔ. <verse eid="MAT 9:16" /><verse number="17" style="v" sid="MAT 9:17" />Mɛnɔ ngɔɔ wai he kɛ woɔ tɔ momohi a mi? Ke a pee ja a, wai he ɔ ma pɛ tɔ momo ɔmɛ nɛ da a ma pue si, nɛ tɔ ɔmɛ hu ma puɛ. Wai he ɔ, tɔ hehi a mi nɛ a kɛ woɔ bɔ nɛ pee nɛ tɔ ɔ kɛ wai ɔ tsuo nɛ a ko puɛ.”<verse eid="MAT 9:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 9:18" />Benɛ Yesu ngɛ ni nɛ ɔmɛ a mi tsɔɔe ɔ, kpe he tsɔɔlɔ nɔkɔtɔma ko ba nɛ e ba kpla si ngɛ e hɛ mi nɛ e kpa lɛ pɛɛ nɛ e de ke, “Ye biyo gbo piɔ nɛ ɔ nɔuu; se o ma nyɛ tsiɛ lɛ ke o ba ta e he kɛkɛ.”<verse eid="MAT 9:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 9:19" />Benɛ Yesu kɛ e kaseli ɔmɛ yaa nyumu nɔkɔtɔma a we ɔ mi ɔ, <verse eid="MAT 9:19" /><verse number="20" style="v" sid="MAT 9:20" />yo ko nɛ muɔ ngɛ bee ngɛ e he jeha nyɔngma kɛ enyɔ sɔuu ɔ ba je e se je nɛ e ta e tade ɔ nya he, <verse eid="MAT 9:20" /><verse number="21" style="v" sid="MAT 9:21" />ejakaa e susu ngɛ e mi kaa e ma na he wami ke e na ta e he kɛkɛ.<verse eid="MAT 9:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 9:22" />Yesu plɛ e he nɛ e de lɛ ke, “Biyo, o tsui nɛ nɔ o mi, o hemi kɛ yemi ɔ tsa mo.” Kɛkɛ nɛ yo ɔ na he wami kɛ je jamɛ a ngmlɛfia a nɔ nɔuu.<verse eid="MAT 9:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 9:23" />Benɛ Yesu ya su we ɔ mi he nɛ jokuɛ yo ɔ yi ta ngɛ ɔ, e na kaa nihi fuu ngɛ hoo pee nɛ a ngɛ gbenɔ lahi lae. <verse eid="MAT 9:23" /><verse number="24" style="v" sid="MAT 9:24" />Kɛkɛ nɛ e de ke, “Nyɛ je ni ɔmɛ kpo, ejakaa yiheyo ɔ gbo we, mahe kɛkɛ nɛ e ngɛ hwɔe!” Se ni ɔmɛ ye e he fɛu. <verse eid="MAT 9:24" /><verse number="25" style="v" sid="MAT 9:25" />Benɛ a je kpo ta a, Yesu sɛ tsu ɔ mi he nɛ a wlɔ yiheyo ɔ ngɛ ɔ nɛ e ya pɛtɛ e nine si, nɛ amlɔ ɔ nɔuu ɔ, e te si. <verse eid="MAT 9:25" /><verse number="26" style="v" sid="MAT 9:26" />Nɛ nyakpɛ sane nɛ ɔ gbɛ fia lejɛ ɔ zugba a nɔ tsuo.<verse eid="MAT 9:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 9:27" />Benɛ Yesu maa ho we ɔ mi lejɛ ɔ jemi ya a, nyumuhi enyɔ nɛ a hɛ yu nyɛɛ e se kɛ ngmlaa ke, “Matsɛ David Bi, moo na wɔ mɔbɔ!”<verse eid="MAT 9:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 9:28" />A nyɛɛ Yesu se kɛ ya sɛ e to he ɔ nɛ e bi mɛ ke, “Anɛ nyɛ heɔ yeɔ kaa ma nyɛ ma bli nyɛ hɛ ngmɛ yuyui ɔmɛ nɛ nyɛ maa hyɛ nɔ́ lo?” A ha heto ke, “Ee, Nutsɔ, wa heɔ yeɔ.”<verse eid="MAT 9:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 9:29" />Kɛkɛ nɛ Yesu ta a hɛ ngmɛ ɔmɛ a he nɛ e de mɛ ke, “E ba mi ha nyɛ ngɛ nyɛ hemi kɛ yemi ɔ nya.”<verse eid="MAT 9:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="MAT 9:30" />Nɛ a hɛ ngmɛ ɔmɛ bli amlɔ ɔ nɔuu. Nɛ Yesu bɔ mɛ kɔkɔ veveeve ke a ko ha nɛ nɔ ko nɛ le enɛ ɔ, <verse eid="MAT 9:30" /><verse number="31" style="v" sid="MAT 9:31" />kɛkɛ nɛ a ho mohu nɛ a ya je e yi kɛ kpa ma a mi tsuo.<verse eid="MAT 9:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 9:32" />Benɛ Yesu je lejɛ ɔ kɛ yaa a, e kɛ nyumu ko nɛ mumi yayami ngɛ e mi nɛ e tui munyu ya kpe. <verse eid="MAT 9:32" /><verse number="33" style="v" sid="MAT 9:33" />Yesu hia mumi yayami ɔ kɛ je e mi nɛ e bɔni munyu tumi nɔuu. Enɛ ɔ pee nihi nɛ ngɛ lejɛ ɔ nyakpɛ nɛ a de ke, “Wa nɛ nɔ́ nɛ ɔ eko hyɛ gblee!”<verse eid="MAT 9:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 9:34" />Se Farisi bi ɔmɛ hu de ke, “E hiaa mumi yayami kɛ jee nihi a mi ejakaa mumi yayami ɔmɛ a matsɛ ji lɛ nitsɛ.”<verse eid="MAT 9:34" /></para>
  <para style="s1">Ni tsuli a he hia, a tsɛ mɛ</para>
  <para style="p">
    <verse number="35" style="v" sid="MAT 9:35" />Nɛ Yesu kpa si ngɛ lejɛ ɔ ma amɛ kɛ kɔpe ɔmɛ a mi; nɛ e tsɔɔ ni nɛ e fiɛ Hiɔwe Matsɛyemi ɔ he Manye Munyu ɔ ngɛ Yuda bi ɔmɛ a kpe he ɔmɛ, nɛ e tsa hiɔ slɔɔtoslɔɔtohi. <verse eid="MAT 9:35" /><verse number="36" style="v" sid="MAT 9:36" />E muklii mi sa lɛ ngɛ nihi nɛ ba e ngɔ ɔ a he, ejakaa a haomi ɔmɛ hiɛ fuu, nɛ a li he nɛ a yaa kɛ bɔ nɛ a ngɛ pee. A ngɛ kaa jijɔhi nɛ be kpakalɔ.<verse eid="MAT 9:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="MAT 9:37" />Nɛ e de e kaseli ɔmɛ ke, “Ni kpami ɔ hiɛ, se ni tsuli ɔmɛ a he pi, <verse eid="MAT 9:37" /><verse number="38" style="v" sid="MAT 9:38" />lɔ ɔ he je ɔ, nyɛ kpa ni kpami nɔ hyɛlɔ ɔ pɛɛ nɛ e he ni tsuli fuu kɛ ba ni kpami ɔ mi.”<verse eid="MAT 9:38" /></para>
  <chapter eid="MAT 9" />
  <chapter number="10" style="c" sid="MAT 10" />
  <para style="p">
    <verse number="1" style="v" sid="MAT 10:1" />Kɛkɛ nɛ Yesu tsɛ e kaseli nyɔngma kɛ enyɔ ɔmɛ kɛ ba e ngɔ, nɛ e ha mɛ he wami ngɛ mumi yayamihi a nɔ nɛ a hia mɛ nɛ a tsa hiɔ fɛɛ hiɔ.<verse eid="MAT 10:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="MAT 10:2" />Kaseli nyɔngma kɛ enyɔ ɔmɛ a biɛhi ji: Simon nɛ a pɔɔ lɛ tsɛmi ke Petro ɔ, kɛ e nyɛmi Andrea; Yakobo, Zebedeo bi ɔ kɛ e nyɛmi Yohane; <verse eid="MAT 10:2" /><verse number="3" style="v" sid="MAT 10:3" />Filipo kɛ Bartolomeo; Toma kɛ Mateo, lapoo tsulɔ ɔ; Yakobo, Alfeo bi ɔ, kɛ Lebeo nɛ a tsɛɛ lɛ Tadeo hulɔ ɔ; <verse eid="MAT 10:3" /><verse number="4" style="v" sid="MAT 10:4" />Simon Kanaan no ɔ; kɛ Yuda Iskariot nɔ nɛ tsɔɔ Yesu se blɔ ɔ.<verse eid="MAT 10:4" /></para>
  <para style="s1">Kaseli ɔmɛ a tsɔmi</para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 10:5" />Nɛ Yesu tsɔ mɛ, nɛ e de mɛ ke, “Nyɛ ko gu ma je li ɔmɛ loo Samaria bi ɔmɛ a ngɔ. <verse eid="MAT 10:5" /><verse number="6" style="v" sid="MAT 10:6" />Se mohu nyɛɛ ya Israel bi ɔmɛ nɛ ji Mawu tohi nɛ laa amɛ pɛ a ngɔ. <verse eid="MAT 10:6" /><verse number="7" style="v" sid="MAT 10:7" />Nyɛ ya fiɛ nɛ nyɛ de mɛ ke, Hiɔwe Matsɛyemi ɔ su si ta. <verse eid="MAT 10:7" /><verse number="8" style="v" sid="MAT 10:8" />Nyɛ tsa hiɔtsɛmɛ, nyɛ tle ni gbogboehi si, nyɛ tsa kpititsɛmɛ nɛ nyɛɛ hia mumi yayamihi. Nyɛ ko he hiɔwo ko, ejakaa yaka gu nɛ a kɛ ha nyɛ hu.<verse eid="MAT 10:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 10:9" />Nyɛ ko hɛɛ sika; <verse eid="MAT 10:9" /><verse number="10" style="v" sid="MAT 10:10" />nɛ nyɛ ko hɛɛ blɔ hiami kotoku, nɛ nyɛ ko hɛɛ tadehi kɛ tokotahi kɛ piɛ nɔ nɛmɛ nɛ nyɛ wo ɔmɛ a he; nɛ nyɛ ko hɛɛ dema tso tete, ejakaa nihi nɛ nyɛ maa ye kɛ bua mɛ ɔ maa hyɛ nyɛ nɔ. <verse eid="MAT 10:10" /><verse number="11" style="v" sid="MAT 10:11" />Nɛ ma tsuaa ma loo kɔpe tsuaa kɔpe mi nɛ nyɛ ma ya sɛ ɔ, nyɛ hla dalɔ nɛ ngɛ lejɛ ɔ se blɔ nɛ nyɛ ya to e ngɔ kɛ ya si be nɛ nyɛ maa je kɛ ya ma kpa mi. <verse eid="MAT 10:11" /><verse number="12" style="v" sid="MAT 10:12" />Ke nyɛ bi nɛ a ha nyɛ to he ɔ, nyɛɛ kɛ wetsɛ ɔ nɛ hi si saminya, <verse eid="MAT 10:12" /><verse number="13" style="v" sid="MAT 10:13" />nɛ ke nyɛ na kaa dalɔ we i ɔ, nyɛɛ gbaa we ɔ, se kɛ e pi dalɔ lɛɛ nyɛɛ ngɔ gbaami ɔ ngɔ to. <verse eid="MAT 10:13" /><verse number="14" style="v" sid="MAT 10:14" />Nɛ ma loo we mi he nɛ a he we nyɛ atuu ngɛ ɔ, nyɛ blɛ nyɛ nane si zu ɔ kɛ pue si loko ji nyɛɛ je jamɛ a ma a loo we ɔ mi. <verse eid="MAT 10:14" /><verse number="15" style="v" sid="MAT 10:15" />Niinɛ, i ngɛ nyɛ dee ke, e maa fani ha Sodom kɛ Gomora, mahi nɛ a yi kpɛti wa amɛ pe jamɛ a ma a, loo we ɔ ngɛ Kojomi Ligbi ɔ nɔ.<verse eid="MAT 10:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 10:16" />I ngɛ nyɛ tsɔe kaa jijɔhi kɛ yaa ogbeteehi a kpɛti. Nyɛ hɛ mi nɛ tɛ kaa sinɔhi, nɛ nyɛ he nɛ jɔ kaa obleku lahuɛhi. <verse eid="MAT 10:16" /><verse number="17" style="v" sid="MAT 10:17" />Nɛ nyɛɛ pee klaalo, ejakaa a maa nu nyɛ, nɛ a maa kojo nyɛ, nɛ a maa fiaa nyɛ kpa ngɛ kpe he ɔmɛ. <verse eid="MAT 10:17" /><verse number="18" style="v" sid="MAT 10:18" />Ngɛ ye he je ɔ, a maa kojo nyɛ ngɛ matsɛhi a hɛ mi. Se lɔ ɔ ma ha nyɛ he blɔ nɛ nyɛ kɛ ye ye he odase kɛ tsɔɔ mɛ kɛ je ɔ tsuo.<verse eid="MAT 10:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 10:19" />Ke a nu nyɛ ɔ, nyɛ ko hao nyɛ he ngɛ nɔ nɛ nyɛ ma ya de ngɛ kojomi he ɔ he, ejakaa ke be ɔ su ɔ, a maa tsɔɔ nyɛ nɔ nɛ sa nɛ nyɛ de ɔ. <verse eid="MAT 10:19" /><verse number="20" style="v" sid="MAT 10:20" />Ejakaa pi nyɛ nɛ nyɛ maa tu munyu ɔ se mohu hiɔwe Tsɛ ɔ Mumi ɔ ji nɔ nɛ maa tu munyu ngɛ nyɛ mi.<verse eid="MAT 10:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 10:21" />Nyɛmi maa tsɔɔ nyɛmi se blɔ nɛ e maa ngɔ lɛ kɛ ha gbenɔ, ja a nɔuu tsɛmɛ maa tsɔɔ a bimɛ a se blɔ. Nɛ bimɛ hu maa te si kɛ wo a tsɛmɛ nɛ a maa ngɔ mɛ kɛ ha nɛ a gbe mɛ. <verse eid="MAT 10:21" /><verse number="22" style="v" sid="MAT 10:22" />Nɛ nɔ tsuaa nɔ maa nyɛ nyɛ, ejakaa ye nihi ji nyɛ. Se nɔ tsuaa nɔ nɛ maa ye ni nɛ ɔmɛ a nɔ kunimi kɛ ya su nyagbe ɔ, a ma he e yi wami.<verse eid="MAT 10:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 10:23" />Ke a ngɛ nyɛ yi mi wae ngɛ ma kake mi ɔ, nyɛɛ tu fo kɛ ho ma kpa mi ya. Niinɛ, i ngɛ nyɛ dee ke nyɛ be Israel ma amɛ tsuo a nɔ kpae kɛ gbe nya loko ji Nɔmlɔ Bi ɔ maa ba. <verse eid="MAT 10:23" /><verse number="24" style="v" sid="MAT 10:24" />Kaselɔ pa we e tsɔɔlɔ; nɛ nyɔguɛ hu pa we e nutsɔ. <verse eid="MAT 10:24" /><verse number="25" style="v" sid="MAT 10:25" />Nɔ nɛ baa tsɔɔlɔ nɔ ɔ, e saa kaselɔ ɔ he, nɛ nɔ nɛ baa nutsɔ nɔ ɔ, e saa nyɔguɛ he. Nɛ ke a tsɛ wetsɛ ɔ abosiami loo Beelzebul, si enyɛmɛ nɛ a be e we bi ɔmɛ tsɛe ja? <verse eid="MAT 10:25" /><verse number="26" style="v" sid="MAT 10:26" />Nyɛ ko ye ni nɛmɛ nɛ ngɛ nyɛ he gbeye woe ɔ gbeye. Ejakaa be ma nɛ anɔkuale ɔ maa je kpo paa, nɛ a diblii mi ni peemi ni ɔmɛ ma plɛ magbɛ nɔ sane.<verse eid="MAT 10:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 10:27" />Ja he je ɔ, nɔ nɛ i ngɛ nyɛ dee ngɛ diblii mi nɛ ɔ, nyɛ ya kpa ngmlaa nɛ nyɛ de ngɛ ma hɛ mi; nɛ nɔ nɛ i de ngɔ wo nyɛ tue mi zaa a, nyɛ ya fiɛ ngɛ ma nɔ.<verse eid="MAT 10:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 10:28" />Nyɛ ko ye nihi nɛ ma nyɛ nyɛ nɔmlɔ tso ɔ maa gbe se a be klaa a nyɛɛ gbemi ɔ gbeye, se mohu nyɛɛ ye nɔ nɛ nyɛɛ klaa a kɛ nɔmlɔ tso ɔ tsuo he mi kpataa ngɛ la mi ɔ pɛ gbeye. <verse eid="MAT 10:28" /><verse number="29" style="v" sid="MAT 10:29" />Anɛ otokliihi enyɔ nɛɛ tsa pi pɛsua nɛ a juaa mɛ lo? Se a ti eko nɔe zugba nɛ Tsɛ ɔ li he nɔ ko. <verse eid="MAT 10:29" /><verse number="30" style="v" sid="MAT 10:30" />Nyɛ yi bwɔmi po ɔ a kane kulaa nɛ a le nya. <verse eid="MAT 10:30" /><verse number="31" style="v" sid="MAT 10:31" />Lɔ ɔ he je ɔ, nyɛ ko hao, ejakaa nyɛ he jua wa hluu pe otokliihi babauu.<verse eid="MAT 10:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 10:32" />Nɔ tsuaa nɔ nɛ woɔ ye ta ngɛ ma hɛ mi kaa ye nɔ ji lɛ ɔ, ami hu ma wo e ta ngɛ ye Tsɛ nɛ ngɛ hiɔwe ɔ hɛ mi. <verse eid="MAT 10:32" /><verse number="33" style="v" sid="MAT 10:33" />Nɛ nɔ tsuaa nɔ nɛ kuaa mi ngɛ nimli a hɛ mi ɔ, ami hu ma kua lɛ ngɛ ye Tsɛ nɛ ngɛ hiɔwe ɔ hɛ mi.<verse eid="MAT 10:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 10:34" />Nyɛ ko susu kaa i ba nɛ ma ba ha he jɔmi ngɛ zugba a nɔ. Dabi, pi he jɔmi hami nɛ i ba, se klaate mohu nɛ i wo kɛ ba. <verse eid="MAT 10:34" /><verse number="35" style="v" sid="MAT 10:35" />Ejakaa i ba nɛ ma ba ha bi nɛ te si kɛ wo e tsɛ, nɛ biyo nɛ te si kɛ wo e nyɛ, nɛ nganyɛ hu nɛ te si kɛ wo e nganyɛ, <verse eid="MAT 10:35" /><verse number="36" style="v" sid="MAT 10:36" />nɛ nɔ e he nyɛli pe kulaa maa pee nihi nɛ ngɛ lɛ nitsɛ e we ɔ mi. <verse eid="MAT 10:36" /><verse number="37" style="v" sid="MAT 10:37" />Nɔ nɛ suɔ e tsɛ loo e nyɛ pe mi ɔ, e sɛ nɛ e peeɔ ye nɔ, nɛ nɔ nɛ suɔ e binyumu loo biyo hu pe mi ɔ, e be nyɛe maa pee ye nɔ. <verse eid="MAT 10:37" /><verse number="38" style="v" sid="MAT 10:38" />Ja a nɔuu nɔ nɛ wo we e sɛumi tso ɔ nɛ e nyɛɛ ye se ɔ, lɛ hu e be ye nɔ pee.<verse eid="MAT 10:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="MAT 10:39" />Nɔ tsuaa nɔ nɛ baa e klaa yi ɔ, e maa laa lɛ, se nɔ nɛ kɛ e klaa ha mi ɔ, e yi ma na wami.<verse eid="MAT 10:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="MAT 10:40" />Nɔ nɛ ma he nyɛ atuu ɔ, ami nɛ e ngɛ hee ɔ nɛ. Nɛ nɔ nɛ ma he mi atuu ɔ, Mawu nɔ nɛ tsɔ mi ɔ nɛ e ngɛ hee ɔ nɛ. <verse eid="MAT 10:40" /><verse number="41" style="v" sid="MAT 10:41" />Nɛ nɔ tsuaa nɔ nɛ heɔ gbalɔ atuu ngɛ Mawu nɔmlɔ nɛ e ji ɔ he ɔ, e ma na hiɔwo nɛ gbalɔ ma na a. Nɛ nɔ nɛ ma he dalɔ atuu ngɛ dalɔ nɛ e ji ɔ he ɔ, e ma na dalɔ hiɔwo.<verse eid="MAT 10:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="MAT 10:42" />Nɛ ke nɔ ko ma ha jokuɛwi nɛ ɔmɛ a ti nɔ kake nyu nɛ e nu ngɛ kaselɔ biɛ mi ɔ, niinɛ, i ngɛ lɛ dee ke e hiɔwo be le bɔe kɔkɔɔkɔ.”<verse eid="MAT 10:42" /></para>
  <chapter eid="MAT 10" />
  <chapter number="11" style="c" sid="MAT 11" />
  <para style="s1">Yesu wo Yohane he wami</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 11:1" />Benɛ Yesu to e kaseli nyɔngma kɛ enyɔ ɔmɛ blɔ nya ta a, e je lejɛ ɔ ya tsɔɔ ni nɛ e fiɛ ngɛ ma amɛ a mi. <verse eid="MAT 11:1" /><verse number="2" style="v" sid="MAT 11:2" />Jamɛ a be ɔ mi ɔ, Yohane Baptisilɔ ɔ ngɛ tsu mi, se benɛ e nu nyakpɛ ni tsumihi nɛ Yesu ngɛ tsue ɔ, e tsɔ e kaseli ɔmɛ kɛ ba Yesu ngɔ nɛ a ba bi lɛ ke, <verse eid="MAT 11:2" /><verse number="3" style="v" sid="MAT 11:3" />“Anɛ mo ji nɔ nɛ ma a, aloo waa hyɛ nɔ kpa blɔ?”<verse eid="MAT 11:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 11:4" />Nɛ Yesu ha tsɔli ɔmɛ heto ke, “Nyɛɛ kpale nɛ nyɛ ya de Yohane nyakpɛ níhi nɛ nyɛ ba na nɛ i ngɛ pee ɔ. Lɔ ɔ ji kaa, <verse eid="MAT 11:4" /><verse number="5" style="v" sid="MAT 11:5" />nihi nɛ a hɛ yu ɔ ngɛ nɔ hyɛe, nihi nɛ ku pue si ɔ ngɛ nyɛɛe; kpititsɛmɛ a he ngɛ tsɔe, tue kpokutsɛmɛ ngɛ nɔ nue, nɛ ni gbogboehi ngɛ si tee; nɛ nyɛ de lɛ hu kaa i ngɛ Manye Munyu ɔ fiɛe kɛ ngɛ ohiafohi tsɔɔe. <verse eid="MAT 11:5" /><verse number="6" style="v" sid="MAT 11:6" />A gbaa nɔ tsuaa nɔ nɛ e juɛmi pee we lɛ sikɔsikɔ ngɛ ye he ɔ.”<verse eid="MAT 11:6" /></para>
  <para style="s1">Yohane he odase yemi</para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 11:7" />Benɛ Yohane kaseli ɔmɛ je se ɔ, Yesu bɔni Yohane he munyu tumi kɛ ngɛ asafo ɔ tsɔɔe. Nɛ e bi mɛ ke, “Benɛ nyɛ ho nɛ nyɛ ya hyɛ Yohane ha ngɛ nga a nɔ ɔ, kɛ nyɛ susu kaa e maa hi kɛɛ? Gla nɛ kɔɔhiɔ ngɛ lɛ fiae lo? <verse eid="MAT 11:7" /><verse number="8" style="v" sid="MAT 11:8" />Aloo nyɛ susu nɛ nyɛ maa na nɔ ko nɛ wo tade wuyaa kaa matsɛbi ngɛ matsɛ we mi lo? <verse eid="MAT 11:8" /><verse number="9" style="v" sid="MAT 11:9" />Aloo Mawu gbalɔ lo? Ee, i ngɛ nyɛ dee ke, e pe gbalɔ tete. <verse eid="MAT 11:9" /><verse number="10" style="v" sid="MAT 11:10" />Ejakaa Yohane ji nɔ nɛ he nɛ a ngma ngɛ ke e maa sɛ ye hlami nɛ e ba fiɛ ye bami ɔ nɛ e dla blɔ ɔ ngɔ to mi ɔ nɛ.<verse eid="MAT 11:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 11:11" />Anɔkuale munyu nɛ i ngɛ nyɛ tue ke, ngɛ nihi nɛ yihi fɔ ɔmɛ a kpɛti ɔ, a ti nɔ ko be nɛ pe Yohane Baptisilɔ ɔ; se kɛ ɔ, nɔ nɛ ji nyafii pe kulaa ngɛ Mawu Matsɛyemi ɔ mi ɔ pe lɛ. <verse eid="MAT 11:11" /><verse number="12" style="v" sid="MAT 11:12" />Nɛ kɛ je be nɛ Yohane bɔni fiɛmi kɛ nihi baptisimi kɛ ba si amlɔ nɛ ɔ, nihi babauu bɔni Hiɔwe Matsɛyemi ɔ he pleemi, <verse eid="MAT 11:12" /><verse number="13" style="v" sid="MAT 11:13" />ejakaa mlaa amɛ kɛ gbali ɔmɛ tsuo ngɛ Yiwamihelɔ ɔ blɔ hyɛe kɛ ba su be nɛ Yohane ba. <verse eid="MAT 11:13" /><verse number="14" style="v" sid="MAT 11:14" />Nɛ ke nyɛ suɔ kaa nyɛ ma he a munyu ɔ ye ɔ, lɛ ji Elia nɔ nɛ gbali ɔmɛ de ke e maa ba a nɛ. <verse eid="MAT 11:14" /><verse number="15" style="v" sid="MAT 11:15" />Nɔ nɛ ngɛ tue nɛ e ke maa nu ɔ, e nu.<verse eid="MAT 11:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 11:16" />I li nɔ nɛ he nɛ ma ngɔ yi nɔ bi nɛ ɔmɛ ngɔ to. A ngɛ kaa jokuɛwi nɛ ngɛ fiee ngɛ jua nɔ nɛ a ngɛ huɛmɛ dee ke, <verse eid="MAT 11:16" /><verse number="17" style="v" sid="MAT 11:17" />Wa kpa bɛ nɛ wa wo do, se nyɛ dui; wa je ya, se nyɛ fo we. <verse eid="MAT 11:17" /><verse number="18" style="v" sid="MAT 11:18" />Ejakaa Yohane Baptisilɔ ɔ ba hi si nɛ e nui da nɛ e hii ngma nɛ nyɛ de ke, Godotsɛ ji lɛ.<verse eid="MAT 11:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 11:19" />Nɔmlɔ Bi ɔ ba nɛ lɛɛ e yeɔ ni nɛ e nuu da nɛ nyɛ de ngɛ e he ke, ‘Ngma yelɔ kɛ da delɔ nɛ kɛ lapoo tsuli kɛ yayami peeli kpanakuhi bɔɔ.’ Se nyɛ nitsɛmɛ nɛ nyɛ ji ni leli ɔ, nyɛ maa na bɔ nɛ nyɛ munyu ɔmɛ be tɛ kake nɔ ha.”<verse eid="MAT 11:19" /></para>
  <para style="s1">Si womihi ke kpeemi</para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 11:20" />Kɛkɛ nɛ Yesu bɔni mahi a nɔ he nɛ e kpa nɛ e tsu nyakpɛ ni ɔmɛ ngɛ ɔ a hɛ mi kami, ejakaa a kpale we ngɛ a yayami ɔmɛ a se. E de mɛ ke,<verse eid="MAT 11:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 11:21" />“Kpoo ha mo, Korazin! Due ha mo, Betsaida! Ejakaa nyakpɛ nihi nɛ i tsu ngɛ nyɛ gbɛjegbɛ ɔmɛ a nɔ ɔ, kaa Tiro kɛ Zidon nɛ i tsu ngɛ jinɛ a kpale ngɛ a yayami ɔmɛ a se momoomo kɛ he piami. <verse eid="MAT 11:21" /><verse number="22" style="v" sid="MAT 11:22" />Anɔkuale munyu nɛ i ngɛ nyɛ dee ke, e maa fani ha Tiro kɛ Zidon ngɛ Kojomi Ligbi ɔ no pe nyɛ. <verse eid="MAT 11:22" /><verse number="23" style="v" sid="MAT 11:23" />Nɛ mo Kapernaum, ma nɛ a wo o hɛ mi nyami pe kulaa a, a maa ba mo si kɛ maa ya gbeje tɔɔ. Ejakaa nyakpɛ ni tsumihi nɛ i tsu ngɛ o mi ɔ, kaa Sodom i tsu ngɛ jinɛ e ngɛ kɛ ba si mwɔnɛ ɔ. <verse eid="MAT 11:23" /><verse number="24" style="v" sid="MAT 11:24" />Anɔkuale, ke Kojomi Ligbi ɔ su ɔ, e be wae ha Sodom kaa mo.”<verse eid="MAT 11:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 11:25" />Kɛkɛ nɛ Yesu sɔle nɛ e de ke, “I ngɛ mo si nae Tsaatsɛ, hiɔwe kɛ zugba Nutsɔ, kaa o ngɔ anɔkuale ni nɛ ɔmɛ ngɔ laa ni nɛmɛ nɛ buu a he ni leli, se o je ngɔ tsɔɔ bimwɔwi. <verse eid="MAT 11:25" /><verse number="26" style="v" sid="MAT 11:26" />Tsaatsɛ, ja a nɛ e sa o hɛ mi kaa o pee.”<verse eid="MAT 11:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 11:27" />“Tsaatsɛ ngɔ nɔ fɛɛ nɔ ngɔ wo ye dɛ. Tsɛ ɔ pɛ nɛ le Bi ɔ, nɛ nɔ ko li Tsɛ ɔ, ja Bi ɔ pɛ kɛ nihi nɛ Bi ɔ suɔ kaa e je Tsɛ ɔ kpo ngɔ tsɔɔ ɔ. <verse eid="MAT 11:27" /><verse number="28" style="v" sid="MAT 11:28" />Nyɛɛ ba ye ngɔ nyɛ nihi kulaa nɛ pɔ tɔ nyɛ, nɛ nyɛ tlomihi pa nyɛ ɔ nɛ ma ha nyɛ he jɔmi. <verse eid="MAT 11:28" /><verse number="29" style="v" sid="MAT 11:29" />Nyɛɛ kase mi nɛ nyɛɛ ngɔ ye subai, ejakaa ye he jɔ nɛ i baa ye he si, nɛ nyɛ klaa amɛ ma na he jɔmi, <verse eid="MAT 11:29" /><verse number="30" style="v" sid="MAT 11:30" />ejakaa ye kasemi wɛ, nɛ ye tlomi ɔ hu jii we.”<verse eid="MAT 11:30" /></para>
  <chapter eid="MAT 11" />
  <chapter number="12" style="c" sid="MAT 12" />
  <para style="s1">Hejɔɔmi Ligbi ɔ he sane</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 12:1" />Jamɛ a be ɔ mi ɔ, Yesu kɛ e kaseli ɔmɛ ya gu blɛfo ngmɔ komɛ a mi ngɛ Hejɔɔmi Ligbi ɔ nɔ. Hwɔ ngɛ e kaseli ɔmɛ yee nɛ a bɔni blɛfo ɔmɛ kpɔmi ngɛ kpee.<verse eid="MAT 12:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="MAT 12:2" />Benɛ Farisi bi ɔmɛ a kpɛti ni komɛ na mɛ ɔ, a bua jɔɛ nɛ a de Yesu ke, “O nɛ, o kaseli ɔmɛ ngɛ mlaa a nɔ tɔe. A ngɛ ni kpae ngɛ Hejɔɔmi Ligbi ɔ nɔ.”<verse eid="MAT 12:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 12:3" />Se Yesu ha mɛ heto ke, “Anɛ nyɛ kane we nɔ nɛ Matsɛ David pee benɛ hwɔ ngɛ e kɛ e huɛ ɔmɛ yee ɔ lo? <verse eid="MAT 12:3" /><verse number="4" style="v" sid="MAT 12:4" />Bɔ nɛ e sɛ Mawu we ɔ nɛ e kɛ e huɛ ɔmɛ ya ye abolo nɛ a kɛ sã bɔ ha Mawu, nɛ e dɛ blɔ kaa nɔ ko yeɔ, ja osɔfo ɔmɛ pɛ ɔ? David hu pee nɔ nɛ dɛ blɔ. <verse eid="MAT 12:4" /><verse number="5" style="v" sid="MAT 12:5" />Aloo nyɛ kane we ngɛ Mose mlaa amɛ a mi kaa osɔfo nɛ ngɛ sɔmɔe ngɛ Sɔlemi We ɔ tsuɔ ni ngɛ Hejɔɔmi Ligbi ɔ nɔ lo? <verse eid="MAT 12:5" /><verse number="6" style="v" sid="MAT 12:6" />Anɔkuale nɛ i ngɛ nyɛ dee ke, nɔ ko ngɛ hiɛ ɔ nɛ pa Sɔlemi We ɔ. <verse eid="MAT 12:6" /><verse number="7" style="v" sid="MAT 12:7" />E ji nyɛ nu Mawu Munyu ɔ nɛ deɔ ke, ‘Mɔbɔ nɛ nyɛ maa na nihi ɔ he hia mi pe nyɛ bɔ sami’ ɔ sisi jinɛ nyɛ be nihi nɛ pee we fɔ yemi nɔ ko ɔ fɔ bue. <verse eid="MAT 12:7" /><verse number="8" style="v" sid="MAT 12:8" />Ejakaa Nɔmlɔ Bi ɔ ngɛ Hejɔɔmi Ligbi ɔ tete nɔ he wami.”<verse eid="MAT 12:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 12:9" />Jehanɛ ɔ Yesu ya sɛ kpe he ɔ, <verse eid="MAT 12:9" /><verse number="10" style="v" sid="MAT 12:10" />nɛ e na nyumu ko nɛ e nine kake gbo. Kɛkɛ nɛ Farisi bi ɔmɛ bi lɛ ke, “Anɛ e da blɔ kaa a tsaa hiɔtsɛ ngɛ Hejɔɔmi Ligbi ɔ nɔ?” A bi lɛ enɛ ɔ, ejakaa a le kaa Yesu maa kplɛɛ nɔ konɛ a da nɔ kɛ po e nya.<verse eid="MAT 12:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 12:11" />Se Yesu na a susumi ɔ nɛ e bi mɛ ke, “Ke nyɛ ti nɔ ko ngɛ to kake too, nɛ e ya nɔ vu mi ngɛ Hejɔɔmi Ligbi ɔ nɔ ɔ, anɛ e ya be lɛ jee ngɛ jamɛ a ligbi ɔ nɔ lo? <verse eid="MAT 12:11" /><verse number="12" style="v" sid="MAT 12:12" />Anɛ nɔmlɔ he jua wɛ pi to lo? E da kaa a peeɔ kpakpa ngɛ Hejɔɔmi Ligbi ɔ nɔ.” <verse eid="MAT 12:12" /><verse number="13" style="v" sid="MAT 12:13" />Kɛkɛ nɛ e de hiɔtsɛ ɔ ke, “Mo kpa o nine ɔ mi!” Nɛ benɛ nyumu ɔ kpa e nine ɔ mi ɔ, e na he wami.<verse eid="MAT 12:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 12:14" />Se Farisi bi ɔmɛ na e he abofu, nɛ a tsɛ kpe konɛ a da enɛ ɔ nɔ nɛ a nu lɛ nɛ a gbe lɛ. <verse eid="MAT 12:14" /><verse number="15" style="v" sid="MAT 12:15" />Se Yesu le ga nɛ a ngɛ toe ɔ, ja a he je ɔ, e je kpe he ɔ nɛ nihi fuu nyɛɛ e se; nɛ e tsa hiɔtsɛhi kulaa nɛ ngɛ a kpɛti ɔ. <verse eid="MAT 12:15" /><verse number="16" style="v" sid="MAT 12:16" />Nɛ e bɔ mɛ kɔkɔ ke a ko ha nɛ nɔ ko nɛ nu e nyakpɛ ni tsumi ɔmɛ a he. <verse eid="MAT 12:16" /><verse number="17" style="v" sid="MAT 12:17" />Nɛ enɛ ɔ ba mi kaa bɔ nɛ Gbalɔ Yesaia de ɔ ke, <verse eid="MAT 12:17" /><verse number="18" style="v" sid="MAT 12:18" />“O nɛ, ye tsɔlɔ nɛ i hla a. Lɛ ji ye suɔmi Bi nɛ i naa e he tsui. Ma ngɔ ye mumi ɔ kɛ wo e mi, nɛ lɛ ji nɔ nɛ maa fiɛ ye kojomi ɔ ha je ɔ tsuo. <verse eid="MAT 12:18" /><verse number="19" style="v" sid="MAT 12:19" />E be pɛe nɛ e be ngmlaa kpae hulɔ, nɛ nɔ ko be e gbi nue ngɛ magbɛ nɔ. <verse eid="MAT 12:19" /><verse number="20" style="v" sid="MAT 12:20" />E be gbɔjɔlɔ ɔ hɛ mi kpatae; e be hɛ nɔ kami bɔbɔyoo gbee; nɛ e kɛ e nyagbe kunimi yemi ɔ maa gu nya tsɔmihi kulaa. <verse eid="MAT 12:20" /><verse number="21" style="v" sid="MAT 12:21" />Nɛ e biɛ ɔ maa pee hɛ nɔ kami nɔ kɛ ha je ɔ tsuo.”<verse eid="MAT 12:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 12:22" />Kɛkɛ nɛ a kɛ nyumu ko nɛ mumi yayami ngɛ e mi nɛ e hyɛ we nɔ nɛ e tui munyu hulɔ ba Yesu ngɔ nɛ e tsa lɛ, nɛ e bɔni nɔ hyɛmi kɛ munyu tumi. <verse eid="MAT 12:22" /><verse number="23" style="v" sid="MAT 12:23" />Nɛ ma asafo nɛ ngɛ lejɛ ɔ nya kpɛ a he nɛ a bi ke, “Anɛ tsa pi David bi ɔ ji nɛ ɔ lo?”<verse eid="MAT 12:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 12:24" />Se benɛ Farisi bi ɔmɛ nu nyakpɛ hiɔ tsami nɛ ɔ he ɔ, a de ke, “E hiaa mumi yayami ngɛ nihi a mi ejakaa mumi yayami ɔmɛ a tsɛ ji lɛ nitsɛ.”<verse eid="MAT 12:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 12:25" />Se akɛnɛ Yesu na a juɛmi ɔmɛ he je ɔ, e de mɛ ke, “Matsɛ yemi fɛɛ matsɛ yemi nɛ tee si kɛ woɔ lɛ nitsɛ e he ɔ, e ywiaa; ja a nɔuu nɛ ma tsuaa ma loo we tsuaa we nɛ tee si kɛ woɔ lɛ nitsɛ e he ɔ, e bɔɛ. <verse eid="MAT 12:25" /><verse number="26" style="v" sid="MAT 12:26" />Nɛ ke Abosiami hia Abosiami ɔ, lɛɛ e gba ta kɛ wo lɛ nitsɛ e he nɛ e matsɛ yemi ɔ be si dae. <verse eid="MAT 12:26" /><verse number="27" style="v" sid="MAT 12:27" />Ja a he je ɔ, ke Abosiami he wami nya i hiaa mumi yayami ngɛ ɔ, lɛɛ mɛni he wami nyɛ nyɛmi ɔmɛ kɛ hiaa mɛ mɔ? Nyɛ bi mɛ nɛ a ha nyɛ nya pomi nɛ ɔ heto. <verse eid="MAT 12:27" /><verse number="28" style="v" sid="MAT 12:28" />Se ke Mawu Mumi ɔ he wami nya i hiaa mumi yayami ɔmɛ ngɛ ɔ, lɛɛ Mawu Matsɛyemi ɔ ba su nyɛ ngɔ. <verse eid="MAT 12:28" /><verse number="29" style="v" sid="MAT 12:29" />Nɔ ko be he walɔ we mi nyɛe maa sɛ nɛ e ya ju e níhi, ja e fi he walɔ ɔ kekle loko e ma nyɛ e we ɔ mi sɛmi. <verse eid="MAT 12:29" /><verse number="30" style="v" sid="MAT 12:30" />Nɔ nɛ be ye blɔ fa mi ɔ, e te si kɛ wo mi, nɛ nɔ nɛ kɛ mi bua we nya a, e ngɛ gbɛe kɛ ngɛ fiae.<verse eid="MAT 12:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 12:31" />I ngɛ nyɛ dee ke nɔ tsuaa nɔ nɛ maa pee yayami ko aloo e maa tu musu bɔmi munyu ko kɛ si Nɔmlɔ Bi ɔ, a ma ngɔ ke lɛ, <verse eid="MAT 12:31" /><verse number="32" style="v" sid="MAT 12:32" />se nɔ nɛ maa tu musu bɔmi munyu ko kɛ si Mumi Klɔuklɔu ɔ, lɛɛ a kɛ be lɛ kɛ e ngɛ je nɛ ɔ mi aloo je nɛ maa ba a mi.<verse eid="MAT 12:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 12:33" />Tso kpakpa woɔ yiblii kpakpa, nɛ tso yaya hu woɔ yiblii yaya, ejakaa tso e yiblii nɛ a kɛ leɔ e mi tso. <verse eid="MAT 12:33" /><verse number="34" style="v" sid="MAT 12:34" />Nyɛ sinɔhi a bimɛ! Kɛ maa pee kɛɛ nɛ nyɛ nɛ nyɛ ji yayami peeli ɔ, nyɛ maa tu munyu kpakpa kɛɛ? Ejakaa bɔ nɛ nɔmlɔ tsui ngɛ ha a, ja nɛ e munyu tumi hu ngɛ. <verse eid="MAT 12:34" /><verse number="35" style="v" sid="MAT 12:35" />Nɔmlɔ kpakpa tuɔ munyu kɛ jeɔ juɛmi kpakpahi nɛ ngɛ e tsui mi kpo, nɛ nɔmlɔ yayami hu tuɔ munyu yaya kɛ jee e tsui yaya a mi. <verse eid="MAT 12:35" /><verse number="36" style="v" sid="MAT 12:36" />Nɛ i ngɛ nyɛ dee ke, nyɛ maa bu yaka munyu tsuaa yaka munyu nɛ nyɛ tuɔ ɔ he akɔtaa ngɛ Kojomi Ligbi ɔ nɔ. <verse eid="MAT 12:36" /><verse number="37" style="v" sid="MAT 12:37" />Enɛ ɔ he je ɔ, nyɛ munyu tumi ɔmɛ tsɔɔ kojomi nɛ nyɛ ma na hwɔɔ se, kaa a maa bu nyɛ bemi aloo a maa bu nyɛ fɔ.”<verse eid="MAT 12:37" /></para>
  <para style="s1">Farisi bi ɔmɛ ngɛ okadi hlae</para>
  <para style="p">
    <verse number="38" style="v" sid="MAT 12:38" />Ligbi ko ɔ, Yuda bi ɔmɛ kɛ Farisi bi ɔmɛ a hɛ mi nyɛɛli ɔmɛ a ti ni komɛ ba Yesu ngɔ ba bi lɛ nɛ e pee okadi kɛ tsɔɔ mɛ nɛ a hyɛ.<verse eid="MAT 12:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="MAT 12:39" />Se Yesu ha mɛ heto nɛ e de ke, “Yi nɔ bi yayamihi kɛ gba puɛli ngɛ okadi hlae se a be mɛ okadi kpa ko tsɔɔe ja Gbalɔ Yona okadi ɔ pɛ. <verse eid="MAT 12:39" /><verse number="40" style="v" sid="MAT 12:40" />Kaa bɔ nɛ Yona hi lo agbo ɔ muklii mi nyɔ kɛ pia ligbi etɛ ɔ, ja a nɔuu nɛ Nɔmlɔ Bi ɔ maa hi zugba a muklii mi nyɔ kɛ pia ligbi etɛ. <verse eid="MAT 12:40" /><verse number="41" style="v" sid="MAT 12:41" />Ninive bi ɔmɛ maa te si kɛ wo nyɛ yi nɔ bi nɛ ɔmɛ ngɛ kojomi ɔ mi nɛ a maa bu nyɛ fɔ, ejakaa a bu Yona fiɛmi ɔ tue nɛ a kpale ngɛ a yayami ɔmɛ a se; nɛ o nɛ, nɔ nɛ pe Yona ngɛ hiɛ ɔ amlɔ nɛ ɔ, se nyɛ he we lɛ yi. <verse eid="MAT 12:41" /><verse number="42" style="v" sid="MAT 12:42" />Woyi je loo Seba Manyɛ ɔ maa te si kɛ wo nyɛ yi nɔ bi nɛ ɔmɛ ngɛ kojomi ɔ mi nɛ e maa bu nyɛ fɔ, ejakaa e hia blɔ kɛ je tsitsaa lokoo kɛ ba bu Salomo ni lemi ɔ tue; se nɔ nɛ kle pe Salomo ngɛ hiɛ ɔ nɛ nyɛ he we lɛ yi.<verse eid="MAT 12:42" /></para>
  <para style="p">
    <verse number="43" style="v" sid="MAT 12:43" />Yi nɔ yayami nɛ ɔ ngɛ kaa nɔ ko nɛ mumi yayami ngɛ e mi. Ejakaa ke mumi yayami je nɔ ko mi nɛ e ya nyɛɛ he gbigblihi kɛ hla he jɔɔmi se e nɛ eko ɔ, <verse eid="MAT 12:43" /><verse number="44" style="v" sid="MAT 12:44" />e deɔ ke, ‘Ma kpale ye se kɛ ya he nɛ i je ɔ’. Nɛ ke e kpale kɛ ba a, e ba naa kaa nɔ ɔ tsui mi tɛ falefale nɛ nɔ ko be mi. <verse eid="MAT 12:44" /><verse number="45" style="v" sid="MAT 12:45" />E yaa nɛ e ya tsɛɔ mumi yayamihi kpaago nɛ pe lɛ ngɔ piɛɔ e he nɛ a ba sɛɔ e mi nɛ a hii lejɛ ɔ, nɛ jamɛ a nɔmlɔ ɔ plɛɔ nɔmlɔ yayami pe kekle ɔ.”<verse eid="MAT 12:45" /></para>
  <para style="p">
    <verse number="46" style="v" sid="MAT 12:46" />Benɛ Yesu ngɛ asafo ɔ munyu tue ɔ, o nɛ, e nyɛ kɛ e nyɛmimɛ ɔmɛ ba da agbo ɔ nya nɛ a ngɛ hlae nɛ a kɛ lɛ nɛ tu munyu. <verse eid="MAT 12:46" /><verse number="47" style="v" sid="MAT 12:47" />Se benɛ nɔ ko ya de lɛ ke e nyɛ kɛ e nyɛmimɛ ɔmɛ daa si ngɛ agbo ɔ nya a, <verse eid="MAT 12:47" /><verse number="48" style="v" sid="MAT 12:48" />e he nɔ ke, “Mɛnɔ ji ye nyɛ, nɛ mɛnɔmɛ hu ji ye nyɛmimɛ ɔmɛ?” <verse eid="MAT 12:48" /><verse number="49" style="v" sid="MAT 12:49" />Kɛkɛ nɛ e tsɔɔ e kaseli ɔmɛ nine nɛ e de ke, “Hyɛ, ni nɛ ɔmɛ ji ye nyɛ kɛ ye nyɛmimɛ. <verse eid="MAT 12:49" /><verse number="50" style="v" sid="MAT 12:50" />Ejakaa nɔ tsuaa nɔ nɛ peeɔ ye Tsɛ nɛ ngɛ hiɔwe ɔ suɔmi nya ni ɔ, lɛ ji ye nyɛminyumu kɛ ye nyɛmiyo kɛ ye nyɛ!”<verse eid="MAT 12:50" /></para>
  <chapter eid="MAT 12" />
  <chapter number="13" style="c" sid="MAT 13" />
  <para style="s1">Mawu Matsɛyemi ɔ he sanehi</para>
  <para style="p">
    <verse number="1-2" style="v" sid="MAT 13:1-2" />Jamɛ a ligbi ɔ nɔ nɔuu ɔ, Yesu je we ɔ mi kɛ ho ya hi si ngɛ wo ɔ nya, nɛ e kɛ we nɛ nimli babauu ba bua ngɛ lejɛ ɔ. E te si ya sɛ lɛ ko mi nɛ e hi si bɔni asafo ɔ ni tsɔɔmi ngɛ wo ɔ nya. <verse eid="MAT 13:1-2" /><verse number="3" style="v" sid="MAT 13:3" />E bu mɛ abɛhi fuu kaa enɛ ɔ kɛ tu mɛ munyu ke,</para>
  <para style="p" vid="MAT 13:3">“Ni dulɔ ko ya du ni ngɛ e ngmɔ mi. <verse eid="MAT 13:3" /><verse number="4" style="v" sid="MAT 13:4" />Benɛ e ngɛ ni ɔ fiae ɔ, ekomɛ ya pue blɔ tue, nɛ lohwe pɛlitsɛmɛ ba ba kukuɔ mɛ. <verse eid="MAT 13:4" /><verse number="5" style="v" sid="MAT 13:5" />Ekomɛ hu ya pue tɛ zugba nɔ nɛ a puɛ mla mohu, <verse eid="MAT 13:5" /><verse number="6" style="v" sid="MAT 13:6" />se akɛnɛ a nɛ zu nɛ mi kuɔ he je ɔ, benɛ pu ɔ te si ɔ, a ngla ejakaa a be sipoku. <verse eid="MAT 13:6" /><verse number="7" style="v" sid="MAT 13:7" />Ni ɔ ekomɛ ya pue mio tsohi a mi, nɛ mio ɔmɛ gbɔɔ mɛ nɛ a gbe mɛ. <verse eid="MAT 13:7" /><verse number="8" style="v" sid="MAT 13:8" />Se ni ɔ ekomɛ hu ya pue zugba kpakpa nɔ nɛ a wo yiblii fuu, ekomɛ nyingmi etɛ, ekomɛ nyingmi ekpa kɛ ekomɛ lafa. <verse eid="MAT 13:8" /><verse number="9" style="v" sid="MAT 13:9" />Nɔ nɛ ngɛ tue ɔ, e nu!”<verse eid="MAT 13:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 13:10" />E kaseli ɔmɛ ba e ngɔ ba bi lɛ ke, “Mɛni he je nɛ o pɔɔ abɛ bumi kɛ munyu tumi ɔ?”<verse eid="MAT 13:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 13:11" />E he nɔ nɛ e de mɛ ke, “Nyɛɛ lɛɛ nyɛ ngɛ he blɔ nɛ nyɛ nuɔ Hiɔwe Matsɛyemi ɔ mi laami munyu ɔmɛ a sisi, sɛ ni kpa amɛ lɛɛ a be kikɛmɛ a he blɔ nɛ ɔ.<verse eid="MAT 13:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 13:12" />Ejakaa nɔ nɛ ngɛ nɔ ko ɔ, a maa ngɔ eko kɛ piɛ he ha lɛ nɛ e maa hiɛ fuu, se nɔ nɛ be eko ɔ, bɔbɔyoo ɔ nɛ e ngɛ tete ɔ a ma kpɔ ngɛ e dɛ. <verse eid="MAT 13:12" /><verse number="13" style="v" sid="MAT 13:13" />Enɛ ɔ he je nɛ i tuɔ munyu ngɛ abɛ mi ngɛ, bɔ nɛ pee nɛ a nu, nɛ a na, se a ko nu sisi.<verse eid="MAT 13:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 13:14" />Enɛ ɔ ha Gbalɔ Yesaia gbami ɔ ba mi kaa bɔ nɛ e de ke, ‘A nu lɛɛ se a nui sisi, nɛ a na lɛɛ se a kɔ we se. <verse eid="MAT 13:14" /><verse number="15" style="v" sid="MAT 13:15" />Ejakaa a tsui ti, nɛ a tue gbo, nɛ a ma a hɛ ngmɛ konɛ a ko hyɛ nɔ nɛ a ko nu nɔ, nɛ a nu sisi nɛ a kpale kɛ ba Mawu ngɔ nɛ e tsa mɛ.’ <verse eid="MAT 13:15" /><verse number="16" style="v" sid="MAT 13:16" />Se nyɛɛ lɛɛ a gbaa nyɛ hɛ ngmɛ ɔmɛ, ejakaa a ngɛ nɔ́ hyɛe, kɛ nyɛ tue ɔmɛ, ejakaa a ngɛ nɔ́ nue. <verse eid="MAT 13:16" /><verse number="17" style="v" sid="MAT 13:17" />Ejakaa anɔkuale i ngɛ nyɛ dee ke, gbali kɛ dali babauu hla kaa a ko na níhi nɛ nyɛ ngɛ nae nɛ ɔ, se a nɛ, kɛ níhi nɛ nyɛ ngɛ nue nɛ ɔ, se a nui.<verse eid="MAT 13:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 13:18" />Jehanɛ ɔ nyɛɛ bu tue nɛ ma tsɔɔ nyɛ ni dulɔ abɛ ɔ sisi. <verse eid="MAT 13:18" /><verse number="19" style="v" sid="MAT 13:19" />Blɔ tue gbigbli he nɛ ni ɔ ekomɛ ya nɔ ɔ ji nɔ nɛ nuɔ Mawu Matsɛyemi he Manye Munyu ɔ se e nui sisi, kɛkɛ ɔ Abosiami baa ba saa nɔ nɛ a du ngɛ e tsui mi ɔ.<verse eid="MAT 13:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 13:20" />Nɛ tɛ zugba a he nɛ ni ɔ ekomɛ ya nɔ ɔ ji nɔ nɛ nuɔ Manye Munyu ɔ kɛ bua jɔmi, <verse eid="MAT 13:20" /><verse number="21" style="v" sid="MAT 13:21" />se akɛnɛ e be sipoku ngɛ e mi ɔ, e hii si kɛkɛ; nɛ ke haomi loo yi mi wami ba ngɛ Munyu ɔ he ɔ, e ngmɛɛ Munyu ɔ he amlɔ ɔ nɔuu. <verse eid="MAT 13:21" /><verse number="22" style="v" sid="MAT 13:22" />Nɛ mio tso zugba a he nɛ ni ɔ ekomɛ ya nɔ ɔ ji nɔ nɛ nuɔ Munyu ɔ, se je nɛ ɔ mi nyagbahi kɛ ni nami se dimi gbee Munyu ɔ nɛ e wui yiblii.<verse eid="MAT 13:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 13:23" />Zugba kpakpa mi he nɛ ni ɔ ekomɛ ya nɔ ɔ ji, nɔ nɛ nuɔ Munyu ɔ nɛ e kɔɔ se, nɛ e woɔ yiblii, ekomɛ nyingmi etɛ, ekomɛ nyingmi ekpa, kɛ ekomɛ hu lafa ngɛ Matsɛyemi ɔ mi.”<verse eid="MAT 13:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 13:24" />Yesu bu mɛ abɛ kpa ko hu ke, “Hiɔwe Matsɛyemi ɔ ngɛ kaa ni dulɔ ko nɛ ya du ni kpakpa ngɛ e ngmɔ ɔ mi, <verse eid="MAT 13:24" /><verse number="25" style="v" sid="MAT 13:25" />se benɛ nɔ tsuaa nɔ hwɔ si ɔ, e he nyɛlɔ ko ho ya du mio wuhi kɛ futu ngma nɛ e du ɔ mi nɛ e je. <verse eid="MAT 13:25" /><verse number="26" style="v" sid="MAT 13:26" />Benɛ ngma a puɛ nɛ e bɔni wami ɔ, mio tso ɔmɛ hu bɔni wami ngɛ a kpɛti.<verse eid="MAT 13:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 13:27" />Nɛ apaa yeli ɔmɛ ba ba de ngmɔtsɛ ɔ ke, ‘Mawetsɛ, anɛ pi dumi ni kpakpa nɛ o du ngɛ o ngmɔ ɔ mi ɔ? Jije nɛ mio nɛ ɔmɛ je mɔ?’<verse eid="MAT 13:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 13:28" />E he nɔ nɛ e de mɛ ke, ‘He nyɛlɔ ko nɛ ya tsu kikɛmɛ a nɔ́ nɛ ɔ nɛ.’ Apaa yeli ɔmɛ bi lɛ ke, ‘Anɛ o suɔ kaa wa ya hiaa mio ɔmɛ ngɛ ni ɔmɛ a kpɛti lo?’<verse eid="MAT 13:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 13:29" />E ha mɛ heto ke, ‘Dabi, eko ɔ ke nyɛ ngɛ mɛ hiae ɔ, nyɛ maa hiaa ngma kpakpa a kɛ futu mi. <verse eid="MAT 13:29" /><verse number="30" style="v" sid="MAT 13:30" />Lɔ ɔ he je ɔ, nyɛɛ ngmɛɛ mɛ tsuo a he nɛ a wa kɛ ya si ni kpami be ɔ nɛ a bua mio ɔmɛ a nya nɛ a tsɔ mɛ la, konɛ a bua ngma a hu nya nɛ a to mɛ ngɛ gba mi.’ ” <verse eid="MAT 13:30" /><verse number="31" style="v" sid="MAT 13:31" />Yesu bu mɛ abɛ kpa ke, “Hiɔwe Matsɛyemi ɔ ngɛ kaa sinapi wu nyafii nɛ a du ngɛ ngmɔ mi. <verse eid="MAT 13:31" /><verse number="32" style="v" sid="MAT 13:32" />Sinapi wu ji dumi wu ko nɛ klee we kulaa se ke e puɛ ɔ, e waa nɛ e plɛɔ tso agbo pe kulaa nɛ lohwe pɛlitsɛmɛ baa ba maa tsuhi ngɛ e nɔ.”<verse eid="MAT 13:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 13:33" />E bu mɛ abɛ kpa ko hu ke, “Hiɔwe Matsɛyemi ɔ ngɛ kaa blodo sami tsopa nɛ yo ko ngɔ kɛ futu blodo ma mi nɛ e mlɛ kɛ ya su be nɛ e ha ma a tsuo fu.”<verse eid="MAT 13:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 13:34" />Yesu pɔɔ abɛ nɛ ɔmɛ bumi kɛ tuɔ munyu kɛ tsɔɔ asafo ɔmɛ. <verse eid="MAT 13:34" /><verse number="35" style="v" sid="MAT 13:35" />Bɔ nɛ pee nɛ nɔ nɛ gbalɔ ɔ de nɛ ɔ nɛ ba mi ke, “I kɛ mɛ maa tu munyu ngɛ abɛhi a mi; ma de mɛ níhi nɛ a ngɔ laa kɛ je je ɔ sisije ɔ.” <verse eid="MAT 13:35" /><verse number="36" style="v" sid="MAT 13:36" />Kɛkɛ nɛ Yesu si asafo ɔ kɛ ba we ɔ mi. Nɛ e kaseli ɔmɛ ba e ngɔ ba de lɛ ke, “Moo tsɔɔ wɔ mio kɛ ngma abɛ ɔ sisi.”<verse eid="MAT 13:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="MAT 13:37" />Nɛ e he nɔ ke, “Nɔmlɔ Bi ɔ ji nɔ nɛ du dumi ni kpakpa a nɛ. <verse eid="MAT 13:37" /><verse number="38" style="v" sid="MAT 13:38" />Nɛ ngmɔ ɔ ji je ɔ nɛ, nɛ dumi ni kpakpa amɛ ji Matsɛyemi ɔ mi bimɛ ɔmɛ; nɛ mio ɔmɛ ji Abosiami bimɛ ɔmɛ. <verse eid="MAT 13:38" /><verse number="39" style="v" sid="MAT 13:39" />Nɛ he nyɛlɔ nɛ ya du mio ɔ ji Abosiami; ngma kpami be ɔ ji je ɔ nyagbe ɔ, nɛ ni kpali ɔmɛ ji Mawu bɔfo ɔmɛ.<verse eid="MAT 13:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="MAT 13:40" />Nɛ kaa bɔ nɛ a bua mio ɔmɛ a nya nɛ a tsɔ mɛ la a, ja a nɔuu e maa ba mi ngɛ je ɔ nyagbe mi. <verse eid="MAT 13:40" /><verse number="41" style="v" sid="MAT 13:41" />Nɔmlɔ Bi ɔ maa tsɔ e bɔfo ɔmɛ kɛ ba nɛ a ma ba bua nane kpatami nɔ tsuaa nɔ kɛ yayami peeli tsuo a nya kɛ je Matsɛyemi ɔ mi, <verse eid="MAT 13:41" /><verse number="42" style="v" sid="MAT 13:42" />nɛ a maa ngɔ mɛ kɛ wo la nɛ ngɛ tsoe glegleegle ɔ mi. Lejɛ ɔ ya fomi kɛ lungu nya kpemi maa hi. <verse eid="MAT 13:42" /><verse number="43" style="v" sid="MAT 13:43" />Nɛ dali ɔmɛ ma kpɛ kaa pu ngɛ a Tsɛ Matsɛyemi ɔ mi. Nɔ nɛ ngɛ tue ɔ, e nu!<verse eid="MAT 13:43" /></para>
  <para style="p">
    <verse number="44" style="v" sid="MAT 13:44" />Hiɔwe Matsɛyemi ɔ ngɛ kaa june nɛ a ngɔ kɛ laa ngɛ ngmɔ ko mi nɛ nɔ ko ya hiɛ. Nɛ benɛ e na june ɔ, lɛ hu e ngɔ kɛ laa ekohu; nɛ e bua nɛ jɔ sɔuu ɔ, e ho ya jua níhi tsuo nɛ e ngɛ ɔ nɛ e na sika bɔ nɛ sa nɛ e kɛ ya he jamɛ a ngmɔ ɔ konɛ e nine nɛ su june ɔ nɔ.<verse eid="MAT 13:44" /></para>
  <para style="p">
    <verse number="45" style="v" sid="MAT 13:45" />Jehanɛ ɔ hu, Hiɔwe Matsɛyemi ɔ ngɛ kaa jua yelɔ ko nɛ ngɛ june kpakpa hlae. <verse eid="MAT 13:45" /><verse number="46" style="v" sid="MAT 13:46" />Benɛ e ya na june kake nɛ he jua wa a, e ho nɛ e ya jua nɔ tsuaa nɔ nɛ e ngɛ ɔ nɛ e kɛ he.<verse eid="MAT 13:46" /></para>
  <para style="p">
    <verse number="47" style="v" sid="MAT 13:47" />Jehanɛ ɔ hu, Hiɔwe Matsɛyemi ɔ ngɛ kaa ya nɛ a fɔ ngɛ wo mi nɛ e gbe lo slɔɔtohi, nɔ nɛ hi kɛ nɔ nɛ hi tsuo eko. <verse eid="MAT 13:47" /><verse number="48" style="v" sid="MAT 13:48" />Nɛ benɛ ya a hyi ɔ, a sa lɛ kɛ ba wo dɔ ɔ mi nɛ a hi si wo he nɛ a bua lo kpakpa amɛ a nya kɛ wo gogahi a mi kɛkɛ nɛ a sake lo nɛ hí ɔmɛ ngɔ pue he. <verse eid="MAT 13:48" /><verse number="49" style="v" sid="MAT 13:49" />Kikɛ ɔ nɔuu e maa ba mi ngɛ je ɔ nyagbe mi, hiɔwe bɔfo ɔmɛ maa ba nɛ a ma ba hla nimli yayami ɔmɛ ngɛ dali ɔmɛ a kpɛti, <verse eid="MAT 13:49" /><verse number="50" style="v" sid="MAT 13:50" />nɛ a ma sake yayami peeli ɔmɛ kɛ wo la glegleegle mi, nɛ lejɛ ɔ ya fomi kɛ lungu nya kpemi maa hi.” <verse eid="MAT 13:50" /><verse number="51" style="v" sid="MAT 13:51" />Yesu bi mɛ ke, “Anɛ nyɛ nu ni nɛ ɔmɛ tsuo a sisi lo?” Nɛ a he nɔ ke, “Ee, Mawetsɛ.”<verse eid="MAT 13:51" /></para>
  <para style="p">
    <verse number="52" style="v" sid="MAT 13:52" />Nɛ e de mɛ ke, “Enɛ ɔ he ɔ, mlaa Tsɔɔlɔ fɛɛ mlaa Tsɔɔlɔ nɛ a pee lɛ ye kaselɔ ɔ, e ngɛ june enyɔ, Somi Momo ɔ mi nɔ kɛ Somi He ɔ mi nɔ ɔ.”<verse eid="MAT 13:52" /></para>
  <para style="s1">Nazaret yami</para>
  <para style="p">
    <verse number="53" style="v" sid="MAT 13:53" />Benɛ Yesu gbe abɛ ɔmɛ a bumi nya a, e je lejɛ ɔ <verse eid="MAT 13:53" /><verse number="54" style="v" sid="MAT 13:54" />nɛ e kpale kɛ ba lɛ nitsɛ e ma mi Nazaret ngɛ Galilea nɛ e ba tsɔɔ mɛ ni ngɛ kpe he ɔ. E nile kɛ okadihi nɛ e pee ɔ ha a nya kpɛ a he nɛ a bi ke, “Jije Nɔmlɔ nɛ ɔ ya na nile kɛ nyakpɛ he wami ni nɛ ɔmɛ ke je?<verse eid="MAT 13:54" /></para>
  <para style="p">
    <verse number="55" style="v" sid="MAT 13:55" />Anɛ tsa pi kapitɛ ɔ bi ɔ ji nɛ ɔ lo? Anɛ tsa pi e nyɛ nɛ a tsɛɛ ke Maria a kɛ e nyɛmimɛ nyumuhi Yakobo kɛ Yosef kɛ Simon kɛ Yuda a? <verse eid="MAT 13:55" /><verse number="56" style="v" sid="MAT 13:56" />Nɛ e nyɛmiyi ɔmɛ, anɛ pi waa kɛ mɛ tsuo nɛ ngɛ hiɛ ɔ? Jije nɛ e ya na nile nɛ ɔ kɛ je mɔ?” <verse eid="MAT 13:56" /><verse number="57" style="v" sid="MAT 13:57" />Kɛkɛ nɛ a mi mi fu lɛ. Se Yesu de mɛ ke, “A woɔ gbalɔ hɛ mi nyami ngɛ he fɛɛ he, se pi ngɛ lɛ nitsɛ e ma mi kɛ e we bimɛ a kpɛti.” <verse eid="MAT 13:57" /><verse number="58" style="v" sid="MAT 13:58" />Akɛnɛ a he we yi he je ɔ, e pee we nyakpɛ ni fuu ko ngɛ lejɛ ɔ.<verse eid="MAT 13:58" /></para>
  <chapter eid="MAT 13" />
  <chapter number="14" style="c" sid="MAT 14" />
  <para style="s1">Yohane gbenɔ</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 14:1" />Benɛ Matsɛ Herode nu Yesu he ɔ, <verse eid="MAT 14:1" /><verse number="2" style="v" sid="MAT 14:2" />e de e sɔmɔli ɔmɛ ke, “Yohane Baptisilɔ ɔ ji lɔ ɔ nɛ, e te si kɛ je gbeje kɛ ba. Lɔ ɔ he je nɛ e nyɛ ngɛ nyakpɛ ni nɛ ɔmɛ tsue ngɛ ɔ nɛ.” <verse eid="MAT 14:2" /><verse number="3" style="v" sid="MAT 14:3" />E ba mi kaa Herode nu Yohane nɛ e fi lɛ, nɛ e wo lɛ tsu mi ngɛ Herodia nɛ ji e nyɛmi Filipo yo nɛ e kɛ lɛ ba ngɛ ɔ he, <verse eid="MAT 14:3" /><verse number="4" style="v" sid="MAT 14:4" />ejakaa Yohane de lɛ ke e sɛ kaa e ngɔ lɛ. <verse eid="MAT 14:4" /><verse number="5" style="v" sid="MAT 14:5" />Herode ko gbe Yohane, se e ya ye asafo ɔ gbeye, ejakaa a buu Yohane gbalɔ.<verse eid="MAT 14:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 14:6" />Benɛ Herode ngɛ e fɔmi ligbi yee ɔ, Herodia biyo ɔ ya do ngɛ ni ɔmɛ a hɛ mi, nɛ e domi ɔ pee Herode fɛu saminya, <verse eid="MAT 14:6" /><verse number="7" style="v" sid="MAT 14:7" />nɛ e ka kita kɛ wo yoyo ɔ si kaa e ma ha lɛ nɔ tsuaa nɔ nɛ e ma bi lɛ. <verse eid="MAT 14:7" /><verse number="8" style="v" sid="MAT 14:8" />Kɛkɛ nɛ e nyɛ ɔ wo lɛ ga kaa e bi Herode ke e suɔ nɛ e ngɔ Yohane Baptisilɔ ɔ yi ngɔ fɔ suwe nɔ kɛ ha lɛ.<verse eid="MAT 14:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 14:9" />E he wa ha matsɛ ɔ, se akɛnɛ e ka kita ngɛ nihi nɛ ba ni yemi ɔ a hɛ mi nɛ e sɛ kaa e tɔ he je ɔ, e fa nɛ a tsu e kita a he ni.<verse eid="MAT 14:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 14:10" />Enɛ ɔ ha a ho ya po Yohane yi ngɛ tsu ɔ mi, <verse eid="MAT 14:10" /><verse number="11" style="v" sid="MAT 14:11" />nɛ a ngɔ e yi ɔ ngɔ fɔ suwe nɔ kɛ ba ha yiheyo ɔ, nɛ e kɛ ya ha e nyɛ ɔ.<verse eid="MAT 14:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 14:12" />Nɛ Yohane kaseli ɔmɛ ba nɛ a ba wo e gbogboe ɔ nɛ a ya pu; nɛ lɔ ɔ se ɔ, a ho ya bɔ Yesu amaniɛ.<verse eid="MAT 14:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 14:13" />Benɛ Yesu nu Yohane gbenɔ ɔ he nɔuu ɔ, e je lejɛ ɔ zaa nɛ e ya sɛ lɛ mi kɛ ho nga nɔ he ko banee ya. Nɛ benɛ asafo ɔ nu ɔ, a je ma amɛ kɛ kɔpe ɔmɛ a mi nɛ a nyɛɛ nane kɛ bu e se.<verse eid="MAT 14:13" /></para>
  <para style="s1">Yesu ha nimli akpe enuɔ niye ni</para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 14:14" />Benɛ Yesu je kpo ngɛ lɛ ɔ mi nɛ e ba na asafo babauu ɔ, e mi mi sa lɛ ngɛ a he nɛ e tsa nihi nɛ be he wami ngɛ a kpɛti ɔmɛ.<verse eid="MAT 14:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 14:15" />Jamɛ a gbɔkuɛ ɔ, e kaseli ɔmɛ ba e ngɔ ba de lɛ ke, “Nga nɔ wa ngɛ ngɛ hiɛ ɔ, nɛ je ngɛ jɔe. Moo wo asafo ɔ blɔ nɛ a ya ma amɛ a mi nɛ a ya he niye ni.”<verse eid="MAT 14:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 14:16" />Se Yesu he nɔ nɛ e de mɛ ke, “E he hia we kaa a ya, nyɛ nitsɛmɛ nyɛ ha mɛ nɔ ko nɛ a ye!”<verse eid="MAT 14:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 14:17" />Nɛ a de lɛ ke, “Abolo nyafinyafi enuɔ kɛ lo enyɔ pɛ wa ngɛ ngɛ hiɛ ɔ!”<verse eid="MAT 14:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 14:18" />Nɛ e de mɛ ke, “Nyɛ wo kɛ ba hiɛ ɔ.”<verse eid="MAT 14:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 14:19" />Kɛkɛ nɛ e fa asafo ɔ ke a hi si ngɛ nga a nɔ; nɛ e muɔ abolo enuɔ kɛ lo enyɔ ɔ, nɛ e hyɛ hiɔwe, nɛ e gbaa nɔ. E ku a mi nɛ e ngɔ ha e kaseli ɔmɛ, nɛ kaseli ɔmɛ gba ngɔ ha asafo ɔ. <verse eid="MAT 14:19" /><verse number="20" style="v" sid="MAT 14:20" />Nɛ mɛ tsuo a ye nɛ a tɔ, nɛ kaseli ɔmɛ kukuɔ bibliwi nɛ piɛ ɔ ngɔ wo kusii nyɔngma kɛ enyɔ mi nɛ a hyi tɔtɔɔtɔ.<verse eid="MAT 14:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 14:21" />Nyumuhi nɛ ye ni ɔ maa su akpe enuɔ, e slo yihi kɛ jokuɛwi. <verse eid="MAT 14:21" /><verse number="22" style="v" sid="MAT 14:22" />Enɛ ɔ se ɔ, Yesu wo e kaseli ɔmɛ blɔ nɛ a wo lɛ kɛ sɛ e hlami kɛ ho wo ɔ se je ya, nɛ lɛɛ e mlɛ nɛ lɛ nitsɛ e wo ni ɔmɛ blɔ.<verse eid="MAT 14:22" /></para>
  <para style="s1">Yesu nyɛɛ wo he mi</para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 14:23" />Benɛ e wo asafo ɔ blɔ se ɔ, e pue nɔ kɛ ho yoku ɔ nɔ ya nɛ e ya sɔle. Se benɛ je jɔ, <verse eid="MAT 14:23" /><verse number="24" style="v" sid="MAT 14:24" />nɛ e kaseli ɔmɛ ngɛ lɛ ɔ mi kɛ yaa a, lɛ ɔ ya bɔni kpami, ejakaa e ngɛ kɔɔhiɔ kpee.<verse eid="MAT 14:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 14:25" />Maa pee makɛ ngmlɛ eywiɛ mi ɔ, Yesu nyɛɛ wo ɔ hɛ mi kɛ ya na mɛ. <verse eid="MAT 14:25" /><verse number="26" style="v" sid="MAT 14:26" />Se benɛ kaseli ɔmɛ na lɛ nɛ e ngɛ wo ɔ hɛ mi nyɛɛe kɛ ma a ngɔ ɔ, a tsui po nɛ a kpa ngmlaa, ejakaa a susu kaa kpade i.<verse eid="MAT 14:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 14:27" />Se amlɔ ɔ, Yesu kɛ mɛ tu munyu nɛ e de mɛ ke, “Nyɛ ko ye gbeye, ami i.”<verse eid="MAT 14:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 14:28" />Petro he nɔ nɛ e de lɛ ke, “Mawetsɛ, ke mo tutuutu i ɔ, lɛɛ mo ha nɛ ma nyɛɛ nyu ɔ hɛ mi kɛ ba o ngɔ.”<verse eid="MAT 14:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 14:29" />Yesu de lɛ ke, “Ba!” Kɛkɛ nɛ Petro je kpo ngɛ lɛ ɔ mi nɛ e bɔni nyu ɔ hɛ mi nyɛɛmi kɛ yaa Yesu ngɔ. <verse eid="MAT 14:29" /><verse number="30" style="v" sid="MAT 14:30" />Se benɛ e na bɔ nɛ oslɔke ɔmɛ ngɛ kue ha a, e tsui po, nɛ nɔuu ɔ, e bɔni mumi. E kpa ngmlaa nɛ e de ke, “Nutsɔ, mo he mi!”<verse eid="MAT 14:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 14:31" />Amlɔ nɔuu ɔ, Yesu kpa e nine mi nɛ e nu lɛ; nɛ e de lɛ ke, “Mo nɛ o hemi kɛ yemi pi, mɛni he je nɛ o ngɛ nguane jee ɔ?” <verse eid="MAT 14:31" /><verse number="32" style="v" sid="MAT 14:32" />Nɛ benɛ a sɛ lɛ ɔ mi ɔ, kɛkɛ nɛ kɔɔhiɔ ɔ nya ba si.<verse eid="MAT 14:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 14:33" />Nɛ ni nɛmɛ nɛ ngɛ lɛ ɔ mi ɔ a nya kpɛ a he nɛ a de ke, “Niinɛ, Mawu Bi ji mo!”<verse eid="MAT 14:33" /></para>
  <para style="s1">Yesu tsa hiɔtsɛhi ngɛ Genesaret</para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 14:34" />Nɛ a po wo ɔ kɛ ba Genesaret zugba a nɔ. <verse eid="MAT 14:34" /><verse number="35" style="v" sid="MAT 14:35" />Nɛ benɛ Genesaret bi ɔmɛ na kaa Yesu i ɔ, a tsɔ kɛ ya lejɛ ɔ kɔpe ɔmɛ tsuo a mi nɛ a ya ngɔ hiɔtsɛhi kɛ ba e ngɔ nɛ e tsa mɛ. <verse eid="MAT 14:35" /><verse number="36" style="v" sid="MAT 14:36" />Hiɔtsɛ ɔmɛ kpa lɛ pɛɛ kaa e ha nɛ a ta e tade ɔ nya he kɛkɛ, nɛ nihi abɔ nɛ ta he ɔ, mɛ tsuo a na he wami.<verse eid="MAT 14:36" /></para>
  <chapter eid="MAT 14" />
  <chapter number="15" style="c" sid="MAT 15" />
  <para style="s1">Blema mlaahi</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 15:1" />Nɛ Farisi bi kɛ mlaa tsɔɔli komɛ nɛ je Yerusalem ɔ ba bi Yesu ke, <verse eid="MAT 15:1" /><verse number="2" style="v" sid="MAT 15:2" />“Mɛni he je nɛ o kaseli ɔmɛ yi Yuda bi ɔmɛ a blema kusumi ɔmɛ a nɔ ɔ? Ejakaa mɛɛ lɛɛ a fɔ we a dɛ kaa bɔ nɛ wa kusumi ɔ ngɛ ɔ loko ji a yeɔ ni.” <verse eid="MAT 15:2" /><verse number="3" style="v" sid="MAT 15:3" />Yesu he nɔ nɛ e bi mɛ ke, “Mɛni he je nɛ nyɛ hu nyɛɛ kɛ nyɛ kusumi ɔmɛ tɔɔ Mawu kita amɛ a nɔ ɔ? <verse eid="MAT 15:3" /><verse number="4" style="v" sid="MAT 15:4" />Ejakaa Mawu de ke, ‘Buu o tsɛ kɛ o nyɛ, nɛ nɔ tsuaa nɔ nɛ gbiɛɛ e tsɛ loo e nyɛ ɔ, a maa gbe le.’ <verse eid="MAT 15:4" /><verse number="5" style="v" sid="MAT 15:5" />Se nyɛɛ lɛɛ nyɛ deɔ ke, ‘Ke ji e fi nyɛ fɔli ɔmɛ tete ɔ, nɔ nɛ nyɛ ma kɛ ye kɛ bua mɛ ɔ, nyɛ ma kɛ ba ha asafo ɔ mohu.’ <verse eid="MAT 15:5" /><verse number="6" style="v" sid="MAT 15:6" />Enɛ ɔ he je ɔ, nyɛ ngɔ nyɛ nitsɛmɛ nyɛ mlaa amɛ kɛ to Mawu kita nɛ e wo kaa o bu o tsɛ kɛ o nyɛ nɛ o hyɛ a nɔ ɔ nane mi. <verse eid="MAT 15:6" /><verse number="7" style="v" sid="MAT 15:7" />Osatotsɛmɛ! Anɔkuale munyu nɛ Yesaia tu ngɛ nyɛ he ke, <verse eid="MAT 15:7" /><verse number="8" style="v" sid="MAT 15:8" />‘Ni nɛ ɔmɛ kɛ a nya woɔ ye hɛ mi nyami, se e ji a tsui mi. <verse eid="MAT 15:8" /><verse number="9" style="v" sid="MAT 15:9" />Yaka tsuaa nɛ a jaa mi ɔ nɛ, ejakaa a tsɔɔ we Mawu kita amɛ, se mohu nimli a mlaa amɛ nɛ a tsɔɔ.’ ”<verse eid="MAT 15:9" /></para>
  <para style="s1">He mu womi nihi</para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 15:10" />Nɛ Yesu tsɛ asafo ɔ kɛ ba e ngɔ nɛ e de mɛ ke, “Nyɛɛ bu nɔ nɛ ma de ɔ tue, nɛ nyɛɛ nu sisi. <verse eid="MAT 15:10" /><verse number="11" style="v" sid="MAT 15:11" />Tsa pi nɔ nɛ yaa nɔ nya mi ɔ nɛ peeɔ nɔmlɔ mutsɛ, se mohu nɔ nɛ jee nɔ nya mi ɔ ji nɔ nɛ woɔ lɛ mu.”<verse eid="MAT 15:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 15:12" />Kɛkɛ nɛ e kaseli ɔmɛ ba e ngɔ ba de lɛ ke, “Anɛ o le kaa benɛ Farisi bi ɔmɛ nu munyu ɔ nɛ o tu ɔ, a na o he abofu ɔ?”<verse eid="MAT 15:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 15:13" />Nɛ e he nɔ ke, “Tso tsuaa tso nɛ pi ye Tsɛ ngɛ hiɔwe ɔ nɛ ma lɛ ɔ, a maa hia lɛ. <verse eid="MAT 15:13" /><verse number="14" style="v" sid="MAT 15:14" />Nyɛ ko di a se. Hɛ yuyuili nɛ ngɛ hɛ yuyuili blɔ tsɔɔe ji mɛ, mɛ tsuo a ma ya nɔ muɔ mi.”<verse eid="MAT 15:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 15:15" />Petro he nɔ nɛ e bi Yesu ke, “tsɔɔ wɔ abɛ ɔ nɛ o bu ke tsa pi nɔ nɛ yaa nɔ nya mi ɔ nɛ peeɔ nɔmlɔ mutsɛ ɔ sisi.”<verse eid="MAT 15:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 15:16" />Nɛ Yesu bi ke, “Anɛ nyɛ hu nyɛ nui ni nɛ ɔmɛ a sisi kɛ sa? <verse eid="MAT 15:16" /><verse number="17" style="v" sid="MAT 15:17" />Anɛ nyɛ li kaa nɔ tsuaa nɔ nɛ yaa nɔ nya mi ɔ, muklii mi e ya sɛɛ loko ji a ya jeɔ kɛ woɔ agbotso mi lo? <verse eid="MAT 15:17" /><verse number="18" style="v" sid="MAT 15:18" />Se munyu yayahi nɛ jee nya mi jee kpo ɔ, tsui mi a jee, nɛ mɛ ji níhi nɛ woɔ nɔmlɔ he mu ɔ nɛ. <verse eid="MAT 15:18" /><verse number="19" style="v" sid="MAT 15:19" />Ejakaa tsui mi nɛ susumi yayahi kaa, nɔmlɔ gbemi, gba puɛmi, ajuama bɔmi, jumi, lakpa kɛ nyangɔ odase yemi kɛ musu bɔmi jee. <verse eid="MAT 15:19" /><verse number="20" style="v" sid="MAT 15:20" />Ni nɛ ɔmɛ ji níhi nɛ woɔ nɔmlɔ he mu, se dɛ nɛ a fɔ we loko ji a yeɔ ni ɔ, e wui nɔ he mu ngɛ mumi mi.”<verse eid="MAT 15:20" /></para>
  <para style="s1">Kanaa yo ɔ hemi kɛ yemi</para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 15:21" />Nɛ Yesu je lejɛ ɔ, e nyɛɛ nane kɛ ho Tiro kɛ Zidon ni ɔmɛ a mi ya. <verse eid="MAT 15:21" /><verse number="22" style="v" sid="MAT 15:22" />Kɛkɛ nɛ Kanaa yo ko nɛ je lejɛ ɔ ni ɔmɛ a mi ɔ ba e ngɔ kɛ ngmlaa ke, “Naa mi mɔbɔ, Nutsɔ, Matsɛ David Bi! Mumi yayami ko ngɛ ye biyo haoe.”<verse eid="MAT 15:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 15:23" />Se Yesu pui e nya mi. Nɛ e kaseli ɔmɛ ba e ngɔ ba kpa lɛ pɛɛ nɛ a de lɛ ke, “Moo wo lɛ blɔ nɛ e ho, ejakaa e ngɛ ngmlaa kpae kɛ ngɛ wa se nyɛɛe tsɔ.”<verse eid="MAT 15:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 15:24" />Nɛ e he nɔ de mɛ ke, “Israel tohi nɛ laa amɛ a ngɔ kɛkɛ nɛ a tsɔ mi, pi ma je li ɔmɛ a ngɔ.”<verse eid="MAT 15:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 15:25" />Se yo ɔ ba ba kpla si ngɛ e hɛ mi nɛ e de lɛ kɛ pɛɛ kpami ekohu ke, “Mawetsɛ, moo ye kɛ bua mi!”<verse eid="MAT 15:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 15:26" />Yesu he nɔ ke, “E dɛ kaa a ngɔɔ bimɛ abolo ɔ sakee kɛ haa gbehi.”<verse eid="MAT 15:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 15:27" />Nɛ yo ɔ he nɔ ke, “Mawetsɛ, ja i mohu, se tse gbe bi ɔmɛ hu yeɔ bibliwi nɛ pueɔ si ngɛ a nutsɔ o okplɔɔ ɔ sisi ɔ eko!”<verse eid="MAT 15:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 15:28" />Kɛkɛ nɛ Yesu ha lɛ heto ke, “Yo, o hemi kɛ yemi ɔ kle! A pee ha mo kaa bɔ nɛ o ngɛ hlae ɔ.” Nɛ a tsa e biyo ɔ jamɛ a ngmlɛfia a nɔ nɔuu.<verse eid="MAT 15:28" /></para>
  <para style="s1">Yesu tsa hiɔtsɛmɛ</para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 15:29" />Yesu je lejɛ ɔ kɛ ba Galilea wo ɔ nya, nɛ e kuɔ kɛ ya yoku ɔ nɔ, nɛ e ya hi si ngɛ lejɛ ɔ. <verse eid="MAT 15:29" /><verse number="30" style="v" sid="MAT 15:30" />Nihi babauu ba e ngɔ nɛ a wo nihi nɛ kplɔ kɛ nihi nɛ hɛ yu kɛ libɔɔhi kɛ mumuihi kɛ ni kpahi fuu kɛ ba pue e nane nya nɛ e tsa mɛ tsuo. <verse eid="MAT 15:30" /><verse number="31" style="v" sid="MAT 15:31" />Nɛ ni ɔmɛ a nya kpɛ a he benɛ a na kaa mumui ɔmɛ ngɛ munyu tue, libɔɔ ɔmɛ te si, nihi nɛ kplɔ ɔmɛ ngɛ nyɛɛe, nɛ nihi nɛ he yu ɔmɛ hu ngɛ nɔ hyɛe ɔ, a wo Israel Mawu ɔ hɛ mi nyami.<verse eid="MAT 15:31" /></para>
  <para style="s1">Yesu ha nimli akpe eywiɛ niye ni</para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 15:32" />Kɛkɛ nɛ Yesu tsɛ e kaseli ɔmɛ kɛ ba e ngɔ nɛ e de mɛ ke, “Nimli nɛ ɔmɛ a he mɔbɔ ngɛ mi pee, ejakaa mwɔnɛ ɔ ji ligbi etɛ sɔuu nɛ a kɛ mi hi si nɛ a nɛ nɔ ko nɛ a ye i sume kaa ma wo mɛ blɔ kɛ muklii mi gu nɛ klibi nɛ ya po mɛ ngɛ blɔ ɔ nɔ.”<verse eid="MAT 15:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 15:33" />E kaseli ɔmɛ bi lɛ ke, “Jije wa ma na abolo fuu ngɛ ngɛ nga nɛ ɔ nɔ nɛ maa su asafo nɛ ɔ nya?”<verse eid="MAT 15:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 15:34" />Nɛ Yesu bi mɛ ke, “Abolo nyɛmɛ nyɛ ngɛ?” A de lɛ ke, “Kpaago kɛ lo tsɔwi bɔɔ ko.”<verse eid="MAT 15:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="MAT 15:35" />Nɛ e fa asafo ɔ ke a hi si ngɛ zugba. <verse eid="MAT 15:35" /><verse number="36" style="v" sid="MAT 15:36" />Kɛkɛ nɛ e kukuɔ abolo kpaago ɔ kɛ lo ɔmɛ, nɛ benɛ e gbaa nɔ ɔ, e ku a mi nɛ e ngɔ kɛ ha e kaseli ɔmɛ nɛ mɛ hu a ngɔ kɛ ha asafo ɔ. <verse eid="MAT 15:36" /><verse number="37" style="v" sid="MAT 15:37" />Nɛ mɛ tsuo a ye nɛ a tɔ, nɛ kaseli ɔmɛ bua bibliwi nɛ piɛ ɔ nya nɛ a na kusii kpaago nɛ a hyi tɔtɔɔtɔ. <verse eid="MAT 15:37" /><verse number="38" style="v" sid="MAT 15:38" />Nihi nɛ ye ni ɔ, a nya ji nyumuhi akpe eywiɛ, e slo yihi kɛ jokuɛwi.<verse eid="MAT 15:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="MAT 15:39" />Jehanɛ ɔ, Yesu wo asafo ɔ blɔ nɛ lɛ nitsɛ e wo lɛ nɛ e pue nɔ kɛ ba Magadan ni ɔmɛ a mi.<verse eid="MAT 15:39" /></para>
  <chapter eid="MAT 15" />
  <chapter number="16" style="c" sid="MAT 16" />
  <para style="s1">Okadi hlami</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 16:1" />Ligbi ko ɔ, Farisi bi kɛ Saduki bi ɔmɛ ba ka Yesu nɛ a bi lɛ nɛ e tsɔɔ mɛ hiɔwe okadi ko. <verse eid="MAT 16:1" /><verse number="2-3" style="v" sid="MAT 16:2-3" />E he nɔ nɛ e de mɛ ke, “Gbɔkuɛ mi ɔ, nyɛ deɔ ke, ‘Je mi ma tsɔ, ejakaa hiɔwe tsu;’ nɛ mɔtu mi ɔ nyɛ deɔ ke, ‘Hiɔmi maa nɛ mwɔnɛ ɔ, ejakaa hiɔwe tsu nɛ e hɛ mi ha.’ Nyɛ le hiɔwe je nihi a sisi tsɔɔmi, se nyɛ nyɛ we yi nɔ ɔmɛ a he okadi ɔmɛ a sisi nɛ nyɛɛ tsɔɔ! <verse eid="MAT 16:2-3" /><verse number="4" style="v" sid="MAT 16:4" />Yi nɔ bimɛ yayamihi kɛ gba puɛli ngɛ nyakpɛ okadi hlae nɛ a na, se a be mɛ okadi kpa ko tsɔɔe, ja Yona okadi ɔ.” Kɛkɛ nɛ Yesu si mɛ.<verse eid="MAT 16:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 16:5" />Se benɛ kaseli ɔmɛ po wo ɔ kɛ ho e se ya a, a ya yo kaa a hɛɛ we abolo.<verse eid="MAT 16:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 16:6" />Nɛ Yesu de mɛ ke, “Nyɛ hɛ nɛ hi nyɛ he nɔ ngɛ Farisi bi kɛ Saduki bi ɔmɛ a ma sasɛ ɔ he.”<verse eid="MAT 16:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 16:7" />A susu kaa e ngɛ enɛ ɔ dee akɛnɛ a hɛɛ we abolo ɔ he je.<verse eid="MAT 16:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 16:8" />Se Yesu na a juɛmi nɛ e de mɛ ke, “Nyɛ nɛ nyɛ hemi kɛ yemi pi, mɛni he je nɛ abolo nɛ nyɛ hɛɛ we ɔ ngɛ nyɛ haoe? <verse eid="MAT 16:8" /><verse number="9" style="v" sid="MAT 16:9" />Anɛ nyɛ nɛ níhi a nya kɛ sa? Nɛ nyɛ kai we nimli akpe enuɔ nɛ i ha mɛ abolo enuɔ nɛ a ye kɛ kusii abɔ nɛ nyɛ bua nya a? <verse eid="MAT 16:9" /><verse number="10" style="v" sid="MAT 16:10" />Aloo nyɛ hɛ je nimli akpe eywiɛ nɛ i ha mɛ abolo kpaago nɛ a ye kɛ kusii abɔ nɛ nyɛ bua nya a nɔ lo? <verse eid="MAT 16:10" /><verse number="11" style="v" sid="MAT 16:11" />Kɛ ji lɛ kɛɛ loko ji nyɛ nui sisi kaa tsa pi abolo he munyu nɛ i ngɛ tue ɔ? Se i ngɛ nyɛ dee ekohu ke, ‘Nyɛ hɛ nɛ hi nyɛ he nɔ ngɛ Farisi bi kɛ Saduki bi ɔmɛ a ma sasɛ ɔ he.’ ”<verse eid="MAT 16:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 16:12" />Enɛ ɔ ha nɛ a kɔ se jehanɛ ɔ kaa nɔ nɛ e ngɛ tsɔɔe kaa abolo ma sasɛ ɔ ji Farisi bi kɛ Saduki bi ɔmɛ a ni tsɔɔmi nɛ dɛ ɔ.<verse eid="MAT 16:12" /></para>
  <para style="s1">Mɛnɔ ji mi?</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 16:13" />Benɛ Yesu ba Kaisaria Filipi zugba a nɔ ɔ, e bi e kaseli ɔmɛ ke, “Mɛnɔ ni ɔmɛ deɔ ke Nɔmlɔ Bi ɔ ji?”<verse eid="MAT 16:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 16:14" />A he nɔ ke, “Nihi deɔ ke, mo ji Yohane Baptisilɔ ɔ, nɛ ni komɛ deɔ ke mo ji Elia, nɛ ni komɛ hu deɔ ke mo ji Yeremia aloo gbali ɔmɛ a ti nɔ kake.”<verse eid="MAT 16:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 16:15" />E bi mɛ jehanɛ ɔ ke, “Se nyɛɛ lɛɛ mɛnɔ nyɛ deɔ ke i ji?”<verse eid="MAT 16:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 16:16" />Kɛkɛ nɛ Simon Petro he nɔ ke, “Mo ji Kristo, Mawu hɛ kalɔ Bi ɔ.”<verse eid="MAT 16:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 16:17" />Nɛ Yesu ha lɛ heto ke, “A gbaa mo, Simon, Yona bi, ejakaa pi nɔmlɔ adesa nɛ je enɛ ɔ kɛ tsɔɔ mo, se mohu ye Tsɛ nɛ ngɛ hiɔwe ɔ nɛ je kɛ tsɔɔ mo. <verse eid="MAT 16:17" /><verse number="18" style="v" sid="MAT 16:18" />Nɛ i ngɛ mo dee ke mo ji Petro, tɛ sa, nɛ o nɔ ma fia ye asafo ɔ ngɔ ma, nɛ gbeje he wami ɔmɛ kulaa be nyɛe nɔ maa ye. <verse eid="MAT 16:18" /><verse number="19" style="v" sid="MAT 16:19" />Nɛ ma ngɔ Hiɔwe Matsɛyemi ɔ nya samfie ɔmɛ kɛ ha mo, nɛ tsu tsuaa tsu nɛ o maa ngmɛ mi ngɛ zugba nɛ ɔ nɔ ɔ, a maa ngmɛ mi ngɛ hiɔwe, nɛ tsu tsuaa tsu nɛ o ma bli nya ngɛ zugba nɛ ɔ nɔ ɔ, a ma bli nya ngɛ hiɔwe!”<verse eid="MAT 16:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 16:20" />Kɛkɛ nɛ e bɔ e kaseli ɔmɛ kɔkɔ ke a ko de nɔ ko ke lɛ ji Kristo ɔ.<verse eid="MAT 16:20" /></para>
  <para style="s1">Yesu tsi e gbenɔ kɛ e si temi nɔ ta</para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 16:21" />Kɛ je jamɛ a be ɔ mi ɔ, Yesu bɔni e kaseli ɔmɛ demi paa ke e maa ya Yerusalem nɛ e ma ya na amanehlu babauu ngɛ nikɔtɔma amɛ kɛ osɔfo nikɔtɔma amɛ kɛ mlaa tsɔɔli ɔmɛ a dɛ mi. A maa gbe lɛ, nɛ a ma tle lɛ si kɛ je gbeje kɛ ba wami mi ekohu ngɛ ligbi nɛ ji etɛ ɔ nɔ.<verse eid="MAT 16:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 16:22" />Se Petro tsɛ lɛ kɛ ba se nɛ e bɔni lɛ kɔkɔ bɔmi ke, “Nutsɔ, a hiɔ ! Enɛ ɔ e ko ba o nɔ kɔkɔɔkɔ!”<verse eid="MAT 16:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 16:23" />Yesu plɛ e hɛ nɛ e de Petro ke, “Jee ye nɔ Abosiami! O ngɛ ye nane kpatae, ejakaa o susuu we Mawu níhi a he, se mohu nimli a nihi a he o susuu.”<verse eid="MAT 16:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 16:24" />Kɛkɛ nɛ Yesu de e kaseli ɔmɛ ke, “Ke nɔ ko suɔ kaa e nyɛɛ ye se ɔ, e kua e he nɛ e wo e sɛumi tso ɔ nɛ e nyɛɛ ye se. <verse eid="MAT 16:24" /><verse number="25" style="v" sid="MAT 16:25" />Ejakaa nɔ tsuaa nɔ nɛ suɔ kaa e maa baa e klaa yi ɔ, e maa laa lɛ, se nɔ tsuaa nɔ nɛ maa laa e klaa ngɛ ye he ɔ, e nine maa su nɔ ekohu. <verse eid="MAT 16:25" /><verse number="26" style="v" sid="MAT 16:26" />Mɛni se nɛ nɔmlɔ ma na, ke e nine su je mluku ɔ tsuo nɔ, se e laa e klaa? Aloo mɛni nɔmlɔ maa ngɔ kɛ to e klaa nane mi? <verse eid="MAT 16:26" /><verse number="27" style="v" sid="MAT 16:27" />Ejakaa Nɔmlɔ Bi ɔ maa ba ngɛ e Tsɛ anunyami ɔ mi kɛ e bɔfo ɔmɛ, nɛ e maa kojo nɔ tsuaa nɔ ngɛ e ni tsumi ɔ nya. <verse eid="MAT 16:27" /><verse number="28" style="v" sid="MAT 16:28" />Nɛ i ngɛ nyɛ dee anɔkuale mi ke, nyɛ nihi nɛ daa si ngɛ hiɛ ɔ, nyɛ ti ni komɛ maa hi wami mi kɛ ya si a maa na Nɔmlɔ Bi ɔ nɛ ma ngɛ e Matsɛyemi ɔ mi.”<verse eid="MAT 16:28" /></para>
  <chapter eid="MAT 16" />
  <chapter number="17" style="c" sid="MAT 17" />
  <para style="s1">Yesu nɔmlɔ tso su tsakemi</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 17:1" />Ligbi ekpa se ɔ, Yesu ngɔ Petro kɛ Yakobo kɛ e nyɛmi Yohane nɛ e kɛ mɛ pɛ ho yoku ko nɔ ya. <verse eid="MAT 17:1" /><verse number="2" style="v" sid="MAT 17:2" />A na kaa e Nɔmlɔ tso su tsake nɛ e hɛ mi bɔni kpɛmi kaa pu. E tade ɔmɛ hiɛ futafuta kaa pu la.<verse eid="MAT 17:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 17:3" />Nɛ tlukaa a, Mose kɛ Elia ba je a he kpo nɛ a kɛɛ lɛ bɔni munyu tumi. <verse eid="MAT 17:3" /><verse number="4" style="v" sid="MAT 17:4" />Kɛkɛ nɛ Petro de Yesu ke, “Nutsɔ, e hi ha wɔ kaa waa hi hiɛ ɔ. Ke o suɔ ɔ, ma pee bo tsuhi etɛ ngɛ hiɛ ɔ, o nɔ kake kɛ Mose nɔ kake kɛ Elia nɔ kake.”<verse eid="MAT 17:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 17:5" />Benɛ e ngɛ munyu nɛ ɔ tue ɔ, bɔ kuu hleii ko ba ha a nɔ, nɛ gbi ko je bɔ kuu ɔ mi de ke, “Nɔ nɛ ɔ ji ye suɔmi Bi nɛ ye bua jɔɔ e he, nyɛɛ bu lɛ tue.”<verse eid="MAT 17:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 17:6" />Benɛ kaseli ɔmɛ nu gbi nɛ ɔ, a ye gbeye nɛ a kɛ a hɛ mi bu si. <verse eid="MAT 17:6" /><verse number="7" style="v" sid="MAT 17:7" />Yesu ba nɛ e ba ta a he nɛ e de mɛ ke, “Nyɛɛ te si, nyɛ ko ye gbeye.”<verse eid="MAT 17:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 17:8" />Se benɛ a wo a hɛ mi nɔ ɔ, a nɛ nɔ ko pe Yesu pɛ.<verse eid="MAT 17:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 17:9" />Nɛ benɛ a ngɛ yoku ɔ kplee ɔ, Yesu bɔ mɛ kɔkɔ ke a ko de nɔ ko nɔ́ nɛ a na a kɛ ya si Nɔmlɔ Bi ɔ maa te si ke je gbeje.<verse eid="MAT 17:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 17:10" />E kaseli ɔmɛ bi lɛ ke, “Mɛni he je nɛ mlaa tsɔɔli ɔmɛ deɔ ke ja Elia ba loko ji Nɔmlɔ Bi ɔ maa ba a?”<verse eid="MAT 17:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 17:11" />Nɛ Yesu he nɔ ke, “Anɔkuale munyu nɛ a ngɛ tue. Elia ma nɛ e ba to níhi kulaa a blɔ nɔ. <verse eid="MAT 17:11" /><verse number="12" style="v" sid="MAT 17:12" />Se Niinɛ, Elia ba mo nɛ a yo we lɛ, nɛ nihi fuu pee lɛ níhi nɛ sɛ. Ja a nɔuu Nɔmlɔ Bi ɔ hu maa na amanehlu ngɛ a dɛ mi.”<verse eid="MAT 17:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 17:13" />Enɛ ɔ ha nɛ e kaseli ɔmɛ kɔ se kaa Yohane Baptisilɔ ɔ he munyu nɛ e ngɛ tue ɔ nɛ.<verse eid="MAT 17:13" /></para>
  <para style="s1">Yesu tsa nyumuyo ko</para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 17:14" />Benɛ a kple yoku ɔ kɛ ba e sisi ɔ, a ba na nihi fuu nɛ ngɛ mɛ mlɛe kɛkɛ nɛ nyumu ko ba e ngɔ ba kpla si ngɛ e hɛ mi, <verse eid="MAT 17:14" /><verse number="15" style="v" sid="MAT 17:15" />nɛ e de lɛ ke, “Nutsɔ, naa ye binyumuyo ɔ mɔbɔ, ejakaa e ngɛ kɔkɔ hiɔ nue nɛ e ngɛ nɔ nae; bɔɔ kɛ bɔɔ kɛkɛ e ya nɔ la mi; nɛ bɔɔ kɛ bɔɔ hu kɛkɛ e ya nɔ nyu mi. <verse eid="MAT 17:15" /><verse number="16" style="v" sid="MAT 17:16" />I kɛ lɛ ba ha o kaseli ɔmɛ se a nyɛ we lɛ nɛ a tsa.”<verse eid="MAT 17:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 17:17" />Yesu ha heto nɛ e de ke, “Oo, yinɔ bihi nɛ a tsui ti, nɛ be hemi kɛ yemi. Mɛni be i kɛ nyɛ maa hi si kɛ ya si? Nɛ mɛni be ma to ye tsui si ha nyɛ kɛ ya ta. Nyɛɛ kɛ lɛ nɛ ba ha mi ngɛ hiɛ ɔ.” <verse eid="MAT 17:17" /><verse number="18" style="v" sid="MAT 17:18" />Kɛkɛ nɛ Yesu nga mumi yayami ɔ yi nɛ e je kpo kɛ je jokuɛ ɔ mi nɛ e na he wami jamɛ a ngmlɛfia a nɔ nɔuu.<verse eid="MAT 17:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 17:19" />Pee se ɔ, Yesu kaseli ɔmɛ ba e ngɔ nɛ a ba bi lɛ ke, “Mɛni he je nɛ wɔɔ lɛɛ wa nyɛ we nɛ waa hia jamɛ a mumi yayami ɔ kɛ je kpo ɔ?”<verse eid="MAT 17:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 17:20" />Yesu he nɔ nɛ e de mɛ ke, “Nyɛ hemi kɛ yemi nɛ pi ɔ he je i. Ejakaa ke nyɛ ngɛ hemi kɛ yemi nɛ ngɛ kaa sinapi wu nyafii ɔ, nyɛ ma de yoku nɛ ɔ ke, ‘Hiaa ngɛ hiɛ ɔ kɛ ya lejɛ ɔ,’ nɛ e maa hia; nɛ nɔ ko be nɛ nyɛ be nyɛe maa pee. <verse eid="MAT 17:20" /><verse number="21" style="v" sid="MAT 17:21" />Se kikɛmɛ a mumi yayami nɛ ɔ, a nyɛ we lɛ hiami, ja kɛ gu ngma himi kɛ sɔlemi nɔ loko ji a ma nyɛ pee.”<verse eid="MAT 17:21" /></para>
  <para style="s1">Yesu tsi e gbenɔ kɛ e si temi nɔ ta ekohu</para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 17:22" />Ligbi ko benɛ a ngɛ Galilea lolo ɔ, Yesu de mɛ ke, “A maa tsɔɔ Nɔmlɔ Bi ɔ se blɔ, nɛ a ma je lɛ kɛ wo nimli a dɛ mi. <verse eid="MAT 17:22" /><verse number="23" style="v" sid="MAT 17:23" />A maa gbe lɛ nɛ ligbi nɛ ji etɛ ɔ nɔ ɔ, a ma tle lɛ si kɛ je gbeje.” Kɛkɛ nɛ aywilɛho nu kaseli ɔmɛ.<verse eid="MAT 17:23" /></para>
  <para style="s1">Onia tsumi he sane</para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 17:24" />Benɛ a ba su Kapernaum ɔ, Sɔlemi We onia tsuli ɔmɛ ba Petro ngɔ nɛ a ba bi lɛ ke, “Anɛ nyɛ tsɔɔlɔ ɔ wui jeha onia a lo?”<verse eid="MAT 17:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 17:25" />Nɛ Petro he nɔ ke, “E woɔ.” Benɛ Petro ba we ɔ mi ɔ, Yesu sɛ hlami bi lɛ ke, “Kɛ o susu kɛɛ, Petro? Mɛnɔmɛ a dɛ zugba a nɔ matsɛmɛ heɔ lapoo ngɛ? Mɛ nitsɛmɛ a bimɛ a dɛ aloo ma setsɛmɛ nɛ a ye a nɔ a dɛ?”<verse eid="MAT 17:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 17:26" />Petro he nɔ ke, “Ngɛ ma setsɛmɛ a dɛ.” Yesu de lɛ ke, “Saminya, lɛɛ a bimɛ ɔmɛ a he jɔ mɛ mɔ. <verse eid="MAT 17:26" /><verse number="27" style="v" sid="MAT 17:27" />Se kɛ ɔ, wa be a nya doe, ja a he je ɔ, yaa wo ɔ nya nɛ o ya fɔ gbowe, nɛ kekleekle lo nɛ o ma sa a, moo pa e nya mi nɛ o maa na sika nɛ maa su i kɛ mo wa onia a nya. Mo je nɛ o kɛ ba ha mɛ.”<verse eid="MAT 17:27" /></para>
  <chapter eid="MAT 17" />
  <chapter number="18" style="c" sid="MAT 18" />
  <para style="s1">Mɛnɔ ji nɔmlɔ ngua pe kulaa?</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 18:1" />Jamɛ a be ɔ mi nɔuu ɔ, kaseli ɔmɛ ba Yesu ngɔ nɛ a ba bi lɛ nɛ e tsɔɔ mɛ a ti nɔ nɛ maa pee nɔmlɔ ngua pe kulaa ngɛ Hiɔwe Matsɛyemi ɔ mi.<verse eid="MAT 18:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="MAT 18:2" />Kɛkɛ nɛ Yesu tsɛ jokuɛ nyafii ko kɛ ba e ngɔ, nɛ e kɛ lɛ ba da a kpɛti, <verse eid="MAT 18:2" /><verse number="3" style="v" sid="MAT 18:3" />nɛ e de mɛ ke, “Anɔkuale nɛ i ngɛ nyɛ dee ɔ nɛ, ke nyɛ tsakee we nɛ nyɛ plɛ kaa jokuɛ tsɔwi ɔ, nyɛ be hiɔwe Matsɛyemi ɔ mi sɛe kɔkɔɔkɔ. <verse eid="MAT 18:3" /><verse number="4" style="v" sid="MAT 18:4" />Ja a he je ɔ, nɔ tsuaa nɔ nɛ baa e he si kaa jokuɛ nɛ ɔ, lɛ ji nɔmlɔ ngua pe kulaa ngɛ Hiɔwe Matsɛyemi ɔ mi. <verse eid="MAT 18:4" /><verse number="5" style="v" sid="MAT 18:5" />Nɛ nɔ tsuaa nɔ nɛ heɔ jokuɛ nyafii kaa nɔ nɛ ɔ atuu ngɛ ye biɛ miɔ, a mi nɛ e ngɛ hee atuu ɔ nɛ. <verse eid="MAT 18:5" /><verse number="6" style="v" sid="MAT 18:6" />Nɛ nɔ nɛ ma kpata jokuɛ tsɔwi nɛ ɔmɛ a ti nɔ kake nɛ heɔ ye nɔ yeɔ nane ɔ, afani nɛ a kɛ wɛ muɔ e kuɛ nɛ a ya sake lɛ ngɔ fɔ wo mi.<verse eid="MAT 18:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 18:7" />Kpoo ha je ɔ ngɛ nihi a nane nɛ ngɛ kpatae ɔ he. Nane kpatami kahi ngɛ mohu, se kpoo ha nɔ nɛ nane kpatami ka a maa gu e nɔ kɛ ba a. <verse eid="MAT 18:7" /><verse number="8" style="v" sid="MAT 18:8" />Lɔ ɔ he je ɔ, ke o nine loo o nane ha nɛ o peeɔ yayami ɔ, poo lɛ ngɛ o he nɛ o sake lɛ ngɔ fɔ he. Ejakaa e maa hi ha mo kaa o kɛ o nine popoe loo o nane popoe maa sɛ wami mi pe nɛ o nine ɔmɛ loo o nane ɔmɛ maa su ngɛ o he nɛ o maa ya neneene la a mi. <verse eid="MAT 18:8" /><verse number="9" style="v" sid="MAT 18:9" />Nɛ ke o hɛ ngmɛ ha nɛ o peeɔ yayami ɔ, hiaa lɛ nɛ o sake lɛ ngɔ fɔ he; afani nɛ o kɛ hɛ ngmɛ kake maa sɛ wami mi pe nɛ o hɛɛ hɛ ngmɛ enyɔ nɛ o maa ya neneene la a mi.<verse eid="MAT 18:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 18:10" />Nyɛɛ hyɛ saminya nɛ nyɛ ko gbe jokuɛ tsɔwi nɛ ɔmɛ a ti nɔ ko he guɛ; ejakaa, i ngɛ nyɛ dee ke, ngɛ hiɔwe ɔ, a bɔfohi hyɛɔ ye Tsɛ hɛ mi daa. <verse eid="MAT 18:10" /><verse number="11" style="v" sid="MAT 18:11" />Nɛ Nɔmlɔ Bi ɔ ba nɔ nɛ laa a yi wami hemi.<verse eid="MAT 18:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 18:12" />Kɛ nyɛ susu kɛɛ? Ke nɔ ko ngɛ to lafa nɛ a kpɛti kake laa a, anɛ e be to nyingmi nɛɛ kɛ nɛɛ ɔ sie ngɛ yoku ɔmɛ a nɔ nɛ e ya nɛ e ya hla kake ɔ nɛ laa a lo? <verse eid="MAT 18:12" /><verse number="13" style="v" sid="MAT 18:13" />Nɛ ke e na lɛ ɔ, i ngɛ nyɛ dee anɔkuale mi ke, e bua jɔɔ e he ngɛ to kake ɔ he pe to nyingmi nɛɛ kɛ nɛɛ ɔ nɛ laa we ɔ. <verse eid="MAT 18:13" /><verse number="14" style="v" sid="MAT 18:14" />Ja a nɔuu nɛ ye Tsɛ ngɛ hiɔwe ɔ sume kaa jokuɛwi nɛ ɔmɛ a ti nɔ kake hɛ mi kpataa.”<verse eid="MAT 18:14" /></para>
  <para style="s1">Yayami kɛ kemi</para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 18:15" />“Ke o nyɛmi ko tɔ o nɔ ɔ, yaa nɛ o kɛ lɛ nyɛ ni enyɔ ɔmɛ kɛkɛ nyɛ ya tu. Ke e bu mo tue nɛ e nu sisi kaa e tɔ ɔ, nyɛmi nɛ pee nyɛmi. <verse eid="MAT 18:15" /><verse number="16" style="v" sid="MAT 18:16" />Se ke e bui ɔ, ngɔɔ nɔ kake loo ni enyɔ kɛ piɛ o he nɛ nyɛ ya na lɛ ekohu konɛ odase yeli nɛ ɔmɛ nɛ a ya ye nɔ́ nɛ o ma de ɔ he odase. <verse eid="MAT 18:16" /><verse number="17" style="v" sid="MAT 18:17" />Nɛ ke e bui mɛ hu tue o, yaa de asafo ɔ; nɛ ke e gbo asafo ɔ hu tue ɔ, moo bu lɛ kaa wɔ jalɔ loo lapoo tsulɔ. <verse eid="MAT 18:17" /><verse number="18" style="v" sid="MAT 18:18" />Anɔkuale i ngɛ nyɛ dee ke, nɔ́ tsuaa nɔ nɛ nyɛ maa fi ngɛ zugba nɛ ɔ nɔ ɔ, a maa fi ngɛ hiɔwe; nɛ nɔ́ tsuaa nɔ nɛ nyɛ maa pine ngɛ zugba nɛ ɔ nɔ ɔ, a maa pine ngɛ hiɔwe.<verse eid="MAT 18:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 18:19" />Jehanɛ ɔ hu, i ngɛ nyɛ dee ke, ke nyɛ ti ni enyɔ pee kake ngɛ zugba nɛ ɔ nɔ kɛ bi nɔ́ ko ɔ, ye Tsɛ nɛ ngɛ hiɔwe ɔ ma ha nyɛ. <verse eid="MAT 18:19" /><verse number="20" style="v" sid="MAT 18:20" />Ejakaa he nɛ ni enyɔ loo ni etɛ bua a he nya ngɛ ngɛ ye biɛ mi ɔ, i ngɛ a kpɛti ngɛ lejɛ ɔ.”<verse eid="MAT 18:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 18:21" />Kɛkɛ nɛ Petro ba Yesu ngɔ nɛ e ba bi lɛ ke, “Nutsɔ, si enyɛmɛ ye nyɛmi ma tɔ ye nɔ nɛ i ma ngɔ kɛ ke lɛ? Si kpaago lo?”<verse eid="MAT 18:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 18:22" />Yesu he nɔ nɛ e de lɛ ke, “Dabi, tsa pi si kpaago, se mohu si kpaago totoe nyingmi kpaago.<verse eid="MAT 18:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 18:23" />Enɛ ɔ he je ɔ, Hiɔwe Matsɛyemi ɔ ngɛ kaa matsɛ ko nɛ ngɛ hlae kaa e kɛ e sɔmɔli maa bu akɔtaa. <verse eid="MAT 18:23" /><verse number="24" style="v" sid="MAT 18:24" />Nɛ benɛ e bɔni bumi ɔ, a kɛ nɔ ko nɛ hɛɛ lɛ hiɔ sidi akpe lafa ba e ngɔ. <verse eid="MAT 18:24" /><verse number="25" style="v" sid="MAT 18:25" />Se akɛnɛ e nyɛ we hiɔ ɔ nɛ e wo he je ɔ, e nutsɔ ɔ fa ke a jua lɛ kɛɛ e yo kɛ e bimɛ kɛ nɔ́ tsuaa nɔ nɛ e ngɛ ɔ nɛ a kɛ wo hiɔ ɔ.<verse eid="MAT 18:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 18:26" />Kɛkɛ nɛ sɔmɔlɔ ɔ kpla si ngɛ e nutsɔ ɔ hɛ mi nɛ e kpa lɛ pee ke, ‘Ye Nutsɔ, moo to o tsui si ha mi nɛ ma wo mo hiɔ ɔ tsuo.’<verse eid="MAT 18:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 18:27" />E nutsɔ ɔ muklii mi sa lɛ ngɛ e he nɛ e na lɛ mɔbɔ. E ngmɛɛ e he nɛ e kɛ hiɔ ɔ ke lɛ.<verse eid="MAT 18:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 18:28" />Se benɛ sɔmɔlɔ nɛ ɔ je kpo ɔ, e ya na e huɛmɛ sɔmɔli ɔmɛ a ti nɔ kake nɛ hɛɛ lɛ hiɔ sidi akpe enyɔ, nɛ e nu lɛ nɛ e mia e kuɛ si nɛ e de lɛ ke, ‘Moo wo mi hiɔ nɛ o hɛɛ mi ɔ nɔuu!’<verse eid="MAT 18:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 18:29" />Nɛ e huɛ sɔmɔlɔ ɔ kpla si kpa lɛ pɛɛ ke, ‘Mo na tsui ha mi nɛ ma wo mo hiɔ ɔ tsuo.’<verse eid="MAT 18:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="MAT 18:30" />Se lɛɛ e kplɛɛ we nɔ, nɛ e ha nɛ a wo lɛ tsu mi kɛ ya si be nɛ e maa wo lɛ hiɔ ɔ tsuo.<verse eid="MAT 18:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 18:31" />Se benɛ e huɛmɛ sɔmɔli ɔmɛ na nɔ́ nɛ e pee ɔ, e dɔ mɛ saminya nɛ a ya bɔ a nutsɔ ɔ nɔ́ nɛ ba a. <verse eid="MAT 18:31" /><verse number="32" style="v" sid="MAT 18:32" />Kɛkɛ nɛ a Nutsɔ ɔ ha a ya tsɛ lɛ kɛ ba nɛ e de lɛ ke, ‘Sɔmɔlɔ yi kpɛti walɔ! Akɛnɛ o kpa mi pɛɛ he je ɔ, i ngɔ hiɔ agbo nɛ o hɛɛ mi ɔ tsuo kɛ ke mo. <verse eid="MAT 18:32" /><verse number="33" style="v" sid="MAT 18:33" />Anɛ e sɛ kaa mo hu o naa o huɛ sɔmɔlɔ ɔ mɔbɔ kaa bɔ nɛ ami hu i na mo mɔbɔ ɔ lo?’<verse eid="MAT 18:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 18:34" />A nutsɔ ɔ muklii mi fu saminya nɛ e wo lɛ kɛ ha nɛ a ya wa lɛ yi mi nɛ a wo lɛ tsu mi kɛ ya si be nɛ e maa wo lɛ hiɔ ɔ kulaa. <verse eid="MAT 18:34" /><verse number="35" style="v" sid="MAT 18:35" />Ja a nɔuu ye Tsɛ nɛ ngɛ hiɔwe ɔ maa pee nyɛ, ke nyɛ ngɔɛ nyɛ nyɛmimɛ a tɔmi kɛ ki mɛ ke ji nyɛ tsui mi!”<verse eid="MAT 18:35" /></para>
  <chapter eid="MAT 18" />
  <chapter number="19" style="c" sid="MAT 19" />
  <para style="p">
    <verse number="1" style="v" sid="MAT 19:1" />Benɛ Yesu gbe munyu nɛ ɔ tumi nya a, e si Galilea nɛ e lɔgɔ Yordan Pa a kɛ ba je Yudea. <verse eid="MAT 19:1" /><verse number="2" style="v" sid="MAT 19:2" />Asafo babauu nyɛɛ e se, nɛ e tsa hiɔtsɛ ɔmɛ ngɛ lejɛ ɔ.<verse eid="MAT 19:2" /></para>
  <para style="s1">Yesu nya tsɔmi</para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 19:3" />Nɛ Farisi bi komɛ ba e ngɔ ba ka lɛ hyɛ ha kaa e ma de nɔ ko nɛ a ma nyɛ da nɔ kɛ kpata e hɛ mi lo. A bi lɛ ke, “Anɛ e da blɔ kaa nyumu fieɔ e yo lo?”<verse eid="MAT 19:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 19:4" />Yesu he nɔ nɛ e bi mɛ ke, “Anɛ nyɛ kane we Ngmami Klɔuklɔu ɔ lo? A ngma ngɛ mi ke, ngɛ sisije ɔ mi ɔ, Mawu bɔ nyumu kɛ yo. <verse eid="MAT 19:4" /><verse number="5" style="v" sid="MAT 19:5" />Nɛ e de ke, nyumu ma si e tsɛ kɛ e nyɛ nɛ e maa pɛtɛ e yo he, nɛ mɛ ni enyɔ ɔmɛ a ma plɛ he lo kake. <verse eid="MAT 19:5" /><verse number="6" style="v" sid="MAT 19:6" />A pi nimli enyɔ hu, se mohu kake. Nɛ nɔ́ nɛ Mawu tsa a, nɔ ko nɛ ko gba mi.”<verse eid="MAT 19:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 19:7" />A bi lɛ ekohu ke, “Mɛni he je mɔ nɛ Mose wo mlaa ke ke nɔ ko ma kua e yo ɔ, e ha lɛ fiemi womi kɛkɛ e ma nyɛ ngmɛɛ e he ɔ?”<verse eid="MAT 19:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 19:8" />Yesu ha mɛ heto ke, “Nyɛ tsui wami he je nɛ Mose ha nyɛ jamɛ a he blɔ kaa nyɛɛ fie nyɛ yi ɔmɛ ngɛ, se tsa pi ja a nɛ Mawu to kɛ je sisije ɔ. <verse eid="MAT 19:8" /><verse number="9" style="v" sid="MAT 19:9" />Enɛ ɔ he je ɔ, i ngɛ nyɛ dee ke, nyumu tsuaa nyumu, nɛ pi ajuama bɔmi he je nɛ e ma kua e yo ngɛ nɛ e ma ya ngɔ yo kpa a, e bɔ ajuama; nɛ nyumu tsuaa nyumu nɛ ngɔɔ yo nɛ a kua lɛ ɔ, lɛ hu e bɔ ajuama.”<verse eid="MAT 19:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 19:10" />Yesu kaseli ɔmɛ de lɛ ke, “Ke kikɛ ɔ ji munyu ɔ, lɛɛ e sɛ kaa a ngɔɔ yo mɔ.”<verse eid="MAT 19:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 19:11" />Yesu he nɔ nɛ e de ke, “Tsa pi nɔ tsuaa nɔ nɛ ma nyɛ tsɔɔmi nɛ ɔ he maa pɛtɛ, ja nihi nɛ Mawu ye kɛ bua mɛ ɔ kɛkɛ. <verse eid="MAT 19:11" /><verse number="12" style="v" sid="MAT 19:12" />Ejakaa ni komɛ ngɛ nɛ, ngɛ a bɔmi su nya a, a be yo nyɛe maa ngɔ; nɛ ni komɛ hu ngɛ nɛ nimli nɛ pee mɛ ja. Nɛ nihi hu ngɛ nɛ Hiɔwe Matsɛyemi ɔ he je nɛ a ngɔɛ yo ngɛ. Nɔ fɛɛ nɔ nɛ ma nyɛ ɔ, e ngɔ ye munyu ɔ.”<verse eid="MAT 19:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 19:13" />Nɛ a kɛ jokuɛwi ba Yesu ngɔ konɛ e ngɔ nine ngɔ pue a nɔ nɛ e sɔle ha mɛ. Se e kaseli ɔmɛ gbɛ wo nihi nɛ wo mɛ kɛ ba a ke, “Nyɛ ko de nɔ́ ha lɛ!”<verse eid="MAT 19:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 19:14" />Se Yesu de mɛ ke, “Nyɛ ha nɛ jokuɛwi ɔmɛ nɛ a ba ye ngɔ, nɛ nyɛ ko tsi mɛ blɔ, ejakaa nihi nɛ ngɛ kaa ni nɛ ɔmɛ ɔ, a nɔ́ ji Hiɔwe Matsɛyemi ɔ nɛ.” <verse eid="MAT 19:14" /><verse number="15" style="v" sid="MAT 19:15" />Kɛkɛ nɛ e ngɔ e nine ngɔ pue a nɔ nɛ e jɔɔ mɛ loko ji e je lejɛ ɔ.<verse eid="MAT 19:15" /></para>
  <para style="s1">Niatsɛ ɔ kpale</para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 19:16" />Nɛ nyumu ko ba Yesu ngɔ ba bi lɛ ke, “Tsɔɔlɔ kpakpa, mɛni nɔ́ ma pee nɛ ma na neneene wami?”<verse eid="MAT 19:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 19:17" />Yesu de lɛ ke, “Nɛ o tsɛ mi Nɔmlɔ kpakpa a, o ngɛ tsɔɔe kaa Mawu ji mi, ejakaa Mawu pɛ ji nɔ kpakpa. Ke o ngɛ hlae nɛ o sɛ wami mi ɔ, moo ye kita amɛ a nɔ.”<verse eid="MAT 19:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 19:18" />Nyumu ɔ bi lɛ ke, “Kita amɛ te nɔ́ nɛmɛ nɛɛ?” Yesu he nɔ de lɛ ke, “Koo gbe nɔmlɔ, ko puɛ gba, koo ju, koo ye lakpa odase, <verse eid="MAT 19:18" /><verse number="19" style="v" sid="MAT 19:19" />moo bu o tsɛ kɛ o nyɛ nɛ o suɔ o nyɛmi nɔmlɔ kaa bɔ nɛ o suɔ mo nitsɛ o he ɔ!”<verse eid="MAT 19:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 19:20" />Nɛ niheyo ɔ de lɛ ke, “I ye enɛ ɔmɛ tsuo a nɔ. Mɛni pa piɛ mi?”<verse eid="MAT 19:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 19:21" />Yesu de lɛ ke, “Ke o ngɛ hlae nɛ o hi kɛ pi si ɔ, yaa nɛ o ya jua nɔ́ tsuaa nɔ nɛ o ngɛ ɔ, nɛ o ngɔ sika a kɛ ha ohiafohi nɛ o ma na weto ni ngɛ hiɔwe konɛ o ba nɛ o ba nyɛɛ ye se.” <verse eid="MAT 19:21" /><verse number="22" style="v" sid="MAT 19:22" />Se benɛ niheyo ɔ nu munyu nɛ ɔ, e ni pee mɔbɔ nɛ e si lejɛ ɔ, ejakaa e ngɛ níhi babauu.<verse eid="MAT 19:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 19:23" />Nɛ Yesu de e kaseli ɔmɛ ke, “Anɔkuale, i ngɛ nyɛ dee ke, e he wa ha niatsɛ kaa e maa sɛ Hiɔwe Matsɛyemi ɔ mi. <verse eid="MAT 19:23" /><verse number="24" style="v" sid="MAT 19:24" />I ngɛ nyɛ dee ekohu ke, e wɛ ha afukpɔngɔ kaa e maa gu abui puɔ mi kaa bɔ nɛ e wa ha niatsɛ kaa e maa sɛ hiɔwe Matsɛyemi ɔ mi ɔ.”<verse eid="MAT 19:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 19:25" />Benɛ e kaseli ɔmɛ nu munyu nɛ ɔ, e pee mɛ yaa nɛ a bi lɛ ke, “Lɛɛ mɛnɔ kulaa yi wami a ma he mɔ?”<verse eid="MAT 19:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 19:26" />Yesu hyɛ mɛ dii nɛ e de mɛ ke, “Ngɛ nɔmlɔ blɔ fa mi ɔ, a be enɛ ɔ nyɛe maa pee, se ngɛ Mawu blɔ fa mi ɔ, a ma nyɛ nɔ́ tsuaa nɔ maa pee.”<verse eid="MAT 19:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 19:27" />Kɛkɛ nɛ Petro bi lɛ ke, “Wɔɔ lɛɛ wa si nɔ́ fɛɛ nɔ nɛ wa ba ngɛ o se nyɛɛe, mɛni se wa ma na mɔ?”<verse eid="MAT 19:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 19:28" />Yesu he nɔ nɛ e de lɛ ke, “Anɔkuale nɛ i ngɛ nyɛ dee ke, benɛ Nɔmlɔ Bi ɔ ma ya hi e anunyami sɛ ɔ nɔ ngɛ Hiɔwe Matsɛyemi ɔ mi ɔ, nyɛ e se nyɛɛli ɔmɛ hu nyɛ maa hi sɛ nyɔngma kɛ enyɔ nɔ, nɛ nyɛ maa kojo Israel wɛtso nyɔngma kɛ enyɔ ɔmɛ. <verse eid="MAT 19:28" /><verse number="29" style="v" sid="MAT 19:29" />Nɛ nɔ tsuaa nɔ nɛ si e we loo nyɛmimɛ nyumuhi loo nyɛmimɛ yihi loo tsɛ loo nyɛ loo e yo loo bimɛ loo weto ni ngɛ ye he ɔ, a maa ma nane mi ha lɛ ngwɔhe lafa, nɛ e ma na neneene wami. <verse eid="MAT 19:29" /><verse number="30" style="v" sid="MAT 19:30" />Nɛ nihi nɛ mɛ ji kekle bimɛ po ɔ, a maa pee se kpɛli, nɛ sekpɛ bi ɔmɛ ma plɛ kekle bimɛ.”<verse eid="MAT 19:30" /></para>
  <chapter eid="MAT 19" />
  <chapter number="20" style="c" sid="MAT 20" />
  <para style="s1">Apaa yeli ɔmɛ a he abɛ ɔ</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 20:1" />“Hiɔwe Matsɛyemi ɔ ngɛ kaa wetsɛ ko nɛ je kpo makɛ mla nɛ e ho ya bɔ ni tsuli apaa nɛ a ya tsu ni ha lɛ ngɛ e wai ngmɔ mi. <verse eid="MAT 20:1" /><verse number="2" style="v" sid="MAT 20:2" />Nɛ bɔ nɛ e kɛ apaa yeli ɔmɛ ye ni tsumi ɔ nya nɛ a kplɛɛ nɔ ji sidi akpe enyɔ ligbi kake; kɛkɛ nɛ e wo mɛ blɔ kɛ ho e wai ngmɔ ɔ mi ya.<verse eid="MAT 20:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 20:3" />Maa pee mɔtu ngmlɛ nɛɛ mi ɔ, e je kpo ekohu nɛ e ya na ni kpahi nɛ a daa si yaka gu ngɛ jua a nɔ; <verse eid="MAT 20:3" /><verse number="4" style="v" sid="MAT 20:4" />nɛ e de mɛ ke a ya nɛ a ya tsu ni ngɛ e wai ngmɔ ɔ mi nɛ e maa wo mɛ hiɔ bɔ nɛ sa; nɛ a ho. <verse eid="MAT 20:4" /><verse number="5" style="v" sid="MAT 20:5" />Jehanɛ ɔ kɛ ma piani ngmlɛ nyɔngma kɛ enyɔ kɛ ngmlɛ etɛ mi ɔ, e je kpo ekohu nɛ e ya pee ja a nɔuu.<verse eid="MAT 20:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 20:6" />Maa pee gbɔkuɛ ngmlɛ enuɔ mi ɔ, e je kpo ekohu nɛ e ya na ni kpahi hu nɛ a daa si yaka gu, nɛ e bi mɛ ke, ‘Mɛni he je nɛ nyɛ tsu we nɔ́ ko mwɔnɛ ɔ?’<verse eid="MAT 20:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 20:7" />Nɛ a de lɛ ke, ‘Ejakaa nɔ ko ba bɔɛ wɔ apaa.’ Nɛ e de mɛ ke, ‘Ke ja a, lɛɛ nyɛ hu nyɛ ba ho ye wai ngmɔ ɔ mi ya.’<verse eid="MAT 20:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 20:8" />Benɛ e su gbɔkuɛ ɔ, wai ngmɔtsɛ ɔ de e hiɔ wolɔ ɔ ke e ya wo ni tsuli ɔmɛ hiɔ; e wo kɛ je sekpɛtsɛ ɔmɛ a nɔ kɛ ya su kekletsɛ ɔmɛ a nɔ. <verse eid="MAT 20:8" /><verse number="9" style="v" sid="MAT 20:9" />Nɛ benɛ gbɔkuɛ ngmɛ enuɔtsɛ ɔmɛ ba a, a ti nɔ tsuaa nɔ na sidi akpe enyɔ. <verse eid="MAT 20:9" /><verse number="10" style="v" sid="MAT 20:10" />Benɛ e su kekle bi ɔmɛ a nɔ ɔ, a susu kaa a hiɔwo ɔ maa hiɛ pe sekpɛ bi ɔmɛ a nɔ́ ɔ, se mɛ hu a na ja a nɔuu.<verse eid="MAT 20:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 20:11" />Benɛ a nine su a hiɔwo ɔ nɔ ɔ, a tu munyu kɛ si ngmɔtsɛ ɔ, <verse eid="MAT 20:11" /><verse number="12" style="v" sid="MAT 20:12" />nɛ a de ke, ‘Sekpɛtsɛ nɛ ɔmɛ ɔ, ngmlɛfia kake kɛkɛ nɛ a tsu ni ɔ nɛ o ha waa kɛ mɛ hiɔwo kake, wɔ nihi nɛ wa tsu ni kɛ je mɔtu nɛ pɔ tɔ wɔ nɛ latsa tsa wɔ ɔ.’<verse eid="MAT 20:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 20:13" />Ngmɔtsɛ ɔ he nɔ nɛ e de a ti nɔ kake ke, ‘Ye huɛ, i pee we mo yayami ko! Anɛ tsa pi sidi akpe enyɔ nɛ i kɛ mo ye nya a lo? <verse eid="MAT 20:13" /><verse number="14" style="v" sid="MAT 20:14" />Mo he o hiɔwo ɔ nɛ o ho! Ye suɔmi nya ni ji kaa ma ha sekpɛtsɛ ɔmɛ kaa bɔ nɛ i ha nyɛ ɔ kɛ. <verse eid="MAT 20:14" /><verse number="15" style="v" sid="MAT 20:15" />Anɛ i be he blɔ kaa i peeɔ nɔ́ nɛ i suɔ kɛ ami nitsɛ ye sika lo? Mɛni he je nɛ e sa kaa o na abofu ngɛ ye mi mi jɔmi ɔ he?’ <verse eid="MAT 20:15" /><verse number="16" style="v" sid="MAT 20:16" />Ja a nɔuu e maa ba mi kaa sekpɛ bi ma plɛ kekle bi, nɛ kekle bi ma plɛ sekpɛ bi.”<verse eid="MAT 20:16" /></para>
  <para style="s1">Yesu tu e gbenɔ he munyu ekohu</para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 20:17" />Benɛ Yesu yaa Yerusalem ɔ, e tsɛ e kaseli nyɔngma kɛ enyɔ ɔmɛ kɛ ya se nɛ e de mɛ ke, <verse eid="MAT 20:17" /><verse number="18" style="v" sid="MAT 20:18" />“Nyɛɛ hyɛ, wa yaa Yerusalem nɛ a ma je Nɔmlɔ Bi ɔ he gbi kɛ ha osɔfo nikɔtɔma amɛ kɛ mlaa tsɔɔli ɔmɛ nɛ a maa bu lɛ gbenɔ fɔ. <verse eid="MAT 20:18" /><verse number="19" style="v" sid="MAT 20:19" />A maa ngɔ lɛ kɛ ha ma je li ɔmɛ nɛ a maa ye e he fɛu, nɛ a maa fiaa lɛ kpa. Nyagbe ɔ a maa sɛu lɛ, nɛ ligbi nɛ ji etɛ ɔ nɔ ɔ, a ma tle lɛ si ekohu.”<verse eid="MAT 20:19" /></para>
  <para style="s1">Zebedeo bi ɔmɛ a nyɛ ya na Yesu</para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 20:20" />Kɛkɛ nɛ Zebedeo bimɛ ɔmɛ a nyɛ ɔ ngɔ e bimɛ nyumu ɔmɛ,Yakobo kɛ Yohane kɛ ba Yesu ngɔ nɛ a ba kpla si, nɛ e ba lɛ nɔ́ ko.<verse eid="MAT 20:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 20:21" />Yesu bi lɛ ke, “Mɛni o ngɛ hlae?” Nɛ e ha heto ke, “Mo ha nɛ ye bimɛ enyɔ nɛ ɔmɛ a ti nɔ kake nɛ hi o hiɔ nɔ, nɛ nɔ kake hu nɛ hi o muɔ nɔ ngɛ o Matsɛyemi ɔ mi.”<verse eid="MAT 20:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 20:22" />Se Yesu he nɔ nɛ e de lɛ ke, “O li nɔ́ nɛ o ngɛ bie ɔ.” Nɛ e bi Yakobo kɛ Yohane ke, “Anɛ nyɛ ma nyɛ maa nu tsimi nya nyu nɛ i yaa nu ɔ lo?” A he nɔ ke, “Ee, wa ma nyɛ!”<verse eid="MAT 20:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 20:23" />Nɛ Yesu de mɛ ke, “Nyɛ ma nyɛ maa nu ye tsimi ɔ nya nyu niinɛ, se ye hiɔ nɔ kɛ ye muɔ nɔ himi ɔ lɛɛ tsa pi ye nɔ i nɛ i kɛ haa. Hihe nɛ ɔmɛ ɔ, a to kɛ ha nihi nɛ ye Tsɛ hla momo ɔ.”<verse eid="MAT 20:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 20:24" />Benɛ ni nyɔngma amɛ nu enɛ ɔ, a muklii mi fu Yakobo kɛ Yohane.<verse eid="MAT 20:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 20:25" />Se Yesu tsɛ mɛ kɛ ba e ngɔ nɛ e de mɛ ke, “Nyɛ le kaa ngɛ ma je li ɔmɛ a blɔ fa mi ɔ, matsɛ ɔmɛ yeɔ a nɔ, nɛ a kpɛti nimli ngua amɛ hu ngɛ nihi ngɛ a sisi nɛ a ngɛ he wami ngɛ a nɔ. <verse eid="MAT 20:25" /><verse number="26" style="v" sid="MAT 20:26" />Se nyɛɛ lɛɛ e be ja ngɛ nyɛ kpɛti. Nyɛ ti nɔ tsuaa nɔ nɛ suɔ kaa e pee nɔmlɔ ngua ngɛ nyɛ kpɛti ɔ, lɛ mohu e pee nyɛ sɔmɔlɔ. <verse eid="MAT 20:26" /><verse number="27" style="v" sid="MAT 20:27" />Nɛ nɔ tsuaa nɔ nɛ suɔ kaa e pee nɔkɔtɔma ngɛ nyɛ kpɛti ɔ, e pee nyɛ tsɔlɔ; <verse eid="MAT 20:27" /><verse number="28" style="v" sid="MAT 20:28" />kaa bɔ nɛ Nɔmlɔ Bi ɔ bɛ nɛ a sɔmɔ lɛ, se e ba sɔmɔmi mohu, nɛ e ngɔ e wami ngɔ pee kpɔmi nɔ́ kɛ ha nihi fuu ɔ.”<verse eid="MAT 20:28" /></para>
  <para style="s1">Yesu tsa he yuyuili enyɔ komɛ</para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 20:29" />E ba mi kaa benɛ Yesu kɛ e kaseli ɔmɛ je Yeriko kɛ yaa a, nimli babauu nyɛɛ a se.<verse eid="MAT 20:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="MAT 20:30" />Nɛ nyumuhi hɛ yuyuili enyɔ hii si ngɛ blɔ ɔ he, nɛ benɛ a nu kaa Yesu bee ɔ, a bɔni ngmlaa kpami ke, “Moo na wɔ mɔbɔ, Nutsɔ, David Bi.”<verse eid="MAT 20:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 20:31" />Asafo ɔ ke a yi ke a pee dii, se a bɔni ngmlaa a kpami wawɛɛ pe kekle ɔ ke, “Moo na wɔ mɔbɔ, Nutsɔ, David Bi!”<verse eid="MAT 20:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 20:32" />Benɛ Yesu ba su he nɛ a ngɛ ɔ, e da si nɛ e tsɛ mɛ nɛ e bi mɛ ke, “Mɛni nyɛ ngɛ hlae nɛ ma pee ha nyɛ?” <verse eid="MAT 20:32" /><verse number="33" style="v" sid="MAT 20:33" />Nɛ a de lɛ ke, “Nutsɔ, wa ngɛ hlae nɛ waa hyɛ ní!”<verse eid="MAT 20:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 20:34" />Yesu muklii mi sa lɛ ngɛ a he nɛ e ta a hɛ ngmɛ ɔmɛ a he, nɛ amlɔ ɔ nɔuu ɔ, a bɔni nɔ́ hyɛmi nɛ a nyɛɛ e se.<verse eid="MAT 20:34" /></para>
  <chapter eid="MAT 20" />
  <chapter number="21" style="c" sid="MAT 21" />
  <para style="s1">Yesu Yerusalem yami</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 21:1" />Benɛ e piɛ bɔɔ nɛ Yesu kɛ e kaseli ɔmɛ maa su Yerusalem ngɛ Betfage kɔpe ko nɛ ngɛ Nuyoku ɔ he ɔ, e tsɔ e kaseli ɔmɛ a ti ni enyɔ kɛ se hlami.<verse eid="MAT 21:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="MAT 21:2" />Nɛ e de mɛ ke, “Ke nyɛ sɛ kɔpe ɔ mi nɔuu ɔ, nyɛ maa na teji ko nɛ a muɔ lɛ si kɛ e bi. Nyɛɛ pine mɛ kɛ ba ha mi ngɛ hiɛ ɔ. <verse eid="MAT 21:2" /><verse number="3" style="v" sid="MAT 21:3" />Nɛ ke nɔ ko bi nyɛ sane ko ɔ, nyɛ de lɛ ke, ‘A he ngɛ Nutsɔ ɔ hiae,’ nɛ sane ko be bae.”<verse eid="MAT 21:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 21:4" />Enɛ ɔ ba mi kaa bɔ nɛ gbalɔ ɔ de ɔ ke, <verse eid="MAT 21:4" /><verse number="5" style="v" sid="MAT 21:5" />“Nyɛ de Zion biyo ɔ ke, o nɛ, o Matsɛ ɔ ma o ngɔ. E he jɔ nɛ e hi teji bi nɔ.”<verse eid="MAT 21:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 21:6" />Nɛ kaseli enyɔ ɔmɛ ho nɛ a ya pee bɔ nɛ Yesu de mɛ ɔ; <verse eid="MAT 21:6" /><verse number="7" style="v" sid="MAT 21:7" />nɛ a kɛ teji ɔ kɛ e bi ɔ ba nɛ a ngɔ a tade ɔmɛ kɛ pue e nɔ nɛ Yesu kuɔ hi nɔ. <verse eid="MAT 21:7" /><verse number="8" style="v" sid="MAT 21:8" />Nɛ nihi fuu ngmɛ a tadehi ngɛ blɔ ɔ nɔ, nɛ a ti ni komɛ hu kplɔ bahi ngɔ pue blɔ ɔ nɔ kɛ nyɛɛ e hɛ mi.<verse eid="MAT 21:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 21:9" />Nɛ nihi nɛ sɛ e hlami kɛ nihi nɛ nyɛɛ e se ɔ tsuo ngɛ ngmlaa kpae ke, “Mawu nɛ gbaa Matsɛ David Bi ɔ! A gbaa nɔ nɛ ma ngɛ Nutsɔ ɔ biɛ mi ɔ! Yi jemi ha Mawu ngɛ Hiɔwe lokoo!”<verse eid="MAT 21:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 21:10" />Benɛ e sɛ Yerusalem ɔ, ma a tsuo bu hoo nɛ a ngɛ bie ke, “Mɛnɔ ji nɛ ɔ?”<verse eid="MAT 21:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 21:11" />Kɛkɛ nɛ asafo ɔ ha heto ke, “Nɔ nɛ ɔ ji Yesu, Gbalɔ nɛ je Nazaret ngɛ Galilea a!” <verse eid="MAT 21:11" /><verse number="12" style="v" sid="MAT 21:12" />Yesu ya sɛ Sɔlemi We ɔ, nɛ e ya fie jua yeli kɛ nihi nɛ ngɛ ni hee ngɛ Sɔlemi We ɔ, nɛ e kpa sika tsakeli ɔmɛ a gba amɛ kɛ bu si.<verse eid="MAT 21:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 21:13" />Nɛ e de mɛ ke, “A ngma ke, ‘A ma tsɛ ye we ɔ Sɔlemi We’, se nyɛɛ lɛɛ nyɛ kɛ pee ojo fiali a hi he.”<verse eid="MAT 21:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 21:14" />Nɛ nihi nɛ a hɛ ngmɛ yu kɛ nihi nɛ a kplɔ ɔ ba e ngɔ ngɛ Sɔlemi We ɔ, nɛ e tsa mɛ. <verse eid="MAT 21:14" /><verse number="15" style="v" sid="MAT 21:15" />Se benɛ osɔfo nikɔtɔma amɛ kɛ mlaa tsɔɔli ɔmɛ na nyakpɛ ni ɔmɛ nɛ e tsu, kɛ bɔ nɛ jokuɛwi ɔmɛ ngɛ ngmlaa kpae ngɛ Sɔlemi We ɔ ke, “Mawu nɛ gbaa David Bi ɔ,” a mi mi fu nɛ a bi lɛ ke, “Anɛ o ngɛ nɔ́ nɛ bimwɔwi nɛ ɔmɛ ngɛ dee ɔ nue lo?”<verse eid="MAT 21:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 21:16" />Yesu he nɔ ke, “Ee! Anɛ nyɛ kane we Ngmami ɔ hyɛ lo? Ejakaa Ngmami ɔ de ke, ‘Bimwɔwi tete ma je e yi!’ ”<verse eid="MAT 21:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 21:17" />Kɛkɛ nɛ e si mɛ nɛ e je ma a mi kɛ ho Betania ya nɛ e ya hwɔ lejɛ ɔ.<verse eid="MAT 21:17" /></para>
  <para style="s1">Yesu gbiɛ tso ɔ</para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 21:18" />E nɔ jena mɔtu benɛ e kpale e se kɛ yaa Yerusalem ɔ , hwɔ bɔni lɛ yemi, <verse eid="MAT 21:18" /><verse number="19" style="v" sid="MAT 21:19" />nɛ e na tso ko nɛ ngɛ kaa mangoo tso ɔ ngɛ blɔ ɔ he nɛ e gba lejɛ ɔ. Se e ya nɛ yiblii ko ngɛ nɔ pe bahi sɔuu. Kɛkɛ nɛ e de tso ɔ ke, “Kɛ je be nɛ ɔ kɛ yaa a, o be yiblii ko woe gbleegbleegblee hu!” Nɛ tso ɔ ngla amlɔ ɔ nɔuu.<verse eid="MAT 21:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 21:20" />Benɛ e kaseli ɔmɛ na enɛ ɔ, a nya kpɛ a he nɛ a bi ke, “Kɛ pee kɛɛ nɛ tso ɔ ngla amlɔ kikɛ ɔ?”<verse eid="MAT 21:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 21:21" />Yesu he nɔ nɛ e de mɛ ke, “Anɔkuale, ke nyɛ ngɛ hemi kɛ yemi nɛ nyɛ ji nguane ɔ, nyɛ ma nyɛ pee níhi kaa kikɛ ɔ kɛ níhi nɛ pe enɛ ɔ. Nyɛ ma nyɛ de Nuyoku nɛ ɔ tete ke, ‘Hiaa nɛ o ya nɔ wo mi’, nɛ e maa hia. <verse eid="MAT 21:21" /><verse number="22" style="v" sid="MAT 21:22" />Nɛ nɔ́ tsuaa nɔ nɛ nyɛ maa sɔle nɛ nyɛ ma kpa he pɛɛ ɔ, nyɛ nine maa su nɔ ke nyɛ he ye.”<verse eid="MAT 21:22" /></para>
  <para style="s1">Yuda nikɔtɔma amɛ tsɔ lɛ klama</para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 21:23" />Benɛ Yesu kpale kɛ ho Sɔlemi We ɔ ya nɛ e ya ngɛ ni tsɔɔe ɔ, osɔfo nikɔtɔma amɛ kɛ ma a mi nikɔtɔma amɛ ba e ngɔ nɛ a ba bi lɛ ke, “Mɛni he blɔ nɛ o ngɛ nɛ o peeɔ kikɛmɛ a ni nɛ ɔmɛ, nɛ mɛnɔ ha mo he blɔ nɛ ɔ?”<verse eid="MAT 21:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 21:24" />Yesu he nɔ nɛ e de mɛ ke, “Ami hu ma bi nyɛ munyu ko, nɛ ke nyɛ ha mi heto ɔ, loko ji ami hu ma tsɔɔ nyɛ he blɔ nɛ i ngɛ he je nɛ i peeɔ kikɛmɛ a ni nɛ ɔmɛ. <verse eid="MAT 21:24" /><verse number="25" style="v" sid="MAT 21:25" />Yohane Baptisilɔ ɔ, jije e je? Mawu ngɔ e je aloo nimli a kpɛti e je?” A susu he ngɛ a kpɛti nɛ a bi a he ke, “Ke wa de ke e je Mawu ngɔ ɔ, e ma bi wɔ ke, lɛɛ mɛni he je wa he we Yohane yi mɔ? <verse eid="MAT 21:25" /><verse number="26" style="v" sid="MAT 21:26" />Nɛ ke wa ke e je nimli a kpɛti ɔ, lɔ ɔ hu asafo ɔ maa pee wɔ basabasa, ejakaa nihi fuu buu Yohane gbalɔ.” <verse eid="MAT 21:26" /><verse number="27" style="v" sid="MAT 21:27" />Kɛkɛ nɛ a ha Yesu heto ke, “Wa li!” Nɛ Yesu hu de mɛ ke, “Lɛɛ ami hu i be nyɛ nyɛ sane ɔ heto hae.<verse eid="MAT 21:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 21:28" />Se jehanɛ ɔ, kɛ nyɛ susu enɛ ɔ he kɛɛ? Nyumu ko ngɛ bimɛ nyumuwi enyɔ, nɛ e ya nɔkɔtɔma a ngɔ nɛ e ya de lɛ ke, ‘Ye bi, yaa tsu ni mwɔnɛ ɔ ha mi ngɛ ye ngmɔ ɔ mi.’ <verse eid="MAT 21:28" /><verse number="29" style="v" sid="MAT 21:29" />Nɛ e he nɔ ke, ‘I be yae.’ Se pee se ɔ, e tsake e juɛmi nɛ e ya. <verse eid="MAT 21:29" /><verse number="30" style="v" sid="MAT 21:30" />Nɛ tsɛ ɔ ya jokuɛ ɔ hu ngɔ, nɛ e de lɛ ja a nɔuu. Se lɛɛ e he nɔ ke, ‘Yoo, ye tsɛ, i ma ya.’ Se e yɛ. <verse eid="MAT 21:30" /><verse number="31" style="v" sid="MAT 21:31" />Bimɛ enyɔ nɛ ɔmɛ a kpɛti mɛnɔ nɛ pee a tsɛ ɔ suɔmi nya ni?” A ha heto ke, “Nɔkɔtɔma a i.” Nɛ Yesu de mɛ ke, “Anɔkuale, i ngɛ nyɛ dee ke, nimli yayamihi kɛ ajuama bɔli maa sɛ nyɛ hlami kɛ ya Hiɔwe Matsɛyemi ɔ mi. <verse eid="MAT 21:31" /><verse number="32" style="v" sid="MAT 21:32" />Ejakaa Yohane Baptisilɔ ɔ ba nyɛ ngɔ ngɛ dami blɔ nɔ konɛ nyɛ tsake nyɛ tsui nɛ nyɛɛ ngɔ nyɛ he kɛ ha Mawu se nyɛ he we lɛ yi, se jua tsuli ɔmɛ kɛ ajuama bɔli ɔmɛ he lɛ ye. Nɛ benɛ nyɛ na le hu ɔ, nyɛ tsakee we nyɛ tsui, lɔ ɔ he je ɔ nyɛ he we lɛ nɛ nyɛɛ ye.” <verse eid="MAT 21:32" /><verse number="33" style="v" sid="MAT 21:33" />Jehanɛ ɔ Yesu de mɛ ke, “Nyɛɛ bu abɛ kpa ko hu tue. Be ko ɔ, zugbatsɛ ko pee wai ngmɔ nɛ e po abɔɔ godoo kɛ wo he. E tsua muɔ ngɛ mi, nɛ e ma tsu ngɛ mi, nɛ e kɛ ha ni tsuli kaa a tsu he ni nɛ e kɛ mɛ nɛ gba, kɛkɛ nɛ e hia blɔ kɛ ho ma kpa nɔ ya.<verse eid="MAT 21:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 21:34" />Benɛ ni kpami be ɔ su ɔ, e tsɔ e tsɔli kɛ ya ngmɔ huli ɔmɛ a ngɔ konɛ a ya ngɔ e blɔ fa mi yiblii nɛ ji ni nɛ a kpa a kɛ ba ha lɛ. <verse eid="MAT 21:34" /><verse number="35" style="v" sid="MAT 21:35" />Se huli ɔmɛ nu e tsɔli ɔmɛ, nɛ a fiaa nɔ kake kpa, nɛ a gbe nɔ kake, nɛ a fiaa nɔ kake hu tɛ.<verse eid="MAT 21:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="MAT 21:36" />Jehanɛ ɔ, e tsɔ tsɔli kpahi nɛ hiɛ pe kekle bi ɔmɛ, se a pee mɛ hu ja a nɔuu. <verse eid="MAT 21:36" /><verse number="37" style="v" sid="MAT 21:37" />Enɛ ɔ tsuo se ɔ, e tsɔ e bi kɛ ya a ngɔ kaa lɛɛ a ma gbo lɛ zo lo.<verse eid="MAT 21:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="MAT 21:38" />Se benɛ huli ɔmɛ na e bi ɔ mohu ɔ, nɔ́ nɛ a de ji, ‘Ni yelɔ ɔ nɛ ma a nɛ, nyɛɛ ba nɛ waa gbe lɛ konɛ e ni ɔ nɛ pee wa nɔ́.’ <verse eid="MAT 21:38" /><verse number="39" style="v" sid="MAT 21:39" />Nɛ a nu lɛ nɛ a tsitsiɛ e kuɛ se mi kɛ je kpo ngɛ ngmɔ ɔ mi nɛ a ya gbe lɛ.<verse eid="MAT 21:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="MAT 21:40" />Jehanɛ ɔ ke ngmɔtsɛ ɔ ba a, mɛni nyɛ susu kaa e maa pee huli nɛ ɔmɛ?”<verse eid="MAT 21:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="MAT 21:41" />Yuda nikɔtɔma amɛ de lɛ ke, “E ma kpata kikɛmɛ a nimli yayami nɛ ɔmɛ a hɛ mi butuu, nɛ e maa ngɔ e wai ngmɔ ɔ kɛ ha huli kpahi nɛ ma ha lɛ ni nɛ a kpa a e blɔ fa mi nɔ́ ngɛ be nɛ sa mi.”<verse eid="MAT 21:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="MAT 21:42" />Kɛkɛ nɛ Yesu bi mɛ ke, “Anɛ nyɛ kane we gblee ngɛ Ngmami ɔmɛ a mi kaa, ‘Tɛ ɔ nɛ tsu fiali ɔmɛ sake kɛ fɔ he ɔ, lɛ nɔuu nɛ e ba plɛ kɔ nya tɛ. Nutsɔ ɔ ni tsumi ji nɛ ɔ nɛ, nɛ e ngɛ nyakpɛ ngɛ wa hɛ mi.’<verse eid="MAT 21:42" /></para>
  <para style="p">
    <verse number="43" style="v" sid="MAT 21:43" />Nɔ́ nɛ i ngɛ tsɔɔe ji kaa a ma kpɔ Mawu Matsɛyemi ɔ ngɛ nyɛ dɛ nɛ a maa ngɔ kɛ ha nihi nɛ maa wo yiblii nɛ a ngɛ hlae ɔ. <verse eid="MAT 21:43" /><verse number="44" style="v" sid="MAT 21:44" />Nɛ nɔ tsuaa nɔ nɛ maa ma kikɛmɛ a tɛ nɛ ɔ nɔ ɔ, e maa ku dugudugu, nɛ nɔ nɛ nɔ nɛ tɛ ɔ maa nɔ ɔ, lɛɛ e maa wɛɛ lɛ kaa mamu.”<verse eid="MAT 21:44" /></para>
  <para style="p">
    <verse number="45" style="v" sid="MAT 21:45" />Benɛ osɔfo nikɔtɔma amɛ kɛ Farisi bi ɔmɛ kɔ se kaa a he munyu e ngɛ tue ngɛ abɛ ɔ mi ɔ, <verse eid="MAT 21:45" /><verse number="46" style="v" sid="MAT 21:46" />a hla kaa a maa nu lɛ nɛ a gbe lɛ, se a ya ye asafo ɔ gbeye, ejakaa a buu Yesu gbalɔ.<verse eid="MAT 21:46" /></para>
  <chapter eid="MAT 21" />
  <chapter number="22" style="c" sid="MAT 22" />
  <para style="s1">Bɔ nɛ Hiɔwe Matsɛyemi ɔ ngɛ</para>
  <para style="p">
    <verse number="1-2" style="v" sid="MAT 22:1-2" />Yesu kɛ mɛ tu munyu ekohu ngɛ abɛhi a mi kɛ tsɔɔ bɔ nɛ Hiɔwe Matsɛyemi ɔ ngɛ ha. E de mɛ ke, “Hiɔwe Matsɛyemi ɔ ngɛ kaa matsɛ ko nɛ ngmɛ yo kpeemi okplɔɔ ha e binyumu. <verse eid="MAT 22:1-2" /><verse number="3" style="v" sid="MAT 22:3" />E kpee nihi fuu, nɛ benɛ a gbe niye ni ɔ nya a, e tsɔ nihi ke a ya tsɛ nihi nɛ a kpee mɛ kɛ ma okplɔɔ ɔ he ɔ, se a bɛ. <verse eid="MAT 22:3" /><verse number="4" style="v" sid="MAT 22:4" />E kpale tsɔ tsɔli kpahi ke a ya de mɛ ke, ‘A gbe nɔ́ tsuaa nɔ nya, a gbe ye na a ekomɛ kɛ ye lohwe zɔtsɛ ɔmɛ, lɔ ɔ he je ɔ, a ba yo kpeemi ɔ!’<verse eid="MAT 22:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 22:5" />Se ni ɔmɛ bui e tsɛmi ɔ nɛ a je kɛ ho a ni tsumihi ya; nɔ kake ho e ngmɔ mi ya, nɛ nɔ ko hu ho e jua yemi ya. <verse eid="MAT 22:5" /><verse number="6" style="v" sid="MAT 22:6" />Ni nɛmɛ nɛ piɛ ɔ nu tsɔli ɔmɛ nɛ a wa mɛ yi mi nɛ a gbe a ti ni komɛ.<verse eid="MAT 22:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 22:7" />Kɛkɛ nɛ matsɛ ɔ mi mi fu nɛ e tsɔ e sojahi nɛ a ya gbe awi yeli ɔmɛ nɛ a sa a ma a. <verse eid="MAT 22:7" /><verse number="8" style="v" sid="MAT 22:8" />Nɛ e de e tsɔli ɔmɛ ke, ‘A gbe yo kpeemi ni ɔ nya mohu, se nihi nɛ a kpee ɔ, a sɛ. <verse eid="MAT 22:8" /><verse number="9" style="v" sid="MAT 22:9" />Ja he je ɔ, nyɛɛ je kpo kɛ ya gbɛjegbɛ ɔ kɔ nya amɛ nɛ nyɛ ya kpee nɔ tsuaa nɔ nɛ nyɛ maa na kɛ ba yo kpeemi he ɔ.’<verse eid="MAT 22:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 22:10" />Nɛ sɔmɔli ɔmɛ je kpo kɛ ho blɔ ɔmɛ a nɔ ya, nɛ a ya bua nihi nɛ a na amɛ tsuo a nya kɛ ba, nimli kpakpahi kɛ nimli yayamihi tsuo, nɛ yo kpeemi he ɔ hyi tɔ. <verse eid="MAT 22:10" /><verse number="11" style="v" sid="MAT 22:11" />Se benɛ matsɛ ɔ ba ni ɔmɛ a he nyami ɔ, e ba na kaa nyumu ko ngɛ a kpɛti nɛ wui yo kpeemi tade.<verse eid="MAT 22:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 22:12" />Nɛ e bi lɛ ke, ‘Huɛ, kɛ pee kɛɛ nɛ o ba hiɛ ɔ nɛ o wui yo kpeemi tade?’ Se nyumu ɔ pɛ e nya mi.<verse eid="MAT 22:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 22:13" />Kɛkɛ nɛ matsɛ ɔ de e sɔmɔli ɔmɛ ke, ‘Nyɛɛ fi e ninehi kɛ e nanehi nɛ nyɛ wo lɛ ya sake kɛ fa blɔ se diblii ɔ mi, he nɛ ya fomi kɛ lungu nya kpemi ngɛ ɔ.’ <verse eid="MAT 22:13" /><verse number="14" style="v" sid="MAT 22:14" />Ejakaa, a tsɛ nihi fuu mohu, se nihi bɔɔ pɛ a maa hla.”<verse eid="MAT 22:14" /></para>
  <para style="s1">Lapoo tsumi he sane</para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 22:15" />Nɛ Farisi bi ɔmɛ ya kpe konɛ a susu blɔ nɔ nɛ a maa gu kɛ ka Yesu he, nɛ e de nɔ́ ko nɛ a maa da nɔ kɛ nu lɛ. <verse eid="MAT 22:15" /><verse number="16" style="v" sid="MAT 22:16" />Nɛ a tsɔ a kaseli ɔmɛ ekomɛ kɛ Herode bi ɔmɛ ekomɛ kɛ ho e ngɔ ya nɛ a ya bi lɛ ke, “Tsɔɔlɔ, wa le kaa anɔkualetsɛ ji mo. O tsɔɔ nɔ nɛ ji anɔkuale ɔ, nɛ o hlɛ nimli a mi, ejakaa o hyɛ we nimli a hɛ mi, nɛ o yi gbeye hulɔ. <verse eid="MAT 22:16" /><verse number="17" style="v" sid="MAT 22:17" />Lɔ ɔ he je ɔ, de wɔ bɔ nɛ o susuu ha. Anɛ e da kaa a tsuɔ lapoo haa Kaisare aloo e dɛ.”<verse eid="MAT 22:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 22:18" />Se Yesu kɔ a juɛmi yaya a se nɛ e de mɛ ke, “Osatotsɛmɛ, mɛnɔ nyɛ ngɛ kae kɛ munyu nɛ ɔ? <verse eid="MAT 22:18" /><verse number="19" style="v" sid="MAT 22:19" />Nyɛ wo sika a eko kɛ ba tsɔɔ mi.” Nɛ a kɛ pɛsua tsɔɔ lɛ.<verse eid="MAT 22:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 22:20" />Nɛ e bi mɛ ke, “Mɛnɔ foni ngɛ nɔ ɔ, nɛ mɛnɔ biɛ ngɛ sisi ɔ?”<verse eid="MAT 22:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 22:21" />A de lɛ ke, “Kaisare nɔ i.” Nɛ e de mɛ ke, “E da, lɛɛ nyɛɛ ngɔ Kaisare nɔ́ kɛ ha Kaisare, konɛ nyɛɛ ngɔ nɔ́ tsuaa nɔ nɛ ji Mawu nɔ́ ɔ hu kɛ ha Mawu.”<verse eid="MAT 22:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 22:22" />Heto nɛ e ha mɛ nɛ ɔ pee mɛ nyakpɛ nɛ a si lɛ nɛ a je.<verse eid="MAT 22:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 22:23" />Se jamɛ a ligbi ɔ nɔuu ɔ, Saduki bi ɔmɛ nɛ deɔ ke ni gbogboehi a si temi ko be ɔ hu ba e ngɔ ba bi lɛ ke, <verse eid="MAT 22:23" /><verse number="24" style="v" sid="MAT 22:24" />“Tsɔɔlɔ, Mose de wɔ ke, ke nɔ ko gbo nɛ e be bi ɔ, e nyɛmi nɛ ngɔ e yo ɔ konɛ a bimɛ ɔmɛ nɛ ye e nyɛmi nɛ gbo ɔ gbosi ni ɔ. <verse eid="MAT 22:24" /><verse number="25" style="v" sid="MAT 22:25" />Jehanɛ ɔ, nyɛmimɛ nyumuhi kpaago komɛ hi si. A Tɛte ɔ ngɔ yo, nɛ e gbo. Akɛnɛ e be bi he je ɔ, Tɛtɛ ɔ ngɔ e yo ɔ. <verse eid="MAT 22:25" /><verse number="26" style="v" sid="MAT 22:26" />Tɛtɛ ɔ hu ba gbo, nɛ akɛnɛ lɛ hu e kɛ yo ɔ fɔ we bi he je ɔ, e si yo ɔ ke ha e senɔ Tɛɛ ɔ. E tsa nɔ ja a kɛ ya su nɔ nɛ ji kpaago ɔ nɔ. <verse eid="MAT 22:26" /><verse number="27" style="v" sid="MAT 22:27" />Ngɛ mɛ tsuo a se ɔ yo ɔ hu ba gbo. <verse eid="MAT 22:27" /><verse number="28" style="v" sid="MAT 22:28" />Jehanɛ ɔ, nyɛmimɛ kpaago nɛ ɔmɛ ɔ, a ti mɛnɔ maa pee yo ɔ tsɛ ngɛ ni gbogboehi a si temi ɔ mi, ejakaa mɛ tsuo a kɛ lɛ hi si hyɛ?”<verse eid="MAT 22:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 22:29" />Yesu he nɔ nɛ e de mɛ ke, “Nyɛ ngɛ tɔe, ejakaa nyɛ li Ngmami Klɔuklɔu ɔ kɛ Mawu he wami. <verse eid="MAT 22:29" /><verse number="30" style="v" sid="MAT 22:30" />Ejakaa ngɛ ni gbogboehi a si temi ɔ mi ɔ, yo ngɔmi ko be, nɛ nɔ tsuaa nɔ ngɛ kaa Mawu bɔfo ngɛ hiɔwe. <verse eid="MAT 22:30" /><verse number="31" style="v" sid="MAT 22:31" />Anɛ nyɛ kane we Ngmami ɔ nɛ kɔɔ ni gbogboehi a si temi he ɔ lo? Anɛ nyɛ yo we kaa nyɛ nɛ Mawu kɛ ngɛ munyu tue benɛ e de ke, <verse eid="MAT 22:31" /><verse number="32" style="v" sid="MAT 22:32" />‘Ami ji Abraham kɛ Isak kɛ Yakob a Mawu ɔ nɛ?’ Lɔ ɔ he je ɔ, Mawu pi ni gbogboehi a Mawu, se mohu hɛ kali a Mawu i.”<verse eid="MAT 22:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 22:33" />Benɛ asafo ɔ nu enɛ ɔ, a nya kpɛ a he ngɛ e ni tsɔɔmi ɔ he. <verse eid="MAT 22:33" /><verse number="34" style="v" sid="MAT 22:34" />Se benɛ Farisi bi ɔmɛ nu kaa Yesu ku Saduki bi ɔmɛ a nya la a, a ba bua a he nya ngɛ he kake, nɛ a pee a juɛmi kaa a ma ya bi munyu kpa ko. <verse eid="MAT 22:34" /><verse number="35" style="v" sid="MAT 22:35" />Ja a he je ɔ, a ti nɔ kake nɛ ji mlaa tsɔɔlɔ ɔ ka lɛ nɛ e bi lɛ ke, <verse eid="MAT 22:35" /><verse number="36" style="v" sid="MAT 22:36" />“Tsɔɔlɔ, Mose mlaa amɛ a kpɛti te nɔ́ nɛ ji ngua pe kulaa nɛɛ?”<verse eid="MAT 22:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="MAT 22:37" />Yesu he nɔ nɛ e de mɛ ke, “ ‘Moo suɔ Nutsɔ ɔ Mawu ɔ kɛ o tsui kɛ o klaa kulaa kɛ o juɛmi kulaa.’ <verse eid="MAT 22:37" /><verse number="38" style="v" sid="MAT 22:38" />Enɛ ɔ ji kita amɛ a mi kekle nɔ kɛ ngua pe kulaa. <verse eid="MAT 22:38" /><verse number="39" style="v" sid="MAT 22:39" />Nɛ enyɔne ɔ nɛ nyɛɛ se ɔ ngɛ kaa kekle nɔ ɔ kɛ, ‘Moo suɔ o nyɛmi nɔmlɔ kaa bɔ nɛ o suɔ mo nitsɛ o he ɔ.’ <verse eid="MAT 22:39" /><verse number="40" style="v" sid="MAT 22:40" />Mlaa nɔ nɛmɛ nɛ piɛ ɔmɛ kɛ gbali ɔmɛ a munyu ɔmɛ tsuo je mlaa enyɔ nɛ ɔmɛ a mi, nɛ ke o ye mlaa nɛ ɔmɛ a nɔ ɔ, o maa na kaa o ngɛ mlaa kpa amɛ tsuo a nɔ yee.”<verse eid="MAT 22:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="MAT 22:41" />Benɛ Farisi bi ɔmɛ a nya ba bua a, Yesu bi mɛ ke, <verse eid="MAT 22:41" /><verse number="42" style="v" sid="MAT 22:42" />“Kɛ nyɛ susuu ngɛ Kristo ɔ he kɛɛ? Mɛnɔ bi ji lɛ?” A ha lɛ heto ke, “David bi ji lɛ.”<verse eid="MAT 22:42" /></para>
  <para style="p">
    <verse number="43" style="v" sid="MAT 22:43" />Nɛ e bi mɛ ekohu ke, “Lɛɛ mɛni he je mɔ nɛ benɛ Mumi Klɔuklɔu ɔ ba David nɔ nɛ e ngɛ munyu tue ɔ e tsɛ lɛ Nutsɔ nɛ e de ke, <verse eid="MAT 22:43" /><verse number="44" style="v" sid="MAT 22:44" />‘Mawu de ye Nutsɔ ɔ ke, Hii si ngɛ ye hiɔ nɔ kɛ ya si be mi nɛ ma ngɔ o he nyɛli ɔmɛ kɛ wo o nane sisi.’ <verse eid="MAT 22:44" /><verse number="45" style="v" sid="MAT 22:45" />Ke David tsɛ lɛ ‘Nutsɔ’ ɔ, kɛ peeɔ kɛɛ nɛ e pa peeɔ e bi mɔ?”<verse eid="MAT 22:45" /></para>
  <para style="p">
    <verse number="46" style="v" sid="MAT 22:46" />A nyɛ we nɛ a ha lɛ heto ko, nɛ kɛ je jamɛ a be ɔ mi ɔ nɔ ko nyɛ we lɛ munyu ko nɛ e bi hu.<verse eid="MAT 22:46" /></para>
  <chapter eid="MAT 22" />
  <chapter number="23" style="c" sid="MAT 23" />
  <para style="s1">Kristo tu Farisi bi ɔmɛ a tɔmihi a he munyu</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 23:1" />Jehanɛ ɔ, Yesu de asafo ɔ kɛ e kaseli ɔmɛ ke, <verse eid="MAT 23:1" /><verse number="2" style="v" sid="MAT 23:2" />“Nyɛ ma susu kaa mlaa tsɔɔli ɔmɛ kɛ Farisi bi ɔmɛ ɔ, Mose we bi ji mɛ ngɛ mlaahi nɛ a ngɛ woe ɔ he je. <verse eid="MAT 23:2" /><verse number="3" style="v" sid="MAT 23:3" />E sa kaa nyɛɛ ye nɔ́ tsuaa nɔ nɛ a ma de nyɛ ɔ nɔ mohu, se nyɛ ko pee a ni peemi ni ɔmɛ, ejakaa a deɔ mohu se a pee we. <verse eid="MAT 23:3" /><verse number="4" style="v" sid="MAT 23:4" />A biɔ nyɛ nɛ nyɛɛ pee níhi nɛ mɛ nitsɛmɛ a be nyɛe maa pee.<verse eid="MAT 23:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 23:5" />A suɔ nɛ nɔ́ tsuaa nɔ nɛ a maa pee ɔ nihi nɛ na mɛ. A kplaa Ngmami Klɔuklɔu ɔ mi munyuhi, nɛ a peeɔ a tade ɔmɛ a nya gagaaga. <verse eid="MAT 23:5" /><verse number="6" style="v" sid="MAT 23:6" />Nɛ be fɛɛ be ke a tsɛ mɛ niye ni ɔ a suɔ nɛ a hi okplɔɔ yi kɛ nikɔtɔmahi a sihi hehi ngɛ kpe he ɔmɛ. <verse eid="MAT 23:6" /><verse number="7" style="v" sid="MAT 23:7" />Nɛ a suɔ jua nɔ kɛ gbɛjegbɛ nɔ ngami ɔmɛ kɛ tsɛmi nɛ a tsɛɛ mɛ ‘Tsɔɔlɔ’, kɛ ‘Nutsɔ’ ɔ. <verse eid="MAT 23:7" /><verse number="8" style="v" sid="MAT 23:8" />Se nyɛɛ lɛɛ nyɛ ko ha nɛ a tsɛ nyɛ ja, ejakaa Mawu nɔ kake pɛ ji nyɛ Tsɔɔlɔ, se nyɛ tsuo lɛɛ nyɛmimɛ ji nyɛ. <verse eid="MAT 23:8" /><verse number="9" style="v" sid="MAT 23:9" />Nyɛ ko tsɛ nɔ ko ngɛ zugba nɛ ɔ nɔ ke, ‘Tsaatsɛ,’ ejakaa Mawu nɛ ngɛ hiɔwe ɔ ji nyɛ tsɛ, nɛ lɛ pɛ e sa nɛ a tsɛ ja. <verse eid="MAT 23:9" /><verse number="10" style="v" sid="MAT 23:10" />Jehanɛ ɔ hu a ko tsɛ nyɛ ‘Nutsɔ,’ ejakaa nɔ kake pɛ ji nyɛ nutsɔ, nɛ lɛ ji Kristo.<verse eid="MAT 23:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 23:11" />Nɔ nɛ sɔmɔɔ ni kpahi kɛ he si bami ji ngua. Lɔ ɔ he je ɔ, nɔ nɛ suɔ kaa e pee ngua pe kulaa ngɛ nyɛ kpɛti ɔ, e plɛ nyɛ sɔmɔlɔ. <verse eid="MAT 23:11" /><verse number="12" style="v" sid="MAT 23:12" />Nɛ nɔ tsuaa nɔ nɛ ma wo e he nɔ ɔ, a maa ba lɛ si, nɛ nɔ tsuaa nɔ nɛ maa ba e he si ɔ, a ma wo e nɔ gojoo.<verse eid="MAT 23:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 23:13" />Kpoo ha nyɛ, Farisi bi kɛ mlaa tsɔɔli, osatotsɛmɛ! Ejakaa nyɛ ha we ni ɔmɛ he blɔ nɛ a sɛ Hiɔwe Matsɛyemi ɔ mi, nɛ nyɛ nitsɛmɛ hu nyɛ sɛ we mi. <verse eid="MAT 23:13" /><verse number="14" style="v" sid="MAT 23:14" />Osatotsɛmɛ! Nyɛ peeɔ nyɛ he kaa nihi nɛ a he tsɔ, nyɛ sɔleɔ gagaaga ngɛ ma hɛ mi ngɛ gbɛjegbɛ ɔmɛ a nɔ, se nyɛ fieɔ yalɔyihi kɛ jee a wehi a mi. <verse eid="MAT 23:14" /><verse number="15" style="v" sid="MAT 23:15" />I ngɛ dee ke kpoo ha nyɛ, Farisi bi kɛ mlaa tsɔɔli, osatotsɛmɛ! Nyɛ gboɔ dengme bɔ nɛ sa kɛ tsakee nɔ ko, se ke nɔ ɔ tsake pɛ nyɛ kpaleɔ peeɔ lɛ Abosiami bi ngwɔ he enyɔ pe bɔ nɛ nyɛ nitsɛmɛ nyɛ ngɛ ɔ. <verse eid="MAT 23:15" /><verse number="16" style="v" sid="MAT 23:16" />Due ha nyɛ, blɔ tsɔɔli hɛ ngmɛ kokoetsɛmɛ! Nyɛ nihi nɛ nyɛ deɔ ke, ke a kɛ ‘Mawu We ɔ’ ka kita nɛ e pi nɔ ko, se ke a kɛ ‘Sɔlemi We ɔ mi sika tsu ɔ’ ka kita lɛɛ due ɔ! <verse eid="MAT 23:16" /><verse number="17" style="v" sid="MAT 23:17" />Kuasiahi nɛ hyɛ we nɔ, te nɔ́ nɛ kle nɛɛ, sika tsu ɔ loo Sɔlemi We ɔ nɛ tsukɔɔ sika tsu ɔ he ɔ? <verse eid="MAT 23:17" /><verse number="18" style="v" sid="MAT 23:18" />Nɛ nyɛ deɔ hu ke, ke nɔ ko kɛ ‘Bɔ sami la tɛ ɔ’ ka kita nɛ e pi nɔ ko, se ke e kɛ ‘Nike ni nɛ ngɛ bɔ sami la tɛ ɔ nɔ’ ka kita lɛɛ due! <verse eid="MAT 23:18" /><verse number="19" style="v" sid="MAT 23:19" />Hɛ ngmɛ kokoetsɛmɛ, te nɔ nɛ kle nɛɛ, bɔ ɔ loo bɔ sami la tɛ ɔ nɛ haa bɔ ɔ he tsɔɔ ɔ? <verse eid="MAT 23:19" /><verse number="20" style="v" sid="MAT 23:20" />Ke o kɛ ‘Bɔ sami la tɛ ɔ’ ka kita a, e tsɔɔ kaa o kɛ la tɛ ɔ kɛ nɔ tsuaa nɔ nɛ ngɛ la tɛ ɔ nɔ ɔ ka kita, <verse eid="MAT 23:20" /><verse number="21" style="v" sid="MAT 23:21" />nɛ ke o kɛ ‘Sɔlemi We ɔ’ ka kita a, e tsɔɔ kaa o kɛ Sɔlemi We ɔ kɛ Mawu nɛ hii mi ɔ ka kita. <verse eid="MAT 23:21" /><verse number="22" style="v" sid="MAT 23:22" />Nɛ ke o kɛ ‘Hiɔwe’ ka kita a, e tsɔɔ kaa o kɛ Mawu Matsɛ Sɛ ɔ kɛ Mawu nitsɛ ka kita.<verse eid="MAT 23:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 23:23" />I ngɛ nyɛ dee ke kpoo ha nyɛ Farisi bi kɛ mlaa tsɔɔli, osatotsɛmɛ! Nyɛ haa mi dlami nyɔngma a ngɛ nyɛ ngmɔ mi nɔ fɛɛ nɔ nɔ pɛpɛɛpɛ, se nyɛ siɔ níhi nɛ a he hia pe kulaa a mohu, nɛ ji dami sane yemi, mɔbɔ nami kɛ hemi kɛ yemi ɔ. E sa kaa nyɛ ha mi dlami nyɔngma a, se nyɛ ko si ni nɛ ɔmɛ nɛ a he hia a hu fa. <verse eid="MAT 23:23" /><verse number="24" style="v" sid="MAT 23:24" />Blɔ tsɔɔli nɛ hyɛ we nɔ, nyɛ tsleɔ anunu ngɛ nɔ nɔ, se nyɛ mii afukpɔngɔ!<verse eid="MAT 23:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 23:25" />Kpoo ha nyɛ, Farisi bi kɛ mlaa tsɔɔli, osatotsɛmɛ! Nyɛ kpo nɔ blɔ ngɛ falefale, se nyɛ mi blɔ hyi gbagbaagba kɛ ojo fiami kɛ hɛ kɔ. <verse eid="MAT 23:25" /><verse number="26" style="v" sid="MAT 23:26" />Farisi bi nɛ nyɛ hɛ yu, nyɛɛ tsu nyɛ mi blɔ he nɛ e je kekle loko ji nyɛ he tsuo maa je.<verse eid="MAT 23:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 23:27" />Kpoo ha nyɛ, Farisi bi kɛ mlaa tsɔɔli, osatotsɛmɛ! Nyɛ ngɛ kaa yɔkɔhi nɛ a he ngɛ fɛu se a mi hyi tɔ kɛ ni gbogboehi a wuhi kɛ mu níhi slɔɔtohi. <verse eid="MAT 23:27" /><verse number="28" style="v" sid="MAT 23:28" />Ja a nɔuu nyɛ hu nyɛ peeɔ nyɛ he kaa dali se osato kɛ yayami sɔuu nɛ hyi nyɛ tsui mi tɔ.<verse eid="MAT 23:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 23:29" />Kpoo ha nyɛ, Farisi bi kɛ mlaa tsɔɔli, osatotsɛmɛ!Nyɛ maa gbali ɔmɛ a yɔkɔ ɔmɛ, nɛ nyɛ dlaa dali ɔmɛ nɛ nyɛ tsɛmɛ ɔmɛ kpata a hɛ mi ɔ a yɔkɔ ɔmɛ a he kɛ mɔmɔhi, <verse eid="MAT 23:29" /><verse number="30" style="v" sid="MAT 23:30" />nɛ nyɛ deɔ ke, ‘E ji wa tsɛmɛ a yi nɔ nɛ a fɔ wɔ ngɛ jinɛ wa ko piɛ we a he nɛ a tane gbali ɔmɛ a yi.’<verse eid="MAT 23:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 23:31" />Enɛ ɔ tsɔɔ kaa nyɛ ngɛ nyɛ nitsɛmɛ nyɛ he odase yee kaa yi kpɛti wali a bimɛ ji nyɛ. <verse eid="MAT 23:31" /><verse number="32" style="v" sid="MAT 23:32" />Nɛ nyɛ ngɛ a ni peemi ni ɔmɛ pee, ejakaa nyɛ ngɛ a yayami ɔmɛ a nɔ tsae. <verse eid="MAT 23:32" /><verse number="33" style="v" sid="MAT 23:33" />Sinɔhi a bimɛ! Kɛ nyɛ maa pee kɛ tu Abosiami a je kojomi ɔ nya fɔ kɛɛ?<verse eid="MAT 23:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 23:34" />Ma tsɔ gbali kɛ ni leli kɛ mlaa tsɔɔli kɛ ba nyɛ ngɔ, nyɛ maa gbe a ti nihi, nɛ nyɛ maa sɛu ni komɛ. Nɛ ni komɛ hu nyɛ maa fiaa a se mi kpa ngɛ nyɛ kpe he ɔmɛ, nɛ nyɛ maa fie mɛ kɛ je nyɛ ma amɛ a mi, <verse eid="MAT 23:34" /><verse number="35" style="v" sid="MAT 23:35" />konɛ nyɛɛ ye dali ɔmɛ tsuo nɛ nyɛ gbe kɛ je Habel nɔ kɛ ba si Zakaria nɛ ji Barakia bi ɔ nɛ nyɛ gbe ngɛ Sɔlemi We ɔ kɛ bɔ sami la tɛ ɔ kpɛti ɔ, a muɔ yi fɔ. <verse eid="MAT 23:35" /><verse number="36" style="v" sid="MAT 23:36" />Anɔkuale, i ngɛ nyɛ dee ke fɔ bumi nɛ ɔmɛ tsuo maa ba yi nɔ bi nɛ ɔmɛ a nɔ.<verse eid="MAT 23:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="MAT 23:37" />Oo Yerusalem, Yerusalem, mo ma nɛ o gbee gbali ɔmɛ nɛ o fiaa nihi tsuo nɛ Mawu tsɔ mɛ o ngɔ tɛ ɔ. Si nyɛmɛ nɛ i hla we kaa ma bua o bimɛ a nya kaa bɔ nɛ kungwɔ buaa e bimɛ a nya kɛ woɔ e pɛlihi a sisi nɛ o kplɛɛ we. <verse eid="MAT 23:37" /><verse number="38" style="v" sid="MAT 23:38" />Lɔ ɔ he je ɔ, amlɔ nɛ ɔ, a si o we ɔ we doku ha mo. <verse eid="MAT 23:38" /><verse number="39" style="v" sid="MAT 23:39" />Nɛ i ngɛ mo dee ke, kɛ je be nɛ ɔ mi kɛ yaa a, o be mi nae hu kɛ yaa si be nɛ o ma de kɛ, ‘A gbaa nɔ nɛ ma ngɛ Nutsɔ ɔ biɛ mi ɔ.’ ”<verse eid="MAT 23:39" /></para>
  <chapter eid="MAT 23" />
  <chapter number="24" style="c" sid="MAT 24" />
  <para style="s1">Yesu tu nihi nɛ maa ba a he munyu</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 24:1" />Benɛ Yesu je kpo kɛ je Sɔlemi We ɔ kɛ yaa a, e kaseli ɔmɛ nyɛɛ e se nɛ a hla kaa a maa tsɔɔ lɛ Sɔlemi We ɔ tsu ɔmɛ .<verse eid="MAT 24:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="MAT 24:2" />Se e de mɛ ke, “Tsɛ nyɛ ngɛ tsu nɛ ɔmɛ tsuo hyɛe? Anɔkuale, i ngɛ nyɛ dee ke, a be eko sie nɛ a be lɛ hulee, nɛ a be tɛ kake tete sie ngɛ eko nɔ.”<verse eid="MAT 24:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 24:3" />Benɛ Yesu hii si ngɛ Nuyoku ɔ nɔ ɔ, e kaseli ɔmɛ ba e ngɔ nɛ a ba bi lɛ ke, “Mɛni be mi ni nɛ ɔmɛ maa ba mi, nɛ mɛni ji o bami kɛ je nɛ ɔ nyagbe ɔ he okadi?”<verse eid="MAT 24:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 24:4" />Nɛ Yesu de mɛ ke, “Nyɛ ko ha nɛ nɔ ko nɛ mlɔ nyɛ. <verse eid="MAT 24:4" /><verse number="5" style="v" sid="MAT 24:5" />Ejakaa nihi fuu maa ba kaa mɛ ji Kristo ɔ nɛ, nɛ a maa mlɔ nihi babauu. <verse eid="MAT 24:5" /><verse number="6" style="v" sid="MAT 24:6" />Ke nyɛ nu tahi a he ɔ, enɛ ɔ tsɔɔ we ye bami ɔ he okadi; ni nɛ ɔmɛ maa ba mohu, se kɛ ɔ, nyagbe ɔ sui lolo. <verse eid="MAT 24:6" /><verse number="7" style="v" sid="MAT 24:7" />Ma maa te si kɛ wo ma, nɛ matsɛhi maa te si kɛ wo a bi, nɛ hwɔ kɛ zugba hosomi maa ba ngɛ hehi slɔɔtohi. <verse eid="MAT 24:7" /><verse number="8" style="v" sid="MAT 24:8" />Se enɛ ɔmɛ tsuo ɔ, haomi agbo ɔ nɛ maa ba a e sisije kɛkɛ i.<verse eid="MAT 24:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 24:9" />Jamɛ a be ɔ mi ɔ, a maa wa nyɛ yi mi, nɛ a maa gbe nyɛ, nɛ je ɔ tsuo maa nyɛ nyɛ ngɛ ye he je. <verse eid="MAT 24:9" /><verse number="10" style="v" sid="MAT 24:10" />Nyɛ ti nihi fuu a nane ma kpata, nɛ a maa nyɛ a nyɛmimɛ nɛ a maa tsɔɔ a se blɔ. <verse eid="MAT 24:10" /><verse number="11" style="v" sid="MAT 24:11" />Nɛ nyangɔ gbali fuu maa te si nɛ a maa tɔtɔ nihi fuu a nane. <verse eid="MAT 24:11" /><verse number="12" style="v" sid="MAT 24:12" />Akɛnɛ yayami maa pɔ he he je ɔ, nihi fuu a suɔmi he maa jɔ yluduu. <verse eid="MAT 24:12" /><verse number="13" style="v" sid="MAT 24:13" />Se ni nɛmɛ nɛ maa hɛɛ mi kɛ ya nyagbe ɔ, a ma he a yi wami.<verse eid="MAT 24:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 24:14" />Se loko ji nyagbe ɔ maa ba a, a maa fiɛ Matsɛyemi ɔ Manye Munyu ɔ ngɔ tsɔɔ je ɔ kulaa konɛ majemaje ɔ tsuo nɛ nu he.<verse eid="MAT 24:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 24:15" />Ja a he je ɔ, ke nyɛ na kaa aywilɛho ni nɛ ɔmɛ nɛ Gbalɔ Daniel tu he munyu ɔ ba he klɔuklɔu ɔ, mo nɔ nɛ o kane womi nɛ ɔ, o kɔ se! <verse eid="MAT 24:15" /><verse number="16" style="v" sid="MAT 24:16" />Kɛkɛ ɔ, nihi nɛ ngɛ Yudea a, a tu fo kɛ ya Yudea yoku ɔmɛ a nɔ. <verse eid="MAT 24:16" /><verse number="17" style="v" sid="MAT 24:17" />Nɛ nihi nɛ ngɛ a tsuhi a yi mi ɔ, a ko kple si ke a yaa ngɔ nɔ ko ngɛ a tsu ɔmɛ a mi loko ji a tu fo. <verse eid="MAT 24:17" /><verse number="18" style="v" sid="MAT 24:18" />Nihi nɛ ngɛ a ngmɔhi a mi ɔ, a ko kpale kɛ ba a wehi a mi ke a yaa ngɔ a tadehi.<verse eid="MAT 24:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 24:19" />Kpoo ha yihi nɛ hɛɛ muklii kɛ nihi nɛ hɛɛ bimwɔwi ngɛ jamɛ a be ɔ mi. <verse eid="MAT 24:19" /><verse number="20" style="v" sid="MAT 24:20" />Nyɛɛ sɔle kaa nyɛ fo tumi be ɔ e ko ba ngɛ fiɛ lebe mi aloo ngɛ Hejɔɔmi Ligbi ɔ nɔ. <verse eid="MAT 24:20" /><verse number="21" style="v" sid="MAT 24:21" />Ejakaa jamɛ a be ɔ mi ɔ, yi mi wami ko maa te si nɛ a nɛ eko hyɛ kɛ je je ɔ sisije kɛ ba si piɔ, nɛ a be eko nae hu gblee.<verse eid="MAT 24:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 24:22" />Niinɛ, ke a pui jamɛ a ligbi ɔmɛ a nɔ kuku ɔ, adesahi kulaa a hɛ mi ma kpata. Se a maa po a nɔ kpiti ngɛ Mawu hlami bi ɔmɛ a he.<verse eid="MAT 24:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 24:23" />Ngɛ jamɛ a be ɔ mi ɔ, ke nɔ ko de nyɛ ke, ‘Kristo ngɛ hiɛ aloo e ba be kɛ ho hiɛ loo hiɛ ya a’, nyɛ ko he ye. <verse eid="MAT 24:23" /><verse number="24" style="v" sid="MAT 24:24" />Ejakaa lakpa Kristohi kɛ lakpa gbali maa te si nɛ a maa pee nyakpɛ nihi kɛ tsɔɔ, nɛ ke nyɛ hyɛ we nɛ hi ɔ, a kɛ maa mlɔ Mawu hlami bi ɔmɛ tete. <verse eid="MAT 24:24" /><verse number="25" style="v" sid="MAT 24:25" />Nyɛ nɛ, i de nyɛ kɛ fɔ si.<verse eid="MAT 24:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 24:26" />Lɔ ɔ he je ɔ, ke nɔ ko de nyɛ ke Kristo ɔ kpale kɛ ba nɛ e ngɛ nga a nɔ ɔ, nyɛ ko ya hyɛ. Aloo ke a de nyɛ ke e ngɛ e he laae ngɛ he ko ɔ nyɛ ko he ye. <verse eid="MAT 24:26" /><verse number="27" style="v" sid="MAT 24:27" />Ejakaa bɔ nɛ oslabai ngaa tlukaa si kake kɛ jee beleku kɛ yaa bonyoku ɔ, ja a nɔuu Nɔmlɔ Bi ɔ bami ɔ maa pee. <verse eid="MAT 24:27" /><verse number="28" style="v" sid="MAT 24:28" />Ejakaa he fɛɛ he nɛ nɔ gbogboe fɔɔ si ngɛ ɔ, lejɛ ɔ okpokuhi buaa a he nya ngɛ.<verse eid="MAT 24:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 24:29" />Ngɛ yi mi wami ɔmɛ a se nɔuu ngɛ jamɛ a ligbi ɔmɛ a nɔ ɔ, pu ma piɛ diblii, nɛ nyɔhiɔ be kpɛe, nɛ dodoehi ma tsɔ kɛ je hiɔwe ba nɔ si, nɛ hiɔwe he wami ɔmɛ ma hoso.<verse eid="MAT 24:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="MAT 24:30" />Kɛkɛ ɔ, Nɔmlɔ Bi ɔ bami he okadi ɔ maa je kpo ngɛ hiɔwe nɛ gbenɔ ya maa pɛ ngɛ zugba a nɔ he fɛɛ he. Nɛ zugba a nɔ wɛtso ɔmɛ maa na Nɔmlɔ Bi ɔ kaa e ma ngɛ hiɔwe bɔ kuu ɔmɛ a mi kɛ he wami kɛ hɛ mi nyami babauu. <verse eid="MAT 24:30" /><verse number="31" style="v" sid="MAT 24:31" />Nɛ e maa tsɔ e bɔfo ɔmɛ kɛ bɛ nɛ nya wa. A ma bua e hlami bi ɔmɛ a nya kɛ maa je je kɔ nya eywiɛ ɔmɛ tsuo kɛ hiɔwe nyagbe he ɔmɛ.<verse eid="MAT 24:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 24:32" />Jehanɛ ɔ, nyɛɛ kase tso nɛ ngɛ kaa mangoo tso he abɛ ɔ nɛ i bu nyɛ ɔ he ni. Benɛ e kɔni ɔmɛ bɔ, nɛ a bahi bɔni peemi mlɔmlɔmlɔ ɔ, nyɛ le kaa latsa be su si ta. <verse eid="MAT 24:32" /><verse number="33" style="v" sid="MAT 24:33" />Ja a nɔuu nyɛ hu ke nyɛ na kaa ni nɛ ɔmɛ tsuo bɔni mi bami ɔ, nyɛɛ le kaa ye bami ɔ su ta. <verse eid="MAT 24:33" /><verse number="34" style="v" sid="MAT 24:34" />Anɔkuale, i ngɛ nyɛ dee ke, yi nɔ nɛ ɔ be bee, ja ni nɛ ɔmɛ ba mi lolo.<verse eid="MAT 24:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="MAT 24:35" />Hiɔwe kɛ zugba maa be kɛ ho, se ye munyu ɔmɛ maa hi si kɛ ya neneene. <verse eid="MAT 24:35" /><verse number="36" style="v" sid="MAT 24:36" />Se nɔ ko li ligbi ɔ kɛ ngmlɛfia a nɛ nyagbe ɔ maa ba, bɔfohi nɛ ngɛ hiɔwe ɔ tete li, nɛ Mawu Bi ɔ hu li, ja Tsɛ ɔ nɔ kake pɛ.<verse eid="MAT 24:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="MAT 24:37" />Nɔmlɔ Bi ɔ bami ɔ maa pee kaa bɔ nɛ e ba mi ngɛ Noa be ɔ mi ɔ, benɛ nyu afua ba tlukaa a. <verse eid="MAT 24:37" /><verse number="38" style="v" sid="MAT 24:38" />Jamɛ a be ɔ mi ɔ, ni ɔmɛ hɛɛ ni yemi kɛ ni numi kɛ yo ngɔmi mi hluu kɛ ya si ligbi nɔ nɛ Noa ya sɛ daka a mi; <verse eid="MAT 24:38" /><verse number="39" style="v" sid="MAT 24:39" />nɛ a he we nɔ́ nɛ ma a yi kɛ ya si be nɛ nyu afua a wo mɛ tsuo kɛ ho; ja a nɔuu Nɔmlɔ Bi ɔ bami ɔ hu maa pee.<verse eid="MAT 24:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="MAT 24:40" />Jamɛ a be ɔ mi ɔ, nyumuhi enyɔ maa hi ni tsue ngɛ ngmɔ nɔ, a maa ngɔ nɔ kake, nɛ a ma si nɔ kake. <verse eid="MAT 24:40" /><verse number="41" style="v" sid="MAT 24:41" />Yihi enyɔ maa hi wɛɛe ngɛ we se, a maa ngɔ nɔ kake, nɛ a ma si nɔ kake.<verse eid="MAT 24:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="MAT 24:42" />Enɛ ɔ he je ɔ, nyɛ dla nyɛ he, ejakaa nyɛ li ligbi nɛ nyɛ Nutsɔ ɔ ma.<verse eid="MAT 24:42" /></para>
  <para style="p">
    <verse number="43" style="v" sid="MAT 24:43" />Se nyɛ na nɛ nyɛɛ le kaa bɔ nɛ wetsɛ ko maa bu e we he konɛ julɔ nɛ ko ba ju lɛ ɔ, ja a nyɛ hu nyɛ ma dla nyɛ he be fɛɛ be kɛ to. <verse eid="MAT 24:43" /><verse number="44" style="v" sid="MAT 24:44" />Enɛ ɔ he je ɔ, nyɛ hu nyɛ dla nyɛ he kɛ to, ejakaa Nɔmlɔ Bi ɔ maa ba ngmlɛfia nɛ nyɛ he be nɔ.<verse eid="MAT 24:44" /></para>
  <para style="p">
    <verse number="45" style="v" sid="MAT 24:45" />Mɛnɔ ji tsɔlɔ ni lelɔ kɛ anɔkualetsɛ nɛ e nutsɔ ngɔ lɛ kɛ to e we bihi a nya konɛ e ha mɛ niye ni ngɛ be nɛ sa mi? <verse eid="MAT 24:45" /><verse number="46" style="v" sid="MAT 24:46" />A gbaa jamɛ a tsɔlɔ ɔ, nɔ nɛ ke e nutsɔ ɔ ba a, e ma ba na lɛ kaa e ngɛ ni ɔ tsue pɛpɛɛpɛ ɔ. <verse eid="MAT 24:46" /><verse number="47" style="v" sid="MAT 24:47" />Anɔkuale, i ngɛ nyɛ dee ke nutsɔ ɔ maa ngɔ lɛ ngɔ to e weto ni ɔmɛ tsuo a nya.<verse eid="MAT 24:47" /></para>
  <para style="p">
    <verse number="48" style="v" sid="MAT 24:48" />Se ke tsɔlɔ yayami ji lɛ ɔ, e ma de e he ke, ‘Ye Nutsɔ ɔ se maa fia si bɔɔ;’ <verse eid="MAT 24:48" /><verse number="49" style="v" sid="MAT 24:49" />nɛ e ma bɔni e huɛmɛ tsɔli kpa amɛ yi mi wami, nɛ e kɛ da deli ma bɔni ni yemi kɛ ni numi. <verse eid="MAT 24:49" /><verse number="50" style="v" sid="MAT 24:50" />Kɛkɛ nɛ e nutsɔ ɔ maa ba tlukaa, <verse eid="MAT 24:50" /><verse number="51" style="v" sid="MAT 24:51" />nɛ e maa fiaa lɛ kpa saminya nɛ e maa wo lɛ blɔ kɛ ho osatotsɛmɛ a kojomi he ya, he nɛ ya fomi kɛ lungu nya kpemi ngɛ ɔ.”<verse eid="MAT 24:51" /></para>
  <chapter eid="MAT 24" />
  <chapter number="25" style="c" sid="MAT 25" />
  <para style="s1">Hiɔwe Matsɛyemi ɔ he munyu kpa komɛ</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 25:1" />“Hiɔwe Matsɛyemi ɔ ngɛ kaa yihewi nyɔngma nɛ a wo a kanehi ke a yaa kpee ayɛflo huno. <verse eid="MAT 25:1" /><verse number="2" style="v" sid="MAT 25:2" />Se a kpɛti ni enuɔ ɔ, ni leli ji mɛ, nɛ ni enuɔ hu kuasiahi. <verse eid="MAT 25:2" /><verse number="3" style="v" sid="MAT 25:3" />Kuasia amɛ wo a kane ɔmɛ mohu, se a ngɔɛ nu kɛ piɛ we he. <verse eid="MAT 25:3" /><verse number="4" style="v" sid="MAT 25:4" />Se ni leli ɔmɛ lɛɛ a hɛɛ nu kɛ tɔ kɛ piɛ a kane ɔmɛ a he.<verse eid="MAT 25:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 25:5" />Ayɛflo huno ɔ kpɛ se, lɔ ɔ he je ɔ mahe nɔ a nɔ. <verse eid="MAT 25:5" /><verse number="6" style="v" sid="MAT 25:6" />Se nyɔ mi kpɛti ɔ, a nu ngmlaa ke, ‘Ayɛflo huno ɔ ma oo! Nyɛɛ je kpo nɛ nyɛ ya kpee lɛ!’<verse eid="MAT 25:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 25:7" />Kɛkɛ nɛ yihewi ɔmɛ tsuo te si o ya nɛ a tsiɛ a kane ɔmɛ a mi. <verse eid="MAT 25:7" /><verse number="8" style="v" sid="MAT 25:8" />Se yihewi kuasia amɛ kpa ni leli ɔmɛ pɛɛ nɛ a ha mɛ a nu ɔ eko, ejakaa a kane ɔmɛ ngɛ gboe.<verse eid="MAT 25:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 25:9" />Se ni leli ɔmɛ de mɛ ke, ‘Wa be nu nɛ maa su nyɛ nya. Nyɛɛ ya tsuapo ɔmɛ a mi nɛ nyɛ ya he eko kɛ ha nyɛ he.’<verse eid="MAT 25:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 25:10" />Benɛ a ho nu ɔ hemi ya a, ayɛflo huno ɔ ba, nɛ ni nɛmɛ nɛ dla a he kɛ to ɔ kɛ lɛ sɛ yo kpeemi he ɔ, nɛ a nga sinya a.<verse eid="MAT 25:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 25:11" />Pee se benɛ yihewi enuɔ ɔmɛ ba a, a ba da sinya a se nɛ a tsɛ ke, ‘Nutsɔ, Nutsɔ, mo bli wɔ!’<verse eid="MAT 25:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 25:12" />Nɛ e he nɔ de mɛ ke, ‘Nyɛɛ ya se kɛ je lejɛ ɔ, i li nyɛ!’<verse eid="MAT 25:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 25:13" />Lɔ ɔ he je ɔ, nyɛɛ huɔ nɛ nyɛ dla nyɛ he kɛ to, ejakaa nyɛ li ligbi loo ngmlɛfia a nɛ Nɔmlɔ Bi ɔ maa kpale kɛ ba.<verse eid="MAT 25:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 25:14" />Jehanɛ ɔ hu ɔ, Hiɔwe Matsɛyemi ɔ ngɛ kaa nyumu ko nɛ benɛ e maa hia blɔ kɛ ho ma kpa ko nɔ ya a, e tsɛ e sɔmɔli nɛ e ha mɛ ni tsumi sika nɛ a kɛ tsu ni ngɛ e se.<verse eid="MAT 25:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 25:15" />E ha nɔ kake sidi akpe enuɔ, nɔ kake hu sidi akpe enyɔ, nɛ nɔ kake hu sidi akpe, bɔ nɛ nɔ tsuaa nɔ ma nyɛ kɛ tsu ni loko ji e hia blɔ. <verse eid="MAT 25:15" /><verse number="16" style="v" sid="MAT 25:16" />Nɔ nɛ na sidi akpe enuɔ ɔ ho nɛ e ya bɔni jua yemi, nɛ amlɔ ɔ nɔuu ɔ, e na se sidi akpe enuɔ kɛ piɛ sika tso ɔ he. <verse eid="MAT 25:16" /><verse number="17" style="v" sid="MAT 25:17" />Ja a nɔuu nɛ nɔ nɛ na sidi akpe enyɔ ɔ hu ya na se sidi akpe enyɔ.<verse eid="MAT 25:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 25:18" />Se nɔ nɛ na sidi akpe ɔ ho ya tsua si nɛ e to sika a ngɛ mi.<verse eid="MAT 25:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 25:19" />E ngɛ mi hluu ɔ, a nutsɔ ɔ ba, nɛ e kɛ mɛ ba bu akɔtaa. <verse eid="MAT 25:19" /><verse number="20" style="v" sid="MAT 25:20" />Nɔ nɛ e ha lɛ sidi akpe enuɔ ɔ, e kɛ sidi akpe nyɔngma ba nɛ e ba de lɛ ke, ‘Nutsɔ, o kɛ sidi akpe enuɔ ha mi; o nɛ, i na se sidi akpe enuɔ ngɔ piɛ he.’<verse eid="MAT 25:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 25:21" />E nutsɔ ɔ je e yi ngɛ ni tsumi kpakpa nɛ e tsu ɔ he nɛ e de ke, ‘O ye anɔkuale ngɛ sika bɔɔ nɛ ɔ he, ma ha o pee nihi fuu a nyatsɛ. Ba sɛ o nutsɔ ɔ bua jɔmi ɔ mi.’<verse eid="MAT 25:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 25:22" />Nɛ nɔ nɛ na sidi akpe enyɔ ɔ hu ba nɛ e ba de ke, ‘Nutsɔ, o ha mi sidi akpe enyɔ ke ma kɛ tsu ni; o nɛ, i na se sidi akpe enyɔ ngɔ piɛ he.’<verse eid="MAT 25:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 25:23" />E nutsɔ ɔ de le ke, ‘Ayekoo, Sɔmɔlɔ kpakpa kɛ anɔkualetsɛ; o ye anɔkuale ngɛ sika bɔɔ nɛ ɔ he, ma ha o ye níhi fuu a nɔ. Ba sɛ o nutsɔ ɔ bua jɔmi ɔ mi.’<verse eid="MAT 25:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 25:24" />Kɛkɛ nɛ nɔ nɛ na sidi akpe ɔ hu ba nɛ e ba de lɛ ke, ‘Nutsɔ, i le kaa yi walɔ ji mo; nɛ o kpaa ni ngɛ he nɛ o du we nɔ ko ngɛ; nɛ o buaa níhi a nya ngɛ he nɛ o fia we nɔ́ ko ngɛ; <verse eid="MAT 25:24" /><verse number="25" style="v" sid="MAT 25:25" />enɛ ɔ ha i ye gbeye nɛ i ho ya pu o sika a; o nɛ o ni.’<verse eid="MAT 25:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 25:26" />E nutsɔ ɔ he nɔ nɛ e de lɛ ke, ‘Sɔmɔlɔ yaya kɛ hejɔtsɛ ji mo; akɛnɛ o le kaa i kpaa ni ngɛ he nɛ i du we nɔ́ ko ngɛ, nɛ i buaa níhi a nya ngɛ he nɛ i fia we nɔ́ ko ngɛ ɔ, <verse eid="MAT 25:26" /><verse number="27" style="v" sid="MAT 25:27" />jinɛ nɔ́ nɛ sa mo peemi ji kaa o ngɔɔ ye sika a ya toɔ ngɛ sika tomi he ɔ konɛ ma na he kpa. <verse eid="MAT 25:27" /><verse number="28" style="v" sid="MAT 25:28" />Nyɛ he sika a ngɛ e dɛ nɛ nyɛ kɛ ha nɔ nɛ hɛɛ sidi akpe nyɔngma a. <verse eid="MAT 25:28" /><verse number="29" style="v" sid="MAT 25:29" />Ejakaa nɔ nɛ baa nɔ́ ko nɛ a ha lɛ yi saminya a, a maa ngɔ eko kɛ piɛ he ha lɛ konɛ e na kɛ be nɔ, se nɔ nɛ yi anɔkuale ɔ, a ma kpɔ bɔɔ nɛ e ngɛ ɔ tete ngɛ e dɛ. <verse eid="MAT 25:29" /><verse number="30" style="v" sid="MAT 25:30" />Nɛ sɔmɔlɔ nɛ ɔ nɛ he be se nami ɔ, nyɛ sake lɛ ngɔ fɔ blɔ se diblii ɔ mi, lejɛ ɔ ya fomi kɛ lungu nya kpemi maa hi.’<verse eid="MAT 25:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 25:31" />Benɛ Nɔmlɔ Bi ɔ maa ba ngɛ e anunyami ɔ mi, nɛ bɔfo ɔmɛ tsuo maa piɛ e he ɔ, jamɛ a be ɔ mi ɔ, e maa hi e anunyami sɛ ɔ nɔ. <verse eid="MAT 25:31" /><verse number="32" style="v" sid="MAT 25:32" />Nɛ e ma bua je ɔ tsuo nya ngɛ e hɛ mi nɛ e ma gba a mi kaa bɔ nɛ to kpakalɔ gbaa jijɔhi kɛ apletsihi a mi ɔ. <verse eid="MAT 25:32" /><verse number="33" style="v" sid="MAT 25:33" />E maa ngɔ jijɔ ɔmɛ kɛ to e hiɔ nine nɔ, kɛ apletsi ɔmɛ ngɛ e muɔ nɔ.<verse eid="MAT 25:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 25:34" />Nɛ matsɛ ɔ ma de nihi nɛ ngɛ e hiɔ nɔ ɔ ke, ‘Nyɛɛ ba, nyɛ nihi nɛ ye Tsɛ jɔɔ nyɛ ɔ, nyɛ ba sɛ Matsɛyemi ɔ mi, he nɛ a dla kɛ to nyɛ kɛ je je ɔ sisije ɔ. <verse eid="MAT 25:34" /><verse number="35" style="v" sid="MAT 25:35" />Ejakaa hwɔ ngɛ mi yee nɛ nyɛ ha mi ni nɛ i ye; kuma ngɛ mi yee nɛ nyɛ ha mi nyu nɛ i nu; nubwɔ ji mi nɛ nyɛ ha nɛ i ba to nyɛ ngɔ; <verse eid="MAT 25:35" /><verse number="36" style="v" sid="MAT 25:36" />i hɛɛ ye he gu nɛ nyɛ wo mi tade; i be he wami nɛ nyɛ ba slaa mi; a wo mi tsu mi nɛ nyɛ ba bi ye si.’<verse eid="MAT 25:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="MAT 25:37" />Nɛ dali nɛ ɔmɛ ma bi ke, ‘Nutsɔ, te be nɛ wa na mo nɛ hwɔ ngɛ mo yee nɛ wa ha mo niye ni nɛɛ? Aloo kuma ngɛ mo yee nɛ wa ha mo nyu nɛɛ? <verse eid="MAT 25:37" /><verse number="38" style="v" sid="MAT 25:38" />Nɛ te be nɛ wa na mo kaa nubwɔ ji mo, nɛ wa ye kɛ bua mo nɛɛ? Aloo o hɛɛ o he gu nɛ wa wo mo tade nɛɛ? <verse eid="MAT 25:38" /><verse number="39" style="v" sid="MAT 25:39" />Nɛ te be nɛ wa na mo nɛ o ngɛ hiɔ nue aloo a wo mo tsu mi nɛ wa ba slaa mo nɛɛ?’<verse eid="MAT 25:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="MAT 25:40" />Nɛ matsɛ ɔ ma de mɛ ke, ‘Anɔkuale, be abɔ nɛ nyɛ pee kɛ ha ye nyɛmimɛ nɛ ɔmɛ a ti nɔ nyafii kake ɔ, ami nɔuu nyɛ pee kɛ ha a nɛ.’ <verse eid="MAT 25:40" /><verse number="41" style="v" sid="MAT 25:41" />Kɛkɛ ɔ, e ma de ni nɛmɛ nɛ ngɛ e muɔ nɔ ɔ hu ke, ‘Nyɛɛ je ye nɔ kɛ ya se, nyɛ nihi nɛ a gbiɛ nyɛ, nyɛɛ ya neneene la a nɛ a dla kɛ to Abosiami kɛ e bɔfo ɔmɛ ɔ mi. <verse eid="MAT 25:41" /><verse number="42" style="v" sid="MAT 25:42" />Ejakaa hwɔ ngɛ mi yee nɛ nyɛ ha we mi ni ma ye; kuma ngɛ mi yee nɛ nyɛ ha we mi nyu ma nu; <verse eid="MAT 25:42" /><verse number="43" style="v" sid="MAT 25:43" />nubwɔ ji mi nɛ nyɛ ha we mi he ko nɛ ma to; i hɛɛ ye he gu nɛ nyɛ wui mi tade; i be he wami, nɛ a wo mi tsu mi, se nyɛ ba slaa we mi.’<verse eid="MAT 25:43" /></para>
  <para style="p">
    <verse number="44" style="v" sid="MAT 25:44" />Nɛ mɛ hu a ma he nɔ ke, ‘Nutsɔ, te be nɛ wa na mo kaa hwɔ ngɛ mo yee aloo kuma ngɛ mo yee aloo nubwɔ ji mo aloo o hɛɛ o he gu aloo o ngɛ hiɔ nue aloo a wo mo tsu mi nɛ wa yi kɛ bua we mo nɛɛ?’<verse eid="MAT 25:44" /></para>
  <para style="p">
    <verse number="45" style="v" sid="MAT 25:45" />Nɛ matsɛ ɔ ma he nɔ ke, ‘Anɔkuale, i ngɛ nyɛ dee ke, si abɔ nɛ nyɛ yi kɛ bua we ye nyɛmimɛ nɛ ɔmɛ a ti nɔ nyafii kake ɔ, ami nɔuu nɛ nyɛ yi kɛ bua we ɔ nɛ.’<verse eid="MAT 25:45" /></para>
  <para style="p">
    <verse number="46" style="v" sid="MAT 25:46" />Nɛ a maa ya neneene tue gblami mi, se dali ɔmɛ lɛɛ a maa ya neneene wami mi.”<verse eid="MAT 25:46" /></para>
  <chapter eid="MAT 25" />
  <chapter number="26" style="c" sid="MAT 26" />
  <para style="s1">Yesu se biɔ tsɔɔmi</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 26:1" />Benɛ Yesu tu e kaseli ɔmɛ munyu nɛ ɔ gbe nya a, e de mɛ ke,<verse eid="MAT 26:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="MAT 26:2" />“Kaa bɔ nɛ nyɛ le ɔ, e piɛ ligbi enyɔ pɛ nɛ a maa ye Hebemi Kaimi Ligbi ɔ, nɛ a ma je Nɔmlɔ Bi ɔ he gbi kɛ ha nɛ a sɛu lɛ.”<verse eid="MAT 26:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 26:3" />Jamɛ a be ɔ mi ɔ, osɔfo nikɔtɔma amɛ kɛ Yuda mlaa tsɔɔli ɔmɛ ya bua a he nya ngɛ Kaiafa, osɔfo nɔkɔtɔma a we ɔ mi, <verse eid="MAT 26:3" /><verse number="4" style="v" sid="MAT 26:4" />nɛ a ya hla blɔ nɔ nɛ a maa gu kɛ nu Yesu ngɛ ga mi nɛ a gbe lɛ. <verse eid="MAT 26:4" /><verse number="5" style="v" sid="MAT 26:5" />Se a ma nya si kaa, “Tsa pi ngɛ Hebemi Ligbi ɔ nɔ, ejakaa gidigidi maa ba ma a mi.”<verse eid="MAT 26:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 26:6" />Nɛ Yesu pue nɔ kɛ ho Betania ya, nɛ e ya to Simon, kpititsɛ ɔ we mi. <verse eid="MAT 26:6" /><verse number="7" style="v" sid="MAT 26:7" />Se benɛ e hii si ngɛ ni yee ɔ, yo ko hɛɛ tɔ kɛ e mi nu je via nɛ he jua wa saminya kɛ ba e ngɔ nɛ e ba plɛ ngɔ pue e yi kpɛti.<verse eid="MAT 26:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 26:8" />Se benɛ e kaseli ɔmɛ na a, a mi mi fu nɛ a de ke, “Mɛni yaka sika puɛmi ji nɛ ɔ? <verse eid="MAT 26:8" /><verse number="9" style="v" sid="MAT 26:9" />Jinɛ e sa kaa a jua nu je via nɛ ɔ sika fuu nɛ a ngɔ kɛ ha ohiafohi.”<verse eid="MAT 26:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 26:10" />Se benɛ Yesu na a juɛmi ɔ, e de mɛ ke, “Mɛni he je nyɛ ngɛ yo nɛ ɔ haoe? Ejakaa e tsu ni kpakpa ha mi. <verse eid="MAT 26:10" /><verse number="11" style="v" sid="MAT 26:11" />Nyɛɛ kɛ ohiafo ɔmɛ nɛ ngɛ daa, se ami lɛɛ tsa pi daa nɛ i kɛ nyɛ maa hi si. <verse eid="MAT 26:11" /><verse number="12" style="v" sid="MAT 26:12" />E plɛ nu je via nɛ ɔ ngɔ pue ye nɔ kɛ to ye nɔmlɔ tso ɔ dlami kɛ pumi. <verse eid="MAT 26:12" /><verse number="13" style="v" sid="MAT 26:13" />Niinɛ, i ngɛ nyɛ dee ke, he fɛɛ he nɛ a maa fiɛ Manye Munyu ɔ ngɛ, ngɛ je mi tsuo ɔ, a maa wo nɔ nɛ e pee nɛ ɔ ta kɛ kai lɛ.”<verse eid="MAT 26:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 26:14" />Kɛkɛ nɛ Yuda Iskariot, kaseli ɔmɛ a ti nɔ kake je kɛ ho osɔfo nikɔtɔma amɛ a ngɔ ya, <verse eid="MAT 26:14" /><verse number="15" style="v" sid="MAT 26:15" />nɛ e ya bi mɛ ke, “Mɛni nyɛ ma ha mi nɛ ma je Yesu kɛ wo nyɛ dɛ mi?” Nɛ a kane sika sidi nyingmi etɛ ngɔ ha lɛ. <verse eid="MAT 26:15" /><verse number="16" style="v" sid="MAT 26:16" />Nɛ kɛ je jamɛ a be ɔ mi ɔ, Yuda Iskariot bɔni blɔ nɔ nɛ e maa gu kɛ tsɔɔ Yesu se blɔ hlami.<verse eid="MAT 26:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 26:17" />Benɛ Hebemi be ɔ kekle ligbi ɔ su ɔ, kaseli ɔmɛ ba Yesu ngɔ ba bi lɛ ke, “Jije o suɔ kaa wa ya dla kɛ ha Hebemi ɔ yemi?”<verse eid="MAT 26:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 26:18" />Nɛ e he nɔ de mɛ ke, “Nyɛɛ ya ma a mi nɛ nyɛ ya de asimasi ke, ‘Wa Nutsɔ ɔ ke, ye be su ta, nɛ i kɛ ye kaseli ɔmɛ ma ba ye Hebemi ɔ ngɛ o we ɔ mi.’ ” <verse eid="MAT 26:18" /><verse number="19" style="v" sid="MAT 26:19" />Nɛ kaseli ɔmɛ ya pee bɔ nɛ Yesu de mɛ ɔ, nɛ a ya dla Hebemi niye ni ɔ ngɔ to.<verse eid="MAT 26:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 26:20" />Jamɛ a ligbi ɔ gbɔkuɛ ɔ, e kɛ e kaseli nyɔngma kɛ enyɔ ɔ ya hi si ngɛ niye ni ɔ he. <verse eid="MAT 26:20" /><verse number="21" style="v" sid="MAT 26:21" />Benɛ a ngɛ ni ɔ yee ɔ, e de mɛ ke, “Nyɛ ti nɔ kake maa tsɔɔ ye se blɔ.”<verse eid="MAT 26:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 26:22" />Kɛkɛ nɛ kaseli ɔmɛ a ni pee mɔbɔmɔbɔ, nɛ a bɔni lɛ bimi kakaaka ke, “Nutsɔ, ami i lo?”<verse eid="MAT 26:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 26:23" />E he nɔ de mɛ ke, “Nɔ nɛ nine kɛ ye nine kpe ngɛ ka a mi ɔ, lɛ ji nɔ nɛ maa tsɔɔ ye se blɔ. <verse eid="MAT 26:23" /><verse number="24" style="v" sid="MAT 26:24" />Nɔmlɔ Bi ɔ ma gbo kaa bɔ nɛ a ngma ngɛ e he ɔ mohu se due ha nɔmlɔ nɛ maa tsɔɔ e se blɔ ɔ, afani nɛ a fɔ we jamɛ a nɔmlɔ ɔ.”<verse eid="MAT 26:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 26:25" />Kɛkɛ nɛ Yuda hu bi lɛ ke, “Nutsɔ, ami i lo?” Yesu he nɔ de lɛ ke, “Ee, mo i!”<verse eid="MAT 26:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 26:26" />Benɛ a ngɛ ni ɔ yee ɔ, Yesu wo abolo nyafii ko nɛ e gbaa nɔ, nɛ e ku mi, nɛ e ngɔ ha e kaseli ɔmɛ nɛ e de ke, “Nyɛ he nɛ nyɛɛ ye, ejakaa enɛ ɔ ji ye Nɔmlɔ tso ɔ nɛ.”<verse eid="MAT 26:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 26:27" />E wo wai kplu ɔ, nɛ e na si, nɛ e ngɔ ha mɛ nɛ e de mɛ ke, “Nyɛ ti nɔ tsuaa nɔ nɛ nu eko, <verse eid="MAT 26:27" /><verse number="28" style="v" sid="MAT 26:28" />ejakaa enɛ ɔ ji ye muɔ nɛ ji Somi He ɔ nɔ́ ɔ nɛ a po kɛ pue si kɛ ha nihi fuu a he yayami kemi. <verse eid="MAT 26:28" /><verse number="29" style="v" sid="MAT 26:29" />Anɔkuale, i ngɛ nyɛ dee ke, i be wai nɛ ɔ eko nue hu kɛ ya si be nɛ i kɛ nyɛ maa nu lɛ ehe ngɛ ye Tsɛ Matsɛyemi ɔ mi.”<verse eid="MAT 26:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="MAT 26:30" />Nɛ benɛ a la yi jemi la a, a pue nɔ kɛ ho Nuyoku ɔ nɔ ya.<verse eid="MAT 26:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 26:31" />Kɛkɛ nɛ Yesu de mɛ ke, “Nyɔ nɛ ɔ mi ɔ, nyɛ tsuo nyɛ ma si ami nɔ kake, ejakaa a ngma ngɛ Ngmami Klɔuklɔu ɔ mi ke, ‘Mawu maa fia to hyɛlɔ ɔ nɔ nɛ to asafo ɔ tsuo maa gbɛ fia.’ <verse eid="MAT 26:31" /><verse number="32" style="v" sid="MAT 26:32" />Se ye si temi ɔ se ɔ, i ma sɛ nyɛ hlami kɛ ya Galilea nɛ i kɛ nyɛ ma ya kpe ngɛ lejɛ ɔ.”<verse eid="MAT 26:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 26:33" />Petro de lɛ ke, “Ke nɔ tsuaa nɔ kpale ngɛ o se ɔ, ami lɛɛ i be kpalee gblee.”<verse eid="MAT 26:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 26:34" />Nɛ Yesu de lɛ ke, “Anɔkuale, i ngɛ mo dee ke, nyɔ nɛ ɔ mi nɔuu, loko ji kungwɔ ma kpa nɔ ɔ, o ma kua mi si etɛ.”<verse eid="MAT 26:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="MAT 26:35" />Se Petro ma nɔ mi nɛ e de ke, “Ke i kɛ mo ma gbo tete po ɔ, i be kpalee ngɛ o se.” Nɛ kaseli kpa amɛ hu de ja a nɔuu.<verse eid="MAT 26:35" /></para>
  <para style="s1">Yesu ya sɔle ngɛ Getsemane</para>
  <para style="p">
    <verse number="36" style="v" sid="MAT 26:36" />Jehanɛ ɔ, Yesu kɛ mɛ ba abɔɔ ko nɛ a tsɛɛ ke Getsemane ɔ mi nɛ e de mɛ ke, “Nyɛɛ hi si ngɛ hiɛ ɔ, i yaa nɛ ma ya sɔle.” <verse eid="MAT 26:36" /><verse number="37" style="v" sid="MAT 26:37" />Nɛ e wo Petro kɛ Zebedeo bimɛ nyumuhi enyɔ, Yakobo kɛ Yohane ɔ ngɔ piɛ e he kɛkɛ nɛ aywilɛho nu lɛ nɛ e hao.<verse eid="MAT 26:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="MAT 26:38" />Nɛ e de mɛ ke, “Ye klaa ngɛ haoe ngɛ ye mi kɛ yaa su gbenɔ mi; nyɛɛ hi si ngɛ hiɛ ɔ nɛ nyɛɛ kɛ mi nɛ fɔ nyɔ.”<verse eid="MAT 26:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="MAT 26:39" />E nyɛɛ kɛ ya e hɛ mi bɔɔ nɛ e ya ngɔ e hɛ mi ngɔ bu si, nɛ e sɔle nɛ e de ke, “Ye Tsɛ, ke e maa hi ɔ, mo ha nɛ a wo kikɛmɛ a kplu nɛ ɔ ngɛ ye nɔ kɛ ho, se mohu pi bɔ nɛ i suɔ, se bɔ nɛ mo o suɔ.”<verse eid="MAT 26:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="MAT 26:40" />Benɛ e kpale kɛ ba e kaseli ɔmɛ a ngɔ ɔ, e ba na kaa a hwɔ mahe, nɛ e tsɛ Petro nɛ e de lɛ ke, “Anɛ nyɛ be nyɛe nɛ nyɛɛ kɛ mi maa fɔ nyɔ ngmlɛfia kake pɛ lo? <verse eid="MAT 26:40" /><verse number="41" style="v" sid="MAT 26:41" />Nyɛɛ fɔ nyɔ nɛ nyɛɛ sɔle konɛ ka nɛ ko ye nyɛ nɔ, ejakaa mumi ɔ ngɛ kplɛɛe mohu, se nɔmlɔ tso ɔ gbɔjɔ.”<verse eid="MAT 26:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="MAT 26:42" />E si mɛ ekohu nɛ e ho ya sɔle nɛ e de ke, “Ye Tsɛ, ke kplu nɛ ɔ be hiɛ jemi kɛ je ye nɔ kaa ja i nu doo ɔ, a pee bɔ nɛ o suɔ.”<verse eid="MAT 26:42" /></para>
  <para style="p">
    <verse number="43" style="v" sid="MAT 26:43" />Benɛ e kpale kɛ ba a ngɔ ɔ, e ba na kaa a hwɔ mahe ekohu, ejakaa nyɔ gbe mɛ. <verse eid="MAT 26:43" /><verse number="44" style="v" sid="MAT 26:44" />Lɔ ɔ he je ɔ, e si mɛ ekohu nɛ e ho ya sɔle nɔ nɛ ji si etɛ, nɛ e tu jamɛ a munyu ɔ nɔuu.<verse eid="MAT 26:44" /></para>
  <para style="p">
    <verse number="45" style="v" sid="MAT 26:45" />Jehanɛ ɔ benɛ e kpale kɛ ba e kaseli ɔmɛ a ngɔ ɔ, e bi mɛ ke, “Anɛ nyɛɛ lɛɛ nyɛ he mi jɔ nyɛ nɛ nyɛ ngɛ mahe hwɔe lo? Ngmlɛfia a su nɛ a ma je Nɔmlɔ Bi ɔ kɛ wo yayami peeli a dɛ mi. <verse eid="MAT 26:45" /><verse number="46" style="v" sid="MAT 26:46" />Nyɛɛ te si nɛ waa ho! Nyɛɛ hyɛ, nɔ nɛ maa tsɔɔ ye se blɔ ɔ nɛ ma a nɛ!”<verse eid="MAT 26:46" /></para>
  <para style="p">
    <verse number="47" style="v" sid="MAT 26:47" />Yesu nya nɔɛ si nɛ Yuda nɛ ji e kaseli nyɔngma kɛ enyɔ ɔmɛ a kpɛti nɔ kake ɔ ba su si kɛ nihi babauu nɛ je osɔfo nikɔtɔma amɛ kɛ ma mi nikɔtɔma amɛ a ngɔ ɔ piɛ e he, nɛ a hɛɛ klaate kɛ tso kpotihi. <verse eid="MAT 26:47" /><verse number="48" style="v" sid="MAT 26:48" />Nɛ Yuda, nɔ nɛ ngɛ e se blɔ tsɔɔe ɔ to mɛ okadi kaa a nu nɔ nɛ e ma nga a, ejakaa lɛ ji nɔ nɛ a ngɛ hlae ɔ nɛ. <verse eid="MAT 26:48" /><verse number="49" style="v" sid="MAT 26:49" />Kɛkɛ nɛ Yuda ba Yesu ngɔ tɛɛ ba de lɛ ke, “Nutsɔ, mo he manye!” Nɛ e fua lɛ atuu kaa nɔ kɛ e huɛ.<verse eid="MAT 26:49" /></para>
  <para style="p">
    <verse number="50" style="v" sid="MAT 26:50" />Se Yesu de lɛ ke, “Ye huɛ, yaa o hɛ mi nɛ o pee nɔ́ nɛ o ma peemi ɔ.” Kɛkɛ nɛ ni ɔmɛ ba tua lɛ nɛ a nu lɛ.<verse eid="MAT 26:50" /></para>
  <para style="p">
    <verse number="51" style="v" sid="MAT 26:51" />Nɛ nihi nɛ kɛ Yesu nyɛɛ ɔ a ti nɔ kake hia klaate nɛ e ja Osɔfo Nɔkɔtɔma a tsɔlɔ ɔ tue nɛ e je nya.<verse eid="MAT 26:51" /></para>
  <para style="p">
    <verse number="52" style="v" sid="MAT 26:52" />Nɛ Yesu de lɛ ke, “Moo ngɔ o klaate ɔ kɛ to e to he ɔ, ejakaa ni nɛmɛ nɛ hiaa klaate ɔ, klaate nya nɔuu nɛ a ma gbo ngɛ. <verse eid="MAT 26:52" /><verse number="53" style="v" sid="MAT 26:53" />Anɛ o susu kaa i be nyɛe ma bi ye Tsɛ nɛ amlɔ nɛ ɔ nɔuu e ma ha mi hiɔwe bɔfohi akpe abɔ nɛ a ba fa ye he? <verse eid="MAT 26:53" /><verse number="54" style="v" sid="MAT 26:54" />Se ke i pee ja a, kɛ maa pee kɛɛ nɛ Ngmami ɔmɛ maa ba mi kɛɛ, kaa ja a pee kikɛ ɔ nɔuu?” <verse eid="MAT 26:54" /><verse number="55" style="v" sid="MAT 26:55" />Kɛkɛ nɛ Yesu de ni ɔmɛ ke, “Anɛ nɔmlɔ awi yelɔ ko ji mi nɛ nyɛ ba mi numi kɛ nyɛ dɛ klaate kɛ tso kpotihi nɛ ɔ lo? I kɛ nyɛ hi Sɔlemi We ɔ nɛ i tsɔɔ nyɛ ni daa, nɛ nyɛ nui mi. <verse eid="MAT 26:55" /><verse number="56" style="v" sid="MAT 26:56" />Se a pee enɛ ɔ tsuo konɛ nihi nɛ gbali ɔmɛ ngma a nɛ ba mi.” Kɛkɛ nɛ kaseli ɔmɛ tsuo tu fo kɛ si lɛ.<verse eid="MAT 26:56" /></para>
  <para style="p">
    <verse number="57" style="v" sid="MAT 26:57" />Nɛ ni nɛmɛ nɛ ba nu Yesu ɔ kpaka lɛ kɛ ho Kaiafa nɛ ji Osɔfo Nɔkɔtɔma a we ɔ mi ya, he nɛ Yuda mlaa tsɔɔli ɔmɛ kɛ nikɔtɔma amɛ bua a he nya ngɛ ɔ. <verse eid="MAT 26:57" /><verse number="58" style="v" sid="MAT 26:58" />Jamɛ a be ɔ mi ɔ, Petro nyɛɛ e se ngɛ lokoo kɛ ba Osɔfo Nɔkɔtɔma a we ɔ mi, nɛ e ya sɛ lejɛ ɔ nɛ e kɛ soja amɛ ya hii si ngɛ kpo ɔ nɔ konɛ e na nɔ nɛ maa ba Yesu nɔ.<verse eid="MAT 26:58" /></para>
  <para style="p">
    <verse number="59" style="v" sid="MAT 26:59" />Osɔfo nikɔtɔma amɛ kɛ Yuda kojoli ɔmɛ tsuo ya bua a he nya ngɛ a kojomi he ngua pe kulaa a, nɛ a hla nihi nɛ a ba ye nyangɔ odase ngɛ Yesu he konɛ a na nɔ ko nɔ nɛ a da nɛ a bu lɛ gbenɔ fɔ. <verse eid="MAT 26:59" /><verse number="60" style="v" sid="MAT 26:60" />Nɛ e ngɛ mi kaa a na lakpa odase yeli fuu mohu, se a odase yemi ɔmɛ dɛ tɛ kake nɔ. Nyagbe ɔ, lakpa odase yeli enyɔ ba, <verse eid="MAT 26:60" /><verse number="61" style="v" sid="MAT 26:61" />nɛ a ba de ke, “Nyumu nɛ ɔ de ke, ‘Ma nyɛ Mawu Sɔlemi We ɔ ma hule nɛ ma kpale ma lɛ ligbi etɛ.’ ”<verse eid="MAT 26:61" /></para>
  <para style="p">
    <verse number="62" style="v" sid="MAT 26:62" />Kɛkɛ nɛ Osɔfo Nɔkɔtɔma a te si da si nɛ e bi Yesu ke, “Saminya! O be nu nɔ nɛ a ngɛ dee ɔ? Anɛ o de ja a loo o de we?” <verse eid="MAT 26:62" /><verse number="63" style="v" sid="MAT 26:63" />Se Yesu pɛ e nya mi. Nɛ Osɔfo Nɔkɔtɔma a de lɛ ke, “I ngɛ mo bie ngɛ Mawu hɛ kalɔ ɔ biɛ mi kaa ke mo ji Kristo, Mawu Bi ɔ, o de wɔ.”<verse eid="MAT 26:63" /></para>
  <para style="p">
    <verse number="64" style="v" sid="MAT 26:64" />Nɛ Yesu he nɔ ke, “Ee, bɔ nɛ o de ɔ, ja i. Se i ngɛ nyɛ dee ke, kɛ je be nɛ ɔ mi kɛ yaa a, nyɛ maa na Nɔmlɔ Bi ɔ nɛ hii si ngɛ Mawu hiɔ nine nɔ, nɛ e ma ngɛ hiɔwe bɔ kuu ɔmɛ a mi.”<verse eid="MAT 26:64" /></para>
  <para style="p">
    <verse number="65" style="v" sid="MAT 26:65" />Kɛkɛ Osɔfo Nɔkɔtɔma a gba lɛ nitsɛ e tade, nɛ e de kɛ ngmlaa ke, “E bɔ musu! Mɛni odase yeli kpahi wa pa ngɛ hlae ekohu? Nyɛ tsuo nyɛ nu nɔ nɛ e de ɔ paa. <verse eid="MAT 26:65" /><verse number="66" style="v" sid="MAT 26:66" />Kɛ nyɛ susu kɛɛ?” A he nɔ kɛ ngmlaa ke, “E sa gbenɔ! E sa gbenɔ!”<verse eid="MAT 26:66" /></para>
  <para style="p">
    <verse number="67" style="v" sid="MAT 26:67" />Kɛkɛ nɛ a la lada ngɔ pue e hɛ mi, nɛ a fiaa lɛ ni. Ni komɛ hu gba lɛ ma, <verse eid="MAT 26:67" /><verse number="68" style="v" sid="MAT 26:68" />nɛ a de lɛ ke, “Kristo, gbaa o tsɔɔ wɔ. Mɛnɔ ji nɔ nɛ gba mo ma a?”<verse eid="MAT 26:68" /></para>
  <para style="s1">Petro kua Yesu</para>
  <para style="p">
    <verse number="69" style="v" sid="MAT 26:69" />Jamɛ a be ɔ mi ɔ, Petro hii si ngɛ se lokoo ngɛ kpo ɔ nɔ, nɛ sɔmɔlɔ yo ko ba e ngɔ ba bi lɛ ke, “Tsɛ mo hu o kɛ Yesu nɛ ngɛ, ejakaa nyɛ tsuo nyɛ je Galilea?”<verse eid="MAT 26:69" /></para>
  <para style="p">
    <verse number="70" style="v" sid="MAT 26:70" />Se Petro kua ngɛ mɛ tsuo a hɛ mi, nɛ e de kɛ ngmlaa ke, “I li nɔ nɛ o ngɛ dee nɛ ɔ tete!”<verse eid="MAT 26:70" /></para>
  <para style="p">
    <verse number="71" style="v" sid="MAT 26:71" />Pee se benɛ e je kpo kɛ ho agbo ɔ se ya a, sɔmɔlɔ yo kpa ko hu na lɛ, nɛ e de nihi nɛ e kɛ mɛ daa si ɔ ke, “Nyumu nɛ ɔ, e kɛ Yesu Nazaret no ɔ nɛ ngɛ.”<verse eid="MAT 26:71" /></para>
  <para style="p">
    <verse number="72" style="v" sid="MAT 26:72" />Se Petro kua ekohu, nɛ e kɛ kita kami de ke, “I li nɔmlɔ nɛ ɔ tete!”<verse eid="MAT 26:72" /></para>
  <para style="p">
    <verse number="73" style="v" sid="MAT 26:73" />Pee se bɔɔ ɔ, nihi nɛ daa si ngɛ lejɛ ɔ ba e ngɔ nɛ a ba de lɛ ke, “Wa le kaa e kaseli ɔmɛ a ti nɔ kake ji mo, ejakaa o munyu tumi tete ngɛ mo si jee kaa Galilea no.”<verse eid="MAT 26:73" /></para>
  <para style="p">
    <verse number="74" style="v" sid="MAT 26:74" />Kɛkɛ nɛ Petro bɔni gbiɛmi kɛ kita kami nɛ e de ke, “I li kikɛmɛ a Nɔmlɔ nɛ ɔ.” Nɛ kungwɔ kpa nɔ amlɔ ɔ nɔuu. <verse eid="MAT 26:74" /><verse number="75" style="v" sid="MAT 26:75" />Nɛ Petro kai nɔ nɛ Yesu de lɛ ɔ, “Loko ji kungwɔ ma kpa nɔ ɔ, o ma kua mi si etɛ.” Nɛ e je kpo ya fo ya wawɛɛ.<verse eid="MAT 26:75" /></para>
  <chapter eid="MAT 26" />
  <chapter number="27" style="c" sid="MAT 27" />
  <para style="s1">Yesu kojomi ke e sɛumi</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 27:1" />Benɛ je na a, osɔfo nikɔtɔma amɛ kɛ ma mi nikɔtɔma amɛ kpe yi ekohu nɛ a susu bɔ nɛ a maa pee kɛ gbe Yesu he. <verse eid="MAT 27:1" /><verse number="2" style="v" sid="MAT 27:2" />Nɛ a wo lɛ kɔsɔkɔsɔ nɛ a kpaka lɛ kɛ ho Pilato nɛ ji Roma amlaalo ɔ ngɔ ya.<verse eid="MAT 27:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 27:3" />Jamɛ a be ɔ mi, benɛ Yuda, nɔ nɛ tsɔɔ Yesu se blɔ ɔ na kaa a bu lɛ gbenɔ fɔ ɔ, e juɛmi plɛ nɛ e pia e he, nɛ e kpale sika a ya ha osɔfo nikɔtɔma amɛ kɛ ma mi nikɔtɔma amɛ ekohu.<verse eid="MAT 27:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 27:4" />Nɛ e de mɛ ke, “I pee yayami, ejakaa i tsɔɔ Nɔmlɔ nɛ yayami ko be e he ɔ se blɔ.” Se mɛ hu a de lɛ ke, “Enɛ ɔ pi wa kɔmɔ, mo nitsɛ o sane i.”<verse eid="MAT 27:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 27:5" />Kɛkɛ nɛ e sake sika a ngɔ pue si ngɛ Sɔlemi We ɔ nɛ e je kɛ ho nɛ e ya wo e kuɛ kpa. <verse eid="MAT 27:5" /><verse number="6" style="v" sid="MAT 27:6" />Osɔfo nikɔtɔma amɛ kukuɔ sika a nɛ a de ke, “E sɛ ngɛ wa mlaa a nya kaa waa kɛ sika nɛ ɔ nɛ piɛ onia sika a he, ejakaa muɔ sika i.”<verse eid="MAT 27:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 27:7" />A susu he hluu nɛ nyagbe mi ɔ, a ma nya si kaa a ma wo kɛ he buɛ puɛlɔ ɔ abɔɔ ɔ nɛ a pu nibwɔhi nɛ ma gbo ngɛ Yerusalem ɔ ngɛ lejɛ ɔ. <verse eid="MAT 27:7" /><verse number="8" style="v" sid="MAT 27:8" />Enɛ ɔ he je nɛ a tsɛɛ jamɛ a abɔɔ ɔ ke, “Muɔ Abɔɔ” kɛ ba si mwɔnɛ ɔ nɛ.<verse eid="MAT 27:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 27:9" />Enɛ ɔ ha Gbalɔ Yeremia munyu ɔ ba mi ke, “Nɛ a ngɔ sika hiɔ yi nyingmi etɛ ɔ nɛ ji e yi jua nɛ Israel bi ɔmɛ wo ɔ, <verse eid="MAT 27:9" /><verse number="10" style="v" sid="MAT 27:10" />nɛ a kɛ ya he buɛ puɛlɔ ɔ abɔɔ ɔ kaa bɔ nɛ Nutsɔ ɔ fa mi ɔ.”<verse eid="MAT 27:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 27:11" />Jamɛ a be ɔ mi ɔ, Yesu daa si ngɛ Pilato nɛ ji Roma amlaalo ɔ hɛ mi, nɛ amlaalo ɔ bi lɛ ke, “Anɛ mo ji Yuda bi ɔmɛ a matsɛ ɔ lo?” Nɛ Yesu de lɛ ke, “Ee, bɔ nɛ ɔ de ɔ, ja i.”<verse eid="MAT 27:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 27:12" />Se benɛ osɔfo nikɔtɔma amɛ kɛ ma mi nikɔtɔma amɛ ngɛ e nya poe ɔ, e pɛ e nya mi.<verse eid="MAT 27:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 27:13" />Enɛ ɔ he je ɔ, Pilato bi lɛ ke, “Anɛ o nui munyu ɔ nɛ a ngɛ tue kɛ ngɛ mo sie ɔ lo?”<verse eid="MAT 27:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 27:14" />Se Yesu de we nɔ ko kulaa, nɛ amlaalo ɔ nya kpɛ e he.<verse eid="MAT 27:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 27:15" />Jamɛ a be ɔ mi ɔ, ke e su Hebemi Nyami Ligbi ɔ, amlaalo ɔ ngmɛɛɔ Yuda bi nɛ a wo mɛ tsu mi ɔ a ti nɔ kake nɛ ma a ngɛ hlae ɔ he ngɔ haa mɛ. <verse eid="MAT 27:15" /><verse number="16" style="v" sid="MAT 27:16" />Se jamɛ a jeha a, a ngɛ awi yelɔ kpanaku ko nɛ a tsɛɛ lɛ ke Baraba. <verse eid="MAT 27:16" /><verse number="17" style="v" sid="MAT 27:17" />Benɛ asafo ɔ bua e he nya ngɛ Pilato hɛ mi ɔ, e bi mɛ ke, “Mɛnɔ he nyɛ suɔ kaa ma ngmɛɛ ha nyɛ, Baraba loo Yesu nɛ a tsɛɛ lɛ Kristo ɔ?” <verse eid="MAT 27:17" /><verse number="18" style="v" sid="MAT 27:18" />Ejakaa e le klɛdɛɛ kaa ninyɛ he nɛ a nu Yesu ngɛ, akɛnɛ e biɛ he si nɛ nihi babauu le lɛ ɔ.<verse eid="MAT 27:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 27:19" />Se benɛ Pilato hii si ngɛ kojomi he ɔ, e yo tsɔ kɛ ba e ngɔ ba de lɛ ke, “Moo ngmɛɛ jamɛ a dalɔ ɔ he kpoo, ejakaa i nla nlami gbeyegbeye ko ngɛ e he nyɔ nɛ ɔ mi.”<verse eid="MAT 27:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 27:20" />Se osɔfo nikɔtɔma amɛ kɛ ma mi nikɔtɔma amɛ wo ni ɔmɛ ga kaa a bi nɛ a ngmɛɛ Baraba mohu he, nɛ a gbe Yesu. <verse eid="MAT 27:20" /><verse number="21" style="v" sid="MAT 27:21" />Lɔ ɔ he je ɔ, benɛ amlaalo ɔ bi ni ɔmɛ ekohu ke, “Ni enyɔ ɔmɛ a ti mɛnɔ he nyɛ suɔ kaa ma ngmɛɛ ha nyɛ ɔ?” A he nɔ kɛ ngmlaa ke, “Baraba!”<verse eid="MAT 27:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 27:22" />Pilato bi mɛ ke, “Lɛɛ mɛni ma pee Yesu nɛ a tsɛɛ lɛ Kristo ɔ?” Nɛ a he nɔ ke, “Moo sɛu lɛ!”<verse eid="MAT 27:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 27:23" />Pilato bi mɛ ke, “Mɛni yayami nɛ e pee?” Se enɛ ɔ mohu ha nɛ a kpa ngmlaa bloblooblo pe kekle ɔ ke, “Moo sɛu lɛ! Moo sɛu lɛ!”<verse eid="MAT 27:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 27:24" />Benɛ Pilato na kaa e nyɛ we he nɔ́ ko nɛ e pee, nɛ gidigidi mohu ngɛ hlae nɛ e te si ɔ, e bi nɛ a ha lɛ nyu nɛ e fɔ e dɛ ngɛ ni ɔmɛ a hɛ mi, nɛ e de ke, “Ami lɛɛ i li dalɔ nɛ ɔ muɔ he nɔ́ ko; nyɛ nitsɛmɛ nyɛ sane i!”<verse eid="MAT 27:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 27:25" />Nɛ ni ɔmɛ tsuo he nɔ kɛ ngmlaa ke, “E muɔ nɛ ba wɔ kɛ wa bimɛ a nɔ!”<verse eid="MAT 27:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 27:26" />Kɛkɛ nɛ Pilato ngmɛɛ Baraba he ngɔ ha mɛ. Nɛ benɛ e ha a fiaa Yesu kpa se ɔ, e ngɔ lɛ kɛ ha Roma soja amɛ ke a ya sɛu lɛ. <verse eid="MAT 27:26" /><verse number="27" style="v" sid="MAT 27:27" />Kekle ɔ, a kpaka Yesu kɛ ho kojomi he ɔ ya, nɛ a ya bua soja amɛ a kuu ɔ tsuo nya kɛ ba e he. <verse eid="MAT 27:27" /><verse number="28" style="v" sid="MAT 27:28" />A je e he tade ɔmɛ, nɛ a ngɔ tade tsutsu klɔii kɛ wo lɛ. <verse eid="MAT 27:28" /><verse number="29" style="v" sid="MAT 27:29" />A pee mio pɛɛ ngɔ bu lɛ, nɛ a ngɔ matsɛ tso kɛ ha lɛ nɛ e hɛɛ ngɛ e hiɔ nine mi. A kpla si ngɛ e hɛ mi, nɛ a ye e he fɛu ke, “Wa nga mo oo, Yuda bi ɔmɛ a matsɛ!” <verse eid="MAT 27:29" /><verse number="30" style="v" sid="MAT 27:30" />A la lada ngɔ pue e nɔ, nɛ a he tso ɔ ngɛ e dɛ nɛ a kɛ fia e yi kpɛti.<verse eid="MAT 27:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 27:31" />Benɛ a ye e he fɛu ta a, a je tade wuyaa a ngɛ e he, nɛ a wo lɛ nitsɛ e tade ɔ ngɔ wo lɛ ekohu nɛ a kpaka lɛ kɛ ho konɛ a ya sɛu lɛ. <verse eid="MAT 27:31" /><verse number="32" style="v" sid="MAT 27:32" />Benɛ a yaa a, a kɛ nyumu ko nɛ je Kirene nɛ a tsɛɛ lɛ ke Simon ɔ ya kpe nɛ a nyɛ e nɔ ke e tloo Yesu sɛumi tso ɔ. <verse eid="MAT 27:32" /><verse number="33" style="v" sid="MAT 27:33" />A ya su he ko nɛ a tsɛɛ ke Golgata nɛ ji “Yikokonohe” ɔ, <verse eid="MAT 27:33" /><verse number="34" style="v" sid="MAT 27:34" />nɛ soja amɛ ngɔ wai nɛ a kɛ tsopa futu mi ngɔ ha lɛ ke e nu, se benɛ e sa e nya hyɛ ha a, e kua numi.<verse eid="MAT 27:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="MAT 27:35" />Nɛ benɛ a sɛu lɛ ɔ, soja amɛ fɔ sɔ ngɛ e tade ɔmɛ a nɔ nɛ a dla mɛ ngɔ ha a he. <verse eid="MAT 27:35" /><verse number="36" style="v" sid="MAT 27:36" />Nɛ a hi si kɛ bɔle lɛ konɛ a bu e he. <verse eid="MAT 27:36" /><verse number="37" style="v" sid="MAT 27:37" />A ngma sane nɛ a kɛ po e nya a kɛ pɛtɛ e yi mi ke, “Yesu, Yuda bi ɔmɛ a matsɛ ɔ ji nɛ ɔ nɛ.”<verse eid="MAT 27:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="MAT 27:38" />Jamɛ a ligbi ɔ mɔtu ɔ, a sɛu ojo fiali enyɔ ngɔ piɛ e he, nɔ kake ngɛ e hiɔ nine nɔ, nɛ nɔ kake hu ngɛ e muɔ nine nɔ. <verse eid="MAT 27:38" /><verse number="39" style="v" sid="MAT 27:39" />Nɛ nihi nɛ ngɛ bee ɔ jɛ lɛ, nɛ a huanya a yi, <verse eid="MAT 27:39" /><verse number="40" style="v" sid="MAT 27:40" />nɛ a de ke, “Mo nɛ o huleɔ Sɔlemi Tsu nɛ o kpaleɔ maa lɛ ligbi etɛ ɔ ji nɛ ɔ? Ke Mawu Bi ji mo tutuutu ɔ, mo kple si ngɛ sɛumi tso ɔ nɔ nɛ o he mo nitsɛ o yi wami.”<verse eid="MAT 27:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="MAT 27:41" />Ja a nɔuu nɛ osɔfo nikɔtɔma amɛ kɛ mlaa tsɔɔli ɔmɛ kɛ ma mi nikɔtɔma amɛ ye e he fɛu nɛ a de ke, <verse eid="MAT 27:41" /><verse number="42" style="v" sid="MAT 27:42" />“Ni kpahi a yi wami e heɔ se e nyɛ we lɛ nitsɛ e nɔ ɔ nɛ e he. Ke Israel matsɛ ji mo ɔ, lɛɛ mo kple si kɛ je sɛumi tso ɔ nɔ koo, nɛ wa ma he mo maa ye. <verse eid="MAT 27:42" /><verse number="43" style="v" sid="MAT 27:43" />E ke e hɛ ngɛ Mawu nɔ, ha nɛ Mawu nɛ je lɛ ke e ngɛ e he suɔmi ɔ. Anɛ pi lɛ nɛ e de ke, ‘Mawu Bi ji mi’ ɔ?”<verse eid="MAT 27:43" /></para>
  <para style="p">
    <verse number="44" style="v" sid="MAT 27:44" />Ja a nɔuu kɛ nɛ ojo fiali ɔmɛ nɛ a sɛu kɛ piɛ e he ɔ hu ye e he fɛu.<verse eid="MAT 27:44" /></para>
  <para style="p">
    <verse number="45" style="v" sid="MAT 27:45" />Ngɛ piani mi ɔ, kɛ je ngmlɛ nyɔngma kɛ enyɔ kɛ ba si ngmlɛ etɛ ɔ, diblii wo ngɛ zugba a nɔ kulaa. <verse eid="MAT 27:45" /><verse number="46" style="v" sid="MAT 27:46" />Se maa pee gbɔkuɛ ngmlɛ etɛ mi ɔ, Yesu kpa ngmlaa wawɛɛ ke, “Eli, Eli, lama Sabaktani?” E sisi ji; “Ye Mawu, ye Mawu, mɛni he je nɛ o kua mi?”<verse eid="MAT 27:46" /></para>
  <para style="p">
    <verse number="47" style="v" sid="MAT 27:47" />Benɛ nihi nɛ daa si ngɛ lejɛ ɔ a ti nihi nu ɔ, a de ke, “Elia nɛ e ngɛ tsɛɛ ɔ nɛ.” <verse eid="MAT 27:47" /><verse number="48" style="v" sid="MAT 27:48" />Kɛkɛ nɛ a ti nɔ kake sa fo nɛ e ya ngɔ kutsa nɛ e kɛ tsɔ wai nɛ duɔ mi, nɛ e ngɔ ma tso nya nɛ e kɛ mane lɛ ke e nu. <verse eid="MAT 27:48" /><verse number="49" style="v" sid="MAT 27:49" />Se nihi nɛ piɛ ɔ de lɛ ke, “Ngmɛɛ e he. Ha waa hyɛ ha kaa Elia maa ba ba je lɛ lo?”<verse eid="MAT 27:49" /></para>
  <para style="p">
    <verse number="50" style="v" sid="MAT 27:50" />Kɛkɛ nɛ Yesu kpa ngmlaa wawɛɛ ekohu nɛ e ma e nya. <verse eid="MAT 27:50" /><verse number="51" style="v" sid="MAT 27:51" />Nɛ hyɛ, Sɔlemi Tsu ɔ mi pomi bo ɔ mi gba enyɔ kɛ je hiɔwe kɛ ba ma si, nɛ zugba hoso, nɛ tɛ sahi a mi gba, <verse eid="MAT 27:51" /><verse number="52" style="v" sid="MAT 27:52" />nɛ yɔkɔhi a nya bli nɛ klɔuklɔu bihi nɛ gbo ɔmɛ fuu te si kɛ je gbeje. <verse eid="MAT 27:52" /><verse number="53" style="v" sid="MAT 27:53" />Nɛ benɛ Yesu te si se ɔ, a je kpo kɛ je a muɔ ɔmɛ a mi kɛ ho Yerusalem ya nɛ a ya je a he kpo kɛ tsɔɔ nihi fuu ngɛ lejɛ ɔ.<verse eid="MAT 27:53" /></para>
  <para style="p">
    <verse number="54" style="v" sid="MAT 27:54" />Se benɛ soja amɛ kɛ a nyatsɛ ɔ nɛ ngɛ e he bue ɔ na zugba hosomi ɔ kɛ níhi tsuo nɛ ba a, a ye gbeye wawɛɛ nɛ a de ke, “Niinɛ, Mawu Bi ji nɛ ɔ nɛ.”<verse eid="MAT 27:54" /></para>
  <para style="p">
    <verse number="55" style="v" sid="MAT 27:55" />Yihi fuu nɛ nyɛɛ Yesu se kɛ je Galilea nɛ a ba hyɛ lɛ ɔ da si ngɛ se lokoo. <verse eid="MAT 27:55" /><verse number="56" style="v" sid="MAT 27:56" />A ti ni komɛ ji Maria Magdalena kɛ Maria nɛ ji Yakobo kɛ Yosef nyɛ ɔ kɛ Zebedeo bimɛ ɔmɛ, Yakobo kɛ Yohane a nyɛ ɔ.<verse eid="MAT 27:56" /></para>
  <para style="s1">Yesu pumi</para>
  <para style="p">
    <verse number="57" style="v" sid="MAT 27:57" />Benɛ e su gbɔkuɛ he ɔ, niatsɛ ko nɛ je Arimatia nɛ a tsɛɛ lɛ ke Yosef, nɛ ji Yesu kaseli ɔmɛ a ti nɔ kake ɔ, <verse eid="MAT 27:57" /><verse number="58" style="v" sid="MAT 27:58" />ya Pilato ngɔ nɛ e ya bi lɛ kaa e ngmɛɛ Yesu gbogboe ɔ he ha lɛ. Nɛ Pilato fa ke a ngɔ gbogboe ɔ kɛ ha lɛ. <verse eid="MAT 27:58" /><verse number="59" style="v" sid="MAT 27:59" />Yosef ngɔ gbogboe ɔ, nɛ e wo bo nɛ he tsɔ falefale kɛ blaa lɛ. <verse eid="MAT 27:59" /><verse number="60" style="v" sid="MAT 27:60" />E kɛ lɛ ya fɔ lɛ nitsɛ e yɔkɔ nɛ a kpɛ ngɛ tɛ sa mi ɔ mi, nɛ e kpɛne tɛ agbo ko kɛ tsi nya nɛ e je. <verse eid="MAT 27:60" /><verse number="61" style="v" sid="MAT 27:61" />Nɛ Maria Magdalena kɛ Maria kaketsɛ ɔ hii si ngɛ lejɛ ɔ ngɛ hyɛe.<verse eid="MAT 27:61" /></para>
  <para style="p">
    <verse number="62" style="v" sid="MAT 27:62" />He dlami kɛ tomi e nɔ jena a, osɔfo nikɔtɔma amɛ kɛ Farisi bi ɔmɛ ho ya na Pilato, <verse eid="MAT 27:62" /><verse number="63" style="v" sid="MAT 27:63" />nɛ a de lɛ ke, “Nutsɔ, wa kai kaa benɛ jamɛ a lakpatsɛ ɔ ngɛ je mi ɔ, e de ke, ‘Ligbi nɛ ji etɛ ɔ, ma te si ekohu.’ <verse eid="MAT 27:63" /><verse number="64" style="v" sid="MAT 27:64" />Enɛ ɔ he je ɔ, wa ngɛ bie nɛ o fa nɛ a ya sɔu yɔkɔ ɔ nya saminya kɛ ya si ligbi etɛ ɔ, ke pi ja a, e kaseli ɔmɛ ma ya ju lɛ kɛ je nɛ a ma ya de nɔ fɛɛ nɔ ke e te si kɛ je gbeje. Ke e ba mi ja a, sekpɛ sisimi ɔ nya maa wa pe kekle nɔ́ ɔ.”<verse eid="MAT 27:64" /></para>
  <para style="p">
    <verse number="65" style="v" sid="MAT 27:65" />Nɛ Pilato de mɛ ke, “Nyɛ ha nyɛ nitsɛmɛ nyɛ Sɔlemi We ɔ soja amɛ nɛ a ya bu bɔ nɛ a ma nyɛ.”<verse eid="MAT 27:65" /></para>
  <para style="p">
    <verse number="66" style="v" sid="MAT 27:66" />A ya sɔu yɔkɔ ɔ nya nɛ a ha soja amɛ ya ngɛ he bue.<verse eid="MAT 27:66" /></para>
  <chapter eid="MAT 27" />
  <chapter number="28" style="c" sid="MAT 28" />
  <para style="s1">Yesu te si</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 28:1" />Hejɔɔmi Ligbi ɔ nyagbe mi benɛ je bɔni nami kɛ ma otsi ɔ kekle ligbi ɔ nɔ ɔ, Maria Magdalena kɛ Maria kake ɔ ba yɔkɔ ɔ slaami.<verse eid="MAT 28:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="MAT 28:2" />Kɛkɛ nɛ zugba hoso wawɛɛ si kake too, ejakaa Nutsɔ ɔ bɔfo je hiɔwe kple si, nɛ e ba kpɛne tɛ ɔ kɛ je muɔ ɔ nya kɛ ho se ya nɛ e ho hi si ngɛ nɔ <verse eid="MAT 28:2" /><verse number="3" style="v" sid="MAT 28:3" />E hɛ mi ngɛ kpɛe kaa oslabai, nɛ e tade ɔ hiɔ futafuta. <verse eid="MAT 28:3" /><verse number="4" style="v" sid="MAT 28:4" />Soja amɛ ye gbeye nɛ a he kpokpo benɛ a na bɔfo ɔ, nɛ a plɛ kaa ni gbogboehi. <verse eid="MAT 28:4" /><verse number="5" style="v" sid="MAT 28:5" />Kɛkɛ nɛ bɔfo ɔ de yi ɔmɛ ke, “Nyɛ ko ye gbeye, ejakaa i le kaa nyɛ ngɛ Yesu nɔ nɛ a sɛu lɛ ɔ hlae. <verse eid="MAT 28:5" /><verse number="6" style="v" sid="MAT 28:6" />E be hiɛ ɔ, e te si kaa bɔ nɛ e de ɔ. Nyɛɛ ba nɛ nyɛ ba hyɛ muɔ ɔ mi he nɛ a dla lɛ ngɛ ɔ. <verse eid="MAT 28:6" /><verse number="7" style="v" sid="MAT 28:7" />Nyɛɛ ya mlamlaamla nɛ nyɛ ya de e kaseli ɔmɛ ke, e te si kɛ je gbeje, nɛ e sɛ a hlami kɛ yaa Galilea nɛ e kɛ mɛ ya kpe ngɛ lejɛ ɔ.”<verse eid="MAT 28:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 28:8" />Nɛ yi ɔmɛ ye esɔ kɛ je yɔkɔ ɔ he kɛ gbeye kɛ nyami konɛ a ya de e kaseli ɔmɛ bɔfo ɔ sɛ ɔ. <verse eid="MAT 28:8" /><verse number="9" style="v" sid="MAT 28:9" />Se benɛ a hɛɛ fo kɛ yaa a, o nɛ, Yesu kɛ mɛ ya kpe nɛ e de mɛ ke, “I nga nyɛ!” Kɛkɛ nɛ a ya kpla si ngɛ e hɛ mi nɛ a nu e nane, nɛ a ja lɛ.<verse eid="MAT 28:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 28:10" />Nɛ Yesu de mɛ ke, “Nyɛ ko ye gbeye, nyɛɛ ya nɛ nyɛ ya de ye nyɛmi ɔmɛ ke a ho Galilea ya nɔuu, nɛ a kɛ mi ya kpe ngɛ lejɛ ɔ.”<verse eid="MAT 28:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 28:11" />Benɛ yi ɔmɛ yaa ma a mi ɔ, Sɔlemi We ɔ he buli ɔmɛ a ti nihi nɛ ngɛ yɔkɔ ɔ he bue ɔ hu ba ma a mi nɛ a ba bɔ osɔfo nikɔtɔma amɛ nihi nɛ ba a. <verse eid="MAT 28:11" /><verse number="12" style="v" sid="MAT 28:12" />Kɛkɛ nɛ a kɛ ma mi nikɔtɔma amɛ ya kpe yi nɛ a wo soja amɛ a nya mi nɔ, <verse eid="MAT 28:12" /><verse number="13" style="v" sid="MAT 28:13" />nɛ a de mɛ ke a de ke Yesu kaseli ɔmɛ ba nɛ a ba ju e gbogboe ɔ nyɔ mi benɛ a hwɔ mahe. <verse eid="MAT 28:13" /><verse number="14" style="v" sid="MAT 28:14" />A wo soja amɛ si ke, “Ke amlaalo ɔ nu he ɔ, wa maa da nyɛ se nɛ nyɛ be sane ko nae.”<verse eid="MAT 28:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 28:15" />Soja amɛ he nyɔ mi ni ɔ, nɛ a pee bɔ nɛ a tsɔɔ mɛ ɔ. Nɛ sane nɛ ɔ gbɛ fia ngɛ Yuda bi ɔmɛ a kpɛti kɛ ba si mwɔnɛ ɔ.<verse eid="MAT 28:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 28:16" />Kɛkɛ nɛ kaseli nyɔngma kɛ kake ɔ je kɛ ho Galilea yoku ɔ nɔ ya, he nɛ Yesu de ke a maa na lɛ ngɛ ɔ. <verse eid="MAT 28:16" /><verse number="17" style="v" sid="MAT 28:17" />Benɛ a ya na lɛ ɔ, a kpla si nɛ a ja lɛ, se a kpɛti ni komɛ je nguane kaa tsa pi Yesu i.<verse eid="MAT 28:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 28:18" />Kɛkɛ nɛ Yesu kɛ mɛ tu munyu nɛ e de mɛ ke, “A ngɔ he blɔ tsuo kɛ ha mi ngɛ hiɔwe kɛ zugba a nɔ. <verse eid="MAT 28:18" /><verse number="19" style="v" sid="MAT 28:19" />Lɔ ɔ he je ɔ, nyɛɛ ya nɛ nyɛ ya pee majemaje ɔ tsuo ye kaseli. Nyɛɛ baptisi mɛ ngɛ Tsɛ ɔ kɛ Bi ɔ kɛ Mumi Klɔuklɔu ɔ biɛ mi, <verse eid="MAT 28:19" /><verse number="20" style="v" sid="MAT 28:20" />nɛ nyɛɛ tsɔɔ kaseli he nɛ ɔmɛ nɛ a ye mlaahi tsuo nɛ i tsɔɔ nyɛ ɔ nɔ; nɛ Niinɛ, i kɛ nyɛ ngɛ daa kɛ yaa su je mi nyagbe.”<verse eid="MAT 28:20" /></para>
  <chapter eid="MAT 28" />
</usx>