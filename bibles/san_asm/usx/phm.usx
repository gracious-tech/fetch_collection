<?xml version="1.0" encoding="UTF-8"?>
<usx version="2.6">
  <book code="PHM" style="id">Sanskrit Bible (NT) in Assamese Script (সত্যৱেদঃ।)</book>
  <para style="rem">© SanskritBible.in । Licensed under CC BY-SA 4.0</para>
  <para style="h">Philemon</para>
  <para style="toc1">ফিলোমোনং পত্ৰং</para>
  <para style="toc2">ফিলোমোনঃ</para>
  <para style="toc3">ফিলোমোনঃ</para>
  <para style="mt1">ফিলোমোনং পত্ৰং</para>
  <chapter number="1" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>খ্ৰীষ্টস্য যীশো ৰ্বন্দিদাসঃ পৌলস্তীথিযনামা ভ্ৰাতা চ প্ৰিযং সহকাৰিণং ফিলীমোনং</para>
  <para style="p">
    <verse number="2" style="v"/>প্ৰিযাম্ আপ্পিযাং সহসেনাম্ আৰ্খিপ্পং ফিলীমোনস্য গৃহে স্থিতাং সমিতিঞ্চ প্ৰতি পত্ৰং লিখতঃ|</para>
  <para style="p">
    <verse number="3" style="v"/>অস্মাকং তাত ঈশ্ৱৰঃ প্ৰভু ৰ্যীশুখ্ৰীষ্টশ্চ যুষ্মান্ প্ৰতি শান্তিম্ অনুগ্ৰহঞ্চ ক্ৰিযাস্তাং|</para>
  <para style="p">
    <verse number="4" style="v"/>প্ৰভুং যীশুং প্ৰতি সৰ্ৱ্ৱান্ পৱিত্ৰলোকান্ প্ৰতি চ তৱ প্ৰেমৱিশ্ৱাসযো ৰ্ৱৃত্তান্তং নিশম্যাহং</para>
  <para style="p">
    <verse number="5" style="v"/>প্ৰাৰ্থনাসমযে তৱ নামোচ্চাৰযন্ নিৰন্তৰং মমেশ্ৱৰং ধন্যং ৱদামি|</para>
  <para style="p">
    <verse number="6" style="v"/>অস্মাসু যদ্যৎ সৌজন্যং ৱিদ্যতে তৎ সৰ্ৱ্ৱং খ্ৰীষ্টং যীশুং যৎ প্ৰতি ভৱতীতি জ্ঞানায তৱ ৱিশ্ৱাসমূলিকা দানশীলতা যৎ সফলা ভৱেৎ তদহম্ ইচ্ছামি|</para>
  <para style="p">
    <verse number="7" style="v"/>হে ভ্ৰাতঃ, ৎৱযা পৱিত্ৰলোকানাং প্ৰাণ আপ্যাযিতা অভৱন্ এতস্মাৎ তৱ প্ৰেম্নাস্মাকং মহান্ আনন্দঃ সান্ত্ৱনা চ জাতঃ|</para>
  <para style="p">
    <verse number="8" style="v"/>ৎৱযা যৎ কৰ্ত্তৱ্যং তৎ ৎৱাম্ আজ্ঞাপযিতুং যদ্যপ্যহং খ্ৰীষ্টেনাতীৱোৎসুকো ভৱেযং তথাপি ৱৃদ্ধ</para>
  <para style="p">
    <verse number="9" style="v"/>ইদানীং যীশুখ্ৰীষ্টস্য বন্দিদাসশ্চৈৱম্ভূতো যঃ পৌলঃ সোঽহং ৎৱাং ৱিনেতুং ৱৰং মন্যে|</para>
  <para style="p">
    <verse number="10" style="v"/>অতঃ শৃঙ্খলবদ্ধোঽহং যমজনযং তং মদীযতনযম্ ওনীষিমম্ অধি ৎৱাং ৱিনযে|</para>
  <para style="p">
    <verse number="11" style="v"/>স পূৰ্ৱ্ৱং তৱানুপকাৰক আসীৎ কিন্ত্ৱিদানীং তৱ মম চোপকাৰী ভৱতি|</para>
  <para style="p">
    <verse number="12" style="v"/>তমেৱাহং তৱ সমীপং প্ৰেষযামি, অতো মদীযপ্ৰাণস্ৱৰূপঃ স ৎৱযানুগৃহ্যতাং|</para>
  <para style="p">
    <verse number="13" style="v"/>সুসংৱাদস্য কৃতে শৃঙ্খলবদ্ধোঽহং পৰিচাৰকমিৱ তং স্ৱসন্নিধৌ ৱৰ্ত্তযিতুম্ ঐচ্ছং|</para>
  <para style="p">
    <verse number="14" style="v"/>কিন্তু তৱ সৌজন্যং যদ্ বলেন ন ভূৎৱা স্ৱেচ্ছাযাঃ ফলং ভৱেৎ তদৰ্থং তৱ সম্মতিং ৱিনা কিমপি কৰ্ত্তৱ্যং নামন্যে|</para>
  <para style="p">
    <verse number="15" style="v"/>কো জানাতি ক্ষণকালাৰ্থং ৎৱত্তস্তস্য ৱিচ্ছেদোঽভৱদ্ এতস্যাযম্ অভিপ্ৰাযো যৎ ৎৱম্ অনন্তকালাৰ্থং তং লপ্স্যসে</para>
  <para style="p">
    <verse number="16" style="v"/>পুন ৰ্দাসমিৱ লপ্স্যসে তন্নহি কিন্তু দাসাৎ শ্ৰেষ্ঠং মম প্ৰিযং তৱ চ শাৰীৰিকসম্বন্ধাৎ প্ৰভুসম্বন্ধাচ্চ ততোঽধিকং প্ৰিযং ভ্ৰাতৰমিৱ|</para>
  <para style="p">
    <verse number="17" style="v"/>অতো হেতো ৰ্যদি মাং সহভাগিনং জানাসি তৰ্হি মামিৱ তমনুগৃহাণ|</para>
  <para style="p">
    <verse number="18" style="v"/>তেন যদি তৱ কিমপ্যপৰাদ্ধং তুভ্যং কিমপি ধাৰ্য্যতে ৱা তৰ্হি তৎ মমেতি ৱিদিৎৱা গণয|</para>
  <para style="p">
    <verse number="19" style="v"/>অহং তৎ পৰিশোৎস্যামি, এতৎ পৌলোঽহং স্ৱহস্তেন লিখামি, যতস্ত্ৱং স্ৱপ্ৰাণান্ অপি মহ্যং ধাৰযসি তদ্ ৱক্তুং নেচ্ছামি|</para>
  <para style="p">
    <verse number="20" style="v"/>ভো ভ্ৰাতঃ, প্ৰভোঃ কৃতে মম ৱাঞ্ছাং পূৰয খ্ৰীষ্টস্য কৃতে মম প্ৰাণান্ আপ্যাযয|</para>
  <para style="p">
    <verse number="21" style="v"/>তৱাজ্ঞাগ্ৰাহিৎৱে ৱিশ্ৱস্য মযা এতৎ লিখ্যতে মযা যদুচ্যতে ততোঽধিকং ৎৱযা কাৰিষ্যত ইতি জানামি|</para>
  <para style="p">
    <verse number="22" style="v"/>তৎকৰণসমযে মদৰ্থমপি ৱাসগৃহং ৎৱযা সজ্জীক্ৰিযতাং যতো যুষ্মাকং প্ৰাৰ্থনানাং ফলৰূপো ৱৰ ইৱাহং যুষ্মভ্যং দাযিষ্যে মমেতি প্ৰত্যাশা জাযতে|</para>
  <para style="p">
    <verse number="23" style="v"/>খ্ৰীষ্টস্য যীশাঃ কৃতে মযা সহ বন্দিৰিপাফ্ৰা</para>
  <para style="p">
    <verse number="24" style="v"/>মম সহকাৰিণো মাৰ্ক আৰিষ্টাৰ্খো দীমা লূকশ্চ ৎৱাং নমস্কাৰং ৱেদযন্তি|</para>
  <para style="p">
    <verse number="25" style="v"/>অস্মাকং প্ৰভো ৰ্যীশুখ্ৰীষ্টস্যানুগ্ৰহো যুষ্মাকম্ আত্মনা সহ ভূযাৎ| আমেন্|</para>
</usx>
