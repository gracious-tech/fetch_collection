<?xml version="1.0" encoding="UTF-8"?>
<usx version="2.6">
  <book code="3JN" style="id">Sanskrit Bible (NT) in Assamese Script (সত্যৱেদঃ।)</book>
  <para style="rem">© SanskritBible.in । Licensed under CC BY-SA 4.0</para>
  <para style="h">3 John</para>
  <para style="toc1">৩ যোহনঃ পত্ৰং</para>
  <para style="toc2">৩ যোহনঃ</para>
  <para style="toc3">৩ যোহনঃ</para>
  <para style="mt1">৩ যোহনঃ পত্ৰং</para>
  <chapter number="1" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>প্ৰাচীনো ঽহং সত্যমতাদ্ যস্মিন্ প্ৰীযে তং প্ৰিযতমং গাযং প্ৰতি পত্ৰং লিখামি|</para>
  <para style="p">
    <verse number="2" style="v"/>হে প্ৰিয, তৱাত্মা যাদৃক্ শুভান্ৱিতস্তাদৃক্ সৰ্ৱ্ৱৱিষযে তৱ শুভং স্ৱাস্থ্যঞ্চ ভূযাৎ|</para>
  <para style="p">
    <verse number="3" style="v"/>ভ্ৰাতৃভিৰাগত্য তৱ সত্যমতস্যাৰ্থতস্ত্ৱং কীদৃক্ সত্যমতমাচৰস্যেতস্য সাক্ষ্যে দত্তে মম মহানন্দো জাতঃ|</para>
  <para style="p">
    <verse number="4" style="v"/>মম সন্তানাঃ সত্যমতমাচৰন্তীতিৱাৰ্ত্তাতো মম য আনন্দো জাযতে ততো মহত্তৰো নাস্তি|</para>
  <para style="p">
    <verse number="5" style="v"/>হে প্ৰিয, ভ্ৰাতৃন্ প্ৰতি ৱিশেষতস্তান্ ৱিদেশিনো ভৃाতৃন্ প্ৰতি ৎৱযা যদ্যৎ কৃতং তৎ সৰ্ৱ্ৱং ৱিশ্ৱাসিনো যোগ্যং|</para>
  <para style="p">
    <verse number="6" style="v"/>তে চ সমিতেঃ সাক্ষাৎ তৱ প্ৰম্নঃ প্ৰমাণং দত্তৱন্তঃ, অপৰম্ ঈশ্ৱৰযোগ্যৰূপেণ তান্ প্ৰস্থাপযতা ৎৱযা সৎকৰ্ম্ম কাৰিষ্যতে|</para>
  <para style="p">
    <verse number="7" style="v"/>যতস্তে তস্য নাম্না যাত্ৰাং ৱিধায ভিন্নজাতীযেভ্যঃ কিমপি ন গৃহীতৱন্তঃ|</para>
  <para style="p">
    <verse number="8" style="v"/>তস্মাদ্ ৱযং যৎ সত্যমতস্য সহাযা ভৱেম তদৰ্থমেতাদৃশা লোকা অস্মাভিৰনুগ্ৰহীতৱ্যাঃ|</para>
  <para style="p">
    <verse number="9" style="v"/>সমিতিং প্ৰত্যহং পত্ৰং লিখিতৱান্ কিন্তু তেষাং মধ্যে যো দিযত্ৰিফিঃ প্ৰধানাযতে সো ঽস্মান্ ন গৃহ্লাতি|</para>
  <para style="p">
    <verse number="10" style="v"/>অতো ঽহং যদোপস্থাস্যামি তদা তেন যদ্যৎ ক্ৰিযতে তৎ সৰ্ৱ্ৱং তং স্মাৰযিষ্যামি, যতঃ স দুৰ্ৱ্ৱাক্যৈৰস্মান্ অপৱদতি, তেনাপি তৃপ্তিং ন গৎৱা স্ৱযমপি ভ্ৰাতৃন্ নানুগৃহ্লাতি যে চানুগ্ৰহীতুমিচ্ছন্তি তান্ সমিতিতো ঽপি বহিষ্কৰোতি|</para>
  <para style="p">
    <verse number="11" style="v"/>হে প্ৰিয, ৎৱযা দুষ্কৰ্ম্ম নানুক্ৰিযতাং কিন্তু সৎকৰ্ম্মৈৱ| যঃ সৎকৰ্ম্মাচাৰী স ঈশ্ৱৰাৎ জাতঃ, যো দুষ্কৰ্ম্মাচাৰী স ঈশ্ৱৰং ন দৃষ্টৱান্|</para>
  <para style="p">
    <verse number="12" style="v"/>দীমীত্ৰিযস্য পক্ষে সৰ্ৱ্ৱৈঃ সাক্ষ্যম্ অদাযি ৱিশেষতঃ সত্যমতেনাপি, ৱযমপি তৎপক্ষে সাক্ষ্যং দদ্মঃ, অস্মাকঞ্চ সাক্ষ্যং সত্যমেৱেতি যূযং জানীথ|</para>
  <para style="p">
    <verse number="13" style="v"/>ৎৱাং প্ৰতি মযা বহূনি লেখিতৱ্যানি কিন্তু মসীলেখনীভ্যাং লেখিতুং নেচ্ছামি|</para>
  <para style="p">
    <verse number="14" style="v"/>অচিৰেণ ৎৱাং দ্ৰক্ষ্যামীতি মম প্ৰত্যাশাস্তে তদাৱাং সম্মুখীভূয পৰস্পৰং সম্ভাষিষ্যাৱহে|</para>
  <para style="p">
    <verse number="15" style="v"/>তৱ শান্তি ৰ্ভূযাৎ| অস্মাকং মিত্ৰাণি ৎৱাং নমস্কাৰং জ্ঞাপযন্তি ৎৱমপ্যেকৈকস্য নাম প্ৰোচ্য মিত্ৰেভ্যো নমস্কুৰু| ইতি|</para>
</usx>
