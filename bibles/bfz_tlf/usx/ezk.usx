<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="EZK" style="id">- Baghlayani Bible</book>
  <para style="toc1">यहेजकेल नबीए रे जरिये लिखी री कताब</para>
  <para style="toc2">यहेजकेल</para>
  <para style="toc3">यहेज.</para>
  <para style="mt">यहेजकेल</para>
  <para style="mt2">यहेजकेल नबीए रे जरिये लिखी री कताब</para>
  <para style="is">भूमिका</para>
  <para style="ip">सन 586 ई. पू. दे यरूशलेमो रे नाशो ते पईले ओर बाद यहेजकेल नबीए बेबीलोनो दे एक गुलामिया रा जीवन जिया था। तेसरे संदेश बेबीलोनो दे गुलामिया दे रणे वाल़े लोका ओर यरूशलेमो दे रणे वाल़े लोका, दूनी खे बोले दे ए। यहेजकेलो रिया कताबा रे छे खास इस्से ए:</para>
  <para style="ili">(1) नबी ऊणे खे यहेजकेलो खे परमेशरो री बुलाहट।</para>
  <para style="ili">(2) लोका पाँदे परमेशरो रा दण्ड पड़ने ओर बऊत ई छोड़ यरूशलेमो रा सत्यानाश ऊणे री चतौणी।</para>
  <para style="ili">(3) कई जातिया जिने परमेशरो रे लोक पटकाए ओर सेयो दबाए, तिना पाँदे परमेशरो री सजा आऊणे रे बारे दे संदेश।</para>
  <para style="ili">(4) यरूशलेमो रे नाशो ते बाद इस्राएलो खे शान्ति मिलणे ओर तेसरे अच्छे भविष्य री प्रतिज्ञा।</para>
  <para style="ili">(5) गोगो रे खलाफ भविष्यबाणी।</para>
  <para style="ili">(6) दुबारा बणे दे मन्दर ओर इस्राएल देशो ते जूड़ेया दा यहेजकेलो रा बिचार।</para>
  <para style="ip">यहेजकेल एक एड़ा माणूं था जो गईरे परोसे ओर महान सोच-बिचारो रा स्वामी था।</para>
  <para style="iot">रूप-रेखा</para>
  <para style="io1">यहेजकेलो रा बुलाया जाणा <char style="ior"><ref loc="EZK 1:1-3:27">1:1-3:27</ref></char></para>
  <para style="io1">यरूशलेमो रे नाशो रा सन्देश <char style="ior"><ref loc="EZK 4:1-24:27">4:1-24:27</ref></char></para>
  <para style="io1">सबी जातिया पाँदे परमेशरो री सजा <char style="ior"><ref loc="EZK 25:1-32:32">25:1-32:32</ref></char></para>
  <para style="io1">आपणे लोका ते परमेशरो री प्रतिज्ञा <char style="ior"><ref loc="EZK 33:1-37:28">33:1-37:28</ref></char></para>
  <para style="io1">गोगो रे खलाफ भविष्यबाणी <char style="ior"><ref loc="EZK 38:1-39:29">38:1-39:29</ref></char></para>
  <para style="io1">नवें मन्दर ओर देशो ते जुड़ेया दा एक दर्शण <char style="ior"><ref loc="EZK 40:1-48:35">40:1-48:35</ref></char></para>
  <chapter number="1" style="c" sid="EZK 1" />
  <para style="s">परमेशरो रे बारे दे यहेजकेलो रा पईला दर्शण</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 1:1" />जेबे आऊँ तीई सालो रे चौथे मीन्ने ओर पाँजुए दिनो रा था, परमेशरे मांते गल्ल कित्ती। आऊँ यहेजकेल कबार नदिया रे कनारे पाँदे तिना लोका बीचा ते जिना खे यहूदी कैदिया रे रूपो दे तेथा ते लईगे दे थे। तेबे स्वर्ग खुली गा ओर माखे परमेशरो रे दर्शण ऊए।<note caller="+" style="f"><char style="fr" closed="false">1:1 </char><char style="ft" closed="false">यहे. 3:23</char></note> <verse eid="EZK 1:1" /><verse number="2" style="v" sid="EZK 1:2" />यहूदा प्रदेशो रे यहोयाकीन राजे री गुलामिया रे पाँजुए सालो रे चौथे मीन्ने रे पाँजुए दिने, बेबीलोनिया रे देशो दे कबार नदिया रे कनारे पाँदे, <verse eid="EZK 1:2" /><verse number="3" style="v" sid="EZK 1:3" />यहोवे बेबीलोनो दे दर्शणो रे जरीये बूजीए रे पाऊ यहेजकेल पुरोईतो खे सन्देश दित्तेया ओर यहोवे री सामर्थ तेस पाँदे तेथी प्रकट ऊई।<verse eid="EZK 1:3" /></para>
  <para style="s">यहोवे रा रथ ओर तेसरा सिंहासन</para>
  <para style="p">
    <verse number="4" style="v" sid="EZK 1:4" />जेबे आऊँ दर्शण देखणे लगेया, तेबे मैं देखेया कि उत्तर दिशा ते बड़ा पऊण-चूखाना ओर आगी रिया लूपिया साथे बड़ा तूफान आऊणे लगी रा ओर तूफानो रे चऊँ कनारे प्रयासा ओर आगी रे बीचो-बीच चमकेया दा पीतल़ी जेड़ा कुछ दिशणे लगी रा। <verse eid="EZK 1:4" /><verse number="5" style="v" sid="EZK 1:5" />तेबे तूफानो बीचा ते चऊँ जानवरा जेड़े कुछ निकल़े ओर तिना री शक्ल माणूंआ जेड़ी थी। <verse eid="EZK 1:5" /><verse number="6" style="v" sid="EZK 1:6" />पर तिना बीचा ते हर एकी रे चार-चार मूँ ओर चार-चार पंख थे। <verse eid="EZK 1:6" /><verse number="7" style="v" sid="EZK 1:7" />तिना रे पैर सीदे थे ओर तिना रे पैरा री थाली बाच्छूआ रे खुरो जेड़े थे ओर सेयो चमकाये रे पीतल़ी जेड़े चमको थे। <verse eid="EZK 1:7" /><verse number="8" style="v" sid="EZK 1:8" />तिना प्राणिया रे चऊँ कनारले पंखा निठे माणूंआ जेड़े आथ थे ओर तिना चऊँ रे मूँ ओर पंख एड़े थे: <verse eid="EZK 1:8" /><verse number="9" style="v" sid="EZK 1:9" />तिना रे पंख एकी-दूजे साथे आपू-बीचे मिले दे थे, सेयो आपणे-आपणे सामणे सीदे ई चलो थे, मुड़ो नि थे। <verse eid="EZK 1:9" /><verse number="10" style="v" sid="EZK 1:10" />हर एकी रे चार मूँ थे सामणे ते तिना री शक्ल माणूंआ जेड़ी थी ओर तिना चऊँ रे दाँणे कनारले मूँ शेरो जेड़े थे, खूँजे कनारले मूँ बल़दो जेड़े थे ओर चऊँ रे पिछले मूँ उकाब पंछिया जेड़े थे।<note caller="+" style="f"><char style="fr" closed="false">1:10 </char><char style="ft" closed="false">प्रका. 4:7</char></note> <verse eid="EZK 1:10" /><verse number="11" style="v" sid="EZK 1:11" />तिना री शक्ल एड़ी थी ओर तिना रे मूँ ओर पंख पाँदलिया तरफा खे लग-लग थे, हर एकी जानवरो रे दो-दो पंख थे, जो एकी-दूजे रे पंखो साथे मिले रे थे ओर दूई-दूई पंखे की तिना रा शरीर टखेया रा था। <verse eid="EZK 1:11" /><verse number="12" style="v" sid="EZK 1:12" />सेयो सीदे आपणे-आपणे सामणे ई चलो थे, जेती प्राणिया रे पीतरे आत्मा जाणा चाओ थी, सेयो तेथी जाओ थे ओर चलदे बखते मुड़ो नि थे। <verse eid="EZK 1:12" /><verse number="13" style="v" sid="EZK 1:13" />तिना चऊँ प्राणिया री शक्ल फेऊआ जेड़ी ओर बल़ी रिया मशाला जेड़ी दिशो थी ओर से आग प्राणिया बीचे ओरे-पोरे चलदे-फिरदे ऊए बऊत प्रयासा देयो थी ओर तेसा आगी ते बिजल़ी निकल़ो थी।<note caller="+" style="f"><char style="fr" closed="false">1:13 </char><char style="ft" closed="false">प्रका. 4:5, प्रका. 11:1</char></note> <verse eid="EZK 1:13" /><verse number="14" style="v" sid="EZK 1:14" />सेओ प्राणी बिजल़िया जेड़े छोड़ आगे पीछे दौड़ोए। <verse eid="EZK 1:14" /><verse number="15" style="v" sid="EZK 1:15" />जेबे आऊँ तिना चऊँ प्राणिया खे देखणे ई लगी रा था, तेबे मैं देखेया कि जमीना दे तिना गे चऊँ मुंए री गिणतिया रे मुताबिक, एक-एक टईर था। <verse eid="EZK 1:15" /><verse number="16" style="v" sid="EZK 1:16" />चारो टईर एक जेड़े दिशो थे। सेयो चमकीले रत्नो जेड़े चमको थे। टईर ईंयाँ बणी रे थे; हर एकी टईरो बीचे एक ओर टईर बणी रा था जो तेते बीछीए ऊई की जाओ था। <verse eid="EZK 1:16" /><verse number="17" style="v" sid="EZK 1:17" />चलदे बखते सेयो टईर आपणे चऊँ कनारे चली सको थे ओर जेबे चलो थे, तेबे मुड़ो नि थे। <verse eid="EZK 1:17" /><verse number="18" style="v" sid="EZK 1:18" />तिना चऊँ टईरा रे केरे बऊत बड़े ओर डराऊणे थे ओर तिना टईरा रे केरेया रे चऊँ कनारे आखी ई आखी परिया रिया थिया।<note caller="+" style="f"><char style="fr" closed="false">1:18 </char><char style="ft" closed="false">प्रका. 4:6</char></note> <verse eid="EZK 1:18" /><verse number="19" style="v" sid="EZK 1:19" />चक्र सदा प्राणिया साथे चलो थे जेबे प्राणी ऊबे अवा दे जाओ थे तो तेबे चक्र बी तिना साथे ऊबे चखी जाओ थे। <verse eid="EZK 1:19" /><verse number="20" style="v" sid="EZK 1:20" />जेती आत्मा जाणा चाओ थी, तेथी सेयो जाओ थे ओर टईर प्राणिया साथे उठो थे, कऊँकि तिना री आत्मा टईरा दे थी। <verse eid="EZK 1:20" /><verse number="21" style="v" sid="EZK 1:21" />जेबे सेयो जिऊँदे प्राणी चलो थे, तेबे यो बी चलो थे ओर जेबे-जेबे सेओ खड़े ओ थे, तेबे सेयो बी खड़े ऊई जाओ थे ओर जेबे सेयो जमीना पाँदा ते उठो थे, तेबे टईर बी तिना साथे उठो थे, कऊँकि प्राणिया री आत्मा टईरा दे थी।<verse eid="EZK 1:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="EZK 1:22" />प्राणिया रे सिरो पाँदे सर्गो जेड़ा एक गुम्मट था जो डराणे वाल़ा बर्फा जेड़ा खतरनाक तरीके साथे चमको था ओर से तिना रे सिरो पाँदे फैलेया रा था।<note caller="+" style="f"><char style="fr" closed="false">1:22 </char><char style="ft" closed="false">यहे. 10:1 </char></note> <verse eid="EZK 1:22" /><verse number="23" style="v" sid="EZK 1:23" />गुम्मटो ते थाले तिना रे पंख एकी-दूजे रिया तरफा खे सीदे फैले दे थे ओर हर एकी प्राणिए रे दो-दो पंख थे जिना साथे तिना रा शरीर टखी रा था। <verse eid="EZK 1:23" /><verse number="24" style="v" sid="EZK 1:24" />जेबे कदी सेयो प्राणी चलो थे। तेबे तिना रे पंखा री फड़फड़ाह्टा री छेड़ माखे बऊत सारे पाणी या शक्तिमान परमेशरो री आवाजा जेड़ी या सेना रे आल्ले जेड़ी सुणो थी ओर जेबे सेयो खड़े ओ थे, तेबे आपणे पंख लटकाई देयो थे।<note caller="+" style="f"><char style="fr" closed="false">1:24 </char><char style="ft" closed="false">यहे. 10:5 </char></note> <verse eid="EZK 1:24" /><verse number="25" style="v" sid="EZK 1:25" />जेबे सेयो आपणे पंख थाले करी की जमीना पाँदे खड़े ओ थे, तो तिना रे सिरो पाँदे बणे दे गुम्मटो ते एक आवाज आई, <verse eid="EZK 1:25" /><verse number="26" style="v" sid="EZK 1:26" />गुम्मटो पाँदे एक बऊत बड़ा सिंहासनो जेड़ा कुछ था जो एक बऊत बड़े किमती पात्थरो ते बणी रा था। सिंहासनो पाँदे एक माणूं बैठेया रा था जो एक माणूंए जेड़ा दिशो था।<note caller="+" style="f"><char style="fr" closed="false">1:26 </char><char style="ft" closed="false">प्रका. 1:13 </char></note> <verse eid="EZK 1:26" /><verse number="27" style="v" sid="EZK 1:27" />मैं से तेसरे लको ते लई की पाँदली तरफा खे माखे मानो चमकाया रा पीतल़ी जेड़ा कुछ दिशेया ओर तेसरे पीतरे ओर चऊँ कनारे आग जी दिशो थी, मैं से तेसरे लको ते लई की थालो तक देखेया। से माखे कुछ आग जी दिशो थी ओर तेसरे चऊँ कनारे प्रयासा था। <verse eid="EZK 1:27" /><verse number="28" style="v" sid="EZK 1:28" />ये बादल़ा बीचे इन्द्र धनुषो रे रंगा साथे चमकणे लगी रा था जेबे बर्खा ओई। ये चमकदार प्रयासा प्रभुए री महिमा खे बताओ थी, जेबे मैं ये देखेया, तो आऊँ जानूआ रे पारे थाले जमीना पाँदे बैठीगा ओर मेरा मूँ जमीना रिया तरफा खे थाले था।<note caller="+" style="f"><char style="fr" closed="false">1:28 </char><char style="ft" closed="false">यहे. 3:23 </char></note><verse eid="EZK 1:28" /></para>
  <chapter eid="EZK 1" />
  <chapter number="2" style="c" sid="EZK 2" />
  <para style="s">यहेजकेलो रा बुलाणा</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 2:1" />परमेशरे माखे बोलेया, “ओ माणूंआ, जेबे मां तां साथे गल्ला करनिया तेबे तैं खड़े ऊई जाणा।”<note caller="+" style="f"><char style="fr" closed="false">2:1 </char><char style="ft" closed="false">प्रेरि. 26:16 </char></note> <verse eid="EZK 2:1" /><verse number="2" style="v" sid="EZK 2:2" />जिंयाँ ई तिने माखे एड़ा बोलेया, तिंयाँ ई परमेशरो री आत्मा मांदे समायी गी आऊँ पैरा पाँदे खड़ा करी ता ओर जो मां साथे गल्ला करो था, मैं तेसरी सुणी। <verse eid="EZK 2:2" /><verse number="3" style="v" sid="EZK 2:3" />तिने माखे बोलेया, “ओ नाश करने वाल़े माणूंआ, आऊँ ताखे इस्राएलिया गे, मतलब बगावत करने वाल़ी जातिया गे पेजुँआ, जिने मेरे खलाफ बगावत करी राखी, तिना रे बुजुर्ग ओर सेयो बी आजो तक मेरे खलाफ पाप करदे आई रे। <verse eid="EZK 2:3" /><verse number="4" style="v" sid="EZK 2:4" />एते पीढ़िया रे लोक जिना गे आऊँ यहोवा ताखे पेजुँआ, सेयो बेशर्म ओर टीठ ए।” <verse eid="EZK 2:4" /><verse number="5" style="v" sid="EZK 2:5" />ओर जेबे तां तिना खे मेरिया गल्ला बताणिया तो ऊई सकोआ कि सेयो बगावत करने वाल़े लोक तिना खे सुणी लो या नि बी सुणी सकदे, पर तेबे बी तिना खे इतणा पता लगी जाणा कि आसा बीचे एक भविष्यबक्ता आई रा। <verse eid="EZK 2:5" /><verse number="6" style="v" sid="EZK 2:6" />ओ माणूंआ, तैं तिना ते नि डरना, ओर ना तिना रिया गल्ला ते डरना। तिना बीचे रणा मतलब कांडे-चीट ओर चींआ बीचे रणे रे बराबर ए, पर तिना ते नि डरना। सेयो बगावत करने वाल़े लोक ए, पर तिना खे आपू पाँदे प्रबल नि ऊणे देणा। <verse eid="EZK 2:6" /><verse number="7" style="v" sid="EZK 2:7" />इजी री खातर चाए सेयो सुणो या ना सुणो, तेबे बी तैं मेरिया गल्ला तिना गे बोलणिया, सेयो तो बड़े बिद्रोही ए। <verse eid="EZK 2:7" /><verse number="8" style="v" sid="EZK 2:8" />पर ओ नाश करने वाल़े माणूंआ, जो आऊँ ताखे बोलूँआ, तूँ तेतेखे सुणी लो, तेस बिद्रोही कराने जेड़े तैं नि बणना, ओर एबे जो आऊँ ताखे देऊँआ, तेतेखे मूँ खोली की खाई लया।<note caller="+" style="f"><char style="fr" closed="false">2:8 </char><char style="ft" closed="false">यिर्म. 15:16 </char></note> <verse eid="EZK 2:8" /><verse number="9" style="v" sid="EZK 2:9" />तेबे मैं नजर दित्ती ओर देखेया कि मेरी तरफा खे एक आथ बढ़ी रा ओर तिदे एक कताब ए। <verse eid="EZK 2:9" /><verse number="10" style="v" sid="EZK 2:10" />परमेशरे से कताब मां सामणे खोली ती ओर से दोनो कनारे लिखी री थी ओर जो तिदे लिखी राखेया था, तिदे रोणे रे गाणे, कथा ओर चतौणिया रिया गल्ला थिया।<note caller="+" style="f"><char style="fr" closed="false">2:10 </char><char style="ft" closed="false">प्रका. 5:1 </char></note><verse eid="EZK 2:10" /></para>
  <chapter eid="EZK 2" />
  <chapter number="3" style="c" sid="EZK 3" />
  <para style="p">
    <verse number="1" style="v" sid="EZK 3:1" />तेबे परमेशरे माखे बोलेया, “ओ नाश करने वाल़े माणूंए रे पाऊ, जो तां सामणे राखी राखेया तिजी खे खाई दे, मतलब एसा कताबा खे खा, तेबे जाई की इस्राएलो रे कराने साथे गल्ला कर।”<note caller="+" style="f"><char style="fr" closed="false">3:1 </char><char style="ft" closed="false">प्रका. 10:9 </char></note> <verse eid="EZK 3:1" /><verse number="2" style="v" sid="EZK 3:2" />इजी री खातर मैं मूँ खोलेया ओर तिने से कताब माखे खुल़ाई ती। <verse eid="EZK 3:2" /><verse number="3" style="v" sid="EZK 3:3" />तेबे परमेशरे माखे बोलेया, “ओ माणूंआ, एसा कताबा खे जेतेखे ताखे आऊँ देऊँआ पचायी दे ओर आपणियां आन्तड़िया इजी साथे परी दे।” तेबे मैं से खाई ती ओर से मेरे मुंए दे सयीतो जेड़ी मीठी लगी। <verse eid="EZK 3:3" /><verse number="4" style="v" sid="EZK 3:4" />तेबे परमेशरे माखे बोलेया, “ओ माणूंआ, तूँ इस्राएलिया रे कराने गे जाई की मेरे वचन तिना खे सुणा। <verse eid="EZK 3:4" /><verse number="5" style="v" sid="EZK 3:5" />आऊँ ताखे तिना लोका गे पेजणे लगी रा जिना री पाषा सिखणा कठण नि ए जेते खे तूँ सिखी नि सकदा। आऊँ ताखे तेरे इस्राएली लोका गे पेजणे लगी रा। <verse eid="EZK 3:5" /><verse number="6" style="v" sid="EZK 3:6" />आऊँ ताखे तिना माणूंआ गे पेजणे लगी रा जिना री पाषा तूँ ठीक-टंगो दे समजेया। जे आऊँ ताखे तिना माणूंआ गे पेजदा जिना री पाषा ताखे समजणे दे कठण ए, तो सेयो हैरान ऊणे थे ओर तां जो तिना ते बोलणा से तिना त्यानो साथे सुणना। <verse eid="EZK 3:6" /><verse number="7" style="v" sid="EZK 3:7" />पर इस्राएलो रे लोका तेरी नि सुणनी, कऊँकि सेयो मेरी पनि सुणना चांदे, सेयो इजी री बजा ते नि सुणना चांदे कऊँकि सेयो सब बऊत जिद्दी ए। <verse eid="EZK 3:7" /><verse number="8" style="v" sid="EZK 3:8" />देख, मां तूँ तिथणा ई टीठ बनाणा जितणे सेयो ए, ओर तिथणा ई जिद्दी बनाणा जितणा सेयो ए। <verse eid="EZK 3:8" /><verse number="9" style="v" sid="EZK 3:9" />जेड़ा ईरा पात्थरो ते बी सख्त ओआ तेड़ा ई मां तेरा मन तिना रे सामणे सख्त करी देणा। तूँ तिना ते बी जादा जिद्दी ऊणा, तैं तिना ते नि डरना। तैं तिना ते बिल्कुल नि डरना कऊँकि सेयो बिद्रोही कराने रे ए।”<verse eid="EZK 3:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="EZK 3:10" />तेबे परमेशरे माखे बोलेया, “ओ माणूंआ, जितणे वचन आऊँ ताखे बोलूँ तिना सबी खे सुण ओर आपणे मनो दे राख।” <verse eid="EZK 3:10" /><verse number="11" style="v" sid="EZK 3:11" />आपणे साथी इस्राएलिया गे जा जो आपणे देशो खे छाडणे खे मजबूर ऊणे ते बाद एती बेबीलोनो दे ए, ओर तिना ते गल्ल बात कर। तिना खे बोल, “यहोवा ईंयाँ बोलोआ” ओर फेर तिना खे मेरा सन्देश बता, चाए सेयो सुणो या ना सुणो। <verse eid="EZK 3:11" /><verse number="12" style="v" sid="EZK 3:12" />तेबे तेते दर्शणो दे आऊँ परमेशरो री आत्मे ठवाल़ेया ओर मैं आपू पीछे बड़ी गड़गड़ाटी साथे एक आवाज सुणी। मैं केसी खे ये बोलदे ऊए सुणेया, “यहोवे री महिमा तेसरिया जगा दे स्तुति ओ।” <verse eid="EZK 3:12" /><verse number="13" style="v" sid="EZK 3:13" />तेबे मैं तेते साथे ई तिना प्राणिया रे पंखो री आवाज, जो एकी-दूजे साथे लगो थे ओर तिना साथे टईरा री आवाज ओर एक बड़ी गड़गड़ाट सुणी। <verse eid="EZK 3:13" /><verse number="14" style="v" sid="EZK 3:14" />तेबे परमेशरो री आत्मा माखे ठवाल़ी की लईगी ओर आऊँ कठण दु:खो साथे परेया रा ओर मनो दे रोषे ऊँदा ऊआ चली गा ओर यहोवे री शक्ति मां पाँदे प्रबल थी। <verse eid="EZK 3:14" /><verse number="15" style="v" sid="EZK 3:15" />आऊँ इस्राएलो रे तिना कैदी लोका गे आई गा जो बेबीलोनो रिया दक्खणा दे कबार नदिया रे कनारे तेलाबीब नाओं रे छोटे गाँवो दे रओ थे। तेती आऊँ साता दिना तक तिना बीचे बेचैन ऊई की बैठेया दा रया। मैं जो कुछ बी देखेया, तिजी ते आऊँ हैरान रईगा।<verse eid="EZK 3:15" /></para>
  <para style="s">परमेशरो रा यहेजकेलो खे पईरेदार बनाणा</para>
  <para style="p">
    <verse number="16" style="v" sid="EZK 3:16" />जेबे सात दिन बीतीगे, तेबे परमेशरो रा ये वचन मांगे पऊँचेया, <verse eid="EZK 3:16" /><verse number="17" style="v" sid="EZK 3:17" />“ओ माणूंआ, मैं तूँ इस्राएलो रे कराने खे पईरेदार ठराई राखेया, तैं मेरे मुंए रिया गल्ला सुणी की तिना खे चतौणी देई की बोलणा।<note caller="+" style="f"><char style="fr" closed="false">3:17 </char><char style="ft" closed="false">यहे. 33:7 </char></note> <verse eid="EZK 3:17" /><verse number="18" style="v" sid="EZK 3:18" />जेबे आऊँ कुछ दुष्ट लोका रे बारे दे बोलूँआ, सेयो आपणे पापो रिया बजा ते जरूर मरने ओर जे तूँ तिना खे सावधान नि करे ओर ना दुष्टा खे ये बोले कि जे तुसे जिऊँदे रणा चाओए तो तिना खे आपणे बुरे कामा ते मुड़ना पड़ना, तो सेयो दुष्ट लोक आपणे कित्ते रे पापो रिया बजा ते मरने, पर तेसरिया मौता रा लेखा मां तांते ई लणा। <verse eid="EZK 3:18" /><verse number="19" style="v" sid="EZK 3:19" />पर जे तूँ दुष्टो खे सावधान करे ओर से आपणे बुरे काम करने ते नि फिरो, तो से आपणे बुरे कामो दे फसेया दा ई मरी जाणा, पर तां आपणे प्राण बचाणे। <verse eid="EZK 3:19" /><verse number="20" style="v" sid="EZK 3:20" />तिंयाँ ई, जे तर्मी माणूं आपणे तर्मो ते फिरी की बुरे काम करने लगो तो मां तेस साथे बुरा बर्ताओ करना, पर तां तिना खे चतौणी देणी चाईयो। जे तूँ तिना खे चतौणी नि देगा ओर सेयो आपणे बुरे कामा ते नि फिरो, तो सेयो आपणे पापो रिया बजा ते मरी जाणे, ओर जो तर्मो रे काम तिने करी राखे ऊगे, तिना री सुधि नि लई जाणी, पर तिना रे खूनो रा लेखा मां तांते ई लणा। <verse eid="EZK 3:20" /><verse number="21" style="v" sid="EZK 3:21" />पर जे तूँ तर्मिया खे एड़ा बोली की सावधान करे कि से पाप नि करो ओर से पापो ते बची जाओ, तो से चतौणी मानणे रिया बजा ते जरूर जिऊँदे रणे ओर तां आपणे प्राण बचाणे।”<verse eid="EZK 3:21" /></para>
  <para style="s">यहेजकेल बोलणे दे असमर्थ</para>
  <para style="p">
    <verse number="22" style="v" sid="EZK 3:22" />तेबे मैं यहोवे रा तेती मां साथे ऊणा महसूस कित्तेया ओर तिने माखे बोलेया, “उठी की शईरो ते बारे मैदानो दे जा ओर तेती मां तां साथे गल्ला करनिया।” <verse eid="EZK 3:22" /><verse number="23" style="v" sid="EZK 3:23" />तेबे आऊँ उठी की बारे मैदानो दे गया ओर मैं तेती देखेया कि यहोवे रा प्रताप जेड़ा माखे कबार नदिया पाँदे, तेड़ा ई एती बी दिशणे लगी रा ओर आऊँ आदर करने खे मुंए रे पारे थाले जमीना पाँदे पड़ीगा। <verse eid="EZK 3:23" /><verse number="24" style="v" sid="EZK 3:24" />तेबे परमेशरो री आत्मा माँदे आईगी ओर तेसे आऊँ पैरा रे पारे खड़ा कित्तेया, तेबे से माखे बोलणे लगेया, “आपणे कअरो रे पीतरे जाई की द्वार बन्द करी की बैठी जा। <verse eid="EZK 3:24" /><verse number="25" style="v" sid="EZK 3:25" />ओ नाश करने वाल़े माणूंआ, देख, तिना लोका तूँ रस्सिया साथे बानी की राखणा ओर तूँ निकल़ी की तिना लोका बीचे जाई नि सकणा। <verse eid="EZK 3:25" /><verse number="26" style="v" sid="EZK 3:26" />कऊँकि सेयो बिद्रोह करने वाल़े लोक ए। मां तेरी जीब तेरे ताल़ूए साथे लगाणी, जेते कि तूँ तिना खे बकी नि सकणा। <verse eid="EZK 3:26" /><verse number="27" style="v" sid="EZK 3:27" />पर जेबे मां तां साथे गल्ला करनिया, तेबे मां तेरा मूँ खोलणा ओर तैं तिना खे एड़ा बोलणा, ‘परमेशर यहोवा ईंयाँ बोलोआ’, ओर तैं मेरा सन्देश सुनाणा। जो लोक तेरिया गल्ला सुणने वाल़े ऊणे तिना तो सुणना, पर बऊत जे लोका नि सुणना, कऊँकि सेयो बिद्रोह करने वाल़े लोक ए।”<verse eid="EZK 3:27" /></para>
  <chapter eid="EZK 3" />
  <chapter number="4" style="c" sid="EZK 4" />
  <para style="s">यरूशलेमो री केराबन्दी ऊणे री भविष्यबाणी</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 4:1" />परमेशरे माखे ये बी बोलेया, “ओ माणूंआ, एक ईट लओ ओर तेतेखे आपणे सामणे राखी की तेते पाँदे यरूशलेम शईरो खे बताणे वाल़िया लाईनी लगा। <verse eid="EZK 4:1" /><verse number="2" style="v" sid="EZK 4:2" />फेर केरा पाणे खे अगुवाई करने खे कि सिपाई शईरो पाँदे अमला करने खे त्यार ए। इजी रे चऊँ कनारे माट्टिया रे टेर लगा ताकि कोई बी बची नि सको। शईरो रे चऊँ कनारे लकड़िया रे बड़े टुकड़े राख, जेते रा इस्तेमाल दुश्मण एतेरिया दवाला तोड़ने खे करी सको। <verse eid="EZK 4:2" /><verse number="3" style="v" sid="EZK 4:3" />तेबे तूँ लोए रा तवा लई की तेतेखे लोए री दवाल मानी की आपणे ओर तेस शईरो बीचे खड़ा कर, तेबे आपणा मूँ तेतेरे सामणे करी की तेस केरी लओ, ईंयाँ तैं से केरी की राखणा। ये इस्राएलो रे कराने खे नशाण ठईरना। <verse eid="EZK 4:3" /><verse number="4-5" style="v" sid="EZK 4:4-5" />तेबे तैं आपणे खूँजे कनारे लेटणा, ये बताणे खे कि इस्राएलो रे पाप तैं आपू पाँदे लई राखे ए, तां 390 दिना तक कष्टो दे रणा। ये तिना साला री गिणतिया खे बताणे वाल़ा ऊणा जो मैं इस्राएलो रे लोका खे सजा देणे रिया तँईं राखी राखे ए। हर दिन जो तां कष्ट सईन करना से तिना री सजा रा एक साल ऊणा। <verse eid="EZK 4:4-5" /><verse number="6" style="v" sid="EZK 4:6" />जेबे 390 बुरे दिन पूरे ऊई जाणे, तेबे आपणे दाँणे कनारे लेटी की यहूदा रे लोका रे पापा रा बोज सयीन करी लया, मैं तेसखे बी ओर ताखे एक सालो रे बदले एक दिन, मतलब चाल़ी दिन ठराई राखे। <verse eid="EZK 4:6" /><verse number="7" style="v" sid="EZK 4:7" />तैं आपणा मूँ दुश्मणा रे केरे दे यरूशलेमो रिया तरफा खे करी की ओर आपणी बाँ सिपाईया जेड़ी चकी की तिना रे खलाफ भविष्यबाणी करनी। <verse eid="EZK 4:7" /><verse number="8" style="v" sid="EZK 4:8" />देख, मां तूँ रस्सिया साथे बानणा ओर जदुओ तक तेसरे केरने रे दिन पूरे नि ओ, तदुओ तक तूँ फिरी नि सकणा।”<verse eid="EZK 4:8" /></para>
  <para style="s">अशुद्ध रोटी</para>
  <para style="p">
    <verse number="9" style="v" sid="EZK 4:9" />इजी ते पईले कि तूँ एड़ा करे, तैं कणक, जौ, फ्रासबीन, मस्सर, बाजरा ओर कणका रा आटा लई की एकी पांडे दे राखी की, तिना साथे रोटिया बणाया करना। जितणे दिना तक तूँ आपणे एकी कनारे लेटेया रा रणा, मतलब 390 दिना तक सेई खाया करना। <verse eid="EZK 4:9" /><verse number="10" style="v" sid="EZK 4:10" />जो रोटी तूँ खाएगा, से तोली-तोली की खाणी, मतलब रोज 200 ग्राम रोटी खाया करनी ओर से रोटी पूरा दिन बखतो-बखतो पाँदे खाया करनी। <verse eid="EZK 4:10" /><verse number="11" style="v" sid="EZK 4:11" />तैं पाणी बी नापी की पिया करना, मतलब 600 ग्राम पाणी एकी दिनो दे पिया करना ओर से बखतो-बखतो पाँदे पीणा। <verse eid="EZK 4:11" /><verse number="12" style="v" sid="EZK 4:12" />आपणी रोटी जौ री रोटिया जेड़ी बणाई की खाया करनी, तैं सेयो रोटिया तेबे बणाया करनिया, जेबे माणूं टट्टी करने लगी रा ओ।<verse eid="EZK 4:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="EZK 4:13" />फेर यहोवे बोलेया, “ईंयाँ ई इस्राएलो रे लोका तिना जातिया बीचे आपणी-आपणी अशुद्ध रोटी जो बिधानो रे खलाफ ए खाया करनी, जेती मां सेयो जबरदस्ती पऊँचाणे।” <verse eid="EZK 4:13" /><verse number="14" style="v" sid="EZK 4:14" />तेबे मैं बोलेया, “ना, परमेशर यहोवा! माखे एड़ा करने खे मजबूर नि कर! मैं कदी बी कोई एड़ा काम नि कित्तेया कि आऊँ अशुद्ध ऊई जाऊँ। जेबे आऊँ छोटा था मैं कदी बी एड़ा मास नि खाया जेते की आऊँ अशुद्ध ऊई सकूँ। मैं ना तो मरे दे जानवरो रा मास खाया ओर ना ई एड़े जानवरो रा मास खाया जो दूजे जानवरे काई राखेया ओ।”<note caller="+" style="f"><char style="fr" closed="false">4:14 </char><char style="ft" closed="false">प्रेरि. 10:14 </char></note> <verse eid="EZK 4:14" /><verse number="15" style="v" sid="EZK 4:15" />तेबे परमेशरे माखे बोलेया, “देख, मैं तेरिया तँईं माणूंआ रे गूओ रे बदले बल़दो रा गोबर ठराई राखेया ओर तैं तिजी साथे ई आपणी रोटी बनाणी।” <verse eid="EZK 4:15" /><verse number="16" style="v" sid="EZK 4:16" />तेबे परमेशरे माखे बोलेया, “ओ माणूंआ, देख, मां यरूशलेमो ते खाणे खे नज्ज दूर करी देणा, इजी री खातर तेथो रे लोका तोली-तोली की ओर फिकर करी की रोटी खाया करनी ओर नापी-नापी की पाणी पिया करना। <verse eid="EZK 4:16" /><verse number="17" style="v" sid="EZK 4:17" />कऊँकि रोटी ओर पाणी बऊत ई कम ऊई जाणे। सेयो सारे के सारे डरो रे मारे एकी दूजे खे देखणे लगणे ओर कमजोर ऊई जाणे, ये सब इजी बजा ते ऊणा कि तिना खे तिना रे पापो री सजा मिलणे लगी री।”<verse eid="EZK 4:17" /></para>
  <chapter eid="EZK 4" />
  <chapter number="5" style="c" sid="EZK 5" />
  <para style="s">यहेजकेलो रा आपणे बाल कटवाणे रे जरीये यरूशलेमो रा नाश दखाणा</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 5:1" />परमेशरे माखे फेर बोलेया, “ओ नाश करने वाल़े माणूंआ, जेबे तूँ ये काम करना शुरू करे, तो एक पैनी तलवार लओ ओर तिजी रा नाईए रे उस्तरे जेड़ा इस्तेमाल करी की आपणे सिर ओर दाढ़िया रे बाल़ कटाई दे, तेबे ताकड़ी लई की बाल़ा खे तीऊँ बराबर इस्सेया दे लग-लग करी दे।” <verse eid="EZK 5:1" /><verse number="2" style="v" sid="EZK 5:2" />जदुए तक यरूशलेमो रे केराबन्दिया रे दिन पूरे नि ऊई जाओगे, तदुए तक इन्तजार करदा रओ। आपणे बाल़ा रा एक इस्सा लओ ओर तेस यरूशलेम शईरो री तस्वीरा वाल़ी ईटा पाँदे फुकी दे। दूजा इस्सा लई की तलवारे की तिजी रे छोटे-छोटे टुकड़े करी दे। ओर तिना टुकड़ेया खे ईटा रे चऊँ कनारे सेटी दे, जेते दे शईर दिशोआ। फेर तीजा इस्सा लई की बाल़ा खे हवा दे ऊबे सेट। मां आपणी तलवार म्यानो ते काडी की तिना पीछे दौड़ना। <verse eid="EZK 5:2" /><verse number="3" style="v" sid="EZK 5:3" />तेबे इना बीचा ते थोड़े जे बाल़ लई की आपणे टाल्ले रे कुणे दे बानी देणे। <verse eid="EZK 5:3" /><verse number="4" style="v" sid="EZK 5:4" />तेबे तिना बीचा ते बी कुछ लई की आगी बीचे सेटणे ताकि सेयो आगी दे फूखी जाओ, ये एते गल्ला री नशाणी ऊणी की यरूशलेमो ते आग फैलणी ओर सारे इस्राएलो दे सब कुछ नाश ऊई जाणा।<verse eid="EZK 5:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="EZK 5:5" />आऊँ, परमेशर यहोवा, ईंयाँ बोलूँआ, “ये चित्र यरूशलेमो रे बारे दे बताओआ, से शईर जो मैं देशा बीचे बसाई राखेया ए, जेतेरे चऊँ कनारे दूजे देश ए। <verse eid="EZK 5:5" /><verse number="6" style="v" sid="EZK 5:6" />पर यरूशलेमो रे दुष्ट लोके मेरिया आज्ञा ना मानी की बिद्रोह करी राखेया, ओर सेयो तिना लोका ते बी जादा दुष्ट ए जो तिना रे चऊँ कनारे रओए। तिने मेरिया बिधिया नि मानिया ओर मेरिया आज्ञा खे मानणे खे ना करी राखी।” <verse eid="EZK 5:6" /><verse number="7" style="v" sid="EZK 5:7" />इजी बजा ते परमेशर यहोवा ईंयाँ बोलोआ कि तुसे लोक जो आपणी चऊँ कनारली जातिया ते जादा बुराई करोए ओर ना मेरी बिधिया पाँदे चलदे, ना मेरे नियम मानदे ओर आपणे चऊँ कनारली जातिया रे नियमो रे मुताबिक पनि कित्तेया, <verse eid="EZK 5:7" /><verse number="8" style="v" sid="EZK 5:8" />इजी बजा ते परमेशर यहोवा ईंयाँ बोलोआ: देख, आऊँ आपू यरूशलेम शईरो रे लोका रे खलाफ आ। मां तुसा खे सजा देणी, ओर दूजे देशो रे लोका ये सब ऊँदे ऊए देखणा। <verse eid="EZK 5:8" /><verse number="9" style="v" sid="EZK 5:9" />यरूशलेमो रे लोको, तुसा रिया सब घृणित मूर्तिया रिया बजा ते मां तुसा खे सजा देणी जेड़ी ना तो आजो तक देई राखी ओर ना बादो ते देणी। <verse eid="EZK 5:9" /><verse number="10" style="v" sid="EZK 5:10" />यरूशलेमो रे लोक पूखा ते इतणे तड़फणे कि माया-बाओ खाणे खे इतणे लाचार ऊई जाणे कि तिना आपणे बच्चे खाणे ओर बच्चेया आपणे माये-बाओ खाणे ओर मां तुसा खे कईया प्रकारा री सजा देणी, <verse eid="EZK 5:10" /><verse number="11" style="v" sid="EZK 5:11" />ओर तुसा बीचे बचे रे सारे लोक चऊँ कनारे तित्तर-बित्तर करी देणे। इजी री खातर परमेशर यहोवा ईंयाँ बोलोआ, “मेरी जिन्दगिया री कसम, कऊँकि तुसे मेरी पवित्र जगा आपणी सारी घिनौनी मूर्तिया ओर सारे घिनौने कामो साथे अशुद्ध करी राखे, मां तुसे कटाणे ओर तुसा पाँदे दया नि करनी ओर तुसा पाँदे कोई दया नि करनी। <verse eid="EZK 5:11" /><verse number="12" style="v" sid="EZK 5:12" />तुसा रे एक तिहाई लोक यरूशलेम शईरो ते पीतरे बमारिया ओर पूखा ते मरने, एक तिहाई लोक तुसा रे दुश्मणा री तलवारी साथे मरने ओर एक तिहाई मां चऊँ कनारे तित्तर-बित्तर करी देणे, पर तेबे बी तुसा रे दुश्मणा फेर तुसा रा पीछा करना ओर आपणियां तलवारी की तुसे काणे। ओर तलवार खींजी की तिना पीछे चलवाणी।<note caller="+" style="f"><char style="fr" closed="false">5:12 </char><char style="ft" closed="false">प्रका. 6:8 </char></note> <verse eid="EZK 5:12" /><verse number="13" style="v" sid="EZK 5:13" />ईंयाँ मेरा कोप शान्त ऊणा ओर आपणी जल़न तिना पाँदे पड़काई की माखे शान्ति मिलणी ओर जेबे आऊँ आपणी जल़न पूरी तरअ ते तिना पाँदे पड़काई चुकूँगा, तेबे यहूदा ओर यरूशलेमो रे लोका खे पता लगी जाणा कि मैं परमेशरे रोषो दे आई की ये सब कुछ करी राखेया।” <verse eid="EZK 5:13" /><verse number="14" style="v" sid="EZK 5:14" />मां तुसा रा शईर खण्डहर बणाई देणा, ओर तुसा रे नेड़े-तेड़े रणे वाल़े दूजे देशो रे लोक तीसिए जाणे, तिना से शईर देखणा ओर तुसा रा मजाक उडाणा। <verse eid="EZK 5:14" /><verse number="15" style="v" sid="EZK 5:15" />इजी री खातर जेबे मां तुसा खे बऊत रोषो दे ओर जल़नी दे आई की सजा देणी, तेबे तुसा री चऊँ कनारली जातिया सामणे बेज्जती, मजाक, शिक्षा ओर हैरानी ऊणी, सेयो डरी जाणे ओर तिना खे चतौणी देणी। ये सब जरूर ऊणा कऊँकि मैं यहोवे ये बोली राखेया ए। <verse eid="EZK 5:15" /><verse number="16" style="v" sid="EZK 5:16" />ये तेस बखते ऊणा, जेबे मां तिना लोका रा नाश करने खे तुसा पाँदे अकाल़ो रे पैने तीर चलायी की, तुसा बीचे अकाल़ बढ़ाणा। <verse eid="EZK 5:16" /><verse number="17" style="v" sid="EZK 5:17" />मां तुसा खे अकाल़ो रा अनुभव कराणा, ओर मां तुसा पाँदे ओर तुसा रे बच्चेया पाँदे अमला करने खे दुष्ट जानवर पेजणा, ओर तुसा रे सारे बच्चे काये जाणे। तुसा विपत्तिया ओर लड़ाईया रा अनुभव करना, ओर मां तुसा रे दुश्मण तुसा पाँदे अमला करने देणे। मैं यहोवे येई बोली राखेया।<note caller="+" style="f"><char style="fr" closed="false">5:17 </char><char style="ft" closed="false">प्रका. 6:8 </char></note><verse eid="EZK 5:17" /></para>
  <chapter eid="EZK 5" />
  <chapter number="6" style="c" sid="EZK 6" />
  <para style="s">इस्राएलो रे पाह्ड़ो रे खलाफ भविष्यबाणी</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 6:1" />तेबे यहोवे रा ये एक ओर सन्देश मांगे पऊँचेया, <verse eid="EZK 6:1" /><verse number="2" style="v" sid="EZK 6:2" />तिने बोलेया, “ओ माणूंआ आपणा मूँ इस्राएलो रे पाह्ड़ो रिया तरफा खे करी की तिना रे खलाफ भविष्यबाणी कर कि तिना साथे क्या ऊणा।” <verse eid="EZK 6:2" /><verse number="3" style="v" sid="EZK 6:3" />ओ इस्राएलो रे पाह्ड़ो ओर पाह्ड़ियो, सुणो परमेशर यहोवा तुसा ते क्या बोलोआ, “मां लड़ाईया री तलवार पेजणी ओर तुसा रे पूजा करने री मूर्तिया रे मन्दर जो पाह्ड़ो पाँदे ए तोड़ी देणे। <verse eid="EZK 6:3" /><verse number="4" style="v" sid="EZK 6:4" />मूर्तिया खे बलि चढ़ाणे खे जो तुसा री बेदिया ए सेयो तोड़ी की टुकड़े-टुकड़े करी देणियां। तुसा री सूरजो रिया मूर्तिया तोड़ी देणियां ओर मां सेयो लोक जो मूर्तिया री पूजा करोए कायी देणे। <verse eid="EZK 6:4" /><verse number="5" style="v" sid="EZK 6:5" />मां इस्राएलिया री लाशा तिना री मूर्तिया सामणे राखणियां ओर तिना री आड्डिया तुसा रे नेड़े-तेड़े बखेरी देणियां। <verse eid="EZK 6:5" /><verse number="6" style="v" sid="EZK 6:6" />इस्राएलो रे सारे शईर नाश करी देणे, तिना रिया सब बेदिया ओर तिना रिया मूर्तिया रे टुकड़े-टुकड़े करी देणे, तिना रिया तूपो रिया बेदिया चूर-चूर ऊई जाणिया, ओर जो कुछ तिने बणाई राखेया से सब राची जाणा। <verse eid="EZK 6:6" /><verse number="7" style="v" sid="EZK 6:7" />तुसा रे लोक मारे जाणे ओर तेबे तुसा बीचा ते जो लोक बची जाणे तिना मानी लणा की आऊँ यहोवा ए। <verse eid="EZK 6:7" /><verse number="8" style="v" sid="EZK 6:8" />परमेशरे बोलेया, तेबे बी मां तुसा रे कई लोक बचाणे। इजी री खातर जेबे तुसे देश-देशो दे ओरे-पोरे बिखरी जाओ, तेबे दूजी जातिया बीचे तुसा रे कई लोक तलवारी साथे मरने ते बची जाणे। <verse eid="EZK 6:8" /><verse number="9" style="v" sid="EZK 6:9" />तेबे तिना बचे रे लोका, तिना जातिया बीचे, जिना दे सेयो गुलाम ऊई की जाणे, आऊँ याद करना ओर ये बी कि म्हारा मूर्तिपूजा करने वाल़ा विश्वासघाती मन यहोवे ते केड़ा अटी गा रा ओर म्हारी व्याभिचारणिया जेड़िया आखी मूर्तिया पाँदे केड़िया लगी रिया, जेते कि यहोवे रा मन टूटी रा। ईंयाँ तिना बुराईया रिया बजा ते, जो तिने आपणी बणाई री मूर्तिया री आराधना करी की करी राखिया, सेयो आपणी नजरा दे घिनौने ठईरने। <verse eid="EZK 6:9" /><verse number="10" style="v" sid="EZK 6:10" />तेबे तिना खे पता लगी जाणा कि मैं यहोवे ई तिना खे सजा देई राखी। सेयो समजी जाणे की जेबे मैं तिना खे सजा देणे री तमकी दित्ती थी, तो मेरा पक्का इरादा था की मां एड़ा करना था।” <verse eid="EZK 6:10" /><verse number="11" style="v" sid="EZK 6:11" />इजी री खातर आऊँ परमेशर यहोवा तांते बोलूँआ, “यहेजकेल आपणे आथ-पैर पटक ओर चींगी की बोल कि तूँ कितणा बेचैन आ, ओर मेरे इस्राएली लोका साथे क्या ऊणा, इजी बजा ते रोओ, कऊँकि तिना रे सारे बुरे कामा ओर बुरे बर्ताओ रिया बजा ते आपणे दुश्मणा रिया तलवारी की मरने, ओर पूख ओर बमारिया ते मरने। <verse eid="EZK 6:11" /><verse number="12" style="v" sid="EZK 6:12" />दूरो रे लोक बमारिया साथे मरने। ओर जो नेड़े ऊणे सेयो लड़ाईया दे तलवारी साथे काये जाणे ओर जो बची की शईरो दे रंदे ऊए केरेया जाओ, से पूखा साथे मरना। ईंयाँ मां आपणा रोषो री तागत तिना पाँदे पूरी तरअ ते उतारनी। <verse eid="EZK 6:12" /><verse number="13" style="v" sid="EZK 6:13" />जेबे हर एक ऊच्ची पाह्ड़िया ओर पाह्ड़ो री हर एक चूँडिया पाँदे, हर एक अरे डाल़ो निठे ओर हर एक कणे बड़े डाल़ो री छांयी निठे, जेती-जेती सेयो आपणी मूर्तिया खे सुख देणे वाल़े खुशबूदार द्रव्य चढ़ाओए, तेती तिना रे काये रे लोक आपणी बेदिया रे नेड़े-तेड़े आपणी मूर्तिया बीचे पड़े रे रणे, तेबे तुसा लोका खे पता लगी जाणा कि आऊँ परमेशर यहोवा ए। <verse eid="EZK 6:13" /><verse number="14" style="v" sid="EZK 6:14" />मां आपणा आथ तिना रे खलाफ बढ़ाई की से देश, दक्खणा रे रेगिस्तानो ते लई की उत्तरा दे रिबला शईरो तक, उजाड़ करी देणे। तेबे तिना खे पता लगी जाणा कि आऊँ ई परमेशर यहोवा ए ओर जो बोलूँआ से करूँआ।”<verse eid="EZK 6:14" /></para>
  <chapter eid="EZK 6" />
  <chapter number="7" style="c" sid="EZK 7" />
  <para style="s">अन्तो रा आऊणा</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 7:1" />तेबे यहोवे रा ये एक ओर सन्देश मांगे पऊँचेया, <verse eid="EZK 7:1" /><verse number="2" style="v" sid="EZK 7:2" />तिने बोलेया “ओ नाश करने वाल़े माणूंआ, आऊँ परमेशर यहोवा, इस्राएलो रे लोका खे ईंयाँ बोलोआ: सारे इस्राएल देशो रे नाश ऊणे रा बखत आईगा दा ए।<note caller="+" style="f"><char style="fr" closed="false">7:2 </char><char style="ft" closed="false">यहे. 7:5 </char></note> <verse eid="EZK 7:2" /><verse number="3" style="v" sid="EZK 7:3" />ओ इस्राएल, तेरे लोका रा अन्त बी आई गा ओर मां आपणा रोष तुसा पाँदे पड़काई की तुसा रे चाल-चलणो रे मुताबिक तुसा खे सजा देणी ओर तुसा रे सारे घिनौने कामा रा फल तुसा खे देणा। <verse eid="EZK 7:3" /><verse number="4" style="v" sid="EZK 7:4" />मां तुसा पाँदे कोई दया नि करनी ओर ना करूणा करनी। मां तुसा रे बुरे बर्ताओ रिया तँईं तुसा खे पक्का सजा देणी। तेबे तुसा खे पता लगी जाणा कि ये सब इजी बजा ते ऊआ कऊँकि मैं यहोवे ये करी राखेया। <verse eid="EZK 7:4" /><verse number="5" style="v" sid="EZK 7:5" />परमेशर यहोवा ईंयाँ बोलोआ: तुसा पाँदे एक ते बाद एक मुसीबत आऊणे लगी री, <verse eid="EZK 7:5" /><verse number="6" style="v" sid="EZK 7:6" />अन्त आऊणे लगी रा ओर से बऊत छोड़ आई जाणा। <verse eid="EZK 7:6" /><verse number="7" style="v" sid="EZK 7:7" />ओ इस्राएल देशो रे रणे वाल़ेयो, तुसे नाश ऊई जाणे। बखत आई गा, दिन नेड़े ए, जेबे तुसे नाश ऊई जाणे। तेस बखते पाह्ड़ो रे मन्दरा पाँदे मूर्तिपूजा करने वाल़े लोक खुश नि ऊणे पर डरी जाणे।”<verse eid="EZK 7:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="EZK 7:8" />एबे बऊत छोड़ मां आपणा रोष तुसा पाँदे पड़काणा ओर तुसा पाँदे पूरा रोष त्वारना ओर तुसा रे चाल-चलणो रे मुताबिक तुसा खे सजा देणी ओर तुसा रे सारे घिनौने कामो रा फल तुसा खे पुगताणा। <verse eid="EZK 7:8" /><verse number="9" style="v" sid="EZK 7:9" />मेरी दया तुसा पाँदे नि ऊणी ओर ना मां तुसा पाँदे कोई करूणा करनी। मां तुसा रे बुरे चाल-चलणो रा फल तुसा खे पुगताणा ओर तुसा रे घिनौने पाप तुसा दे बणे दे रणे। तेबे तुसा खे पता लगी जाणा कि आऊँ यहोवा सजा देणे वाल़ा ए। <verse eid="EZK 7:9" /><verse number="10" style="v" sid="EZK 7:10" />देखो, तुसा री मुसीबता रा दिन आईगा रा ए! तुसा पाँदे बड़ी पारी मुसीबत आऊणे वाल़ी ए! एकी डाल़ो जेड़े जिदे फूल आऊणे वाल़ा ए, तुसा रे कमण्ड ओर बुरे काम सजा रिया तँईं त्यार ए। <verse eid="EZK 7:10" /><verse number="11" style="v" sid="EZK 7:11" />उपद्रव बढ़दे-बढ़दे दुष्टता री सजा बणीगी, इस्राएलो रे लोका बीचा ते कोई नि बचणा ओर ना तिना रा वैभव, ना तिना रा बऊत तअन ओर ना तिना रा खास ऊणे बीचा ते कुछ रणा ओर ना तिना रिया तँईं केसी शोग करना। <verse eid="EZK 7:11" /><verse number="12" style="v" sid="EZK 7:12" />बखत आई गा, दिन नेड़े आई गा रा, ना तो खरीदणे वाल़ा खुशी मनाओ ओर ना बेचणे वाल़ा दु:ख करो, इस्राएलो रे सारे लोक जो एबु बी देशो दे रणे लगी रे तिना पाँदे कोप पड़की रा। <verse eid="EZK 7:12" /><verse number="13" style="v" sid="EZK 7:13" />चाए सेयो जिऊँदे रओ जो बी माणूं आपणी जमीन बेचो आ, तेसखे से जमीन फेर नि मिलणी, जदुए तक से जिऊँदा ए। परमेशरे दशी राखेया ए कि तेसा पीड़ा रे खलाफ न्याय ओर नाशो रा दर्शण नि बदलणा। तेस आपणा मन नि बदलणा। सब कोई आपणे पापो रिया बजा ते नाश ऊणे। <verse eid="EZK 7:13" /><verse number="14" style="v" sid="EZK 7:14" />सिपाईए लड़ाईया खे त्यार ऊणे रिया तँईं नरसिंगा बजाया। पर लड़ाई लड़ने खे कोई बी बारे नि जांदा, कऊँकि इस्राएलो रे सबी लोका पाँदे मेरा रोष पड़की रा।<verse eid="EZK 7:14" /></para>
  <para style="s">इस्राएलो रे पापो री सजा</para>
  <para style="p">
    <verse number="15" style="v" sid="EZK 7:15" />जेबे यो गल्ला ऊणिया, तेबे तेरे दुश्मण तलवारा लई की शईरो ते बारे सड़का दे खड़े ऊणे, ओर शईरो रे पीतरे कअरा दे अकाल़ ओर बमारिया ऊणिया। जो लोक शईरो ते नठी की बणो दे चली जाणे सेयो दुश्मणा रिया तलवारी की लड़ाईया दे मरने। ओर जो शईरो दे रई जाणे, सेयो अकाल़ ओर बमारिये की मरने। <verse eid="EZK 7:15" /><verse number="16" style="v" sid="EZK 7:16" />मां तिना बीचा ते जो बची की निकल़ना सेयो बचणे तो आए, पर आपणे-आपणे बुरे कामो दे फसे रे तराईया दे रणे वाल़े कबूतरो जेड़े पाह्ड़ो पाँदे दु:खी रणे। <verse eid="EZK 7:16" /><verse number="17" style="v" sid="EZK 7:17" />सबी रे आथ टीले ओर सबी रे जानू बऊत कमजोर ऊई जाणे। <verse eid="EZK 7:17" /><verse number="18" style="v" sid="EZK 7:18" />तिना लको दे टाट बानणी ओर आपणा दु:ख बताणे खे तिना रे बाल़ बिखरे दे ऊणे, सबी रे मूँ सूकी जाणे ओर सबी रे सिर गँजे ऊई जाणे। <verse eid="EZK 7:18" /><verse number="19" style="v" sid="EZK 7:19" />तिना आपणे चाँदिए रे देवतेया रिया मूर्तिया सड़का दे सेटी देणियां ओर तिना आपणे सूईने रे देवतेया रिया मूर्तिया अशुद्ध ठराणियां, यहोवे रे बऊत रोषो रे दिने तिना रे सूईने-चाँदिए रिया मूर्तिया तिना खे बचायी नि सकदिया, ना तिजी साथे तिना रे जियूए खे सन्तुष्टि मिलणी, ना तिना रे पेट परने। कऊँकि से तिना रे बुरे कामो री ठोकरा री बजा ऊई रा। <verse eid="EZK 7:19" /><verse number="20" style="v" sid="EZK 7:20" />तिना लोका खे आपणे सुन्दर सूईने रे गईणेया पाँदे कमण्ड था। तिने तिना रा इस्तेमाल घिनौनी मूर्तिया ओर चित्र बनाणे खे कित्तेया। इजी री खातर मैं यहोवे तिना रिया किमती चीजा ते तिना खे नफरत करवाई ती। <verse eid="EZK 7:20" /><verse number="21" style="v" sid="EZK 7:21" />मां तिना रा सूईना-चाँदी लुटणे खे परदेशिया रे आथो दे ओर पैसा छुड़ाणे खे तरतिया रे दुष्ट लोका रे वशो दे करी देणा ओर तिना से अशुद्ध करी देणा। <verse eid="EZK 7:21" /><verse number="22" style="v" sid="EZK 7:22" />मां तिना ते आपणा मूँ फेरी लणा, तेबे तिना मेरा किमती मन्दर अपवित्र करी देणी, डाकूआ तिदे कूसी की से अपवित्र करी देणी। <verse eid="EZK 7:22" /><verse number="23" style="v" sid="EZK 7:23" />एक साँगल़ बणाई दे, कऊँकि देश अन्याय री अत्या साथे ओर यरूशलेम शईर उपद्रवो साथे फरेया राए। <verse eid="EZK 7:23" /><verse number="24" style="v" sid="EZK 7:24" />मां दूजी जातिया रे बुरे ते बुरे लोक ल्याऊणे, ओर तिना लोका इस्राएलो रे लोका रे कअरो रे मालक ऊई जाणे ओर मां तागतवरा रा कमण्ड तोड़ी देणा ओर तिना री पवित्र जगा अपवित्र करिया जाणिया। <verse eid="EZK 7:24" /><verse number="25" style="v" sid="EZK 7:25" />जेबे सेयो नाश ऊई जाणे, तेबे तिना खे शान्ति टोल़ने ते पनि मिलणी। <verse eid="EZK 7:25" /><verse number="26" style="v" sid="EZK 7:26" />एकी ते बाद एक मुसीबत आऊणी। खतरनाक चीजा रे बारे दे बऊत सारिया गल्ला आऊणियां। लोका भविष्यबक्तेया ते पूछणा कि तिना खे क्या ऊणा। पुरोईता गे लोका खे सखाणे खे कुछ नि ऊणा। बुजुर्गा गे देणे खे कोई खरी सलाह् नि ऊणी। <verse eid="EZK 7:26" /><verse number="27" style="v" sid="EZK 7:27" />तुसा रे राजे शोक करना, ओर तेसरे अधिकारिया उम्मीद छाडी देणी ओर दु:खी ऊई की रोणे, ओर लोक डरो रे मारे थरथराई जाणे। मां तुसा खे तुसा रे कित्ते रे बुरे कामा रिया बजा ते सजा देणी, ओर तुसा खे सजा देणी जिंयाँ तुसे ओरी ना न्याय करोए। तेबे तिना खे पता लगी जाणा कि आऊँ परमेशर यहोवा ए।<verse eid="EZK 7:27" /></para>
  <chapter eid="EZK 7" />
  <chapter number="8" style="c" sid="EZK 8" />
  <para style="s">यरूशलेमो रे मन्दरो दे ओरी देवतेया री पूजा</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 8:1" />बेबीलोनो दे म्हारे गुलामिया रे छठुए सालो रे छठुए मीन्ने रे पाँजुए दिने जेबे आऊँ आपणे कअरे बैठी रा था ओर यहूदा प्रदेशो रे बुजुर्ग मेरे सामणे बैठी रे थे, तेबे परमेशर यहोवे री शक्ति तेथी मां पाँदे प्रकट ऊई। <verse eid="EZK 8:1" /><verse number="2" style="v" sid="EZK 8:2" />तेबे मैं आपणे सुफने दे केसी एड़े माणूंए खे देखेया जो एक आदमिए जेड़ा दिशो था। तेसरे लको ते थाले, तेसरा शरीर आगी जेड़ा जल़ने लगी रा था, ओर तेसरे लको ते पाँदे तेसरा शरीर बऊत गर्म चमकाए रे पीतल़ी जेड़ा चमकणे लगी रा था। <verse eid="EZK 8:2" /><verse number="3" style="v" sid="EZK 8:3" />तिने नौखा आथ जा कुछ बढ़ाई की मेरे सिरो रे बाल़ पकड़े, तेबे परमेशरो री आत्मे आऊँ तरती ओर सर्गो बीचे चकी की परमेशरो रे दखाए रे दर्शणो रे यरूशलेमो रे मन्दरो दे पीतरे, आँगणो रे तेस बड़े द्वारो गे पऊँचाई ता, जेतेरा मूँ उत्तरो रिया तरफा खे ए ओर जेती परमेशरो खे रोष चढ़ाणे वाल़ी मूर्तिया री जगा थी, जेतेरी बजा ते जल़न पैदा ओई। <verse eid="EZK 8:3" /><verse number="4" style="v" sid="EZK 8:4" />तेबे तेती चिनार नदिया रे कनारे इस्राएलो रे परमेशरो रा तेज तेड़ा ई था जेड़ा मैं मैदानो दे देखेया था। <verse eid="EZK 8:4" /><verse number="5" style="v" sid="EZK 8:5" />तेबे परमेशरे माखे बोलेया, “ओ माणूंआ, आपणी आखी उत्तरो रिया तरफा खे चकी की देख।” तेबे मैं आपणी आखी चकी की उत्तरो रिया तरफा खे देखेया कि बेदिया रे बड़े द्वारो रे उत्तरो रिया तरफा खे तेथो खे जाणे रिया जगा दे से मूर्ति थी जेतेते परमेशर घृणा करो था। <verse eid="EZK 8:5" /><verse number="6" style="v" sid="EZK 8:6" />तेबे तिने माखे बोलेया, “ओ माणूंआ, क्या तूँ देखणे लगी रा कि यो लोक क्या करने लगी रे? इस्राएलो रा कराना कितणे गंदे काम करोआ, ताकि आऊँ आपणे पवित्र मन्दरो ते दूर ऊई जाऊँ, पर तां इना ते बी जादा घृणित काम देखणे।” <verse eid="EZK 8:6" /><verse number="7" style="v" sid="EZK 8:7" />तेबे से माखे मन्दरो रे आँगणो रे द्वारो दे लईगा ओर मैं देखेया कि कांदा दे एक छेद ए। <verse eid="EZK 8:7" /><verse number="8" style="v" sid="EZK 8:8" />तेबे परमेशरे माखे बोलेया, “ओ माणूंआ, कांदा खे फाड़, तेबे मैं कांद फाड़ी की क्या देखेया कि एक द्वार ए।” <verse eid="EZK 8:8" /><verse number="9" style="v" sid="EZK 8:9" />तेबे परमेशरे माखे बोलेया, “पीतरे जाई की देख कि यो लोक एती केड़े गंदे काम करने लगी रे।” <verse eid="EZK 8:9" /><verse number="10" style="v" sid="EZK 8:10" />इजी री खातर आऊँ तेते द्वारो ते पीतरे गया ओर मैं देखेया कि एक बड़े कमरे री चऊँ कनारली कांदा दे हर तरआ रे लूरने वाल़े जन्तु ओर घृणित डांगरा रे चित्र बणी रे थे, ओर तिना सबी मूर्तिया रे चित्र बणी रे थे जिना री इस्राएली लोक पूजा करो थे। <verse eid="EZK 8:10" /><verse number="11" style="v" sid="EZK 8:11" />इस्राएलो रे कराने रे बुजुर्गा बीचा ते सत्तर मर्द जिना बीचे शापानो रा पाऊ याजन्याह बी ए, सेयो तिना चित्रा सामणे खड़ी रे ओर हर एकी मर्दे आपणे आथो दे तूपदान लई राखेया ओर तूपो रे तुएँ ते बादल़ो री खुशबू उठणे लगी री। <verse eid="EZK 8:11" /><verse number="12" style="v" sid="EZK 8:12" />तेबे परमेशरे माखे बोलेया, “ओ माणूंआ, क्या तैं देखी राखेया कि इस्राएलो रे कराने रे बुजुर्ग आपणी-आपणी नक्काशी वाल़े कमरे पीतरे, मतलब न्हेरे दे क्या करने लगी रे? सेयो एकी दूजे ते बोलोए कि यहोवा आसा खे नि देखदा, यहोवे देश छाडीता रा।” <verse eid="EZK 8:12" /><verse number="13" style="v" sid="EZK 8:13" />तेबे तिने माखे बोलेया, “तां इना ते बी जादा घृणित काम देखणे जो यो लोक करोए।” <verse eid="EZK 8:13" /><verse number="14" style="v" sid="EZK 8:14" />तेबे से माखे यहोवे रे मन्दरो ते तेस बड़े द्वारो गे लईगा जो उत्तरो रिया तरफा खे था ओर मैं तेती जवाणसा बैठी रिया ओर रोंदिया देखिया। सेओ रोणे लगी रिया थिया कऊँकि देवता तम्मूज मरी गा था।<note caller="+" style="f"><char style="fr" closed="false">8:14 </char><char style="ft" closed="false">तम्मूज बेबीलोनो दे खाद ओर डाल़ा खे बढ़ाणे वाल़ा देवता था। लोका रा मानणा था कि हर साल गर्मिया रे आखरी दे तेसरी मौत ऊई जाओई, ओर जेतेरा नतीजा ये आ कि गर्मिया दे डाल़-बूट सूकणे लगी जाओए, ओर डाल़िया रा उगणा बन्द ऊई जाओआ। लोक, खास करी की जवाणसा, तेसरिया मौता पाँदे शोग मनाओईया। ओर मन्दरो रे पीतरे आँगणो दे बैठी जाओ थिया। सेयो रो थिया ओर तेसरे दूबारा जिऊँदा ऊणे खे प्रार्थना करो थिया। </char></note> <verse eid="EZK 8:14" /><verse number="15" style="v" sid="EZK 8:15" />तेबे परमेशरे माखे बोलेया, “ओ माणूंआ, क्या तैं ये देखी राखेया? तां इना ते बी जादा घृणित काम देखणे।” <verse eid="EZK 8:15" /><verse number="16" style="v" sid="EZK 8:16" />तेबे से माखे यहोवे रे पीतरले आँगणो दे लईगा ओर तेती यहोवे रे द्वारो गे आँगण ओर बेदिया बीचे कोई पच्ची मर्द आपणी पीठ यहोवे रे मन्दरो रिया तरफा खे ओर आपणे मूँ पूर्बो रिया तरफा खे कित्ते रे थे, सेयो पूर्ब दिशा ते निकल़दे ऊए सूरजो री पूजा करने खे माथा टेकणे लगी रे थे। <verse eid="EZK 8:16" /><verse number="17" style="v" sid="EZK 8:17" />तेबे परमेशरे माखे बोलेया, “ओ माणूंआ, देख! यहूदा रे लोक मेरे मन्दरो दे ये घिनौने काम करने लगी रे! ये एक खतरनाक गल्ल ए! ओर सेयो आपणे देशो दे हर जगा दे उपद्रवो रे काम करने लगी रे। सेयो माखे हर बखत रोष दलांदे रओए। तिना खे देख! सेयो जितणा ऊई सको मेरी बेज्जती करदे रओए।<note caller="+" style="f"><char style="fr" closed="false">8:17 </char><char style="ft" closed="false">ये यहूदा रे लोका रा परमेशरो री बेज्जती करने रा सबी ते बेज्जतिया वाल़ा तरिका ए।</char></note> <verse eid="EZK 8:17" /><verse number="18" style="v" sid="EZK 8:18" />इजी री खातर मां बी जल़नी दे आई की तिना खे सजा देणी। मां यहूदा रे लोका पाँदे दया नि करनी। सेयो मतादा रिया तँईं मां पाँदे चींगदे बी रओ, तेबे बी मां तिना री गल्ल नि सुणनी।”<verse eid="EZK 8:18" /></para>
  <chapter eid="EZK 8" />
  <chapter number="9" style="c" sid="EZK 9" />
  <para style="s">यरूशलेमो खे सजा</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 9:1" />तीजी ते बाद, परमेशरे जोरे की माखे बोलेया, ताकि बऊत जे लोक सुणी सको, “तिना लोका खे एती ल्याओ जिना यरूशलेम शईरो रे लोका खे सजा देणी! पईरेदारा खे बोलो कि सेयो आपणे अथियार साथे लई की आओ।” <verse eid="EZK 9:1" /><verse number="2" style="v" sid="EZK 9:2" />तेबे मैं मन्दरो रे पाँदले दरवाजे ते छे मर्द सड़का दे आऊँदे देखे ये दरवाजा उत्तरो रिया तरफा खे ए। हर एक आदमी आपणे-आपणे आथो दे तलवार लई की आए ओर तिना बीचे रेशमो रे टाल्ले पईने रे, लको दे लिखणे वाल़ा दवाईत बाने दे एक ओर मर्द था, ओर सेयो सब मन्दरो ते पीतरे जाई की पीतल़ी री बेदिया गे खड़े ऊईगे। <verse eid="EZK 9:2" /><verse number="3" style="v" sid="EZK 9:3" />तेबे इस्राएलो रे परमेशरो रा तेज करूबा पाँदा ते, जिना पाँदे से रया करो था, मन्दरो री देऊल़ी पाँदे उठी की आई गा था ओर यहोवे से लिखणे वाल़ा माणूं जिने रेशमो रे टाल्ले पईनी राखे थे ओर लको दे दवाईत बानी राखेया था, बोलेया। <verse eid="EZK 9:3" /><verse number="4" style="v" sid="EZK 9:4" />तेबे यहोवे तेसखे बोलेया, “एस यरूशलेम शईरो रे पीतरे ओरे-पोरे जाई की जितणे माणूं तिना सबी घृणित कामो रिया बजा ते जो तिदे करे जाओए, शोक करदे ओर दु:खो साथे चींगोए, तिना रे माथे दे नशाण लगाई दे।” <verse eid="EZK 9:4" /><verse number="5" style="v" sid="EZK 9:5" />जेबे आऊँ सुणने लगी रा था, परमेशरे बाकी छे आदमिया खे बोलेया, “शईरो दे सफेद एपोद पईने दे माणूंए रा पीछा करो ओर लोका खे कांदे जाओ। केसी पाँदे बी दया नि करनी। <verse eid="EZK 9:5" /><verse number="6" style="v" sid="EZK 9:6" />स्याणे, जवान, कुआँरी, बाल-बच्चे, सबी खे काई की नाश करो, पर जेस केसी माणूंए रे माथे दे से नशाण ओ, तेसरे नेड़े नि जाणा ओर मेरे पवित्र मन्दरो ते ई शुरू करो।” इजी री खातर तिने मन्दरो रे सामणे मूर्तिया री पूजा करने वाल़ेया बुजुर्गा खे काणा शुरू कित्तेया।<verse eid="EZK 9:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="EZK 9:7" />तेबे परमेशरे तिना खे बोलेया, “मन्दरो खे अशुद्ध करो ओर आँगणो खे लाशा साथे परी देयो। चलो, बारे निकल़ो।” तेबे सेयो गये ओर तिने यरूशलेम शईरो दे लोक काये। <verse eid="EZK 9:7" /><verse number="8" style="v" sid="EZK 9:8" />जेबे सेयो लोक काणे लगी रे थे ओर आऊँ कल्ला रयी गा, तेबे आऊँ मुंए रे पारे थाले पड़ीगा ओर मैं चींगी की बोलेया, “हाय परमेशर यहोवा! क्या तां आपणा रोष यरूशलेमो पाँदे पड़काई की इस्राएलो रे सारे बचे रे लोक बी नाश करी देणे?” <verse eid="EZK 9:8" /><verse number="9" style="v" sid="EZK 9:9" />तेबे परमेशरे माखे ज्वाब दित्तेया, “इस्राएल ओर यहूदा रे पाप बऊत जादा ए, एते देशो दे हर जगा लोका री अत्या करी जाओई ओर ये शईर अन्याय करने वाल़ेया लोका साथे परी गा रा ए। सेओ लोक एकी दूजे ते बोलोए कि यहोवे ये देश छाडीता रा ओर से कुछ नि देखदा कि आसे क्या करने लगी रे। <verse eid="EZK 9:9" /><verse number="10" style="v" sid="EZK 9:10" />इजी री खातर तिना पाँदे दया नि ऊणी, ना मां तिना लोका रिया तँईं करूणा करनी, बल्कि एबे मां तिना खे तिना रे कित्ते रे बुरे कामा री सजा देणी।” <verse eid="EZK 9:10" /><verse number="11" style="v" sid="EZK 9:11" />तेबे मैं क्या देखेया कि जिने लिखणे वाल़े माणूंए रेशमो रे टाल्ले पईनी राखे थे ओर लको दे दवाईत बानी राखेया था, तिने ये बोली की समाचार दित्तेया, “जेड़ी तैं आज्ञा दित्ती, मैं तेड़ा ई करी राखेया।”<note caller="+" style="f"><char style="fr" closed="false">9:11 </char><char style="ft" closed="false">प्रका. 1:13 </char></note><verse eid="EZK 9:11" /></para>
  <chapter eid="EZK 9" />
  <chapter number="10" style="c" sid="EZK 10" />
  <para style="s">परमेशरो री महिमा रा मन्दरो ते निकल़ी जाणा</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 10:1" />इजी ते बाद मैं जो दर्शण देखेया कि कुछ एड़ा जो सिंहासनो जेड़ा दिशोआ। ये नीलमणिया ते बणी रा था। ये छतो पाँदे था, ओर ये करूबा रे सिरो पाँदे था। रा <verse eid="EZK 10:1" /><verse number="2" style="v" sid="EZK 10:2" />तेबे यहोवे तेस रेशमो रे टाल्ले पईने रे माणूंए खे बोलेया, “करूबा रे निठे कूमणे वाल़े टईरा बीचे जा। करूबा बीचे जल़ने लगी रे फेऊआ बीचा ते कुछ फेऊ चकी की आपणियां मुट्ठिया दे परी लो। फेर तिना खे यरूशलेम शईरो दे हर जगा दे सेटी दे।” तिने माणूंए तेड़ा ई कित्तेया, ओर आऊँ देखणे लगी रा था। <verse eid="EZK 10:2" /><verse number="3" style="v" sid="EZK 10:3" />जेबे से माणूं मन्दरो दे दक्खणा रिया तरफा खे गया तो करूब मन्दरो रे पीतरे आँगणो दे खड़ी रे थे। ओर बादल़ पीतरले आँगणो दे फरेया रा था। <verse eid="EZK 10:3" /><verse number="4" style="v" sid="EZK 10:4" />तेस बखते यहोवे रा तेज करूबा पाँदा ते उठी की मन्दरो री देऊल़ी पाँदे आई गा ओर मन्दरो दे बादल़ परी गा ओर से आँगण यहोवे रे तेजो साथे परी गा। <verse eid="EZK 10:4" /><verse number="5" style="v" sid="EZK 10:5" />करूबा रे पंखा री छेड़ बऊत जादा थी। से छेड़ बारले आँगणो तक सुणने लगी री थी। से छेड़ सर्वशक्तिमान परमेशरो रिया आवाजा जेड़ी थी जेबे से बोलो था। <verse eid="EZK 10:5" /><verse number="6" style="v" sid="EZK 10:6" />जेबे यहोवे रेशमो रे टाल्ले पईने रे माणूंए खे कूमणे वाल़े टईरा ते पीतरे करूबा बीचा ते आग लणे री आज्ञा दित्ती, तेबे से तिना बीचे जाई की एक टईरो गे खड़ा ऊईगा। <verse eid="EZK 10:6" /><verse number="7" style="v" sid="EZK 10:7" />तेबे करूबा बीचा ते एकी करूबे आपणा आथ आगे करी की, तेते आगी बीचा ते जो करूबा बीचे थी, थोड़ी जी चकी की रेशमो रे टाल्ले पईने रे माणूंए रे मुट्ठूआ दे देईती ओर से आदमी तिजी खे लई की बारे चली गा। <verse eid="EZK 10:7" /><verse number="8" style="v" sid="EZK 10:8" />करूबा रे पंखा निठे तो माणूंए रे आथो जेड़ा कुछ दिशो था। <verse eid="EZK 10:8" /><verse number="9" style="v" sid="EZK 10:9" />तेबे मैं जो दर्शण देखेया कि करूबा गे चार टईर ए; मतलब एक-एक करूबो गे एक-एक टईर ए, ओर टईरा रा रूप फिरोजा रत्नो जेड़ा चमकीला जा ए। <verse eid="EZK 10:9" /><verse number="10" style="v" sid="EZK 10:10" />तिना रा एड़ा रूप ए कि चारो एक जेड़े दिशोए, जेड़ा एक टईरो बीचे दूजा टईर ओ। <verse eid="EZK 10:10" /><verse number="11" style="v" sid="EZK 10:11" />जेबे सेयो चार टईर चलो थे तेबे सेयो आपणे चऊँ कनारले पारो पाँदे चलो थे ओर चलदे बखते मुड़ो नि थे, बल्कि जेथो खे तिना रा सिर रओ था सेयो तेथो खे ई तेस पीछे चलो थे ओर सेयो चलदे बखते मुड़ो नि थे। <verse eid="EZK 10:11" /><verse number="12" style="v" sid="EZK 10:12" />दुनी करूबा रे पूरे शरीरो पाँदे आखी थिया, तिना री पीठ, तिना रे आथ ओर तिना रे पंखा समेत करूबा रा सारा शरीर ओर जो टईर तिना रे थे, सेयो बी सारे के सारे चऊँ कनारे आखी साथे परे थे।<note caller="+" style="f"><char style="fr" closed="false">10:12 </char><char style="ft" closed="false">प्रका. 4:8 </char></note> <verse eid="EZK 10:12" /><verse number="13" style="v" sid="EZK 10:13" />मां सामणे इना टईरा खे चक्कर बोलेया, मतलब कूमणे वाल़े टईर। <verse eid="EZK 10:13" /><verse number="14" style="v" sid="EZK 10:14" />हर एकी पंखो वाल़े करूबो रे चार-चार मूँ थे। एकी री शक्ल तो बल़दो जेड़ी थी, दूजे री शक्ल माणूंए जेड़ी थी, तीजे री शक्ल शेरो जेड़ी थी, ओर चौथे री शक्ल बाजो जेड़ी थी।<note caller="+" style="f"><char style="fr" closed="false">10:14 </char><char style="ft" closed="false">प्रका. 4:7 </char></note> <verse eid="EZK 10:14" /><verse number="15" style="v" sid="EZK 10:15" />करूब जमीना पाँदा ते ऊबे उठी गे। यो सेयो जानवर थे, जो मैं कबार नदिया गे देखे थे। <verse eid="EZK 10:15" /><verse number="16" style="v" sid="EZK 10:16" />जेबे-जेबे सेयो करूब चलो थे ओर जेबे-जेबे करूब जमीना पाँदा ते उठणे खे आपणे पंख चको थे तेबे-तेबे टईर तिना गे ते नि मुड़ो थे। <verse eid="EZK 10:16" /><verse number="17" style="v" sid="EZK 10:17" />जेबे सेयो करूब खड़े ओ थे तेबे यो बी खड़े ऊई जाओ थे ओर जेबे सेयो उठो थे तेबे यो बी साथे उठो थे, एड़ा इजी बजा ते ओआ था कऊँकि तिना प्राणिया री आत्मा टईरा दे रओ थी। <verse eid="EZK 10:17" /><verse number="18" style="v" sid="EZK 10:18" />यहोवे रा तेज मन्दरो री देऊल़ी पाँदा ते उठी की करूबा पाँदे ठईरी गा। <verse eid="EZK 10:18" /><verse number="19" style="v" sid="EZK 10:19" />तेबे करूब आपणे पंख चकी की मां सामणे तरतिया पाँदा ते उठी की निकल़ी गे ओर टईर बी तिना साथे-साथे गये ओर सेयो सब यहोवे रे मन्दरो रे पूर्बो रे बड़े द्वारो गे खड़े ऊईगे ओर इस्राएलो रे परमेशरो रा तेज तिना पाँदे ठईरेया दा रया। <verse eid="EZK 10:19" /><verse number="20" style="v" sid="EZK 10:20" />यो सेयो ई जानवर ए जो मैं कबार नदिया गे इस्राएलो रे परमेशरो निठे देखे थे ओर माखे पता लगी गा कि सेयो बी करूब ए। <verse eid="EZK 10:20" /><verse number="21" style="v" sid="EZK 10:21" />हर एकी प्राणिए रे चार मूँ, चार पंख थे, ओर हर एकी पंखो निठे माणूंए रे जे आथो जेड़ा कुछ दिशो था। <verse eid="EZK 10:21" /><verse number="22" style="v" sid="EZK 10:22" />तिना करूबा रे मुंए री शक्ल सेईए जो मैं कबार नदिया रे कनारे पाँदे देखी थी ओर तिना रे मूँ ई क्या बल्कि तिना रा सारा शरीर बी तेड़ा ई था। सेयो सब सीदे आगे ई गये ओर सेयो मुड़े नि।<verse eid="EZK 10:22" /></para>
  <chapter eid="EZK 10" />
  <chapter number="11" style="c" sid="EZK 11" />
  <para style="s">दुष्ट शासको रा न्याय कित्तेया जाणा</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 11:1" />एते ते बाद परमेशरो री तागती आऊँ ऊबे चकी की यहोवे रे मन्दरो रे पूर्बो रे बड़े द्वारो गे जेतेरा मूँ पूर्बो री दिशा रिया तरफा खे था, पऊँचाई ता ओर तेती मैं क्या देखेया कि, बड़े द्वारो गे ई पच्ची मर्द ए। मैं तिना बीचे अज्जूरो रा पाऊ याजन्याह ओर बनायाह रा पाऊ पलत्याह देखेया, जो प्रजा रे परदान थे। <verse eid="EZK 11:1" /><verse number="2" style="v" sid="EZK 11:2" />तेबे यहोवे माखे बोलेया, “ओ नाश ऊणे वाल़े माणूंआ, ये सेयो पच्ची माणूं ए जो एस यरूशलेम शईरो दे बुरे काम करने रे बारे दे सोचोए। ये लोक लोका खे बुरे काम करने री सला देओए।” <verse eid="EZK 11:2" /><verse number="3" style="v" sid="EZK 11:3" />यो लोक बोलोए, “आसा छोड़ ई फेर आपणे कअर बनाणे लगणा। शईर खाणा बनाणे वाल़े पांडे जेड़ा ए, ओर आसे तेते दे बचे दे ए, जिंयाँ मास तेते दे बचाई की राखेया दा रओआ। <verse eid="EZK 11:3" /><verse number="4" style="v" sid="EZK 11:4" />ओ नाश ऊणे वाल़े माणूंआ, ताखे तिना खे चतौणी देणे रिया तँईं मेरा सन्देश बोलणा पड़ना।” <verse eid="EZK 11:4" /><verse number="5" style="v" sid="EZK 11:5" />तेबे यहोवे रा आत्मा मां पाँदे उतरेया ओर तिने माखे बोलेया, “लोका खे एड़ा बोल, यहोवा ईंयाँ बोलोआ: ओ इस्राएलो रे लोको तुसे एड़ा ई बोली राखेया; जो कुछ तुसा रे मनो दे आओआ, आऊँ तेसखे जाणूंआ। <verse eid="EZK 11:5" /><verse number="6" style="v" sid="EZK 11:6" />तुसे तो एस शईरो दे कई लोक काये, बल्कि एथो रिया सड़का लाशा साथे परी तिया। <verse eid="EZK 11:6" /><verse number="7" style="v" sid="EZK 11:7" />इजी बजा ते प्रभु यहोवा ईंयाँ बोलोआ: जो माणूं तुसे एस शईरो दे काई राखे, तिना रिया लाशा ई एस शईरो दे टोकणे रा मास ए ओर तुसे एते पांडे ते निकयाल़े जाणे। <verse eid="EZK 11:7" /><verse number="8" style="v" sid="EZK 11:8" />तुसे तलवारी ते डरोए ओर मां तुसा पाँदे तलवार चलाणी, प्रभु यहोवे री येई बाणी ए।” <verse eid="EZK 11:8" /><verse number="9" style="v" sid="EZK 11:9" />परमेशरे ये बी बोलेया, “मां तुसे एस शईरो ते निकयाल़ी की परदेशी दुश्मणा रे आथो दे करी देणे ओर तुसा खे सजा दलाणी। <verse eid="EZK 11:9" /><verse number="10" style="v" sid="EZK 11:10" />तिना तुसे लड़ाईया दे तलवारी साथे काई देणे; तुसा एथी इस्राएलो दे सजा पाणी। तेबे तुसा खे पता लगी जाणा कि आऊँ यहोवा जो बोलूँआ सेई करुँ बी आ। <verse eid="EZK 11:10" /><verse number="11" style="v" sid="EZK 11:11" />ये शईर तुसा खे टोकणा नि बणना ओर ना तुसे एते बीचला मास ऊणे, मां तुसा रा मुकद्दमा इस्राएलो रे बन्ने पाँदे चुकाणा।” <verse eid="EZK 11:11" /><verse number="12" style="v" sid="EZK 11:12" />तेबे तुसा खे पता लगी जाणा कि आऊँ ई यहोवा ए; तुसे जो मेरे बिधानो रिया गल्ला नि मानिया। इजी रे बदले तुसे दूजे जातिया रे लोका रे बिधान मानणे लगी रे। <verse eid="EZK 11:12" /><verse number="13" style="v" sid="EZK 11:13" />आऊँ एड़ी भविष्यबाणी करने लगी रा था कि बनायाह रा पाऊ पलत्याह मरी गा। तेबे आऊँ मुंए रे पारे थाले पड़ी की जोरे की चींगेया ओर बोलेया, “हाय प्रभु यहोवा, क्या तां इस्राएलो रे बचे रे लोक पूरी तरह ते नाश करी देणे?”<verse eid="EZK 11:13" /></para>
  <para style="s">गुलामिया बीचे गए दे लोका ते परमेशरो री प्रतिज्ञा</para>
  <para style="p">
    <verse number="14" style="v" sid="EZK 11:14" />तेबे यहोवे रा ये सन्देश मांगे पऊँचेया, <verse eid="EZK 11:14" /><verse number="15" style="v" sid="EZK 11:15" />“ओ नाश ऊणे वाल़े माणूंआ, सुण कि यरूशलेमो रे लोक तेरे, ओर तां साथे गुलामिया दे गये दे ओर सारे इस्राएलिया रे बारे दे क्या बोलोए। सेयो इस्राएलो रे सारे तिना लोका रे बारे दे बोलोए जो एबु बेबीलोनो दे ए।” सेयो बोलणे लगी रे, “सेयो लोक यहोवे ते दूर चली गे दे ए। इजी री खातर ये देश म्हारा ए ओर आसे इदे रई सकूँए।” <verse eid="EZK 11:15" /><verse number="16" style="v" sid="EZK 11:16" />पर तूँ आपणे साथी गुलामा खे बोल, “प्रभु यहोवा ईंयाँ बोलोआ कि मैं तुसे दूर-दूर जातिया बीचे बसाए ओर देशो-देशो बीचे तित्तर-बित्तर करी तो दित्ते रे, तेबे बी जेते देशो दे तुसे आई रे, तिना दे मां आपू तुसा खे थोड़े दिना खे पवित्र जगा ठईरना।” <verse eid="EZK 11:16" /><verse number="17" style="v" sid="EZK 11:17" />इजी री खातर तुँ तिना लोका खे बोल, “प्रभु यहोवा ईंयाँ बोलोआ कि कदी मां तुसे तिना जातिया बीचा ते कट्ठे करने जिना बीचे तुसे लई जाई राखे ओर तुसे इस्राएलो दे वापस लई आऊणे, ओर तुसे फेर आपणे देशो दे बसी जाणे। <verse eid="EZK 11:17" /><verse number="18" style="v" sid="EZK 11:18" />ओर जेबे तुसे जो गुलामिया दे ए, इस्राएलो री जमीना दे वापस आऊणे, तेबे तेस देशो रिया सारी घृणित मूर्तिया ओर घृणित काम बी तेथा ते दूर करने। <verse eid="EZK 11:18" /><verse number="19" style="v" sid="EZK 11:19" />तेबे मां तिना रा मन एक करी देणा ओर तिना रे पीतरे एक नया आत्मा पैदा करना ओर तिना रे शरीरो ते पात्थरो रा दिल निकयाल़ी की मासो रा दिल देणा,<note caller="+" style="f"><char style="fr" closed="false">11:19 </char><char style="ft" closed="false">यहे. 36:26 </char></note> <verse eid="EZK 11:19" /><verse number="20" style="v" sid="EZK 11:20" />जेते कि सेयो मेरी बिधिया पाँदे सदा चलेया करो ओर मेरे नियम मानो ओर सेयो मेरी प्रजा ठईरने ओर आऊँ तिना रा परमेशर ठईरना। <verse eid="EZK 11:20" /><verse number="21" style="v" sid="EZK 11:21" />पर सेयो लोक आपणी घिनौनी मूर्तिया ओर घिनौने कामो पाँदे मन लगाई की चलदे रओए, मां तिना खे तिना रे बुरे कामा री सजा देणी। परमेशर यहोवा येई बोलोआ।”<verse eid="EZK 11:21" /></para>
  <para style="s">परमेशरो री महिमा रा यरूशलेमो ते चलणा</para>
  <para style="p">
    <verse number="22" style="v" sid="EZK 11:22" />तेबे करूबे आपणे पंख खोले ओर टईर तिना साथे-साथे चले ओर इस्राएलो रे परमेशरो रा तेज तिना पाँदे था। <verse eid="EZK 11:22" /><verse number="23" style="v" sid="EZK 11:23" />तेबे यहोवे रा तेज यरूशलेम शईरो ते उठी की तेस पाह्ड़ो पाँदे ठईरी गा, जो यरूशलेम शईरो रे पूर्बो रिया तरफा खे था। <verse eid="EZK 11:23" /><verse number="24" style="v" sid="EZK 11:24" />दर्शणो दे आत्मे आऊँ ऊबे चकेया ओर माखे वापस बेबीलोनो दे लईगी। आऊँ तिना इस्राएलिया गे अटी की आईगा जो तेती बन्दी थे। ये ई दर्शणो रा अन्त था। <verse eid="EZK 11:24" /><verse number="25" style="v" sid="EZK 11:25" />तेबे जितणिया गल्ला यहोवे माखे दर्शणो दे दखाईया थिया, सेयो मैं गुलामा खे बताईतिया।<verse eid="EZK 11:25" /></para>
  <chapter eid="EZK 11" />
  <chapter number="12" style="c" sid="EZK 12" />
  <para style="s">गुलामिया दे जाणे री नशाणी</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 12:1" />तेबे यहोवे रा एक ओर सन्देश मांगे पऊँचेया, तिने बोलेया, <verse eid="EZK 12:1" /><verse number="2" style="v" sid="EZK 12:2" />“ओ नाश ऊणे वाल़े माणूंआ, तूँ एड़ेया लोका बीचे रएया जो बिद्रोह करदे रओए, तिना रे आखी तो आईया, पर से नि देखदे जो आऊँ चाऊँ था कि सेयो देखो, तिना रे सुणने खे कान तो आए, पर से सुणना नि चाँदे जो आऊँ तिना खे सुनाणा चाऊँआ, कऊँकि सेयो बिद्रोह करने वाल़े लोक ए।<note caller="+" style="f"><char style="fr" closed="false">12:2 </char><char style="ft" closed="false">मर. 8:18, रोम. 11:8 </char></note> <verse eid="EZK 12:2" /><verse number="3" style="v" sid="EZK 12:3" />इजी री खातर ओ नाश ऊणे वाल़े माणूंआ, दिने गुलामिया रा समान त्यार करी की तिना सामणे उठी जाया, तिना सामणे आपणी जगा छाडी की दूजी जगा खे जाया। पले ई सेयो बिद्रोह करने वाल़े लोक ए, तेबे बी क्या पता सेयो त्यान देयो कि तूँ क्या दखाणा चाएया। <verse eid="EZK 12:3" /><verse number="4" style="v" sid="EZK 12:4" />इजी री खातर तैं दिने तिना सामणे कैद करी की निया दा समान निकयाल़ना ओर तेबे तैं साँजके बखते गुलामिया रे जाणे वाल़े जेड़े तिना सामणे उठी जाणा। <verse eid="EZK 12:4" /><verse number="5" style="v" sid="EZK 12:5" />जेबे सेयो लोक ताखे देखणे लगी रे ओ तेबे तैं आपणे कअरो री कांदा दे एक बड़ा छेद करना ओर आपणा सारा समान तेते छेदो रिये बारे काडणा ओर तैं बी बारे निकल़ी की चली जाणा। <verse eid="EZK 12:5" /><verse number="6" style="v" sid="EZK 12:6" />तिना लोका रे सामणे ई आपणा समान कांदा पाँदे चकी की न्हेरे दे बारे निकल़ना ओर आपणा मूँ टाल्ले की टखी की राखणा, ताकि ताखे जमीन नि दिशो। एड़ा करने रे जरिये तां इस्राएलो रे लोका खे आऊणे वाल़े खतरे रे बारे दे नशाणी ऊणा।” <verse eid="EZK 12:6" /><verse number="7" style="v" sid="EZK 12:7" />इजी री खातर जेड़ी यहोवे माखे आज्ञा दित्ती तिजी रे ई मुताबिक मैं कित्तेया। दिने मैं आपणा समान गुलामा रे समानो जेड़ा काडेया ओर साँजा आपणे आथो साथे आपणे कअरो री कांदा दे छेद कित्तेया, तेबे न्हेरे दे आपणा समान निकयाल़ी की, तिना सामणे कांदा पाँदे चकी की चली गा। <verse eid="EZK 12:7" /><verse number="8" style="v" sid="EZK 12:8" />आगली प्यागा यहोवे रा ये सन्देश मांगे पऊँचेया, <verse eid="EZK 12:8" /><verse number="9" style="v" sid="EZK 12:9" />“ओ नाश ऊणे वाल़े माणूंआ, क्या इस्राएलो रे कराने, मतलब बगावत करने वाल़े तिने कराने तांते नि पूछेया कि तूँ ये क्या करने लगी रा?” <verse eid="EZK 12:9" /><verse number="10" style="v" sid="EZK 12:10" />तूँ तिना खे बोल, “परमेशर यहोवा ईंयाँ बोलोआ कि इना कामा दे यरूशलेमो रे राजा सिदकिय्याह ओर इस्राएलो रे सारे लोका खे एक सन्देश देई राखेया ए।” <verse eid="EZK 12:10" /><verse number="11" style="v" sid="EZK 12:11" />तूँ तिना खे बोल, “मैं जो करी राखेया से तुसा खे नशाणी ए, जेड़ा मैं करी राखेया, तेड़ा ई इस्राएली लोका साथे बी ऊणा, तिना खे उठी की गुलामिया दे जाणा पड़ना।” <verse eid="EZK 12:11" /><verse number="12" style="v" sid="EZK 12:12" />यरूशलेम शईरो रा राजा सिदकिय्याह सांजा रे बखते न्हेरे दे आपणा समान कांदा पाँदे चकी की चली जाणा। तेसरे सेवका शईरो री दवाला दे एक बड़ा छेद करना ओर तेस तिसिये बारे आपणा समान निकयाल़ी लणा। तेस आपणा मूँ टाल्ले साथे टखी की राखणा ताकि दूजे लोक तेसखे पछयाणी नि सको। <verse eid="EZK 12:12" /><verse number="13" style="v" sid="EZK 12:13" />परमेशर बोलोआ, “पर मां तेसखे जाल़ बछाणा ओर से तिदे फसी जाणा, तेबे मां से बेबीलोन शईरो दे लई जाणा, जेती से अन्दा ऊई की मरी जाणा। <verse eid="EZK 12:13" /><verse number="14" style="v" sid="EZK 12:14" />जितणे तेसरे मतदगार तेसरे नेड़े-तेड़े ऊणे, सेयो ओर तेसरी सारी टोलिया मां सारी दिशा दे तित्तर-बित्तर करी देणियां ओर दुश्मणा तलवार लई की तिना रा पीछा करना। <verse eid="EZK 12:14" /><verse number="15" style="v" sid="EZK 12:15" />जेबे मां सेयो जातिया-जातिया बीचे तित्तर बित्तर करी देणे ओर देशो-देशो दे लग-लग करी देणे, तेबे यरूशलेमो रे लोका खे पता लगी जाणा कि आऊँ ई यहोवा ए। <verse eid="EZK 12:15" /><verse number="16" style="v" sid="EZK 12:16" />पर मां तिना बीचा ते थोड़े जे लोक बचाई लणे। सेयो तलवार, पूख ओर बमारिया ते नि मरने। जेबे सेयो तिना दूजे देशा रे लोका बीचे रणे तेबे तिना खे पता लगी जाणा कि तिने बुरे काम करी राखे। ओर तिना जाणी लणा कि आऊँ ई यहोवा ए।”<verse eid="EZK 12:16" /></para>
  <para style="s">थरथरांदे ऊए भविष्यवक्ता रा नशाण</para>
  <para style="p">
    <verse number="17" style="v" sid="EZK 12:17" />तेबे यहोवे रा ये सन्देश मांगे पऊँचेया तिने बोलेया, <verse eid="EZK 12:17" /><verse number="18" style="v" sid="EZK 12:18" />“ओ नाश ऊणे वाल़े माणूंआ, तैं डरदे ऊए आपणी रोटी खाणी ओर डरदे ओर कांबदे ऊए आपणा पाणी पीणा; <verse eid="EZK 12:18" /><verse number="19" style="v" sid="EZK 12:19" />फेर इस्राएलो रे लोका खे ये बोलणा कि परमेशर यहोवा यरूशलेम ओर इस्राएलो रे पूरे देशो दे रणे वाल़ेया लोका रे बारे दे ईंयाँ बोलोआ, तिना आपणी रोटी ओर पाणी पींदे बखते डरना ओर कांबणा। तिना रे दुश्मणो तिना री जमीन एड़ी नाश करी देणी की तिदे कुछ पनि बचणा। एड़ा इजी बजा ते ऊणा कऊँकि तेती रणे वाल़ेया सबी लोके बुरे काम करी राखे। <verse eid="EZK 12:19" /><verse number="20" style="v" sid="EZK 12:20" />यहोवे बसे दे यहूदा रे शईर उजाड़ी देणे ओर फसल उपजाणे वाल़ी जमीन बी उजाड़ पड़ी जाणी, तेबे तुसा लोका खे पता लगी जाणा कि आऊँ ई यहोवा ए।”<verse eid="EZK 12:20" /></para>
  <para style="s">नाश नेड़े आ</para>
  <para style="p">
    <verse number="21" style="v" sid="EZK 12:21" />तेबे यहोवे रा वचन माखे मिलेया। ओर तिने बोलेया, <verse eid="EZK 12:21" /><verse number="22" style="v" sid="EZK 12:22" />“ओ नाश ऊणे वाल़े माणूंआ, ये केड़ी कआवत ए जो तुसे लोक इस्राएलो रे देशो दे बोलेया करोए, दिन जादा ऊईगे रे ओर दर्शणो री कोई गल्ल पूरी नि ऊई? <verse eid="EZK 12:22" /><verse number="23" style="v" sid="EZK 12:23" />तिना लोका खे बोल, परमेशर यहोवा ईंयाँ बोलोआ: मां ये कआवत बन्द करनी ओर ये कआवत इस्राएलो पाँदे फेर नि चलणी ओर तूँ तिना खे बोल कि से दिन नेड़े आई गा रा ओर दर्शणो रिया सब गल्ला पुरिया ऊणे वाल़िया ए, <verse eid="EZK 12:23" /><verse number="24" style="v" sid="EZK 12:24" />एबे से चूठे भविष्यबक्ता इस्राएली लोका खे चूठे दर्शण या एड़ी भविष्यबाणी नि बताई सकणे जो लोका खे खुश करने री कोशिश करोए। <verse eid="EZK 12:24" /><verse number="25" style="v" sid="EZK 12:25" />कऊँकि आऊँ यहोवा ए, जेबे आऊँ बोलूँ, तेबे जो वचन आऊँ बोलूँ, से पूरा ऊई जाणा, से बऊत जल्दी पूरा ऊणे वाल़ा ए। समजी लो, तुसे जो मेरी गल्ल मानणे ते ना करोए, तो मां ये तुसा रे जिऊँदे जिऊए पूरा करना। मां से सब पूरा करना जो मैं बोली राखेया, परमेशर यहोवे री येई बाणी ए।” <verse eid="EZK 12:25" /><verse number="26" style="v" sid="EZK 12:26" />तेबे यहोवे रा ये सन्देश माखे मिलेया, <verse eid="EZK 12:26" /><verse number="27" style="v" sid="EZK 12:27" />“ओ नाश ऊणे वाल़े माणूंआ, देख, इस्राएलो रे लोक ईंयाँ बोलणे लगी रे कि जो दर्शण से देखोआ, से कई दिन बाद पूरा ऊणे वाल़ा ए ओर से दूरो रे बखतो रे बारे दे भविष्यबाणी करोआ। <verse eid="EZK 12:27" /><verse number="28" style="v" sid="EZK 12:28" />इजी री खातर तूँ तिना खे बोल, परमेशर यहोवा ईंयाँ बोलोआ: मेरे केसी वचनो रे पूरा ऊणे रे फेर देरी नि ऊणी, बल्कि जो वचन आऊँ बोलूँगा, से छोड़ ई पूरा ऊणा, परमेशर यहोवे री येई बाणी ए।”<verse eid="EZK 12:28" /></para>
  <chapter eid="EZK 12" />
  <chapter number="13" style="c" sid="EZK 13" />
  <para style="s">मूर्ख भविष्यबक्ताओं पाँदे हाय</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 13:1" />तेबे यहोवे रा ये सन्देश माखे फेर मिलेया, <verse eid="EZK 13:1" /><verse number="2" style="v" sid="EZK 13:2" />“ओ नाश ऊणे वाल़े माणूंआ, इस्राएलो रे जो भविष्यबक्ता ए सेयो भविष्यबाणी तो करने लगी रे, पर सेयो सिर्फ आपणियां ई गल्ला सिखाओए।” तिना खे बोल, “यहोवे रा सन्देश सुणो।” <verse eid="EZK 13:2" /><verse number="3" style="v" sid="EZK 13:3" />तिने माखे चूठे भविष्यबक्तेया ते ये बोलणे खे बोलेया, “आऊँ परमेशर यहोवा ए ओर ये मेरा सन्देश ए, लाणत ए, तिना मूर्ख भविष्यबक्तेया खे जो आपणी ई आत्मा पीछे पटकी जाओए ओर तिना खे कोई दर्शण नि मिलेया!” <verse eid="EZK 13:3" /><verse number="4" style="v" sid="EZK 13:4" />ओ इस्राएलो रे लोको, तुसा रे भविष्यबक्ता खण्डहरो री गीदड़िया जेड़े बणी रे। <verse eid="EZK 13:4" /><verse number="5" style="v" sid="EZK 13:5" />तिने तुसा रे शईरो रिया टुटी रिया दवाला ठीक करने खे तुसा री मताद नि करी राखी। दवाला इतणिया मजबूत नि ऊणिया कि सेयो यहोवे रे दिने इस्राएलो रे लोका खे बचाई की राखी सको। तेबेई मां तुसा रे दुश्मणा खे तुसा पाँदे अमला करने देणा। <verse eid="EZK 13:5" /><verse number="6" style="v" sid="EZK 13:6" />यहोवे माखे बोलेया, “तिना रे दर्शण बेकार ए, तिने दर्शणो रा बेकार ओर चूठा दावा करी राखेया ओर तेबे बी ये उम्मीद दलाई कि यहोवे ये वचन पूरा करना, तेबे बी यहोवे सेयो नि पेजे।” <verse eid="EZK 13:6" /><verse number="7" style="v" sid="EZK 13:7" />आ, तुसे भविष्यबक्तेया चूठे दर्शण देखी राखे। तुसे चूठ बोलोए जेबे तुसे बोलोए, “यहोवे री ये बाणी ए।” तुसे एड़ा बोलोए, पर मैं तुसा खे कोई बी सन्देश नि देई राखेया। <verse eid="EZK 13:7" /><verse number="8" style="v" sid="EZK 13:8" />इजी बजा ते परमेशर यहोवा तुसा खे ईंयाँ बोलोआ, “तुसे जो बेकार गल्ला बोलिया ओर चूठे दर्शण देखी राखे, इजी बजा ते आऊँ तुसा रे खलाफ ए, परमेशर यहोवे री येई बाणी ए।” <verse eid="EZK 13:8" /><verse number="9" style="v" sid="EZK 13:9" />जो भविष्यबक्ता चूठे दर्शण देखोए ओर चूठी भविष्यबाणी करोए, मेरा आथ तिना रे खलाफ ऊणा ओर सेयो मां आपणी प्रजा बीचे नि रणे देणे। तिना रे नाओं इस्राएलो रे कराने दे नि लिखे जाणे ओर ना सेयो इस्राएलो रे देशो दे जाई सकणे, इजी ते तुसा खे पता लगी जाणा कि आऊँ ई परमेशर यहोवा ए। <verse eid="EZK 13:9" /><verse number="10" style="v" sid="EZK 13:10" />कऊँकि तिने चूठे नबीए बार-बार मेरे लोका ते चूठ बोलेया। नबीए बोलेया की शान्ति रणी ओर तेती कोई शान्ति नि ए ओर इजी री खातर जेबे कोई दवाल बणाओआ तेबे सेयो तेतेरी लिपाई माट्टिए की करोए।<note caller="+" style="f"><char style="fr" closed="false">13:10 </char><char style="ft" closed="false">यहे. 13:16, यिर्म. 8:11 </char></note> <verse eid="EZK 13:10" /><verse number="11" style="v" sid="EZK 13:11" />तिना माट्टिए की लिपणे वाल़ेया लोका खे बोलो कि से टल़ी जाणी। कऊँकि पारी बर्खा ऊणी, बड़े-बड़े ओल़े पड़ने ओर जेबे पारी तूफान आऊणा तेबे से टल़ी जाणी। <verse eid="EZK 13:11" /><verse number="12" style="v" sid="EZK 13:12" />इजी री खातर जेबे कांद टल़ी जाणी, तेबे लोका तुसा खे बोलणा कि जो लिपाई तुसे कित्ती थी से केयी गी? <verse eid="EZK 13:12" /><verse number="13" style="v" sid="EZK 13:13" />इजी बजा ते आऊँ परमेशर यहोवा तुसा खे ईंयाँ बोलोआ: कऊँकि आऊँ तुसा ते बऊत गुस्से दे आ, मां यरूशलेमो खे नाश करने खे दुश्मणा री सेना पेजणी। ये एड़ा ऊणा जेड़े कि मां तुसे नाश करने रिया तँईं बऊत तेज अवा, ओल़े ओर बऊत जादा बर्खा पेजणी।<note caller="+" style="f"><char style="fr" closed="false">13:13 </char><char style="ft" closed="false">निर्ग. 9:24 </char></note> <verse eid="EZK 13:13" /><verse number="14" style="v" sid="EZK 13:14" />ईंयाँ जेसा दवाला पाँदे तुसे कच्ची लिपाई करी राखी, से मां टाल़ी देणी, बल्कि माट्टिया रे मलाई देणी ओर तेतेरी निऊँ खुली जाणी ओर जेबे से टल़नी, तेबे तुसे तेती निठे दबी की नाश ऊई जाणे ओर तुसा खे पता लगी जाणा कि आऊँ ई यहोवा ए। <verse eid="EZK 13:14" /><verse number="15" style="v" sid="EZK 13:15" />ईंयाँ मां कांद ओर तेतेरी कच्ची लिपाई करने वाल़े दुँईं पाँदे आपणा रोष पूरी तरअ ते पड़काणा, तेबे तुसा खे बोलणा, ना तो दवाल ओर ना तेतेखे लिपाई करने वाल़े रये। <verse eid="EZK 13:15" /><verse number="16" style="v" sid="EZK 13:16" />मतलब इस्राएलो रे सेयो भविष्यबक्ता जो यरूशलेमो रे बारे दे भविष्यबाणी करो थे ओर तिना री शान्तिया रा दर्शण बताओ थे, पर परमेशर यहोवे री ये बाणी ए कि शान्ति तो आई नि। <verse eid="EZK 13:16" /><verse number="17" style="v" sid="EZK 13:17" />तेबे यहोवे मांते फेर गल्ल कित्ती, ओ नाश ऊणे वाल़े माणूंआ, एबे इस्राएलो री जवाणसा नबिया रे बारे दे बचार कर ओर तिना रा बरोद कर, जो आपणे ई मनो ते भविष्यबाणी करोईया, तिना रे खलाफ भविष्यबाणी कर। <verse eid="EZK 13:17" /><verse number="18" style="v" sid="EZK 13:18" />सर्वशक्तिमान यहोवा ईंयाँ बोलोआ, “लाणत ए तिना जवाणसा पाँदे कऊँकि तिना पाँदे बऊत पारी बिपदा आऊणी जो टाल्लेया रे टुकड़े बणाओईया ओर तिना रे बारे दे बोलोईया कि इना दे जादुए री शक्ति ए। लोक तिना खे आपणे आथा ओर सिरो दे बानोए। सेयो जवाणसा लोका रिया जिंदगिया पाँदे आपणा अक्क जमाणा चाओईया। तिना खे एड़ा लगोआ कि सेयो दूजेया रिया जिंदगिया पाँदे आपणा अक्क जमाई सकोईया ओर सेयो आपू बचिया दिया रणियां। <verse eid="EZK 13:18" /><verse number="19" style="v" sid="EZK 13:19" />तुसे तो जौ रे मुट्ठू ओर रोटिया रे टुकड़ेया रिया तँईं आऊँ मेरी प्रजा री नजरा दे अपवित्र ठराई की ओर आपणी तिना चूठी गल्ला रे जरीये, जो मेरी प्रजा रे लोक तुसा ते सुणोए, जो काणे जोगे नि थे, सेयो काईते ओर जो बचणे जोगे नि थे, सेयो जिऊँदे राखे। <verse eid="EZK 13:19" /><verse number="20" style="v" sid="EZK 13:20" />इजी बजा ते परमेशर यहोवा तिना जवाणसा खे ईंयाँ बोलोआ, देखो, आऊँ तुसा रे तिना सरयाणेया रे खलाफ ए, जिना रे जरीये तुसे प्राणो रा शिकार करोईया, इजी री खातर जिना खे तुसे शिकार करी की उडाओईया सेयो मां तुसा रे आथो ते छुड़ाई देणे। <verse eid="EZK 13:20" /><verse number="21" style="v" sid="EZK 13:21" />मां तुसा रे सिरो रे बुर्के फाड़ी की आपणी प्रजा रे लोक तुसा रे आथो ते छुड़ाई देणे ओर बादो ते सेयो तुसा रे वशो दे नि रणे, ताकि तुसे तिना रा शिकार करी सको, तेबे तुसा खे पता लगी जाणा कि आऊँ ई यहोवा ए। <verse eid="EZK 13:21" /><verse number="22" style="v" sid="EZK 13:22" />तुसे चूठ बोली की तर्मिये रा मन उदास करी राखेया, तेबे बी मैं से उदास नि करना चाया ओर तुसे दुष्ट माणूंए खे याओ दित्तेया, ताकि से आपणे बुरे कामो ते नि फिरो ओर जिऊँदा रओ। <verse eid="EZK 13:22" /><verse number="23" style="v" sid="EZK 13:23" />ओ चूठी नबीया जवाणसो इजी बजा ते एबे तुसा चूठ नि बोलणा कि तुसे कोई दर्शण देखी राखेया, ओर ना तुसे लोका खे चूठी भविष्यबाणी करी सकदे कि आऊणे वाल़े बखतो दे क्या ऊणा ए। कऊँकि मां आपणी प्रजा तुसा रे तोखा देणे ते छुड़ाणी। तेबे तुसा खे पता लगी जाणा कि आऊँ ई यहोवा ए।”<verse eid="EZK 13:23" /></para>
  <chapter eid="EZK 13" />
  <chapter number="14" style="c" sid="EZK 14" />
  <para style="s">यहेजकेलो रा मूर्तिपूजा करने वाल़ेया री बेज्जती करना</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 14:1" />तेबे एकी दिने बेबीलोनो दे जो इस्राएली गुलाम थे तिना रे कुछ मुखिया मांगे आये ओर सेओ मेरे सामणे बैठीगे। <verse eid="EZK 14:1" /><verse number="2" style="v" sid="EZK 14:2" />तेबे यहोवे रा ये सन्देश माखे मिलेया। ओर तिने माखे बोलेया, <verse eid="EZK 14:2" /><verse number="3" style="v" sid="EZK 14:3" />“ओ नाश ऊणे वाल़े माणूंआ, इने मुखिये आपणे दिलो दे मूर्तिया राखी लईया दिया ए। तिने एड़िया चीजा अपनाई राखिया ए जिना सेयो पापो दे फसाई देणे। आऊँ तिना री बिनती कऊँ सुणूँ?” <verse eid="EZK 14:3" /><verse number="4" style="v" sid="EZK 14:4" />इजी री खातर तूँ तिना खे बोल, परमेशर यहोवा ईंयाँ बोलोआ, “हर इस्राएलिया बीचा ते कोई बी आपणी मूर्तिया आपणे मनो दे राखी की ओर आपणे पापो री ठोकर आपणे सामणे राखी की भविष्यबक्ते गे आओ, तेसखे मां यहोवे, तेसरी बऊत मूर्तिया रे मुताबिक ई ज्वाब देणा, <verse eid="EZK 14:4" /><verse number="5" style="v" sid="EZK 14:5" />मां एड़ा इजी री खातर करना ताकि इस्राएली लोक, जिने आपणी मूर्तिया रिया पूजा करने रिया बजा ते आऊँ छाडीता, फेर तिना ईमानदारिया ते मेरी आराधना करनी।” <verse eid="EZK 14:5" /><verse number="6" style="v" sid="EZK 14:6" />इजी री खातर इस्राएलो रे लोका खे ये सब बोलो, तिना खे बोलो मेरा स्वामी परमेशर यहोवा ईंयाँ बोलोआ, मां नेड़े आओ ओर आपणी गन्दी मूर्तिया खे छाडी देओ। ओर आपणे सारे घिनौने कामा ते मूँ फेरो। <verse eid="EZK 14:6" /><verse number="7" style="v" sid="EZK 14:7" />कऊँकि तुसे इस्राएलो रे लोका बीचा ते ओर तेते बीचे रणे वाल़े परदेशिया बीचा ते बी कोई कऊँ नि ओ, जो मां पीछे चलणा छाडी की आपणी घृणित मूर्तिया आपणे मनो दे राखोगा ओर आपणे पापो री ठोकर आपणे सामणे राखो ओर तेबे आपणी कोई गल्ल मांते पूछणे खे भविष्यबक्ते गे आओगा, तो तेसखे मां यहोवे आपू ई ज्वाब देणा। <verse eid="EZK 14:7" /><verse number="8" style="v" sid="EZK 14:8" />मां एड़े माणूंए रे खलाफ ऊई जाणा। मां तेसखे सजा देणी ओर से ओरी लोका रिया तँईं चिह्न बणना। लोका तेसरा मजाक उडाणा। मां से आपणे लोका बीचे नि रणे देणा, तेबे तुसा लोका खे पता लगी जाणा कि आऊँ ई यहोवा ए। <verse eid="EZK 14:8" /><verse number="9" style="v" sid="EZK 14:9" />ओर जे कोई भविष्यबक्ता तोखा खाई की चूठी भविष्यबाणी करो, तो चाए मैं तेसखे से सन्देश देणे खे बी बोली राखेया ओ, तो बी मां से बारे निकयाल़ी देणा, ओर आपणे इस्राएली लोका बीचा ते बारे करी देणा। <verse eid="EZK 14:9" /><verse number="10" style="v" sid="EZK 14:10" />तिना सबी लोका आपणे-आपणे पापा री सजा पाणी, मतलब जेड़ा भविष्यबक्ते खे पूछणे वाल़े रा पाप ठईरना, तेड़ा ई भविष्यबक्ते रा बी पाप ठईरना, ओर मां तिना दुनी खे सजा देणी। <verse eid="EZK 14:10" /><verse number="11" style="v" sid="EZK 14:11" />ताकि बादो रे इस्राएलो रे लोक मां पीछे चलणा नि छाडो ओर ना आपणे कई प्रकारा रे पापा रिया बजा ते अशुद्ध बणो, बल्कि सेयो मेरी प्रजा बणो ओर आऊँ तिना रा परमेशर ठईरूँ, परमेशर यहोवे री येई बाणी ए।<verse eid="EZK 14:11" /></para>
  <para style="s">यहोवे रा इस्राईलो खे सजा देणा</para>
  <para style="p">
    <verse number="12" style="v" sid="EZK 14:12" />तेबे यहोवे रा ये सन्देश माखे मिलेया, <verse eid="EZK 14:12" /><verse number="13" style="v" sid="EZK 14:13" />“ओ नाश ऊणे वाल़े माणूंआ, जेबे केसी देशो रे लोक मां साथे विश्वासघात करी की पापी ऊई जाओ ओर आऊँ आपणा आथ तेस देशो रे खलाफ बढ़ाई की नज्ज आऊणे रा जरिया दूर करुँ ओर तिदे अकाल़ ल्याई की तेथा ते माणूं ओर डांगर दोनो नाश करी देऊँ, <verse eid="EZK 14:13" /><verse number="14" style="v" sid="EZK 14:14" />तेबे चाए तिदे नूह, दानिय्येल ओर अय्यूब यो तीनो मर्द ओ, तेबे बी सेयो आपणे तर्मो रे जरीये आपणे ई प्राण बचाई सकणे, परमेशर यहोवे री येई बाणी ए।” <verse eid="EZK 14:14" /><verse number="15" style="v" sid="EZK 14:15" />परमेशरे बोलेया जे आऊँ केसी देशो दे जंगल़ी जानवर पेजूँ ओर से अमला करी की कई माणूंआ खे काई देयो ओर जानवरो रिया बजा ते तिदे कोई नि जाओ, <verse eid="EZK 14:15" /><verse number="16" style="v" sid="EZK 14:16" />जे यो तीनो तर्मी माणूं नूह, दानिय्येल ओर अय्यूब तेती रये ऊँदे, तेबे बी परमेशर यहोवे री ये बाणी ए कि मेरी जिन्दगिया री कसम, सेयो आपणे माठे-बेटिया खे नि बचायी सकदे, सेयो ई कल्ले बचणे, पर देश उजाड़ ऊई जाणा। <verse eid="EZK 14:16" /><verse number="17" style="v" sid="EZK 14:17" />परमेशरे बोलेया, “क्या तेस देशो रे खलाफ लड़ने खे आऊँ दुश्मणो री सेना खे पेजी सकूँआ? तिना सैनिका से देश तलवारे की नाश करी देणा। मां से देशो ते सारे लोक ओर डांगर निकयाल़ी की बारे करने। <verse eid="EZK 14:17" /><verse number="18" style="v" sid="EZK 14:18" />तेबे तिदे चाए सेयो तीन मर्द बी ऊँदे तेबे बी परमेशर यहोवे री ये बाणी ए कि मेरी जिन्दगिया री कसम, सेयो आपणे माठे-बेटिया खे बी मरने ते नि बचायी सकणे थे, सेयो ई कल्ले बचणे थे कऊँकि सेयो तो तर्मी थे। <verse eid="EZK 14:18" /><verse number="19" style="v" sid="EZK 14:19" />जे आऊँ तेस देशो दे बमारी फैलाऊँ ओर तिदे आपणा रोष पड़काई की तेसरा खून एड़ा बह्ईणे देऊँ कि तेथो रे माणूं ओर डांगर दोनो नाश ओ, <verse eid="EZK 14:19" /><verse number="20" style="v" sid="EZK 14:20" />तेबे तिदे चाए सेयो तीन मर्द मतलब नूह, दानिय्येल ओर अय्यूब बी तिदे ऊँदे तेबे बी परमेशर यहोवे री ये बाणी ए कि मेरी जिन्दगिया री कसम, सेयो आपणे माठे-बेटिया खे बी मरने ते नि बचायी सकणे थे, सेयो ई कल्ले आपणे तर्मो रिया बजा ते बचणे थे।” <verse eid="EZK 14:20" /><verse number="21" style="v" sid="EZK 14:21" />इजी री खातर एबे आऊँ, परमेशर यहोवा ईंयाँ बोलूँआ, “मां यरूशलेमो रे लोका पाँदे आपणे चारो दण्ड पऊँचाणे, जेते की तिना खे बऊत पारी सजा मिलणी। कुछ लोक ओर जानवर तलवारे की मरने, कुछ अकाल़ो रिया बजा ते मरने, कुछ जंगल़ी जानवरा रे अमले ते मरने, ओर कुछ विपत्तिया रिया बजा ते नाश ऊई जाणे।<note caller="+" style="f"><char style="fr" closed="false">14:21 </char><char style="ft" closed="false">प्रका. 6:8 </char></note> <verse eid="EZK 14:21" /><verse number="22" style="v" sid="EZK 14:22" />तेबे बी तुसा रे कुछ लोक जिऊँदे बची जाणे, जवान ओर बच्चे दोनों। ओर जेबे तुसा तिना रे बुरे काम ओर बर्ताओ देखणा, तेबे तुसा समजी जाणा कि यरूशलेमो रे लोका पाँदे तिना कईया बड़ी विपत्तिया खे पेजणे री खास बजा थी जो मैं तिना पाँदे पेजिया थिया। <verse eid="EZK 14:22" /><verse number="23" style="v" sid="EZK 14:23" />जेबे तुसे तिना रा चाल-चलण ओर काम देखो, तेबे सेयो तुसा री शान्तिया री बजा ऊणे ओर तुसा खे पता लगी जाणा कि मैं जो कुछ यरूशलेमो दे इस्राएली लोका साथे जो करी राखेया, से बिना बजा ते नि कित्तेया, परमेशर यहोवे री येई बाणी ए।”<verse eid="EZK 14:23" /></para>
  <chapter eid="EZK 14" />
  <chapter number="15" style="c" sid="EZK 15" />
  <para style="s">बेकार अंगूरो री बेला रा उदारण</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 15:1" />तेबे यहोवे रा ये सन्देश माखे मिलेया, <verse eid="EZK 15:1" /><verse number="2" style="v" sid="EZK 15:2" />“ओ नाश ऊणे वाल़े माणूंआ, सबी डाल़ा बीचे अंगूरा री बेला री कोई अहमियत नि ए। अंगूरा री बेल जो जंगल़ो रे डाल़ा बीचे लगोई, तिदे कोई गुण नि ए। <verse eid="EZK 15:2" /><verse number="3" style="v" sid="EZK 15:3" />तेतेरिया लकड़िया री कोई बी चीज नि बणदी, ओर ना केसी पांडे खे टांगणे खे तेते बीचा ते खूँडी बणी सकोई। <verse eid="EZK 15:3" /><verse number="4" style="v" sid="EZK 15:4" />देख, लोक तेसा लकड़िया खे बाल़ने खे आगी दे फूकी देओए ओर तेतेरा से सब फूखी जाओआ, ओर से किजी कामो जोगी नि ऊँदी।” <verse eid="EZK 15:4" /><verse number="5" style="v" sid="EZK 15:5" />देख, से आगी दे फूखणे ते पईले बी बेकार थी ओर आगी दे जल़ने ते बाद बी बेकार ई ए। तुसे तिजी ते कुछ नि बचाई सकदे। <verse eid="EZK 15:5" /><verse number="6" style="v" sid="EZK 15:6" />इजी री खातर परमेशर यहोवा ईंयाँ बोलोआ, “जिंयाँ जंगल़ो रे डाल़ा बीचा ते अंगूरा री बेला खे आगी दे फूकी देओए, तिंयाँ ई मां यरूशलेमो रे लोक नाश करी देणे। <verse eid="EZK 15:6" /><verse number="7" style="v" sid="EZK 15:7" />मां सेयो त्यागी देणे। तिना खे एड़ा लगणा कि सेयो बची गे रे पर फेर बी एक ओर आग ऊणी जेसा सेयो फूकी देणे। ओर जेबे मां तिना खे सजा देणी, तो तुसा लोका जो जिऊँदे रणे जाणी लणा तिना कि ये काम मैं यहोवे ई करी राखेया। <verse eid="EZK 15:7" /><verse number="8" style="v" sid="EZK 15:8" />मां आपणे लोका रा देश उजाड़ी देणा, कऊँकि तिने लोके मां साथे विश्वासघात करी राखेया ए। परमेशर यहोवे री येई बाणी ए।”<verse eid="EZK 15:8" /></para>
  <chapter eid="EZK 15" />
  <chapter number="16" style="c" sid="EZK 16" />
  <para style="s">व्याभिचार करने वाल़ा यरूशलेम</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 16:1" />तेबे यहोवे रा ये सन्देश माखे मिलेया, <verse eid="EZK 16:1" /><verse number="2" style="v" sid="EZK 16:2" />“ओ नाश ऊणे वाल़े माणूंआ, यरूशलेमो रे लोका खे तिना रे सारे घिनौने काम बताई दे, <verse eid="EZK 16:2" /><verse number="3" style="v" sid="EZK 16:3" />ओर तिना खे बोल, ओ यरूशलेमो रे लोको, परमेशर यहोवा तुसा खे ईंयाँ बोलोआ, तुसा रा जन्म ओर तुसा री उत्पत्ति कनानिया रे देशो ते ऊई, तुसा रा बाओ तो एमोरी ओर माये हित्तिन थी। <verse eid="EZK 16:3" /><verse number="4" style="v" sid="EZK 16:4" />ये एड़ा ए जेड़े कि जेस दिने तुसे जम्मे, तेस दिने तो तुसा रा नाल़ूआ कटणे वाल़ा कोई नि था, ना तुसा रा शरीर पाणिये की नुल़ाया, ओर ना तुसा रा शरीर लूणे की मल़ेया या तुसा दे कोई टाल्ला लपेटेया ओ, जेड़े की इस्राएली बच्चेया साथे हमेशा ओआ। <verse eid="EZK 16:4" /><verse number="5" style="v" sid="EZK 16:5" />यरूशलेम, किने बी तां पाँदे दया नि कित्ती ताकि इना कामा बीचा ते तेरिया तँईं एक बी काम कित्तेया ऊँदा, बल्कि आपणे जमणे रे दिने तूँ घृणित ऊणे रिया बजा ते खुले मैदानो दे सेटिती दी थी।” <verse eid="EZK 16:5" /><verse number="6" style="v" sid="EZK 16:6" />फेर मैं तूँ देखी जेबे आऊँ तीसिए जाणे लगी रा था। ओर तूँ तेती आपणे ई खूनो बीचे लथपथ जमीना पाँदे पड़ी री थी। तूँ ईलणे री कोशिश करने लगी री थी। जेबे तूँ तेती लेटी री थी, तेबे मैं ताखे बोलेया, “जिऊँदी रओ।” <verse eid="EZK 16:6" /><verse number="7" style="v" sid="EZK 16:7" />तेबे मैं तूँ डोरूआ रिया डाल़िया जेड़े बढ़ाई ओर तूँ बढ़दे-बढ़दे बड़ी ऊईगी ओर बऊत बांकी ऊईगी, तेरी छातिया सुडौल ऊईया ओर तेरे बाल़ बढ़दे गये, तेबे बी तूँ नांगी थी। <verse eid="EZK 16:7" /><verse number="8" style="v" sid="EZK 16:8" />जेबे मैं फेर थोड़े साला बाद तूँ देखी, तो एड़ा लगेया जेड़े मैं देखेया कि तूँ ब्या करने लाईक बड़ी ऊईगी दी ए। तेबे एड़ा लगेया जेड़े मैं आपणे टाल्ले रा कुणा तां पाँदे टखाईता ओ, ये दशणे रिया तँईं कि मां तां साथे ब्या करना, जेतेरा मतलब ऊआ कि तूँ एबे नांगी री रयी। मां तां साथे ब्या करने रा वादा कित्तेया, ओर तूँ मेरी लाड़ी बणीगी। परमेशर यहोवे री येई बाणी ए।<verse eid="EZK 16:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="EZK 16:9" />तेबे मैं तूँ पाणिए साथे नुल़ाई की तां पाँदा ते खून तोयी ता ओर तेरे शरीरो पाँदे जैतूनो रा तेल मल़ेया। <verse eid="EZK 16:9" /><verse number="10" style="v" sid="EZK 16:10" />तेबे मैं ताखे कढ़ाई वाल़े टाल्ले ओर बाकरेया री खाला रिया जूतिया पन्याईया ओर तेरे लको दे छोटा रेशम बानेया ओर ताखे रेशमी टाल्ले पन्याए। <verse eid="EZK 16:10" /><verse number="11" style="v" sid="EZK 16:11" />तेबे मैं तेरा श्रृंगार कित्तेया ओर तेरे आथो दे बांगा ओर गल़े दे आर पन्याया। <verse eid="EZK 16:11" /><verse number="12" style="v" sid="EZK 16:12" />तेबे मैं तेरे नाको दे बाल़ू ओर तेरे कानो दे बाल़िया पन्याईया ओर तेरे सिरो पाँदे सुन्दर मुकुट राखेया। <verse eid="EZK 16:12" /><verse number="13" style="v" sid="EZK 16:13" />तांगे सूईने-चाँदिए रे गईणे थे, ओर तूँ हमेशा कढ़ाईदार सण ओर रेशमो रे टाल्ले पईनो थी। तूँ खास आटे री बणी री रोटिया ई खाओ थी, ओर खाणे रिया तँईं सयीत ओर जैतूनो रा तेल राखो थी। तूँ बऊत सुन्दर ऊईगी थी। ओर तूँ राणी बणीगी। <verse eid="EZK 16:13" /><verse number="14" style="v" sid="EZK 16:14" />तेरी सुन्दरता रा बोल-बाला दूजी जातिया बीचे फैलीगा, कऊँकि तेस प्रतापो रिया बजा ते, जो मैं ताखे आपणी तरफा ते दित्तेया था, तूँ बऊत बांकी थी, परमेशर यहोवे री येई बाणी ए। <verse eid="EZK 16:14" /><verse number="15" style="v" sid="EZK 16:15" />परमेशरे फेर बोलेया, ओर माखे एड़ा लगेया जेड़े कि ताखे परोसा ऊईगा ओ कि कऊँकि लोक जाणो थे कि तूँ बऊत बांकी ए, तूँ वेश्या बणी की बऊत पैसा कमाई सकोई। एड़ा लगेया जेड़े कि तैं हर एकी आदमिए साथे व्याभिचार कित्तेया जो तांगे आया ओर सेयो सब बी तेरी सुन्दरता रा मजा लणे लगी रे थे। <verse eid="EZK 16:15" /><verse number="16" style="v" sid="EZK 16:16" />तैं आपणे बांके टाल्ले लई की रंग-बरंगिया मूर्तिया री पूजा करने खे ऊच्ची जगा बणाई तिया ओर तेती व्याभिचार कित्तेया, एड़े बुरे काम कित्ते जो ना कदी ऊए ओर ना कदी ऊणे। <verse eid="EZK 16:16" /><verse number="17" style="v" sid="EZK 16:17" />जो सूईने-चाँदिए रे गईणे मैं ताखे दित्ते थे तिना ते तैं मूर्तिया बणाई लिया, ओर तिना मूर्तिया री पूजा करी की विश्वासघाती वेश्या जेड़ा पाप कित्तेया। <verse eid="EZK 16:17" /><verse number="18" style="v" sid="EZK 16:18" />तेबे तैं आपणे बांके कढ़ाईया वाल़े टाल्ले लई की तिना मूर्तिया खे पन्याए ओर मेरा तेल ओर तूप तिना सामणे चढ़ाया। <verse eid="EZK 16:18" /><verse number="19" style="v" sid="EZK 16:19" />मैं ताखे जो रोटी दित्ती थी, मतलब जो मैदा, तेल ओर सयीत ताखे आऊँ खुलाऊँ था, से सारा तैं तेस सामणे सुख देणे वाल़ी खुशबू करी की राखी ता, परमेशर यहोवे री येई बाणी ए कि एड़ा ई ऊआ। <verse eid="EZK 16:19" /><verse number="20" style="v" sid="EZK 16:20" />परमेशरे बोलेया तैं आपणे माठे-बेटिया लई की जो तैं मेरिया तँईं जमाए, तिना मूर्तिया खे बलिदान करी की चढ़ाए। क्या तेरा व्याभिचार एड़ी छोटी गल्ल थी? <verse eid="EZK 16:20" /><verse number="21" style="v" sid="EZK 16:21" />कि तैं मेरे बाल-बच्चे काईते, ओर तैं सेयो मूर्तिया रे सामणे बलि करी की चढ़ाईते। <verse eid="EZK 16:21" /><verse number="22" style="v" sid="EZK 16:22" />तैं आपणे सारे घृणित कामो रे ओर व्याभिचार करदे ऊए आपणे बचपनो रे दिन कदी याद नि कित्ते, जबकि तूँ नांगी आपणे खूनो बीचे लेटी री थी।<verse eid="EZK 16:22" /></para>
  <para style="s">यरूशलेमो रा जीवन एक वेश्या जेड़ा</para>
  <para style="p">
    <verse number="23" style="v" sid="EZK 16:23" />तेरी तेसा सारी बुराईया पीछे क्या ऊआ? परमेशर यहोवे री येई बाणी ए, हाय, तां पाँदे हाय! <verse eid="EZK 16:23" /><verse number="24" style="v" sid="EZK 16:24" />तैं चूठे देवतेया खे एक मन्दर बणाया ओर तैं एकी चौको दे तिना मूर्तिया री पूजा करने खे ऊच्ची बेदिया बणाई ती। <verse eid="EZK 16:24" /><verse number="25" style="v" sid="EZK 16:25" />तैं आपणी एक-एक सड़का रे कनारे बी ऊच्ची जगा बणाई की आपणी सुन्दरता घृणित कराईती ओर हर एक यात्री खे बुरे कामो खे बुलाई की, तूँ हर दिन एकी वेश्या ते बी जादा ऊँदी चली री। <verse eid="EZK 16:25" /><verse number="26" style="v" sid="EZK 16:26" />तेबे तू तेस आपणे पड़ोसी मिस्रो रे लोका साथे बी, जो मोटे-ताजे ए, तिना साथे वेश्या जेड़ा बर्ताओ कित्तेया ओर तिने माखे रोष चढ़ाणे खे आपणा व्याभिचार वाल़ा पाप ओर जादा बढ़ाईता। बढ़ांदी गयी। <verse eid="EZK 16:26" /><verse number="27" style="v" sid="EZK 16:27" />इजी बजा ते मैं ताखे सजा देणे रा फैंसला कित्तेया, तेरा रोज का खाणा कम करिता रा ए ओर तेरी दुश्मण पलिश्ती जवाणसा जो तेरे महापापो रे कामो ते शर्माओईया, मैं तूँ तिना री इच्छा पाँदे छाडी ती री। <verse eid="EZK 16:27" /><verse number="28" style="v" sid="EZK 16:28" />तेबे बी तेरे तोखे वाल़े काम कम नि ऊए, इजी री खातर तैं अश्शूरी लोका साथे बी वेश्या जेड़े विश्वासघात कित्तेया ओर तिना साथे व्याभिचार करने ते बाद बी तेरी इच्छा शान्त नि ऊई। <verse eid="EZK 16:28" /><verse number="29" style="v" sid="EZK 16:29" />तैं बेबीलोनो रे बपारिया साथे बी व्याभिचार कित्तेया। एकी वेश्या जेड़े तैं आपू खे बऊत सारेया लोका खे बेचेया। पर सेयो फेर बी ताखे खुश नि करी सके।<verse eid="EZK 16:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="EZK 16:30" />ओ, यरूशलेम, आऊँ तांते बऊत गुस्से आ। आऊँ परमेशर यहोवा ए ओर ये मेरी बाणी ए कि तेरा मन केड़ा चंचल ए कि तूँ इना सारे कामा करेई, जो बेशर्म वेश्या रेई काम ए? <verse eid="EZK 16:30" /><verse number="31" style="v" sid="EZK 16:31" />तैं हर एक गल़िया रे कुणे पाँदे मूर्तिपूजा करने खे मन्दर बणाए ओर हर एक चौको दे आपणी ऊच्ची जगा मूर्तिपूजा खे बणाई, क्या इजी तेई तूँ वेश्या नि बणी? कऊँकि तूँ एड़ी कमाईया पाँदे आसोई। <verse eid="EZK 16:31" /><verse number="32" style="v" sid="EZK 16:32" />तूँ व्याभिचार करने वाल़ी लाड़ी ए, तूँ पराए मर्दा खे आपणे लाड़े रे बदले मानेई। <verse eid="EZK 16:32" /><verse number="33" style="v" sid="EZK 16:33" />सबी वेश्या खे तो पैसे मिलोए, पर तैं आपणे सबी दोस्ता खे आपू पैसे देई की ओर तिना खे लाल़च देई की बुलाई राखे, ताकि सेयो चऊँ कनारे ते आई की तां साथे व्याभिचार करो। <verse eid="EZK 16:33" /><verse number="34" style="v" sid="EZK 16:34" />ईंयाँ तेरा व्याभिचार बाकी व्याभिचारिया ते उल्टा ए। तां पीछे कोई व्याभिचारी नि चलदा ओर तूँ केसी ते कीमत नि लंदी, बल्कि तूँ ई देई, इजी बजा ते तूँ उल्टी ठईरी।<verse eid="EZK 16:34" /></para>
  <para style="s">यरूशलेमो खे परमेशरो री सजा</para>
  <para style="p">
    <verse number="35" style="v" sid="EZK 16:35" />इजी बजा ते, ओ वेश्या जेड़े तोखा देणे वाल़े यरूशलेम, यहोवे रा वचन सुण, <verse eid="EZK 16:35" /><verse number="36" style="v" sid="EZK 16:36" />परमेशर यहोवा ईंयाँ बोलोआ, “तैं जो करी राखेया से एड़ा ए जेड़े तैं आपणे टाल्ले आपू खोली राखे ओर वेश्या जेड़ा बर्ताओ कित्तेया ओर तिना मर्दा साथे संबंध बणाए जो तेरे लाड़े नि ए। मेरा मतलब ए कि तूँ घृणित मूर्तिया री पूजा करदी रये ई, ओर ताखे आपणे बच्चे तिना खे बलि करना अच्छा लगोआ। <verse eid="EZK 16:36" /><verse number="37" style="v" sid="EZK 16:37" />एबे आऊँ जो करने वाल़ा ए से एड़ा ए जेड़े मां सेयो सब लोक कट्ठा करने जिना रे बारे दे तूँ सोचे ई कि सेयो मांते प्यार करोए, ओर जिना ते तूँ नफरत करेई। मां सेयो तां पाँदे अमला करने खे तेरे चऊँ कनारे कट्ठे करने, ओर मां जो करना से एड़ा ए जेड़े मैं तेरे टाल्ले खोली ते, ओर तिना तूँ तेबे देखणी जेबे तूँ पूरी तरआ ते नांगी ऊणी। <verse eid="EZK 16:37" /><verse number="38" style="v" sid="EZK 16:38" />तेबे मां ताखे एड़ी सजा देणी, जेड़ी व्याभिचारणिया ओर खून करने वाल़ी जवाणसा खे दित्ती जाओई ओर मां रोष ओर जल़नी रे आई की तेरा खून बाह्णा। <verse eid="EZK 16:38" /><verse number="39" style="v" sid="EZK 16:39" />मां ईंयाँ तूँ तेरे प्रेमिया रे वशो दे करी देणी ओर तिना तेरे गुम्मट टाल़ी देणे ओर तेरी ऊच्ची जगा तोड़ी देणियां, तिना तेरे टाल्ले जबरदस्ती खोलणे ओर तेरे सुन्दर गईणे छुड़ाई लणे ओर तूँ नांगी करी की छाडी देणी। <verse eid="EZK 16:39" /><verse number="40" style="v" sid="EZK 16:40" />तेबे तेरे खलाफ तिना एक सभा कट्ठी करी की तिना तां पाँदे पात्थर बाणे ओर आपणी तलवारी साथे बाडी की टुकड़े-टुकड़े करी देणी। <verse eid="EZK 16:40" /><verse number="41" style="v" sid="EZK 16:41" />तेबे तेरे पईलके प्रेमी जो एबे तेरे दुश्मण ए तिना आग लगाई की तेरे कअर फूकी देणे ओर ताखे बऊत जवाणसा सामणे सजा देणी ओर मां तेरा व्याभिचार बन्द करना ओर तां फेर व्याभिचार करने खे कीमत नि देणी। <verse eid="EZK 16:41" /><verse number="42" style="v" sid="EZK 16:42" />तेबे मां फेर तां पाँदे रोष नि करना। मां, तैं जो माखे छाडी की ओरी देवतेया री पूजा कित्ती तेतेरिया बजा ते फेर तांते घृणा करना छाडी देणा। <verse eid="EZK 16:42" /><verse number="43" style="v" sid="EZK 16:43" />तैं जो आपणे बचपनो रे दिन याद नि राखे, बल्कि इना सबी गल्ला रिया बजा ते माखे रोष चढ़ाया, इजी बजा ते मां तेरा चाल-चलण तेरे सिरो पाँदे पाणा ओर तूँ आपणे पिछले सारे घिनौने कामा ते ओर जादा महापाप नि करना, परमेशर यहोवे री येई बाणी ए।”<verse eid="EZK 16:43" /></para>
  <para style="s">जेड़ी माये तेड़ी बेटी</para>
  <para style="p">
    <verse number="44" style="v" sid="EZK 16:44" />यहोवा बोलोआ, “देख, ओ यरूशलेम, सबी लोका तेरे बारे दे ये कहावत बोलणी, ‘जेड़ी माये तेड़ी बेटी’।” <verse eid="EZK 16:44" /><verse number="45" style="v" sid="EZK 16:45" />तूँ आपणियां माया जेड़ी ए, जेसे आपणे लाड़े ओर आपणे बच्चेया ते नफरत कित्ती, तूँ बी आपणियां बईणा जेड़ी ए, तेसे बी तेरिया आपणे लाड़े ओर आपणे बच्चेया ते नफरत कित्ती। तुसा रा बाओ एमोरी था ओर तुसा री माये हित्ती थी। <verse eid="EZK 16:45" /><verse number="46" style="v" sid="EZK 16:46" />तेरी बड़ी बईण शोमरोन ए, जो आपणी बेटिया समेत तेरे खूँजे कनारे रओई ओर तेरी छोटी बईण, जो तेरे दाँणे कनारे रओई, से बेटिया समेत सदोम ए। <verse eid="EZK 16:46" /><verse number="47" style="v" sid="EZK 16:47" />तैं तिना जेड़ी चाल नि चली ओर ना तिना जेड़े बुरे कामो ते सन्तुष्ट ऊई, ये तो बऊत छोटी गल्ल ऊँदी, पर तेरा सारा चाल-चलण तिना ते बी जादा बिगड़ी गा। <verse eid="EZK 16:47" /><verse number="48" style="v" sid="EZK 16:48" />परमेशर यहोवा एड़ा बोलोआ, “जेड़ा कि आऊँ जिऊँदा परमेशर ए, मेरी जिन्दगिया री कसम, तेरी बईण सदोमे ओर तेसा रे गांवें कदी बी से बुराई नि करी राखी जो तैं ओर तेरे गांवें करी राखी। <verse eid="EZK 16:48" /><verse number="49" style="v" sid="EZK 16:49" />देख, तेरी बईण सदोमो रा पाप ये था कि से आपणी बेटिया समेत कमण्ड करो थी, पेट परी-परी की खाओ थी ओर सुख-चैनो दे रओ थी ओर गरीब-कंगाल़ लोका खे नि मानो थी। <verse eid="EZK 16:49" /><verse number="50" style="v" sid="EZK 16:50" />सदोम ओर तेसरे लोक बऊत ज्यादा कमण्ड करी की मां सामणे बऊत पाप करने लगे। जेबे मैं सेओ तिना कामा खे करदे देखे तेबे मैं सजा दित्ती।” <verse eid="EZK 16:50" /><verse number="51" style="v" sid="EZK 16:51" />परमेशरे बोलेया, इजी ते अलावा, शोमरोनो रे लोक तुसा यरूशलेमो रे लोका सामणे निर्दोष निकल़ी रे, तैं तो शोमरोनो ते बढ़ी की बुरे काम करी राखे ओर आपणे अन्दकूप घृणित कामो रे जरीये आपणी बईणा ते जीती गी। <verse eid="EZK 16:51" /><verse number="52" style="v" sid="EZK 16:52" />इजी री खातर तैं जो आपणी बईणी रा न्याय कित्तेया, इजी बजा ते शर्मिंदा ओ, कऊँकि तैं तिना ते बढ़ी की घृणित पाप करी राखे, इजी बजा ते सेयो तां सामणे निर्दोष ठईरी रिया। इजी री खातर तूँ एते गल्ला ते शर्म कर ओर शर्मांदी रओ, कऊँकि तैं आपणियां बईणी कम दोषी ठराई राखिया।<verse eid="EZK 16:52" /></para>
  <para style="s">सदोम ओर सामरिया रा दुबारा बसणा</para>
  <para style="p">
    <verse number="53" style="v" sid="EZK 16:53" />जेबे आऊँ तिने खे, मतलब बेटिया समेत सदोम ओर शोमरोनो खे गुलामिया ते वापस ल्याऊँगा, तेबे तिना बीचे ई तेरे गुलाम बी वापस ल्याऊँगा। <verse eid="EZK 16:53" /><verse number="54" style="v" sid="EZK 16:54" />जेते कि तूँ शर्मांदी रये ओर आपणे सारे कामा खे देखी की ताखे शर्म आऊँदी रओ, कऊँकि तूँ तिना री शान्तिया री बजा ऊई री। <verse eid="EZK 16:54" /><verse number="55" style="v" sid="EZK 16:55" />ईंयाँ तुसे ओर तुसा रिया बईणी सदोम ओर सामरिया रे लोके बी आपणी-आपणी बेटिया समेत आपणी पईलकी दशा दे फेर पऊँछणियां। <verse eid="EZK 16:55" /><verse number="56" style="v" sid="EZK 16:56" />परमेशरे बोलेया जदुओ तक तेरी बुराई सामणे नि आई थी, मतलब जेस बखतो तक तूँ नेड़े-तेड़े रे लोका समेत अरामी ओर पलिश्ती जवाणसा री जो एबे ताखे चऊँ कनारे ते तुच्छ जाणोईया, बेज्जती करो थी, <verse eid="EZK 16:56" /><verse number="57" style="v" sid="EZK 16:57" />आपणे तिना कमण्डो रे दिना रे तूँ आपणी बईण सदोमो रा नाओं पनि लओ थी। <verse eid="EZK 16:57" /><verse number="58" style="v" sid="EZK 16:58" />पर एबे ताखे आपणे पापा रा बोज आपू ई चकणा पड़ी रा, यहोवे री येई बाणी ए।<verse eid="EZK 16:58" /></para>
  <para style="s">एक वाचा जो सदा तक ठईरनी</para>
  <para style="p">
    <verse number="59" style="v" sid="EZK 16:59" />परमेशर यहोवा ईंयाँ बोलोआ, “मां तां साथे एड़ा ई बर्ताव करना, जेड़ा तैं कित्तेया, कऊँकि तैं वाचा तोड़ी की कसम तुच्छ जाणी। <verse eid="EZK 16:59" /><verse number="60" style="v" sid="EZK 16:60" />तेबे बी मां तेरे बचपनो रे दिना री आपणी वाचा याद करनी ओर तां साथे सदा री वाचा बानणी। <verse eid="EZK 16:60" /><verse number="61" style="v" sid="EZK 16:61" />जेबे तां आपणी बड़ी बईण ओर छोटी बईण आपू गे ल्याऊणिया, तेबे तां याद करना कि तैं क्या करी राखेया, ओर तां बऊत बेज्जती महसूस करनी। मां सेयो तेरिया बेटिया जेड़िया रणे देणियां, हालाँकि ये तां साथे मेरे वादे रा इस्सा नि था।<note caller="+" style="f"><char style="fr" closed="false">16:61 </char><char style="ft" closed="false">रोम. 6:21 </char></note> <verse eid="EZK 16:61" /><verse number="62" style="v" sid="EZK 16:62" />मां तां साथे आपणी वाचा पक्की करनी ओर तेबे ताखे पता लगी जाणा कि आऊँ ई यहोवा ए।<note caller="+" style="f"><char style="fr" closed="false">16:62 </char><char style="ft" closed="false">यहे. 37:26 </char></note> <verse eid="EZK 16:62" /><verse number="63" style="v" sid="EZK 16:63" />जेते कि तूँ याद करी की शर्मिंदा ओ ओर शर्मा रे मारे फेर कदी मूँ नि खोले। ये तेस बखते ऊना, जेबे मां तेरे सारे काम टखणे, परमेशर यहोवे री येई बाणी ए।”<note caller="+" style="f"><char style="fr" closed="false">16:63 </char><char style="ft" closed="false">पज. 78:38 </char></note><verse eid="EZK 16:63" /></para>
  <chapter eid="EZK 16" />
  <chapter number="17" style="c" sid="EZK 17" />
  <para style="s">उकाबो रा प्रमाण</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 17:1" />यहोवे रा ये सन्देश एक ओर बार माखे मिलेया, <verse eid="EZK 17:1" /><verse number="2" style="v" sid="EZK 17:2" />“ओ नाश ऊणे वाल़े माणूंआ, इस्राएलो रे लोका खे ये बुजाणी ओर उदारण देई की बोल।” परमेशर यहोवा ईंयाँ बोलोआ, <verse eid="EZK 17:2" /><verse number="3" style="v" sid="EZK 17:3" />“एक बड़ा उकाब था जेसरे पंख मजबूत थे। तेसरे पंख लाम्बे ओर बांके थे, ओर तिना दे कई तरआ रे रंग थे। उकाब लबानोनो रे पाह्ड़ा दे आया तिने एकी देवदारो रे डाल़ो री चूँडी पकड़ी ली। <verse eid="EZK 17:3" /><verse number="4" style="v" sid="EZK 17:4" />तेबे तिने तेसा डाल़िया री सबी ते पाँदली पाँगटी तोड़ी ती ओर से लेण-देण करने वाल़े देशो दे लई जाई की बपारिया रे एक शईरो दे लगाई। <verse eid="EZK 17:4" /><verse number="5" style="v" sid="EZK 17:5" />तेबे उकाबे इस्राएल देशो रा कुछ बीज लई की एक उपजाऊ डोरूए दे लगाया, जेती एस मजनू डाल़ो खे उगणे खे सदा बऊत पाणी मिलदा रओ था। <verse eid="EZK 17:5" /><verse number="6" style="v" sid="EZK 17:6" />से बिऊ बड़ा ऊई की एक छोटी जी अंगूरा री बेल बणीगी जो जमीना पाँदे फैलीगी। एतेरिया डाल़िया चीला रिया तरआ मुड़ी रिया थिया, पर इजी रिया जड़ी जमीना दे थाले बढ़ने लगी रिया थिया। इजी री खातर से एक खरी बेल बणीगी ओर एसे बेली बऊत सारिया डाल़िया ओर पत्ते पैदा कित्ते।”<verse eid="EZK 17:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="EZK 17:7" />तेबे एक ओर उकाब पंछी था जेसरे पंख मजबूत थे, तेसरे पंख लाम्बे ओर बांके थे, सेयो कईया रंगा रे थे। से अंगूरा री बेल तेसा जगा ते जेती से लगाई राखी थी, तेस दूजे उकाब पंछिये रिया तरफा खे आपणी जड़ फैलाणे ओर डाल़िया नपाणे लगी ताकि से तेसा खे खींजेया करो। <verse eid="EZK 17:7" /><verse number="8" style="v" sid="EZK 17:8" />अंगूरो री बेल अच्छे डोरूए दे ओर अच्छे पाणिए गे लगाई राखी थी ताकि अच्छे फल, डाल़िया ओर खरी अंगूरा री डाल़ी बणो। <verse eid="EZK 17:8" /><verse number="9" style="v" sid="EZK 17:9" />फेर जेबे तूँ लोका खे ये बताई दे, तो तिना खे बोलणा, यहोवा ईंयाँ बोलोआ, “एसा बेला पक्का ना तो ठीक ए ओर ना ई एसा फल देणे। एतेखे लगाणे वाल़े उकाबो से जड़ी ते पटी देणी, ओर एतेरे सारे फल़ अल़ी जाणे ओर एतेरे पत्ते सूकी जाणे। एतेखे पटणे खे कोई तागतबर लोका री जरूरत नि ए। <verse eid="EZK 17:9" /><verse number="10" style="v" sid="EZK 17:10" />चाए से लगी री बी रओ, तेबे बी से फलणी-फूलणी नि, जेबे तेतेखे गर्म अवा लगणी, तेबे से बेल पूरी तरअ ते सूकी जाणी। से जेती जम्मी री तेते क्यारिया देई सूकी जाणी।”<verse eid="EZK 17:10" /></para>
  <para style="s">प्रमाणो रा मतलब</para>
  <para style="p">
    <verse number="11" style="v" sid="EZK 17:11" />तेबे यहोवे रा ये सन्देश माखे मिलेया, “तेस बगावत करने वाल़े कराने खे बोल, <verse eid="EZK 17:11" /><verse number="12" style="v" sid="EZK 17:12" />इना बगावत करने वाल़ेया लोका ते पूछ, उकाबो री एसा बुजाणिया रा मतलब। तेबे तिना खे बोल, बाबेलो रे राजे यरूशलेमो दे जाई की तेथो रे राजा ओर परदान लई की आपणे बाबेलो दे पऊँचाए।” <verse eid="EZK 17:12" /><verse number="13" style="v" sid="EZK 17:13" />नबूकदनेस्सरे सिदकिय्याह चूणेया जो यहूदा रे राजे रे परिवारो रा था। तिने तेस माणूंए ते वादा कित्तेया ओर तेसखे वशो दे रणे री कसम खुल़ाई ओर देशो रे परदाना खे लईगा। <verse eid="EZK 17:13" /><verse number="14" style="v" sid="EZK 17:14" />बेबीलोनो रे राजे एड़ा इजी खे कित्तेया ताकि इस्राएलो रा राज्य कमजोर ऊई जाओ, ओर से फेर ऊबे उठी नि सको, ओर सिर्फ आपणे समजौते रिया बजा ते ई जिऊँदा रई सको। <verse eid="EZK 17:14" /><verse number="15" style="v" sid="EZK 17:15" />पर यहूदा रे नवें राजे बादो ते बेबीलोनो रे राजे रे खलाफ बिद्रोह कित्तेया ओर कोड़े ओर बड़ी सेना माँगणे खे आपणे दूत मिस्रो दे पेजी ते। क्या से फलणा-फूलणा? क्या एड़े काम करने वाल़ा बचणा? क्या से आपणी वाचा तोड़ने ते बाद बी बची जाणा? <verse eid="EZK 17:15" /><verse number="16" style="v" sid="EZK 17:16" />आऊँ परमेशर यहोवा ईंयाँ बोलूँआ, “आऊँ आपणी जिन्दगिया री कसम खाई कि वचन देऊँआ, कि ये नवां राजा बाबेलो दे मरना, कऊँकि तिने आपणी कसम ओर बाबेलो रे राजे साथे कित्तेया रा समजौता तोड़ी ता, जिने से राजा बणाया था। <verse eid="EZK 17:16" /><verse number="17" style="v" sid="EZK 17:17" />मिस्रो रा राजा यहूदा रे राजे री रक्षा करने दे असमर्थ था। से बऊत सारे सैनिका खे पेजी सकोआ पर मिस्रो री महान शक्ति यहूदा री रक्षा नि करी सकदी। नबूकदनेस्सरो री सेना शईरो पाँदे कब्जा करने खे कच्ची सड़का ओर माट्टिया रिया कांदा बनाणियां। बऊत ज्यादा लोक मरने। <verse eid="EZK 17:17" /><verse number="18" style="v" sid="EZK 17:18" />यहूदा रे राजे बेबीलोनो रे राजे साथे कित्ते रे आपणे समजौते रा पाल़न नि कित्तेया। तिने बेबीलोनो रे राजे री सेवा करने रा वादा कित्तेया था, पर इजी रे बजाए से तेसरे खलाफ ऊईगा। तिने जो वादा कित्तेया था, से नि कित्तेया, इजी री बजा ते यहूदा रा राजा बची नि सकदा।” <verse eid="EZK 17:18" /><verse number="19" style="v" sid="EZK 17:19" />परमेशर यहोवा ईंयाँ बोलोआ, “मेरी जिन्दगिया री कसम, सिदकिय्याहे मेरी कसम तुच्छ जाणी ओर मेरी वाचा तोड़ी राखी, एस पापो रिया बजा ते मां तेसखे सजा देणी। <verse eid="EZK 17:19" /><verse number="20" style="v" sid="EZK 17:20" />ये एड़ा ऊणा मानो मां तेस पकड़ने खे जाल़ बछाणा ओर से तिदे फसी जाणा। से पकड़ी की बेबीलोनो दे लई जाणा ओर सजा देणी कऊँकि तिने मेरे खलाफ बिद्रोह कित्तेया था। <verse eid="EZK 17:20" /><verse number="21" style="v" sid="EZK 17:21" />तेसरे सारे दलो बीचा ते जितणे नठोगे, सब लड़ाईया दे मरने ओर जो रयी जाओगे, सेयो चऊँ दिशा दे तित्तर-बित्तर ऊई जाणे। तेबे तुसा लोका खे पता लगी जाणा कि मैं यहोवे ई एड़ा बोली राखेया।”<verse eid="EZK 17:21" /></para>
  <para style="s">परमेशरो री प्रतिज्ञा</para>
  <para style="p">
    <verse number="22" style="v" sid="EZK 17:22" />तेबे परमेशर यहोवा एड़ा बोलेया, “मां बी देवदारो री ऊच्ची चूँडिया ते कुछ लई की लगाणा ओर तेतेरी सबी ते पाँदली पाँगटिया ते एक नरम पाँगटी तोड़ी की एक ऊच्चे पाह्ड़ो पाँदे लगाणी, <verse eid="EZK 17:22" /><verse number="23" style="v" sid="EZK 17:23" />मां आपू इस्राएलो रे ऊच्चे पाह्ड़ो पाँदे लगाणी, तेबे से डाल़ी फैली की मजबूत ओर प्रतापी देवदार बणी जाणा ओर तेते थाले, मतलब तेतेरी डाल़िया री छांयी दे कई प्रकारा रे पंछिया बसेरा करना।<note caller="+" style="f"><char style="fr" closed="false">17:23 </char><char style="ft" closed="false">पज. 92:12 </char></note> <verse eid="EZK 17:23" /><verse number="24" style="v" sid="EZK 17:24" />तेबे मैदानो रे सबी डाल़ा खे पता लगी जाणा कि मैं परमेशरे ई ऊच्चे डाल़ निठे ओर निठे डाल़ ऊच्चे करी राखे, अरे डाल़ सुकाईते ओर सूके डाल़ अरे करीते। मैं यहोवे ई एड़ा बोली राखेया ओर तेड़ा ई करी बी दित्तेया।”<verse eid="EZK 17:24" /></para>
  <chapter eid="EZK 17" />
  <chapter number="18" style="c" sid="EZK 18" />
  <para style="s">पापो रिया तँईं व्यक्तिगत जिम्मेदारी</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 18:1" />तेबे यहोवे मांगे एक ओर सन्देश दित्तेया, <verse eid="EZK 18:1" /><verse number="2" style="v" sid="EZK 18:2" />तिने बोलेया, “ये कहावत क्या ए जो लोक इस्राएल देशो दे बार-बार बोलोए कि माये बावे खट्टे अँगूर खाए, पर बच्चेया खे खट्टा स्वाद मिलेया।” <verse eid="EZK 18:2" /><verse number="3" style="v" sid="EZK 18:3" />प्रभु यहोवा ये बोलोआ कि मेरिया जिन्दगिया री कसम, तुसा खे इस्राएलो दे फेर ये कहावत बोलणे रा मौका नि मिलणा। <verse eid="EZK 18:3" /><verse number="4" style="v" sid="EZK 18:4" />देखो, सबी रे प्राण तो मेरे ई ए, जेड़ा बाओ रा प्राण, तेड़ा ई पाऊआ रा बी प्राण ए, दोनो मेरे ई ए। एतेरिया तँईं जो आदमी पाप करोगा से तेथी ई मरी जाणा। <verse eid="EZK 18:4" /><verse number="5" style="v" sid="EZK 18:5" />जो कोई आदमी पला ओ, तेबे से जिऊँदा रणा। से पला आदमी ओर न्याय ओर तर्मो रे काम करो, <verse eid="EZK 18:5" /><verse number="6" style="v" sid="EZK 18:6" />ओर ना तो पाह्ड़ो रे पूजा री जगा पाँदे रोटी खाई ओ, ना इस्राएलो रे लोका रिया मूर्तिया री पूजा कित्ती ओ; ना दूजे री लाड़िया साथे गल़त काम कित्तेया ओ, ओर ना छोतली जवाणसा रे नेड़े गया ओ, <verse eid="EZK 18:6" /><verse number="7" style="v" sid="EZK 18:7" />ओर ना केसी पाँदे अन्देर कित्तेया ओ बल्कि कर्जदारो खे तेसरी बन्धक फेर देईती ओ, ना केसी खे लूटेया ओ, बल्कि पूखे खे आपणी रोटी दित्ती ओ, ओर नांगे खे टाल़े दित्ते ओ, <verse eid="EZK 18:7" /><verse number="8" style="v" sid="EZK 18:8" />से केसी खे पैसे उधार नि देंदा ओर फेर तिजी रा ब्याज नि मांगदा ए। ओर से कोई बी बुरा काम करने खे ना करोआ। से लोका री मताद सच्चाईया ते ओर बिना केसी भेद-भावो ते करोआ। <verse eid="EZK 18:8" /><verse number="9" style="v" sid="EZK 18:9" />से मेरे बिधि बिधानो खे सई तरीके ते मानोआ, सच्चाईया साथे काम करोआ, एड़ा माणूं तर्मी ए, से पक्का ई जिऊँदा रणा, प्रभु यहोवे री येई वाणी ए। <verse eid="EZK 18:9" /><verse number="10" style="v" sid="EZK 18:10" />पर जे तेसरा पाऊ डाकू, अत्यारा, या ऊबे बोली राखे पापा बीचा ते केसी रा करने वाल़ा ओ, <verse eid="EZK 18:10" /><verse number="11" style="v" sid="EZK 18:11" />ओर ऊबे बोली राखे खरे कामो खे करने वाल़ा ना ओ, ओर पाह्ड़ो रिया पूजा रिया जगा पाँदे रोटी खाई ओ, ओर तिने दूजे री केसी लाड़िया साथे गल़त काम करी की प्रष्ट कित्तेया ओ, <verse eid="EZK 18:11" /><verse number="12" style="v" sid="EZK 18:12" />तिने गरीब लोका पाँदे अन्देर कित्तेया ओ, ओरी खे लूटेया ओ, बन्दक वापस नि कित्ती ओ, मूर्तिया रिया तरफा खे आख चकी ओ, बुरा काम कित्तेया ओ। <verse eid="EZK 18:12" /><verse number="13" style="v" sid="EZK 18:13" />ब्याजो पाँदे पैसा दित्तेया ओ, ओर ब्याज लया ओ तेबे क्या से जिऊँदा रणा? से जिऊँदा नि रणा; इजी खे की तिने ये सारे बुरे काम करी राखे से पक्का मरना ओर तेसरा खून तेसरे ई सिरो पाँदे पड़ना। <verse eid="EZK 18:13" /><verse number="14" style="v" sid="EZK 18:14" />फेर जे एड़े दुष्ट माणूंए रा पाऊ ओ ओर से आपणे बाओ रे ये सारे पाप देखी की डरो रे मारे तिना जेड़ा ना करदा ओ। <verse eid="EZK 18:14" /><verse number="15" style="v" sid="EZK 18:15" />मतलब ना तो पाह्ड़ो दे पूजा रिया जगा दे रोटी खाई ओ, ना इस्राएलो रे कराने री मूर्तिया री तरफा खे आख चकी ओ, ना पराई जवाणस प्रष्ट कित्ती ओ, <verse eid="EZK 18:15" /><verse number="16" style="v" sid="EZK 18:16" />ना केसी पाँदे अन्देर कित्तेया ओ, ना कुछ बन्धक लया ओ, ना कोई लूटेया ओ, बल्कि आपणी रोटी पूखेया खे देईती ओ, ओर जेसगे टाल्ले नि थे तेसखे टाल्ले दित्ते ओ, <verse eid="EZK 18:16" /><verse number="17" style="v" sid="EZK 18:17" />गरीब लोका रे नुकशाणो ते आथ रोकेया ओ, ब्याज ओर बढ़ती नि लई ओ, मेरे नियमो खे मानेया ओ, ओर मेरी बिधिया पाँदे चलेया ओ, तेबे से आपणे बाओ रे पापो रिया बजा ते नि मरना, बल्कि जिऊँदा ई रणा। <verse eid="EZK 18:17" /><verse number="18" style="v" sid="EZK 18:18" />तेसरा बाओ, जिने अन्देर कित्तेया ओर लूटेया, ओर आपणे साथो रे लोका बीचे बुरा काम कित्तेया, से आपणे बुरे कामो रिया बजा ते मरी जाणा। <verse eid="EZK 18:18" /><verse number="19" style="v" sid="EZK 18:19" />जे तुसे मांते पूछो कि बाओ रे पापो रिया बजा ते तेसरे पाऊए खे सजा कऊँ नि ऊणी, तो मां ज्वाब देणा कि पाऊए सेई कित्तेया जो सई ओर ठीक था तिने बऊत सावधानिया साथे मेरे नियमो रा पाल़न कित्तेया! तेबे से जिऊँदा रणा। <verse eid="EZK 18:19" /><verse number="20" style="v" sid="EZK 18:20" />जो आदमी पाप करोगा सेई मरोगा, ना तो पाऊ बाओ रे पापा रा बोज चकोगा ओर न बाओ पाऊए रा; तर्मिये खे आपणे ई तर्मो रा फल, ओर दुष्टो खे आपणी ई दुष्टता रा फल मिलणा।<note caller="+" style="f"><char style="fr" closed="false">18:20 </char><char style="ft" closed="false">लेवी. 26:16 </char></note> <verse eid="EZK 18:20" /><verse number="21" style="v" sid="EZK 18:21" />पर जे दुष्ट माणूं आपणे सब पापो ते फिरी की, मेरी सब बिधिया रा पाल़न करो ओर न्याय ओर तर्मो रे काम करो, तेबे से नि मरना; बल्कि जिऊँदा ई रणा। <verse eid="EZK 18:21" /><verse number="22" style="v" sid="EZK 18:22" />तिने जितणे पाप कित्ते ओ, तिना बिचा ते केसी री याद तेसरे खलाफ नि करनी; जो तर्मो रे काम तिने कित्ते ओ, तेसरिया बजा ते से जिऊँदा रणा। <verse eid="EZK 18:22" /><verse number="23" style="v" sid="EZK 18:23" />मां प्रभु यहोवे री ये वाणी ए, “क्या आऊँ दुष्टो रे मरने ते थोड़ा जा बी खुश ऊँआ? क्या आऊँ इजी ते खुश नि ऊँदा कि से आपणियां बाटा ते फिरी की जिऊँदा रओ?<note caller="+" style="f"><char style="fr" closed="false">18:23 </char><char style="ft" closed="false">1 तीमु. 2:4 </char></note>” <verse eid="EZK 18:23" /><verse number="24" style="v" sid="EZK 18:24" />पर जेबे एक तर्मी माणूं खरे ओर सई काम करना बन्द करी सकोआ, बल्कि दुष्टो रे जे सारे बुरे कामा खे करने लगोआ। तेबे से जिऊँदा नि रई सकदा। जितणे तर्मो रे काम तिने करी राखे, मां तिना बिचा ते कोई बी याद नि राखणे। इजी रे बजाये मां तेसखे तेसरे कित्ते रे बुरे कामा रिया बजा ते सजा देणी। से मां साथे परोसे जोगा नि रया, तेतेरिया बजा ते से मरी जाणा। <verse eid="EZK 18:24" /><verse number="25" style="v" sid="EZK 18:25" />परमेशरे बोलेया, तेबे बी तुसे लोक बोलोए, “प्रभुए री चाल एक जेड़ी नि ए।” ओ इस्राएलो रे कराने, देख, क्या मेरी चाल एक जेड़ी नि ए? क्या तेरी चाल गल़त नि ए? <verse eid="EZK 18:25" /><verse number="26" style="v" sid="EZK 18:26" />जेबे तर्मी आपणे तर्मो ते फिरी कि बुरे काम करने लगो, तेबे से तिना रिया बजा ते मरना, मतलब से आपणे बुरे कामो रिया बजा ते ई मरी जाणा। <verse eid="EZK 18:26" /><verse number="27" style="v" sid="EZK 18:27" />फेर जेबे दुष्ट आपणे बुरे कामो ते फिरी कि, न्याय ओर तर्मो रे काम करने लगो, तेबे से आपणे प्राण बचाओगा। <verse eid="EZK 18:27" /><verse number="28" style="v" sid="EZK 18:28" />से जो सोच बचार करी की आपणे सारे अपराधा ते फिरेया, इजी बजा ते नि मरना, जिऊँदा ई रणा। <verse eid="EZK 18:28" /><verse number="29" style="v" sid="EZK 18:29" />तेबे बी इस्राएलो रे लोके बोलेया कि प्रभुए री चाल एक जेड़ी नि ए। ओ इस्राएलो रे कराने, क्या मेरी चाल एक जेड़ी निए? क्या तुसा री चाल गल़त नि? <verse eid="EZK 18:29" /><verse number="30" style="v" sid="EZK 18:30" />प्रभु यहोवे री ये वाणी ए, “ओ इस्राएलो रे लोको, मा तुसा बिचा ते हर एक माणूंआ रा न्याय तेसरे चाल चलणो रे मुताबिक ई करना। पश्चाताप करो ओर आपणे सारे पापा खे छाडो, तेबे तुसा रा तर्म तुसा खे ठोकर खाणे री बजा नि ऊणा। <verse eid="EZK 18:30" /><verse number="31" style="v" sid="EZK 18:31" />आपणे सारे पाप जो तुसे करी राखे, दूर करो; आपणा मन ओर आपणी आत्मा बदलो! ओ इस्राएलो रे लोको, तुसे कऊँ मरो?” <verse eid="EZK 18:31" /><verse number="32" style="v" sid="EZK 18:32" />माखे खुशी नि ऊँदी जेबे केसी खे मरना पड़ोआ। आपणे पापा ते दूर ऊई जाओ ताकि तुसे जिऊँदे रओ। सर्वशक्तिमान यहोवे री ये ई वाणी ए।<verse eid="EZK 18:32" /></para>
  <chapter eid="EZK 18" />
  <chapter number="19" style="c" sid="EZK 19" />
  <para style="s">राजकुमारो रिया तँईं इस्राएलो रा शोग</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 19:1" />यहोवे माखे बोलेया, “यहेजकेल इस्राएलो रे दुनी परदाना रे बारे दे तूँ ये शोगो रा गीत सुणा, <verse eid="EZK 19:1" /><verse number="2" style="v" sid="EZK 19:2" />‘इस्राएलो रे हाकिमा खे बोल, एड़ा लगोआ जेड़े तुसा री माये एक एड़ी शेरनी थी, जेसे आपणे बच्चेया खे दूजे जवान शेरा बीचे पाल़ेया था।’ <verse eid="EZK 19:2" /><verse number="3" style="v" sid="EZK 19:3" />तेसे आपणे एक बच्चे खे शिकार करने खे जानवर पकड़ने सिखाए, जिंयाँ-जिंयाँ से बड़ा ऊआ, तिने लोका खे खाणा शुरू करी ता। <verse eid="EZK 19:3" /><verse number="4" style="v" sid="EZK 19:4" />जेबे ओरी देशो रे लोके तेसरे बारे दे सुणेया। तिने एक खड्डा खणेया ओर आपणे जाल़ो दे से फसाईता। तिने तेसदे कांडे पाए ओर तेसखे मिस्रो दे लईगे। <verse eid="EZK 19:4" /><verse number="5" style="v" sid="EZK 19:5" />तेसरी माये तेसरे कअरे आऊणे रा इन्तजार करोई। से नि आया ओर तेसे तेसरिया तँईं उम्मीद करना छाडीता। तेसे आपणे दूजे माठे खे एक जवान शेर बणने दे मताद कित्ती। <verse eid="EZK 19:5" /><verse number="6" style="v" sid="EZK 19:6" />तेबे से जवान शेर ऊई की शेरा बीचे चलणे-फिरने लगेया ओर से बी शिकार पकड़ना सीखी गा ओर तिने बी माणूंआ रा शिकार करना ओर खाणा शुरू करिता। <verse eid="EZK 19:6" /><verse number="7" style="v" sid="EZK 19:7" />तिने तिना रे मईलो पाँदे अमला कित्तेया। तिने शईर नाश कित्ते ओर सेयो उजाड़ी ते, बल्कि तेसरे गरजणे रे डरो रे मारे यहूदा देश ओर जो कुछ तिदे था सब ऊजड़ी गा। <verse eid="EZK 19:7" /><verse number="8" style="v" sid="EZK 19:8" />तेबे तेसरे चऊँ कनारले देशा रे लोक आपणे-आपणे राज ते तेसरे खलाफ निकल़ी की आए, ओर तिने तेस पाँदे जाल़ सेटेया। तिने से आपणे जाल़ो दे फसाईता। <verse eid="EZK 19:8" /><verse number="9" style="v" sid="EZK 19:9" />तेबे सेयो तेसरे नकेल लगाई की जेला दे बन्द करी की बाबेलो रे राजे गे लईगे ओर गढ़ो दे बन्द करी ता, ताकि तेसरी आवाज इस्राएलो रे पाह्ड़ी देशो दे फेर नि सुणो।”<verse eid="EZK 19:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="EZK 19:10" />तेरी माये जेसा ते तूँ जम्मेया, से कनारे पाँदे लगी री अंगूरा री बेला जेड़ी थी ओर डूगे पाणिए रिया बजा ते फल ओर डाल़िया साथे परी री थी। <verse eid="EZK 19:10" /><verse number="11" style="v" sid="EZK 19:11" />राज करने वाल़ेया रे राजदण्डो खे तेते बेला दे मोटिया-मोटिया पाँगटिया थिया ओर से इतणी ऊच्ची ऊई कि से बादल़ा तँईं खे पऊँची ओर आपणी बऊत सारी डाल़िया समेत से बऊत ई लाम्बी ओर मजबूत दिशणे लगी। <verse eid="EZK 19:11" /><verse number="12" style="v" sid="EZK 19:12" />तेबे बी से बेल रोषो रे आई की जमीना दे पट्टी की सेटी ती ओर तेतेरे फल तूप पखणे रिया बजा ते सूकी गे ओर तेतेरी मोटिया पाँगटिया टूटी की सूकी गिया ओर सेयो आगी रे स्वा ऊईगिया। <verse eid="EZK 19:12" /><verse number="13" style="v" sid="EZK 19:13" />एबे से बेल रेगिस्तानो दे जमणे लगी री। से गर्म, सूकिया जगा दे ए जेती पाणी नि ए। <verse eid="EZK 19:13" /><verse number="14" style="v" sid="EZK 19:14" />आगी तेते रा चोठ जल़ाना शुरू करिता, फेर तेतेरी पाँगटिया जल़ाना शुरू करिता ओर सारे अँगूर जल़ाईते। एबे एक बी मजबूत डाल़ी नि बची री; सेयो कदी बी राजे रिया तँईं राजदण्ड नि बणने। येई शोगो रा गीत ए ओर ये शोगो रे बखते गाया जाणा चाईयो।<verse eid="EZK 19:14" /></para>
  <chapter eid="EZK 19" />
  <chapter number="20" style="c" sid="EZK 20" />
  <para style="s">इस्राएलो रा बिद्रोह</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 20:1" />म्हारे गुलामिया दे गये दे पाँजुए मीन्ने रे दसुए दिने इस्राएलो रे कुछ बुजुर्ग मांगे आए। ये सातुआ साल था जेबे आसे बेबीलोनो दे बन्दी थे। परदान मां सामणे बैठी रे थे। सेयो चाओ थे कि आऊँ यहोवे ते कुछ सन्देश पूछूँ। <verse eid="EZK 20:1" /><verse number="2" style="v" sid="EZK 20:2" />तेबे यहोवे माखे बोलेया, <verse eid="EZK 20:2" /><verse number="3" style="v" sid="EZK 20:3" />“ओ नाश ऊणे वाल़े माणूंआ, इस्राएली बुजुर्गा खे ईंयाँ बोल, परमेशर यहोवा ईंयाँ बोलोआ, तुसे बोलोए कि तुसे मांते कोई सन्देश चाओए। आऊँ तुसा खे बोलूँआ कि मेरी जिन्दगिया री कसम, मां तुसे ईंयाँ आपू नेड़े नि आऊणे देणे। <verse eid="EZK 20:3" /><verse number="4" style="v" sid="EZK 20:4" />ओ नाश ऊणे वाल़े माणूंआ, तिना रा न्याय कर ओर तिना खे दोषी ठरा। ओर तिना खे बोल कि तिना रे बुजुर्गा रे घिनौने काम कितणे बुरे थे। <verse eid="EZK 20:4" /><verse number="5" style="v" sid="EZK 20:5" />ओर तिना खे बोल, परमेशर यहोवा ईंयाँ बोलोआ: जेस दिने मैं इस्राएलो रे लोक चूणी ले ओर याकूबो रे कुलो ते कसम खाई ओर मिस्र देशो दे आपणे आपू खे प्रगट कित्तेया ओर तिना साथे कसम खाई की बोलेया, आऊँ तुसा रा परमेशर यहोवा ए। <verse eid="EZK 20:5" /><verse number="6" style="v" sid="EZK 20:6" />तेस दिने ई मैं तिना खे ये बी कसम खाई कि मां तुसे मिस्र देशो ते निकयाल़ी की एक देशो दे पऊँचाणे, जो मैं तुसा रिया तँईं चूणी ला रा, से सबी देशो ते जादा सुन्दर ए ओर तिदे दूद ओर सयीतो रिया खाड्डा बह्ओईया।” <verse eid="EZK 20:6" /><verse number="7" style="v" sid="EZK 20:7" />तुसा बीचा ते हे एकी खे आपणियां-आपणियां घिनौनिया मूर्तिया दूर करनिया चाईयो जिना ते तुसे प्यार करो थे, ओर मिस्रो रे देवतेया रिया मूर्तिया साथे आपू खे अशुद्ध नि करो। कऊँकि आऊँ ई तुसा रा परमेशर यहोवा ए। <verse eid="EZK 20:7" /><verse number="8" style="v" sid="EZK 20:8" />पर सेयो मेरे खलाफ ऊईगे ओर तिने मेरी एक नि सुणनी चायी, जिना घृणित मूर्तिया ते सेयो प्यार करो थे, सेयो किने बी सेटिया नि ओर ना मिस्रो रिया मूर्तिया छाडिया। तेबे मैं बोलेया, “मां एथी मिस्र देशो दे तुसा खे सजा देणी ओर पूरा कोप दखाणा। <verse eid="EZK 20:8" /><verse number="9" style="v" sid="EZK 20:9" />तेबे बी मैं आपणे नाओं रे मुताबिक एड़ा कित्तेया कि जिना बीचे सेयो थे ओर जिना सामणे आऊँ तिना खे मिस्र देशो ते काडणे खे सामणे आया था तिना जातिया सामणे सेयो अपवित्र नि ठईरो। <verse eid="EZK 20:9" /><verse number="10" style="v" sid="EZK 20:10" />आऊँ इस्राएलो रे परिवारो खे मिस्रो ते बारे निकयाल़ी की रेगिस्तानो दे ली आया। <verse eid="EZK 20:10" /><verse number="11" style="v" sid="EZK 20:11" />तेती मैं तिना खे आपणी बिधिया बताईया ओर आपणे बिधान बी बताए ताकि जो कोई माणूं तिना खे मानो, से तिना रिया बजा ते जिऊँदा रओ। <verse eid="EZK 20:11" /><verse number="12" style="v" sid="EZK 20:12" />तेबे मैं तिना रिया तँईं आपणे रामो रे दिन ठराए जो मेरे ओर तिना बीचे नशाण ठईरे ताकि सेयो जाणो कि आऊँ परमेशर तिना खे पवित्र करने वाल़ा ए। <verse eid="EZK 20:12" /><verse number="13" style="v" sid="EZK 20:13" />तेबे बी इस्राएलो रे लोके मां साथे रेगिस्तानो दे बगावत कित्ती, सेयो मेरी बिधिया पाँदे नि चले ओर मेरे बिधान तुच्छ जाणे, जिना खे जे माणूं मानो तो से तिना खे मानी की जिऊँदा रणा ओर तिने मेरे रामो रे दिन बऊत अपवित्र करीते।” तेबे मैं बोलेया, “इजी बजा ते आऊँ तिना ते बऊत नराज था। मैं तिना खे तेथी रेगिस्तानो दे नाश करने रा फैंसला करी ला था, <verse eid="EZK 20:13" /><verse number="14" style="v" sid="EZK 20:14" />पर मैं आपणे तर्मी नाओं रे मुताबिक एड़ा कित्तेया कि सेयो तिना जातिया सामणे, जिना सामणे ते आऊँ तिना खे निकयाल़ी की ल्याया था, अपवित्र नि ठईरो। <verse eid="EZK 20:14" /><verse number="15" style="v" sid="EZK 20:15" />तेबे मैं रेगिस्तानो दे तिना ते कसम खाई कि जो देश मैं तिना खे देईता रा ओर जो सबी देशा बीचे सुन्दर ए, जिदे दूद ओर सयीतो रिया खाड्डा बह्ओईया, तिदे सेयो नि पऊँचाणे।” <verse eid="EZK 20:15" /><verse number="16" style="v" sid="EZK 20:16" />कऊँकि तिना खे मेरे नियम तुच्छ लगे ओर मेरी बिधिया पाँदे नि चले ओर मेरे रामो रे दिन अपवित्र कित्ते थे, कऊँकि तिना रा मन तिना री मूर्तिया रिया तरफा खे लगेया रा रया। <verse eid="EZK 20:16" /><verse number="17" style="v" sid="EZK 20:17" />तेबे बी मैं तिना पाँदे दया री नजर कित्ती ओर सेयो नाश नि कित्ते ओर ना ई सेयो रेगिस्तानो दे पूरी तरअ ते नाश कित्ते। <verse eid="EZK 20:17" /><verse number="18" style="v" sid="EZK 20:18" />तेबे मैं रेगिस्तानो दे तिना री ल्वादा खे बोलेया, “आपणे बुजुर्गा री बिधिया पाँदे नि चलो, ना तिना री रवाजा खे मानो ओर ना तिना री मूर्तिया री पूजा करी की आपू खे अशुद्ध करो। <verse eid="EZK 20:18" /><verse number="19" style="v" sid="EZK 20:19" />आऊँ तुसा रा परमेशर यहोवा ए, मेरी बिधिया पाँदे चलो ओर मेरे बिधान मानणे दे चौकसी करो <verse eid="EZK 20:19" /><verse number="20" style="v" sid="EZK 20:20" />ओर मेरे रामो रे दिनो खे पवित्र मानो कि सेयो मेरे ओर तुसा बीचे नशाण ठईरो ओर जेते कि तुसे जाणो कि आऊँ तुसा रा परमेशर यहोवा ए।” <verse eid="EZK 20:20" /><verse number="21" style="v" sid="EZK 20:21" />पर तिना रे बच्चेया बी मां साथे बगावत कित्ती, सेयो मेरी बिधिया पाँदे नि चले, ना मेरे बिधानो खे मानणे दे चौकसी कित्ती, जिना खे जे माणूं मानो तो सेयो तिना रिया बजा ते जिऊँदे रओ। तिने मेरे रामो रे दिनो रे बारे दे मेरे बिधानो रा पालण ना करी की से अपवित्र कित्तेया। इजी बजा ते आऊँ तिना ते बऊत नराज था। आऊँ तिना खे तेथी उजाड़ जगा दे नाश करने खे त्यार था। <verse eid="EZK 20:21" /><verse number="22" style="v" sid="EZK 20:22" />पर मैं आपणे आपू खे रोकेया। ओर आपणे नाओं रे मुताबिक एड़ा कित्तेया कि तिना जातिया सामणे जिना सामणे आऊँ इस्राएलिया खे निकयाल़ी की ल्याया था, सेयो अपवित्र नि ठईरो। <verse eid="EZK 20:22" /><verse number="23" style="v" sid="EZK 20:23" />तेबे मैं उजाड़ जगा दे तिना ते कसम खाई कि मां तुसे जातिया-जातिया बीचे तित्तर-बित्तर करी देणे। <verse eid="EZK 20:23" /><verse number="24" style="v" sid="EZK 20:24" />इस्राएलो रे लोके मेरिया बिदिया नि मानिया। तिने बिधानो खे मानणे खे ना करिती। ओर रामो रे दिनो खे तिने अशुद्ध कित्तेया। सेयो तिना मूर्तिया री पूजा करने खे बऊत ई उत्सुक थे जिना री पूजा तिना रे बुजुर्ग करेया करो थे। <verse eid="EZK 20:24" /><verse number="25" style="v" sid="EZK 20:25" />तेबे मैं तिना खे एड़िया-एड़िया बिधिया ठराईया जो अच्छिया नि थिया ओर एड़िया-एड़िया रवाजा जिना रिया बजा ते सेयो जिऊँदे नि रयी सको। <verse eid="EZK 20:25" /><verse number="26" style="v" sid="EZK 20:26" />मैं सेयो तिना रिया ई पेंटा रिया बजा ते अशुद्ध ऊणे दित्तेया, ओर आपणे सबी जेठेया पाऊआ खे आगी दे बलि करने दित्तेया। ये सब तिना खे सजा देणे ओर ये दखाणे रिया तँईं था कि आऊँ ई यहोवा ए। <verse eid="EZK 20:26" /><verse number="27" style="v" sid="EZK 20:27" />ओ नाश ऊणे वाल़े माणूंआ, तूँ इस्राएलो रे लोका खे बोल, परमेशर यहोवा ईंयाँ बोलोआ: इस्राएलो रे लोके मेरे खलाफ चूठिया गल्ला बोलिया ओर मेरे खलाफ बुरिया योजना बणाईया। <verse eid="EZK 20:27" /><verse number="28" style="v" sid="EZK 20:28" />कऊँकि जेबे मैं सेयो तेते देशो दे पऊँचाए, जेतेखे तिना खे देणे री कसम मैं खाई थी, तेबे सेयो हर एक ऊच्चे टीले ओर हर एक कणे डाल़ा पाँदे नजर करी की तेथी आपणे मेलबलि चढ़ाणे लगे ओर तेथी आपणी पेंटा चढ़ाणे लगे ओर माखे बऊत रोष चढ़ांदे रये, तेथी आपणा खुशबूदार तेल ओर तेथी आपणे अर्घ देणे लगे। <verse eid="EZK 20:28" /><verse number="29" style="v" sid="EZK 20:29" />तेबे मैं इस्राएलिया ते पूछेया, “जेती ऊच्ची जगा दे तुसे लोक जाओए, तेते रा क्या मतलब ए? इजी बजा तेई तेथो खे आजो तक बामा<note caller="+" style="f"><char style="fr" closed="false">20:29 </char><char style="fq" closed="false">बामा </char><char style="ft" closed="false">ऊच्ची जगा </char></note> बोलेया जाओआ।” <verse eid="EZK 20:29" /><verse number="30" style="v" sid="EZK 20:30" />यहोवे यिर्मयाह खे बोलेया, “इजी री खातर इस्राएलो रे लोका खे बोल, परमेशर यहोवा तुसा ते ये पूछोआ: क्या तुसे बी आपणे बुजुर्गा जेड़े आपू खे अशुद्ध करी देओए? तुसे मां साथे वफादार नि ए। इजी रे बदले क्या तुसे घृणित मूर्तिया री पूजा करी की व्याभिचारणिया रे काम करदे रणा चाओए?” <verse eid="EZK 20:30" /><verse number="31" style="v" sid="EZK 20:31" />आज बी तुसे सेई आपणी पेंटा चढ़ाओए ओर आपणे बाल-बच्चेया खे आगी दे बलि करी की आपू खे अशुद्ध करोए। चढ़ाओए, ओर फेर तुसे इस्राएलो रे लोक एबु बी ये पूछणे खे आओए कि मेरी इच्छा क्या ए! परमेशर यहोवे री ये बाणी ए कि मेरी जिन्दगिया री कसम तुसे मांते कुछ पनि पूछी सकणे। <verse eid="EZK 20:31" /><verse number="32" style="v" sid="EZK 20:32" />जो गल्ल तुसा रे मनो दे आओई कि आसा लक्कड़ ओर पात्थरो रिया मूर्तिया रे पुजारी ऊई की दूजी जातिया रे ओर देश-देशो रे कुलो जेड़े ऊई जाणे, से किंयाँ बी पूरी नि ऊई सकदी।<verse eid="EZK 20:32" /></para>
  <para style="s">परमेशरो इस्राएल दुबारा बसाणा</para>
  <para style="p">
    <verse number="33" style="v" sid="EZK 20:33" />आऊँ परमेशर यहोवा ईंयाँ बोलूँआ, “मेरी जिन्दगिया री कसम मां आपणी बड़ी शक्तिया साथे ओर बड़े पारी रोषो दे आई की तुसा पाँदे राज करना।<note caller="+" style="f"><char style="fr" closed="false">20:33 </char><char style="ft" closed="false">यिर्म. 21:6 </char></note> <verse eid="EZK 20:33" /><verse number="34" style="v" sid="EZK 20:34" />मां तागतबर आथ ओर बढ़ाई रिया बाई ते, ओर पड़काई री जलजलाहटा साथे तुसे देश-देशो रे लोका बीचा ते लग करने ओर तिना देशो रे जेती तुसे तित्तर-बित्तर ऊईगे थे, कट्ठे करने। <verse eid="EZK 20:34" /><verse number="35" style="v" sid="EZK 20:35" />ओर मां तुसे एकी उजाड़ जगा दे लई जाणे, जो दूजी जातिया रे लोके चऊँ कनारा ते केरी राखेया ए। तेती मां तुसा रे आमणे-सामणे तुसा रा न्याय करना। <verse eid="EZK 20:35" /><verse number="36" style="v" sid="EZK 20:36" />मैं तुसा रे बुजुर्गा खे उजाड़ जगा दे तेबे सजा दित्ती थी जेबे सेयो मिस्रो ते बारे आए थे। मां तुसा खे बी तिंयाँ ई सजा देणी। मां परमेशर यहोवे री येई बाणी ए।” <verse eid="EZK 20:36" /><verse number="37" style="v" sid="EZK 20:37" />मां तुसे डण्डे रे सारे चलाणे ओर तुसे वाचा रे बन्दनो दे पाणे। <verse eid="EZK 20:37" /><verse number="38" style="v" sid="EZK 20:38" />मां तुसा बीचा ते सारे बगावत करने वाल़े निकयाल़ी की जो मेरा अपराद करोए, तुसे शुद्ध करने ओर जेस देशो दे सेयो टिकोए, तेथा ते सेयो मां निकयाल़ी की ल्याऊणे, पर इस्राएलो रे देशो रे कूसणे नि देणे, तेबे तुसा खे पता लगी जाणा कि आऊँ ई यहोवा ए। <verse eid="EZK 20:38" /><verse number="39" style="v" sid="EZK 20:39" />ओ इस्राएलो रे लोके, तुसा खे तो परमेशर यहोवा ईंयाँ बोलोआ: जाई की आपणी-आपणी देवतेया री मूर्तिया री आराधना करो ओर जे तुसे मेरी नि सुणोगे, तो बादो ते बी एड़ा ई करेया करो, पर मेरा पवित्र नाओं आपणी पेंट ओर मूर्तिया रे जरीये अपवित्र नि करना। <verse eid="EZK 20:39" /><verse number="40" style="v" sid="EZK 20:40" />कऊँकि परमेशर यहोवा ईंयाँ बोलोआ कि इस्राएलो रा सारा कराना आपणे देशो रे मेरे पवित्र सिय्योन पाह्ड़ो पाँदे, इस्राएलो रे ऊच्चे पाह्ड़ो पाँदे, सारे के सारेया मेरी आराधना करनी, आऊँ तेथी तिना ते खुश ऊणा ओर तेथी मां तुसा रिया चकी रिया पेंटा ओर चढ़ाई रिया खरिया-खरिया चीजा ओर तुसा रिया सब पवित्र कित्तिया रिया चीजा तुसा ते लया करूँगा। <verse eid="EZK 20:40" /><verse number="41" style="v" sid="EZK 20:41" />मां तुसे देशो ते ओर तिना सबी जगा ते वापस ल्याऊणे तेती तुसे रंदे आई रे। तेबे मां तुसा रा स्वागत करना, जेड़े कि माखे खुश करने वाल़ा खुशबू देणे वाल़ा तूप। जेबे मां तुसा बीचे रणा, तो मां ओरी सबी देशा खे दखाणा कि आऊँ पवित्र ए।<note caller="+" style="f"><char style="fr" closed="false">20:41 </char><char style="ft" closed="false">यहे. 28:25 </char></note> <verse eid="EZK 20:41" /><verse number="42" style="v" sid="EZK 20:42" />जेबे आऊँ तुसा खे इस्राएलो रे देशो रे पऊँचाऊँ, जेतेखे देणे री कसम मैं तुसा रे बुजुर्गा ते खाई थी, तेबे तुसा खे पता लगी जाणा कि आऊँ ई यहोवा ए। <verse eid="EZK 20:42" /><verse number="43" style="v" sid="EZK 20:43" />तेती तुसा आपणा चाल-चलण ओर आपणे सारे काम जिना खे करी की तुसे अशुद्ध ऊई रे याद करने ओर आपणे बुरे कामो रिया बजा ते आपणी नजरा रे घिनौने ठईरने। <verse eid="EZK 20:43" /><verse number="44" style="v" sid="EZK 20:44" />ओ इस्राएलो रे कराने, जेबे आऊँ तुसा साथे तुसा रे बुरे चाल-चलण ओर बिगड़े रे कामो रे मुताबिक नि, पर आपणे ई नाओं रे मुताबिक बर्ताव करुँ, तेबे तुसा खे पता लगी जाणा कि आऊँ ई यहोवा ए, परमेशर यहोवे री येई बाणी ए।<verse eid="EZK 20:44" /></para>
  <para style="s">दक्खण देशो रे बणो दे आग</para>
  <para style="p">
    <verse number="45" style="v" sid="EZK 20:45" />तेबे यहोवे रा ये सन्देश माखे फेर मिलेया, <verse eid="EZK 20:45" /><verse number="46" style="v" sid="EZK 20:46" />“ओ नाश ऊणे वाल़े माणूंआ, आपणा मूँ इस्राएलो रे दक्खण दिशा रिया जगा खे कर, दक्खणा रिया जगा खे वचन सुणा ओर दक्खण देशो रे बणो<note caller="+" style="f"><char style="fr" closed="false">20:46 </char><char style="fq" closed="false">दक्खण देशो रे बणो </char><char style="ft" closed="false">यरूशलेम </char></note> रे बारे दे भविष्यबाणी कर।” <verse eid="EZK 20:46" /><verse number="47" style="v" sid="EZK 20:47" />दक्खण देशो रे बणो खे बोल, परमेशर यहोवे रा ये वचन सुण, परमेशर यहोवा ईंयाँ बोलोआ, “मां तांदे आग लगाई देणी, ओर जितणे तेरे अरे, सूके, जितणे बी डाल़ ए, सेयो सारे आगी दे फूखी जाऊणे, तेती आग नि बिजणी ओर तिजी री बजा ते दखणो ते लई की उत्तरो तक सबी रे मूँ फूखी जाऊणे। <verse eid="EZK 20:47" /><verse number="48" style="v" sid="EZK 20:48" />तेबे सबी लोका खे पता लगणा कि ये आग यहोवे री लगाई रिये ओर ये कदी नि बिजणी।” <verse eid="EZK 20:48" /><verse number="49" style="v" sid="EZK 20:49" />तेबे मैं परमेशरो ते शकाईत करी की बोलेया, “ओ परमेशर यहोवा, जेबे आऊँ एड़िया गल्ला लोका खे बोलूँआ, तो सेयो लोक मेरे बारे दे बोलेया करोए कि ये तो सिर्फ काअणी ई बोलेया करोआ।”<verse eid="EZK 20:49" /></para>
  <chapter eid="EZK 20" />
  <chapter number="21" style="c" sid="EZK 21" />
  <para style="s">बाबेल परमेशरो री तलवार</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 21:1" />यहोवे फेर माखे ये सन्देश दित्तेया, <verse eid="EZK 21:1" /><verse number="2" style="v" sid="EZK 21:2" />ओ नाश ऊणे वाल़े माणूंआ, आपणा मूँ यरूशलेमो रिया तरफा खे कर ओर आराधना करने री पवित्र जगा रिया तरफा खे वचन सुणा; इस्राएल देशो रे बारे दे भविष्यबाणी कर ओर तिना खे चतौणी दे, <verse eid="EZK 21:2" /><verse number="3" style="v" sid="EZK 21:3" />प्रभु यहोवा यहेजकेलो खे बोलोआ कि इस्राएलो रे लोका खे ईंयाँ बोल, “देख, आऊँ तेरे खलाफ ए ओर मां आपणी तलवार म्यानो ते खींजी की तां बीचा ते तर्मी ओर पापी दुँईं रा नाश करना। <verse eid="EZK 21:3" /><verse number="4" style="v" sid="EZK 21:4" />इजी खे कि आऊँ तां बीचा ते तर्मी ओर पापी दुँईं रा नाश करने वाल़ा ए, इजी बजा ते मां आपणी तलवार म्यानो ते निकाल़ी की तेतेरा इस्तेमाल देशो रे सबी लोका पाँदे दक्खणो ते लई की उत्तरो तक अमला करने खे करना; <verse eid="EZK 21:4" /><verse number="5" style="v" sid="EZK 21:5" />तेबे दुनिया रे सबी लोका खे पता लगी जाणा कि आऊँ यहोवा ए ओर तिना जाणी लणा की मैं आपणी तलवार म्यानो ते खींजी राखी ओर तेस तिदे फेर नि राखणी।” <verse eid="EZK 21:5" /><verse number="6" style="v" sid="EZK 21:6" />इजी री खातर ओ नाश ऊणे वाल़े माणूंआ, तू राड़ी दे, पारी दु:ख कर ओर बऊत दु:खी ऊई की इस्राएलो रे लोका सामणे राड़ी दे। <verse eid="EZK 21:6" /><verse number="7" style="v" sid="EZK 21:7" />जेबे सेयो तांते पूछो, तूँ राड़ी कऊँ देणे लगी रा, तेबे बोलेया, समाचारो रिया बजा ते। कऊँकि एड़ी गल्ल ऊणे वाल़ी ए कि सबी रे मन टूटी जाणे ओर सबी रे आथ टीले पड़ने, सबी री आत्मा बेबस ओर सबी रे जानू कमजोर ऊई जाणे। देखो, तुसे बेफिकर ऊई की रओ कि ये बऊत छोड़ ऊणा। परमेशर यहोवे री येई बाणी ए।<verse eid="EZK 21:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="EZK 21:8" />तेबे यहोवे माखे ये सन्देश दित्तेया, <verse eid="EZK 21:8" /><verse number="9" style="v" sid="EZK 21:9" />“ओ नाश ऊणे वाल़े माणूंआ, भविष्यबाणी करी की तिना खे बोल, परमेशर यहोवा ईंयाँ बोलोआ, देख, पैनी कित्ती री तलवार ओर चमकाई री तलवार! <verse eid="EZK 21:9" /><verse number="10" style="v" sid="EZK 21:10" />से मेरिया तलवारी खे पैनी करी राख कि आऊँ तीजी ते बऊत सारेया लोका खे कायी सकूँ; ओर ये इजी खे चमकाई राखी ताकि बिजल़िया जेड़ी चमको! तो क्या आसा खे खुश ऊणा चाईयो? से तो यहोवे रे पाऊए रा राजदण्ड ए, ओर सबी राजदण्डा खे बेकार जाणने वाल़ा ए। <verse eid="EZK 21:10" /><verse number="11" style="v" sid="EZK 21:11" />से चमकाणे खे इजी खे दित्ती थी ताकि आथो दे लई सको, से इजी खे पैनी कित्ती ओर चमकाई ती ताकि काणे वाल़ेया रे आथो दे देयो। <verse eid="EZK 21:11" /><verse number="12" style="v" sid="EZK 21:12" />इजी री खातर ओ नाश ऊणे वाल़े माणूंआ, चींगो, ओर हाय, हाय कर! कऊँकि तलवार मेरे लोका पाँदे चलणे वाल़ी ए, से इस्राएलो रे सबी परदाना पाँदे चलणे वाल़ी ए; मेरी प्रजा साथे सेयो बी तलवारी रे गेड़े दे आईगे, इजी बजा ते तूँ दु:खो दे आपणी छाती पीट। <verse eid="EZK 21:12" /><verse number="13" style="v" sid="EZK 21:13" />कऊँकि सच्ची तेसरी जाँच ऊई री जे तिना खे बेकार जाणने वाल़ा राजदण्ड पनि रओ, तो क्या? परमेशर यहोवे री येई बाणी ए। <verse eid="EZK 21:13" /><verse number="14" style="v" sid="EZK 21:14" />इजी री खातर परमेशरे बोलेया, ओ नाश ऊणे वाल़े माणूंआ, भविष्यबाणी कर ओर आथो साथे चाड़िया बजा ओर तलवार दो बार क्या तीन बार बी तलवार चलो, ये तो काणे खे तलवार ए, बल्कि बड़े ते बड़े खे काणे री तलवार ए, जो चऊँ कनारा ते तिना पाँदे अमला करोई। <verse eid="EZK 21:14" /><verse number="15" style="v" sid="EZK 21:15" />इजी बजा ते मेरे लोक डरो रे मारे काँबी जाणे। तिना बीचा ते बऊत जे रूड़ी जाणे। मेरी तलवार शईरो दे हर जगा तिना खे काणे खे त्यार ए। ये बिजल़िया जेड़ी चमकणे लगी री। ये काणे खे त्यार ए। <verse eid="EZK 21:15" /><verse number="16" style="v" sid="EZK 21:16" />ओ मेरी तलवार दोधारी बण, ओर दाँणे कनारे जा, तेबे त्यार ऊई की खूँजे कनारे मुड़, जेथो खे बी तेरा मूरा ओ। <verse eid="EZK 21:16" /><verse number="17" style="v" sid="EZK 21:17" />मां बी चाड़िया बजाणियां ओर आपणा रोष ठण्डा करना, माखे यहोवे एड़ा बोली राखेया।”<verse eid="EZK 21:17" /></para>
  <para style="s">बेबीलोनो रे राजे री तलवार</para>
  <para style="p">
    <verse number="18" style="v" sid="EZK 21:18" />तेबे यहोवे रा ये सन्देश माखे फेर मिलेया, <verse eid="EZK 21:18" /><verse number="19" style="v" sid="EZK 21:19" />“ओ नाश ऊणे वाल़े माणूंआ, दो बाटा बणाई दे ताकि बाबेलो रे राजे री तलवार आओ; दोनो बाटा एक ई देशो ते निकल़ो! तेबे एक नशाण बणा, मतलब शईरो रे मुरे पाँदे एक नशाण बणा; <verse eid="EZK 21:19" /><verse number="20" style="v" sid="EZK 21:20" />तलवारी खे सेयो दो जगा दखा जेती बाटा जाओईया। एक बाट शईरो री राजधानी रब्बा खे जाओई, जो अम्मोनिया रा बड़ा शईर ए। दूजी बाट यहूदा देशो रे गढ़वाल़े शईर यरूशलेमो दे जाओई। <verse eid="EZK 21:20" /><verse number="21" style="v" sid="EZK 21:21" />बाबेलो रा राजा तेते जगा दे पऊँचणा जेती बाट लग-लग जगा खे जाओई। तेस फैंसला करने री कोशिश करनी की केसा बाटा दे जाणा। तेस जादुए रा इस्तेमाल करी की आपणे देवतेया ते पूछणा ताकि सेयो तेसखे बताओ। तेस आपणे देवतेया री मूर्तिया ते प्रार्थना करनी। तेस जानवरा रा काल़जा देखणा। <verse eid="EZK 21:21" /><verse number="22" style="v" sid="EZK 21:22" />तेसरे दाँणे आथो रे यरूशलेमो रा नाओं ए ताकि से तेसरी तरफा खे युद्धो रे यन्त्र लगाओ ओर गल़ा फाड़ी की काणे री आज्ञा देयो ओर जोरे की ललकारो, शईरो रे बड़े द्वारो रिया तरफा खे युद्धो रे यन्त्र लगाओ ओर अथियार बानी की शईरो रे खलाफ कांदा पाँदे बैठी जाओ। <verse eid="EZK 21:22" /><verse number="23" style="v" sid="EZK 21:23" />यरूशलेमो रे लोका एते चूठो पाँदे परोसा नि करना कऊँकि तिने जो समजौता करी राखेया ए, से सच्च आ। पर बेबीलोनो रे राजे तिना खे तिना रे पाप याद दलाणे। ओर तिना खे आऊणे वाल़ी गुलामिया रे बारे दे चतौणी देणी।” <verse eid="EZK 21:23" /><verse number="24" style="v" sid="EZK 21:24" />इजी बजा ते प्रभु यहोवे माखे बोलेया: कऊँकि तुसा रे पाप याद करी राखे ओर तुसा रे पाप जो खुली गे रे, कऊँकि तुसा रे सबी कामा दे पाप ई पाप दिशी रा ओर तुसे याद आई रे, इजी री खातर तुसे दुश्मणा रे जरीये ई पकड़े जाणे। <verse eid="EZK 21:24" /><verse number="25" style="v" sid="EZK 21:25" />ओ इस्राएलो रे दुष्ट परदान, तेरा दिन आई गा रा, पापो रिया सजा रा बखत आई गा रा। <verse eid="EZK 21:25" /><verse number="26" style="v" sid="EZK 21:26" />तेरे बारे दे परमेशर यहोवा ईंयाँ बोलोआ: पगड़ी उतार ओर मुकुट बी उतारी दे, ये जेड़ा था तेड़ा नि रणा, जो ईठा ए तेसखे ऊच्चा कर ओर जो ऊच्चा ए तेसखे निठा कर।<note caller="+" style="f"><char style="fr" closed="false">21:26 </char><char style="ft" closed="false">पज. 75:7</char></note> <verse eid="EZK 21:26" /><verse number="27" style="v" sid="EZK 21:27" />मां से यरूशलेम शईर पुरिया तरह नाश करी देणा ओर सब कुछ सत्यानाश करी देणा ओर जदुओ तक तेसरा अधिकारी नि आओगा, तदुओ तक से उजाड़ रणा, तेबे मां तेसखे देई देणा।<verse eid="EZK 21:27" /></para>
  <para style="s">अम्मोनिया ते बेज्जतिया रा बदला लणा</para>
  <para style="p">
    <verse number="28" style="v" sid="EZK 21:28" />परमेशरे बोलेया, “ओ नाश ऊणे वाल़े माणूंआ, भविष्यबाणी करी की बोल कि प्रभु यहोवा अम्मोनी ओर तिना री कित्ती री बेज्जतिया रे बारे दे ईंयाँ बोलोआ, एक तलवार तिना खे नाश करने रिया तँईं त्यार ए। ये बिजल़िया रिया तरआ चमकी री ए, ये काणे रिया तँईं त्यार ए।” <verse eid="EZK 21:28" /><verse number="29" style="v" sid="EZK 21:29" />तुसा रे भविष्यबक्तेया तुसा खे चूठे दर्शण बताई राखे, ओर चूठी भविष्यबाणी ताखे बताओए ताकि तूँ तिना दुष्ट अदमरे कायला री क्याड़िया पाँदे पड़े जिना रा दिन आई गा रा ओर जिना रे पापो रे अन्तो रा दिन आई गा रा। <verse eid="EZK 21:29" /><verse number="30" style="v" sid="EZK 21:30" />एबे तुसे तलवारी खे म्यानी रे वापस राख। जेते जगा रे तूँ बणाई ओर जेते देशो दे तेरी शुरूआत ऊई, तिदे ई मा तेरा न्याय करना। <verse eid="EZK 21:30" /><verse number="31" style="v" sid="EZK 21:31" />मां तां पाँदे आपणा रोष पड़काणा ओर तुसा पाँदे आपणे रोषो री आग सेटणी ओर तूँ डांगरा जेड़ी माणूंआ रे आथो रे करी देणी जो नाश करने रे निपुण ए। <verse eid="EZK 21:31" /><verse number="32" style="v" sid="EZK 21:32" />तूँ आगी दे फूखी जाणा, तूँ काया जाणा ओर तेरा खून तेरे ई देशो दे बाह्या जाणा, ओर केसी तूँ फेर याद नि राखणा। कऊँकि मैं यहोवे ई एड़ा बोली राखेया।<verse eid="EZK 21:32" /></para>
  <chapter eid="EZK 21" />
  <chapter number="22" style="c" sid="EZK 22" />
  <para style="s">यरूशलेमो रा पाप</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 22:1" />यहोवे रा ये सन्देश एक बार फेर माखे मिलेया, <verse eid="EZK 22:1" /><verse number="2" style="v" sid="EZK 22:2" />“ओ नाश ऊणे वाल़े माणूंआ, तूँ ई न्याय कर, अत्यारे शईर यरूशलेमो रे पापो रा तूँ ई न्याय कर। तिने जो बुरे काम करी राखे तिना सबी खे तेसखे बता।” <verse eid="EZK 22:2" /><verse number="3" style="v" sid="EZK 22:3" />ओर तेस शईरो खे बोल, परमेशर यहोवा ईंयाँ बोलोआ, “शईर अत्यारे लोका ते परेया रा ए। जेते कि तुसा रा नाश ऊणे रा बखत चट आओ ओर तुसे आपणा ई नुकशाण करने खे ओर अशुद्ध ऊणे खे मूर्तिया बणाओए।” <verse eid="EZK 22:3" /><verse number="4" style="v" sid="EZK 22:4" />यरूशलेमो रे लोको, तुसे जो अत्या करी राखिया, तुसे तेते कि दोषी ठईरी रे ओर जो मूर्तिया तुसे बणाईया, तिना रिया बजा ते तुसे अशुद्ध ऊईगे रे, तुसे आपणे नाशो रा दिन नेड़े करिता दा ए, ओर आपणे पिछले सालो तक पऊँची गा रा। इजी बजा ते मैं तुसे जातिया-जातिया रे लोका बीचे बेज्जती ओर मजाको री बजा बणाईते रे। <verse eid="EZK 22:4" /><verse number="5" style="v" sid="EZK 22:5" />ओ बदनाम शईर, ओ उपद्रवो साथे परे रे शईरो रे लोको, जो नेड़े ओर दूर ए, तिना सबी तुसा रा मजाक ड्वाणा। <verse eid="EZK 22:5" /><verse number="6" style="v" sid="EZK 22:6" />देख, इस्राएलो रे सारे परदान आपणी-आपणी तागती रे मुताबिक शईरो दे अत्या करने वाल़े ऊईगे रे। <verse eid="EZK 22:6" /><verse number="7" style="v" sid="EZK 22:7" />एते बीचे यरूशलेमो दे तुसे लोक आपणे माये-बाओ री गल्ल नि मानी; तां बीचे परदेशिया पाँदे अन्देर कित्तेया; सेयो अनाथ ओर बिदुआ खे तुच्छ जाणोए। <verse eid="EZK 22:7" /><verse number="8" style="v" sid="EZK 22:8" />तुसे मेरी पवित्र चीजा जो मेरिया सेवा खे थिया तुच्छ जाणिया ओर मेरे रामो रे दिन अपवित्र करी राखे। <verse eid="EZK 22:8" /><verse number="9" style="v" sid="EZK 22:9" />यरूशलेमो रे लोक ओरी लोका रे बारे दे चूठ बोलोए। लोक अत्या करने खे आगे रओए, ओर तेरे लोके पाह्ड़ो पाँदे मूर्तिया खे चढ़ाईया दिया बलिया रिया रोटिया खाईया; तुसा बीचे बऊत बड़ा पाप ऊई रा। <verse eid="EZK 22:9" /><verse number="10" style="v" sid="EZK 22:10" />यरूशलेमो बीचे एड़े लोक ए जो आपणियां सोतेलिया माया साथे गन्दा काम करोए ओर महावारी आई री जवाणसा साथे सम्बन्द बणाई की अशुद्ध ऊए। <verse eid="EZK 22:10" /><verse number="11" style="v" sid="EZK 22:11" />एस शईरो दे कोई आपणे पड़ोसिये री लाड़िया साथे सया ओर किने आपणी बऊआ साथे सयी की महापाप कित्तेया, ओर किने आपणी बईण ओर आपणियां सोतेलिया बईणी साथे बुरा काम कित्तेया। <verse eid="EZK 22:11" /><verse number="12" style="v" sid="EZK 22:12" />यरूशलेमो बीचे लोके अत्या करने खे रिश्वत लई राखी, तुसे ब्याज ओर मूल़ लया ओर आपणे पड़ोसिया पाँदे अत्याचार करी की फायदा उठाया; ओर तुसे आऊँ पुलाई ता रा, प्रभु यहोवे री येई बाणी ए। <verse eid="EZK 22:12" /><verse number="13" style="v" sid="EZK 22:13" />इजी री खातर देख, जो फायदा तुसे अन्याय साथे उठाया ओर आपू बीचे अत्या करी की खून बाह्या ए, तेते पाँदे गुस्से दे मैं चाड़िया बजाई राखिया। <verse eid="EZK 22:13" /><verse number="14" style="v" sid="EZK 22:14" />तो जेबे मां तुसा रा न्याय करना, तेस दिने तुसा रा मन मजबूत ओर आथ खड़े नि रणे। मैं यहोवे ये बोली राखेया ओर एड़ा ई करना। <verse eid="EZK 22:14" /><verse number="15" style="v" sid="EZK 22:15" />मां तुसा रे लोक जातिया-जातिया बीचे तित्तर-बित्तर करी देणे ओर तुसा री अशुद्धता तुसा बीचा ते खत्म करी देणी। <verse eid="EZK 22:15" /><verse number="16" style="v" sid="EZK 22:16" />इजी री खातर दूजे देशा रे लोका तुसा री बेज्जती करनी, ओ यरूशलेम, तेबे तुसा खे पता लगी जाणा कि आऊँ ई यहोवा ए।<verse eid="EZK 22:16" /></para>
  <para style="s">परमेशरो रे गुस्से री आग</para>
  <para style="p">
    <verse number="17" style="v" sid="EZK 22:17" />तेबे यहोवे रा ये सन्देश मांगे मिलेया, <verse eid="EZK 22:17" /><verse number="18" style="v" sid="EZK 22:18" />“ओ नाश ऊणे वाल़े माणूंआ, इस्राएलो रा कराना मां सामणे बेकार ऊईगा रा; सेयो सारे के सारे भट्टिया बीचे पीतल़, राँगे ओर लोए ओर शीशे जेड़े बणी गे रे; सेयो चाँदिए रे मैलो जेड़े ऊईगे रे। <verse eid="EZK 22:18" /><verse number="19" style="v" sid="EZK 22:19" />इजी बजा ते परमेशर यहोवा इस्राएली लोका खे बोलोआ: कऊँकि तुसे सब के सब धातुआ रे मैलो जेड़े बणी गे रे, तो देखो, आऊँ तुसा खे यरूशलेमो रे कट्ठा करने वाल़ा ए। <verse eid="EZK 22:19" /><verse number="20" style="v" sid="EZK 22:20" />जिंयाँ कारीगर चाँदी, पीतल़, लोआ, शीशा ओर टीन इजी री खातर भट्टिया रे पीतरे कट्ठा करी की राखोए कि तिना खे आगी रे गल़ाओ, तिंयाँ ई मां तुसे आपणे रोषो रे आई की तुसे कट्ठे करी की तेथी ई राखी की गल़ाई देणे। <verse eid="EZK 22:20" /><verse number="21" style="v" sid="EZK 22:21" />मां तुसे तेती कट्ठे करी की आपणे रोषो री आगी रे फूकी देणे ओर तुसे तेती तेसा आगी बीचे गल़ी जाणे। <verse eid="EZK 22:21" /><verse number="22" style="v" sid="EZK 22:22" />सेयो यरूशलेमो दे तेड़े ई पिगल़ी जाणे जिंयाँ चाँदी आगी बीचे गल़ाया जाओआ, तेबे तुसा खे पता लगी जाणा कि जिने आसा पाँदे आपणा रोष पड़काई राखेया, से यहोवा ए।”<verse eid="EZK 22:22" /></para>
  <para style="s">इस्राएलो रे अगुओ रा पाप</para>
  <para style="p">
    <verse number="23" style="v" sid="EZK 22:23" />तेबे यहोवे रा ये सन्देश माखे मिलेया, <verse eid="EZK 22:23" /><verse number="24" style="v" sid="EZK 22:24" />“ओ नाश ऊणे वाल़े माणूंआ, यरूशलेमो रे लोका खे बोल, तू एड़ा देश ए जो कदी शुद्ध नि ऊआ ओर जेबे यहोवा तुसा ते रोषे ऊआ, तेबे तिने तुसा रे देशो दे कोई बर्खा नि कित्ती। <verse eid="EZK 22:24" /><verse number="25" style="v" sid="EZK 22:25" />देशो रे शासक<note caller="+" style="f"><char style="fr" closed="false">22:25 </char><char style="fq" closed="false">शासक </char><char style="ft" closed="false">हिब्रु पाषा दे भविष्यबक्ता लिखेया जाओआ </char></note> लोका खे दु:ख देओए, जेड़े तागतबर शेर जानवरा रे टुकड़े-टुकड़े करी देओआ। सेयो आपणी शक्तिया रा इस्तेमाल लोका खे नाश करने रिया तँईं करोए। सेयो ओरी रिया तन दौलत ओर किमती चीजा आपू खे लई लो ए। ओर तिना बऊत मर्द काई देणे ओर तिना रिया लाड़िया बिदुआ बणाई देणियां। <verse eid="EZK 22:25" /><verse number="26" style="v" sid="EZK 22:26" />तेथो रे पुरोईते मेरा बिधान नि मानेया ओर मेरी पवित्र चीजा जो मेरी सेवा खे थिया अपवित्र करी तिया; तिने पवित्र ओर अपवित्रो बीचे कोई फर्क नि समजेया ओर ना ई ओरी खे शुद्ध ओर अशुद्धो रा फर्क सिखाया ओर सेयो मेरे रामो रे दिनो रे कोई फिकर नि करदे, जेते कि इस्राएलो रे लोक मेरी इज्जत नि करदे। <verse eid="EZK 22:26" /><verse number="27" style="v" sid="EZK 22:27" />तिना रे अधिकारी भेड़िये जेड़ा शिकार पकड़ोए ओर अन्याय साथे फायदा चकणे रिया तँईं अत्या करोए ओर बईमानी करने रिया तँईं माणूं अत्या करने खे आगे रओए।<note caller="+" style="f"><char style="fr" closed="false">22:27 </char><char style="ft" closed="false">सप. 3:3 </char></note> <verse eid="EZK 22:27" /><verse number="28" style="v" sid="EZK 22:28" />तिना रे भविष्यबक्ता तिना रिया तँईं कच्ची लिपाई मतलब चूठे दर्शण बताई की यहोवे रे बिना बोले सेओ चूठी भविष्यबाणी करोए कि प्रभु यहोवा ईंयाँ बोलोआ। <verse eid="EZK 22:28" /><verse number="29" style="v" sid="EZK 22:29" />देशो रे आम माणूं बी अन्देर करोए ओर पराया पैसा छुड़ाओए, सेयो गरीबा पाँदे अत्याचार करोए ओर न्याय री फिकर छाडी की परदेसिये पाँदे अन्देर करोए। <verse eid="EZK 22:29" /><verse number="30" style="v" sid="EZK 22:30" />मैं तिना बीचे एड़ा माणूं टोल़ना चाएया जो इना लोका खे सुदरने रिया तँईं मांते प्रार्थना करो, ताकि माखे सेयो नाश नि करने पड़ो, पर एड़ा कोई नि मिलेया। <verse eid="EZK 22:30" /><verse number="31" style="v" sid="EZK 22:31" />इजी बजा ते आऊँ इस्राएली लोका ते बऊत रोषे ऊआ ओर मैं सेयो आपणी जल़ना री आगी रे फूकी ते, एबे मां तिना खे तिना रे पापा रे मुताबिक सजा देणी। परमेशर यहोवे री येई बाणी ए।”<note caller="+" style="f"><char style="fr" closed="false">22:31 </char><char style="ft" closed="false">यहे. 11:21, यहे. 9:10 </char></note><verse eid="EZK 22:31" /></para>
  <chapter eid="EZK 22" />
  <chapter number="23" style="c" sid="EZK 23" />
  <para style="s">दो व्याभिचारणिया बईणा</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 23:1" />यहोवे रा ये सन्देश फेर माखे मिलेया, <verse eid="EZK 23:1" /><verse number="2" style="v" sid="EZK 23:2" />“ओ नाश ऊणे वाल़े माणूंआ, दो बईणी थिया, जो एक ई माया रिया बेटिया थिया। <verse eid="EZK 23:2" /><verse number="3" style="v" sid="EZK 23:3" />सेयो आपणे बचपनो तेई वेश्या रा काम मिस्रो दे करने लगिया; तिना री छातिया कुआँरिया रेई मर्द छूँओ थे ओर तिना रा कुआँरापन बी खोईता ओर सेयो वेश्या बणीगिया। <verse eid="EZK 23:3" /><verse number="4" style="v" sid="EZK 23:4" />बड़िया बईणी रा नाओं ओहोला<note caller="+" style="f"><char style="fr" closed="false">23:4 </char><char style="fq" closed="false">ओहोला </char><char style="ft" closed="false">तेसरी पवित्र जगा </char></note> था ओर छोटिया रा नाओं ओहोलीबा<note caller="+" style="f"><char style="fr" closed="false">23:4 </char><char style="fq" closed="false">ओहोलीबा </char><char style="ft" closed="false">मेरी पवित्र जगा </char></note> था। ओहोला रा मतलब सामरिया था, ओर ओहोलीबा रा मतलब यरूशलेम था। सेयो मेरिया लाड़िया बणीगिया ओर बादो ते तिने मेरिया तँईं माठे ओर बेटिया पैदा कित्ते।”<verse eid="EZK 23:4" /></para>
  <para style="s">बड़ी बईण सामरी</para>
  <para style="p">
    <verse number="5" style="v" sid="EZK 23:5" />ओहोला जेबे मेरी थी, तेबेई व्याभिचारिणी ऊई की आपणे दोस्ता पाँदे मोहित ऊणे लगी जो तेसा रे पड़ोसी अश्शूरी थे। <verse eid="EZK 23:5" /><verse number="6" style="v" sid="EZK 23:6" />सेयो सारे के सारे तो नीले टाल्ले पईनणे वाल़े सुन्दर सिपाई, परदान ओर सरदार थे ओर तिना बीचा ते कुछ लोक कोड़ेया पाँदे सवार थे। <verse eid="EZK 23:6" /><verse number="7" style="v" sid="EZK 23:7" />इजी री खातर तेसे तिना ई साथे व्याभिचार कित्तेया जो सारे के सारे परदान अश्शूरी थे। से जेस साथे चाओ थी तेस साथे बुरा काम करो थी। से तिना री मूर्तिया री पूजा करो थी ओर आपू खे अशुद्ध बणाओ थी। <verse eid="EZK 23:7" /><verse number="8" style="v" sid="EZK 23:8" />जो व्याभिचार तेसे मिस्रो रे सिखेया था, से तेसे नि छाडेया, कऊँकि बचपनो दे मिस्रो रे माणूंए तेसा साथे कुकर्म कित्तेया ओर तेसा रिया छातिया छूँईंया ओर तन-मनो साथे तेसा साथे व्याभिचार कित्तेया। <verse eid="EZK 23:8" /><verse number="9" style="v" sid="EZK 23:9" />इजी बजा ते मैं से तिना अश्शूरी दोस्ता रे आथो रेई करी ती जिना पाँदे से मोहित ऊई थी। <verse eid="EZK 23:9" /><verse number="10" style="v" sid="EZK 23:10" />तिने तेसा खे बदनाम करने खे तेसा रे टाल्ले खुलाईते। तिने तेसा रे माठे बेटिया छुड़ाईते। तिने तेसा पाँदे अमला कित्तेया ओर से काईती। तेसारी सजा री बजा ते हर जगा जवाणसा तेसा रिया किस्मता रे बारे दे गल्ला करो थिया।<verse eid="EZK 23:10" /></para>
  <para style="s">छोटी बईण, यरूशलेम</para>
  <para style="p">
    <verse number="11" style="v" sid="EZK 23:11" />यहोवे माखे बोलेया, “तेसा री छोटी बईण ओहोलीबे ये देखेया, तेबे बी से मोहित ऊई की व्याभिचार करने रे आपणी बईणी ते बी जादा बढ़ी गी। <verse eid="EZK 23:11" /><verse number="12" style="v" sid="EZK 23:12" />ओहोलीबा बी आपणे अश्शूरी पड़ोसिया पाँदे मोहित ओ थी, जो सारे के सारे बऊत सुन्दर टाल्ले पईनणे वाल़े ओर तिना बीचा ते कुछ लोक कोड़ेया पाँदे सवार थे, सिपाई, सरदार ओर सबी प्रकारा रे परदान थे। <verse eid="EZK 23:12" /><verse number="13" style="v" sid="EZK 23:13" />तेबे मैं देखेया कि से बी अशुद्ध ऊई गी; तिना दुँईं बईणी री एक जेड़ी चाल थी।” <verse eid="EZK 23:13" /><verse number="14" style="v" sid="EZK 23:14" />पर छोटी बईण ओहोलीबा जादा व्याभिचार करदी गई; तेसे कांदा दे मर्दा रे चित्र देखे। सेयो चमकणे वाल़े लाल रंगो रे चित्र थे जो लोके बेबीलोनो रे मर्दा रे बणाई राखे थे। <verse eid="EZK 23:14" /><verse number="15" style="v" sid="EZK 23:15" />तिने बेबीलोनो रे माणूंए लको दे चादर बानी राखी थी ओर तिना रे सिरो पाँदे लाम्बी पगड़िया थिया। ओर तिना रे सिरो पाँदे रंग-बरंगी पगड़िया थिया। सेयो सब मर्द बड़े अधिकारी दिशणे लगी रे थे। ये सारे बेबीलोनो दे रणे वाल़े थे जिना री जन्म-भूमि कसदिया रा देश था। <verse eid="EZK 23:15" /><verse number="16" style="v" sid="EZK 23:16" />तेबे बेबीलोनो रिया तिना छावणिया खे देखदे ई ओहोलीबा तिना पाँदे मोहित ऊई गी ओर तिना गे कसदिया रे देशो रे दूत पेजे। <verse eid="EZK 23:16" /><verse number="17" style="v" sid="EZK 23:17" />तेबे बाबेली तेसा गे माँजे पाँदे आए ओर तेसा साथे व्याभिचार करी की से अशुद्ध करी ती ओर जेबे से तिना ते अशुद्ध ऊई गी, तेबे तेसा रा मन तिना ते फिरी गा। <verse eid="EZK 23:17" /><verse number="18" style="v" sid="EZK 23:18" />तेसे आपणे आपू खे सबी रे सामणे ल्याया ओर सबी खे दशी ता कि से एक वेश्या ए। माखे तेसा ते तितणी ई नफरत ऊणे लगी री थी जितणी माखे तेसा री बड़ी बईणी ते ओ थी। <verse eid="EZK 23:18" /><verse number="19" style="v" sid="EZK 23:19" />तेबे बी ओहोलीबा मिस्र देशो रे आपणे बचपनो रे दिन याद करी की जेबे से वेश्या रा काम करो थी, ओर जादा व्याभिचार करदी गई; <verse eid="EZK 23:19" /><verse number="20" style="v" sid="EZK 23:20" />तेती से एड़े मिस्रो रे मर्दा पाँदे मोहित ऊई थी, जिना रे गुप्त अंग गह्देया जेड़े ओर वीर्य कोड़ेया जेड़ा था। <verse eid="EZK 23:20" /><verse number="21" style="v" sid="EZK 23:21" />तैं सोचेया ऊणा कि जेबे तूँ जवान थी तो आपू किंयाँ गन्दे तरीके ते व्याभिचार करो थी। तूँ चाए थी कि मर्द तेरे दुदु पकड़ो ओर तांते प्यार करो जेड़ा कि मिस्रो रे मर्दे कित्तेया था।<verse eid="EZK 23:21" /></para>
  <para style="s">यरूशलेमो पाँदे न्याय</para>
  <para style="p">
    <verse number="22" style="v" sid="EZK 23:22" />इजी बजा ते ओ ओहोलीबा, परमेशर यहोवा ताखे ईंयाँ बोलोआ, “देख, मां तेरे दोस्त, जिना ते तेरा मन फिरी गा चऊँ कनारे ते तेरे खलाफ ली आऊणे। <verse eid="EZK 23:22" /><verse number="23" style="v" sid="EZK 23:23" />मतलब बाबेली ओर सारे कसदी ओर पकोदो रे लोक, शोया ओर कोआ जातिया रे लोका खे; ओर तिना साथे सारे अश्शूरी ल्याऊणे, जो सारे के सारे कोड़ेया रे सवार सुन्दर सिपाई, परदान ओर कई प्रकारा रे सरदार, परदान ओर नामी मर्द थे। <verse eid="EZK 23:23" /><verse number="24" style="v" sid="EZK 23:24" />ओबालिया रे सब प्यार करने वाल़े लोका री पीड़ तुसा गे आऊणी। सेयो आपणे कोड़ेया पाँदे सवार ओर आपणे रथो पाँदे आऊणे। लोक गिणतिया दे बऊत ऊणे। तिना गे तिना रे भाल़े तिना रिया ढाला ओर तिना रे सिरो रे सुरक्षा कवच ऊणे। सेओ तुसा रे चऊँ कनारे कट्ठे ऊणे। मां तिना खे बताणा कि तुसे मां साथे क्या करी राखेया ओर तिना आपणी तरफा ते तुसा खे दण्डो री सजा देणी।” <verse eid="EZK 23:24" /><verse number="25" style="v" sid="EZK 23:25" />मां तां पाँदे जल़ना, जेतेते तिना बी तुसा साथे रोषो रे आई की बर्ताव करना। तिना तेसरा नाक ओर कान बाडी देणे ओर तेरा जो बी बचेया रा रणा से तलवारी साथे काई देणा। तिना तेसरे बच्चे छुड़ाई की लई जाणे ओर तेरे कअरो दे जो बी जिऊँदे बची जाणे, सेयो आगी रे फूखी जाणे। <verse eid="EZK 23:25" /><verse number="26" style="v" sid="EZK 23:26" />तेरे पईलके प्रेमिया तेरे टाल्ले खोली की तेरे सुन्दर-सुन्दर गईणे लई जाणे। <verse eid="EZK 23:26" /><verse number="27" style="v" sid="EZK 23:27" />ईंयाँ मां तेरा माहापाप ओर जो वेश्या रा काम तैं मिस्र देशो रे सिखेया था, से बी तांते छुड़ाणा, एथो तक कि तां फेर आपणी आख तिना रिया तरफा खे नि लगाणी ओर ना मिस्र देश फेर याद करना। <verse eid="EZK 23:27" /><verse number="28" style="v" sid="EZK 23:28" />प्रभु यहोवे माखे यरूशलेमो रे लोका खे बोलणे खे बोलेया: मां तूँ तिना लोका रे आथो दे करी देणी जिना ते तूँ नफरत करेई। यो से लोक ए जिना तैं इजी बजा ते मूँ मोड़ी ला कऊँकि तूँ परेशान थी। <verse eid="EZK 23:28" /><verse number="29" style="v" sid="EZK 23:29" />ओर तिना तां साथे दुश्मणिया साथे बर्ताव करना ओर तेरी सारी कमाई लई लणी ओर तूँ नांगी करी की छाडी देणी ओर जेबे तूँ क्वाड़नी, तेबे तेरे सारे पाप ओर व्याभिचार सामणे आई जाणे। <verse eid="EZK 23:29" /><verse number="30" style="v" sid="EZK 23:30" />यो काम तां साथे इजी खे करे जाणे कऊँकि तूँ दूजी जातिया पीछे व्याभिचारणिया जेड़ी ऊई गी ओर तिना रिया मूर्तिया खे पूजी की अशुद्ध ऊई गी। <verse eid="EZK 23:30" /><verse number="31" style="v" sid="EZK 23:31" />तूँ आपणी बड़ी बईणी री चाला पाँदे चली री, इजी बजा ते मां तेरे आथो दे तेसा जेड़ा सजा रा कटोरा देणा।<verse eid="EZK 23:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="EZK 23:32" />प्रभु यहोवा ईंयाँ बोलोआ, “ताखे आपणी बड़ी बईणी रे सजा वाल़े कटोरे ते पीणा जो मैं तेरिया बईणी खे देई राखेया। ये एक एड़ा कटोरा ए जिदे बऊत सजा ए। लोक तुसा पाँदे आसणे ओर तुसा री बेजती करनी। <verse eid="EZK 23:32" /><verse number="33" style="v" sid="EZK 23:33" />तूँ नशे दे ओर दु:खो साथे रज्जी जाणी। तूँ आपणी बड़ी बईणी ओहोले सामरिया रा नाओं राखेया, मतलब नाश ओर उजाड़ पी की रज्जी जाणी। <verse eid="EZK 23:33" /><verse number="34" style="v" sid="EZK 23:34" />तेते बीचा ते तां चाटी-चाटी की पीणा ओर तेतेरे ठीकरे बी चबाणे ओर दु:खो दे आपणी छातिया काईल करी देणियां; कऊँकि मैं ई एड़ा बोली राखेया, प्रभु यहोवे री येई बाणी ए।” <verse eid="EZK 23:34" /><verse number="35" style="v" sid="EZK 23:35" />तैं जो आऊँ पुलाई ता रा ओर आपणा मूँ मांते फेरी ता रा, इजी री खातर तूँ आपू ई आपणे पापा ओर व्याभिचारो री सजा रा बोज चक, परमेशर यहोवे रा येई वचन ए।<verse eid="EZK 23:35" /></para>
  <para style="s">दूई बईणा खे परमेशरो री सजा</para>
  <para style="p">
    <verse number="36" style="v" sid="EZK 23:36" />यहोवे माखे बोलेया, “ओ नाश ऊणे वाल़े माणूंआ, तूँ ओहोला ओर ओहोलीबा रा न्याय कर। तिना पाँदे तिना रे कित्ते रे घिनौने कामा रा दोष लगा। <verse eid="EZK 23:36" /><verse number="37" style="v" sid="EZK 23:37" />कऊँकि तिने सबी व्याभिचार करी राखेया ओर तिना रे आथो रे खून लगी रा; तिने आपणी मूर्तिया साथे व्याभिचार कित्तेया ओर आपणे बच्चे जो मांते पैदा ऊए थे, तिना मूर्तिया सामणे बलि करने खे चढ़ाए। <verse eid="EZK 23:37" /><verse number="38" style="v" sid="EZK 23:38" />तेबे तिने मां साथे एड़ा बर्ताव कित्तेया कि तेते साथे ई मेरी पवित्र जगा बी अशुद्ध कित्ती ओर मेरा रामो रा दिन बी अपवित्र करिता। <verse eid="EZK 23:38" /><verse number="39" style="v" sid="EZK 23:39" />सेयो आपणे बच्चे मूर्तिया सामणे बलि करी की तेस दिने ई मेरे पवित्र मन्दरो दे कूसी गे। सेयो मेरे आराधना रे मन्दरो दे आए ओर से अपवित्र करिता। <verse eid="EZK 23:39" /><verse number="40" style="v" sid="EZK 23:40" />ओहोले ओर ओहोलीबे दूनी बऊत दूरा ते माणूं बुलाए ओर सेयो आए बी। तिना रिया तँईं तूँ नाह्यी तोई की, आखी दे काजल़ लगाई की, गईणे पईनी की; <verse eid="EZK 23:40" /><verse number="41" style="v" sid="EZK 23:41" />तू सुन्दर माँजे पाँदे बैठी दी रयी ओर तां सामणे एक मेज राखेया दा था, जेते पाँदे तैं मेरा तूप ओर मेरा जैतूनो रा तेल जो मेरिया पूजा खे थे राखेया। <verse eid="EZK 23:41" /><verse number="42" style="v" sid="EZK 23:42" />उजाड़ जगा दे यरूशलेमो रे निश्चिंत लोका री पीड़ा रा आल्ला सुणेया ओर तिना आम लोका गे जंगल़ो ते बुलाए रे नशेड़ी लोक बी थे, तिने तिना दुँईं बईणी रे आथो रे बांगा पन्याईया ओर तिना रे सिरो पाँदे सुन्दर मुकुट राखेया। <verse eid="EZK 23:42" /><verse number="43" style="v" sid="EZK 23:43" />तेबे जो व्याभिचार करदे-करदे सयाणियां ऊई चुकिया थिया, तिना रे बारे दे मैं आपणे आपू ते बोलेया, एबे तो तिना तेसा साथे ई व्याभिचार करना। <verse eid="EZK 23:43" /><verse number="44" style="v" sid="EZK 23:44" />कऊँकि सेयो लोक तेसा गे एड़े गये जेड़े लोक वेश्या गे जाओए। तेड़े ई सेयो ओहोला ओर ओहोलीबा नाओं री माहापापणी जवाणसा गे गये। <verse eid="EZK 23:44" /><verse number="45" style="v" sid="EZK 23:45" />इजी री खातर तर्मी लोक व्याभिचारणिया ओर अत्यारे जोगा ओहोला ओर ओहोलीबा रा न्याय करो, कऊँकि सेयो व्याभिचारणिया ए ओर तिना रे आथो दे अत्या रा खून लगी रा।” <verse eid="EZK 23:45" /><verse number="46" style="v" sid="EZK 23:46" />इजी बजा ते मैं परमेशर यहोवा ये बोलेया, “मां एक पीड़ा ते ओहोला रे खलाफ जेसा रा नाओं सामरिया ओर ओहोलीबा रा नाओं यरूशलेम राखेया ए तिना पाँदे अमला कराई की सेयो एड़िया करनिया कि सेयो मारिया-मारिया फिरनियां ओर लूटी जाणिया। <verse eid="EZK 23:46" /><verse number="47" style="v" sid="EZK 23:47" />सेना रे तिना दुश्मणा ओहोला ओहोलीबा पाँदे पत्थराव करी की सेयो कायी देणियां ओर आपणी तलवारी साथे बाडी देणियां, तेबे तिना, तिना रे बच्चे काई की तिना रे कअर फूकी देणे।” <verse eid="EZK 23:47" /><verse number="48" style="v" sid="EZK 23:48" />परमेशर बोलोआ, “ईंयाँ मां पाप देशो ते दूर करी देणा ओर तेबे सबी जवाणसा खे शिक्षा मिलणी ओर सेयो तुसा जेड़ा पाप करने ते बची जाणिया। <verse eid="EZK 23:48" /><verse number="49" style="v" sid="EZK 23:49" />तुसा दूनी बईणा रा महापाप तुसा रे सिरो पाँदे ई पड़ना ओर तुसा जरूर आपणी मूर्तिया री आराधना करी की आपणे ई पापा रा बोज चकणा ओर तेबे तुसा खे पता लगी जाणा कि आऊँ परमेशर यहोवा ए।”<verse eid="EZK 23:49" /></para>
  <chapter eid="EZK 23" />
  <chapter number="24" style="c" sid="EZK 24" />
  <para style="s">उबल़दी टोकणी</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 24:1" />म्हारे गुलामिया रे नऊए सालो रे दसुए मीन्ने रे दसुए दिने, यहोवे रा ये सन्देश फेर माखे मिलेया, <verse eid="EZK 24:1" /><verse number="2" style="v" sid="EZK 24:2" />“ओ नाश ऊणे वाल़े माणूंआ, आजका दिन लिखी लो, कऊँकि आजके दिने ई बेबीलोनो रे राजे आई की यरूशलेमो पाँदे अमला करना शुरू करने लगी रा।” <verse eid="EZK 24:2" /><verse number="3" style="v" sid="EZK 24:3" />इना इस्राएलिया खे बोल, कऊँकि सेयो मेरी आज्ञा खे मानणे खे ना करोए। प्रभु यहोवा ईंयाँ बोलोआ, “टोकणियां खे आगी पाँदे राखी दे; तीजी खे राखी की तिदे पाणी पाई दो; <verse eid="EZK 24:3" /><verse number="4" style="v" sid="EZK 24:4" />पांडे दे आपणे सबी ते खरे डांगरो रे मासो रे टुकड़े पाई दे: खुटी, कांद ओर सबी ते खरे टुकड़े तिदे पाई दे। फेर पांडे रे बाकी खाले इस्से खे सबी ते खरे मासो ते परी दे। <verse eid="EZK 24:4" /><verse number="5" style="v" sid="EZK 24:5" />सबी ते खरे डांगरो रा मास लओ, ओर टोकणियां थाले लकड़ू बाल़ी की तेस मासो खे ठीक टंगो दे पकाओ ताकि पीतरे ई आड्डिया पक्की जाओ।” <verse eid="EZK 24:5" /><verse number="6" style="v" sid="EZK 24:6" />प्रभु यहोवा ईंयाँ बोलोआ: अत्या करने वाल़े शईर<note caller="+" style="f"><char style="fr" closed="false">24:6 </char><char style="fq" closed="false">अत्या करने वाल़े शईर </char><char style="ft" closed="false">यरूशलेम </char></note> लाणत ए तां पाँदे! ये एक खई लगे दे पांडे जेड़ा ए, जो कदी साफ नि कित्तेया जांदा। मासो रा एक-एक टुकड़ा निकाल़ी देओए, ओर तिदे एक पनि रंदा। <verse eid="EZK 24:6" /><verse number="7" style="v" sid="EZK 24:7" />कऊँकि यरूशलेमो रे लोका रा बाह्या रा खून तेथी आए; तिने से जमीना दे बाह्यी की माट्टिया साथे नि टकेया, पर जिने लोके सेयो काये थे तिना रा खून तेथी नांगी चट्टानी पाँदे सेटिता था।<note caller="+" style="f"><char style="fr" closed="false">24:7 </char><char style="ft" closed="false">प्रका. 18:24</char></note> <verse eid="EZK 24:7" /><verse number="8" style="v" sid="EZK 24:8" />इजी री खातर मैं तिना रा खून बी नांगी चट्टानी पाँदे राखी राखेया ताकि से टखी नि सको मैं ये कित्तेया, जेतेते लोक गुस्से ओ, ओर तेसखे बेकसूर लोका री अत्या री सजा देओ। <verse eid="EZK 24:8" /><verse number="9" style="v" sid="EZK 24:9" />प्रभु यहोवा ईंयाँ बोलोआ, “हाय, तेस खूनी शईरो पाँदे! मां बी आगी री लकड़िया रा टेर बड़ा करी देणा। <verse eid="EZK 24:9" /><verse number="10" style="v" sid="EZK 24:10" />इजी री खातर बऊत लकड़िया पा, आगी री बऊत चल़ लगा, मास ठीक-टंगो दे पक्का ओर मसाला मला ओर आड्डिया बी राड़ी देयो। <verse eid="EZK 24:10" /><verse number="11" style="v" sid="EZK 24:11" />तेबे टोकणियां खे खाली करी की फेऊआ पाँदे राखी देओ। जेते कि से ताता ऊई जाओ ओर तेतेरा पीतल़ फूखो, ओर तेतेरा मैल गल़ो ओर तेतेरा जंग खत्म ऊई जाओ। <verse eid="EZK 24:11" /><verse number="12" style="v" sid="EZK 24:12" />एड़ा लगोआ जेड़े आऊँ तेतेखे साफ करदा-करदा थकी गा, पर तेतेरा पारी जंग तेते ते नि छूटेया, तेतेरा जंग आगी साथे पनि छूटदा। <verse eid="EZK 24:12" /><verse number="13" style="v" sid="EZK 24:13" />ओ यरूशलेम, तेरे बुरे कामे तूँ अशुद्ध करिता दा ए ओर पापो ते कलंकित ऊई। आऊँ तो ताखे शुद्ध करना चाऊँ था, पर तूँ शुद्ध नि ऊई, इजी बजा ते जदुओ तक आऊँ आपणा रोष तां पाँदे पड़काई की शान्त नि करूँगा, तदुओ तक तूँ फेर शुद्ध नि करी जाणी। <verse eid="EZK 24:13" /><verse number="14" style="v" sid="EZK 24:14" />मैं यहोवे ई ये बोली राखेया ओर से ऊई बी जाणा, मां एड़ा ई करना, मां तूँ नि छाडणी, ना माखे तां पाँदे तरस आऊणा, ना पछताणा; तेरे चाल-चलण ओर कामो रेई मुताबिक तेरा न्याय करेया जाणा, प्रभु यहोवे री येई बाणी ए।”<verse eid="EZK 24:14" /></para>
  <para style="s">यहेजकेलो री लाड़िया री मौत</para>
  <para style="p">
    <verse number="15" style="v" sid="EZK 24:15" />तेबे यहोवे रा ये सन्देश माखे मिलेया, <verse eid="EZK 24:15" /><verse number="16" style="v" sid="EZK 24:16" />“ओ नाश ऊणे वाल़े माणूंआ, आऊँ अचाणक तेरी प्यारी लाड़िया खे तांते दूर करने लगी रा, जेसा ते तूँ बऊत प्यार करेआ। पर जेबे से मरी जाओ, तो ये नि दखाणा कि तूँ दु:खी आ, शोक करने लगी रा या रोणे लगी रा ओ। <verse eid="EZK 24:16" /><verse number="17" style="v" sid="EZK 24:17" />पीतरे ई पीतरे रोंदा रओ, पर तेसारी कब्रा पाँदे रोण पीटण करने नि जाणा। आपणा सिर नांगा नि करना ओर ना आपणे जोड़े खोलणे। शोग करने जो तरीका ये से नि करना, ना ई शान्ति देणे आऊणे वाल़ेया लोका रा खाणा खाणा।” <verse eid="EZK 24:17" /><verse number="18" style="v" sid="EZK 24:18" />तेबे मैं एक दिन प्यागा लोका खे बोलेया ओर तेसा ई साँजा खे मेरी लाड़ी मरी गी। तेबे मैं दूजे दिने प्यागा उठी की तेसा आज्ञा रे मुताबिक ई कित्तेया। <verse eid="EZK 24:18" /><verse number="19" style="v" sid="EZK 24:19" />तेबे लोक माखे बोलणे लगे, “क्या तां आसा गे नि बताणा कि ये जो तूँ करेया, एतेरा आसा लोका खे क्या मतलब ए?” <verse eid="EZK 24:19" /><verse number="20" style="v" sid="EZK 24:20" />मैं तिना खे ज्वाब दित्तेया, यहोवे रा ये सन्देश माखे मिलेया, <verse eid="EZK 24:20" /><verse number="21" style="v" sid="EZK 24:21" />“तूँ इस्राएलो रे लोका खे बोल, प्रभु यहोवा ईंयाँ बोलोआ: देखो, आऊँ आपणे पवित्र मन्दरो खे जेतेरा गढ़ ऊणे ते तुसे कमण्ड करोए ओर जो तुसा री पसन्दा राए, तेतेखे आऊँ अपवित्र करने वाल़ा ए ओर आपणे जिना माठे-बेटिया खे तुसे छाडी की आई रे, सेयो तलवारी साथे मारे जाणे।” <verse eid="EZK 24:21" /><verse number="22" style="v" sid="EZK 24:22" />जेड़ा मैं करी राखेया, तेड़ा ई तुसा लोका करना, तुसा बी आपणे ओठ नि टखणे, ना शोगो री रोटी खाणी। <verse eid="EZK 24:22" /><verse number="23" style="v" sid="EZK 24:23" />तुसा सिरो रे पगड़ी ओर पैरा रे जोड़े पैनी की राखणे, ना तुसे रोणे, ना छाती पीटणी, बल्कि आपणे बुरे कामो रे फसी की गल़दे जाणे ओर एकी-दूजे रिया तरफा खे कणदे रणे। <verse eid="EZK 24:23" /><verse number="24" style="v" sid="EZK 24:24" />यहोवा लगातार आगे बोलोआ, “ईंयाँ यहेजकेल तुसा रिया तँईं एक नशाणी ठईरना; जेड़ा तिने कित्तेया, ठीक तेड़ा ई तुसा बी करना ओर जेबे ये ऊई जाणा, तेबे तुसा जाणी लणा कि आऊँ ई यहोवा परमेशर ए।” <verse eid="EZK 24:24" /><verse number="25" style="v" sid="EZK 24:25" />तेबे यहोवे माखे बोलेया, ओ नाश ऊणे वाल़े माणूंआ, क्या ये सच्च नि ए कि जेस दिने मां तिना रा मन्दर, तिना री शोभा ओर खुशिया री बजा ओर तिना रे माठे-बेटिया जो तिना री आखी री खुशी ओर मनो खे चाणे वाल़े ए, तिना ते मां सेयो लई लणे, <verse eid="EZK 24:25" /><verse number="26" style="v" sid="EZK 24:26" />जेस दिने मां एड़ा करना, तेस दिने कुछ लोक जो नाश ऊणे ते बची जाणे, तिना तांगे आई की ताखे बताणा। <verse eid="EZK 24:26" /><verse number="27" style="v" sid="EZK 24:27" />तेस दिने ई तेरा मूँ खुलणा ओर तूँ फेर चुप नि रणा, पर जो लोक बची गे रे तिना खे चतौणी देणी। ईंयाँ तूँ इना लोका खे एक नशाणी ठईरना ओर इना खे पता लगी जाणा कि आऊँ यहोवा ए।<verse eid="EZK 24:27" /></para>
  <chapter eid="EZK 24" />
  <chapter number="25" style="c" sid="EZK 25" />
  <para style="s">अम्मोनी लोका रे खलाफ न्याय</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 25:1" />यहोवे रा ये सन्देश माखे फेर मिलेया, <verse eid="EZK 25:1" /><verse number="2" style="v" sid="EZK 25:2" />“ओ नाश ऊणे वाल़े माणूंआ, अम्मोनिया रिया तरफा खे मूँ करी की तिना रे बारे दे भविष्यबाणी कर। <verse eid="EZK 25:2" /><verse number="3" style="v" sid="EZK 25:3" />अम्मोनिया खे बोल, परमेशर यहोवे रा वचन सुणो, परमेशर यहोवा ईंयाँ बोलोआ, तुसे जो मेरे पवित्र मन्दरो रे बारे दे, जेबे से अपवित्र कित्तेया ओर इस्राएल देशो रे बारे दे जेबे से ऊजड़ी गा ओर यहूदा रे कराने रे बारे दे जेबे सेयो तिना रे दुश्मणे गुलामिया दे निए, वा! वा! बोलेया! <verse eid="EZK 25:3" /><verse number="4" style="v" sid="EZK 25:4" />इजी बजा ते देखो, आऊँ तुसा खे पूर्बो रे रेगिस्तानो रिया जनजातिया रे कब्जे दे करने वाल़ा ए ओर तिना तुसा बीचे आपणे डेरे लगाणे ओर आपणे कअर बनवाणे; तिना फल खाणे ओर आपणे डांगरा रा दूद पीणा जो तुसा रा ऊणा चाईयो था। <verse eid="EZK 25:4" /><verse number="5" style="v" sid="EZK 25:5" />ओर मां तुसा री राजधानी रब्बा शईर ऊँटा खे रणे खे ओर अम्मोनिया रे देश पेडा-बाकरिया रे बैठणे री जगा करी देणियां; तेबे तुसा जाणी लणा कि आऊँ यहोवा ए।” <verse eid="EZK 25:5" /><verse number="6" style="v" sid="EZK 25:6" />कऊँकि परमेशर यहोवा ईंयाँ बोलोआ, “तुसे जो इस्राएलो रे कराने रिया बजा ते चाड़िया बजाईया ओर नाचे ओर आपणे सारे कमण्डो रिया बजा ते मनो दे खुशी मनाई, <verse eid="EZK 25:6" /><verse number="7" style="v" sid="EZK 25:7" />तो सुणो, एबे मां तुसा खे सजा देणी। मां दूजे देशा रे लोका खे तुसा रिया सारिया कीमती चीजा लई जाणे देणियां। मां तुसे पूरी तरआ ते रचाई देणे ताकि तुसे एबे एक देश नि रई जाओ। मां तुसे नाश करी देणे। तेबे तुसा जाणी लणा कि आऊँ ई यहोवा ए।”<verse eid="EZK 25:7" /></para>
  <para style="s">मोआबी लोका रे खलाफ न्याय</para>
  <para style="p">
    <verse number="8" style="v" sid="EZK 25:8" />परमेशर यहोवा एड़ा बोलोआ, “मोआब ओर सेईर शईरो रे लोक जो बोलोए, देखो, यहूदा रा कराना ओरी सबी जातिया जेड़े ऊईगे रे। <verse eid="EZK 25:8" /><verse number="9" style="v" sid="EZK 25:9" />इजी बजा ते देख, मोआब देशो रे कनारले सबी ते खास शईर बेत्यशीमोत, बाल्मोन ओर किर्यातैम, जो तेस देशो रे सुन्दर ए, मां तिना रिया बाटा खोली की, <verse eid="EZK 25:9" /><verse number="10" style="v" sid="EZK 25:10" />मां पूर्ब देशो रे लोक मोआब ओर अम्मोनो पाँदे जीत दलाणे जोगे बनाणे। मतलब मां एड़ा करना कि अम्मोन एबे ओरी देशा याद तक नि करना। <verse eid="EZK 25:10" /><verse number="11" style="v" sid="EZK 25:11" />ईंयाँ मां मोआबो खे बी सजा देणी ओर तिना जाणी लणा कि आऊँ ई यहोवा ए।”<verse eid="EZK 25:11" /></para>
  <para style="s">एदोमो रे लोका रे खलाफ न्याय</para>
  <para style="p">
    <verse number="12" style="v" sid="EZK 25:12" />परमेशर यहोवा ईंयाँ बी बोलोआ, “एदोमे जो यहूदा रे लोका ते बदला लया ओर तिना ते बदला लई की बड़ा दोषी ऊईगा रा, <verse eid="EZK 25:12" /><verse number="13" style="v" sid="EZK 25:13" />इजी बजा ते परमेशर यहोवा ईंयाँ बोलोआ, मां एदोम देशो रे लोका खे सजा देणी ओर तेथो रे सब माणूं ओर सब जानवर कायी देणे। मां से तेमान शईरो ते लई की ददान शईरो तक उजाड़ करी देणा ओर लोक लड़ाईया दे काये जाणे। <verse eid="EZK 25:13" /><verse number="14" style="v" sid="EZK 25:14" />मां आपणे इस्राएली लोका रे जरीये एदोमो रे लोका ते आपणा बदला लणा ओर तिना तेते देशो दे मेरे रोष ओर कोपो रे मुताबिक काम करना। तेबे तिना खे मेरे बदले रा पता लगी जाणा, परमेशर यहोवे री येई बाणी ए।”<verse eid="EZK 25:14" /></para>
  <para style="s">पलिश्ती जातिया रे खलाफ न्याय</para>
  <para style="p">
    <verse number="15" style="v" sid="EZK 25:15" />परमेशर यहोवा ईंयाँ बोलोआ, “कऊँकि पलिश्ती लोके यहूदा रे लोका ते बदला लया, बल्कि आपणे बऊत बखतो ते पईलकी दुश्मणिया री बजा ते आपणे मनो रे कमण्डो ते बदला लई कि नाश कित्ते, <verse eid="EZK 25:15" /><verse number="16" style="v" sid="EZK 25:16" />ओर इजी री खातर मैं पक्का करी ला दा ए कि मां पलिश्तिया पाँदे अमला करना ओर करेती लोक नाश करी देणे। मां पलिश्ती लोक जो भूमध्य समुद्रो रे कनारे बची रे सब मैदानो दे नाश करी देणे। <verse eid="EZK 25:16" /><verse number="17" style="v" sid="EZK 25:17" />मां रोषो दे आई की मुकद्दमा लड़ी की, पलिश्तिया रे खलाफ कड़क ऊई की बदला लणा ओर जेबे मां तिना ते बदला लई लणा, तेबे पलिश्तिया जाणी लणा कि आऊँ ई यहोवा ए।”<verse eid="EZK 25:17" /></para>
  <chapter eid="EZK 25" />
  <chapter number="26" style="c" sid="EZK 26" />
  <para style="s">सोर शईरो रे खलाफ न्याय</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 26:1" />ग्यारुए सालो रे पईले मीन्ने रे पईले दिने यहोवे रा ये सन्देश माखे मिलेया, <verse eid="EZK 26:1" /><verse number="2" style="v" sid="EZK 26:2" />“ओ नाश ऊणे वाल़े माणूंआ, सोर शईर जो यरूशलेम शईरो रे नाशो पाँदे खुश ऊई की बोलणे लगी रा, वा! वा! से जो पूर्बा रिया तरफा खे समृद्ध बपार करने खे जाणे रा द्वार था, से टुटीगा रा ए, ओर आऊँ तेतेरा वारिस आ। कऊँकि से उजड़ी गा दा ए, इजी री खातर आऊँ तनवान ऊई जाणा।” <verse eid="EZK 26:2" /><verse number="3" style="v" sid="EZK 26:3" />इजी बजा ते परमेशर यहोवा ईंयाँ बोलोआ, “ओ सोर, देख, आऊँ तुसा रे खलाफ ए ओर मां एड़ा करना कि बऊत सारिया जातिया तेरे खलाफ एड़िया उठणियां जेड़िया समुद्रो रिया लईरा उठोईया। <verse eid="EZK 26:3" /><verse number="4" style="v" sid="EZK 26:4" />देशा पाँदे अमला करने वाल़िया सेना सोर शईरो री दवाल रूड़ाई देणी ओर तेथो रे गुम्मट तोड़ी देणे ओर मां तेते पाँदा ते तेतेरी माट्टी खरेची की से नांगी चट्टान बणाई देणी। <verse eid="EZK 26:4" /><verse number="5" style="v" sid="EZK 26:5" />से समुद्रो बीचे जाल़ बछाणे री जगा ई ऊई जाणी; कऊँकि परमेशर यहोवे री येई बाणी ए ओर से दुश्मण देशा ते लूटी जाऊणी; <verse eid="EZK 26:5" /><verse number="6" style="v" sid="EZK 26:6" />ओर तेसरे उपजाऊ जमीना रे गांव तलवारी की नाश ऊई जाणे। तेबे तिना जाणी लणा कि आऊँ ई यहोवा ए।” <verse eid="EZK 26:6" /><verse number="7" style="v" sid="EZK 26:7" />कऊँकि परमेशर यहोवा ईंयाँ बोलोआ, देख, मां सोर शईरो रे खलाफ दुनिया रा सबी ते शक्तिशाली बाबेलो रा राजा नबूकदनेस्सर कोड़ेया, रथ, सवार, बड़ी पीड़ ओर सेना समेत उत्तर दिशा ते ल्याऊणा। <verse eid="EZK 26:7" /><verse number="8" style="v" sid="EZK 26:8" />तेसरी सेने उपजाऊ जमीना दे बसे दे शईरा रे लोक लड़ाईया दे कायी देणे। दुश्मणा तुसा रे खलाफ खड्डे खणने, माट्टिया रे टेर लगाणे ओर ढाला री एक मजबूत दवाल खड़ी करनी। <verse eid="EZK 26:8" /><verse number="9" style="v" sid="EZK 26:9" />तिना शईरो री दवाला टाल़ने खे लकड़ेया रा इस्तेमाल करना। तिना मजबूत गुम्मटा खे टाल़ने रिया तँईं आपणे अथियार रा इस्तेमाल करना। <verse eid="EZK 26:9" /><verse number="10" style="v" sid="EZK 26:10" />तेसरे कोड़े इतणे ऊणे कि तूँ तिना री तूड़ा साथे टखी जाऊणा ओर जेबे से तेरे बड़े द्वारो रे एड़ा कूसणा, जेड़े लोक नाके वाल़े शईरो रे कूसोए, तेबे तेरी शईरो री दवाल सवार, छकड़े ओर रथो री आवाज सुणी की डरी जाणी। <verse eid="EZK 26:10" /><verse number="11" style="v" sid="EZK 26:11" />तेस आपणे कोड़ेया री टापा साथे तेरी सारी सड़का केसी देणियां ओर तेरे रणे वाल़े तलवारी साथे काई देणे ओर तेरे मजबूत खम्बे जमीना दे टाल़ी देणे। <verse eid="EZK 26:11" /><verse number="12" style="v" sid="EZK 26:12" />दुश्मणा रे सिपाईया तेरा तअन लूटी लणा ओर तेरे बपारो रिया चीजा छुड़ाई लणियां; तिना तेरी दवाल टाल़ी देणी ओर तेरे मनो खे सुन्दर लगणे वाल़ा कअर तोड़ी देणा; तेरे पात्थर ओर लक्कड़ ओर माट्टी पाणिए रे सेटी देणी। <verse eid="EZK 26:12" /><verse number="13" style="v" sid="EZK 26:13" />मां तेरे गाणेया रा सूर बन्द करी देणा ओर तेरी बीणा री आवाज फेर नि सुणनी।<note caller="+" style="f"><char style="fr" closed="false">26:13 </char><char style="ft" closed="false">प्रका. 18:22</char></note> <verse eid="EZK 26:13" /><verse number="14" style="v" sid="EZK 26:14" />मां तूँ नांगी चट्टान करी देणी ओर तूँ फेर बसाया नि जाणा, कऊँकि मैं यहोवे ई एड़ा बोली राखेया, परमेशर यहोवे री येई बाणी ए।<verse eid="EZK 26:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="EZK 26:15" />परमेशर यहोवा सोर शईरो खे बोलोआ, “जेबे तुसा पाँदे जीत आसिल कित्ती जाणी, तेबे समुद्रो रे कनारे रणे वाल़े लोक काये दे लोका रा चींगणा सुणी की बऊत ई डरी जाणे। <verse eid="EZK 26:15" /><verse number="16" style="v" sid="EZK 26:16" />जेबे समुद्रो रे कनारे रे शईरा रे राजा लोक बऊत दु:खी ऊई जाणे। सेयो एबे आपणे सिंहासणो पाँदे नि बैठणे। तिना आपणे बांके राजेया वाल़े टाल्ले खोली देणे। तिना डरो रे मारे कांबदे ऊए जमीना पाँदे बैठी जाणे। जेबे तिना सुणना कि तुसा साथे क्या ऊई रा, तो सेयो तुसा रिया आरा री खबर सुणी की रा कांबणे लगी जाणे। <verse eid="EZK 26:16" /><verse number="17" style="v" sid="EZK 26:17" />तिना तेरे बारे दे शोगो रा गाणा बणाई की ताखे बोलणा, हाय! मच्छुआरे री बसायी री हाय! सराये रे शईर जो समुद्रो बीचे रणे वाल़ेया समेत सामर्थी था, ओर तेरे लोका रे डरो ते समुद्रो कनारे रणे वाल़े लोक बऊत डरो थे।<note caller="+" style="f"><char style="fr" closed="false">26:17 </char><char style="ft" closed="false">प्रका. 18:9, प्रका. 18:10</char></note> <verse eid="EZK 26:17" /><verse number="18" style="v" sid="EZK 26:18" />एबे जेस दिने से शईर नाश ऊई जाणा, एड़ा लगोआ मानो समुद्रो रे कनारे रे इलाके दे रणे वाल़े लोक काँबी जाणे ओर समुद्रो रे द्वीपा रे लोक तेस शईरो रे नाश ऊई जाणे रिया बजा ते डरी जाणे।” <verse eid="EZK 26:18" /><verse number="19" style="v" sid="EZK 26:19" />कऊँकि आऊँ परमेशर यहोवा ईंयाँ बोलूँआ, “जेबे मां तूँ रेगिस्तानो रे शईरो जेड़ा उजाड़ करी देणा ओर तां पाँदे बड़ा समुद्र चढ़ाणा ओर तूँ डूगे पाणिए दे डूबी जाणा।<note caller="+" style="f"><char style="fr" closed="false">26:19 </char><char style="ft" closed="false">प्रका. 18:19</char></note> <verse eid="EZK 26:19" /><verse number="20" style="v" sid="EZK 26:20" />तेबे गड्डेया रे ओर रूड़ने वाल़ेया समेत मां तूँ बी पुराणे लोका साथे उतारी देणा ओर तूँ तिना साथे थाले राखी की पुराणे बखतो री ऊजड़ी री जगा जेड़ी करी देणा; एथो तक कि तूँ फेर नि बसणा ओर ना जिऊँदे लोका बीचे फेर कोई जगा मिलणी। <verse eid="EZK 26:20" /><verse number="21" style="v" sid="EZK 26:21" />मां तूँ डरने री बजा करी देणा ओर तूँ बादो ते फेर नि रणा, बल्कि टोल़ने ते बी तेरा पता नि लगणा, परमेशर यहोवे री येई बाणी ए।”<note caller="+" style="f"><char style="fr" closed="false">26:21 </char><char style="ft" closed="false">यहे. 27:36, पज. 37:36</char></note><verse eid="EZK 26:21" /></para>
  <chapter eid="EZK 26" />
  <chapter number="27" style="c" sid="EZK 27" />
  <para style="s">सोर शईरो रिया तँईं शोग करना</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 27:1" />यहोवे रा ये सन्देश एक बार फेर माखे मिलेया, <verse eid="EZK 27:1" /><verse number="2" style="v" sid="EZK 27:2" />“ओ नाश ऊणे वाल़े माणूंआ, सोर शईरो रे बारे दे एक शोगो रा गाणा बणाई की तेसखे बोल”<verse eid="EZK 27:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="EZK 27:3" />ओ समुद्रो रे मुँआणे पाँदे रणे वाल़ी, ओ बऊत सारे द्धीपो रिया तँईं देश-देशो रे लोका साथे बपार करने वाल़ी, परमेशर यहोवा ईंयाँ बोलोआ,</para>
  <para style="q" vid="EZK 27:3">ओ सोर देशो रे लोको तुसे बोली राखेया कि म्हारा शईर बऊत सुन्दर ए।<verse eid="EZK 27:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="EZK 27:4" />तेरा बन्ना समुद्रो बीचे ए; तेरे शईरो खे बनाणे वाल़े तेरा शईर बऊत सुन्दर बणाई राखेया।<verse eid="EZK 27:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="EZK 27:5" />तेरिया सब फटिया सनीर पाह्ड़ो रे सनौबरो री लकड़िया रिया बणी रिया,</para>
  <para style="q" vid="EZK 27:5">तेरे जाह्जो खे बनाणे खे लबानोनो रे पाह्ड़ो रे देवदारो री लकड़ी लई राखी।<verse eid="EZK 27:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="EZK 27:6" />तेरे पतवार बाशान प्रदेशो रे बड़े डाल़ो रे बणी रे,</para>
  <para style="q" vid="EZK 27:6">सनौबरो ते चीड़ो रे डाल़ा रा इस्तेमाल,</para>
  <para style="q" vid="EZK 27:6">तेरे जाह्जो रे फर्शो रे कमरे रिया तँईं कित्तेया,</para>
  <para style="q" vid="EZK 27:6">ओर तिने एते रणे री जगा आथी दाँदो ते सजाई।<verse eid="EZK 27:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="EZK 27:7" />तेरे जाह्जो रे तरपाल मिस्रो ते ल्याये रे कढ़ाईदार रेशमो रे बणी रे,</para>
  <para style="q" vid="EZK 27:7">ताकि तेतेरे चण्डे लोक दूरा ते देखी सको,</para>
  <para style="q" vid="EZK 27:7">तुसा री चाँदणी एलीशा रे द्धीपो<note caller="+" style="f"><char style="fr" closed="false">27:7 </char><char style="fq" closed="false">एलीशा रे द्धीपो </char><char style="ft" closed="false">साईप्रस </char></note> ते ल्याये रे नीले ओर बैंगणी रंगो रे टाल्लेया री बणी।<verse eid="EZK 27:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="EZK 27:8" />तुसा रे खेनेवाले सिदोन ओर अर्वद शईरो रे रणे वाल़े थे; ओ सोर, तुसा बीचे ई रणे वाल़े अक्लमंद लोक तुसा रे जाह्ज चलाणे वाल़े थे।<verse eid="EZK 27:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="EZK 27:9" />तेरे कारीगर जुड़ाई करने वाल़े गबल शईरो रे बुजुर्ग ओर अक्लमंद लोक थे;</para>
  <para style="q" vid="EZK 27:9">तुसा बीचे बपार करने खे मच्छुआरेया समेत समुद्रो रे सारे जाह्ज तुसा गे आईगे थे।<note caller="+" style="f"><char style="fr" closed="false">27:9 </char><char style="ft" closed="false">प्रका. 18:19</char></note><verse eid="EZK 27:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="EZK 27:10" />तुसा री सेना दे फारसी, लूदी ओर पूती देशा रे लोक पर्ती ऊए थे;</para>
  <para style="q" vid="EZK 27:10">तिने तुसा बीचे ढाल ओर टोपी टाँगी ओर तिना री बजा ते ई सोर शईरो रे लोका रा प्रताप बढ़ेया था।<verse eid="EZK 27:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="EZK 27:11" />सोर शईरो री दवाला पाँदे तेरी सेना साथे अर्वद शईरो रे लोक चऊँ कनारे थे</para>
  <para style="q" vid="EZK 27:11">ओर तेरे गुम्मटो दे गम्मद शईरो रे रणे वाल़े सिपाई खड़े थे, तिने आपणी ढाला तेरे चऊँ कनारे टाँगिया थिया;</para>
  <para style="q" vid="EZK 27:11">तेरी सुन्दरता तिना रे जरीये पूरी ऊई थी।<verse eid="EZK 27:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="EZK 27:12" />आपणी बऊत सारी सम्पत्तिया रिया बजा ते तर्शीश शईरो रे लोक तेरे बपारी थे; तिने चाँदी, लोआ, राँगा ओर शीशा देई की तेरा माल खरीदेया। <verse eid="EZK 27:12" /><verse number="13" style="v" sid="EZK 27:13" />यावान, तूबल ओर मेशेक इलाके रे लोक तेरे मालो रे बदले दास-दासिया ओर पीतल़ी रे पांडे देई की तां साथे बपार करो थे। <verse eid="EZK 27:13" /><verse number="14" style="v" sid="EZK 27:14" />तोगर्मारे कराने रे लोके तेरी सम्पत्ति लई की कोड़े, सवारिया रे कोड़े ओर खच्चर दित्ते। <verse eid="EZK 27:14" /><verse number="15" style="v" sid="EZK 27:15" />ददानी लोक तेरे बपारी थे; बऊत सारे द्वीप तेरे समानो री मण्डी बणे थे; सेयो तांगे आथी दाँदो रे सींग ओर आबनूसो री लकड़ी बपारो रे ल्याओ थे। <verse eid="EZK 27:15" /><verse number="16" style="v" sid="EZK 27:16" />तेरे अराम प्रदेशो दे कईया तरआ रिया चीजा खे बणाओ थे। इजी री खातर एदोम प्रदेश बी तां साथे बपार करो था। एदोम प्रदेशो रे बपारी तेरे समानो रे बदले दे ताखे यो चीजा देयो थे; मरकत मणि, बैंगणी रंगो रे ओर कढ़ाईदार टाल्ले, सन, मूगा ओर लालड़ी देई की सेयो तेरा माल लओ थे। <verse eid="EZK 27:16" /><verse number="17" style="v" sid="EZK 27:17" />यहूदा ओर इस्राएल देश बी तेरे बपारी थे; सेयो तेरे समानो रे बदले जैतूनो रा तेल, पईली फसला रे दाऊगल़े, मिन्नीत शईरो री बढ़िया कणक, सईत, तेल ओर बलसान देयो थे। <verse eid="EZK 27:17" /><verse number="18" style="v" sid="EZK 27:18" />तां बीचे बऊत कारीगरी ऊई ओर हर प्रकारा रा तअन कट्ठा ऊआ, एते ते दमिश्क शईर तेरा बपारो री जगा ऊईगा; तांगे हेलबोन शईरो रा शराब ओर साफ सफेद ऊन पऊँछायी। <verse eid="EZK 27:18" /><verse number="19" style="v" sid="EZK 27:19" />वदान ओर यावाने तेरे मालो रे बदले सूत दित्तेया ओर तिना रिया बजा ते फौलाद, तेजपता ओर अगरो रा बी बपार ऊआ। <verse eid="EZK 27:19" /><verse number="20" style="v" sid="EZK 27:20" />ददान शईरो रे बपारी तां साथे कोड़ेया री काठिया खे टाल्लेया रा बपार करो था। <verse eid="EZK 27:20" /><verse number="21" style="v" sid="EZK 27:21" />अरब देशो रे लोक ओर केदार देशो रे सारे परदान लोके तेरे समानो ने बदले ताखे मिन्टू, खाडू ओर बाकरे ल्याई की तां साथे लेण-देण कित्तेया। <verse eid="EZK 27:21" /><verse number="22" style="v" sid="EZK 27:22" />शेबा ओर रामाह शईरो रे बपारिये तेरे समानो रे बदले तां साथे खरी-खरी जातिया रा सब प्रकारा रा मसाला, हर प्रकारा री मणि ओर सूईना देई की तां साथे बपार कित्तेया। <verse eid="EZK 27:22" /><verse number="23" style="v" sid="EZK 27:23" />हारान, कन्ने, एदेन, शेबा शईरा रे बपारी ओर अश्शूर ओर कलमद इलाके रे बपारिये तां साथे बपार कित्तेया। <verse eid="EZK 27:23" /><verse number="24" style="v" sid="EZK 27:24" />इने खरिया-खरिया चीजा, मतलब टखणे खे नीले कढ़ाईदार टाल्ले ओर डोरिया साथे बानी री ओर देवदारो साते बणे री चित्रा रे टाल्लेया रिया पेटिया ल्याई की तां साथे लेण-देण कित्तेया। <verse eid="EZK 27:24" /><verse number="25" style="v" sid="EZK 27:25" />तर्शीश शईरो रे जाह्ज तेरा माल टोणे वाल़े ऊए।</para>
  <para style="q" vid="EZK 27:25">तिना रे जरीये तूँ समुद्रो बीचे रयी की बऊत अमीर ओर प्रतापी ऊई गी थी।<verse eid="EZK 27:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="EZK 27:26" />तेरे जाह्जो खे चलाणे वाल़ेया तूँ डूगे पाणिए रे पऊँचाई ता था</para>
  <para style="q" vid="EZK 27:26">पर तूफानो तुसा रे जाह्ज समुद्रो दे नाश करी देणे।<verse eid="EZK 27:26" /></para>
  <para style="q">
    <verse number="27" style="v" sid="EZK 27:27" />तेस दिने ई तेरी तअन-सम्पत्ति, बपारो रा माल, मच्छुआरे, मांझी, जुड़ाईया रा काम करने वाल़े, बपारी लोक</para>
  <para style="q" vid="EZK 27:27">ओर तां बीचे जितणे सिपाई ए ओर तेरे सारे लोक, ओर जो कुछ तांगे था, से सब समुद्रो दे डुबी जाणा।<verse eid="EZK 27:27" /></para>
  <para style="q">
    <verse number="28" style="v" sid="EZK 27:28" />तेरे जाह्जा खे चलाणे वाल़े डूबदे बखते चींगणे ओर तेरे नेड़े-तेड़े रे लोक डरी जाणे।<verse eid="EZK 27:28" /></para>
  <para style="q">
    <verse number="29" style="v" sid="EZK 27:29" />सब चलाणे वाल़े, मच्छुआरे ओर समुद्रो दे जितणे मच्छुआरे रओए,</para>
  <para style="q" vid="EZK 27:29">सेयो आपणे-आपणे जाह्जो पाँदा ते उतरने,<note caller="+" style="f"><char style="fr" closed="false">27:29 </char><char style="ft" closed="false">प्रका. 18:17</char></note><verse eid="EZK 27:29" /></para>
  <para style="q">
    <verse number="30" style="v" sid="EZK 27:30" />ओर सेयो ताखे समुद्रो दे डूबदे ऊए देखी की जोरे-जोरे की चींगणे लगी रे।</para>
  <para style="q" vid="EZK 27:30">सेयो दु:खो दे आपणे-आपणे सिरो दे स्वा लगाई की तूड़ा बीचे मरेलणे,<note caller="+" style="f"><char style="fr" closed="false">27:30 </char><char style="ft" closed="false">प्रका 18:19 </char></note><verse eid="EZK 27:30" /></para>
  <para style="q">
    <verse number="31" style="v" sid="EZK 27:31" />ओर तेरे दु:खो रे आपणे सिरो रे बाल़ कटवाई देणे</para>
  <para style="q" vid="EZK 27:31">ओर लको रे टाट बानी की आपणे मनो रे बड़े दु:खो साथे तेरिया तँईं रोणे ओर छाती पीटी-पीटी की शोग मनाणे लगी रे।<verse eid="EZK 27:31" /></para>
  <para style="q">
    <verse number="32" style="v" sid="EZK 27:32" />तिना दु:ख करदे ऊए तेरे बारे दे ये शोगो रा गीत गाणा,</para>
  <para style="q" vid="EZK 27:32">सोर समुद्रो दे नाश करी ता दा ए, तेसा जेड़ा कुण शईर ए?<note caller="+" style="f"><char style="fr" closed="false">27:32 </char><char style="ft" closed="false">प्रका. 18:15, प्रका. 18:18</char></note><verse eid="EZK 27:32" /></para>
  <para style="q">
    <verse number="33" style="v" sid="EZK 27:33" />जेबे तेरा माल समुद्रो ते बारे निकल़ो था, तेबे बऊत सारी जातिया रे लोक रज्जी जाओ थे;</para>
  <para style="q" vid="EZK 27:33">तेरे अमीर ओर बऊत सारे मालो रिया बजा ते तरतिया रे राजा अमीर ओ थे।<note caller="+" style="f"><char style="fr" closed="false">27:33 </char><char style="ft" closed="false">प्रका. 18:9, प्रका. 18:15, प्रका. 18:19</char></note><verse eid="EZK 27:33" /></para>
  <para style="q">
    <verse number="34" style="v" sid="EZK 27:34" />जेस बखते तूँ समुद्रो रे पाणिए बीचे टूटी की डुबी, तेस बखते तेरे बपारो रा सारा माल ओर तां साथे काम करने वाल़े सब तेरे पीतरे रयी की नाश ऊईगे।<verse eid="EZK 27:34" /></para>
  <para style="q">
    <verse number="35" style="v" sid="EZK 27:35" />समुद्रो रे कनारे देशो रे सब रणे वाल़े आपणे भाग्य खे देखी की डरी गे,</para>
  <para style="q" vid="EZK 27:35">ओर तेथो रे सबी राजेया रे बाल़ खड़े ऊईगे ओर तिना रे मूँ उदास ऊईगे।<verse eid="EZK 27:35" /></para>
  <para style="q">
    <verse number="36" style="v" sid="EZK 27:36" />देश-देशो रे बपारी तेरे खलाफ ताना मारो थे,</para>
  <para style="q" vid="EZK 27:36">तूँ डरो री बजा ऊई गी री ओर तूँ फेर खड़ी नि रयी सकणी।<note caller="+" style="f"><char style="fr" closed="false">27:36 </char><char style="ft" closed="false">यहे. 26:21, यिर्म. 18:16</char></note><verse eid="EZK 27:36" /></para>
  <chapter eid="EZK 27" />
  <chapter number="28" style="c" sid="EZK 28" />
  <para style="s">सोर शईरो रे राजे रे खलाफ भविष्यबाणी</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 28:1" />यहोवे रा ये सन्देश माखे एक बार फेर मिलेया, <verse eid="EZK 28:1" /><verse number="2" style="v" sid="EZK 28:2" />“ओ नाश ऊणे वाल़े माणूंआ, सोर शईरो रे परदानो खे बोल, परमेशर यहोवा ईंयाँ बोलोआ कि तैं कमण्डी ऊई की ये बोली राखेया, कि आऊँ एक देवता ए, आऊँ समुद्रो बीचे एकी द्वीपो पाँदे एकी शईरो दे एकी देवते रे आसणो पाँदे बैठी रा!” पर जे तू आपणे आपू खे देवते जेड़ा दखाएया, तेबे बी तू ईश्वर नि ए, माणूं ई ए।<note caller="+" style="f"><char style="fr" closed="false">28:2 </char><char style="ft" closed="false">यहे. 28:9</char></note> <verse eid="EZK 28:2" /><verse number="3" style="v" sid="EZK 28:3" />तूँ दानिय्येलो ते जादा अक्लमंद तो आए; कि तूँ सारे पेतो खे जाणेया, <verse eid="EZK 28:3" /><verse number="4" style="v" sid="EZK 28:4" />तूँ आपणी बुद्धि ओर समजा रे जरीये अमीर ऊआ ओर आपणे पण्डारा दे सूईना-चाँदी राखी राखेया; <verse eid="EZK 28:4" /><verse number="5" style="v" sid="EZK 28:5" />तैं आपणी बुद्धिया साथे लेण-देण कित्तेया, जेते कि तूँ अमीर ऊईगा ओर अमीर ऊणे रिया बजा ते ताखे कमण्ड ऊईगा। <verse eid="EZK 28:5" /><verse number="6" style="v" sid="EZK 28:6" />इजी बजा ते परमेशर यहोवा ईंयाँ बोलोआ, कऊँकि तूँ सोचेया कि तूँ परमेशरो जेड़ा अक्लमंद आ, <verse eid="EZK 28:6" /><verse number="7" style="v" sid="EZK 28:7" />इजी री खातर देख, मां तां पाँदे एड़े परदेशिया ते अमला करवाणा, जो सबी जातिया ते जादा दुष्ट ए; तिना सेयो सब बांकिया चीजा नाश करी देणियां जो तुसे आपणे अक्ला ओर समजा ते आसिल करी राखिया, <verse eid="EZK 28:7" /><verse number="8" style="v" sid="EZK 28:8" />तिना तूँ मौता रे कुएँ दे सेटी देणा, ओर तूँ तलवारे की काई देणा, समुद्रो तेरी कब्र बणी जाणा। <verse eid="EZK 28:8" /><verse number="9" style="v" sid="EZK 28:9" />तेबे क्या तां आपणे काणे वाल़ेया रे सामणे बोलदे रणा, आऊँ देवता ए। तूँ आपणे काईल करने वाल़ेया रे आथो दे देवता नि, माणूं ई ठईरना। <verse eid="EZK 28:9" /><verse number="10" style="v" sid="EZK 28:10" />तूँ परदेशिया रे आथो ते बिना खतना कित्ते रे लोका जेड़ा मरना; कऊँकि मैं ई एड़ा बोली राखेया, परमेशर यहोवे री येई बाणी ए।<verse eid="EZK 28:10" /></para>
  <para style="s">सोर शईरो रे राजे रा नाश</para>
  <para style="p">
    <verse number="11" style="v" sid="EZK 28:11" />तेबे यहोवे रा ये सन्देश माखे मिलेया, <verse eid="EZK 28:11" /><verse number="12" style="v" sid="EZK 28:12" />ओ नाश ऊणे वाल़े माणूंआ, सोरो रे राजे रे बारे दे ये शोगो रा गाणा बणाई की तेसखे बोल, परमेशर यहोवा ईंयाँ बोलोआ,</para>
  <para style="q" vid="EZK 28:12">“तूँ तो अक्लमंद ए,</para>
  <para style="q" vid="EZK 28:12">तूँ बऊत जादा बुद्धिमान ओर बऊत सुन्दर ए।<verse eid="EZK 28:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="EZK 28:13" />तूँ परमेशरो रे अदन नाओं रे बगीचे रे था;</para>
  <para style="q" vid="EZK 28:13">तांगे गईणे, माणिक्य, पुखराज, ईरा, फिरोजा, सुलैमानी मणि, यशब, नीलमणि, मरकत ओर लाल सब प्रकारा रे मणि ओर सूईने रे टाल्ले थे;</para>
  <para style="q" vid="EZK 28:13">तेरे डफ ओर बँसरिया तां बीचे ई बणाईया थिया;</para>
  <para style="q" vid="EZK 28:13">जेस दिने तूँ बणाया गया था; तेस दिने सेयो बी त्यार कित्तिया थिया।<note caller="+" style="f"><char style="fr" closed="false">28:13 </char><char style="ft" closed="false">प्रका. 2:7</char></note><verse eid="EZK 28:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="EZK 28:14" />तूँ रक्षा करने वाल़ा अभिषिक्त करूब था, मैं तूँ एड़ा ठराया कि तूँ परमेशरो रे पवित्र पाह्ड़ो पाँदे रये था;</para>
  <para style="q" vid="EZK 28:14">तूँ आगी जेड़े चमकणे वाल़े मणिया बीचे चलो-फिरो था।<verse eid="EZK 28:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="EZK 28:15" />जेस दिनो ते तूँ बणाया ओर जेस दिनो तक तांदे बुराई नि थी,</para>
  <para style="q" vid="EZK 28:15">तेस दिनो तक तूँ आपणी सारी चाला रे निर्दोष रया।<verse eid="EZK 28:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="EZK 28:16" />पर बऊत जादा लेण-देणो रिया बजा ते तूँ बुराईया साथे परी की अपवित्र ऊईगा;</para>
  <para style="q" vid="EZK 28:16">इजी ते मैं तूँ परमेशरो रे पाह्ड़ो ते जेती आऊँ रऊँआ थाले उतारी ता ओर ओ रक्षा करने वाल़े करूब,</para>
  <para style="q" vid="EZK 28:16">मैं तूँ आगी जेड़े चमकणे वाल़े मणिये बीचा ते नाश करी ता।<verse eid="EZK 28:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="EZK 28:17" />कऊँकि तूँ बऊत सुन्दर थी, इजी री खातर ताखे बऊत कमण्ड था;</para>
  <para style="q" vid="EZK 28:17">ओर वैभवो रिया बजा ते तेरी बुद्धि बिगड़ी गी थी।</para>
  <para style="q" vid="EZK 28:17">मैं तूँ जमीना दे पटकी ता ओर ओरी राजेया रे सामणे तूँ राखेया कि सेयो ताखे देखो।<verse eid="EZK 28:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="EZK 28:18" />तेरे बऊत जादा बुरे कामो रिया बजा ते ओर लेण-देणो री बुराईया ते तेरी आराधना री जगा अपवित्र ऊईगिया;</para>
  <para style="q" vid="EZK 28:18">इजी बजा ते मैं तां बीचे एड़ी आग पैदा कित्ती कि तिदे तूँ स्वा ऊईगा</para>
  <para style="q" vid="EZK 28:18">ओर मैं तूँ सबी देखणे वाल़ेया सामणे स्वा करी ता।<verse eid="EZK 28:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="EZK 28:19" />देश-देशो रे लोका बीचा ते जितणे ताखे जाणोए, सब तेरी बजा ते डरी गे;</para>
  <para style="q" vid="EZK 28:19">तूँ डरने री बजा ऊआ ओर फेर कदी नि रणा।”<verse eid="EZK 28:19" /></para>
  <para style="s">सिदोन शईरो रे खलाफ भविष्यबाणी</para>
  <para style="p">
    <verse number="20" style="v" sid="EZK 28:20" />यहोवे रा ये सन्देश माखे फेर मिलेया, <verse eid="EZK 28:20" /><verse number="21" style="v" sid="EZK 28:21" />“ओ नाश ऊणे वाल़े माणूंआ, आपणा मूँ सिदोन शईरो रिया तरफा खे करी की तेसरे खलाफ भविष्यबाणी कर, <verse eid="EZK 28:21" /><verse number="22" style="v" sid="EZK 28:22" />ओर बोल, प्रभु यहोवा ईंयाँ बोलोआ, ओ सिदोन, आऊँ तेरे खलाफ ए, जो कुछ मां तां साथे करना तेतेरिया बजा लोका मेरी महिमा करनी। जेबे मां ताखे सजा देणी ओर तेस बीचे आपू खे पवित्र ठराऊँगा, तेबे लोका खे पता लगी जाणा कि आऊँ ई यहोवा ए।” <verse eid="EZK 28:22" /><verse number="23" style="v" sid="EZK 28:23" />मां शईरो रे लोक कायी देणे। दुश्मणा शईरो रे चऊँ कनारा ते अमला करना, ओर तिना रा खून सड़का बह्याई देणा। तेबे तिना खे पता लगी जाणा कि आऊँ ई यहोवा ए।<verse eid="EZK 28:23" /></para>
  <para style="s">इस्राएलो खे आशीष मिलणा</para>
  <para style="p">
    <verse number="24" style="v" sid="EZK 28:24" />यहोवा बोलोआ, “इस्राएलो रे लोको, तुसा रे नेड़े-तेड़े रणे वाल़ेया लोका तुसा खे एबे नुकशाण नि पऊँचाणा जेड़ा कि कांडे वाल़ेया बाड़ा या पईने कांडे चूबी की लोका खे कायी देयो ए। ओर तेबे इस्राएली लोका खे पता लगी जाणा कि आऊँ ई परमेशर यहोवा ए, जो बोलूँआ से ई करुँ बी आ।” <verse eid="EZK 28:24" /><verse number="25" style="v" sid="EZK 28:25" />परमेशर यहोवा ईंयाँ बोलोआ, “जेबे मां इस्राएलो रा कराना तिना सबी लोका बीचे कट्ठा करना, जिना बीचे सेयो तितर-बित्तर ऊए ओर देश-देशो रे लोका सामणे तिना रे जरीये पवित्र परमेशर ठईरना, तेबे सेयो तेते देशो रे रणे, जो मैं आपणे दास याकूबो खे दित्तेया था। <verse eid="EZK 28:25" /><verse number="26" style="v" sid="EZK 28:26" />इस्राएलो रे लोक आपणे देशो दे बिना डरे बसे दे रणे; तिना कअर बनाणे ओर अंगूरा रे बगीचे लगाणे। जिने बी देशे जो तिना साथे लगदे ए, तिना साथे दुश्मणिया रा बर्ताओ करी राखेया था, तिना खे मां सजा देणी। तेते ते बाद इस्राएली लोक आपणे देशो दे बिना डरे रणे। तेबे तिना खे पता लगी जाणा कि आऊँ ई तिना रा परमेशर यहोवा ए।”<verse eid="EZK 28:26" /></para>
  <chapter eid="EZK 28" />
  <chapter number="29" style="c" sid="EZK 29" />
  <para style="s">मिस्रो रे खलाफ भविष्यबाणी</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 29:1" />दसुए सालो रे दसुए मीन्ने रे बारूए दिने यहोवे रा ये सन्देश माखे फेर मिलेया, <verse eid="EZK 29:1" /><verse number="2" style="v" sid="EZK 29:2" />“ओ नाश ऊणे वाल़े माणूंआ, आपणा मूँ मिस्र देशो रे राजा फिरौनो रिया तरफा खे करी की तेसरे ओर सारे मिस्रो रे खलाफ भविष्यबाणी कर” <verse eid="EZK 29:2" /><verse number="3" style="v" sid="EZK 29:3" />तिना ते गल्ला कर ओर ईंयाँ बोल, परमेशर यहोवा ईंयाँ बोलोआ, “ओ मिस्र देशो रे राजा फिरौन, आऊँ तेरे खलाफ ए, ओ बड़े शईर, तूँ जो आपणी नील नदिया बीचे पड़ेया दा मगरमच्छ ए, तूँ बोलेया, नील नदी मेरी आपणी ए ओर मैं से आपणियां तँईं बणाई राखी।” <verse eid="EZK 29:3" /><verse number="4" style="v" sid="EZK 29:4" />मां तेरे मुंए दे कांडा पाई की तूँ पकड़ी लणा। मां तेरी नदिया रिया मछलिया तेरिया ताकड़िया दे लटकाई देणियां। मां तूँ तिना सबी मछलिया समेत नदिया ते बारे खिंजी की लई आऊणा। <verse eid="EZK 29:4" /><verse number="5" style="v" sid="EZK 29:5" />तेबे मां तूँ तेरी सारी मछलिया समेत उजाड़ जगा दे सेटी देणा। तूँ मैदानो रे पड़ेया रा रणा। तूँ ना तो केसी चकणा ओर ना तूँ कब्रा दे राखणा। मैं तूँ बणो रे डांगर ओर पंछिया खे खाणे खे देई देणा। <verse eid="EZK 29:5" /><verse number="6" style="v" sid="EZK 29:6" />तेबे मिस्रो रे सबी रणे वाल़ेया खे पता लगी जाणा कि आऊँ ई यहोवा ए। यहोवा बोलोआ, “इस्राएलो रे लोके मतादा रिया तँईं तुसा मिस्रिया पाँदे परोसा कित्तेया था, पर तूँ तिना रिया तँईं एक नंगल़ो जेड़ा था। <verse eid="EZK 29:6" /><verse number="7" style="v" sid="EZK 29:7" />इस्राएलिये तूँ आपणे आथे की पकड़ी ला। पर तूँ तिना रे बोजे की टूटी गा। तैं तिना रिया कांदा छिली तिया। इस्राएलो रे लोक तेरा साअरा लणे खे तां पाँदे चुके, पर तूँ दो टुकड़े ऊईगा। ओर तिना री पीठ टुटी गी।” <verse eid="EZK 29:7" /><verse number="8" style="v" sid="EZK 29:8" />इजी बजा ते परमेशर यहोवा ईंयाँ बोलोआ, “ओ मिस्रो रे राजा, मां तां पाँदे तलवार चलाई की, मां तेरे सब माणूं ओर डांगर दोनो नाश करी देणे। <verse eid="EZK 29:8" /><verse number="9" style="v" sid="EZK 29:9" />तेबे मिस्र देश उजाड़ ई उजाड़ ऊई जाणा ओर तिना खे पता लगी जाणा कि आऊँ ई यहोवा ए। तैं बोली राखेया कि मेरी नील नदी मेरी आपणी ई ए ओर से मैं ई बणाई राखी। <verse eid="EZK 29:9" /><verse number="10" style="v" sid="EZK 29:10" />इजी बजा ते देख, आऊँ तेरे ओर तेरी नदिया रे खलाफ ए ओर मां मिस्र देश मिग्दोल शईरो ते लई की सवेने शईरो तक बल्कि कूश देशो रे बन्ने तक उजाड़ ई उजाड़ करी देणा। <verse eid="EZK 29:10" /><verse number="11" style="v" sid="EZK 29:11" />केसी बी माणूंए मिस्रो दे पैर तक नि राखणा, ओर ना तीसिए जाणा। तेती केसी डांगरो रा पैर पनि पड़ना। से चाल़िया साला तक ऊजड़ पड़ेया दा रणा। <verse eid="EZK 29:11" /><verse number="12" style="v" sid="EZK 29:12" />चाल़ी साल तक मां मिस्र देश उजड़े रे देशो बीचे उजाड़ करी की राखणा ओर तेथो रे शईर उजड़े रे शईरा बीचे खण्डहर ई रणे। मां मिस्री लोक जातिया-जातिया बीचे तित्तर-बित्तर करी देणे।” <verse eid="EZK 29:12" /><verse number="13" style="v" sid="EZK 29:13" />परमेशर यहोवा ईंयाँ बोलोआ, “जेबे चाल़ी साल बीती जाणे तेबे मां मिस्री लोक तिना जातिया बीचा ते कट्ठे करने, जिना रे सेयो तित्तर-बित्तर ऊईगे थे; <verse eid="EZK 29:13" /><verse number="14" style="v" sid="EZK 29:14" />ओर मां मिस्री लोक गुलामिया ते छुड़ाई की पत्रोस देशो दे, जो तिना री जन्मभूमि ए, फेर पऊँचाई देणे ओर तेती तिना रा छोटा जा राज ऊई जाणा। <verse eid="EZK 29:14" /><verse number="15" style="v" sid="EZK 29:15" />मिस्र सबी राज्या बीचे छोटा ऊणा ओर तिना आपणा सिर ओरी जातिया बीचे नि चकणा; कऊँकि मां मिस्री लोक एड़े कम करी देणे कि तिना फेर ओरी जातिया पाँदे राज नि करी सकणा। <verse eid="EZK 29:15" /><verse number="16" style="v" sid="EZK 29:16" />से फेर इस्राएलो रे कराने रे परोसे री बजा नि ऊणी, कऊँकि तिना जेबे फेर मतादा रिया तँईं तिना रिया तरफा खे देखणे लगणा, तेबे तिना, तिना रे पाप याद करने। तेबे इस्राएलो रे लोका खे पता लगी जाणा कि आऊँ ई परमेशर यहोवा ए।”<verse eid="EZK 29:16" /></para>
  <para style="s">बाबेलो रे जरिये मिस्रो रा लूटेया जाणा</para>
  <para style="p">
    <verse number="17" style="v" sid="EZK 29:17" />राजा यहोयाकीम ओर आसा खे बेबीलोनो दे गुलाम बणाई की लईगे दे सताई साल ऊईगे दे थे तीजी रे पईले मीन्ने रे पईले दिने यहोवे रा ये सन्देश माखे फेर मिलेया, <verse eid="EZK 29:17" /><verse number="18" style="v" sid="EZK 29:18" />“ओ नाश ऊणे वाल़े माणूंआ, बाबेल देशो रे राजा नबूकदनेस्सरे सोर देशो खे केरने खे आपणी सेना ते बऊत मईणत कराई; हर एकी रा सिर गँजा ऊईगा ओर हर एकी रे फरकुआ री चामड़ी छिली गी; तेबे बी तेसखे सोर देशो ते ना तो इतणी जादा मईणती री मजदूरी मिली ओर ना तेसरी सेना खे।” <verse eid="EZK 29:18" /><verse number="19" style="v" sid="EZK 29:19" />इजी बजा ते परमेशर यहोवा ईंयाँ बोलोआ, “देख, मां बाबेलो रे राजा नबूकदनेस्सरो खे मिस्र देश देई देणा ओर तेस तेथो रे लोक लई जाणे ओर तेथो री तअन-सम्पत्ति लूटी की आपणी करी देणी; मतलब येई मजदूरी तेसरी सेना खे मिलणी। <verse eid="EZK 29:19" /><verse number="20" style="v" sid="EZK 29:20" />मैं तेसरी मईणता रे बदले तेसखे मिस्र देश इजी खे दित्तेया कऊँकि तिने ओर तिना री सेने मेरिया खातर काम कित्तेया था, परमेशर यहोवे री येई बाणी ए।” <verse eid="EZK 29:20" /><verse number="21" style="v" sid="EZK 29:21" />जेस बखते मिस्र देश आरना तेस बखते मां इस्राएल फेर एक तागतबर देश बनाणा। तेबे मां ताखे तिना रिया तँईं एक सन्देश देणा। ओ यहेजकेल, तिना तेरिया गल्ला सुणनिया। तेबे इस्राएलिया खे पता लगी जाणा कि आऊँ ई यहोवा ए।<verse eid="EZK 29:21" /></para>
  <chapter eid="EZK 29" />
  <chapter number="30" style="c" sid="EZK 30" />
  <para style="s">मिस्र देश ओर तेसरे साथिया खे सजा मिलणी</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 30:1" />फेर यहोवे रा ये सन्देश माखे मिलेया, <verse eid="EZK 30:1" /><verse number="2" style="v" sid="EZK 30:2" />“ओ नाश ऊणे वाल़े माणूंआ, भविष्यबाणी करी की बोल, परमेशर यहोवा ईंयाँ बोलोआ: ओ मिस्रो रे लोको, हाय, हाय करो, डराऊणा दिन आऊणे लगी रा!” <verse eid="EZK 30:2" /><verse number="3" style="v" sid="EZK 30:3" />परमेशर तुसा खे बोलोआ, “कऊँकि से खतरनाक दिन, मतलब यहोवे रा दिन नेड़े ए, से काल़े बादल़ो रा दिन ऊणा, तेबे सारे देशो रिया तँईं सजा रा दिन ऊणा। <verse eid="EZK 30:3" /><verse number="4" style="v" sid="EZK 30:4" />मिस्रो दे लड़ाई ऊणी ओर कूश देशो दे बड़ा संकट ऊणा। मिस्रो दे बऊत जे लोक तलवारे की काये जाणे; मिस्र लूटी लणा ओर खण्डहरो दे छाडी देणा। <verse eid="EZK 30:4" /><verse number="5" style="v" sid="EZK 30:5" />कूश, पूत, लिबिया, लूद ओर सारे दोगले ओर कूब देशो रे लोक ओर वाचा बाने रे मेरे आपणे इस्राएल देशो रे कराये पाँदे गये दे सिपाई, मिस्रिया साथे तलवारी साथे काये जाणे।” <verse eid="EZK 30:5" /><verse number="6" style="v" sid="EZK 30:6" />यहोवा ईंयाँ बोलोआ, “मिस्रो खे सम्बाल़ने वाल़े बी टल़ी जाणे ओर मिस्री आपणी जेसा सामर्था पाँदे कमण्ड करोए, से टूटी जाणी, उत्तरा दे मिग्दोल शईरो ते लई की दक्खणा दे सवेने शईरो तक तेथो रे रणे वाल़े तलवारी साथे मारे जाणे, परमेशर यहोवे री येई बाणी ए।” <verse eid="EZK 30:6" /><verse number="7" style="v" sid="EZK 30:7" />मिस्र केसी बी दूजे देशो रे मुकाबले जादा उजाड़ ऊई जाणा। इजी रे शईर पूरी तरआ ते नाश ऊई जाणे। <verse eid="EZK 30:7" /><verse number="8" style="v" sid="EZK 30:8" />जेबे मां मिस्रो दे आग लगाणी। ओर तेथो रे सारे मतदगार नाश ऊई जाणे, तेबे तिना खे पता लगी जाणा कि आऊँ ई यहोवा ए। <verse eid="EZK 30:8" /><verse number="9" style="v" sid="EZK 30:9" />जेबे से दिन आऊणा ओर मिस्र नाश ऊई जाणा, तो मां कूशो रे बेफिकरे लोका खे जगाणे रिया तँईं जाह्जा दे दूत पेजणे, ओर सेयो डरी जाणे। से दिन आऊणे वाल़ा ए!<verse eid="EZK 30:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="EZK 30:10" />परमेशर यहोवा ईंयाँ बोलोआ, “मां बाबेलो रे राजा नबूकदनेस्सरो रे आथो साथे मिस्रो रे बऊत सारे लोक नाश करी देणे। <verse eid="EZK 30:10" /><verse number="11" style="v" sid="EZK 30:11" />मां नबूकदनेस्सर राजा तेसरिया सेना समेत, जो सबी जातिया बीचे खतरनाक ए, तेस देशो दे नाश करने खे पेजणा ओर तिना मिस्र देशो रे लोका खे तलवारे की काई की से सारा देश लाशा साथे परी देणा। <verse eid="EZK 30:11" /><verse number="12" style="v" sid="EZK 30:12" />तेबे मां नील नदिया रा पाणी सुकाई देणा ओर देश दुष्ट लोका रे आथो दे करी देणा ओर मां परदेशिया रे जरीये देश ओर जो कुछ तिदे ए, नाश करी देणा; मैं यहोवे ई ये बोली राखेया।” <verse eid="EZK 30:12" /><verse number="13" style="v" sid="EZK 30:13" />परमेशर यहोवा ईंयाँ बोलोआ, “मां नोप शईरो ते मूर्तिया नाश करनिया ओर तेथो रिया मूर्तिया रणे नि देणियां, फेर कोई परदान मिस्र देशो दे नि उठणा ओर मां मिस्र देशो रे डर पैदा करना। <verse eid="EZK 30:13" /><verse number="14" style="v" sid="EZK 30:14" />मां पत्रोस शईर उजाड़ना ओर उत्तरा दे सोअन शईरो दे आग लगाणी ओर नो शईरो खे सजा देणी। <verse eid="EZK 30:14" /><verse number="15" style="v" sid="EZK 30:15" />सीन शईर जो मिस्रो री मजबूत जगा ए, तेते पाँदे मां आपणा रोष पड़काणा ओर नो शईरो री सेना नाश करी देणी। <verse eid="EZK 30:15" /><verse number="16" style="v" sid="EZK 30:16" />मां मिस्रो रे आग लगाणी, सीन शईरो रे लोक बऊत डरी जाणे; ओर नो शईर फाड़ी देणा ओर नोप शईरो रे बिरोदी दिने-दपईरे उठणे। <verse eid="EZK 30:16" /><verse number="17" style="v" sid="EZK 30:17" />ओन ओर पीवेसेत शईरा रे जवान सिपाई तलवारी की मरने ओर यो शईर गुलामिया दे चली जाणे। <verse eid="EZK 30:17" /><verse number="18" style="v" sid="EZK 30:18" />जेबे मां मिस्रिया रा जूँगड़ा तहपन्हेस शईरो दे तोड़ना, तेबे तिदे दिने न्हेरा ऊणा ओर तेसरी शक्ति जेस पाँदे से फूलोआ, से नाश ऊई जाणी; तेस पाँदे बादल़ छायी जाणे ओर मिस्रो तेथो रे लोक गुलाम बणाई देणे। <verse eid="EZK 30:18" /><verse number="19" style="v" sid="EZK 30:19" />ईंयाँ मां मिस्रिया खे सजा देणी ओर तिना खे पता लगी जाणा कि आऊँ यहोवा ए।”<verse eid="EZK 30:19" /></para>
  <para style="s">मिस्रो रे राजे री टूटी री शक्ति</para>
  <para style="p">
    <verse number="20" style="v" sid="EZK 30:20" />फेर ग्यारुए सालो रे पईले मीन्ने रे सातुए दिने यहोवे रा ये सन्देश माखे मिलेया, <verse eid="EZK 30:20" /><verse number="21" style="v" sid="EZK 30:21" />“ओ नाश ऊणे वाल़े माणूंआ, मैं मिस्रो रे राजा फिरौनो री बाँ तोड़ी ती री; ओर देख, ना तो से जोड़ी, ना तिदे लेप लगाई की पट्टी कराई ताकि से बानी की तलवार पकड़ने जोगी बणी सको।” <verse eid="EZK 30:21" /><verse number="22" style="v" sid="EZK 30:22" />इजी री खातर परमेशर यहोवा ईंयाँ बोलोआ, देख, आऊँ मिस्रो रे राजा फिरौनो रे खलाफ ए ओर तेसरी ठीक ओर खराब दोनो बाँई तोड़नियां ओर लड़ाईया री तलवार तेसरे आथो ते सटयाई देणी। <verse eid="EZK 30:22" /><verse number="23" style="v" sid="EZK 30:23" />मां मिस्री जातिया-जातिया बीचे तित्तर-बित्तर करी देणे, ओर देशो-देशो दे बखेरी देणे। <verse eid="EZK 30:23" /><verse number="24" style="v" sid="EZK 30:24" />मां बाबेलो रे राजे रिया बाँई तागतबर करी की आपणी तलवार तेसरे आथो रे देणी; पर मिस्रो रे राजा फिरौनो रिया बाँई तोड़ी देणियां ओर से आपणे दुश्मण बेबीलोनो रे राजे रे सामणे चींगणा, ओर मरी जाणा। <verse eid="EZK 30:24" /><verse number="25" style="v" sid="EZK 30:25" />मां मिस्रो रे राजे रिया बाँयी सम्बाल़नियां ओर फिरौनो रिया बाँयी टीलिया पड़ी जाणिया, तेबे तिना आरे दे मिस्रिया खे पता लगी जाणा कि आऊँ ई यहोवा ए। जेबे मां बाबेलो रे राजे रे आथो दे आपणी तलवार देणी, तेबे तेस से मिस्र देशो दे चलाणी; <verse eid="EZK 30:25" /><verse number="26" style="v" sid="EZK 30:26" />ओर मां मिस्री जातिया-जातिया बीचे तित्तर-बित्तर करी देणे, ओर देशो-देशो दे बखेरी देणे। तेबे मिस्रिया खे पता लगी जाणा कि आऊँ यहोवा ए।<verse eid="EZK 30:26" /></para>
  <chapter eid="EZK 30" />
  <chapter number="31" style="c" sid="EZK 31" />
  <para style="s">मिस्र देश ओर अश्शूर प्रदेशो रा नाश</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 31:1" />मारे गुलामिया दे गये रे ग्यारुए सालो रे तीजे मीन्ने रे पईले दिने यहोवे रा ये सन्देश माखे मिलेया, <verse eid="EZK 31:1" /><verse number="2" style="v" sid="EZK 31:2" />“ओ नाश ऊणे वाल़े माणूंआ, मिस्र देशो रे राजा फिरौन ओर तेसरे नौकरा खे बोल, आपणी बडयाई करने दे तूँ केस जेड़ा ए? <verse eid="EZK 31:2" /><verse number="3" style="v" sid="EZK 31:3" />देख, अश्शूर तो लबानोनो रे पाहड़ो रा एक देवदार था जेतेरिया सुन्दर-सुन्दर पाँगटिया, कणी छांए देयो थिया ओर बऊत ऊच्चिया थिया ओर तिना री चूँडी बादल़ो तक पऊँचो थी। <verse eid="EZK 31:3" /><verse number="4" style="v" sid="EZK 31:4" />डूगे चरनेया ते पाणी आओ था, इजी बजा ते देवदारो रा डाल़ लाम्बा ऊईगा। फेर पाणी डाल़ो रे चोठो रे चऊँ कनारे बह्ओ था जो पाणिए खे नेडे़-तेड़ो रे ओरी डाल़ा तक लई जाओ था। <verse eid="EZK 31:4" /><verse number="5" style="v" sid="EZK 31:5" />इजी बजा ते से बड़ा डाल़ मैदानो रे सबी डाल़ा बीचे ऊच्चा ऊईगा, तेसरिया पाँगटिया बऊत ओर लाम्बिया ऊईया, कऊँकि जेबे सेयो निकल़िया, तेबे तिना खे बऊत पाणी मिलेया। <verse eid="EZK 31:5" /><verse number="6" style="v" sid="EZK 31:6" />सबी तरआ रे पंछी एतेरिया डाल़िया पाँदे आपणे कोअले बणाओ थे। इजी रिया डाल़िया निठे जानवर बच्चे पैदा करो थे। सब बड़े देश एतेरिया छाया दे रओ थे।<note caller="+" style="f"><char style="fr" closed="false">31:6 </char><char style="ft" closed="false">दानी. 4:12</char></note> <verse eid="EZK 31:6" /><verse number="7" style="v" sid="EZK 31:7" />डाल़ इतणा सुन्दर था ओर एतेरिया डाल़िया लाम्बिया थिया। एतेरिया जड़ी डूगे बह्णे वाल़े पाणिए तक पऊँची रिया थिया। <verse eid="EZK 31:7" /><verse number="8" style="v" sid="EZK 31:8" />परमेशरो रे बगीचे रे देवदार बी तेसखे लकोई नि सको थे, सनौबरो रे डाल़ तेसरी पाँगटिया जेड़े पनि थे ओर ना अर्मोनो रे डाल़, परमेशरो रे बगीचे बीचा ते कोई बी डाल़ तेस बराबर सुन्दर नि था। <verse eid="EZK 31:8" /><verse number="9" style="v" sid="EZK 31:9" />मैं से बऊत डाल़िया रिया बजा ते सुन्दर बणाया था, एथो तक कि अदन बगीचे रे सारे डाल़, जो परमेशरो रे बगीचे दे थे, तेसते जल़ो थे।”<verse eid="EZK 31:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="EZK 31:10" />इजी बजा ते परमेशर यहोवा ईंयाँ बोलोआ, “तेसरी ऊचाई जो बढ़ी गी री ओर तेसरी चूँडी जो बादल़ो तक पऊँचोई ओर आपणी ऊचाईया री बजा ते तेसरा मन जो फूलोआ, <verse eid="EZK 31:10" /><verse number="11" style="v" sid="EZK 31:11" />इजी बजा ते मैं यहोवा परमेशरे ये देवदारो रा डाल़<note caller="+" style="f"><char style="fr" closed="false">31:11 </char><char style="fq" closed="false">देवदारो रा डाल़ </char><char style="ft" closed="false">परदान </char></note> देशो रे राजे रे कब्जे दे करिता। तिने एसखे एसरे पापा रे मुताबिक सजा दित्ती। ईंयाँ मैं ये बारे करिता। <verse eid="EZK 31:11" /><verse number="12" style="v" sid="EZK 31:12" />परदेशी, जो जातिया बीचे खतरनाक लोक ए, तिना से बाडी की छाडी देणा, तेसरी डाल़िया पाह्ड़ा पाँदे ओर सब तराईया रे सेटी देणियां ओर तेसरी पाँगटिया देशो रे सबी नाल़ेया रे टूटी की पड़िया री रणियां ओर सबी जातिया रे लोक तेसरी छांयी खे छाडी की चली जाणे। <verse eid="EZK 31:12" /><verse number="13" style="v" sid="EZK 31:13" />तेस टल़े रे डाल़ो पाँदे सर्गो रे सब पंछी बसेरा करोए ओर तेसरी पाँगटिया पाँदे मैदानो रे सारे जानवर रओए। <verse eid="EZK 31:13" /><verse number="14" style="v" sid="EZK 31:14" />ये इजी री खातर ऊआ ताकि जो डाल़ पाणिए रे कनारे लगी रे, सेयो आपणी ऊचाई नि बढ़ाओ, ना आपणी चूँडी बादल़ो तक पऊँचाओ ओर तिना बीचा ते जो पाणिए रिया बजा ते मजबूत ऊईगे रे सेयो ऊच्चे ऊणे रिया बजा ते सिर नि चको; कऊँकि सेयो बी सारे के सारे कब्रा रे पड़े रे माणूंआ जेड़े मौता रे वशो रे करी की अधलोको दे पाई देणे।”<verse eid="EZK 31:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="EZK 31:15" />परमेशर यहोवा ईंयाँ बोलोआ, “ये डाल़ मरीगा दा ए ओर आपणियां कब्रा दे चलीगा दा ए। जेबे एड़ा ऊआ, तो मैं लोक बऊत दु:खी करीते। मैं पाणिए रे चरने बन्द करीते। एबे बऊत पाणिए रे नाल़े नि रये। मैं लबानोनो रे पाह्ड़ काल़े करीते। बणो रे सारे डाल़ सूकी गे दे। <verse eid="EZK 31:15" /><verse number="16" style="v" sid="EZK 31:16" />जेबे मैं से कब्रा रे पड़े रे माणूंआ गे अधलोको रे सेटी ता, तेबे तेसरे टल़ने री आवाज सुणी की जातिया-जातिया रे लोक डरी गे ओर अदनो रे बगीचे रे सारे डाल़, मतलब लबानोनो रे खरे-खरे डाल़े, जितणेया खे तेसते पाणी मिलो था, तिना सबी खे अधलोको रे शान्ति मिली। <verse eid="EZK 31:16" /><verse number="17" style="v" sid="EZK 31:17" />सेयो बी तेस साथे तलवारी साथे मरे रे लोका गे अधलोको रे उतरी गे, मतलब सेयो जो तेसरी तागत थे ओर जातिया-जातिया रे बीचे तेसरी छांयी रे रओ थे। <verse eid="EZK 31:17" /><verse number="18" style="v" sid="EZK 31:18" />ओ मिस्र, महिमा ओर बडयाईया रे बारे दे अदनो रे बगीचे रे डाल़ा बीचा ते तूँ केस जेड़ा ए? तूँ तो अदनो रे बाकी डाल़ा साथे अधलोको रे उतारना ओर बिना खतना कित्ते रे लोका बीचे तलवारी साथे लड़ाईया दे मरे रे लोका बीचे पड़ेया दा रणा। फिरौन आपणे नौकरा समेत एड़ा ई ऊणा, परमेशर यहोवे री येई बाणी ए।”<verse eid="EZK 31:18" /></para>
  <chapter eid="EZK 31" />
  <chapter number="32" style="c" sid="EZK 32" />
  <para style="s">फिरौन ओर मिस्र देशो रिया तँईं शोग</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 32:1" />म्हारे गुलामिया दे गये रे बारूए सालो रे बारूए मीन्ने रे पईले दिने यहोवे रा ये सन्देश माखे फेर मिलेया, <verse eid="EZK 32:1" /><verse number="2" style="v" sid="EZK 32:2" />“ओ नाश ऊणे वाल़े माणूंआ, मिस्रो रे राजा फिरौनो रे बारे दे शोगो रा गाणा बणाई की तेसखे सुणा, जातिया-जातिया दे तेरी उपमा जवान शेरो साथे दित्ती थी, पर तूँ समुद्रो रे मगरमच्छो जेड़ा ए; तुसे पाणिए खे आपणे पैरा साथे गाऊदल़ा करोए। तुसा रिया नदिया रा पाणी गन्दा ऊई जाओआ।” <verse eid="EZK 32:2" /><verse number="3" style="v" sid="EZK 32:3" />परमेशर यहोवा ईंयाँ बोलोआ, “मां बऊत सारी जातिया री सभा रे जरीये तां पाँदे आपणा जाल़ बछाणा ओर तिना तूँ मेरे बड़े जाल़ो रे खींजी लणा। <verse eid="EZK 32:3" /><verse number="4" style="v" sid="EZK 32:4" />तेबे मां तूँ जमीना दे छाडणा ओर मैदानो दे सेटी की मां तेरा मास सारी तरतिया रे बणो रे जानवर ओर पंछिया खे खाणे खे देणा। <verse eid="EZK 32:4" /><verse number="5" style="v" sid="EZK 32:5" />मां तेरा मास पाह्ड़ो पाँदे बखेरी देणा ओर काअटिया तुसा रिया आड्डिया ते परी देणियां। <verse eid="EZK 32:5" /><verse number="6" style="v" sid="EZK 32:6" />जेस देशो दे तूँ तैरेया, तेथो रे पाह्ड़ मां तेरे खूनो साथे सींजणे ओर तिना रे नाल़े तेरे खूनो साथे परी जाणे। <verse eid="EZK 32:6" /><verse number="7" style="v" sid="EZK 32:7" />जेस बखते आऊँ तेरा नाश करने लगूँगा, तेस बखते मां सर्ग टखी देणा ओर तारे तूँदल़े करी देणे; मां सूरज बादल़ो रे लकोई देणा ओर चाँदो आपणा प्रयासा नि देणा।<note caller="+" style="f"><char style="fr" closed="false">32:7 </char><char style="ft" closed="false">मत्ती 24:29, योए. 2:31</char></note> <verse eid="EZK 32:7" /><verse number="8" style="v" sid="EZK 32:8" />सर्गो रे जितणी बी प्रयासा देणे वाल़िया जोतिया ए, सेयो सब मां तेरी बजा ते तुँदल़िया करी देणियां, ओर तेरे देशो दे नेरा करी देणा, परमेशर यहोवे री येई बाणी ए।”<verse eid="EZK 32:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="EZK 32:9" />जेबे मां तेरे नाशो रा समाचार जातिया-जातिया बीचे ओर तेरे अणजाणे देशो दे फैलाणा, तेबे बड़े-बड़े लोका रे मनो दे डर पैदा ऊई जाणा। <verse eid="EZK 32:9" /><verse number="10" style="v" sid="EZK 32:10" />मां तुसा साथे जो ऊईरा, तेतेरिया बजा ते बऊत जातिया रे लोक डराई देणे, ओर जेबे मां तिना सामणे आपणी तलवार चलाणी, जेबे परमेशरो मिस्र ओर तेसरा राजा नाश करने तेतेरिया बजा ते तिना रे राजा डरी जाणे ओर काँबी जाणे। जेस बखते तुसे नाश ऊणे, सेयो सब काँबी जाणे, ओर डरने की केथी सेयो बी मरी नि जाओ। <verse eid="EZK 32:10" /><verse number="11" style="v" sid="EZK 32:11" />कऊँकि ओ मिस्र परमेशर यहोवा ताखे ईंयाँ बोलोआ, “बाबेलो रे राजे री तलवार तां पाँदे चलणी। <verse eid="EZK 32:11" /><verse number="12" style="v" sid="EZK 32:12" />मां तेरे सिपाई एड़े शूरवीरा री तलवारी साथे रूड़ाणे जो सबी जातिया बीचे खतरनाक ए। तिना मिस्रो रे लोका रा कमण्ड तोड़ना ओर तिना रे सारे सिपाईया रा नाश करी देणा। <verse eid="EZK 32:12" /><verse number="13" style="v" sid="EZK 32:13" />मां तेसरे सारे डांगर तेथो रे नदिया रे कनारेया पाँदा ते नाश करी देणे ओर बादो ते सेयो तलाब ना तो माणूंआ रे पैरा साथे ओर ना डांगरा रे खुरा सारे गाऊदल़े ऊणे। <verse eid="EZK 32:13" /><verse number="14" style="v" sid="EZK 32:14" />तेबे मां मिस्रो रा पाणी साफ करी देणा ओर तिना री नदिया जैतूनो रे तेलो जेड़िया बह्ईणियां, परमेशर यहोवे री येई बाणी ए।” <verse eid="EZK 32:14" /><verse number="15" style="v" sid="EZK 32:15" />जेबे मां मिस्र देश उजाड़ी देणा ओर जेते साथे से फरेया राए, से खाली करी देणा ओर मां जेबे तेथो रे रणे वाल़े सब काई देणे, तेबे मिस्रिया खे पता लगी जाणा कि आऊँ ई यहोवा ए। <verse eid="EZK 32:15" /><verse number="16" style="v" sid="EZK 32:16" />लोका खे शोग मनाणे खे शोगो रा गाणा येई ए; जातिया-जातिया री जवाणसा ये गाणा; मिस्र ओर तेथो रे सारे सिपाईया रे बारे दे येई शोगो रा गीत गाणा, परमेशर यहोवे री येई बाणी ए।<verse eid="EZK 32:16" /></para>
  <para style="s">मुड़देया रा संसार</para>
  <para style="p">
    <verse number="17" style="v" sid="EZK 32:17" />तेबे आसा रा बन्दिया रे रूपो दे बेबीलोनो दे गुलाम दे बारूए सालो रे पईले मीन्ने रे पन्द्रुए दिने यहोवे रा ये सन्देश फेर माखे मिलेया, <verse eid="EZK 32:17" /><verse number="18" style="v" sid="EZK 32:18" />“ओ नाश ऊणे वाल़े माणूंआ, मिस्रो रे नौकरा खे हाय-हाय कर ओर तेसखे प्रतापी जातिया रे लोका समेत कब्रा रे दबाए रे लोका गे अधलोको दे उतार। <verse eid="EZK 32:18" /><verse number="19" style="v" sid="EZK 32:19" />मिस्रिया ते बोल तू केस ते बांका ए? तुसे मरे दे लोका री दुनिया दे जाणे ओर बिना खतने रे पापिया बीचे पड़े दे रणे। <verse eid="EZK 32:19" /><verse number="20" style="v" sid="EZK 32:20" />सेयो तलवारी साथे मरे रे लोका बीचे पड़ने, तिना रिया तँईं तलवार ठराई राखी; इजी री खातर मिस्रो खे तेसरे सारे लोका समेत कसिटी की लई जाओ। <verse eid="EZK 32:20" /><verse number="21" style="v" sid="EZK 32:21" />सिपाईया रे परदाना तेस साथे ओर तेसरे मतदगारा साथे अधलोको दे गल्ला करनिया; सेयो बिना खतना कित्ते रे लोक तेती तलवारी साथे मरी की पड़ी रे।”<verse eid="EZK 32:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="EZK 32:22" />आपणी सारी सेना रे सिपाईया समेत अश्शूर बी तेती ए, तेसरी कब्रा तेसरे चऊँ कनारे ए; सारे के सारे तलवारी साथे काई राखे। <verse eid="EZK 32:22" /><verse number="23" style="v" sid="EZK 32:23" />तेसरी कब्रा गड्डेया रे कूणे रे बणी रिया ओर तेसरी कब्रा रे चऊँ कनारे तेसरे सिपाई ए, सेयो सारे के सारे तलवारी साथे मरी की पड़ी रे। जो तरतिया पाँदे जिऊँदे लोका खे डराओ थे, <verse eid="EZK 32:23" /><verse number="24" style="v" sid="EZK 32:24" />तेती एलाम ए, ओर तेसरी कब्रा रे चऊँ कनारे तेसरे सारे सिपाई ए; सेयो सारे के सारे तलवारी साथे मारी ते दे, जो बिना खतने ते अधलोको दे उतरी गे दे; सेयो तरतिया पाँदे जिऊँदे लोका खे डराओ थे, पर एबे कब्रा दे ओर गढ़े देया साथे तिना रे मुंए पाँदे बी उदासी छायी री। <verse eid="EZK 32:24" /><verse number="25" style="v" sid="EZK 32:25" />एलाम लड़ाईया दे काये दे लोका बीचे लेटीगा। तेसरी कब्रा तेसरे चऊँ कनारे ए, सेयो सारे के सारे बिना खतना कित्ते रे तलवारी साथे काई ते दे; तिने तरतिया पाँदे जिऊँदे लोका दे डर फैलाया था, पर एबे कब्रा दे ओर दबाया देया साथे तिना रे मुंए पाँदे बी उदासी छायी री ओर सेयो मेरे रेया बीचे राखी राखे। <verse eid="EZK 32:25" /><verse number="26" style="v" sid="EZK 32:26" />मेशेक ओर तूबल तेती ए, ओर तिना रे सबी सिपाईया रिया कब्रा चऊँ कनारे ए। सेयो सारे के सारे बिना खतना रे ए, सब लड़ाईया दे कायी राखे। फेर बी एकी बार तिने जिऊँदे लोक बऊत डराईते दे थे। <verse eid="EZK 32:26" /><verse number="27" style="v" sid="EZK 32:27" />सेओ तिना बिना खतना कित्ते रे सिपाईया साथे पड़े दे नि रणे, जो तिना रे अथियारा साथे दबाईते दे, तेती तिने आपणियां तलवारा तिना रे सिरो निठे राखी राखिया। जेबे सेयो ईम्मती वाल़े लोक जिऊँदे थे, तिने लोका बीचे बऊत डर पैदा करिता था। <verse eid="EZK 32:27" /><verse number="28" style="v" sid="EZK 32:28" />इजी री खातर ओ मिस्रो रे राजा, मां तूँ कायी देणा ओर तूँ बी तिना बिना खतने रे मरे दे लोका री कब्रा साथे पड़ेया दा रणा, जो परमेशरो खे नि मानदे। <verse eid="EZK 32:28" /><verse number="29" style="v" sid="EZK 32:29" />तेती एदोम ओर तेसरे राजा ओर तेसरे सारे परदान, जो पराक्रमी ऊई की बी तलवारी साथे मरे रेया साथे राखी राखे; लड़ाईया दे काये दे बिना खतना कित्ते रे लोका साथे सेयो बी पड़े दे रणे। <verse eid="EZK 32:29" /><verse number="30" style="v" sid="EZK 32:30" />मरे दे लोका रिया दुनिया दे उत्तर दिशा दे इस्राएलो रे सारे परदान ओर सारे सिदोनी बीए, जो मरे रेया साथे उतरी गे; तिने आपणे पराक्रमो साथे डर पैदा कित्तेया था, पर एबे सेयो शर्मिंदा ऊए ओर तलवारी साथे ओर मरे रेया साथे सेयो बी बिना खतना कित्ते रे पड़ी रे ओर कब्रा रे बाकी दबाए रेया साथे तिना रे मुंए पाँदे बी उदासी छायी री। <verse eid="EZK 32:30" /><verse number="31" style="v" sid="EZK 32:31" />इना खे देखी की फिरौनो खे बी आपणे सिपाईया समेत शान्ति मिलणी, आ, फिरौन ओर तेसरी सारी सेना जो तलवारी साथे मरी, परमेशर यहोवे री येई बाणी ए। <verse eid="EZK 32:31" /><verse number="32" style="v" sid="EZK 32:32" />कऊँकि मैं तेसरी बजा ते तरतिया पाँदे जिऊँदे लोका दे डर पैदा कित्तेया था; इजी री खातर से लड़ाईया दे तलवारे की काये दे सबी सिपाईया ओर जो मरी गे रे तिना समेत बिना खतना कित्ते रे लोका बीचे लटयाल़ना, परमेशर यहोवे री येई बाणी ए।<verse eid="EZK 32:32" /></para>
  <para style="b" />
  <chapter eid="EZK 32" />
  <chapter number="33" style="c" sid="EZK 33" />
  <para style="s">पईरेदार ओर तिना रा समाचार</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 33:1" />यहोवे रा ये सन्देश माखे फेर मिलेया, <verse eid="EZK 33:1" /><verse number="2" style="v" sid="EZK 33:2" />“ओ नाश ऊणे वाल़े माणूंआ, आपणे इस्राएली लोका खे बोल, कि जेबे आऊँ केसी देशो पाँदे तिना रे दुश्मणा खे लड़ाई करने खे ल्याऊँआ ति क्या ओआ? तेस देशो रे लोक आपणेया लोका बीचा ते केसी खे आपणा पईरेदार बणाई लओए। <verse eid="EZK 33:2" /><verse number="3" style="v" sid="EZK 33:3" />तेबे सेयो पईरेदार ये देखी की कि एस देशो रे दुश्मण अमला करने वाल़े ए, नरसिंगा बजाई की लोका खे बताई देयो, <verse eid="EZK 33:3" /><verse number="4" style="v" sid="EZK 33:4" />तेबे जो कोई रड़सिंगे री आवाज सुणी की सावधान नि ओ ओर तलवारी साथे मरी जाओ, तेसरा खून तेसरे ई सिरो पाँदे पड़ना। <verse eid="EZK 33:4" /><verse number="5" style="v" sid="EZK 33:5" />तिने रड़सिंगे री आवाज सुणी, पर सावधान नि ऊआ, इजी री खातर तेसरा खून तेसखे ई लगणा। पर जे से सावधान ऊई जांदा, तो आपणे प्राण बचाई सको था।<note caller="+" style="f"><char style="fr" closed="false">33:5 </char><char style="ft" closed="false">मत्ती 27:25</char></note> <verse eid="EZK 33:5" /><verse number="6" style="v" sid="EZK 33:6" />पर जे पईरेदार ये देखी की कि अमला ऊणे वाल़ा ए, चतौणिया खे नरसिंगा बजाई की लोका खे नि बताओगा ओर जेबे लड़ाईया दे तलवार चलोगी तेबे तिना बीचा ते कोई मरी जाओ, तो से तो आपणे पापो रे फसेया रा मरी जाणा, पर तेसरे खूनो रा लेखा मां पईरेदारो तेई लणा।” <verse eid="EZK 33:6" /><verse number="7" style="v" sid="EZK 33:7" />इजी री खातर ओ नाश ऊणे वाल़े माणूंआ, मैं तूँ इस्राएलो रे कराने रा पईरेदार ठराईता रा, तूँ मेरे मुंए ते वचन सुणी-सुणी की तिना खे मेरी तरफा ते सावधान करी दे। <verse eid="EZK 33:7" /><verse number="8" style="v" sid="EZK 33:8" />जे आऊँ दुष्टो खे बोलूँ, “ओ दुष्ट, तूँ जरूर मरना, तेबे जे तूँ तेसखे तेसरी बाटा रे बारे दे सावधान नि करे, तो से दुष्ट आपणे पापो रे फसेया रा मरना, पर तेसरे खूनो रा लेखा मां तांते ई लणा। <verse eid="EZK 33:8" /><verse number="9" style="v" sid="EZK 33:9" />पर जे तूँ दुष्टो खे तेसरी बाटा रे बारे दे सावधान करे कि आपणे बुरे कामो ते फिर ओर से फिरो नि, तो से तो आपणे पापो रे फसेया रा मरी जाणा, पर तां आपणे प्राण बचाई लणे।”<verse eid="EZK 33:9" /></para>
  <para style="s">परमेशर लोका खे खत्म नि करना चाँदा</para>
  <para style="p">
    <verse number="10" style="v" sid="EZK 33:10" />फेर ओ नाश ऊणे वाल़े माणूंआ, इस्राएलो रे लोका खे ईंयाँ बोल, “तुसे लोक ईंयाँ पूछोए, म्हारे पाप ओर पापो रा पार आसा पाँदे लदेया राए ओर आसे तेतेरी बजा ते नाश ऊणे लगी रे, आसे किंयाँ जिऊँदे रणे?” <verse eid="EZK 33:10" /><verse number="11" style="v" sid="EZK 33:11" />तेबे तिना खे बोल, “परमेशर यहोवा ईंयाँ बोलोआ, मेरी जिन्दगिया री कसम, आऊँ दुष्टो रे मरने ते कोई खुश नि ऊँदा, पर एते ते खुश रऊँआ कि दुष्ट आपणे बुरे कामो ते फिरी की जिऊँदा रओ। ओ इस्राएलो रे कराने, तुसे आपणे बुरे कामा ते फिरो, ताकि तुसे मरो नि?” <verse eid="EZK 33:11" /><verse number="12" style="v" sid="EZK 33:12" />ओ माणूंआ, “आपणे लोका खे ईंयाँ बोल, जेबे तर्मी माणूं पाप करो, तेबे तेसरा तर्म तेसखे बचाई नि सकदा ओर दुष्टो री दुष्टता जो बी ओ, जेबे से तेते ते फिरी जाओ, तो तेसरी बजा ते से टल़ना नि ओर तर्मी माणूं जेबे पाप करो, तेबे आपणे तर्मो रिया बजा ते जिऊँदा नि रणा।” <verse eid="EZK 33:12" /><verse number="13" style="v" sid="EZK 33:13" />जे आऊँ तर्मिये खे बोलूँ कि तूँ जरूर जिऊँदा रणा ओर से आपणे तर्मो पाँदे परोसा राखी की बुरे काम करने लगोगा, तेबे तेसरे तर्मो रे कोई बी काम याद नि करे जाणे, जो बुरे काम तिने करी राखे ओ, से तिदे ई फसेया रा मरी जाणा। <verse eid="EZK 33:13" /><verse number="14" style="v" sid="EZK 33:14" />तेबे जे आऊँ दुष्टो खे बोलूँ, तूँ जरूर मरना ओर से आपणे पापो ते फिरी की न्याय ओर तर्मो रे काम करने लगो, <verse eid="EZK 33:14" /><verse number="15" style="v" sid="EZK 33:15" />उदारणो खे, जे से कर्जा देणे रिया तँईं तेतेरे बदले लई दी चीजा खे वापस करी देयो, या जो तिने चोरी राखेया था तिजी खे वापस करी देयो, जे से पाप करना बन्द करी देयोआ ओर जीवन देणे वाल़िया बिधिया खे मानोआ, तो से नि मरना; से जरूर जिऊँदा रणा। <verse eid="EZK 33:15" /><verse number="16" style="v" sid="EZK 33:16" />जितणे पाप तिने करी राखे ऊणे, तिना बीचा ते कोई बी याद नि करेया जाणा; तिने न्याय ओर तर्मो रे काम कित्ते ओर से जरूर जिऊँदा रणा। <verse eid="EZK 33:16" /><verse number="17" style="v" sid="EZK 33:17" />तेबे बी तुसा रे लोक मां पाँदे दोष लगाओए, प्रभुए री बाट ठीक नि; पर तिना री बाट ठीक नि ए। <verse eid="EZK 33:17" /><verse number="18" style="v" sid="EZK 33:18" />जेबे तर्मी आपणे तर्मो ते फिरी की बुरे काम करने लगो, तेबे जरूर से तिदे फसेया रा ई मरी जाणा। <verse eid="EZK 33:18" /><verse number="19" style="v" sid="EZK 33:19" />जेबे दुष्ट आपणी दुष्टता ते फिरी की न्याय ओर तर्मो रे काम करने लगोगा, तेबे से तिना कामो रिया बजा ते जिऊँदा रणा। <verse eid="EZK 33:19" /><verse number="20" style="v" sid="EZK 33:20" />ओ इस्राएलियो, तेबे बी तुसे बोलोए, “कि प्रभुए री चाल ठीक नि। ओ इस्राएलो रे कराने, मां हर एक माणूंए रा न्याय तेसरे कामो रे मुताबिक ई करना।”<verse eid="EZK 33:20" /></para>
  <para style="s">यरूशलेमो रा नाश</para>
  <para style="p">
    <verse number="21" style="v" sid="EZK 33:21" />तेबे म्हारी गुलामिया रे ग्यारुए सालो रे दसुए मीन्ने रे पाँजुए दिने, एक माणूं जो यरूशलेम शईरो ते नठी की बचीगा था, से मांगे आई की बोलणे लगेया, “यरूशलेम शईर लई ला दा।” <verse eid="EZK 33:21" /><verse number="22" style="v" sid="EZK 33:22" />तेस नठी की आऊणे वाल़े माणूंए ते पईले साँजा खे यहोवे री शक्ति मां पाँदे ऊई थी ओर प्यागा तक, मतलब तेस माणूंए रे आऊणे तक तिने मेरा मूँ खोली ता, तेबे मेरा मूँ खुला ई रया ओर आऊँ फेर चुप नि रया।<verse eid="EZK 33:22" /></para>
  <para style="s">लोका रा पाप</para>
  <para style="p">
    <verse number="23" style="v" sid="EZK 33:23" />तेबे यहोवे रा ये सन्देश माखे मिलेया, <verse eid="EZK 33:23" /><verse number="24" style="v" sid="EZK 33:24" />“ओ नाश ऊणे वाल़े माणूंआ, इस्राएलो री जमीना दे तिना खण्डहरो दे रणे वाल़े ईंयाँ बोलोए, अब्राहम एक ई माणूं था, तेबे बी देशो रा अधिकारी ऊआ, पर आसे लोक बऊत सारे ए, इजी री खातर देश पक्का म्हारे ई कब्जे दे देई राखेया।” <verse eid="EZK 33:24" /><verse number="25" style="v" sid="EZK 33:25" />इजी बजा ते तूँ तिना खे बोल, परमेशर यहोवा ईंयाँ बोलोआ, “तुसे लोक तो मासो खे खूनो समेत खाओए ओर आपणी मूर्तिया री आराधना करोए ओर अत्या करोए, तेबे क्या तुसे लोक तेस देशो रे अधिकारी रयी सकोए? <verse eid="EZK 33:25" /><verse number="26" style="v" sid="EZK 33:26" />तुसे आपणी पसन्दा रिया चीजा आसिल करने रिया तँईं लड़ाई-चगड़े रा इस्तेमाल करोए। तुसे बुरे काम करोए, तुसे ओरी मर्दा रिया जवाणसा साथे बुरा काम करोए। इजी रिया बजा ते तुसे इस्राएलो री जमीना रे अक्कदार नि ऊणे।” <verse eid="EZK 33:26" /><verse number="27" style="v" sid="EZK 33:27" />तूँ तिना खे ये बोल, परमेशर यहोवा ईंयाँ बोलोआ, “मेरी जिन्दगिया री कसम, बिना कोई शको ते जो लोक खण्डहरो रे रओए, सेयो तलवारी साथे मरने ओर मां डोरूआ दे रणे वाल़े बणो रे जानवरा ते खुल़ाई देणे। बमारिया रिया बजा ते सेयो मरने, जो मजबूत कअरा दे ओर गुफा दे रओए।<note caller="+" style="f"><char style="fr" closed="false">33:27 </char><char style="ft" closed="false">यिर्म. 42:22</char></note> <verse eid="EZK 33:27" /><verse number="28" style="v" sid="EZK 33:28" />मां से देश उजाड़ ई उजाड़ करी देणा ओर तेथो रा सामर्थी ऊणे रा कमण्ड चली जाणा ओर इस्राएलो रे पाह्ड़ एड़े उजड़ने कि तिना पाँदे ऊई की कोई नि चलणा। <verse eid="EZK 33:28" /><verse number="29" style="v" sid="EZK 33:29" />इजी री खातर जेबे आऊँ तिना लोका रे कित्ते रे सारे घिनौने कामो रिया बजा ते तेस देशो खे उजाड़ी देऊँ, तेबे तिना खे पता लगी जाणा कि आऊँ ई यहोवा ए।”<verse eid="EZK 33:29" /></para>
  <para style="s">वचन सुणना ओर तिना पाँदे नि चलणा</para>
  <para style="p">
    <verse number="30" style="v" sid="EZK 33:30" />यहोवा बोलोआ, “ओ नाश ऊणे वाल़े माणूंआ, तेरे लोक कांदा गे ओर कअरो रे द्वारा गे तेरे बारे दे गल्ला बणाओए ओर एकी-दूजे खे बोलोए, आओ, सुणो, यहोवे रिया तरफा ते कुण जा वचन निकल़ोआ।” <verse eid="EZK 33:30" /><verse number="31" style="v" sid="EZK 33:31" />सेयो प्रजा जेड़े तांगे आओए ओर मेरी प्रजा बणी की तां सामणे बैठी की तेरे वचन सुणोए, पर सेयो तिना पाँदे चलदे नि, मुंए ते तो सेयो बऊत प्यार दखाओए, पर तिना रा मन लाल़चो रेई लगेया रा रओआ। <verse eid="EZK 33:31" /><verse number="32" style="v" sid="EZK 33:32" />तूँ तिना री नजरा रे प्यारो रे मीठे गीत गाणे वाल़े ओर बजाणे वाल़े जेड़ा ठईरी रा, कऊँकि सेयो तेरे वचन सुणो ते आए, पर तिना पाँदे चलदे नि। <verse eid="EZK 33:32" /><verse number="33" style="v" sid="EZK 33:33" />इजी री खातर जेबे यो खतरनाक गल्ल ऊई जाणिया, तेबे जरूर बीतणी, तेबे मेरे लोका खे पता लगी जाणा कि आसा बीचे एक भविष्यबक्ता आया था।<verse eid="EZK 33:33" /></para>
  <chapter eid="EZK 33" />
  <chapter number="34" style="c" sid="EZK 34" />
  <para style="s">इस्राएलो रे गवाल़े</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 34:1" />प्रभुए रा ये सन्देश फेर माखे मिलेया। प्रभुए माखे बोलेया, <verse eid="EZK 34:1" /><verse number="2" style="v" sid="EZK 34:2" />“ओ नाश ऊणे वाल़े माणूंआ, इस्राएलो रे परदाना रे खलाफ भविष्यबाणी करी की तिना परदाना खे बोल, परमेशर यहोवा ईंयाँ बोलोआ: लाणत ए इस्राएलो रे ग्वाल़ेया पाँदे! तुसे जो आपणा त्यान तो राखोए, पर पेडा री देखपाल़ नि करदे। <verse eid="EZK 34:2" /><verse number="3" style="v" sid="EZK 34:3" />तुसे तिना रा दूद पियोए, ऊना रे बणे दे टाल़े पईनोए, ओर बढ़िया पेडा खे कायी की तिना रा मास खाओए। पर तुसे कदी बी पेडा री देखपाल़ नि करदे।<note caller="+" style="f"><char style="fr" closed="false">34:3 </char><char style="ft" closed="false">जक. 11:16 </char></note> <verse eid="EZK 34:3" /><verse number="4" style="v" sid="EZK 34:4" />तुसे बमार पेडा री देख-भाल़ नि कित्ती, ना तिना रे जख्मा पाँदे कोई त्यान दित्तेया, ना निकयाल़ी रिया वापस ल्याईया, ना राची रिया टोल़िया, पर तुसे तागत ओर जबरदस्ती अक्क चलाई राखेया। <verse eid="EZK 34:4" /><verse number="5" style="v" sid="EZK 34:5" />सेयो गवाल़े ना ऊणे रिया बजा ते रूल़ी गिया ओर सारे बणो रे जानवरे सेयो कायी की खाई तिया। <verse eid="EZK 34:5" /><verse number="6" style="v" sid="EZK 34:6" />इजी री खातर मेरी पेडा-बाकरिया ऊच्चे पाह्ड़ा ओर पाह्ड़िया पाँदे पटकणे लगी रिया। सेयो सारिया तरतिया पाँदे ओरे-पोरे ऊईगी रिया ए, ओर सेयो किने पनि टोल़िया ओर ना ई टोल़ने री कोशिश कित्ती।” <verse eid="EZK 34:6" /><verse number="7" style="v" sid="EZK 34:7" />इजी बजा ते ओ ग्वाल़ेयो, यहोवे रा वचन सुणो: <verse eid="EZK 34:7" /><verse number="8" style="v" sid="EZK 34:8" />परमेशर यहोवा ईंयाँ बोलोआ, “आऊँ जिऊँदा परमेशर ए, इजी री खातर तुसा खे मेरी गल्ल सुणनी चाईयो। मेरी पेडा-बाकरिया पाँदे बणो रे जानवरे अमला करी राखेया, जिने सेयो कायी तिया ओर खाई लईया, कऊँकि तिना रा कोई ग्वाल़ा नि था। मेरे ग्वाल़ेया तिना खे टोल़ने री कोशिश नि कित्ती। सेयो पेडा री नि, बल्कि आपणी ई देखपाल़ करने लगी रे थे, <verse eid="EZK 34:8" /><verse number="9" style="v" sid="EZK 34:9" />इजी बजा ते ओ ग्वाल़ेयो, परमेशरो रा ये वचन सुणो, <verse eid="EZK 34:9" /><verse number="10" style="v" sid="EZK 34:10" />परमेशर यहोवा ईंयाँ बोलोआ, देखो, आऊँ ग्वाल़ेया रे खलाफ ए ओर मां तिना ते आपणी पेडा-बाकरिया रा लेखा लणा ओर सेयो फेर तिना खे चराणे नि देणियां; सेयो फेर आपणा-आपणा पेट नि परी सकणियां। मां आपणियां पेडा-बाकरिया तिना रे मुंए ते छुड़ाई की ल्याऊणिया, ताकि आगो खे सेयो तिना खे नि खाओ।”<verse eid="EZK 34:10" /></para>
  <para style="s">ठीक ग्वाल़ा</para>
  <para style="p">
    <verse number="11" style="v" sid="EZK 34:11" />कऊँकि परमेशर यहोवा ईंयाँ बोलोआ, “देखो, मां आपू आपणियां पेडा-बाकरिया री खबर-सम्बाल़ लणी ओर सेयो टोल़निया।<note caller="+" style="f"><char style="fr" closed="false">34:11 </char><char style="ft" closed="false">लूक. 19:10 </char></note> <verse eid="EZK 34:11" /><verse number="12" style="v" sid="EZK 34:12" />जिंयाँ ग्वाल़ा आपणियां पेडा-बाकरिया बीचा ते राची रिया खे फेर आपणे चूण्डो रे कट्ठा करोआ, तिंयाँ ई मां बी आपणियां पेडा-बाकरिया कट्ठिया करनिया; मां सेयो तिना सबी जगा ते निकयाल़ी की ल्याऊणिया, जेती सेयो बादल़ ओर अन्दकूप न्हेरे रिया बजा ते तितर-बित्तर ऊई गिया थिया। <verse eid="EZK 34:12" /><verse number="13" style="v" sid="EZK 34:13" />मां सेयो देश-देशो रे लोका बीचा ते निकयाल़निया ओर सेयो देश-देशो ते कट्ठिया करनिया ओर सेयो तिना री आपणी जमीना दे लई आऊणियां ओर मां सेयो इस्राएलो रे पाह्ड़ो पाँदे, नाल़ेया दे ओर तेस देशो रे सबी बसी री जगा दे चराणिया। <verse eid="EZK 34:13" /><verse number="14" style="v" sid="EZK 34:14" />मां सेयो अच्छी चराईया दे ओर ऊच्चे-ऊच्चे पाह्ड़ो दे चराणिया, तेती सेयो अच्छी अरयालिया दे बैठेया करनिया ओर इस्राएलो रे पाह्ड़ो पाँदे खरी-खरी काआ चरेया करनी। <verse eid="EZK 34:14" /><verse number="15" style="v" sid="EZK 34:15" />आऊँ आपू ई आपणी पेडा-बाकरिया रा ग्वाल़ा ऊणा ओर मां तिना खे शान्तिया साथे रणे खे जगा देणी, परमेशर यहोवे री येई बाणी ए।<note caller="+" style="f"><char style="fr" closed="false">34:15 </char><char style="ft" closed="false">पज. 23:1-2 </char></note> <verse eid="EZK 34:15" /><verse number="16" style="v" sid="EZK 34:16" />मां राची रिया पेडा टोल़निया ओर निकयाल़ी रिया वापस ल्याऊणिया, जो काईल ऊणिया तिना रे जख्म बानणे, ओर बमार ठीक करनिया ओर जो मोटिया ओर तागतबर ए सेयो मां नाश करी देणियां, मां तिना री चरवाई न्याय साथे करनी।” <verse eid="EZK 34:16" /><verse number="17" style="v" sid="EZK 34:17" />ओ मेरे लोको, तुसा खे परमेशर यहोवा ईंयाँ बोलोआ, “देखो, आऊँ पेडा-पेडा बीचे, खाडूआ ओर बाकरेया बीचे न्याय करूँआ।<note caller="+" style="f"><char style="fr" closed="false">34:17 </char><char style="ft" closed="false">मत्ती 25:32 </char></note> <verse eid="EZK 34:17" /><verse number="18" style="v" sid="EZK 34:18" />क्या तुसा खे ये छोटी गल्ल लगोई कि तुसे अच्छी चराई चरो ओर बाकी चराईया खे आपणे पैरा निठे माँडो ओर क्या तुसा खे ये छोटी गल्ल लगोई कि तुसे साफ पाणी पियो ओर बाकी पाणिए खे आपणे पैरा साथे गाऊदल़ा करो? <verse eid="EZK 34:18" /><verse number="19" style="v" sid="EZK 34:19" />क्या मेरी पेडा-बाकरिया खे से काआ चरना पड़ना जो तुसे आपणे पैरे की केसी राखेया ओर तुसा रे पैरा निठे गाऊदल़ा कित्तेया रा पाणी पीणा पड़ना?” <verse eid="EZK 34:19" /><verse number="20" style="v" sid="EZK 34:20" />इजी बजा ते परमेशर यहोवा तिना खे ईंयाँ बोलोआ, “देखो, मां आपू मोटी ओर पतल़ी पेडा-बाकरिया बीचे न्याय करना।<note caller="+" style="f"><char style="fr" closed="false">34:20 </char><char style="ft" closed="false">तागतबर परदान ओर कमजोर परदान </char></note> <verse eid="EZK 34:20" /><verse number="21" style="v" sid="EZK 34:21" />तुसे जो सबी बमारा खे बाँयी ओर फरकुआ साथे एथो तक ताका देओए ओर सींगो साथे एथो तक मारोए कि सेयो तित्तर-बित्तर ऊई जाओईया, <verse eid="EZK 34:21" /><verse number="22" style="v" sid="EZK 34:22" />इजी बजा ते मां आपणियां पेडा-बाकरिया बचाणियां, सेयो फेर नि लूटणियां ओर मां पेडा-पेडा ओर बाकरी-बाकरिया बीचे न्याय करना। <verse eid="EZK 34:22" /><verse number="23" style="v" sid="EZK 34:23" />मां तिना पाँदे आपणे दास दाऊदो जेड़ा एक एड़ा ग्वाल़ा ठईराणा, जेस सेयो चराणिया, से मेरा दास दाऊद ऊणा, तेस ई सेयो चराणिया ओर सेई तिना रा ग्वाल़ा ऊणा। <verse eid="EZK 34:23" /><verse number="24" style="v" sid="EZK 34:24" />आऊँ, यहोवा, तिना रा परमेशर ठईरना ओर मेरा दास दाऊद तिना बीचे परदान ऊणा; मैं परमेशरे ई ये बोली राखेया। <verse eid="EZK 34:24" /><verse number="25" style="v" sid="EZK 34:25" />मां आपणे लोका साथे शान्तिया री वाचा बानणी ओर दुष्ट जानवर देशो दे रणे नि देणे; तेबे सेयो जंगल़ो रे बिना डरे रणे ओर बणो दे सऊणे। <verse eid="EZK 34:25" /><verse number="26" style="v" sid="EZK 34:26" />मां सेयो ओर आपणी पाह्ड़िया रे नेड़े-तेड़े रिया जगा आशीष रिया बजा बनाणियां ओर मां बरखा रे बखतो दे बरखा करनिया, ओर से बरखा आशीर्वादो री बरखा ऊणी। <verse eid="EZK 34:26" /><verse number="27" style="v" sid="EZK 34:27" />मैदानो रे डाल़ फलणे ओर जमीना आपणी उपज उपजाणी ओर सेयो आपणे देशो रे बिना डरे रणे, जेबे मां तिना रा जूँगड़ा तोड़ी की तिना लोका रे आथो ते छुड़ाणा, जो तिना ते सेवा कराओए, तेबे तिना खे पता लगी जाणा कि आऊँ ई यहोवा ए। <verse eid="EZK 34:27" /><verse number="28" style="v" sid="EZK 34:28" />सेयो फेर जातिया-जातिया नि लुटणे ओर ना ई बणो रे डांगरा सेयो खाणे, सेयो बिना डरे रणे ओर सेयो केसी नि डराणे। <verse eid="EZK 34:28" /><verse number="29" style="v" sid="EZK 34:29" />मां तिना खे उपजाऊ बगीचा लगाणा ओर सेयो देशो रे फेर पूखे नि मरने ओर ना परदेशी जातिया रे लोका फेर तिना री निन्दा करनी। <verse eid="EZK 34:29" /><verse number="30" style="v" sid="EZK 34:30" />तिना खे पता लगी जाणा कि आऊँ परमेशर यहोवा, तिना साथे ए ओर सेयो जो इस्राएलो रे लोक ए, सेयो मेरी प्रजा ए, मां परमेशर यहोवे री येई बाणी ए। <verse eid="EZK 34:30" /><verse number="31" style="v" sid="EZK 34:31" />तुसे तो मेरी पेडा-बाकरिया, मेरी चराईया रिया पेडा-बाकरिया ए, तुसे तो माणूं ए ओर आऊँ तुसा रा परमेशर ए, परमेशर यहोवे री येई बाणी ए।”<verse eid="EZK 34:31" /></para>
  <chapter eid="EZK 34" />
  <chapter number="35" style="c" sid="EZK 35" />
  <para style="s">एदोमो खे परमेशरो री सजा</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 35:1" />यहोवे रा ये सन्देश माखे फेर मिलेया, <verse eid="EZK 35:1" /><verse number="2" style="v" sid="EZK 35:2" />“ओ नाश ऊणे वाल़े माणूंआ, आपणा मूँ सेईर पाह्ड़ो रिया तरफा खे करी की तेथो रे लोका रे खलाफ भविष्यबाणी कर।” <verse eid="EZK 35:2" /><verse number="3" style="v" sid="EZK 35:3" />ओर तिना खे बोल, परमेशर यहोवा ईंयाँ बोलोआ, “ओ सेईर पाह्ड़, आऊँ तेरे खलाफ ए; मां तुसा पाँदे अमला करना, ताकि तुसे रेगिस्तानो जेड़े बणी जाओ। <verse eid="EZK 35:3" /><verse number="4" style="v" sid="EZK 35:4" />मां तेरे शईर खण्डहर करी देणे ओर तूँ उजाड़ ऊई जाणा, तेबे ताखे पता लगी जाणा कि आऊँ ई यहोवा ए। <verse eid="EZK 35:4" /><verse number="5" style="v" sid="EZK 35:5" />कऊँकि तूँ इस्राएलिया साथे सदा दुश्मणी राखदा आई रा, इजी बजा ते जेबे तिना रे दुश्मणे तिना पाँदे अमला करी की सेयो काईते, तेबे तैं तिना री मताद नि कित्ती। जेबे मैं तिना खे तिना रे पापो री सजा दित्ती, तेबे सेयो बड़िया मुसीबता दे पड़ीगे।” <verse eid="EZK 35:5" /><verse number="6" style="v" sid="EZK 35:6" />इजी री खातर परमेशर यहोवा ईंयाँ बोलोआ, “मेरी जिन्दगिया री कसम, मां तेरे दुश्मण ताखे काणे खे पेजणे ओर तिना तूँ कायी देणा। जेबे दूजे लोक काये तेबे तूँ खुश ऊआ था।” <verse eid="EZK 35:6" /><verse number="7" style="v" sid="EZK 35:7" />ईंयाँ मां सेईर पाह्ड़ उजाड़ ई उजाड़ करी देणा ओर जो तिदे आऊँदा-जांदा ऊगा, से मां नाश करी देणा। <verse eid="EZK 35:7" /><verse number="8" style="v" sid="EZK 35:8" />मां तेथो रे पाह्ड़ काये देया लोका रिया लाशा साथे परी देणे; तेरे टीले, तराईया ओर सारे नाल़ेया दे तलवारी साथे काये रे पड़ने। <verse eid="EZK 35:8" /><verse number="9" style="v" sid="EZK 35:9" />मां तूँ सदा खे उजाड़ी देणा ओर तेरे शईर फेर नि बसणे। तेबे तुसा खे पता लगी जाणा कि आऊँ यहोवा ए।<verse eid="EZK 35:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="EZK 35:10" />परमेशर बोलोआ, “यो दोनो जातिया ओर यो दोनो देश मेरे ऊणे ओर आसे एदोमी ई इना रे मालक ऊई जाणे” तेबे बी यहोवा तेती था। <verse eid="EZK 35:10" /><verse number="11" style="v" sid="EZK 35:11" />इजी बजा ते परमेशर यहोवा ईंयाँ बोलोआ, “मेरी जिन्दगिया री कसम, तेरे रोषो रे मुताबिक ओर जो जल़न तैं मेरे लोका पाँदे आपणी दुश्मणिया री बजा ते करी राखी, तिजी रेई मुताबिक मां ता साथे बर्ताव करना ओर जेबे मां तेरा न्याय करना, तेबे मां तुसा सामणे आऊणा।” <verse eid="EZK 35:11" /><verse number="12" style="v" sid="EZK 35:12" />ताखे पता लगी जाणा कि मैं यहोवे तेरी सारिया तिरस्कार कित्ती रिया गल्ला सुणी राखिया, जो तैं इस्राएलो रे पाह्ड़ो रे बारे दे बोली राखिया, सेयो तो ऊजड़ी गे, सेयो आसा खे ई देई राखे, ताकि आसे तिना खे खाऊँ। <verse eid="EZK 35:12" /><verse number="13" style="v" sid="EZK 35:13" />तैं आपणे मुंए ते मेरे खलाफ बडयाईया कित्तिया ओर मेरे खलाफ बऊत गल्ला कित्तिया; जो मैं सुणी राखिया। <verse eid="EZK 35:13" /><verse number="14" style="v" sid="EZK 35:14" />परमेशर यहोवा ईंयाँ बोलोआ, “जेबे पूरी तरतिया पाँदे खुशी ऊणी, तेबे मां तूँ उजाड़ी देणा। <verse eid="EZK 35:14" /><verse number="15" style="v" sid="EZK 35:15" />तूँ इस्राएल जो परमेशरो रा आपणा इस्सा ए तेसरे उजड़ने रिया बजा ते खुश ऊआ, इजी री खातर मां बी तां साथे तेड़ा ई करना; ओ सेईर पाह्ड़, ओ एदोम देश, तूँ सुनसाण रेगिस्तान बणी जाणा। तेबे इस्राएलिया खे पता लगी जाणा कि आऊँ ई यहोवा ए।”<verse eid="EZK 35:15" /></para>
  <chapter eid="EZK 35" />
  <chapter number="36" style="c" sid="EZK 36" />
  <para style="s">इस्राएलो पाँदे परमेशरो री आशीष</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 36:1" />यहोवे यहेजकेलो खे बोलेया, “ओ नाश ऊणे वाल़े माणूंआ, तूँ इस्राएलो रे पाह्ड़ा खे भविष्यबाणी करी की बोल, ओ इस्राएलो रे पाह्ड़ो, यहोवे रा वचन सुणो। <verse eid="EZK 36:1" /><verse number="2" style="v" sid="EZK 36:2" />परमेशर यहोवा ईंयाँ बोलोआ: तुसा रे दुश्मणे तो तुसा रे बारे दे बोली राखेया, वा! पुराणे बखतो रिया ऊच्चिया जगा एबे म्हारिया ऊईगिया रिया ए।” <verse eid="EZK 36:2" /><verse number="3" style="v" sid="EZK 36:3" />इजी बजा ते भविष्यबाणी करी की बोल, परमेशर यहोवा ईंयाँ बोलोआ, “नेड़े-तेड़े रे देशे जो तूँ उजाड़ ओर चऊँ कनारे ते तूँ एड़ा निगल़ी ला रा कि तुसे बची रिया जातिया रे कब्जे दे ऊई जाओ ओर बकवासी तुसा रिया गल्ला करोए ओर आम लोक तुसा री निन्दा करोए।” <verse eid="EZK 36:3" /><verse number="4" style="v" sid="EZK 36:4" />इजी बजा ते, ओ इस्राएलो रे पाह्ड़ो, परमेशर यहोवे रा वचन सुणो, परमेशर यहोवा तुसा खे ईंयाँ बोलोआ, “मतलब पाह्ड़ ओर पाह्ड़िया खे ओर नाल़े ओर तराईया खे ओर उजड़े रे खण्डहर ओर सुनसाण शईरा खे जो चऊँ कनारली बची रिया जातिया ते लूटी गे ओर तिना री आसिया री बजा ऊईगे रे; <verse eid="EZK 36:4" /><verse number="5" style="v" sid="EZK 36:5" />परमेशर यहोवा ईंयाँ बोलोआ, मैं आपणे रोषो रिया आगी ते पक्का बची री जातिया रे ओर सारे एदोम देशो रे बारे दे बोली राखेया कि जिने मेरा देश आपणे मनो रे पूरे मजे ओर कमण्डो साथे आपणे अक्को रे करी राखेया ताकि से पराया ऊई की लूटी जाओ।” <verse eid="EZK 36:5" /><verse number="6" style="v" sid="EZK 36:6" />इजी बजा ते इस्राएलो रे देशो रे बारे दे भविष्यबाणी करी की पाह्ड़, पाह्ड़िया, नाल़े ओर तराईया खे बोल, परमेशर यहोवा ईंयाँ बोलोआ, “देखो, तुसे जातिया री निन्दा सयीन करी राखी, इजी बजा ते आऊँ तुसा रे दुश्मणा ते बड़े पारी रोषो दे आई की बोलणे लगी रा।” <verse eid="EZK 36:6" /><verse number="7" style="v" sid="EZK 36:7" />परमेशर यहोवा ईंयाँ बोलोआ, “आऊँ आथ ऊबे चकी कि कसम खाऊँआ कि तिना देशा छोड़ ई आपणी बेज्जती सयीणी पड़नी।”<verse eid="EZK 36:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="EZK 36:8" />पर ओ इस्राएलो रे पाह्ड़ो, तुसा पाँदे डाल़िया लगणियां ओर तिना रे फल मेरी इस्राएली प्रजा खे लगणे, कऊँकि सेयो छोड़ ई गुलामिया ते वापस इस्राएलो खे आई जाणे। <verse eid="EZK 36:8" /><verse number="9" style="v" sid="EZK 36:9" />देखो, आऊँ तुसा साथे ए ओर मां तुसा पाँदे दया करनी ओर तुसे फसला बांदे-लगांदे जाणे। <verse eid="EZK 36:9" /><verse number="10" style="v" sid="EZK 36:10" />मां तां पाँदे बऊत माणूं, मतलब इस्राएलो रा सारा कराना बसाणा ओर शईर फेर बसणे ओर खण्डहर फेर बणाए जाणे। <verse eid="EZK 36:10" /><verse number="11" style="v" sid="EZK 36:11" />मां तां पाँदे माणूं ओर डांगर दोनो बऊत जादा बढ़ाणे ओर मां तूँ पुराणे बखतो जेड़ा बसाणा ओर मां तेरी री पईले ते जादा पलाई करनी। तेबे ताखे पता लगी जाणा कि आऊँ ई यहोवा ए। <verse eid="EZK 36:11" /><verse number="12" style="v" sid="EZK 36:12" />मां तुसे, मतलब मेरी प्रजा इस्राएल लोक, फेर एते देशो दे रणे खे वापस ली आऊणे ओर सेयो तुसा रे मालक ऊणे ओर तुसे तिना रे आपणे इस्से ऊणे ओर तां तिना रे बच्चे अकाल़ो रिया बजा ते मरने नि देणे। <verse eid="EZK 36:12" /><verse number="13" style="v" sid="EZK 36:13" />परमेशर यहोवा ईंयाँ बोलोआ, “दूजिया जातिया ये बोली की तुसा रा मजाक करोईया, कि इस्राएल एड़ा देश ए जो आपणे ई माणूंआ खे कायी देओआ, ओर आपणे ई बच्चेया खे पूखा मरने देओआ। <verse eid="EZK 36:13" /><verse number="14" style="v" sid="EZK 36:14" />इजी री खातर तूँ फेर माणूंआ खे नि खाई सकणा ओर ना आपू बीचे बसी री जातिया बिना नाश करनिया, परमेशर यहोवे री येई बाणी ए।” <verse eid="EZK 36:14" /><verse number="15" style="v" sid="EZK 36:15" />मां फेर जातिया-जातिया रे लोका ते तेरी निन्दा नि सुनवाणी ओर ताखे फेर जातिया-जातिया रे लोका ते निन्दा नि सयीणी पड़नी ओर तां आपू पाँदे बसी रिया जातिया खे फेर ठोकर नि खुलाणी, परमेशर यहोवे री येई बाणी ए।<verse eid="EZK 36:15" /></para>
  <para style="s">इस्राएलो रा नवां जीवन</para>
  <para style="p">
    <verse number="16" style="v" sid="EZK 36:16" />तेबे यहोवे रा ये सन्देश फेर माखे मिलेया, <verse eid="EZK 36:16" /><verse number="17" style="v" sid="EZK 36:17" />“ओ नाश ऊणे वाल़े माणूंआ, जेबे इस्राएलो रा कराना आपणे देशो रे रओ था, तेबे आपणे चाल-चलण ओर कामो रे जरीये सेयो तेतेखे अशुद्ध करो थे; तिना रा चाल-चलण माखे महावारी आई री जवाणसा री अशुद्धता जेड़ा लगो था। <verse eid="EZK 36:17" /><verse number="18" style="v" sid="EZK 36:18" />इजी री खातर जो अत्या तिने देशो रे कित्ती ओर देश आपणी मूर्तिया साथे अशुद्ध कित्तेया, इजी बजा ते मैं तिना पाँदे आपणा रोष पड़काया। <verse eid="EZK 36:18" /><verse number="19" style="v" sid="EZK 36:19" />मैं सेयो जातिया-जातिया बीचे तित्तर-बित्तर कित्ते ओर सेयो देश-देशो रे रूल़ी गे; मैं तिना खे तिना रे चाल-चलण ओर कामो रे मुताबिक सजा दित्ती।” <verse eid="EZK 36:19" /><verse number="20" style="v" sid="EZK 36:20" />सेयो जेते-जेते देशो दे गये, तेती बी तिने मेरा पवित्र नाओं अपवित्र ठराया, तेथो रे लोक तिना रे बारे दे ये बोलो थे, “यो यहोवे रे आपणे लोक थे, पर तेबे बी तिने यो आपणे देशो ते निकाल़ी ते।”<note caller="+" style="f"><char style="fr" closed="false">36:20 </char><char style="ft" closed="false">रोम. 2:24</char></note> <verse eid="EZK 36:20" /><verse number="21" style="v" sid="EZK 36:21" />पर मैं आपणे पवित्र नाओं री खबर-सम्बाल़ लई, जो इस्राएलो रे कराने तिना जातिया बीचे अपवित्र ठराया था, जेती सेयो गये थे।<verse eid="EZK 36:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="EZK 36:22" />इजी बजा ते तू इस्राएलो रे कराने खे बोल, परमेशर यहोवा ईंयाँ बोलोआ, “ओ इस्राएलो रे कराने, आऊँ एतेखे तुसा रिया तँईं नि, पर आपणे पवित्र नाओं रिया तँईं करूँआ, जो तुसे तिना जातिया बीचे अपवित्र ठराया जेती तुसे गये थे। <verse eid="EZK 36:22" /><verse number="23" style="v" sid="EZK 36:23" />मां आपणा बड़ा नाओं पवित्र ठराणा, जो तुसे ओरी जातिया बीचे अपवित्र ठराया, जो तुसे तिना बीचे अपवित्र कित्तेया ओर जेबे आऊँ तिना री नजरा दे तुसा बीचे पवित्र ठईरना, तेबे तिना ओरी जातिया खे पता लगी जाणा कि आऊँ ई यहोवा ए, परमेशर यहोवे री येई बाणी ए।”<note caller="+" style="f"><char style="fr" closed="false">36:23 </char><char style="ft" closed="false">यहे. 39:7</char></note> <verse eid="EZK 36:23" /><verse number="24" style="v" sid="EZK 36:24" />मां तुसे दूजी जातिया बीचा ते लई लणे ओर देशो ते कट्ठे करने ओर तुसे तुसा रे आपणे देशो दे पऊँचाई देणे। <verse eid="EZK 36:24" /><verse number="25" style="v" sid="EZK 36:25" />तुसे शुद्ध ऊई जाणे, जेड़े मैं तुसा पाँदे साफ पाणी छिड़की राखेया ए। मां सेयो सब चीजा टाई देणियां जो तुसा खे अशुद्ध बणाओईया। मां सेयो मूर्तिया दूर करी देणियां जिना री तुसे पूजा करोए।<note caller="+" style="f"><char style="fr" closed="false">36:25 </char><char style="ft" closed="false">इब्रा. 10:22</char></note> <verse eid="EZK 36:25" /><verse number="26" style="v" sid="EZK 36:26" />मां तुसा खे नवां मन देणा ओर तुसा रे पीतरे नवीं आत्मा पैदा करनी ओर तुसा रे शरीरो ते पात्थरो रा दिल निकयाल़ी की तुसा खे मासो रा दिल देणा।<note caller="+" style="f"><char style="fr" closed="false">36:26 </char><char style="ft" closed="false">यहे. 11:19-20</char></note> <verse eid="EZK 36:26" /><verse number="27" style="v" sid="EZK 36:27" />मां आपणा आत्मा तुसा रे पीतरे देई की एड़ा करना कि तुसे मेरी बिधिया पाँदे चलणे ओर मेरे नियम मानी की तिना रे मुताबिक करना।<note caller="+" style="f"><char style="fr" closed="false">36:27 </char><char style="ft" closed="false">यहे. 37:14</char></note> <verse eid="EZK 36:27" /><verse number="28" style="v" sid="EZK 36:28" />तुसे इस्राएलो रे देशो दे बसणे जो मैं तुसा रे बुजुर्गा खे दित्तेया था ओर तुसे मेरी प्रजा ठईरने ओर आऊँ तुसा रा परमेशर ठईरना। <verse eid="EZK 36:28" /><verse number="29" style="v" sid="EZK 36:29" />मां तुसे तुसा री सारी अशुद्धता ते छुड़ाणे ओर तुसा रे डोरूआ दे नज्ज बऊत पैदा करना, ओर तुसा बीचे अकाल़ नि पाणा। <verse eid="EZK 36:29" /><verse number="30" style="v" sid="EZK 36:30" />मां डाल़ो रे फल ओर डोरूआ री उपज बढ़ाणी, ताकि जातिया बीचे अकाल़ो रिया बजा ते तुसा री निन्दा नि ओ। <verse eid="EZK 36:30" /><verse number="31" style="v" sid="EZK 36:31" />तेबे तुसे आपणे बुरे चाल-चलण ओर आपणे काम जो अच्छे नि थे, याद करी की आपणे पाप ओर घिनौने कामो रिया बजा ते आपणे आपू ते नफरत करने लगणे। <verse eid="EZK 36:31" /><verse number="32" style="v" sid="EZK 36:32" />परमेशर यहोवा ईंयाँ बोलोआ, “इस्राएल, आऊँ चाऊँआ कि तुसा खे पता लगी जाओ कि आऊँ ये सब तुसा रिया तँईं नि करने लगी रा। आऊँ चाऊँआ कि तुसे जो करने लगी रे, तिजी रिया तँईं शर्म ओर बेज्जती मेहसुस करो।”<verse eid="EZK 36:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="EZK 36:33" />परमेशर यहोवा ईंयाँ बोलोआ, “जेबे मां तुसे तुसा रे सारे पापो रे कामो ते शुद्ध करने, तेबे तुसा रे शईर बसाणे ओर जो शईर तुसे नाश करी राखे सेयो शईर फेर बणाए जाणे। <verse eid="EZK 36:33" /><verse number="34" style="v" sid="EZK 36:34" />तुसा रा देश जो सारे आऊणे-जाणे वाल़ेया सामणे उजाड़ ए, से उजाड़ ऊणे रिया बजा ते बाया-बीजेया जाणा। <verse eid="EZK 36:34" /><verse number="35" style="v" sid="EZK 36:35" />तेबे तिना लोका बोलेया जो इस्राएल देशो रिये जाओए, ये देश जो उजाड़ था, से अदनो रे बगीचे जेड़ा ऊईगा ओर जो शईर खण्डहर ओर उजाड़ ऊईगे थे ओर टाल़ी ते थे, सेयो गढ़वाल़े ऊईगे ओर बसायी ते रे। <verse eid="EZK 36:35" /><verse number="36" style="v" sid="EZK 36:36" />तेबे जो जातिया तुसा रे नेड़े-तेड़े बची रिया रणियां, तिना खे पता लगी जाणा कि मैं परमेशरे टाल़ेया रा फेर बणाया ओर उजाड़ जगा दे डाल़ लगाए, मैं यहोवे ये बोलेया ओर एड़ा ई करना।”<verse eid="EZK 36:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="EZK 36:37" />परमेशर यहोवा ईंयाँ बोलोआ, “इस्राएलो रे लोका फेर मांते प्रार्थना करनी कि आऊँ तिना खे एड़ा करुँ, ओर मां तिना रे लोका री गिणती पेडा बाकरिया जेड़ी बढ़ाई देणी। <verse eid="EZK 36:37" /><verse number="38" style="v" sid="EZK 36:38" />जिंयाँ पवित्र बलिया रिया पेडा-बाकरिया ओईया, मतलब ठराए रे त्योआरो रे बखते यरूशलेम शईरो रिया पेडा-बाकरिया अणगिणत ओईया, तिंयाँ ई एबे जो शईर सुनसाण पड़ी रे, अणगिणत माणूंआ री पीड़ा साथे परी जाणे। तेबे गुलामिया ते आये दे लोका खे पता लगी जाणा कि आऊँ ई यहोवा ए।”<verse eid="EZK 36:38" /></para>
  <chapter eid="EZK 36" />
  <chapter number="37" style="c" sid="EZK 37" />
  <para style="s">सुकी आड्डिया री काअटी</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 37:1" />मैं यहोवे री शक्ति आपू दे महसूस कित्ती ओर से माँदे आपणा आत्मा समायी की बारे लईगा ओर आऊँ तराईया बीचे खड़ा करी ता; से काअटी आड्डिया साथे परी री थी। <verse eid="EZK 37:1" /><verse number="2" style="v" sid="EZK 37:2" />तेबे तिने आऊँ तिना आड्डिया रे चऊँ कनारे कुमाया ओर तराईया बीचे बऊत सारिया आड्डिया थिया ओर सेयो पूरी तरआ ते सूकी गिया थिया। <verse eid="EZK 37:2" /><verse number="3" style="v" sid="EZK 37:3" />तेबे यहोवे मांते पूछेया, “ओ नाश ऊणे वाल़े माणूंआ, क्या यो आड्डिया जियूँदिया ऊई सकोईया?” मैं ज्वाब दित्तेया, “ओ मेरे परमेशर यहोवा तूँ ई जाणेया।” <verse eid="EZK 37:3" /><verse number="4" style="v" sid="EZK 37:4" />तेबे यहोवे माखे फेर बोलेया, “इना आड्डिया खे भविष्यबाणी करी की बोल, ओ सूकी आड्डियो, यहोवे रा ये वचन सुणो। <verse eid="EZK 37:4" /><verse number="5" style="v" sid="EZK 37:5" />परमेशर यहोवा तुसा आड्डिया खे ईंयाँ बोलोआ: देखो, मां आपू तुसा सबी दे आपणा साआ<note caller="+" style="f"><char style="fr" closed="false">37:5 </char><char style="fq" closed="false">साआ </char><char style="ft" closed="false">आत्मा </char></note> पाणा, ओर तुसे फेर जिऊँदिया ऊई जाणिया। <verse eid="EZK 37:5" /><verse number="6" style="v" sid="EZK 37:6" />मां तुसे लोक कट्ठे जोड़ने ओर तुसा पाँदे मास चढ़ाणा, ओर तुसे चामड़िया साथे टखणे। मां तुसा लोका दे साआ पाणा ओर तुसे जिऊँदे ऊई जाणे। तेबे तुसा खे पता लगी जाणा कि आऊँ ई यहोवा ए।”<verse eid="EZK 37:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="EZK 37:7" />एसा आज्ञा रे मुताबिक आऊँ भविष्यबाणी करने लगेया ओर आऊँ भविष्यबाणी करने ई लगी रा था कि एक आवाज आई ओर ईल्लण ऊआ ओर हर एकी शरीरो रिया आड्डिया कट्ठिया जुड़ी गिया ओर पूरे कंगाल़ बणीगिया। <verse eid="EZK 37:7" /><verse number="8" style="v" sid="EZK 37:8" />आऊँ देखदा रया, कि तिना दे नसा पैदा ऊईया ओर मास चढ़ेया ओर सेयो पाँदा ते चामड़िया साथे टखी गिया; पर तिना रे कोई साआ नि था। <verse eid="EZK 37:8" /><verse number="9" style="v" sid="EZK 37:9" />तेबे तिने माखे बोलेया, “ओ नाश ऊणे वाल़े माणूंआ, साओ ते भविष्यबाणी कर ओर साओ ते भविष्यबाणी करी की बोल, ओ साआ, परमेशर यहोवा ईंयाँ बोलोआ कि चारो दिशा ते आई की जो यो काई राखे इना दे समायी जा ताकि यो जिऊँदे ऊई जाओ।” <verse eid="EZK 37:9" /><verse number="10" style="v" sid="EZK 37:10" />परमेशरो री एसा आज्ञा रे मुताबिक मैं भविष्यबाणी कित्ती, तेबे तिना रे साआ आई गा ओर सेयो जिऊँदे ऊई की आपणे-आपणे पैरो पाँदे खड़िया ऊईगिया ओर एक बऊत बड़ी सेना ऊई गी। <verse eid="EZK 37:10" /><verse number="11" style="v" sid="EZK 37:11" />तेबे यहोवे माखे बोलेया, “ओ नाश ऊणे वाल़े माणूंआ, यो आड्डिया इस्राएलो रे सारे कराने री उपमा ए। सेयो बोलोए, म्हारी आड्डिया सूकी गिया ओर म्हारी उम्मीद टूटी गी, आसे पूरी तरअ ते टूटी चुके रे।” <verse eid="EZK 37:11" /><verse number="12" style="v" sid="EZK 37:12" />इजी बजा ते भविष्यबाणी करी की तिना खे बोल, “परमेशर यहोवा ईंयाँ बोलोआ: ओ मेरी प्रजा रे लोको, देखो, मां तुसा रिया कब्रा खोली की तुसे तिना बीचा ते काडणे ओर इस्राएलो रे देशो रे पऊँचाई देणे।<note caller="+" style="f"><char style="fr" closed="false">37:12 </char><char style="ft" closed="false">यशा. 26:19</char></note> <verse eid="EZK 37:12" /><verse number="13" style="v" sid="EZK 37:13" />इजी री खातर जेबे आऊँ तुसा रिया कब्रा खोलूँ ओर तुसा खे तिना ते निकयाल़ूँ, तेबे ओ मेरी प्रजा रे लोको, तुसा खे पता लगी जाणा कि आऊँ यहोवा ए। <verse eid="EZK 37:13" /><verse number="14" style="v" sid="EZK 37:14" />मां तुसा दे आपणा साआ देणा ओर तुसे जियूणे ओर तुसे तुसा रे आपणे देशो रे बसाणे; तेबे तुसा खे पता लगी जाणा कि मैं यहोवे ई ये बोली राखेया ओर करी बी राखेया, यहोवे री येई बाणी ए।”<note caller="+" style="f"><char style="fr" closed="false">37:14 </char><char style="ft" closed="false">यहे. 36:27</char></note><verse eid="EZK 37:14" /></para>
  <para style="s">यहूदा ओर इस्राएल एक ई राज्य</para>
  <para style="p">
    <verse number="15" style="v" sid="EZK 37:15" />फेर यहोवे रा ये सन्देश माखे मिलेया, <verse eid="EZK 37:15" /><verse number="16" style="v" sid="EZK 37:16" />“ओ नाश ऊणे वाल़े माणूंआ, लकड़िया रा एक टुकड़ा लई की तेते पाँदे लिख, ये यहूदा ओर इस्राएलो रे सबी गोत्रा री अगुआई करोआ। ओर तेबे दूजी लकड़ी लई की तेते पाँदे लिख, ये यूसुफो री मतलब एप्रैमो री ओर इस्राएलो रे सबी गोत्रा री अगुआई करोआ।” <verse eid="EZK 37:16" /><verse number="17" style="v" sid="EZK 37:17" />तेबे तिना लकड़िया खे एकी-दूजिया साथे जोड़ी की एक ई बणाई दे, ताकि सेयो तेरे आथो रे एक ई लकड़ी बणी जाओ। <verse eid="EZK 37:17" /><verse number="18" style="v" sid="EZK 37:18" />जेबे तेरे लोक तांते पूछो, क्या तां आसा गे नि बताणा कि इना ते तेरा क्या मतलब ए? <verse eid="EZK 37:18" /><verse number="19" style="v" sid="EZK 37:19" />तेबे तिना खे बोलणा, “परमेशर यहोवा ईंयाँ बोलोआ: मेरे आथो दे जो ये यूसुफो री लकड़िया रा टुकड़ा ए, से इस्राएल ओर इस्राएलो रे सबी गोत्रा रा नशाण ए। मां ये यहूदा<note caller="+" style="f"><char style="fr" closed="false">37:19 </char><char style="fq" closed="false">यहूदा </char><char style="ft" closed="false">एप्रैम </char></note> रे नशाण वाल़ी लकड़िया रे टुकड़े ते जोड़ी की तेसरे आथो दे एक लकड़िया रा टुकड़ा बणने लगी रा। <verse eid="EZK 37:19" /><verse number="20" style="v" sid="EZK 37:20" />जिना लकड़िया पाँदे तां एड़ा लिखणा, सेयो तिना सामणे तेरे आथो रे रओ।” <verse eid="EZK 37:20" /><verse number="21" style="v" sid="EZK 37:21" />तेबे तूँ तिना लोका खे बोल, परमेशर यहोवा ईंयाँ बोलोआ, “देखो, मां इस्राएली तिना जातिया बीचा ते लई की जिना बीचे सेयो चली गे रे, चऊँ कनारो ते कट्ठे करने ओर सेयो तिना रे आपणे देशो रे पऊँचाणे। <verse eid="EZK 37:21" /><verse number="22" style="v" sid="EZK 37:22" />मां सेयो तिना रे देशो रे, मतलब इस्राएलो रे पाह्ड़ो रे एक ई जाति करी देणी; ओर तिना सबी रा एक ई राजा ऊणा ओर सेयो फेर दो नि रणे ओर ना ई फेर दूई राज्या दे बटणे। <verse eid="EZK 37:22" /><verse number="23" style="v" sid="EZK 37:23" />इस्राएलिया फेर आपू खे आपणी मूर्तिया, घिनौने काम या आपणे केसी बी पापो रे जरीये अशुद्ध नि करना, पर मां सेयो तिना सबी बस्तिया दे, जेती सेयो पाप करो थे, निकयाल़ी की शुद्ध करने ओर छुड़ाणे ओर सेयो मेरी प्रजा ऊणे ओर आऊँ तिना रा परमेशर ऊणा।”<note caller="+" style="f"><char style="fr" closed="false">37:23 </char><char style="ft" closed="false">यहे. 36:25</char></note><verse eid="EZK 37:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="EZK 37:24" />मेरे दास दाऊदो जेड़ा राजा तिना रा राजा ऊणा ओर तिना सबी रा एक ई ग्वाल़ा ऊणा। सेयो मेरे नियमो पाँदे चलणे ओर मेरी बिधिया मानी की तिना रे मुताबिक चलणे।<note caller="+" style="f"><char style="fr" closed="false">37:24 </char><char style="ft" closed="false">यहे. 34:23</char></note> <verse eid="EZK 37:24" /><verse number="25" style="v" sid="EZK 37:25" />सेयो तेस देशो रे रणे, जो मैं आपणे दास याकूबो खे दित्तेया था ओर जेती तुसा रे बुजुर्ग रओ थे, तिदे ई सेयो ओर तिना रे माठे-पोते सदा बसे दे रणे ओर मेरे दास दाऊदो जेड़ा राजा सदा तिना रा परदान रणा। <verse eid="EZK 37:25" /><verse number="26" style="v" sid="EZK 37:26" />मां इस्राएलो रे लोका साथे शान्तिया री वाचा बानणी; से सदा री वाचा ठईरनी ओर मां तिना खे जगा देई की गिणतिया दे बढ़ाणे ओर तिना बीचे आपणी पवित्र जगा सदा बणाई की राखणी।<note caller="+" style="f"><char style="fr" closed="false">37:26 </char><char style="ft" closed="false">पज. 89:3,4</char></note> <verse eid="EZK 37:26" /><verse number="27" style="v" sid="EZK 37:27" />मां तेती तिना बीचे रणा, आऊँ तिना रा परमेशर ऊणा, ओर सेयो मेरी प्रजा ऊणे।<note caller="+" style="f"><char style="fr" closed="false">37:27 </char><char style="ft" closed="false">प्रका. 21:3</char></note> <verse eid="EZK 37:27" /><verse number="28" style="v" sid="EZK 37:28" />जेबे मेरा मन्दर तिना बीचे सदा खे रणा, तेबे सबी दूजे देशा रिया जातिया खे पता लगी जाणा कि आऊँ यहोवा इस्राएलो खे पवित्र करने वाल़ा ए।<verse eid="EZK 37:28" /></para>
  <chapter eid="EZK 37" />
  <chapter number="38" style="c" sid="EZK 38" />
  <para style="s">गोगो रे खलाफ समाचार</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 38:1" />तेबे यहोवे रा वचन मांगे पऊँचेया, <verse eid="EZK 38:1" /><verse number="2" style="v" sid="EZK 38:2" />“ओ नाश ऊणे वाल़े माणूंआ, मागोग देशो दे राजा गोग ओर रोष शईरो रिया तरफा खे कुमो ओर देखो। से मेशेक ओर तूबलो रा सबी ते जरूरी शासक ए, तेसखे चतौणी देणे रिया तँईं तेसरा सन्देश बोल।”<note caller="+" style="f"><char style="fr" closed="false">38:2 </char><char style="ft" closed="false">यहे. 39:1</char></note> <verse eid="EZK 38:2" /><verse number="3" style="v" sid="EZK 38:3" />तिना खे ये बोल, “ओ गोग, ओ रोष, मेशेक ओर तूबलो रे परदान, परमेशर यहोवा ईंयाँ बोलोआ, देख, आऊँ तेरे खलाफ ए। <verse eid="EZK 38:3" /><verse number="4" style="v" sid="EZK 38:4" />मां तूँ कुमायी देणा ओर तेरे जबड़ेया दे नकेल पायी की तूँ इस्राएलो गे लई आऊणा। तूँ ओर तेरी सारी सेना, तेरे कोड़े ओर कोड़ेया पाँदे सवार अथियार लई की लोक, ओर बऊत सारे ओर सिपाई जो बड़ी ढाला ओर छोटी ढाला लई की ऊणे, ओर तिना सबी गे तलवारा ऊणिया। <verse eid="EZK 38:4" /><verse number="5" style="v" sid="EZK 38:5" />तिना साथे फारस, कूश<note caller="+" style="f"><char style="fr" closed="false">38:5 </char><char style="fq" closed="false">कूश </char><char style="ft" closed="false">इथोपिया </char></note> ओर पूत, जो तिना रे सारे अथियार ढाला ओर टोप पईन दे ऊणे; <verse eid="EZK 38:5" /><verse number="6" style="v" sid="EZK 38:6" />ओर गोमेर ओर तेसरे सारे दलो खे ओर उत्तर दिशा रे दूर-दूर देशो रे बेथ-तोगर्मा राज्य रे सिपाई ओर तेसरे सारे दल काडणे; तां साथे बऊत सारे देशा रे सिपाई ऊणे। <verse eid="EZK 38:6" /><verse number="7" style="v" sid="EZK 38:7" />इजी री खातर तूँ त्यार ऊई जा; तूँ ओर जितणी लोका री पीड़ तांगे लड़ने खे कट्ठी ओ, त्यार रया ओर तैं तिना रा अगुवा बणना। <verse eid="EZK 38:7" /><verse number="8" style="v" sid="EZK 38:8" />कुछ साला बाद तेरी खबर-सम्बाल़ लणी ओर अन्तो रे सालो दे तूँ तेस देशो दे आऊणा, जो तलवारी ते छूटेया दा ऊणा ओर जेथो रे रणे वाल़े बऊत सारी जातिया बीचा ते कट्ठे ऊणे; मतलब तूँ इस्राएलो रे पाह्ड़ो पाँदे आऊणा जो लगातार उजाड़ने लगी रे; पर इस्राएली सबी देशा रे लोका रे वशो ते छुड़ाई की सारे के सारे बिना डरे रणे। <verse eid="EZK 38:8" /><verse number="9" style="v" sid="EZK 38:9" />तां अमला करना ओर तूफानो जेड़ा आऊणा ओर आपणी सारी सेना ओर बऊत सारे लोका समेत बादल़ो जेड़ा देशो पाँदे छायी जाणा।”<verse eid="EZK 38:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="EZK 38:10" />परमेशर यहोवा ईंयाँ बोलोआ, “ओ गोग, तेस दिने तेरे मनो दे एड़िया-एड़िया गल्ला आऊणियां कि तां एक बुरी योजना बी करनी; <verse eid="EZK 38:10" /><verse number="11" style="v" sid="EZK 38:11" />ओर तां बोलणा कि मां तिना गाँवां पाँदे अमला करना जिना दे चऊँ कनारे दवाला नि आ, जिना दे लोक शान्तिया ते रओए, ओर आसा तिना पाँदे अमला करना। तिना गे बचणे रिया तँईं कोई मजबूत दवाल या द्वार नि ए, <verse eid="EZK 38:11" /><verse number="12" style="v" sid="EZK 38:12" />ताकि तूँ तिना री तन-दौल़त छीनी की तिना खे लूटे ओर तिना खण्डहरा पाँदे अमला करे जो फेर बसायी राखे ओर तिना लोका रे खलाफ जाए जो जातिया बीचा ते यरूशलेमो दे कट्ठे ऊए थे जो तरतिया री नाई ए, जेती सेयो आपणे डांगर ओर बाकी सम्पत्ति राखोए।” <verse eid="EZK 38:12" /><verse number="13" style="v" sid="EZK 38:13" />शेबा ओर ददान शईरो रे लोका ओर तर्शीश शईरो रे बपारिया आपणे देशो रे सारे जवान शेरा समेत तांते पूछणा, “क्या तूँ लुटणे आऊणे लगी रा? क्या तैं पैसा छुड़ाणे, सूईना-चाँदी चकणे, डांगर ओर सम्पत्ति निणे ओर बड़ी लूट लुटणे खे आपणी पीड़ कट्ठी करी राखी?”<verse eid="EZK 38:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="EZK 38:14" />इजी बजा ते, ओ नाश ऊणे वाल़े माणूंआ, भविष्यबाणी करी की गोगो खे बोल, “परमेशर यहोवा ईंयाँ बोलोआ, जेस बखते मेरी इस्राएल प्रजा बिना डरे बसी री रणी, ताखे एतेरी खबर मिली जाणी? <verse eid="EZK 38:14" /><verse number="15" style="v" sid="EZK 38:15" />तूँ उत्तर दिशा दे आपणे देशो ते आऊणा; तूँ ओर तां साथे बऊत जातिया रे लोक, जो सारे के सारे कोड़ेया पाँदे चढ़े रे ऊणे, मतलब एक बड़ी पीड़ ओर तागतबर सेना। <verse eid="EZK 38:15" /><verse number="16" style="v" sid="EZK 38:16" />जिंयाँ बादल़ जमीना दे छाई जाओआ, तिंयाँ ई तां मेरी इस्राएल प्रजा पाँदे चढ़ाई करनी।” इजी खे ओ गोग, अन्तो रे दिनो रे एड़ा ई ऊणा कि मां तांते आपणी इस्राएलो री प्रजा पाँदे इजी रिया तँईं चढ़ाई कराणी, ताकि जेबे आऊँ जातिया सामणे तेरे जरीये आपू खे पवित्र ठराऊँ, तेबे तिना आऊँ पछयाणी लणा।<verse eid="EZK 38:16" /></para>
  <para style="s">गोगो खे परमेशरो री सजा</para>
  <para style="p">
    <verse number="17" style="v" sid="EZK 38:17" />परमेशर यहोवा ईंयाँ बोलोआ, “क्या तूँ सेईए जेसरे बारे दे मैं पुराणे बखतो रे आपणे दासा साथे, मतलब इस्राएलो रे तिना भविष्यबक्तेया रे जरीये गल्ल कित्ती थी, जो तिना दिना रे सालो तक ये भविष्यबाणी करदे रये कि यहोवे गोगो ते इस्राएलिया पाँदे चढ़ाई करवाणी?” <verse eid="EZK 38:17" /><verse number="18" style="v" sid="EZK 38:18" />जेस दिने इस्राएलो पाँदे गोगो चढ़ाई करनी, तेस दिने ई मेरा रोष मेरे मुंए ते सामणे आऊणा, परमेशर यहोवे री येई बाणी ए। <verse eid="EZK 38:18" /><verse number="19" style="v" sid="EZK 38:19" />मैं जल़नी रे ओर रोषो रे आई की बोलेया कि तेस दिने पक्का इस्राएल देशो रे बड़ा ईल्लण ऊणा। <verse eid="EZK 38:19" /><verse number="20" style="v" sid="EZK 38:20" />सब जिऊँदे प्राणी समुद्रो रिया मछलिया, सर्गो रे पंछी, मैदानो रे डांगर, जमीना दे लूरने वाल़े सारे जीव-जन्तु ओर जमीना दे जितणे माणूं रओए, सब मेरे ऊणे रिया बजा ते डरी जाणे। ओर पाह्ड़ टाल़ी जाणे; चट्टानी टूटी जाणिया; दवाला तरतिया पाँदे टल़ी जाणिया।<note caller="+" style="f"><char style="fr" closed="false">38:20 </char><char style="ft" closed="false">होश. 4:3</char></note> <verse eid="EZK 38:20" /><verse number="21" style="v" sid="EZK 38:21" />परमेशर यहोवे री ये बाणी ए कि मां तेसरे खलाफ तलवार चलाणे रिया तँईं सारे पाह्ड़ो खे आका पाणिया ओर गोगो रे सारे सिपाईया एकी दूजे रे खलाफ तलवारे की लड़ना शुरू करी देणा। <verse eid="EZK 38:21" /><verse number="22" style="v" sid="EZK 38:22" />मां गोग ओर तेसरी बड़ी सेना खे सजा देणी ओर तेस पाँदे ओर तेसरी सेना पाँदे ओर तिना पाँदे बऊत सारी जातिया जो तिना गे ऊणिया, मां बड़ी पारी बर्खा करनी ओर ओल़े, आग ओर गन्धक बरसाणी।<note caller="+" style="f"><char style="fr" closed="false">38:22 </char><char style="ft" closed="false">यशा. 66:16</char></note> <verse eid="EZK 38:22" /><verse number="23" style="v" sid="EZK 38:23" />ईंयाँ आऊँ आपणे आपू खे महान ओर पवित्र ठराऊँगा ओर सबी देशा रे सामणे आपू खे प्रगट करना। तेबे तिना सबी देशा रे लोका खे पता लगी जाणा कि आऊँ ई यहोवा ए।<verse eid="EZK 38:23" /></para>
  <chapter eid="EZK 38" />
  <chapter number="39" style="c" sid="EZK 39" />
  <para style="s">गोगो री आर</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 39:1" />यहोवे फेर मांते गल्ला करदे रया, “ओ नाश ऊणे वाल़े माणूंआ, गोगो साथे ऊणे वाल़िया ओर बी खतरनाक गल्ला रे बारे दे भविष्यबाणी करी की बोल, ओ गोग, ओ रोष, जो मेशेक ओर तूबलो पाँदे राज करोआ, आऊँ तेरे खलाफ ए। <verse eid="EZK 39:1" /><verse number="2" style="v" sid="EZK 39:2" />मां तूँ चऊँ कनारो ते कूमायी की ल्याऊणा ओर उत्तर दिशा रे दूर-दूर देशो ते चढ़ाई की ली आऊणा ओर इस्राएलो रे देशो दे पऊँचाणा। <verse eid="EZK 39:2" /><verse number="3" style="v" sid="EZK 39:3" />तेती मां तेरा धनुष तेरे खूँजे आथो ते थाले सटयाणा ओर तेरे तीर तेरे दाँणे आथो ते थाले सटयाई देणे। <verse eid="EZK 39:3" /><verse number="4" style="v" sid="EZK 39:4" />तूँ आपणी सारी सेना ओर आपू साथली सारी जातिया समेत इस्राएलो रे पाह्ड़ो पाँदे मरी जाणा; मां तूँ नेका-प्रकारा रे पंछिया ते, जो मास खाणे वाल़े ए ओर बणो रे जानवरा खे तिना रा खाणा करी की देई देणा, <verse eid="EZK 39:4" /><verse number="5" style="v" sid="EZK 39:5" />तूँ खाली डोरूए दे रूड़ी की मरी जाणा, कऊँकि मैं ई एड़ा बोली राखेया, परमेशर यहोवे री येई बाणी ए।” <verse eid="EZK 39:5" /><verse number="6" style="v" sid="EZK 39:6" />मां मागोग शईरो रे ओर द्धीपो रे बिना डरे रणे वाल़ेया लोका बीचे आग लगाणी ओर मागोग ओर पूर्बा दे भूमध्य समुद्रो रे कनारे वाल़े लोका खे पता लगी जाणा कि आऊँ ई यहोवा ए।<note caller="+" style="f"><char style="fr" closed="false">39:6 </char><char style="ft" closed="false">आमो. 1:10</char></note><verse eid="EZK 39:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="EZK 39:7" />मां आपणी इस्राएली प्रजा बीचे आपणा नाओं सामणे ल्याऊणा ओर आपणा पवित्र नाओं फेर अपवित्र नि ऊणे देणा; तेबे जातिया-जातिया रे लोका खे बी पता लगी जाणा कि आऊँ इस्राएलो रा पवित्र यहोवा ए। <verse eid="EZK 39:7" /><verse number="8" style="v" sid="EZK 39:8" />ये कटणा ऊणे वाल़ी ए ओर से ऊई जाणी, परमेशर यहोवे री येई बाणी ए। ये सेई न्याय रा दिन ए जेतेरी चर्चा मैं करी राखी।<verse eid="EZK 39:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="EZK 39:9" />इस्राएल देशो रे शईरा दे रणे वाल़े आपणे-आपणे शईरो ते बारे निकल़ने, ओर तिना आपणे दुश्मणा रे अथियारा दे छुड़ाई की आग लगाई की फूकी देणे। तिना साता साला तक लकड़िया रे बदले ढाल, तलवार, धनुष, तीर, डण्डे, बड़छे बाल़ने खे इस्तेमाल करदे रणे। <verse eid="EZK 39:9" /><verse number="10" style="v" sid="EZK 39:10" />इजी बजा ते तिना मैदानो दे लकड़ू नि कट्ठे करने, ना जंगल़ो दे डाल़ बाडणे, कऊँकि तिना अथियार ई फूकेया करने, तिना आपू खे लुटणे वाल़े लुटणे ओर आपणे छुड़ाणे वाल़ेया ते छुड़ाणा, परमेशर यहोवे री येई बाणी ए।<verse eid="EZK 39:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="EZK 39:11" />जेस दिने ये सब बीतणा मां गोगो खे इस्राएल देशो दे दबाणे खे एक जगा देणी, से समुद्रो रे पूर्बो रिया तरफा खे आऊणे वाल़ेया री काअटी। एसा आऊणे वाल़े रोकी देणे, कऊँकि तेती गोग ओर तेसरी सारी पीड़ दबाई जाणी। इजी खे हामोन ओर गोगो री काअटी<note caller="+" style="f"><char style="fr" closed="false">39:11 </char><char style="fq" closed="false">हामोन ओर गोगो री काअटी </char><char style="ft" closed="false">गोगो रे सेना दे मरे दे सिपाईया री काअटी </char></note> बोलेया जाणा। <verse eid="EZK 39:11" /><verse number="12" style="v" sid="EZK 39:12" />इस्राएलो रा कराना तिना खे सात मीन्ने तक माट्टी देंदा रणा, ताकि आपणे देशो खे शुद्ध करो। <verse eid="EZK 39:12" /><verse number="13" style="v" sid="EZK 39:13" />देशो रे सबी लोका तिना खे मिली की माट्टी देणी ओर जेस बखते मेरी महिमा ऊणी, तेस बखते तिना रा नाओं बी बड़ा ऊणा, परमेशर यहोवे री येई बाणी ए। <verse eid="EZK 39:13" /><verse number="14" style="v" sid="EZK 39:14" />सात मीन्ने पूरे ऊणे ते बाद, कुछ लोक चूणे जाणे कि सेयो सारे देशो दे कूमी की जमीना दे पड़िया दिया लाशा खे टोल़ो ओर तिना खे दबाई देयो, ताकि सेयो देशो खे तार्मिक रितिया ते शुद्ध करी सको। ईंयाँ फेर से जमीन यहोवे खे इस्तेमालो खे ऊई जाणी। <verse eid="EZK 39:14" /><verse number="15" style="v" sid="EZK 39:15" />देशो दे कुमदे ऊए, जेबे बी तिना खे कोई माणूंआ री आड्डी मिलदी, सेयो तेते गे एक नशाण लगाई देयो थे, ताकि कब्र खणने वाल़े आई की तिजी खे गोगो रिया सेना री काअटिया दे दबाई सको, <verse eid="EZK 39:15" /><verse number="16" style="v" sid="EZK 39:16" />हमोन<note caller="+" style="f"><char style="fr" closed="false">39:16 </char><char style="fq" closed="false">हमोन </char><char style="ft" closed="false">पीड़ </char></note> नाओ रा एक शईर बी तेती आ। ईंयाँ तिना से देश शुद्ध करी देणा।<verse eid="EZK 39:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="EZK 39:17" />ओर एबे, ओ नाश ऊणे वाल़े माणूंआ, परमेशर यहोवा बोलोआ, “सबी पंछिया खे ओर सबी जानवरा खे बुलाओ, तिना खे बोल, मेरे एस बड़े बलिदानो रिया पाट्टिया खे कट्ठे ऊई जाओ। दूरा-दूरा ते इस्राएलो रे पाह्ड़ो पाँदे आओ, तेती आई की तुसे मास खाओ ओर खून पियो। <verse eid="EZK 39:17" /><verse number="18" style="v" sid="EZK 39:18" />तुसा शूरवीरा रा मास खाणा ओर तरतिया रे परदेशी परदाना रा खून पीणा ओर खाडू, मिन्टू, बाकरे ओर बल़दा रा बी जो सारे के सारे बाशान प्रदेशो दे त्यार कित्ते रे ऊणे। <verse eid="EZK 39:18" /><verse number="19" style="v" sid="EZK 39:19" />तेसा पाट्टिया दे जो यहोवे तुसा रिया तँईं त्यार करी राखी ए, तुसे चर्बिया खे खांदे-खांदे रज्जी जाणे ओर खून पी-पी की रज्जी जाणे। <verse eid="EZK 39:19" /><verse number="20" style="v" sid="EZK 39:20" />मां तुसा खे खाणे खे कोड़े ओर तिना रे सवार देणे। मां तुसा खे खाणे खे शूरवीर माणूं ओर हर प्रकारा रे सिपाई देणे,” परमेशर यहोवे री येई बाणी ए।<verse eid="EZK 39:20" /></para>
  <para style="s">इस्राएलो री दुबारा स्थापना</para>
  <para style="p">
    <verse number="21" style="v" sid="EZK 39:21" />मां जातिया-जातिया रे लोका बीचे आपणी महिमा प्रगट करनी ओर जातिया-जातिया रे सबी लोका मेरे सजा रे काम जो मां करने ओर मेरा आथ जो तिना पाँदे पड़ना, देखी लणा। <verse eid="EZK 39:21" /><verse number="22" style="v" sid="EZK 39:22" />तेस दिनो ते बाद इस्राएलो रे कराने खे पता लगी जाणा कि यहोवा म्हारा परमेशर ए। <verse eid="EZK 39:22" /><verse number="23" style="v" sid="EZK 39:23" />जातिया-जातिया रे लोका खे बी पता लगी जाणा कि इस्राएलो रा कराना आपणे बुरे कामो रिया बजा ते गुलामिया दे गया था; कऊँकि तिने मां साथे एड़ा विश्वासघात कित्तेया कि आऊँ तिना ते दूर ऊईगा ओर तिना रे दुश्मणा ते लड़ाईया दे तलवारे की तिना खे आरने ओर काणे दित्तेया। <verse eid="EZK 39:23" /><verse number="24" style="v" sid="EZK 39:24" />मैं तिना री अशुद्धता ओर पापो रे मुताबिक तिना साथे बर्ताव करी की आपणा मूँ तिना ते मोड़ी ला था। <verse eid="EZK 39:24" /><verse number="25" style="v" sid="EZK 39:25" />इजी री खातर परमेशर यहोवा ईंयाँ बोलोआ, “एबे मां याकूब गुलामिया ते वापस ली आऊणा ओर इस्राएलो रे सारे कराने पाँदे दया करनी ओर आपणे पवित्र नाओं रिया तँईं माखे जल़न ऊणी। <verse eid="EZK 39:25" /><verse number="26" style="v" sid="EZK 39:26" />तेबे तेस सारे विश्वासघातो रिया बजा ते जो तिने मेरे खलाफ कित्तेया इस्राएली शर्मिंदा ऊणे ओर आपणे देशो दे बिना डरे रणे ओर सेयो केसी नि डराणे। <verse eid="EZK 39:26" /><verse number="27" style="v" sid="EZK 39:27" />जेबे मां सेयो जातिया-जातिया बीचा ते वापस ल्याऊणे ओर तिना दुश्मणा रे देशा ते कट्ठे करने, तेबे बऊत सारी जातिया री नजरा दे तिना रे जरीये पवित्र ठईरना। <verse eid="EZK 39:27" /><verse number="28" style="v" sid="EZK 39:28" />तेबे इस्राएलो रे लोका खे पता लगी जाणा कि यहोवा म्हारा परमेशर ए, कऊँकि मैं सेयो जातिया-जातिया बीचे गुलाम करी की फेर तिना रे आपणे देशो रे कट्ठे कित्ते। मां तिना बीचा ते कोई बी परदेसो दे नि छाडणा, <verse eid="EZK 39:28" /><verse number="29" style="v" sid="EZK 39:29" />मां एबे तिना ते फेर कदी बी आपणा मूँ नि मोड़ना, कऊँकि मैं इस्राएलो रे कराने पाँदे आपणा आत्मा लटी राखेया, परमेशर यहोवे री येई बाणी ए।”<verse eid="EZK 39:29" /></para>
  <chapter eid="EZK 39" />
  <chapter number="40" style="c" sid="EZK 40" />
  <para style="s">एकी दर्शणो दे यहेजकेलो रा यरूशलेमो दे पऊँचाया जाणा</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 40:1" />पच्चीये सालो दे जेबे आसे बाबेलो दे गुलाम थे, मैं यहोवे री शक्ति आपू पाँदे महसूस कित्ती। ये सालो रे पईले मीन्ने रे दसुए दिने ऊआ। बाबेलो रे सिपाईया रे जरीये यरूशलेम शईरो खे नाश कित्ते दे चौदा साल ऊई चुके दे थे। एकी दर्शणो दे, परमेशर माखे यरूशलेम लईगा। <verse eid="EZK 40:1" /><verse number="2" style="v" sid="EZK 40:2" />आपणे दर्शणो दे परमेशरे आऊँ इस्राएल देशो रे पऊँचाया ओर तेती एक बऊत ऊच्चे पाह्ड़ो पाँदे खड़ा कित्तेया, जेते पाँदे दक्खण तरफा खे तिना मञ्जला खे देखी कि केसी शईरो रा आकार लगो था। <verse eid="EZK 40:2" /><verse number="3" style="v" sid="EZK 40:3" />जेबे यहोवा माखे तेती नेड़े लईगा, तेबे मैं एक आदमी देखेया जेसरी शक्ल पीतल़ी जेड़ी चमकणे लगी री थी, तिने आपणे आथो दे रेशमो री नापणे री रस्सी ओर एक नापणे रा डण्डा पकड़ी राखेया था। से मन्दरो रे पीतरे जाणे वाल़े द्वारो गे खड़ी रा था।<note caller="+" style="f"><char style="fr" closed="false">40:3 </char><char style="ft" closed="false">प्रका. 11:1, प्रका. 21:15</char></note> <verse eid="EZK 40:3" /><verse number="4" style="v" sid="EZK 40:4" />तिने दशणे वाल़े मर्दे माखे बोलेया, “ओ नाश ऊणे वाल़े माणूंआ, आपणी आखी साथे देख, ओर आपणे कानो साथे सुण; ओर जो कुछ मां ताखे दखाणा तिना सबी पाँदे त्यान दे, कऊँकि तूँ इजी री खातर एती पऊँछायी राखेया ताकि आऊँ ताखे इना गल्ला दखाऊँ ओर जो कुछ देखे से सब कुछ इस्राएलो रे लोका खे बताए।”<verse eid="EZK 40:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="EZK 40:5" />आऊँ मन्दरो री जगा खे पुरिया तरआ ते केरे दे एक दवाल देखी सकूँ था। तिने माणूंए आथो दे नापणे रा डण्डा लई ला जो साडे दस फुट लाम्बा था ओर दवाल नापी, ओर दवाल साडे दस फुट मोटी ओर साडे दस फुट ऊच्ची थी।<note caller="+" style="f"><char style="fr" closed="false">40:5 </char><char style="ft" closed="false">प्रका. 21:15</char></note> <verse eid="EZK 40:5" /><verse number="6" style="v" sid="EZK 40:6" />फेर दशणे वाल़ा मर्द पूर्बा रिया तरफा खे तेस बड़े द्वारो गे गया। पैड़िया पाँदे चढ़ी की बड़े द्वारो री दोनो देऊल़ी री चौड़ाई नापी जो नापणे रे डण्डे बराबर थी। <verse eid="EZK 40:6" /><verse number="7" style="v" sid="EZK 40:7" />बड़े द्वारो गे सबी कनारे चौकीदारा रे कमरे बणी रे थे। इना रा हर कमरा नापणे रे डण्डे बराबर चौड़ा ओर लाम्बा था, इना कमरेया बीचलिया बाटा री दवाला समेत दूरी साडे सात फुट थी। बड़े द्वारो री पीतरली देऊल़, जो पीतरे जाणे री बाट बड़े दरवाजे ते पीतरे आँगणो गे मन्दरो रिया तरफा खे थी, से बी ओरा ते लई की पोरो तक साडे दस फुट थी। <verse eid="EZK 40:7" /><verse number="8" style="v" sid="EZK 40:8" />तिने से कमरा नापेया तो देखेया कि से चौदा फुट चौड़ा था। ये पीतरे जाणे वाल़े दरवाजे रा कनारा था जो सबी ते नेड़े था। <verse eid="EZK 40:8" /><verse number="9" style="v" sid="EZK 40:9" />ये चौदा फुट चौड़ा था, ओर एतेरे खम्बे साडे तीन फुट मोटे थे। ये पीतरे जाणे वाल़ा कमरा बड़े द्वारो रे पीतरले कनारे पाँदे था, जेतेरा रा मूँ मन्दरो रिया तरफा खे था। <verse eid="EZK 40:9" /><verse number="10" style="v" sid="EZK 40:10" />पूर्वी बड़े द्वारो रे बरामदे रे दुँईं तरफा खे तीन-तीन पईरेदारा रे कमरे एकी आकारो रे थे। हर कमरे दे बीचे कांदा बी एकी जेड़िया थिया। <verse eid="EZK 40:10" /><verse number="11" style="v" sid="EZK 40:11" />तेबे तिने माणूंए बड़ा द्वार नापेया, जो की खुलणे पाँदे साडे सतारा फुट चौड़ा था, ओर पीतरे जाणे वाल़े द्वारो री बाट साडे बाई फुट चौड़ी थी। <verse eid="EZK 40:11" /><verse number="12" style="v" sid="EZK 40:12" />हर पईरेदारा रे कमरे रे आगे इक्की ईंच एक कांद थी। कमरे हर तरफा दे साडे दस फुट थे। <verse eid="EZK 40:12" /><verse number="13" style="v" sid="EZK 40:13" />तेबे तिने बड़े द्वारो री सारी चौड़ाई नापी, ओर सामणे वाल़े पईरेदारा रे कमरे रिया पिछलिया कांदा बीचली दूरी नापी; ये दूरी लगभग चवाल़ी फुट थी। ओर द्वार आमणे-सामणे थे। <verse eid="EZK 40:13" /><verse number="14" style="v" sid="EZK 40:14" />तेबे तिने बड़े द्वारो रे पीतरा ते लई की पीतरे जाणे वाल़े कमरे तको री बीचलिया कांदा नापिया, तिना री दूरी 105 फुट थी। <verse eid="EZK 40:14" /><verse number="15" style="v" sid="EZK 40:15" />बड़े द्वारो री बाट एकी कनारा ते लई की दूजे कनारे तक साडे सतासी फुट थी। <verse eid="EZK 40:15" /><verse number="16" style="v" sid="EZK 40:16" />पईरेदारा री कमरे रे ओर बड़े द्वारो ते पीतरे चऊँ कनारे कमरे रे बीचले खम्बेया रे बीचे-बीचे झिलमिलदार द्वारिया थिया ओर खम्बेया रे द्वारो दे तेड़िया ई थिया ओर बड़े द्वारो रे पीतरे चऊँ कनारे द्वारिया थिया ओर हर एक खम्बे दे खजूरी रे डाल़ बणाई राखे थे।<verse eid="EZK 40:16" /></para>
  <para style="s">मन्दरो रा बारला आँगण</para>
  <para style="p">
    <verse number="17" style="v" sid="EZK 40:17" />तेबे दशणे वाल़ा मर्द माखे बारले आँगणो दे लईगा ओर तेस आँगणो रे चऊँ कनारे कमरे थे ओर एक मेल्ला बणी रा था, जेते पाँदे तीई कमरे बणी रे थे। <verse eid="EZK 40:17" /><verse number="18" style="v" sid="EZK 40:18" />ये मेल्ला, मतलब थालला मेल्ला बड़े द्वारो साथे लगेया दा था ओर तिना री लम्बाईया रे मुताबिक था। <verse eid="EZK 40:18" /><verse number="19" style="v" sid="EZK 40:19" />तेबे दशणे वाल़े माणूंए मन्दरो रे आँगणो दे बारे ओर पीतरे जाणे वाल़े द्वारा रे बीचली दूरी नापी; जो 175 फुट थी।<verse eid="EZK 40:19" /></para>
  <para style="s">उत्तर दिशा रा द्वार</para>
  <para style="p">
    <verse number="20" style="v" sid="EZK 40:20" />ओर क्या देखेया कि उत्तरा रिया तरफा खे एक बड़ा द्वार था, जो बारले आँगणो ते जुड़ेया दा था। तिने तेसरी लम्बाई ओर चौड़ाई नापी, <verse eid="EZK 40:20" /><verse number="21" style="v" sid="EZK 40:21" />एती बी हर तरफा खे तीन पईरेदारा रे कमरे थे, जिना दे बांडणे वाल़िया कांदा ओर एक पीतरे जाणे वाल़ा बरांडा था। सारे नाप पूर्बो रे बड़े द्वारो ते मेल खाओ थे। पीतरे जाणे वाल़े दरवाजे री बाट साडे सतासी फुट लाम्बी ओर साडे तेताल़ी फुट चौड़ी थी, जो सामणे वाल़े पईरेदारा रे कमरेया री पिछली कांदा बीचे थी। <verse eid="EZK 40:21" /><verse number="22" style="v" sid="EZK 40:22" />इजी दे बी द्वारिया रे ओर खम्बेया रे आँगण ओर खजूरी री नपाई पूर्बो रे बड़े द्वारो री जी थी ओर एते पाँदे चढ़ने खे सात पैड़िया थिया ओर तिना सामणे एतेरा आँगणा था। <verse eid="EZK 40:22" /><verse number="23" style="v" sid="EZK 40:23" />जेड़ा पूर्बा रिया तरफा खे बड़ा द्वार था तेड़ा ई उत्तरा रिया तरफा खे बी था, जो मन्दरो रे पीतरले आँगणो रिया तरफा खे जाओ था, जो बारले बड़े द्वारो रे सामणे था। दुनी पीतरे आऊणे वाल़े द्वारा बीचली दूरी 175 फुट थी।<verse eid="EZK 40:23" /></para>
  <para style="s">दक्खणा रा बड़ा द्वार</para>
  <para style="p">
    <verse number="24" style="v" sid="EZK 40:24" />तेबे दशणे वाल़ा मर्द माखे दक्खणा रिया तरफा खे लईगा ओर तेती बी एक बड़ा द्वार था; ओर तिने एतेरे खम्बे ओर खम्बेया रा आँगण नापेया जो इना जेड़ा ई था। <verse eid="EZK 40:24" /><verse number="25" style="v" sid="EZK 40:25" />इजी दे कांदा साथे द्वारिया थिया, जेड़े तिना सबी दे थिया, ओर एक आऊणे रा कमरा था जेथा ते बड़े द्वारो री बाट बारे आँगणो खे खुलो थी। ओर सबी जेड़े, बड़े द्वारो री बाट साडे सतासी फुट लाम्बी ओर साडे तेताल़ी फुट चौड़ी थी जो सामणे बणे दे पईरेदारा रे कमरे रिया पिछली कांदा रे बीचे थी। <verse eid="EZK 40:25" /><verse number="26" style="v" sid="EZK 40:26" />इदे बी चढ़ने खे सात पैड़िया थिया ओर तिना सामणे खम्बेया री कांद थी ओर दुँईं कनारले खम्बेया पाँदे खजूरी रे डाल़ बणाई राखे थे। <verse eid="EZK 40:26" /><verse number="27" style="v" sid="EZK 40:27" />ओर एती बी, बारले बड़े द्वारो रे सामणे, एक ओर बड़ा द्वार था जो पीतरे आँगणो दे जाओ था। दुनी बड़े द्वारा बीचली दूरी 175 फुट थी।<verse eid="EZK 40:27" /></para>
  <para style="s">पितरले आँगणो रे तीन बड़े द्वार</para>
  <para style="p">
    <verse number="28" style="v" sid="EZK 40:28" />तेबे दशणे वाल़ा मर्द माखे दक्खणा रे बड़े द्वारो रिये ऊई की पीतरले आँगणो दे लईगा ओर तिने दक्खणा रा बड़ा द्वार नापेया जो ओरी जेड़ा ई था। <verse eid="EZK 40:28" /><verse number="29" style="v" sid="EZK 40:29" />इजी रा पईरेदारा रा कमरा, बीचलिया कांदा ओर ब्रंडा ओरी जेड़े ई आकारो रे थे। इजी रिया कांदा दे ओर ब्रंडे दे द्वारिया बी थिया। ओर ओरी जेड़े, आँगण साडे सतासी फुट लाम्बा ओर साडे तेताल़ी फुट चौड़ा था। <verse eid="EZK 40:29" /><verse number="30" style="v" sid="EZK 40:30" />पीतरले ब्रंडे दे चऊँ कनारे द्वार थे से ब्रंडा नौ फुट लाम्बा ओर साडे तेताल़ी फुट चौड़ा था। <verse eid="EZK 40:30" /><verse number="31" style="v" sid="EZK 40:31" />एते द्वारो खे पीतरे आऊणे रा ब्रंडा बारले आँगणो रिया तरफा खे था ओर इजी रे खम्बेया पाँदे बी खजूरी रे डाल़ बणी रे थे ओर बड़े द्वारो पाँदे चढ़ने खे आठ पैड़िया थिया।<verse eid="EZK 40:31" /></para>
  <para style="s">पितरला आँगण पूर्वो रा बड़ा द्वार</para>
  <para style="p">
    <verse number="32" style="v" sid="EZK 40:32" />तेबे दशणे वाल़ा मर्द माखे पूर्बो रिया तरफा खे पीतरले आँगणो दे लईगा ओर तेते तरफा रे बड़े द्वार नापे ओर सेयो बी तेड़े ई थे। <verse eid="EZK 40:32" /><verse number="33" style="v" sid="EZK 40:33" />इदे बी पईरेदारा रे कमरे, कांदा ओर ब्रंडा ओरी जेड़े ई आकारो रे थे, ओर कांदा साथे ब्रंडे दे द्वारिया थिया। आँगण साडे सतासी फुट लाम्बा ओर साडे तेताल़ी फुट चौड़ा था। <verse eid="EZK 40:33" /><verse number="34" style="v" sid="EZK 40:34" />इजी रा ब्रंडा बी बारले आँगणो रिया तरफा खे था ओर तेतेरे दुँईं कनारे खम्बेया पाँदे खजूरी रे डाल़ बणी रे थे ओर बड़े द्वारो पाँदे बी चढ़ने खे आठ पैड़िया थिया।<verse eid="EZK 40:34" /></para>
  <para style="s">पितरला आँगण उत्तरो रा बड़ा द्वार</para>
  <para style="p">
    <verse number="35" style="v" sid="EZK 40:35" />तेबे दशणे वाल़े मर्दे आऊँ उत्तरो रे बड़े द्वारो रिया तरफा खे निया ओर से नापेया ओर तेतेरा नाप बी ओरी जेड़ा ई था। <verse eid="EZK 40:35" /><verse number="36" style="v" sid="EZK 40:36" />तिदे बी बड़े द्वारो गे पईरेदारा रे कमरे, कांदा ओर ब्रंडे रा नाप ओरी बड़े द्वारा रे बराबर ई था ओर द्वारिया बी तिंयाँ ई ओरी जेड़िया थिया। बड़े द्वारो रा आँगण साडे सतासी फुट लाम्बा ओर साडे तेताल़ी फुट चौड़ा था। <verse eid="EZK 40:36" /><verse number="37" style="v" sid="EZK 40:37" />इजी रे खम्बेया रा ब्रंडा बारले आँगणो रिया तरफा खे था ओर इजी रे खम्बेया पाँदे बी खजूरी रे डाल़ बणी रे थे ओर बड़े द्वारो पाँदे चढ़ने खे आठ पैड़िया थिया।<verse eid="EZK 40:37" /></para>
  <para style="s">बलिदान त्यार करने रे कमरे</para>
  <para style="p">
    <verse number="38" style="v" sid="EZK 40:38" />तेबे बड़े द्वारो गे खम्बेया रे नेड़े द्वारो गे एक कमरा था, जेती पुरोईत डांगरा रिया लोथा खे तोई की तिना खे बलिया रे रूपो दे फूकी देयो थे। <verse eid="EZK 40:38" /><verse number="39" style="v" sid="EZK 40:39" />एते ब्रंडे दे चार मेज थे, कमरे रे हर तरफा खे दो-दो। इना मेजा पाँदे ई सेयो डांगरा खे काओ थे जिना खे पापबलिया रे रूपो दे चढ़ाया जाओ था, या तो तिना खे पूरा फुकी देयो थे या पापो रिया तँईं या फेर दोषबलिया खे बलि चढ़ाया जाओ थी। <verse eid="EZK 40:39" /><verse number="40" style="v" sid="EZK 40:40" />बड़े द्वारो रे बारले एक तरफा खे, मतलब उत्तरी द्वारो री चढ़ाईया पाँदे दो मेज थे ओर तेतेरे दूजे कनारे पाँदे बी, जो बड़े द्वारो रे ब्रंडे गे थी, दो मेज थे। <verse eid="EZK 40:40" /><verse number="41" style="v" sid="EZK 40:41" />इजी री खातर तेती कुल मलाई की आठ मेज थे जिना पाँदे बलि करने वाल़े डांगरो खे फाटेया जाओ था; चार कमरे रे पीतरे ओर चार बारे आँगणो दे, <verse eid="EZK 40:41" /><verse number="42" style="v" sid="EZK 40:42" />तेबे होमबलिया खे बी कअड़े रे पात्थरा रे चार मेज थे, जो साडे कत्ती ईंच लाम्बे, साडे कत्ती ईंच चौड़े ओर इक्की ईंच ऊच्चे थे, तिना मेजा पाँदे बलि करने वाल़े डांगरो खे फाटणे रिया तँईं छुरी ओर अथियार राखे जाओ थे। <verse eid="EZK 40:42" /><verse number="43" style="v" sid="EZK 40:43" />पीतरे चऊँ कनारे कांदा दे तीन ईंच लाम्बे ऊक लगी रे थे। ओर बलिदानो रा मास मेजा पाँदे राखेया जाओ था। <verse eid="EZK 40:43" /><verse number="44" style="v" sid="EZK 40:44" />पीतरले आँगणो रे उत्तरो दे बड़े द्वारो रे बारे गाणेवाल़ेया रे कमरे थे जिना रे द्वार दक्खणा रिया तरफा खे थे ओर पूर्वा दे बड़े द्वारो रिया तरफा खे एक कमरा था, जेतेरा द्वार उत्तरो रिया तरफा खे था। <verse eid="EZK 40:44" /><verse number="45" style="v" sid="EZK 40:45" />दशणे वाल़े मर्दे माखे बोलेया, “ये कमरा, जेतेरा द्वार दक्खणा रिया तरफा खे ए, तिना पुरोईता खे ए, जो मन्दरो री रखवाल़ी करोए। <verse eid="EZK 40:45" /><verse number="46" style="v" sid="EZK 40:46" />दक्खणा रे द्वारो रे नेड़े रा कमरा तिना पुरोईता खे ए जो बेदिया पाँदे परमेशरो री सेवा करोए। यो सादोक पुरोईतो री ल्वाद ए। सेयो लेविया रे वंशो रे ए जो यहोवे री सेवा-टईल करने रिया तँईं तेसरे नेड़े जाई सकोए।”<verse eid="EZK 40:46" /></para>
  <para style="s">पितरला आँगण ओर मन्दर</para>
  <para style="p">
    <verse number="47" style="v" sid="EZK 40:47" />फेर स्वर्दूतो जेड़े दशणे वाल़े माणूंए पितरला आँगण नापेया जो चकोर था, मतलब 175 फुट लाम्बा ओर 175 फुट चौड़ा था। बेदी मन्दरो रे सामणे आँगणो दे थी। <verse eid="EZK 40:47" /><verse number="48" style="v" sid="EZK 40:48" />फेर दशणे वाल़ा मर्द माखे मन्दरो रे पीतरे ब्रंडे दे लईगा। तिने ब्रंडे रे द्वारो रे दुँईं कनारलिया कांदा नापिया, ओर सेयो साडे आठ फुट मोटिया थिया। बड़ा द्वार साडे चौबी फुट चौड़ा था, ओर बड़े द्वारो रे हर तरफा खे कांदा साडे पाँज फुट जादा लाम्बिया थिया। <verse eid="EZK 40:48" /><verse number="49" style="v" sid="EZK 40:49" />ब्रंडा पैंती फुट चौड़ा ओर इक्की फुट गईरा था। इजी दे जाणे खे दस पैड़िया थिया, ओर हर तरफा खे एक खम्बा था।<verse eid="EZK 40:49" /></para>
  <chapter eid="EZK 40" />
  <chapter number="41" style="c" sid="EZK 41" />
  <para style="s">मन्दरो री लम्बाई-चौड़ाई</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 41:1" />इजी ते बाद से दशणे वाल़ा माणूं माखे मन्दरो रिया पवित्र जगा दे लईगा ओर तेते द्वारो रिया दुँईं कनारलिया कांदा नापिया, ओर सेयो दस-दस फुट मोटिया थिया। <verse eid="EZK 41:1" /><verse number="2" style="v" sid="EZK 41:2" />मन्दरो दे पीतरे जाणे रा द्वार साडे सतारा फुट चौड़ा था ओर द्वारो री दुँईं तरफा रिया कांदा नौ फुट लाम्बिया थिया। पवित्र जगा री लम्बाई सत्तर फुट ओर चौड़ाई पैंती फुट थी। <verse eid="EZK 41:2" /><verse number="3" style="v" sid="EZK 41:3" />फेर दशणे वाल़ा माणूं पवित्र जगा ते आगे कमरे दे गया। तेतेरे द्वारो रे दुँईं कनारलिया कांदा नापिया, ओर सेयो साडे तीन फुट मोटिया थिया। तेतेरा द्वार साडे दस फुट चौड़ा था, ओर तेते द्वारो रिया दुँईं कनारलिया कांदा साडे बारा फुट लाम्बिया थिया। <verse eid="EZK 41:3" /><verse number="4" style="v" sid="EZK 41:4" />पवित्र जगा रा पितरला कमरा पैंती फुट लाम्बा ओर पैंती फुट चौड़ा था। तिने माखे बोलेया, “ये परम पवित्र जगा ए।”<verse eid="EZK 41:4" /></para>
  <para style="s">मन्दरो रे कमरे</para>
  <para style="p">
    <verse number="5" style="v" sid="EZK 41:5" />तेबे दशणे वाल़े माणूंए मन्दरो री पीतरली कांद नापी जो साडे दस फुट मोटी थी बारलिया कांदा साथे कमरेया री एक लाईन थी हर कमरा सात फुट चौड़ा था। <verse eid="EZK 41:5" /><verse number="6" style="v" sid="EZK 41:6" />यो बारले कमरे तीन मञ्जला रे थे ओर एक-एक मईलो रे तीई-तीई कमरे थिया। मन्दरो रे नेड़े-तेड़े कांद इजी री खातर थी ताकि बारले कमरे तेतेरे सारे दे ओ ओर तिदे ई कमरे रिया कड़िया बठयाल़ी राखिया थिया ओर सेयो मन्दरो रे सारे दे नि थिया। <verse eid="EZK 41:6" /><verse number="7" style="v" sid="EZK 41:7" />मन्दरो रे नेड़े-तेड़े जो कमरे बारे थे, तिना बीचा ते जो पाँदे थे, सेयो बऊत चौड़े थे; मतलब मन्दरो रे नेड़े-तेड़े जो कुछ बणी रा था, से जिंयाँ-जिंयाँ पाँदो खे चढ़दा गया, तिंयाँ-तिंयाँ चौड़ा ऊँदा गया; ईंयाँ एस कअरो री चौड़ाई पाँदली तरफा खे बढ़ी री थी ओर लोक थालली मञ्जला बीचा ते पाँदली मञ्जला खे चढ़ी सको थे। <verse eid="EZK 41:7" /><verse number="8" style="v" sid="EZK 41:8" />मैं देखेया की मन्दर एकी ऊच्ची जगा पाँदे बणी रा था, जो साथले कमरेया खे निऊँआ रा काम करो था। ये चौक नापणे रे डण्डे बराबर साडे दस फुट ऊच्चा था। <verse eid="EZK 41:8" /><verse number="9" style="v" sid="EZK 41:9" />मन्दरो रे बारले कमरेया रिया कांदा साडे आठ फुट मोटिया थिया। इजी बजा ते इना साथले कमरेया बीचे एक खुली जगा बणी दी रओ थी। <verse eid="EZK 41:9" /><verse number="10" style="v" sid="EZK 41:10" />ओर पीतरले आँगणो री बारली कांदा साथे कमरे एकी लाईनी दे थे। ये खुली जगा पैंती फुट चौड़ी थी, ओर ये मन्दरो रे चऊँ कनारे रे फैली दी थी। <verse eid="EZK 41:10" /><verse number="11" style="v" sid="EZK 41:11" />साथो वाल़े दूई कमरे रे द्वार छतो वाल़े आँगणो दे खुलो थे, जो साडे आठ फुट चौड़ा था। एक द्वार उत्तर दिशा कनारो खे ओर दूजा द्वार दक्खण दिशा रिया तरफा खे था।<verse eid="EZK 41:11" /></para>
  <para style="s">पश्चिमो रिया तरफा रा भवन</para>
  <para style="p">
    <verse number="12" style="v" sid="EZK 41:12" />मन्दरो रे आँगणो रे सामणे पच्छमा रिया तरफा दे एक बड़ा भवन था, से 122 फुट चौड़ा था ओर 157 फुट लाम्बा था, ओर इजी रिया कांदा साडे आठ फुट मोटिया थिया।<verse eid="EZK 41:12" /></para>
  <para style="s">मन्दरो रा पूरा नाप</para>
  <para style="p">
    <verse number="13" style="v" sid="EZK 41:13" />फेर दशणे वाल़े माणूंए मन्दर नापेया, ओर देखेया कि ये 175 फुट लाम्बा था। भवनो रे चऊँ कनारे रा आँगण, जिदे इजी रिया कांदा बी थिया, 175 फुट लाम्बा था। <verse eid="EZK 41:13" /><verse number="14" style="v" sid="EZK 41:14" />पीतरे आँगणो रा पूर्वी इस्सा 175 फुट चौड़ा था। इदे मन्दरो रा आगे वाल़ा इस्सा बी आओ था। <verse eid="EZK 41:14" /><verse number="15" style="v" sid="EZK 41:15" />पच्छमा रिया तरफा रा भवन, जेते दे इजी रिया दो कांदा बी आओईया, से 175 फुट चौड़ा था।<verse eid="EZK 41:15" /></para>
  <para style="s">मन्दरो री सजावट</para>
  <para style="p">
    <verse number="16" style="v" sid="EZK 41:16" />तेबे तिने देऊल़ी ओर झिलमिलदार द्वारिया ओर नेड़े-तेड़े री तीनो मञ्जला रे छाज्जे नापे जो देऊल़ी सामणे थे ओर सेयो चऊँ कनारो ते तख़्तेया साथे बन्द थे ओर जमीना ते द्वारिया तक ओर द्वारिया रे नेड़े-तेड़े हर जगा तख़्तेया साथे बन्द थे। <verse eid="EZK 41:16" /><verse number="17" style="v" sid="EZK 41:17" />तेबे तिने द्वारो री पाँदली जगा पीतरले मन्दरो तक ओर तेतेरे बारे बी ओर नेड़े-तेड़े री सारिया कांदा पीतरे ओर बारे बी नापेया। <verse eid="EZK 41:17" /><verse number="18" style="v" sid="EZK 41:18" />तिदे करूब ओर खजूरी रे डाल़ एड़े बणी रे थे कि दो-दो करूबा बीचे एक-एक खजूरी रा डाल़ था ओर हर एकी करूबो रे दो-दो मूँ थे। <verse eid="EZK 41:18" /><verse number="19" style="v" sid="EZK 41:19" />एक मूँ आदमिए रा था जो एकी तरफा ते खजूरो रे डाल़ो खे देखणे लगी रा। दूजा मूँ एकी जवान शेरो रा था, जो दूजे कनारा ते खजूरो रे डाल़ो खे देखो था। मन्दरो रे पीतरे सारे जगा दे चित्र बणाई राखे थे। <verse eid="EZK 41:19" /><verse number="20" style="v" sid="EZK 41:20" />जमीना ते लई की द्वारो पाँदो तक करूब ओर खजूरी रे डाल़ बणी रे थे। मन्दरो रे सामणे बड़े कमरे री कांद ईंयाँ बणी री थी।<verse eid="EZK 41:20" /></para>
  <para style="s">लकड़िया री बेदी</para>
  <para style="p">
    <verse number="21" style="v" sid="EZK 41:21" />मन्दरो रे द्वारो रे खम्बे चकौर थे ओर पवित्र जगा रे सामणे रा रूप मन्दरो जेड़ा था। <verse eid="EZK 41:21" /><verse number="22" style="v" sid="EZK 41:22" />तेती लकड़िया री बणी री एक बेदी थी, जो पाँज फुट ऊच्ची ओर साडे तीन फुट चौड़ी थी। इजी रे कुणे, थाली ओर कनारिया सब लकड़िया रिया बणी रिया थिया। तिने माणूंए माखे बोलेया, “ये से मेज ए जो परमेशरो रे सामणे खड़ी री ए।”<verse eid="EZK 41:22" /></para>
  <para style="s">पवित्र जगा रे द्वार</para>
  <para style="p">
    <verse number="23" style="v" sid="EZK 41:23" />सामणे रे कमरे दे दो द्वार थे। परम पवित्र जगा दे बी दोरे द्वार थे। <verse eid="EZK 41:23" /><verse number="24" style="v" sid="EZK 41:24" />ओर हर एक दरवाजे रे दो-दो मुड़ने वाल़े फल़े थे, हर एक दरवाजे खे दो-दो फल़े थे। <verse eid="EZK 41:24" /><verse number="25" style="v" sid="EZK 41:25" />पवित्र जगा रे द्वारो पाँदे बी खजूरी रे डाल़ ओर पंखा वाल़े करूब बणी रे थे, ओर ब्रंडे रे द्वारो रिया बारली तरफा खे लकड़िया दे नक्काशी थी। <verse eid="EZK 41:25" /><verse number="26" style="v" sid="EZK 41:26" />ब्रंडे रे दुँईं कनारे झिलमिलदार द्वारिया थिया ओर खजूरी रे डाल़ बणी रे थे बारले कनारलिया कांदा साथे लगे दे कमरेया दे छत बणी रे थे।<verse eid="EZK 41:26" /></para>
  <chapter eid="EZK 41" />
  <chapter number="42" style="c" sid="EZK 42" />
  <para style="s">पुरोईता रिया तँईं कमरे</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 42:1" />तेबे दशणे वाल़ा माणूं माखे बारले आँगणो दे मन्दरो रे उत्तरो रिया तरफा खे लईगा ओर माखे तिना दूई कमरेया गे ल्याया जो मन्दरो रे आँगणो सामणे ओर तेतेरी उत्तरो रिया तरफा खे थे। <verse eid="EZK 42:1" /><verse number="2" style="v" sid="EZK 42:2" />ये भवन, जेतेरा द्वार उत्तरो रिया तरफा खे खुलो था, 175 फुट लाम्बा ओर साडे सतासी फुट चौड़ा था। <verse eid="EZK 42:2" /><verse number="3" style="v" sid="EZK 42:3" />कमरेया रा एक इस्सा पीतरले आँगणो रे सामणे पैंती फुट चौड़ा था। कमरेया रा दूजा कनारा आँगणो रिया बाटा कनारो खे था। दुनी तरफा रे कमरे तीऊँ-तीऊँ मञ्जला रे बणाई राखे थे ओर एकी दूजे रे आमणे-सामणे खड़ी रे थे। <verse eid="EZK 42:3" /><verse number="4" style="v" sid="EZK 42:4" />कमरेया रे बीचे खाली जगा दे साडे सतारा फुट चौड़ी बाट थी। ये पूरी जगा दे 175 फुटा तँईं खे फैलेया दा था, ओर सारे द्वार उत्तरा रिया तरफा खे थे। <verse eid="EZK 42:4" /><verse number="5" style="v" sid="EZK 42:5" />पाँदलिया कमरे छोटिया थिया, मतलब छाज्जेया री बजा ते सेयो थालली ओर बीचली कमरे ते छोटिया थिया। <verse eid="EZK 42:5" /><verse number="6" style="v" sid="EZK 42:6" />कऊँकि सेयो कमरे तीऊँ मञ्जला रे थे ओर आँगणो सामणे तिना रे खम्बे नि थे; इजी बजा ते पाँदलिया कमरे थालली ओर बीचली कमरे ते छोटिया थिया। <verse eid="EZK 42:6" /><verse number="7" style="v" sid="EZK 42:7" />एक बारली कांद थी जो कमरेया खे बारले आँगणो ते लग करो थी; ये साडे सतासी फुट लाम्बी थी। <verse eid="EZK 42:7" /><verse number="8" style="v" sid="EZK 42:8" />एसे कांदे कमरेया रे बारले इस्से री लम्बाई बढ़ाईती दी ए, जो सिर्फ साडे सतासी फुटा तक फैली रा था, जबकि पितरला इस्सा मतलब मन्दरो रिया तरफा रे कमरे 175 फुटा तक फैली रे थे। <verse eid="EZK 42:8" /><verse number="9" style="v" sid="EZK 42:9" />इना कमरे ते थाले पूर्बो रिया तरफा खे बाट थी, जेती लोक बारले आँगणो ते इना दे जाओ थे। <verse eid="EZK 42:9" /><verse number="10" style="v" sid="EZK 42:10" />मन्दरो रिया दक्खणा रिया तरफा खे पितरले आँगणो रे सामणे दो कमरे थे जो मन्दरो रे बारले आँगणो बीचे थे। ये कमरे उत्तरा रिया तरफा रे कमरेया जेड़े ई बणी रे थे। <verse eid="EZK 42:10" /><verse number="11" style="v" sid="EZK 42:11" />तिना रे सामणे री बाट उत्तरी कमरे री बाटा जेड़ी थी, तिना री लम्बाई-चौड़ाई एक बराबर थी, पीतरे आऊणे ओर बारे निकल़ने रा टंग तिना रे द्वारो जेड़ा था। <verse eid="EZK 42:11" /><verse number="12" style="v" sid="EZK 42:12" />दक्खण कमरे रे द्वारो रे मुताबिक बाटा रे सिरे पाँदे द्वार था, मतलब पूर्बो रिया तरफा री कांदा सामणे, जेथा ते लोक तिना दे जाओ थे। <verse eid="EZK 42:12" /><verse number="13" style="v" sid="EZK 42:13" />तेबे दशणे वाल़े माणूंए माखे बोलेया, “यो उत्तरी ओर दक्खणी कमरे जो आँगणो सामणे ए, सेयो ई पवित्र कमरे ए, जिना दे यहोवे रे नेड़े जाणे वाल़े पुरोईता बऊत पवित्र चीजा खाया करनिया, सेयो बऊत पवित्र चीजा, नज्जो री बलि, पापबलि ओर दोषबलि, तेथी राखणियां; कऊँकि से जगा पवित्र ए। <verse eid="EZK 42:13" /><verse number="14" style="v" sid="EZK 42:14" />जेबे पुरोईत मन्दरो रे पीतरे आईगे दे ओ ओर सेयो बारे जाणा चाओ, तो पवित्र जगा ते बारले आँगणो दे ईंयाँ ई नि निकल़ेया करने, मतलब तिना पईले यहोवे री सेवा-टईल करने वाल़े टाल्ले पवित्र जगा दे राखी देणे; कऊँकि सेयो कमरे पवित्र ए। तेबे तिना रोजके टाल्ले पईनी की आम लोका री जगा दे जाणा।”<verse eid="EZK 42:14" /></para>
  <para style="s">मन्दरो री बारली लम्बाई-चौड़ाई</para>
  <para style="p">
    <verse number="15" style="v" sid="EZK 42:15" />जेबे दशणे वाल़ा माणूं मन्दरो रे पीतरले सारे कमरे नापी चुकेया, तेबे माखे पूर्ब दिशा रे बड़े द्वारो री बाटा ते बारे लई जाई की बारली जगा चऊँ कनारो ते नापणे लगेया। <verse eid="EZK 42:15" /><verse number="16" style="v" sid="EZK 42:16" />दशणे वाल़े माणूंए पूर्बो रिया तरफा खे नापणे रे बैंजो साथे नापेया, जो 875 फूटो रे बराबर था। <verse eid="EZK 42:16" /><verse number="17" style="v" sid="EZK 42:17" />तिने माणूंए आपणे नापणे रा डण्डा लई की उत्तर दिशा रा इस्सा नापेया ओर से 875 फुट लाम्बा निकल़ेया। <verse eid="EZK 42:17" /><verse number="18" style="v" sid="EZK 42:18" />तिने माणूंए आपणे नापणे रा डण्डा लई की दक्खणा रिया तरफा खे नापणे जो 875 फुट लाम्बा था। <verse eid="EZK 42:18" /><verse number="19" style="v" sid="EZK 42:19" />बादो ते तिने माणूंए आपणे नापणे रा डण्डा लई की पच्छमा कनारो खे मुड़ी की नापेया। जो 875 फुट लाम्बा था। <verse eid="EZK 42:19" /><verse number="20" style="v" sid="EZK 42:20" />ईंयाँ तिने दशणे वाल़े माणूंए नापेया ओर से जगा चऊँ कनारा ते बराबर थी मतलब नापणे रे डण्डे रे मुताबिक 875 फुट थी। एतेरे चऊँ कनारे एक कांद थी जो पवित्र जगा ओर आम जगा खे लग करो थी।<verse eid="EZK 42:20" /></para>
  <chapter eid="EZK 42" />
  <chapter number="43" style="c" sid="EZK 43" />
  <para style="s">मन्दर, परमेशरो रे रणे री जगा</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 43:1" />फेर दशणे वाल़ा माणूं माखे तेस बड़े द्वारो गे लईगा, जेतेरा मूरा मन्दरो रे पूर्बो रिया तरफा खे था। <verse eid="EZK 43:1" /><verse number="2" style="v" sid="EZK 43:2" />तेबे इस्राएलो रे परमेशरो रे ऊणे रा तेज पूर्ब दिशा ते आया ओर तेसरी बाणी बऊत सारे पाणिए रे शादो जेड़ी ऊई ओर तेसरे तेजो ते सारी तरतिया दे प्रयासा ऊईगा।<note caller="+" style="f"><char style="fr" closed="false">43:2 </char><char style="ft" closed="false">प्रका. 19:6</char></note> <verse eid="EZK 43:2" /><verse number="3" style="v" sid="EZK 43:3" />ये दर्शण तेस दर्शणो जेड़ा था, जो मैं यरूशलेम शईरो रे नाश ऊणे खे परमेशर आऊँदे बखते देखेया था ओर तेस दर्शणो जेड़ा, जो मैं कबार नदिया रे कनारे देखेया था। तेबे मैं आपणा मूँ जमीना रिया तरफा खे थाले करिता। <verse eid="EZK 43:3" /><verse number="4" style="v" sid="EZK 43:4" />तेबे यहोवे रा तेज तेस बड़े द्वारो दे ते ऊई की जो पूर्बो रिया तरफा खे था, मन्दरो दे आई गा। <verse eid="EZK 43:4" /><verse number="5" style="v" sid="EZK 43:5" />तेबे यहोवे रे आत्मे आऊँ चकी की मन्दरो रे पीतरले आँगणो दे पऊँचाया ओर यहोवे रा तेज मन्दरो दे परीगा था। <verse eid="EZK 43:5" /><verse number="6" style="v" sid="EZK 43:6" />तेबे मैं एक माणूंए री आवाज सुणी, जो मन्दरो ते माखे बोलणे लगी रा था ओर दशणे वाल़ा माणूं मेरे एकी कनारे खड़ी रा था। <verse eid="EZK 43:6" /><verse number="7" style="v" sid="EZK 43:7" />तिने माखे बोलेया, “ओ नाश ऊणे वाल़े माणूंआ, यहोवे री ये बाणी ए कि ये तो मेरे सिंहासनो री जगा ओर मेरे पैर राखणे री जगा ए, जेती मां इस्राएलो बीचे सदा वास करी की रणा ओर ना तो इस्राएलो रे कराने ओर ना तेसरे राजे आपणे व्याभिचारो ते या आपणी ऊच्ची जगा रे आपणे राजेया री लाशा खे दबाई की मेरा नाओं फेर अशुद्ध करना। <verse eid="EZK 43:7" /><verse number="8" style="v" sid="EZK 43:8" />इस्राएलो रे राजा आपणी देऊल़ी मेरिया देऊल़ी रे नेड़े ओर आपणे द्वारो रे खम्बे मेरे द्वारो रे खम्बेया रे नेड़े बणाओ थे ओर मां ओर तिना बीचे बस कांद ई थी ओर तिने आपणे घिनौने कामो साथे मेरा पवित्र नाओं अशुद्ध ठराया था; इजी री खातर मैं रोषो रे आई की सेयो नाश करीते।” <verse eid="EZK 43:8" /><verse number="9" style="v" sid="EZK 43:9" />एबे सेयो आपणे मूर्तिया री पूजा रे जरीये व्याभिचार ओर आपणे राजेया री लाशा मेरे सामणे ते दूर करी देयो, तेबे मां तिना बीचे सदा वास करी की राखणा। <verse eid="EZK 43:9" /><verse number="10" style="v" sid="EZK 43:10" />ओर यहोवे आगे बोलेया, “ओ नाश ऊणे वाल़े माणूंआ, ताखे इस्राएलो रे लोका खे एस मन्दरो रे बारे दे बताणा चाईयो। इजी ते तिना खे आपणे पापा पाँदे शर्म आऊणी चाईयो। तिना मन्दरो रे नमूने रे बारे दे खोजबीन करनी चाईयो। <verse eid="EZK 43:10" /><verse number="11" style="v" sid="EZK 43:11" />जे सेयो आपणे सारे कामो ते शर्मिंदा ओ ओर तिना खे एस मन्दरो रा आकार, रूप ओर एतेरे बारे-पीतरे आऊणे जाणे री बाट ओर एतेरे सारे आकार, बिदिया, नियम बताणा ओर तिना सामणे लिखी की राखणा; जेते कि सेयो इजी रा सारा आकार ओर तिना बिधिया रा ईमानदारिया ते पालण करो। <verse eid="EZK 43:11" /><verse number="12" style="v" sid="EZK 43:12" />मन्दरो रा बिधान ये कि पाह्ड़ो री चूँडिया रे चऊँ कनारे सारी जगा बऊत पवित्र मानणी ए। देख, मन्दरो रा येई बिधान ए।”<verse eid="EZK 43:12" /></para>
  <para style="s">बेदिया री बणावट</para>
  <para style="p">
    <verse number="13" style="v" sid="EZK 43:13" />बेदिया रा नाप ये ए: बेदिया रे चऊँ कनारे इक्की ईंच डूगी ओर इक्की ईंच चौड़ी नाल़ी ए, जेते रे कनारे पाँदे नौ ईंच चौड़ी एक पट्टी ए। ओर ये बेदिया री ऊचाई ए, <verse eid="EZK 43:13" /><verse number="14" style="v" sid="EZK 43:14" />नाल़िया ते बेदी साडे तीन फुट ऊबे उठी की एक ऊँदले कनारे पाँदे पऊँचोई जो बेदिया खे केरी राखोई ओर इक्की ईंच चौड़ा ए। ऊँदले कनारा ते बेदी सात फुट ऊबे उठी की उबले कनारे पाँदे पऊँचोई से बी इक्की ईंच चौड़ा ए, <verse eid="EZK 43:14" /><verse number="15" style="v" sid="EZK 43:15" />से उबला इस्सा, बेदिया री चूल, जेते पाँदे बलि फुकी जाओ थी सात फुट ऊच्ची ओई, जेतेरे चारो कूणेया ते एक-एक सींग निकल़ोआ। <verse eid="EZK 43:15" /><verse number="16" style="v" sid="EZK 43:16" />बेदिया री चूँडी चौरस ए, जेतेरा नाप इक्की फुट लाम्बा ओर इक्की फुट चौड़ा ए।<note caller="+" style="f"><char style="fr" closed="false">43:16 </char><char style="ft" closed="false">यहे. 27:1</char></note> <verse eid="EZK 43:16" /><verse number="17" style="v" sid="EZK 43:17" />उबला कनारा बी चौरस आकारो रा बणोआ, जेतेरा नाप साडे चौबी फुट लाम्बा ओर साडे चौबी फुट चौड़ा ए, जेतेरे कनारे पाँदे इक्की ईंचो रा गटर ओर साडे दस ईंचो रा मोड़ ए। बेदिया रे पूर्बो रे इस्से दे ऊबे जाणे खे पैड़िया ए।<verse eid="EZK 43:17" /></para>
  <para style="s">बेदिया रा अर्पण</para>
  <para style="p">
    <verse number="18" style="v" sid="EZK 43:18" />तेबे यहोवे माखे बोलेया, “ओ नाश ऊणे वाल़े माणूंआ, परमेशर यहोवा ईंयाँ बोलोआ, जेस दिने होमबलि चढ़ाणे ओर खून छिड़कणे खे बेदी बणाओ, तेस दिनो रिया बिधिया यो ऊणिया चाईयो। <verse eid="EZK 43:18" /><verse number="19" style="v" sid="EZK 43:19" />मतलब लेवी गोत्रो रे सेयो पुरोईत जो सादोको रे वंशो ते ए, सिर्फ तिना ई मेरे नेड़े आई की मेरी सेवा-टईल करेया करनी, तिना खे तैं पापबलिया खे एक बाच्छू देणा, परमेशर यहोवे री येई बाणी ए। <verse eid="EZK 43:19" /><verse number="20" style="v" sid="EZK 43:20" />तेबे तैं तेसरे खूनो बीचा ते थोड़ा जा लई की बेदिया रे चारो सींगा पाँदे ओर कुर्सिया रे चारो कूणेया ओर चारो फटिया रे लगाई देणा; ईंयाँ बेदिया रिया तँईं प्राश्चित करी की से पवित्र करनी। <verse eid="EZK 43:20" /><verse number="21" style="v" sid="EZK 43:21" />तेबे पापबलिया रा बाच्छू लई की, मन्दरो री पवित्र जगा ते बारे ठराई री जगा रे फूकी देणा। <verse eid="EZK 43:21" /><verse number="22" style="v" sid="EZK 43:22" />दूजे दिने एक निर्दोष बाकरा पापबलि करी की चढ़ाणा ओर जिंयाँ बाच्छूए रे जरीये बेदी पवित्र करनी, तिंयाँ ई से एस बाकरे रे जरीये बी पवित्र करनी।<note caller="+" style="f"><char style="fr" closed="false">43:22 </char><char style="ft" closed="false">दूजा दिन तेस दिनो खे बताओआ जेबे यहेजकेल बेदिया खे पवित्र करना शुरू करोआ </char></note> <verse eid="EZK 43:22" /><verse number="23" style="v" sid="EZK 43:23" />जेबे तूँ तेसा खे पवित्र करी देओ, तेबे तैं एक निर्दोष बाच्छू ओर एक निर्दोष खाडू चढ़ाणा। <verse eid="EZK 43:23" /><verse number="24" style="v" sid="EZK 43:24" />तैं बल़द ओर खाड्डू मन्दरो दे पेंटा रे रूपो दे चढ़ाणे ओर यहोवे रे सामणे ल्याऊणे ओर पुरोईत लोक तिना दे लूण पायी की तिना खे यहोवे खे होमबलि करी की चढ़ाओ। <verse eid="EZK 43:24" /><verse number="25" style="v" sid="EZK 43:25" />फेर साता दिना तक हर दिन पुरोईतो गे एक बाकरा पापबलिया खे बलि करी की चढ़ाणा, ताकि से बेदिया खे मेरिया तँईं ग्रहण करने जोगी बणाओ। ओर एक बाच्छू ओर एक खाडू बी बलि करने, जो निर्दोष ओ। <verse eid="EZK 43:25" /><verse number="26" style="v" sid="EZK 43:26" />साता दिना तक पुरोईत लोक बेदिया खे प्राश्चित करी की शुद्ध करदे रओ; ईंयाँ तेसा रा संस्कार ओ। <verse eid="EZK 43:26" /><verse number="27" style="v" sid="EZK 43:27" />जेबे पुरोईत बेदिया री शुद्धिया रे तिना साता दिना खे पूरा करी लो, तेबे आठुए दिनो ते बादो ते पुरोईत लोक तुसा रे होमबलि ओर मेलबलि बेदिया पाँदे चढ़ाया करो; तेबे आऊँ तुसा ते खुश ऊणा, परमेशर यहोवे री येई बाणी ए।”<verse eid="EZK 43:27" /></para>
  <chapter eid="EZK 43" />
  <chapter number="44" style="c" sid="EZK 44" />
  <para style="s">पूर्बा रे दरवाजे रा इस्तेमाल</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 44:1" />फेर दर्शणो दे से माणूं माखे मन्दरो रे बारले द्वारो गे लईगा, जो पूर्बो रिया तरफा खे था, पर बारला द्वार बन्द था। <verse eid="EZK 44:1" /><verse number="2" style="v" sid="EZK 44:2" />तेबे यहोवे माखे बोलेया, “ये बड़े द्वार बन्द रओ ओर खोलणा नि; कोई एते ते ऊई की पीतरे नि जाओ; कऊँकि इस्राएलो रा परमेशर यहोवा एते रिये ऊई की पीतरे आई रा; इजी बजा ते ये सदा खे बन्द रणा चाईयो। <verse eid="EZK 44:2" /><verse number="3" style="v" sid="EZK 44:3" />इस्राएलो रा परदान मेरिया तँईं चढ़ाए दे बलिदानो खे खाणे खे एती आई सकोआ। से बड़े द्वारो रे ब्रंडे रिये ऊई की पीतरे जाओ ओर इसिये ई ऊई की बारे निकल़ो।”<verse eid="EZK 44:3" /></para>
  <para style="s">मन्दरो दे जाणे रे बारे दे</para>
  <para style="p">
    <verse number="4" style="v" sid="EZK 44:4" />तेबे से उत्तरो रे बड़े द्वारो गे ऊई की माखे मईलो सामणे लईगा; तेबे मैं देखेया कि यहोवे री महिमा रा तेज तेसरे मन्दरो दे परी गा रा ए। ओर आऊँ डर ओर कबराणे रिया बजा ते थाले जमीना पाँदे लेटीगा।<note caller="+" style="f"><char style="fr" closed="false">44:4 </char><char style="ft" closed="false">प्रका. 15:8</char></note> <verse eid="EZK 44:4" /><verse number="5" style="v" sid="EZK 44:5" />तेबे यहोवे माखे बोलेया, “ओ नाश ऊणे वाल़े माणूंआ, त्यान देई की आपणी आखी साथे देख ओर जो कुछ आऊँ ताखे आपणे मन्दरो री सारी बिदिया ओर नियमो रे बारे दे बोलूँ, से सब आपणे कानो साथे सुण ओर मन्दरो रे सारे बड़े द्वार ओर पवित्र जगा दे सब जाणे वाल़ी बाटा पाँदे त्यान दे। <verse eid="EZK 44:5" /><verse number="6" style="v" sid="EZK 44:6" />ओर तिना बिरोदिया खे, मतलब इस्राएलो रे कराने खे बोलणा, परमेशर यहोवा ईंयाँ बोलोआ: ओ इस्राएलो रे कराने, आपणे सारे घिनौने कामा ते एबे पीछे अटी जा। <verse eid="EZK 44:6" /><verse number="7" style="v" sid="EZK 44:7" />तिने मेरा मन्दर अपवित्र करी राखेया ए, कऊँकि तिने बिना खतने रे परदेशी लोक मेरे मन्दरो दे आऊणे देई राखे जो मेरी आज्ञा खे नि मानदे, जेबे कि बलिया री चर्बी ओर खून माखे चढ़ाणे लगी रे थे। इजी री खातर मेरे लोके आपणे सारे बुरे कामा रिया बजा ते मेरी आज्ञा तोड़ी राखी।<note caller="+" style="f"><char style="fr" closed="false">44:7 </char><char style="ft" closed="false">यहे. 1:28</char></note> <verse eid="EZK 44:7" /><verse number="8" style="v" sid="EZK 44:8" />तुसे मेरी पवित्र चीजा री रक्षा नि कित्ती, पर तुसे आपणे ई मनो ते दूजिया जातिया रे लोक मेरी पवित्र जगा दे मेरी पवित्र चीजा री रक्षा करने खे ठराए। <verse eid="EZK 44:8" /><verse number="9" style="v" sid="EZK 44:9" />इजी री खातर परमेशर यहोवा ईंयाँ बोलोआ: इस्राएलिया बीचे कोई दूजी जातिया रे लोक, बिना खतना कित्ते रे लोक ओर पापी लोका खे मेरे मन्दरो दे आऊणे री अनुमति नि ए। एथो तक कि कोई दूजी जातिया रे लोक जो तुसा बीचे काफी बखतो ते रओए, तिना खे बी मेरे मन्दरो दे आऊणे री अनुमति नि ए।”<verse eid="EZK 44:9" /></para>
  <para style="s">लेवी, पुरोईत ऊणे खे लग कित्ते</para>
  <para style="p">
    <verse number="10" style="v" sid="EZK 44:10" />यहोवे माखे बोलेया, “पर लेवी लोक जो तेस बखते मांते दूर ऊईगे थे, जेबे इस्राएली लोक माखे छाडी की आपणी मूर्तिया पीछे पटकी गे थे, तिना खे आपणे पापा री सजा जरूर मिलणी। <verse eid="EZK 44:10" /><verse number="11" style="v" sid="EZK 44:11" />पर सेयो मेरे पवित्र मन्दरो दे सेवा करी सकोए। सेयो मन्दरो रे द्वारो पाँदे पईरा देणे वाल़े ऊई सकोए। सेयो तिना डांगरा खे कायी सकोए जिना खे लोक होमबलि ओर मेलबलिया खे ल्याओए। सेयो तिना लोका री मताद करी सकोए जो मेरी सेवा-टईल करने खे आओए।” <verse eid="EZK 44:11" /><verse number="12" style="v" sid="EZK 44:12" />कऊँकि इने लेविये इस्राएलो रे लोका री सेवा-टईल कित्ती जेबे सेयो मूर्तिया री पूजा करो थे, ओर इस्राएलो रे लोक पापो दे फसाईते, इजी बजा ते मैं तिना रे बारे दे कसम खाई कि तिना लेविया आपणे पापा री सजा जरूर पाणी। परमेशर यहोवे री येई बाणी ए। <verse eid="EZK 44:12" /><verse number="13" style="v" sid="EZK 44:13" />सेयो लेवी मेरे नेड़े नि आओ ओर ना मेरिया तँईं पुरोईता रा काम करो ओर ना मेरी केसी पवित्र चीजा खे या केसी बऊत पवित्र चीजा खे छुँईं सको, सेयो आपणी शर्मा रा ओर जो घिनौने काम तिने कित्ते, तिना रा बी पार चको। <verse eid="EZK 44:13" /><verse number="14" style="v" sid="EZK 44:14" />तेबे बी मां सेयो मन्दरो री सम्बाल़ी री चीजा रे रक्षा करने वाल़े ठराणे; तिदे सेवा रा जितणा काम ओ ओर जो कुछ तिदे करना ओ, तेतेखे करने वाल़े सेयो ई ओ।<verse eid="EZK 44:14" /></para>
  <para style="s">पुरोईत</para>
  <para style="p">
    <verse number="15" style="v" sid="EZK 44:15" />तेबे लेवी पुरोईत जो सादोको रे कराने रे ए ओर जिने तेस बखते मेरी पवित्र जगा री रक्षा कित्ती जेबे इस्राएली मांगा गे ते पटकी गे थे, सिर्फ सादोक पुरोईतो रे परिवारो रे पुरोईत ई मेरे मन्दरो दे मेरी सेवा करो थे। इजी री खातर एबे सादोको रे वंशो रे माखे बलिया री चर्बी ओर खून चढ़ाई सकोए, परमेशर यहोवे री येई बाणी ए। <verse eid="EZK 44:15" /><verse number="16" style="v" sid="EZK 44:16" />सेयो पुरोईत मेरे मन्दरो दे आया करो ओर मेरे मेजो गे मेरी सेवा-टईल करने खे आओ ओर मेरी चीजा री रक्षा करो। <verse eid="EZK 44:16" /><verse number="17" style="v" sid="EZK 44:17" />जेबे सेयो पीतरले आँगणो रे बड़े द्वारो रिये ऊई की जाया करो, तेबे लीलणी रे टाल्ले पईनी की जाओ ओर जेबे सेयो तिदे सेवा-टईल करो, तेबे कोई ऊना रा टाल्ला नि पईनो। <verse eid="EZK 44:17" /><verse number="18" style="v" sid="EZK 44:18" />सेयो सिरो पाँदे सणो रिया सुन्दर टोपिया पईनो ओर लको दे सणो रे कच्छे पईनो; सेयो आपणे लको रे एड़ा कोई रेशमो रा टाल्ला नि बानो जेते साथे परसीना आओआ। <verse eid="EZK 44:18" /><verse number="19" style="v" sid="EZK 44:19" />जेबे सेयो पुरोईता रे टाल्ले पईनी की बारले आँगणो दे लोका गे निकल़ो, तेबे जिना टाल्ले पईनी की सेयो सेवा-टईल करोए, तिना खे खोली की ओर पवित्र कमरे दे राखी की आपणे रोजके टाल्ले पईनो, जेते कि लोक तिना रे टाल्लेया रिया बजा ते पवित्र नि ठईरो। <verse eid="EZK 44:19" /><verse number="20" style="v" sid="EZK 44:20" />पुरोईत ना तो आपणा सिर गँजा कराओ ओर ना बाल़ लाम्बे ऊणे देयो; सेयो बस आपणे बाल़ छोटे करी की कटाओ। <verse eid="EZK 44:20" /><verse number="21" style="v" sid="EZK 44:21" />पीतरले आँगणो रे जांदे बखते कोई पुरोईत शराब नि पियो। <verse eid="EZK 44:21" /><verse number="22" style="v" sid="EZK 44:22" />सेयो बिदुआ या छाडी री जवाणसा साथे ब्या नि करो; बस इस्राएलो रे कराने रे कुलो बीचा ते कुआँरी या एड़ी बिदुआ साथे ब्या करो जो केसी पुरोईतो री जवाणस ऊई थी। <verse eid="EZK 44:22" /><verse number="23" style="v" sid="EZK 44:23" />पुरोईत मेरी प्रजा खे पवित्र ओर अपवित्र रा फर्क सिखाया करो ओर शुद्ध ओर अशुद्ध रा फर्क बताया करो। <verse eid="EZK 44:23" /><verse number="24" style="v" sid="EZK 44:24" />जेबे कोई मुकद्दमा ओ तेबे न्याय करने खे बी सेयो ई बैठो ओर मेरे नियमो रे मुताबिक न्याय करो। मेरे सारे ठराए रे त्योआरो रे बारे दे बी सेयो मेरे बिधान ओर बिधिया रा पालण करो ओर मेरे रामो रे दिनो खे पवित्र मानो। <verse eid="EZK 44:24" /><verse number="25" style="v" sid="EZK 44:25" />पुरोईत केसी माणूंए री लाशा गे नि जाओ, एड़ा करने ते सेयो अशुद्ध ऊई जाणे। पर जे मरने वाल़ा माणूं तिना रा माये-बाओ, माठे-बेटी, पाई ओर एड़ी बईण जेसा रा ब्या नि ऊई रा ओ, सेयो तिना गे जाई की आपू खे अशुद्ध करी सकोए। <verse eid="EZK 44:25" /><verse number="26" style="v" sid="EZK 44:26" />जे कोई पुरोईत लाशा खे छूँओ, तो से अशुद्ध ऊई जाओआ ओर तेसखे शुद्ध करने खे एकी बिधानो ते निकल़ना पड़ोआ। <verse eid="EZK 44:26" /><verse number="27" style="v" sid="EZK 44:27" />ओर जेस दिने सेयो पवित्र मन्दरो दे, मतलब पीतरले आँगणो दे सेवा-टईल करने खे फेर जाओ, तेस दिन आपणियां तँईं पापबलि चढ़ाओ, परमेशर यहोवे री येई बाणी ए। <verse eid="EZK 44:27" /><verse number="28" style="v" sid="EZK 44:28" />पुरोईता री एक ई आपणी जमीन ऊणी, मतलब तिना रा इस्सा आऊँ ईए; तुसे तिना खे इस्राएलो बीचे कोई एड़ी जमीन नि देणी, जो तिना री आपणी ऊई जाओ; तिना री आपणी जमीन आऊँ ईए। <verse eid="EZK 44:28" /><verse number="29" style="v" sid="EZK 44:29" />एतेरे बजाये तिना खे नज्जो री बलिया रा इस्सा मिलणा चाईयो साथे ई पापबलि ओर दोषबलिया दे बी इस्सा मिलणा चाईयो। <verse eid="EZK 44:29" /><verse number="30" style="v" sid="EZK 44:30" />सब प्रकारा री सबी ते पईली उपज ओर सब प्रकारा री चकी री पेंट जो तुसे चकी की चढ़ाओ, पुरोईता खे मिलेया करो ओर नये नज्जो रा पईला बाटेया रा आटा बी पुरोईता खे देया करना, जेते कि तुसा लोका रे कअरो दे आशीष ओ।<note caller="+" style="f"><char style="fr" closed="false">44:30 </char><char style="ft" closed="false">लेवी. 26:10</char></note> <verse eid="EZK 44:30" /><verse number="31" style="v" sid="EZK 44:31" />पुरोईता खे एड़ा कोई बी पंछी या डांगर नि खाणा चाईयो जो आपू मरी रा ओ या से किने ओरी जानवरे कायी राखेया ओ।<note caller="+" style="f"><char style="fr" closed="false">44:31 </char><char style="ft" closed="false">लेवी. 22:8 </char></note><verse eid="EZK 44:31" /></para>
  <chapter eid="EZK 44" />
  <chapter number="45" style="c" sid="EZK 45" />
  <para style="s">जमीना रा पवित्र इस्सा</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 45:1" />जेबे तुसे चिट्ठी पाई की इस्राएलो री जमीना खे बाँडो, तेबे देशो बीचा ते एक इस्सा पवित्र समजी की यहोवे खे चढ़ाणा; से साडे बारह किलोमीटर लाम्बा ओर चौड़ाई दस किलोमीटर ऊणी। से जगा आपणे चऊँ कनारे बन्ने तक पवित्र ठईरो। <verse eid="EZK 45:1" /><verse number="2" style="v" sid="EZK 45:2" />एते जमीना रा एक इस्सा, जेतेरी लम्बाई ओर चौड़ाई 875 फुट ए, मन्दरो खे लग राखणी। एतेरे चऊँ कनारे साडे सतासी फुट चौड़ी जमीना री एक पट्टी खाली छाडणी। <verse eid="EZK 45:2" /><verse number="3" style="v" sid="EZK 45:3" />तेती पवित्र जगा दे तुसे तेरा किलोमीटर लाम्बी ओर पाँज किलोमीटर चौड़ी एक जगा नापणी ओर तिदे ई पवित्र जगा बनाणी, जो परम पवित्र ठईरो। <verse eid="EZK 45:3" /><verse number="4" style="v" sid="EZK 45:4" />जो पुरोईत मन्दरो री सेवा-टईल करो ओर यहोवे री सेवा-टईल करने खे नेड़े आओ, से तिना रिया तँईं ओ; तेती तिना रे कअरो खे जगा ओ ओर पवित्र जगा खे पवित्र ठईरो। <verse eid="EZK 45:4" /><verse number="5" style="v" sid="EZK 45:5" />तेबे साडे बारह किलोमीटर लाम्बा ओर पाँज किलोमीटर चौड़ा एक इस्सा, मन्दरो री सेवा-टईल करने वाल़े लेविया री बीइ कमरे खे ओ। <verse eid="EZK 45:5" /><verse number="6" style="v" sid="EZK 45:6" />तेबे यरूशलेम शईरो रिया तँईं, चढ़ाए रे पवित्र इस्से गे, तुसे साडे बारह किलोमीटर लाम्बी ओर दो दशमलव पाँज किलोमीटर चौड़ी, खास जमीन ठराणी, से इस्राएलो रे सारे लोका खे ओ।<verse eid="EZK 45:6" /></para>
  <para style="s">परदानो रिया तँईं जमीन</para>
  <para style="p">
    <verse number="7" style="v" sid="EZK 45:7" />इस्राएलो रे न्यायिया रिया तँईं जमीना रे दो खास इस्से पेंटा खे लग राखणे। एक इस्सा पवित्र जमीन ओर शईरो रे पूर्बा रे इस्से साथे बन्ना मिलेया दा ऊणा, ओर दूजा इस्सा पच्छमा रे इस्से रे बन्ने साथे मिलेया दा ऊणा। फेर राजकुमारो री जमीना रा पूर्बा ओर पच्छमा रा बन्ना आदिवासी जगा रे पूर्बी ओर पच्छमा रे बन्ने साथे मिली जाणिया। <verse eid="EZK 45:7" /><verse number="8" style="v" sid="EZK 45:8" />ये इस्राएलो री जमीना रा से इस्सा ऊणा जो परदानो रा ऊणा। कऊँकि मेरे राजे गे आपणी जमीन ऊणी, इजी री खातर तिना खे मेरे लोका खे कष्ट देणे री जरूरत नि ऊणी। पर इस्राएलो रे कराने खे तेसरे गोत्रो रे मुताबिक इस्सा देणा जो तिना रा ऊणा।<verse eid="EZK 45:8" /></para>
  <para style="s">परदानो रिया तँईं नियम</para>
  <para style="p">
    <verse number="9" style="v" sid="EZK 45:9" />परमेशर यहोवा ईंयाँ बोलोआ, “ओ इस्राएलो रे परदानो! बस करो, उपद्रव ओर उत्पादो खे दूर करो ओर मेरिया बिदिया खे मानेया करो ओर न्याय ओर तर्मो रे काम करेया करो; तुसा खे मेरे लोका खे फेर कदी बी तिना री जमीना ते नि काडणा चाईयो। परमेशर यहोवे री येई बाणी ए। <verse eid="EZK 45:9" /><verse number="10" style="v" sid="EZK 45:10" />तुसा खे आकार ओर बजन नापणे खे एक सई चीजा रा इस्तेमाल करना चाईयो। <verse eid="EZK 45:10" /><verse number="11" style="v" sid="EZK 45:11" />तुसा रा एपा ओर बत दोनो एक ई नापो रे ओ, मतलब दुँईं दे होमेरो रा दसुआ इस्सा आओ, होमेर ई सई नाप ऊणा। <verse eid="EZK 45:11" /><verse number="12" style="v" sid="EZK 45:12" />शेकेल बीई गेरा रा ऊणा। पाँज शेकेल पाँज शेकेल ई ओ ओर दस शेकेल दस शेकेल ई ओ। तुसा रा मानेया पंजा शेकेलो रा ऊणा। <verse eid="EZK 45:12" /><verse number="13" style="v" sid="EZK 45:13" />जेबे तुसा मन्दरो री खास पूजा खे पेंट चढ़ाणी तेबे तेतेरा बजन ईंयाँ ऊणा: मतलब कणका रे हर 100 किलो दे पौणे दो किलो इस्सा; जौ रे हर 100 किलो दे बी पौणे दो किलो रा इस्सा, <verse eid="EZK 45:13" /><verse number="14" style="v" sid="EZK 45:14" />जैतूनो रे तेलो रा जो इस्सा ऊणा से ये आ: मतलब हर 450 लीटरो दे साडे चार लीटर इस्सा। (450 लीटर एक कोर नाप ओआ, जो एक होमेरो रे बराबर ए। होमेर दस बत ओआ।) <verse eid="EZK 45:14" /><verse number="15" style="v" sid="EZK 45:15" />इस्राएलो री खरी-खरी चराईया बीचा ते दो-दो सौ पेडा-बाकरिया बीचा ते एक पेड या बाकरी देया करनी, यो सारी चीजा नज्जो री बलि, होमबलि ओर मेलबलिया रिया तँईं देया करनी, जेते की तिना खे प्राश्चित करेया जाओ, परमेशर यहोवे री येई बाणी ए। <verse eid="EZK 45:15" /><verse number="16" style="v" sid="EZK 45:16" />इस्राएलो रे परदाना खे देशो रे सब लोक ये पेंट देयो।<note caller="+" style="f"><char style="fr" closed="false">45:16 </char><char style="ft" closed="false">परदानो नज्ज कट्ठा करना ओर डांगर तदुए तक राखणे जदुए तक मन्दरो दे तिना री जरूरत नि ओ। </char></note> <verse eid="EZK 45:16" /><verse number="17" style="v" sid="EZK 45:17" />त्यार, नये चाँदो रे दिन, रामो रे दिन ओर इस्राएलो रे लोका रे ठराए रे बखतो दे होमबलि, नज्जो री बलि ओर खुशबूदार द्रव्य रा अर्घ देणा परदानो रा ई काम ओ। इस्राएलो रे कराने खे प्राश्चित करने खे से पापबलि, नज्जो री बलि, होमबलि ओर मेलबलि त्यार करो।”<verse eid="EZK 45:17" /></para>
  <para style="s">त्यार</para>
  <para style="p">
    <verse number="18" style="v" sid="EZK 45:18" />परमेशर यहोवा ईंयाँ बोलोआ, “सालो रे पईले मीन्ने रे पईले दिने तैं एक निर्दोष बाच्छू बलि करना ओर ईंयाँ पवित्र जगा शुद्ध करनी। <verse eid="EZK 45:18" /><verse number="19" style="v" sid="EZK 45:19" />एस पापबलिया रे खूनो बीचा ते पुरोईत कुछ लई की मन्दरो रे दरवाजे रे खम्बे, ओर बेदिया री कुर्सिया रे चऊँ कूणेया दे ओर पीतरले आँगणो रे बड़े द्वारो रे खम्बेया पाँदे लगाओ। <verse eid="EZK 45:19" /><verse number="20" style="v" sid="EZK 45:20" />तेबे एते ई सालो रे पईले मीन्ने रे सातुए दिने सबी पूला रे पड़े दे ओर शरीफा रिया तँईं बी ईंयाँ ई करना; ईंयाँ ई मन्दरो खे प्राश्चित करना। <verse eid="EZK 45:20" /><verse number="21" style="v" sid="EZK 45:21" />हर सालो रे पईले मीन्ने रे चौदुए दिने तुसा फसह रा त्योआर मनाणा शुरू करना चाईयो। ये त्योआर साता दिना तक चलणा। ओर तिदे तुसे बिना सजेड़े री रोटी खाया करनी। <verse eid="EZK 45:21" /><verse number="22" style="v" sid="EZK 45:22" />फसह रे त्योआरो रे पईले दिने परदान आपणे-आपणे ओर प्रजा रे सबी लोका रिया तँईं एक बाच्छू पापबलिया खे त्यार करो। <verse eid="EZK 45:22" /><verse number="23" style="v" sid="EZK 45:23" />त्योआरो रे सातो दिना दे हर दिन तुसे सात बाच्छू ओर सात खाडू निर्दोष ओ सेयो यहोवे खे बलि करी की चढ़ाणे ओर सेयो सारे के सारे फुकी देणे। तेसखे हर रोज एक-एक बाकरा पापबलिया रे रूपो दे चढ़ाणा ए। <verse eid="EZK 45:23" /><verse number="24" style="v" sid="EZK 45:24" />हर एक बाच्छू ओर खाडूए साथे राजे दस किलो नज्जो री बलि ओर नज्जो री बलिया ते बाद तीन लीटर जैतूनो रा तेल देणा। <verse eid="EZK 45:24" /><verse number="25" style="v" sid="EZK 45:25" />सातुए मीन्ने रे पन्द्रुए दिनो ते शुरू ऊई की आगे ये साता दिना तक ऊँदा रणा, मतलब त्योआरो रे दिनो दे राजा पापबलि, होमबलि, नज्जो री बलि ओर तेल एसा बिधिया रे मुताबिक ई करेया करो।”<verse eid="EZK 45:25" /></para>
  <chapter eid="EZK 45" />
  <chapter number="46" style="c" sid="EZK 46" />
  <para style="s">परदान ओर त्योआर</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 46:1" />परमेशर यहोवा ईंयाँ बोलोआ, “पीतरले आँगणो रा पूर्बो कनारला बड़ा द्वार कामो रे छे दिना तक बन्द रओ, पर रामो रे दिने खुला रओ ओर नये चाँदो रे त्योआरो रे दिने बी खुला रओ। <verse eid="EZK 46:1" /><verse number="2" style="v" sid="EZK 46:2" />इस्राएलो रा परदान बारा ते बड़े द्वारो रे ब्रंडे ते आँगणो दे आऊणा चाईयो, ओर बड़े द्वारो रे नेड़े खड़ा ऊणा चाईयो। फेर पुरोईता तेस डांगरो री बलि देणी चाईयो, जेसखे परदान बेदिया पाँदे पूरी तरआ ते जल़ाणे खे ल्याया था, ओर मां साथे मेल-मिलाप राखणे रिया तँईं तेसरी मेलबलिया री पेंट बी। परदानो खे द्वारो पाँदे मेरी पूजा करनी चाईयो, ओर तेबे से बारे जाओ ओर बड़ा द्वार साँज ऊणे ते पईले बन्द नि करना। <verse eid="EZK 46:2" /><verse number="3" style="v" sid="EZK 46:3" />इस्राएली लोक रामो रे दिने ओर नये चाँदो रे दिने तेस बड़े द्वारो रे द्वारो पाँदे यहोवे सामणे माथा तेकेया करो। <verse eid="EZK 46:3" /><verse number="4" style="v" sid="EZK 46:4" />रामो रे दिने जो होमबलि इस्राएलो रे परदान यहोवे खे चढ़ाओ, से पेडा रे छे निर्दोष बच्चे ओर एक निर्दोष खाडू ऊणा चाईयो। <verse eid="EZK 46:4" /><verse number="5" style="v" sid="EZK 46:5" />नज्जो री बलि ये ऊणी चाईयो: मतलब खाडूओ साथे दस किलो आटा ओर पेडा रे बच्चेया साथे आपणे चकणे रे मुताबिक नज्ज ओर हर दस किलो आटे साथे तीन लीटर जैतूनो रा तेल। <verse eid="EZK 46:5" /><verse number="6" style="v" sid="EZK 46:6" />नये चाँदो रे दिने राजा एक निर्दोष बाच्छू ओर पेडा रे छे बच्चे ओर एक खाडू चढ़ाओ; यो सब निर्दोष ऊणे चाईयो। <verse eid="EZK 46:6" /><verse number="7" style="v" sid="EZK 46:7" />तेसखे बाच्छू ओर खाडू दुँईं साथे नज्जो री बलिया खे दस-दस किलो आटा‍ चढ़ाणा। पेडा रे बच्चेया साथे से जितणा नज्ज चढ़ाणा चाओ, तितणा देई सकोआ। तेसखे हर दस किलो आटे साथे लगभग तीन लीटर जैतूनो रा तेल बी चढ़ाणा चाईयो। <verse eid="EZK 46:7" /><verse number="8" style="v" sid="EZK 46:8" />जेबे परदान पीतरे जाओ तेबे से बड़े द्वारो रे ब्रंडे ते ऊई की जाओ ओर तेसा बाटा देई निकल़ी जाओ। <verse eid="EZK 46:8" /><verse number="9" style="v" sid="EZK 46:9" />जेबे आम लोक ठराए रे बखतो दे यहोवे सामणे माथा टेकणे आओ, तेबे जो उत्तरी बड़े द्वारो ते ऊई की माथा टेकणे खे पीतरे आओगा, से दक्खण बड़े द्वारो ते निकल़ो ओर जो दक्खण बड़े द्वारो दे ऊई की पीतरे आओ, से उत्तरी बड़े द्वारो ते बारे निकल़ो, मतलब जो जेस बड़े द्वारो ते आओ, से तेस बड़े द्वारो ते वापस नि ओ, आपणे सामणे ई निकल़ी जाओ। <verse eid="EZK 46:9" /><verse number="10" style="v" sid="EZK 46:10" />जेबे सेयो लोक पीतरे आओ तेबे परदान तिना बीचे ऊई की आओ ओर जेबे सेयो निकल़ो, तेबे सेयो एक साथे निकल़ो। <verse eid="EZK 46:10" /><verse number="11" style="v" sid="EZK 46:11" />जेबे त्योआर ओर बाकी ठराए रे बखतो रे आगी दे बलि चढ़ाणी, तेबे तेते साथे नज्जो री बलि चढ़ाणे री ये बिधि ए: हर बाच्छू ओर खाडूए साथे दस किलो नज्ज, ओर पेडा रे बच्चेया साथे आपणी इच्छा रे मुताबिक नज्ज ओर हर दस किलो आटे साथे लगभग तीन लीटर जैतूनो रा तेल। <verse eid="EZK 46:11" /><verse number="12" style="v" sid="EZK 46:12" />तेबे जेबे राजा होमबलि या मेलबलिया खे आपणी इच्छा बलि करी की यहोवे री खातर त्यार करो, तेबे पूर्बो कनारला बड़े द्वार तिना खे खोलेया जाओ ओर सेयो आपणा होमबलि ओर मेलबलि तिंयाँ ई त्यार करो जिंयाँ से रामो रे दिने त्यार करोआ, तेबे से निकल़ो ओर तेसरे निकल़ने ते बाद बड़े द्वार बन्द करी देणा।” <verse eid="EZK 46:12" /><verse number="13" style="v" sid="EZK 46:13" />तेबे यहोवे बोलेया, “हर प्यागा तैं यहोवे रिया तँईं होमबलिया रे रूपो दे एक सालो रा एक निर्दोष पेडा रा बच्चा चढ़ाणा चाईयो। <verse eid="EZK 46:13" /><verse number="14" style="v" sid="EZK 46:14" />हर प्यागा खे एस साथे एक नज्जो री बलि त्यार करना, मतलब दो किलो आटा ओर तिदे मलाणे खे एक लीटर जैतूनो रे तेल लणा। तैं ये सदा बिधिया रे मुताबिक यहोवे खे नज्जो री बलि करी की चढ़ाया करना। <verse eid="EZK 46:14" /><verse number="15" style="v" sid="EZK 46:15" />पेडा रा बच्चा, नज्जो री बलि ओर तेल, हर प्यागा खे सदा होमबलि करी की चढ़ाया करना।”<verse eid="EZK 46:15" /></para>
  <para style="s">परदान ओर जमीना रा इस्सा</para>
  <para style="p">
    <verse number="16" style="v" sid="EZK 46:16" />परमेशर यहोवा ईंयाँ बोलोआ, “जे राजा आपणे केसी पाऊए खे कुछ देयो, तो से तेसरा इस्सा ऊई की तेसरे पोतेया खे बी मिलो; इस्से रे नियमो रे मुताबिक से तिना रा बी आपणा इस्सा ठईरो। <verse eid="EZK 46:16" /><verse number="17" style="v" sid="EZK 46:17" />पर जे से आपणे इस्से बीचा ते आपणे केसी नौकरो खे कुछ देयो, तो छुट्टिया रे सालो तक तो से तेसरा बणेया रा रओ, पर तेते बाद परदानो खे वापस करेया जाओ ओर तेसरा आपणा इस्सा ई तेसरे पाऊआ खे मिलो। <verse eid="EZK 46:17" /><verse number="18" style="v" sid="EZK 46:18" />प्रजा रा एड़ा कोई इस्सा परदान नि लओ, जो अन्देर करी की तिना री आपणी जमीना ते छुड़ाई राखेया ओ; आपणे पाऊआ खे से आपणी ई जमीना बीचा ते इस्सा देयो; एड़ा नि ओ कि मेरी प्रजा रे लोक आपणी-आपणी जमीना ते तित्तर-बित्तर ऊई जाओ।”<verse eid="EZK 46:18" /></para>
  <para style="s">मन्दरो रे रसोई कअर</para>
  <para style="p">
    <verse number="19" style="v" sid="EZK 46:19" />तेबे से माणूं माखे बड़े द्वारो ते एक ओर द्वारो ते ऊई की पुरोईता री उत्तरो कनारो री पवित्र कमरे रे लईगा; तेती पच्छमा कनारो रे कूणे रे एक जगा थी। <verse eid="EZK 46:19" /><verse number="20" style="v" sid="EZK 46:20" />तेबे तिने माखे बोलेया, “ये जगा ए जिदे पुरोईत लोक दोषबलि ओर पापबलिया रा मास पकाओ ओर नज्जो री बलिया खे पकाओ, एड़ा नि ओ कि तिना खे बारले आँगणो रे लई जाई की आम लोक पवित्र ठईरो।” <verse eid="EZK 46:20" /><verse number="21" style="v" sid="EZK 46:21" />तेते ते बाद तिने आऊँ मन्दरो रे बारले आँगणो दे लई जाई की आँगणो रे चऊँ कूणेया दे कूमाया ओर आँगणो रे हर एक कूणे दे एक-एक बन्द कनारा बणी रा था, <verse eid="EZK 46:21" /><verse number="22" style="v" sid="EZK 46:22" />मतलब आँगणो रे चऊँ कूणेया दे साठ फूट लाम्बे ओर पैंताल़ी फूट चौड़े बन्द कनारे थे; चऊँ कूणे रे बन्द कनारे रा एक ई नाप था। <verse eid="EZK 46:22" /><verse number="23" style="v" sid="EZK 46:23" />पीतरे चऊँ कनारे कांद थी ओर कांदा निठे पकाणे खे चूले बणी रे थे। <verse eid="EZK 46:23" /><verse number="24" style="v" sid="EZK 46:24" />तेबे तिने माणूंए माखे बोलेया, “पकाणे रे कअर, जेती मन्दरो री सेवा-टईल करने वाल़े लोक लेवी. ए। जो बलिदाना खे पकाओ, सेयो यो ईए।<note caller="+" style="f"><char style="fr" closed="false">46:24 </char><char style="ft" closed="false">यहे. 44:10-14 </char></note>”<verse eid="EZK 46:24" /></para>
  <chapter eid="EZK 46" />
  <chapter number="47" style="c" sid="EZK 47" />
  <para style="s">जीवन देणे वाल़ी नदी</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 47:1" />मेरे दर्शणो दे, से माणूं माखे मन्दरो रे द्वारो गे वापस ल्याया। तेती मैं देखेया कि मन्दरो रे द्वारो ते थाले पूर्बा रिया तरफा खे एक सूबल़ बह्यीणे लगी री थी ओर दक्खणा रिया तरफा खे बेदिया रे दाणे कनारे ते जाणे लगी री थी।<note caller="+" style="f"><char style="fr" closed="false">47:1 </char><char style="ft" closed="false">प्रका. 22:1</char></note> <verse eid="EZK 47:1" /><verse number="2" style="v" sid="EZK 47:2" />से माणूं माखे उत्तरो रे बड़े द्वारो ते ऊई की दवाला ते बारे लईगा ओर पूर्बो रे द्वारो रिया तरफा खे लईगा। तेती आऊँ पूर्बा रे द्वारो गे दक्खणा रे इस्से गे बह्यीणे लगी रे पाणिये खे देखी सकुँ था, <verse eid="EZK 47:2" /><verse number="3" style="v" sid="EZK 47:3" />से माणूं माखे आथो दे नापणे री डोरी लई की नापदे ऊए 1,750 फुटा तक पाणिये साथे लईगा ओर पारले कनारे लईगा। ओर पाणी मेरे मोरड़ेया तक था। <verse eid="EZK 47:3" /><verse number="4" style="v" sid="EZK 47:4" />तिने फेर 1,750 फुटो तक नापेया ओर माखे फेर पार लईगा। एबे तेती से पाणी मेरे जानूआ तक था। 1,750 फुट आगे जाणे ते बाद, पाणी मेरे लको तक आईगा, <verse eid="EZK 47:4" /><verse number="5" style="v" sid="EZK 47:5" />तिने फेर 1,750 फुट नापेया, ओर नदी इतणी डूगी ऊईगी थी कि पैदल चली की पार जाणा मुमकिन नि था। ये तरने रिया तँईं काफी डूगी थी, पर पैदल चलणे खे बऊत डूगी थी। <verse eid="EZK 47:5" /><verse number="6" style="v" sid="EZK 47:6" />तेबे तिने माणूंए मांते पूछेया, “ओ नाश ऊणे वाल़े माणूंआ, क्या तैं ये देखी राखेया?” तेबे तिने आऊँ नदिया रे कनारे-कनारे वापस लई जाई की पऊँचाई ता। <verse eid="EZK 47:6" /><verse number="7" style="v" sid="EZK 47:7" />मैं वापस ऊई की क्या देखेया कि नदिया रे दुँईं कनारेया पाँदे बऊत सारे डाल़ ए।<note caller="+" style="f"><char style="fr" closed="false">47:7 </char><char style="ft" closed="false">यहे. 47:12</char></note> <verse eid="EZK 47:7" /><verse number="8" style="v" sid="EZK 47:8" />तिने माणूंए माखे बोलेया, “ये सूबल़ पूर्बा रिया तरफा री जमीना रिया तरफा खे जाओई। ये यरदन नदिया री काअटिया दे जाओई। फेर पाणी अराबा<note caller="+" style="f"><char style="fr" closed="false">47:8 </char><char style="fq" closed="false">अराबा </char><char style="ft" closed="false">यरदन काअटी</char></note> रे खारे समुद्रो दे चली जाओआ। जेबे ये पाणी तेती समुद्रो दे जाओआ, तो पाणी खारा ऊणे रे बजाये शुद्ध ऊई जाओआ। <verse eid="EZK 47:8" /><verse number="9" style="v" sid="EZK 47:9" />जेती-जेती ये नदी बह्ओगी, तेती-तेती सब प्रकारा रे बऊत अण्डे देणे वाल़े जीव-जन्तु जिऊणे ओर मछलिया बी बऊत ऊई जाणिया; कऊँकि एसा सूबल़ा रा पाणी तेती पऊँची रा ओर तालो रा पाणी मीठा ऊई जाणा ओर जेती केथी ये नदी पऊँछणी तेती सारे जन्तु जियूणे। <verse eid="EZK 47:9" /><verse number="10" style="v" sid="EZK 47:10" />समुद्रो रे कनारे पाँदे मच्छुआरे खड़े रे रणे ओर एनगदिया रे चरणे ते लई की एनगलैम चरणे तक तिना जाल़ बछाई की राखणा ओर तिना खे बड़े समुद्रो जेड़िया कई प्रकारा रिया अणगिणत मछलिया मिलणिया। <verse eid="EZK 47:10" /><verse number="11" style="v" sid="EZK 47:11" />पर मृत समुद्रो गे जो दल-दल ओर गड्डे ए, तिना रा पाणी मीठा नि ऊणा, सेयो लूणके ई रणे। <verse eid="EZK 47:11" /><verse number="12" style="v" sid="EZK 47:12" />नदिया रे दुँईं कनारेया पाँदे कई-प्रकारा रे खाणे जोगे फलो वाल़े डाल़ जमणे, जिना रे पत्ते नि मुरझाणे ओर ना तिना रा फल देणा कदी बन्द ऊणा, कऊँकि नदिया रा पाणी पवित्र जगा ते निकल़ी रा। तिना रे मीन्ने रे मीन्ने नये-नये फल लगणे। तिना रे सारे फल तो खाणे रे ओर पत्ते दवाईया रे कामे आऊणे।”<note caller="+" style="f"><char style="fr" closed="false">47:12 </char><char style="ft" closed="false">प्रका. 22:2</char></note><verse eid="EZK 47:12" /></para>
  <para style="s">देशो रे बाने</para>
  <para style="p">
    <verse number="13" style="v" sid="EZK 47:13" />परमेशर यहोवा इस्राएलो खे ईंयाँ बोलोआ, “जेस बन्ने ते पीतरे तुसा रे सबी गोत्रा खे ये देश बाँडणा पड़ना, से ये ए: यूसुफो खे दो इस्से मिलो।” <verse eid="EZK 47:13" /><verse number="14" style="v" sid="EZK 47:14" />यहोवा परमेशरे इस्राएलिया ते बोलेया, “से तुसा एकी-दूजे जेड़ा आपणे इस्से दे पाणा, कऊँकि मैं कसम खाई राखी कि से तुसा रे पितरा खे देणा, इजी री खातर ये देश तुसा रा आपणा सदा रा इस्सा ठईरना। <verse eid="EZK 47:14" /><verse number="15" style="v" sid="EZK 47:15" />तेस देशो रा बन्ना जो परमेशर इस्राएलिया खे देओआ से ये ए। मतलब उत्तरो रिया तरफा रा बन्ना भूमध्य समुद्रो ते पूर्बा रे शईर हेतलोनो तक, फेर हमात दर्रे ते ऊँदे ऊए सदादो री काट्टिया तक, <verse eid="EZK 47:15" /><verse number="16" style="v" sid="EZK 47:16" />हमात बेरोता ओर सिब्रैम शईरा तक, जो दमिश्क इलाके ओर हमात इलाके रे बीचे बन्ने गे ए। तेथा ते से बन्ना हसर्हत्तीकोन शईरो तक फैलणी, जो हौरान जगा रे बन्ने पाँदे ए। <verse eid="EZK 47:16" /><verse number="17" style="v" sid="EZK 47:17" />ईंयाँ ये बन्ना भूमध्य समुद्रो ते लई की दमिश्को ते ऊँदे ऊए दक्खणा दे हसरेनोन शईरो तक फैली दी ऊणी। तेतेरे उत्तरा दे हमात शईरो तक। उत्तरो रा बन्ना ये ईए। <verse eid="EZK 47:17" /><verse number="18" style="v" sid="EZK 47:18" />पूर्बा रिया तरफा खे, बन्ना हौरान ओर दमिश्को बीचे, दक्खणा दे यरदन नदिया साथे गिलाद इलाका ओर इस्राएलो री जमीना बीचे, मृत समुद्रो साथे तामार शईरो तक फैली दी ऊणी। पूर्वी बन्ना तो येई ओ। <verse eid="EZK 47:18" /><verse number="19" style="v" sid="EZK 47:19" />दक्खणा रिया तरफा खे, बन्ना तामारो दे दक्खण-पच्छमा ते लई की मरीबा-कादेश शईरो रे नेड़े री सूबल़ा तक फैलेया दा ऊणा। फेर बन्ना मिस्रो रे बन्ने पाँदे सूके नाल़े रे कनारे पच्छमा दे बड़े समुद्रो तक फैली दी ऊणी। दक्खणा रा बन्ना येई ओ। <verse eid="EZK 47:19" /><verse number="20" style="v" sid="EZK 47:20" />पच्छमा रा बन्ना दक्खण बन्ने ते लई की हमात री काट्टिया सामणे तक समुद्र ओ। पच्छमा रा बन्ना येई ओ। <verse eid="EZK 47:20" /><verse number="21" style="v" sid="EZK 47:21" />ईंयाँ देश इस्राएलो रे गोत्रो रे मुताबिक आपू बीचे बांडी लणा। <verse eid="EZK 47:21" /><verse number="22" style="v" sid="EZK 47:22" />ये आपू बीचे ओर तिना परदेशिया साथे बांडी लणा, जो तुसा बीचे रंदे ऊए बाल़क जमाओ। सेयो तुसा री नजरा रे देसी इस्राएलिया जेड़े ठईरो ओर तुसा रे गोत्रा बीचे आपणा-आपणा इस्सा पाओ। <verse eid="EZK 47:22" /><verse number="23" style="v" sid="EZK 47:23" />जो परदेशी जेस गोत्रो रे देशो रे रओआ, तेसखे से ई इस्सा देणा, परमेशर यहोवे री येई बाणी ए।”<verse eid="EZK 47:23" /></para>
  <chapter eid="EZK 47" />
  <chapter number="48" style="c" sid="EZK 48" />
  <para style="s">गोत्रो दे जमीन बाडणा</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 48:1" />इस्राएलो रे गोत्रो रे इस्से ये ए: उत्तरी बन्ने ते लगेया रा हेतलोन शईरो री बाटा गे हमात जगा री काट्टिया तक ओर दमिश्क रे बन्ने रे हसरेनान शईरो ते उत्तरो रिया तरफा खे हमात तक एक इस्सा दानो रा ओ ओर तेतेरे पूर्वी ओर पच्छमी बन्ना बी ओ। <verse eid="EZK 48:1" /><verse number="2" style="v" sid="EZK 48:2" />दान गोत्रो रे बन्ने ते लगेया रा पूर्बो ते पच्छमा तक आशेर गोत्रो रा एक इस्सा ओ। <verse eid="EZK 48:2" /><verse number="3" style="v" sid="EZK 48:3" />आशेर गोत्रो रे बन्ने ते लगेया रा, पूर्बो ते पच्छमा तक नप्तालिया रे गोत्रो रा एक इस्सा ओ। <verse eid="EZK 48:3" /><verse number="4" style="v" sid="EZK 48:4" />नप्ताली गोत्रो रे बन्ने ते लगेया रा पूर्बो ते पच्छमा तक मनश्शे गोत्रो रा एक इस्सा ओ। <verse eid="EZK 48:4" /><verse number="5" style="v" sid="EZK 48:5" />मनश्शे गोत्रो रे बन्ने ते लगेया रा पूर्बो ते पच्छमा तक एप्रैम गोत्रो रा एक इस्सा ओ। <verse eid="EZK 48:5" /><verse number="6" style="v" sid="EZK 48:6" />एप्रैम गोत्रो रे बन्ने ते लगेया रा पूर्बो ते पच्छमा तक रूबेन गोत्रो रा एक इस्सा ओ। <verse eid="EZK 48:6" /><verse number="7" style="v" sid="EZK 48:7" />रूबेन गोत्रो रे बन्ने ते लगेया रा पूर्बो ते पच्छमा तक यहूदा गोत्रो रा एक इस्सा ओ।<verse eid="EZK 48:7" /></para>
  <para style="s">देशो रे बीचे जमीना रा खास इस्सा</para>
  <para style="p">
    <verse number="8" style="v" sid="EZK 48:8" />यहूदा गोत्रो रे बन्ने ते लगेया रा पूर्बो ते पच्छमा तक से चढ़ाया रा इस्सा ओ, जो तुसा खे चढ़ाणा पड़ना, से साडे बारह किलोमीटर चौड़ा ओर पूर्बो ते लई की पच्छमा तक केसी एक गोत्रो रे इस्से जेड़ा लाम्बा ओ ओर तेते बीचे मन्दर ओ। <verse eid="EZK 48:8" /><verse number="9" style="v" sid="EZK 48:9" />जो इस्सा तुसा यहोवे खे चढ़ाणा पड़ना, से साडे बारह किलोमीटर लाम्बा ओर दस किलोमीटर चौड़ा ओ। <verse eid="EZK 48:9" /><verse number="10" style="v" sid="EZK 48:10" />ये चढ़ाया रा पवित्र इस्सा पुरोईता खे मिलो; से उत्तर ओर दखणो रिया तरफा खे साडे बारह किलोमीटर लाम्बा, पच्छमा ओर पूर्बो रिया तरफा खे पाँज किलोमीटर चौड़ा ऊणा चाईयो ओर पूर्बो रिया तरफा खे पाँज किलोमीटर चौड़ी ओर दक्खणो ते साडे बारह किलोमीटर लाम्बी ऊणी। तेतेरे बीचो बीच यहोवे रा मन्दर ऊणा चाईयो। <verse eid="EZK 48:10" /><verse number="11" style="v" sid="EZK 48:11" />ये खास पवित्र इस्सा सादोको री ल्वादा रे तिना पवित्र पुरोईता खे ओ जो मेरी आज्ञा रा पालण करदे आई रे ओर इस्राएलिया रे पटकणे रे बखते लेविया जेड़े नि पटके थे। <verse eid="EZK 48:11" /><verse number="12" style="v" sid="EZK 48:12" />इजी री खातर देशो रे चढ़ाए रे इस्से बीचा ते ये तिना खे चढ़ाया रा इस्सा, मतलब बऊत पवित्र देश ठईरो ओर लेवी गोत्रो रे बन्ने साथे लगेया रा रओ। <verse eid="EZK 48:12" /><verse number="13" style="v" sid="EZK 48:13" />पुरोईता रे बन्ने ते लगेया रा लेविया रा इस्सा ओ, से साडे बारह किलोमीटर लाम्बा ओर पाँज किलोमीटर चौड़ा ओ, इया सारी लम्बाई-चौड़ाई येई ओ। <verse eid="EZK 48:13" /><verse number="14" style="v" sid="EZK 48:14" />पुरोईत ओर लेवी तेते बीचा ते ना तो कुछ बेचो, ना दूजी जमीना साथे बदलो ओर ना जमीना री पईली उपज ओरी केसी खे देयो, कऊँकि से यहोवे खे पवित्र ए। <verse eid="EZK 48:14" /><verse number="15" style="v" sid="EZK 48:15" />साडे बारह किलोमीटर लाम्बी ओर टाई किलोमीटर चौड़ा इस्सा बचेया रा रणा, से शईर, बस्ती ओर चराईया खे आम इस्सा ओ ओर यरूशलेम शईर तेते बीचे ओ। <verse eid="EZK 48:15" /><verse number="16" style="v" sid="EZK 48:16" />शईरो रा नाप ये ऊणा चाईयो, मतलब उत्तर, दक्खण, पूर्ब ओर पच्छमा रिया तरफा खे स्वा दो किलोमीटर लाम्बा। <verse eid="EZK 48:16" /><verse number="17" style="v" sid="EZK 48:17" />शईरो गे उत्तर, दक्खण, पूर्ब ओर पच्छमा दे चराईया ओ। जो 410 फुट चौड़ाईया ऊणिया चाईयो। <verse eid="EZK 48:17" /><verse number="18" style="v" sid="EZK 48:18" />चढ़ाए रे पवित्र जमीना रे इस्से री लम्बाईया बीचा ते बचेया दा इस्सा पूर्बा रिया तरफा खे पाँज किलोमीटर ओर पच्छमा रिया तरफा खे पाँज किलोमीटर ऊणा। ये इस्सा पवित्र, चढ़ाए दे इस्से साथे लगेया दा ऊणा। तेतेरी उपजा ते तीना लोका खे खाणा मिलणा जो यरूशलेम शईरो दे काम करोए। <verse eid="EZK 48:18" /><verse number="19" style="v" sid="EZK 48:19" />इस्राएलो रे सारे गोत्रो बीचा ते जो यरूशलेम शईरो दे काम करो, से तेतेरी खेती करेया करो। <verse eid="EZK 48:19" /><verse number="20" style="v" sid="EZK 48:20" />सारा चढ़ाया रा इस्सा साडे बारह किलोमीटर चौड़ा-लाम्बा ओ, तुसा खे चौरस पवित्र जगा चढ़ाणी पड़नी जिदे शईरो री खास जमीन ओ। <verse eid="EZK 48:20" /><verse number="21" style="v" sid="EZK 48:21" />जो इस्सा रयी जाओगा, से परदाना खे मिलो। पवित्र चढ़ाए रे इस्से री ओर शईरो री खास जमीना रे दुँईं कनारे, मतलब तिना रे पूर्ब ओर पश्‍चिम कनारे साडे बारह किलोमीटर चौड़ाई, जो ओरी गोत्रा रे इस्से रे रओ, से परदाना खे मिलो ओर चढ़ाया रा पवित्र इस्सा ओर मन्दरो री पवित्र जगा तिना बीचे ऊणी चाईयो। <verse eid="EZK 48:21" /><verse number="22" style="v" sid="EZK 48:22" />जो परदानो रा इस्सा ऊणा, से लेविया बीचे ओर शईरो री खास जमीन ओ। परदानो रा इस्सा यहूदा रे गोत्रो री जमीन ओर दक्खणा दे बिन्यामीन गोत्रो री जमीना बीचे ऊणा।<verse eid="EZK 48:22" /></para>
  <para style="s">ओरी गोत्रो रे इस्से</para>
  <para style="p">
    <verse number="23" style="v" sid="EZK 48:23" />तेसा खास जगा रे दक्खणा दे, हर ओरी गोत्रा खे जमीना रा एक इस्सा देया जाणा चाईयो जो कि इस्राएलो रे पूर्बो रे बन्ने ते लई की पच्छमा दे बड़े समुद्रो तक फैलेया दा ए। उत्तरा रिया तरफा ते शुरू ऊई की बिन्यामीन गोत्रो खे जमीन ऊणी। <verse eid="EZK 48:23" /><verse number="24" style="v" sid="EZK 48:24" />बिन्यामीनो रे बन्ने ते लगेया रा पूर्बो ते पच्छमा तक शिमोन गोत्रो रा एक इस्सा। <verse eid="EZK 48:24" /><verse number="25" style="v" sid="EZK 48:25" />शिमोन रे बन्ने ते लगेया रा पूर्बो ते पच्छमा तक इस्साकार गोत्रो रा एक इस्सा। <verse eid="EZK 48:25" /><verse number="26" style="v" sid="EZK 48:26" />इस्साकारो रे बन्ने ते लगेया रा पूर्बो ते पच्छमा तक जबूलून गोत्रो रा एक इस्सा। <verse eid="EZK 48:26" /><verse number="27" style="v" sid="EZK 48:27" />जबूलून रे बन्ने ते लगेया रा पूर्बो ते पच्छमा तक गाद गोत्रो रा एक इस्सा। <verse eid="EZK 48:27" /><verse number="28" style="v" sid="EZK 48:28" />ओर गाद रे बन्ने गे दक्खण तरफा रा बन्ना तामार शईरो ते लई की मरीबा-कादेश नाओं री सूबल़ा तक ओर मिस्रो रे नाल़े ओर समुद्रो तक पऊँचे। <verse eid="EZK 48:28" /><verse number="29" style="v" sid="EZK 48:29" />जो इस्राएल देश तुसा खे इस्राएलो रे गोत्रा खे बाँडणे पड़ने से यो ईए ओर तिना रे इस्से बी यो ईए, परमेशर यहोवे री येई बाणी ए।<verse eid="EZK 48:29" /></para>
  <para style="s">शईरो रे द्वार</para>
  <para style="p">
    <verse number="30" style="v" sid="EZK 48:30" />शईरो ते निकल़ने रे द्वार ए ऊणे। मतलब उत्तरो रिया तरफा खे जेतेरी लम्बाई स्वा दो किलोमीटर ऊणी। <verse eid="EZK 48:30" /><verse number="31" style="v" sid="EZK 48:31" />तिना रे तीन बड़े द्वार ओ; मतलब एक रूबेन रा बड़े द्वार, एक यहूदा रा बड़े द्वार ओर एक लेविये रा बड़े द्वार ओ; कऊँकि शईरो रे बड़े द्वारो रे नाओं इस्राएलो रे गोत्रा पाँदे राखणे पड़ने। <verse eid="EZK 48:31" /><verse number="32" style="v" sid="EZK 48:32" />पूर्बो रिया तरफा खे स्वा दो किलोमीटर लाम्बा बन्ना ओ ओर तिदे तीन बड़े द्वार ऊणे चाईयो, मतलब एक यूसुफो रा बड़े द्वार, एक बिन्यामीनो रा बड़े द्वार ओर एक दान रा बड़े द्वार ओ। <verse eid="EZK 48:32" /><verse number="33" style="v" sid="EZK 48:33" />दक्खण तरफा खे स्वा दो किलोमीटर लाम्बा ओ ओर तिदे तीन बड़े द्वार ओ, मतलब एक शिमोन रा बड़े द्वार, एक इस्साकारो रा बड़े द्वार ओर एक जबूलूनो रा बड़े द्वार ओ। <verse eid="EZK 48:33" /><verse number="34" style="v" sid="EZK 48:34" />ओर पच्छमा रिया तरफा खे स्वा दो किलोमीटर लाम्बा ओर तिदे तीन बड़े द्वार ओ, मतलब एक गाद रा बड़े द्वार, एक आशेर रा बड़े द्वार ओर एक नप्ताली रा बड़े द्वार ओ। <verse eid="EZK 48:34" /><verse number="35" style="v" sid="EZK 48:35" />इजी री खातर शईरो रे चऊँ कनारे रा केरा नौ किलोमीटर ऊणा ओर तेस दिनो ते बाद शईरो रा नाओं “यहोवा एती ए”<note caller="+" style="f"><char style="fr" closed="false">48:35 </char><char style="fq" closed="false">यहोवा एती ए </char><char style="ft" closed="false">यहोवा शामा </char></note> रणा।<verse eid="EZK 48:35" /></para>
  <chapter eid="EZK 48" />
</usx>