<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="JOL" style="id" />
  <para style="h">योएल</para>
  <para style="toc1">योएल नबीए रे जरिये लिखी री कताब</para>
  <para style="toc2">योएल</para>
  <para style="toc3">योए.</para>
  <para style="mt">योएल</para>
  <para style="mt2">योएल नबीए रे जरिये लिखी री कताब</para>
  <para style="is">भूमिका</para>
  <para style="ip">नबी योएलो रे बारे दे बऊत कम गल्ला री जाणकारी ए, ओर ये बी पक्का-पक्का जाणकारी नि ए कि ये कदी जम्मेया ओर कदी मरेया। पर एड़ा लगोआ कि ऊई सकोआ ये कताब 400 या 500 ई. पू. दे लिखी ऊगी, जेबे फारसी साम्राज्य रा राज था। योएले टिड्डिया रे एक खतरनाक अमले ओर एक विनाश करने वाल़े अकाल़ो रे बारे दे बताई राखेया। इना कटणा दे से “यहोवे रा दिन” आऊणे रा नशाण देखोआ; ये एक एड़ा बखत ऊणा जेबे यहोवे तिना लोका खे सजा देणी जो तेसरी तार्मिकता रा बरोद करोए। लोका ते पश्चाताप करने रिया तँईं परमेशरो खे बुलाओआ ओर तेसरे लोका खे दुबारा बसणा ओर आशीषा री तेसरी प्रतिज्ञा खे भविष्यवक्ता ओरी तक बी पऊँचाओआ। ये प्रतिज्ञा खास करी की त्यान देणे वाल़ी ए कि परमेशरो आपणा आत्मा सबी माणूंआ, जवाणसा ओर मर्दा, जवाना ओर स्याणेया पाँदे लटणा।</para>
  <para style="iot">रूप-रेखा</para>
  <para style="io1">टिड्डिया रा अमला <char style="ior"><ref loc="JOL 1:1-2:17">1:1-2:17</ref></char></para>
  <para style="io1">दुबारा बसणे री प्रतिज्ञा <char style="ior"><ref loc="JOL 2:18-27">2:18-27</ref> </char></para>
  <para style="io1">यहोवे रा दिन <char style="ior"><ref loc="JOL 2:28-3:21">2:28-3:21</ref></char></para>
  <chapter number="1" style="c" sid="JOL 1" />
  <para style="p">
    <verse number="1" style="v" sid="JOL 1:1" />यहोवे रा वचन योएल भविष्यवक्ते गे पऊँचेया, जो पूतीएलो रा पाऊ ए, यहोवा ईंयाँ बोलोआ:<verse eid="JOL 1:1" /></para>
  <para style="s">टिड्डिया रा अमला</para>
  <para style="p">
    <verse number="2" style="v" sid="JOL 1:2" />ओ इस्राएल देशो रे परदानो, सुणो, ओर एते जमीना दे रणे वाल़े सब लोको, त्यानो साथे सुणो! एड़ी गल्ल तुसा रे दिना दे, या तुसा रे बुजुर्गा रे दिना दे कदी पनि ऊई री। <verse eid="JOL 1:2" /><verse number="3" style="v" sid="JOL 1:3" />इना गल्ला रे बारे दे तुसा आपणे बच्चेया गे दशेया करना ओर तुसा रे बच्चेया यो गल्ला आपणे बच्चेया गे दशेया करनिया ओर तुसा रे नाती पोतेया यो गल्ला आऊणे वाल़ी पीढ़िया गे दशेया करनिया। <verse eid="JOL 1:3" /><verse number="4" style="v" sid="JOL 1:4" />जो कुछ गाजाम<note caller="+" style="f"><char style="fr" closed="false">1:4 </char><char style="fq" closed="false">गाजाम </char><char style="ft" closed="false">कुतरने वाल़िया </char></note> नाओं री टिड्डिया ते बचेया, से अर्बे<note caller="+" style="f"><char style="fr" closed="false">1:4 </char><char style="fq" closed="false">अर्बे </char><char style="ft" closed="false">उडणे वाल़ी </char></note> नाओं री टिड्डिये खाई ला ओर जो कुछ अर्बे नाओं री टिड्डिया ते बचेया, से येलेक<note caller="+" style="f"><char style="fr" closed="false">1:4 </char><char style="fq" closed="false">येलेक </char><char style="ft" closed="false">उटकणे वाल़ी </char></note> नाओं री टिड्डिये खाई ला ओर जो कुछ येलेक नाओं री टिड्डिया ते बचेया, से हारसील<note caller="+" style="f"><char style="fr" closed="false">1:4 </char><char style="fq" closed="false">हारसील </char><char style="ft" closed="false">छिलणे वाल़ी </char></note> टिड्डिये खाई ला।<verse eid="JOL 1:4" /></para>
  <para style="s">टिड्डिया रा आऊणा</para>
  <para style="p">
    <verse number="5" style="v" sid="JOL 1:5" />ओ शराबियो, जागी जाओ ओर रोओ! ओ सारे शराब पीणे वाल़ेयो लोको, रोओ। कऊँकि तुसा रा नवां शराब एबे खत्म ऊई चूकी रा ए। हाय, हाय करो, कऊँकि एबे तुसा खे से फेर नि मिलणा। <verse eid="JOL 1:5" /><verse number="6" style="v" sid="JOL 1:6" />टिड्डिया एक तागतबर सेना जेड़िया ए जो मेरे देशो री जमीना दे कूसी चूकी रिया ए। सेयो इतणी जादा ए कि तिना खे गिणी पनि सकदे। तिना रे दाँद शेरो रे दाँदा जेड़े पईने ए। सेयो शेरनिया रे तीखे दाँदा जेड़े ए। <verse eid="JOL 1:6" /><verse number="7" style="v" sid="JOL 1:7" />तिने मेरिया अंगूरा री बेला उजाड़ी तिया ओर मेरे दाऊगल़ेया रे डाल़ तोड़ी ते। तिना मेरे डाल़ा रे छिलके बी चट करी जाणे। तिना रिया पाँगटिया चीटिया ऊई जाणिया ओर सेयो डाल़ सूकी जाणे।<verse eid="JOL 1:7" /></para>
  <para style="s">लोका रा रोणा</para>
  <para style="p">
    <verse number="8" style="v" sid="JOL 1:8" />जिंयाँ कोई नवीं लाड़ी आपणे लाड़े रे मरने रिया तँईं लको दे टाट बानी की शोग करोई, तिंयाँ ई तुसे बी शोग करो। <verse eid="JOL 1:8" /><verse number="9" style="v" sid="JOL 1:9" />यहोवे रे मन्दरो दे ना तो नज्जो री बलि ओर ना अर्घ आओआ। तेसरी सेवा करने वाल़े जो पुरोईत ए, सेयो शोग करोए। <verse eid="JOL 1:9" /><verse number="10" style="v" sid="JOL 1:10" />कऊँकि जमीना री फसल बर्बाद ऊई गी, एथो तक कि जमीन बी सूकी गी दी ए, कऊँकि नज्ज नाश ऊईगा, अंगूरा री नवीं फसल बर्बाद ऊईगी री। जैतूनो रा तेल बी खत्म ऊईगा। <verse eid="JOL 1:10" /><verse number="11" style="v" sid="JOL 1:11" />ओ जिम्मीदारो, शर्मिंदा ओ, ओ अंगूरा रे बगीचेया रे मालको, कणक ओर जौ खे हाय, हाय करो, कऊँकि फसल बर्बाद ऊई गी री। <verse eid="JOL 1:11" /><verse number="12" style="v" sid="JOL 1:12" />अंगूरा री बेल सूकी गी ओर दाऊगल़ेया रे डाल़ मुरझाणे लगी रे। अनार, खजूर, सेऊ, बल्कि मैदानो रे सारे डाल़ सूकी गे रे ओर लोका बीचे खुशी खत्म ऊईगी दी ए। <verse eid="JOL 1:12" /><verse number="13" style="v" sid="JOL 1:13" />ओ पुरोईतो, लको दे टाट बानी की शोग करो! रोओ, तुसे जो बेदिया री सेवा करोए, शोग करो; तुसे जो मन्दरो दे मेरे परमेशरो री सेवा करोए। आओ, ओर शोगो रे टाल्ले पईनी की रात काटो। रोओ कऊँकि एबे कोई बी तुसा रे परमेशरो रे मन्दरो दे नज्जो री बलि ओर अर्घ नि ल्याऊँदे। <verse eid="JOL 1:13" /><verse number="14" style="v" sid="JOL 1:14" />पवित्र बअरतो रा दिन ठराओ, लोका खे बोलो कि सेयो कुछ नि खाओ। तिना खे एक खास सेवा खे कट्ठा करो। मुखिया खे, ओर तिना सबी खे जो देशो दे रणे वाल़े ए, तिना खे बी बुलाओ। तिना खे आपणे परमेशर यहोवे रे मन्दरो दे बुलाओ। ओर तेसते प्रार्थना करो। <verse eid="JOL 1:14" /><verse number="15" style="v" sid="JOL 1:15" />तेते दिनो खे हाय! कऊँकि यहोवे रा दिन नेड़े ए। से सर्वशक्तिमान परमेशरो रिया तरफा ते सत्यानाश ऊणे रा दिन ऊई की आऊणा। <verse eid="JOL 1:15" /><verse number="16" style="v" sid="JOL 1:16" />म्हारे खाणे-पीणे रिया चीजा आसा सामणे बर्बाद ऊईया। ओर म्हारे परमेशरो रे मन्दरो री खुशी ओर आनन्द चली गा। <verse eid="JOL 1:16" /><verse number="17" style="v" sid="JOL 1:17" />जो बीज आसे बाया था से सूका पड़ने रिया बजा ते फूकीगा ओर नज्जो री फसल बर्बाद ऊई गी। खल्याण खाली ऊईगे ओर नज्जो रे पण्डार खाली ऊईगे।<verse eid="JOL 1:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="JOL 1:18" />डांगर पीड़ा रिया बजा ते किंयाँ रोणे लगी रे? जानवरा रे चूण्डा रे चूण्ड ओरे-पोरे पटकणे लगी रे, कऊँकि तिना खे चरने खे काआ नि मिलणे लगी रा। ओर पेडा-बाकरिया रे चूण्डा रे चूण्ड बी पीड़ा दे ए। <verse eid="JOL 1:18" /><verse number="19" style="v" sid="JOL 1:19" />ओ यहोवा, आऊँ तेरी दुहाई देऊँआ, कऊँकि उजाड़ जगा रिया चराईया आगी दे स्वा ऊईगिया ओर बणो रे सारे डाल़ आगी री बजा ते फूखी गे। <verse eid="JOL 1:19" /><verse number="20" style="v" sid="JOL 1:20" />उजाड़ जगा रे जानवर बी तुसा ते मतादा रिया तँईं बोलोए। पाणिए रिया सूबल़ा सूकी गी रिया ए। ओर आगी रेगिस्तानो रे काओ रे मैदान फूकी ते दे ए।<verse eid="JOL 1:20" /></para>
  <chapter eid="JOL 1" />
  <chapter number="2" style="c" sid="JOL 2" />
  <para style="s">यहोवे रा दिन जो आऊणे वाल़ा ए</para>
  <para style="p">
    <verse number="1" style="v" sid="JOL 2:1" />सिय्योनो रे पाह्ड़ा दे रड़सिंगे बजाओ, परमेशरो रे पवित्र पाह्ड़ो पाँदे साआ बानी की बजाओ! देशो रे सब रणे वाल़े डरी गे, कऊँकि यहोवे रा दिन आओआ, बल्कि से नेड़े ए। <verse eid="JOL 2:1" /><verse number="2" style="v" sid="JOL 2:2" />से दिन दु:खो वाल़ा ओर घोर न्हेरे वाल़ा ऊणा। काल़े बादल़ छाए दे रणे। एक बड़ी सेना आऊणे लगी री। ये प्यागा रे प्रयासे जेड़ी पाह्ड़ो दे दिशणी। एड़ी महान सेना पईले कदी पनि आई री। ओर ये आऊणे वाल़े साला दे फेर कदी नि आऊणी। <verse eid="JOL 2:2" /><verse number="3" style="v" sid="JOL 2:3" />आगी जेड़े तिना आपणियां बाटा दे आऊणे वाल़ी हर चीज फूकी देणी। तिना रे पीछे एड़ा लगोआ मानो आगी रिये लूपिये जमीन फूकी ती ए। तिना रे आगे जो जमीन ए से अदनो रे बगीचे जेड़ी ए। तिना रे पीछे एक सूका ओर खाली रेगिस्तान ए। तिना ते कुछ नि बचदा।<verse eid="JOL 2:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="JOL 2:4" />टिड्डिया रे सिर एड़े दिशणे लगी रे थे, मानो कोड़े आऊणे लगी रे। लड़ाईया रे कोड़ेया जेड़े टिड्डिया चूण्डो दे दौड़ने लगी रिया ए। <verse eid="JOL 2:4" /><verse number="5" style="v" sid="JOL 2:5" />सेयो पाह्ड़ो री चूँडिया पाँदे उटकदे ऊए रथा री जी छेड़ करोईया। सेयो सूके काओ रे आगी दे जल़ने जेड़ी चटचट करोईया। सेयो एक तागतबर सेना जेड़िया ए, जो लड़ाईया खे त्यार रओई। <verse eid="JOL 2:5" /><verse number="6" style="v" sid="JOL 2:6" />तेसा सेना रे सामणे सब लोक दु:खी ओए, सबी रे मूँ डरो रे मारे पिऊँल़े पड़ी जाओए। <verse eid="JOL 2:6" /><verse number="7" style="v" sid="JOL 2:7" />सिपाईया जेड़े सेयो अमला करोए, सिपाईया जेड़े सेयो दवाला पाँदे चढ़ोए। हर टिड्डिया रे चूण्ड सेना जेड़े आपणियां बाटा रिये जाओए; सेयो आपणी बाट नि बदलदे। <verse eid="JOL 2:7" /><verse number="8" style="v" sid="JOL 2:8" />सेयो एकी-दूजे खे ताक्का नि देंदे, सेयो तिना सबी चीजा पाँदे अमला करोए जो तिना खे रोकणे री कोशिश करोए। पर तेबे बी सेयो आपणियां पाल़िया देई रओए। <verse eid="JOL 2:8" /><verse number="9" style="v" sid="JOL 2:9" />सेयो शईरो दे ओरे-पोरे दौड़ोए ओर दवाला पाँदे चढ़ोए, सेयो कअरो दे एड़े कूसोए, जिंयाँ चोर द्वारिया ते कूसोए। <verse eid="JOL 2:9" /><verse number="10" style="v" sid="JOL 2:10" />तिना ते आगे तरती ईलोई ओर सर्ग थरथराओआ। सूरज ओर चाँदो रा प्रयासा चली जाणा ओर तारे नि चमकदे। <verse eid="JOL 2:10" /><verse number="11" style="v" sid="JOL 2:11" />यहोवा आपणे तेस दलो ते आगे आपणी आवाज सुणाओआ, कऊँकि तेसरी सेना बऊत ई बड़ी ओर तागतबर ए, जो तेसरा कईणा मानोई, कऊँकि यहोवे रा दिन बड़ा ओर बऊत खतरनाक ए, तीजी खे सयीन करना नामुमकिन ए।<verse eid="JOL 2:11" /></para>
  <para style="s">परमेशरो रिया तरफा खे आओ</para>
  <para style="p">
    <verse number="12" style="v" sid="JOL 2:12" />तेबे बी, यहोवे री ये बाणी ए, “यबु बी सुणो, बअरतो साथे रोंदे-पीटदे ओर करलांदे आपणे पूरे पापा ते मन फिरी की मांगे आओ। <verse eid="JOL 2:12" /><verse number="13" style="v" sid="JOL 2:13" />आपणा दु:ख बताणे खे तुसे आपणे टाल्ले फाड़ना बन्द करो। इजी ते कोई फाईदा नि ऊणा। इजी रे बजाए माखे दखाओ कि तुसे सच्चो मनो ते पछताणे लगी रे। आपणे परमेशर यहोवे रिया तरफा खे फिरो, कऊँकि से अनुग्रह करने वाल़ा, दयालु, गुस्सा करने रे देरी करने वाल़ा, करूणा करने वाल़ा ओर दु:ख देई की आपणा मन बदल़ने वाल़ा ए। <verse eid="JOL 2:13" /><verse number="14" style="v" sid="JOL 2:14" />क्या पता से तुसा पाँदे तरस खाओ ओर जो सजा से तुसा खे देणा चाओ था तीजी रे बदले से तुसा खे एड़ी आशीष देयो जेते कि तुसे आपणे परमेशर यहोवे खे नज्जो री बलि ओर अर्घ चढ़ाई सको।” <verse eid="JOL 2:14" /><verse number="15" style="v" sid="JOL 2:15" />सिय्योनो दे रड़सिंगे बजाओ, पवित्र बअरतो रा दिन ठराओ, बड़ी सभा रा प्रचार करो। <verse eid="JOL 2:15" /><verse number="16" style="v" sid="JOL 2:16" />पक्का करो की लोक रीति रवाजा रे मुताबिक पवित्र ए, तिना खे कट्ठा करो। बुजुर्गा खे बुलाई लो, बच्चे ओर दूद पीणे वाल़े बच्चेया खे बी कट्ठे करो। नवें ब्या कित्ते रे लाड़ा लाड़ी बी आपणे कमरे ते निकल़ी की आओ। <verse eid="JOL 2:16" /><verse number="17" style="v" sid="JOL 2:17" />पुरोईत जो यहोवे री सेवा करने वाल़े ए, सेयो आँगण ओर बेदिया बीचे रोई-रोई की ये प्रार्थना करो, “ओ यहोवा, आपणी प्रजा खे बचा ओर आपणे इस्से री बेज्जती नि ऊणे दे, ना दूजी जातिया तिजी रा उदारण देई सको। जातिया-जातिया रे लोका आपू बीचे ये बोलणा कि तिना रा परमेशर केई ए?”<verse eid="JOL 2:17" /></para>
  <para style="s">परमेशर आपणे लोका री प्रार्थना रा ज्वाब देओआ</para>
  <para style="p">
    <verse number="18" style="v" sid="JOL 2:18" />तेबे यहोवे खे आपणे देशो रिया तँईं फिकर ऊणे लगेया, तिने आपणे लोका पाँदे दया कित्ती। <verse eid="JOL 2:18" /><verse number="19" style="v" sid="JOL 2:19" />यहोवे आपणी प्रजा रे लोका खे ज्वाब दित्तेया, “सुणो, आऊँ तुसा खे नज्ज, ताजा शराब ओर जैतूनो रा तेल पेजणे लगी रा। ओर जेबे से तुसा खे मिलणा तेबे तुसे रज्जी जाणे ओर मां आजो ते बाद दूजी जातिया ते तुसा री बेज्जती नि ऊणे देणी। <verse eid="JOL 2:19" /><verse number="20" style="v" sid="JOL 2:20" />टिड्डिया रा एक ओर चूण्ड उत्तरा रिया तरफा ते तुसा पाँदे अमला करने खे आऊणा, पर मां सेयो यरूशलेमो ते आगे रेगिस्तानो दे जाणे खे मजबूर करी देणा। कुछ पूर्वा रिया तरफा खे मृत सागरो दे चली जाणे ओर कुछ पच्छमा दे बड़े समुद्रो दे चली जाणे। तेती सेयो सब मरी जाणे, ओर तिना रे शरीरो ते बास आऊणी।” <verse eid="JOL 2:20" /><verse number="21" style="v" sid="JOL 2:21" />ओ देश, तूँ नि डर, तूँ मगन ओ ओर खुशी मना, कऊँकि यहोवे बड़े-बड़े काम करी राखे। <verse eid="JOL 2:21" /><verse number="22" style="v" sid="JOL 2:22" />उजाड़ जगा रे जानवरो डरो नि। रेगिस्तानो दे काओ रिया काईणी फेर अरिया ऊणे लगी रिया। डाल़ आपणे फल़ देणे लगी रे। अंगूरा री बेला दे ओर दाऊगल़े रे डाल़ा दे फल़ लगणे लगी रे। <verse eid="JOL 2:22" /><verse number="23" style="v" sid="JOL 2:23" />ओ सिय्योन पाह्ड़ो रे लोको खुश रओ, तुसे आपणे परमेशर यहोवे रिया बजा ते खुशी मनाओ, फेर मैं तुसा रिया तँईं पारी बर्खा करी राखी ए। पईले जेड़े ई मैं बरसाती री बर्खा ओर बसंत ऋतुआ री बर्खा करी राखी ए। <verse eid="JOL 2:23" /><verse number="24" style="v" sid="JOL 2:24" />तुसा रे खल्याण नज्जो साथे परी जाणे ओर रसकुण्ड नवें शराबो साथे ओर जैतूनो रे तेलो साथे परी जाणे।<verse eid="JOL 2:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="JOL 2:25" />यहोवे बोलेया, “मां तुसा खे तिना सबी चीजा रा बदला देणा जो कुछ गाजाम<note caller="+" style="f"><char style="fr" closed="false">2:25 </char><char style="fq" closed="false">गाजाम </char><char style="ft" closed="false">कुतरने वाल़िया </char></note> नाओं री टिड्डिये, अर्बे<note caller="+" style="f"><char style="fr" closed="false">2:25 </char><char style="fq" closed="false">अर्बे </char><char style="ft" closed="false">उडणे वाल़ी </char></note> नाओं री टिड्डिये, येलेक<note caller="+" style="f"><char style="fr" closed="false">2:25 </char><char style="fq" closed="false">येलेक </char><char style="ft" closed="false">उटकणे वाल़ी </char></note> नाओं री टिड्डिये ओर हारसील<note caller="+" style="f"><char style="fr" closed="false">2:25 </char><char style="fq" closed="false">हारसील </char><char style="ft" closed="false">छिलणे वाल़ी </char></note> टिड्डिये खाई ला था। जो मैं तुसा पाँदे अमला करने खे पेजी राखिया थिया। <verse eid="JOL 2:25" /><verse number="26" style="v" sid="JOL 2:26" />तुसा पेट परी की खाणा ओर रज्जी जाणे ओर आपणे परमेशर यहोवे रे नाओं री स्तुति करनी, जिने तुसा खे अचम्बे रे काम कित्ते ओर मेरी प्रजा री कदी बी बेज्जत नि ऊणी। <verse eid="JOL 2:26" /><verse number="27" style="v" sid="JOL 2:27" />तेबे तुसा खे पता लगी जाणा कि आऊँ इस्राएलो लोका बीचे आ। आऊँ तुसा रा परमेशर यहोवा आ। ओर कोई दूजा परमेशर नि ए। इजी री खातर मेरे लोका खे फेर बेज्जत नि ऊणा पड़ना। यहोवे रा दिन आऊणे लगी रा।”<verse eid="JOL 2:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="JOL 2:28" />तिना गल्ला ते बाद मां सबी प्राणिया पाँदे आपणा आत्मा पेजणा, तुसा रे माठे-बेटिया भविष्यबाणी करनी ओर तुसा रे बुजुर्गा सुफने देखणे ओर तुसा रे जवाना दर्शण देखणे। <verse eid="JOL 2:28" /><verse number="29" style="v" sid="JOL 2:29" />तिना दिना दे मां आपणा आत्मा आपणे दासा पाँदे पेजणा, से चाए मर्द ओ या जवाणस। <verse eid="JOL 2:29" /><verse number="30" style="v" sid="JOL 2:30" />मां सर्ग ओर तरतिया दे चमत्कार, मतलब खून ओर आग ओर तुएँ रे खम्बे दखाणे। <verse eid="JOL 2:30" /><verse number="31" style="v" sid="JOL 2:31" />यहोवे रे तेस खतरनाक ओर बड़े दिनो रे आऊणे ते पईले सूरजो रा प्रयासा चली जाणा ओ चाँद खूनो जेड़ा लाल ऊई जाणा। तेस बड़े ओर डराऊणे दिनो ते पईले जेबे मां, यहोवे, आऊणा ये सब ऊणा। <verse eid="JOL 2:31" /><verse number="32" style="v" sid="JOL 2:32" />जेस केसी यहोवे ते प्रार्थना करनी से तेस बचाणे। आऊँ वादा करूँआ कि यरूशलेमो दे कुछ लोक बिपदा ते बची जाणे; जो मैं चूणी राखे सेयो बची जाणे।<verse eid="JOL 2:32" /></para>
  <chapter eid="JOL 2" />
  <chapter number="3" style="c" sid="JOL 3" />
  <para style="s">परमेशरो सबी देशा रा न्याय करना</para>
  <para style="p">
    <verse number="1" style="v" sid="JOL 3:1" />यहोवा ये बोलोआ, “सुणो, जिना दिना दे ओर जेस बखतो दे मां यहूदा ओर यरूशलेमो रे रणे वाल़े गुलामिया ते वापस ली आऊणे, <verse eid="JOL 3:1" /><verse number="2" style="v" sid="JOL 3:2" />तेस बखते मां सारे देशो रे लोक कट्ठे करी की यहोशापातो<note caller="+" style="f"><char style="fr" closed="false">3:2 </char><char style="fq" closed="false">यहोशापातो </char><char style="ft" closed="false">यहोवा न्याय करोआ </char></note> री तराईया दे लई जाणे ओर तेती तिना साथे आपणी प्रजा, मतलब आपणा निज इस्सा इस्राएलो रे बारे दे जो तिने दूजी जातिये मेरा देश इस्राएल आपू बीचे बांडी ला था: इजी री खातर मां तेती तिना जातिया रा न्याय करना। <verse eid="JOL 3:2" /><verse number="3" style="v" sid="JOL 3:3" />तिने मेरे लोका रिया तँईं पर्चिया पाईया। तिने वेश्या खे पाणे रिया तँईं आपणे माठे गुलाम बनाणे खे बेचीते। तिने शराबो रिया तँईं खे बेटिया बेची तिया।”<verse eid="JOL 3:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="JOL 3:4" />ओ सोर, ओर सिदोन शईरो रे लोको ओर ओ पलिश्तीन प्रदेशो रे लोको, मैं तुसा रा कोई नुकशाण नि करी राखेया! इजी री खातर जे तुसे मांते बदला लणे री कोशिश करने लगी रे ओ, तो मां तुसा ते तुसा रे कामा रा बदला लणा। <verse eid="JOL 3:4" /><verse number="5" style="v" sid="JOL 3:5" />कऊँकि तुसे मेरे मन्दरो ते सूईना-चाँदी ओर कई कीमती चीजा लूटी लिया ए ओर सेयो आपणे मन्दरो दे लई जाई की राखी तिया दिया ए। <verse eid="JOL 3:5" /><verse number="6" style="v" sid="JOL 3:6" />यहूदा ओर यरूशलेमो रे लोक तिना रे दुश्मणे यूनानिया खे जो यावानो रे वंशो रे थे इजी री खातर बेचे, ताकि सेयो आपणे देशो ते दूर कित्ते जाओ। <verse eid="JOL 3:6" /><verse number="7" style="v" sid="JOL 3:7" />इजी री खातर सुणो, पर एबे मां सेयो बदला लणे खे पड़काणे। मां सेयो तेते जगा ते वापस ल्याऊणे जेती तुसे सेयो बेचे थे। ओर मां तुसा साथे सेई करना जो तुसे तिना साथे कित्तेया था। <verse eid="JOL 3:7" /><verse number="8" style="v" sid="JOL 3:8" />मां तुसा रे माठे-बेटिया मतलब आऊणे वाल़ी पीढ़ी यहूदिया रे आथो दे बिकवाई देणे ओर तिना सेयो शबाई जातिया रे लोका रे आथो दे बेची देणे, कऊँकि परमेशरे ये बोली राखेया। <verse eid="JOL 3:8" /><verse number="9" style="v" sid="JOL 3:9" />सबी देशा रे लोका दे ये प्रचार करो, युद्धो री त्यारी करो, आपणे योद्धा खे त्यार करो। सारे योद्धा नेड़े आई की लड़ने खे आगे बढ़ो। <verse eid="JOL 3:9" /><verse number="10" style="v" sid="JOL 3:10" />आपणे-आपणे अल़ो रे फाल़े खे कूटी की तलवारा ओर आपणी-आपणी दाचिया खे कूटी की बड़छे बणाओ, जो कमजोर ओ से बी बोलो, आऊँ वीर ए।<verse eid="JOL 3:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="JOL 3:11" />ओ चऊँ कनारले देशा रे लोको, फटाफट आओ ओर कट्ठे ऊई जाओ। ओ यहोवा, तूँ बी आपणे शूरवीरा खे तेती लई जा। <verse eid="JOL 3:11" /><verse number="12" style="v" sid="JOL 3:12" />सबी देशा रे लोक त्यार ऊई की आगे बढ़ी की आओ ओर यहोशापातो री तराईया दे लड़ने खे आई जाओ, कऊँकि तेती मां चऊँ कनारली जातिया रा न्याय करने खे बैठणा। <verse eid="JOL 3:12" /><verse number="13" style="v" sid="JOL 3:13" />सेयो बडाईया खे त्यार फसला जेड़े ए; इजी री खातर तिना पाँदे आथ चलाओ, जेड़े एक जिम्मीदार फसला खे बाडणे खे आपणी दाची चलाओआ। सेयो अंगूरा जेड़े ए जिना खे गड्डेया दे ऊच्चा टेर लगाई की राखी राखेया ए, जेती तिना खे केसेया जाओआ। कऊँकि सेयो बऊत दुष्ट ए, तिना खे एबु सख्त सजा देयो, जेड़े एक जिम्मीदार अंगूरा खे रसकुण्डो दे तदुए तक केसदा रओआ जदुए तक कि रस निकल़ना बन्द नि ऊई जाओ। <verse eid="JOL 3:13" /><verse number="14" style="v" sid="JOL 3:14" />तेसा यहोशापातो री तराईया दे बऊत सारे लोक ए। कऊँकि तेते तराईया दे यहोवे रा दिन नेड़े ए। <verse eid="JOL 3:14" /><verse number="15" style="v" sid="JOL 3:15" />सूरज ओर चाँदो आपणा-आपणा प्रयासा नि देणा ओर ना तारे चमकणे। <verse eid="JOL 3:15" /><verse number="16" style="v" sid="JOL 3:16" />परमेशर यहोवा सिय्योनो ते गरजणा ओर यरूशलेमो दे गरजणा सुणना जेते री बजा ते सर्ग ओर तरती काँबी जाणे। पर यहोवा आपणी प्रजा खे शरण देणे री जगा ओर इस्राएलिया खे मजबूत गढ़ ठईरना।<verse eid="JOL 3:16" /></para>
  <para style="s">परमेशरो रे लोका खे आशीष</para>
  <para style="p">
    <verse number="17" style="v" sid="JOL 3:17" />तेबे तुसा जाणी लणा कि आऊँ तुसा रा परमेशर यहोवा, आऊँ आपणे पवित्र पाह्ड़ सिय्योनो पाँदे वास करूँआ। यरूशलेम सदा पवित्र रणा, ओर परदेशी सिपाई तेसखे फेर कदी बी जीती नि सकणे। <verse eid="JOL 3:17" /><verse number="18" style="v" sid="JOL 3:18" />तेस बखते पाह्ड़ो ते अंगूरा रा रस टपकणा। पाह्ड़िया ते दूद बईणा। यहूदा प्रदेशो रे सारे नाल़े पाणिए साथे परी जाणे ओर यहोवे रे मन्दरो बीचा ते एक सूबल़ निकल़नी, एस शित्तीम जगा खे पाणी देणा जेती बबूलो रे डाल़ जम्मोए। <verse eid="JOL 3:18" /><verse number="19" style="v" sid="JOL 3:19" />मिस्र देश ओर एदोम देशो रे लोके यहूदा रे लोका री अत्या कित्ती, तिने तिना रे देशो दे बेकसुर लोका रा खून बाह्ई राखेया, एबे मिस्र देश ऊजड़ ओर एदोम देश उजड़ेया दा रेगिस्तान ऊई जाणा। <verse eid="JOL 3:19" /><verse number="20" style="v" sid="JOL 3:20" />पर यहूदा सदा ओर यरूशलेम हमेशा खे बणेया दा रणा। <verse eid="JOL 3:20" /><verse number="21" style="v" sid="JOL 3:21" />जिना देशा रे लोके इस्राएलो रे बेकसूर लोका री अत्या करी राखी, तिना ते मां बदला लणा, मां तिना रे खूनो रा पाप माफ नि करना। कऊँकि परमेशर यहोवा सिय्योन रे पाह्ड़ो पाँदे वास करोआ।<verse eid="JOL 3:21" /></para>
  <chapter eid="JOL 3" />
</usx>