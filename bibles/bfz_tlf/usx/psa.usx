  <para style="h">पजन</para>
  <para style="toc1">पजना रा संग्रह</para>
  <para style="toc2">पजन</para>
  <para style="toc3">पज.</para>
  <para style="mt">पजन</para>
  <para style="mt2">पजना रा संग्रह</para>
  <para style="is">भूमिका</para>
  <para style="ip">कविता रा संग्रह, पजना री कताब पुराणे नियमो री कताबा दे एक ई जिदे कई रचणे वाल़ेया री रचना रा संग्रह ए। इजी रे कई लिखणे वाल़े ए: दाऊद, आसाप, कोरह रे माठे, सुलैमान, एतान, मूसा ओर अणजाण लोक ए। ये कताब लगभग 1440-430 ई. पू. दे लिखी थी।</para>
  <para style="ip">व्यक्तिगत पजन इतिआसो दे मूसे रे बखतो तक पुराणे ए ओर दाऊद, आसाप, सुलैमान ओर एज्रा पंथियों (बाबेलो रे गुलामिया ते बादो तक) तक रे ए। इजी रा मतलब ए कि एसा कताबा दे लगभग एक ह्जार सालो रा पजन संग्रह ए। इस्राएलो री प्रजा-परमेशरे तिना रिया तँईं ओर पूरे इतिआसो दे विश्वासिया रिया तँईं क्या कित्तेया ए। पजना रे बारे दे: परमेशर ओर तेसरी सृष्टि, युद्ध, आराधना, समज, पाप ओर बुराई, सजा न्याय ओर मसीह रा आऊणा। पजन पढ़ने वाल़ेया खे प्रोत्साहित करोए कि सेयो परमेशरो रा ओर तेसरे कामा रा गुणगान करो।</para>
  <para style="iot">रूप-रेखा</para>
  <para style="io1">मसीही कताब <char style="ior"><ref loc="PSA 1:1-41:13">1:1-41:13</ref> </char></para>
  <para style="io1">मनोकामना री कताब <char style="ior"><ref loc="PSA 42:1-72:20">42:1-72:20</ref> </char></para>
  <para style="io1">इस्राएलो री कताब <char style="ior"><ref loc="PSA 73:1-89:52">73:1-89:52</ref> </char></para>
  <para style="io1">परमेशरो रे शासनो री कताब <char style="ior"><ref loc="PSA 90:1-106:48">90:1-106:48</ref> </char></para>
  <para style="io1">गुणगाणो री कताब <char style="ior"><ref loc="PSA 107:1-150:6">107:1-150:6</ref> </char></para>
  <chapter number="1" style="c" sid="PSA 1" />
  <para style="ms">पईला इस्सा</para>
  <para style="mr">
    <ref loc="PSA 1-41">पजन 1-41</ref></para>
  <para style="s">तर्मी ओर दुष्ट माणूं</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 1:1" />खुश सेयो लोक ए जो दुष्ट लोका रिया सलाई खे नि मानदे,</para>
  <para style="q" vid="PSA 1:1">ओर जो पापिया रे उदारणा खे नि मानदे</para>
  <para style="q" vid="PSA 1:1">ओर ना तिना लोका बीचे शामिल ओए जो परमेशरो रा मजाक उडाओए।<verse eid="PSA 1:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 1:2" />इना सबी गल्ला खे छाडी की सेयो यहोवे रे बिधानो खे मानणे ते खुश रओए</para>
  <para style="q" vid="PSA 1:2">ओर सेयो रात-दिन तीजी रे बारे दे त्यानो साथे पढ़ोए ओर सोचदे रओए।<note caller="+" style="f"><char style="fr" closed="false">1:2 </char><char style="ft" closed="false">यहो. 1:8</char></note><verse eid="PSA 1:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 1:3" />से माणूं तेस डाल़ो जेड़ा ए, जो आपणे आपू नि जम्मी रा बल्कि आपणी इच्छा ते बह्ईंदे पाणिए रे कनारे लगाई राखेया,</para>
  <para style="q" vid="PSA 1:3">ओर आपणे बखतो दे फल़ो आ ओर जेसरे पत्ते कदी बी मुरझांदे नि। तेबेई तो जो कुछ से माणूं करोआ, से सफल ओआ।<note caller="+" style="f"><char style="fr" closed="false">1:3 </char><char style="ft" closed="false">यिर्म. 17:8, पजन. 92:12-14</char></note><verse eid="PSA 1:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 1:4" />दुष्ट माणूं एड़े नि ऊँदे,</para>
  <para style="q" vid="PSA 1:4">सेयो पूए जेड़े ओए, जेतेखे पऊण डवाई देओई।<verse eid="PSA 1:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 1:5" />पापिया गे न्याय रे दिने कोई बी बाना नि ऊणा ओर सेयो दोषी ठराए जाणे,</para>
  <para style="q" vid="PSA 1:5">ओर सेयो तर्मिया री मण्डल़िया ते दूर कित्ते जाणे।<verse eid="PSA 1:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 1:6" />कऊँकि से तर्मी लोका रा मार्गदर्शन ओर रक्षा करोआ, पर जेते बाटा दे दुष्ट हांडोए से तिना खे तेथी लई जाओआ,</para>
  <para style="q" vid="PSA 1:6">जेती तिना खे हमेशा खे परमेशरो रे जरिये सजा मिलणी।<note caller="+" style="f"><char style="fr" closed="false">1:6 </char><char style="ft" closed="false">पजन. 68:2; 73:27; 92:9</char></note><verse eid="PSA 1:6" /></para>
  <chapter eid="PSA 1" />
  <chapter number="2" style="c" sid="PSA 2" />
  <para style="s">परमेशरो रा अभिषिक्त राजा</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 2:1" />जातिया-जातिया रे लोक परमेशरो ते गुस्से कऊँ ओए?</para>
  <para style="q" vid="PSA 2:1">लोक आपणे बेकारो रिया योजना कऊँ बणाओए?<note caller="+" style="f"><char style="fr" closed="false">2:1 </char><char style="ft" closed="false">सेयो लोक जो परमेशरो खे नि जाणदे </char></note><verse eid="PSA 2:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 2:2" />तरतिया रे तिना सबी जातिया रे राजेया यहोवा ओर तेसरे चूणे दे राजे रे खलाफो दे</para>
  <para style="q" vid="PSA 2:2">एक मन ऊई कि बिद्रोह कित्तेया ओर आपू बीचे बोलणे लगे,<note caller="+" style="f"><char style="fr" closed="false">2:2 </char><char style="ft" closed="false">प्रकाशित 11:18, प्रेरित 4:25,26, प्रकाशित 19:19</char></note><verse eid="PSA 2:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 2:3" />“आओ, आसे आपणे आपू खे प्रभु ओर तेसरे राजे ते छुट्टी जाईए</para>
  <para style="q" vid="PSA 2:3">जो आसा पाँदे राज्य ओर कब्जा करोए।”<verse eid="PSA 2:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 2:4" />स्वर्गो दे विराजमान यहोवा आपणे सिंहासनो पाँदे बैठी रा,</para>
  <para style="q" vid="PSA 2:4">तेसखे आसी आई ओर तिना रिया योजना रा मजाक उडाया।<verse eid="PSA 2:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 2:5" />तेबे प्रभुए तिना खे गुस्से दे चतौणी देणी,</para>
  <para style="q" vid="PSA 2:5">ओर बऊत गुस्से दे ये बोली की सेयो डराणे,<verse eid="PSA 2:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 2:6" />परमेशरे बोलेया, “आऊँ आपणे पवित्र पाह्ड़ सिय्योनो री राजगद्दिया पाँदे तो</para>
  <para style="q" vid="PSA 2:6">आपणे चूणे रे राजे खे बठयाल़ी चुकेया रा।”<verse eid="PSA 2:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 2:7" />राजे बोलेया, “मां सेयो वचन सबी खे बताणे जो माखे यहोवे बताई राखे,</para>
  <para style="q" vid="PSA 2:7">तूँ मेरा पाऊ ए, आजो ते आऊँ तेरा बाओ आ।<note caller="+" style="f"><char style="fr" closed="false">2:7 </char><char style="ft" closed="false">मत्ती 3:17, मत्ती 17:5, मरक 1:11, मरक 9:7, लूक 3:22, लूक 9:35, यूह. 1:49, प्रेरित 13:33, इब्रानी 1:5, इब्रानी 5:5, 2 पत 1:1</char></note><verse eid="PSA 2:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 2:8" />तूँ मांते माँग ओर मां देशो-देशो रे लोक तेरी जायदात ऊणे खे,</para>
  <para style="q" vid="PSA 2:8">ओर पूरी तरती तेरे अक्को दे करी देणी।<note caller="+" style="f"><char style="fr" closed="false">2:8 </char><char style="ft" closed="false">इब्रानी 1:2</char></note><verse eid="PSA 2:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 2:9" />तां सेयो पुरिया तरआ ते अराई देणे, तां सेयो नाश करी देणे,</para>
  <para style="q" vid="PSA 2:9">जिंयाँ लोक लोए रे डण्डे साथे माट्टिया रे पांडेया खे चूर-चूर करोए।”<note caller="+" style="f"><char style="fr" closed="false">2:9 </char><char style="ft" closed="false">प्रकाशित 2:27, प्रकाशित 12:5, प्रकाशित 19:15</char></note><verse eid="PSA 2:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 2:10" />इजी री खातर एबे, ओ राजेयो, अक्लमंद बणो।</para>
  <para style="q" vid="PSA 2:10">ओ तरतिया रे न्यायियो! सम्बल़ी जाओ।<verse eid="PSA 2:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 2:11" />डरदे ऊए प्रभुए री आराधना करो ओर थरथरांदे ऊए मगन ओ।<note caller="+" style="f"><char style="fr" closed="false">2:11 </char><char style="ft" closed="false">फिलि. 2:12</char></note><verse eid="PSA 2:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 2:12" />तेसरे पाऊए रे सामणे नम्र बणी की प्रणाम करो! जे तुसे एड़ा नि करदे, तो यहोवा बऊत गुस्से ऊणा,</para>
  <para style="q" vid="PSA 2:12">ओर तेस अचाणक तुसे काई देणे, ये मत सोचणा कि तेस बऊत छोड़ दखाई देणा कि से बऊत गुस्से दे ए!</para>
  <para style="q" vid="PSA 2:12">पर से तिना सबी लोका साथे बऊत खुश ए जो तिना ते रक्षा करने रा अनुरोद करोए।<verse eid="PSA 2:12" /></para>
  <chapter eid="PSA 2" />
  <chapter number="3" style="c" sid="PSA 3" />
  <para style="s">मुसीबता रे बखते आत्म-परोसा</para>
  <para style="d">दाऊदो रा पजन। जेबे से आपणे पाऊ अबशालोमो गे ते नठेया था।</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 3:1" />ओ प्रभु, मेरे सताणे वाल़े कितणे बढ़ीगे रे!</para>
  <para style="q" vid="PSA 3:1">मेरे बरोदो रे बऊत जणे उठी गे रे।<verse eid="PSA 3:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 3:2" />सेयो मेरे बारे बोलोए</para>
  <para style="q" vid="PSA 3:2">कि तेसखे परमेशर पनि बचाई सकदा। सेला<verse eid="PSA 3:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 3:3" />पर ओ प्रभु! तूँ माखे हमेशा खतरे ते बचाणे रिया तँईं मेरे चऊँ कनारे महिमा जेड़ा ए।</para>
  <para style="q" vid="PSA 3:3">तूँ माखे जिताएया ओर मेरिया ईमती खे बढ़ाएया।<verse eid="PSA 3:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 3:4" />आऊँ तां प्रभुए खे जोरे की आका पाऊँआ</para>
  <para style="q" vid="PSA 3:4">ओर तूँ आपणे पवित्र पाह्ड़ो मतलब सियोनों ते माखे उत्तर देओआ। सेला<verse eid="PSA 3:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 3:5" />आऊँ लेटीगा ओर निश्चे साथे सुती गा,</para>
  <para style="q" vid="PSA 3:5">आँऊ फेर ठीक-ठाक जागी की उठी गा, कऊँकि तूँ माखे सारी रात सम्बाल़ने वाल़ा प्रभु ए,<verse eid="PSA 3:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 3:6" />आऊँ तिना दस ह्जार दुश्मणा ते नि डरदा,</para>
  <para style="q" vid="PSA 3:6">जो माखे काणे रिया तँईं चऊँ कनारे ते केरी की खड़ी रे।<verse eid="PSA 3:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 3:7" />उठ, ओ यहोवा! माखे बचाई लओ,</para>
  <para style="q" vid="PSA 3:7">मेरे परमेशर! तूँ मेरे सबी दुश्मणा खे सजा देओआ</para>
  <para style="q" vid="PSA 3:7">ओर तिना खे नुकशाण पऊँचाणे रिया तँईं कमजोर बणाई देओआ।<verse eid="PSA 3:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 3:8" />उद्धार प्रभुए तेई ओआ।</para>
  <para style="q" vid="PSA 3:8">ओ प्रभु! तेरी आशीष तेरी प्रजा रे लोका पाँदे ओ।<verse eid="PSA 3:8" /></para>
  <chapter eid="PSA 3" />
  <chapter number="4" style="c" sid="PSA 4" />
  <para style="s">परमेशरो पाँदे परोसा</para>
  <para style="d">बजाणे वाल़े रे परदानो रिया तँईं : तारा वाल़े बाजेया साथे। दाऊदो रा पजन</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 4:1" />ओ मेरी रक्षा करने वाल़े तर्मी परमेशर! जेबे आऊँ ताखे आका पाऊँ तेबे तूँ माखे उत्तर देया;</para>
  <para style="q" vid="PSA 4:1">जेबे आऊँ परेशानिया रे पड़ेया रा था तेबे तैं मेरी मताद कित्ती।</para>
  <para style="q" vid="PSA 4:1">एबे मां पाँदे दया कर ओर मेरी प्रार्थना सुणी लओ।<verse eid="PSA 4:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 4:2" />ओ माणूंओ! कदुओ तक मेरी महिमा रे बदले बेज्जती ऊँदा रणा?</para>
  <para style="q" vid="PSA 4:2">तुसा कदुओ तक चूठे देवतेया साथे प्यार राखणा ओर चूठी योजना री टोल़ा रे रणा? सेला<verse eid="PSA 4:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 4:3" />ये जाणी लओ कि प्रभुए तर्मी दास आपणियां खातर लग करी राखे।</para>
  <para style="q" vid="PSA 4:3">जेबे मां प्रभुए खे आक पाणी तेबे तेस सुणी लणी।<verse eid="PSA 4:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 4:4" />जेबे तुसा खे गुस्सा आओआ तो तुसा रा गुस्सा तुसा खे आपणे वशो दे नि करो, ओर से तुसा ते पाप नि करवाओ।</para>
  <para style="q" vid="PSA 4:4">जेबे तुसे आपणे बिस्तरे पाँदे लेटोए, तो चुपचाप ऊई की आपू खे परखो कि तुसे क्या सोचोए।<verse eid="PSA 4:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 4:5" />यहोवे खे ठीक बलिदान चढ़ाओ</para>
  <para style="q" vid="PSA 4:5">ओर तेस पाँदे ई परोसा करेया करो।<verse eid="PSA 4:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 4:6" />कई माणूं एड़ा बोलोए, “काश! आसे पलाईया खे देखी सकदे।</para>
  <para style="q" vid="PSA 4:6">ओ प्रभु, तूँ आसा खे दया रिया नजरा ते देख!”<verse eid="PSA 4:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 4:7" />तैं मेरे मनो रे तेसते केथी जादा खुशी परी ती री,</para>
  <para style="q" vid="PSA 4:7">जो तिना खे नज्ज ओर जादा अंगूरा रे रसो री बढ़ोतरिया ते ओई।<verse eid="PSA 4:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 4:8" />मां शान्तिया दे लेटी जाणा ओर निश्चे री नींजा दे सुती जाणा;</para>
  <para style="q" vid="PSA 4:8">कऊँकि ओ प्रभु, तूँई माखे निश्चिंत रणे देओआ।<verse eid="PSA 4:8" /></para>
  <chapter eid="PSA 4" />
  <chapter number="5" style="c" sid="PSA 5" />
  <para style="s">सई बाट बताणे रिया तँईं प्रार्थना</para>
  <para style="d">बजाणे वाल़े परदानो रिया तँईं : बंसरिया साथे, दाऊदो रा पजन</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 5:1" />ओ प्रभु, मेरे शब्द त्यानो साथे सुण,</para>
  <para style="q" vid="PSA 5:1">मेरे त्यान करने रिया तरफा खे मन लगा।<verse eid="PSA 5:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 5:2" />ओ मेरे राजा! मेरे परमेशर! आँऊ तेरी दुहाई देऊँआ तिजी पाँदे त्यान दे,</para>
  <para style="q" vid="PSA 5:2">कऊँकि आऊँ तांते ई प्रार्थना करूँआ।<verse eid="PSA 5:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 5:3" />ओ प्रभु, प्यागा ताखे मेरी पुकार सुणनी।</para>
  <para style="q" vid="PSA 5:3">मां तड़के उठी की प्रार्थना करी की तेरे ज्वाबो रा इन्तजार करना।<verse eid="PSA 5:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 5:4" />कऊँकि तूँ एड़ा परमेशर नि ए जो दुष्टता रे कामा ते खुश ओआ;</para>
  <para style="q" vid="PSA 5:4">बुरे लोक तां साथे नि रई सकदे।<verse eid="PSA 5:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 5:5" />कमण्डी तां सामणे खड़े नि रई सकणे;</para>
  <para style="q" vid="PSA 5:5">ताखे सबी अनर्थ करने वाल़ेया ते नफरत ए।<verse eid="PSA 5:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 5:6" />तां सेयो, जो चूठ बोलोए नाश करी देणे;</para>
  <para style="q" vid="PSA 5:6">प्रभु तो अत्यारे ओर कपट करने वाल़ेया माणूंआ ते नफरत करोआ।<verse eid="PSA 5:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 5:7" />पर आऊँ तेरी अपार करूणा रिया बजा ते तेरे मईलो रे आऊणा।</para>
  <para style="q" vid="PSA 5:7">मां तेरा डर मानी की तेरे पवित्र मन्दरो रिया तरफा खे माथा टेकणा।<verse eid="PSA 5:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 5:8" />ओ यहोवा, माखे सई बाटा दे चलणे दे मताद कर।</para>
  <para style="q" vid="PSA 5:8">मेरे दुश्मण मां पाँदे अमला करने रा इन्तजार करने लगी रे।</para>
  <para style="q" vid="PSA 5:8">माखे सई तरीके री बाट दखा,</para>
  <para style="q" vid="PSA 5:8">ताकि आऊँ गल़त बाटा दे नि जाई सकूँ।<verse eid="PSA 5:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 5:9" />जो कुछ सेयो बोलोए से सच्च नि ए!</para>
  <para style="q" vid="PSA 5:9">सेयो सिर्फ नाश करना चाओए।</para>
  <para style="q" vid="PSA 5:9">तिना रे शब्द छिपे दे गड्डे जेड़े तोखा देणे वाल़े ओए,</para>
  <para style="q" vid="PSA 5:9">ओर तिना री जीब चूठ बोलणे रिया तँईं ठीक ओई।<note caller="+" style="f"><char style="fr" closed="false">5:9 </char><char style="ft" closed="false">रोम. 3:13 </char></note><verse eid="PSA 5:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 5:10" />ओ परमेशर, तूँ तिना खे दोषी ठईरा;</para>
  <para style="q" vid="PSA 5:10">सेयो आपणी साजिशा रे आपू ई फसी जाओ;</para>
  <para style="q" vid="PSA 5:10">तिना खे तिना रे जादा पापो रिया बजा ते आपणे सामणे ते दूर करी दे,</para>
  <para style="q" vid="PSA 5:10">कऊँकि तिने तां साथे बगावत करी राखी।<verse eid="PSA 5:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 5:11" />पर जितणे तां पाँदे परोसा राखोए, सब आनंद करो,</para>
  <para style="q" vid="PSA 5:11">सेयो सदा जोरे की गांदे रओ; तूँ तिना री रक्षा करेया,</para>
  <para style="q" vid="PSA 5:11">ओर जो तां साथे प्यार करोए, सेयो तांदे खुश ओ।<verse eid="PSA 5:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 5:12" />तूँ तर्मी लोका खे आशीर्वाद देआ जो तेरिया आज्ञा खे मानोए,</para>
  <para style="q" vid="PSA 5:12">प्रभु; तेरा प्रेम तिना खे बचाओआ।<verse eid="PSA 5:12" /></para>
  <chapter eid="PSA 5" />
  <chapter number="6" style="c" sid="PSA 6" />
  <para style="s">दया रिया तँईं प्रार्थना</para>
  <para style="d">बजाणे वाल़े परदानो रिया तँईं : तारा वाल़े बाजे साथे। खर्ज रागो रे, दाऊदो रा पजन</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 6:1" />ओ प्रभु, तूँ माखे आपणे गुस्से रे नि चिड़क,</para>
  <para style="q" vid="PSA 6:1">ना माखे ताड़ना दे।<verse eid="PSA 6:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 6:2" />ओ प्रभु, मां पाँदे दया कर, कऊँकि आऊँ कमजोर ऊईगा रा,</para>
  <para style="q" vid="PSA 6:2">प्रभु, माखे तागत दे, आऊँ पुरिया तरआ ते थकी गा रा ए।<verse eid="PSA 6:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 6:3" />आऊँ बऊत जादा परेशान ए।</para>
  <para style="q" vid="PSA 6:3">कदुए तक, ओ प्रभु, तां मेरी मताद करने खे इन्तजार करदे रणा?<note caller="+" style="f"><char style="fr" closed="false">6:3 </char><char style="ft" closed="false">यूह. 12:27</char></note><verse eid="PSA 6:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 6:4" />यहोवा, आ ओर माखे बचाई लो।</para>
  <para style="q" vid="PSA 6:4">माखे बचा कऊँकि तूँ पूरे दिलो ते मांते प्यार करेआ।<verse eid="PSA 6:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 6:5" />जे आऊँ मरी जाऊँगा तो तेबे आऊँ ताखे याद पनि करी सकदा।</para>
  <para style="q" vid="PSA 6:5">कोई पनि तिना रिया कब्रा गे तेरा तन्यवाद करी सकदा!<verse eid="PSA 6:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 6:6" />आऊँ रोंदे-रोंदे थकी गा,</para>
  <para style="q" vid="PSA 6:6">आऊँ आपणा मांजा आसूआ साथे सेड़ुआं;</para>
  <para style="q" vid="PSA 6:6">हर राती मेरा बछौणा आसूआ साथे सिजी जाओआ।<verse eid="PSA 6:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 6:7" />मेरिया आखी दु:खो साथे बैठी गी रिया</para>
  <para style="q" vid="PSA 6:7">ओर मेरे सताणे वाल़ेया रिया बजा ते सेयो तुँदल़िया पड़ी गी रिया।<verse eid="PSA 6:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 6:8" />ओ सब अनर्थ करने वाल़ेयो! मांते दूर रओ,</para>
  <para style="q" vid="PSA 6:8">कऊँकि प्रभुए मेरे रोणे री आवाज सुणी ली री।<note caller="+" style="f"><char style="fr" closed="false">6:8 </char><char style="ft" closed="false">मत्ती 7:23, लूक. 13:27</char></note><verse eid="PSA 6:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 6:9" />प्रभुए मेरा गिड़गिड़ाणा सुणी राखेया;</para>
  <para style="q" vid="PSA 6:9">तेस मेरी प्रार्थना ग्रहण बी करनी।<verse eid="PSA 6:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 6:10" />मेरे सारे दुश्मण शर्मिंदा ऊणे ओर बऊत कबराणे;</para>
  <para style="q" vid="PSA 6:10">ओर सेयो अचाणक पुरिया तरआ ते बेज्जत ऊई की नठी जाणे।<verse eid="PSA 6:10" /></para>
  <chapter eid="PSA 6" />
  <chapter number="7" style="c" sid="PSA 7" />
  <para style="s">न्याय रिया तँईं प्रार्थना</para>
  <para style="d">दाऊदो रा शिग्गायोन नाओं रा पजन जो तिने बिन्यामीनी कूशो रिया गल्ला रिया बजा ते प्रभुए रे सामणे गाया</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 7:1" />ओ मेरे प्रभु परमेशर! मेरा परोसा तां पाँदे ए आँऊ तेरी शरणा रे आई रा,</para>
  <para style="q" vid="PSA 7:1">मेरा पीछा करने वाल़ेया ते माखे बचा ओर तिना ते माखे बचाई दे,<verse eid="PSA 7:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 7:2" />एड़ा नि ओ कि सेयो माखे शेरो जेड़े फाड़ी की टुकड़े-टुकड़े करी देओ</para>
  <para style="q" vid="PSA 7:2">ओर कोई माखे बचाणे वाल़ा नि ओ।<verse eid="PSA 7:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 7:3" />ओ मेरे प्रभु परमेशर! जे मैं कोई गल़त काम कित्तेया ओ,</para>
  <para style="q" vid="PSA 7:3">जे मेरे आथो ते कोई बुरा काम ऊईरा ओ,<verse eid="PSA 7:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 7:4" />जे मैं आपणे केसी दोस्तो ते तोखा कित्तेया ओ;</para>
  <para style="q" vid="PSA 7:4">जे मैं बिना बजा ते आपणे दुश्मणा पाँदे बी जुल्म कित्तेया ओ;</para>
  <para style="q" vid="PSA 7:4">जे मैं इना बिचा ते एक बी गल़ती कित्ती ओ,<verse eid="PSA 7:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 7:5" />तो मेरे दुश्मण मेरे प्राणो रा पीछा करी की माखे आई की पकड़ो,</para>
  <para style="q" vid="PSA 7:5">बल्कि सेयो मेरी बेज्जती करी की माखे काई देयो, ओर माखे जमीना दे मरेया दा समजी की सेटी देयो। सेला<verse eid="PSA 7:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 7:6" />ओ प्रभु, गुस्से रे उठ; गुस्से ते परे मेरे सताणे वाल़ेया रे खलाफ तूँ खड़ा ऊई जा;</para>
  <para style="q" vid="PSA 7:6">ओ परमेशर, मेरी खातर जाग! तैं न्याय री आज्ञा तो देईती री।<verse eid="PSA 7:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 7:7" />तूँ देशो-देशो रे लोका रे चूण्डो खे आपणे चऊँ कनारिये कट्ठे कर;</para>
  <para style="q" vid="PSA 7:7">ओर तूँ स्वर्गो ते तिना पाँदे राज कर।<verse eid="PSA 7:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 7:8" />प्रभु जातिया-जातिया रे लोका रा न्याय करोआ;</para>
  <para style="q" vid="PSA 7:8">प्रभु मेरी तार्मिकता ओर खराईया रे मुताबिक मेरा न्याय कर; कऊँकि आँऊ निर्दोष ए।<verse eid="PSA 7:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 7:9" />तूँ एक तर्मी परमेशर ए ओर म्हारे विचार ओर इच्छा रा न्याय करेया।</para>
  <para style="q" vid="PSA 7:9">दुष्टा रिया दुष्टता खे रोक ओर तर्मिये खे ईनाम दे।<verse eid="PSA 7:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 7:10" />परमेशर मेरी रक्षा ईंयाँ करोआ जिंयाँ एक ढाल सिपाईए री रक्षा करोई,</para>
  <para style="q" vid="PSA 7:10">से तिना सबी लोका खे बचाओआ जो तर्मी ए।<verse eid="PSA 7:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 7:11" />परमेशर तर्मी ओर न्याय करने वाल़ा ए</para>
  <para style="q" vid="PSA 7:11">से बुरेया माणूंआ खे हर रोज सजा देओआ।<verse eid="PSA 7:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 7:12" />जे माणूं आपणे बुरे कामा ते मन नि फिराओ तो तेस आपणी तलवारी पाँदे सान चढ़ाणी</para>
  <para style="q" vid="PSA 7:12">ओर युद्ध करने रिया तँईं आपणा धनुष त्यार करना।<note caller="+" style="f"><char style="fr" closed="false">7:12 </char><char style="ft" closed="false">लूक 13:3-5</char></note><verse eid="PSA 7:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 7:13" />ओर तेस माणूंए खे तिने मौता रे अथियार त्यार करी लये रे,</para>
  <para style="q" vid="PSA 7:13">से आपणे तीरा खे आगी रे बाण बणाओआ।<verse eid="PSA 7:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 7:14" />देख, दुष्टो खे अनर्थ कामो रिया पीड़ा ऊणे लगी रिया,</para>
  <para style="q" vid="PSA 7:14">तेसरे बुरे कामा रा गर्भ ए ओर तेसते चूठ पैदा ऊआ,<verse eid="PSA 7:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 7:15" />तिने गड्डा खणी की से ओर डूगा कित्तेया</para>
  <para style="q" vid="PSA 7:15">ओर से आपू ई तेते गड्डे रे रूड़ी गा जो तिने खणेया था।<verse eid="PSA 7:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 7:16" />तिना आपू तेसा परेशानिया रा अनुभव करना जो सेयो दूजेया खे पैदा करना चाओए;</para>
  <para style="q" vid="PSA 7:16">सेयो जो दूजेया खे लड़ाई चगड़ेया रिया चीजा करना चाओए, सेयो आपू ई तिने की काईल ऊणे।<verse eid="PSA 7:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 7:17" />आऊँ यहोवे री तारीफ करूँआ कऊँकि से हमेशा ठीक काम करोआ;</para>
  <para style="q" vid="PSA 7:17">मां यहोवे री तारीफ करने खे गीत गाणा, जो केसी बी दूजेया देवतेया रे मुकाबले परमपरदान ए।<verse eid="PSA 7:17" /></para>
  <chapter eid="PSA 7" />
  <chapter number="8" style="c" sid="PSA 8" />
  <para style="s">परमेशरो री महिमा ओर माणूंआ री इज्जत</para>
  <para style="d">बजाणे वाल़े परदानो रिया तँईं : गित्तितो रे रागो पाँदे राजा दाऊदो रा पजन</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 8:1" />ओ यहोवा म्हारे प्रभु! सारिया दुनिया रे लोका खे पता ए!</para>
  <para style="q" vid="PSA 8:1">जो लोक तेरी महिमा करोए से स्वर्गो तक पऊँचोई।<verse eid="PSA 8:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 8:2" />तैं आपणे बैरिया री बजा ते बच्चे ओर दूद पींदे बच्चेया रे जरिए आपणी महिमा कराई ए,</para>
  <para style="q" vid="PSA 8:2">ताकि तूँ दुश्मण ओर बदला लणे वाल़ेया खे रोकी की राखे।<note caller="+" style="f"><char style="fr" closed="false">8:2 </char><char style="ft" closed="false">मत्ती 21:16</char></note><verse eid="PSA 8:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 8:3" />जेबे आऊँ सर्गो खे, जो तेरे आथो रा काम ए</para>
  <para style="q" vid="PSA 8:3">ओर चाँद ओर तारे, जो तैं ठराई राखे, देखूँआ;<verse eid="PSA 8:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 8:4" />तो तेबे माणूं क्या ए कि तूँ तेसखे याद राखे</para>
  <para style="q" vid="PSA 8:4">ओर आदमी क्या ए कि तूँ तेसरा त्यान राखे?<verse eid="PSA 8:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 8:5" />परमेशरे आसे माणूं आपू ते थोड़े ई कम बणाई राखे</para>
  <para style="q" vid="PSA 8:5">ओर तैं आसा खे महिमा ओर इज्जती रा मुकट पन्याई राखेया।<verse eid="PSA 8:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 8:6" />तैं आसा खे आपणे जरिये बणाई रिया सारिया चीजा पाँदे राज करने खे अनुमति देई राखी। ओर तैं आपणी सारी सृष्टि म्हारे अक्को दे करी ती री।<note caller="+" style="f"><char style="fr" closed="false">8:6 </char><char style="ft" closed="false">1 कुरिन्थ 15:27, इफिसि 1:22, इब्रानी 2:6-8, प्रेरित 17:31</char></note><verse eid="PSA 8:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 8:7" />सब पेडा-बाकरिया, गाय-बल़द</para>
  <para style="q" vid="PSA 8:7">ओर जितणे बणो रे डांगर ए,<verse eid="PSA 8:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 8:8" />सर्गो रे पंछी ओर समुद्रो रिया मछलिया</para>
  <para style="q" vid="PSA 8:8">ओर जितणे जीव-जंतु समुद्रो रे चलो-फिरोए।<verse eid="PSA 8:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 8:9" />ओ परमेशर! ओ म्हारे प्रभु!</para>
  <para style="q" vid="PSA 8:9">तेरा नाओं सारी तरतिया पाँदे बऊत ई महान् ए।<verse eid="PSA 8:9" /></para>
  <chapter eid="PSA 8" />
  <chapter number="9" style="c" sid="PSA 9" />
  <para style="s">परमेशरो रे न्याय रिया तँईं तन्यवादो रा पजन</para>
  <para style="d">बजाणे वाल़े परदानो रिया तँईं मुतलबैयन रागो पाँदे दाऊदो रा पजन</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 9:1" />ओ प्रभु परमेशर, मां आपणे पूरे मनो ते तेरा तन्यवाद करना;</para>
  <para style="q" vid="PSA 9:1">मां तेरे सारे अचम्बे रे कामो रा बखाण करना।<verse eid="PSA 9:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 9:2" />मां तेरी बजा ते खुश ऊणा,</para>
  <para style="q" vid="PSA 9:2">ओ परमपरदान परमेशर, मां तेरे नाओं रा पजन गाणा।<verse eid="PSA 9:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 9:3" />जेबे मेरे दुश्मणा खे एहसास ऊणा कि तूँ बऊत तागतबर ए,</para>
  <para style="q" vid="PSA 9:3">सेयो ठोकर खाओए,</para>
  <para style="q" vid="PSA 9:3">ओर सेयो फेर मरी जाओए।<verse eid="PSA 9:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 9:4" />तैं मेरे मकद्दमे रा न्याय करी की फैंसला मेरे अक्को रे दित्तेया;</para>
  <para style="q" vid="PSA 9:4">तैं सिंहासनो पाँदे बैठी की सच्चाईया साथे न्याय कित्तेया।<verse eid="PSA 9:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 9:5" />तैं दूजिया जातिया रे<note caller="+" style="f"><char style="fr" closed="false">9:5 </char><char style="ft" closed="false">जो परमेशरो खे नि जाणदे </char></note> लोक थिड़के ओर दुष्ट नाश कित्ते;</para>
  <para style="q" vid="PSA 9:5">तैं तिना रा नाओं सदा खेई मिटाईता रा।<verse eid="PSA 9:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 9:6" />तैं दुश्मणा रे शईर जड़ी तेई पटी ते</para>
  <para style="q" vid="PSA 9:6">ओर जो सारे शईर तैं टाल़ी ते,</para>
  <para style="q" vid="PSA 9:6">तिना रा नाओं-नशाण ई मिटी गा रा।<verse eid="PSA 9:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 9:7" />पर प्रभु जुगो-जुगो तक सिंहासनो पाँदे विराजमान ए,</para>
  <para style="q" vid="PSA 9:7">तिने आपणा सिंहासन न्याय री खातर ठराई राखेया।<verse eid="PSA 9:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 9:8" />ओर तेस आपू ई दुनिया रा न्याय तार्मिकता साथे करना,</para>
  <para style="q" vid="PSA 9:8">तेस लोका रा मुकद्दमा न्याय साथे नपटेणा।<note caller="+" style="f"><char style="fr" closed="false">9:8 </char><char style="ft" closed="false">पजन 96:13, प्रेरित 17:31</char></note><verse eid="PSA 9:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 9:9" />यहोवा तिना लोका रिया तँईं शरण लणे री जगा ऊणा जो दीन ए;</para>
  <para style="q" vid="PSA 9:9">आ, जेबे तिना खे परेशानी ऊणी तो से तिना खे लूकणे री जगा जेड़ा ऊणा।<verse eid="PSA 9:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 9:10" />प्रभु, जो ताखे जाणोए; सेयो तां पाँदे परोसा करी सकोए;</para>
  <para style="q" vid="PSA 9:10">जो तांगे आओए, तिना खे तूँ कदी नि छाडदा।<verse eid="PSA 9:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 9:11" />सिय्योन पाह्ड़ो ते राज करने वाल़े प्रभुए रा पजन गाओ!</para>
  <para style="q" vid="PSA 9:11">जातिया-जातिया रे लोका बीचे तेसरे महान कामो रा प्रचार करो!<verse eid="PSA 9:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 9:12" />प्रभु अत्या करने वाल़े खे सजा देणा नि पुलदा,</para>
  <para style="q" vid="PSA 9:12">जो गरीब तांगे दुहाई देओए,</para>
  <para style="q" vid="PSA 9:12">तिना री तूँ सुणेया।<verse eid="PSA 9:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 9:13" />ओ प्रभु परमेशर! मां पाँदे दया कर।</para>
  <para style="q" vid="PSA 9:13">देख, मेरे बैरी मां पाँदे अत्याचार करने लगी रे,</para>
  <para style="q" vid="PSA 9:13">तूँ ई माखे मरने ते बचाई सकेया।<verse eid="PSA 9:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 9:14" />ताकि आऊँ यरूशलेमो रे लोका गे जाई कि तिना सबी गल्ला रा वर्णन करुँ जेतेरिया तँईं आऊँ तेरी स्तुति करूँआ।</para>
  <para style="q" vid="PSA 9:14">आऊँ तेती खुश रणा कऊँकि तैं आऊँ बचाई राखेया।<verse eid="PSA 9:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 9:15" />दूजी जातिया वाल़ेया जो गड्डा खणेया था, तिदे सेयो आपू ई पड़ी गे,</para>
  <para style="q" vid="PSA 9:15">जो जाल़ तिने लगाया था, तिदे तिना रा ई पैर फसी गा।<verse eid="PSA 9:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 9:16" />परमेशर यहोवा सई न्याय करी की आपणे आपू खे प्रकट कित्तेया,</para>
  <para style="q" vid="PSA 9:16">दुष्ट लोक आपणे ई कित्ते रे कामो रे जाल़ो रे फसी गे। हिग्गायोन, सेला<verse eid="PSA 9:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 9:17" />मौत तिना सबी दुष्ट लोका रा भाग्य ए,</para>
  <para style="q" vid="PSA 9:17">जो परमेशरो खे ठुकराई देओए।<verse eid="PSA 9:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 9:18" />पर गरीब लोक अनन्तकालो तक बिसरे नि रणे</para>
  <para style="q" vid="PSA 9:18">ओर ना ई नम्र लोका री उम्मीद सदा खे नाश ऊणी।<verse eid="PSA 9:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 9:19" />ओ यहोवा, उठ! ओर देशो रे दुष्ट माणूंआ रा न्याय कर;</para>
  <para style="q" vid="PSA 9:19">तिना खे ए सोचणे री आज्ञा नि दे कि सेयो मजबूत ए,</para>
  <para style="q" vid="PSA 9:19">तिना खे कदी बी सजा नि मिलणी।<verse eid="PSA 9:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 9:20" />ओ परमेशर, तिना खे डरा!</para>
  <para style="q" vid="PSA 9:20">ताकि सेयो सब लोक जाणी लओ कि सेयो सिर्फ नाश ऊणे वाल़े माणूं ए।<verse eid="PSA 9:20" /></para>
  <chapter eid="PSA 9" />
  <chapter number="10" style="c" sid="PSA 10" />
  <para style="s">न्याय रिया तँईं प्रार्थना</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 10:1" />ओ प्रभु, कऊँ तूँ दूर खड़ेया रा रएया?</para>
  <para style="q" vid="PSA 10:1">मुसीबता रे बखते लूकेया रा कऊँ रएया?<verse eid="PSA 10:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 10:2" />दुष्टा रे कमण्डो रिया बजा तेई माणूं खदेड़े जाओए;</para>
  <para style="q" vid="PSA 10:2">सेयो आपणी ई निकयाल़िया रिया योजना रे फसी जाओए।<verse eid="PSA 10:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 10:3" />कऊँकि दुष्ट माणूं आपणी इच्छा पाँदे कमण्ड करोआ</para>
  <para style="q" vid="PSA 10:3">ओर लाल़ची माणूं प्रभुए खे छाडी देओआ ओर तेसखे स्राप देओए।<verse eid="PSA 10:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 10:4" />दुष्ट माणूं परमेशरो री कोई परवा नि करदे;</para>
  <para style="q" vid="PSA 10:4">आपणे कमण्डो रिया बजा ते सेयो सोचोए कि परमेशर नि आ।<verse eid="PSA 10:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 10:5" />एड़ा लगोआ कि सेयो हमेशा सफल ओए, ओर सेयो नि सोचदे कि तिना खे तिना रे ई कामो री सजा मिलणी, ओर सेयो आपणे दुश्मणा रा मजाक उड़ांदे रओए।<verse eid="PSA 10:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 10:6" />से आपणे मनो रे बोलोआ, “आऊँ कदी असफल नि ऊई सकदा;</para>
  <para style="q" vid="PSA 10:6">आऊँ कदी बी मुसीबता रे नि पड़ना।”<verse eid="PSA 10:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 10:7" />तेसरे मुंए रे बोल स्राप, छल ओर तमकिया साथे परे ए,</para>
  <para style="q" vid="PSA 10:7">तिना रे मुंए ते सिर्फ अनर्थ ओर उत्पातो रिया गल्ला निकल़ोईया।<note caller="+" style="f"><char style="fr" closed="false">10:7 </char><char style="ft" closed="false">रोमी 3:14</char></note><verse eid="PSA 10:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 10:8" />से निर्दोष लोका री अत्या करने रिया तँईं आपू खे गाँवो दे लकोई राखोआ,</para>
  <para style="q" vid="PSA 10:8">सेयो लाचार लोका री अत्या करने रा मौका टोल़दे रओए।<verse eid="PSA 10:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 10:9" />से शेरो जेड़ा जाड़ो बीचे लूकी की घात लगाई की ताका रे बैठेया रा रओआ,</para>
  <para style="q" vid="PSA 10:9">से दु:खी माणूंए खे पकड़ने री ताका रे रओआ।</para>
  <para style="q" vid="PSA 10:9">से दु:खी माणूंए खे आपणे जाल़ो रे फसाई की कसिटी की ल्याओआ ओर तेबे तेसखे दबोची लओआ।<verse eid="PSA 10:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 10:10" />लाचार माणूं चूकी जाओआ ओर से कट्ठा ऊई की बैठोआ</para>
  <para style="q" vid="PSA 10:10">ओर से तेसरे जाल़ो रे फसी जाओए।<verse eid="PSA 10:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 10:11" />दुष्ट माणूं आपणे मनो रे बोलोआ, “परमेशर मेरी परवा नि करदा,</para>
  <para style="q" vid="PSA 10:11">तिने आपणियां आखी बन्द करिती रिया ओर तेस आँऊ कदी नि देखणा।”<verse eid="PSA 10:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 10:12" />ओ परमेशर, उठ! तिना दुष्टा खे सजा दे</para>
  <para style="q" vid="PSA 10:12">ओर जो सीदे ए, तिना खे याद राख।<verse eid="PSA 10:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 10:13" />दुष्ट माणूं परमेशरो खे तुच्छ कऊँ जाणोआ</para>
  <para style="q" vid="PSA 10:13">ओर आपणे मनो रे बोलोआ, “तेस माखे सजा नि देणी?”<verse eid="PSA 10:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 10:14" />पर तूँ तिना परेशानिया ओर संकटो खे देखेया जो तिना रे जरिए ओए।</para>
  <para style="q" vid="PSA 10:14">जो लाचार लोक दु:खी ए,</para>
  <para style="q" vid="PSA 10:14">सेयो उम्मीद करोए कि तुसा तिना री मताद करनी;</para>
  <para style="q" vid="PSA 10:14">ओर तुसे अनाथा री मताद बी करोए।<verse eid="PSA 10:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 10:15" />दुष्ट ओर बुरे माणूंआ री तागत खत्म कर,</para>
  <para style="q" vid="PSA 10:15">जो दुष्ट काम तिने कित्ते, तिजी खे तिना खे तदुए तक सजा देंदा रओ</para>
  <para style="q" vid="PSA 10:15">जदुए तक सेयो एड़े कामा खे करना बंद नि करी देओ।<verse eid="PSA 10:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 10:16" />यहोवा, तूँ सदा खे म्हारा राजा ए,</para>
  <para style="q" vid="PSA 10:16">पर दुष्ट जातिया रे लोक तरतिया पाँदा ते नाश ऊई जाणे।<note caller="+" style="f"><char style="fr" closed="false">10:16 </char><char style="ft" closed="false">रोमी 11:26,27</char></note><verse eid="PSA 10:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 10:17" />ओ प्रभु, तूँ सीदे लोका री प्रार्थना खे सुणेया</para>
  <para style="q" vid="PSA 10:17">ओर तिना खे ईम्मत देंदा रएया।<verse eid="PSA 10:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 10:18" />तूँ अनाथ ओर दु:खी माणूंआ री रक्षा करेया</para>
  <para style="q" vid="PSA 10:18">ताकि माणूं फेर कदी बी दूजेया खे डराई नि सको।<verse eid="PSA 10:18" /></para>
  <chapter eid="PSA 10" />
  <chapter number="11" style="c" sid="PSA 11" />
  <para style="s">परमेशरो पाँदे परोसा</para>
  <para style="d">बजाणे वाल़े परदानो रिया तँईं दाऊदो रा पजन</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 11:1" />मेरी शरण परमेशर ए।</para>
  <para style="q" vid="PSA 11:1">तेबे मां साथे मत बोल कि माखे पंछिये जेड़े पाह्ड़ो पाँदे उडणे री जरूरत ए।<verse eid="PSA 11:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 11:2" />कऊँकि देखो, दुष्ट आपणा धनुष चढ़ाओए</para>
  <para style="q" vid="PSA 11:2">ओर आपणा तीर धनुषो री डोरिया पाँदे राखोए</para>
  <para style="q" vid="PSA 11:2">ताकि सीदे मनो वाल़ेया माणूंआ पाँदे न्हेरे तीर चलाओ;<verse eid="PSA 11:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 11:3" />जेबे लोका खे नियम न मानणे रिया बजा ते सजा नि मिलदी;</para>
  <para style="q" vid="PSA 11:3">तो तिदे तर्मी लोक क्या करी सकोए?<verse eid="PSA 11:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 11:4" />प्रभु आपणे पवित्र मईलो रे ए; प्रभुए रा सिंहासन स्वर्गो दे ए,</para>
  <para style="q" vid="PSA 11:4">तेसरिया आखी माणूंए रिया ल्वादा खे सदा देखदिया रओईया</para>
  <para style="q" vid="PSA 11:4">ओर तेसरिया पलका तिना खे परखो इया।<verse eid="PSA 11:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 11:5" />प्रभु तार्मिक ओर दुष्ट माणूंए खे परखोआ,</para>
  <para style="q" vid="PSA 11:5">तेसरी आत्मा लड़ाई-चगड़े ते प्यार राखणे वाल़ेया लोका ते कृणा करोई।<verse eid="PSA 11:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 11:6" />तेस दुष्टा पाँदे आग ओर गन्धक बरसाणी</para>
  <para style="q" vid="PSA 11:6">ओर चुल़सणे वाल़ी प्रचण्ड गर्मिया री लूआ ते तिना खे सजा देणी।<verse eid="PSA 11:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 11:7" />कऊँकि प्रभु तर्मी ए,</para>
  <para style="q" vid="PSA 11:7">से तार्मिकता रेई कामा ते खुश रओआ;</para>
  <para style="q" vid="PSA 11:7">तर्मी माणूंए तेसरा दर्शण पाणा।<verse eid="PSA 11:7" /></para>
  <chapter eid="PSA 11" />
  <chapter number="12" style="c" sid="PSA 12" />
  <para style="s">मतादा रिया तँईं प्रार्थना</para>
  <para style="d">परदान बजाणे रिया तँईं खर्जो रे रागो रे दाऊदो रा पजन</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 12:1" />ओ प्रभु, म्हारी मताद करो, कऊँकि एक बी पग्त नि रया;</para>
  <para style="q" vid="PSA 12:1">माणूंआ बीचा ते परोसे जोगे लोक लोप ऊईगे रे।<verse eid="PSA 12:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 12:2" />हर एक माणूं आपणे पड़ोसिया ते चूठिया गल्ला बोलोआ,</para>
  <para style="q" vid="PSA 12:2">सेयो चलाकिया रे ओठा ते दोगलिया गल्ला बोलोए।<verse eid="PSA 12:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 12:3" />प्रभुए सबी रे चलाक ओठ</para>
  <para style="q" vid="PSA 12:3">ओर से जीब जेसा ते बड़ा बोल निकल़ोआ, बाडी देणे।<verse eid="PSA 12:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 12:4" />सेयो बोलोए, “चूठ बोली कि आसा खे सेई मिलणा जो आसे चाऊँए;</para>
  <para style="q" vid="PSA 12:4">आसे आपू ये सोचूँए कि आसा क्या करना चाईयो,</para>
  <para style="q" vid="PSA 12:4">इजी री खातर कोई बी आसा खे ये नि बोली सकदा</para>
  <para style="q" vid="PSA 12:4">आसा खे क्या नि करना चाईयो!”<verse eid="PSA 12:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 12:5" />पर यहोवा ईंयाँ बोलोआ, “मैं सेयो चगड़े वाल़िया चीजा देखिया जो तिने बेसहारा लोका साथे करी राखिया;</para>
  <para style="q" vid="PSA 12:5">ओर मैं सेयो लोक कणदे ऊए सुणी राखे,</para>
  <para style="q" vid="PSA 12:5">इजी री खातर मां उठणा ओर सेयो लोक बचाणे</para>
  <para style="q" vid="PSA 12:5">जो चाओए कि आऊँ तिना री मताद करुँ।”<verse eid="PSA 12:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 12:6" />प्रभुए रा वायदा परोसे जोगा ए,</para>
  <para style="q" vid="PSA 12:6">तेस चाँदिए जेड़ा, जो पट्ठिया रे माट्टिया पाँदे गल़ाई की</para>
  <para style="q" vid="PSA 12:6">सात बार साफ करी राखेया ओ।<verse eid="PSA 12:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 12:7" />ओ प्रभु, तां ई सेयो बचाणे,</para>
  <para style="q" vid="PSA 12:7">तिना खे एड़ेया दुष्ट लोका ते सदा बचाई की राख।<verse eid="PSA 12:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 12:8" />जेबे माणूंआ बीचे बुराईया रा आदर ओआ,</para>
  <para style="q" vid="PSA 12:8">तेबे दुष्ट लोक चऊँ कनारे अकड़ोए।<verse eid="PSA 12:8" /></para>
  <chapter eid="PSA 12" />
  <chapter number="13" style="c" sid="PSA 13" />
  <para style="s">मुसीबता रे मतादा रिया तँईं प्रार्थना</para>
  <para style="d">बजाणे वाल़े रे परदानो रिया तँईं दाऊदो रा पजन</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 13:1" />ओ यहोवा, तां कदुओ तक, आँऊ पुलाई की राखणा?</para>
  <para style="q" vid="PSA 13:1">तां कदुओ तक आपणा मूँ मांते लकोणा?<verse eid="PSA 13:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 13:2" />मां कदुओ तक मुसीबत चालदे रणा?</para>
  <para style="q" vid="PSA 13:2">कदुए तक मां दिन-रात दु:खो दे पड़े रे रणा?</para>
  <para style="q" vid="PSA 13:2">कदुओ तक मेरा दुश्मण मां पाँदे प्रबल ऊँदा रणा?<verse eid="PSA 13:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 13:3" />ओ मेरे परमेशर यहोवा मां कनारो खे देखो, ओर माखे ज्वाब देओ।</para>
  <para style="q" vid="PSA 13:3">माखे फेर मजबूत बणने दे मताद कर, ओर माखे मरने री आज्ञा नि दे।<verse eid="PSA 13:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 13:4" />एड़ा नि ओ कि मेरा दुश्मण बोलो कि आऊँ तेस पाँदे प्रबल ऊईगा</para>
  <para style="q" vid="PSA 13:4">ओर एड़ा नि ओ कि जेबे आऊँ लड़खड़ाणे लगूँ, तेबे मेरे दुश्मण खुश ऊई जाओ।<verse eid="PSA 13:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 13:5" />पर आऊँ तो परोसा करूँआ कि तूँ वफादारिया ते मांते प्रेम करदा रणा,</para>
  <para style="q" vid="PSA 13:5">जेबे आऊँ बचाणा तेबे आऊँ खुश ऊणा।<verse eid="PSA 13:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 13:6" />ओ यहोवा, तैं मेरिया तँईं कई पले काम करी राखे,</para>
  <para style="q" vid="PSA 13:6">इजी री खातर मां तेरिया तँईं स्तुति पजन गाणा।<verse eid="PSA 13:6" /></para>
  <chapter eid="PSA 13" />
  <chapter number="14" style="c" sid="PSA 14" />
  <para style="s">माणूंआ री मूर्खता ओर दुष्टता</para>
  <para style="d">बजाणे वाल़े रे परदानो रिया तँईं दाऊदो रा पजन</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 14:1" />मूर्खे आपणे मनो रे बोलेया, “कोई परमेशर अया ई नि,”</para>
  <para style="q" vid="PSA 14:1">सेयो बिगड़ी गे, तिने बुरे काम कित्ते,</para>
  <para style="q" vid="PSA 14:1">एड़ा कोई पनिए जो पलाईया रा काम करो।<verse eid="PSA 14:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 14:2" />यहोवे स्वर्गो ते माणूंआ खे देखेया</para>
  <para style="q" vid="PSA 14:2">कि देखूँआ कि कोई समजदार,</para>
  <para style="q" vid="PSA 14:2">परमेशरो री आराधना करने वाल़ा अए कि नई।<verse eid="PSA 14:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 14:3" />सेयो सारे के सारे पटकी गे, सब प्रष्ट ऊईगे,</para>
  <para style="q" vid="PSA 14:3">एड़ा कोई पनिए जो पलाईया रा काम करो।<note caller="+" style="f"><char style="fr" closed="false">14:3 </char><char style="ft" closed="false">रोमी 3:10,11</char></note><verse eid="PSA 14:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 14:4" />क्या सेयो बुरे लोक कदी नि सीखणे कि परमेशर तिना खे सजा देणे रिया तँईं क्या करी सकोआ?</para>
  <para style="q" vid="PSA 14:4">सेयो यहोवे रे लोका रे खलाफ चगड़े रा काम करोए,</para>
  <para style="q" vid="PSA 14:4">जबकि से जो खाणा देओआ तेस खाओए,</para>
  <para style="q" vid="PSA 14:4">ओर कदी बी यहोवे ते प्रार्थना नि करदे।<verse eid="PSA 14:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 14:5" />पर एक दिन एड़ा आऊणा कि सेयो बऊत डरने,</para>
  <para style="q" vid="PSA 14:5">कऊँकि परमेशर आज्ञा मानणे वाल़े तर्मी लोका बीचे हमेशा रओआ।<verse eid="PSA 14:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 14:6" />बुरा काम करने वाल़े हमेशा ईमानदार लोका रे खलाफ बुरी योजना बणओए,</para>
  <para style="q" vid="PSA 14:6">पर यहोवा आपणे लोका री रक्षा आपू करोआ।<verse eid="PSA 14:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 14:7" />मेरी इच्छा ए कि यहोवा यरूशलेमो ते आऊणा आसा इस्राएली लोका खे बचाणे!</para>
  <para style="q" vid="PSA 14:7">ओ यहोवा, जेबे तुसे आपणे लोका खे फेर आशीर्वाद देओए,</para>
  <para style="q" vid="PSA 14:7">तो आसे सारे इस्राएली लोक,</para>
  <para style="q" vid="PSA 14:7">जो याकूबो रे कुलो रे, खुश ऊणे।<note caller="+" style="f"><char style="fr" closed="false">14:7 </char><char style="ft" closed="false">पजन 53:6; लूक 1:69</char></note><verse eid="PSA 14:7" /></para>
  <chapter eid="PSA 14" />
  <chapter number="15" style="c" sid="PSA 15" />
  <para style="s">सिय्योनो रे रणे वाल़े</para>
  <para style="d">दाऊदो रा पजन</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 15:1" />ओ प्रभु! तेरे तम्बूए रे कुण ठईरी सकोआ?</para>
  <para style="q" vid="PSA 15:1">तेरे पवित्र पाह्ड़ो पाँदे कुण बसी सकोआ?<note caller="+" style="f"><char style="fr" closed="false">15:1 </char><char style="ft" closed="false">15:4-5; 61:4; 2 शमूएल 6:12; 16-17</char></note><verse eid="PSA 15:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 15:2" />सेयो माणूं जो सबी गल्ला दे परमेशरो री आज्ञा रा पाल़न करोए ओर हमेशा तर्मो रा काम करोए,</para>
  <para style="q" vid="PSA 15:2">ओर दिलो ते सच्च बोलोए;<verse eid="PSA 15:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 15:3" />जो आपणी जीबा ते निंदा नि करदा</para>
  <para style="q" vid="PSA 15:3">ओर ना आपणे दोस्तो री बुराई करदा</para>
  <para style="q" vid="PSA 15:3">ओर ना आपणे पड़ोसिये री निंदा सुणदा;<verse eid="PSA 15:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 15:4" />जो यहोवे खे नि मानदे तिना खे सेयो तुच्छ जाणोए,</para>
  <para style="q" vid="PSA 15:4">पर यहोवे रे डरो दे रणे वाल़े लोका रा सेयो आदर करोए।</para>
  <para style="q" vid="PSA 15:4">से परमेशरो रे सामणे वादा करी की बदलदा नि; चाए तिजी री कोई बी कीमत कऊँ नि देणी पड़ो।<verse eid="PSA 15:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 15:5" />जो आपणा पैसा ब्याजो पाँदे नि देंदा</para>
  <para style="q" vid="PSA 15:5">ओर निर्दोष माणूंए रा नुकशाण करने खे रिश्वत नि लंदा।</para>
  <para style="q" vid="PSA 15:5">एड़ा काम करने वाल़ा माणूं सदा बणेया रा रओआ।<verse eid="PSA 15:5" /></para>
  <chapter eid="PSA 15" />
  <chapter number="16" style="c" sid="PSA 16" />
  <para style="s">परमेशर मेरा पाअग</para>
  <para style="d">दाऊदो रा मिक्ताम</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 16:1" />ओ परमेशर मेरी रक्षा कर,</para>
  <para style="q" vid="PSA 16:1">कऊँकि मेरा परोसा सिर्फ तां ई पाँदे ए।<verse eid="PSA 16:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 16:2" />मैं प्रभुए खे बोलेया, “तूँ ई मेरा प्रभु ए,</para>
  <para style="q" vid="PSA 16:2">मांगे जो कुछ अया से यो सारिया खरिया चीजा तांते ई मिली रिया ए।”<verse eid="PSA 16:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 16:3" />तरतिया पाँदे जो पवित्र लोक ए,</para>
  <para style="q" vid="PSA 16:3">सेयो ई आदरो जोगे ए</para>
  <para style="q" vid="PSA 16:3">ओर तिना तेई आऊँ खुश ए।<verse eid="PSA 16:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 16:4" />जो माणूं ओरी देवतेया रिया तरफा खे दौड़ोए, सेयो आपू पाँदे कई दु:ख लयाओए;</para>
  <para style="q" vid="PSA 16:4">मां तिना रे खूनो वाल़े अर्घो दे इस्सा नि लणा;</para>
  <para style="q" vid="PSA 16:4">मां तिना रे देवतेया री पग्ति नि करनी।<verse eid="PSA 16:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 16:5" />तूँ ई प्रभु, जो मैं चूणी राखेया, तेरे बगैर मेरी पलाई केथी नि ए।</para>
  <para style="q" vid="PSA 16:5">ओर तुसे माखे से सब देई राखेया जो जरूरी ए;</para>
  <para style="q" vid="PSA 16:5">मेरा भविष्य तेरे ई आथो दे ए।<verse eid="PSA 16:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 16:6" />यहोवे माखे एक नौखी जगा रणे खे देई राखी;</para>
  <para style="q" vid="PSA 16:6">तिने माखे जो कुछ देई राखेया,</para>
  <para style="q" vid="PSA 16:6">तिजी ते आऊँ खुश ए।<verse eid="PSA 16:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 16:7" />आऊँ प्रभुए खे तन्य बोलूँआ,</para>
  <para style="q" vid="PSA 16:7">कऊँकि तिने माखे सलाअ दित्ती;</para>
  <para style="q" vid="PSA 16:7">बल्कि मेरा मन बी राती माखे सिखाओआ।<verse eid="PSA 16:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 16:8" />आऊँ जाणूंआ कि यहोवा मां साथे ए।</para>
  <para style="q" vid="PSA 16:8">से मेरे नेड़े ई ए; इजी री खातर कुछ बी माखे चिन्ता करने री गल्ल नि ए।<verse eid="PSA 16:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 16:9" />इजी बजा ते आऊँ बऊत खुश ए;</para>
  <para style="q" vid="PSA 16:9">आऊँ सई-सलामत रई सकूँआ। मेरी आत्मा खुश ए।<verse eid="PSA 16:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 16:10" />आऊँ तेरे जरिये चुणेया दा माणूं ए।</para>
  <para style="q" vid="PSA 16:10">तां आऊँ कब्रा दे नि छाडणा या मेरा शरीर सड़ने नि देणा। तां मेरा प्राण अधलोको दे नि छाडणा ओर ना तां आपणा पग्त सड़ने देणा।<note caller="+" style="f"><char style="fr" closed="false">16:10 </char><char style="ft" closed="false">तेरा वफादार सेवक यीशु मसीह</char></note><verse eid="PSA 16:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 16:11" />तां माखे से बाट दखाणी;</para>
  <para style="q" vid="PSA 16:11">जो अनन्त जीवनो रिया तरफा खे जाओई;</para>
  <para style="q" vid="PSA 16:11">तेरी मौजुदगिया रे माखे आनंद ओर सदा री खुशी मिलोई।<note caller="+" style="f"><char style="fr" closed="false">16:11 </char><char style="ft" closed="false">प्रेरित 2:25-28</char></note><verse eid="PSA 16:11" /></para>
  <chapter eid="PSA 16" />
  <chapter number="17" style="c" sid="PSA 17" />
  <para style="s">अत्याचारिए ते बचणे रिया तँईं प्रार्थना</para>
  <para style="d">दाऊदो री प्रार्थना</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 17:1" />सुणो, ओ प्रभु, न्याय रिया तँईं मेरा जोरे की बोलणा;</para>
  <para style="q" vid="PSA 17:1">मताद करने खे मेरे रोणे पाँदे त्यान देयो!</para>
  <para style="q" vid="PSA 17:1">मेरी बिना कपटो री प्रार्थना सुणी लो।<verse eid="PSA 17:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 17:2" />सिर्फ तुसेई बोली सकोए कि आऊँ बेकसुर आ,</para>
  <para style="q" vid="PSA 17:2">कऊँकि सिर्फ तेरिया ई आखी न्याय खे देखी सकोईया।<verse eid="PSA 17:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 17:3" />तूँ जाणेया कि राती दे बी आऊँ क्या सोचूँआ; तैं परखी की जाणी ला रा कि आऊँ क्या बोलूँआ ओर क्या करूँआ, ओर तूँ जाणेया कि मैं कदी बी चूठ ना बोलणे री ठाणी ली री ए।<verse eid="PSA 17:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 17:4" />मैं ओरी जेड़े काम नि कित्ते;</para>
  <para style="q" vid="PSA 17:4">मैं हमेशा सेई कित्तेया जो सई ए,</para>
  <para style="q" vid="PSA 17:4">ओर मैं दूजेया माणूंआ साथे गल़त बर्ताव नि कित्तेया ए।<verse eid="PSA 17:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 17:5" />आऊँ हमेशा तेरिया ई बाटा दे चलदा आई रा,</para>
  <para style="q" vid="PSA 17:5">ओर कदी बी तिजी ते पटकी नि रया।<verse eid="PSA 17:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 17:6" />ओ परमेशर, मैं तांते प्रार्थना करी राखी, कऊँकि तां माखे उत्तर देणा।</para>
  <para style="q" vid="PSA 17:6">मेरिया तरफा खे त्यान देई की मेरी बिनती सुणी लओ।<verse eid="PSA 17:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 17:7" />तूँ माखे दस कि तूँ मांते ईमानदारिया ते प्यार करेया।</para>
  <para style="q" vid="PSA 17:7">आपणियां महान शक्तिया ते तिना लोका खे बचा</para>
  <para style="q" vid="PSA 17:7">जो आपणे दुश्मणा ते बचणे रिया तँईं तां पाँदे परोसा करोए।<verse eid="PSA 17:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 17:8" />आपणियां आखी रिया पुतलिया जेड़े माखे सई-सलामत राख;</para>
  <para style="q" vid="PSA 17:8">आपणे पंखा निठे माखे लकोई की राख।<verse eid="PSA 17:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 17:9" />तिना दुष्टा ते जो मां पाँदे अत्याचार करोए,</para>
  <para style="q" vid="PSA 17:9">मेरे प्राणा रे दुश्मणा ते जिने आऊँ केरी राखेया।<verse eid="PSA 17:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 17:10" />तिने आपणा दिल पात्थरो जेड़ा काठा करी राखेया;</para>
  <para style="q" vid="PSA 17:10">तिना रे मुंए ते कमण्डो रिया ई गल्ला निकल़ोईया।<verse eid="PSA 17:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 17:11" />तिने हर कदमो पाँदे आऊँ केरी राखेया;</para>
  <para style="q" vid="PSA 17:11">सेयो माखे जमीना दे पटकणे खे मेरिया ताका रे ए।<verse eid="PSA 17:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 17:12" />सेयो तेस शेरो जेड़े ए जो फाड़ने खे त्यार बैठी रे,</para>
  <para style="q" vid="PSA 17:12">ओर जवान शेरो जेड़ा ए जो लूकी की शकारो खे न्याल़ो आ।<verse eid="PSA 17:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 17:13" />प्रभु, उठ!</para>
  <para style="q" vid="PSA 17:13">तिना रा सामणा कर ओर तिना खे थाले पटकी दे!</para>
  <para style="q" vid="PSA 17:13">आपणियां तलवारी रे जरिए मेरे प्राणो खे दुष्टो ते बचा।<verse eid="PSA 17:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 17:14" />ओ यहोवा, आपणियां शक्तिया ते माखे तिना लोका ते बचा जो सिर्फ एते दुनिया रिया चीजा ते ई प्यार करोए।</para>
  <para style="q" vid="PSA 17:14">पर तूँ तिना लोका खे बऊत सारा खाणा देआ जिना ते तूँ बऊत प्यार करेया;</para>
  <para style="q" vid="PSA 17:14">तिना रे बच्चेया गे बी बऊत चीजा ऊणिया जिना रे अक्कदार तिना रे पोते ऊणे।<verse eid="PSA 17:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 17:15" />पर मां तो निर्दोष ऊई की तेरे मुंए रा दर्शण करना; कऊँकि आऊँ निर्दोष ए,</para>
  <para style="q" vid="PSA 17:15">जेबे मां जागणा तेबे मां प्रभुए रा दर्शण देखी की सन्तुष्ट ऊणा।<note caller="+" style="f"><char style="fr" closed="false">17:15 </char><char style="ft" closed="false">पजन 4:6; 7:1; 1 यूहन्ना 3:2</char></note><verse eid="PSA 17:15" /></para>
  <chapter eid="PSA 17" />
  <chapter number="18" style="c" sid="PSA 18" />
  <para style="s">राजा दाऊदो रा मुक्तिगान</para>
  <para style="d">बजाणे वाल़े रे परदानो रिया तँईं। प्रभुए रा दास दाऊदो रा पजन, जेतेरे वचन तिने प्रभुए रिया तँईं तेस बखते गाए जेबे प्रभुए से तेसरे सारे दुश्मणा रे आथो ते ओर शाऊलो रे आथो ते बचाया था, तेबे दाऊदे ये गीत गाया:</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 18:1" />ओ प्रभु, ओ मेरी तागत, आऊँ ताखे प्यार करूँआ।<verse eid="PSA 18:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 18:2" />प्रभु मेरी रक्षा करने वाल़ा ए; से माखे मजबूत किले जेड़ा ए।</para>
  <para style="q" vid="PSA 18:2">मेरा परमेशर मेरी सुरक्षा करोआ, ओर आऊँ तेस साथे सुरक्षित आ।</para>
  <para style="q" vid="PSA 18:2">से माखे ढाल बणी की बचाओआ;</para>
  <para style="q" vid="PSA 18:2">से माखे बचाओआ ओर माखे सुरक्षित राखोआ।<note caller="+" style="f"><char style="fr" closed="false">18:2 </char><char style="ft" closed="false">इब्रानी 2:13</char></note><verse eid="PSA 18:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 18:3" />मां प्रभुए खे जो स्तुतिया जोगा ए आका पाणिया;</para>
  <para style="q" vid="PSA 18:3">ओर ईंयाँ आऊँ मेरे दुश्मणा ते बचाया जाणा।<verse eid="PSA 18:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 18:4" />मेरे चऊँ कनारे बऊत बुरा हाल ए, जेतेते मेरी मौत बी ऊई सकोई;</para>
  <para style="q" vid="PSA 18:4">ओर ये स्थिति एड़ी थी जेड़े कि बऊत जादा पाणिए रिये बाढ़े आऊँ बाई की काईता ओ।<note caller="+" style="f"><char style="fr" closed="false">18:4 </char><char style="ft" closed="false">पजन 116:3</char></note><verse eid="PSA 18:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 18:5" />मौता रा खतरा मेरे नेड़े-तेड़े था,</para>
  <para style="q" vid="PSA 18:5">ओर कब्रे मेरिया तँईं आपणा जाल़ बछयाईता।<verse eid="PSA 18:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 18:6" />मुसीबता रे बखते मैं प्रभु परमेशरो खे आका पाईया;</para>
  <para style="q" vid="PSA 18:6">मैं आपणा परमेशर पुकारेया</para>
  <para style="q" vid="PSA 18:6">ओर तिने आपणे रणे रिया जगा ते मेरिया गल्ला सुणिया</para>
  <para style="q" vid="PSA 18:6">ओर तिने मेरिया पुकारा पाँदे त्यान दित्तेया।<verse eid="PSA 18:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 18:7" />तेबे तरती ईल्ली गी ओर थरथराई गी</para>
  <para style="q" vid="PSA 18:7">ओर पाह्ड़ा रिया निऊँआ थरथराई की ईलणे लगिया,</para>
  <para style="q" vid="PSA 18:7">कऊँकि प्रभु बऊत जादा गुस्से ऊईगा था।<verse eid="PSA 18:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 18:8" />तेसरे नाको ते तुआँ निकल़ेया</para>
  <para style="q" vid="PSA 18:8">ओर तेसरे मुंए ते पस्म करने वाल़ी आग निकल़ने लगी,</para>
  <para style="q" vid="PSA 18:8">जेते साथे कोईले सुलगणे लगे।<verse eid="PSA 18:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 18:9" />से सर्गो खे खोली की थाले उतरी की आया</para>
  <para style="q" vid="PSA 18:9">ओर तेसरे पैरा निठे काल़े बादल़ थे।<verse eid="PSA 18:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 18:10" />यहोवा पंखा वाल़े करूबा पाँदे सवार ऊई की आया,</para>
  <para style="q" vid="PSA 18:10">फेर अवा जेड़े उडी की आया।<verse eid="PSA 18:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 18:11" />तेसरे चऊँ कनारे न्हेरा था जेड़े की तिने कांबल़ टकी राखेया ओ,</para>
  <para style="q" vid="PSA 18:11">ओर से चऊँ कनारा ते काल़े बादल़ ओर पाणिए री ओसे की टकी राखेया था।<verse eid="PSA 18:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 18:12" />तेसरे चऊँ कनारे बिजल़ी कड़को थी,</para>
  <para style="q" vid="PSA 18:12">ओल़े ओर जल़दे ऊए कोईले सर्गो ते थाले छूटणे लगे।<verse eid="PSA 18:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 18:13" />प्रभु सर्गो रे गरजेया</para>
  <para style="q" vid="PSA 18:13">ओर परमपरदान परमेशरे आपणी वाणी सुणाई, ओल़े ओर फेऊ पड़ने लगे।<verse eid="PSA 18:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 18:14" />तिने आपणे तीर चलाई-चलाई की दुश्मण तित्तर-बित्तर करीते;</para>
  <para style="q" vid="PSA 18:14">बल्कि बिजल़ी चमकाई-चमकाई की सेयो अराईते।<verse eid="PSA 18:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 18:15" />ओ यहोवा, जेबे तैं एक बार थिड़केया</para>
  <para style="q" vid="PSA 18:15">ओर तेरिया नासा रे साओ रिया तागती ते डूगे समुद्रो री थाली</para>
  <para style="q" vid="PSA 18:15">ओर तरतिया री निऊँ दिखणे लगी गी!<verse eid="PSA 18:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 18:16" />प्रभुए ऊच्चिया जगा ते आपणा आथ बढ़ाई की आऊँ पकड़ी ला</para>
  <para style="q" vid="PSA 18:16">ओर डूगे पाणिए बीचा ते आँऊ ऊबे खींजी ला।<verse eid="PSA 18:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 18:17" />तिने मांते नफरत करने वाल़ेया, मेरे तागतबर दुश्मणा ते मेरी रक्षा कित्ती,</para>
  <para style="q" vid="PSA 18:17">कऊँकि आऊँ तिना खे नि अराई सकूँ था।<verse eid="PSA 18:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 18:18" />मेरी मुसीबता रे बखते तिने मां पाँदे अमला कित्तेया,</para>
  <para style="q" vid="PSA 18:18">पर प्रभु मेरा साअरा था।<verse eid="PSA 18:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 18:19" />तिने माखे सई जगा दे पऊँचणे दे मेरी मताद कित्ती,</para>
  <para style="q" vid="PSA 18:19">तिने आऊँ छुड़ाया, कऊँकि से मांते खुश था।<verse eid="PSA 18:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 18:20" />मेरे सई काम करने रिया बजा ते परमेशर यहोवा माखे ईनाम दित्तेया;</para>
  <para style="q" vid="PSA 18:20">ओर मेरे बेकसूर ऊणे रे बदले तिने माखे आशीर्वाद दित्तेया।<verse eid="PSA 18:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PSA 18:21" />आऊँ प्रभुए री बाटा रिये चलदा रया</para>
  <para style="q" vid="PSA 18:21">ओर दुष्टता री बजा ते आपणे परमेशरो ते दूर नि ऊआ।<verse eid="PSA 18:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="PSA 18:22" />मैं हमेशा तेरेया नियमा रा पालण करी राखेया,</para>
  <para style="q" vid="PSA 18:22">ओर तेरिया आज्ञा नि तोड़ी राखिया।<verse eid="PSA 18:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="PSA 18:23" />आऊँ तेस सामणे निर्दोष रया</para>
  <para style="q" vid="PSA 18:23">ओर अपराधो ते आपणे आपू खे बचांदा रया।<verse eid="PSA 18:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="PSA 18:24" />ओर इजी री खातर प्रभु माखे ईनाम देओआ कऊँकि आऊँ सई काम करूँआ,</para>
  <para style="q" vid="PSA 18:24">से माखे जाणोआ कि आऊँ बेकसूर ए।<verse eid="PSA 18:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="PSA 18:25" />दया करने वाल़े साथे तूँ आपू खे दयावंत</para>
  <para style="q" vid="PSA 18:25">ओर तर्मी मर्दो साथे तूँ आपू खे तर्मी दखाएया।<verse eid="PSA 18:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="PSA 18:26" />शुद्ध माणूंए साथे तूँ आपू खे शुद्ध दखाए आ,</para>
  <para style="q" vid="PSA 18:26">ओर टेडे साथे तूँ टेडा बणेया।<verse eid="PSA 18:26" /></para>
  <para style="q">
    <verse number="27" style="v" sid="PSA 18:27" />तूँ नम्र लोका खे बचाएआ,</para>
  <para style="q" vid="PSA 18:27">पर कमण्डी माणूंए खे तूँ बेज्जत करेया।<verse eid="PSA 18:27" /></para>
  <para style="q">
    <verse number="28" style="v" sid="PSA 18:28" />यहोवा तूँ मेरिया बाटा दे प्रयासा करेया ताकि आऊँ देखी सकूँ,</para>
  <para style="q" vid="PSA 18:28">पर जेबे तूँ प्रयासा बणाएया तेबे कोई न्हेरा नि रंदा।<verse eid="PSA 18:28" /></para>
  <para style="q">
    <verse number="29" style="v" sid="PSA 18:29" />कऊँकि परमेशर माखे मेरे दुश्मणा पाँदे अमला करने;</para>
  <para style="q" vid="PSA 18:29">ओर तिना रे शईरा पाँदे कब्जा करने री तागत देओआ।<verse eid="PSA 18:29" /></para>
  <para style="q">
    <verse number="30" style="v" sid="PSA 18:30" />सब कुछ जो यहोवा मेरा परमेशर करोआ से सई ए।</para>
  <para style="q" vid="PSA 18:30">आसे तेस पाँदे परोसा करी सकूँए कि जो से वादा करोआ तेस पूरा करोआ।</para>
  <para style="q" vid="PSA 18:30">से आपणे शरणा रे आऊणे वाल़ेया खे ढाला रे जेड़ा तिना री रक्षा करोआ।<verse eid="PSA 18:30" /></para>
  <para style="q">
    <verse number="31" style="v" sid="PSA 18:31" />ओ यहोवा, ताखे छाडी की ओर कोई बी परमेशर नि ए!</para>
  <para style="q" vid="PSA 18:31">म्हारी शरण लणे री बड़ी चट्टान तूँ ई ए।<verse eid="PSA 18:31" /></para>
  <para style="q">
    <verse number="32" style="v" sid="PSA 18:32" />ये सेई परमेशर ए जो सामर्था साथे माखे परा पूरा करोआ</para>
  <para style="q" vid="PSA 18:32">ओर मेरी बाटा खे सिद्ध करोआ।<verse eid="PSA 18:32" /></para>
  <para style="q">
    <verse number="33" style="v" sid="PSA 18:33" />सेई मेरे पैरा खे ईरणियां रे पैरा जेड़ी तेज चाल देओआ</para>
  <para style="q" vid="PSA 18:33">ओर माखे मेरी ऊच्चिया जगा रे खड़ा करोआ।<verse eid="PSA 18:33" /></para>
  <para style="q">
    <verse number="34" style="v" sid="PSA 18:34" />से माखे पीतल़ी रा धनुष चलाणा सिखाओआ,</para>
  <para style="q" vid="PSA 18:34">ताकि युद्धो रे बखते माखे धनुष चलाणा आई सको।<verse eid="PSA 18:34" /></para>
  <para style="q">
    <verse number="35" style="v" sid="PSA 18:35" />ओ परमेशर यहोवा, जिंयाँ ढाल रक्षा करोई तिंयाँ ई तूँ मेरी रक्षा करेया,</para>
  <para style="q" vid="PSA 18:35">ओर तेरी मताद पाई की आऊँ बऊत बड़ा राजा बणीगा रा।<verse eid="PSA 18:35" /></para>
  <para style="q">
    <verse number="36" style="v" sid="PSA 18:36" />तैं मां पाँदे कब्जा ऊणे ते बचाई राखेया,</para>
  <para style="q" vid="PSA 18:36">ओर आऊँ कदी नि रूड़ेया।<verse eid="PSA 18:36" /></para>
  <para style="q">
    <verse number="37" style="v" sid="PSA 18:37" />मां आपणे दुश्मणा रा पीछा करी की सेयो पकड़ी लणे</para>
  <para style="q" vid="PSA 18:37">ओर जदुए तक तिना रा नाश नि करी लऊँगा तदुए तक वापस नि आऊँगा।<verse eid="PSA 18:37" /></para>
  <para style="q">
    <verse number="38" style="v" sid="PSA 18:38" />मां सेयो एड़े मारने कि सेयो उठी नि सकणे;</para>
  <para style="q" vid="PSA 18:38">सेयो आरी कि मेरे पैरा पाँदे पड़ने।<verse eid="PSA 18:38" /></para>
  <para style="q">
    <verse number="39" style="v" sid="PSA 18:39" />तैं माखे इतणी तागत दित्ती, ताकि आँऊ आपणे दुश्मणा ते युद्ध करी की तिना खे अराई सकूँ।<verse eid="PSA 18:39" /></para>
  <para style="q">
    <verse number="40" style="v" sid="PSA 18:40" />तैं मेरे दुश्मण नठाए ओर मैं सेयो काईते,</para>
  <para style="q" vid="PSA 18:40">ओर आऊँ तिना खे नाश करी देऊँ जो मांते कृणा करोए।<verse eid="PSA 18:40" /></para>
  <para style="q">
    <verse number="41" style="v" sid="PSA 18:41" />तिने दुहाई तो दित्ती पर तिना खे कोई बी बचाणे वाल़ा नि मिलेया,</para>
  <para style="q" vid="PSA 18:41">तिने प्रभु बी आपणियां मतादा रिया तँईं पुकारेया,</para>
  <para style="q" vid="PSA 18:41">पर तिने बी तिना खे उत्तर नि दित्तेया।<verse eid="PSA 18:41" /></para>
  <para style="q">
    <verse number="42" style="v" sid="PSA 18:42" />मैं सेयो कूटी-कूटी की पऊणी की उडाई री तूड़ा जेड़े करीते;</para>
  <para style="q" vid="PSA 18:42">मैं सेयो बाटा रे चीकड़ो जेड़े निकयाल़ी की सेटी ते।<verse eid="PSA 18:42" /></para>
  <para style="q">
    <verse number="43" style="v" sid="PSA 18:43" />तैं आऊँ ऊड़दंग मचाणे वाल़ेया लोका रे चगड़ेया ते बी छुड़ाया;</para>
  <para style="q" vid="PSA 18:43">तैं आऊँ दूजिया जातिया रा परदान बणाई राखेया;</para>
  <para style="q" vid="PSA 18:43">जिना लोका खे आऊँ जाणूं पनि था तिने मेरी सेवा कित्ती।<verse eid="PSA 18:43" /></para>
  <para style="q">
    <verse number="44" style="v" sid="PSA 18:44" />जिंयाँ ई तिने मेरा नाओं सुणेया तिंयाँ ई सेयो मेरी आज्ञा रा पालण करने लगे,</para>
  <para style="q" vid="PSA 18:44">परदेशी मेरे वशो रे ऊई जाणे।<note caller="+" style="f"><char style="fr" closed="false">18:44 </char><char style="ft" closed="false">2 शमूएल 8:9-12</char></note><verse eid="PSA 18:44" /></para>
  <para style="q">
    <verse number="45" style="v" sid="PSA 18:45" />परदेशी मुरझाई जाणे</para>
  <para style="q" vid="PSA 18:45">ओर आपणे किलेया ते थरथराई की निकल़ने।<verse eid="PSA 18:45" /></para>
  <para style="q">
    <verse number="46" style="v" sid="PSA 18:46" />प्रभु परमेशर जिऊँदा ए; ओर चट्टानी जेड़ा मजबूत ए;</para>
  <para style="q" vid="PSA 18:46">ओर मेरा उद्धार करने वाल़े परमेशरो री स्तुति ओ।<verse eid="PSA 18:46" /></para>
  <para style="q">
    <verse number="47" style="v" sid="PSA 18:47" />तन्य ए मेरा बदला लणे वाल़ा परमेशर!</para>
  <para style="q" vid="PSA 18:47">जिने देशो-देशो रे लोक मेरे वशो रे करीते;<verse eid="PSA 18:47" /></para>
  <para style="q">
    <verse number="48" style="v" sid="PSA 18:48" />ओर प्रभुए आऊँ मेरे दुश्मणा ते छुड़ाया;</para>
  <para style="q" vid="PSA 18:48">तूँ माखे मेरे बरोदिया रे सामणे ऊच्चा करेया</para>
  <para style="q" vid="PSA 18:48">ओर चगड़ा करने वाल़ेया बरोदी मर्दा ते माखे बचाएया<verse eid="PSA 18:48" /></para>
  <para style="q">
    <verse number="49" style="v" sid="PSA 18:49" />इजी बजा ते ओ प्रभु, जातिया-जातिया रे सामणे मां तेरा तन्यवाद करना</para>
  <para style="q" vid="PSA 18:49">ओर तेरे नाओं रा पजन गाणा।<verse eid="PSA 18:49" /></para>
  <para style="q">
    <verse number="50" style="v" sid="PSA 18:50" />तूँ आपणे ठराए रे राजे रा बड़ा उद्धार करेआ;</para>
  <para style="q" vid="PSA 18:50">तां आपणे अभिषिक्त दाऊद</para>
  <para style="q" vid="PSA 18:50">ओर तेसरे वंशो पाँदे जुगो-जुगो तक करूणा करदे रणा।<verse eid="PSA 18:50" /></para>
  <chapter eid="PSA 18" />
  <chapter number="19" style="c" sid="PSA 19" />
  <para style="s">सृष्टिया रे परमेशरो री महिमा</para>
  <para style="d">बजाणे वाल़े परदानो रिया तँईं दाऊदो रा पजन</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 19:1" />जेबे लोक तिना चीजा खे देखोए जो परमेशरे स्वर्गो दे राखिया ए, तो सेयो समजी सकोए कि से बऊत महान ए ओर तिने सर्गो दे नौखिया चीजा बणाई राखिया ए।<verse eid="PSA 19:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 19:2" />हर रोज एकी माणूंए जेड़ा परमेशरो रे बारे दे बताओआ, ओर आगले दिने बी सेई काणी ए।</para>
  <para style="q" vid="PSA 19:2">ओर हर रात एकी माणूंए जेड़ी आसा खे सिखाओई कि परमेशर बड़ा महान ए।<verse eid="PSA 19:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 19:3" />ना तो कोई बोली ए ओर ना कोई पाषा,</para>
  <para style="q" vid="PSA 19:3">जेती तिना रा शब्द नि सुणदा।<verse eid="PSA 19:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 19:4" />फेर बी तिना री आवाज सारी तरतिया पाँदे गूँजी री</para>
  <para style="q" vid="PSA 19:4">ओर तिना रे वचन दुनिया रे कनारे तक पऊँची गे रे।</para>
  <para style="q" vid="PSA 19:4">परमेशरे सर्गो बीचे सूरजो रिया तँईं एक मण्डप खड़ा करी राखेया,<verse eid="PSA 19:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 19:5" />से एड़ा निकल़ोआ जेड़ा लाड़ा आपणे मईलो ते निकल़ोआ।</para>
  <para style="q" vid="PSA 19:5">से दौड़ने वाल़े खिलाड़ी ए जेड़ा आपणी दौड़ दौड़ने रे खुश ओआ।<verse eid="PSA 19:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 19:6" />से सर्गो रे एक कूणे ते निकल़ोआ</para>
  <para style="q" vid="PSA 19:6">ओर से तिजी रे दूजे कूणे तक चक्कर लगाओआ</para>
  <para style="q" vid="PSA 19:6">ओर तेसरी गर्मी सबी खे पऊँचोई।<verse eid="PSA 19:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 19:7" />यहोवे रा बिधान खरा ए, से प्राणो खे नवीं जिन्दगी देओआ;</para>
  <para style="q" vid="PSA 19:7">यहोवे रे नियम परोसे जोगे ए,</para>
  <para style="q" vid="PSA 19:7">शरीफ माणूंए खे अक्लमंद बणाई देओए।<verse eid="PSA 19:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 19:8" />यहोवे रे उपदेश सिद्ध ए, मनो खे खुश करी देओए;</para>
  <para style="q" vid="PSA 19:8">यहोवे री आज्ञा ठीक ए, से आखी रे जोति लई आओई;<verse eid="PSA 19:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 19:9" />यहोवे रा वचन पवित्र ए, से अनन्तकालो तक बणेया दा रओआ;</para>
  <para style="q" vid="PSA 19:9">परमेशर यहोवे रे फैंसले खरे ओर पुरिया तरआ ते सई ए।<verse eid="PSA 19:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 19:10" />सेयो तो सूईने ते जादा चाणे जोगे ए ओर शुद्ध सूईने ते बी बढ़ी की मनो खे अच्छे लगणे वाल़े ए;</para>
  <para style="q" vid="PSA 19:10">सेयो सईतो ते ओर छते ते टपकणे वाल़े सईतो ते बी बढ़ी की मीठे ए।<note caller="+" style="f"><char style="fr" closed="false">19:10 </char><char style="ft" closed="false">पजन. 119:72,103</char></note><verse eid="PSA 19:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 19:11" />तिना तेई तेरा दास चौकस कित्तेया जाओआ;</para>
  <para style="q" vid="PSA 19:11">तिना खे मानणे ते बड़ा प्रतिफल मिलोआ।<note caller="+" style="f"><char style="fr" closed="false">19:11 </char><char style="ft" closed="false">2 यूह. 1:8, पजन 119:11</char></note><verse eid="PSA 19:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 19:12" />पर कोई बी आपणी गल़ती नि समजी सकदा,</para>
  <para style="q" vid="PSA 19:12">इजी री खातर ओ यहोवा, तूँ माखे मेरे गुप्त पापा खे माफ करी की पवित्र करी दे।<verse eid="PSA 19:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 19:13" />तूँ आपणे दासो खे एड़िया चीजा करने ते दूर राख जो माखे पता ए कि गल़त ए;</para>
  <para style="q" vid="PSA 19:13">मेरेया सारे पापा खे मां पाँदे राज नि करने दे!</para>
  <para style="q" vid="PSA 19:13">जे तूँ एड़ा करेया तो आऊँ एबे एड़े पाप करने रिया तँईं दोषी नि ऊणा, ओर आऊँ तेरे खलाफ बिद्रोह करी कि बड़ा पापी नि बणना।<note caller="+" style="f"><char style="fr" closed="false">19:13 </char><char style="ft" closed="false">गिण. 15:30</char></note><verse eid="PSA 19:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 19:14" />ओ परमेशर यहोवा, तूँ माखे छुड़ाणे वाल़ा ओर मेरी रक्षा करने वाल़ा मजबूत पाह्ड़ो जेड़ा ए,</para>
  <para style="q" vid="PSA 19:14">मेरे मुंए रे वचन ओर मेरे मनो रा त्यान करना तां सामणे ग्रहण करने जोगा ओ!<verse eid="PSA 19:14" /></para>
  <chapter eid="PSA 19" />
  <chapter number="20" style="c" sid="PSA 20" />
  <para style="s">जीतणे रिया तँईं प्रार्थना</para>
  <para style="d">बजाणे वाल़े रे परदानो रिया तँईं दाऊदो रा पजन</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 20:1" />आऊँ प्रार्थना करूँआ कि जेबे तूँ मुसीबता दे ए तो प्रभुए तेरी सुणी लओ!</para>
  <para style="q" vid="PSA 20:1">ओर याकूबो रा परमेशर तेरी रक्षा करो!<verse eid="PSA 20:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 20:2" />से आपणियां पवित्र जगा ते तेरी मताद करो,</para>
  <para style="q" vid="PSA 20:2">ओर सिय्योन पाह्ड़ो ते ताखे सम्बाल़ो!<verse eid="PSA 20:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 20:3" />से तेरी सारी नज्जो री बलिया खे याद राखो</para>
  <para style="q" vid="PSA 20:3">ओर तेरी होमबलिया खे ग्रईण करो। सेला<verse eid="PSA 20:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 20:4" />से तेरी मनो री इच्छा खे पूरी करो</para>
  <para style="q" vid="PSA 20:4">ओर तेरी सारी योजना खे सफल करो!<verse eid="PSA 20:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 20:5" />तेबे आसा तेरे उद्धारो रिया खुशिया दे चींगणा</para>
  <para style="q" vid="PSA 20:5">ओर म्हारे परमेशरो री तारीफ करी कि तेरिया जीता रा जशन मनाणा।</para>
  <para style="q" vid="PSA 20:5">प्रभु ताखे तेरिया सबी प्रार्थना रा ज्वाब देओ।<note caller="+" style="f"><char style="fr" closed="false">20:5 </char><char style="ft" closed="false">पजन 60:4</char></note><verse eid="PSA 20:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 20:6" />एबे माखे पता लगी गा कि यहोवा आपणे चूणे दे राजे रा उद्धार करोआ,</para>
  <para style="q" vid="PSA 20:6">से पवित्र स्वर्गो ते तेसरी प्रार्थना सुणोआ फेर आपणे महान बलो ते तेसखे जीत दिलाओआ।<verse eid="PSA 20:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 20:7" />केसी खे रथा रा ओर केसी खे कोड़ेया रा परोसा ए,</para>
  <para style="q" vid="PSA 20:7">पर आसे आपणे प्रभु परमेशरो री सामर्था पाँदे परोसा राखूँए।<note caller="+" style="f"><char style="fr" closed="false">20:7 </char><char style="ft" closed="false">पजन 33:16,17</char></note><verse eid="PSA 20:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 20:8" />एड़े लोक तो नपी गे ओर रूड़ीगे</para>
  <para style="q" vid="PSA 20:8">पर आसे तो उठे ओर सीदे खड़े ए।<verse eid="PSA 20:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 20:9" />ओ प्रभु, राजे खे बचाई दे,</para>
  <para style="q" vid="PSA 20:9">जेबे आसे ताखे बुलाऊँ तो तूँ आसा खे ज्वाब दे।<verse eid="PSA 20:9" /></para>
  <chapter eid="PSA 20" />
  <chapter number="21" style="c" sid="PSA 21" />
  <para style="s">प्रभुए रे उद्धारो रे खुशी</para>
  <para style="d">बजाणे वाल़े रे परदानो रिया तँईं दाऊदो रा पजन</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 21:1" />ओ यहोवा, तेरी महान तागत राजे खे बी खुश करी देओई,</para>
  <para style="q" vid="PSA 21:1">से खुशी मनाओआ कऊँकि तूँ तेसखे उद्धार देआ।<verse eid="PSA 21:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 21:2" />तैं तेसरे मनो री इच्छा पूरी करी राखी</para>
  <para style="q" vid="PSA 21:2">ओर तैं तेसरी बिनतिया रा ज्वाब देआ। सेला<verse eid="PSA 21:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 21:3" />कऊँकि तेसरिया प्रार्थना रे ज्वाबो दे,</para>
  <para style="q" vid="PSA 21:3">तैं तेसखे सफल ओर समृद्ध ऊणे दे मताद कित्ती</para>
  <para style="q" vid="PSA 21:3">ओर तेसरे सिरो पाँदे सूईने रा मुकुट राखेया।<verse eid="PSA 21:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 21:4" />तिने तांते जिन्दगी मांगी ओर तैं तेसखे जीवनदान दित्तेया;</para>
  <para style="q" vid="PSA 21:4">तैं तेसखे जुगो-जुगो री जिन्दगी देईती।<verse eid="PSA 21:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 21:5" />से बऊत प्रतापो वाल़ा ए,</para>
  <para style="q" vid="PSA 21:5">कऊँकि तैं तेसखे आपणेया दुश्मणा खे अराणे दे मताद कित्ती;</para>
  <para style="q" vid="PSA 21:5">तैं से प्रसिद्ध बणाईता रा।<verse eid="PSA 21:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 21:6" />तैं तेसखे आशीष दित्ती जो सदा खे बणेया दा रणा,</para>
  <para style="q" vid="PSA 21:6">ओर तैं तेसगे रणे रे जरिये से खुश करिता रा ए।<verse eid="PSA 21:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 21:7" />कऊँकि राजे रा परोसा यहोवे पाँदे ए</para>
  <para style="q" vid="PSA 21:7">ओर परमपरदान परमेशरो रिया दया ते तेसरा सिंहासन मजबूत बणेया रा रणा।<verse eid="PSA 21:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 21:8" />तूँ तेसखे आपणे सबी दुश्मणा ओर तिना सबी ते जो तेसते नफरत करोए तिना पाँदे कब्जा करने दे सक्षम बणाओआ।<verse eid="PSA 21:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 21:9" />जेबे तूँ प्रकट ऊणा तेबे तां आपू सामणे आपणे दुश्मण बल़दे ऊए भट्टे जेड़े जल़ाणे।</para>
  <para style="q" vid="PSA 21:9">प्रभुए सेयो आपणे गुस्से ते निगल़ी लणे</para>
  <para style="q" vid="PSA 21:9">ओर आगी सेयो स्वा करी देणे।<verse eid="PSA 21:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 21:10" />तां तिना री ल्वाद तरतिया पाँदा ते मटयाई देणी</para>
  <para style="q" vid="PSA 21:10">ओर तिना रा वंश माणूंआ बीचा ते नाश करी देणा।<verse eid="PSA 21:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 21:11" />कऊँकि तिने तेरे खलाफ बुरा करने रा सोची राखेया,</para>
  <para style="q" vid="PSA 21:11">तिने एड़ा साजिश रचाई राखेया तेबे बी सेयो सफल नि ऊणे।<verse eid="PSA 21:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 21:12" />तां सेयो पीठ दखाई की नठणे खे मजबूर करी देणे</para>
  <para style="q" vid="PSA 21:12">कऊँकि तां आपणा धनुष तिना रे खलाफ चढ़ाणा।<verse eid="PSA 21:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 21:13" />ओ प्रभु, आपणी सामर्था री महानता खे प्रकट कर!</para>
  <para style="q" vid="PSA 21:13">आसा गायी-गायी की तेरे पराक्रमो रा पजन सुनाणा।<verse eid="PSA 21:13" /></para>
  <chapter eid="PSA 21" />
  <chapter number="22" style="c" sid="PSA 22" />
  <para style="s">माणूंए रे मनो री पुकार ओर स्तुतिगान</para>
  <para style="d">बजाणे वाल़े परदानो रिया तँईं अभ्येलेरशर रागो दे दाऊदो रा पजन</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 22:1" />ओ मेरे परमेशर! ओ मेरे परमेशर!</para>
  <para style="q" vid="PSA 22:1">तैं आऊँ कऊँ छाडीता?</para>
  <para style="q" vid="PSA 22:1">तूँ मेरी मताद कऊँ नि करदा?</para>
  <para style="q" vid="PSA 22:1">तूँ मेरी पुकार कऊँ नि सुणदा? तूँ माखे कऊँ नि बचांदा?<verse eid="PSA 22:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 22:2" />ओ मेरे परमेशर! आऊँ ताखे दिने आका पाऊँआ,</para>
  <para style="q" vid="PSA 22:2">पर तूँ ज्वाब नि देंदा</para>
  <para style="q" vid="PSA 22:2">ओर राती बी आऊँ‍ चुप नि रंदा।<verse eid="PSA 22:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 22:3" />पर तूँ तो इस्राएलो री स्तुतिया रे सिंहासणो पाँदे विराजमान ए,</para>
  <para style="q" vid="PSA 22:3">तूँ तो पवित्र परमेशर ए।<verse eid="PSA 22:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 22:4" />म्हारे बुजुर्ग तां ई पाँदे परोसा राखो थे;</para>
  <para style="q" vid="PSA 22:4">सेयो परोसा राखो थे</para>
  <para style="q" vid="PSA 22:4">ओर तूँ तिना खे खतरेया ते बचाए था।<verse eid="PSA 22:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 22:5" />तिने तूँई पुकारेया ओर तैं सेयो छुड़ाए</para>
  <para style="q" vid="PSA 22:5">ओर सेयो तां ई पाँदे परोसा राखो थे</para>
  <para style="q" vid="PSA 22:5">ओर सेयो कदी शर्मिंदा नि ऊए।<verse eid="PSA 22:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 22:6" />पर तैं आऊँ नि बचाया,</para>
  <para style="q" vid="PSA 22:6">लोक माखे नबाग समजोए ओर तिना रा बचार ए कि आऊँ एक माणूं नि आ,</para>
  <para style="q" vid="PSA 22:6">पर एकी कीड़े जेड़ा बेकार ए!<verse eid="PSA 22:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 22:7" />माखे देखणे वाल़े सब जणे मेरा मजाक उडाओए</para>
  <para style="q" vid="PSA 22:7">ओर ओठ चबाओए</para>
  <para style="q" vid="PSA 22:7">ओर सिर ईलाई की ओर मेरी बेजती करोए ओर बोलोए,<note caller="+" style="f"><char style="fr" closed="false">22:7 </char><char style="ft" closed="false">मत्ती 27:39, मरक 15:29</char></note><verse eid="PSA 22:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 22:8" />“से यहोवे पाँदे परोसा करोआ ओर बोलोआ,</para>
  <para style="q" vid="PSA 22:8">कि यहोवा तेसते बऊत खुश ए;</para>
  <para style="q" vid="PSA 22:8">जे एड़ा ए, तो सेई एसखे छुड़ाओ ओर मताद करो!”<note caller="+" style="f"><char style="fr" closed="false">22:8 </char><char style="ft" closed="false">पजन. 91:14</char></note><verse eid="PSA 22:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 22:9" />से तूँई था जिने आऊँ गर्भो ते निकयाल़ेया;</para>
  <para style="q" vid="PSA 22:9">जेबे आऊँ दूद पींदा बच्चा था,</para>
  <para style="q" vid="PSA 22:9">तदुए तेई तैं माखे परोसा राखणा सिखाया।<verse eid="PSA 22:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 22:10" />आऊँ जन्मो तेई तांगे सम्बाल़ी ता था,</para>
  <para style="q" vid="PSA 22:10">माया रे गर्भो तेई तूँई मेरा परमेशर रया।<verse eid="PSA 22:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 22:11" />मांते दूर नि ओ कऊँकि मुसीबत नेड़े ए</para>
  <para style="q" vid="PSA 22:11">ओर कोई मेरी मताद करने वाल़ा नि ए।<verse eid="PSA 22:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 22:12" />मेरे दुश्मण बणो रे बल़दा रे चूण्डो जेड़े मेरे चऊँ कनारे ए।</para>
  <para style="q" vid="PSA 22:12">सेयो बाशान देशो रे साँडा जेड़े बऊत तागती वाल़े ए ओर तिने मेरे चऊँ कनारे केरा पाई राखेया।<verse eid="PSA 22:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 22:13" />सेयो फाड़ने ओर गरजणे वाल़े शेरो जेड़े ए,</para>
  <para style="q" vid="PSA 22:13">तिने मेरी तरफा खे आपणा मूँ खोली राखेया।<verse eid="PSA 22:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 22:14" />आऊँ पुरिया तरआ ते थकी गा रा</para>
  <para style="q" vid="PSA 22:14">ओर मेरी सारी आड्डिया रे जोड़ उखड़ी गे;</para>
  <para style="q" vid="PSA 22:14">आऊँ एबे ये उम्मीद नि करदा कि परमेशर माखे बचाओगा;</para>
  <para style="q" vid="PSA 22:14">ये उम्मीद पुरिया तरआ ते चली गी री ए जिंयाँ मोम जो गल़ी गा रा ए।<verse eid="PSA 22:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 22:15" />मेरी तागत टूटे रे माट्टिया रे पांडे जेड़ी सूकी गी ए,</para>
  <para style="q" vid="PSA 22:15">ओर मेरी जीब मेरे ताल़ूए साथे चिपकी गी ए।</para>
  <para style="q" vid="PSA 22:15">परमेशर, तैं आऊँ छाडीता रा ए कि आऊँ मरी की माट्टिया दे मिली जाणा।<note caller="+" style="f"><char style="fr" closed="false">22:15 </char><char style="ft" closed="false">नसी 17:22 अय्यू. 7.21; पजन 7.5, 90.3 </char></note><verse eid="PSA 22:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 22:16" />मेरेया दुश्मणे आऊँ चऊँ कनारा ते केरी ला कटणे वाल़े कुत्तेया रे चूण्डो जेड़ा,</para>
  <para style="q" vid="PSA 22:16">तिने मेरे आथ-पैर कटी ते दे।<note caller="+" style="f"><char style="fr" closed="false">22:16 </char><char style="ft" closed="false">मत्ती 27:35, मरक 15:29, लूक 23:33</char></note><verse eid="PSA 22:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 22:17" />आऊँ आपणी एक-एक आड्डी गिणी सकूँआ;</para>
  <para style="q" vid="PSA 22:17">मेरे दुश्मण माखे कूरदे ऊए मेरा मजाक उडाणे लगी रे।<verse eid="PSA 22:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 22:18" />तिने मेरे टाल्ले आपू बीचे बांडी ले</para>
  <para style="q" vid="PSA 22:18">ओर मेरे टाल्लेया पाँदे चिट्ठी पाई।<note caller="+" style="f"><char style="fr" closed="false">22:18 </char><char style="ft" closed="false">मत्ती 27:35, लूक 23:34, यहून् 19:24,25</char></note><verse eid="PSA 22:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 22:19" />पर ओ प्रभु तूँ दूर नि रओ!</para>
  <para style="q" vid="PSA 22:19">ओ मेरी मताद करने वाल़े, बिना देर कित्ते मेरी मताद कर!<verse eid="PSA 22:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 22:20" />तलवारी ते ओर कुत्ते रे पंजे ते मेरे प्राणो खे बचाई लओ!<verse eid="PSA 22:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PSA 22:21" />माखे शेरो रे मुंए ते बचा,</para>
  <para style="q" vid="PSA 22:21">जंगल़ी सांडो रे सींगा ते तैं आऊँ बचाई ला रा।<verse eid="PSA 22:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="PSA 22:22" />मां आपणे इस्राएली पाईया सामणे तेरे नाओं रा प्रचार करना;</para>
  <para style="q" vid="PSA 22:22">सभा बीचे मां तेरी तारीफ करनी।<note caller="+" style="f"><char style="fr" closed="false">22:22 </char><char style="ft" closed="false">इब्रानी 2:12</char></note><verse eid="PSA 22:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="PSA 22:23" />ओ यहोवे रा डर मानणे वाल़ेयो, तेसरी स्तुति करो!</para>
  <para style="q" vid="PSA 22:23">ओ याकूबो रे वंशो रे लोको तुसे सब तेसरी महिमा करो!</para>
  <para style="q" vid="PSA 22:23">ओ इस्राएलो रे वंशो रे लोको, तेसरी पग्ती करो!<note caller="+" style="f"><char style="fr" closed="false">22:23 </char><char style="ft" closed="false">पजन 135:19,20</char></note><verse eid="PSA 22:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="PSA 22:24" />कऊँकि प्रभुए दु:खी माणूंए रा बेज्जती नि कित्तेया</para>
  <para style="q" vid="PSA 22:24">ओर ना तेसते कृणा कित्ती ओर ना तेस दु:खी माणूंए ते आपणा मूँ लकोया;</para>
  <para style="q" vid="PSA 22:24">पर जेबे तिने माणूंए प्रभुए री दुहाई दित्ती, तेबे तिने तेसरी सुणी ली।<verse eid="PSA 22:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="PSA 22:25" />बड़ी सभा रे मेरा स्तुति करना तेरिया ई तरफा ते ओआ;</para>
  <para style="q" vid="PSA 22:25">मां तेरे पग्ता रे सामणे आपणी मान्नत पूरी करनी।<verse eid="PSA 22:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="PSA 22:26" />नम्र लोक रोटी खाई की रजणे;</para>
  <para style="q" vid="PSA 22:26">प्रभुए खे टोल़ने वाल़ेया प्रभुए री स्तुति करनी।</para>
  <para style="q" vid="PSA 22:26">सेओ सदा जिऊँदे रओ!<verse eid="PSA 22:26" /></para>
  <para style="q">
    <verse number="27" style="v" sid="PSA 22:27" />तरतिया रे सबी दूर-दूर देशो रे लोका प्रभुए रा नाओं याद करना</para>
  <para style="q" vid="PSA 22:27">ओर तेसरी तरफा खे फिरने</para>
  <para style="q" vid="PSA 22:27">ओर हर जातिया रे लोका तेरी आराधना करनी।<verse eid="PSA 22:27" /></para>
  <para style="q">
    <verse number="28" style="v" sid="PSA 22:28" />कऊँकि राज्य प्रभुए रा ईए</para>
  <para style="q" vid="PSA 22:28">ओर सबी देशा पाँदे सेई राजा ए।<note caller="+" style="f"><char style="fr" closed="false">22:28 </char><char style="ft" closed="false">जकर्याह. 14:9</char></note><verse eid="PSA 22:28" /></para>
  <para style="q">
    <verse number="29" style="v" sid="PSA 22:29" />पक्का, तरतिया रे सारे कमण्डी लोक प्रभुए रे सामणे चुकणे;</para>
  <para style="q" vid="PSA 22:29">सेयो सब जो माट्टिया रे मिली जाओए</para>
  <para style="q" vid="PSA 22:29">ओर जो आपणा प्राण नि बचाई सकदे,</para>
  <para style="q" vid="PSA 22:29">तिना सबी यहोवे रे सामणे ई कुटणे टेकणे।<verse eid="PSA 22:29" /></para>
  <para style="q">
    <verse number="30" style="v" sid="PSA 22:30" />एकी पीढ़िया रे लोका तेसरी सेवा करनी;</para>
  <para style="q" vid="PSA 22:30">दूजी पीढ़िया रे लोका प्रभुए रे बारे बताणा।<verse eid="PSA 22:30" /></para>
  <para style="q">
    <verse number="31" style="v" sid="PSA 22:31" />सेयो आऊणे ओर तेसरी तार्मिकता रे काम एकी वंशो पाँदे जो पैदा ऊणा,</para>
  <para style="q" vid="PSA 22:31">ये बोली की प्रगट करने कि तिने एड़े-एड़े अचम्बे रे काम कित्ते।<verse eid="PSA 22:31" /></para>
  <chapter eid="PSA 22" />
  <chapter number="23" style="c" sid="PSA 23" />
  <para style="s">प्रभु मेरा चराणे वाल़ा ए</para>
  <para style="d">दाऊदो रा पजन</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 23:1" />प्रभु माखे चराणे वाल़ा ए,</para>
  <para style="q" vid="PSA 23:1">माखे कोई कमी नि ऊणी।<note caller="+" style="f"><char style="fr" closed="false">23:1 </char><char style="ft" closed="false">यशायाह 40:11</char></note><verse eid="PSA 23:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 23:2" />से माखे अरी-परी काओ री जमीना दे राम कराओआ;<note caller="+" style="f"><char style="fr" closed="false">23:2 </char><char style="ft" closed="false">पेडा रे चरने ओर राम करने रिया तँईं एक खरी जगा </char></note></para>
  <para style="q" vid="PSA 23:2">से माखे शांत झरने रे कनारे पाँदे लई जाओआ।<verse eid="PSA 23:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 23:3" />से माखे नवीं तागत देओआ।</para>
  <para style="q" vid="PSA 23:3">से माखे सई बाट दखाओआ,</para>
  <para style="q" vid="PSA 23:3">जेड़ा तिने वादा करी राखेया ए।<verse eid="PSA 23:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 23:4" />चाए आऊँ बऊत जादा न्हेरिया काअटिया रे ऊई की चलूँ,</para>
  <para style="q" vid="PSA 23:4">तेबे बी कोई अनिष्ट ऊणे ते नि डरदा,</para>
  <para style="q" vid="PSA 23:4">कऊँकि ओ प्रभु, तूँ मां साथे ए,</para>
  <para style="q" vid="PSA 23:4">तेरे चराणे वाल़े री सोठी ओर डण्डा मेरी रक्षा करोए।<verse eid="PSA 23:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 23:5" />मेरे दुश्मणा री मौजुदगिया रे तूँ मेरिया तँईं रोटिया री मेज<note caller="+" style="f"><char style="fr" closed="false">23:5 </char><char style="ft" closed="false">बड़े खाणे </char></note> लगाओआ;</para>
  <para style="q" vid="PSA 23:5">तैं तेलो साथे मेरा अभिषेक करी राखेया,</para>
  <para style="q" vid="PSA 23:5">मेरा कटोरा छल़कणे लगी रा।<verse eid="PSA 23:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 23:6" />पक्का पलाई ओर करूणा जिन्दगी पर मां साथे बणी री रणी</para>
  <para style="q" vid="PSA 23:6">ओर मां प्रभुए रे कअरे जुगो-जुगो तक रणा।<verse eid="PSA 23:6" /></para>
  <chapter eid="PSA 23" />
  <chapter number="24" style="c" sid="PSA 24" />
  <para style="s">महिमामय राजा</para>
  <para style="d">दाऊदो रा पजन</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 24:1" />तरती ओर जो कुछ तिदे ए,</para>
  <para style="q" vid="PSA 24:1">दुनिया ओर तिदे रणे वाल़े लोक बी सब यहोवे रे ए।<verse eid="PSA 24:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 24:2" />कऊँकि प्रभुए ई तेतेरी निऊँ समुद्रो रिया गईराईया दे मजबूत करी राखी</para>
  <para style="q" vid="PSA 24:2">ओर नदिया पाँदे ठराई राखी।<verse eid="PSA 24:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 24:3" />प्रभुए रे पाह्ड़ो पाँदे कुण चढ़ी सकोआ?</para>
  <para style="q" vid="PSA 24:3">ओर तेसरिया पवित्र जगा रे कुण खड़ा ऊई सकोआ?<verse eid="PSA 24:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 24:4" />सिर्फ सेई जेसरे काम निर्दोष ओर बचार अच्छे ए,</para>
  <para style="q" vid="PSA 24:4">जो मूर्तिपूजा नि करदे ओर जो चूठ नि बोलदे।<verse eid="PSA 24:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 24:5" />यहोवे तिना खे आशीष देणी ओर सेयो बचाणे,</para>
  <para style="q" vid="PSA 24:5">ओर सेयो तर्मी ठराणे।<verse eid="PSA 24:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 24:6" />एड़े ई लोक परमेशरो खे टोल़ने वाल़े ए,</para>
  <para style="q" vid="PSA 24:6">तेरे दर्शणो री इच्छा राखणे वाल़े याकूबो रे वंशो रे ए। सेला<verse eid="PSA 24:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 24:7" />ओ द्वारो, आपणे सिर ऊच्चे करो!</para>
  <para style="q" vid="PSA 24:7">ओ सनातनो रे द्वारो, ऊच्चे ऊई जाओ,</para>
  <para style="q" vid="PSA 24:7">ताकि प्रतापी राजा पीतरे आई सको!<verse eid="PSA 24:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 24:8" />से प्रतापी राजा कुण ए?</para>
  <para style="q" vid="PSA 24:8">प्रभु, जो सामर्थी ओर पराक्रमी ए,</para>
  <para style="q" vid="PSA 24:8">परमेशर, जो युद्धो रे पराक्रमी ए!<verse eid="PSA 24:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 24:9" />ओ द्वारो, आपणे सिर ऊच्चे करो!</para>
  <para style="q" vid="PSA 24:9">ओ सनातनो रे द्वारो, ऊच्चे ऊई जाओ,</para>
  <para style="q" vid="PSA 24:9">ताकि प्रतापी राजा पीतरे आई सको!<verse eid="PSA 24:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 24:10" />से प्रतापी राजा कुण ए?</para>
  <para style="q" vid="PSA 24:10">सेनाओं रा प्रभु, सेई प्रतापी राजा ए। सेला<verse eid="PSA 24:10" /></para>
  <chapter eid="PSA 24" />
  <chapter number="25" style="c" sid="PSA 25" />
  <para style="s">अगुवाई ओर रक्षा रिया तँईं प्रार्थना</para>
  <para style="d">दाऊदो रा पजन</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 25:1" />ओ प्रभु आऊँ तां पाँदे ई परोसा करूँआ।<note caller="+" style="f"><char style="fr" closed="false">25:1 </char><char style="ft" closed="false">86:4, 143:8 </char></note><verse eid="PSA 25:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 25:2" />ओ मेरे परमेशर, मैं तांई पाँदे परोसा राखी राखेया,</para>
  <para style="q" vid="PSA 25:2">माखे शर्मिंदा नि ऊणे देया;</para>
  <para style="q" vid="PSA 25:2">मेरे दुश्मण मां पाँदे विजय नि पाई सको।<verse eid="PSA 25:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 25:3" />बल्कि जितणे लोक तेरा इन्तजार करोए,</para>
  <para style="q" vid="PSA 25:3">तिना बीचा ते कोई बी शर्मिंदा नि ऊणा,</para>
  <para style="q" vid="PSA 25:3">पर जो बिना बजा ते विश्वासघात करोए</para>
  <para style="q" vid="PSA 25:3">सेयो ई शर्मिंदा ऊणे।<verse eid="PSA 25:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 25:4" />ओ यहोवा, आपणी बाट माखे दखा;</para>
  <para style="q" vid="PSA 25:4">माखे तिजी पाँदे चलणा सखा।<verse eid="PSA 25:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 25:5" />माखे आपणी सच्चाईया रिया बाटा पाँदे चलणा सखा,</para>
  <para style="q" vid="PSA 25:5">कऊँकि तूँई मेरा परमेशर ए जो माखे बचाओआ।</para>
  <para style="q" vid="PSA 25:5">माखे सदा तेरा ई परोसा रओआ।<verse eid="PSA 25:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 25:6" />ओ प्रभु, आपणी दया ओर करूणा खे याद कर;</para>
  <para style="q" vid="PSA 25:6">कऊँकि तूँ तिना खे जुगो-जुगो ते प्रकट करदा आई रा।<verse eid="PSA 25:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 25:7" />ओ प्रभु, आपणी पलाईया रिया बजा ते</para>
  <para style="q" vid="PSA 25:7">मेरी जवानिया रे पाप ओर पाप याद नि कर;</para>
  <para style="q" vid="PSA 25:7">आपणी करूणा रेई मुताबिक तूँ माखे याद कर।<verse eid="PSA 25:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 25:8" />कऊँकि तूँ यहोवा तर्मी ओर पला ए;</para>
  <para style="q" vid="PSA 25:8">तूँ पापी माणूंआ खे बी सिखाए आ कि तेरिया बाटा दे किंयाँ चलणा ए।<verse eid="PSA 25:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 25:9" />से नम्र लोका खे सई बाटा दे चलणा सिखाओआ,</para>
  <para style="q" vid="PSA 25:9">ओर तिना खे आपणी इच्छा बी सिखाओआ।<verse eid="PSA 25:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 25:10" />जो प्रभुए रे वादे ओर चतौणिया खे मानोए,</para>
  <para style="q" vid="PSA 25:10">तिना खे प्रभुए रिया सारिया बाटा करूणा ओर सच्चाईया रिया ए।<note caller="+" style="f"><char style="fr" closed="false">25:10 </char><char style="ft" closed="false">यूह. 1:17</char></note><verse eid="PSA 25:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 25:11" />ओ यहोवा, तूँ आपणे वादे खे याद कर,</para>
  <para style="q" vid="PSA 25:11">मेरे पाप जो बऊत ए, माफ कर।<verse eid="PSA 25:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 25:12" />जे कोई प्रभुए रा आदर करोए,</para>
  <para style="q" vid="PSA 25:12">तो प्रभु तेस माणूंए खे जीवन जिऊणे रा सई तरीका बताओआ।<verse eid="PSA 25:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 25:13" />से हमेशा रजे दे रणे</para>
  <para style="q" vid="PSA 25:13">ओर तेसरा वंश तरतिया पाँदे अधिकारी ऊणा।<verse eid="PSA 25:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 25:14" />प्रभु आपणे पग्ता खे सई बाट दखाओआ,</para>
  <para style="q" vid="PSA 25:14">ओर तेस तिना खे आपणी वाचा रा पाल़न करना सिखाणा।<note caller="+" style="f"><char style="fr" closed="false">25:14 </char><char style="ft" closed="false">इफि. 1:9, इफि. 1:18</char></note><verse eid="PSA 25:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 25:15" />मां हर बखते मतादा रिया तँईं परमेशरो रिया तरफा खे देखणा,</para>
  <para style="q" vid="PSA 25:15">ओर से माखे खतरे ते बचाओआ।<note caller="+" style="f"><char style="fr" closed="false">25:15 </char><char style="ft" closed="false">पजन 141:8</char></note><verse eid="PSA 25:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 25:16" />ओ प्रभु, मेरिया तरफा खे फिरी की मां पाँदे दया कर;</para>
  <para style="q" vid="PSA 25:16">कऊँकि आऊँ कल्ला ओर दु:खी ए।<verse eid="PSA 25:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 25:17" />मेरे मनो रा क्ल़ेश बढ़ी गा रा, माखे मेरे दु:खो ते छुड़ाई लओ।<verse eid="PSA 25:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 25:18" />मेरे दु:ख ओर कष्टा खे देख</para>
  <para style="q" vid="PSA 25:18">ओर मेरे सारे पाप माफ कर।<verse eid="PSA 25:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 25:19" />मेरे दुश्मणा खे देख कि सेयो किंयाँ बढ़ीगे रे</para>
  <para style="q" vid="PSA 25:19">ओर मां साथे बड़ी पारी दुश्मणी राखोए।<verse eid="PSA 25:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 25:20" />मेरे प्राणो री रक्षा कर ओर मेरा उद्धार कर,</para>
  <para style="q" vid="PSA 25:20">माखे शर्मिंदा नि ऊणे दे;</para>
  <para style="q" vid="PSA 25:20">कऊँकि आऊँ तेरी शरणा रे आई रा।<verse eid="PSA 25:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PSA 25:21" />ओ यहोवा, मेरिया रक्षा रिया तँईं आऊँ तां पाँदे परोसा करूँआ।</para>
  <para style="q" vid="PSA 25:21">मेरा त्यान राख, कऊँकि आऊँ ईमानदार ओर ठीक ए।<verse eid="PSA 25:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="PSA 25:22" />ओ यहोवा, आपणे इस्राएली लोका खे तूँ सबी मुसीबता ते छुड़ाई लओ।<verse eid="PSA 25:22" /></para>
  <chapter eid="PSA 25" />
  <chapter number="26" style="c" sid="PSA 26" />
  <para style="s">एक खरे माणूंए री प्रार्थना</para>
  <para style="d">दाऊदो रा पजन</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 26:1" />ओ यहोवा, मेरा न्याय कर,</para>
  <para style="q" vid="PSA 26:1">कऊँकि मेरा चाल-चलण निर्दोष ए;</para>
  <para style="q" vid="PSA 26:1">ओ यहोवा, तां पाँदे मैं परोसा जो करी राखेया ओर से पक्का ए।<verse eid="PSA 26:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 26:2" />ओ प्रभु, माखे जांच ओर परख;</para>
  <para style="q" vid="PSA 26:2">मेरे मन ओर मेरे दिलो खे परख।<verse eid="PSA 26:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 26:3" />तेरी करूणा तो मेरिया आखी सामणे ए</para>
  <para style="q" vid="PSA 26:3">ओर आऊँ तेरी सच्चाईया पाँदे चलदा आई रा।<verse eid="PSA 26:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 26:4" />आऊँ चूठ बोलणे वाल़ेया साथे नि बैठेया</para>
  <para style="q" vid="PSA 26:4">ओर ना ई मां कपटिया री संगति करनी,<verse eid="PSA 26:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 26:5" />आऊँ बुरेया लोका रिया संगतिया ते कृणा करूँआ</para>
  <para style="q" vid="PSA 26:5">ओर ना ई मां दुष्टा साथे बैठणा।<verse eid="PSA 26:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 26:6" />मां आपणे आथ निर्दोषो रे पाणिए साथे तोणे,</para>
  <para style="q" vid="PSA 26:6">तेबे ओ प्रभु, मां तेरी बेदिया री प्रदखणा लणी।<note caller="+" style="f"><char style="fr" closed="false">26:6 </char><char style="ft" closed="false">पजन 73:13</char></note><verse eid="PSA 26:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 26:7" />ताकि तेरा तन्यवाद जोरे की करुँ</para>
  <para style="q" vid="PSA 26:7">ओर तेरे सारे अचम्बे रे कामा रा बखाण करुँ।<verse eid="PSA 26:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 26:8" />ओ प्रभु, आऊँ प्यार करूँआ तेस मईलो ते से जो तेरा धाम ए;</para>
  <para style="q" vid="PSA 26:8">तेसा जगा ते जो तेरी महिमा री रणे री जगा ए।<verse eid="PSA 26:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 26:9" />हे यहोवा, मेरी मौत पापी माणूंए जेड़ी नि ओ,</para>
  <para style="q" vid="PSA 26:9">ओर मेरी जिन्दगिया खे अत्यारेया साथे नि मिला।<verse eid="PSA 26:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 26:10" />सेयो तो बुरे काम करने दे लगे रे रओए</para>
  <para style="q" vid="PSA 26:10">ओर हमेशा रिश्वत लणे खे त्यार रओए।<verse eid="PSA 26:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 26:11" />पर आऊँ तो खराईया साथे चलूँआ।</para>
  <para style="q" vid="PSA 26:11">तूँ माखे छुड़ाई लओ ओर मां पाँदे दया कर।<verse eid="PSA 26:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 26:12" />आऊँ सबी खतरेया ते बचेया दा ए,</para>
  <para style="q" vid="PSA 26:12">मां पग्ता रिया सभा रे प्रभुए री स्तुति करनी।<verse eid="PSA 26:12" /></para>
  <chapter eid="PSA 26" />
  <chapter number="27" style="c" sid="PSA 27" />
  <para style="s">परमेशरो री जोति मेरा उद्धार</para>
  <para style="d">दाऊदो रा पजन</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 27:1" />यहोवा मेरी जोति ए जो माखे बचाओई।</para>
  <para style="q" vid="PSA 27:1">आऊँ केसी ते नि डरदा।</para>
  <para style="q" vid="PSA 27:1">यहोवा मेरी रखवाल़ी आपू करोआ ओर आऊँ कदी बी चिन्ता नि करदा।<verse eid="PSA 27:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 27:2" />जेबे बुराई करने वाल़े मां पाँदे अमला करने खे मेरे नेड़े आओए,</para>
  <para style="q" vid="PSA 27:2">तेबे सेयो ठोकर खाई की थाले रूड़ी जाओए।<verse eid="PSA 27:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 27:3" />चाए सेना बी मेरे खलाफ माखे केरा पाई लओ,</para>
  <para style="q" vid="PSA 27:3">तेबे बी मां नि डरना; चाए मेरे खलाफ युद्ध छिड़ी जाओ,</para>
  <para style="q" vid="PSA 27:3">तेबे बी मेरा परोसा यहोवे पाँदे अटल ए।<verse eid="PSA 27:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 27:4" />मैं सिर्फ एक ई बरदान प्रभुए ते मांगी राखेया,</para>
  <para style="q" vid="PSA 27:4">मां तेतेरे ई जत्नो रे लगेया रा रणा,</para>
  <para style="q" vid="PSA 27:4">ताकि आऊँ पूरी जिन्दगी प्रभुए रे मईलो रे रई सकूँ ओर प्रभुए री सुन्दरता खे देखी सकूँ</para>
  <para style="q" vid="PSA 27:4">ओर तेसरे मईलो रे दर्शण करुँ।<note caller="+" style="f"><char style="fr" closed="false">27:4 </char><char style="ft" closed="false">पजन 6:8, पजन 23:6, फिलि. 3:13</char></note><verse eid="PSA 27:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 27:5" />प्रभुए मुसीबता रे बखते आऊँ आपणे</para>
  <para style="q" vid="PSA 27:5">मण्डपो रे लकोई देणा;</para>
  <para style="q" vid="PSA 27:5">तेस माखे आपणे तम्बूए रे पीतरे आसरा देणा</para>
  <para style="q" vid="PSA 27:5">ओर तेस आँऊ सुरक्षित जगा दे राखणा।<verse eid="PSA 27:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 27:6" />एबे मेरा सिर मेरे चऊँ कनारलेया दुश्मणा ते ऊच्चा ऊणा</para>
  <para style="q" vid="PSA 27:6">ओर मां प्रभुए रे तम्बूए रे जयजयकारा साथे बलिदान चढ़ाणा</para>
  <para style="q" vid="PSA 27:6">ओर तेसरा पजन गाणा।<verse eid="PSA 27:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 27:7" />ओ प्रभु, जेबे आँऊ ताखे आका पाऊँ तेबे मेरी पुकार सुणी लओ,</para>
  <para style="q" vid="PSA 27:7">तूँ मां पाँदे दया कर ओर माखे उत्तर दे।<note caller="+" style="f"><char style="fr" closed="false">27:7 </char><char style="ft" closed="false">पजन 130:2-4, पजन 13:3</char></note><verse eid="PSA 27:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 27:8" />जेबे तैं बोलेया, “आओ मेरी आराधना कर।”</para>
  <para style="q" vid="PSA 27:8">तेबे मैं ज्वाब दित्तेया, “मां आऊणा, प्रभु।”<verse eid="PSA 27:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 27:9" />आऊँ तेरा दास ए; मांते नराज नि ऊणा ओर ना मांते दूर ऊणा।</para>
  <para style="q" vid="PSA 27:9">तैं हमेशा मेरी मताद करी राखी ए।</para>
  <para style="q" vid="PSA 27:9">तूँ मेरा सेई परमेशर ए जिने आऊँ बचाई राखेया,</para>
  <para style="q" vid="PSA 27:9">इजी री खातर एबु माखे नि छाड।<verse eid="PSA 27:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 27:10" />मेरे माये-बाओए तो आऊँ छाडीता रा,</para>
  <para style="q" vid="PSA 27:10">पर प्रभुए आऊँ सम्बाल़ी लणा।<verse eid="PSA 27:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 27:11" />माखे सखा, ओ प्रभु, कि तूँ क्या चाएआ कि आऊँ करुँ,</para>
  <para style="q" vid="PSA 27:11">ओर माखे एक सुरक्षित बाटा दे लई चल, कऊँकि मेरे बऊत दुश्मण ए।<note caller="+" style="f"><char style="fr" closed="false">27:11 </char><char style="ft" closed="false">पजन 5:8</char></note><verse eid="PSA 27:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 27:12" />माखे मेरे सताणे वाल़ेया री इच्छा पाँदे नि छाड,</para>
  <para style="q" vid="PSA 27:12">कऊँकि चूठे गवा, जो मेरे खलाफ खड़ी रे;</para>
  <para style="q" vid="PSA 27:12">सेयो चगड़ा करने रिया धुना रे ए।<verse eid="PSA 27:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 27:13" />पर आऊँ जाणूंआ कऊँकि आऊँ तां पाँदे परोसा करूँआ, जदुओ तक आऊँ जिऊँदा ए तूँ माखे पला ए।<note caller="+" style="f"><char style="fr" closed="false">27:13 </char><char style="ft" closed="false">पजन 142:5</char></note><verse eid="PSA 27:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 27:14" />प्रभुए खे न्याल़दा रओ;</para>
  <para style="q" vid="PSA 27:14">ईम्मत राख ओर तेरा दिल मजबूत रओ;</para>
  <para style="q" vid="PSA 27:14">जरूर, प्रभुए खे न्याल़दा रओ।<note caller="+" style="f"><char style="fr" closed="false">27:14 </char><char style="ft" closed="false">पजन 31:24</char></note><verse eid="PSA 27:14" /></para>
  <chapter eid="PSA 27" />
  <chapter number="28" style="c" sid="PSA 28" />
  <para style="s">मतादा रिया तँईं प्रार्थना</para>
  <para style="d">दाऊदो रा पजन</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 28:1" />ओ प्रभु, चट्टानी जेड़ा मेरी रक्षा करने वाल़े, आऊँ ताखे ई आका पाऊँआ।</para>
  <para style="q" vid="PSA 28:1">मेरिया आका सुणी लओ!</para>
  <para style="q" vid="PSA 28:1">जे तूँ मेरिया आका रा ज्वाब नि देगा तो छोड़ ई आऊँ तिना साथे मिली जाणा जो आपणियां कब्रा दे ए।<verse eid="PSA 28:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 28:2" />जेबे आऊँ मतादा रिया तँईं ताखे आका पाऊँ</para>
  <para style="q" vid="PSA 28:2">ओर आँऊ तेरी परम पवित्र जगा री पीतरली कोठरिया री</para>
  <para style="q" vid="PSA 28:2">तरफा खे आपणे आथ फैलाऊँ,</para>
  <para style="q" vid="PSA 28:2">तेबे मेरी बिनती सुणी लया।<verse eid="PSA 28:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 28:3" />तिना बुरे काम करने वाल़ेया ओर कुकर्मी लोका साथे माखे दोषी नि ठरा,</para>
  <para style="q" vid="PSA 28:3">जो आपणे पड़ोसिया साथे गल्ला तो शान्तिया रिया करोए;</para>
  <para style="q" vid="PSA 28:3">पर आपणे दिलो रे बुराई राखोए।<verse eid="PSA 28:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 28:4" />तिने लोके जो कुछ बी करी राखेया तिजी रे जरिए तिना खे सजा दे</para>
  <para style="q" vid="PSA 28:4">तिना खे तिना रे बुरे कामा रिया तँईं सजा दे।<note caller="+" style="f"><char style="fr" closed="false">28:4 </char><char style="ft" closed="false">मत्ती 16:27, प्रकाशित 18:6,13, प्रकाशित 22:12</char></note><verse eid="PSA 28:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 28:5" />सेयो दुष्ट लोक प्रभुए रे कामा पाँदे</para>
  <para style="q" vid="PSA 28:5">ओर तेसरे आथो रे कामा पाँदे त्यान नि करदे,</para>
  <para style="q" vid="PSA 28:5">इजी री खातर तेस तिना खे सजा देणी ओर सेयो सदा खे नाश करी देणे।<verse eid="PSA 28:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 28:6" />प्रभु तन्य ए,</para>
  <para style="q" vid="PSA 28:6">कऊँकि तिने मेरी बिनती सुणी।<verse eid="PSA 28:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 28:7" />प्रभु मेरी तागत ए ओर ढाला जेड़ा मेरी रक्षा करोआ;</para>
  <para style="q" vid="PSA 28:7">तेस पाँदे परोसा राखणे ते मेरे मनो खे मताद मिली री,</para>
  <para style="q" vid="PSA 28:7">इजी री खातर मेरा मन खुश ए</para>
  <para style="q" vid="PSA 28:7">ओर मां गाणा गायी की तेसरा तन्यवाद करना।<verse eid="PSA 28:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 28:8" />प्रभु आपणी प्रजा रे लोका री तागत ए,</para>
  <para style="q" vid="PSA 28:8">से आपणे अभिषिक्त राजे रिया तँईं उद्धारो जेड़ा ए।<verse eid="PSA 28:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 28:9" />ओ प्रभु, आपणे लोका रा उद्धार कर</para>
  <para style="q" vid="PSA 28:9">ओर आपणे निज इस्से रे लोका खे आशीष दे</para>
  <para style="q" vid="PSA 28:9">ओर एक चराणे वाल़े जेड़ा आपणे लोका खे सम्बाल़ी की राख।<verse eid="PSA 28:9" /></para>
  <chapter eid="PSA 28" />
  <chapter number="29" style="c" sid="PSA 29" />
  <para style="s">तूफानो दे परमेशरो री आवाज</para>
  <para style="d">दाऊदो रा पजन</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 29:1" />ओ परमेशरो रे पाऊए,<note caller="+" style="f"><char style="fr" closed="false">29:1 </char><char style="ft" closed="false">स्वर्गदूतो</char></note> परमेशरो रा,</para>
  <para style="q" vid="PSA 29:1">आ प्रभुए रा ई गुणगाण करो,</para>
  <para style="q" vid="PSA 29:1">तुसे प्रभुए री महिमा ओर सामर्था री सराईणा करो।<verse eid="PSA 29:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 29:2" />तुसे प्रभुए रे नाओं री महिमा करो;</para>
  <para style="q" vid="PSA 29:2">पवित्रता साथे सजी की प्रभुए री आराधना करो।<verse eid="PSA 29:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 29:3" />प्रभुए री वाणी समुद्रो पाँदे सुणोई;</para>
  <para style="q" vid="PSA 29:3">प्रतापी परमेशर गरजोआ,</para>
  <para style="q" vid="PSA 29:3">प्रभु समुद्रो पाँदे रओआ।<note caller="+" style="f"><char style="fr" closed="false">29:3 </char><char style="ft" closed="false">अय्यू. 37:4,5</char></note><verse eid="PSA 29:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 29:4" />प्रभुए री वाणी शक्तिशाली ए,</para>
  <para style="q" vid="PSA 29:4">प्रभुए री वाणी प्रतापमयी ए।<verse eid="PSA 29:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 29:5" />प्रभुए री वाणी देवदारा रे डाल़ा खे तोड़ी देओई;</para>
  <para style="q" vid="PSA 29:5">प्रभु लबानोनो रे देवदारा खे बी नाश करी देओआ।<verse eid="PSA 29:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 29:6" />यहोवे रिया तागती ते लबानोनो रा पाह्ड़ बी बाच्छूए जेड़ा पुड़कोआ,</para>
  <para style="q" vid="PSA 29:6">ओर सिर्योन पाह्ड़ बणो रे सांडो जेड़ा उटकोआ।<verse eid="PSA 29:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 29:7" />प्रभुए री वाणी आगी री लूपिया खे चीरोई।<verse eid="PSA 29:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 29:8" />प्रभुए री वाणी बणा खे ईलाई देओई,</para>
  <para style="q" vid="PSA 29:8">प्रभु कादेशो रे बणो खे बी ईलाई देओआ।<verse eid="PSA 29:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 29:9" />प्रभुए री वाणिया ते ईरणियां रे बखतो ते पईले बच्चे ऊई जाओए</para>
  <para style="q" vid="PSA 29:9">ओर जंगल़ो रे पतझड़ ऊई जाओआ</para>
  <para style="q" vid="PSA 29:9">ओर तेसरे मईलो रे सब कोई बोलोए, “प्रभुए री महिमा ओ!”<verse eid="PSA 29:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 29:10" />जलप्रलय रे बखते प्रभु विराजमान था</para>
  <para style="q" vid="PSA 29:10">ओर प्रभु सदा खे राजा बणी की विराजमान रओआ।<note caller="+" style="f"><char style="fr" closed="false">29:10 </char><char style="ft" closed="false">हमेशा खे नियम</char></note><verse eid="PSA 29:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 29:11" />प्रभुए आपणी प्रजा खे तागत देणी;</para>
  <para style="q" vid="PSA 29:11">प्रभुए आपणी प्रजा खे शान्तिया री आशीष देणी।<verse eid="PSA 29:11" /></para>
  <chapter eid="PSA 29" />
  <chapter number="30" style="c" sid="PSA 30" />
  <para style="s">तन्यवादो री प्रार्थना</para>
  <para style="d">मईलो री प्रतिष्ठा रिया तँईं दाऊदो रा पजन</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 30:1" />ओ प्रभु, मां तेरी सराईणा करनी,</para>
  <para style="q" vid="PSA 30:1">कऊँकि तैं आऊँ गईराईया ते खींजी की ऊबे निकयाल़ी राखेया</para>
  <para style="q" vid="PSA 30:1">ओर मेरे दुश्मणा खे मां पाँदे खुशी नि मनाणे दित्ती।<verse eid="PSA 30:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 30:2" />ओ मेरे प्रभु परमेशर,</para>
  <para style="q" vid="PSA 30:2">आऊँ तेरिया मतादा रिया तँईं रोया ओर तैं आऊँ तन्दरूस्त करिता।<verse eid="PSA 30:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 30:3" />ओ प्रभु, जेबे आऊँ मरने ई वाल़ा था तो तैं आऊँ बचाई ला।</para>
  <para style="q" vid="PSA 30:3">आऊँ लगभग मरी गया था, पर तैं माखे ठीक ऊणे दे मताद कित्ती।<verse eid="PSA 30:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 30:4" />ओ प्रभुए रे पग्तो,</para>
  <para style="q" vid="PSA 30:4">प्रभुए रा पजन गाओ</para>
  <para style="q" vid="PSA 30:4">ओर तेसरे पले कामा खे याद करदे ऊए तेसरे पवित्र नाओं रा तन्यवाद करो।<verse eid="PSA 30:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 30:5" />यहोवे रा गुस्सा तो थोड़ी जी देरा रा ओआ,</para>
  <para style="q" vid="PSA 30:5">पर तेसरी दया जिन्दगी परो री ओई।</para>
  <para style="q" vid="PSA 30:5">जे कदी राती रोणा पड़ो,</para>
  <para style="q" vid="PSA 30:5">पर प्यागा खुशी मिलणी।<verse eid="PSA 30:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 30:6" />जेबे माखे कोई बी परेशानी नि ऊई थी, तो मैं आपू बोलेया था, “कोई बी माखे अराई नि सकदा।”<verse eid="PSA 30:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 30:7" />ओ यहोवा, तूँ आपणी खुशिया ते मेरिया तँईं पला था, तैं आऊँ ऊच्चे पाह्ड़ो जेड़ा सुरक्षित राखेया;</para>
  <para style="q" vid="PSA 30:7">जेबे तैं मांते आपणे आपू खे लकोया,</para>
  <para style="q" vid="PSA 30:7">तेबे आऊँ डरीगा।<verse eid="PSA 30:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 30:8" />ओ प्रभु, मैं ताखे ई आका पाईया</para>
  <para style="q" vid="PSA 30:8">ओर प्रभुए तेई गिड़गिड़ाई की ये बिनती कित्ती,<verse eid="PSA 30:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 30:9" />“जेबे आऊँ कब्रा रे चली जाणा,</para>
  <para style="q" vid="PSA 30:9">तेबे मेरिया मौता ते क्या फायदा ऊणा?</para>
  <para style="q" vid="PSA 30:9">क्या मरेया रा माणूं तेरा तन्यवाद करी सकोआ?</para>
  <para style="q" vid="PSA 30:9">क्या आँऊ फेर तेरी सच्चाईया रा तन्यवाद करी सकूँआ?”<verse eid="PSA 30:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 30:10" />ओ प्रभु, सुण, मां पाँदे दया कर;</para>
  <para style="q" vid="PSA 30:10">ओ प्रभु, तूँ मेरी मताद कर।<verse eid="PSA 30:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 30:11" />तैं मेरा दु:ख खुशिया रे बदली ता;</para>
  <para style="q" vid="PSA 30:11">तैं मेरे दु:ख दूर करीते ओर मेरे चऊँ कनारे खुशिया ई खुशिया देईतिया।<verse eid="PSA 30:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 30:12" />ताकि मेरी आत्मा तेरा पजन गांदी रओ</para>
  <para style="q" vid="PSA 30:12">ओर कदी चुप नि रओ।</para>
  <para style="q" vid="PSA 30:12">ओ मेरे प्रभु परमेशर,</para>
  <para style="q" vid="PSA 30:12">मां सदा तेरा तन्यवाद करदे रणा।<verse eid="PSA 30:12" /></para>
  <chapter eid="PSA 30" />
  <chapter number="31" style="c" sid="PSA 31" />
  <para style="s">परमेशरो पाँदे परोसे री प्रार्थना</para>
  <para style="d">बजाणे वाल़े परदानो रिया तँईं दाऊदो रा पजन</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 31:1" />ओ यहोवा, मेरा परोसा तां पाँदे ए;</para>
  <para style="q" vid="PSA 31:1">माखे कदी शर्मिंदा नि ऊणे देणा;</para>
  <para style="q" vid="PSA 31:1">आपणी तार्मिकता रे जरिए माखे बचाई लओ।<verse eid="PSA 31:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 31:2" />ओ यहोवा, आपणा त्यान मेरिया तरफा खे लगाई की</para>
  <para style="q" vid="PSA 31:2">फटाफट माखे छुड़ाई लओ।<note caller="+" style="f"><char style="fr" closed="false">31:2 </char><char style="ft" closed="false">पजन 102:2</char></note><verse eid="PSA 31:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 31:3" />कऊँकि तूँ मेरिया तँईं चट्टान ओर गढ़ो जेड़ा ए;</para>
  <para style="q" vid="PSA 31:3">इजी री खातर आपणे नाओं रिया तँईं माखे सई बाट दखा</para>
  <para style="q" vid="PSA 31:3">ओर माखे आगे लई चल।<verse eid="PSA 31:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 31:4" />तूँ ई ए जो माखे सम्बाल़ोआ,</para>
  <para style="q" vid="PSA 31:4">माखे तेस जाल़ो ते बचा जो मेरेया दुश्मणे मेरिया तँईं बछाई राखेया,<verse eid="PSA 31:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 31:5" />आँऊ आपणा जीवन तेरे ई आथो रे सम्बाल़ी देऊँआ;</para>
  <para style="q" vid="PSA 31:5">ओ प्रभु, ओ सच्चे परमेशर,</para>
  <para style="q" vid="PSA 31:5">तैं आऊँ मोले लई की आजाद करी राखेया।<note caller="+" style="f"><char style="fr" closed="false">31:5 </char><char style="ft" closed="false">लूक 23:46, प्रेरित 7:59, 1 पत 4:19</char></note><verse eid="PSA 31:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 31:6" />जो बेकार मूर्तिया पाँदे मन लगाओए,</para>
  <para style="q" vid="PSA 31:6">तिना ते आऊँ कृणा करूँआ,</para>
  <para style="q" vid="PSA 31:6">पर प्रभु, आँऊ तां पाँदे परोसा राखूँआ।<note caller="+" style="f"><char style="fr" closed="false">31:6 </char><char style="ft" closed="false">पजन 24:4</char></note><verse eid="PSA 31:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 31:7" />आऊँ तेरी करूणा ते मगन ओर खुश ए,</para>
  <para style="q" vid="PSA 31:7">कऊँकि तैं मेरे दु:ख देखे,</para>
  <para style="q" vid="PSA 31:7">मेरी मुसीबता रे बखते तैं मेरी सम्बाल़ लई।<verse eid="PSA 31:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 31:8" />तैं आऊँ दुश्मणा रे आथो रे पड़ने नि दित्तेया;</para>
  <para style="q" vid="PSA 31:8">पर तैं आँऊ खतरे ते बचाई राखेया।<verse eid="PSA 31:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 31:9" />ओ प्रभु, मां पाँदे दया कर, कऊँकि आऊँ मुसीबता रे ए;</para>
  <para style="q" vid="PSA 31:9">मेरिया आखी बऊत रोणे रिया बजा ते कमजोर ऊई गी रिया;</para>
  <para style="q" vid="PSA 31:9">मेरा प्राण ओर शरीर बी सुकी गा रा।<verse eid="PSA 31:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 31:10" />मेरी जिन्दगी पापो रिया बजा ते</para>
  <para style="q" vid="PSA 31:10">ओर मेरी उम्र कणदे-कणदे कटणे लगी री,</para>
  <para style="q" vid="PSA 31:10">मुसीबता रिया बजा ते मेरी तागत कटदी गई</para>
  <para style="q" vid="PSA 31:10">ओर मेरिया आड्डिया दिशणे लगिया।<verse eid="PSA 31:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 31:11" />आपणे सारे बरोदिया रिया बजा ते मेरे पड़ोसिया सामणे मेरी बेज्जती ऊई री;</para>
  <para style="q" vid="PSA 31:11">आपणे जाण-पछयाण वाल़ेया खे आऊँ डरो री बजा बणीगा,</para>
  <para style="q" vid="PSA 31:11">जो माखे सड़का रे देखोए, सेयो तेबुई मांते दूर नठी जाओए।<verse eid="PSA 31:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 31:12" />लोक माखे पूली चूकी रे, जिंयाँ सेयो तिना लोका खे पूली जाओए जो मरी गे रे ए।</para>
  <para style="q" vid="PSA 31:12">सेयो माखे टूटे रे पांडे जेड़ा बेकार समजोए।<verse eid="PSA 31:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 31:13" />मैं बऊत जणेया रे मुंए ते आपणी निंदा सुणी,</para>
  <para style="q" vid="PSA 31:13">चऊँ कनारे डर ई डर ए!</para>
  <para style="q" vid="PSA 31:13">जेबे तिने मेरे खलाफ आपू बीचे सम्मति करी की</para>
  <para style="q" vid="PSA 31:13">मेरे प्राण लणे री साजिश कित्ती।<verse eid="PSA 31:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 31:14" />पर ओ प्रभु, मैं तो तां ई पाँदे परोसा राखी राखेया,</para>
  <para style="q" vid="PSA 31:14">मैं बोलेया, “तूँई मेरा परमेशर ए।”<verse eid="PSA 31:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 31:15" />मेरी जिन्दगी तेरे आथो रे ए;</para>
  <para style="q" vid="PSA 31:15">माखे मेरे दुश्मणा ते ओर मेरे सताणे वाल़ेया ते छुड़ा।<verse eid="PSA 31:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 31:16" />मां पाँदे दया कर ओर माखे बचा</para>
  <para style="q" vid="PSA 31:16">कऊँकि तूँ हमेशा मांते बऊत प्यार करेया।<verse eid="PSA 31:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 31:17" />ओ प्रभु, माखे शर्मिंदा नि ऊणे दे</para>
  <para style="q" vid="PSA 31:17">कऊँकि मैं ताखे आका पाई राखिया;</para>
  <para style="q" vid="PSA 31:17">दुष्ट लोक शर्मिंदा ओ</para>
  <para style="q" vid="PSA 31:17">ओर सेयो चुपचाप पताल़ो रे पड़े रे रओ।<verse eid="PSA 31:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 31:18" />जो कमण्ड ओर बेज्जतिया साथे तर्मिया री निंदा करोए,</para>
  <para style="q" vid="PSA 31:18">तिना रे चूठ बोलणे वाल़े मूँ बंद कित्ते जाओ।<note caller="+" style="f"><char style="fr" closed="false">31:18 </char><char style="ft" closed="false">पजन 94:4, पजन 120:2</char></note><verse eid="PSA 31:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 31:19" />तैं आपणे पग्ता खे बऊत चीजा राखी रिया ए!</para>
  <para style="q" vid="PSA 31:19">हर कोई जाणोआ कि तूँ कितणा पला ए,</para>
  <para style="q" vid="PSA 31:19">तूँ तिना लोका री रक्षा करेया जो तां पाँदे परोसा करोए।<verse eid="PSA 31:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 31:20" />तूँ तिना खे आपणी मौजुदगिया री छाया रे माणूंआ री</para>
  <para style="q" vid="PSA 31:20">साजिशा ते लकोई राखेया;</para>
  <para style="q" vid="PSA 31:20">तां सेयो आपणे मण्डपो रे चगड़ेया ते लकोई की राखणे।<verse eid="PSA 31:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PSA 31:21" />ओ यहोवा, आऊँ तेरी महिमा करूँआ,</para>
  <para style="q" vid="PSA 31:21">कऊँकि तैं मां पाँदे दया कित्ती जेबे दुश्मणे आऊँ चऊँ कनारा ते केरी राखेया था।<verse eid="PSA 31:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="PSA 31:22" />मैं तो कबराई की बोलेया था, “आऊँ प्रभुए री नजरा ते दूर ऊईगा।”</para>
  <para style="q" vid="PSA 31:22">पर तैं मेरिया आका प्रार्थना सुणी लईया,</para>
  <para style="q" vid="PSA 31:22">जेबे मैं से मतादा रिया तँईं बुलाया।<verse eid="PSA 31:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="PSA 31:23" />ओ प्रभुए रे सारे पग्तो, तेस साथे प्यार राखो!</para>
  <para style="q" vid="PSA 31:23">प्रभु सच्चे लोका री रक्षा तो करोआ,</para>
  <para style="q" vid="PSA 31:23">पर जो कमण्ड करोआ,</para>
  <para style="q" vid="PSA 31:23">तेसखे से ठीक-टंगो रे बदला देओआ।<note caller="+" style="f"><char style="fr" closed="false">31:23 </char><char style="ft" closed="false">पजन 97:10</char></note><verse eid="PSA 31:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="PSA 31:24" />ओ प्रभुए पाँदे उम्मीद राखणे वाल़ेयो,</para>
  <para style="q" vid="PSA 31:24">ईम्मत राखो ओर बऊत मजबूत रओ।<note caller="+" style="f"><char style="fr" closed="false">31:24 </char><char style="ft" closed="false">1 कुरिन्थ 16:13</char></note><verse eid="PSA 31:24" /></para>
  <chapter eid="PSA 31" />
  <chapter number="32" style="c" sid="PSA 32" />
  <para style="s">माफी पाणे री आशीष</para>
  <para style="d">दाऊदो रा पजन मश्कील</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 32:1" />से माणूं बऊत ई तन्य ए</para>
  <para style="q" vid="PSA 32:1">जेसरा पाप यहोवे माफ कित्तेया</para>
  <para style="q" vid="PSA 32:1">ओर तेसरा पाप मिटाईता रा ओ।<note caller="+" style="f"><char style="fr" closed="false">32:1 </char><char style="ft" closed="false">रोमी 4:7</char></note><verse eid="PSA 32:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 32:2" />से माणूं बऊत ई तन्य ए,</para>
  <para style="q" vid="PSA 32:2">जेस पाँदे प्रभु गल़त काम करने रा दोष नि लगांदा ओ</para>
  <para style="q" vid="PSA 32:2">ओर जो सबी छल-कपटो ते छुटीगा ओ।<note caller="+" style="f"><char style="fr" closed="false">32:2 </char><char style="ft" closed="false">रोमी 4:8</char></note><verse eid="PSA 32:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 32:3" />जदुए तक मैं आपणा पाप मानी नि लया,</para>
  <para style="q" vid="PSA 32:3">तदुए तक मेरा शरीर बऊत कमजोर ओर बमार ऊईगा, ओर आऊँ सारा दिन कणदा रया।<verse eid="PSA 32:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 32:4" />ओ यहोवा, तूँ माखे रात-दिन सजा देयो था, मेरी तागत ईंयाँ खत्म ऊई जिंयाँ गर्मिया दे सूका पड़ोआ। सेला<verse eid="PSA 32:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 32:5" />जेबे मैं आपणा पाप तेरे सामणे मानेया</para>
  <para style="q" vid="PSA 32:5">ओर आपणे बुरे काम नि छुपाए ओर बोलेया, “मां आपणे पाप प्रभुए रे सामणे मानी लणे,”</para>
  <para style="q" vid="PSA 32:5">तेबे तैं मेरे बुरे काम ओर पाप माफ करीते।<note caller="+" style="f"><char style="fr" closed="false">32:5 </char><char style="ft" closed="false">1 यूह. 1:9</char></note> सेला<verse eid="PSA 32:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 32:6" />इजी बजा ते हर एक पग्त तांते एड़े बखते प्रार्थना करो</para>
  <para style="q" vid="PSA 32:6">जेबे कि तूँ मिली सकेया।</para>
  <para style="q" vid="PSA 32:6">पक्का जेबे पाणिए री बड़ी बाढ़ आऊणी तेबे बी तेस पग्तो गे नि पऊँचणी।<verse eid="PSA 32:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 32:7" />तूँ मेरा आसरा लणे री जगा ए;</para>
  <para style="q" vid="PSA 32:7">आऊँ तेरे उद्धारो रा गाणा जोरे की गाऊँआं, कऊँकि तूँ मेरी रक्षा करेया। सेला<verse eid="PSA 32:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 32:8" />प्रभु ये बोलोआ, “मां ताखे अक्ल देणी</para>
  <para style="q" vid="PSA 32:8">ओर जेते बाटा रे तां चलणा ओगा तिदे मां ताखे सला देणी;</para>
  <para style="q" vid="PSA 32:8">मां तां पाँदे आपणी नजर लगाई री राखणी।”<verse eid="PSA 32:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 32:9" />इजी री खातर तुसे कोड़े ओर खच्चरा जेड़े नि बणो जिना खे समज नि ऊँदी,</para>
  <para style="q" vid="PSA 32:9">तिना रा जोश रास ओर लगामा साथे रोकणा पड़ोआ,</para>
  <para style="q" vid="PSA 32:9">नई तो सेयो तेरे वशो रे नि आऊणे।<verse eid="PSA 32:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 32:10" />दुष्ट माणूंआ खे तो बऊत तकलीफ ऊणी;</para>
  <para style="q" vid="PSA 32:10">पर जो प्रभुए पाँदे परोसा राखोआ से करूणा ते केरेया रा रणा।<verse eid="PSA 32:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 32:11" />ओ तर्मियो, प्रभुए रे कामा ते खुश ओर मगन रओ</para>
  <para style="q" vid="PSA 32:11">ओर ओ सारे सीदे मनो वाल़ेयो खुशिया साथे जयजयकार करो!<verse eid="PSA 32:11" /></para>
  <chapter eid="PSA 32" />
  <chapter number="33" style="c" sid="PSA 33" />
  <para style="s">परमेशरो री स्तुतिया रा गाणा</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 33:1" />ओ तर्मियो, प्रभुए दे खुश रओ,</para>
  <para style="q" vid="PSA 33:1">स्तुति करना तर्मी लोका खे शोभा देओआ।<verse eid="PSA 33:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 33:2" />बीणा बजाई-बजाई की प्रभुए रा तन्यवाद करो,</para>
  <para style="q" vid="PSA 33:2">दस तारा वाल़ी सारंगी बजाई-बजाई की प्रभुए रा पजन गाओ।<note caller="+" style="f"><char style="fr" closed="false">33:2 </char><char style="ft" closed="false">इफिसि 5:19</char></note><verse eid="PSA 33:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 33:3" />यहोवे रिया तँईं नया गाणा गाओ,</para>
  <para style="q" vid="PSA 33:3">जयजयकार करदे ऊए ठीक-टंगो रे बाजे बजाओ।<note caller="+" style="f"><char style="fr" closed="false">33:3 </char><char style="ft" closed="false">प्रकाशित 14:3</char></note><verse eid="PSA 33:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 33:4" />कऊँकि प्रभुए रा वचन सच्चा ए</para>
  <para style="q" vid="PSA 33:4">ओर तेसरे हर काम सच्चाईया साथे पूरे ओए।<verse eid="PSA 33:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 33:5" />से तार्मिकता ओर न्याय साथे प्यार राखोआ;</para>
  <para style="q" vid="PSA 33:5">प्रभुए री करूणा साथे तरती परी री ए।<verse eid="PSA 33:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 33:6" />प्रभुए आपणियां आज्ञा ते सर्ग बणाया।</para>
  <para style="q" vid="PSA 33:6">सूरज, चाँद ओर तारे आपणे शब्दा रे जरिए बणाए।<note caller="+" style="f"><char style="fr" closed="false">33:6 </char><char style="ft" closed="false">इब्रानी 11:3</char></note><verse eid="PSA 33:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 33:7" />प्रभु समुद्रो रा पाणी एकी जगा कट्ठा करोआ मानो केसी पांडे रे कट्ठा करी राखेया,</para>
  <para style="q" vid="PSA 33:7">ओर से डूगे समुद्रो खे आपणे पण्डारो रे राखोआ।<verse eid="PSA 33:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 33:8" />सारी तरतिया रे लोक प्रभुए री आराधना करो,</para>
  <para style="q" vid="PSA 33:8">दुनिया रे सब रणे वाल़े तेसरा आदर करो!<verse eid="PSA 33:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 33:9" />कऊँकि जेबे परमेशरे बोलेया, तेबे दुनिया बणीगी थी;</para>
  <para style="q" vid="PSA 33:9">जेबे तिने आज्ञा दित्ती, तेबे सब कुछ दिशणे लगेया।<verse eid="PSA 33:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 33:10" />प्रभु जातिया-जातिया री सलाई खे बेकार करी देओआ;</para>
  <para style="q" vid="PSA 33:10">से देशो-देशो रे लोका री इच्छा खे निष्फल करी देओआ।<verse eid="PSA 33:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 33:11" />प्रभुए री योजना जुगो-जुगो तक बणी री रणी;</para>
  <para style="q" vid="PSA 33:11">तेसरे मनो रे बचार पीढ़िया ते पीढ़िया तक बणे रे रणे।<verse eid="PSA 33:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 33:12" />से देश बऊत ई तन्य ए</para>
  <para style="q" vid="PSA 33:12">जेसरा परमेशर प्रभु ए ओर सेयो लोक,</para>
  <para style="q" vid="PSA 33:12">जो प्रभुए आपणी जायदात ऊणे खे चूणी ले रे!<verse eid="PSA 33:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 33:13" />प्रभु स्वर्गो ते देखोआ,</para>
  <para style="q" vid="PSA 33:13">से सबी माणूंआ खे देखदा रओआ;<verse eid="PSA 33:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 33:14" />से तेसा जगा ते जेती से सिंहासणो पाँदे बैठेया राए,</para>
  <para style="q" vid="PSA 33:14">तरतिया पाँदे रणे वाल़ेया सबी खे देखदा रओआ,<verse eid="PSA 33:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 33:15" />सेई तिना सबी रे दिला खे जाणोआ</para>
  <para style="q" vid="PSA 33:15">ओर तिना रे सबी कामा री जाँच-पड़ताल़ करोआ।<verse eid="PSA 33:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 33:16" />राजे री जीत तेसरी बऊत सारी सेना ते नि ऊई सकदा;</para>
  <para style="q" vid="PSA 33:16">वीर मर्दो री विजय तेसरी आपणी बड़ी शक्तिया ते नि ऊँदी।<verse eid="PSA 33:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 33:17" />युद्धो रे जीतणे रिया तँईं कोड़ेया पाँदे परोसा करना बेकार ए,</para>
  <para style="q" vid="PSA 33:17">से आपणी बऊत तागत ऊणे रिया बजा ते केसी खे बचाई नि सकदा।<verse eid="PSA 33:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 33:18" />देखो, प्रभु आपणे पग्ता पाँदे नजर राखोआ जो तेसरी आज्ञा खे मानोए</para>
  <para style="q" vid="PSA 33:18">ओर तिना पाँदे जो तेसरी करूणा री उम्मीद राखोए,<verse eid="PSA 33:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 33:19" />ताकि से तिना रे प्राण मौता ते बचाओ,</para>
  <para style="q" vid="PSA 33:19">ओर अकाल़ो रे बखते तिना खे जिऊँदा राखो।<verse eid="PSA 33:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 33:20" />आसे आपणी उम्मीद प्रभुए पाँदे लगाई राखी;</para>
  <para style="q" vid="PSA 33:20">सेई म्हारा रक्षक ए ओर म्हारी मताद करोआ।<verse eid="PSA 33:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PSA 33:21" />म्हारा मन यहोवे रिया बजा ते खुश ऊणा,</para>
  <para style="q" vid="PSA 33:21">कऊँकि आसे तेसरे पवित्र नाओं पाँदे परोसा राखी राखेया।<verse eid="PSA 33:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="PSA 33:22" />ओ प्रभु, जिंयाँ तां पाँदे म्हारी उम्मीद ए,</para>
  <para style="q" vid="PSA 33:22">तिंयाँ ई तेरी करूणा आसा पाँदे ओ।<verse eid="PSA 33:22" /></para>
  <chapter eid="PSA 33" />
  <chapter number="34" style="c" sid="PSA 34" />
  <para style="s">परमेशरो रिया पलाईया रिया तँईं तेसरी स्तुति</para>
  <para style="d">दाऊदो रा पजन, जेबे से अबीमेलेको रे सामणे इस्सालो जेड़ा बणेया ओर अबीमेलेके से निकयाल़ी ता ओर से चलीगा</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 34:1" />मां हर बखत प्रभुए खे तन्यवाद बोलेया करना;</para>
  <para style="q" vid="PSA 34:1">तेसरी स्तुति लगातार मेरे मुंए ते ऊँदी रणी।<verse eid="PSA 34:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 34:2" />मां यहोवे रे कामा रिया तँईं तेसरी स्तुति करनी;</para>
  <para style="q" vid="PSA 34:2">ताकि सीदे लोक ये सुणी की खुश ओ।<verse eid="PSA 34:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 34:3" />मां साथे प्रभुए री तारीफ करो ओर आओ,</para>
  <para style="q" vid="PSA 34:3">आसे मिली की तेसरे नाओं री स्तुति करूँए!<verse eid="PSA 34:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 34:4" />मैं परमेशर यहोवे ते प्रार्थना कित्ती, तेबे तिने मेरी सुणी ली</para>
  <para style="q" vid="PSA 34:4">ओर तिने आऊँ मेरे सारे डरो ते छुड़ाईता।<verse eid="PSA 34:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 34:5" />जिने तेसरी तरफा खे देखेया तिने जोति पाई</para>
  <para style="q" vid="PSA 34:5">ओर सेयो कदी शर्मिंदा नि ऊए।<verse eid="PSA 34:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 34:6" />इने दु:खी माणूंए यहोवा पुकारेया तेबे तिने तेसरी प्रार्थना सुणी ली,</para>
  <para style="q" vid="PSA 34:6">ओर प्रभुए से तेसरी सारी मुसीबता ते छुड़ाई ला।<verse eid="PSA 34:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 34:7" />जो लोक प्रभुए री पग्ती करोए,</para>
  <para style="q" vid="PSA 34:7">तिना खे प्रभुए रा दूत चऊँ कनारे ते केरा पाई की तिना खे खतरेया ते बचाओआ।<note caller="+" style="f"><char style="fr" closed="false">34:7 </char><char style="ft" closed="false">इब्रानी 1:14, दानिय्येल 6:22</char></note><verse eid="PSA 34:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 34:8" />परखी की देखो कि प्रभु कितणा पला ए!</para>
  <para style="q" vid="PSA 34:8">से मर्द बऊत ई तन्य ए जो तेसरी शरण लओआ।<note caller="+" style="f"><char style="fr" closed="false">34:8 </char><char style="ft" closed="false">1 पत 2:3</char></note><verse eid="PSA 34:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 34:9" />ओ प्रभुए रे पवित्र लोको, प्रभुए ते डरो।</para>
  <para style="q" vid="PSA 34:9">जो लोक प्रभुए ते डरोए तिना खे किजी बी चीजा री कमी नि ऊँदी!<verse eid="PSA 34:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 34:10" />जवान शेरा खे तो कमी ऊई जाओई</para>
  <para style="q" vid="PSA 34:10">ओर सेयो पूखे बी रयी जाओए;</para>
  <para style="q" vid="PSA 34:10">पर जो लोक प्रभुए खे टोल़ोए तिना खे किजी बी खरिया चीजा री कमी नि ऊणी।<verse eid="PSA 34:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 34:11" />ओ बाल़को, आओ, मेरी गल्ल सुणो,</para>
  <para style="q" vid="PSA 34:11">मां तुसा खे प्रभुए री पग्ती करनी सिखाणी।<verse eid="PSA 34:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 34:12" />से कुण माणूं ए जो जिऊणे री इच्छा राखोआ</para>
  <para style="q" vid="PSA 34:12">ओर लाम्बी उम्र चाओआ ताकि पलाई देखी सको?<verse eid="PSA 34:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 34:13" />आपणी जीबा खे बुराई करने ते रोकी की राख</para>
  <para style="q" vid="PSA 34:13">ओर आपणे मुंए री चौकसी राख</para>
  <para style="q" vid="PSA 34:13">ताकि तिजी ते छल-कपटो री कोई गल्ल नि निकल़ो।<note caller="+" style="f"><char style="fr" closed="false">34:13 </char><char style="ft" closed="false">याकूब 1:26</char></note><verse eid="PSA 34:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 34:14" />बुराईया ते दूर रओ, ओर जो खरा ए सेई कर!</para>
  <para style="q" vid="PSA 34:14">हमेशा कड़ी मईणत कर ताकि लोक एकी-दूजे साथे शान्तिया दे रई सको।<note caller="+" style="f"><char style="fr" closed="false">34:14 </char><char style="ft" closed="false">इब्रानी 12:14</char></note><verse eid="PSA 34:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 34:15" />यहोवे रिया आखी तर्मिया पाँदे लगी री रओईया</para>
  <para style="q" vid="PSA 34:15">ओर तेसरे कान बी तेसरी बिनतिया रिया तरफा खे लगे रे रओए।<note caller="+" style="f"><char style="fr" closed="false">34:15 </char><char style="ft" closed="false">यूह. 9:31</char></note><verse eid="PSA 34:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 34:16" />पर यहोवा तिना लोका रे खलाफ ए जो बुरे काम करोए।</para>
  <para style="q" vid="PSA 34:16">ओर तिना रे मरने ते बाद, लोक तिना खे पुरिया तरआ ते पूली जाणे।<note caller="+" style="f"><char style="fr" closed="false">34:16 </char><char style="ft" closed="false">1 पत 3:10-12</char></note><verse eid="PSA 34:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 34:17" />जेबे तार्मिक माणूं दुहाई देओए तेबे प्रभु सुणोआ</para>
  <para style="q" vid="PSA 34:17">ओर तिना खे सबी मुसीबता ते बचाओआ।<verse eid="PSA 34:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 34:18" />प्रभु पश्चाताप करने वाल़ेया री सुणने ओर मताद करने रिया तँईं त्यार रओआ</para>
  <para style="q" vid="PSA 34:18">ओर दु:खी आत्मा वाल़े माणूंए खे बचाओआ।<verse eid="PSA 34:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 34:19" />तार्मिक माणूंए पाँदे बऊत सारिया मुसीबता तो पड़ोईया,</para>
  <para style="q" vid="PSA 34:19">तेबे बी प्रभु तेसखे तिना सबी ते बचाओआ।<note caller="+" style="f"><char style="fr" closed="false">34:19 </char><char style="ft" closed="false">नसी 24:16, 2 तीमुथि 3:11</char></note><verse eid="PSA 34:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 34:20" />प्रभु तेसरी सारिया आड्डिया खे सई-सलामत राखोआ</para>
  <para style="q" vid="PSA 34:20">ओर तिना बीचा ते एक पनि टूटदी।<note caller="+" style="f"><char style="fr" closed="false">34:20 </char><char style="ft" closed="false">यूह. 19:36</char></note><verse eid="PSA 34:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PSA 34:21" />दुष्ट माणूं आपणी बुराईया रिया बजा ते नाश ऊई जाणा</para>
  <para style="q" vid="PSA 34:21">ओर जो लोक तार्मिक माणूंए ते कृणा करोए सेयो दोषी ठईरने।<verse eid="PSA 34:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="PSA 34:22" />यहोवे तिना रे प्राण बचाणे जो तेसरी सेवा करोए।</para>
  <para style="q" vid="PSA 34:22">ओर जो तेस पाँदे परोसा राखोए,</para>
  <para style="q" vid="PSA 34:22">तिना बीचा ते तेस कोई बी दोषी नि ठराणा।<verse eid="PSA 34:22" /></para>
  <chapter eid="PSA 34" />
  <chapter number="35" style="c" sid="PSA 35" />
  <para style="s">दुश्मणा ते छुटकारा पाणे रिया तँईं प्रार्थना</para>
  <para style="d">दाऊदो रा पजन</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 35:1" />ओ यहोवा, जो माणूं मां साथे मकद्दमा लड़ोए,</para>
  <para style="q" vid="PSA 35:1">तिना साथे तूँ बी मकद्दमा लड़;</para>
  <para style="q" vid="PSA 35:1">जो मां साथे युद्ध करोए, तिना साथे तूँ बी युद्ध कर।<verse eid="PSA 35:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 35:2" />ढाल ओर भाल़ा लई की मेरी मताद करने खे खड़ा ओ।<verse eid="PSA 35:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 35:3" />आपणी बर्छी तिना रिया तरफा खे फेर जो मां पीछे पड़ी रे, तूँ मांते वादा कर कि तां आऊँ बचाई लणा। जो माणूं मेरा पीछा करोए, तिना रे खलाफ बर्छी ओर भाल़ा चक।</para>
  <para style="q" vid="PSA 35:3">तूँ मेरे प्राणो खे ये बोल, “आऊँ ई तेरा उद्धार करने वाल़ा ए।”<verse eid="PSA 35:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 35:4" />जो माणूं माखे काणा चाओए, सेयो शर्मिंदा ओर बेज्जत ओ!</para>
  <para style="q" vid="PSA 35:4">जो मेरे नुकशाणो रे बारे दे सोचोए,</para>
  <para style="q" vid="PSA 35:4">सेयो पीछे टाए जाओ ओर तिना री बेज्जती ओ!<verse eid="PSA 35:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 35:5" />सेयो पऊणी साथे उडने वाल़े पूए जेड़े ऊई जाओ</para>
  <para style="q" vid="PSA 35:5">ओर प्रभुए रा दूत तिना खे खदेड़दा जाओ!<verse eid="PSA 35:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 35:6" />तिना री बाट न्हेरी ओर खड़ीसणे वाल़ी ओ</para>
  <para style="q" vid="PSA 35:6">ओर प्रभुए रा दूत तिना खे खदेड़दा जाओ!<verse eid="PSA 35:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 35:7" />बिना बजा ते तिने मेरिया तँईं आपणा जाल़ गड्डे दे बछाया;</para>
  <para style="q" vid="PSA 35:7">बिना बजा ते ई तिने मेरे प्राण लणे खे गड्डा खणी राखेया।<verse eid="PSA 35:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 35:8" />अचाणक तिना पाँदे बिपदा पड़ी जाओ</para>
  <para style="q" vid="PSA 35:8">ओर जो जाल़ तिने बछाई राखेया तिदे सेयो आपू ई फसी जाओ</para>
  <para style="q" vid="PSA 35:8">ओर तिदे सेयो आपू ई पड़ी जाओ।<note caller="+" style="f"><char style="fr" closed="false">35:8 </char><char style="ft" closed="false">रोमी 11:9,10, 1 थिस्सलुनी 5:3</char></note><verse eid="PSA 35:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 35:9" />पर मां प्रभुए दे मगन ऊणा;</para>
  <para style="q" vid="PSA 35:9">कऊँकि तिने आऊँ बचाई राखेया।<verse eid="PSA 35:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 35:10" />मां पूरे दिलो ते ये बोलणा, “ओ प्रभु, तां जेड़ा कोई पनि ए,</para>
  <para style="q" vid="PSA 35:10">तूँ दु:खी माणूंआ खे बड़े-बड़े तागतबर लोका ते बचाओआ</para>
  <para style="q" vid="PSA 35:10">ओर लूटेरेया ते गरीब लोका री रक्षा करेया।”<verse eid="PSA 35:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 35:11" />मेरे खलाफ चूठे गवाह् खड़े ओए</para>
  <para style="q" vid="PSA 35:11">ओर जो गल्ल आऊँ नि जाणदा सेई मांते पूछोए।<verse eid="PSA 35:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 35:12" />सेयो मां साथे पलाईया रे बदले बुराई करोए;</para>
  <para style="q" vid="PSA 35:12">एथो तक कि मेरा प्राण ऊबी जाओआ।<verse eid="PSA 35:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 35:13" />जेबे सेयो रोगी थे तेबे मैं पश्चाताप करने रिया तँईं टाट पईनी की राखी</para>
  <para style="q" vid="PSA 35:13">ओर पूखा-त्याया रई की दु:ख सईन करदा रया</para>
  <para style="q" vid="PSA 35:13">ओर माखे मेरी प्रार्थना रा जबाब नि मिलेया।<note caller="+" style="f"><char style="fr" closed="false">35:13 </char><char style="ft" closed="false">अय्यू. 30:25, रोमी 12:15</char></note><verse eid="PSA 35:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 35:14" />आऊँ तिना साथे एड़ा सबाओ राखूँ था</para>
  <para style="q" vid="PSA 35:14">कि जेड़ा मानो मेरे संगी-साथी या मेरे पाई ओ;</para>
  <para style="q" vid="PSA 35:14">जेड़ा कोई माया खे शोग करोआ,</para>
  <para style="q" vid="PSA 35:14">तेड़ा ई मैं शोगो रा पईरावा पईनी की सिर चुकाई की शोग कित्तेया।<verse eid="PSA 35:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 35:15" />पर जेबे आऊँ लड़खड़ाई की रूड़ेया तेबे मेरे दुश्मण खुश ऊई की कट्ठे ऊईगे,</para>
  <para style="q" vid="PSA 35:15">सेयो मेरे चऊँ कनारे केरा पाई की खड़ी गे ओर मां पाँदे आसणे लगे ओर मजाक करने लगे।</para>
  <para style="q" vid="PSA 35:15">एथो तक कि अणजाण लोके बी मां पाँदे अमला कित्तेया ओर सेयो नि रूके।<verse eid="PSA 35:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 35:16" />तिने माखे गाल़ी दित्तिया ओर मेरा मजाक उडाया,</para>
  <para style="q" vid="PSA 35:16">ओर नफरता साथे कूरी की माखे देखणे लगे।<note caller="+" style="f"><char style="fr" closed="false">35:16 </char><char style="ft" closed="false">पजन 37:12</char></note><verse eid="PSA 35:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 35:17" />ओ प्रभु, तां कदुओ तक देखदे रणा?</para>
  <para style="q" vid="PSA 35:17">एसा बिपदा ते जिदे तिने आऊँ पाई राखेया,</para>
  <para style="q" vid="PSA 35:17">माखे काणे रिया तँईं जवान शेरा जेड़े अमला करने वाल़े लोका ते माखे बचा।<note caller="+" style="f"><char style="fr" closed="false">35:17 </char><char style="ft" closed="false">7:2; 10:9; 17:12; 22:13,21</char></note><verse eid="PSA 35:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 35:18" />मां बड़ी सभा रे तेरा तन्यवाद करना;</para>
  <para style="q" vid="PSA 35:18">मां बऊत सारे लोका बीचे तेरी स्तुति करनी।<verse eid="PSA 35:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 35:19" />मेरे खलाफ चूठ बोलणे वाल़े मेरे दुश्मण खुशी नि मनाई सको,</para>
  <para style="q" vid="PSA 35:19">जो बिना मतलबो ते मेरे बैरी ए, सेयो मेरी बेजती करदे ऊए आसी नि सको।<note caller="+" style="f"><char style="fr" closed="false">35:19 </char><char style="ft" closed="false">यूह. 15:25, पजन 69:4</char></note><verse eid="PSA 35:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 35:20" />कऊँकि सेयो मेल-जोलो रिया गल्ला नि बोलदे,</para>
  <para style="q" vid="PSA 35:20">पर दुनिया रे शान्तिया साथे रणे वाल़े लोका रे खलाफ छलो री इच्छा राखोए।<verse eid="PSA 35:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PSA 35:21" />तिने मेरे खलाफ चींगदे ऊए मां पाँदे दोष लगाए ओर बोलोए,</para>
  <para style="q" vid="PSA 35:21">“आसे सेयो गल़त काम देखे जो तैं कित्ते!”<verse eid="PSA 35:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="PSA 35:22" />ओ प्रभु, तैं तो ये देखी राखेया;</para>
  <para style="q" vid="PSA 35:22">एबे चुप नि रओ! ओ प्रभु, मांते दूर नि रओ!<verse eid="PSA 35:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="PSA 35:23" />उठ, मेरा न्याय करने खे जाग,</para>
  <para style="q" vid="PSA 35:23">ओ मेरे परमेशर, ओ मेरे प्रभु, मेरा मकद्दमा निपटाणे खे आओ!<verse eid="PSA 35:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="PSA 35:24" />ओ मेरे प्रभु परमेशर, तूँ तर्मी आ, तूँ आपू बता कि आऊँ निर्दोष आ,</para>
  <para style="q" vid="PSA 35:24">ओर मेरेया दुश्मणा खे मां पाँदे आसणे नि दे!<verse eid="PSA 35:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="PSA 35:25" />सेयो आपणे आपू ते ये नि बोली सको, “वाह! म्हारी इच्छा तो पूरी ऊई गी!”</para>
  <para style="q" vid="PSA 35:25">सेयो ये नि बोलो, “आसे से निगल़ी ता।”<verse eid="PSA 35:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="PSA 35:26" />जो लोक मेरे नुकशाणो ते खुश ओए,</para>
  <para style="q" vid="PSA 35:26">तिना खे पुरिया तरअ ते शर्मिंदा ओर बेज्जत कर!</para>
  <para style="q" vid="PSA 35:26">जो मेरे खलाफ बडयाईया करोए तिना खे शर्म</para>
  <para style="q" vid="PSA 35:26">ओर अनादरो साथे टखी दे!<verse eid="PSA 35:26" /></para>
  <para style="q">
    <verse number="27" style="v" sid="PSA 35:27" />जो लोक मेरे तर्मो ते खुश रओए, सेयो जयजयकार करो</para>
  <para style="q" vid="PSA 35:27">ओर खुशी मनाओ ओर हमेशा बोलदे रओ, “प्रभुए री तारीफ ओ,</para>
  <para style="q" vid="PSA 35:27">से आपणे दासो रे कल्याणो ते खुश ओआ!”<verse eid="PSA 35:27" /></para>
  <para style="q">
    <verse number="28" style="v" sid="PSA 35:28" />तेबे मां पूरे दिन चींगदे रणा, प्रभु परमेशरो री स्तुति करो! तिने सेई कित्तेया जो सई था।<verse eid="PSA 35:28" /></para>
  <chapter eid="PSA 35" />
  <chapter number="36" style="c" sid="PSA 36" />
  <para style="s">परमेशरो रा प्यार ओर माणूंए री दुष्टता</para>
  <para style="d">बजाणे वाल़े रे परदानो रिया तँईं प्रभुए रे दास दाऊदो रा पजन</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 36:1" />दुष्ट लोक लगातार पाप करने री इच्छा करदे रओए। सेयो सोचोए कि तिना खे परमेशरो रा आदर करने री जरूरत नि ए।<note caller="+" style="f"><char style="fr" closed="false">36:1 </char><char style="ft" closed="false">रोमी 3:18</char></note><verse eid="PSA 36:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 36:2" />सेयो आपू खे बऊत जादा पसन्द करोए, इजी री खातर सेयो आपणे पापो खे नि देखदे ओर नफरत पनि करदे।<verse eid="PSA 36:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 36:3" />तेसरे मुंए रिया गल्ला अनर्थ ओर छलो रिया ए;</para>
  <para style="q" vid="PSA 36:3">तिने बुद्धि ओर पलाईया रे काम करने बंद करीते दे।<verse eid="PSA 36:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 36:4" />से आपणे बछौणे पाँदे लेटे रे बुरिया गल्ला सोचोआ;</para>
  <para style="q" vid="PSA 36:4">से आपू खे तेसा बाटा रे लई की चलोआ जिदे पलाई नि ए;</para>
  <para style="q" vid="PSA 36:4">बुराई करने ते से पीछे नि अटदा।<verse eid="PSA 36:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 36:5" />ओ प्रभु, तेरी करूणा स्वर्गो तक महान ए,</para>
  <para style="q" vid="PSA 36:5">तेरी सच्चाई सर्गो तक पऊँची री।<verse eid="PSA 36:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 36:6" />तेरी तार्मिकता ऊच्चे पाह्ड़ो जेड़ी ए, तेरे नियम समुद्रो जेड़े गईरे ए;</para>
  <para style="q" vid="PSA 36:6">ओ प्रभु, तूँ माणूं ओर डांगर दुँईं री रक्षा करेया।<verse eid="PSA 36:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 36:7" />ओ परमेशर, तेरी करूणा कितणी कीमती ए!</para>
  <para style="q" vid="PSA 36:7">माणूं तेरे पंखा रिया छाया रे शरण लओए।<verse eid="PSA 36:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 36:8" />सेयो तेरे मईलो<note caller="+" style="f"><char style="fr" closed="false">36:8 </char><char style="ft" closed="false">मन्दर</char></note> रे चिकणे खाणे ते रजणे,</para>
  <para style="q" vid="PSA 36:8">ओर तां आपणी सुखो री नदिया ते तिना खे पाणी पल़्याणा।<verse eid="PSA 36:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 36:9" />कऊँकि जिन्दगिया री सूबल़ तांगे ईए;</para>
  <para style="q" vid="PSA 36:9">तेरी जोतिया रे जरिए आसा खे प्रयासा मिलणा।<note caller="+" style="f"><char style="fr" closed="false">36:9 </char><char style="ft" closed="false">यहून् 4:10,14, प्रकाशित 21:6</char></note><verse eid="PSA 36:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 36:10" />जो पग्त ताखे जाणोए तिना पाँदे तूँ आपणी करूणा करदा रओ</para>
  <para style="q" vid="PSA 36:10">ओर सच्चाईया साथे चलणे वाल़ेया पाँदे आपणी तार्मिकता बणाई की राख!<verse eid="PSA 36:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 36:11" />कमण्डी माणूंआ खे मां पाँदे अमला करने नि दे,</para>
  <para style="q" vid="PSA 36:11">ओर ना ई दुष्ट माणूंआ खे मेरा पीछा करने<verse eid="PSA 36:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 36:12" />तेती बुरे काम करने वाल़े रूड़ी गे रे;</para>
  <para style="q" vid="PSA 36:12">सेयो तकेली ते रे ओर फेर उठी नि सकणे।<verse eid="PSA 36:12" /></para>
  <chapter eid="PSA 36" />
  <chapter number="37" style="c" sid="PSA 37" />
  <para style="s">कुकर्मिया रा अन्त ओर तर्मिया रा अन्त</para>
  <para style="d">दाऊदो रा पजन</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 37:1" />बुरे काम करने वाल़ेया री बजा ते आपू खे परेशान नि करो,</para>
  <para style="q" vid="PSA 37:1">गल़त काम करने वाल़ेया ते ईर्ष्या नि कर!<verse eid="PSA 37:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 37:2" />कऊँकि सेयो काओ जेड़े चट ई बाडी देणे</para>
  <para style="q" vid="PSA 37:2">ओर अरे काओ जेड़े मुरझाई जाणे।<verse eid="PSA 37:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 37:3" />प्रभुए पाँदे परोसा राख ओर पले काम कर, देशो रे बसेया रा रओ</para>
  <para style="q" vid="PSA 37:3">ओर सच्चाईया पाँदे मन लगाई की राख।<verse eid="PSA 37:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 37:4" />तुसे तेड़ा ई करना जेड़ा यहोवा चाओआ,</para>
  <para style="q" vid="PSA 37:4">ओर तेस तेरे मनो री इच्छा पूरी करनी।<note caller="+" style="f"><char style="fr" closed="false">37:4 </char><char style="ft" closed="false">मत्ती 6:33</char></note><verse eid="PSA 37:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 37:5" />आपणियां बाटा री चिन्ता प्रभुए पाँदे छाड</para>
  <para style="q" vid="PSA 37:5">ओर तेस पाँदे परोसा राख, तेस ई पूरा करना।<verse eid="PSA 37:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 37:6" />तेरी तार्मिकता त्याड़िया रिया तूपा रे प्रयासे जेड़ी चमकणी</para>
  <para style="q" vid="PSA 37:6">ओर तेरी सच्चाई त्याड़िया रे प्रयासे जेड़ी प्रगट करनी।<verse eid="PSA 37:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 37:7" />प्रभुए रे सामणे शान्त रओ ओर सब्रो साथे तेसखे न्याल़;</para>
  <para style="q" vid="PSA 37:7">तेस माणूंए रिया बजा ते आपू खे परेशान नि कर जो बुरे काम करने रे जरिये सफल ओआ</para>
  <para style="q" vid="PSA 37:7">ओर से बुरिया साजिशा खे निकयाल़ोआ!<verse eid="PSA 37:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 37:8" />गुस्से ते दूर रओ ओर जल़ना छाडी देओ!</para>
  <para style="q" vid="PSA 37:8">आपू खे परेशान नि कर, तिजी ते बुराई ई निकल़नी।<verse eid="PSA 37:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 37:9" />एक दिन यहोवे दुष्ट लोक नाश करने,</para>
  <para style="q" vid="PSA 37:9">पर जो लोक यहोवे पाँदे परोसा राखोए, सेयो ई तरतिया रे अक्कदार ऊणे।<note caller="+" style="f"><char style="fr" closed="false">37:9 </char><char style="ft" closed="false">तेते जगा रे अक्कदार ऊणे जो यहोवे तिना खे देणे रा वादा करी राखेया</char></note><verse eid="PSA 37:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 37:10" />दुष्ट माणूं चट ई राची जाणे,</para>
  <para style="q" vid="PSA 37:10">ओर तुसा खे सेयो फेर टोल़ी की पनि मिलणे।<verse eid="PSA 37:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 37:11" />पर नम्र लोक तरतिया रे अक्कदार ऊणे</para>
  <para style="q" vid="PSA 37:11">ओर तिना बड़ी शान्तिया साथे खुशी मनाणी।<note caller="+" style="f"><char style="fr" closed="false">37:11 </char><char style="ft" closed="false">मत्ती 5:5</char></note><verse eid="PSA 37:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 37:12" />दुष्ट माणूं तर्मिया रे खलाफ षड़यन्त्र रचोए</para>
  <para style="q" vid="PSA 37:12">ओर तेस पाँदे दाँद किरड़ोए।<verse eid="PSA 37:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 37:13" />पर परमेशर यहोवा दुष्ट लोका पाँदे आसणा,</para>
  <para style="q" vid="PSA 37:13">कऊँकि से देखोआ कि तिना रे आखरी न्याय रे दिन नेड़े आऊणे वाल़े ए।<verse eid="PSA 37:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 37:14" />दुष्ट लोके तलवारी खींजी राखिया ओर धनुष चढ़ाई राखे,</para>
  <para style="q" vid="PSA 37:14">ताकि दु:खी ओर सीदे लोका खे माट्टिया रे मलाई देओ</para>
  <para style="q" vid="PSA 37:14">ओर सई काम करने वाल़ेया खे काई सको।<verse eid="PSA 37:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 37:15" />तिना रिया तलवारी साथे तिना रेई दिल छिदणे</para>
  <para style="q" vid="PSA 37:15">ओर तिना रे धनुष तोड़े जाणे।<verse eid="PSA 37:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 37:16" />तार्मिक माणूंए रा थोड़ा जा तअन</para>
  <para style="q" vid="PSA 37:16">दुष्ट माणूंए रे बऊत सारे धनो ते खरा ए।<verse eid="PSA 37:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 37:17" />कऊँकि यहोवा दुष्ट माणूंआ री तागत खत्म करोआ,</para>
  <para style="q" vid="PSA 37:17">पर तार्मिक माणूंआ खे सम्बाल़ोआ।<verse eid="PSA 37:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 37:18" />निर्दोष माणूंआ री देखपाल़ यहोवा आपू करोआ,</para>
  <para style="q" vid="PSA 37:18">ओर तिना री बरासती रा इस्सा हमेशा बणेया रा रणा।<verse eid="PSA 37:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 37:19" />बिपदा रे बखते तिना री उम्मीद नि टूटणी ओर ना सेयो शर्मिंदा ऊणे</para>
  <para style="q" vid="PSA 37:19">बल्कि अकाल़ो रे बखते सेयो रज्जे रे रणे।<verse eid="PSA 37:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 37:20" />दुष्ट लोक नाश ऊई जाणे ओर</para>
  <para style="q" vid="PSA 37:20">प्रभुए रे दुश्मण काओ रे फूलो जेड़े नाश ऊई जाणे,</para>
  <para style="q" vid="PSA 37:20">सेयो तुएँ जेड़े लोप ऊई जाणे।<verse eid="PSA 37:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PSA 37:21" />दुष्ट कर्ज लओआ ओर चुकांदा नि,</para>
  <para style="q" vid="PSA 37:21">पर तार्मिक माणूं दया करी की दान देओआ;<verse eid="PSA 37:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="PSA 37:22" />यहोवे ते आशीष पाए रे लोक तरतिया रे अक्कदार ऊणे,</para>
  <para style="q" vid="PSA 37:22">पर सेयो लोक नाश ऊई जाणे जिना खे यहोवे स्राप देई राखेया।<verse eid="PSA 37:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="PSA 37:23" />जे तुसे सेई करोए जो प्रभु चाओआ,</para>
  <para style="q" vid="PSA 37:23">तो तेस तेरिया बाटा दे तेरी रक्षा करनी।<verse eid="PSA 37:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="PSA 37:24" />चाए से रूड़ो तेबे बी सदा थाले पड़ेया रा नि रणा,</para>
  <para style="q" vid="PSA 37:24">कऊँकि प्रभु तेसरा आथ पकड़ी राखोआ।<verse eid="PSA 37:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="PSA 37:25" />आऊँ बचपनो ते लई की स्याणदे बखतो तक देखदा आई रा;</para>
  <para style="q" vid="PSA 37:25">प्रभुए ना तो कदी कोई तर्मी माणूं छाडेया</para>
  <para style="q" vid="PSA 37:25">ओर ना ई तेसरी ल्वाद पीख मांगदे ऊए देखी।<verse eid="PSA 37:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="PSA 37:26" />तर्मी माणूं तो सदा दया करी की कर्ज देओआ</para>
  <para style="q" vid="PSA 37:26">ओर तेसरा वंश आशीषा रा जरिया बणोआ।<verse eid="PSA 37:26" /></para>
  <para style="q">
    <verse number="27" style="v" sid="PSA 37:27" />बुराईया ते दूर रओ ओर पले काम कर;</para>
  <para style="q" vid="PSA 37:27">तेबे तूँ देशो रे सदा शान्तिया साथे बसेया रा रणा।<verse eid="PSA 37:27" /></para>
  <para style="q">
    <verse number="28" style="v" sid="PSA 37:28" />कऊँकि प्रभु न्याय साथे प्यार राखोआ ओर तेस आपणे पग्त नि छाडणे।</para>
  <para style="q" vid="PSA 37:28">तिना री रक्षा तो सदा ओई, पर दुष्ट माणूंआ रे बच्चे नाश ऊई जाणे।<verse eid="PSA 37:28" /></para>
  <para style="q">
    <verse number="29" style="v" sid="PSA 37:29" />तार्मिक माणूं तरतिया रे अक्कदार ऊणे</para>
  <para style="q" vid="PSA 37:29">ओर तिदे सदा बसे रे रणे।<verse eid="PSA 37:29" /></para>
  <para style="q">
    <verse number="30" style="v" sid="PSA 37:30" />तार्मिक माणूं आपणे मुंए ते अक्ला रिया गल्ला करोआ</para>
  <para style="q" vid="PSA 37:30">ओर न्याय रा वचन बोलोआ।<verse eid="PSA 37:30" /></para>
  <para style="q">
    <verse number="31" style="v" sid="PSA 37:31" />सेयो हमेशा परमेशरो री बिदिया रे बारे दे सोचदे रओए,</para>
  <para style="q" vid="PSA 37:31">ओर परमेशरो रिया बाटा ते कदी बी दूर नि ऊँदे।<verse eid="PSA 37:31" /></para>
  <para style="q">
    <verse number="32" style="v" sid="PSA 37:32" />दुष्ट माणूं तार्मिक माणूंए री ताका रे रओआ</para>
  <para style="q" vid="PSA 37:32">ओर तेसखे काणे री कोशिश करोआ।<verse eid="PSA 37:32" /></para>
  <para style="q">
    <verse number="33" style="v" sid="PSA 37:33" />पर यहोवा दुष्ट माणूंए खे सफल नि ऊणे देंदा,</para>
  <para style="q" vid="PSA 37:33">ओर जेबे तार्मिक माणूंए रा न्याय ऊणा, तेबे प्रभुए से दोषी नि ठराणा।<verse eid="PSA 37:33" /></para>
  <para style="q">
    <verse number="34" style="v" sid="PSA 37:34" />प्रभुए खे न्याल़दा रओ ओर तेसरी बाटा रे चलदा रओ,</para>
  <para style="q" vid="PSA 37:34">ओर तेस तेरी तरक्की करी की तूँ तरतिया रा अक्कदार बणाई देणा;</para>
  <para style="q" vid="PSA 37:34">तां दुष्ट माणूंए रा सत्यानाश ऊँदे देखणा।<verse eid="PSA 37:34" /></para>
  <para style="q">
    <verse number="35" style="v" sid="PSA 37:35" />मैं दुष्ट एड़ा पराक्रमी ओर एड़ा फैलदा ऊआ देखेया,</para>
  <para style="q" vid="PSA 37:35">जेड़ा कोई अरा डाल़ आपणी जमीना दे आपणे-आपू जम्मेया रा फैलोआ।<verse eid="PSA 37:35" /></para>
  <para style="q">
    <verse number="36" style="v" sid="PSA 37:36" />पर कुछ बखतो ते बाद मैं देखेया कि से तेथा ते राचीगा रा ए</para>
  <para style="q" vid="PSA 37:36">ओर मैं बी से टोल़ेया, पर तेबे बी से तेती नि मिलेया।<note caller="+" style="f"><char style="fr" closed="false">37:36 </char><char style="ft" closed="false">पजन 37:10</char></note><verse eid="PSA 37:36" /></para>
  <para style="q">
    <verse number="37" style="v" sid="PSA 37:37" />खरे माणूंए खे त्यानो दे राखो ओर तर्मिये खे देख,</para>
  <para style="q" vid="PSA 37:37">कऊँकि शान्तिया ते रणे वाल़े माणूंए रे अंतो रा फल अच्छा ए।<note caller="+" style="f"><char style="fr" closed="false">37:37 </char><char style="ft" closed="false">यशायाह 32:17</char></note><verse eid="PSA 37:37" /></para>
  <para style="q">
    <verse number="38" style="v" sid="PSA 37:38" />पर दुष्ट पापी माणूं पूरी तरआ ते बर्बाद ओए,</para>
  <para style="q" vid="PSA 37:38">तिना रे बाल-बच्चे पनि रणे।<verse eid="PSA 37:38" /></para>
  <para style="q">
    <verse number="39" style="v" sid="PSA 37:39" />तार्मिक माणूंए खे यहोवा आपू बचाओआ,</para>
  <para style="q" vid="PSA 37:39">मुसीबता रे बखते से तिना रा मजबूत गढ़ ए।<verse eid="PSA 37:39" /></para>
  <para style="q">
    <verse number="40" style="v" sid="PSA 37:40" />प्रभु तिना माणूंआ री मताद करी की तिना खे बचाओआ;</para>
  <para style="q" vid="PSA 37:40">से तिना खे दुष्टा ते छुड़ाई की तिना री रक्षा करोआ,</para>
  <para style="q" vid="PSA 37:40">कऊँकि सेयो तेसरी शरणा रे आई रे।<verse eid="PSA 37:40" /></para>
  <chapter eid="PSA 37" />
  <chapter number="38" style="c" sid="PSA 38" />
  <para style="s">दु:खी माणूंए री प्रार्थना</para>
  <para style="d">यादगारा रिया तँईं दाऊदो रा पजन</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 38:1" />ओ प्रभु, गुस्से ते माखे नि डाँट,</para>
  <para style="q" vid="PSA 38:1">ओर ना जल़ी की माखे सजा दे!<verse eid="PSA 38:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 38:2" />तेरे तीरे आँऊ बीनी ता</para>
  <para style="q" vid="PSA 38:2">ओर तेरा आथ मां पाँदे उठी रा।<verse eid="PSA 38:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 38:3" />तेरे गुस्से रिया बजा ते मेरा शरीर तन्दरूस्त नि ए;</para>
  <para style="q" vid="PSA 38:3">ओर मेरे पापो रिया बजा ते मेरी आड्डिया दे कुछ बी ठीक नि ए।<verse eid="PSA 38:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 38:4" />आँऊ आपणे बुरे कामा रिया बजा ते सिरो तक डूबी गा रा,</para>
  <para style="q" vid="PSA 38:4">ओर सेयो पारी बोजो जेड़े मेरे सईणे ते बारे ऊईगे रे।<verse eid="PSA 38:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 38:5" />मेरे जख्मा ते सड़यांन आओई,</para>
  <para style="q" vid="PSA 38:5">मेरी मूर्खता रिया बजा ते सेयो सड़ीगे रे।<verse eid="PSA 38:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 38:6" />आऊँ बऊत दु:खी ए ओर चूकीगा रा;</para>
  <para style="q" vid="PSA 38:6">पूरा दिन आऊँ शोग करदा चलदा-फिरदा रऊँआ।<verse eid="PSA 38:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 38:7" />बुखारो रिया बजा ते मेरा शरीर जल़ने लगी रा</para>
  <para style="q" vid="PSA 38:7">ओर आऊँ बऊत ई जादा बमार ए।<verse eid="PSA 38:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 38:8" />आऊँ कमजोर ओर बऊत ई टुटीगा रा;</para>
  <para style="q" vid="PSA 38:8">आऊँ आपणे दिलो री तकलीफा ते कणदा रऊँआ।<verse eid="PSA 38:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 38:9" />ओ प्रभु, मेरी सारी इच्छा तेरे सामणे ए,</para>
  <para style="q" vid="PSA 38:9">ओर मेरा कणना तांते छिपी नि रया।<verse eid="PSA 38:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 38:10" />मेरा दिल बऊत तेज धड़कोआ ओर मेरी तागत खत्म ऊणे वाल़ी ए;</para>
  <para style="q" vid="PSA 38:10">ओर मेरिया आखी ते ठीक पनि दिखणे लगी रा।<verse eid="PSA 38:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 38:11" />मेरे दोस्त ओर मेरे रिश्तेदार मेरी बिपदा रे बखते मांते दूर ऊईगे,</para>
  <para style="q" vid="PSA 38:11">ओर मेरे टब्बरो रे बी दूर जाई की खड़े ऊईगे।<note caller="+" style="f"><char style="fr" closed="false">38:11 </char><char style="ft" closed="false">पजन 31:11, लूक 23:49</char></note><verse eid="PSA 38:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 38:12" />ओर जो लोक माखे काणा चाओए, सेयो माखे पकड़ने खे जाल़ बछाओए,</para>
  <para style="q" vid="PSA 38:12">ओर माखे नुकशाण पऊँचाणे री कोशिश करने वाल़े दुष्टता रिया गल्ला बोलोए</para>
  <para style="q" vid="PSA 38:12">ओर सेयो पूरा दिन छल-कपट करने रिया गल्ला सोचोए।<verse eid="PSA 38:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 38:13" />पर आऊँ टऊणे जेड़ा सुणदा ई नि,</para>
  <para style="q" vid="PSA 38:13">ओर गूँगे जेड़ा आपणा मूँ नि खोलदा।<verse eid="PSA 38:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 38:14" />बल्कि आऊँ तेस माणूंए जेड़ा ऊईगा रा जो कुछ सुणदा ई नि,</para>
  <para style="q" vid="PSA 38:14">ओर जेसरे मुंए ते आपणे बचाव रिया तँईं कोई गल्ल नि निकल़दी।<verse eid="PSA 38:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 38:15" />पर ओ प्रभु, मैं तांई पाँदे आपणी उम्मीद लगाई राखी,</para>
  <para style="q" vid="PSA 38:15">ओ प्रभु, मेरे परमेशर, तांई माखे ज्वाब देणा।<verse eid="PSA 38:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 38:16" />मैं बोलेया, “एड़ा नि ओ कि सेयो मां पाँदे आसणे लगो;</para>
  <para style="q" vid="PSA 38:16">जेबे मेरे पैर खरीसड़ो तेबे सेयो मां पाँदे बडिया-बडिया गल्ला करो।”<verse eid="PSA 38:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 38:17" />कऊँकि आऊँ एबे रूड़ने ई वाल़ा ए;</para>
  <para style="q" vid="PSA 38:17">ओर मेरा दु:ख हर बखत मां साथे ए।<verse eid="PSA 38:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 38:18" />मां तो आपणे बुरे काम मानी लणे,</para>
  <para style="q" vid="PSA 38:18">ओर आँऊ आपणे पापो रिया बजा ते दु:खी आ।<verse eid="PSA 38:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 38:19" />पर मेरे दुश्मण फुर्तिले ओर सामर्थी ए,</para>
  <para style="q" vid="PSA 38:19">ओर जो मां साथे बिना मतलबो ते कृणा करोए सेयो बऊत बढ़ीगे रे।<verse eid="PSA 38:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 38:20" />जो पलाईया रे बदले बुराई करोए,</para>
  <para style="q" vid="PSA 38:20">सेयो बी मेरी पलाईया पीछे चलणे रिया बजा ते मां साथे बरोद राखोए।<verse eid="PSA 38:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PSA 38:21" />ओ प्रभु, माखे छाड नि!</para>
  <para style="q" vid="PSA 38:21">ओ मेरे परमेशर, मांते दूर नि ओ!<verse eid="PSA 38:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="PSA 38:22" />ओ प्रभु, ओ मेरे उद्धारकर्ता,</para>
  <para style="q" vid="PSA 38:22">मेरी मताद करने खे फुर्ती कर!<verse eid="PSA 38:22" /></para>
  <chapter eid="PSA 38" />
  <chapter number="39" style="c" sid="PSA 39" />
  <para style="s">बुद्धि ओर माफिया रिया तँईं प्रार्थना</para>
  <para style="d">बजाणे वाल़े यदूतून परदानो रिया तँईं दाऊदो रा पजन</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 39:1" />मैं आपणे आपू ते बोलेया, “मां आपणे चाल-चलणो रे चौकसी करनी,</para>
  <para style="q" vid="PSA 39:1">ताकि मेरी जीबा ते पाप नि ओ; जदुए तक दुष्ट मां सामणे ए,</para>
  <para style="q" vid="PSA 39:1">तदुए तक मां लगाम लगाई की आपणा मूँ बंद राखणा।”<note caller="+" style="f"><char style="fr" closed="false">39:1 </char><char style="ft" closed="false">याकूब 1:26</char></note><verse eid="PSA 39:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 39:2" />आऊँ मौन धारण करी की गूँगा बणीगा,</para>
  <para style="q" vid="PSA 39:2">ओर पलाईया रिया तरफा ते बी चुप रया</para>
  <para style="q" vid="PSA 39:2">ओर मेरी तकलीफ बढ़ी गी,<verse eid="PSA 39:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 39:3" />मेरा दिल पीतरे ई पीतरे फूखणे लगी रा था।</para>
  <para style="q" vid="PSA 39:3">सोचदे-सोचदे आग पड़की गी; तेबे आऊँ बोलणे लगेया,<note caller="+" style="f"><char style="fr" closed="false">39:3 </char><char style="ft" closed="false">77:3, 77:6</char></note><verse eid="PSA 39:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 39:4" />“ओ यहोवा, मेरा अंत माखे बताई दे ओर ये बी कि मेरी उम्र कितणी ए,</para>
  <para style="q" vid="PSA 39:4">जेते की आऊँ आपणी जिन्दगिया रे बारे दे जाणी लऊँ कि मेरी जिन्दगी कितणी ए!<verse eid="PSA 39:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 39:5" />देख, तैं माखे थोड़ी ई जिन्दगी देई राखी ए ओर मेरी जिन्दगी तेरी नजरा रे कुछ पनिए।</para>
  <para style="q" vid="PSA 39:5">सच्ची सब माणूं किंयाँ बी टिके रे कऊँ नि ओ तेबे बी बेकार ठईरी रे। सेला<verse eid="PSA 39:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 39:6" />सच्चो खे ई माणूं छांयी जेड़ा चलदा-फिरदा प्राणी ए; सेयो बेकारो खेई कबराओए;</para>
  <para style="q" vid="PSA 39:6">से पैसे तो सांजोआ, पर जाणदा नि कि से केस लणे!”<verse eid="PSA 39:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 39:7" />एबे ओ परमेशर, आँऊ केसखे न्याल़ूँ?</para>
  <para style="q" vid="PSA 39:7">मेरी उम्मीद तो तेरिया तरफा खे लगी री।<verse eid="PSA 39:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 39:8" />माखे मेरे सारे अपराधा ते छुड़ाई लओ।</para>
  <para style="q" vid="PSA 39:8">ताकि आँऊ मूर्खा रिया तँईं निन्दा जोगा नि बणूँ।<verse eid="PSA 39:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 39:9" />आऊँ तो गूँगा बणीगा ओर ना ई मैं आपणा मूँ खोलेया;</para>
  <para style="q" vid="PSA 39:9">कऊँकि ये काम तैंई करी राखेया।<verse eid="PSA 39:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 39:10" />तैं जो बिपदा मां पाँदे पाई राखी तिजी खे मांते दूर करी दे,</para>
  <para style="q" vid="PSA 39:10">कऊँकि आऊँ तो तेरे आथो री मारा ते नाश ऊईगा रा।<verse eid="PSA 39:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 39:11" />जेबे लोक बुरे काम करोए तो तूँ तिना खे चतौणी देआ ओर तिना खे सजा देआ।</para>
  <para style="q" vid="PSA 39:11">तूँ तिना रिया किमती चीजा खे नाश करी देआ, जिंयाँ एक कीड़ा टाल्लेया खे खाई जाओआ।</para>
  <para style="q" vid="PSA 39:11">सच्ची सब माणूं बेकारो रेई कमण्ड करोए। सेला<verse eid="PSA 39:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 39:12" />ओ प्रभु, आऊँ मतादा रिया तँईं प्रार्थना करूँआ ओर मेरी बिनतिया पाँदे त्यान दे,</para>
  <para style="q" vid="PSA 39:12">मेरा रोणा सुणी की शांत नि रओ! कऊँकि आऊँ तां साथे एक पराऊणेया जेड़ा रऊँआ,</para>
  <para style="q" vid="PSA 39:12">ओर आपणे सारे बुजुर्गा जेड़ा परदेशी ए।<note caller="+" style="f"><char style="fr" closed="false">39:12 </char><char style="ft" closed="false">इब्रानी 11:13</char></note><verse eid="PSA 39:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 39:13" />इजी ते पईले कि आऊँ मरी जाऊँ ओर रऊँ नि,</para>
  <para style="q" vid="PSA 39:13">मां पाँदे गुस्से ऊणा बन्द करी देओ ताकि आऊँ खुशिया री जिन्दगी पाई सकूँ।<verse eid="PSA 39:13" /></para>
  <chapter eid="PSA 39" />
  <chapter number="40" style="c" sid="PSA 40" />
  <para style="s">स्तुतिया रा एक गाणा</para>
  <para style="d">बजाणे वाल़े रे परदानो रिया तँईं दाऊदो रा पजन</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 40:1" />आऊँ सब्रो साथे प्रभुए खे न्याल़दा रया;</para>
  <para style="q" vid="PSA 40:1">ओर तिने मेरी तरफा खे त्यान दित्तेया ओर मेरी दुहाई सुणी।<verse eid="PSA 40:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 40:2" />तिने आऊँ चीकड़ ओर चीकड़ो ते परे गड्डे ते बारे खिंजी ता,</para>
  <para style="q" vid="PSA 40:2">तिने मेरे पैर चट्टानी पाँदे मजबूत कित्ते। ताकि आऊँ ठीक टंगो दे चली सकूँ ओर खरीसड़ू नि।<verse eid="PSA 40:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 40:3" />यहोवे माखे एक नवां गाणा सिखाया, जो म्हारे परमेशरो री स्तुतिया रा गाणा ए।</para>
  <para style="q" vid="PSA 40:3">बऊत लोक देखी की डरने ओर तिना प्रभुए पाँदे परोसा राखणा।<note caller="+" style="f"><char style="fr" closed="false">40:3 </char><char style="ft" closed="false">प्रकाशित 5:9, प्रकाशित 14:3, पजन 52:6</char></note><verse eid="PSA 40:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 40:4" />से माणूं बऊत ई तन्य ए, जो प्रभुए पाँदे परोसा करोआ,</para>
  <para style="q" vid="PSA 40:4">ओर मूर्तिया री तरफा खे नि मुड़दे या चूठे देवतेया री पूजा करने वाल़ेया बीचे शामल नि ऊँदे।<verse eid="PSA 40:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 40:5" />ओ मेरे प्रभु परमेशर, तैं आसा रिया तँईं बऊत सारे काम करी राखे!</para>
  <para style="q" vid="PSA 40:5">जो अचम्बे रे काम ओर इच्छा तूँ म्हारिया तँईं करेया सेयो बऊत सारिया ए;</para>
  <para style="q" vid="PSA 40:5">जे आँऊ तिजी रे बारे लोका खे बताऊँ तो आँऊ बतांदे-बतांदे थकी जाणा कऊँकि तिना री गिणती नि ऊई सकदी।</para>
  <para style="q" vid="PSA 40:5">प्रभु, तां जेड़ा कोई नि ए!<verse eid="PSA 40:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 40:6" />तूँ मेलबलि ओर नज्जो री बलिया ते खुश नि ऊँदा,</para>
  <para style="q" vid="PSA 40:6">तैं मेरे कान खोले ताकि आँऊ बिधानो रा पालण करुँ।<verse eid="PSA 40:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 40:7" />ओर इजी री खातर मैं ये ज्वाब दित्तेया, “हे परमेशर, देख आऊँ एथी आ,</para>
  <para style="q" vid="PSA 40:7">कऊँकि कताबा रे मेरे बारे एड़ा ईए लिखेया रा।”<verse eid="PSA 40:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 40:8" />ओ मेरे परमेशर, आऊँ तेरी इच्छा पूरी करने ते खुश ए</para>
  <para style="q" vid="PSA 40:8">ओर तेरा बिधान मेरे दिलो रे ए।<note caller="+" style="f"><char style="fr" closed="false">40:8 </char><char style="ft" closed="false">इब्रानी 10:5-7</char></note><verse eid="PSA 40:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 40:9" />जेबे बी तुसा रे लोक कट्ठा ओए, मैं तिना खे बताई राखेया कि तैं आसे किंयाँ बचाई राखे। यहोवा, तूँ जाणेआ कि आऊँ तिना तर्मिया लोका खे बताणे ते नि डरदा।<note caller="+" style="f"><char style="fr" closed="false">40:9 </char><char style="ft" closed="false">22.25; 35.18</char></note><verse eid="PSA 40:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 40:10" />मैं तेरी तार्मिकता आपणे दिलो रेई नि राखी; बल्कि तेरी सच्चाई</para>
  <para style="q" vid="PSA 40:10">ओर तेरे उद्धारो री चर्चा करी राखी; मैं तेरी करूणा ओर सच्चाई बड़ी सभा ते गुप्त नि राखी।<verse eid="PSA 40:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 40:11" />ओ प्रभु, तूँ आपणी बड़ी दया मां पाँदा ते नि टाया,</para>
  <para style="q" vid="PSA 40:11">तेरी करूणा ओर सच्चाईया ते लगातार मेरी रक्षा ऊँदी रओ!<verse eid="PSA 40:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 40:12" />मेरे जीवनो दे अणगिणत समस्या ए।</para>
  <para style="q" vid="PSA 40:12">मेरे पाप मेरे चऊँ कनारे ए, ओर माखे आपणी बाट नि लगी री मिलणे।</para>
  <para style="q" vid="PSA 40:12">मेरे पाप मेरे सिरो रे बाल़ा री गिणतिया ते जादा ए,</para>
  <para style="q" vid="PSA 40:12">ओर इजी री बजा ते मेरा दिल दु:खी ए।</para>
  <para style="q" vid="PSA 40:12">बुरे काम गिणतिया रे मेरे‍ सिरो रे बाल़ा ते बी जादा ए, तेबेई तो मेरा दिल दु:खी आ।<verse eid="PSA 40:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 40:13" />ओ प्रभु, मईरबानी करी की माखे छुड़ाई लओ!</para>
  <para style="q" vid="PSA 40:13">ओ प्रभु, मेरी मताद करने रिया तँईं फुर्ती करी दे!<verse eid="PSA 40:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 40:14" />जो लोक माखे काणा चाओए, सब शर्मिंदा ओ ओर तिना री बेज्जती ओ;</para>
  <para style="q" vid="PSA 40:14">जो मेरे नुकशाणो ते खुश ओए सेयो नठाए जाओ</para>
  <para style="q" vid="PSA 40:14">ओर तिना रा नरादर कित्तेया जाओ।<verse eid="PSA 40:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 40:15" />मेरी इच्छा ए कि जो लोक मेरा मजाक उडाओए,</para>
  <para style="q" vid="PSA 40:15">तेरे जरिए आरने ते बेज्जत ओ।<verse eid="PSA 40:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 40:16" />पर जितणे लोक तांगे आओए, सेयो सब तेरिया बजा ते खुश ओर आनंदित ओ;</para>
  <para style="q" vid="PSA 40:16">जो तेरे कित्ते रे उद्धारो ते प्यार करोए, सेयो सदा बोलदे रओ, “प्रभुए री तारीफ ओ।”<verse eid="PSA 40:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 40:17" />आऊँ तो दु:खी ओर गरीब ए, तेबे बी प्रभु मेरी चिन्ता करोआ।</para>
  <para style="q" vid="PSA 40:17">तूँ मेरा मतदगार ओर माखे छुड़ाणे वाल़ा ए; ओ मेरे परमेशर मेरी मताद कर।<verse eid="PSA 40:17" /></para>
  <chapter eid="PSA 40" />
  <chapter number="41" style="c" sid="PSA 41" />
  <para style="s">रोगी माणूंए री प्रार्थना</para>
  <para style="d">बजाणे वाल़े परदानो रिया तँईं दाऊदो रा पजन</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 41:1" />से मर्द बऊत ई तन्य ए जो गरीब लोका री सम्बाल़ लओआ! बिपदा रे बखते यहोवे से बचाणा।<verse eid="PSA 41:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 41:2" />प्रभुए तेसरी रक्षा करी की से जिऊँदा राखणा ओर से तरतिया पाँदे भाग्यशाली ऊणा। प्रभुए सेयो तिना रे दुश्मणा ते बचाणे।<verse eid="PSA 41:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 41:3" />जेबे से बमारिया रिया बजा ते माँजे पाँदे पड़ेया रा ऊणा, तेबे प्रभुए से सम्बाल़ना; तां से बमारिया ते पुरिया तरअ ते ठीक करना।<verse eid="PSA 41:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 41:4" />मैं बिनती कित्ती, “ओ प्रभु! मां पाँदे दया कर; माखे तन्दरूस्त कर, कऊँकि मैं तो तेरे खलाफ पाप करी राखेया।”<verse eid="PSA 41:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 41:5" />मेरे दुश्मण मेरे बारे दे दुष्टता साथे ये बोलोए: “से कदी मरना ओर तेसरा नाओं कदी मिटणा?”<verse eid="PSA 41:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 41:6" />जो लोक माखे मिलणे आओए, सेयो ईमानदार नि ए, सेयो मेरे बारे दे बुरिया खबरा कट्ठिया करोए ओर फेर बारे जाई की लोका बीचे तिना री चर्चा करोए।<verse eid="PSA 41:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 41:7" />मेरे सारे बैरी मिली की मेरे खलाफ चूगलिया करोए; सेयो मेरे खलाफ ऊई की मेरे नुकशाणो रे बारे सोचोए।<verse eid="PSA 41:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 41:8" />सेयो दुष्ट लोक बोलोए कि एसखे तो कोई बुरी बमारी लगी गी री, एबे जो ये लेटीगा रा, फेर कदी बी ये उठी नि सकदा।<verse eid="PSA 41:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 41:9" />मेरा प्यारा दोस्त जेस पाँदे आऊँ परोसा राखूँ था, जो मेरी रोटी खाओ था, तिने बी मेरे खलाफ बोलेया।<note caller="+" style="f"><char style="fr" closed="false">41:9 </char><char style="ft" closed="false">2 शमूएल 15:12, यूह. 13:18, प्रेरित 1:16</char></note><verse eid="PSA 41:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 41:10" />पर ओ यहोवा, तूँ मां पाँदे दया करी की माखे ठीक करी दे, ताकि आऊँ तिना ते बदला लई सकूँ।<verse eid="PSA 41:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 41:11" />मेरा दुश्मण जो मांते जीती नि सकदा, इजी ते मैं जाणी ला कि तूँ मांते खुश ए।<verse eid="PSA 41:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 41:12" />तां मेरी मताद करनी, कऊँकि आऊँ सेई करूँआ जो सई ए: तां आऊँ सदा खे आपू सामणे राखणा।<verse eid="PSA 41:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 41:13" />इस्राएलो रा प्रभु परमेशर शुरूए ते लई की जुगो-जुगो तक तन्य ए, आमीन्, फेर आमीन्।<note caller="+" style="f"><char style="fr" closed="false">41:13 </char><char style="ft" closed="false">लूक 1:68, पजन 106:48</char></note><verse eid="PSA 41:13" /></para>
  <chapter eid="PSA 41" />
  <chapter number="42" style="c" sid="PSA 42" />
  <para style="ms">दूजा इस्सा</para>
  <para style="mr">
    <ref loc="PSA 42-72">पजन 42-72</ref></para>
  <para style="s">परमेशरो रिया तँईं इच्छा</para>
  <para style="d">बजाणे वाल़े परदानो रिया तँईं कोरह वंशिया रा मश्कील</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 42:1" />ईरणी जिंयाँ नदिया रे पाणिए खे तड़फोई,</para>
  <para style="q" vid="PSA 42:1">तिंयाँ ई ओ परमेशर, आऊँ बी तेरिया तँईं तड़फुआ।<verse eid="PSA 42:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 42:2" />आऊँ तेरिया तँईं त्याया ए, ओ जिऊँदे परमेशर।</para>
  <para style="q" vid="PSA 42:2">आऊँ कदी तेरे सामणे जाई की आराधना करी सकूँआ?<note caller="+" style="f"><char style="fr" closed="false">42:2 </char><char style="ft" closed="false">पजन 63:1, प्रकाशित 22:4</char></note><verse eid="PSA 42:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 42:3" />मेरे आसू ई रात-दिन मेरी रोटी बणीगे ओर मेरे दुश्मण लगातार मांते पूछदे रओए कि तेरा परमेशर केई ए?<verse eid="PSA 42:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 42:4" />जेबे माखे याद आओई कि पईले मेरी जिन्दगी केड़ी थी, तो आऊँ बऊत दु:खी ऊई जाऊँआ ओर रोऊँआ।</para>
  <para style="q" vid="PSA 42:4">आऊँ लोका री बऊत पारी पीड़ा साथे परमेशरो रे मन्दरो दे तेसरी आराधना करने खे जाया करुँ था।</para>
  <para style="q" vid="PSA 42:4">मैं तेती लोका ते आगे जाई कि खुशिया रे गाणे गाए ओर आसे जोरे-जोरे की परमेशरो री तारीफ करेया करुँ थे।<verse eid="PSA 42:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 42:5" />इजी री खातर आऊँ आपणे आपू ते पूछूँआ, “आऊँ इतणा उदास ओर परेशान कऊँ ए?”</para>
  <para style="q" vid="PSA 42:5">माखे परमेशरो से मताद पाणे रिया तँईं थोड़ा इन्तजार करना चाईयो।</para>
  <para style="q" vid="PSA 42:5">तेबे मां एक बार फेर आपणे परमेशरो री स्तुति करनी, कऊँकि सेई माखे बचाणे वाल़ा ए।<note caller="+" style="f"><char style="fr" closed="false">42:5 </char><char style="ft" closed="false">मत्ती 26:38, मरक 14:34, यूह. 12:27</char></note><verse eid="PSA 42:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 42:6" />ओ मेरे परमेशर, आपणे पीतरा ते दु:खी आ जेबे आऊँ तेरे बारे दे सोचूँआ,</para>
  <para style="q" vid="PSA 42:6">तेथा ते जेथा ते यरदन नदी हेर्मोन पाह्ड़ो ते शुरू ओई ओर मीजार पाह्ड़ो ते।<verse eid="PSA 42:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 42:7" />तेरे पाणिए रा शब्द सुणी की पाणी, पाणिए खे आका पाओआ,</para>
  <para style="q" vid="PSA 42:7">तेरिया सारिया तरंगा ओर लईरा रे आऊँ डूबी गा रा।<verse eid="PSA 42:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 42:8" />तेबे बी प्रभुए दिने आपणी दया ओर करूणा प्रगट करनी;</para>
  <para style="q" vid="PSA 42:8">ओर राती बी मां तेसरा गीत गाणा</para>
  <para style="q" vid="PSA 42:8">ओर माखे जिन्दगी देणे वाल़े प्रभुए ते मां प्रार्थना करनी।<verse eid="PSA 42:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 42:9" />मां आपणे प्रभुए ते जो माखे चट्टानी जेड़ा ए पूछणा, “तैं आँऊ कऊँ पुलाईता?</para>
  <para style="q" vid="PSA 42:9">आऊँ दुश्मणा रे अत्याचारो रिया बजा ते कऊँ शोगो साथे चलेया करूँआ?”<verse eid="PSA 42:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 42:10" />मेरेया बैरिया रे तानेया ते आऊँ दबणे लगी रा,</para>
  <para style="q" vid="PSA 42:10">ओर सेयो लगातार मांते पूछदे रओए, “तेरा परमेशर केई ए?”<verse eid="PSA 42:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 42:11" />आऊँ आपणे आपू ते फेर पूछूँआ, आऊँ इतणा उदास ओर परेशान कऊँ आ?</para>
  <para style="q" vid="PSA 42:11">माखे परमेशरो ते मताद पाणे रिया तँईं थोड़ी देर इन्तजार करना चाईयो।</para>
  <para style="q" vid="PSA 42:11">तेबे मां एक बार आपणे परमेशरो री स्तुति करनी, कऊँकि सेई माखे बचाणे वाल़ा ए।<verse eid="PSA 42:11" /></para>
  <chapter eid="PSA 42" />
  <chapter number="43" style="c" sid="PSA 43" />
  <para style="s">बिपदा रे बखते प्रार्थना</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 43:1" />ओ परमेशर, मेरा न्याय कर ओर पापी लोका साथे मेरा मकद्दमा लड़;</para>
  <para style="q" vid="PSA 43:1">माखे चूठ बोलणे वाल़े ओर बुरे माणूंआ ते बचा।<verse eid="PSA 43:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 43:2" />कऊँकि ओ परमेशर, तूँई मेरी शरण लणे री जगा ए, तैं आऊँ कऊँ छाडीता?</para>
  <para style="q" vid="PSA 43:2">मेरेया दुश्मणा रे अत्याचारो रिया बजा ते माखे लगातार कऊँ दु:ख सईणा पड़ोआ?<verse eid="PSA 43:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 43:3" />तूँ माखे आपणी जोति ओर सच्चाईया खे पेज; ताकि तेतेरे जरिए आऊँ तेरे पवित्र पाह्ड़ सिय्योन ओर तेरे मन्दरो दे वापस पऊँची सकूँ जेती तूँ रएआ।<verse eid="PSA 43:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 43:4" />तेबे मां परमेशरो रिया बेदिया गे जाणा,</para>
  <para style="q" vid="PSA 43:4">तेरी आराधना करनी, जो माखे खुश करोआ।</para>
  <para style="q" vid="PSA 43:4">तूँ मेरा परमेशर आ ओर तेती मां तेरी तारीफ करनी। मां आपणियां बीणा साथे, परमेशर, तन्यवाद देणे रिया तँईं गाणा।<verse eid="PSA 43:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 43:5" />आऊँ दु:खी कऊँ आ? आऊँ बेचैन कऊँ आ? माखे तां पाँदे परोसा ए!</para>
  <para style="q" vid="PSA 43:5">ओर मां फेर तेरी तारीफ करनी कऊँकि तूँ मेरी मताद करेया, ओर तूँ मेरा परमेशर ए। तूँ माखे बचाएआ।<verse eid="PSA 43:5" /></para>
  <chapter eid="PSA 43" />
  <chapter number="44" style="c" sid="PSA 44" />
  <para style="s">इस्राएलो री शकाईत</para>
  <para style="d">बजाणे वाल़े परदानो रिया तँईं कोरह वंशिया रा मश्कील</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 44:1" />ओ परमेशर, आसे आपणे काने की सुणेया, म्हारे बुजुर्ग आसा गे ये बताओ थे</para>
  <para style="q" vid="PSA 44:1">कि तैं तिना रे बखतो दे ओर पुराणे बखतो दे क्या-क्या काम करी राखे।<verse eid="PSA 44:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 44:2" />तैं आपणे आथो साथे देशो रे लोक निकयाल़े ओर यो बसाए;</para>
  <para style="q" vid="PSA 44:2">तैं देशो-देशो रे लोका खे दु:ख दित्तेया ओर यो चऊँ कनारे फैलाईते;<verse eid="PSA 44:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 44:3" />म्हारे बुजुर्ग ना तो आपणी तलवारी रे बलो ते एते देशो रे अक्कदार ऊए ओर ना ई आपणी बांई री तागती साथे;</para>
  <para style="q" vid="PSA 44:3">बल्कि तेरे दाँणे आथ ओर तेरी बां ओर तेरे खुश मुंए रिया बजा ते जीती गे; कऊँकि तूँ तिना ते खुश था।<verse eid="PSA 44:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 44:4" />ओ परमेशर, तूँई म्हारा महाराजा ए; तूँई आपणी प्रजा इस्राएलो खे उद्धार दलाणे वाल़ा परमेशर ए।<verse eid="PSA 44:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 44:5" />आसा तेरिया तागती रे साअरे आपणे दुश्मण पीछे तकेली की रूड़ाई देणे; आसा तेरे नाओं रे प्रतापो साथे आपणे बरोदी केसी देणे।<verse eid="PSA 44:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 44:6" />माखे आपणे धनुषो पाँदे परोसा नि ए ओर ना ई मेरी तलवार माखे बचाई सकोई।<verse eid="PSA 44:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 44:7" />पर तैंई आसे म्हारे बरोदिया ते बचाए ओर म्हारे बैरी दु:खी ओर शर्मिंदा कित्ते।<verse eid="PSA 44:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 44:8" />आसे लगातार तां परमेशरो री तारीफ करदे रऊँए ओर सदा तेरे नाओं रा तन्यवाद करदे रणे। सेला<verse eid="PSA 44:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 44:9" />तेबे बी तैं एबे आसे छाडी ते रे ओर म्हारा बेज्जती करी राखेया</para>
  <para style="q" vid="PSA 44:9">ओर म्हारिया सेना साथे आगे नि गया।<verse eid="PSA 44:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 44:10" />एबे आसा खे आपणे दुश्मणा रे सामणे ते नठणा पड़ी रा,</para>
  <para style="q" vid="PSA 44:10">सेयो आसा रिया सबी चीजा खे लूटी की लई जाओए।<verse eid="PSA 44:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 44:11" />तैं आसे कसाईये री पेडा जेड़े करीते रे,</para>
  <para style="q" vid="PSA 44:11">ओर आसे कईया देशा रे बखेरी ते।<verse eid="PSA 44:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 44:12" />तैं आपणी प्रजा रे लोक सस्ते रेई बेचीते,</para>
  <para style="q" vid="PSA 44:12">जिंयाँ कि तिना री कुछ बी कीमत नि ए!<verse eid="PSA 44:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 44:13" />तैं आसे म्हारे पड़ोसिया बीचे मूर्ख बणाईते ओर म्हारे चऊँ कनारे रणे वाल़ेया रिया नजरा रे आसे आसिया जोगे करीते।<verse eid="PSA 44:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 44:14" />तैं आसे देशा बीचे एक मजाक बणाईते;<note caller="+" style="f"><char style="fr" closed="false">44:14 </char><char style="ft" closed="false">दूजिया जातिया रे लोक</char></note></para>
  <para style="q" vid="PSA 44:14">सेयो आसा रा मजाक उडाओए।<verse eid="PSA 44:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 44:15" />कलंक लगाणे वाल़े ओर निंदा करने वाल़ेया रे बोलो ते</para>
  <para style="q" vid="PSA 44:15">लगातार आसा खे तिरस्कार सईणा पड़ोआ,<verse eid="PSA 44:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 44:16" />दुश्मण ओर बदला लणे वाल़े रिया मौजुदगिया री बजा ते,</para>
  <para style="q" vid="PSA 44:16">बुरा-पला बोलणे वाल़े ओर निंदा करने वाल़े रिया बजा ते।<verse eid="PSA 44:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 44:17" />ये सब कुछ आसा पाँदे बितेया तेबे बी आसे ताखे नि पूले,</para>
  <para style="q" vid="PSA 44:17">ओर ना ई आसे से वाचा तोड़ी जो तैं आसा साथे करी राखी थी।<verse eid="PSA 44:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 44:18" />आसे तूँ हमेशा आपणे दिलो दे राखेया,</para>
  <para style="q" vid="PSA 44:18">ओर तेरिया शिक्षा रा पाल़न कित्तेया;<verse eid="PSA 44:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 44:19" />पर तेबे बी तैं आसे दबाईते</para>
  <para style="q" vid="PSA 44:19">ओर आसे अन्दकूप न्हेरे दे बेसारा करी की छाडी ते जेती जंगल़ी जानवर रओए।<verse eid="PSA 44:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 44:20" />आसे ताखे कदी नि पूले,</para>
  <para style="q" vid="PSA 44:20">या केसी ओरी देवते ते प्रार्थना नि कित्ती,<verse eid="PSA 44:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PSA 44:21" />जे आसे एड़ा कित्तेया ऊँदा तो परमेशरो खे पता लगी जाणा था,</para>
  <para style="q" vid="PSA 44:21">कऊँकि तूँ सबी गुप्त गल्ला खे जाणोआ।<verse eid="PSA 44:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="PSA 44:22" />पर आसे तेरे लोक ऊणे रिया बजा ते म्हारे दुश्मण आसा खे लगातार काणे लगी रे।</para>
  <para style="q" vid="PSA 44:22">तिना रिया नजरा दे आसे फाटणे वाल़िया पेडा जेड़े समजे जाऊँए।<note caller="+" style="f"><char style="fr" closed="false">44:22 </char><char style="ft" closed="false">रोमी 8:36</char></note><verse eid="PSA 44:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="PSA 44:23" />ओ प्रभु, जाग! तूँ कऊँ सऊणे लगी रा?</para>
  <para style="q" vid="PSA 44:23">उठ! आसा खे सदा खे नि छाड!<verse eid="PSA 44:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="PSA 44:24" />तूँ आपणा मूँ कऊँ लकोई देया</para>
  <para style="q" vid="PSA 44:24">ओर म्हारा दु:ख ओर कष्ट पूली जाएया?<verse eid="PSA 44:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="PSA 44:25" />म्हारे प्राण माट्टिया रे मिली गे;</para>
  <para style="q" vid="PSA 44:25">म्हारा पेट जमीना साथे चिपकी गा।<verse eid="PSA 44:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="PSA 44:26" />उठ, ओर म्हारी मताद कर!</para>
  <para style="q" vid="PSA 44:26">आपणी करूणा रे मुताबिक आसा खे छुड़ाई लओ।<verse eid="PSA 44:26" /></para>
  <chapter eid="PSA 44" />
  <chapter number="45" style="c" sid="PSA 45" />
  <para style="s">राजे रिया तँईं ब्याओ रा गीत</para>
  <para style="d">बजाणे वाल़े परदानो रिया तँईं शोशन्नीम रागो रे कोरह वंशिया रा मश्कील। प्यारो रा गीत</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 45:1" />जिंयाँ मैं राजे रिया तँईं नवां गाणा त्यार करी राखेया, मेरा दिल शब्दा ते परी रा।</para>
  <para style="q" vid="PSA 45:1">एक अच्छे लेखको रिया कलमा रे जेड़े मेरी जीब एक कविता साथे त्यार ए।<verse eid="PSA 45:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 45:2" />तूँ माणूंआ री ल्वादा बीचे बऊत ई सुन्दर ए;</para>
  <para style="q" vid="PSA 45:2">तेरे ओठा ते मिठे बोल निकल़ोए;</para>
  <para style="q" vid="PSA 45:2">इजी रिया तँईं परमेशरे ताखे जुगो-जुगो खे आशीष देई राखी।<note caller="+" style="f"><char style="fr" closed="false">45:2 </char><char style="ft" closed="false">लूक 4:22, इब्रानी 1:3,4</char></note><verse eid="PSA 45:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 45:3" />ओ वीर राजा! तूँ आपणी तलवारी ऊबे चक, तूँ महान ओर प्रतापी ए,<verse eid="PSA 45:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 45:4" />सच्चाई, नम्रता ओर तार्मिकता रिया तँईं आपणे एश्वर्य</para>
  <para style="q" vid="PSA 45:4">ओर प्रतापो पाँदे सफलता साथे सवार ओ;</para>
  <para style="q" vid="PSA 45:4">कऊँकि तूँ तागतबर ए, तां खतरनाक ओर नौखे काम करने।<verse eid="PSA 45:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 45:5" />तेरे तीर तो पईने ए, तिना बाणा ते राजे रे दुश्मणा रे दिल बीनी जाणे;</para>
  <para style="q" vid="PSA 45:5">तेरे पैरा पाँदे देशो-देशो रे लोक पड़ने।<verse eid="PSA 45:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 45:6" />ओ परमेशर, तेरा सिंहासन जुगो-जुगो तक बणेया रा रणा;</para>
  <para style="q" vid="PSA 45:6">तेरा राजदण्ड न्याय रा राजदण्ड ए।<verse eid="PSA 45:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 45:7" />तूँ तार्मिकता साथे प्यार ओर बुरे कामा साथे बैर राखेया।</para>
  <para style="q" vid="PSA 45:7">इजी बजा ते परमेशरे, आ तेरे परमेशरे तूँ तेरे साथिया ते लग करी की</para>
  <para style="q" vid="PSA 45:7">खुशिया रे तेलो साथे तेरा अभिषेक करी राखेया।<note caller="+" style="f"><char style="fr" closed="false">45:7 </char><char style="ft" closed="false">इब्रानी 1:8,9</char></note><verse eid="PSA 45:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 45:8" />तेरे सारे टाल्ले गन्धरस, अगर ओर तेजपते साथे खुशबूदार ए,</para>
  <para style="q" vid="PSA 45:8">तूँ आथिया रे दाँदा वाल़े मईलो दे तारा वाल़े बाजे रिया बजा ते खुश ऊईरा।<verse eid="PSA 45:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 45:9" />तेरिया सम्मानित जवाणसा बीचे राजकुमारिया बीए;</para>
  <para style="q" vid="PSA 45:9">तेरे दाँणे कनारे पटराणी, जो ओपीरो रे कुन्दनो साथे सजी री खड़ी री।<verse eid="PSA 45:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 45:10" />ओ राजकुमारी सुण, ओर बचार कर ओर त्यान दे;</para>
  <para style="q" vid="PSA 45:10">आपणे लोका खे ओर आपणे पेऊके खे पूली जा;<verse eid="PSA 45:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 45:11" />तेबे राजे तेरे रूपो री चाईणा करनी।</para>
  <para style="q" vid="PSA 45:11">कऊँकि से तो तेरा प्रभु ए,</para>
  <para style="q" vid="PSA 45:11">तूँ तेस सामणे आपणा सिर चूका।<verse eid="PSA 45:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 45:12" />सोर प्रदेशो री राजकुमारी बी मिलणे खे आऊणी।</para>
  <para style="q" vid="PSA 45:12">प्रजा रे अमीर लोका ताखे खुश करने री कोशिश करनी।<verse eid="PSA 45:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 45:13" />राजकुमारी मईलो रे बऊत ई शोभा देओई,</para>
  <para style="q" vid="PSA 45:13">तेसा रे टाल्लेया पाँदे सूईने साथे कढ़ाई करी राखी।<verse eid="PSA 45:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 45:14" />से बूटेदार कढ़ाई कित्ते रे टाल्ले पईनी की राजे गे पऊँचाई जाणी।</para>
  <para style="q" vid="PSA 45:14">जो कुआँरिया तेसा रिया सेलिया ए,</para>
  <para style="q" vid="PSA 45:14">सेयो तेसा पीछे-पीछे चलदिया ऊईया तांगे पऊँचाईया जाणिया।<verse eid="PSA 45:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 45:15" />सेयो आनंद ओर खुशिया साथे पऊँचाईया जाणिया,</para>
  <para style="q" vid="PSA 45:15">ओर तिना राजे रे मईलो रे प्रवेश करना।<verse eid="PSA 45:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 45:16" />मेरे राजा तेरे बऊत बाल-बच्चे ऊणे, सेयो बी तेड़े ई राजा ऊणे जेड़े तेरा बाओ ओर दादे थे।</para>
  <para style="q" vid="PSA 45:16">तां तिना खे तरतिया दे युगो-युगो रा हाकिम ठराणा।<verse eid="PSA 45:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 45:17" />ओर जेथो तक मेरी गल्ल ए, मां एड़ा करना कि तेरे नाओं री चर्चा पीढ़िया ते पीढ़िया तक ऊँदी रणी;</para>
  <para style="q" vid="PSA 45:17">ओर लोका तेरी हमेशा खे तारीफ करनी।<verse eid="PSA 45:17" /></para>
  <chapter eid="PSA 45" />
  <chapter number="46" style="c" sid="PSA 46" />
  <para style="s">परमेशर आसा रा शरण लणे री जगा ए</para>
  <para style="d">बजाणे वाल़े परदानो रिया तँईं कोरह वंशिया रा अलामोतो रे रागो पाँदे एक गीत</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 46:1" />परमेशर म्हारा शरण लणे री जगा ओर तागत ए,</para>
  <para style="q" vid="PSA 46:1">हमेशा मुसीबता रे बखते मताद करने खे त्यार रओआ।<verse eid="PSA 46:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 46:2" />इजी खे आसा नि डरना,</para>
  <para style="q" vid="PSA 46:2">चाए तरती पल्टी जाओ ओर पाह्ड़ समुद्रो बीचे डूबी जाओ।<verse eid="PSA 46:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 46:3" />चाए समुद्रो रा पाणी बड़ा पारी शाद करो</para>
  <para style="q" vid="PSA 46:3">ओर लईरा उठो ओर पाह्ड़ तिजी री बाढ़ा ते थरथराई जाओ।<note caller="+" style="f"><char style="fr" closed="false">46:3 </char><char style="ft" closed="false">लूक 21:25, मत्ती 7:25</char></note> सेला<verse eid="PSA 46:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 46:4" />एक नदी ए जेतेरिया पाणिए रिया ताअरा परमेशरो रे शईरो खे,</para>
  <para style="q" vid="PSA 46:4">परमपरदानो रे पवित्र रणे रे मईलो रे खुशी देओई।<verse eid="PSA 46:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 46:5" />परमेशर तेस शईरो<note caller="+" style="f"><char style="fr" closed="false">46:5 </char><char style="ft" closed="false">यरूशलेम</char></note> रे बीचे ए,</para>
  <para style="q" vid="PSA 46:5">ओर तीजी खे कदी बी नाश नि करी सकदे।</para>
  <para style="q" vid="PSA 46:5">जेबे तड़का ऊणा, तेबे परमेशरो तीजी री मताद करने खे तेती ऊणा।<verse eid="PSA 46:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 46:6" />जातिया-जातिया रे लोक डरने लगी रे;</para>
  <para style="q" vid="PSA 46:6">राज्य-राज्य रे लोक डगमगाणे लगे;</para>
  <para style="q" vid="PSA 46:6">पर परमेशरो रे शब्द बोलदे ई तरती गल़ी जाओई।<note caller="+" style="f"><char style="fr" closed="false">46:6 </char><char style="ft" closed="false">प्रकाशित 11:18, पजन 2:1</char></note><verse eid="PSA 46:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 46:7" />स्वर्गिय सेनाओं रा प्रभु आसा साथे ए;</para>
  <para style="q" vid="PSA 46:7">याकूबो रा परमेशर म्हारा ऊच्चा गढ़ ए। सेला<verse eid="PSA 46:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 46:8" />आओ ओर देखो यहोवे क्या करी राखेया।</para>
  <para style="q" vid="PSA 46:8">देखो कि तिने तरतिया पाँदे क्या नौखे काम करी राखे।<verse eid="PSA 46:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 46:9" />से तरतिया रे एकी कनारे ते दूजे कनारे तक युद्ध बन्द करी देओआ;</para>
  <para style="q" vid="PSA 46:9">से धनुषो खे तोड़ोआ ओर भाल़े रे टुकड़े-टुकड़े करी देओआ</para>
  <para style="q" vid="PSA 46:9">ओर रथा खे आगी रे पाई की स्वा करी देओआ।<verse eid="PSA 46:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 46:10" />“चुप ऊई जाओ ओर जाणी लओ कि आऊँ ई परमेशर ए।</para>
  <para style="q" vid="PSA 46:10">आऊँ सबी देशा बीचे महान ए,</para>
  <para style="q" vid="PSA 46:10">आऊँ पुरिया तरतिया पाँदे महान ए!”<verse eid="PSA 46:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 46:11" />स्वर्गिय सेनाओं रा प्रभु आसा साथे ए;</para>
  <para style="q" vid="PSA 46:11">याकूबो रा परमेशर म्हारा ऊच्चा गढ़ ए। सेला<verse eid="PSA 46:11" /></para>
  <chapter eid="PSA 46" />
  <chapter number="47" style="c" sid="PSA 47" />
  <para style="s">परमेशर म्हारा राजा</para>
  <para style="d">बजाणे वाल़े परदानो रिया तँईं कोरह वंशिया रा पजन</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 47:1" />ओ देशो-देशो रे लोको, खुशिया साथे चाड़िया बजाओ!</para>
  <para style="q" vid="PSA 47:1">ऊच्चिया आवाजा रे परमेशरो री जयजयकार करो!<verse eid="PSA 47:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 47:2" />कऊँकि प्रभु, परमपरदान परमेशर डरो जोगा ए;</para>
  <para style="q" vid="PSA 47:2">से सारी तरतिया रा महान राजा ए।<verse eid="PSA 47:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 47:3" />तिने म्हारे दुश्मणा रे खलाफ लड़ाई जीती ली ए,</para>
  <para style="q" vid="PSA 47:3">ओर तेसा जातिया रे लोक म्हारे कब्जे दे ए।<verse eid="PSA 47:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 47:4" />तिने आसा खे ये जमीन छाँटी जेती एबे आसे रऊँए;</para>
  <para style="q" vid="PSA 47:4">आसे इस्राएली लोक जिना खे से प्यार करोआ, कमण्ड ए कि आसे एस देशो रे मालक ए। सेला<verse eid="PSA 47:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 47:5" />जेबे लोक जयजयकार करोए ओर रड़सिंगे बजाओए,</para>
  <para style="q" vid="PSA 47:5">तेबे परमेशर आपणे सिंहासणो पाँदे विराजमान ओआ।<note caller="+" style="f"><char style="fr" closed="false">47:5 </char><char style="ft" closed="false">लूक 24:51, यूह. 6:62, प्रेरित 1:9, पजन 68:1,2</char></note><verse eid="PSA 47:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 47:6" />परमेशरो रा पजन गाओ, पजन गाओ!</para>
  <para style="q" vid="PSA 47:6">म्हारे महाराजे रा पजन गाओ, पजन गाओ!<verse eid="PSA 47:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 47:7" />कऊँकि परमेशर सारी तरतिया रा महाराजा ए,</para>
  <para style="q" vid="PSA 47:7">तेसरा पजन गायी कि जय-जयकार करो।<verse eid="PSA 47:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 47:8" />परमेशर देशा-देशा पाँदे राज करोआ;</para>
  <para style="q" vid="PSA 47:8">परमेशर आपणे पवित्र सिंहासनो पाँदे बैठी रा।<note caller="+" style="f"><char style="fr" closed="false">47:8 </char><char style="ft" closed="false">पजन 96:10, प्रकाशित 19:6</char></note><verse eid="PSA 47:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 47:9" />अब्राहमो रे परमेशरो री प्रजा बणने रिया तँईं राज्य-राज्य रे शासक लोक कट्ठे ऊई रे।</para>
  <para style="q" vid="PSA 47:9">कऊँकि तरतिया री ढाला परमेशरो रे वशो रेईया, से तो शिरोमणि ए!<verse eid="PSA 47:9" /></para>
  <chapter eid="PSA 47" />
  <chapter number="48" style="c" sid="PSA 48" />
  <para style="s">सिय्योनो रे परमेशरो री महिमा</para>
  <para style="d">कोरह वंशिया रा पजन</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 48:1" />यहोवा महान ए ओर बऊत तारीफा जोगा ए, म्हारे परमेशरो रे शईरो दे<note caller="+" style="f"><char style="fr" closed="false">48:1 </char><char style="ft" closed="false">यरूशलेम शईर</char></note></para>
  <para style="q" vid="PSA 48:1">तेते शईरो दे जेती से रओआ जो तेते पवित्र पाह्ड़ी सिय्योनो पाँदे बणी रा। सेला<verse eid="PSA 48:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 48:2" />से शईर ऊच्चा ओर सुन्दर ए, से पुरिया तरअ ते खुशी लयाओआ।</para>
  <para style="q" vid="PSA 48:2">सिय्योन पाह्ड़ महान राजे रा शईर ए, ये से जगा ए जेती सच्चा परमेशर रओआ।<note caller="+" style="f"><char style="fr" closed="false">48:2 </char><char style="ft" closed="false">मत्ती 5:35, यिर्मयाह 3:19</char></note><verse eid="PSA 48:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 48:3" />परमेशर एते शईरो रेया लोका री रक्षा करने खे आजीर रओआ ओर एतेरी रक्षा करने वाल़ा साबित ऊआ ए।<verse eid="PSA 48:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 48:4" />कई राजा आपणियां सेना साथे कट्ठे ऊई रे;</para>
  <para style="q" vid="PSA 48:4">तेते शईरो पाँदे अमला करने रिया तँईं,<verse eid="PSA 48:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 48:5" />पर सेयो तेस शईरो खे देखी की हैरान ऊईगे,</para>
  <para style="q" vid="PSA 48:5">सेयो डरो रे मारे थुरने लगे फेर तेथा ते नठीगे।<verse eid="PSA 48:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 48:6" />तेती तिना खे थुरनी छूटी गी</para>
  <para style="q" vid="PSA 48:6">ओर तिना खे तेती पारती जवाणसा रिया जमणे री जिया पीड़ा ऊणे लगिया।<verse eid="PSA 48:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 48:7" />सेयो एड़े थुरीगे जेड़े तर्शीश शईरो खे जाणे वाल़े जाह्ज तेज अवा रिया बजा ते थुरी जाओए। जेड़े ए,</para>
  <para style="q" vid="PSA 48:7">जिना खे पुर्बो री तरफा ते आऊणे वाल़ी पऊण तोड़ी देओई।<verse eid="PSA 48:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 48:8" />आसे सुणेया था कि से शईर बऊत ई सुन्दर ए,</para>
  <para style="q" vid="PSA 48:8">ओर एबे आसे सर्वशक्तिमान परमेशरो रे शईरो खे देखी बी लया,</para>
  <para style="q" vid="PSA 48:8">कि परमेशरो सदा तक तेतेरी रक्षा करनी। सेला<verse eid="PSA 48:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 48:9" />ओ परमेशर, आसे एती तेरे मन्दरो दे त्यान करूँए कि तूँ आसा खे किंयाँ वफादारिया ते प्यार करेया।<verse eid="PSA 48:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 48:10" />तूँ जाणे-मानेया दा ए ओर पुरिया तरतिया रे लोक तेरी तारीफ करोए,</para>
  <para style="q" vid="PSA 48:10">कऊँकि तूँ शक्तिशाली ओर सई न्याय करी की शासन करेया। तेरा दाँणा आथ सदा जीत दलाओआ;<verse eid="PSA 48:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 48:11" />तेरे न्याय रे कामो रिया बजा ते सिय्योन पाह्ड़ खुशी मनाओ</para>
  <para style="q" vid="PSA 48:11">ओर यहूदा प्रदेशो रे लोक मगन ओ!<verse eid="PSA 48:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 48:12" />परमेशरो रे लोको, सिय्योन पाह्ड़ो रे चऊँ कनारे कुमो,</para>
  <para style="q" vid="PSA 48:12">फेर तिजी रे गुम्मट गिणी लओ कि कितणे ए,<verse eid="PSA 48:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 48:13" />तिजी री दवाला पाँदे त्यान करो,</para>
  <para style="q" vid="PSA 48:13">तेथो रे मईल त्यानो साथे देखो,</para>
  <para style="q" vid="PSA 48:13">ताकि तुसे आऊणे वाल़ी पीढ़िया रे लोका गे इजी रे बारे दे बताई सको।<verse eid="PSA 48:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 48:14" />कऊँकि ये परमेशर जुगो-जुगो तक म्हारा परमेशर ए,</para>
  <para style="q" vid="PSA 48:14">तेस म्हारे मरने तक म्हारी अगुवाई करनी।<verse eid="PSA 48:14" /></para>
  <chapter eid="PSA 48" />
  <chapter number="49" style="c" sid="PSA 49" />
  <para style="s">तअन-दौलता पाँदे परोसा राखणे री मूर्खता</para>
  <para style="d">बजाणे वाल़े परदानो रिया तँईं कोरह वंशिया रा पजन</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 49:1" />ओ देशो-देशो रे सारे लोको ये सुणो! ओ दुनिया रे सारे रणे वाल़ेयो, तुसे सब त्यानो देओ!<verse eid="PSA 49:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 49:2" />छोटे-बड़े, तनवान ओ या गरीब, सब माणूं सुणो कि आऊँ क्या करने लगी रा।<verse eid="PSA 49:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 49:3" />आऊँ बुद्धिया रिया गल्ला बोलूँआ;</para>
  <para style="q" vid="PSA 49:3">ओर मेरे दिलो रिया गल्ला समजणे जोगिया ऊणिया।<verse eid="PSA 49:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 49:4" />आऊँ बुद्धिया रिया गल्ला रे बारे दे सोचूँआ,</para>
  <para style="q" vid="PSA 49:4">ओर आऊँ आपणी बीणा बजांदे ऊए तिना बुद्धिया रे वचना रा मतलब बताऊँआ।<verse eid="PSA 49:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 49:5" />बिपदा रे बखते आँऊ नि डरदा</para>
  <para style="q" vid="PSA 49:5">जेबे मेरे दुश्मण माखे चऊँ कनारे ते मेरी बुराई करने खे केरी राखोए।<verse eid="PSA 49:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 49:6" />दुष्ट लोक आपणी सम्पत्तिया पाँदे परोसा राखोए</para>
  <para style="q" vid="PSA 49:6">ओर आपू गे बऊत जादा पैसेया रा कमण्ड करोए,<verse eid="PSA 49:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 49:7" />आसा बीचा ते कोई बी माणूं आपू खे किंयाँ बी छुड़ाई नि सकदा</para>
  <para style="q" vid="PSA 49:7">ओर ना परमेशरो खे आपणे प्राणो रे बदले प्राश्चितो रिया तँईं कुछ कीमत देई सकोआ,<verse eid="PSA 49:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 49:8" />कऊँकि से कीमत बऊत जादा ए,</para>
  <para style="q" vid="PSA 49:8">जेते खे कोई बी नि चुकाई सकदा।<verse eid="PSA 49:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 49:9" />कोई एड़ा नि ए जो सदा जिऊँदा रई सको,</para>
  <para style="q" vid="PSA 49:9">ओर कब्रा रे नि जाओ।<verse eid="PSA 49:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 49:10" />कोई बी देखी सकोए कि अक्लमंद बी मरोए</para>
  <para style="q" vid="PSA 49:10">ओर मूर्ख ओर डांगर सरीखे माणूं दोनो मरी की आपणी सम्पत्ति ओरी खे छाडी जाओए।<verse eid="PSA 49:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 49:11" />तिना री कब्र ई तिना रा सदा रणे वाल़ा कअर ए</para>
  <para style="q" vid="PSA 49:11">तिना गे आपणी जमीन ओर कअर बी था, जेते पाँदे तिना रा नाओं था,<verse eid="PSA 49:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 49:12" />पर माणूं हमेशा खे जिऊँदा नि रंदा, पले ई से बऊत अमीर ओ।</para>
  <para style="q" vid="PSA 49:12">से डांगरो जेड़ा ई मरना।<verse eid="PSA 49:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 49:13" />एड़ा तिना साथे ओआ जो आपणे कामा पाँदे मूर्खता ते परोसा करोए,</para>
  <para style="q" vid="PSA 49:13">जो आपू गे सबी चीजा ते खुश ओए। सेला<verse eid="PSA 49:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 49:14" />सेयो मानो अधलोको रिया पेडा-बाकरिया ठराई राखे,</para>
  <para style="q" vid="PSA 49:14">मौत तिना खे चराणे वाल़ा गाद्दी ठईरनी;</para>
  <para style="q" vid="PSA 49:14">तर्मिया तिना पाँदे राज करना,</para>
  <para style="q" vid="PSA 49:14">सेयो सीदे कब्रा रे चली जाणे</para>
  <para style="q" vid="PSA 49:14">ओर तिना रा शरीर तेती सड़ी जाणा।</para>
  <para style="q" vid="PSA 49:14">अधलोक ई तिना री रणे री जगा ऊणी।<verse eid="PSA 49:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 49:15" />पर परमेशरो आँऊ छुड़ाई लणा;</para>
  <para style="q" vid="PSA 49:15">तेस आँऊ मौता री शक्तिया ते बचाई लणा। सेला<verse eid="PSA 49:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 49:16" />जेबे कोई माणूं अमीर ऊई जाओ</para>
  <para style="q" vid="PSA 49:16">ओर तेसरे कअरो रा मान-सम्मान बढ़ी जाओ,</para>
  <para style="q" vid="PSA 49:16">तेबे तैं डरना नि।<verse eid="PSA 49:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 49:17" />जेबे से मरी जाओआ तेबे से आपू साथे कुछ बी नि लई जाई सकदा</para>
  <para style="q" vid="PSA 49:17">ओर ना ई तेसरा मान-सम्मान<note caller="+" style="f"><char style="fr" closed="false">49:17 </char><char style="ft" closed="false">तअन</char></note> तेस साथे कब्रा रे जाणा।<verse eid="PSA 49:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 49:18" />जदुए तक एक अमीर माणूं जिऊँदा ए से आपू खे तन्यवाद देओआ,</para>
  <para style="q" vid="PSA 49:18">ओर तेसरिया सफलता रिया बजा ते सब लोक तेसरी तारीफ करोए।<verse eid="PSA 49:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 49:19" />तेबे बी से आपणे मरे बुजुर्गा साथे मलाया जाणा,</para>
  <para style="q" vid="PSA 49:19">जेती न्हेरा सदा खे रओआ।<verse eid="PSA 49:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 49:20" />माणूंआ री समज तिना खे मौता ते दूर नि राखी सकदी,</para>
  <para style="q" vid="PSA 49:20">सेयो नाशवान डांगरा जेड़े ए।<verse eid="PSA 49:20" /></para>
  <chapter eid="PSA 49" />
  <chapter number="50" style="c" sid="PSA 50" />
  <para style="s">परमेशर सच्चा न्यायधीश ए</para>
  <para style="d">आसापो रा पजन</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 50:1" />सर्वशक्तिमान परमेशरे बोली राखेया,</para>
  <para style="q" vid="PSA 50:1">ओर पूर्वो ते लई की पच्छमा तक तरतिया रे सब लोक बुलाई राखे।<verse eid="PSA 50:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 50:2" />सिय्योनो ते जो बऊत जादा सुन्दर ए,</para>
  <para style="q" vid="PSA 50:2">परमेशरे आपणा तेज दखाई राखेया।<verse eid="PSA 50:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 50:3" />म्हारा परमेशर आऊणा ओर चुपचाप नि रणा,</para>
  <para style="q" vid="PSA 50:3">प्रचण्ड आग तेसते आगे-आगे पस्म करदे जाणी ओर तेसरे चऊँ कनारे बड़ा पारी तूफान चलणा।<verse eid="PSA 50:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 50:4" />परमेशरो सर्ग ओर तरती गवा रे रूपो रे राखणे, कि सेयो तेसखे आपणी प्रजा रा न्याय करदे ऊए देखो।<verse eid="PSA 50:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 50:5" />“मेरे पग्ता खे मांगे कट्ठे करो,</para>
  <para style="q" vid="PSA 50:5">जिने बलिदान चढ़ाई की मां साथे वाचा बानी राखी!”<verse eid="PSA 50:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 50:6" />स्वर्गो परमेशरो रा तर्मी ऊणे रा प्रचार करना</para>
  <para style="q" vid="PSA 50:6">कऊँकि परमेशर आपू ई न्याय करने वाल़ा ए।<note caller="+" style="f"><char style="fr" closed="false">50:6 </char><char style="ft" closed="false">पजन 97:6, इब्रानी 12:23</char></note> सेला<verse eid="PSA 50:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 50:7" />तेस बोलणा, “ओ मेरे लोको, सुणो! आऊँ तुसा खे बोलूँआ! ओ इस्राएली लोको,</para>
  <para style="q" vid="PSA 50:7">आऊँ तुसा रे बारे दे गवाई देऊँआ! आऊँ परमेशर, तुसा रा परमेशर ए!<verse eid="PSA 50:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 50:8" />आऊँ तां पाँदे तेरी मेलबलिया रे बारे दोष नि लगांदा,</para>
  <para style="q" vid="PSA 50:8">तेरे होमबलि तो हमेशा मेरिया तँईं चढ़ोए।<verse eid="PSA 50:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 50:9" />मां ना तो तेरे कअरो ते बल़द</para>
  <para style="q" vid="PSA 50:9">ओर ना तेरिया गवाईणी ते बाकरे बल़ी करने खे लणे।<verse eid="PSA 50:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 50:10" />कऊँकि बणो रे सारे जीव-जंतु ओर ह्जारो पाह्ड़ो रे जानवर मेरे ईए।<verse eid="PSA 50:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 50:11" />पाह्ड़ो रे सारे पंछिया खे आऊँ जाणूंआ</para>
  <para style="q" vid="PSA 50:11">ओर मैदानो रे चलणे-फिरने वाल़े जानवर मेरे ईए।<verse eid="PSA 50:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 50:12" />जे आऊँ पूखा ऊँदा, तो ताखे नि बोलदा;</para>
  <para style="q" vid="PSA 50:12">कऊँकि दुनिया ओर जो कुछ तिदे ए,</para>
  <para style="q" vid="PSA 50:12">से मेरा ईए।<note caller="+" style="f"><char style="fr" closed="false">50:12 </char><char style="ft" closed="false">प्रेरि. 17:25, 1 कुरि. 10:26</char></note><verse eid="PSA 50:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 50:13" />क्या आऊँ बल़दो रा मास खाऊँ या बाकरेया रा खून पीऊँ?<verse eid="PSA 50:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 50:14" />परमेशरो खे तन्यवादो रा बलिदान ई चढ़ा</para>
  <para style="q" vid="PSA 50:14">ओर परमपरदानो रिया तँईं आपणी मान्नता पुरिया कर;<note caller="+" style="f"><char style="fr" closed="false">50:14 </char><char style="ft" closed="false">इब्रानी 13:15, सभो. 5:4,5</char></note><verse eid="PSA 50:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 50:15" />ओर मुसीबता रे बखते माखे बुला,</para>
  <para style="q" vid="PSA 50:15">मां तूँ मुसीबता ते छुड़ाणा ओर तां मेरी महिमा करनी।”<verse eid="PSA 50:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 50:16" />पर दुष्टो खे परमेशर बोलोआ, “ताखे मेरी बिदिया रा बखाण करने ते क्या काम</para>
  <para style="q" vid="PSA 50:16">ओर तूँ मेरी वाचा री चर्चा कऊँ करेया?<verse eid="PSA 50:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 50:17" />तूँ तो मेरी शिक्षा ते बैर करेया</para>
  <para style="q" vid="PSA 50:17">ओर मेरी आज्ञा खे नि मानदा।<verse eid="PSA 50:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 50:18" />जेबे तैं चोर देखेया, तेबे तेसरी संगतिया ते खुश ऊआ</para>
  <para style="q" vid="PSA 50:18">ओर व्याभिचारिया साथे शामिल ऊआ।<verse eid="PSA 50:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 50:19" />तूँ बुराई करने खे सदा त्यार रएया</para>
  <para style="q" vid="PSA 50:19">ओर ना ई चूठ बोलणे दे शर्म करदा।<verse eid="PSA 50:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 50:20" />तूँ आपू आपणे पाई-बईणा पाँदे आरोप लगाणे</para>
  <para style="q" vid="PSA 50:20">ओर तिना साथे गल़ती टोल़ने खे त्यार रएया।<verse eid="PSA 50:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PSA 50:21" />ये काम तैं कित्तेया ओर मैं कुछ नि बोलेया;</para>
  <para style="q" vid="PSA 50:21">इजी री खातर तैं समजेया कि परमेशर बिल्कुल मां जेड़ा ए।</para>
  <para style="q" vid="PSA 50:21">पर एबे मां तूँ समजयाणा ओर तां सामणे सब कुछ स्पष्ट करना।<verse eid="PSA 50:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="PSA 50:22" />ओ परमेशरो खे पूलणे वाल़ेयो!</para>
  <para style="q" vid="PSA 50:22">एसा गल्ला खे ठीक टंगो रे समजी लओ,</para>
  <para style="q" vid="PSA 50:22">केथी एड़ा नि ओ कि आऊँ तुसा खे नाश करी देऊँ</para>
  <para style="q" vid="PSA 50:22">ओर कोई तुसा खे बचाणे वाल़ा नि ओ!<verse eid="PSA 50:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="PSA 50:23" />तन्यवादो रे बलिदानो खे चढ़ाणे वाल़ा मेरा आदर करोआ</para>
  <para style="q" vid="PSA 50:23">ओर जो मेरी गल्ल मानोआ से मां जरूर बचाणा।”<note caller="+" style="f"><char style="fr" closed="false">50:23 </char><char style="ft" closed="false">इब्रानी 13:15</char></note><verse eid="PSA 50:23" /></para>
  <chapter eid="PSA 50" />
  <chapter number="51" style="c" sid="PSA 51" />
  <para style="s">पाप माफ करने रिया तँईं प्रार्थना</para>
  <para style="d">बजाणे वाल़े परदानो रिया तँईं दाऊदो रा पजन, जेबे नबी नातान दाऊदो गे आया कऊँकि दाऊदे ओरी बतशेबा जवाणसा साथे व्याभिचार कित्तेया था।</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 51:1" />ओ परमेशर, आपणे गईरे प्यारो रिया बजा ते मां पाँदे दया कर।</para>
  <para style="q" vid="PSA 51:1">तेरी बड़ी दया रिया बजा ते मेरे पापो खे मटयाई दे।<note caller="+" style="f"><char style="fr" closed="false">51:1 </char><char style="ft" closed="false">लूक 18:13, यशायाह 43:25</char></note><verse eid="PSA 51:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 51:2" />माखे ठीक-टंगो रे तोई की मेरे बुरे काम दूर कर</para>
  <para style="q" vid="PSA 51:2">ओर मेरे पापो ते छुड़ाई की माखे शुद्ध कर!<verse eid="PSA 51:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 51:3" />आऊँ जाणूंआ कि मैं तेरी बात नि मानी।</para>
  <para style="q" vid="PSA 51:3">आऊँ ये नि पूली सकदा कि आऊँ दोषी आ।<verse eid="PSA 51:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 51:4" />मैं बस तेरे ई खलाफ पाप कित्तेया ओर जो तेरिया नजरा रे बुरा ए,</para>
  <para style="q" vid="PSA 51:4">सेई करी राखेया, इजी री खातर तैं जो मेरा न्याय करी राखेया से बिल्कुल सई ए।<note caller="+" style="f"><char style="fr" closed="false">51:4 </char><char style="ft" closed="false">लूक 15:18,21, रोमी 3:4</char></note><verse eid="PSA 51:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 51:5" />देख, जेस दिनो ते आऊँ पैदा ऊआ, तेसी दिनो ते आऊँ पापी था;</para>
  <para style="q" vid="PSA 51:5">सच्चो खे, जदुए ते मेरिये माये मेरा गर्भधारण कित्तेया, तदो ते ई आऊँ पापी आ।<note caller="+" style="f"><char style="fr" closed="false">51:5 </char><char style="ft" closed="false">यूह. 3:6, रोमी 5:12, इफिसि 2:3</char></note><verse eid="PSA 51:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 51:6" />पर तूँ चाएआ कि आऊँ पुरिया तरआ ते सच्चा ओर इमानदार रऊँ।</para>
  <para style="q" vid="PSA 51:6">तूँ माखे बुद्धिमानीया ते जीवन जीऊणा सखाणा चाएआ।<verse eid="PSA 51:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 51:7" />जूबे की माखे शुद्ध कर ओर तेबे आऊँ शुद्ध ऊई जाणा,</para>
  <para style="q" vid="PSA 51:7">तूँ माखे तोओ तेबे आऊँ बर्फा जेड़ा सफेद ऊई जाणा।<note caller="+" style="f"><char style="fr" closed="false">51:7 </char><char style="ft" closed="false">निर्ग. 12:22; लैव्य. 14:1-7; गिण. 19:1-6, 16-19.</char></note><verse eid="PSA 51:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 51:8" />माखे खुशी ओर आनंदो रिया गल्ला सुणा,</para>
  <para style="q" vid="PSA 51:8">जेते की मेरिया आड्डिया जो तैं तोड़ी राखिया,</para>
  <para style="q" vid="PSA 51:8">सेयो मगन ऊई जाओ।<verse eid="PSA 51:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 51:9" />आपणा मूँ मेरे पापो रिया तरफा ते मोड़ी दे</para>
  <para style="q" vid="PSA 51:9">ओर मेरे सारे बुरे काम मटयाई दे।<verse eid="PSA 51:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 51:10" />ओ परमेशर, मेरे पीतरे शुद्ध बचारा खे पैदा कर ओर माखे दुबारा इमानदार बणा<verse eid="PSA 51:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 51:11" />माखे आपणी मौजुदगिया ते दूर नि कर ओर आपणी पवित्र आत्मा मांते नि निक्याल़।<verse eid="PSA 51:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 51:12" />आपणे कित्ते रे उद्धारो री खुशी माखे फेर देई दे</para>
  <para style="q" vid="PSA 51:12">ओर नम्र आत्मा देई की माखे आसरा दे।<verse eid="PSA 51:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 51:13" />तेबे मां अपराधिया खे तेरी बाट सिखाणी,</para>
  <para style="q" vid="PSA 51:13">तेबे पापी तेरिया तरफा खे फिरने।<verse eid="PSA 51:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 51:14" />ओ परमेशर, ओ मेरे उद्धारकर्ता परमेशर,</para>
  <para style="q" vid="PSA 51:14">माखे अत्या रे पापो ते छुड़ाई लओ!</para>
  <para style="q" vid="PSA 51:14">तेबे आऊँ तेरिया तार्मिकता रा जयजयकार करी सकूँआ।<verse eid="PSA 51:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 51:15" />ओ यहोवा, बोलणे दे मेरी मताद कर कि आऊँ तेरी स्तुति करी सकूँ।<verse eid="PSA 51:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 51:16" />कऊँकि तूँ मेलबलिया ते खुश नि ऊँदा,</para>
  <para style="q" vid="PSA 51:16">नई तो आऊँ बलि चढ़ाई देंदा;</para>
  <para style="q" vid="PSA 51:16">होमबलिया ते बी तूँ खुश नि ऊँदा।<verse eid="PSA 51:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 51:17" />ओ परमेशर मेरा बलिदान एक नम्र आत्मा ए,</para>
  <para style="q" vid="PSA 51:17">तूँ नम्र ओर पश्चाताप करने वाल़े मनो खे बेकार नि समजदा;<verse eid="PSA 51:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 51:18" />ओ परमेशर, खुश ऊई की यरूशलेम शईरो पाँदे आपणी दया कर ओर तिना री मताद कर,</para>
  <para style="q" vid="PSA 51:18">यरूशलेम शईरो री दवाला खे तूँ फेर खड़ा कर।<verse eid="PSA 51:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 51:19" />तेबे तूँ तार्मिकता रे कामो ते,</para>
  <para style="q" vid="PSA 51:19">मतलब सबी डांगरा री होमबलिया ते खुश ऊणा;</para>
  <para style="q" vid="PSA 51:19">तेबे लोका तेरी बेदिया पाँदे बल़द चढ़ाणे।<verse eid="PSA 51:19" /></para>
  <chapter eid="PSA 51" />
  <chapter number="52" style="c" sid="PSA 52" />
  <para style="s">परमेशरो रा न्याय ओर दया</para>
  <para style="d">परदान बजाणे वाल़े रिया तँईं मश्किलो पाँदे दाऊदो रा पजन, जेबे एदोम देशो रे दोएगे शाऊलो खे बताया कि दाऊद अहीमेलेको रे कअरे आई रा।</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 52:1" />ओ तागतबर माणूं, कऊँ तूँ आपणे कुकर्मा पाँदे कमण्ड करेया?</para>
  <para style="q" vid="PSA 52:1">परमेशरो री करूणा तो सदा बणी री रओई।<verse eid="PSA 52:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 52:2" />सारा दिन तुसे दूजेया ते छुटकारा पाणे री योजना बणाओए;</para>
  <para style="q" vid="PSA 52:2">तुसे जो बोलोए से पैने चाकुए रिया तरआ दूजेया खे चोट पऊँचाओए, ओर तुसे हमेशा दूजेया खे तोखा देंदे रओए।<verse eid="PSA 52:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 52:3" />ताखे पलाईया ते बढ़ी की बुराई</para>
  <para style="q" vid="PSA 52:3">ओर सच्च बोलणे ते अलावा चूठ प्यारा ए। सेला<verse eid="PSA 52:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 52:4" />तुसे लोका खे तोखा देणे रिया तँईं गल्ला बोलोए, तुसा खे लोका खे चोट देणा अच्छा लगोआ।<verse eid="PSA 52:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 52:5" />जरूर परमेशरो तूँ सदा खे नाश करी देणी;</para>
  <para style="q" vid="PSA 52:5">तेस तूँ पकड़ी की तेरे रणे री जगा ते निकयाल़ी देणी</para>
  <para style="q" vid="PSA 52:5">ओर जिऊँदेया रे लोको ते तूँ पट्टी की सेटी देणी। सेला<verse eid="PSA 52:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 52:6" />तेबे तार्मिक लोक एसा घटणा खे देखी की डरी जाणे</para>
  <para style="q" vid="PSA 52:6">ओर ये बोली कि तेस पाँदे आसणे,<verse eid="PSA 52:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 52:7" />“देखो, ये सेई माणूं ए जिने परमेशर आपणी शरण नि मानेया,</para>
  <para style="q" vid="PSA 52:7">पर तिजी रे बदले तिने आपणी तअन-दौलता पाँदे परोसा राखेया</para>
  <para style="q" vid="PSA 52:7">ओर आपू खे ओरी लोका रा नुकशाण करने रिया तँईं मजबूत करदा रया!”<verse eid="PSA 52:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 52:8" />पर आऊँ तो परमेशरो रे मन्दरो रे अरे जैतूनो रे डाल़ो जेड़ा ए।</para>
  <para style="q" vid="PSA 52:8">मैं परमेशरो रिया करूणा पाँदे सदा परोसा करूँआ।<verse eid="PSA 52:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 52:9" />ओ परमेशर, मां तेरा तन्यवाद सदा करदे रणा;</para>
  <para style="q" vid="PSA 52:9">कऊँकि तैंई ये काम करी राखेया।</para>
  <para style="q" vid="PSA 52:9">मां तेरे नाओं रा गुणगाण तेरे पग्ता रे सामणे करना कऊँकि तेरा नाओं खरा ए।<verse eid="PSA 52:9" /></para>
  <chapter eid="PSA 52" />
  <chapter number="53" style="c" sid="PSA 53" />
  <para style="s">माणूंए री दुष्टता ओर मूर्खता</para>
  <para style="d">बजाणे वाल़े परदानो रिया तँईं महलत रागो पाँदे दाऊदो रा मश्कील</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 53:1" />मूर्खे आपणे आपू ते बोलोआ, “कोई परमेशर अया ई नि।”</para>
  <para style="q" vid="PSA 53:1">सेयो प्रष्ट ऊईगे रे, तिने बुरे घिनौने काम करी राखे;</para>
  <para style="q" vid="PSA 53:1">एड़ा कोई पनिए, जो पलाईया रे काम करो।<verse eid="PSA 53:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 53:2" />परमेशरे स्वर्गो ते माणूंआ पाँदे नजर दित्ती,</para>
  <para style="q" vid="PSA 53:2">ताकि देखो कि कोई एड़ा माणूं अया कि जो समजा साथे काम करोआ</para>
  <para style="q" vid="PSA 53:2">या परमेशरो खे टोल़ोआ।<verse eid="PSA 53:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 53:3" />पर सब माणूं परमेशरो रिया बाटा ते अटी गे रे;</para>
  <para style="q" vid="PSA 53:3">सारे एक जेड़े प्रष्ट ऊईगे;</para>
  <para style="q" vid="PSA 53:3">एड़ा कोई पनि ए जो पलाई करो,</para>
  <para style="q" vid="PSA 53:3">एक बी नि ए।<note caller="+" style="f"><char style="fr" closed="false">53:3 </char><char style="ft" closed="false">पजन 14:1-3, रोमी 3:10-12</char></note><verse eid="PSA 53:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 53:4" />परमेशरे पूछेया, “क्या सेयो नि जाणदे? क्या सेयो बुरे काम करने वाल़े नासमज ए? सेयो मेरेया लोका खे लूटी की जिऊणे लगी रे,</para>
  <para style="q" vid="PSA 53:4">ओर सेयो मां परमेशरो ते प्रार्थना पनि करदे।”<verse eid="PSA 53:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 53:5" />पर तुसे पईले ते जादा डरे दे ऊणे। परमेशरो आपणे दुश्मणा रिया आड्डिया ओरे-पोरे सेटी देणियां,</para>
  <para style="q" vid="PSA 53:5">ओर जेबे परमेशरो तुसे ठुकराणे, तेबे तुसे बदनाम ऊई जाणे।<verse eid="PSA 53:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 53:6" />पला ऊँदा जे सिय्योनो ते इस्राएलो रा पूरा उद्धार निकल़दा!</para>
  <para style="q" vid="PSA 53:6">जेबे परमेशरो आपणे लोक बंधुआईया ते वापस लई आऊणे,</para>
  <para style="q" vid="PSA 53:6">तेबे याकूब मगन ओर इस्राएल खुश ऊणा।<verse eid="PSA 53:6" /></para>
  <chapter eid="PSA 53" />
  <chapter number="54" style="c" sid="PSA 54" />
  <para style="s">दुश्मणा ते बचाणे रिया तँईं प्रार्थना</para>
  <para style="d">बजाणे वाल़े परदानो रिया तँईं, दाऊदो रा तारा वाल़े बाजे साथे मश्कील, जेबे जीपिए आई की शाऊलो खे बोलेया, “क्या दाऊद आसा गे लुकेया राए?”</para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 54:1" />ओ परमेशर, तूँ माखे आपणी महान शक्ति,</para>
  <para style="q" vid="PSA 54:1">ओर आपणे महान प्रतापो रे जरिए माखे बचा ओर आजाद करी लो।<verse eid="PSA 54:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 54:2" />ओ परमेशर, मेरी प्रार्थना सुणी लओ;</para>
  <para style="q" vid="PSA 54:2">मेरे वचना रिया तरफा खे त्यान लगा।<verse eid="PSA 54:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 54:3" />कऊँकि कमण्डी लोक मां पीछे पड़ी रे,</para>
  <para style="q" vid="PSA 54:3">सेयो दुष्ट माणूं माखे काणा चाओए,</para>
  <para style="q" vid="PSA 54:3">सेयो परमेशरो रा कोई आदर नि करदे। सेला<verse eid="PSA 54:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 54:4" />पर परमेशर मेरी मताद करने वाल़ा ए;</para>
  <para style="q" vid="PSA 54:4">यहोवा मेरी रक्षा करने वाल़ा ए।<verse eid="PSA 54:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 54:5" />परमेशरो मेरे बरोदिया री बुराई तिना पाँदे ई वापस करी देणी।</para>
  <para style="q" vid="PSA 54:5">ओ परमेशर, तूँ आपणी सच्चाईया ते तिना रा सत्यानाश कर।<verse eid="PSA 54:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 54:6" />ओ यहोवा, मां खुशिया साथे ताखे बलिदान चढ़ाणा;</para>
  <para style="q" vid="PSA 54:6">मां ताखे तन्यवाद देणा कऊँकि तूँ पला ए।<verse eid="PSA 54:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 54:7" />तैं आऊँ सारे दु:खो ते छुड़ाई राखेया</para>
  <para style="q" vid="PSA 54:7">ओर मैं आपणियां आखी ते आपणे दुश्मणा खे आरदे ऊए देखी राखेया ए।<verse eid="PSA 54:7" /></para>
  <chapter eid="PSA 54" />
  <chapter number="55" style="c" sid="PSA 55" />
  <para style="s">विश्वासघातिए रे विनाशो रिया तँईं प्रार्थना</para>
  <para style="d">बजाणे वाल़े रे परदानो रिया तँईं तारा वाल़े बाजे साथे दाऊदो रा मश्कील</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 55:1" />ओ परमेशर, मेरिया प्रार्थना रिया तरफा खे त्यान दे</para>
  <para style="q" vid="PSA 55:1">ओर मेरिया बिनतिया खे अणसुणी नि कर!<verse eid="PSA 55:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 55:2" />मेरी प्रार्थना सुणी की माखे उत्तर दे,</para>
  <para style="q" vid="PSA 55:2">मां पाँदे आई री मुसीबता रे बार रे सोची की आऊँ बेचैन रऊँआ।<verse eid="PSA 55:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 55:3" />कऊँकि मेरे दुश्मण आल्ला-गोल्ला ओर पापी लोक उपद्रव करने लगी रे;</para>
  <para style="q" vid="PSA 55:3">सेयो मां पाँदे दोष लगाओए ओर गुस्से रे आई की माखे सताओए।<verse eid="PSA 55:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 55:4" />मेरा मन पीतरे ई पीतरे बऊत दु:खी ए</para>
  <para style="q" vid="PSA 55:4">ओर आऊँ मरने ते डरने लगी रा।<verse eid="PSA 55:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 55:5" />आऊँ तो डरो रे मारे थुरने लगी रा</para>
  <para style="q" vid="PSA 55:5">ओर डरो रे मारे मेरे बाल़-बाल़ खड़े ऊईगे रे।<verse eid="PSA 55:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 55:6" />तेबे मैं बोलेया कि खरा ऊँदा जे मेरे कबूतरो जेड़े पंख ऊँदे,</para>
  <para style="q" vid="PSA 55:6">तो आऊँ उडी जांदा ओर माखे राम मिलदा!<verse eid="PSA 55:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 55:7" />देखो, तेबे तो आऊँ उडदे-उडदे दूर निकल़ी जाणा था</para>
  <para style="q" vid="PSA 55:7">ओर सुनसाण जगा रे आपणा बसेरा करदा।<verse eid="PSA 55:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 55:8" />आऊँ छोड़ आपणे बैरिया ते नठी की केथी रणे रिया जगा दे जांदा,</para>
  <para style="q" vid="PSA 55:8">जो एक आँधी तूफानो जेड़ा ए।<verse eid="PSA 55:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 55:9" />ओ प्रभु, तिना रा नाश कर ओर तिना री पाषा रे गड़बड़ी पाई दे,</para>
  <para style="q" vid="PSA 55:9">कऊँकि मैं शईरो रे ईंसा ओर चगड़ा देखी राखेया।<verse eid="PSA 55:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 55:10" />रात-दिन सेयो तिजी री दवाला पाँदे चढ़ी की चऊँ कनारे कूमोए</para>
  <para style="q" vid="PSA 55:10">ओर तेतेरे पीतरे बुराई ओर चगड़ा करोए।<verse eid="PSA 55:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 55:11" />सेयो हर जगा चीजा खे नाश करी देओए।</para>
  <para style="q" vid="PSA 55:11">सेयो बारे चौका पाँदे लोका पाँदे अत्याचार करोए ओर तिना खे तोखा देओए।<verse eid="PSA 55:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 55:12" />जे कोई दुश्मण मेरी निंदा करदा,</para>
  <para style="q" vid="PSA 55:12">तो आँऊ तिजी खे सईन करी लंदा;</para>
  <para style="q" vid="PSA 55:12">जे मेरे खलाफ मेरा बैरी उठदा तो मां तेसते लूकी जाणा था।<verse eid="PSA 55:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 55:13" />पर से तो तूँई था, जो मां जेड़ा एक माणूं,</para>
  <para style="q" vid="PSA 55:13">मेरा प्यारा दोस्त ओर मेरी जाण-पछयाणी रा था।<verse eid="PSA 55:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 55:14" />जेस साथे आसे दोनो जणे आपू बीचे</para>
  <para style="q" vid="PSA 55:14">मीठिया-मीठिया गल्ला करदे आराधना करने वाल़ेया रे चूण्डो साथे परमेशरो रे मन्दरो रे जाऊँ थे।<verse eid="PSA 55:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 55:15" />मेरे दुश्मणा खे अचाणक मौत आई जाओ;</para>
  <para style="q" vid="PSA 55:15">सेयो जिऊँदे ई अधलोको रे उतरी जाओ,</para>
  <para style="q" vid="PSA 55:15">कऊँकि बुराई तिना रे कअर ओर तिना रे मनो रेईए।<verse eid="PSA 55:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 55:16" />पर मां तो परमेशरो खे मतादा रिया तँईं आका पाणिया</para>
  <para style="q" vid="PSA 55:16">ओर प्रभुए आऊँ बचाई लणा।<verse eid="PSA 55:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 55:17" />मां साँजा, प्यागा ओर त्याड़िया तिंऊँ पईरे दु:खो दे दुहाई देणी</para>
  <para style="q" vid="PSA 55:17">ओर कणदे रणा ओर परमेशरो मेरी आवाज सुणी लणी।<verse eid="PSA 55:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 55:18" />युद्धो दे प्रभुए मेरी रक्षा करनी;</para>
  <para style="q" vid="PSA 55:18">जेबे मेरे खलाफ बऊत सारे दुश्मण खड़े ऊणे,</para>
  <para style="q" vid="PSA 55:18">तेस मेरे प्राण नाश ऊणे ते बचाणे।<verse eid="PSA 55:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 55:19" />परमेशर जो शुरूए ते सिंहासणो पाँदे बैठेया राए,</para>
  <para style="q" vid="PSA 55:19">मेरी प्रार्थना सुणी की तेस तिना खे उत्तर देणा। सेला,</para>
  <para style="q" vid="PSA 55:19">कऊँकि तिना लोका रे दिलो रे कोई बदलाव नि ए</para>
  <para style="q" vid="PSA 55:19">ओर ना सेयो परमेशरो ते डरदे।<verse eid="PSA 55:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 55:20" />मेरे साथिये आपू साथे शान्तिया रा मेल राखणे वाल़ेया पाँदे बी आथ चकी राखेया,</para>
  <para style="q" vid="PSA 55:20">तिने आपणा वादा तोड़ी ता रा।<verse eid="PSA 55:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PSA 55:21" />तेसरे मुंए रिया गल्ला मां सामणे नऊणिंया जेड़िया चिकणिया ओ थिया,</para>
  <para style="q" vid="PSA 55:21">पर फेर बी तेसरे मनो रे मेरे खलाफ ईर्ष्या थी;</para>
  <para style="q" vid="PSA 55:21">तेसरे बोल तेलो ते जादा चिकणे तो थे, पर फेर बी सेयो नांगी तलवार थे।<verse eid="PSA 55:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="PSA 55:22" />आपणा बोज प्रभुए पाँदे पाई दे;</para>
  <para style="q" vid="PSA 55:22">तेस तूँ सम्बाल़ना,</para>
  <para style="q" vid="PSA 55:22">तेस तार्मिक माणूं कदी नि टल़ने देणे।<note caller="+" style="f"><char style="fr" closed="false">55:22 </char><char style="ft" closed="false">1 पत 5:7, पजन 37:24</char></note><verse eid="PSA 55:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="PSA 55:23" />पर ओ परमेशर, तूँ तिना अत्यारेया ओर चूठेया लोका खे नाशो रे गड्डे रे सेटी दे;</para>
  <para style="q" vid="PSA 55:23">अत्यारे ओर कपटी माणूं आपणी आदिया उम्रा तक बी जिऊँदे नि रणे।</para>
  <para style="q" vid="PSA 55:23">पर मां तां पाँदे ई परोसा राखणा।<verse eid="PSA 55:23" /></para>
  <chapter eid="PSA 55" />
  <chapter number="56" style="c" sid="PSA 56" />
  <para style="s">परमेशरो पाँदे परोसे रिया तँईं प्रार्थना</para>
  <para style="d">बजाणे वाल़े परदानो रिया तँईं योनतेलेखद्दोकीम रागो दे दाऊदो रा मिक्ताम। ये तेस बखतो राए जेबे पलिश्तिए से गत शईरो रे पकड़ेया था</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 56:1" />ओ परमेशर, मां पाँदे दया कर!</para>
  <para style="q" vid="PSA 56:1">मेरेया दुश्मणे चऊँ कनारा ते केरी की मां पाँदे अमला करी राखेया,</para>
  <para style="q" vid="PSA 56:1">सेयो माखे हर रोज दु:खी देई कि माखे काणा चाओए।<verse eid="PSA 56:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 56:2" />मेरे दुश्मण हर रोज मां पाँदे अमला करोए,</para>
  <para style="q" vid="PSA 56:2">ओर जो कमण्डी मांते लड़ोए, सेयो बऊत जादा ए।<verse eid="PSA 56:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 56:3" />जेस बखते माखे डर लगणा,</para>
  <para style="q" vid="PSA 56:3">मां तां पाँदे परोसा राखणा।<verse eid="PSA 56:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 56:4" />ओ परमेशर, आऊँ तेरी स्तुति करूँआ, कऊँकि तैं जो वादा कित्तेया तेस पूरा करेया,</para>
  <para style="q" vid="PSA 56:4">माखे तां पाँदे परोसा ए ओर फेर आऊँ नि डरदा।</para>
  <para style="q" vid="PSA 56:4">कोई बी लोक पक्का ई मेरा नुकशाण नि करी सकदे।<verse eid="PSA 56:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 56:5" />दुश्मण लगातार मेरे वचना रा उल्टा मतलब लगाई की अड़चण लगाओए।</para>
  <para style="q" vid="PSA 56:5">तिना रे सारे बचार मेरे खलाफ बुराईया रिया तँईं ए।<verse eid="PSA 56:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 56:6" />सेयो सब मिली की कट्ठे ओए</para>
  <para style="q" vid="PSA 56:6">ओर लूकी की बैठोए। सेयो मेरे कदमा-कदमा खे देखोए,</para>
  <para style="q" vid="PSA 56:6">मानो सेयो मेरे प्राण लणे रिया ताका रे ए।<verse eid="PSA 56:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 56:7" />इजी री खातर ओ परमेशर, तिना खे तिना रे बुरे कामा री सजा दे जो सेयो करोए;</para>
  <para style="q" vid="PSA 56:7">दखा कि तूँ तिना लोका खे अराई की गुस्से दे आ!<verse eid="PSA 56:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 56:8" />देख तूँ जाणेया कि मां पाँदे केड़िया मुसीबता आई रिया,</para>
  <para style="q" vid="PSA 56:8">तैं मेरे हर रोणे-चींगणे रा साब राखेया,</para>
  <para style="q" vid="PSA 56:8">ओर सब गल्ला तैं आपणियां कताबा दे लिखी राखिया ए।<verse eid="PSA 56:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 56:9" />जेस बखते आऊँ ताखे आका पाऊँ,</para>
  <para style="q" vid="PSA 56:9">तेस ई बखते मेरे दुश्मण उल्टे फिरने।</para>
  <para style="q" vid="PSA 56:9">आऊँ ये जाणूंआ कि परमेशर मेरी तरफा खे ए।<verse eid="PSA 56:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 56:10" />परमेशरो रिया मतादा ते मां तेसरे वचनो री तारीफ करनी,</para>
  <para style="q" vid="PSA 56:10">यहोवे रिया मतादा ते मां तेसरे वचनो री तारीफ करनी।<verse eid="PSA 56:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 56:11" />मैं परमेशरो पाँदे परोसा राखी राखेया, मां नि डरना।</para>
  <para style="q" vid="PSA 56:11">माणूं मेरा क्या बिगाड़ी सकोआ?<verse eid="PSA 56:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 56:12" />ओ परमेशर, तेरी मान्नता रा पार मां पाँदे पड़ी रा;</para>
  <para style="q" vid="PSA 56:12">मां ताखे तन्यवादो री बलि चढ़ाणी।<verse eid="PSA 56:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 56:13" />कऊँकि तैं मौता ते मेरा प्राण बचाई राखेया;</para>
  <para style="q" vid="PSA 56:13">तैं मेरे पैर बी खड़ीसणे ते बचाई राखे,</para>
  <para style="q" vid="PSA 56:13">ताकि आऊँ परमेशरो सामणे जिऊँदेया रे प्रयासे रे चलूँ फिरूँ।<verse eid="PSA 56:13" /></para>
  <chapter eid="PSA 56" />
  <chapter number="57" style="c" sid="PSA 57" />
  <para style="s">छुटकारे रिया तँईं प्रार्थना</para>
  <para style="d">बजाणे वाल़े रे परदानो रिया तँईं अल-तशहेत रागो दे दाऊदो रा मिक्ताम; जेबे से शाऊलो गे ते नठी की गुफा रे लूकी गा था।</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 57:1" />ओ परमेशर, मां पाँदे दया कर, मां पाँदे दया कर,</para>
  <para style="q" vid="PSA 57:1">कऊँकि आऊँ तेरी ई शरणा रे आई रा ओर जदुए तक यो बिपदा टल़ी नि जाओ,</para>
  <para style="q" vid="PSA 57:1">तदुए तक मां तेरे पंखा री छाया रे शरण लई की रणा।<verse eid="PSA 57:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 57:2" />मां तां परमपरदान परमेशरो ते प्रार्थना करनी,</para>
  <para style="q" vid="PSA 57:2">जिने मेरी सारिया जरूरता पुरिया करी राखिया ए।<verse eid="PSA 57:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 57:3" />परमेशरो स्वर्गो ते ज्वाब देणा, ओर आऊँ बचाई लणा,</para>
  <para style="q" vid="PSA 57:3">ओर जो माखे दु:ख देओए तिना पाँदे तूँ मुसीबत पाएया। सेला,</para>
  <para style="q" vid="PSA 57:3">तेरी दया मां पाँदे अटल ए, ओर तूँ सच्चा ओर परोसे जोगा ए।<verse eid="PSA 57:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 57:4" />आँऊ एड़ेया माणूंआ बीचे रऊँआ जो शेरा जेड़े खूंखार ए,</para>
  <para style="q" vid="PSA 57:4">आँऊ धधकदी आगी बीचे सुतुआं;</para>
  <para style="q" vid="PSA 57:4">मतलब एड़े माणूंआ बीचे जिना रे दाँद बड़छे ओर तीर ए</para>
  <para style="q" vid="PSA 57:4">ओर जिना री जीब तेज तलवारा जेड़ी ए।<verse eid="PSA 57:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 57:5" />ओ परमेशर, तूँ स्वर्गो पाँदे बऊत महान ओर तेजोमय ए,</para>
  <para style="q" vid="PSA 57:5">तेरी महिमा सारी तरतिया पाँदे फैली जाओ!<verse eid="PSA 57:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 57:6" />मेरे दुश्मणे माखे पकड़ने खे जाल़ फैलाई राखेया;</para>
  <para style="q" vid="PSA 57:6">आऊँ बऊत जादा दु:खो दे पड़ीगा दा ए। सेला<verse eid="PSA 57:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 57:7" />ओ परमेशर, मेरा परोसा तां पाँदे अटल ए,</para>
  <para style="q" vid="PSA 57:7">ओर मां जय-जयकार करदे ऊए तेरे गीत गाणे!<verse eid="PSA 57:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 57:8" />आऊँ एबे जागणा! मां आपणी सारंगी ओर आपणा बीणा चकी लणा।</para>
  <para style="q" vid="PSA 57:8">सूरजो रे निकल़दे ई मां गीत सुनाणा!<verse eid="PSA 57:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 57:9" />ओ प्रभु, मां देशो-देशा रे लोका बीचे तेरी सराईणा करनी;</para>
  <para style="q" vid="PSA 57:9">मां राज्य-राज्य रे लोका बीचे तेरा पजन गाणा।<verse eid="PSA 57:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 57:10" />कऊँकि तेरी करूणा इतणी महान ए कि स्वर्गो रे पऊँचोई ऊच्चाईया तक</para>
  <para style="q" vid="PSA 57:10">ओर तेरी सच्चाई सर्गो तक पऊँचोई।<verse eid="PSA 57:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 57:11" />ओ परमेशर, तूँ सर्गो पाँदे आपणी महानता प्रकट कर!</para>
  <para style="q" vid="PSA 57:11">तेरी महिमा सारी तरतिया पाँदे फैली जाओ!<verse eid="PSA 57:11" /></para>
  <chapter eid="PSA 57" />
  <chapter number="58" style="c" sid="PSA 58" />
  <para style="s">अन्याय रे खलाफ प्रार्थना</para>
  <para style="d">बजाणे वाल़े परदानो रिया तँईं अल-तशहेत रागो रे दाऊदो रा मिक्ताम</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 58:1" />ओ जाणे-माणे रे माणूंओ,<note caller="+" style="f"><char style="fr" closed="false">58:1 </char><char style="ft" closed="false">तागतबर माणूं</char></note> क्या तुसे सच्ची तार्मिकता रिया गल्ला बोलोए?</para>
  <para style="q" vid="PSA 58:1">ओ न्याय करने वाल़े लोको, क्या तुसे सच्चाईया ते न्याय करोए?<verse eid="PSA 58:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 58:2" />तुसे कदी न्याय नि करदे, तुसे हमेशा बुरा ई सोचोए,</para>
  <para style="q" vid="PSA 58:2">तुसे देशो दे चगड़े ई करोए।<verse eid="PSA 58:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 58:3" />दुष्ट लोक जन्मो तेई गल़त बाटा रे पटकी जाओए,</para>
  <para style="q" vid="PSA 58:3">जेबे सेयो पेटो रेई ओए तदुए तेई चूठ बोलणे री बुराई करदे ऊए पटकी जाओए।<verse eid="PSA 58:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 58:4" />तिना रे सापो रे विषो जेड़ा विष ए,</para>
  <para style="q" vid="PSA 58:4">सेयो तेस टऊणे नागो जेड़े ए जो आपणा कान बन्द करी लओआ;<verse eid="PSA 58:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 58:5" />ओर सपेरा चाए कितणी ई निपुणता साथे मंत्र पढ़ो,</para>
  <para style="q" vid="PSA 58:5">तेबे बी से तेसरी नि सुणदा।<verse eid="PSA 58:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 58:6" />ओ परमेशर, तिना रे मुंए ते दाँद तोड़ी दे;</para>
  <para style="q" vid="PSA 58:6">ओ प्रभु, तिना जवान शेरा री दाड़ा पटी दे!<verse eid="PSA 58:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 58:7" />सेयो कुल़ी की बह्यींदे ऊए पाणिए जेड़े ऊई जाओ;</para>
  <para style="q" vid="PSA 58:7">सेयो बाटा रे काओ जेड़े दबी की सूकी जाओ।<verse eid="PSA 58:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 58:8" />सेयो फीला जेड़े ऊई जाओ, जो चलदे बखते ई नाश ऊई जाओईया</para>
  <para style="q" vid="PSA 58:8">ओर जवाणसा रे गर्भो री टाल़ा जेड़े ऊई जाओ, जिने त्याड़ा देखेया ई नि।<verse eid="PSA 58:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 58:9" />इजी ते पईले कि तुसा री आँडिया रे कांडेया वाल़े लक्कड़ूआ री चल़ लगो,</para>
  <para style="q" vid="PSA 58:9">परमेशरो तूफानो साथे बिना फूखे ओर फूखे रे, दोनो डवाई की लई जाणे।<verse eid="PSA 58:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 58:10" />ओर पापी माणूंए खे सजा मिलदे देखी की तर्मी माणूंए खे खुशी मिलणी,</para>
  <para style="q" vid="PSA 58:10">ओर आपणे दुश्मणा रे खूनो ते तिना आपणे पैर तोओ,<verse eid="PSA 58:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 58:11" />तेबे माणूंआ बोलणे लगणा, “पक्का तर्मिया खे ईनाम ए;</para>
  <para style="q" vid="PSA 58:11">सच्चो खेई एक परमेशर ए, जो तरतिया पाँदे न्याय करोआ।”<verse eid="PSA 58:11" /></para>
  <chapter eid="PSA 58" />
  <chapter number="59" style="c" sid="PSA 59" />
  <para style="s">सुरक्षा रिया तँईं प्रार्थना</para>
  <para style="d">बजाणे वाल़े परदानो रिया तँईं अल-तशहेत रागो रे दाऊदो रा मिक्ताम; जेबे शाऊले दूत पेजे कि सेयो दाऊदो खे काणे रिया तँईं तेसरे कअरो रा पईरा देओ।</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 59:1" />ओ परमेशर, माखे मेरे दुश्मणा ते बचाई लओ!</para>
  <para style="q" vid="PSA 59:1">जो मां पाँदे अमला करना चाओए, तिना ते मेरी रक्षा कर!<verse eid="PSA 59:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 59:2" />इना बुरेया लोका ते तूँ माखे बचा;</para>
  <para style="q" vid="PSA 59:2">ओर इना अत्या करने वाल़ेया ते मेरी रक्षा कर।<verse eid="PSA 59:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 59:3" />देख, किंयाँ सेयो माखे काणे रिया तँईं मेरिया ताका रे लगी रे;</para>
  <para style="q" vid="PSA 59:3">जबकि ओ प्रभु, मेरा कोई पाप नि ए,</para>
  <para style="q" vid="PSA 59:3">मैं तिना रे खलाफ कोई पाप नि करी राखेया,</para>
  <para style="q" vid="PSA 59:3">तेबे बी तागतबर माणूं मेरे खलाफ कट्ठे ओए।<verse eid="PSA 59:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 59:4" />मैं कोई अपराध नि करी राखेया,</para>
  <para style="q" vid="PSA 59:4">तेबे बी सेयो मां पाँदे अमला करने रिया तँईं त्यार ए।</para>
  <para style="q" vid="PSA 59:4">मेरी मताद करने रिया तँईं जाग</para>
  <para style="q" vid="PSA 59:4">ओर मेरिया एसा दशा खे देखी लओ!<verse eid="PSA 59:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 59:5" />ओ स्वर्गिय सेनाओं रे प्रभु परमेशर,</para>
  <para style="q" vid="PSA 59:5">ओ इस्राएलो रे परमेशर, सबी देशा रे लोका खे जो बुरे ओर अत्याचारी ए,</para>
  <para style="q" vid="PSA 59:5">तिना पाँदे दया नि कर, तिना खे सजा देणे रिया तँईं जाग! सेला<verse eid="PSA 59:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 59:6" />मेरे दुश्मण साँजा खे वापस आई की कुत्तेया जेड़े गुर्राओए</para>
  <para style="q" vid="PSA 59:6">ओर सेयो शईरो रे चऊँ कनारे कूमोए।<verse eid="PSA 59:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 59:7" />ओ यहोवा तिना रा चींगणा ओर तिना री तमकीया खे तो सुण,</para>
  <para style="q" vid="PSA 59:7">तिना री जीब तलवारी जेड़ी पैनी ए, सेयो ये सोचोए कि आसा खे कोई नि सुणदा!</para>
  <para style="q" vid="PSA 59:7">कऊँकि सेयो बोलोए, “कुण म्हारिया गल्ला सुणोआ?”<verse eid="PSA 59:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 59:8" />पर ओ प्रभु, तां तिना पाँदे आसणा;</para>
  <para style="q" vid="PSA 59:8">तां सारे देशो री जातिया मजाको रे उडाई देणियां।<verse eid="PSA 59:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 59:9" />तूँई मेरी तागत ए, माखे तेरी ई उम्मीद ए!</para>
  <para style="q" vid="PSA 59:9">कऊँकि ओ परमेशर, तूँई मेरा मजबूत गढ़ ए।<verse eid="PSA 59:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 59:10" />तूँ मांते प्यार करेआ, ओर तूँ मां नेड़े आऊणा,</para>
  <para style="q" vid="PSA 59:10">ओर तां माखे मेरे दुश्मण आरदे ऊए दखाणे।<verse eid="PSA 59:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 59:11" />तिना खे घात नि कर, ओ यहोवा, ओ म्हारी ढाल!</para>
  <para style="q" vid="PSA 59:11">एड़ा नि ओ कि मेरे लोक एसा गल्ला खे पूली जाओ;</para>
  <para style="q" vid="PSA 59:11">तिना खे आपणियां शक्तिया साथे तित्तर बित्तर कर की तिना खे दबाई दे।<verse eid="PSA 59:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 59:12" />सेयो आपणे मुंए ते कित्ते रे पाप,</para>
  <para style="q" vid="PSA 59:12">तिना रे ओठा ते निकल़े रे वचन,</para>
  <para style="q" vid="PSA 59:12">तिना रे मुंए ते निकल़ी री स्रापो रिया गल्ला</para>
  <para style="q" vid="PSA 59:12">ओर चूठ बोलणे रिया बजा ते, आपणे ई कमण्डो रे फसी जाओ।<verse eid="PSA 59:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 59:13" />तूँ गुस्से रे आई की तिना रा अंत कर,</para>
  <para style="q" vid="PSA 59:13">तिना रा अंत करी दे ताकि सेयो नाश ऊई जाओ,</para>
  <para style="q" vid="PSA 59:13">तेबे लोका जाणना कि परमेशर इस्राएलो पाँदे,</para>
  <para style="q" vid="PSA 59:13">बल्कि तरतिया रे कनारे तक राज करोआ। सेला<verse eid="PSA 59:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 59:14" />सेयो लोक साँजा खे वापस आई की कुत्तेया जेड़े गुर्राओए</para>
  <para style="q" vid="PSA 59:14">ओर शईरो रे चऊँ कनारे कूमोए।<verse eid="PSA 59:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 59:15" />सेयो पेट परने रिया तँईं रोटिया रे टुकड़ेया खे पटकदे फिरोए</para>
  <para style="q" vid="PSA 59:15">ओर जे रज्जो नि तो पूरी रात गुर्रांदे रओए।<verse eid="PSA 59:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 59:16" />पर मां तेरिया तागती रे बारे गीत गाणा</para>
  <para style="q" vid="PSA 59:16">ओर प्यागा तड़के ई तेरी करूणा री मां जयजयकार करनी।</para>
  <para style="q" vid="PSA 59:16">कऊँकि तूँ मेरा ऊच्चा गढ़ ए</para>
  <para style="q" vid="PSA 59:16">ओर मुसीबता रे बखते तूँ मेरी शरण लणे री जगा ठईरी रा।<verse eid="PSA 59:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 59:17" />तूँई मेरी तागत ए, मां तेरी तारीफ करदे ऊए तेरा पजन गाणा,</para>
  <para style="q" vid="PSA 59:17">ओर मेरा परमेशर जेस पाँदे आऊँ परोसा करूँआ,</para>
  <para style="q" vid="PSA 59:17">तूँ मेरा मजबूत गढ़</para>
  <para style="q" vid="PSA 59:17">ओर मां पाँदे करूणा करने वाल़ा परमेशर ए।<verse eid="PSA 59:17" /></para>
  <chapter eid="PSA 59" />
  <chapter number="60" style="c" sid="PSA 60" />
  <para style="s">छुटकारे रिया तँईं प्रार्थना</para>
  <para style="d">बजाणे वाल़े परदानो रिया तँईं दाऊदो रा मिक्ताम शोशनेदूत रागो रे, शिक्षा रिया तँईं। जेबे से अरम्नहरैम ओर अरमसोबा ते लड़ो था। ओर योआबे वापस आई की लूणो रिया काअटिया दे बारा ह्जार एदोमी मर्द मारी ते।</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 60:1" />ओ परमेशर, तैं आसे छाडी ते ओर आसे तोड़ी ते।</para>
  <para style="q" vid="PSA 60:1">तूँ गुस्से ऊआ; एबे आसा खे फेर पईले जेड़ा बणाई दे।<verse eid="PSA 60:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 60:2" />तैं तरती ईलाई ती ओर से फाड़ी ती;</para>
  <para style="q" vid="PSA 60:2">एबे तिजी रिया खीड़ा परी दे,</para>
  <para style="q" vid="PSA 60:2">कऊँकि से डगमगाणे लगी री।<verse eid="PSA 60:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 60:3" />तैं आपणी प्रजा रे लोका खे बुरे दिन दखाए,</para>
  <para style="q" vid="PSA 60:3">तैं आसा खे लड़खड़ाणे वाल़ा अंगूरा रा रस पल़्याया।<verse eid="PSA 60:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 60:4" />जो तेरे डरो दे रओए, तिना खे तूँ चण्डा देआ,</para>
  <para style="q" vid="PSA 60:4">ताकि सेयो नाश ऊणे ते बची जाओ। सेला<verse eid="PSA 60:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 60:5" />ओ परमेशर तूँ आसा खे आपणी महान शक्ति ओर तागती ते बचा,</para>
  <para style="q" vid="PSA 60:5">ताकि तेरी प्रजा जिना ते तूँ प्यार राखेया छूटी जाओ।<verse eid="PSA 60:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 60:6" />परमेशरे पवित्र जगा ते बोलेया, “मां खुश ऊई की शकेम शईरो रा बटवारा करना</para>
  <para style="q" vid="PSA 60:6">ओर मां सुक्कोतो री काअटी नपवाणी।”<verse eid="PSA 60:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 60:7" />गिलाद देश मेरा ए, मनश्शे रा देश बी मेरा ए</para>
  <para style="q" vid="PSA 60:7">ओर एप्रैमो रा देश मेरे सिरो रा टोप ए,</para>
  <para style="q" vid="PSA 60:7">यहूदा देश मेरा राजदण्ड ए।<verse eid="PSA 60:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 60:8" />पर मोआबो रा देश मेरे तोणे रा पांडा ए;</para>
  <para style="q" vid="PSA 60:8">ओर एदोमो रे देशो पाँदे मां आपणा जोड़ा सेटणा ओर से मेरे मालक ऊणे रा नशाण ऊणा।</para>
  <para style="q" vid="PSA 60:8">क्या पलिश्ती देशो रे लोक एड़ा सोचोए कि तिना री जयजयकार ऊणी? ओर क्या सेयो मांते जीती सकोए?<verse eid="PSA 60:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 60:9" />ओ परमेशर, कुण माखे गढ़वाल़े शईरो दे लई जाओगा?</para>
  <para style="q" vid="PSA 60:9">माखे एदोम देशो तक कुण लई जाओगा?<verse eid="PSA 60:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 60:10" />ओ परमेशर, क्या तैं आसे छाडी नि दित्ते रे?</para>
  <para style="q" vid="PSA 60:10">ओ परमेशर, तूँ म्हारी सेना साथे कऊँ नि जांदा!<verse eid="PSA 60:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 60:11" />म्हारे दुश्मणा रे खलाफ म्हारी मताद कर,</para>
  <para style="q" vid="PSA 60:11">कऊँकि माणूंआ ते मतादा री उम्मीद राखणा बेकार ए।<verse eid="PSA 60:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 60:12" />परमेशरो रिया मतादा रिया बजा ते आसा वीरता साथे लड़ना,</para>
  <para style="q" vid="PSA 60:12">कऊँकि परमेशरो ई म्हारे दुश्मण केसणे।<verse eid="PSA 60:12" /></para>
  <chapter eid="PSA 60" />
  <chapter number="61" style="c" sid="PSA 61" />
  <para style="s">रक्षा रिया तँईं प्रार्थना</para>
  <para style="d">परदान बजाणे वाल़ेया रिया तँईं तारा वाल़े बाजे साथे दाऊदो रा पजन</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 61:1" />ओ परमेशर, मेरी पुकार सुण,</para>
  <para style="q" vid="PSA 61:1">मेरी प्रार्थना रिया तरफा खे त्यान दे।<verse eid="PSA 61:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 61:2" />नराजगिया दे ओर करो ते दूर आऊँ तुसा खे आका पाऊँआ!</para>
  <para style="q" vid="PSA 61:2">माखे सुरक्षित जगा दे लई चलो,</para>
  <para style="q" vid="PSA 61:2">केसी एड़े मजबूत गढ़ो पाँदे जेती आँऊ सई-सलामत रई सकूँ, माखे लई चल।<verse eid="PSA 61:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 61:3" />कऊँकि तूँ मेरी शरण लणे री जगा ए</para>
  <para style="q" vid="PSA 61:3">ओर दुश्मणा ते बचणे रिया खातर ऊच्चे किले जेड़ा ए।<verse eid="PSA 61:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 61:4" />आऊँ तेरे तम्बूए रे जुगो-जुगो तक रणा चाऊँआ।</para>
  <para style="q" vid="PSA 61:4">आऊँ तेरे पंखा री आड़ा रे शरण लणा चाऊँआ। सेला<verse eid="PSA 61:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 61:5" />ओ परमेशर, तैं मेरिया मान्नता सुणिया,</para>
  <para style="q" vid="PSA 61:5">जो तेरे नाओं रे पग्त ए, तैं तिना री इच्छा पूरी करी राखी।<verse eid="PSA 61:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 61:6" />तां राजे री उम्र बऊत बढ़ाणी;</para>
  <para style="q" vid="PSA 61:6">तेसरी उम्रा रे साल कईया पीढ़िया रे बराबर ऊणे।<verse eid="PSA 61:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 61:7" />से परमेशरो सामणे सदा बणेया रा रणा;<note caller="+" style="f"><char style="fr" closed="false">61:7 </char><char style="ft" closed="false">तेसरा राज्य</char></note></para>
  <para style="q" vid="PSA 61:7">तूँ आपणी करूणा ओर सच्चाईया खे ठराई की राख कि सेयो तेसरी रक्षा करो।<verse eid="PSA 61:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 61:8" />ईंयाँ मां सदा तेरे नाओं रा पजन गायी-गायी की</para>
  <para style="q" vid="PSA 61:8">आपणी मान्नता हर दिन पुरिया करेया करनिया।<verse eid="PSA 61:8" /></para>
  <chapter eid="PSA 61" />
  <chapter number="62" style="c" sid="PSA 62" />
  <para style="s">परमेशरो रे उद्धारो रिया तँईं इन्तजार</para>
  <para style="d">बजाणे वाल़े परदानो रिया तँईं दाऊदो रा पजन। यदूतून रागो पाँदे</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 62:1" />आऊँ ईम्मती साथे परमेशरो रा इन्तजार करूँआ कि से माखे बचाओ;</para>
  <para style="q" vid="PSA 62:1">आऊँ सिर्फ तेस ई पाँदे पुरिया तरआ ते परोसा करूँआ।<verse eid="PSA 62:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 62:2" />मेरी रक्षा करने वाल़ा ओर माखे बचाणे वाल़ा सेईए;</para>
  <para style="q" vid="PSA 62:2">से मेरे शरण लणे रा ऊच्चा गढ़ ए ओर कोई बी माखे अराई नि सकदा।<verse eid="PSA 62:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 62:3" />तुसा कदुए तक केसी एड़े माणूंए पाँदे अमला करना</para>
  <para style="q" vid="PSA 62:3">जो एक टुटी-फुटी दी दवाला ते जादा मजबूत नि ए?<verse eid="PSA 62:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 62:4" />सेयो माखे मेरे आदरो रिया जगा ते बारे निकाल़ना चाओए,</para>
  <para style="q" vid="PSA 62:4">सेयो चूठ बोलणे ते प्यार राखोए,</para>
  <para style="q" vid="PSA 62:4">मुंए ते तो सेयो आशीर्वाद देणे रिया गल्ला करोए, पर दिलो ते स्राप देओए। सेला<verse eid="PSA 62:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 62:5" />आऊँ परमेशरो रे आसरे रऊँआ,</para>
  <para style="q" vid="PSA 62:5">ओर आऊँ तेस पाँदे परोसा राखूँआ।<verse eid="PSA 62:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 62:6" />सेई मेरी रक्षा करोआ ओर बचाओआ;</para>
  <para style="q" vid="PSA 62:6">से मेरा रक्षक ए, ओर आऊँ कदी बी आरना नि।<verse eid="PSA 62:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 62:7" />मेरा उद्धार ओर मेरी महिमा रा आधार परमेशर ए;</para>
  <para style="q" vid="PSA 62:7">सेई मेरी मजबूत चट्टान ओर मेरी शरण लणे री जगा ए।<verse eid="PSA 62:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 62:8" />ओ लोको, हर बखत परमेशरो पाँदे परोसा राखो!</para>
  <para style="q" vid="PSA 62:8">तेसते आपणे मनो रिया गल्ला खुली की बोलो,</para>
  <para style="q" vid="PSA 62:8">कऊँकि परमेशर म्हारी शरण लणे री जगा ए। सेला<verse eid="PSA 62:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 62:9" />आसे माणूं तो बस एक साओ जेड़े ए; आसा बीचा ते कोई बी महान नि ए।</para>
  <para style="q" vid="PSA 62:9">आसा सबी रा बजन एक अवा रे चोंके ते बी कम ए।<verse eid="PSA 62:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 62:10" />अन्देर करने पाँदे परोसा नि राखो</para>
  <para style="q" vid="PSA 62:10">ओर लूट-मार करी की मिली री चीजा पाँदे बेकारो रे नि फूलो,</para>
  <para style="q" vid="PSA 62:10">चाए तअन-दौलत बढ़ी जाओ, तेबे बी तिजी पाँदे मन नि लगाणा।<note caller="+" style="f"><char style="fr" closed="false">62:10 </char><char style="ft" closed="false">मत्ती 19:21,22, 1 तीमुथि 6:17</char></note><verse eid="PSA 62:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 62:11" />मैं परमेशरो खे एकी ते जादा बार ये बोलदे ऊए सुणी राखेया कि सिर्फ सेईए जेसगे सई दे शक्ति ए।<verse eid="PSA 62:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 62:12" />ओर ओ प्रभु, करूणा बी तेरी ईए।</para>
  <para style="q" vid="PSA 62:12">कऊँकि तूँ एकी-एकी माणूंए खे तेसरे कामो रे मुताबिक प्रतिफल देया।<note caller="+" style="f"><char style="fr" closed="false">62:12 </char><char style="ft" closed="false">दानिय्येल 9:9, मत्ती 16:27, रोमी 2:6, प्रकाशित 22:12</char></note><verse eid="PSA 62:12" /></para>
  <chapter eid="PSA 62" />
  <chapter number="63" style="c" sid="PSA 63" />
  <para style="s">परमेशर त्यायी आत्मा खे रजाओआ</para>
  <para style="d">दाऊदो रा पजन जेबे से यहूदा प्रदेशो री सुनसाण जगा रे था।</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 63:1" />तूँ मेरा परमेशर ए! आऊँ तेरी आराधना करूँआ।</para>
  <para style="q" vid="PSA 63:1">मेरा दिल तेरिया तँईं एड़ा तरसोआ, जेड़ा रेगिस्तानो दे ठण्डे पाणिये खे तरसोए।<verse eid="PSA 63:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 63:2" />ईंयाँ मैं पवित्र जगा रे तां पाँदे नजर कित्ती,</para>
  <para style="q" vid="PSA 63:2">ताकि आँऊ तेरी महिमा ओर सामर्थ देखूँ।<verse eid="PSA 63:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 63:3" />कऊँकि तेरी अटल प्यार जिन्दगिया ते बी खरी ए,</para>
  <para style="q" vid="PSA 63:3">मां आपणे मुंए ते तेरी तारीफ करनी।<verse eid="PSA 63:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 63:4" />जदुए तक आँऊ जिऊँदा ए तदुए तक मां ताखे तन्य बोलदे रणा;</para>
  <para style="q" vid="PSA 63:4">मां तेरिया तरफा खे आपणे आथ फैलाणे ओर तेरे नाओं ते प्रार्थना करनी।<verse eid="PSA 63:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 63:5" />तूँ माखे बऊत खुश करेआ, बडिया खाणे ते खरा। मां तेरी स्तुति करने रिया तँईं खुशिया ते गीत गाणा।</para>
  <para style="q" vid="PSA 63:5">ओर मां जयजयकार करी की तेरी स्तुति करनी।<verse eid="PSA 63:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 63:6" />जेबे आऊँ बिस्तरे पाँदे लेटेया दा ऊँआ, आऊँ ताखे याद करूँआ,</para>
  <para style="q" vid="PSA 63:6">ओर सारी रात तेरे ई बारे दे सोचेया करूँआ।<verse eid="PSA 63:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 63:7" />कऊँकि तूँ मेरा मतदगार बणी रा,</para>
  <para style="q" vid="PSA 63:7">इजी री खातर मां तेरे पंखा री छाया रे तेरी जयजयकार करनी।<verse eid="PSA 63:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 63:8" />मेरा प्राण तां साथे जुड़ी रा</para>
  <para style="q" vid="PSA 63:8">ओर तेरा दाँणा आथ माखे सम्बाल़ोआ।<verse eid="PSA 63:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 63:9" />पर जो लोक माखे काणे री कोशिश करोए,</para>
  <para style="q" vid="PSA 63:9">सेयो मरे दे लोका रिया दुनिया दे चली जाणे।<verse eid="PSA 63:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 63:10" />सेयो तलवारी साथे काये जाणे</para>
  <para style="q" vid="PSA 63:10">ओर गीदड़ा खे खाणे रिया तँईं ऊई जाणे।<verse eid="PSA 63:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 63:11" />पर राजा परमेशरो रिया बजा ते खुश ऊणा;</para>
  <para style="q" vid="PSA 63:11">सब कोई परमेशरो री कसम खाओए</para>
  <para style="q" vid="PSA 63:11">ओर तिदे ई आपणी तारीफ करने लगोए;</para>
  <para style="q" vid="PSA 63:11">पर चूठ बोलणे वाल़े लोका रा मूँ बंद कित्तेया जाणा।<verse eid="PSA 63:11" /></para>
  <chapter eid="PSA 63" />
  <chapter number="64" style="c" sid="PSA 64" />
  <para style="s">गुप्त दुश्मणा ते रक्षा रिया तँईं प्रार्थना</para>
  <para style="d">बजाणे वाल़े परदानो रिया तँईं दाऊदो रा पजन</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 64:1" />ओ परमेशर, मां पाँदे बऊत मुसीबत पड़ी री, मेरी प्रार्थना सुण;</para>
  <para style="q" vid="PSA 64:1">आऊँ आपणे दुश्मणा ते डरीगा रा ए, एबे तूँ ई मेरे जीवनो खे बचा!<verse eid="PSA 64:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 64:2" />बुरे काम करने वाल़ेया लोका रिया साजिशा ते</para>
  <para style="q" vid="PSA 64:2">ओर अनर्थ काम करने वाल़ेया रिया योजना ते माखे लकोई दे।<verse eid="PSA 64:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 64:3" />तिने आपणी जीब तलवारी जेड़ी तेज करी राखी</para>
  <para style="q" vid="PSA 64:3">ओर आपणे कऊड़े वचना जेड़े तीर चढ़ाई राखे,<verse eid="PSA 64:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 64:4" />ताकि लूकी की आपणे तीर बेकसूर लोका पाँदे चलाओ;</para>
  <para style="q" vid="PSA 64:4">सेयो तिना पाँदे तीर बाई की डरदे पनि।<verse eid="PSA 64:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 64:5" />सेयो बुरे काम करने खे ईम्मत करोए;</para>
  <para style="q" vid="PSA 64:5">सेयो तिना रे खलाफ जाल़ बछाणे रिया तँईं लूकी की योजना बणाओए</para>
  <para style="q" vid="PSA 64:5">ओर आपणे आपू ते बोलोए, “आसा खे कोई नि देखी सकदा?”<verse eid="PSA 64:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 64:6" />सेयो सारे बुरे काम करने री योजना बणाओए</para>
  <para style="q" vid="PSA 64:6">ओर एकी दूजे ते बोलोए, “आसे सोची समजी की पक्की योजना बणाई राखी।</para>
  <para style="q" vid="PSA 64:6">कऊँकि माणूंआ रे मन ओर दिलो रे बचार बऊत गईरे ए।”<verse eid="PSA 64:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 64:7" />पर परमेशरो तिना पाँदे आपणे तीर चलाणे;</para>
  <para style="q" vid="PSA 64:7">सेयो अचाणक कायल ऊई जाणे।<verse eid="PSA 64:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 64:8" />परमेशरो तिना री जीब तिना रेई खलाफ बदली देणी</para>
  <para style="q" vid="PSA 64:8">ताकि सेयो ठोकर खाई की नाश ऊई जाओ;</para>
  <para style="q" vid="PSA 64:8">तिना खे देखणे वाल़ेया सारेया लोका आपणा-आपणा सिर ईलांदे ऊए तिना रा मजाक ड्वाणा।<verse eid="PSA 64:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 64:9" />तेबे सारे लोक डरी जाणे</para>
  <para style="q" vid="PSA 64:9">ओर परमेशरो रे कित्ते रे महान कामो रा बखान करना</para>
  <para style="q" vid="PSA 64:9">ओर तेसरे कित्ते रे महान कामा रे बारे दे सोचदे रणे।<verse eid="PSA 64:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 64:10" />यहोवा आपणे तर्मी लोका खे शान्ति ओर खुशिया ते आशीष देयो।</para>
  <para style="q" vid="PSA 64:10">ओर तेसरिया शरणा दे रणे वाल़े तेसरी जयजयकार करो।<verse eid="PSA 64:10" /></para>
  <chapter eid="PSA 64" />
  <chapter number="65" style="c" sid="PSA 65" />
  <para style="s">परमेशरो री स्तुति ओर तन्यवाद</para>
  <para style="d">बजाणे वाल़े परदानो रिया तँईं दाऊदो रा पजन, गीत</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 65:1" />ओ परमेशर, सिय्योनो दे तेरी स्तुति करनी ओर तांते कित्ते दे वादे पूरे करना आसा खे ठीक ए।</para>
  <para style="q" vid="PSA 65:1">ओर तेरिया तँईं मान्नता पुरिया कित्तिया जाणिया!<verse eid="PSA 65:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 65:2" />कऊँकि तूँ सबी री प्रार्थना खे सुणेया,</para>
  <para style="q" vid="PSA 65:2">सब लोक तांगे ई आऊणे।<note caller="+" style="f"><char style="fr" closed="false">65:2 </char><char style="ft" closed="false">प्रेरित 10:34,35, यशायाह 66:23</char></note><verse eid="PSA 65:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 65:3" />मेरे पाप मां पाँदे प्रबल ऊई रे;</para>
  <para style="q" vid="PSA 65:3">पर म्हारे अपराधा खे तूँ माफ कर।<verse eid="PSA 65:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 65:4" />सेयो लोक बऊत ई भाग्यशाली ए,</para>
  <para style="q" vid="PSA 65:4">जिना खे तूँ चूणी की आपू नेड़े आऊणे देआ</para>
  <para style="q" vid="PSA 65:4">ताकि सेयो तेरे मईलो रे आँगणो रे रया करो!</para>
  <para style="q" vid="PSA 65:4">आसे तेरे मईलो रे मतलब तेरे पवित्र मन्दरो रे खरे-खरे पदार्थ खाई की रजणे।<verse eid="PSA 65:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 65:5" />ओ म्हारे उद्धारकर्ता परमेशर, ओ तरतिया रे सारे दूर-दूर देशो रे</para>
  <para style="q" vid="PSA 65:5">ओर दूरो रे समुद्रो रे रणे वाल़ेया री उम्मीद,</para>
  <para style="q" vid="PSA 65:5">तां तार्मिकता ते कित्ते रे नौखे कामा रे जरिए आसा खे मूँ मांगा वरदान देणा;<verse eid="PSA 65:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 65:6" />तैं आपणियां तागती ते बड़े-बड़े पाह्ड़ खड़े करी राखे;</para>
  <para style="q" vid="PSA 65:6">तीजी ते तेरी महान शक्तिया रा पता चलोआ।<verse eid="PSA 65:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 65:7" />तूँ जो समुद्रो रा शाद, तिजी री लईरा रा शाद</para>
  <para style="q" vid="PSA 65:7">ओर देशो-देशो रे लोका रा आल्ला-गोल्ला शान्त करेया;<note caller="+" style="f"><char style="fr" closed="false">65:7 </char><char style="ft" closed="false">मत्ती 8:26, यशायाह 17:12,13</char></note><verse eid="PSA 65:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 65:8" />जो लोक तरतिया पाँदे बऊत दूर-दराजो रिया जगा दे रओए,</para>
  <para style="q" vid="PSA 65:8">सेयो तुसा रे जरिए कित्ते दे चमत्कारा रिया बजा ते तुसा रा आदर करोए; ओर त्यार ओर पच्छमा दे रणे वाल़े लोक खुशिया दे जयजयकार करोए।<verse eid="PSA 65:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 65:9" />तूँ जमीना री सम्बाल़ लई की तिजी खे सिंजेया;</para>
  <para style="q" vid="PSA 65:9">तूँ तिजी खे बऊत पजणे वाल़ी बणाएया;</para>
  <para style="q" vid="PSA 65:9">परमेशरो री नदी पाणिए साथे परी री रओई;</para>
  <para style="q" vid="PSA 65:9">तूँ तरतिया खे त्यार करी की माणूंआ खे नज्ज त्यार करेया।<verse eid="PSA 65:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 65:10" />तूँ डोरूआ री फाटा खे ठीक-टंगो रे सिंजेया</para>
  <para style="q" vid="PSA 65:10">ओर तिना री बीचली माट्टिया खे बठयाल़ेया,</para>
  <para style="q" vid="PSA 65:10">तूँ बर्खा साथे जमीना खे नरम करेया ओर तिजी रिया फसला खे आशीष देया।<verse eid="PSA 65:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 65:11" />आपणी पलाईया साथे पूरे सालो पाँदे तैं मानो मुकुट पन्याई ता रा,</para>
  <para style="q" vid="PSA 65:11">तेरिया बाटा रे कनारे डोरू लईरांदे रओए<verse eid="PSA 65:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 65:12" />सुनसाण प्रदेशो रे रयासी निकल़ोई</para>
  <para style="q" vid="PSA 65:12">ओर पाह्ड़िया खुशिया साथे सजी रिया ए।<verse eid="PSA 65:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 65:13" />चराईया पेडा-बाकरिया साथे परी रिया ए</para>
  <para style="q" vid="PSA 65:13">ओर काअटिया नज्जो साथे टखी रिया ए;</para>
  <para style="q" vid="PSA 65:13">सेयो मिली की जयजयकार करोईया ओर गाओ बीए।<verse eid="PSA 65:13" /></para>
  <chapter eid="PSA 65" />
  <chapter number="66" style="c" sid="PSA 66" />
  <para style="s">परमेशरो रे महान कामा रिया तँईं स्तुति</para>
  <para style="d">बजाणे वाल़े परदानो रिया तँईं गीत, पजन</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 66:1" />ओ सारी तरतिया रे लोको,</para>
  <para style="q" vid="PSA 66:1">परमेशरो रा खुशिया साथे जयजयकार करो;<verse eid="PSA 66:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 66:2" />तेसरे नाओं री महिमा रा पजन गाओ,</para>
  <para style="q" vid="PSA 66:2">तेसरी स्तुति करदे ऊए, तेसरी महिमा करो।<verse eid="PSA 66:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 66:3" />परमेशरो खे बोलो, “तेरे काम कितणे नौखे ए!</para>
  <para style="q" vid="PSA 66:3">तेरी महान सामर्था रिया बजा ते तेरे दुश्मण तां सामणे कुटणे टेकोए।<verse eid="PSA 66:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 66:4" />सारी तरतिया रे लोका तेरी आराधना करनी</para>
  <para style="q" vid="PSA 66:4">ओर तिना तेरी तारीफा रा पजन गाणा;</para>
  <para style="q" vid="PSA 66:4">तिना तेरे नाओं री तारीफा रा पजन गाणा।” सेला<verse eid="PSA 66:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 66:5" />परमेशरे जो काम कित्ते तिना कामा खे आई की देखो;</para>
  <para style="q" vid="PSA 66:5">से आपणे कामा रिया बजा ते माणूंआ खे डराऊणा दिशोआ।<verse eid="PSA 66:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 66:6" />तिने समुद्र सूकिया जमीना दे बदली ता;</para>
  <para style="q" vid="PSA 66:6">लोके पैदल ई चली की नदिया टपी तिया;</para>
  <para style="q" vid="PSA 66:6">इजी री खातर आओ आसे प्रभुए रे कित्ते रे कामा रिया बजा ते तेसदे खुश ओऊँए।<verse eid="PSA 66:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 66:7" />जो आपणियां शक्तिया ते सदा राज करोआ</para>
  <para style="q" vid="PSA 66:7">ओर आपणी आखी साथे देशा-देशा खे ताकोआ।</para>
  <para style="q" vid="PSA 66:7">इजी खे जो लोक तेसरी गल्ल नि मानदे सेयो बिद्रोह करने वाल़े आपणे सिर तेस सामणे नि चको।<verse eid="PSA 66:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 66:8" />ओ देशो-देशो रे लोको म्हारे परमेशरो री स्तुति करो</para>
  <para style="q" vid="PSA 66:8">ओर तेसरी स्तुतिया री आवाज सारिया जगा दे सुणने देओ।<verse eid="PSA 66:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 66:9" />तिने आसे सई-सलामत राखी राखे</para>
  <para style="q" vid="PSA 66:9">ओर म्हारे पैर खड़ीसणे नि दित्ते।<verse eid="PSA 66:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 66:10" />कऊँकि ओ परमेशर तैं आसे परखी राखे;</para>
  <para style="q" vid="PSA 66:10">जिंयाँ चाँदी शुद्ध कित्तेया जाओआ तिंयाँ तैं आसे शुद्ध कित्ते।<note caller="+" style="f"><char style="fr" closed="false">66:10 </char><char style="ft" closed="false">1 पत 1:7, यशायाह 48:10</char></note><verse eid="PSA 66:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 66:11" />तैं आसे मुसीबता दे पड़ने दित्ते</para>
  <para style="q" vid="PSA 66:11">ओर म्हारिया पीठी पाँदे पारी बोजा राखेया था;<verse eid="PSA 66:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 66:12" />तैं म्हारे दुश्मण म्हारे सिरो पाँदिए चलणे दित्ते,</para>
  <para style="q" vid="PSA 66:12">आसे आग ओर पाणिए बीछीए ऊई की गये;</para>
  <para style="q" vid="PSA 66:12">पर तैं आसे तारी की तेते जगा बीचा ते सुखो साथे परी ते।<verse eid="PSA 66:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 66:13" />मां होमबलि लई की तेरे मईलो रे आऊणा;</para>
  <para style="q" vid="PSA 66:13">मां ताखे आपणी मान्नता चढ़ाणियां,<verse eid="PSA 66:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 66:14" />मुसीबता रे बखते मैं जो मान्नत मानी थी,</para>
  <para style="q" vid="PSA 66:14">से मां ताखे देणी।<verse eid="PSA 66:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 66:15" />खाडूआ री चर्बिया रा खुशबू वाल़े तूपो समेत मां ताखे मोटे डांगरा री होमबलि, चढ़ाणी;</para>
  <para style="q" vid="PSA 66:15">मां ताखे बाकरेया समेत बल़द चढ़ाणे। सेला<verse eid="PSA 66:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 66:16" />ओ परमेशरो ते डरने वाल़ेयो, आओ ओर सुणो!</para>
  <para style="q" vid="PSA 66:16">मां तुसा खे बताणा कि परमेशरे मेरिया तँईं क्या-क्या करी राखेया।<verse eid="PSA 66:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 66:17" />मैं से पुकारेया</para>
  <para style="q" vid="PSA 66:17">ओर मैं तेसरा ई गुणगाण कित्तेया।<verse eid="PSA 66:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 66:18" />जे आऊँ आपणे मनो रे अनर्थ गल्ला सोचदा,</para>
  <para style="q" vid="PSA 66:18">तो प्रभु मेरी नि सुणदा।<note caller="+" style="f"><char style="fr" closed="false">66:18 </char><char style="ft" closed="false">यूह. 9:31, नसी 15:29</char></note><verse eid="PSA 66:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 66:19" />पर परमेशरे तो मेरी दुहाई सुणी;</para>
  <para style="q" vid="PSA 66:19">तिने मेरी प्रार्थना रिया तरफा खे त्यान देई राखेया।<verse eid="PSA 66:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 66:20" />तन्य ए परमेशर, जिने ना तो मेरी प्रार्थना अणसुणी कित्ती</para>
  <para style="q" vid="PSA 66:20">ओर ना आपणी करूणा मांते दूर कित्ती।<verse eid="PSA 66:20" /></para>
  <chapter eid="PSA 66" />
  <chapter number="67" style="c" sid="PSA 67" />
  <para style="s">तन्यवादो रा पजन</para>
  <para style="d">बजाणे वाल़े परदानो रिया तँईं तारा वाल़े बाजे साथे पजन, गीत</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 67:1" />ओ परमेशर आसा पाँदे दया करो</para>
  <para style="q" vid="PSA 67:1">ओर आसा खे आशीष देओ;</para>
  <para style="q" vid="PSA 67:1">तूँ आसा पाँदे आपणे मुंए रा प्रयासा चमका। सेला<verse eid="PSA 67:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 67:2" />ताकि पूरी दुनिया रे लोक तेरी इच्छा जाणी लो;</para>
  <para style="q" vid="PSA 67:2">ओर सबी जातिया रे तेरे उद्धारो खे जाणी लो।<note caller="+" style="f"><char style="fr" closed="false">67:2 </char><char style="ft" closed="false">लूक 2:30,31, तीतुस. 2:11</char></note><verse eid="PSA 67:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 67:3" />ओ परमेशर, देशो-देशो रे लोक तेरी सराईणा करो;</para>
  <para style="q" vid="PSA 67:3">देशो-देशो रे सब लोक तेरी सराईणा करो।<verse eid="PSA 67:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 67:4" />दुनिया रे राज्य-राज्य रे लोक खुशी मनाओ</para>
  <para style="q" vid="PSA 67:4">ओर जयजयकार करो; कऊँकि तां दुनिया रे देशा रे लोका रा न्याय निष्पक्षता साथे करना</para>
  <para style="q" vid="PSA 67:4">ओर तरतिया रे राज्य-राज्य रे लोका खे सई बाट बताणी। सेला<verse eid="PSA 67:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 67:5" />ओ परमेशर, दुनिया रे देशो-देशो रे लोक तेरी सराईणा करो,</para>
  <para style="q" vid="PSA 67:5">दुनिया रे देशो-देशो रे सब लोक तेरी सराईणा करो।<verse eid="PSA 67:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 67:6" />आसा रिये जमीने खरी फसल पजाई राखी, ओर परमेशर,</para>
  <para style="q" vid="PSA 67:6">जो आसा रा परमेशर ए, तिने आसा खे आशीष देई राखी।<verse eid="PSA 67:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 67:7" />परमेशरो आसा खे आशीष देणी</para>
  <para style="q" vid="PSA 67:7">ओर तरतिया रे दूर-दूर देशो रे लोका तेसरा आदर करना।<verse eid="PSA 67:7" /></para>
  <chapter eid="PSA 67" />
  <chapter number="68" style="c" sid="PSA 68" />
  <para style="s">इस्राएली लोका रा स्तुतिगान</para>
  <para style="d">बजाणे वाल़े परदानो रिया तँईं दाऊदो रा पजन, गीत</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 68:1" />परमेशर उठी की खड़ा ओआ, ओर आपणे दुश्मणा खे बखेरी देओआ</para>
  <para style="q" vid="PSA 68:1">ओर जो तेसते दुश्मणी राखोए से तेसरे सामणे ते आरी की नठी जाणे।<verse eid="PSA 68:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 68:2" />जिंयाँ तुआँ उडी जाओआ, तिंयाँ ई तूँ तिना खे डवाई दे;</para>
  <para style="q" vid="PSA 68:2">जिंयाँ मोम आगी सामणे गल़ी जाओआ,</para>
  <para style="q" vid="PSA 68:2">तिंयाँ ई दुष्ट लोक परमेशरो रिया मौजुदगिया ते नाश ऊई जाणे।<verse eid="PSA 68:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 68:3" />पर तार्मिक माणूं खुश ऊणे, सेयो परमेशरो सामणे बऊत खुश ऊणे;</para>
  <para style="q" vid="PSA 68:3">सेयो आनंदो साथे बऊत मगन ऊणे!<verse eid="PSA 68:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 68:4" />परमेशरो रिया तँईं गीत गाओ, तेसरे नाओं री स्तुति करो,</para>
  <para style="q" vid="PSA 68:4">जो बादल़ा पाँदे सवार ऊई की चलोआ, तेसरिया तँईं सड़क बणाओ;</para>
  <para style="q" vid="PSA 68:4">तेसरा नाओं यहोवा ए, इजी खे तुसे तेस सामणे खुश ओ!<verse eid="PSA 68:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 68:5" />परमेशर आपणी पवित्र मन्दरो<note caller="+" style="f"><char style="fr" closed="false">68:5 </char><char style="ft" closed="false">स्वर्गो दे</char></note> दे रओआ,</para>
  <para style="q" vid="PSA 68:5">से अनाथ बच्चेया रा बाओ ओर बिदुआ रा रखवाल़ा ए।<verse eid="PSA 68:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 68:6" />परमेशर अनाथा रा कअर बसाओआ</para>
  <para style="q" vid="PSA 68:6">ओर बंदुआ खे छुड़ाई की भाग्यशाली बणाओआ;</para>
  <para style="q" vid="PSA 68:6">पर तेसते बिद्रोह करने वाल़ेया खे ऊजड़ जमीना रे रणा पड़ोआ।<verse eid="PSA 68:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 68:7" />ओ परमेशर, जेबे तूँ आपणी प्रजा ते आगे-आगे चलो था,</para>
  <para style="q" vid="PSA 68:7">जेबे तूँ सुनसाण जगा रे सेना समेत चलेया, सेला<verse eid="PSA 68:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 68:8" />तरतिया पाँदे भूकंप आया ओर बरखा ऊई,</para>
  <para style="q" vid="PSA 68:8">कऊँकि तूँ इस्राएलिया रा परमेशर यहोवा जो सीनै रे पाह्ड़ो पाँदे राज करोआ, तेरे डरो रे मारे तिना खे थुरनी छुटीगी।</para>
  <para style="q" vid="PSA 68:8">परमेशर, आ, इस्राएलो रे परमेशरो री मौजुदगिया रे थरथराणे लगेया।<note caller="+" style="f"><char style="fr" closed="false">68:8 </char><char style="ft" closed="false">इब्रानी 12:26, न्यायियो 5:4,5</char></note><verse eid="PSA 68:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 68:9" />ओ परमेशर, तैं सर्गो ते बऊत जादा बरखा कित्ती,</para>
  <para style="q" vid="PSA 68:9">जेतेते तैं आपणी जगा फेर अरी-परी करी ती।<verse eid="PSA 68:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 68:10" />तेरे लोका रे चूण्ड तेते देशो रे बसणे लगे;</para>
  <para style="q" vid="PSA 68:10">ओ परमेशर, तैं आपणी पलाईया ते गरीब लोका खे खरिया चीजा दित्तिया</para>
  <para style="q" vid="PSA 68:10">जिना री तिना खे जरूरत थी। तैं सेयो मजबूत बणाए।<verse eid="PSA 68:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 68:11" />प्रभु आज्ञा देओआ, तेबे शुभ समाचार सुनाणे वाल़िया जवाणसा रा</para>
  <para style="q" vid="PSA 68:11">बड़ा चूण्ड ऊई जाओआ।<verse eid="PSA 68:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 68:12" />आपणी-आपणी सेना समेत दुश्मण राजे दौड़ी की चली जाओए</para>
  <para style="q" vid="PSA 68:12">ओर कअरे रणे वाल़िया जवाणसा तेसा लूटा रे समानो खे बांडी लओईया।<verse eid="PSA 68:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 68:13" />तिना खे चाँदिए साथे मढ़े रे कबूतरा रे पंख</para>
  <para style="q" vid="PSA 68:13">ओर सूईने साथे मढ़े रे पैर मिले।</para>
  <para style="q" vid="PSA 68:13">ओ मर्दो, क्या तुसे पेडा रिया गवाईणी रे दुबकी की बैठी रणे?<verse eid="PSA 68:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 68:14" />जेबे सर्वशक्तिमान परमेशरे राजे तेते जमीना दे तित्तर बित्तर कित्ते,</para>
  <para style="q" vid="PSA 68:14">तेबे एड़ा लगेया मानो सलमोन पाह्ड़ो पाँदे बर्फ पड़ने लगी री।<verse eid="PSA 68:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 68:15" />बाशानो रा पाह्ड़ परमेशरो रा पाह्ड़ ए;</para>
  <para style="q" vid="PSA 68:15">बाशानो रा पाह्ड़ बऊत ऊच्चा पाह्ड़ ए।<verse eid="PSA 68:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 68:16" />ओ ऊच्चे पाह्ड़ो, तुसे तेस पाह्ड़ो खे ईर्ष्या करी की कऊँ कूरने लगी रा,</para>
  <para style="q" vid="PSA 68:16">जेते पाह्ड़ो खे परमेशरे आपणा राज्य करने रिया तँईं चूणी राखेया</para>
  <para style="q" vid="PSA 68:16">ओर जेते पाँदे प्रभुए जुगो-जुगो तक रणा?<verse eid="PSA 68:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 68:17" />परमेशरो रे रथ बीई ह्जार, बल्कि ह्जारो ए,</para>
  <para style="q" vid="PSA 68:17">प्रभु तिना बीचे ए, जेड़ा से सीनै पाह्ड़ो री पवित्र जगा रे ए।<verse eid="PSA 68:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 68:18" />जेबे परमेशर चोटिया पाँदे आऊणा; तेस आपू साथे बऊत कैदी लई जाणे,</para>
  <para style="q" vid="PSA 68:18">तेस हठ करने वाल़े लोका ते बी पेंट लणी।</para>
  <para style="q" vid="PSA 68:18">यहोवा परमेशर सदा खे तेथी ई रणा।<note caller="+" style="f"><char style="fr" closed="false">68:18 </char><char style="ft" closed="false">इफिसि 4:8</char></note><verse eid="PSA 68:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 68:19" />तन्य ए प्रभु जो हर रोज म्हारा बोज चकोआ;</para>
  <para style="q" vid="PSA 68:19">सेई म्हारा उद्धारकर्ता परमेशर ए। सेला<verse eid="PSA 68:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 68:20" />सेई आसा खे बचाणे वाल़ा परमेशर ठईरेया;</para>
  <para style="q" vid="PSA 68:20">प्रभु परमेशर मौता ते बी बचाओआ।<verse eid="PSA 68:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PSA 68:21" />पक्का परमेशरो आपणे दुश्मणा रे सिर</para>
  <para style="q" vid="PSA 68:21">ओर तेस माणूंए री बाल़ा साथे परी री खोपड़िया पाँदे बायी-बायी की से चूर-चूर करी देणी</para>
  <para style="q" vid="PSA 68:21">जो आपणे पापो ते परी रिया बाटा रे चलदा रओआ।<verse eid="PSA 68:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="PSA 68:22" />यहोवा बोलोआ, “मां आपणे दुश्मण बाशानो ते बल्कि समुद्रो रिया थालिया ते बी वापस लई आऊणे,<verse eid="PSA 68:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="PSA 68:23" />ताकि तूँ आपणे पैरा खे दुश्मणा रे खूनो रे डबोए</para>
  <para style="q" vid="PSA 68:23">ओर तेरे दुश्मण तेरे कुत्तेया रा इस्सा ठईरो।”<verse eid="PSA 68:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="PSA 68:24" />ओ परमेशर, तेरी जीती की वापस आऊणे री शोभा-यात्रा दिशोईया;</para>
  <para style="q" vid="PSA 68:24">मेरे परमेशर, मेरे राजे री शोभा-यात्रा पवित्र जगा रे प्रवेश करदे ऊए दिशोईया।<verse eid="PSA 68:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="PSA 68:25" />गाणे वाल़े आगे-आगे ओर तारा वाल़े बाजे बजाणे वाल़े पीछे-पीछे गये,</para>
  <para style="q" vid="PSA 68:25">तिना रे चऊँ कनारे कुआँरिया डफली बजाओ थिया।<verse eid="PSA 68:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="PSA 68:26" />तेसरे लोका रिया सबा दे परमेशरो री स्तुति करो;</para>
  <para style="q" vid="PSA 68:26">ओ याकूबो रे कराने रे लोको, यहोवे री स्तुति करो!<verse eid="PSA 68:26" /></para>
  <para style="q">
    <verse number="27" style="v" sid="PSA 68:27" />तेती सबी ते छोटा गोत्र बिन्यामीन तिना री अगुवाई करने लगी रा,</para>
  <para style="q" vid="PSA 68:27">तिना रे चूण्डो रे यहूदा रे परदान ओर तिना री सभा समेत जबूलून</para>
  <para style="q" vid="PSA 68:27">ओर नप्ताली गोत्रो रे बी परदान ए।<verse eid="PSA 68:27" /></para>
  <para style="q">
    <verse number="28" style="v" sid="PSA 68:28" />तेरे परमेशरे आपणी सामर्थ दखाई राखी;</para>
  <para style="q" vid="PSA 68:28">ओ परमेशर, आपणी सामर्था खे आसा पाँदे प्रकट कर,</para>
  <para style="q" vid="PSA 68:28">जिंयाँ तैं पईले प्रकट कित्ती।<verse eid="PSA 68:28" /></para>
  <para style="q">
    <verse number="29" style="v" sid="PSA 68:29" />तेरे यरूशलेमो रे मन्दरो रिया बजा ते</para>
  <para style="q" vid="PSA 68:29">राजेया तेरिया तँईं पेंट ल्याऊणी।<verse eid="PSA 68:29" /></para>
  <para style="q">
    <verse number="30" style="v" sid="PSA 68:30" />नगल़ा बीचे रणे वाल़े जंगल़ी डांगरा खे,</para>
  <para style="q" vid="PSA 68:30">साँडा रे चूण्डा खे ओर देशा-देशा रे बाच्छूआ खे थिड़क।</para>
  <para style="q" vid="PSA 68:30">तिना चाँदिए रे टुकड़े लई की आत्म-समर्पण करना;</para>
  <para style="q" vid="PSA 68:30">जो लोक युद्धो ते खुश रओए, प्रभुए सेयो तित्तर बित्तर करीते।<note caller="+" style="f"><char style="fr" closed="false">68:30 </char><char style="ft" closed="false">यहेजकेल 29:3</char></note><verse eid="PSA 68:30" /></para>
  <para style="q">
    <verse number="31" style="v" sid="PSA 68:31" />मिस्र देशो ते अधिकारी आऊणे;</para>
  <para style="q" vid="PSA 68:31">कूश<note caller="+" style="f"><char style="fr" closed="false">68:31 </char><char style="ft" closed="false">इथोपिया</char></note> देशो रे लोका आपणे आथ परमेशरो रिया तरफा खे फुर्तिया रे फैलाणे।<verse eid="PSA 68:31" /></para>
  <para style="q">
    <verse number="32" style="v" sid="PSA 68:32" />ओ तरतिया पाँदले राज्य-राज्य रे लोको, परमेशरो रा गीत गाओ;</para>
  <para style="q" vid="PSA 68:32">प्रभुए री तारीफा रा पजन गाओ! सेला<verse eid="PSA 68:32" /></para>
  <para style="q">
    <verse number="33" style="v" sid="PSA 68:33" />जो सबी ते ऊच्चे सदा रणे वाल़े स्वर्गो रे संवार ऊई की चलोआ,</para>
  <para style="q" vid="PSA 68:33">देखो, से आपणी वाणी सुणाओआ, से गम्भीर वाणी शक्तिशाली ए।<verse eid="PSA 68:33" /></para>
  <para style="q">
    <verse number="34" style="v" sid="PSA 68:34" />परमेशरो री सामर्था री स्तुति करो,</para>
  <para style="q" vid="PSA 68:34">तेसरी महानता इस्राएलो पाँदे छाई री</para>
  <para style="q" vid="PSA 68:34">ओर तेसरी सामर्थ सर्गो रे दिशोई।<verse eid="PSA 68:34" /></para>
  <para style="q">
    <verse number="35" style="v" sid="PSA 68:35" />ओ परमेशर, तूँ आपणियां पवित्र जगा रे डरो जोगा ए,</para>
  <para style="q" vid="PSA 68:35">इस्राएलो रा परमेशर ई आपणी प्रजा खे सामर्थ</para>
  <para style="q" vid="PSA 68:35">ओर शक्ति देणे वाल़ा ए। परमेशर तन्य ए।<verse eid="PSA 68:35" /></para>
  <chapter eid="PSA 68" />
  <chapter number="69" style="c" sid="PSA 69" />
  <para style="s">मुसीबता रे बखते मतादा रिया तँईं पुकार</para>
  <para style="d">बजाणे वाल़े परदानो रिया तँईं शोशन्नीम रागो रे दाऊदो रा गीत</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 69:1" />ओ परमेशर, माखे बचाई लओ! कऊँकि बाढ़ा रा पाणी मेरे गल़े तक आईगा रा</para>
  <para style="q" vid="PSA 69:1">ओर आऊँ डूबणे लगी रा।<verse eid="PSA 69:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 69:2" />आऊँ चिकड़ो बीचे तसणे लगी रा</para>
  <para style="q" vid="PSA 69:2">ओर माखे पैर राखणे खे केथी बी जगा नि ए;</para>
  <para style="q" vid="PSA 69:2">आऊँ डूगे पाणिए बीचे आईगा रा ओर पाणिए री ताअरा रे डूबणे लगी रा।<verse eid="PSA 69:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 69:3" />आऊँ आका पाँदे-पाँदे थकी गा, मेरा गल़ा सूकीगा रा;</para>
  <para style="q" vid="PSA 69:3">आपणे परमेशरो खे न्याल़दे-न्याल़दे मेरिया आखी थकी गी रिया।<verse eid="PSA 69:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 69:4" />जो बिना बजा ते मेरे बैरी ए,</para>
  <para style="q" vid="PSA 69:4">सेयो गिणतिया रे मेरे सिरो रे बाल़ा ते बी जादा ए।</para>
  <para style="q" vid="PSA 69:4">माखे नाश करने वाल़े जो बेकारो रेई मेरे दुश्मण ए,</para>
  <para style="q" vid="PSA 69:4">मां पाँदे चूठे दोष लगाणे वाल़े तागतबर ए,</para>
  <para style="q" vid="PSA 69:4">जो मैं लूटी नि राखेया, से बी माखे देणा पड़ेया।<note caller="+" style="f"><char style="fr" closed="false">69:4 </char><char style="ft" closed="false">यूह. 15:25, पजन 35:19</char></note><verse eid="PSA 69:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 69:5" />ओ परमेशर, तूँ तो मेरी मूर्खता खे जाणेया</para>
  <para style="q" vid="PSA 69:5">ओर मेरे कित्ते रे अपराद तां सामणे ए।<verse eid="PSA 69:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 69:6" />ओ प्रभु, ओ स्वर्गिय सेनाओं रे प्रभु, जिना री उम्मीद तां पाँदे ए,</para>
  <para style="q" vid="PSA 69:6">सेयो मेरिया बजा ते शर्मिंदा नि ओ,</para>
  <para style="q" vid="PSA 69:6">ओ इस्राएलो रे परमेशर, जो ताखे टोल़ोए,</para>
  <para style="q" vid="PSA 69:6">सेयो मेरिया बजा ते बेज्जत नि ओ।<verse eid="PSA 69:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 69:7" />तेरिया ई तँईं मेरी निंदा ऊई री</para>
  <para style="q" vid="PSA 69:7">ओर मेरा मूँ शरमा रे मारे टखी रा।<verse eid="PSA 69:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 69:8" />आऊँ आपणे ई इस्राएली पाईया सामणे पाखला माणूं बणीगा</para>
  <para style="q" vid="PSA 69:8">ओर आपणे सके पाईया रिया नजरा रे परदेशी ठईरेया।<verse eid="PSA 69:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 69:9" />कऊँकि आऊँ तेरे मईलो रिया तँईं जोशो साथे परेया रा फुखदे-फुखदे पस्म ऊईगा</para>
  <para style="q" vid="PSA 69:9">ओर जो निंदा सेयो तेरी करोए, सेई निंदा माखे सईन करनी पड़ोई।<note caller="+" style="f"><char style="fr" closed="false">69:9 </char><char style="ft" closed="false">यूह. 2:17, रोमी 15:3, इब्रानी 11:26, रोमी. 15:3</char></note><verse eid="PSA 69:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 69:10" />जेबे मैं रोंदे ऊए बअरत करी की आपणे आपू खे नम्र कित्तेया,</para>
  <para style="q" vid="PSA 69:10">तेबे तिजी ते बी मेरी निंदा ई ऊई।<verse eid="PSA 69:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 69:11" />जेबे आँऊ टाटा<note caller="+" style="f"><char style="fr" closed="false">69:11 </char><char style="fq" closed="false">टाटा </char><char style="ft" closed="false">टाट मतलब शोगो रे टाल्ले</char></note> रे टाल्ले पईनुँआ,</para>
  <para style="q" vid="PSA 69:11">ये देखणे खे कि आऊँ उदास आ, तो सेयो मेरा मजाक उडाओए।<verse eid="PSA 69:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 69:12" />सेयो हर जगा दे मेरे बारे दे गल्ला करोए,</para>
  <para style="q" vid="PSA 69:12">ओर शराबी मेरे बारे दे गीत बणाओए।<verse eid="PSA 69:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 69:13" />पर ओ यहोवा, मेरी प्रार्थना तो तेरिया खुशिया रे बखते ई ऊई ए;</para>
  <para style="q" vid="PSA 69:13">ओ परमेशर आपणी बड़ी पारी करूणा ते</para>
  <para style="q" vid="PSA 69:13">ओर बचाणे री आपणी सच्ची कसमा रे मुताबिक मेरी सुणी लओ।<verse eid="PSA 69:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 69:14" />माखे चिकड़ो बीचा ते बारे निकयाल़ी दे ताकि आऊँ तिदे तसी नि जाऊँ;</para>
  <para style="q" vid="PSA 69:14">माखे मेरे बैरिया ते ओर डूगे पाणिए रे डूबणे ते बचाई लओ।<verse eid="PSA 69:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 69:15" />आऊँ पाणिए री ताअरा रे हड़ी नि जाऊँ</para>
  <para style="q" vid="PSA 69:15">ओर ना ई आऊँ डूगे पाणिए रे डूबी की मरूँ ओर ना ई कब्रा रा मूरा मां पाँदे बंद ओ।<verse eid="PSA 69:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 69:16" />ओ प्रभु, माखे उत्तर दे, कऊँकि तेरी करूणा बऊत खरी ए;</para>
  <para style="q" vid="PSA 69:16">आपणी दया रे मुताबिक मेरिया तरफा खे त्यान दे।<verse eid="PSA 69:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 69:17" />आपणे दासो ते आपणे आपू खे नि लको,</para>
  <para style="q" vid="PSA 69:17">कऊँकि आऊँ बडिया मुसीबता रे आ, फटाफट माखे ज्वाब दे।<verse eid="PSA 69:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 69:18" />मां नेड़े आई की माखे छुड़ाई लओ,</para>
  <para style="q" vid="PSA 69:18">मेरे दुश्मणा ते माखे आजाद करी दे।<verse eid="PSA 69:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 69:19" />तूँ मेरी निंदा, शर्म ओर मेरी बेज्जतिया खे</para>
  <para style="q" vid="PSA 69:19">जो आऊँ सईणे लगी रा तिना सबी खे जाणेया,</para>
  <para style="q" vid="PSA 69:19">तूँ मेरे सारे बैरिया खे जाणेया।<verse eid="PSA 69:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 69:20" />मेरा दिल निंदा रिया बजा ते दु:खी ए</para>
  <para style="q" vid="PSA 69:20">ओर आऊँ बऊत ई जादा उदास ए।</para>
  <para style="q" vid="PSA 69:20">मैं केसी तरस खाणे वाल़े री उम्मीद तो कित्ती पर कोई नि मिलेया</para>
  <para style="q" vid="PSA 69:20">ओर शान्ति देणे वाल़ेया खे न्याल़दा रया, पर कोई नि मिलेया।<verse eid="PSA 69:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PSA 69:21" />तिने लोके माखे खाणे खे जईर दित्तेया</para>
  <para style="q" vid="PSA 69:21">ओर मेरी त्याय मटयाणे खे सिरका पल़्याया।<note caller="+" style="f"><char style="fr" closed="false">69:21 </char><char style="ft" closed="false">मरक 15:23,36, लूक 23:36, यूह. 19:28,29</char></note><verse eid="PSA 69:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="PSA 69:22" />तिना री रोटिया री जगा तिना खे फन्दे री जगा बणी जाओ</para>
  <para style="q" vid="PSA 69:22">ओर जेबे सेयो मां साथे शान्तिया ते रणे लगी रे ओ,</para>
  <para style="q" vid="PSA 69:22">से बखत तिना खे फन्दा बणी जाओ।<verse eid="PSA 69:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="PSA 69:23" />तिना रिया आखी तुँदल़िया पड़ी जाओ ताकि सेयो देखी नि सको</para>
  <para style="q" vid="PSA 69:23">ओर तूँ तिना रे लको खे सदा ई चुकाई की राख।<note caller="+" style="f"><char style="fr" closed="false">69:23 </char><char style="ft" closed="false">रोमी 11:9,10</char></note><verse eid="PSA 69:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="PSA 69:24" />तूँ तिना पाँदे आपणा गुस्सा पड़का</para>
  <para style="q" vid="PSA 69:24">ओर तेरा पड़केया रा गुस्सा तिना खे स्वा करी देओ।<note caller="+" style="f"><char style="fr" closed="false">69:24 </char><char style="ft" closed="false">प्रकाशित 16:1</char></note><verse eid="PSA 69:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="PSA 69:25" />तिना रे रणे री जगा ऊजड़ी जाओ,</para>
  <para style="q" vid="PSA 69:25">तिना रे कअरो रे कोई नि रओ।<note caller="+" style="f"><char style="fr" closed="false">69:25 </char><char style="ft" closed="false">प्रेरित 1:20</char></note><verse eid="PSA 69:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="PSA 69:26" />एड़े माणूं तेस आदमिए रा पीछा करोए जो तैं मारी राखेया;</para>
  <para style="q" vid="PSA 69:26">सेयो तिना लोका री तकलीफा री चर्चा करोए जो तैं कायल कित्ते।<note caller="+" style="f"><char style="fr" closed="false">69:26 </char><char style="ft" closed="false">यशायाह. 53:4</char></note><verse eid="PSA 69:26" /></para>
  <para style="q">
    <verse number="27" style="v" sid="PSA 69:27" />तिना रे सबी पापा खे लिखी लओ।</para>
  <para style="q" vid="PSA 69:27">तिना रे पाप तिना खे कदी बी माफ नि करने, कि सेयो तर्मी ऊई जाओ।<verse eid="PSA 69:27" /></para>
  <para style="q">
    <verse number="28" style="v" sid="PSA 69:28" />जिन्दगिया री कताबा ते तिना रा नाओं मटयाई दे</para>
  <para style="q" vid="PSA 69:28">ओर तिना रे नाओं तर्मिया साथे लिखेया नि जाओ।<note caller="+" style="f"><char style="fr" closed="false">69:28 </char><char style="ft" closed="false">लूक 10:20, प्रकाशित 3:5, प्रकाशित 20:12,15, प्रकाशित 21:27</char></note><verse eid="PSA 69:28" /></para>
  <para style="q">
    <verse number="29" style="v" sid="PSA 69:29" />मां साथे बुरा बर्ताओ करने लगी रे ओर दु:ख ऊणे लगी रा।</para>
  <para style="q" vid="PSA 69:29">मेरी रक्षा करो, परमेशर, ओर माखे बचाई की राख!<verse eid="PSA 69:29" /></para>
  <para style="q">
    <verse number="30" style="v" sid="PSA 69:30" />मां गाणा गायी की यहोवे रे नाओं री स्तुति करनी</para>
  <para style="q" vid="PSA 69:30">ओर तन्यवाद करदे ऊए तेरी तारीफ करनी। <verse eid="PSA 69:30" /><verse number="31" style="v" sid="PSA 69:31" />एड़ा करने ते ओ यहोवा तूँ डांगरा रिया बलिया ते बी जादा खुश ऊणे।</para>
  <para style="q" vid="PSA 69:31">बल्कि सींगा वाल़े ओर खुरो वाल़े बल़दो रिया बलिया ते बी जादा अच्छा लगणा।<verse eid="PSA 69:31" /></para>
  <para style="q">
    <verse number="32" style="v" sid="PSA 69:32" />नम्र लोक इजी खे देखी की खुश ऊणे;</para>
  <para style="q" vid="PSA 69:32">ओ परमेशरो खे टोल़ने वाल़ेयो, तुसा रे दिलो खे नवीं तागत मिलो।<verse eid="PSA 69:32" /></para>
  <para style="q">
    <verse number="33" style="v" sid="PSA 69:33" />कऊँकि प्रभु गरीबा री सुणोआ ओर आपणे लोका ते,</para>
  <para style="q" vid="PSA 69:33">जो बंदुए ए तिना ते कृणा नि करदा।<verse eid="PSA 69:33" /></para>
  <para style="q">
    <verse number="34" style="v" sid="PSA 69:34" />स्वर्ग ओर तरती, समुद्र</para>
  <para style="q" vid="PSA 69:34">ओर तिदे सब रणे वाल़े सारे जीव-जंतु तेरी स्तुति करो।<verse eid="PSA 69:34" /></para>
  <para style="q">
    <verse number="35" style="v" sid="PSA 69:35" />परमेशरो सिय्योनो री रक्षा करनी</para>
  <para style="q" vid="PSA 69:35">ओर यहूदा प्रदेशो रे शईर फेर बसाणे</para>
  <para style="q" vid="PSA 69:35">ओर प्रभुए रे लोक तेती फेर बसी की तेथो रे अक्कदार ऊई जाणे।<verse eid="PSA 69:35" /></para>
  <para style="q">
    <verse number="36" style="v" sid="PSA 69:36" />तेसरे दासा रे वंशो रे लोका से आपणे इस्से रे पाणा</para>
  <para style="q" vid="PSA 69:36">ओर प्रभुए रे नाओं ते प्यार करने वाल़े ई तेती बसे रे रणे।<verse eid="PSA 69:36" /></para>
  <chapter eid="PSA 69" />
  <chapter number="70" style="c" sid="PSA 70" />
  <para style="s">मतादा रिया तँईं प्रार्थना</para>
  <para style="d">बजाणे वाल़े परदानो रिया तँईं : दाऊदो रा पजन, याद कराणे रिया तँईं।</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 70:1" />ओ परमेशर, मेरा उद्धार कर,</para>
  <para style="q" vid="PSA 70:1">ओ प्रभु, बिना देर कित्ते मेरी मताद कर!<verse eid="PSA 70:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 70:2" />जो माणूं मेरा प्राण लणे रिया टोल़ा रे ए,</para>
  <para style="q" vid="PSA 70:2">तिना री बेज्जती कित्ती जाओ ओर सेयो कबराई जाओ!</para>
  <para style="q" vid="PSA 70:2">जो मेरे नुकशाणो ते खुश ओए, सेयो पीछे टाए जाओ</para>
  <para style="q" vid="PSA 70:2">ओर तिना रा नरादर कित्तेया जाओ।<verse eid="PSA 70:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 70:3" />जो मेरी बेज्जती करोए, सेयो दुश्मण बदनाम ऊणे चाईयो आपणियां आरी खे देखी की।<verse eid="PSA 70:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 70:4" />पर जितणे ताखे टोल़ोए, सेयो सारे तेरिया बजा ते खुश ओर आनंदित ओ</para>
  <para style="q" vid="PSA 70:4">ओर जो लोक तेरे उद्धारो ते प्यार करोए,</para>
  <para style="q" vid="PSA 70:4">सेयो लगातार ये बोलदे रओ, “परमेशरो री तारीफ ओ!”<verse eid="PSA 70:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 70:5" />पर आऊँ तो दु:खी ओर गरीब ए;</para>
  <para style="q" vid="PSA 70:5">ओ परमेशर, चटचारे मेरी मताद कर!</para>
  <para style="q" vid="PSA 70:5">तूँ मेरा मतदगार ओर छुड़ाणे वाल़ा ए;</para>
  <para style="q" vid="PSA 70:5">ओ यहोवा, मेरी मताद करने दे देर नि कर!<verse eid="PSA 70:5" /></para>
  <chapter eid="PSA 70" />
  <chapter number="71" style="c" sid="PSA 71" />
  <para style="s">एक बुजुर्ग माणूंए री प्रार्थना</para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 71:1" />ओ प्रभु, आऊँ तेरी शरणा रे आई रा,</para>
  <para style="q" vid="PSA 71:1">मेरी उम्मीद कदी नि टूटो!<verse eid="PSA 71:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 71:2" />तूँ माखे आपणी तार्मिकता रे जरिए छुड़ाई लओ</para>
  <para style="q" vid="PSA 71:2">ओर माखे बचा; मेरी तरफा खे त्यान दे ओर मेरी मताद कर!<verse eid="PSA 71:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 71:3" />मेरिया रक्षा रिया तँईं मेरी सई-सलामत जगा ओर एक मजबूत गढ़ बण;</para>
  <para style="q" vid="PSA 71:3">तूँ ई मेरी जगा ओर रक्षा ए।<verse eid="PSA 71:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 71:4" />ओ मेरे परमेशर, दुष्ट, बुरे ओर क्रूर माणूंआ रे आथा ते मेरी रक्षा कर।<verse eid="PSA 71:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 71:5" />कऊँकि ओ प्रभु परमेशर,</para>
  <para style="q" vid="PSA 71:5">तूँई मेरी उम्मीद ए, बचपनो तेई मेरा आधार तूँई ए।<verse eid="PSA 71:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 71:6" />जन्मो तेई मैं तेरा आसरा लया;</para>
  <para style="q" vid="PSA 71:6">से तूँई था जिने मेरिया माया रे गर्भो ते आँऊ निकयाल़ेया था;</para>
  <para style="q" vid="PSA 71:6">इजी री खातर मां सदा तेरी स्तुति करदे रणा।<verse eid="PSA 71:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 71:7" />आऊँ बऊत जणेया खे चमत्कार बणी रा;</para>
  <para style="q" vid="PSA 71:7">पर तूँई मेरी शरण लणे री जगा ए।<verse eid="PSA 71:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 71:8" />मेरे मुंए ते तेरा गुणगाण</para>
  <para style="q" vid="PSA 71:8">ओर तेरी महिमा लगातार ऊँदी रओ।<verse eid="PSA 71:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 71:9" />स्याणदे बखते माखे नि छाडेया;</para>
  <para style="q" vid="PSA 71:9">जेबे मेरी तागत कम ऊई जाओ तो माखे नि छाडेया।<verse eid="PSA 71:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 71:10" />जो मेरे प्राणो रिया ताका रे ए सेयो आपू बीचे सम्मति करोए।</para>
  <para style="q" vid="PSA 71:10">मेरे दुश्मण मेरे बारे ये गल्ला बणाओए कि<verse eid="PSA 71:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 71:11" />सेयो एकी दूजे ते बोलोए कि परमेशरे से छाडीता रा; तेसरा पीछा करी की तेसखे पकड़ी लओ,</para>
  <para style="q" vid="PSA 71:11">कऊँकि तेसखे छुड़ाणे वाल़ा कोई नि ए।<verse eid="PSA 71:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 71:12" />ओ परमेशर, मांते दूर नि रओ;</para>
  <para style="q" vid="PSA 71:12">ओ परमेशर मेरी मताद करने रिया तँईं देर नि कर!<verse eid="PSA 71:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 71:13" />जो मेरे प्राणो रे टोल़ा रे ए, तिना री उम्मीद टूटो ओर सेयो नाश ऊई जाओ;</para>
  <para style="q" vid="PSA 71:13">जो मेरा नुकशाण करना चाओए, सेयो निंदा ओर अनादरो रे पड़ी जाओ।<verse eid="PSA 71:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 71:14" />आऊँ हमेशा तां पाँदे परोसा करूँआ,</para>
  <para style="q" vid="PSA 71:14">मां तेरी जयजयकार ओर बी जादा करनी।<verse eid="PSA 71:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 71:15" />मां पूरा दिन आपणे मुंए ते तेरी तार्मिकता री</para>
  <para style="q" vid="PSA 71:15">ओर तेरे कित्ते रे उद्धारो रे कामा री ओर तेरे अणगिणत कामा री चर्चा करदे रणा।</para>
  <para style="q" vid="PSA 71:15">कऊँकि तिना रा पूरा ब्योरा मेरिया समजा ते पोरे ए।<verse eid="PSA 71:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 71:16" />मां आपणे प्रभु परमेशरो रे सामर्था रे कामा रा बखाण करदे ऊए आऊणा,</para>
  <para style="q" vid="PSA 71:16">प्रभु, मां बस तेरी ई तार्मिकता री चर्चा करदे रणा।<verse eid="PSA 71:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 71:17" />ओ परमेशर, तूँ तो माखे बचपनो तेई सिखांदा आई रा</para>
  <para style="q" vid="PSA 71:17">ओर आऊँ एबुए तक तेरे अचम्बे रे कामा रा प्रचार करदे आई रा।<verse eid="PSA 71:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 71:18" />इजी री खातर ओ परमेशर, जेबे आऊँ स्याणा ऊई जाऊँ</para>
  <para style="q" vid="PSA 71:18">ओर मेरे बाल़ सफेद ऊई जाओ, तेबे बी तूँ माखे नि छाडेया,</para>
  <para style="q" vid="PSA 71:18">जदुए तक आऊँ आऊणे वाल़ी पीढ़िया रे लोका गे तेरिया बांई री तागत</para>
  <para style="q" vid="PSA 71:18">ओर पराक्रमो रे बारे नि सुणाई देऊँ।</para>
  <para style="q" vid="PSA 71:18">तदुए तक माखे जिऊँदा राखेया।<verse eid="PSA 71:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 71:19" />ओ परमेशर, तेरी तार्मिकता बऊत महान ए।</para>
  <para style="q" vid="PSA 71:19">जिने बड़े-बड़े काम करी राखे, ओ परमेशर तां बराबर कोई बी नि ए।<verse eid="PSA 71:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 71:20" />तैं तो आसा गे बऊत कठण कष्ट दखाई राखे,</para>
  <para style="q" vid="PSA 71:20">पर तां एबे फेर आसे जिऊँदे करने ओर तरतिया री डूगिया जगा ते फेर बारे निकयाल़ने।<verse eid="PSA 71:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PSA 71:21" />तां मेरी इज्जत बड़ाणी</para>
  <para style="q" vid="PSA 71:21">ओर माखे दुबारा ते शान्ति देणी।<verse eid="PSA 71:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="PSA 71:22" />ओ मेरे परमेशर, मां सारंगी बजाई की तेरी सच्चाईया री सराईणा करनी;</para>
  <para style="q" vid="PSA 71:22">ओ इस्राएलो रे पवित्र परमेशर, मां बीणा बजाई की तेरा पजन गाणा।<verse eid="PSA 71:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="PSA 71:23" />जेबे मां तेरा पजन गाणा,</para>
  <para style="q" vid="PSA 71:23">तेबे आपणे मुंए ते ओर आपणे प्राणो ते बी,</para>
  <para style="q" vid="PSA 71:23">जो तैं बचाई ला रा, जयजयकार करनी।<verse eid="PSA 71:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="PSA 71:24" />मां तेरी तार्मिकता री चर्चा लगातार करदे रणा;</para>
  <para style="q" vid="PSA 71:24">कऊँकि जो लोक मेरा नुकशाण करने री कोशिश करो थे,</para>
  <para style="q" vid="PSA 71:24">तिना री उम्मीद टूटी गी ओर सेयो बेज्जत ऊईगे।<verse eid="PSA 71:24" /></para>
  <chapter eid="PSA 71" />
  <chapter number="72" style="c" sid="PSA 72" />
  <para style="s">तर्मी राजे रा राज्य</para>
  <para style="d">सुलैमानो रा गीत</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 72:1" />ओ परमेशर, राजे खे आपणे न्याय रे नियम बता,</para>
  <para style="q" vid="PSA 72:1">राजे रे पाऊए खे आपणा तार्मिकता देई दे!<verse eid="PSA 72:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 72:2" />ताकि से तेरी प्रजा रा न्याय तार्मिकता साथे</para>
  <para style="q" vid="PSA 72:2">ओर तेरे दु:खी लोका रा न्याय बिना पक्षपातो ते करो।<note caller="+" style="f"><char style="fr" closed="false">72:2 </char><char style="ft" closed="false">मत्ती 25:31-34, प्रेरित 17:31, रोमी 14:10, 2 कुरिन्थ 5:10</char></note><verse eid="PSA 72:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 72:3" />पाह्ड़ ओर पाह्ड़िया ते प्रजा रे लोका खे तर्मो रे शान्ति मिलणी।<verse eid="PSA 72:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 72:4" />तेस राजे प्रजा रे दु:खी लोका रा न्याय करना</para>
  <para style="q" vid="PSA 72:4">ओर गरीब लोक बचाणे ओर अन्देर करने वाल़े चूर करने।<note caller="+" style="f"><char style="fr" closed="false">72:4 </char><char style="ft" closed="false">यशायाह 11:4</char></note><verse eid="PSA 72:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 72:5" />जदुए तक सूरज ओर चाँद बणे रे रणे,</para>
  <para style="q" vid="PSA 72:5">तदुए तक पीढ़िया-पीढ़िया रे तेरेया लोका तेरा डर मानदे रणा।<verse eid="PSA 72:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 72:6" />राजा डोरूआ दे बर्खा जेड़ा आशीषा री बजा ओ,</para>
  <para style="q" vid="PSA 72:6">जमीना दे पड़ने वाल़ी बर्खा जेड़ा ओ जो जमीना खे सिंजोई।<verse eid="PSA 72:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 72:7" />म्हारे राजे रे दिना रे तार्मिक माणूं फल़णे-फूलणे</para>
  <para style="q" vid="PSA 72:7">ओर जदुए तक चाँद बणेया रा रणा तदुए तक बऊत शान्ति रणी।<verse eid="PSA 72:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 72:8" />तेसरा राज्य एकी समुद्रो ते लई कि दूजे समुद्रो तक</para>
  <para style="q" vid="PSA 72:8">ओर फरात नदिया ते लई की तरतिया रे दूजे कनारे तक ऊणा।<verse eid="PSA 72:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 72:9" />सुनसाण जगा रे रणे वाल़े लोक तेस सामणे जानूआ रे पारे चुकणे</para>
  <para style="q" vid="PSA 72:9">ओर तेसरे दुश्मणा माट्टी चाटणी।<verse eid="PSA 72:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 72:10" />तर्शीश ओर टापूआ-टापूआ रे राजेया पेंट ल्याऊणी,</para>
  <para style="q" vid="PSA 72:10">शेबा ओर सबा दुँईं जगा रे राजेया तोफे पऊँचाणे।<verse eid="PSA 72:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 72:11" />सबी राजेया तेसगे माथा टेकणा,</para>
  <para style="q" vid="PSA 72:11">देशो-देशो रे लोका तेरी सेवा करनी।<note caller="+" style="f"><char style="fr" closed="false">72:11 </char><char style="ft" closed="false">प्रकाशित 21:26, मत्ती 2:11</char></note><verse eid="PSA 72:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 72:12" />कऊँकि राजे दुहाई देणे वाल़े गरीब लोक</para>
  <para style="q" vid="PSA 72:12">ओर दु:खी ओर बिना साअरे माणूं बचाणे।<verse eid="PSA 72:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 72:13" />तेस कंगाल़ ओर गरीबो पाँदे तरस खाणी</para>
  <para style="q" vid="PSA 72:13">ओर गरीबा री जिन्दगी बचाणी।<verse eid="PSA 72:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 72:14" />तेस तिना रे प्राण अन्देर ओर उपद्रव करने वाल़ेया ते छुड़ाई लणे</para>
  <para style="q" vid="PSA 72:14">ओर तिना रा जीवन तेसरी नजरा रे कीमती ए।<note caller="+" style="f"><char style="fr" closed="false">72:14 </char><char style="ft" closed="false">तीतुस 2:14</char></note><verse eid="PSA 72:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 72:15" />से तो जिऊँदा रणा ओर शेबा रे सूईने बीचा ते तेसखे देणा।</para>
  <para style="q" vid="PSA 72:15">लोका तेसरिया तँईं हर रोज प्रार्थना करनी</para>
  <para style="q" vid="PSA 72:15">ओर पूरा दिन तेसरिया तँईं आशीष मांगणी।<verse eid="PSA 72:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 72:16" />देशो रे बऊत सारा नज्ज ऊणा</para>
  <para style="q" vid="PSA 72:16">ओर पाह्ड़ा रिया चूँडिया पाँदे फसला रे डोरू लईराणे।</para>
  <para style="q" vid="PSA 72:16">जेतेरे सिल्ले लबानोनो रे देवदारा रे डाल़ा जेड़े</para>
  <para style="q" vid="PSA 72:16">ओर शईरो रे रणे वाल़े लोक काओ जेड़े लईराणे।<verse eid="PSA 72:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 72:17" />राजे रा नाओं सदा-सर्वदा बणेया रा रणा;</para>
  <para style="q" vid="PSA 72:17">जदुए तक सूरज बणेया रा रणा, तदुए तक तेसरे वंशो रे लोका राज करना</para>
  <para style="q" vid="PSA 72:17">ओर लोका आपू खे तेसरी बजा ते तन्य मानणा।</para>
  <para style="q" vid="PSA 72:17">सारे देशो रे लोका तेसखे तन्य बोलणा।<verse eid="PSA 72:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 72:18" />इस्राएलो रा प्रभु परमेशर तन्य ए;</para>
  <para style="q" vid="PSA 72:18">तिने ई अचम्बे रे काम कित्ते।<note caller="+" style="f"><char style="fr" closed="false">72:18 </char><char style="ft" closed="false">पजन 136:4</char></note><verse eid="PSA 72:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 72:19" />राजे रा महिमा ते परेया रा नाओं सदा तन्य रणा</para>
  <para style="q" vid="PSA 72:19">ओर सारी तरती तेसरी महिमा साथे परी जाणी। आमीन् फेर आमीन्।<verse eid="PSA 72:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 72:20" />यिशै रे पाऊ दाऊदो री प्रार्थना खत्म ऊई गी।<verse eid="PSA 72:20" /></para>
  <chapter eid="PSA 72" />
  <chapter number="73" style="c" sid="PSA 73" />
  <para style="ms">तीजा इस्सा</para>
  <para style="mr">
    <ref loc="PSA 73-89">पजन 73-89</ref></para>
  <para style="s">परमेशरो रा न्याय</para>
  <para style="d">आसापो रा पजन</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 73:1" />परमेशर सच्चो खे ई इस्राएलो रे लोका रिया तँईं पला ए, तिना लोका रिया तँईं जो ईमानदारिया ते तेसरी सेवा करना चाओए।<verse eid="PSA 73:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 73:2" />पर मेरा परोसा लगभग खत्म ई ऊईगा था, मैं परोसा बी लगभग खोई दित्तेया था,</para>
  <para style="q" vid="PSA 73:2">मेरे पैर खड़ीसणे ई वाल़े थे।<verse eid="PSA 73:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 73:3" />जेबे आऊँ दुष्ट लोका रा कल्याण देखूँ था,</para>
  <para style="q" vid="PSA 73:3">तेबे आऊँ तिना कमण्डी लोका रे बारे दे ईर्ष्या करुँ था।<verse eid="PSA 73:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 73:4" />कऊँकि तिना लोका खे कोई बी पीड़ नि ऊँदी।</para>
  <para style="q" vid="PSA 73:4">सेयो हमेशा मजबूत ओर ठीक रओए।<verse eid="PSA 73:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 73:5" />तिना खे ओरी माणूंआ जेड़ा कष्ट नि ऊँदा</para>
  <para style="q" vid="PSA 73:5">ओर ओरी माणूंआ जेड़ी तिना पाँदे बिपदा नि पड़दी।<verse eid="PSA 73:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 73:6" />ओर इजी बजा ते तिने कमण्ड आरो जेड़ा</para>
  <para style="q" vid="PSA 73:6">ओर ईंसा खे चोगे रे जेड़ा पईनोए;<verse eid="PSA 73:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 73:7" />तिना रिया लाल़ची आखी तिना खे पापो रिया तरफा खे लई जाओईया।</para>
  <para style="q" vid="PSA 73:7">तिना रा मन बुरेया कामा रे बारे दे सोचोआ।<verse eid="PSA 73:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 73:8" />सेयो तार्मिक माणूंए रा मजाक ऊड़ाओए</para>
  <para style="q" vid="PSA 73:8">ओर तिना साथे दुष्टता रिया गल्ला बोलोए।</para>
  <para style="q" vid="PSA 73:8">सेयो बडिया-बडिया गल्ला मारोए।<verse eid="PSA 73:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 73:9" />सेयो इतणे कमण्डी ए कि सेयो स्वर्गो रे बैठे रे परमेशरो खे बुरा बोलोए</para>
  <para style="q" vid="PSA 73:9">ओर दूजेया खे सेयो उक्कम देओए!<verse eid="PSA 73:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 73:10" />इजी रिया तँईं परमेशरो रे लोक बुरे माणूंआ गे आई की तिना री तारीफ करोए</para>
  <para style="q" vid="PSA 73:10">ओर तिना दे केसी बी गल्ला री कमी नि पाँदे।<verse eid="PSA 73:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 73:11" />तेबे दुष्ट लोक बोलोए, “परमेशर किंयाँ जाणोआ?</para>
  <para style="q" vid="PSA 73:11">क्या परमपरदानो खे कुछ ज्ञान ए?”<verse eid="PSA 73:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 73:12" />देखो, यो तो दुष्ट लोक ए;</para>
  <para style="q" vid="PSA 73:12">तेबे बी सानिया ते पैसा कट्ठा करोए।<verse eid="PSA 73:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 73:13" />मैं बेकारो रेई आपणा दिल शुद्ध कित्तेया</para>
  <para style="q" vid="PSA 73:13">ओर आपणे आथ बिना दोषो रे तोई राखे;<verse eid="PSA 73:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 73:14" />कऊँकि आऊँ पूरा दिन मार खांदा आई रा</para>
  <para style="q" vid="PSA 73:14">ओर रोज प्यागा मेरी ताड़ना ऊँदी आई री।<verse eid="PSA 73:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 73:15" />जे आऊँ बी एड़िया दुष्ट गल्ला करदा,</para>
  <para style="q" vid="PSA 73:15">से मेरा तेरिया प्रजा साथे तोखा देणा ऊँदा।<verse eid="PSA 73:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 73:16" />जेबे आऊँ सोचणे लगेया कि ये आऊँ किंयाँ समजूँ,</para>
  <para style="q" vid="PSA 73:16">तो ये मेरी नजरा रे बऊत जादा कठण काम था,<verse eid="PSA 73:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 73:17" />पर जेबे आँऊ परमेशरो रे मन्दरो दे गया,</para>
  <para style="q" vid="PSA 73:17">तेबे मैं दुष्ट माणूंआ रा अन्त समजी ला।<verse eid="PSA 73:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 73:18" />पक्का तूँ तिना खे खड़ीसणे वाल़ी जगा रे राखेया</para>
  <para style="q" vid="PSA 73:18">ओर रूड़ाई की सत्यानाश करी देआ।<verse eid="PSA 73:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 73:19" />सेयो थोड़ी जिया देरा रे किंयाँ ऊजड़ी गे!</para>
  <para style="q" vid="PSA 73:19">सेयो डरदे-डरदे पूरिया तरअ ते नाश ऊईगे।<verse eid="PSA 73:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 73:20" />ओ परमेशर, सेयो माणूं एड़े ऊणे जेड़े कोई सुफना, जेते खे आसे जागदे ई पूली जाऊँए।</para>
  <para style="q" vid="PSA 73:20">तिंयाँ ई तां जेबे उठणा, तेबे सेयो राची जाणे।<verse eid="PSA 73:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PSA 73:21" />मेरा मन तो कड़ुआ ऊईगा,</para>
  <para style="q" vid="PSA 73:21">मेरे दिलो रे बऊत ई तकलीफ थी।<verse eid="PSA 73:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="PSA 73:22" />आऊँ तो मूर्ख ओर नासमज था,</para>
  <para style="q" vid="PSA 73:22">आऊँ तां सामणे रई की बी डांगरो जेड़ा बणीगा था।<verse eid="PSA 73:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="PSA 73:23" />तेबे बी आऊँ लगातार तां ई साथे था;</para>
  <para style="q" vid="PSA 73:23">तैं मेरा दाँणा आथ पकड़ी की राखेया।<verse eid="PSA 73:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="PSA 73:24" />तूँ आपणी सलाई ते माखे सई बाट दखाएया</para>
  <para style="q" vid="PSA 73:24">ओर जिन्दगिया रे आखरी रे तां आँऊ आपणी महिमा रे ग्रईण करना।<verse eid="PSA 73:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="PSA 73:25" />स्वर्गो रे मेरा ओर कोई नि ए;</para>
  <para style="q" vid="PSA 73:25">तां साथे तरतिया पाँदे रंदे ऊए आऊँ ओर कुछ नि चांदा।<verse eid="PSA 73:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="PSA 73:26" />मेरा शरीर ओर दिल चाए दोनो आरी जाओ;</para>
  <para style="q" vid="PSA 73:26">पर परमेशर, तूँ सदा मेरे दिलो री चट्टान ओर इस्सा ए।<verse eid="PSA 73:26" /></para>
  <para style="q">
    <verse number="27" style="v" sid="PSA 73:27" />जो तांते दूर रओए, सेयो तो नाश ऊणे;</para>
  <para style="q" vid="PSA 73:27">जो कोई तेरे खलाफ व्याभिचारो जेड़ा तोखा करोआ, तेसरा तूँ नाश करी देया।<verse eid="PSA 73:27" /></para>
  <para style="q">
    <verse number="28" style="v" sid="PSA 73:28" />पर परमेशरो रे नेड़े रणा, येई माखे पला ए;</para>
  <para style="q" vid="PSA 73:28">मैं प्रभु परमेशर आपणी शरण लणे री जगा मानी राखी;</para>
  <para style="q" vid="PSA 73:28">प्रभु, मां तेरे सारे कामा रा बखाण करना।<verse eid="PSA 73:28" /></para>
  <chapter eid="PSA 73" />
  <chapter number="74" style="c" sid="PSA 74" />
  <para style="s">देशो रे बचाव रिया तँईं प्रार्थना</para>
  <para style="d">आसापो रा मश्कील</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 74:1" />ओ परमेशर, तैं आसे सदा खे कऊँ छाडी ते?</para>
  <para style="q" vid="PSA 74:1">कऊँ तेरा गुस्सा तेरिया पेडा रे खलाफ उठणे लगी रा?<verse eid="PSA 74:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 74:2" />याद कर आपणी मण्डल़िया खे, जो तैं पुराणे बखतो ते खरीदी राखी थी</para>
  <para style="q" vid="PSA 74:2">ओर जो तैं आपणा निज पाअगो रा गोत्र बनाणे रिया तँईं छुड़ाई ला था।</para>
  <para style="q" vid="PSA 74:2">याद कर सिय्योन पाह्ड़ो खे, जेती तूँ रये आ!<note caller="+" style="f"><char style="fr" closed="false">74:2 </char><char style="ft" closed="false">बिध. 32:9, यिर्मयाह 10:16, प्रेरित 20:28</char></note><verse eid="PSA 74:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 74:3" />आओ ओर म्हारिया ईमारता खे देखो! तेरे दुश्मणे सेयो पुरिया तरआ ते नाश करी तिया ए।</para>
  <para style="q" vid="PSA 74:3">तिने तेरे मन्दरो दे जो कुछ बी ए, सब कुछ नाश करिता रा ए।<verse eid="PSA 74:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 74:4" />म्हारे दुश्मण तेरे मन्दरो ते शेरो रिया तरआ गरजोए,</para>
  <para style="q" vid="PSA 74:4">तेती तिने आपणे ई चण्डे खड़े करी राखे कि सेयो जीती गे।<verse eid="PSA 74:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 74:5" />सेयो क्वाड़िया साथे मन्दरो रे टुकड़े-टुकड़े करो थे,</para>
  <para style="q" vid="PSA 74:5">जिंयाँ डाल़ बाडणे वाल़े लोक!<verse eid="PSA 74:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 74:6" />तिने मन्दरो री नक्काशी क्वाड़िया ओर थोड़ूआ साथे फाड़ी ती री ए।<verse eid="PSA 74:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 74:7" />तिने तेरे रणे रिया जगा दे आग लगाईती</para>
  <para style="q" vid="PSA 74:7">ओर तेरे नाओं री रणे री जगा टाल़ी की अशुद्ध करिती री।<verse eid="PSA 74:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 74:8" />तिने आपणे मनो रे बोलेया, “आसा यो एकदम दबाई देणे।”</para>
  <para style="q" vid="PSA 74:8">तिने एते देशो रे परमेशरो री सारिया आराधना करने रिया जगा फूकी तिया।<verse eid="PSA 74:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 74:9" />आसा खे एबे परमेशरो रा कोई बी नौखा चिह्न नि दिशदा;</para>
  <para style="q" vid="PSA 74:9">एबे कोई नबी नि रया, आसा बीचे कोई नि जाणदा कि म्हारी एड़ी दशा कदुओ तक रणी।<verse eid="PSA 74:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 74:10" />ओ परमेशर, बरोदी कदुओ तक आसा री निंदा करदा रणा?</para>
  <para style="q" vid="PSA 74:10">क्या दुश्मण तेरे नाओं री निंदा सदा करदा रणा?<verse eid="PSA 74:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 74:11" />तैं आपणा दाँणा आथ कऊँ रोकी राखेया?</para>
  <para style="q" vid="PSA 74:11">तेस आपणे दाँणे आथो खे पँजरो ते निकयाल़ी की तिना रा अंत करी दे।<verse eid="PSA 74:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 74:12" />परमेशर तो शुरूए तेई आसा रा राजा ए,</para>
  <para style="q" vid="PSA 74:12">से तरतिया पाँदे उद्धारो रे काम करदा आई रा।<verse eid="PSA 74:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 74:13" />तैं तो आपणी शक्तिया साथे समुद्रो रे दो इस्से करीते;</para>
  <para style="q" vid="PSA 74:13">तैं तो पाणिए बीचे अजगरो रे टुकड़े-टुकड़े करीते।<verse eid="PSA 74:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 74:14" />तैं तो लिब्यातानो<note caller="+" style="f"><char style="fr" closed="false">74:14 </char><char style="fq" closed="false">लिब्यातानो </char><char style="ft" closed="false">पुराणा दानव</char></note> रे सिरो रे टुकड़े-टुकड़े करी की</para>
  <para style="q" vid="PSA 74:14">जंगल़ी जानवरा खे खुल़ाई ते।<verse eid="PSA 74:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 74:15" />तैं चट्टान तोड़ी की साफ पाणिए रे चरने ओर सूबल़ा नकाल़िया,</para>
  <para style="q" vid="PSA 74:15">तैं तो बारामासी बह्णे वाल़िया नदिया सुखाई तिया।<verse eid="PSA 74:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 74:16" />तेरा ई दिन ए ओर रात बी तेरी ए;</para>
  <para style="q" vid="PSA 74:16">सूरज ओर चाँद तैंई ठराई राखे।<verse eid="PSA 74:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 74:17" />तैं तो तरतिया रे सारे बन्ने ठराए,</para>
  <para style="q" vid="PSA 74:17">तऊँदी ओर ईयूँद दोनो तैं बणाई राखे<verse eid="PSA 74:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 74:18" />ओ प्रभु, याद कर कि दुश्मणे तेरी केड़ी निंदा करी राखी</para>
  <para style="q" vid="PSA 74:18">ओर मूर्ख लोके तेरे नाओं री बेज्जती करी राखी।<verse eid="PSA 74:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 74:19" />आपणी कूगिया रे प्राण जंगल़ी जानवरा रे वशो रे नि कर,</para>
  <para style="q" vid="PSA 74:19">आपणे दु:खी लोका रिया जिन्दगिया खे सदा खे नि पूला।<verse eid="PSA 74:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 74:20" />आपणी तेसा वाचा खे याद राख जो आसा साथे करी राखी ए,</para>
  <para style="q" vid="PSA 74:20">कऊँकि देशो दे न्हेरा ओर अत्याचार ऊणे लगी रा!<verse eid="PSA 74:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PSA 74:21" />दबे रे लोका खे बेज्जत ऊई की वापस नि आऊणा पड़ो;</para>
  <para style="q" vid="PSA 74:21">दु:खी ओर गरीब लोक तेरे नाओं री स्तुति करो।<note caller="+" style="f"><char style="fr" closed="false">74:21 </char><char style="ft" closed="false">पजन 103:6</char></note><verse eid="PSA 74:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="PSA 74:22" />ओ परमेशर उठ, आपणा मकद्दमा आपू ई लड़;</para>
  <para style="q" vid="PSA 74:22">मूर्ख लोका ते जो तेरी निंदा लगातार ऊँदी रओई, तिजी खे याद कर।<verse eid="PSA 74:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="PSA 74:23" />आपणे बैरिया रा बड़ा बोल नि पूल,</para>
  <para style="q" vid="PSA 74:23">तेरे बरोदिया रा आल्ला-गोल्ला तो लगातार उठदा रओआ।<verse eid="PSA 74:23" /></para>
  <chapter eid="PSA 74" />
  <chapter number="75" style="c" sid="PSA 75" />
  <para style="s">न्याय रिया तँईं परमेशरो रा तन्यवाद</para>
  <para style="d">बजाणे वाल़े परदानो रिया तँईं : अलतशहेत<note caller="+" style="f"><char style="fr" closed="false">75:0 </char><char style="fq" closed="false">अलतशहेत </char><char style="ft" closed="false">अलतशहेतो रा मतलब नाश नि करो</char></note> रागो दे आसापो रा पजन, गीत।</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 75:1" />ओ परमेशर, आसे तेरा तन्यवाद करूँए,</para>
  <para style="q" vid="PSA 75:1">आसा तेरिया महानता रे बारे दे,</para>
  <para style="q" vid="PSA 75:1">ओर तैं केड़े-केड़े नौखे काम करी राखे,</para>
  <para style="q" vid="PSA 75:1">सेयो बी सबी खे बताणे।<verse eid="PSA 75:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 75:2" />परमेशर बोलोआ, “जेबे ठीक बखत आऊणा</para>
  <para style="q" vid="PSA 75:2">तेबे मां आपू ई ठीक-ठीक न्याय करना।”<verse eid="PSA 75:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 75:3" />जेबे तरती तिदे सब रणे वाल़ेया समेत ईलोई,</para>
  <para style="q" vid="PSA 75:3">तेबे आऊँ तिजी रे खम्बे स्थिर करूँआ। सेला<verse eid="PSA 75:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 75:4" />आऊँ कमण्डी लोका खे बोलूँआ कि कमण्ड नि करो,</para>
  <para style="q" vid="PSA 75:4">ओर दुष्ट लोका खे बोलूँआ कि आपणियां तागती पाँदे कमण्ड नि करो।<verse eid="PSA 75:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 75:5" />परमेशरो रे खलाफ कमण्ड नि करो।</para>
  <para style="q" vid="PSA 75:5">एड़े कमण्डो ते मत बोलो।<verse eid="PSA 75:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 75:6" />कऊँकि बढ़ोतरी ना तो पूर्वो ते,</para>
  <para style="q" vid="PSA 75:6">ना पच्छमा ते ओर ना ई सुनसाण जगा ते आओई;<verse eid="PSA 75:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 75:7" />पर परमेशर ई न्याय करने वाल़ा ए,</para>
  <para style="q" vid="PSA 75:7">से एकी खे थाले करोआ ओर दूजे खे बढ़ाओआ।<verse eid="PSA 75:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 75:8" />यहोवे रे आथो रे एक कटोरा ए,</para>
  <para style="q" vid="PSA 75:8">तिदे तेसरे गुस्से री प्रबल दाख-शराबो ते परी री ए।</para>
  <para style="q" vid="PSA 75:8">से तिजी खे लटी देओआ,</para>
  <para style="q" vid="PSA 75:8">ओर सारे दुष्ट तेस पीओ ए; सेयो तेस आखरी बूँदा तक पीओ ए।<note caller="+" style="f"><char style="fr" closed="false">75:8 </char><char style="ft" closed="false">यिर्मयाह 25:15, प्रकाशित 14:10, प्रकाशित 16:19</char></note><verse eid="PSA 75:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 75:9" />पर मां तो सदा प्रचार करदे रणा,</para>
  <para style="q" vid="PSA 75:9">मां याकूबो रे परमेशरो रा पजन गाणा।<verse eid="PSA 75:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 75:10" />परमेशरो सारे दुष्टा रे निकल़े रे सींग बाडी देणे,</para>
  <para style="q" vid="PSA 75:10">पर तर्मिया रे सींग ऊच्चे कित्ते जाणे।<verse eid="PSA 75:10" /></para>
  <chapter eid="PSA 75" />
  <chapter number="76" style="c" sid="PSA 76" />
  <para style="s">जीत दलाणे वाल़ा परमेशर</para>
  <para style="d">बजाणे वाल़े परदानो रिया तँईं : तारा वाल़े बाजे साथे, आसापो रा पजन, गीत।</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 76:1" />परमेशरे यहूदा प्रदेशो रे आपू खे प्रकट कित्तेया;</para>
  <para style="q" vid="PSA 76:1">इस्राएलो रे तेसरा नाओं महान ए।<verse eid="PSA 76:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 76:2" />ओर तेसरा कअर शालेमो दे ए,</para>
  <para style="q" vid="PSA 76:2">ओर सिय्योन पाह्ड़ो पाँदे रओआ।<note caller="+" style="f"><char style="fr" closed="false">76:2 </char><char style="ft" closed="false">यरूशलेम; शलेम पुराणा, पूर्व-इस्राएली, जेरूशलमो रा नाओं ए, देखो उत्प. ति 14.18.</char></note><verse eid="PSA 76:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 76:3" />तेती तिने तीर, ढाल, तलवार</para>
  <para style="q" vid="PSA 76:3">ओर युद्धो रे अथियार तोड़ी की नाश करीते। सेला<verse eid="PSA 76:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 76:4" />ओ परमेशर, तूँ कितणा गौरवशाली ए! तूँ कितणा प्रतापी ए,</para>
  <para style="q" vid="PSA 76:4">जेबे तूँ पाह्ड़ो ते वापस आओआ, जेती तैं आपणे दुश्मण अराई राखे थे।<verse eid="PSA 76:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 76:5" />मजबूत सैनिक लूटी गे ओर बड़ी पारी नींजा रे पड़ी रे;</para>
  <para style="q" vid="PSA 76:5">ओर शूरवीरा बीचा ते केसी रा आथ नि चलेया।<verse eid="PSA 76:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 76:6" />ओ याकूबो रे परमेशर, तेरे थिड़कणे ते,</para>
  <para style="q" vid="PSA 76:6">कोड़े रथो समेत मरी की खत्म ऊईगे।<verse eid="PSA 76:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 76:7" />बस तूँई डरो जोगा ए ओर जेबे तेरा गुस्सा पड़कणे लगोआ,</para>
  <para style="q" vid="PSA 76:7">तेबे तां सामणे कोई खड़ा रई नि सकदा?<verse eid="PSA 76:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 76:8" />तैं स्वर्गो ते न्याय रा फैंसला सुणाया;</para>
  <para style="q" vid="PSA 76:8">तरती तेस बखते सुणी की डरी गी, ओर चुप ऊई गी,<verse eid="PSA 76:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 76:9" />जेबे यहोवा न्याय करने खे खड़ा ऊआ,</para>
  <para style="q" vid="PSA 76:9">तैं तरतिया दे सेयो सब बचाए जो नम्र थे। सेला<verse eid="PSA 76:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 76:10" />माणूंआ रे गुस्से ते तेरी जादा तारीफ ओई;</para>
  <para style="q" vid="PSA 76:10">जो युद्धो ते बची रणे, तिना तेरे त्यार मनाणे।<verse eid="PSA 76:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 76:11" />आपणे प्रभु परमेशरो री मान्नता मानो, ओर पूरी बी करो;</para>
  <para style="q" vid="PSA 76:11">यहोवे रे चऊँ कनारे रणे वाल़े लोक तेसखे पेंट चढ़ाओ, प्रभु डरो जोगा ए।<verse eid="PSA 76:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 76:12" />परमेशरो परदाना रा कमण्ड मटयाई देणा;</para>
  <para style="q" vid="PSA 76:12">से तरतिया रे राजेया खे डरो जोगा लगोआ।<verse eid="PSA 76:12" /></para>
  <chapter eid="PSA 76" />
  <chapter number="77" style="c" sid="PSA 77" />
  <para style="s">मुसीबता रे बखते ईम्मत देणी</para>
  <para style="d">बजाणे वाल़े रे परदानो रिया तँईं : यदूतून रागो पाँदे, आसापो रा पजन।</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 77:1" />मां परमेशरो री दुहाई ऊच्ची आवाज करी की देणी,</para>
  <para style="q" vid="PSA 77:1">मां परमेशरो री दुहाई देणी ओर तेस मेरिया तरफा खे त्यान देणा।<verse eid="PSA 77:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 77:2" />जेबे आऊँ मुसीबता दे पड़ेया; तेबे आऊँ यहोवे गे जाईकी प्रार्थना करूँआ।</para>
  <para style="q" vid="PSA 77:2">पूरी रात आऊँ प्रार्थना करदे ऊए आपणे आथ फैलाई की राखूँआ, पर माखे शान्ति नि मिली।<verse eid="PSA 77:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 77:3" />आऊँ परमेशरो खे याद करी-करी की कणूंआ;</para>
  <para style="q" vid="PSA 77:3">त्यान करदे-करदे मेरी आत्मा थकी जाओई। सेला<verse eid="PSA 77:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 77:4" />तूँ माखे नींजा रा टमका लगणे नि देंदा;</para>
  <para style="q" vid="PSA 77:4">आऊँ एड़ा कबराईगा रा कि मेरे मुंए ते शब्द नि निकल़दा।<verse eid="PSA 77:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 77:5" />आँऊ पुराणे बखतो रे तिना दिना रे बारे दे सोचूँआ</para>
  <para style="q" vid="PSA 77:5">ओर पिछले जुगो रे तिना साला रे बारे दे।<verse eid="PSA 77:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 77:6" />आऊँ राती आपणेया गाणेया खे याद करूँआ</para>
  <para style="q" vid="PSA 77:6">ओर आपणे दिलो रे त्यान करूँआ, ओर मनो रे ठीक-टंगो रे बिचार करूँआ:<verse eid="PSA 77:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 77:7" />“क्या प्रभुए जुगो-जुगो खे आँऊ छाडी देणा</para>
  <para style="q" vid="PSA 77:7">ओर फेर कदी तेस मां पाँदे दया नि करनी?<verse eid="PSA 77:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 77:8" />क्या तेसरी करूणा सदा खे चली जाणी?</para>
  <para style="q" vid="PSA 77:8">क्या तेसरा वचन पीढ़िया-पीढ़िया खे निष्फल ऊई जाणा?<verse eid="PSA 77:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 77:9" />क्या परमेशर दया करना पूली गा?</para>
  <para style="q" vid="PSA 77:9">क्या तिने आपणे गुस्से रे आई की दया करनी बन्द करिती री?”<verse eid="PSA 77:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 77:10" />मैं बोलेया, “येई तो मेरा दु:ख ए कि परमपरदानो रा दाँणा आथ बदली गा रा ए।”<verse eid="PSA 77:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 77:11" />मां यहोवे रे बड़े कामा री चर्चा करनी;</para>
  <para style="q" vid="PSA 77:11">पुराणे बखतो दे जो नौखे काम तैं करी राखे सेयो मां याद राखणे।<verse eid="PSA 77:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 77:12" />मां तेरे सारेया कामा पाँदे त्यान करना</para>
  <para style="q" vid="PSA 77:12">ओर तेरे बड़े नौखे काम सोचणे।<verse eid="PSA 77:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 77:13" />तूँ ओ परमेशर जो बी काम करेया; तेरा से काम पवित्र ओआ,</para>
  <para style="q" vid="PSA 77:13">तूँ सबी ते बड़ा ओर महान ए, तेरा मुकाबला देवी-देवता नि करी सकदे!<verse eid="PSA 77:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 77:14" />अचम्बे रे काम करने वाल़ा परमेशर तूँई ए,</para>
  <para style="q" vid="PSA 77:14">तैं देशो-देशो रे लोका पाँदे आपणी सामर्थ प्रगट करी राखी।<verse eid="PSA 77:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 77:15" />तैं आपणियां तागती साथे आपणी प्रजा याकूब</para>
  <para style="q" vid="PSA 77:15">ओर यूसुफो रे वंश छुड़ाई ले रे। सेला<verse eid="PSA 77:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 77:16" />ओ परमेशर, समुद्रे तूँ देखेया, जेबे समुद्रे तूँ देखेया तेबे से डरीगा;</para>
  <para style="q" vid="PSA 77:16">डूगा समुद्र बी थरथराई गा।<verse eid="PSA 77:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 77:17" />बादल़ा ते थाले पाणी आओआ ओर साथे गिड़ने री आवाज,</para>
  <para style="q" vid="PSA 77:17">ओर सारे सर्गो दे बिजल़ी चमकणे लगी।<verse eid="PSA 77:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 77:18" />तूफानो बीचे तेरे गरजणे री आवाज सुणी;</para>
  <para style="q" vid="PSA 77:18">दुनिया बिजल़िया साथे चमकी गी; तरती थरथराई ओर ईल्ली गी।<verse eid="PSA 77:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 77:19" />तेरी बाट समुद्रो रे ए ओर तेरी बाट डूगे पाणिए बिछिए ऊई की जाओई;</para>
  <para style="q" vid="PSA 77:19">ओर तेरे पैरा रे नशाण पता नि लगदे।<verse eid="PSA 77:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 77:20" />तैं मूसा ओर हारूणो रे जरिए</para>
  <para style="q" vid="PSA 77:20">आपणी प्रजा री अगुवाई पेडा जेड़ी कित्ती।<verse eid="PSA 77:20" /></para>
  <chapter eid="PSA 77" />
  <chapter number="78" style="c" sid="PSA 78" />
  <para style="s">परमेशर ओर तेसरे लोक</para>
  <para style="d">आसापो रा मश्कील</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 78:1" />ओ मेरे लोको, मेरी शिक्षा सुणो;</para>
  <para style="q" vid="PSA 78:1">मेरे मुंए ते निकल़े रे वचना रिया तरफा खे त्यान देओ!<verse eid="PSA 78:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 78:2" />मां तुसा खे बुद्धिया रिया गल्ला बताणिया,</para>
  <para style="q" vid="PSA 78:2">साथे मां पुराणे बखतो रिया गुप्त गल्ला रा पेत बताणा।<note caller="+" style="f"><char style="fr" closed="false">78:2 </char><char style="ft" closed="false">मत्ती 13:35</char></note><verse eid="PSA 78:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 78:3" />जो गल्ला आसे सुणिया, ओर समजिया</para>
  <para style="q" vid="PSA 78:3">ओर म्हारे बुजुर्गे आसा गे बताईया।<verse eid="PSA 78:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 78:4" />प्रभुए रा गुणगाण ओर तेसरी सामर्थ ओर अचम्बे रे काम जो तिने कित्ते,</para>
  <para style="q" vid="PSA 78:4">सेयो आसा तिना री ल्वादा ते गुप्त नि राखणे</para>
  <para style="q" vid="PSA 78:4">बल्कि आऊणे वाल़िया पीढ़िया रे लोका गे तिजी रा बखाण करना।<note caller="+" style="f"><char style="fr" closed="false">78:4 </char><char style="ft" closed="false">बिध. 4:9, यहोशू 4:6,7, इफिसि 6:4</char></note><verse eid="PSA 78:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 78:5" />प्रभुए याकूबो गे एक चतौणी ठराई ओर इस्राएलो रे एक बिधान ठराई,</para>
  <para style="q" vid="PSA 78:5">जेतेरे बारे दे तिने आसा रे पितरा खे आज्ञा दित्ती</para>
  <para style="q" vid="PSA 78:5">कि सेयो आपणी ल्वादा खे इना गल्ला खे सिखाओ;<verse eid="PSA 78:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 78:6" />ताकि आऊणे वाल़ी पीढ़ी तिना खे सीखो,</para>
  <para style="q" vid="PSA 78:6">ओर बदले दे आपणे बच्चेया खे सिखाओ।<verse eid="PSA 78:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 78:7" />जेते कि सेयो यहोवे पाँदे परोसा राखो</para>
  <para style="q" vid="PSA 78:7">ओर यहोवे रे बड़े-बड़े कामो खे पूली नि जाओ</para>
  <para style="q" vid="PSA 78:7">बल्कि तेसरी आज्ञा खे मानदे रओ;<verse eid="PSA 78:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 78:8" />ओर सेयो आपणे पितरा जेड़े नि ऊणे,</para>
  <para style="q" vid="PSA 78:8">सेयो बगावत ओर आज्ञा खे नि मानणे वाल़े लोक ए,</para>
  <para style="q" vid="PSA 78:8">जिना रा परमेशरो पाँदे परोसा कदी पक्का नि था</para>
  <para style="q" vid="PSA 78:8">ओर जो तेसरे प्रति वफादार नि रये।<note caller="+" style="f"><char style="fr" closed="false">78:8 </char><char style="ft" closed="false">2 राजा 17:14,15</char></note><verse eid="PSA 78:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 78:9" />एप्रैमो रे वंशो रे लोक तो शस्त्रधारी ओर धनुर्धारी ऊई की बी,</para>
  <para style="q" vid="PSA 78:9">युद्धो रे बखते नठीगे थे।<verse eid="PSA 78:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 78:10" />तिने परमेशरो री वाचा पूरी नि कित्ती</para>
  <para style="q" vid="PSA 78:10">ओर तेसरे बिधि-बिधानो पाँदे चलणे ते मुकरीगे।<verse eid="PSA 78:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 78:11" />तिने तेसरे बड़े-बड़े काम ओर जो अचम्बे रे काम</para>
  <para style="q" vid="PSA 78:11">तिने तिना सामणे कित्ते थे, सेयो पुलाई ते।<verse eid="PSA 78:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 78:12" />तिना रे बुजुर्गा रे सामणे मिस्र देशो रे सोअनो री जमीना दे</para>
  <para style="q" vid="PSA 78:12">परमेशरे नौखे काम कित्ते थे।<verse eid="PSA 78:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 78:13" />परमेशरे समुद्रो रे दो इस्से करी की सेयो पार टपाईते,</para>
  <para style="q" vid="PSA 78:13">ओर पाणी टेरो जेड़ा एकी जगा खड़ा करिता।<verse eid="PSA 78:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 78:14" />तिने दिनो रे बखते बादल़े की</para>
  <para style="q" vid="PSA 78:14">ओर पूरी रात आगी रे प्रयासे रे जरिए सेयो चलाए।<verse eid="PSA 78:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 78:15" />तिने सुनसाण जगा रे चट्टानी फाड़ी की</para>
  <para style="q" vid="PSA 78:15">मानो डूगिया बांई ते तिना खे मनमाना पाणी, पल़्याया।<note caller="+" style="f"><char style="fr" closed="false">78:15 </char><char style="ft" closed="false">निर्ग. 17:6, गिण 20:11, 1 कुरिन्थ 10:4</char></note><verse eid="PSA 78:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 78:16" />परमेशरे चट्टानी ते बी पाणिए री तारा निकयाल़िया</para>
  <para style="q" vid="PSA 78:16">ओर नदिया जेड़ा पाणी बाह्या।<verse eid="PSA 78:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 78:17" />तेबे बी इब्री लोक फेर परमेशरो रे खलाफ ओर जादा पाप करदे गये</para>
  <para style="q" vid="PSA 78:17">ओर बिना पाणिए रे प्रदेशो रे परमपरदानो रा बरोद करदे रये।<verse eid="PSA 78:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 78:18" />तिने आपणी मर्जिया रे मुताबिक रोटी मांगी की</para>
  <para style="q" vid="PSA 78:18">मन ई मनो रे परमेशरो री परीक्षा कित्ती।<verse eid="PSA 78:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 78:19" />सेयो परमेशरो रे खलाफ ये बोलणे लगे, “क्या परमेशर सुनसाण जगा रे रोटिया रा इन्तजाम करी सकोआ?<verse eid="PSA 78:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 78:20" />तिने चट्टानी पाँदे बाई की पाणी बाह्यी तो दित्तेया</para>
  <para style="q" vid="PSA 78:20">ओर पाणिए रिया तारा उमड़ने लगिया, पर क्या से रोटी बी देई सकोआ?</para>
  <para style="q" vid="PSA 78:20">क्या से आपणी प्रजा रे लोका खे मासो रा इन्तजाम करी सकोआ?”<verse eid="PSA 78:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PSA 78:21" />तिना रिया एड़िया गल्ला सुणी की यहोवे खे बऊत जादा गुस्सा आया,</para>
  <para style="q" vid="PSA 78:21">तिने आपणी प्रजा इस्राएलिया रे खलाफ आग बरसाई<verse eid="PSA 78:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="PSA 78:22" />कऊँकि तिने परमेशरो पाँदे परोसा नि राखेया था</para>
  <para style="q" vid="PSA 78:22">ओर ना ई तेसरे उद्धार करने रिया शक्तिया पाँदे परोसा कित्तेया।<verse eid="PSA 78:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="PSA 78:23" />तेबे बी तिने ऊच्चे सर्गो खे आज्ञा दित्ती</para>
  <para style="q" vid="PSA 78:23">ओर तिने सर्गो रे द्वार खोले;<verse eid="PSA 78:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="PSA 78:24" />ओर तिना खे खाणे रिया तँईं मन्ना बरसाया</para>
  <para style="q" vid="PSA 78:24">ओर परमेशरे तिना खे स्वर्गो रा नज्ज दित्तेया।<note caller="+" style="f"><char style="fr" closed="false">78:24 </char><char style="ft" closed="false">निर्ग. 16:4, यूह. 6:31</char></note><verse eid="PSA 78:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="PSA 78:25" />माणूंए स्वर्गदूता री रोटी खाई;</para>
  <para style="q" vid="PSA 78:25">परमेशरे तिना खे पेट परी की रोटी दित्ती।<verse eid="PSA 78:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="PSA 78:26" />यहोवे पुर्बो री तरफा ते पऊण चलाई</para>
  <para style="q" vid="PSA 78:26">ओर आपणी शक्तिया साथे दक्खणा री पऊण चलाई;<verse eid="PSA 78:26" /></para>
  <para style="q">
    <verse number="27" style="v" sid="PSA 78:27" />ओर तिने तिना पाँदे तूड़ा रे कणा जेड़ा मासो री बरखा कित्ती</para>
  <para style="q" vid="PSA 78:27">ओर समुद्रो रे कनारे बालूए जेड़े अणगिणत पंछी पेजे;<verse eid="PSA 78:27" /></para>
  <para style="q">
    <verse number="28" style="v" sid="PSA 78:28" />ओर तिना री छावणिया बीचे,</para>
  <para style="q" vid="PSA 78:28">तिना रे रणे रिया जगा रे चऊँ कनारे सेटे।<verse eid="PSA 78:28" /></para>
  <para style="q">
    <verse number="29" style="v" sid="PSA 78:29" />ओर सेयो खाई की बऊत रज्जी गे;</para>
  <para style="q" vid="PSA 78:29">ईंयाँ परमेशरे तिना खे तिना री इच्छा रे मुताबिक खाणे खे दित्तेया।<verse eid="PSA 78:29" /></para>
  <para style="q">
    <verse number="30" style="v" sid="PSA 78:30" />एबु तिने आपणी खाणे री इच्छा पुरिया तरअ ते पूरी पनि करी राखी थी</para>
  <para style="q" vid="PSA 78:30">ओर तिना री रोटी तिना रे मुंए रेई थी,<verse eid="PSA 78:30" /></para>
  <para style="q">
    <verse number="31" style="v" sid="PSA 78:31" />कि परमेशरो रा गुस्सा तिना पाँदे पड़केया,</para>
  <para style="q" vid="PSA 78:31">ओर तिने तिना रे अट्टे-कट्टे मर्द काईते ओर इस्राएलो रे जवान बी काईते।<note caller="+" style="f"><char style="fr" closed="false">78:31 </char><char style="ft" closed="false">1 कुरिन्थ 10:5</char></note><verse eid="PSA 78:31" /></para>
  <para style="q">
    <verse number="32" style="v" sid="PSA 78:32" />इतणा ऊणे रे बावजूद बी सेयो बऊत जादा पाप करदे गये;</para>
  <para style="q" vid="PSA 78:32">ओर परमेशरो रे अचम्बे रे कामा पाँदे परोसा नि कित्तेया।<verse eid="PSA 78:32" /></para>
  <para style="q">
    <verse number="33" style="v" sid="PSA 78:33" />इजी खे तिने तिना रे दिन बेकारो री मईणती रे</para>
  <para style="q" vid="PSA 78:33">ओर तिना रे साल कबराई की कटवाए।<verse eid="PSA 78:33" /></para>
  <para style="q">
    <verse number="34" style="v" sid="PSA 78:34" />जेबे परमेशर तिना खे मारने लगो था,</para>
  <para style="q" vid="PSA 78:34">तेबे सेयो तेसखे पूछो थे;</para>
  <para style="q" vid="PSA 78:34">ओर पश्चाताप करी की परमेशरो खे टोल़ो थे।<verse eid="PSA 78:34" /></para>
  <para style="q">
    <verse number="35" style="v" sid="PSA 78:35" />एबे तिना खे याद आओ था कि परमेशर म्हारी चट्टान ए</para>
  <para style="q" vid="PSA 78:35">ओर परमपरदान परमेशर आसा खे छुड़ाणे वाल़ा ए।<verse eid="PSA 78:35" /></para>
  <para style="q">
    <verse number="36" style="v" sid="PSA 78:36" />पर तेबे बी तिने तेसखे तोखा दित्तेया;</para>
  <para style="q" vid="PSA 78:36">तिने तेसगे चूठ बोलेया।<verse eid="PSA 78:36" /></para>
  <para style="q">
    <verse number="37" style="v" sid="PSA 78:37" />कऊँकि तिना रा मन परमेशरो रिया तरफा खे मजबूत नि था;</para>
  <para style="q" vid="PSA 78:37">ना ई सेयो तेसरी वाचा रे बारे दे सच्चे थे।<note caller="+" style="f"><char style="fr" closed="false">78:37 </char><char style="ft" closed="false">प्रेरित 8:21</char></note><verse eid="PSA 78:37" /></para>
  <para style="q">
    <verse number="38" style="v" sid="PSA 78:38" />पर परमेशर दयालु ए, से नाश नि करदा बल्कि से पापो खे टखोआ,</para>
  <para style="q" vid="PSA 78:38">से बार-बार आपणे गुस्से खे शान्त करदा रओआ,</para>
  <para style="q" vid="PSA 78:38">ओर आपणे गुस्से री जल़ना खे पुरिया तरअ ते पड़कणे नि देंदा।<verse eid="PSA 78:38" /></para>
  <para style="q">
    <verse number="39" style="v" sid="PSA 78:39" />तेसखे याद था कि यो तो नाशवान ए, सेयो पऊणी जेड़े ए,</para>
  <para style="q" vid="PSA 78:39">जो चली जाओई ओर वापस नि आऊँदी।<verse eid="PSA 78:39" /></para>
  <para style="q">
    <verse number="40" style="v" sid="PSA 78:40" />कितणी ई बार तिने सुनसाण जगा रे परमेशरो रे खलाफ बगावत कित्ती</para>
  <para style="q" vid="PSA 78:40">ओर तेते सुनसाण जगा दे से उदास कित्तेया।<verse eid="PSA 78:40" /></para>
  <para style="q">
    <verse number="41" style="v" sid="PSA 78:41" />सेयो बार-बार परमेशरो री परीक्षा करो थे</para>
  <para style="q" vid="PSA 78:41">ओर इस्राएलो रे पवित्र परमेशरो खे दु:खी करो थे।<verse eid="PSA 78:41" /></para>
  <para style="q">
    <verse number="42" style="v" sid="PSA 78:42" />तिने ना तो तेसरी शक्ति याद कित्ती,</para>
  <para style="q" vid="PSA 78:42">ना से दिन जेबे परमेशरे सेयो तिना रे बैरिया रे वशो ते छुड़ाए थे;<verse eid="PSA 78:42" /></para>
  <para style="q">
    <verse number="43" style="v" sid="PSA 78:43" />जेबे तिने मिस्र देशो रे आपणे चिह्न दखाए थे</para>
  <para style="q" vid="PSA 78:43">ओर सोअनो रे मैदानो रे अचम्बे रे काम कित्ते थे।<verse eid="PSA 78:43" /></para>
  <para style="q">
    <verse number="44" style="v" sid="PSA 78:44" />परमेशरे मिस्रो रिया नदिया रा पाणी खूनो रे बदली ता</para>
  <para style="q" vid="PSA 78:44">ओर मिस्रो रे रणे वाल़े आपणी नदिया रा पाणी पी नि सके।<note caller="+" style="f"><char style="fr" closed="false">78:44 </char><char style="ft" closed="false">प्रकाशित 16:4</char></note><verse eid="PSA 78:44" /></para>
  <para style="q">
    <verse number="45" style="v" sid="PSA 78:45" />परमेशरे तिना बीचे माखा रे चूण्ड पेजे, जिने सेयो खाए</para>
  <para style="q" vid="PSA 78:45">ओर मिनके बी पेजे, जिने सेयो बऊत सताए।<verse eid="PSA 78:45" /></para>
  <para style="q">
    <verse number="46" style="v" sid="PSA 78:46" />तिने तिना री जमीना री फसल कीड़ेया खे,</para>
  <para style="q" vid="PSA 78:46">ओर तिना री खेतीबाड़ी टिड्डिया खे खुल़ाई ती।<verse eid="PSA 78:46" /></para>
  <para style="q">
    <verse number="47" style="v" sid="PSA 78:47" />तिने तिना री अंगूरा री बेला ओल़ेया साथे</para>
  <para style="q" vid="PSA 78:47">तिना रे गूलरो रे डाल़ बड़े-बड़े पात्थर बरसाई की नाश करीते।<verse eid="PSA 78:47" /></para>
  <para style="q">
    <verse number="48" style="v" sid="PSA 78:48" />तिने तिना रे डांगर ओल़ेया साथे</para>
  <para style="q" vid="PSA 78:48">ओर तिना रिया पेड़ा-बाकरिया पाँदे बिजल़ी सेटी सेयो मटयाई तिया।<verse eid="PSA 78:48" /></para>
  <para style="q">
    <verse number="49" style="v" sid="PSA 78:49" />तिने तिना पाँदे आपणा प्रचण्ड गुस्सा ओर कोप पड़काया</para>
  <para style="q" vid="PSA 78:49">ओर सेयो बिपदा रे पाईते ओर दु:ख देणे वाल़े दूता रा दल पेजेया।<verse eid="PSA 78:49" /></para>
  <para style="q">
    <verse number="50" style="v" sid="PSA 78:50" />तिने आपणे गुस्से पाँदे लगाम नि लगाई, ओर ना तिना रे प्राण छाडे,</para>
  <para style="q" vid="PSA 78:50">बल्कि सेयो महामारिया ते काईते।<verse eid="PSA 78:50" /></para>
  <para style="q">
    <verse number="51" style="v" sid="PSA 78:51" />तिने मिस्र देशो रे सब जेठे बच्चे काईते,</para>
  <para style="q" vid="PSA 78:51">हामो रे वंशो रे सबी ते तागतबर माणूं मरी गे।<verse eid="PSA 78:51" /></para>
  <para style="q">
    <verse number="52" style="v" sid="PSA 78:52" />तिजी ते बाद परमेशर आपणी प्रजा रे लोका खे पेडा-बाकरिया जेड़ी एकी जगा ते दूजी जगा खे लई चलेया</para>
  <para style="q" vid="PSA 78:52">ओर सुनसाण जगा रे तिना री अगुवाई डांगरा रे चूण्डा जेड़ी कित्ती।<verse eid="PSA 78:52" /></para>
  <para style="q">
    <verse number="53" style="v" sid="PSA 78:53" />से तिना खे सई-सलामत लई चलेया ओर तिना खे कोई डर नि लगेया,</para>
  <para style="q" vid="PSA 78:53">पर तिना रे दुश्मण समुद्रो रे डूबी गे।<verse eid="PSA 78:53" /></para>
  <para style="q">
    <verse number="54" style="v" sid="PSA 78:54" />ओर तिने सेयो आपणे पवित्र देशो रे बन्ने तक,</para>
  <para style="q" vid="PSA 78:54">तेसी पाह्ड़ी देशो रे पऊँचाए, जो तिने आपणी सामर्था साथे जीतेया था।<verse eid="PSA 78:54" /></para>
  <para style="q">
    <verse number="55" style="v" sid="PSA 78:55" />परमेशरे तिना सामणे ते दूजी जातिया नठाई तिया;</para>
  <para style="q" vid="PSA 78:55">ओर तिना री जमीन डोरिया साथे नापी-नापी की बांडी ती;</para>
  <para style="q" vid="PSA 78:55">ओर इस्राएलो रे गोत्र तिना रे डेरेया रे बसाए।<verse eid="PSA 78:55" /></para>
  <para style="q">
    <verse number="56" style="v" sid="PSA 78:56" />तेबे बी तिने परमपरदान परमेशरो री परीक्षा कित्ती</para>
  <para style="q" vid="PSA 78:56">ओर तेस साथे बगावत कित्ती ओर तेसरी चतौणिया नि मानियां<verse eid="PSA 78:56" /></para>
  <para style="q">
    <verse number="57" style="v" sid="PSA 78:57" />ओर तिने तेसते मूँ फेरी की आपणे बुजुर्गा जेड़ा विश्वासघात कित्तेया;</para>
  <para style="q" vid="PSA 78:57">सेयो तोखा देणे वाल़े धनुषो जेड़े दूजिया तरफा खे मुड़ी गे।<verse eid="PSA 78:57" /></para>
  <para style="q">
    <verse number="58" style="v" sid="PSA 78:58" />कऊँकि तिने ऊच्ची जगा पाँदे बेदिया बणाई की परमेशर नराज कित्तेया</para>
  <para style="q" vid="PSA 78:58">ओर मूर्तिया बणाई की तेसरे जल़न पैदा कित्ती।<verse eid="PSA 78:58" /></para>
  <para style="q">
    <verse number="59" style="v" sid="PSA 78:59" />ये देखी कि यहोवे खे गुस्सा आया,</para>
  <para style="q" vid="PSA 78:59">ओर तिने इस्राएल बिल्कुल छाडीता।<verse eid="PSA 78:59" /></para>
  <para style="q">
    <verse number="60" style="v" sid="PSA 78:60" />तिने शीलोह शईर आपणे रणे री जगा</para>
  <para style="q" vid="PSA 78:60">जो तिने माणूंआ बीचे खड़ा कित्तेया था, छाडीता।<verse eid="PSA 78:60" /></para>
  <para style="q">
    <verse number="61" style="v" sid="PSA 78:61" />ओर आपणा सन्दूक बंदुआईया रे जाणे दित्तेया</para>
  <para style="q" vid="PSA 78:61">ओर आपणी सामर्थ ओर महिमा रा चिह्न दुश्मणा रे आथो रे करिता।<verse eid="PSA 78:61" /></para>
  <para style="q">
    <verse number="62" style="v" sid="PSA 78:62" />तिने आपणी प्रजा तलवारी साथे मरवाई ती</para>
  <para style="q" vid="PSA 78:62">ओर आपणे निज पाअगो रे लोका पाँदे तेसरा गुस्सा पड़की गा।<verse eid="PSA 78:62" /></para>
  <para style="q">
    <verse number="63" style="v" sid="PSA 78:63" />तिना रे जवान आगी रे पस्म ऊईगे</para>
  <para style="q" vid="PSA 78:63">ओर तिना री कुआँरिया रे ब्याओ रे गीत नि गाए गये।<verse eid="PSA 78:63" /></para>
  <para style="q">
    <verse number="64" style="v" sid="PSA 78:64" />तिना रे पुरोईत तलवारी की मारे गये</para>
  <para style="q" vid="PSA 78:64">ओर तिना रिया बिदुआ खे शोग करने री आज्ञा नि थी।<verse eid="PSA 78:64" /></para>
  <para style="q">
    <verse number="65" style="v" sid="PSA 78:65" />तेबे प्रभु मानो नींजा रे छल़ी की उठेया</para>
  <para style="q" vid="PSA 78:65">ओर एड़े वीरो जेड़ा उठेया जो शराब पी की ललकारोआ।<verse eid="PSA 78:65" /></para>
  <para style="q">
    <verse number="66" style="v" sid="PSA 78:66" />तिने आपणे बरोदी मारी की पीछे टाई ते;</para>
  <para style="q" vid="PSA 78:66">ओर तिना री सदा खे बेज्जती कराई।<verse eid="PSA 78:66" /></para>
  <para style="q">
    <verse number="67" style="v" sid="PSA 78:67" />पर तिने यूसुफो रा वंश छाडीता;</para>
  <para style="q" vid="PSA 78:67">ओर तिने एप्रैमो रा गोत्र नि चुणेया;<verse eid="PSA 78:67" /></para>
  <para style="q">
    <verse number="68" style="v" sid="PSA 78:68" />पर यहूदा रा ई गोत्र ओर सिय्योन पाह्ड़ चूणी ला,</para>
  <para style="q" vid="PSA 78:68">जेतेते से प्यार करो था।<verse eid="PSA 78:68" /></para>
  <para style="q">
    <verse number="69" style="v" sid="PSA 78:69" />तिने आपणा मन्दर बऊत ऊच्चा बणाईता,</para>
  <para style="q" vid="PSA 78:69">ओर तरतिया जेड़ा से मजबूत बणाईता, जेतेरी निऊँ तिने सदा खे पाई राखी।<verse eid="PSA 78:69" /></para>
  <para style="q">
    <verse number="70" style="v" sid="PSA 78:70" />फेर तिने आपणा दास दाऊद चूणी ला</para>
  <para style="q" vid="PSA 78:70">ओर पेडा रिया गवाईणी ते से निकयाल़ी ला;<verse eid="PSA 78:70" /></para>
  <para style="q">
    <verse number="71" style="v" sid="PSA 78:71" />से तेसखे बच्चे वाल़िया पेडा पीछे-पीछे फिरने ते लई आया</para>
  <para style="q" vid="PSA 78:71">ताकि से तेसरी प्रजा याकूबो रा मतलब तेसरे निज पाअग इस्राएलो रा चरवाह बणो।<verse eid="PSA 78:71" /></para>
  <para style="q">
    <verse number="72" style="v" sid="PSA 78:72" />दाऊदे खरे मनो ते तिना री रखवाल़ी कित्ती</para>
  <para style="q" vid="PSA 78:72">ओर आपणे आथो री कुशलता साथे तिना री अगुवाई कित्ती।<verse eid="PSA 78:72" /></para>
  <chapter eid="PSA 78" />
  <chapter number="79" style="c" sid="PSA 79" />
  <para style="s">देशो रे छुटकारे रिया तँईं प्रार्थना</para>
  <para style="d">आसापो रा पजन</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 79:1" />ओ परमेशर, दूजी जातिया वाल़ेया तेरिया जगा पाँदे कब्जा करिता दा,</para>
  <para style="q" vid="PSA 79:1">तिने तेरा पवित्र मन्दर अशुद्ध करिता दा,</para>
  <para style="q" vid="PSA 79:1">तिने यरूशलेम शईर पुरिया तरआ ते नाश करिता दा ए।<note caller="+" style="f"><char style="fr" closed="false">79:1 </char><char style="ft" closed="false">लूक 21:24, प्रकाशित 11:2</char></note><verse eid="PSA 79:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 79:2" />तिने तेरे दासा रिया लाशा सर्गो रे पंछिया रा खाणा बणने रिया तँईं</para>
  <para style="q" vid="PSA 79:2">ओर तेरे पग्ता रा मास बणो रे डांगरा खे खाणे रिया तँईं देईता।<verse eid="PSA 79:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 79:3" />तिने तेरे लोका रा खून यरूशलेमो रे चऊँ कनारे पाणिए जेड़ा बाह्या,</para>
  <para style="q" vid="PSA 79:3">ओर तिना खे माट्टी देणे वाल़ा कोई नि था।<note caller="+" style="f"><char style="fr" closed="false">79:3 </char><char style="ft" closed="false">प्रकाशित 16:6</char></note><verse eid="PSA 79:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 79:4" />पड़ोसिया बीचे म्हारी निंदा ऊई;</para>
  <para style="q" vid="PSA 79:4">चऊँ कनारे रणे वाल़े आसा पाँदे आसोए ओर म्हारा मजाक ऊड़ाओए।<verse eid="PSA 79:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 79:5" />ओ प्रभु, कदुओ तक? क्या तां लगातार गुस्सा करदे रणा?</para>
  <para style="q" vid="PSA 79:5">कदुओ तक आगी जेड़ी जल़न तांदे पड़कदी रणी?<verse eid="PSA 79:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 79:6" />जो जातिया ताखे नि जाणदिया,</para>
  <para style="q" vid="PSA 79:6">ओर जिना राज्य रे लोक तांते प्रार्थना नि करदे,</para>
  <para style="q" vid="PSA 79:6">तिना पाँदे ई आपणा सारा गुस्सा पड़का।<note caller="+" style="f"><char style="fr" closed="false">79:6 </char><char style="ft" closed="false">1 थिस्सलुनी 4:5, 2 थिस्सलुनी 1:8</char></note><verse eid="PSA 79:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 79:7" />कऊँकि तिने तेरे आपणे इस्राएली लोक काईते;</para>
  <para style="q" vid="PSA 79:7">ओर तिने तेरा देश नाश करिता।<verse eid="PSA 79:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 79:8" />म्हारे बुजुर्गा रे पापो रे कामा खे म्हारे खलाफ याद नि कर;</para>
  <para style="q" vid="PSA 79:8">तेरी दया आसा पाँदे चटचारे ओ, कऊँकि आसे बऊत बुरिया दशा रे पड़ी रे।<verse eid="PSA 79:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 79:9" />ओ म्हारे उद्धारकर्ता परमेशर, आपणे नाओं री महिमा रिया तँईं म्हारी मताद कर;</para>
  <para style="q" vid="PSA 79:9">ओर आपणे नाओं रे मुताबिक आसा खे छुड़ाई की म्हारे पाप टखी दे।<verse eid="PSA 79:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 79:10" />ताकि दूजिया जातिया रे लोक बोली नि सको कि तिना रा परमेशर केई ए?</para>
  <para style="q" vid="PSA 79:10">तेरे दासा रे खूनो रा बदला दूजिया जातिया ते आसा सामणे लया जाओ।<note caller="+" style="f"><char style="fr" closed="false">79:10 </char><char style="ft" closed="false">प्रकाशित 6:10, प्रकाशित 19:2</char></note><verse eid="PSA 79:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 79:11" />तेरे सामणे कैदिया रा कणना तेरे कानो तक पऊँचो;</para>
  <para style="q" vid="PSA 79:11">आपणी महान सामर्था रे जरिए जो घात ऊणे वाल़े ए तिना खे बचा।<verse eid="PSA 79:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 79:12" />ओ यहोवा, दूजिये जातिये जो तेरी बेज्जती करी राखी ए,</para>
  <para style="q" vid="PSA 79:12">तिजी रा सातगुणा बदला तिना खे दे!<verse eid="PSA 79:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 79:13" />तेबे आसा जो तेरी प्रजा ओर तेरी चराईया रिया पेडा ए,</para>
  <para style="q" vid="PSA 79:13">तेरा तन्यवाद सदा करदे रणा;</para>
  <para style="q" vid="PSA 79:13">ओर पीढ़िया ते पीढ़िया तक तेरा गुणगाण सदा करदे रणा।<verse eid="PSA 79:13" /></para>
  <chapter eid="PSA 79" />
  <chapter number="80" style="c" sid="PSA 80" />
  <para style="s">इस्राएली जातिया रिया तँईं प्रार्थना</para>
  <para style="d">बजाणे वाल़े रे परदानो रिया तँईं शोशन्नीमेदूत रागो रे आसापो रा पजन</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 80:1" />ओ इस्राएलो रे चराणे वाल़े, सुण!</para>
  <para style="q" vid="PSA 80:1">तूँ जो यूसुफो री अगुवाई पेडा जेड़ी करेया,</para>
  <para style="q" vid="PSA 80:1">ओ करूबा पाँदे विराजमान ऊणे वाल़े, आपणा तेज दखा!<verse eid="PSA 80:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 80:2" />तूँ एप्रैम, बिन्यामीन ओर मनश्शे रे सामणे आईजा।</para>
  <para style="q" vid="PSA 80:2">तूँ आसा खे आपणी तागत दखा; तूँ आईजा ओर आसा खे बचाई लो<verse eid="PSA 80:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 80:3" />ओ परमेशर, आसा खे जिंयाँ का तिंयाँ करी दे;</para>
  <para style="q" vid="PSA 80:3">ओर आसा पाँदे दया कर, ताकि आसे आपणे दुश्मणा ते बची सकिए<verse eid="PSA 80:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 80:4" />ओ स्वर्गिय सेनाओं रे प्रभु परमेशर,</para>
  <para style="q" vid="PSA 80:4">तां कदुओ तक आपणी प्रजा रिया प्रार्थना अणसुणी करदे रणा?<verse eid="PSA 80:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 80:5" />तैं तिना खे आसूआ री रोटी खुल़ाई,</para>
  <para style="q" vid="PSA 80:5">ओर पीणे खे आसू ई आसू दित्ते।<verse eid="PSA 80:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 80:6" />तूँ आसा खे म्हारे पड़ोसिया साथे लड़ाई करने री बजा बणाई देया;</para>
  <para style="q" vid="PSA 80:6">ओर म्हारे दुश्मण म्हारी बेज्जती करोए।<verse eid="PSA 80:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 80:7" />ओ स्वर्गिय सेनाओं रे परमेशर, आसा खे जिंयाँ का तिंयाँ करी दे;</para>
  <para style="q" vid="PSA 80:7">ओर आपणी दया आसा पाँदे प्रकट कर, ताकि आसे बची जाईए।<verse eid="PSA 80:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 80:8" />तूँ मिस्र देशो ते एक दाखा री बेल लई आया;</para>
  <para style="q" vid="PSA 80:8">ओर दूजिया जातिया<note caller="+" style="f"><char style="fr" closed="false">80:8 </char><char style="ft" closed="false">कनानी लोक</char></note> खे निकयाल़ी की से लगाईती।<note caller="+" style="f"><char style="fr" closed="false">80:8 </char><char style="ft" closed="false">यशा. 5:1-7</char></note><verse eid="PSA 80:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 80:9" />परमेशरे तेसा बेला खे जगा त्यार कित्ती;</para>
  <para style="q" vid="PSA 80:9">ओर तेसे बेले जड़ पकड़ी ओर फैली की देश परीता।<verse eid="PSA 80:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 80:10" />पाह्ड़ तिजी री छाया ते</para>
  <para style="q" vid="PSA 80:10">ओर बऊत बड़े देवदार तिजी रिया बेली ते टखीगे;<verse eid="PSA 80:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 80:11" />तिजी रिया पाँगटिया समुद्रो तक बढ़ी गिया,</para>
  <para style="q" vid="PSA 80:11">ओर तिजी रे पलँगूर फरात नदिया तक फैली गे।<verse eid="PSA 80:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 80:12" />तेबे तैं तिजी रा बाड़ कऊँ टाईता,</para>
  <para style="q" vid="PSA 80:12">एबे सारे बाटा चलदे तिजी रे फल़ तोड़ी देओए?<verse eid="PSA 80:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 80:13" />जंगल़ी सूंर तिजी खे नाश करी देओए</para>
  <para style="q" vid="PSA 80:13">ओर बणो रे सारे डांगर तिजी खे चरी जाओए।<verse eid="PSA 80:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 80:14" />ओ स्वर्गिय सेनाओं रे परमेशर, वापस आईजा!</para>
  <para style="q" vid="PSA 80:14">स्वर्गो ते त्यानो साथे देख, आओ ओर आपणियां प्रजा खे बचा,<verse eid="PSA 80:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 80:15" />ये बेल तैं आपणे दाँणे आथो साथे लगाई,</para>
  <para style="q" vid="PSA 80:15">ओर जो पाँगटी तैं आपणियां तँईं मजबूत करी राखी,<verse eid="PSA 80:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 80:16" />से आगी दे फूखी गी, से बाडी ती;</para>
  <para style="q" vid="PSA 80:16">दुश्मण तेरे थिड़कणे ते नाश ऊई जाओ।<verse eid="PSA 80:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 80:17" />पर तिना लोका री रखवाल़ी कर जो तैं आपणियां तँईं चूणी राखे</para>
  <para style="q" vid="PSA 80:17">ओर से देश जेते खे तैं तागत देई राखी ए।<verse eid="PSA 80:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 80:18" />तेबे आसा लोका तांते मूँ नि मोड़ना:</para>
  <para style="q" vid="PSA 80:18">तूँ आसा खे जिन्दगी दे ताकि आसे तांते प्रार्थना करी सकिए।<verse eid="PSA 80:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 80:19" />ओ स्वर्गिय सेनाओं रे प्रभु परमेशर, आसा खे जिंयाँ का तिंयाँ करी दे</para>
  <para style="q" vid="PSA 80:19">ओर आसा पाँदे दया कर, ताकि आसे आपणे दुश्मणा ते बची जाईए,<verse eid="PSA 80:19" /></para>
  <chapter eid="PSA 80" />
  <chapter number="81" style="c" sid="PSA 81" />
  <para style="s">परमेशरो री पलाई ओर इस्राएलो रा अठ</para>
  <para style="d">बजाणे वाल़े परदानो रिया तँईं गित्तीथ रागो रे आसापो रा पजन।</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 81:1" />ऊच्चिया आवाजा रे खुशिया साथे परमेशरो रा गीत गाओ,</para>
  <para style="q" vid="PSA 81:1">सेई म्हारी तागत ए; याकूबो रे परमेशरो री जयजयकार करो!<note caller="+" style="f"><char style="fr" closed="false">81:1 </char><char style="ft" closed="false">पजन 67:4</char></note><verse eid="PSA 81:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 81:2" />पजन गाओ, डफली ओर सारंगिया साथे</para>
  <para style="q" vid="PSA 81:2">मिठिया आवाजा रे बीणा बजाओ।<verse eid="PSA 81:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 81:3" />नये चाँदो रे दिने,</para>
  <para style="q" vid="PSA 81:3">ओर पूनेया खे म्हारे त्योआरो रे दिने रड़सिंगा बजाओ।<verse eid="PSA 81:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 81:4" />कऊँकि ये इस्राएलो खे बिधि,</para>
  <para style="q" vid="PSA 81:4">ओर याकूबो रे परमेशरो रा ठराया रा नियम ए।<verse eid="PSA 81:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 81:5" />जेबे परमेशरे मिस्र देशो खे सजा दित्ती थी, तेबे तिने ये नियम इस्राएलिया खे दित्ते।</para>
  <para style="q" vid="PSA 81:5">माखे एक अणजाण आवाज ये बोलदे ऊए सुणी कि,<verse eid="PSA 81:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 81:6" />मैं प्रभुए तिना रिया कांदा पाँदा ते बोज उतारी ता;</para>
  <para style="q" vid="PSA 81:6">तिना रा टोकरी टोणा छूटीगा।<verse eid="PSA 81:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 81:7" />तैं मुसीबता रे बखते आँऊ पुकारेया, तेबे मैं तूँ बचाया;</para>
  <para style="q" vid="PSA 81:7">मैं बादल़ गरजणे रिया गुप्त जगा ते ताखे उत्तर दित्तेया,</para>
  <para style="q" vid="PSA 81:7">ओर मरीबा नाओं री सूबल़ा रे नेड़े तेरी परीक्षा कित्ती।<note caller="+" style="f"><char style="fr" closed="false">81:7 </char><char style="ft" closed="false">निर्ग. 17:1-7; गिण 20:2-13; पजन 95:8-9</char></note> सेला<verse eid="PSA 81:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 81:8" />ओ मेरी प्रजा, सुण, आऊँ ताखे सचेत करूँआ!</para>
  <para style="q" vid="PSA 81:8">ओ इस्राएल पला ओ कि तूँ मेरी गल्ल सुणो!<verse eid="PSA 81:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 81:9" />तां बीचे केसी पराए देवते री आराधना नि ओ;</para>
  <para style="q" vid="PSA 81:9">ओर ना ई तैं केसी पराये देवते गे माथा टेकणा!<verse eid="PSA 81:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 81:10" />तेरा प्रभु परमेशर आऊँ ए,</para>
  <para style="q" vid="PSA 81:10">जो ताखे मिस्र देशो ते निकयाल़ी की लई आई रा।</para>
  <para style="q" vid="PSA 81:10">तूँ आपणा मूँ खोल, मां से परी देणा।<note caller="+" style="f"><char style="fr" closed="false">81:10 </char><char style="ft" closed="false">पजन 37:3,4</char></note><verse eid="PSA 81:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 81:11" />पर मेरिये प्रजे मेरी बाणी नि सुणी;</para>
  <para style="q" vid="PSA 81:11">इस्राएले मेरी आज्ञा नि मानी।<verse eid="PSA 81:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 81:12" />इजी री खातर मैं से तेसरे टीठ मनो पाँदे छाडीता,</para>
  <para style="q" vid="PSA 81:12">ताकि से आपणी ई योजना रे मुताबिक चलो।<note caller="+" style="f"><char style="fr" closed="false">81:12 </char><char style="ft" closed="false">प्रेरित 14:16</char></note><verse eid="PSA 81:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 81:13" />जे मेरी प्रजे मेरी गल्ल सुणी ऊँदी,</para>
  <para style="q" vid="PSA 81:13">जे इस्राएल मेरी बताई री बाटा रे चलदा,<verse eid="PSA 81:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 81:14" />तो आऊँ तिना रे दुश्मणा खे चट ई अराई देंदा</para>
  <para style="q" vid="PSA 81:14">ओर तिना खे सख्त सजा देंदा।<verse eid="PSA 81:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 81:15" />जो लोक यहोवे ते नफरत करोए; सेयो डरदे ऊए तेसरे सामणे चुकणे,</para>
  <para style="q" vid="PSA 81:15">तिना री सजा हमेशा खे बणी दी रणी।<verse eid="PSA 81:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 81:16" />ओ इस्राएल, आँऊ ताखे खरिया ते खरी कणका रिया रोटिया खुल़ांदा,</para>
  <para style="q" vid="PSA 81:16">ओर आँऊ चट्टानी रे सईतो साथे ताखे रजांदा।<verse eid="PSA 81:16" /></para>
  <chapter eid="PSA 81" />
  <chapter number="82" style="c" sid="PSA 82" />
  <para style="s">सच्चे न्याय रिया तँईं बिनती</para>
  <para style="d">आसापो रा पजन</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 82:1" />परमेशरो रिया सभा दे परमेशर ई खड़ी रा,</para>
  <para style="q" vid="PSA 82:1">से ईश्वरा रे दूता<note caller="+" style="f"><char style="fr" closed="false">82:1 </char><char style="ft" closed="false">जो लोक सोचोए कि सेयो ईश्वर ए</char></note> बीचे न्याय करोआ।<verse eid="PSA 82:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 82:2" />तुसा लोका कदुओ तक अन्याय साथे फैंसला करदे रणा</para>
  <para style="q" vid="PSA 82:2">ओर दुष्ट लोका रा पक्ष लंदे रणा? सेला<verse eid="PSA 82:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 82:3" />गरीब ओर अनाथा रा न्याय चुकाओ,</para>
  <para style="q" vid="PSA 82:3">जरूरतमंदा ओर बेसहारा खे बेकसूर सिद्ध करो।<verse eid="PSA 82:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 82:4" />कमजोर ओर बेसहारा लोका खे बचाई लओ;</para>
  <para style="q" vid="PSA 82:4">ताकि बुरे लोक तिना खे काईल नि करी सको।<verse eid="PSA 82:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 82:5" />ईश्वर<note caller="+" style="f"><char style="fr" closed="false">82:5 </char><char style="ft" closed="false">दुष्ट लोक</char></note> ना तो कुछ समजोए ओर ना कुछ जाणोए,</para>
  <para style="q" vid="PSA 82:5">बल्कि सेयो न्हेरे पटकणे लगी रे; तरतिया री पूरी निऊँ ईल्ली जाओई।<verse eid="PSA 82:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 82:6" />मैं बोलेया, “तुसे ईश्वर ए,</para>
  <para style="q" vid="PSA 82:6">ओर सब के सब परमपरदान परमेशरो रे पाऊ ए;<note caller="+" style="f"><char style="fr" closed="false">82:6 </char><char style="ft" closed="false">यूह. 10:34</char></note><verse eid="PSA 82:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 82:7" />तेबे बी तुसे माणूंआ जेड़े मरने,</para>
  <para style="q" vid="PSA 82:7">ओर परदाना जेड़ा तुसा रा बी पतन ऊई जाणा।”<verse eid="PSA 82:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 82:8" />ओ परमेशर उठ, तरतिया रा न्याय कर;</para>
  <para style="q" vid="PSA 82:8">कऊँकि सारे देशा पाँदे तेरा ई अक्क ए!<verse eid="PSA 82:8" /></para>
  <chapter eid="PSA 82" />
  <chapter number="83" style="c" sid="PSA 83" />
  <para style="s">इस्राएलो री जीता रिया तँईं प्रार्थना</para>
  <para style="d">आसापो रा गीत</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 83:1" />ओ परमेशर मौन नि रओ;</para>
  <para style="q" vid="PSA 83:1">ओ परमेशर चुप नि रओ, ओर ना ई शांत रओ!<verse eid="PSA 83:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 83:2" />देख! तेरे दुश्मण अंगामा मचाणे लगी रे;</para>
  <para style="q" vid="PSA 83:2">ओर जो तांते बैर राखोए, सेयो बरोद करोए।<verse eid="PSA 83:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 83:3" />सेयो उशयारिया साथे तेरी प्रजा रे खलाफ षड़यन्त्र रचणे लगी रे,</para>
  <para style="q" vid="PSA 83:3">ओर जिना री तूँ रक्षा करेया तिना रे खलाफ आपू बीचे सम्मति करोए।<verse eid="PSA 83:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 83:4" />तिने एकी दूजे खे बोलेया, “आओ, आसे तिना खे एड़ा नाश करूँए कि राज्य ई खत्म ऊई जाओ;</para>
  <para style="q" vid="PSA 83:4">ओर इस्राएलो रा नाओं आगो खे याद नि रओ।”<verse eid="PSA 83:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 83:5" />तिने एक मन ऊई की सम्मति कित्ती,</para>
  <para style="q" vid="PSA 83:5">ओर तेरे ई खलाफ वाचा बानी राखी।<verse eid="PSA 83:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 83:6" />सेयो दुश्मण यो ए जेड़े एदोमो रे तम्बूए वाल़े</para>
  <para style="q" vid="PSA 83:6">ओर इश्माएली, मोआबी, हग्री,<verse eid="PSA 83:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 83:7" />गबाली, अम्मोनी, अमालेकी</para>
  <para style="q" vid="PSA 83:7">ओर सोर समेत पलिश्ती ए।<verse eid="PSA 83:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 83:8" />अश्शूरी लोक बी इना साथे मिली गे रे;</para>
  <para style="q" vid="PSA 83:8">ओर लूतो रे वंशो वाल़े अम्मोनी ओर मोआबी बी इना रिया तरफा खे मिली गे रे। सेला<verse eid="PSA 83:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 83:9" />इना साथे एड़ा बर्ताव कर जेड़ा तैं मिद्यानिया साथे,</para>
  <para style="q" vid="PSA 83:9">ओर कीशोन नाल़े रे सीसरा ओर याबीनो साथे कित्तेया था,<note caller="+" style="f"><char style="fr" closed="false">83:9 </char><char style="ft" closed="false">न्यायियो 6-8</char></note><verse eid="PSA 83:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 83:10" />जो एनदोरो रे नाश ऊए,</para>
  <para style="q" vid="PSA 83:10">ओर जमीना रिया तँईं खाद बणीगे।<note caller="+" style="f"><char style="fr" closed="false">83:10 </char><char style="ft" closed="false">सेयो कब्रा दे नि दबाए, पर जेती पड़ी रे थे तिना रिया लाशा तेथी जमीना दे पड़िया दिया रईया </char></note><verse eid="PSA 83:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 83:11" />तिना रे परदाना साथे तेड़ा ई करो जो तुसे ओरेब ओर जेबो<note caller="+" style="f"><char style="fr" closed="false">83:11 </char><char style="ft" closed="false">ओरेब ओर जेब दो मिद्यानी परदान थे जो जिन्हें एप्रैमिये काईते, न्यायियो 7:24-25</char></note> साथे कित्तेया था;</para>
  <para style="q" vid="PSA 83:11">जेबह ओर सल्मुन्ना जेड़ा तिना रे सबी परदाना खे अराई दे,<note caller="+" style="f"><char style="fr" closed="false">83:11 </char><char style="ft" closed="false">न्यायियो 8:21</char></note><verse eid="PSA 83:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 83:12" />जिने बोलेया था, “आओ, आसा से जमीन आपणे कब्जे दे करी लणी जो परमेशरो री ए।”<verse eid="PSA 83:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 83:13" />ओ परमेशर, इना खे पऊण-चूखाने रिया तूड़ा जेड़े,</para>
  <para style="q" vid="PSA 83:13">या पऊणी साथे ड्वाए रे पूए जेड़ा करी दे।<verse eid="PSA 83:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 83:14" />तेसा आगी जेड़े जो बणो खे फूकी की स्वा करी देओई,</para>
  <para style="q" vid="PSA 83:14">ओर तेसा लूपिया जेड़ी जो पाह्ड़ा खे फूकी देओई,<verse eid="PSA 83:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 83:15" />तूँ इना खे आपणे तूफानो साथे नठाई दे,</para>
  <para style="q" vid="PSA 83:15">ओर तेरे पऊण-चूखाने साथे यो कबराई जाओ!<verse eid="PSA 83:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 83:16" />ओ यहोवा, दुश्मणा खे बऊत शर्मिंदा कर,</para>
  <para style="q" vid="PSA 83:16">ताकि सेयो ये मानी लओ कि तूँ बऊत तागतबर ए।<verse eid="PSA 83:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 83:17" />इना खे सदा-सदा खे शर्मिंदा कर ओर डराई दे,</para>
  <para style="q" vid="PSA 83:17">यो बेज्जत ऊई जाओ, ओर इना रा नाश ऊई जाओ,<verse eid="PSA 83:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 83:18" />जेते कि यो जाणी लओ कि बस तूँई जेसरा नाओं प्रभु ए,</para>
  <para style="q" vid="PSA 83:18">ओर तूँ ई सारी तरतिया पाँदे परमपरदान परमेशर ए।<verse eid="PSA 83:18" /></para>
  <chapter eid="PSA 83" />
  <chapter number="84" style="c" sid="PSA 84" />
  <para style="s">परमेशरो रे मन्दरो री इच्छा</para>
  <para style="d">बजाणे वाल़े परदानो रिया तँईं गित्तीथ रागो रे कोरह वंशिया रा पजन।</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 84:1" />ओ स्वर्गिय सेनाओं रे प्रभु,</para>
  <para style="q" vid="PSA 84:1">तेरा मन्दर केड़ा बांका ए!<verse eid="PSA 84:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 84:2" />मेरा प्राण प्रभुए रे आँगणो री इच्छा करदे-करदे बेओश ऊईगा;</para>
  <para style="q" vid="PSA 84:2">मेरा तन मन दोनो जिऊँदे परमेशरो खे आका पाणे लगी रे।<verse eid="PSA 84:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 84:3" />ओ स्वर्गिय सेनाओं रे प्रभु, ओ मेरे राजा,</para>
  <para style="q" vid="PSA 84:3">ओर मेरे परमेशर, तेरी बेदिया पाँदे चिड़िये आपणा बसेरा</para>
  <para style="q" vid="PSA 84:3">ओर शूपाबेनिये आपणा कोअला बणाई ला रा जिदे सेयो आपणे बच्चे राखो।<verse eid="PSA 84:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 84:4" />तन्य ए सेयो तेरे मईलो रे रणे वाल़े;</para>
  <para style="q" vid="PSA 84:4">तिना तेरी स्तुति लगातार करदे रणा।<verse eid="PSA 84:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 84:5" />तूँ तिना सबी लोका खे आशीर्वाद देआ जो आपणी तागती रिया तँईं तां पाँदे निर्भर ए</para>
  <para style="q" vid="PSA 84:5">ओर जो तेरे मन्दरो दे जाणे री गईरी इच्छा राखोए।<verse eid="PSA 84:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 84:6" />सेयो रोणे री तराईया रे जांदे ऊए तिजी खे सूबल़ा री जगा बणाई देओए;</para>
  <para style="q" vid="PSA 84:6">फेर बरसाती री आगली बर्खा तिदे आशीष ई आशीष उपजाओई।<verse eid="PSA 84:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 84:7" />सेयो जीता पाँदे जीत पाँदे जाओए;</para>
  <para style="q" vid="PSA 84:7">तिना बीचा ते हर एकी जणे सिय्योनो रे परमेशरो खे आपणा मूँ दखाणा।<verse eid="PSA 84:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 84:8" />ओ प्रभु, स्वर्गिय सेनाओं रे परमेशर, मेरी प्रार्थना सुण,</para>
  <para style="q" vid="PSA 84:8">ओ याकूबो रे परमेशर मेरिया गल्ला पाँदे त्यान दे!<verse eid="PSA 84:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 84:9" />ओ परमेशर, म्हारे राजे खे आशीष दे,</para>
  <para style="q" vid="PSA 84:9">जेस राजे खे तैं चूणी राखेया ए!<verse eid="PSA 84:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 84:10" />तेरे आँगणो रे एक दिन रणा ओरी जगा ह्जार दिन रणे ते केथी खरा ए।</para>
  <para style="q" vid="PSA 84:10">दुष्टा रे डेरेया रे रणे ते आपणे परमेशरो रे मन्दरो रिया देऊल़ी पाँदे खड़े रणा माखे जादा अच्छा लगोआ।<verse eid="PSA 84:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 84:11" />ओ यहोवा, म्हारी रक्षा करने वाल़ा महान राजा तूँ ई ए, प्रभु दया ओर महिमा देओआ;</para>
  <para style="q" vid="PSA 84:11">ओर जो लोक तर्मो रिया बाटा रे हांडोए; प्रभु तिना खे खरिया-खरिया चीजा देओआ।<verse eid="PSA 84:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 84:12" />ओ स्वर्गिय सेनाओं रे प्रभु! से माणूं बऊत ई तन्य ए</para>
  <para style="q" vid="PSA 84:12">जो तां पाँदे परोसा राखोआ!<verse eid="PSA 84:12" /></para>
  <chapter eid="PSA 84" />
  <chapter number="85" style="c" sid="PSA 85" />
  <para style="s">परमेशरो री दया रिया तँईं प्रार्थना</para>
  <para style="d">बजाणे वाल़े परदानो रिया तँईं : कोरह वंशिया रा पजन।</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 85:1" />ओ यहोवा, तैं आपणे देशो पाँदे दया करी राखी ए,</para>
  <para style="q" vid="PSA 85:1">याकूबो री ल्वादा खे बंदुआईया ते छुड़ाई की लई आई रा।<verse eid="PSA 85:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 85:2" />तैं आपणी प्रजा रे बुरे काम माफ करी राखे;</para>
  <para style="q" vid="PSA 85:2">ओर तिना रे सारे पाप टखी ते रे। सेला<verse eid="PSA 85:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 85:3" />तैं आपणा गुस्सा शांत करिता रा;</para>
  <para style="q" vid="PSA 85:3">ओर आपणा पड़केया रा कोप दूर करी राखेया।<verse eid="PSA 85:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 85:4" />पर ओ परमेशर, एबे आसा रिया तरफा खे कूम, ओर आसा खे फेर तागतबर बणा।</para>
  <para style="q" vid="PSA 85:4">तूँ ई ए जो आसा खे बचाएआ, आसा ते नराज ऊणा बन्द करी दे।<verse eid="PSA 85:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 85:5" />क्या तां सदा ई आसा ते नराज रणा?</para>
  <para style="q" vid="PSA 85:5">क्या तां पीढ़िया ते पीढ़िया तक गुस्सा करदे रणा?<verse eid="PSA 85:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 85:6" />कृपा करी कि आसा गे वापस आईजा ओर आसा खे नवां जीवन दे!</para>
  <para style="q" vid="PSA 85:6">तेबे आसे जो तेरी प्रजा ए सुखी ऊणे ओर तेरी स्तुति करनी।<verse eid="PSA 85:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 85:7" />ओ प्रभु, आपणी करूणा आसा खे दखा,</para>
  <para style="q" vid="PSA 85:7">ओर तूँ म्हारा उद्धार कर।<verse eid="PSA 85:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 85:8" />एबे मां त्यानो साथे सुणना कि परमेशर यहोवा क्या बोलोआ?</para>
  <para style="q" vid="PSA 85:8">तेस आपणी प्रजा खे जो पग्त बी ए शान्ति देणी,</para>
  <para style="q" vid="PSA 85:8">पर सेयो दुबारा मूर्खता नि करने लगो।<verse eid="PSA 85:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 85:9" />पक्का यहोवे रा उद्धार तिना लोका रे नेड़े ए जो तेसते डरोए,</para>
  <para style="q" vid="PSA 85:9">तेबे म्हारे देशो रे परमेशरो री महिमा दिशणी।<verse eid="PSA 85:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 85:10" />करूणा ओर सच्चाई आपू बीचे मिलीगी रिया;</para>
  <para style="q" vid="PSA 85:10">तार्मिकता ओर शान्ति आपू बीचे मिलीगिया।<verse eid="PSA 85:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 85:11" />तरतिया बीचा ते सच्चाई डाल़ा जेड़ी उगोई</para>
  <para style="q" vid="PSA 85:11">न्याय सर्गो ते थाले देखणा।<verse eid="PSA 85:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 85:12" />फेर प्रभुए खरिया चीजा देणियां</para>
  <para style="q" vid="PSA 85:12">ओर म्हारिया जमीना आपणी उपज देणी।<verse eid="PSA 85:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 85:13" />न्याय यहोवे ते आगे-आगे चलणा,</para>
  <para style="q" vid="PSA 85:13">ओर आपणे पैरा रे नशाणो ते आसा खे बाट बनाणी।<verse eid="PSA 85:13" /></para>
  <chapter eid="PSA 85" />
  <chapter number="86" style="c" sid="PSA 86" />
  <para style="s">मतादा रिया तँईं प्रार्थना</para>
  <para style="d">दाऊदो री प्रार्थना</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 86:1" />ओ यहोवा, मेरिया बिनतिया खे त्यानो साथे सुण ओर माखे उत्तर दे,</para>
  <para style="q" vid="PSA 86:1">कऊँकि आऊँ दु:खी ओर गरीब ए।<verse eid="PSA 86:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 86:2" />मेरे प्राणो री रक्षा कर, कऊँकि आऊँ पग्त ए;</para>
  <para style="q" vid="PSA 86:2">तूँ मेरा परमेशर ए, इजी री खातर आपणे दास माखे,</para>
  <para style="q" vid="PSA 86:2">जेसरा परोसा तां पाँदे ए, उद्धार कर।<verse eid="PSA 86:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 86:3" />ओ यहोवा, मां पाँदे दया कर;</para>
  <para style="q" vid="PSA 86:3">कऊँकि आऊँ ताखे ई लगातार आका पाँदा रऊँआ।<verse eid="PSA 86:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 86:4" />ओ यहोवा, आपणे दासो रे मनो खे खुश कर,</para>
  <para style="q" vid="PSA 86:4">कऊँकि आऊँ तेरा ई त्यान करूँआ।<verse eid="PSA 86:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 86:5" />ओ यहोवा, तूँ पला ओर माफ करने वाल़ा ए,</para>
  <para style="q" vid="PSA 86:5">ओर जितणे ताखे पुकारोए तिना सबी पाँदे तूँ बऊत करूणा करने वाल़ा ए।<verse eid="PSA 86:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 86:6" />ओ प्रभु, मेरिया प्रार्थना पाँदे त्यान दे;</para>
  <para style="q" vid="PSA 86:6">ओर मेरी बिनती त्यानो साथे सुण।<verse eid="PSA 86:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 86:7" />मुसीबता रे बखते मां ताखे आका पाणिया,</para>
  <para style="q" vid="PSA 86:7">कऊँकि तां मेरी सुणी लणी।<verse eid="PSA 86:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 86:8" />ओ यहोवा, देवतेया बीचे तां जेड़ा कोई नि ए,</para>
  <para style="q" vid="PSA 86:8">ओर ना ई ओरी रे काम तेरे कामा रे बराबर ए।<verse eid="PSA 86:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 86:9" />ओ यहोवा, जितणिया जातिया तैं बणाई राखिया,</para>
  <para style="q" vid="PSA 86:9">सबी तां सामणे आई की तांगे माथा टेकणा,</para>
  <para style="q" vid="PSA 86:9">ओर तिना तेरे नाओं री महिमा करनी।<note caller="+" style="f"><char style="fr" closed="false">86:9 </char><char style="ft" closed="false">प्रकाशित 15:4</char></note><verse eid="PSA 86:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 86:10" />कऊँकि तूँ महान ए ओर नौखे काम करने वाल़ा ए,</para>
  <para style="q" vid="PSA 86:10">बस तूँई एक परमेशर ए।<verse eid="PSA 86:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 86:11" />ओ यहोवा, आपणी बाट माखे दखा, ताकि आँऊ सच्चाईया पाँदे चलूँ;</para>
  <para style="q" vid="PSA 86:11">माखे एक चित्त कर, ताकि आऊँ तेरे नाओं रा डर मानूँ।<verse eid="PSA 86:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 86:12" />ओ यहोवा, ओ मेरे परमेशर, मां आपणे पूरे मनो ते तेरा तन्यवाद करना,</para>
  <para style="q" vid="PSA 86:12">ओर तेरे नाओं री महिमा सदा करदे रणा।<verse eid="PSA 86:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 86:13" />मेरिया तँईं तेरा लगातार प्यार कितणा महान ए!</para>
  <para style="q" vid="PSA 86:13">तैं आऊँ मरने ते बचाई ला।<verse eid="PSA 86:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 86:14" />ओ परमेशर, कमण्डी लोक मेरे खलाफ उठी रे,</para>
  <para style="q" vid="PSA 86:14">ओर बुरे लोका रा चूण्ड माखे काणे रा मोका टोल़ेया करोए,</para>
  <para style="q" vid="PSA 86:14">ओर सेयो लोक तेरा कुछ बी आदर नि करदे।<verse eid="PSA 86:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 86:15" />पर तूँ, ओ प्रभु, दयालु ओर कृपा, देरिया ते गुस्सा करने वाल़ा,</para>
  <para style="q" vid="PSA 86:15">करूणा ओर सच्चाईया ते परेया रा परमेशर ए।<verse eid="PSA 86:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 86:16" />मेरिया तरफा खे फिरी की मां पाँदे दया कर;</para>
  <para style="q" vid="PSA 86:16">आपणे दासो खे तूँ सामर्थ दे, ओर आपणी दासिया रे पाऊए खे बचा।<verse eid="PSA 86:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 86:17" />आपणी पलाईया रा कोई चिह्न दखा,</para>
  <para style="q" vid="PSA 86:17">जेतेखे देखी की मेरे बैरी शर्मिंदा ओ, कऊँकि ओ प्रभु,</para>
  <para style="q" vid="PSA 86:17">तैं आपू मेरी मताद कित्ती ओर माखे शान्ति देई राखी।<verse eid="PSA 86:17" /></para>
  <chapter eid="PSA 86" />
  <chapter number="87" style="c" sid="PSA 87" />
  <para style="s">परमेशरो रा शईर सिय्योनो री स्तुतिया रे</para>
  <para style="d">कोरह वंशिया रा पजन। गीत</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 87:1" />यहोवे जो शईर बसाया ए से तेसरे पवित्र पाह्ड़ो पाँदे ए;<verse eid="PSA 87:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 87:2" />इस्राएलो रिया केसी बी जगा ते बढ़ी की,</para>
  <para style="q" vid="PSA 87:2">से यरूशलेम शईरो ते प्यार करोआ।<verse eid="PSA 87:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 87:3" />ओ परमेशरो रे शईर,<note caller="+" style="f"><char style="fr" closed="false">87:3 </char><char style="ft" closed="false">यरूशलेम</char></note> सुण,</para>
  <para style="q" vid="PSA 87:3">तिना नौखिया गल्ला रे बारे दे जो से तेरे बारे दे बोलोआ; सेला<verse eid="PSA 87:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 87:4" />मां आपणे जाण-पछयाणी रे लोका साथे मिस्र</para>
  <para style="q" vid="PSA 87:4">ओर बाबेलो री बी चर्चा करनी; पलिश्ती, सोर ओर कूशो<note caller="+" style="f"><char style="fr" closed="false">87:4 </char><char style="ft" closed="false">इथोपिया</char></note> खे देखो;</para>
  <para style="q" vid="PSA 87:4">तिना रे बारे दे ये बोलेया जाओआ : “ये तेथी पैदा ऊआ था।”<verse eid="PSA 87:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 87:5" />पर यरूशलेमो रे बारे दे ये बोलेया जाणा, “इना सबी जातिया रा जन्म तेथी ऊईरा”</para>
  <para style="q" vid="PSA 87:5">ओर परमपरदानो से शईर तागतबर बनाणा।<verse eid="PSA 87:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 87:6" />यहोवे जेबे देशो-देशो रे लोका रे नाओं लिखी की गिणी लणे,</para>
  <para style="q" vid="PSA 87:6">तेबे ये बोलणा, “ये तेथी पैदा ऊआ था।” सेला<verse eid="PSA 87:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 87:7" />गाणेवाल़ेया ओर नाचणे वाल़ेया दुँईं बोलणा, “म्हारी सारिया आशीषा रा कारण यरूशलेम शईर ई ए।”<verse eid="PSA 87:7" /></para>
  <chapter eid="PSA 87" />
  <chapter number="88" style="c" sid="PSA 88" />
  <para style="s">मौता ते बचाणे री प्रार्थना</para>
  <para style="d">कोरह वंशिया रा पजन। बजाणे वाल़े रे परदानो रिया तँईं : महलतलग्नोत रागो रे एज्रावंशी हेमानो रा मश्कील</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 88:1" />ओ यहोवा, मेरे उद्धारकर्ता परमेशर,</para>
  <para style="q" vid="PSA 88:1">आऊँ तां सामणे आपणे दु:खो दे रोऊँआ।<verse eid="PSA 88:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 88:2" />मेरिया प्रार्थना पाँदे त्यान दे,</para>
  <para style="q" vid="PSA 88:2">मेरी मतादा रिया तँईं बिनती सुण!<verse eid="PSA 88:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 88:3" />आऊँ इतणे संकटो दे पड़ी रा,</para>
  <para style="q" vid="PSA 88:3">कि आऊँ एबे मरने वाल़ा ए।<verse eid="PSA 88:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 88:4" />आऊँ कब्रा रे जाणे वाल़ेया बीचे गिणी राखेया;</para>
  <para style="q" vid="PSA 88:4">आऊँ कमजोर मर्दो जेड़ा ऊईगा रा।<verse eid="PSA 88:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 88:5" />आऊँ मुड़देया बीचे छाडीता रा,</para>
  <para style="q" vid="PSA 88:5">ओर जो घात ऊई की कब्रा रे पड़ी रे,</para>
  <para style="q" vid="PSA 88:5">जिना खे तूँ फेर याद नि करदा ओर सेयो तेरी मतादा ते बिना ए,</para>
  <para style="q" vid="PSA 88:5">तिना जेड़ा आऊँ ऊईगा रा।<verse eid="PSA 88:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 88:6" />तैं आऊँ कब्रा री थाल़िया रेई,</para>
  <para style="q" vid="PSA 88:6">न्हेरे ओर डूगिया जगा रे राखी राखेया।<verse eid="PSA 88:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 88:7" />तेरे गुस्से री जल़न मां ई पाँदे बणी री;</para>
  <para style="q" vid="PSA 88:7">आपणियां सारिया लईरा साथे तूँ माखे डबोणे लगी रा। सेला<verse eid="PSA 88:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 88:8" />तैं आऊँ मेरे जाण-पछयाण वाल़ेया ते दूर करी राखेया;</para>
  <para style="q" vid="PSA 88:8">ओर आऊँ तिना री नजरा दे बुरा बणाईता। आऊँ बंदी ए ओर निकल़ी नि सकदा।<note caller="+" style="f"><char style="fr" closed="false">88:8 </char><char style="ft" closed="false">अय्यू. 19:13, पजन 31:11, लूक 23:49</char></note><verse eid="PSA 88:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 88:9" />दु:खो रिया बजा ते मेरिया आखी ते चाल़ा-माल़ा दिशोआ।</para>
  <para style="q" vid="PSA 88:9">ओ यहोवा, आऊँ लगातार ताखे आका पाऊँआ ओर प्रार्थना दे आपणे आथ तेरिया तरफा खे फैलांदा आई रा।<verse eid="PSA 88:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 88:10" />क्या तां मुड़देया रिया खातर नौखे काम करने?</para>
  <para style="q" vid="PSA 88:10">क्या मरे रेया लोका उठी की तेरी स्तुति करनी? सेला<verse eid="PSA 88:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 88:11" />क्या कब्रा रे तेरी करूणा रा</para>
  <para style="q" vid="PSA 88:11">ओर नाश-लोको रे तेरी सच्चाईया रा बखाण ऊई सकोआ?<verse eid="PSA 88:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 88:12" />क्या न्हेरे तेरे नौखे काम,</para>
  <para style="q" vid="PSA 88:12">या तेरी तार्मिकता विश्वासघातो रिया दशा रे प्रकट कित्ती जाणी?<verse eid="PSA 88:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 88:13" />प्रभु, आँऊ तेरिया मतादा रिया तँईं रोऊँआ;</para>
  <para style="q" vid="PSA 88:13">प्यागा मेरी प्रार्थना तां तक पऊँचोई।<verse eid="PSA 88:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 88:14" />ओ प्रभु, तूँ माखे कऊँ छाडेया?</para>
  <para style="q" vid="PSA 88:14">तूँ आपणा मूँ मांते कऊँ लकोंदा रएया?<verse eid="PSA 88:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 88:15" />आऊँ बचपनो तेई दु:खी बल्कि अदमुआ ए;</para>
  <para style="q" vid="PSA 88:15">आँऊ मौता रे नेड़े पऊँची गा रा;</para>
  <para style="q" vid="PSA 88:15">आऊँ तेरे डरो रे मारे बऊत बेचैन ऊईगा रा।<verse eid="PSA 88:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 88:16" />तेरा गुस्सा मां पाँदे उतरी रा;</para>
  <para style="q" vid="PSA 88:16">तेरे डरो ते आँऊ नाश ऊणे लगी रा।<verse eid="PSA 88:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 88:17" />तैं जो विपत्ति पेजी राखी ए, सेयो मेरे चऊँ कनारे ए, जिंयाँ डूगे पाणिए दे बाढ़।</para>
  <para style="q" vid="PSA 88:17">सेयो मेरे चऊँ कनारिये बऊत नेड़े आओईया।<verse eid="PSA 88:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 88:18" />तैं दोस्त ओर पाई-बन्दुआ दुँईं ते आऊँ दूर करी राखेया;</para>
  <para style="q" vid="PSA 88:18">एबे न्हेरा ई मेरा साथी ए।<verse eid="PSA 88:18" /></para>
  <chapter eid="PSA 88" />
  <chapter number="89" style="c" sid="PSA 89" />
  <para style="s">राष्ट्रो री बिपदा रे बखते स्तुतिगान</para>
  <para style="d">एतान एज्रावंशिये रा मश्कील</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 89:1" />प्रभु, मां तेरी करूणा रे बारे दे सदा गांदे रणा;</para>
  <para style="q" vid="PSA 89:1">मां आपणे मुंए ते तेरी सच्चाई पीढ़िया ते पीढ़िया तक बतांदे रणा।<verse eid="PSA 89:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 89:2" />कऊँकि मैं बोली राखेया, “तेरी करूणा सदा बणी री रणी,</para>
  <para style="q" vid="PSA 89:2">तां स्वर्गो रे आपणी सच्चाई बणाई री राखणी।”<verse eid="PSA 89:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 89:3" />तैं बोलेया, “मैं आपणे चूणे रे राजे साथे वाचा बानी राखी,</para>
  <para style="q" vid="PSA 89:3">मैं आपणे दास दाऊदो ते ये कसम खाई राखी,<verse eid="PSA 89:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 89:4" />मां दाऊदो रे वंशो बीचा ते एक हमेशा खे राजा बनाणा;</para>
  <para style="q" vid="PSA 89:4">ओर तेरी राजगद्दी पीढ़िया ते पीढ़िया तक बणाई री राखणी।”<verse eid="PSA 89:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 89:5" />ओ प्रभु, स्वर्गो रे तेरे नौखे कामा री,</para>
  <para style="q" vid="PSA 89:5">ओर पवित्र लोका री सबा रे तेरी सच्चाईया री तारीफ ऊणी।<verse eid="PSA 89:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 89:6" />कऊँकि सर्गो रे यहोवे जेड़ा कोई पनि आ।</para>
  <para style="q" vid="PSA 89:6">स्वर्गदूता बीचे यहोवे जेड़ा कोई पनि आ।<verse eid="PSA 89:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 89:7" />परमेशर पवित्र लोका री सबा रे बऊत जादा प्रतिष्ठा जोगा ए,</para>
  <para style="q" vid="PSA 89:7">से आपणे चऊँ कनारे रणे वाल़ेया बीचे सबी ते जादा डरो जोगा ए।<note caller="+" style="f"><char style="fr" closed="false">89:7 </char><char style="ft" closed="false">2 थिस्सलुनी 1:10, पजन 76:7,11</char></note><verse eid="PSA 89:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 89:8" />ओ प्रभु, स्वर्गिय सेनाओं रे परमेशर यहोवा, तां जेड़ा योद्धा कोई पनि ए।</para>
  <para style="q" vid="PSA 89:8">ओ प्रभु, तेरे चऊँ कनारे तेरी सच्चाई ए!<verse eid="PSA 89:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 89:9" />समुद्रो रे गर्वो खे तूँई तोड़ेया; जेबे तिजी रिया लईरा उठोईया,</para>
  <para style="q" vid="PSA 89:9">तेबे तूँई तिना खे शांत करी देया।<verse eid="PSA 89:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 89:10" />तैं समुद्रो रे राक्ष राहाबो खे थाले मांडी की काईता,</para>
  <para style="q" vid="PSA 89:10">तैं आपणे पराक्रमो ते आपणे दुश्मण अराईते।<note caller="+" style="f"><char style="fr" closed="false">89:10 </char><char style="ft" closed="false">लूक 1:51, यशायाह 51:9</char></note><verse eid="PSA 89:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 89:11" />सर्ग तेरा ए, तरती बी तेरी ए; दुनिया ओर जो कुछ तिदे ए,</para>
  <para style="q" vid="PSA 89:11">से तैंई बणाई राखेया।<note caller="+" style="f"><char style="fr" closed="false">89:11 </char><char style="ft" closed="false">1 कुरिन्थ 10:26, पजन 24:1,2</char></note><verse eid="PSA 89:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 89:12" />उत्तर ओर दक्खण तैंई बणाई राखे;</para>
  <para style="q" vid="PSA 89:12">ताबोर ओर हेर्मोन पाह्ड़ तेरे नाओं री जयजयकार करोए।<verse eid="PSA 89:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 89:13" />तेरिया बांयी तागतबर ए; तेरा आथ शक्तिया साथे परेया राए</para>
  <para style="q" vid="PSA 89:13">ओर तेरा दाँणा आथ प्रबल ए।<verse eid="PSA 89:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 89:14" />तार्मिकता ओर न्याय तेरे सिंहासनो रे मूल़ ए;</para>
  <para style="q" vid="PSA 89:14">करूणा ओर सच्चाई तांते आगे-आगे चलोईया।<verse eid="PSA 89:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 89:15" />सेयो लोक बऊत ई तन्य ए जो त्योआरो री खुशिया खे जाणोए;</para>
  <para style="q" vid="PSA 89:15">ओ प्रभु, सेयो लोक तेरे मुंए री जोतिया रे प्रयासे साथे हांडोए,<verse eid="PSA 89:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 89:16" />आसे हमेशा हर रोज खुश रऊँए,</para>
  <para style="q" vid="PSA 89:16">तेरिया तार्मिकता रिया तँईं आसे तेरी जयजयकार करूँए।<verse eid="PSA 89:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 89:17" />तूँई तिना री तागती री शोभा ए,</para>
  <para style="q" vid="PSA 89:17">ओर तेरिया खुशिया ते म्हारा सिर ऊच्चा ऊई जाणा।<verse eid="PSA 89:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 89:18" />म्हारी ढाल प्रभुए रिया तरफा ते ए;</para>
  <para style="q" vid="PSA 89:18">म्हारा राजा इस्राएलो रे पवित्र परमेशरो रिया तरफा ते ए।<verse eid="PSA 89:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 89:19" />तैं पुराणे बखतो रे आपणे पग्तो खे दर्शण देई की</para>
  <para style="q" vid="PSA 89:19">ये बोलेया था, “मैं मताद करने री जिम्मेबारी एकी तागतबर मर्दो पाँदे राखी ए।</para>
  <para style="q" vid="PSA 89:19">मैं प्रजा बीचा ते एक मर्द चूणी राखेया ओर से बढ़ाई राखेया।<verse eid="PSA 89:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 89:20" />मैं आपणे दास दाऊदो खे लई की,</para>
  <para style="q" vid="PSA 89:20">आपणे पवित्र तेलो साथे तेसरा अभिषेक करी राखेया।<note caller="+" style="f"><char style="fr" closed="false">89:20 </char><char style="ft" closed="false">प्रेरित 13:22</char></note><verse eid="PSA 89:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PSA 89:21" />मेरी तागत हमेशा तेस साथे रणी,</para>
  <para style="q" vid="PSA 89:21">ओर मेरिया तागती से मजबूत बनाणा।<verse eid="PSA 89:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="PSA 89:22" />तेसरा दुश्मण तेसखे अराई नि सकणा,</para>
  <para style="q" vid="PSA 89:22">ओर ना ई बुरे माणूं तेसखे दु:ख देई सकणे।<verse eid="PSA 89:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="PSA 89:23" />मां तेसरे दुश्मण तेस सामणे नाश करने,</para>
  <para style="q" vid="PSA 89:23">ओर तेसरे बैरिया पाँदे मुसीबता पाणिया।<verse eid="PSA 89:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="PSA 89:24" />पर मेरी सच्चाई ओर करूणा तेस साथे बणी री रणी,</para>
  <para style="q" vid="PSA 89:24">ओर मेरे नाओं रे जरीये तेसरा सींग ऊच्चा ऊई जाणा।<verse eid="PSA 89:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="PSA 89:25" />मां तेसरे राज्य भूमध्य सागरो ते लई कि फरात नदिया तक फलाणा।<verse eid="PSA 89:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="PSA 89:26" />तेस माखे आका पाई की बोलणा, ‘तूँ मेरा पिता ए,</para>
  <para style="q" vid="PSA 89:26">मेरा परमेशर ओर माखे बचाणे री चट्टान ए।’<note caller="+" style="f"><char style="fr" closed="false">89:26 </char><char style="ft" closed="false">1 पत 1:17, प्रकाशित 21:7</char></note><verse eid="PSA 89:26" /></para>
  <para style="q">
    <verse number="27" style="v" sid="PSA 89:27" />तेबे मां से आपणा जेठा पाऊ,</para>
  <para style="q" vid="PSA 89:27">ओर तरतिया रे राजेया पाँदे परदान बनाणा।<note caller="+" style="f"><char style="fr" closed="false">89:27 </char><char style="ft" closed="false">प्रकाशित 1:5, प्रकाशित 17:18</char></note><verse eid="PSA 89:27" /></para>
  <para style="q">
    <verse number="28" style="v" sid="PSA 89:28" />मां आपणी करूणा तेस पाँदे सदा बणाई री राखणी,</para>
  <para style="q" vid="PSA 89:28">ओर मेरी वाचा तेसखे अटल़ रणी।<verse eid="PSA 89:28" /></para>
  <para style="q">
    <verse number="29" style="v" sid="PSA 89:29" />तेसरा खानदान मां कदी बी खत्म नि ऊणे देणा</para>
  <para style="q" vid="PSA 89:29">ओर तेसरे खानदानो ते एक सदा खे राजे रे सिंहासनो पाँदे बैठणा।<verse eid="PSA 89:29" /></para>
  <para style="q">
    <verse number="30" style="v" sid="PSA 89:30" />जे तेसरे वंशो रे लोक मेरे बिधानो खे छाडो</para>
  <para style="q" vid="PSA 89:30">ओर मेरे नियमा रे मुताबिक नि चलोगे,<verse eid="PSA 89:30" /></para>
  <para style="q">
    <verse number="31" style="v" sid="PSA 89:31" />जे सेयो मेरे बिधि-बिधानो खे नि मानोगे,</para>
  <para style="q" vid="PSA 89:31">ओर मेरिया आज्ञा खे नि मानोगे,<verse eid="PSA 89:31" /></para>
  <para style="q">
    <verse number="32" style="v" sid="PSA 89:32" />तेबे मां तिना रे पापा री सजा तिना खे देणी;</para>
  <para style="q" vid="PSA 89:32">तिना रिया गल़तिया रिया तँईं तिना दु:ख पुगतणा पड़ना।<verse eid="PSA 89:32" /></para>
  <para style="q">
    <verse number="33" style="v" sid="PSA 89:33" />पर मां आपणी करूणा तेस पाँदा ते नि टाणी,</para>
  <para style="q" vid="PSA 89:33">ओर ना आपणी सच्चाई चूठी बणने देणी।<verse eid="PSA 89:33" /></para>
  <para style="q">
    <verse number="34" style="v" sid="PSA 89:34" />ना मां आपणा वादा तोड़ना,</para>
  <para style="q" vid="PSA 89:34">ओर ना आपणे मुंए ते निकल़े रे शब्द बदल़ने।<verse eid="PSA 89:34" /></para>
  <para style="q">
    <verse number="35" style="v" sid="PSA 89:35" />आँऊ सदा खे आपणी पवित्रता री कसम खाई चुकेया रा;</para>
  <para style="q" vid="PSA 89:35">मां दाऊदो खे कदी तोखा नि देणा।<verse eid="PSA 89:35" /></para>
  <para style="q">
    <verse number="36" style="v" sid="PSA 89:36" />तेसरा वंश सदा चलदा रणा,</para>
  <para style="q" vid="PSA 89:36">ओर तेसरी राजगद्दी सूरजो जेड़ी मां सामणे चमकदी रणी।<note caller="+" style="f"><char style="fr" closed="false">89:36 </char><char style="ft" closed="false">लूक 1:32,33</char></note><verse eid="PSA 89:36" /></para>
  <para style="q">
    <verse number="37" style="v" sid="PSA 89:37" />से चाँदो जेड़ा सदा बणेया रा रणा;</para>
  <para style="q" vid="PSA 89:37">ये गवाई सर्गो रे बणी री ए।”<verse eid="PSA 89:37" /></para>
  <para style="s">राजे रे आरने पाँदे विलाप</para>
  <para style="q">
    <verse number="38" style="v" sid="PSA 89:38" />प्रभु, तेबे बी तैं आपणा अभिषिक्त राजा छाडीता</para>
  <para style="q" vid="PSA 89:38">ओर से मानेया नि, तैं आपणे अभिषिक्त राजे पाँदे बऊत गुस्सा कित्तेया।<verse eid="PSA 89:38" /></para>
  <para style="q">
    <verse number="39" style="v" sid="PSA 89:39" />तैं आपणे दासो साथे बानी री वाचा छाडी ती,</para>
  <para style="q" vid="PSA 89:39">ओर तेसरा मुकुट जमीना दे सेटी की अशुद्ध करिता।<verse eid="PSA 89:39" /></para>
  <para style="q">
    <verse number="40" style="v" sid="PSA 89:40" />तैं तेसरे शईरो रिया सारिया दवाला तोड़ी तिया,</para>
  <para style="q" vid="PSA 89:40">ओर तेसरे गढ़ खण्डहर बणाईते।<verse eid="PSA 89:40" /></para>
  <para style="q">
    <verse number="41" style="v" sid="PSA 89:41" />सब बाटा दे आऊँदे जांदे लोक जो चाओ तन-दौलत लूटी लओए,</para>
  <para style="q" vid="PSA 89:41">ओर तेसरे नेड़े तेड़े रे देशो रे लोक तेसरा मजाक उडाओए!<verse eid="PSA 89:41" /></para>
  <para style="q">
    <verse number="42" style="v" sid="PSA 89:42" />तैं तेसरे बरोदी तागतबर बणाए;</para>
  <para style="q" vid="PSA 89:42">ओर तेसरे सारे दुश्मण खुश करी राखे।<verse eid="PSA 89:42" /></para>
  <para style="q">
    <verse number="43" style="v" sid="PSA 89:43" />तैं तेसरे अस्त्र-शस्त्र बेकार करीते ए,</para>
  <para style="q" vid="PSA 89:43">ओर से अराईता रा ए।<verse eid="PSA 89:43" /></para>
  <para style="q">
    <verse number="44" style="v" sid="PSA 89:44" />तैं तेसरा राजदण्ड तेसरे आथो ते छीनी ला,</para>
  <para style="q" vid="PSA 89:44">ओर तेसरा सिंहासन जमीना दे सेटी ता।<verse eid="PSA 89:44" /></para>
  <para style="q">
    <verse number="45" style="v" sid="PSA 89:45" />तैं तेसरी जवानी कटाई ती,</para>
  <para style="q" vid="PSA 89:45">ओर से आरने री शरमा साथे टखी ता रा। सेला<verse eid="PSA 89:45" /></para>
  <para style="s">छुटकारे रिया तँईं प्रार्थना</para>
  <para style="q">
    <verse number="46" style="v" sid="PSA 89:46" />ओ प्रभु, तां कदुओ तक लगातार मूँ फेरी की राखणा,</para>
  <para style="q" vid="PSA 89:46">कदुओ तक तेरा गुस्सा आगी जेड़ा पड़कदे रणा।<verse eid="PSA 89:46" /></para>
  <para style="q">
    <verse number="47" style="v" sid="PSA 89:47" />ओ प्रभु, माखे याद कर, कि मेरी जिन्दगी थोड़ी जी तो अए,</para>
  <para style="q" vid="PSA 89:47">तैं सारे माणूं बेकारो रेई कऊँ बणाई राखे?<verse eid="PSA 89:47" /></para>
  <para style="q">
    <verse number="48" style="v" sid="PSA 89:48" />एड़ा कुण माणूं ए जो सदा खे जिऊँदा रओ ओर मौता खे नि देखो?</para>
  <para style="q" vid="PSA 89:48">क्या कोई आपणे आपू खे कब्रा दे जाणे ते बचाई सकोआ? सेला<verse eid="PSA 89:48" /></para>
  <para style="q">
    <verse number="49" style="v" sid="PSA 89:49" />ओ यहोवा, केई ए तेरी पुराणे बखतो री करूणा</para>
  <para style="q" vid="PSA 89:49">जेतेरी कसम तैं आपणे दास दाऊदो साथे सच्चाईया ते खाई थी?<verse eid="PSA 89:49" /></para>
  <para style="q">
    <verse number="50" style="v" sid="PSA 89:50" />ओ यहोवा, आपणे दासो खे याद कर! लोक मेरे बारे दे मजाक करोए,</para>
  <para style="q" vid="PSA 89:50">ओर माखे बऊत बेज्जती सईन करनी पड़ोई।<verse eid="PSA 89:50" /></para>
  <para style="q">
    <verse number="51" style="v" sid="PSA 89:51" />ओ यहोवा, तेरे दुश्मण तेरे चूणे दे राजे री बेज्जती करोए!</para>
  <para style="q" vid="PSA 89:51">सेयो जेती बी जाओए तेसरी बेज्जती करोए।<verse eid="PSA 89:51" /></para>
  <para style="q">
    <verse number="52" style="v" sid="PSA 89:52" />प्रभु जुगो-जुगो तक तन्य रणा! आमीन् फेर आमीन्।<verse eid="PSA 89:52" /></para>
  <chapter eid="PSA 89" />
  <chapter number="90" style="c" sid="PSA 90" />
  <para style="ms">चौथा इस्सा</para>
  <para style="mr">
    <ref loc="PSA 90-106">पजन 90-106</ref></para>
  <para style="s">परमेशर ओर माणूं</para>
  <para style="d">परमेशरो रा जन मूसे री प्रार्थना</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 90:1" />ओ प्रभु, तूँ पीढ़िया ते पीढ़िया तक</para>
  <para style="q" vid="PSA 90:1">आसा खे आसरा लणे री जगा बणी रा।<verse eid="PSA 90:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 90:2" />पाह्ड़ा रे पैदा ऊणे ते पईले, तेरे जरिए दुनिया री सृष्टि ऊणे ते पईले,</para>
  <para style="q" vid="PSA 90:2">शुरूए ते अनन्तकालो तक तूँई परमेशर ए।<verse eid="PSA 90:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 90:3" />तूँ माणूंआ खे माट्टिया रे वापस लई जाएया,</para>
  <para style="q" vid="PSA 90:3">ओर तूँ ये बोलेया, “ओ माणूंओ, वापस आओ!”<verse eid="PSA 90:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 90:4" />कऊँकि ह्जार साल तेरी नजरा रे एड़े ए,</para>
  <para style="q" vid="PSA 90:4">जेड़ा काल का दिन जो बीती गा, या राती रा एक पईर।<note caller="+" style="f"><char style="fr" closed="false">90:4 </char><char style="ft" closed="false">2 पत 3:8</char></note><verse eid="PSA 90:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 90:5" />तूँ माणूंआ खे हड़ाई की लई जाएया;</para>
  <para style="q" vid="PSA 90:5">सेयो सुफने जेड़े ठईरोए, सेयो प्यागा खे बढ़ने वाल़े काओ जेड़े ओए।<verse eid="PSA 90:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 90:6" />जो प्यागा खे बड़ोई ओर फूलोई</para>
  <para style="q" vid="PSA 90:6">ओर साँजा तक बाडी की मुरझाई जाओई।<verse eid="PSA 90:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 90:7" />कऊँकि आसे तेरे गुस्से साथे नाश ऊई रे</para>
  <para style="q" vid="PSA 90:7">ओर तेरी जल़ना साथे कबराई गे रे।<verse eid="PSA 90:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 90:8" />ताखे म्हारे पापा रा पता ए,</para>
  <para style="q" vid="PSA 90:8">जो काम आसे न्हेरे दे लूकी की कित्ते, सेयो बी ताखे दिशोए।<verse eid="PSA 90:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 90:9" />कऊँकि म्हारिया जिन्दगिया रे सारे दिन तेरे रोषो रे बीती जाओए,</para>
  <para style="q" vid="PSA 90:9">आसे आपणी जिन्दगिया रे साल आह् परदे ऊए बिताऊँए।<verse eid="PSA 90:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 90:10" />म्हारी उम्रा रे साल सत्तर तो अए</para>
  <para style="q" vid="PSA 90:10">ओर चाए तागती रिया बजा ते अस्सी बी ऊई जाओए,</para>
  <para style="q" vid="PSA 90:10">तेबे बी तिना री अवधि दु:ख ओर पापो रे बितोई</para>
  <para style="q" vid="PSA 90:10">कऊँकि से चटचारे बीती जाओई ओर आसे प्राण-पखेरू उडी जाओए।<verse eid="PSA 90:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 90:11" />तेरे गुस्से रिया शक्तिया खे</para>
  <para style="q" vid="PSA 90:11">ओर तेरे डरने जोगे रोषो खे कुण समजोआ?<verse eid="PSA 90:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 90:12" />इजी खे आसा खे सखा कि म्हारा जीवन कितणा छोटा ए,</para>
  <para style="q" vid="PSA 90:12">ताकि आसे समजदार ऊई जाऊँ।<verse eid="PSA 90:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 90:13" />ओ यहोवा, वापस आईजा! कदुओ तक तूँ आसा ते गुस्से रणा?</para>
  <para style="q" vid="PSA 90:13">ओर आपणे दासा पाँदे तरस खा!<verse eid="PSA 90:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 90:14" />तूँ प्यागा आपणी करूणा साथे आसा खे रज्जा,</para>
  <para style="q" vid="PSA 90:14">ताकि आसे पूरी जिन्दगी जयजयकार ओर खुशी मनांदे रईये।<verse eid="PSA 90:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 90:15" />जितणे दिन तूँ आसा खे दु:ख देंदा आया</para>
  <para style="q" vid="PSA 90:15">ओर जितणे साल आसे क्ल़ेश सईन करदे आए तिथणे ई साल आसा खे खुशी दे।<verse eid="PSA 90:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 90:16" />तेरा काम तेरे दासा पाँदे</para>
  <para style="q" vid="PSA 90:16">ओर तेरा प्रताप तिना री ल्वादा पाँदे प्रगट ओ।<verse eid="PSA 90:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 90:17" />म्हारे प्रभु परमेशरो री दया आसा पाँदे ओ,</para>
  <para style="q" vid="PSA 90:17">जो काम आसे करूँए तिजी खे सफल कर,</para>
  <para style="q" vid="PSA 90:17">जरूर प्रभु, तूँ म्हारे आथो रे काम सफल कर।<verse eid="PSA 90:17" /></para>
  <chapter eid="PSA 90" />
  <chapter number="91" style="c" sid="PSA 91" />
  <para style="s">परमेशर म्हारा रक्षा करने वाल़ा</para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 91:1" />जो लोक सर्वशक्तिमान परमेशरो रिया शरणा दे रओआ,</para>
  <para style="q" vid="PSA 91:1">सेयो परमपरदान परमेशरो रिया देख-रेखा दे बची की राम करी सकोए।<verse eid="PSA 91:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 91:2" />मां प्रभुए रे बारे बोलणा, “से मेरी शरण लणे री जगा ओर गढ़ ए;</para>
  <para style="q" vid="PSA 91:2">से मेरा परमेशर ए, मां तेस पाँदे परोसा राखणा।”<verse eid="PSA 91:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 91:3" />यहोवे तूँ सबी लूके दे जाल़ा ते छुड़ाणा,</para>
  <para style="q" vid="PSA 91:3">ओर महामारिया ते बचाणा;<verse eid="PSA 91:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 91:4" />तेस तूँ आपणे पंखा रिया ओटी रे लई लणा</para>
  <para style="q" vid="PSA 91:4">ओर तां तेसरे चरणा दे शरण पाणी;</para>
  <para style="q" vid="PSA 91:4">तेसरी सच्चाई ताखे ढाल ओर झिलम ठईरनी।<verse eid="PSA 91:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 91:5" />तूँ ना तो राती रे डरो ते डरना</para>
  <para style="q" vid="PSA 91:5">ओर ना दिने चलणे वाल़े दुश्मणा रे तीरो ते,<verse eid="PSA 91:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 91:6" />ना न्हेरे फैलणे वाल़ी तेसा महामारिया ते</para>
  <para style="q" vid="PSA 91:6">ओर ना नाश करने वाल़े तेस महारोगो ते जो दिने-दपईरे उजाड़ोआ।<verse eid="PSA 91:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 91:7" />तेरे नेड़े ह्जार लोक ओर तेरे दाँणे कनारे दस ह्जार लोक रूड़ी की मरने;</para>
  <para style="q" vid="PSA 91:7">पर महामारी तां नेड़े नि आऊणी।<verse eid="PSA 91:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 91:8" />पर तां आपणियां आखी ते देखणा कि</para>
  <para style="q" vid="PSA 91:8">दुष्ट लोका खे किंयाँ सजा मिलोई।<verse eid="PSA 91:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 91:9" />तैं यहोवे खे आपणा बचाणे वाल़ा,</para>
  <para style="q" vid="PSA 91:9">परमपरदानो खे आपणी रक्षा करने वाल़ा बणाया ए,<verse eid="PSA 91:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 91:10" />इजी री खातर कोई मुसीबत तां पाँदे नि आऊणी,</para>
  <para style="q" vid="PSA 91:10">ना कोई दु:ख तेरे डेरे रे नेड़े आऊणा।<verse eid="PSA 91:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 91:11" />कऊँकि तेस आपणे दूता खे तेरिया तँईं आज्ञा देणी,</para>
  <para style="q" vid="PSA 91:11">कि जेती केथी तूँ जाए सेयो तेरी रक्षा करो।<verse eid="PSA 91:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 91:12" />तिना स्वर्गदूता तूँ आपणे आथो-आथ चकी देणा,</para>
  <para style="q" vid="PSA 91:12">एड़ा नि ओ कि तेरे पैरो रे पात्थरो साथे बूड़ो।<note caller="+" style="f"><char style="fr" closed="false">91:12 </char><char style="ft" closed="false">मत्ती 4:6, लूक 4:10,11, इब्रानी 1:14</char></note><verse eid="PSA 91:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 91:13" />तां शेर ओर नाग केसणे,</para>
  <para style="q" vid="PSA 91:13">तां जवान शेर ओर अजगर पैरा निठे केसणे।<verse eid="PSA 91:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 91:14" />यहोवा बोलोआ, “जो मां साथे प्यार राखेया, इजी री खातर मां से छुड़ाणा;</para>
  <para style="q" vid="PSA 91:14">मां से ऊच्ची जगा रे राखणा, कऊँकि तिने मेरा नाओं जाणी ला रा।”<verse eid="PSA 91:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 91:15" />परमेशरे बोलेया, “जेबे से माखे आका पाओगा; तेबे मां तेसखे उत्तर देणा”</para>
  <para style="q" vid="PSA 91:15">मुसीबता रे बखते मां तेस साथे रणा; मां से बचाणा ओर तेसरी महिमा बढ़ाणी।<verse eid="PSA 91:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 91:16" />मां तेसरी उम्र बढ़ाणी ओर सन्तुष्ट करना</para>
  <para style="q" vid="PSA 91:16">ओर तेसखे आपणे कित्ते रे उद्धारो रा दर्शण कराणा।<verse eid="PSA 91:16" /></para>
  <chapter eid="PSA 91" />
  <chapter number="92" style="c" sid="PSA 92" />
  <para style="s">स्तुतिया रा गीत</para>
  <para style="d">एक पजन। रामो रे दिनो रिया तँईं गीत</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 92:1" />ओ प्रभु, पला ए तेरा तन्यवाद करना;</para>
  <para style="q" vid="PSA 92:1">ओ परमपरदान परमेशर, पला ए तेरे नाओं रा गुणगाण करना;<verse eid="PSA 92:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 92:2" />दस तारा वाल़े बाजे पाँदे, बीणा पाँदे गम्भीर आवाजा दे गाणा, प्यागा तेरी करूणा ओर सांजा तेरी सच्चाईया रा प्रचार करना।<verse eid="PSA 92:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 92:3" />सारंगिया साथे रागो रे मुताबिक प्यागा तेरी करूणा</para>
  <para style="q" vid="PSA 92:3">ओर राती तेरी सच्चाईया रा प्रचार करना कितणा पला ए।<verse eid="PSA 92:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 92:4" />ओ प्रभु, तैं आऊँ आपणे कामे की खुश करी राखेया</para>
  <para style="q" vid="PSA 92:4">ओर मां तेरे आथो रे कामा रिया बजा ते तेरी जयजयकार करनी</para>
  <para style="q" vid="PSA 92:4">जो तैं मेरिया तँईं करी राखी।<verse eid="PSA 92:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 92:5" />ओ प्रभु, तेरे काम कितणे महान ए!</para>
  <para style="q" vid="PSA 92:5">तेरे बचार बऊत ई गम्भीर ए!<note caller="+" style="f"><char style="fr" closed="false">92:5 </char><char style="ft" closed="false">प्रकाशित 15:3, रोमी 11:33,34</char></note><verse eid="PSA 92:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 92:6" />नासमज माणूं ये नि जाणदा ओर ना मूर्ख</para>
  <para style="q" vid="PSA 92:6">इजी रे बारे बचार करोआ :<verse eid="PSA 92:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 92:7" />तेबे बी दुष्ट माणूं काओ जेड़े अरे-परे रओए</para>
  <para style="q" vid="PSA 92:7">ओर सब अनर्थ करने वाल़े खुश ओए,</para>
  <para style="q" vid="PSA 92:7">तेबे बी सेयो सदा-सर्वदा खे नाश ऊई जाणे,<verse eid="PSA 92:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 92:8" />पर ओ प्रभु,</para>
  <para style="q" vid="PSA 92:8">तां राजे रे रूपो दे सदा राज करना<verse eid="PSA 92:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 92:9" />कऊँकि ओ प्रभु, तेरे दुश्मण, आ तेरे दुश्मण नाश ऊणे;</para>
  <para style="q" vid="PSA 92:9">सारे बुरे काम करने वाल़े तित्तर बित्तर ऊई जाणे।<verse eid="PSA 92:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 92:10" />पर तैं आऊँ जंगल़ी सांडो जेड़ा तागतबर बणाई राखेया;</para>
  <para style="q" vid="PSA 92:10">तैं मां पाँदे ताजा तेल लटी की मेरा अभिषेक करी राखेया।<verse eid="PSA 92:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 92:11" />आँऊ आपणे दुश्मणा पाँदे नजर करी की</para>
  <para style="q" vid="PSA 92:11">ओर तिना बुरा करने वाल़ेया रा आल सुणी की सन्तुष्ट ऊईरा,</para>
  <para style="q" vid="PSA 92:11">जो मेरे खलाफ उठे थे।<verse eid="PSA 92:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 92:12" />तार्मिक लोक खजूरो रे डाल़ो जेड़े फलणे-फूलणे</para>
  <para style="q" vid="PSA 92:12">ओर सेयो लबानोन प्रदेशो रे देवदारा रे डाल़ा जेड़े बढ़दे रणे।<verse eid="PSA 92:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 92:13" />सेयो प्रभुए रे मईलो रे लगाए रे,</para>
  <para style="q" vid="PSA 92:13">म्हारे परमेशरो रे आँगणो रे फूलणे-फलणे।<verse eid="PSA 92:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 92:14" />सेयो स्याणे ऊँदे ऊए बी फलदे रणे,</para>
  <para style="q" vid="PSA 92:14">सेयो सदा रस भरे ओर अरे-परे रणे,<verse eid="PSA 92:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 92:15" />जेते की ये प्रगट ओ, कि प्रभु सच्चा ए,</para>
  <para style="q" vid="PSA 92:15">सेई मेरी चट्टान ए, ओर तेसरे कुछ बी बुराई नि ए।<verse eid="PSA 92:15" /></para>
  <chapter eid="PSA 92" />
  <chapter number="93" style="c" sid="PSA 93" />
  <para style="s">परमेशरो रे राज्य री महिमा</para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 93:1" />प्रभु राजा ए; तिने प्रतापो रा पईरावा पईनी राखेया;</para>
  <para style="q" vid="PSA 93:1">प्रभुए पईरावा पईनी राखेया ओर सामर्था रा फैंटा बानी राखेया।</para>
  <para style="q" vid="PSA 93:1">इजी बजा ते दुनिया री निऊँ मजबूत ए, से ईल्ली नि सकदी।<verse eid="PSA 93:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 93:2" />ओ यहोवा, तेरी राजगद्दी शुरूए तेई मजबूत ए,</para>
  <para style="q" vid="PSA 93:2">तूँ सदा ते राज करेया।<verse eid="PSA 93:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 93:3" />ओ प्रभु, समुद्रो रिया प्रचण्ड लईरा ऊठणे लगी रिया,</para>
  <para style="q" vid="PSA 93:3">प्रचण्ड लईरा रा बड़ा पारी शाद ऊणे लगी रा।<verse eid="PSA 93:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 93:4" />महासागरो रिया आवाजा ते ओर समुद्रो रिया प्रचण्ड लईरा ते जादा,</para>
  <para style="q" vid="PSA 93:4">ऊच्चे पाँदे विराजमान प्रभु शक्तिशाली ए।<verse eid="PSA 93:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 93:5" />ओ प्रभु, तेरी चतौणिया बऊत ई परोसे जोगिया ए;</para>
  <para style="q" vid="PSA 93:5">तेरे मईलो खे जुगो-जुगो री पवित्रता ई शोभा देओई।<verse eid="PSA 93:5" /></para>
  <chapter eid="PSA 93" />
  <chapter number="94" style="c" sid="PSA 94" />
  <para style="s">परमेशर सबी रा न्याय करने वाल़ा</para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 94:1" />ओ यहोवा, ओ बदला लणे वाल़े परमेशर,</para>
  <para style="q" vid="PSA 94:1">ओ बदला लणे वाल़े परमेशर, आपणा तेज दखा!<note caller="+" style="f"><char style="fr" closed="false">94:1 </char><char style="ft" closed="false">बिध. 32:35</char></note><verse eid="PSA 94:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 94:2" />ओ तरतिया रा न्याय करने वाल़े, उठ!</para>
  <para style="q" vid="PSA 94:2">ओर कमण्ड करने वाल़ेया ते बदला लओ!<verse eid="PSA 94:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 94:3" />ओ प्रभु, दुष्ट लोका कदुओ तक,</para>
  <para style="q" vid="PSA 94:3">दुष्ट लोका कदुओ तक बडयाईया मारदे रणे?<verse eid="PSA 94:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 94:4" />सेयो लगातार टीठ गल्ला करदे रओए,</para>
  <para style="q" vid="PSA 94:4">ओर सब अनर्थ काम करने वाल़े बडयाईया मारोए।<verse eid="PSA 94:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 94:5" />ओ यहोवा, इने तेरी प्रजा तंग करिती दी!</para>
  <para style="q" vid="PSA 94:5">जो लोक तेरे नीज पाअग ए तिना खे दु:ख देओए।<verse eid="PSA 94:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 94:6" />सेयो बिदुआ ओर परदेशिया री अत्या करोए</para>
  <para style="q" vid="PSA 94:6">ओर अनाथ बच्चेया खे मारी देओए;<verse eid="PSA 94:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 94:7" />सेयो बोलोए, “यहोवा माखे नि देखदा,</para>
  <para style="q" vid="PSA 94:7">याकूबो रा परमेशर बचार नि करदा।”<verse eid="PSA 94:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 94:8" />अरे नासमज लोको तुसे बचार तो करो</para>
  <para style="q" vid="PSA 94:8">ओर ओ मूर्खो, तुसे कदी समजदार ऊणे?<verse eid="PSA 94:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 94:9" />जिने कान दित्ते, क्या से आपू नि सुणदा?</para>
  <para style="q" vid="PSA 94:9">जिने आख बणाई, क्या से आपू नि देखदा?<verse eid="PSA 94:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 94:10" />जो जातिया-जातिया खे ताड़ना देओआ</para>
  <para style="q" vid="PSA 94:10">ओर माणूंआ खे समज देओआ, क्या तेस समजयाणा नि?<verse eid="PSA 94:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 94:11" />प्रभु माणूंआ रे बचारा खे जाणोआ</para>
  <para style="q" vid="PSA 94:11">ओर से ये बी जाणोआ कि माणूं सिर्फ साओ जेड़ा ए।<note caller="+" style="f"><char style="fr" closed="false">94:11 </char><char style="ft" closed="false">1 कुरिन्थ 3:20</char></note><verse eid="PSA 94:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 94:12" />ओ यहोवा, से मर्द बऊत ई तन्य ए जेसखे तूँ ताड़ना देया</para>
  <para style="q" vid="PSA 94:12">ओर ईंयाँ तेसखे आपणा बिधान सिखाओआ,<verse eid="PSA 94:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 94:13" />तूँ तेसखे मुसीबता रे दिने तेस बखतो तक शान्ति देंदा रओआ,</para>
  <para style="q" vid="PSA 94:13">जदुए तक दुष्टा खे गड्डा नि खणेया जांदा।<verse eid="PSA 94:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 94:14" />कऊँकि यहोवे आपणी प्रजा रे लोक नि त्यागणे,</para>
  <para style="q" vid="PSA 94:14">तेस आपणा निज पाअग नि छाडणा;<note caller="+" style="f"><char style="fr" closed="false">94:14 </char><char style="ft" closed="false">रोमी 11:1,2</char></note><verse eid="PSA 94:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 94:15" />पर न्याय बी तार्मिकता रे मुताबिक कित्तेया जाणा</para>
  <para style="q" vid="PSA 94:15">ओर निष्कपट माणूंआ तिजी रा अनुशरण करना।<verse eid="PSA 94:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 94:16" />बुरे काम करने वाल़ेया रे खलाफ मेरी तरफा खे कुण खड़ा ऊणा?</para>
  <para style="q" vid="PSA 94:16">मेरिया तरफा ते अनर्थ काम करने वाल़ेया रा सामणा केस करना?<verse eid="PSA 94:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 94:17" />जे प्रभुए मेरी मताद नि कित्ती ऊँदी,</para>
  <para style="q" vid="PSA 94:17">तो थोड़ी जिया देरा बीचे आऊँ मरी जांदा।<verse eid="PSA 94:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 94:18" />जेबे मैं बोलेया, “मेरा पैर खड़ीसणे लगी रा,”</para>
  <para style="q" vid="PSA 94:18">तेबे ओ प्रभु, तेरी करूणे माखे साअरा दित्तेया।<verse eid="PSA 94:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 94:19" />जेबे मेरे दिलो रे चिन्ता बढ़ी जाओईया,</para>
  <para style="q" vid="PSA 94:19">तेबे ओ प्रभु, तेरी दित्ती री शान्तिया साथे माखे सुख मिलोआ।<note caller="+" style="f"><char style="fr" closed="false">94:19 </char><char style="ft" closed="false">2 कुरिन्थ 1:5</char></note><verse eid="PSA 94:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 94:20" />क्या तेरे ओर दुष्ट माणूंआ रे सिंहासनो बीचे समजौता ऊई सकोआ,</para>
  <para style="q" vid="PSA 94:20">जो नियमा री आड़ा दे हुड़दंग मचाओए?<verse eid="PSA 94:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PSA 94:21" />सेयो तर्मिया रा प्राण लणे खे चूण्ड बणाई की कट्ठे ओए,</para>
  <para style="q" vid="PSA 94:21">ओर निर्दोष माणूंआ खे प्राणदण्ड देओए।<verse eid="PSA 94:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="PSA 94:22" />पर प्रभु मेरा गढ़,</para>
  <para style="q" vid="PSA 94:22">ओर मेरा परमेशर मेरी शरण लणे री मजबूत चट्टान ए।<verse eid="PSA 94:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="PSA 94:23" />परमेशरे तिना रे अनर्थ काम तिना पाँदे ई वापस करीते</para>
  <para style="q" vid="PSA 94:23">ओर तेस सेयो तिना रिया बुराईया साथे ई सत्यानाश करने।</para>
  <para style="q" vid="PSA 94:23">म्हारे प्रभु परमेशरो सेयो जरूर नाश करने।<verse eid="PSA 94:23" /></para>
  <chapter eid="PSA 94" />
  <chapter number="95" style="c" sid="PSA 95" />
  <para style="s">स्तुतिगान</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 95:1" />आओ आसे प्रभुए रिया तँईं ऊच्चिया आवाजा रे गाईए;</para>
  <para style="q" vid="PSA 95:1">जो परमेशर म्हारी रक्षा करोआ तेसरी जयजयकार करो!<verse eid="PSA 95:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 95:2" />आसे तेसरा तन्यवाद करदे ऊए तेस सामणे आईए</para>
  <para style="q" vid="PSA 95:2">ओर पजन गांदे ऊए तेसरी जयजयकार करिए।<verse eid="PSA 95:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 95:3" />प्रभु महान परमेशर ए</para>
  <para style="q" vid="PSA 95:3">ओर से सबी देवतेया बीचे महान् राजा ए।<verse eid="PSA 95:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 95:4" />तरतिया रिया सारिया डूगिया जगा यहोवे रे ई आथो रे ए</para>
  <para style="q" vid="PSA 95:4">ओर पाह्ड़ो रिया चूँडिया बी तेसरिया ईए।<verse eid="PSA 95:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 95:5" />समुद्र तेसरा ईए ओर तिने ई से बणाया</para>
  <para style="q" vid="PSA 95:5">ओर सुकी जगा बी तेसरे ई आथो री रचना ए।<verse eid="PSA 95:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 95:6" />आओ आसे प्रभुए रे चरणा रे चूकी की तेसरी आराधना करिए;</para>
  <para style="q" vid="PSA 95:6">आपणे बनाणे वाल़े प्रभुए रे सामणे सिर चूकाईए!<verse eid="PSA 95:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 95:7" />कऊँकि यहोवा म्हारा परमेशर ए,</para>
  <para style="q" vid="PSA 95:7">ओर आसे तेसरी प्रजा ए, ओर तेसरे आथो रिया पेडा ए।</para>
  <para style="q" vid="PSA 95:7">आज परमेशरो री आवाज सुणो!<note caller="+" style="f"><char style="fr" closed="false">95:7 </char><char style="ft" closed="false">निर्ग. 17:7</char></note><verse eid="PSA 95:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 95:8" />तुसे आपणा दिल इतणा काठा नि करो,</para>
  <para style="q" vid="PSA 95:8">जेड़ा तुसा रे बुजुर्गे तेस दिने कित्तेया था</para>
  <para style="q" vid="PSA 95:8">जेबे सेयो मरीबा रे, सुनसाण जगा दे मस्सा दे थे।<note caller="+" style="f"><char style="fr" closed="false">95:8 </char><char style="ft" closed="false">निर्ग. 17:1-7; गिण. 20:1-13; बिध. 6:16; 33:8</char></note><verse eid="PSA 95:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 95:9" />जेती तुसा रे बुजुर्गे मां प्रभुए री परीक्षा कित्ती थी,</para>
  <para style="q" vid="PSA 95:9">तिने मां प्रभुए रे काम देखी की बी से परखेया था।<verse eid="PSA 95:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 95:10" />चाल़िया साला तक आऊँ तेसा पीढ़िया रे लोका ते रूठेया रा रया</para>
  <para style="q" vid="PSA 95:10">ओर मैं बोलेया, यो तो परमाणे वाल़े मनो रे ए ओर इने मेरी बाट नि पछयाणी।<verse eid="PSA 95:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 95:11" />इजी बजा ते मैं गुस्से रे आई की कसम खाई</para>
  <para style="q" vid="PSA 95:11">कि यो कदी बी मेरे राम करने रिया जगा रे नि जाई सकणे।<note caller="+" style="f"><char style="fr" closed="false">95:11 </char><char style="ft" closed="false">इब्रानी 3:7-19</char></note><verse eid="PSA 95:11" /></para>
  <chapter eid="PSA 95" />
  <chapter number="96" style="c" sid="PSA 96" />
  <para style="s">परमेशर सर्वोच्च राजा</para>
  <para style="r">(<ref loc="1CH 16:23-33">1 इतिआस 16:23-33</ref>)</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 96:1" />प्रभुए रिया तँईं एक नया गीत गाओ,</para>
  <para style="q" vid="PSA 96:1">ओ सारी तरतिया रे लोको प्रभुए रिया तँईं गाओ!<note caller="+" style="f"><char style="fr" closed="false">96:1 </char><char style="ft" closed="false">प्रकाशित 5:9, पजन 33:3</char></note><verse eid="PSA 96:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 96:2" />प्रभुए रिया तँईं गाओ, तेसरे नाओं खे तन्य बोलो;</para>
  <para style="q" vid="PSA 96:2">हर दिन तेसरे कित्ते रे उद्धारो रा शुभ समाचार सुणांदे रओ।<verse eid="PSA 96:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 96:3" />दूजिया जातिया दे यहोवे री महिमा रा</para>
  <para style="q" vid="PSA 96:3">ओर देशो-देशो रे लोका गे तेसरे अचम्बे रे कामा रा बखाण करो।<verse eid="PSA 96:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 96:4" />प्रभु महान् ए ओर बऊत ई स्तुति करने लाईक ए;</para>
  <para style="q" vid="PSA 96:4">से तो सबी देवतेया ते जादा आदर करने जोगा ए।<verse eid="PSA 96:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 96:5" />कऊँकि देशो-देशो रे सब देवता तो मूर्तिया ईए;</para>
  <para style="q" vid="PSA 96:5">पर प्रभुए ई स्वर्ग बणाई राखेया।<verse eid="PSA 96:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 96:6" />तेसरे चऊँ कनारे मान-सम्मान ओर एश्वर्य ए;</para>
  <para style="q" vid="PSA 96:6">तेसरे मन्दरो रे सामर्थ ओर शोभा ए।<verse eid="PSA 96:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 96:7" />ओ देशो-देशो रे कुलो रे लोको,</para>
  <para style="q" vid="PSA 96:7">प्रभुए रा गुणगाण करो,</para>
  <para style="q" vid="PSA 96:7">प्रभुए री महिमा ओर स्तुति करो!<verse eid="PSA 96:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 96:8" />प्रभुए रे नाओं री एड़ी महिमा करो जो तेस जोगी ए;</para>
  <para style="q" vid="PSA 96:8">पेंट लई की तेसरे मन्दरो रे आओ!<verse eid="PSA 96:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 96:9" />परमेशरो री आराधना करो; जो सुन्दर ओर पवित्र ए।</para>
  <para style="q" vid="PSA 96:9">ओ सारी तरतिया रे लोको तेस सामणे थरथरांदे रओ!<verse eid="PSA 96:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 96:10" />जातिया-जातिया बीचे बोलो, “प्रभु राज करोआ!</para>
  <para style="q" vid="PSA 96:10">ओर तरतिया री निऊँ एड़ी मजबूत ए कि से ईल्ली नि सकदी;</para>
  <para style="q" vid="PSA 96:10">प्रभुए देशो-देशो रे लोका रा न्याय बिना पक्षपातो साथे करना।<verse eid="PSA 96:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 96:11" />सर्ग खुशी मनाओ ओर तरती मगन ओ;</para>
  <para style="q" vid="PSA 96:11">समुद्र ओर तिजी बीचलिया सारिया चीजा खुशिया साथे गरजो;<verse eid="PSA 96:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 96:12" />तरती ओर जो कुछ तिदे ए, से खुश ओ;</para>
  <para style="q" vid="PSA 96:12">जेबे प्रभु आऊणा, तेबे बणो रे सारे डाल़ा प्रभुए रे सामणे जयजयकार करनी।</para>
  <para style="q" vid="PSA 96:12">तेस तरतिया रा न्याय करने खे आऊणा।<verse eid="PSA 96:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 96:13" />यहोवे तार्मिकता साथे दुनिया रा</para>
  <para style="q" vid="PSA 96:13">ओर सच्चाईया साथे सबी जातिया रा न्याय करना।”<note caller="+" style="f"><char style="fr" closed="false">96:13 </char><char style="ft" closed="false">प्रेरित 17:31</char></note><verse eid="PSA 96:13" /></para>
  <chapter eid="PSA 96" />
  <chapter number="97" style="c" sid="PSA 97" />
  <para style="s">प्रभुए रा राज्य ओर सामर्थ</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 97:1" />प्रभु राज्य करोआ, तरती मगन ओ;</para>
  <para style="q" vid="PSA 97:1">ओर द्वीप जो बऊत ए, सेयो बी खुशी मनाओ!<note caller="+" style="f"><char style="fr" closed="false">97:1 </char><char style="ft" closed="false">प्रकाशित 19:7</char></note><verse eid="PSA 97:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 97:2" />प्रभुए रे चऊँ कनारे बादल़ ओर न्हेरा ए;</para>
  <para style="q" vid="PSA 97:2">तार्मिकता ओर न्याय तेसरे सिंहासनो रे मूल़ ए।<verse eid="PSA 97:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 97:3" />तेसते आगे-आगे आग चलदी ऊई</para>
  <para style="q" vid="PSA 97:3">तेसरे बरोदिया खे चऊँ कनारे ते पस्म करी देओई।<note caller="+" style="f"><char style="fr" closed="false">97:3 </char><char style="ft" closed="false">प्रकाशित 11:5</char></note><verse eid="PSA 97:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 97:4" />तेसरी बिजल़िया साथे दुनिया खे प्रयासा ओआ,</para>
  <para style="q" vid="PSA 97:4">ये देखी की तरती थरथराई गी!<verse eid="PSA 97:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 97:5" />प्रभुए री मौजुदगिया रे, मतलब सारी तरतिया रे परमेशरो री मौजुदगिया रे</para>
  <para style="q" vid="PSA 97:5">पाह्ड़ मोमो जेड़े गल़ी जाओए।<verse eid="PSA 97:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 97:6" />सर्ग प्रभुए री तार्मिकता रा एलान करोआ;</para>
  <para style="q" vid="PSA 97:6">ओर देशो-देशो रे सबी लोके तेसरी महिमा देखी।<verse eid="PSA 97:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 97:7" />जितणे माणूं कअड़ी री मूर्तिया री पूजा करोए</para>
  <para style="q" vid="PSA 97:7">ओर तिना पाँदे गर्व करोए, सेयो सब शर्मिंदा ऊणे;</para>
  <para style="q" vid="PSA 97:7">सारे देवता प्रभुए गेई माथा टेको।<verse eid="PSA 97:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 97:8" />ओ प्रभु, तेरे न्याय रे बारे जेबे सिय्योनो रे लोके सुणेया</para>
  <para style="q" vid="PSA 97:8">तेबे सेयो खुश ऊए ओर यहूदा प्रदेशो रे शईर मगन ऊए।<verse eid="PSA 97:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 97:9" />कऊँकि ओ प्रभु, तूँ सारी तरतिया पाँदे परमपरदान ए;</para>
  <para style="q" vid="PSA 97:9">तूँ सारे देवतेया ते बऊत जादा महान ठईरी रा।<note caller="+" style="f"><char style="fr" closed="false">97:9 </char><char style="ft" closed="false">यूह. 3:31</char></note><verse eid="PSA 97:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 97:10" />यहोवा तिना ते प्यार करोआ जो बुराईया ते कृणा करोए।</para>
  <para style="q" vid="PSA 97:10">से आपणे पग्ता रे प्राणा री रक्षा करोआ</para>
  <para style="q" vid="PSA 97:10">ओर तिना खे दुष्टा रे आथो ते बचाओआ।<verse eid="PSA 97:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 97:11" />परमेशरो री जोति तार्मिक माणूंआ पाँदे चमकोई।</para>
  <para style="q" vid="PSA 97:11">पले ओर इमानदार लोक खुश ऊणे।<verse eid="PSA 97:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 97:12" />यहोवा जो करोआ तीजी रिया बजा ते सब तर्मी लोक खुश ऊणे!</para>
  <para style="q" vid="PSA 97:12">ओर तेसरे पवित्र नाओं रा तन्यवाद करो!<verse eid="PSA 97:12" /></para>
  <chapter eid="PSA 97" />
  <chapter number="98" style="c" sid="PSA 98" />
  <para style="s">परमेशरो री सच्चाईया रिया तँईं स्तुतिगान</para>
  <para style="d">पजन</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 98:1" />यहोवे रिया तँईं नया गीत गाओ,</para>
  <para style="q" vid="PSA 98:1">तिने आपणी शक्ति ओर तागती ते महान ओर अचम्बे रे काम</para>
  <para style="q" vid="PSA 98:1">ओर बऊत बड़ी जीत ऊई<verse eid="PSA 98:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 98:2" />यहोवे सबी लोका खे दखाया कि तेसगे बचाणे ओर न्याय करने री सामर्थ ए,<verse eid="PSA 98:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 98:3" />यहोवे इस्राएलिया रिया तँईं आपणा उद्धार करने रा वादा पूरा कित्तेया,</para>
  <para style="q" vid="PSA 98:3">देशो-देशो रे सबी लोका रिये आखी देखेया कि म्हारा परमेशर दया करने वाल़ा ए।<note caller="+" style="f"><char style="fr" closed="false">98:3 </char><char style="ft" closed="false">लूका 1:54, प्रेरित 28:28 </char></note><verse eid="PSA 98:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 98:4" />ओ सारी तरतिया रे लोको, प्रभुए री जयजयकार करो;</para>
  <para style="q" vid="PSA 98:4">जोशो साथे जयजयकार करो, ओर पजन गाओ!<note caller="+" style="f"><char style="fr" closed="false">98:4 </char><char style="ft" closed="false">यशायाह 44:23</char></note><verse eid="PSA 98:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 98:5" />बीणा बजांदे ऊए प्रभुए रा पजन गाओ,</para>
  <para style="q" vid="PSA 98:5">बीणा बजांदे ऊए मीठिया आवाजा रे पजन सुणाओ।<verse eid="PSA 98:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 98:6" />तुरही ओर रड़सिंगे री आवाजा रे प्रभु राजे री जयजयकार करो।<verse eid="PSA 98:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 98:7" />समुद्र ओर तिजी बीचलिया सारिया चीजा;</para>
  <para style="q" vid="PSA 98:7">दुनिया ओर तिदे रणे वाल़े खुशिया साथे बड़ी आवाज करो!<verse eid="PSA 98:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 98:8" />नदिया पाणिए रा शाद करो;</para>
  <para style="q" vid="PSA 98:8">पाह्ड़ मिली की जयजयकार करो।<verse eid="PSA 98:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 98:9" />कऊँकि यहोवा तरतिया रा न्याय करने खे आऊणे वाल़ा ए।</para>
  <para style="q" vid="PSA 98:9">तेस तार्मिकता साथे दुनिया रा</para>
  <para style="q" vid="PSA 98:9">ओर सच्चाईया साथे देशो-देशो रे लोका रा न्याय करना।<note caller="+" style="f"><char style="fr" closed="false">98:9 </char><char style="ft" closed="false">प्रेरित 17:31</char></note><verse eid="PSA 98:9" /></para>
  <chapter eid="PSA 98" />
  <chapter number="99" style="c" sid="PSA 99" />
  <para style="s">पवित्रता रिया तँईं स्तुतिगान</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 99:1" />ओ यहोवा, तूँ राजा ए देशो-देशो रे लोक तांते थूरने लगी रे!</para>
  <para style="q" vid="PSA 99:1">तूँ करूबा पाँदे बैठी की राज करेआ, तरती ईलणे लगी!<note caller="+" style="f"><char style="fr" closed="false">99:1 </char><char style="ft" closed="false">यहेजकेल 1:5-14, 10:21, निर्ग. 25:11-17, 1 शमूएल 4:4, 2 शमूएल 6:2, 2 राजा 19:15, प्रकाशित 11:18, प्रकाशित 19:6</char></note><verse eid="PSA 99:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 99:2" />यहोवा सिय्योनो<note caller="+" style="f"><char style="fr" closed="false">99:2 </char><char style="ft" closed="false">यरूशलेम</char></note> रे महान ए</para>
  <para style="q" vid="PSA 99:2">ओर से देशो-देशो रे लोका पाँदे परदान ए।<verse eid="PSA 99:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 99:3" />सारे लोक प्रभुए रे महान् ओर डरो जोगे नाओं रा तन्यवाद करो!</para>
  <para style="q" vid="PSA 99:3">से पवित्र ए।<verse eid="PSA 99:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 99:4" />राजे री सामर्थ न्याय साथे मेल राखोई,</para>
  <para style="q" vid="PSA 99:4">तैंई सच्चाईया री स्थापना करी राखी;</para>
  <para style="q" vid="PSA 99:4">न्याय ओर तार्मिकता इस्राएलो दे तैंई शुरू कित्ती।<verse eid="PSA 99:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 99:5" />म्हारे प्रभु परमेशरो री सराईणा करो;</para>
  <para style="q" vid="PSA 99:5">ओर तेसरे पैरा री चौकिया सामणे माथा टेको!</para>
  <para style="q" vid="PSA 99:5">से पवित्र ए!<verse eid="PSA 99:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 99:6" />मूसा ओर हारूण प्रभुए रे पुरोईत थे;</para>
  <para style="q" vid="PSA 99:6">प्रभुए ते प्रार्थना करने वाल़ेया बीचे शमूएल था</para>
  <para style="q" vid="PSA 99:6">तिने प्रभु पुकारेया ओर प्रभुए तिना खे उत्तर दित्तेया।<verse eid="PSA 99:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 99:7" />से बादल़ो रे खम्बे रे ऊई की तिना साथे गल्ला करो था</para>
  <para style="q" vid="PSA 99:7">ओर सेयो तेसरी चतौणिया ओर तेसरी दित्ती री बिदिया पाँदे चलो थे।<verse eid="PSA 99:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 99:8" />ओ म्हारे यहोवा, तूँ तिना री सुणी लये था;</para>
  <para style="q" vid="PSA 99:8">तैं तिना रे पाप माफ कित्ते,</para>
  <para style="q" vid="PSA 99:8">पर तिना रिया गल़तिया रिया तँईं तिना खे सजा बी दित्ती।<verse eid="PSA 99:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 99:9" />म्हारे प्रभु परमेशरो री सराईणा करो,</para>
  <para style="q" vid="PSA 99:9">ओर तेसरे पवित्र पाह्ड़ो पाँदे जाई की आराधना करो;</para>
  <para style="q" vid="PSA 99:9">कऊँकि म्हारा प्रभु परमेशर पवित्र ए!<verse eid="PSA 99:9" /></para>
  <chapter eid="PSA 99" />
  <chapter number="100" style="c" sid="PSA 100" />
  <para style="s">परमेशरो री स्तुतिया रा गीत</para>
  <para style="d">तन्यवादो रा पजन</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 100:1" />ओ सारी तरतिया रे लोको,</para>
  <para style="q" vid="PSA 100:1">प्रभुए री जयजयकार करो!<verse eid="PSA 100:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 100:2" />खुशिया साथे प्रभुए री आराधना करो!</para>
  <para style="q" vid="PSA 100:2">जयजयकार करदे ऊए तेसरे सामणे आओ!<verse eid="PSA 100:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 100:3" />पक्का जाणी लओ कि प्रभु ई परमेशर ए।</para>
  <para style="q" vid="PSA 100:3">प्रभुए ई आसे बणाए ओर आसे तेसरे ईए;</para>
  <para style="q" vid="PSA 100:3">आसे तेसरी प्रजा रे लोक ओर तेसरी चराईया रिया पेडा ए।<verse eid="PSA 100:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 100:4" />तेसरे मईलो रे तन्यवाद ओर तेसरे आँगणो रे स्तुति करदे ऊए आओ,</para>
  <para style="q" vid="PSA 100:4">तेसरी सराईणा करो ओर तेसरे नाओं खे तन्य बोलो!<verse eid="PSA 100:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 100:5" />कऊँकि प्रभु परमेशर पला ए,</para>
  <para style="q" vid="PSA 100:5">तेसरी करूणा सदा-सर्वदा ओर तेसरी सच्चाई पीढ़िया ते पीढ़िया तक बणी री रओई।<verse eid="PSA 100:5" /></para>
  <chapter eid="PSA 100" />
  <chapter number="101" style="c" sid="PSA 101" />
  <para style="s">तार्मिक जिन्दगी बिताणे रा संकल्प</para>
  <para style="d">दाऊदो रा पजन</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 101:1" />ओ यहोवा, मां तेरिया दया रा ओर न्याय रा गीत बनाणा,</para>
  <para style="q" vid="PSA 101:1">ओर आँऊ ये तेरिया तँईं गाऊँआं,<verse eid="PSA 101:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 101:2" />मां अक्ला साथे खरिया बाटा रे चलणा।</para>
  <para style="q" vid="PSA 101:2">प्रभु, तूँ मांगे कदी आऊणा? मां आपणे कअरे खरा चाल-चलण राखणा।<verse eid="PSA 101:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 101:3" />मां केसी बी बुरे कामा पाँदे मन नि लगाणा।</para>
  <para style="q" vid="PSA 101:3">आऊँ बुरिया बाटा रे चलणे वाल़ेया रे कामा ते कृणा करूँआ;</para>
  <para style="q" vid="PSA 101:3">एड़े कामा रे मां नि लगणा।<verse eid="PSA 101:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 101:4" />बुरा सबाओ मांते दूर रणा;</para>
  <para style="q" vid="PSA 101:4">मां बुराईया ते बी दूर रणा।<verse eid="PSA 101:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 101:5" />जो माणूं पीछा ते आपणे पड़ोसिये री निंदा करोआ,</para>
  <para style="q" vid="PSA 101:5">तेसरा मां सत्यानाश करना; जेसरिया आखी रे कमण्ड साफ-साफ दिशोआ</para>
  <para style="q" vid="PSA 101:5">ओर जेसरा मन कमण्डी ए, से मां सईन नि करना।<verse eid="PSA 101:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 101:6" />मेरिया आखी देशो रे परोसे जोगे लोका पाँदे लगी रिया रणियां ताकि सेयो मां साथे रओ;</para>
  <para style="q" vid="PSA 101:6">जो माणूं खरिया बाटा रे चलोआ सेई मेरी सेवा करने वाल़ा ऊणा।<verse eid="PSA 101:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 101:7" />जो माणूं दूजेया खे तोखा देओए सेयो मेरे मईलो रे पीतरे नि रई सकदे;</para>
  <para style="q" vid="PSA 101:7">जो चूठ बोलोआ से मां सामणे टीकी नि सकणा।<verse eid="PSA 101:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 101:8" />मां आपणे देशो रे दुष्ट लोक हर रोज नाश करने;</para>
  <para style="q" vid="PSA 101:8">मां सब बुरे लोक यहोवे रे शईरो<note caller="+" style="f"><char style="fr" closed="false">101:8 </char><char style="ft" closed="false">यरूशलेम</char></note> ते बारे निकाल़ी देणे।<verse eid="PSA 101:8" /></para>
  <chapter eid="PSA 101" />
  <chapter number="102" style="c" sid="PSA 102" />
  <para style="s">मुसीबता रे पड़े रे नौजवानो री प्रार्थना</para>
  <para style="d">एक दु:खी माणूंए री तेस बखतो री प्रार्थना जेबे से दु:खो रे मारे आपणे शोगो रिया गल्ला प्रभुए रे सामणे खुली की बोलोआ।</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 102:1" />ओ प्रभु, मेरी प्रार्थना सुण;</para>
  <para style="q" vid="PSA 102:1">मेरा मतादा रिया तँईं रोणा तां तक पऊँचो!<verse eid="PSA 102:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 102:2" />मेरी मुसीबता रे बखते मांते नि लूकणा;</para>
  <para style="q" vid="PSA 102:2">मेरिया प्रार्थना रिया तरफा खे त्यान दे,</para>
  <para style="q" vid="PSA 102:2">ओर चट ज्वाब दे।<verse eid="PSA 102:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 102:3" />कऊँकि मेरिया जिन्दगिया रे दिन तुएँ जेड़े लोप ऊणे लगी रे</para>
  <para style="q" vid="PSA 102:3">ओर मेरी आड्डिया लकड़ूआ जेड़िया फूकी गी रिया।<verse eid="PSA 102:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 102:4" />आऊँ काओ जेड़ा मुरझाई गा रा ए,</para>
  <para style="q" vid="PSA 102:4">ओर आऊँ आपणी रोटी खाणा पूली जाऊँआ।<verse eid="PSA 102:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 102:5" />कंणदे-कंणदे आऊँ एड़ा सूकीगा कि मेरे शरीरो दे मेरी आड्डिया दिशणे लगी रिया ए।<verse eid="PSA 102:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 102:6" />आऊँ सुनसाण जगा रे धनेश पंछिए जेड़ा ऊईगा रा,</para>
  <para style="q" vid="PSA 102:6">आऊँ खण्डहरा रे उल्लूए जेड़ा बणीगा रा।<verse eid="PSA 102:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 102:7" />आऊँ जागदा रऊँआ ओर चिड़िया जेड़ा ऊईगा रा</para>
  <para style="q" vid="PSA 102:7">जो छतो पाँदे कल्ली बैठी री रओई।<verse eid="PSA 102:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 102:8" />मेरे दुश्मण लगातार मेरी निंदा करोए;</para>
  <para style="q" vid="PSA 102:8">जो मेरे बरोदो रिया धुना रे इस्साल ऊणे लगी रे,</para>
  <para style="q" vid="PSA 102:8">सेयो मेरा नाओं लई की स्राप देओए।<verse eid="PSA 102:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 102:9" />मैं रोटिया रे बदले स्वा खाई</para>
  <para style="q" vid="PSA 102:9">ओर आसू मिलाई की पाणी पियूँआ।<verse eid="PSA 102:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 102:10" />ये तेरे गुस्से ओर तेरे कोपो रिया बजा ते ऊईरा;</para>
  <para style="q" vid="PSA 102:10">कऊँकि तैं आऊँ सम्बाल़ेया ओर फेर सेटी ता रा।<verse eid="PSA 102:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 102:11" />मेरी उम्र कटदी छांयी जेड़ी ए</para>
  <para style="q" vid="PSA 102:11">ओर आऊँ आपू काओ जेड़ा सूकदा चली रा।<verse eid="PSA 102:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 102:12" />पर ओ प्रभु, तूँ सदा ई राजगद्दिया पाँदे विराजमान रणा;</para>
  <para style="q" vid="PSA 102:12">ओर तेरा नाओं पीढ़िया ते पीढ़िया तक बणेया रा रणा।<verse eid="PSA 102:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 102:13" />तां उठी की सिय्योनो पाँदे दया करनी;</para>
  <para style="q" vid="PSA 102:13">कऊँकि तेस पाँदे दया करने रा ठराया रा बखत आईगा रा।<verse eid="PSA 102:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 102:14" />तेरे दास तेस शईरो साथे प्यार करोए, चाए से नाश ई ऊईगा रा;</para>
  <para style="q" vid="PSA 102:14">तिना खे तिजी पाँदे दया आओई, चाए से खण्डहर ईए।<verse eid="PSA 102:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 102:15" />इजी बजा ते जातिया-जातिया रे लोका प्रभुए रे नाओं रा डर मानणा</para>
  <para style="q" vid="PSA 102:15">ओर तरतिया रे सारे राजा तेरे प्रतापो ते डरने।<verse eid="PSA 102:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 102:16" />कऊँकि प्रभुए सिय्योन फेर बसाई राखेया</para>
  <para style="q" vid="PSA 102:16">ओर से आपणी महिमा रे दिशोआ;<verse eid="PSA 102:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 102:17" />तेस आपणे छाडे रे लोका पाँदे त्यान करना</para>
  <para style="q" vid="PSA 102:17">ओर तिना री प्रार्थना सुणनी।<verse eid="PSA 102:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 102:18" />ये गल्ल आऊणे वाल़िया पीढ़िया खे लिखी जाणी,</para>
  <para style="q" vid="PSA 102:18">ताकि एक जाति जो पैदा ऊणी, से यहोवे री स्तुति करो।<verse eid="PSA 102:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 102:19" />कऊँकि प्रभुए आपणी ऊच्ची ओर पवित्र जगा ते नजर करी की</para>
  <para style="q" vid="PSA 102:19">स्वर्गो ते तरतिया खे देखेया,<verse eid="PSA 102:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 102:20" />ताकि से बन्दिया रा कणना सुणो</para>
  <para style="q" vid="PSA 102:20">ओर मौता री सजा पाए रेया खे आजाद करो;<verse eid="PSA 102:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PSA 102:21" />तेबे लोका सिय्योनो रे प्रभुए रे नाओं रा बखाण करना</para>
  <para style="q" vid="PSA 102:21">ओर यरूशलेमो रे तेसरी स्तुति करनी;<verse eid="PSA 102:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="PSA 102:22" />ये तेस बखते ऊणा जेबे देश-देश</para>
  <para style="q" vid="PSA 102:22">ओर राज्य-राज्य रे लोक प्रभुए री आराधना करने खे कट्ठे ऊणे।<verse eid="PSA 102:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="PSA 102:23" />तैं यहोवे आऊँ जवानिया देई कमजोर करिता दा ए,</para>
  <para style="q" vid="PSA 102:23">ओर तैं मेरी तागत ओर मेरी उम्रा रे दिन बी कम करीते।<verse eid="PSA 102:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="PSA 102:24" />मैं बोलेया, “ओ मेरे परमेशर!</para>
  <para style="q" vid="PSA 102:24">तेरी उम्र पीढ़िया ते पीढ़िया तक बणी री रणी,</para>
  <para style="q" vid="PSA 102:24">तूँ माखे आदिया उम्रा रे नि चकेया।”<verse eid="PSA 102:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="PSA 102:25" />शुरूओ तेई तैं तरतिया री निऊँ पाई</para>
  <para style="q" vid="PSA 102:25">ओर सर्ग तेरे आथो रा बणाया राए।<verse eid="PSA 102:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="PSA 102:26" />तरती ओर सर्ग सब नाश ऊई जाणे, पर तूँ सदा बणेया रा रणा;</para>
  <para style="q" vid="PSA 102:26">ओर सेयो सब टाल्लेया जेड़े पुराणे ऊई जाणे।</para>
  <para style="q" vid="PSA 102:26">तां सेयो टाल्लेया जेड़े बदल़ने, इजी खे सेयो बदली जाणे;<verse eid="PSA 102:26" /></para>
  <para style="q">
    <verse number="27" style="v" sid="PSA 102:27" />पर तूँ तेथी ए ओर तेरे साला रा अन्त नि ऊणा।<verse eid="PSA 102:27" /></para>
  <para style="q">
    <verse number="28" style="v" sid="PSA 102:28" />तेरे दासा री ल्वाद सई-सलामत बणी री रणी</para>
  <para style="q" vid="PSA 102:28">ओर तिना रा वंश तां सामणे बणेया रा रणा।<verse eid="PSA 102:28" /></para>
  <chapter eid="PSA 102" />
  <chapter number="103" style="c" sid="PSA 103" />
  <para style="s">परमेशरो रा प्यार</para>
  <para style="d">दाऊदो रा पजन</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 103:1" />ओ मेरे मन, प्रभुए खे तन्य बोल ओर जो कुछ मांदे ए,</para>
  <para style="q" vid="PSA 103:1">से तेसरे पवित्र नाओं खे तन्य बोलो!<verse eid="PSA 103:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 103:2" />ओ मेरे मन, प्रभुए खे तन्य बोल</para>
  <para style="q" vid="PSA 103:2">ओर तेसरे केसी उपकारो खे नि पूलेया!<verse eid="PSA 103:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 103:3" />सेई तो तेरे सारे पाप माफ करोआ</para>
  <para style="q" vid="PSA 103:3">ओर तेरी सारिया बमारिया खे ठीक करोआ।<verse eid="PSA 103:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 103:4" />यहोवा ई माखे मरने ते बचाओआ,</para>
  <para style="q" vid="PSA 103:4">ओर साथे ई माखे प्यार ओर दया री आशीष देओआ,<verse eid="PSA 103:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 103:5" />सेई मेरे जीवनो खे खरिया चीजा ते परी देओआ,</para>
  <para style="q" vid="PSA 103:5">कि आऊँ उकाब पंछिये जेड़ा जवान ओर तागतबर बणया रा रऊँ।<note caller="+" style="f"><char style="fr" closed="false">103:5 </char><char style="ft" closed="false">यशायाह 40:31</char></note><verse eid="PSA 103:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 103:6" />यहोवा सारे दु:खी कमजोर माणूंआ री खातर तर्म</para>
  <para style="q" vid="PSA 103:6">ओर न्याय रे काम करोआ।<verse eid="PSA 103:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 103:7" />तिने मूसे खे आपणी योजना बताई</para>
  <para style="q" vid="PSA 103:7">ओर इस्राएलिया री ल्वादा पाँदे आपणे काम प्रगट कित्ते।<note caller="+" style="f"><char style="fr" closed="false">103:7 </char><char style="ft" closed="false">पजन 147:19</char></note><verse eid="PSA 103:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 103:8" />प्रभु दयालु ओर कृपा करने वाल़ा, देरा ते गुस्सा करने वाल़ा</para>
  <para style="q" vid="PSA 103:8">ओर बऊत ई करूणा करने वाल़ा ए।<note caller="+" style="f"><char style="fr" closed="false">103:8 </char><char style="ft" closed="false">पजन 86:15, पजन 145:8</char></note><verse eid="PSA 103:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 103:9" />तेस सदा बकदे ई नि रणा,</para>
  <para style="q" vid="PSA 103:9">ना ई तेसरा गुस्सा सदा खे पड़केया दा रणा।<verse eid="PSA 103:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 103:10" />तिने म्हारे पापो रे मुताबिक आसा साथे बर्ताव नि कित्तेया</para>
  <para style="q" vid="PSA 103:10">ओर ना ई म्हारे बुरे कामा रे मुताबिक आसा ते बदला लया।<verse eid="PSA 103:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 103:11" />सर्ग तरतिया पाँदे जितणा ऊच्चा ए,</para>
  <para style="q" vid="PSA 103:11">तितणी ई तेसरी महान करूणा तेसरे पग्ता पाँदे ए।<verse eid="PSA 103:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 103:12" />पूर्व पच्छमा ते जितणा दूर ए,</para>
  <para style="q" vid="PSA 103:12">तिने म्हारे पाप आसा ते तितणे ई दूर करीते रे।<verse eid="PSA 103:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 103:13" />जेड़ी दया बाओ आपणे बाल़का पाँदे करोआ,</para>
  <para style="q" vid="PSA 103:13">प्रभु बी आपणे पग्ता पाँदे तेड़ी ई दया करोआ।<verse eid="PSA 103:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 103:14" />कऊँकि से म्हारी रचना जाणोआ कि आसे किंयाँ बणी रे</para>
  <para style="q" vid="PSA 103:14">ओर तेसखे याद ए कि माणूं माट्टी ईए।<verse eid="PSA 103:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 103:15" />माणूंए री उम्र काओ जेड़ी ओई,</para>
  <para style="q" vid="PSA 103:15">से मैदानो रे फूलो जेड़ा फूलोआ;<verse eid="PSA 103:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 103:16" />जो पऊण लगदे ई ठईरी नि सकदा</para>
  <para style="q" vid="PSA 103:16">ओर ना ई से आपणी जगा रे फेर मिलदा।<verse eid="PSA 103:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 103:17" />पर तिना खे जो यहोवे रा आदर करोए, तेसरी करूणा सदा तक बणी दी रणी,</para>
  <para style="q" vid="PSA 103:17">ओर तेसरी पलाई पीढ़िया ते पीढ़िया तक बणी रणी।<note caller="+" style="f"><char style="fr" closed="false">103:17 </char><char style="ft" closed="false">लूक 1:50</char></note><verse eid="PSA 103:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 103:18" />जो तेसरी वाचा खे पूरा करोए</para>
  <para style="q" vid="PSA 103:18">ओर तेसरे उपदेश याद करी की तिना खे मानोए।<verse eid="PSA 103:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 103:19" />प्रभुए तो आपणा सिंहासन स्वर्गो रे स्थिर करी राखेया</para>
  <para style="q" vid="PSA 103:19">ओर तेसरा राज्य पुरिया सृष्टिया पाँदे ए।<verse eid="PSA 103:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 103:20" />ओ प्रभुए रे स्वर्गदूतो, तुसे जो महान शक्तिशाली ए</para>
  <para style="q" vid="PSA 103:20">ओर तुसे जो तेसरा वचन सुणी की तिजी रे मुताबिक काम करोए,</para>
  <para style="q" vid="PSA 103:20">प्रभुए खे तन्य बोलो!<verse eid="PSA 103:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PSA 103:21" />ओ प्रभुए री सारी स्वर्गिय सेना,<note caller="+" style="f"><char style="fr" closed="false">103:21 </char><char style="ft" closed="false">स्वर्गदूत</char></note></para>
  <para style="q" vid="PSA 103:21">तेसरी इच्छा खे पूरी करने वाल़े सारे सेवको, प्रभुए खे तन्य बोलो!<verse eid="PSA 103:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="PSA 103:22" />ओ प्रभुए री सारी सृष्टि,</para>
  <para style="q" vid="PSA 103:22">तेसरे राज्य री सारिया जगा रे प्रभुए खे तन्य बोलो।</para>
  <para style="q" vid="PSA 103:22">ओ मेरे मन, तूँ प्रभुए खे तन्य बोल!<verse eid="PSA 103:22" /></para>
  <chapter eid="PSA 103" />
  <chapter number="104" style="c" sid="PSA 104" />
  <para style="s">सृष्टि करने वाल़े री स्तुति</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 104:1" />आऊँ आपणे आपू ते बोलूँआ, “यहोवे री स्तुति करो!”</para>
  <para style="q" vid="PSA 104:1">यहोवा, मेरे परमेशर, तूँ बऊत महान ए!</para>
  <para style="q" vid="PSA 104:1">तूँ एक महान राजे रे रूपो दे अक्को साथे शासन करेआ।<verse eid="PSA 104:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 104:2" />तूँ प्रयासे खे चाद्दरी जेड़ा टखी राखोआ</para>
  <para style="q" vid="PSA 104:2">ओर सर्गो खे तम्बूए जेड़ा ताणी की राखोआ,<verse eid="PSA 104:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 104:3" />तैं आपणे कअरो रे खम्बे बन्दे पाणिए पाँदे खड़े करी राखे।</para>
  <para style="q" vid="PSA 104:3">ओर बादल़ा खे आपणा रथ बणाओआ</para>
  <para style="q" vid="PSA 104:3">ओर पऊणी रे पंखा पाँदे सवारी करोआ,<verse eid="PSA 104:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 104:4" />तूँ पऊणी खे आपणे दूत ओर धधकती आगी खे</para>
  <para style="q" vid="PSA 104:4">आपणी सेवा करने वाल़े दूत बणाओआ।<note caller="+" style="f"><char style="fr" closed="false">104:4 </char><char style="ft" closed="false">इब्रानी 1:7</char></note><verse eid="PSA 104:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 104:5" />तैं तरती तिजी रिया निऊँआ पाँदे खड़ी करी राखी,</para>
  <para style="q" vid="PSA 104:5">ताकि से जुगो-जुगो तक नि डगमगाओ।<verse eid="PSA 104:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 104:6" />तैं तरती टाल्ले जेड़ी गईरे पाणिए साथे टखी ती;</para>
  <para style="q" vid="PSA 104:6">पाणिए पाह्ड़ चूँडिया तक टकी ते दे।<verse eid="PSA 104:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 104:7" />तेरे डांटणे ते समुद्र नठीगा,</para>
  <para style="q" vid="PSA 104:7">तेरे गिड़ने री आवाज सुणदे ई से अड़बड़िया साथे बह्यींदा चलीगा।<verse eid="PSA 104:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 104:8" />पाणी पाह्ड़ा पाँदिए चढ़ी की बह्यींदा ऊआ काअटिया रिया बाटा ते तेते जगा रे उतरी गा,</para>
  <para style="q" vid="PSA 104:8">जो तैं तेसखे त्यार करी की ठराई राखेया।<verse eid="PSA 104:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 104:9" />तैं पाणिए खे एक बन्ना ठराया, जेतेखे से लंगी नि सकदा</para>
  <para style="q" vid="PSA 104:9">ओर ना फिरी की मैदानो खे टखी सकोआ।<verse eid="PSA 104:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 104:10" />तूँ चरनेया खे काअटिया रे बाह्या,</para>
  <para style="q" vid="PSA 104:10">सेयो पाह्ड़ा बीचे बह्ओए,<verse eid="PSA 104:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 104:11" />तिना ते मैदानो रे सारे जीव-जन्तु पाणी पियोए,</para>
  <para style="q" vid="PSA 104:11">बणो रे गह्दे बी आपणी त्याय मटयाई लओए।<verse eid="PSA 104:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 104:12" />तेसा नदिया रे कनारे डाल़ा दे</para>
  <para style="q" vid="PSA 104:12">पंछी रणे खे कोअले बणाओए ओर गीत गांदे रओए।<note caller="+" style="f"><char style="fr" closed="false">104:12 </char><char style="ft" closed="false">मत्ती 13:32</char></note><verse eid="PSA 104:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 104:13" />तूँ आपणी रणे रिया जगा दे ऊबा ते पाह्ड़ा पाँदे बरखा करदा रएया,</para>
  <para style="q" vid="PSA 104:13">तेरे कामा रे फलो ते तरती सन्तुष्ट रओई।<verse eid="PSA 104:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 104:14" />तूँ डांगरा खे काआ ओर माणूंआ रे कामा रिया तँईं नज्ज पैदा करेया</para>
  <para style="q" vid="PSA 104:14">ओर ईंयाँ जमीना ते माणूं खाणे रिया चीजा पैदा करोआ,<verse eid="PSA 104:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 104:15" />ओर अंगूरा रा रस जेते की माणूंआ रा मन खुश ऊई जाओआ</para>
  <para style="q" vid="PSA 104:15">ओर मुंए खे चमकाणे रिया तँईं तेल, ओर नज्ज,</para>
  <para style="q" vid="PSA 104:15">जेते साथे तेसखे तागत मिलोई।<verse eid="PSA 104:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 104:16" />प्रभुए रे डाल़ जो तिने लगाई राखे,</para>
  <para style="q" vid="PSA 104:16">लबानोन प्रदेशो रे देवदारा रे डाल़ पाणिए साथे तृप्त रओए।<verse eid="PSA 104:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 104:17" />तिना दे चिड़िया आपणा कोअला बणाओईया;</para>
  <para style="q" vid="PSA 104:17">सारसो रा बसेरा केली रे डाल़ा रे ओआ।<verse eid="PSA 104:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 104:18" />जंगल़ी बाकरेया खे ऊच्चे पाह्ड़ ए</para>
  <para style="q" vid="PSA 104:18">ओर चट्टानी शापाना री रणे रिया जगा ए।<verse eid="PSA 104:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 104:19" />तिने ठराए रे बखतो खे चाँद बणाया;</para>
  <para style="q" vid="PSA 104:19">सूरज आपणा छपणे रा बखत जाणोआ।<verse eid="PSA 104:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 104:20" />तूँ न्हेरा करेया, तेबे रात ऊई जाओई;</para>
  <para style="q" vid="PSA 104:20">जिदे बणो रे सारे जीव-जन्तु कूमो-फिरोए।<verse eid="PSA 104:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PSA 104:21" />जवान शेर शकारो रिया तँईं गुर्राओए</para>
  <para style="q" vid="PSA 104:21">ओर परमेशरो ते आपणा शकार माँगोए।<verse eid="PSA 104:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="PSA 104:22" />त्याड़ा निकल़दे ई सेयो चली जाओए</para>
  <para style="q" vid="PSA 104:22">ओर आपणियां गुफा रे जाई की बैठी जाओए।<verse eid="PSA 104:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="PSA 104:23" />तेबे माणूं आपणे कामा रिया तँईं,</para>
  <para style="q" vid="PSA 104:23">साँजा तक मईणत करने खे निकल़ोआ।<verse eid="PSA 104:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="PSA 104:24" />ओ यहोवा, तेरे काम अणगिणत ए!</para>
  <para style="q" vid="PSA 104:24">यो सब चीजा तैं आपणी अक्ला साथे बणाई राखिया;</para>
  <para style="q" vid="PSA 104:24">तेरे जरिए बणाई रिया सारिया चीजा ते तरती परिपूर्ण ए।<verse eid="PSA 104:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="PSA 104:25" />ईंयाँ ई समुद्र कितणा बड़ा ओर बऊत ई चौड़ा ए</para>
  <para style="q" vid="PSA 104:25">ओर तिदे अणगिणत पाणिए बीचे लूरने वाल़े जीव-जन्तु,</para>
  <para style="q" vid="PSA 104:25">छोटे-बड़े सारे परी रे।<verse eid="PSA 104:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="PSA 104:26" />तिदे पाणिए बीचे चलणे वाल़े जाह्ज बी आओ जाओए</para>
  <para style="q" vid="PSA 104:26">ओर लिब्यातान<note caller="+" style="f"><char style="fr" closed="false">104:26 </char><char style="fq" closed="false">लिब्यातान </char><char style="ft" closed="false">समुद्रो दे रणे वाल़ा दानव</char></note> बी, जो तैं तिदे खेलणे रिया तँईं बणाई राखेया।<verse eid="PSA 104:26" /></para>
  <para style="q">
    <verse number="27" style="v" sid="PSA 104:27" />इना सबी खे तेरा ई आसरा ए,</para>
  <para style="q" vid="PSA 104:27">ताकि तूँ इना खे बखतो-बखतो पाँदे खाणे खे देया करे।<verse eid="PSA 104:27" /></para>
  <para style="q">
    <verse number="28" style="v" sid="PSA 104:28" />जेबे तूँ तिना खे खाणे खे देओआ तेबे सेयो तिजी खे कट्ठा करी लओए;</para>
  <para style="q" vid="PSA 104:28">जेबे तूँ आपणी मुट्ठी खोलेया तेबे सेयो खरिया चीजा साथे रजी जाओए।<verse eid="PSA 104:28" /></para>
  <para style="q">
    <verse number="29" style="v" sid="PSA 104:29" />जेबे तूँ तिना ते आपणा मूँ फेरी लएया;</para>
  <para style="q" vid="PSA 104:29">तेबे सेयो कबराई जाओए; जेबे तूँ तिना रा साआ वापस लई लएया</para>
  <para style="q" vid="PSA 104:29">तेबे सेयो मरी जाओए ओर माट्टिया रे फेर मिली जाओए।<verse eid="PSA 104:29" /></para>
  <para style="q">
    <verse number="30" style="v" sid="PSA 104:30" />फेर तूँ आपणा आत्मा<note caller="+" style="f"><char style="fr" closed="false">104:30 </char><char style="ft" closed="false">साआ</char></note> पेजेया तेबे सेयो पैदा कित्ते जाओए</para>
  <para style="q" vid="PSA 104:30">ओर तरती तिना साथे फेर परी जाओई ओर नवीं बणी जाओई।<verse eid="PSA 104:30" /></para>
  <para style="q">
    <verse number="31" style="v" sid="PSA 104:31" />प्रभुए री महिमा सदा ऊँदी रओ,</para>
  <para style="q" vid="PSA 104:31">प्रभु आपणे कामे की खुश ओ!<verse eid="PSA 104:31" /></para>
  <para style="q">
    <verse number="32" style="v" sid="PSA 104:32" />से तरतिया पाँदे नजर करोआ</para>
  <para style="q" vid="PSA 104:32">ओर तरती थरथराई जाओई ओर तेसरे पाह्ड़ा खे छूँदे ई पाह्ड़ा ते तुआँ निकल़ोआ।<verse eid="PSA 104:32" /></para>
  <para style="q">
    <verse number="33" style="v" sid="PSA 104:33" />जदुए तक आँऊ जिऊँदा ए, मां प्रभुए रिया तँईं गीत गांदे रणा,</para>
  <para style="q" vid="PSA 104:33">जदुए तक आऊँ बणेया रा रणा तदुए तक मां आपणे परमेशरो रा पजन गांदे रणा।<verse eid="PSA 104:33" /></para>
  <para style="q">
    <verse number="34" style="v" sid="PSA 104:34" />मेरा त्यान करना प्रभुए खे प्यारा लगो,</para>
  <para style="q" vid="PSA 104:34">कऊँकि आऊँ तो प्रभुए रिया बजा ते खुश रणा।<verse eid="PSA 104:34" /></para>
  <para style="q">
    <verse number="35" style="v" sid="PSA 104:35" />पापी लोका रा तरतिया पाँदा ते अन्त ऊई जाणा,</para>
  <para style="q" vid="PSA 104:35">ओर दुष्ट लोक आगो खे नि रणे!</para>
  <para style="q" vid="PSA 104:35">ओ मेरे मन प्रभुए खे तन्य बोल! यहोवे री स्तुति करो!<verse eid="PSA 104:35" /></para>
  <chapter eid="PSA 104" />
  <chapter number="105" style="c" sid="PSA 105" />
  <para style="s">परमेशर ओर तेसरे लोक</para>
  <para style="r">(<ref loc="1CH 16:8-22">1 इतिआस 16:8-22</ref>)</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 105:1" />प्रभुए रा तन्यवाद करो, तेसते प्रार्थना करो,</para>
  <para style="q" vid="PSA 105:1">देशो-देशो रे लोका बीचे तेसरे सारेया कामा रा प्रचार करो!<verse eid="PSA 105:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 105:2" />प्रभुए रिया तँईं गीत गाओ, तेसरा पजन गाओ,</para>
  <para style="q" vid="PSA 105:2">तेसरे सारे अचम्बे रे कामा रे बारे दे सबी खे बताओ।<verse eid="PSA 105:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 105:3" />तुसे तेसरे पवित्र नाओं री तारीफ करो,</para>
  <para style="q" vid="PSA 105:3">यहोवे खे टोल़ने वाल़ेया रा दिल खुश ओ!<verse eid="PSA 105:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 105:4" />यहोवे ते मतादा रिया तँईं बोलो;</para>
  <para style="q" vid="PSA 105:4">हमेशा तेसरी जयजयकार करदे रओ।<verse eid="PSA 105:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 105:5" />तेसरे अचम्बे रे कामा खे, जो तिने कित्ते, याद करो,</para>
  <para style="q" vid="PSA 105:5">तेसरे चमत्कार ओर कित्ते रे फैंसले याद करो!<verse eid="PSA 105:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 105:6" />ओ प्रभुए रे दास अब्राहमो रे वंशजो,</para>
  <para style="q" vid="PSA 105:6">ओ याकूबो रे बच्चेयो, तुसे तो तेसरे चूणे रे ए!<verse eid="PSA 105:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 105:7" />सेई म्हारा प्रभु परमेशर ए;</para>
  <para style="q" vid="PSA 105:7">सारिया तरतिया पाँदे तेसरे फैंसले ओए।<verse eid="PSA 105:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 105:8" />से आपणी वाचा खे, तेस वचनो खे</para>
  <para style="q" vid="PSA 105:8">जो तिने ह्जार पीढ़िया खे देई राखेया, सदा याद राखोआ।<verse eid="PSA 105:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 105:9" />अब्राहमो साथे बानी री वाचा खे</para>
  <para style="q" vid="PSA 105:9">ओर इसहाको साथे खाई री आपणी कसमा खे प्रभु याद राखोआ।<note caller="+" style="f"><char style="fr" closed="false">105:9 </char><char style="ft" closed="false">लूक 1:72,73</char></note><verse eid="PSA 105:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 105:10" />ओर सेई तिने याकूबो खे बिधि-बिदान</para>
  <para style="q" vid="PSA 105:10">ओर इस्राएलो रिया तँईं सदा री वाचा ठराई,<verse eid="PSA 105:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 105:11" />तिने ये बोलेया, “मां कनान देश ताखे ई देणा;</para>
  <para style="q" vid="PSA 105:11">से बांडणे दे सदा खे तेरा ओर तेरे वंशो रा रणा।”<verse eid="PSA 105:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 105:12" />तेस बखते परमेशरो रे लोक गिणतिया रे थोड़े थे,</para>
  <para style="q" vid="PSA 105:12">सेयो कनानो दे परदेशिया जेड़े रओ थे।<verse eid="PSA 105:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 105:13" />सेयो एकी देशो ते दूजे देशो दे</para>
  <para style="q" vid="PSA 105:13">ओर एकी राज्य ते दूजे राज्य रे पटकदे रये।<verse eid="PSA 105:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 105:14" />पर यहोवे केसी बी माणूंए खे तिना पाँदे अन्देर नि करने दित्तेया</para>
  <para style="q" vid="PSA 105:14">ओर से राजेया खे तिना रिया खातर ये तमकी देओ था,<verse eid="PSA 105:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 105:15" />तिने बोलेया “मेरे अभिषिक्ता खे नि छूणा</para>
  <para style="q" vid="PSA 105:15">ओर ना ई मेरे नबिया रा अनिष्ट करना!”<verse eid="PSA 105:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 105:16" />तेबे यहोवे कनान देशो रे अकाल़ पेजेया</para>
  <para style="q" vid="PSA 105:16">ओर नज्जो रे सारे पण्डार खाली करीते।<verse eid="PSA 105:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 105:17" />तेबे तिने यूसुफ नाओं रा एक मर्द तिना ते पईले पेजेया था,</para>
  <para style="q" vid="PSA 105:17">जो दास ऊणे खे बेचेया था।<verse eid="PSA 105:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 105:18" />लोके तेसरे पैरा रे बेड़िया पाई की तेसखे दु:ख दित्तेया,</para>
  <para style="q" vid="PSA 105:18">से लोए रे साँगल़ो साथे बानेया;<verse eid="PSA 105:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 105:19" />जदुए तक की तेसरी गल्ल पूरी नि ऊई,</para>
  <para style="q" vid="PSA 105:19">तदुए तक प्रभुए रा वचन तेसखे कसौटिया पाँदे गूड़दा रया।<verse eid="PSA 105:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 105:20" />तिजी ते बाद मिस्रो रे राजे सिपाई पेजी की से छुड़ाईता</para>
  <para style="q" vid="PSA 105:20">ओर प्रजा पाँदे राज करने वाल़े से इना बन्दना ते छुड़ाया;<verse eid="PSA 105:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PSA 105:21" />मिस्रो रे राजे यूसुफ आपणे मईलो रा मालक</para>
  <para style="q" vid="PSA 105:21">ओर आपणियां सारिया जायदाता रा अधिकारी ठराया,<note caller="+" style="f"><char style="fr" closed="false">105:21 </char><char style="ft" closed="false">प्रेरित 7:10</char></note><verse eid="PSA 105:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="PSA 105:22" />ताकि से आपणी इच्छा रे मुताबिक तेसरे परदाना खे उक्म देओ</para>
  <para style="q" vid="PSA 105:22">ओर तेसरे बुजुर्गा खे ज्ञान सिखाओ।<verse eid="PSA 105:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="PSA 105:23" />तेबे इस्राएल मिस्र देशो रे आया</para>
  <para style="q" vid="PSA 105:23">ओर याकूब हामो रे प्रदेशो रे परदेशी रया।<verse eid="PSA 105:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="PSA 105:24" />यहोवे आपणे लोक गिणतिया रे बऊत जादा बढ़ाए</para>
  <para style="q" vid="PSA 105:24">ओर तेसरे दुश्मणा ते जादा सेयो तागतबर बणाए।<verse eid="PSA 105:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="PSA 105:25" />तेबे प्रभुए मिस्र देशो रे रणे वाल़ेया रा मन एड़ा फेरी ता</para>
  <para style="q" vid="PSA 105:25">कि सेयो तेसरे निज लोका साथे बैर राखणे लगे</para>
  <para style="q" vid="PSA 105:25">ओर तेसरे दासा साथे छल-कपट करने लगे।<verse eid="PSA 105:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="PSA 105:26" />तेबे यहोवे मूसा ओर हारूण पेजे जो यहोवे चूणी राखे थे।<verse eid="PSA 105:26" /></para>
  <para style="q">
    <verse number="27" style="v" sid="PSA 105:27" />तिने दुँईं जणेया मिस्री लोका बीचे प्रभुए रे चिह्न दखाए</para>
  <para style="q" vid="PSA 105:27">ओर हामो रे देशो दे चमत्कार दखाए।<verse eid="PSA 105:27" /></para>
  <para style="q">
    <verse number="28" style="v" sid="PSA 105:28" />यहोवे तेस देशो दे अन्दकूप न्हेरा कित्तेया,</para>
  <para style="q" vid="PSA 105:28">पर तेबे बी मिस्रो रे लोक यहोवे रिया गल्ला नि माने।<verse eid="PSA 105:28" /></para>
  <para style="q">
    <verse number="29" style="v" sid="PSA 105:29" />परमेशरे मिस्रिया रा पाणी खूनो रे बदली ता</para>
  <para style="q" vid="PSA 105:29">ओर तिना रिया मछलिया काई तिया।<verse eid="PSA 105:29" /></para>
  <para style="q">
    <verse number="30" style="v" sid="PSA 105:30" />मिनके तिना री जमीना दे,</para>
  <para style="q" vid="PSA 105:30">बल्कि तिना रे राजे रे मईलो रे बी परी गे।<verse eid="PSA 105:30" /></para>
  <para style="q">
    <verse number="31" style="v" sid="PSA 105:31" />परमेशरे आज्ञा दित्ती, तेबे माखा रे चूण्ड आईगे</para>
  <para style="q" vid="PSA 105:31">ओर तिना रे सारे देशो रे पऊँरी रे चूण्ड आईगे।<verse eid="PSA 105:31" /></para>
  <para style="q">
    <verse number="32" style="v" sid="PSA 105:32" />प्रभुए तिना खे बर्खा रे बदले आणी रे गोल़े</para>
  <para style="q" vid="PSA 105:32">ओर तिना रे देशो रे धधकती आग बरसाई।<verse eid="PSA 105:32" /></para>
  <para style="q">
    <verse number="33" style="v" sid="PSA 105:33" />प्रभुए तिना रिया अंगूरा रिया बेला</para>
  <para style="q" vid="PSA 105:33">ओर दाऊगल़े रे डाल़ नाश करीते,</para>
  <para style="q" vid="PSA 105:33">बल्कि तिना रे देशो रे सारे डाल़ तोड़ी ते।<verse eid="PSA 105:33" /></para>
  <para style="q">
    <verse number="34" style="v" sid="PSA 105:34" />प्रभुए आज्ञा दित्ती तेबे अणगिणत टिड्डिया</para>
  <para style="q" vid="PSA 105:34">ओर कीड़े आईगे,<verse eid="PSA 105:34" /></para>
  <para style="q">
    <verse number="35" style="v" sid="PSA 105:35" />ओर तिने तिना रे देशो रा सारा नज्ज खाईता</para>
  <para style="q" vid="PSA 105:35">ओर तिना री जमीना रे सारे फल़ चट करीते।<verse eid="PSA 105:35" /></para>
  <para style="q">
    <verse number="36" style="v" sid="PSA 105:36" />परमेशरे तिना रे देशो रे सब जेठे बच्चे,</para>
  <para style="q" vid="PSA 105:36">तिना री तागती रे पईले फल़ नाश करीते।<verse eid="PSA 105:36" /></para>
  <para style="q">
    <verse number="37" style="v" sid="PSA 105:37" />तेबे यहोवे सूईने-चाँदिए साथे इस्राएली गुलामिया ते बारे निकयाल़े</para>
  <para style="q" vid="PSA 105:37">ओर तिना बीचे कोई बी कमजोर नि था।<verse eid="PSA 105:37" /></para>
  <para style="q">
    <verse number="38" style="v" sid="PSA 105:38" />तिना रे जाणे ते मिस्रो रे रणे वाल़े खुश ऊईगे,</para>
  <para style="q" vid="PSA 105:38">कऊँकि इस्राएलिया रा डर तिना रे पीतरे बसी गा था।<verse eid="PSA 105:38" /></para>
  <para style="q">
    <verse number="39" style="v" sid="PSA 105:39" />प्रभुए तिना खे छांयी रिया तँईं बादल़ फैलाया</para>
  <para style="q" vid="PSA 105:39">ओर राती खे प्रयासा देणे खे आग प्रगट कित्ती।<verse eid="PSA 105:39" /></para>
  <para style="q">
    <verse number="40" style="v" sid="PSA 105:40" />इस्राएलिए खाणे खे मांगेया ओर परमेशरे बटेरा पऊँचाईया;</para>
  <para style="q" vid="PSA 105:40">प्रभुए सेयो स्वर्गिय रोटिया साथे तृप्त कित्ते।<note caller="+" style="f"><char style="fr" closed="false">105:40 </char><char style="ft" closed="false">यूह. 6:31</char></note><verse eid="PSA 105:40" /></para>
  <para style="q">
    <verse number="41" style="v" sid="PSA 105:41" />यहोवे चट्टान तोड़ी की पाणी निकयाल़ेया</para>
  <para style="q" vid="PSA 105:41">ओर सूकिया जमीना दे नदी बह्यीणे लगी।<verse eid="PSA 105:41" /></para>
  <para style="q">
    <verse number="42" style="v" sid="PSA 105:42" />परमेशरे आपणे दास अब्राहमो रिया तँईं</para>
  <para style="q" vid="PSA 105:42">आपणे पवित्र वचन याद राखे।<verse eid="PSA 105:42" /></para>
  <para style="q">
    <verse number="43" style="v" sid="PSA 105:43" />प्रभु आपणे निज लोका खे खुशिया साथे</para>
  <para style="q" vid="PSA 105:43">ओर आपणे चूणे रेया खे जयजयकारो साथे निकयाल़ी की लई आया।<verse eid="PSA 105:43" /></para>
  <para style="q">
    <verse number="44" style="v" sid="PSA 105:44" />ओर परमेशरे इस्राएलिया खे दूजी जातिया रे देश दित्ते</para>
  <para style="q" vid="PSA 105:44">ओर सेयो ओरी लोका री मईणता रे फल़ो रे अक्कदार बणाईते,<verse eid="PSA 105:44" /></para>
  <para style="q">
    <verse number="45" style="v" sid="PSA 105:45" />तिने एड़ा इजी खे कित्तेया ताकि सेयो तेसरे नियमा रे मुताबिक आपणा जीवन जियो,</para>
  <para style="q" vid="PSA 105:45">तेसरिया सबी आज्ञा खे आपणे मनो दे याद राखो। यहोवे री सदा जयजयकार ऊँदी रओ।<verse eid="PSA 105:45" /></para>
  <chapter eid="PSA 105" />
  <chapter number="106" style="c" sid="PSA 106" />
  <para style="s">परमेशरो रिया तँईं इस्राएलो रा अविश्वास</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 106:1" />यहोवे री स्तुति करो! प्रभुए रा तन्यवाद करो,</para>
  <para style="q" vid="PSA 106:1">कऊँकि से पला ए ओर तेसरी करूणा सदा री ए!<verse eid="PSA 106:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 106:2" />यहोवे रे पराक्रमो रे कामा खे कुण बताई सकोआ</para>
  <para style="q" vid="PSA 106:2">या तेसरा पूरा गुणगाण कुण सुणाई सकोआ?<verse eid="PSA 106:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 106:3" />सेयो लोक तन्य ए, जो तेसरी आज्ञा रा पाल़न करोए,</para>
  <para style="q" vid="PSA 106:3">जो हमेशा सई काम करोए<verse eid="PSA 106:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 106:4" />ओ प्रभु, जेबे तूँ आपणे निज लोका पाँदे खुशिया ते कृपा करेगा</para>
  <para style="q" vid="PSA 106:4">तेबे माखे बी याद करेया;</para>
  <para style="q" vid="PSA 106:4">मेरा उद्धार करने रिया तँईं मेरी सम्बाल़ लओ,<verse eid="PSA 106:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 106:5" />ताकि आऊँ तेरे चुणेया रे लोका रा कल्याण देखी सकूँ</para>
  <para style="q" vid="PSA 106:5">ओर तेरिया प्रजा रे लोका रिया खुशिया रे खुश ऊई सकूँ</para>
  <para style="q" vid="PSA 106:5">ओर तेरे निज पाअगो साथे तारीफ करी सकूँ।<verse eid="PSA 106:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 106:6" />आसे तो आपणे बुजुर्गा जेड़ा पाप करी राखेया,</para>
  <para style="q" vid="PSA 106:6">आसे बुरे काम कित्ते, आसे दुष्टता करी राखी!<verse eid="PSA 106:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 106:7" />जेबे म्हारे बुजुर्ग मिस्र देशो रे थे तिने तेरे अचम्बे रे काम नि समजे,</para>
  <para style="q" vid="PSA 106:7">ना तिने तेरी अपार करूणा याद राखी;</para>
  <para style="q" vid="PSA 106:7">तिने समुद्रो रे कनारे पाँदे, मतलब लाल समुद्रो रे कनारे पाँदे बगावत कित्ती।<verse eid="PSA 106:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 106:8" />तेबे बी प्रभु, तैं आपणे नाओं रिया तैंई सेयो बचाए,</para>
  <para style="q" vid="PSA 106:8">ताकि तिना पाँदे आपणे पराक्रमो खे प्रगट करो।<verse eid="PSA 106:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 106:9" />प्रभु, तैं लाल समुद्र डांटेया ओर से सूकीगा</para>
  <para style="q" vid="PSA 106:9">ओर तूँ आपणियां प्रजा खे डूगे समुद्रो बिछिए ईंयाँ निकयाल़ी की लई आया</para>
  <para style="q" vid="PSA 106:9">मानो सुनसाण जगा बीचा ते निकयाल़ी की लईगा।<verse eid="PSA 106:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 106:10" />ईंयाँ तैं सेयो तिना रे बैरिया ते बचाए</para>
  <para style="q" vid="PSA 106:10">ओर दुश्मणा रे आथो ते छुड़ाई लये।<note caller="+" style="f"><char style="fr" closed="false">106:10 </char><char style="ft" closed="false">लूक 1:71</char></note><verse eid="PSA 106:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 106:11" />ओर तिना रे दुश्मण पाणिए रे डूबी गे,</para>
  <para style="q" vid="PSA 106:11">तिना बीचा ते एक पनि बचेया।<verse eid="PSA 106:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 106:12" />तेबे म्हारे बुजुर्गे प्रभुए रे वचना पाँदे परोसा कित्तेया</para>
  <para style="q" vid="PSA 106:12">ओर तेसरी स्तुति करने लगे।<verse eid="PSA 106:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 106:13" />पर सेयो चट ई प्रभुए रे कामा खे पूली गे</para>
  <para style="q" vid="PSA 106:13">ओर तेसरिया सलाई रिया तँईं नि ठईरे।<verse eid="PSA 106:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 106:14" />तिने सुनसाण जगा रे बऊत लाल़च कित्तेया</para>
  <para style="q" vid="PSA 106:14">ओर बिना पाणिए रिया जगा रे परमेशरो री परीक्षा लई।<note caller="+" style="f"><char style="fr" closed="false">106:14 </char><char style="ft" closed="false">1 कुरिन्थ 10:9</char></note><verse eid="PSA 106:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 106:15" />तिने लोके जो मांगेया, से परमेशरे तिना खे दित्तेया;</para>
  <para style="q" vid="PSA 106:15">पर तिना बीचे महामारी बी पेजी।<verse eid="PSA 106:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 106:16" />जेबे तिने डेरेया रे मूसा</para>
  <para style="q" vid="PSA 106:16">ओर यहोवे रे पवित्र जन हारूणो रिया तँईं ईर्ष्या कित्ती,<verse eid="PSA 106:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 106:17" />तेबे तरती फटी की दातानो खे निगल़ी गी</para>
  <para style="q" vid="PSA 106:17">ओर तेसे अबीरामो रा चूण्ड बी टकी ता।<verse eid="PSA 106:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 106:18" />तेबे तिना रे चूण्डो रे आग लगी गी</para>
  <para style="q" vid="PSA 106:18">ओर दुष्ट लोक आगी रिया लूपिया साथे पस्म ऊईगे।<verse eid="PSA 106:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 106:19" />तिने होरेब पाह्ड़ो<note caller="+" style="f"><char style="fr" closed="false">106:19 </char><char style="ft" closed="false">सीनै पाह्ड़</char></note> पाँदे सूईने रे बाच्छूए री मूर्ति बणाई</para>
  <para style="q" vid="PSA 106:19">ओर तेसा बणाई रिया मूर्तिया गे माथा तेकेया।<verse eid="PSA 106:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 106:20" />तिने परमेशरो री महिमा खे</para>
  <para style="q" vid="PSA 106:20">काआ खाणे वाल़े बल़दो रिया मूर्तिया रे बदली ता।<note caller="+" style="f"><char style="fr" closed="false">106:20 </char><char style="ft" closed="false">रोमी 1:23</char></note><verse eid="PSA 106:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PSA 106:21" />सेयो आपणे उद्धार करने वाल़े परमेशरो खे पूली गे,</para>
  <para style="q" vid="PSA 106:21">जिने मिस्र देशो रे बड़े-बड़े काम कित्ते थे।<verse eid="PSA 106:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="PSA 106:22" />तिने हामो रे देशो दे अचम्बे रे काम</para>
  <para style="q" vid="PSA 106:22">ओर लाल समुद्रो रे कनारे पाँदे डराऊणे काम कित्ते थे।<verse eid="PSA 106:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="PSA 106:23" />इजी खे प्रभुए बोलेया कि मां इना रा सत्यानाश करी देणा था</para>
  <para style="q" vid="PSA 106:23">जे मेरा चुणेया रा दास मूसा मां सामणे तिना रिया खातर खड़ा नि ऊँदा,</para>
  <para style="q" vid="PSA 106:23">ताकि मेरा गुस्सा शान्त ऊई जाओ,</para>
  <para style="q" vid="PSA 106:23">केथी एड़ा नि ओ कि आऊँ तिना खे नाश करी देऊँ।<verse eid="PSA 106:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="PSA 106:24" />तेबे म्हारे बुजुर्गे तेस सुखी देशो खे छाडीता,</para>
  <para style="q" vid="PSA 106:24">कऊँकि तिने परमेशरो रे वादे पाँदे परोसा नि कित्तेया।<verse eid="PSA 106:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="PSA 106:25" />सेयो आपणे तम्बूए रे कुड़कुड़ांदे रये</para>
  <para style="q" vid="PSA 106:25">ओर तिने प्रभुए रा कईणा नि मानेया।<verse eid="PSA 106:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="PSA 106:26" />तेबे प्रभुए तिना रे बारे दे कसम खाई, कि</para>
  <para style="q" vid="PSA 106:26">मां यो सुनसाण जगा रे नाश करी देणे<verse eid="PSA 106:26" /></para>
  <para style="q">
    <verse number="27" style="v" sid="PSA 106:27" />ओर इना रे वंश दूजी जातिया सामणे बखेरी देणे</para>
  <para style="q" vid="PSA 106:27">ओर देशो-देशो रे तित्तर बित्तर करी देणे।<note caller="+" style="f"><char style="fr" closed="false">106:27 </char><char style="ft" closed="false">पजन 44:11</char></note><verse eid="PSA 106:27" /></para>
  <para style="q">
    <verse number="28" style="v" sid="PSA 106:28" />तेबे पोरो दे परमेशरो रे लोक बाल देवते री उपासना दे जाणे लगे</para>
  <para style="q" vid="PSA 106:28">ओर मरे दे देवतेया खे चढ़ाई दी बलिया खे खाया।<verse eid="PSA 106:28" /></para>
  <para style="q">
    <verse number="29" style="v" sid="PSA 106:29" />ईंयाँ तिने आपणे कामा ते प्रभुए खे गुस्सा चढ़ाया</para>
  <para style="q" vid="PSA 106:29">ओर तिना बीचे महामारी फैली गी।<verse eid="PSA 106:29" /></para>
  <para style="q">
    <verse number="30" style="v" sid="PSA 106:30" />तेबे पीनहासे खड़े ऊई की न्यायदण्ड दित्तेया,</para>
  <para style="q" vid="PSA 106:30">जेते की महामारी रूकी गी<verse eid="PSA 106:30" /></para>
  <para style="q">
    <verse number="31" style="v" sid="PSA 106:31" />तेसरा ये काम पीढ़िया ते पीढ़िया तक</para>
  <para style="q" vid="PSA 106:31">सदा खे तार्मिकता गिणेया गया।<verse eid="PSA 106:31" /></para>
  <para style="q">
    <verse number="32" style="v" sid="PSA 106:32" />तिने मरीबा री सूबल़ा रे नेड़े बी प्रभुए खे गुस्सा दलाया</para>
  <para style="q" vid="PSA 106:32">ओर तिना रिया बजा ते मूसे रा नुकशाण ऊआ;<verse eid="PSA 106:32" /></para>
  <para style="q">
    <verse number="33" style="v" sid="PSA 106:33" />कऊँकि तिने मूसे खे बऊत जादा गुस्सा दलाया,</para>
  <para style="q" vid="PSA 106:33">जेतेरिया बजा ते तिने मूर्खता रिया गल्ला बोलिया,<verse eid="PSA 106:33" /></para>
  <para style="q">
    <verse number="34" style="v" sid="PSA 106:34" />“इस्राएलिए दूजिया जातिया रे लोक नाश नि कित्ते,</para>
  <para style="q" vid="PSA 106:34">जेड़ी प्रभुए तिना खे आज्ञा दित्ती थी,<verse eid="PSA 106:34" /></para>
  <para style="q">
    <verse number="35" style="v" sid="PSA 106:35" />पर तिने दुष्ट जातिया रे लोका साथे ब्या कित्तेया,</para>
  <para style="q" vid="PSA 106:35">ओर तिने तिना रे जे काम बी सीखी ले;<verse eid="PSA 106:35" /></para>
  <para style="q">
    <verse number="36" style="v" sid="PSA 106:36" />म्हारे बुजुर्ग तिना रिया मूर्तिया री पूजा करने लगे,</para>
  <para style="q" vid="PSA 106:36">जो तिना खेई फन्दा बणीगी।<verse eid="PSA 106:36" /></para>
  <para style="q">
    <verse number="37" style="v" sid="PSA 106:37" />तिने आपणे माठे-बेटिया खे कनानो रे देवतेया रे आगे बलिया रे रूपो दे चढ़ाया।,</para>
  <para style="q" vid="PSA 106:37">पूत-प्रेता खे बलिदान कित्ते;<note caller="+" style="f"><char style="fr" closed="false">106:37 </char><char style="ft" closed="false">1 कुरिन्थ 10:20</char></note><verse eid="PSA 106:37" /></para>
  <para style="q">
    <verse number="38" style="v" sid="PSA 106:38" />तिने आपणे निर्दोष माठे-बेटिया रा खून बाह्या,</para>
  <para style="q" vid="PSA 106:38">जो तिने कनान देशो रिया मूर्तिया पाँदे बलिदान कित्ते,</para>
  <para style="q" vid="PSA 106:38">इजी खे तरती खूनो साथे अपवित्र ऊई गी।<verse eid="PSA 106:38" /></para>
  <para style="q">
    <verse number="39" style="v" sid="PSA 106:39" />सेयो आपू ई आपणे कामा रे जरिए अशुद्ध ऊईगे</para>
  <para style="q" vid="PSA 106:39">ओर आपणे कामा रे जरिए व्याभिचारी बी बणीगे।<verse eid="PSA 106:39" /></para>
  <para style="q">
    <verse number="40" style="v" sid="PSA 106:40" />तेबे प्रभुए रा गुस्सा आपणे निज लोका पाँदे पड़केया</para>
  <para style="q" vid="PSA 106:40">ओर तिने आपणे निज पाअगो ते कृणा कित्ती;<verse eid="PSA 106:40" /></para>
  <para style="q">
    <verse number="41" style="v" sid="PSA 106:41" />तेबे प्रभुए सेयो दूजी जातिया रे वशो रे करीते</para>
  <para style="q" vid="PSA 106:41">ओर तिना रे बैरिये तिना पाँदे राज कित्तेया।<verse eid="PSA 106:41" /></para>
  <para style="q">
    <verse number="42" style="v" sid="PSA 106:42" />तिना रे दुश्मणे तिना पाँदे अन्देर कित्तेया</para>
  <para style="q" vid="PSA 106:42">ओर सेयो तिना रे वशो रे ऊईगे।<verse eid="PSA 106:42" /></para>
  <para style="q">
    <verse number="43" style="v" sid="PSA 106:43" />कई बार प्रभुए सेयो छुड़ाए, पर सेयो तेसरे खलाफ बगावत करदे गये</para>
  <para style="q" vid="PSA 106:43">ओर आपणे बुरे कामा रिया बजा ते तिना खे चुकणा पड़ेया।<verse eid="PSA 106:43" /></para>
  <para style="q">
    <verse number="44" style="v" sid="PSA 106:44" />तेबे बी जेबे प्रभुए प्रार्थना दे तिना री पुकार सुणी,</para>
  <para style="q" vid="PSA 106:44">तेबे तिने तिना री मुसीबता पाँदे त्यान कित्तेया!<verse eid="PSA 106:44" /></para>
  <para style="q">
    <verse number="45" style="v" sid="PSA 106:45" />प्रभुए तिना रिया तँईं आपणी वाचा याद करी की</para>
  <para style="q" vid="PSA 106:45">आपणी अपार करूणा रे मुताबिक तरस खाया,<verse eid="PSA 106:45" /></para>
  <para style="q">
    <verse number="46" style="v" sid="PSA 106:46" />ओर जो तिना खे बंदी बणाई की लईगे थे,</para>
  <para style="q" vid="PSA 106:46">तिना सबी ते तिना पाँदे दया करवाई।”<verse eid="PSA 106:46" /></para>
  <para style="q">
    <verse number="47" style="v" sid="PSA 106:47" />ओ म्हारे परमेशर, म्हारा उद्धार कर</para>
  <para style="q" vid="PSA 106:47">ओर आसा खे दूजी जातिया बीचा ते कट्ठा करी दे,</para>
  <para style="q" vid="PSA 106:47">ताकि आसे तेरे पवित्र नाओं रा तन्यवाद करिए</para>
  <para style="q" vid="PSA 106:47">ओर तेरी स्तुति करदे ऊए तेरी तारीफ करिए।<verse eid="PSA 106:47" /></para>
  <para style="q">
    <verse number="48" style="v" sid="PSA 106:48" />इस्राएलो रा यहोवा परमेशर शुरूए ते लई की जुगो-जुगो तक तन्य ए!</para>
  <para style="q" vid="PSA 106:48">ओर सारी प्रजा बोलो आमीन्!</para>
  <para style="q" vid="PSA 106:48">यहोवे री स्तुति करो।<note caller="+" style="f"><char style="fr" closed="false">106:48 </char><char style="ft" closed="false">पजन 41:13</char></note><verse eid="PSA 106:48" /></para>
  <chapter eid="PSA 106" />
  <chapter number="107" style="c" sid="PSA 107" />
  <para style="ms">पाँजुआ इस्सा</para>
  <para style="mr">
    <ref loc="PSA 107-150">पजन 107-150</ref></para>
  <para style="s">मुसीबता ते छुटकारा</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 107:1" />प्रभुए रा तन्यवाद करो, कऊँकि से पला ए</para>
  <para style="q" vid="PSA 107:1">ओर तेसरी करूणा सदा री ए!<verse eid="PSA 107:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 107:2" />प्रभुए रे छुड़ाए रे लोक,</para>
  <para style="q" vid="PSA 107:2">जो तिने दुश्मणा रे आथो ते मोल देई की छुड़ाई लये रे,<verse eid="PSA 107:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 107:3" />ओर जो तिने देशो-देशो ते, पूर्व-पच्छम, उत्तर-दक्खणो ते कट्ठे करी राखे,</para>
  <para style="q" vid="PSA 107:3">सेयो प्रभुए रा तन्यवाद करो।<note caller="+" style="f"><char style="fr" closed="false">107:3 </char><char style="ft" closed="false">पजन 106:47</char></note><verse eid="PSA 107:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 107:4" />तिना देशा ते वापस आऊणे वाल़ेया बीचा ते कुछ सुनसाण जगा दे पटकी गे;</para>
  <para style="q" vid="PSA 107:4">सेयो राची गे थे ओर तिना गे रणे खे कोई शईर नि था।<verse eid="PSA 107:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 107:5" />पूख ओर त्यायी री बजा ते</para>
  <para style="q" vid="PSA 107:5">सेयो कमजोर ऊईगे।<verse eid="PSA 107:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 107:6" />तेबे तिने मुसीबता रे बखते प्रभुए री दुहाई दित्ती</para>
  <para style="q" vid="PSA 107:6">ओर प्रभुए सेयो मुसीबता ते छुड़ाए;<verse eid="PSA 107:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 107:7" />ओर सेयो ठीक बाटा रिये चलाए,</para>
  <para style="q" vid="PSA 107:7">ताकि सेयो बसणे खे केसी शईरो रे जाई की पऊँचो।<verse eid="PSA 107:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 107:8" />लोक प्रभुए री करूणा रिया बजा ते</para>
  <para style="q" vid="PSA 107:8">ओर तिना अचम्बे रे कामा रिया बजा ते,</para>
  <para style="q" vid="PSA 107:8">जो से माणूंआ री खातर करोआ, तेसरा तन्यवाद करो!<verse eid="PSA 107:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 107:9" />से त्याया खे पीणे खे बऊत पाणी देओआ</para>
  <para style="q" vid="PSA 107:9">ओर पूखेया खे खरिया चीजा साथे रजाओआ।<note caller="+" style="f"><char style="fr" closed="false">107:9 </char><char style="ft" closed="false">लूक 1:53, यिर्मयाह 31:25</char></note><verse eid="PSA 107:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 107:10" />कुछ न्हेरे ओर मौता री छांयी रे बैठी रे थे</para>
  <para style="q" vid="PSA 107:10">ओर दु:खो रे पड़े रे ओर बेड़िया साथे जकड़ी रे थे,<verse eid="PSA 107:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 107:11" />कऊँकि सेयो परमेशरो रे वचना रे खलाफ चले</para>
  <para style="q" vid="PSA 107:11">ओर परमपरदानो री सलाह् तुच्छ जाणी।<verse eid="PSA 107:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 107:12" />तेबे प्रभुए तिना खे इतणा कष्ट दित्तेया कि सेयो ठोकर खाई की रूड़ीगे</para>
  <para style="q" vid="PSA 107:12">ओर तिना खे कोई बी मताद करने वाल़ा नि मिलेया।<verse eid="PSA 107:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 107:13" />तेबे तिने आपणी मुसीबता रे प्रभुए री दुहाई दित्ती</para>
  <para style="q" vid="PSA 107:13">ओर प्रभुए सेयो एसा बिपदा ते छुड़ाए;<verse eid="PSA 107:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 107:14" />तिने सेयो अन्दकूप न्हेरे ते बारे निकाल़ी की ल्याया</para>
  <para style="q" vid="PSA 107:14">ओर तिना रिया बेड़िया तोड़ी तिया।<verse eid="PSA 107:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 107:15" />लोक प्रभुए री करूणा रिया बजा ते</para>
  <para style="q" vid="PSA 107:15">ओर तिना अचम्बे रे कामा रिया बजा ते,</para>
  <para style="q" vid="PSA 107:15">जो से माणूंआ खे करोआ, तेसरा तन्यवाद करो!<verse eid="PSA 107:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 107:16" />प्रभुए पीतल़ी रे द्वार तोड़े</para>
  <para style="q" vid="PSA 107:16">ओर लोए रिया छड़ा रे टुकड़े-टुकड़े करीते।<verse eid="PSA 107:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 107:17" />मूर्ख आपणी बुरी चाल</para>
  <para style="q" vid="PSA 107:17">ओर बुरे कामा रिया बजा ते बऊत दु:खी ओए।<verse eid="PSA 107:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 107:18" />सेयो कुछ बी खाणा नि चाँदे</para>
  <para style="q" vid="PSA 107:18">ओर सेयो मरने रे बऊत नेड़े थे<verse eid="PSA 107:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 107:19" />तेबे तिने आपणी मुसीबता रे बखते प्रभुए री दुहाई दित्ती</para>
  <para style="q" vid="PSA 107:19">ओर प्रभुए सेयो मुसीबता ते बचाए।<verse eid="PSA 107:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 107:20" />प्रभु तिना खे आपणे वचनो रे जरिए तन्दरूस्त करोआ</para>
  <para style="q" vid="PSA 107:20">ओर विनाशो ते तिना री रक्षा करोआ।<note caller="+" style="f"><char style="fr" closed="false">107:20 </char><char style="ft" closed="false">पजन 147:15</char></note><verse eid="PSA 107:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PSA 107:21" />लोक प्रभुए री करूणा रिया बजा ते</para>
  <para style="q" vid="PSA 107:21">ओर तिना अचम्बे रे कामा रिया बजा ते,</para>
  <para style="q" vid="PSA 107:21">जो से माणूंआ रिया तँईं करोआ, तेसरा तन्यवाद करो!<verse eid="PSA 107:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="PSA 107:22" />ओर सेयो तन्यवादो री बलि चढ़ाओ</para>
  <para style="q" vid="PSA 107:22">ओर जयजयकार करदे ऊए, तेसरे कामा रा बखाण करो।<verse eid="PSA 107:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="PSA 107:23" />जो लोक जाह्जो दे समुद्रो दे हांडोए</para>
  <para style="q" vid="PSA 107:23">ओर महासागरो पाँदे ऊई की बपार करोए;<verse eid="PSA 107:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="PSA 107:24" />सेयो प्रभुए रे कामा खे</para>
  <para style="q" vid="PSA 107:24">ओर तिना अचम्बे रे कामा खे जो सेयो गईरे समुद्रो रे करोआ, देखोए।<verse eid="PSA 107:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="PSA 107:25" />प्रभुए आज्ञा दित्ती, ओर तूफान आया,</para>
  <para style="q" vid="PSA 107:25">जेतेते लईरा ऊठणे लगिया।<verse eid="PSA 107:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="PSA 107:26" />जाह्ज सर्गो तक ऊच्चे चकीते</para>
  <para style="q" vid="PSA 107:26">ओर फेर गईराईया तक थाले त्वारी ते।</para>
  <para style="q" vid="PSA 107:26">ईंयाँ मुसीबता दे तिने आपणी ईम्मत छाडी ती,<verse eid="PSA 107:26" /></para>
  <para style="q">
    <verse number="27" style="v" sid="PSA 107:27" />सेयो लड़खड़ाई गे ओर शराबिया रे नशे जेड़े डगमगाणे लगे</para>
  <para style="q" vid="PSA 107:27">ओर तिना री सारी बुद्धि नाश ऊई जाओई।<verse eid="PSA 107:27" /></para>
  <para style="q">
    <verse number="28" style="v" sid="PSA 107:28" />तेबे सेयो मुसीबता रे बखते प्रभुए री दुहाई देओए</para>
  <para style="q" vid="PSA 107:28">ओर से तिना खे बिपदा ते बचाई लओआ।<verse eid="PSA 107:28" /></para>
  <para style="q">
    <verse number="29" style="v" sid="PSA 107:29" />प्रभु तूफानो खे बंद करी देओआ</para>
  <para style="q" vid="PSA 107:29">ओर लईरा शान्त ऊई जाओईया।<verse eid="PSA 107:29" /></para>
  <para style="q">
    <verse number="30" style="v" sid="PSA 107:30" />लईरा रे शान्त ऊणे रिया बजा ते सेयो खुश थे</para>
  <para style="q" vid="PSA 107:30">ओर से तिना खे तेते बन्दरगाह रे सई-सलामत लई आए</para>
  <para style="q" vid="PSA 107:30">जेती सेयो जाणा चाओ थे।<verse eid="PSA 107:30" /></para>
  <para style="q">
    <verse number="31" style="v" sid="PSA 107:31" />लोक प्रभुए री दया री बजा ते</para>
  <para style="q" vid="PSA 107:31">ओर तिना अचम्बे रे कामा रिया बजा ते,</para>
  <para style="q" vid="PSA 107:31">जो से माणूंआ रिया तँईं करोआ, तेसरा तन्यवाद करो।<verse eid="PSA 107:31" /></para>
  <para style="q">
    <verse number="32" style="v" sid="PSA 107:32" />ओर सेयो लोका रिया मण्डल़िया दे तेसरी सराईणा करो</para>
  <para style="q" vid="PSA 107:32">ओर बुजुर्गा रिया बैठका दे तेसरी स्तुति करो।<verse eid="PSA 107:32" /></para>
  <para style="q">
    <verse number="33" style="v" sid="PSA 107:33" />यहोवा नदिया खे सुनसाण जगा बणाई देओआ</para>
  <para style="q" vid="PSA 107:33">ओर पाणिए रे चरनेया खे सूकी जमीन बणाई देओआ।<verse eid="PSA 107:33" /></para>
  <para style="q">
    <verse number="34" style="v" sid="PSA 107:34" />से तेती रणे वाल़ेया रिया दुष्टता रिया बजा ते</para>
  <para style="q" vid="PSA 107:34">पजणे वाल़ी जमीना खे बंजर बणाई देओआ।<verse eid="PSA 107:34" /></para>
  <para style="q">
    <verse number="35" style="v" sid="PSA 107:35" />से सुनसाण जगा खे पाणिए रे खाल़ा दे</para>
  <para style="q" vid="PSA 107:35">ओर सूकिया जमीना खे पाणिए रे चरनेया दे बदली देओआ।<verse eid="PSA 107:35" /></para>
  <para style="q">
    <verse number="36" style="v" sid="PSA 107:36" />तेबे से तेती पूखेया खे बसाई देओआ,</para>
  <para style="q" vid="PSA 107:36">ताकि सेयो बसणे रिया तँईं शईर त्यार करो;<verse eid="PSA 107:36" /></para>
  <para style="q">
    <verse number="37" style="v" sid="PSA 107:37" />ओर फसल-बाड़ी लगाओ ओर अंगूरा रे बगीचे लगाओ</para>
  <para style="q" vid="PSA 107:37">ओर पांतिया-पांतिया रे फल़ पैदा करो।<verse eid="PSA 107:37" /></para>
  <para style="q">
    <verse number="38" style="v" sid="PSA 107:38" />यहोवा आपणियां प्रजा खे आशीष देओआ ओर तिना रे बऊत बाल-बच्चे ओए,</para>
  <para style="q" vid="PSA 107:38">यहोवा तिना रे डांगरा खे बी से कम नि ऊणे देंदा।<verse eid="PSA 107:38" /></para>
  <para style="q">
    <verse number="39" style="v" sid="PSA 107:39" />जेबे परमेशरो रे लोक अन्देर, बिपदा ओर दु:खो रिया बजा ते,</para>
  <para style="q" vid="PSA 107:39">आरे ओर बेज्जत ऊए,<verse eid="PSA 107:39" /></para>
  <para style="q">
    <verse number="40" style="v" sid="PSA 107:40" />यहोवे तिना पाँदे अन्देर करने वाल़ेया खे तुच्छ जाणेया,</para>
  <para style="q" vid="PSA 107:40">ओर सेयो सुनसाण जगा रे पटकाईते;<verse eid="PSA 107:40" /></para>
  <para style="q">
    <verse number="41" style="v" sid="PSA 107:41" />पर यहोवा गरीबा खे दु:खो ते छुड़ाई की तिना री तरक्की करोआ</para>
  <para style="q" vid="PSA 107:41">ओर तिना रे टब्बरो खे पेडा रे चूण्डा जेड़ा बऊत बढ़ाई देओआ।<verse eid="PSA 107:41" /></para>
  <para style="q">
    <verse number="42" style="v" sid="PSA 107:42" />सीदे माणूं ये देखी की बऊत खुश ओए;</para>
  <para style="q" vid="PSA 107:42">ओर सब बुरे माणूं आपणा मूँ बंद करी देओए।<verse eid="PSA 107:42" /></para>
  <para style="q">
    <verse number="43" style="v" sid="PSA 107:43" />जो अक्लमंद ओ, से इना सबी गल्ला पाँदे त्यान देओ</para>
  <para style="q" vid="PSA 107:43">ओर लोक प्रभुए री करूणा पाँदे बचार करो।<verse eid="PSA 107:43" /></para>
  <chapter eid="PSA 107" />
  <chapter number="108" style="c" sid="PSA 108" />
  <para style="s">दुश्मणा रे खलाफ मतादा री प्रार्थना</para>
  <para style="d">दाऊदो रा पजन</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 108:1" />ओ यहोवा, मेरा दिल तांदे ई लगेया राए;</para>
  <para style="q" vid="PSA 108:1">मां गीत गाणा, मां आपणी आत्मा ते बी पजन गाणा।<verse eid="PSA 108:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 108:2" />मां आपणी सारंगी, आपणी बीणा चकणी!</para>
  <para style="q" vid="PSA 108:2">ओर सूरजो रे निकल़णे ते पईले मां संगीत बजाणा!<verse eid="PSA 108:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 108:3" />ओ प्रभु, मां देशो-देशो रे लोका बीचे तेरा तन्यवाद करना</para>
  <para style="q" vid="PSA 108:3">ओर राज्य-राज्य रे लोका बीचे तेरा पजन गाणा।<verse eid="PSA 108:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 108:4" />कऊँकि तेरी करूणा सर्गो ते बी ऊच्ची ए</para>
  <para style="q" vid="PSA 108:4">ओर तेरी सच्चाई सर्गो तक महान ए।<verse eid="PSA 108:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 108:5" />ओ परमेशर, स्वर्गो पाँदे आपणी महानता प्रकट कर</para>
  <para style="q" vid="PSA 108:5">ओर तेरी महिमा सारी तरतिया पाँदे ओ!<verse eid="PSA 108:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 108:6" />तूँ आपणियां तागती ते आसा खे बचाई लओ</para>
  <para style="q" vid="PSA 108:6">ओर म्हारी बिनती सुणी लओ, कि जिना लोका ते तूँ प्यार करेया सेयो उद्धार पाओ!<verse eid="PSA 108:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 108:7" />परमेशरे आपणी पवित्रता रे ऊई की बोली राखेया, “मां खुश ऊई की शकेम शईर बांडी लणा</para>
  <para style="q" vid="PSA 108:7">ओर सुक्कोतो री काअटी नपवाणी।<verse eid="PSA 108:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 108:8" />गिलाद प्रदेश मेरा ए, मनश्शे बी मेरा ए;</para>
  <para style="q" vid="PSA 108:8">ओर एप्रैम मेरे शरण लणे री जगा ए,</para>
  <para style="q" vid="PSA 108:8">यहूदा प्रदेश मेरा राजदण्ड ए।<verse eid="PSA 108:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 108:9" />मोआब मेरे तोणे रा पांडा ए, एदोम देश मेरे पैरा निठे ऊणा,</para>
  <para style="q" vid="PSA 108:9">पलिश्ती देशो पाँदे मां जयजयकार करनी।”<verse eid="PSA 108:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 108:10" />ओ परमेशर, आऊँ गढ़वाल़े शईरो रे केस पऊँचाणा?</para>
  <para style="q" vid="PSA 108:10">कुण माखे एदोमो तक लई जाओगा?<verse eid="PSA 108:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 108:11" />ओ परमेशर, क्या तैं आसे छाडी नि दित्ते</para>
  <para style="q" vid="PSA 108:11">ओर ओ परमेशर, तूँ म्हारी सेना साथे कऊँ नि चलदा।<verse eid="PSA 108:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 108:12" />दुश्मणा रे खलाफ म्हारी मताद कर,</para>
  <para style="q" vid="PSA 108:12">कऊँकि माणूंआ री मताद तो बेकार ए!<verse eid="PSA 108:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 108:13" />परमेशरो री मतादा ते आसा वीरता दखाणी,</para>
  <para style="q" vid="PSA 108:13">कऊँकि म्हारे दुश्मण तेसी ई आपणे पैरा निठे केसणे।<verse eid="PSA 108:13" /></para>
  <chapter eid="PSA 108" />
  <chapter number="109" style="c" sid="PSA 109" />
  <para style="s">बदले री मांग</para>
  <para style="d">बजाणे वाल़े रे परदानो रिया तँईं दाऊदो रा पजन</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 109:1" />ओ परमेशर, जेसरी आऊँ स्तुति करूँआ,</para>
  <para style="q" vid="PSA 109:1">तूँ चुप नि रओ।<verse eid="PSA 109:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 109:2" />कऊँकि मेरे खलाफ दुष्ट ओर कपटी माणूं चूठ बोलोए,</para>
  <para style="q" vid="PSA 109:2">सेयो मेरे बारे दे चूठ बोलोए जो सच्च नि आ।<verse eid="PSA 109:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 109:3" />तिने मेरे बारे दे बुरिया गल्ला बोली कि आऊँ चऊँ कनारे ते केरी ता रा</para>
  <para style="q" vid="PSA 109:3">ओर सेयो बिना बजा तेई मां साथे लड़ोए।<note caller="+" style="f"><char style="fr" closed="false">109:3 </char><char style="ft" closed="false">यूह. 15:25</char></note><verse eid="PSA 109:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 109:4" />मेरे प्यारो रे बदले सेयो मां साथे बरोद करोए,</para>
  <para style="q" vid="PSA 109:4">पर आऊँ तो लगातार तिना रिया तँईं प्रार्थना करदा रऊँआ।<verse eid="PSA 109:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 109:5" />तिने पलाईया रे बदले मां साथे बुराई कित्ती</para>
  <para style="q" vid="PSA 109:5">ओर मेरे प्यारो रे बदले मां साथे बैर करी राखेया।<verse eid="PSA 109:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 109:6" />मेरे दुश्मणे बोलेया, “तेसखे परखणे खे केसी प्रष्ट न्यायिये खे चूण,</para>
  <para style="q" vid="PSA 109:6">ओर तेसरे आपणे दुश्मणा बीचा ते एकी खे तेस पाँदे दोष लगाणे दे।”<verse eid="PSA 109:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 109:7" />जेबे तेसरा न्याय कित्तेया जाओ, तेबे से दोषी निकल़ो,</para>
  <para style="q" vid="PSA 109:7">ओर तेसरी प्रार्थना पाप गिणी जाओ!<verse eid="PSA 109:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 109:8" />से छोड़ ई मरी जाओ;</para>
  <para style="q" vid="PSA 109:8">ओर कोई दूजा तेसरी तन-दौलत लई लो!<note caller="+" style="f"><char style="fr" closed="false">109:8 </char><char style="ft" closed="false">प्रेरित 1:20</char></note><verse eid="PSA 109:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 109:9" />तेसरे बच्चे अनाथ ऊई जाओ</para>
  <para style="q" vid="PSA 109:9">ओर तेसरी लाड़ी बिदुआ ऊई जाओ!<verse eid="PSA 109:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 109:10" />ओर तेसरे बच्चे मारे-मारे फिरो ओर सेयो पीख मांगेया करो;</para>
  <para style="q" vid="PSA 109:10">तिना खे आपणे उजड़े रे कअरो ते दूर जाई की टुकड़ा माँगणा पड़ो।<verse eid="PSA 109:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 109:11" />साऊकार तेसरा सब कुछ छीनी की लई लओ</para>
  <para style="q" vid="PSA 109:11">ओर परदेशी तेसरी मईणता री कमाई लूटी लओ!<verse eid="PSA 109:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 109:12" />तेस पाँदे कोई करूणा नि करो</para>
  <para style="q" vid="PSA 109:12">ओर तेसरे अनाथ बाल़का पाँदे कोई दया नि करो!<verse eid="PSA 109:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 109:13" />तेसरा वंश नाश ऊई जाओ,</para>
  <para style="q" vid="PSA 109:13">दूजिया पीढ़िया रे तेसरा नाओं मिटी जाओ!<verse eid="PSA 109:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 109:14" />तेसरे पितरा रा पाप प्रभुए खे याद रओ</para>
  <para style="q" vid="PSA 109:14">ओर तेसरी माया रा पाप मटयाया नि जाओ!<verse eid="PSA 109:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 109:15" />ओ यहोवा तूँ हमेशा तिना रे पाप याद राख,</para>
  <para style="q" vid="PSA 109:15">ताकि तूँ तिना रा नाओं तरतिया पाँदा ते मटयाई दे!<verse eid="PSA 109:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 109:16" />मेरा दुश्मण कदी केसी पाँदे दयावान नि ऊआ।</para>
  <para style="q" vid="PSA 109:16">बल्कि दु:खी ओर गरीबा खे सताओ था</para>
  <para style="q" vid="PSA 109:16">ओर तिने सेयो मरने बी दित्ते,<verse eid="PSA 109:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 109:17" />तेसखे ओरी खे स्राप देणा प्यारा लगो था</para>
  <para style="q" vid="PSA 109:17">ओर स्राप तेस पाँदे पड़ीगा, तेसखे आशीर्वाद देणा अच्छा नि लगो था,</para>
  <para style="q" vid="PSA 109:17">इजी खे आशीर्वाद तेसते दूर रया।<verse eid="PSA 109:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 109:18" />से स्राप देणा टाल्लेया जेड़ा पईनो था</para>
  <para style="q" vid="PSA 109:18">ओर से तेसरे पेटो रे पाणिए जेड़ा</para>
  <para style="q" vid="PSA 109:18">ओर तेसरी आड्डिया दे तेलो जेड़ा रची गा।<verse eid="PSA 109:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 109:19" />तेसरे स्राप फैंटे जेड़े तेसरे चऊँ कनारे रओ,</para>
  <para style="q" vid="PSA 109:19">जेड़ा से हर रोज पईनोआ।<verse eid="PSA 109:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 109:20" />प्रभुए रिया तरफा ते मेरे बरोदिया खे</para>
  <para style="q" vid="PSA 109:20">ओर मेरे खलाफ बुरा बोलणे वाल़ेया खे येई बदला मिलो!<verse eid="PSA 109:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PSA 109:21" />पर ओ यहोवा, तूँ आपणे नाओं रे मुताबिक मां साथे बर्ताव कर;</para>
  <para style="q" vid="PSA 109:21">तेरी करूणा तो बड़ी ए, इजी री खातर तूँ माखे छुटकारा दे!<verse eid="PSA 109:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="PSA 109:22" />कऊँकि आऊँ दु:खी ओर गरीब ए</para>
  <para style="q" vid="PSA 109:22">ओर मेरे पीतरे मेरा दिल कायल ऊईरा।<verse eid="PSA 109:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="PSA 109:23" />आऊँ टल़दी ऊई छांयी जेड़ा टल़दा जाणे लगी रा;</para>
  <para style="q" vid="PSA 109:23">आऊँ टिड्डिया जेड़ा डवाई ता रा।<verse eid="PSA 109:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="PSA 109:24" />बअरत करदे-करदे मेरे जानू कमजोर ऊईगे</para>
  <para style="q" vid="PSA 109:24">ओर मांदे चर्बी नि रणे रिया बजा ते आऊँ सूकीगा रा।<verse eid="PSA 109:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="PSA 109:25" />जेबे लोक माखे देखोए, तो सेयो मां पाँदे आसदे ऊए मजाक उडाओए;</para>
  <para style="q" vid="PSA 109:25">सेयो बेज्जती करी की सिर ईलाओए।<note caller="+" style="f"><char style="fr" closed="false">109:25 </char><char style="ft" closed="false">(इब्रानी 10:12-13, लूक 20:42-43)</char></note><verse eid="PSA 109:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="PSA 109:26" />ओ मेरे प्रभु परमेशर, मेरी मताद कर!</para>
  <para style="q" vid="PSA 109:26">आपणी करूणा रे मुताबिक माखे बचाई लओ!<verse eid="PSA 109:26" /></para>
  <para style="q">
    <verse number="27" style="v" sid="PSA 109:27" />मेरेया दुश्मणा खे ये पता लगी जाओ कि ये तेरा काम ए</para>
  <para style="q" vid="PSA 109:27">ओर ओ प्रभु, तैंई ये करी राखेया!<verse eid="PSA 109:27" /></para>
  <para style="q">
    <verse number="28" style="v" sid="PSA 109:28" />सेयो माखे कोसदे तो रओ, पर तूँ आशीष दे!</para>
  <para style="q" vid="PSA 109:28">सेयो तो उठदे ई शर्मिंदा ओ, पर तेरा दास खुश ओ!<note caller="+" style="f"><char style="fr" closed="false">109:28 </char><char style="ft" closed="false">1 कुरिन्थ 4:12</char></note><verse eid="PSA 109:28" /></para>
  <para style="q">
    <verse number="29" style="v" sid="PSA 109:29" />मेरे दुश्मण बेज्जत ऊई जाओ;</para>
  <para style="q" vid="PSA 109:29">सेयो आपणी बेज्जतिया खे टाल्लेया जेड़े पईनी लो!<verse eid="PSA 109:29" /></para>
  <para style="q">
    <verse number="30" style="v" sid="PSA 109:30" />मां प्रभुए रा बऊत तन्यवाद करना</para>
  <para style="q" vid="PSA 109:30">ओर बऊत लोका बीचे तेसरी स्तुति करनी।<verse eid="PSA 109:30" /></para>
  <para style="q">
    <verse number="31" style="v" sid="PSA 109:31" />यहोवा गरीबा रे दाँणे कनारे खड़ेया रा रणा,</para>
  <para style="q" vid="PSA 109:31">ताकि से तेसखे मौता री सजा देणे वाल़ेया रे आथो ते बचाओ।<verse eid="PSA 109:31" /></para>
  <chapter eid="PSA 109" />
  <chapter number="110" style="c" sid="PSA 110" />
  <para style="s">परमेशर ओर तेसरा चूणेया रा राजा</para>
  <para style="d">दाऊदो रा पजन</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 110:1" />यहोवे मेरे प्रभुए ते बोलेया, “तूँ मेरे दाँणे बैठ,</para>
  <para style="q" vid="PSA 110:1">जदुओ तक आऊँ तेरे दुश्मणा खे तेरे पैरा री चौकी नि बणाई देऊँ।”<note caller="+" style="f"><char style="fr" closed="false">110:1 </char><char style="ft" closed="false">इब्रानी 10:12,13, लूक 20:42,43</char></note><verse eid="PSA 110:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 110:2" />यहोवे तेसते बोलेया, “मां तेरी शक्ति एक राजे रे रूपो दे सिय्योनो ते लई कि दूजिया जगा तक बढ़ाणी।</para>
  <para style="q" vid="PSA 110:2">ओर तां आपणे दुश्मणा पाँदे राज करना।”<verse eid="PSA 110:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 110:3" />तेरिया प्रजा रे लोक तेरे पराक्रमो रे दिने आपणी इच्छा ते आपू खे अर्पित करोए;</para>
  <para style="q" vid="PSA 110:3">तेरे जवान लोक पवित्र पाह्ड़ो पाँदे तड़के रे पाल़े जेड़े तांगे ए।<verse eid="PSA 110:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 110:4" />यहोवे आपू वादा कित्तेया से तीजी ते पीछे नि आटणा, जेड़ा तिने बोलेया,, “तूँ मलिकिसिदको रिया रीतिया पाँदे सदा खे पुरोईत ए।” <note caller="+" style="f"><char style="fr" closed="false">110:4 </char><char style="ft" closed="false">इब्रानी 7:21, इब्रानी 7:17</char></note><verse eid="PSA 110:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 110:5" />यहोवा तेरे दाँणियां तरफा खे ए,</para>
  <para style="q" vid="PSA 110:5">तेस आपणे गुस्से रे दिने राजे चूर करी देणे।<note caller="+" style="f"><char style="fr" closed="false">110:5 </char><char style="ft" closed="false">पजन 143:5</char></note><verse eid="PSA 110:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 110:6" />तेस जातिया-जातिया रा न्याय करना,</para>
  <para style="q" vid="PSA 110:6">रणभूमि मुड़देया साथे परी जाणी;</para>
  <para style="q" vid="PSA 110:6">तेस लाम्बे चौड़े देशो रे परदान चूर-चूर करी देणे।<verse eid="PSA 110:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 110:7" />तेस बाटा रिये चली की चरने रा पाणी पीणा</para>
  <para style="q" vid="PSA 110:7">ओर तेबे तेस जीतणे ते बाद आपणा सिर ऊच्चा करना।<verse eid="PSA 110:7" /></para>
  <chapter eid="PSA 110" />
  <chapter number="111" style="c" sid="PSA 111" />
  <para style="s">पलाईया रिया तँईं परमेशरो री स्तुति</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 111:1" />यहोवे री जयजयकार करो! मां यहोवे रा आपणियां मण्डल़िया रे सामणे;</para>
  <para style="q" vid="PSA 111:1">सीदे मनो ते यहोवे रा तन्यवाद करना।<verse eid="PSA 111:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 111:2" />प्रभुए रे काम महान ए, जितणे तिना ते खुश रओए,</para>
  <para style="q" vid="PSA 111:2">सेयो तिना खे टोल़ोए।<note caller="+" style="f"><char style="fr" closed="false">111:2 </char><char style="ft" closed="false">पजन 143:5</char></note><verse eid="PSA 111:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 111:3" />जो बी यहोवा काम करोआ, से काम महान ई ओए,</para>
  <para style="q" vid="PSA 111:3">तेसरी न्याय करने री तार्मिकता सदा री ए।<verse eid="PSA 111:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 111:4" />प्रभुए आपणे अचम्बे रे काम याद करवाई राखे;</para>
  <para style="q" vid="PSA 111:4">प्रभु दया करने वाल़ा ओर अनुग्रह करने वाल़ा ए।<verse eid="PSA 111:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 111:5" />तिने आपणे पग्ता खे रोटी खाणे खे देई राखी;</para>
  <para style="q" vid="PSA 111:5">तेस आपणी वाचा सदा खे याद राखणी।<verse eid="PSA 111:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 111:6" />यहोवे देशो-देशो रा अक्क आपणे लोका खे देई की</para>
  <para style="q" vid="PSA 111:6">आपणे कामा री शक्ति तिना पाँदे प्रकट करी राखी।<verse eid="PSA 111:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 111:7" />यहोवे रे काम सच्चाई ओर न्याय ए;</para>
  <para style="q" vid="PSA 111:7">तेसरे सारे उपदेश परोसा करने जोगे ए।<verse eid="PSA 111:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 111:8" />तेसरे उपदेश सदा खे रओए;</para>
  <para style="q" vid="PSA 111:8">तिना खे सच्चाई ओर तार्मिकता दे दित्ते थे।<verse eid="PSA 111:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 111:9" />परमेशरे आपणे लोक गुलामिया ते आजाद कित्ते ओर तिना साथे हमेशा रा वादा कित्तेया।</para>
  <para style="q" vid="PSA 111:9">से पवित्र ओर आदरो जोगा ए।<note caller="+" style="f"><char style="fr" closed="false">111:9 </char><char style="ft" closed="false">लूक 1:49,68</char></note><verse eid="PSA 111:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 111:10" />प्रभुए री पग्ती करना बुद्धिया री शुरूआत ए;</para>
  <para style="q" vid="PSA 111:10">जितणे तेसरी आज्ञा खे मानोए, तिना खे अच्छी समज मिलोई।</para>
  <para style="q" vid="PSA 111:10">प्रभुए री स्‍तुति सदा कित्ती जाणी।<verse eid="PSA 111:10" /></para>
  <chapter eid="PSA 111" />
  <chapter number="112" style="c" sid="PSA 112" />
  <para style="s">परमेशरो रे पग्ता री खुशी</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 112:1" />यहोवे री स्तुति करो! से माणूं बऊत ई तन्य ए जो यहोवे री इज्जत करोआ,</para>
  <para style="q" vid="PSA 112:1">जो तेसरिया आज्ञा रा पाल़न करने ते खुश ओए।<verse eid="PSA 112:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 112:2" />तेसरा वंश देशो दे महान ऊणा;</para>
  <para style="q" vid="PSA 112:2">सच्चे माणूंआ री ल्वादा परमेशरो ते आशीष पाणी।<verse eid="PSA 112:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 112:3" />तेसरा परिवार तनवान ऊणा,</para>
  <para style="q" vid="PSA 112:3">ओर तेसरा तर्म सदा खे बणेया दा रणा।<verse eid="PSA 112:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 112:4" />सच्चे माणूंए रिया तँईं न्हेरे दे जोति उदय ओई,</para>
  <para style="q" vid="PSA 112:4">प्रभु अनुग्रह करने वाल़ा, दयालु ओर तार्मिक ए।<verse eid="PSA 112:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 112:5" />जो माणूं ओरी पाँदे दया करोआ ओर त्वार देओआ,</para>
  <para style="q" vid="PSA 112:5">ओर ईमानदारिया साथे आपणे हरेक काम करोआ, तेसरा कल्याण ओआ।<verse eid="PSA 112:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 112:6" />से कदी बी डगमगाणा नि;</para>
  <para style="q" vid="PSA 112:6">तार्मिक माणूंए री याद सदा बणी री रणी।<verse eid="PSA 112:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 112:7" />से बुरिया खबरा ते नि डरदा;</para>
  <para style="q" vid="PSA 112:7">तेसरा दिल प्रभुए पाँदे परोसा राखणे ते पक्का बणेया रा रओआ।<verse eid="PSA 112:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 112:8" />तेसरा दिल मजबूत ए,</para>
  <para style="q" vid="PSA 112:8">जदुए तक से आपणे दुश्मणा पाँदे नजर करी की सन्तुष्ट नि ओ, से नि डरना।<verse eid="PSA 112:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 112:9" />तिने उदारता साथे गरीबा खे दान दित्तेया,</para>
  <para style="q" vid="PSA 112:9">तेसरी तार्मिकता सदा बणी री रणी</para>
  <para style="q" vid="PSA 112:9">ओर महिमा साथे तेसरा सींग ऊच्चा कित्तेया जाणा।<note caller="+" style="f"><char style="fr" closed="false">112:9 </char><char style="ft" closed="false">2 कुरिन्थ 9:9</char></note><verse eid="PSA 112:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 112:10" />दुष्ट इजी खे देखी की गुस्से ऊणा;</para>
  <para style="q" vid="PSA 112:10">से दाँद किरड़दा ऊआ ओर गल़ी-गल़ी की मरी जाणा;</para>
  <para style="q" vid="PSA 112:10">पर दुष्टा री इच्छा पूरी नि ऊणी।<note caller="+" style="f"><char style="fr" closed="false">112:10 </char><char style="ft" closed="false">प्रेरित 7:54</char></note><verse eid="PSA 112:10" /></para>
  <chapter eid="PSA 112" />
  <chapter number="113" style="c" sid="PSA 113" />
  <para style="s">स्तुतिया जोगा नाओं</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 113:1" />यहोवे री स्तुति करो! ओ यहोवे रे सेवको, स्तुति करो,</para>
  <para style="q" vid="PSA 113:1">यहोवे रे नाओं री स्तुति करो!<verse eid="PSA 113:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 113:2" />यहोवे रे नाओं री स्तुति आजो ते लई की सदा तक ऊँदी रओ।<verse eid="PSA 113:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 113:3" />पूर्वो ते लई की पच्छमा तक,</para>
  <para style="q" vid="PSA 113:3">यहोवे रे नाओं री स्तुति कित्ती जाओ।<verse eid="PSA 113:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 113:4" />प्रभु सारे देशा पाँदे महान ए</para>
  <para style="q" vid="PSA 113:4">ओर तेसरी महिमा सर्गो ते बी ऊच्ची ए।<verse eid="PSA 113:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 113:5" />म्हारे परमेशर यहोवे जेड़ा कोई पनि ए।</para>
  <para style="q" vid="PSA 113:5">से तो ऊच्चिया जगा पाँदे विराजमान ए,<verse eid="PSA 113:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 113:6" />पर से सर्ग ओर तरतिया पाँदे बी,</para>
  <para style="q" vid="PSA 113:6">नजर करने खे चुकोआ।<verse eid="PSA 113:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 113:7" />से कंगाल़ा खे माट्टिया पाँदा ते</para>
  <para style="q" vid="PSA 113:7">ओर गरीबा खे स्वाई रे टेरो पाँदा ते चकी की ऊच्चा करोआ।<verse eid="PSA 113:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 113:8" />ताकि तेसखे परदाना साथे,</para>
  <para style="q" vid="PSA 113:8">मतलब आपणी प्रजा रे परदाना साथे बठयाल़ो।<note caller="+" style="f"><char style="fr" closed="false">113:8 </char><char style="ft" closed="false">अय्यू. 36:7</char></note><verse eid="PSA 113:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 113:9" />से बांझ जवाणसा खे बच्चेया री खुशी मनाणे वाल़ी माये बणाओआ।</para>
  <para style="q" vid="PSA 113:9">यहोवे री स्तुति करो!<verse eid="PSA 113:9" /></para>
  <chapter eid="PSA 113" />
  <chapter number="114" style="c" sid="PSA 114" />
  <para style="s">फसह रे त्योआरो रा गीत</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 114:1" />जेबे इस्राएली लोक मिस्रो ते निकल़े,</para>
  <para style="q" vid="PSA 114:1">जेबे याकूबो रे कराने रे लोक दूजिया पाषा बोलणे वाल़ेया लोका रे देशो खे छाडीता,<verse eid="PSA 114:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 114:2" />तेबे यहूदा यहोवे री पवित्र प्रजा,</para>
  <para style="q" vid="PSA 114:2">ओर इस्राएल तेसरा निज इस्सा बणीगा।<verse eid="PSA 114:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 114:3" />जिंयाँ लाल समुद्रे इस्राएली आऊँदे ऊए देखे; से चट दूई इस्सेया दे ऊईगा,</para>
  <para style="q" vid="PSA 114:3">यरदन नदी उल्टी बह्यीणे लगी।<note caller="+" style="f"><char style="fr" closed="false">114:3 </char><char style="ft" closed="false">पजन 77:16</char></note><verse eid="PSA 114:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 114:4" />पाह्ड़ खाडूआ जेड़े उटकणे लगे</para>
  <para style="q" vid="PSA 114:4">ओर पाह्ड़िया पेडा-बाकरिया रे बच्चेया जेड़िया उटकणे लगिया।<verse eid="PSA 114:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 114:5" />ओ समुद्र, ताखे क्या ऊआ कि तूँ नठीगा?</para>
  <para style="q" vid="PSA 114:5">ओर ओ यरदन नदी, तूँ कऊँ उल्टी बह्यीणे लगी?<verse eid="PSA 114:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 114:6" />ओ पाह्ड़ो, तुसे पेडा जेड़े</para>
  <para style="q" vid="PSA 114:6">ओर ओ पाह्ड़ियो तुसे पेडा-बाकरिया रे बच्चेया जेड़िया कऊँ उटकणे लगिया?<verse eid="PSA 114:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 114:7" />ओ तरतिए यहोवे रे आऊणे ते,</para>
  <para style="q" vid="PSA 114:7">याकूबो रे परमेशरो री मौजुदगिया रे थरथरा।<note caller="+" style="f"><char style="fr" closed="false">114:7 </char><char style="ft" closed="false">पजन 96:9</char></note><verse eid="PSA 114:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 114:8" />प्रभु चट्टानी खे पाणिए रा खाल़,</para>
  <para style="q" vid="PSA 114:8">पथरीली जमीना खे बह्ईंदे पाणिए रे चश्मेया दे बदली देओआ।<verse eid="PSA 114:8" /></para>
  <chapter eid="PSA 114" />
  <chapter number="115" style="c" sid="PSA 115" />
  <para style="s">सिर्फ एक ई सच्चा परमेशर</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 115:1" />ओ यहोवा, म्हारी नि, बल्कि तेरी ई जयजयकार ओ! सारी महिमा जोगा तूँ ई ए,</para>
  <para style="q" vid="PSA 115:1">कऊँकि तेरी करूणा ओर सच्चाई सदा री ए।<verse eid="PSA 115:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 115:2" />देशो-देशो रे लोक कऊँ आसा ते एड़ा पूछणे लगो, “तुसा रा परमेशर केई आ?”<verse eid="PSA 115:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 115:3" />म्हारा परमेशर तो स्वर्गो दे ए;</para>
  <para style="q" vid="PSA 115:3">तिने जो चाया, सेई काम तिने कित्तेया।<verse eid="PSA 115:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 115:4" />पर दूजिया जातिया रे देवता तो सूईने-चाँदिए ते बणी रिया मूर्तिया ए,</para>
  <para style="q" vid="PSA 115:4">जो माणूंए आपू बणाई राखिया ए।<verse eid="PSA 115:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 115:5" />तिना रे मूँ तो अए, पर सेयो बोली नि सकदिया;</para>
  <para style="q" vid="PSA 115:5">तिना रे आखी तो अए, पर सेयो देखी नि सकदिया।<verse eid="PSA 115:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 115:6" />तिना रे कान तो अए, पर सेयो सुणी नि सकदिया;</para>
  <para style="q" vid="PSA 115:6">तिना रे नाक बी अए, पर सेयो सींगी नि सकदिया।<verse eid="PSA 115:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 115:7" />तिना रे आथ तो अए, पर सेयो छुँईं नि सकदिया;</para>
  <para style="q" vid="PSA 115:7">तिना रे पैर तो अए, पर सेयो चली नि सकदिया</para>
  <para style="q" vid="PSA 115:7">ओर सेयो आपणे गल़े ते कोई बी शब्द नि निकयाल़ी सकदिया।<verse eid="PSA 115:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 115:8" />जो तिना खे बणाओए;</para>
  <para style="q" vid="PSA 115:8">सेयो तिना ई मूर्तिया जेड़े निर्जीव ए</para>
  <para style="q" vid="PSA 115:8">ओर तिना पाँदे परोसा राखणे वाल़े बी सब तेड़े ई ऊई जाणे।<verse eid="PSA 115:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 115:9" />ओ इस्राएली लोको, प्रभुए पाँदे परोसा राखो!</para>
  <para style="q" vid="PSA 115:9">सेई तुसा रा मताद करने वाल़ा ओर रक्षक ए।<verse eid="PSA 115:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 115:10" />ओ हारूणो रे वंशो रे पुरोईतो, प्रभुए पाँदे परोसा राखो!</para>
  <para style="q" vid="PSA 115:10">सेई तुसा रा मताद करने वाल़ा ओर रक्षक ए।<verse eid="PSA 115:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 115:11" />ओ प्रभुए रे पग्तो, प्रभुए पाँदे परोसा राखो!</para>
  <para style="q" vid="PSA 115:11">सेई तुसा रा मताद करने वाल़ा ओर रक्षक ए।<verse eid="PSA 115:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 115:12" />प्रभुए आसे याद करी राखे; तेस आसा खे आशीष देणी;</para>
  <para style="q" vid="PSA 115:12">तेस इस्राएलो रे कराने खे आशीष देणी;</para>
  <para style="q" vid="PSA 115:12">तेस हारूणो रे वंशो रे पुरोईता खे आशीष देणी।<verse eid="PSA 115:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 115:13" />प्रभुए आपणे पग्ता खे,</para>
  <para style="q" vid="PSA 115:13">छोटेया-बड़ेया सबी खे आशीष देणी।<note caller="+" style="f"><char style="fr" closed="false">115:13 </char><char style="ft" closed="false">पजन 128:1</char></note><verse eid="PSA 115:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 115:14" />प्रभु तुसा खे</para>
  <para style="q" vid="PSA 115:14">ओर तुसा रे बाल-बच्चेया खे बी सदा बढ़ांदा जाओ!<verse eid="PSA 115:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 115:15" />प्रभु जो सर्ग ओर तरतिया खे बनाणे वाल़ा ए,</para>
  <para style="q" vid="PSA 115:15">तेसरिया तरफा ते तुसे आशीष पाओ।<verse eid="PSA 115:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 115:16" />स्वर्ग तो प्रभुए राए,</para>
  <para style="q" vid="PSA 115:16">पर तरती तिने माणूंआ खे देई राखी।<verse eid="PSA 115:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 115:17" />मरे रे माणूं यहोवे री स्तुति नि करी सकदे</para>
  <para style="q" vid="PSA 115:17">कऊँकि सेयो मृत्यु-लोको रे खामोश ऊई की पड़ी रे,<verse eid="PSA 115:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 115:18" />पर आसा लोका यहोवे खे एबुए ते लई की</para>
  <para style="q" vid="PSA 115:18">सदा तक तन्य बोलदे रणा।</para>
  <para style="q" vid="PSA 115:18">यहोवे री स्तुति करो!<verse eid="PSA 115:18" /></para>
  <chapter eid="PSA 115" />
  <chapter number="116" style="c" sid="PSA 116" />
  <para style="s">मौता ते बचणे रिया तँईं परमेशरो रा तन्यवाद</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 116:1" />आऊँ प्रभुए ते प्यार करूँआ,</para>
  <para style="q" vid="PSA 116:1">कऊँकि तिने मेरी प्रार्थना सुणी राखी।<verse eid="PSA 116:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 116:2" />तिने मेरिया तरफा खे सदा त्यान देई राखेया,</para>
  <para style="q" vid="PSA 116:2">इजी रिया खातर मां पूरी जिन्दगी तेसखे आका पाँदे रणा।<verse eid="PSA 116:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 116:3" />मौत मेरे चऊँ कनारे थी;</para>
  <para style="q" vid="PSA 116:3">आऊँ मृत्यु-लोको रे जंजाल़ो रे फसेया रा था;</para>
  <para style="q" vid="PSA 116:3">माखे कष्ट ओर दु:ख चेलणे पड़े।<note caller="+" style="f"><char style="fr" closed="false">116:3 </char><char style="ft" closed="false">पजन 18:4,5</char></note><verse eid="PSA 116:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 116:4" />तेबे मैं बिनती कित्ती, “ओ यहोवा,</para>
  <para style="q" vid="PSA 116:4">माखे मरने ते बचाई लओ!”<verse eid="PSA 116:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 116:5" />प्रभु अनुग्रह करने वाल़ा ओर तर्मी ए;</para>
  <para style="q" vid="PSA 116:5">म्हारा परमेशर दया करने वाल़ा ए।<verse eid="PSA 116:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 116:6" />प्रभु पोल़ेया माणूंआ री रक्षा करोआ;</para>
  <para style="q" vid="PSA 116:6">जेबे आऊँ बऊत बुरिया दशा रे था, तिने आँऊ बचाई ला।<verse eid="PSA 116:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 116:7" />ओ मेरे मन, पक्का बणेया रा रओ;</para>
  <para style="q" vid="PSA 116:7">कऊँकि यहोवे मां पाँदे पलाई करी राखी।<verse eid="PSA 116:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 116:8" />यहोवे आऊँ मरने ते बचाई राखेया;</para>
  <para style="q" vid="PSA 116:8">तिने मेरे आसू रोके ओर आऊँ आरने ते बचाया।<verse eid="PSA 116:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 116:9" />एबे मां एते दुनिया दे जेती लोक रओए,</para>
  <para style="q" vid="PSA 116:9">यहोवे री सेवा करनी।<verse eid="PSA 116:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 116:10" />मैं तेबे बी यहोवे पाँदे परोसा कित्तेया,</para>
  <para style="q" vid="PSA 116:10">जेबे मैं बोलेया, “माखे बऊत दु:ख ए।”<note caller="+" style="f"><char style="fr" closed="false">116:10 </char><char style="ft" closed="false">2 कुरिन्थ 4:13</char></note><verse eid="PSA 116:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 116:11" />मैं बिना सोचे-समजे ये बोलेया, “सब लोक चूठ बोलोए।”<note caller="+" style="f"><char style="fr" closed="false">116:11 </char><char style="ft" closed="false">रोमी 3:4</char></note><verse eid="PSA 116:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 116:12" />यहोवे मेरिया तँईं जितणी बी पलाई कित्ती,</para>
  <para style="q" vid="PSA 116:12">तिजी रे बदले आऊँ तेसखे क्या देऊँ?<verse eid="PSA 116:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 116:13" />मां ताखे अंगूरा रे रसो री पेंट चढ़ाणी,</para>
  <para style="q" vid="PSA 116:13">ओर तेरे नाओं ते प्रार्थना करनी, कऊँकि तैं आँऊ बचाई राखेया।<verse eid="PSA 116:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 116:14" />प्रभुए रे लोका सामणे मां प्रभुए खे सेई देणा</para>
  <para style="q" vid="PSA 116:14">जो मैं वादा करी राखेया।<verse eid="PSA 116:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 116:15" />प्रभुए रे पग्ता री मौत,</para>
  <para style="q" vid="PSA 116:15">तेसरिया नजरा रे बऊत ई किमती ए।<verse eid="PSA 116:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 116:16" />ओ प्रभु, सुण, आऊँ तेरा दास ए;</para>
  <para style="q" vid="PSA 116:16">आऊँ तेरा दास ए ओर तेरी दासिया रा पाऊ ए। तैं आँऊ मौता ते बचाई राखेया।<verse eid="PSA 116:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 116:17" />मां ताखे तन्यवादो री बलि चढ़ाणी</para>
  <para style="q" vid="PSA 116:17">ओर यहोवा, तेरे नाओं ते प्रार्थना करनी।<verse eid="PSA 116:17" /></para>
  <para style="q">
    <verse number="18-19" style="v" sid="PSA 116:18-19" />मां यहोवे री प्रजा रे सामणे, प्रभुए रे मईलो रे आँगणो दे,</para>
  <para style="q" vid="PSA 116:18-19">ओ यरूशलेम, तेरे पीतरे मां यहोवे रिया तँईं आपणियां मान्नता पुरिया करनिया।</para>
  <para style="q" vid="PSA 116:18-19">यहोवे री स्तुति करो!<verse eid="PSA 116:18-19" /></para>
  <chapter eid="PSA 116" />
  <chapter number="117" style="c" sid="PSA 117" />
  <para style="s">परमेशरो री स्तुतिया रा पजन</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 117:1" />ओ देशो-देशो रे लोको, यहोवे री स्तुति करो!</para>
  <para style="q" vid="PSA 117:1">ओ जातिया-जातिया रे सब लोको, प्रभुए रा गुणगाण करो!<note caller="+" style="f"><char style="fr" closed="false">117:1 </char><char style="ft" closed="false">रोमी 15:11</char></note><verse eid="PSA 117:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 117:2" />यहोवे आसा पाँदे खास करूणा करी राखी;</para>
  <para style="q" vid="PSA 117:2">ओर यहोवे री सच्चाई सदा बणी री रओई।</para>
  <para style="q" vid="PSA 117:2">यहोवे री स्तुति करो!<verse eid="PSA 117:2" /></para>
  <chapter eid="PSA 117" />
  <chapter number="118" style="c" sid="PSA 118" />
  <para style="s">जीतणे रिया तँईं तन्यवाद</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 118:1" />प्रभुए रा तन्यवाद करो, कऊँकि से पला ए</para>
  <para style="q" vid="PSA 118:1">ओर तेसरी करूणा सदा री ए!<verse eid="PSA 118:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 118:2" />इस्राएली लोक बोलो, “प्रभुए री करूणा सदा री ए।”<verse eid="PSA 118:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 118:3" />हारूणो रे वंशो रे पुरोईत ये बोलो, “प्रभुए री करूणा सदा री ए।”<verse eid="PSA 118:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 118:4" />प्रभुए री पग्ती करने वाल़े ये बोलो, “प्रभुए री करूणा सदा री ए।”<verse eid="PSA 118:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 118:5" />मैं मुसीबता दे परमेशरो खे आका पाईया,</para>
  <para style="q" vid="PSA 118:5">यहोवे माखे उत्तर दित्तेया ओर आऊँ मुसीबता ते छुड़ाया।<verse eid="PSA 118:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 118:6" />प्रभु मेरे पक्षो रे ए, मां नि डरना।</para>
  <para style="q" vid="PSA 118:6">माणूं मेरा कुछ नि करी सकदा।<note caller="+" style="f"><char style="fr" closed="false">118:6 </char><char style="ft" closed="false">रोमी 8:31, इब्रानी 13:6</char></note><verse eid="PSA 118:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 118:7" />प्रभु मेरे पक्षो रे ए, से मेरी मताद करने वाल़ा ए;</para>
  <para style="q" vid="PSA 118:7">माखे आपणियां आखी ते दिशणा कि मेरे दुश्मण आरी गे।<verse eid="PSA 118:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 118:8" />प्रभुए री शरणा रे जाणा,</para>
  <para style="q" vid="PSA 118:8">माणूंआ पाँदे परोसा राखणे ते खरा ए।<verse eid="PSA 118:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 118:9" />प्रभुए री शरणा रे जाणा,</para>
  <para style="q" vid="PSA 118:9">परदाना पाँदे परोसा राखणे ते खरा ए।<verse eid="PSA 118:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 118:10" />सबी जातिये आऊँ केरी ला रा;</para>
  <para style="q" vid="PSA 118:10">पर प्रभुए रे नाओं ते मां सेयो पक्का नाश करी देणे।<verse eid="PSA 118:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 118:11" />तिने आऊँ केरी ला रा, पक्का तिने आऊँ केरी ला रा;</para>
  <para style="q" vid="PSA 118:11">पर प्रभुए रे नाओं ते मां सेयो पक्का नाश करी देणे।<verse eid="PSA 118:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 118:12" />तिने आऊँ पँऊरी जेड़ा केरी ता रा, सेयो कांडेया री आगी जेड़े चट बीजी गे;</para>
  <para style="q" vid="PSA 118:12">पर प्रभुए रे नाओं ते मां सेयो पक्का नाश करी देणे।<verse eid="PSA 118:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 118:13" />माखे रूड़ाणे रिया तँईं तैं माखे जोरे की ताक्का तो दित्तेया था,</para>
  <para style="q" vid="PSA 118:13">पर यहोवे मेरी मताद कित्ती।<verse eid="PSA 118:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 118:14" />यहोवा मेरी तागत ओर पजनो रा विषय ए;</para>
  <para style="q" vid="PSA 118:14">तिने आँऊ दुश्मणा ते बचाई राखेया।<verse eid="PSA 118:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 118:15" />परमेशरो रे तर्मी लोका रे तम्बूए दे जयजयकार ओर उद्धारो री आवाज ऊणे लगी री,</para>
  <para style="q" vid="PSA 118:15">यहोवे रिये पराक्रमी तागती ये करी राखेया ए।<verse eid="PSA 118:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 118:16" />यहोवे रा दाँणा आथ महान् ऊईरा,</para>
  <para style="q" vid="PSA 118:16">यहोवे रे दाँणे आथो ते पराक्रमो रा काम ओआ!<verse eid="PSA 118:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 118:17" />आऊँ नि मरना, बल्कि जिऊँदा रणा</para>
  <para style="q" vid="PSA 118:17">ओर मां यहोवे रे कामा रा बखाण करदे रणा।<verse eid="PSA 118:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 118:18" />परमेशरे माखे बऊत कष्ट तो दित्तेया,</para>
  <para style="q" vid="PSA 118:18">पर आऊँ मौता रे वशो रे नि कित्तेया।<note caller="+" style="f"><char style="fr" closed="false">118:18 </char><char style="ft" closed="false">2 कुरिन्थ 6:9, इब्रानी 12:10,11</char></note><verse eid="PSA 118:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 118:19" />माखे न्याय रे मन्दरो रे द्वार खोलो,</para>
  <para style="q" vid="PSA 118:19">मां तिदे जाई की यहोवे रा तन्यवाद करना।<verse eid="PSA 118:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 118:20" />प्रभुए रा द्वार येईए,</para>
  <para style="q" vid="PSA 118:20">इदे तर्मिया प्रवेश करना।<note caller="+" style="f"><char style="fr" closed="false">118:20 </char><char style="ft" closed="false">यूह. 10:9</char></note><verse eid="PSA 118:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PSA 118:21" />ओ प्रभु, मां तेरा तन्यवाद करना,</para>
  <para style="q" vid="PSA 118:21">कऊँकि तैं मेरी प्रार्थना सुणी की माखे उत्तर देई राखेया,</para>
  <para style="q" vid="PSA 118:21">तैं आऊँ मेरेया दुश्मणा ते बचाई राखेया।<verse eid="PSA 118:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="PSA 118:22" />जो पात्थर राजमिस्त्रिए नबाग ठराया था,</para>
  <para style="q" vid="PSA 118:22">सेई कुणे री निऊँआ रा पात्थर बणीगा।<note caller="+" style="f"><char style="fr" closed="false">118:22 </char><char style="ft" closed="false">1 पत 2:4, लूक 20:17</char></note><verse eid="PSA 118:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="PSA 118:23" />ये काम प्रभुए राए</para>
  <para style="q" vid="PSA 118:23">ओर ये म्हारी नजरा रे अद्भुत ए।<verse eid="PSA 118:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="PSA 118:24" />आजका दिन प्रभुए बणाई राखेया;</para>
  <para style="q" vid="PSA 118:24">आसे इदे मगन ओर खुश ओईये।<verse eid="PSA 118:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="PSA 118:25" />ओ प्रभु, आसे तांते बिनती करूँए, आसा खे बचा!</para>
  <para style="q" vid="PSA 118:25">ओ प्रभु, आसे तांते बिनती करूँए, आसा खे कामयाबी दे!<verse eid="PSA 118:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="PSA 118:26" />तन्य ए से माणूं, जो प्रभुए रे नाओं ते आओआ!</para>
  <para style="q" vid="PSA 118:26">आसे ताखे प्रभुए रे मन्दरो ते आशीर्वाद देई राखेया।<note caller="+" style="f"><char style="fr" closed="false">118:26 </char><char style="ft" closed="false">मत्ती 23:39, लूक 13:35, मरक 11:9,10, लूक 19:38</char></note><verse eid="PSA 118:26" /></para>
  <para style="q">
    <verse number="27" style="v" sid="PSA 118:27" />परमेशर यहोवा ए ओर तिने आसा खे प्रयासा देई राखेया।</para>
  <para style="q" vid="PSA 118:27">यज्ञो रे डांगरो खे बेदिया रे सींगो ते रस्सिया साथे बानो!<verse eid="PSA 118:27" /></para>
  <para style="q">
    <verse number="28" style="v" sid="PSA 118:28" />ओ प्रभु, तूँई मेरा परमेशर ए, मां तेरा तन्यवाद करना;</para>
  <para style="q" vid="PSA 118:28">तूँ मेरा परमेशर ए, मां तेरा गुणगाण करना।<verse eid="PSA 118:28" /></para>
  <para style="q">
    <verse number="29" style="v" sid="PSA 118:29" />प्रभुए रा तन्यवाद करो, कऊँकि से पला ए;</para>
  <para style="q" vid="PSA 118:29">ओर तेसरी करूणा सदा बणी री रणी!<verse eid="PSA 118:29" /></para>
  <chapter eid="PSA 118" />
  <chapter number="119" style="c" sid="PSA 119" />
  <para style="s">परमेशरो रा बिदान सबी ते खरा ए</para>
  <para style="d">आलेफ</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 119:1" />सेयो माणूं बऊत ई तन्य ए जिना रा चाल-चलण निर्दोष ए,</para>
  <para style="q" vid="PSA 119:1">ओर जो प्रभुए रे बिधि-बिधानो पाँदे हांडोए!<verse eid="PSA 119:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 119:2" />सेयो बऊत ई तन्य ए, जो प्रभुए री चतौणिया खे मानोए,</para>
  <para style="q" vid="PSA 119:2">ओर आपणे पूरे मनो ते प्रभुए खे टोल़ोए!<verse eid="PSA 119:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 119:3" />तेबे सेयो बुरे काम नि करदे,</para>
  <para style="q" vid="PSA 119:3">बल्कि यहोवे री बताई रिया बाटा रे हांडोए।<verse eid="PSA 119:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 119:4" />ओ यहोवा, तैं आसा खे आपणे नियम देई राखे,</para>
  <para style="q" vid="PSA 119:4">ओर बोलेया कि आसे तिना रा ईमानदारिया ते पाल़न करूँगे।<verse eid="PSA 119:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 119:5" />पला ऊँदा कि तेरी बिदिया खे मानणे रिया तँईं</para>
  <para style="q" vid="PSA 119:5">मेरा चाल-चलण मजबूत ऊई जांदा!<verse eid="PSA 119:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 119:6" />प्रभु, तेबे मां तेरी सारिया आज्ञा रिया तरफा खे आपणा त्यान लगाए रे राखणा</para>
  <para style="q" vid="PSA 119:6">ओर मेरी उम्मीद नि टूटणी।<verse eid="PSA 119:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 119:7" />जेबे मां तेरे तार्मिक नियम सीखणे,</para>
  <para style="q" vid="PSA 119:7">तेबे निष्कपट दिलो ते मां तेरा तन्यवाद करना।<verse eid="PSA 119:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 119:8" />मां तेरिया बिदिया रा पाल़न करना:</para>
  <para style="q" vid="PSA 119:8">प्रभु, तूँ माखे कदी पनि छाडेया!</para>
  <para style="s" vid="PSA 119:8">परमेशरो रे बिधानो खे मानणा</para>
  <para style="d" vid="PSA 119:8">बेथ<verse eid="PSA 119:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 119:9" />जवान आपणे चाल-चलणो खे किंयाँ शुद्ध राखी सकोआ?</para>
  <para style="q" vid="PSA 119:9">प्रभु, तेरे वचनो रा पाल़न करने ते।<verse eid="PSA 119:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 119:10" />पूरे दिलो ते आऊँ तेरी सेवा करने री कोशिश करूँआ;</para>
  <para style="q" vid="PSA 119:10">माखे तू आपणियां आज्ञा ते पटकणे नि देया!<verse eid="PSA 119:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 119:11" />मैं तेरे वचन आपणे दिलो रे तारण करी राखे,</para>
  <para style="q" vid="PSA 119:11">ताकि तेरे खलाफ पाप नि करुँ।<verse eid="PSA 119:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 119:12" />ओ प्रभु, तूँ तन्य ए;</para>
  <para style="q" vid="PSA 119:12">माखे आपणी बिदिया सखाई दे!<verse eid="PSA 119:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 119:13" />तेरे सारे नियमा रा बखाण</para>
  <para style="q" vid="PSA 119:13">मैं आपणे मुंए ते करी राखेया।<verse eid="PSA 119:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 119:14" />आऊँ तेरिया चतौणिया रिया बाटा ते खुश ऊईरा,</para>
  <para style="q" vid="PSA 119:14">मानो कि आँऊ सब प्रकारा री तअन-दौलता ते खुश ऊईरा।<verse eid="PSA 119:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 119:15" />मां तेरे उपदेशा पाँदे त्यान करना</para>
  <para style="q" vid="PSA 119:15">ओर मां तेरिया बताईया रिया बाटा रिया तरफा खे नजर राखणी<verse eid="PSA 119:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 119:16" />मां तेरी बिदिया ते खुश रणा</para>
  <para style="q" vid="PSA 119:16">ओर मां तेरे वचन नि पूलणे।</para>
  <para style="s" vid="PSA 119:16">परमेशरो रे बिधानो दे खुशी</para>
  <para style="d" vid="PSA 119:16">गिमेल<verse eid="PSA 119:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 119:17" />प्रभु, आपणे दासो पाँदे उपकार कर ताकि आऊँ जिऊँदा रई सकूँ</para>
  <para style="q" vid="PSA 119:17">ओर तेरे वचना रा पाल़न करी सकूँ।<verse eid="PSA 119:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 119:18" />तूँ मेरिया आखी खोली दे,</para>
  <para style="q" vid="PSA 119:18">ताकि आऊँ तेरे बिधानो रिया सच्चाईया रिया नौखिया गल्ला देखी सकूँ।<verse eid="PSA 119:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 119:19" />आऊँ तो तरतिया पाँदे परदेशी ए;</para>
  <para style="q" vid="PSA 119:19">प्रभु, आपणियां आज्ञा मांते नि लको।<verse eid="PSA 119:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 119:20" />आऊँ तो हर बखत तेरे नियमा रा पाल़न करना चाऊँआ। आऊँ इजी खे सबी चीजा ते जादा चाऊँआ।<verse eid="PSA 119:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PSA 119:21" />तूँ कमण्डिया खे, जो स्रापित ए, डाँटेया,</para>
  <para style="q" vid="PSA 119:21">सेयो तेरिया आज्ञा ते पटकी गे रे।<verse eid="PSA 119:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="PSA 119:22" />आऊँ तेरिया बिदिया रा पाल़न करूँआ।</para>
  <para style="q" vid="PSA 119:22">इजी खे लोक मेरी निन्दा नि करी सको, एड़ा नि ओ कि आऊँ बेज्जत ऊई जाऊँ।<verse eid="PSA 119:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="PSA 119:23" />परदान बी बैठी की मेरे खलाफ गल्ला करो थे,</para>
  <para style="q" vid="PSA 119:23">पर आऊँ तेरी बिदिया खे मनो दे सोचदा रऊँआ।<verse eid="PSA 119:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="PSA 119:24" />तेरिया बिदिया ते माखे खुशी मिलोई!</para>
  <para style="q" vid="PSA 119:24">तेरिया बिदिया मेरिया तँईं सलाई देणे वाल़े जेड़िया ए।</para>
  <para style="s" vid="PSA 119:24">परमेशरो रे बिधानो खे मानणे रा संकल्प</para>
  <para style="d" vid="PSA 119:24">दाल्थ<verse eid="PSA 119:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="PSA 119:25" />आऊँ चट ई मरने वाल़ा ए,</para>
  <para style="q" vid="PSA 119:25">प्रभु, तूँ आपणे वचनो रे मुताबिक माखे फेर जिऊँदा कर!<verse eid="PSA 119:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="PSA 119:26" />जेबे मैं आपणे चाल-चलणो रे बारे तांगे बताया,</para>
  <para style="q" vid="PSA 119:26">तेबे तैं माखे उत्तर दित्तेया; तूँ माखे आपणी बिदिया सखाई दे!<verse eid="PSA 119:26" /></para>
  <para style="q">
    <verse number="27" style="v" sid="PSA 119:27" />तेरिया बिदिया खे समजणे खे मेरी मताद कर,</para>
  <para style="q" vid="PSA 119:27">तेबे मां तेरे अचम्बे रे कामा पाँदे त्यान करना।<verse eid="PSA 119:27" /></para>
  <para style="q">
    <verse number="28" style="v" sid="PSA 119:28" />आऊँ इतणा उदास ऊईगा रा ए कि मांदे ओर तागत नि ए।</para>
  <para style="q" vid="PSA 119:28">तूँ आपणे वचनो रे मुताबिक माखे सम्बाल़!<verse eid="PSA 119:28" /></para>
  <para style="q">
    <verse number="29" style="v" sid="PSA 119:29" />प्रभु, तूँ माखे गल़त काम करने ते रोक,</para>
  <para style="q" vid="PSA 119:29">ओर माखे आपणी बिधान सखाई की मां पाँदे दया कर।<verse eid="PSA 119:29" /></para>
  <para style="q">
    <verse number="30" style="v" sid="PSA 119:30" />मैं सच्चाईया री बाट चूणी ली री,</para>
  <para style="q" vid="PSA 119:30">आऊँ तेरे नियमा रिया तरफा खे चित्त लगाई राखूँआ।<verse eid="PSA 119:30" /></para>
  <para style="q">
    <verse number="31" style="v" sid="PSA 119:31" />ओ प्रभु, आऊँ तेरिया शिक्षा दे चिपकेया राए,</para>
  <para style="q" vid="PSA 119:31">माखे शर्मिंदा नि ऊणे देया!<verse eid="PSA 119:31" /></para>
  <para style="q">
    <verse number="32" style="v" sid="PSA 119:32" />आऊँ हर बखत तेरिया आज्ञा रा पाल़न करना चाऊँआ।</para>
  <para style="q" vid="PSA 119:32">तिना खे जादा ते जादा समजणे रे मेरी मताद कर।</para>
  <para style="s" vid="PSA 119:32">समजा रिया तँईं प्रार्थना</para>
  <para style="d" vid="PSA 119:32">हे<verse eid="PSA 119:32" /></para>
  <para style="q">
    <verse number="33" style="v" sid="PSA 119:33" />ओ यहोवा, माखे आपणियां बिदिया रा मतलब सखाई दे,</para>
  <para style="q" vid="PSA 119:33">ओर मां से जिन्दगी पर मानदे रणा।<note caller="+" style="f"><char style="fr" closed="false">119:33 </char><char style="ft" closed="false">मेरा ईनाम तिना खे राखणे दे ऊणा</char></note><verse eid="PSA 119:33" /></para>
  <para style="q">
    <verse number="34" style="v" sid="PSA 119:34" />माखे समजदे, ताकि आऊँ तेरे बिधानो खे मानदा रऊँ</para>
  <para style="q" vid="PSA 119:34">ओर पूरे मनो ते तिजी रा पाल़न करुँ।<verse eid="PSA 119:34" /></para>
  <para style="q">
    <verse number="35" style="v" sid="PSA 119:35" />आपणी आज्ञा रिया बाटा रे माखे चला,</para>
  <para style="q" vid="PSA 119:35">कऊँकि आऊँ तिजी तेई खुश ए।<verse eid="PSA 119:35" /></para>
  <para style="q">
    <verse number="36" style="v" sid="PSA 119:36" />प्रभु, मेरे दिलो खे लाल़चो रिया तरफा खे नि,</para>
  <para style="q" vid="PSA 119:36">पर आपणियां शिक्षा रिया तरफा खेई फेरी दे।<verse eid="PSA 119:36" /></para>
  <para style="q">
    <verse number="37" style="v" sid="PSA 119:37" />चूठेया देवतेया रिया तरफा ते मेरिया आखी टाई दे;</para>
  <para style="q" vid="PSA 119:37">तूँ माखे आपणी बाटा रिया तँईं जिन्दगी दे।<verse eid="PSA 119:37" /></para>
  <para style="q">
    <verse number="38" style="v" sid="PSA 119:38" />तेरा वादा जो तेरा डर मानणे वाल़ेया खे ए,</para>
  <para style="q" vid="PSA 119:38">तिजी खे आपणे दासो रिया खातर बी पूरा कर।<verse eid="PSA 119:38" /></para>
  <para style="q">
    <verse number="39" style="v" sid="PSA 119:39" />मेरी निंदा दूर कर, तिजी ते आऊँ डरूँआ;</para>
  <para style="q" vid="PSA 119:39">कऊँकि तेरे नियम सबी ते खरे ए।<verse eid="PSA 119:39" /></para>
  <para style="q">
    <verse number="40" style="v" sid="PSA 119:40" />आऊँ तेरिया बिदिया रे मुताबिक आपणा जीवन जिऊणा चाऊँआ;</para>
  <para style="q" vid="PSA 119:40">माखे नवां जीवन दे कऊँकि तूँ तर्मी आ।</para>
  <para style="s" vid="PSA 119:40">परमेशरो रे बिधानो पाँदे परोसा</para>
  <para style="d" vid="PSA 119:40">वाव<verse eid="PSA 119:40" /></para>
  <para style="q">
    <verse number="41" style="v" sid="PSA 119:41" />ओ यहोवा, तूँ एसा गल्ला खे प्रकट कर कि तूँ मांते कितणा प्यार करेया,</para>
  <para style="q" vid="PSA 119:41">तूँ माखे बचा जेड़ा तैं आपू बोलेया ए।<verse eid="PSA 119:41" /></para>
  <para style="q">
    <verse number="42" style="v" sid="PSA 119:42" />तेबे आऊँ मेरी निंदा करने वाल़ेया खे कुछ उत्तर देई सकूँआ,</para>
  <para style="q" vid="PSA 119:42">कऊँकि आँऊ तेरे वचना पाँदे परोसा करूँआ।<verse eid="PSA 119:42" /></para>
  <para style="q">
    <verse number="43" style="v" sid="PSA 119:43" />माखे सच्चे वचन बोलणे ते नि रोक,</para>
  <para style="q" vid="PSA 119:43">कऊँकि मेरी उम्मीद तेरे नियमा पाँदे ए।<verse eid="PSA 119:43" /></para>
  <para style="q">
    <verse number="44" style="v" sid="PSA 119:44" />मां तेरे बिधानो रा लगातार</para>
  <para style="q" vid="PSA 119:44">जुगो-जुगो तक पाल़न करदे रणा;<verse eid="PSA 119:44" /></para>
  <para style="q">
    <verse number="45" style="v" sid="PSA 119:45" />मां आजादिया साथे आपणी जिन्दगी बिताणी;</para>
  <para style="q" vid="PSA 119:45">कऊँकि आऊँ तेरे उपदेशा रा पाल़न करने री कोशिश करूँआ।<verse eid="PSA 119:45" /></para>
  <para style="q">
    <verse number="46" style="v" sid="PSA 119:46" />मां राजेया रे सामणे तेरिया शिक्षा री चर्चा करेया करनी</para>
  <para style="q" vid="PSA 119:46">ओर शर्म नि करनी,<note caller="+" style="f"><char style="fr" closed="false">119:46 </char><char style="ft" closed="false">रोमी 1:16</char></note><verse eid="PSA 119:46" /></para>
  <para style="q">
    <verse number="47" style="v" sid="PSA 119:47" />कऊँकि आऊँ तेरिया आज्ञा ते खुश ए</para>
  <para style="q" vid="PSA 119:47">ओर तिना ते आऊँ प्यार करूँआ।<verse eid="PSA 119:47" /></para>
  <para style="q">
    <verse number="48" style="v" sid="PSA 119:48" />मां तेरिया आज्ञा रिया तरफा खे, जिना ते आऊँ प्यार करूँआ,</para>
  <para style="q" vid="PSA 119:48">आपणे आथ फैलाणे ओर तेरिया बिदिया पाँदे त्यान करना।</para>
  <para style="s" vid="PSA 119:48">परमेशरो रे बिधानो पाँदे उम्मीद</para>
  <para style="d" vid="PSA 119:48">जै़न<verse eid="PSA 119:48" /></para>
  <para style="q">
    <verse number="49" style="v" sid="PSA 119:49" />प्रभु, आपणे दासो ते कित्ते रे वादे खे याद कर,</para>
  <para style="q" vid="PSA 119:49">कऊँकि तैं माखे उम्मीद देई राखी।<verse eid="PSA 119:49" /></para>
  <para style="q">
    <verse number="50" style="v" sid="PSA 119:50" />मेरे दु:खो दे माखे शान्ति तिजी तेई ऊई री,</para>
  <para style="q" vid="PSA 119:50">कऊँकि तेरे वचनो रे जरिए मैं जिन्दगी पाई राखी।<verse eid="PSA 119:50" /></para>
  <para style="q">
    <verse number="51" style="v" sid="PSA 119:51" />जबकि कमण्डी माणूंए मेरा बऊत मजाक डवाया,</para>
  <para style="q" vid="PSA 119:51">तेबे बी आऊँ तेरे बिधि-बिधानो ते नि अटेया।<verse eid="PSA 119:51" /></para>
  <para style="q">
    <verse number="52" style="v" sid="PSA 119:52" />ओ प्रभु, मैं तेरे पुराणे नियम याद करी की</para>
  <para style="q" vid="PSA 119:52">शान्ति पाई राखी।<verse eid="PSA 119:52" /></para>
  <para style="q">
    <verse number="53" style="v" sid="PSA 119:53" />जिने दुष्ट माणूंए तेरा बिधान छाडीता रा,</para>
  <para style="q" vid="PSA 119:53">तिना रिया बजा ते आऊँ गुस्से ते लाल ऊणे लगी रा।<verse eid="PSA 119:53" /></para>
  <para style="q">
    <verse number="54" style="v" sid="PSA 119:54" />जेती आऊँ परदेशी ऊई की रऊँआ,</para>
  <para style="q" vid="PSA 119:54">तेती तेरिया बिदिया, मेरे गीत बणी रे।<verse eid="PSA 119:54" /></para>
  <para style="q">
    <verse number="55" style="v" sid="PSA 119:55" />ओ प्रभु, आँऊ राती तेरा नाओं याद करूँआ</para>
  <para style="q" vid="PSA 119:55">ओर तेरे बिधानो रा पाल़न करूँआ।<verse eid="PSA 119:55" /></para>
  <para style="q">
    <verse number="56" style="v" sid="PSA 119:56" />ये मांते इजी बजा ते ऊआ,</para>
  <para style="q" vid="PSA 119:56">कऊँकि मैं तेरे उपदेश माने।</para>
  <para style="s" vid="PSA 119:56">परमेशरो रे बिधानो रिया तँईं पग्ती</para>
  <para style="d" vid="PSA 119:56">हेथ<verse eid="PSA 119:56" /></para>
  <para style="q">
    <verse number="57" style="v" sid="PSA 119:57" />प्रभु, तूँ मेरा सब कुछ ए;</para>
  <para style="q" vid="PSA 119:57">मैं पक्का निश्चा करी ला रा कि मां तेरे वचनो रे मुताबिक चलणा।<verse eid="PSA 119:57" /></para>
  <para style="q">
    <verse number="58" style="v" sid="PSA 119:58" />आऊँ तांते ते पूरे दिलो ते बिनती करूँआ कि तुँ मां पाँदे दया कर,</para>
  <para style="q" vid="PSA 119:58">जेड़ा तैं आपू वादा कित्तेया था।<verse eid="PSA 119:58" /></para>
  <para style="q">
    <verse number="59" style="v" sid="PSA 119:59" />मैं आपणे बर्ताओ रे बारे दे सोचेया,</para>
  <para style="q" vid="PSA 119:59">ओर मैं तेरिया बिदिया रा पाल़न करने रा फैंसला कित्तेया ए।<verse eid="PSA 119:59" /></para>
  <para style="q">
    <verse number="60" style="v" sid="PSA 119:60" />मैं बिना देर कित्ते</para>
  <para style="q" vid="PSA 119:60">तेरी आज्ञा मानणे खे फुर्ती कित्ती।<verse eid="PSA 119:60" /></para>
  <para style="q">
    <verse number="61" style="v" sid="PSA 119:61" />दुष्ट माणूंए मेरे खलाफ जाल़ बिछाई राखेया ए,</para>
  <para style="q" vid="PSA 119:61">पर आऊँ तेरे बिधानो खे नि पूलदा।<verse eid="PSA 119:61" /></para>
  <para style="q">
    <verse number="62" style="v" sid="PSA 119:62" />तेरे तर्मो रे नियमा रिया बजा ते</para>
  <para style="q" vid="PSA 119:62">मां आदिया राती तेरा तन्यवाद करने खे उठणा।<verse eid="PSA 119:62" /></para>
  <para style="q">
    <verse number="63" style="v" sid="PSA 119:63" />आऊँ तिना सबी रा दोस्त आ जो तेरा आदर करोए,</para>
  <para style="q" vid="PSA 119:63">तिना रा जो तेरिया बिदिया रा पाल़न करोए।<verse eid="PSA 119:63" /></para>
  <para style="q">
    <verse number="64" style="v" sid="PSA 119:64" />ओ प्रभु, तरती तेरी करूणा साथे परी रिये;</para>
  <para style="q" vid="PSA 119:64">तूँ माखे आपणी बिदिया सखा!</para>
  <para style="s" vid="PSA 119:64">परमेशरो रे बिधानो रा मोल</para>
  <para style="d" vid="PSA 119:64">टेथ<verse eid="PSA 119:64" /></para>
  <para style="q">
    <verse number="65" style="v" sid="PSA 119:65" />ओ प्रभु, तैं आपणे वादे रे मुताबिक</para>
  <para style="q" vid="PSA 119:65">आपणे दास मां साथे पलाई करी राखी।<verse eid="PSA 119:65" /></para>
  <para style="q">
    <verse number="66" style="v" sid="PSA 119:66" />माखे बुद्धि ओर ज्ञान दे,</para>
  <para style="q" vid="PSA 119:66">कऊँकि आऊँ तेरिया आज्ञा पाँदे परोसा करूँआ।<verse eid="PSA 119:66" /></para>
  <para style="q">
    <verse number="67" style="v" sid="PSA 119:67" />दु:खी ऊणे ते पईले आऊँ पटकी गा था;</para>
  <para style="q" vid="PSA 119:67">पर एबे आऊँ तेरे वचना खे मानूँआ।<verse eid="PSA 119:67" /></para>
  <para style="q">
    <verse number="68" style="v" sid="PSA 119:68" />ओ यहोवा, तूँ पला ए ओर पलाई करेया;</para>
  <para style="q" vid="PSA 119:68">माखे आपणी बिदिया सखा।<verse eid="PSA 119:68" /></para>
  <para style="q">
    <verse number="69" style="v" sid="PSA 119:69" />कमण्डी माणूंए तो मेरे खलाफ चूठिया गल्ला बणाईया,</para>
  <para style="q" vid="PSA 119:69">पर आँऊ तेरे उपदेशा खे पूरे दिलो ते मानूँआ।<verse eid="PSA 119:69" /></para>
  <para style="q">
    <verse number="70" style="v" sid="PSA 119:70" />तिना चूठेया माणूंआ खे बुद्धि नि ए,</para>
  <para style="q" vid="PSA 119:70">पर आऊँ तेरे बिधानो दे खुश रऊँआ।<verse eid="PSA 119:70" /></para>
  <para style="q">
    <verse number="71" style="v" sid="PSA 119:71" />माखे जो सजा मिली, से माखे ठीक ई ऊआ,</para>
  <para style="q" vid="PSA 119:71">जेतेते आऊँ तेरिया बिदिया सीखी सकूँ।<verse eid="PSA 119:71" /></para>
  <para style="q">
    <verse number="72" style="v" sid="PSA 119:72" />सूईने-चाँदिए रे ह्जारो टुकड़ेया रे बजाए</para>
  <para style="q" vid="PSA 119:72">तेरा बिधान माखे बऊत खरा ए।</para>
  <para style="s" vid="PSA 119:72">परमेशरो रे बिधानो रा न्याय</para>
  <para style="d" vid="PSA 119:72">योध<verse eid="PSA 119:72" /></para>
  <para style="q">
    <verse number="73" style="v" sid="PSA 119:73" />तैं आपणे आथा साथे आऊँ बणाई राखेया ओर माखे आकार दित्तेया;</para>
  <para style="q" vid="PSA 119:73">एबे माखे समजदे, ताकि आऊँ तेरिया आज्ञा खे सिखी सकूँ।<verse eid="PSA 119:73" /></para>
  <para style="q">
    <verse number="74" style="v" sid="PSA 119:74" />जो तांते डरोए, सेयो माखे देखी की खुश ऊणे,</para>
  <para style="q" vid="PSA 119:74">कऊँकि मैं तेरे वचना पाँदे उम्मीद लगाई राखी।<verse eid="PSA 119:74" /></para>
  <para style="q">
    <verse number="75" style="v" sid="PSA 119:75" />ओ यहोवा, माखे पता ए कि तेरा न्याय सच्चा ए,</para>
  <para style="q" vid="PSA 119:75">ओर तैं माखे तेड़ी सजा दित्ती कऊँकि तूँ वफादार ए।<verse eid="PSA 119:75" /></para>
  <para style="q">
    <verse number="76" style="v" sid="PSA 119:76" />माखे आपणी करूणा साथे शान्ति दे,</para>
  <para style="q" vid="PSA 119:76">कऊँकि तैं आपणे दासो ते एड़ा ई वादा करी राखेया।<verse eid="PSA 119:76" /></para>
  <para style="q">
    <verse number="77" style="v" sid="PSA 119:77" />तेरी असीम दया मां पाँदे ओ, जेतेते आऊँ जिऊँदा रऊँ;</para>
  <para style="q" vid="PSA 119:77">कऊँकि आऊँ तेरे बिधानो ते खुश ए।<verse eid="PSA 119:77" /></para>
  <para style="q">
    <verse number="78" style="v" sid="PSA 119:78" />कमण्डी माणूं शर्मिंदा ओ, तिने मां पाँदे चूठा आरोप लगाया ए,</para>
  <para style="q" vid="PSA 119:78">पर मां तेरे उपदेशा पाँदे त्यान करना।<verse eid="PSA 119:78" /></para>
  <para style="q">
    <verse number="79" style="v" sid="PSA 119:79" />जो तांते डरोए, सेयो मां कनारो खे फिरो,</para>
  <para style="q" vid="PSA 119:79">जेतेते सेयो तेरिया शिक्षा खे समजी लओ।<verse eid="PSA 119:79" /></para>
  <para style="q">
    <verse number="80" style="v" sid="PSA 119:80" />आऊँ निष्कपट दिलो ते बिदिया रा पाल़न करुँ,</para>
  <para style="q" vid="PSA 119:80">ताकि माखे शर्मिंदा नि ऊणा पड़ो।</para>
  <para style="s" vid="PSA 119:80">छुटकारे रिया तँईं प्रार्थना</para>
  <para style="d" vid="PSA 119:80">क़ाफ<verse eid="PSA 119:80" /></para>
  <para style="q">
    <verse number="81" style="v" sid="PSA 119:81" />ओ यहोवा, आऊँ मरने पाँदे आ, न्याल़ेया करूँआ कि तां आऊँ बचाणा;</para>
  <para style="q" vid="PSA 119:81">पर आऊँ तेरे वचना पाँदे परोसा करूँआ।<verse eid="PSA 119:81" /></para>
  <para style="q">
    <verse number="82" style="v" sid="PSA 119:82" />मेरिया आखी तेरा वादा पूरा ऊँदे ऊए देखणे रिया तँईं बेचैन इया</para>
  <para style="q" vid="PSA 119:82">ओर आऊँ ये पुछूँआ कि तां माखे कदी शान्ति देणी?<verse eid="PSA 119:82" /></para>
  <para style="q">
    <verse number="83" style="v" sid="PSA 119:83" />कऊँकि आऊँ तुएँ ते तुँदल़िया पड़ी री कुप्पिया जेड़ा ऊईगा रा,</para>
  <para style="q" vid="PSA 119:83">तेबे बी आऊँ तेरिया बिदिया खे नि पूलेया।<verse eid="PSA 119:83" /></para>
  <para style="q">
    <verse number="84" style="v" sid="PSA 119:84" />ओ यहोवा, आऊँ तेरी सेवा करूँआ, आऊँ एते दु:खो दे कदुओ तक पड़ेया दा रणा?</para>
  <para style="q" vid="PSA 119:84">जो मेरा पीछा करने लगी रे; तिना खे सजा तां कदी देणी?<verse eid="PSA 119:84" /></para>
  <para style="q">
    <verse number="85" style="v" sid="PSA 119:85" />कमण्डी लोक जो तेरे बिधानो रे मुताबिक नि चलदे,</para>
  <para style="q" vid="PSA 119:85">तिने माखे रूड़ाणे रिया तँईं गड्डे खणी राखे।<verse eid="PSA 119:85" /></para>
  <para style="q">
    <verse number="86" style="v" sid="PSA 119:86" />तेरिया सारिया आज्ञा परोसा करने जोगिया ए;</para>
  <para style="q" vid="PSA 119:86">सेयो लोक चूठो खेई मां पीछे पड़ी रे; प्रभु, तूँ मेरी मताद कर!<verse eid="PSA 119:86" /></para>
  <para style="q">
    <verse number="87" style="v" sid="PSA 119:87" />सेयो माखे तरतिया पाँदा ते तकरीबन मिटाणे ई वाल़े थे,</para>
  <para style="q" vid="PSA 119:87">पर मैं तेरे उपदेश नि छाडे।<verse eid="PSA 119:87" /></para>
  <para style="q">
    <verse number="88" style="v" sid="PSA 119:88" />प्रभु, आपणियां दया ते माखे फेर जिऊँदा कर,</para>
  <para style="q" vid="PSA 119:88">ताकि आऊँ तेरिया दित्ती रिया शिक्षा रा पाल़न करी सकूँ।<verse eid="PSA 119:88" /></para>
  <para style="q">
    <verse number="89" style="v" sid="PSA 119:89" />ओ यहोवा, तेरा वचन,</para>
  <para style="q" vid="PSA 119:89">सर्गो दे सदा खे बणेया रा रओ।<verse eid="PSA 119:89" /></para>
  <para style="q">
    <verse number="90" style="v" sid="PSA 119:90" />तेरी सच्चाई पीढ़िया ते पीढ़िया तक बणी री रओई;</para>
  <para style="q" vid="PSA 119:90">तैं तरती स्थिर कित्ती, तेबेई तो से बणी री ए।<verse eid="PSA 119:90" /></para>
  <para style="q">
    <verse number="91" style="v" sid="PSA 119:91" />सर्ग ओर तरती तेरे नियमा रे मुताबिक आजो तक बणे रे ए;</para>
  <para style="q" vid="PSA 119:91">कऊँकि सारी सृष्टि तेरे वशो दे ए।<verse eid="PSA 119:91" /></para>
  <para style="q">
    <verse number="92" style="v" sid="PSA 119:92" />जे आऊँ तेरे बिधानो ते खुश नि ऊँदा,</para>
  <para style="q" vid="PSA 119:92">तो आऊँ बिपदा रेई बखते नाश ऊई जांदा।<verse eid="PSA 119:92" /></para>
  <para style="q">
    <verse number="93" style="v" sid="PSA 119:93" />मां तेरे उपदेश कदी नि पूलणे;</para>
  <para style="q" vid="PSA 119:93">कऊँकि तिना रेई जरिए तैं आऊँ जिऊँदा करी राखेया।<verse eid="PSA 119:93" /></para>
  <para style="q">
    <verse number="94" style="v" sid="PSA 119:94" />ओ यहोवा, आऊँ तेरा ईए, तूँ मेरी रक्षा कर;</para>
  <para style="q" vid="PSA 119:94">आऊँ तेरिया बिदिया रिया सारिया गल्ला मानदा रया।<verse eid="PSA 119:94" /></para>
  <para style="q">
    <verse number="95" style="v" sid="PSA 119:95" />दुष्ट मेरा नाश करने रिया तँईं मेरिया ताका रे लगी रे;</para>
  <para style="q" vid="PSA 119:95">पर आऊँ तेरिया शिक्षा पाँदे त्यान करूँआ।<verse eid="PSA 119:95" /></para>
  <para style="q">
    <verse number="96" style="v" sid="PSA 119:96" />जितणी गल्ला पुरिया लगोईया, सेयो सब मैं अदूरिया पाईया,</para>
  <para style="q" vid="PSA 119:96">पर तेरिया आज्ञा रा विस्तार बड़ा ए।</para>
  <para style="s" vid="PSA 119:96">परमेशरो रे बिधानो रिया तँईं प्यार</para>
  <para style="d" vid="PSA 119:96">मीम<verse eid="PSA 119:96" /></para>
  <para style="q">
    <verse number="97" style="v" sid="PSA 119:97" />आह्! आऊँ तेरे बिधानो ते कितणा प्यार करूँआ!</para>
  <para style="q" vid="PSA 119:97">पूरा दिन मेरा त्यान तिजी पाँदे ई लगेया रा रओआ।<verse eid="PSA 119:97" /></para>
  <para style="q">
    <verse number="98" style="v" sid="PSA 119:98" />तूँ आपणी आज्ञा रे जरिए माखे आपणे दुश्मणा ते जादा अक्लमंद बणाएया,</para>
  <para style="q" vid="PSA 119:98">कऊँकि सेयो सदा मेरे मनो रे रओईया।<verse eid="PSA 119:98" /></para>
  <para style="q">
    <verse number="99" style="v" sid="PSA 119:99" />आऊँ आपणे सबी गुरूआ ते बी जादा समज राखूँआ,</para>
  <para style="q" vid="PSA 119:99">कऊँकि मेरा त्यान तेरिया शिक्षा पाँदे लगी रा।<verse eid="PSA 119:99" /></para>
  <para style="q">
    <verse number="100" style="v" sid="PSA 119:100" />आऊँ बुजुर्गा ते बी जादा समजदार ए,</para>
  <para style="q" vid="PSA 119:100">कऊँकि आऊँ तेरे उपदेशा खे मानूँआ।<verse eid="PSA 119:100" /></para>
  <para style="q">
    <verse number="101" style="v" sid="PSA 119:101" />आऊँ सब बुरे आचरणो ते दूर रया,</para>
  <para style="q" vid="PSA 119:101">कऊँकि आऊँ तेरे वचना रा पाल़न करना चाऊँआ।<verse eid="PSA 119:101" /></para>
  <para style="q">
    <verse number="102" style="v" sid="PSA 119:102" />आऊँ तेरे नियमा ते पीछे नि अटेया,</para>
  <para style="q" vid="PSA 119:102">कऊँकि तैंई माखे शिक्षा देई राखी।<verse eid="PSA 119:102" /></para>
  <para style="q">
    <verse number="103" style="v" sid="PSA 119:103" />तेरे वचन माखे बऊत मीठे लगोए,</para>
  <para style="q" vid="PSA 119:103">सेयो मेरे मुंए दे सईतो ते बी मीठे ए।<verse eid="PSA 119:103" /></para>
  <para style="q">
    <verse number="104" style="v" sid="PSA 119:104" />तेरे उपदेशा साथे आऊँ समजदार ऊई जाऊँआ,</para>
  <para style="q" vid="PSA 119:104">इजी री खातर आऊँ सारिया चूठिया बाटा ते कृणा करूँआ।</para>
  <para style="s" vid="PSA 119:104">परमेशरो रे बिधानो रा प्रयासा</para>
  <para style="d" vid="PSA 119:104">नून<verse eid="PSA 119:104" /></para>
  <para style="q">
    <verse number="105" style="v" sid="PSA 119:105" />तेरा वचन माखे सला देणे वाल़ा दिऊए जेड़ा ए</para>
  <para style="q" vid="PSA 119:105">ओर बाटा रिये चलणे खे प्रयासे जेड़ा ए।<verse eid="PSA 119:105" /></para>
  <para style="q">
    <verse number="106" style="v" sid="PSA 119:106" />मैं कसम खाई की ठाणी ला रा,</para>
  <para style="q" vid="PSA 119:106">कि मां तेरे तार्मिक नियमा रे मुताबिक चलणा।<verse eid="PSA 119:106" /></para>
  <para style="q">
    <verse number="107" style="v" sid="PSA 119:107" />आऊँ बऊत जादा दु:खो रे पड़ी रा;</para>
  <para style="q" vid="PSA 119:107">ओ प्रभु, आपणे वचनो रे मुताबिक माखे फेर जिऊँदा कर।<verse eid="PSA 119:107" /></para>
  <para style="q">
    <verse number="108" style="v" sid="PSA 119:108" />ओ प्रभु, आऊँ बिनती करूँआ कि मेरे मुंए री स्तुति-बलि ग्रहण कर</para>
  <para style="q" vid="PSA 119:108">ओर आपणे नियम माखे सखा।<verse eid="PSA 119:108" /></para>
  <para style="q">
    <verse number="109" style="v" sid="PSA 119:109" />आऊँ आपणी जान जोखिमो दे पाणे खे हमेशा त्यार आ;</para>
  <para style="q" vid="PSA 119:109">तेबे बी आऊँ तेरे बिधानो खे नि पूलेया।<verse eid="PSA 119:109" /></para>
  <para style="q">
    <verse number="110" style="v" sid="PSA 119:110" />दुष्ट लोके मेरिया तँईं जाल़ बछाई राखेया,</para>
  <para style="q" vid="PSA 119:110">पर आऊँ तेरे उपदेशा ते नि पटकेया।<verse eid="PSA 119:110" /></para>
  <para style="q">
    <verse number="111" style="v" sid="PSA 119:111" />तेरिया शिक्षा सदा माखे सबी ते किमती सम्पति ओर मेरिया खुशिया री बजा ए।<verse eid="PSA 119:111" /></para>
  <para style="q">
    <verse number="112" style="v" sid="PSA 119:112" />मैं आपणा मन इजी गल्ला पाँदे लगाई राखेया,</para>
  <para style="q" vid="PSA 119:112">कि अंतो तक तेरिया बिदिया पाँदे सदा चलदा रऊँ।</para>
  <para style="s" vid="PSA 119:112">परमेशरो रे बिधानो दे सलामती</para>
  <para style="d" vid="PSA 119:112">सामेख<verse eid="PSA 119:112" /></para>
  <para style="q">
    <verse number="113" style="v" sid="PSA 119:113" />आऊँ दूई तरफा खे चलणे वाल़े माणूंए ते कृणा करूँआ,</para>
  <para style="q" vid="PSA 119:113">पर तेरे बिधानो साथे प्यार राखूँआ।<verse eid="PSA 119:113" /></para>
  <para style="q">
    <verse number="114" style="v" sid="PSA 119:114" />मेरे शरण लणे री जगा ओर माखे बचाणे वाल़ा तूँ ई ए।;</para>
  <para style="q" vid="PSA 119:114">आऊँ तेरे वचना री उम्मीद करूँआ।<verse eid="PSA 119:114" /></para>
  <para style="q">
    <verse number="115" style="v" sid="PSA 119:115" />ओ बुरे काम करने वाल़ेयो, मांते दूर ऊई जाओ,</para>
  <para style="q" vid="PSA 119:115">ताकि आऊँ आपणे परमेशरो रिया आज्ञा खे मानूँ।<verse eid="PSA 119:115" /></para>
  <para style="q">
    <verse number="116" style="v" sid="PSA 119:116" />ओ प्रभु, आपणे वचनो रे मुताबिक माखे सम्बाल़,</para>
  <para style="q" vid="PSA 119:116">ताकि आऊँ जिऊँदा रऊँ ओर मेरी उम्मीद टूटणे नि देया!<verse eid="PSA 119:116" /></para>
  <para style="q">
    <verse number="117" style="v" sid="PSA 119:117" />प्रभु, माखे साअरा दे ताकि आऊँ बचेया रा रऊँ</para>
  <para style="q" vid="PSA 119:117">ओर मां लगातार तेरिया बिदिया पाँदे चित्त लगाई की राखणा।<verse eid="PSA 119:117" /></para>
  <para style="q">
    <verse number="118" style="v" sid="PSA 119:118" />जो माणूं तेरिया बिदिया ते पटकी जाओए,</para>
  <para style="q" vid="PSA 119:118">तिना सबी खे तूँ तुच्छ जाणेया, कऊँकि तिना री उशयारी चूठी ए।<verse eid="PSA 119:118" /></para>
  <para style="q">
    <verse number="119" style="v" sid="PSA 119:119" />जिंयाँ धातुआ रा मैल तोया जाओआ तिंयाँ तूँ तरतिया रे सारे दुष्टा खे तोई देया;</para>
  <para style="q" vid="PSA 119:119">इजी बजा ते आऊँ तेरिया शिक्षा साथे प्यार राखूँआ।<verse eid="PSA 119:119" /></para>
  <para style="q">
    <verse number="120" style="v" sid="PSA 119:120" />प्रभु, तेरे डरो रे मारे मेरा शरीर थरथराओआ</para>
  <para style="q" vid="PSA 119:120">ओर आऊँ तेरे नियमा ते डरूँआ।</para>
  <para style="s" vid="PSA 119:120">परमेशरो रे बिधानो खे मानणा</para>
  <para style="d" vid="PSA 119:120">ऐन<verse eid="PSA 119:120" /></para>
  <para style="q">
    <verse number="121" style="v" sid="PSA 119:121" />मैं सेई काम करी राखे जो न्याय ओर सच्चे ए।</para>
  <para style="q" vid="PSA 119:121">तूँ माखे मेरेया दुश्मणा बीचे नि छाडेया!<verse eid="PSA 119:121" /></para>
  <para style="q">
    <verse number="122" style="v" sid="PSA 119:122" />आपणे दास मेरिया पलाईया खे तूँ आपू जमानत दे,</para>
  <para style="q" vid="PSA 119:122">ताकि कमण्डी मां पाँदे अन्देर नि करी सको।<verse eid="PSA 119:122" /></para>
  <para style="q">
    <verse number="123" style="v" sid="PSA 119:123" />मेरिया आखी तांते उद्धार पाणे खे</para>
  <para style="q" vid="PSA 119:123">ओर तेरा तार्मिक वादा पूरा ऊँदे ऊए देखणे रिया तँईं बेचैन इया।<verse eid="PSA 119:123" /></para>
  <para style="q">
    <verse number="124" style="v" sid="PSA 119:124" />आपणे दास मां साथे आपणी करूणा रे मुताबिक बर्ताव कर</para>
  <para style="q" vid="PSA 119:124">ओर आपणियां बिदिया माखे सखा।<verse eid="PSA 119:124" /></para>
  <para style="q">
    <verse number="125" style="v" sid="PSA 119:125" />आऊँ तेरा दास ए, तूँ माखे समजदे,</para>
  <para style="q" vid="PSA 119:125">ताकि आऊँ तेरिया शिक्षा खे समजी सकूँ।<verse eid="PSA 119:125" /></para>
  <para style="q">
    <verse number="126" style="v" sid="PSA 119:126" />ओ यहोवा, एबे तेरे काम करने रा बखत आईगा रा!</para>
  <para style="q" vid="PSA 119:126">कऊँकि लोक तेरिया बिदिया रा पाल़न नि करने लगी रे।<verse eid="PSA 119:126" /></para>
  <para style="q">
    <verse number="127" style="v" sid="PSA 119:127" />इजी बजा ते आऊँ तेरी आज्ञा खे सूईने ते</para>
  <para style="q" vid="PSA 119:127">बल्कि कुन्दनो ते बी जादा प्यारा करूँआ।<verse eid="PSA 119:127" /></para>
  <para style="q">
    <verse number="128" style="v" sid="PSA 119:128" />इजी बजा ते आऊँ तेरे सारे उपदेशा रे मुताबिक आपणा चाल-चलण सई करूँआ</para>
  <para style="q" vid="PSA 119:128">ओर सबी चूठिया बाटा ते कृणा करूँआ।</para>
  <para style="s" vid="PSA 119:128">परमेशरो रे बिधानो पाँदे चलणे री इच्छा</para>
  <para style="d" vid="PSA 119:128">पे<verse eid="PSA 119:128" /></para>
  <para style="q">
    <verse number="129" style="v" sid="PSA 119:129" />तेरिया शिक्षा नऊखिया ए;</para>
  <para style="q" vid="PSA 119:129">इजी बजा ते आऊँ तिना खे आपणे पूरे मनो ते मानूँआ।<verse eid="PSA 119:129" /></para>
  <para style="q">
    <verse number="130" style="v" sid="PSA 119:130" />तेरेया वचना री समज मेरे दिलो दे प्रयासा देओई,</para>
  <para style="q" vid="PSA 119:130">तिजी ते पोल़े लोका खे समज मिलोई।<verse eid="PSA 119:130" /></para>
  <para style="q">
    <verse number="131" style="v" sid="PSA 119:131" />आऊँ तेरे वचना रा त्याया ए;</para>
  <para style="q" vid="PSA 119:131">कऊँकि आऊँ तेरिया आज्ञा री इच्छा करूँआ।<verse eid="PSA 119:131" /></para>
  <para style="q">
    <verse number="132" style="v" sid="PSA 119:132" />जिंयाँ तूँ आपणे नाओं रे पग्ता रिया तँईं करेया,</para>
  <para style="q" vid="PSA 119:132">तिंयाँ ई मेरिया तरफा खे फिरी की मां पाँदे दया कर।<verse eid="PSA 119:132" /></para>
  <para style="q">
    <verse number="133" style="v" sid="PSA 119:133" />आपणे वादे रे मुताबिक मेरे पैर मजबूत कर</para>
  <para style="q" vid="PSA 119:133">ओर केसी बी अनर्थ गल्ला खे मां पाँदे राज नि करने दे।<verse eid="PSA 119:133" /></para>
  <para style="q">
    <verse number="134" style="v" sid="PSA 119:134" />माणूंआ रे अत्याचारो ते माखे छुड़ाई लओ,</para>
  <para style="q" vid="PSA 119:134">ताकि आऊँ तेरे उपदेशा खे मानी सकूँ।<verse eid="PSA 119:134" /></para>
  <para style="q">
    <verse number="135" style="v" sid="PSA 119:135" />प्रभु, आपणे मुंए री ज्योति आपणे दासो मां पाँदे चमकाई दे,</para>
  <para style="q" vid="PSA 119:135">ओर तूँ आपणी बिदिया माखे सखा।<verse eid="PSA 119:135" /></para>
  <para style="q">
    <verse number="136" style="v" sid="PSA 119:136" />मेरिया आखी ते पाणिए रिया तारा निकल़दिया रओईया,</para>
  <para style="q" vid="PSA 119:136">कऊँकि लोक तेरे बिधानो रा पाल़न नि करदे।</para>
  <para style="s" vid="PSA 119:136">परमेशरो रे बिधानो रा न्याय</para>
  <para style="d" vid="PSA 119:136">सांदे<verse eid="PSA 119:136" /></para>
  <para style="q">
    <verse number="137" style="v" sid="PSA 119:137" />ओ प्रभु, तूँ तर्मी ए,</para>
  <para style="q" vid="PSA 119:137">ओर तेरे नियमा रे पक्षपात नि ऊँदा।<note caller="+" style="f"><char style="fr" closed="false">119:137 </char><char style="ft" closed="false">पजन 145:17</char></note><verse eid="PSA 119:137" /></para>
  <para style="q">
    <verse number="138" style="v" sid="PSA 119:138" />तेरिया सारिया शिक्षा तार्मिक ओर परोसे जोगिया ए।<verse eid="PSA 119:138" /></para>
  <para style="q">
    <verse number="139" style="v" sid="PSA 119:139" />आऊँ गुस्से दे आगी जेड़ा जल़ने लगी रा,</para>
  <para style="q" vid="PSA 119:139">कऊँकि मेरे दुश्मण तेरिया आज्ञा खे पूली गे रे।<verse eid="PSA 119:139" /></para>
  <para style="q">
    <verse number="140" style="v" sid="PSA 119:140" />तेरा वचन पुरिया तरअ ते ताया राए,</para>
  <para style="q" vid="PSA 119:140">इजी बजा ते तेरा दास तिजी साथे प्यार राखोआ।<verse eid="PSA 119:140" /></para>
  <para style="q">
    <verse number="141" style="v" sid="PSA 119:141" />आऊँ छोटा ओर तुच्छ ए,</para>
  <para style="q" vid="PSA 119:141">तेबे बी आऊँ तेरे उपदेशा खे नि पूलदा।<verse eid="PSA 119:141" /></para>
  <para style="q">
    <verse number="142" style="v" sid="PSA 119:142" />तेरी तार्मिकता सदा बणी री रणी,</para>
  <para style="q" vid="PSA 119:142">ओर तेरा बिधान सच्चा ए।<verse eid="PSA 119:142" /></para>
  <para style="q">
    <verse number="143" style="v" sid="PSA 119:143" />जबकि आऊँ कष्टा रे ओर दु:खो रे फसी रा,</para>
  <para style="q" vid="PSA 119:143">तेबे बी आऊँ तेरिया आज्ञा ते खुश ए।<verse eid="PSA 119:143" /></para>
  <para style="q">
    <verse number="144" style="v" sid="PSA 119:144" />तेरिया शिक्षा सदा न्याय रिया ए;</para>
  <para style="q" vid="PSA 119:144">तूँ माखे समजदे ताकि आऊँ जिऊँदा रऊँ।</para>
  <para style="s" vid="PSA 119:144">छुटकारे रिया तँईं प्रार्थना</para>
  <para style="d" vid="PSA 119:144">क़ाफ<verse eid="PSA 119:144" /></para>
  <para style="q">
    <verse number="145" style="v" sid="PSA 119:145" />ओ यहोवा, आऊँ आपणे पूरे दिलो ते प्रार्थना करूँआ,</para>
  <para style="q" vid="PSA 119:145">माखे उत्तर दे! मां तेरिया बिदिया मानदे रणा।<verse eid="PSA 119:145" /></para>
  <para style="q">
    <verse number="146" style="v" sid="PSA 119:146" />मैं तांते प्रार्थना करी राखी, तूँ माखे बचाई लओ,</para>
  <para style="q" vid="PSA 119:146">ताकि आऊँ तेरिया शिक्षा खे मानेया करुँ।<verse eid="PSA 119:146" /></para>
  <para style="q">
    <verse number="147" style="v" sid="PSA 119:147" />मैं प्यागा त्याड़ा निकल़ने ते पईले तूँ मतादा रिया तँईं पुकारेया;</para>
  <para style="q" vid="PSA 119:147">मेरी उम्मीद तेरे वचना पाँदे थी।<verse eid="PSA 119:147" /></para>
  <para style="q">
    <verse number="148" style="v" sid="PSA 119:148" />आऊँ सारी रात नि सऊँदा,</para>
  <para style="q" vid="PSA 119:148">ओर आऊँ तेरिया गल्ला रे बारे दे मनो दे सोचदा रऊँआ।<verse eid="PSA 119:148" /></para>
  <para style="q">
    <verse number="149" style="v" sid="PSA 119:149" />आपणी करूणा रे मुताबिक मेरी सुणी लओ;</para>
  <para style="q" vid="PSA 119:149">ओ प्रभु, आपणे नियमा रे मुताबिक माखे फेर जिऊँदा कर।<verse eid="PSA 119:149" /></para>
  <para style="q">
    <verse number="150" style="v" sid="PSA 119:150" />मेरा पीछा करने वाल़े नेड़े आईगे रे;</para>
  <para style="q" vid="PSA 119:150">तिने षड़यन्त्र रची राखेया; सेयो तेरे बिधानो खे नि मानदे।<verse eid="PSA 119:150" /></para>
  <para style="q">
    <verse number="151" style="v" sid="PSA 119:151" />पर ओ प्रभु, तूँ नेड़े ए</para>
  <para style="q" vid="PSA 119:151">ओर तेरिया सब आज्ञा सच्चिया ए।<verse eid="PSA 119:151" /></para>
  <para style="q">
    <verse number="152" style="v" sid="PSA 119:152" />बऊत दिना ते आऊँ तेरिया शिक्षा खे जाणी चूकी रा,</para>
  <para style="q" vid="PSA 119:152">कि तैं तिना री निऊँ सदा रिया तँईं पाई राखी।</para>
  <para style="s" vid="PSA 119:152">मतादा रिया तँईं बिनती</para>
  <para style="d" vid="PSA 119:152">रेश<verse eid="PSA 119:152" /></para>
  <para style="q">
    <verse number="153" style="v" sid="PSA 119:153" />प्रभु, मेरे दु:खो खे देख ओर माखे छुड़ाई लओ,</para>
  <para style="q" vid="PSA 119:153">कऊँकि आऊँ तेरे बिधानो खे नि पूली रा।<verse eid="PSA 119:153" /></para>
  <para style="q">
    <verse number="154" style="v" sid="PSA 119:154" />मेरे पक्षो दे आपणा फैंसला दे ओर माखे छुड़ाई लओ;</para>
  <para style="q" vid="PSA 119:154">आपणे वादे रे मुताबिक माखे फेर जिऊँदा कर।<verse eid="PSA 119:154" /></para>
  <para style="q">
    <verse number="155" style="v" sid="PSA 119:155" />दुष्ट लोक नि बची सकदे,</para>
  <para style="q" vid="PSA 119:155">कऊँकि सेयो तेरिया बिदिया रा पाल़न नि करदे।<verse eid="PSA 119:155" /></para>
  <para style="q">
    <verse number="156" style="v" sid="PSA 119:156" />ओ प्रभु, तेरी दया तो महान ए,</para>
  <para style="q" vid="PSA 119:156">इजी री खातर आपणे नियमा रे मुताबिक माखे फेर जिऊँदा कर।<verse eid="PSA 119:156" /></para>
  <para style="q">
    <verse number="157" style="v" sid="PSA 119:157" />मेरा पीछा करने वाल़े लोक ओर माखे सताणे वाल़े बऊत ए,</para>
  <para style="q" vid="PSA 119:157">तेबे बी आऊँ तेरिया शिक्षा ते नि अटदा।<verse eid="PSA 119:157" /></para>
  <para style="q">
    <verse number="158" style="v" sid="PSA 119:158" />आऊँ विश्वासघातिया खे देखी की तिना ते कृणा करूँआ;</para>
  <para style="q" vid="PSA 119:158">कऊँकि सेयो तेरे वचना रा पाल़न नि करदे।<verse eid="PSA 119:158" /></para>
  <para style="q">
    <verse number="159" style="v" sid="PSA 119:159" />देख, आऊँ तेरे उपदेशा ते कितणा प्यार राखूँआ!</para>
  <para style="q" vid="PSA 119:159">ओ प्रभु आपणी करूणा रे मुताबिक माखे फेर जिऊँदा कर।<verse eid="PSA 119:159" /></para>
  <para style="q">
    <verse number="160" style="v" sid="PSA 119:160" />तेरे सारे वचन सच्चे ए,</para>
  <para style="q" vid="PSA 119:160">तेरिया शिक्षा दे सच्चाई ए ओर तेरी तर्मो री बिधि सदा री ए।</para>
  <para style="s" vid="PSA 119:160">परमेशरो रे बिधानो रिया तँईं समर्पण</para>
  <para style="d" vid="PSA 119:160">शीन<verse eid="PSA 119:160" /></para>
  <para style="q">
    <verse number="161" style="v" sid="PSA 119:161" />परदान बिना मतलबो तेई मां पीछे पड़ी रे,</para>
  <para style="q" vid="PSA 119:161">पर मेरा दिल तेरे वचना रा डर मानोआ।<note caller="+" style="f"><char style="fr" closed="false">119:161 </char><char style="ft" closed="false">पजन 119:23</char></note><verse eid="PSA 119:161" /></para>
  <para style="q">
    <verse number="162" style="v" sid="PSA 119:162" />जिंयाँ कोई बड़ी लूट पाणे वाल़ा माणूं खुश ओआ,</para>
  <para style="q" vid="PSA 119:162">तिंयाँ ई आऊँ बी तेरे वचना ते खुश ए।<verse eid="PSA 119:162" /></para>
  <para style="q">
    <verse number="163" style="v" sid="PSA 119:163" />चूठो ते आऊँ बैर ओर कृणा राखूँआ,</para>
  <para style="q" vid="PSA 119:163">पर तेरे बिधानो ते प्यार राखूँआ।<verse eid="PSA 119:163" /></para>
  <para style="q">
    <verse number="164" style="v" sid="PSA 119:164" />तेरे तार्मिक नियमा रिया बजा ते,</para>
  <para style="q" vid="PSA 119:164">आऊँ दिनो रे सात बार तेरी स्तुति करूँआ।<verse eid="PSA 119:164" /></para>
  <para style="q">
    <verse number="165" style="v" sid="PSA 119:165" />प्रभु, तेरे बिधानो साथे प्यार राखणे वाल़ेया खे बऊत ई शान्ति मिलोई,</para>
  <para style="q" vid="PSA 119:165">ओर तिना खे कोई ठोकर नि लगदी।<verse eid="PSA 119:165" /></para>
  <para style="q">
    <verse number="166" style="v" sid="PSA 119:166" />ओ यहोवा, आऊँ तेरी बाट देखूँआ कि तूँ माखे बचाए,</para>
  <para style="q" vid="PSA 119:166">ओर जो तूँ आज्ञा देआ से करूँआ।<verse eid="PSA 119:166" /></para>
  <para style="q">
    <verse number="167" style="v" sid="PSA 119:167" />आऊँ तेरिया शिक्षा रा जिऊए ते पाल़न करदा आई रा</para>
  <para style="q" vid="PSA 119:167">ओर तिना ते बऊत प्यार करूँआ।<verse eid="PSA 119:167" /></para>
  <para style="q">
    <verse number="168" style="v" sid="PSA 119:168" />आऊँ तेरिया शिक्षा ओर तेरिया आज्ञा रा पाल़न करूँआ;</para>
  <para style="q" vid="PSA 119:168">तूँ सब कुछ देखेया जो आऊँ करूँआ।</para>
  <para style="s" vid="PSA 119:168">परमेशरो ते मताद पाणे रिया तँईं प्रार्थना</para>
  <para style="d" vid="PSA 119:168">ताव<verse eid="PSA 119:168" /></para>
  <para style="q">
    <verse number="169" style="v" sid="PSA 119:169" />ओ प्रभु, मेरी पुकार तां तक पऊँचो;</para>
  <para style="q" vid="PSA 119:169">तूँ आपणे वचनो रे मुताबिक माखे समजदे!<verse eid="PSA 119:169" /></para>
  <para style="q">
    <verse number="170" style="v" sid="PSA 119:170" />मेरी बिनती तां तक पऊँचो;</para>
  <para style="q" vid="PSA 119:170">तूँ आपणे वचनो रे मुताबिक माखे छुड़ाई लओ।<verse eid="PSA 119:170" /></para>
  <para style="q">
    <verse number="171" style="v" sid="PSA 119:171" />मां सदा तेरी जयजयकार करनी,</para>
  <para style="q" vid="PSA 119:171">कऊँकि तूँ माखे आपणी बिदिया सिखाएया।<verse eid="PSA 119:171" /></para>
  <para style="q">
    <verse number="172" style="v" sid="PSA 119:172" />मां तेरिया बिदिया रे बारे दे गाणा,</para>
  <para style="q" vid="PSA 119:172">कऊँकि तेरिया सारिया आज्ञा दे तार्मिकता ए।<verse eid="PSA 119:172" /></para>
  <para style="q">
    <verse number="173" style="v" sid="PSA 119:173" />प्रभु, तेरा आथ मेरी मताद करने रिया तँईं त्यार रओआ,</para>
  <para style="q" vid="PSA 119:173">कऊँकि मैं तेरे उपदेश अपनाई राखे।<verse eid="PSA 119:173" /></para>
  <para style="q">
    <verse number="174" style="v" sid="PSA 119:174" />ओ यहोवा, माखे उम्मीद ए कि तां आऊँ बचाई लणा,</para>
  <para style="q" vid="PSA 119:174">कऊँकि आऊँ तेरे बिधानो ते खुश ए।<verse eid="PSA 119:174" /></para>
  <para style="q">
    <verse number="175" style="v" sid="PSA 119:175" />प्रभु, माखे जिऊँदा कर ताकि आऊँ तेरी स्तुति करी सकूँ,</para>
  <para style="q" vid="PSA 119:175">तेरे नियम मेरी मताद करो।<verse eid="PSA 119:175" /></para>
  <para style="q">
    <verse number="176" style="v" sid="PSA 119:176" />आऊँ राची रिया पेडा जेड़ा बाटा ते पटकी गा रा;</para>
  <para style="q" vid="PSA 119:176">प्रभु, आपणे दास माखे टोल़, कऊँकि आऊँ तेरिया आज्ञा खे याद राखूँआ।<verse eid="PSA 119:176" /></para>
  <chapter eid="PSA 119" />
  <chapter number="120" style="c" sid="PSA 120" />
  <para style="s">परमेशरो ते मतादा रिया तँईं प्रार्थना</para>
  <para style="d">यात्रा रा गाणा</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 120:1" />आपणियां मुसीबता रे बखते मैं प्रभुए खे पुकारेया,</para>
  <para style="q" vid="PSA 120:1">ओर तिने मेरी सुणी ली।<verse eid="PSA 120:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 120:2" />ओ यहोवा, तूँ मांते चूठ बोलणे वाल़े माणूं,</para>
  <para style="q" vid="PSA 120:2">ओर छल करने वाल़े माणूंए ते बचाई की राख।<verse eid="PSA 120:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 120:3" />ओ छल करने वाल़े माणूंओ, यहोवे तुसा साथे क्या करना?</para>
  <para style="q" vid="PSA 120:3">तुसा खे तेस किंयाँ सजा देणी?<verse eid="PSA 120:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 120:4" />तेस तुसा खे एक सिपाईए रे पईनेया तीरा ते,</para>
  <para style="q" vid="PSA 120:4">ओर लाल-गर्म फेऊआ ते सजा देणी!<verse eid="PSA 120:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 120:5" />तुसा बीचे रणा मेशेको दे या केदारा जगा रेया लोका बीचे रणे जेड़ा बुरा ए।<verse eid="PSA 120:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 120:6" />आऊँ बऊत लाम्बे बखतो ते एड़े लोका साथे रऊँआ जो शान्तिया ते नफरत करोए!<verse eid="PSA 120:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 120:7" />आऊँ तो शान्ति चाऊँआ;</para>
  <para style="q" vid="PSA 120:7">पर मेरे बोलदे ई, सेयो लड़ना चाओए!<verse eid="PSA 120:7" /></para>
  <chapter eid="PSA 120" />
  <chapter number="121" style="c" sid="PSA 121" />
  <para style="s">परमेशर म्हारी रक्षा करने वाल़ा ए</para>
  <para style="d">यात्रा रा गाणा</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 121:1" />मां आपणियां आखी पाह्ड़ा रिया तरफा खे लगाणियां।</para>
  <para style="q" vid="PSA 121:1">माखे मताद केथा ते मिलणी?<verse eid="PSA 121:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 121:2" />माखे मताद प्रभुए रिया तरफा ते मिलोई,</para>
  <para style="q" vid="PSA 121:2">जो सर्ग ओर तरतिया खे बनाणे वाल़ा ए।<verse eid="PSA 121:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 121:3" />यहोवा तेरी रक्षा करने वाल़ा ए,</para>
  <para style="q" vid="PSA 121:3">ओर से ना तो सऊणा ओर ना तूँ रूड़ने देणा।<verse eid="PSA 121:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 121:4" />देखो, इस्राएलो री रक्षा करने वाल़े खे ना तो नींजा रे टमके आऊणे,</para>
  <para style="q" vid="PSA 121:4">ना ई से सऊणा। <note caller="+" style="f"><char style="fr" closed="false">121:4 </char><char style="ft" closed="false">यहोवा हमेशा जागदा ओर चौकस रओआ। </char></note><verse eid="PSA 121:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 121:5" />यहोवा म्हारी रक्षा करने वाल़ा ए,</para>
  <para style="q" vid="PSA 121:5">से तेसा छाई जेड़ा ए जो आसा खे तूपा ते बचाओई।<verse eid="PSA 121:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 121:6" />ना तो दिने तूपा रे</para>
  <para style="q" vid="PSA 121:6">ओर ना ई राती री चानणियाँ ते तेरा कोई नुकशाण ऊणा।<verse eid="PSA 121:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 121:7" />यहोवा से आ जो हर खतरे दे तुसा री देखपाल़ करोआ।</para>
  <para style="q" vid="PSA 121:7">से तुसा रे जीवनो खे बचाई की राखोआ।<verse eid="PSA 121:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 121:8" />प्रभुए तेरे जाणे-आऊणे रे</para>
  <para style="q" vid="PSA 121:8">तेरी रक्षा एबुए ते लई की सदा तक करदे रणा।<verse eid="PSA 121:8" /></para>
  <chapter eid="PSA 121" />
  <chapter number="122" style="c" sid="PSA 122" />
  <para style="s">यरूशलेमो री शान्तिया रिया तँईं प्रार्थना</para>
  <para style="d">दाऊदो री यात्रा रा गाणा</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 122:1" />जेबे मेरेया दोस्ते माखे बोलेया, “आओ, आसे प्रभुए रे मईलो खे चलूँए,”</para>
  <para style="q" vid="PSA 122:1">तेबे आऊँ खुश ऊईगा।<verse eid="PSA 122:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 122:2" />ओ यरूशलेम,</para>
  <para style="q" vid="PSA 122:2">तेरे प्रवेश द्वारो पाँदे आसे खड़ी रे!<verse eid="PSA 122:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 122:3" />ओ यरूशलेम, तूँ कितणा मजबूत ओर सुन्दर शईर ए,</para>
  <para style="q" vid="PSA 122:3">जेसरे कअर एकी-दूजे साथे मिली रे।<verse eid="PSA 122:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 122:4" />ये से जगा ए जेती इस्राएलो रे सबी गोत्रा रे लोक आओए,</para>
  <para style="q" vid="PSA 122:4">यहोवे रा तन्यवाद करने खे जेड़ी यहोवे तिना खे आज्ञा देई राखी।<verse eid="PSA 122:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 122:5" />इस्राएलो रा राजा एथी आ,</para>
  <para style="q" vid="PSA 122:5">सिंहासनो पाँदे बैठेया दा, दाऊदो रे कराने रा न्याये करने खे।<verse eid="PSA 122:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 122:6" />यरूशलेमो री शान्तिया रिया तँईं प्रार्थना करो;</para>
  <para style="q" vid="PSA 122:6">एते शईरो दे तां साथे प्यार करने वाल़े फल़ो-फूलो!<verse eid="PSA 122:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 122:7" />ओ यरूशलेम, तेरिया दवाला रे पीतरे शान्ति</para>
  <para style="q" vid="PSA 122:7">ओर तेरे मईलो रे सुरक्षा बणी री रओ!<verse eid="PSA 122:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 122:8" />आपणे परिवार ओर दोस्ता खे मां ये बोलणा,</para>
  <para style="q" vid="PSA 122:8">“तुसा बीचे शान्ति बणी री रओ!”<verse eid="PSA 122:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 122:9" />आपणे प्रभु परमेशरो रे मन्दरो रिया तँईं,</para>
  <para style="q" vid="PSA 122:9">मां तेरी पलाईया री कोशिश करनी।<verse eid="PSA 122:9" /></para>
  <chapter eid="PSA 122" />
  <chapter number="123" style="c" sid="PSA 123" />
  <para style="s">परमेशरो री दया रिया तँईं प्रार्थना</para>
  <para style="d">यात्रा रा गाणा</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 123:1" />ओ यहोवा, आऊँ प्रार्थना दे तेरिया ओर स्वर्गो रिया तरफा खे देखूँआ,</para>
  <para style="q" vid="PSA 123:1">जेथा ते तूँ तरतिया पाँदे राज करेया।<verse eid="PSA 123:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 123:2" />देख, जिंयाँ दासो रिया आखी आपणे मालको रे आथो रिया तरफा खे</para>
  <para style="q" vid="PSA 123:2">ओर जिंयाँ दासिया रिया आखी आपणियां मालकणिया रे आथो रिया तरफा खे लगी री रओईया,</para>
  <para style="q" vid="PSA 123:2">तिंयाँ ई म्हारिया आखी म्हारे प्रभु परमेशरो रिया तरफा खे तेस बखतो तक लगी रिया रणियां,</para>
  <para style="q" vid="PSA 123:2">जदुओ तक से आसा पाँदे दया नि करो।<verse eid="PSA 123:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 123:3" />आसा पाँदे दया कर, ओ प्रभु, आसा पाँदे दया कर,</para>
  <para style="q" vid="PSA 123:3">कऊँकि आसा री बऊत ई बेज्जती ऊई गी री।<verse eid="PSA 123:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 123:4" />म्हारा जिऊ अमीर लोका रे मजाको ते</para>
  <para style="q" vid="PSA 123:4">ओर कमण्डिया री बेज्जतिया ते बऊत ई परी गा रा।<verse eid="PSA 123:4" /></para>
  <chapter eid="PSA 123" />
  <chapter number="124" style="c" sid="PSA 124" />
  <para style="s">परमेशर आपणे लोका री रक्षा करने वाल़ा</para>
  <para style="d">दाऊदो री यात्रा रा गाणा</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 124:1" />जे यहोवा आसा रिया तँईं नि लड़दा ऊँदा, तो क्या ऊँदा?</para>
  <para style="q" vid="PSA 124:1">इस्राएलो रे लोको, एबे ज्वाब देओ<verse eid="PSA 124:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 124:2" />जे प्रभु तेस बखते म्हारी तरफा खे नि ऊँदा</para>
  <para style="q" vid="PSA 124:2">जेबे म्हारे दुश्मणे आसा पाँदे अमला कित्तेया,<verse eid="PSA 124:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 124:3" />तो तिना तेसी बखते आसे जिऊँदे ई खाई जाणे थे,</para>
  <para style="q" vid="PSA 124:3">जेबे तिना रा गुस्सा आसा पाँदे पड़केया था।<verse eid="PSA 124:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 124:4" />आसे तेस बखते ई पाणिए रे डूबी जाणे थे</para>
  <para style="q" vid="PSA 124:4">ओर पाणिए रिया छालिया साथे हड़ी जाणे थे;<verse eid="PSA 124:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 124:5" />ओर उछल़दे पाणिए बीचे आसे तेसी बखते हड़ी जाणे थे।<verse eid="PSA 124:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 124:6" />आओ आसे यहोवे रा तन्यवाद करूँए,</para>
  <para style="q" vid="PSA 124:6">जिने आसे म्हारे दुश्मणा रा शकार ऊणे नि दित्ते!<verse eid="PSA 124:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 124:7" />चीड़ीमारो रे जाल़ो ते छूटे रे पंछिए जेड़े म्हारे प्राण बची गे;</para>
  <para style="q" vid="PSA 124:7">तिना रा जाल़ फटीगा ओर आसे बची की निकल़ी गे!<verse eid="PSA 124:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 124:8" />प्रभु जो सर्ग ओर तरतिया खे बनाणे वाल़ा ए,</para>
  <para style="q" vid="PSA 124:8">म्हारी मताद तेसरे ई नाओं ते ओई।<verse eid="PSA 124:8" /></para>
  <chapter eid="PSA 124" />
  <chapter number="125" style="c" sid="PSA 125" />
  <para style="s">परमेशरो रे लोका री सुरक्षा</para>
  <para style="d">दाऊदो री यात्रा रा गीत</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 125:1" />जो परमेशरो पाँदे परोसा राखोए,</para>
  <para style="q" vid="PSA 125:1">सेयो सिय्योन पाह्ड़ो जेड़े ए,</para>
  <para style="q" vid="PSA 125:1">जो टल़दा नि,</para>
  <para style="q" vid="PSA 125:1">बल्कि सदा बणेया रा रओआ।<verse eid="PSA 125:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 125:2" />जिंयाँ यरूशलेमो रे चऊँ कनारे पाह्ड़ ए,</para>
  <para style="q" vid="PSA 125:2">तिंयाँ ई प्रभु आपणे निज लोका रे चऊँ कनारे एबुए ते लई की सदा तक बणेया रा रणा।<verse eid="PSA 125:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 125:3" />तर्मी माणूंए पाँदे दुष्ट माणूंए रा राज्य सदा नि रंदा,</para>
  <para style="q" vid="PSA 125:3">ताकि तर्मी माणूं दुष्ट माणूंए री तरआ बुरेया कामा रिया तरफा खे नि फिरो।<verse eid="PSA 125:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 125:4" />ओ यहोवा, तिना रा पला कर जो दूजेया रिया तँईं तर्मी काम करोए,</para>
  <para style="q" vid="PSA 125:4">ओर जो तेरिया आज्ञा खे दिलो ते मानोए।<verse eid="PSA 125:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 125:5" />पर जो लोक आपणियां बुरिया बाटा पाँदे हांडोए,</para>
  <para style="q" vid="PSA 125:5">ओ यहोवा, तिना खे दूर कर! तिना खे तिना लोका साथे दूर लई जाओ जो बुरे काम करोए।</para>
  <para style="q" vid="PSA 125:5">इस्राएलो खे शान्ति मिलो!<note caller="+" style="f"><char style="fr" closed="false">125:5 </char><char style="ft" closed="false">नसी 2:15</char></note><verse eid="PSA 125:5" /></para>
  <chapter eid="PSA 125" />
  <chapter number="126" style="c" sid="PSA 126" />
  <para style="s">छुटकारे रिया तँईं प्रार्थना</para>
  <para style="d">यात्रा रा गाणा</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 126:1" />जेबे यहोवे आसे इस्राएली लोक गुलामिया ते यरूशलेम शईरो दे वापस पऊँचाए,</para>
  <para style="q" vid="PSA 126:1">तेबे आसा खे ये केसी सुफने जेड़ा लगेया।<verse eid="PSA 126:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 126:2" />तेबे म्हारे मुंए पाँदे खुशिया साथे आसी आईगी</para>
  <para style="q" vid="PSA 126:2">ओर म्हारी जीब जयजयकार करने लगी;</para>
  <para style="q" vid="PSA 126:2">तेबे जातिया-जातिया रे लोक आपू बीचे म्हारे बारे दे बोलणे लगे,</para>
  <para style="q" vid="PSA 126:2">“यहोवे इना रिया तँईं महान काम करी राखे।”<verse eid="PSA 126:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 126:3" />प्रभुए म्हारिया तँईं महान काम करी राखे</para>
  <para style="q" vid="PSA 126:3">ओर इजी ते आसे खुश ए।<verse eid="PSA 126:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 126:4" />जिंयाँ सूकिया जगा रिया नदिया बरसाती दे पाणिए साथे परी जाओईया, तिंयाँ ई,</para>
  <para style="q" vid="PSA 126:4">ओ प्रभु, आसा खे फेर समृद्ध बणाई दे!<verse eid="PSA 126:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 126:5" />जो आसू बाह्ंदे ऊए बीज बाओए,</para>
  <para style="q" vid="PSA 126:5">तिना फसल जयजयकार करदे ऊए बाडणी।<verse eid="PSA 126:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 126:6" />चाए बाणे वाल़ा जिम्मीदार बेजा लई की रोंदा ऊआ चली जाओ,</para>
  <para style="q" vid="PSA 126:6">तेबे बी से पूल़े लई की जयजयकार करदा ऊआ फेर पक्का वापस आई जाणा।<note caller="+" style="f"><char style="fr" closed="false">126:6 </char><char style="ft" closed="false">लूक 6:21</char></note><verse eid="PSA 126:6" /></para>
  <chapter eid="PSA 126" />
  <chapter number="127" style="c" sid="PSA 127" />
  <para style="s">परमेशरो रा आशीर्वाद</para>
  <para style="d">सुलैमानो री यात्रा रा गाणा</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 127:1" />जे कअरो खे प्रभु नि बणाओ, तो तिजी खे बनाणे वाल़े माणूंए री मईणत बेकार ऊणी।</para>
  <para style="q" vid="PSA 127:1">जे प्रभु शईरो री रक्षा नि करो, तो पईरेदारो रा जागणा बेकार ई ऊणा।<verse eid="PSA 127:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 127:2" />तुसे बेकारो रेई तड़के उठोए ओर बेकारो रेई देरा ते सओए</para>
  <para style="q" vid="PSA 127:2">ओर बेकारो रेई बड़ी पारी मईणत करी की रोटी खाओए, ये सब तुसा खे बेकार ई ए;</para>
  <para style="q" vid="PSA 127:2">कऊँकि यहोवा ई आपू साथे प्यार करने वाल़ेया खे नींज परदान करोआ।<verse eid="PSA 127:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 127:3" />देखो, बच्चे प्रभुए रा दित्तेया दा पाअग ए,</para>
  <para style="q" vid="PSA 127:3">गर्भो रा फल प्रभुए रिया तरफा ते दित्तेया रा प्रतिफल ए।<verse eid="PSA 127:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 127:4" />जवानिया रे पैदा ऊईरा पाऊ वीरो रे आथो रे तीरो जेड़ा ओआ।<verse eid="PSA 127:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 127:5" />से माणूं बऊत ई तन्य ए जेसगे एड़े कई तीर ए।</para>
  <para style="q" vid="PSA 127:5">न्याय रिया जगा पाँदे आपणे दुश्मणा ते मिलदे ऊए से कदी आरना नि।<verse eid="PSA 127:5" /></para>
  <chapter eid="PSA 127" />
  <chapter number="128" style="c" sid="PSA 128" />
  <para style="s">परमेशरो रा डर मानणे रिया तँईं आशीष</para>
  <para style="d">यात्रा रा गीत</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 128:1" />तन्य ए से जो यहोवे रा आदर करोए,</para>
  <para style="q" vid="PSA 128:1">जो तेसरिया आज्ञा रे मुताबिक जीवन बताओए।<verse eid="PSA 128:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 128:2" />तां आपणे आथो रिया मईणता री कमाई खाणी;</para>
  <para style="q" vid="PSA 128:2">तूँ सुखी ऊणा ओर तेरा पला ई ऊणा।<verse eid="PSA 128:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 128:3" />तेरे कअरो रे पीतरे तेरी लाड़ी फल़ ल्याऊणे वाल़ी अंगूरा री बेला जेड़ी ऊणी;</para>
  <para style="q" vid="PSA 128:3">तेरे खाणे रे मेजो रे चऊँ कनारे जैतूनो रे पौधे जेड़े तेरे बाल़क ऊणे।<verse eid="PSA 128:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 128:4" />देखो, जो माणूं प्रभुए रा डर मानोआ,</para>
  <para style="q" vid="PSA 128:4">तेस एड़ी ई आशीष पाणी।<verse eid="PSA 128:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 128:5" />प्रभु ताखे सिय्योनो ते आशीष देओ</para>
  <para style="q" vid="PSA 128:5">ओर तूँ सारी जिन्दगी यरूशलेमो री बढ़ोतरी देखदा रये!<verse eid="PSA 128:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 128:6" />बल्कि तूँ आपणे दोईते-पोतेया खे बी देखी सके!</para>
  <para style="q" vid="PSA 128:6">इस्राएलो पाँदे शान्ति बणी दी रओ!<verse eid="PSA 128:6" /></para>
  <chapter eid="PSA 128" />
  <chapter number="129" style="c" sid="PSA 129" />
  <para style="s">दुश्मणा री आरा रिया तँईं प्रार्थना</para>
  <para style="d">यात्रा रा गाणा</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 129:1" />एबे इस्राएल ये बोलो, “मेरे बचपनो ते दुश्मण माखे बार-बार क्ल़ेश देंदे आई रे”<verse eid="PSA 129:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 129:2" />जेबे आऊँ छोटा था, दुश्मणे लगातार अमले कित्ते!</para>
  <para style="q" vid="PSA 129:2">तेबे बी सेयो मां पाँदे प्रबल नि ऊई सके।<verse eid="PSA 129:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 129:3" />तिने मेरिया पीठी पाँदे अमला कित्तेया ओर तिने तीजी पाँदे लाम्बे नशाण बणाए,</para>
  <para style="q" vid="PSA 129:3">जिंयाँ किसान आपणे डोरू बाओआ।<verse eid="PSA 129:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 129:4" />पर यहोवा जो तर्मी ए; तिने आऊँ दुष्ट माणूंए रिया गुलामिया ते छुड़ाया,<verse eid="PSA 129:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 129:5" />जितणे सिय्योनो ते बैर राखोए, सेयो सब शर्मिंदा ओ</para>
  <para style="q" vid="PSA 129:5">ओर तिना खे आरी की पीछे आटणा पड़ो!<verse eid="PSA 129:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 129:6" />सेयो छतो पाँदले काओ जेड़े ओ,</para>
  <para style="q" vid="PSA 129:6">जो बढ़ने ते पईले ई सूकी जाओई;<verse eid="PSA 129:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 129:7" />जेतेते कोई ताअन ओर कणक बाडणे वाल़ा आपणी मुट्ठ नि परदा,</para>
  <para style="q" vid="PSA 129:7">ना ई पूल़ेया खे बानणे वाल़ा आपणियां बांई परी सकदा,<verse eid="PSA 129:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 129:8" />ओर ना बाटा रे आऊणे-जाणे वाल़े ये बोलदे, “प्रभुए री आशीष तुसा पाँदे ओ!</para>
  <para style="q" vid="PSA 129:8">आसे तुसा खे प्रभुए रे नाओं ते आशीष देऊँए!”<verse eid="PSA 129:8" /></para>
  <chapter eid="PSA 129" />
  <chapter number="130" style="c" sid="PSA 130" />
  <para style="s">करूणा करने वाल़ा परमेशर</para>
  <para style="d">यात्रा रा गाणा</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 130:1" />ओ यहोवा, मैं बऊत पारी मुसीबता रे बखते ताखे आका पाईया!<verse eid="PSA 130:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 130:2" />ओ प्रभु, मेरी पुकार सुण!</para>
  <para style="q" vid="PSA 130:2">तेरे कान मेरे मतादा रिया तँईं पुकारने रिया तरफा खे त्यानो साथे लगे रे रओ!<verse eid="PSA 130:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 130:3" />ओ यहोवा, जे तुसे म्हारे पापा रा लेखा-जोखा राखोए,</para>
  <para style="q" vid="PSA 130:3">तो दोषी ठराणे ते कुण बचाई सकोआ?<verse eid="PSA 130:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 130:4" />पर तूँ माफ करने वाल़ा ए,</para>
  <para style="q" vid="PSA 130:4">ताकि आसे तेरा आदर करिए।<verse eid="PSA 130:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 130:5" />आऊँ बेसब्रिया ते यहोवे रिया मतादा री बाट देखदा रऊँआ,</para>
  <para style="q" vid="PSA 130:5">ओर तेसरे वचना पाँदे माखे परोसा ए।<verse eid="PSA 130:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 130:6" />प्याग ऊणे रा इन्तजार करने वाल़े पईरेदारो ते जादा, आ,</para>
  <para style="q" vid="PSA 130:6">प्याग ऊणे रा इन्तजार करने वाल़े पईरेदारो ते जादा मेरा प्राण प्रभुए रा इन्तजार करोआ।<verse eid="PSA 130:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 130:7" />ओ इस्राएल, प्रभुए पाँदे उम्मीद लगाई की राख!</para>
  <para style="q" vid="PSA 130:7">कऊँकि प्रभु करूणा करने वाल़ा ओर पुरिया तरअ ते छुटकारा देणे वाल़ा ए।<verse eid="PSA 130:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 130:8" />यहोवे इस्राएलो रे लोक तिना रे बुरे कामा ते बचाणे।<note caller="+" style="f"><char style="fr" closed="false">130:8 </char><char style="ft" closed="false">पजन 131:3</char></note><verse eid="PSA 130:8" /></para>
  <chapter eid="PSA 130" />
  <chapter number="131" style="c" sid="PSA 131" />
  <para style="s">परमेशरो पाँदे परोसा</para>
  <para style="d">दाऊदो री यात्रा रा गाणा</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 131:1" />ओ यहोवा, मैं अबिमान करना छाडीता रा</para>
  <para style="q" vid="PSA 131:1">ओर आपणे अहंकारो ते दूर ऊईगा रा</para>
  <para style="q" vid="PSA 131:1">ओर जो मांते ऊई नि सकदा तिजी पाँदे आँऊ आपणा बखत बर्बाद नि करदा।<verse eid="PSA 131:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 131:2" />पर मैं एक छोटे बच्चे जेड़ा आपू खे सुरक्षित ओर सन्तुष्ट महसूस करना सिखी ला रा,</para>
  <para style="q" vid="PSA 131:2">जिंयाँ एक दूद छुड़ाया रा बच्चा आपणी माया रिया गोदा रे शान्त रओआ।<verse eid="PSA 131:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 131:3" />ओ इस्राएल, एबुए ते लई की सदा-सर्वदा खे</para>
  <para style="q" vid="PSA 131:3">यहोवे पाँदे ई उम्मीद लगाई की राख!<verse eid="PSA 131:3" /></para>
  <chapter eid="PSA 131" />
  <chapter number="132" style="c" sid="PSA 132" />
  <para style="s">प्रभुए रे मन्दरो रिया तँईं प्रार्थना</para>
  <para style="d">यात्रा रा गाणा</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 132:1" />ओ यहोवा, राजा दाऊद ओर तेसरे जरिये सये दे सबी दु:खा खे नि पुलणा।<verse eid="PSA 132:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 132:2" />तिने तांते एक गम्भीर वादा कित्तेया,</para>
  <para style="q" vid="PSA 132:2">तेस पराक्रमी परमेशरो री, जेसरी म्हारे बुजुर्ग याकूबे उपासना कित्ती थी।<verse eid="PSA 132:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 132:3" />तिने बोलेया, “मां तेस बखतो तक आपणे कअरे नि जाणा</para>
  <para style="q" vid="PSA 132:3">ओर ना आपणे बिस्तरे पाँदे लेटणा;<verse eid="PSA 132:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 132:4" />मां आपणियां आखी रे नींज नि आऊणे देणी</para>
  <para style="q" vid="PSA 132:4">ओर ना आपणियां पलका खे चपकी लणे देणी,<verse eid="PSA 132:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 132:5" />जदुओ तक आऊँ यहोवे रिया तँईं एक जगा नि बणाऊँ,</para>
  <para style="q" vid="PSA 132:5">जो तेस पराक्रमी परमेशरो रा कअर ए, जेसरी उपासना याकूब करो था।”<note caller="+" style="f"><char style="fr" closed="false">132:5 </char><char style="ft" closed="false">प्रेरित 7:46</char></note><verse eid="PSA 132:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 132:6" />देखो, एप्राता दे आसे वादे रे सन्दूको रे बारे दे सुणेया,</para>
  <para style="q" vid="PSA 132:6">ओर से यरीमो रे डोरूआ रे पाया।<note caller="+" style="f"><char style="fr" closed="false">132:6 </char><char style="ft" closed="false">1 शमूएल 4:1-6:16</char></note><verse eid="PSA 132:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 132:7" />आसे बोलेया, आसे यहोवे रे मन्दरो खे चलूँए;</para>
  <para style="q" vid="PSA 132:7">आओ आसे तेसरे सिंहासनो रे सामणे माथा तेकूँए!<verse eid="PSA 132:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 132:8" />ओ यहोवा, मन्दरो दे आओ वादे रे सन्दूको गे,</para>
  <para style="q" vid="PSA 132:8">जो आपणियां शक्तिया रा नशाण ए, ओर एती सदा खे रओ।<verse eid="PSA 132:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 132:9" />तेरे पुरोईत सदा सेई करो जो सई ए;</para>
  <para style="q" vid="PSA 132:9">ओर तेरे पग्त लोक जयजयकार करो।<verse eid="PSA 132:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 132:10" />तैं आपणे दास दाऊदो ते वादा करी राखेया ए;</para>
  <para style="q" vid="PSA 132:10">ओ यहोवा, आपणे चूणे दे राजे खे अणदेखा नि कर।<verse eid="PSA 132:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 132:11" />यहोवे दाऊदो ते सच्ची कसम खाई राखी ओर तेस तिजी ते नि मुकरना:</para>
  <para style="q" vid="PSA 132:11">“मां तेरे निज पाऊआ बीचा ते एक पाऊ तेरी गद्दिया पाँदे बठयाल़ना।<note caller="+" style="f"><char style="fr" closed="false">132:11 </char><char style="ft" closed="false">2 शमूएल 7:12, प्रेरित 2:30</char></note><verse eid="PSA 132:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 132:12" />जे तेरे वंशो रे लोक मेरी वाचा खे मानेया करोगे</para>
  <para style="q" vid="PSA 132:12">ओर जो आज्ञा मां तिना खे सिखाणी, तिजी पाँदे चलो,</para>
  <para style="q" vid="PSA 132:12">तो तिना रे वंशो रे लोक बी तेरी गद्दिया पाँदे जुगो-जुगो तक बैठदे जाणे।”<verse eid="PSA 132:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 132:13" />कऊँकि प्रभुए सिय्योन चूणी राखेया</para>
  <para style="q" vid="PSA 132:13">ओर तिजी खे आपणे रणे री जगा बनाणे री इच्छा करी राखी।<verse eid="PSA 132:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 132:14" />तुसे बोलेया, “ये से जगा ए जेती मां सदा खे रणा,</para>
  <para style="q" vid="PSA 132:14">ये मेरा कअर ए।”<verse eid="PSA 132:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 132:15" />मां सिय्योन शईरो री हर एक चीजा पाँदे आशीष देणी,</para>
  <para style="q" vid="PSA 132:15">एते शईरो रे गरीबा खे मां खाणे पीणे खे बऊत देणा।<verse eid="PSA 132:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 132:16" />मां एथो रे पुरोईता खे उद्धारो रे टाल्ले पनयाणे,</para>
  <para style="q" vid="PSA 132:16">एते शईरो दे रणे वाल़ेया पग्त लोका खुशिया साथे जयजयकार करनी।<verse eid="PSA 132:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 132:17" />एती मां दाऊदो रे वंशो बीचा ते एक महान राजा बनाणा;</para>
  <para style="q" vid="PSA 132:17">एती मां आपणे चूणे रे राजे रा राज सुरक्षित करना।<note caller="+" style="f"><char style="fr" closed="false">132:17 </char><char style="ft" closed="false">लूक 1:69</char></note><verse eid="PSA 132:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 132:18" />मां दाऊदो रे दुश्मण शर्मिंदा करने;</para>
  <para style="q" vid="PSA 132:18">पर दाऊदो रा मुकुट तेसरे सिरो पाँदे सदा सजेया रा रणा।<verse eid="PSA 132:18" /></para>
  <chapter eid="PSA 132" />
  <chapter number="133" style="c" sid="PSA 133" />
  <para style="s">परमेशरो रे लोका री एकता</para>
  <para style="d">दाऊदो री यात्रा रा गाणा</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 133:1" />देखो, केड़ी उत्तम ओर पली गल्ल ए कि</para>
  <para style="q" vid="PSA 133:1">यहोवे री प्रजा आपू बीचे मिली-जुली की रओई!<verse eid="PSA 133:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 133:2" />ये तो तेस किमती तेलो जेड़ा ए, जो हारूण पुरोईतो रे सिरो पाँदे लटेया था</para>
  <para style="q" vid="PSA 133:2">ओर तेसरिया दाड़िया पाँदिए बह्यी की, तेसरे टाल्लेया रे कूणे तक पऊँची गा।<verse eid="PSA 133:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 133:3" />से हेर्मोन पाह्ड़ो रे तेस पाल़े जेड़ा ए, जो सिय्योनो रे पाह्ड़ा पाँदे पड़ोई!</para>
  <para style="q" vid="PSA 133:3">प्रभुए तो तेती सदा री जिन्दगिया री आशीष ठराई राखी।<verse eid="PSA 133:3" /></para>
  <chapter eid="PSA 133" />
  <chapter number="134" style="c" sid="PSA 134" />
  <para style="s">परमेशरो री स्तुति करने रा आह्वान</para>
  <para style="d">यात्रा रा गाणा</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 134:1" />ओ प्रभुए रे सब सेवको, सुणो,</para>
  <para style="q" vid="PSA 134:1">तुसे जो राथियो खे प्रभुए रे मईलो दे सेवा करोए, प्रभुए खे तन्य बोलो।<note caller="+" style="f"><char style="fr" closed="false">134:1 </char><char style="ft" closed="false">प्रकाशित 19:5</char></note><verse eid="PSA 134:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 134:2" />पवित्र जगा रिया तरफा खे आपणे आथ चको</para>
  <para style="q" vid="PSA 134:2">ओर यहोवे री स्तुति करो!<verse eid="PSA 134:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 134:3" />प्रभु जो सर्ग ओर तरतिया खे बनाणे वाल़ा ए,</para>
  <para style="q" vid="PSA 134:3">से सिय्योनो ते ताखे आशीष देयो।<verse eid="PSA 134:3" /></para>
  <chapter eid="PSA 134" />
  <chapter number="135" style="c" sid="PSA 135" />
  <para style="s">प्रभु महान ए</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 135:1" />प्रभुए री स्तुति करो, प्रभुए रे नाओं री स्तुति करो,</para>
  <para style="q" vid="PSA 135:1">ओ प्रभुए रे सेवको तुसे तेसरी स्तुति करो,<note caller="+" style="f"><char style="fr" closed="false">135:1 </char><char style="ft" closed="false">पजन 113:1</char></note><verse eid="PSA 135:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 135:2" />तुसे जो प्रभुए रे मईलो रे,</para>
  <para style="q" vid="PSA 135:2">मतलब म्हारे परमेशरो रे मन्दरो रे आँगणो रे खड़े रे रओए!<verse eid="PSA 135:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 135:3" />प्रभुए री स्तुति करो, कऊँकि प्रभु पला ए;</para>
  <para style="q" vid="PSA 135:3">तेसरे नाओं रा पजन गाओ, कऊँकि प्रभु दया करने वाल़ा ए!<verse eid="PSA 135:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 135:4" />परमेशरे तिने याकूबो रे कराने ओर इस्राएलो रे लोका खे आपणा ऊणे रिया तँईं चूणी ला दा ए,<verse eid="PSA 135:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 135:5" />आऊँ जाणूंआ कि प्रभु महान ए,</para>
  <para style="q" vid="PSA 135:5">आसा रा प्रभु सबी देवतेया ते ऊच्चा ए।<verse eid="PSA 135:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 135:6" />जो कुछ प्रभुए चाया से तिने सर्ग,</para>
  <para style="q" vid="PSA 135:6">तरती ओर समुद्र ओर सारी डूगिया जगा रे कित्तेया।<verse eid="PSA 135:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 135:7" />से तरतिया रे कूणे ते बादल़ उठाओआ</para>
  <para style="q" vid="PSA 135:7">ओर बर्खा खे बिजल़ी चमकाओआ ओर आपणे स्वर्गिय पण्डारो ते पऊण चलाओआ।<verse eid="PSA 135:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 135:8" />प्रभुए मिस्रो रे माणूं ओर डांगर,</para>
  <para style="q" vid="PSA 135:8">सबी रे जेठे बच्चे मारी ते!<verse eid="PSA 135:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 135:9" />तेती मिस्रो दे तिने राजा ओर तेसरे सारे अधिकारिया खे सजा देणे खे चमत्कार ओर नौखे काम कित्ते।<verse eid="PSA 135:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 135:10" />तिने बऊत सारिया जातिया नाश कित्तिया</para>
  <para style="q" vid="PSA 135:10">ओर कई सामर्थी राजे काईते,<verse eid="PSA 135:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 135:11" />एमोरिया रा राजा सिहोन ओर बाशानो रा राजा ओग</para>
  <para style="q" vid="PSA 135:11">ओर कनानो रे सारे राजे घात कित्ते;<verse eid="PSA 135:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 135:12" />ओर तिने तिना री जमीन बांडी की,</para>
  <para style="q" vid="PSA 135:12">आपणी प्रजा इस्राएलो रे पाअग ऊणे खे देईती।<verse eid="PSA 135:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 135:13" />ओ प्रभु, तेरा नाओं सदा स्थिर ए,</para>
  <para style="q" vid="PSA 135:13">ओ प्रभु, जेते नाओं ते तूँ याद कित्तेया जाओआ, से पीढ़िया ते पीढ़िया तक बणेया रा रणा।<verse eid="PSA 135:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 135:14" />ओ प्रभु, तां आपणी प्रजा री रक्षा करनी</para>
  <para style="q" vid="PSA 135:14">ओर आपणे दासा री बुरी दशा देखी की तरस खाणा।<note caller="+" style="f"><char style="fr" closed="false">135:14 </char><char style="ft" closed="false">बिध. 32:36</char></note><verse eid="PSA 135:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 135:15" />दूजिया जातिया रे लोका रे देवते सूईने-चाँदिए रे ए,</para>
  <para style="q" vid="PSA 135:15">सेयो माणूंए आपणे आथे की बणाई राखिया।<verse eid="PSA 135:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 135:16" />तिना रे मूँ तो अए, पर सेयो बोली नि सकदिया,</para>
  <para style="q" vid="PSA 135:16">तिना रे आखी तो अईया, पर सेयो देखी नि सकदिया,<verse eid="PSA 135:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 135:17" />तिना मूर्तिया रे कान तो अए, पर सेयो सुणी नि सकदिया,</para>
  <para style="q" vid="PSA 135:17">ना ई तिना रे मुंए रे जिन्दगिया रा साआ ए।<note caller="+" style="f"><char style="fr" closed="false">135:17 </char><char style="ft" closed="false">प्रकाशित 9:20</char></note><verse eid="PSA 135:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 135:18" />जो तिना खे बणाओए, सेयो तिना मूर्तिया जेड़े ई निर्जीव ए।</para>
  <para style="q" vid="PSA 135:18">सेयो बी बेजान ए, जो तिना पाँदे परोसा करोए!<verse eid="PSA 135:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 135:19" />ओ इस्राएलो रे कराने रे लोको, प्रभुए खे तन्य बोलो!</para>
  <para style="q" vid="PSA 135:19">ओ हारूण वंशो रे पुरोईतो, प्रभुए खे तन्य बोलो!<verse eid="PSA 135:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 135:20" />ओ लेवी वंशो रे लोको, प्रभुए खे तन्य बोलो!</para>
  <para style="q" vid="PSA 135:20">ओ प्रभुए रे पग्तो, प्रभुए खे तन्य बोलो!<verse eid="PSA 135:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PSA 135:21" />प्रभु जो यरूशलेमो रे रओआ,</para>
  <para style="q" vid="PSA 135:21">तेसखे सिय्योनो रे तन्य बोलेया जाओ! प्रभुए री स्तुति करो!<verse eid="PSA 135:21" /></para>
  <chapter eid="PSA 135" />
  <chapter number="136" style="c" sid="PSA 136" />
  <para style="s">परमेशरो री करूणा सदा री ए</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 136:1" />प्रभुए रा तन्यवाद करो, कऊँकि से पला ए</para>
  <para style="q" vid="PSA 136:1">ओर तेसरी करूणा सदा री ए।<verse eid="PSA 136:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 136:2" />यहोवा जो सबी देवतेया पाँदे शासन करोआ,</para>
  <para style="q" vid="PSA 136:2">तेसरी करूणा सदा री ए।<verse eid="PSA 136:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 136:3" />सबी ते बड़े पराक्रमी यहोवे रा तन्यवाद करो,</para>
  <para style="q" vid="PSA 136:3">तेसरी करूणा सदा री ए।<verse eid="PSA 136:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 136:4" />प्रभुए ते अलावा कोई बड़े-बड़े अचम्बे रे काम नि करी सकदा,</para>
  <para style="q" vid="PSA 136:4">तेसरी करूणा सदा री ए।<verse eid="PSA 136:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 136:5" />तिने आपणी समजा साथे सर्ग बणाया,</para>
  <para style="q" vid="PSA 136:5">तेसरी करूणा सदा री ए।<verse eid="PSA 136:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 136:6" />समुद्रो पाँदे तरतिया खे फैलाणे वाल़े रा तन्यवाद करो,</para>
  <para style="q" vid="PSA 136:6">तेसरी करूणा सदा री ए।<verse eid="PSA 136:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 136:7" />तिने सूरज ओर चाँद बणाए, तेसरी करूणा सदा री ए।<verse eid="PSA 136:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 136:8" />तिने दिनो पाँदे राज करने रिया तँईं सूरज बणाया,</para>
  <para style="q" vid="PSA 136:8">तेसरी करूणा सदा री ए<verse eid="PSA 136:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 136:9" />ओर राती पाँदे राज करने रिया तँईं चाँद ओर तारे बणाए,</para>
  <para style="q" vid="PSA 136:9">तेसरी करूणा सदा री ए।<verse eid="PSA 136:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 136:10" />तिने मिस्री लोका रे जेठे बच्चे काईते,</para>
  <para style="q" vid="PSA 136:10">तेसरी करूणा सदा री ए<verse eid="PSA 136:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 136:11" />ओर तिने इस्राएली लोक मिस्रिया ते बचाए,</para>
  <para style="q" vid="PSA 136:11">तेसरी करूणा सदा री ए।<verse eid="PSA 136:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 136:12" />तिने आपणी नौखी सामर्था ते सेयो निकयाल़े,</para>
  <para style="q" vid="PSA 136:12">तेसरी करूणा सदा री ए।<verse eid="PSA 136:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 136:13" />तिने लाल समुद्रो रे दो इस्से करीते,</para>
  <para style="q" vid="PSA 136:13">तेसरी करूणा सदा री ए<verse eid="PSA 136:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 136:14" />तिने इस्राएली लोक समुद्रो रे बीचा-बिछिए पार करीते,</para>
  <para style="q" vid="PSA 136:14">तेसरी करूणा सदा री ए।<verse eid="PSA 136:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 136:15" />पर तिने राजा फिरौन तेसरिया सेना समेत लाल समुद्रो बीचे डबोई ता,</para>
  <para style="q" vid="PSA 136:15">तेसरी करूणा सदा री ए।<verse eid="PSA 136:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 136:16" />तिने आपणे निज लोका री सुनसाण जगा रे अगुवाई कित्ती,</para>
  <para style="q" vid="PSA 136:16">तेसरी करूणा सदा री ए।<verse eid="PSA 136:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 136:17" />तिने बड़े-बड़े राजा मारे,</para>
  <para style="q" vid="PSA 136:17">तेसरी करूणा सदा री ए।<verse eid="PSA 136:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 136:18" />तिने प्रतापी राजा बी काये,</para>
  <para style="q" vid="PSA 136:18">तेसरी करूणा सदा री ए;<verse eid="PSA 136:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 136:19" />तिने एमोरिया रे राजा सिहोन,</para>
  <para style="q" vid="PSA 136:19">तेसरी करूणा सदा री ए।<verse eid="PSA 136:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 136:20" />ओर बाशानो रा राजा ओग मारेया,</para>
  <para style="q" vid="PSA 136:20">तेसरी करूणा सदा री ए।<verse eid="PSA 136:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PSA 136:21" />तिना री जगा तिने आपणियां प्रजा खे दित्ती,</para>
  <para style="q" vid="PSA 136:21">तेसरी करूणा सदा री ए;<verse eid="PSA 136:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="PSA 136:22" />तिने से जगा इस्राएलो खे जो तेसरा आपणा दास ए तिना खे दित्ती;</para>
  <para style="q" vid="PSA 136:22">तेसरी करूणा सदा री ए।<verse eid="PSA 136:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="PSA 136:23" />प्रभुए आसा रिया बुरिया दशा रे म्हारी सम्बाल़ लई,</para>
  <para style="q" vid="PSA 136:23">तेसरी करूणा सदा री ए;<verse eid="PSA 136:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="PSA 136:24" />ओर म्हारे बैरिया ते आसे छुड़ाई राखे,</para>
  <para style="q" vid="PSA 136:24">तेसरी करूणा सदा री ए।<verse eid="PSA 136:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="PSA 136:25" />से सबी प्राणिया खे खाणे खे खाणा देओआ,</para>
  <para style="q" vid="PSA 136:25">तेसरी करूणा सदा री ए।<verse eid="PSA 136:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="PSA 136:26" />स्वर्गो रे परमेशरो रा तन्यवाद करो,</para>
  <para style="q" vid="PSA 136:26">तेसरी करूणा सदा री ए।<verse eid="PSA 136:26" /></para>
  <chapter eid="PSA 136" />
  <chapter number="137" style="c" sid="PSA 137" />
  <para style="s">बन्दुआईया दे इस्राएलो रा विलापगीत</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 137:1" />जेबे आसे बेबीलोनो री नईरा रे कनारे बैठीगे</para>
  <para style="q" vid="PSA 137:1">तेबे सिय्योनो खे याद करी की रोणे लगे!<verse eid="PSA 137:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 137:2" />तेती बिऊँसा रे डाल़ा पाँदे आसे आपणियां बीणा टाँगी तिया;<verse eid="PSA 137:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 137:3" />कऊँकि जो आसा खे बंदी बणाई की लईगे थे,</para>
  <para style="q" vid="PSA 137:3">सेयो आसा खे तेती गीत गाणे खे बोलो थे कि आसा खे सिय्योनो रा कोई गीत सुणाओ</para>
  <para style="q" vid="PSA 137:3">ओर आसा खे रुलाणे वाल़े आसा खे खुशी मनाणे खे बोलो थे।<verse eid="PSA 137:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 137:4" />पराये देशो रे आसे प्रभुए रा गाणा किंयाँ गाईये?<verse eid="PSA 137:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 137:5" />ओ यरूशलेम, जे आऊँ ताखे पूली जाऊँ,</para>
  <para style="q" vid="PSA 137:5">तो आऊँ फेर बीणा नि बजाई सकूँ।<verse eid="PSA 137:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 137:6" />जे आऊँ ताखे याद नि राखूँ, तो आऊँ फेर कदी नि गायी सकणा,</para>
  <para style="q" vid="PSA 137:6">जे आऊँ ताखे आपणी सबी ते बड़ी खुशी नि<verse eid="PSA 137:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 137:7" />ओ प्रभु, एदोमो रे वंशो रे खलाफ यरूशलेमो रे विनाशो रे तिना दिना खे याद कर कि सेयो किंयाँ बोलो थे,</para>
  <para style="q" vid="PSA 137:7">“टाल़ो! इजी खे निऊँआ तेई टाल़ी देओ!”<verse eid="PSA 137:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 137:8" />ओ बेबीलोन, तूँ तो चट ई उजड़ने वाल़ी ए,</para>
  <para style="q" vid="PSA 137:8">से माणूं तन्य ऊणा, जेस तां साथे एड़ा बर्ताव करना, जेड़ा तैं आसा साथे कित्तेया!<note caller="+" style="f"><char style="fr" closed="false">137:8 </char><char style="ft" closed="false">प्रकाशित 18:6 </char></note><verse eid="PSA 137:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 137:9" />से माणूं तन्य ऊणा,</para>
  <para style="q" vid="PSA 137:9">जेस तेरे बच्चे पकड़ी की चट्टानी पाँदे पटकी देणे!<note caller="+" style="f"><char style="fr" closed="false">137:9 </char><char style="ft" closed="false">प्रकाशित 18:6</char></note><verse eid="PSA 137:9" /></para>
  <chapter eid="PSA 137" />
  <chapter number="138" style="c" sid="PSA 138" />
  <para style="s">परमेशरो री कृपा रिया तँईं तन्यवादो री प्रार्थना</para>
  <para style="d">दाऊदो रा पजन</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 138:1" />ओ यहोवा, मां पूरे दिलो ते तेरा तन्यवाद करना;</para>
  <para style="q" vid="PSA 138:1">मां दूजेया देवतेया रे सामणे तेरी जयजयकारा रा गीत गाणा।<verse eid="PSA 138:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 138:2" />मां तेरे पवित्र मन्दरो रिया तरफा खे मूँ करी की माथा टेकणा</para>
  <para style="q" vid="PSA 138:2">ओर मां तेरी करूणा ओर सच्चाईया रिया तँईं तेरे नाओं री सराईणा करनी;</para>
  <para style="q" vid="PSA 138:2">कऊँकि तैं आपणे वचनो खे आपणे बड़े नाओं ते जादा महत्व देई राखेया।<verse eid="PSA 138:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 138:3" />जेस दिने मैं ताखे आका पाईया, तेस ई दिने तैं मेरी सुणी ली</para>
  <para style="q" vid="PSA 138:3">ओर तैं माखे तागत देई की मेरी ईम्मत बढ़ाई।<verse eid="PSA 138:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 138:4" />ओ प्रभु, तरतिया रे सारे राजेया तेरा तन्यवाद करना,</para>
  <para style="q" vid="PSA 138:4">कऊँकि तिने तेरे वादे सुणी राखे;<verse eid="PSA 138:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 138:5" />सेयो यहोवे रे महान प्रताप ओर</para>
  <para style="q" vid="PSA 138:5">जो काम यहोवे कित्तेया तीजी खे तिना गीत गायी की जयजयकार करनी।<verse eid="PSA 138:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 138:6" />तेबे बी प्रभु, तूँ ऊच्चे सिंहासणो पाँदे बैठेया राए,</para>
  <para style="q" vid="PSA 138:6">तेबे बी तूँ नम्र माणूंआ रिया तरफा खे देखोआ,</para>
  <para style="q" vid="PSA 138:6">पर कमण्डिया खे दूरा तेई पछयाणी लओआ।<verse eid="PSA 138:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 138:7" />जेबे आऊँ मुसीबता ते किरेया दा ऊँआ, तो तुसे माखे बचाई की राखोए।</para>
  <para style="q" vid="PSA 138:7">तुसे मेरे गुस्से ते परे दुश्मणा रा बरोद करो ओर आपणियां तागती ते माखे बचाओ।<verse eid="PSA 138:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 138:8" />प्रभुए मेरिया तँईं आपणे वादे रे मुताबिक सब कुछ पूरा करना; ओ प्रभु, तेरी करूणा सदा री ए!</para>
  <para style="q" vid="PSA 138:8">जो काम तैं शुरू कित्तेया, तेसखे एबे तूँ खत्म करी दे।<verse eid="PSA 138:8" /></para>
  <chapter eid="PSA 138" />
  <chapter number="139" style="c" sid="PSA 139" />
  <para style="s">परमेशरो रा सिद्ध ज्ञान</para>
  <para style="d">बजाणे वाल़े रे परदानो रिया तँईं दाऊदो रा पजन</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 139:1" />ओ यहोवा, तैं आऊँ परखी की जाणी ला रा।<note caller="+" style="f"><char style="fr" closed="false">139:1 </char><char style="ft" closed="false">रोमी 8:27</char></note></para>
  <para style="q" vid="PSA 139:1">ओर तुसा खे मेरे बारे दे सब कुछ पता ए<verse eid="PSA 139:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 139:2" />तूँ मेरा उठणा-बैठणा जाणेया</para>
  <para style="q" vid="PSA 139:2">ओर मेरिया सोचा खे दूरा तेई समजी लया।<verse eid="PSA 139:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 139:3" />तूँ मेरे चलणे ओर राम करने रिया जगा रा ठीक-टंगो रे पता लगाई लया</para>
  <para style="q" vid="PSA 139:3">ओर तूँ मेरे पूरे चाल-चलणो रा पेत जाणेया।<verse eid="PSA 139:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 139:4" />ओ प्रभु, मेरे मुंए री एड़ी कोई बी गल्ल नि ए</para>
  <para style="q" vid="PSA 139:4">जेतेखे तूँ पुरिया तरअ ते नि जाणदा ओ।<verse eid="PSA 139:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 139:5" />तूँ मेरे चऊँ कनारे हर तरफा खे आ;</para>
  <para style="q" vid="PSA 139:5">तूँ आपणियां तागती ते मेरी रक्षा करेया।<verse eid="PSA 139:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 139:6" />प्रभु, ये ज्ञान माखे बऊत कठण ए,</para>
  <para style="q" vid="PSA 139:6">ये बऊत ई गईरा ज्ञान ए, जो मेरिया समजा ते बारे ए।<verse eid="PSA 139:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 139:7" />आऊँ तेरिया आत्मा ते लग ऊई की केई जाऊँगा?</para>
  <para style="q" vid="PSA 139:7">आँऊ तेरिया मौजुदगिया ते केई नठूँ?<verse eid="PSA 139:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 139:8" />जे आऊँ सर्गो पाँदे चढ़ूँ, तो तूँ तेती ए!</para>
  <para style="q" vid="PSA 139:8">जे आऊँ आपणा बछौणा मरेया री दुनिया रे बछाऊँ, तो तेती बी तूँई ए!<verse eid="PSA 139:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 139:9" />जे आऊँ उडी की पूर्व दिशा रिया तरफा खे</para>
  <para style="q" vid="PSA 139:9">समुद्रो ते पार कलाणियां दे बसूँ,<verse eid="PSA 139:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 139:10" />तो तेती बी तां मेरी अगुआई करनी,</para>
  <para style="q" vid="PSA 139:10">ओर तां मेरी मताद करनी,<verse eid="PSA 139:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 139:11" />जे आऊँ बोलूँ कि मां न्हेरे लूकी जाणा</para>
  <para style="q" vid="PSA 139:11">ओर मेरे चऊँ कनारला प्रयासा रात ऊई जाओ,<verse eid="PSA 139:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 139:12" />तेबे बी आँऊ न्हेरे तांते नि लूकी सकदा,</para>
  <para style="q" vid="PSA 139:12">कऊँकि राती बी दिनो रे बराबर प्रयासा देणा,</para>
  <para style="q" vid="PSA 139:12">ताखे तो न्हेरा ओर प्रयासा दोनो एक बराबर ए।<verse eid="PSA 139:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 139:13" />मेरे मनो रा स्वामी तो तूँई ए,</para>
  <para style="q" vid="PSA 139:13">मेरिया माया रे गर्भो रे तैंई आँऊ बणाई राखेया।<verse eid="PSA 139:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 139:14" />मां तेरा तन्यवाद करना, कऊँकि आऊँ खतरनाक ओर अद्भुत तरीके रे रची राखेया।</para>
  <para style="q" vid="PSA 139:14">तेरे काम कितणे अचम्बे रे ए ओर आऊँ इजी खे ठीक-टंगो रे जाणूंआ।<note caller="+" style="f"><char style="fr" closed="false">139:14 </char><char style="ft" closed="false">प्रकाशित 15:3</char></note><verse eid="PSA 139:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 139:15" />जेबे मेरी आड्डिया बणने लगी रिया थिया, तो त्यानो साथे आपणियां माया रे पेटो दे राखणे लगी रे थे,</para>
  <para style="q" vid="PSA 139:15">जेबे आऊँ तेती गुप्त रूपो दे बढ़ने लगी रा था, तो तुसे जाणो थे कि आऊँ तेती था,<verse eid="PSA 139:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 139:16" />तेरिये आखी मेरा बांगा-टेडा शरीर बणदा देखेया</para>
  <para style="q" vid="PSA 139:16">ओर मेरे सारे अंग जो हर दिन बणदे जाओ थे,</para>
  <para style="q" vid="PSA 139:16">सेयो रचे जाणे ते पईले, तेरिया कताबा रे लिखी राखे थे।<verse eid="PSA 139:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 139:17" />ओ परमेशर, तेरे बिचार मेरिया तँईं कितणे कीमती ए!</para>
  <para style="q" vid="PSA 139:17">तिना री गिणतिया रा जोड़ कितणा बड़ा ए!<verse eid="PSA 139:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 139:18" />जे आऊँ तिना खे गिणदा तो सेयो बालूए रे कणा ते बी जादा ऊणे थे।</para>
  <para style="q" vid="PSA 139:18">जेबे आऊँ जागूँआ, तेबे बी तां साथे रऊँआ।<verse eid="PSA 139:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 139:19" />ओ परमेशर, पक्का तां दुष्ट माणूं काई देणे!</para>
  <para style="q" vid="PSA 139:19">ओ अत्या करने वाल़ेयो, मांते दूर ऊई जाओ!<verse eid="PSA 139:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 139:20" />कऊँकि सेयो तेरी चर्चा उशयारिया रे करोए,</para>
  <para style="q" vid="PSA 139:20">तेरे दुश्मण तेरा नाओं चूठिया गल्ला रे लओए।<verse eid="PSA 139:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PSA 139:21" />ओ प्रभु, क्या आसे तेरे बैरिया साथे बैर नि करुँ,</para>
  <para style="q" vid="PSA 139:21">ओर तेरे बरोदिया साथे क्या आँऊ दुश्मणी नि राखूँ?<note caller="+" style="f"><char style="fr" closed="false">139:21 </char><char style="ft" closed="false">प्रकाशित 2:6</char></note><verse eid="PSA 139:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="PSA 139:22" />आ, आऊँ तिना साथे दिलो ते कृणा करूँआ,</para>
  <para style="q" vid="PSA 139:22">आऊँ तिना खे आपणा दुश्मण समजूँआ।<verse eid="PSA 139:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="PSA 139:23" />ओ परमेशर, माखे परख ओर मेरा दिल पछयाण, माखे जांची-परखी लओ!</para>
  <para style="q" vid="PSA 139:23">ओर मेरे बचारा खे जाणी लओ!<verse eid="PSA 139:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="PSA 139:24" />ओर देख कि मांदे कोई बुरी चाल तो नि ए,</para>
  <para style="q" vid="PSA 139:24">प्रभु, माखे सदा रिया बाटा रे लई चल!<verse eid="PSA 139:24" /></para>
  <chapter eid="PSA 139" />
  <chapter number="140" style="c" sid="PSA 140" />
  <para style="s">रक्षा रिया तँईं प्रार्थना</para>
  <para style="d">बजाणे वाल़े रे परदानो रिया तँईं दाऊदो रा पजन</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 140:1" />ओ प्रभु, माखे बुरेया माणूंआ ते बचाई लओ;</para>
  <para style="q" vid="PSA 140:1">ईंसा करने वाल़े मर्दो ते मेरी रक्षा कर;<verse eid="PSA 140:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 140:2" />सेयो दिलो रे बुरा करने री सोची राखोए;</para>
  <para style="q" vid="PSA 140:2">सेयो लगातार लड़ाईया करोए।<verse eid="PSA 140:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 140:3" />तिना रिया जीबा काणे वाल़े सापो जेड़िया ए,</para>
  <para style="q" vid="PSA 140:3">तिना रिया गल्ला नागो रे जईरो जेड़िया ओईया।<note caller="+" style="f"><char style="fr" closed="false">140:3 </char><char style="ft" closed="false">रोमी 3:13, याकूब 3:8</char></note> सेला<verse eid="PSA 140:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 140:4" />ओ यहोवा, माखे दुष्ट माणूंआ रे आथो ते बचाई लओ;</para>
  <para style="q" vid="PSA 140:4">माखे तिना चगड़ा करने वाल़े लोका ते बचा जो मेरे राचणे री साजिश करोए।<verse eid="PSA 140:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 140:5" />इने कमण्डिये माखे फंदे लगाई राखे,</para>
  <para style="q" vid="PSA 140:5">बाटा रे माखे पकड़ने खे जाल़ बछाई राखेया ए। सेला<verse eid="PSA 140:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 140:6" />ओ प्रभु, मैं ताखे बोली राखेया कि तूँई मेरा परमेशर ए;</para>
  <para style="q" vid="PSA 140:6">ओ प्रभु, मेरे गिड़गिड़ाणे रिया तरफा खे त्यान दे!<verse eid="PSA 140:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 140:7" />ओ प्रभु परमेशर, ओ मेरे सामर्थी उद्धारकर्ता,</para>
  <para style="q" vid="PSA 140:7">तैं युद्धो रे बखते मेरी रक्षा करी राखी।<verse eid="PSA 140:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 140:8" />ओ प्रभु, दुष्टो री इच्छा खे पूरी नि ऊणे दे,</para>
  <para style="q" vid="PSA 140:8">तेसरी बुरी साजिश सफल नि ऊणे दे,</para>
  <para style="q" vid="PSA 140:8">नई तो तेस कमण्ड करना। सेला<verse eid="PSA 140:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 140:9" />सेयो दुश्मण जिने आँऊ केरी राखेया</para>
  <para style="q" vid="PSA 140:9">तिना रा सोचेया रा अनिष्ठ तिना रेई सिरो पाँदे पड़ो!<verse eid="PSA 140:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 140:10" />तिना पाँदे आगी रे फेऊआ री बरखा ओ!</para>
  <para style="q" vid="PSA 140:10">सेयो आगी बीचे सेटे जाओ!</para>
  <para style="q" vid="PSA 140:10">सेयो एड़े गड्डे रे पड़ो कि सेयो फेर उठी नि सको!<verse eid="PSA 140:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 140:11" />दूजेया पाँदे चूठा दोष लगाणे वाल़े सफल नि ओ;</para>
  <para style="q" vid="PSA 140:11">बुराई चगड़ा करने वाल़ेया लोका पाँदे हावी ऊणे दे ओर तिना खे नाश करने दे,<verse eid="PSA 140:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 140:12" />ओ यहोवा, माखे परोसा ए कि तूँ दु:खी माणूंआ रा ओर गरीबा रा न्याय चुकाणा।<verse eid="PSA 140:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 140:13" />तर्मी लोका तेरी स्तुति करनी;</para>
  <para style="q" vid="PSA 140:13">सेयो तेरे सामणे रणे।<verse eid="PSA 140:13" /></para>
  <chapter eid="PSA 140" />
  <chapter number="141" style="c" sid="PSA 141" />
  <para style="s">पाप ओर पापिया ते बचाव रिया तँईं प्रार्थना</para>
  <para style="d">दाऊदो रा पजन</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 141:1" />ओ प्रभु, माखे गल़त काम करने री इच्छा ते ओर बुरेया लोका रिया दुष्टता दे शामिल ऊणे ते बचा।</para>
  <para style="q" vid="PSA 141:1">आऊँ कदी बी तिना रिया पाट्टिया दे ईसा नि लऊँ।<verse eid="PSA 141:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 141:2" />मेरी प्रार्थना तां सामणे खुशबूदार तूप ओर मेरा आथ जोड़ना,</para>
  <para style="q" vid="PSA 141:2">साँजके बखतो री नज्जो री बलि मानी जाओ!<note caller="+" style="f"><char style="fr" closed="false">141:2 </char><char style="ft" closed="false">प्रकाशित 5:8, प्रकाशित 8:3,4, नसी 3:25,1 पत 3:6</char></note><verse eid="PSA 141:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 141:3" />ओ यहोवा, माखे गल़त गल्ला नि बोलणे दे;</para>
  <para style="q" vid="PSA 141:3">मेरे ओठा री रखवाल़ी कर!<note caller="+" style="f"><char style="fr" closed="false">141:3 </char><char style="ft" closed="false">याकूब 1:26</char></note><verse eid="PSA 141:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 141:4" />मेरा मन केसी बुरिया गल्ला रिया तरफा खे फिरने नि देया;</para>
  <para style="q" vid="PSA 141:4">आऊँ बुरे काम करने वाल़े माणूंआ साथे, तिना रे बुरे कामा रे नि लगूँ</para>
  <para style="q" vid="PSA 141:4">ओर आऊँ तिना रे स्वाद खाणे रिया चीजा बीचा ते कुछ पनि खाऊँ!<verse eid="PSA 141:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 141:5" />तर्मी लोक माखे सजा देओ ओर दया ते माखे बको, पर मां बुरेया लोका ते इज्जत कदी नि लणी,</para>
  <para style="q" vid="PSA 141:5">कऊँकि आऊँ सदा तिना रे बुरे कामा रे खलाफ प्रार्थना करूँआ।<verse eid="PSA 141:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 141:6" />जेबे दुश्मणा रे शासक थाले सेटी देणे,</para>
  <para style="q" vid="PSA 141:6">तो लोका मानी लणा कि मेरी गल्ल सच्ची थी।<verse eid="PSA 141:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 141:7" />लकड़िया खे जिंयाँ दाल़ी की छोटे-छोटे टुकड़ेया दे बाडेया जाओआ,</para>
  <para style="q" vid="PSA 141:7">तिंयाँ ई तिना रिया आड्डिया दूजिया कब्रा रे नेड़े जमीना दे बखेरिया जाणिया।<verse eid="PSA 141:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 141:8" />पर ओ मेरे यहोवा, आऊँ तां पाँदे परोसा राखूँआ।</para>
  <para style="q" vid="PSA 141:8">आऊँ तांते शरण चाऊँआ; माखे मरने नि दे!<verse eid="PSA 141:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 141:9" />जो फन्दा तिने मेरिया तँईं लगाई राखेया</para>
  <para style="q" vid="PSA 141:9">तिजी ते ओर बुरे काम करने वाल़ेया रे जाल़ो ते मेरी रक्षा कर!<verse eid="PSA 141:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 141:10" />दुष्ट लोक आपणे जाल़ो रे आपू ई फसो,</para>
  <para style="q" vid="PSA 141:10">पर आऊँ बची जाऊँ।<verse eid="PSA 141:10" /></para>
  <chapter eid="PSA 141" />
  <chapter number="142" style="c" sid="PSA 142" />
  <para style="s">मतादा रिया तँईं प्रार्थना</para>
  <para style="d">दाऊदो रा मश्कील, जेबे से गुफा रे था: प्रार्थना</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 142:1" />आऊँ मतादा रिया तँईं प्रभुए री दुहाई देऊँआ,</para>
  <para style="q" vid="PSA 142:1">आऊँ ऊच्चिया आवाजा रे प्रभुए ते बिनती करूँआ,<verse eid="PSA 142:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 142:2" />आऊँ प्रभुए रे सामणे आपणे दु:खो रिया गल्ला बताऊँआ,</para>
  <para style="q" vid="PSA 142:2">आऊँ आपणियां मुसीबता तेस सामणे बताऊँआ।<verse eid="PSA 142:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 142:3" />जेबे आऊँ बऊत जादा नराश ऊई जाऊँआ, तो से जाणोआ कि माखे क्या करना चाईयो।</para>
  <para style="q" vid="PSA 142:3">जेते बाटा रिये आऊँ चलूँआ, तेते बाटा दे मेरे दुश्मणे माखे पकड़ने खे जाल़ बछाई राखेया।<verse eid="PSA 142:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 142:4" />जेबे आऊँ आपणे ओरे-पोरे देखूँआ, तो मेरी मताद करने वाल़ा ओर रक्षा करने वाल़ा कोई नि ए।</para>
  <para style="q" vid="PSA 142:4">केसी खे मेरी परवा नि ए।<verse eid="PSA 142:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 142:5" />ओ यहोवा, आँऊ तांगे रोया कि तूँ मेरी मताद करे,</para>
  <para style="q" vid="PSA 142:5">माखे बचाणे वाल़ा तूँई ए,</para>
  <para style="q" vid="PSA 142:5">मेरे जिऊँदे जिऊए तूँई मेरा सब कुछ ए।<verse eid="PSA 142:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 142:6" />मेरा रोणा त्यानो साथे सुण,</para>
  <para style="q" vid="PSA 142:6">कऊँकि मेरी दशा बऊत बुरी ऊई गी री!</para>
  <para style="q" vid="PSA 142:6">जो मां पीछे पड़ी रे, तिना ते माखे बचाई लओ;</para>
  <para style="q" vid="PSA 142:6">कऊँकि सेयो मांते जादा तागतबर ए।<verse eid="PSA 142:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 142:7" />माखे मेरेया दु:खा ते बचा;</para>
  <para style="q" vid="PSA 142:7">तेबे मां तेरिया तर्मी प्रजा रिया मण्डल़िया दे तेरी स्तुति करनी,</para>
  <para style="q" vid="PSA 142:7">कऊँकि तैं मेरी पलाई करी राखी ए।<verse eid="PSA 142:7" /></para>
  <chapter eid="PSA 142" />
  <chapter number="143" style="c" sid="PSA 143" />
  <para style="s">छुटकारे रिया तँईं प्रार्थना</para>
  <para style="d">दाऊदो रा पजन</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 143:1" />ओ प्रभु, मेरी प्रार्थना सुण,</para>
  <para style="q" vid="PSA 143:1">मेरे गिड़गिड़ाणे रिया तरफा खे त्यान दे!</para>
  <para style="q" vid="PSA 143:1">आपणी सच्चाई ओर तार्मिकता रे मुताबिक माखे उत्तर दे।<verse eid="PSA 143:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 143:2" />ओ प्रभु, आपणे दासो साथे मुकद्दमा नि चला!</para>
  <para style="q" vid="PSA 143:2">कऊँकि कोई प्राणी तेरी नजरा रे निर्दोष नि ठईरी सकदा।<note caller="+" style="f"><char style="fr" closed="false">143:2 </char><char style="ft" closed="false">रोमी 3:20, 1 कुरिन्थ 4:4, गलाति 2:16</char></note><verse eid="PSA 143:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 143:3" />मेरेया दुश्मणे मेरे प्राणो रा शकार कित्तेया ए ओर आऊँ पुरिया तरआ ते अराई दित्तेया रा ए।</para>
  <para style="q" vid="PSA 143:3">तिने आऊँ न्हेरिया जगा दे पाईता रा ओर आऊँ तिना जेड़ा ए जो बऊत पईले मरी गे रे ए।<verse eid="PSA 143:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 143:4" />इजी बजा ते आऊँ बऊत नराश ओर चिन्ता दे आ।<verse eid="PSA 143:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 143:5" />माखे पुराणे दिन याद आओए,</para>
  <para style="q" vid="PSA 143:5">आऊँ तेरे सारे अद्भुत कामा पाँदे त्यान करूँआ</para>
  <para style="q" vid="PSA 143:5">ओर तेरे आथो रे कामा खे सोचूँआ।<verse eid="PSA 143:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 143:6" />आऊँ आपणे आथ फलाई कि तांते बिनती करूँआ,</para>
  <para style="q" vid="PSA 143:6">सूकिया जमीना जेड़ा मेरा प्राण तेरिया तँईं त्याया ए। सेला<verse eid="PSA 143:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 143:7" />ओ प्रभु, चटचारे मेरी सुणी लओ;</para>
  <para style="q" vid="PSA 143:7">कऊँकि मेरे प्राण निकल़ने ई वाल़े ए,</para>
  <para style="q" vid="PSA 143:7">मांते आपणा मूँ नि लको,</para>
  <para style="q" vid="PSA 143:7">एड़ा नि ओ कि आऊँ कब्रा रे पड़े रे मरेया जेड़ा ऊई जाऊँ।<verse eid="PSA 143:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 143:8" />प्रभु, प्यागा आपणी करूणा रे वचन माखे सुणा;</para>
  <para style="q" vid="PSA 143:8">आऊँ तां ई पाँदे परोसा करूँआ।</para>
  <para style="q" vid="PSA 143:8">जेते बाटा रे माखे चलणा चाईयो,</para>
  <para style="q" vid="PSA 143:8">से बाट माखे बताई दे,</para>
  <para style="q" vid="PSA 143:8">कऊँकि आऊँ तेरा ई त्यान करूँआ।<verse eid="PSA 143:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 143:9" />ओ यहोवा, माखे मेरे दुश्मणा ते बचाई लओ;</para>
  <para style="q" vid="PSA 143:9">आऊँ बचणे रिया तँईं तांगे आऊँआ।<verse eid="PSA 143:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 143:10" />तूँ मेरा परमेशर ए। माखे ये सखा, कि तूँ आपणिया इच्छा ते मांते क्या करवाणा चाएया,</para>
  <para style="q" vid="PSA 143:10">ओर तेरा पला आत्मा माखे सई बाटा रिये लई चलो।<verse eid="PSA 143:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 143:11" />ओ यहोवा, तूँ जो तर्मी ए, माखे छुड़ा;</para>
  <para style="q" vid="PSA 143:11">कऊँकि तूँ पला ए माखे मेरिया मुसीबता ते छुड़ाई लओ!<verse eid="PSA 143:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 143:12" />ओर आपणी करूणा करी की मेरे दुश्मणा रा सत्यानाश करी दे</para>
  <para style="q" vid="PSA 143:12">ओर माखे सताणे वाल़े सबी बैरिया रा सत्यानाश करी दे,</para>
  <para style="q" vid="PSA 143:12">कऊँकि आऊँ तेरा दास ए।<verse eid="PSA 143:12" /></para>
  <chapter eid="PSA 143" />
  <chapter number="144" style="c" sid="PSA 144" />
  <para style="s">जीत आसिल ऊणे पाँदे तन्यवादो री प्रार्थना</para>
  <para style="d">दाऊदो रा पजन</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 144:1" />यहोवे री स्तुति करो, मेरी रक्षा करने वाल़ा! से माखे युद्ध करने रिया तँईं सिखाओआ ओर त्यार करोआ।<verse eid="PSA 144:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 144:2" />से मेरी रक्षा करने वाल़ा ए, मेरी रणे री जगा ओर मेरा उद्धार करने वाल़ा ए,</para>
  <para style="q" vid="PSA 144:2">जेस पाँदे आऊँ बचणे रिया तँईं परोसा करूँआ।</para>
  <para style="q" vid="PSA 144:2">से देशो-देशो रे लोका खे मेरे वशो रे करी देओआ।<verse eid="PSA 144:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 144:3" />ओ प्रभु, माणूं क्या ए कि तूँ तेस पाँदे त्यान देओ,</para>
  <para style="q" vid="PSA 144:3">या आदमी क्या ए कि तूँ तेसरी कुछ चिन्ता करो?<verse eid="PSA 144:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 144:4" />माणूं साओ जेड़ा ए,</para>
  <para style="q" vid="PSA 144:4">तेसरे उम्रा रे दिन टल़दी ऊई छांयी जेड़े ए।<verse eid="PSA 144:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 144:5" />ओ यहोवा, सर्गो खे पड़दे जेड़ा फाड़ी की थाले उतरी की आओ!</para>
  <para style="q" vid="PSA 144:5">बड़े-बड़े पाह्ड़ा खे छूँ तेबे तिना ते तुआँ उठणा!<verse eid="PSA 144:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 144:6" />तूँ बिजल़ी कड़कड़ाई की मेरे दुश्मणा खे तित्तर बित्तर करी दे,</para>
  <para style="q" vid="PSA 144:6">आपणे तीर चला, ताकि सेयो कबराई जाओ!<verse eid="PSA 144:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 144:7" />तूँ ऊच्चिया जगा ते आपणे आथ बढ़ाई की माखे गईरे समुद्रो ते बारे निकयाल़,</para>
  <para style="q" vid="PSA 144:7">मतलब परदेशिया रे वशो ते माखे छुड़ा।<verse eid="PSA 144:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 144:8" />सेयो कदी सच्च नि बोलदे,</para>
  <para style="q" vid="PSA 144:8">ओर सेयो कसम खाई की बी चूठ बोलोए।<verse eid="PSA 144:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 144:9" />ओ यहोवा, मां तेरिया तँईं नवां गीत गाणा;</para>
  <para style="q" vid="PSA 144:9">मां दस तारा वाल़ी सारंगी बजाई की तेरा पजन गाणा।<note caller="+" style="f"><char style="fr" closed="false">144:9 </char><char style="ft" closed="false">प्रकाशित 5:9, प्रकाशित 14:3</char></note><verse eid="PSA 144:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 144:10" />तूँई राजेया खे जीत दलाओआ</para>
  <para style="q" vid="PSA 144:10">ओर आपणे दास दाऊदो खे तलवारी री मारा ते बचाएया।<verse eid="PSA 144:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 144:11" />प्रभु, माखे बारे निकयाल़</para>
  <para style="q" vid="PSA 144:11">ओर परदेशिया रे वशो ते छुड़ाई लओ,</para>
  <para style="q" vid="PSA 144:11">सेयो कदी सच्च नि बोलदे,</para>
  <para style="q" vid="PSA 144:11">ओर सेयो कसम खाई की बी चूठ बोलोए।<verse eid="PSA 144:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 144:12" />म्हारे माठे जवानिया रे बखते पौधेया जेड़े बढ़े रे ओ</para>
  <para style="q" vid="PSA 144:12">ओर म्हारिया बेटिया तिना कुणे वाल़े खम्बेया जेड़िया ऊई जाओ,</para>
  <para style="q" vid="PSA 144:12">जो मईलो खे बणाए जाओए;<verse eid="PSA 144:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 144:13" />म्हारे पण्डार-कअर हर किस्मा रे नज्जो साथे परे रओ</para>
  <para style="q" vid="PSA 144:13">ओर म्हारिया पेडा-बाकरिया म्हारे मैदानो रे ह्जारो-ह्जार बच्चे पैदा करो;<verse eid="PSA 144:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 144:14" />जेबे म्हारे बल़द खूब लदे रे ओ;</para>
  <para style="q" vid="PSA 144:14">जेबे आसा रे ना कोई बिग्न ओ</para>
  <para style="q" vid="PSA 144:14">ओर ना ई म्हारा केथी युद्धो रे जाणा ओ</para>
  <para style="q" vid="PSA 144:14">ओर ना म्हारे चौका रे रोणे री आवाज सुणो!<verse eid="PSA 144:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 144:15" />एड़े सुख-चैना साथे रणे वाल़े लोक तन्य ए!</para>
  <para style="q" vid="PSA 144:15">सेयो लोक तन्य ए जिना रा परमेशर प्रभु ए!<verse eid="PSA 144:15" /></para>
  <chapter eid="PSA 144" />
  <chapter number="145" style="c" sid="PSA 145" />
  <para style="s">परमेशरो री महिमा ओर प्यारो रा गीत</para>
  <para style="d">दाऊदो रा पजन</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 145:1" />ओ मेरे परमेशर, ओ राजा, मां तेरा गुणगाण करना</para>
  <para style="q" vid="PSA 145:1">ओर जुगो-जुगो तक तेरे नाओं खे तन्य बोलदे रणा।<verse eid="PSA 145:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 145:2" />हर रोज मां ताखे तन्य बोलेया करना</para>
  <para style="q" vid="PSA 145:2">ओर जुगो-जुगो तक तेरे नाओं री स्तुति करदे रणा।<verse eid="PSA 145:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 145:3" />प्रभु महान् ओर बऊत स्तुति करने जोगा ए</para>
  <para style="q" vid="PSA 145:3">ओर प्रभुए री महानता अपार ए।<verse eid="PSA 145:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 145:4" />तेरे कामा री तारीफ ओर तेरे महान कामा रा बखाण,</para>
  <para style="q" vid="PSA 145:4">पीढ़िया ते पीढ़िया तक ऊँदा जाणा।<verse eid="PSA 145:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 145:5" />मां तेरे एश्वर्य री महिमा रे प्रतापो पाँदे</para>
  <para style="q" vid="PSA 145:5">ओर तेरे अचम्बे रे कामा पाँदे त्यान करना।<verse eid="PSA 145:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 145:6" />लोका तेरे खतरनाक कामा री शक्तिया री चर्चा करनी</para>
  <para style="q" vid="PSA 145:6">ओर मां तेरे बड़े-बड़े कामा रा बखाण करना।<verse eid="PSA 145:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 145:7" />तिना तेरिया सारिया पलाईया रे बारे दे बताणा,</para>
  <para style="q" vid="PSA 145:7">ओर तेरे तर्मो रे बारे दे गाणा।<verse eid="PSA 145:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 145:8" />प्रभु अनुग्रह करने वाल़ा ओर दयालु,</para>
  <para style="q" vid="PSA 145:8">देरा ते गुस्सा करने वाल़ा ओर बऊत करूणा करने वाल़ा ए।<verse eid="PSA 145:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 145:9" />प्रभु सबी रिया तँईं पला ए</para>
  <para style="q" vid="PSA 145:9">ओर तेसरी दया तेसरिया सारिया सृष्टिया पाँदे ए।<verse eid="PSA 145:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 145:10" />ओ प्रभु, तेरिया सारिया सृष्टिया तेरा तन्यवाद करना</para>
  <para style="q" vid="PSA 145:10">ओर तेरे पग्त लोका ताखे तन्यवाद बोलेया करना!<verse eid="PSA 145:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 145:11" />तिना तेरे राज्य री महिमा री चर्चा करनी</para>
  <para style="q" vid="PSA 145:11">ओर तेरे सामर्था रिया गल्ला करनिया,<verse eid="PSA 145:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 145:12" />ताकि सेयो माणूंआ पाँदे तेरे महान कामा</para>
  <para style="q" vid="PSA 145:12">ओर तेरे राज्य रे प्रतापो री महिमा प्रगट करो।<verse eid="PSA 145:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 145:13" />तेरा राज्य जुगो-जुगो रा</para>
  <para style="q" vid="PSA 145:13">ओर तेरा राज पीढ़िया ते पीढ़िया तक बणेया रा रणा।<verse eid="PSA 145:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 145:14" />यहोवा तिना री मताद करोआ जो मुसीबता दे ए;</para>
  <para style="q" vid="PSA 145:14">से रूड़ेया देया खे ऊबे चकोआ।<verse eid="PSA 145:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 145:15" />प्रभु, सारेया प्राणिया रिया आखी तेरिया तरफा खे लगी रिया रओईया</para>
  <para style="q" vid="PSA 145:15">ओर तूँ तिना खे सई बखतो पाँदे खाणे खे देया।<verse eid="PSA 145:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 145:16" />तूँ आपणी मुट्ठी खोली की,</para>
  <para style="q" vid="PSA 145:16">सबी प्राणिया खे खाणे खे देई की सन्तुष्ट करेआ।<verse eid="PSA 145:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 145:17" />प्रभु आपणे सारे चाल-चलणो रे तार्मिक</para>
  <para style="q" vid="PSA 145:17">ओर आपणे सबी कामा दे करूणामय ए।<note caller="+" style="f"><char style="fr" closed="false">145:17 </char><char style="ft" closed="false">प्रकाशित 15:3, प्रकाशित 16:5</char></note><verse eid="PSA 145:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 145:18" />प्रभु आपणे सबी आका पाणे वाल़ेया रे नेड़े ए,</para>
  <para style="q" vid="PSA 145:18">से तिना सबी रे नेड़े ए, जितणे तेसखे सच्चाईया साथे आका पाओए।<verse eid="PSA 145:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 145:19" />से आपणे सारेया पग्ता री इच्छा पूरी करोआ</para>
  <para style="q" vid="PSA 145:19">ओर तिना री दुहाई सुणी की तिना खे बचाई लओआ।<verse eid="PSA 145:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 145:20" />प्रभु तिना सबी री रक्षा करोआ जो तेसते प्यार करोए,</para>
  <para style="q" vid="PSA 145:20">पर से सबी दुष्टा रा सत्यानाश करोआ।<verse eid="PSA 145:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PSA 145:21" />मां प्रभुए री स्तुति करनी</para>
  <para style="q" vid="PSA 145:21">ओर सारे प्राणी प्रभुए रे पवित्र नाओं खे जुगो-जुगो तक तन्य बोलदे रओ।<verse eid="PSA 145:21" /></para>
  <chapter eid="PSA 145" />
  <chapter number="146" style="c" sid="PSA 146" />
  <para style="s">उद्धार करने वाल़े परमेशरो री स्तुति</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 146:1" />प्रभुए री स्तुति करो।<note caller="+" style="f"><char style="fr" closed="false">146:1 </char><char style="ft" closed="false">हल्लेलुयाह </char></note></para>
  <para style="q" vid="PSA 146:1">ओ मेरे मन प्रभुए री स्तुति कर!<verse eid="PSA 146:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 146:2" />मां पूरी जिन्दगी प्रभुए री स्तुति करदे रणा;</para>
  <para style="q" vid="PSA 146:2">जदुए तक आऊँ जिऊँदा रणा,</para>
  <para style="q" vid="PSA 146:2">तदुए तक मां आपणे परमेशरो रा पजन गांदे रणा।<verse eid="PSA 146:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 146:3" />तुसे ना तो केसी परदानो पाँदे परोसा राखणा, ना केसी माणूंए पाँदे,</para>
  <para style="q" vid="PSA 146:3">कऊँकि तिना दे बचाणे री सामर्थ नि ए।<verse eid="PSA 146:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 146:4" />तिना रा बी प्राण निकल़ना, सेयो बी माट्टिया रे मिली जाणे;</para>
  <para style="q" vid="PSA 146:4">तेसी दिने तिना रिया सारिया योजना नाश ऊई जाणिया।<verse eid="PSA 146:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 146:5" />से बऊत ई तन्य ए, जेसरा मतदगार याकूबो रा परमेशर ए</para>
  <para style="q" vid="PSA 146:5">ओर जेसरा परोसा आपणे प्रभु परमेशरो पाँदे ए।<verse eid="PSA 146:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 146:6" />सेई परमेशर सर्ग ओर तरती, समुद्र ओर तिदे जो कुछ अए, सबी खे बनाणे वाल़ा ए</para>
  <para style="q" vid="PSA 146:6">ओर प्रभु आपणा वचन सदा खे पूरा करोआ।<note caller="+" style="f"><char style="fr" closed="false">146:6 </char><char style="ft" closed="false">प्रेरित 4:24, प्रेरित 14:15, प्रेरित 17:24, प्रकाशित 10:6, प्रकाशित 14:7</char></note><verse eid="PSA 146:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 146:7" />से कमजोर माणूंआ खे न्याय दलाओआ</para>
  <para style="q" vid="PSA 146:7">ओर पूखेया खे रोटी देओआ।</para>
  <para style="q" vid="PSA 146:7">प्रभु बंदिया खे छुड़ाओआ;<verse eid="PSA 146:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 146:8" />यहोवा अन्देया खे आखी देओआ।</para>
  <para style="q" vid="PSA 146:8">से तिना खे ऊबे चकोआ जो रूड़ी गे रे,</para>
  <para style="q" vid="PSA 146:8">यहोवा तर्मिया साथे प्यार राखोआ।<verse eid="PSA 146:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 146:9" />प्रभु परदेशिया री रक्षा करोआ</para>
  <para style="q" vid="PSA 146:9">ओर अनाथ ओर बिदुआ खे सम्बाल़ोआ;</para>
  <para style="q" vid="PSA 146:9">पर से दुष्टा री बाटा खे बांगा-टेडा करोआ।<verse eid="PSA 146:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 146:10" />ओ सिय्योन, तेरा प्रभु परमेशर पीढ़िया ते पीढ़िया तक सदा राज्य करदा रणा।</para>
  <para style="q" vid="PSA 146:10">प्रभुए री स्तुति करो।<note caller="+" style="f"><char style="fr" closed="false">146:10 </char><char style="ft" closed="false">हल्लेलुयाह!</char></note><verse eid="PSA 146:10" /></para>
  <chapter eid="PSA 146" />
  <chapter number="147" style="c" sid="PSA 147" />
  <para style="s">सर्वशक्तिमान परमेशरो री स्तुति</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 147:1" />प्रभुए री स्तुति करो!</para>
  <para style="q" vid="PSA 147:1">आपणे परमेशरो रा पजन गाणा अच्छा ए;</para>
  <para style="q" vid="PSA 147:1">कऊँकि से मनो खे अच्छा लगणे वाल़ा ए,</para>
  <para style="q" vid="PSA 147:1">तेसरी स्तुति करना मनो खे अच्छा लगोआ।<verse eid="PSA 147:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 147:2" />प्रभु यरूशलेमो खे फेर बसाणे लगी रा;</para>
  <para style="q" vid="PSA 147:2">से इस्राएलिया खे गुलामिया ते वापस आपणे कअरे ल्याऊणे लगी रा।<verse eid="PSA 147:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 147:3" />यहोवा दु:खी दिलो वाल़ेया खे ठीक करोआ</para>
  <para style="q" vid="PSA 147:3">ओर तिना रे जख्मा पाँदे पट्टी बानोआ।<verse eid="PSA 147:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 147:4" />से तारेया खे गिणोआ</para>
  <para style="q" vid="PSA 147:4">ओर से सारेया तारेया खे तिना रे नाओं ते बुलाओआ।<verse eid="PSA 147:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 147:5" />म्हारा यहोवा महान् ओर बऊत सामर्थी ए;</para>
  <para style="q" vid="PSA 147:5">तेसरी बुद्धि अपरम्पार ए।<verse eid="PSA 147:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 147:6" />प्रभु नम्र लोका खे सम्बाल़ोआ</para>
  <para style="q" vid="PSA 147:6">ओर दुष्टा खे जमीना दे सेटी देओआ।<verse eid="PSA 147:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 147:7" />प्रभुए रा तन्यवाद करदे ऊए गीत गाओ;</para>
  <para style="q" vid="PSA 147:7">म्हारे परमेशरो रा बीणा बजांदे ऊए पजन गाओ।<verse eid="PSA 147:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 147:8" />से सर्गो खे बादल़ा साथे टखी देओआ</para>
  <para style="q" vid="PSA 147:8">ओर तरतिया खे बर्खा री त्यारी करोआ</para>
  <para style="q" vid="PSA 147:8">ओर पाह्ड़ा पाँदे काआ जमाओआ।<note caller="+" style="f"><char style="fr" closed="false">147:8 </char><char style="ft" closed="false">प्रेरित 14:17</char></note><verse eid="PSA 147:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 147:9" />से डांगरा खे ओर कावा रेया बच्चेया खे,</para>
  <para style="q" vid="PSA 147:9">जो आका पाओए, खाणे खे देओआ।<note caller="+" style="f"><char style="fr" closed="false">147:9 </char><char style="ft" closed="false">लूक 12:24</char></note><verse eid="PSA 147:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 147:10" />ना तो से कोड़ेया रिया सेना ते खुश ओआ</para>
  <para style="q" vid="PSA 147:10">ओर ना तागतबर सेना ते खुश ओआ।<verse eid="PSA 147:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 147:11" />प्रभु आपणे पग्ता तेई खुश रओआ,</para>
  <para style="q" vid="PSA 147:11">मतलब तिना ते जो तेसरी करूणा री उम्मीद लगाई राखोए।<verse eid="PSA 147:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 147:12" />ओ यरूशलेम, प्रभुए री तारीफ कर!</para>
  <para style="q" vid="PSA 147:12">ओ सिय्योन, आपणे परमेशरो री स्तुति कर!<verse eid="PSA 147:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 147:13" />तेस तेरा शईर बचाई की राखणा,</para>
  <para style="q" vid="PSA 147:13">ओर आपणियां प्रजा खे बच्चे देई की आशीष देओआ।<verse eid="PSA 147:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 147:14" />से तेरे बन्नेया पाँदे शान्ति राखोआ</para>
  <para style="q" vid="PSA 147:14">ओर ताखे खरिया ते खरिया कणका साथे रजाओआ।<verse eid="PSA 147:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 147:15" />से तरतिया पाँदे आपणी आज्ञा रा प्रचार करोआ,</para>
  <para style="q" vid="PSA 147:15">तेसरा वचन बऊत तेज दौड़ोआ।<verse eid="PSA 147:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 147:16" />से ऊना जेड़ी बर्फा री बरखा करोआ</para>
  <para style="q" vid="PSA 147:16">ओर स्वाई जेड़ा पाल़ा बिखेरोआ।<verse eid="PSA 147:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 147:17" />से बर्फा खे छोटेया-छोटेया टुकड़ेया रे सेटोआ,</para>
  <para style="q" vid="PSA 147:17">तेसरी कित्ती री ठण्ड कोई बी सईन नि करी सकोआ।<verse eid="PSA 147:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 147:18" />से आज्ञा देई की बर्फा खे पिगल़ाई देओआ;</para>
  <para style="q" vid="PSA 147:18">से पऊण चलाओआ, तेबे पाणी बईणे लगोआ।<verse eid="PSA 147:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 147:19" />परमेशर याकूबो खे आपणा वचन</para>
  <para style="q" vid="PSA 147:19">ओर इस्राएलो खे आपणी बिदिया ओर नियम बताओआ।<verse eid="PSA 147:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 147:20" />पर तिने आपणे नियम केसी ओर देशा खे नि दित्ते।</para>
  <para style="q" vid="PSA 147:20">यहोवे री स्तुति करो!<note caller="+" style="f"><char style="fr" closed="false">147:20 </char><char style="ft" closed="false">रोमी 3:2</char></note><verse eid="PSA 147:20" /></para>
  <chapter eid="PSA 147" />
  <chapter number="148" style="c" sid="PSA 148" />
  <para style="s">सारी सृष्टि परमेशरो री स्तुति करो</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 148:1" />प्रभुए री स्तुति करो!</para>
  <para style="q" vid="PSA 148:1">प्रभुए री स्तुति स्वर्गो ते करो,</para>
  <para style="q" vid="PSA 148:1">ऊच्चिया जगा रे तेसरी स्तुति करो!<verse eid="PSA 148:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 148:2" />ओ यहोवे रे स्वर्गदूतो, तेसरी स्तुति करो;</para>
  <para style="q" vid="PSA 148:2">ओ प्रभुए री सेनाओं, तेसरी स्तुति करो!<verse eid="PSA 148:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 148:3" />ओ सूरज ओर चाँद, तेसरी स्तुति करो,</para>
  <para style="q" vid="PSA 148:3">ओ सब चमकणे वाल़े तारेयो, तेसरी स्तुति करो!<verse eid="PSA 148:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 148:4" />ओ सबी ते ऊच्चे सर्ग ओर ओ सर्गो ते पाँदले पाणी,</para>
  <para style="q" vid="PSA 148:4">तुसे दोनो तेसरी स्तुति करो!<verse eid="PSA 148:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 148:5" />यो सारे प्रभुए रे नाओं री स्तुति करो;</para>
  <para style="q" vid="PSA 148:5">कऊँकि प्रभुए आज्ञा दित्ती ओर यो बणाए गये।<verse eid="PSA 148:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 148:6" />ओर प्रभुए जुगो-जुगो तक सेयो स्थिर करी राखे;</para>
  <para style="q" vid="PSA 148:6">ओर प्रभुए एड़ी बिधि ठराई राखी, जो कदी टल़ी नि सकदी।<verse eid="PSA 148:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 148:7" />तरतिया पाँदे प्रभुए री स्तुति करो,</para>
  <para style="q" vid="PSA 148:7">ओ अजगर ओर डूगे समुद्र,<verse eid="PSA 148:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 148:8" />ओ आग ओर ओल़े, ओ बर्फ ओर पाल़ा,</para>
  <para style="q" vid="PSA 148:8">ओ प्रभुए रा वचन मानणे वाल़ी प्रचण्ड पऊण!<verse eid="PSA 148:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 148:9" />ओ पाह्ड़ो ओर सारे टिलेयो,</para>
  <para style="q" vid="PSA 148:9">ओ फल देणे वाल़े डाल़ो ओर देवदारो!<verse eid="PSA 148:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 148:10" />ओ बणो रे ओर सब करेलू डांगरो,</para>
  <para style="q" vid="PSA 148:10">ओ लूरने वाल़े जन्तुओ ओर पंछियो!<verse eid="PSA 148:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 148:11" />ओ तरतिया रे राजेओ ओर राज्य-राज्य रे सारे लोको,</para>
  <para style="q" vid="PSA 148:11">ओ परदानो ओर तरतिया रे न्याय करने वाल़ेयो!<verse eid="PSA 148:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 148:12" />ओ जवानो ओर कुआँरियो,</para>
  <para style="q" vid="PSA 148:12">ओ बुजुर्गो ओर बाल़को!<verse eid="PSA 148:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 148:13" />प्रभुए रे नाओं री स्तुति करो, कऊँकि तेसरा ई नाओं महान् ए;</para>
  <para style="q" vid="PSA 148:13">तेसरी महिमा तरती ओर सर्गो पाँदे ए।<verse eid="PSA 148:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 148:14" />प्रभुए आपणे निज लोक तागतबर बणाई राखे; ये तेसरे सबी पग्ता खे,</para>
  <para style="q" vid="PSA 148:14">मतलब इस्राएलो री ल्वादा खे ओर प्रभुए रे नेड़े रणे वाल़ी प्रजा रिया तँईं स्तुति करने रा विषय ए।</para>
  <para style="q" vid="PSA 148:14">प्रभुए री स्तुति करो!<verse eid="PSA 148:14" /></para>
  <chapter eid="PSA 148" />
  <chapter number="149" style="c" sid="PSA 149" />
  <para style="s">इस्राएल परमेशरो री स्तुति करो</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 149:1" />प्रभुए री स्तुति करो! प्रभुए रिया तँईं नवां गीत गाओ,</para>
  <para style="q" vid="PSA 149:1">पग्ता री सभा रे प्रभुए री स्तुति करो!<note caller="+" style="f"><char style="fr" closed="false">149:1 </char><char style="ft" closed="false">प्रकाशित 5:9, प्रकाशित 14:3</char></note><verse eid="PSA 149:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 149:2" />इस्राएली लोक आपू खे बनाणे वाल़ेया रिया बजा ते खुश ओ,</para>
  <para style="q" vid="PSA 149:2">सिय्योनो रे रणे वाल़े आपणे राजे रिया बजा ते प्रभुए रे मगन ओ!<verse eid="PSA 149:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 149:3" />इस्राएली लोको नाचदे ऊए प्रभुए रे नाओं री स्तुति करो</para>
  <para style="q" vid="PSA 149:3">ओर डफली ओर बीणा बजांदे ऊए तेसरा पजन गाओ!<verse eid="PSA 149:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 149:4" />यहोवा आपणियां प्रजा ते खुश रओआ;</para>
  <para style="q" vid="PSA 149:4">तेस नम्र लोका रा उद्धार करी की तिना री शोभा बढ़ाओआ।<verse eid="PSA 149:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 149:5" />पग्त लोक प्रभुए री महिमा रिया बजा ते खुश ओ</para>
  <para style="q" vid="PSA 149:5">ओर सेयो आपणे बछौणे पाँदे लेटे रे बी जयजयकार करो।<verse eid="PSA 149:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 149:6" />तिना रे गल़े ते परमेशरो री तारीफ ओ</para>
  <para style="q" vid="PSA 149:6">ओर तिना रे आथो रे दोधारी तलवार रओ,<verse eid="PSA 149:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 149:7" />ताकि सेयो जातिया-जातिया ते बदला लई सको</para>
  <para style="q" vid="PSA 149:7">ओर राज्य-राज्य रे लोका खे ताड़ना देओ,<verse eid="PSA 149:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 149:8" />सेयो तिना रे राजेया खे साँगल़ो साथे</para>
  <para style="q" vid="PSA 149:8">ओर तिना रे जाणे-माणे रे मर्दा खे लोए रिया बेड़िया साथे जकड़ी की राखो,<verse eid="PSA 149:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 149:9" />ओर तिना खे ठराई री सजा देओ!</para>
  <para style="q" vid="PSA 149:9">प्रभुए रे सबी पग्ता रा एड़ा ई मान-सम्मान ऊणा।</para>
  <para style="q" vid="PSA 149:9">प्रभुए री स्तुति करो।<verse eid="PSA 149:9" /></para>
  <chapter eid="PSA 149" />
  <chapter number="150" style="c" sid="PSA 150" />
  <para style="s">परमेशरो री स्तुति ओ</para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 150:1" />प्रभुए री स्तुति करो! परमेशरो रे पवित्र मन्दरो दे तेसरी स्तुति करो;</para>
  <para style="q" vid="PSA 150:1">तेसरे सामर्था साथे परे रे सर्गो दे तेसरी स्तुति करो!<verse eid="PSA 150:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 150:2" />यहोवे रे महान कामा रिया तँईं तेसरी स्तुति करो;</para>
  <para style="q" vid="PSA 150:2">तेसरी अपार महानता रिया बजा ते तेसरी स्तुति करो!<verse eid="PSA 150:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 150:3" />रड़सिंगा बजांदे ऊए तेसरी स्तुति करो;</para>
  <para style="q" vid="PSA 150:3">सारंगी ओर बीणा बजांदे ऊए तेसरी स्तुति करो!<verse eid="PSA 150:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 150:4" />डफली बजांदे ओर नाचदे ऊए तेसरी स्तुति करो;</para>
  <para style="q" vid="PSA 150:4">बीणा ओर बंसरी बजांदे ऊए तेसरी स्तुति करो!<verse eid="PSA 150:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 150:5" />ऊच्चिया आवाजा वाल़ी खंजरी बजांदे ऊए तेसरी स्तुति करो!</para>
  <para style="q" vid="PSA 150:5">खुशिया साथे ऊच्चिया आवाजा वाल़ी खंजरी बजांदे ऊए तेसरी स्तुति करो!<verse eid="PSA 150:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 150:6" />सारे प्राणी प्रभुए री स्तुति करो!</para>
  <para style="q" vid="PSA 150:6">प्रभुए री स्तुति करो!<verse eid="PSA 150:6" /></para>
  <chapter eid="PSA 150" />
</usx>