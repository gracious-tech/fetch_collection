<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="MAL" style="id" />
  <para style="h">मलाकी</para>
  <para style="toc1">मलाकी नबीए रे जरिये लिखी री कताब</para>
  <para style="toc2">मलाकी</para>
  <para style="toc3">मला.</para>
  <para style="mt">मलाकी</para>
  <para style="mt2">मलाकी नबीए रे जरिये लिखी री कताब</para>
  <para style="is">भूमिका</para>
  <para style="ip">मलाकिये री कताब ई. पू. पांजवी शताब्दिया दे यरूशलेमो रे मन्दरो रे दुबारा बनाणे ते बाद केसी बखतो दे लिखी थी। नबीए री खास मनपसंद पुरोईता ओर आम लोका रा त्यान एते गल्ला रिया तरफा खे करना था कि सेयो परमेशरो साथे कित्ते रे आपणे वादे खे परोसे वाल़े बणो। ये पक्का ए कि परमेशरो री प्रजा रे जीवनो दे ओर आराधना दे चलाकी ओर बुराई आईगी दी थी। पुरोईत ओर आम लोक दोनो ई परमेशरो खे पूरा दान ना देई की, ओर तेसरी शिक्षा रे मुताबिक जीवन ना जी की तेसखे तोखा देणे लगी रे थे। पर परमेशर आपणे लोका रा न्याय करने ओर तिना खे पवित्र करने खे आऊणा, पर इजी ते पईले तेस आपणी बाट त्यार करने ओर आपणी वाचा रा प्रचार करने खे आपणा सन्देश देणे वाल़ा दूत पेजणा।</para>
  <para style="iot">रूप-रेखा</para>
  <para style="io1">इस्राएलो रे पाप <char style="ior"><ref loc="MAL 1:1-2:16">1:1-2:16</ref></char></para>
  <para style="io1">परमेशरो रा न्याय ओर तेसरी दया <char style="ior"><ref loc="MAL 2:17-4:6">2:17-4:6</ref></char></para>
  <chapter number="1" style="c" sid="MAL 1" />
  <para style="p">
    <verse number="1" style="v" sid="MAL 1:1" />ये सन्देश जो यहोवे मलाकिये रे जरीये इस्राएलो रे लोका ते बोलेया था,<verse eid="MAL 1:1" /></para>
  <para style="s">इस्राएलो रे लोका खे यहोवे रा प्रेम</para>
  <para style="p">
    <verse number="2" style="v" sid="MAL 1:2" />परमेशर बोलोआ, “मैं सदा तुसा ते बऊत प्यार कित्तेया ए, पर तुसे पूछोए कि तैं कुणजी गल्ला दे आसा साथे प्यार करी राखेया?” परमेशरो री ये बाणी ए, “क्या एसाव याकूबो रा पाई नि ए? तो बी मैं याकूबो ते प्यार कित्तेया।” <verse eid="MAL 1:2" /><verse number="3" style="v" sid="MAL 1:3" />पर एसावो ते आऊँ नफरत करूँआ, ओर तेसरे पाह्ड़ी देशो खे नाश करी देऊँआ, ओर तेसरी जमीना खे बणो रे गीदड़ा रे वशो दे करी देऊँआ। <verse eid="MAL 1:3" /><verse number="4" style="v" sid="MAL 1:4" />एदोमो दे एसावो रे कुलो रे बोलोए, “आसे तो बर्बाद ऊईगे दे ए, पर आसा खण्डहर फेर बसाणे” पर सेना रा यहोवा ज्वाब देओआ, “सेयो फेर बनाणे री कोशिश करी सकोए, पर मां सेयो फेर टाल़ी देणे। तिना रे देशो खे ‘दुष्टा रा देश’ बोलेया जाणा, ओर तिना रे लोक ‘सेयो लोक जिना पाँदे यहोवा सदा गुस्सा करोआ’ बोलेया जाणा।” <verse eid="MAL 1:4" /><verse number="5" style="v" sid="MAL 1:5" />तुसा रिया आखी ये देखणा ओर तुसा बोलणा, “यहोवा महान ए! से इस्राएलो रे बन्नेया ते बारे बी राज करोआ।”<verse eid="MAL 1:5" /></para>
  <para style="s">यहोवे रा पुरोईता खे थिड़कणा</para>
  <para style="p">
    <verse number="6" style="v" sid="MAL 1:6" />एक पाऊ आपणे बाओ री इज्जत करोआ। एक दास आपणे मालको री इज्जत करोआ। जे आऊँ बाओ ए, तो माखे से इज्जत केई देणी चाईयो? जे आऊँ मालक ए, तो तुसा मेरा डर कितणा मानणा चाईयो? प्रभु, जो सबी पाँदे राज करोआ, बोलोआ, “तुसे पुरोईत माखे बेकार समजोए। पर तुसे पूछोए, आसे तूँ किंयाँ बेकार जाणेया।” <verse eid="MAL 1:6" /><verse number="7" style="v" sid="MAL 1:7" />तुसे मेरी बेदिया पाँदे माखे अशुद्ध रोटी चढ़ाओए, तेबे बी तुसे पूछोए, “आसे कुणजी गल्ला दे ताखे अशुद्ध ठराऊँए?” तुसे ये बताईता दा ए कि तुसे प्रभुए री बेदिया खे तीतणा खास नि मानदे। <verse eid="MAL 1:7" /><verse number="8" style="v" sid="MAL 1:8" />जेबे तुसे माखे अन्दे डांगरो खे बलि करने खे नेड़े ल्याओए, तो क्या ये गल़त नि ए? ओर जेबे तुसे लंगड़े या बमार डांगरो खे ल्याओए, तो क्या ये गल़त नि ए? आपणे राज्यपालो गे एड़ी पेंट ल्याओए, क्या से खुश ऊणा या तेस तुसा पाँदे दया करनी? सेना रे यहोवे री येई बाणी ए।<verse eid="MAL 1:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MAL 1:9" />एबे परमेशरो ते प्रार्थना ते बिनती करो कि आसा पाँदे दया कर! पर जदुए तक तुसा एड़ी पेंट चढ़ांदे रणा, तेस तुसे किंयाँ ग्रहण करने? सेना रे यहोवे रा येई वचन ए। <verse eid="MAL 1:9" /><verse number="10" style="v" sid="MAL 1:10" />अच्छा ऊँदा कि तुसा बीचा ते कोई मन्दरो रे दरवाजेया खे बन्द करी देंदा, ताकि ये बेकार बलिदान नि चढ़ाए जाई सको! सेना रे यहोवे रा ये वचन ए, “आऊँ तुसा ते खुश नि आ, ओर मां तुसा रे बलिदान ग्रहण नि करने।” <verse eid="MAL 1:10" /><verse number="11" style="v" sid="MAL 1:11" />पर दूजी जातिया बीचे मेरा नाओं तड़के ते लई की सांजा तक महिमा वाल़ा ए। सारी तरतिया दे सेयो मेरे नाओं रिया तँईं खुशबू देणे वाल़ा तूप ओर शुद्ध पेंट चढ़ाओए। कऊँकि दूजी जातिया दे मेरा नाओं महान ए, सेना रे यहोवे रा येई वचन ए। <verse eid="MAL 1:11" /><verse number="12" style="v" sid="MAL 1:12" />पर तुसे मेरे नाओं खे एड़ा मानोए जेड़े कि से पवित्र नि आ। तुसे बोलोए कि यहोवे री बेदी अशुद्ध ए। ओर तुसे तीजी पाँदे मिलणे वाल़े खाणे खे तुच्छ जाणोए। <verse eid="MAL 1:12" /><verse number="13" style="v" sid="MAL 1:13" />सेना रा यहोवा बोलोआ, “तुसे बोलोए, यहोवे री सेवा करना बऊत कठण ए, ओर मेरी आज्ञा खे नि मानदे। जरा सोचो! चोरी कित्ते दे, अपंग ओर बमार डांगरा खे बलिया रे रूपो दे चढ़ाया करोए! क्या माखे तुसा ते एड़ी पेंट लणी चाईयो?” यहोवा पूछोआ। <verse eid="MAL 1:13" /><verse number="14" style="v" sid="MAL 1:14" />स्रापित ए एड़ा तोखा देणे वाल़ा माणूं, जो आपणी पेडा बीचा ते एक सबी ते बढ़िया खाडूए खे देणे री प्रतिज्ञा करोआ, पर यहोवे खे एक नकम्मा खाड्डू चढ़ाओआ। कऊँकि सेना रे यहोवे री ये बाणी ए, कि आऊँ महान राजा ए, ओर सबी जातिया रे लोक मेरा आदर करोए।<verse eid="MAL 1:14" /></para>
  <chapter eid="MAL 1" />
  <chapter number="2" style="c" sid="MAL 2" />
  <para style="s">पुरोईता खे चतौणी</para>
  <para style="p">
    <verse number="1" style="v" sid="MAL 2:1" />एबे ओ पुरोईतो, ये चतौणी तुसा खे ए। <verse eid="MAL 2:1" /><verse number="2" style="v" sid="MAL 2:2" />इजी खे सुणो, पूरे मनो रे मेरा आदर करो। सेना रा यहोवा ये बोलोआ, “जे तुसे एड़ा नि करोगे, तो मां तुसा खे स्राप देणा। मां तुसा रे आशीर्वाद स्रापो दे बदली देणे। सच्च ये आ कि ये मैं पईले ई करी ला दा ए, कऊँकि तुसे पूरे मनो ते मेरा आदर नि कित्तेया। <verse eid="MAL 2:2" /><verse number="3" style="v" sid="MAL 2:3" />तुसे जो करी राखेया, तिजी रिया बजा ते मां तुसा रे वंशो खे सजा देणी ओर तुसा रे बलिदाना रे डांगरा रा गोबर तुसा रे थोबड़े पाँदे मल़ी देणा। ओर तुसे तिजी साथे कूड़े रे टेरो दे सेटी देणे। <verse eid="MAL 2:3" /><verse number="4" style="v" sid="MAL 2:4" />तेबे तुसा खे पता लगी जाणा कि मैं तुसा खे ये आज्ञा इजी खे दित्ती थी, ताकि लेविया ओर तिना रे वंशो साथे मेरी बानी री वाचा बणी दी रओ, सेना रे यहोवे रा येई वचन ए।” <verse eid="MAL 2:4" /><verse number="5" style="v" sid="MAL 2:5" />तुसा रे बुजुर्ग लेविया साथे मेरा वादा इजी री खातर था कऊँकि आऊँ चाऊँ था कि पुरोईत सुख शान्तिया साथे रओ। ओर मैं तिना खे ए ई कित्तेया ए। आऊँ चाऊँ था कि सेयो मेरा आदर करो बल्कि बऊत आदर करो। <verse eid="MAL 2:5" /><verse number="6" style="v" sid="MAL 2:6" />तिने लोका खे सच्चा बिधान सिखाया, ओर तेसरे मुंए ते बुरी गल्ल नि निकल़ो थी। से मां साथे ऊई की चलो था ओर खुशिया साथे ओर शान्तिया ते रओ था। <verse eid="MAL 2:6" /><verse number="7" style="v" sid="MAL 2:7" />कऊँकि पुरोईतो खे चाईयो कि से आपणे ओठे की ज्ञानो री रक्षा करो, कऊँकि से सेना रे यहोवे रा दूत ए जो सबी पाँदे राज करोआ। ओर लोक तेसरे मुंए ते ज्ञानो री गल्ल सुणोए। ओर लोक तेसरे मुंए ते शिक्षा खे लओए। <verse eid="MAL 2:7" /><verse number="8" style="v" sid="MAL 2:8" />पर तुसे लोक आपणियां बाटा ते अटी गे दे ए, तुसे आपणियां शिक्षा रे जरिये कईया खे ठोकर खुल़ाई राखी ए। तुसे लेविया री वाचा तोड़ी ती री, सेना रे यहोवे री येई बाणी ए। <verse eid="MAL 2:8" /><verse number="9" style="v" sid="MAL 2:9" />इजी री खातर मैं बी तुसे सबी लोका सामणे तुच्छ ओर निठे करीते, कऊँकि तुसे मेरी बाटा रे नि चलदे, बल्कि बिधान देणे रे मूँ देखी की बिचार करोए।<verse eid="MAL 2:9" /></para>
  <para style="s">परमेशरो रे खलाफ लोका रा जाणा</para>
  <para style="p">
    <verse number="10" style="v" sid="MAL 2:10" />तुसे जाणोए कि आसा रा एक ई परमेशर ए। परमेशरे ई आसे सब बणाई राखे। पर एबे आसे एकी दूजे रे खलाफ ऊईगे दे ए। आसे तेस वादे खे तोड़ी देऊँए जो परमेशरे आसा रे बुजुर्गा ते कित्तेया था। <verse eid="MAL 2:10" /><verse number="11" style="v" sid="MAL 2:11" />यहूदा रे लोके जो वादा परमेशरो ते कित्तेया था से तोड़ी ता दा ए। ओर यरूशलेम ओर सारे इस्राएल देशो दे घृणित काम करी राखे। तिने से मन्दर अपवित्र करिता दा ए जेतेते यहोवा प्यार करो था। मर्दे तिना जवाणसा साथे ब्या करी राखेया जो पराये देवतेया री पूजा करो थिया। <verse eid="MAL 2:11" /><verse number="12" style="v" sid="MAL 2:12" />यहोवे एड़े काम करने वाल़ेया हर एकी माणूंए ते, चाए से कोई बी ओ, लग करने। ताकि सेयो याकूबो रे वंशो ते सदा खे लग ऊई जाओ। तेसरे कअरो रे रक्षक ओर सेना रे परमेशरो री पेंट चढ़ाणे वाल़ेया खे, यहूदा ते बाडी देणे। <verse eid="MAL 2:12" /><verse number="13" style="v" sid="MAL 2:13" />तेबे तुसे ये दूजा काम कित्तेया कि तुसे परमेशरो री बेदी रोणे वाल़े ओर आखी परने वाल़े आसूआ साथे सीन्नी करी ती, एथो तक कि से तुसा री पेंटा रिया तरफा खे देखदा तक नि ओर ना खुश ऊई की तुसा रे आथो ते लओआ। तुसे पूछोए एड़ा कऊँ? <verse eid="MAL 2:13" /><verse number="14" style="v" sid="MAL 2:14" />इजी री खातर, कऊँकि परमेशर तेरे ओर तेरी तेसा जवानिया री साथी मतलब ब्यायी री जवाणसा बीचे गवाह् ऊआ था, जेसरा तैं विश्वासघात करी राखेया। <verse eid="MAL 2:14" /><verse number="15" style="v" sid="MAL 2:15" />पक्का यहोवे ई तुसे कट्ठे जोड़ी राखे। तुसा री आत्मा ओर तुसा रा शरीर तेसरे ई ए। इजी री खातर से तुसा ते परमेशरो ते प्यार करने वाल़ी ल्वाद चाओआ। इजी री खातर तुसे सब आपणी-आपणी लाड़िया साथे वफादार बणे दे रओ। जेसा साथे तुसे जवानिया दे ब्या कित्तेया था। <verse eid="MAL 2:15" /><verse number="16" style="v" sid="MAL 2:16" />इस्राएलो रा परमेशर यहोवा ईंयाँ बोलोआ, “जो मर्द आपणी लाड़िया ते प्यार नि करदा, बल्कि तेसा खे छाडी देओआ, से आपणे टाल्ले उपद्रवो ते टखोआ।” सेना रे यहोवे री ये बाणी ए। इजी री खातर तुसे आपणी आत्मा दे बची की रओ, ओर विश्वासघात करने वाल़े नि बणो। <verse eid="MAL 2:16" /><verse number="17" style="v" sid="MAL 2:17" />तुसे लोके आपणी गल्ला साथे यहोवा थकेरी राखेया ए। तेबे बी तुसे पूछोए, “आसे कुणजी गल्ला ते से थकेरी राखेया? ये बोली की कि जो लोक बुराई करोए, सेयो यहोवे री नजरा दे खरे ए, ओर से तिना ते खुश ओआ। या ये पूछी की कि न्याय रा परमेशर केयी ए?”<verse eid="MAL 2:17" /></para>
  <chapter eid="MAL 2" />
  <chapter number="3" style="c" sid="MAL 3" />
  <para style="s">सन्देश देणे वाल़ा आऊणा</para>
  <para style="p">
    <verse number="1" style="v" sid="MAL 3:1" />देखो, आऊँ आपणे दूतो खे पेजुँआ ओर तेस मांते आगे बाट सुदारनी, तेबे यहोवा जेसखे तुसे टोल़ोए, से अचाणक आपणे मन्दरो दे आई जाणा, वाचा रा से दूत, जेसरी बाट तुसे देखणे लगी, से पक्का आऊणा, सेना रे यहोवे री येई बाणी ए। <verse eid="MAL 3:1" /><verse number="2" style="v" sid="MAL 3:2" />पर तेसरे न्याय रा दिन कुण सयी सकोआ? ओर जेबे से दिशो, तेबे कुण खड़ा रयी सकोआ? कऊँकि से सन्यारो री आग ओर तोबिये रे साबणो जेड़ा मैल दूर करोआ। <verse eid="MAL 3:2" /><verse number="3" style="v" sid="MAL 3:3" />से तेस सन्यारो जेड़ा ऊणा जो चाँदिए खे तदुए तक आगी दे जल़ाओआ जदुए तक तेते रा सारा मैल फुकी नि जाओ ओर से शुद्ध नि ऊई जाओ। ओर तेस लेविया रे वंशो री बुराई दूर करनी, तेस सेयो तदुए तक शुद्ध करने जदुए तक सेयो शुद्ध सूईने ओर चाँदिए जेड़े नि ऊई जाओ। ओर तेबे तिना यहोवे खे एड़े बलिदान चढ़ाणे जिना रे बारे दे सेयो जाणोए की से सई ए। <verse eid="MAL 3:3" /><verse number="4" style="v" sid="MAL 3:4" />तेबे यहूदा प्रदेश ओर यरूशलेम शईरो रे लोक जो पेंट यहोवे खे ल्याऊणे, तिजी ते से खुश ऊणा। <verse eid="MAL 3:4" /><verse number="5" style="v" sid="MAL 3:5" />यहोवा बोलोआ, “तेबे मां न्याय करने खे तुसा रे नेड़े आऊणा, ओर जादू, व्याभिचार ओर चूठी गवाई देणे वाल़ेया रे खलाफ, जो मजदूरा खे तिना री मजदूरी नि देंदे, बिदुआ ओर अनाथा पाँदे अन्देर करने वाल़े, परदेशिया रा न्याय बिगाड़ने वाल़े ओर मेरा डर नि मानदे, तिना सबी रे खलाफ मां तेबु गवाई देणी, सेना रे परमेशरो रा येई वचन ए।”<verse eid="MAL 3:5" /></para>
  <para style="s">दसुए इस्से री चोरी</para>
  <para style="p">
    <verse number="6" style="v" sid="MAL 3:6" />कऊँकि आऊँ परमेशर बदलदा नि, इजी बजा ते, ओ याकूबो री ल्वाद, तुसे नाश नि ऊए। <verse eid="MAL 3:6" /><verse number="7" style="v" sid="MAL 3:7" />आपणे बुजुर्गा रे दिना ते तुसे मेरी बिधिया ते आटदे आई रे ओर तिना रा पालण नि करदे। तुसे मेरी तरफा खे फिरो, तेबे मां बी तुसा रिया तरफा खे फिरना, सेना रे यहोवे रा येई वचन ए, पर तुसे पूछोए कि आसे कुणजी गल्ला ते फिरूँ? <verse eid="MAL 3:7" /><verse number="8" style="v" sid="MAL 3:8" />आऊँ तुसा ते बोलूँआ, “माणूं परमेशरो खे तोखा नि देयो।” पर तुसे पूछोए, “आसे तूँ किंयाँ लूटेया?” आऊँ बोलूँआ, “तुसे माखे से दसुआ इस्सा ओर चढ़त नि देंदे जो तुसा खे देणा चाईयो था।” <verse eid="MAL 3:8" /><verse number="9" style="v" sid="MAL 3:9" />तुसे जो बी करोए तिजी सबी दे स्राप पड़ीगा दा ए, कऊँकि तेस देशो दे तुसे लोक माखे तोखा देणे लगी रे। <verse eid="MAL 3:9" /><verse number="10" style="v" sid="MAL 3:10" />सारे दशमांश मेरे मन्दरो रे पण्डारो दे लई आओ। तेबे तेती बऊत खाणे-पीणे रिया चीजा ऊणिया। ईंयाँ तुसे माखे परखो, सेना रा यहोवा ईंयाँ बोलोआ, “तेबे तुसा देखणा कि मां स्वर्गो रे द्वार खोली देणे। मां इतणिया आशीषा बरसाणिया कि तुसा गे राखणे खे जगा नि ऊणी।” <verse eid="MAL 3:10" /><verse number="11" style="v" sid="MAL 3:11" />मां तुसा रा नाश करने वाल़े एड़े थिड़कणे कि तिना तुसा री जमीना री फसल बर्बाद नि करनी ओर तुसा री अंगूरा री बेला रे फल काच्चे नि छूटणे, सेना रे परमेशरो रा येई वचन ए। <verse eid="MAL 3:11" /><verse number="12" style="v" sid="MAL 3:12" />तेबे सारी जातिया तुसा खे तन्य बोलणा, कऊँकि तुसा रा देशो बऊत सुन्दर ऊणा, सेना रे परमेशरो रा येई वचन ए। <verse eid="MAL 3:12" /><verse number="13" style="v" sid="MAL 3:13" />परमेशर बोलोआ, “तुसे मेरे खलाफ टीठ गल्ला करी राखिया, पर तुसे पूछोए कि आसे तेरे खलाफ क्या करी राखेया? <verse eid="MAL 3:13" /><verse number="14" style="v" sid="MAL 3:14" />तुसे बोली राखेया कि परमेशरो री सेवा करना बेकार ए। आसे जो तेसरे बताए रे काम पूरे करी राखे ओर सेना रे परमेशरो रे डरो रे मारे शोगो रा पईरावा पईनी की चली रे, इजी ते क्या फायदा ऊआ? <verse eid="MAL 3:14" /><verse number="15" style="v" sid="MAL 3:15" />पर यहोवा तो कमण्डी लोका खे ई आशीर्वाद देओआ! आ, बुरे काम करने वाल़े ई तो अमीर बणोए! परमेशर तो तिना खे सजा पनि देंदा जो तिना री परीक्षा लणा पसन्द करोए। आसे तो येई सोचूँए।”<verse eid="MAL 3:15" /></para>
  <para style="s">यादगारिया री कताब</para>
  <para style="p">
    <verse number="16" style="v" sid="MAL 3:16" />तेबे परमेशरो रा डर मानणे वाल़ेया आपू बीचे गल्ला कित्तिया ओर परमेशर त्यान देई की तिना री सुणो था ओर जो परमेशरो रा डर मानो था ओर तेसरे नाओं रा आदर करो थे, तिना री यादा रिया तँईं तेस सामणे एक कताब लिखी जाओ थी। <verse eid="MAL 3:16" /><verse number="17" style="v" sid="MAL 3:17" />सेना रा यहोवा ईंयाँ बोलोआ, “जेस दिने मां न्याय करना, से मेरिया तँईं खास तअन ऊणा। मां सेयो तेड़े ई छाडी देणे जेड़े एक बाओ आपणे आज्ञा ना मानणे वाल़े माठे खे छाडी देओआ। <verse eid="MAL 3:17" /><verse number="18" style="v" sid="MAL 3:18" />तेबे तुसा फेर तर्मी ओर दुष्टा बीचे, मतलब जो परमेशरो री सेवा करोआ ओर जो तेसरी सेवा नि करदा, तिना दुँईं बीचे पेत जाणी लणा।”<verse eid="MAL 3:18" /></para>
  <chapter eid="MAL 3" />
  <chapter number="4" style="c" sid="MAL 4" />
  <para style="s">न्याय रा दिन</para>
  <para style="p">
    <verse number="1" style="v" sid="MAL 4:1" />सर्वशक्तिमान परमेशर बोलोआ, “तुसे बेफिकर रओ, यहोवे रे न्याय रा दिन आऊणे लगी रा। मेरा गुस्सा भट्टे दे धधकदिया आगी जेड़ा धधकणा। सारे कमण्डी लोक सूके काओ जेड़े ऊई जाणे। ओर सेयो सब जो बुरे काम करोए, सेयो बी। आऊणे वाल़े दिनो दे सेयो आगी दे एड़े फूखी जाऊणे कि तिना रा नाओं-नशाण नि रणा, सेना रे यहोवे रा येई वचन ए। <verse eid="MAL 4:1" /><verse number="2" style="v" sid="MAL 4:2" />पर तुसा रिया तँईं जो मेरे नाओं रा डर मानोए, तर्मो रा सूरज निकल़ना ओर तेसरी किरणा ते तुसे ठीक ऊई जाणे ओर तुसे बारे जाणे ओर अच्छे ते पाल़े रे बाच्छूए जेड़े जो गवाईणी ते बारे निकल़ोआ उछल़-कूद करदे रणे। <verse eid="MAL 4:2" /><verse number="3" style="v" sid="MAL 4:3" />तेबे तेस दिने, जेबे मां दुष्टा रा न्याय करना, तेबे तुसा मौज-मस्ती करनी, मेरे तेस ठराए रे दिने सेयो तुसा रे पैरा निठली स्वा बणी जाणे, सेना रे यहोवे रा येई वचन ए। <verse eid="MAL 4:3" /><verse number="4" style="v" sid="MAL 4:4" />जो बिधान मैं मूसे खे दित्तेया था, जो मेरा सेवक था, तिना खे मानदे रणा। जो आज्ञा ओर बिधिया मैं तेसखे होरेबो रे पाह्ड़ो पाँदे दित्तिया थिया, तिना खे मानदे रणा, जिना खे मानणे रा काम तुसा सबी इस्राएलिया खे करना चाईयो। <verse eid="MAL 4:4" /><verse number="5" style="v" sid="MAL 4:5" />देखो, परमेशरो रे तेस बड़े ओर डराऊणे दिनो रे आऊणे ते पईले मां तुसा गे एलिय्याह नबी पेजणा। <verse eid="MAL 4:5" /><verse number="6" style="v" sid="MAL 4:6" />एलिय्याहो माया-बाओ ओर तिना रे बच्चेया बीचे शान्ति ल्याऊणी। तेस बच्चेया ओर तिना रे माया-बाओ बीचे बी शान्ति ल्याऊणी। जे एड़ा नि ऊआ, तो मां आऊणा। ओर मां ये देश पूरी तरआ ते नाश करी देणा।”<verse eid="MAL 4:6" /></para>
  <chapter eid="MAL 4" />
</usx>