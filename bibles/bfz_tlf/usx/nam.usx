<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="NAM" style="id" />
  <para style="h">नहूम</para>
  <para style="toc1">नहूम नबीए रे जरिये लिखी री कताब</para>
  <para style="toc2">नहूम</para>
  <para style="toc3">नहू.</para>
  <para style="mt">नहूम</para>
  <para style="mt2">नबीए रे जरिये लिखी री कताब</para>
  <para style="is">भूमिका</para>
  <para style="ip">नहूम री कताब एक एड़ी कविता ए जिदे इस्राएलो रे पुराणे ओर अत्याचार करने वाल़े दुश्मण अश्शूरो री राजधानी नीनवे रे नाशो पाँदे खुशी मनाई राखी ए। ई. पू. 700 साला रे लगभग अन्तो दे नीनवे रे नाशो खे एक टीठ ओर गुस्से वाल़ी जातिया पाँदे परमेशरो री सजा आऊणे रे रूपो दे देखेया गया ए।</para>
  <para style="iot">रूप-रेखा</para>
  <para style="io1">नीनवे शईरो रा न्याय <char style="ior"><ref loc="NAM 1:1-15">1:1-15</ref></char></para>
  <para style="io1">नीनवे शईरो रा नाश <char style="ior"><ref loc="NAM 2:1-3:19">2:1-3:19</ref></char></para>
  <chapter number="1" style="c" sid="NAM 1" />
  <para style="p">
    <verse number="1" style="v" sid="NAM 1:1" />आऊँ नहूम जो एल्कोशी गाँवो रा रणे वाल़ा ए, ये सन्देस नीनवे शईरो रे बारे दे माखे परमेशरे एक दर्शणो री कताबा रे जरीये दित्तेया।<verse eid="NAM 1:1" /></para>
  <para style="s">नीनवे शईरो खे परमेशरो रा रोष</para>
  <para style="p">
    <verse number="2" style="v" sid="NAM 1:2" />परमेशर जल़न करने वाल़ा ओर बदला लणे वाल़ा ईश्वर ए, परमेशर बदला लणे वाल़ा ओर रोष करने वाल़ा ए, परमेशर आपणे बिरोदिया ते बदला लओआ ओर आपणे दुश्मणा रे पाप नि पूलदा। <verse eid="NAM 1:2" /><verse number="3" style="v" sid="NAM 1:3" />परमेशर देरिया ते रोष करने वाल़ा ओर बऊत शक्तिशाली ए, तेस दोषी किंयाँ बी निर्दोष नि ठराणे। परमेशर पऊण-चूखाना ओर तूफानो बीचे आपणी तागत बताओआ। बादल़ तेसरे पैरा थालली तूड़ ए। <verse eid="NAM 1:3" /><verse number="4" style="v" sid="NAM 1:4" />जेबे से समुद्र ओर नदिया खे आज्ञा देयोआ कि सूकी जाओ, तो सेयो सकूँ जाओए। से बाशान जगा रे डोरूआ दे ओर कर्मेल पाह्ड़ो री उतराईया पाँदले काओ खे सुकाई देओआ, ओर लबानोनो रे फुला खे मुरझाई देओआ। <verse eid="NAM 1:4" /><verse number="5" style="v" sid="NAM 1:5" />तेसरे छूँणे ते पाह्ड़ा खे थूरनी छूटी जाओई ओर पाह्ड़िया गल़ी जाओईया; तेसरे प्रतापो ते तरती, बल्कि सारी दुनिया आपणे सबी रणे वाल़ेया समेत डरो रे मारे काँबी जाओई।<verse eid="NAM 1:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="NAM 1:6" />तेसरे रोषो रा सामणा कुण करी सकोआ? जेबे तेसखे रोष आओआ, तेबे कुण ठईरी सकोआ? तेसरा रोष आगी जेड़ा पड़की जाओआ ओर पाह्ड़ तेसरे सामणे तूड़ा दे मिली जाओए। <verse eid="NAM 1:6" /><verse number="7" style="v" sid="NAM 1:7" />परमेशर खरा ए, मुसीबता रे बखते से म्हारी रक्षा करोआ ओर जो तेसरी शरणा दे आओए, तिना रा ख्याल राखोआ। <verse eid="NAM 1:7" /><verse number="8" style="v" sid="NAM 1:8" />पर तेस उमड़दे ऊई खाड्डा रे पाणिये ते बिरोदिया रा पूरी तरआ ते नाश करी देणा, ओर आपणे दुश्मण न्हेरे दे खदेड़ी देणे। <verse eid="NAM 1:8" /><verse number="9" style="v" sid="NAM 1:9" />तुसे परमेशरो रे खलाफ क्या योजना करने लगी रे? तेस तुसा रा अन्त करी देणा, मुसीबत दूजी बार नि पड़नी। <verse eid="NAM 1:9" /><verse number="10" style="v" sid="NAM 1:10" />कऊँकि चाए सेयो कांडेया साथे फसे दे ओ ओर शराबो रे नशे दे बी डूबे दे ओ, तेबे बी सेयो सूके रे डण्डे जेड़े आगी दे फूकी की पस्म ऊई जाणे। <verse eid="NAM 1:10" /><verse number="11" style="v" sid="NAM 1:11" />नीनवे शईरो ते एक एड़ा आदमी निकल़ी रा जो लोका खे यहोवे रे खलाफ बऊत बुरे काम करने री सला देओआ।<verse eid="NAM 1:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="NAM 1:12" />परमेशर ईंयाँ बोलोआ, “चाए सेयो गिणतिया दे अणगिणत ओर तागती दे बऊत जादा बलवान कऊँ नि ओ, मां सेयो नाश करी देणे ओर सेयो तरतिया पाँदा ते राची जाणे। ओर मेरे आपणे लोको, मैं तुसे बमारिया ते दु:खी करी राखे, पर एबे मां तुसे दु:खी नि करने। <verse eid="NAM 1:12" /><verse number="13" style="v" sid="NAM 1:13" />कऊँकि एबे मां तेसरे पारो रा जूँगड़ा तेरी क्याड़िया ते उतारी की तोड़ी देणा, मां सेयो रस्सिया तोड़ी देणियां जो ताखे पकड़ोईया।”<verse eid="NAM 1:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="NAM 1:14" />नीनवे, परमेशरे तेरे बारे दे एक ये आज्ञा देई राखी ए। तिने बोली राखेया ए, “तुसा रा नाओं आगे बढ़ाणे खे कोई ल्वाद नि ऊणी। मां तुसा रे देवतेया रे मन्दरो री लकड़ी ओर कअड़ी रिया मूर्तिया नाश करी देणियां। मां तुसा खे तुसा री कब्रा त्यार करनिया। कऊँकि तूँ दुष्ट ए।” <verse eid="NAM 1:14" /><verse number="15" style="v" sid="NAM 1:15" />देखो! एक दूत पाह्ड़ो पाँदा ते खुशखबरी लई की आऊणे लगी रा! से शान्तिया रा सन्देश लई की आऊणे लगी रा। शुभ समाचार खे सुनाणे वाल़ा ओर शान्तिया रा प्रचार करने वाल़ा आऊणे लगी रा! ओ यहूदा रे लोको, आपणे त्योआर मनाओ ओर आपणी सारिया मान्नता पुरिया करो, कऊँकि तुसारे दुष्ट दुश्मणा फेर कदी बी तुसा पाँदे अमला नि करना। सेयो पूरी तरआ ते नाश ऊई जाणे।<verse eid="NAM 1:15" /></para>
  <chapter eid="NAM 1" />
  <chapter number="2" style="c" sid="NAM 2" />
  <para style="s">नीनवे रा नाश</para>
  <para style="p">
    <verse number="1" style="v" sid="NAM 2:1" />ओ नीनवे शईर, सेना तां पाँदे अमला करने खे आऊणे लगी रिया ए। आपणे किलेया री रक्षा करो! सड़का रिया तरफा खे नजर राखो! त्यार ऊई जाओ! आपणी पूरी तागत बढ़ाओ। <verse eid="NAM 2:1" /><verse number="2" style="v" sid="NAM 2:2" />परमेशर याकूबो री बढ़ोतरी इस्राएलो री बढ़ोतरिया जेड़ी जिंयाँ की तिंयाँ करने लगी रा, कऊँकि उजाड़नेवाल़े सेयो उजाड़ी ते रे ओर अंगूरा रिया डाल़िया नाश करी ती रिया। <verse eid="NAM 2:2" /><verse number="3" style="v" sid="NAM 2:3" />तेसरे शूरवीरा रिया ढाला लाल रंगो साथे रंगी राखिया, ओर तेसरे योद्धा लाल रंगो रे टाल्ले पईने दे ए। त्यारिया रे दिने रथा रे लोए आगी जेड़े चमकोए, ओर सिपाई आपणे भाल़े अवा दे इलाओए। <verse eid="NAM 2:3" /><verse number="4" style="v" sid="NAM 2:4" />रथ सड़का दे बऊत तेज दौड़ोए ओर चौको दे ओरे-पोरे चलाए जाओए, तिना रे रथ बऊत तेज दौड़ोए, जेड़े सर्गो दे बिजल़ी चमकोई। <verse eid="NAM 2:4" /><verse number="5" style="v" sid="NAM 2:5" />इजी बीचे, तुसा रे राजे आपणे अधिकारी बुलाणे जो छोड़ आऊणे रिया बजा ते लड़खड़ाई जाणे। तिना आपणे आपू खे बचाणे रिया तँईं आपणियां ढाला खे पकड़ी की शईरो री दवाला रिया तरफा खे नठणे। <verse eid="NAM 2:5" /><verse number="6" style="v" sid="NAM 2:6" />नदिया रे द्वार खोले जाओए ओर राजे रे मईलो खे तोड़ने लगी रे। <verse eid="NAM 2:6" /><verse number="7" style="v" sid="NAM 2:7" />नीनवे खे कैद करने री आज्ञा देई राखी ए, ओर सब दासिया तेसरे कब्जे पाँदे शोग करने लगी रिया ए। सेयो कबूतरा जेड़े रोणे लगी रिया ए ओर दु:खो रिया बजा ते आपणी छाती पीटणे लगी रिया ए। <verse eid="NAM 2:7" /><verse number="8" style="v" sid="NAM 2:8" />नीनवे एड़े तलाबो जेड़ा ऊईगा दा ए जेतेरा पाणी बह्ई की बारे निकल़ने लगी रा ओ। सेयो लोक आका पाई की बोलणे लगी रे, “रूको! रूको! ठईरी जाओ, केथी नठी नि जाणा।” पर कोई ना तो रूको आ ओर ना ई कोई तिना पाँदे त्यान देओआ। <verse eid="NAM 2:8" /><verse number="9" style="v" sid="NAM 2:9" />ओ सिपाईयो, तुसे जो नीनवे रा नाश करने लगी रे! तुसे चाँदी लई लो ओर ये सूईना बी लई लो! एती लणे खे बऊत सारिया चीजा ए। एती बऊत सारे खजाने बी ए! <verse eid="NAM 2:9" /><verse number="10" style="v" sid="NAM 2:10" />एबे नीनवे खाली ए, सब कुछ लूटी ला दा ए। शईर बर्बाद ऊईगा दा ए! लोके ईम्मत खोई ती दी ए। सेयो बऊत डरीगे दे ए, जेतेरिया बजा ते तिना रे जानू आपू बीचे टकराणे लगी रे। तिना रा शरीर कांबणे लगी रा, ओर डरो रे मारे मूँ पिऊँल़ा पड़ीगा दा ए। <verse eid="NAM 2:10" /><verse number="11" style="v" sid="NAM 2:11" />शेरा री से गुफा ओर जवान शेरो रे शिकारो री से जगा केयी रयी, जेती शेर ओर शेरनी आपणे बच्चेया समेत नशंग कूमोए। <verse eid="NAM 2:11" /><verse number="12" style="v" sid="NAM 2:12" />शेर आपणी तागती साथे बऊत शिकार फाड़ो था ओर आपणी शेरनिया खे शिकारो रा गल़ा कोटी-कोटी की लई जाओ था ओर आपणी गुफा खे शिकारो साथे परी देयो था। <verse eid="NAM 2:12" /><verse number="13" style="v" sid="NAM 2:13" />सर्वशक्तिमान यहोवा बोलोआ, “आऊँ तुसा रे खलाफ ए। मां तुसा रे रथ फूकी देणे ओर तलवारी की तुसा रे जवान शेर काई देणे। मां सेयो सब जानवर लई जाणे जिना पाँदे तुसे अमला करोए। केसी बी तुसा रे दूता री आवाज नि सुणनी।”<verse eid="NAM 2:13" /></para>
  <chapter eid="NAM 2" />
  <chapter number="3" style="c" sid="NAM 3" />
  <para style="s">नीनवे रा स्राप</para>
  <para style="p">
    <verse number="1" style="v" sid="NAM 3:1" />ओ नीनवे शईर तां पाँदे लाणत ए, तूँ पक्का ई नाश ऊई जाणा! तांदे लोक अत्या करने वाल़े ओर खून बाह्णे वाल़े बऊत जादा ए। तेरे लोक चूठ बोलणे ओर लूटणे वाल़े ए। तेरे लोक हर बखत दूजेया साथे लड़ाई चगड़ा करदे रओए। <verse eid="NAM 3:1" /><verse number="2" style="v" sid="NAM 3:2" />कोड़ेया री, रथा, टईरा ओर कोड़ेया रे पैरा री तेज आवाज सुणो। रथ नीनवे रिया तरफा खे बढ़ने लगी रे। <verse eid="NAM 3:2" /><verse number="3" style="v" sid="NAM 3:3" />कोड़ेया पाँदे सवार लोका रे आथो दे चमकणे वाल़िया तलवारा ओर भाल़े देखे जाई सकोए। सड़का दे लाशा पड़ी रिया ए। हर जगा लाशा रे टेर लगी रे। इतणिया लाशा ए कि लोक तिना पाँदे रुड़ने लगी रे। <verse eid="NAM 3:3" /><verse number="4" style="v" sid="NAM 3:4" />ये सब कुछ नीनवे रिया बजा ते ऊईरा। नीनवे तेसा सुन्दर वेश्या जवाणसा जेड़ा ए जो कदी बी रजदी नि ए, तेसा खे ओर जादा, ओर जादा चाईयो था। तिने आपणे आपू खे बऊत सारे देशा खे बेचीता दा था, ओर तिने सेयो कुल आपणे दास बनाणे खे तिना पाँदे तंत्र-मंत्र करी राखेया था।<verse eid="NAM 3:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="NAM 3:5" />सेना रे यहोवे री ये बाणी ए, “आऊँ तेरे खलाफ ए, मां तेरे टाल्ले मुंए तक ऊबे चकणे। तेरा नांगा शरीर मां सारेया देशा खे दखाणा। तिना सबी देशा तेरी बेशर्मी देखणी। <verse eid="NAM 3:5" /><verse number="6" style="v" sid="NAM 3:6" />मां तां पाँदे घिनौनिया चीजा सेटी देणियां। मां तां साथे कृणा रा बर्ताओ करना। लोका तूँ देखणी ओर तां पाँदे आसणे। <verse eid="NAM 3:6" /><verse number="7" style="v" sid="NAM 3:7" />जितणेया तूँ देखणी, सबी तांगा गे ते नठी की बोलणा कि नीनवे नाश ऊई गी, तेरिया तँईं केस रोणा? मां केथा ते ताखे ईम्मत देणे वाल़े खे ल्याऊँ?” <verse eid="NAM 3:7" /><verse number="8" style="v" sid="NAM 3:8" />क्या तूँ तेबेस शईरो ते बढ़ी की ए, जो नील नदिया बीचे बसी री थी ओर तेसा रे चऊँ कनारे पाणी था ओर समुद्र तेसा खे किले रा ओर दवाला रा काम करो था। <verse eid="NAM 3:8" /><verse number="9" style="v" sid="NAM 3:9" />कूश ओर मिस्री तेसा खे बऊत जादा तागत देयो थे, पूत ओर लूबी तेसा रे मतदगार थे। <verse eid="NAM 3:9" /><verse number="10" style="v" sid="NAM 3:10" />तेबे बी तेसा खे बन्दी बनाई की गुलामिया दे लईगे, तेसा रे छोटे-छोटे बच्चे सड़का रे कनारे पाँदे टुकड़े-टुकड़े करीते; तेसा रे प्रतिष्ठित लोका खे तिने चिट्ठी पाईया ओर तेसा रे सारे बड़े लोक साँगल़ा दे बानी ते दे ए। <verse eid="NAM 3:10" /><verse number="11" style="v" sid="NAM 3:11" />तुसे नीनवे रे लोका जेड़े ई मतवाल़े ऊई जाणे, ओर आपणे दुश्मणा ते बचणे रिया तँईं शरण लणे खे जगा टोल़ने लगणे।<verse eid="NAM 3:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="NAM 3:12" />तुसा री सारिया मजबूत जगा दाऊगल़े रे डाल़ा जेड़िया ए। जेबे दुश्मणा सेयो ईलाणे तो तिना रे पईले फल बड़ी सानिया ते थाले पड़ी जाणे। ओर तुसा रिया किमती चीजा दाऊगल़ेया जेड़िया ऊणिया जो लोका रे मुंए दे पड़ी जाणिया। <verse eid="NAM 3:12" /><verse number="13" style="v" sid="NAM 3:13" />देख, तेरे शईरो रे पीतरे तेरे सिपाईए लड़ने री तागत खोई ती दी ए। तेरे देशो रे जाणे रिया बाटा तेरे दुश्मणा खे बिल्कुल खुलिया पड़ी रिया, तेरे द्वारा दे लगी रे लकड़िया रे डण्डे आग लगाई की नाश करीते दे ए। <verse eid="NAM 3:13" /><verse number="14" style="v" sid="NAM 3:14" />तेरे दुश्मणा रे केरने ते पईले ई तूँ आपणे शईरो दे पीतरे पाणी कट्ठा करी लो, ओर आपणे किले जादा मजबूत करी लो। गड्डेया दे जाई की माट्टी केसो ओर तिजी खे सांचेया दे पाओ, दवाला री मरम्मत करने खे ईटा बणाओ। <verse eid="NAM 3:14" /><verse number="15" style="v" sid="NAM 3:15" />तेती तूँ आगी दे फूकी की पस्म ऊई जाणी ओर तूँ तलवारी साथे नाश ऊई जाणी। तेसा तूँ येलेक नाओं री टिड्डिया जेड़ी निगल़ी लणी, चाए तूँ अर्बे नाओं री टिड्डिया जेड़ी अणगिणत बी ऊई जाए! <verse eid="NAM 3:15" /><verse number="16" style="v" sid="NAM 3:16" />तेरे बपारी सर्गो रे अणगिणत तारेया ते बी जादा ऊए, सेयो तिना टिड्डिया जेड़े बऊत ऊईगे जो सब कुछ चट करी की उडी जाओईया। <verse eid="NAM 3:16" /><verse number="17" style="v" sid="NAM 3:17" />तेरे अधिकारी लोक टिड्डिया जेड़े ओर तेरे सेनापति टिड्डिया रे दलो जेड़े ठईरने, जो ठण्डी रे दिना दे दवाला पाँदे बैठी जाओईया, पर जेबे सूरज दिशोआ, तेबे नठी जाओईया ओर कोई नि जाणदा कि सेयो केयी गईया।<verse eid="NAM 3:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="NAM 3:18" />ओ अश्शूरो रे राजा, तेरे ठराए रे परदान सयी जाओए, तेरे शूरवीर पारी नींजा दे पड़ी गे रे। तेरी प्रजा पाह्ड़ो पाँदे तित्तर-बित्तर ऊई गी री ओर तिना खे फेर कोई कट्ठा नि करदा। <verse eid="NAM 3:18" /><verse number="19" style="v" sid="NAM 3:19" />तेरे जख़्म नि परी सकदे, तेरी बमारिया रा लाज नि ऊई सकदा। हर कोई जो तेरे नाशो रिया खबरा खे सुणोआ, चाड़िया बजाओआ। सेयो सब खुश ए! कऊँकि तिने सबी तेसा पीड़ा खे सईन करी राखेया ए, जिना खे तूँ सदा तिना खे देया करे था।<verse eid="NAM 3:19" /></para>
  <chapter eid="NAM 3" />
</usx>