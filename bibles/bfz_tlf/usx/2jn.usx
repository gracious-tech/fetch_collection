  <para style="h">2 यूहन्ना</para>
  <para style="toc1">यूहन्ने री दूजी पत्री</para>
  <para style="toc2">2 यूहन्ना</para>
  <para style="toc3">2 यूहन्</para>
  <para style="mt1">2 यूहन्ना</para>
  <para style="mt2">यूहन्ने री लिखी री दूजी चिट्ठी</para>
  <para style="imt">भूमिका</para>
  <para style="ip">यूहन्ने री दूजी चिट्ठी “बुजुर्गा” री तरफा ते “चूणी री जवाणस और तेसा रे बच्चेया” रे नाओं लिखी राखी थी। जेतेरा मतलब ए-एक स्थानिय मण्डल़िया और तिजी रे सदस्य। संक्षेपो रे इजी रा संदेश ए, एकी-दूजे साथे प्यार राखणे री प्रार्थना और चूठे शिक्षक और तिना री शिक्षा रे खलाफ चेतावणी।</para>
  <para style="is">रूप-रेखा</para>
  <para style="io1">भूमिका 1:1-3</para>
  <para style="io1">प्यारो री खासियत 1:4-6</para>
  <para style="io1">चूठे तर्मसिद्धांता रे खलाफ चेतावणी 1:7-11</para>
  <para style="io1">निचोड़ 1:12, 13</para>
  <chapter number="1" style="c" sid="2JN 1"/>
  <para style="s">अभिवादन</para>
  <para style="p">
    <verse number="1" style="v" sid="2JN 1:1"/>ये चिट्ठी मां बुजुर्गो री तरफा ते ए। आँऊ ये चिट्ठी तेसा खास जवाणसा खे और तेसा रे बाल-बच्चेया खे लिखणे लगी रा जिना खे परमेशरे आपणे लोक करी की चूणी राखेया। आऊँ तुसा सबी ते सच्चा प्यार करूँआ, बस आऊँ ई नि, बल्कि सेयो सब बी प्यार राखोए, जो सच्चाईया खे जाणोए। <verse eid="2JN 1:1"/><verse number="2" style="v" sid="2JN 1:2"/>आसे सब लोक तांते प्यार करुँए कऊँकि से सच्चाई जो आसा रे टीकी री रओई, और सदा आसा साथे अटल रणी। <verse eid="2JN 1:2"/><verse number="3" style="v" sid="2JN 1:3"/>पिता परमेशर और पिते रे पाऊ प्रभु यीशु मसीह री तरफा ते कृपा, दया और शान्ति आसा साथे सच और प्यारो रे बणी रणी।<verse eid="2JN 1:3"/></para>
  <para style="s">सच्चाई और प्यार</para>
  <para style="p">
    <verse number="4" style="v" sid="2JN 1:4"/>आऊँ बऊत खुश ऊआ कि मैं तेरे कुछ बाल-बच्चे, तेसा आज्ञा रे मुताबिक, जो आसा खे पिते री तरफा ते मिली थी, सच्चाईया पाँदे चलदे ऊए पाए। <verse eid="2JN 1:4"/><verse number="5" style="v" sid="2JN 1:5"/>एबे ओ जवाणसे! आऊँ ताखे कोई नयी आज्ञा नि, पर सेई जो शुरूओ तेई आसा गे ए, लिखूँआ। और तांते बिनती करूँआ कि आसे एकी-दूजे साथे प्यार राखिए <verse eid="2JN 1:5"/><verse number="6" style="v" sid="2JN 1:6"/>और प्यार ये कि आसे तेसरी आज्ञा रे मुताबिक चलिए। ये सेई आज्ञा ए, जो तुसे शुरूओ ते सुणी राखी और तुसा खे इजी पाँदे चलणा बी चाईयो।<verse eid="2JN 1:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="2JN 1:7"/>कऊँकि बऊत सारे एड़े भरमाणे वाल़े दुनिया रे निकल़ी की आयी रे, जो ये नि मानदे कि प्रभु यीशु मसीह शरीरो रे ऊई की आए। भरमाणे वाल़ा और मसीह रा बिरोदी येई ए। <verse eid="2JN 1:7"/><verse number="8" style="v" sid="2JN 1:8"/>आपणे बारे रे चौकस रओ। जो मईणत आसे सब करी राखी, तिजी खे तुसे खोई नि देओ, बल्कि अनन्त जीवनो रा पूरा फल पाओ। <verse eid="2JN 1:8"/><verse number="9" style="v" sid="2JN 1:9"/>जो कोई मसीह री शिक्षा ते पटकी जाओआ और मसीह री शिक्षा रे बणेया रा नि रंदा, तेसगे परमेशर निए। पर कोई तेसरी शिक्षा रे टीके रा रओआ, तेसगे पिता बीए और पुत्र बी। <verse eid="2JN 1:9"/><verse number="10" style="v" sid="2JN 1:10"/>जे कोई तुसा गे आओ और मसीह री सच्ची शिक्षा नि देओ, तेसखे ना तो कअरे आऊणे देओ और ना ई तेसरी आदर-खातर करो। <verse eid="2JN 1:10"/><verse number="11" style="v" sid="2JN 1:11"/>कऊँकि जो कोई एड़े जणे री आदर-खातर करोआ, से तेसरे बुरे कामो रे साजा ओआ।<verse eid="2JN 1:11"/></para>
  <para style="s">आखरी अभिवादन</para>
  <para style="p">
    <verse number="12" style="v" sid="2JN 1:12"/>माखे तुसा खे बऊत सारिया गल्ला लिखणिया ए, पर कागज और स्याईया ते लिखणा नि चांदा, पर उम्मीद ए कि आऊँ तुसा गे आऊणा और आमणे-सामणे गल्ला करूँगा, जेते की आसा री खुशी पूरी ओ। <verse eid="2JN 1:12"/><verse number="13" style="v" sid="2JN 1:13"/>परमेशरो रे जरिए चूणी री तेरी बईणा रे बाल-बच्चे जो एती आसा साथे ताखे नमस्कार बोलोए।<verse eid="2JN 1:13"/></para>
  <chapter eid="2JN 1"/>
</usx>
